// lib/firnc1/sema.fi — TYPPRUEFER, IN FIRN.
//
// Sechster Teil von Stufe 1 und der bisher groesste: die Portierung des Kerns
// von `compiler/src/sema.rs`. Geprueft wird das, was `firnc0` zusichert —
// **jeder Ausdruck bekommt einen konkreten Typ**.
//
// DAS VERFAHREN IST BIDIREKTIONAL. Ein Ganzzahlliteral hat in Firn keinen
// eigenen Typ; er kommt aus dem Zusammenhang:
//
//     let x: i32 = 5        der Kontexthinweis macht die 5 zu i32
//     a + 1                 der Typ von `a` macht die 1 zu dessen Typ
//     5                     allein steht: FEHLER, nicht ableitbar
//
// Dafuer gibt es zwei Wege durch denselben Baum:
//   * `probe` ermittelt den Typ OHNE zu melden und ohne die Tabelle zu
//     beschreiben — damit `a + 1` den Typ des Literals aus `a` gewinnt;
//   * `ausdruck` prueft wirklich und traegt den Typ ein.
// Die Reihenfolge ist Vertrag: erst der bereits typisierte Operand, dann der
// Kontexthinweis. Sonst meldet `let x: i64 = a + 1` (a: i32) den Fehler an der
// falschen Stelle.
//
// NICHT PORTIERT (und deshalb hier benannt): saemtliche Fehlermeldungen. Die
// Firn-Fassung ZAEHLT Fehler, sie beschreibt sie nicht. Der Vergleich laeuft
// nur ueber Quellen, die `firnc0` fehlerfrei prueft — dort ist die Zahl der
// Meldungen null, und was zaehlt, sind die Typen. Ebenso fehlen
// Erreichbarkeitsanalyse (`return` am Ende), Veraenderlichkeitspruefung
// (`let` gegen `var`) und die Rekursionspruefung fuer Structs.

import rt
import vec
import intern
import ast
import types
import pattern
import err
import gc
import iface
import core
import nogc

export { Sema, sema_new, sema_free, sema_run, sema_error, sema_ty,
         sema_types, sema_ty_count, sema_needs_comptime, sema_const_value,
         sema_mu_set, sema_fe_set, sema_gc_set, sema_if_set,
         sema_kernel_set,
         sema_tree }

const KEIN: u32 = 4294967295

struct Sema {
    b: u64,              // Zeiger auf den Baum
    it: u64,             // Zeiger auf den Interner
    ty: types.Types,
    etyp: Vec[u32],      // Typ je Ausdrucksknoten
    v_name: Vec[u32],    // Bereiche: Namen, Typen und Grenzen
    v_ty: Vec[u32],
    b_limit: Vec[u32],
    k_name: Vec[u32],    // Konstanten
    k_ty: Vec[u32],
    k_value: Vec[u64],
    t_bool: u32,         // vorgefertigte Typen
    t_i64: u32,
    t_usize: u32,
    t_void: u32,
    t_error: u32,
    t_f64: u32,
    ret: u32,            // Rueckgabetyp der laufenden Funktion
    mu: u64,             // Register der Aufzaehlungen/Musterabgleiche (0 = keins)
    feh: u64,            // Register der Fehlermengen/-unionen (0 = keins)
    gc: u64,             // Registrierung der gc-Klassen (Runde 34; 0 = keine)
    ifr: u64,            // Registrierung der Schnittstellen (Runde 46; 0 = keine)
    // `#[must_consume]` (Runde 36, attrs.rs/sema.rs::check_attrs): Namensnummern
    // der gekennzeichneten Funktionen und StructINDIZES der gekennzeichneten Typen.
    mc_fname: Vec[u32],
    mc_si: Vec[u32],
    err: usize,
    // RUNDE 52 (SPEC 2): das Kernel-Profil. Aufgeloest wird es in
    // `bin/firnc1.fi` (Deklaration oder `--profile=`), hier wird es nur
    // durchgesetzt.
    kernel: bool,
    ct_needed: bool,     // eine Konstante braucht Auswertung zur Uebersetzungszeit
}

fn sema_new(b: u64, it: u64) -> Sema {
    return Sema{
        b: b, it: it,
        ty: types.types_new(),
        etyp: vec_new[u32](),
        v_name: vec_new[u32](), v_ty: vec_new[u32](), b_limit: vec_new[u32](),
        k_name: vec_new[u32](), k_ty: vec_new[u32](), k_value: vec_new[u64](),
        t_bool: 0, t_i64: 0, t_usize: 0, t_void: 0, t_error: 0, t_f64: 0,
        ret: 0, mu: 0, feh: 0, gc: 0, ifr: 0, mc_fname: vec_new[u32](), mc_si: vec_new[u32](),
        err: 0, kernel: false, ct_needed: false,
    }
}

fn sema_free(s: *mut Sema) {
    types.types_free(&(*s).ty)
    vec_free[u32](&(*s).etyp)
    vec_free[u32](&(*s).v_name)
    vec_free[u32](&(*s).v_ty)
    vec_free[u32](&(*s).b_limit)
    vec_free[u32](&(*s).k_name)
    vec_free[u32](&(*s).k_ty)
    vec_free[u64](&(*s).k_value)
    vec_free[u32](&(*s).mc_fname)
    vec_free[u32](&(*s).mc_si)
}

fn sema_error(s: *mut Sema) -> usize { return (*s).err }

// Das Muster-Register anmelden. MUSS vor `sema_lauf` stehen.
fn sema_mu_set(s: *mut Sema, m: u64) { (*s).mu = m }

fn mu(s: *mut Sema) -> *mut pattern.Pat { return (*s).mu as *mut pattern.Pat }
fn has_mu(s: *mut Sema) -> bool { return (*s).mu != 0 }

// Das Fehler-Register anmelden. MUSS vor `sema_lauf` stehen.
fn sema_fe_set(s: *mut Sema, f: u64) { (*s).feh = f }

fn fe(s: *mut Sema) -> *mut err.Error { return (*s).feh as *mut err.Error }
fn has_fe(s: *mut Sema) -> bool { return (*s).feh != 0 }

// Die gc-Registrierung anmelden (Runde 34). MUSS vor `sema_lauf` stehen.
fn sema_gc_set(s: *mut Sema, g: u64) { (*s).gc = g }

fn gcp(s: *mut Sema) -> *mut gc.Gc { return (*s).gc as *mut gc.Gc }
fn has_gc(s: *mut Sema) -> bool { return (*s).gc != 0 }

// Die Schnittstellen-Registrierung anmelden (Runde 46). MUSS vor
// `sema_lauf` stehen.
fn sema_if_set(s: *mut Sema, f: u64) { (*s).ifr = f }

// RUNDE 52 (SPEC 2): im Kernel-Profil gibt es weder `syscall` (kein
// Betriebssystem darunter) noch `gc class` (kein globaler Heap).
fn sema_kernel_set(s: *mut Sema, v: bool) { (*s).kernel = v }

fn ifp(s: *mut Sema) -> *mut iface.If { return (*s).ifr as *mut iface.If }
fn has_if(s: *mut Sema) -> bool { return (*s).ifr != 0 }

// Der Baum hinter diesem Lauf (fuer `nogc.fi`).
fn sema_tree(s: *mut Sema) -> *mut ast.Tree { return (*s).b as *mut ast.Tree }
fn sema_needs_comptime(s: *mut Sema) -> bool { return (*s).ct_needed }
fn sema_types(s: *mut Sema) -> *mut types.Types { return &(*s).ty }
fn sema_ty_count(s: *mut Sema) -> usize { return vec_len[u32](&(*s).etyp) }
fn sema_ty(s: *mut Sema, i: u32) -> u32 { return vec_at[u32](&(*s).etyp, i as usize) }

fn tree(s: *mut Sema) -> *mut ast.Tree { return (*s).b as *mut ast.Tree }
fn table(s: *mut Sema) -> *mut types.Types { return &(*s).ty }
fn names(s: *mut Sema) -> *mut intern.Interner { return (*s).it as *mut intern.Interner }

fn complain(s: *mut Sema) { (*s).err = (*s).err + 1 }

fn remember(s: *mut Sema, e: u32, t: u32) {
    vec_set[u32](&(*s).etyp, e as usize, t)
}

// ------------------------------------------------------------------ Bereiche

fn range_on(s: *mut Sema) {
    vec_push[u32](&(*s).b_limit, vec_len[u32](&(*s).v_name) as u32)
}

fn range_zu(s: *mut Sema) {
    let g: u32 = vec_last[u32](&(*s).b_limit)
    vec_pop[u32](&(*s).b_limit)
    while vec_len[u32](&(*s).v_name) > g as usize {
        vec_pop[u32](&(*s).v_name)
        vec_pop[u32](&(*s).v_ty)
    }
}

fn var_create(s: *mut Sema, name: u32, t: u32) {
    vec_push[u32](&(*s).v_name, name)
    vec_push[u32](&(*s).v_ty, t)
}

// Von hinten suchen: der innerste Bereich gewinnt.
fn var_search(s: *mut Sema, name: u32) -> u32 {
    var i: usize = vec_len[u32](&(*s).v_name)
    while i > 0 {
        i = i - 1
        if vec_at[u32](&(*s).v_name, i) == name {
            return vec_at[u32](&(*s).v_ty, i)
        }
    }
    return KEIN
}

fn const_search(s: *mut Sema, name: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*s).k_name) {
        if vec_at[u32](&(*s).k_name, i) == name {
            return vec_at[u32](&(*s).k_ty, i)
        }
        i = i + 1
    }
    return KEIN
}

fn sema_const_value(s: *mut Sema, name: u32) -> u64 {
    return const_value(s, name)
}

fn const_value(s: *mut Sema, name: u32) -> u64 {
    var i: usize = 0
    while i < vec_len[u32](&(*s).k_name) {
        if vec_at[u32](&(*s).k_name, i) == name {
            return vec_at[u64](&(*s).k_value, i)
        }
        i = i + 1
    }
    return 0
}

// Nummer der Funktion mit diesem Namen, oder KEIN.
fn fn_search(s: *mut Sema, name: u32) -> u32 {
    var i: usize = 0
    while i < ast.fn_count(tree(s)) {
        if ast.fn_name(tree(s), i) == name {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// -------------------------------------------------------------- Hilfsfragen

fn is_int(s: *mut Sema, t: u32) -> bool { return types.is_int(table(s), t) }
fn is_error(s: *mut Sema, t: u32) -> bool { return types.ty_kind(table(s), t) == types.K_FEHLER }
fn is_bool(s: *mut Sema, t: u32) -> bool { return types.ty_kind(table(s), t) == types.K_BOOL }
fn is_f64(s: *mut Sema, t: u32) -> bool { return types.ty_kind(table(s), t) == types.K_F64 }

// Darf dieser Typ an einer `as`-Umwandlung teilnehmen?
fn convertible(s: *mut Sema, t: u32) -> bool {
    return is_int(s, t) || is_bool(s, t) || types.is_ptr(table(s), t) || is_f64(s, t)
}

// Loest einen Typausdruck des Baums auf.
fn ast_ty(s: *mut Sema, te: u32) -> u32 {
    return types.resolve(table(s), tree(s), names(s), te)
}

// ---------------------------------------------------------------- probe
//
// Typ eines Ausdrucks OHNE Meldung und ohne die Tabelle zu beschreiben.
// KEIN heisst "nicht ableitbar" — genau wie `Option::None` in sema.rs.

fn probe(s: *mut Sema, e: u32) -> u32 {
    return probe_t(s, e, 0)
}

fn probe_t(s: *mut Sema, e: u32, d: u32) -> u32 {
    if d >= 200 {
        return KEIN
    }
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_INT {
        return KEIN
    }
    if a == ast.E_FLOAT {
        return (*s).t_f64
    }
    if a == ast.E_BOOL {
        return (*s).t_bool
    }
    if a == ast.E_ID {
        let v: u32 = var_search(s, ast.e_a(b, e))
        if v != KEIN {
            return v
        }
        return const_search(s, ast.e_a(b, e))
    }
    if a == ast.E_UN {
        let op: u32 = ast.e_a(b, e)
        if op == 0 {
            return probe_t(s, ast.e_b(b, e), d + 1)
        }
        if op == 1 {
            return (*s).t_bool
        }
        if op == 2 {
            let inner: u32 = probe_t(s, ast.e_b(b, e), d + 1)
            if inner == KEIN {
                return KEIN
            }
            return types.new_ty(table(s), types.K_PTR, inner, 1)
        }
        let p: u32 = probe_t(s, ast.e_b(b, e), d + 1)
        if p == KEIN {
            return KEIN
        }
        if types.ty_kind(table(s), p) != types.K_PTR {
            return KEIN
        }
        return types.ty_a(table(s), p)
    }
    if a == ast.E_BIN {
        let op: u32 = ast.e_a(b, e)
        if op >= 10 {
            return (*s).t_bool
        }
        if op == 8 || op == 9 {
            return probe_t(s, ast.e_b(b, e), d + 1)
        }
        let l: u32 = probe_t(s, ast.e_b(b, e), d + 1)
        if l != KEIN {
            return l
        }
        return probe_t(s, ast.e_c(b, e), d + 1)
    }
    if a == ast.E_FELD {
        let bt: u32 = probe_t(s, ast.e_a(b, e), d + 1)
        if bt == KEIN {
            return KEIN
        }
        // HOOK gc: Feldzugriff durch `Gc[T]` hindurch, ohne zu melden
        // (sema.rs::probe_d ueber gc::hook_field_base).
        if has_gc(s) {
            let si: u32 = gc.gc_field_base(gcp(s), table(s), bt)
            if si != KEIN {
                return types.st_field_ty(table(s), si as usize, ast.e_b(b, e))
            }
        }
        if types.ty_kind(table(s), bt) != types.K_STRUCT {
            return KEIN
        }
        return types.st_field_ty(table(s), types.ty_a(table(s), bt) as usize, ast.e_b(b, e))
    }
    if a == ast.E_IDX {
        let bt: u32 = probe_t(s, ast.e_a(b, e), d + 1)
        if bt == KEIN {
            return KEIN
        }
        if types.ty_kind(table(s), bt) != types.K_ARR {
            return KEIN
        }
        return types.ty_a(table(s), bt)
    }
    if a == ast.E_RUF {
        if ast.e_number(b, e) != 0 {
            return (*s).t_usize
        }
        // HOOK fehlerunionen: `try a`/`a catch b` liefern den Erfolgstyp
        // der Fehlerunion (errors.rs::success_type ueber probe_d).
        if has_fe(s) {
            if err.error_is_resultname(names(s), ast.e_a(b, e)) {
                if ast.e_c(b, e) == 0 {
                    return KEIN
                }
                let inner: u32 = probe_t(s, ast.child_at(b, ast.e_b(b, e)), d + 1)
                if inner == KEIN {
                    return KEIN
                }
                let u: u32 = err.error_union_of_ty(fe(s), table(s), inner)
                if u == KEIN {
                    return KEIN
                }
                return err.error_u_valty(fe(s), u)
            }
        }
        if has_gc(s) {
            // HOOK gc (gc.rs::probe_typ): `weak`/`stark`/`x.as?[C]` OHNE
            // Pruefung — damit ein Ganzzahlliteral daneben seinen Typ
            // bekommt.
            var argt: u32 = KEIN
            if ast.e_c(b, e) > 0 {
                argt = probe_t(s, ast.child_at(b, ast.e_b(b, e)), d + 1)
            }
            let pt: u32 = gc.gc_probe_ty(gcp(s), table(s), names(s), ast.e_a(b, e), argt)
            if pt != KEIN {
                return pt
            }
        }
        // HOOK impl (impls.rs in sema::probe_d): Rueckgabetyp der Methode,
        // ohne zu melden und ohne zu schreiben — sonst bekaeme ein Literal
        // daneben keinen Typ (`p.summe() != 42`).
        if is_method_call(names(s), ast.e_a(b, e)) {
            if ast.e_c(b, e) == 0 {
                return KEIN
            }
            let et: u32 = probe_t(s, ast.child_at(b, ast.e_b(b, e)), d + 1)
            if et == KEIN {
                return KEIN
            }
            let sn: u32 = recv_struct(s, et)
            if sn == KEIN {
                return KEIN
            }
            let m: u32 = intern.intern_ab(names(s), ast.e_a(b, e), 7)
            // HOOK iface: auf einem `dyn I` steht der Typ in der
            // Schnittstelle, nicht in der Funktionstabelle (iface.fi).
            if has_if(s) {
                let ii: u32 = iface.if_of_dyn(ifp(s), sn)
                if ii != KEIN {
                    let k: u32 = iface.if_slot(ifp(s), ii as usize, m)
                    if k == KEIN {
                        return KEIN
                    }
                    return iface.if_rtyp(ifp(s), ii as usize, k)
                }
            }
            let mf: u32 = fn_search(s, method_func(s, sn, m))
            if mf == KEIN {
                return KEIN
            }
            return types.ret_ty_the_func(table(s), mf as usize)
        }
        let f: u32 = fn_search(s, ast.e_a(b, e))
        if f == KEIN {
            return KEIN
        }
        return types.ret_ty_the_func(table(s), f as usize)
    }
    if a == ast.E_SYSCALL {
        return (*s).t_i64
    }
    if a == ast.E_AS {
        return ast_ty(s, ast.e_b(b, e))
    }
    if a == ast.E_SLIT {
        let si: i32 = types.struct_index(table(s), ast.e_a(b, e))
        if si < 0 {
            return KEIN
        }
        return types.new_ty(table(s), types.K_STRUCT, si as u32, 0)
    }
    if a == ast.E_ALIT {
        if ast.e_c(b, e) == 0 {
            return KEIN
        }
        let et: u32 = probe_t(s, ast.child_at(b, ast.e_b(b, e)), d + 1)
        if et == KEIN {
            return KEIN
        }
        return types.new_ty(table(s), types.K_ARR, et, ast.e_c(b, e) as u64)
    }
    return KEIN
}

// ------------------------------------------------- konstante Auswertung
//
// Gebraucht fuer `const` und fuer die Laenge eines Wiederholungsliterals —
// die geht in den TYP ein (`[T; N]`), also muss sie hier stehen.

fn wrap(s: *mut Sema, v: i64, t: u32) -> i64 {
    let bits: u32 = types.bits_of(table(s), t)
    if bits == 0 || bits >= 64 {
        return v
    }
    let mask: i64 = (1 << bits as i64) - 1
    let m: i64 = v & mask
    if types.is_sign(table(s), t) {
        if (m >> (bits - 1) as i64) & 1 != 0 {
            return m - (1 << bits as i64)
        }
    }
    return m
}

fn const_eval(s: *mut Sema, e: u32, good: *mut bool) -> i64 {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_INT {
        return ast.e_number(b, e) as i64
    }
    if a == ast.E_BOOL {
        if ast.e_a(b, e) == 1 {
            return 1
        }
        return 0
    }
    if a == ast.E_ID {
        if const_search(s, ast.e_a(b, e)) == KEIN {
            *good = false
            return 0
        }
        return const_value(s, ast.e_a(b, e)) as i64
    }
    if a == ast.E_UN {
        let v: i64 = const_eval(s, ast.e_b(b, e), good)
        let op: u32 = ast.e_a(b, e)
        if op == 0 {
            return 0 - v
        }
        if op == 1 {
            if v == 0 {
                return 1
            }
            return 0
        }
        *good = false
        return 0
    }
    if a == ast.E_BIN {
        let op: u32 = ast.e_a(b, e)
        let x: i64 = const_eval(s, ast.e_b(b, e), good)
        let y: i64 = const_eval(s, ast.e_c(b, e), good)
        var v: i64 = 0
        if op == 0 { v = x + y }
        else if op == 1 { v = x - y }
        else if op == 2 { v = x * y }
        else if op == 3 {
            if y == 0 {
                *good = false
                return 0
            }
            v = x / y
        }
        else if op == 4 {
            if y == 0 {
                *good = false
                return 0
            }
            v = x % y
        }
        else if op == 5 { v = x & y }
        else if op == 6 { v = x | y }
        else if op == 7 { v = x ^ y }
        else if op == 8 { v = x << y }
        else if op == 9 { v = x >> y }
        else if op == 10 { if x == y { v = 1 } }
        else if op == 11 { if x != y { v = 1 } }
        else if op == 12 { if x < y { v = 1 } }
        else if op == 13 { if x <= y { v = 1 } }
        else if op == 14 { if x > y { v = 1 } }
        else if op == 15 { if x >= y { v = 1 } }
        else if op == 16 { if x != 0 && y != 0 { v = 1 } }
        else { if x != 0 || y != 0 { v = 1 } }
        return wrap(s, v, sema_ty(s, e))
    }
    if a == ast.E_AS {
        let v: i64 = const_eval(s, ast.e_a(b, e), good)
        let dst: u32 = sema_ty(s, e)
        if is_bool(s, dst) {
            if v != 0 {
                return 1
            }
            return 0
        }
        if types.is_ptr(table(s), dst) {
            *good = false
            return 0
        }
        return wrap(s, v, dst)
    }
    // Ein AUFRUF in einem konstanten Ausdruck heisst: `firnc0` fuehrt die
    // Funktion zur Uebersetzungszeit aus (comptime.rs). Das ist nicht
    // portiert — die Datei wird gesondert gezaehlt, nicht als Abweichung.
    if a == ast.E_RUF {
        (*s).ct_needed = true
    }
    *good = false
    return 0
}

// ------------------------------------------------------------- Ausdruecke
//
// `hinweis` ist der Kontexttyp oder KEIN. Rueckgabe ist immer ein konkreter
// Typ; im Fehlerfall der Fehlertyp.

fn expr(s: *mut Sema, e: u32, note: u32) -> u32 {
    let t: u32 = expr_inner(s, e, note)
    remember(s, e, t)
    return t
}

// Gibt allen Teilausdruecken einen konkreten Typ, ohne inhaltlich zu pruefen.
fn infer(s: *mut Sema, e: u32) {
    expr(s, e, (*s).t_i64)
}

fn field_ty(s: *mut Sema, bt: u32, name: u32) -> u32 {
    // HOOK gc: Feldzugriff durch `Gc[T]` hindurch (gc.rs::hook_field_base).
    // Ein Gc-Zeiger wird gefolgt, ohne `(*p).feld` — er ist erstklassig.
    if has_gc(s) {
        let si: u32 = gc.gc_field_base(gcp(s), table(s), bt)
        if si != KEIN {
            let st: u32 = types.new_ty(table(s), types.K_STRUCT, si, 0)
            return field_ty(s, st, name)
        }
    }
    if types.ty_kind(table(s), bt) == types.K_STRUCT {
        let ft: u32 = types.st_field_ty(table(s), types.ty_a(table(s), bt) as usize, name)
        if ft == KEIN {
            complain(s)
            return (*s).t_error
        }
        return ft
    }
    if is_error(s, bt) {
        return (*s).t_error
    }
    complain(s)
    return (*s).t_error
}

fn index_ty(s: *mut Sema, bt: u32, idx: u32) -> u32 {
    let it: u32 = expr(s, idx, (*s).t_usize)
    if !is_error(s, it) && !types.ty_equal(table(s), it, (*s).t_usize) {
        complain(s)
    }
    if types.ty_kind(table(s), bt) == types.K_ARR {
        return types.ty_a(table(s), bt)
    }
    if is_error(s, bt) {
        return (*s).t_error
    }
    complain(s)
    return (*s).t_error
}

// Zuweisbarer Ausdruck: liefert den Typ oder KEIN.
fn lvalue(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_ID {
        let v: u32 = var_search(s, ast.e_a(b, e))
        if v != KEIN {
            remember(s, e, v)
            return v
        }
        let k: u32 = const_search(s, ast.e_a(b, e))
        if k != KEIN {
            remember(s, e, k)
            return k
        }
        complain(s)
        remember(s, e, (*s).t_error)
        return (*s).t_error
    }
    if a == ast.E_FELD {
        let bt: u32 = lvalue(s, ast.e_a(b, e))
        if bt == KEIN {
            return KEIN
        }
        let t: u32 = field_ty(s, bt, ast.e_b(b, e))
        remember(s, e, t)
        return t
    }
    if a == ast.E_IDX {
        let bt: u32 = lvalue(s, ast.e_a(b, e))
        if bt == KEIN {
            return KEIN
        }
        let t: u32 = index_ty(s, bt, ast.e_b(b, e))
        remember(s, e, t)
        return t
    }
    if a == ast.E_UN && ast.e_a(b, e) == 3 {
        let t0: u32 = expr(s, ast.e_b(b, e), KEIN)
        var t: u32 = (*s).t_error
        if types.ty_kind(table(s), t0) == types.K_PTR {
            t = types.ty_a(table(s), t0)
        } else if !is_error(s, t0) {
            complain(s)
        }
        remember(s, e, t)
        return t
    }
    infer(s, e)
    complain(s)
    return KEIN
}

fn unary(s: *mut Sema, e: u32, note: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let op: u32 = ast.e_a(b, e)
    let inner: u32 = ast.e_b(b, e)
    if op == 0 {
        var h: u32 = probe(s, inner)
        if h == KEIN {
            if note != KEIN && is_int(s, note) {
                h = note
            }
        }
        let t: u32 = expr(s, inner, h)
        if is_error(s, t) {
            return (*s).t_error
        }
        if !is_int(s, t) {
            complain(s)
            return (*s).t_error
        }
        return t
    }
    if op == 1 {
        let t: u32 = expr(s, inner, (*s).t_bool)
        if is_error(s, t) {
            return (*s).t_error
        }
        if !is_bool(s, t) {
            complain(s)
            return (*s).t_error
        }
        return (*s).t_bool
    }
    if op == 2 {
        let t: u32 = lvalue(s, inner)
        if t == KEIN || is_error(s, t) {
            return (*s).t_error
        }
        return types.new_ty(table(s), types.K_PTR, t, 1)
    }
    let t: u32 = expr(s, inner, KEIN)
    if types.ty_kind(table(s), t) == types.K_PTR {
        return types.ty_a(table(s), t)
    }
    if is_error(s, t) {
        return (*s).t_error
    }
    complain(s)
    return (*s).t_error
}

fn binary(s: *mut Sema, e: u32, note: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let op: u32 = ast.e_a(b, e)
    let l: u32 = ast.e_b(b, e)
    let r: u32 = ast.e_c(b, e)

    // logische Verknuepfung
    if op == 16 || op == 17 {
        let lt: u32 = expr(s, l, (*s).t_bool)
        let rt: u32 = expr(s, r, (*s).t_bool)
        if !is_error(s, lt) && !is_bool(s, lt) {
            complain(s)
        }
        if !is_error(s, rt) && !is_bool(s, rt) {
            complain(s)
        }
        return (*s).t_bool
    }

    // Vergleich
    if op >= 10 && op <= 15 {
        // HOOK fehlerunionen: `e == E::NotFound` vergleicht zwei Fehlerwerte
        // derselben Menge (errors.rs::hook_binary).
        if has_fe(s) && (op == 10 || op == 11) {
            if error_quiet_set(s, l) != KEIN || error_quiet_set(s, r) != KEIN {
                let lt2: u32 = expr(s, l, KEIN)
                let rt2: u32 = expr(s, r, KEIN)
                let ls: u32 = err.error_set_of_ty(fe(s), table(s), lt2)
                let rs: u32 = err.error_set_of_ty(fe(s), table(s), rt2)
                if ls != KEIN && rs != KEIN && ls == rs {
                    return (*s).t_bool
                }
                if !is_error(s, lt2) && !is_error(s, rt2) {
                    complain(s)
                }
                return (*s).t_bool
            }
        }
        var want: u32 = probe(s, l)
        if want == KEIN {
            want = probe(s, r)
        }
        let lt: u32 = expr(s, l, want)
        let rt: u32 = expr(s, r, want)
        if is_error(s, lt) || is_error(s, rt) {
            return (*s).t_bool
        }
        // HOOK gc: Identitaetsvergleich zweier verwandter Gc-Zeiger (gc.rs).
        var same: bool = types.compatible(table(s), lt, rt)
        if !same && has_gc(s) {
            same = gc.gc_is_related((*s).gc, table(s), lt, rt)
        }
        if !same {
            complain(s)
            return (*s).t_bool
        }
        let only_equal: bool = op == 10 || op == 11
        var ok: bool = is_int(s, lt) || is_f64(s, lt)
        if !ok && only_equal {
            ok = is_bool(s, lt) || types.is_ptr(table(s), lt)
        }
        if !ok {
            complain(s)
        }
        return (*s).t_bool
    }

    // Verschiebung: der linke Operand bestimmt den Typ
    if op == 8 || op == 9 {
        var h: u32 = probe(s, l)
        if h == KEIN {
            if note != KEIN && is_int(s, note) {
                h = note
            }
        }
        let lt: u32 = expr(s, l, h)
        var rh: u32 = probe(s, r)
        if rh == KEIN {
            if is_int(s, lt) {
                rh = lt
            } else {
                rh = (*s).t_i64
            }
        }
        let rt: u32 = expr(s, r, rh)
        if is_error(s, lt) {
            return (*s).t_error
        }
        if is_error(s, rt) {
            return lt
        }
        if !is_int(s, lt) || !is_int(s, rt) {
            complain(s)
            return (*s).t_error
        }
        return lt
    }

    // Arithmetik und Bitoperationen: der bereits typisierte Operand hat
    // VORRANG vor dem Kontexthinweis.
    var want: u32 = probe(s, l)
    if want == KEIN {
        want = probe(s, r)
    }
    if want == KEIN {
        if note != KEIN && is_int(s, note) {
            want = note
        }
    }
    let lt: u32 = expr(s, l, want)
    let rt: u32 = expr(s, r, want)
    if is_error(s, lt) || is_error(s, rt) {
        return (*s).t_error
    }
    if is_f64(s, lt) || is_f64(s, rt) {
        // `%` und die Bitoperationen sind fuer f64 nicht definiert.
        let allowed: bool = op <= 3
        if !allowed {
            complain(s)
            return (*s).t_error
        }
        if !types.ty_equal(table(s), lt, rt) {
            complain(s)
            return (*s).t_error
        }
        return (*s).t_f64
    }
    if !is_int(s, lt) || !is_int(s, rt) || !types.ty_equal(table(s), lt, rt) {
        complain(s)
        return (*s).t_error
    }
    return lt
}

// ------------------------------------------------- gc (gc.rs)
//
// `gc C{...}` liefert `AllocError!Gc[C]` (check_neu in Stufe 0). Der
// Aufrufname traegt die Klasse ("gc C"), das einzige Argument ist das
// Structliteral mit den Anfangswerten.

fn gc_new_check(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let name: u32 = ast.e_a(b, e)
    var slit: u32 = KEIN
    if ast.e_c(b, e) == 1 {
        let a0: u32 = ast.child_at(b, ast.e_b(b, e))
        if ast.e_kind(b, a0) == ast.E_SLIT {
            slit = a0
        }
    }
    let ki_i: i64 = gc.gc_class_out_new(gcp(s), names(s), name)
    if ki_i < 0 {
        // unbekannte gc-klasse
        if slit != KEIN {
            var k: u32 = 0
            while k < ast.e_c(b, slit) {
                infer(s, ast.child_at(b, ast.e_b(b, slit) + k * 2 + 1))
                k = k + 1
            }
        }
        complain(s)
        return (*s).t_error
    }
    let ki: u32 = ki_i as u32
    let sidx: u32 = gc.gc_sidx(gcp(s), ki)
    if slit != KEIN {
        let off: u32 = ast.e_b(b, slit)
        let cnt: u32 = ast.e_c(b, slit)
        var k: u32 = 0
        while k < cnt {
            let fname: u32 = ast.child_at(b, off + k * 2)
            let fexpr: u32 = ast.child_at(b, off + k * 2 + 1)
            // doppelt angegeben?
            var j: u32 = 0
            while j < k {
                if ast.child_at(b, off + j * 2) == fname {
                    complain(s)
                }
                j = j + 1
            }
            let want: u32 = types.st_field_ty(table(s), sidx as usize, fname)
            if want == KEIN {
                infer(s, fexpr)
                complain(s)
            } else {
                let got: u32 = expr(s, fexpr, want)
                if !is_error(s, got) && !types.compatible(table(s), got, want) {
                    complain(s)
                }
            }
            k = k + 1
        }
        // Bei einer gc-Allokation muessen ALLE Felder angegeben werden.
        if cnt != types.st_flen(table(s), sidx as usize) {
            complain(s)
        }
    }
    // Die fehlbare Allokation: AllocError!Gc[C] (DESIGNZIELE §2). Die Menge
    // kommt mit der automatisch eingezogenen Laufzeit (lib/gc/gc.fi).
    if !has_fe(s) {
        complain(s)
        return (*s).t_error
    }
    var ae: [u8; 10] = "AllocError"
    let aen: u32 = intern.intern_number(names(s), (&ae[0]) as u64, 10) as u32
    let sm: u32 = err.error_set_find(fe(s), aen)
    if sm == KEIN {
        complain(s)
        return (*s).t_error
    }
    let st: u32 = types.new_ty(table(s), types.K_STRUCT, sidx, 0)
    let val: u32 = types.new_ty(table(s), types.K_PTR, st, 1)
    let ut: u32 = err.error_union_build(fe(s), table(s), names(s), sm, val)
    let ui: u32 = err.error_union_of_ty(fe(s), table(s), ut)
    if ui != KEIN {
        gc.gc_union_set(gcp(s), ki, ui)
    }
    // Der Literal-Knoten selbst traegt den Union-Typ (Stufe 0: `record`).
    if slit != KEIN {
        remember(s, slit, ut)
    }
    return ut
}

// `x.as?[C]` — die gepruefte Abwaertsumwandlung (check_as in Stufe 0).
fn gc_as_check(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let name: u32 = ast.e_a(b, e)
    let zi: i64 = gc.gc_class_out_as(gcp(s), names(s), name)
    if zi < 0 {
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            infer(s, ast.child_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let target: u32 = zi as u32
    if ast.e_c(b, e) == 0 {
        complain(s)
        return (*s).t_error
    }
    let arg: u32 = ast.child_at(b, ast.e_b(b, e))
    let at: u32 = expr(s, arg, KEIN)
    if is_error(s, at) {
        return (*s).t_error
    }
    var source: u32 = KEIN
    if types.ty_kind(table(s), at) == types.K_PTR {
        let inner: u32 = types.ty_a(table(s), at)
        if types.ty_kind(table(s), inner) == types.K_STRUCT {
            source = gc.gc_class_of_struct(gcp(s), types.ty_a(table(s), inner))
        }
    }
    if source == KEIN {
        // '.as?[C]' erwartet einen Gc[T]
        complain(s)
        return (*s).t_error
    }
    if source != target && !gc.gc_is_descendant(gcp(s), target, source) && !gc.gc_is_descendant(gcp(s), source, target) {
        // die beiden Klassen sind nicht verwandt
        complain(s)
        return (*s).t_error
    }
    let st: u32 = types.new_ty(table(s), types.K_STRUCT, gc.gc_sidx(gcp(s), target), 0)
    return types.new_ty(table(s), types.K_PTR, st, 1)
}

// `weak(g)` und `stark(w)` (der Rest von hook_call in Stufe 0).
fn gc_weak_check(s: *mut Sema, e: u32, is_weak: bool) -> u32 {
    let b: *mut ast.Tree = tree(s)
    if ast.e_c(b, e) != 1 {
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            infer(s, ast.child_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let arg: u32 = ast.child_at(b, ast.e_b(b, e))
    let at: u32 = expr(s, arg, KEIN)
    if is_error(s, at) {
        return (*s).t_error
    }
    if is_weak {
        var ki: u32 = KEIN
        if types.ty_kind(table(s), at) == types.K_PTR {
            let inner: u32 = types.ty_a(table(s), at)
            if types.ty_kind(table(s), inner) == types.K_STRUCT {
                ki = gc.gc_class_of_struct(gcp(s), types.ty_a(table(s), inner))
            }
        }
        if ki == KEIN {
            // 'weak' erwartet einen Gc[T]
            complain(s)
            return (*s).t_error
        }
        return types.new_ty(table(s), types.K_STRUCT, gc.gc_widx(gcp(s), ki), 0)
    }
    var ki: u32 = KEIN
    if types.ty_kind(table(s), at) == types.K_STRUCT {
        ki = gc.gc_class_of_weak(gcp(s), types.ty_a(table(s), at))
    }
    if ki == KEIN {
        // 'stark' erwartet einen GcWeak[T]
        complain(s)
        return (*s).t_error
    }
    let st: u32 = types.new_ty(table(s), types.K_STRUCT, gc.gc_sidx(gcp(s), ki), 0)
    return types.new_ty(table(s), types.K_PTR, st, 1)
}

// ------------------------------------------------------- RUNDE 45: Methoden
//
// Vorbild: compiler/src/impls.rs. `x.m(a)` steht als Aufruf `"methode m"` im
// Baum; welche Funktion gemeint ist, entscheidet ALLEIN der statische Typ des
// Empfaengers. Kein dynamischer Versand, keine vtable.

fn is_method_call(it: *mut intern.Interner, name: u32) -> bool {
    var w: [u8; 7] = "method "
    return intern.intern_prefix(it, name, (&w[0]) as u64, 7)
}

// Der Name, unter dem die Methoden eines Empfaengertyps stehen — Wert ODER
// Zeiger. RUNDE 50: das ist nicht mehr nur ein Struct. Auch ein GRUNDTYP kann
// eine Schnittstelle umsetzen (`impl Ord for i32`), und dann heisst seine
// Methode `i32__kleiner`. Ein typloses Ganzzahlliteral gehoert nicht dazu —
// es hat keinen festen Typ, unter dem ein `impl`-Block stehen koennte.
fn recv_struct(s: *mut Sema, t: u32) -> u32 {
    var i: u32 = t
    if types.ty_kind(table(s), i) == types.K_PTR {
        i = types.ty_a(table(s), i)
    }
    let a: u32 = types.ty_kind(table(s), i)
    if a == types.K_STRUCT {
        return types.st_name(table(s), types.ty_a(table(s), i) as usize)
    }
    return types.base_ty_name(names(s), a)
}

// `Typ__methode` — der Name der Funktion hinter der Methode.
fn method_func(s: *mut Sema, sn: u32, m: u32) -> u32 {
    let it: *mut intern.Interner = names(s)
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, intern.intern_ptr(it, sn), intern.intern_length(it, sn))
    var tr: [u8; 2] = "__"
    rt.buf_push_bytes(&b, (&tr[0]) as u64, 2)
    rt.buf_push_bytes(&b, intern.intern_ptr(it, m), intern.intern_length(it, m))
    let nr: u32 = intern.intern_number(it, rt.buf_ptr(&b), rt.buf_len(&b)) as u32
    rt.buf_free(&b)
    return nr
}

// Kann von diesem Ausdruck eine Adresse genommen werden? Dieselbe Menge, die
// `&x` erlaubt (impls.rs::ist_platz).
fn is_slot(s: *mut Sema, e: u32) -> bool {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_ID {
        return true
    }
    if a == ast.E_FELD {
        return true
    }
    if a == ast.E_IDX {
        return true
    }
    if a == ast.E_UN {
        return ast.e_a(b, e) == 3
    }
    return false
}

fn methods_call(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    if cnt < 1 {
        complain(s)
        return (*s).t_error
    }
    let m: u32 = intern.intern_ab(names(s), ast.e_a(b, e), 7)
    let recv: u32 = ast.child_at(b, off)
    let et: u32 = expr(s, recv, KEIN)
    var k: u32 = 1
    if is_error(s, et) {
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        return (*s).t_error
    }
    let sn: u32 = recv_struct(s, et)
    if sn == KEIN {
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    // HOOK iface (iface.rs::hook_methode): `f.m(args)` auf einem `dyn I` —
    // DYNAMISCHER VERSAND. Welche Funktion laeuft, steht erst zur Laufzeit
    // in der Methodentafel; geprueft wird gegen die Schnittstelle.
    if has_if(s) {
        let ii: u32 = iface.if_of_dyn(ifp(s), sn)
        if ii != KEIN {
            return interfaces_call(s, e, ii, m, et)
        }
    }
    let f: u32 = fn_search(s, method_func(s, sn, m))
    if f == KEIN {
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let plen: u32 = ast.fn_plen(b, f as usize)
    // Der Empfaenger — die einzige Anpassung am Aufrufort: verlangt die
    // Methode einen Zeiger und liegt er als Wert vor, wird seine Adresse
    // genommen. Umgekehrt gibt es NICHTS: kein automatisches Ableiten.
    if plen > 0 {
        let p0: u32 = types.param_ty_resolved(table(s), f as usize, 0)
        let will_z: bool = types.is_ptr(table(s), p0)
        let is_z: bool = types.is_ptr(table(s), et)
        if will_z && !is_z {
            if !is_slot(s, recv) {
                complain(s)
            }
        }
        if !will_z && is_z {
            complain(s)
        }
    }
    if cnt != plen {
        complain(s)
    }
    while k < cnt {
        let arg: u32 = ast.child_at(b, off + k)
        if k < plen {
            let pt: u32 = types.param_ty_resolved(table(s), f as usize, k)
            if has_fe(s) && coerce_check(s, arg, pt) {
                k = k + 1
                continue
            }
            let t: u32 = expr(s, arg, pt)
            if !types.compatible(table(s), t, pt) {
                complain(s)
            }
        } else {
            infer(s, arg)
        }
        k = k + 1
    }
    return types.ret_ty_the_func(table(s), f as usize)
}

// Ein Aufruf ueber die Schnittstelle. Der Empfaenger ist der fette Zeiger
// SELBST (ein Wert); ein `*dyn I` wird bewusst nicht angenommen —
// `(*z).m(…)` sagt dasselbe und macht sichtbar, dass zwei Woerter gelesen
// werden.
fn interfaces_call(s: *mut Sema, e: u32, ii: u32, m: u32, et: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    let mk: u32 = iface.if_slot(ifp(s), ii as usize, m)
    var k: u32 = 1
    if mk == KEIN {
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        // die schnittstelle hat keine methode dieses namens
        complain(s)
        return (*s).t_error
    }
    // RUNDE 50 — OBJEKTSICHERHEIT: eine Signatur mit `Self` kennt der
    // Aufrufer ueber `dyn I` nicht. Welcher Typ dahintersteckt, steht erst
    // zur Laufzeit fest, und `*Self` waere fuer jeden ein anderer Typ. Solche
    // Methoden gibt es nur statisch, ueber eine Schranke.
    if iface.if_m_self(ifp(s), ii, mk) {
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    if types.is_ptr(table(s), et) {
        // ein Zeiger auf einen Schnittstellenwert ist keiner
        complain(s)
    }
    let plen: u32 = iface.if_plen(ifp(s), ii as usize, mk)
    if cnt != plen + 1 {
        complain(s)
    }
    while k < cnt {
        let arg: u32 = ast.child_at(b, off + k)
        if k <= plen {
            let pt: u32 = iface.if_ptyp(ifp(s), ii as usize, mk, k - 1)
            if has_fe(s) && coerce_check(s, arg, pt) {
                k = k + 1
                continue
            }
            let t: u32 = expr(s, arg, pt)
            if !types.compatible(table(s), t, pt) {
                complain(s)
            }
        } else {
            infer(s, arg)
        }
        k = k + 1
    }
    return iface.if_rtyp(ifp(s), ii as usize, mk)
}

// ---------------------------------------------- Inline-Assembler und MMIO
//
// RUNDE 52 (compiler/src/core.rs::hook_call).

// Ganzzahltyp zu einem MMIO-Breitenindex (0 = u8 … 3 = u64).
fn mmio_ty(s: *mut Sema, w: u32) -> u32 {
    if w == 0 {
        return types.new_ty(table(s), types.K_U8, 0, 0)
    }
    if w == 1 {
        return types.new_ty(table(s), types.K_U16, 0, 0)
    }
    if w == 2 {
        return types.new_ty(table(s), types.K_U32, 0, 0)
    }
    return types.new_ty(table(s), types.K_U64, 0, 0)
}

// Ein Registername in einem asm-Block. `wo`: 0 = out, 1 = in, 2 = clobber.
fn asm_reg_check(s: *mut Sema, reg: u32, wo: u32) -> bool {
    if wo == 2 {
        var mw: [u8; 6] = "memory"
        if intern.intern_equal(names(s), reg, (&mw[0]) as u64, 6) {
            return true
        }
    }
    if core.reg_stem(names(s), reg) != core.KEIN_REG {
        return true
    }
    complain(s)
    return false
}

fn asm_check(s: *mut Sema, blk: u32, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    var good: bool = true
    let out: u32 = ast.asm_out(b, blk)
    if out != ast.NICHTS {
        if !asm_reg_check(s, out, 0) {
            good = false
        }
    }
    var k: u32 = 0
    while k < ast.asm_in_count(b, blk) {
        if !asm_reg_check(s, ast.asm_in_reg(b, blk, k), 1) {
            good = false
        }
        k = k + 1
    }
    var k2: u32 = 0
    while k2 < ast.asm_clob_count(b, blk) {
        if !asm_reg_check(s, ast.asm_clob(b, blk, k2), 2) {
            good = false
        }
        k2 = k2 + 1
    }
    // Jeder Eingabewert muss skalar sein — in ein Register passt nichts
    // anderes.
    let u64t: u32 = types.new_ty(table(s), types.K_U64, 0, 0)
    var k3: u32 = 0
    while k3 < cnt {
        let t: u32 = expr(s, ast.child_at(b, off + k3), u64t)
        if is_error(s, t) {
            good = false
        } else if !is_int(s, t) && !is_bool(s, t) && !types.is_ptr(table(s), t) {
            complain(s)
            good = false
        }
        k3 = k3 + 1
    }
    if !good {
        return (*s).t_error
    }
    if out != ast.NICHTS {
        return u64t
    }
    return (*s).t_void
}

fn mmio_check(s: *mut Sema, w: u32, e: u32, write: bool) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    var should: u32 = 1
    if write {
        should = 2
    }
    let zt: u32 = mmio_ty(s, w)
    if cnt != should {
        var k: u32 = 0
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let pt: u32 = types.new_ty(table(s), types.K_PTR, zt, 1)
    let at: u32 = expr(s, ast.child_at(b, off), pt)
    if !is_error(s, at) && !types.is_ptr(table(s), at) {
        complain(s)
        return (*s).t_error
    }
    if is_error(s, at) {
        return (*s).t_error
    }
    if !write {
        return zt
    }
    let wt: u32 = expr(s, ast.child_at(b, off + 1), zt)
    if is_error(s, wt) {
        return (*s).t_error
    }
    if !is_int(s, wt) {
        complain(s)
        return (*s).t_error
    }
    return (*s).t_void
}

fn call(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    // `size_of[T]()` — kein gewoehnlicher Aufruf, sondern eine Groesse zur
    // Uebersetzungszeit (sizeof.rs). Der Parser hat den Typknoten nach
    // `e_zahl` gelegt (Knoten + 1); aufgeloest wird er erst hier, weil erst
    // hier die Structtafel steht.
    if ast.e_number(b, e) != 0 {
        let st: u32 = ast_ty(s, (ast.e_number(b, e) - 1) as u32)
        if is_error(s, st) {
            complain(s)
            return (*s).t_error
        }
        if types.ty_kind(table(s), st) == types.K_VOID {
            complain(s)
            return (*s).t_error
        }
        return (*s).t_usize
    }
    let name: u32 = ast.e_a(b, e)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    // HOOK impl (impls.rs::hook_call): `x.m(args)` — Methodenaufruf.
    if is_method_call(names(s), name) {
        return methods_call(s, e)
    }
    // HOOK fehlerunionen (errors.rs::hook_call): `__try#`, `__catch#` und
    // `Fehlermenge::Variante`. Steht VOR dem enum/match-Hook, weil es in
    // Stufe 0 auch zuerst drankommt; eine Menge und eine Aufzaehlung
    // desselben Namens gibt es nicht (die Anmeldung meldet den Konflikt).
    if has_fe(s) {
        if err.error_is_tryname(names(s), name) {
            return try_check(s, e)
        }
        if err.error_is_catchname(names(s), name) {
            return catch_check(s, e)
        }
        var en: u32 = KEIN
        var vn: u32 = KEIN
        err.error_name_split((*s).feh, names(s), name, &en, &vn)
        if en != KEIN {
            if err.error_set_find(fe(s), en) != KEIN {
                return error_ctor_check(s, en, e)
            }
        }
    }
    // HOOK enum/match (sema_match.rs): `__match#N` ist der Musterabgleich,
    // `Enum::Variante(..)` der Konstruktor. Beides steht nicht in der
    // Funktionsliste.
    if has_mu(s) {
        if pattern.pat_is_matchname(names(s), name) {
            match_check(s, pattern.pat_match_number(names(s), name))
            return (*s).t_void
        }
        if pattern.pat_is_ctorname(names(s), name) {
            return ctor_check(s, name, e)
        }
    }
    // RUNDE 52 (core.rs): der Inline-Assembler und die acht MMIO-Namen.
    // `asm$N` kann keine eigene Funktion sein ('$' ist kein Bezeichnerzeichen);
    // bei MMIO gewinnt eine gleichnamige eigene Funktion.
    let anr: u32 = core.asm_number(names(s), name)
    if anr != core.KEINE_NUMMER {
        return asm_check(s, anr, e)
    }
    if fn_search(s, name) == KEIN {
        let wl: u32 = core.mmio_read_width(names(s), name)
        if wl != core.KEINE_BREITE {
            return mmio_check(s, wl, e, false)
        }
        let ws: u32 = core.mmio_write_width(names(s), name)
        if ws != core.KEINE_BREITE {
            return mmio_check(s, ws, e, true)
        }
    }
    // RUNDE 49 (thread.rs): die drei Faden-Primitive. Eine gleichnamige
    // eigene Funktion gewinnt, genau wie beim atomaren Addieren.
    var fst: [u8; 14] = "__thread_start"
    if intern.intern_equal(names(s), name, (&fst[0]) as u64, 14) && fn_search(s, name) == KEIN {
        let u64t2: u32 = types.new_ty(table(s), types.K_U64, 0, 0)
        let i64t2: u32 = types.new_ty(table(s), types.K_I64, 0, 0)
        let u8t2: u32 = types.new_ty(table(s), types.K_U8, 0, 0)
        let pu8t: u32 = types.new_ty(table(s), types.K_PTR, u8t2, 1)
        if cnt != 3 {
            var k3: u32 = 0
            while k3 < cnt {
                infer(s, ast.child_at(b, off + k3))
                k3 = k3 + 1
            }
            complain(s)
            return (*s).t_error
        }
        let ta: u32 = expr(s, ast.child_at(b, off), u64t2)
        let ts: u32 = expr(s, ast.child_at(b, off + 1), u64t2)
        let tc: u32 = expr(s, ast.child_at(b, off + 2), pu8t)
        if !is_error(s, ta) && !is_int(s, ta) {
            complain(s)
            return (*s).t_error
        }
        if !is_error(s, ts) && !is_int(s, ts) {
            complain(s)
            return (*s).t_error
        }
        if !is_error(s, tc) && !types.is_ptr(table(s), tc) {
            complain(s)
            return (*s).t_error
        }
        if is_error(s, ta) || is_error(s, ts) || is_error(s, tc) {
            return (*s).t_error
        }
        return i64t2
    }
    var fsl: [u8; 13] = "__thread_self"
    if intern.intern_equal(names(s), name, (&fsl[0]) as u64, 13) && fn_search(s, name) == KEIN {
        let u8t3: u32 = types.new_ty(table(s), types.K_U8, 0, 0)
        let pu8t2: u32 = types.new_ty(table(s), types.K_PTR, u8t3, 1)
        if cnt != 0 {
            var k4: u32 = 0
            while k4 < cnt {
                infer(s, ast.child_at(b, off + k4))
                k4 = k4 + 1
            }
            complain(s)
            return (*s).t_error
        }
        return pu8t2
    }
    var atc: [u8; 13] = "__atomic_swap"
    if intern.intern_equal(names(s), name, (&atc[0]) as u64, 13) && fn_search(s, name) == KEIN {
        let u64t3: u32 = types.new_ty(table(s), types.K_U64, 0, 0)
        let pu64t: u32 = types.new_ty(table(s), types.K_PTR, u64t3, 1)
        if cnt != 3 {
            var k5: u32 = 0
            while k5 < cnt {
                infer(s, ast.child_at(b, off + k5))
                k5 = k5 + 1
            }
            complain(s)
            return (*s).t_error
        }
        let tp2: u32 = expr(s, ast.child_at(b, off), pu64t)
        let te2: u32 = expr(s, ast.child_at(b, off + 1), u64t3)
        let tn2: u32 = expr(s, ast.child_at(b, off + 2), u64t3)
        if !is_error(s, tp2) && !types.is_ptr(table(s), tp2) {
            complain(s)
            return (*s).t_error
        }
        if !is_error(s, te2) && !is_int(s, te2) {
            complain(s)
            return (*s).t_error
        }
        if !is_error(s, tn2) && !is_int(s, tn2) {
            complain(s)
            return (*s).t_error
        }
        if is_error(s, tp2) || is_error(s, te2) || is_error(s, tn2) {
            return (*s).t_error
        }
        return u64t3
    }
    // `__atomar_addieren(p, delta)` (atomic.rs, RUNDE 47): atomares
    // Lesen-Addieren-Schreiben, Ergebnis ist der ALTE Wert. Grundlage des
    // Zaehlers von `Arc[T]` (SPEC 3.4). Eine eigene Funktion gewinnt.
    var atw: [u8; 12] = "__atomic_add"
    if intern.intern_equal(names(s), name, (&atw[0]) as u64, 12) && fn_search(s, name) == KEIN {
        let u64t: u32 = types.new_ty(table(s), types.K_U64, 0, 0)
        let pu64: u32 = types.new_ty(table(s), types.K_PTR, u64t, 1)
        if cnt != 2 {
            var k2: u32 = 0
            while k2 < cnt {
                infer(s, ast.child_at(b, off + k2))
                k2 = k2 + 1
            }
            complain(s)
            return (*s).t_error
        }
        let tp: u32 = expr(s, ast.child_at(b, off), pu64)
        let td: u32 = expr(s, ast.child_at(b, off + 1), u64t)
        if !is_error(s, tp) && !types.is_ptr(table(s), tp) {
            complain(s)
            return (*s).t_error
        }
        if !is_error(s, td) && !is_int(s, td) {
            complain(s)
            return (*s).t_error
        }
        if is_error(s, tp) || is_error(s, td) {
            return (*s).t_error
        }
        return u64t
    }
    // HOOK gc (gc.rs::hook_call): `gc C{...}`, die beiden Intrinsics,
    // `x.as?[C]`, `weak(g)` und `stark(w)`. Steht vor der Funktionssuche —
    // ausser `weak`/`stark`: eine gleichnamige EIGENE Funktion gewinnt
    // (in Stufe 0: `ck.fns.contains_key(name)`).
    if has_gc(s) {
        if gc.gc_has_new_prefix(names(s), name) {
            return gc_new_check(s, e)
        }
        if gc.gc_state_name(names(s), name) != 0 {
            var k: u32 = 0
            while k < cnt {
                infer(s, ast.child_at(b, off + k))
                k = k + 1
            }
            let u8t: u32 = types.new_ty(table(s), types.K_U8, 0, 0)
            return types.new_ty(table(s), types.K_PTR, u8t, 1)
        }
        if gc.gc_has_as_prefix(names(s), name) {
            return gc_as_check(s, e)
        }
        if (gc.gc_is_weak_name(names(s), name) || gc.gc_is_strong_name(names(s), name)) && fn_search(s, name) == KEIN {
            return gc_weak_check(s, e, gc.gc_is_weak_name(names(s), name))
        }
        // `barrier(x)` (ct.rs): die undurchsichtige Sperre — Verhalten ist
        // die Identitaet, geprueft wird nur die Skalaritaet. Eine eigene
        // Funktion namens `barrier` gewinnt (ct.rs::hook_call).
        var bw: [u8; 7] = "barrier"
        if intern.intern_equal(names(s), name, (&bw[0]) as u64, 7) && fn_search(s, name) == KEIN {
            if cnt != 1 {
                complain(s)
                return (*s).t_error
            }
            let at: u32 = expr(s, ast.child_at(b, off), KEIN)
            if is_error(s, at) {
                return (*s).t_error
            }
            if !is_int(s, at) && !is_bool(s, at) && !types.is_ptr(table(s), at) {
                complain(s)
                return (*s).t_error
            }
            return at
        }
        // `select(bedingung, a, b)` (ct.rs::check_select, RUNDE 36):
        // datenunabhaengige Auswahl — nur skalare Typen, beide Zweige
        // denselben Typs, keine implizite Umwandlung. Eigene Funktion gewinnt.
        var sw2: [u8; 6] = "select"
        if intern.intern_equal(names(s), name, (&sw2[0]) as u64, 6) && fn_search(s, name) == KEIN {
            if cnt != 3 {
                complain(s)
                return (*s).t_error
            }
            let cty: u32 = expr(s, ast.child_at(b, off), (*s).t_bool)
            if !is_error(s, cty) && !is_bool(s, cty) {
                complain(s)
            }
            let ta: u32 = expr(s, ast.child_at(b, off + 1), KEIN)
            let tb: u32 = expr(s, ast.child_at(b, off + 2), ta)
            if is_error(s, ta) || is_error(s, tb) {
                return (*s).t_error
            }
            if !is_int(s, ta) && !is_bool(s, ta) && !types.is_ptr(table(s), ta) {
                complain(s)
                return (*s).t_error
            }
            if !types.ty_equal(table(s), ta, tb) {
                complain(s)
                return (*s).t_error
            }
            return ta
        }
        // `secure_zero(zeiger, anzahl)` (ct.rs::check_secure_zero, RUNDE 36):
        // nullt den Puffer und darf nie wegoptimiert werden (SPEC §9.3, C3).
        var sz: [u8; 11] = "secure_zero"
        if intern.intern_equal(names(s), name, (&sz[0]) as u64, 11) && fn_search(s, name) == KEIN {
            if cnt != 2 {
                complain(s)
                return (*s).t_error
            }
            let tp: u32 = expr(s, ast.child_at(b, off), KEIN)
            if !is_error(s, tp) && !types.is_ptr(table(s), tp) {
                complain(s)
            }
            let tn: u32 = expr(s, ast.child_at(b, off + 1), (*s).t_usize)
            if !is_error(s, tn) && !is_int(s, tn) {
                complain(s)
            }
            return (*s).t_void
        }
    }
    let f: u32 = fn_search(s, name)
    if f == KEIN {
        var k: u32 = 0
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let plen: u32 = ast.fn_plen(b, f as usize)
    if cnt != plen {
        complain(s)
    }
    var k: u32 = 0
    while k < cnt {
        let arg: u32 = ast.child_at(b, off + k)
        if k < plen {
            let pt: u32 = types.param_ty_resolved(table(s), f as usize, k)
            // HOOK fehlerunionen: implizite Umwandlung eines Arguments
            // (errors.rs::hook_coerce in `call`).
            if has_fe(s) && coerce_check(s, arg, pt) {
                k = k + 1
                continue
            }
            let t: u32 = expr(s, arg, pt)
            if !types.compatible(table(s), t, pt) {
                complain(s)
            }
        } else {
            infer(s, arg)
        }
        k = k + 1
    }
    return types.ret_ty_the_func(table(s), f as usize)
}

fn struct_literal(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let name: u32 = ast.e_a(b, e)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    let si: i32 = types.struct_index(table(s), name)
    if si < 0 {
        var k: u32 = 0
        while k < cnt {
            infer(s, ast.child_at(b, off + k * 2 + 1))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    var k: u32 = 0
    while k < cnt {
        let fname: u32 = ast.child_at(b, off + k * 2)
        let fexpr: u32 = ast.child_at(b, off + k * 2 + 1)
        let ft: u32 = types.st_field_ty(table(s), si as usize, fname)
        if ft == KEIN {
            infer(s, fexpr)
            complain(s)
        } else {
            // HOOK fehlerunionen: implizite Umwandlung eines Feldwerts.
            var converted: bool = false
            if has_fe(s) {
                converted = coerce_check(s, fexpr, ft)
            }
            if !converted {
                let t: u32 = expr(s, fexpr, ft)
                if !types.compatible(table(s), t, ft) {
                    complain(s)
                }
            }
        }
        k = k + 1
    }
    if cnt != types.st_flen(table(s), si as usize) {
        complain(s)
    }
    return types.new_ty(table(s), types.K_STRUCT, si as u32, 0)
}

fn expr_inner(s: *mut Sema, e: u32, note: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)

    if a == ast.E_FLOAT {
        return (*s).t_f64
    }
    if a == ast.E_INT {
        // Ein Ganzzahlliteral hat KEINEN eigenen Typ — er kommt von aussen.
        if note != KEIN {
            if is_int(s, note) {
                return note
            }
            if is_error(s, note) {
                return (*s).t_error
            }
        }
        complain(s)
        return (*s).t_error
    }
    if a == ast.E_BOOL {
        return (*s).t_bool
    }
    if a == ast.E_ID {
        let v: u32 = var_search(s, ast.e_a(b, e))
        if v != KEIN {
            return v
        }
        let k: u32 = const_search(s, ast.e_a(b, e))
        if k != KEIN {
            return k
        }
        complain(s)
        return (*s).t_error
    }
    if a == ast.E_UN {
        return unary(s, e, note)
    }
    if a == ast.E_BIN {
        return binary(s, e, note)
    }
    if a == ast.E_FELD {
        let bt: u32 = expr(s, ast.e_a(b, e), KEIN)
        return field_ty(s, bt, ast.e_b(b, e))
    }
    if a == ast.E_IDX {
        let bt: u32 = expr(s, ast.e_a(b, e), KEIN)
        return index_ty(s, bt, ast.e_b(b, e))
    }
    if a == ast.E_RUF {
        return call(s, e)
    }
    if a == ast.E_SYSCALL {
        let off: u32 = ast.e_b(b, e)
        let cnt: u32 = ast.e_c(b, e)
        // RUNDE 52 (prof.rs): unter einem freistehenden Kernel liegt kein
        // Betriebssystem, das einen Systemaufruf entgegennehmen koennte.
        if (*s).kernel {
            complain(s)
        }
        if cnt == 0 || cnt > 7 {
            complain(s)
        }
        var k: u32 = 0
        while k < cnt {
            let t: u32 = expr(s, ast.child_at(b, off + k), (*s).t_i64)
            if !is_error(s, t) && !is_int(s, t) && !types.is_ptr(table(s), t) {
                complain(s)
            }
            k = k + 1
        }
        return (*s).t_i64
    }
    if a == ast.E_AS {
        let dst: u32 = ast_ty(s, ast.e_b(b, e))
        // HOOK iface (iface.rs::hook_cast): `x as dyn I` — der
        // Schnittstellenwert entsteht AUSDRUECKLICH (SPEC §6.2).
        if has_if(s) && types.ty_kind(table(s), dst) == types.K_STRUCT {
            let dn: u32 = types.st_name(table(s), types.ty_a(table(s), dst) as usize)
            let ii: u32 = iface.if_of_dyn(ifp(s), dn)
            if ii != KEIN {
                let src: u32 = expr(s, ast.e_a(b, e), KEIN)
                if is_error(s, src) {
                    return dst
                }
                if !types.is_ptr(table(s), src) {
                    complain(s)
                    return (*s).t_error
                }
                let inner: u32 = types.ty_a(table(s), src)
                if types.ty_kind(table(s), inner) != types.K_STRUCT {
                    complain(s)
                    return (*s).t_error
                }
                if !iface.if_impl_ok(ifp(s), ii, types.ty_a(table(s), inner)) {
                    complain(s)
                    return (*s).t_error
                }
                return dst
            }
        }
        var ih: u32 = KEIN
        if is_int(s, dst) {
            ih = dst
        } else if is_bool(s, dst) {
            ih = (*s).t_i64
        } else if types.is_ptr(table(s), dst) {
            ih = (*s).t_usize
        }
        let src: u32 = expr(s, ast.e_a(b, e), ih)
        if is_error(s, src) || is_error(s, dst) {
            return dst
        }
        if !convertible(s, src) || !convertible(s, dst) {
            complain(s)
            return (*s).t_error
        }
        return dst
    }
    if a == ast.E_SLIT {
        return struct_literal(s, e)
    }
    if a == ast.E_AWDH {
        let value: u32 = ast.e_a(b, e)
        let count: u32 = ast.e_b(b, e)
        let ct: u32 = expr(s, count, (*s).t_usize)
        var n: u64 = 0
        if is_error(s, ct) || !is_int(s, ct) {
            if !is_error(s, ct) {
                complain(s)
            }
        } else {
            var good: bool = true
            let v: i64 = const_eval(s, count, &good)
            if good && v > 0 {
                n = v as u64
            } else {
                complain(s)
            }
        }
        var eh: u32 = KEIN
        if note != KEIN {
            if types.ty_kind(table(s), note) == types.K_ARR {
                eh = types.ty_a(table(s), note)
            }
        }
        let vt: u32 = expr(s, value, eh)
        if n == 0 || is_error(s, vt) {
            return (*s).t_error
        }
        if note != KEIN {
            if types.ty_kind(table(s), note) == types.K_ARR {
                if !types.compatible(table(s), vt, types.ty_a(table(s), note)) {
                    complain(s)
                }
                if types.ty_n(table(s), note) != n {
                    complain(s)
                }
            }
        }
        return types.new_ty(table(s), types.K_ARR, vt, n)
    }
    // Array-Literal
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    var is_arr: bool = false
    if note != KEIN {
        is_arr = types.ty_kind(table(s), note) == types.K_ARR
    }
    if is_arr {
        let et: u32 = types.ty_a(table(s), note)
        if cnt as u64 != types.ty_n(table(s), note) {
            complain(s)
        }
        var k: u32 = 0
        while k < cnt {
            let t: u32 = expr(s, ast.child_at(b, off + k), et)
            if !types.compatible(table(s), t, et) {
                complain(s)
            }
            k = k + 1
        }
        return types.new_ty(table(s), types.K_ARR, et, types.ty_n(table(s), note))
    }
    var k: u32 = 0
    while k < cnt {
        infer(s, ast.child_at(b, off + k))
        k = k + 1
    }
    complain(s)
    return (*s).t_error
}

// ------------------------------------------------- enum/match (sema_match.rs)
//
// Portierung der Typpruefung fuer Aufzaehlungen und Musterabgleich.
// Wie ueberall in dieser Datei: Fehler werden GEZAEHLT, nicht beschrieben.

// Subjekt-Arten des Musterabgleichs (Subject in sema_match.rs).
const SJ_BAD: u32 = 0
const SJ_ENUM: u32 = 1
const SJ_BOOL: u32 = 2
const SJ_INT: u32 = 3

// `Enum::Variante(args..)` pruefen. Liefert den Aufzaehlungstyp.
fn ctor_check(s: *mut Sema, name: u32, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    // Den Namen an der ersten Doppelpunktsstelle teilen.
    let it: *mut intern.Interner = names(s)
    let zp: u64 = intern.intern_ptr(it, name)
    let zn: usize = intern.intern_length(it, name)
    var ename: u32 = KEIN
    var vname: u32 = KEIN
    var i: usize = 0
    while i + 1 < zn {
        if rt.ld8(zp, i) == 58 as u8 && rt.ld8(zp, i + 1) == 58 as u8 {
            ename = intern.intern_number(it, zp, i) as u32
            vname = intern.intern_number(it, zp + (i + 2) as u64, zn - i - 2) as u32
            break
        }
        i = i + 1
    }
    let ei: u32 = pattern.pat_enum_find(mu(s), ename)
    if ei == KEIN {
        // unbekannte aufzaehlung
        var k: u32 = 0
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let vi: u32 = pattern.pat_variant_find(mu(s), ei, vname)
    if vi == KEIN {
        // aufzaehlung hat diese variante nicht
        var k2: u32 = 0
        while k2 < cnt {
            infer(s, ast.child_at(b, off + k2))
            k2 = k2 + 1
        }
        complain(s)
        return (*s).t_error
    }
    let roff: u32 = pattern.pat_v_roff(mu(s), vi)
    let flen: u32 = pattern.pat_v_tlen(mu(s), vi)
    if cnt != flen {
        complain(s)
    }
    var k3: u32 = 0
    while k3 < cnt {
        let arg: u32 = ast.child_at(b, off + k3)
        if k3 < flen {
            let want: u32 = pattern.pat_rf_ty(mu(s), roff + k3)
            let got: u32 = expr(s, arg, want)
            if !types.compatible(table(s), got, want) {
                complain(s)
            }
        } else {
            infer(s, arg)
        }
        k3 = k3 + 1
    }
    return types.new_ty(table(s), types.K_STRUCT, pattern.pat_e_sidx(mu(s), ei), 0)
}

// Passt der Musterwert in den Typ? (fits in sema_match.rs)
fn fits_in(s: *mut Sema, v: i64, t: u32) -> bool {
    let bits: u32 = types.bits_of(table(s), t)
    if bits == 0 {
        return true
    }
    if types.is_sign(table(s), t) {
        if bits >= 64 {
            return true
        }
        let lo: i64 = 0 - (1 << (bits - 1) as i64)
        let hi: i64 = (1 << (bits - 1) as i64) - 1
        return v >= lo && v <= hi
    }
    if v < 0 {
        return false
    }
    if bits >= 64 {
        // GRENZE: `u64`-Marken jenseits von `i64::MAX` lassen sich hier nicht
        // niederschreiben (Stufe 0 rechnet mit i128) — siehe pattern.fi.
        return true
    }
    return (v as u64) < (1 << bits as i64) as u64
}

// Prueft ein Muster gegen den erwarteten Typ und legt seine Bindungen an.
fn pattern_check(s: *mut Sema, pat: u32, ty: u32, sj_kind: u32, sj_ei: u32,
                  top: bool) {
    let m: *mut pattern.Pat = mu(s)
    let a: u32 = pattern.pat_mu_kind(m, pat)
    if a == pattern.MU_WILD {
        return
    }
    if a == pattern.MU_BIND {
        var_create(s, pattern.pat_mu_a(m, pat), ty)
        return
    }
    if a == pattern.MU_BOOL {
        if !is_bool(s, ty) && !is_error(s, ty) {
            complain(s)
        }
        return
    }
    if a == pattern.MU_INT {
        if !is_int(s, ty) && !is_error(s, ty) {
            complain(s)
            return
        }
        if !is_error(s, ty) {
            if !fits_in(s, pattern.pat_mu_lo(m, pat), ty) {
                complain(s)
            }
        }
        return
    }
    if a == pattern.MU_BEREICH {
        if !is_int(s, ty) && !is_error(s, ty) {
            complain(s)
            return
        }
        if !is_error(s, ty) {
            if !fits_in(s, pattern.pat_mu_lo(m, pat), ty) {
                complain(s)
                return
            }
            if !fits_in(s, pattern.pat_mu_hi(m, pat), ty) {
                complain(s)
            }
        }
        return
    }
    // MU_VARIANT
    let ename: u32 = pattern.pat_mu_a(m, pat)
    var ei: u32 = KEIN
    if ename != ast.NICHTS {
        ei = pattern.pat_enum_find(m, ename)
        if ei == KEIN {
            complain(s)
            return
        }
    } else {
        // Ohne Namen: die Aufzaehlung kommt aus dem erwarteten Typ.
        if types.ty_kind(table(s), ty) == types.K_STRUCT {
            ei = pattern.pat_enum_at_struct(m, types.ty_a(table(s), ty))
        }
        if ei == KEIN {
            return
        }
    }
    let want: u32 = types.new_ty(table(s), types.K_STRUCT, pattern.pat_e_sidx(m, ei), 0)
    if !is_error(s, ty) {
        if !types.ty_equal(table(s), ty, want) {
            complain(s)
            return
        }
    }
    if top {
        if sj_kind == SJ_ENUM && sj_ei != ei {
            complain(s)
            return
        }
    }
    let vi: u32 = pattern.pat_variant_find(m, ei, pattern.pat_mu_b(m, pat))
    if vi == KEIN {
        complain(s)
        return
    }
    let soff: u32 = pattern.pat_mu_soff(m, pat)
    let slen: u32 = pattern.pat_mu_slen(m, pat)
    let roff: u32 = pattern.pat_v_roff(m, vi)
    let flen: u32 = pattern.pat_v_tlen(m, vi)
    if slen != flen {
        complain(s)
    }
    var k: u32 = 0
    while k < slen {
        if k < flen {
            let ft: u32 = pattern.pat_rf_ty(m, roff + k)
            pattern_check(s, pattern.pat_mu_child(m, soff + k), ft, sj_kind, sj_ei, false)
        }
        k = k + 1
    }
}

// Das `match` mit der Nummer `mi` pruefen (check_match in sema_match.rs).
fn match_check(s: *mut Sema, mi: u32) {
    let m: *mut pattern.Pat = mu(s)
    if mi as usize >= pattern.pat_match_count(m) {
        complain(s)
        return
    }
    let subj: u32 = pattern.pat_m_subj(m, mi)
    let sty: u32 = expr(s, subj, KEIN)
    // Das Subjekt klassifizieren: Aufzaehlung, bool, Ganzzahl — sonst Fehler.
    var sj_kind: u32 = SJ_BAD
    var sj_ei: u32 = KEIN
    if is_error(s, sty) {
        sj_kind = SJ_BAD
    } else if types.ty_kind(table(s), sty) == types.K_STRUCT {
        let ei: u32 = pattern.pat_enum_at_struct(m, types.ty_a(table(s), sty))
        if ei == KEIN {
            // 'match' auf einem gewoehnlichen Struct: Fehler.
            complain(s)
            sj_kind = SJ_BAD
        } else {
            sj_kind = SJ_ENUM
            sj_ei = ei
        }
    } else if is_bool(s, sty) {
        sj_kind = SJ_BOOL
    } else if is_int(s, sty) {
        sj_kind = SJ_INT
    } else {
        complain(s)
        sj_kind = SJ_BAD
    }
    // Der erwartete Typ der Muster.
    var mty: u32 = sty
    if sj_kind == SJ_ENUM {
        mty = types.new_ty(table(s), types.K_STRUCT, pattern.pat_e_sidx(m, sj_ei), 0)
    } else if sj_kind == SJ_BOOL {
        mty = (*s).t_bool
    }
    // 1. Je Fall: eigener Bereich, Muster pruefen, Rumpf pruefen.
    let aoff: u32 = pattern.pat_m_aoff(m, mi)
    let alen: u32 = pattern.pat_m_alen(m, mi)
    var ai: u32 = 0
    while ai < alen {
        range_on(s)
        pattern_check(s, pattern.pat_a_pat(m, aoff + ai), mty, sj_kind, sj_ei, true)
        block(s, pattern.pat_a_block(m, aoff + ai), true)
        range_zu(s)
        ai = ai + 1
    }
    // 2. Unerreichbarkeit: nach einem immer zutreffenden Fall kommt nichts.
    var has_catch: bool = false
    ai = 0
    while ai < alen {
        if has_catch {
            complain(s)
            break
        }
        if pattern.pat_irrefutable(m, pattern.pat_a_pat(m, aoff + ai)) {
            has_catch = true
        }
        ai = ai + 1
    }
    // 3. VOLLSTAENDIGKEIT — ein fehlender Fall ist ein FEHLER (SPEC §6.3).
    if sj_kind == SJ_BAD {
        return
    }
    if has_catch {
        return
    }
    if sj_kind == SJ_INT {
        // Ohne Auffangfall ist ein Ganzzahl-match nie vollstaendig.
        complain(s)
        return
    }
    if sj_kind == SJ_BOOL {
        var has_w: bool = false
        var has_f: bool = false
        ai = 0
        while ai < alen {
            let pat: u32 = pattern.pat_a_pat(m, aoff + ai)
            if pattern.pat_mu_kind(m, pat) == pattern.MU_BOOL {
                if pattern.pat_mu_a(m, pat) == 1 {
                    has_w = true
                } else {
                    has_f = true
                }
            }
            ai = ai + 1
        }
        if !has_w || !has_f {
            complain(s)
        }
        return
    }
    // SJ_ENUM: jede Variante muss einen Fall haben, dessen Untermuster alle
    // unanfechtbar sind.
    let voff: u32 = pattern.pat_e_voff(m, sj_ei)
    let vlen: u32 = pattern.pat_e_vlen(m, sj_ei)
    var v: u32 = 0
    while v < vlen {
        let vname: u32 = pattern.pat_v_name(m, voff + v)
        var covered: bool = false
        ai = 0
        while ai < alen {
            let pat: u32 = pattern.pat_a_pat(m, aoff + ai)
            if pattern.pat_mu_kind(m, pat) == pattern.MU_VARIANT {
                if pattern.pat_mu_b(m, pat) == vname {
                    var all_un: bool = true
                    let soff: u32 = pattern.pat_mu_soff(m, pat)
                    let slen: u32 = pattern.pat_mu_slen(m, pat)
                    var k: u32 = 0
                    while k < slen {
                        if !pattern.pat_irrefutable(m, pattern.pat_mu_child(m, soff + k)) {
                            all_un = false
                        }
                        k = k + 1
                    }
                    if all_un {
                        covered = true
                    }
                }
            }
            ai = ai + 1
        }
        if !covered {
            complain(s)
        }
        v = v + 1
    }
}

// ------------------------------------------------------------- Anweisungen

// -------------------------------------- fehlerunionen (errors.rs)
//
// Portierung der Typpruefung fuer `try`, `catch`, `Menge::Variante` und die
// implizite Umwandlung. Wie ueberall in dieser Datei: Fehler werden
// GEZAEHLT, nicht beschrieben.

// `try a` (check_try in errors.rs). Liefert den Erfolgstyp der Union.
fn try_check(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let arg: u32 = ast.child_at(b, ast.e_b(b, e))
    let got: u32 = expr(s, arg, KEIN)
    let u: u32 = err.error_union_of_ty(fe(s), table(s), got)
    if u == KEIN {
        // 'try' erwartet einen wert einer fehlerunion
        if !is_error(s, got) {
            complain(s)
        }
        return (*s).t_error
    }
    let val: u32 = err.error_u_valty(fe(s), u)
    let ru: u32 = err.error_union_of_ty(fe(s), table(s), (*s).ret)
    if ru == KEIN {
        // 'try' ausserhalb einer funktion mit fehlerunions-rueckgabetyp
        complain(s)
        return val
    }
    if err.error_u_set(fe(s), ru) != err.error_u_set(fe(s), u) {
        // beide fehlermengen muessen dieselbe sein
        complain(s)
        return val
    }
    err.error_try_set(fe(s), e, u)
    return val
}

// `a catch b` (check_catch in errors.rs). Liefert den Erfolgstyp der Union.
fn catch_check(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let lhs: u32 = ast.child_at(b, off)
    let rhs: u32 = ast.child_at(b, off + 1)
    let got: u32 = expr(s, lhs, KEIN)
    let u: u32 = err.error_union_of_ty(fe(s), table(s), got)
    if u == KEIN {
        // 'catch' erwartet links einen wert einer fehlerunion
        if !is_error(s, got) {
            complain(s)
        }
        infer(s, rhs)
        return (*s).t_error
    }
    let want: u32 = err.error_u_valty(fe(s), u)
    // `catch |f| ersatz`: der Fehlerwert ist im Ersatz sichtbar — mit dem
    // Typ der MENGE (dem reinen Fehlerwert).
    let bind: u32 = err.error_cb(fe(s), e)
    if bind != KEIN {
        range_on(s)
        let st: u32 = err.error_set_ty(fe(s), table(s),
                                            err.error_u_set(fe(s), u))
        var_create(s, bind, st)
    }
    let rt: u32 = expr(s, rhs, want)
    if bind != KEIN {
        range_zu(s)
    }
    if !is_error(s, rt) && !types.compatible(table(s), rt, want) {
        complain(s)
    }
    err.error_catch_set(fe(s), e, u)
    return want
}

// `Menge::Variante` — der reine Fehlerwert (der Konstruktor-Ast von
// errors.rs::hook_call). Die Menge existiert; das hat der Aufrufer geprueft.
fn error_ctor_check(s: *mut Sema, en: u32, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    var k: u32 = 0
    while k < cnt {
        infer(s, ast.child_at(b, off + k))
        k = k + 1
    }
    if cnt > 0 {
        // die fehlervariante traegt keine nutzdaten
        complain(s)
    }
    if err.error_ctor_code((*s).feh, names(s), ast.e_a(b, e)) < 0 {
        // unbekannte variante
        complain(s)
        return (*s).t_error
    }
    return err.error_set_ty(fe(s), table(s),
                                 err.error_set_find(fe(s), en))
}

// Implizite Umwandlung in eine Fehlerunion an `return`/`let`/Zuweisung/
// Argument/Feld (hook_coerce in errors.rs). Liefert false, wenn `want`
// keine Fehlerunion ist — dann laeuft die gewoehnliche Pruefung.
fn coerce_check(s: *mut Sema, e: u32, want: u32) -> bool {
    let u: u32 = err.error_union_of_ty(fe(s), table(s), want)
    if u == KEIN {
        return false
    }
    let uv: u32 = err.error_u_valty(fe(s), u)
    let got: u32 = expr(s, e, uv)
    if is_error(s, got) {
        return true
    }
    if types.ty_equal(table(s), got, want) {
        // schon eine Fehlerunion — nichts umzuwandeln
        return true
    }
    let sm: u32 = err.error_set_of_ty(fe(s), table(s), got)
    if sm != KEIN {
        if sm == err.error_u_set(fe(s), u) {
            err.error_coerce_set(fe(s), e, err.FEHLER_AUS_FEHLER, u)
            return true
        }
        // fehlerwert einer anderen menge
        complain(s)
        return true
    }
    if types.compatible(table(s), got, uv) {
        err.error_coerce_set(fe(s), e, err.FEHLER_AUS_WERT, u)
        return true
    }
    complain(s)
    return true
}

// Ist der Ausdruck ERKENNBAR ein Fehlerwert (`quiet_set` in errors.rs):
// eine Variante `E::V` oder eine Variable vom Typ einer Fehlermenge.
fn error_quiet_set(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_RUF {
        var en: u32 = KEIN
        var vn: u32 = KEIN
        err.error_name_split((*s).feh, names(s), ast.e_a(b, e), &en, &vn)
        if en != KEIN {
            return err.error_set_find(fe(s), en)
        }
        return KEIN
    }
    if a == ast.E_ID {
        let v: u32 = var_search(s, ast.e_a(b, e))
        if v != KEIN {
            return err.error_set_of_ty(fe(s), table(s), v)
        }
    }
    return KEIN
}

fn cond(s: *mut Sema, e: u32) {
    let t: u32 = expr(s, e, (*s).t_bool)
    if !is_error(s, t) && !is_bool(s, t) {
        complain(s)
    }
}

fn stmt(s: *mut Sema, i: u32) {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.s_kind(b, i)

    if a == ast.S_LET || a == ast.S_VAR {
        let te: u32 = ast.s_b(b, i)
        var t: u32 = 0
        if te != ast.NICHTS {
            let d: u32 = ast_ty(s, te)
            // HOOK fehlerunionen: implizite Umwandlung bei 'let'.
            var converted: bool = false
            if has_fe(s) {
                converted = coerce_check(s, ast.s_c(b, i), d)
            }
            if !converted {
                let got: u32 = expr(s, ast.s_c(b, i), d)
                if !types.compatible(table(s), got, d) {
                    complain(s)
                }
            }
            t = d
        } else {
            let got: u32 = expr(s, ast.s_c(b, i), KEIN)
            if types.ty_kind(table(s), got) == types.K_VOID {
                complain(s)
                t = (*s).t_error
            } else {
                t = got
            }
        }
        var_create(s, ast.s_a(b, i), t)
        return
    }
    if a == ast.S_ZUW {
        let t: u32 = lvalue(s, ast.s_a(b, i))
        if t == KEIN {
            expr(s, ast.s_b(b, i), (*s).t_i64)
            return
        }
        // HOOK fehlerunionen: implizite Umwandlung bei der Zuweisung.
        if has_fe(s) && coerce_check(s, ast.s_b(b, i), t) {
            return
        }
        let got: u32 = expr(s, ast.s_b(b, i), t)
        if !types.compatible(table(s), got, t) {
            complain(s)
        }
        return
    }
    if a == ast.S_IF {
        cond(s, ast.s_a(b, i))
        block(s, ast.s_b(b, i), false)
        if ast.s_c(b, i) != ast.NICHTS {
            stmt(s, ast.s_c(b, i))
        }
        return
    }
    if a == ast.S_WHILE {
        cond(s, ast.s_a(b, i))
        block(s, ast.s_b(b, i), false)
        return
    }
    if a == ast.S_FOR {
        var want: u32 = probe(s, ast.s_b(b, i))
        if want == KEIN {
            want = probe(s, ast.s_c(b, i))
        }
        let st: u32 = expr(s, ast.s_b(b, i), want)
        var w2: u32 = want
        if w2 == KEIN {
            w2 = st
        }
        let et: u32 = expr(s, ast.s_c(b, i), w2)
        var t: u32 = (*s).t_error
        if is_error(s, st) || is_error(s, et) {
            t = (*s).t_error
        } else if !is_int(s, st) || !is_int(s, et) || !types.ty_equal(table(s), st, et) {
            complain(s)
            t = (*s).t_error
        } else {
            t = st
        }
        range_on(s)
        var_create(s, ast.s_a(b, i), t)
        block(s, ast.s_d(b, i), true)
        range_zu(s)
        return
    }
    if a == ast.S_RET {
        let w: u32 = (*s).ret
        if ast.s_a(b, i) == ast.NICHTS {
            if types.ty_kind(table(s), w) != types.K_VOID && !is_error(s, w) {
                complain(s)
            }
            return
        }
        if types.ty_kind(table(s), w) == types.K_VOID {
            expr(s, ast.s_a(b, i), (*s).t_i64)
            complain(s)
            return
        }
        // HOOK fehlerunionen: implizite Umwandlung bei 'return'
        // (errors.rs::hook_coerce in check_stmt).
        if has_fe(s) && coerce_check(s, ast.s_a(b, i), w) {
            return
        }
        let got: u32 = expr(s, ast.s_a(b, i), w)
        if !types.compatible(table(s), got, w) {
            complain(s)
        }
        return
    }
    if a == ast.S_DEFER || a == ast.S_ERRDEFER {
        stmt(s, ast.s_a(b, i))
        return
    }
    if a == ast.S_EXPR {
        let e2: u32 = ast.s_a(b, i)
        let et: u32 = expr(s, e2, KEIN)
        // "Ergebnis eines Aufrufs wird als Anweisung verworfen"
        // (sema.rs::check_discard): HOOK fehlerunionen — ein `E!T`-Wert ist
        // implizit #[must_consume] (SPEC §5.1); dazu seit Runde 36 die
        // ausdrueckliche Kennzeichnung an Funktion oder Typ (SPEC §3.3).
        if ast.e_kind(b, e2) == ast.E_RUF && ast.e_number(b, e2) == 0 {
            var discarded: bool = false
            if has_fe(s) && err.error_union_of_ty(fe(s), table(s), et) != KEIN {
                discarded = true
            }
            if !discarded {
                var mj: usize = 0
                while mj < vec_len[u32](&(*s).mc_fname) {
                    if vec_at[u32](&(*s).mc_fname, mj) == ast.e_a(b, e2) {
                        discarded = true
                    }
                    mj = mj + 1
                }
            }
            if !discarded && !is_error(s, et) && types.ty_kind(table(s), et) == types.K_STRUCT {
                var mk: usize = 0
                while mk < vec_len[u32](&(*s).mc_si) {
                    if vec_at[u32](&(*s).mc_si, mk) == types.ty_a(table(s), et) {
                        discarded = true
                    }
                    mk = mk + 1
                }
            }
            if discarded {
                complain(s)
            }
        }
        return
    }
    if a == ast.S_BLOCK {
        block(s, ast.s_a(b, i), false)
        return
    }
    // break / continue: der Parser hat die Lage schon geprueft.
}

fn block(s: *mut Sema, bi: u32, range_already_open: bool) {
    let b: *mut ast.Tree = tree(s)
    if !range_already_open {
        range_on(s)
    }
    var k: u32 = 0
    while k < ast.b_len(b, bi) {
        stmt(s, ast.slist_at(b, ast.b_off(b, bi) + k))
        k = k + 1
    }
    if !range_already_open {
        range_zu(s)
    }
}

// ------------------------------------------------------------------- Lauf

fn sema_run(s: *mut Sema) {
    let b: *mut ast.Tree = tree(s)
    // 0. Aufzaehlungen: NAMEN anmelden, damit Structs und Signaturen sie
    //    benennen koennen (vor dem Structlayout — genau wie `declare_enums`
    //    vor `collect_structs` in Stufe 0).
    if has_mu(s) {
        pattern.pat_register(mu(s), table(s))
    }
    // 0b. Fehlermengen: NAMEN anmelden — nach den Aufzaehlungen, vor den
    //    Structs des Baums, genau wie `declare_error_sets` in Stufe 0. Die
    //    Typaufloesung bekommt das Register, damit sie `__eu#<n>`-Platzhalter
    //    aufloesen kann.
    var fe_sofar: usize = 0
    if has_fe(s) {
        err.error_register((*s).feh, table(s), names(s))
        types.types_error_set(table(s), (*s).feh)
    }
    // 0c. gc-Klassen: als Structs anmelden — NACH den Fehlermengen, VOR den
    //    Structs des Baums, genau wie `declare_classes` in Stufe 0. Die
    //    Typaufloesung bekommt das Register, damit sie `__gc#p:`/`__gc#w:`-
    //    Platzhalter aufloesen kann (derselbe Uebergabepunkt wie `__eu#<n>`).
    var gc_sofar: usize = 0
    if has_gc(s) {
        // RUNDE 52 (prof.rs): `gc class` braucht den Tracing-Sammler; im
        // Kernel-Profil gibt es keine GC-Typen (SPEC 2).
        if (*s).kernel && gc.gc_has_classes((*s).gc as *mut gc.Gc) {
            complain(s)
        }
        gc.gc_register((*s).gc, table(s), names(s))
        types.types_gc_set(table(s), (*s).gc)
    }
    // 0d. Schnittstellen: `dyn I` als Struct anmelden — VOR den Structs des
    //    Baums, genau wie `declare_interfaces` in Stufe 0. Ein eigener Haken
    //    in der Typaufloesung ist nicht noetig: der Struct traegt den Namen
    //    `"dyn I"`, und den findet `aufloesen` wie jeden anderen.
    var if_sofar: usize = 0
    if has_if(s) {
        iface.if_register((*s).ifr, table(s), names(s))
    }
    // 1. Structlayout und Funktionssignaturen — dieselbe Rechnung wie in
    //    `types.fi`, hier einmal fuer alles.
    types.types_resolve(table(s), b, names(s))
    // 1a. Schnittstellen: jede Umsetzung vollstaendig pruefen — alle Methoden
    //    da, alle Signaturen passend (`hook_check_impls` in Stufe 0). Laeuft
    //    NACH den Signaturen und VOR den Rumpfen.
    if has_if(s) {
        let ij: usize = iface.if_check((*s).ifr, table(s), b, names(s))
        while if_sofar < ij {
            complain(s)
            if_sofar = if_sofar + 1
        }
    }
    // 1b. `#[must_consume]` einsammeln (sema.rs::check_attrs, Runde 36):
    //    gekennzeichnete Funktionen ueber ihren NAMEN, gekennzeichnete Typen
    //    ueber ihren Structindex (die Typnummer ist nicht stabil — `neuer_typ`
    //    vergibt je Aufruf eine neue).
    var mi: usize = 0
    while mi < ast.fn_count(b) {
        if ast.fn_mc(b, mi) == 1 {
            vec_push[u32](&(*s).mc_fname, ast.fn_name(b, mi))
        }
        mi = mi + 1
    }
    mi = 0
    while mi < ast.structure_count(b) {
        if ast.structure_mc(b, mi) == 1 {
            let si: i32 = types.struct_index(table(s), ast.structure_name(b, mi))
            if si >= 0 {
                vec_push[u32](&(*s).mc_si, si as u32)
            }
        }
        mi = mi + 1
    }
    if has_fe(s) {
        // Fehler aus der Registrierung mitzaehlen (doppelte Mengen,
        // unbekannte Mengen, Unionen als verbotener Feldtyp).
        let fj: usize = err.error_error(fe(s))
        while fe_sofar < fj {
            complain(s)
            fe_sofar = fe_sofar + 1
        }
    }
    // 1b. Aufzaehlungen: LAYOUTS eintragen — nach dem Structlayout der
    //    Handstructschreibungen, vor jedem Gebrauch (`layout_enums` in
    //    Stufe 0). Fehler daraus zaehlen mit.
    if has_mu(s) {
        let mf: u32 = pattern.pat_layout(mu(s), table(s), b, names(s))
        var mk: u32 = 0
        while mk < mf {
            complain(s)
            mk = mk + 1
        }
    }
    // 1c. gc-Klassen: Feldlayout festlegen — erst hier sind die Structs des
    //    Programms bekannt (`layout_classes` in Stufe 0). Fehler daraus
    //    (unbekannte Basis, Ringe, verbotene Feldtypen) zaehlen mit.
    if has_gc(s) {
        gc.gc_layout((*s).gc, table(s), b, names(s))
        let gj: usize = gc.gc_error(gcp(s))
        while gc_sofar < gj {
            complain(s)
            gc_sofar = gc_sofar + 1
        }
    }

    // 2. Grundtypen anlegen, damit sie nicht bei jedem Zugriff neu entstehen.
    (*s).t_bool = types.new_ty(table(s), types.K_BOOL, 0, 0)
    (*s).t_i64 = types.new_ty(table(s), types.K_I64, 0, 0)
    (*s).t_usize = types.new_ty(table(s), types.K_USIZE, 0, 0)
    (*s).t_void = types.new_ty(table(s), types.K_VOID, 0, 0)
    (*s).t_error = types.new_ty(table(s), types.K_FEHLER, 0, 0)
    (*s).t_f64 = types.new_ty(table(s), types.K_F64, 0, 0)

    // 3. Typtabelle fuer alle Ausdruecke anlegen.
    var i: usize = 0
    while i < ast.expr_count(b) {
        vec_push[u32](&(*s).etyp, (*s).t_error)
        i = i + 1
    }

    // 4. Konstanten der Reihe nach: eine spaetere darf eine fruehere benutzen.
    range_on(s)
    i = 0
    while i < ast.const_count(b) {
        let t: u32 = ast_ty(s, ast.const_ty(b, i))
        let got: u32 = expr(s, ast.const_value(b, i), t)
        if !types.compatible(table(s), got, t) {
            complain(s)
        }
        var good: bool = true
        let v: i64 = const_eval(s, ast.const_value(b, i), &good)
        vec_push[u32](&(*s).k_name, ast.const_name(b, i))
        vec_push[u32](&(*s).k_ty, t)
        if good {
            vec_push[u64](&(*s).k_value, wrap(s, v, t) as u64)
        } else {
            vec_push[u64](&(*s).k_value, 0)
            complain(s)
        }
        i = i + 1
    }

    // 5. Funktionsrumpfe.
    i = 0
    while i < ast.fn_count(b) {
        (*s).ret = types.ret_ty_the_func(table(s), i)
        range_on(s)
        var k: u32 = 0
        while k < ast.fn_plen(b, i) {
            var_create(s, ast.param_name(b, ast.fn_poff(b, i) + k),
                        types.param_ty_resolved(table(s), i, k))
            k = k + 1
        }
        block(s, ast.fn_body(b, i), true)
        range_zu(s)
        i = i + 1
    }
    range_zu(s)
    if has_fe(s) {
        // Unionen, die erst in einem RUMPF aufgeloest wurden (etwa
        // `let r: E!i32 = ...`), koennen dort noch Fehler gezaehlt haben.
        let fj: usize = err.error_error(fe(s))
        while fe_sofar < fj {
            complain(s)
            fe_sofar = fe_sofar + 1
        }
    }
    if has_gc(s) {
        // gc-Typfehler, die erst in einem RUMPF auftraten (unbekannte
        // Klasse in `Gc[...]`, Klassenname als Werttyp).
        let gj: usize = gc.gc_error(gcp(s))
        while gc_sofar < gj {
            complain(s)
            gc_sofar = gc_sofar + 1
        }
        // 6. `#[no_gc]` transitiv pruefen (nogc.rs). Laeuft NACH der
        //    Typpruefung, weil Regel 3 (Schreiben in ein Gc[T]-Feld) die
        //    Typtabelle braucht.
        var mu2: u64 = 0
        if has_mu(s) {
            mu2 = (*s).mu
        }
        let nf: usize = nogc.nogc_check(s as u64, mu2, (*s).gc, (*s).it)
        var nk: usize = 0
        while nk < nf {
            complain(s)
            nk = nk + 1
        }
    }
}
