// lib/firnc1/sema.fi -- THE TYPE CHECKER, WRITTEN IN FIRN.
//
// Sixth part of stage 1 and the largest so far: the port of the core
// of `compiler/src/sema.rs`. It checks what `firnc0` guarantees --
// **every expression gets a concrete type**.
//
// THE METHOD IS BIDIRECTIONAL. In Firn an integer literal carries no type
// of its own; it comes from the context:
//
//     let x: i32 = 5        the context makes the 5 an i32
//     a + 1                 the 1 takes the type of `a`
//     5                     on its own: ERROR, nothing to infer from
//
// There are therefore two passes over the same tree:
//   * `probe` works out the type WITHOUT reporting and without writing to
//     the table, so that in `a + 1` the literal gets its type from `a`;
//   * `expr` really checks and records the type.
// The order is part of the contract: the already typed operand first, then
// the context. Otherwise `let x: i64 = a + 1` (a: i32) reports the error in
// the wrong place.
//
// NOT PORTED (and said here plainly): the error messages. The Firn version
// COUNTS errors, it does not describe them. The comparison only ever runs
// on sources that `firnc0` accepts without errors -- there the number of
// messages is zero and what matters are the types. Also missing are the
// reachability analysis (`return` at the end), the mutability check
// (`let` versus `var`) and the recursion check for structs.

import rt
import vec
import intern
import ast
import types
import pattern
import err
import gc
import iface
import core
import nogc

export { Sema, sema_new, sema_free, sema_run, sema_error, sema_ty,
         sema_types, sema_ty_count, sema_needs_comptime, sema_const_value,
         sema_mu_set, sema_fe_set, sema_gc_set, sema_if_set,
         sema_kernel_set,
         sema_tree }

const NONE: u32 = 4294967295

struct Sema {
    b: u64,              // pointer to the tree
    it: u64,             // pointer to the interner
    ty: types.Types,
    etyp: Vec[u32],      // type per expression node
    v_name: Vec[u32],    // scopes: names, types and bounds
    v_ty: Vec[u32],
    b_limit: Vec[u32],
    k_name: Vec[u32],    // constants
    k_ty: Vec[u32],
    k_value: Vec[u64],
    t_bool: u32,         // prebuilt types
    t_i64: u32,
    t_usize: u32,
    t_void: u32,
    t_error: u32,
    t_f64: u32,
    ret: u32,            // return type of the current function
    mu: u64,             // registry of enumerations/pattern matches (0 = none)
    feh: u64,            // registry of error sets/unions (0 = none)
    gc: u64,             // registry of the gc classes (round 34; 0 = none)
    ifr: u64,            // registry of the interfaces (round 46; 0 = none)
    // `#[must_consume]` (round 36, attrs.rs/sema.rs::check_attrs): intern numbers
    // of the marked functions and struct INDICES of the marked types.
    mc_fname: Vec[u32],
    mc_si: Vec[u32],
    err: usize,
    // ROUND 52 (SPEC 2): the kernel profile. It is resolved in
    // `bin/firnc1.fi` (from the declaration or `--profile=`); here it is
    // only enforced.
    kernel: bool,
    ct_needed: bool,     // a constant needs evaluation at compile time
}

fn sema_new(b: u64, it: u64) -> Sema {
    return Sema{
        b: b, it: it,
        ty: types.types_new(),
        etyp: vec_new[u32](),
        v_name: vec_new[u32](), v_ty: vec_new[u32](), b_limit: vec_new[u32](),
        k_name: vec_new[u32](), k_ty: vec_new[u32](), k_value: vec_new[u64](),
        t_bool: 0, t_i64: 0, t_usize: 0, t_void: 0, t_error: 0, t_f64: 0,
        ret: 0, mu: 0, feh: 0, gc: 0, ifr: 0, mc_fname: vec_new[u32](), mc_si: vec_new[u32](),
        err: 0, kernel: false, ct_needed: false,
    }
}

fn sema_free(s: *mut Sema) {
    types.types_free(&(*s).ty)
    vec_free[u32](&(*s).etyp)
    vec_free[u32](&(*s).v_name)
    vec_free[u32](&(*s).v_ty)
    vec_free[u32](&(*s).b_limit)
    vec_free[u32](&(*s).k_name)
    vec_free[u32](&(*s).k_ty)
    vec_free[u64](&(*s).k_value)
    vec_free[u32](&(*s).mc_fname)
    vec_free[u32](&(*s).mc_si)
}

fn sema_error(s: *mut Sema) -> usize { return (*s).err }

// Register the pattern registry. MUST happen before `sema_run`.
fn sema_mu_set(s: *mut Sema, m: u64) { (*s).mu = m }

fn mu(s: *mut Sema) -> *mut pattern.Pat { return (*s).mu as *mut pattern.Pat }
fn has_mu(s: *mut Sema) -> bool { return (*s).mu != 0 }

// Register the error registry. MUST happen before `sema_run`.
fn sema_fe_set(s: *mut Sema, f: u64) { (*s).feh = f }

fn fe(s: *mut Sema) -> *mut err.Error { return (*s).feh as *mut err.Error }
fn has_fe(s: *mut Sema) -> bool { return (*s).feh != 0 }

// Register the gc registry (round 34). MUST happen before `sema_run`.
fn sema_gc_set(s: *mut Sema, g: u64) { (*s).gc = g }

fn gcp(s: *mut Sema) -> *mut gc.Gc { return (*s).gc as *mut gc.Gc }
fn has_gc(s: *mut Sema) -> bool { return (*s).gc != 0 }

// Register the interface registry (round 46). MUST happen before
// `sema_run`.
fn sema_if_set(s: *mut Sema, f: u64) { (*s).ifr = f }

// ROUND 52 (SPEC 2): the kernel profile has neither `syscall` (there is no
// operating system below it) nor `gc class` (no global heap).
fn sema_kernel_set(s: *mut Sema, v: bool) { (*s).kernel = v }

fn ifp(s: *mut Sema) -> *mut iface.If { return (*s).ifr as *mut iface.If }
fn has_if(s: *mut Sema) -> bool { return (*s).ifr != 0 }

// The tree behind this run (for `nogc.fi`).
fn sema_tree(s: *mut Sema) -> *mut ast.Tree { return (*s).b as *mut ast.Tree }
fn sema_needs_comptime(s: *mut Sema) -> bool { return (*s).ct_needed }
fn sema_types(s: *mut Sema) -> *mut types.Types { return &(*s).ty }
fn sema_ty_count(s: *mut Sema) -> usize { return vec_len[u32](&(*s).etyp) }
fn sema_ty(s: *mut Sema, i: u32) -> u32 { return vec_at[u32](&(*s).etyp, i as usize) }

fn tree(s: *mut Sema) -> *mut ast.Tree { return (*s).b as *mut ast.Tree }
fn table(s: *mut Sema) -> *mut types.Types { return &(*s).ty }
fn names(s: *mut Sema) -> *mut intern.Interner { return (*s).it as *mut intern.Interner }

fn complain(s: *mut Sema) { (*s).err = (*s).err + 1 }

fn remember(s: *mut Sema, e: u32, t: u32) {
    vec_set[u32](&(*s).etyp, e as usize, t)
}

// -------------------------------------------------------------------- scopes

fn range_on(s: *mut Sema) {
    vec_push[u32](&(*s).b_limit, vec_len[u32](&(*s).v_name) as u32)
}

fn range_off(s: *mut Sema) {
    let g: u32 = vec_last[u32](&(*s).b_limit)
    vec_pop[u32](&(*s).b_limit)
    while vec_len[u32](&(*s).v_name) > g as usize {
        vec_pop[u32](&(*s).v_name)
        vec_pop[u32](&(*s).v_ty)
    }
}

fn var_create(s: *mut Sema, name: u32, t: u32) {
    vec_push[u32](&(*s).v_name, name)
    vec_push[u32](&(*s).v_ty, t)
}

// Search from the back: the innermost scope wins.
fn var_search(s: *mut Sema, name: u32) -> u32 {
    var i: usize = vec_len[u32](&(*s).v_name)
    while i > 0 {
        i = i - 1
        if vec_at[u32](&(*s).v_name, i) == name {
            return vec_at[u32](&(*s).v_ty, i)
        }
    }
    return NONE
}

fn const_search(s: *mut Sema, name: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*s).k_name) {
        if vec_at[u32](&(*s).k_name, i) == name {
            return vec_at[u32](&(*s).k_ty, i)
        }
        i = i + 1
    }
    return NONE
}

fn sema_const_value(s: *mut Sema, name: u32) -> u64 {
    return const_value(s, name)
}

fn const_value(s: *mut Sema, name: u32) -> u64 {
    var i: usize = 0
    while i < vec_len[u32](&(*s).k_name) {
        if vec_at[u32](&(*s).k_name, i) == name {
            return vec_at[u64](&(*s).k_value, i)
        }
        i = i + 1
    }
    return 0
}

// Index of the function with this name, or NONE.
fn fn_search(s: *mut Sema, name: u32) -> u32 {
    var i: usize = 0
    while i < ast.fn_count(tree(s)) {
        if ast.fn_name(tree(s), i) == name {
            return i as u32
        }
        i = i + 1
    }
    return NONE
}

// --------------------------------------------------------- helper questions

fn is_int(s: *mut Sema, t: u32) -> bool { return types.is_int(table(s), t) }
fn is_error(s: *mut Sema, t: u32) -> bool { return types.ty_kind(table(s), t) == types.K_ERROR }
fn is_bool(s: *mut Sema, t: u32) -> bool { return types.ty_kind(table(s), t) == types.K_BOOL }
fn is_f64(s: *mut Sema, t: u32) -> bool { return types.ty_kind(table(s), t) == types.K_F64 }

// May this type take part in an `as` conversion?
fn convertible(s: *mut Sema, t: u32) -> bool {
    return is_int(s, t) || is_bool(s, t) || types.is_ptr(table(s), t) || is_f64(s, t)
}

// Resolves a type expression of the tree.
fn ast_ty(s: *mut Sema, te: u32) -> u32 {
    return types.resolve(table(s), tree(s), names(s), te)
}

// ---------------------------------------------------------------- probe
//
// Type of an expression WITHOUT reporting and without writing to the table.
// NONE means "cannot be inferred" -- exactly like `Option::None` in sema.rs.

fn probe(s: *mut Sema, e: u32) -> u32 {
    return probe_t(s, e, 0)
}

fn probe_t(s: *mut Sema, e: u32, d: u32) -> u32 {
    if d >= 200 {
        return NONE
    }
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_INT {
        return NONE
    }
    if a == ast.E_FLOAT {
        return (*s).t_f64
    }
    if a == ast.E_BOOL {
        return (*s).t_bool
    }
    if a == ast.E_ID {
        let v: u32 = var_search(s, ast.e_a(b, e))
        if v != NONE {
            return v
        }
        return const_search(s, ast.e_a(b, e))
    }
    if a == ast.E_UN {
        let op: u32 = ast.e_a(b, e)
        if op == 0 {
            return probe_t(s, ast.e_b(b, e), d + 1)
        }
        if op == 1 {
            return (*s).t_bool
        }
        if op == 2 {
            let inner: u32 = probe_t(s, ast.e_b(b, e), d + 1)
            if inner == NONE {
                return NONE
            }
            return types.new_ty(table(s), types.K_PTR, inner, 1)
        }
        let p: u32 = probe_t(s, ast.e_b(b, e), d + 1)
        if p == NONE {
            return NONE
        }
        if types.ty_kind(table(s), p) != types.K_PTR {
            return NONE
        }
        return types.ty_a(table(s), p)
    }
    if a == ast.E_BIN {
        let op: u32 = ast.e_a(b, e)
        if op >= 10 {
            return (*s).t_bool
        }
        if op == 8 || op == 9 {
            return probe_t(s, ast.e_b(b, e), d + 1)
        }
        let l: u32 = probe_t(s, ast.e_b(b, e), d + 1)
        if l != NONE {
            return l
        }
        return probe_t(s, ast.e_c(b, e), d + 1)
    }
    if a == ast.E_FIELD {
        let bt: u32 = probe_t(s, ast.e_a(b, e), d + 1)
        if bt == NONE {
            return NONE
        }
        // HOOK gc: field access through a `Gc[T]`, without reporting
        // (sema.rs::probe_d via gc::hook_field_base).
        if has_gc(s) {
            let si: u32 = gc.gc_field_base(gcp(s), table(s), bt)
            if si != NONE {
                return types.st_field_ty(table(s), si as usize, ast.e_b(b, e))
            }
        }
        if types.ty_kind(table(s), bt) != types.K_STRUCT {
            return NONE
        }
        return types.st_field_ty(table(s), types.ty_a(table(s), bt) as usize, ast.e_b(b, e))
    }
    if a == ast.E_IDX {
        let bt: u32 = probe_t(s, ast.e_a(b, e), d + 1)
        if bt == NONE {
            return NONE
        }
        if types.ty_kind(table(s), bt) != types.K_ARR {
            return NONE
        }
        return types.ty_a(table(s), bt)
    }
    if a == ast.E_CALL {
        if ast.e_number(b, e) != 0 {
            return (*s).t_usize
        }
        // HOOK error unions: `try a`/`a catch b` yield the success type
        // of the error union (errors.rs::success_type via probe_d).
        if has_fe(s) {
            if err.error_is_resultname(names(s), ast.e_a(b, e)) {
                if ast.e_c(b, e) == 0 {
                    return NONE
                }
                let inner: u32 = probe_t(s, ast.child_at(b, ast.e_b(b, e)), d + 1)
                if inner == NONE {
                    return NONE
                }
                let u: u32 = err.error_union_of_ty(fe(s), table(s), inner)
                if u == NONE {
                    return NONE
                }
                return err.error_u_valty(fe(s), u)
            }
        }
        if has_gc(s) {
            // HOOK gc (gc.rs::probe_ty): `weak`/`strong`/`x.as?[C]` WITHOUT
            // checking, so that an integer literal next to it still gets
            // its type.
            var argt: u32 = NONE
            if ast.e_c(b, e) > 0 {
                argt = probe_t(s, ast.child_at(b, ast.e_b(b, e)), d + 1)
            }
            let pt: u32 = gc.gc_probe_ty(gcp(s), table(s), names(s), ast.e_a(b, e), argt)
            if pt != NONE {
                return pt
            }
        }
        // HOOK impl (impls.rs in sema::probe_d): the return type of the method,
        // without reporting and without writing -- otherwise a literal next
        // to it would get no type (`p.sum() != 42`).
        if is_method_call(names(s), ast.e_a(b, e)) {
            if ast.e_c(b, e) == 0 {
                return NONE
            }
            let et: u32 = probe_t(s, ast.child_at(b, ast.e_b(b, e)), d + 1)
            if et == NONE {
                return NONE
            }
            let sn: u32 = recv_struct(s, et)
            if sn == NONE {
                return NONE
            }
            let m: u32 = intern.intern_ab(names(s), ast.e_a(b, e), 7)
            // HOOK iface: for a `dyn I` the type comes from the interface,
            // not from the function table (iface.fi).
            if has_if(s) {
                let ii: u32 = iface.if_of_dyn(ifp(s), sn)
                if ii != NONE {
                    let k: u32 = iface.if_slot(ifp(s), ii as usize, m)
                    if k == NONE {
                        return NONE
                    }
                    return iface.if_rtyp(ifp(s), ii as usize, k)
                }
            }
            let mf: u32 = fn_search(s, method_func(s, sn, m))
            if mf == NONE {
                return NONE
            }
            return types.ret_ty_the_func(table(s), mf as usize)
        }
        let f: u32 = fn_search(s, ast.e_a(b, e))
        if f == NONE {
            return NONE
        }
        return types.ret_ty_the_func(table(s), f as usize)
    }
    if a == ast.E_SYSCALL {
        return (*s).t_i64
    }
    if a == ast.E_AS {
        return ast_ty(s, ast.e_b(b, e))
    }
    if a == ast.E_SLIT {
        let si: i32 = types.struct_index(table(s), ast.e_a(b, e))
        if si < 0 {
            return NONE
        }
        return types.new_ty(table(s), types.K_STRUCT, si as u32, 0)
    }
    if a == ast.E_ALIT {
        if ast.e_c(b, e) == 0 {
            return NONE
        }
        let et: u32 = probe_t(s, ast.child_at(b, ast.e_b(b, e)), d + 1)
        if et == NONE {
            return NONE
        }
        return types.new_ty(table(s), types.K_ARR, et, ast.e_c(b, e) as u64)
    }
    return NONE
}

// -------------------------------------------------- constant evaluation
//
// Needed for `const` and for the length of a repeat literal -- that length
// goes into the TYPE (`[T; N]`), so it has to be known here.

fn wrap(s: *mut Sema, v: i64, t: u32) -> i64 {
    let bits: u32 = types.bits_of(table(s), t)
    if bits == 0 || bits >= 64 {
        return v
    }
    let mask: i64 = (1 << bits as i64) - 1
    let m: i64 = v & mask
    if types.is_sign(table(s), t) {
        if (m >> (bits - 1) as i64) & 1 != 0 {
            return m - (1 << bits as i64)
        }
    }
    return m
}

fn const_eval(s: *mut Sema, e: u32, good: *mut bool) -> i64 {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_INT {
        return ast.e_number(b, e) as i64
    }
    if a == ast.E_BOOL {
        if ast.e_a(b, e) == 1 {
            return 1
        }
        return 0
    }
    if a == ast.E_ID {
        if const_search(s, ast.e_a(b, e)) == NONE {
            *good = false
            return 0
        }
        return const_value(s, ast.e_a(b, e)) as i64
    }
    if a == ast.E_UN {
        let v: i64 = const_eval(s, ast.e_b(b, e), good)
        let op: u32 = ast.e_a(b, e)
        if op == 0 {
            return 0 - v
        }
        if op == 1 {
            if v == 0 {
                return 1
            }
            return 0
        }
        *good = false
        return 0
    }
    if a == ast.E_BIN {
        let op: u32 = ast.e_a(b, e)
        let x: i64 = const_eval(s, ast.e_b(b, e), good)
        let y: i64 = const_eval(s, ast.e_c(b, e), good)
        var v: i64 = 0
        if op == 0 { v = x + y }
        else if op == 1 { v = x - y }
        else if op == 2 { v = x * y }
        else if op == 3 {
            if y == 0 {
                *good = false
                return 0
            }
            v = x / y
        }
        else if op == 4 {
            if y == 0 {
                *good = false
                return 0
            }
            v = x % y
        }
        else if op == 5 { v = x & y }
        else if op == 6 { v = x | y }
        else if op == 7 { v = x ^ y }
        else if op == 8 { v = x << y }
        else if op == 9 { v = x >> y }
        else if op == 10 { if x == y { v = 1 } }
        else if op == 11 { if x != y { v = 1 } }
        else if op == 12 { if x < y { v = 1 } }
        else if op == 13 { if x <= y { v = 1 } }
        else if op == 14 { if x > y { v = 1 } }
        else if op == 15 { if x >= y { v = 1 } }
        else if op == 16 { if x != 0 && y != 0 { v = 1 } }
        else { if x != 0 || y != 0 { v = 1 } }
        return wrap(s, v, sema_ty(s, e))
    }
    if a == ast.E_AS {
        let v: i64 = const_eval(s, ast.e_a(b, e), good)
        let dst: u32 = sema_ty(s, e)
        if is_bool(s, dst) {
            if v != 0 {
                return 1
            }
            return 0
        }
        if types.is_ptr(table(s), dst) {
            *good = false
            return 0
        }
        return wrap(s, v, dst)
    }
    // A CALL in a constant expression means that `firnc0` runs the
    // function at compile time (comptime.rs). That is not
    // ported -- the file is counted separately, not as a deviation.
    if a == ast.E_CALL {
        (*s).ct_needed = true
    }
    *good = false
    return 0
}

// ------------------------------------------------------------ expressions
//
// `note` is the context type or NONE. The result is always a concrete
// type; on error, the error type.

fn expr(s: *mut Sema, e: u32, note: u32) -> u32 {
    let t: u32 = expr_inner(s, e, note)
    remember(s, e, t)
    return t
}

// Gives every subexpression a concrete type, without checking the contents.
fn infer(s: *mut Sema, e: u32) {
    expr(s, e, (*s).t_i64)
}

fn field_ty(s: *mut Sema, bt: u32, name: u32) -> u32 {
    // HOOK gc: field access reaching through `Gc[T]` (gc.rs::hook_field_base).
    // A Gc pointer is followed without `(*p).field` -- it is first class.
    if has_gc(s) {
        let si: u32 = gc.gc_field_base(gcp(s), table(s), bt)
        if si != NONE {
            let st: u32 = types.new_ty(table(s), types.K_STRUCT, si, 0)
            return field_ty(s, st, name)
        }
    }
    if types.ty_kind(table(s), bt) == types.K_STRUCT {
        let ft: u32 = types.st_field_ty(table(s), types.ty_a(table(s), bt) as usize, name)
        if ft == NONE {
            complain(s)
            return (*s).t_error
        }
        return ft
    }
    if is_error(s, bt) {
        return (*s).t_error
    }
    complain(s)
    return (*s).t_error
}

fn index_ty(s: *mut Sema, bt: u32, idx: u32) -> u32 {
    let it: u32 = expr(s, idx, (*s).t_usize)
    if !is_error(s, it) && !types.ty_equal(table(s), it, (*s).t_usize) {
        complain(s)
    }
    if types.ty_kind(table(s), bt) == types.K_ARR {
        return types.ty_a(table(s), bt)
    }
    if is_error(s, bt) {
        return (*s).t_error
    }
    complain(s)
    return (*s).t_error
}

// Assignable expression: yields the type or NONE.
fn lvalue(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_ID {
        let v: u32 = var_search(s, ast.e_a(b, e))
        if v != NONE {
            remember(s, e, v)
            return v
        }
        let k: u32 = const_search(s, ast.e_a(b, e))
        if k != NONE {
            remember(s, e, k)
            return k
        }
        complain(s)
        remember(s, e, (*s).t_error)
        return (*s).t_error
    }
    if a == ast.E_FIELD {
        let bt: u32 = lvalue(s, ast.e_a(b, e))
        if bt == NONE {
            return NONE
        }
        let t: u32 = field_ty(s, bt, ast.e_b(b, e))
        remember(s, e, t)
        return t
    }
    if a == ast.E_IDX {
        let bt: u32 = lvalue(s, ast.e_a(b, e))
        if bt == NONE {
            return NONE
        }
        let t: u32 = index_ty(s, bt, ast.e_b(b, e))
        remember(s, e, t)
        return t
    }
    if a == ast.E_UN && ast.e_a(b, e) == 3 {
        let t0: u32 = expr(s, ast.e_b(b, e), NONE)
        var t: u32 = (*s).t_error
        if types.ty_kind(table(s), t0) == types.K_PTR {
            t = types.ty_a(table(s), t0)
        } else if !is_error(s, t0) {
            complain(s)
        }
        remember(s, e, t)
        return t
    }
    infer(s, e)
    complain(s)
    return NONE
}

fn unary(s: *mut Sema, e: u32, note: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let op: u32 = ast.e_a(b, e)
    let inner: u32 = ast.e_b(b, e)
    if op == 0 {
        var h: u32 = probe(s, inner)
        if h == NONE {
            if note != NONE && is_int(s, note) {
                h = note
            }
        }
        let t: u32 = expr(s, inner, h)
        if is_error(s, t) {
            return (*s).t_error
        }
        if !is_int(s, t) {
            complain(s)
            return (*s).t_error
        }
        return t
    }
    if op == 1 {
        let t: u32 = expr(s, inner, (*s).t_bool)
        if is_error(s, t) {
            return (*s).t_error
        }
        if !is_bool(s, t) {
            complain(s)
            return (*s).t_error
        }
        return (*s).t_bool
    }
    if op == 2 {
        let t: u32 = lvalue(s, inner)
        if t == NONE || is_error(s, t) {
            return (*s).t_error
        }
        return types.new_ty(table(s), types.K_PTR, t, 1)
    }
    let t: u32 = expr(s, inner, NONE)
    if types.ty_kind(table(s), t) == types.K_PTR {
        return types.ty_a(table(s), t)
    }
    if is_error(s, t) {
        return (*s).t_error
    }
    complain(s)
    return (*s).t_error
}

fn binary(s: *mut Sema, e: u32, note: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let op: u32 = ast.e_a(b, e)
    let l: u32 = ast.e_b(b, e)
    let r: u32 = ast.e_c(b, e)

    // logical connectives
    if op == 16 || op == 17 {
        let lt: u32 = expr(s, l, (*s).t_bool)
        let rt: u32 = expr(s, r, (*s).t_bool)
        if !is_error(s, lt) && !is_bool(s, lt) {
            complain(s)
        }
        if !is_error(s, rt) && !is_bool(s, rt) {
            complain(s)
        }
        return (*s).t_bool
    }

    // comparison
    if op >= 10 && op <= 15 {
        // HOOK error unions: `e == E::NotFound` compares two error values
        // of the same set (errors.rs::hook_binary).
        if has_fe(s) && (op == 10 || op == 11) {
            if error_quiet_set(s, l) != NONE || error_quiet_set(s, r) != NONE {
                let lt2: u32 = expr(s, l, NONE)
                let rt2: u32 = expr(s, r, NONE)
                let ls: u32 = err.error_set_of_ty(fe(s), table(s), lt2)
                let rs: u32 = err.error_set_of_ty(fe(s), table(s), rt2)
                if ls != NONE && rs != NONE && ls == rs {
                    return (*s).t_bool
                }
                if !is_error(s, lt2) && !is_error(s, rt2) {
                    complain(s)
                }
                return (*s).t_bool
            }
        }
        var want: u32 = probe(s, l)
        if want == NONE {
            want = probe(s, r)
        }
        let lt: u32 = expr(s, l, want)
        let rt: u32 = expr(s, r, want)
        if is_error(s, lt) || is_error(s, rt) {
            return (*s).t_bool
        }
        // HOOK gc: identity comparison of two related Gc pointers (gc.rs).
        var same: bool = types.compatible(table(s), lt, rt)
        if !same && has_gc(s) {
            same = gc.gc_is_related((*s).gc, table(s), lt, rt)
        }
        if !same {
            complain(s)
            return (*s).t_bool
        }
        let only_equal: bool = op == 10 || op == 11
        var ok: bool = is_int(s, lt) || is_f64(s, lt)
        if !ok && only_equal {
            ok = is_bool(s, lt) || types.is_ptr(table(s), lt)
        }
        if !ok {
            complain(s)
        }
        return (*s).t_bool
    }

    // shift: the left operand decides the type
    if op == 8 || op == 9 {
        var h: u32 = probe(s, l)
        if h == NONE {
            if note != NONE && is_int(s, note) {
                h = note
            }
        }
        let lt: u32 = expr(s, l, h)
        var rh: u32 = probe(s, r)
        if rh == NONE {
            if is_int(s, lt) {
                rh = lt
            } else {
                rh = (*s).t_i64
            }
        }
        let rt: u32 = expr(s, r, rh)
        if is_error(s, lt) {
            return (*s).t_error
        }
        if is_error(s, rt) {
            return lt
        }
        if !is_int(s, lt) || !is_int(s, rt) {
            complain(s)
            return (*s).t_error
        }
        return lt
    }

    // arithmetic and bit operations: the already typed operand takes
    // PRECEDENCE over the context type.
    var want: u32 = probe(s, l)
    if want == NONE {
        want = probe(s, r)
    }
    if want == NONE {
        if note != NONE && is_int(s, note) {
            want = note
        }
    }
    let lt: u32 = expr(s, l, want)
    let rt: u32 = expr(s, r, want)
    if is_error(s, lt) || is_error(s, rt) {
        return (*s).t_error
    }
    if is_f64(s, lt) || is_f64(s, rt) {
        // `%` and the bit operations are undefined for f64.
        let allowed: bool = op <= 3
        if !allowed {
            complain(s)
            return (*s).t_error
        }
        if !types.ty_equal(table(s), lt, rt) {
            complain(s)
            return (*s).t_error
        }
        return (*s).t_f64
    }
    if !is_int(s, lt) || !is_int(s, rt) || !types.ty_equal(table(s), lt, rt) {
        complain(s)
        return (*s).t_error
    }
    return lt
}

// ------------------------------------------------- gc (gc.rs)
//
// `gc C{...}` yields `AllocError!Gc[C]` (check_new in stage 0). The callee
// name carries the class ("gc C"), and the only argument is the struct
// literal with the initial values.

fn gc_new_check(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let name: u32 = ast.e_a(b, e)
    var slit: u32 = NONE
    if ast.e_c(b, e) == 1 {
        let a0: u32 = ast.child_at(b, ast.e_b(b, e))
        if ast.e_kind(b, a0) == ast.E_SLIT {
            slit = a0
        }
    }
    let ki_i: i64 = gc.gc_class_out_new(gcp(s), names(s), name)
    if ki_i < 0 {
        // unknown gc class
        if slit != NONE {
            var k: u32 = 0
            while k < ast.e_c(b, slit) {
                infer(s, ast.child_at(b, ast.e_b(b, slit) + k * 2 + 1))
                k = k + 1
            }
        }
        complain(s)
        return (*s).t_error
    }
    let ki: u32 = ki_i as u32
    let sidx: u32 = gc.gc_sidx(gcp(s), ki)
    if slit != NONE {
        let off: u32 = ast.e_b(b, slit)
        let cnt: u32 = ast.e_c(b, slit)
        var k: u32 = 0
        while k < cnt {
            let fname: u32 = ast.child_at(b, off + k * 2)
            let fexpr: u32 = ast.child_at(b, off + k * 2 + 1)
            // given twice?
            var j: u32 = 0
            while j < k {
                if ast.child_at(b, off + j * 2) == fname {
                    complain(s)
                }
                j = j + 1
            }
            let want: u32 = types.st_field_ty(table(s), sidx as usize, fname)
            if want == NONE {
                infer(s, fexpr)
                complain(s)
            } else {
                let got: u32 = expr(s, fexpr, want)
                if !is_error(s, got) && !types.compatible(table(s), got, want) {
                    complain(s)
                }
            }
            k = k + 1
        }
        // A gc allocation has to give ALL fields.
        if cnt != types.st_flen(table(s), sidx as usize) {
            complain(s)
        }
    }
    // The fallible allocation: AllocError!Gc[C] (DESIGN_GOALS 2). The set
    // comes in with the runtime, pulled in automatically (lib/gc/gc.fi).
    if !has_fe(s) {
        complain(s)
        return (*s).t_error
    }
    var ae: [u8; 10] = "AllocError"
    let aen: u32 = intern.intern_number(names(s), (&ae[0]) as u64, 10) as u32
    let sm: u32 = err.error_set_find(fe(s), aen)
    if sm == NONE {
        complain(s)
        return (*s).t_error
    }
    let st: u32 = types.new_ty(table(s), types.K_STRUCT, sidx, 0)
    let val: u32 = types.new_ty(table(s), types.K_PTR, st, 1)
    let ut: u32 = err.error_union_build(fe(s), table(s), names(s), sm, val)
    let ui: u32 = err.error_union_of_ty(fe(s), table(s), ut)
    if ui != NONE {
        gc.gc_union_set(gcp(s), ki, ui)
    }
    // The literal node itself carries the union type (stage 0: `record`).
    if slit != NONE {
        remember(s, slit, ut)
    }
    return ut
}

// `x.as?[C]` -- the checked downcast (check_as in stage 0).
fn gc_as_check(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let name: u32 = ast.e_a(b, e)
    let zi: i64 = gc.gc_class_out_as(gcp(s), names(s), name)
    if zi < 0 {
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            infer(s, ast.child_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let target: u32 = zi as u32
    if ast.e_c(b, e) == 0 {
        complain(s)
        return (*s).t_error
    }
    let arg: u32 = ast.child_at(b, ast.e_b(b, e))
    let at: u32 = expr(s, arg, NONE)
    if is_error(s, at) {
        return (*s).t_error
    }
    var source: u32 = NONE
    if types.ty_kind(table(s), at) == types.K_PTR {
        let inner: u32 = types.ty_a(table(s), at)
        if types.ty_kind(table(s), inner) == types.K_STRUCT {
            source = gc.gc_class_of_struct(gcp(s), types.ty_a(table(s), inner))
        }
    }
    if source == NONE {
        // '.as?[C]' expects a Gc[T]
        complain(s)
        return (*s).t_error
    }
    if source != target && !gc.gc_is_descendant(gcp(s), target, source) && !gc.gc_is_descendant(gcp(s), source, target) {
        // the two classes are not related
        complain(s)
        return (*s).t_error
    }
    let st: u32 = types.new_ty(table(s), types.K_STRUCT, gc.gc_sidx(gcp(s), target), 0)
    return types.new_ty(table(s), types.K_PTR, st, 1)
}

// `weak(g)` and `strong(w)` (the rest of hook_call in stage 0).
fn gc_weak_check(s: *mut Sema, e: u32, is_weak: bool) -> u32 {
    let b: *mut ast.Tree = tree(s)
    if ast.e_c(b, e) != 1 {
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            infer(s, ast.child_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let arg: u32 = ast.child_at(b, ast.e_b(b, e))
    let at: u32 = expr(s, arg, NONE)
    if is_error(s, at) {
        return (*s).t_error
    }
    if is_weak {
        var ki: u32 = NONE
        if types.ty_kind(table(s), at) == types.K_PTR {
            let inner: u32 = types.ty_a(table(s), at)
            if types.ty_kind(table(s), inner) == types.K_STRUCT {
                ki = gc.gc_class_of_struct(gcp(s), types.ty_a(table(s), inner))
            }
        }
        if ki == NONE {
            // 'weak' expects a Gc[T]
            complain(s)
            return (*s).t_error
        }
        return types.new_ty(table(s), types.K_STRUCT, gc.gc_widx(gcp(s), ki), 0)
    }
    var ki: u32 = NONE
    if types.ty_kind(table(s), at) == types.K_STRUCT {
        ki = gc.gc_class_of_weak(gcp(s), types.ty_a(table(s), at))
    }
    if ki == NONE {
        // 'strong' expects a GcWeak[T]
        complain(s)
        return (*s).t_error
    }
    let st: u32 = types.new_ty(table(s), types.K_STRUCT, gc.gc_sidx(gcp(s), ki), 0)
    return types.new_ty(table(s), types.K_PTR, st, 1)
}

// -------------------------------------------------------- ROUND 45: methods
//
// Model: compiler/src/impls.rs. `x.m(a)` sits in the tree as the call
// `"method m"`; which function is meant is decided SOLELY by the static
// type of the receiver. No dynamic dispatch, no vtable.

fn is_method_call(it: *mut intern.Interner, name: u32) -> bool {
    var w: [u8; 7] = "method "
    return intern.intern_prefix(it, name, (&w[0]) as u64, 7)
}

// The prefix the methods of a receiver type live under -- value OR pointer.
// ROUND 50: this is no longer only a struct. A PRIMITIVE TYPE can implement
// an interface too (`impl Ord for i32`), and then its method is called
// `i32__less`. A typeless integer literal does not belong here -- it has
// no fixed type that could carry an `impl` block.
fn recv_struct(s: *mut Sema, t: u32) -> u32 {
    var i: u32 = t
    if types.ty_kind(table(s), i) == types.K_PTR {
        i = types.ty_a(table(s), i)
    }
    let a: u32 = types.ty_kind(table(s), i)
    if a == types.K_STRUCT {
        return types.st_name(table(s), types.ty_a(table(s), i) as usize)
    }
    return types.base_ty_name(names(s), a)
}

// `Type__method` -- the name of the function behind the method.
fn method_func(s: *mut Sema, sn: u32, m: u32) -> u32 {
    let it: *mut intern.Interner = names(s)
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, intern.intern_ptr(it, sn), intern.intern_length(it, sn))
    var tr: [u8; 2] = "__"
    rt.buf_push_bytes(&b, (&tr[0]) as u64, 2)
    rt.buf_push_bytes(&b, intern.intern_ptr(it, m), intern.intern_length(it, m))
    let nr: u32 = intern.intern_number(it, rt.buf_ptr(&b), rt.buf_len(&b)) as u32
    rt.buf_free(&b)
    return nr
}

// Can this expression have its address taken? The same set of cases that
// `&x` allows (impls.rs::is_slot).
fn is_slot(s: *mut Sema, e: u32) -> bool {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_ID {
        return true
    }
    if a == ast.E_FIELD {
        return true
    }
    if a == ast.E_IDX {
        return true
    }
    if a == ast.E_UN {
        return ast.e_a(b, e) == 3
    }
    return false
}

fn methods_call(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    if cnt < 1 {
        complain(s)
        return (*s).t_error
    }
    let m: u32 = intern.intern_ab(names(s), ast.e_a(b, e), 7)
    let recv: u32 = ast.child_at(b, off)
    let et: u32 = expr(s, recv, NONE)
    var k: u32 = 1
    if is_error(s, et) {
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        return (*s).t_error
    }
    let sn: u32 = recv_struct(s, et)
    if sn == NONE {
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    // HOOK iface (iface.rs::hook_method): `f.m(args)` on a `dyn I` --
    // DYNAMIC DISPATCH. Which function runs is known only at run time,
    // from the method table; the check runs against the interface.
    if has_if(s) {
        let ii: u32 = iface.if_of_dyn(ifp(s), sn)
        if ii != NONE {
            return interfaces_call(s, e, ii, m, et)
        }
    }
    let f: u32 = fn_search(s, method_func(s, sn, m))
    if f == NONE {
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let plen: u32 = ast.fn_plen(b, f as usize)
    // The receiver -- the only adjustment at the call site: if the method
    // wants a pointer and the receiver is a value, its address is taken.
    // The other way round there is NOTHING: no automatic deref.
    if plen > 0 {
        let p0: u32 = types.param_ty_resolved(table(s), f as usize, 0)
        let will_z: bool = types.is_ptr(table(s), p0)
        let is_z: bool = types.is_ptr(table(s), et)
        if will_z && !is_z {
            if !is_slot(s, recv) {
                complain(s)
            }
        }
        if !will_z && is_z {
            complain(s)
        }
    }
    if cnt != plen {
        complain(s)
    }
    while k < cnt {
        let arg: u32 = ast.child_at(b, off + k)
        if k < plen {
            let pt: u32 = types.param_ty_resolved(table(s), f as usize, k)
            if has_fe(s) && coerce_check(s, arg, pt) {
                k = k + 1
                continue
            }
            let t: u32 = expr(s, arg, pt)
            if !types.compatible(table(s), t, pt) {
                complain(s)
            }
        } else {
            infer(s, arg)
        }
        k = k + 1
    }
    return types.ret_ty_the_func(table(s), f as usize)
}

// A call through the interface. The receiver is the fat pointer ITSELF
// (a value); a `*dyn I` is deliberately not accepted -- `(*z).m(...)`
// says the same thing and makes it visible that two words are being
// read.
fn interfaces_call(s: *mut Sema, e: u32, ii: u32, m: u32, et: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    let mk: u32 = iface.if_slot(ifp(s), ii as usize, m)
    var k: u32 = 1
    if mk == NONE {
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        // the interface has no method of that name
        complain(s)
        return (*s).t_error
    }
    // ROUND 50 -- OBJECT SAFETY: a signature with `Self` is unknown to the
    // caller through `dyn I`. Which type is behind it is fixed only at run
    // time, and `*Self` would be a different type for each. Such methods
    // exist only statically, through a bound.
    if iface.if_m_self(ifp(s), ii, mk) {
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    if types.is_ptr(table(s), et) {
        // a pointer to an interface value is not one
        complain(s)
    }
    let plen: u32 = iface.if_plen(ifp(s), ii as usize, mk)
    if cnt != plen + 1 {
        complain(s)
    }
    while k < cnt {
        let arg: u32 = ast.child_at(b, off + k)
        if k <= plen {
            let pt: u32 = iface.if_ptyp(ifp(s), ii as usize, mk, k - 1)
            if has_fe(s) && coerce_check(s, arg, pt) {
                k = k + 1
                continue
            }
            let t: u32 = expr(s, arg, pt)
            if !types.compatible(table(s), t, pt) {
                complain(s)
            }
        } else {
            infer(s, arg)
        }
        k = k + 1
    }
    return iface.if_rtyp(ifp(s), ii as usize, mk)
}

// ----------------------------------------------- inline assembly and MMIO
//
// ROUND 52 (compiler/src/core.rs::hook_call).

// Integer type to an MMIO width index (0 = u8 ... 3 = u64).
fn mmio_ty(s: *mut Sema, w: u32) -> u32 {
    if w == 0 {
        return types.new_ty(table(s), types.K_U8, 0, 0)
    }
    if w == 1 {
        return types.new_ty(table(s), types.K_U16, 0, 0)
    }
    if w == 2 {
        return types.new_ty(table(s), types.K_U32, 0, 0)
    }
    return types.new_ty(table(s), types.K_U64, 0, 0)
}

// A register name in an asm block. `wo`: 0 = output, 1 = input, 2 = clobber.
fn asm_reg_check(s: *mut Sema, reg: u32, wo: u32) -> bool {
    if wo == 2 {
        var mw: [u8; 6] = "memory"
        if intern.intern_equal(names(s), reg, (&mw[0]) as u64, 6) {
            return true
        }
    }
    if core.reg_stem(names(s), reg) != core.NO_REG {
        return true
    }
    complain(s)
    return false
}

fn asm_check(s: *mut Sema, blk: u32, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    var good: bool = true
    let out: u32 = ast.asm_out(b, blk)
    if out != ast.NOTHING {
        if !asm_reg_check(s, out, 0) {
            good = false
        }
    }
    var k: u32 = 0
    while k < ast.asm_in_count(b, blk) {
        if !asm_reg_check(s, ast.asm_in_reg(b, blk, k), 1) {
            good = false
        }
        k = k + 1
    }
    var k2: u32 = 0
    while k2 < ast.asm_clob_count(b, blk) {
        if !asm_reg_check(s, ast.asm_clob(b, blk, k2), 2) {
            good = false
        }
        k2 = k2 + 1
    }
    // Every input value has to be scalar -- nothing else fits into a
    // register.
    let u64t: u32 = types.new_ty(table(s), types.K_U64, 0, 0)
    var k3: u32 = 0
    while k3 < cnt {
        let t: u32 = expr(s, ast.child_at(b, off + k3), u64t)
        if is_error(s, t) {
            good = false
        } else if !is_int(s, t) && !is_bool(s, t) && !types.is_ptr(table(s), t) {
            complain(s)
            good = false
        }
        k3 = k3 + 1
    }
    if !good {
        return (*s).t_error
    }
    if out != ast.NOTHING {
        return u64t
    }
    return (*s).t_void
}

fn mmio_check(s: *mut Sema, w: u32, e: u32, write: bool) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    var should: u32 = 1
    if write {
        should = 2
    }
    let zt: u32 = mmio_ty(s, w)
    if cnt != should {
        var k: u32 = 0
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let pt: u32 = types.new_ty(table(s), types.K_PTR, zt, 1)
    let at: u32 = expr(s, ast.child_at(b, off), pt)
    if !is_error(s, at) && !types.is_ptr(table(s), at) {
        complain(s)
        return (*s).t_error
    }
    if is_error(s, at) {
        return (*s).t_error
    }
    if !write {
        return zt
    }
    let wt: u32 = expr(s, ast.child_at(b, off + 1), zt)
    if is_error(s, wt) {
        return (*s).t_error
    }
    if !is_int(s, wt) {
        complain(s)
        return (*s).t_error
    }
    return (*s).t_void
}

fn call(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    // `size_of[T]()` -- not an ordinary call but a size fixed at compile
    // time (sizeof.rs). The parser has put the type node into `e_number`
    // (node + 1); both are resolved only here, because the struct table
    // is only available here.
    if ast.e_number(b, e) != 0 {
        let st: u32 = ast_ty(s, (ast.e_number(b, e) - 1) as u32)
        if is_error(s, st) {
            complain(s)
            return (*s).t_error
        }
        if types.ty_kind(table(s), st) == types.K_VOID {
            complain(s)
            return (*s).t_error
        }
        return (*s).t_usize
    }
    let name: u32 = ast.e_a(b, e)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    // HOOK impl (impls.rs::hook_call): `x.m(args)` -- method call.
    if is_method_call(names(s), name) {
        return methods_call(s, e)
    }
    // HOOK error unions (errors.rs::hook_call): `__try#`, `__catch#` and
    // `ErrorSet::Variant`. Comes BEFORE the enum/match hook, because in
    // stage 0 it comes first too; a set and an enum of the same name
    // cannot both exist (the registration reports the clash).
    if has_fe(s) {
        if err.error_is_tryname(names(s), name) {
            return try_check(s, e)
        }
        if err.error_is_catchname(names(s), name) {
            return catch_check(s, e)
        }
        var en: u32 = NONE
        var vn: u32 = NONE
        err.error_name_split((*s).feh, names(s), name, &en, &vn)
        if en != NONE {
            if err.error_set_find(fe(s), en) != NONE {
                return error_ctor_check(s, en, e)
            }
        }
    }
    // HOOK enum/match (sema_match.rs): `__match#N` is the pattern match,
    // `Enum::Variant(..)` the constructor. Neither of them is in the
    // function list.
    if has_mu(s) {
        if pattern.pat_is_matchname(names(s), name) {
            match_check(s, pattern.pat_match_number(names(s), name))
            return (*s).t_void
        }
        if pattern.pat_is_ctorname(names(s), name) {
            return ctor_check(s, name, e)
        }
    }
    // ROUND 52 (core.rs): the inline assembler and the eight MMIO names.
    // `asm$N` cannot be a function ('$' is not an identifier character);
    // for MMIO a user function of the same name wins.
    let anr: u32 = core.asm_number(names(s), name)
    if anr != core.NO_NUMBER {
        return asm_check(s, anr, e)
    }
    if fn_search(s, name) == NONE {
        let wl: u32 = core.mmio_read_width(names(s), name)
        if wl != core.NO_WIDTH {
            return mmio_check(s, wl, e, false)
        }
        let ws: u32 = core.mmio_write_width(names(s), name)
        if ws != core.NO_WIDTH {
            return mmio_check(s, ws, e, true)
        }
    }
    // ROUND 49 (thread.rs): the three thread primitives. A user function
    // of the same name wins, exactly as for the atomic addition.
    var fst: [u8; 14] = "__thread_start"
    if intern.intern_equal(names(s), name, (&fst[0]) as u64, 14) && fn_search(s, name) == NONE {
        let u64t2: u32 = types.new_ty(table(s), types.K_U64, 0, 0)
        let i64t2: u32 = types.new_ty(table(s), types.K_I64, 0, 0)
        let u8t2: u32 = types.new_ty(table(s), types.K_U8, 0, 0)
        let pu8t: u32 = types.new_ty(table(s), types.K_PTR, u8t2, 1)
        if cnt != 3 {
            var k3: u32 = 0
            while k3 < cnt {
                infer(s, ast.child_at(b, off + k3))
                k3 = k3 + 1
            }
            complain(s)
            return (*s).t_error
        }
        let ta: u32 = expr(s, ast.child_at(b, off), u64t2)
        let ts: u32 = expr(s, ast.child_at(b, off + 1), u64t2)
        let tc: u32 = expr(s, ast.child_at(b, off + 2), pu8t)
        if !is_error(s, ta) && !is_int(s, ta) {
            complain(s)
            return (*s).t_error
        }
        if !is_error(s, ts) && !is_int(s, ts) {
            complain(s)
            return (*s).t_error
        }
        if !is_error(s, tc) && !types.is_ptr(table(s), tc) {
            complain(s)
            return (*s).t_error
        }
        if is_error(s, ta) || is_error(s, ts) || is_error(s, tc) {
            return (*s).t_error
        }
        return i64t2
    }
    var fsl: [u8; 13] = "__thread_self"
    if intern.intern_equal(names(s), name, (&fsl[0]) as u64, 13) && fn_search(s, name) == NONE {
        let u8t3: u32 = types.new_ty(table(s), types.K_U8, 0, 0)
        let pu8t2: u32 = types.new_ty(table(s), types.K_PTR, u8t3, 1)
        if cnt != 0 {
            var k4: u32 = 0
            while k4 < cnt {
                infer(s, ast.child_at(b, off + k4))
                k4 = k4 + 1
            }
            complain(s)
            return (*s).t_error
        }
        return pu8t2
    }
    var atc: [u8; 13] = "__atomic_swap"
    if intern.intern_equal(names(s), name, (&atc[0]) as u64, 13) && fn_search(s, name) == NONE {
        let u64t3: u32 = types.new_ty(table(s), types.K_U64, 0, 0)
        let pu64t: u32 = types.new_ty(table(s), types.K_PTR, u64t3, 1)
        if cnt != 3 {
            var k5: u32 = 0
            while k5 < cnt {
                infer(s, ast.child_at(b, off + k5))
                k5 = k5 + 1
            }
            complain(s)
            return (*s).t_error
        }
        let tp2: u32 = expr(s, ast.child_at(b, off), pu64t)
        let te2: u32 = expr(s, ast.child_at(b, off + 1), u64t3)
        let tn2: u32 = expr(s, ast.child_at(b, off + 2), u64t3)
        if !is_error(s, tp2) && !types.is_ptr(table(s), tp2) {
            complain(s)
            return (*s).t_error
        }
        if !is_error(s, te2) && !is_int(s, te2) {
            complain(s)
            return (*s).t_error
        }
        if !is_error(s, tn2) && !is_int(s, tn2) {
            complain(s)
            return (*s).t_error
        }
        if is_error(s, tp2) || is_error(s, te2) || is_error(s, tn2) {
            return (*s).t_error
        }
        return u64t3
    }
    // `__atomic_add(p, delta)` (atomic.rs, ROUND 47): atomic
    // read-add-write, the result is the OLD value. Basis of the
    // reference count of `Arc[T]` (SPEC 3.4). A user function wins.
    var atw: [u8; 12] = "__atomic_add"
    if intern.intern_equal(names(s), name, (&atw[0]) as u64, 12) && fn_search(s, name) == NONE {
        let u64t: u32 = types.new_ty(table(s), types.K_U64, 0, 0)
        let pu64: u32 = types.new_ty(table(s), types.K_PTR, u64t, 1)
        if cnt != 2 {
            var k2: u32 = 0
            while k2 < cnt {
                infer(s, ast.child_at(b, off + k2))
                k2 = k2 + 1
            }
            complain(s)
            return (*s).t_error
        }
        let tp: u32 = expr(s, ast.child_at(b, off), pu64)
        let td: u32 = expr(s, ast.child_at(b, off + 1), u64t)
        if !is_error(s, tp) && !types.is_ptr(table(s), tp) {
            complain(s)
            return (*s).t_error
        }
        if !is_error(s, td) && !is_int(s, td) {
            complain(s)
            return (*s).t_error
        }
        if is_error(s, tp) || is_error(s, td) {
            return (*s).t_error
        }
        return u64t
    }
    // HOOK gc (gc.rs::hook_call): `gc C{...}`, the two intrinsics,
    // `x.as?[C]`, `weak(g)` and `strong(w)`. Runs before the function lookup,
    // except for `weak`/`strong`: there a USER function of the same name
    // wins (in stage 0: `ck.fns.contains_key(..)`).
    if has_gc(s) {
        if gc.gc_has_new_prefix(names(s), name) {
            return gc_new_check(s, e)
        }
        if gc.gc_state_name(names(s), name) != 0 {
            var k: u32 = 0
            while k < cnt {
                infer(s, ast.child_at(b, off + k))
                k = k + 1
            }
            let u8t: u32 = types.new_ty(table(s), types.K_U8, 0, 0)
            return types.new_ty(table(s), types.K_PTR, u8t, 1)
        }
        if gc.gc_has_as_prefix(names(s), name) {
            return gc_as_check(s, e)
        }
        if (gc.gc_is_weak_name(names(s), name) || gc.gc_is_strong_name(names(s), name)) && fn_search(s, name) == NONE {
            return gc_weak_check(s, e, gc.gc_is_weak_name(names(s), name))
        }
        // `barrier(x)` (ct.rs): the opaque barrier -- the behaviour is
        // the identity, only scalarity is checked. A user function
        // called `barrier` wins (ct.rs::hook_call).
        var bw: [u8; 7] = "barrier"
        if intern.intern_equal(names(s), name, (&bw[0]) as u64, 7) && fn_search(s, name) == NONE {
            if cnt != 1 {
                complain(s)
                return (*s).t_error
            }
            let at: u32 = expr(s, ast.child_at(b, off), NONE)
            if is_error(s, at) {
                return (*s).t_error
            }
            if !is_int(s, at) && !is_bool(s, at) && !types.is_ptr(table(s), at) {
                complain(s)
                return (*s).t_error
            }
            return at
        }
        // `select(condition, a, b)` (ct.rs::check_select, ROUND 36):
        // data independent choice -- only scalar types, both branches of
        // the same type, no implicit conversion. A user function wins.
        var sw2: [u8; 6] = "select"
        if intern.intern_equal(names(s), name, (&sw2[0]) as u64, 6) && fn_search(s, name) == NONE {
            if cnt != 3 {
                complain(s)
                return (*s).t_error
            }
            let cty: u32 = expr(s, ast.child_at(b, off), (*s).t_bool)
            if !is_error(s, cty) && !is_bool(s, cty) {
                complain(s)
            }
            let ta: u32 = expr(s, ast.child_at(b, off + 1), NONE)
            let tb: u32 = expr(s, ast.child_at(b, off + 2), ta)
            if is_error(s, ta) || is_error(s, tb) {
                return (*s).t_error
            }
            if !is_int(s, ta) && !is_bool(s, ta) && !types.is_ptr(table(s), ta) {
                complain(s)
                return (*s).t_error
            }
            if !types.ty_equal(table(s), ta, tb) {
                complain(s)
                return (*s).t_error
            }
            return ta
        }
        // `secure_zero(pointer, count)` (ct.rs::check_secure_zero, ROUND 36):
        // zeroes the buffer and must never be optimized away (SPEC 9.3, C3).
        var sz: [u8; 11] = "secure_zero"
        if intern.intern_equal(names(s), name, (&sz[0]) as u64, 11) && fn_search(s, name) == NONE {
            if cnt != 2 {
                complain(s)
                return (*s).t_error
            }
            let tp: u32 = expr(s, ast.child_at(b, off), NONE)
            if !is_error(s, tp) && !types.is_ptr(table(s), tp) {
                complain(s)
            }
            let tn: u32 = expr(s, ast.child_at(b, off + 1), (*s).t_usize)
            if !is_error(s, tn) && !is_int(s, tn) {
                complain(s)
            }
            return (*s).t_void
        }
    }
    let f: u32 = fn_search(s, name)
    if f == NONE {
        var k: u32 = 0
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let plen: u32 = ast.fn_plen(b, f as usize)
    if cnt != plen {
        complain(s)
    }
    var k: u32 = 0
    while k < cnt {
        let arg: u32 = ast.child_at(b, off + k)
        if k < plen {
            let pt: u32 = types.param_ty_resolved(table(s), f as usize, k)
            // HOOK error unions: implicit conversion of an argument
            // (errors.rs::hook_coerce in `call`).
            if has_fe(s) && coerce_check(s, arg, pt) {
                k = k + 1
                continue
            }
            let t: u32 = expr(s, arg, pt)
            if !types.compatible(table(s), t, pt) {
                complain(s)
            }
        } else {
            infer(s, arg)
        }
        k = k + 1
    }
    return types.ret_ty_the_func(table(s), f as usize)
}

fn struct_literal(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let name: u32 = ast.e_a(b, e)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    let si: i32 = types.struct_index(table(s), name)
    if si < 0 {
        var k: u32 = 0
        while k < cnt {
            infer(s, ast.child_at(b, off + k * 2 + 1))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    var k: u32 = 0
    while k < cnt {
        let fname: u32 = ast.child_at(b, off + k * 2)
        let fexpr: u32 = ast.child_at(b, off + k * 2 + 1)
        let ft: u32 = types.st_field_ty(table(s), si as usize, fname)
        if ft == NONE {
            infer(s, fexpr)
            complain(s)
        } else {
            // HOOK error unions: implicit conversion of a field value.
            var converted: bool = false
            if has_fe(s) {
                converted = coerce_check(s, fexpr, ft)
            }
            if !converted {
                let t: u32 = expr(s, fexpr, ft)
                if !types.compatible(table(s), t, ft) {
                    complain(s)
                }
            }
        }
        k = k + 1
    }
    if cnt != types.st_flen(table(s), si as usize) {
        complain(s)
    }
    return types.new_ty(table(s), types.K_STRUCT, si as u32, 0)
}

fn expr_inner(s: *mut Sema, e: u32, note: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)

    if a == ast.E_FLOAT {
        return (*s).t_f64
    }
    if a == ast.E_INT {
        // An integer literal carries NO type of its own -- it comes from outside.
        if note != NONE {
            if is_int(s, note) {
                return note
            }
            if is_error(s, note) {
                return (*s).t_error
            }
        }
        complain(s)
        return (*s).t_error
    }
    if a == ast.E_BOOL {
        return (*s).t_bool
    }
    if a == ast.E_ID {
        let v: u32 = var_search(s, ast.e_a(b, e))
        if v != NONE {
            return v
        }
        let k: u32 = const_search(s, ast.e_a(b, e))
        if k != NONE {
            return k
        }
        complain(s)
        return (*s).t_error
    }
    if a == ast.E_UN {
        return unary(s, e, note)
    }
    if a == ast.E_BIN {
        return binary(s, e, note)
    }
    if a == ast.E_FIELD {
        let bt: u32 = expr(s, ast.e_a(b, e), NONE)
        return field_ty(s, bt, ast.e_b(b, e))
    }
    if a == ast.E_IDX {
        let bt: u32 = expr(s, ast.e_a(b, e), NONE)
        return index_ty(s, bt, ast.e_b(b, e))
    }
    if a == ast.E_CALL {
        return call(s, e)
    }
    if a == ast.E_SYSCALL {
        let off: u32 = ast.e_b(b, e)
        let cnt: u32 = ast.e_c(b, e)
        // ROUND 52 (prof.rs): below a freestanding kernel there is no
        // operating system that could accept a system call.
        if (*s).kernel {
            complain(s)
        }
        if cnt == 0 || cnt > 7 {
            complain(s)
        }
        var k: u32 = 0
        while k < cnt {
            let t: u32 = expr(s, ast.child_at(b, off + k), (*s).t_i64)
            if !is_error(s, t) && !is_int(s, t) && !types.is_ptr(table(s), t) {
                complain(s)
            }
            k = k + 1
        }
        return (*s).t_i64
    }
    if a == ast.E_AS {
        let dst: u32 = ast_ty(s, ast.e_b(b, e))
        // HOOK iface (iface.rs::hook_cast): `x as dyn I` -- the
        // interface value is created EXPLICITLY (SPEC 6.2).
        if has_if(s) && types.ty_kind(table(s), dst) == types.K_STRUCT {
            let dn: u32 = types.st_name(table(s), types.ty_a(table(s), dst) as usize)
            let ii: u32 = iface.if_of_dyn(ifp(s), dn)
            if ii != NONE {
                let src: u32 = expr(s, ast.e_a(b, e), NONE)
                if is_error(s, src) {
                    return dst
                }
                if !types.is_ptr(table(s), src) {
                    complain(s)
                    return (*s).t_error
                }
                let inner: u32 = types.ty_a(table(s), src)
                if types.ty_kind(table(s), inner) != types.K_STRUCT {
                    complain(s)
                    return (*s).t_error
                }
                if !iface.if_impl_ok(ifp(s), ii, types.ty_a(table(s), inner)) {
                    complain(s)
                    return (*s).t_error
                }
                return dst
            }
        }
        var ih: u32 = NONE
        if is_int(s, dst) {
            ih = dst
        } else if is_bool(s, dst) {
            ih = (*s).t_i64
        } else if types.is_ptr(table(s), dst) {
            ih = (*s).t_usize
        }
        let src: u32 = expr(s, ast.e_a(b, e), ih)
        if is_error(s, src) || is_error(s, dst) {
            return dst
        }
        if !convertible(s, src) || !convertible(s, dst) {
            complain(s)
            return (*s).t_error
        }
        return dst
    }
    if a == ast.E_SLIT {
        return struct_literal(s, e)
    }
    if a == ast.E_AWDH {
        let value: u32 = ast.e_a(b, e)
        let count: u32 = ast.e_b(b, e)
        let ct: u32 = expr(s, count, (*s).t_usize)
        var n: u64 = 0
        if is_error(s, ct) || !is_int(s, ct) {
            if !is_error(s, ct) {
                complain(s)
            }
        } else {
            var good: bool = true
            let v: i64 = const_eval(s, count, &good)
            if good && v > 0 {
                n = v as u64
            } else {
                complain(s)
            }
        }
        var eh: u32 = NONE
        if note != NONE {
            if types.ty_kind(table(s), note) == types.K_ARR {
                eh = types.ty_a(table(s), note)
            }
        }
        let vt: u32 = expr(s, value, eh)
        if n == 0 || is_error(s, vt) {
            return (*s).t_error
        }
        if note != NONE {
            if types.ty_kind(table(s), note) == types.K_ARR {
                if !types.compatible(table(s), vt, types.ty_a(table(s), note)) {
                    complain(s)
                }
                if types.ty_n(table(s), note) != n {
                    complain(s)
                }
            }
        }
        return types.new_ty(table(s), types.K_ARR, vt, n)
    }
    // array literal
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    var is_arr: bool = false
    if note != NONE {
        is_arr = types.ty_kind(table(s), note) == types.K_ARR
    }
    if is_arr {
        let et: u32 = types.ty_a(table(s), note)
        if cnt as u64 != types.ty_n(table(s), note) {
            complain(s)
        }
        var k: u32 = 0
        while k < cnt {
            let t: u32 = expr(s, ast.child_at(b, off + k), et)
            if !types.compatible(table(s), t, et) {
                complain(s)
            }
            k = k + 1
        }
        return types.new_ty(table(s), types.K_ARR, et, types.ty_n(table(s), note))
    }
    var k: u32 = 0
    while k < cnt {
        infer(s, ast.child_at(b, off + k))
        k = k + 1
    }
    complain(s)
    return (*s).t_error
}

// ------------------------------------------------- enum/match (sema_match.rs)
//
// Port of the type check for enums and pattern matching.
// As everywhere in this file: errors are COUNTED, not described.

// subject kinds of the pattern match (Subject in sema_match.rs).
const SJ_BAD: u32 = 0
const SJ_ENUM: u32 = 1
const SJ_BOOL: u32 = 2
const SJ_INT: u32 = 3

// Check `Enum::Variant(args..)`. Yields the enum type.
fn ctor_check(s: *mut Sema, name: u32, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    // Split the name at the first double colon.
    let it: *mut intern.Interner = names(s)
    let zp: u64 = intern.intern_ptr(it, name)
    let zn: usize = intern.intern_length(it, name)
    var ename: u32 = NONE
    var vname: u32 = NONE
    var i: usize = 0
    while i + 1 < zn {
        if rt.ld8(zp, i) == 58 as u8 && rt.ld8(zp, i + 1) == 58 as u8 {
            ename = intern.intern_number(it, zp, i) as u32
            vname = intern.intern_number(it, zp + (i + 2) as u64, zn - i - 2) as u32
            break
        }
        i = i + 1
    }
    let ei: u32 = pattern.pat_enum_find(mu(s), ename)
    if ei == NONE {
        // unknown enum
        var k: u32 = 0
        while k < cnt {
            infer(s, ast.child_at(b, off + k))
            k = k + 1
        }
        complain(s)
        return (*s).t_error
    }
    let vi: u32 = pattern.pat_variant_find(mu(s), ei, vname)
    if vi == NONE {
        // the enum has no such variant
        var k2: u32 = 0
        while k2 < cnt {
            infer(s, ast.child_at(b, off + k2))
            k2 = k2 + 1
        }
        complain(s)
        return (*s).t_error
    }
    let roff: u32 = pattern.pat_v_roff(mu(s), vi)
    let flen: u32 = pattern.pat_v_tlen(mu(s), vi)
    if cnt != flen {
        complain(s)
    }
    var k3: u32 = 0
    while k3 < cnt {
        let arg: u32 = ast.child_at(b, off + k3)
        if k3 < flen {
            let want: u32 = pattern.pat_rf_ty(mu(s), roff + k3)
            let got: u32 = expr(s, arg, want)
            if !types.compatible(table(s), got, want) {
                complain(s)
            }
        } else {
            infer(s, arg)
        }
        k3 = k3 + 1
    }
    return types.new_ty(table(s), types.K_STRUCT, pattern.pat_e_sidx(mu(s), ei), 0)
}

// Does the pattern value fit into the type? (`fits` in sema_match.rs)
fn fits_in(s: *mut Sema, v: i64, t: u32) -> bool {
    let bits: u32 = types.bits_of(table(s), t)
    if bits == 0 {
        return true
    }
    if types.is_sign(table(s), t) {
        if bits >= 64 {
            return true
        }
        let lo: i64 = 0 - (1 << (bits - 1) as i64)
        let hi: i64 = (1 << (bits - 1) as i64) - 1
        return v >= lo && v <= hi
    }
    if v < 0 {
        return false
    }
    if bits >= 64 {
        // LIMIT: `u64` bounds above `i64::MAX` cannot be written down
        // here (stage 0 computes with i128) -- see pattern.fi.
        return true
    }
    return (v as u64) < (1 << bits as i64) as u64
}

// Checks a pattern against the expected type and creates its bindings.
fn pattern_check(s: *mut Sema, pat: u32, ty: u32, sj_kind: u32, sj_ei: u32,
                  top: bool) {
    let m: *mut pattern.Pat = mu(s)
    let a: u32 = pattern.pat_mu_kind(m, pat)
    if a == pattern.MU_WILD {
        return
    }
    if a == pattern.MU_BIND {
        var_create(s, pattern.pat_mu_a(m, pat), ty)
        return
    }
    if a == pattern.MU_BOOL {
        if !is_bool(s, ty) && !is_error(s, ty) {
            complain(s)
        }
        return
    }
    if a == pattern.MU_INT {
        if !is_int(s, ty) && !is_error(s, ty) {
            complain(s)
            return
        }
        if !is_error(s, ty) {
            if !fits_in(s, pattern.pat_mu_lo(m, pat), ty) {
                complain(s)
            }
        }
        return
    }
    if a == pattern.MU_RANGE {
        if !is_int(s, ty) && !is_error(s, ty) {
            complain(s)
            return
        }
        if !is_error(s, ty) {
            if !fits_in(s, pattern.pat_mu_lo(m, pat), ty) {
                complain(s)
                return
            }
            if !fits_in(s, pattern.pat_mu_hi(m, pat), ty) {
                complain(s)
            }
        }
        return
    }
    // MU_VARIANT
    let ename: u32 = pattern.pat_mu_a(m, pat)
    var ei: u32 = NONE
    if ename != ast.NOTHING {
        ei = pattern.pat_enum_find(m, ename)
        if ei == NONE {
            complain(s)
            return
        }
    } else {
        // Without an explicit enum name it comes from the expected type.
        if types.ty_kind(table(s), ty) == types.K_STRUCT {
            ei = pattern.pat_enum_at_struct(m, types.ty_a(table(s), ty))
        }
        if ei == NONE {
            return
        }
    }
    let want: u32 = types.new_ty(table(s), types.K_STRUCT, pattern.pat_e_sidx(m, ei), 0)
    if !is_error(s, ty) {
        if !types.ty_equal(table(s), ty, want) {
            complain(s)
            return
        }
    }
    if top {
        if sj_kind == SJ_ENUM && sj_ei != ei {
            complain(s)
            return
        }
    }
    let vi: u32 = pattern.pat_variant_find(m, ei, pattern.pat_mu_b(m, pat))
    if vi == NONE {
        complain(s)
        return
    }
    let soff: u32 = pattern.pat_mu_soff(m, pat)
    let slen: u32 = pattern.pat_mu_slen(m, pat)
    let roff: u32 = pattern.pat_v_roff(m, vi)
    let flen: u32 = pattern.pat_v_tlen(m, vi)
    if slen != flen {
        complain(s)
    }
    var k: u32 = 0
    while k < slen {
        if k < flen {
            let ft: u32 = pattern.pat_rf_ty(m, roff + k)
            pattern_check(s, pattern.pat_mu_child(m, soff + k), ft, sj_kind, sj_ei, false)
        }
        k = k + 1
    }
}

// Check the `match` with the number `mi` (check_match in sema_match.rs).
fn match_check(s: *mut Sema, mi: u32) {
    let m: *mut pattern.Pat = mu(s)
    if mi as usize >= pattern.pat_match_count(m) {
        complain(s)
        return
    }
    let subj: u32 = pattern.pat_m_subj(m, mi)
    let sty: u32 = expr(s, subj, NONE)
    // Classify the subject: enum, bool or integer -- anything else is an error.
    var sj_kind: u32 = SJ_BAD
    var sj_ei: u32 = NONE
    if is_error(s, sty) {
        sj_kind = SJ_BAD
    } else if types.ty_kind(table(s), sty) == types.K_STRUCT {
        let ei: u32 = pattern.pat_enum_at_struct(m, types.ty_a(table(s), sty))
        if ei == NONE {
            // 'match' on an ordinary struct: error.
            complain(s)
            sj_kind = SJ_BAD
        } else {
            sj_kind = SJ_ENUM
            sj_ei = ei
        }
    } else if is_bool(s, sty) {
        sj_kind = SJ_BOOL
    } else if is_int(s, sty) {
        sj_kind = SJ_INT
    } else {
        complain(s)
        sj_kind = SJ_BAD
    }
    // The expected type of the patterns.
    var mty: u32 = sty
    if sj_kind == SJ_ENUM {
        mty = types.new_ty(table(s), types.K_STRUCT, pattern.pat_e_sidx(m, sj_ei), 0)
    } else if sj_kind == SJ_BOOL {
        mty = (*s).t_bool
    }
    // 1. Per arm: a scope of its own, check the pattern, check the body.
    let aoff: u32 = pattern.pat_m_aoff(m, mi)
    let alen: u32 = pattern.pat_m_alen(m, mi)
    var ai: u32 = 0
    while ai < alen {
        range_on(s)
        pattern_check(s, pattern.pat_a_pat(m, aoff + ai), mty, sj_kind, sj_ei, true)
        block(s, pattern.pat_a_block(m, aoff + ai), true)
        range_off(s)
        ai = ai + 1
    }
    // 2. Reachability: nothing may follow an arm that always matches.
    var has_catch: bool = false
    ai = 0
    while ai < alen {
        if has_catch {
            complain(s)
            break
        }
        if pattern.pat_irrefutable(m, pattern.pat_a_pat(m, aoff + ai)) {
            has_catch = true
        }
        ai = ai + 1
    }
    // 3. COMPLETENESS -- a missing arm is an ERROR (SPEC 6.3).
    if sj_kind == SJ_BAD {
        return
    }
    if has_catch {
        return
    }
    if sj_kind == SJ_INT {
        // Without a catch all arm an integer match is never complete.
        complain(s)
        return
    }
    if sj_kind == SJ_BOOL {
        var has_w: bool = false
        var has_f: bool = false
        ai = 0
        while ai < alen {
            let pat: u32 = pattern.pat_a_pat(m, aoff + ai)
            if pattern.pat_mu_kind(m, pat) == pattern.MU_BOOL {
                if pattern.pat_mu_a(m, pat) == 1 {
                    has_w = true
                } else {
                    has_f = true
                }
            }
            ai = ai + 1
        }
        if !has_w || !has_f {
            complain(s)
        }
        return
    }
    // SJ_ENUM: every variant needs an arm whose subpatterns are all
    // irrefutable.
    let voff: u32 = pattern.pat_e_voff(m, sj_ei)
    let vlen: u32 = pattern.pat_e_vlen(m, sj_ei)
    var v: u32 = 0
    while v < vlen {
        let vname: u32 = pattern.pat_v_name(m, voff + v)
        var covered: bool = false
        ai = 0
        while ai < alen {
            let pat: u32 = pattern.pat_a_pat(m, aoff + ai)
            if pattern.pat_mu_kind(m, pat) == pattern.MU_VARIANT {
                if pattern.pat_mu_b(m, pat) == vname {
                    var all_un: bool = true
                    let soff: u32 = pattern.pat_mu_soff(m, pat)
                    let slen: u32 = pattern.pat_mu_slen(m, pat)
                    var k: u32 = 0
                    while k < slen {
                        if !pattern.pat_irrefutable(m, pattern.pat_mu_child(m, soff + k)) {
                            all_un = false
                        }
                        k = k + 1
                    }
                    if all_un {
                        covered = true
                    }
                }
            }
            ai = ai + 1
        }
        if !covered {
            complain(s)
        }
        v = v + 1
    }
}

// -------------------------------------------------------------- statements

// --------------------------------------- error unions (errors.rs)
//
// Port of the type check for `try`, `catch`, `Set::Variant` and the
// implicit conversion. As everywhere in this file: errors are
// COUNTED, not described.

// `try a` (check_try in errors.rs). Yields the success type of the union.
fn try_check(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let arg: u32 = ast.child_at(b, ast.e_b(b, e))
    let got: u32 = expr(s, arg, NONE)
    let u: u32 = err.error_union_of_ty(fe(s), table(s), got)
    if u == NONE {
        // 'try' expects a value of an error union
        if !is_error(s, got) {
            complain(s)
        }
        return (*s).t_error
    }
    let val: u32 = err.error_u_valty(fe(s), u)
    let ru: u32 = err.error_union_of_ty(fe(s), table(s), (*s).ret)
    if ru == NONE {
        // 'try' outside a function that returns an error union
        complain(s)
        return val
    }
    if err.error_u_set(fe(s), ru) != err.error_u_set(fe(s), u) {
        // both error sets have to be the same
        complain(s)
        return val
    }
    err.error_try_set(fe(s), e, u)
    return val
}

// `a catch b` (check_catch, errors.rs). Yields the success type of the union.
fn catch_check(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let lhs: u32 = ast.child_at(b, off)
    let rhs: u32 = ast.child_at(b, off + 1)
    let got: u32 = expr(s, lhs, NONE)
    let u: u32 = err.error_union_of_ty(fe(s), table(s), got)
    if u == NONE {
        // 'catch' expects a value of an error union on the left
        if !is_error(s, got) {
            complain(s)
        }
        infer(s, rhs)
        return (*s).t_error
    }
    let want: u32 = err.error_u_valty(fe(s), u)
    // `catch |f| fallback`: the error value is visible in the fallback --
    // with the type of the SET (the bare error value).
    let bind: u32 = err.error_cb(fe(s), e)
    if bind != NONE {
        range_on(s)
        let st: u32 = err.error_set_ty(fe(s), table(s),
                                            err.error_u_set(fe(s), u))
        var_create(s, bind, st)
    }
    let rt: u32 = expr(s, rhs, want)
    if bind != NONE {
        range_off(s)
    }
    if !is_error(s, rt) && !types.compatible(table(s), rt, want) {
        complain(s)
    }
    err.error_catch_set(fe(s), e, u)
    return want
}

// `Set::Variant` -- the bare error value (the constructor branch of
// errors.rs::hook_call). The set exists; the caller has checked that.
fn error_ctor_check(s: *mut Sema, en: u32, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    var k: u32 = 0
    while k < cnt {
        infer(s, ast.child_at(b, off + k))
        k = k + 1
    }
    if cnt > 0 {
        // the error variant has no payload
        complain(s)
    }
    if err.error_ctor_code((*s).feh, names(s), ast.e_a(b, e)) < 0 {
        // unknown variant
        complain(s)
        return (*s).t_error
    }
    return err.error_set_ty(fe(s), table(s),
                                 err.error_set_find(fe(s), en))
}

// Implicit conversion into an error union at `return`/`let`/assignment/
// argument/field (hook_coerce in errors.rs). Yields false if `want` is
// not an error union -- then the ordinary check runs.
fn coerce_check(s: *mut Sema, e: u32, want: u32) -> bool {
    let u: u32 = err.error_union_of_ty(fe(s), table(s), want)
    if u == NONE {
        return false
    }
    let uv: u32 = err.error_u_valty(fe(s), u)
    let got: u32 = expr(s, e, uv)
    if is_error(s, got) {
        return true
    }
    if types.ty_equal(table(s), got, want) {
        // already an error union -- nothing to convert
        return true
    }
    let sm: u32 = err.error_set_of_ty(fe(s), table(s), got)
    if sm != NONE {
        if sm == err.error_u_set(fe(s), u) {
            err.error_coerce_set(fe(s), e, err.ERROR_OUT_ERROR, u)
            return true
        }
        // error value of another set
        complain(s)
        return true
    }
    if types.compatible(table(s), got, uv) {
        err.error_coerce_set(fe(s), e, err.ERROR_OUT_VALUE, u)
        return true
    }
    complain(s)
    return true
}

// Is the expression RECOGNISABLY an error value (`quiet_set`, errors.rs):
// a variant `E::V` or a variable whose type is an error set.
fn error_quiet_set(s: *mut Sema, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_CALL {
        var en: u32 = NONE
        var vn: u32 = NONE
        err.error_name_split((*s).feh, names(s), ast.e_a(b, e), &en, &vn)
        if en != NONE {
            return err.error_set_find(fe(s), en)
        }
        return NONE
    }
    if a == ast.E_ID {
        let v: u32 = var_search(s, ast.e_a(b, e))
        if v != NONE {
            return err.error_set_of_ty(fe(s), table(s), v)
        }
    }
    return NONE
}

fn cond(s: *mut Sema, e: u32) {
    let t: u32 = expr(s, e, (*s).t_bool)
    if !is_error(s, t) && !is_bool(s, t) {
        complain(s)
    }
}

fn stmt(s: *mut Sema, i: u32) {
    let b: *mut ast.Tree = tree(s)
    let a: u32 = ast.s_kind(b, i)

    if a == ast.S_LET || a == ast.S_VAR {
        let te: u32 = ast.s_b(b, i)
        var t: u32 = 0
        if te != ast.NOTHING {
            let d: u32 = ast_ty(s, te)
            // HOOK error unions: implicit conversion at 'let'.
            var converted: bool = false
            if has_fe(s) {
                converted = coerce_check(s, ast.s_c(b, i), d)
            }
            if !converted {
                let got: u32 = expr(s, ast.s_c(b, i), d)
                if !types.compatible(table(s), got, d) {
                    complain(s)
                }
            }
            t = d
        } else {
            let got: u32 = expr(s, ast.s_c(b, i), NONE)
            if types.ty_kind(table(s), got) == types.K_VOID {
                complain(s)
                t = (*s).t_error
            } else {
                t = got
            }
        }
        var_create(s, ast.s_a(b, i), t)
        return
    }
    if a == ast.S_ZUW {
        let t: u32 = lvalue(s, ast.s_a(b, i))
        if t == NONE {
            expr(s, ast.s_b(b, i), (*s).t_i64)
            return
        }
        // HOOK error unions: implicit conversion in an assignment.
        if has_fe(s) && coerce_check(s, ast.s_b(b, i), t) {
            return
        }
        let got: u32 = expr(s, ast.s_b(b, i), t)
        if !types.compatible(table(s), got, t) {
            complain(s)
        }
        return
    }
    if a == ast.S_IF {
        cond(s, ast.s_a(b, i))
        block(s, ast.s_b(b, i), false)
        if ast.s_c(b, i) != ast.NOTHING {
            stmt(s, ast.s_c(b, i))
        }
        return
    }
    if a == ast.S_WHILE {
        cond(s, ast.s_a(b, i))
        block(s, ast.s_b(b, i), false)
        return
    }
    if a == ast.S_FOR {
        var want: u32 = probe(s, ast.s_b(b, i))
        if want == NONE {
            want = probe(s, ast.s_c(b, i))
        }
        let st: u32 = expr(s, ast.s_b(b, i), want)
        var w2: u32 = want
        if w2 == NONE {
            w2 = st
        }
        let et: u32 = expr(s, ast.s_c(b, i), w2)
        var t: u32 = (*s).t_error
        if is_error(s, st) || is_error(s, et) {
            t = (*s).t_error
        } else if !is_int(s, st) || !is_int(s, et) || !types.ty_equal(table(s), st, et) {
            complain(s)
            t = (*s).t_error
        } else {
            t = st
        }
        range_on(s)
        var_create(s, ast.s_a(b, i), t)
        block(s, ast.s_d(b, i), true)
        range_off(s)
        return
    }
    if a == ast.S_RET {
        let w: u32 = (*s).ret
        if ast.s_a(b, i) == ast.NOTHING {
            if types.ty_kind(table(s), w) != types.K_VOID && !is_error(s, w) {
                complain(s)
            }
            return
        }
        if types.ty_kind(table(s), w) == types.K_VOID {
            expr(s, ast.s_a(b, i), (*s).t_i64)
            complain(s)
            return
        }
        // HOOK error unions: implicit conversion at 'return'
        // (errors.rs::hook_coerce in check_stmt).
        if has_fe(s) && coerce_check(s, ast.s_a(b, i), w) {
            return
        }
        let got: u32 = expr(s, ast.s_a(b, i), w)
        if !types.compatible(table(s), got, w) {
            complain(s)
        }
        return
    }
    if a == ast.S_DEFER || a == ast.S_ERRDEFER {
        stmt(s, ast.s_a(b, i))
        return
    }
    if a == ast.S_EXPR {
        let e2: u32 = ast.s_a(b, i)
        let et: u32 = expr(s, e2, NONE)
        // "the result of a call is discarded as a statement"
        // (sema.rs::check_discard): HOOK error unions -- an `E!T` value is
        // implicitly #[must_consume] (SPEC 5.1), and since round 36 there is
        // also the explicit marking on a function or type (SPEC 3.3).
        if ast.e_kind(b, e2) == ast.E_CALL && ast.e_number(b, e2) == 0 {
            var discarded: bool = false
            if has_fe(s) && err.error_union_of_ty(fe(s), table(s), et) != NONE {
                discarded = true
            }
            if !discarded {
                var mj: usize = 0
                while mj < vec_len[u32](&(*s).mc_fname) {
                    if vec_at[u32](&(*s).mc_fname, mj) == ast.e_a(b, e2) {
                        discarded = true
                    }
                    mj = mj + 1
                }
            }
            if !discarded && !is_error(s, et) && types.ty_kind(table(s), et) == types.K_STRUCT {
                var mk: usize = 0
                while mk < vec_len[u32](&(*s).mc_si) {
                    if vec_at[u32](&(*s).mc_si, mk) == types.ty_a(table(s), et) {
                        discarded = true
                    }
                    mk = mk + 1
                }
            }
            if discarded {
                complain(s)
            }
        }
        return
    }
    if a == ast.S_BLOCK {
        block(s, ast.s_a(b, i), false)
        return
    }
    // break / continue: the parser has already checked the position.
}

fn block(s: *mut Sema, bi: u32, range_already_open: bool) {
    let b: *mut ast.Tree = tree(s)
    if !range_already_open {
        range_on(s)
    }
    var k: u32 = 0
    while k < ast.b_len(b, bi) {
        stmt(s, ast.slist_at(b, ast.b_off(b, bi) + k))
        k = k + 1
    }
    if !range_already_open {
        range_off(s)
    }
}

// ---------------------------------------------------------------- the run

fn sema_run(s: *mut Sema) {
    let b: *mut ast.Tree = tree(s)
    // 0. Enums: register the NAMES first, so that structs and signatures can
    //    use them (before the struct layout -- exactly like `declare_enums`
    //    before `collect_structs` in stage 0).
    if has_mu(s) {
        pattern.pat_register(mu(s), table(s))
    }
    // 0b. Error sets: register the NAMES -- after the enums, before the
    //    structs of the tree, exactly like `declare_error_sets` in stage 0. The
    //    type resolution gets the registry, so that it can resolve
    //    `__eu#<n>` placeholders.
    var fe_so_far: usize = 0
    if has_fe(s) {
        err.error_register((*s).feh, table(s), names(s))
        types.types_error_set(table(s), (*s).feh)
    }
    // 0c. gc classes: register them as structs -- AFTER the error sets, BEFORE
    //    the structs of the tree, exactly like `declare_classes` in stage 0. The
    //    type resolution gets the registry, so that it can resolve `__gc#p:`/
    //    `__gc#w:` placeholders (the same handover point as `__eu#<n>`).
    var gc_so_far: usize = 0
    if has_gc(s) {
        // ROUND 52 (prof.rs): `gc class` needs the tracing collector; the
        // kernel profile carries no GC types (SPEC 2).
        if (*s).kernel && gc.gc_has_classes((*s).gc as *mut gc.Gc) {
            complain(s)
        }
        gc.gc_register((*s).gc, table(s), names(s))
        types.types_gc_set(table(s), (*s).gc)
    }
    // 0d. Interfaces: register `dyn I` as struct -- BEFORE the structs of the
    //    tree, exactly like `declare_interfaces` in stage 0. No hook of its own
    //    is needed in the type resolution: the struct carries the
    //    name `"dyn I"`, and `resolve` finds it like any other.
    var if_so_far: usize = 0
    if has_if(s) {
        iface.if_register((*s).ifr, table(s), names(s))
    }
    // 1. Struct layout and function signatures -- the same computation as
    //    in `types.fi`, here once for everything.
    types.types_resolve(table(s), b, names(s))
    // 1a. Interfaces: check every implementation completely -- all methods
    //    present, all signatures matching (`hook_check_impls` in stage 0). Runs
    //    AFTER the signatures and BEFORE the bodies.
    if has_if(s) {
        let ij: usize = iface.if_check((*s).ifr, table(s), b, names(s))
        while if_so_far < ij {
            complain(s)
            if_so_far = if_so_far + 1
        }
    }
    // 1b. Collect `#[must_consume]` (sema.rs::check_attrs, round 36):
    //    marked functions by their NAME, marked types by their struct
    //    index (the type number is not stable -- `new_ty` hands out a
    //    new one on every call).
    var mi: usize = 0
    while mi < ast.fn_count(b) {
        if ast.fn_mc(b, mi) == 1 {
            vec_push[u32](&(*s).mc_fname, ast.fn_name(b, mi))
        }
        mi = mi + 1
    }
    mi = 0
    while mi < ast.structure_count(b) {
        if ast.structure_mc(b, mi) == 1 {
            let si: i32 = types.struct_index(table(s), ast.structure_name(b, mi))
            if si >= 0 {
                vec_push[u32](&(*s).mc_si, si as u32)
            }
        }
        mi = mi + 1
    }
    if has_fe(s) {
        // Count the errors from the registry too (duplicate sets,
        // unknown sets, unions used as a field type).
        let fj: usize = err.error_error(fe(s))
        while fe_so_far < fj {
            complain(s)
            fe_so_far = fe_so_far + 1
        }
    }
    // 1b. Enums: record the LAYOUTS -- after the struct layout of the
    //    handwritten structs and before any use (`layout_enums` in
    //    stage 0). Errors from that count too.
    if has_mu(s) {
        let mf: u32 = pattern.pat_layout(mu(s), table(s), b, names(s))
        var mk: u32 = 0
        while mk < mf {
            complain(s)
            mk = mk + 1
        }
    }
    // 1c. gc classes: work out the field layout -- only here are the structs
    //    of the program known (`layout_classes` in stage 0). Errors from that
    //    (unknown base, cycles, forbidden field types) count too.
    if has_gc(s) {
        gc.gc_layout((*s).gc, table(s), b, names(s))
        let gj: usize = gc.gc_error(gcp(s))
        while gc_so_far < gj {
            complain(s)
            gc_so_far = gc_so_far + 1
        }
    }

    // 2. Create the primitive types once instead of at every access.
    (*s).t_bool = types.new_ty(table(s), types.K_BOOL, 0, 0)
    (*s).t_i64 = types.new_ty(table(s), types.K_I64, 0, 0)
    (*s).t_usize = types.new_ty(table(s), types.K_USIZE, 0, 0)
    (*s).t_void = types.new_ty(table(s), types.K_VOID, 0, 0)
    (*s).t_error = types.new_ty(table(s), types.K_ERROR, 0, 0)
    (*s).t_f64 = types.new_ty(table(s), types.K_F64, 0, 0)

    // 3. Create the type table for all expressions.
    var i: usize = 0
    while i < ast.expr_count(b) {
        vec_push[u32](&(*s).etyp, (*s).t_error)
        i = i + 1
    }

    // 4. Constants one after another: a later one may use the earlier ones.
    range_on(s)
    i = 0
    while i < ast.const_count(b) {
        let t: u32 = ast_ty(s, ast.const_ty(b, i))
        let got: u32 = expr(s, ast.const_value(b, i), t)
        if !types.compatible(table(s), got, t) {
            complain(s)
        }
        var good: bool = true
        let v: i64 = const_eval(s, ast.const_value(b, i), &good)
        vec_push[u32](&(*s).k_name, ast.const_name(b, i))
        vec_push[u32](&(*s).k_ty, t)
        if good {
            vec_push[u64](&(*s).k_value, wrap(s, v, t) as u64)
        } else {
            vec_push[u64](&(*s).k_value, 0)
            complain(s)
        }
        i = i + 1
    }

    // 5. Function bodies.
    i = 0
    while i < ast.fn_count(b) {
        (*s).ret = types.ret_ty_the_func(table(s), i)
        range_on(s)
        var k: u32 = 0
        while k < ast.fn_plen(b, i) {
            var_create(s, ast.param_name(b, ast.fn_poff(b, i) + k),
                        types.param_ty_resolved(table(s), i, k))
            k = k + 1
        }
        block(s, ast.fn_body(b, i), true)
        range_off(s)
        i = i + 1
    }
    range_off(s)
    if has_fe(s) {
        // Unions that are resolved only inside a BODY (say
        // `let r: E!i32 = ...`) can still have counted errors there.
        let fj: usize = err.error_error(fe(s))
        while fe_so_far < fj {
            complain(s)
            fe_so_far = fe_so_far + 1
        }
    }
    if has_gc(s) {
        // gc type errors that only showed up inside a BODY (unknown
        // class in `Gc[...]`, a class name used as a value type).
        let gj: usize = gc.gc_error(gcp(s))
        while gc_so_far < gj {
            complain(s)
            gc_so_far = gc_so_far + 1
        }
        // 6. Check `#[no_gc]` transitively (nogc.rs). Runs AFTER the
        //    type check, because rule 3 (writing to a Gc[T] field) needs
        //    the type table.
        var mu2: u64 = 0
        if has_mu(s) {
            mu2 = (*s).mu
        }
        let nf: usize = nogc.nogc_check(s as u64, mu2, (*s).gc, (*s).it)
        var nk: usize = 0
        while nk < nf {
            complain(s)
            nk = nk + 1
        }
    }
}
