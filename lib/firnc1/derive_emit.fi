// SPDX-License-Identifier: MPL-2.0
import rt
import vec
import derive_decl

const D_DEBUG: u32 = 1
const D_EQ: u32 = 2
const D_ORD: u32 = 4
const D_HASH: u32 = 8
const D_CLONE: u32 = 16
const D_DEFAULT: u32 = 32

fn dv_self_type(dc: *mut derive_decl.Dc) {
    derive_decl.dv_put_range(dc, (*dc).name_s, (*dc).name_e)
    let g: usize = vec_len[usize](&(*dc).gens) / 2
    if g == 0 { return }
    derive_decl.dv_put(dc, "[")
    var i: usize = 0
    while i < g {
        if i > 0 { derive_decl.dv_put(dc, ", ") }
        derive_decl.dv_put_range(dc, vec_at[usize](&(*dc).gens, i * 2), vec_at[usize](&(*dc).gens, i * 2 + 1))
        i = i + 1
    }
    derive_decl.dv_put(dc, "]")
}

fn dv_val(dc: *mut derive_decl.Dc, v: *mut derive_decl.Val) {
    if (*v).kind == derive_decl.KIND_SELF {
        derive_decl.dv_put(dc, "(*self).")
        derive_decl.dv_put_range(dc, (*v).s, (*v).e)
    } else if (*v).kind == derive_decl.KIND_OTHER {
        derive_decl.dv_put(dc, "o.")
        derive_decl.dv_put_range(dc, (*v).s, (*v).e)
    } else if (*v).kind == derive_decl.KIND_BIND_A {
        derive_decl.dv_put(dc, "a")
        derive_decl.dv_put_num(dc, (*v).s)
    } else {
        derive_decl.dv_put(dc, "b")
        derive_decl.dv_put_num(dc, (*v).s)
    }
}

fn dv_is_str(dc: *mut derive_decl.Dc, ts: usize, te: usize) -> bool {
    return derive_decl.dv_eq_lit((*dc).src, ts, te, "str")
}

fn dv_x_debug(dc: *mut derive_decl.Dc, ts: usize, te: usize, v: *mut derive_decl.Val) {
    if dv_is_str(dc, ts, te) {
        derive_decl.dv_put(dc, "derive.str_debug(")
        dv_val(dc, v)
        derive_decl.dv_put(dc, ")")
        return
    }
    dv_val(dc, v)
    derive_decl.dv_put(dc, ".debug()")
}

fn dv_x_clone(dc: *mut derive_decl.Dc, ts: usize, te: usize, v: *mut derive_decl.Val) {
    dv_val(dc, v)
    if !dv_is_str(dc, ts, te) {
        derive_decl.dv_put(dc, ".clone()")
    }
}

fn dv_x_hash(dc: *mut derive_decl.Dc, ts: usize, te: usize, v: *mut derive_decl.Val) {
    if dv_is_str(dc, ts, te) {
        derive_decl.dv_put(dc, "derive.str_hash(")
        dv_val(dc, v)
        derive_decl.dv_put(dc, ")")
        return
    }
    dv_val(dc, v)
    derive_decl.dv_put(dc, ".hash()")
}

fn dv_x_cmp(dc: *mut derive_decl.Dc, ts: usize, te: usize, a: *mut derive_decl.Val, b: *mut derive_decl.Val) {
    var lt: str = " < "
    var gt: str = " > "
    var i: u32 = 0
    while i < 2 {
        if dv_is_str(dc, ts, te) {
            derive_decl.dv_put(dc, "if derive.str_cmp(")
        } else if derive_decl.dv_eq_lit((*dc).src, ts, te, "bool") {
            derive_decl.dv_put(dc, "if derive.bool_cmp(")
        } else {
            derive_decl.dv_put(dc, "if ")
        }
        dv_val(dc, a)
        if dv_is_str(dc, ts, te) || derive_decl.dv_eq_lit((*dc).src, ts, te, "bool") {
            derive_decl.dv_put(dc, ", ")
            dv_val(dc, b)
            if i == 0 { derive_decl.dv_put(dc, ") < 0") } else { derive_decl.dv_put(dc, ") > 0") }
        } else {
            if i == 0 { derive_decl.dv_put(dc, lt) } else { derive_decl.dv_put(dc, gt) }
            dv_val(dc, b)
        }
        if i == 0 {
            derive_decl.dv_put(dc, " { return 0 - 1 }; ")
        } else {
            derive_decl.dv_put(dc, " { return 1 }; ")
        }
        i = i + 1
    }
}

fn dv_field_val(dc: *mut derive_decl.Dc, k: usize, kind: u32, v: *mut derive_decl.Val) {
    (*v).kind = kind
    (*v).s = vec_at[usize](&(*dc).fields, k * 4)
    (*v).e = vec_at[usize](&(*dc).fields, k * 4 + 1)
}

fn dv_field_ty_s(dc: *mut derive_decl.Dc, k: usize) -> usize { return vec_at[usize](&(*dc).fields, k * 4 + 2) }

fn dv_field_ty_e(dc: *mut derive_decl.Dc, k: usize) -> usize { return vec_at[usize](&(*dc).fields, k * 4 + 3) }

fn dv_nfields(dc: *mut derive_decl.Dc) -> usize { return vec_len[usize](&(*dc).fields) / 4 }

fn dv_s_debug(dc: *mut derive_decl.Dc) {
    var v: derive_decl.Val = derive_decl.Val { kind: 0, s: 0, e: 0 }
    derive_decl.dv_put(dc, "fn debug(*self) -> str { var c = derive.dbg_new(); c = derive.dbg_text(c, \"")
    derive_decl.dv_put_range(dc, (*dc).name_s, (*dc).name_e)
    let nf: usize = dv_nfields(dc)
    if nf == 0 {
        derive_decl.dv_put(dc, "\"); ")
    } else {
        derive_decl.dv_put(dc, " { \"); ")
        var k: usize = 0
        while k < nf {
            dv_field_val(dc, k, derive_decl.KIND_SELF, &v)
            derive_decl.dv_put(dc, "c = derive.dbg_field(c, \"")
            derive_decl.dv_put_range(dc, v.s, v.e)
            if k == 0 { derive_decl.dv_put(dc, "\", \"\", ") } else { derive_decl.dv_put(dc, "\", \", \", ") }
            dv_x_debug(dc, dv_field_ty_s(dc, k), dv_field_ty_e(dc, k), &v)
            derive_decl.dv_put(dc, "); ")
            k = k + 1
        }
        derive_decl.dv_put(dc, "c = derive.dbg_text(c, \" }\"); ")
    }
    derive_decl.dv_put(dc, "return derive.dbg_done(c) } ")
}

fn dv_s_eq(dc: *mut derive_decl.Dc) {
    var a: derive_decl.Val = derive_decl.Val { kind: 0, s: 0, e: 0 }
    var b: derive_decl.Val = derive_decl.Val { kind: 1, s: 0, e: 0 }
    derive_decl.dv_put(dc, "fn eq(*self, o: ")
    dv_self_type(dc)
    derive_decl.dv_put(dc, ") -> bool { return ")
    let nf: usize = dv_nfields(dc)
    if nf == 0 { derive_decl.dv_put(dc, "true") }
    var k: usize = 0
    while k < nf {
        if k > 0 { derive_decl.dv_put(dc, " && ") }
        dv_field_val(dc, k, derive_decl.KIND_SELF, &a)
        dv_field_val(dc, k, derive_decl.KIND_OTHER, &b)
        dv_val(dc, &a)
        derive_decl.dv_put(dc, " == ")
        dv_val(dc, &b)
        k = k + 1
    }
    derive_decl.dv_put(dc, " } ")
}

fn dv_s_ord(dc: *mut derive_decl.Dc) {
    var a: derive_decl.Val = derive_decl.Val { kind: 0, s: 0, e: 0 }
    var b: derive_decl.Val = derive_decl.Val { kind: 1, s: 0, e: 0 }
    derive_decl.dv_put(dc, "fn cmp(*self, o: ")
    dv_self_type(dc)
    derive_decl.dv_put(dc, ") -> i64 { ")
    var k: usize = 0
    while k < dv_nfields(dc) {
        dv_field_val(dc, k, derive_decl.KIND_SELF, &a)
        dv_field_val(dc, k, derive_decl.KIND_OTHER, &b)
        dv_x_cmp(dc, dv_field_ty_s(dc, k), dv_field_ty_e(dc, k), &a, &b)
        k = k + 1
    }
    derive_decl.dv_put(dc, "return 0 } ")
}

fn dv_s_hash(dc: *mut derive_decl.Dc) {
    var v: derive_decl.Val = derive_decl.Val { kind: 0, s: 0, e: 0 }
    derive_decl.dv_put(dc, "fn hash(*self) -> u64 { var h: u64 = derive.hash_seed(); ")
    var k: usize = 0
    while k < dv_nfields(dc) {
        dv_field_val(dc, k, derive_decl.KIND_SELF, &v)
        derive_decl.dv_put(dc, "h = derive.hash_mix(h, ")
        dv_x_hash(dc, dv_field_ty_s(dc, k), dv_field_ty_e(dc, k), &v)
        derive_decl.dv_put(dc, "); ")
        k = k + 1
    }
    derive_decl.dv_put(dc, "return h } ")
}

fn dv_s_clone(dc: *mut derive_decl.Dc) {
    var v: derive_decl.Val = derive_decl.Val { kind: 0, s: 0, e: 0 }
    derive_decl.dv_put(dc, "fn clone(*self) -> ")
    dv_self_type(dc)
    derive_decl.dv_put(dc, " { return ")
    dv_self_type(dc)
    derive_decl.dv_put(dc, " { ")
    var k: usize = 0
    while k < dv_nfields(dc) {
        if k > 0 { derive_decl.dv_put(dc, ", ") }
        dv_field_val(dc, k, derive_decl.KIND_SELF, &v)
        derive_decl.dv_put_range(dc, v.s, v.e)
        derive_decl.dv_put(dc, ": ")
        dv_x_clone(dc, dv_field_ty_s(dc, k), dv_field_ty_e(dc, k), &v)
        k = k + 1
    }
    derive_decl.dv_put(dc, " } } ")
}

fn dv_default_value(dc: *mut derive_decl.Dc, ts: usize, te: usize) -> bool {
    let src: u64 = (*dc).src
    if derive_decl.dv_eq_lit(src, ts, te, "i8") || derive_decl.dv_eq_lit(src, ts, te, "i16")
    || derive_decl.dv_eq_lit(src, ts, te, "i32") || derive_decl.dv_eq_lit(src, ts, te, "i64")
    || derive_decl.dv_eq_lit(src, ts, te, "isize") || derive_decl.dv_eq_lit(src, ts, te, "u8")
    || derive_decl.dv_eq_lit(src, ts, te, "u16") || derive_decl.dv_eq_lit(src, ts, te, "u32")
    || derive_decl.dv_eq_lit(src, ts, te, "u64") || derive_decl.dv_eq_lit(src, ts, te, "usize")
    || derive_decl.dv_eq_lit(src, ts, te, "f32") {
        derive_decl.dv_put(dc, "0 as ")
        derive_decl.dv_put_range(dc, ts, te)
        return true
    }
    if derive_decl.dv_eq_lit(src, ts, te, "f64") {
        derive_decl.dv_put(dc, "0.0")
        return true
    }
    if derive_decl.dv_eq_lit(src, ts, te, "bool") {
        derive_decl.dv_put(dc, "false")
        return true
    }
    if derive_decl.dv_eq_lit(src, ts, te, "str") {
        derive_decl.dv_put(dc, "\"\"")
        return true
    }
    if derive_decl.dv_starts(src, te, ts, "Vec[") && derive_decl.dv_at(src, te - 1) == 93 {
        derive_decl.dv_put(dc, "vec_new[")
        derive_decl.dv_put_range(dc, ts + 4, te - 1)
        derive_decl.dv_put(dc, "]()")
        return true
    }
    var i: usize = ts
    while i < te {
        let c: u8 = derive_decl.dv_at(src, i)
        if c == 91 || c == 40 {
            return derive_decl.dv_fail(dc, (*dc).name_s, 1, "derive(Default): a field type has no default")
        }
        i = i + 1
    }
    derive_decl.dv_put(dc, "default_")
    derive_decl.dv_put_range(dc, ts, te)
    derive_decl.dv_put(dc, "()")
    return true
}

fn dv_s_default(dc: *mut derive_decl.Dc) -> bool {
    derive_decl.dv_put(dc, " fn default_")
    derive_decl.dv_put_range(dc, (*dc).name_s, (*dc).name_e)
    derive_decl.dv_put(dc, "() -> ")
    derive_decl.dv_put_range(dc, (*dc).name_s, (*dc).name_e)
    derive_decl.dv_put(dc, " { return ")
    derive_decl.dv_put_range(dc, (*dc).name_s, (*dc).name_e)
    derive_decl.dv_put(dc, " { ")
    var v: derive_decl.Val = derive_decl.Val { kind: 0, s: 0, e: 0 }
    var k: usize = 0
    while k < dv_nfields(dc) {
        if k > 0 { derive_decl.dv_put(dc, ", ") }
        dv_field_val(dc, k, derive_decl.KIND_SELF, &v)
        derive_decl.dv_put_range(dc, v.s, v.e)
        derive_decl.dv_put(dc, ": ")
        if !dv_default_value(dc, dv_field_ty_s(dc, k), dv_field_ty_e(dc, k)) { return false }
        k = k + 1
    }
    derive_decl.dv_put(dc, " } } impl ")
    derive_decl.dv_put_range(dc, (*dc).name_s, (*dc).name_e)
    derive_decl.dv_put(dc, " { fn default() -> ")
    derive_decl.dv_put_range(dc, (*dc).name_s, (*dc).name_e)
    derive_decl.dv_put(dc, " { return default_")
    derive_decl.dv_put_range(dc, (*dc).name_s, (*dc).name_e)
    derive_decl.dv_put(dc, "() } }")
    return true
}

fn dv_struct_methods(dc: *mut derive_decl.Dc, flags: u32) {
    if (flags & D_DEBUG) != 0 { dv_s_debug(dc) }
    if (flags & D_EQ) != 0 { dv_s_eq(dc) }
    if (flags & D_ORD) != 0 { dv_s_ord(dc) }
    if (flags & D_HASH) != 0 { dv_s_hash(dc) }
    if (flags & D_CLONE) != 0 { dv_s_clone(dc) }
}
