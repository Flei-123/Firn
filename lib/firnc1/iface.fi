// lib/firnc1/iface.fi — `interface`, `dyn I` und der DYNAMISCHE VERSAND:
// DIE REGISTRIERUNG, IN FIRN (Runde 46).
//
// Die Portierung des Datenmodells von `compiler/src/iface.rs`. Derselbe
// Aufbau wie `pattern.fi` (Runde 32), `err.fi` (Runde 33) und `gc.fi`
// (Runde 34): die Registrierung liegt AUSSERHALB des Baums, weil sie ueber
// alle Dateien einer Uebersetzung hinweg dieselbe sein muss. Namen von
// Schnittstellen gelten programmweit und werden NICHT umbenannt — genau wie
// Aufzaehlungen und gc-Klassen.
//
// DARSTELLUNG (verbindlich, docs/RUNDE46.md, wortgleich zu Stufe 0):
//
//   interface I { … }  -> Struct "dyn I" im Typkontext, 16 Byte:
//                           daten: *mut u8  (Versatz 0)
//                           tafel: *mut u8  (Versatz 8)
//   dyn I              -> genau dieser Struct (ein FETTER ZEIGER)
//   impl I for T       -> Methodentafel `.L__iface.I.T` in `.rodata`
//
// Der Typname `dyn I` steht mit einem LEERZEICHEN im Interner und kann
// deshalb aus keinem Bezeichner des Quelltextes entstehen — dieselbe Bauart
// wie `"gc C"` und `"methode m"`.
//
// DER TYPNAME EINER UMSETZUNG steht hier so, wie er im Quelltext geschrieben
// wurde. `firnc1` benennt Modulnamen beim Parsen um, `firnc0` danach; damit
// beide Compiler dieselbe Umsetzung finden, sucht `if_pruefen` den Struct in
// derselben Reihenfolge wie `iface.rs::typ_struct`: der Name selbst, dann
// `gc <Name>`, dann GENAU EIN Struct, dessen Name auf `__<Name>` endet.

import rt
import vec
import intern
import ast
import types

export { If, if_new, if_free, if_error, if_count, if_has, if_names_self,
         if_add, if_method_add, if_impl_add,
         if_index, if_name, if_sidx, if_of_dyn, if_is_dyn_name,
         if_mlen, if_mname, if_slot, if_rtyp, if_plen, if_ptyp,
         if_register, if_check, if_impl_ok, if_table,
         if_u_count, if_u_ok, if_u_if, if_u_pre, if_u_sidx,
         // Runde 50
         if_m_self, if_impl_da }

const KEIN: u32 = 4294967295

struct If {
    i_name: Vec[u32],      // Name der Schnittstelle
    i_dname: Vec[u32],     // Name des Structs "dyn I"
    i_moff: Vec[u32],      // Methoden: Bereich in m_*
    i_mlen: Vec[u32],
    i_sidx: Vec[u32],      // Struct "dyn I" im Typkontext (KEIN bis if_anmelden)
    m_name: Vec[u32],      // Methodenname
    m_poff: Vec[u32],      // Parameter: Bereich in p_* (OHNE den Empfaenger)
    m_plen: Vec[u32],
    m_ret: Vec[u32],       // Typknoten im Baum, ast.NICHTS = kein Rueckgabewert
    m_rtyp: Vec[u32],      // aufgeloest
    m_on: Vec[u32],       // 1 = Typen aufgeloest
    m_self: Vec[u32],      // 1 = die Signatur nennt `Self` (Runde 50)
    p_te: Vec[u32],        // Typknoten im Baum
    p_ty: Vec[u32],       // aufgeloest
    u_if: Vec[u32],        // Umsetzungen: Name der Schnittstelle
    u_ty: Vec[u32],       // Typname, wie geschrieben
    u_sidx: Vec[u32],      // aufgeloest (KEIN = nicht gefunden)
    u_pre: Vec[u32],      // Name, unter dem die Methoden stehen (`T__m`)
    u_ok: Vec[u32],        // 1 = Umsetzung vollstaendig
    u_checked: Vec[u32],
    scratch: rt.Buf,
    err: usize,
}

fn if_new() -> If {
    return If{
        i_name: vec_new[u32](), i_dname: vec_new[u32](),
        i_moff: vec_new[u32](), i_mlen: vec_new[u32](), i_sidx: vec_new[u32](),
        m_name: vec_new[u32](), m_poff: vec_new[u32](), m_plen: vec_new[u32](),
        m_ret: vec_new[u32](), m_rtyp: vec_new[u32](), m_on: vec_new[u32](),
        m_self: vec_new[u32](),
        p_te: vec_new[u32](), p_ty: vec_new[u32](),
        u_if: vec_new[u32](), u_ty: vec_new[u32](), u_sidx: vec_new[u32](),
        u_pre: vec_new[u32](), u_ok: vec_new[u32](), u_checked: vec_new[u32](),
        scratch: rt.buf_new(),
        err: 0,
    }
}

fn if_free(f: *mut If) {
    vec_free[u32](&(*f).i_name)
    vec_free[u32](&(*f).i_dname)
    vec_free[u32](&(*f).i_moff)
    vec_free[u32](&(*f).i_mlen)
    vec_free[u32](&(*f).i_sidx)
    vec_free[u32](&(*f).m_name)
    vec_free[u32](&(*f).m_poff)
    vec_free[u32](&(*f).m_plen)
    vec_free[u32](&(*f).m_ret)
    vec_free[u32](&(*f).m_rtyp)
    vec_free[u32](&(*f).m_on)
    vec_free[u32](&(*f).m_self)
    vec_free[u32](&(*f).p_te)
    vec_free[u32](&(*f).p_ty)
    vec_free[u32](&(*f).u_if)
    vec_free[u32](&(*f).u_ty)
    vec_free[u32](&(*f).u_sidx)
    vec_free[u32](&(*f).u_pre)
    vec_free[u32](&(*f).u_ok)
    vec_free[u32](&(*f).u_checked)
    rt.buf_free(&(*f).scratch)
}

fn if_error(f: *mut If) -> usize { return (*f).err }

fn if_count(f: *mut If) -> usize { return vec_len[u32](&(*f).i_name) }

fn if_has(f: *mut If) -> bool { return vec_len[u32](&(*f).i_name) > 0 }

fn if_name(f: *mut If, i: usize) -> u32 { return vec_at[u32](&(*f).i_name, i) }

fn if_sidx(f: *mut If, i: usize) -> u32 { return vec_at[u32](&(*f).i_sidx, i) }

fn if_mlen(f: *mut If, i: usize) -> u32 { return vec_at[u32](&(*f).i_mlen, i) }

fn if_mname(f: *mut If, i: usize, k: u32) -> u32 {
    return vec_at[u32](&(*f).m_name, (vec_at[u32](&(*f).i_moff, i) + k) as usize)
}

// Nennt die Signatur dieser Methode `Self`? Dann haengen ihre Typen am
// umsetzenden Typ, und ueber `dyn I` ist sie nicht aufrufbar (Runde 50).
fn if_m_self(f: *mut If, i: u32, k: u32) -> bool {
    let m: usize = (vec_at[u32](&(*f).i_moff, i as usize) + k) as usize
    return vec_at[u32](&(*f).m_self, m) == 1
}

// Der noch nicht aufgeloeste Typknoten eines Parameters bzw. des
// Rueckgabewertes — gebraucht, wenn `Self` erst je Umsetzung eingesetzt wird.
fn if_pte(f: *mut If, i: u32, k: u32, j: u32) -> u32 {
    let m: usize = (vec_at[u32](&(*f).i_moff, i as usize) + k) as usize
    return vec_at[u32](&(*f).p_te, (vec_at[u32](&(*f).m_poff, m) + j) as usize)
}

fn if_mret(f: *mut If, i: u32, k: u32) -> u32 {
    let m: usize = (vec_at[u32](&(*f).i_moff, i as usize) + k) as usize
    return vec_at[u32](&(*f).m_ret, m)
}

fn if_rtyp(f: *mut If, i: usize, k: u32) -> u32 {
    return vec_at[u32](&(*f).m_rtyp, (vec_at[u32](&(*f).i_moff, i) + k) as usize)
}

fn if_plen(f: *mut If, i: usize, k: u32) -> u32 {
    return vec_at[u32](&(*f).m_plen, (vec_at[u32](&(*f).i_moff, i) + k) as usize)
}

fn if_ptyp(f: *mut If, i: usize, k: u32, j: u32) -> u32 {
    let m: usize = (vec_at[u32](&(*f).i_moff, i) + k) as usize
    return vec_at[u32](&(*f).p_ty, (vec_at[u32](&(*f).m_poff, m) + j) as usize)
}

// Nummer der Methode in der Schnittstelle = Platz in der Methodentafel.
fn if_slot(f: *mut If, i: usize, mname: u32) -> u32 {
    var k: u32 = 0
    while k < if_mlen(f, i) {
        if if_mname(f, i, k) == mname {
            return k
        }
        k = k + 1
    }
    return KEIN
}

fn if_index(f: *mut If, name: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*f).i_name) {
        if vec_at[u32](&(*f).i_name, i) == name {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// Schnittstelle hinter dem Structnamen `dyn I`.
fn if_of_dyn(f: *mut If, sname: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*f).i_dname) {
        if vec_at[u32](&(*f).i_dname, i) == sname {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// Faengt der Name mit `"dyn "` an? (Auch ohne Registrierung beantwortbar.)
fn if_is_dyn_name(it: *mut intern.Interner, name: u32) -> bool {
    var w: [u8; 4] = "dyn "
    return intern.intern_prefix(it, name, (&w[0]) as u64, 4)
}

// `"dyn " ++ name` — der interne Structname.
fn dynname(f: *mut If, it: *mut intern.Interner, name: u32) -> u32 {
    rt.buf_clear(&(*f).scratch)
    var w: [u8; 4] = "dyn "
    rt.buf_push_bytes(&(*f).scratch, (&w[0]) as u64, 4)
    rt.buf_push_bytes(&(*f).scratch, intern.intern_ptr(it, name),
                      intern.intern_length(it, name))
    return intern.intern_number(it, rt.buf_ptr(&(*f).scratch),
                                rt.buf_len(&(*f).scratch)) as u32
}

// `a ++ "__" ++ b`
fn joined(f: *mut If, it: *mut intern.Interner, a: u32, b: u32) -> u32 {
    rt.buf_clear(&(*f).scratch)
    rt.buf_push_bytes(&(*f).scratch, intern.intern_ptr(it, a),
                      intern.intern_length(it, a))
    var tr: [u8; 2] = "__"
    rt.buf_push_bytes(&(*f).scratch, (&tr[0]) as u64, 2)
    rt.buf_push_bytes(&(*f).scratch, intern.intern_ptr(it, b),
                      intern.intern_length(it, b))
    return intern.intern_number(it, rt.buf_ptr(&(*f).scratch),
                                rt.buf_len(&(*f).scratch)) as u32
}

// -------------------------------------------------------------- Der Parser

// Neue Schnittstelle. KEIN = der Name ist schon vergeben.
fn if_add(f: *mut If, it: *mut intern.Interner, name: u32) -> u32 {
    if if_index(f, name) != KEIN {
        return KEIN
    }
    let i: u32 = vec_len[u32](&(*f).i_name) as u32
    vec_push[u32](&(*f).i_name, name)
    vec_push[u32](&(*f).i_dname, dynname(f, it, name))
    vec_push[u32](&(*f).i_moff, vec_len[u32](&(*f).m_name) as u32)
    vec_push[u32](&(*f).i_mlen, 0)
    vec_push[u32](&(*f).i_sidx, KEIN)
    return i
}

// Eine Methode anhaengen. Die Parametertypen stehen in `ptypen` (Typknoten
// des Baums, OHNE den Empfaenger). `false` = die Methode gibt es schon.
fn if_method_add(f: *mut If, i: u32, name: u32, ptypes: *mut Vec[u32],
                   ret: u32, has_self: bool) -> bool {
    if if_slot(f, i as usize, name) != KEIN {
        return false
    }
    let poff: u32 = vec_len[u32](&(*f).p_te) as u32
    var k: usize = 0
    while k < vec_len[u32](ptypes) {
        vec_push[u32](&(*f).p_te, vec_at[u32](ptypes, k))
        vec_push[u32](&(*f).p_ty, 0)
        k = k + 1
    }
    vec_push[u32](&(*f).m_name, name)
    vec_push[u32](&(*f).m_poff, poff)
    vec_push[u32](&(*f).m_plen, vec_len[u32](ptypes) as u32)
    vec_push[u32](&(*f).m_ret, ret)
    vec_push[u32](&(*f).m_rtyp, 0)
    vec_push[u32](&(*f).m_on, 0)
    var hs: u32 = 0
    if has_self {
        hs = 1
    }
    vec_push[u32](&(*f).m_self, hs)
    vec_set[u32](&(*f).i_mlen, i as usize, vec_at[u32](&(*f).i_mlen, i as usize) + 1)
    return true
}

// `impl I for T` anmelden.
fn if_impl_add(f: *mut If, iface: u32, ty: u32) {
    vec_push[u32](&(*f).u_if, iface)
    vec_push[u32](&(*f).u_ty, ty)
    vec_push[u32](&(*f).u_sidx, KEIN)
    vec_push[u32](&(*f).u_pre, KEIN)
    vec_push[u32](&(*f).u_ok, 0)
    vec_push[u32](&(*f).u_checked, 0)
}

// ------------------------------------------------------------ Die Typtafel

// Fuer jede Schnittstelle den Struct `"dyn I"` anlegen: zwei Zeiger,
// 16 Byte, Ausrichtung 8. MUSS vor `typen_aufloesen` laufen — genau wie
// `declare_interfaces` in Stufe 0 vor `collect_structs`.
fn if_register(f2: u64, t: *mut types.Types, it: *mut intern.Interner) {
    let f: *mut If = f2 as *mut If
    let n: usize = if_count(f)
    if n == 0 {
        return
    }
    let u8t: u32 = types.new_ty(t, types.K_U8, 0, 0)
    let pt: u32 = types.new_ty(t, types.K_PTR, u8t, 1)
    var i: usize = 0
    while i < n {
        if vec_at[u32](&(*f).i_sidx, i) == KEIN {
            let sn: u32 = vec_at[u32](&(*f).i_dname, i)
            let sidx: u32 = types.types_struct_reserve(t, sn)
            var names: Vec[u32] = vec_new[u32]()
            var types_v: Vec[u32] = vec_new[u32]()
            var ver: Vec[u64] = vec_new[u64]()
            var dw: [u8; 4] = "data"
            var tw: [u8; 5] = "table"
            vec_push[u32](&names, intern.intern_number(it, (&dw[0]) as u64, 5) as u32)
            vec_push[u32](&types_v, pt)
            vec_push[u64](&ver, 0)
            vec_push[u32](&names, intern.intern_number(it, (&tw[0]) as u64, 5) as u32)
            vec_push[u32](&types_v, pt)
            vec_push[u64](&ver, 8)
            types.types_struct_define(t, sidx, 16, 8, &names, &types_v, &ver)
            vec_free[u32](&names)
            vec_free[u32](&types_v)
            vec_free[u64](&ver)
            vec_set[u32](&(*f).i_sidx, i, sidx)
        }
        i = i + 1
    }
}

// --------------------------------------------------------- Die Pruefung

// Struct hinter dem Typnamen einer Umsetzung — dieselben drei Schritte wie
// `iface.rs::typ_struct`.
fn ty_struct(f: *mut If, t: *mut types.Types, it: *mut intern.Interner,
              name: u32, ambiguous: *mut bool) -> u32 {
    *ambiguous = false
    let d: i32 = types.struct_index(t, name)
    if d >= 0 {
        return d as u32
    }
    // `gc <Name>`
    rt.buf_clear(&(*f).scratch)
    var gw: [u8; 3] = "gc "
    rt.buf_push_bytes(&(*f).scratch, (&gw[0]) as u64, 3)
    rt.buf_push_bytes(&(*f).scratch, intern.intern_ptr(it, name),
                      intern.intern_length(it, name))
    let gn: i64 = intern.intern_find(it, rt.buf_ptr(&(*f).scratch),
                                      rt.buf_len(&(*f).scratch))
    if gn >= 0 {
        let g: i32 = types.struct_index(t, gn as u32)
        if g >= 0 {
            return g as u32
        }
    }
    // GENAU EIN Struct, dessen Name auf `__<Name>` endet (Typ in einem Modul)
    rt.buf_clear(&(*f).scratch)
    var uw: [u8; 2] = "__"
    rt.buf_push_bytes(&(*f).scratch, (&uw[0]) as u64, 2)
    rt.buf_push_bytes(&(*f).scratch, intern.intern_ptr(it, name),
                      intern.intern_length(it, name))
    let sp: u64 = rt.buf_ptr(&(*f).scratch)
    let sn: usize = rt.buf_len(&(*f).scratch)
    var hit: u32 = KEIN
    var number: usize = 0
    var i: usize = 0
    while i < types.st_count(t) {
        let nm: u32 = types.st_name(t, i)
        let ln: usize = intern.intern_length(it, nm)
        if ln > sn {
            var equal: bool = true
            var k: usize = 0
            while k < sn {
                if rt.ld8(intern.intern_ptr(it, nm), ln - sn + k) != rt.ld8(sp, k) {
                    equal = false
                    break
                }
                k = k + 1
            }
            if equal {
                hit = i as u32
                number = number + 1
            }
        }
        i = i + 1
    }
    if number == 1 {
        return hit
    }
    if number > 1 {
        *ambiguous = true
    }
    return KEIN
}

// Name, unter dem die Methoden eines Typs stehen: der Structname ohne das
// interne `"gc "` einer Klasse.
fn method_prefix(f: *mut If, t: *mut types.Types, it: *mut intern.Interner,
                   sidx: u32) -> u32 {
    let nm: u32 = types.st_name(t, sidx as usize)
    var gw: [u8; 3] = "gc "
    if !intern.intern_prefix(it, nm, (&gw[0]) as u64, 3) {
        return nm
    }
    return intern.intern_ab(it, nm, 3)
}

// Passen zwei Typen an einer Signaturgrenze? Dieselbe Regel wie
// `typen.vertraeglich`: Zeiger ohne die Veraenderlichkeit.
fn fits(t: *mut types.Types, a: u32, b: u32) -> bool {
    return types.compatible(t, a, b)
}

// Die Typen der Schnittstellenmethoden aufloesen und jede Umsetzung pruefen.
// MUSS nach `typen_aufloesen` laufen (die Signaturen der Funktionen stehen
// erst dann). Rueckgabe: die Zahl der neuen Fehler.
fn if_check(f2: u64, t: *mut types.Types, b: *mut ast.Tree,
              it: *mut intern.Interner) -> usize {
    let f: *mut If = f2 as *mut If
    let before: usize = (*f).err
    // 1. Typen der Methoden aufloesen (einmal je Methode).
    var m: usize = 0
    while m < vec_len[u32](&(*f).m_name) {
        // Eine Signatur mit `Self` hat GLOBAL keine Typen — sie bekommt sie
        // erst je Umsetzung (`pruefe_umsetzung`). Hier aufzuloesen hiesse,
        // `Self` als gewoehnlichen Typnamen zu suchen.
        if vec_at[u32](&(*f).m_self, m) == 1 {
            vec_set[u32](&(*f).m_on, m, 1)
        }
        if vec_at[u32](&(*f).m_on, m) == 0 {
            let poff: u32 = vec_at[u32](&(*f).m_poff, m)
            var k: u32 = 0
            while k < vec_at[u32](&(*f).m_plen, m) {
                let te: u32 = vec_at[u32](&(*f).p_te, (poff + k) as usize)
                vec_set[u32](&(*f).p_ty, (poff + k) as usize,
                                types.resolve(t, b, it, te))
                k = k + 1
            }
            let r: u32 = vec_at[u32](&(*f).m_ret, m)
            if r == ast.NICHTS {
                vec_set[u32](&(*f).m_rtyp, m, types.new_ty(t, types.K_VOID, 0, 0))
            } else {
                vec_set[u32](&(*f).m_rtyp, m, types.resolve(t, b, it, r))
            }
            vec_set[u32](&(*f).m_on, m, 1)
        }
        m = m + 1
    }
    // 2. Jede Umsetzung pruefen.
    var u: usize = 0
    while u < vec_len[u32](&(*f).u_if) {
        if vec_at[u32](&(*f).u_checked, u) == 0 {
            vec_set[u32](&(*f).u_checked, u, 1)
            check_impl(f, t, b, it, u)
        }
        u = u + 1
    }
    return (*f).err - before
}

// Heisst dieser Name `Self`? (Runde 50)
fn is_self(it: *mut intern.Interner, nr: u32) -> bool {
    var w: [u8; 4] = "Self"
    return intern.intern_equal(it, nr, (&w[0]) as u64, 4)
}

// Nennt dieser Typknoten `Self`? Gebraucht beim Parsen einer Schnittstelle.
fn if_names_self(b: *mut ast.Tree, it: *mut intern.Interner, te: u32) -> bool {
    if te == ast.NICHTS {
        return false
    }
    let a: u32 = ast.t_kind(b, te)
    if a == ast.T_PTR || a == ast.T_ARR {
        return if_names_self(b, it, ast.t_a(b, te))
    }
    return is_self(it, ast.t_a(b, te))
}

// Wie `typen.aufloesen`, aber `Self` wird durch den Typ der Umsetzung
// ersetzt. Das ist die ganze Sonderbehandlung von `Self`: die Schnittstelle
// haelt den Typknoten, die Umsetzung setzt ein.
fn resolve_self(t: *mut types.Types, b: *mut ast.Tree, it: *mut intern.Interner,
                  te: u32, slf: u32) -> u32 {
    if te == ast.NICHTS {
        return types.new_ty(t, types.K_VOID, 0, 0)
    }
    let a: u32 = ast.t_kind(b, te)
    if a == ast.T_PTR {
        let inner: u32 = resolve_self(t, b, it, ast.t_a(b, te), slf)
        return types.new_ty(t, types.K_PTR, inner, ast.t_b(b, te))
    }
    if a == ast.T_ARR {
        let elem: u32 = resolve_self(t, b, it, ast.t_a(b, te), slf)
        return types.new_ty(t, types.K_ARR, elem, ast.t_b(b, te))
    }
    if is_self(it, ast.t_a(b, te)) {
        return slf
    }
    return types.resolve(t, b, it, te)
}

// SETZT DER TYP `typname` DIE SCHNITTSTELLE `iname` UM? (Runde 50)
//
// Verglichen werden NAMEN, nicht Typen: gefragt wird bei der Auspraegung
// (`mono.fi`), also vor dem Typpruefer. Der Name in der Registrierung steht
// so da, wie er im Quelltext geschrieben wurde; das Typargument traegt schon
// den Namen nach der Modulumbenennung. Deshalb dieselben drei Schritte wie in
// `typ_struct` — nur dass die Endungsregel fuer einen GRUNDTYP nicht gilt:
// `Vec__i32` endet auf `__i32`, ist aber `Vec[i32]` und nicht `i32`.
fn if_impl_da(f: *mut If, it: *mut intern.Interner, iname: u32,
                   ty_name: u32) -> bool {
    var u: usize = 0
    while u < vec_len[u32](&(*f).u_if) {
        if vec_at[u32](&(*f).u_if, u) == iname {
            let ut: u32 = vec_at[u32](&(*f).u_ty, u)
            if ut == ty_name {
                return true
            }
            // `gc <Name>`
            rt.buf_clear(&(*f).scratch)
            var gw: [u8; 3] = "gc "
            rt.buf_push_bytes(&(*f).scratch, (&gw[0]) as u64, 3)
            rt.buf_push_bytes(&(*f).scratch, intern.intern_ptr(it, ut),
                              intern.intern_length(it, ut))
            if intern.intern_equal(it, ty_name, rt.buf_ptr(&(*f).scratch),
                                    rt.buf_len(&(*f).scratch)) {
                return true
            }
            if types.base_ty(it, ut) < 0 {
                rt.buf_clear(&(*f).scratch)
                var uw: [u8; 2] = "__"
                rt.buf_push_bytes(&(*f).scratch, (&uw[0]) as u64, 2)
                rt.buf_push_bytes(&(*f).scratch, intern.intern_ptr(it, ut),
                                  intern.intern_length(it, ut))
                if ends_on(it, ty_name, rt.buf_ptr(&(*f).scratch),
                             rt.buf_len(&(*f).scratch)) {
                    return true
                }
            }
        }
        u = u + 1
    }
    return false
}

fn ends_on(it: *mut intern.Interner, name: u32, p: u64, n: usize) -> bool {
    let ln: usize = intern.intern_length(it, name)
    if ln <= n {
        return false
    }
    let zp: u64 = intern.intern_ptr(it, name)
    var k: usize = 0
    while k < n {
        if rt.ld8(zp, ln - n + k) != rt.ld8(p, k) {
            return false
        }
        k = k + 1
    }
    return true
}

fn check_impl(f: *mut If, t: *mut types.Types, b: *mut ast.Tree,
                    it: *mut intern.Interner, u: usize) {
    let iname: u32 = vec_at[u32](&(*f).u_if, u)
    let ii: u32 = if_index(f, iname)
    if ii == KEIN {
        // unbekannte schnittstelle
        (*f).err = (*f).err + 1
        return
    }
    // TRAEGER DER UMSETZUNG: ein Struct oder — seit Runde 50 — ein
    // GRUNDTYP. Ein Grundtyp steht nicht in der Structtafel; `u_sidx` bleibt
    // dann KEIN, und alles, was den Index braucht (Methodentafel, `as dyn I`),
    // gilt fuer ihn nicht. Der Grundtyp wird ZUERST gefragt: die Endungssuche
    // in `typ_struct` faende sonst `Vec__i32` fuer `i32`.
    let raw: u32 = vec_at[u32](&(*f).u_ty, u)
    var sidx: u32 = KEIN
    var slf: u32 = 0
    var pre: u32 = 0
    let g: i32 = types.base_ty(it, raw)
    if g >= 0 {
        slf = types.new_ty(t, g as u32, 0, 0)
        pre = raw
    } else {
        var ambiguous: bool = false
        sidx = ty_struct(f, t, it, raw, &ambiguous)
        if sidx == KEIN {
            // unbekannter oder mehrdeutiger typ
            (*f).err = (*f).err + 1
            return
        }
        // Eine Schnittstelle setzt keine Schnittstelle um.
        if if_of_dyn(f, types.st_name(t, sidx as usize)) != KEIN {
            (*f).err = (*f).err + 1
            return
        }
        pre = method_prefix(f, t, it, sidx)
        slf = types.new_ty(t, types.K_STRUCT, sidx, 0)
    }
    // Doppelte Umsetzung — verglichen wird der METHODENPRAEFIX des
    // aufgeloesten Traegers, damit Grundtypen (ohne Structindex) mitzaehlen.
    var v: usize = 0
    while v < u {
        if vec_at[u32](&(*f).u_if, v) == iname {
            let pv: u32 = vec_at[u32](&(*f).u_pre, v)
            if pv != KEIN && pv == pre {
                (*f).err = (*f).err + 1
                return
            }
        }
        v = v + 1
    }
    vec_set[u32](&(*f).u_sidx, u, sidx)
    vec_set[u32](&(*f).u_pre, u, pre)
    var complete: bool = true
    var k: u32 = 0
    while k < if_mlen(f, ii as usize) {
        let full: u32 = joined(f, it, pre, if_mname(f, ii as usize, k))
        let fi: i64 = fn_search(b, full)
        if fi < 0 {
            // die methode fehlt
            complete = false
            (*f).err = (*f).err + 1
            k = k + 1
            continue
        }
        // Bei `Self` haengen die Typen an DIESER Umsetzung, nicht an der
        // Schnittstelle — deshalb hier aufgeloest und nicht in Schritt 1.
        let mself: bool = if_m_self(f, ii, k)
        let plen: u32 = ast.fn_plen(b, fi as usize)
        if plen < 1 {
            complete = false
            (*f).err = (*f).err + 1
            k = k + 1
            continue
        }
        // Empfaenger: ein Zeiger auf GENAU diesen Typ.
        let p0: u32 = types.param_ty_resolved(t, fi as usize, 0)
        if !types.is_ptr(t, p0) || !types.ty_equal(t, types.ty_a(t, p0), slf) {
            complete = false
            (*f).err = (*f).err + 1
            k = k + 1
            continue
        }
        if plen != if_plen(f, ii as usize, k) + 1 {
            complete = false
            (*f).err = (*f).err + 1
            k = k + 1
            continue
        }
        var matching: bool = true
        var j: u32 = 0
        while j < if_plen(f, ii as usize, k) {
            let actual: u32 = types.param_ty_resolved(t, fi as usize, j + 1)
            var should: u32 = 0
            if mself {
                should = resolve_self(t, b, it, if_pte(f, ii, k, j), slf)
            } else {
                should = if_ptyp(f, ii as usize, k, j)
            }
            if !fits(t, actual, should) {
                matching = false
                break
            }
            j = j + 1
        }
        if !matching {
            complete = false
            (*f).err = (*f).err + 1
            k = k + 1
            continue
        }
        var sollr: u32 = 0
        if mself {
            sollr = resolve_self(t, b, it, if_mret(f, ii, k), slf)
        } else {
            sollr = if_rtyp(f, ii as usize, k)
        }
        if !fits(t, types.ret_ty_the_func(t, fi as usize), sollr) {
            complete = false
            (*f).err = (*f).err + 1
        }
        k = k + 1
    }
    if complete {
        vec_set[u32](&(*f).u_ok, u, 1)
    }
}

fn fn_search(b: *mut ast.Tree, name: u32) -> i64 {
    var i: usize = 0
    while i < ast.fn_count(b) {
        if ast.fn_name(b, i) == name {
            return i as i64
        }
        i = i + 1
    }
    return -1
}

// Setzt der Struct `sidx` die Schnittstelle `ii` vollstaendig um?
fn if_impl_ok(f: *mut If, ii: u32, sidx: u32) -> bool {
    if sidx == KEIN {
        return false
    }
    let iname: u32 = if_name(f, ii as usize)
    var u: usize = 0
    while u < vec_len[u32](&(*f).u_if) {
        if vec_at[u32](&(*f).u_if, u) == iname && vec_at[u32](&(*f).u_sidx, u) == sidx {
            if vec_at[u32](&(*f).u_ok, u) == 1 {
                return true
            }
        }
        u = u + 1
    }
    return false
}

// Methodenpraefix der Umsetzung — der zweite Teil des Tafelnamens.
// KEIN, wenn dieser Typ die Schnittstelle nicht (vollstaendig) umsetzt.
fn if_table(f: *mut If, ii: u32, sidx: u32) -> u32 {
    if sidx == KEIN {
        return KEIN
    }
    let iname: u32 = if_name(f, ii as usize)
    var u: usize = 0
    while u < vec_len[u32](&(*f).u_if) {
        if vec_at[u32](&(*f).u_if, u) == iname && vec_at[u32](&(*f).u_sidx, u) == sidx {
            if vec_at[u32](&(*f).u_ok, u) == 1 {
                return vec_at[u32](&(*f).u_pre, u)
            }
        }
        u = u + 1
    }
    return KEIN
}

// ---------------------------------------------------- Der Codegenerator

fn if_u_count(f: *mut If) -> usize { return vec_len[u32](&(*f).u_if) }

fn if_u_ok(f: *mut If, u: usize) -> bool { return vec_at[u32](&(*f).u_ok, u) == 1 }

fn if_u_if(f: *mut If, u: usize) -> u32 { return vec_at[u32](&(*f).u_if, u) }

fn if_u_pre(f: *mut If, u: usize) -> u32 { return vec_at[u32](&(*f).u_pre, u) }

fn if_u_sidx(f: *mut If, u: usize) -> u32 { return vec_at[u32](&(*f).u_sidx, u) }
