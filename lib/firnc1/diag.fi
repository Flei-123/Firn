// lib/firnc1/diag.fi — DIAGNOSEN, GESCHRIEBEN IN FIRN.
//
// Zweiter Teil von Stufe 1 (docs/SELBSTHOSTING.md §2). Das Ausgabeformat ist
// VERBINDLICH — die Negativtests haengen daran:
//
//     error: erwartet ')' nach Argumentliste
//       --> tests/neg/bad_call.fi:7:22
//        |
//      7 |     let x = add(1, 2 ;
//        |                      ^ hier
//        = hinweis: ...
//
// Nachgewiesen wird das nicht durch Hinsehen, sondern durch `tools/lex_compare.sh`:
// fuer jede Quelle mit einem Lexfehler muss die FEHLERAUSGABE dieses Moduls
// Oktett fuer Oktett mit der von `firnc0 --emit=tokens` uebereinstimmen.
//
// AUFBAU: wie im Lexer Struktur der Felder statt Feld der Strukturen. Eine
// Diagnose besteht aus vier Zahlen (Datei, Zeile, Spalte, Laenge) und drei
// Textstuecken (Meldung, Markierungstext, Hinweis); die Zahlen liegen in
// `Vec[u32]`, die Texte hintereinander in EINEM Puffer mit Versatz und Laenge.

import rt
import vec

export { Diags, diag_new, diag_free, diag_file, diag_file_name,
         diag_error, diag_error_note, diag_count, diag_has_error,
         diag_full, diag_render, diag_source_line }

const TABBREITE: usize = 4
// Obergrenze, damit kaputte Eingaben keine Fehlerlawine erzeugen.
const HOECHSTZAHL: usize = 40
// Steht fuer "kein Hinweis" — eine echte Laenge wird das nie.
const KEIN: u32 = 4294967295

struct Diags {
    // --- Quelltextkarte
    dnames: rt.Buf,        // Dateinamen hintereinander
    dname_off: Vec[u32],
    dname_len: Vec[u32],
    dsource: Vec[u64],     // Zeiger auf den Quelltext je Datei
    dsource_len: Vec[u64],
    // --- gesammelte Diagnosen
    d_file: Vec[u32],
    d_line: Vec[u32],
    d_col: Vec[u32],
    d_length: Vec[u32],
    txt: rt.Buf,           // Meldung, Markierung und Hinweis hintereinander
    d_msg_off: Vec[u32],
    d_msg_len: Vec[u32],
    d_mark_off: Vec[u32],
    d_mark_len: Vec[u32],
    d_to_off: Vec[u32],
    d_to_len: Vec[u32],   // KEIN = kein Hinweis
}

fn diag_new() -> Diags {
    return Diags{
        dnames: rt.buf_new(),
        dname_off: vec_new[u32](), dname_len: vec_new[u32](),
        dsource: vec_new[u64](), dsource_len: vec_new[u64](),
        d_file: vec_new[u32](), d_line: vec_new[u32](),
        d_col: vec_new[u32](), d_length: vec_new[u32](),
        txt: rt.buf_new(),
        d_msg_off: vec_new[u32](), d_msg_len: vec_new[u32](),
        d_mark_off: vec_new[u32](), d_mark_len: vec_new[u32](),
        d_to_off: vec_new[u32](), d_to_len: vec_new[u32](),
    }
}

fn diag_free(d: *mut Diags) {
    rt.buf_free(&(*d).dnames)
    vec_free[u32](&(*d).dname_off)
    vec_free[u32](&(*d).dname_len)
    vec_free[u64](&(*d).dsource)
    vec_free[u64](&(*d).dsource_len)
    vec_free[u32](&(*d).d_file)
    vec_free[u32](&(*d).d_line)
    vec_free[u32](&(*d).d_col)
    vec_free[u32](&(*d).d_length)
    rt.buf_free(&(*d).txt)
    vec_free[u32](&(*d).d_msg_off)
    vec_free[u32](&(*d).d_msg_len)
    vec_free[u32](&(*d).d_mark_off)
    vec_free[u32](&(*d).d_mark_len)
    vec_free[u32](&(*d).d_to_off)
    vec_free[u32](&(*d).d_to_len)
}

// Nimmt eine Quelldatei in die Karte auf und liefert ihre Nummer.
fn diag_file(d: *mut Diags, name: u64, name_n: usize, source: u64, source_n: usize) -> u32 {
    let nr: u32 = vec_len[u32](&(*d).dname_off) as u32
    vec_push[u32](&(*d).dname_off, rt.buf_len(&(*d).dnames) as u32)
    rt.buf_push_bytes(&(*d).dnames, name, name_n)
    vec_push[u32](&(*d).dname_len, name_n as u32)
    vec_push[u64](&(*d).dsource, source)
    vec_push[u64](&(*d).dsource_len, source_n as u64)
    return nr
}

fn diag_count(d: *mut Diags) -> usize { return vec_len[u32](&(*d).d_line) }
fn diag_has_error(d: *mut Diags) -> bool { return diag_count(d) > 0 }
fn diag_full(d: *mut Diags) -> bool { return diag_count(d) >= HOECHSTZAHL }

fn diag_file_name(d: *mut Diags, nr: u32, out: *mut rt.Buf) {
    if nr as usize >= vec_len[u32](&(*d).dname_off) {
        var unb: [u8; 11] = "<unbekannt>"
        rt.buf_push_bytes(out, (&unb[0]) as u64, 11)
        return
    }
    let p: u64 = rt.buf_ptr(&(*d).dnames) + vec_at[u32](&(*d).dname_off, nr as usize) as u64
    rt.buf_push_bytes(out, p, vec_at[u32](&(*d).dname_len, nr as usize) as usize)
}

// Vergleicht zwei Textstuecke im Meldungspuffer bzw. gegen einen Zeiger.
fn txt_equal(d: *mut Diags, off: u32, len: u32, p: u64, n: usize) -> bool {
    if len as usize != n {
        return false
    }
    return rt.mem_eq(rt.buf_ptr(&(*d).txt) + off as u64, p, n)
}

// Doppelte Meldungen an derselben Stelle unterdruecken
// (Fehlerwiederherstellung erzeugt sie sonst reihenweise).
fn already_da(d: *mut Diags, file: u32, line: u32, col: u32, length: u32,
            msg: u64, msg_n: usize) -> bool {
    var i: usize = 0
    while i < diag_count(d) {
        var equal: bool = vec_at[u32](&(*d).d_file, i) == file
        equal = equal && vec_at[u32](&(*d).d_line, i) == line
        equal = equal && vec_at[u32](&(*d).d_col, i) == col
        equal = equal && vec_at[u32](&(*d).d_length, i) == length
        if equal {
            if txt_equal(d, vec_at[u32](&(*d).d_msg_off, i), vec_at[u32](&(*d).d_msg_len, i), msg, msg_n) {
                return true
            }
        }
        i = i + 1
    }
    return false
}

fn store(d: *mut Diags, file: u32, line: u32, col: u32, length: u32,
           msg: u64, msg_n: usize, to: u64, to_n: usize, has_to: bool) {
    if already_da(d, file, line, col, length, msg, msg_n) {
        return
    }
    if diag_full(d) {
        return
    }
    vec_push[u32](&(*d).d_file, file)
    vec_push[u32](&(*d).d_line, line)
    vec_push[u32](&(*d).d_col, col)
    var ln: u32 = length
    if ln == 0 { ln = 1 }
    vec_push[u32](&(*d).d_length, ln)

    vec_push[u32](&(*d).d_msg_off, rt.buf_len(&(*d).txt) as u32)
    rt.buf_push_bytes(&(*d).txt, msg, msg_n)
    vec_push[u32](&(*d).d_msg_len, msg_n as u32)

    // Markierungstext ist bei `error`/`error_note` immer "hier".
    var here: [u8; 4] = "hier"
    vec_push[u32](&(*d).d_mark_off, rt.buf_len(&(*d).txt) as u32)
    rt.buf_push_bytes(&(*d).txt, (&here[0]) as u64, 4)
    vec_push[u32](&(*d).d_mark_len, 4)

    vec_push[u32](&(*d).d_to_off, rt.buf_len(&(*d).txt) as u32)
    if has_to {
        rt.buf_push_bytes(&(*d).txt, to, to_n)
        vec_push[u32](&(*d).d_to_len, to_n as u32)
    } else {
        vec_push[u32](&(*d).d_to_len, KEIN)
    }
}

fn diag_error(d: *mut Diags, file: u32, line: u32, col: u32, length: u32,
               msg: u64, msg_n: usize) {
    store(d, file, line, col, length, msg, msg_n, 0, 0, false)
}

fn diag_error_note(d: *mut Diags, file: u32, line: u32, col: u32, length: u32,
                       msg: u64, msg_n: usize, to: u64, to_n: usize) {
    store(d, file, line, col, length, msg, msg_n, to, to_n, true)
}

// Anfang und Laenge der Quelltextzeile `zeile` (1-basiert), ohne Zeilenende
// und ohne ein abschliessendes CR. Rueckgabe gepackt: (anfang << 32) | laenge.
// Bei ungueltiger Zeile: 0.
fn diag_source_line(d: *mut Diags, file: u32, line: u32) -> u64 {
    if line == 0 || file as usize >= vec_len[u64](&(*d).dsource) {
        return 0
    }
    let q: u64 = vec_at[u64](&(*d).dsource, file as usize)
    let n: usize = vec_at[u64](&(*d).dsource_len, file as usize) as usize
    var nr: u32 = 1
    var start: usize = 0
    var i: usize = 0
    while i <= n {
        if i == n || rt.ld8(q, i) == 10 as u8 {
            if nr == line {
                var end: usize = i
                if end > start {
                    if rt.ld8(q, end - 1) == 13 as u8 {
                        end = end - 1
                    }
                }
                return ((start as u64) << 32) | ((end - start) as u64)
            }
            nr = nr + 1
            start = i + 1
        }
        i = i + 1
    }
    return 0
}

fn digits(v: u64) -> usize {
    var s: usize = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        s = s + 1
    }
    return s
}

fn repeat(b: *mut rt.Buf, c: u8, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push(b, c)
        i = i + 1
    }
}

fn txt_piece(d: *mut Diags, b: *mut rt.Buf, off: u32, len: u32) {
    rt.buf_push_bytes(b, rt.buf_ptr(&(*d).txt) + off as u64, len as usize)
}

// Eine Diagnose in der verbindlichen Form.
fn render_a(d: *mut Diags, b: *mut rt.Buf, i: usize) {
    var s_err: [u8; 7] = "error: "
    rt.buf_push_bytes(b, (&s_err[0]) as u64, 7)
    txt_piece(d, b, vec_at[u32](&(*d).d_msg_off, i), vec_at[u32](&(*d).d_msg_len, i))
    rt.buf_push(b, 10 as u8)

    let file: u32 = vec_at[u32](&(*d).d_file, i)
    let line: u32 = vec_at[u32](&(*d).d_line, i)
    let col: u32 = vec_at[u32](&(*d).d_col, i)
    let length: u32 = vec_at[u32](&(*d).d_length, i)
    let to_len: u32 = vec_at[u32](&(*d).d_to_len, i)

    // Ohne echten Ort: nur Dateiname und ggf. Hinweis.
    if line == 0 {
        var s_pf: [u8; 6] = "  --> "
        rt.buf_push_bytes(b, (&s_pf[0]) as u64, 6)
        diag_file_name(d, file, b)
        rt.buf_push(b, 10 as u8)
        if to_len != KEIN {
            var s_h1: [u8; 11] = "  hinweis: "
            rt.buf_push_bytes(b, (&s_h1[0]) as u64, 11)
            txt_piece(d, b, vec_at[u32](&(*d).d_to_off, i), to_len)
            rt.buf_push(b, 10 as u8)
        }
        return
    }

    let w: usize = digits(line as u64)
    // pad = w + 1 Leerzeichen
    repeat(b, 32 as u8, w + 1)
    var s_pf2: [u8; 4] = "--> "
    rt.buf_push_bytes(b, (&s_pf2[0]) as u64, 4)
    diag_file_name(d, file, b)
    rt.buf_push(b, 58 as u8)
    rt.buf_push_dec_u64(b, line as u64)
    rt.buf_push(b, 58 as u8)
    rt.buf_push_dec_u64(b, col as u64)
    rt.buf_push(b, 10 as u8)

    repeat(b, 32 as u8, w + 1)
    var s_bar: [u8; 2] = " |"
    rt.buf_push_bytes(b, (&s_bar[0]) as u64, 2)
    rt.buf_push(b, 10 as u8)

    // " 7 | <quelltext mit expandierten tabulatoren>"
    rt.buf_push(b, 32 as u8)
    rt.buf_push_dec_u64(b, line as u64)
    var s_bar2: [u8; 3] = " | "
    rt.buf_push_bytes(b, (&s_bar2[0]) as u64, 3)
    let zl: u64 = diag_source_line(d, file, line)
    let za: usize = (zl >> 32) as usize
    let zn: usize = (zl & 4294967295) as usize
    let q: u64 = vec_at[u64](&(*d).dsource, file as usize)
    var k: usize = 0
    while k < zn {
        let c: u8 = rt.ld8(q, za + k)
        if c == 9 as u8 {
            repeat(b, 32 as u8, TABBREITE)
        } else {
            rt.buf_push(b, c)
        }
        k = k + 1
    }
    rt.buf_push(b, 10 as u8)

    // Markierungszeile. Der Versatz zaehlt ZEICHEN, nicht Oktette — und ein
    // Tabulator zaehlt als TABBREITE. Ohne beides steht das Dach unter einem
    // Umlaut oder hinter einem Tabulator an der falschen Stelle.
    repeat(b, 32 as u8, w + 1)
    rt.buf_push_bytes(b, (&s_bar2[0]) as u64, 3)
    var view: usize = 0
    var chars: usize = 0
    var j: usize = 0
    while j < zn {
        if chars + 1 >= col as usize {
            break
        }
        let c: u8 = rt.ld8(q, za + j)
        if (c & 192 as u8) != 128 as u8 {
            if c == 9 as u8 {
                view = view + TABBREITE
            } else {
                view = view + 1
            }
            chars = chars + 1
        }
        j = j + 1
    }
    repeat(b, 32 as u8, view)
    var roof: usize = length as usize
    if roof < 1 { roof = 1 }
    repeat(b, 94 as u8, roof)
    rt.buf_push(b, 32 as u8)
    txt_piece(d, b, vec_at[u32](&(*d).d_mark_off, i), vec_at[u32](&(*d).d_mark_len, i))
    rt.buf_push(b, 10 as u8)

    if to_len != KEIN {
        repeat(b, 32 as u8, w + 1)
        var s_h2: [u8; 12] = " = hinweis: "
        rt.buf_push_bytes(b, (&s_h2[0]) as u64, 11)
        txt_piece(d, b, vec_at[u32](&(*d).d_to_off, i), to_len)
        rt.buf_push(b, 10 as u8)
    }
}

fn diag_render(d: *mut Diags, b: *mut rt.Buf) {
    var i: usize = 0
    while i < diag_count(d) {
        render_a(d, b, i)
        i = i + 1
    }
    if diag_count(d) > 1 {
        rt.buf_push_dec_u64(b, diag_count(d) as u64)
        var s_end: [u8; 16] = " Fehler gefunden"
        rt.buf_push_bytes(b, (&s_end[0]) as u64, 16)
        rt.buf_push(b, 10 as u8)
    }
}
