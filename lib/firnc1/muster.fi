// lib/firnc1/muster.fi — AUFZAEHLUNGEN (`enum`) UND MUSTERABGLEICH (`match`):
// DIE REGISTRIERUNG, IN FIRN.
//
// Zwoelfter Teil von Stufe 1: die Portierung des Datenmodells von
// `compiler/src/sema_match.rs`. Warum eine Registrierung ausserhalb des
// Baums? Zwei Gruende, beide aus Stufe 0 uebernommen:
//
//   * Die FAELLE eines `match` liegen NICHT im Syntaxbaum. Im Baum steht nur
//     ein Aufruf `__match#<nummer>` ohne Argumente; Subjekt, Muster und
//     Rumpfbloecke stehen hier. Grund bei `firnc0`: generische Vorlagen
//     koennen die Faelle sonst nicht je Auspraegung ersetzen. `firnc1`
//     uebernimmt die Trennung unveraendert — damit bleibt der Baum flach und
//     `--emit=ast-kanon` druckt genau das, was Stufe 0 druckt.
//   * Das LAYOUT einer Aufzaehlung gehoert nicht in den Baum, sondern in den
//     Typkontext: die Aufzaehlung wird als Struct mit den Feldern `__tag`
//     und `__v<tag>_<i>` eingetragen (siehe `mus_layout`).
//
// SPEICHERLAYOUT (verbindlich, SPEC §6.3):
//   offset 0           : __tag : u32   (Variantennummer, Deklarationsreihenfolge)
//   offset payload_off : Nutzdaten, payload_off = round_up(4, payload_align)
// Die Nutzdatenfelder einer Variante liegen in Deklarationsreihenfolge mit
// natuerlicher Ausrichtung hintereinander; die Bereiche VERSCHIEDENER
// Varianten ueberlagern sich (echte Vereinigung). Groesse =
// round_up(payload_off + max_variantengroesse, align), align =
// max(4, payload_align).
//
// MUSTER (SPEC §6.3): `_`, Bindung, Ganzzahl, bool, Bereich `lo..hi` /
// `lo..=hi`, `Enum::Variante(untermuster..)` — der Aufzaehlungsname darf
// fehlen (`::Variante`), Verschachtelung bis 32 Ebenen.
//
// GRENZE GEGENUEBER STUFE 0 (ehrlich benannt): Musterwerte und
// Bereichsgrenzen sind hier `i64`, bei `firnc0` `i128`. Eine Marke jenseits
// von `i64` (etwa `u64::MAX` als Muster) liesse sich hier nicht
// niederschreiben. Kein Programm im Korpus tut das; wer es tut, bekommt
// einen falschen Vergleich statt einer Meldung — das ist die Richtung, die
// diese Stufe sonst auch waehlt, und es steht deshalb hier und in
// docs/SELBSTHOSTING.md §22.

import rt
import vec
import intern
import ast
import typen

export { Mus, mus_neu, mus_frei, mus_fehler,
         MU_WILD, MU_BIND, MU_INT, MU_BOOL, MU_BEREICH, MU_VARIANT,
         mus_enum_dazu, mus_vt_anfang, mus_vt_dazu, mus_variante_dazu,
         mus_match_dazu, mus_arm_dazu,
         mus_mu_dazu, mus_kinder_anfang, mus_kind_dazu,
         mus_enum_anzahl, mus_enum_finden, mus_enum_bei_struct,
         mus_e_name, mus_e_sidx, mus_e_voff, mus_e_vlen,
         mus_e_groesse, mus_e_ausricht,
         mus_v_name, mus_v_tag, mus_v_tlen, mus_v_roff,
         mus_variante_finden, mus_rf_typ, mus_rf_off,
         mus_match_anzahl, mus_m_subj, mus_m_aoff, mus_m_alen,
         mus_a_pat, mus_a_block,
         mus_mu_art, mus_mu_a, mus_mu_b, mus_mu_lo, mus_mu_hi,
         mus_mu_soff, mus_mu_slen, mus_mu_kind, mus_unanfechtbar,
         mus_ist_matchname, mus_match_nummer, mus_ist_ctorname,
         mus_anmelden, mus_layout }

const KEIN: u32 = 4294967295

// Musterarten
const MU_WILD: u32 = 0     // `_`
const MU_BIND: u32 = 1     // `name` — bindet den ganzen Wert (mu_a = Name)
const MU_INT: u32 = 2      // Ganzzahl (mu_lo)
const MU_BOOL: u32 = 3     // true/false (mu_a = 1/0)
const MU_BEREICH: u32 = 4  // `lo..hi` / `lo..=hi` (mu_lo/mu_hi, mu_a = 1 bei `=`)
const MU_VARIANT: u32 = 5  // `Enum::Variante(unter..)` — mu_a = Aufzaehlungsname
                           // oder KEIN, mu_b = Variantenname,
                           // Untermuster ab mu_soff (mu_slen Stueck)

struct Mus {
    // Aufzaehlungen
    e_name: Vec[u32],
    e_sidx: Vec[u32],       // Structindex in typen.Typen (KEIN bis mus_anmelden)
    e_voff: Vec[u32], e_vlen: Vec[u32],
    e_groesse: Vec[u64], e_ausricht: Vec[u64],

    // Varianten aller Aufzaehlungen, hintereinander
    v_name: Vec[u32], v_tag: Vec[u32],
    v_toff: Vec[u32], v_tlen: Vec[u32],   // Nutzdaten-Typknoten (Baum)
    v_roff: Vec[u32],                     // aufgeloeste Felder ab hier (ab Layout)

    vt_typ: Vec[u32],       // Nutzdatentypen, wie geschrieben (Typknoten)
    rf_typ: Vec[u32],       // aufgeloest: Typ je Nutzdatenfeld
    rf_off: Vec[u64],       // ... und dessen Versatz

    // Musterabgleiche
    m_subj: Vec[u32], m_aoff: Vec[u32], m_alen: Vec[u32],
    a_pat: Vec[u32], a_block: Vec[u32],

    // Musterknoten (flach)
    mu_art: Vec[u32], mu_a: Vec[u32], mu_b: Vec[u32],
    mu_lo: Vec[i64], mu_hi: Vec[i64],
    mu_soff: Vec[u32], mu_slen: Vec[u32],
    mu_kinder: Vec[u32],

    kladde: rt.Buf,
    fehler: usize,
}

fn mus_neu() -> Mus {
    return Mus{
        e_name: vec_neu[u32](), e_sidx: vec_neu[u32](),
        e_voff: vec_neu[u32](), e_vlen: vec_neu[u32](),
        e_groesse: vec_neu[u64](), e_ausricht: vec_neu[u64](),
        v_name: vec_neu[u32](), v_tag: vec_neu[u32](),
        v_toff: vec_neu[u32](), v_tlen: vec_neu[u32](), v_roff: vec_neu[u32](),
        vt_typ: vec_neu[u32](),
        rf_typ: vec_neu[u32](), rf_off: vec_neu[u64](),
        m_subj: vec_neu[u32](), m_aoff: vec_neu[u32](), m_alen: vec_neu[u32](),
        a_pat: vec_neu[u32](), a_block: vec_neu[u32](),
        mu_art: vec_neu[u32](), mu_a: vec_neu[u32](), mu_b: vec_neu[u32](),
        mu_lo: vec_neu[i64](), mu_hi: vec_neu[i64](),
        mu_soff: vec_neu[u32](), mu_slen: vec_neu[u32](),
        mu_kinder: vec_neu[u32](),
        kladde: rt.buf_neu(),
        fehler: 0,
    }
}

fn mus_frei(m: *mut Mus) {
    vec_frei[u32](&(*m).e_name)
    vec_frei[u32](&(*m).e_sidx)
    vec_frei[u32](&(*m).e_voff)
    vec_frei[u32](&(*m).e_vlen)
    vec_frei[u64](&(*m).e_groesse)
    vec_frei[u64](&(*m).e_ausricht)
    vec_frei[u32](&(*m).v_name)
    vec_frei[u32](&(*m).v_tag)
    vec_frei[u32](&(*m).v_toff)
    vec_frei[u32](&(*m).v_tlen)
    vec_frei[u32](&(*m).v_roff)
    vec_frei[u32](&(*m).vt_typ)
    vec_frei[u32](&(*m).rf_typ)
    vec_frei[u64](&(*m).rf_off)
    vec_frei[u32](&(*m).m_subj)
    vec_frei[u32](&(*m).m_aoff)
    vec_frei[u32](&(*m).m_alen)
    vec_frei[u32](&(*m).a_pat)
    vec_frei[u32](&(*m).a_block)
    vec_frei[u32](&(*m).mu_art)
    vec_frei[u32](&(*m).mu_a)
    vec_frei[u32](&(*m).mu_b)
    vec_frei[i64](&(*m).mu_lo)
    vec_frei[i64](&(*m).mu_hi)
    vec_frei[u32](&(*m).mu_soff)
    vec_frei[u32](&(*m).mu_slen)
    vec_frei[u32](&(*m).mu_kinder)
    rt.buf_frei(&(*m).kladde)
}

fn mus_fehler(m: *mut Mus) -> usize { return (*m).fehler }

// --------------------------------------------------------------- Anlegen

fn mus_enum_finden(m: *mut Mus, name: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*m).e_name) {
        if vec_at[u32](&(*m).e_name, i) == name {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// Neue Aufzaehlung. Der Name bleibt UNVERAENDERT — Aufzaehlungsnamen gelten
// programmweit, nicht je Modul (SPEC §14.1). Doppelt deklariert ist ein
// Fehler; eingetragen wird trotzdem (der erste Eintrag gewinnt die Suche).
fn mus_enum_dazu(m: *mut Mus, name: u32) -> u32 {
    if mus_enum_finden(m, name) != KEIN {
        (*m).fehler = (*m).fehler + 1
    }
    let i: u32 = vec_len[u32](&(*m).e_name) as u32
    vec_push[u32](&(*m).e_name, name)
    vec_push[u32](&(*m).e_sidx, KEIN)
    vec_push[u32](&(*m).e_voff, vec_len[u32](&(*m).v_name) as u32)
    vec_push[u32](&(*m).e_vlen, 0)
    vec_push[u64](&(*m).e_groesse, 0)
    vec_push[u64](&(*m).e_ausricht, 1)
    return i
}

fn mus_vt_anfang(m: *mut Mus) -> u32 { return vec_len[u32](&(*m).vt_typ) as u32 }
fn mus_vt_dazu(m: *mut Mus, t: u32) { vec_push[u32](&(*m).vt_typ, t) }

fn mus_variante_dazu(m: *mut Mus, ei: u32, name: u32, toff: u32, tlen: u32) {
    // Doppelt deklarierte Variante ist ein Fehler.
    let voff: u32 = vec_at[u32](&(*m).e_voff, ei as usize)
    let vlen: u32 = vec_at[u32](&(*m).e_vlen, ei as usize)
    var k: u32 = 0
    while k < vlen {
        if vec_at[u32](&(*m).v_name, (voff + k) as usize) == name {
            (*m).fehler = (*m).fehler + 1
            break
        }
        k = k + 1
    }
    vec_push[u32](&(*m).v_name, name)
    vec_push[u32](&(*m).v_tag, vlen)
    vec_push[u32](&(*m).v_toff, toff)
    vec_push[u32](&(*m).v_tlen, tlen)
    vec_push[u32](&(*m).v_roff, 0)
    vec_setzen[u32](&(*m).e_vlen, ei as usize, vlen + 1)
}

// Nummer einer Variante in dieser Aufzaehlung (GLOBALER Variantenindex),
// oder KEIN.
fn mus_variante_finden(m: *mut Mus, ei: u32, name: u32) -> u32 {
    let voff: u32 = vec_at[u32](&(*m).e_voff, ei as usize)
    let vlen: u32 = vec_at[u32](&(*m).e_vlen, ei as usize)
    var k: u32 = 0
    while k < vlen {
        if vec_at[u32](&(*m).v_name, (voff + k) as usize) == name {
            return voff + k
        }
        k = k + 1
    }
    return KEIN
}

// ------------------------------------------------------------- match-Faelle

fn mus_match_dazu(m: *mut Mus, subj: u32) -> u32 {
    let i: u32 = vec_len[u32](&(*m).m_subj) as u32
    vec_push[u32](&(*m).m_subj, subj)
    vec_push[u32](&(*m).m_aoff, vec_len[u32](&(*m).a_pat) as u32)
    vec_push[u32](&(*m).m_alen, 0)
    return i
}

fn mus_arm_dazu(m: *mut Mus, mi: u32, pat: u32, block: u32) {
    vec_push[u32](&(*m).a_pat, pat)
    vec_push[u32](&(*m).a_block, block)
    let n: u32 = vec_at[u32](&(*m).m_alen, mi as usize)
    vec_setzen[u32](&(*m).m_alen, mi as usize, n + 1)
}

// Musterknoten anlegen. Untermuster-Listen muessen erst gesammelt und dann am
// Stueck abgelegt werden (mus_kinder_anfang / mus_kind_dazu) — dieselbe
// Lehre wie im Parser: sofortiges Anhaengen verschachtelt die Listen.
fn mus_mu_dazu(m: *mut Mus, art: u32, a: u32, b: u32, lo: i64, hi: i64,
               soff: u32, slen: u32) -> u32 {
    let i: u32 = vec_len[u32](&(*m).mu_art) as u32
    vec_push[u32](&(*m).mu_art, art)
    vec_push[u32](&(*m).mu_a, a)
    vec_push[u32](&(*m).mu_b, b)
    vec_push[i64](&(*m).mu_lo, lo)
    vec_push[i64](&(*m).mu_hi, hi)
    vec_push[u32](&(*m).mu_soff, soff)
    vec_push[u32](&(*m).mu_slen, slen)
    return i
}

fn mus_kinder_anfang(m: *mut Mus) -> u32 { return vec_len[u32](&(*m).mu_kinder) as u32 }
fn mus_kind_dazu(m: *mut Mus, k: u32) { vec_push[u32](&(*m).mu_kinder, k) }

// ----------------------------------------------------------------- Lesen

fn mus_enum_anzahl(m: *mut Mus) -> usize { return vec_len[u32](&(*m).e_name) }
fn mus_e_name(m: *mut Mus, ei: u32) -> u32 { return vec_at[u32](&(*m).e_name, ei as usize) }
fn mus_e_sidx(m: *mut Mus, ei: u32) -> u32 { return vec_at[u32](&(*m).e_sidx, ei as usize) }
fn mus_e_voff(m: *mut Mus, ei: u32) -> u32 { return vec_at[u32](&(*m).e_voff, ei as usize) }
fn mus_e_vlen(m: *mut Mus, ei: u32) -> u32 { return vec_at[u32](&(*m).e_vlen, ei as usize) }
fn mus_e_groesse(m: *mut Mus, ei: u32) -> u64 { return vec_at[u64](&(*m).e_groesse, ei as usize) }
fn mus_e_ausricht(m: *mut Mus, ei: u32) -> u64 { return vec_at[u64](&(*m).e_ausricht, ei as usize) }

fn mus_enum_bei_struct(m: *mut Mus, sidx: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*m).e_sidx) {
        if vec_at[u32](&(*m).e_sidx, i) == sidx {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

fn mus_v_name(m: *mut Mus, vi: u32) -> u32 { return vec_at[u32](&(*m).v_name, vi as usize) }
fn mus_v_tag(m: *mut Mus, vi: u32) -> u32 { return vec_at[u32](&(*m).v_tag, vi as usize) }
fn mus_v_tlen(m: *mut Mus, vi: u32) -> u32 { return vec_at[u32](&(*m).v_tlen, vi as usize) }
fn mus_v_roff(m: *mut Mus, vi: u32) -> u32 { return vec_at[u32](&(*m).v_roff, vi as usize) }
fn mus_rf_typ(m: *mut Mus, ri: u32) -> u32 { return vec_at[u32](&(*m).rf_typ, ri as usize) }
fn mus_rf_off(m: *mut Mus, ri: u32) -> u64 { return vec_at[u64](&(*m).rf_off, ri as usize) }

fn mus_match_anzahl(m: *mut Mus) -> usize { return vec_len[u32](&(*m).m_subj) }
fn mus_m_subj(m: *mut Mus, mi: u32) -> u32 { return vec_at[u32](&(*m).m_subj, mi as usize) }
fn mus_m_aoff(m: *mut Mus, mi: u32) -> u32 { return vec_at[u32](&(*m).m_aoff, mi as usize) }
fn mus_m_alen(m: *mut Mus, mi: u32) -> u32 { return vec_at[u32](&(*m).m_alen, mi as usize) }
fn mus_a_pat(m: *mut Mus, ai: u32) -> u32 { return vec_at[u32](&(*m).a_pat, ai as usize) }
fn mus_a_block(m: *mut Mus, ai: u32) -> u32 { return vec_at[u32](&(*m).a_block, ai as usize) }

fn mus_mu_art(m: *mut Mus, i: u32) -> u32 { return vec_at[u32](&(*m).mu_art, i as usize) }
fn mus_mu_a(m: *mut Mus, i: u32) -> u32 { return vec_at[u32](&(*m).mu_a, i as usize) }
fn mus_mu_b(m: *mut Mus, i: u32) -> u32 { return vec_at[u32](&(*m).mu_b, i as usize) }
fn mus_mu_lo(m: *mut Mus, i: u32) -> i64 { return vec_at[i64](&(*m).mu_lo, i as usize) }
fn mus_mu_hi(m: *mut Mus, i: u32) -> i64 { return vec_at[i64](&(*m).mu_hi, i as usize) }
fn mus_mu_soff(m: *mut Mus, i: u32) -> u32 { return vec_at[u32](&(*m).mu_soff, i as usize) }
fn mus_mu_slen(m: *mut Mus, i: u32) -> u32 { return vec_at[u32](&(*m).mu_slen, i as usize) }
fn mus_mu_kind(m: *mut Mus, i: u32) -> u32 { return vec_at[u32](&(*m).mu_kinder, i as usize) }

// Trifft das Muster IMMER zu?
fn mus_unanfechtbar(m: *mut Mus, i: u32) -> bool {
    let a: u32 = mus_mu_art(m, i)
    return a == MU_WILD || a == MU_BIND
}

// ------------------------------------------------------ Namen der Aufrufe

// Beginnt der Name mit `__match#`? Das `#` kann nie in einem Bezeichner aus
// dem Quelltext stehen (sema_match.rs, MATCH_PREFIX).
fn mus_ist_matchname(it: *mut intern.Interner, name: u32) -> bool {
    var pfx: [u8; 8] = "__match#"
    let p: u64 = intern.intern_zeiger(it, name)
    let n: usize = intern.intern_laenge(it, name)
    if n < 8 {
        return false
    }
    return rt.mem_eq(p, (&pfx[0]) as u64, 8)
}

// Die Nummer hinter `__match#`.
fn mus_match_nummer(it: *mut intern.Interner, name: u32) -> u32 {
    let p: u64 = intern.intern_zeiger(it, name)
    let n: usize = intern.intern_laenge(it, name)
    var v: u32 = 0
    var i: usize = 8
    while i < n {
        v = v * 10 + (rt.ld8(p, i) - 48 as u8) as u32
        i = i + 1
    }
    return v
}

// Enthaelt der Name `::`? Dann ist es ein Aufzaehlungskonstruktor
// (`Enum::Variante`). Gewoehnliche Funktionsnamen enthalten keinen
// Doppelpunkt — den lext der Lexer nie als Teil eines Bezeichners.
fn mus_ist_ctorname(it: *mut intern.Interner, name: u32) -> bool {
    let p: u64 = intern.intern_zeiger(it, name)
    let n: usize = intern.intern_laenge(it, name)
    var i: usize = 0
    while i + 1 < n {
        if rt.ld8(p, i) == 58 as u8 {
            if rt.ld8(p, i + 1) == 58 as u8 {
                return true
            }
        }
        i = i + 1
    }
    return false
}

// Teilt `Enum::Variante` an der ERSTEN Doppelpunktsstelle. `en`/`vn` sind
// Nummern im Interner; der Puffer `k` darf sich danach nicht mehr bewegen.
fn ctor_teilen(m: *mut Mus, it: *mut intern.Interner, name: u32,
               en: *mut u32, vn: *mut u32) {
    let p: u64 = intern.intern_zeiger(it, name)
    let n: usize = intern.intern_laenge(it, name)
    var i: usize = 0
    while i + 1 < n {
        if rt.ld8(p, i) == 58 as u8 && rt.ld8(p, i + 1) == 58 as u8 {
            *en = intern.intern_nummer(it, p, i) as u32
            *vn = intern.intern_nummer(it, p + (i + 2) as u64, n - i - 2) as u32
            return
        }
        i = i + 1
    }
    *en = KEIN
    *vn = KEIN
}

// ------------------------------------------------- Anmeldung im Typkontext

// Meldet die NAMEN aller Aufzaehlungen an, damit Structs und
// Funktionssignaturen sie benennen koennen. Muss VOR `typen.typen_aufloesen`
// laufen — die Aufzaehlungen stehen dann vor den Structs des Baums im
// Typkontext, genau wie in Stufe 0 (`declare_enums` vor `collect_structs`).
fn mus_anmelden(m: *mut Mus, t: *mut typen.Typen) {
    var i: usize = 0
    while i < mus_enum_anzahl(m) {
        let name: u32 = mus_e_name(m, i as u32)
        if typen.struct_index(t, name) >= 0 {
            (*m).fehler = (*m).fehler + 1
        }
        let idx: u32 = typen.typen_struct_vormerken(t, name)
        vec_setzen[u32](&(*m).e_sidx, i, idx)
        i = i + 1
    }
}

// Name eines Typs, sofern er DEM WERT NACH enthalten ist (Zeiger nicht).
fn wert_name(b: *mut ast.Baum, te: u32) -> u32 {
    let a: u32 = ast.t_art(b, te)
    if a == ast.T_NAME {
        return ast.t_a(b, te)
    }
    if a == ast.T_ARR {
        return wert_name(b, ast.t_a(b, te))
    }
    return KEIN
}

// Enthaelt der aufgeloeste Typ eine Aufzaehlung DEM WERT NACH?
fn enthaelt_enum(m: *mut Mus, t: *mut typen.Typen, ty: u32) -> bool {
    let k: u32 = typen.ty_art(t, ty)
    if k == typen.K_STRUCT {
        return mus_enum_bei_struct(m, typen.ty_a(t, ty)) != KEIN
    }
    if k == typen.K_ARR {
        return enthaelt_enum(m, t, typen.ty_a(t, ty))
    }
    return false
}

fn toposort(mu: *mut Mus, i: u32, d_off: *mut Vec[u32], d_len: *mut Vec[u32],
            d_ziel: *mut Vec[u32], state: *mut Vec[u32], order: *mut Vec[u32],
            bad: *mut Vec[u32]) {
    let st: u32 = vec_at[u32](state, i as usize)
    if st == 2 {
        return
    }
    if st == 1 {
        // Zyklus: diese Aufzaehlung enthaelt sich selbst.
        var k: usize = 0
        var da: bool = false
        while k < vec_len[u32](bad) {
            if vec_at[u32](bad, k) == i {
                da = true
            }
            k = k + 1
        }
        if !da {
            vec_push[u32](bad, i)
        }
        return
    }
    vec_setzen[u32](state, i as usize, 1)
    let off: u32 = vec_at[u32](d_off, i as usize)
    let len: u32 = vec_at[u32](d_len, i as usize)
    var k: u32 = 0
    while k < len {
        let j: u32 = vec_at[u32](d_ziel, (off + k) as usize)
        toposort(mu, j, d_off, d_len, d_ziel, state, order, bad)
        // Wer von einem Zyklus abhaengt, ist selbst kaputt.
        var x: usize = 0
        var jbad: bool = false
        while x < vec_len[u32](bad) {
            if vec_at[u32](bad, x) == j {
                jbad = true
            }
            x = x + 1
        }
        if jbad {
            var ibad: bool = false
            x = 0
            while x < vec_len[u32](bad) {
                if vec_at[u32](bad, x) == i {
                    ibad = true
                }
                x = x + 1
            }
            if !ibad {
                vec_push[u32](bad, i)
            }
        }
        k = k + 1
    }
    vec_setzen[u32](state, i as usize, 2)
    vec_push[u32](order, i)
}

fn in_bad(bad: *mut Vec[u32], i: u32) -> bool {
    var k: usize = 0
    while k < vec_len[u32](bad) {
        if vec_at[u32](bad, k) == i {
            return true
        }
        k = k + 1
    }
    return false
}

// Interner Name `__v<vi>_<fi>` bzw. `__tag` fuer die Structfelder.
fn feldname(m: *mut Mus, it: *mut intern.Interner, vi: u32, fi: u32) -> u32 {
    rt.buf_leeren(&(*m).kladde)
    var v: [u8; 3] = "__v"
    rt.buf_push_bytes(&(*m).kladde, (&v[0]) as u64, 3)
    rt.buf_push_dez_u64(&(*m).kladde, vi as u64)
    rt.buf_push(&(*m).kladde, 95 as u8)
    rt.buf_push_dez_u64(&(*m).kladde, fi as u64)
    return intern.intern_nummer(it, rt.buf_ptr(&(*m).kladde),
                                rt.buf_len(&(*m).kladde)) as u32
}

fn tag_name(m: *mut Mus, it: *mut intern.Interner) -> u32 {
    var v: [u8; 5] = "__tag"
    return intern.intern_nummer(it, (&v[0]) as u64, 5) as u32
}

// Berechnet das Layout jeder Aufzaehlung und traegt es als Struct-Layout in
// den Typkontext ein. Muss NACH `typen.typen_aufloesen` laufen (die Structs
// des Baums stehen dann; eine Aufzaehlung darf ein Struct dem Wert nach
// enthalten, umgekehrt nicht). Liefert die Zahl der neuen Fehler.
fn mus_layout(m: *mut Mus, t: *mut typen.Typen, b: *mut ast.Baum,
              it: *mut intern.Interner) -> u32 {
    let vorher: usize = (*m).fehler
    let n: usize = mus_enum_anzahl(m)
    if n == 0 {
        return 0
    }
    // 1. Ein Structfeld mit Aufzaehlungstyp DEM WERT NACH ist ein Fehler
    //    (die Structlayouts stehen zu diesem Zeitpunkt bereits fest).
    var si: usize = 0
    while si < ast.struktur_anzahl(b) {
        var k: u32 = 0
        while k < ast.struktur_flen(b, si) {
            let fi: u32 = ast.struktur_foff(b, si) + k
            let ty: u32 = typen.aufloesen(t, b, it, ast.feld_typ(b, fi))
            if enthaelt_enum(m, t, ty) {
                (*m).fehler = (*m).fehler + 1
            }
            k = k + 1
        }
        si = si + 1
    }
    // 2. Abhaengigkeiten zwischen Aufzaehlungen (eine Aufzaehlung darf eine
    //    andere dem Wert nach enthalten). Zyklen sind ein Fehler.
    var d_off: Vec[u32] = vec_neu[u32]()
    var d_len: Vec[u32] = vec_neu[u32]()
    var d_ziel: Vec[u32] = vec_neu[u32]()
    var i: usize = 0
    while i < n {
        vec_push[u32](&d_off, vec_len[u32](&d_ziel) as u32)
        vec_push[u32](&d_len, 0)
        let ei: u32 = i as u32
        let voff: u32 = mus_e_voff(m, ei)
        let vlen: u32 = mus_e_vlen(m, ei)
        var v: u32 = 0
        while v < vlen {
            let toff: u32 = vec_at[u32](&(*m).v_toff, (voff + v) as usize)
            let tlen: u32 = vec_at[u32](&(*m).v_tlen, (voff + v) as usize)
            var f: u32 = 0
            while f < tlen {
                let wn: u32 = wert_name(b, vec_at[u32](&(*m).vt_typ, (toff + f) as usize))
                if wn != KEIN {
                    let dep: u32 = mus_enum_finden(m, wn)
                    if dep != KEIN {
                        vec_push[u32](&d_ziel, dep)
                        vec_setzen[u32](&d_len, i, vec_at[u32](&d_len, i) + 1)
                    }
                }
                f = f + 1
            }
            v = v + 1
        }
        i = i + 1
    }
    var state: Vec[u32] = vec_neu[u32]()
    var order: Vec[u32] = vec_neu[u32]()
    var bad: Vec[u32] = vec_neu[u32]()
    i = 0
    while i < n {
        vec_push[u32](&state, 0)
        i = i + 1
    }
    i = 0
    while i < n {
        toposort(m, i as u32, &d_off, &d_len, &d_ziel, &state, &order, &bad)
        i = i + 1
    }
    vec_frei[u32](&d_off)
    vec_frei[u32](&d_len)
    vec_frei[u32](&d_ziel)
    vec_frei[u32](&state)
    i = 0
    while i < vec_len[u32](&bad) {
        // Aufzaehlung enthaelt sich selbst (direkt oder indirekt).
        (*m).fehler = (*m).fehler + 1
        i = i + 1
    }

    // 3. Layout in Abhaengigkeitsreihenfolge.
    let t_u32: u32 = typen.neuer_typ(t, typen.K_U32, 0, 0)
    var fnamen: Vec[u32] = vec_neu[u32]()
    var ftypen: Vec[u32] = vec_neu[u32]()
    var fvers: Vec[u64] = vec_neu[u64]()
    var oi: usize = 0
    while oi < vec_len[u32](&order) {
        let ei: u32 = vec_at[u32](&order, oi)
        oi = oi + 1
        if in_bad(&bad, ei) {
            continue
        }
        let sidx: u32 = mus_e_sidx(m, ei)
        if sidx == KEIN {
            continue
        }
        // 3a. Nutzdatentypen aufloesen, groesste Ausrichtung bestimmen.
        var payload_ausricht: u64 = 1
        let voff: u32 = mus_e_voff(m, ei)
        let vlen: u32 = mus_e_vlen(m, ei)
        var v: u32 = 0
        while v < vlen {
            let vi: u32 = voff + v
            let toff: u32 = vec_at[u32](&(*m).v_toff, vi as usize)
            let tlen: u32 = vec_at[u32](&(*m).v_tlen, vi as usize)
            // aufgeloeste Felder dieser Variante: ab hier lueckenlos
            vec_setzen[u32](&(*m).v_roff, vi as usize,
                            vec_len[u32](&(*m).rf_typ) as u32)
            var f: u32 = 0
            while f < tlen {
                let ty: u32 = typen.aufloesen(t, b, it,
                    vec_at[u32](&(*m).vt_typ, (toff + f) as usize))
                if typen.ty_art(t, ty) == typen.K_VOID {
                    (*m).fehler = (*m).fehler + 1
                }
                var a: u64 = typen.ausrichtung_von(t, ty)
                if a < 1 { a = 1 }
                if a > payload_ausricht {
                    payload_ausricht = a
                }
                vec_push[u32](&(*m).rf_typ, ty)
                vec_push[u64](&(*m).rf_off, 0)
                f = f + 1
            }
            v = v + 1
        }
        let payload_off: u64 = typen.aufrunden(4, payload_ausricht)
        // 3b. Versaetze je Variante — die Bereiche verschiedener Varianten
        //     ueberlagern sich (echte Vereinigung).
        vec_leeren[u32](&fnamen)
        vec_leeren[u32](&ftypen)
        vec_leeren[u64](&fvers)
        vec_push[u32](&fnamen, tag_name(m, it))
        vec_push[u32](&ftypen, t_u32)
        vec_push[u64](&fvers, 0)
        var max_ende: u64 = payload_off
        v = 0
        while v < vlen {
            let vi: u32 = voff + v
            let tlen: u32 = vec_at[u32](&(*m).v_tlen, vi as usize)
            let roff: u32 = vec_at[u32](&(*m).v_roff, vi as usize)
            var off: u64 = payload_off
            var f: u32 = 0
            while f < tlen {
                let ty: u32 = vec_at[u32](&(*m).rf_typ, (roff + f) as usize)
                var a: u64 = typen.ausrichtung_von(t, ty)
                if a < 1 { a = 1 }
                let gr: u64 = typen.groesse_von(t, ty)
                off = typen.aufrunden(off, a)
                vec_setzen[u64](&(*m).rf_off, (roff + f) as usize, off)
                vec_push[u32](&fnamen, feldname(m, it, v, f))
                vec_push[u32](&ftypen, ty)
                vec_push[u64](&fvers, off)
                off = off + gr
                f = f + 1
            }
            if off > max_ende {
                max_ende = off
            }
            v = v + 1
        }
        var ausricht: u64 = payload_ausricht
        if ausricht < 4 { ausricht = 4 }
        var groesse: u64 = typen.aufrunden(max_ende, ausricht)
        if groesse < ausricht { groesse = ausricht }
        vec_setzen[u64](&(*m).e_groesse, ei as usize, groesse)
        vec_setzen[u64](&(*m).e_ausricht, ei as usize, ausricht)
        typen.typen_struct_festlegen(t, sidx, groesse, ausricht,
                                     &fnamen, &ftypen, &fvers)
    }
    vec_frei[u32](&fnamen)
    vec_frei[u32](&ftypen)
    vec_frei[u64](&fvers)
    vec_frei[u32](&order)
    vec_frei[u32](&bad)
    return ((*m).fehler - vorher) as u32
}
