// SPDX-License-Identifier: MPL-2.0

import rt
import lexer

export { tok_kind_text, tok_text }

const KIND_EOF: u32 = 68

fn push_word(out: *mut rt.Buf, index: usize) {
    var words: [u8; 321] = "fn let var if else while return struct const profile as mut true false syscall extern break continue defer errdefer comptime for in import export enum match error try catch ( ) { } [ ] , : ; . .. -> = + - * / % & | ^ << >> && || ! ? # == != < <= > >= ? ? ~ += -= *= /= %= &= |= ^= <<= >>= ++ -- ? +% -% *% +| -| *| static"
    var at: usize = 0
    var w: usize = 0
    var i: usize = 0
    while i <= 321 {
        if i == 321 || words[i] == 32 as u8 {
            if w == index {
                rt.buf_push_bytes(out, (&words[0]) as u64 + at as u64, i - at)
                return
            }
            w = w + 1
            at = i + 1
        }
        i = i + 1
    }
}

fn tok_kind_text(kind: u32, out: *mut rt.Buf) {
    if kind == KIND_EOF {
        var eof: [u8; 11] = "end of file"
        rt.buf_push_bytes(out, (&eof[0]) as u64, 11)
        return
    }
    if kind < 4 || kind > 90 {
        var unk: [u8; 5] = "token"
        rt.buf_push_bytes(out, (&unk[0]) as u64, 5)
        return
    }
    push_word(out, (kind - 4) as usize)
}

fn tok_text(l: *mut lexer.Lexer, i: usize, out: *mut rt.Buf) {
    if i >= lexer.lex_count(l) {
        tok_kind_text(KIND_EOF, out)
        return
    }
    let kind: u32 = lexer.lex_kind(l, i)
    if kind == 0 {
        rt.buf_push_dec_u64(out, lexer.lex_number(l, i))
        return
    }
    if kind == 1 {
        let nr: u32 = lexer.lex_nr(l, i)
        rt.buf_push_bytes(out, lexer.lex_name_ptr(l, nr), lexer.lex_name_length(l, nr))
        return
    }
    if kind == 3 {
        var s2: [u8; 10] = " elements)"
        rt.buf_push(out, 34 as u8)
        rt.buf_push(out, 226 as u8)
        rt.buf_push(out, 128 as u8)
        rt.buf_push(out, 166 as u8)
        rt.buf_push(out, 34 as u8)
        rt.buf_push(out, 32 as u8)
        rt.buf_push(out, 40 as u8)
        rt.buf_push_dec_u64(out, lexer.lex_lit_len(l, lexer.lex_nr(l, i) as usize) as u64)
        rt.buf_push_bytes(out, (&s2[0]) as u64, 10)
        return
    }
    tok_kind_text(kind, out)
}
