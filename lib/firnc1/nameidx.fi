import vec

export { nameidx_put, nameidx_get, nameidx_reset, NAMEIDX_NONE }

const NAMEIDX_NONE: u32 = 4294967295
const NAMEIDX_LIMIT: u32 = 67108864

fn nameidx_put(v: *mut Vec[u32], name: u32, value: u32) {
    if name >= NAMEIDX_LIMIT {
        return
    }
    let need: usize = name as usize + 1
    if vec_len[u32](v) < need {
        vec_reserve[u32](v, need)
        while vec_len[u32](v) < need {
            vec_push[u32](v, 0)
        }
    }
    if vec_at[u32](v, name as usize) == 0 {
        vec_set[u32](v, name as usize, value + 1)
    }
}

fn nameidx_get(v: *mut Vec[u32], name: u32) -> u32 {
    if name as usize >= vec_len[u32](v) {
        return NAMEIDX_NONE
    }
    let k: u32 = vec_at[u32](v, name as usize)
    if k == 0 {
        return NAMEIDX_NONE
    }
    return k - 1
}

fn nameidx_reset(v: *mut Vec[u32], name: u32) {
    if name as usize >= vec_len[u32](v) {
        return
    }
    vec_set[u32](v, name as usize, 0)
}
