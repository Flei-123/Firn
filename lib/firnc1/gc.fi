// lib/firnc1/gc.fi — `gc class`, `Gc[T]`, `GcWeak[T]`, schwache Verweise und
// die GC-Abfragen fuer `#[no_gc]`: DIE REGISTRIERUNG, IN FIRN (Runde 34).
//
// Vierzehnter Teil von Stufe 1: die Portierung des Datenmodells von
// `compiler/src/gc.rs`. Derselbe Aufbau wie `muster.fi` (Runde 32) und
// `fehler.fi` (Runde 33): die Registrierung liegt AUSSERHALB des Baums, weil
// sie ueber alle Dateien einer Uebersetzung hinweg dieselbe sein muss —
// Klassennamen gelten programmweit (in Stufe 0 schreibt der Renamer die
// Namen in der Registrierung nicht um; die Eintraege entstehen beim Parsen
// und bleiben, wie sie sind).
//
// DARSTELLUNG (verbindlich, docs/GC.md, unveraendert aus Stufe 0):
//   gc class C { … }   -> Struct "gc C" im Typkontext (Praefixlayout der Basis)
//   Gc[C]              -> *mut <Struct "gc C">
//   GcWeak[C]          -> Struct "GcWeak[C]" { __p: u64, __s: u64 }
//   gc C{ … }          -> AllocError!Gc[C]
//
// Der Parser traegt die Klasse hier ein; die Typnamen stehen als Platzhalter
// `__gc#p:C` / `__gc#w:C` im Baum (das `#` kann nie in einem Bezeichner des
// Quelltextes stehen) und werden in `typen.aufloesen` ueber `gc_typ_haken`
// aufgeloest — derselbe Uebergabepunkt wie `hook_resolve_ty` in Stufe 0 und
// derselbe Importzyklus wie bei den Fehlerunionen (`typen.fi` <-> `gc.fi`).
//
// Die Typkennung ist die Deklarationsnummer ab 1; die Typtabelle fuer den
// Sammler schreibt `codegen.fi` aus diesen Angaben (typtabelle_asm in
// Stufe 0). Die Sammler-Laufzeit selbst ist lesbares Firn (`lib/gc/gc.fi`)
// und wird vom Treiber eingezogen, sobald irgendwo `gc class` steht —
// hier liegen nur ihre NAMEN (fuer `#[no_gc]`, Regel 1).

import rt
import vec
import intern
import lexer
import ast
import typen

export { Gc, gc_neu, gc_frei, gc_fehler, gc_anzahl, gc_hat_klassen,
         gc_klasse_dazu, gc_basis_setzen, gc_feld_dazu,
         gc_laufzeit_setzen, gc_laufzeit,
         gc_index_von, gc_ist_klasse, gc_name, gc_sidx, gc_widx,
         gc_tid, gc_size, gc_basis_tid, gc_union, gc_union_setzen,
         gc_klasse_von_struct, gc_klasse_von_weak, gc_ist_nachfahre,
         gc_anmelden, gc_layout,
         gc_typ_haken, gc_ist_gc_ptr, gc_ist_gc_weak, gc_ist_gc_zeiger,
         gc_ist_aufwaerts, gc_ist_verwandt, gc_feld_basis,
         gc_hat_neu_praefix, gc_klasse_aus_neu,
         gc_hat_as_praefix, gc_klasse_aus_as,
         gc_ist_alloc_aufruf, gc_ist_weak_name, gc_ist_stark_name,
         gc_zustandsname, gc_probe_typ, gc_quelle_scan,
         gc_stark_anzahl, gc_stark_off, gc_schwach_anzahl, gc_schwach_off }

const KEIN: u32 = 4294967295

struct Gc {
    k_name: Vec[u32],      // Klassenname (Nummer im Interner)
    k_basis: Vec[u32],     // Name der Basis, 0 = keine
    k_foff: Vec[u32], k_flen: Vec[u32],   // eigene Felder: Bereich in f_*
    f_name: Vec[u32], f_te: Vec[u32],     // Feldname, Typknoten im Baum
    k_sidx: Vec[u32],      // Struct "gc C" im Typkontext (KEIN bis gc_anmelden)
    k_widx: Vec[u32],      // Struct "GcWeak[C]"
    k_size: Vec[u64],      // nach dem Layout: Groesse in Bytes
    k_btid: Vec[u64],      // Typkennung der Basis, 0 = keine
    k_union: Vec[u32],     // Fehlerunion AllocError!Gc[C]: Index + 1 (0 = keine)
    k_fertig: Vec[u32],    // 1 = Layout steht
    k_soff: Vec[u32], k_slen: Vec[u32],   // starke Feldoffsets: Bereich in s_offs
    k_woff: Vec[u32], k_wlen: Vec[u32],   // schwache: Bereich in w_offs
    s_offs: Vec[u64], w_offs: Vec[u64],
    kladde: rt.Buf,
    fehler: usize,
    // Runde 49: 1 = die Laufzeit (lib/gc/gc.fi) ist Teil dieses Programms,
    // auch wenn es KEIN `gc class` gibt. Dann muss der Zustandsblock
    // trotzdem im Assembler stehen — die Fadentafel und die Sperren liegen
    // darin (codegen.rs: `hat_klassen() || laufzeit_aktiv()`).
    laufzeit: usize,
}

fn gc_neu() -> Gc {
    return Gc{
        k_name: vec_neu[u32](), k_basis: vec_neu[u32](),
        k_foff: vec_neu[u32](), k_flen: vec_neu[u32](),
        f_name: vec_neu[u32](), f_te: vec_neu[u32](),
        k_sidx: vec_neu[u32](), k_widx: vec_neu[u32](),
        k_size: vec_neu[u64](), k_btid: vec_neu[u64](),
        k_union: vec_neu[u32](), k_fertig: vec_neu[u32](),
        k_soff: vec_neu[u32](), k_slen: vec_neu[u32](),
        k_woff: vec_neu[u32](), k_wlen: vec_neu[u32](),
        s_offs: vec_neu[u64](), w_offs: vec_neu[u64](),
        kladde: rt.buf_neu(),
        fehler: 0,
        laufzeit: 0,
    }
}

fn gc_frei(g: *mut Gc) {
    vec_frei[u32](&(*g).k_name)
    vec_frei[u32](&(*g).k_basis)
    vec_frei[u32](&(*g).k_foff)
    vec_frei[u32](&(*g).k_flen)
    vec_frei[u32](&(*g).f_name)
    vec_frei[u32](&(*g).f_te)
    vec_frei[u32](&(*g).k_sidx)
    vec_frei[u32](&(*g).k_widx)
    vec_frei[u64](&(*g).k_size)
    vec_frei[u64](&(*g).k_btid)
    vec_frei[u32](&(*g).k_union)
    vec_frei[u32](&(*g).k_fertig)
    vec_frei[u32](&(*g).k_soff)
    vec_frei[u32](&(*g).k_slen)
    vec_frei[u32](&(*g).k_woff)
    vec_frei[u32](&(*g).k_wlen)
    vec_frei[u64](&(*g).s_offs)
    vec_frei[u64](&(*g).w_offs)
    rt.buf_frei(&(*g).kladde)
}

fn gc_fehler(g: *mut Gc) -> usize { return (*g).fehler }
fn gc_anzahl(g: *mut Gc) -> usize { return vec_len[u32](&(*g).k_name) }
fn gc_hat_klassen(g: *mut Gc) -> bool { return gc_anzahl(g) > 0 }

fn gc_laufzeit_setzen(g: *mut Gc, an: usize) { (*g).laufzeit = an }

fn gc_laufzeit(g: *mut Gc) -> usize { return (*g).laufzeit }

// --------------------------------------------------------------- Namen

// Hat der eingetragene Name `nr` an Stelle 0..n die Bytes `lit`?
fn name_gleich(it: *mut intern.Interner, nr: u32, lit: u64, n: usize) -> bool {
    if intern.intern_laenge(it, nr) != n {
        return false
    }
    return rt.mem_eq(intern.intern_zeiger(it, nr), lit, n)
}

// Beginnt der Name `nr` mit den Bytes `lit` (Laenge n)?
fn name_praefix(it: *mut intern.Interner, nr: u32, lit: u64, n: usize) -> bool {
    if intern.intern_laenge(it, nr) < n {
        return false
    }
    return rt.mem_eq(intern.intern_zeiger(it, nr), lit, n)
}

// ------------------------------------------------------------- Bestand

fn gc_index_von(g: *mut Gc, name: u32) -> u32 {
    var i: usize = 0
    while i < gc_anzahl(g) {
        if vec_at[u32](&(*g).k_name, i) == name {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

fn gc_ist_klasse(g: *mut Gc, name: u32) -> bool { return gc_index_von(g, name) != KEIN }

fn gc_name(g: *mut Gc, ki: u32) -> u32 { return vec_at[u32](&(*g).k_name, ki as usize) }
fn gc_sidx(g: *mut Gc, ki: u32) -> u32 { return vec_at[u32](&(*g).k_sidx, ki as usize) }
fn gc_widx(g: *mut Gc, ki: u32) -> u32 { return vec_at[u32](&(*g).k_widx, ki as usize) }
// Typkennung: ab 1 in Deklarationsreihenfolge (wie Stufe 0).
fn gc_tid(g: *mut Gc, ki: u32) -> u64 { return ki as u64 + 1 }
fn gc_size(g: *mut Gc, ki: u32) -> u64 { return vec_at[u64](&(*g).k_size, ki as usize) }
fn gc_basis_tid(g: *mut Gc, ki: u32) -> u64 { return vec_at[u64](&(*g).k_btid, ki as usize) }
// Fehlerunion AllocError!Gc[C]: Index in der Fehler-Registrierung + 1.
fn gc_union(g: *mut Gc, ki: u32) -> u32 { return vec_at[u32](&(*g).k_union, ki as usize) }
fn gc_union_setzen(g: *mut Gc, ki: u32, u: u32) {
    vec_setzen[u32](&(*g).k_union, ki as usize, u + 1)
}
fn gc_stark_anzahl(g: *mut Gc, ki: u32) -> u32 { return vec_at[u32](&(*g).k_slen, ki as usize) }
fn gc_schwach_anzahl(g: *mut Gc, ki: u32) -> u32 { return vec_at[u32](&(*g).k_wlen, ki as usize) }
fn gc_stark_off(g: *mut Gc, ki: u32, j: u32) -> u64 {
    return vec_at[u64](&(*g).s_offs, (vec_at[u32](&(*g).k_soff, ki as usize) + j) as usize)
}
fn gc_schwach_off(g: *mut Gc, ki: u32, j: u32) -> u64 {
    return vec_at[u64](&(*g).w_offs, (vec_at[u32](&(*g).k_woff, ki as usize) + j) as usize)
}

// Neue Klasse aus dem Parser. KEIN, wenn es den Namen schon gibt — der
// Aufrufer (Parser) meldet den Fehler selbst.
fn gc_klasse_dazu(g: *mut Gc, name: u32) -> u32 {
    if gc_index_von(g, name) != KEIN {
        return KEIN
    }
    let i: u32 = gc_anzahl(g) as u32
    vec_push[u32](&(*g).k_name, name)
    vec_push[u32](&(*g).k_basis, 0)
    vec_push[u32](&(*g).k_foff, vec_len[u32](&(*g).f_name) as u32)
    vec_push[u32](&(*g).k_flen, 0)
    vec_push[u32](&(*g).k_sidx, KEIN)
    vec_push[u32](&(*g).k_widx, KEIN)
    vec_push[u64](&(*g).k_size, 0)
    vec_push[u64](&(*g).k_btid, 0)
    vec_push[u32](&(*g).k_union, 0)
    vec_push[u32](&(*g).k_fertig, 0)
    vec_push[u32](&(*g).k_soff, 0)
    vec_push[u32](&(*g).k_slen, 0)
    vec_push[u32](&(*g).k_woff, 0)
    vec_push[u32](&(*g).k_wlen, 0)
    return i
}

fn gc_basis_setzen(g: *mut Gc, ki: u32, basis: u32) {
    vec_setzen[u32](&(*g).k_basis, ki as usize, basis)
}

// Eigenes Feld. false = doppelt (der Parser meldet den Fehler).
fn gc_feld_dazu(g: *mut Gc, ki: u32, fname: u32, te: u32) -> bool {
    let off: u32 = vec_at[u32](&(*g).k_foff, ki as usize)
    let len: u32 = vec_at[u32](&(*g).k_flen, ki as usize)
    var k: u32 = 0
    while k < len {
        if vec_at[u32](&(*g).f_name, (off + k) as usize) == fname {
            return false
        }
        k = k + 1
    }
    vec_push[u32](&(*g).f_name, fname)
    vec_push[u32](&(*g).f_te, te)
    vec_setzen[u32](&(*g).k_flen, ki as usize, len + 1)
    return true
}

// Klasse hinter einem Structindex ("gc C"), oder KEIN.
fn gc_klasse_von_struct(g: *mut Gc, sidx: u32) -> u32 {
    var i: usize = 0
    while i < gc_anzahl(g) {
        if vec_at[u32](&(*g).k_sidx, i) == sidx {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// Klasse hinter einem GcWeak-Structindex, oder KEIN.
fn gc_klasse_von_weak(g: *mut Gc, widx: u32) -> u32 {
    var i: usize = 0
    while i < gc_anzahl(g) {
        if vec_at[u32](&(*g).k_widx, i) == widx {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// Ist `a` ein Nachfahre von `b` (echte Kette, `a` selbst zaehlt nicht)?
fn gc_ist_nachfahre(g: *mut Gc, a: u32, b: u32) -> bool {
    var cur: u32 = a
    var schritte: u32 = 0
    while schritte < 1024 {
        let bn: u32 = vec_at[u32](&(*g).k_basis, cur as usize)
        if bn == 0 {
            return false
        }
        let nxt: u32 = gc_index_von(g, bn)
        if nxt == KEIN {
            return false
        }
        if nxt == b {
            return true
        }
        cur = nxt
        schritte = schritte + 1
    }
    return false
}

// --------------------------------------------------------- Typfragen

// `Gc[T]` — starker Zeiger: *mut <Struct "gc T">.
fn gc_ist_gc_ptr(g: *mut Gc, t: *mut typen.Typen, ty: u32) -> bool {
    if typen.ty_art(t, ty) != typen.K_PTR {
        return false
    }
    let inner: u32 = typen.ty_a(t, ty)
    if typen.ty_art(t, inner) != typen.K_STRUCT {
        return false
    }
    return gc_klasse_von_struct(g, typen.ty_a(t, inner)) != KEIN
}

// `GcWeak[T]` — schwacher Verweis (Zwei-Wort-Struct).
fn gc_ist_gc_weak(g: *mut Gc, t: *mut typen.Typen, ty: u32) -> bool {
    if typen.ty_art(t, ty) != typen.K_STRUCT {
        return false
    }
    return gc_klasse_von_weak(g, typen.ty_a(t, ty)) != KEIN
}

fn gc_ist_gc_zeiger(g: *mut Gc, t: *mut typen.Typen, ty: u32) -> bool {
    return gc_ist_gc_ptr(g, t, ty) || gc_ist_gc_weak(g, t, ty)
}

// Kostenlose Aufwaertsumwandlung `Gc[Abgeleitet]` -> `Gc[Basis]` (SPEC 4.4).
fn gc_ist_aufwaerts(g2: u64, t: *mut typen.Typen, got: u32, want: u32) -> bool {
    let g: *mut Gc = g2 as *mut Gc
    if typen.ty_art(t, got) != typen.K_PTR || typen.ty_art(t, want) != typen.K_PTR {
        return false
    }
    let gi: u32 = typen.ty_a(t, got)
    let wi: u32 = typen.ty_a(t, want)
    if typen.ty_art(t, gi) != typen.K_STRUCT || typen.ty_art(t, wi) != typen.K_STRUCT {
        return false
    }
    let a: u32 = gc_klasse_von_struct(g, typen.ty_a(t, gi))
    let b: u32 = gc_klasse_von_struct(g, typen.ty_a(t, wi))
    if a == KEIN || b == KEIN {
        return false
    }
    return a == b || gc_ist_nachfahre(g, a, b)
}

// Verwandt in irgendeiner Richtung (Identitaetsvergleich `g == h`).
fn gc_ist_verwandt(g2: u64, t: *mut typen.Typen, a: u32, b: u32) -> bool {
    return gc_ist_aufwaerts(g2, t, a, b) || gc_ist_aufwaerts(g2, t, b, a)
}

// Feldzugriff durch einen `Gc[T]` hindurch: der Structindex, durch den
// hindurchgegriffen wird (hook_field_base in Stufe 0).
fn gc_feld_basis(g: *mut Gc, t: *mut typen.Typen, bt: u32) -> u32 {
    if typen.ty_art(t, bt) != typen.K_PTR {
        return KEIN
    }
    let inner: u32 = typen.ty_a(t, bt)
    if typen.ty_art(t, inner) != typen.K_STRUCT {
        return KEIN
    }
    let si: u32 = typen.ty_a(t, inner)
    if gc_klasse_von_struct(g, si) == KEIN {
        return KEIN
    }
    return si
}

// ------------------------------------------- Aufrufnamen der Sprachoberflaeche

// Beginnt der Aufrufname mit `gc ` ("gc C{...}")? Das Leerzeichen kann nie
// in einem Bezeichner des Quelltextes stehen.
fn gc_hat_neu_praefix(it: *mut intern.Interner, nr: u32) -> bool {
    var pfx: [u8; 3] = "gc "
    return name_praefix(it, nr, (&pfx[0]) as u64, 3)
}

// Klasse hinter "gc C", oder -1.
fn gc_klasse_aus_neu(g: *mut Gc, it: *mut intern.Interner, nr: u32) -> i64 {
    if !gc_hat_neu_praefix(it, nr) {
        return -1
    }
    let p: u64 = intern.intern_zeiger(it, nr)
    let n: usize = intern.intern_laenge(it, nr)
    let kn: i64 = intern.intern_finde(it, p + 3, n - 3)
    if kn < 0 {
        return -1
    }
    let ki: u32 = gc_index_von(g, kn as u32)
    if ki == KEIN {
        return -1
    }
    return ki as i64
}

fn gc_hat_as_praefix(it: *mut intern.Interner, nr: u32) -> bool {
    var pfx: [u8; 8] = "__gc#as:"
    return name_praefix(it, nr, (&pfx[0]) as u64, 8)
}

// Klasse hinter "__gc#as:C", oder -1.
fn gc_klasse_aus_as(g: *mut Gc, it: *mut intern.Interner, nr: u32) -> i64 {
    if !gc_hat_as_praefix(it, nr) {
        return -1
    }
    let p: u64 = intern.intern_zeiger(it, nr)
    let n: usize = intern.intern_laenge(it, nr)
    let kn: i64 = intern.intern_finde(it, p + 8, n - 8)
    if kn < 0 {
        return -1
    }
    let ki: u32 = gc_index_von(g, kn as u32)
    if ki == KEIN {
        return -1
    }
    return ki as i64
}

fn gc_ist_weak_name(it: *mut intern.Interner, nr: u32) -> bool {
    var w: [u8; 4] = "weak"
    return name_gleich(it, nr, (&w[0]) as u64, 4)
}

fn gc_ist_stark_name(it: *mut intern.Interner, nr: u32) -> bool {
    var w: [u8; 5] = "stark"
    return name_gleich(it, nr, (&w[0]) as u64, 5)
}

// Die Compilerintrinsics: 1 = `__gc_state`, 2 = `__gc_save_regs`, 0 = keins.
fn gc_zustandsname(it: *mut intern.Interner, nr: u32) -> u32 {
    var s1: [u8; 10] = "__gc_state"
    if name_gleich(it, nr, (&s1[0]) as u64, 10) {
        return 1
    }
    var s2: [u8; 14] = "__gc_save_regs"
    if name_gleich(it, nr, (&s2[0]) as u64, 14) {
        return 2
    }
    return 0
}

// ------------------------------------------- `#[no_gc]`, Regel 1 (SPEC 3.5.4)

// Ist `nr` der Name einer GC-Allokation oder einer Sammler-Funktion, die
// einen Sammellauf ausloesen kann bzw. den Zustand des Sammlers anfasst?
// Vertrag fuer `nogc.fi` — wortgleich zu `ist_gc_alloc_aufruf` in gc.rs.
fn gc_ist_alloc_aufruf(g: *mut Gc, it: *mut intern.Interner, nr: u32) -> bool {
    if gc_hat_neu_praefix(it, nr) {
        return true
    }
    let p: u64 = intern.intern_zeiger(it, nr)
    let n: usize = intern.intern_laenge(it, nr)
    // Das Endstueck hinter dem LETZTEN "__" zaehlt ebenfalls, sonst waere
    // die Zusage ueber eine Modulgrenze hinweg zu umgehen (`modul__gc_init`).
    var tail: usize = 0
    var i: usize = 0
    while i + 1 < n {
        if rt.ld8(p, i) == 95 as u8 && rt.ld8(p, i + 1) == 95 as u8 {
            tail = i + 2
        }
        i = i + 1
    }
    var n1: [u8; 7] = "gc_init"
    var n2: [u8; 10] = "gc_collect"
    var n3: [u8; 14] = "__gc_alloc_raw"
    var n4: [u8; 16] = "__gc_collect_now"
    var n5: [u8; 16] = "gc_set_max_bytes"
    var n6: [u8; 12] = "gc_max_bytes"
    var n7: [u8; 14] = "gc_total_bytes"
    var n8: [u8; 14] = "gc_collections"
    var n8b: [u8; 15] = "gc_live_objects"
    var n9: [u8; 13] = "gc_heap_bytes"
    var n10: [u8; 13] = "gc_live_bytes"
    var n11: [u8; 16] = "gc_pause_ns_last"
    var n12: [u8; 15] = "gc_pause_ns_max"
    var n13: [u8; 17] = "gc_pause_ns_total"
    var n14: [u8; 11] = "gc_barriers"
    var n15: [u8; 10] = "__gc_state"
    var n16: [u8; 14] = "__gc_save_regs"
    var n17: [u8; 13] = "__gc_weak_raw"
    var n18: [u8; 15] = "__gc_strong_raw"
    var n19: [u8; 11] = "__gc_as_raw"
    var n20: [u8; 12] = "__gc_barrier"
    if eines_von(p, n, tail, (&n1[0]) as u64, 7) { return true }
    if eines_von(p, n, tail, (&n2[0]) as u64, 10) { return true }
    if eines_von(p, n, tail, (&n3[0]) as u64, 14) { return true }
    if eines_von(p, n, tail, (&n4[0]) as u64, 16) { return true }
    if eines_von(p, n, tail, (&n5[0]) as u64, 15) { return true }
    if eines_von(p, n, tail, (&n6[0]) as u64, 12) { return true }
    if eines_von(p, n, tail, (&n7[0]) as u64, 14) { return true }
    if eines_von(p, n, tail, (&n8[0]) as u64, 14) { return true }
    if eines_von(p, n, tail, (&n8b[0]) as u64, 15) { return true }
    if eines_von(p, n, tail, (&n9[0]) as u64, 13) { return true }
    if eines_von(p, n, tail, (&n10[0]) as u64, 13) { return true }
    if eines_von(p, n, tail, (&n11[0]) as u64, 16) { return true }
    if eines_von(p, n, tail, (&n12[0]) as u64, 15) { return true }
    if eines_von(p, n, tail, (&n13[0]) as u64, 17) { return true }
    if eines_von(p, n, tail, (&n14[0]) as u64, 11) { return true }
    if eines_von(p, n, tail, (&n15[0]) as u64, 10) { return true }
    if eines_von(p, n, tail, (&n16[0]) as u64, 14) { return true }
    if eines_von(p, n, tail, (&n17[0]) as u64, 13) { return true }
    if eines_von(p, n, tail, (&n18[0]) as u64, 15) { return true }
    if eines_von(p, n, tail, (&n19[0]) as u64, 11) { return true }
    if eines_von(p, n, tail, (&n20[0]) as u64, 12) { return true }
    return false
}

// Volltreffer oder Treffer des Endstuecks hinter dem letzten "__".
fn eines_von(p: u64, n: usize, tail: usize, lit: u64, ln: usize) -> bool {
    if n == ln && rt.mem_eq(p, lit, ln) {
        return true
    }
    if tail > 0 && n - tail == ln && rt.mem_eq(p + tail as u64, lit, ln) {
        return true
    }
    return false
}

// ------------------------------------------------------------- Anmeldung

// `// HOOK gc` in `sema::Checker::run` (vor `collect_structs`): jede Klasse
// wird als Struct vorgemerkt — NACH den Fehlermengen, VOR den Structs des
// Baums, genau wie `declare_classes` in Stufe 0. Das Layout kommt in
// `gc_layout`, wenn die Structs des Programms bekannt sind.
fn gc_anmelden(g2: u64, t: *mut typen.Typen, it: *mut intern.Interner) {
    let g: *mut Gc = g2 as *mut Gc
    let n: usize = gc_anzahl(g)
    if n == 0 {
        return
    }
    var i: usize = 0
    while i < n {
        let name: u32 = vec_at[u32](&(*g).k_name, i)
        if typen.struct_index(t, name) >= 0 {
            // typ '…' ist bereits deklariert
            (*g).fehler = (*g).fehler + 1
        }
        rt.buf_leeren(&(*g).kladde)
        var p1: [u8; 3] = "gc "
        rt.buf_push_bytes(&(*g).kladde, (&p1[0]) as u64, 3)
        rt.buf_push_bytes(&(*g).kladde, intern.intern_zeiger(it, name),
                          intern.intern_laenge(it, name))
        let sn: u32 = intern.intern_nummer(it, rt.buf_ptr(&(*g).kladde),
                                           rt.buf_len(&(*g).kladde)) as u32
        let sidx: u32 = typen.typen_struct_vormerken(t, sn)
        rt.buf_leeren(&(*g).kladde)
        var p2: [u8; 7] = "GcWeak["
        rt.buf_push_bytes(&(*g).kladde, (&p2[0]) as u64, 7)
        rt.buf_push_bytes(&(*g).kladde, intern.intern_zeiger(it, name),
                          intern.intern_laenge(it, name))
        rt.buf_push(&(*g).kladde, 93 as u8)
        let wn: u32 = intern.intern_nummer(it, rt.buf_ptr(&(*g).kladde),
                                           rt.buf_len(&(*g).kladde)) as u32
        let widx: u32 = typen.typen_struct_vormerken(t, wn)
        // Der schwache Verweis ist ein Zwei-Wort-Struct { __p, __s }: der
        // Zeiger VERSCHLEIERT (damit der konservative Stapelscan ihn nicht
        // als starke Wurzel liest) und die Seriennummer des Zielblocks.
        let u64t: u32 = typen.neuer_typ(t, typen.K_U64, 0, 0)
        var wnamen: Vec[u32] = vec_neu[u32]()
        var wtypen: Vec[u32] = vec_neu[u32]()
        var wvers: Vec[u64] = vec_neu[u64]()
        var wp: [u8; 3] = "__p"
        var ws: [u8; 3] = "__s"
        vec_push[u32](&wnamen, intern.intern_nummer(it, (&wp[0]) as u64, 3) as u32)
        vec_push[u32](&wtypen, u64t)
        vec_push[u64](&wvers, 0)
        vec_push[u32](&wnamen, intern.intern_nummer(it, (&ws[0]) as u64, 3) as u32)
        vec_push[u32](&wtypen, u64t)
        vec_push[u64](&wvers, 8)
        typen.typen_struct_festlegen(t, widx, 16, 8, &wnamen, &wtypen, &wvers)
        vec_frei[u32](&wnamen)
        vec_frei[u32](&wtypen)
        vec_frei[u64](&wvers)
        vec_setzen[u32](&(*g).k_sidx, i, sidx)
        vec_setzen[u32](&(*g).k_widx, i, widx)
        i = i + 1
    }
    // Basis pruefen: Existenz und keine Ringe (declare_classes, Schritt 2).
    i = 0
    while i < n {
        let b: u32 = vec_at[u32](&(*g).k_basis, i)
        if b != 0 {
            let bi: u32 = gc_index_von(g, b)
            if bi == KEIN {
                // unbekannte basisklasse
                (*g).fehler = (*g).fehler + 1
                vec_setzen[u32](&(*g).k_basis, i, 0)
            } else if kreis(g, bi, i as u32) {
                // ringfoermige vererbungskette
                (*g).fehler = (*g).fehler + 1
                vec_setzen[u32](&(*g).k_basis, i, 0)
            }
        }
        i = i + 1
    }
}

// Erreicht `von` ueber die Basiskette `ziel`?
fn kreis(g: *mut Gc, von: u32, ziel: u32) -> bool {
    var cur: u32 = von
    var schritte: u32 = 0
    while schritte < 1024 {
        if cur == ziel {
            return true
        }
        let bn: u32 = vec_at[u32](&(*g).k_basis, cur as usize)
        if bn == 0 {
            return false
        }
        let nxt: u32 = gc_index_von(g, bn)
        if nxt == KEIN {
            return false
        }
        cur = nxt
        schritte = schritte + 1
    }
    return true
}

// --------------------------------------------------------------- Layout

// `// HOOK gc` in `sema::add_items_inner` (NACH `collect_structs`): das
// Feldlayout jeder Klasse, in topologischer Reihenfolge (Basis zuerst).
fn gc_layout(g2: u64, t: *mut typen.Typen, b: *mut ast.Baum, it: *mut intern.Interner) {
    let g: *mut Gc = g2 as *mut Gc
    let n: usize = gc_anzahl(g)
    var pass: usize = 0
    while pass < n {
        var fortschritt: bool = false
        var i: usize = 0
        while i < n {
            if vec_at[u32](&(*g).k_fertig, i) == 0 {
                let bn: u32 = vec_at[u32](&(*g).k_basis, i)
                var warten: bool = false
                if bn != 0 {
                    let bi: u32 = gc_index_von(g, bn)
                    if bi != KEIN {
                        warten = vec_at[u32](&(*g).k_fertig, bi as usize) == 0
                    }
                }
                if !warten {
                    lege_aus(g, t, b, it, i as u32)
                    fortschritt = true
                }
            }
            i = i + 1
        }
        if !fortschritt {
            return
        }
        pass = pass + 1
    }
}

// Erlaubte Feldtypen (feldtyp_erlaubt in Stufe 0): Ganzzahlen, bool, f64,
// Zeiger, Gc[T], GcWeak[T] und Arrays davon — keine gewoehnlichen Structs.
fn feldtyp_erlaubt(g: *mut Gc, t: *mut typen.Typen, ty: u32) -> bool {
    let k: u32 = typen.ty_art(t, ty)
    if k == typen.K_FEHLER {
        return true
    }
    if k == typen.K_ARR {
        return feldtyp_erlaubt(g, t, typen.ty_a(t, ty))
    }
    if k == typen.K_STRUCT {
        return gc_ist_gc_weak(g, t, ty)
    }
    if k == typen.K_VOID {
        return false
    }
    return true
}

fn lege_aus(g: *mut Gc, t: *mut typen.Typen, b: *mut ast.Baum, it: *mut intern.Interner, i: u32) {
    var namen: Vec[u32] = vec_neu[u32]()
    var typen_v: Vec[u32] = vec_neu[u32]()
    // Basisfelder liegen VORNE (Praefixlayout, kostenlose Aufwaertsumwandlung).
    var basis_tid: u64 = 0
    let bn: u32 = vec_at[u32](&(*g).k_basis, i as usize)
    if bn != 0 {
        let bi: u32 = gc_index_von(g, bn)
        if bi != KEIN {
            basis_tid = gc_tid(g, bi)
            let bsidx: u32 = vec_at[u32](&(*g).k_sidx, bi as usize)
            var k: u32 = 0
            while k < typen.st_flen(t, bsidx as usize) {
                let fi: u32 = typen.st_foff(t, bsidx as usize) + k
                vec_push[u32](&namen, typen.sf_name(t, fi))
                vec_push[u32](&typen_v, typen.sf_typ(t, fi))
                k = k + 1
            }
        }
    }
    // Eigene Felder: geerbte Namen duerfen nicht erneut vergeben werden.
    let foff: u32 = vec_at[u32](&(*g).k_foff, i as usize)
    let flen: u32 = vec_at[u32](&(*g).k_flen, i as usize)
    var k: u32 = 0
    while k < flen {
        let fname: u32 = vec_at[u32](&(*g).f_name, (foff + k) as usize)
        let fte: u32 = vec_at[u32](&(*g).f_te, (foff + k) as usize)
        var doppelt: bool = false
        var j: usize = 0
        while j < vec_len[u32](&namen) {
            if vec_at[u32](&namen, j) == fname {
                doppelt = true
            }
            j = j + 1
        }
        if doppelt {
            // feld ist schon in der basis vergeben
            (*g).fehler = (*g).fehler + 1
            k = k + 1
            continue
        }
        let ty: u32 = typen.aufloesen(t, b, it, fte)
        if !feldtyp_erlaubt(g, t, ty) {
            // feldtyp ist in einer gc-klasse nicht erlaubt
            (*g).fehler = (*g).fehler + 1
            k = k + 1
            continue
        }
        vec_push[u32](&namen, fname)
        vec_push[u32](&typen_v, ty)
        k = k + 1
    }
    // Versaetze rechnen (dieselbe Rechnung wie typen.struct_layout).
    var vers: Vec[u64] = vec_neu[u64]()
    var versatz: u64 = 0
    var max_a: u64 = 1
    var m: usize = 0
    while m < vec_len[u32](&namen) {
        let ty: u32 = vec_at[u32](&typen_v, m)
        var au: u64 = typen.ausrichtung_von(t, ty)
        if au < 1 { au = 1 }
        let gr: u64 = typen.groesse_von(t, ty)
        if au > max_a { max_a = au }
        versatz = typen.aufrunden(versatz, au)
        vec_push[u64](&vers, versatz)
        versatz = versatz + gr
        m = m + 1
    }
    let groesse: u64 = typen.aufrunden(versatz, max_a)
    let sidx: u32 = vec_at[u32](&(*g).k_sidx, i as usize)
    typen.typen_struct_festlegen(t, sidx, groesse, max_a, &namen, &typen_v, &vers)
    // Offsets fuer die compilergenerierte Verfolgung einsammeln.
    let soff: u32 = vec_len[u64](&(*g).s_offs) as u32
    let woff: u32 = vec_len[u64](&(*g).w_offs) as u32
    var slen: u32 = 0
    var wlen: u32 = 0
    m = 0
    while m < vec_len[u32](&namen) {
        let ty: u32 = vec_at[u32](&typen_v, m)
        if gc_ist_gc_ptr(g, t, ty) {
            vec_push[u64](&(*g).s_offs, vec_at[u64](&vers, m))
            slen = slen + 1
        } else if gc_ist_gc_weak(g, t, ty) {
            vec_push[u64](&(*g).w_offs, vec_at[u64](&vers, m))
            wlen = wlen + 1
        }
        m = m + 1
    }
    vec_frei[u32](&namen)
    vec_frei[u32](&typen_v)
    vec_frei[u64](&vers)
    vec_setzen[u64](&(*g).k_size, i as usize, groesse)
    vec_setzen[u64](&(*g).k_btid, i as usize, basis_tid)
    vec_setzen[u32](&(*g).k_soff, i as usize, soff)
    vec_setzen[u32](&(*g).k_slen, i as usize, slen)
    vec_setzen[u32](&(*g).k_woff, i as usize, woff)
    vec_setzen[u32](&(*g).k_wlen, i as usize, wlen)
    vec_setzen[u32](&(*g).k_fertig, i as usize, 1)
}

// ------------------------------------------------------- Typaufloesung

// HOOK in `typen.aufloesen` (hook_resolve_ty in gc.rs): `Gc[C]`, `GcWeak[C]`
// und der verbotene Gebrauch eines Klassennamens als gewoehnlicher Typ.
// Rueckgabe KEIN = kein GC-Name, die normale Aufloesung geht weiter.
// Fehler werden hier GEZAEHLT (der Typpruefer zieht sie ueber `gc_fehler`
// in seine eigene Zaehlung — wie `fehler.fi`).
fn gc_typ_haken(g2: u64, t: *mut typen.Typen, it: *mut intern.Interner, nr: u32) -> u32 {
    let g: *mut Gc = g2 as *mut Gc
    var pfx1: [u8; 7] = "__gc#p:"
    if name_praefix(it, nr, (&pfx1[0]) as u64, 7) {
        let p: u64 = intern.intern_zeiger(it, nr)
        let n: usize = intern.intern_laenge(it, nr)
        let kn: i64 = intern.intern_finde(it, p + 7, n - 7)
        var ki: u32 = KEIN
        if kn >= 0 {
            ki = gc_index_von(g, kn as u32)
        }
        if ki == KEIN {
            // unbekannte gc-klasse
            (*g).fehler = (*g).fehler + 1
            return typen.neuer_typ(t, typen.K_FEHLER, 0, 0)
        }
        let st: u32 = typen.neuer_typ(t, typen.K_STRUCT, gc_sidx(g, ki), 0)
        return typen.neuer_typ(t, typen.K_PTR, st, 1)
    }
    var pfx2: [u8; 7] = "__gc#w:"
    if name_praefix(it, nr, (&pfx2[0]) as u64, 7) {
        let p: u64 = intern.intern_zeiger(it, nr)
        let n: usize = intern.intern_laenge(it, nr)
        let kn: i64 = intern.intern_finde(it, p + 7, n - 7)
        var ki: u32 = KEIN
        if kn >= 0 {
            ki = gc_index_von(g, kn as u32)
        }
        if ki == KEIN {
            (*g).fehler = (*g).fehler + 1
            return typen.neuer_typ(t, typen.K_FEHLER, 0, 0)
        }
        return typen.neuer_typ(t, typen.K_STRUCT, gc_widx(g, ki), 0)
    }
    // `let x: Knoten` — ein gc-class-Wert lebt NUR auf dem GC-Heap.
    if gc_ist_klasse(g, nr) {
        // '…' ist eine gc-klasse und kann kein wert sein
        (*g).fehler = (*g).fehler + 1
        return typen.neuer_typ(t, typen.K_FEHLER, 0, 0)
    }
    return KEIN
}

// --------------------------------------------------- probe (Typ ohne Pruefung)

// Typ von `weak(g)`, `stark(w)` und `x.as?[C]` OHNE Pruefung — damit ein
// Ganzzahlliteral daneben seinen Typ bekommt (`probe_typ` in gc.rs).
// `arg` ist der GESCHAETZTE Typ des ersten Arguments (KEIN = unbekannt).
fn gc_probe_typ(g: *mut Gc, t: *mut typen.Typen, it: *mut intern.Interner,
                name: u32, arg: u32) -> u32 {
    if gc_hat_as_praefix(it, name) {
        let ki: i64 = gc_klasse_aus_as(g, it, name)
        if ki < 0 {
            return KEIN
        }
        let st: u32 = typen.neuer_typ(t, typen.K_STRUCT, gc_sidx(g, ki as u32), 0)
        return typen.neuer_typ(t, typen.K_PTR, st, 1)
    }
    if arg == KEIN {
        return KEIN
    }
    if gc_ist_weak_name(it, name) {
        if typen.ty_art(t, arg) != typen.K_PTR {
            return KEIN
        }
        let inner: u32 = typen.ty_a(t, arg)
        if typen.ty_art(t, inner) != typen.K_STRUCT {
            return KEIN
        }
        let ki: u32 = gc_klasse_von_struct(g, typen.ty_a(t, inner))
        if ki == KEIN {
            return KEIN
        }
        return typen.neuer_typ(t, typen.K_STRUCT, gc_widx(g, ki), 0)
    }
    if gc_ist_stark_name(it, name) {
        if typen.ty_art(t, arg) != typen.K_STRUCT {
            return KEIN
        }
        let ki: u32 = gc_klasse_von_weak(g, typen.ty_a(t, arg))
        if ki == KEIN {
            return KEIN
        }
        let st: u32 = typen.neuer_typ(t, typen.K_STRUCT, gc_sidx(g, ki), 0)
        return typen.neuer_typ(t, typen.K_PTR, st, 1)
    }
    return KEIN
}

// --------------------------------------------------------- Quelltextsuche

// Entscheidet am TOKENSTROM, ob eine Datei `gc class` benutzt (Bit 1),
// `error AllocError` selbst deklariert (Bit 2) bzw. den Finalisierer-
// Verteiler `fn __gc_finalisiere` selbst mitbringt (Bit 4, Runde 47) —
// `quelle_braucht_gc`, `quelle_hat_allocerror` und
// `quelle_hat_finalisierer` in gc.rs. Danach zieht der Treiber die Laufzeit
// ein, laesst die Fehlermenge weg, wenn das Programm sie schon hat, und legt
// die leere Voreinstellung des Verteilers nur dazu, wenn sie fehlt.
//
// BIT 4 ZAEHLT NUR AUS DER WURZELDATEI. In einem Modul hiesse die Funktion
// `modul____gc_finalisiere`, und die Laufzeit faende sie nicht mehr; der
// Treiber maskiert die Modulergebnisse deshalb mit 3.
// MERGE R49+R53: beide Zweige haben Bit 8 vergeben — Runde 53 fuer
// GcVec/GcMap, Runde 49 fuer einen eigenen `__faden_arbeit`. Bit 8 bleibt
// bei den Sammlungen (es wird auch aus MODULEN uebernommen), der
// Fadenverteiler zieht auf Bit 16 um (zaehlt nur aus der Wurzeldatei).
fn gc_quelle_scan(l: u64, it2: u64, gc_nr: i64, class_nr: i64, ae_nr: i64,
                  fin_nr: i64, fa_nr: i64) -> u32 {
    let lx: *mut lexer.Lexer = l as *mut lexer.Lexer
    let it: *mut intern.Interner = it2 as *mut intern.Interner
    // Runde 53 (gc.rs::quelle_braucht_sammlungen): Praefixtest statt
    // Gleichheitstest — er deckt den Typ `GcVec[Gc[T]]` UND den Aufruf
    // `gcvec_anhaengen[T](…)` mit derselben Pruefung ab.
    var s1: [u8; 5] = "GcVec"
    var s2: [u8; 5] = "GcMap"
    var s3: [u8; 6] = "gcvec_"
    var s4: [u8; 6] = "gcmap_"
    var aus: u32 = 0
    var i: usize = 0
    while i + 1 < lexer.lex_anzahl(lx) {
        let a: u32 = lexer.lex_art(lx, i)
        if a == 1 {
            let nr: u32 = lexer.lex_nr(lx, i)
            var samml: bool = intern.intern_praefix(it, nr, (&s1[0]) as u64, 5)
            if !samml {
                samml = intern.intern_praefix(it, nr, (&s2[0]) as u64, 5)
            }
            if !samml {
                samml = intern.intern_praefix(it, nr, (&s3[0]) as u64, 6)
            }
            if !samml {
                samml = intern.intern_praefix(it, nr, (&s4[0]) as u64, 6)
            }
            if samml {
                aus = aus | 8
            }
        }
        if a == 1 && gc_nr >= 0 && lexer.lex_nr(lx, i) as i64 == gc_nr {
            if lexer.lex_art(lx, i + 1) == 1 && class_nr >= 0 {
                if lexer.lex_nr(lx, i + 1) as i64 == class_nr {
                    aus = aus | 1
                }
            }
        }
        // 31 = das Schluesselwort `error` (Token-Art aus lexer.fi).
        if a == 31 && ae_nr >= 0 && lexer.lex_art(lx, i + 1) == 1 {
            if lexer.lex_nr(lx, i + 1) as i64 == ae_nr {
                aus = aus | 2
            }
        }
        // 4 = das Schluesselwort `fn` (A_KWFN in lexer.fi).
        if a == 4 && fin_nr >= 0 && lexer.lex_art(lx, i + 1) == 1 {
            if lexer.lex_nr(lx, i + 1) as i64 == fin_nr {
                aus = aus | 4
            }
        }
        // Runde 49 (Merge: Bit 16 statt 8): die Wurzeldatei bringt
        // `fn __faden_arbeit` selbst mit (quelle_hat_fadenarbeit in gc.rs).
        if a == 4 && fa_nr >= 0 && lexer.lex_art(lx, i + 1) == 1 {
            if lexer.lex_nr(lx, i + 1) as i64 == fa_nr {
                aus = aus | 16
            }
        }
        // Runde 49: die Laufzeit wird auch von JEDEM Bezeichner mit dem
        // Praefix `faden_` oder `__faden` gezogen — die Faden-Laufzeit steht
        // in derselben Datei wie der Sammler und braucht denselben
        // Zustandsblock (quelle_braucht_gc in gc.rs, wortgleich).
        if a == 1 {
            let fnr2: u32 = lexer.lex_nr(lx, i)
            let fpz: u64 = lexer.lex_name_zeiger(lx, fnr2)
            let fpl: usize = lexer.lex_name_laenge(lx, fnr2)
            var pfa: [u8; 6] = "faden_"
            var pfb: [u8; 7] = "__faden"
            if fpl >= 6 as usize && rt.mem_eq(fpz, (&pfa[0]) as u64, 6) {
                aus = aus | 1
            }
            if fpl >= 7 as usize && rt.mem_eq(fpz, (&pfb[0]) as u64, 7) {
                aus = aus | 1
            }
        }
        i = i + 1
    }
    return aus
}
