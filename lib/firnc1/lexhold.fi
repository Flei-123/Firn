// SPDX-License-Identifier: MPL-2.0
// lib/firnc1/lexhold.fi -- firnc1.lexhold: lexers of the first pass kept for the second pass

import rt
import vec
import lexer

export { Held, LexHold, hold_new, hold_slot, hold_get, hold_release, hold_free }

struct Held {
    lx: lexer.Lexer,
    src: rt.Buf,
}

struct LexHold {
    slots: Vec[u64],
}

fn held_size[T]() -> usize {
    return size_of[T]()
}

fn hold_new() -> LexHold {
    return LexHold { slots: vec_new[u64]() }
}

fn hold_slot(h: *mut LexHold, index: usize) -> *mut Held {
    while vec_len[u64](&(*h).slots) <= index {
        vec_push[u64](&(*h).slots, 0)
    }
    let p: u64 = rt.heap_alloc(held_size[Held]())
    if p == 0 {
        return 0 as *mut Held
    }
    vec_set[u64](&(*h).slots, index, p)
    (*(p as *mut Held)).src = rt.buf_new()
    return p as *mut Held
}

fn hold_get(h: *mut LexHold, index: usize) -> *mut Held {
    return vec_at[u64](&(*h).slots, index) as *mut Held
}

fn hold_release(h: *mut LexHold, index: usize) {
    let p: u64 = vec_at[u64](&(*h).slots, index)
    if p == 0 {
        return
    }
    lexer.lex_free(&(*(p as *mut Held)).lx)
    rt.buf_free(&(*(p as *mut Held)).src)
    rt.heap_free(p, held_size[Held]())
    vec_set[u64](&(*h).slots, index, 0)
}

fn hold_free(h: *mut LexHold) {
    var i: usize = 0
    while i < vec_len[u64](&(*h).slots) {
        hold_release(h, i)
        i = i + 1
    }
    vec_free[u64](&(*h).slots)
}
