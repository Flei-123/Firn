// lib/firnc1/codegen.fi — VON DER FIR ZU x86-64, IN FIRN.
//
// Neunter Teil von Stufe 1 und der letzte vor dem Fixpunkt. Damit uebersetzt
// die Firn-Fassung ein Programm von vorne bis hinten: Text -> Token -> Baum ->
// Typen -> FIR -> Assembler.
//
// BEWUSST OHNE REGISTERZUTEILUNG. `firnc0` hat dafuer `regalloc.rs` mit
// Lebendigkeitsanalyse und Verschmelzung; hier bekommt JEDER FIR-Wert einen
// eigenen Platz im Rahmen, und jede Instruktion laedt ihre Operanden, rechnet
// und schreibt zurueck. Das ist langsamer Code — aber richtiger, und er ist in
// einem Nachmittag nachvollziehbar. Der Vergleich laeuft deshalb auch NICHT
// ueber den Assemblertext, sondern ueber das VERHALTEN: uebersetzen,
// assemblieren, linken, laufen lassen, Rueckgabewert und Ausgabe vergleichen.
// Fuer einen Codegenerator ist das ohnehin der ehrlichere Massstab.
//
// RAHMEN: `[rbp - 8*(v+1)]` ist der Platz des Wertes `%v`. Dahinter liegen die
// Bereiche der `alloca`s. Ein Wert liegt IMMER als volle 64 Bit da, passend
// erweitert (vorzeichen- bzw. nullerweitert) — deshalb muss nach jeder
// Rechnung `normalisiere` laufen.
//
// GLEITKOMMA laeuft ueber `xmm0`/`xmm1`. Ein `f64`-Wert liegt im Rahmen wie
// jeder andere — als acht Oktette; nur die Rechnung geht durch die
// SSE-Befehle. Eine eigene Klassifikation an der Funktionsgrenze gibt es
// NICHT: Stufe 0 uebergibt `f64` in Ganzzahlregistern (SPEC §14.1, bewusste
// Abweichung von System V), und genau das tut dieser Codegenerator auch.
//
// MEHR ALS SECHS ARGUMENTE gehen nach System V ueber den Stapel, in
// UMGEKEHRTER Reihenfolge. Beim Aufruf muss `rsp` 16-ausgerichtet sein — bei
// ungerader Zahl von Stapelargumenten wird deshalb ein Fuellwort davor
// gelegt. Die aufgerufene Funktion findet sie bei `[rbp+16]`, `[rbp+24]`, …;
// davor liegen die gesicherte Ruecksprungadresse und das gesicherte `rbp`.

import rt
import vec
import intern
import fir
import gc
import iface
import core

export { Cg, cg_new, cg_free, cg_run, cg_unsuitable, cg_text, cg_gc_set,
         cg_freestanding_set,
         cg_if_set }

const KEIN: u32 = 4294967295

struct Cg {
    f: u64              // Zeiger auf die Fir
    it: u64             // Interner
    out: rt.Buf
    slot: Vec[u64]      // Versatz je Wert (positiv, von rbp abzuziehen)
    aslot: Vec[u64]     // Versatz des alloca-Bereichs je Wert, 0 = keiner
    frame: u64
    unsuitable: bool
    gcr: u64            // gc-Registrierung (Runde 34), 0 = keine Klassen
    ifr: u64            // Schnittstellen (Runde 46), 0 = keine
    free: bool          // RUNDE 52: freistehend — kein `_start`, kein exit
}

fn cg_new(f: u64, it: u64) -> Cg {
    return Cg{
        f: f, it: it,
        out: rt.buf_new(),
        slot: vec_new[u64](), aslot: vec_new[u64](),
        frame: 0, unsuitable: false, gcr: 0, ifr: 0, free: false,
    }
}

// Die gc-Registrierung anmelden (Runde 34): sie traegt Groesse, Typkennung
// und Feldoffsets jeder Klasse — daraus entsteht die Typtabelle des Sammlers.
fn cg_gc_set(c: *mut Cg, g: u64) { (*c).gcr = g }

// RUNDE 52 (SPEC 2): freistehend uebersetzen — KEIN `_start`, kein
// Laufzeitvorspann, kein `exit`. Das Ergebnis ist eine Objektdatei, die ein
// Bootlader bzw. ein Linkerskript einbindet.
fn cg_freestanding_set(c: *mut Cg, v: bool) { (*c).free = v }

// Die Schnittstellen-Registrierung anmelden (Runde 46): aus ihr entstehen
// die Methodentafeln in `.rodata`.
fn cg_if_set(c: *mut Cg, f: u64) { (*c).ifr = f }
fn ifg(c: *mut Cg) -> *mut iface.If { return (*c).ifr as *mut iface.If }
fn has_if(c: *mut Cg) -> bool {
    if (*c).ifr == 0 {
        return false
    }
    return iface.if_has(ifg(c))
}
fn gcg(c: *mut Cg) -> *mut gc.Gc { return (*c).gcr as *mut gc.Gc }
fn has_gc(c: *mut Cg) -> bool {
    if (*c).gcr == 0 {
        return false
    }
    // Runde 49: auch ohne `gc class` braucht ein Programm mit Faeden den
    // Zustandsblock (gc.rs: `hat_klassen() || laufzeit_aktiv()`).
    if gc.gc_runtime(gcg(c)) != 0 as usize {
        return true
    }
    return gc.gc_has_classes(gcg(c))
}

fn cg_free(c: *mut Cg) {
    rt.buf_free(&(*c).out)
    vec_free[u64](&(*c).slot)
    vec_free[u64](&(*c).aslot)
}

fn cg_unsuitable(c: *mut Cg) -> bool { return (*c).unsuitable }
fn cg_text(c: *mut Cg) -> *mut rt.Buf { return &(*c).out }
fn ff(c: *mut Cg) -> *mut fir.Fir { return (*c).f as *mut fir.Fir }
fn it(c: *mut Cg) -> *mut intern.Interner { return (*c).it as *mut intern.Interner }

// ------------------------------------------------------------- Textausgabe

fn t(c: *mut Cg, p: u64, n: usize) {
    rt.buf_push_bytes(&(*c).out, p, n)
}

fn nl(c: *mut Cg) {
    rt.buf_push(&(*c).out, 10 as u8)
}

fn number(c: *mut Cg, v: u64) {
    rt.buf_push_dec_u64(&(*c).out, v)
}

fn inum(c: *mut Cg, v: i64) {
    rt.buf_push_dec_i64(&(*c).out, v)
}

// Symbolname einer Funktion: `_F1.` davor, damit nichts mit dem
// Betriebssystem oder mit `firnc0` kollidiert.
fn sym(c: *mut Cg, nr: u32) {
    var p: [u8; 4] = "_F1."
    t(c, (&p[0]) as u64, 4)
    rt.buf_push_bytes(&(*c).out, intern.intern_ptr(it(c), nr), intern.intern_length(it(c), nr))
}

fn blocklabel(c: *mut Cg, fnr: u32, bb: u32) {
    var p: [u8; 2] = ".L"
    t(c, (&p[0]) as u64, 2)
    sym(c, fnr)
    var q: [u8; 4] = "__bb"
    t(c, (&q[0]) as u64, 4)
    number(c, bb as u64)
}

// ---------------------------------------------------------- Registernamen
// 0=rax 1=rcx 2=rdx 3=rsi 4=rdi 5=r8 6=r9 7=r10 8=rbp 9=rsp
const R_AX: u32 = 0
const R_CX: u32 = 1
const R_DX: u32 = 2

fn reg64(c: *mut Cg, r: u32) {
    var tab: [u8; 29] = "rax|rcx|rdx|rsi|rdi|r8|r9|r10"
    piece(c, (&tab[0]) as u64, 29, r)
}

// Teilstueck `nr` aus einer mit '|' getrennten Tafel schreiben.
fn piece(c: *mut Cg, p: u64, n: usize, nr: u32) {
    var i: usize = 0
    var k: u32 = 0
    var start: usize = 0
    while i <= n {
        var end: bool = i == n
        if !end {
            end = rt.ld8(p, i) == 124 as u8
        }
        if end {
            if k == nr {
                t(c, p + start as u64, i - start)
                return
            }
            k = k + 1
            start = i + 1
        }
        i = i + 1
    }
}

// Registername in der Breite `bits` (8/16/32/64) fuer rax/rcx/rdx.
fn regb(c: *mut Cg, r: u32, bits: u32) {
    var t8: [u8; 8] = "al|cl|dl"
    var t16: [u8; 8] = "ax|cx|dx"
    var t32: [u8; 11] = "eax|ecx|edx"
        if bits == 8 {
        piece(c, (&t8[0]) as u64, 8, r)
        return
    }
        if bits == 16 {
        piece(c, (&t16[0]) as u64, 8, r)
        return
    }
        if bits == 32 {
        piece(c, (&t32[0]) as u64, 11, r)
        return
    }
    reg64(c, r)
}

fn word_size(c: *mut Cg, bits: u32) {
    var b: [u8; 5] = "byte "
    var w: [u8; 5] = "word "
    var d: [u8; 6] = "dword "
    var q: [u8; 6] = "qword "
        if bits == 8 {
        t(c, (&b[0]) as u64, 5)
        return
    }
        if bits == 16 {
        t(c, (&w[0]) as u64, 5)
        return
    }
        if bits == 32 {
        t(c, (&d[0]) as u64, 6)
        return
    }
    t(c, (&q[0]) as u64, 6)
}

// `  ` am Zeilenanfang
fn ins(c: *mut Cg) {
    var s: [u8; 4] = "    "
    t(c, (&s[0]) as u64, 4)
}

fn w(c: *mut Cg, p: u64, n: usize) {
    t(c, p, n)
}

// `mov <reg>, qword ptr [rbp-<off>]`
fn load_slot(c: *mut Cg, r: u32, off: u64) {
    ins(c)
    var m: [u8; 4] = "mov "
    w(c, (&m[0]) as u64, 4)
    reg64(c, r)
    var s: [u8; 17] = ", qword ptr [rbp-"
    w(c, (&s[0]) as u64, 17)
    number(c, off)
    var e: [u8; 1] = "]"
    w(c, (&e[0]) as u64, 1)
    nl(c)
}

fn store_slot(c: *mut Cg, off: u64, r: u32) {
    ins(c)
    var m: [u8; 19] = "mov qword ptr [rbp-"
    w(c, (&m[0]) as u64, 19)
    number(c, off)
    var s: [u8; 3] = "], "
    w(c, (&s[0]) as u64, 3)
    reg64(c, r)
    nl(c)
}

fn slot_of(c: *mut Cg, v: u32) -> u64 {
    return vec_at[u64](&(*c).slot, v as usize)
}

fn load_value(c: *mut Cg, r: u32, v: u32) {
    load_slot(c, r, slot_of(c, v))
}

// Ein Wert liegt IMMER als volle 64 Bit im Rahmen, passend erweitert.
// Nach jeder Rechnung muss das wiederhergestellt werden.
fn normalize(c: *mut Cg, r: u32, ty: u32) {
    let bits: u32 = fir.fty_bits(ty)
    if bits >= 64 || bits == 0 {
        return
    }
    let sign: bool = ty == fir.T_I8 || ty == fir.T_I16 || ty == fir.T_I32
    if bits == 32 && !sign {
        // `movzx r64, r/m32` gibt es nicht — ein `mov exx, exx` nullt die
        // oberen 32 Bit von selbst.
        ins(c)
        var m: [u8; 4] = "mov "
        w(c, (&m[0]) as u64, 4)
        regb(c, r, 32)
        var k: [u8; 2] = ", "
        w(c, (&k[0]) as u64, 2)
        regb(c, r, 32)
        nl(c)
        return
    }
    ins(c)
    if sign {
        var m2: [u8; 6] = "movsx "
        w(c, (&m2[0]) as u64, 6)
    } else {
        var m3: [u8; 6] = "movzx "
        w(c, (&m3[0]) as u64, 6)
    }
    reg64(c, r)
    var k2: [u8; 2] = ", "
    w(c, (&k2[0]) as u64, 2)
    regb(c, r, bits)
    nl(c)
}

// Ein einfacher Befehl mit zwei Registeroperanden: `<op> <a>, <b>`
fn op2(c: *mut Cg, name: u64, n: usize, a: u32, b: u32) {
    ins(c)
    w(c, name, n)
    var s: [u8; 1] = " "
    w(c, (&s[0]) as u64, 1)
    reg64(c, a)
    var k: [u8; 2] = ", "
    w(c, (&k[0]) as u64, 2)
    reg64(c, b)
    nl(c)
}

fn op1(c: *mut Cg, name: u64, n: usize, a: u32) {
    ins(c)
    w(c, name, n)
    var s: [u8; 1] = " "
    w(c, (&s[0]) as u64, 1)
    reg64(c, a)
    nl(c)
}

fn raw(c: *mut Cg, p: u64, n: usize) {
    ins(c)
    w(c, p, n)
    nl(c)
}

// ------------------------------------------------------------ Instruktionen

fn is_sign(ty: u32) -> bool {
    return ty == fir.T_I8 || ty == fir.T_I16 || ty == fir.T_I32 || ty == fir.T_I64
}

// `movsd xmm<n>, qword ptr [rbp-<off>]`
fn load_xmm(c: *mut Cg, n: u32, v: u32) {
    ins(c)
    var m: [u8; 9] = "movsd xmm"
    w(c, (&m[0]) as u64, 9)
    number(c, n as u64)
    var s: [u8; 17] = ", qword ptr [rbp-"
    w(c, (&s[0]) as u64, 17)
    number(c, slot_of(c, v))
    var e: [u8; 1] = "]"
    w(c, (&e[0]) as u64, 1)
    nl(c)
}

fn store_xmm(c: *mut Cg, off: u64, n: u32) {
    ins(c)
    var m: [u8; 21] = "movsd qword ptr [rbp-"
    w(c, (&m[0]) as u64, 21)
    number(c, off)
    var s: [u8; 6] = "], xmm"
    w(c, (&s[0]) as u64, 6)
    number(c, n as u64)
    nl(c)
}

fn emit_bin_f64(c: *mut Cg, op: u32, a: u32, b: u32, dst: u32) {
    if op > 3 {
        // `%` und die Bitoperationen sind fuer f64 nicht definiert — der
        // Typpruefer laesst sie gar nicht durch.
        (*c).unsuitable = true
        return
    }
    load_xmm(c, 0, a)
    load_xmm(c, 1, b)
    ins(c)
    var tab: [u8; 23] = "addsd|subsd|mulsd|divsd"
    piece(c, (&tab[0]) as u64, 23, op)
    var r: [u8; 11] = " xmm0, xmm1"
    w(c, (&r[0]) as u64, 11)
    nl(c)
    store_xmm(c, slot_of(c, dst), 0)
}

// Vergleich zweier `f64`. `comisd` setzt die Flaggen wie ein
// UNSIGNED-Vergleich; NaN setzt zusaetzlich PF. Nach IEEE-754 ist jeder
// Vergleich mit NaN falsch — ausser `!=`, das wahr sein muss.
fn emit_cmp_f64(c: *mut Cg, op: u32, a: u32, b: u32, dst: u32) {
    load_xmm(c, 0, a)
    load_xmm(c, 1, b)
    var cm: [u8; 17] = "comisd xmm0, xmm1"
    raw(c, (&cm[0]) as u64, 17)
    ins(c)
    var set: [u8; 3] = "set"
    w(c, (&set[0]) as u64, 3)
    var names: [u8; 14] = "e|ne|b|be|a|ae"
    piece(c, (&names[0]) as u64, 14, op)
    var al: [u8; 3] = " al"
    w(c, (&al[0]) as u64, 3)
    nl(c)
    // NaN: PF ist gesetzt. Bei `==` muss das Ergebnis dann 0 sein, bei `!=`
    // muss es 1 sein, bei den vier Ordnungsvergleichen 0.
    if op == 1 {
        var sp: [u8; 7] = "setp cl"
        raw(c, (&sp[0]) as u64, 7)
        var o: [u8; 9] = "or al, cl"
        raw(c, (&o[0]) as u64, 9)
    } else {
        var snp: [u8; 8] = "setnp cl"
        raw(c, (&snp[0]) as u64, 8)
        var an: [u8; 10] = "and al, cl"
        raw(c, (&an[0]) as u64, 10)
    }
    var mz: [u8; 13] = "movzx rax, al"
    raw(c, (&mz[0]) as u64, 13)
    store_slot(c, slot_of(c, dst), R_AX)
}

fn emit_bin(c: *mut Cg, ty: u32, op: u32, a: u32, b: u32, dst: u32) {
    if ty == fir.T_F64 {
        emit_bin_f64(c, op, a, b, dst)
        return
    }
    load_value(c, R_AX, a)
    load_value(c, R_CX, b)
        if op == 0 {
        var n: [u8; 3] = "add"
        op2(c, (&n[0]) as u64, 3, R_AX, R_CX)
    }
        else if op == 1 {
        var n: [u8; 3] = "sub"
        op2(c, (&n[0]) as u64, 3, R_AX, R_CX)
    }
        else if op == 2 {
        var n: [u8; 4] = "imul"
        op2(c, (&n[0]) as u64, 4, R_AX, R_CX)
    }
    else if op == 3 || op == 4 {
        // Division und Rest: `idiv`/`div` teilen rdx:rax.
        if is_sign(ty) {
            var q: [u8; 3] = "cqo"
            raw(c, (&q[0]) as u64, 3)
            var d: [u8; 4] = "idiv"
            op1(c, (&d[0]) as u64, 4, R_CX)
        } else {
            var z: [u8; 12] = "xor edx, edx"
            raw(c, (&z[0]) as u64, 12)
            var d2: [u8; 3] = "div"
            op1(c, (&d2[0]) as u64, 3, R_CX)
        }
        if op == 4 {
            var m: [u8; 12] = "mov rax, rdx"
            raw(c, (&m[0]) as u64, 12)
        }
    }
        else if op == 5 {
        var n: [u8; 3] = "and"
        op2(c, (&n[0]) as u64, 3, R_AX, R_CX)
    }
        else if op == 6 {
        var n: [u8; 2] = "or"
        op2(c, (&n[0]) as u64, 2, R_AX, R_CX)
    }
        else if op == 7 {
        var n: [u8; 3] = "xor"
        op2(c, (&n[0]) as u64, 3, R_AX, R_CX)
    }
    else if op == 8 {
        var n: [u8; 11] = "shl rax, cl"
        raw(c, (&n[0]) as u64, 11)
    }
    else {
        if is_sign(ty) {
            var n: [u8; 11] = "sar rax, cl"
            raw(c, (&n[0]) as u64, 11)
        } else {
            var n2: [u8; 11] = "shr rax, cl"
            raw(c, (&n2[0]) as u64, 11)
        }
    }
    normalize(c, R_AX, ty)
    store_slot(c, slot_of(c, dst), R_AX)
}

fn emit_cmp(c: *mut Cg, ty: u32, op: u32, a: u32, b: u32, dst: u32) {
    if ty == fir.T_F64 {
        emit_cmp_f64(c, op, a, b, dst)
        return
    }
    load_value(c, R_AX, a)
    load_value(c, R_CX, b)
    var cm: [u8; 3] = "cmp"
    op2(c, (&cm[0]) as u64, 3, R_AX, R_CX)
    ins(c)
    var set: [u8; 3] = "set"
    w(c, (&set[0]) as u64, 3)
    // eq ne lt le gt ge — mit oder ohne Vorzeichen
    var vz: [u8; 14] = "e|ne|l|le|g|ge"
    var oz: [u8; 14] = "e|ne|b|be|a|ae"
    if is_sign(ty) {
        piece(c, (&vz[0]) as u64, 14, op)
    } else {
        piece(c, (&oz[0]) as u64, 14, op)
    }
    var al: [u8; 3] = " al"
    w(c, (&al[0]) as u64, 3)
    nl(c)
    var mz: [u8; 13] = "movzx rax, al"
    raw(c, (&mz[0]) as u64, 13)
    store_slot(c, slot_of(c, dst), R_AX)
}

fn emit_const(c: *mut Cg, ty: u32, raw_value: u64, dst: u32) {
    ins(c)
    var m: [u8; 7] = "movabs "
    w(c, (&m[0]) as u64, 7)
    reg64(c, R_AX)
    var k: [u8; 2] = ", "
    w(c, (&k[0]) as u64, 2)
    if is_sign(ty) {
        inum(c, raw_value as i64)
    } else {
        number(c, raw_value)
    }
    nl(c)
    store_slot(c, slot_of(c, dst), R_AX)
}

// Zugriff auf den Speicher: `mov <reg>, <groesse> ptr [rax]` und umgekehrt.
fn emit_load(c: *mut Cg, ty: u32, addr: u32, dst: u32) {
    load_value(c, R_AX, addr)
    let bits: u32 = fir.fty_bits(ty)
    ins(c)
    if bits >= 64 {
        var m: [u8; 24] = "mov rax, qword ptr [rax]"
        w(c, (&m[0]) as u64, 24)
    } else {
        if is_sign(ty) {
            var m2: [u8; 6] = "movsx "
            w(c, (&m2[0]) as u64, 6)
        } else {
            var m3: [u8; 6] = "movzx "
            w(c, (&m3[0]) as u64, 6)
        }
        if bits == 32 && !is_sign(ty) {
            // wieder der Sonderfall: `mov eax, dword ptr [rax]`
            rt.buf_set_len(&(*c).out, rt.buf_len(&(*c).out) - 6)
            var m4: [u8; 4] = "mov "
            w(c, (&m4[0]) as u64, 4)
            regb(c, R_AX, 32)
        } else {
            reg64(c, R_AX)
        }
        var k: [u8; 2] = ", "
        w(c, (&k[0]) as u64, 2)
        word_size(c, bits)
        var p: [u8; 9] = "ptr [rax]"
        w(c, (&p[0]) as u64, 9)
    }
    nl(c)
    store_slot(c, slot_of(c, dst), R_AX)
}

fn emit_store(c: *mut Cg, ty: u32, addr: u32, val: u32) {
    load_value(c, R_AX, addr)
    load_value(c, R_CX, val)
    let bits: u32 = fir.fty_bits(ty)
    ins(c)
    var m: [u8; 4] = "mov "
    w(c, (&m[0]) as u64, 4)
    word_size(c, bits)
    var p: [u8; 11] = "ptr [rax], "
    w(c, (&p[0]) as u64, 11)
    regb(c, R_CX, bits)
    nl(c)
}

// ------------------------------------------------------- Rahmen und Bloecke

fn round_up(v: u64, on: u64) -> u64 {
    let r: u64 = v % on
    if r == 0 { return v }
    return v + on - r
}

// Legt fuer jeden Wert einen Platz an und danach die Bereiche der `alloca`s.
fn frame_build(c: *mut Cg, fnr: u32) {
    let f: *mut fir.Fir = ff(c)
    let n: u32 = fir.value_count(f, fnr)
    vec_clear[u64](&(*c).slot)
    vec_clear[u64](&(*c).aslot)
    var cursor: u64 = 0
    var v: u32 = 0
    while v < n {
        cursor = cursor + 8
        vec_push[u64](&(*c).slot, cursor)
        vec_push[u64](&(*c).aslot, 0)
        v = v + 1
    }
    // Nur der Eintrittsblock enthaelt `alloca` — das ist eine Zusicherung der
    // FIR und wird hier ausgenutzt.
    let bb0: u32 = 0
    var k: u32 = 0
    while k < fir.inst_count(f, fnr, bb0) {
        let i: u32 = fir.inst_at(f, fnr, bb0, k)
        if fir.i_kind_of(f, i) == fir.O_ALLOCA {
            var au: u64 = fir.i_alen_of(f, i) as u64
            if au == 0 { au = 1 }
            if au > 16 { au = 16 }
            var gr: u64 = fir.i_number_of(f, i)
            if gr < 1 { gr = 1 }
            cursor = round_up(cursor + gr, au)
            vec_set[u64](&(*c).aslot, fir.i_dst_of(f, i) as usize, cursor)
        }
        k = k + 1
    }
    (*c).frame = round_up(cursor, 16)
}

fn emit_alloca(c: *mut Cg, dst: u32) {
    ins(c)
    var m: [u8; 14] = "lea rax, [rbp-"
    w(c, (&m[0]) as u64, 14)
    number(c, vec_at[u64](&(*c).aslot, dst as usize))
    var e: [u8; 1] = "]"
    w(c, (&e[0]) as u64, 1)
    nl(c)
    store_slot(c, slot_of(c, dst), R_AX)
}

fn emit_ptradd(c: *mut Cg, base: u32, off: u32, dst: u32) {
    load_value(c, R_AX, base)
    load_value(c, R_CX, off)
    var a: [u8; 3] = "add"
    op2(c, (&a[0]) as u64, 3, R_AX, R_CX)
    store_slot(c, slot_of(c, dst), R_AX)
}

fn emit_cast(c: *mut Cg, of: u32, after: u32, src: u32, dst: u32) {
    if of == fir.T_F64 && after == fir.T_F64 {
        load_value(c, R_AX, src)
        store_slot(c, slot_of(c, dst), R_AX)
        return
    }
    if after == fir.T_F64 {
        // Ganzzahl -> f64. `cvtsi2sd` rechnet VORZEICHENBEHAFTET; der Wert
        // liegt im Rahmen bereits passend erweitert, also stimmt das auch
        // fuer vorzeichenlose Typen bis 2^63.
        load_value(c, R_AX, src)
        var cv: [u8; 18] = "cvtsi2sd xmm0, rax"
        raw(c, (&cv[0]) as u64, 18)
        store_xmm(c, slot_of(c, dst), 0)
        return
    }
    if of == fir.T_F64 {
        // f64 -> Ganzzahl, abschneidend Richtung null (wie in C).
        load_xmm(c, 0, src)
        var cv2: [u8; 19] = "cvttsd2si rax, xmm0"
        raw(c, (&cv2[0]) as u64, 19)
        normalize(c, R_AX, after)
        store_slot(c, slot_of(c, dst), R_AX)
        return
    }
    load_value(c, R_AX, src)
    normalize(c, R_AX, after)
    store_slot(c, slot_of(c, dst), R_AX)
}

fn emit_un(c: *mut Cg, ty: u32, op: u32, a: u32, dst: u32) {
    if ty == fir.T_F64 {
        // Das Lowering erzeugt fuer `-x` bei f64 kein `neg` (es schreibt
        // `0.0 - x`), aber falls doch: das Vorzeichenbit umlegen.
        (*c).unsuitable = true
        return
    }
    load_value(c, R_AX, a)
    if op == 0 {
        var n: [u8; 3] = "neg"
        op1(c, (&n[0]) as u64, 3, R_AX)
    } else {
        if ty == fir.T_BOOL {
            var x: [u8; 10] = "xor eax, 1"
            raw(c, (&x[0]) as u64, 10)
        } else {
            var n2: [u8; 3] = "not"
            op1(c, (&n2[0]) as u64, 3, R_AX)
        }
    }
    normalize(c, R_AX, ty)
    store_slot(c, slot_of(c, dst), R_AX)
}

// Aufrufregister nach System V.
fn argreg(c: *mut Cg, k: u32) {
    var tab: [u8; 21] = "rdi|rsi|rdx|rcx|r8|r9"
    piece(c, (&tab[0]) as u64, 21, k)
}

fn emit_call(c: *mut Cg, f: *mut fir.Fir, i: u32, fnr: u32) {
    let aoff: u32 = fir.i_aoff_of(f, i)
    let alen: u32 = fir.i_alen_of(f, i)
    // Stapelargumente: rueckwaerts auflegen, davor bei Bedarf ein Fuellwort.
    var stack: u32 = 0
    if alen > 6 {
        stack = alen - 6
    }
    var fill: u32 = 0
    if stack % 2 == 1 {
        fill = 1
        var sp: [u8; 10] = "sub rsp, 8"
        raw(c, (&sp[0]) as u64, 10)
    }
    if stack > 0 {
        var j: u32 = alen
        while j > 6 {
            j = j - 1
            ins(c)
            var m: [u8; 20] = "push qword ptr [rbp-"
            w(c, (&m[0]) as u64, 20)
            number(c, slot_of(c, fir.arg_at(f, aoff + j)))
            var e: [u8; 1] = "]"
            w(c, (&e[0]) as u64, 1)
            nl(c)
        }
    }
    var k: u32 = 0
    while k < 6 && k < alen {
        ins(c)
        var m: [u8; 4] = "mov "
        w(c, (&m[0]) as u64, 4)
        argreg(c, k)
        var s: [u8; 17] = ", qword ptr [rbp-"
        w(c, (&s[0]) as u64, 17)
        number(c, slot_of(c, fir.arg_at(f, aoff + k)))
        var e: [u8; 1] = "]"
        w(c, (&e[0]) as u64, 1)
        nl(c)
        k = k + 1
    }
    ins(c)
    var cl: [u8; 5] = "call "
    w(c, (&cl[0]) as u64, 5)
    sym(c, fir.i_a_of(f, i))
    nl(c)
    if stack + fill > 0 {
        ins(c)
        var ad: [u8; 9] = "add rsp, "
        w(c, (&ad[0]) as u64, 9)
        number(c, (stack + fill) as u64 * 8)
        nl(c)
    }
    let dst: u32 = fir.i_dst_of(f, i)
    if dst != fir.KEIN {
        normalize(c, R_AX, fir.i_ty_of(f, i))
        store_slot(c, slot_of(c, dst), R_AX)
    }
}

// Dynamischer Versand (iface.rs, Runde 46): wie `emit_call`, nur steht das
// Ziel in einem Wert statt in einem Symbol. Es wird ZULETZT nach `rax`
// geladen — `rax` ist hier reines Arbeitsregister und kein Argumentregister.
fn emit_calli(c: *mut Cg, f: *mut fir.Fir, i: u32, fnr: u32) {
    let aoff: u32 = fir.i_aoff_of(f, i)
    let alen: u32 = fir.i_alen_of(f, i)
    var stack: u32 = 0
    if alen > 6 {
        stack = alen - 6
    }
    var fill: u32 = 0
    if stack % 2 == 1 {
        fill = 1
        var sp: [u8; 10] = "sub rsp, 8"
        raw(c, (&sp[0]) as u64, 10)
    }
    if stack > 0 {
        var j: u32 = alen
        while j > 6 {
            j = j - 1
            ins(c)
            var m: [u8; 20] = "push qword ptr [rbp-"
            w(c, (&m[0]) as u64, 20)
            number(c, slot_of(c, fir.arg_at(f, aoff + j)))
            var e: [u8; 1] = "]"
            w(c, (&e[0]) as u64, 1)
            nl(c)
        }
    }
    var k: u32 = 0
    while k < 6 && k < alen {
        ins(c)
        var m: [u8; 4] = "mov "
        w(c, (&m[0]) as u64, 4)
        argreg(c, k)
        var s: [u8; 17] = ", qword ptr [rbp-"
        w(c, (&s[0]) as u64, 17)
        number(c, slot_of(c, fir.arg_at(f, aoff + k)))
        var e: [u8; 1] = "]"
        w(c, (&e[0]) as u64, 1)
        nl(c)
        k = k + 1
    }
    load_slot(c, R_AX, slot_of(c, fir.i_a_of(f, i)))
    var cl: [u8; 8] = "call rax"
    raw(c, (&cl[0]) as u64, 8)
    if stack + fill > 0 {
        ins(c)
        var ad: [u8; 9] = "add rsp, "
        w(c, (&ad[0]) as u64, 9)
        number(c, (stack + fill) as u64 * 8)
        nl(c)
    }
    let dst: u32 = fir.i_dst_of(f, i)
    if dst != fir.KEIN {
        normalize(c, R_AX, fir.i_ty_of(f, i))
        store_slot(c, slot_of(c, dst), R_AX)
    }
}

// Adresse einer Methodentafel: `lea rax, [rip + .L__iface.<I>.<T>]`.
fn emit_vtab(c: *mut Cg, iname: u32, tname: u32, dst: u32) {
    ins(c)
    var le: [u8; 20] = "lea rax, [rip + .L__"
    w(c, (&le[0]) as u64, 20)
    var ifw: [u8; 6] = "iface."
    w(c, (&ifw[0]) as u64, 6)
    rt.buf_push_bytes(&(*c).out, intern.intern_ptr(it(c), iname),
                      intern.intern_length(it(c), iname))
    rt.buf_push(&(*c).out, 46 as u8)
    rt.buf_push_bytes(&(*c).out, intern.intern_ptr(it(c), tname),
                      intern.intern_length(it(c), tname))
    var zu: [u8; 1] = "]"
    w(c, (&zu[0]) as u64, 1)
    nl(c)
    store_slot(c, slot_of(c, dst), R_AX)
}

// Die Methodentafeln (`.rodata`) — eine je vollstaendiger Umsetzung. Das
// Format steht in iface.rs (`tafeln_asm`): Zeiger auf die Methoden, in der
// Reihenfolge der Schnittstelle.
fn if_tables(c: *mut Cg) {
    let g: *mut iface.If = ifg(c)
    var da: bool = false
    var u: usize = 0
    while u < iface.if_u_count(g) {
        if iface.if_u_ok(g, u) && iface.if_u_sidx(g, u) != KEIN {
            da = true
        }
        u = u + 1
    }
    if !da {
        return
    }
    var sec: [u8; 16] = ".section .rodata"
    t(c, (&sec[0]) as u64, 16)
    nl(c)
    var al: [u8; 8] = ".align 8"
    t(c, (&al[0]) as u64, 8)
    nl(c)
    u = 0
    while u < iface.if_u_count(g) {
        // Eine Tafel gibt es nur je STRUCT-Umsetzung. Fuer einen Grundtyp
        // (Runde 50) gaebe es keinen `dyn`-Wert, der sie benutzen koennte.
        if iface.if_u_ok(g, u) && iface.if_u_sidx(g, u) != KEIN {
            let iname: u32 = iface.if_u_if(g, u)
            let pfx: u32 = iface.if_u_pre(g, u)
            var lb: [u8; 10] = ".L__iface."
            t(c, (&lb[0]) as u64, 10)
            rt.buf_push_bytes(&(*c).out, intern.intern_ptr(it(c), iname),
                              intern.intern_length(it(c), iname))
            rt.buf_push(&(*c).out, 46 as u8)
            rt.buf_push_bytes(&(*c).out, intern.intern_ptr(it(c), pfx),
                              intern.intern_length(it(c), pfx))
            rt.buf_push(&(*c).out, 58 as u8)
            nl(c)
            let ii: u32 = iface.if_index(g, iname)
            var k: u32 = 0
            while k < iface.if_mlen(g, ii as usize) {
                ins(c)
                var q: [u8; 6] = ".quad "
                w(c, (&q[0]) as u64, 6)
                var pre: [u8; 4] = "_F1."
                w(c, (&pre[0]) as u64, 4)
                rt.buf_push_bytes(&(*c).out, intern.intern_ptr(it(c), pfx),
                                  intern.intern_length(it(c), pfx))
                var tr: [u8; 2] = "__"
                w(c, (&tr[0]) as u64, 2)
                let mn: u32 = iface.if_mname(g, ii as usize, k)
                rt.buf_push_bytes(&(*c).out, intern.intern_ptr(it(c), mn),
                                  intern.intern_length(it(c), mn))
                nl(c)
                k = k + 1
            }
        }
        u = u + 1
    }
}

fn emit_syscall(c: *mut Cg, f: *mut fir.Fir, i: u32) {
    let aoff: u32 = fir.i_aoff_of(f, i)
    let alen: u32 = fir.i_alen_of(f, i)
    if alen > 7 {
        (*c).unsuitable = true
        return
    }
    // rax = Nummer, danach rdi rsi rdx r10 r8 r9
    var tab: [u8; 25] = "rax|rdi|rsi|rdx|r10|r8|r9"
    var k: u32 = 0
    while k < alen {
        ins(c)
        var m: [u8; 4] = "mov "
        w(c, (&m[0]) as u64, 4)
        piece(c, (&tab[0]) as u64, 25, k)
        var s: [u8; 17] = ", qword ptr [rbp-"
        w(c, (&s[0]) as u64, 17)
        number(c, slot_of(c, fir.arg_at(f, aoff + k)))
        var e: [u8; 1] = "]"
        w(c, (&e[0]) as u64, 1)
        nl(c)
        k = k + 1
    }
    var sc: [u8; 7] = "syscall"
    raw(c, (&sc[0]) as u64, 7)
    let dst: u32 = fir.i_dst_of(f, i)
    if dst != fir.KEIN {
        store_slot(c, slot_of(c, dst), R_AX)
    }
}

// `Op::Select` (ct.rs, RUNDE 36): datenunabhaengige Auswahl als `cmov` —
// KEIN Sprung (SPEC §9.2). Jeder Wert liegt als volle 64 Bit im Rahmen,
// deshalb reicht die 64-Bit-Form fuer alle Breiten (es gibt ohnehin kein
// 8-Bit-`cmov`).
fn emit_select(c: *mut Cg, cond: u32, a: u32, bv: u32, dst: u32) {
    load_value(c, R_AX, bv)
    load_value(c, R_DX, a)
    load_value(c, R_CX, cond)
    var t1: [u8; 13] = "test rcx, rcx"
    raw(c, (&t1[0]) as u64, 13)
    var t2: [u8; 15] = "cmovne rax, rdx"
    raw(c, (&t2[0]) as u64, 15)
    store_slot(c, slot_of(c, dst), R_AX)
}

// `Op::SecureZero` (ct.rs, RUNDE 36): nullt und gilt NIE als toter Code
// (SPEC §9.3, C3) — `rep stosb`, wie in Stufe 0.
fn emit_seczero(c: *mut Cg, addr: u32, size: u32) {
    load_slot(c, 4, slot_of(c, addr))
    load_value(c, R_CX, size)
    var x: [u8; 12] = "xor eax, eax"
    raw(c, (&x[0]) as u64, 12)
    var r: [u8; 9] = "rep stosb"
    raw(c, (&r[0]) as u64, 9)
}

// `Op::AtomicAdd` (atomic.rs, RUNDE 47): EINE Instruktion mit `lock`-Praefix,
// Ergebnis ist der ALTE Wert. Genau wie in Stufe 0 (regalloc.rs/codegen_x86.rs).
fn emit_atomadd(c: *mut Cg, addr: u32, val: u32, dst: u32) {
    load_value(c, R_CX, addr)
    load_value(c, R_AX, val)
    var x: [u8; 30] = "lock xadd qword ptr [rcx], rax"
    raw(c, (&x[0]) as u64, 30)
    store_slot(c, slot_of(c, dst), R_AX)
}

// ---------------------------------------------- Inline-Assembler und MMIO
//
// RUNDE 52 (compiler/src/core.rs, codegen_x86.rs). IMMER volatile: die
// Zeilen stehen genau einmal und genau hier.

// Eine internierte Zeichenkette in den Assemblertext schreiben.
fn iname(c: *mut Cg, nr: u32) {
    rt.buf_push_bytes(&(*c).out, intern.intern_ptr(it(c), nr),
                      intern.intern_length(it(c), nr))
}

fn emit_asm(c: *mut Cg, f: *mut fir.Fir, i: u32, dst: u32) {
    let template: u32 = fir.i_a_of(f, i)
    let out: u32 = fir.i_b_of(f, i)
    let aoff: u32 = fir.i_aoff_of(f, i)
    let alen: u32 = fir.i_alen_of(f, i)
    var kom: [u8; 60] = "# asm (volatile): darf weder entfernt noch verschoben werden"
    raw(c, (&kom[0]) as u64, 60)
    // Eingaben in ihre Register legen. Die schmalen Namen sind Sichten auf
    // denselben 64-Bit-Stamm, deshalb geht immer das ganze Wort hinein.
    var k: u32 = 0
    while k < alen {
        let rn: u32 = fir.arg_at(f, aoff + k * 2)
        let v: u32 = fir.arg_at(f, aoff + k * 2 + 1)
        ins(c)
        var m: [u8; 4] = "mov "
        w(c, (&m[0]) as u64, 4)
        iname(c, core.reg_stem(it(c), rn))
        var s: [u8; 17] = ", qword ptr [rbp-"
        w(c, (&s[0]) as u64, 17)
        number(c, slot_of(c, v))
        var kl: [u8; 1] = "]"
        w(c, (&kl[0]) as u64, 1)
        nl(c)
        k = k + 1
    }
    // Die Vorlage zeilenweise, woertlich.
    let p: u64 = intern.intern_ptr(it(c), template)
    let n: usize = intern.intern_length(it(c), template)
    var start: usize = 0
    var j: usize = 0
    while j <= n {
        var end: bool = j == n
        if !end {
            end = rt.ld8(p, j) == 10 as u8
        }
        if end {
            ins(c)
            w(c, p + start as u64, j - start)
            nl(c)
            start = j + 1
        }
        j = j + 1
    }
    if out != fir.KEIN {
        ins(c)
        var m2: [u8; 19] = "mov qword ptr [rbp-"
        w(c, (&m2[0]) as u64, 19)
        number(c, slot_of(c, dst))
        var s2: [u8; 3] = "], "
        w(c, (&s2[0]) as u64, 3)
        iname(c, core.reg_stem(it(c), out))
        nl(c)
    }
}

fn emit_mmio_load(c: *mut Cg, ty: u32, addr: u32, dst: u32) {
    load_value(c, R_CX, addr)
    let bits: u32 = fir.fty_bits(ty)
    ins(c)
    if bits >= 64 {
        var m: [u8; 24] = "mov rax, qword ptr [rcx]"
        w(c, (&m[0]) as u64, 24)
    } else if bits == 32 {
        var m2: [u8; 24] = "mov eax, dword ptr [rcx]"
        w(c, (&m2[0]) as u64, 24)
    } else {
        var m3: [u8; 11] = "movzx eax, "
        w(c, (&m3[0]) as u64, 11)
        word_size(c, bits)
        var p2: [u8; 9] = "ptr [rcx]"
        w(c, (&p2[0]) as u64, 9)
    }
    nl(c)
    store_slot(c, slot_of(c, dst), R_AX)
}

fn emit_mmio_store(c: *mut Cg, ty: u32, addr: u32, val: u32) {
    load_value(c, R_CX, addr)
    load_value(c, R_AX, val)
    let bits: u32 = fir.fty_bits(ty)
    ins(c)
    var m: [u8; 4] = "mov "
    w(c, (&m[0]) as u64, 4)
    word_size(c, bits)
    var p: [u8; 11] = "ptr [rcx], "
    w(c, (&p[0]) as u64, 11)
    regb(c, R_AX, bits)
    nl(c)
}

// `Op::AtomicCas` (thread.rs, RUNDE 49): `lock cmpxchg [rcx], rdx` — eine
// Instruktion. rax traegt den erwarteten Wert und danach den vorgefundenen.
fn emit_atomcas(c: *mut Cg, addr: u32, erw: u32, new: u32, dst: u32) {
    load_value(c, R_CX, addr)
    load_value(c, R_DX, new)
    load_value(c, R_AX, erw)
    var x: [u8; 33] = "lock cmpxchg qword ptr [rcx], rdx"
    raw(c, (&x[0]) as u64, 33)
    store_slot(c, slot_of(c, dst), R_AX)
}

// `Op::ThreadSelf` (thread.rs, RUNDE 49): der eigene Fadenblock aus `fs:0`.
// Vor `arch_prctl(ARCH_SET_FS)` ist das ein Zugriff auf Adresse 0 — die
// Laufzeit setzt die Basis, bevor sie den Wert je liest (lib/gc/gc.fi).
fn emit_tls(c: *mut Cg, dst: u32) {
    var x: [u8; 23] = "mov rax, qword ptr fs:0"
    raw(c, (&x[0]) as u64, 23)
    store_slot(c, slot_of(c, dst), R_AX)
}

// `Op::ThreadSpawn` (thread.rs, RUNDE 49): `clone(2)` mit Trampolin. Wort fuer
// Wort dieselbe Folge wie in Stufe 0 (compiler/src/thread.rs::spawn_sequenz);
// nur das Symbol des Einstiegs traegt das Praefix dieser Stufe.
//
// `1:` ist eine NUMERISCHE Marke des Assemblers — `jnz 1f` springt zur
// naechsten `1:` nach vorn. Damit braucht die Folge keinen Zaehler und darf
// beliebig oft im selben Modul stehen.
fn emit_spawn(c: *mut Cg, arg: u32, stack: u32, ctid: u32, dst: u32) {
    load_value(c, 4, arg)
    load_value(c, 3, stack)
    load_value(c, R_DX, ctid)
    var z1: [u8; 11] = "sub rsi, 16"
    raw(c, (&z1[0]) as u64, 11)
    var z2: [u8; 24] = "mov qword ptr [rsi], rdi"
    raw(c, (&z2[0]) as u64, 24)
    var z3: [u8; 12] = "mov r10, rdx"
    raw(c, (&z3[0]) as u64, 12)
    var z4: [u8; 16] = "mov rdi, 3477248"
    raw(c, (&z4[0]) as u64, 16)
    var z5: [u8; 12] = "xor r8d, r8d"
    raw(c, (&z5[0]) as u64, 12)
    var z6: [u8; 11] = "mov eax, 56"
    raw(c, (&z6[0]) as u64, 11)
    var z7: [u8; 7] = "syscall"
    raw(c, (&z7[0]) as u64, 7)
    var z8: [u8; 13] = "test rax, rax"
    raw(c, (&z8[0]) as u64, 13)
    var z9: [u8; 6] = "jnz 1f"
    raw(c, (&z9[0]) as u64, 6)
    var za: [u8; 24] = "mov rdi, qword ptr [rsp]"
    raw(c, (&za[0]) as u64, 24)
    var zb: [u8; 11] = "add rsp, 16"
    raw(c, (&zb[0]) as u64, 11)
    var zc: [u8; 12] = "xor ebp, ebp"
    raw(c, (&zc[0]) as u64, 12)
    var zd: [u8; 25] = "call _F1.__faden_einstieg"
    raw(c, (&zd[0]) as u64, 25)
    var ze: [u8; 12] = "mov edi, eax"
    raw(c, (&ze[0]) as u64, 12)
    var zf: [u8; 11] = "mov eax, 60"
    raw(c, (&zf[0]) as u64, 11)
    raw(c, (&z7[0]) as u64, 7)
    var zg: [u8; 3] = "ud2"
    raw(c, (&zg[0]) as u64, 3)
    var zh: [u8; 2] = "1:"
    w(c, (&zh[0]) as u64, 2)
    nl(c)
    store_slot(c, slot_of(c, dst), R_AX)
}

fn emit_copymem(c: *mut Cg, target: u32, source: u32, size: u64) {
    load_slot(c, 4, slot_of(c, target))
    load_slot(c, 3, slot_of(c, source))
    ins(c)
    var m: [u8; 9] = "mov rcx, "
    w(c, (&m[0]) as u64, 9)
    number(c, size)
    nl(c)
    var r: [u8; 9] = "rep movsb"
    raw(c, (&r[0]) as u64, 9)
}

// ------------------------------------------------------------------- Lauf

// `Op::GcAddr` — Adresse des Zustandsblocks des Sammlers in `rax`.
// Mit regs=1 werden vorher die callee-saved Register in den Block gerettet
// (Offset 3968, gc.rs REG_SAVE_OFF), sonst waere die Zusage "konservativer
// Stapel- UND Registerscan" (SPEC 3.5.3) falsch. Diese Stufe hat keine
// Registerzuteilung; die Rettung ist trotzdem dieselbe — sie kostet sechs
// `mov` und haelt den Vertrag wortgleich.
fn emit_gcaddr(c: *mut Cg, regs: u64, dst: u32) {
    ins(c)
    var m: [u8; 31] = "lea rax, [rip + .L__gc_zustand]"
    w(c, (&m[0]) as u64, 31)
    nl(c)
    if regs == 1 {
        var tab: [u8; 23] = "rbx|rbp|r12|r13|r14|r15"
        var k: u32 = 0
        while k < 6 {
            ins(c)
            var mv: [u8; 19] = "mov qword ptr [rax+"
            w(c, (&mv[0]) as u64, 19)
            number(c, 3968 + k as u64 * 8)
            var mm: [u8; 3] = "], "
            w(c, (&mm[0]) as u64, 3)
            piece(c, (&tab[0]) as u64, 23, k)
            nl(c)
            k = k + 1
        }
    }
    store_slot(c, slot_of(c, dst), R_AX)
}

// Die compilergenerierte Typtabelle des Sammlers (`.rodata`) und der
// Zustandsblock (`.data`) — das Format steht in gc.rs (`typtabelle_asm`)
// und ist verbindlich, weil die Laufzeit es liest:
//   wort 0: n_typen;  eintrag(tid) = tabelle + 8 + (tid-1)*64
//   +0 groesse · +8 basis-tid · +16 n stark · +24 offsetliste ·
//   +32 n schwach · +40 offsetliste · +48 tid · +56 reserviert
fn gc_table(c: *mut Cg) {
    let g: *mut gc.Gc = gcg(c)
    var sec: [u8; 16] = ".section .rodata"
    t(c, (&sec[0]) as u64, 16)
    nl(c)
    var al: [u8; 8] = ".align 8"
    t(c, (&al[0]) as u64, 8)
    nl(c)
    var lab: [u8; 18] = ".L__gc_typtabelle:"
    t(c, (&lab[0]) as u64, 18)
    nl(c)
    ins(c)
    var q: [u8; 6] = ".quad "
    w(c, (&q[0]) as u64, 6)
    number(c, gc.gc_count(g) as u64)
    nl(c)
    var i: u32 = 0
    while i < gc.gc_count(g) as u32 {
        ins(c)
        w(c, (&q[0]) as u64, 6)
        number(c, gc.gc_size(g, i))
        nl(c)
        ins(c)
        w(c, (&q[0]) as u64, 6)
        number(c, gc.gc_base_tid(g, i))
        nl(c)
        ins(c)
        w(c, (&q[0]) as u64, 6)
        number(c, gc.gc_strong_count(g, i) as u64)
        nl(c)
        ins(c)
        w(c, (&q[0]) as u64, 6)
        var ls: [u8; 19] = ".L__gc_typtabelle.s"
        w(c, (&ls[0]) as u64, 19)
        number(c, gc.gc_tid(g, i))
        nl(c)
        ins(c)
        w(c, (&q[0]) as u64, 6)
        number(c, gc.gc_weak_count(g, i) as u64)
        nl(c)
        ins(c)
        w(c, (&q[0]) as u64, 6)
        var lw: [u8; 19] = ".L__gc_typtabelle.w"
        w(c, (&lw[0]) as u64, 19)
        number(c, gc.gc_tid(g, i))
        nl(c)
        ins(c)
        w(c, (&q[0]) as u64, 6)
        number(c, gc.gc_tid(g, i))
        nl(c)
        ins(c)
        w(c, (&q[0]) as u64, 6)
        number(c, 0)
        nl(c)
        i = i + 1
    }
    i = 0
    while i < gc.gc_count(g) as u32 {
        var ls2: [u8; 19] = ".L__gc_typtabelle.s"
        t(c, (&ls2[0]) as u64, 19)
        number(c, gc.gc_tid(g, i))
        var dp: [u8; 1] = ":"
        t(c, (&dp[0]) as u64, 1)
        nl(c)
        var j: u32 = 0
        while j < gc.gc_strong_count(g, i) {
            ins(c)
            w(c, (&q[0]) as u64, 6)
            number(c, gc.gc_strong_off(g, i, j))
            nl(c)
            j = j + 1
        }
        ins(c)
        w(c, (&q[0]) as u64, 6)
        number(c, 0)
        nl(c)
        var lw2: [u8; 19] = ".L__gc_typtabelle.w"
        t(c, (&lw2[0]) as u64, 19)
        number(c, gc.gc_tid(g, i))
        t(c, (&dp[0]) as u64, 1)
        nl(c)
        j = 0
        while j < gc.gc_weak_count(g, i) {
            ins(c)
            w(c, (&q[0]) as u64, 6)
            number(c, gc.gc_weak_off(g, i, j))
            nl(c)
            j = j + 1
        }
        ins(c)
        w(c, (&q[0]) as u64, 6)
        number(c, 0)
        nl(c)
        i = i + 1
    }
    // Zustandsblock: beschreibbar, wort 0 zeigt auf die Typtabelle.
    var sd: [u8; 14] = ".section .data"
    t(c, (&sd[0]) as u64, 14)
    nl(c)
    var a16: [u8; 9] = ".align 16"
    t(c, (&a16[0]) as u64, 9)
    nl(c)
    var zl: [u8; 15] = ".L__gc_zustand:"
    t(c, (&zl[0]) as u64, 15)
    nl(c)
    ins(c)
    w(c, (&q[0]) as u64, 6)
    var lt: [u8; 17] = ".L__gc_typtabelle"
    w(c, (&lt[0]) as u64, 17)
    nl(c)
    ins(c)
    var zz: [u8; 6] = ".zero "
    w(c, (&zz[0]) as u64, 6)
    number(c, 4088)
    nl(c)
    var st: [u8; 14] = ".section .text"
    t(c, (&st[0]) as u64, 14)
    nl(c)
}

fn emit_inst(c: *mut Cg, fnr: u32, i: u32) {
    let f: *mut fir.Fir = ff(c)
    let kind: u32 = fir.i_kind_of(f, i)
    let ty: u32 = fir.i_ty_of(f, i)
    let dst: u32 = fir.i_dst_of(f, i)
        if kind == fir.O_CONST {
        emit_const(c, ty, fir.i_number_of(f, i), dst)
        return
    }
        if kind == fir.O_BIN {
        emit_bin(c, ty, fir.i_c_of(f, i), fir.i_a_of(f, i), fir.i_b_of(f, i), dst)
        return
    }
    if kind == fir.O_CMP {
        emit_cmp(c, fir.i_number_of(f, i) as u32, fir.i_c_of(f, i), fir.i_a_of(f, i), fir.i_b_of(f, i), dst)
        return
    }
        if kind == fir.O_UN {
        emit_un(c, ty, fir.i_c_of(f, i), fir.i_a_of(f, i), dst)
        return
    }
        if kind == fir.O_CAST {
        emit_cast(c, fir.i_c_of(f, i), ty, fir.i_a_of(f, i), dst)
        return
    }
        if kind == fir.O_ALLOCA {
        emit_alloca(c, dst)
        return
    }
        if kind == fir.O_LOAD {
        emit_load(c, ty, fir.i_a_of(f, i), dst)
        return
    }
        if kind == fir.O_STORE {
        emit_store(c, ty, fir.i_a_of(f, i), fir.i_b_of(f, i))
        return
    }
        if kind == fir.O_PTRADD {
        emit_ptradd(c, fir.i_a_of(f, i), fir.i_b_of(f, i), dst)
        return
    }
        if kind == fir.O_CALL {
        emit_call(c, f, i, fnr)
        return
    }
        if kind == fir.O_SYSCALL {
        emit_syscall(c, f, i)
        return
    }
    if kind == fir.O_COPYMEM {
        emit_copymem(c, fir.i_a_of(f, i), fir.i_b_of(f, i), fir.i_number_of(f, i))
        return
    }
    if kind == fir.O_GCADDR {
        emit_gcaddr(c, fir.i_number_of(f, i), dst)
        return
    }
    if kind == fir.O_SELECT {
        emit_select(c, fir.i_a_of(f, i), fir.i_b_of(f, i), fir.i_c_of(f, i), dst)
        return
    }
    if kind == fir.O_SECZERO {
        emit_seczero(c, fir.i_a_of(f, i), fir.i_b_of(f, i))
        return
    }
    if kind == fir.O_ATOMADD {
        emit_atomadd(c, fir.i_a_of(f, i), fir.i_b_of(f, i), dst)
        return
    }
    if kind == fir.O_ATOMCAS {
        emit_atomcas(c, fir.i_a_of(f, i), fir.i_b_of(f, i), fir.i_c_of(f, i), dst)
        return
    }
    if kind == fir.O_SPAWN {
        emit_spawn(c, fir.i_a_of(f, i), fir.i_b_of(f, i), fir.i_c_of(f, i), dst)
        return
    }
    if kind == fir.O_TLS {
        emit_tls(c, dst)
        return
    }
    if kind == fir.O_CALLI {
        emit_calli(c, f, i, fnr)
        return
    }
    if kind == fir.O_VTAB {
        emit_vtab(c, fir.i_a_of(f, i), fir.i_b_of(f, i), dst)
        return
    }
    if kind == fir.O_ASM {
        emit_asm(c, f, i, dst)
        return
    }
    if kind == fir.O_MMIOLD {
        emit_mmio_load(c, ty, fir.i_a_of(f, i), dst)
        return
    }
    if kind == fir.O_MMIOST {
        emit_mmio_store(c, ty, fir.i_a_of(f, i), fir.i_b_of(f, i))
        return
    }
    (*c).unsuitable = true
}

fn emit_term(c: *mut Cg, fnr: u32, bb: u32) {
    let f: *mut fir.Fir = ff(c)
    let kind: u32 = fir.b_term_of(f, fnr, bb)
    if kind == fir.TERM_BR {
        ins(c)
        var j: [u8; 4] = "jmp "
        w(c, (&j[0]) as u64, 4)
        blocklabel(c, fir.f_name_of(f, fnr), fir.b_t1_of(f, fnr, bb))
        nl(c)
        return
    }
    if kind == fir.TERM_BRCOND {
        load_value(c, R_AX, fir.b_t1_of(f, fnr, bb))
        var tst: [u8; 11] = "test eax, 1"
        raw(c, (&tst[0]) as u64, 11)
        ins(c)
        var jn: [u8; 4] = "jne "
        w(c, (&jn[0]) as u64, 4)
        blocklabel(c, fir.f_name_of(f, fnr), fir.b_t2_of(f, fnr, bb))
        nl(c)
        ins(c)
        var jm: [u8; 4] = "jmp "
        w(c, (&jm[0]) as u64, 4)
        blocklabel(c, fir.f_name_of(f, fnr), fir.b_t3_of(f, fnr, bb))
        nl(c)
        return
    }
    if kind == fir.TERM_SWITCH {
        // VERGLEICHSKETTE, keine Sprungtabelle: `codegen_switch.rs` baut ab
        // acht dichten Marken eine Tabelle in `.rodata`; beide Verfahren sind
        // verhaltensgleich, und das Verhalten ist der Massstab dieser Stufe.
        // Der Wert liegt normalisiert als volle 64 Bit im Rahmen — ein
        // `cmp rax, <marke>` stimmt damit fuer jede Schluesselbreite.
        let val: u32 = fir.b_t1_of(f, fnr, bb)
        let def: u32 = fir.b_t2_of(f, fnr, bb)
        let off: u32 = fir.b_t3_of(f, fnr, bb)
        let len: u32 = fir.b_t4_of(f, fnr, bb)
        if len == 0 {
            ins(c)
            var j0: [u8; 4] = "jmp "
            w(c, (&j0[0]) as u64, 4)
            blocklabel(c, fir.f_name_of(f, fnr), def)
            nl(c)
            return
        }
        load_value(c, R_AX, val)
        var k: u32 = 0
        while k < len {
            ins(c)
            var cm: [u8; 9] = "cmp rax, "
            w(c, (&cm[0]) as u64, 9)
            inum(c, fir.sw_key_at(f, off + k))
            nl(c)
            ins(c)
            var je: [u8; 3] = "je "
            w(c, (&je[0]) as u64, 3)
            blocklabel(c, fir.f_name_of(f, fnr), fir.sw_target(f, off + k))
            nl(c)
            k = k + 1
        }
        ins(c)
        var j9: [u8; 4] = "jmp "
        w(c, (&j9[0]) as u64, 4)
        blocklabel(c, fir.f_name_of(f, fnr), def)
        nl(c)
        return
    }
    let v: u32 = fir.b_t1_of(f, fnr, bb)
    if v != fir.KEIN {
        load_value(c, R_AX, v)
    }
    var lv: [u8; 5] = "leave"
    raw(c, (&lv[0]) as u64, 5)
    // RUNDE 52: eine `#[interrupt]`-Funktion stellt erst alle Register her
    // und schliesst mit `iretq` ab — nur diese Instruktion setzt rflags, cs
    // und rsp des unterbrochenen Fadens zurueck.
    if fir.f_int_of(f, fnr) == 1 {
        int_register(c, true)
        var iq: [u8; 5] = "iretq"
        raw(c, (&iq[0]) as u64, 5)
        return
    }
    var rt2: [u8; 3] = "ret"
    raw(c, (&rt2[0]) as u64, 3)
}

// RUNDE 52: die Register, die eine `#[interrupt]`-Funktion rettet — alle
// Universalregister ausser `rsp` (der Prozessor) und `rbp` (der gewoehnliche
// Prolog). `rueck = true` kehrt die Reihenfolge um und schreibt `pop`.
fn int_register(c: *mut Cg, back: bool) {
    var tab: [u8; 53] = "rax|rcx|rdx|rbx|rsi|rdi|r8|r9|r10|r11|r12|r13|r14|r15"
    var k: u32 = 0
    while k < 14 {
        var nr: u32 = k
        if back {
            nr = 13 - k
        }
        ins(c)
        if back {
            var po: [u8; 4] = "pop "
            w(c, (&po[0]) as u64, 4)
        } else {
            var pu: [u8; 5] = "push "
            w(c, (&pu[0]) as u64, 5)
        }
        piece(c, (&tab[0]) as u64, 53, nr)
        nl(c)
        k = k + 1
    }
}

fn cg_run(c: *mut Cg) {
    let f: *mut fir.Fir = ff(c)
    var header: [u8; 29] = ".intel_syntax noprefix\n.text\n"
    t(c, (&header[0]) as u64, 29)
    if !(*c).free {
        var st: [u8; 91] = ".globl _start\n_start:\n    xor rbp, rbp\n    mov rdi, rsp\n    and rsp, -16\n    call _F1.main\n"
        t(c, (&st[0]) as u64, 91)
        var st2: [u8; 53] = "    mov edi, eax\n    mov eax, 60\n    syscall\n    hlt\n"
        t(c, (&st2[0]) as u64, 53)
    }

    var fi: u32 = 0
    while fi < fir.fn_count(f) as u32 {
        frame_build(c, fi)
        nl(c)
        var g: [u8; 7] = ".globl "
        t(c, (&g[0]) as u64, 7)
        sym(c, fir.f_name_of(f, fi))
        nl(c)
        sym(c, fir.f_name_of(f, fi))
        var dp: [u8; 1] = ":"
        t(c, (&dp[0]) as u64, 1)
        nl(c)
        if fir.f_int_of(f, fi) == 1 {
            var ik: [u8; 46] = "    # interrupt: alle universalregister retten"
            t(c, (&ik[0]) as u64, 46)
            nl(c)
            int_register(c, false)
        }
        var pr: [u8; 30] = "    push rbp\n    mov rbp, rsp\n"
        t(c, (&pr[0]) as u64, 30)
        if (*c).frame > 0 {
            ins(c)
            var sb: [u8; 9] = "sub rsp, "
            w(c, (&sb[0]) as u64, 9)
            number(c, (*c).frame)
            nl(c)
        }
        // Parameter aus den Argumentregistern in ihre Plaetze sichern.
        let plen: u32 = fir.f_plen_of(f, fi)
        var k: u32 = 0
        while k < plen {
            if k < 6 {
                ins(c)
                var m: [u8; 19] = "mov qword ptr [rbp-"
                w(c, (&m[0]) as u64, 19)
                number(c, slot_of(c, k))
                var s: [u8; 3] = "], "
                w(c, (&s[0]) as u64, 3)
                argreg(c, k)
                nl(c)
            } else {
                // Vom Stapel des Aufrufers: [rbp+16], [rbp+24], …
                ins(c)
                var m2: [u8; 24] = "mov rax, qword ptr [rbp+"
                w(c, (&m2[0]) as u64, 24)
                number(c, 16 + (k - 6) as u64 * 8)
                var e2: [u8; 1] = "]"
                w(c, (&e2[0]) as u64, 1)
                nl(c)
                store_slot(c, slot_of(c, k), R_AX)
            }
            k = k + 1
        }
        var bb: u32 = 0
        while bb < fir.block_count(f, fi) {
            blocklabel(c, fir.f_name_of(f, fi), bb)
            var dp2: [u8; 1] = ":"
            t(c, (&dp2[0]) as u64, 1)
            nl(c)
            var n: u32 = 0
            while n < fir.inst_count(f, fi, bb) {
                emit_inst(c, fi, fir.inst_at(f, fi, bb, n))
                if (*c).unsuitable {
                    return
                }
                n = n + 1
            }
            emit_term(c, fi, bb)
            bb = bb + 1
        }
        fi = fi + 1
    }
    // HOOK gc: Typtabelle (.rodata) und Zustandsblock (.data) des Sammlers —
    // nur, wenn das Programm ueberhaupt ein `gc class` enthaelt (gc.rs).
    if has_gc(c) {
        gc_table(c)
    }
    // HOOK iface: die Methodentafeln (.rodata) — nur, wenn das Programm
    // ueberhaupt eine Schnittstelle umsetzt (iface.rs, Runde 46).
    if has_if(c) {
        if_tables(c)
    }
    var gnu: [u8; 38] = ".section .note.GNU-stack,\"\",@progbits\n"
    t(c, (&gnu[0]) as u64, 38)
}
