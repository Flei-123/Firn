// lib/firnc1/err.fi — FEHLERUNIONEN `E!T`: DIE REGISTRIERUNG, IN FIRN.
//
// Dreizehnter Teil von Stufe 1: die Portierung des Datenmodells von
// `compiler/src/errors.rs`. Derselbe Aufbau wie `pattern.fi` (Runde 32): die
// Registrierung liegt AUSSERHALB des Baums, weil sie ueber alle Dateien
// einer Uebersetzung hinweg dieselbe sein muss (Fehlermengennamen gelten
// programmweit, SPEC §14.1) — und weil der Baum flach bleibt: `try x` und
// `x catch y` stehen im Baum als Aufruf `__try#` bzw. `__catch#`, genau wie
// Stufe 0 sie in `--emit=ast-kanon` druckt.
//
// SPEICHERLAYOUT (verbindlich, SPEC §5.1):
//   error IoError { NotFound, Permission, Closed }   // Codes 1, 2, 3
//   IoError      -> struct { __err: u32 }              (nur der Code)
//   IoError!i32  -> struct { __err: u32, __val: i32 }  (0 = Erfolg)
//
// Damit ist eine Fehlerunion ein GEWOEHNLICHER Struct im Typkontext;
// Aggregatrueckgabe und Codegen tragen sie unveraendert. Die Seitentabellen
// hier spielen dieselbe Rolle wie `enum_by_struct` in Stufe 0.
//
// DIE TYPANGABE `E!T` kennt der Parser noch nicht als Typ — er legt einen
// Platzhalter `__eu#<nummer>` in den Baum (das `#` kann nie in einem
// Bezeichner aus dem Quelltext stehen) und die Angabe selbst in `p_set`/
// `p_te`. Aufgeloest wird sie erst in `typen.aufloesen`, das ueber
// `fehler_platzhalter`/`fehler_typ` hierher rueckfragt — derselbe
// Uebergabepunkt wie `hook_resolve_ty` in Stufe 0.
//
// WAEHREND DER STRUCTPHASE (die Layouts der Baum-Structs stehen noch nicht
// fest) kann eine Union ueber einem Struct nicht ausgelegt werden; Stufe 0
// lehnt sie dort als Feldtyp ab. `fehler_structphase` meldet das Fenster,
// `fehler_typ` zaehlt den Fehler.

import rt
import vec
import intern
import ast
import types

export { Error, error_new, error_free, error_error,
         error_set_add, error_variant_add, error_set_find,
         error_set_count, error_pending_add, error_placeholder,
         error_ty, error_register, error_structphase,
         error_is_tryname, error_is_catchname, error_is_resultname,
         error_cb_set, error_cb,
         error_try_set, error_try,
         error_catch_set, error_catch,
         error_coerce_set, error_coerce_open, error_coerce_kind,
         error_busy_on, error_busy_zu,
         error_union_of_ty, error_set_of_ty,
         error_u_set, error_u_valty, error_u_voff, error_u_sidx,
         error_union_ty, error_set_ty, error_union_build, error_code_of,
         error_ctor_code, error_name_split,
         FEHLER_AUS_WERT, FEHLER_AUS_FEHLER }

const KEIN: u32 = 4294967295

// Umwandlungsarten (CoerceKind in errors.rs)
const FEHLER_AUS_WERT: u32 = 1    // `return wert` — Erfolg, __err = 0
const FEHLER_AUS_FEHLER: u32 = 2  // `return E::Variante` — Fehler, __err = code

struct Error {
    // Fehlermengen
    s_name: Vec[u32],
    s_sidx: Vec[u32],       // Structindex in typen.Typen
    s_voff: Vec[u32], s_vlen: Vec[u32],
    v_name: Vec[u32],       // Varianten aller Mengen, hintereinander

    // ausstehende `E!T`-Typangaben (zwischen Parser und Typaufloesung)
    p_set: Vec[u32],        // Mengenname (Nummer im Interner)
    p_te: Vec[u32],         // innerer Typknoten (Baum)

    // konkrete Fehlerunionen
    u_set: Vec[u32],        // Mengenindex
    u_sidx: Vec[u32],       // Structindex in typen.Typen
    u_valty: Vec[u32],      // aufgeloester Erfolgstyp
    u_voff: Vec[u64],       // Versatz von __val

    // je Ausdruck (die Listen wachsen auf Anfrage, 0 = nichts eingetragen)
    x_try: Vec[u32],        // Union + 1
    x_catch: Vec[u32],      // Union + 1
    x_cokind: Vec[u32],      // FEHLER_AUS_* oder 0
    x_couni: Vec[u32],      // Union
    x_busy: Vec[u32],       // 1 = die Umwandlung laeuft gerade (BUSY in Stufe 0)

    // `catch |e| ...`: Name der Bindung je catch-Ausdruck (spaerlich)
    cb_out: Vec[u32],
    cb_name: Vec[u32],

    scratch: rt.Buf,
    err: usize,
    in_structs: bool,       // die Structphase laeuft (hook_struct_phase)
}

fn error_new() -> Error {
    return Error{
        s_name: vec_new[u32](), s_sidx: vec_new[u32](),
        s_voff: vec_new[u32](), s_vlen: vec_new[u32](),
        v_name: vec_new[u32](),
        p_set: vec_new[u32](), p_te: vec_new[u32](),
        u_set: vec_new[u32](), u_sidx: vec_new[u32](),
        u_valty: vec_new[u32](), u_voff: vec_new[u64](),
        x_try: vec_new[u32](), x_catch: vec_new[u32](),
        x_cokind: vec_new[u32](), x_couni: vec_new[u32](), x_busy: vec_new[u32](),
        cb_out: vec_new[u32](), cb_name: vec_new[u32](),
        scratch: rt.buf_new(),
        err: 0, in_structs: false,
    }
}

fn error_free(f: *mut Error) {
    vec_free[u32](&(*f).s_name)
    vec_free[u32](&(*f).s_sidx)
    vec_free[u32](&(*f).s_voff)
    vec_free[u32](&(*f).s_vlen)
    vec_free[u32](&(*f).v_name)
    vec_free[u32](&(*f).p_set)
    vec_free[u32](&(*f).p_te)
    vec_free[u32](&(*f).u_set)
    vec_free[u32](&(*f).u_sidx)
    vec_free[u32](&(*f).u_valty)
    vec_free[u64](&(*f).u_voff)
    vec_free[u32](&(*f).x_try)
    vec_free[u32](&(*f).x_catch)
    vec_free[u32](&(*f).x_cokind)
    vec_free[u32](&(*f).x_couni)
    vec_free[u32](&(*f).x_busy)
    vec_free[u32](&(*f).cb_out)
    vec_free[u32](&(*f).cb_name)
    rt.buf_free(&(*f).scratch)
}

fn error_error(f: *mut Error) -> usize { return (*f).err }

// --------------------------------------------------------------- Mengen

fn error_set_find(f: *mut Error, name: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*f).s_name) {
        if vec_at[u32](&(*f).s_name, i) == name {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

fn error_set_count(f: *mut Error) -> usize { return vec_len[u32](&(*f).s_name) }

// Neue Fehlermenge. KEIN, wenn es den Namen schon gibt — der Aufrufer
// (Parser) meldet den Fehler, weil er ihn zu seiner eigenen Zaehlung geben
// will (Stufe 0: `errors_decl` meldet ueber die Parser-Diagnose).
fn error_set_add(f: *mut Error, name: u32) -> u32 {
    if error_set_find(f, name) != KEIN {
        return KEIN
    }
    let i: u32 = vec_len[u32](&(*f).s_name) as u32
    vec_push[u32](&(*f).s_name, name)
    vec_push[u32](&(*f).s_sidx, KEIN)
    vec_push[u32](&(*f).s_voff, vec_len[u32](&(*f).v_name) as u32)
    vec_push[u32](&(*f).s_vlen, 0)
    return i
}

// Neue Variante. false, wenn es sie in dieser Menge schon gibt.
fn error_variant_add(f: *mut Error, si: u32, name: u32) -> bool {
    let voff: u32 = vec_at[u32](&(*f).s_voff, si as usize)
    let vlen: u32 = vec_at[u32](&(*f).s_vlen, si as usize)
    var k: u32 = 0
    while k < vlen {
        if vec_at[u32](&(*f).v_name, (voff + k) as usize) == name {
            return false
        }
        k = k + 1
    }
    vec_push[u32](&(*f).v_name, name)
    vec_set[u32](&(*f).s_vlen, si as usize, vlen + 1)
    return true
}

// Code einer Variante (ab 1, Deklarationsreihenfolge), 0 wenn unbekannt.
// Exportierte Huelle fuer `gc.fi`/`lower.fi` (Runde 34: AllocError::OutOfMemory).
fn error_code_of(f: *mut Error, si: u32, name: u32) -> u32 {
    return variants_code(f, si, name)
}

fn variants_code(f: *mut Error, si: u32, name: u32) -> u32 {
    let voff: u32 = vec_at[u32](&(*f).s_voff, si as usize)
    let vlen: u32 = vec_at[u32](&(*f).s_vlen, si as usize)
    var k: u32 = 0
    while k < vlen {
        if vec_at[u32](&(*f).v_name, (voff + k) as usize) == name {
            return k + 1
        }
        k = k + 1
    }
    return 0
}

// ------------------------------------------------- ausstehende Typangaben

fn error_pending_add(f: *mut Error, set: u32, te: u32) -> u32 {
    let i: u32 = vec_len[u32](&(*f).p_set) as u32
    vec_push[u32](&(*f).p_set, set)
    vec_push[u32](&(*f).p_te, te)
    return i
}

// Ist `name` ein Platzhalter `__eu#<nummer>`? Liefert die Nummer, sonst -1.
fn error_placeholder(it: *mut intern.Interner, name: u32) -> i64 {
    let p: u64 = intern.intern_ptr(it, name)
    let n: usize = intern.intern_length(it, name)
    if n < 6 {
        return -1
    }
    var pfx: [u8; 5] = "__eu#"
    if !rt.mem_eq(p, (&pfx[0]) as u64, 5) {
        return -1
    }
    var v: i64 = 0
    var i: usize = 5
    while i < n {
        let z: u8 = rt.ld8(p, i)
        if z < 48 as u8 || z > 57 as u8 {
            return -1
        }
        v = v * 10 + (z - 48 as u8) as i64
        i = i + 1
    }
    return v
}

// Enthaelt der aufgeloeste Typ einen Struct DEM WERT NACH? (Zeiger
// unterbrechen — `contains_struct` in errors.rs.)
fn contains_struct(t: *mut types.Types, ty: u32) -> bool {
    let k: u32 = types.ty_kind(t, ty)
    if k == types.K_STRUCT {
        return true
    }
    if k == types.K_ARR {
        return contains_struct(t, types.ty_a(t, ty))
    }
    return false
}

// Union zu einem Structindex, oder KEIN (`union_by_struct` in Stufe 0).
fn error_union_at_struct(f: *mut Error, sidx: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*f).u_sidx) {
        if vec_at[u32](&(*f).u_sidx, i) == sidx {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// Menge zu einem Structindex, oder KEIN (`set_by_struct` in Stufe 0).
fn error_set_at_struct(f: *mut Error, sidx: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*f).s_sidx) {
        if vec_at[u32](&(*f).s_sidx, i) == sidx {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// Fehlerunion zu einem aufgeloesten Typ (`union_of` in Stufe 0).
fn error_union_of_ty(f: *mut Error, t: *mut types.Types, ty: u32) -> u32 {
    if types.ty_kind(t, ty) != types.K_STRUCT {
        return KEIN
    }
    return error_union_at_struct(f, types.ty_a(t, ty))
}

// Fehlermenge zu einem aufgeloesten Typ (`set_name_of` in Stufe 0).
fn error_set_of_ty(f: *mut Error, t: *mut types.Types, ty: u32) -> u32 {
    if types.ty_kind(t, ty) != types.K_STRUCT {
        return KEIN
    }
    return error_set_at_struct(f, types.ty_a(t, ty))
}

// Legt die Union `sm!val_ty` als Struct im Typkontext an — oder findet sie
// wieder. Der Name ist `<menge>!<name des erfolgstyps>`, genau die Form aus
// `TypeCtx::name_of`; weil `!` nie in einem Quelltext-Bezeichner steht,
// kollidiert er mit nichts. (`get_or_create_union` in errors.rs.)
fn error_union_build(f: *mut Error, t: *mut types.Types,
                      it: *mut intern.Interner, sm: u32, val_ty: u32) -> u32 {
    rt.buf_clear(&(*f).scratch)
    let sn: u32 = vec_at[u32](&(*f).s_name, sm as usize)
    rt.buf_push_bytes(&(*f).scratch, intern.intern_ptr(it, sn),
                      intern.intern_length(it, sn))
    rt.buf_push(&(*f).scratch, 33 as u8)
    types.name_of(t, it, &(*f).scratch, val_ty)
    let nr: u32 = intern.intern_number(it, rt.buf_ptr(&(*f).scratch),
                                       rt.buf_len(&(*f).scratch)) as u32
    let present: i32 = types.struct_index(t, nr)
    if present >= 0 {
        return types.new_ty(t, types.K_STRUCT, present as u32, 0)
    }
    let idx: u32 = types.types_struct_append(t, nr)
    // Das Layout ist das eines gewoehnlichen Structs: __err @ 0 (u32), __val
    // dahinter mit natuerlicher Ausrichtung; die Ausrichtung des Ganzen ist
    // mindestens 4 (die des Codes).
    var va: u64 = types.alignment_of(t, val_ty)
    if va < 1 { va = 1 }
    let voff: u64 = types.round_up(4, va)
    var align: u64 = va
    if align < 4 { align = 4 }
    let size: u64 = types.round_up(voff + types.size_of(t, val_ty), align)
    var names: Vec[u32] = vec_new[u32]()
    var types_v: Vec[u32] = vec_new[u32]()
    var ver: Vec[u64] = vec_new[u64]()
    var en: [u8; 5] = "__err"
    var vn: [u8; 5] = "__val"
    vec_push[u32](&names, intern.intern_number(it, (&en[0]) as u64, 5) as u32)
    vec_push[u32](&types_v, types.new_ty(t, types.K_U32, 0, 0))
    vec_push[u64](&ver, 0)
    vec_push[u32](&names, intern.intern_number(it, (&vn[0]) as u64, 5) as u32)
    vec_push[u32](&types_v, val_ty)
    vec_push[u64](&ver, voff)
    types.types_struct_define(t, idx, size, align, &names, &types_v, &ver)
    vec_free[u32](&names)
    vec_free[u32](&types_v)
    vec_free[u64](&ver)
    vec_push[u32](&(*f).u_set, sm)
    vec_push[u32](&(*f).u_sidx, idx)
    vec_push[u32](&(*f).u_valty, val_ty)
    vec_push[u64](&(*f).u_voff, voff)
    return types.new_ty(t, types.K_STRUCT, idx, 0)
}

// HOOK in `typen.aufloesen`: loest eine Platzhalter-Typangabe `E!T` auf
// (`hook_resolve_ty` in errors.rs). Fehler werden hier gezaehlt; `sema`
// uebernimmt sie in seine eigene Zaehlung.
fn error_ty(feh: u64, t: *mut types.Types, b: *mut ast.Tree,
              it: *mut intern.Interner, pi: u32) -> u32 {
    let f: *mut Error = feh as *mut Error
    let set: u32 = vec_at[u32](&(*f).p_set, pi as usize)
    let te: u32 = vec_at[u32](&(*f).p_te, pi as usize)
    let sm: u32 = error_set_find(f, set)
    if sm == KEIN {
        // unbekannte fehlermenge
        (*f).err = (*f).err + 1
        return types.new_ty(t, types.K_FEHLER, 0, 0)
    }
    let val_ty: u32 = types.resolve(t, b, it, te)
    if types.ty_kind(t, val_ty) == types.K_FEHLER {
        return val_ty
    }
    if types.ty_kind(t, val_ty) == types.K_VOID {
        // der erfolgstyp einer fehlerunion kann nicht '()' sein
        (*f).err = (*f).err + 1
        return types.new_ty(t, types.K_FEHLER, 0, 0)
    }
    if (*f).in_structs && contains_struct(t, val_ty) {
        // Waehrend der Structphase stehen die Struct-Layouts noch nicht
        // fest — ein klarer Fehler statt eines stillen Fehl-Layouts
        // (SPEC §14.1.fehlerunionen F10).
        (*f).err = (*f).err + 1
        return types.new_ty(t, types.K_FEHLER, 0, 0)
    }
    return error_union_build(f, t, it, sm, val_ty)
}

// Meldet jede Fehlermenge als Struct `{ __err: u32 }` an
// (`declare_error_sets` in errors.rs). Muss VOR `typen.typen_aufloesen`
// laufen, NACH `muster.mus_anmelden` — dieselbe Reihenfolge wie Stufe 0
// (`declare_enums`, dann `declare_error_sets`, dann `collect_structs`).
fn error_register(feh: u64, t: *mut types.Types, it: *mut intern.Interner) {
    let f: *mut Error = feh as *mut Error
    var en: [u8; 5] = "__err"
    let enr: u32 = intern.intern_number(it, (&en[0]) as u64, 5) as u32
    let t_u32: u32 = types.new_ty(t, types.K_U32, 0, 0)
    var i: usize = 0
    while i < vec_len[u32](&(*f).s_name) {
        let name: u32 = vec_at[u32](&(*f).s_name, i)
        if types.struct_index(t, name) >= 0 {
            // typ ist bereits deklariert
            (*f).err = (*f).err + 1
        }
        let idx: u32 = types.types_struct_reserve(t, name)
        vec_set[u32](&(*f).s_sidx, i, idx)
        var names: Vec[u32] = vec_new[u32]()
        var types_v: Vec[u32] = vec_new[u32]()
        var ver: Vec[u64] = vec_new[u64]()
        vec_push[u32](&names, enr)
        vec_push[u32](&types_v, t_u32)
        vec_push[u64](&ver, 0)
        types.types_struct_define(t, idx, 4, 4, &names, &types_v, &ver)
        vec_free[u32](&names)
        vec_free[u32](&types_v)
        vec_free[u64](&ver)
        i = i + 1
    }
}

// Meldet den Beginn/das Ende der Structphase (`hook_struct_phase`).
fn error_structphase(feh: u64, active: bool) {
    let f: *mut Error = feh as *mut Error
    (*f).in_structs = active
}

// ------------------------------------------------------ Namen der Aufrufe

fn has_prefix(it: *mut intern.Interner, name: u32, pfx: *mut u8, n: usize) -> bool {
    if intern.intern_length(it, name) != n {
        return false
    }
    return rt.mem_eq(intern.intern_ptr(it, name), pfx as u64, n)
}

// `__try#` — der interne Name eines `try`-Ausdrucks (TRY_NAME in errors.rs).
fn error_is_tryname(it: *mut intern.Interner, name: u32) -> bool {
    var pfx: [u8; 6] = "__try#"
    return has_prefix(it, name, &pfx[0], 6)
}

// `__catch#` — der interne Name eines `catch`-Ausdrucks (CATCH_NAME).
fn error_is_catchname(it: *mut intern.Interner, name: u32) -> bool {
    var pfx: [u8; 8] = "__catch#"
    return has_prefix(it, name, &pfx[0], 8)
}

fn error_is_resultname(it: *mut intern.Interner, name: u32) -> bool {
    return error_is_tryname(it, name) || error_is_catchname(it, name)
}

// Teilt `Menge::Variante` an der ERSTEN Doppelpunktsstelle. `en`/`vn` sind
// Nummern im Interner; KEIN, wenn es keinen Doppelpunkt gibt.
fn error_name_split(feh: u64, it: *mut intern.Interner, name: u32,
                      en: *mut u32, vn: *mut u32) {
    let p: u64 = intern.intern_ptr(it, name)
    let n: usize = intern.intern_length(it, name)
    var i: usize = 0
    while i + 1 < n {
        if rt.ld8(p, i) == 58 as u8 && rt.ld8(p, i + 1) == 58 as u8 {
            *en = intern.intern_number(it, p, i) as u32
            *vn = intern.intern_number(it, p + (i + 2) as u64, n - i - 2) as u32
            return
        }
        i = i + 1
    }
    *en = KEIN
    *vn = KEIN
}

// Code von `Menge::Variante` (ab 1); -1, wenn das kein Fehlerwert ist.
fn error_ctor_code(feh: u64, it: *mut intern.Interner, name: u32) -> i64 {
    let f: *mut Error = feh as *mut Error
    var en: u32 = KEIN
    var vn: u32 = KEIN
    error_name_split(feh, it, name, &en, &vn)
    if en == KEIN {
        return -1
    }
    let sm: u32 = error_set_find(f, en)
    if sm == KEIN {
        return -1
    }
    let c: u32 = variants_code(f, sm, vn)
    if c == 0 {
        return -1
    }
    return c as i64
}

// ------------------------------------------------------ je Ausdruck

// Laesst die Ausdruckslisten bis einschliesslich `e` wachsen.
fn slot(f: *mut Error, e: u32) {
    while vec_len[u32](&(*f).x_try) <= e as usize {
        vec_push[u32](&(*f).x_try, 0)
        vec_push[u32](&(*f).x_catch, 0)
        vec_push[u32](&(*f).x_cokind, 0)
        vec_push[u32](&(*f).x_couni, 0)
        vec_push[u32](&(*f).x_busy, 0)
    }
}

fn error_try_set(f: *mut Error, e: u32, u: u32) {
    slot(f, e)
    vec_set[u32](&(*f).x_try, e as usize, u + 1)
}

// Die Union des `try`-Ausdrucks e, oder KEIN (`try_of` in errors.rs).
fn error_try(f: *mut Error, e: u32) -> u32 {
    if e as usize >= vec_len[u32](&(*f).x_try) {
        return KEIN
    }
    let v: u32 = vec_at[u32](&(*f).x_try, e as usize)
    if v == 0 {
        return KEIN
    }
    return v - 1
}

fn error_catch_set(f: *mut Error, e: u32, u: u32) {
    slot(f, e)
    vec_set[u32](&(*f).x_catch, e as usize, u + 1)
}

fn error_catch(f: *mut Error, e: u32) -> u32 {
    if e as usize >= vec_len[u32](&(*f).x_catch) {
        return KEIN
    }
    let v: u32 = vec_at[u32](&(*f).x_catch, e as usize)
    if v == 0 {
        return KEIN
    }
    return v - 1
}

fn error_coerce_set(f: *mut Error, e: u32, kind: u32, u: u32) {
    slot(f, e)
    vec_set[u32](&(*f).x_cokind, e as usize, kind)
    vec_set[u32](&(*f).x_couni, e as usize, u)
}

// Die an einem Ausdruck vorgemerkte Umwandlung, sofern sie nicht gerade
// selbst erzeugt wird (`pending_coerce` mit BUSY in lower_errors.rs).
fn error_coerce_open(f: *mut Error, e: u32) -> u32 {
    if e as usize >= vec_len[u32](&(*f).x_cokind) {
        return KEIN
    }
    if vec_at[u32](&(*f).x_cokind, e as usize) == 0 {
        return KEIN
    }
    if vec_at[u32](&(*f).x_busy, e as usize) != 0 {
        return KEIN
    }
    return vec_at[u32](&(*f).x_couni, e as usize)
}

fn error_coerce_kind(f: *mut Error, e: u32) -> u32 {
    if e as usize >= vec_len[u32](&(*f).x_cokind) {
        return 0
    }
    return vec_at[u32](&(*f).x_cokind, e as usize)
}

fn error_busy_on(f: *mut Error, e: u32) {
    slot(f, e)
    vec_set[u32](&(*f).x_busy, e as usize, 1)
}

fn error_busy_zu(f: *mut Error, e: u32) {
    slot(f, e)
    vec_set[u32](&(*f).x_busy, e as usize, 0)
}

// `catch |e| ...`: Name der Bindung je Ausdruck (`catch_bind` in errors.rs).
fn error_cb_set(f: *mut Error, e: u32, name: u32) {
    vec_push[u32](&(*f).cb_out, e)
    vec_push[u32](&(*f).cb_name, name)
}

fn error_cb(f: *mut Error, e: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*f).cb_out) {
        if vec_at[u32](&(*f).cb_out, i) == e {
            return vec_at[u32](&(*f).cb_name, i)
        }
        i = i + 1
    }
    return KEIN
}

// ------------------------------------------------------------- Union lesen

fn error_u_set(f: *mut Error, u: u32) -> u32 { return vec_at[u32](&(*f).u_set, u as usize) }
fn error_u_sidx(f: *mut Error, u: u32) -> u32 { return vec_at[u32](&(*f).u_sidx, u as usize) }
fn error_u_valty(f: *mut Error, u: u32) -> u32 { return vec_at[u32](&(*f).u_valty, u as usize) }
fn error_u_voff(f: *mut Error, u: u32) -> u64 { return vec_at[u64](&(*f).u_voff, u as usize) }

// Aufgeloester Typ einer Union bzw. einer Menge (frischer Eintrag in der
// Typtafel — verglichen wird strukturell, `typ_gleich`).
fn error_union_ty(f: *mut Error, t: *mut types.Types, u: u32) -> u32 {
    return types.new_ty(t, types.K_STRUCT, error_u_sidx(f, u), 0)
}

fn error_set_ty(f: *mut Error, t: *mut types.Types, sm: u32) -> u32 {
    return types.new_ty(t, types.K_STRUCT,
                           vec_at[u32](&(*f).s_sidx, sm as usize), 0)
}
