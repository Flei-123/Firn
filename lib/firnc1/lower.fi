// lib/firnc1/lower.fi — VOM GEPRUEFTEN BAUM ZUR FIR, IN FIRN.
//
// Achter Teil von Stufe 1: die Portierung von `compiler/src/lower.rs`.
//
// UMFANG: der skalare Kern, die Aggregate UND `defer`/`errdefer`.
//
// AUFGESCHOBENE ANWEISUNGEN (SPEC §5.1) sind ein Stapel je BLOCKEBENE. Beim
// Verlassen eines Blocks laufen seine eigenen rueckwaerts; bei `return`
// laufen ALLE Ebenen der Funktion, bei `break`/`continue` nur die, die
// INNERHALB der Schleife vereinbart wurden. `errdefer` laeuft ausschliesslich
// auf dem FEHLERPFAD (`return E::Variante`, `try`) — seit Runde 36 ueber
// `defer_bis_fehler` (`ret_term_fehler` in Stufe 0, SPEC §5.1).
//
// AGGREGATE BEWEGEN SICH NIE ALS WERT, sondern immer ueber ADRESSEN. Es gibt
// genau zwei Wege: `schreib_nach(adr, e)` legt einen Ausdruck an einer Adresse
// ab, `adresse(e)` besorgt die Adresse eines vorhandenen Aggregats. Ein
// Struct-Literal wird feldweise geschrieben, ein fremdes Aggregat mit
// `copymem` kopiert.
//
// AN DER FUNKTIONSGRENZE entscheidet `abi` (SPEC §13, §14.1):
//   bis 16 Byte   -> ein oder zwei GANZZAHLWOERTER
//   darueber      -> ein versteckter Zeiger auf eine Kopie des Aufrufers
//   Rueckgabe > 8 -> versteckter Zeiger in `rdi` (`sret`)
//
// ZWEI DINGE, DIE MAN NICHT RATEN KANN und die deshalb genau nachgebaut sind:
//
//  1. Die WERTNUMMERN folgen der Reihenfolge des ANLEGENS, die gedruckte
//     Reihenfolge aber nicht: jede `alloca` wandert an den Anfang des
//     Eintrittsblocks. `%0 = alloca` und `%2 = alloca` koennen deshalb
//     untereinander stehen, obwohl `%1` dazwischen entstanden ist.
//  2. Nach `return`, `break` und `continue` wird ein NEUER, unerreichbarer
//     Block geoeffnet. Er bleibt im Text stehen (bb7, bb8 …) — die
//     Codebereinigung entfernt ihn erst spaeter. Wer ihn weglaesst, bekommt
//     einen anderen Text.

import rt
import vec
import intern
import ast
import types
import sema
import fir
import pattern
import err
import gc
import iface
import core

export { Lower, low_new, low_free, low_run, low_error, low_fir, low_unsuitable,
         low_mu_set, low_fe_set, low_gc_set, low_if_set }

const KEIN: u32 = 4294967295

struct Lower {
    b: u64              // Baum
    it: u64             // Interner
    sm: u64             // Sema
    f: fir.Fir
    fi: u32             // laufende Funktion
    cur: u32            // laufender Block
    v_name: Vec[u32]    // Bereiche: Name -> Platz
    v_slot: Vec[u32]
    b_limit: Vec[u32]
    l_break: Vec[u32]   // Schleifenziele
    l_cont: Vec[u32]
    l_depth: Vec[u32]   // Stapeltiefe der aufgeschobenen Anweisungen je Schleife
    d_stmt: Vec[u32]    // aufgeschobene Anweisungen, in Reihenfolge der Vereinbarung
    d_err: Vec[u32]     // 1 = `errdefer`
    d_limit: Vec[u32]  // Grenzen je Blockebene
    sret: u32
    mu: u64             // Register der Aufzaehlungen/Musterabgleiche (0 = keins)
    feh: u64            // Register der Fehlermengen/-unionen (0 = keins)
    gcr: u64            // Registrierung der gc-Klassen (Runde 34; 0 = keine)
    ifr: u64            // Registrierung der Schnittstellen (Runde 46; 0 = keine)
    err: usize
    unsuitable: bool    // Aggregat oder `defer` gefunden
}

fn low_new(b: u64, it: u64, sm: u64) -> Lower {
    return Lower{
        b: b, it: it, sm: sm,
        f: fir.fir_new(),
        fi: 0, cur: 0,
        v_name: vec_new[u32](), v_slot: vec_new[u32](), b_limit: vec_new[u32](),
        l_break: vec_new[u32](), l_cont: vec_new[u32](), l_depth: vec_new[u32](),
        d_stmt: vec_new[u32](), d_err: vec_new[u32](), d_limit: vec_new[u32](),
        sret: KEIN, mu: 0, feh: 0, gcr: 0, ifr: 0, err: 0, unsuitable: false,
    }
}

fn low_free(l: *mut Lower) {
    fir.fir_free(&(*l).f)
    vec_free[u32](&(*l).v_name)
    vec_free[u32](&(*l).v_slot)
    vec_free[u32](&(*l).b_limit)
    vec_free[u32](&(*l).l_break)
    vec_free[u32](&(*l).l_cont)
    vec_free[u32](&(*l).l_depth)
    vec_free[u32](&(*l).d_stmt)
    vec_free[u32](&(*l).d_err)
    vec_free[u32](&(*l).d_limit)
}

fn low_error(l: *mut Lower) -> usize { return (*l).err }

// Das Muster-Register anmelden. MUSS vor `low_lauf` stehen.
fn low_mu_set(l: *mut Lower, m: u64) { (*l).mu = m }

fn mul(l: *mut Lower) -> *mut pattern.Pat { return (*l).mu as *mut pattern.Pat }
fn has_mu(l: *mut Lower) -> bool { return (*l).mu != 0 }

// Das Fehler-Register anmelden. MUSS vor `low_lauf` stehen.
fn low_fe_set(l: *mut Lower, f: u64) { (*l).feh = f }

// Die gc-Registrierung anmelden (Runde 34). MUSS vor `low_lauf` stehen.
fn low_gc_set(l: *mut Lower, g: u64) { (*l).gcr = g }

// Die Schnittstellen-Registrierung anmelden (Runde 46). MUSS vor
// `low_lauf` stehen.
fn low_if_set(l: *mut Lower, f: u64) { (*l).ifr = f }

fn fel(l: *mut Lower) -> *mut err.Error { return (*l).feh as *mut err.Error }
fn has_fe(l: *mut Lower) -> bool { return (*l).feh != 0 }
fn gcl(l: *mut Lower) -> *mut gc.Gc { return (*l).gcr as *mut gc.Gc }
fn has_gc(l: *mut Lower) -> bool { return (*l).gcr != 0 }
fn ifl(l: *mut Lower) -> *mut iface.If { return (*l).ifr as *mut iface.If }
fn has_if(l: *mut Lower) -> bool { return (*l).ifr != 0 }
fn low_unsuitable(l: *mut Lower) -> bool { return (*l).unsuitable }
fn low_fir(l: *mut Lower) -> *mut fir.Fir { return &(*l).f }

fn tree(l: *mut Lower) -> *mut ast.Tree { return (*l).b as *mut ast.Tree }
fn sm(l: *mut Lower) -> *mut sema.Sema { return (*l).sm as *mut sema.Sema }
fn tf(l: *mut Lower) -> *mut types.Types { return sema.sema_types(sm(l)) }
fn names(l: *mut Lower) -> *mut intern.Interner { return (*l).it as *mut intern.Interner }

fn give_up(l: *mut Lower) {
    (*l).unsuitable = true
}

// ------------------------------------------------- Typen: Quelle -> FIR

fn is_aggregate(l: *mut Lower, t: u32) -> bool {
    let k: u32 = types.ty_kind(tf(l), t)
    return k == types.K_ARR || k == types.K_STRUCT
}

// FIR-Typ eines skalaren Quelltyps; fir.KEIN bei einem Aggregat.
fn fty(l: *mut Lower, t: u32) -> u32 {
    let k: u32 = types.ty_kind(tf(l), t)
    if k == types.K_I8 { return fir.T_I8 }
    if k == types.K_I16 { return fir.T_I16 }
    if k == types.K_I32 { return fir.T_I32 }
    if k == types.K_I64 { return fir.T_I64 }
    if k == types.K_ISIZE { return fir.T_I64 }
    if k == types.K_U8 { return fir.T_U8 }
    if k == types.K_U16 { return fir.T_U16 }
    if k == types.K_U32 { return fir.T_U32 }
    if k == types.K_U64 { return fir.T_U64 }
    if k == types.K_USIZE { return fir.T_U64 }
    if k == types.K_BOOL { return fir.T_BOOL }
    if k == types.K_F64 { return fir.T_F64 }
    if k == types.K_PTR { return fir.T_PTR }
    if k == types.K_VOID { return fir.T_VOID }
    return fir.KEIN
}

fn e_fty(l: *mut Lower, e: u32) -> u32 {
    return fty(l, sema.sema_ty(sm(l), e))
}

// ------------------------------------------------------------- Bausteine

fn push(l: *mut Lower, kind: u32, ty: u32, a: u32, b: u32, c: u32, z: u64, aoff: u32, alen: u32) -> u32 {
    return fir.inst_add(&(*l).f, (*l).fi, (*l).cur, kind, ty, a, b, c, z, aoff, alen)
}

fn push_void(l: *mut Lower, kind: u32, ty: u32, a: u32, b: u32, c: u32, z: u64, aoff: u32, alen: u32) {
    fir.inst_void_add(&(*l).f, (*l).fi, (*l).cur, kind, ty, a, b, c, z, aoff, alen)
}

fn constant(l: *mut Lower, ty: u32, v: u64) -> u32 {
    return push(l, fir.O_CONST, ty, 0, 0, 0, v, 0, 0)
}

fn load(l: *mut Lower, ty: u32, addr: u32) -> u32 {
    return push(l, fir.O_LOAD, ty, addr, 0, 0, 0, 0, 0)
}

fn store(l: *mut Lower, ty: u32, addr: u32, value: u32) {
    push_void(l, fir.O_STORE, ty, addr, value, 0, 0, 0, 0)
}

fn alloca(l: *mut Lower, size: u64, align: u64) -> u32 {
    return fir.alloca_add(&(*l).f, (*l).fi, size, align)
}

fn new_block(l: *mut Lower) -> u32 {
    return fir.block_new(&(*l).f, (*l).fi)
}

fn term(l: *mut Lower, kind: u32, t1: u32, t2: u32, t3: u32) {
    fir.term_set(&(*l).f, (*l).fi, (*l).cur, kind, t1, t2, t3)
}

fn terminated(l: *mut Lower) -> bool {
    return fir.is_terminated(&(*l).f, (*l).fi, (*l).cur)
}

// ------------------------------------------------------------- Bereiche

fn range_on(l: *mut Lower) {
    vec_push[u32](&(*l).b_limit, vec_len[u32](&(*l).v_name) as u32)
}

fn range_zu(l: *mut Lower) {
    let g: u32 = vec_last[u32](&(*l).b_limit)
    vec_pop[u32](&(*l).b_limit)
    while vec_len[u32](&(*l).v_name) > g as usize {
        vec_pop[u32](&(*l).v_name)
        vec_pop[u32](&(*l).v_slot)
    }
}

fn create(l: *mut Lower, name: u32, slot: u32) {
    vec_push[u32](&(*l).v_name, name)
    vec_push[u32](&(*l).v_slot, slot)
}

// ------------------------------------------- Aufgeschobene Anweisungen

fn defer_level_on(l: *mut Lower) {
    vec_push[u32](&(*l).d_limit, vec_len[u32](&(*l).d_stmt) as u32)
}

// Fuehrt die eigenen aufgeschobenen Anweisungen dieser Ebene aus (rueckwaerts)
// und raeumt die Ebene ab.
fn defer_level_zu(l: *mut Lower) {
    let g: u32 = vec_last[u32](&(*l).d_limit)
    vec_pop[u32](&(*l).d_limit)
    var i: usize = vec_len[u32](&(*l).d_stmt)
    while i > g as usize {
        i = i - 1
        // `errdefer` laeuft NICHT beim gewoehnlichen Verlassen.
        if vec_at[u32](&(*l).d_err, i) == 0 {
            stmt(l, vec_at[u32](&(*l).d_stmt, i))
        }
    }
    while vec_len[u32](&(*l).d_stmt) > g as usize {
        vec_pop[u32](&(*l).d_stmt)
        vec_pop[u32](&(*l).d_err)
    }
}

// Fuehrt alle aufgeschobenen Anweisungen OBERHALB von `tiefe` aus — innerste
// Ebene zuerst, innerhalb einer Ebene rueckwaerts. Der Stapel bleibt dabei
// UNVERAENDERT: `defer_ebene_zu` raeumt seine eigene Ebene ab. Was danach
// noch erzeugt wird, landet im unerreichbaren Block hinter dem Sprung.
fn defer_to_mf(l: *mut Lower, depth: u32, with_error: bool) {
    var e: usize = vec_len[u32](&(*l).d_limit)
    var end: usize = vec_len[u32](&(*l).d_stmt)
    while e > depth as usize {
        e = e - 1
        let g: u32 = vec_at[u32](&(*l).d_limit, e)
        var i: usize = end
        while i > g as usize {
            i = i - 1
            // `errdefer` laeuft NUR auf dem Fehlerpfad (SPEC §5.1) —
            // `lower_defers_bis(tiefe, mit_fehler)` in Stufe 0.
            if vec_at[u32](&(*l).d_err, i) == 0 || with_error {
                stmt(l, vec_at[u32](&(*l).d_stmt, i))
            }
        }
        end = g as usize
    }
}

fn defer_to(l: *mut Lower, depth: u32) {
    defer_to_mf(l, depth, false)
}

// Ruecksprung auf dem FEHLERPFAD: zusaetzlich laufen die `errdefer`-
// Anweisungen (`ret_term_fehler`, Runde 36).
fn defer_to_error(l: *mut Lower) {
    defer_to_mf(l, 0, true)
}

// Gibt es in dieser Funktion ein aktives `errdefer`? (`hat_errdefer`)
fn has_errdefer(l: *mut Lower) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*l).d_err) {
        if vec_at[u32](&(*l).d_err, i) == 1 {
            return true
        }
        i = i + 1
    }
    return false
}

fn search(l: *mut Lower, name: u32) -> u32 {
    var i: usize = vec_len[u32](&(*l).v_name)
    while i > 0 {
        i = i - 1
        if vec_at[u32](&(*l).v_name, i) == name {
            return vec_at[u32](&(*l).v_slot, i)
        }
    }
    return KEIN
}

// --------------------------------------------------------------- Adressen

// Adresse eines zuweisbaren Ausdrucks.
fn address(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(l)
    let a: u32 = ast.e_kind(b, e)
    // HOOK fehlerunionen (lower_errors.rs::hook_addr): ein Ausdruck mit
    // vorgemerkter Umwandlung liegt als fertige Union im Speicher.
    if has_fe(l) {
        let cu: u32 = err.error_coerce_open(fel(l), e)
        if cu != KEIN {
            let us: usize = err.error_u_sidx(fel(l), cu) as usize
            var g: u64 = types.st_size(tf(l), us)
            if g < 1 { g = 1 }
            var al: u64 = types.st_alignment(tf(l), us)
            if al < 1 { al = 1 }
            let slot: u32 = alloca(l, g, al)
            union_write(l, slot, e, cu)
            return slot
        }
    }
    if a == ast.E_ID {
        let slot: u32 = search(l, ast.e_a(b, e))
        if slot != KEIN {
            return slot
        }
        give_up(l)
        return 0
    }
    if a == ast.E_UN && ast.e_a(b, e) == 3 {
        return value(l, ast.e_b(b, e))
    }
    if a == ast.E_FELD {
        let bt: u32 = sema.sema_ty(sm(l), ast.e_a(b, e))
        var si: usize = 0
        var base: u32 = 0
        if types.ty_kind(tf(l), bt) == types.K_STRUCT {
            si = types.ty_a(tf(l), bt) as usize
            base = address(l, ast.e_a(b, e))
        } else if types.ty_kind(tf(l), bt) == types.K_PTR {
            // `p.f` auf einem Zeiger auf Struct: automatisch dereferenzieren.
            let inner: u32 = types.ty_a(tf(l), bt)
            if types.ty_kind(tf(l), inner) != types.K_STRUCT {
                give_up(l)
                return 0
            }
            si = types.ty_a(tf(l), inner) as usize
            base = value(l, ast.e_a(b, e))
        } else {
            give_up(l)
            return 0
        }
        return ptradd_const(l, base, field_offset(l, si, ast.e_b(b, e)))
    }
    if a == ast.E_IDX {
        let bt: u32 = sema.sema_ty(sm(l), ast.e_a(b, e))
        var elem: u32 = 0
        var base: u32 = 0
        if types.ty_kind(tf(l), bt) == types.K_ARR {
            elem = types.ty_a(tf(l), bt)
            base = address(l, ast.e_a(b, e))
        } else if types.ty_kind(tf(l), bt) == types.K_PTR {
            elem = types.ty_a(tf(l), bt)
            base = value(l, ast.e_a(b, e))
        } else {
            give_up(l)
            return 0
        }
        let gr: u64 = q_size(l, elem)
        let ift: u32 = e_fty(l, ast.e_b(b, e))
        let iv: u32 = value(l, ast.e_b(b, e))
        return elem_address(l, base, iv, ift, gr)
    }
    if a == ast.E_SLIT || a == ast.E_ALIT || a == ast.E_AWDH {
        let t: u32 = sema.sema_ty(sm(l), e)
        let slot: u32 = alloca(l, q_size(l, t), q_align(l, t))
        write_after(l, slot, e)
        return slot
    }
    // HOOK iface: `((&x) as dyn I).m()` — der Schnittstellenwert bekommt
    // einen Zwischenplatz, dessen Adresse hier steht (iface.fi).
    if a == ast.E_AS {
        let t2: u32 = sema.sema_ty(sm(l), e)
        if is_dyn_ty(l, t2) {
            let slot2: u32 = alloca(l, q_size(l, t2), q_align(l, t2))
            write_after(l, slot2, e)
            return slot2
        }
    }
    if a == ast.E_RUF {
        // HOOK fehlerunionen (lower_errors.rs::hook_addr): `try`, `catch`
        // und der reine Fehlerwert legen ihren Platz selbst an.
        if has_fe(l) && ast.e_number(b, e) == 0 {
            let nm: u32 = ast.e_a(b, e)
            if err.error_is_tryname(names(l), nm) {
                return try_address(l, e)
            }
            if err.error_is_catchname(names(l), nm) {
                return catch_slot(l, e)
            }
            let cc: i64 = err.error_ctor_code((*l).feh, names(l), nm)
            if cc >= 0 {
                return ctor_address(l, e, cc as u64)
            }
        }
        // HOOK enum (lower_match.rs): der Konstruktor legt den Wert selbst an.
        if has_mu(l) && ast.e_number(b, e) == 0 {
            if pattern.pat_is_ctorname(names(l), ast.e_a(b, e)) {
                let t: u32 = sema.sema_ty(sm(l), e)
                let slot: u32 = alloca(l, q_size(l, t), q_align(l, t))
                ctor_write(l, e, slot)
                return slot
            }
        }
        // Ein Aufruf, der ein Aggregat liefert, schreibt in einen
        // Zwischenspeicher; dessen Adresse ist das Ergebnis (SPEC §14.1).
        let t: u32 = sema.sema_ty(sm(l), e)
        if !is_aggregate(l, t) {
            give_up(l)
            return 0
        }
        let slot: u32 = alloca(l, q_size(l, t), q_align(l, t))
        call_with_target(l, e, slot)
        return slot
    }
    give_up(l)
    return 0
}

// -------------------------------------------------- Ablegen an eine Adresse

// Ist `t` ein Schnittstellenwert (`dyn I`)?
fn is_dyn_ty(l: *mut Lower, t: u32) -> bool {
    if !has_if(l) {
        return false
    }
    if types.ty_kind(tf(l), t) != types.K_STRUCT {
        return false
    }
    let nm: u32 = types.st_name(tf(l), types.ty_a(tf(l), t) as usize)
    return iface.if_of_dyn(ifl(l), nm) != KEIN
}

// HOOK iface (iface.rs::lower_cast_into): `p as dyn I` — zwei Woerter.
// Der Datenzeiger wird NICHT veraendert (kein Versatz, keine
// Verschleierung); nur so findet der konservative Stapelscan des Sammlers
// das Objekt dahinter (SPEC §3.5.3).
fn interface_write(l: *mut Lower, addr: u32, e: u32, t: u32) {
    let b: *mut ast.Tree = tree(l)
    let dn: u32 = types.st_name(tf(l), types.ty_a(tf(l), t) as usize)
    let ii: u32 = iface.if_of_dyn(ifl(l), dn)
    if ii == KEIN {
        give_up(l)
        return
    }
    let inner: u32 = ast.e_a(b, e)
    let qt: u32 = sema.sema_ty(sm(l), inner)
    if types.ty_kind(tf(l), qt) != types.K_PTR {
        give_up(l)
        return
    }
    let qi: u32 = types.ty_a(tf(l), qt)
    if types.ty_kind(tf(l), qi) != types.K_STRUCT {
        give_up(l)
        return
    }
    let pre: u32 = iface.if_table(ifl(l), ii, types.ty_a(tf(l), qi))
    if pre == KEIN {
        give_up(l)
        return
    }
    let pv: u32 = value(l, inner)
    store(l, fir.T_PTR, ptradd_const(l, addr, 0), pv)
    let tv: u32 = push(l, fir.O_VTAB, fir.T_PTR,
                       iface.if_name(ifl(l), ii as usize), pre, 0, 0, 0, 0)
    store(l, fir.T_PTR, ptradd_const(l, addr, 8), tv)
}

fn write_after(l: *mut Lower, addr: u32, e: u32) {
    if (*l).unsuitable {
        return
    }
    let b: *mut ast.Tree = tree(l)
    let a: u32 = ast.e_kind(b, e)
    let t: u32 = sema.sema_ty(sm(l), e)

    // HOOK fehlerunionen (lower_errors.rs::hook_write_into): die implizite
    // Umwandlung, der reine Fehlerwert und `try`/`catch` schreiben selbst.
    if has_fe(l) {
        let cu: u32 = err.error_coerce_open(fel(l), e)
        if cu != KEIN {
            union_write(l, addr, e, cu)
            return
        }
        if a == ast.E_RUF && ast.e_number(b, e) == 0 {
            let nm: u32 = ast.e_a(b, e)
            let cc: i64 = err.error_ctor_code((*l).feh, names(l), nm)
            if cc >= 0 {
                let cv: u32 = constant(l, fir.T_U32, cc as u64)
                store(l, fir.T_U32, addr, cv)
                return
            }
            var is_res: bool = err.error_is_tryname(names(l), nm)
            if !is_res {
                is_res = err.error_is_catchname(names(l), nm)
            }
            if is_res {
                var src: u32 = 0
                if err.error_is_tryname(names(l), nm) {
                    src = try_address(l, e)
                } else {
                    src = catch_slot(l, e)
                }
                copy_value(l, addr, src, t)
                return
            }
        }
    }

    if a == ast.E_SLIT {
        let si: usize = types.ty_a(tf(l), t) as usize
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            let fname: u32 = ast.child_at(b, ast.e_b(b, e) + k * 2)
            let fexpr: u32 = ast.child_at(b, ast.e_b(b, e) + k * 2 + 1)
            let fa: u32 = ptradd_const(l, addr, field_offset(l, si, fname))
            write_after(l, fa, fexpr)
            k = k + 1
        }
        return
    }
    if a == ast.E_ALIT {
        let esz: u64 = q_size(l, types.ty_a(tf(l), t))
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            let ea: u32 = elem_address_const(l, addr, esz, k as u64)
            write_after(l, ea, ast.child_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        return
    }
    if a == ast.E_AWDH {
        repeat(l, addr, ast.e_a(b, e), types.ty_a(tf(l), t), types.ty_n(tf(l), t))
        return
    }
    if a == ast.E_RUF && has_mu(l) && ast.e_number(b, e) == 0 {
        // HOOK enum (lower_match.rs): der Konstruktor schreibt direkt ins Ziel.
        if pattern.pat_is_ctorname(names(l), ast.e_a(b, e)) {
            ctor_write(l, e, addr)
            return
        }
    }
    if a == ast.E_RUF && is_aggregate(l, t) {
        call_with_target(l, e, addr)
        return
    }
    // HOOK iface: `p as dyn I` schreibt Datenzeiger und Tafel (iface.fi).
    if a == ast.E_AS && is_dyn_ty(l, t) {
        interface_write(l, addr, e, t)
        return
    }
    if is_aggregate(l, t) {
        let src: u32 = address(l, e)
        copymem(l, addr, src, types.size_of(tf(l), t))
        return
    }
    let ft: u32 = fty(l, t)
    let v: u32 = value(l, e)
    store(l, ft, addr, v)
}

// `[wert; N]` an `adr` schreiben. Der Wert wird GENAU EINMAL ausgewertet und
// dann vervielfaeltigt — bis acht Elemente ausgerollt, darueber als Schleife.
fn repeat(l: *mut Lower, addr: u32, val: u32, et: u32, n: u64) {
    let esz: u64 = q_size(l, et)
    let scalar: bool = !is_aggregate(l, et)
    var sv: u32 = 0
    var sft: u32 = 0
    var saddr: u32 = 0
    if scalar {
        sft = fty(l, et)
        sv = value(l, val)
    } else {
        saddr = address(l, val)
    }
    if n <= 8 {
        var i: u64 = 0
        while i < n {
            let ea: u32 = elem_address_const(l, addr, esz, i)
            if scalar {
                store(l, sft, ea, sv)
            } else {
                copymem(l, ea, saddr, esz)
            }
            i = i + 1
        }
        return
    }
    let islot: u32 = alloca(l, 8, 8)
    let null: u32 = constant(l, fir.T_U64, 0)
    store(l, fir.T_U64, islot, null)
    let header: u32 = new_block(l)
    let body: u32 = new_block(l)
    let end: u32 = new_block(l)
    term(l, fir.TERM_BR, header, 0, 0)

    (*l).cur = header
    let iv: u32 = load(l, fir.T_U64, islot)
    let nv: u32 = constant(l, fir.T_U64, n)
    let c: u32 = push(l, fir.O_CMP, fir.T_BOOL, iv, nv, 2, fir.T_U64 as u64, 0, 0)
    term(l, fir.TERM_BRCOND, c, body, end)

    (*l).cur = body
    let iv2: u32 = load(l, fir.T_U64, islot)
    let ea: u32 = elem_address(l, addr, iv2, fir.T_U64, esz)
    if scalar {
        store(l, sft, ea, sv)
    } else {
        copymem(l, ea, saddr, esz)
    }
    // Der schon geladene Index wird WIEDERVERWENDET — ein zweiter `load`
    // waere eine Instruktion zu viel und verschoebe alle Wertnummern.
    let one: u32 = constant(l, fir.T_U64, 1)
    let inc: u32 = push(l, fir.O_BIN, fir.T_U64, iv2, one, 0, 0, 0, 0)
    store(l, fir.T_U64, islot, inc)
    term(l, fir.TERM_BR, header, 0, 0)

    (*l).cur = end
}

fn q_size(l: *mut Lower, t: u32) -> u64 {
    var g: u64 = types.size_of(tf(l), t)
    if g < 1 { g = 1 }
    return g
}

fn q_align(l: *mut Lower, t: u32) -> u64 {
    var a: u64 = types.alignment_of(tf(l), t)
    if a < 1 { a = 1 }
    return a
}

// Versatz eines Feldes im Struct `si`.
fn field_offset(l: *mut Lower, si: usize, fname: u32) -> u64 {
    var k: u32 = 0
    while k < types.st_flen(tf(l), si) {
        let fnr: u32 = types.st_foff(tf(l), si) + k
        if types.sf_name(tf(l), fnr) == fname {
            return types.sf_offset(tf(l), fnr)
        }
        k = k + 1
    }
    return 0
}

fn field_ty_of(l: *mut Lower, si: usize, fname: u32) -> u32 {
    return types.st_field_ty(tf(l), si, fname)
}

fn ptradd_const(l: *mut Lower, base: u32, off: u64) -> u32 {
    if off == 0 {
        return base
    }
    let o: u32 = constant(l, fir.T_I64, off)
    return push(l, fir.O_PTRADD, fir.T_PTR, base, o, 0, 0, 0, 0)
}

// Adresse eines Elements mit BERECHNETEM Index. Der Index wird zuerst auf
// `u64` gebracht — genau in dieser Reihenfolge, sonst stimmen die Wertnummern
// nicht (layout.rs::elem_addr).
fn elem_address(l: *mut Lower, base: u32, idx: u32, ift: u32, gr: u64) -> u32 {
    var idx64: u32 = idx
    if ift != fir.T_U64 {
        idx64 = push(l, fir.O_CAST, fir.T_U64, idx, 0, ift, 0, 0, 0)
    }
    let g: u32 = constant(l, fir.T_U64, gr)
    let off: u32 = push(l, fir.O_BIN, fir.T_U64, idx64, g, 2, 0, 0, 0)
    return push(l, fir.O_PTRADD, fir.T_PTR, base, off, 0, 0, 0, 0)
}

fn elem_address_const(l: *mut Lower, base: u32, gr: u64, i: u64) -> u32 {
    return ptradd_const(l, base, gr * i)
}

fn copymem(l: *mut Lower, target: u32, source: u32, size: u64) {
    push_void(l, fir.O_COPYMEM, fir.T_VOID, target, source, 0, size, 0, 0)
}

// ------------------------------------------------------------- Ausdruecke

fn value(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(l)
    let t: u32 = sema.sema_ty(sm(l), e)
    if is_aggregate(l, t) {
        give_up(l)
        return 0
    }
    let a: u32 = ast.e_kind(b, e)
    let ft: u32 = e_fty(l, e)

    if a == ast.E_INT {
        return constant(l, ft, ast.e_number(b, e))
    }
    if a == ast.E_FLOAT {
        return constant(l, fir.T_F64, ast.e_number(b, e))
    }
    if a == ast.E_BOOL {
        return constant(l, fir.T_BOOL, ast.e_a(b, e) as u64)
    }
    if a == ast.E_ID {
        let slot: u32 = search(l, ast.e_a(b, e))
        if slot != KEIN {
            return load(l, ft, slot)
        }
        // Konstante: der Wert steht schon im Typpruefer.
        return constant(l, ft, sema_const(l, ast.e_a(b, e)))
    }
    if a == ast.E_UN {
        let op: u32 = ast.e_a(b, e)
        if op == 2 {
            return address(l, ast.e_b(b, e))
        }
        if op == 3 {
            let addr: u32 = value(l, ast.e_b(b, e))
            return load(l, ft, addr)
        }
        let v: u32 = value(l, ast.e_b(b, e))
        var un: u32 = 0
        if op == 1 {
            un = 1
        }
        return push(l, fir.O_UN, ft, v, 0, un, 0, 0, 0)
    }
    if a == ast.E_BIN {
        return binary(l, e)
    }
    if a == ast.E_FELD || a == ast.E_IDX {
        let addr: u32 = address(l, e)
        return load(l, ft, addr)
    }
    if a == ast.E_RUF {
        // HOOK fehlerunionen (lower_errors.rs::hook_value): das SKALARE
        // Ergebnis von `try`/`catch` (Aggregate laufen ueber `adresse`).
        if has_fe(l) && ast.e_number(b, e) == 0 {
            let nm: u32 = ast.e_a(b, e)
            if err.error_is_tryname(names(l), nm) {
                let sa: u32 = try_address(l, e)
                return load(l, ft, sa)
            }
            if err.error_is_catchname(names(l), nm) {
                let sa: u32 = catch_slot(l, e)
                return load(l, ft, sa)
            }
        }
        return call(l, e, ft)
    }
    if a == ast.E_SYSCALL {
        // JEDES Argument geht als `i64` in den Syscall — was nicht schon i64
        // ist, wird umgewandelt. Auch Zeiger; sonst fehlt genau ein `cast`.
        var tmp: Vec[u32] = vec_new[u32]()
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            let arg: u32 = ast.child_at(b, ast.e_b(b, e) + k)
            let aft: u32 = e_fty(l, arg)
            let v: u32 = value(l, arg)
            if aft == fir.T_I64 {
                vec_push[u32](&tmp, v)
            } else {
                vec_push[u32](&tmp, push(l, fir.O_CAST, fir.T_I64, v, 0, aft, 0, 0, 0))
            }
            k = k + 1
        }
        let off: u32 = args_store(l, &tmp)
        vec_free[u32](&tmp)
        return push(l, fir.O_SYSCALL, fir.T_I64, 0, 0, 0, 0, off, ast.e_c(b, e))
    }
    if a == ast.E_AS {
        let of: u32 = e_fty(l, ast.e_a(b, e))
        let after: u32 = ft
        let src: u32 = value(l, ast.e_a(b, e))
        if of == after {
            return src
        }
        if after == fir.T_BOOL {
            let z: u32 = constant(l, of, 0)
            return push(l, fir.O_CMP, fir.T_BOOL, src, z, 1, of as u64, 0, 0)
        }
        return push(l, fir.O_CAST, after, src, 0, of, 0, 0, 0)
    }
    give_up(l)
    return 0
}

// Wert einer Konstanten aus dem Typpruefer.
fn sema_const(l: *mut Lower, name: u32) -> u64 {
    return sema.sema_const_value(sm(l), name)
}

fn binary(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(l)
    let op: u32 = ast.e_a(b, e)
    let li: u32 = ast.e_b(b, e)
    let re: u32 = ast.e_c(b, e)

    if op == 16 || op == 17 {
        return short_circuit(l, op, li, re)
    }
    if op >= 10 && op <= 15 {
        // HOOK fehlerunionen (lower_errors.rs::hook_binary): zwei Fehlerwerte
        // vergleichen heisst ihre Codes vergleichen (u32 am Anfang).
        if has_fe(l) && (op == 10 || op == 11) {
            let lty: u32 = sema.sema_ty(sm(l), li)
            let rty: u32 = sema.sema_ty(sm(l), re)
            if err.error_set_of_ty(fel(l), tf(l), lty) != KEIN {
                if err.error_set_of_ty(fel(l), tf(l), rty) != KEIN {
                    let aa: u32 = address(l, li)
                    let av: u32 = load(l, fir.T_U32, aa)
                    let ba: u32 = address(l, re)
                    let bv: u32 = load(l, fir.T_U32, ba)
                    return push(l, fir.O_CMP, fir.T_BOOL, av, bv, op - 10,
                                fir.T_U32 as u64, 0, 0)
                }
            }
        }
        let ty: u32 = e_fty(l, li)
        let av: u32 = value(l, li)
        let bv: u32 = value(l, re)
        return push(l, fir.O_CMP, fir.T_BOOL, av, bv, op - 10, ty as u64, 0, 0)
    }
    let ft: u32 = e_fty(l, e)
    // Reihenfolge wie `ast::BinOp`: add sub mul div rem and or xor shl shr
    let bop: u32 = op
    let av: u32 = value(l, li)
    var bv: u32 = value(l, re)
    if op == 8 || op == 9 {
        let bt: u32 = e_fty(l, re)
        if bt != ft {
            bv = push(l, fir.O_CAST, ft, bv, 0, bt, 0, 0, 0)
        }
    }
    return push(l, fir.O_BIN, ft, av, bv, bop, 0, 0, 0)
}

// `&&` / `||` kurzschliessend: Ergebnisplatz + Verzweigung.
fn short_circuit(l: *mut Lower, op: u32, li: u32, re: u32) -> u32 {
    let slot: u32 = alloca(l, 1, 1)
    let av: u32 = value(l, li)
    store(l, fir.T_BOOL, slot, av)
    let rhs: u32 = new_block(l)
    let join: u32 = new_block(l)
    var then: u32 = rhs
    var els: u32 = join
    if op == 17 {
        then = join
        els = rhs
    }
    term(l, fir.TERM_BRCOND, av, then, els)
    (*l).cur = rhs
    let bv: u32 = value(l, re)
    store(l, fir.T_BOOL, slot, bv)
    if !terminated(l) {
        term(l, fir.TERM_BR, join, 0, 0)
    }
    (*l).cur = join
    return load(l, fir.T_BOOL, slot)
}

// Klasse eines Typs an der Funktionsgrenze: Anzahl der Ganzzahlwoerter,
// oder `fir.KEIN` fuer die Speicherklasse.
fn abi_class(l: *mut Lower, t: u32) -> u32 {
    let k: u32 = types.class_of(tf(l), t)
    if k == types.KLASSE_MEM {
        return fir.KEIN
    }
    return k
}

fn abi_sret(l: *mut Lower, t: u32) -> bool {
    return types.needs_sret(tf(l), t)
}

// Laedt ein Aggregat als `n` Ganzzahlwoerter. Ist die Groesse kein Vielfaches
// von acht, laeuft es ueber einen aufgefuellten Zwischenpuffer — sonst laege
// der letzte `load` teilweise HINTER dem Objekt.
fn words_load(l: *mut Lower, addr: u32, size: u64, n: u32, out: *mut Vec[u32]) {
    var source: u32 = addr
    if size % 8 != 0 {
        let t: u32 = alloca(l, n as u64 * 8, 8)
        copymem(l, t, addr, size)
        source = t
    }
    var i: u32 = 0
    while i < n {
        let a: u32 = ptradd_const(l, source, i as u64 * 8)
        vec_push[u32](out, load(l, fir.T_I64, a))
        i = i + 1
    }
}

fn words_store(l: *mut Lower, target: u32, size: u64, w: u32) {
    if size % 8 != 0 {
        let t: u32 = alloca(l, 8, 8)
        store(l, fir.T_I64, t, w)
        copymem(l, target, t, size)
        return
    }
    store(l, fir.T_I64, target, w)
}

// Die Argumente muessen ZUSAMMENHAENGEND liegen. Ein Argument, das selbst
// einen Aufruf enthaelt, legt sonst seine eigenen Argumente MITTEN in die
// aeussere Liste — derselbe Fehler wie beim Parser (Runde 22). Also erst
// sammeln, dann am Stueck ablegen.
fn args_store(l: *mut Lower, tmp: *mut Vec[u32]) -> u32 {
    let off: u32 = fir.arg_start(&(*l).f)
    var i: usize = 0
    while i < vec_len[u32](tmp) {
        fir.arg_add(&(*l).f, vec_at[u32](tmp, i))
        i = i + 1
    }
    return off
}

// ------------------------------------------------- gc (gc_lower.rs, Runde 34)
//
// `gc C{ ... }` — Aufruf der Laufzeit (`__gc_alloc_raw`), danach die
// Fehlerunion `AllocError!Gc[C]` an `ziel` bauen und die Felder schreiben.
// Der Sammellauf steckt in `__gc_alloc_raw`: ERST sammeln, DANN
// `AllocError::OutOfMemory` (DESIGNZIELE §2).
fn gc_alloc_lower(l: *mut Lower, e: u32, target: u32) {
    let b: *mut ast.Tree = tree(l)
    let ki_i: i64 = gc.gc_class_out_new(gcl(l), names(l), ast.e_a(b, e))
    if ki_i < 0 {
        give_up(l)
        return
    }
    let ki: u32 = ki_i as u32
    let sidx: u32 = gc.gc_sidx(gcl(l), ki)
    // Lage von `__val` in der Fehlerunion.
    let ui: u32 = gc.gc_union(gcl(l), ki)
    if ui == 0 {
        give_up(l)
        return
    }
    let voff: u64 = err.error_u_voff(fel(l), ui - 1)
    var ae: [u8; 10] = "AllocError"
    let aen: u32 = intern.intern_number(names(l), (&ae[0]) as u64, 10) as u32
    let sm2: u32 = err.error_set_find(fel(l), aen)
    var om: [u8; 11] = "OutOfMemory"
    let omn: u32 = intern.intern_number(names(l), (&om[0]) as u64, 11) as u32
    let code: u32 = err.error_code_of(fel(l), sm2, omn)
    if code == 0 {
        give_up(l)
        return
    }
    var ar: [u8; 14] = "__gc_alloc_raw"
    let arn: u32 = intern.intern_number(names(l), (&ar[0]) as u64, 14) as u32

    let tidv: u32 = constant(l, fir.T_U64, gc.gc_tid(gcl(l), ki))
    let sizev: u32 = constant(l, fir.T_U64, gc.gc_size(gcl(l), ki))
    var tmp: Vec[u32] = vec_new[u32]()
    vec_push[u32](&tmp, tidv)
    vec_push[u32](&tmp, sizev)
    let aoff: u32 = args_store(l, &tmp)
    vec_free[u32](&tmp)
    let p: u32 = push(l, fir.O_CALL, fir.T_PTR, arn, 0, 0, 0, aoff, 2)
    let null: u32 = constant(l, fir.T_PTR, 0)
    // 1 = ungleich (Reihenfolge wie `ast::BinOp`: eq ne lt le gt ge)
    let ok: u32 = push(l, fir.O_CMP, fir.T_BOOL, p, null, 1, fir.T_PTR as u64, 0, 0)
    let ok_bb: u32 = new_block(l)
    let fail_bb: u32 = new_block(l)
    let join: u32 = new_block(l)
    term(l, fir.TERM_BRCOND, ok, ok_bb, fail_bb)

    // Fehlerfall: erst hat die Laufzeit gesammelt, dann ist wirklich Schluss.
    (*l).cur = fail_bb
    let cv: u32 = constant(l, fir.T_U32, code as u64)
    store(l, fir.T_U32, target, cv)
    let va1: u32 = ptradd_const(l, target, voff)
    let z0: u32 = constant(l, fir.T_PTR, 0)
    store(l, fir.T_PTR, va1, z0)
    term(l, fir.TERM_BR, join, 0, 0)

    // Erfolgsfall: Fehlerunion fuellen (damit der Zeiger sofort eine Wurzel
    // auf dem Stapel hat), dann die Felder schreiben.
    (*l).cur = ok_bb
    let z32: u32 = constant(l, fir.T_U32, 0)
    store(l, fir.T_U32, target, z32)
    let va2: u32 = ptradd_const(l, target, voff)
    store(l, fir.T_PTR, va2, p)
    if ast.e_c(b, e) == 1 {
        let slit: u32 = ast.child_at(b, ast.e_b(b, e))
        if ast.e_kind(b, slit) == ast.E_SLIT {
            let off: u32 = ast.e_b(b, slit)
            let cnt: u32 = ast.e_c(b, slit)
            var k: u32 = 0
            while k < cnt {
                let fname: u32 = ast.child_at(b, off + k * 2)
                let fexpr: u32 = ast.child_at(b, off + k * 2 + 1)
                let fa: u32 = ptradd_const(l, p, field_offset(l, sidx as usize, fname))
                write_after(l, fa, fexpr)
                k = k + 1
            }
        }
    }
    if !terminated(l) {
        term(l, fir.TERM_BR, join, 0, 0)
    }
    (*l).cur = join
}

// Die Einfuegebarriere (hook_assign in gc_lower.rs): NACH dem Schreiben
// eines `Gc[T]`-Zeigers in ein Heapfeld. Nur Schreibzugriffe IN den Heap
// brauchen sie; eine oertliche Veraenderliche liegt auf dem Stapel.
fn gc_barrier(l: *mut Lower, target: u32) {
    let b: *mut ast.Tree = tree(l)
    let t: u32 = sema.sema_ty(sm(l), target)
    if !gc.gc_is_gc_ptr(gcl(l), tf(l), t) {
        return
    }
    var ins_heap: bool = false
    let a: u32 = ast.e_kind(b, target)
    if a == ast.E_FELD {
        let bt: u32 = sema.sema_ty(sm(l), ast.e_a(b, target))
        if gc.gc_is_gc_ptr(gcl(l), tf(l), bt) {
            ins_heap = true
        }
        if types.ty_kind(tf(l), bt) == types.K_PTR {
            ins_heap = true
        }
    }
    if a == ast.E_IDX {
        let bt: u32 = sema.sema_ty(sm(l), ast.e_a(b, target))
        if types.ty_kind(tf(l), bt) == types.K_PTR {
            ins_heap = true
        }
    }
    if a == ast.E_UN && ast.e_a(b, target) == 3 {
        ins_heap = true
    }
    if !ins_heap {
        return
    }
    var bn: [u8; 12] = "__gc_barrier"
    let bnn: u32 = intern.intern_number(names(l), (&bn[0]) as u64, 12) as u32
    let addr: u32 = address(l, target)
    let val: u32 = load(l, fir.T_PTR, addr)
    var tmp: Vec[u32] = vec_new[u32]()
    vec_push[u32](&tmp, addr)
    vec_push[u32](&tmp, val)
    let aoff: u32 = args_store(l, &tmp)
    vec_free[u32](&tmp)
    push_void(l, fir.O_CALL, fir.T_VOID, bnn, 0, 0, 0, aoff, 2)
}

// Ein Aufruf nach der Aufrufkonvention. `ziel` ist die Zieladresse, wenn die
// Funktion ein Aggregat liefert (sonst `fir.KEIN`). Rueckgabe: der skalare
// Wert, oder 0.
// ------------------------------------------------------- RUNDE 45: Methoden
// Dieselbe Aufloesung wie in sema.fi — aus demselben Material, damit beide
// nicht auseinanderlaufen koennen (impls.rs::ziel_von).

fn is_method_call(it: *mut intern.Interner, name: u32) -> bool {
    var w: [u8; 8] = "methode "
    return intern.intern_prefix(it, name, (&w[0]) as u64, 8)
}

// RUNDE 50: wie `sema.fi::empf_struct` — auch ein Grundtyp traegt Methoden.
// Beide Seiten rechnen aus demselben Material, damit sie nicht auseinander
// laufen koennen.
fn recv_struct_l(l: *mut Lower, t: u32) -> u32 {
    var i: u32 = t
    if types.ty_kind(tf(l), i) == types.K_PTR {
        i = types.ty_a(tf(l), i)
    }
    let a: u32 = types.ty_kind(tf(l), i)
    if a == types.K_STRUCT {
        return types.st_name(tf(l), types.ty_a(tf(l), i) as usize)
    }
    return types.base_ty_name(names(l), a)
}

fn method_func_l(l: *mut Lower, sn: u32, m: u32) -> u32 {
    let it: *mut intern.Interner = names(l)
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, intern.intern_ptr(it, sn), intern.intern_length(it, sn))
    var tr: [u8; 2] = "__"
    rt.buf_push_bytes(&b, (&tr[0]) as u64, 2)
    rt.buf_push_bytes(&b, intern.intern_ptr(it, m), intern.intern_length(it, m))
    let nr: u32 = intern.intern_number(it, rt.buf_ptr(&b), rt.buf_len(&b)) as u32
    rt.buf_free(&b)
    return nr
}

// ---------------------------------------------- Inline-Assembler und MMIO
//
// RUNDE 52 (compiler/src/core.rs::lower_hook).

fn mmio_fty(w: u32) -> u32 {
    if w == 0 {
        return fir.T_U8
    }
    if w == 1 {
        return fir.T_U16
    }
    if w == 2 {
        return fir.T_U32
    }
    return fir.T_U64
}

fn asm_lower(l: *mut Lower, blk: u32, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(l)
    let off: u32 = ast.e_b(b, e)
    let cnt: u32 = ast.e_c(b, e)
    // Eingaben in Quellreihenfolge auswerten und auf 64 Bit bringen: in ein
    // Register geht immer das ganze Wort.
    var values: Vec[u32] = vec_new[u32]()
    var k: u32 = 0
    while k < cnt {
        let arg: u32 = ast.child_at(b, off + k)
        var v: u32 = value(l, arg)
        let ft: u32 = e_fty(l, arg)
        if ft != fir.T_U64 && ft != fir.T_I64 && ft != fir.T_PTR {
            v = push(l, fir.O_CAST, fir.T_U64, v, 0, ft, 0, 0, 0)
        }
        vec_push[u32](&values, v)
        k = k + 1
    }
    // Argumentblock: erst die Paare (Register, Wert), danach die Clobber.
    let aoff: u32 = fir.arg_start(&(*l).f)
    var k2: u32 = 0
    while k2 < cnt {
        fir.arg_add(&(*l).f, ast.asm_in_reg(b, blk, k2))
        fir.arg_add(&(*l).f, vec_at[u32](&values, k2 as usize))
        k2 = k2 + 1
    }
    vec_free[u32](&values)
    let cz: u32 = ast.asm_clob_count(b, blk)
    var k3: u32 = 0
    while k3 < cz {
        fir.arg_add(&(*l).f, ast.asm_clob(b, blk, k3))
        k3 = k3 + 1
    }
    let template: u32 = ast.asm_template(b, blk)
    var out: u32 = ast.asm_out(b, blk)
    if out == ast.NICHTS {
        out = fir.KEIN
    }
    if out == fir.KEIN {
        push_void(l, fir.O_ASM, fir.T_VOID, template, out, 0, cz as u64, aoff, cnt)
        return 0
    }
    return push(l, fir.O_ASM, fir.T_U64, template, out, 0, cz as u64, aoff, cnt)
}

fn call_full(l: *mut Lower, e: u32, target: u32) -> u32 {
    let b: *mut ast.Tree = tree(l)
    var name: u32 = ast.e_a(b, e)
    // HOOK gc (gc_lower.rs::hook_call): Allokation, Intrinsics, `as?` — und
    // `weak`/`stark` sind Laufzeitfunktionen (`echter_name`).
    // RUNDE 52 (core.rs): Inline-Assembler und MMIO.
    let anr: u32 = core.asm_number(names(l), name)
    if anr != core.KEINE_NUMMER {
        return asm_lower(l, anr, e)
    }
    if fn_number(l, name) == KEIN {
        let wl: u32 = core.mmio_read_width(names(l), name)
        if wl != core.KEINE_BREITE {
            let ad: u32 = value(l, ast.child_at(b, ast.e_b(b, e)))
            return push(l, fir.O_MMIOLD, mmio_fty(wl), ad, 0, 0, 0, 0, 0)
        }
        let ws: u32 = core.mmio_write_width(names(l), name)
        if ws != core.KEINE_BREITE {
            let ad2: u32 = value(l, ast.child_at(b, ast.e_b(b, e)))
            let wv: u32 = value(l, ast.child_at(b, ast.e_b(b, e) + 1))
            push_void(l, fir.O_MMIOST, mmio_fty(ws), ad2, wv, 0, 0, 0, 0)
            return 0
        }
    }
    // RUNDE 49 (thread.rs): Faden erzeugen, TLS-Selbstzeiger, Vergleichs-Tausch.
    var fstw: [u8; 14] = "__thread_start"
    if intern.intern_equal(names(l), name, (&fstw[0]) as u64, 15) && fn_number(l, name) == KEIN {
        let arg0: u32 = value(l, ast.child_at(b, ast.e_b(b, e)))
        let arg1: u32 = value(l, ast.child_at(b, ast.e_b(b, e) + 1))
        let arg2: u32 = value(l, ast.child_at(b, ast.e_b(b, e) + 2))
        return push(l, fir.O_SPAWN, fir.T_I64, arg0, arg1, arg2, 0, 0, 0)
    }
    var fslw: [u8; 13] = "__thread_self"
    if intern.intern_equal(names(l), name, (&fslw[0]) as u64, 14) && fn_number(l, name) == KEIN {
        return push(l, fir.O_TLS, fir.T_PTR, 0, 0, 0, 0, 0, 0)
    }
    var atcw: [u8; 13] = "__atomic_swap"
    if intern.intern_equal(names(l), name, (&atcw[0]) as u64, 17) && fn_number(l, name) == KEIN {
        let cp: u32 = value(l, ast.child_at(b, ast.e_b(b, e)))
        let cea: u32 = ast.child_at(b, ast.e_b(b, e) + 1)
        let cna: u32 = ast.child_at(b, ast.e_b(b, e) + 2)
        var ce: u32 = value(l, cea)
        var cn: u32 = value(l, cna)
        let cet: u32 = e_fty(l, cea)
        if cet != fir.T_U64 && cet != fir.T_I64 {
            ce = push(l, fir.O_CAST, fir.T_U64, ce, 0, cet, 0, 0, 0)
        }
        let cnt: u32 = e_fty(l, cna)
        if cnt != fir.T_U64 && cnt != fir.T_I64 {
            cn = push(l, fir.O_CAST, fir.T_U64, cn, 0, cnt, 0, 0, 0)
        }
        return push(l, fir.O_ATOMCAS, fir.T_U64, cp, ce, cn, 0, 0, 0)
    }
    // `__atomar_addieren(p, delta)` (atomic.rs, RUNDE 47): Op::AtomicAdd.
    var atw: [u8; 12] = "__atomic_add"
    if intern.intern_equal(names(l), name, (&atw[0]) as u64, 17) && fn_number(l, name) == KEIN {
        let padr: u32 = value(l, ast.child_at(b, ast.e_b(b, e)))
        let darg: u32 = ast.child_at(b, ast.e_b(b, e) + 1)
        var dv: u32 = value(l, darg)
        let dft: u32 = e_fty(l, darg)
        if dft != fir.T_U64 && dft != fir.T_I64 {
            dv = push(l, fir.O_CAST, fir.T_U64, dv, 0, dft, 0, 0, 0)
        }
        return push(l, fir.O_ATOMADD, fir.T_U64, padr, dv, 0, 0, 0, 0)
    }
    if has_gc(l) && ast.e_number(b, e) == 0 {
        if gc.gc_has_new_prefix(names(l), name) {
            var z: u32 = target
            if z == fir.KEIN {
                let t: u32 = sema.sema_ty(sm(l), e)
                z = alloca(l, q_size(l, t), q_align(l, t))
            }
            gc_alloc_lower(l, e, z)
            return 0
        }
        let zn: u32 = gc.gc_state_name(names(l), name)
        if zn != 0 {
            var regs: u64 = 0
            if zn == 2 {
                regs = 1
            }
            return push(l, fir.O_GCADDR, fir.T_PTR, 0, 0, 0, regs, 0, 0)
        }
        if gc.gc_has_as_prefix(names(l), name) {
            let ki_i: i64 = gc.gc_class_out_as(gcl(l), names(l), name)
            if ki_i < 0 {
                give_up(l)
                return 0
            }
            let arg: u32 = ast.child_at(b, ast.e_b(b, e))
            let pv: u32 = value(l, arg)
            let tidv: u32 = constant(l, fir.T_U64, gc.gc_tid(gcl(l), ki_i as u32))
            var an: [u8; 11] = "__gc_as_raw"
            let ann: u32 = intern.intern_number(names(l), (&an[0]) as u64, 11) as u32
            var tmp: Vec[u32] = vec_new[u32]()
            vec_push[u32](&tmp, pv)
            vec_push[u32](&tmp, tidv)
            let aoff: u32 = args_store(l, &tmp)
            vec_free[u32](&tmp)
            return push(l, fir.O_CALL, fir.T_PTR, ann, 0, 0, 0, aoff, 2)
        }
        // `barrier(x)` (ct.rs): undurchsichtig fuer den Optimierer — den
        // hat diese Stufe nicht, also bleibt die Identitaet.
        var bw: [u8; 7] = "barrier"
        if intern.intern_equal(names(l), name, (&bw[0]) as u64, 7) && fn_number(l, name) == KEIN {
            return value(l, ast.child_at(b, ast.e_b(b, e)))
        }
        // `select(bedingung, a, b)` (ct.rs::lower_ct_call, RUNDE 36): die
        // FIR-Instruktion Op::Select — der Codegenerator macht ein `cmov`
        // daraus, keinen Sprung (SPEC §9.2).
        var sw2: [u8; 6] = "select"
        if intern.intern_equal(names(l), name, (&sw2[0]) as u64, 6) && fn_number(l, name) == KEIN {
            let aa: u32 = ast.child_at(b, ast.e_b(b, e) + 1)
            let sty: u32 = e_fty(l, aa)
            let cond: u32 = value(l, ast.child_at(b, ast.e_b(b, e)))
            let av: u32 = value(l, aa)
            let bv: u32 = value(l, ast.child_at(b, ast.e_b(b, e) + 2))
            return push(l, fir.O_SELECT, sty, cond, av, bv, 0, 0, 0)
        }
        // `secure_zero(zeiger, anzahl)` (ct.rs, RUNDE 36): Op::SecureZero;
        // die Byteanzahl wird als u64 gebraucht (`angleichen` — schmalere
        // Ganzzahlen werden vorzeichenrichtig erweitert).
        var sz: [u8; 11] = "secure_zero"
        if intern.intern_equal(names(l), name, (&sz[0]) as u64, 11) && fn_number(l, name) == KEIN {
            let narg: u32 = ast.child_at(b, ast.e_b(b, e) + 1)
            let zadr: u32 = value(l, ast.child_at(b, ast.e_b(b, e)))
            var nv: u32 = value(l, narg)
            let nft: u32 = e_fty(l, narg)
            if nft != fir.T_U64 && nft != fir.T_I64 {
                nv = push(l, fir.O_CAST, fir.T_U64, nv, 0, nft, 0, 0, 0)
            }
            push_void(l, fir.O_SECZERO, fir.T_VOID, zadr, nv, 0, 0, 0, 0)
            return 0
        }
        // `weak`/`stark` — eine gleichnamige EIGENE Funktion gewinnt.
        if fn_number(l, name) == KEIN {
            if gc.gc_is_weak_name(names(l), name) {
                var wn: [u8; 13] = "__gc_weak_raw"
                name = intern.intern_number(names(l), (&wn[0]) as u64, 13) as u32
            }
            if gc.gc_is_strong_name(names(l), name) {
                var sn2: [u8; 15] = "__gc_strong_raw"
                name = intern.intern_number(names(l), (&sn2[0]) as u64, 15) as u32
            }
        }
    }
    // HOOK impl (impls.rs, Runde 45): `x.m(a)` steht als `"methode m"` im
    // Baum. Das Ziel wird hier NEU abgeleitet — aus dem Typ des Empfaengers
    // und dem Methodennamen, genau wie im Typpruefer. Eine Seitentabelle
    // zwischen den Phasen gibt es bewusst nicht.
    var recv_addr: bool = false
    // HOOK iface (iface.rs::lower_versand, Runde 46): `f.m(a)` auf einem
    // `dyn I`. `ziel` traegt die Adresse aus der Methodentafel, `daten` den
    // Zeiger auf den Wert; alles andere — Aggregate, versteckter
    // Rueckgabezeiger, Stapelargumente — laeuft danach durch genau denselben
    // Code wie ein gewoehnlicher Aufruf.
    var dispatch: bool = false
    var v_target: u32 = 0
    var v_data: u32 = 0
    var v_rt: u32 = 0
    if has_if(l) && is_method_call(names(l), name) {
        let empf0: u32 = ast.child_at(b, ast.e_b(b, e))
        let et0: u32 = sema.sema_ty(sm(l), empf0)
        let sn0: u32 = recv_struct_l(l, et0)
        if sn0 != KEIN {
            let ii: u32 = iface.if_of_dyn(ifl(l), sn0)
            if ii != KEIN {
                let m0: u32 = intern.intern_ab(names(l), name, 8)
                let mk: u32 = iface.if_slot(ifl(l), ii as usize, m0)
                if mk == KEIN {
                    give_up(l)
                    return 0
                }
                let base: u32 = address(l, empf0)
                v_data = load(l, fir.T_PTR, ptradd_const(l, base, 0))
                let table: u32 = load(l, fir.T_PTR, ptradd_const(l, base, 8))
                v_target = load(l, fir.T_PTR, ptradd_const(l, table, 8 * mk as u64))
                v_rt = iface.if_rtyp(ifl(l), ii as usize, mk)
                dispatch = true
            }
        }
    }
    if !dispatch && is_method_call(names(l), name) {
        let recv: u32 = ast.child_at(b, ast.e_b(b, e))
        let et: u32 = sema.sema_ty(sm(l), recv)
        let sn: u32 = recv_struct_l(l, et)
        if sn == KEIN {
            give_up(l)
            return 0
        }
        let m: u32 = intern.intern_ab(names(l), name, 8)
        name = method_func_l(l, sn, m)
        let mf: u32 = fn_number(l, name)
        if mf == KEIN {
            give_up(l)
            return 0
        }
        if ast.fn_plen(b, mf as usize) > 0 {
            let p0: u32 = types.param_ty_resolved(tf(l), mf as usize, 0)
            recv_addr = types.is_ptr(tf(l), p0) && !types.is_ptr(tf(l), et)
        }
    }
    var rt2: u32 = 0
    if dispatch {
        rt2 = v_rt
    } else {
        let fnr: u32 = fn_number(l, name)
        if fnr == KEIN {
            give_up(l)
            return 0
        }
        rt2 = types.ret_ty_the_func(tf(l), fnr as usize)
    }
    let ret_agg: bool = is_aggregate(l, rt2)
    let sret: bool = abi_sret(l, rt2)

    var tmp: Vec[u32] = vec_new[u32]()
    var target: u32 = fir.KEIN
    if ret_agg {
        if target != fir.KEIN {
            target = target
        } else {
            target = alloca(l, q_size(l, rt2), q_align(l, rt2))
        }
    }
    if sret {
        vec_push[u32](&tmp, target)
    }
    var k: u32 = 0
    while k < ast.e_c(b, e) {
        let arg: u32 = ast.child_at(b, ast.e_b(b, e) + k)
        // HOOK iface: der Empfaenger ist der Datenzeiger aus dem fetten
        // Zeiger — er wurde oben schon gelesen (iface.fi).
        if k == 0 && dispatch {
            vec_push[u32](&tmp, v_data)
            k = k + 1
            continue
        }
        // HOOK impl: der Empfaenger geht als ADRESSE hinein (impls.rs).
        if k == 0 && recv_addr {
            vec_push[u32](&tmp, address(l, arg))
            k = k + 1
            continue
        }
        var at: u32 = sema.sema_ty(sm(l), arg)
        // HOOK fehlerunionen (lower_errors.rs::hook_arg_type): ein implizit
        // umgewandeltes Argument ueberquert die Grenze als Aggregat.
        if has_fe(l) {
            let cu: u32 = err.error_coerce_open(fel(l), arg)
            if cu != KEIN {
                at = err.error_union_ty(fel(l), tf(l), cu)
            }
        }
        if !is_aggregate(l, at) {
            vec_push[u32](&tmp, value(l, arg))
            k = k + 1
            continue
        }
        let gr: u64 = q_size(l, at)
        let kl: u32 = abi_class(l, at)
        if kl != fir.KEIN {
            let addr: u32 = address(l, arg)
            words_load(l, addr, gr, kl, &tmp)
        } else {
            // Speicherklasse: versteckter Zeiger auf eine Kopie des Aufrufers.
            let t: u32 = alloca(l, gr, q_align(l, at))
            write_after(l, t, arg)
            vec_push[u32](&tmp, t)
        }
        k = k + 1
    }
    let cnt: u32 = vec_len[u32](&tmp) as u32
    let off: u32 = args_store(l, &tmp)
    vec_free[u32](&tmp)

    var call_kind: u32 = fir.O_CALL
    var call_target: u32 = name
    if dispatch {
        call_kind = fir.O_CALLI
        call_target = v_target
    }
    if ret_agg {
        let gr: u64 = types.size_of(tf(l), rt2)
        if sret {
            push(l, call_kind, fir.T_PTR, call_target, 0, 0, 0, off, cnt)
        } else {
            let w: u32 = push(l, call_kind, fir.T_I64, call_target, 0, 0, 0, off, cnt)
            words_store(l, target, gr, w)
        }
        return 0
    }
    let ft: u32 = fty(l, rt2)
    if ft == fir.T_VOID {
        push_void(l, call_kind, ft, call_target, 0, 0, 0, off, cnt)
        return 0
    }
    return push(l, call_kind, ft, call_target, 0, 0, 0, off, cnt)
}

fn call_with_target(l: *mut Lower, e: u32, target: u32) {
    call_full(l, e, target)
}

fn call(l: *mut Lower, e: u32, ft: u32) -> u32 {
    // `size_of[T]()` laesst zur Laufzeit NICHTS uebrig: eine Konstante.
    let z: u64 = ast.e_number(tree(l), e)
    if z != 0 {
        let t: u32 = types.resolve(tf(l), tree(l), names(l), (z - 1) as u32)
        return constant(l, fir.T_U64, types.size_of(tf(l), t))
    }
    return call_full(l, e, fir.KEIN)
}

fn fn_number(l: *mut Lower, name: u32) -> u32 {
    let b: *mut ast.Tree = tree(l)
    var i: usize = 0
    while i < ast.fn_count(b) {
        if ast.fn_name(b, i) == name {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// ------------------------------------------------------------- Anweisungen

fn stmt(l: *mut Lower, i: u32) {
    if (*l).unsuitable {
        return
    }
    let b: *mut ast.Tree = tree(l)
    let a: u32 = ast.s_kind(b, i)

    if a == ast.S_LET || a == ast.S_VAR {
        let init: u32 = ast.s_c(b, i)
        // HOOK fehlerunionen (lower_errors.rs::hook_let): die implizite
        // Umwandlung schreibt die Union selbst in den neuen Platz.
        if has_fe(l) {
            let cu: u32 = err.error_coerce_open(fel(l), init)
            if cu != KEIN {
                let us: usize = err.error_u_sidx(fel(l), cu) as usize
                var g: u64 = types.st_size(tf(l), us)
                if g < 1 { g = 1 }
                var al: u64 = types.st_alignment(tf(l), us)
                if al < 1 { al = 1 }
                let slot: u32 = alloca(l, g, al)
                union_write(l, slot, init, cu)
                create(l, ast.s_a(b, i), slot)
                return
            }
        }
        let t: u32 = sema.sema_ty(sm(l), init)
        if !is_aggregate(l, t) {
            let ft: u32 = fty(l, t)
            if ft == fir.KEIN || ft == fir.T_VOID {
                give_up(l)
                return
            }
        }
        let slot: u32 = alloca(l, q_size(l, t), q_align(l, t))
        write_after(l, slot, init)
        create(l, ast.s_a(b, i), slot)
        return
    }
    if a == ast.S_ZUW {
        let addr: u32 = address(l, ast.s_a(b, i))
        write_after(l, addr, ast.s_b(b, i))
        // HOOK gc (gc_lower.rs::hook_assign): die Einfuegebarriere NACH dem
        // Schreiben eines Gc-Zeigers in ein Heapfeld.
        if has_gc(l) {
            gc_barrier(l, ast.s_a(b, i))
        }
        return
    }
    if a == ast.S_EXPR {
        let e: u32 = ast.s_a(b, i)
        let ea: u32 = ast.e_kind(b, e)
        // HOOK fehlerunionen (lower_errors.rs::hook_stmt): `try`/`catch`/
        // Fehlerwert als Anweisung — der Wert wird verworfen, der Weg zu
        // ihm bleibt.
        if ea == ast.E_RUF && has_fe(l) && ast.e_number(b, e) == 0 {
            let nm: u32 = ast.e_a(b, e)
            if err.error_is_tryname(names(l), nm) {
                try_address(l, e)
                return
            }
            if err.error_is_catchname(names(l), nm) {
                catch_slot(l, e)
                return
            }
            let cc: i64 = err.error_ctor_code((*l).feh, names(l), nm)
            if cc >= 0 {
                let t: u32 = sema.sema_ty(sm(l), e)
                let slot: u32 = alloca(l, q_size(l, t), q_align(l, t))
                let cv: u32 = constant(l, fir.T_U32, cc as u64)
                store(l, fir.T_U32, slot, cv)
                return
            }
        }
        if ea == ast.E_RUF && has_mu(l) && ast.e_number(b, e) == 0 {
            // HOOK enum/match (lower_match.rs::lower_types_stmt).
            let nm: u32 = ast.e_a(b, e)
            if pattern.pat_is_matchname(names(l), nm) {
                match_lower(l, pattern.pat_match_number(names(l), nm))
                return
            }
            if pattern.pat_is_ctorname(names(l), nm) {
                // Der Wert wird verworfen, braucht aber einen Platz.
                let t: u32 = sema.sema_ty(sm(l), e)
                let slot: u32 = alloca(l, q_size(l, t), q_align(l, t))
                ctor_write(l, e, slot)
                return
            }
        }
        if ea == ast.E_RUF {
            let t: u32 = sema.sema_ty(sm(l), e)
            if is_aggregate(l, t) {
                // Das Ergebnis wird verworfen, braucht aber einen Platz.
                let slot: u32 = alloca(l, q_size(l, t), q_align(l, t))
                call_with_target(l, e, slot)
                return
            }
            call(l, e, fty(l, t))
            return
        }
        if ea == ast.E_SYSCALL {
            value(l, e)
            return
        }
        value(l, e)
        return
    }
    if a == ast.S_BLOCK {
        block(l, ast.s_a(b, i))
        return
    }
    if a == ast.S_RET {
        let wv: u32 = ast.s_a(b, i)
        if wv == ast.NICHTS {
            defer_to(l, 0)
            term(l, fir.TERM_RET, KEIN, 0, 0)
        } else {
            // EHRLICHE GRENZE (SPEC §14.1 F5, lower.rs): eine FERTIGE
            // Fehlerunion zurueckgeben, waehrend ein `errdefer` aktiv ist —
            // erst zur Laufzeit stuende fest, ob das der Fehlerpfad ist.
            // Abgelehnt statt still uebergangen. Bei einer Umwandlung
            // (`return E::Variante`, `return wert`) ist der Typ von `wv` der
            // QUELLtyp und diese Bedingung greift nicht.
            if has_fe(l) && has_errdefer(l) {
                let rt0: u32 = sema.sema_ty(sm(l), wv)
                if err.error_union_of_ty(fel(l), tf(l), rt0) != KEIN {
                    (*l).err = (*l).err + 1
                    return
                }
            }
            // HOOK fehlerunionen (lower_errors.rs::hook_return): die
            // implizite Umwandlung bei 'return'.
            var converted: bool = false
            if has_fe(l) {
                let cu: u32 = err.error_coerce_open(fel(l), wv)
                if cu != KEIN {
                    error_return(l, wv, cu)
                    converted = true
                }
            }
            if !converted {
            let t: u32 = sema.sema_ty(sm(l), wv)
            if is_aggregate(l, t) {
                // Aggregatrueckgabe nach `abi`: ueber den versteckten Zeiger
                // oder in EINEM Wort.
                let gr: u64 = types.size_of(tf(l), t)
                if (*l).sret != KEIN {
                    write_after(l, (*l).sret, wv)
                    defer_to(l, 0)
                    term(l, fir.TERM_RET, (*l).sret, 0, 0)
                } else {
                    let addr: u32 = address(l, wv)
                    var w: Vec[u32] = vec_new[u32]()
                    words_load(l, addr, gr, 1, &w)
                    let w0: u32 = vec_at[u32](&w, 0)
                    vec_free[u32](&w)
                    defer_to(l, 0)
                    term(l, fir.TERM_RET, w0, 0, 0)
                }
            } else {
                let v: u32 = value(l, wv)
                defer_to(l, 0)
                term(l, fir.TERM_RET, v, 0, 0)
            }
            }
        }
        // Alles danach ist unerreichbar: neuen Block oeffnen, damit die
        // Zusicherung "ein Terminator je Block" gilt.
        (*l).cur = new_block(l)
        return
    }
    if a == ast.S_IF {
        let c: u32 = value(l, ast.s_a(b, i))
        let then: u32 = new_block(l)
        let els: u32 = new_block(l)
        let join: u32 = new_block(l)
        term(l, fir.TERM_BRCOND, c, then, els)
        (*l).cur = then
        block(l, ast.s_b(b, i))
        if !terminated(l) {
            term(l, fir.TERM_BR, join, 0, 0)
        }
        (*l).cur = els
        if ast.s_c(b, i) != ast.NICHTS {
            stmt(l, ast.s_c(b, i))
        }
        if !terminated(l) {
            term(l, fir.TERM_BR, join, 0, 0)
        }
        (*l).cur = join
        return
    }
    if a == ast.S_WHILE {
        let header: u32 = new_block(l)
        let body: u32 = new_block(l)
        let end: u32 = new_block(l)
        term(l, fir.TERM_BR, header, 0, 0)
        (*l).cur = header
        let c: u32 = value(l, ast.s_a(b, i))
        term(l, fir.TERM_BRCOND, c, body, end)
        (*l).cur = body
        vec_push[u32](&(*l).l_break, end)
        vec_push[u32](&(*l).l_cont, header)
        vec_push[u32](&(*l).l_depth, vec_len[u32](&(*l).d_limit) as u32)
        block(l, ast.s_b(b, i))
        vec_pop[u32](&(*l).l_break)
        vec_pop[u32](&(*l).l_cont)
        vec_pop[u32](&(*l).l_depth)
        if !terminated(l) {
            term(l, fir.TERM_BR, header, 0, 0)
        }
        (*l).cur = end
        return
    }
    if a == ast.S_FOR {
        let t: u32 = sema.sema_ty(sm(l), ast.s_b(b, i))
        let ft: u32 = fty(l, t)
        if ft == fir.KEIN || ft == fir.T_VOID {
            give_up(l)
            return
        }
        var bytes: u64 = fir.fty_bytes(ft)
        if bytes < 1 { bytes = 1 }
        let islot: u32 = alloca(l, bytes, bytes)
        let sv: u32 = value(l, ast.s_b(b, i))
        store(l, ft, islot, sv)
        // Die Obergrenze wird EINMAL ausgewertet.
        let eslot: u32 = alloca(l, bytes, bytes)
        let ev: u32 = value(l, ast.s_c(b, i))
        store(l, ft, eslot, ev)

        let header: u32 = new_block(l)
        let body: u32 = new_block(l)
        let step: u32 = new_block(l)
        let end: u32 = new_block(l)
        term(l, fir.TERM_BR, header, 0, 0)

        (*l).cur = header
        let iv: u32 = load(l, ft, islot)
        let lim: u32 = load(l, ft, eslot)
        let c: u32 = push(l, fir.O_CMP, fir.T_BOOL, iv, lim, 2, ft as u64, 0, 0)
        term(l, fir.TERM_BRCOND, c, body, end)

        (*l).cur = body
        range_on(l)
        create(l, ast.s_a(b, i), islot)
        vec_push[u32](&(*l).l_break, end)
        vec_push[u32](&(*l).l_cont, step)
        vec_push[u32](&(*l).l_depth, vec_len[u32](&(*l).d_limit) as u32)
        block(l, ast.s_d(b, i))
        vec_pop[u32](&(*l).l_break)
        vec_pop[u32](&(*l).l_cont)
        vec_pop[u32](&(*l).l_depth)
        range_zu(l)
        if !terminated(l) {
            term(l, fir.TERM_BR, step, 0, 0)
        }

        (*l).cur = step
        let iv2: u32 = load(l, ft, islot)
        let one: u32 = constant(l, ft, 1)
        let inc: u32 = push(l, fir.O_BIN, ft, iv2, one, 0, 0, 0, 0)
        store(l, ft, islot, inc)
        term(l, fir.TERM_BR, header, 0, 0)

        (*l).cur = end
        return
    }
    if a == ast.S_BREAK {
        defer_to(l, vec_last[u32](&(*l).l_depth))
        term(l, fir.TERM_BR, vec_last[u32](&(*l).l_break), 0, 0)
        (*l).cur = new_block(l)
        return
    }
    if a == ast.S_CONT {
        defer_to(l, vec_last[u32](&(*l).l_depth))
        term(l, fir.TERM_BR, vec_last[u32](&(*l).l_cont), 0, 0)
        (*l).cur = new_block(l)
        return
    }
    if a == ast.S_DEFER || a == ast.S_ERRDEFER {
        // Nur VORMERKEN — ausgefuehrt wird beim Verlassen des Blocks.
        vec_push[u32](&(*l).d_stmt, ast.s_a(b, i))
        if a == ast.S_ERRDEFER {
            vec_push[u32](&(*l).d_err, 1)
        } else {
            vec_push[u32](&(*l).d_err, 0)
        }
        return
    }
}

fn block(l: *mut Lower, bi: u32) {
    let b: *mut ast.Tree = tree(l)
    range_on(l)
    defer_level_on(l)
    var k: u32 = 0
    while k < ast.b_len(b, bi) {
        stmt(l, ast.slist_at(b, ast.b_off(b, bi) + k))
        k = k + 1
    }
    // Die aufgeschobenen Anweisungen laufen VOR dem Schliessen des Bereichs,
    // damit die Namen des Blocks noch sichtbar sind.
    defer_level_zu(l)
    range_zu(l)
}

// ------------------------------------------- enum/match (lower_match.rs)
//
// Portierung des Lowerings von `match` und Aufzaehlungskonstruktoren.
// Ergebnis ist ein `switch` ueber die Variantennummer (bzw. den
// Ganzzahlwert); Untermuster werden als Kette von Vergleichen HINTER dem
// Sprung geprueft. Die Reihenfolge der erzeugten Instruktionen und Bloecke
// ist Vertrag — `tools/fir_compare.sh` vergleicht Oktett fuer Oktett.

// Bereichsmuster bis zu dieser Weite werden in einzelne Sprungmarken
// aufgeloest; breitere werden als Vergleich geprueft (MAX_RANGE_KEYS).
const MAX_BEREICH_MARKEN: i64 = 256

// Schreibt `Enum::Variante(a, b)` unmittelbar an die Adresse `adr`.
fn ctor_write(l: *mut Lower, e: u32, addr: u32) {
    let b: *mut ast.Tree = tree(l)
    let m: *mut pattern.Pat = mul(l)
    let t: u32 = sema.sema_ty(sm(l), e)
    if types.ty_kind(tf(l), t) != types.K_STRUCT {
        (*l).err = (*l).err + 1
        return
    }
    let ei: u32 = pattern.pat_enum_at_struct(m, types.ty_a(tf(l), t))
    if ei == KEIN {
        (*l).err = (*l).err + 1
        return
    }
    // Variantenname aus dem Aufrufnamen (hinter dem ersten `::`).
    let it: *mut intern.Interner = names(l)
    let zp: u64 = intern.intern_ptr(it, ast.e_a(b, e))
    let zn: usize = intern.intern_length(it, ast.e_a(b, e))
    var vname: u32 = KEIN
    var i: usize = 0
    while i + 1 < zn {
        if rt.ld8(zp, i) == 58 as u8 && rt.ld8(zp, i + 1) == 58 as u8 {
            vname = intern.intern_number(it, zp + (i + 2) as u64, zn - i - 2) as u32
            break
        }
        i = i + 1
    }
    let vi: u32 = pattern.pat_variant_find(m, ei, vname)
    if vi == KEIN {
        (*l).err = (*l).err + 1
        return
    }
    // Zuerst die Variantennummer, dann die Nutzdatenfelder.
    let tk: u32 = constant(l, fir.T_U32, pattern.pat_v_tag(m, vi) as u64)
    store(l, fir.T_U32, addr, tk)
    let roff: u32 = pattern.pat_v_roff(m, vi)
    let cnt: u32 = ast.e_c(b, e)
    var k: u32 = 0
    while k < cnt {
        let off: u64 = pattern.pat_rf_off(m, roff + k)
        let ad: u32 = ptradd_const(l, addr, off)
        write_after(l, ad, ast.child_at(b, ast.e_b(b, e) + k))
        k = k + 1
    }
}

// Was ein Fall zum Schluessel beitraegt (ArmPlan in lower_match.rs):
// pl_hat = 0 heisst "kommt fuer JEDEN Schluessel in Frage", pl_test = 1
// heisst "nach dem Schluessel sind noch Vergleiche noetig". Die Marken eines
// Falls liegen flach in `pk`.
fn plan_arm(l: *mut Lower, pat: u32, sj_ei: u32,
            pl_has: *mut Vec[u32], pl_test: *mut Vec[u32],
            pl_off: *mut Vec[u32], pl_len: *mut Vec[u32], pk: *mut Vec[i64]) {
    let m: *mut pattern.Pat = mul(l)
    let a: u32 = pattern.pat_mu_kind(m, pat)
    vec_push[u32](pl_off, vec_len[i64](pk) as u32)
    if a == pattern.MU_WILD || a == pattern.MU_BIND {
        vec_push[u32](pl_has, 0)
        vec_push[u32](pl_test, 0)
        vec_push[u32](pl_len, 0)
        return
    }
    if a == pattern.MU_INT {
        vec_push[u32](pl_has, 1)
        vec_push[u32](pl_test, 0)
        vec_push[i64](pk, pattern.pat_mu_lo(m, pat))
        vec_push[u32](pl_len, 1)
        return
    }
    if a == pattern.MU_BOOL {
        vec_push[u32](pl_has, 1)
        vec_push[u32](pl_test, 0)
        vec_push[i64](pk, pattern.pat_mu_a(m, pat) as i64)
        vec_push[u32](pl_len, 1)
        return
    }
    if a == pattern.MU_BEREICH {
        let lo: i64 = pattern.pat_mu_lo(m, pat)
        var last: i64 = pattern.pat_mu_hi(m, pat)
        if pattern.pat_mu_a(m, pat) == 0 {
            last = last - 1
        }
        let extent: i64 = last - lo + 1
        if extent > 0 && extent <= MAX_BEREICH_MARKEN {
            vec_push[u32](pl_has, 1)
            vec_push[u32](pl_test, 0)
            var v: i64 = lo
            var n: u32 = 0
            while v <= last {
                vec_push[i64](pk, v)
                n = n + 1
                v = v + 1
            }
            vec_push[u32](pl_len, n)
        } else {
            vec_push[u32](pl_has, 0)
            vec_push[u32](pl_test, 1)
            vec_push[u32](pl_len, 0)
        }
        return
    }
    // MU_VARIANT: der Schluessel ist die Variantennummer; Restpruefung, wenn
    // ein Untermuster nicht unanfechtbar ist.
    let vi: u32 = pattern.pat_variant_find(m, sj_ei, pattern.pat_mu_b(m, pat))
    var tag: i64 = 0 - 1
    if vi != KEIN {
        tag = pattern.pat_v_tag(m, vi) as i64
    }
    vec_push[u32](pl_has, 1)
    vec_push[i64](pk, tag)
    vec_push[u32](pl_len, 1)
    var test: u32 = 0
    let soff: u32 = pattern.pat_mu_soff(m, pat)
    let slen: u32 = pattern.pat_mu_slen(m, pat)
    var k: u32 = 0
    while k < slen {
        if !pattern.pat_irrefutable(m, pattern.pat_mu_child(m, soff + k)) {
            test = 1
        }
        k = k + 1
    }
    vec_push[u32](pl_test, test)
}

// Faelle, die fuer `key` (bzw. fuer die Auffangkette) in Frage kommen —
// Quelltextreihenfolge; nach dem ersten Fall ohne Restpruefung ist Schluss.
fn candidates(l: *mut Lower, pl_has: *mut Vec[u32], pl_test: *mut Vec[u32],
              pl_off: *mut Vec[u32], pl_len: *mut Vec[u32], pk: *mut Vec[i64],
              alen: u32, has_key: bool, key: i64, out: *mut Vec[u32]) {
    var i: u32 = 0
    while i < alen {
        var fits: bool = false
        if vec_at[u32](pl_has, i as usize) == 0 {
            fits = true
        } else if has_key {
            let off: u32 = vec_at[u32](pl_off, i as usize)
            let len: u32 = vec_at[u32](pl_len, i as usize)
            var k: u32 = 0
            while k < len {
                if vec_at[i64](pk, (off + k) as usize) == key {
                    fits = true
                }
                k = k + 1
            }
        }
        if fits {
            vec_push[u32](out, i)
            if vec_at[u32](pl_test, i as usize) == 0 {
                return
            }
        }
        i = i + 1
    }
}

// Restpruefung EINES Untermusters an der Adresse `adr`. Bei Erfolg faellt
// der Ablauf durch, bei Misserfolg geht es nach `fail`.
fn under_test(l: *mut Lower, addr: u32, pat: u32, ty: u32, fail: u32) {
    let m: *mut pattern.Pat = mul(l)
    let a: u32 = pattern.pat_mu_kind(m, pat)
    if a == pattern.MU_WILD || a == pattern.MU_BIND {
        return
    }
    if a == pattern.MU_INT {
        let ft: u32 = fty(l, ty)
        let av: u32 = load(l, ft, addr)
        let bv: u32 = constant(l, ft, pattern.pat_mu_lo(m, pat) as u64)
        let c: u32 = push(l, fir.O_CMP, fir.T_BOOL, av, bv, 0, ft as u64, 0, 0)
        let nb: u32 = new_block(l)
        term(l, fir.TERM_BRCOND, c, nb, fail)
        (*l).cur = nb
        return
    }
    if a == pattern.MU_BOOL {
        let av: u32 = load(l, fir.T_BOOL, addr)
        let bv: u32 = constant(l, fir.T_BOOL, pattern.pat_mu_a(m, pat) as u64)
        let c: u32 = push(l, fir.O_CMP, fir.T_BOOL, av, bv, 0, fir.T_BOOL as u64, 0, 0)
        let nb: u32 = new_block(l)
        term(l, fir.TERM_BRCOND, c, nb, fail)
        (*l).cur = nb
        return
    }
    if a == pattern.MU_BEREICH {
        let ft: u32 = fty(l, ty)
        var last: i64 = pattern.pat_mu_hi(m, pat)
        if pattern.pat_mu_a(m, pat) == 0 {
            last = last - 1
        }
        let av: u32 = load(l, ft, addr)
        let k1: u32 = constant(l, ft, pattern.pat_mu_lo(m, pat) as u64)
        let c1: u32 = push(l, fir.O_CMP, fir.T_BOOL, av, k1, 5, ft as u64, 0, 0)
        let nb: u32 = new_block(l)
        term(l, fir.TERM_BRCOND, c1, nb, fail)
        (*l).cur = nb
        let k2: u32 = constant(l, ft, last as u64)
        let c2: u32 = push(l, fir.O_CMP, fir.T_BOOL, av, k2, 3, ft as u64, 0, 0)
        let nb2: u32 = new_block(l)
        term(l, fir.TERM_BRCOND, c2, nb2, fail)
        (*l).cur = nb2
        return
    }
    // MU_VARIANT: erst die Variantennummer, dann die Untermuster.
    if types.ty_kind(tf(l), ty) != types.K_STRUCT {
        (*l).err = (*l).err + 1
        return
    }
    let ei: u32 = pattern.pat_enum_at_struct(m, types.ty_a(tf(l), ty))
    if ei == KEIN {
        (*l).err = (*l).err + 1
        return
    }
    let vi: u32 = pattern.pat_variant_find(m, ei, pattern.pat_mu_b(m, pat))
    if vi == KEIN {
        (*l).err = (*l).err + 1
        return
    }
    let av: u32 = load(l, fir.T_U32, addr)
    let bv: u32 = constant(l, fir.T_U32, pattern.pat_v_tag(m, vi) as u64)
    let c: u32 = push(l, fir.O_CMP, fir.T_BOOL, av, bv, 0, fir.T_U32 as u64, 0, 0)
    let nb: u32 = new_block(l)
    term(l, fir.TERM_BRCOND, c, nb, fail)
    (*l).cur = nb
    let soff: u32 = pattern.pat_mu_soff(m, pat)
    let slen: u32 = pattern.pat_mu_slen(m, pat)
    let roff: u32 = pattern.pat_v_roff(m, vi)
    var k: u32 = 0
    while k < slen {
        let sub: u32 = pattern.pat_mu_child(m, soff + k)
        if !pattern.pat_irrefutable(m, sub) {
            let off: u64 = pattern.pat_rf_off(m, roff + k)
            let ft: u32 = pattern.pat_rf_ty(m, roff + k)
            let sa: u32 = ptradd_const(l, addr, off)
            under_test(l, sa, sub, ft, fail)
        }
        k = k + 1
    }
}

// Restpruefungen eines Musters auf oberster Ebene (emit_tests).
fn pattern_tests(l: *mut Lower, base: u32, pat: u32, sj_ei: u32,
                schl: u32, kft: u32, fail: u32) {
    let m: *mut pattern.Pat = mul(l)
    let a: u32 = pattern.pat_mu_kind(m, pat)
    if a == pattern.MU_WILD || a == pattern.MU_BIND || a == pattern.MU_INT {
        return
    }
    if a == pattern.MU_BOOL {
        return
    }
    if a == pattern.MU_BEREICH {
        var last: i64 = pattern.pat_mu_hi(m, pat)
        if pattern.pat_mu_a(m, pat) == 0 {
            last = last - 1
        }
        // Schluessel direkt vergleichen (kein load — er liegt schon vor).
        let k1: u32 = constant(l, kft, pattern.pat_mu_lo(m, pat) as u64)
        let c1: u32 = push(l, fir.O_CMP, fir.T_BOOL, schl, k1, 5, kft as u64, 0, 0)
        let nb: u32 = new_block(l)
        term(l, fir.TERM_BRCOND, c1, nb, fail)
        (*l).cur = nb
        let k2: u32 = constant(l, kft, last as u64)
        let c2: u32 = push(l, fir.O_CMP, fir.T_BOOL, schl, k2, 3, kft as u64, 0, 0)
        let nb2: u32 = new_block(l)
        term(l, fir.TERM_BRCOND, c2, nb2, fail)
        (*l).cur = nb2
        return
    }
    // MU_VARIANT: der Schluessel (Variantennummer) ist schon geprueft; hier
    // nur die Untermuster, die nicht unanfechtbar sind.
    let vi: u32 = pattern.pat_variant_find(m, sj_ei, pattern.pat_mu_b(m, pat))
    if vi == KEIN {
        (*l).err = (*l).err + 1
        return
    }
    let soff: u32 = pattern.pat_mu_soff(m, pat)
    let slen: u32 = pattern.pat_mu_slen(m, pat)
    let roff: u32 = pattern.pat_v_roff(m, vi)
    var k: u32 = 0
    while k < slen {
        let sub: u32 = pattern.pat_mu_child(m, soff + k)
        if !pattern.pat_irrefutable(m, sub) {
            let off: u64 = pattern.pat_rf_off(m, roff + k)
            let ft: u32 = pattern.pat_rf_ty(m, roff + k)
            let sa: u32 = ptradd_const(l, base, off)
            under_test(l, sa, sub, ft, fail)
        }
        k = k + 1
    }
}

// Die Pruefkette eines Schluessels (emit_chain): probiert die Kandidaten in
// Quelltextreihenfolge; der letzte Ausweg ist `fallthrough`.
fn chain(l: *mut Lower, mi: u32, cands: *mut Vec[u32],
         pl_test: *mut Vec[u32], base: u32, schl: u32, kft: u32,
         sj_ei: u32, body: *mut Vec[u32], fallthrough: u32) -> u32 {
    let m: *mut pattern.Pat = mul(l)
    let entry: u32 = new_block(l)
    (*l).cur = entry
    var ci: usize = 0
    while ci < vec_len[u32](cands) {
        let ai: u32 = vec_at[u32](cands, ci)
        let body_bb: u32 = vec_at[u32](body, ai as usize)
        if vec_at[u32](pl_test, ai as usize) == 0 {
            term(l, fir.TERM_BR, body_bb, 0, 0)
            return entry
        }
        let fail: u32 = new_block(l)
        let aoff: u32 = pattern.pat_m_aoff(m, mi)
        pattern_tests(l, base, pattern.pat_a_pat(m, aoff + ai), sj_ei, schl, kft, fail)
        term(l, fir.TERM_BR, body_bb, 0, 0)
        (*l).cur = fail
        ci = ci + 1
    }
    term(l, fir.TERM_BR, fallthrough, 0, 0)
    return entry
}

// Bindungen eines Musters: jede Bindung ist die ADRESSE des getroffenen
// Werts (Aufzaehlungswerte liegen im Speicher).
fn pattern_bind(l: *mut Lower, addr: u32, pat: u32, ty: u32, sj_ei: u32) {
    let m: *mut pattern.Pat = mul(l)
    let a: u32 = pattern.pat_mu_kind(m, pat)
    if a == pattern.MU_BIND {
        create(l, pattern.pat_mu_a(m, pat), addr)
        return
    }
    if a == pattern.MU_VARIANT {
        var ei: u32 = sj_ei
        if ei == KEIN {
            if types.ty_kind(tf(l), ty) == types.K_STRUCT {
                ei = pattern.pat_enum_at_struct(m, types.ty_a(tf(l), ty))
            }
        }
        if ei == KEIN {
            return
        }
        let vi: u32 = pattern.pat_variant_find(m, ei, pattern.pat_mu_b(m, pat))
        if vi == KEIN {
            return
        }
        let soff: u32 = pattern.pat_mu_soff(m, pat)
        let slen: u32 = pattern.pat_mu_slen(m, pat)
        let roff: u32 = pattern.pat_v_roff(m, vi)
        var k: u32 = 0
        while k < slen {
            let off: u64 = pattern.pat_rf_off(m, roff + k)
            let ft: u32 = pattern.pat_rf_ty(m, roff + k)
            let sa: u32 = ptradd_const(l, addr, off)
            pattern_bind(l, sa, pattern.pat_mu_child(m, soff + k), ft, KEIN)
            k = k + 1
        }
        return
    }
}

// Das `match` mit der Nummer `mi` lowern (lower_match in lower_match.rs).
fn match_lower(l: *mut Lower, mi: u32) {
    let m: *mut pattern.Pat = mul(l)
    let b: *mut ast.Tree = tree(l)
    if mi as usize >= pattern.pat_match_count(m) {
        (*l).err = (*l).err + 1
        return
    }
    let subj: u32 = pattern.pat_m_subj(m, mi)
    let sty: u32 = sema.sema_ty(sm(l), subj)
    var sj_ei: u32 = KEIN
    if types.ty_kind(tf(l), sty) == types.K_STRUCT {
        sj_ei = pattern.pat_enum_at_struct(m, types.ty_a(tf(l), sty))
    }

    // Schluesselwert und Adresse des Subjekts bestimmen. Eine Aufzaehlung
    // liegt im Speicher: Schluessel ist die geladene Variantennummer (u32).
    // Sonst ist der Wert selbst der Schluessel, und die Adresse ist ein
    // Zwischenplatz fuer moegliche Bindungen.
    var base: u32 = 0
    var schl: u32 = 0
    var kft: u32 = fir.T_U32
    if sj_ei != KEIN {
        base = address(l, subj)
        schl = load(l, fir.T_U32, base)
    } else {
        kft = e_fty(l, subj)
        let v: u32 = value(l, subj)
        base = alloca(l, q_size(l, sty), q_align(l, sty))
        store(l, kft, base, v)
        schl = v
    }
    let start: u32 = (*l).cur

    let aoff: u32 = pattern.pat_m_aoff(m, mi)
    let alen: u32 = pattern.pat_m_alen(m, mi)

    var pl_has: Vec[u32] = vec_new[u32]()
    var pl_test: Vec[u32] = vec_new[u32]()
    var pl_off: Vec[u32] = vec_new[u32]()
    var pl_len: Vec[u32] = vec_new[u32]()
    var pk: Vec[i64] = vec_new[i64]()
    var body: Vec[u32] = vec_new[u32]()
    defer vec_free[u32](&pl_has)
    defer vec_free[u32](&pl_test)
    defer vec_free[u32](&pl_off)
    defer vec_free[u32](&pl_len)
    defer vec_free[i64](&pk)
    defer vec_free[u32](&body)

    var ai: u32 = 0
    while ai < alen {
        plan_arm(l, pattern.pat_a_pat(m, aoff + ai), sj_ei,
                 &pl_has, &pl_test, &pl_off, &pl_len, &pk)
        vec_push[u32](&body, new_block(l))
        ai = ai + 1
    }
    let join: u32 = new_block(l)

    // Schluessel einsammeln: aufsteigend, duplikatfrei.
    var keys: Vec[i64] = vec_new[i64]()
    defer vec_free[i64](&keys)
    ai = 0
    while ai < alen {
        if vec_at[u32](&pl_has, ai as usize) != 0 {
            let off: u32 = vec_at[u32](&pl_off, ai as usize)
            let len: u32 = vec_at[u32](&pl_len, ai as usize)
            var k: u32 = 0
            while k < len {
                let key: i64 = vec_at[i64](&pk, (off + k) as usize)
                var da: bool = false
                var x: usize = 0
                while x < vec_len[i64](&keys) {
                    if vec_at[i64](&keys, x) == key {
                        da = true
                    }
                    x = x + 1
                }
                if !da {
                    vec_push[i64](&keys, key)
                }
                k = k + 1
            }
        }
        ai = ai + 1
    }
    // Aufsteigend sortieren (die Liste ist kurz — Einfuegesortierung).
    var i1: usize = 1
    while i1 < vec_len[i64](&keys) {
        let v: i64 = vec_at[i64](&keys, i1)
        var j: usize = i1
        while j > 0 {
            if vec_at[i64](&keys, j - 1) <= v {
                break
            }
            vec_set[i64](&keys, j, vec_at[i64](&keys, j - 1))
            j = j - 1
        }
        vec_set[i64](&keys, j, v)
        i1 = i1 + 1
    }

    // Auffangkette ZUERST (ihre Blocknummern kommen vor den Schluesselketten),
    // dann je Schluessel die Kandidatenkette.
    var cands: Vec[u32] = vec_new[u32]()
    defer vec_free[u32](&cands)
    candidates(l, &pl_has, &pl_test, &pl_off, &pl_len, &pk, alen, false, 0, &cands)
    let catch_bb: u32 = chain(l, mi, &cands, &pl_test, base, schl, kft,
                                sj_ei, &body, join)

    let sw_off: u32 = fir.sw_start(&(*l).f)
    var sw_len: u32 = 0
    var ki: usize = 0
    while ki < vec_len[i64](&keys) {
        let key: i64 = vec_at[i64](&keys, ki)
        vec_clear[u32](&cands)
        candidates(l, &pl_has, &pl_test, &pl_off, &pl_len, &pk, alen, true, key, &cands)
        let bb: u32 = chain(l, mi, &cands, &pl_test, base, schl, kft,
                            sj_ei, &body, catch_bb)
        fir.sw_add(&(*l).f, key, bb)
        sw_len = sw_len + 1
        ki = ki + 1
    }
    if sw_len == 0 {
        fir.term_set(&(*l).f, (*l).fi, start, fir.TERM_BR, catch_bb, 0, 0)
    } else {
        fir.term_switch(&(*l).f, (*l).fi, start, schl, kft, catch_bb, sw_off, sw_len)
    }

    // Rumpf jedes Falls.
    ai = 0
    while ai < alen {
        (*l).cur = vec_at[u32](&body, ai as usize)
        range_on(l)
        pattern_bind(l, base, pattern.pat_a_pat(m, aoff + ai), sty, sj_ei)
        block(l, pattern.pat_a_block(m, aoff + ai))
        range_zu(l)
        if !terminated(l) {
            term(l, fir.TERM_BR, join, 0, 0)
        }
        ai = ai + 1
    }
    (*l).cur = join
}

// ------------------------------------------------------------------- Lauf

// -------------------------------------- fehlerunionen (lower_errors.rs)
//
// Portierung des Lowerings von `try`, `catch`, `Menge::Variante` und der
// impliziten Umwandlung. Eine Fehlerunion ist ein gewoehnlicher Struct
// (`{ __err: u32, __val: T }`, 0 = Erfolg) — es braucht keine neue
// FIR-Instruktion, nur load/store, einen Vergleich und eine Verzweigung.
// Die Reihenfolge der erzeugten Instruktionen und Bloecke ist Vertrag,
// `tools/fir_compare.sh` vergleicht Oktett fuer Oktett.
//
// RUNDE 36: `ret_term_fehler` ist portiert — der Fehlerpfad
// (`return E::Variante`, `try`) laesst zusaetzlich die `errdefer`-
// Anweisungen laufen (`defer_bis_fehler`).

// Schreibt die Fehlerunion an `addr` — Erfolgswert oder Fehlercode
// (`write_union`). BUSY verhindert, dass der Rohwert-Zugriff erneut in
// die Umwandlung laeuft.
fn union_write(l: *mut Lower, addr: u32, e: u32, cu: u32) {
    err.error_busy_on(fel(l), e)
    let kind: u32 = err.error_coerce_kind(fel(l), e)
    if kind == err.FEHLER_AUS_WERT {
        let zero: u32 = constant(l, fir.T_U32, 0)
        store(l, fir.T_U32, addr, zero)
        let va: u32 = ptradd_const(l, addr, err.error_u_voff(fel(l), cu))
        write_after(l, va, e)
    } else {
        let code: u32 = error_code(l, e)
        store(l, fir.T_U32, addr, code)
    }
    err.error_busy_zu(fel(l), e)
}

// Fehlercode eines Ausdrucks vom Typ einer Fehlermenge (`error_code`):
// bei einer Variante die Konstante, sonst der geladene Code.
fn error_code(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(l)
    if ast.e_kind(b, e) == ast.E_RUF && ast.e_number(b, e) == 0 {
        let cc: i64 = err.error_ctor_code((*l).feh, names(l), ast.e_a(b, e))
        if cc >= 0 {
            return constant(l, fir.T_U32, cc as u64)
        }
    }
    let a: u32 = address(l, e)
    return load(l, fir.T_U32, a)
}

// `Menge::Variante` als Wert: ein Platz mit dem Code (`ctor_addr`).
fn ctor_address(l: *mut Lower, e: u32, code: u64) -> u32 {
    let t: u32 = sema.sema_ty(sm(l), e)
    let slot: u32 = alloca(l, q_size(l, t), q_align(l, t))
    let c: u32 = constant(l, fir.T_U32, code)
    store(l, fir.T_U32, slot, c)
    return slot
}

// Kopiert einen Wert vom Typ `t` von `src` nach `dst` (`copy_value`).
fn copy_value(l: *mut Lower, dst: u32, src: u32, t: u32) {
    if is_aggregate(l, t) {
        copymem(l, dst, src, types.size_of(tf(l), t))
        return
    }
    // Wie `scalar_fty` in lower_errors.rs: f64 ist dort ABSICHTLICH nicht
    // im Muster — kein Programm im Korpus hat `E!f64`; hier dasselbe.
    if types.ty_kind(tf(l), t) == types.K_F64 {
        return
    }
    let ft: u32 = fty(l, t)
    if ft == fir.KEIN || ft == fir.T_VOID {
        return
    }
    let v: u32 = load(l, ft, src)
    store(l, ft, dst, v)
}

// `return` mit impliziter Umwandlung in die Fehlerunion der Funktion
// (`do_return`).
fn error_return(l: *mut Lower, v: u32, cu: u32) {
    // `return E::Variante` ist der Fehlerpfad, `return wert` der
    // Erfolgspfad — der Typpruefer hat das entschieden (`coerce_art`).
    let error_path: bool = err.error_coerce_kind(fel(l), v) == err.FEHLER_AUS_FEHLER
    if (*l).sret != KEIN {
        union_write(l, (*l).sret, v, cu)
        if error_path {
            defer_to_error(l)
        } else {
            defer_to(l, 0)
        }
        term(l, fir.TERM_RET, (*l).sret, 0, 0)
        return
    }
    // Bis 8 Byte liegt die Fehlerunion in einem Wort in `rax` (abi). Der
    // Zwischenspeicher wird genullt, damit die Fuellbytes in jeder
    // Baustufe denselben Wert haben.
    let slot: u32 = alloca(l, 8, 8)
    let zero: u32 = constant(l, fir.T_I64, 0)
    store(l, fir.T_I64, slot, zero)
    union_write(l, slot, v, cu)
    let w: u32 = load(l, fir.T_I64, slot)
    if error_path {
        defer_to_error(l)
    } else {
        defer_to(l, 0)
    }
    term(l, fir.TERM_RET, w, 0, 0)
}

// Verlaesst die Funktion mit dem Fehlercode `code` (`return_error`) —
// IMMER der Fehlerpfad: hier laufen auch die `errdefer`-Anweisungen.
fn error_leave(l: *mut Lower, code: u32) {
    if (*l).sret != KEIN {
        store(l, fir.T_U32, (*l).sret, code)
        defer_to_error(l)
        term(l, fir.TERM_RET, (*l).sret, 0, 0)
        return
    }
    let slot: u32 = alloca(l, 8, 8)
    let zero: u32 = constant(l, fir.T_I64, 0)
    store(l, fir.T_I64, slot, zero)
    store(l, fir.T_U32, slot, code)
    let w: u32 = load(l, fir.T_I64, slot)
    defer_to_error(l)
    term(l, fir.TERM_RET, w, 0, 0)
}

// `try a` — liefert die Adresse des Erfolgswertes; im Fehlerfall wird die
// Funktion mit demselben Code verlassen (`try_value_addr`).
fn try_address(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(l)
    let u: u32 = err.error_try(fel(l), e)
    if u == KEIN {
        give_up(l)
        return 0
    }
    let arg: u32 = ast.child_at(b, ast.e_b(b, e))
    let src: u32 = address(l, arg)
    let code: u32 = load(l, fir.T_U32, src)
    let zero: u32 = constant(l, fir.T_U32, 0)
    let bad: u32 = push(l, fir.O_CMP, fir.T_BOOL, code, zero, 1,
                        fir.T_U32 as u64, 0, 0)
    let fail: u32 = new_block(l)
    let cont: u32 = new_block(l)
    term(l, fir.TERM_BRCOND, bad, fail, cont)
    (*l).cur = fail
    error_leave(l, code)
    (*l).cur = cont
    return ptradd_const(l, src, err.error_u_voff(fel(l), u))
}

// `a catch b` — liefert die Adresse des Ergebnisses (Erfolgswert oder
// Ersatz) in einem eigenen Platz (`catch_slot`).
fn catch_slot(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Tree = tree(l)
    let u: u32 = err.error_catch(fel(l), e)
    if u == KEIN {
        give_up(l)
        return 0
    }
    let lhs: u32 = ast.child_at(b, ast.e_b(b, e))
    let rhs: u32 = ast.child_at(b, ast.e_b(b, e) + 1)
    let vt: u32 = err.error_u_valty(fel(l), u)
    let slot: u32 = alloca(l, q_size(l, vt), q_align(l, vt))
    let src: u32 = address(l, lhs)
    let code: u32 = load(l, fir.T_U32, src)
    let zero: u32 = constant(l, fir.T_U32, 0)
    let good: u32 = push(l, fir.O_CMP, fir.T_BOOL, code, zero, 0,
                         fir.T_U32 as u64, 0, 0)
    let ok_bb: u32 = new_block(l)
    let old_bb: u32 = new_block(l)
    let join: u32 = new_block(l)
    term(l, fir.TERM_BRCOND, good, ok_bb, old_bb)

    (*l).cur = ok_bb
    let va: u32 = ptradd_const(l, src, err.error_u_voff(fel(l), u))
    copy_value(l, slot, va, vt)
    if !terminated(l) {
        term(l, fir.TERM_BR, join, 0, 0)
    }

    (*l).cur = old_bb
    // `catch |f| ...`: der Fehlerwert liegt im Ersatz als Variable.
    let bind: u32 = err.error_cb(fel(l), e)
    if bind != KEIN {
        range_on(l)
        let eslot: u32 = alloca(l, 4, 4)
        store(l, fir.T_U32, eslot, code)
        create(l, bind, eslot)
    }
    write_after(l, slot, rhs)
    if bind != KEIN {
        range_zu(l)
    }
    if !terminated(l) {
        term(l, fir.TERM_BR, join, 0, 0)
    }

    (*l).cur = join
    return slot
}

fn low_run(l: *mut Lower) {
    let b: *mut ast.Tree = tree(l)
    var i: usize = 0
    while i < ast.fn_count(b) {
        let rt2: u32 = types.ret_ty_the_func(tf(l), i)
        let ret_agg: bool = is_aggregate(l, rt2)
        let sret: bool = abi_sret(l, rt2)
        // FIR-Rueckgabetyp: Aggregat ueber den versteckten Zeiger, sonst ein
        // Wort in `rax`.
        var rf: u32 = 0
        if ret_agg {
            if sret {
                rf = fir.T_PTR
            } else {
                rf = fir.T_I64
            }
        } else {
            rf = fty(l, rt2)
            if rf == fir.KEIN {
                give_up(l)
                return
            }
        }
        // FIR-Parameter aus der Aufrufkonvention.
        let poff: u32 = vec_len[u32](&(*l).f.p_ty) as u32
        if sret {
            vec_push[u32](&(*l).f.p_ty, fir.T_PTR)
        }
        // Art je Quellparameter: >=0 Anzahl Woerter · KEIN Zeiger · sonst skalar
        var kind: Vec[u32] = vec_new[u32]()
        var k: u32 = 0
        while k < ast.fn_plen(b, i) {
            let pt: u32 = types.param_ty_resolved(tf(l), i, k)
            if is_aggregate(l, pt) {
                let kl: u32 = abi_class(l, pt)
                if kl != fir.KEIN {
                    var w: u32 = 0
                    while w < kl {
                        vec_push[u32](&(*l).f.p_ty, fir.T_I64)
                        w = w + 1
                    }
                    vec_push[u32](&kind, kl)
                } else {
                    vec_push[u32](&(*l).f.p_ty, fir.T_PTR)
                    vec_push[u32](&kind, KEIN)
                }
            } else {
                let pf: u32 = fty(l, pt)
                if pf == fir.KEIN || pf == fir.T_VOID {
                    give_up(l)
                    vec_free[u32](&kind)
                    return
                }
                vec_push[u32](&(*l).f.p_ty, pf)
                vec_push[u32](&kind, KEIN - 1)
            }
            k = k + 1
        }
        let plen: u32 = vec_len[u32](&(*l).f.p_ty) as u32 - poff
        (*l).fi = fir.fn_new(&(*l).f, ast.fn_name(b, i), rf, poff, plen)
        // RUNDE 52 (core.rs): `#[interrupt]` — eigene Aufrufkonvention.
        if ast.fn_int(b, i) != 0 {
            fir.f_int_set(&(*l).f, (*l).fi, 1)
        }
        (*l).cur = 0
        (*l).sret = KEIN
        var next: u32 = 0
        if sret {
            (*l).sret = fir.param_value(&(*l).f, (*l).fi, 0)
            next = 1
        }
        range_on(l)
        // Parameter bekommen einen Platz und werden im Eintrittsblock gesichert.
        k = 0
        while k < ast.fn_plen(b, i) {
            let pt: u32 = types.param_ty_resolved(tf(l), i, k)
            let ak: u32 = vec_at[u32](&kind, k as usize)
            let pname: u32 = ast.param_name(b, ast.fn_poff(b, i) + k)
            if ak == KEIN - 1 {
                let pf: u32 = vec_at[u32](&(*l).f.p_ty, (poff + next) as usize)
                var by: u64 = fir.fty_bytes(pf)
                if by < 1 { by = 1 }
                let slot: u32 = alloca(l, by, by)
                store(l, pf, slot, fir.param_value(&(*l).f, (*l).fi, next))
                next = next + 1
                create(l, pname, slot)
            } else if ak == KEIN {
                // Der Aufrufer hat bereits eine Kopie angelegt; ihre Adresse
                // IST der Platz des Parameters.
                create(l, pname, fir.param_value(&(*l).f, (*l).fi, next))
                next = next + 1
            } else {
                // Der Platz wird auf volle Woerter aufgefuellt, damit die
                // Stores vollstaendig im Objekt liegen.
                var gr: u64 = q_size(l, pt)
                if gr < ak as u64 * 8 {
                    gr = ak as u64 * 8
                }
                var au: u64 = q_align(l, pt)
                if au < 8 {
                    au = 8
                }
                let slot: u32 = alloca(l, gr, au)
                var w: u32 = 0
                while w < ak {
                    let a2: u32 = ptradd_const(l, slot, w as u64 * 8)
                    store(l, fir.T_I64, a2, fir.param_value(&(*l).f, (*l).fi, next + w))
                    w = w + 1
                }
                next = next + ak
                create(l, pname, slot)
            }
            k = k + 1
        }
        vec_free[u32](&kind)
        block(l, ast.fn_body(b, i))
        range_zu(l)
        if (*l).unsuitable {
            return
        }
        // Offene (unerreichbare) Bloecke abschliessen.
        var bb: u32 = 0
        while bb < fir.block_count(&(*l).f, (*l).fi) {
            if !fir.is_terminated(&(*l).f, (*l).fi, bb) {
                (*l).cur = bb
                if rf == fir.T_VOID {
                    term(l, fir.TERM_RET, KEIN, 0, 0)
                } else {
                    let v: u32 = constant(l, rf, 0)
                    term(l, fir.TERM_RET, v, 0, 0)
                }
            }
            bb = bb + 1
        }
        i = i + 1
    }
}
