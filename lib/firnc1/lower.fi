// lib/firnc1/lower.fi — VOM GEPRUEFTEN BAUM ZUR FIR, IN FIRN.
//
// Achter Teil von Stufe 1: die Portierung von `compiler/src/lower.rs`.
//
// UMFANG: der skalare Kern, die Aggregate UND `defer`/`errdefer`.
//
// AUFGESCHOBENE ANWEISUNGEN (SPEC §5.1) sind ein Stapel je BLOCKEBENE. Beim
// Verlassen eines Blocks laufen seine eigenen rueckwaerts; bei `return`
// laufen ALLE Ebenen der Funktion, bei `break`/`continue` nur die, die
// INNERHALB der Schleife vereinbart wurden. `errdefer` laeuft ausschliesslich
// auf dem FEHLERPFAD (`return E::Variante`, `try`) — seit Runde 36 ueber
// `defer_bis_fehler` (`ret_term_fehler` in Stufe 0, SPEC §5.1).
//
// AGGREGATE BEWEGEN SICH NIE ALS WERT, sondern immer ueber ADRESSEN. Es gibt
// genau zwei Wege: `schreib_nach(adr, e)` legt einen Ausdruck an einer Adresse
// ab, `adresse(e)` besorgt die Adresse eines vorhandenen Aggregats. Ein
// Struct-Literal wird feldweise geschrieben, ein fremdes Aggregat mit
// `copymem` kopiert.
//
// AN DER FUNKTIONSGRENZE entscheidet `abi` (SPEC §13, §14.1):
//   bis 16 Byte   -> ein oder zwei GANZZAHLWOERTER
//   darueber      -> ein versteckter Zeiger auf eine Kopie des Aufrufers
//   Rueckgabe > 8 -> versteckter Zeiger in `rdi` (`sret`)
//
// ZWEI DINGE, DIE MAN NICHT RATEN KANN und die deshalb genau nachgebaut sind:
//
//  1. Die WERTNUMMERN folgen der Reihenfolge des ANLEGENS, die gedruckte
//     Reihenfolge aber nicht: jede `alloca` wandert an den Anfang des
//     Eintrittsblocks. `%0 = alloca` und `%2 = alloca` koennen deshalb
//     untereinander stehen, obwohl `%1` dazwischen entstanden ist.
//  2. Nach `return`, `break` und `continue` wird ein NEUER, unerreichbarer
//     Block geoeffnet. Er bleibt im Text stehen (bb7, bb8 …) — die
//     Codebereinigung entfernt ihn erst spaeter. Wer ihn weglaesst, bekommt
//     einen anderen Text.

import rt
import vec
import intern
import ast
import typen
import sema
import fir
import muster
import fehler
import gc
import iface
import kern

export { Lower, low_neu, low_frei, low_lauf, low_fehler, low_fir, low_ungeeignet,
         low_mu_setzen, low_fe_setzen, low_gc_setzen, low_if_setzen }

const KEIN: u32 = 4294967295

struct Lower {
    b: u64              // Baum
    it: u64             // Interner
    sm: u64             // Sema
    f: fir.Fir
    fi: u32             // laufende Funktion
    cur: u32            // laufender Block
    v_name: Vec[u32]    // Bereiche: Name -> Platz
    v_slot: Vec[u32]
    b_grenze: Vec[u32]
    l_break: Vec[u32]   // Schleifenziele
    l_cont: Vec[u32]
    l_tiefe: Vec[u32]   // Stapeltiefe der aufgeschobenen Anweisungen je Schleife
    d_stmt: Vec[u32]    // aufgeschobene Anweisungen, in Reihenfolge der Vereinbarung
    d_err: Vec[u32]     // 1 = `errdefer`
    d_grenze: Vec[u32]  // Grenzen je Blockebene
    sret: u32
    mu: u64             // Register der Aufzaehlungen/Musterabgleiche (0 = keins)
    feh: u64            // Register der Fehlermengen/-unionen (0 = keins)
    gcr: u64            // Registrierung der gc-Klassen (Runde 34; 0 = keine)
    ifr: u64            // Registrierung der Schnittstellen (Runde 46; 0 = keine)
    fehler: usize
    ungeeignet: bool    // Aggregat oder `defer` gefunden
}

fn low_neu(b: u64, it: u64, sm: u64) -> Lower {
    return Lower{
        b: b, it: it, sm: sm,
        f: fir.fir_neu(),
        fi: 0, cur: 0,
        v_name: vec_neu[u32](), v_slot: vec_neu[u32](), b_grenze: vec_neu[u32](),
        l_break: vec_neu[u32](), l_cont: vec_neu[u32](), l_tiefe: vec_neu[u32](),
        d_stmt: vec_neu[u32](), d_err: vec_neu[u32](), d_grenze: vec_neu[u32](),
        sret: KEIN, mu: 0, feh: 0, gcr: 0, ifr: 0, fehler: 0, ungeeignet: false,
    }
}

fn low_frei(l: *mut Lower) {
    fir.fir_frei(&(*l).f)
    vec_frei[u32](&(*l).v_name)
    vec_frei[u32](&(*l).v_slot)
    vec_frei[u32](&(*l).b_grenze)
    vec_frei[u32](&(*l).l_break)
    vec_frei[u32](&(*l).l_cont)
    vec_frei[u32](&(*l).l_tiefe)
    vec_frei[u32](&(*l).d_stmt)
    vec_frei[u32](&(*l).d_err)
    vec_frei[u32](&(*l).d_grenze)
}

fn low_fehler(l: *mut Lower) -> usize { return (*l).fehler }

// Das Muster-Register anmelden. MUSS vor `low_lauf` stehen.
fn low_mu_setzen(l: *mut Lower, m: u64) { (*l).mu = m }

fn mul(l: *mut Lower) -> *mut muster.Mus { return (*l).mu as *mut muster.Mus }
fn hat_mu(l: *mut Lower) -> bool { return (*l).mu != 0 }

// Das Fehler-Register anmelden. MUSS vor `low_lauf` stehen.
fn low_fe_setzen(l: *mut Lower, f: u64) { (*l).feh = f }

// Die gc-Registrierung anmelden (Runde 34). MUSS vor `low_lauf` stehen.
fn low_gc_setzen(l: *mut Lower, g: u64) { (*l).gcr = g }

// Die Schnittstellen-Registrierung anmelden (Runde 46). MUSS vor
// `low_lauf` stehen.
fn low_if_setzen(l: *mut Lower, f: u64) { (*l).ifr = f }

fn fel(l: *mut Lower) -> *mut fehler.Fehler { return (*l).feh as *mut fehler.Fehler }
fn hat_fe(l: *mut Lower) -> bool { return (*l).feh != 0 }
fn gcl(l: *mut Lower) -> *mut gc.Gc { return (*l).gcr as *mut gc.Gc }
fn hat_gc(l: *mut Lower) -> bool { return (*l).gcr != 0 }
fn ifl(l: *mut Lower) -> *mut iface.If { return (*l).ifr as *mut iface.If }
fn hat_if(l: *mut Lower) -> bool { return (*l).ifr != 0 }
fn low_ungeeignet(l: *mut Lower) -> bool { return (*l).ungeeignet }
fn low_fir(l: *mut Lower) -> *mut fir.Fir { return &(*l).f }

fn baum(l: *mut Lower) -> *mut ast.Baum { return (*l).b as *mut ast.Baum }
fn sm(l: *mut Lower) -> *mut sema.Sema { return (*l).sm as *mut sema.Sema }
fn tf(l: *mut Lower) -> *mut typen.Typen { return sema.sema_typen(sm(l)) }
fn namen(l: *mut Lower) -> *mut intern.Interner { return (*l).it as *mut intern.Interner }

fn aufgeben(l: *mut Lower) {
    (*l).ungeeignet = true
}

// ------------------------------------------------- Typen: Quelle -> FIR

fn ist_aggregat(l: *mut Lower, t: u32) -> bool {
    let k: u32 = typen.ty_art(tf(l), t)
    return k == typen.K_ARR || k == typen.K_STRUCT
}

// FIR-Typ eines skalaren Quelltyps; fir.KEIN bei einem Aggregat.
fn fty(l: *mut Lower, t: u32) -> u32 {
    let k: u32 = typen.ty_art(tf(l), t)
    if k == typen.K_I8 { return fir.T_I8 }
    if k == typen.K_I16 { return fir.T_I16 }
    if k == typen.K_I32 { return fir.T_I32 }
    if k == typen.K_I64 { return fir.T_I64 }
    if k == typen.K_ISIZE { return fir.T_I64 }
    if k == typen.K_U8 { return fir.T_U8 }
    if k == typen.K_U16 { return fir.T_U16 }
    if k == typen.K_U32 { return fir.T_U32 }
    if k == typen.K_U64 { return fir.T_U64 }
    if k == typen.K_USIZE { return fir.T_U64 }
    if k == typen.K_BOOL { return fir.T_BOOL }
    if k == typen.K_F64 { return fir.T_F64 }
    if k == typen.K_PTR { return fir.T_PTR }
    if k == typen.K_VOID { return fir.T_VOID }
    return fir.KEIN
}

fn e_fty(l: *mut Lower, e: u32) -> u32 {
    return fty(l, sema.sema_typ(sm(l), e))
}

// ------------------------------------------------------------- Bausteine

fn push(l: *mut Lower, art: u32, ty: u32, a: u32, b: u32, c: u32, z: u64, aoff: u32, alen: u32) -> u32 {
    return fir.inst_dazu(&(*l).f, (*l).fi, (*l).cur, art, ty, a, b, c, z, aoff, alen)
}

fn push_void(l: *mut Lower, art: u32, ty: u32, a: u32, b: u32, c: u32, z: u64, aoff: u32, alen: u32) {
    fir.inst_void_dazu(&(*l).f, (*l).fi, (*l).cur, art, ty, a, b, c, z, aoff, alen)
}

fn konst(l: *mut Lower, ty: u32, v: u64) -> u32 {
    return push(l, fir.O_CONST, ty, 0, 0, 0, v, 0, 0)
}

fn lade(l: *mut Lower, ty: u32, adr: u32) -> u32 {
    return push(l, fir.O_LOAD, ty, adr, 0, 0, 0, 0, 0)
}

fn speichere(l: *mut Lower, ty: u32, adr: u32, wert: u32) {
    push_void(l, fir.O_STORE, ty, adr, wert, 0, 0, 0, 0)
}

fn alloca(l: *mut Lower, groesse: u64, ausricht: u64) -> u32 {
    return fir.alloca_dazu(&(*l).f, (*l).fi, groesse, ausricht)
}

fn neuer_block(l: *mut Lower) -> u32 {
    return fir.block_neu(&(*l).f, (*l).fi)
}

fn term(l: *mut Lower, art: u32, t1: u32, t2: u32, t3: u32) {
    fir.term_setzen(&(*l).f, (*l).fi, (*l).cur, art, t1, t2, t3)
}

fn terminiert(l: *mut Lower) -> bool {
    return fir.ist_terminiert(&(*l).f, (*l).fi, (*l).cur)
}

// ------------------------------------------------------------- Bereiche

fn bereich_auf(l: *mut Lower) {
    vec_push[u32](&(*l).b_grenze, vec_len[u32](&(*l).v_name) as u32)
}

fn bereich_zu(l: *mut Lower) {
    let g: u32 = vec_letztes[u32](&(*l).b_grenze)
    vec_pop[u32](&(*l).b_grenze)
    while vec_len[u32](&(*l).v_name) > g as usize {
        vec_pop[u32](&(*l).v_name)
        vec_pop[u32](&(*l).v_slot)
    }
}

fn anlegen(l: *mut Lower, name: u32, slot: u32) {
    vec_push[u32](&(*l).v_name, name)
    vec_push[u32](&(*l).v_slot, slot)
}

// ------------------------------------------- Aufgeschobene Anweisungen

fn defer_ebene_auf(l: *mut Lower) {
    vec_push[u32](&(*l).d_grenze, vec_len[u32](&(*l).d_stmt) as u32)
}

// Fuehrt die eigenen aufgeschobenen Anweisungen dieser Ebene aus (rueckwaerts)
// und raeumt die Ebene ab.
fn defer_ebene_zu(l: *mut Lower) {
    let g: u32 = vec_letztes[u32](&(*l).d_grenze)
    vec_pop[u32](&(*l).d_grenze)
    var i: usize = vec_len[u32](&(*l).d_stmt)
    while i > g as usize {
        i = i - 1
        // `errdefer` laeuft NICHT beim gewoehnlichen Verlassen.
        if vec_at[u32](&(*l).d_err, i) == 0 {
            anweisung(l, vec_at[u32](&(*l).d_stmt, i))
        }
    }
    while vec_len[u32](&(*l).d_stmt) > g as usize {
        vec_pop[u32](&(*l).d_stmt)
        vec_pop[u32](&(*l).d_err)
    }
}

// Fuehrt alle aufgeschobenen Anweisungen OBERHALB von `tiefe` aus — innerste
// Ebene zuerst, innerhalb einer Ebene rueckwaerts. Der Stapel bleibt dabei
// UNVERAENDERT: `defer_ebene_zu` raeumt seine eigene Ebene ab. Was danach
// noch erzeugt wird, landet im unerreichbaren Block hinter dem Sprung.
fn defer_bis_mf(l: *mut Lower, tiefe: u32, mit_fehler: bool) {
    var e: usize = vec_len[u32](&(*l).d_grenze)
    var ende: usize = vec_len[u32](&(*l).d_stmt)
    while e > tiefe as usize {
        e = e - 1
        let g: u32 = vec_at[u32](&(*l).d_grenze, e)
        var i: usize = ende
        while i > g as usize {
            i = i - 1
            // `errdefer` laeuft NUR auf dem Fehlerpfad (SPEC §5.1) —
            // `lower_defers_bis(tiefe, mit_fehler)` in Stufe 0.
            if vec_at[u32](&(*l).d_err, i) == 0 || mit_fehler {
                anweisung(l, vec_at[u32](&(*l).d_stmt, i))
            }
        }
        ende = g as usize
    }
}

fn defer_bis(l: *mut Lower, tiefe: u32) {
    defer_bis_mf(l, tiefe, false)
}

// Ruecksprung auf dem FEHLERPFAD: zusaetzlich laufen die `errdefer`-
// Anweisungen (`ret_term_fehler`, Runde 36).
fn defer_bis_fehler(l: *mut Lower) {
    defer_bis_mf(l, 0, true)
}

// Gibt es in dieser Funktion ein aktives `errdefer`? (`hat_errdefer`)
fn hat_errdefer(l: *mut Lower) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*l).d_err) {
        if vec_at[u32](&(*l).d_err, i) == 1 {
            return true
        }
        i = i + 1
    }
    return false
}

fn suchen(l: *mut Lower, name: u32) -> u32 {
    var i: usize = vec_len[u32](&(*l).v_name)
    while i > 0 {
        i = i - 1
        if vec_at[u32](&(*l).v_name, i) == name {
            return vec_at[u32](&(*l).v_slot, i)
        }
    }
    return KEIN
}

// --------------------------------------------------------------- Adressen

// Adresse eines zuweisbaren Ausdrucks.
fn adresse(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(l)
    let a: u32 = ast.e_art(b, e)
    // HOOK fehlerunionen (lower_errors.rs::hook_addr): ein Ausdruck mit
    // vorgemerkter Umwandlung liegt als fertige Union im Speicher.
    if hat_fe(l) {
        let cu: u32 = fehler.fehler_coerce_offen(fel(l), e)
        if cu != KEIN {
            let us: usize = fehler.fehler_u_sidx(fel(l), cu) as usize
            var g: u64 = typen.st_groesse(tf(l), us)
            if g < 1 { g = 1 }
            var al: u64 = typen.st_ausrichtung(tf(l), us)
            if al < 1 { al = 1 }
            let slot: u32 = alloca(l, g, al)
            union_schreiben(l, slot, e, cu)
            return slot
        }
    }
    if a == ast.E_ID {
        let slot: u32 = suchen(l, ast.e_a(b, e))
        if slot != KEIN {
            return slot
        }
        aufgeben(l)
        return 0
    }
    if a == ast.E_UN && ast.e_a(b, e) == 3 {
        return wert(l, ast.e_b(b, e))
    }
    if a == ast.E_FELD {
        let bt: u32 = sema.sema_typ(sm(l), ast.e_a(b, e))
        var si: usize = 0
        var basis: u32 = 0
        if typen.ty_art(tf(l), bt) == typen.K_STRUCT {
            si = typen.ty_a(tf(l), bt) as usize
            basis = adresse(l, ast.e_a(b, e))
        } else if typen.ty_art(tf(l), bt) == typen.K_PTR {
            // `p.f` auf einem Zeiger auf Struct: automatisch dereferenzieren.
            let inner: u32 = typen.ty_a(tf(l), bt)
            if typen.ty_art(tf(l), inner) != typen.K_STRUCT {
                aufgeben(l)
                return 0
            }
            si = typen.ty_a(tf(l), inner) as usize
            basis = wert(l, ast.e_a(b, e))
        } else {
            aufgeben(l)
            return 0
        }
        return ptradd_konst(l, basis, feld_versatz(l, si, ast.e_b(b, e)))
    }
    if a == ast.E_IDX {
        let bt: u32 = sema.sema_typ(sm(l), ast.e_a(b, e))
        var elem: u32 = 0
        var basis: u32 = 0
        if typen.ty_art(tf(l), bt) == typen.K_ARR {
            elem = typen.ty_a(tf(l), bt)
            basis = adresse(l, ast.e_a(b, e))
        } else if typen.ty_art(tf(l), bt) == typen.K_PTR {
            elem = typen.ty_a(tf(l), bt)
            basis = wert(l, ast.e_a(b, e))
        } else {
            aufgeben(l)
            return 0
        }
        let gr: u64 = q_groesse(l, elem)
        let ift: u32 = e_fty(l, ast.e_b(b, e))
        let iv: u32 = wert(l, ast.e_b(b, e))
        return elem_adresse(l, basis, iv, ift, gr)
    }
    if a == ast.E_SLIT || a == ast.E_ALIT || a == ast.E_AWDH {
        let t: u32 = sema.sema_typ(sm(l), e)
        let slot: u32 = alloca(l, q_groesse(l, t), q_ausricht(l, t))
        schreib_nach(l, slot, e)
        return slot
    }
    // HOOK iface: `((&x) as dyn I).m()` — der Schnittstellenwert bekommt
    // einen Zwischenplatz, dessen Adresse hier steht (iface.fi).
    if a == ast.E_AS {
        let t2: u32 = sema.sema_typ(sm(l), e)
        if ist_dyn_typ(l, t2) {
            let slot2: u32 = alloca(l, q_groesse(l, t2), q_ausricht(l, t2))
            schreib_nach(l, slot2, e)
            return slot2
        }
    }
    if a == ast.E_RUF {
        // HOOK fehlerunionen (lower_errors.rs::hook_addr): `try`, `catch`
        // und der reine Fehlerwert legen ihren Platz selbst an.
        if hat_fe(l) && ast.e_zahl(b, e) == 0 {
            let nm: u32 = ast.e_a(b, e)
            if fehler.fehler_ist_tryname(namen(l), nm) {
                return try_adresse(l, e)
            }
            if fehler.fehler_ist_catchname(namen(l), nm) {
                return catch_slot(l, e)
            }
            let cc: i64 = fehler.fehler_ctor_code((*l).feh, namen(l), nm)
            if cc >= 0 {
                return ctor_adresse(l, e, cc as u64)
            }
        }
        // HOOK enum (lower_match.rs): der Konstruktor legt den Wert selbst an.
        if hat_mu(l) && ast.e_zahl(b, e) == 0 {
            if muster.mus_ist_ctorname(namen(l), ast.e_a(b, e)) {
                let t: u32 = sema.sema_typ(sm(l), e)
                let slot: u32 = alloca(l, q_groesse(l, t), q_ausricht(l, t))
                ctor_schreiben(l, e, slot)
                return slot
            }
        }
        // Ein Aufruf, der ein Aggregat liefert, schreibt in einen
        // Zwischenspeicher; dessen Adresse ist das Ergebnis (SPEC §14.1).
        let t: u32 = sema.sema_typ(sm(l), e)
        if !ist_aggregat(l, t) {
            aufgeben(l)
            return 0
        }
        let slot: u32 = alloca(l, q_groesse(l, t), q_ausricht(l, t))
        ruf_mit_ziel(l, e, slot)
        return slot
    }
    aufgeben(l)
    return 0
}

// -------------------------------------------------- Ablegen an eine Adresse

// Ist `t` ein Schnittstellenwert (`dyn I`)?
fn ist_dyn_typ(l: *mut Lower, t: u32) -> bool {
    if !hat_if(l) {
        return false
    }
    if typen.ty_art(tf(l), t) != typen.K_STRUCT {
        return false
    }
    let nm: u32 = typen.st_name(tf(l), typen.ty_a(tf(l), t) as usize)
    return iface.if_von_dyn(ifl(l), nm) != KEIN
}

// HOOK iface (iface.rs::lower_cast_into): `p as dyn I` — zwei Woerter.
// Der Datenzeiger wird NICHT veraendert (kein Versatz, keine
// Verschleierung); nur so findet der konservative Stapelscan des Sammlers
// das Objekt dahinter (SPEC §3.5.3).
fn schnittstelle_schreiben(l: *mut Lower, adr: u32, e: u32, t: u32) {
    let b: *mut ast.Baum = baum(l)
    let dn: u32 = typen.st_name(tf(l), typen.ty_a(tf(l), t) as usize)
    let ii: u32 = iface.if_von_dyn(ifl(l), dn)
    if ii == KEIN {
        aufgeben(l)
        return
    }
    let innen: u32 = ast.e_a(b, e)
    let qt: u32 = sema.sema_typ(sm(l), innen)
    if typen.ty_art(tf(l), qt) != typen.K_PTR {
        aufgeben(l)
        return
    }
    let qi: u32 = typen.ty_a(tf(l), qt)
    if typen.ty_art(tf(l), qi) != typen.K_STRUCT {
        aufgeben(l)
        return
    }
    let prae: u32 = iface.if_tafel(ifl(l), ii, typen.ty_a(tf(l), qi))
    if prae == KEIN {
        aufgeben(l)
        return
    }
    let pv: u32 = wert(l, innen)
    speichere(l, fir.T_PTR, ptradd_konst(l, adr, 0), pv)
    let tv: u32 = push(l, fir.O_VTAB, fir.T_PTR,
                       iface.if_name(ifl(l), ii as usize), prae, 0, 0, 0, 0)
    speichere(l, fir.T_PTR, ptradd_konst(l, adr, 8), tv)
}

fn schreib_nach(l: *mut Lower, adr: u32, e: u32) {
    if (*l).ungeeignet {
        return
    }
    let b: *mut ast.Baum = baum(l)
    let a: u32 = ast.e_art(b, e)
    let t: u32 = sema.sema_typ(sm(l), e)

    // HOOK fehlerunionen (lower_errors.rs::hook_write_into): die implizite
    // Umwandlung, der reine Fehlerwert und `try`/`catch` schreiben selbst.
    if hat_fe(l) {
        let cu: u32 = fehler.fehler_coerce_offen(fel(l), e)
        if cu != KEIN {
            union_schreiben(l, adr, e, cu)
            return
        }
        if a == ast.E_RUF && ast.e_zahl(b, e) == 0 {
            let nm: u32 = ast.e_a(b, e)
            let cc: i64 = fehler.fehler_ctor_code((*l).feh, namen(l), nm)
            if cc >= 0 {
                let cv: u32 = konst(l, fir.T_U32, cc as u64)
                speichere(l, fir.T_U32, adr, cv)
                return
            }
            var ist_erg: bool = fehler.fehler_ist_tryname(namen(l), nm)
            if !ist_erg {
                ist_erg = fehler.fehler_ist_catchname(namen(l), nm)
            }
            if ist_erg {
                var src: u32 = 0
                if fehler.fehler_ist_tryname(namen(l), nm) {
                    src = try_adresse(l, e)
                } else {
                    src = catch_slot(l, e)
                }
                kopie_wert(l, adr, src, t)
                return
            }
        }
    }

    if a == ast.E_SLIT {
        let si: usize = typen.ty_a(tf(l), t) as usize
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            let fname: u32 = ast.kind_at(b, ast.e_b(b, e) + k * 2)
            let fexpr: u32 = ast.kind_at(b, ast.e_b(b, e) + k * 2 + 1)
            let fa: u32 = ptradd_konst(l, adr, feld_versatz(l, si, fname))
            schreib_nach(l, fa, fexpr)
            k = k + 1
        }
        return
    }
    if a == ast.E_ALIT {
        let esz: u64 = q_groesse(l, typen.ty_a(tf(l), t))
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            let ea: u32 = elem_adresse_konst(l, adr, esz, k as u64)
            schreib_nach(l, ea, ast.kind_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        return
    }
    if a == ast.E_AWDH {
        wiederhole(l, adr, ast.e_a(b, e), typen.ty_a(tf(l), t), typen.ty_n(tf(l), t))
        return
    }
    if a == ast.E_RUF && hat_mu(l) && ast.e_zahl(b, e) == 0 {
        // HOOK enum (lower_match.rs): der Konstruktor schreibt direkt ins Ziel.
        if muster.mus_ist_ctorname(namen(l), ast.e_a(b, e)) {
            ctor_schreiben(l, e, adr)
            return
        }
    }
    if a == ast.E_RUF && ist_aggregat(l, t) {
        ruf_mit_ziel(l, e, adr)
        return
    }
    // HOOK iface: `p as dyn I` schreibt Datenzeiger und Tafel (iface.fi).
    if a == ast.E_AS && ist_dyn_typ(l, t) {
        schnittstelle_schreiben(l, adr, e, t)
        return
    }
    if ist_aggregat(l, t) {
        let src: u32 = adresse(l, e)
        copymem(l, adr, src, typen.groesse_von(tf(l), t))
        return
    }
    let ft: u32 = fty(l, t)
    let v: u32 = wert(l, e)
    speichere(l, ft, adr, v)
}

// `[wert; N]` an `adr` schreiben. Der Wert wird GENAU EINMAL ausgewertet und
// dann vervielfaeltigt — bis acht Elemente ausgerollt, darueber als Schleife.
fn wiederhole(l: *mut Lower, adr: u32, val: u32, et: u32, n: u64) {
    let esz: u64 = q_groesse(l, et)
    let skalar: bool = !ist_aggregat(l, et)
    var sv: u32 = 0
    var sft: u32 = 0
    var saddr: u32 = 0
    if skalar {
        sft = fty(l, et)
        sv = wert(l, val)
    } else {
        saddr = adresse(l, val)
    }
    if n <= 8 {
        var i: u64 = 0
        while i < n {
            let ea: u32 = elem_adresse_konst(l, adr, esz, i)
            if skalar {
                speichere(l, sft, ea, sv)
            } else {
                copymem(l, ea, saddr, esz)
            }
            i = i + 1
        }
        return
    }
    let islot: u32 = alloca(l, 8, 8)
    let null: u32 = konst(l, fir.T_U64, 0)
    speichere(l, fir.T_U64, islot, null)
    let kopf: u32 = neuer_block(l)
    let rumpf: u32 = neuer_block(l)
    let ende: u32 = neuer_block(l)
    term(l, fir.TERM_BR, kopf, 0, 0)

    (*l).cur = kopf
    let iv: u32 = lade(l, fir.T_U64, islot)
    let nv: u32 = konst(l, fir.T_U64, n)
    let c: u32 = push(l, fir.O_CMP, fir.T_BOOL, iv, nv, 2, fir.T_U64 as u64, 0, 0)
    term(l, fir.TERM_BRCOND, c, rumpf, ende)

    (*l).cur = rumpf
    let iv2: u32 = lade(l, fir.T_U64, islot)
    let ea: u32 = elem_adresse(l, adr, iv2, fir.T_U64, esz)
    if skalar {
        speichere(l, sft, ea, sv)
    } else {
        copymem(l, ea, saddr, esz)
    }
    // Der schon geladene Index wird WIEDERVERWENDET — ein zweiter `load`
    // waere eine Instruktion zu viel und verschoebe alle Wertnummern.
    let eins: u32 = konst(l, fir.T_U64, 1)
    let inc: u32 = push(l, fir.O_BIN, fir.T_U64, iv2, eins, 0, 0, 0, 0)
    speichere(l, fir.T_U64, islot, inc)
    term(l, fir.TERM_BR, kopf, 0, 0)

    (*l).cur = ende
}

fn q_groesse(l: *mut Lower, t: u32) -> u64 {
    var g: u64 = typen.groesse_von(tf(l), t)
    if g < 1 { g = 1 }
    return g
}

fn q_ausricht(l: *mut Lower, t: u32) -> u64 {
    var a: u64 = typen.ausrichtung_von(tf(l), t)
    if a < 1 { a = 1 }
    return a
}

// Versatz eines Feldes im Struct `si`.
fn feld_versatz(l: *mut Lower, si: usize, fname: u32) -> u64 {
    var k: u32 = 0
    while k < typen.st_flen(tf(l), si) {
        let fnr: u32 = typen.st_foff(tf(l), si) + k
        if typen.sf_name(tf(l), fnr) == fname {
            return typen.sf_versatz(tf(l), fnr)
        }
        k = k + 1
    }
    return 0
}

fn feld_typ_von(l: *mut Lower, si: usize, fname: u32) -> u32 {
    return typen.st_feld_typ(tf(l), si, fname)
}

fn ptradd_konst(l: *mut Lower, basis: u32, off: u64) -> u32 {
    if off == 0 {
        return basis
    }
    let o: u32 = konst(l, fir.T_I64, off)
    return push(l, fir.O_PTRADD, fir.T_PTR, basis, o, 0, 0, 0, 0)
}

// Adresse eines Elements mit BERECHNETEM Index. Der Index wird zuerst auf
// `u64` gebracht — genau in dieser Reihenfolge, sonst stimmen die Wertnummern
// nicht (layout.rs::elem_addr).
fn elem_adresse(l: *mut Lower, basis: u32, idx: u32, ift: u32, gr: u64) -> u32 {
    var idx64: u32 = idx
    if ift != fir.T_U64 {
        idx64 = push(l, fir.O_CAST, fir.T_U64, idx, 0, ift, 0, 0, 0)
    }
    let g: u32 = konst(l, fir.T_U64, gr)
    let off: u32 = push(l, fir.O_BIN, fir.T_U64, idx64, g, 2, 0, 0, 0)
    return push(l, fir.O_PTRADD, fir.T_PTR, basis, off, 0, 0, 0, 0)
}

fn elem_adresse_konst(l: *mut Lower, basis: u32, gr: u64, i: u64) -> u32 {
    return ptradd_konst(l, basis, gr * i)
}

fn copymem(l: *mut Lower, ziel: u32, quelle: u32, groesse: u64) {
    push_void(l, fir.O_COPYMEM, fir.T_VOID, ziel, quelle, 0, groesse, 0, 0)
}

// ------------------------------------------------------------- Ausdruecke

fn wert(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(l)
    let t: u32 = sema.sema_typ(sm(l), e)
    if ist_aggregat(l, t) {
        aufgeben(l)
        return 0
    }
    let a: u32 = ast.e_art(b, e)
    let ft: u32 = e_fty(l, e)

    if a == ast.E_INT {
        return konst(l, ft, ast.e_zahl(b, e))
    }
    if a == ast.E_FLOAT {
        return konst(l, fir.T_F64, ast.e_zahl(b, e))
    }
    if a == ast.E_BOOL {
        return konst(l, fir.T_BOOL, ast.e_a(b, e) as u64)
    }
    if a == ast.E_ID {
        let slot: u32 = suchen(l, ast.e_a(b, e))
        if slot != KEIN {
            return lade(l, ft, slot)
        }
        // Konstante: der Wert steht schon im Typpruefer.
        return konst(l, ft, sema_konst(l, ast.e_a(b, e)))
    }
    if a == ast.E_UN {
        let op: u32 = ast.e_a(b, e)
        if op == 2 {
            return adresse(l, ast.e_b(b, e))
        }
        if op == 3 {
            let adr: u32 = wert(l, ast.e_b(b, e))
            return lade(l, ft, adr)
        }
        let v: u32 = wert(l, ast.e_b(b, e))
        var un: u32 = 0
        if op == 1 {
            un = 1
        }
        return push(l, fir.O_UN, ft, v, 0, un, 0, 0, 0)
    }
    if a == ast.E_BIN {
        return binaer(l, e)
    }
    if a == ast.E_FELD || a == ast.E_IDX {
        let adr: u32 = adresse(l, e)
        return lade(l, ft, adr)
    }
    if a == ast.E_RUF {
        // HOOK fehlerunionen (lower_errors.rs::hook_value): das SKALARE
        // Ergebnis von `try`/`catch` (Aggregate laufen ueber `adresse`).
        if hat_fe(l) && ast.e_zahl(b, e) == 0 {
            let nm: u32 = ast.e_a(b, e)
            if fehler.fehler_ist_tryname(namen(l), nm) {
                let sa: u32 = try_adresse(l, e)
                return lade(l, ft, sa)
            }
            if fehler.fehler_ist_catchname(namen(l), nm) {
                let sa: u32 = catch_slot(l, e)
                return lade(l, ft, sa)
            }
        }
        return ruf(l, e, ft)
    }
    if a == ast.E_SYSCALL {
        // JEDES Argument geht als `i64` in den Syscall — was nicht schon i64
        // ist, wird umgewandelt. Auch Zeiger; sonst fehlt genau ein `cast`.
        var tmp: Vec[u32] = vec_neu[u32]()
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            let arg: u32 = ast.kind_at(b, ast.e_b(b, e) + k)
            let aft: u32 = e_fty(l, arg)
            let v: u32 = wert(l, arg)
            if aft == fir.T_I64 {
                vec_push[u32](&tmp, v)
            } else {
                vec_push[u32](&tmp, push(l, fir.O_CAST, fir.T_I64, v, 0, aft, 0, 0, 0))
            }
            k = k + 1
        }
        let off: u32 = args_ablegen(l, &tmp)
        vec_frei[u32](&tmp)
        return push(l, fir.O_SYSCALL, fir.T_I64, 0, 0, 0, 0, off, ast.e_c(b, e))
    }
    if a == ast.E_AS {
        let von: u32 = e_fty(l, ast.e_a(b, e))
        let nach: u32 = ft
        let src: u32 = wert(l, ast.e_a(b, e))
        if von == nach {
            return src
        }
        if nach == fir.T_BOOL {
            let z: u32 = konst(l, von, 0)
            return push(l, fir.O_CMP, fir.T_BOOL, src, z, 1, von as u64, 0, 0)
        }
        return push(l, fir.O_CAST, nach, src, 0, von, 0, 0, 0)
    }
    aufgeben(l)
    return 0
}

// Wert einer Konstanten aus dem Typpruefer.
fn sema_konst(l: *mut Lower, name: u32) -> u64 {
    return sema.sema_konst_wert(sm(l), name)
}

fn binaer(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(l)
    let op: u32 = ast.e_a(b, e)
    let li: u32 = ast.e_b(b, e)
    let re: u32 = ast.e_c(b, e)

    if op == 16 || op == 17 {
        return kurzschluss(l, op, li, re)
    }
    if op >= 10 && op <= 15 {
        // HOOK fehlerunionen (lower_errors.rs::hook_binary): zwei Fehlerwerte
        // vergleichen heisst ihre Codes vergleichen (u32 am Anfang).
        if hat_fe(l) && (op == 10 || op == 11) {
            let lty: u32 = sema.sema_typ(sm(l), li)
            let rty: u32 = sema.sema_typ(sm(l), re)
            if fehler.fehler_set_von_typ(fel(l), tf(l), lty) != KEIN {
                if fehler.fehler_set_von_typ(fel(l), tf(l), rty) != KEIN {
                    let aa: u32 = adresse(l, li)
                    let av: u32 = lade(l, fir.T_U32, aa)
                    let ba: u32 = adresse(l, re)
                    let bv: u32 = lade(l, fir.T_U32, ba)
                    return push(l, fir.O_CMP, fir.T_BOOL, av, bv, op - 10,
                                fir.T_U32 as u64, 0, 0)
                }
            }
        }
        let ty: u32 = e_fty(l, li)
        let av: u32 = wert(l, li)
        let bv: u32 = wert(l, re)
        return push(l, fir.O_CMP, fir.T_BOOL, av, bv, op - 10, ty as u64, 0, 0)
    }
    let ft: u32 = e_fty(l, e)
    // Reihenfolge wie `ast::BinOp`: add sub mul div rem and or xor shl shr
    let bop: u32 = op
    let av: u32 = wert(l, li)
    var bv: u32 = wert(l, re)
    if op == 8 || op == 9 {
        let bt: u32 = e_fty(l, re)
        if bt != ft {
            bv = push(l, fir.O_CAST, ft, bv, 0, bt, 0, 0, 0)
        }
    }
    return push(l, fir.O_BIN, ft, av, bv, bop, 0, 0, 0)
}

// `&&` / `||` kurzschliessend: Ergebnisplatz + Verzweigung.
fn kurzschluss(l: *mut Lower, op: u32, li: u32, re: u32) -> u32 {
    let slot: u32 = alloca(l, 1, 1)
    let av: u32 = wert(l, li)
    speichere(l, fir.T_BOOL, slot, av)
    let rhs: u32 = neuer_block(l)
    let join: u32 = neuer_block(l)
    var dann: u32 = rhs
    var sonst: u32 = join
    if op == 17 {
        dann = join
        sonst = rhs
    }
    term(l, fir.TERM_BRCOND, av, dann, sonst)
    (*l).cur = rhs
    let bv: u32 = wert(l, re)
    speichere(l, fir.T_BOOL, slot, bv)
    if !terminiert(l) {
        term(l, fir.TERM_BR, join, 0, 0)
    }
    (*l).cur = join
    return lade(l, fir.T_BOOL, slot)
}

// Klasse eines Typs an der Funktionsgrenze: Anzahl der Ganzzahlwoerter,
// oder `fir.KEIN` fuer die Speicherklasse.
fn abi_klasse(l: *mut Lower, t: u32) -> u32 {
    let k: u32 = typen.klasse_von(tf(l), t)
    if k == typen.KLASSE_MEM {
        return fir.KEIN
    }
    return k
}

fn abi_sret(l: *mut Lower, t: u32) -> bool {
    return typen.braucht_sret(tf(l), t)
}

// Laedt ein Aggregat als `n` Ganzzahlwoerter. Ist die Groesse kein Vielfaches
// von acht, laeuft es ueber einen aufgefuellten Zwischenpuffer — sonst laege
// der letzte `load` teilweise HINTER dem Objekt.
fn woerter_laden(l: *mut Lower, adr: u32, groesse: u64, n: u32, aus: *mut Vec[u32]) {
    var quelle: u32 = adr
    if groesse % 8 != 0 {
        let t: u32 = alloca(l, n as u64 * 8, 8)
        copymem(l, t, adr, groesse)
        quelle = t
    }
    var i: u32 = 0
    while i < n {
        let a: u32 = ptradd_konst(l, quelle, i as u64 * 8)
        vec_push[u32](aus, lade(l, fir.T_I64, a))
        i = i + 1
    }
}

fn woerter_speichern(l: *mut Lower, ziel: u32, groesse: u64, w: u32) {
    if groesse % 8 != 0 {
        let t: u32 = alloca(l, 8, 8)
        speichere(l, fir.T_I64, t, w)
        copymem(l, ziel, t, groesse)
        return
    }
    speichere(l, fir.T_I64, ziel, w)
}

// Die Argumente muessen ZUSAMMENHAENGEND liegen. Ein Argument, das selbst
// einen Aufruf enthaelt, legt sonst seine eigenen Argumente MITTEN in die
// aeussere Liste — derselbe Fehler wie beim Parser (Runde 22). Also erst
// sammeln, dann am Stueck ablegen.
fn args_ablegen(l: *mut Lower, tmp: *mut Vec[u32]) -> u32 {
    let off: u32 = fir.arg_anfang(&(*l).f)
    var i: usize = 0
    while i < vec_len[u32](tmp) {
        fir.arg_dazu(&(*l).f, vec_at[u32](tmp, i))
        i = i + 1
    }
    return off
}

// ------------------------------------------------- gc (gc_lower.rs, Runde 34)
//
// `gc C{ ... }` — Aufruf der Laufzeit (`__gc_alloc_raw`), danach die
// Fehlerunion `AllocError!Gc[C]` an `ziel` bauen und die Felder schreiben.
// Der Sammellauf steckt in `__gc_alloc_raw`: ERST sammeln, DANN
// `AllocError::OutOfMemory` (DESIGNZIELE §2).
fn gc_alloc_senken(l: *mut Lower, e: u32, ziel: u32) {
    let b: *mut ast.Baum = baum(l)
    let ki_i: i64 = gc.gc_klasse_aus_neu(gcl(l), namen(l), ast.e_a(b, e))
    if ki_i < 0 {
        aufgeben(l)
        return
    }
    let ki: u32 = ki_i as u32
    let sidx: u32 = gc.gc_sidx(gcl(l), ki)
    // Lage von `__val` in der Fehlerunion.
    let ui: u32 = gc.gc_union(gcl(l), ki)
    if ui == 0 {
        aufgeben(l)
        return
    }
    let voff: u64 = fehler.fehler_u_voff(fel(l), ui - 1)
    var ae: [u8; 10] = "AllocError"
    let aen: u32 = intern.intern_nummer(namen(l), (&ae[0]) as u64, 10) as u32
    let sm2: u32 = fehler.fehler_menge_finden(fel(l), aen)
    var om: [u8; 11] = "OutOfMemory"
    let omn: u32 = intern.intern_nummer(namen(l), (&om[0]) as u64, 11) as u32
    let code: u32 = fehler.fehler_code_von(fel(l), sm2, omn)
    if code == 0 {
        aufgeben(l)
        return
    }
    var ar: [u8; 14] = "__gc_alloc_raw"
    let arn: u32 = intern.intern_nummer(namen(l), (&ar[0]) as u64, 14) as u32

    let tidv: u32 = konst(l, fir.T_U64, gc.gc_tid(gcl(l), ki))
    let sizev: u32 = konst(l, fir.T_U64, gc.gc_size(gcl(l), ki))
    var tmp: Vec[u32] = vec_neu[u32]()
    vec_push[u32](&tmp, tidv)
    vec_push[u32](&tmp, sizev)
    let aoff: u32 = args_ablegen(l, &tmp)
    vec_frei[u32](&tmp)
    let p: u32 = push(l, fir.O_CALL, fir.T_PTR, arn, 0, 0, 0, aoff, 2)
    let null: u32 = konst(l, fir.T_PTR, 0)
    // 1 = ungleich (Reihenfolge wie `ast::BinOp`: eq ne lt le gt ge)
    let ok: u32 = push(l, fir.O_CMP, fir.T_BOOL, p, null, 1, fir.T_PTR as u64, 0, 0)
    let ok_bb: u32 = neuer_block(l)
    let fail_bb: u32 = neuer_block(l)
    let join: u32 = neuer_block(l)
    term(l, fir.TERM_BRCOND, ok, ok_bb, fail_bb)

    // Fehlerfall: erst hat die Laufzeit gesammelt, dann ist wirklich Schluss.
    (*l).cur = fail_bb
    let cv: u32 = konst(l, fir.T_U32, code as u64)
    speichere(l, fir.T_U32, ziel, cv)
    let va1: u32 = ptradd_konst(l, ziel, voff)
    let z0: u32 = konst(l, fir.T_PTR, 0)
    speichere(l, fir.T_PTR, va1, z0)
    term(l, fir.TERM_BR, join, 0, 0)

    // Erfolgsfall: Fehlerunion fuellen (damit der Zeiger sofort eine Wurzel
    // auf dem Stapel hat), dann die Felder schreiben.
    (*l).cur = ok_bb
    let z32: u32 = konst(l, fir.T_U32, 0)
    speichere(l, fir.T_U32, ziel, z32)
    let va2: u32 = ptradd_konst(l, ziel, voff)
    speichere(l, fir.T_PTR, va2, p)
    if ast.e_c(b, e) == 1 {
        let slit: u32 = ast.kind_at(b, ast.e_b(b, e))
        if ast.e_art(b, slit) == ast.E_SLIT {
            let off: u32 = ast.e_b(b, slit)
            let anz: u32 = ast.e_c(b, slit)
            var k: u32 = 0
            while k < anz {
                let fname: u32 = ast.kind_at(b, off + k * 2)
                let fexpr: u32 = ast.kind_at(b, off + k * 2 + 1)
                let fa: u32 = ptradd_konst(l, p, feld_versatz(l, sidx as usize, fname))
                schreib_nach(l, fa, fexpr)
                k = k + 1
            }
        }
    }
    if !terminiert(l) {
        term(l, fir.TERM_BR, join, 0, 0)
    }
    (*l).cur = join
}

// Die Einfuegebarriere (hook_assign in gc_lower.rs): NACH dem Schreiben
// eines `Gc[T]`-Zeigers in ein Heapfeld. Nur Schreibzugriffe IN den Heap
// brauchen sie; eine oertliche Veraenderliche liegt auf dem Stapel.
fn gc_barriere(l: *mut Lower, ziel: u32) {
    let b: *mut ast.Baum = baum(l)
    let t: u32 = sema.sema_typ(sm(l), ziel)
    if !gc.gc_ist_gc_ptr(gcl(l), tf(l), t) {
        return
    }
    var ins_heap: bool = false
    let a: u32 = ast.e_art(b, ziel)
    if a == ast.E_FELD {
        let bt: u32 = sema.sema_typ(sm(l), ast.e_a(b, ziel))
        if gc.gc_ist_gc_ptr(gcl(l), tf(l), bt) {
            ins_heap = true
        }
        if typen.ty_art(tf(l), bt) == typen.K_PTR {
            ins_heap = true
        }
    }
    if a == ast.E_IDX {
        let bt: u32 = sema.sema_typ(sm(l), ast.e_a(b, ziel))
        if typen.ty_art(tf(l), bt) == typen.K_PTR {
            ins_heap = true
        }
    }
    if a == ast.E_UN && ast.e_a(b, ziel) == 3 {
        ins_heap = true
    }
    if !ins_heap {
        return
    }
    var bn: [u8; 12] = "__gc_barrier"
    let bnn: u32 = intern.intern_nummer(namen(l), (&bn[0]) as u64, 12) as u32
    let adr: u32 = adresse(l, ziel)
    let val: u32 = lade(l, fir.T_PTR, adr)
    var tmp: Vec[u32] = vec_neu[u32]()
    vec_push[u32](&tmp, adr)
    vec_push[u32](&tmp, val)
    let aoff: u32 = args_ablegen(l, &tmp)
    vec_frei[u32](&tmp)
    push_void(l, fir.O_CALL, fir.T_VOID, bnn, 0, 0, 0, aoff, 2)
}

// Ein Aufruf nach der Aufrufkonvention. `ziel` ist die Zieladresse, wenn die
// Funktion ein Aggregat liefert (sonst `fir.KEIN`). Rueckgabe: der skalare
// Wert, oder 0.
// ------------------------------------------------------- RUNDE 45: Methoden
// Dieselbe Aufloesung wie in sema.fi — aus demselben Material, damit beide
// nicht auseinanderlaufen koennen (impls.rs::ziel_von).

fn ist_methodenruf(it: *mut intern.Interner, name: u32) -> bool {
    var w: [u8; 8] = "methode "
    return intern.intern_praefix(it, name, (&w[0]) as u64, 8)
}

// RUNDE 50: wie `sema.fi::empf_struct` — auch ein Grundtyp traegt Methoden.
// Beide Seiten rechnen aus demselben Material, damit sie nicht auseinander
// laufen koennen.
fn empf_struct_l(l: *mut Lower, t: u32) -> u32 {
    var i: u32 = t
    if typen.ty_art(tf(l), i) == typen.K_PTR {
        i = typen.ty_a(tf(l), i)
    }
    let a: u32 = typen.ty_art(tf(l), i)
    if a == typen.K_STRUCT {
        return typen.st_name(tf(l), typen.ty_a(tf(l), i) as usize)
    }
    return typen.grundtyp_name(namen(l), a)
}

fn methodenfunktion_l(l: *mut Lower, sn: u32, m: u32) -> u32 {
    let it: *mut intern.Interner = namen(l)
    var b: rt.Buf = rt.buf_neu()
    rt.buf_push_bytes(&b, intern.intern_zeiger(it, sn), intern.intern_laenge(it, sn))
    var tr: [u8; 2] = "__"
    rt.buf_push_bytes(&b, (&tr[0]) as u64, 2)
    rt.buf_push_bytes(&b, intern.intern_zeiger(it, m), intern.intern_laenge(it, m))
    let nr: u32 = intern.intern_nummer(it, rt.buf_ptr(&b), rt.buf_len(&b)) as u32
    rt.buf_frei(&b)
    return nr
}

// ---------------------------------------------- Inline-Assembler und MMIO
//
// RUNDE 52 (compiler/src/kern.rs::lower_hook).

fn mmio_fty(w: u32) -> u32 {
    if w == 0 {
        return fir.T_U8
    }
    if w == 1 {
        return fir.T_U16
    }
    if w == 2 {
        return fir.T_U32
    }
    return fir.T_U64
}

fn asm_senken(l: *mut Lower, blk: u32, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(l)
    let off: u32 = ast.e_b(b, e)
    let anz: u32 = ast.e_c(b, e)
    // Eingaben in Quellreihenfolge auswerten und auf 64 Bit bringen: in ein
    // Register geht immer das ganze Wort.
    var werte: Vec[u32] = vec_neu[u32]()
    var k: u32 = 0
    while k < anz {
        let arg: u32 = ast.kind_at(b, off + k)
        var v: u32 = wert(l, arg)
        let ft: u32 = e_fty(l, arg)
        if ft != fir.T_U64 && ft != fir.T_I64 && ft != fir.T_PTR {
            v = push(l, fir.O_CAST, fir.T_U64, v, 0, ft, 0, 0, 0)
        }
        vec_push[u32](&werte, v)
        k = k + 1
    }
    // Argumentblock: erst die Paare (Register, Wert), danach die Clobber.
    let aoff: u32 = fir.arg_anfang(&(*l).f)
    var k2: u32 = 0
    while k2 < anz {
        fir.arg_dazu(&(*l).f, ast.asm_ein_reg(b, blk, k2))
        fir.arg_dazu(&(*l).f, vec_at[u32](&werte, k2 as usize))
        k2 = k2 + 1
    }
    vec_frei[u32](&werte)
    let cz: u32 = ast.asm_clob_anzahl(b, blk)
    var k3: u32 = 0
    while k3 < cz {
        fir.arg_dazu(&(*l).f, ast.asm_clob(b, blk, k3))
        k3 = k3 + 1
    }
    let vorlage: u32 = ast.asm_vorlage(b, blk)
    var aus: u32 = ast.asm_aus(b, blk)
    if aus == ast.NICHTS {
        aus = fir.KEIN
    }
    if aus == fir.KEIN {
        push_void(l, fir.O_ASM, fir.T_VOID, vorlage, aus, 0, cz as u64, aoff, anz)
        return 0
    }
    return push(l, fir.O_ASM, fir.T_U64, vorlage, aus, 0, cz as u64, aoff, anz)
}

fn ruf_voll(l: *mut Lower, e: u32, ziel: u32) -> u32 {
    let b: *mut ast.Baum = baum(l)
    var name: u32 = ast.e_a(b, e)
    // HOOK gc (gc_lower.rs::hook_call): Allokation, Intrinsics, `as?` — und
    // `weak`/`stark` sind Laufzeitfunktionen (`echter_name`).
    // RUNDE 52 (kern.rs): Inline-Assembler und MMIO.
    let anr: u32 = kern.asm_nummer(namen(l), name)
    if anr != kern.KEINE_NUMMER {
        return asm_senken(l, anr, e)
    }
    if fn_nummer(l, name) == KEIN {
        let wl: u32 = kern.mmio_lesen_breite(namen(l), name)
        if wl != kern.KEINE_BREITE {
            let ad: u32 = wert(l, ast.kind_at(b, ast.e_b(b, e)))
            return push(l, fir.O_MMIOLD, mmio_fty(wl), ad, 0, 0, 0, 0, 0)
        }
        let ws: u32 = kern.mmio_schreiben_breite(namen(l), name)
        if ws != kern.KEINE_BREITE {
            let ad2: u32 = wert(l, ast.kind_at(b, ast.e_b(b, e)))
            let wv: u32 = wert(l, ast.kind_at(b, ast.e_b(b, e) + 1))
            push_void(l, fir.O_MMIOST, mmio_fty(ws), ad2, wv, 0, 0, 0, 0)
            return 0
        }
    }
    // RUNDE 49 (faden.rs): Faden erzeugen, TLS-Selbstzeiger, Vergleichs-Tausch.
    var fstw: [u8; 15] = "__faden_starten"
    if intern.intern_gleich(namen(l), name, (&fstw[0]) as u64, 15) && fn_nummer(l, name) == KEIN {
        let arg0: u32 = wert(l, ast.kind_at(b, ast.e_b(b, e)))
        let arg1: u32 = wert(l, ast.kind_at(b, ast.e_b(b, e) + 1))
        let arg2: u32 = wert(l, ast.kind_at(b, ast.e_b(b, e) + 2))
        return push(l, fir.O_SPAWN, fir.T_I64, arg0, arg1, arg2, 0, 0, 0)
    }
    var fslw: [u8; 14] = "__faden_selbst"
    if intern.intern_gleich(namen(l), name, (&fslw[0]) as u64, 14) && fn_nummer(l, name) == KEIN {
        return push(l, fir.O_TLS, fir.T_PTR, 0, 0, 0, 0, 0, 0)
    }
    var atcw: [u8; 17] = "__atomar_tauschen"
    if intern.intern_gleich(namen(l), name, (&atcw[0]) as u64, 17) && fn_nummer(l, name) == KEIN {
        let cp: u32 = wert(l, ast.kind_at(b, ast.e_b(b, e)))
        let cea: u32 = ast.kind_at(b, ast.e_b(b, e) + 1)
        let cna: u32 = ast.kind_at(b, ast.e_b(b, e) + 2)
        var ce: u32 = wert(l, cea)
        var cn: u32 = wert(l, cna)
        let cet: u32 = e_fty(l, cea)
        if cet != fir.T_U64 && cet != fir.T_I64 {
            ce = push(l, fir.O_CAST, fir.T_U64, ce, 0, cet, 0, 0, 0)
        }
        let cnt: u32 = e_fty(l, cna)
        if cnt != fir.T_U64 && cnt != fir.T_I64 {
            cn = push(l, fir.O_CAST, fir.T_U64, cn, 0, cnt, 0, 0, 0)
        }
        return push(l, fir.O_ATOMCAS, fir.T_U64, cp, ce, cn, 0, 0, 0)
    }
    // `__atomar_addieren(p, delta)` (atomar.rs, RUNDE 47): Op::AtomicAdd.
    var atw: [u8; 17] = "__atomar_addieren"
    if intern.intern_gleich(namen(l), name, (&atw[0]) as u64, 17) && fn_nummer(l, name) == KEIN {
        let padr: u32 = wert(l, ast.kind_at(b, ast.e_b(b, e)))
        let darg: u32 = ast.kind_at(b, ast.e_b(b, e) + 1)
        var dv: u32 = wert(l, darg)
        let dft: u32 = e_fty(l, darg)
        if dft != fir.T_U64 && dft != fir.T_I64 {
            dv = push(l, fir.O_CAST, fir.T_U64, dv, 0, dft, 0, 0, 0)
        }
        return push(l, fir.O_ATOMADD, fir.T_U64, padr, dv, 0, 0, 0, 0)
    }
    if hat_gc(l) && ast.e_zahl(b, e) == 0 {
        if gc.gc_hat_neu_praefix(namen(l), name) {
            var z: u32 = ziel
            if z == fir.KEIN {
                let t: u32 = sema.sema_typ(sm(l), e)
                z = alloca(l, q_groesse(l, t), q_ausricht(l, t))
            }
            gc_alloc_senken(l, e, z)
            return 0
        }
        let zn: u32 = gc.gc_zustandsname(namen(l), name)
        if zn != 0 {
            var regs: u64 = 0
            if zn == 2 {
                regs = 1
            }
            return push(l, fir.O_GCADDR, fir.T_PTR, 0, 0, 0, regs, 0, 0)
        }
        if gc.gc_hat_as_praefix(namen(l), name) {
            let ki_i: i64 = gc.gc_klasse_aus_as(gcl(l), namen(l), name)
            if ki_i < 0 {
                aufgeben(l)
                return 0
            }
            let arg: u32 = ast.kind_at(b, ast.e_b(b, e))
            let pv: u32 = wert(l, arg)
            let tidv: u32 = konst(l, fir.T_U64, gc.gc_tid(gcl(l), ki_i as u32))
            var an: [u8; 11] = "__gc_as_raw"
            let ann: u32 = intern.intern_nummer(namen(l), (&an[0]) as u64, 11) as u32
            var tmp: Vec[u32] = vec_neu[u32]()
            vec_push[u32](&tmp, pv)
            vec_push[u32](&tmp, tidv)
            let aoff: u32 = args_ablegen(l, &tmp)
            vec_frei[u32](&tmp)
            return push(l, fir.O_CALL, fir.T_PTR, ann, 0, 0, 0, aoff, 2)
        }
        // `barrier(x)` (ct.rs): undurchsichtig fuer den Optimierer — den
        // hat diese Stufe nicht, also bleibt die Identitaet.
        var bw: [u8; 7] = "barrier"
        if intern.intern_gleich(namen(l), name, (&bw[0]) as u64, 7) && fn_nummer(l, name) == KEIN {
            return wert(l, ast.kind_at(b, ast.e_b(b, e)))
        }
        // `select(bedingung, a, b)` (ct.rs::lower_ct_call, RUNDE 36): die
        // FIR-Instruktion Op::Select — der Codegenerator macht ein `cmov`
        // daraus, keinen Sprung (SPEC §9.2).
        var sw2: [u8; 6] = "select"
        if intern.intern_gleich(namen(l), name, (&sw2[0]) as u64, 6) && fn_nummer(l, name) == KEIN {
            let aa: u32 = ast.kind_at(b, ast.e_b(b, e) + 1)
            let sty: u32 = e_fty(l, aa)
            let cond: u32 = wert(l, ast.kind_at(b, ast.e_b(b, e)))
            let av: u32 = wert(l, aa)
            let bv: u32 = wert(l, ast.kind_at(b, ast.e_b(b, e) + 2))
            return push(l, fir.O_SELECT, sty, cond, av, bv, 0, 0, 0)
        }
        // `secure_zero(zeiger, anzahl)` (ct.rs, RUNDE 36): Op::SecureZero;
        // die Byteanzahl wird als u64 gebraucht (`angleichen` — schmalere
        // Ganzzahlen werden vorzeichenrichtig erweitert).
        var sz: [u8; 11] = "secure_zero"
        if intern.intern_gleich(namen(l), name, (&sz[0]) as u64, 11) && fn_nummer(l, name) == KEIN {
            let narg: u32 = ast.kind_at(b, ast.e_b(b, e) + 1)
            let zadr: u32 = wert(l, ast.kind_at(b, ast.e_b(b, e)))
            var nv: u32 = wert(l, narg)
            let nft: u32 = e_fty(l, narg)
            if nft != fir.T_U64 && nft != fir.T_I64 {
                nv = push(l, fir.O_CAST, fir.T_U64, nv, 0, nft, 0, 0, 0)
            }
            push_void(l, fir.O_SECZERO, fir.T_VOID, zadr, nv, 0, 0, 0, 0)
            return 0
        }
        // `weak`/`stark` — eine gleichnamige EIGENE Funktion gewinnt.
        if fn_nummer(l, name) == KEIN {
            if gc.gc_ist_weak_name(namen(l), name) {
                var wn: [u8; 13] = "__gc_weak_raw"
                name = intern.intern_nummer(namen(l), (&wn[0]) as u64, 13) as u32
            }
            if gc.gc_ist_stark_name(namen(l), name) {
                var sn2: [u8; 15] = "__gc_strong_raw"
                name = intern.intern_nummer(namen(l), (&sn2[0]) as u64, 15) as u32
            }
        }
    }
    // HOOK impl (impls.rs, Runde 45): `x.m(a)` steht als `"methode m"` im
    // Baum. Das Ziel wird hier NEU abgeleitet — aus dem Typ des Empfaengers
    // und dem Methodennamen, genau wie im Typpruefer. Eine Seitentabelle
    // zwischen den Phasen gibt es bewusst nicht.
    var empf_adr: bool = false
    // HOOK iface (iface.rs::lower_versand, Runde 46): `f.m(a)` auf einem
    // `dyn I`. `ziel` traegt die Adresse aus der Methodentafel, `daten` den
    // Zeiger auf den Wert; alles andere — Aggregate, versteckter
    // Rueckgabezeiger, Stapelargumente — laeuft danach durch genau denselben
    // Code wie ein gewoehnlicher Aufruf.
    var versand: bool = false
    var v_ziel: u32 = 0
    var v_daten: u32 = 0
    var v_rt: u32 = 0
    if hat_if(l) && ist_methodenruf(namen(l), name) {
        let empf0: u32 = ast.kind_at(b, ast.e_b(b, e))
        let et0: u32 = sema.sema_typ(sm(l), empf0)
        let sn0: u32 = empf_struct_l(l, et0)
        if sn0 != KEIN {
            let ii: u32 = iface.if_von_dyn(ifl(l), sn0)
            if ii != KEIN {
                let m0: u32 = intern.intern_ab(namen(l), name, 8)
                let mk: u32 = iface.if_slot(ifl(l), ii as usize, m0)
                if mk == KEIN {
                    aufgeben(l)
                    return 0
                }
                let basis: u32 = adresse(l, empf0)
                v_daten = lade(l, fir.T_PTR, ptradd_konst(l, basis, 0))
                let tafel: u32 = lade(l, fir.T_PTR, ptradd_konst(l, basis, 8))
                v_ziel = lade(l, fir.T_PTR, ptradd_konst(l, tafel, 8 * mk as u64))
                v_rt = iface.if_rtyp(ifl(l), ii as usize, mk)
                versand = true
            }
        }
    }
    if !versand && ist_methodenruf(namen(l), name) {
        let empf: u32 = ast.kind_at(b, ast.e_b(b, e))
        let et: u32 = sema.sema_typ(sm(l), empf)
        let sn: u32 = empf_struct_l(l, et)
        if sn == KEIN {
            aufgeben(l)
            return 0
        }
        let m: u32 = intern.intern_ab(namen(l), name, 8)
        name = methodenfunktion_l(l, sn, m)
        let mf: u32 = fn_nummer(l, name)
        if mf == KEIN {
            aufgeben(l)
            return 0
        }
        if ast.fn_plen(b, mf as usize) > 0 {
            let p0: u32 = typen.param_typ_aufgeloest(tf(l), mf as usize, 0)
            empf_adr = typen.ist_zeiger(tf(l), p0) && !typen.ist_zeiger(tf(l), et)
        }
    }
    var rt2: u32 = 0
    if versand {
        rt2 = v_rt
    } else {
        let fnr: u32 = fn_nummer(l, name)
        if fnr == KEIN {
            aufgeben(l)
            return 0
        }
        rt2 = typen.ret_typ_der_funktion(tf(l), fnr as usize)
    }
    let ret_agg: bool = ist_aggregat(l, rt2)
    let sret: bool = abi_sret(l, rt2)

    var tmp: Vec[u32] = vec_neu[u32]()
    var target: u32 = fir.KEIN
    if ret_agg {
        if ziel != fir.KEIN {
            target = ziel
        } else {
            target = alloca(l, q_groesse(l, rt2), q_ausricht(l, rt2))
        }
    }
    if sret {
        vec_push[u32](&tmp, target)
    }
    var k: u32 = 0
    while k < ast.e_c(b, e) {
        let arg: u32 = ast.kind_at(b, ast.e_b(b, e) + k)
        // HOOK iface: der Empfaenger ist der Datenzeiger aus dem fetten
        // Zeiger — er wurde oben schon gelesen (iface.fi).
        if k == 0 && versand {
            vec_push[u32](&tmp, v_daten)
            k = k + 1
            continue
        }
        // HOOK impl: der Empfaenger geht als ADRESSE hinein (impls.rs).
        if k == 0 && empf_adr {
            vec_push[u32](&tmp, adresse(l, arg))
            k = k + 1
            continue
        }
        var at: u32 = sema.sema_typ(sm(l), arg)
        // HOOK fehlerunionen (lower_errors.rs::hook_arg_type): ein implizit
        // umgewandeltes Argument ueberquert die Grenze als Aggregat.
        if hat_fe(l) {
            let cu: u32 = fehler.fehler_coerce_offen(fel(l), arg)
            if cu != KEIN {
                at = fehler.fehler_union_typ(fel(l), tf(l), cu)
            }
        }
        if !ist_aggregat(l, at) {
            vec_push[u32](&tmp, wert(l, arg))
            k = k + 1
            continue
        }
        let gr: u64 = q_groesse(l, at)
        let kl: u32 = abi_klasse(l, at)
        if kl != fir.KEIN {
            let adr: u32 = adresse(l, arg)
            woerter_laden(l, adr, gr, kl, &tmp)
        } else {
            // Speicherklasse: versteckter Zeiger auf eine Kopie des Aufrufers.
            let t: u32 = alloca(l, gr, q_ausricht(l, at))
            schreib_nach(l, t, arg)
            vec_push[u32](&tmp, t)
        }
        k = k + 1
    }
    let anz: u32 = vec_len[u32](&tmp) as u32
    let off: u32 = args_ablegen(l, &tmp)
    vec_frei[u32](&tmp)

    var rufart: u32 = fir.O_CALL
    var rufziel: u32 = name
    if versand {
        rufart = fir.O_CALLI
        rufziel = v_ziel
    }
    if ret_agg {
        let gr: u64 = typen.groesse_von(tf(l), rt2)
        if sret {
            push(l, rufart, fir.T_PTR, rufziel, 0, 0, 0, off, anz)
        } else {
            let w: u32 = push(l, rufart, fir.T_I64, rufziel, 0, 0, 0, off, anz)
            woerter_speichern(l, target, gr, w)
        }
        return 0
    }
    let ft: u32 = fty(l, rt2)
    if ft == fir.T_VOID {
        push_void(l, rufart, ft, rufziel, 0, 0, 0, off, anz)
        return 0
    }
    return push(l, rufart, ft, rufziel, 0, 0, 0, off, anz)
}

fn ruf_mit_ziel(l: *mut Lower, e: u32, ziel: u32) {
    ruf_voll(l, e, ziel)
}

fn ruf(l: *mut Lower, e: u32, ft: u32) -> u32 {
    // `size_of[T]()` laesst zur Laufzeit NICHTS uebrig: eine Konstante.
    let z: u64 = ast.e_zahl(baum(l), e)
    if z != 0 {
        let t: u32 = typen.aufloesen(tf(l), baum(l), namen(l), (z - 1) as u32)
        return konst(l, fir.T_U64, typen.groesse_von(tf(l), t))
    }
    return ruf_voll(l, e, fir.KEIN)
}

fn fn_nummer(l: *mut Lower, name: u32) -> u32 {
    let b: *mut ast.Baum = baum(l)
    var i: usize = 0
    while i < ast.fn_anzahl(b) {
        if ast.fn_name(b, i) == name {
            return i as u32
        }
        i = i + 1
    }
    return KEIN
}

// ------------------------------------------------------------- Anweisungen

fn anweisung(l: *mut Lower, i: u32) {
    if (*l).ungeeignet {
        return
    }
    let b: *mut ast.Baum = baum(l)
    let a: u32 = ast.s_art(b, i)

    if a == ast.S_LET || a == ast.S_VAR {
        let init: u32 = ast.s_c(b, i)
        // HOOK fehlerunionen (lower_errors.rs::hook_let): die implizite
        // Umwandlung schreibt die Union selbst in den neuen Platz.
        if hat_fe(l) {
            let cu: u32 = fehler.fehler_coerce_offen(fel(l), init)
            if cu != KEIN {
                let us: usize = fehler.fehler_u_sidx(fel(l), cu) as usize
                var g: u64 = typen.st_groesse(tf(l), us)
                if g < 1 { g = 1 }
                var al: u64 = typen.st_ausrichtung(tf(l), us)
                if al < 1 { al = 1 }
                let slot: u32 = alloca(l, g, al)
                union_schreiben(l, slot, init, cu)
                anlegen(l, ast.s_a(b, i), slot)
                return
            }
        }
        let t: u32 = sema.sema_typ(sm(l), init)
        if !ist_aggregat(l, t) {
            let ft: u32 = fty(l, t)
            if ft == fir.KEIN || ft == fir.T_VOID {
                aufgeben(l)
                return
            }
        }
        let slot: u32 = alloca(l, q_groesse(l, t), q_ausricht(l, t))
        schreib_nach(l, slot, init)
        anlegen(l, ast.s_a(b, i), slot)
        return
    }
    if a == ast.S_ZUW {
        let adr: u32 = adresse(l, ast.s_a(b, i))
        schreib_nach(l, adr, ast.s_b(b, i))
        // HOOK gc (gc_lower.rs::hook_assign): die Einfuegebarriere NACH dem
        // Schreiben eines Gc-Zeigers in ein Heapfeld.
        if hat_gc(l) {
            gc_barriere(l, ast.s_a(b, i))
        }
        return
    }
    if a == ast.S_EXPR {
        let e: u32 = ast.s_a(b, i)
        let ea: u32 = ast.e_art(b, e)
        // HOOK fehlerunionen (lower_errors.rs::hook_stmt): `try`/`catch`/
        // Fehlerwert als Anweisung — der Wert wird verworfen, der Weg zu
        // ihm bleibt.
        if ea == ast.E_RUF && hat_fe(l) && ast.e_zahl(b, e) == 0 {
            let nm: u32 = ast.e_a(b, e)
            if fehler.fehler_ist_tryname(namen(l), nm) {
                try_adresse(l, e)
                return
            }
            if fehler.fehler_ist_catchname(namen(l), nm) {
                catch_slot(l, e)
                return
            }
            let cc: i64 = fehler.fehler_ctor_code((*l).feh, namen(l), nm)
            if cc >= 0 {
                let t: u32 = sema.sema_typ(sm(l), e)
                let slot: u32 = alloca(l, q_groesse(l, t), q_ausricht(l, t))
                let cv: u32 = konst(l, fir.T_U32, cc as u64)
                speichere(l, fir.T_U32, slot, cv)
                return
            }
        }
        if ea == ast.E_RUF && hat_mu(l) && ast.e_zahl(b, e) == 0 {
            // HOOK enum/match (lower_match.rs::lower_types_stmt).
            let nm: u32 = ast.e_a(b, e)
            if muster.mus_ist_matchname(namen(l), nm) {
                match_lower(l, muster.mus_match_nummer(namen(l), nm))
                return
            }
            if muster.mus_ist_ctorname(namen(l), nm) {
                // Der Wert wird verworfen, braucht aber einen Platz.
                let t: u32 = sema.sema_typ(sm(l), e)
                let slot: u32 = alloca(l, q_groesse(l, t), q_ausricht(l, t))
                ctor_schreiben(l, e, slot)
                return
            }
        }
        if ea == ast.E_RUF {
            let t: u32 = sema.sema_typ(sm(l), e)
            if ist_aggregat(l, t) {
                // Das Ergebnis wird verworfen, braucht aber einen Platz.
                let slot: u32 = alloca(l, q_groesse(l, t), q_ausricht(l, t))
                ruf_mit_ziel(l, e, slot)
                return
            }
            ruf(l, e, fty(l, t))
            return
        }
        if ea == ast.E_SYSCALL {
            wert(l, e)
            return
        }
        wert(l, e)
        return
    }
    if a == ast.S_BLOCK {
        block(l, ast.s_a(b, i))
        return
    }
    if a == ast.S_RET {
        let wv: u32 = ast.s_a(b, i)
        if wv == ast.NICHTS {
            defer_bis(l, 0)
            term(l, fir.TERM_RET, KEIN, 0, 0)
        } else {
            // EHRLICHE GRENZE (SPEC §14.1 F5, lower.rs): eine FERTIGE
            // Fehlerunion zurueckgeben, waehrend ein `errdefer` aktiv ist —
            // erst zur Laufzeit stuende fest, ob das der Fehlerpfad ist.
            // Abgelehnt statt still uebergangen. Bei einer Umwandlung
            // (`return E::Variante`, `return wert`) ist der Typ von `wv` der
            // QUELLtyp und diese Bedingung greift nicht.
            if hat_fe(l) && hat_errdefer(l) {
                let rt0: u32 = sema.sema_typ(sm(l), wv)
                if fehler.fehler_union_von_typ(fel(l), tf(l), rt0) != KEIN {
                    (*l).fehler = (*l).fehler + 1
                    return
                }
            }
            // HOOK fehlerunionen (lower_errors.rs::hook_return): die
            // implizite Umwandlung bei 'return'.
            var umgewandelt: bool = false
            if hat_fe(l) {
                let cu: u32 = fehler.fehler_coerce_offen(fel(l), wv)
                if cu != KEIN {
                    fehler_return(l, wv, cu)
                    umgewandelt = true
                }
            }
            if !umgewandelt {
            let t: u32 = sema.sema_typ(sm(l), wv)
            if ist_aggregat(l, t) {
                // Aggregatrueckgabe nach `abi`: ueber den versteckten Zeiger
                // oder in EINEM Wort.
                let gr: u64 = typen.groesse_von(tf(l), t)
                if (*l).sret != KEIN {
                    schreib_nach(l, (*l).sret, wv)
                    defer_bis(l, 0)
                    term(l, fir.TERM_RET, (*l).sret, 0, 0)
                } else {
                    let adr: u32 = adresse(l, wv)
                    var w: Vec[u32] = vec_neu[u32]()
                    woerter_laden(l, adr, gr, 1, &w)
                    let w0: u32 = vec_at[u32](&w, 0)
                    vec_frei[u32](&w)
                    defer_bis(l, 0)
                    term(l, fir.TERM_RET, w0, 0, 0)
                }
            } else {
                let v: u32 = wert(l, wv)
                defer_bis(l, 0)
                term(l, fir.TERM_RET, v, 0, 0)
            }
            }
        }
        // Alles danach ist unerreichbar: neuen Block oeffnen, damit die
        // Zusicherung "ein Terminator je Block" gilt.
        (*l).cur = neuer_block(l)
        return
    }
    if a == ast.S_IF {
        let c: u32 = wert(l, ast.s_a(b, i))
        let dann: u32 = neuer_block(l)
        let sonst: u32 = neuer_block(l)
        let join: u32 = neuer_block(l)
        term(l, fir.TERM_BRCOND, c, dann, sonst)
        (*l).cur = dann
        block(l, ast.s_b(b, i))
        if !terminiert(l) {
            term(l, fir.TERM_BR, join, 0, 0)
        }
        (*l).cur = sonst
        if ast.s_c(b, i) != ast.NICHTS {
            anweisung(l, ast.s_c(b, i))
        }
        if !terminiert(l) {
            term(l, fir.TERM_BR, join, 0, 0)
        }
        (*l).cur = join
        return
    }
    if a == ast.S_WHILE {
        let kopf: u32 = neuer_block(l)
        let rumpf: u32 = neuer_block(l)
        let ende: u32 = neuer_block(l)
        term(l, fir.TERM_BR, kopf, 0, 0)
        (*l).cur = kopf
        let c: u32 = wert(l, ast.s_a(b, i))
        term(l, fir.TERM_BRCOND, c, rumpf, ende)
        (*l).cur = rumpf
        vec_push[u32](&(*l).l_break, ende)
        vec_push[u32](&(*l).l_cont, kopf)
        vec_push[u32](&(*l).l_tiefe, vec_len[u32](&(*l).d_grenze) as u32)
        block(l, ast.s_b(b, i))
        vec_pop[u32](&(*l).l_break)
        vec_pop[u32](&(*l).l_cont)
        vec_pop[u32](&(*l).l_tiefe)
        if !terminiert(l) {
            term(l, fir.TERM_BR, kopf, 0, 0)
        }
        (*l).cur = ende
        return
    }
    if a == ast.S_FOR {
        let t: u32 = sema.sema_typ(sm(l), ast.s_b(b, i))
        let ft: u32 = fty(l, t)
        if ft == fir.KEIN || ft == fir.T_VOID {
            aufgeben(l)
            return
        }
        var bytes: u64 = fir.fty_bytes(ft)
        if bytes < 1 { bytes = 1 }
        let islot: u32 = alloca(l, bytes, bytes)
        let sv: u32 = wert(l, ast.s_b(b, i))
        speichere(l, ft, islot, sv)
        // Die Obergrenze wird EINMAL ausgewertet.
        let eslot: u32 = alloca(l, bytes, bytes)
        let ev: u32 = wert(l, ast.s_c(b, i))
        speichere(l, ft, eslot, ev)

        let kopf: u32 = neuer_block(l)
        let rumpf: u32 = neuer_block(l)
        let schritt: u32 = neuer_block(l)
        let ende: u32 = neuer_block(l)
        term(l, fir.TERM_BR, kopf, 0, 0)

        (*l).cur = kopf
        let iv: u32 = lade(l, ft, islot)
        let lim: u32 = lade(l, ft, eslot)
        let c: u32 = push(l, fir.O_CMP, fir.T_BOOL, iv, lim, 2, ft as u64, 0, 0)
        term(l, fir.TERM_BRCOND, c, rumpf, ende)

        (*l).cur = rumpf
        bereich_auf(l)
        anlegen(l, ast.s_a(b, i), islot)
        vec_push[u32](&(*l).l_break, ende)
        vec_push[u32](&(*l).l_cont, schritt)
        vec_push[u32](&(*l).l_tiefe, vec_len[u32](&(*l).d_grenze) as u32)
        block(l, ast.s_d(b, i))
        vec_pop[u32](&(*l).l_break)
        vec_pop[u32](&(*l).l_cont)
        vec_pop[u32](&(*l).l_tiefe)
        bereich_zu(l)
        if !terminiert(l) {
            term(l, fir.TERM_BR, schritt, 0, 0)
        }

        (*l).cur = schritt
        let iv2: u32 = lade(l, ft, islot)
        let eins: u32 = konst(l, ft, 1)
        let inc: u32 = push(l, fir.O_BIN, ft, iv2, eins, 0, 0, 0, 0)
        speichere(l, ft, islot, inc)
        term(l, fir.TERM_BR, kopf, 0, 0)

        (*l).cur = ende
        return
    }
    if a == ast.S_BREAK {
        defer_bis(l, vec_letztes[u32](&(*l).l_tiefe))
        term(l, fir.TERM_BR, vec_letztes[u32](&(*l).l_break), 0, 0)
        (*l).cur = neuer_block(l)
        return
    }
    if a == ast.S_CONT {
        defer_bis(l, vec_letztes[u32](&(*l).l_tiefe))
        term(l, fir.TERM_BR, vec_letztes[u32](&(*l).l_cont), 0, 0)
        (*l).cur = neuer_block(l)
        return
    }
    if a == ast.S_DEFER || a == ast.S_ERRDEFER {
        // Nur VORMERKEN — ausgefuehrt wird beim Verlassen des Blocks.
        vec_push[u32](&(*l).d_stmt, ast.s_a(b, i))
        if a == ast.S_ERRDEFER {
            vec_push[u32](&(*l).d_err, 1)
        } else {
            vec_push[u32](&(*l).d_err, 0)
        }
        return
    }
}

fn block(l: *mut Lower, bi: u32) {
    let b: *mut ast.Baum = baum(l)
    bereich_auf(l)
    defer_ebene_auf(l)
    var k: u32 = 0
    while k < ast.b_len(b, bi) {
        anweisung(l, ast.sliste_at(b, ast.b_off(b, bi) + k))
        k = k + 1
    }
    // Die aufgeschobenen Anweisungen laufen VOR dem Schliessen des Bereichs,
    // damit die Namen des Blocks noch sichtbar sind.
    defer_ebene_zu(l)
    bereich_zu(l)
}

// ------------------------------------------- enum/match (lower_match.rs)
//
// Portierung des Lowerings von `match` und Aufzaehlungskonstruktoren.
// Ergebnis ist ein `switch` ueber die Variantennummer (bzw. den
// Ganzzahlwert); Untermuster werden als Kette von Vergleichen HINTER dem
// Sprung geprueft. Die Reihenfolge der erzeugten Instruktionen und Bloecke
// ist Vertrag — `tools/fir_vergleich.sh` vergleicht Oktett fuer Oktett.

// Bereichsmuster bis zu dieser Weite werden in einzelne Sprungmarken
// aufgeloest; breitere werden als Vergleich geprueft (MAX_RANGE_KEYS).
const MAX_BEREICH_MARKEN: i64 = 256

// Schreibt `Enum::Variante(a, b)` unmittelbar an die Adresse `adr`.
fn ctor_schreiben(l: *mut Lower, e: u32, adr: u32) {
    let b: *mut ast.Baum = baum(l)
    let m: *mut muster.Mus = mul(l)
    let t: u32 = sema.sema_typ(sm(l), e)
    if typen.ty_art(tf(l), t) != typen.K_STRUCT {
        (*l).fehler = (*l).fehler + 1
        return
    }
    let ei: u32 = muster.mus_enum_bei_struct(m, typen.ty_a(tf(l), t))
    if ei == KEIN {
        (*l).fehler = (*l).fehler + 1
        return
    }
    // Variantenname aus dem Aufrufnamen (hinter dem ersten `::`).
    let it: *mut intern.Interner = namen(l)
    let zp: u64 = intern.intern_zeiger(it, ast.e_a(b, e))
    let zn: usize = intern.intern_laenge(it, ast.e_a(b, e))
    var vname: u32 = KEIN
    var i: usize = 0
    while i + 1 < zn {
        if rt.ld8(zp, i) == 58 as u8 && rt.ld8(zp, i + 1) == 58 as u8 {
            vname = intern.intern_nummer(it, zp + (i + 2) as u64, zn - i - 2) as u32
            break
        }
        i = i + 1
    }
    let vi: u32 = muster.mus_variante_finden(m, ei, vname)
    if vi == KEIN {
        (*l).fehler = (*l).fehler + 1
        return
    }
    // Zuerst die Variantennummer, dann die Nutzdatenfelder.
    let tk: u32 = konst(l, fir.T_U32, muster.mus_v_tag(m, vi) as u64)
    speichere(l, fir.T_U32, adr, tk)
    let roff: u32 = muster.mus_v_roff(m, vi)
    let anz: u32 = ast.e_c(b, e)
    var k: u32 = 0
    while k < anz {
        let off: u64 = muster.mus_rf_off(m, roff + k)
        let ad: u32 = ptradd_konst(l, adr, off)
        schreib_nach(l, ad, ast.kind_at(b, ast.e_b(b, e) + k))
        k = k + 1
    }
}

// Was ein Fall zum Schluessel beitraegt (ArmPlan in lower_match.rs):
// pl_hat = 0 heisst "kommt fuer JEDEN Schluessel in Frage", pl_test = 1
// heisst "nach dem Schluessel sind noch Vergleiche noetig". Die Marken eines
// Falls liegen flach in `pk`.
fn plan_arm(l: *mut Lower, pat: u32, sj_ei: u32,
            pl_hat: *mut Vec[u32], pl_test: *mut Vec[u32],
            pl_off: *mut Vec[u32], pl_len: *mut Vec[u32], pk: *mut Vec[i64]) {
    let m: *mut muster.Mus = mul(l)
    let a: u32 = muster.mus_mu_art(m, pat)
    vec_push[u32](pl_off, vec_len[i64](pk) as u32)
    if a == muster.MU_WILD || a == muster.MU_BIND {
        vec_push[u32](pl_hat, 0)
        vec_push[u32](pl_test, 0)
        vec_push[u32](pl_len, 0)
        return
    }
    if a == muster.MU_INT {
        vec_push[u32](pl_hat, 1)
        vec_push[u32](pl_test, 0)
        vec_push[i64](pk, muster.mus_mu_lo(m, pat))
        vec_push[u32](pl_len, 1)
        return
    }
    if a == muster.MU_BOOL {
        vec_push[u32](pl_hat, 1)
        vec_push[u32](pl_test, 0)
        vec_push[i64](pk, muster.mus_mu_a(m, pat) as i64)
        vec_push[u32](pl_len, 1)
        return
    }
    if a == muster.MU_BEREICH {
        let lo: i64 = muster.mus_mu_lo(m, pat)
        var last: i64 = muster.mus_mu_hi(m, pat)
        if muster.mus_mu_a(m, pat) == 0 {
            last = last - 1
        }
        let weite: i64 = last - lo + 1
        if weite > 0 && weite <= MAX_BEREICH_MARKEN {
            vec_push[u32](pl_hat, 1)
            vec_push[u32](pl_test, 0)
            var v: i64 = lo
            var n: u32 = 0
            while v <= last {
                vec_push[i64](pk, v)
                n = n + 1
                v = v + 1
            }
            vec_push[u32](pl_len, n)
        } else {
            vec_push[u32](pl_hat, 0)
            vec_push[u32](pl_test, 1)
            vec_push[u32](pl_len, 0)
        }
        return
    }
    // MU_VARIANT: der Schluessel ist die Variantennummer; Restpruefung, wenn
    // ein Untermuster nicht unanfechtbar ist.
    let vi: u32 = muster.mus_variante_finden(m, sj_ei, muster.mus_mu_b(m, pat))
    var tag: i64 = 0 - 1
    if vi != KEIN {
        tag = muster.mus_v_tag(m, vi) as i64
    }
    vec_push[u32](pl_hat, 1)
    vec_push[i64](pk, tag)
    vec_push[u32](pl_len, 1)
    var test: u32 = 0
    let soff: u32 = muster.mus_mu_soff(m, pat)
    let slen: u32 = muster.mus_mu_slen(m, pat)
    var k: u32 = 0
    while k < slen {
        if !muster.mus_unanfechtbar(m, muster.mus_mu_kind(m, soff + k)) {
            test = 1
        }
        k = k + 1
    }
    vec_push[u32](pl_test, test)
}

// Faelle, die fuer `key` (bzw. fuer die Auffangkette) in Frage kommen —
// Quelltextreihenfolge; nach dem ersten Fall ohne Restpruefung ist Schluss.
fn kandidaten(l: *mut Lower, pl_hat: *mut Vec[u32], pl_test: *mut Vec[u32],
              pl_off: *mut Vec[u32], pl_len: *mut Vec[u32], pk: *mut Vec[i64],
              alen: u32, hat_key: bool, key: i64, aus: *mut Vec[u32]) {
    var i: u32 = 0
    while i < alen {
        var passt: bool = false
        if vec_at[u32](pl_hat, i as usize) == 0 {
            passt = true
        } else if hat_key {
            let off: u32 = vec_at[u32](pl_off, i as usize)
            let len: u32 = vec_at[u32](pl_len, i as usize)
            var k: u32 = 0
            while k < len {
                if vec_at[i64](pk, (off + k) as usize) == key {
                    passt = true
                }
                k = k + 1
            }
        }
        if passt {
            vec_push[u32](aus, i)
            if vec_at[u32](pl_test, i as usize) == 0 {
                return
            }
        }
        i = i + 1
    }
}

// Restpruefung EINES Untermusters an der Adresse `adr`. Bei Erfolg faellt
// der Ablauf durch, bei Misserfolg geht es nach `fail`.
fn unter_test(l: *mut Lower, adr: u32, pat: u32, ty: u32, fail: u32) {
    let m: *mut muster.Mus = mul(l)
    let a: u32 = muster.mus_mu_art(m, pat)
    if a == muster.MU_WILD || a == muster.MU_BIND {
        return
    }
    if a == muster.MU_INT {
        let ft: u32 = fty(l, ty)
        let av: u32 = lade(l, ft, adr)
        let bv: u32 = konst(l, ft, muster.mus_mu_lo(m, pat) as u64)
        let c: u32 = push(l, fir.O_CMP, fir.T_BOOL, av, bv, 0, ft as u64, 0, 0)
        let nb: u32 = neuer_block(l)
        term(l, fir.TERM_BRCOND, c, nb, fail)
        (*l).cur = nb
        return
    }
    if a == muster.MU_BOOL {
        let av: u32 = lade(l, fir.T_BOOL, adr)
        let bv: u32 = konst(l, fir.T_BOOL, muster.mus_mu_a(m, pat) as u64)
        let c: u32 = push(l, fir.O_CMP, fir.T_BOOL, av, bv, 0, fir.T_BOOL as u64, 0, 0)
        let nb: u32 = neuer_block(l)
        term(l, fir.TERM_BRCOND, c, nb, fail)
        (*l).cur = nb
        return
    }
    if a == muster.MU_BEREICH {
        let ft: u32 = fty(l, ty)
        var last: i64 = muster.mus_mu_hi(m, pat)
        if muster.mus_mu_a(m, pat) == 0 {
            last = last - 1
        }
        let av: u32 = lade(l, ft, adr)
        let k1: u32 = konst(l, ft, muster.mus_mu_lo(m, pat) as u64)
        let c1: u32 = push(l, fir.O_CMP, fir.T_BOOL, av, k1, 5, ft as u64, 0, 0)
        let nb: u32 = neuer_block(l)
        term(l, fir.TERM_BRCOND, c1, nb, fail)
        (*l).cur = nb
        let k2: u32 = konst(l, ft, last as u64)
        let c2: u32 = push(l, fir.O_CMP, fir.T_BOOL, av, k2, 3, ft as u64, 0, 0)
        let nb2: u32 = neuer_block(l)
        term(l, fir.TERM_BRCOND, c2, nb2, fail)
        (*l).cur = nb2
        return
    }
    // MU_VARIANT: erst die Variantennummer, dann die Untermuster.
    if typen.ty_art(tf(l), ty) != typen.K_STRUCT {
        (*l).fehler = (*l).fehler + 1
        return
    }
    let ei: u32 = muster.mus_enum_bei_struct(m, typen.ty_a(tf(l), ty))
    if ei == KEIN {
        (*l).fehler = (*l).fehler + 1
        return
    }
    let vi: u32 = muster.mus_variante_finden(m, ei, muster.mus_mu_b(m, pat))
    if vi == KEIN {
        (*l).fehler = (*l).fehler + 1
        return
    }
    let av: u32 = lade(l, fir.T_U32, adr)
    let bv: u32 = konst(l, fir.T_U32, muster.mus_v_tag(m, vi) as u64)
    let c: u32 = push(l, fir.O_CMP, fir.T_BOOL, av, bv, 0, fir.T_U32 as u64, 0, 0)
    let nb: u32 = neuer_block(l)
    term(l, fir.TERM_BRCOND, c, nb, fail)
    (*l).cur = nb
    let soff: u32 = muster.mus_mu_soff(m, pat)
    let slen: u32 = muster.mus_mu_slen(m, pat)
    let roff: u32 = muster.mus_v_roff(m, vi)
    var k: u32 = 0
    while k < slen {
        let sub: u32 = muster.mus_mu_kind(m, soff + k)
        if !muster.mus_unanfechtbar(m, sub) {
            let off: u64 = muster.mus_rf_off(m, roff + k)
            let ft: u32 = muster.mus_rf_typ(m, roff + k)
            let sa: u32 = ptradd_konst(l, adr, off)
            unter_test(l, sa, sub, ft, fail)
        }
        k = k + 1
    }
}

// Restpruefungen eines Musters auf oberster Ebene (emit_tests).
fn muster_tests(l: *mut Lower, basis: u32, pat: u32, sj_ei: u32,
                schl: u32, kft: u32, fail: u32) {
    let m: *mut muster.Mus = mul(l)
    let a: u32 = muster.mus_mu_art(m, pat)
    if a == muster.MU_WILD || a == muster.MU_BIND || a == muster.MU_INT {
        return
    }
    if a == muster.MU_BOOL {
        return
    }
    if a == muster.MU_BEREICH {
        var last: i64 = muster.mus_mu_hi(m, pat)
        if muster.mus_mu_a(m, pat) == 0 {
            last = last - 1
        }
        // Schluessel direkt vergleichen (kein load — er liegt schon vor).
        let k1: u32 = konst(l, kft, muster.mus_mu_lo(m, pat) as u64)
        let c1: u32 = push(l, fir.O_CMP, fir.T_BOOL, schl, k1, 5, kft as u64, 0, 0)
        let nb: u32 = neuer_block(l)
        term(l, fir.TERM_BRCOND, c1, nb, fail)
        (*l).cur = nb
        let k2: u32 = konst(l, kft, last as u64)
        let c2: u32 = push(l, fir.O_CMP, fir.T_BOOL, schl, k2, 3, kft as u64, 0, 0)
        let nb2: u32 = neuer_block(l)
        term(l, fir.TERM_BRCOND, c2, nb2, fail)
        (*l).cur = nb2
        return
    }
    // MU_VARIANT: der Schluessel (Variantennummer) ist schon geprueft; hier
    // nur die Untermuster, die nicht unanfechtbar sind.
    let vi: u32 = muster.mus_variante_finden(m, sj_ei, muster.mus_mu_b(m, pat))
    if vi == KEIN {
        (*l).fehler = (*l).fehler + 1
        return
    }
    let soff: u32 = muster.mus_mu_soff(m, pat)
    let slen: u32 = muster.mus_mu_slen(m, pat)
    let roff: u32 = muster.mus_v_roff(m, vi)
    var k: u32 = 0
    while k < slen {
        let sub: u32 = muster.mus_mu_kind(m, soff + k)
        if !muster.mus_unanfechtbar(m, sub) {
            let off: u64 = muster.mus_rf_off(m, roff + k)
            let ft: u32 = muster.mus_rf_typ(m, roff + k)
            let sa: u32 = ptradd_konst(l, basis, off)
            unter_test(l, sa, sub, ft, fail)
        }
        k = k + 1
    }
}

// Die Pruefkette eines Schluessels (emit_chain): probiert die Kandidaten in
// Quelltextreihenfolge; der letzte Ausweg ist `fallthrough`.
fn kette(l: *mut Lower, mi: u32, cands: *mut Vec[u32],
         pl_test: *mut Vec[u32], basis: u32, schl: u32, kft: u32,
         sj_ei: u32, koerper: *mut Vec[u32], fallthrough: u32) -> u32 {
    let m: *mut muster.Mus = mul(l)
    let entry: u32 = neuer_block(l)
    (*l).cur = entry
    var ci: usize = 0
    while ci < vec_len[u32](cands) {
        let ai: u32 = vec_at[u32](cands, ci)
        let koerper_bb: u32 = vec_at[u32](koerper, ai as usize)
        if vec_at[u32](pl_test, ai as usize) == 0 {
            term(l, fir.TERM_BR, koerper_bb, 0, 0)
            return entry
        }
        let fail: u32 = neuer_block(l)
        let aoff: u32 = muster.mus_m_aoff(m, mi)
        muster_tests(l, basis, muster.mus_a_pat(m, aoff + ai), sj_ei, schl, kft, fail)
        term(l, fir.TERM_BR, koerper_bb, 0, 0)
        (*l).cur = fail
        ci = ci + 1
    }
    term(l, fir.TERM_BR, fallthrough, 0, 0)
    return entry
}

// Bindungen eines Musters: jede Bindung ist die ADRESSE des getroffenen
// Werts (Aufzaehlungswerte liegen im Speicher).
fn muster_binden(l: *mut Lower, adr: u32, pat: u32, ty: u32, sj_ei: u32) {
    let m: *mut muster.Mus = mul(l)
    let a: u32 = muster.mus_mu_art(m, pat)
    if a == muster.MU_BIND {
        anlegen(l, muster.mus_mu_a(m, pat), adr)
        return
    }
    if a == muster.MU_VARIANT {
        var ei: u32 = sj_ei
        if ei == KEIN {
            if typen.ty_art(tf(l), ty) == typen.K_STRUCT {
                ei = muster.mus_enum_bei_struct(m, typen.ty_a(tf(l), ty))
            }
        }
        if ei == KEIN {
            return
        }
        let vi: u32 = muster.mus_variante_finden(m, ei, muster.mus_mu_b(m, pat))
        if vi == KEIN {
            return
        }
        let soff: u32 = muster.mus_mu_soff(m, pat)
        let slen: u32 = muster.mus_mu_slen(m, pat)
        let roff: u32 = muster.mus_v_roff(m, vi)
        var k: u32 = 0
        while k < slen {
            let off: u64 = muster.mus_rf_off(m, roff + k)
            let ft: u32 = muster.mus_rf_typ(m, roff + k)
            let sa: u32 = ptradd_konst(l, adr, off)
            muster_binden(l, sa, muster.mus_mu_kind(m, soff + k), ft, KEIN)
            k = k + 1
        }
        return
    }
}

// Das `match` mit der Nummer `mi` lowern (lower_match in lower_match.rs).
fn match_lower(l: *mut Lower, mi: u32) {
    let m: *mut muster.Mus = mul(l)
    let b: *mut ast.Baum = baum(l)
    if mi as usize >= muster.mus_match_anzahl(m) {
        (*l).fehler = (*l).fehler + 1
        return
    }
    let subj: u32 = muster.mus_m_subj(m, mi)
    let sty: u32 = sema.sema_typ(sm(l), subj)
    var sj_ei: u32 = KEIN
    if typen.ty_art(tf(l), sty) == typen.K_STRUCT {
        sj_ei = muster.mus_enum_bei_struct(m, typen.ty_a(tf(l), sty))
    }

    // Schluesselwert und Adresse des Subjekts bestimmen. Eine Aufzaehlung
    // liegt im Speicher: Schluessel ist die geladene Variantennummer (u32).
    // Sonst ist der Wert selbst der Schluessel, und die Adresse ist ein
    // Zwischenplatz fuer moegliche Bindungen.
    var basis: u32 = 0
    var schl: u32 = 0
    var kft: u32 = fir.T_U32
    if sj_ei != KEIN {
        basis = adresse(l, subj)
        schl = lade(l, fir.T_U32, basis)
    } else {
        kft = e_fty(l, subj)
        let v: u32 = wert(l, subj)
        basis = alloca(l, q_groesse(l, sty), q_ausricht(l, sty))
        speichere(l, kft, basis, v)
        schl = v
    }
    let start: u32 = (*l).cur

    let aoff: u32 = muster.mus_m_aoff(m, mi)
    let alen: u32 = muster.mus_m_alen(m, mi)

    var pl_hat: Vec[u32] = vec_neu[u32]()
    var pl_test: Vec[u32] = vec_neu[u32]()
    var pl_off: Vec[u32] = vec_neu[u32]()
    var pl_len: Vec[u32] = vec_neu[u32]()
    var pk: Vec[i64] = vec_neu[i64]()
    var koerper: Vec[u32] = vec_neu[u32]()
    defer vec_frei[u32](&pl_hat)
    defer vec_frei[u32](&pl_test)
    defer vec_frei[u32](&pl_off)
    defer vec_frei[u32](&pl_len)
    defer vec_frei[i64](&pk)
    defer vec_frei[u32](&koerper)

    var ai: u32 = 0
    while ai < alen {
        plan_arm(l, muster.mus_a_pat(m, aoff + ai), sj_ei,
                 &pl_hat, &pl_test, &pl_off, &pl_len, &pk)
        vec_push[u32](&koerper, neuer_block(l))
        ai = ai + 1
    }
    let join: u32 = neuer_block(l)

    // Schluessel einsammeln: aufsteigend, duplikatfrei.
    var keys: Vec[i64] = vec_neu[i64]()
    defer vec_frei[i64](&keys)
    ai = 0
    while ai < alen {
        if vec_at[u32](&pl_hat, ai as usize) != 0 {
            let off: u32 = vec_at[u32](&pl_off, ai as usize)
            let len: u32 = vec_at[u32](&pl_len, ai as usize)
            var k: u32 = 0
            while k < len {
                let key: i64 = vec_at[i64](&pk, (off + k) as usize)
                var da: bool = false
                var x: usize = 0
                while x < vec_len[i64](&keys) {
                    if vec_at[i64](&keys, x) == key {
                        da = true
                    }
                    x = x + 1
                }
                if !da {
                    vec_push[i64](&keys, key)
                }
                k = k + 1
            }
        }
        ai = ai + 1
    }
    // Aufsteigend sortieren (die Liste ist kurz — Einfuegesortierung).
    var i1: usize = 1
    while i1 < vec_len[i64](&keys) {
        let v: i64 = vec_at[i64](&keys, i1)
        var j: usize = i1
        while j > 0 {
            if vec_at[i64](&keys, j - 1) <= v {
                break
            }
            vec_setzen[i64](&keys, j, vec_at[i64](&keys, j - 1))
            j = j - 1
        }
        vec_setzen[i64](&keys, j, v)
        i1 = i1 + 1
    }

    // Auffangkette ZUERST (ihre Blocknummern kommen vor den Schluesselketten),
    // dann je Schluessel die Kandidatenkette.
    var cands: Vec[u32] = vec_neu[u32]()
    defer vec_frei[u32](&cands)
    kandidaten(l, &pl_hat, &pl_test, &pl_off, &pl_len, &pk, alen, false, 0, &cands)
    let auffang_bb: u32 = kette(l, mi, &cands, &pl_test, basis, schl, kft,
                                sj_ei, &koerper, join)

    let sw_off: u32 = fir.sw_anfang(&(*l).f)
    var sw_len: u32 = 0
    var ki: usize = 0
    while ki < vec_len[i64](&keys) {
        let key: i64 = vec_at[i64](&keys, ki)
        vec_leeren[u32](&cands)
        kandidaten(l, &pl_hat, &pl_test, &pl_off, &pl_len, &pk, alen, true, key, &cands)
        let bb: u32 = kette(l, mi, &cands, &pl_test, basis, schl, kft,
                            sj_ei, &koerper, auffang_bb)
        fir.sw_dazu(&(*l).f, key, bb)
        sw_len = sw_len + 1
        ki = ki + 1
    }
    if sw_len == 0 {
        fir.term_setzen(&(*l).f, (*l).fi, start, fir.TERM_BR, auffang_bb, 0, 0)
    } else {
        fir.term_switch(&(*l).f, (*l).fi, start, schl, kft, auffang_bb, sw_off, sw_len)
    }

    // Rumpf jedes Falls.
    ai = 0
    while ai < alen {
        (*l).cur = vec_at[u32](&koerper, ai as usize)
        bereich_auf(l)
        muster_binden(l, basis, muster.mus_a_pat(m, aoff + ai), sty, sj_ei)
        block(l, muster.mus_a_block(m, aoff + ai))
        bereich_zu(l)
        if !terminiert(l) {
            term(l, fir.TERM_BR, join, 0, 0)
        }
        ai = ai + 1
    }
    (*l).cur = join
}

// ------------------------------------------------------------------- Lauf

// -------------------------------------- fehlerunionen (lower_errors.rs)
//
// Portierung des Lowerings von `try`, `catch`, `Menge::Variante` und der
// impliziten Umwandlung. Eine Fehlerunion ist ein gewoehnlicher Struct
// (`{ __err: u32, __val: T }`, 0 = Erfolg) — es braucht keine neue
// FIR-Instruktion, nur load/store, einen Vergleich und eine Verzweigung.
// Die Reihenfolge der erzeugten Instruktionen und Bloecke ist Vertrag,
// `tools/fir_vergleich.sh` vergleicht Oktett fuer Oktett.
//
// RUNDE 36: `ret_term_fehler` ist portiert — der Fehlerpfad
// (`return E::Variante`, `try`) laesst zusaetzlich die `errdefer`-
// Anweisungen laufen (`defer_bis_fehler`).

// Schreibt die Fehlerunion an `addr` — Erfolgswert oder Fehlercode
// (`write_union`). BUSY verhindert, dass der Rohwert-Zugriff erneut in
// die Umwandlung laeuft.
fn union_schreiben(l: *mut Lower, addr: u32, e: u32, cu: u32) {
    fehler.fehler_busy_auf(fel(l), e)
    let art: u32 = fehler.fehler_coerce_art(fel(l), e)
    if art == fehler.FEHLER_AUS_WERT {
        let zero: u32 = konst(l, fir.T_U32, 0)
        speichere(l, fir.T_U32, addr, zero)
        let va: u32 = ptradd_konst(l, addr, fehler.fehler_u_voff(fel(l), cu))
        schreib_nach(l, va, e)
    } else {
        let code: u32 = fehlercode(l, e)
        speichere(l, fir.T_U32, addr, code)
    }
    fehler.fehler_busy_zu(fel(l), e)
}

// Fehlercode eines Ausdrucks vom Typ einer Fehlermenge (`error_code`):
// bei einer Variante die Konstante, sonst der geladene Code.
fn fehlercode(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(l)
    if ast.e_art(b, e) == ast.E_RUF && ast.e_zahl(b, e) == 0 {
        let cc: i64 = fehler.fehler_ctor_code((*l).feh, namen(l), ast.e_a(b, e))
        if cc >= 0 {
            return konst(l, fir.T_U32, cc as u64)
        }
    }
    let a: u32 = adresse(l, e)
    return lade(l, fir.T_U32, a)
}

// `Menge::Variante` als Wert: ein Platz mit dem Code (`ctor_addr`).
fn ctor_adresse(l: *mut Lower, e: u32, code: u64) -> u32 {
    let t: u32 = sema.sema_typ(sm(l), e)
    let slot: u32 = alloca(l, q_groesse(l, t), q_ausricht(l, t))
    let c: u32 = konst(l, fir.T_U32, code)
    speichere(l, fir.T_U32, slot, c)
    return slot
}

// Kopiert einen Wert vom Typ `t` von `src` nach `dst` (`copy_value`).
fn kopie_wert(l: *mut Lower, dst: u32, src: u32, t: u32) {
    if ist_aggregat(l, t) {
        copymem(l, dst, src, typen.groesse_von(tf(l), t))
        return
    }
    // Wie `scalar_fty` in lower_errors.rs: f64 ist dort ABSICHTLICH nicht
    // im Muster — kein Programm im Korpus hat `E!f64`; hier dasselbe.
    if typen.ty_art(tf(l), t) == typen.K_F64 {
        return
    }
    let ft: u32 = fty(l, t)
    if ft == fir.KEIN || ft == fir.T_VOID {
        return
    }
    let v: u32 = lade(l, ft, src)
    speichere(l, ft, dst, v)
}

// `return` mit impliziter Umwandlung in die Fehlerunion der Funktion
// (`do_return`).
fn fehler_return(l: *mut Lower, v: u32, cu: u32) {
    // `return E::Variante` ist der Fehlerpfad, `return wert` der
    // Erfolgspfad — der Typpruefer hat das entschieden (`coerce_art`).
    let fehlerpfad: bool = fehler.fehler_coerce_art(fel(l), v) == fehler.FEHLER_AUS_FEHLER
    if (*l).sret != KEIN {
        union_schreiben(l, (*l).sret, v, cu)
        if fehlerpfad {
            defer_bis_fehler(l)
        } else {
            defer_bis(l, 0)
        }
        term(l, fir.TERM_RET, (*l).sret, 0, 0)
        return
    }
    // Bis 8 Byte liegt die Fehlerunion in einem Wort in `rax` (abi). Der
    // Zwischenspeicher wird genullt, damit die Fuellbytes in jeder
    // Baustufe denselben Wert haben.
    let slot: u32 = alloca(l, 8, 8)
    let zero: u32 = konst(l, fir.T_I64, 0)
    speichere(l, fir.T_I64, slot, zero)
    union_schreiben(l, slot, v, cu)
    let w: u32 = lade(l, fir.T_I64, slot)
    if fehlerpfad {
        defer_bis_fehler(l)
    } else {
        defer_bis(l, 0)
    }
    term(l, fir.TERM_RET, w, 0, 0)
}

// Verlaesst die Funktion mit dem Fehlercode `code` (`return_error`) —
// IMMER der Fehlerpfad: hier laufen auch die `errdefer`-Anweisungen.
fn fehler_verlassen(l: *mut Lower, code: u32) {
    if (*l).sret != KEIN {
        speichere(l, fir.T_U32, (*l).sret, code)
        defer_bis_fehler(l)
        term(l, fir.TERM_RET, (*l).sret, 0, 0)
        return
    }
    let slot: u32 = alloca(l, 8, 8)
    let zero: u32 = konst(l, fir.T_I64, 0)
    speichere(l, fir.T_I64, slot, zero)
    speichere(l, fir.T_U32, slot, code)
    let w: u32 = lade(l, fir.T_I64, slot)
    defer_bis_fehler(l)
    term(l, fir.TERM_RET, w, 0, 0)
}

// `try a` — liefert die Adresse des Erfolgswertes; im Fehlerfall wird die
// Funktion mit demselben Code verlassen (`try_value_addr`).
fn try_adresse(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(l)
    let u: u32 = fehler.fehler_try(fel(l), e)
    if u == KEIN {
        aufgeben(l)
        return 0
    }
    let arg: u32 = ast.kind_at(b, ast.e_b(b, e))
    let src: u32 = adresse(l, arg)
    let code: u32 = lade(l, fir.T_U32, src)
    let zero: u32 = konst(l, fir.T_U32, 0)
    let bad: u32 = push(l, fir.O_CMP, fir.T_BOOL, code, zero, 1,
                        fir.T_U32 as u64, 0, 0)
    let fail: u32 = neuer_block(l)
    let cont: u32 = neuer_block(l)
    term(l, fir.TERM_BRCOND, bad, fail, cont)
    (*l).cur = fail
    fehler_verlassen(l, code)
    (*l).cur = cont
    return ptradd_konst(l, src, fehler.fehler_u_voff(fel(l), u))
}

// `a catch b` — liefert die Adresse des Ergebnisses (Erfolgswert oder
// Ersatz) in einem eigenen Platz (`catch_slot`).
fn catch_slot(l: *mut Lower, e: u32) -> u32 {
    let b: *mut ast.Baum = baum(l)
    let u: u32 = fehler.fehler_catch(fel(l), e)
    if u == KEIN {
        aufgeben(l)
        return 0
    }
    let lhs: u32 = ast.kind_at(b, ast.e_b(b, e))
    let rhs: u32 = ast.kind_at(b, ast.e_b(b, e) + 1)
    let vt: u32 = fehler.fehler_u_valty(fel(l), u)
    let slot: u32 = alloca(l, q_groesse(l, vt), q_ausricht(l, vt))
    let src: u32 = adresse(l, lhs)
    let code: u32 = lade(l, fir.T_U32, src)
    let zero: u32 = konst(l, fir.T_U32, 0)
    let good: u32 = push(l, fir.O_CMP, fir.T_BOOL, code, zero, 0,
                         fir.T_U32 as u64, 0, 0)
    let ok_bb: u32 = neuer_block(l)
    let alt_bb: u32 = neuer_block(l)
    let join: u32 = neuer_block(l)
    term(l, fir.TERM_BRCOND, good, ok_bb, alt_bb)

    (*l).cur = ok_bb
    let va: u32 = ptradd_konst(l, src, fehler.fehler_u_voff(fel(l), u))
    kopie_wert(l, slot, va, vt)
    if !terminiert(l) {
        term(l, fir.TERM_BR, join, 0, 0)
    }

    (*l).cur = alt_bb
    // `catch |f| ...`: der Fehlerwert liegt im Ersatz als Variable.
    let bind: u32 = fehler.fehler_cb(fel(l), e)
    if bind != KEIN {
        bereich_auf(l)
        let eslot: u32 = alloca(l, 4, 4)
        speichere(l, fir.T_U32, eslot, code)
        anlegen(l, bind, eslot)
    }
    schreib_nach(l, slot, rhs)
    if bind != KEIN {
        bereich_zu(l)
    }
    if !terminiert(l) {
        term(l, fir.TERM_BR, join, 0, 0)
    }

    (*l).cur = join
    return slot
}

fn low_lauf(l: *mut Lower) {
    let b: *mut ast.Baum = baum(l)
    var i: usize = 0
    while i < ast.fn_anzahl(b) {
        let rt2: u32 = typen.ret_typ_der_funktion(tf(l), i)
        let ret_agg: bool = ist_aggregat(l, rt2)
        let sret: bool = abi_sret(l, rt2)
        // FIR-Rueckgabetyp: Aggregat ueber den versteckten Zeiger, sonst ein
        // Wort in `rax`.
        var rf: u32 = 0
        if ret_agg {
            if sret {
                rf = fir.T_PTR
            } else {
                rf = fir.T_I64
            }
        } else {
            rf = fty(l, rt2)
            if rf == fir.KEIN {
                aufgeben(l)
                return
            }
        }
        // FIR-Parameter aus der Aufrufkonvention.
        let poff: u32 = vec_len[u32](&(*l).f.p_typ) as u32
        if sret {
            vec_push[u32](&(*l).f.p_typ, fir.T_PTR)
        }
        // Art je Quellparameter: >=0 Anzahl Woerter · KEIN Zeiger · sonst skalar
        var art: Vec[u32] = vec_neu[u32]()
        var k: u32 = 0
        while k < ast.fn_plen(b, i) {
            let pt: u32 = typen.param_typ_aufgeloest(tf(l), i, k)
            if ist_aggregat(l, pt) {
                let kl: u32 = abi_klasse(l, pt)
                if kl != fir.KEIN {
                    var w: u32 = 0
                    while w < kl {
                        vec_push[u32](&(*l).f.p_typ, fir.T_I64)
                        w = w + 1
                    }
                    vec_push[u32](&art, kl)
                } else {
                    vec_push[u32](&(*l).f.p_typ, fir.T_PTR)
                    vec_push[u32](&art, KEIN)
                }
            } else {
                let pf: u32 = fty(l, pt)
                if pf == fir.KEIN || pf == fir.T_VOID {
                    aufgeben(l)
                    vec_frei[u32](&art)
                    return
                }
                vec_push[u32](&(*l).f.p_typ, pf)
                vec_push[u32](&art, KEIN - 1)
            }
            k = k + 1
        }
        let plen: u32 = vec_len[u32](&(*l).f.p_typ) as u32 - poff
        (*l).fi = fir.fn_neu(&(*l).f, ast.fn_name(b, i), rf, poff, plen)
        // RUNDE 52 (kern.rs): `#[interrupt]` — eigene Aufrufkonvention.
        if ast.fn_int(b, i) != 0 {
            fir.f_int_setzen(&(*l).f, (*l).fi, 1)
        }
        (*l).cur = 0
        (*l).sret = KEIN
        var naechster: u32 = 0
        if sret {
            (*l).sret = fir.param_wert(&(*l).f, (*l).fi, 0)
            naechster = 1
        }
        bereich_auf(l)
        // Parameter bekommen einen Platz und werden im Eintrittsblock gesichert.
        k = 0
        while k < ast.fn_plen(b, i) {
            let pt: u32 = typen.param_typ_aufgeloest(tf(l), i, k)
            let ak: u32 = vec_at[u32](&art, k as usize)
            let pname: u32 = ast.param_name(b, ast.fn_poff(b, i) + k)
            if ak == KEIN - 1 {
                let pf: u32 = vec_at[u32](&(*l).f.p_typ, (poff + naechster) as usize)
                var by: u64 = fir.fty_bytes(pf)
                if by < 1 { by = 1 }
                let slot: u32 = alloca(l, by, by)
                speichere(l, pf, slot, fir.param_wert(&(*l).f, (*l).fi, naechster))
                naechster = naechster + 1
                anlegen(l, pname, slot)
            } else if ak == KEIN {
                // Der Aufrufer hat bereits eine Kopie angelegt; ihre Adresse
                // IST der Platz des Parameters.
                anlegen(l, pname, fir.param_wert(&(*l).f, (*l).fi, naechster))
                naechster = naechster + 1
            } else {
                // Der Platz wird auf volle Woerter aufgefuellt, damit die
                // Stores vollstaendig im Objekt liegen.
                var gr: u64 = q_groesse(l, pt)
                if gr < ak as u64 * 8 {
                    gr = ak as u64 * 8
                }
                var au: u64 = q_ausricht(l, pt)
                if au < 8 {
                    au = 8
                }
                let slot: u32 = alloca(l, gr, au)
                var w: u32 = 0
                while w < ak {
                    let a2: u32 = ptradd_konst(l, slot, w as u64 * 8)
                    speichere(l, fir.T_I64, a2, fir.param_wert(&(*l).f, (*l).fi, naechster + w))
                    w = w + 1
                }
                naechster = naechster + ak
                anlegen(l, pname, slot)
            }
            k = k + 1
        }
        vec_frei[u32](&art)
        block(l, ast.fn_rumpf(b, i))
        bereich_zu(l)
        if (*l).ungeeignet {
            return
        }
        // Offene (unerreichbare) Bloecke abschliessen.
        var bb: u32 = 0
        while bb < fir.block_anzahl(&(*l).f, (*l).fi) {
            if !fir.ist_terminiert(&(*l).f, (*l).fi, bb) {
                (*l).cur = bb
                if rf == fir.T_VOID {
                    term(l, fir.TERM_RET, KEIN, 0, 0)
                } else {
                    let v: u32 = konst(l, rf, 0)
                    term(l, fir.TERM_RET, v, 0, 0)
                }
            }
            bb = bb + 1
        }
        i = i + 1
    }
}
