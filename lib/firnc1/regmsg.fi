import rt
import intern
import types
import msgfmt
import report
import regerr

export { regmsg_say }

fn regmsg_say(r: *mut regerr.RegErr, i: usize, pend: *mut report.Pend, dmsg: *mut rt.Buf,
        t: *mut types.Types, it: *mut intern.Interner) -> bool {
    let code: u32 = regerr.regerr_code(r, i)
    let pos: u64 = regerr.regerr_pos(r, i)
    let a0: u64 = regerr.regerr_arg(r, i, 0)
    let a1: u64 = regerr.regerr_arg(r, i, 1)
    let a2: u64 = regerr.regerr_arg(r, i, 2)
    let a3: u64 = regerr.regerr_arg(r, i, 3)
    let a4: u64 = regerr.regerr_arg(r, i, 4)
    let a5: u64 = regerr.regerr_arg(r, i, 5)
    rt.buf_clear(dmsg)

    if code == 101 {
        var m101_0: [u8; 22] = "unknown error set '%n'"
        msgfmt.fmt_msg(dmsg, (&m101_0[0]) as u64, 22, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 102 {
        var m102_0: [u8; 49] = "the success type of an error union cannot be '()'"
        msgfmt.fmt_msg(dmsg, (&m102_0[0]) as u64, 49, t, it, 0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 103 {
        var m103_0: [u8; 78] = "an error union over the success type '%t' cannot be the field type of a struct"
        msgfmt.fmt_msg(dmsg, (&m103_0[0]) as u64, 78, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 104 {
        var m104_0: [u8; 29] = "type '%n' is already declared"
        msgfmt.fmt_msg(dmsg, (&m104_0[0]) as u64, 29, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 201 {
        var m201_0: [u8; 29] = "type '%n' is already declared"
        msgfmt.fmt_msg(dmsg, (&m201_0[0]) as u64, 29, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 202 {
        var m202_0: [u8; 23] = "unknown base class '%n'"
        msgfmt.fmt_msg(dmsg, (&m202_0[0]) as u64, 23, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 203 {
        var m203_0: [u8; 48] = "the inheritance chain of 'gc class %n' is cyclic"
        msgfmt.fmt_msg(dmsg, (&m203_0[0]) as u64, 48, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 204 {
        var m204_0: [u8; 56] = "field '%n' is already taken in the base of 'gc class %n'"
        msgfmt.fmt_msg(dmsg, (&m204_0[0]) as u64, 56, t, it, a0, a1, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 205 {
        var m205_0: [u8; 42] = "field type %t is not allowed in a gc class"
        msgfmt.fmt_msg(dmsg, (&m205_0[0]) as u64, 42, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 206 {
        var m206_0: [u8; 21] = "unknown gc class '%n'"
        msgfmt.fmt_msg(dmsg, (&m206_0[0]) as u64, 21, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 207 {
        var m207_0: [u8; 40] = "'%n' is a gc class and cannot be a value"
        msgfmt.fmt_msg(dmsg, (&m207_0[0]) as u64, 40, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 301 {
        var m301_0: [u8; 22] = "unknown interface '%n'"
        msgfmt.fmt_msg(dmsg, (&m301_0[0]) as u64, 22, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 302 {
        var m302_0: [u8; 26] = "the type '%n' is ambiguous"
        msgfmt.fmt_msg(dmsg, (&m302_0[0]) as u64, 26, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 303 {
        var m303_0: [u8; 17] = "unknown type '%n'"
        msgfmt.fmt_msg(dmsg, (&m303_0[0]) as u64, 17, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 304 {
        var m304_0: [u8; 35] = "'%n' is an interface and not a type"
        msgfmt.fmt_msg(dmsg, (&m304_0[0]) as u64, 35, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 305 {
        var m305_0: [u8; 42] = "'%n' already implements the interface '%n'"
        msgfmt.fmt_msg(dmsg, (&m305_0[0]) as u64, 42, t, it, a0, a1, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 306 {
        var m306_0: [u8; 42] = "'%n' does not implement the method '%n.%n'"
        msgfmt.fmt_msg(dmsg, (&m306_0[0]) as u64, 42, t, it, a0, a1, a2, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 307 {
        var m307_0: [u8; 41] = "the receiver of '%n.%n' does not fit '%n'"
        msgfmt.fmt_msg(dmsg, (&m307_0[0]) as u64, 41, t, it, a0, a1, a2, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 308 {
        var m308_0: [u8; 55] = "'%n.%n' has %d parameters, the interface '%n' requires "
        msgfmt.fmt_msg(dmsg, (&m308_0[0]) as u64, 55, t, it, a0, a1, a2, a3)
        var m308_1: [u8; 2] = "%d"
        msgfmt.fmt_msg(dmsg, (&m308_1[0]) as u64, 2, t, it, a4, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 309 {
        var m309_0: [u8; 52] = "parameter %d of '%n.%n' has type %t, the interface '"
        msgfmt.fmt_msg(dmsg, (&m309_0[0]) as u64, 52, t, it, a0, a1, a2, a3)
        var m309_1: [u8; 15] = "%n' requires %t"
        msgfmt.fmt_msg(dmsg, (&m309_1[0]) as u64, 15, t, it, a4, a5, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 310 {
        var m310_0: [u8; 48] = "'%n.%n' returns %t, the interface '%n' requires "
        msgfmt.fmt_msg(dmsg, (&m310_0[0]) as u64, 48, t, it, a0, a1, a2, a3)
        var m310_1: [u8; 2] = "%t"
        msgfmt.fmt_msg(dmsg, (&m310_1[0]) as u64, 2, t, it, a4, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 401 {
        var m401_0: [u8; 29] = "type '%n' is already declared"
        msgfmt.fmt_msg(dmsg, (&m401_0[0]) as u64, 29, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 402 {
        var m402_0: [u8; 73] = "field '%n' has the enum type '%n' — that is not supported in this stage"
        msgfmt.fmt_msg(dmsg, (&m402_0[0]) as u64, 73, t, it, a0, a1, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 403 {
        var m403_0: [u8; 50] = "enum '%n' contains itself (directly or indirectly)"
        msgfmt.fmt_msg(dmsg, (&m403_0[0]) as u64, 50, t, it, a0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    if code == 404 {
        var m404_0: [u8; 50] = "the payload of a variant cannot have the type '()'"
        msgfmt.fmt_msg(dmsg, (&m404_0[0]) as u64, 50, t, it, 0, 0, 0, 0)
        report.pend_add(pend, pos, 1, dmsg)
        return true
    }
    return false
}
