// SPDX-License-Identifier: MPL-2.0
import rt
import vec
import derive_decl
import derive_emit

fn dv_nvars(dc: *mut derive_decl.Dc) -> usize { return vec_len[usize](&(*dc).vars) / 4 }

fn dv_var_count(dc: *mut derive_decl.Dc, k: usize) -> usize { return vec_at[usize](&(*dc).vars, k * 4 + 3) }

fn dv_var_type_s(dc: *mut derive_decl.Dc, k: usize, j: usize) -> usize {
    return vec_at[usize](&(*dc).vtys, (vec_at[usize](&(*dc).vars, k * 4 + 2) + j) * 2)
}

fn dv_var_type_e(dc: *mut derive_decl.Dc, k: usize, j: usize) -> usize {
    return vec_at[usize](&(*dc).vtys, (vec_at[usize](&(*dc).vars, k * 4 + 2) + j) * 2 + 1)
}

fn dv_put_var_name(dc: *mut derive_decl.Dc, k: usize) {
    derive_decl.dv_put_range(dc, vec_at[usize](&(*dc).vars, k * 4), vec_at[usize](&(*dc).vars, k * 4 + 1))
}

fn dv_put_pattern(dc: *mut derive_decl.Dc, k: usize, bind: u8) {
    derive_decl.dv_put_range(dc, (*dc).name_s, (*dc).name_e)
    derive_decl.dv_put(dc, "::")
    dv_put_var_name(dc, k)
    let cnt: usize = dv_var_count(dc, k)
    if cnt == 0 { return }
    derive_decl.dv_put(dc, "(")
    var j: usize = 0
    while j < cnt {
        if j > 0 { derive_decl.dv_put(dc, ", ") }
        rt.buf_push(&(*dc).out, bind)
        derive_decl.dv_put_num(dc, j)
        j = j + 1
    }
    derive_decl.dv_put(dc, ")")
}

fn dv_bind(v: *mut derive_decl.Val, kind: u32, j: usize) {
    (*v).kind = kind
    (*v).s = j
    (*v).e = j
}

fn dv_e_debug(dc: *mut derive_decl.Dc) {
    var v: derive_decl.Val = derive_decl.Val { kind: 0, s: 0, e: 0 }
    derive_decl.dv_put(dc, "fn debug(*self) -> str { match *self { ")
    var k: usize = 0
    while k < dv_nvars(dc) {
        dv_put_pattern(dc, k, 97)
        derive_decl.dv_put(dc, " => { var c = derive.dbg_new(); c = derive.dbg_text(c, \"")
        dv_put_var_name(dc, k)
        derive_decl.dv_put(dc, "\"); ")
        let cnt: usize = dv_var_count(dc, k)
        if cnt > 0 {
            derive_decl.dv_put(dc, "c = derive.dbg_text(c, \"(\"); ")
            var j: usize = 0
            while j < cnt {
                if j > 0 { derive_decl.dv_put(dc, "c = derive.dbg_text(c, \", \"); ") }
                dv_bind(&v, derive_decl.KIND_BIND_A, j)
                derive_decl.dv_put(dc, "c = derive.dbg_text(c, ")
                derive_emit.dv_x_debug(dc, dv_var_type_s(dc, k, j), dv_var_type_e(dc, k, j), &v)
                derive_decl.dv_put(dc, "); ")
                j = j + 1
            }
            derive_decl.dv_put(dc, "c = derive.dbg_text(c, \")\"); ")
        }
        derive_decl.dv_put(dc, "return derive.dbg_done(c) } ")
        k = k + 1
    }
    derive_decl.dv_put(dc, "} } ")
}

fn dv_e_eq(dc: *mut derive_decl.Dc) {
    derive_decl.dv_put(dc, "fn eq(*self, o: ")
    derive_emit.dv_self_type(dc)
    derive_decl.dv_put(dc, ") -> bool { match *self { ")
    var k: usize = 0
    while k < dv_nvars(dc) {
        dv_put_pattern(dc, k, 97)
        derive_decl.dv_put(dc, " => { match o { ")
        dv_put_pattern(dc, k, 98)
        derive_decl.dv_put(dc, " => { return ")
        let cnt: usize = dv_var_count(dc, k)
        if cnt == 0 { derive_decl.dv_put(dc, "true") }
        var j: usize = 0
        while j < cnt {
            if j > 0 { derive_decl.dv_put(dc, " && ") }
            derive_decl.dv_put(dc, "a")
            derive_decl.dv_put_num(dc, j)
            derive_decl.dv_put(dc, " == b")
            derive_decl.dv_put_num(dc, j)
            j = j + 1
        }
        derive_decl.dv_put(dc, " } _ => { return false } } } ")
        k = k + 1
    }
    derive_decl.dv_put(dc, "} } ")
}

fn dv_e_clone(dc: *mut derive_decl.Dc) {
    var v: derive_decl.Val = derive_decl.Val { kind: 0, s: 0, e: 0 }
    derive_decl.dv_put(dc, "fn clone(*self) -> ")
    derive_emit.dv_self_type(dc)
    derive_decl.dv_put(dc, " { match *self { ")
    var k: usize = 0
    while k < dv_nvars(dc) {
        dv_put_pattern(dc, k, 97)
        derive_decl.dv_put(dc, " => { return ")
        derive_decl.dv_put_range(dc, (*dc).name_s, (*dc).name_e)
        derive_decl.dv_put(dc, "::")
        dv_put_var_name(dc, k)
        let cnt: usize = dv_var_count(dc, k)
        if cnt > 0 {
            derive_decl.dv_put(dc, "(")
            var j: usize = 0
            while j < cnt {
                if j > 0 { derive_decl.dv_put(dc, ", ") }
                dv_bind(&v, derive_decl.KIND_BIND_A, j)
                derive_emit.dv_x_clone(dc, dv_var_type_s(dc, k, j), dv_var_type_e(dc, k, j), &v)
                j = j + 1
            }
            derive_decl.dv_put(dc, ")")
        }
        derive_decl.dv_put(dc, " } ")
        k = k + 1
    }
    derive_decl.dv_put(dc, "} } ")
}

fn dv_e_hash(dc: *mut derive_decl.Dc) {
    var v: derive_decl.Val = derive_decl.Val { kind: 0, s: 0, e: 0 }
    derive_decl.dv_put(dc, "fn hash(*self) -> u64 { match *self { ")
    var k: usize = 0
    while k < dv_nvars(dc) {
        dv_put_pattern(dc, k, 97)
        derive_decl.dv_put(dc, " => { var h: u64 = derive.hash_mix(derive.hash_seed(), ")
        derive_decl.dv_put_num(dc, k)
        derive_decl.dv_put(dc, " as u64); ")
        var j: usize = 0
        while j < dv_var_count(dc, k) {
            dv_bind(&v, derive_decl.KIND_BIND_A, j)
            derive_decl.dv_put(dc, "h = derive.hash_mix(h, ")
            derive_emit.dv_x_hash(dc, dv_var_type_s(dc, k, j), dv_var_type_e(dc, k, j), &v)
            derive_decl.dv_put(dc, "); ")
            j = j + 1
        }
        derive_decl.dv_put(dc, "return h } ")
        k = k + 1
    }
    derive_decl.dv_put(dc, "} } ")
}

fn dv_e_ord_arm(dc: *mut derive_decl.Dc, k: usize) {
    var a: derive_decl.Val = derive_decl.Val { kind: 0, s: 0, e: 0 }
    var b: derive_decl.Val = derive_decl.Val { kind: 0, s: 0, e: 0 }
    dv_put_pattern(dc, k, 97)
    let cnt: usize = dv_var_count(dc, k)
    if cnt == 0 {
        derive_decl.dv_put(dc, " => { return 0 } ")
        return
    }
    derive_decl.dv_put(dc, " => { match o { ")
    dv_put_pattern(dc, k, 98)
    derive_decl.dv_put(dc, " => { ")
    var j: usize = 0
    while j < cnt {
        dv_bind(&a, derive_decl.KIND_BIND_A, j)
        dv_bind(&b, derive_decl.KIND_BIND_B, j)
        derive_emit.dv_x_cmp(dc, dv_var_type_s(dc, k, j), dv_var_type_e(dc, k, j), &a, &b)
        j = j + 1
    }
    derive_decl.dv_put(dc, "return 0 } _ => { return 0 } } } ")
}

fn dv_e_ord(dc: *mut derive_decl.Dc) {
    derive_decl.dv_put(dc, "fn derive_tag(*self) -> i64 { match *self { ")
    var k: usize = 0
    while k < dv_nvars(dc) {
        dv_put_pattern(dc, k, 97)
        derive_decl.dv_put(dc, " => { return ")
        derive_decl.dv_put_num(dc, k)
        derive_decl.dv_put(dc, " } ")
        k = k + 1
    }
    derive_decl.dv_put(dc, "} } fn cmp(*self, o: ")
    derive_emit.dv_self_type(dc)
    derive_decl.dv_put(dc, ") -> i64 { let ta = (*self).derive_tag(); let tb = o.derive_tag(); ")
    derive_decl.dv_put(dc, "if ta < tb { return 0 - 1 }; if ta > tb { return 1 }; match *self { ")
    k = 0
    while k < dv_nvars(dc) {
        dv_e_ord_arm(dc, k)
        k = k + 1
    }
    derive_decl.dv_put(dc, "} } ")
}

fn dv_enum_methods(dc: *mut derive_decl.Dc, flags: u32) {
    if (flags & derive_emit.D_DEBUG) != 0 { dv_e_debug(dc) }
    if (flags & derive_emit.D_EQ) != 0 { dv_e_eq(dc) }
    if (flags & derive_emit.D_ORD) != 0 { dv_e_ord(dc) }
    if (flags & derive_emit.D_HASH) != 0 { dv_e_hash(dc) }
    if (flags & derive_emit.D_CLONE) != 0 { dv_e_clone(dc) }
}
