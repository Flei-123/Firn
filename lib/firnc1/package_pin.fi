import rt

export { pin_same }

const NEWLINE: u8 = 10

fn is_blank(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 13 as u8
}

fn pin_path(out: *mut rt.Buf, rp: u64, rn: usize) {
    var suffix: [u8; 11] = "/.firn/pin\0"
    rt.buf_clear(out)
    rt.buf_push_bytes(out, rp, rn)
    rt.buf_push_bytes(out, (&suffix[0]) as u64, 10)
    rt.buf_push(out, 0 as u8)
}

fn first_line_trimmed(src: *mut rt.Buf, out: *mut rt.Buf) {
    let base: u64 = rt.buf_ptr(src)
    let total: usize = rt.buf_len(src)
    var end: usize = 0
    while end < total && rt.ld8(base, end) != NEWLINE {
        end = end + 1
    }
    var start: usize = 0
    while start < end && is_blank(rt.ld8(base, start)) {
        start = start + 1
    }
    while end > start && is_blank(rt.ld8(base, end - 1)) {
        end = end - 1
    }
    rt.buf_clear(out)
    rt.buf_push_bytes(out, base + (start as u64), end - start)
}

fn read_pin(rp: u64, rn: usize, out: *mut rt.Buf) -> bool {
    var path: rt.Buf = rt.buf_new()
    var src: rt.Buf = rt.buf_new()
    pin_path(&path, rp, rn)
    var found: bool = false
    if rt.read_file(rt.buf_ptr(&path), &src) {
        first_line_trimmed(&src, out)
        found = rt.buf_len(out) > 0
    }
    rt.buf_free(&src)
    rt.buf_free(&path)
    return found
}

fn pin_same(ap: u64, an: usize, bp: u64, bn: usize) -> bool {
    var x: rt.Buf = rt.buf_new()
    var y: rt.Buf = rt.buf_new()
    var same: bool = false
    if read_pin(ap, an, &x) && read_pin(bp, bn, &y) {
        if rt.buf_len(&x) == rt.buf_len(&y) {
            same = rt.mem_eq(rt.buf_ptr(&x), rt.buf_ptr(&y), rt.buf_len(&x))
        }
    }
    rt.buf_free(&x)
    rt.buf_free(&y)
    return same
}
