// SPDX-License-Identifier: MPL-2.0

import rt
import vec
import intern
import ast

export { Assoc, as_new, as_free, as_decl_add, as_decl_has, as_decl_count, as_decl_name,
    as_item_add, as_item_find, as_items_count, as_item_if, as_item_ty, as_item_name, as_item_pos,
    as_path_add, as_path_find, as_path_base, as_path_assoc, as_patch, as_cur_set, as_cur,
    as_joined }

const NONE: u32 = 4294967295
const PATCH_ROUNDS: u32 = 4

struct Assoc {
    d_if: Vec[u32],
    d_name: Vec[u32],
    a_if: Vec[u32],
    a_ty: Vec[u32],
    a_name: Vec[u32],
    a_te: Vec[u32],
    a_pos: Vec[u64],
    pt_node: Vec[u32],
    pt_name: Vec[u32],
    pt_base: Vec[u32],
    pt_assoc: Vec[u32],
    cur_ty: u32,
}

fn as_new() -> Assoc {
    return Assoc {
        d_if: vec_new[u32](), d_name: vec_new[u32](),
        a_if: vec_new[u32](), a_ty: vec_new[u32](), a_name: vec_new[u32](),
        a_te: vec_new[u32](), a_pos: vec_new[u64](),
        pt_node: vec_new[u32](), pt_name: vec_new[u32](),
        pt_base: vec_new[u32](), pt_assoc: vec_new[u32](),
        cur_ty: NONE,
    }
}

fn as_free(a: *mut Assoc) {
    vec_free[u32](&(*a).d_if)
    vec_free[u32](&(*a).d_name)
    vec_free[u32](&(*a).a_if)
    vec_free[u32](&(*a).a_ty)
    vec_free[u32](&(*a).a_name)
    vec_free[u32](&(*a).a_te)
    vec_free[u64](&(*a).a_pos)
    vec_free[u32](&(*a).pt_node)
    vec_free[u32](&(*a).pt_name)
    vec_free[u32](&(*a).pt_base)
    vec_free[u32](&(*a).pt_assoc)
}

fn as_cur_set(a: *mut Assoc, ty: u32) { (*a).cur_ty = ty }

fn as_cur(a: *mut Assoc) -> u32 { return (*a).cur_ty }

fn as_decl_has(a: *mut Assoc, iface: u32, name: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*a).d_if) {
        if vec_at[u32](&(*a).d_if, i) == iface && vec_at[u32](&(*a).d_name, i) == name {
            return true
        }
        i = i + 1
    }
    return false
}

fn as_decl_add(a: *mut Assoc, iface: u32, name: u32) -> bool {
    if as_decl_has(a, iface, name) {
        return false
    }
    vec_push[u32](&(*a).d_if, iface)
    vec_push[u32](&(*a).d_name, name)
    return true
}

fn as_decl_count(a: *mut Assoc) -> usize { return vec_len[u32](&(*a).d_if) }

fn as_decl_name(a: *mut Assoc, iface: u32, k: usize) -> u32 {
    var seen: usize = 0
    var i: usize = 0
    while i < vec_len[u32](&(*a).d_if) {
        if vec_at[u32](&(*a).d_if, i) == iface {
            if seen == k {
                return vec_at[u32](&(*a).d_name, i)
            }
            seen = seen + 1
        }
        i = i + 1
    }
    return NONE
}

fn as_item_add(a: *mut Assoc, iface: u32, ty: u32, name: u32, te: u32, pos: u64) {
    vec_push[u32](&(*a).a_if, iface)
    vec_push[u32](&(*a).a_ty, ty)
    vec_push[u32](&(*a).a_name, name)
    vec_push[u32](&(*a).a_te, te)
    vec_push[u64](&(*a).a_pos, pos)
}

fn as_items_count(a: *mut Assoc) -> usize { return vec_len[u32](&(*a).a_if) }

fn as_item_if(a: *mut Assoc, i: usize) -> u32 { return vec_at[u32](&(*a).a_if, i) }

fn as_item_ty(a: *mut Assoc, i: usize) -> u32 { return vec_at[u32](&(*a).a_ty, i) }

fn as_item_name(a: *mut Assoc, i: usize) -> u32 { return vec_at[u32](&(*a).a_name, i) }

fn as_item_pos(a: *mut Assoc, i: usize) -> u64 { return vec_at[u64](&(*a).a_pos, i) }

fn as_item_find(a: *mut Assoc, ty: u32, name: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*a).a_ty) {
        if vec_at[u32](&(*a).a_ty, i) == ty && vec_at[u32](&(*a).a_name, i) == name {
            return vec_at[u32](&(*a).a_te, i)
        }
        i = i + 1
    }
    return NONE
}

fn as_joined(a: *mut Assoc, it: *mut intern.Interner, buf: *mut rt.Buf, base: u32, name: u32) -> u32 {
    rt.buf_clear(buf)
    rt.buf_push_bytes(buf, intern.intern_ptr(it, base), intern.intern_length(it, base))
    var sep: [u8; 2] = "::"
    rt.buf_push_bytes(buf, (&sep[0]) as u64, 2)
    rt.buf_push_bytes(buf, intern.intern_ptr(it, name), intern.intern_length(it, name))
    return intern.intern_number(it, rt.buf_ptr(buf), rt.buf_len(buf)) as u32
}

fn as_path_add(a: *mut Assoc, node: u32, joined: u32, base: u32, name: u32) {
    vec_push[u32](&(*a).pt_node, node)
    vec_push[u32](&(*a).pt_name, joined)
    vec_push[u32](&(*a).pt_base, base)
    vec_push[u32](&(*a).pt_assoc, name)
}

fn as_path_find(a: *mut Assoc, joined: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*a).pt_name) {
        if vec_at[u32](&(*a).pt_name, i) == joined {
            return i as u32
        }
        i = i + 1
    }
    return NONE
}

fn as_path_base(a: *mut Assoc, i: u32) -> u32 { return vec_at[u32](&(*a).pt_base, i as usize) }

fn as_path_assoc(a: *mut Assoc, i: u32) -> u32 { return vec_at[u32](&(*a).pt_assoc, i as usize) }

fn as_patch(a: *mut Assoc, b: *mut ast.Tree) {
    var round: u32 = 0
    var changed: bool = true
    while changed && round < PATCH_ROUNDS {
        changed = false
        var i: usize = 0
        while i < vec_len[u32](&(*a).pt_node) {
            let node: u32 = vec_at[u32](&(*a).pt_node, i)
            if ast.t_kind(b, node) == ast.T_NAME && ast.t_a(b, node) == vec_at[u32](&(*a).pt_name, i) {
                let te: u32 = as_item_find(a, vec_at[u32](&(*a).pt_base, i), vec_at[u32](&(*a).pt_assoc, i))
                if te != NONE && te != node {
                    ast.ty_set(b, node, ast.t_kind(b, te), ast.t_a(b, te), ast.t_b(b, te))
                    changed = true
                }
            }
            i = i + 1
        }
        round = round + 1
    }
}
