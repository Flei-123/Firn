// SPDX-License-Identifier: MPL-2.0

import rt

export { Nearest, nearest_new, nearest_offer, nearest_say }

const NEAREST_MAX_LEN: usize = 128
const NEAREST_MIN_TOLERANCE: usize = 1
const NEAREST_MAX_TOLERANCE: usize = 3
const NEAREST_NONE: usize = 4294967295
const NEAREST_FOLD_MAX_LEN: usize = 64

struct Nearest {
    name: u64,
    name_n: usize,
    limit: usize,
    best_d: usize,
    best: u64,
    best_n: usize,
    snake: [u8; 130],
    snake_n: usize,
    alt_limit: usize,
    alt_d: usize,
    alt: u64,
    alt_n: usize,
}

fn nearest_tolerance(n: usize) -> usize {
    let t: usize = n / 3
    if t < NEAREST_MIN_TOLERANCE {
        return NEAREST_MIN_TOLERANCE
    }
    if t > NEAREST_MAX_TOLERANCE {
        return NEAREST_MAX_TOLERANCE
    }
    return t
}

fn nearest_new(name: u64, name_n: usize) -> Nearest {
    var n: Nearest = Nearest { name: name, name_n: name_n, limit: nearest_tolerance(name_n), best_d: NEAREST_NONE, best: 0, best_n: 0,
        snake: [0 as u8; 130], snake_n: 0, alt_limit: 0, alt_d: NEAREST_NONE, alt: 0, alt_n: 0 }
    nearest_fold(&n)
    return n
}

fn byte_at(p: u64, i: usize) -> u8 {
    return *((p + i as u64) as *mut u8)
}

fn nearest_fold(n: *mut Nearest) {
    if (*n).name_n == 0 || (*n).name_n > NEAREST_FOLD_MAX_LEN {
        return
    }
    let first: u8 = byte_at((*n).name, 0)
    if first < 65 || first > 90 {
        return
    }
    var i: usize = 0
    var k: usize = 0
    while i < (*n).name_n {
        let c: u8 = byte_at((*n).name, i)
        if c >= 65 && c <= 90 {
            if i > 0 {
                (*n).snake[k] = 95 as u8
                k = k + 1
            }
            (*n).snake[k] = (c + 32) as u8
        } else {
            (*n).snake[k] = c
        }
        k = k + 1
        i = i + 1
    }
    (*n).snake_n = k
    (*n).alt_limit = nearest_tolerance(k)
}

fn nearest_distance(a: u64, an: usize, b: u64, bn: usize) -> usize {
    var line: [u32; 130] = [0; 130]
    var j: usize = 0
    while j <= bn {
        line[j] = j as u32
        j = j + 1
    }
    var i: usize = 0
    while i < an {
        var before: u32 = line[0]
        line[0] = (i + 1) as u32
        j = 0
        while j < bn {
            var replace: u32 = before
            if byte_at(a, i) != byte_at(b, j) {
                replace = replace + 1
            }
            before = line[j + 1]
            var best: u32 = replace
            if line[j] + 1 < best {
                best = line[j] + 1
            }
            if before + 1 < best {
                best = before + 1
            }
            line[j + 1] = best
            j = j + 1
        }
        i = i + 1
    }
    return line[bn] as usize
}

fn bytes_less(a: u64, an: usize, b: u64, bn: usize) -> bool {
    var i: usize = 0
    while i < an && i < bn {
        let x: u8 = byte_at(a, i)
        let y: u8 = byte_at(b, i)
        if x != y {
            return x < y
        }
        i = i + 1
    }
    return an < bn
}

fn nearest_offer_direct(n: *mut Nearest, p: u64, len: usize) {
    if len == (*n).name_n && rt.mem_eq(p, (*n).name, len) {
        return
    }
    let d: usize = nearest_distance((*n).name, (*n).name_n, p, len)
    if d > (*n).limit {
        return
    }
    let better: bool = (*n).best_d == NEAREST_NONE || d < (*n).best_d || (d == (*n).best_d && bytes_less(p, len, (*n).best, (*n).best_n))
    if better {
        (*n).best_d = d
        (*n).best = p
        (*n).best_n = len
    }
}

fn nearest_offer_folded(n: *mut Nearest, p: u64, len: usize) {
    let d: usize = nearest_distance((&(*n).snake[0]) as u64, (*n).snake_n, p, len)
    if d > (*n).alt_limit {
        return
    }
    let better: bool = (*n).alt_d == NEAREST_NONE || d < (*n).alt_d || (d == (*n).alt_d && bytes_less(p, len, (*n).alt, (*n).alt_n))
    if better {
        (*n).alt_d = d
        (*n).alt = p
        (*n).alt_n = len
    }
}

fn nearest_offer(n: *mut Nearest, p: u64, len: usize) {
    if len > NEAREST_MAX_LEN || (*n).name_n > NEAREST_MAX_LEN {
        return
    }
    nearest_offer_direct(n, p, len)
    if (*n).snake_n > 0 {
        nearest_offer_folded(n, p, len)
    }
}

fn nearest_say(n: *mut Nearest, out: *mut rt.Buf) -> bool {
    var pick: u64 = (*n).best
    var pick_n: usize = (*n).best_n
    if (*n).alt_d != NEAREST_NONE && ((*n).best_d == NEAREST_NONE || (*n).alt_d < (*n).best_d) {
        pick = (*n).alt
        pick_n = (*n).alt_n
    } else if (*n).best_d == NEAREST_NONE {
        return false
    }
    var pre: [u8; 14] = "did you mean '"
    var post: [u8; 2] = "'?"
    rt.buf_push_bytes(out, (&pre[0]) as u64, 14)
    rt.buf_push_bytes(out, pick, pick_n)
    rt.buf_push_bytes(out, (&post[0]) as u64, 2)
    return true
}
