// SPDX-License-Identifier: GPL-2.0-only
// lib/firnc1/core.fi -- FREESTANDING: inline assembly, MMIO, interrupt.
//
// Port of `compiler/src/core.rs` (round 52). This module holds NO
// state: it is the shared table that the parser, the type checker, the
// lowering and the code generator need so that all four talk about the
// same register names. The `asm` block itself sits in the tree
// (`ast.fi`, `asm_add`) -- just as the `match` arms sit in pattern.fi.
//
// ALLOWED REGISTERS (core.rs, same reasoning): only the caller-saved
// set of System V -- rax rcx rdx rsi rdi r8..r11, together with their
// narrow names. A plain `call` clobbers exactly those; that way neither
// the register allocation of firnc0 nor the frame based code generator
// of this stage needs a special rule. rbx, rbp, rsp and r12-r15 carry
// the frame or are callee-saved and are rejected with a message of
// their own.

import rt
import vec
import intern

export { reg_stem, reg_locked, mmio_read_width, mmio_write_width,
    asm_number, NO_REG, NO_WIDTH, NO_NUMBER }

// "no register" / "no width" / "no asm number"
const NO_REG: u32 = 4294967295
const NO_WIDTH: u32 = 4294967295
const NO_NUMBER: u32 = 4294967295

// Compares the interned string `nr` with a byte array.
fn equal(it: *mut intern.Interner, nr: u32, p: u64, n: usize) -> bool {
    return intern.intern_equal(it, nr, p, n)
}

// 64-bit stem for allowed register names, as the interned number;
// `NO_REG` if the text is not one of them.
//
// The table holds ONE byte array with '|' as the separator: first the
// register text, then its stem. That way it stays checkable on a single
// line and does not need 36 separate array literals.
fn reg_stem(it: *mut intern.Interner, nr: u32) -> u32 {
    var tab: [u8; 275] = "rax|rax|eax|rax|ax|rax|al|rax|rcx|rcx|ecx|rcx|cx|rcx|cl|rcx|rdx|rdx|edx|rdx|dx|rdx|dl|rdx|rsi|rsi|esi|rsi|si|rsi|sil|rsi|rdi|rdi|edi|rdi|di|rdi|dil|rdi|r8|r8|r8d|r8|r8w|r8|r8b|r8|r9|r9|r9d|r9|r9w|r9|r9b|r9|r10|r10|r10d|r10|r10w|r10|r10b|r10|r11|r11|r11d|r11|r11w|r11|r11b|r11"
    let p: u64 = (&tab[0]) as u64
    var i: usize = 0
    var field: u32 = 0
    var anf: usize = 0
    var name_anf: usize = 0
    var name_len: usize = 0
    while i <= 275 {
        var end: bool = i == 275
        if !end {
            end = rt.ld8(p, i) == 124 as u8
        }
        if end {
            if field % 2 == 0 {
                name_anf = anf
                name_len = i - anf
            } else {
                if equal(it, nr, p + name_anf as u64, name_len) {
                    return intern.intern_number(it, p + anf as u64, i - anf) as u32
                }
            }
            field = field + 1
            anf = i + 1
        }
        i = i + 1
    }
    return NO_REG
}

// Registers that do exist but that the inline assembler rejects. A table
// of its own, so that the message can say WHY.
fn reg_locked(it: *mut intern.Interner, nr: u32) -> bool {
    var tab: [u8; 119] = "rbx|ebx|bx|bl|rbp|ebp|bp|bpl|rsp|esp|sp|spl|r12|r12d|r12w|r12b|r13|r13d|r13w|r13b|r14|r14d|r14w|r14b|r15|r15d|r15w|r15b"
    let p: u64 = (&tab[0]) as u64
    var i: usize = 0
    var anf: usize = 0
    while i <= 119 {
        var end: bool = i == 119
        if !end {
            end = rt.ld8(p, i) == 124 as u8
        }
        if end {
            if equal(it, nr, p + anf as u64, i - anf) {
                return true
            }
            anf = i + 1
        }
        i = i + 1
    }
    return false
}

// Width index (0 = 8 bit, 1 = 16, 2 = 32, 3 = 64) for MMIO names.
fn width_out_table(it: *mut intern.Interner, nr: u32, p: u64, n: usize) -> u32 {
    var i: usize = 0
    var anf: usize = 0
    var field: u32 = 0
    while i <= n {
        var end: bool = i == n
        if !end {
            end = rt.ld8(p, i) == 124 as u8
        }
        if end {
            if equal(it, nr, p + anf as u64, i - anf) {
                return field
            }
            field = field + 1
            anf = i + 1
        }
        i = i + 1
    }
    return NO_WIDTH
}

fn mmio_read_width(it: *mut intern.Interner, nr: u32) -> u32 {
    var tab: [u8; 54] = "__mmio_read8|__mmio_read16|__mmio_read32|__mmio_read64"
    return width_out_table(it, nr, (&tab[0]) as u64, 54)
}

fn mmio_write_width(it: *mut intern.Interner, nr: u32) -> u32 {
    var tab: [u8; 58] = "__mmio_write8|__mmio_write16|__mmio_write32|__mmio_write64"
    return width_out_table(it, nr, (&tab[0]) as u64, 58)
}

// Number behind `asm$<n>` names; `NO_NUMBER` if the text is not one.
fn asm_number(it: *mut intern.Interner, nr: u32) -> u32 {
    let n: usize = intern.intern_length(it, nr)
    if n < 5 {
        return NO_NUMBER
    }
    let p: u64 = intern.intern_ptr(it, nr)
    if rt.ld8(p, 0) != 97 as u8 {
        return NO_NUMBER
    }
    if rt.ld8(p, 1) != 115 as u8 {
        return NO_NUMBER
    }
    if rt.ld8(p, 2) != 109 as u8 {
        return NO_NUMBER
    }
    if rt.ld8(p, 3) != 36 as u8 {
        return NO_NUMBER
    }
    var value: u64 = 0
    var i: usize = 4
    while i < n {
        let z: u8 = rt.ld8(p, i)
        if z < 48 as u8 || z > 57 as u8 {
            return NO_NUMBER
        }
        value = value * 10 + ((z as u64) - 48)
        i = i + 1
    }
    return value as u32
}
