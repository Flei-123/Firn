import rt
import intern

export { canon_alias }

fn canon_alias(it: *mut intern.Interner, nr: u32) -> u32 {
    var from: [u8; 71] = "sbyte|short|int|long|byte|ushort|uint|ulong||||double|float|string|char"
    let q: u64 = intern.intern_ptr(it, nr)
    let n: usize = intern.intern_length(it, nr)
    var i: usize = 0
    var k: i32 = 0
    var start: usize = 0
    while i <= 71 {
        var end: bool = i == 71
        if !end {
            end = from[i] == 124 as u8
        }
        if end {
            if i - start == n && n > 0 {
                if rt.mem_eq((&from[start]) as u64, q, n) {
                    return canon_at(it, k)
                }
            }
            k = k + 1
            start = i + 1
        }
        i = i + 1
    }
    return nr
}

// The k-th name of the canonical table as an interner number.
fn canon_at(it: *mut intern.Interner, k: i32) -> u32 {
    var to: [u8; 62] = "i8|i16|i32|i64|u8|u16|u32|u64|usize|isize|bool|f64|f32|str|u32"
    var j: usize = 0
    var m: i32 = 0
    var start: usize = 0
    while j <= 62 {
        var end: bool = j == 62
        if !end {
            end = to[j] == 124 as u8
        }
        if end {
            if m == k {
                return intern.intern_number(it, (&to[start]) as u64, j - start) as u32
            }
            m = m + 1
            start = j + 1
        }
        j = j + 1
    }
    return 0
}
