import rt
import vec
import intern
import ast
import report
import sema

export { constfn_check }

const NOTHING: u32 = 4294967295
const U_ADDR: u32 = 2
const U_DEREF: u32 = 3
const U_INOUT: u32 = 5

const K_CALLS_NON_CONST: u32 = 1
const K_POINTER: u32 = 2
const K_FLOAT: u32 = 3

struct Cw {
    sm: u64,
    it: u64,
    who: u32,
    found: usize,
    msg: rt.Buf,
}

fn tree(w: *mut Cw) -> *mut ast.Tree { return sema.sema_tree((*w).sm as *mut sema.Sema) }

fn put_text(w: *mut Cw, s: str) {
    unsafe { rt.buf_push_bytes(&(*w).msg, s.p as u64, s.n) }
}

fn put_name(w: *mut Cw, nr: u32) {
    let it: *mut intern.Interner = (*w).it as *mut intern.Interner
    rt.buf_push_bytes(&(*w).msg, intern.intern_ptr(it, nr), intern.intern_length(it, nr))
}

fn report_at(w: *mut Cw, e: u32, kind: u32, callee: u32) {
    let b: *mut ast.Tree = tree(w)
    rt.buf_clear(&(*w).msg)
    put_text(w, "'const fn ")
    put_name(w, (*w).who)
    if kind == K_CALLS_NON_CONST {
        put_text(w, "' calls '")
        put_name(w, callee)
        put_text(w, "', which is not a 'const fn'")
    } else if kind == K_POINTER {
        put_text(w, "' must not use pointers")
    } else {
        put_text(w, "' must not use floating point yet")
    }
    var width: u32 = ast.expr_len(b, e)
    if width == 0 {
        width = 1
    }
    report.pend_add(sema.sema_pend((*w).sm as *mut sema.Sema), ast.expr_pos(b, e), width, &(*w).msg)
    (*w).found = (*w).found + 1
}

fn calls_non_const(w: *mut Cw, name: u32) -> bool {
    let b: *mut ast.Tree = tree(w)
    var i: usize = 0
    while i < ast.fn_count(b) {
        if ast.fn_name(b, i) == name && ast.fn_const(b, i) == 0 {
            return true
        }
        i = i + 1
    }
    return false
}

fn expr(w: *mut Cw, x: u32) {
    let b: *mut ast.Tree = tree(w)
    let a: u32 = ast.e_kind(b, x)
    let xa: u32 = ast.e_a(b, x)
    let xb: u32 = ast.e_b(b, x)
    let xc: u32 = ast.e_c(b, x)
    if a == ast.E_LAMBDA {
        return
    }
    if a == ast.E_CALL {
        if calls_non_const(w, xa) {
            report_at(w, x, K_CALLS_NON_CONST, xa)
        }
        var k: u32 = 0
        while k < xc {
            expr(w, ast.child_at(b, xb + k))
            k = k + 1
        }
    } else if a == ast.E_FLOAT {
        report_at(w, x, K_FLOAT, NOTHING)
    } else if a == ast.E_UN {
        if xa == U_ADDR || xa == U_INOUT || xa == U_DEREF {
            report_at(w, x, K_POINTER, NOTHING)
        }
        expr(w, xb)
    } else if a == ast.E_SYSCALL || a == ast.E_ALIT {
        var j: u32 = 0
        while j < xc {
            expr(w, ast.child_at(b, xb + j))
            j = j + 1
        }
    } else if a == ast.E_SLIT {
        var m: u32 = 0
        while m < xc {
            expr(w, ast.child_at(b, xb + m * 2 + 1))
            m = m + 1
        }
    } else if a == ast.E_IFEX {
        expr(w, xa)
        expr(w, xb)
        expr(w, xc)
    } else if a == ast.E_BIN {
        expr(w, xb)
        expr(w, xc)
    } else if a == ast.E_FIELD || a == ast.E_AS || a == ast.E_TEXT {
        expr(w, xa)
    } else if a == ast.E_IDX || a == ast.E_AWDH {
        expr(w, xa)
        expr(w, xb)
    }
}

fn block(w: *mut Cw, bi: u32) {
    let b: *mut ast.Tree = tree(w)
    var k: u32 = 0
    while k < ast.b_len(b, bi) {
        stmt(w, ast.slist_at(b, ast.b_off(b, bi) + k))
        k = k + 1
    }
}

fn stmt(w: *mut Cw, s: u32) {
    let b: *mut ast.Tree = tree(w)
    let a: u32 = ast.s_kind(b, s)
    if a == ast.S_LET || a == ast.S_VAR {
        expr(w, ast.s_c(b, s))
    } else if a == ast.S_ZUW || a == ast.S_ZUWOP {
        expr(w, ast.s_a(b, s))
        expr(w, ast.s_b(b, s))
    } else if a == ast.S_STEP || a == ast.S_EXPR {
        expr(w, ast.s_a(b, s))
    } else if a == ast.S_IF {
        expr(w, ast.s_a(b, s))
        block(w, ast.s_b(b, s))
        if ast.s_c(b, s) != NOTHING {
            stmt(w, ast.s_c(b, s))
        }
    } else if a == ast.S_WHILE {
        expr(w, ast.s_a(b, s))
        block(w, ast.s_b(b, s))
    } else if a == ast.S_FOR {
        expr(w, ast.s_b(b, s))
        expr(w, ast.s_c(b, s))
        block(w, ast.s_d(b, s))
    } else if a == ast.S_RET {
        if ast.s_a(b, s) != NOTHING {
            expr(w, ast.s_a(b, s))
        }
    } else if a == ast.S_BLOCK {
        block(w, ast.s_a(b, s))
    } else if a == ast.S_DEFER || a == ast.S_ERRDEFER {
        stmt(w, ast.s_a(b, s))
    }
}

fn constfn_check(sm: u64, it: u64) -> usize {
    var w: Cw = Cw { sm: sm, it: it, who: NOTHING, found: 0, msg: rt.buf_new() }
    let b: *mut ast.Tree = tree(&w)
    var fi: usize = 0
    while fi < ast.fn_count(b) {
        if ast.fn_const(b, fi) == 1 {
            w.who = ast.fn_name(b, fi)
            block(&w, ast.fn_body(b, fi))
        }
        fi = fi + 1
    }
    rt.buf_free(&w.msg)
    return w.found
}
