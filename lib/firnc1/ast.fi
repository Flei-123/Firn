// lib/firnc1/ast.fi — DER SYNTAXBAUM VON FIRN, IN FIRN.
//
// Dritter Teil von Stufe 1. `docs/SELBSTHOSTING.md` §2.4 sagt, wie er gebaut
// sein muss: **rekursive Baeume ueber `Vec`-Indizes statt ueber Zeiger.**
// Der Grund ist nicht Bequemlichkeit, sondern Bestandsaufnahme — ein Knoten,
// der einen anderen ueber einen Index nennt, braucht keinen Allokator je
// Knoten, keine Freigabereihenfolge und keinen Zerstoerer. Der ganze Baum wird
// mit `baum_frei` in einem Zug frei.
//
// AUFBAU: Struktur der Felder, wie im Lexer. Jede Knotenart hat feste Plaetze:
//
//   Ausdruck   e_art · e_a · e_b · e_c · e_zahl
//   Anweisung  s_art · s_a · s_b · s_c · s_d
//   Typ        t_art · t_a · t_b
//   Block      b_off · b_len  ->  Bereich in `sliste`
//
// Kinderlisten veraenderlicher Laenge (Aufrufargumente, Arrayelemente,
// Structfelder) liegen hintereinander in `kinder`; der Knoten merkt sich nur
// Versatz und Anzahl. Damit kommt der ganze Baum mit dreizehn `Vec` aus.

import rt
import vec

export { Baum, baum_neu, baum_frei,
         NICHTS,
         T_NAME, T_PTR, T_ARR,
         E_INT, E_FLOAT, E_BOOL, E_ID, E_UN, E_BIN, E_FELD, E_IDX, E_RUF,
         E_SYSCALL, E_AS, E_SLIT, E_ALIT, E_AWDH,
         S_LET, S_VAR, S_ZUW, S_IF, S_WHILE, S_RET, S_FOR, S_BREAK, S_CONT,
         S_DEFER, S_ERRDEFER, S_EXPR, S_BLOCK,
         typ_neu, ausdruck_neu, anweisung_neu, block_neu,
         kind_anfang, kind_dazu, kind_anzahl, ausdruck_anzahl,
         param_anfang, feld_anfang, sliste_anfang, sliste_dazu,
         t_art, t_a, t_b, e_art, e_a, e_b, e_c, e_zahl,
         s_art, s_a, s_b, s_c, s_d, b_off, b_len, kind_at, sliste_at,
         imp_dazu, exp_dazu, konst_dazu, struktur_dazu, fn_dazu, profil_setzen,
         imp_anzahl, imp_pfad, imp_alias, exp_anzahl, exp_name,
         konst_anzahl, konst_name, konst_typ, konst_wert,
         struktur_anzahl, struktur_name, struktur_foff, struktur_flen,
         feld_name, feld_typ, feld_dazu,
         fn_anzahl, fn_name, fn_poff, fn_plen, fn_ret, fn_rumpf,
         param_name, param_typ, param_dazu, profil,
         ct_dazu, ct_anzahl, ct_block }

// "kein Wert" — eine echte Knotennummer wird das nie.
const NICHTS: u32 = 4294967295

// Typarten
const T_NAME: u32 = 0
const T_PTR: u32 = 1
const T_ARR: u32 = 2

// Ausdrucksarten
const E_INT: u32 = 0
const E_FLOAT: u32 = 1
const E_BOOL: u32 = 2
const E_ID: u32 = 3
const E_UN: u32 = 4
const E_BIN: u32 = 5
const E_FELD: u32 = 6
const E_IDX: u32 = 7
const E_RUF: u32 = 8
const E_SYSCALL: u32 = 9
const E_AS: u32 = 10
const E_SLIT: u32 = 11
const E_ALIT: u32 = 12
const E_AWDH: u32 = 13

// Anweisungsarten
const S_LET: u32 = 0
const S_VAR: u32 = 1
const S_ZUW: u32 = 2
const S_IF: u32 = 3
const S_WHILE: u32 = 4
const S_RET: u32 = 5
const S_FOR: u32 = 6
const S_BREAK: u32 = 7
const S_CONT: u32 = 8
const S_DEFER: u32 = 9
const S_ERRDEFER: u32 = 10
const S_EXPR: u32 = 11
const S_BLOCK: u32 = 12

struct Baum {
    t_art: Vec[u32], t_a: Vec[u32], t_b: Vec[u64],
    e_art: Vec[u32], e_a: Vec[u32], e_b: Vec[u32], e_c: Vec[u32], e_zahl: Vec[u64],
    kinder: Vec[u32],
    s_art: Vec[u32], s_a: Vec[u32], s_b: Vec[u32], s_c: Vec[u32], s_d: Vec[u32],
    b_off: Vec[u32], b_len: Vec[u32], sliste: Vec[u32],
    // Deklarationen
    i_pfad: Vec[u32], i_alias: Vec[u32],
    x_name: Vec[u32],
    c_name: Vec[u32], c_typ: Vec[u32], c_wert: Vec[u32],
    st_name: Vec[u32], st_off: Vec[u32], st_len: Vec[u32],
    fd_name: Vec[u32], fd_typ: Vec[u32],
    f_name: Vec[u32], f_poff: Vec[u32], f_plen: Vec[u32], f_ret: Vec[u32], f_rumpf: Vec[u32],
    pa_name: Vec[u32], pa_typ: Vec[u32],
    prof: u32,
    // `comptime { ... }`-Bloecke der obersten Ebene: nur die Blocknummern.
    // Sie gehoeren zu keiner Funktion; der Interpreter in zeit.fi (Runde 35)
    // fuehrt sie VOR der Typpruefung aus.
    ct_block: Vec[u32],
}

fn baum_neu() -> Baum {
    return Baum{
        t_art: vec_neu[u32](), t_a: vec_neu[u32](), t_b: vec_neu[u64](),
        e_art: vec_neu[u32](), e_a: vec_neu[u32](), e_b: vec_neu[u32](),
        e_c: vec_neu[u32](), e_zahl: vec_neu[u64](),
        kinder: vec_neu[u32](),
        s_art: vec_neu[u32](), s_a: vec_neu[u32](), s_b: vec_neu[u32](),
        s_c: vec_neu[u32](), s_d: vec_neu[u32](),
        b_off: vec_neu[u32](), b_len: vec_neu[u32](), sliste: vec_neu[u32](),
        i_pfad: vec_neu[u32](), i_alias: vec_neu[u32](),
        x_name: vec_neu[u32](),
        c_name: vec_neu[u32](), c_typ: vec_neu[u32](), c_wert: vec_neu[u32](),
        st_name: vec_neu[u32](), st_off: vec_neu[u32](), st_len: vec_neu[u32](),
        fd_name: vec_neu[u32](), fd_typ: vec_neu[u32](),
        f_name: vec_neu[u32](), f_poff: vec_neu[u32](), f_plen: vec_neu[u32](),
        f_ret: vec_neu[u32](), f_rumpf: vec_neu[u32](),
        pa_name: vec_neu[u32](), pa_typ: vec_neu[u32](),
        prof: NICHTS,
        ct_block: vec_neu[u32](),
    }
}

fn baum_frei(b: *mut Baum) {
    vec_frei[u32](&(*b).t_art)
    vec_frei[u32](&(*b).t_a)
    vec_frei[u64](&(*b).t_b)
    vec_frei[u32](&(*b).e_art)
    vec_frei[u32](&(*b).e_a)
    vec_frei[u32](&(*b).e_b)
    vec_frei[u32](&(*b).e_c)
    vec_frei[u64](&(*b).e_zahl)
    vec_frei[u32](&(*b).kinder)
    vec_frei[u32](&(*b).s_art)
    vec_frei[u32](&(*b).s_a)
    vec_frei[u32](&(*b).s_b)
    vec_frei[u32](&(*b).s_c)
    vec_frei[u32](&(*b).s_d)
    vec_frei[u32](&(*b).b_off)
    vec_frei[u32](&(*b).b_len)
    vec_frei[u32](&(*b).sliste)
    vec_frei[u32](&(*b).i_pfad)
    vec_frei[u32](&(*b).i_alias)
    vec_frei[u32](&(*b).x_name)
    vec_frei[u32](&(*b).c_name)
    vec_frei[u32](&(*b).c_typ)
    vec_frei[u32](&(*b).c_wert)
    vec_frei[u32](&(*b).st_name)
    vec_frei[u32](&(*b).st_off)
    vec_frei[u32](&(*b).st_len)
    vec_frei[u32](&(*b).fd_name)
    vec_frei[u32](&(*b).fd_typ)
    vec_frei[u32](&(*b).f_name)
    vec_frei[u32](&(*b).f_poff)
    vec_frei[u32](&(*b).f_plen)
    vec_frei[u32](&(*b).f_ret)
    vec_frei[u32](&(*b).f_rumpf)
    vec_frei[u32](&(*b).pa_name)
    vec_frei[u32](&(*b).pa_typ)
    vec_frei[u32](&(*b).ct_block)
}

// ---------------------------------------------------------------- Anlegen

fn typ_neu(b: *mut Baum, art: u32, a: u32, z: u64) -> u32 {
    let i: u32 = vec_len[u32](&(*b).t_art) as u32
    vec_push[u32](&(*b).t_art, art)
    vec_push[u32](&(*b).t_a, a)
    vec_push[u64](&(*b).t_b, z)
    return i
}

fn ausdruck_neu(b: *mut Baum, art: u32, a: u32, c: u32, d: u32, z: u64) -> u32 {
    let i: u32 = vec_len[u32](&(*b).e_art) as u32
    vec_push[u32](&(*b).e_art, art)
    vec_push[u32](&(*b).e_a, a)
    vec_push[u32](&(*b).e_b, c)
    vec_push[u32](&(*b).e_c, d)
    vec_push[u64](&(*b).e_zahl, z)
    return i
}

fn anweisung_neu(b: *mut Baum, art: u32, a: u32, c: u32, d: u32, e: u32) -> u32 {
    let i: u32 = vec_len[u32](&(*b).s_art) as u32
    vec_push[u32](&(*b).s_art, art)
    vec_push[u32](&(*b).s_a, a)
    vec_push[u32](&(*b).s_b, c)
    vec_push[u32](&(*b).s_c, d)
    vec_push[u32](&(*b).s_d, e)
    return i
}

// Block aus einem bereits in `sliste` liegenden Bereich.
fn block_neu(b: *mut Baum, off: u32, laen: u32) -> u32 {
    let i: u32 = vec_len[u32](&(*b).b_off) as u32
    vec_push[u32](&(*b).b_off, off)
    vec_push[u32](&(*b).b_len, laen)
    return i
}

fn kind_anfang(b: *mut Baum) -> u32 { return vec_len[u32](&(*b).kinder) as u32 }
fn kind_dazu(b: *mut Baum, v: u32) { vec_push[u32](&(*b).kinder, v) }
fn kind_anzahl(b: *mut Baum) -> u32 { return vec_len[u32](&(*b).kinder) as u32 }
fn ausdruck_anzahl(b: *mut Baum) -> usize { return vec_len[u32](&(*b).e_art) }
fn kind_at(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).kinder, i as usize) }

// Anfang der naechsten zusammenhaengenden Liste. Gebraucht von der
// Monomorphisierung, die ganze Teilbaeume nachbaut: Kinder-, Parameter-,
// Feld- und Anweisungslisten muessen LUECKENLOS liegen, also wird erst
// gesammelt und dann am Stueck abgelegt (dieselbe Lehre wie im Parser).
fn param_anfang(b: *mut Baum) -> u32 { return vec_len[u32](&(*b).pa_name) as u32 }
fn feld_anfang(b: *mut Baum) -> u32 { return vec_len[u32](&(*b).fd_name) as u32 }
fn sliste_anfang(b: *mut Baum) -> u32 { return vec_len[u32](&(*b).sliste) as u32 }
fn sliste_dazu(b: *mut Baum, v: u32) { vec_push[u32](&(*b).sliste, v) }
fn sliste_at(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).sliste, i as usize) }

// ------------------------------------------------------------------ Lesen

fn t_art(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).t_art, i as usize) }
fn t_a(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).t_a, i as usize) }
fn t_b(b: *mut Baum, i: u32) -> u64 { return vec_at[u64](&(*b).t_b, i as usize) }
fn e_art(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).e_art, i as usize) }
fn e_a(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).e_a, i as usize) }
fn e_b(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).e_b, i as usize) }
fn e_c(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).e_c, i as usize) }
fn e_zahl(b: *mut Baum, i: u32) -> u64 { return vec_at[u64](&(*b).e_zahl, i as usize) }
fn s_art(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).s_art, i as usize) }
fn s_a(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).s_a, i as usize) }
fn s_b(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).s_b, i as usize) }
fn s_c(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).s_c, i as usize) }
fn s_d(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).s_d, i as usize) }
fn b_off(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).b_off, i as usize) }
fn b_len(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).b_len, i as usize) }

// ----------------------------------------------------------- Deklarationen

fn profil_setzen(b: *mut Baum, n: u32) { (*b).prof = n }
fn profil(b: *mut Baum) -> u32 { return (*b).prof }

fn imp_dazu(b: *mut Baum, pfad: u32, alias: u32) {
    vec_push[u32](&(*b).i_pfad, pfad)
    vec_push[u32](&(*b).i_alias, alias)
}
fn imp_anzahl(b: *mut Baum) -> usize { return vec_len[u32](&(*b).i_pfad) }
fn imp_pfad(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).i_pfad, i) }
fn imp_alias(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).i_alias, i) }

fn exp_dazu(b: *mut Baum, n: u32) { vec_push[u32](&(*b).x_name, n) }
fn exp_anzahl(b: *mut Baum) -> usize { return vec_len[u32](&(*b).x_name) }
fn exp_name(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).x_name, i) }

fn konst_dazu(b: *mut Baum, n: u32, t: u32, w: u32) {
    vec_push[u32](&(*b).c_name, n)
    vec_push[u32](&(*b).c_typ, t)
    vec_push[u32](&(*b).c_wert, w)
}
fn konst_anzahl(b: *mut Baum) -> usize { return vec_len[u32](&(*b).c_name) }
fn konst_name(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).c_name, i) }
fn konst_typ(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).c_typ, i) }
fn konst_wert(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).c_wert, i) }

fn feld_dazu(b: *mut Baum, n: u32, t: u32) -> u32 {
    let i: u32 = vec_len[u32](&(*b).fd_name) as u32
    vec_push[u32](&(*b).fd_name, n)
    vec_push[u32](&(*b).fd_typ, t)
    return i
}
fn feld_name(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).fd_name, i as usize) }
fn feld_typ(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).fd_typ, i as usize) }

fn struktur_dazu(b: *mut Baum, n: u32, off: u32, laen: u32) {
    vec_push[u32](&(*b).st_name, n)
    vec_push[u32](&(*b).st_off, off)
    vec_push[u32](&(*b).st_len, laen)
}
fn struktur_anzahl(b: *mut Baum) -> usize { return vec_len[u32](&(*b).st_name) }
fn struktur_name(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).st_name, i) }
fn struktur_foff(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).st_off, i) }
fn struktur_flen(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).st_len, i) }

fn param_dazu(b: *mut Baum, n: u32, t: u32) -> u32 {
    let i: u32 = vec_len[u32](&(*b).pa_name) as u32
    vec_push[u32](&(*b).pa_name, n)
    vec_push[u32](&(*b).pa_typ, t)
    return i
}
fn param_name(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).pa_name, i as usize) }
fn param_typ(b: *mut Baum, i: u32) -> u32 { return vec_at[u32](&(*b).pa_typ, i as usize) }

fn fn_dazu(b: *mut Baum, n: u32, poff: u32, plen: u32, ret: u32, rumpf: u32) {
    vec_push[u32](&(*b).f_name, n)
    vec_push[u32](&(*b).f_poff, poff)
    vec_push[u32](&(*b).f_plen, plen)
    vec_push[u32](&(*b).f_ret, ret)
    vec_push[u32](&(*b).f_rumpf, rumpf)
}
fn fn_anzahl(b: *mut Baum) -> usize { return vec_len[u32](&(*b).f_name) }
fn fn_name(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).f_name, i) }
fn fn_poff(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).f_poff, i) }
fn fn_plen(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).f_plen, i) }
fn fn_ret(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).f_ret, i) }
fn fn_rumpf(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).f_rumpf, i) }

// ------------------------------------------------------- `comptime`-Bloecke

fn ct_dazu(b: *mut Baum, block: u32) { vec_push[u32](&(*b).ct_block, block) }
fn ct_anzahl(b: *mut Baum) -> usize { return vec_len[u32](&(*b).ct_block) }
fn ct_block(b: *mut Baum, i: usize) -> u32 { return vec_at[u32](&(*b).ct_block, i) }
