import rt
import intern
import types

export { hint_import, hint_mismatch }

fn word_listed(list: u64, n: usize, w: u64, wn: usize) -> bool {
    var at: usize = 0
    var i: usize = 0
    while i <= n {
        if i == n || *((list + i as u64) as *mut u8) == 32 as u8 {
            if i - at == wn && rt.mem_eq(list + at as u64, w, wn) {
                return true
            }
            at = i + 1
        }
        i = i + 1
    }
    return false
}

fn is_numeric(w: u64, wn: usize) -> bool {
    var words: [u8; 49] = "i8 i16 i32 i64 u8 u16 u32 u64 usize isize f32 f64"
    return word_listed((&words[0]) as u64, 49, w, wn)
}

fn hint_import(out: *mut rt.Buf, name: u64, name_n: usize) -> bool {
    var words: [u8; 197] = "args base64 bisect bytes csv deflate deque dict dir env extract fs glob hash io itertools json log map math md5 net num option process rc rng rt setops shell stats str tar testkit text time vec xml"
    if !word_listed((&words[0]) as u64, 197, name, name_n) {
        return false
    }
    var pre: [u8; 16] = "add 'import std."
    var post: [u8; 24] = "' at the top of the file"
    rt.buf_push_bytes(out, (&pre[0]) as u64, 16)
    rt.buf_push_bytes(out, name, name_n)
    rt.buf_push_bytes(out, (&post[0]) as u64, 24)
    return true
}

fn hint_mismatch(out: *mut rt.Buf, ty: *mut types.Types, it: *mut intern.Interner, expected: u32, found: u32) -> bool {
    var want: rt.Buf = rt.buf_new()
    var have: rt.Buf = rt.buf_new()
    types.name_of(ty, it, &want, expected)
    types.name_of(ty, it, &have, found)
    let wp: u64 = rt.buf_ptr(&want)
    let hp: u64 = rt.buf_ptr(&have)
    let wn: usize = rt.buf_len(&want)
    let hn: usize = rt.buf_len(&have)
    let want_number: bool = is_numeric(wp, wn)
    let have_number: bool = is_numeric(hp, hn)
    var lit_str: [u8; 3] = "str"
    var lit_bool: [u8; 4] = "bool"
    let found_str: bool = hn == 3 && rt.mem_eq(hp, (&lit_str[0]) as u64, 3)
    let want_str: bool = wn == 3 && rt.mem_eq(wp, (&lit_str[0]) as u64, 3)
    let found_bool: bool = hn == 4 && rt.mem_eq(hp, (&lit_bool[0]) as u64, 4)
    var shown: bool = false
    if want_number && found_str {
        var h1: [u8; 67] = "a str holds text; parse it with std.num before using it as a number"
        rt.buf_push_bytes(out, (&h1[0]) as u64, 67)
        shown = true
    } else if want_str && (have_number || found_bool) {
        var h2: [u8; 51] = "format the value as text: io.fmt_string(f\"{value}\")"
        rt.buf_push_bytes(out, (&h2[0]) as u64, 51)
        shown = true
    } else if want_number && have_number {
        var h3: [u8; 41] = "convert it explicitly: write '<value> as "
        rt.buf_push_bytes(out, (&h3[0]) as u64, 41)
        rt.buf_push_bytes(out, wp, wn)
        rt.buf_push(out, 39 as u8)
        shown = true
    }
    rt.buf_free(&want)
    rt.buf_free(&have)
    return shown
}
