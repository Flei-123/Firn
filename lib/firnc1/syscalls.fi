// lib/firnc1/syscalls.fi -- THE SYSTEM CALL TABLE, IN FIRN.
//
// ROUND ARM-FREESTANDING. The Firn twin of `compiler/src/syscalls.rs`
// (round 80). A `syscall` in Firn source carries the x86-64 NUMBER:
//
//     syscall(1, 1, (&buf[0]) as u64, 3)      // write(1, buf, 3)
//
// Linux numbers its calls differently on every architecture -- on AArch64
// `write` is 64, and 1 is `io_destroy`. So the number in the tree is read as
// the CANONICAL NAME of the call ("the one that is 1 on x86-64") and this
// file is the one place that translates it.
//
// WHY IT IS HERE ALREADY, THOUGH `firnc1` CANNOT GENERATE A64 YET. Because
// it is the half of the job that can be CHECKED today: this table and the
// Rust one have to agree entry for entry, and
// `tools/aarch64/syscall_table.sh` compares them by running BOTH -- the
// Rust compiler's table through its own module test, this one through
// `bin/sysdump.fi`, built by firnc0 AND by firnc1. A table that drifts
// apart from its twin is caught the day it drifts, not the day somebody
// finally writes `codegen_a64.fi` and wonders why the kernel hangs.
//
// What is NOT here, said plainly: the A64 code generator. Without it this
// module has no caller inside `firnc1` -- it is a checked, ready piece of a
// round that has not been written (docs/ROUND-ARM-FREESTANDING.md, section
// on firnc1).

// The SHAPE of the translation -- the Firn spelling of `enum A64` in
// `compiler/src/syscalls.rs`.
// K_NONE      the table does not know this number
// K_DIRECT    same arguments, another number
// K_ATFDCWD   AT_FDCWD in front of the arguments, then this number
//             (the generic table has no `open`, only `openat`)
// K_FORKCLONE fork() -> clone(SIGCHLD, 0, 0, 0, 0)
// K_DUP3      dup2(a, b) -> dup3(a, b, 0)
// K_SETTP     arch_prctl(ARCH_SET_FS, p) -> msr tpidr_el0, p; not a system
//             call at all on this machine
// K_MISSING   no equivalent that a number and an argument shift can bridge
const K_NONE: u32 = 0
const K_DIRECT: u32 = 1
const K_ATFDCWD: u32 = 2
const K_FORKCLONE: u32 = 3
const K_DUP3: u32 = 4
const K_SETTP: u32 = 5
const K_MISSING: u32 = 6

// `AT_FDCWD` -- "relative to the working directory", the value that turns
// `openat` back into `open`. It is -100, and it is written as the unsigned
// pattern here because a stage-0 `const` of this shape is what the rest of
// this compiler uses.
const AT_FDCWD: i64 = -100
// `SIGCHLD` -- the flag word that turns `clone` into `fork`.
const SIGCHLD: i64 = 17
// `ARCH_SET_FS`, the only `arch_prctl` request that is translated (0x1002).
const ARCH_SET_FS: i64 = 4098

// The AArch64 form of the canonical (x86-64) system call number `n`.
// Writes the shape into `*shape` and returns the aarch64 number, or -1 when
// there is none (K_NONE, K_SETTP, K_MISSING).
//
// Sorted by the left column, exactly like the Rust table, so that the two
// can be read side by side.
fn aarch64(n: i64, shape: *mut u32) -> i64 {
    if n == 0 { *shape = K_DIRECT
        return 63 }  // read
    if n == 1 { *shape = K_DIRECT
        return 64 }  // write
    if n == 2 { *shape = K_ATFDCWD
        return 56 }  // open      -> openat
    if n == 3 { *shape = K_DIRECT
        return 57 }  // close
    if n == 5 { *shape = K_DIRECT
        return 80 }  // fstat
    if n == 8 { *shape = K_DIRECT
        return 62 }  // lseek
    if n == 9 { *shape = K_DIRECT
        return 222 }  // mmap
    if n == 10 { *shape = K_DIRECT
        return 226 }  // mprotect
    if n == 11 { *shape = K_DIRECT
        return 215 }  // munmap
    if n == 12 { *shape = K_DIRECT
        return 214 }  // brk
    if n == 13 { *shape = K_DIRECT
        return 134 }  // rt_sigaction
    if n == 14 { *shape = K_DIRECT
        return 135 }  // rt_sigprocmask
    if n == 16 { *shape = K_DIRECT
        return 29 }  // ioctl
    if n == 17 { *shape = K_DIRECT
        return 67 }  // pread64
    if n == 18 { *shape = K_DIRECT
        return 68 }  // pwrite64
    if n == 19 { *shape = K_DIRECT
        return 65 }  // readv
    if n == 20 { *shape = K_DIRECT
        return 66 }  // writev
    if n == 24 { *shape = K_DIRECT
        return 124 }  // sched_yield
    if n == 28 { *shape = K_DIRECT
        return 233 }  // madvise
    if n == 32 { *shape = K_DIRECT
        return 23 }  // dup
    if n == 33 { *shape = K_DUP3
        return 24 }  // dup2      -> dup3
    if n == 35 { *shape = K_DIRECT
        return 101 }  // nanosleep
    if n == 39 { *shape = K_DIRECT
        return 172 }  // getpid
    if n == 41 { *shape = K_DIRECT
        return 198 }  // socket
    if n == 42 { *shape = K_DIRECT
        return 203 }  // connect
    if n == 43 { *shape = K_DIRECT
        return 202 }  // accept
    if n == 44 { *shape = K_DIRECT
        return 206 }  // sendto
    if n == 45 { *shape = K_DIRECT
        return 207 }  // recvfrom
    if n == 46 { *shape = K_DIRECT
        return 211 }  // sendmsg
    if n == 47 { *shape = K_DIRECT
        return 212 }  // recvmsg
    if n == 48 { *shape = K_DIRECT
        return 210 }  // shutdown
    if n == 49 { *shape = K_DIRECT
        return 200 }  // bind
    if n == 50 { *shape = K_DIRECT
        return 201 }  // listen
    if n == 51 { *shape = K_DIRECT
        return 204 }  // getsockname
    if n == 52 { *shape = K_DIRECT
        return 205 }  // getpeername
    if n == 53 { *shape = K_DIRECT
        return 199 }  // socketpair
    if n == 54 { *shape = K_DIRECT
        return 208 }  // setsockopt
    if n == 55 { *shape = K_DIRECT
        return 209 }  // getsockopt
    if n == 56 { *shape = K_MISSING
        return -1 }
    if n == 57 { *shape = K_FORKCLONE
        return 220 }  // fork      -> clone(SIGCHLD)
    if n == 59 { *shape = K_DIRECT
        return 221 }  // execve
    if n == 60 { *shape = K_DIRECT
        return 93 }  // exit
    if n == 61 { *shape = K_DIRECT
        return 260 }  // wait4
    if n == 62 { *shape = K_DIRECT
        return 129 }  // kill
    if n == 63 { *shape = K_DIRECT
        return 160 }  // uname
    if n == 79 { *shape = K_DIRECT
        return 17 }  // getcwd
    if n == 96 { *shape = K_DIRECT
        return 169 }  // gettimeofday
    if n == 102 { *shape = K_DIRECT
        return 174 }  // getuid
    if n == 107 { *shape = K_DIRECT
        return 175 }  // geteuid
    if n == 158 { *shape = K_SETTP
        return -1 }  // arch_prctl(ARCH_SET_FS) -> msr tpidr_el0
    if n == 186 { *shape = K_DIRECT
        return 178 }  // gettid
    if n == 200 { *shape = K_DIRECT
        return 131 }  // tgkill
    if n == 202 { *shape = K_DIRECT
        return 98 }  // futex
    if n == 217 { *shape = K_DIRECT
        return 61 }  // getdents64
    if n == 228 { *shape = K_DIRECT
        return 113 }  // clock_gettime
    if n == 231 { *shape = K_DIRECT
        return 94 }  // exit_group
    if n == 257 { *shape = K_DIRECT
        return 56 }  // openat
    if n == 262 { *shape = K_DIRECT
        return 79 }  // newfstatat
    if n == 288 { *shape = K_DIRECT
        return 242 }  // accept4
    if n == 318 { *shape = K_DIRECT
        return 278 }  // getrandom
    *shape = K_NONE
    return -1
}

// How many entries the table has. Kept as a separate answer so the
// comparison tool can check that neither side has quietly grown one.
fn count() -> u32 {
    var c: u32 = 0
    var n: i64 = 0
    var sh: u32 = 0
    while n < 400 {
        if aarch64(n, &sh) != -1 { c = c + 1 }
        else {
            if sh != K_NONE { c = c + 1 }
        }
        n = n + 1
    }
    return c
}
