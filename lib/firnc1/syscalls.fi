fn count() -> u32 {
    var c: u32 = 0
    var n: i64 = 0
    var sh: u32 = 0
    while n < 400 {
        if aarch64(n, &sh) != -1 { c = c + 1 }
        else {
            if sh != K_NONE { c = c + 1 }
        }
        n = n + 1
    }
    return c
}
