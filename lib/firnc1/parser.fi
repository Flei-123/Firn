// lib/firnc1/parser.fi — DER PARSER VON FIRN, IN FIRN.
//
// Rekursiver Abstieg, kein Generator — genau wie `compiler/src/parser.rs`.
// Gebaut wird in `ast.Baum`: Knoten ueber `Vec`-Indizes statt ueber Zeiger
// (docs/SELBSTHOSTING.md §2.4).
//
// UMFANG: die KERNSPRACHE. Was seinen Baum ausserhalb von `Program` haelt —
// `enum`/`match`, Fehlerunionen, generische Vorlagen, `gc class`, Attribute,
// `comptime` — ist NICHT dabei. Diese Dateien werden im Vergleich gezaehlt und
// uebersprungen, nicht stillschweigend uebergangen.
//
// EBENFALLS NICHT DABEI: die Fehlerwiederherstellung. `firnc0` sammelt bis zu
// vierzig Meldungen und liest weiter; dieser Parser meldet die erste und hoert
// auf. Das ist ehrlich weniger — und fuer den Vergleich ohne Belang, weil er
// nur ueber Quellen laeuft, die `firnc0` fehlerfrei liest.
//
// EINE REGEL, DIE MAN LEICHT UEBERSIEHT: ein Operator am ZEILENANFANG setzt
// den Ausdruck NICHT fort, solange keine Klammer offen ist (`weiter()`).
// Deshalb ist
//     a
//     - b
// zwei Anweisungen und nicht eine Subtraktion.

import rt
import vec
import intern
import lexer
import ast
import mono
import muster
import fehler
import gc

export { Parser, par_neu, par_neu_modul, par_frei, par_lauf, par_fehler, par_baum,
         par_nicht_kern, par_baum_uebernehmen, par_gen_setzen, par_mu_setzen,
         par_fe_setzen, par_zeit_setzen, par_gc_setzen }

// Token-Arten aus lexer.fi (dieselbe Reihenfolge wie compiler/src/lexer.rs)
// "kein Wert"
const KEIN: u32 = 4294967295

const A_INT: u32 = 0
const A_IDENT: u32 = 1
const A_FLOAT: u32 = 2
const A_STR: u32 = 3
const A_KWFN: u32 = 4
const A_KWLET: u32 = 5
const A_KWVAR: u32 = 6
const A_KWIF: u32 = 7
const A_KWELSE: u32 = 8
const A_KWWHILE: u32 = 9
const A_KWRETURN: u32 = 10
const A_KWSTRUCT: u32 = 11
const A_KWCONST: u32 = 12
const A_KWPROFILE: u32 = 13
const A_KWAS: u32 = 14
const A_KWMUT: u32 = 15
const A_KWTRUE: u32 = 16
const A_KWFALSE: u32 = 17
const A_KWSYSCALL: u32 = 18
const A_KWEXTERN: u32 = 19
const A_KWBREAK: u32 = 20
const A_KWCONTINUE: u32 = 21
const A_KWDEFER: u32 = 22
const A_KWERRDEFER: u32 = 23
const A_KWCOMPTIME: u32 = 24
const A_KWFOR: u32 = 25
const A_KWIN: u32 = 26
const A_KWIMPORT: u32 = 27
const A_KWEXPORT: u32 = 28
const A_KWENUM: u32 = 29
const A_KWMATCH: u32 = 30
const A_KWERROR: u32 = 31
const A_KWTRY: u32 = 32
const A_KWCATCH: u32 = 33
const A_LPAREN: u32 = 34
const A_RPAREN: u32 = 35
const A_LBRACE: u32 = 36
const A_RBRACE: u32 = 37
const A_LBRACKET: u32 = 38
const A_RBRACKET: u32 = 39
const A_COMMA: u32 = 40
const A_COLON: u32 = 41
const A_SEMI: u32 = 42
const A_DOT: u32 = 43
const A_DOTDOT: u32 = 44
const A_ARROW: u32 = 45
const A_ASSIGN: u32 = 46
const A_PLUS: u32 = 47
const A_MINUS: u32 = 48
const A_STAR: u32 = 49
const A_SLASH: u32 = 50
const A_PERCENT: u32 = 51
const A_AMP: u32 = 52
const A_PIPE: u32 = 53
const A_CARET: u32 = 54
const A_SHL: u32 = 55
const A_SHR: u32 = 56
const A_ANDAND: u32 = 57
const A_OROR: u32 = 58
const A_NOT: u32 = 59
const A_QUESTION: u32 = 60
const A_HASH: u32 = 61
const A_EQEQ: u32 = 62
const A_NOTEQ: u32 = 63
const A_LT: u32 = 64
const A_LE: u32 = 65
const A_GT: u32 = 66
const A_GE: u32 = 67
const A_EOF: u32 = 68

// Binaeroperatoren — dieselbe Reihenfolge wie `ast::BinOp`.
const B_ADD: u32 = 0
const B_SUB: u32 = 1
const B_MUL: u32 = 2
const B_DIV: u32 = 3
const B_REM: u32 = 4
const B_AND: u32 = 5
const B_OR: u32 = 6
const B_XOR: u32 = 7
const B_SHL: u32 = 8
const B_SHR: u32 = 9
const B_EQ: u32 = 10
const B_NE: u32 = 11
const B_LT: u32 = 12
const B_LE: u32 = 13
const B_GT: u32 = 14
const B_GE: u32 = 15
const B_LAND: u32 = 16
const B_LOR: u32 = 17

// Unaeroperatoren
const U_NEG: u32 = 0
const U_NOT: u32 = 1
const U_ADDR: u32 = 2
const U_DEREF: u32 = 3

struct Parser {
    lx: u64,             // Zeiger auf den Lexer
    pos: usize,
    n: usize,
    baum: ast.Baum,
    // MODULSYSTEM. Ist `alias` gesetzt, gehoert diese Datei nicht zur Wurzel:
    // jeder Name, den sie SELBST oben deklariert, bekommt `alias__` davor.
    // Damit liegen alle Dateien in EINEM Baum, ohne dass sich zwei Funktionen
    // gleichen Namens in die Quere kommen. `firnc0` macht dasselbe in
    // `modules.rs`, nur nach dem Parsen statt waehrend.
    alias: u32,
    eigene: Vec[u32],    // oben deklarierte Namen dieser Datei
    fremd: u64,          // gemeinsamer Baum (0 = eigener)
    module: Vec[u32],    // Namensnummern der Modul-Aliasse (fuer `modul.name`)
    kladde: rt.Buf,      // baut qualifizierte Namen zusammen
    klammern: usize,     // offene Klammern (fuer `weiter()`)
    kein_slit: usize,    // > 0: kein Struct-Literal auf oberster Ebene
    fehler: usize,
    nicht_kern: bool,    // Datei benutzt eine nicht portierte Erweiterung
    // GENERISCHE VORLAGEN. Die Ablage liegt AUSSERHALB des Parsers, weil sie
    // ueber alle Dateien einer Uebersetzung hinweg dieselbe sein muss: eine
    // Wurzeldatei benutzt `Vec[i32]`, deklariert ist `Vec[T]` in einem Modul.
    // 0 = kein Register, dann sind Generics eine nicht portierte Erweiterung.
    gen: u64,
    // Register der Aufzaehlungen und Musterabgleiche (Runde 32). Dieselbe
    // Bauart wie `gen`: die Ablage liegt ausserhalb des Parsers, weil sie
    // ueber alle Dateien einer Uebersetzung hinweg dieselbe sein muss.
    // 0 = kein Register, dann sind `enum`/`match` nicht portiert.
    mu: u64,
    // Registrierung der Fehlermengen/-unionen (Runde 33). Dieselbe Bauart
    // wie `mu`: eine Ablage fuer alle Dateien der Uebersetzung.
    // 0 = kein Register, dann sind `error`/`try`/`catch` nicht portiert.
    feh: u64,
    // RUNDE 35: `comptime { ... }` ist angemeldet. Kein Register ausserhalb
    // des Baums noetig — die Bloecke liegen als Blocknummern im Baum selbst
    // (`ast.ct_block`); der Interpreter steht in zeit.fi. Nur das FLAG gehoert
    // hierher, weil `erweiterungen_suchen` vor dem Parsen wissen muss, ob das
    // Schluesselwort Kernsprache ist (derselbe Uebergang wie Runde 31-33).
    zeit: bool,
    // RUNDE 34: Registrierung der gc-Klassen (`gc.fi`). Dieselbe Bauart wie
    // `mu`/`feh`: eine Ablage fuer alle Dateien der Uebersetzung, weil
    // Klassennamen programmweit gelten. 0 = kein Register, dann sind
    // `gc class`, `Gc[T]`, `x.as?[C]` und `#[no_gc]` nicht portiert.
    gcr: u64,
    // Das Attribut `#[no_gc]` vor der naechsten Funktionsdeklaration.
    nogc_anstehend: u32,
    tpoff: u32,          // Anfang der laufenden Typparameterliste
    // Namensnummer von `size_of`, oder -1. `size_of` ist KEIN Schluesselwort
    // (sizeof.rs) — es laesst sich nur am Namen erkennen.
    sonr: i64,
    // LOKALE NAMEN, als Stapel von Bereichen. Ein Parameter oder eine lokale
    // Variable VERDECKT einen gleichnamigen Namen derselben Datei.
    lokal: Vec[u32],
    lgrenze: Vec[u32],
}

fn par_neu(lx: u64) -> Parser {
    var p: Parser = Parser{
        lx: lx, pos: 0, n: 0,
        baum: ast.baum_neu(),
        alias: KEIN, eigene: vec_neu[u32](), fremd: 0,
        module: vec_neu[u32](),
        kladde: rt.buf_neu(),
        klammern: 0, kein_slit: 0, fehler: 0, nicht_kern: false,
        gen: 0, mu: 0, feh: 0, zeit: false, gcr: 0, nogc_anstehend: 0, tpoff: 0, sonr: -1,
        lokal: vec_neu[u32](), lgrenze: vec_neu[u32](),
    }
    p.n = lexer.lex_anzahl(lx as *mut lexer.Lexer)
    return p
}

// Wie `par_neu`, aber in einen GEMEINSAMEN Baum und mit Modul-Alias.
// `alias == KEIN` heisst Wurzeldatei (keine Umbenennung).
fn par_neu_modul(lx: u64, baum: u64, alias: u32) -> Parser {
    var p: Parser = par_neu(lx)
    p.fremd = baum
    p.alias = alias
    return p
}

// Register der generischen Vorlagen anmelden. MUSS vor `par_lauf` stehen.
fn par_gen_setzen(p: *mut Parser, g: u64) { (*p).gen = g }

// Register der Aufzaehlungen/Musterabgleiche anmelden. Ebenfalls VOR `par_lauf`.
fn par_mu_setzen(p: *mut Parser, m: u64) { (*p).mu = m }

// Registrierung der Fehlerunionen anmelden. Ebenfalls VOR `par_lauf`.
fn par_fe_setzen(p: *mut Parser, f: u64) { (*p).feh = f }

fn gn(p: *mut Parser) -> *mut mono.Gen { return (*p).gen as *mut mono.Gen }
fn hat_gen(p: *mut Parser) -> bool { return (*p).gen != 0 }
fn mn(p: *mut Parser) -> *mut muster.Mus { return (*p).mu as *mut muster.Mus }
fn hat_mu(p: *mut Parser) -> bool { return (*p).mu != 0 }
fn fh(p: *mut Parser) -> *mut fehler.Fehler { return (*p).feh as *mut fehler.Fehler }
fn hat_fe(p: *mut Parser) -> bool { return (*p).feh != 0 }

// RUNDE 35: `comptime`-Bloecke anmelden.
fn par_zeit_setzen(p: *mut Parser) { (*p).zeit = true }
fn hat_zeit(p: *mut Parser) -> bool { return (*p).zeit }

// RUNDE 34: die gc-Registrierung anmelden. Ebenfalls VOR `par_lauf`.
fn par_gc_setzen(p: *mut Parser, g: u64) { (*p).gcr = g }
fn gr(p: *mut Parser) -> *mut gc.Gc { return (*p).gcr as *mut gc.Gc }
fn hat_gc(p: *mut Parser) -> bool { return (*p).gcr != 0 }

fn par_baum_uebernehmen(p: *mut Parser) -> *mut ast.Baum {
    return par_baum(p)
}

fn par_frei(p: *mut Parser) {
    // Ein GEMEINSAMER Baum gehoert dem Aufrufer.
    if (*p).fremd == 0 {
        ast.baum_frei(&(*p).baum)
    }
    vec_frei[u32](&(*p).module)
    vec_frei[u32](&(*p).eigene)
    rt.buf_frei(&(*p).kladde)
    vec_frei[u32](&(*p).lokal)
    vec_frei[u32](&(*p).lgrenze)
}

fn par_fehler(p: *mut Parser) -> usize { return (*p).fehler }
fn par_baum(p: *mut Parser) -> *mut ast.Baum {
    if (*p).fremd != 0 {
        return (*p).fremd as *mut ast.Baum
    }
    return &(*p).baum
}
fn par_nicht_kern(p: *mut Parser) -> bool { return (*p).nicht_kern }

fn lx(p: *mut Parser) -> *mut lexer.Lexer { return (*p).lx as *mut lexer.Lexer }

// ------------------------------------------------------------- Tokenzugriff

fn art(p: *mut Parser, k: usize) -> u32 {
    if (*p).pos + k >= (*p).n {
        return A_EOF
    }
    return lexer.lex_art(lx(p), (*p).pos + k)
}

fn nummer(p: *mut Parser, k: usize) -> u32 {
    if (*p).pos + k >= (*p).n {
        return 0
    }
    return lexer.lex_nr(lx(p), (*p).pos + k)
}

fn zahl(p: *mut Parser) -> u64 {
    if (*p).pos >= (*p).n {
        return 0
    }
    return lexer.lex_zahl(lx(p), (*p).pos)
}

fn zeile(p: *mut Parser, i: usize) -> u32 {
    if i >= (*p).n {
        return 0
    }
    return lexer.lex_zeile(lx(p), i)
}

fn am_ende(p: *mut Parser) -> bool { return art(p, 0) == A_EOF }

fn ist(p: *mut Parser, a: u32) -> bool { return art(p, 0) == a }

fn weiter_bump(p: *mut Parser) {
    if (*p).pos < (*p).n {
        (*p).pos = (*p).pos + 1
    }
}

fn friss(p: *mut Parser, a: u32) -> bool {
    if ist(p, a) {
        weiter_bump(p)
        return true
    }
    return false
}

// Steht das aktuelle Token am ZEILENANFANG?
fn zeilenanfang(p: *mut Parser) -> bool {
    if (*p).pos == 0 {
        return true
    }
    if (*p).pos >= (*p).n {
        return true
    }
    return zeile(p, (*p).pos) > zeile(p, (*p).pos - 1)
}

// Darf der Ausdruck mit dem aktuellen Token fortgesetzt werden?
fn weiter(p: *mut Parser) -> bool {
    return (*p).klammern > 0 || !zeilenanfang(p)
}

fn meckern(p: *mut Parser) {
    (*p).fehler = (*p).fehler + 1
}

fn erwarte(p: *mut Parser, a: u32) -> bool {
    if friss(p, a) {
        return true
    }
    meckern(p)
    return false
}

// -------------------------------------------------------------------- Namen

// Setzt zwei Namen mit einem Trenner zusammen und traegt das Ergebnis ein.
fn verbinde(p: *mut Parser, a: u32, trenner: u64, tn: usize, b: u32) -> u32 {
    let it: *mut intern.Interner = lexer.lex_namen(lx(p))
    rt.buf_leeren(&(*p).kladde)
    rt.buf_push_bytes(&(*p).kladde, intern.intern_zeiger(it, a), intern.intern_laenge(it, a))
    rt.buf_push_bytes(&(*p).kladde, trenner, tn)
    rt.buf_push_bytes(&(*p).kladde, intern.intern_zeiger(it, b), intern.intern_laenge(it, b))
    return intern.intern_nummer(it, rt.buf_ptr(&(*p).kladde), rt.buf_len(&(*p).kladde)) as u32
}

// Ist `nr` ein Name, den DIESE Datei oben deklariert?
fn ist_eigen(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).eigene) {
        if vec_at[u32](&(*p).eigene, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

// Umbenennung eines Namens dieser Datei: `alias__name`. In der Wurzeldatei
// bleibt alles, wie es ist.
// ------------------------------------------------------------ Lokale Namen
//
// `fn par_neu(lx: u64)` in einer Datei, die auch `fn lx(..)` hat: `lx` im
// Rumpf ist der PARAMETER. Ohne diese Liste bekam er beim Umbenennen
// `parser__` davor und war weg — gefunden erst beim Selbstuebersetzen in
// Runde 31, weil vorher kein Modul einen Parameter so nannte wie eine seiner
// eigenen Funktionen. `modules.rs::Renamer` haelt dieselbe Liste.
//
// NUR WERTE werden verdeckt. Ein Aufruf `lx(p)` meint weiterhin die
// Funktion (`Renamer::resolve` mit `is_value = false`), und ein TYPNAME
// ohnehin.
fn lok_auf(p: *mut Parser) {
    vec_push[u32](&(*p).lgrenze, vec_len[u32](&(*p).lokal) as u32)
}

fn lok_zu(p: *mut Parser) {
    if vec_len[u32](&(*p).lgrenze) == 0 {
        return
    }
    let g: u32 = vec_pop[u32](&(*p).lgrenze)
    while vec_len[u32](&(*p).lokal) > g as usize {
        vec_pop[u32](&(*p).lokal)
    }
}

fn lok_dazu(p: *mut Parser, nr: u32) { vec_push[u32](&(*p).lokal, nr) }

fn ist_lokal(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).lokal) {
        if vec_at[u32](&(*p).lokal, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

fn umbenannt(p: *mut Parser, nr: u32) -> u32 {
    if (*p).alias == KEIN {
        return nr
    }
    if !ist_eigen(p, nr) {
        return nr
    }
    var tr: [u8; 2] = "__"
    return verbinde(p, (*p).alias, (&tr[0]) as u64, 2, nr)
}

// Baut `modul.name` und traegt es in den Interner ein.
// `modul.name` wird zum EINEN Namen `modul.name` (Wurzelbetrieb, damit der
// Vergleich mit `firnc0 --emit=ast-kanon` stimmt) bzw. zu `modul__name`,
// sobald wirklich mehrere Dateien uebersetzt werden. Beides ist derselbe
// Gedanke: aus zwei Teilen wird ein eindeutiger Name.
fn qualifiziere(p: *mut Parser, modul: u32, name: u32) -> u32 {
    if (*p).fremd != 0 {
        var tr: [u8; 2] = "__"
        return verbinde(p, modul, (&tr[0]) as u64, 2, name)
    }
    var pt: [u8; 1] = "."
    return verbinde(p, modul, (&pt[0]) as u64, 1, name)
}

fn ist_modul(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).module) {
        if vec_at[u32](&(*p).module, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

// `name` steht schon; wenn es ein Modulname mit `.` dahinter ist, wird
// `modul.mitglied` daraus.
fn umbenannt_wert(p: *mut Parser, nr: u32, wert: bool) -> u32 {
    if wert {
        if ist_lokal(p, nr) {
            return nr
        }
    }
    return umbenannt(p, nr)
}

fn vielleicht_qualifiziert(p: *mut Parser, nr: u32, wert: bool) -> u32 {
    if !ist_modul(p, nr) {
        return umbenannt_wert(p, nr, wert)
    }
    if !ist(p, A_DOT) {
        return umbenannt_wert(p, nr, wert)
    }
    if art(p, 1) != A_IDENT {
        return umbenannt_wert(p, nr, wert)
    }
    let m: u32 = nummer(p, 1)
    weiter_bump(p)
    weiter_bump(p)
    return qualifiziere(p, nr, m)
}

// ---------------------------------------------------------- Generisches
//
// `[T, U: Int]` an der DEKLARATION, `[i32, u8]` an der VERWENDUNG. Eckige
// Klammern statt spitzer, damit `<` eindeutig Vergleich bleibt (SPEC §12).

// Typparameterliste einer Vorlage. Die Parameter landen im Register, hier
// steht nur, ob es geklappt hat.
fn typparameterliste(p: *mut Parser) -> bool {
    if !erwarte(p, A_LBRACKET) {
        return false
    }
    let off: u32 = mono.gen_tp_anfang(gn(p))
    (*p).tpoff = off
    while true {
        if ist(p, A_RBRACKET) || am_ende(p) {
            break
        }
        let vor: usize = (*p).pos
        if !ist(p, A_IDENT) {
            meckern(p)
            return false
        }
        let name: u32 = nummer(p, 0)
        weiter_bump(p)
        var schranke: u32 = 0
        if friss(p, A_COLON) {
            if !ist(p, A_IDENT) {
                meckern(p)
                return false
            }
            let s: u32 = mono.gen_schranke(gn(p), nummer(p, 0))
            if s == KEIN {
                meckern(p)
                return false
            }
            schranke = s
            weiter_bump(p)
        }
        if mono.gen_tp_doppelt(gn(p), off, name) {
            meckern(p)
            return false
        }
        mono.gen_tp_dazu(gn(p), name, schranke)
        if !friss(p, A_COMMA) {
            break
        }
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    if !erwarte(p, A_RBRACKET) {
        return false
    }
    if mono.gen_tp_anfang(gn(p)) == off {
        meckern(p)
        return false
    }
    return true
}

// Typargumente an einer Verwendungsstelle: `[i32, *mut u8]`.
fn typargumente(p: *mut Parser, aus: *mut Vec[u32]) -> bool {
    if !erwarte(p, A_LBRACKET) {
        return false
    }
    while true {
        if ist(p, A_RBRACKET) || am_ende(p) {
            break
        }
        let vor: usize = (*p).pos
        let t: u32 = typ(p)
        if t == ast.NICHTS {
            return false
        }
        vec_push[u32](aus, t)
        if !friss(p, A_COMMA) {
            break
        }
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    if !erwarte(p, A_RBRACKET) {
        return false
    }
    if vec_len[u32](aus) == 0 {
        meckern(p)
        return false
    }
    return true
}

// -------------------------------------------------------------------- Typen

fn typ(p: *mut Parser) -> u32 {
    if ist(p, A_STAR) {
        weiter_bump(p)
        var m: u64 = 0
        if friss(p, A_KWMUT) {
            m = 1
        }
        let inner: u32 = typ(p)
        if inner == ast.NICHTS {
            return ast.NICHTS
        }
        return ast.typ_neu(par_baum(p), ast.T_PTR, inner, m)
    }
    if ist(p, A_LBRACKET) {
        weiter_bump(p)
        let elem: u32 = typ(p)
        if elem == ast.NICHTS {
            return ast.NICHTS
        }
        if !erwarte(p, A_SEMI) {
            return ast.NICHTS
        }
        if !ist(p, A_INT) {
            meckern(p)
            return ast.NICHTS
        }
        let laen: u64 = zahl(p)
        weiter_bump(p)
        if !erwarte(p, A_RBRACKET) {
            return ast.NICHTS
        }
        return ast.typ_neu(par_baum(p), ast.T_ARR, elem, laen)
    }
    if ist(p, A_IDENT) {
        let nr: u32 = nummer(p, 0)
        weiter_bump(p)
        // RUNDE 34 (gc.rs::hook_type): `Gc[C]` und `GcWeak[C]`. Der Name
        // steht als Platzhalter `__gc#p:C` / `__gc#w:C` im Baum; aufgeloest
        // wird er erst in der Typaufloesung. Klassennamen gelten
        // programmweit — KEINE Modul-Umbenennung.
        if hat_gc(p) && ist(p, A_LBRACKET) {
            var art_nr: u32 = 0
            var g1: [u8; 2] = "Gc"
            var g2: [u8; 6] = "GcWeak"
            let it2: *mut intern.Interner = lexer.lex_namen(lx(p))
            if intern.intern_gleich(it2, nr, (&g1[0]) as u64, 2) {
                art_nr = 1
            }
            if intern.intern_gleich(it2, nr, (&g2[0]) as u64, 6) {
                art_nr = 2
            }
            if art_nr != 0 {
                weiter_bump(p)
                if !ist(p, A_IDENT) {
                    meckern(p)
                    return ast.NICHTS
                }
                let kn: u32 = nummer(p, 0)
                weiter_bump(p)
                if !erwarte(p, A_RBRACKET) {
                    return ast.NICHTS
                }
                rt.buf_leeren(&(*p).kladde)
                if art_nr == 1 {
                    var px1: [u8; 7] = "__gc#p:"
                    rt.buf_push_bytes(&(*p).kladde, (&px1[0]) as u64, 7)
                } else {
                    var px2: [u8; 7] = "__gc#w:"
                    rt.buf_push_bytes(&(*p).kladde, (&px2[0]) as u64, 7)
                }
                rt.buf_push_bytes(&(*p).kladde, intern.intern_zeiger(it2, kn),
                                  intern.intern_laenge(it2, kn))
                let pn: u32 = intern.intern_nummer(it2, rt.buf_ptr(&(*p).kladde),
                                                   rt.buf_len(&(*p).kladde)) as u32
                return ast.typ_neu(par_baum(p), ast.T_NAME, pn, 0)
            }
        }
        // `E!T` — eine Fehlerunion (errors.rs::hook_type). Der Parser legt
        // die Angabe in die Registrierung und einen Platzhalter `__eu#<n>`
        // in den Baum; aufgeloest wird er erst im Typpruefer. Die
        // Reihenfolge zaehlt: `!` steht VOR dem `[` der Generics, genau
        // wie in Stufe 0 (`hook_type` vor `hook_generic_type`).
        if hat_fe(p) && ist(p, A_NOT) {
            weiter_bump(p)
            let inner: u32 = typ(p)
            if inner == ast.NICHTS {
                return ast.NICHTS
            }
            let pi: u32 = fehler.fehler_pending_dazu(fh(p), nr, inner)
            let it: *mut intern.Interner = lexer.lex_namen(lx(p))
            rt.buf_leeren(&(*p).kladde)
            var eu: [u8; 5] = "__eu#"
            rt.buf_push_bytes(&(*p).kladde, (&eu[0]) as u64, 5)
            rt.buf_push_dez_u64(&(*p).kladde, pi as u64)
            let pn: u32 = intern.intern_nummer(it, rt.buf_ptr(&(*p).kladde),
                                               rt.buf_len(&(*p).kladde)) as u32
            return ast.typ_neu(par_baum(p), ast.T_NAME, pn, 0)
        }
        // Ein `[` hinter einem Typnamen ist eine generische Auspraegung.
        if ist(p, A_LBRACKET) {
            var generisch: bool = false
            if hat_gen(p) {
                generisch = mono.gen_ist_struct(gn(p), nr)
            }
            if !generisch {
                (*p).nicht_kern = true
                meckern(p)
                return ast.NICHTS
            }
            var targs: Vec[u32] = vec_neu[u32]()
            let ok: bool = typargumente(p, &targs)
            if !ok {
                vec_frei[u32](&targs)
                return ast.NICHTS
            }
            let m: u32 = mono.gen_auspraegung(gn(p), nr, &targs, false)
            vec_frei[u32](&targs)
            return ast.typ_neu(par_baum(p), ast.T_NAME, m, 0)
        }
        let q: u32 = vielleicht_qualifiziert(p, nr, false)
        return ast.typ_neu(par_baum(p), ast.T_NAME, q, 0)
    }
    meckern(p)
    return ast.NICHTS
}

// --------------------------------------------------------------- Ausdruecke

fn ausdruck(p: *mut Parser) -> u32 {
    var e: u32 = oder_ausdruck(p)
    // `ausdruck catch ersatz` bzw. `ausdruck catch |f| ersatz` — bindet
    // SCHWAECHER als jeder Operator und ist linksassoziativ; der Ersatz
    // ist ein Oder-Ausdruck (errors.rs::hook_catch). Im Baum steht ein
    // Aufruf `__catch#` mit zwei Argumenten; die Bindung liegt in der
    // Registrierung.
    if hat_fe(p) {
        while ist(p, A_KWCATCH) {
            weiter_bump(p)
            var bind: u32 = KEIN
            if ist(p, A_PIPE) {
                weiter_bump(p)
                if !ist(p, A_IDENT) {
                    meckern(p)
                    return e
                }
                bind = nummer(p, 0)
                weiter_bump(p)
                if !erwarte(p, A_PIPE) {
                    return e
                }
            }
            // Die Bindung ist ein LOKALER Name — nur im Ersatz sichtbar
            // und von der Modul-Umbenennung ausgenommen (wie die Bindung
            // eines Musters, Runde 32).
            if bind != KEIN {
                lok_auf(p)
                lok_dazu(p, bind)
            }
            let rhs: u32 = oder_ausdruck(p)
            if bind != KEIN {
                lok_zu(p)
            }
            var tmp: Vec[u32] = vec_neu[u32]()
            vec_push[u32](&tmp, e)
            vec_push[u32](&tmp, rhs)
            let off: u32 = liste_ablegen(p, &tmp)
            vec_frei[u32](&tmp)
            var cn: [u8; 8] = "__catch#"
            let it: *mut intern.Interner = lexer.lex_namen(lx(p))
            let name: u32 = intern.intern_nummer(it, (&cn[0]) as u64, 8) as u32
            e = ast.ausdruck_neu(par_baum(p), ast.E_RUF, name, off, 2, 0)
            if bind != KEIN {
                fehler.fehler_cb_setzen(fh(p), e, bind)
            }
        }
    }
    return e
}

// Ausdruck ohne Struct-Literal auf oberster Ebene (Bedingungen).
fn bed_ausdruck(p: *mut Parser) -> u32 {
    (*p).kein_slit = (*p).kein_slit + 1
    let e: u32 = ausdruck(p)
    (*p).kein_slit = (*p).kein_slit - 1
    return e
}

// Ausdruck in Klammern/Argumenten: Struct-Literale sind dort erlaubt.
fn innen_ausdruck(p: *mut Parser) -> u32 {
    let gemerkt: usize = (*p).kein_slit
    (*p).kein_slit = 0
    (*p).klammern = (*p).klammern + 1
    let e: u32 = ausdruck(p)
    (*p).klammern = (*p).klammern - 1
    (*p).kein_slit = gemerkt
    return e
}

fn oder_ausdruck(p: *mut Parser) -> u32 {
    var links: u32 = und_ausdruck(p)
    while ist(p, A_OROR) && weiter(p) {
        weiter_bump(p)
        let rechts: u32 = und_ausdruck(p)
        links = ast.ausdruck_neu(par_baum(p), ast.E_BIN, B_LOR, links, rechts, 0)
    }
    return links
}

fn und_ausdruck(p: *mut Parser) -> u32 {
    var links: u32 = vgl_ausdruck(p)
    while ist(p, A_ANDAND) && weiter(p) {
        weiter_bump(p)
        let rechts: u32 = vgl_ausdruck(p)
        links = ast.ausdruck_neu(par_baum(p), ast.E_BIN, B_LAND, links, rechts, 0)
    }
    return links
}

// -1 = kein Vergleichsoperator
fn vgl_op(a: u32) -> i32 {
    if a == A_EQEQ { return B_EQ as i32 }
    if a == A_NOTEQ { return B_NE as i32 }
    if a == A_LT { return B_LT as i32 }
    if a == A_LE { return B_LE as i32 }
    if a == A_GT { return B_GT as i32 }
    if a == A_GE { return B_GE as i32 }
    return -1
}

// Vergleiche sind NICHT assoziativ (SPEC §10.1: genau ein Vergleich).
fn vgl_ausdruck(p: *mut Parser) -> u32 {
    let links: u32 = add_ausdruck(p)
    let op: i32 = vgl_op(art(p, 0))
    if op < 0 || !weiter(p) {
        return links
    }
    weiter_bump(p)
    let rechts: u32 = add_ausdruck(p)
    var e: u32 = ast.ausdruck_neu(par_baum(p), ast.E_BIN, op as u32, links, rechts, 0)
    while vgl_op(art(p, 0)) >= 0 && weiter(p) {
        meckern(p)
        let op2: i32 = vgl_op(art(p, 0))
        weiter_bump(p)
        let r2: u32 = add_ausdruck(p)
        e = ast.ausdruck_neu(par_baum(p), ast.E_BIN, op2 as u32, e, r2, 0)
    }
    return e
}

fn add_op(a: u32) -> i32 {
    if a == A_PLUS { return B_ADD as i32 }
    if a == A_MINUS { return B_SUB as i32 }
    if a == A_PIPE { return B_OR as i32 }
    if a == A_CARET { return B_XOR as i32 }
    return -1
}

fn add_ausdruck(p: *mut Parser) -> u32 {
    var links: u32 = mul_ausdruck(p)
    while add_op(art(p, 0)) >= 0 && weiter(p) {
        let op: i32 = add_op(art(p, 0))
        weiter_bump(p)
        let rechts: u32 = mul_ausdruck(p)
        links = ast.ausdruck_neu(par_baum(p), ast.E_BIN, op as u32, links, rechts, 0)
    }
    return links
}

fn mul_op(a: u32) -> i32 {
    if a == A_STAR { return B_MUL as i32 }
    if a == A_SLASH { return B_DIV as i32 }
    if a == A_PERCENT { return B_REM as i32 }
    if a == A_AMP { return B_AND as i32 }
    if a == A_SHL { return B_SHL as i32 }
    if a == A_SHR { return B_SHR as i32 }
    return -1
}

fn mul_ausdruck(p: *mut Parser) -> u32 {
    var links: u32 = un_ausdruck(p)
    while mul_op(art(p, 0)) >= 0 && weiter(p) {
        let op: i32 = mul_op(art(p, 0))
        weiter_bump(p)
        let rechts: u32 = un_ausdruck(p)
        links = ast.ausdruck_neu(par_baum(p), ast.E_BIN, op as u32, links, rechts, 0)
    }
    return links
}

fn un_ausdruck(p: *mut Parser) -> u32 {
    let a: u32 = art(p, 0)
    var op: i32 = -1
    if a == A_MINUS { op = U_NEG as i32 }
    else if a == A_NOT { op = U_NOT as i32 }
    else if a == A_AMP { op = U_ADDR as i32 }
    else if a == A_STAR { op = U_DEREF as i32 }
    if op < 0 {
        return nach_ausdruck(p)
    }
    weiter_bump(p)
    let inner: u32 = un_ausdruck(p)
    return ast.ausdruck_neu(par_baum(p), ast.E_UN, op as u32, inner, 0, 0)
}

// Hilfsliste erst SAMMELN, dann am Stueck in `kinder` legen.
//
// Der naheliegende Weg — jedes Argument sofort anhaengen — ist falsch, sobald
// ein Argument selbst einen Aufruf enthaelt: dessen Argumente landen dann
// MITTEN in der aeusseren Liste. Genau das ist beim ersten Lauf passiert; aus
// `f(a, g(b))` wurde `f(a, b, g(b))`. Kinderlisten muessen zusammenhaengend
// sein, also wird die innere Liste zuerst fertig.
fn liste_ablegen(p: *mut Parser, tmp: *mut Vec[u32]) -> u32 {
    let off: u32 = ast.kind_anfang(par_baum(p))
    var i: usize = 0
    while i < vec_len[u32](tmp) {
        ast.kind_dazu(par_baum(p), vec_at[u32](tmp, i))
        i = i + 1
    }
    return off
}

// Argumentliste nach bereits verbrauchtem '('.
fn ruf_argumente(p: *mut Parser) -> u32 {
    var tmp: Vec[u32] = vec_neu[u32]()
    while true {
        if ist(p, A_RPAREN) || am_ende(p) {
            break
        }
        let vor: usize = (*p).pos
        let e: u32 = innen_ausdruck(p)
        vec_push[u32](&tmp, e)
        if !friss(p, A_COMMA) {
            break
        }
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    erwarte(p, A_RPAREN)
    let off: u32 = liste_ablegen(p, &tmp)
    vec_frei[u32](&tmp)
    return off
}

fn nach_ausdruck(p: *mut Parser) -> u32 {
    var e: u32 = grund_ausdruck(p)
    while true {
        if !weiter(p) {
            return e
        }
        let a: u32 = art(p, 0)
        if a == A_DOT {
            weiter_bump(p)
            // RUNDE 34 (gc.rs::hook_postfix): `x.as?[C]` — die gepruefte
            // Abwaertsumwandlung. Im Baum ein Aufruf `__gc#as:C`.
            if hat_gc(p) && ist(p, A_KWAS) && art(p, 1) == A_QUESTION {
                weiter_bump(p)
                weiter_bump(p)
                if !erwarte(p, A_LBRACKET) {
                    return e
                }
                if !ist(p, A_IDENT) {
                    meckern(p)
                    return e
                }
                let kn: u32 = nummer(p, 0)
                weiter_bump(p)
                if !erwarte(p, A_RBRACKET) {
                    return e
                }
                let it4: *mut intern.Interner = lexer.lex_namen(lx(p))
                rt.buf_leeren(&(*p).kladde)
                var px5: [u8; 8] = "__gc#as:"
                rt.buf_push_bytes(&(*p).kladde, (&px5[0]) as u64, 8)
                rt.buf_push_bytes(&(*p).kladde, intern.intern_zeiger(it4, kn),
                                  intern.intern_laenge(it4, kn))
                let an: u32 = intern.intern_nummer(it4, rt.buf_ptr(&(*p).kladde),
                                                   rt.buf_len(&(*p).kladde)) as u32
                var tmp4: Vec[u32] = vec_neu[u32]()
                vec_push[u32](&tmp4, e)
                let off4: u32 = liste_ablegen(p, &tmp4)
                vec_frei[u32](&tmp4)
                e = ast.ausdruck_neu(par_baum(p), ast.E_RUF, an, off4, 1, 0)
                continue
            }
            if !ist(p, A_IDENT) {
                meckern(p)
                return e
            }
            let nr: u32 = nummer(p, 0)
            weiter_bump(p)
            e = ast.ausdruck_neu(par_baum(p), ast.E_FELD, e, nr, 0, 0)
        } else if a == A_LBRACKET {
            // `summe[i32](a, b)` — Aufruf einer generischen Vorlage. Das ist
            // die einzige Stelle, an der `[` nach einem Ausdruck NICHT
            // Indizierung heisst; entschieden wird am NAMEN.
            var vorlage: bool = false
            if hat_gen(p) && ast.e_art(par_baum(p), e) == ast.E_ID {
                vorlage = mono.gen_ist_fn(gn(p), ast.e_a(par_baum(p), e))
            }
            if vorlage {
                let basis: u32 = ast.e_a(par_baum(p), e)
                var targs: Vec[u32] = vec_neu[u32]()
                let ok: bool = typargumente(p, &targs)
                if !ok {
                    vec_frei[u32](&targs)
                    return e
                }
                let m: u32 = mono.gen_auspraegung(gn(p), basis, &targs, true)
                vec_frei[u32](&targs)
                if !erwarte(p, A_LPAREN) {
                    return e
                }
                let off: u32 = ruf_argumente(p)
                let laen: u32 = ast.kind_anzahl(par_baum(p)) - off
                e = ast.ausdruck_neu(par_baum(p), ast.E_RUF, m, off, laen, 0)
            } else {
                weiter_bump(p)
                let idx: u32 = innen_ausdruck(p)
                erwarte(p, A_RBRACKET)
                e = ast.ausdruck_neu(par_baum(p), ast.E_IDX, e, idx, 0, 0)
            }
        } else if a == A_LPAREN {
            // Nur direkte Funktionsnamen koennen aufgerufen werden (Stufe 0).
            if ast.e_art(par_baum(p), e) != ast.E_ID {
                meckern(p)
                return e
            }
            let name: u32 = ast.e_a(par_baum(p), e)
            weiter_bump(p)
            let off: u32 = ruf_argumente(p)
            let laen: u32 = ast.kind_anzahl(par_baum(p)) - off
            e = ast.ausdruck_neu(par_baum(p), ast.E_RUF, name, off, laen, 0)
        } else if a == A_KWAS {
            weiter_bump(p)
            let t: u32 = typ(p)
            if t == ast.NICHTS {
                return e
            }
            e = ast.ausdruck_neu(par_baum(p), ast.E_AS, e, t, 0, 0)
        } else {
            return e
        }
    }
    return e
}

// `Name{ feld: wert, ... }` — '{' steht noch an.
fn struct_literal(p: *mut Parser, name: u32) -> u32 {
    weiter_bump(p)
    var tmp: Vec[u32] = vec_neu[u32]()
    while true {
        if ist(p, A_RBRACE) || am_ende(p) {
            break
        }
        let vor: usize = (*p).pos
        if !ist(p, A_IDENT) {
            meckern(p)
            break
        }
        let fname: u32 = nummer(p, 0)
        weiter_bump(p)
        if !erwarte(p, A_COLON) {
            break
        }
        let wert: u32 = innen_ausdruck(p)
        vec_push[u32](&tmp, fname)
        vec_push[u32](&tmp, wert)
        if !friss(p, A_COMMA) {
            break
        }
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    erwarte(p, A_RBRACE)
    let laen: u32 = vec_len[u32](&tmp) as u32 / 2
    let off: u32 = liste_ablegen(p, &tmp)
    vec_frei[u32](&tmp)
    return ast.ausdruck_neu(par_baum(p), ast.E_SLIT, name, off, laen, 0)
}

// Ein Zeichenkettenliteral wird zu einem ARRAY-LITERAL aus Ganzzahlen —
// genauso wie in `firnc0`. Damit ist der Typ `[u8; N]` bzw. `[u16; N]`, und
// Typpruefer und Lowering brauchen nichts Eigenes.
fn text_literal(p: *mut Parser) -> u32 {
    let k: usize = nummer(p, 0) as usize
    let la: u32 = lexer.lex_lit_art(lx(p), k)
    let n: usize = lexer.lex_lit_len(lx(p), k)
    weiter_bump(p)
    if n == 0 {
        meckern(p)
        return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
    }
    var tmp: Vec[u32] = vec_neu[u32]()
    var i: usize = 0
    while i < n {
        var w: u64 = 0
        if la == 2 {
            w = lexer.lex_lit_einheit(lx(p), k, i) as u64
        } else {
            w = lexer.lex_lit_byte(lx(p), k, i) as u64
        }
        vec_push[u32](&tmp, ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, w))
        i = i + 1
    }
    let off: u32 = liste_ablegen(p, &tmp)
    vec_frei[u32](&tmp)
    return ast.ausdruck_neu(par_baum(p), ast.E_ALIT, 0, off, n as u32, 0)
}

// `size_of[Typname]()` — `size_of` ist gelesen, `[` steht an.
//
// BEWUSST NUR EIN TYPNAME, kein voller Typausdruck: genau wie `sizeof.rs`.
fn size_of_ausdruck(p: *mut Parser) -> u32 {
    weiter_bump(p)
    if !ist(p, A_IDENT) {
        meckern(p)
        return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
    }
    let tn: u32 = nummer(p, 0)
    weiter_bump(p)
    if !erwarte(p, A_RBRACKET) {
        return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
    }
    if !erwarte(p, A_LPAREN) {
        return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
    }
    if !erwarte(p, A_RPAREN) {
        return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
    }
    let t: u32 = ast.typ_neu(par_baum(p), ast.T_NAME, tn, 0)
    let name: u32 = mono.gen_size_of_name(gn(p), t)
    return ast.ausdruck_neu(par_baum(p), ast.E_RUF, name, 0, 0, (t as u64) + 1)
}

fn grund_ausdruck(p: *mut Parser) -> u32 {
    let a: u32 = art(p, 0)
    // `try ausdruck` — der Operand ist ein UNAERER Ausdruck, der Aufruf
    // heisst `__try#` (errors.rs::hook_primary, TRY_NAME).
    if a == A_KWTRY && hat_fe(p) {
        weiter_bump(p)
        let inner: u32 = un_ausdruck(p)
        let off: u32 = ast.kind_anfang(par_baum(p))
        ast.kind_dazu(par_baum(p), inner)
        var tn: [u8; 6] = "__try#"
        let it: *mut intern.Interner = lexer.lex_namen(lx(p))
        let name: u32 = intern.intern_nummer(it, (&tn[0]) as u64, 6) as u32
        return ast.ausdruck_neu(par_baum(p), ast.E_RUF, name, off, 1, 0)
    }
    if a == A_INT {
        let v: u64 = zahl(p)
        weiter_bump(p)
        return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, v)
    }
    if a == A_FLOAT {
        let v: u64 = zahl(p)
        weiter_bump(p)
        return ast.ausdruck_neu(par_baum(p), ast.E_FLOAT, 0, 0, 0, v)
    }
    if a == A_STR {
        return text_literal(p)
    }
    if a == A_KWTRUE {
        weiter_bump(p)
        return ast.ausdruck_neu(par_baum(p), ast.E_BOOL, 1, 0, 0, 0)
    }
    if a == A_KWFALSE {
        weiter_bump(p)
        return ast.ausdruck_neu(par_baum(p), ast.E_BOOL, 0, 0, 0, 0)
    }
    if a == A_LPAREN {
        weiter_bump(p)
        let e: u32 = innen_ausdruck(p)
        erwarte(p, A_RPAREN)
        return e
    }
    if a == A_LBRACKET {
        weiter_bump(p)
        var tmp: Vec[u32] = vec_neu[u32]()
        var fertig: bool = false
        if !ist(p, A_RBRACKET) && !am_ende(p) {
            let erstes: u32 = innen_ausdruck(p)
            if ist(p, A_SEMI) {
                weiter_bump(p)
                let anzahl: u32 = innen_ausdruck(p)
                erwarte(p, A_RBRACKET)
                vec_frei[u32](&tmp)
                return ast.ausdruck_neu(par_baum(p), ast.E_AWDH, erstes, anzahl, 0, 0)
            }
            vec_push[u32](&tmp, erstes)
            if !friss(p, A_COMMA) {
                erwarte(p, A_RBRACKET)
                fertig = true
            }
        }
        while !fertig {
            if ist(p, A_RBRACKET) || am_ende(p) {
                break
            }
            let vor: usize = (*p).pos
            let e: u32 = innen_ausdruck(p)
            vec_push[u32](&tmp, e)
            if !friss(p, A_COMMA) {
                break
            }
            if (*p).pos == vor {
                weiter_bump(p)
            }
        }
        if !fertig {
            erwarte(p, A_RBRACKET)
        }
        let laen: u32 = vec_len[u32](&tmp) as u32
        let off: u32 = liste_ablegen(p, &tmp)
        vec_frei[u32](&tmp)
        return ast.ausdruck_neu(par_baum(p), ast.E_ALIT, 0, off, laen, 0)
    }
    if a == A_KWSYSCALL {
        weiter_bump(p)
        erwarte(p, A_LPAREN)
        let off: u32 = ruf_argumente(p)
        let laen: u32 = ast.kind_anzahl(par_baum(p)) - off
        return ast.ausdruck_neu(par_baum(p), ast.E_SYSCALL, 0, off, laen, 0)
    }
    if a == A_IDENT {
        let nr: u32 = nummer(p, 0)
        weiter_bump(p)
        // RUNDE 34 (gc.rs::hook_primary): `gc C{ ... }`, `gc_null[C]()` und
        // `weak_null[C]()`.
        if hat_gc(p) {
            let it3: *mut intern.Interner = lexer.lex_namen(lx(p))
            var gw2: [u8; 2] = "gc"
            if intern.intern_gleich(it3, nr, (&gw2[0]) as u64, 2) {
                if ist(p, A_IDENT) && art(p, 1) == A_LBRACE {
                    var cw2: [u8; 5] = "class"
                    if !intern.intern_gleich(it3, nummer(p, 0), (&cw2[0]) as u64, 5) {
                        let kn: u32 = nummer(p, 0)
                        weiter_bump(p)
                        // "gc C" — mit Leerzeichen, kann nie ein Bezeichner
                        // des Quelltextes sein.
                        var tr2: [u8; 1] = " "
                        let voll: u32 = verbinde(p, nr, (&tr2[0]) as u64, 1, kn)
                        // kein_slit gilt hier nicht: die Klammer gehoert zur
                        // Allokation, nicht zur Kontrollstruktur.
                        let lit: u32 = struct_literal(p, voll)
                        var tmp2: Vec[u32] = vec_neu[u32]()
                        vec_push[u32](&tmp2, lit)
                        let off2: u32 = liste_ablegen(p, &tmp2)
                        vec_frei[u32](&tmp2)
                        return ast.ausdruck_neu(par_baum(p), ast.E_RUF, voll, off2, 1, 0)
                    }
                }
            }
            var gn1: [u8; 7] = "gc_null"
            var gn2: [u8; 9] = "weak_null"
            let ist_gnull: bool = intern.intern_gleich(it3, nr, (&gn1[0]) as u64, 7)
            let ist_wnull: bool = intern.intern_gleich(it3, nr, (&gn2[0]) as u64, 9)
            if (ist_gnull || ist_wnull) && ist(p, A_LBRACKET) {
                weiter_bump(p)
                if !ist(p, A_IDENT) {
                    meckern(p)
                    return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
                }
                let kn: u32 = nummer(p, 0)
                weiter_bump(p)
                if !erwarte(p, A_RBRACKET) {
                    return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
                }
                if !erwarte(p, A_LPAREN) {
                    return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
                }
                if !erwarte(p, A_RPAREN) {
                    return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
                }
                if ist_gnull {
                    // `0 as Gc[C]` — der Nullwert ist der Nullzeiger.
                    rt.buf_leeren(&(*p).kladde)
                    var px3: [u8; 7] = "__gc#p:"
                    rt.buf_push_bytes(&(*p).kladde, (&px3[0]) as u64, 7)
                    rt.buf_push_bytes(&(*p).kladde, intern.intern_zeiger(it3, kn),
                                      intern.intern_laenge(it3, kn))
                    let tn: u32 = intern.intern_nummer(it3, rt.buf_ptr(&(*p).kladde),
                                                       rt.buf_len(&(*p).kladde)) as u32
                    let tn2: u32 = ast.typ_neu(par_baum(p), ast.T_NAME, tn, 0)
                    let null: u32 = ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
                    return ast.ausdruck_neu(par_baum(p), ast.E_AS, null, tn2, 0, 0)
                }
                // `GcWeak[C]{ __p: 0, __s: 0 }` — der leere schwache Verweis.
                rt.buf_leeren(&(*p).kladde)
                var px4: [u8; 7] = "GcWeak["
                rt.buf_push_bytes(&(*p).kladde, (&px4[0]) as u64, 7)
                rt.buf_push_bytes(&(*p).kladde, intern.intern_zeiger(it3, kn),
                                  intern.intern_laenge(it3, kn))
                rt.buf_push(&(*p).kladde, 93 as u8)
                let wn: u32 = intern.intern_nummer(it3, rt.buf_ptr(&(*p).kladde),
                                                   rt.buf_len(&(*p).kladde)) as u32
                var wp2: [u8; 3] = "__p"
                var ws2: [u8; 3] = "__s"
                let wp_n: u32 = intern.intern_nummer(it3, (&wp2[0]) as u64, 3) as u32
                let ws_n: u32 = intern.intern_nummer(it3, (&ws2[0]) as u64, 3) as u32
                let n1: u32 = ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
                let n2: u32 = ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
                var tmp3: Vec[u32] = vec_neu[u32]()
                vec_push[u32](&tmp3, wp_n)
                vec_push[u32](&tmp3, n1)
                vec_push[u32](&tmp3, ws_n)
                vec_push[u32](&tmp3, n2)
                let off3: u32 = liste_ablegen(p, &tmp3)
                vec_frei[u32](&tmp3)
                return ast.ausdruck_neu(par_baum(p), ast.E_SLIT, wn, off3, 2, 0)
            }
        }
        // `size_of[T]()` — der Typtext wandert in den AUFRUFNAMEN
        // (`size_of$i32`, sizeof.rs), der Typknoten zusaetzlich nach
        // `e_zahl`; aufgeloest wird beides erst im Typpruefer, der die
        // Structtafel kennt.
        if (*p).sonr >= 0 && nr as i64 == (*p).sonr && ist(p, A_LBRACKET) {
            return size_of_ausdruck(p)
        }
        // `Vec[i32]{ ... }` — Literal einer generischen Struktur.
        var gstruct: bool = false
        if hat_gen(p) && ist(p, A_LBRACKET) {
            gstruct = mono.gen_ist_struct(gn(p), nr)
        }
        if gstruct {
            var targs: Vec[u32] = vec_neu[u32]()
            let ok: bool = typargumente(p, &targs)
            if !ok {
                vec_frei[u32](&targs)
                return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
            }
            let m: u32 = mono.gen_auspraegung(gn(p), nr, &targs, false)
            vec_frei[u32](&targs)
            if ist(p, A_LBRACE) && (*p).kein_slit == 0 {
                return struct_literal(p, m)
            }
            meckern(p)
            return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
        }
        // `Enum::Variante(..)` — der Aufzaehlungskonstruktor. Erkannt an der
        // FORM (`IDENT :: IDENT`), nicht an einem Register — genau wie
        // `sema_match.rs::hook_primary`. `::` sind ZWEI Doppelpunkttoken;
        // ein eigenes Token gibt es nicht.
        if ist(p, A_COLON) && art(p, 1) == A_COLON {
            if !hat_mu(p) {
                (*p).nicht_kern = true
                meckern(p)
                return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
            }
            weiter_bump(p)
            weiter_bump(p)
            if !ist(p, A_IDENT) {
                meckern(p)
                return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
            }
            let vn: u32 = nummer(p, 0)
            weiter_bump(p)
            // Der vollstaendige Name `Enum::Variante` wird EIN Name. KEINE
            // Umbenennung: Aufzaehlungsnamen gelten programmweit (SPEC §14.1).
            var dp: [u8; 2] = "::"
            let full: u32 = verbinde(p, nr, (&dp[0]) as u64, 2, vn)
            var aoff: u32 = 0
            var alen: u32 = 0
            if ist(p, A_LPAREN) {
                weiter_bump(p)
                aoff = ruf_argumente(p)
                alen = ast.kind_anzahl(par_baum(p)) - aoff
            }
            return ast.ausdruck_neu(par_baum(p), ast.E_RUF, full, aoff, alen, 0)
        }
        // Steht `(` an, ist das ein AUFRUFNAME — den verdeckt eine lokale
        // Variable nicht (`Renamer::resolve`, is_value = false).
        let q: u32 = vielleicht_qualifiziert(p, nr, !ist(p, A_LPAREN))
        if ist(p, A_LBRACE) && (*p).kein_slit == 0 {
            return struct_literal(p, q)
        }
        return ast.ausdruck_neu(par_baum(p), ast.E_ID, q, 0, 0, 0)
    }
    meckern(p)
    weiter_bump(p)
    return ast.ausdruck_neu(par_baum(p), ast.E_INT, 0, 0, 0, 0)
}

// -------------------------------------------------------------- Anweisungen

// Anweisungsende: ';' oder Zeilenwechsel oder '}'.
fn ende_anweisung(p: *mut Parser) {
    var hatte: bool = false
    while ist(p, A_SEMI) {
        weiter_bump(p)
        hatte = true
    }
    if hatte || ist(p, A_RBRACE) || am_ende(p) || zeilenanfang(p) {
        return
    }
    meckern(p)
}

fn block(p: *mut Parser) -> u32 {
    if !erwarte(p, A_LBRACE) {
        return ast.block_neu(par_baum(p), 0, 0)
    }
    lok_auf(p)
    // Die Anweisungsnummern werden zuerst gesammelt und erst am Ende in
    // `sliste` gelegt — verschachtelte Bloecke wuerden sonst dazwischenfunken.
    var eigene: Vec[u32] = vec_neu[u32]()
    while true {
        if ist(p, A_RBRACE) {
            break
        }
        if am_ende(p) {
            meckern(p)
            break
        }
        if friss(p, A_SEMI) {
            continue
        }
        if (*p).fehler > 0 {
            break
        }
        let vor: usize = (*p).pos
        let s: u32 = anweisung(p)
        vec_push[u32](&eigene, s)
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    friss(p, A_RBRACE)
    let off: u32 = vec_len[u32](&(*par_baum(p)).sliste) as u32
    var i: usize = 0
    while i < vec_len[u32](&eigene) {
        vec_push[u32](&(*par_baum(p)).sliste, vec_at[u32](&eigene, i))
        i = i + 1
    }
    let laen: u32 = vec_len[u32](&eigene) as u32
    vec_frei[u32](&eigene)
    lok_zu(p)
    return ast.block_neu(par_baum(p), off, laen)
}

fn let_anweisung(p: *mut Parser) -> u32 {
    var art_s: u32 = ast.S_LET
    if ist(p, A_KWVAR) {
        art_s = ast.S_VAR
    }
    weiter_bump(p)
    if !ist(p, A_IDENT) {
        meckern(p)
        return ast.anweisung_neu(par_baum(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let name: u32 = nummer(p, 0)
    weiter_bump(p)
    var t: u32 = ast.NICHTS
    if friss(p, A_COLON) {
        t = typ(p)
        if t == ast.NICHTS {
            return ast.anweisung_neu(par_baum(p), ast.S_BREAK, 0, 0, 0, 0)
        }
    }
    if !erwarte(p, A_ASSIGN) {
        return ast.anweisung_neu(par_baum(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let init: u32 = ausdruck(p)
    ende_anweisung(p)
    // ERST JETZT sichtbar: `let x = x + 1` meint rechts das aeussere `x`.
    lok_dazu(p, name)
    return ast.anweisung_neu(par_baum(p), art_s, name, t, init, 0)
}

fn if_anweisung(p: *mut Parser) -> u32 {
    weiter_bump(p)
    let bed: u32 = bed_ausdruck(p)
    let dann: u32 = block(p)
    var sonst: u32 = ast.NICHTS
    if ist(p, A_KWELSE) {
        weiter_bump(p)
        if ist(p, A_KWIF) {
            sonst = anweisung(p)
        } else {
            let b: u32 = block(p)
            sonst = ast.anweisung_neu(par_baum(p), ast.S_BLOCK, b, 0, 0, 0)
        }
    }
    return ast.anweisung_neu(par_baum(p), ast.S_IF, bed, dann, sonst, 0)
}

fn while_anweisung(p: *mut Parser) -> u32 {
    weiter_bump(p)
    let bed: u32 = bed_ausdruck(p)
    let rumpf: u32 = block(p)
    return ast.anweisung_neu(par_baum(p), ast.S_WHILE, bed, rumpf, 0, 0)
}

fn for_anweisung(p: *mut Parser) -> u32 {
    weiter_bump(p)
    if !ist(p, A_IDENT) {
        meckern(p)
        return ast.anweisung_neu(par_baum(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let name: u32 = nummer(p, 0)
    weiter_bump(p)
    if !erwarte(p, A_KWIN) {
        return ast.anweisung_neu(par_baum(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let von: u32 = bed_ausdruck(p)
    if !erwarte(p, A_DOTDOT) {
        return ast.anweisung_neu(par_baum(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let bis: u32 = bed_ausdruck(p)
    lok_auf(p)
    lok_dazu(p, name)
    let rumpf: u32 = block(p)
    lok_zu(p)
    return ast.anweisung_neu(par_baum(p), ast.S_FOR, name, von, bis, rumpf)
}

fn return_anweisung(p: *mut Parser) -> u32 {
    weiter_bump(p)
    var wert: u32 = ast.NICHTS
    var hat: bool = true
    if ist(p, A_SEMI) || ist(p, A_RBRACE) || am_ende(p) || zeilenanfang(p) {
        hat = false
    }
    if hat {
        wert = ausdruck(p)
    }
    ende_anweisung(p)
    return ast.anweisung_neu(par_baum(p), ast.S_RET, wert, 0, 0, 0)
}

fn anweisung(p: *mut Parser) -> u32 {
    let a: u32 = art(p, 0)
    if a == A_KWLET || a == A_KWVAR {
        return let_anweisung(p)
    }
    if a == A_KWIF {
        return if_anweisung(p)
    }
    if a == A_KWWHILE {
        return while_anweisung(p)
    }
    if a == A_KWFOR {
        return for_anweisung(p)
    }
    if a == A_KWBREAK {
        weiter_bump(p)
        ende_anweisung(p)
        return ast.anweisung_neu(par_baum(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    if a == A_KWCONTINUE {
        weiter_bump(p)
        ende_anweisung(p)
        return ast.anweisung_neu(par_baum(p), ast.S_CONT, 0, 0, 0, 0)
    }
    if a == A_KWDEFER || a == A_KWERRDEFER {
        var art_s: u32 = ast.S_DEFER
        if a == A_KWERRDEFER {
            art_s = ast.S_ERRDEFER
        }
        weiter_bump(p)
        let inner: u32 = anweisung(p)
        return ast.anweisung_neu(par_baum(p), art_s, inner, 0, 0, 0)
    }
    if a == A_KWRETURN {
        return return_anweisung(p)
    }
    if a == A_LBRACE {
        let b: u32 = block(p)
        return ast.anweisung_neu(par_baum(p), ast.S_BLOCK, b, 0, 0, 0)
    }
    if a == A_KWMATCH {
        if !hat_mu(p) {
            (*p).nicht_kern = true
            meckern(p)
            return ast.anweisung_neu(par_baum(p), ast.S_BREAK, 0, 0, 0, 0)
        }
        return match_anweisung(p)
    }
    if a == A_KWCATCH {
        // `catch` steht nie am Anfang einer Anweisung — ein gewoehnlicher
        // Syntaxfehler, wie in Stufe 0. (`try` faellt in den Ausdrucksweg.)
        meckern(p)
        return ast.anweisung_neu(par_baum(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let e: u32 = ausdruck(p)
    if ist(p, A_ASSIGN) {
        weiter_bump(p)
        let v: u32 = ausdruck(p)
        ende_anweisung(p)
        return ast.anweisung_neu(par_baum(p), ast.S_ZUW, e, v, 0, 0)
    }
    ende_anweisung(p)
    return ast.anweisung_neu(par_baum(p), ast.S_EXPR, e, 0, 0, 0)
}

// -------------------------------------------------------------- Deklarationen

fn parameterliste(p: *mut Parser) -> u32 {
    let off: u32 = vec_len[u32](&(*par_baum(p)).pa_name) as u32
    while true {
        if ist(p, A_RPAREN) || am_ende(p) {
            break
        }
        let vor: usize = (*p).pos
        if !ist(p, A_IDENT) {
            meckern(p)
            break
        }
        let name: u32 = nummer(p, 0)
        weiter_bump(p)
        if !erwarte(p, A_COLON) {
            break
        }
        let t: u32 = typ(p)
        if t == ast.NICHTS {
            break
        }
        ast.param_dazu(par_baum(p), name, t)
        lok_dazu(p, name)
        if !friss(p, A_COMMA) {
            break
        }
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    return off
}

// `fn name[T: Int](..) -> R { .. }`
//
// DER NAME BLEIBT UNVERAENDERT, auch in einem Modul: generische Namen gelten
// programmweit und werden unqualifiziert benutzt (`vec_push[i32](..)`).
// Deshalb nimmt `eigene_suchen` sie auch nicht in die Umbenennungsliste auf.
//
// Die Vorlage geht NICHT in die Funktionsliste des Baums — sonst stolperte
// der Typpruefer ueber `T` und `--emit=ast-kanon` druckte sie, was `firnc0`
// nicht tut. Ihre Knoten stehen sehr wohl im Baum; gemerkt werden nur die
// Einstiegspunkte.
fn fn_vorlage(p: *mut Parser, name: u32) {
    if !typparameterliste(p) {
        return
    }
    let toff: u32 = (*p).tpoff
    let tlen: u32 = mono.gen_tp_anfang(gn(p)) - toff
    if !erwarte(p, A_LPAREN) {
        return
    }
    // Waehrend des Rumpfes sind alle Auspraegungen ABSTRAKT: `Vec[T]` ist
    // noch keine Arbeit, sondern eine Vorschrift.
    mono.gen_tiefe_auf(gn(p))
    lok_auf(p)
    let poff: u32 = parameterliste(p)
    erwarte(p, A_RPAREN)
    let plen: u32 = ast.param_anfang(par_baum(p)) - poff
    var ret: u32 = ast.NICHTS
    if friss(p, A_ARROW) {
        ret = typ(p)
        if ret == ast.NICHTS {
            lok_zu(p)
            mono.gen_tiefe_zu(gn(p))
            return
        }
    }
    let rumpf: u32 = block(p)
    lok_zu(p)
    mono.gen_tiefe_zu(gn(p))
    mono.gen_fn_vorlage(gn(p), name, toff, tlen, poff, plen, ret, rumpf)
}

// `struct Name[T] { feld: T, .. }`
fn struct_vorlage(p: *mut Parser, name: u32) {
    if !typparameterliste(p) {
        return
    }
    let toff: u32 = (*p).tpoff
    let tlen: u32 = mono.gen_tp_anfang(gn(p)) - toff
    if !erwarte(p, A_LBRACE) {
        return
    }
    mono.gen_tiefe_auf(gn(p))
    let off: u32 = ast.feld_anfang(par_baum(p))
    while true {
        while friss(p, A_COMMA) || friss(p, A_SEMI) {}
        if ist(p, A_RBRACE) || am_ende(p) {
            break
        }
        let vor: usize = (*p).pos
        if !ist(p, A_IDENT) {
            meckern(p)
            break
        }
        let fname: u32 = nummer(p, 0)
        weiter_bump(p)
        if !erwarte(p, A_COLON) {
            break
        }
        let t: u32 = typ(p)
        if t == ast.NICHTS {
            break
        }
        ast.feld_dazu(par_baum(p), fname, t)
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    erwarte(p, A_RBRACE)
    mono.gen_tiefe_zu(gn(p))
    let flen: u32 = ast.feld_anfang(par_baum(p)) - off
    mono.gen_struct_vorlage(gn(p), name, toff, tlen, off, flen)
}

fn fn_deklaration(p: *mut Parser) {
    weiter_bump(p)
    if !ist(p, A_IDENT) {
        meckern(p)
        return
    }
    let roh: u32 = nummer(p, 0)
    weiter_bump(p)
    // Eine Typparameterliste macht daraus eine generische VORLAGE.
    if ist(p, A_LBRACKET) {
        if !hat_gen(p) {
            (*p).nicht_kern = true
            meckern(p)
            return
        }
        fn_vorlage(p, roh)
        return
    }
    let name: u32 = umbenannt(p, roh)
    if !erwarte(p, A_LPAREN) {
        return
    }
    lok_auf(p)
    let poff: u32 = parameterliste(p)
    erwarte(p, A_RPAREN)
    let plen: u32 = vec_len[u32](&(*par_baum(p)).pa_name) as u32 - poff
    var ret: u32 = ast.NICHTS
    if friss(p, A_ARROW) {
        ret = typ(p)
        if ret == ast.NICHTS {
            lok_zu(p)
            return
        }
    }
    let rumpf: u32 = block(p)
    lok_zu(p)
    ast.fn_dazu(par_baum(p), name, poff, plen, ret, rumpf, (*p).nogc_anstehend)
    (*p).nogc_anstehend = 0
}

fn struct_deklaration(p: *mut Parser) {
    weiter_bump(p)
    if !ist(p, A_IDENT) {
        meckern(p)
        return
    }
    let roh: u32 = nummer(p, 0)
    weiter_bump(p)
    if ist(p, A_LBRACKET) {
        if !hat_gen(p) {
            (*p).nicht_kern = true
            meckern(p)
            return
        }
        struct_vorlage(p, roh)
        return
    }
    let name: u32 = umbenannt(p, roh)
    if !erwarte(p, A_LBRACE) {
        return
    }
    let off: u32 = vec_len[u32](&(*par_baum(p)).fd_name) as u32
    while true {
        while friss(p, A_COMMA) || friss(p, A_SEMI) {}
        if ist(p, A_RBRACE) || am_ende(p) {
            break
        }
        let vor: usize = (*p).pos
        if !ist(p, A_IDENT) {
            meckern(p)
            break
        }
        let fname: u32 = nummer(p, 0)
        weiter_bump(p)
        if !erwarte(p, A_COLON) {
            break
        }
        let t: u32 = typ(p)
        if t == ast.NICHTS {
            break
        }
        ast.feld_dazu(par_baum(p), fname, t)
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    erwarte(p, A_RBRACE)
    let laen: u32 = vec_len[u32](&(*par_baum(p)).fd_name) as u32 - off
    ast.struktur_dazu(par_baum(p), name, off, laen)
}

fn const_deklaration(p: *mut Parser) {
    weiter_bump(p)
    if !ist(p, A_IDENT) {
        meckern(p)
        return
    }
    let name: u32 = umbenannt(p, nummer(p, 0))
    weiter_bump(p)
    if !erwarte(p, A_COLON) {
        return
    }
    let t: u32 = typ(p)
    if t == ast.NICHTS {
        return
    }
    if !erwarte(p, A_ASSIGN) {
        return
    }
    let w: u32 = ausdruck(p)
    ende_anweisung(p)
    ast.konst_dazu(par_baum(p), name, t, w)
}

fn import_deklaration(p: *mut Parser) {
    weiter_bump(p)
    if !ist(p, A_IDENT) {
        meckern(p)
        return
    }
    rt.buf_leeren(&(*p).kladde)
    let it: *mut intern.Interner = lexer.lex_namen(lx(p))
    var letzter: u32 = nummer(p, 0)
    rt.buf_push_bytes(&(*p).kladde, intern.intern_zeiger(it, letzter), intern.intern_laenge(it, letzter))
    weiter_bump(p)
    while ist(p, A_DOT) && art(p, 1) == A_IDENT {
        weiter_bump(p)
        letzter = nummer(p, 0)
        rt.buf_push(&(*p).kladde, 46 as u8)
        rt.buf_push_bytes(&(*p).kladde, intern.intern_zeiger(it, letzter), intern.intern_laenge(it, letzter))
        weiter_bump(p)
    }
    let pfad: u32 = intern.intern_nummer(it, rt.buf_ptr(&(*p).kladde), rt.buf_len(&(*p).kladde)) as u32
    ast.imp_dazu(par_baum(p), pfad, letzter)
    vec_push[u32](&(*p).module, letzter)
    ende_anweisung(p)
}

fn export_deklaration(p: *mut Parser) {
    weiter_bump(p)
    if !erwarte(p, A_LBRACE) {
        return
    }
    while true {
        while friss(p, A_COMMA) || friss(p, A_SEMI) {}
        if ist(p, A_RBRACE) || am_ende(p) {
            break
        }
        if !ist(p, A_IDENT) {
            meckern(p)
            break
        }
        ast.exp_dazu(par_baum(p), nummer(p, 0))
        weiter_bump(p)
    }
    erwarte(p, A_RBRACE)
}

fn profile_deklaration(p: *mut Parser) {
    weiter_bump(p)
    if !ist(p, A_IDENT) {
        meckern(p)
        return
    }
    ast.profil_setzen(par_baum(p), nummer(p, 0))
    weiter_bump(p)
    ende_anweisung(p)
}

// ------------------------------------------------------ enum und match
//
// Portierung der Parser-Hooks aus `sema_match.rs`. Die FAELLE eines `match`
// stehen NICHT im Baum, sondern im Muster-Register (`muster.fi`); im Baum
// bleibt ein Aufruf `__match#<nummer>` ohne Argumente. So kann auch eine
// generische Vorlage die Faelle je Auspraegung ersetzen — und
// `--emit=ast-kanon` druckt genau das, was Stufe 0 druckt.

// `::` sind zwei unmittelbar aufeinanderfolgende Doppelpunkttoken.
fn doppelpunkt(p: *mut Parser, k: usize) -> bool {
    return art(p, k) == A_COLON && art(p, k + 1) == A_COLON
}

// `enum Name { A, B(i32), C(Punkt, bool) }`
fn enum_deklaration(p: *mut Parser) {
    weiter_bump(p)
    if !ist(p, A_IDENT) {
        meckern(p)
        return
    }
    // KEINE Umbenennung: Aufzaehlungsnamen gelten programmweit (SPEC §14.1).
    let name: u32 = nummer(p, 0)
    weiter_bump(p)
    if !erwarte(p, A_LBRACE) {
        return
    }
    let ei: u32 = muster.mus_enum_dazu(mn(p), name)
    while true {
        while friss(p, A_COMMA) {}
        if ist(p, A_RBRACE) || am_ende(p) {
            break
        }
        let vor: usize = (*p).pos
        if !ist(p, A_IDENT) {
            meckern(p)
            break
        }
        let vname: u32 = nummer(p, 0)
        weiter_bump(p)
        let toff: u32 = muster.mus_vt_anfang(mn(p))
        var tlen: u32 = 0
        if friss(p, A_LPAREN) {
            while true {
                if ist(p, A_RPAREN) || am_ende(p) {
                    break
                }
                let vor2: usize = (*p).pos
                let t: u32 = typ(p)
                if t == ast.NICHTS {
                    break
                }
                muster.mus_vt_dazu(mn(p), t)
                tlen = tlen + 1
                if !friss(p, A_COMMA) {
                    break
                }
                if (*p).pos == vor2 {
                    weiter_bump(p)
                }
            }
            erwarte(p, A_RPAREN)
        }
        muster.mus_variante_dazu(mn(p), ei, vname, toff, tlen)
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    erwarte(p, A_RBRACE)
    if muster.mus_e_vlen(mn(p), ei) == 0 {
        // Eine Aufzaehlung ohne Variante ist ein Fehler (wie in Stufe 0).
        meckern(p)
    }
}

// `error Name { A, B, C }` — eine Fehlermenge (errors.rs::errors_decl).
// KEINE Umbenennung des Namens: Fehlermengen gelten programmweit, genau wie
// Aufzaehlungsnamen (SPEC §14.1). Codes ab 1 in Deklarationsreihenfolge.
fn error_deklaration(p: *mut Parser) {
    weiter_bump(p)
    if !ist(p, A_IDENT) {
        meckern(p)
        return
    }
    let name: u32 = nummer(p, 0)
    weiter_bump(p)
    if !erwarte(p, A_LBRACE) {
        return
    }
    let mi: u32 = fehler.fehler_menge_dazu(fh(p), name)
    if mi == KEIN {
        // fehlermenge ist bereits deklariert
        meckern(p)
    }
    var n: u32 = 0
    while true {
        while friss(p, A_COMMA) {}
        if ist(p, A_RBRACE) || am_ende(p) {
            break
        }
        let vor: usize = (*p).pos
        if !ist(p, A_IDENT) {
            meckern(p)
            break
        }
        let vn: u32 = nummer(p, 0)
        weiter_bump(p)
        // Doppelt deklarierte Variante ist ein Fehler (wie in Stufe 0).
        if mi != KEIN {
            if !fehler.fehler_variante_dazu(fh(p), mi, vn) {
                meckern(p)
            }
        }
        n = n + 1
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    erwarte(p, A_RBRACE)
    if n == 0 {
        // Eine Fehlermenge ohne Variante ist ein Fehler (wie in Stufe 0).
        meckern(p)
    }
}

// Ganzzahl in einem Muster, optional mit Vorzeichen.
fn muster_ganzzahl(p: *mut Parser, gut: *mut bool) -> i64 {
    var neg: bool = false
    if friss(p, A_MINUS) {
        neg = true
    }
    if !ist(p, A_INT) {
        meckern(p)
        *gut = false
        return 0
    }
    let v: u64 = zahl(p)
    weiter_bump(p)
    if neg {
        return 0 - (v as i64)
    }
    return v as i64
}

// Ein Muster (SPEC §6.3). Bindungen werden sofort als lokale Namen
// angemeldet — der Rumpf des Falls wird danach geparst und muss sie sehen.
fn muster(p: *mut Parser, tiefe: u32) -> u32 {
    if tiefe > 32 {
        meckern(p)
        return ast.NICHTS
    }
    let a: u32 = art(p, 0)
    if a == A_KWTRUE {
        weiter_bump(p)
        return muster.mus_mu_dazu(mn(p), muster.MU_BOOL, 1, 0, 0, 0, 0, 0)
    }
    if a == A_KWFALSE {
        weiter_bump(p)
        return muster.mus_mu_dazu(mn(p), muster.MU_BOOL, 0, 0, 0, 0, 0, 0)
    }
    if a == A_INT || a == A_MINUS {
        var gut: bool = true
        let lo: i64 = muster_ganzzahl(p, &gut)
        if !gut {
            return ast.NICHTS
        }
        if ist(p, A_DOTDOT) {
            weiter_bump(p)
            var inkl: u32 = 0
            if friss(p, A_ASSIGN) {
                inkl = 1
            }
            let hi: i64 = muster_ganzzahl(p, &gut)
            if !gut {
                return ast.NICHTS
            }
            // Ein leerer Bereich ist ein Fehler (wie in Stufe 0).
            if inkl == 1 {
                if hi < lo {
                    meckern(p)
                    return ast.NICHTS
                }
            } else {
                if hi <= lo {
                    meckern(p)
                    return ast.NICHTS
                }
            }
            return muster.mus_mu_dazu(mn(p), muster.MU_BEREICH, inkl, 0, lo, hi, 0, 0)
        }
        return muster.mus_mu_dazu(mn(p), muster.MU_INT, 0, 0, lo, 0, 0, 0)
    }
    if a == A_IDENT {
        let nr: u32 = nummer(p, 0)
        weiter_bump(p)
        let it: *mut intern.Interner = lexer.lex_namen(lx(p))
        var us: [u8; 1] = "_"
        if intern.intern_gleich(it, nr, (&us[0]) as u64, 1) {
            return muster.mus_mu_dazu(mn(p), muster.MU_WILD, 0, 0, 0, 0, 0, 0)
        }
        if doppelpunkt(p, 0) {
            weiter_bump(p)
            weiter_bump(p)
            return varianten_muster(p, nr, tiefe)
        }
        // Bindung des ganzen Wertes
        lok_dazu(p, nr)
        return muster.mus_mu_dazu(mn(p), muster.MU_BIND, nr, 0, 0, 0, 0, 0)
    }
    if doppelpunkt(p, 0) {
        // `::Variante` — der Aufzaehlungsname fehlt und wird aus dem
        // Subjekttyp bestimmt.
        weiter_bump(p)
        weiter_bump(p)
        return varianten_muster(p, ast.NICHTS, tiefe)
    }
    meckern(p)
    return ast.NICHTS
}

// `Variante(untermuster, ..)` — der Variantenname steht noch an.
fn varianten_muster(p: *mut Parser, ename: u32, tiefe: u32) -> u32 {
    if !ist(p, A_IDENT) {
        meckern(p)
        return ast.NICHTS
    }
    let vname: u32 = nummer(p, 0)
    weiter_bump(p)
    var soff: u32 = 0
    var slen: u32 = 0
    if friss(p, A_LPAREN) {
        var tmp: Vec[u32] = vec_neu[u32]()
        while true {
            if ist(p, A_RPAREN) || am_ende(p) {
                break
            }
            let vor: usize = (*p).pos
            let sub: u32 = muster(p, tiefe + 1)
            if sub == ast.NICHTS {
                break
            }
            vec_push[u32](&tmp, sub)
            if !friss(p, A_COMMA) {
                break
            }
            if (*p).pos == vor {
                weiter_bump(p)
            }
        }
        erwarte(p, A_RPAREN)
        // Erst SAMMELN, dann am Stueck ablegen — die inneren Muster haben
        // ihre eigenen Kinder bereits abgelegt.
        soff = muster.mus_kinder_anfang(mn(p))
        var i: usize = 0
        while i < vec_len[u32](&tmp) {
            muster.mus_kind_dazu(mn(p), vec_at[u32](&tmp, i))
            i = i + 1
        }
        slen = vec_len[u32](&tmp) as u32
        vec_frei[u32](&tmp)
    }
    return muster.mus_mu_dazu(mn(p), muster.MU_VARIANT, ename, vname, 0, 0, soff, slen)
}

// `match subjekt { muster => { .. } .. }` als Anweisung. Wird zum Aufruf
// `__match#<nummer>` ohne Argumente; die Faelle liegen im Muster-Register.
fn match_anweisung(p: *mut Parser) -> u32 {
    weiter_bump(p)
    // `match` in einer generischen Vorlage wird nicht unterstuetzt — die
    // Faelle liegen im Register, eine Vorlage koennte sie nicht je
    // Auspraegung ersetzen (Fehler auch in Stufe 0).
    if hat_gen(p) {
        if mono.gen_in_vorlage(gn(p)) {
            (*p).nicht_kern = true
            meckern(p)
        }
    }
    // Im Subjekt ist kein Structliteral auf oberster Ebene erlaubt —
    // `match X { .. }` liesse sich sonst nicht vom Block unterscheiden.
    let subj: u32 = bed_ausdruck(p)
    if !erwarte(p, A_LBRACE) {
        return ast.anweisung_neu(par_baum(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let mi: u32 = muster.mus_match_dazu(mn(p), subj)
    while true {
        while friss(p, A_COMMA) || friss(p, A_SEMI) {}
        if ist(p, A_RBRACE) || am_ende(p) {
            break
        }
        let vor: usize = (*p).pos
        // Die Bindungen des Musters sind im Rumpf sichtbar — und nur dort.
        lok_auf(p)
        let pat: u32 = muster(p, 0)
        if pat == ast.NICHTS {
            lok_zu(p)
            break
        }
        // `=>` sind zwei Token: `=` und `>`.
        if !(ist(p, A_ASSIGN) && art(p, 1) == A_GT) {
            meckern(p)
            lok_zu(p)
            break
        }
        weiter_bump(p)
        weiter_bump(p)
        if !ist(p, A_LBRACE) {
            meckern(p)
            lok_zu(p)
            break
        }
        let rumpf: u32 = block(p)
        lok_zu(p)
        muster.mus_arm_dazu(mn(p), mi, pat, rumpf)
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    erwarte(p, A_RBRACE)
    if muster.mus_m_alen(mn(p), mi) == 0 {
        meckern(p)
    }
    // Der Aufrufname traegt die Nummer: `__match#<mi>`.
    let it: *mut intern.Interner = lexer.lex_namen(lx(p))
    rt.buf_leeren(&(*p).kladde)
    var pfx: [u8; 8] = "__match#"
    rt.buf_push_bytes(&(*p).kladde, (&pfx[0]) as u64, 8)
    rt.buf_push_dez_u64(&(*p).kladde, mi as u64)
    let name: u32 = intern.intern_nummer(it, rt.buf_ptr(&(*p).kladde),
                                         rt.buf_len(&(*p).kladde)) as u32
    let e: u32 = ast.ausdruck_neu(par_baum(p), ast.E_RUF, name, 0, 0, 0)
    return ast.anweisung_neu(par_baum(p), ast.S_EXPR, e, 0, 0, 0)
}

// Vorabsuche: alle `import`-Aliasse einsammeln, damit `modul.name` von der
// ERSTEN Zeile an erkannt wird. `firnc0` macht dasselbe.
fn module_vorab(p: *mut Parser) {
    var i: usize = 0
    while i + 1 < (*p).n {
        if lexer.lex_art(lx(p), i) == A_KWIMPORT {
            var j: usize = i + 1
            var letzter: u32 = ast.NICHTS
            while j < (*p).n {
                if lexer.lex_art(lx(p), j) != A_IDENT {
                    break
                }
                letzter = lexer.lex_nr(lx(p), j)
                j = j + 1
                if j >= (*p).n {
                    break
                }
                if lexer.lex_art(lx(p), j) != A_DOT {
                    break
                }
                j = j + 1
            }
            if letzter != ast.NICHTS {
                vec_push[u32](&(*p).module, letzter)
            }
        }
        i = i + 1
    }
}

// Vorabsuche nach Erweiterungen, die dieser Parser NICHT kennt.
//
// Besser hier als mitten im Abstieg: so steht vor dem ersten Knoten fest, ob
// die Datei ueberhaupt Kernsprache ist, und der Vergleich zaehlt sie sauber
// als "nicht Kern" statt als Abweichung. Erkannt wird am TOKENSTROM:
//
//   enum · match · error · try · catch · comptime · '#'   Schluesselwoerter
//   '?'                                                    `x.as?[C]`
//   '::'                                                   `Enum::Variante`
//   IDENT '['  nach 'fn'/'struct'   generische Vorlage — NUR NOCH DANN eine
//                                   Erweiterung, wenn kein Vorlagenregister
//                                   angemeldet ist (Runde 31)
//   IDENT '!'                                              Fehlerunion `E!T`
//   der Bezeichner `gc`                                    `gc class`, `gc C{}`
fn erweiterungen_suchen(p: *mut Parser) {
    // Nummer des Bezeichners "gc" — falls er im Text ueberhaupt vorkommt.
    let it: *mut intern.Interner = lexer.lex_namen(lx(p))
    var gc_wort: [u8; 2] = "gc"
    let gc_nr: i64 = intern.intern_finde(it, (&gc_wort[0]) as u64, 2)
    // Die Intrinsics fuer konstante Laufzeit (`ct.rs`, SPEC §9.2/§9.3) sind
    // gewoehnliche Bezeichner, kein Schluesselwort — sie lassen sich nur am
    // NAMEN erkennen. Wer eine eigene Funktion `select` schreibt, faellt hier
    // faelschlich heraus; das ist die vorsichtige Richtung.
    var ct1: [u8; 6] = "select"
    var ct2: [u8; 7] = "barrier"
    var ct3: [u8; 11] = "secure_zero"
    let ct1_nr: i64 = intern.intern_finde(it, (&ct1[0]) as u64, 6)
    let ct2_nr: i64 = intern.intern_finde(it, (&ct2[0]) as u64, 7)
    let ct3_nr: i64 = intern.intern_finde(it, (&ct3[0]) as u64, 11)

    var i: usize = 0
    while i < (*p).n {
        let a: u32 = lexer.lex_art(lx(p), i)
        if a == A_KWENUM || a == A_KWMATCH {
            // Gehoert zur Kernsprache, SOBALD das Muster-Register angemeldet
            // ist — derselbe Uebergang wie bei den generischen Vorlagen
            // (Runde 31).
            if !hat_mu(p) {
                (*p).nicht_kern = true
                return
            }
        }
        if a == A_KWERROR || a == A_KWTRY || a == A_KWCATCH {
            // Gehoert zur Kernsprache, SOBALD die Fehler-Registrierung
            // angemeldet ist — derselbe Uebergang wie bei `enum`/`match`
            // (Runde 32).
            if !hat_fe(p) {
                (*p).nicht_kern = true
                return
            }
        }
        if a == A_KWERRDEFER {
            // `errdefer` laeuft nur auf dem Fehlerpfad — den kennt diese
            // Stufe noch nicht (eigene Runde, eine Datei im Korpus).
            (*p).nicht_kern = true
            return
        }
        if a == A_KWCOMPTIME {
            // RUNDE 35: gehoert zur Kernsprache, sobald `par_zeit_setzen`
            // gelaufen ist — derselbe Uebergang wie Runde 31-33.
            if !hat_zeit(p) {
                (*p).nicht_kern = true
                return
            }
        }
        if a == A_HASH {
            // RUNDE 34: `#[no_gc]` gehoert zur Kernsprache, sobald die
            // gc-Registrierung angemeldet ist — jedes ANDERE Attribut
            // (`#[must_consume]`, ...) bleibt eine nicht portierte
            // Erweiterung, wie bisher.
            var ok_attr: bool = false
            if hat_gc(p) && i + 3 < (*p).n {
                if lexer.lex_art(lx(p), i + 1) == A_LBRACKET && lexer.lex_art(lx(p), i + 3) == A_RBRACKET {
                    if lexer.lex_art(lx(p), i + 2) == A_IDENT {
                        var an: [u8; 5] = "no_gc"
                        ok_attr = intern.intern_gleich(lexer.lex_namen(lx(p)),
                                lexer.lex_nr(lx(p), i + 2), (&an[0]) as u64, 5)
                    }
                }
            }
            if !ok_attr {
                (*p).nicht_kern = true
                return
            }
        }
        if a == A_QUESTION {
            // RUNDE 34: `?` gehoert nur zu `x.as?[C]` — Kern mit Registrierung.
            if !hat_gc(p) {
                (*p).nicht_kern = true
                return
            }
        }
        if a == A_COLON && i + 1 < (*p).n {
            if lexer.lex_art(lx(p), i + 1) == A_COLON {
                if !hat_mu(p) {
                    (*p).nicht_kern = true
                    return
                }
            }
        }
        if a == A_IDENT {
            let nr: i64 = lexer.lex_nr(lx(p), i) as i64
            if gc_nr >= 0 && nr == gc_nr {
                // RUNDE 34: `gc`/`gc class`/`gc C{}` gehoeren zur Kernsprache,
                // sobald die gc-Registrierung angemeldet ist (derselbe
                // Uebergang wie Runde 31-33, 35).
                if !hat_gc(p) {
                    (*p).nicht_kern = true
                    return
                }
            }
            if ct1_nr >= 0 && nr == ct1_nr {
                (*p).nicht_kern = true
                return
            }
            if ct2_nr >= 0 && nr == ct2_nr {
                // RUNDE 34: `barrier(x)` ist die undurchsichtige Sperre aus
                // ct.rs — fuer das Verhalten (und diese Stufe hat keinen
                // Optimierer) ist sie die Identitaet. Sie gehoert zur
                // Kernsprache, sobald die gc-Registrierung angemeldet ist:
                // die braucht sie (tests/modules/dom.fi), und nur der
                // richtige Compiler meldet sie an — die Dump-Werkzeuge
                // bleiben bei "nicht kern", weil ihre Stufe-0-Seite das
                // Undurchsichtige (`Op::Barrier`) druckt.
                if !hat_gc(p) {
                    (*p).nicht_kern = true
                    return
                }
            }
            if ct3_nr >= 0 && nr == ct3_nr {
                (*p).nicht_kern = true
                return
            }
            if i + 1 < (*p).n && lexer.lex_art(lx(p), i + 1) == A_NOT {
                // `E!T` — die Fehlerunion baut auf IDENT `!` auf.
                if !hat_fe(p) {
                    (*p).nicht_kern = true
                    return
                }
            }
            if i > 0 && i + 1 < (*p).n && !hat_gen(p) {
                let vorher: u32 = lexer.lex_art(lx(p), i - 1)
                if vorher == A_KWFN || vorher == A_KWSTRUCT {
                    if lexer.lex_art(lx(p), i + 1) == A_LBRACKET {
                        (*p).nicht_kern = true
                        return
                    }
                }
            }
        }
        i = i + 1
    }
}

// Sammelt die Namen, die diese Datei auf oberster Ebene deklariert. Nur die
// werden umbenannt — eine Verwendung aus einem anderen Modul steht ohnehin
// qualifiziert da.
fn eigene_suchen(p: *mut Parser) {
    if (*p).alias == KEIN {
        return
    }
    var i: usize = 0
    while i + 1 < (*p).n {
        let a: u32 = lexer.lex_art(lx(p), i)
        if a == A_KWFN || a == A_KWSTRUCT || a == A_KWCONST {
            if lexer.lex_art(lx(p), i + 1) == A_IDENT {
                // Eine generische Vorlage behaelt ihren Namen: generische
                // Namen gelten PROGRAMMWEIT und werden unqualifiziert
                // benutzt. Wer sie umbenennt, macht `vec_push[i32](..)` in
                // der Wurzeldatei unauffindbar.
                var generisch: bool = false
                if a != A_KWCONST && i + 2 < (*p).n {
                    generisch = lexer.lex_art(lx(p), i + 2) == A_LBRACKET
                }
                if !generisch {
                    vec_push[u32](&(*p).eigene, lexer.lex_nr(lx(p), i + 1))
                }
            }
        }
        i = i + 1
    }
}

// RUNDE 35: `comptime { ... }` auf oberster Ebene. Der Rumpf ist ein
// gewoehnlicher Block — dieselben Anweisungen, dieselbe lokale
// Namensverdeckung, dieselbe Modul-Umbenennung. Der Block wandert NICHT in
// eine Funktion, sondern als Nummer in `ast.ct_block`; der Interpreter in
// zeit.fi fuehrt ihn vor der Typpruefung aus (Vorbild compiler/src/comptime.rs).
fn comptime_deklaration(p: *mut Parser) {
    weiter_bump(p)
    let b: u32 = block(p)
    ast.ct_dazu(par_baum(p), b)
}

// RUNDE 34: Steht an dieser Stelle `gc class`? (hook_item in gc.rs)
fn ist_gc_class(p: *mut Parser) -> bool {
    if !ist(p, A_IDENT) {
        return false
    }
    var gw: [u8; 2] = "gc"
    let it: *mut intern.Interner = lexer.lex_namen(lx(p))
    if !intern.intern_gleich(it, nummer(p, 0), (&gw[0]) as u64, 2) {
        return false
    }
    if art(p, 1) != A_IDENT {
        return false
    }
    var cw: [u8; 5] = "class"
    return intern.intern_gleich(it, nummer(p, 1), (&cw[0]) as u64, 5)
}

// `#[no_gc]` — das einzige Attribut dieser Stufe. Eine Klammer mit
// Argumenten ist ein Fehler (`no_gc` erwartet 0 Argumente, attrs.rs).
fn attribut(p: *mut Parser) {
    weiter_bump(p)
    if !erwarte(p, A_LBRACKET) {
        return
    }
    if !ist(p, A_IDENT) {
        meckern(p)
        return
    }
    var an: [u8; 5] = "no_gc"
    let it: *mut intern.Interner = lexer.lex_namen(lx(p))
    if !intern.intern_gleich(it, nummer(p, 0), (&an[0]) as u64, 5) {
        meckern(p)
        return
    }
    weiter_bump(p)
    if ist(p, A_LPAREN) {
        meckern(p)
        return
    }
    if !erwarte(p, A_RBRACKET) {
        return
    }
    (*p).nogc_anstehend = 1
}

// `gc class Name [extends Basis] { feld: Typ, ... }` (gc_class_decl in
// gc.rs). Die Klasse geht in die Registrierung (`gc.fi`), NICHT in den
// Baum — Klassennamen gelten programmweit und werden nicht umbenannt.
fn gc_class_deklaration(p: *mut Parser) {
    weiter_bump(p)
    weiter_bump(p)
    if !ist(p, A_IDENT) {
        meckern(p)
        return
    }
    let name: u32 = nummer(p, 0)
    weiter_bump(p)
    var basis: u32 = 0
    if ist(p, A_IDENT) {
        var ew: [u8; 7] = "extends"
        let it: *mut intern.Interner = lexer.lex_namen(lx(p))
        if intern.intern_gleich(it, nummer(p, 0), (&ew[0]) as u64, 7) {
            weiter_bump(p)
            if !ist(p, A_IDENT) {
                meckern(p)
                return
            }
            basis = nummer(p, 0)
            weiter_bump(p)
            if ist(p, A_COMMA) {
                // mehrfachvererbung ist nicht erlaubt (SPEC 4.4)
                meckern(p)
                return
            }
        }
    }
    if !erwarte(p, A_LBRACE) {
        return
    }
    let ki: u32 = gc.gc_klasse_dazu(gr(p), name)
    if ki == KEIN {
        // 'gc class ...' ist bereits deklariert
        meckern(p)
        return
    }
    if basis != 0 {
        gc.gc_basis_setzen(gr(p), ki, basis)
    }
    while true {
        while friss(p, A_COMMA) {}
        if ist(p, A_RBRACE) || am_ende(p) {
            break
        }
        let vor: usize = (*p).pos
        if !ist(p, A_IDENT) {
            meckern(p)
            break
        }
        let fname: u32 = nummer(p, 0)
        weiter_bump(p)
        if !erwarte(p, A_COLON) {
            break
        }
        let ft: u32 = typ(p)
        if ft == ast.NICHTS {
            break
        }
        if !gc.gc_feld_dazu(gr(p), ki, fname, ft) {
            // feld ist bereits deklariert
            meckern(p)
        }
        if !friss(p, A_COMMA) {
            break
        }
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
    erwarte(p, A_RBRACE)
}

fn par_lauf(p: *mut Parser) {
    if hat_gen(p) {
        var so: [u8; 7] = "size_of"
        (*p).sonr = intern.intern_finde(lexer.lex_namen(lx(p)), (&so[0]) as u64, 7)
    }
    erweiterungen_suchen(p)
    eigene_suchen(p)
    if (*p).nicht_kern {
        return
    }
    module_vorab(p)
    while true {
        while friss(p, A_SEMI) {}
        if am_ende(p) {
            break
        }
        if (*p).fehler > 0 {
            break
        }
        let vor: usize = (*p).pos
        let a: u32 = art(p, 0)
        // `#[no_gc]` gehoert vor eine FUNKTION (attrs.rs, Ziel::Funktion).
        if (*p).nogc_anstehend == 1 && a != A_KWFN && a != A_HASH {
            meckern(p)
            (*p).nogc_anstehend = 0
        }
        if a == A_HASH && hat_gc(p) {
            // `#[no_gc]` vor einer Funktion (Runde 34, SPEC 3.5.4). Andere
            // Attribute faengt die Vorabsuche als nicht-Kern ab.
            attribut(p)
        } else if a == A_IDENT && hat_gc(p) && ist_gc_class(p) {
            gc_class_deklaration(p)
        } else if a == A_KWFN {
            fn_deklaration(p)
        } else if a == A_KWSTRUCT {
            struct_deklaration(p)
        } else if a == A_KWENUM && hat_mu(p) {
            enum_deklaration(p)
        } else if a == A_KWERROR && hat_fe(p) {
            error_deklaration(p)
        } else if a == A_KWCOMPTIME && hat_zeit(p) {
            comptime_deklaration(p)
        } else if a == A_KWCONST {
            const_deklaration(p)
        } else if a == A_KWPROFILE {
            profile_deklaration(p)
        } else if a == A_KWIMPORT {
            import_deklaration(p)
        } else if a == A_KWEXPORT {
            export_deklaration(p)
        } else {
            // Alles Uebrige gehoert zu den nicht portierten Erweiterungen
            // (`enum`, `error`, `gc class`, `comptime`, Attribute) oder ist
            // schlicht falsch.
            // Ein BEZEICHNER auf oberster Ebene kann in Stufe 0 nur ein
            // Haken sein — `gc class Name { … }`. Der gehoert wie `enum`,
            // `error`, `comptime` und Attribute zu den nicht portierten
            // Erweiterungen.
            if a == A_KWENUM || a == A_KWERROR || a == A_KWCOMPTIME || a == A_HASH || a == A_IDENT {
                (*p).nicht_kern = true
            }
            meckern(p)
            break
        }
        if (*p).pos == vor {
            weiter_bump(p)
        }
    }
}
