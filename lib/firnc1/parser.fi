// lib/firnc1/parser.fi -- THE PARSER OF FIRN, WRITTEN AS FIRN.
//
// Recursive descent, no generator -- exactly like `compiler/src/parser.rs`.
// It gets built inside `ast.Tree`: nodes over `Vec` indices instead of over
// pointers (docs/SELBSTHOSTING.md section 2.4).
//
// SCOPE: the CORE LANGUAGE. Whatever holds its tree outside of `Program` --
// `enum`/`match`, error unions, generic templates, `gc class`, attributes,
// `comptime` -- is NOT part of it. Those files get counted and skipped inside
// the comparison, not quietly passed over.
//
// LIKEWISE NOT PART OF IT: the error recovery. `firnc0` collects up to
// forty messages and reads on; this parser reports the first one and stops.
// That is honestly less -- and without weight for the comparison, because it
// runs only over sources that `firnc0` reads without errors.
//
// ONE RULE THAT IS EASILY OVERLOOKED: one operator at the START OF THE LINE
// does NOT continue the expression as long as no parenthesis is open (`next()`).
// That is why
//     a
//     - b
// is two statements and no subtraction.

import rt
import vec
import intern
import lexer
import ast
import mono
import pattern
import err
import gc
import iface

export { Parser, par_new, par_new_module, par_free, par_run, par_error, par_tree,
         par_not_core, par_tree_take, par_gen_set, par_mu_set,
         par_fe_set, par_time_set, par_gc_set, par_if_set }

// token kinds out of lexer.fi (the same order as compiler/src/lexer.rs)
// "no value"
const NONE: u32 = 4294967295

const A_INT: u32 = 0
const A_IDENT: u32 = 1
const A_FLOAT: u32 = 2
const A_STR: u32 = 3
const A_KWFN: u32 = 4
const A_KWLET: u32 = 5
const A_KWVAR: u32 = 6
const A_KWIF: u32 = 7
const A_KWELSE: u32 = 8
const A_KWWHILE: u32 = 9
const A_KWRETURN: u32 = 10
const A_KWSTRUCT: u32 = 11
const A_KWCONST: u32 = 12
const A_KWPROFILE: u32 = 13
const A_KWAS: u32 = 14
const A_KWMUT: u32 = 15
const A_KWTRUE: u32 = 16
const A_KWFALSE: u32 = 17
const A_KWSYSCALL: u32 = 18
const A_KWEXTERN: u32 = 19
const A_KWBREAK: u32 = 20
const A_KWCONTINUE: u32 = 21
const A_KWDEFER: u32 = 22
const A_KWERRDEFER: u32 = 23
const A_KWCOMPTIME: u32 = 24
const A_KWFOR: u32 = 25
const A_KWIN: u32 = 26
const A_KWIMPORT: u32 = 27
const A_KWEXPORT: u32 = 28
const A_KWENUM: u32 = 29
const A_KWMATCH: u32 = 30
const A_KWERROR: u32 = 31
const A_KWTRY: u32 = 32
const A_KWCATCH: u32 = 33
const A_LPAREN: u32 = 34
const A_RPAREN: u32 = 35
const A_LBRACE: u32 = 36
const A_RBRACE: u32 = 37
const A_LBRACKET: u32 = 38
const A_RBRACKET: u32 = 39
const A_COMMA: u32 = 40
const A_COLON: u32 = 41
const A_SEMI: u32 = 42
const A_DOT: u32 = 43
const A_DOTDOT: u32 = 44
const A_ARROW: u32 = 45
const A_ASSIGN: u32 = 46
const A_PLUS: u32 = 47
const A_MINUS: u32 = 48
const A_STAR: u32 = 49
const A_SLASH: u32 = 50
const A_PERCENT: u32 = 51
const A_AMP: u32 = 52
const A_PIPE: u32 = 53
const A_CARET: u32 = 54
const A_SHL: u32 = 55
const A_SHR: u32 = 56
const A_ANDAND: u32 = 57
const A_OROR: u32 = 58
const A_NOT: u32 = 59
const A_QUESTION: u32 = 60
const A_HASH: u32 = 61
const A_EQEQ: u32 = 62
const A_NOTEQ: u32 = 63
const A_LT: u32 = 64
const A_LE: u32 = 65
const A_GT: u32 = 66
const A_GE: u32 = 67
const A_EOF: u32 = 68
const A_FSTR: u32 = 69

// binary operators -- the same order as `ast::BinOp`.
const B_ADD: u32 = 0
const B_SUB: u32 = 1
const B_MUL: u32 = 2
const B_DIV: u32 = 3
const B_REM: u32 = 4
const B_AND: u32 = 5
const B_OR: u32 = 6
const B_XOR: u32 = 7
const B_SHL: u32 = 8
const B_SHR: u32 = 9
const B_EQ: u32 = 10
const B_NE: u32 = 11
const B_LT: u32 = 12
const B_LE: u32 = 13
const B_GT: u32 = 14
const B_GE: u32 = 15
const B_LAND: u32 = 16
const B_LOR: u32 = 17

// unary operators
const U_NEG: u32 = 0
const U_NOT: u32 = 1
const U_ADDR: u32 = 2
const U_DEREF: u32 = 3

struct Parser {
    lx: u64,             // pointer to the lexer
    pos: usize,
    n: usize,
    tree: ast.Tree,
    // MODULE SYSTEM. Once `alias` is set, this file does not belong to the root:
    // every identifier that it declares ITSELF at the top gets `alias__` ahead of it.
    // That way all files lie inside ONE tree, without two functions of the
    // same spelling getting into each other's way. `firnc0` does the same inside
    // `modules.rs`, only after the parsing instead of during.
    alias: u32,
    own: Vec[u32],    // top level names declared by this file
    foreign: u64,          // shared tree (0 = its own)
    module: Vec[u32],    // intern numbers of the module aliases (for `module.x`)
    scratch: rt.Buf,      // puts qualified names together
    parens: usize,     // open parentheses (for `next()`)
    no_slit: usize,    // > 0: no struct literal on the top level
    err: usize,
    not_core: bool,    // file uses one extension that is not ported
    // GENERIC TEMPLATES. The store sits OUTSIDE the parser, because it has
    // to be the same across all files of one translation: one
    // root file uses `Vec[i32]`, declared is `Vec[T]` inside some module.
    // 0 = no registry, then generics are one extension that is not ported.
    gen: u64,
    // Registry of the enumerations and pattern matches (round 32). The same
    // construction as `gen`: the store sits outside the parser, because it has
    // to be the same across all files of one translation.
    // 0 = no registry, then `enum`/`match` are not ported.
    mu: u64,
    // Registry of the error sets/unions (round 33). The same construction
    // as `mu`: one store for all files of the translation.
    // 0 = no registry, then `error`/`try`/`catch` are not ported.
    feh: u64,
    // ROUND 35: `comptime { ... }` is registered. No registry outside
    // the tree needed -- the blocks lie as block numbers inside the tree itself
    // (`ast.ct_block`); the interpreter stands inside time.fi. Only the FLAG belongs
    // here, because `extensions_search` has to know before the parsing whether the
    // keyword is core language (the same transition as rounds 31-33).
    time: bool,
    // ROUND 34: registry of the gc classes (`gc.fi`). The same construction as
    // `mu`/`feh`: one store for all files of the translation, because
    // class names hold program wide. 0 = no registry, then
    // `gc class`, `Gc[T]`, `x.as?[C]` and `#[no_gc]` are not ported.
    gcr: u64,
    // ROUND 46: registry of the interfaces (`iface.fi`). The same
    // construction as `gcr`. 0 = no registry; then `interface` blocks get
    // read correctly but not kept -- that suffices for
    // `bin/astdump.fi`, whose yardstick (`ast_canon.rs`) does not print them
    // either.
    ifr: u64,
    // The attribute `#[no_gc]` ahead of the next function declaration.
    nogc_pending: u32,
    // ROUND 52: `#[interrupt]` ahead of the next function (SPEC 2).
    int_pending: u32,
    // The attribute `#[must_consume]` ahead of the next fn/struct declaration
    // (round 36, attrs.rs -- Target::Both).
    mc_pending: u32,
    tpoff: u32,          // start of the running type parameter list
    // Intern number of `size_of`, or -1. `size_of` is NO keyword
    // (sizeof.rs) -- it can be told apart only by its spelling.
    sonr: i64,
    // LOCAL NAMES, as stack of scopes. One parameter or one local
    // variable HIDES one identically spelled entry of the same file.
    local: Vec[u32],
    llimit: Vec[u32],
    // ROUND 39, interpolation: the hidden `let _fsegK_N` of the
    // text segments -- `block` lifts them ahead of the next statement.
    hoist: Vec[u32],
    // > 0: one interpolation runs already -- nesting is not there yet.
    interp: u32,
}

fn par_new(lx: u64) -> Parser {
    var p: Parser = Parser{
        lx: lx, pos: 0, n: 0,
        tree: ast.tree_new(),
        alias: NONE, own: vec_new[u32](), foreign: 0,
        module: vec_new[u32](),
        scratch: rt.buf_new(),
        parens: 0, no_slit: 0, err: 0, not_core: false,
        gen: 0, mu: 0, feh: 0, time: false, gcr: 0, ifr: 0, nogc_pending: 0, int_pending: 0, mc_pending: 0, tpoff: 0, sonr: -1,
        local: vec_new[u32](), llimit: vec_new[u32](),
        hoist: vec_new[u32](), interp: 0,
    }
    p.n = lexer.lex_count(lx as *mut lexer.Lexer)
    return p
}

// Like `par_new`, but into a SHARED tree and with module alias.
// `alias == NONE` means root file (no rewriting).
fn par_new_module(lx: u64, tree: u64, alias: u32) -> Parser {
    var p: Parser = par_new(lx)
    p.foreign = tree
    p.alias = alias
    return p
}

// Register the registry of the generic templates. MUST stand before `par_run`.
fn par_gen_set(p: *mut Parser, g: u64) { (*p).gen = g }

// Register the registry of enumerations/pattern matches. Likewise BEFORE `par_run`.
fn par_mu_set(p: *mut Parser, m: u64) { (*p).mu = m }

// Register the registry of the error unions. Likewise BEFORE `par_run`.
fn par_fe_set(p: *mut Parser, f: u64) { (*p).feh = f }

fn gn(p: *mut Parser) -> *mut mono.Gen { return (*p).gen as *mut mono.Gen }
fn has_gen(p: *mut Parser) -> bool { return (*p).gen != 0 }
fn mn(p: *mut Parser) -> *mut pattern.Pat { return (*p).mu as *mut pattern.Pat }
fn has_mu(p: *mut Parser) -> bool { return (*p).mu != 0 }
fn fh(p: *mut Parser) -> *mut err.Error { return (*p).feh as *mut err.Error }
fn has_fe(p: *mut Parser) -> bool { return (*p).feh != 0 }

// ROUND 35: register `comptime` blocks.
fn par_time_set(p: *mut Parser) { (*p).time = true }
fn has_time(p: *mut Parser) -> bool { return (*p).time }

// ROUND 34: register the gc registry. Likewise BEFORE `par_run`.
fn par_gc_set(p: *mut Parser, g: u64) { (*p).gcr = g }
fn par_if_set(p: *mut Parser, f: u64) { (*p).ifr = f }
fn ifr(p: *mut Parser) -> *mut iface.If { return (*p).ifr as *mut iface.If }
fn has_if(p: *mut Parser) -> bool { return (*p).ifr != 0 }
fn gr(p: *mut Parser) -> *mut gc.Gc { return (*p).gcr as *mut gc.Gc }
fn has_gc(p: *mut Parser) -> bool { return (*p).gcr != 0 }

fn par_tree_take(p: *mut Parser) -> *mut ast.Tree {
    return par_tree(p)
}

fn par_free(p: *mut Parser) {
    // A SHARED tree belongs to the caller.
    if (*p).foreign == 0 {
        ast.tree_free(&(*p).tree)
    }
    vec_free[u32](&(*p).module)
    vec_free[u32](&(*p).own)
    rt.buf_free(&(*p).scratch)
    vec_free[u32](&(*p).local)
    vec_free[u32](&(*p).llimit)
    vec_free[u32](&(*p).hoist)
}

fn par_error(p: *mut Parser) -> usize { return (*p).err }
fn par_tree(p: *mut Parser) -> *mut ast.Tree {
    if (*p).foreign != 0 {
        return (*p).foreign as *mut ast.Tree
    }
    return &(*p).tree
}
fn par_not_core(p: *mut Parser) -> bool { return (*p).not_core }

fn lx(p: *mut Parser) -> *mut lexer.Lexer { return (*p).lx as *mut lexer.Lexer }

// ------------------------------------------------------------- token access

fn kind(p: *mut Parser, k: usize) -> u32 {
    if (*p).pos + k >= (*p).n {
        return A_EOF
    }
    return lexer.lex_kind(lx(p), (*p).pos + k)
}

fn tok_nr(p: *mut Parser, k: usize) -> u32 {
    if (*p).pos + k >= (*p).n {
        return 0
    }
    return lexer.lex_nr(lx(p), (*p).pos + k)
}

fn number(p: *mut Parser) -> u64 {
    if (*p).pos >= (*p).n {
        return 0
    }
    return lexer.lex_number(lx(p), (*p).pos)
}

fn line(p: *mut Parser, i: usize) -> u32 {
    if i >= (*p).n {
        return 0
    }
    return lexer.lex_line(lx(p), i)
}

fn at_end(p: *mut Parser) -> bool { return kind(p, 0) == A_EOF }

fn actual(p: *mut Parser, a: u32) -> bool { return kind(p, 0) == a }

fn next_bump(p: *mut Parser) {
    if (*p).pos < (*p).n {
        (*p).pos = (*p).pos + 1
    }
}

fn eat(p: *mut Parser, a: u32) -> bool {
    if actual(p, a) {
        next_bump(p)
        return true
    }
    return false
}

// Does the current token stand at the START OF THE LINE?
fn line_start(p: *mut Parser) -> bool {
    if (*p).pos == 0 {
        return true
    }
    if (*p).pos >= (*p).n {
        return true
    }
    return line(p, (*p).pos) > line(p, (*p).pos - 1)
}

// May the expression get continued with the current token?
fn next(p: *mut Parser) -> bool {
    return (*p).parens > 0 || !line_start(p)
}

fn complain(p: *mut Parser) {
    (*p).err = (*p).err + 1
}

fn expect(p: *mut Parser, a: u32) -> bool {
    if eat(p, a) {
        return true
    }
    complain(p)
    return false
}

// -------------------------------------------------------------------- names

// Puts two names together with one separator and enters the result.
fn join(p: *mut Parser, a: u32, sep: u64, tn: usize, b: u32) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    rt.buf_clear(&(*p).scratch)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, a), intern.intern_length(it, a))
    rt.buf_push_bytes(&(*p).scratch, sep, tn)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, b), intern.intern_length(it, b))
    return intern.intern_number(it, rt.buf_ptr(&(*p).scratch), rt.buf_len(&(*p).scratch)) as u32
}

// Is `nr` one identifier that THIS file declares at the top?
fn is_own(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).own) {
        if vec_at[u32](&(*p).own, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

// Rewriting of one identifier of this file: `alias__name`. Inside the root file
// everything stays as it is.
// ------------------------------------------------------------- local names
//
// `fn par_new(lx: u64)` inside one file that has `fn lx(..)` too: `lx` inside
// the body is the PARAMETER. Without this list it got `parser__` ahead of it
// while rewriting and was gone -- found only at the self translation inside
// round 31, because before that no module called one parameter like one of its
// own functions. `modules.rs::Renamer` keeps the same list.
//
// ONLY VALUES get hidden. One call `lx(p)` still means the
// function (`Renamer::resolve` with `is_value = false`), and one TYPE
// IDENTIFIER anyway.
fn loc_on(p: *mut Parser) {
    vec_push[u32](&(*p).llimit, vec_len[u32](&(*p).local) as u32)
}

fn loc_off(p: *mut Parser) {
    if vec_len[u32](&(*p).llimit) == 0 {
        return
    }
    let g: u32 = vec_pop[u32](&(*p).llimit)
    while vec_len[u32](&(*p).local) > g as usize {
        vec_pop[u32](&(*p).local)
    }
}

fn loc_add(p: *mut Parser, nr: u32) { vec_push[u32](&(*p).local, nr) }

fn is_local(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).local) {
        if vec_at[u32](&(*p).local, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

fn renamed(p: *mut Parser, nr: u32) -> u32 {
    if (*p).alias == NONE {
        return nr
    }
    if !is_own(p, nr) {
        return nr
    }
    var tr: [u8; 2] = "__"
    return join(p, (*p).alias, (&tr[0]) as u64, 2, nr)
}

// Builds `module.x` and enters it into the interner.
// `module.x` becomes the ONE identifier `module.x` (root operation, so that the
// comparison with `firnc0 --emit=ast-canon` holds) or `module__x`,
// as soon as several files really get translated. Both are the same
// thought: out of two pieces one unambiguous identifier arises.
fn qualify(p: *mut Parser, module: u32, name: u32) -> u32 {
    if (*p).foreign != 0 {
        var tr: [u8; 2] = "__"
        return join(p, module, (&tr[0]) as u64, 2, name)
    }
    var pt: [u8; 1] = "."
    return join(p, module, (&pt[0]) as u64, 1, name)
}

fn is_module(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).module) {
        if vec_at[u32](&(*p).module, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

// The identifier stands there already; should it be one module alias with a `.`
// behind it, `module.member` gets built out of it.
fn renamed_value(p: *mut Parser, nr: u32, value: bool) -> u32 {
    if value {
        if is_local(p, nr) {
            return nr
        }
    }
    return renamed(p, nr)
}

fn maybe_qualified(p: *mut Parser, nr: u32, value: bool) -> u32 {
    if !is_module(p, nr) {
        return renamed_value(p, nr, value)
    }
    if !actual(p, A_DOT) {
        return renamed_value(p, nr, value)
    }
    if kind(p, 1) != A_IDENT {
        return renamed_value(p, nr, value)
    }
    let m: u32 = tok_nr(p, 1)
    next_bump(p)
    next_bump(p)
    return qualify(p, nr, m)
}

// ------------------------------------------------------------- generics
//
// `[T, U: Int]` at the DECLARATION, `[i32, u8]` at the USE. Square
// brackets instead of angled ones, so that `<` stays unambiguously comparison (SPEC 12).

// Type parameter list of one template. The parameters land inside the registry,
// here stands only whether it worked out.
fn ty_param_list(p: *mut Parser) -> bool {
    if !expect(p, A_LBRACKET) {
        return false
    }
    let off: u32 = mono.gen_tp_start(gn(p))
    (*p).tpoff = off
    while true {
        if actual(p, A_RBRACKET) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            return false
        }
        let name: u32 = tok_nr(p, 0)
        next_bump(p)
        if mono.gen_tp_duplicate(gn(p), off, name) {
            complain(p)
            return false
        }
        mono.gen_tp_add(gn(p), name)
        // ROUND 50: `T: A + B + C` -- the bounds stand with `+`
        // one after another and hold ALL at the same time. One unknown identifier
        // is no wrong input but that of one interface;
        // the check happens at the instantiation.
        if eat(p, A_COLON) {
            while true {
                if !actual(p, A_IDENT) {
                    complain(p)
                    return false
                }
                let snr: u32 = tok_nr(p, 0)
                let sa: u32 = mono.gen_bound(gn(p), snr)
                if !mono.gen_tp_bound_add(gn(p), sa, snr) {
                    // the same bound stands there twice
                    complain(p)
                    return false
                }
                next_bump(p)
                if !eat(p, A_PLUS) {
                    break
                }
            }
        }
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    if !expect(p, A_RBRACKET) {
        return false
    }
    if mono.gen_tp_start(gn(p)) == off {
        complain(p)
        return false
    }
    return true
}

// Type arguments at one place of use: `[i32, *mut u8]`.
fn ty_args(p: *mut Parser, out: *mut Vec[u32]) -> bool {
    if !expect(p, A_LBRACKET) {
        return false
    }
    while true {
        if actual(p, A_RBRACKET) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        let t: u32 = ty(p)
        if t == ast.NOTHING {
            return false
        }
        vec_push[u32](out, t)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    if !expect(p, A_RBRACKET) {
        return false
    }
    if vec_len[u32](out) == 0 {
        complain(p)
        return false
    }
    return true
}

// -------------------------------------------------------------------- types

fn ty(p: *mut Parser) -> u32 {
    if actual(p, A_STAR) {
        next_bump(p)
        var m: u64 = 0
        if eat(p, A_KWMUT) {
            m = 1
        }
        let inner: u32 = ty(p)
        if inner == ast.NOTHING {
            return ast.NOTHING
        }
        return ast.ty_new(par_tree(p), ast.T_PTR, inner, m)
    }
    if actual(p, A_LBRACKET) {
        next_bump(p)
        let elem: u32 = ty(p)
        if elem == ast.NOTHING {
            return ast.NOTHING
        }
        if !expect(p, A_SEMI) {
            return ast.NOTHING
        }
        if !actual(p, A_INT) {
            complain(p)
            return ast.NOTHING
        }
        let len: u64 = number(p)
        next_bump(p)
        if !expect(p, A_RBRACKET) {
            return ast.NOTHING
        }
        return ast.ty_new(par_tree(p), ast.T_ARR, elem, len)
    }
    if actual(p, A_IDENT) {
        let nr: u32 = tok_nr(p, 0)
        next_bump(p)
        // ROUND 34 (gc.rs::hook_type): `Gc[C]` and `GcWeak[C]`. The identifier
        // stands as placeholder `__gc#p:C` / `__gc#w:C` inside the tree; resolved
        // it gets only inside the type resolution. Class names hold
        // program wide -- NO module rewriting.
        if has_gc(p) && actual(p, A_LBRACKET) {
            var kind_nr: u32 = 0
            var g1: [u8; 2] = "Gc"
            var g2: [u8; 6] = "GcWeak"
            let it2: *mut intern.Interner = lexer.lex_names(lx(p))
            if intern.intern_equal(it2, nr, (&g1[0]) as u64, 2) {
                kind_nr = 1
            }
            if intern.intern_equal(it2, nr, (&g2[0]) as u64, 6) {
                kind_nr = 2
            }
            // ROUND 53 (gc.rs::hook_type): `GcVec[E]` and `GcMap[K,V]`.
            // Both are pointers to the runtime classes `GcVec`/`GcMap`
            // (lib/gc/gcvec.fi, lib/gc/gcmap.fi) -- `GcVec[Gc[Node]]` is
            // therefore exactly `Gc[GcVec]`. The type arguments get parsed
            // COMPLETELY (one typo shall stand out) and after that discarded:
            // stage 0 has no generic `gc class`, the element type gets checked
            // at the access, not at the container.
            var g3: [u8; 5] = "GcVec"
            var g4: [u8; 5] = "GcMap"
            if intern.intern_equal(it2, nr, (&g3[0]) as u64, 5) {
                kind_nr = 3
            }
            if intern.intern_equal(it2, nr, (&g4[0]) as u64, 5) {
                kind_nr = 4
            }
            if kind_nr == 3 || kind_nr == 4 {
                next_bump(p)
                var arg_count: u32 = 0
                var next: bool = true
                while next {
                    let ta: u32 = ty(p)
                    if ta == ast.NOTHING {
                        return ast.NOTHING
                    }
                    arg_count = arg_count + 1
                    if actual(p, A_COMMA) {
                        next_bump(p)
                    } else {
                        next = false
                    }
                }
                var should: u32 = 1
                if kind_nr == 4 {
                    should = 2
                }
                if arg_count != should {
                    complain(p)
                    return ast.NOTHING
                }
                if !expect(p, A_RBRACKET) {
                    return ast.NOTHING
                }
                rt.buf_clear(&(*p).scratch)
                var px5: [u8; 7] = "__gc#p:"
                rt.buf_push_bytes(&(*p).scratch, (&px5[0]) as u64, 7)
                if kind_nr == 3 {
                    rt.buf_push_bytes(&(*p).scratch, (&g3[0]) as u64, 5)
                } else {
                    rt.buf_push_bytes(&(*p).scratch, (&g4[0]) as u64, 5)
                }
                let pn5: u32 = intern.intern_number(it2, rt.buf_ptr(&(*p).scratch),
                                                    rt.buf_len(&(*p).scratch)) as u32
                return ast.ty_new(par_tree(p), ast.T_NAME, pn5, 0)
            }
            if kind_nr != 0 {
                next_bump(p)
                if !actual(p, A_IDENT) {
                    complain(p)
                    return ast.NOTHING
                }
                let kn: u32 = tok_nr(p, 0)
                next_bump(p)
                if !expect(p, A_RBRACKET) {
                    return ast.NOTHING
                }
                rt.buf_clear(&(*p).scratch)
                if kind_nr == 1 {
                    var px1: [u8; 7] = "__gc#p:"
                    rt.buf_push_bytes(&(*p).scratch, (&px1[0]) as u64, 7)
                } else {
                    var px2: [u8; 7] = "__gc#w:"
                    rt.buf_push_bytes(&(*p).scratch, (&px2[0]) as u64, 7)
                }
                rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it2, kn),
                                  intern.intern_length(it2, kn))
                let pn: u32 = intern.intern_number(it2, rt.buf_ptr(&(*p).scratch),
                                                   rt.buf_len(&(*p).scratch)) as u32
                return ast.ty_new(par_tree(p), ast.T_NAME, pn, 0)
            }
        }
        // `E!T` -- one error union (errors.rs::hook_type). The parser puts
        // the entry into the registry and one placeholder `__eu#<n>`
        // into the tree; the type checker resolves it later on. The
        // order counts: `!` stands BEFORE the `[` of the generics, exactly
        // as at stage 0 (`hook_type` before `hook_generic_type`).
        if has_fe(p) && actual(p, A_NOT) {
            next_bump(p)
            let inner: u32 = ty(p)
            if inner == ast.NOTHING {
                return ast.NOTHING
            }
            let pi: u32 = err.error_pending_add(fh(p), nr, inner)
            let it: *mut intern.Interner = lexer.lex_names(lx(p))
            rt.buf_clear(&(*p).scratch)
            var eu: [u8; 5] = "__eu#"
            rt.buf_push_bytes(&(*p).scratch, (&eu[0]) as u64, 5)
            rt.buf_push_dec_u64(&(*p).scratch, pi as u64)
            let pn: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                               rt.buf_len(&(*p).scratch)) as u32
            return ast.ty_new(par_tree(p), ast.T_NAME, pn, 0)
        }
        // One `[` behind one type identifier is one generic instantiation.
        if actual(p, A_LBRACKET) {
            var generic: bool = false
            if has_gen(p) {
                generic = mono.gen_is_struct(gn(p), nr)
            }
            if !generic {
                (*p).not_core = true
                complain(p)
                return ast.NOTHING
            }
            var targs: Vec[u32] = vec_new[u32]()
            let ok: bool = ty_args(p, &targs)
            if !ok {
                vec_free[u32](&targs)
                return ast.NOTHING
            }
            let m: u32 = mono.gen_instance(gn(p), nr, &targs, false)
            vec_free[u32](&targs)
            return ast.ty_new(par_tree(p), ast.T_NAME, m, 0)
        }
        // ROUND 46 (iface.rs::hook_type): `dyn I` -- the interface value.
        // It becomes ONE identifier with a blank; the type resolution
        // settles it later on. Interface names hold program wide
        // and do NOT get rewritten.
        var dw: [u8; 3] = "dyn"
        let itd: *mut intern.Interner = lexer.lex_names(lx(p))
        if intern.intern_equal(itd, nr, (&dw[0]) as u64, 3) && actual(p, A_IDENT) {
            let inr: u32 = tok_nr(p, 0)
            next_bump(p)
            rt.buf_clear(&(*p).scratch)
            var dw2: [u8; 4] = "dyn "
            rt.buf_push_bytes(&(*p).scratch, (&dw2[0]) as u64, 4)
            rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(itd, inr),
                              intern.intern_length(itd, inr))
            let dn: u32 = intern.intern_number(itd, rt.buf_ptr(&(*p).scratch),
                                               rt.buf_len(&(*p).scratch)) as u32
            return ast.ty_new(par_tree(p), ast.T_NAME, dn, 0)
        }
        let q: u32 = maybe_qualified(p, nr, false)
        return ast.ty_new(par_tree(p), ast.T_NAME, q, 0)
    }
    complain(p)
    return ast.NOTHING
}

// -------------------------------------------------------------- expressions

fn expr(p: *mut Parser) -> u32 {
    var e: u32 = or_expr(p)
    // `expr catch fallback` or `expr catch |f| fallback` -- binds
    // WEAKER than every operator and is left associative; the fallback
    // is one or expression (errors.rs::hook_catch). The tree holds one
    // call `__catch#` with two arguments; the binding lies inside the
    // registry.
    if has_fe(p) {
        while actual(p, A_KWCATCH) {
            next_bump(p)
            var bind: u32 = NONE
            if actual(p, A_PIPE) {
                next_bump(p)
                if !actual(p, A_IDENT) {
                    complain(p)
                    return e
                }
                bind = tok_nr(p, 0)
                next_bump(p)
                if !expect(p, A_PIPE) {
                    return e
                }
            }
            // The binding is one LOCAL identifier -- visible only inside the
            // fallback and left out of the module rewriting (like the binding
            // of one pattern, round 32).
            if bind != NONE {
                loc_on(p)
                loc_add(p, bind)
            }
            let rhs: u32 = or_expr(p)
            if bind != NONE {
                loc_off(p)
            }
            var tmp: Vec[u32] = vec_new[u32]()
            vec_push[u32](&tmp, e)
            vec_push[u32](&tmp, rhs)
            let off: u32 = list_store(p, &tmp)
            vec_free[u32](&tmp)
            var cn: [u8; 8] = "__catch#"
            let it: *mut intern.Interner = lexer.lex_names(lx(p))
            let name: u32 = intern.intern_number(it, (&cn[0]) as u64, 8) as u32
            e = ast.expr_new(par_tree(p), ast.E_CALL, name, off, 2, 0)
            if bind != NONE {
                err.error_cb_set(fh(p), e, bind)
            }
        }
    }
    return e
}

// Expression without struct literal on the top level (conditions).
fn cond_expr(p: *mut Parser) -> u32 {
    (*p).no_slit = (*p).no_slit + 1
    let e: u32 = expr(p)
    (*p).no_slit = (*p).no_slit - 1
    return e
}

// Expression inside parentheses/arguments: struct literals are allowed there.
fn inner_expr(p: *mut Parser) -> u32 {
    let remembered: usize = (*p).no_slit
    (*p).no_slit = 0
    (*p).parens = (*p).parens + 1
    let e: u32 = expr(p)
    (*p).parens = (*p).parens - 1
    (*p).no_slit = remembered
    return e
}

fn or_expr(p: *mut Parser) -> u32 {
    var left: u32 = and_expr(p)
    while actual(p, A_OROR) && next(p) {
        next_bump(p)
        let right: u32 = and_expr(p)
        left = ast.expr_new(par_tree(p), ast.E_BIN, B_LOR, left, right, 0)
    }
    return left
}

fn and_expr(p: *mut Parser) -> u32 {
    var left: u32 = cmp_expr(p)
    while actual(p, A_ANDAND) && next(p) {
        next_bump(p)
        let right: u32 = cmp_expr(p)
        left = ast.expr_new(par_tree(p), ast.E_BIN, B_LAND, left, right, 0)
    }
    return left
}

// -1 = no comparison operator
fn cmp_op(a: u32) -> i32 {
    if a == A_EQEQ { return B_EQ as i32 }
    if a == A_NOTEQ { return B_NE as i32 }
    if a == A_LT { return B_LT as i32 }
    if a == A_LE { return B_LE as i32 }
    if a == A_GT { return B_GT as i32 }
    if a == A_GE { return B_GE as i32 }
    return -1
}

// Comparisons are NOT associative (SPEC 10.1: exactly one comparison).
fn cmp_expr(p: *mut Parser) -> u32 {
    let left: u32 = add_expr(p)
    let op: i32 = cmp_op(kind(p, 0))
    if op < 0 || !next(p) {
        return left
    }
    next_bump(p)
    let right: u32 = add_expr(p)
    var e: u32 = ast.expr_new(par_tree(p), ast.E_BIN, op as u32, left, right, 0)
    while cmp_op(kind(p, 0)) >= 0 && next(p) {
        complain(p)
        let op2: i32 = cmp_op(kind(p, 0))
        next_bump(p)
        let r2: u32 = add_expr(p)
        e = ast.expr_new(par_tree(p), ast.E_BIN, op2 as u32, e, r2, 0)
    }
    return e
}

fn add_op(a: u32) -> i32 {
    if a == A_PLUS { return B_ADD as i32 }
    if a == A_MINUS { return B_SUB as i32 }
    if a == A_PIPE { return B_OR as i32 }
    if a == A_CARET { return B_XOR as i32 }
    return -1
}

fn add_expr(p: *mut Parser) -> u32 {
    var left: u32 = mul_expr(p)
    while add_op(kind(p, 0)) >= 0 && next(p) {
        let op: i32 = add_op(kind(p, 0))
        next_bump(p)
        let right: u32 = mul_expr(p)
        left = ast.expr_new(par_tree(p), ast.E_BIN, op as u32, left, right, 0)
    }
    return left
}

fn mul_op(a: u32) -> i32 {
    if a == A_STAR { return B_MUL as i32 }
    if a == A_SLASH { return B_DIV as i32 }
    if a == A_PERCENT { return B_REM as i32 }
    if a == A_AMP { return B_AND as i32 }
    if a == A_SHL { return B_SHL as i32 }
    if a == A_SHR { return B_SHR as i32 }
    return -1
}

fn mul_expr(p: *mut Parser) -> u32 {
    var left: u32 = un_expr(p)
    while mul_op(kind(p, 0)) >= 0 && next(p) {
        let op: i32 = mul_op(kind(p, 0))
        next_bump(p)
        let right: u32 = un_expr(p)
        left = ast.expr_new(par_tree(p), ast.E_BIN, op as u32, left, right, 0)
    }
    return left
}

fn un_expr(p: *mut Parser) -> u32 {
    let a: u32 = kind(p, 0)
    var op: i32 = -1
    if a == A_MINUS { op = U_NEG as i32 }
    else if a == A_NOT { op = U_NOT as i32 }
    else if a == A_AMP { op = U_ADDR as i32 }
    else if a == A_STAR { op = U_DEREF as i32 }
    if op < 0 {
        return after_expr(p)
    }
    next_bump(p)
    let inner: u32 = un_expr(p)
    return ast.expr_new(par_tree(p), ast.E_UN, op as u32, inner, 0, 0)
}

// COLLECT the helper list first, then put it into `children` as one piece.
//
// The obvious way -- append every argument right away -- is wrong as soon as
// one argument itself holds one call: its arguments then land
// RIGHT INTO the outer list. Exactly that happened at the first run; out of
// `f(a, g(b))` came `f(a, b, g(b))`. Child lists have to be contiguous,
// so the inner list gets finished first.
fn list_store(p: *mut Parser, tmp: *mut Vec[u32]) -> u32 {
    let off: u32 = ast.child_start(par_tree(p))
    var i: usize = 0
    while i < vec_len[u32](tmp) {
        ast.child_add(par_tree(p), vec_at[u32](tmp, i))
        i = i + 1
    }
    return off
}

// Argument list after one '(' consumed already. The arguments come into one
// SCRATCH BUFFER and wander into `children` only as one piece -- one nested
// call would otherwise put its own list right between (the same lesson as inside
// `list_store`). At the method call the receiver stands inside it already.
fn call_args_in(p: *mut Parser, tmp: *mut Vec[u32]) {
    while true {
        if actual(p, A_RPAREN) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        let e: u32 = inner_expr(p)
        vec_push[u32](tmp, e)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RPAREN)
}

fn call_args(p: *mut Parser) -> u32 {
    var tmp: Vec[u32] = vec_new[u32]()
    call_args_in(p, &tmp)
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    return off
}

// ROUND 45 (impls.rs): `"method " ++ <ident>` -- the call label of one method call
// that is not resolved yet. The blank turns it into one identifier that
// can arise from no source text identifier.
fn method_call_name(p: *mut Parser, nr: u32) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    rt.buf_clear(&(*p).scratch)
    var w: [u8; 7] = "method "
    rt.buf_push_bytes(&(*p).scratch, (&w[0]) as u64, 7)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, nr),
                      intern.intern_length(it, nr))
    return intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                rt.buf_len(&(*p).scratch)) as u32
}

fn after_expr(p: *mut Parser) -> u32 {
    var e: u32 = basic_expr(p)
    while true {
        if !next(p) {
            return e
        }
        let a: u32 = kind(p, 0)
        if a == A_DOT {
            next_bump(p)
            // ROUND 34 (gc.rs::hook_postfix): `x.as?[C]` -- the checked
            // downward conversion. Inside the tree one call `__gc#as:C`.
            if has_gc(p) && actual(p, A_KWAS) && kind(p, 1) == A_QUESTION {
                next_bump(p)
                next_bump(p)
                if !expect(p, A_LBRACKET) {
                    return e
                }
                if !actual(p, A_IDENT) {
                    complain(p)
                    return e
                }
                let kn: u32 = tok_nr(p, 0)
                next_bump(p)
                if !expect(p, A_RBRACKET) {
                    return e
                }
                let it4: *mut intern.Interner = lexer.lex_names(lx(p))
                rt.buf_clear(&(*p).scratch)
                var px5: [u8; 8] = "__gc#as:"
                rt.buf_push_bytes(&(*p).scratch, (&px5[0]) as u64, 8)
                rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it4, kn),
                                  intern.intern_length(it4, kn))
                let an: u32 = intern.intern_number(it4, rt.buf_ptr(&(*p).scratch),
                                                   rt.buf_len(&(*p).scratch)) as u32
                var tmp4: Vec[u32] = vec_new[u32]()
                vec_push[u32](&tmp4, e)
                let off4: u32 = list_store(p, &tmp4)
                vec_free[u32](&tmp4)
                e = ast.expr_new(par_tree(p), ast.E_CALL, an, off4, 1, 0)
                continue
            }
            if !actual(p, A_IDENT) {
                complain(p)
                return e
            }
            let nr: u32 = tok_nr(p, 0)
            next_bump(p)
            // ROUND 45 (impls.rs::hook_method_call): should one parenthesis
            // follow, it is one METHOD CALL. The receiver becomes the first
            // argument; which function is meant gets settled only by the
            // type checker out of its type.
            // The parenthesis has to stand on the SAME line (`next`) -- otherwise
            // the next statement starting with `(` would be one
            // method call of the field access ahead of it.
            if next(p) && actual(p, A_LPAREN) {
                next_bump(p)
                var mtmp: Vec[u32] = vec_new[u32]()
                vec_push[u32](&mtmp, e)
                call_args_in(p, &mtmp)
                let mname: u32 = method_call_name(p, nr)
                let mlaen: u32 = vec_len[u32](&mtmp) as u32
                let moff: u32 = list_store(p, &mtmp)
                vec_free[u32](&mtmp)
                e = ast.expr_new(par_tree(p), ast.E_CALL, mname, moff, mlaen, 0)
                continue
            }
            e = ast.expr_new(par_tree(p), ast.E_FIELD, e, nr, 0, 0)
        } else if a == A_LBRACKET {
            // `sum[i32](a, b)` -- call of one generic template. That is
            // the only spot where `[` behind one expression does NOT mean
            // indexing; the IDENTIFIER settles it.
            var template: bool = false
            if has_gen(p) && ast.e_kind(par_tree(p), e) == ast.E_ID {
                template = mono.gen_is_fn(gn(p), ast.e_a(par_tree(p), e))
            }
            if template {
                let base: u32 = ast.e_a(par_tree(p), e)
                var targs: Vec[u32] = vec_new[u32]()
                let ok: bool = ty_args(p, &targs)
                if !ok {
                    vec_free[u32](&targs)
                    return e
                }
                let m: u32 = mono.gen_instance(gn(p), base, &targs, true)
                vec_free[u32](&targs)
                if !expect(p, A_LPAREN) {
                    return e
                }
                let off: u32 = call_args(p)
                let len: u32 = ast.child_count(par_tree(p)) - off
                e = ast.expr_new(par_tree(p), ast.E_CALL, m, off, len, 0)
            } else {
                next_bump(p)
                let idx: u32 = inner_expr(p)
                expect(p, A_RBRACKET)
                e = ast.expr_new(par_tree(p), ast.E_IDX, e, idx, 0, 0)
            }
        } else if a == A_LPAREN {
            // Only direct function names can be called (stage 0).
            if ast.e_kind(par_tree(p), e) != ast.E_ID {
                complain(p)
                return e
            }
            let name: u32 = ast.e_a(par_tree(p), e)
            next_bump(p)
            let off: u32 = call_args(p)
            let len: u32 = ast.child_count(par_tree(p)) - off
            e = ast.expr_new(par_tree(p), ast.E_CALL, name, off, len, 0)
        } else if a == A_KWAS {
            next_bump(p)
            let t: u32 = ty(p)
            if t == ast.NOTHING {
                return e
            }
            e = ast.expr_new(par_tree(p), ast.E_AS, e, t, 0, 0)
        } else {
            return e
        }
    }
    return e
}

// `Type{ field: value, ... }` -- '{' still stands there.
fn struct_literal(p: *mut Parser, name: u32) -> u32 {
    next_bump(p)
    var tmp: Vec[u32] = vec_new[u32]()
    while true {
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let value: u32 = inner_expr(p)
        vec_push[u32](&tmp, fname)
        vec_push[u32](&tmp, value)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    let len: u32 = vec_len[u32](&tmp) as u32 / 2
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    return ast.expr_new(par_tree(p), ast.E_SLIT, name, off, len, 0)
}

// One string literal becomes one ARRAY LITERAL of integers --
// just as inside `firnc0`. With that the type is `[u8; N]` or `[u16; N]`, and
// type checker and lowering need nothing of their own. The construction reads out of
// the lexer handed over, so that the interpolation reuses it for its text
// segments (round 39).
fn alit_out_lit(p: *mut Parser, lx2: *mut lexer.Lexer, k: usize) -> u32 {
    let la: u32 = lexer.lex_lit_kind(lx2, k)
    let n: usize = lexer.lex_lit_len(lx2, k)
    var tmp: Vec[u32] = vec_new[u32]()
    var i: usize = 0
    while i < n {
        var w: u64 = 0
        if la == 2 {
            w = lexer.lex_lit_unit(lx2, k, i) as u64
        } else {
            w = lexer.lex_lit_byte(lx2, k, i) as u64
        }
        vec_push[u32](&tmp, ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, w))
        i = i + 1
    }
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    return ast.expr_new(par_tree(p), ast.E_ALIT, 0, off, n as u32, 0)
}

// -------------------------------------------------------- inline assembly
//
// ROUND 52 (compiler/src/core.rs). Grammar:
//
//   asm_expr     = "asm" "(" str_lit { "," asm_op } ")" ;
//   asm_op       = "in"      "(" str_lit ")" expr
//                | "out"     "(" str_lit ")"
//                | "clobber" "(" str_lit ")" ;
//
// The tree keeps one call `asm$<number>` with the INPUT EXPRESSIONS as
// arguments; template, registers and clobbers lie inside the tree registry
// (`ast.asm_add`). Exactly this split is what `firnc0` has too -- that is why
// `--emit=ast-canon` prints the same text on both sides.

// String literal at the current spot as interned number.
fn lit_intern(p: *mut Parser) -> u32 {
    let k: usize = tok_nr(p, 0) as usize
    let n: usize = lexer.lex_lit_len(lx(p), k)
    rt.buf_clear(&(*p).scratch)
    var i: usize = 0
    while i < n {
        rt.buf_push(&(*p).scratch, lexer.lex_lit_byte(lx(p), k, i))
        i = i + 1
    }
    next_bump(p)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    return intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                rt.buf_len(&(*p).scratch)) as u32
}

fn asm_block(p: *mut Parser) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    next_bump(p)
    next_bump(p)
    let template: u32 = lit_intern(p)
    var out: u32 = ast.NOTHING
    var regs: Vec[u32] = vec_new[u32]()
    var clobs: Vec[u32] = vec_new[u32]()
    var args: Vec[u32] = vec_new[u32]()
    var ow: [u8; 3] = "out"
    var cw: [u8; 7] = "clobber"
    while eat(p, A_COMMA) {
        if actual(p, A_RPAREN) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        var which: u32 = 3
        if actual(p, A_KWIN) {
            next_bump(p)
            which = 0
        } else if actual(p, A_IDENT) && intern.intern_equal(it, tok_nr(p, 0), (&ow[0]) as u64, 3) {
            next_bump(p)
            which = 1
        } else if actual(p, A_IDENT) && intern.intern_equal(it, tok_nr(p, 0), (&cw[0]) as u64, 7) {
            next_bump(p)
            which = 2
        }
        if which == 3 {
            complain(p)
            break
        }
        if !expect(p, A_LPAREN) {
            break
        }
        if !actual(p, A_STR) {
            complain(p)
            break
        }
        let reg: u32 = lit_intern(p)
        if !expect(p, A_RPAREN) {
            break
        }
        if which == 0 {
            vec_push[u32](&regs, reg)
            vec_push[u32](&args, inner_expr(p))
        } else if which == 1 {
            if out != ast.NOTHING {
                complain(p)
            }
            out = reg
        } else {
            vec_push[u32](&clobs, reg)
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RPAREN)
    let blk: u32 = ast.asm_add(par_tree(p), template, out, &regs, &clobs)
    vec_free[u32](&regs)
    vec_free[u32](&clobs)
    rt.buf_clear(&(*p).scratch)
    var pw: [u8; 4] = "asm$"
    rt.buf_push_bytes(&(*p).scratch, (&pw[0]) as u64, 4)
    rt.buf_push_dec_u64(&(*p).scratch, blk as u64)
    let name: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                         rt.buf_len(&(*p).scratch)) as u32
    let off: u32 = list_store(p, &args)
    let len: u32 = vec_len[u32](&args) as u32
    vec_free[u32](&args)
    return ast.expr_new(par_tree(p), ast.E_CALL, name, off, len, 0)
}

fn text_literal(p: *mut Parser) -> u32 {
    let k: usize = tok_nr(p, 0) as usize
    let n: usize = lexer.lex_lit_len(lx(p), k)
    next_bump(p)
    if n == 0 {
        complain(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    return alit_out_lit(p, lx(p), k)
}

// ------------------------------------------------------------ interpolation
//
// `f"..."` (round 39): the parser splits the body up AT COMPILE TIME
// into one call chain onto the Fmt builder out of `std.io` -- no varargs,
// no parsing at run time. The same translation as inside firnc0
// (`parser.rs::interpolation`): out of `f"x = {x}!"` comes
// `io.fmt_text(io.fmt_number(io.fmt_text(io.fmt_new(), &_fseg0_0[0], 6),
//                       (x) as i64), &_fseg0_1[0], 1)`.
// The text segments get lifted ahead of the surrounding statement as hidden
// `let _fsegK_N: [u8; N]` (`block` empties `hoist`). Whoever writes `f"..."`
// needs `import std.io`.

// Identifier of one hidden text segment: `_fseg<node count>`. `firnc0`
// numbers with its `ExprId` (`_fseg{next_id}`); the node count of the
// shared tree is the same figure here -- that way the canonical
// trees of both compilers stay character identical (tools/parser_compare.sh).
fn interp_seg_name(p: *mut Parser, state: usize) -> u32 {
    var b: rt.Buf = rt.buf_new()
    defer rt.buf_free(&b)
    var t: [u8; 5] = "_fseg"
    rt.buf_push_bytes(&b, (&t[0]) as u64, 5)
    rt.buf_push_dec_u64(&b, state as u64)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    return intern.intern_number(it, rt.buf_ptr(&b), rt.buf_len(&b)) as u32
}

// One text segment: lex `"` + body + `"` anew (the decoding is
// by construction the same as with one handwritten literal), register it as
// hidden `let _fsegK_N: [u8; N]` and hang
// `io.fmt_text(chain, &_fsegK_N[0] as u64, N)` onto the chain.
fn interp_text(p: *mut Parser, chain: u32, io_nr: u32, k: usize, of: usize, to: usize) -> u32 {
    var source: rt.Buf = rt.buf_new()
    defer rt.buf_free(&source)
    rt.buf_push(&source, 34 as u8)
    var i: usize = of
    while i < to {
        rt.buf_push(&source, lexer.lex_lit_byte(lx(p), k, i))
        i = i + 1
    }
    rt.buf_push(&source, 34 as u8)
    var dname: [u8; 9] = "<segment>"
    var l2: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&source), rt.buf_len(&source),
        lexer.lex_kw_ptr(lx(p)), lexer.lex_kw_len(lx(p)), (&dname[0]) as u64, 9)
    lexer.lex_names_set(&l2, lexer.lex_names(lx(p)) as u64)
    lexer.lex_run(&l2)
    if lexer.lex_error(&l2) > 0 {
        complain(p)
        lexer.lex_free(&l2)
        return chain
    }
    let state: usize = vec_len[u32](&(*par_tree(p)).e_kind)
    let alit: u32 = alit_out_lit(p, (&l2) as *mut lexer.Lexer, 0)
    lexer.lex_free(&l2)
    let elen: u32 = ast.e_c(par_tree(p), alit)
    if elen == 0 {
        return chain
    }
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let seg_name: u32 = interp_seg_name(p, state)
    var u8t: [u8; 2] = "u8"
    let u8nr: u32 = intern.intern_number(it, (&u8t[0]) as u64, 2) as u32
    let u8typ: u32 = ast.ty_new(par_tree(p), ast.T_NAME, u8nr, 0)
    let arrtyp: u32 = ast.ty_new(par_tree(p), ast.T_ARR, u8typ, elen as u64)
    let var_s: u32 = ast.stmt_new(par_tree(p), ast.S_LET, seg_name, arrtyp, alit, 0)
    vec_push[u32](&(*p).hoist, var_s)
    let id: u32 = ast.expr_new(par_tree(p), ast.E_ID, seg_name, 0, 0, 0)
    let null: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    let idx: u32 = ast.expr_new(par_tree(p), ast.E_IDX, id, null, 0, 0)
    let addr: u32 = ast.expr_new(par_tree(p), ast.E_UN, U_ADDR, idx, 0, 0)
    var u64t: [u8; 3] = "u64"
    let u64nr: u32 = intern.intern_number(it, (&u64t[0]) as u64, 3) as u32
    let u64typ: u32 = ast.ty_new(par_tree(p), ast.T_NAME, u64nr, 0)
    let ptr: u32 = ast.expr_new(par_tree(p), ast.E_AS, addr, u64typ, 0, 0)
    let len: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, elen as u64)
    var ft: [u8; 8] = "fmt_text"
    let text_nr: u32 = qualify(p, io_nr, intern.intern_number(it, (&ft[0]) as u64, 8) as u32)
    let aoff: u32 = ast.child_start(par_tree(p))
    ast.child_add(par_tree(p), chain)
    ast.child_add(par_tree(p), ptr)
    ast.child_add(par_tree(p), len)
    return ast.expr_new(par_tree(p), ast.E_CALL, text_nr, aoff, 3, 0)
}

// One expression segment: lex the fragment anew, parse ONE expression out of
// it with one parser copy (the same tree, the same registries, the same
// intern table, the same local names) and hang it onto the chain as
// `io.fmt_number(chain, (expr) as i64)`.
fn interp_expr(p: *mut Parser, chain: u32, io_nr: u32, k: usize, of: usize, to: usize) -> u32 {
    var source: rt.Buf = rt.buf_new()
    defer rt.buf_free(&source)
    var i: usize = of
    while i < to {
        rt.buf_push(&source, lexer.lex_lit_byte(lx(p), k, i))
        i = i + 1
    }
    var dname: [u8; 12] = "<expression>"
    var l2: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&source), rt.buf_len(&source),
        lexer.lex_kw_ptr(lx(p)), lexer.lex_kw_len(lx(p)), (&dname[0]) as u64, 12)
    lexer.lex_names_set(&l2, lexer.lex_names(lx(p)) as u64)
    lexer.lex_run(&l2)
    if lexer.lex_error(&l2) > 0 {
        complain(p)
        lexer.lex_free(&l2)
        return chain
    }
    // The copy shares everything that expressions need (tree, registries,
    // modules, local names); `interp = 1` blocks the nesting.
    // The tree gets shared OVER `foreign`: at root operation (foreign == 0,
    // the dump tools) `par_tree` would otherwise point onto the TREE COPY of the
    // copy -- the expression nodes would land inside the stack frame and would be
    // dead after the return (segfault inside astdump on `f"{x}"`).
    var sub: Parser = (*p)
    sub.foreign = par_tree(p) as u64
    sub.lx = (&l2) as u64
    sub.pos = 0
    sub.n = lexer.lex_count(&l2)
    sub.parens = 0
    sub.no_slit = 0
    sub.interp = 1
    let e: u32 = inner_expr(&sub)
    (*p).err = sub.err
    if sub.not_core {
        (*p).not_core = true
    }
    let whole: bool = actual(&sub, A_EOF)
    lexer.lex_free(&l2)
    if !whole {
        complain(p)
        return chain
    }
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    var i64t: [u8; 3] = "i64"
    let i64nr: u32 = intern.intern_number(it, (&i64t[0]) as u64, 3) as u32
    let i64typ: u32 = ast.ty_new(par_tree(p), ast.T_NAME, i64nr, 0)
    let cast: u32 = ast.expr_new(par_tree(p), ast.E_AS, e, i64typ, 0, 0)
    var fz: [u8; 10] = "fmt_number"
    let number_nr: u32 = qualify(p, io_nr, intern.intern_number(it, (&fz[0]) as u64, 10) as u32)
    let aoff: u32 = ast.child_start(par_tree(p))
    ast.child_add(par_tree(p), chain)
    ast.child_add(par_tree(p), cast)
    return ast.expr_new(par_tree(p), ast.E_CALL, number_nr, aoff, 2, 0)
}

fn interpolation(p: *mut Parser) -> u32 {
    let k: usize = tok_nr(p, 0) as usize
    let n: usize = lexer.lex_lit_len(lx(p), k)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if (*p).interp > 0 {
        // One f"..." inside the expression of one f"..." -- not yet (round 39).
        complain(p)
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    var io_t: [u8; 2] = "io"
    let io_nr: u32 = intern.intern_number(it, (&io_t[0]) as u64, 2) as u32
    if !is_module(p, io_nr) {
        // Without `import std.io` the building blocks do not exist -- the same
        // state as with one handwritten `io.` without import.
        complain(p)
    }
    var fn_t: [u8; 7] = "fmt_new"
    let new_nr: u32 = qualify(p, io_nr, intern.intern_number(it, (&fn_t[0]) as u64, 7) as u32)
    var chain: u32 = ast.expr_new(par_tree(p), ast.E_CALL, new_nr, ast.child_start(par_tree(p)), 0, 0)
    var i: usize = 0
    var text_of: usize = 0
    while i < n {
        let b: u32 = lexer.lex_lit_byte(lx(p), k, i) as u32
        if b == 125 {
            // '}' without '{'
            complain(p)
            break
        }
        if b == 92 {
            // escaping belongs to the text segment
            i = i + 2
            continue
        }
        if b != 123 {
            i = i + 1
            continue
        }
        if i > text_of {
            chain = interp_text(p, chain, io_nr, k, text_of, i)
        }
        var j: usize = i + 1
        var closed: bool = false
        while j < n {
            let b2: u32 = lexer.lex_lit_byte(lx(p), k, j) as u32
            if b2 == 123 {
                // '{' inside the expression -- core version: no nesting
                complain(p)
                break
            }
            if b2 == 125 {
                closed = true
                break
            }
            j = j + 1
        }
        if !closed {
            complain(p)
            break
        }
        chain = interp_expr(p, chain, io_nr, k, i + 1, j)
        i = j + 1
        text_of = i
    }
    if text_of < n {
        chain = interp_text(p, chain, io_nr, k, text_of, n)
    }
    next_bump(p)
    return chain
}

// `size_of[TypeName]()` -- `size_of` is read, `[` stands there.
//
// DELIBERATELY ONLY ONE TYPE IDENTIFIER, no full type expression: like `sizeof.rs`.
fn size_of_expr(p: *mut Parser) -> u32 {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    let tn: u32 = tok_nr(p, 0)
    next_bump(p)
    if !expect(p, A_RBRACKET) {
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    if !expect(p, A_LPAREN) {
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    if !expect(p, A_RPAREN) {
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    let t: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tn, 0)
    let name: u32 = mono.gen_size_of_name(gn(p), t)
    return ast.expr_new(par_tree(p), ast.E_CALL, name, 0, 0, (t as u64) + 1)
}

fn basic_expr(p: *mut Parser) -> u32 {
    let a: u32 = kind(p, 0)
    // `try expr` -- the operand is one UNARY expression, the call
    // is called `__try#` (errors.rs::hook_primary, TRY_NAME).
    if a == A_KWTRY && has_fe(p) {
        next_bump(p)
        let inner: u32 = un_expr(p)
        let off: u32 = ast.child_start(par_tree(p))
        ast.child_add(par_tree(p), inner)
        var tn: [u8; 6] = "__try#"
        let it: *mut intern.Interner = lexer.lex_names(lx(p))
        let name: u32 = intern.intern_number(it, (&tn[0]) as u64, 6) as u32
        return ast.expr_new(par_tree(p), ast.E_CALL, name, off, 1, 0)
    }
    if a == A_INT {
        let v: u64 = number(p)
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, v)
    }
    if a == A_FLOAT {
        let v: u64 = number(p)
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_FLOAT, 0, 0, 0, v)
    }
    if a == A_STR {
        return text_literal(p)
    }
    if a == A_FSTR {
        return interpolation(p)
    }
    if a == A_KWTRUE {
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_BOOL, 1, 0, 0, 0)
    }
    if a == A_KWFALSE {
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_BOOL, 0, 0, 0, 0)
    }
    if a == A_LPAREN {
        next_bump(p)
        let e: u32 = inner_expr(p)
        expect(p, A_RPAREN)
        return e
    }
    if a == A_LBRACKET {
        next_bump(p)
        var tmp: Vec[u32] = vec_new[u32]()
        var done: bool = false
        if !actual(p, A_RBRACKET) && !at_end(p) {
            let first: u32 = inner_expr(p)
            if actual(p, A_SEMI) {
                next_bump(p)
                let count: u32 = inner_expr(p)
                expect(p, A_RBRACKET)
                vec_free[u32](&tmp)
                return ast.expr_new(par_tree(p), ast.E_AWDH, first, count, 0, 0)
            }
            vec_push[u32](&tmp, first)
            if !eat(p, A_COMMA) {
                expect(p, A_RBRACKET)
                done = true
            }
        }
        while !done {
            if actual(p, A_RBRACKET) || at_end(p) {
                break
            }
            let before: usize = (*p).pos
            let e: u32 = inner_expr(p)
            vec_push[u32](&tmp, e)
            if !eat(p, A_COMMA) {
                break
            }
            if (*p).pos == before {
                next_bump(p)
            }
        }
        if !done {
            expect(p, A_RBRACKET)
        }
        let len: u32 = vec_len[u32](&tmp) as u32
        let off: u32 = list_store(p, &tmp)
        vec_free[u32](&tmp)
        return ast.expr_new(par_tree(p), ast.E_ALIT, 0, off, len, 0)
    }
    if a == A_KWSYSCALL {
        next_bump(p)
        expect(p, A_LPAREN)
        let off: u32 = call_args(p)
        let len: u32 = ast.child_count(par_tree(p)) - off
        return ast.expr_new(par_tree(p), ast.E_SYSCALL, 0, off, len, 0)
    }
    if a == A_IDENT {
        // ROUND 52 (core.rs::hook_primary): `asm("...", in("dx") p, out("rax"),
        // clobber("memory"))`. ONLY when `asm` is followed directly by `(` and one
        // string literal -- otherwise `asm` stays one ordinary
        // identifier and there is no new keyword.
        var asmw: [u8; 3] = "asm"
        let is_asm: bool = intern.intern_equal(lexer.lex_names(lx(p)), tok_nr(p, 0), (&asmw[0]) as u64, 3)
        if is_asm && kind(p, 1) == A_LPAREN && kind(p, 2) == A_STR {
            return asm_block(p)
        }
        let nr: u32 = tok_nr(p, 0)
        next_bump(p)
        // ROUND 34 (gc.rs::hook_primary): `gc C{ ... }`, `gc_null[C]()` and
        // `weak_null[C]()`.
        if has_gc(p) {
            let it3: *mut intern.Interner = lexer.lex_names(lx(p))
            var gw2: [u8; 2] = "gc"
            if intern.intern_equal(it3, nr, (&gw2[0]) as u64, 2) {
                if actual(p, A_IDENT) && kind(p, 1) == A_LBRACE {
                    var cw2: [u8; 5] = "class"
                    if !intern.intern_equal(it3, tok_nr(p, 0), (&cw2[0]) as u64, 5) {
                        let kn: u32 = tok_nr(p, 0)
                        next_bump(p)
                        // "gc C" -- with a blank, can never be one identifier
                        // of the source text.
                        var tr2: [u8; 1] = " "
                        let whole: u32 = join(p, nr, (&tr2[0]) as u64, 1, kn)
                        // no_slit does not hold here: the parenthesis belongs to the
                        // allocation, not to the control structure.
                        let lit: u32 = struct_literal(p, whole)
                        var tmp2: Vec[u32] = vec_new[u32]()
                        vec_push[u32](&tmp2, lit)
                        let off2: u32 = list_store(p, &tmp2)
                        vec_free[u32](&tmp2)
                        return ast.expr_new(par_tree(p), ast.E_CALL, whole, off2, 1, 0)
                    }
                }
            }
            var gn1: [u8; 7] = "gc_null"
            var gn2: [u8; 9] = "weak_null"
            let is_gnull: bool = intern.intern_equal(it3, nr, (&gn1[0]) as u64, 7)
            let is_wnull: bool = intern.intern_equal(it3, nr, (&gn2[0]) as u64, 9)
            if (is_gnull || is_wnull) && actual(p, A_LBRACKET) {
                next_bump(p)
                if !actual(p, A_IDENT) {
                    complain(p)
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                let kn: u32 = tok_nr(p, 0)
                next_bump(p)
                if !expect(p, A_RBRACKET) {
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                if !expect(p, A_LPAREN) {
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                if !expect(p, A_RPAREN) {
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                if is_gnull {
                    // `0 as Gc[C]` -- the null value is the null pointer.
                    rt.buf_clear(&(*p).scratch)
                    var px3: [u8; 7] = "__gc#p:"
                    rt.buf_push_bytes(&(*p).scratch, (&px3[0]) as u64, 7)
                    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it3, kn),
                                      intern.intern_length(it3, kn))
                    let tn: u32 = intern.intern_number(it3, rt.buf_ptr(&(*p).scratch),
                                                       rt.buf_len(&(*p).scratch)) as u32
                    let tn2: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tn, 0)
                    let null: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                    return ast.expr_new(par_tree(p), ast.E_AS, null, tn2, 0, 0)
                }
                // `GcWeak[C]{ __p: 0, __s: 0 }` -- the empty weak reference.
                rt.buf_clear(&(*p).scratch)
                var px4: [u8; 7] = "GcWeak["
                rt.buf_push_bytes(&(*p).scratch, (&px4[0]) as u64, 7)
                rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it3, kn),
                                  intern.intern_length(it3, kn))
                rt.buf_push(&(*p).scratch, 93 as u8)
                let wn: u32 = intern.intern_number(it3, rt.buf_ptr(&(*p).scratch),
                                                   rt.buf_len(&(*p).scratch)) as u32
                var wp2: [u8; 3] = "__p"
                var ws2: [u8; 3] = "__s"
                let wp_n: u32 = intern.intern_number(it3, (&wp2[0]) as u64, 3) as u32
                let ws_n: u32 = intern.intern_number(it3, (&ws2[0]) as u64, 3) as u32
                let n1: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                let n2: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                var tmp3: Vec[u32] = vec_new[u32]()
                vec_push[u32](&tmp3, wp_n)
                vec_push[u32](&tmp3, n1)
                vec_push[u32](&tmp3, ws_n)
                vec_push[u32](&tmp3, n2)
                let off3: u32 = list_store(p, &tmp3)
                vec_free[u32](&tmp3)
                return ast.expr_new(par_tree(p), ast.E_SLIT, wn, off3, 2, 0)
            }
        }
        // `size_of[T]()` -- the type text wanders into the CALL LABEL
        // (`size_of$i32`, sizeof.rs), the type node additionally onto
        // `e_number`; resolved both get only inside the type checker, which knows
        // the struct table.
        if (*p).sonr >= 0 && nr as i64 == (*p).sonr && actual(p, A_LBRACKET) {
            return size_of_expr(p)
        }
        // `Vec[i32]{ ... }` -- literal of one generic structure.
        var gstruct: bool = false
        if has_gen(p) && actual(p, A_LBRACKET) {
            gstruct = mono.gen_is_struct(gn(p), nr)
        }
        if gstruct {
            var targs: Vec[u32] = vec_new[u32]()
            let ok: bool = ty_args(p, &targs)
            if !ok {
                vec_free[u32](&targs)
                return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
            }
            let m: u32 = mono.gen_instance(gn(p), nr, &targs, false)
            vec_free[u32](&targs)
            if actual(p, A_LBRACE) && (*p).no_slit == 0 {
                return struct_literal(p, m)
            }
            complain(p)
            return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
        }
        // `Enum::Variant(..)` -- the enumeration constructor. Recognized by the
        // FORM (`IDENT :: IDENT`), not by one registry -- exactly like
        // `sema_match.rs::hook_primary`. `::` are TWO colon tokens;
        // one token of its own does not exist.
        if actual(p, A_COLON) && kind(p, 1) == A_COLON {
            if !has_mu(p) {
                (*p).not_core = true
                complain(p)
                return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
            }
            next_bump(p)
            next_bump(p)
            if !actual(p, A_IDENT) {
                complain(p)
                return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
            }
            let vn: u32 = tok_nr(p, 0)
            next_bump(p)
            // The complete `Enum::Variant` becomes ONE identifier. NO
            // rewriting: enumeration names hold program wide (SPEC 14.1).
            var dp: [u8; 2] = "::"
            let full: u32 = join(p, nr, (&dp[0]) as u64, 2, vn)
            var aoff: u32 = 0
            var alen: u32 = 0
            if actual(p, A_LPAREN) {
                next_bump(p)
                aoff = call_args(p)
                alen = ast.child_count(par_tree(p)) - aoff
            }
            return ast.expr_new(par_tree(p), ast.E_CALL, full, aoff, alen, 0)
        }
        // Should `(` stand there, it is one CALL LABEL -- one local variable
        // does not hide that (`Renamer::resolve`, is_value = false).
        let q: u32 = maybe_qualified(p, nr, !actual(p, A_LPAREN))
        if actual(p, A_LBRACE) && (*p).no_slit == 0 {
            return struct_literal(p, q)
        }
        return ast.expr_new(par_tree(p), ast.E_ID, q, 0, 0, 0)
    }
    complain(p)
    next_bump(p)
    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
}

// --------------------------------------------------------------- statements

// Statement end: ';' or line change or '}'.
fn end_stmt(p: *mut Parser) {
    var had: bool = false
    while actual(p, A_SEMI) {
        next_bump(p)
        had = true
    }
    if had || actual(p, A_RBRACE) || at_end(p) || line_start(p) {
        return
    }
    complain(p)
}

fn block(p: *mut Parser) -> u32 {
    if !expect(p, A_LBRACE) {
        return ast.block_new(par_tree(p), 0, 0)
    }
    loc_on(p)
    // The statement numbers get collected first and put into `slist` only
    // at the end -- nested blocks would otherwise cut between them.
    var own: Vec[u32] = vec_new[u32]()
    while true {
        if actual(p, A_RBRACE) {
            break
        }
        if at_end(p) {
            complain(p)
            break
        }
        if eat(p, A_SEMI) {
            continue
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        let s: u32 = stmt(p)
        // Hidden text segments of the interpolation stand AHEAD of the
        // statement that holds their interpolation (round 39).
        var hi: usize = 0
        while hi < vec_len[u32](&(*p).hoist) {
            vec_push[u32](&own, vec_at[u32](&(*p).hoist, hi))
            hi = hi + 1
        }
        vec_clear[u32](&(*p).hoist)
        vec_push[u32](&own, s)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    eat(p, A_RBRACE)
    let off: u32 = vec_len[u32](&(*par_tree(p)).slist) as u32
    var i: usize = 0
    while i < vec_len[u32](&own) {
        vec_push[u32](&(*par_tree(p)).slist, vec_at[u32](&own, i))
        i = i + 1
    }
    let len: u32 = vec_len[u32](&own) as u32
    vec_free[u32](&own)
    loc_off(p)
    return ast.block_new(par_tree(p), off, len)
}

fn let_stmt(p: *mut Parser) -> u32 {
    var kind_s: u32 = ast.S_LET
    if actual(p, A_KWVAR) {
        kind_s = ast.S_VAR
    }
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    var t: u32 = ast.NOTHING
    if eat(p, A_COLON) {
        t = ty(p)
        if t == ast.NOTHING {
            return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
        }
    }
    if !expect(p, A_ASSIGN) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let init: u32 = expr(p)
    end_stmt(p)
    // Visible ONLY FROM NOW ON: `let x = x + 1` means the outer `x` on the right.
    loc_add(p, name)
    return ast.stmt_new(par_tree(p), kind_s, name, t, init, 0)
}

fn if_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    let cond: u32 = cond_expr(p)
    let then: u32 = block(p)
    var els: u32 = ast.NOTHING
    if actual(p, A_KWELSE) {
        next_bump(p)
        if actual(p, A_KWIF) {
            els = stmt(p)
        } else {
            let b: u32 = block(p)
            els = ast.stmt_new(par_tree(p), ast.S_BLOCK, b, 0, 0, 0)
        }
    }
    return ast.stmt_new(par_tree(p), ast.S_IF, cond, then, els, 0)
}

fn while_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    let cond: u32 = cond_expr(p)
    let body: u32 = block(p)
    return ast.stmt_new(par_tree(p), ast.S_WHILE, cond, body, 0, 0)
}

fn for_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    if !expect(p, A_KWIN) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let of: u32 = cond_expr(p)
    if !expect(p, A_DOTDOT) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let to: u32 = cond_expr(p)
    loc_on(p)
    loc_add(p, name)
    let body: u32 = block(p)
    loc_off(p)
    return ast.stmt_new(par_tree(p), ast.S_FOR, name, of, to, body)
}

fn return_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    var value: u32 = ast.NOTHING
    var has: bool = true
    if actual(p, A_SEMI) || actual(p, A_RBRACE) || at_end(p) || line_start(p) {
        has = false
    }
    if has {
        value = expr(p)
    }
    end_stmt(p)
    return ast.stmt_new(par_tree(p), ast.S_RET, value, 0, 0, 0)
}

fn stmt(p: *mut Parser) -> u32 {
    let a: u32 = kind(p, 0)
    if a == A_KWLET || a == A_KWVAR {
        return let_stmt(p)
    }
    if a == A_KWIF {
        return if_stmt(p)
    }
    if a == A_KWWHILE {
        return while_stmt(p)
    }
    if a == A_KWFOR {
        return for_stmt(p)
    }
    if a == A_KWBREAK {
        next_bump(p)
        end_stmt(p)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    if a == A_KWCONTINUE {
        next_bump(p)
        end_stmt(p)
        return ast.stmt_new(par_tree(p), ast.S_CONT, 0, 0, 0, 0)
    }
    if a == A_KWDEFER || a == A_KWERRDEFER {
        var kind_s: u32 = ast.S_DEFER
        if a == A_KWERRDEFER {
            kind_s = ast.S_ERRDEFER
        }
        next_bump(p)
        let inner: u32 = stmt(p)
        return ast.stmt_new(par_tree(p), kind_s, inner, 0, 0, 0)
    }
    if a == A_KWRETURN {
        return return_stmt(p)
    }
    if a == A_LBRACE {
        let b: u32 = block(p)
        return ast.stmt_new(par_tree(p), ast.S_BLOCK, b, 0, 0, 0)
    }
    if a == A_KWMATCH {
        if !has_mu(p) {
            (*p).not_core = true
            complain(p)
            return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
        }
        return match_stmt(p)
    }
    if a == A_KWCATCH {
        // `catch` never stands at the start of one statement -- one ordinary
        // syntax error, as at stage 0. (`try` falls into the expression way.)
        complain(p)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let e: u32 = expr(p)
    if actual(p, A_ASSIGN) {
        next_bump(p)
        let v: u32 = expr(p)
        end_stmt(p)
        return ast.stmt_new(par_tree(p), ast.S_ZUW, e, v, 0, 0)
    }
    end_stmt(p)
    return ast.stmt_new(par_tree(p), ast.S_EXPR, e, 0, 0, 0)
}

// --------------------------------------------------------------- declarations

fn param_list(p: *mut Parser) -> u32 {
    let off: u32 = vec_len[u32](&(*par_tree(p)).pa_name) as u32
    while true {
        if actual(p, A_RPAREN) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let name: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let t: u32 = ty(p)
        if t == ast.NOTHING {
            break
        }
        ast.param_add(par_tree(p), name, t)
        loc_add(p, name)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    return off
}

// `fn IDENT[T: Int](..) -> R { .. }`
//
// THE IDENTIFIER STAYS UNCHANGED, inside one module too: generic names hold
// program wide and get used unqualified (`vec_push[i32](..)`).
// That is why `own_search` does not take them into the rewriting list either.
//
// The template does NOT go into the function list of the tree -- the type
// checker would otherwise trip over `T` and `--emit=ast-canon` would print it,
// which `firnc0` does not do. Its nodes do stand inside the tree; kept are only
// the entry points.
fn fn_template(p: *mut Parser, name: u32) {
    if !ty_param_list(p) {
        return
    }
    let toff: u32 = (*p).tpoff
    let tlen: u32 = mono.gen_tp_start(gn(p)) - toff
    if !expect(p, A_LPAREN) {
        return
    }
    // While the body runs, all instantiations are ABSTRACT: `Vec[T]` is
    // no work yet but one rule.
    mono.gen_depth_on(gn(p))
    loc_on(p)
    let poff: u32 = param_list(p)
    expect(p, A_RPAREN)
    let plen: u32 = ast.param_start(par_tree(p)) - poff
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            loc_off(p)
            mono.gen_depth_off(gn(p))
            return
        }
    }
    let body: u32 = block(p)
    loc_off(p)
    mono.gen_depth_off(gn(p))
    mono.gen_fn_template(gn(p), name, toff, tlen, poff, plen, ret, body)
}

// `struct IDENT[T] { field: T, .. }`
fn struct_template(p: *mut Parser, name: u32) {
    if !ty_param_list(p) {
        return
    }
    let toff: u32 = (*p).tpoff
    let tlen: u32 = mono.gen_tp_start(gn(p)) - toff
    if !expect(p, A_LBRACE) {
        return
    }
    mono.gen_depth_on(gn(p))
    let off: u32 = ast.field_start(par_tree(p))
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let t: u32 = ty(p)
        if t == ast.NOTHING {
            break
        }
        ast.field_add(par_tree(p), fname, t)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    mono.gen_depth_off(gn(p))
    let flen: u32 = ast.field_start(par_tree(p)) - off
    mono.gen_struct_template(gn(p), name, toff, tlen, off, flen)
}

fn fn_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let raw: u32 = tok_nr(p, 0)
    next_bump(p)
    // One type parameter list turns it into one generic TEMPLATE.
    if actual(p, A_LBRACKET) {
        if !has_gen(p) {
            (*p).not_core = true
            complain(p)
            return
        }
        fn_template(p, raw)
        return
    }
    let name: u32 = renamed(p, raw)
    if !expect(p, A_LPAREN) {
        return
    }
    loc_on(p)
    let poff: u32 = param_list(p)
    expect(p, A_RPAREN)
    let plen: u32 = vec_len[u32](&(*par_tree(p)).pa_name) as u32 - poff
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            loc_off(p)
            return
        }
    }
    let body: u32 = block(p)
    loc_off(p)
    ast.fn_add(par_tree(p), name, poff, plen, ret, body, (*p).nogc_pending,
                (*p).mc_pending, (*p).int_pending)
    (*p).nogc_pending = 0
    (*p).mc_pending = 0
    (*p).int_pending = 0
}

fn struct_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let raw: u32 = tok_nr(p, 0)
    next_bump(p)
    if actual(p, A_LBRACKET) {
        if !has_gen(p) {
            (*p).not_core = true
            complain(p)
            return
        }
        struct_template(p, raw)
        return
    }
    let name: u32 = renamed(p, raw)
    if !expect(p, A_LBRACE) {
        return
    }
    let off: u32 = vec_len[u32](&(*par_tree(p)).fd_name) as u32
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let t: u32 = ty(p)
        if t == ast.NOTHING {
            break
        }
        ast.field_add(par_tree(p), fname, t)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    let len: u32 = vec_len[u32](&(*par_tree(p)).fd_name) as u32 - off
    ast.structure_add(par_tree(p), name, off, len, (*p).mc_pending)
    (*p).mc_pending = 0
}

fn const_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let name: u32 = renamed(p, tok_nr(p, 0))
    next_bump(p)
    if !expect(p, A_COLON) {
        return
    }
    let t: u32 = ty(p)
    if t == ast.NOTHING {
        return
    }
    if !expect(p, A_ASSIGN) {
        return
    }
    let w: u32 = expr(p)
    end_stmt(p)
    ast.const_add(par_tree(p), name, t, w)
}

fn import_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    rt.buf_clear(&(*p).scratch)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    var last: u32 = tok_nr(p, 0)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, last), intern.intern_length(it, last))
    next_bump(p)
    while actual(p, A_DOT) && kind(p, 1) == A_IDENT {
        next_bump(p)
        last = tok_nr(p, 0)
        rt.buf_push(&(*p).scratch, 46 as u8)
        rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, last), intern.intern_length(it, last))
        next_bump(p)
    }
    let path: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch), rt.buf_len(&(*p).scratch)) as u32
    ast.imp_add(par_tree(p), path, last)
    vec_push[u32](&(*p).module, last)
    end_stmt(p)
}

fn export_decl(p: *mut Parser) {
    next_bump(p)
    if !expect(p, A_LBRACE) {
        return
    }
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        ast.exp_add(par_tree(p), tok_nr(p, 0))
        next_bump(p)
    }
    expect(p, A_RBRACE)
}

fn profile_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    ast.profile_set(par_tree(p), tok_nr(p, 0))
    next_bump(p)
    end_stmt(p)
}

// ------------------------------------------------------ enum and match
//
// Port of the parser hooks out of `sema_match.rs`. The ARMS of one `match`
// do NOT stand inside the tree but inside the pattern registry (`pattern.fi`); the
// tree keeps one call `__match#<number>` without arguments. That way one
// generic template can replace the arms per instantiation too -- and
// `--emit=ast-canon` prints exactly what stage 0 prints.

// `::` are two colon tokens following each other directly.
fn colon(p: *mut Parser, k: usize) -> bool {
    return kind(p, k) == A_COLON && kind(p, k + 1) == A_COLON
}

// `enum IDENT { A, B(i32), C(Point, bool) }`
fn enum_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    // NO rewriting: enumeration names hold program wide (SPEC 14.1).
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    if !expect(p, A_LBRACE) {
        return
    }
    let ei: u32 = pattern.pat_enum_add(mn(p), name)
    while true {
        while eat(p, A_COMMA) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let vname: u32 = tok_nr(p, 0)
        next_bump(p)
        let toff: u32 = pattern.pat_vt_start(mn(p))
        var tlen: u32 = 0
        if eat(p, A_LPAREN) {
            while true {
                if actual(p, A_RPAREN) || at_end(p) {
                    break
                }
                let vor2: usize = (*p).pos
                let t: u32 = ty(p)
                if t == ast.NOTHING {
                    break
                }
                pattern.pat_vt_add(mn(p), t)
                tlen = tlen + 1
                if !eat(p, A_COMMA) {
                    break
                }
                if (*p).pos == vor2 {
                    next_bump(p)
                }
            }
            expect(p, A_RPAREN)
        }
        pattern.pat_variant_add(mn(p), ei, vname, toff, tlen)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    if pattern.pat_e_vlen(mn(p), ei) == 0 {
        // One enumeration without a variant counts as error (as at stage 0).
        complain(p)
    }
}

// `error IDENT { A, B, C }` -- one error set (errors.rs::errors_decl).
// NO rewriting of the identifier: error sets hold program wide, exactly like
// enumeration names (SPEC 14.1). Codes from 1 by order of declaration.
fn error_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    if !expect(p, A_LBRACE) {
        return
    }
    let mi: u32 = err.error_set_add(fh(p), name)
    if mi == NONE {
        // error set is declared already
        complain(p)
    }
    var n: u32 = 0
    while true {
        while eat(p, A_COMMA) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let vn: u32 = tok_nr(p, 0)
        next_bump(p)
        // One variant declared twice counts as error (as at stage 0).
        if mi != NONE {
            if !err.error_variant_add(fh(p), mi, vn) {
                complain(p)
            }
        }
        n = n + 1
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    if n == 0 {
        // One error set without a variant counts as error (as at stage 0).
        complain(p)
    }
}

// Integer inside one pattern, optionally with sign.
fn pattern_int(p: *mut Parser, good: *mut bool) -> i64 {
    var neg: bool = false
    if eat(p, A_MINUS) {
        neg = true
    }
    if !actual(p, A_INT) {
        complain(p)
        *good = false
        return 0
    }
    let v: u64 = number(p)
    next_bump(p)
    if neg {
        return 0 - (v as i64)
    }
    return v as i64
}

// One pattern (SPEC 6.3). Bindings get registered as local names right
// away -- the body of the arm gets parsed afterwards and has to see them.
fn pattern(p: *mut Parser, depth: u32) -> u32 {
    if depth > 32 {
        complain(p)
        return ast.NOTHING
    }
    let a: u32 = kind(p, 0)
    if a == A_KWTRUE {
        next_bump(p)
        return pattern.pat_mu_add(mn(p), pattern.MU_BOOL, 1, 0, 0, 0, 0, 0)
    }
    if a == A_KWFALSE {
        next_bump(p)
        return pattern.pat_mu_add(mn(p), pattern.MU_BOOL, 0, 0, 0, 0, 0, 0)
    }
    if a == A_INT || a == A_MINUS {
        var good: bool = true
        let lo: i64 = pattern_int(p, &good)
        if !good {
            return ast.NOTHING
        }
        if actual(p, A_DOTDOT) {
            next_bump(p)
            var incl: u32 = 0
            if eat(p, A_ASSIGN) {
                incl = 1
            }
            let hi: i64 = pattern_int(p, &good)
            if !good {
                return ast.NOTHING
            }
            // One empty range counts as error (as at stage 0).
            if incl == 1 {
                if hi < lo {
                    complain(p)
                    return ast.NOTHING
                }
            } else {
                if hi <= lo {
                    complain(p)
                    return ast.NOTHING
                }
            }
            return pattern.pat_mu_add(mn(p), pattern.MU_RANGE, incl, 0, lo, hi, 0, 0)
        }
        return pattern.pat_mu_add(mn(p), pattern.MU_INT, 0, 0, lo, 0, 0, 0)
    }
    if a == A_IDENT {
        let nr: u32 = tok_nr(p, 0)
        next_bump(p)
        let it: *mut intern.Interner = lexer.lex_names(lx(p))
        var us: [u8; 1] = "_"
        if intern.intern_equal(it, nr, (&us[0]) as u64, 1) {
            return pattern.pat_mu_add(mn(p), pattern.MU_WILD, 0, 0, 0, 0, 0, 0)
        }
        if colon(p, 0) {
            next_bump(p)
            next_bump(p)
            return variants_pattern(p, nr, depth)
        }
        // binding of the whole value
        loc_add(p, nr)
        return pattern.pat_mu_add(mn(p), pattern.MU_BIND, nr, 0, 0, 0, 0, 0)
    }
    if colon(p, 0) {
        // `::Variant` -- the enumeration part is missing and gets settled
        // out of the subject type.
        next_bump(p)
        next_bump(p)
        return variants_pattern(p, ast.NOTHING, depth)
    }
    complain(p)
    return ast.NOTHING
}

// `Variant(subpattern, ..)` -- the variant identifier still stands there.
fn variants_pattern(p: *mut Parser, ename: u32, depth: u32) -> u32 {
    if !actual(p, A_IDENT) {
        complain(p)
        return ast.NOTHING
    }
    let vname: u32 = tok_nr(p, 0)
    next_bump(p)
    var soff: u32 = 0
    var slen: u32 = 0
    if eat(p, A_LPAREN) {
        var tmp: Vec[u32] = vec_new[u32]()
        while true {
            if actual(p, A_RPAREN) || at_end(p) {
                break
            }
            let before: usize = (*p).pos
            let sub: u32 = pattern(p, depth + 1)
            if sub == ast.NOTHING {
                break
            }
            vec_push[u32](&tmp, sub)
            if !eat(p, A_COMMA) {
                break
            }
            if (*p).pos == before {
                next_bump(p)
            }
        }
        expect(p, A_RPAREN)
        // COLLECT first, then store as one piece -- the inner patterns have
        // stored their own children already.
        soff = pattern.pat_children_start(mn(p))
        var i: usize = 0
        while i < vec_len[u32](&tmp) {
            pattern.pat_child_add(mn(p), vec_at[u32](&tmp, i))
            i = i + 1
        }
        slen = vec_len[u32](&tmp) as u32
        vec_free[u32](&tmp)
    }
    return pattern.pat_mu_add(mn(p), pattern.MU_VARIANT, ename, vname, 0, 0, soff, slen)
}

// `match subject { pattern => { .. } .. }` as statement. It becomes the call
// `__match#<number>` without arguments; the arms lie inside the pattern registry.
fn match_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    // `match` inside one generic template is not supported -- the
    // arms lie inside the registry, one template could not replace them per
    // instantiation (wrong at stage 0 too).
    if has_gen(p) {
        if mono.gen_in_template(gn(p)) {
            (*p).not_core = true
            complain(p)
        }
    }
    // Inside the subject no struct literal is allowed on the top level --
    // `match X { .. }` could otherwise not be told apart from the block.
    let subj: u32 = cond_expr(p)
    if !expect(p, A_LBRACE) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let mi: u32 = pattern.pat_match_add(mn(p), subj)
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        // The bindings of the pattern are visible inside the body -- and only there.
        loc_on(p)
        let pat: u32 = pattern(p, 0)
        if pat == ast.NOTHING {
            loc_off(p)
            break
        }
        // `=>` are two tokens: `=` and `>`.
        if !(actual(p, A_ASSIGN) && kind(p, 1) == A_GT) {
            complain(p)
            loc_off(p)
            break
        }
        next_bump(p)
        next_bump(p)
        if !actual(p, A_LBRACE) {
            complain(p)
            loc_off(p)
            break
        }
        let body: u32 = block(p)
        loc_off(p)
        pattern.pat_arm_add(mn(p), mi, pat, body)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    if pattern.pat_m_alen(mn(p), mi) == 0 {
        complain(p)
    }
    // The call label carries the number: `__match#<mi>`.
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    rt.buf_clear(&(*p).scratch)
    var pfx: [u8; 8] = "__match#"
    rt.buf_push_bytes(&(*p).scratch, (&pfx[0]) as u64, 8)
    rt.buf_push_dec_u64(&(*p).scratch, mi as u64)
    let name: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                         rt.buf_len(&(*p).scratch)) as u32
    let e: u32 = ast.expr_new(par_tree(p), ast.E_CALL, name, 0, 0, 0)
    return ast.stmt_new(par_tree(p), ast.S_EXPR, e, 0, 0, 0)
}

// Prescan: collect all `import` aliases, so that `module.x` gets recognized
// from the FIRST line onwards. `firnc0` does the same.
fn module_upfront(p: *mut Parser) {
    var i: usize = 0
    while i + 1 < (*p).n {
        if lexer.lex_kind(lx(p), i) == A_KWIMPORT {
            var j: usize = i + 1
            var last: u32 = ast.NOTHING
            while j < (*p).n {
                if lexer.lex_kind(lx(p), j) != A_IDENT {
                    break
                }
                last = lexer.lex_nr(lx(p), j)
                j = j + 1
                if j >= (*p).n {
                    break
                }
                if lexer.lex_kind(lx(p), j) != A_DOT {
                    break
                }
                j = j + 1
            }
            if last != ast.NOTHING {
                vec_push[u32](&(*p).module, last)
            }
        }
        i = i + 1
    }
}

// Prescan for extensions that this parser does NOT know.
//
// Better here than amid the descent: that way it stands fixed before the first
// node whether the file is core language at all, and the comparison counts it
// cleanly as "not core" instead of as deviation. Recognized by the TOKEN STREAM:
//
//   enum | match | error | try | catch | comptime | '#'   keywords
//   '?'                                                    `x.as?[C]`
//   '::'                                                   `Enum::Variant`
//   IDENT '['  after 'fn'/'struct'  generic template -- ONLY THEN one
//                                   extension, once no template registry
//                                   is registered (round 31)
//   IDENT '!'                                              error union `E!T`
//   the identifier `gc`                                    `gc class`, `gc C{}`
fn extensions_search(p: *mut Parser) {
    // Intern number of the identifier "gc" -- should it turn up inside the text at all.
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    var gc_word: [u8; 2] = "gc"
    let gc_nr: i64 = intern.intern_find(it, (&gc_word[0]) as u64, 2)
    // The intrinsics for constant runtime (`ct.rs`, SPEC 9.2/9.3) are
    // ordinary identifiers, no keyword -- they can be told apart only by
    // their SPELLING. Whoever writes one own function `select` drops out here
    // wrongly; that is the careful direction.
    var ct1: [u8; 6] = "select"
    var ct2: [u8; 7] = "barrier"
    var ct3: [u8; 11] = "secure_zero"
    let ct1_nr: i64 = intern.intern_find(it, (&ct1[0]) as u64, 6)
    let ct2_nr: i64 = intern.intern_find(it, (&ct2[0]) as u64, 7)
    let ct3_nr: i64 = intern.intern_find(it, (&ct3[0]) as u64, 11)

    var i: usize = 0
    while i < (*p).n {
        let a: u32 = lexer.lex_kind(lx(p), i)
        if a == A_KWENUM || a == A_KWMATCH {
            // Belongs to the core language AS SOON AS the pattern registry is
            // registered -- the same transition as with the generic templates
            // (round 31).
            if !has_mu(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_KWERROR || a == A_KWTRY || a == A_KWCATCH {
            // Belongs to the core language AS SOON AS the error registry
            // is registered -- the same transition as with `enum`/`match`
            // (round 32).
            if !has_fe(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_KWERRDEFER {
            // ROUND 36: belongs to the core language as soon as the error
            // registry is registered -- the error path comes out of
            // `err.fi`/`lower.fi` (`ret_term_error`), the same
            // transition as with `error`/`try`/`catch` (round 33).
            if !has_fe(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_KWCOMPTIME {
            // ROUND 35: belongs to the core language as soon as `par_time_set`
            // has run -- the same transition as rounds 31-33.
            if !has_time(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_HASH {
            // ROUND 34: `#[no_gc]` belongs to the core language as soon as the
            // gc registry is registered -- every OTHER attribute
            // (`#[must_consume]`, ...) stays one extension that is not
            // ported, as before.
            var ok_attr: bool = false
            if has_gc(p) && i + 3 < (*p).n {
                if lexer.lex_kind(lx(p), i + 1) == A_LBRACKET && lexer.lex_kind(lx(p), i + 3) == A_RBRACKET {
                    if lexer.lex_kind(lx(p), i + 2) == A_IDENT {
                        var an: [u8; 5] = "no_gc"
                        var mc: [u8; 12] = "must_consume"
                        // Round 36: both attributes carried out (attrs.rs).
                        // Round 52: on top of those `#[interrupt]` and `#[allow_fp]`.
                        var iw: [u8; 9] = "interrupt"
                        var fw: [u8; 8] = "allow_fp"
                        let anr: u32 = lexer.lex_nr(lx(p), i + 2)
                        let itn: *mut intern.Interner = lexer.lex_names(lx(p))
                        ok_attr = intern.intern_equal(itn, anr, (&an[0]) as u64, 5) ||
                                intern.intern_equal(itn, anr, (&mc[0]) as u64, 12) ||
                                intern.intern_equal(itn, anr, (&iw[0]) as u64, 9) ||
                                intern.intern_equal(itn, anr, (&fw[0]) as u64, 8)
                    }
                }
            }
            if !ok_attr {
                (*p).not_core = true
                return
            }
        }
        if a == A_QUESTION {
            // ROUND 34: `?` belongs only to `x.as?[C]` -- core with registry.
            if !has_gc(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_COLON && i + 1 < (*p).n {
            if lexer.lex_kind(lx(p), i + 1) == A_COLON {
                if !has_mu(p) {
                    (*p).not_core = true
                    return
                }
            }
        }
        if a == A_IDENT {
            let nr: i64 = lexer.lex_nr(lx(p), i) as i64
            if gc_nr >= 0 && nr == gc_nr {
                // ROUND 34: `gc`/`gc class`/`gc C{}` belong to the core language
                // as soon as the gc registry is registered (the same
                // transition as rounds 31-33, 35).
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if ct1_nr >= 0 && nr == ct1_nr {
                // ROUND 36: `select(b, a, b)` is ported (ct.rs) -- the same
                // transition as with `barrier`: core, as soon as the gc
                // registry is registered; the dump tools stay
                // at "not core", because their stage 0 side prints
                // `Op::Select`.
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if ct2_nr >= 0 && nr == ct2_nr {
                // ROUND 34: `barrier(x)` is the opaque barrier out of
                // ct.rs -- for the behaviour (and this stage has no
                // optimizer) it is the identity. It belongs to the
                // core language as soon as the gc registry is registered:
                // that one needs it (tests/modules/dom.fi), and only the
                // real compiler registers it -- the dump tools
                // stay at "not core", because their stage 0 side prints
                // the opaque part (`Op::Barrier`).
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if ct3_nr >= 0 && nr == ct3_nr {
                // ROUND 36: `secure_zero(p, n)` is ported (ct.rs) --
                // the same transition as with `select`.
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if i + 1 < (*p).n && lexer.lex_kind(lx(p), i + 1) == A_NOT {
                // `E!T` -- the error union builds on IDENT `!`.
                if !has_fe(p) {
                    (*p).not_core = true
                    return
                }
            }
            if i > 0 && i + 1 < (*p).n && !has_gen(p) {
                let before: u32 = lexer.lex_kind(lx(p), i - 1)
                if before == A_KWFN || before == A_KWSTRUCT {
                    if lexer.lex_kind(lx(p), i + 1) == A_LBRACKET {
                        (*p).not_core = true
                        return
                    }
                }
            }
        }
        i = i + 1
    }
}

// Collects the names that this file declares on the top level. Only those
// get rewritten -- one use out of another module stands there qualified
// anyway.
fn own_search(p: *mut Parser) {
    if (*p).alias == NONE {
        return
    }
    var i: usize = 0
    while i + 1 < (*p).n {
        // ROUND 45: the methods of one `impl` block are called `Type__method`
        // and never stand under their short spelling inside the module. `firnc0`
        // collects the names only AFTER the parsing (modules.rs) and therefore
        // does not see them either -- without this jump both would drift apart.
        if is_impl_at(p, i) {
            i = impl_end(p, i)
            continue
        }
        // ROUND 46: the same for `interface I { fn ... }`. The methods of one
        // interface are no names of the module -- `firnc0` never sees them
        // either (the block does not even land inside the tree).
        if is_interface_at(p, i) {
            i = impl_end(p, i)
            continue
        }
        let a: u32 = lexer.lex_kind(lx(p), i)
        if a == A_KWFN || a == A_KWSTRUCT || a == A_KWCONST {
            if lexer.lex_kind(lx(p), i + 1) == A_IDENT {
                // One generic template keeps its spelling: generic
                // names hold PROGRAM WIDE and get used
                // unqualified. Whoever rewrites them makes `vec_push[i32](..)`
                // unfindable inside the root file.
                var generic: bool = false
                if a != A_KWCONST && i + 2 < (*p).n {
                    generic = lexer.lex_kind(lx(p), i + 2) == A_LBRACKET
                }
                if !generic {
                    vec_push[u32](&(*p).own, lexer.lex_nr(lx(p), i + 1))
                }
            }
        }
        i = i + 1
    }
}

// ROUND 35: `comptime { ... }` on the top level. The body is one
// ordinary block -- the same statements, the same local
// hiding of names, the same module rewriting. The block wanders NOT into
// one function but as number into `ast.ct_block`; the interpreter inside
// time.fi runs it before the type check (model compiler/src/comptime.rs).
fn comptime_decl(p: *mut Parser) {
    next_bump(p)
    let b: u32 = block(p)
    ast.ct_add(par_tree(p), b)
}

// ROUND 34: does `gc class` stand at this spot? (hook_item inside gc.rs)
fn is_gc_class(p: *mut Parser) -> bool {
    if !actual(p, A_IDENT) {
        return false
    }
    var gw: [u8; 2] = "gc"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, tok_nr(p, 0), (&gw[0]) as u64, 2) {
        return false
    }
    if kind(p, 1) != A_IDENT {
        return false
    }
    var cw: [u8; 5] = "class"
    return intern.intern_equal(it, tok_nr(p, 1), (&cw[0]) as u64, 5)
}

// ROUND 45 (impls.rs::hook_item): does `impl Type {` stand at this spot?
// `impl` is NO keyword but one identifier at one position
// where nothing else may stand -- the same solution as `gc class`.
fn is_impl(p: *mut Parser) -> bool {
    if !actual(p, A_IDENT) {
        return false
    }
    var iw: [u8; 4] = "impl"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, tok_nr(p, 0), (&iw[0]) as u64, 4) {
        return false
    }
    if kind(p, 1) != A_IDENT {
        return false
    }
    if kind(p, 2) == A_LBRACE {
        return true
    }
    // ROUND 46: `impl Interface for Type {`. `for` is one
    // keyword and makes the form unambiguous.
    if kind(p, 2) != A_KWFOR {
        return false
    }
    if kind(p, 3) != A_IDENT {
        return false
    }
    return kind(p, 4) == A_LBRACE
}

// ROUND 46 (iface.rs::hook_item): does `interface IDENT {` stand at this spot?
fn is_interface(p: *mut Parser) -> bool {
    if !actual(p, A_IDENT) {
        return false
    }
    var iw: [u8; 9] = "interface"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, tok_nr(p, 0), (&iw[0]) as u64, 9) {
        return false
    }
    if kind(p, 1) != A_IDENT {
        return false
    }
    return kind(p, 2) == A_LBRACE
}

// The same at one ABSOLUTE token spot (for the prescan).
fn is_interface_at(p: *mut Parser, i: usize) -> bool {
    if i + 2 >= (*p).n {
        return false
    }
    if lexer.lex_kind(lx(p), i) != A_IDENT {
        return false
    }
    var iw: [u8; 9] = "interface"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, lexer.lex_nr(lx(p), i), (&iw[0]) as u64, 9) {
        return false
    }
    if lexer.lex_kind(lx(p), i + 1) != A_IDENT {
        return false
    }
    return lexer.lex_kind(lx(p), i + 2) == A_LBRACE
}

// The same at one ABSOLUTE token spot (for the prescan).
fn is_impl_at(p: *mut Parser, i: usize) -> bool {
    if i + 2 >= (*p).n {
        return false
    }
    if lexer.lex_kind(lx(p), i) != A_IDENT {
        return false
    }
    var iw: [u8; 4] = "impl"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, lexer.lex_nr(lx(p), i), (&iw[0]) as u64, 4) {
        return false
    }
    if lexer.lex_kind(lx(p), i + 1) != A_IDENT {
        return false
    }
    if lexer.lex_kind(lx(p), i + 2) == A_LBRACE {
        return true
    }
    if i + 4 >= (*p).n {
        return false
    }
    if lexer.lex_kind(lx(p), i + 2) != A_KWFOR {
        return false
    }
    if lexer.lex_kind(lx(p), i + 3) != A_IDENT {
        return false
    }
    return lexer.lex_kind(lx(p), i + 4) == A_LBRACE
}

// Spot AFTER the closing brace of the block at `i`. The search starts from
// the FIRST curly brace onwards -- `impl T {` and `impl I for T {` (and
// likewise `interface I {`) are therefore the same case.
fn impl_end(p: *mut Parser, i: usize) -> usize {
    var k: usize = i + 2
    while k < (*p).n {
        if lexer.lex_kind(lx(p), k) == A_LBRACE {
            break
        }
        k = k + 1
    }
    var depth: usize = 0
    while k < (*p).n {
        let a: u32 = lexer.lex_kind(lx(p), k)
        if a == A_LBRACE {
            depth = depth + 1
        }
        if a == A_RBRACE {
            depth = depth - 1
            if depth == 0 {
                return k + 1
            }
        }
        k = k + 1
    }
    return k
}

// The receiver of one method: `self`, `*self` or `*mut self`.
// Firn has no references -- the receiver gets written like every
// other parameter of this language (impls.rs, section "The receiver").
fn self_param(p: *mut Parser, tname0: u32) -> bool {
    var sw: [u8; 4] = "self"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let snr: u32 = intern.intern_number(it, (&sw[0]) as u64, 4) as u32
    // ROUND 46: for one `gc class` the receiver carries the INTERNAL
    // struct spelling `"gc K"` -- out of `*self` comes exactly `Gc[K]`. Whether `K`
    // is one class stands inside the registry; that one gets filled while
    // parsing, so `gc class K` has to stand BEFORE the `impl` block
    // (docs/RUNDE46.md section 9). Word for word as impls.rs::self_param.
    var tname: u32 = tname0
    var class: bool = false
    if has_gc(p) && gc.gc_is_class(gr(p), tname0) {
        class = true
        rt.buf_clear(&(*p).scratch)
        var gw: [u8; 3] = "gc "
        rt.buf_push_bytes(&(*p).scratch, (&gw[0]) as u64, 3)
        rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, tname0),
                          intern.intern_length(it, tname0))
        tname = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                     rt.buf_len(&(*p).scratch)) as u32
    }
    if actual(p, A_IDENT) && tok_nr(p, 0) == snr {
        if class {
            // one 'gc class' value lives only on the GC heap
            complain(p)
            return false
        }
        next_bump(p)
        let t: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tname, 0)
        ast.param_add(par_tree(p), snr, t)
        loc_add(p, snr)
        return true
    }
    if actual(p, A_STAR) {
        var m: u64 = 0
        var k: usize = 1
        if kind(p, 1) == A_KWMUT {
            m = 1
            k = 2
        }
        if kind(p, k) == A_IDENT && tok_nr(p, k) == snr {
            next_bump(p)
            if m == 1 {
                next_bump(p)
            }
            next_bump(p)
            let inner: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tname, 0)
            let t: u32 = ast.ty_new(par_tree(p), ast.T_PTR, inner, m)
            ast.param_add(par_tree(p), snr, t)
            loc_add(p, snr)
            return true
        }
    }
    complain(p)
    return false
}

// One method becomes the ordinary function `Type__method`. After that it is
// nothing special any more -- the same type check, the same lowering.
fn methods_decl(p: *mut Parser, tname: u32) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let mnr: u32 = tok_nr(p, 0)
    next_bump(p)
    if actual(p, A_LBRACKET) {
        complain(p)
        return
    }
    var tr: [u8; 2] = "__"
    let name: u32 = join(p, tname, (&tr[0]) as u64, 2, mnr)
    if !expect(p, A_LPAREN) {
        return
    }
    loc_on(p)
    let poff: u32 = ast.param_start(par_tree(p))
    if !self_param(p, tname) {
        loc_off(p)
        return
    }
    if eat(p, A_COMMA) {
        param_list(p)
    }
    expect(p, A_RPAREN)
    let plen: u32 = ast.param_start(par_tree(p)) - poff
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            loc_off(p)
            return
        }
    }
    let body: u32 = block(p)
    loc_off(p)
    ast.fn_add(par_tree(p), name, poff, plen, ret, body, 0, 0, 0)
}

// ROUND 46 (iface.rs::interface_decl): `interface I { fn m(*self) -> T ... }`.
// The block goes into the registry (`iface.fi`), NOT into the tree --
// interface names hold program wide and do not get rewritten. Without one
// registry (astdump) it gets read correctly and discarded.
fn interface_decl(p: *mut Parser) {
    next_bump(p)
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    var ii: u32 = NONE
    if has_if(p) {
        ii = iface.if_add(ifr(p), lexer.lex_names(lx(p)), name)
        if ii == NONE {
            // the interface is declared already
            complain(p)
            return
        }
    }
    if !expect(p, A_LBRACE) {
        return
    }
    while true {
        while eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_KWFN) {
            complain(p)
            break
        }
        if !interfaces_method(p, ii) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
}

// One method of the interface: `fn m(<receiver>[, param...]) [-> T]`
// -- WITHOUT body. The receiver MUST be one pointer: over the table
// only the data pointer stands available.
fn interfaces_method(p: *mut Parser, ii: u32) -> bool {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return false
    }
    let mnr: u32 = tok_nr(p, 0)
    next_bump(p)
    if actual(p, A_LBRACKET) {
        complain(p)
        return false
    }
    if !expect(p, A_LPAREN) {
        return false
    }
    var sw: [u8; 4] = "self"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let snr: u32 = intern.intern_number(it, (&sw[0]) as u64, 4) as u32
    if !actual(p, A_STAR) {
        complain(p)
        return false
    }
    var k: usize = 1
    if kind(p, 1) == A_KWMUT {
        k = 2
    }
    if kind(p, k) != A_IDENT || tok_nr(p, k) != snr {
        complain(p)
        return false
    }
    next_bump(p)
    if k == 2 {
        next_bump(p)
    }
    next_bump(p)
    var ptypes: Vec[u32] = vec_new[u32]()
    if eat(p, A_COMMA) {
        while true {
            if actual(p, A_RPAREN) || at_end(p) {
                break
            }
            let before: usize = (*p).pos
            if !actual(p, A_IDENT) {
                complain(p)
                vec_free[u32](&ptypes)
                return false
            }
            next_bump(p)
            if !expect(p, A_COLON) {
                vec_free[u32](&ptypes)
                return false
            }
            let pt: u32 = ty(p)
            if pt == ast.NOTHING {
                vec_free[u32](&ptypes)
                return false
            }
            vec_push[u32](&ptypes, pt)
            if !eat(p, A_COMMA) {
                break
            }
            if (*p).pos == before {
                next_bump(p)
            }
        }
    }
    if !expect(p, A_RPAREN) {
        vec_free[u32](&ptypes)
        return false
    }
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            vec_free[u32](&ptypes)
            return false
        }
    }
    if actual(p, A_LBRACE) {
        // one interface method carries no body
        complain(p)
        vec_free[u32](&ptypes)
        return false
    }
    // ROUND 50: does the signature say `Self`? Then its types hang on the
    // implementing type and get resolved only per implementation.
    var has_self: bool = false
    var hi: usize = 0
    while hi < vec_len[u32](&ptypes) {
        if iface.if_names_self(par_tree(p), lexer.lex_names(lx(p)),
                               vec_at[u32](&ptypes, hi)) {
            has_self = true
        }
        hi = hi + 1
    }
    if iface.if_names_self(par_tree(p), lexer.lex_names(lx(p)), ret) {
        has_self = true
    }
    if ii != NONE {
        if !iface.if_method_add(ifr(p), ii, mnr, &ptypes, ret, has_self) {
            // the method exists inside this interface already
            complain(p)
            vec_free[u32](&ptypes)
            return false
        }
    }
    vec_free[u32](&ptypes)
    return true
}

fn impl_decl(p: *mut Parser) {
    next_bump(p)
    let first: u32 = tok_nr(p, 0)
    next_bump(p)
    // ROUND 46 (iface.rs): `impl Interface for Type`. The block creates
    // THE SAME functions as `impl Type` -- the interface only says
    // additionally what has to stand inside. Inside the registry the
    // type spelling stands as it stands inside the source text (without module
    // prefix): `firnc0` has only the raw spelling at this spot too.
    var raw: u32 = first
    var is_for: bool = false
    if actual(p, A_KWFOR) {
        next_bump(p)
        if !actual(p, A_IDENT) {
            complain(p)
            return
        }
        raw = tok_nr(p, 0)
        next_bump(p)
        is_for = true
    }
    let tname: u32 = renamed(p, raw)
    if is_for && has_if(p) {
        iface.if_impl_add(ifr(p), first, raw)
    }
    if !expect(p, A_LBRACE) {
        return
    }
    while true {
        while eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_KWFN) {
            complain(p)
            break
        }
        methods_decl(p, tname)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
}

// `#[no_gc]` and `#[must_consume]` -- the two attributes carried out
// (attrs.rs: exactly these two stand on `implemented: true`). One parenthesis
// with arguments counts as error (both expect 0 arguments, attrs.rs);
// every other spelling gets caught by the prescan as not core already.
fn attr(p: *mut Parser) {
    next_bump(p)
    if !expect(p, A_LBRACKET) {
        return
    }
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    var an: [u8; 5] = "no_gc"
    var mc: [u8; 12] = "must_consume"
    // ROUND 52 (attrs.rs): `#[interrupt]` and `#[allow_fp]` (SPEC 2).
    var iw: [u8; 9] = "interrupt"
    var fw: [u8; 8] = "allow_fp"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let is_nogc: bool = intern.intern_equal(it, tok_nr(p, 0), (&an[0]) as u64, 5)
    let is_mc: bool = intern.intern_equal(it, tok_nr(p, 0), (&mc[0]) as u64, 12)
    let is_int: bool = intern.intern_equal(it, tok_nr(p, 0), (&iw[0]) as u64, 9)
    let is_fp: bool = intern.intern_equal(it, tok_nr(p, 0), (&fw[0]) as u64, 8)
    if !is_nogc && !is_mc && !is_int && !is_fp {
        complain(p)
        return
    }
    next_bump(p)
    if actual(p, A_LPAREN) {
        complain(p)
        return
    }
    if !expect(p, A_RBRACKET) {
        return
    }
    if is_mc {
        (*p).mc_pending = 1
    } else if is_int {
        (*p).int_pending = 1
    } else if is_fp {
        // `#[allow_fp]` allows floating point inside the kernel profile; inside the tree
        // nothing of it stays over, because this stage does not enforce the
        // profile bans (docs/RUNDE52.md, "Open points").
        (*p).nogc_pending = (*p).nogc_pending
    } else {
        (*p).nogc_pending = 1
    }
}

// `gc class IDENT [extends Base] { field: Type, ... }` (gc_class_decl inside
// gc.rs). The class goes into the registry (`gc.fi`), NOT into the
// tree -- class names hold program wide and do not get rewritten.
fn gc_class_decl(p: *mut Parser) {
    next_bump(p)
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    var base: u32 = 0
    if actual(p, A_IDENT) {
        var ew: [u8; 7] = "extends"
        let it: *mut intern.Interner = lexer.lex_names(lx(p))
        if intern.intern_equal(it, tok_nr(p, 0), (&ew[0]) as u64, 7) {
            next_bump(p)
            if !actual(p, A_IDENT) {
                complain(p)
                return
            }
            base = tok_nr(p, 0)
            next_bump(p)
            if actual(p, A_COMMA) {
                // multiple inheritance is not allowed (SPEC 4.4)
                complain(p)
                return
            }
        }
    }
    if !expect(p, A_LBRACE) {
        return
    }
    let ki: u32 = gc.gc_class_add(gr(p), name)
    if ki == NONE {
        // 'gc class ...' is declared already
        complain(p)
        return
    }
    if base != 0 {
        gc.gc_base_set(gr(p), ki, base)
    }
    while true {
        while eat(p, A_COMMA) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let ft: u32 = ty(p)
        if ft == ast.NOTHING {
            break
        }
        if !gc.gc_field_add(gr(p), ki, fname, ft) {
            // field is declared already
            complain(p)
        }
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
}

fn par_run(p: *mut Parser) {
    if has_gen(p) {
        var so: [u8; 7] = "size_of"
        (*p).sonr = intern.intern_find(lexer.lex_names(lx(p)), (&so[0]) as u64, 7)
    }
    extensions_search(p)
    own_search(p)
    if (*p).not_core {
        return
    }
    module_upfront(p)
    while true {
        while eat(p, A_SEMI) {}
        if at_end(p) {
            break
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        let a: u32 = kind(p, 0)
        // `#[no_gc]` belongs ahead of one FUNCTION (attrs.rs, Target::Func),
        // `#[must_consume]` ahead of both (attrs.rs, Target::Both) -- round 36.
        if (*p).nogc_pending == 1 && a != A_KWFN && a != A_HASH {
            complain(p)
            (*p).nogc_pending = 0
        }
        if (*p).mc_pending == 1 && a != A_KWFN && a != A_KWSTRUCT && a != A_HASH {
            complain(p)
            (*p).mc_pending = 0
        }
        if a == A_HASH && has_gc(p) {
            // `#[no_gc]` ahead of one function (round 34, SPEC 3.5.4),
            // `#[must_consume]` ahead of function or struct (round 36). Other
            // attributes get caught by the prescan as not core.
            attr(p)
        } else if a == A_IDENT && has_gc(p) && is_gc_class(p) {
            gc_class_decl(p)
        } else if a == A_IDENT && is_interface(p) {
            interface_decl(p)
        } else if a == A_IDENT && is_impl(p) {
            impl_decl(p)
        } else if a == A_KWFN {
            fn_decl(p)
        } else if a == A_KWSTRUCT {
            struct_decl(p)
        } else if a == A_KWENUM && has_mu(p) {
            enum_decl(p)
        } else if a == A_KWERROR && has_fe(p) {
            error_decl(p)
        } else if a == A_KWCOMPTIME && has_time(p) {
            comptime_decl(p)
        } else if a == A_KWCONST {
            const_decl(p)
        } else if a == A_KWPROFILE {
            profile_decl(p)
        } else if a == A_KWIMPORT {
            import_decl(p)
        } else if a == A_KWEXPORT {
            export_decl(p)
        } else {
            // Everything left over belongs to the extensions that are not
            // ported (`enum`, `error`, `gc class`, `comptime`, attributes) or is
            // plainly wrong.
            // One IDENTIFIER on the top level can be only one hook at
            // stage 0 -- `gc class C { ... }`. That belongs, like `enum`,
            // `error`, `comptime` and attributes, to the extensions that are
            // not ported.
            if a == A_KWENUM || a == A_KWERROR || a == A_KWCOMPTIME || a == A_HASH || a == A_IDENT {
                (*p).not_core = true
            }
            complain(p)
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    if vec_len[u32](&(*p).hoist) > 0 {
        // f"..." on ITEM level (say inside one `const`): there is no
        // statement ahead of which the text segments could get lifted.
        complain(p)
    }
}
