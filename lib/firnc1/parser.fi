// lib/firnc1/parser.fi — DER PARSER VON FIRN, IN FIRN.
//
// Rekursiver Abstieg, kein Generator — genau wie `compiler/src/parser.rs`.
// Gebaut wird in `ast.Baum`: Knoten ueber `Vec`-Indizes statt ueber Zeiger
// (docs/SELBSTHOSTING.md §2.4).
//
// UMFANG: die KERNSPRACHE. Was seinen Baum ausserhalb von `Program` haelt —
// `enum`/`match`, Fehlerunionen, generische Vorlagen, `gc class`, Attribute,
// `comptime` — ist NICHT dabei. Diese Dateien werden im Vergleich gezaehlt und
// uebersprungen, nicht stillschweigend uebergangen.
//
// EBENFALLS NICHT DABEI: die Fehlerwiederherstellung. `firnc0` sammelt bis zu
// vierzig Meldungen und liest weiter; dieser Parser meldet die erste und hoert
// auf. Das ist ehrlich weniger — und fuer den Vergleich ohne Belang, weil er
// nur ueber Quellen laeuft, die `firnc0` fehlerfrei liest.
//
// EINE REGEL, DIE MAN LEICHT UEBERSIEHT: ein Operator am ZEILENANFANG setzt
// den Ausdruck NICHT fort, solange keine Klammer offen ist (`weiter()`).
// Deshalb ist
//     a
//     - b
// zwei Anweisungen und nicht eine Subtraktion.

import rt
import vec
import intern
import lexer
import ast
import mono
import pattern
import err
import gc
import iface

export { Parser, par_new, par_new_module, par_free, par_run, par_error, par_tree,
         par_not_core, par_tree_take, par_gen_set, par_mu_set,
         par_fe_set, par_time_set, par_gc_set, par_if_set }

// Token-Arten aus lexer.fi (dieselbe Reihenfolge wie compiler/src/lexer.rs)
// "kein Wert"
const NONE: u32 = 4294967295

const A_INT: u32 = 0
const A_IDENT: u32 = 1
const A_FLOAT: u32 = 2
const A_STR: u32 = 3
const A_KWFN: u32 = 4
const A_KWLET: u32 = 5
const A_KWVAR: u32 = 6
const A_KWIF: u32 = 7
const A_KWELSE: u32 = 8
const A_KWWHILE: u32 = 9
const A_KWRETURN: u32 = 10
const A_KWSTRUCT: u32 = 11
const A_KWCONST: u32 = 12
const A_KWPROFILE: u32 = 13
const A_KWAS: u32 = 14
const A_KWMUT: u32 = 15
const A_KWTRUE: u32 = 16
const A_KWFALSE: u32 = 17
const A_KWSYSCALL: u32 = 18
const A_KWEXTERN: u32 = 19
const A_KWBREAK: u32 = 20
const A_KWCONTINUE: u32 = 21
const A_KWDEFER: u32 = 22
const A_KWERRDEFER: u32 = 23
const A_KWCOMPTIME: u32 = 24
const A_KWFOR: u32 = 25
const A_KWIN: u32 = 26
const A_KWIMPORT: u32 = 27
const A_KWEXPORT: u32 = 28
const A_KWENUM: u32 = 29
const A_KWMATCH: u32 = 30
const A_KWERROR: u32 = 31
const A_KWTRY: u32 = 32
const A_KWCATCH: u32 = 33
const A_LPAREN: u32 = 34
const A_RPAREN: u32 = 35
const A_LBRACE: u32 = 36
const A_RBRACE: u32 = 37
const A_LBRACKET: u32 = 38
const A_RBRACKET: u32 = 39
const A_COMMA: u32 = 40
const A_COLON: u32 = 41
const A_SEMI: u32 = 42
const A_DOT: u32 = 43
const A_DOTDOT: u32 = 44
const A_ARROW: u32 = 45
const A_ASSIGN: u32 = 46
const A_PLUS: u32 = 47
const A_MINUS: u32 = 48
const A_STAR: u32 = 49
const A_SLASH: u32 = 50
const A_PERCENT: u32 = 51
const A_AMP: u32 = 52
const A_PIPE: u32 = 53
const A_CARET: u32 = 54
const A_SHL: u32 = 55
const A_SHR: u32 = 56
const A_ANDAND: u32 = 57
const A_OROR: u32 = 58
const A_NOT: u32 = 59
const A_QUESTION: u32 = 60
const A_HASH: u32 = 61
const A_EQEQ: u32 = 62
const A_NOTEQ: u32 = 63
const A_LT: u32 = 64
const A_LE: u32 = 65
const A_GT: u32 = 66
const A_GE: u32 = 67
const A_EOF: u32 = 68
const A_FSTR: u32 = 69

// Binaeroperatoren — dieselbe Reihenfolge wie `ast::BinOp`.
const B_ADD: u32 = 0
const B_SUB: u32 = 1
const B_MUL: u32 = 2
const B_DIV: u32 = 3
const B_REM: u32 = 4
const B_AND: u32 = 5
const B_OR: u32 = 6
const B_XOR: u32 = 7
const B_SHL: u32 = 8
const B_SHR: u32 = 9
const B_EQ: u32 = 10
const B_NE: u32 = 11
const B_LT: u32 = 12
const B_LE: u32 = 13
const B_GT: u32 = 14
const B_GE: u32 = 15
const B_LAND: u32 = 16
const B_LOR: u32 = 17

// Unaeroperatoren
const U_NEG: u32 = 0
const U_NOT: u32 = 1
const U_ADDR: u32 = 2
const U_DEREF: u32 = 3

struct Parser {
    lx: u64,             // Zeiger auf den Lexer
    pos: usize,
    n: usize,
    tree: ast.Tree,
    // MODULSYSTEM. Ist `alias` gesetzt, gehoert diese Datei nicht zur Wurzel:
    // jeder Name, den sie SELBST oben deklariert, bekommt `alias__` davor.
    // Damit liegen alle Dateien in EINEM Baum, ohne dass sich zwei Funktionen
    // gleichen Namens in die Quere kommen. `firnc0` macht dasselbe in
    // `modules.rs`, nur nach dem Parsen statt waehrend.
    alias: u32,
    own: Vec[u32],    // oben deklarierte Namen dieser Datei
    foreign: u64,          // gemeinsamer Baum (0 = eigener)
    module: Vec[u32],    // Namensnummern der Modul-Aliasse (fuer `modul.name`)
    scratch: rt.Buf,      // baut qualifizierte Namen zusammen
    parens: usize,     // offene Klammern (fuer `weiter()`)
    no_slit: usize,    // > 0: kein Struct-Literal auf oberster Ebene
    err: usize,
    not_core: bool,    // Datei benutzt eine nicht portierte Erweiterung
    // GENERISCHE VORLAGEN. Die Ablage liegt AUSSERHALB des Parsers, weil sie
    // ueber alle Dateien einer Uebersetzung hinweg dieselbe sein muss: eine
    // Wurzeldatei benutzt `Vec[i32]`, deklariert ist `Vec[T]` in einem Modul.
    // 0 = kein Register, dann sind Generics eine nicht portierte Erweiterung.
    gen: u64,
    // Register der Aufzaehlungen und Musterabgleiche (Runde 32). Dieselbe
    // Bauart wie `gen`: die Ablage liegt ausserhalb des Parsers, weil sie
    // ueber alle Dateien einer Uebersetzung hinweg dieselbe sein muss.
    // 0 = kein Register, dann sind `enum`/`match` nicht portiert.
    mu: u64,
    // Registrierung der Fehlermengen/-unionen (Runde 33). Dieselbe Bauart
    // wie `mu`: eine Ablage fuer alle Dateien der Uebersetzung.
    // 0 = kein Register, dann sind `error`/`try`/`catch` nicht portiert.
    feh: u64,
    // RUNDE 35: `comptime { ... }` ist angemeldet. Kein Register ausserhalb
    // des Baums noetig — die Bloecke liegen als Blocknummern im Baum selbst
    // (`ast.ct_block`); der Interpreter steht in time.fi. Nur das FLAG gehoert
    // hierher, weil `erweiterungen_suchen` vor dem Parsen wissen muss, ob das
    // Schluesselwort Kernsprache ist (derselbe Uebergang wie Runde 31-33).
    time: bool,
    // RUNDE 34: Registrierung der gc-Klassen (`gc.fi`). Dieselbe Bauart wie
    // `mu`/`feh`: eine Ablage fuer alle Dateien der Uebersetzung, weil
    // Klassennamen programmweit gelten. 0 = kein Register, dann sind
    // `gc class`, `Gc[T]`, `x.as?[C]` und `#[no_gc]` nicht portiert.
    gcr: u64,
    // RUNDE 46: Registrierung der Schnittstellen (`iface.fi`). Dieselbe
    // Bauart wie `gcr`. 0 = kein Register; dann werden `interface`-Bloecke
    // zwar richtig gelesen, aber nicht aufgehoben — das reicht fuer
    // `bin/astdump.fi`, dessen Massstab (`ast_canon.rs`) sie ebenfalls
    // nicht ausgibt.
    ifr: u64,
    // Das Attribut `#[no_gc]` vor der naechsten Funktionsdeklaration.
    nogc_pending: u32,
    // RUNDE 52: `#[interrupt]` vor der naechsten Funktion (SPEC 2).
    int_pending: u32,
    // Das Attribut `#[must_consume]` vor der naechsten fn-/struct-Deklaration
    // (Runde 36, attrs.rs — Ziel::Beides).
    mc_pending: u32,
    tpoff: u32,          // Anfang der laufenden Typparameterliste
    // Namensnummer von `size_of`, oder -1. `size_of` ist KEIN Schluesselwort
    // (sizeof.rs) — es laesst sich nur am Namen erkennen.
    sonr: i64,
    // LOKALE NAMEN, als Stapel von Bereichen. Ein Parameter oder eine lokale
    // Variable VERDECKT einen gleichnamigen Namen derselben Datei.
    local: Vec[u32],
    llimit: Vec[u32],
    // RUNDE 39, Interpolation: die versteckten `let _fsegK_N` der
    // Textsegmente — `block` hebt sie vor die naechste Anweisung.
    hoist: Vec[u32],
    // > 0: eine Interpolation laeuft bereits — Schachtelung ist noch nicht.
    interp: u32,
}

fn par_new(lx: u64) -> Parser {
    var p: Parser = Parser{
        lx: lx, pos: 0, n: 0,
        tree: ast.tree_new(),
        alias: NONE, own: vec_new[u32](), foreign: 0,
        module: vec_new[u32](),
        scratch: rt.buf_new(),
        parens: 0, no_slit: 0, err: 0, not_core: false,
        gen: 0, mu: 0, feh: 0, time: false, gcr: 0, ifr: 0, nogc_pending: 0, int_pending: 0, mc_pending: 0, tpoff: 0, sonr: -1,
        local: vec_new[u32](), llimit: vec_new[u32](),
        hoist: vec_new[u32](), interp: 0,
    }
    p.n = lexer.lex_count(lx as *mut lexer.Lexer)
    return p
}

// Wie `par_neu`, aber in einen GEMEINSAMEN Baum und mit Modul-Alias.
// `alias == KEIN` heisst Wurzeldatei (keine Umbenennung).
fn par_new_module(lx: u64, tree: u64, alias: u32) -> Parser {
    var p: Parser = par_new(lx)
    p.foreign = tree
    p.alias = alias
    return p
}

// Register der generischen Vorlagen anmelden. MUSS vor `par_lauf` stehen.
fn par_gen_set(p: *mut Parser, g: u64) { (*p).gen = g }

// Register der Aufzaehlungen/Musterabgleiche anmelden. Ebenfalls VOR `par_lauf`.
fn par_mu_set(p: *mut Parser, m: u64) { (*p).mu = m }

// Registrierung der Fehlerunionen anmelden. Ebenfalls VOR `par_lauf`.
fn par_fe_set(p: *mut Parser, f: u64) { (*p).feh = f }

fn gn(p: *mut Parser) -> *mut mono.Gen { return (*p).gen as *mut mono.Gen }
fn has_gen(p: *mut Parser) -> bool { return (*p).gen != 0 }
fn mn(p: *mut Parser) -> *mut pattern.Pat { return (*p).mu as *mut pattern.Pat }
fn has_mu(p: *mut Parser) -> bool { return (*p).mu != 0 }
fn fh(p: *mut Parser) -> *mut err.Error { return (*p).feh as *mut err.Error }
fn has_fe(p: *mut Parser) -> bool { return (*p).feh != 0 }

// RUNDE 35: `comptime`-Bloecke anmelden.
fn par_time_set(p: *mut Parser) { (*p).time = true }
fn has_time(p: *mut Parser) -> bool { return (*p).time }

// RUNDE 34: die gc-Registrierung anmelden. Ebenfalls VOR `par_lauf`.
fn par_gc_set(p: *mut Parser, g: u64) { (*p).gcr = g }
fn par_if_set(p: *mut Parser, f: u64) { (*p).ifr = f }
fn ifr(p: *mut Parser) -> *mut iface.If { return (*p).ifr as *mut iface.If }
fn has_if(p: *mut Parser) -> bool { return (*p).ifr != 0 }
fn gr(p: *mut Parser) -> *mut gc.Gc { return (*p).gcr as *mut gc.Gc }
fn has_gc(p: *mut Parser) -> bool { return (*p).gcr != 0 }

fn par_tree_take(p: *mut Parser) -> *mut ast.Tree {
    return par_tree(p)
}

fn par_free(p: *mut Parser) {
    // Ein GEMEINSAMER Baum gehoert dem Aufrufer.
    if (*p).foreign == 0 {
        ast.tree_free(&(*p).tree)
    }
    vec_free[u32](&(*p).module)
    vec_free[u32](&(*p).own)
    rt.buf_free(&(*p).scratch)
    vec_free[u32](&(*p).local)
    vec_free[u32](&(*p).llimit)
    vec_free[u32](&(*p).hoist)
}

fn par_error(p: *mut Parser) -> usize { return (*p).err }
fn par_tree(p: *mut Parser) -> *mut ast.Tree {
    if (*p).foreign != 0 {
        return (*p).foreign as *mut ast.Tree
    }
    return &(*p).tree
}
fn par_not_core(p: *mut Parser) -> bool { return (*p).not_core }

fn lx(p: *mut Parser) -> *mut lexer.Lexer { return (*p).lx as *mut lexer.Lexer }

// ------------------------------------------------------------- Tokenzugriff

fn kind(p: *mut Parser, k: usize) -> u32 {
    if (*p).pos + k >= (*p).n {
        return A_EOF
    }
    return lexer.lex_kind(lx(p), (*p).pos + k)
}

fn tok_nr(p: *mut Parser, k: usize) -> u32 {
    if (*p).pos + k >= (*p).n {
        return 0
    }
    return lexer.lex_nr(lx(p), (*p).pos + k)
}

fn number(p: *mut Parser) -> u64 {
    if (*p).pos >= (*p).n {
        return 0
    }
    return lexer.lex_number(lx(p), (*p).pos)
}

fn line(p: *mut Parser, i: usize) -> u32 {
    if i >= (*p).n {
        return 0
    }
    return lexer.lex_line(lx(p), i)
}

fn at_end(p: *mut Parser) -> bool { return kind(p, 0) == A_EOF }

fn actual(p: *mut Parser, a: u32) -> bool { return kind(p, 0) == a }

fn next_bump(p: *mut Parser) {
    if (*p).pos < (*p).n {
        (*p).pos = (*p).pos + 1
    }
}

fn eat(p: *mut Parser, a: u32) -> bool {
    if actual(p, a) {
        next_bump(p)
        return true
    }
    return false
}

// Steht das aktuelle Token am ZEILENANFANG?
fn line_start(p: *mut Parser) -> bool {
    if (*p).pos == 0 {
        return true
    }
    if (*p).pos >= (*p).n {
        return true
    }
    return line(p, (*p).pos) > line(p, (*p).pos - 1)
}

// Darf der Ausdruck mit dem aktuellen Token fortgesetzt werden?
fn next(p: *mut Parser) -> bool {
    return (*p).parens > 0 || !line_start(p)
}

fn complain(p: *mut Parser) {
    (*p).err = (*p).err + 1
}

fn expect(p: *mut Parser, a: u32) -> bool {
    if eat(p, a) {
        return true
    }
    complain(p)
    return false
}

// -------------------------------------------------------------------- Namen

// Setzt zwei Namen mit einem Trenner zusammen und traegt das Ergebnis ein.
fn join(p: *mut Parser, a: u32, sep: u64, tn: usize, b: u32) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    rt.buf_clear(&(*p).scratch)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, a), intern.intern_length(it, a))
    rt.buf_push_bytes(&(*p).scratch, sep, tn)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, b), intern.intern_length(it, b))
    return intern.intern_number(it, rt.buf_ptr(&(*p).scratch), rt.buf_len(&(*p).scratch)) as u32
}

// Ist `nr` ein Name, den DIESE Datei oben deklariert?
fn is_own(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).own) {
        if vec_at[u32](&(*p).own, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

// Umbenennung eines Namens dieser Datei: `alias__name`. In der Wurzeldatei
// bleibt alles, wie es ist.
// ------------------------------------------------------------ Lokale Namen
//
// `fn par_neu(lx: u64)` in einer Datei, die auch `fn lx(..)` hat: `lx` im
// Rumpf ist der PARAMETER. Ohne diese Liste bekam er beim Umbenennen
// `parser__` davor und war weg — gefunden erst beim Selbstuebersetzen in
// Runde 31, weil vorher kein Modul einen Parameter so nannte wie eine seiner
// eigenen Funktionen. `modules.rs::Renamer` haelt dieselbe Liste.
//
// NUR WERTE werden verdeckt. Ein Aufruf `lx(p)` meint weiterhin die
// Funktion (`Renamer::resolve` mit `is_value = false`), und ein TYPNAME
// ohnehin.
fn loc_on(p: *mut Parser) {
    vec_push[u32](&(*p).llimit, vec_len[u32](&(*p).local) as u32)
}

fn loc_off(p: *mut Parser) {
    if vec_len[u32](&(*p).llimit) == 0 {
        return
    }
    let g: u32 = vec_pop[u32](&(*p).llimit)
    while vec_len[u32](&(*p).local) > g as usize {
        vec_pop[u32](&(*p).local)
    }
}

fn loc_add(p: *mut Parser, nr: u32) { vec_push[u32](&(*p).local, nr) }

fn is_local(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).local) {
        if vec_at[u32](&(*p).local, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

fn renamed(p: *mut Parser, nr: u32) -> u32 {
    if (*p).alias == NONE {
        return nr
    }
    if !is_own(p, nr) {
        return nr
    }
    var tr: [u8; 2] = "__"
    return join(p, (*p).alias, (&tr[0]) as u64, 2, nr)
}

// Baut `modul.name` und traegt es in den Interner ein.
// `modul.name` wird zum EINEN Namen `modul.name` (Wurzelbetrieb, damit der
// Vergleich mit `firnc0 --emit=ast-kanon` stimmt) bzw. zu `modul__name`,
// sobald wirklich mehrere Dateien uebersetzt werden. Beides ist derselbe
// Gedanke: aus zwei Teilen wird ein eindeutiger Name.
fn qualify(p: *mut Parser, module: u32, name: u32) -> u32 {
    if (*p).foreign != 0 {
        var tr: [u8; 2] = "__"
        return join(p, module, (&tr[0]) as u64, 2, name)
    }
    var pt: [u8; 1] = "."
    return join(p, module, (&pt[0]) as u64, 1, name)
}

fn is_module(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).module) {
        if vec_at[u32](&(*p).module, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

// `name` steht schon; wenn es ein Modulname mit `.` dahinter ist, wird
// `modul.mitglied` daraus.
fn renamed_value(p: *mut Parser, nr: u32, value: bool) -> u32 {
    if value {
        if is_local(p, nr) {
            return nr
        }
    }
    return renamed(p, nr)
}

fn maybe_qualified(p: *mut Parser, nr: u32, value: bool) -> u32 {
    if !is_module(p, nr) {
        return renamed_value(p, nr, value)
    }
    if !actual(p, A_DOT) {
        return renamed_value(p, nr, value)
    }
    if kind(p, 1) != A_IDENT {
        return renamed_value(p, nr, value)
    }
    let m: u32 = tok_nr(p, 1)
    next_bump(p)
    next_bump(p)
    return qualify(p, nr, m)
}

// ---------------------------------------------------------- Generisches
//
// `[T, U: Int]` an der DEKLARATION, `[i32, u8]` an der VERWENDUNG. Eckige
// Klammern statt spitzer, damit `<` eindeutig Vergleich bleibt (SPEC §12).

// Typparameterliste einer Vorlage. Die Parameter landen im Register, hier
// steht nur, ob es geklappt hat.
fn ty_param_list(p: *mut Parser) -> bool {
    if !expect(p, A_LBRACKET) {
        return false
    }
    let off: u32 = mono.gen_tp_start(gn(p))
    (*p).tpoff = off
    while true {
        if actual(p, A_RBRACKET) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            return false
        }
        let name: u32 = tok_nr(p, 0)
        next_bump(p)
        if mono.gen_tp_duplicate(gn(p), off, name) {
            complain(p)
            return false
        }
        mono.gen_tp_add(gn(p), name)
        // RUNDE 50: `T: A + B + C` — die Schranken stehen mit `+`
        // hintereinander und gelten ALLE gleichzeitig. Ein unbekannter Name
        // ist keine Fehleingabe, sondern der Name einer Schnittstelle;
        // geprueft wird bei der Auspraegung.
        if eat(p, A_COLON) {
            while true {
                if !actual(p, A_IDENT) {
                    complain(p)
                    return false
                }
                let snr: u32 = tok_nr(p, 0)
                let sa: u32 = mono.gen_bound(gn(p), snr)
                if !mono.gen_tp_bound_add(gn(p), sa, snr) {
                    // dieselbe schranke steht zweimal
                    complain(p)
                    return false
                }
                next_bump(p)
                if !eat(p, A_PLUS) {
                    break
                }
            }
        }
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    if !expect(p, A_RBRACKET) {
        return false
    }
    if mono.gen_tp_start(gn(p)) == off {
        complain(p)
        return false
    }
    return true
}

// Typargumente an einer Verwendungsstelle: `[i32, *mut u8]`.
fn ty_args(p: *mut Parser, out: *mut Vec[u32]) -> bool {
    if !expect(p, A_LBRACKET) {
        return false
    }
    while true {
        if actual(p, A_RBRACKET) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        let t: u32 = ty(p)
        if t == ast.NOTHING {
            return false
        }
        vec_push[u32](out, t)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    if !expect(p, A_RBRACKET) {
        return false
    }
    if vec_len[u32](out) == 0 {
        complain(p)
        return false
    }
    return true
}

// -------------------------------------------------------------------- Typen

fn ty(p: *mut Parser) -> u32 {
    if actual(p, A_STAR) {
        next_bump(p)
        var m: u64 = 0
        if eat(p, A_KWMUT) {
            m = 1
        }
        let inner: u32 = ty(p)
        if inner == ast.NOTHING {
            return ast.NOTHING
        }
        return ast.ty_new(par_tree(p), ast.T_PTR, inner, m)
    }
    if actual(p, A_LBRACKET) {
        next_bump(p)
        let elem: u32 = ty(p)
        if elem == ast.NOTHING {
            return ast.NOTHING
        }
        if !expect(p, A_SEMI) {
            return ast.NOTHING
        }
        if !actual(p, A_INT) {
            complain(p)
            return ast.NOTHING
        }
        let len: u64 = number(p)
        next_bump(p)
        if !expect(p, A_RBRACKET) {
            return ast.NOTHING
        }
        return ast.ty_new(par_tree(p), ast.T_ARR, elem, len)
    }
    if actual(p, A_IDENT) {
        let nr: u32 = tok_nr(p, 0)
        next_bump(p)
        // RUNDE 34 (gc.rs::hook_type): `Gc[C]` und `GcWeak[C]`. Der Name
        // steht als Platzhalter `__gc#p:C` / `__gc#w:C` im Baum; aufgeloest
        // wird er erst in der Typaufloesung. Klassennamen gelten
        // programmweit — KEINE Modul-Umbenennung.
        if has_gc(p) && actual(p, A_LBRACKET) {
            var kind_nr: u32 = 0
            var g1: [u8; 2] = "Gc"
            var g2: [u8; 6] = "GcWeak"
            let it2: *mut intern.Interner = lexer.lex_names(lx(p))
            if intern.intern_equal(it2, nr, (&g1[0]) as u64, 2) {
                kind_nr = 1
            }
            if intern.intern_equal(it2, nr, (&g2[0]) as u64, 6) {
                kind_nr = 2
            }
            // RUNDE 53 (gc.rs::hook_type): `GcVec[E]` und `GcMap[K,V]`.
            // Beide sind Zeiger auf die Laufzeitklassen `GcVec`/`GcMap`
            // (lib/gc/gcvec.fi, lib/gc/gcmap.fi) — `GcVec[Gc[Node]]` ist
            // also genau `Gc[GcVec]`. Die Typargumente werden VOLLSTAENDIG
            // geparst (ein Tippfehler soll auffallen) und danach verworfen:
            // Stufe 0 hat keine generischen `gc class`, der Elementtyp wird
            // am Zugriff geprueft, nicht am Behaelter.
            var g3: [u8; 5] = "GcVec"
            var g4: [u8; 5] = "GcMap"
            if intern.intern_equal(it2, nr, (&g3[0]) as u64, 5) {
                kind_nr = 3
            }
            if intern.intern_equal(it2, nr, (&g4[0]) as u64, 5) {
                kind_nr = 4
            }
            if kind_nr == 3 || kind_nr == 4 {
                next_bump(p)
                var arg_count: u32 = 0
                var next: bool = true
                while next {
                    let ta: u32 = ty(p)
                    if ta == ast.NOTHING {
                        return ast.NOTHING
                    }
                    arg_count = arg_count + 1
                    if actual(p, A_COMMA) {
                        next_bump(p)
                    } else {
                        next = false
                    }
                }
                var should: u32 = 1
                if kind_nr == 4 {
                    should = 2
                }
                if arg_count != should {
                    complain(p)
                    return ast.NOTHING
                }
                if !expect(p, A_RBRACKET) {
                    return ast.NOTHING
                }
                rt.buf_clear(&(*p).scratch)
                var px5: [u8; 7] = "__gc#p:"
                rt.buf_push_bytes(&(*p).scratch, (&px5[0]) as u64, 7)
                if kind_nr == 3 {
                    rt.buf_push_bytes(&(*p).scratch, (&g3[0]) as u64, 5)
                } else {
                    rt.buf_push_bytes(&(*p).scratch, (&g4[0]) as u64, 5)
                }
                let pn5: u32 = intern.intern_number(it2, rt.buf_ptr(&(*p).scratch),
                                                    rt.buf_len(&(*p).scratch)) as u32
                return ast.ty_new(par_tree(p), ast.T_NAME, pn5, 0)
            }
            if kind_nr != 0 {
                next_bump(p)
                if !actual(p, A_IDENT) {
                    complain(p)
                    return ast.NOTHING
                }
                let kn: u32 = tok_nr(p, 0)
                next_bump(p)
                if !expect(p, A_RBRACKET) {
                    return ast.NOTHING
                }
                rt.buf_clear(&(*p).scratch)
                if kind_nr == 1 {
                    var px1: [u8; 7] = "__gc#p:"
                    rt.buf_push_bytes(&(*p).scratch, (&px1[0]) as u64, 7)
                } else {
                    var px2: [u8; 7] = "__gc#w:"
                    rt.buf_push_bytes(&(*p).scratch, (&px2[0]) as u64, 7)
                }
                rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it2, kn),
                                  intern.intern_length(it2, kn))
                let pn: u32 = intern.intern_number(it2, rt.buf_ptr(&(*p).scratch),
                                                   rt.buf_len(&(*p).scratch)) as u32
                return ast.ty_new(par_tree(p), ast.T_NAME, pn, 0)
            }
        }
        // `E!T` — eine Fehlerunion (errors.rs::hook_type). Der Parser legt
        // die Angabe in die Registrierung und einen Platzhalter `__eu#<n>`
        // in den Baum; aufgeloest wird er erst im Typpruefer. Die
        // Reihenfolge zaehlt: `!` steht VOR dem `[` der Generics, genau
        // wie in Stufe 0 (`hook_type` vor `hook_generic_type`).
        if has_fe(p) && actual(p, A_NOT) {
            next_bump(p)
            let inner: u32 = ty(p)
            if inner == ast.NOTHING {
                return ast.NOTHING
            }
            let pi: u32 = err.error_pending_add(fh(p), nr, inner)
            let it: *mut intern.Interner = lexer.lex_names(lx(p))
            rt.buf_clear(&(*p).scratch)
            var eu: [u8; 5] = "__eu#"
            rt.buf_push_bytes(&(*p).scratch, (&eu[0]) as u64, 5)
            rt.buf_push_dec_u64(&(*p).scratch, pi as u64)
            let pn: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                               rt.buf_len(&(*p).scratch)) as u32
            return ast.ty_new(par_tree(p), ast.T_NAME, pn, 0)
        }
        // Ein `[` hinter einem Typnamen ist eine generische Auspraegung.
        if actual(p, A_LBRACKET) {
            var generic: bool = false
            if has_gen(p) {
                generic = mono.gen_is_struct(gn(p), nr)
            }
            if !generic {
                (*p).not_core = true
                complain(p)
                return ast.NOTHING
            }
            var targs: Vec[u32] = vec_new[u32]()
            let ok: bool = ty_args(p, &targs)
            if !ok {
                vec_free[u32](&targs)
                return ast.NOTHING
            }
            let m: u32 = mono.gen_instance(gn(p), nr, &targs, false)
            vec_free[u32](&targs)
            return ast.ty_new(par_tree(p), ast.T_NAME, m, 0)
        }
        // RUNDE 46 (iface.rs::hook_type): `dyn I` — der Schnittstellenwert.
        // Der Name wird zu EINEM Namen mit Leerzeichen; aufgeloest wird er
        // erst in der Typaufloesung. Schnittstellennamen gelten programmweit
        // und werden NICHT umbenannt.
        var dw: [u8; 3] = "dyn"
        let itd: *mut intern.Interner = lexer.lex_names(lx(p))
        if intern.intern_equal(itd, nr, (&dw[0]) as u64, 3) && actual(p, A_IDENT) {
            let inr: u32 = tok_nr(p, 0)
            next_bump(p)
            rt.buf_clear(&(*p).scratch)
            var dw2: [u8; 4] = "dyn "
            rt.buf_push_bytes(&(*p).scratch, (&dw2[0]) as u64, 4)
            rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(itd, inr),
                              intern.intern_length(itd, inr))
            let dn: u32 = intern.intern_number(itd, rt.buf_ptr(&(*p).scratch),
                                               rt.buf_len(&(*p).scratch)) as u32
            return ast.ty_new(par_tree(p), ast.T_NAME, dn, 0)
        }
        let q: u32 = maybe_qualified(p, nr, false)
        return ast.ty_new(par_tree(p), ast.T_NAME, q, 0)
    }
    complain(p)
    return ast.NOTHING
}

// --------------------------------------------------------------- Ausdruecke

fn expr(p: *mut Parser) -> u32 {
    var e: u32 = or_expr(p)
    // `ausdruck catch ersatz` bzw. `ausdruck catch |f| ersatz` — bindet
    // SCHWAECHER als jeder Operator und ist linksassoziativ; der Ersatz
    // ist ein Oder-Ausdruck (errors.rs::hook_catch). Im Baum steht ein
    // Aufruf `__catch#` mit zwei Argumenten; die Bindung liegt in der
    // Registrierung.
    if has_fe(p) {
        while actual(p, A_KWCATCH) {
            next_bump(p)
            var bind: u32 = NONE
            if actual(p, A_PIPE) {
                next_bump(p)
                if !actual(p, A_IDENT) {
                    complain(p)
                    return e
                }
                bind = tok_nr(p, 0)
                next_bump(p)
                if !expect(p, A_PIPE) {
                    return e
                }
            }
            // Die Bindung ist ein LOKALER Name — nur im Ersatz sichtbar
            // und von der Modul-Umbenennung ausgenommen (wie die Bindung
            // eines Musters, Runde 32).
            if bind != NONE {
                loc_on(p)
                loc_add(p, bind)
            }
            let rhs: u32 = or_expr(p)
            if bind != NONE {
                loc_off(p)
            }
            var tmp: Vec[u32] = vec_new[u32]()
            vec_push[u32](&tmp, e)
            vec_push[u32](&tmp, rhs)
            let off: u32 = list_store(p, &tmp)
            vec_free[u32](&tmp)
            var cn: [u8; 8] = "__catch#"
            let it: *mut intern.Interner = lexer.lex_names(lx(p))
            let name: u32 = intern.intern_number(it, (&cn[0]) as u64, 8) as u32
            e = ast.expr_new(par_tree(p), ast.E_CALL, name, off, 2, 0)
            if bind != NONE {
                err.error_cb_set(fh(p), e, bind)
            }
        }
    }
    return e
}

// Ausdruck ohne Struct-Literal auf oberster Ebene (Bedingungen).
fn cond_expr(p: *mut Parser) -> u32 {
    (*p).no_slit = (*p).no_slit + 1
    let e: u32 = expr(p)
    (*p).no_slit = (*p).no_slit - 1
    return e
}

// Ausdruck in Klammern/Argumenten: Struct-Literale sind dort erlaubt.
fn inner_expr(p: *mut Parser) -> u32 {
    let remembered: usize = (*p).no_slit
    (*p).no_slit = 0
    (*p).parens = (*p).parens + 1
    let e: u32 = expr(p)
    (*p).parens = (*p).parens - 1
    (*p).no_slit = remembered
    return e
}

fn or_expr(p: *mut Parser) -> u32 {
    var left: u32 = and_expr(p)
    while actual(p, A_OROR) && next(p) {
        next_bump(p)
        let right: u32 = and_expr(p)
        left = ast.expr_new(par_tree(p), ast.E_BIN, B_LOR, left, right, 0)
    }
    return left
}

fn and_expr(p: *mut Parser) -> u32 {
    var left: u32 = cmp_expr(p)
    while actual(p, A_ANDAND) && next(p) {
        next_bump(p)
        let right: u32 = cmp_expr(p)
        left = ast.expr_new(par_tree(p), ast.E_BIN, B_LAND, left, right, 0)
    }
    return left
}

// -1 = kein Vergleichsoperator
fn cmp_op(a: u32) -> i32 {
    if a == A_EQEQ { return B_EQ as i32 }
    if a == A_NOTEQ { return B_NE as i32 }
    if a == A_LT { return B_LT as i32 }
    if a == A_LE { return B_LE as i32 }
    if a == A_GT { return B_GT as i32 }
    if a == A_GE { return B_GE as i32 }
    return -1
}

// Vergleiche sind NICHT assoziativ (SPEC §10.1: genau ein Vergleich).
fn cmp_expr(p: *mut Parser) -> u32 {
    let left: u32 = add_expr(p)
    let op: i32 = cmp_op(kind(p, 0))
    if op < 0 || !next(p) {
        return left
    }
    next_bump(p)
    let right: u32 = add_expr(p)
    var e: u32 = ast.expr_new(par_tree(p), ast.E_BIN, op as u32, left, right, 0)
    while cmp_op(kind(p, 0)) >= 0 && next(p) {
        complain(p)
        let op2: i32 = cmp_op(kind(p, 0))
        next_bump(p)
        let r2: u32 = add_expr(p)
        e = ast.expr_new(par_tree(p), ast.E_BIN, op2 as u32, e, r2, 0)
    }
    return e
}

fn add_op(a: u32) -> i32 {
    if a == A_PLUS { return B_ADD as i32 }
    if a == A_MINUS { return B_SUB as i32 }
    if a == A_PIPE { return B_OR as i32 }
    if a == A_CARET { return B_XOR as i32 }
    return -1
}

fn add_expr(p: *mut Parser) -> u32 {
    var left: u32 = mul_expr(p)
    while add_op(kind(p, 0)) >= 0 && next(p) {
        let op: i32 = add_op(kind(p, 0))
        next_bump(p)
        let right: u32 = mul_expr(p)
        left = ast.expr_new(par_tree(p), ast.E_BIN, op as u32, left, right, 0)
    }
    return left
}

fn mul_op(a: u32) -> i32 {
    if a == A_STAR { return B_MUL as i32 }
    if a == A_SLASH { return B_DIV as i32 }
    if a == A_PERCENT { return B_REM as i32 }
    if a == A_AMP { return B_AND as i32 }
    if a == A_SHL { return B_SHL as i32 }
    if a == A_SHR { return B_SHR as i32 }
    return -1
}

fn mul_expr(p: *mut Parser) -> u32 {
    var left: u32 = un_expr(p)
    while mul_op(kind(p, 0)) >= 0 && next(p) {
        let op: i32 = mul_op(kind(p, 0))
        next_bump(p)
        let right: u32 = un_expr(p)
        left = ast.expr_new(par_tree(p), ast.E_BIN, op as u32, left, right, 0)
    }
    return left
}

fn un_expr(p: *mut Parser) -> u32 {
    let a: u32 = kind(p, 0)
    var op: i32 = -1
    if a == A_MINUS { op = U_NEG as i32 }
    else if a == A_NOT { op = U_NOT as i32 }
    else if a == A_AMP { op = U_ADDR as i32 }
    else if a == A_STAR { op = U_DEREF as i32 }
    if op < 0 {
        return after_expr(p)
    }
    next_bump(p)
    let inner: u32 = un_expr(p)
    return ast.expr_new(par_tree(p), ast.E_UN, op as u32, inner, 0, 0)
}

// Hilfsliste erst SAMMELN, dann am Stueck in `kinder` legen.
//
// Der naheliegende Weg — jedes Argument sofort anhaengen — ist falsch, sobald
// ein Argument selbst einen Aufruf enthaelt: dessen Argumente landen dann
// MITTEN in der aeusseren Liste. Genau das ist beim ersten Lauf passiert; aus
// `f(a, g(b))` wurde `f(a, b, g(b))`. Kinderlisten muessen zusammenhaengend
// sein, also wird die innere Liste zuerst fertig.
fn list_store(p: *mut Parser, tmp: *mut Vec[u32]) -> u32 {
    let off: u32 = ast.child_start(par_tree(p))
    var i: usize = 0
    while i < vec_len[u32](tmp) {
        ast.child_add(par_tree(p), vec_at[u32](tmp, i))
        i = i + 1
    }
    return off
}

// Argumentliste nach bereits verbrauchtem '('. Die Argumente kommen in einen
// ZWISCHENSPEICHER und wandern erst am Stueck in `kinder` — ein geschachtelter
// Aufruf legt sonst seine eigene Liste mittenhinein (dieselbe Lehre wie in
// `liste_ablegen`). Beim Methodenaufruf steht der Empfaenger schon darin.
fn call_args_in(p: *mut Parser, tmp: *mut Vec[u32]) {
    while true {
        if actual(p, A_RPAREN) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        let e: u32 = inner_expr(p)
        vec_push[u32](tmp, e)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RPAREN)
}

fn call_args(p: *mut Parser) -> u32 {
    var tmp: Vec[u32] = vec_new[u32]()
    call_args_in(p, &tmp)
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    return off
}

// RUNDE 45 (impls.rs): `"method " ++ name` — der Aufrufname eines noch nicht
// aufgeloesten Methodenaufrufs. Das Leerzeichen macht ihn zu einem Namen, der
// aus keinem Bezeichner des Quelltextes entstehen kann.
fn method_call_name(p: *mut Parser, nr: u32) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    rt.buf_clear(&(*p).scratch)
    var w: [u8; 7] = "method "
    rt.buf_push_bytes(&(*p).scratch, (&w[0]) as u64, 7)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, nr),
                      intern.intern_length(it, nr))
    return intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                rt.buf_len(&(*p).scratch)) as u32
}

fn after_expr(p: *mut Parser) -> u32 {
    var e: u32 = basic_expr(p)
    while true {
        if !next(p) {
            return e
        }
        let a: u32 = kind(p, 0)
        if a == A_DOT {
            next_bump(p)
            // RUNDE 34 (gc.rs::hook_postfix): `x.as?[C]` — die gepruefte
            // Abwaertsumwandlung. Im Baum ein Aufruf `__gc#as:C`.
            if has_gc(p) && actual(p, A_KWAS) && kind(p, 1) == A_QUESTION {
                next_bump(p)
                next_bump(p)
                if !expect(p, A_LBRACKET) {
                    return e
                }
                if !actual(p, A_IDENT) {
                    complain(p)
                    return e
                }
                let kn: u32 = tok_nr(p, 0)
                next_bump(p)
                if !expect(p, A_RBRACKET) {
                    return e
                }
                let it4: *mut intern.Interner = lexer.lex_names(lx(p))
                rt.buf_clear(&(*p).scratch)
                var px5: [u8; 8] = "__gc#as:"
                rt.buf_push_bytes(&(*p).scratch, (&px5[0]) as u64, 8)
                rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it4, kn),
                                  intern.intern_length(it4, kn))
                let an: u32 = intern.intern_number(it4, rt.buf_ptr(&(*p).scratch),
                                                   rt.buf_len(&(*p).scratch)) as u32
                var tmp4: Vec[u32] = vec_new[u32]()
                vec_push[u32](&tmp4, e)
                let off4: u32 = list_store(p, &tmp4)
                vec_free[u32](&tmp4)
                e = ast.expr_new(par_tree(p), ast.E_CALL, an, off4, 1, 0)
                continue
            }
            if !actual(p, A_IDENT) {
                complain(p)
                return e
            }
            let nr: u32 = tok_nr(p, 0)
            next_bump(p)
            // RUNDE 45 (impls.rs::hook_methodenaufruf): folgt eine Klammer,
            // ist es ein METHODENAUFRUF. Der Empfaenger wird das erste
            // Argument; welche Funktion gemeint ist, entscheidet erst der
            // Typpruefer aus seinem Typ.
            // Die Klammer muss in DERSELBEN Zeile stehen (`weiter`) — sonst
            // waere die naechste Anweisung, die mit `(` beginnt, ein
            // Methodenaufruf des Feldzugriffs davor.
            if next(p) && actual(p, A_LPAREN) {
                next_bump(p)
                var mtmp: Vec[u32] = vec_new[u32]()
                vec_push[u32](&mtmp, e)
                call_args_in(p, &mtmp)
                let mname: u32 = method_call_name(p, nr)
                let mlaen: u32 = vec_len[u32](&mtmp) as u32
                let moff: u32 = list_store(p, &mtmp)
                vec_free[u32](&mtmp)
                e = ast.expr_new(par_tree(p), ast.E_CALL, mname, moff, mlaen, 0)
                continue
            }
            e = ast.expr_new(par_tree(p), ast.E_FIELD, e, nr, 0, 0)
        } else if a == A_LBRACKET {
            // `summe[i32](a, b)` — Aufruf einer generischen Vorlage. Das ist
            // die einzige Stelle, an der `[` nach einem Ausdruck NICHT
            // Indizierung heisst; entschieden wird am NAMEN.
            var template: bool = false
            if has_gen(p) && ast.e_kind(par_tree(p), e) == ast.E_ID {
                template = mono.gen_is_fn(gn(p), ast.e_a(par_tree(p), e))
            }
            if template {
                let base: u32 = ast.e_a(par_tree(p), e)
                var targs: Vec[u32] = vec_new[u32]()
                let ok: bool = ty_args(p, &targs)
                if !ok {
                    vec_free[u32](&targs)
                    return e
                }
                let m: u32 = mono.gen_instance(gn(p), base, &targs, true)
                vec_free[u32](&targs)
                if !expect(p, A_LPAREN) {
                    return e
                }
                let off: u32 = call_args(p)
                let len: u32 = ast.child_count(par_tree(p)) - off
                e = ast.expr_new(par_tree(p), ast.E_CALL, m, off, len, 0)
            } else {
                next_bump(p)
                let idx: u32 = inner_expr(p)
                expect(p, A_RBRACKET)
                e = ast.expr_new(par_tree(p), ast.E_IDX, e, idx, 0, 0)
            }
        } else if a == A_LPAREN {
            // Nur direkte Funktionsnamen koennen aufgerufen werden (Stufe 0).
            if ast.e_kind(par_tree(p), e) != ast.E_ID {
                complain(p)
                return e
            }
            let name: u32 = ast.e_a(par_tree(p), e)
            next_bump(p)
            let off: u32 = call_args(p)
            let len: u32 = ast.child_count(par_tree(p)) - off
            e = ast.expr_new(par_tree(p), ast.E_CALL, name, off, len, 0)
        } else if a == A_KWAS {
            next_bump(p)
            let t: u32 = ty(p)
            if t == ast.NOTHING {
                return e
            }
            e = ast.expr_new(par_tree(p), ast.E_AS, e, t, 0, 0)
        } else {
            return e
        }
    }
    return e
}

// `Name{ feld: wert, ... }` — '{' steht noch an.
fn struct_literal(p: *mut Parser, name: u32) -> u32 {
    next_bump(p)
    var tmp: Vec[u32] = vec_new[u32]()
    while true {
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let value: u32 = inner_expr(p)
        vec_push[u32](&tmp, fname)
        vec_push[u32](&tmp, value)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    let len: u32 = vec_len[u32](&tmp) as u32 / 2
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    return ast.expr_new(par_tree(p), ast.E_SLIT, name, off, len, 0)
}

// Ein Zeichenkettenliteral wird zu einem ARRAY-LITERAL aus Ganzzahlen —
// genauso wie in `firnc0`. Damit ist der Typ `[u8; N]` bzw. `[u16; N]`, und
// Typpruefer und Lowering brauchen nichts Eigenes. Der Aufbau liest aus dem
// uebergebenen Lexer, damit ihn die Interpolation fuer ihre Textsegmente
// wiederverwendet (Runde 39).
fn alit_out_lit(p: *mut Parser, lx2: *mut lexer.Lexer, k: usize) -> u32 {
    let la: u32 = lexer.lex_lit_kind(lx2, k)
    let n: usize = lexer.lex_lit_len(lx2, k)
    var tmp: Vec[u32] = vec_new[u32]()
    var i: usize = 0
    while i < n {
        var w: u64 = 0
        if la == 2 {
            w = lexer.lex_lit_unit(lx2, k, i) as u64
        } else {
            w = lexer.lex_lit_byte(lx2, k, i) as u64
        }
        vec_push[u32](&tmp, ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, w))
        i = i + 1
    }
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    return ast.expr_new(par_tree(p), ast.E_ALIT, 0, off, n as u32, 0)
}

// ------------------------------------------------------- Inline-Assembler
//
// RUNDE 52 (compiler/src/core.rs). Grammatik:
//
//   asm_ausdruck = "asm" "(" str_lit { "," asm_op } ")" ;
//   asm_op       = "in"      "(" str_lit ")" ausdruck
//                | "out"     "(" str_lit ")"
//                | "clobber" "(" str_lit ")" ;
//
// Im Baum bleibt ein Aufruf `asm$<nummer>` mit den EINGABEAUSDRUECKEN als
// Argumenten; Vorlage, Register und Clobber liegen im Baum-Register
// (`ast.asm_dazu`). Genau diese Aufteilung hat auch `firnc0` — deshalb
// druckt `--emit=ast-kanon` auf beiden Seiten denselben Text.

// Zeichenkettenliteral an der aktuellen Stelle als internierte Nummer.
fn lit_intern(p: *mut Parser) -> u32 {
    let k: usize = tok_nr(p, 0) as usize
    let n: usize = lexer.lex_lit_len(lx(p), k)
    rt.buf_clear(&(*p).scratch)
    var i: usize = 0
    while i < n {
        rt.buf_push(&(*p).scratch, lexer.lex_lit_byte(lx(p), k, i))
        i = i + 1
    }
    next_bump(p)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    return intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                rt.buf_len(&(*p).scratch)) as u32
}

fn asm_block(p: *mut Parser) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    next_bump(p)
    next_bump(p)
    let template: u32 = lit_intern(p)
    var out: u32 = ast.NOTHING
    var regs: Vec[u32] = vec_new[u32]()
    var clobs: Vec[u32] = vec_new[u32]()
    var args: Vec[u32] = vec_new[u32]()
    var ow: [u8; 3] = "out"
    var cw: [u8; 7] = "clobber"
    while eat(p, A_COMMA) {
        if actual(p, A_RPAREN) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        var which: u32 = 3
        if actual(p, A_KWIN) {
            next_bump(p)
            which = 0
        } else if actual(p, A_IDENT) && intern.intern_equal(it, tok_nr(p, 0), (&ow[0]) as u64, 3) {
            next_bump(p)
            which = 1
        } else if actual(p, A_IDENT) && intern.intern_equal(it, tok_nr(p, 0), (&cw[0]) as u64, 7) {
            next_bump(p)
            which = 2
        }
        if which == 3 {
            complain(p)
            break
        }
        if !expect(p, A_LPAREN) {
            break
        }
        if !actual(p, A_STR) {
            complain(p)
            break
        }
        let reg: u32 = lit_intern(p)
        if !expect(p, A_RPAREN) {
            break
        }
        if which == 0 {
            vec_push[u32](&regs, reg)
            vec_push[u32](&args, inner_expr(p))
        } else if which == 1 {
            if out != ast.NOTHING {
                complain(p)
            }
            out = reg
        } else {
            vec_push[u32](&clobs, reg)
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RPAREN)
    let blk: u32 = ast.asm_add(par_tree(p), template, out, &regs, &clobs)
    vec_free[u32](&regs)
    vec_free[u32](&clobs)
    rt.buf_clear(&(*p).scratch)
    var pw: [u8; 4] = "asm$"
    rt.buf_push_bytes(&(*p).scratch, (&pw[0]) as u64, 4)
    rt.buf_push_dec_u64(&(*p).scratch, blk as u64)
    let name: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                         rt.buf_len(&(*p).scratch)) as u32
    let off: u32 = list_store(p, &args)
    let len: u32 = vec_len[u32](&args) as u32
    vec_free[u32](&args)
    return ast.expr_new(par_tree(p), ast.E_CALL, name, off, len, 0)
}

fn text_literal(p: *mut Parser) -> u32 {
    let k: usize = tok_nr(p, 0) as usize
    let n: usize = lexer.lex_lit_len(lx(p), k)
    next_bump(p)
    if n == 0 {
        complain(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    return alit_out_lit(p, lx(p), k)
}

// ------------------------------------------------------------ Interpolation
//
// `f"..."` (Runde 39): der Parser zerlegt den Rumpf ZUR UeBERSETZUNGSZEIT
// in eine Aufrufkette auf den Fmt-Builder aus `std.io` — keine Varargs,
// kein Laufzeit-Parsen. Dieselbe Uebersetzung wie in firnc0
// (`parser.rs::interpolation`): aus `f"x = {x}!"` wird
// `io.fmt_text(io.fmt_zahl(io.fmt_text(io.fmt_neu(), &_fseg0_0[0], 6),
//                       (x) as i64), &_fseg0_1[0], 1)`.
// Die Textsegmente werden als versteckte `let _fsegK_N: [u8; N]` vor die
// umgebende Anweisung gehoben (`block` leert `hoist`). Wer `f"..."`
// schreibt, braucht `import std.io`.

// Name eines versteckten Textsegments: `_fseg<knotenstand>`. `firnc0`
// nummeriert mit seiner `ExprId` (`_fseg{next_id}`); der Knotenstand des
// gemeinsamen Baums ist hier dieselbe Zahl — so bleiben die kanonischen
// Baeume beider Compiler zeichengleich (tools/parser_compare.sh).
fn interp_seg_name(p: *mut Parser, state: usize) -> u32 {
    var b: rt.Buf = rt.buf_new()
    defer rt.buf_free(&b)
    var t: [u8; 5] = "_fseg"
    rt.buf_push_bytes(&b, (&t[0]) as u64, 5)
    rt.buf_push_dec_u64(&b, state as u64)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    return intern.intern_number(it, rt.buf_ptr(&b), rt.buf_len(&b)) as u32
}

// Ein Textsegment: `"` + Rumpf + `"` neu lexen (die Entschluesselung ist
// so per Bauart dieselbe wie bei einem handgeschriebenen Literal), als
// verstecktes `let _fsegK_N: [u8; N]` anmelden und
// `io.fmt_text(kette, &name[0] as u64, N)` an die Kette haengen.
fn interp_text(p: *mut Parser, chain: u32, io_nr: u32, k: usize, of: usize, to: usize) -> u32 {
    var source: rt.Buf = rt.buf_new()
    defer rt.buf_free(&source)
    rt.buf_push(&source, 34 as u8)
    var i: usize = of
    while i < to {
        rt.buf_push(&source, lexer.lex_lit_byte(lx(p), k, i))
        i = i + 1
    }
    rt.buf_push(&source, 34 as u8)
    var dname: [u8; 9] = "<segment>"
    var l2: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&source), rt.buf_len(&source),
        lexer.lex_kw_ptr(lx(p)), lexer.lex_kw_len(lx(p)), (&dname[0]) as u64, 9)
    lexer.lex_names_set(&l2, lexer.lex_names(lx(p)) as u64)
    lexer.lex_run(&l2)
    if lexer.lex_error(&l2) > 0 {
        complain(p)
        lexer.lex_free(&l2)
        return chain
    }
    let state: usize = vec_len[u32](&(*par_tree(p)).e_kind)
    let alit: u32 = alit_out_lit(p, (&l2) as *mut lexer.Lexer, 0)
    lexer.lex_free(&l2)
    let elen: u32 = ast.e_c(par_tree(p), alit)
    if elen == 0 {
        return chain
    }
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let seg_name: u32 = interp_seg_name(p, state)
    var u8t: [u8; 2] = "u8"
    let u8nr: u32 = intern.intern_number(it, (&u8t[0]) as u64, 2) as u32
    let u8typ: u32 = ast.ty_new(par_tree(p), ast.T_NAME, u8nr, 0)
    let arrtyp: u32 = ast.ty_new(par_tree(p), ast.T_ARR, u8typ, elen as u64)
    let var_s: u32 = ast.stmt_new(par_tree(p), ast.S_LET, seg_name, arrtyp, alit, 0)
    vec_push[u32](&(*p).hoist, var_s)
    let id: u32 = ast.expr_new(par_tree(p), ast.E_ID, seg_name, 0, 0, 0)
    let null: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    let idx: u32 = ast.expr_new(par_tree(p), ast.E_IDX, id, null, 0, 0)
    let addr: u32 = ast.expr_new(par_tree(p), ast.E_UN, U_ADDR, idx, 0, 0)
    var u64t: [u8; 3] = "u64"
    let u64nr: u32 = intern.intern_number(it, (&u64t[0]) as u64, 3) as u32
    let u64typ: u32 = ast.ty_new(par_tree(p), ast.T_NAME, u64nr, 0)
    let ptr: u32 = ast.expr_new(par_tree(p), ast.E_AS, addr, u64typ, 0, 0)
    let len: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, elen as u64)
    var ft: [u8; 8] = "fmt_text"
    let text_nr: u32 = qualify(p, io_nr, intern.intern_number(it, (&ft[0]) as u64, 8) as u32)
    let aoff: u32 = ast.child_start(par_tree(p))
    ast.child_add(par_tree(p), chain)
    ast.child_add(par_tree(p), ptr)
    ast.child_add(par_tree(p), len)
    return ast.expr_new(par_tree(p), ast.E_CALL, text_nr, aoff, 3, 0)
}

// Ein Ausdruckssegment: das Fragment neu lexen, mit einer Parser-Kopie
// EINEN Ausdruck daraus parsen (derselbe Baum, dieselben Register, dieselbe
// Namenstafel, dieselben lokalen Namen) und als
// `io.fmt_zahl(kette, (ausdruck) as i64)` an die Kette haengen.
fn interp_expr(p: *mut Parser, chain: u32, io_nr: u32, k: usize, of: usize, to: usize) -> u32 {
    var source: rt.Buf = rt.buf_new()
    defer rt.buf_free(&source)
    var i: usize = of
    while i < to {
        rt.buf_push(&source, lexer.lex_lit_byte(lx(p), k, i))
        i = i + 1
    }
    var dname: [u8; 12] = "<expression>"
    var l2: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&source), rt.buf_len(&source),
        lexer.lex_kw_ptr(lx(p)), lexer.lex_kw_len(lx(p)), (&dname[0]) as u64, 12)
    lexer.lex_names_set(&l2, lexer.lex_names(lx(p)) as u64)
    lexer.lex_run(&l2)
    if lexer.lex_error(&l2) > 0 {
        complain(p)
        lexer.lex_free(&l2)
        return chain
    }
    // Die Kopie teilt alles, was Ausdruecke brauchen (Baum, Register,
    // Module, lokale Namen); `interp = 1` sperrt die Schachtelung.
    // Der Baum wird UEBER `fremd` geteilt: im Wurzelbetrieb (fremd == 0,
    // die Dump-Werkzeuge) zeigt `par_baum` sonst auf die BAUM-KOPIE der
    // Kopie — die Ausdrucksknoten laenden im Stapelrahmen und waeren nach
    // der Rueckkehr tot (Segfault in astdump auf `f"{x}"`).
    var sub: Parser = (*p)
    sub.foreign = par_tree(p) as u64
    sub.lx = (&l2) as u64
    sub.pos = 0
    sub.n = lexer.lex_count(&l2)
    sub.parens = 0
    sub.no_slit = 0
    sub.interp = 1
    let e: u32 = inner_expr(&sub)
    (*p).err = sub.err
    if sub.not_core {
        (*p).not_core = true
    }
    let whole: bool = actual(&sub, A_EOF)
    lexer.lex_free(&l2)
    if !whole {
        complain(p)
        return chain
    }
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    var i64t: [u8; 3] = "i64"
    let i64nr: u32 = intern.intern_number(it, (&i64t[0]) as u64, 3) as u32
    let i64typ: u32 = ast.ty_new(par_tree(p), ast.T_NAME, i64nr, 0)
    let cast: u32 = ast.expr_new(par_tree(p), ast.E_AS, e, i64typ, 0, 0)
    var fz: [u8; 10] = "fmt_number"
    let number_nr: u32 = qualify(p, io_nr, intern.intern_number(it, (&fz[0]) as u64, 10) as u32)
    let aoff: u32 = ast.child_start(par_tree(p))
    ast.child_add(par_tree(p), chain)
    ast.child_add(par_tree(p), cast)
    return ast.expr_new(par_tree(p), ast.E_CALL, number_nr, aoff, 2, 0)
}

fn interpolation(p: *mut Parser) -> u32 {
    let k: usize = tok_nr(p, 0) as usize
    let n: usize = lexer.lex_lit_len(lx(p), k)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if (*p).interp > 0 {
        // Ein f"..." im Ausdruck eines f"..." — noch nicht (Runde 39).
        complain(p)
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    var io_t: [u8; 2] = "io"
    let io_nr: u32 = intern.intern_number(it, (&io_t[0]) as u64, 2) as u32
    if !is_module(p, io_nr) {
        // Ohne `import std.io` gibt es die Bausteine nicht — derselbe
        // Stand wie bei einem handgeschriebenen `io.` ohne Import.
        complain(p)
    }
    var fn_t: [u8; 7] = "fmt_new"
    let new_nr: u32 = qualify(p, io_nr, intern.intern_number(it, (&fn_t[0]) as u64, 7) as u32)
    var chain: u32 = ast.expr_new(par_tree(p), ast.E_CALL, new_nr, ast.child_start(par_tree(p)), 0, 0)
    var i: usize = 0
    var text_of: usize = 0
    while i < n {
        let b: u32 = lexer.lex_lit_byte(lx(p), k, i) as u32
        if b == 125 {
            // '}' ohne '{'
            complain(p)
            break
        }
        if b == 92 {
            // Maskierung gehoert dem Textsegment
            i = i + 2
            continue
        }
        if b != 123 {
            i = i + 1
            continue
        }
        if i > text_of {
            chain = interp_text(p, chain, io_nr, k, text_of, i)
        }
        var j: usize = i + 1
        var closed: bool = false
        while j < n {
            let b2: u32 = lexer.lex_lit_byte(lx(p), k, j) as u32
            if b2 == 123 {
                // '{' im Ausdruck — Kernfassung: keine Schachtelung
                complain(p)
                break
            }
            if b2 == 125 {
                closed = true
                break
            }
            j = j + 1
        }
        if !closed {
            complain(p)
            break
        }
        chain = interp_expr(p, chain, io_nr, k, i + 1, j)
        i = j + 1
        text_of = i
    }
    if text_of < n {
        chain = interp_text(p, chain, io_nr, k, text_of, n)
    }
    next_bump(p)
    return chain
}

// `size_of[Typname]()` — `size_of` ist gelesen, `[` steht an.
//
// BEWUSST NUR EIN TYPNAME, kein voller Typausdruck: genau wie `sizeof.rs`.
fn size_of_expr(p: *mut Parser) -> u32 {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    let tn: u32 = tok_nr(p, 0)
    next_bump(p)
    if !expect(p, A_RBRACKET) {
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    if !expect(p, A_LPAREN) {
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    if !expect(p, A_RPAREN) {
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    let t: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tn, 0)
    let name: u32 = mono.gen_size_of_name(gn(p), t)
    return ast.expr_new(par_tree(p), ast.E_CALL, name, 0, 0, (t as u64) + 1)
}

fn basic_expr(p: *mut Parser) -> u32 {
    let a: u32 = kind(p, 0)
    // `try ausdruck` — der Operand ist ein UNAERER Ausdruck, der Aufruf
    // heisst `__try#` (errors.rs::hook_primary, TRY_NAME).
    if a == A_KWTRY && has_fe(p) {
        next_bump(p)
        let inner: u32 = un_expr(p)
        let off: u32 = ast.child_start(par_tree(p))
        ast.child_add(par_tree(p), inner)
        var tn: [u8; 6] = "__try#"
        let it: *mut intern.Interner = lexer.lex_names(lx(p))
        let name: u32 = intern.intern_number(it, (&tn[0]) as u64, 6) as u32
        return ast.expr_new(par_tree(p), ast.E_CALL, name, off, 1, 0)
    }
    if a == A_INT {
        let v: u64 = number(p)
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, v)
    }
    if a == A_FLOAT {
        let v: u64 = number(p)
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_FLOAT, 0, 0, 0, v)
    }
    if a == A_STR {
        return text_literal(p)
    }
    if a == A_FSTR {
        return interpolation(p)
    }
    if a == A_KWTRUE {
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_BOOL, 1, 0, 0, 0)
    }
    if a == A_KWFALSE {
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_BOOL, 0, 0, 0, 0)
    }
    if a == A_LPAREN {
        next_bump(p)
        let e: u32 = inner_expr(p)
        expect(p, A_RPAREN)
        return e
    }
    if a == A_LBRACKET {
        next_bump(p)
        var tmp: Vec[u32] = vec_new[u32]()
        var done: bool = false
        if !actual(p, A_RBRACKET) && !at_end(p) {
            let first: u32 = inner_expr(p)
            if actual(p, A_SEMI) {
                next_bump(p)
                let count: u32 = inner_expr(p)
                expect(p, A_RBRACKET)
                vec_free[u32](&tmp)
                return ast.expr_new(par_tree(p), ast.E_AWDH, first, count, 0, 0)
            }
            vec_push[u32](&tmp, first)
            if !eat(p, A_COMMA) {
                expect(p, A_RBRACKET)
                done = true
            }
        }
        while !done {
            if actual(p, A_RBRACKET) || at_end(p) {
                break
            }
            let before: usize = (*p).pos
            let e: u32 = inner_expr(p)
            vec_push[u32](&tmp, e)
            if !eat(p, A_COMMA) {
                break
            }
            if (*p).pos == before {
                next_bump(p)
            }
        }
        if !done {
            expect(p, A_RBRACKET)
        }
        let len: u32 = vec_len[u32](&tmp) as u32
        let off: u32 = list_store(p, &tmp)
        vec_free[u32](&tmp)
        return ast.expr_new(par_tree(p), ast.E_ALIT, 0, off, len, 0)
    }
    if a == A_KWSYSCALL {
        next_bump(p)
        expect(p, A_LPAREN)
        let off: u32 = call_args(p)
        let len: u32 = ast.child_count(par_tree(p)) - off
        return ast.expr_new(par_tree(p), ast.E_SYSCALL, 0, off, len, 0)
    }
    if a == A_IDENT {
        // RUNDE 52 (core.rs::hook_primary): `asm("…", in("dx") p, out("rax"),
        // clobber("memory"))`. NUR wenn auf `asm` unmittelbar `(` und ein
        // Zeichenkettenliteral folgen — sonst bleibt `asm` ein gewoehnlicher
        // Bezeichner und es gibt kein neues Schluesselwort.
        var asmw: [u8; 3] = "asm"
        let is_asm: bool = intern.intern_equal(lexer.lex_names(lx(p)), tok_nr(p, 0), (&asmw[0]) as u64, 3)
        if is_asm && kind(p, 1) == A_LPAREN && kind(p, 2) == A_STR {
            return asm_block(p)
        }
        let nr: u32 = tok_nr(p, 0)
        next_bump(p)
        // RUNDE 34 (gc.rs::hook_primary): `gc C{ ... }`, `gc_null[C]()` und
        // `weak_null[C]()`.
        if has_gc(p) {
            let it3: *mut intern.Interner = lexer.lex_names(lx(p))
            var gw2: [u8; 2] = "gc"
            if intern.intern_equal(it3, nr, (&gw2[0]) as u64, 2) {
                if actual(p, A_IDENT) && kind(p, 1) == A_LBRACE {
                    var cw2: [u8; 5] = "class"
                    if !intern.intern_equal(it3, tok_nr(p, 0), (&cw2[0]) as u64, 5) {
                        let kn: u32 = tok_nr(p, 0)
                        next_bump(p)
                        // "gc C" — mit Leerzeichen, kann nie ein Bezeichner
                        // des Quelltextes sein.
                        var tr2: [u8; 1] = " "
                        let whole: u32 = join(p, nr, (&tr2[0]) as u64, 1, kn)
                        // kein_slit gilt hier nicht: die Klammer gehoert zur
                        // Allokation, nicht zur Kontrollstruktur.
                        let lit: u32 = struct_literal(p, whole)
                        var tmp2: Vec[u32] = vec_new[u32]()
                        vec_push[u32](&tmp2, lit)
                        let off2: u32 = list_store(p, &tmp2)
                        vec_free[u32](&tmp2)
                        return ast.expr_new(par_tree(p), ast.E_CALL, whole, off2, 1, 0)
                    }
                }
            }
            var gn1: [u8; 7] = "gc_null"
            var gn2: [u8; 9] = "weak_null"
            let is_gnull: bool = intern.intern_equal(it3, nr, (&gn1[0]) as u64, 7)
            let is_wnull: bool = intern.intern_equal(it3, nr, (&gn2[0]) as u64, 9)
            if (is_gnull || is_wnull) && actual(p, A_LBRACKET) {
                next_bump(p)
                if !actual(p, A_IDENT) {
                    complain(p)
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                let kn: u32 = tok_nr(p, 0)
                next_bump(p)
                if !expect(p, A_RBRACKET) {
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                if !expect(p, A_LPAREN) {
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                if !expect(p, A_RPAREN) {
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                if is_gnull {
                    // `0 as Gc[C]` — der Nullwert ist der Nullzeiger.
                    rt.buf_clear(&(*p).scratch)
                    var px3: [u8; 7] = "__gc#p:"
                    rt.buf_push_bytes(&(*p).scratch, (&px3[0]) as u64, 7)
                    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it3, kn),
                                      intern.intern_length(it3, kn))
                    let tn: u32 = intern.intern_number(it3, rt.buf_ptr(&(*p).scratch),
                                                       rt.buf_len(&(*p).scratch)) as u32
                    let tn2: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tn, 0)
                    let null: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                    return ast.expr_new(par_tree(p), ast.E_AS, null, tn2, 0, 0)
                }
                // `GcWeak[C]{ __p: 0, __s: 0 }` — der leere schwache Verweis.
                rt.buf_clear(&(*p).scratch)
                var px4: [u8; 7] = "GcWeak["
                rt.buf_push_bytes(&(*p).scratch, (&px4[0]) as u64, 7)
                rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it3, kn),
                                  intern.intern_length(it3, kn))
                rt.buf_push(&(*p).scratch, 93 as u8)
                let wn: u32 = intern.intern_number(it3, rt.buf_ptr(&(*p).scratch),
                                                   rt.buf_len(&(*p).scratch)) as u32
                var wp2: [u8; 3] = "__p"
                var ws2: [u8; 3] = "__s"
                let wp_n: u32 = intern.intern_number(it3, (&wp2[0]) as u64, 3) as u32
                let ws_n: u32 = intern.intern_number(it3, (&ws2[0]) as u64, 3) as u32
                let n1: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                let n2: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                var tmp3: Vec[u32] = vec_new[u32]()
                vec_push[u32](&tmp3, wp_n)
                vec_push[u32](&tmp3, n1)
                vec_push[u32](&tmp3, ws_n)
                vec_push[u32](&tmp3, n2)
                let off3: u32 = list_store(p, &tmp3)
                vec_free[u32](&tmp3)
                return ast.expr_new(par_tree(p), ast.E_SLIT, wn, off3, 2, 0)
            }
        }
        // `size_of[T]()` — der Typtext wandert in den AUFRUFNAMEN
        // (`size_of$i32`, sizeof.rs), der Typknoten zusaetzlich nach
        // `e_zahl`; aufgeloest wird beides erst im Typpruefer, der die
        // Structtafel kennt.
        if (*p).sonr >= 0 && nr as i64 == (*p).sonr && actual(p, A_LBRACKET) {
            return size_of_expr(p)
        }
        // `Vec[i32]{ ... }` — Literal einer generischen Struktur.
        var gstruct: bool = false
        if has_gen(p) && actual(p, A_LBRACKET) {
            gstruct = mono.gen_is_struct(gn(p), nr)
        }
        if gstruct {
            var targs: Vec[u32] = vec_new[u32]()
            let ok: bool = ty_args(p, &targs)
            if !ok {
                vec_free[u32](&targs)
                return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
            }
            let m: u32 = mono.gen_instance(gn(p), nr, &targs, false)
            vec_free[u32](&targs)
            if actual(p, A_LBRACE) && (*p).no_slit == 0 {
                return struct_literal(p, m)
            }
            complain(p)
            return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
        }
        // `Enum::Variante(..)` — der Aufzaehlungskonstruktor. Erkannt an der
        // FORM (`IDENT :: IDENT`), nicht an einem Register — genau wie
        // `sema_match.rs::hook_primary`. `::` sind ZWEI Doppelpunkttoken;
        // ein eigenes Token gibt es nicht.
        if actual(p, A_COLON) && kind(p, 1) == A_COLON {
            if !has_mu(p) {
                (*p).not_core = true
                complain(p)
                return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
            }
            next_bump(p)
            next_bump(p)
            if !actual(p, A_IDENT) {
                complain(p)
                return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
            }
            let vn: u32 = tok_nr(p, 0)
            next_bump(p)
            // Der vollstaendige Name `Enum::Variante` wird EIN Name. KEINE
            // Umbenennung: Aufzaehlungsnamen gelten programmweit (SPEC §14.1).
            var dp: [u8; 2] = "::"
            let full: u32 = join(p, nr, (&dp[0]) as u64, 2, vn)
            var aoff: u32 = 0
            var alen: u32 = 0
            if actual(p, A_LPAREN) {
                next_bump(p)
                aoff = call_args(p)
                alen = ast.child_count(par_tree(p)) - aoff
            }
            return ast.expr_new(par_tree(p), ast.E_CALL, full, aoff, alen, 0)
        }
        // Steht `(` an, ist das ein AUFRUFNAME — den verdeckt eine lokale
        // Variable nicht (`Renamer::resolve`, is_value = false).
        let q: u32 = maybe_qualified(p, nr, !actual(p, A_LPAREN))
        if actual(p, A_LBRACE) && (*p).no_slit == 0 {
            return struct_literal(p, q)
        }
        return ast.expr_new(par_tree(p), ast.E_ID, q, 0, 0, 0)
    }
    complain(p)
    next_bump(p)
    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
}

// -------------------------------------------------------------- Anweisungen

// Anweisungsende: ';' oder Zeilenwechsel oder '}'.
fn end_stmt(p: *mut Parser) {
    var had: bool = false
    while actual(p, A_SEMI) {
        next_bump(p)
        had = true
    }
    if had || actual(p, A_RBRACE) || at_end(p) || line_start(p) {
        return
    }
    complain(p)
}

fn block(p: *mut Parser) -> u32 {
    if !expect(p, A_LBRACE) {
        return ast.block_new(par_tree(p), 0, 0)
    }
    loc_on(p)
    // Die Anweisungsnummern werden zuerst gesammelt und erst am Ende in
    // `sliste` gelegt — verschachtelte Bloecke wuerden sonst dazwischenfunken.
    var own: Vec[u32] = vec_new[u32]()
    while true {
        if actual(p, A_RBRACE) {
            break
        }
        if at_end(p) {
            complain(p)
            break
        }
        if eat(p, A_SEMI) {
            continue
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        let s: u32 = stmt(p)
        // Versteckte Textsegmente der Interpolation stehen VOR der
        // Anweisung, die ihre Interpolation enthaelt (Runde 39).
        var hi: usize = 0
        while hi < vec_len[u32](&(*p).hoist) {
            vec_push[u32](&own, vec_at[u32](&(*p).hoist, hi))
            hi = hi + 1
        }
        vec_clear[u32](&(*p).hoist)
        vec_push[u32](&own, s)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    eat(p, A_RBRACE)
    let off: u32 = vec_len[u32](&(*par_tree(p)).slist) as u32
    var i: usize = 0
    while i < vec_len[u32](&own) {
        vec_push[u32](&(*par_tree(p)).slist, vec_at[u32](&own, i))
        i = i + 1
    }
    let len: u32 = vec_len[u32](&own) as u32
    vec_free[u32](&own)
    loc_off(p)
    return ast.block_new(par_tree(p), off, len)
}

fn let_stmt(p: *mut Parser) -> u32 {
    var kind_s: u32 = ast.S_LET
    if actual(p, A_KWVAR) {
        kind_s = ast.S_VAR
    }
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    var t: u32 = ast.NOTHING
    if eat(p, A_COLON) {
        t = ty(p)
        if t == ast.NOTHING {
            return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
        }
    }
    if !expect(p, A_ASSIGN) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let init: u32 = expr(p)
    end_stmt(p)
    // ERST JETZT sichtbar: `let x = x + 1` meint rechts das aeussere `x`.
    loc_add(p, name)
    return ast.stmt_new(par_tree(p), kind_s, name, t, init, 0)
}

fn if_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    let cond: u32 = cond_expr(p)
    let then: u32 = block(p)
    var els: u32 = ast.NOTHING
    if actual(p, A_KWELSE) {
        next_bump(p)
        if actual(p, A_KWIF) {
            els = stmt(p)
        } else {
            let b: u32 = block(p)
            els = ast.stmt_new(par_tree(p), ast.S_BLOCK, b, 0, 0, 0)
        }
    }
    return ast.stmt_new(par_tree(p), ast.S_IF, cond, then, els, 0)
}

fn while_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    let cond: u32 = cond_expr(p)
    let body: u32 = block(p)
    return ast.stmt_new(par_tree(p), ast.S_WHILE, cond, body, 0, 0)
}

fn for_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    if !expect(p, A_KWIN) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let of: u32 = cond_expr(p)
    if !expect(p, A_DOTDOT) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let to: u32 = cond_expr(p)
    loc_on(p)
    loc_add(p, name)
    let body: u32 = block(p)
    loc_off(p)
    return ast.stmt_new(par_tree(p), ast.S_FOR, name, of, to, body)
}

fn return_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    var value: u32 = ast.NOTHING
    var has: bool = true
    if actual(p, A_SEMI) || actual(p, A_RBRACE) || at_end(p) || line_start(p) {
        has = false
    }
    if has {
        value = expr(p)
    }
    end_stmt(p)
    return ast.stmt_new(par_tree(p), ast.S_RET, value, 0, 0, 0)
}

fn stmt(p: *mut Parser) -> u32 {
    let a: u32 = kind(p, 0)
    if a == A_KWLET || a == A_KWVAR {
        return let_stmt(p)
    }
    if a == A_KWIF {
        return if_stmt(p)
    }
    if a == A_KWWHILE {
        return while_stmt(p)
    }
    if a == A_KWFOR {
        return for_stmt(p)
    }
    if a == A_KWBREAK {
        next_bump(p)
        end_stmt(p)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    if a == A_KWCONTINUE {
        next_bump(p)
        end_stmt(p)
        return ast.stmt_new(par_tree(p), ast.S_CONT, 0, 0, 0, 0)
    }
    if a == A_KWDEFER || a == A_KWERRDEFER {
        var kind_s: u32 = ast.S_DEFER
        if a == A_KWERRDEFER {
            kind_s = ast.S_ERRDEFER
        }
        next_bump(p)
        let inner: u32 = stmt(p)
        return ast.stmt_new(par_tree(p), kind_s, inner, 0, 0, 0)
    }
    if a == A_KWRETURN {
        return return_stmt(p)
    }
    if a == A_LBRACE {
        let b: u32 = block(p)
        return ast.stmt_new(par_tree(p), ast.S_BLOCK, b, 0, 0, 0)
    }
    if a == A_KWMATCH {
        if !has_mu(p) {
            (*p).not_core = true
            complain(p)
            return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
        }
        return match_stmt(p)
    }
    if a == A_KWCATCH {
        // `catch` steht nie am Anfang einer Anweisung — ein gewoehnlicher
        // Syntaxfehler, wie in Stufe 0. (`try` faellt in den Ausdrucksweg.)
        complain(p)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let e: u32 = expr(p)
    if actual(p, A_ASSIGN) {
        next_bump(p)
        let v: u32 = expr(p)
        end_stmt(p)
        return ast.stmt_new(par_tree(p), ast.S_ZUW, e, v, 0, 0)
    }
    end_stmt(p)
    return ast.stmt_new(par_tree(p), ast.S_EXPR, e, 0, 0, 0)
}

// -------------------------------------------------------------- Deklarationen

fn param_list(p: *mut Parser) -> u32 {
    let off: u32 = vec_len[u32](&(*par_tree(p)).pa_name) as u32
    while true {
        if actual(p, A_RPAREN) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let name: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let t: u32 = ty(p)
        if t == ast.NOTHING {
            break
        }
        ast.param_add(par_tree(p), name, t)
        loc_add(p, name)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    return off
}

// `fn name[T: Int](..) -> R { .. }`
//
// DER NAME BLEIBT UNVERAENDERT, auch in einem Modul: generische Namen gelten
// programmweit und werden unqualifiziert benutzt (`vec_push[i32](..)`).
// Deshalb nimmt `eigene_suchen` sie auch nicht in die Umbenennungsliste auf.
//
// Die Vorlage geht NICHT in die Funktionsliste des Baums — sonst stolperte
// der Typpruefer ueber `T` und `--emit=ast-kanon` druckte sie, was `firnc0`
// nicht tut. Ihre Knoten stehen sehr wohl im Baum; gemerkt werden nur die
// Einstiegspunkte.
fn fn_template(p: *mut Parser, name: u32) {
    if !ty_param_list(p) {
        return
    }
    let toff: u32 = (*p).tpoff
    let tlen: u32 = mono.gen_tp_start(gn(p)) - toff
    if !expect(p, A_LPAREN) {
        return
    }
    // Waehrend des Rumpfes sind alle Auspraegungen ABSTRAKT: `Vec[T]` ist
    // noch keine Arbeit, sondern eine Vorschrift.
    mono.gen_depth_on(gn(p))
    loc_on(p)
    let poff: u32 = param_list(p)
    expect(p, A_RPAREN)
    let plen: u32 = ast.param_start(par_tree(p)) - poff
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            loc_off(p)
            mono.gen_depth_off(gn(p))
            return
        }
    }
    let body: u32 = block(p)
    loc_off(p)
    mono.gen_depth_off(gn(p))
    mono.gen_fn_template(gn(p), name, toff, tlen, poff, plen, ret, body)
}

// `struct Name[T] { feld: T, .. }`
fn struct_template(p: *mut Parser, name: u32) {
    if !ty_param_list(p) {
        return
    }
    let toff: u32 = (*p).tpoff
    let tlen: u32 = mono.gen_tp_start(gn(p)) - toff
    if !expect(p, A_LBRACE) {
        return
    }
    mono.gen_depth_on(gn(p))
    let off: u32 = ast.field_start(par_tree(p))
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let t: u32 = ty(p)
        if t == ast.NOTHING {
            break
        }
        ast.field_add(par_tree(p), fname, t)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    mono.gen_depth_off(gn(p))
    let flen: u32 = ast.field_start(par_tree(p)) - off
    mono.gen_struct_template(gn(p), name, toff, tlen, off, flen)
}

fn fn_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let raw: u32 = tok_nr(p, 0)
    next_bump(p)
    // Eine Typparameterliste macht daraus eine generische VORLAGE.
    if actual(p, A_LBRACKET) {
        if !has_gen(p) {
            (*p).not_core = true
            complain(p)
            return
        }
        fn_template(p, raw)
        return
    }
    let name: u32 = renamed(p, raw)
    if !expect(p, A_LPAREN) {
        return
    }
    loc_on(p)
    let poff: u32 = param_list(p)
    expect(p, A_RPAREN)
    let plen: u32 = vec_len[u32](&(*par_tree(p)).pa_name) as u32 - poff
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            loc_off(p)
            return
        }
    }
    let body: u32 = block(p)
    loc_off(p)
    ast.fn_add(par_tree(p), name, poff, plen, ret, body, (*p).nogc_pending,
                (*p).mc_pending, (*p).int_pending)
    (*p).nogc_pending = 0
    (*p).mc_pending = 0
    (*p).int_pending = 0
}

fn struct_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let raw: u32 = tok_nr(p, 0)
    next_bump(p)
    if actual(p, A_LBRACKET) {
        if !has_gen(p) {
            (*p).not_core = true
            complain(p)
            return
        }
        struct_template(p, raw)
        return
    }
    let name: u32 = renamed(p, raw)
    if !expect(p, A_LBRACE) {
        return
    }
    let off: u32 = vec_len[u32](&(*par_tree(p)).fd_name) as u32
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let t: u32 = ty(p)
        if t == ast.NOTHING {
            break
        }
        ast.field_add(par_tree(p), fname, t)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    let len: u32 = vec_len[u32](&(*par_tree(p)).fd_name) as u32 - off
    ast.structure_add(par_tree(p), name, off, len, (*p).mc_pending)
    (*p).mc_pending = 0
}

fn const_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let name: u32 = renamed(p, tok_nr(p, 0))
    next_bump(p)
    if !expect(p, A_COLON) {
        return
    }
    let t: u32 = ty(p)
    if t == ast.NOTHING {
        return
    }
    if !expect(p, A_ASSIGN) {
        return
    }
    let w: u32 = expr(p)
    end_stmt(p)
    ast.const_add(par_tree(p), name, t, w)
}

fn import_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    rt.buf_clear(&(*p).scratch)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    var last: u32 = tok_nr(p, 0)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, last), intern.intern_length(it, last))
    next_bump(p)
    while actual(p, A_DOT) && kind(p, 1) == A_IDENT {
        next_bump(p)
        last = tok_nr(p, 0)
        rt.buf_push(&(*p).scratch, 46 as u8)
        rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, last), intern.intern_length(it, last))
        next_bump(p)
    }
    let path: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch), rt.buf_len(&(*p).scratch)) as u32
    ast.imp_add(par_tree(p), path, last)
    vec_push[u32](&(*p).module, last)
    end_stmt(p)
}

fn export_decl(p: *mut Parser) {
    next_bump(p)
    if !expect(p, A_LBRACE) {
        return
    }
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        ast.exp_add(par_tree(p), tok_nr(p, 0))
        next_bump(p)
    }
    expect(p, A_RBRACE)
}

fn profile_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    ast.profile_set(par_tree(p), tok_nr(p, 0))
    next_bump(p)
    end_stmt(p)
}

// ------------------------------------------------------ enum und match
//
// Portierung der Parser-Hooks aus `sema_match.rs`. Die FAELLE eines `match`
// stehen NICHT im Baum, sondern im Muster-Register (`pattern.fi`); im Baum
// bleibt ein Aufruf `__match#<nummer>` ohne Argumente. So kann auch eine
// generische Vorlage die Faelle je Auspraegung ersetzen — und
// `--emit=ast-kanon` druckt genau das, was Stufe 0 druckt.

// `::` sind zwei unmittelbar aufeinanderfolgende Doppelpunkttoken.
fn colon(p: *mut Parser, k: usize) -> bool {
    return kind(p, k) == A_COLON && kind(p, k + 1) == A_COLON
}

// `enum Name { A, B(i32), C(Punkt, bool) }`
fn enum_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    // KEINE Umbenennung: Aufzaehlungsnamen gelten programmweit (SPEC §14.1).
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    if !expect(p, A_LBRACE) {
        return
    }
    let ei: u32 = pattern.pat_enum_add(mn(p), name)
    while true {
        while eat(p, A_COMMA) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let vname: u32 = tok_nr(p, 0)
        next_bump(p)
        let toff: u32 = pattern.pat_vt_start(mn(p))
        var tlen: u32 = 0
        if eat(p, A_LPAREN) {
            while true {
                if actual(p, A_RPAREN) || at_end(p) {
                    break
                }
                let vor2: usize = (*p).pos
                let t: u32 = ty(p)
                if t == ast.NOTHING {
                    break
                }
                pattern.pat_vt_add(mn(p), t)
                tlen = tlen + 1
                if !eat(p, A_COMMA) {
                    break
                }
                if (*p).pos == vor2 {
                    next_bump(p)
                }
            }
            expect(p, A_RPAREN)
        }
        pattern.pat_variant_add(mn(p), ei, vname, toff, tlen)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    if pattern.pat_e_vlen(mn(p), ei) == 0 {
        // Eine Aufzaehlung ohne Variante ist ein Fehler (wie in Stufe 0).
        complain(p)
    }
}

// `error Name { A, B, C }` — eine Fehlermenge (errors.rs::errors_decl).
// KEINE Umbenennung des Namens: Fehlermengen gelten programmweit, genau wie
// Aufzaehlungsnamen (SPEC §14.1). Codes ab 1 in Deklarationsreihenfolge.
fn error_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    if !expect(p, A_LBRACE) {
        return
    }
    let mi: u32 = err.error_set_add(fh(p), name)
    if mi == NONE {
        // fehlermenge ist bereits deklariert
        complain(p)
    }
    var n: u32 = 0
    while true {
        while eat(p, A_COMMA) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let vn: u32 = tok_nr(p, 0)
        next_bump(p)
        // Doppelt deklarierte Variante ist ein Fehler (wie in Stufe 0).
        if mi != NONE {
            if !err.error_variant_add(fh(p), mi, vn) {
                complain(p)
            }
        }
        n = n + 1
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    if n == 0 {
        // Eine Fehlermenge ohne Variante ist ein Fehler (wie in Stufe 0).
        complain(p)
    }
}

// Ganzzahl in einem Muster, optional mit Vorzeichen.
fn pattern_int(p: *mut Parser, good: *mut bool) -> i64 {
    var neg: bool = false
    if eat(p, A_MINUS) {
        neg = true
    }
    if !actual(p, A_INT) {
        complain(p)
        *good = false
        return 0
    }
    let v: u64 = number(p)
    next_bump(p)
    if neg {
        return 0 - (v as i64)
    }
    return v as i64
}

// Ein Muster (SPEC §6.3). Bindungen werden sofort als lokale Namen
// angemeldet — der Rumpf des Falls wird danach geparst und muss sie sehen.
fn pattern(p: *mut Parser, depth: u32) -> u32 {
    if depth > 32 {
        complain(p)
        return ast.NOTHING
    }
    let a: u32 = kind(p, 0)
    if a == A_KWTRUE {
        next_bump(p)
        return pattern.pat_mu_add(mn(p), pattern.MU_BOOL, 1, 0, 0, 0, 0, 0)
    }
    if a == A_KWFALSE {
        next_bump(p)
        return pattern.pat_mu_add(mn(p), pattern.MU_BOOL, 0, 0, 0, 0, 0, 0)
    }
    if a == A_INT || a == A_MINUS {
        var good: bool = true
        let lo: i64 = pattern_int(p, &good)
        if !good {
            return ast.NOTHING
        }
        if actual(p, A_DOTDOT) {
            next_bump(p)
            var incl: u32 = 0
            if eat(p, A_ASSIGN) {
                incl = 1
            }
            let hi: i64 = pattern_int(p, &good)
            if !good {
                return ast.NOTHING
            }
            // Ein leerer Bereich ist ein Fehler (wie in Stufe 0).
            if incl == 1 {
                if hi < lo {
                    complain(p)
                    return ast.NOTHING
                }
            } else {
                if hi <= lo {
                    complain(p)
                    return ast.NOTHING
                }
            }
            return pattern.pat_mu_add(mn(p), pattern.MU_RANGE, incl, 0, lo, hi, 0, 0)
        }
        return pattern.pat_mu_add(mn(p), pattern.MU_INT, 0, 0, lo, 0, 0, 0)
    }
    if a == A_IDENT {
        let nr: u32 = tok_nr(p, 0)
        next_bump(p)
        let it: *mut intern.Interner = lexer.lex_names(lx(p))
        var us: [u8; 1] = "_"
        if intern.intern_equal(it, nr, (&us[0]) as u64, 1) {
            return pattern.pat_mu_add(mn(p), pattern.MU_WILD, 0, 0, 0, 0, 0, 0)
        }
        if colon(p, 0) {
            next_bump(p)
            next_bump(p)
            return variants_pattern(p, nr, depth)
        }
        // Bindung des ganzen Wertes
        loc_add(p, nr)
        return pattern.pat_mu_add(mn(p), pattern.MU_BIND, nr, 0, 0, 0, 0, 0)
    }
    if colon(p, 0) {
        // `::Variante` — der Aufzaehlungsname fehlt und wird aus dem
        // Subjekttyp bestimmt.
        next_bump(p)
        next_bump(p)
        return variants_pattern(p, ast.NOTHING, depth)
    }
    complain(p)
    return ast.NOTHING
}

// `Variante(untermuster, ..)` — der Variantenname steht noch an.
fn variants_pattern(p: *mut Parser, ename: u32, depth: u32) -> u32 {
    if !actual(p, A_IDENT) {
        complain(p)
        return ast.NOTHING
    }
    let vname: u32 = tok_nr(p, 0)
    next_bump(p)
    var soff: u32 = 0
    var slen: u32 = 0
    if eat(p, A_LPAREN) {
        var tmp: Vec[u32] = vec_new[u32]()
        while true {
            if actual(p, A_RPAREN) || at_end(p) {
                break
            }
            let before: usize = (*p).pos
            let sub: u32 = pattern(p, depth + 1)
            if sub == ast.NOTHING {
                break
            }
            vec_push[u32](&tmp, sub)
            if !eat(p, A_COMMA) {
                break
            }
            if (*p).pos == before {
                next_bump(p)
            }
        }
        expect(p, A_RPAREN)
        // Erst SAMMELN, dann am Stueck ablegen — die inneren Muster haben
        // ihre eigenen Kinder bereits abgelegt.
        soff = pattern.pat_children_start(mn(p))
        var i: usize = 0
        while i < vec_len[u32](&tmp) {
            pattern.pat_child_add(mn(p), vec_at[u32](&tmp, i))
            i = i + 1
        }
        slen = vec_len[u32](&tmp) as u32
        vec_free[u32](&tmp)
    }
    return pattern.pat_mu_add(mn(p), pattern.MU_VARIANT, ename, vname, 0, 0, soff, slen)
}

// `match subjekt { muster => { .. } .. }` als Anweisung. Wird zum Aufruf
// `__match#<nummer>` ohne Argumente; die Faelle liegen im Muster-Register.
fn match_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    // `match` in einer generischen Vorlage wird nicht unterstuetzt — die
    // Faelle liegen im Register, eine Vorlage koennte sie nicht je
    // Auspraegung ersetzen (Fehler auch in Stufe 0).
    if has_gen(p) {
        if mono.gen_in_template(gn(p)) {
            (*p).not_core = true
            complain(p)
        }
    }
    // Im Subjekt ist kein Structliteral auf oberster Ebene erlaubt —
    // `match X { .. }` liesse sich sonst nicht vom Block unterscheiden.
    let subj: u32 = cond_expr(p)
    if !expect(p, A_LBRACE) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let mi: u32 = pattern.pat_match_add(mn(p), subj)
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        // Die Bindungen des Musters sind im Rumpf sichtbar — und nur dort.
        loc_on(p)
        let pat: u32 = pattern(p, 0)
        if pat == ast.NOTHING {
            loc_off(p)
            break
        }
        // `=>` sind zwei Token: `=` und `>`.
        if !(actual(p, A_ASSIGN) && kind(p, 1) == A_GT) {
            complain(p)
            loc_off(p)
            break
        }
        next_bump(p)
        next_bump(p)
        if !actual(p, A_LBRACE) {
            complain(p)
            loc_off(p)
            break
        }
        let body: u32 = block(p)
        loc_off(p)
        pattern.pat_arm_add(mn(p), mi, pat, body)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    if pattern.pat_m_alen(mn(p), mi) == 0 {
        complain(p)
    }
    // Der Aufrufname traegt die Nummer: `__match#<mi>`.
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    rt.buf_clear(&(*p).scratch)
    var pfx: [u8; 8] = "__match#"
    rt.buf_push_bytes(&(*p).scratch, (&pfx[0]) as u64, 8)
    rt.buf_push_dec_u64(&(*p).scratch, mi as u64)
    let name: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                         rt.buf_len(&(*p).scratch)) as u32
    let e: u32 = ast.expr_new(par_tree(p), ast.E_CALL, name, 0, 0, 0)
    return ast.stmt_new(par_tree(p), ast.S_EXPR, e, 0, 0, 0)
}

// Vorabsuche: alle `import`-Aliasse einsammeln, damit `modul.name` von der
// ERSTEN Zeile an erkannt wird. `firnc0` macht dasselbe.
fn module_upfront(p: *mut Parser) {
    var i: usize = 0
    while i + 1 < (*p).n {
        if lexer.lex_kind(lx(p), i) == A_KWIMPORT {
            var j: usize = i + 1
            var last: u32 = ast.NOTHING
            while j < (*p).n {
                if lexer.lex_kind(lx(p), j) != A_IDENT {
                    break
                }
                last = lexer.lex_nr(lx(p), j)
                j = j + 1
                if j >= (*p).n {
                    break
                }
                if lexer.lex_kind(lx(p), j) != A_DOT {
                    break
                }
                j = j + 1
            }
            if last != ast.NOTHING {
                vec_push[u32](&(*p).module, last)
            }
        }
        i = i + 1
    }
}

// Vorabsuche nach Erweiterungen, die dieser Parser NICHT kennt.
//
// Besser hier als mitten im Abstieg: so steht vor dem ersten Knoten fest, ob
// die Datei ueberhaupt Kernsprache ist, und der Vergleich zaehlt sie sauber
// als "nicht Kern" statt als Abweichung. Erkannt wird am TOKENSTROM:
//
//   enum · match · error · try · catch · comptime · '#'   Schluesselwoerter
//   '?'                                                    `x.as?[C]`
//   '::'                                                   `Enum::Variante`
//   IDENT '['  nach 'fn'/'struct'   generische Vorlage — NUR NOCH DANN eine
//                                   Erweiterung, wenn kein Vorlagenregister
//                                   angemeldet ist (Runde 31)
//   IDENT '!'                                              Fehlerunion `E!T`
//   der Bezeichner `gc`                                    `gc class`, `gc C{}`
fn extensions_search(p: *mut Parser) {
    // Nummer des Bezeichners "gc" — falls er im Text ueberhaupt vorkommt.
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    var gc_word: [u8; 2] = "gc"
    let gc_nr: i64 = intern.intern_find(it, (&gc_word[0]) as u64, 2)
    // Die Intrinsics fuer konstante Laufzeit (`ct.rs`, SPEC §9.2/§9.3) sind
    // gewoehnliche Bezeichner, kein Schluesselwort — sie lassen sich nur am
    // NAMEN erkennen. Wer eine eigene Funktion `select` schreibt, faellt hier
    // faelschlich heraus; das ist die vorsichtige Richtung.
    var ct1: [u8; 6] = "select"
    var ct2: [u8; 7] = "barrier"
    var ct3: [u8; 11] = "secure_zero"
    let ct1_nr: i64 = intern.intern_find(it, (&ct1[0]) as u64, 6)
    let ct2_nr: i64 = intern.intern_find(it, (&ct2[0]) as u64, 7)
    let ct3_nr: i64 = intern.intern_find(it, (&ct3[0]) as u64, 11)

    var i: usize = 0
    while i < (*p).n {
        let a: u32 = lexer.lex_kind(lx(p), i)
        if a == A_KWENUM || a == A_KWMATCH {
            // Gehoert zur Kernsprache, SOBALD das Muster-Register angemeldet
            // ist — derselbe Uebergang wie bei den generischen Vorlagen
            // (Runde 31).
            if !has_mu(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_KWERROR || a == A_KWTRY || a == A_KWCATCH {
            // Gehoert zur Kernsprache, SOBALD die Fehler-Registrierung
            // angemeldet ist — derselbe Uebergang wie bei `enum`/`match`
            // (Runde 32).
            if !has_fe(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_KWERRDEFER {
            // RUNDE 36: gehoert zur Kernsprache, sobald die Fehler-
            // Registrierung angemeldet ist — der Fehlerpfad kommt aus
            // `err.fi`/`lower.fi` (`ret_term_fehler`), derselbe
            // Uebergang wie bei `error`/`try`/`catch` (Runde 33).
            if !has_fe(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_KWCOMPTIME {
            // RUNDE 35: gehoert zur Kernsprache, sobald `par_zeit_setzen`
            // gelaufen ist — derselbe Uebergang wie Runde 31-33.
            if !has_time(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_HASH {
            // RUNDE 34: `#[no_gc]` gehoert zur Kernsprache, sobald die
            // gc-Registrierung angemeldet ist — jedes ANDERE Attribut
            // (`#[must_consume]`, ...) bleibt eine nicht portierte
            // Erweiterung, wie bisher.
            var ok_attr: bool = false
            if has_gc(p) && i + 3 < (*p).n {
                if lexer.lex_kind(lx(p), i + 1) == A_LBRACKET && lexer.lex_kind(lx(p), i + 3) == A_RBRACKET {
                    if lexer.lex_kind(lx(p), i + 2) == A_IDENT {
                        var an: [u8; 5] = "no_gc"
                        var mc: [u8; 12] = "must_consume"
                        // Runde 36: beide umgesetzten Attribute (attrs.rs).
                        // Runde 52: dazu `#[interrupt]` und `#[allow_fp]`.
                        var iw: [u8; 9] = "interrupt"
                        var fw: [u8; 8] = "allow_fp"
                        let anr: u32 = lexer.lex_nr(lx(p), i + 2)
                        let itn: *mut intern.Interner = lexer.lex_names(lx(p))
                        ok_attr = intern.intern_equal(itn, anr, (&an[0]) as u64, 5) ||
                                intern.intern_equal(itn, anr, (&mc[0]) as u64, 12) ||
                                intern.intern_equal(itn, anr, (&iw[0]) as u64, 9) ||
                                intern.intern_equal(itn, anr, (&fw[0]) as u64, 8)
                    }
                }
            }
            if !ok_attr {
                (*p).not_core = true
                return
            }
        }
        if a == A_QUESTION {
            // RUNDE 34: `?` gehoert nur zu `x.as?[C]` — Kern mit Registrierung.
            if !has_gc(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_COLON && i + 1 < (*p).n {
            if lexer.lex_kind(lx(p), i + 1) == A_COLON {
                if !has_mu(p) {
                    (*p).not_core = true
                    return
                }
            }
        }
        if a == A_IDENT {
            let nr: i64 = lexer.lex_nr(lx(p), i) as i64
            if gc_nr >= 0 && nr == gc_nr {
                // RUNDE 34: `gc`/`gc class`/`gc C{}` gehoeren zur Kernsprache,
                // sobald die gc-Registrierung angemeldet ist (derselbe
                // Uebergang wie Runde 31-33, 35).
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if ct1_nr >= 0 && nr == ct1_nr {
                // RUNDE 36: `select(b, a, b)` ist portiert (ct.rs) — derselbe
                // Uebergang wie bei `barrier`: Kern, sobald die gc-
                // Registrierung angemeldet ist; die Dump-Werkzeuge bleiben
                // bei "nicht kern", weil ihre Stufe-0-Seite `Op::Select`
                // druckt.
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if ct2_nr >= 0 && nr == ct2_nr {
                // RUNDE 34: `barrier(x)` ist die undurchsichtige Sperre aus
                // ct.rs — fuer das Verhalten (und diese Stufe hat keinen
                // Optimierer) ist sie die Identitaet. Sie gehoert zur
                // Kernsprache, sobald die gc-Registrierung angemeldet ist:
                // die braucht sie (tests/modules/dom.fi), und nur der
                // richtige Compiler meldet sie an — die Dump-Werkzeuge
                // bleiben bei "nicht kern", weil ihre Stufe-0-Seite das
                // Undurchsichtige (`Op::Barrier`) druckt.
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if ct3_nr >= 0 && nr == ct3_nr {
                // RUNDE 36: `secure_zero(p, n)` ist portiert (ct.rs) —
                // derselbe Uebergang wie bei `select`.
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if i + 1 < (*p).n && lexer.lex_kind(lx(p), i + 1) == A_NOT {
                // `E!T` — die Fehlerunion baut auf IDENT `!` auf.
                if !has_fe(p) {
                    (*p).not_core = true
                    return
                }
            }
            if i > 0 && i + 1 < (*p).n && !has_gen(p) {
                let before: u32 = lexer.lex_kind(lx(p), i - 1)
                if before == A_KWFN || before == A_KWSTRUCT {
                    if lexer.lex_kind(lx(p), i + 1) == A_LBRACKET {
                        (*p).not_core = true
                        return
                    }
                }
            }
        }
        i = i + 1
    }
}

// Sammelt die Namen, die diese Datei auf oberster Ebene deklariert. Nur die
// werden umbenannt — eine Verwendung aus einem anderen Modul steht ohnehin
// qualifiziert da.
fn own_search(p: *mut Parser) {
    if (*p).alias == NONE {
        return
    }
    var i: usize = 0
    while i + 1 < (*p).n {
        // RUNDE 45: die Methoden eines `impl`-Blocks heissen `Typ__methode`
        // und stehen nie unter ihrem kurzen Namen im Modul. `firnc0` sammelt
        // die Namen erst NACH dem Parsen (modules.rs) und sieht sie deshalb
        // ebenfalls nicht — ohne diesen Sprung liefen beide auseinander.
        if is_impl_at(p, i) {
            i = impl_end(p, i)
            continue
        }
        // RUNDE 46: dasselbe fuer `interface I { fn … }`. Die Methoden einer
        // Schnittstelle sind keine Namen des Moduls — `firnc0` sieht sie
        // ebenfalls nie (der Block landet gar nicht im Baum).
        if is_interface_at(p, i) {
            i = impl_end(p, i)
            continue
        }
        let a: u32 = lexer.lex_kind(lx(p), i)
        if a == A_KWFN || a == A_KWSTRUCT || a == A_KWCONST {
            if lexer.lex_kind(lx(p), i + 1) == A_IDENT {
                // Eine generische Vorlage behaelt ihren Namen: generische
                // Namen gelten PROGRAMMWEIT und werden unqualifiziert
                // benutzt. Wer sie umbenennt, macht `vec_push[i32](..)` in
                // der Wurzeldatei unauffindbar.
                var generic: bool = false
                if a != A_KWCONST && i + 2 < (*p).n {
                    generic = lexer.lex_kind(lx(p), i + 2) == A_LBRACKET
                }
                if !generic {
                    vec_push[u32](&(*p).own, lexer.lex_nr(lx(p), i + 1))
                }
            }
        }
        i = i + 1
    }
}

// RUNDE 35: `comptime { ... }` auf oberster Ebene. Der Rumpf ist ein
// gewoehnlicher Block — dieselben Anweisungen, dieselbe lokale
// Namensverdeckung, dieselbe Modul-Umbenennung. Der Block wandert NICHT in
// eine Funktion, sondern als Nummer in `ast.ct_block`; der Interpreter in
// time.fi fuehrt ihn vor der Typpruefung aus (Vorbild compiler/src/comptime.rs).
fn comptime_decl(p: *mut Parser) {
    next_bump(p)
    let b: u32 = block(p)
    ast.ct_add(par_tree(p), b)
}

// RUNDE 34: Steht an dieser Stelle `gc class`? (hook_item in gc.rs)
fn is_gc_class(p: *mut Parser) -> bool {
    if !actual(p, A_IDENT) {
        return false
    }
    var gw: [u8; 2] = "gc"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, tok_nr(p, 0), (&gw[0]) as u64, 2) {
        return false
    }
    if kind(p, 1) != A_IDENT {
        return false
    }
    var cw: [u8; 5] = "class"
    return intern.intern_equal(it, tok_nr(p, 1), (&cw[0]) as u64, 5)
}

// RUNDE 45 (impls.rs::hook_item): Steht an dieser Stelle `impl Typ {`?
// `impl` ist KEIN Schluesselwort, sondern ein Bezeichner in einer Stellung,
// in der sonst nichts stehen darf — dieselbe Loesung wie `gc class`.
fn is_impl(p: *mut Parser) -> bool {
    if !actual(p, A_IDENT) {
        return false
    }
    var iw: [u8; 4] = "impl"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, tok_nr(p, 0), (&iw[0]) as u64, 4) {
        return false
    }
    if kind(p, 1) != A_IDENT {
        return false
    }
    if kind(p, 2) == A_LBRACE {
        return true
    }
    // RUNDE 46: `impl Schnittstelle for Typ {`. `for` ist ein
    // Schluesselwort und macht die Form eindeutig.
    if kind(p, 2) != A_KWFOR {
        return false
    }
    if kind(p, 3) != A_IDENT {
        return false
    }
    return kind(p, 4) == A_LBRACE
}

// RUNDE 46 (iface.rs::hook_item): Steht an dieser Stelle `interface Name {`?
fn is_interface(p: *mut Parser) -> bool {
    if !actual(p, A_IDENT) {
        return false
    }
    var iw: [u8; 9] = "interface"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, tok_nr(p, 0), (&iw[0]) as u64, 9) {
        return false
    }
    if kind(p, 1) != A_IDENT {
        return false
    }
    return kind(p, 2) == A_LBRACE
}

// Dasselbe an einer ABSOLUTEN Tokenstelle (fuer die Vorabsuche).
fn is_interface_at(p: *mut Parser, i: usize) -> bool {
    if i + 2 >= (*p).n {
        return false
    }
    if lexer.lex_kind(lx(p), i) != A_IDENT {
        return false
    }
    var iw: [u8; 9] = "interface"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, lexer.lex_nr(lx(p), i), (&iw[0]) as u64, 9) {
        return false
    }
    if lexer.lex_kind(lx(p), i + 1) != A_IDENT {
        return false
    }
    return lexer.lex_kind(lx(p), i + 2) == A_LBRACE
}

// Dasselbe an einer ABSOLUTEN Tokenstelle (fuer die Vorabsuche).
fn is_impl_at(p: *mut Parser, i: usize) -> bool {
    if i + 2 >= (*p).n {
        return false
    }
    if lexer.lex_kind(lx(p), i) != A_IDENT {
        return false
    }
    var iw: [u8; 4] = "impl"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, lexer.lex_nr(lx(p), i), (&iw[0]) as u64, 4) {
        return false
    }
    if lexer.lex_kind(lx(p), i + 1) != A_IDENT {
        return false
    }
    if lexer.lex_kind(lx(p), i + 2) == A_LBRACE {
        return true
    }
    if i + 4 >= (*p).n {
        return false
    }
    if lexer.lex_kind(lx(p), i + 2) != A_KWFOR {
        return false
    }
    if lexer.lex_kind(lx(p), i + 3) != A_IDENT {
        return false
    }
    return lexer.lex_kind(lx(p), i + 4) == A_LBRACE
}

// Stelle NACH der schliessenden Klammer des Blocks bei `i`. Gesucht wird ab
// der ERSTEN geschweiften Klammer — `impl T {` und `impl I for T {` (und
// ebenso `interface I {`) sind damit derselbe Fall.
fn impl_end(p: *mut Parser, i: usize) -> usize {
    var k: usize = i + 2
    while k < (*p).n {
        if lexer.lex_kind(lx(p), k) == A_LBRACE {
            break
        }
        k = k + 1
    }
    var depth: usize = 0
    while k < (*p).n {
        let a: u32 = lexer.lex_kind(lx(p), k)
        if a == A_LBRACE {
            depth = depth + 1
        }
        if a == A_RBRACE {
            depth = depth - 1
            if depth == 0 {
                return k + 1
            }
        }
        k = k + 1
    }
    return k
}

// Der Empfaenger einer Methode: `self`, `*self` oder `*mut self`.
// Firn hat keine Referenzen — der Empfaenger wird geschrieben wie jeder
// andere Parameter dieser Sprache (impls.rs, Abschnitt „Der Empfaenger").
fn self_param(p: *mut Parser, tname0: u32) -> bool {
    var sw: [u8; 4] = "self"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let snr: u32 = intern.intern_number(it, (&sw[0]) as u64, 4) as u32
    // RUNDE 46: fuer eine `gc class` traegt der Empfaenger den INTERNEN
    // Structnamen `"gc K"` — aus `*self` wird damit genau `Gc[K]`. Ob `K`
    // eine Klasse ist, steht in der Registrierung; sie wird beim Parsen
    // gefuellt, deshalb muss `gc class K` VOR dem `impl`-Block stehen
    // (docs/RUNDE46.md §9). Wortgleich zu impls.rs::selbst_param.
    var tname: u32 = tname0
    var class: bool = false
    if has_gc(p) && gc.gc_is_class(gr(p), tname0) {
        class = true
        rt.buf_clear(&(*p).scratch)
        var gw: [u8; 3] = "gc "
        rt.buf_push_bytes(&(*p).scratch, (&gw[0]) as u64, 3)
        rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, tname0),
                          intern.intern_length(it, tname0))
        tname = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                                     rt.buf_len(&(*p).scratch)) as u32
    }
    if actual(p, A_IDENT) && tok_nr(p, 0) == snr {
        if class {
            // ein 'gc class'-Wert lebt nur auf dem GC-Heap
            complain(p)
            return false
        }
        next_bump(p)
        let t: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tname, 0)
        ast.param_add(par_tree(p), snr, t)
        loc_add(p, snr)
        return true
    }
    if actual(p, A_STAR) {
        var m: u64 = 0
        var k: usize = 1
        if kind(p, 1) == A_KWMUT {
            m = 1
            k = 2
        }
        if kind(p, k) == A_IDENT && tok_nr(p, k) == snr {
            next_bump(p)
            if m == 1 {
                next_bump(p)
            }
            next_bump(p)
            let inner: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tname, 0)
            let t: u32 = ast.ty_new(par_tree(p), ast.T_PTR, inner, m)
            ast.param_add(par_tree(p), snr, t)
            loc_add(p, snr)
            return true
        }
    }
    complain(p)
    return false
}

// Eine Methode wird zur gewoehnlichen Funktion `Typ__methode`. Danach ist sie
// nichts Besonderes mehr — dieselbe Typpruefung, dasselbe Lowering.
fn methods_decl(p: *mut Parser, tname: u32) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let mnr: u32 = tok_nr(p, 0)
    next_bump(p)
    if actual(p, A_LBRACKET) {
        complain(p)
        return
    }
    var tr: [u8; 2] = "__"
    let name: u32 = join(p, tname, (&tr[0]) as u64, 2, mnr)
    if !expect(p, A_LPAREN) {
        return
    }
    loc_on(p)
    let poff: u32 = ast.param_start(par_tree(p))
    if !self_param(p, tname) {
        loc_off(p)
        return
    }
    if eat(p, A_COMMA) {
        param_list(p)
    }
    expect(p, A_RPAREN)
    let plen: u32 = ast.param_start(par_tree(p)) - poff
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            loc_off(p)
            return
        }
    }
    let body: u32 = block(p)
    loc_off(p)
    ast.fn_add(par_tree(p), name, poff, plen, ret, body, 0, 0, 0)
}

// RUNDE 46 (iface.rs::interface_decl): `interface I { fn m(*self) -> T … }`.
// Der Block geht in die Registrierung (`iface.fi`), NICHT in den Baum —
// Schnittstellennamen gelten programmweit und werden nicht umbenannt. Ohne
// Registrierung (astdump) wird er richtig gelesen und verworfen.
fn interface_decl(p: *mut Parser) {
    next_bump(p)
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    var ii: u32 = NONE
    if has_if(p) {
        ii = iface.if_add(ifr(p), lexer.lex_names(lx(p)), name)
        if ii == NONE {
            // die schnittstelle ist bereits deklariert
            complain(p)
            return
        }
    }
    if !expect(p, A_LBRACE) {
        return
    }
    while true {
        while eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_KWFN) {
            complain(p)
            break
        }
        if !interfaces_method(p, ii) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
}

// Eine Methode der Schnittstelle: `fn name(<empfaenger>[, param…]) [-> T]`
// — OHNE Rumpf. Der Empfaenger MUSS ein Zeiger sein: ueber die Tafel steht
// nur der Datenzeiger zur Verfuegung.
fn interfaces_method(p: *mut Parser, ii: u32) -> bool {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return false
    }
    let mnr: u32 = tok_nr(p, 0)
    next_bump(p)
    if actual(p, A_LBRACKET) {
        complain(p)
        return false
    }
    if !expect(p, A_LPAREN) {
        return false
    }
    var sw: [u8; 4] = "self"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let snr: u32 = intern.intern_number(it, (&sw[0]) as u64, 4) as u32
    if !actual(p, A_STAR) {
        complain(p)
        return false
    }
    var k: usize = 1
    if kind(p, 1) == A_KWMUT {
        k = 2
    }
    if kind(p, k) != A_IDENT || tok_nr(p, k) != snr {
        complain(p)
        return false
    }
    next_bump(p)
    if k == 2 {
        next_bump(p)
    }
    next_bump(p)
    var ptypes: Vec[u32] = vec_new[u32]()
    if eat(p, A_COMMA) {
        while true {
            if actual(p, A_RPAREN) || at_end(p) {
                break
            }
            let before: usize = (*p).pos
            if !actual(p, A_IDENT) {
                complain(p)
                vec_free[u32](&ptypes)
                return false
            }
            next_bump(p)
            if !expect(p, A_COLON) {
                vec_free[u32](&ptypes)
                return false
            }
            let pt: u32 = ty(p)
            if pt == ast.NOTHING {
                vec_free[u32](&ptypes)
                return false
            }
            vec_push[u32](&ptypes, pt)
            if !eat(p, A_COMMA) {
                break
            }
            if (*p).pos == before {
                next_bump(p)
            }
        }
    }
    if !expect(p, A_RPAREN) {
        vec_free[u32](&ptypes)
        return false
    }
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            vec_free[u32](&ptypes)
            return false
        }
    }
    if actual(p, A_LBRACE) {
        // eine schnittstellenmethode hat keinen rumpf
        complain(p)
        vec_free[u32](&ptypes)
        return false
    }
    // RUNDE 50: nennt die Signatur `Self`? Dann haengen ihre Typen am
    // umsetzenden Typ und werden erst je Umsetzung aufgeloest.
    var has_self: bool = false
    var hi: usize = 0
    while hi < vec_len[u32](&ptypes) {
        if iface.if_names_self(par_tree(p), lexer.lex_names(lx(p)),
                               vec_at[u32](&ptypes, hi)) {
            has_self = true
        }
        hi = hi + 1
    }
    if iface.if_names_self(par_tree(p), lexer.lex_names(lx(p)), ret) {
        has_self = true
    }
    if ii != NONE {
        if !iface.if_method_add(ifr(p), ii, mnr, &ptypes, ret, has_self) {
            // die methode gibt es in dieser schnittstelle schon
            complain(p)
            vec_free[u32](&ptypes)
            return false
        }
    }
    vec_free[u32](&ptypes)
    return true
}

fn impl_decl(p: *mut Parser) {
    next_bump(p)
    let first: u32 = tok_nr(p, 0)
    next_bump(p)
    // RUNDE 46 (iface.rs): `impl Schnittstelle for Typ`. Der Block legt
    // DIESELBEN Funktionen an wie `impl Typ` — die Schnittstelle sagt nur
    // zusaetzlich, was darin stehen MUSS. In der Registrierung steht der
    // Typname so, wie er im Quelltext steht (ohne Modulpraefix): `firnc0`
    // hat an dieser Stelle ebenfalls nur den rohen Namen.
    var raw: u32 = first
    var is_for: bool = false
    if actual(p, A_KWFOR) {
        next_bump(p)
        if !actual(p, A_IDENT) {
            complain(p)
            return
        }
        raw = tok_nr(p, 0)
        next_bump(p)
        is_for = true
    }
    let tname: u32 = renamed(p, raw)
    if is_for && has_if(p) {
        iface.if_impl_add(ifr(p), first, raw)
    }
    if !expect(p, A_LBRACE) {
        return
    }
    while true {
        while eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_KWFN) {
            complain(p)
            break
        }
        methods_decl(p, tname)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
}

// `#[no_gc]` und `#[must_consume]` — die beiden umgesetzten Attribute
// (attrs.rs: genau diese zwei stehen auf `umgesetzt: true`). Eine Klammer
// mit Argumenten ist ein Fehler (beide erwarten 0 Argumente, attrs.rs);
// jeder andere Name wird von der Vorabsuche schon als nicht-Kern abgefangen.
fn attr(p: *mut Parser) {
    next_bump(p)
    if !expect(p, A_LBRACKET) {
        return
    }
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    var an: [u8; 5] = "no_gc"
    var mc: [u8; 12] = "must_consume"
    // RUNDE 52 (attrs.rs): `#[interrupt]` und `#[allow_fp]` (SPEC 2).
    var iw: [u8; 9] = "interrupt"
    var fw: [u8; 8] = "allow_fp"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let is_nogc: bool = intern.intern_equal(it, tok_nr(p, 0), (&an[0]) as u64, 5)
    let is_mc: bool = intern.intern_equal(it, tok_nr(p, 0), (&mc[0]) as u64, 12)
    let is_int: bool = intern.intern_equal(it, tok_nr(p, 0), (&iw[0]) as u64, 9)
    let is_fp: bool = intern.intern_equal(it, tok_nr(p, 0), (&fw[0]) as u64, 8)
    if !is_nogc && !is_mc && !is_int && !is_fp {
        complain(p)
        return
    }
    next_bump(p)
    if actual(p, A_LPAREN) {
        complain(p)
        return
    }
    if !expect(p, A_RBRACKET) {
        return
    }
    if is_mc {
        (*p).mc_pending = 1
    } else if is_int {
        (*p).int_pending = 1
    } else if is_fp {
        // `#[allow_fp]` erlaubt Gleitkomma im Kernel-Profil; im Baum bleibt
        // davon nichts uebrig, weil diese Stufe die Profilverbote nicht
        // durchsetzt (docs/RUNDE52.md, „Offenes").
        (*p).nogc_pending = (*p).nogc_pending
    } else {
        (*p).nogc_pending = 1
    }
}

// `gc class Name [extends Basis] { feld: Typ, ... }` (gc_class_decl in
// gc.rs). Die Klasse geht in die Registrierung (`gc.fi`), NICHT in den
// Baum — Klassennamen gelten programmweit und werden nicht umbenannt.
fn gc_class_decl(p: *mut Parser) {
    next_bump(p)
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    var base: u32 = 0
    if actual(p, A_IDENT) {
        var ew: [u8; 7] = "extends"
        let it: *mut intern.Interner = lexer.lex_names(lx(p))
        if intern.intern_equal(it, tok_nr(p, 0), (&ew[0]) as u64, 7) {
            next_bump(p)
            if !actual(p, A_IDENT) {
                complain(p)
                return
            }
            base = tok_nr(p, 0)
            next_bump(p)
            if actual(p, A_COMMA) {
                // mehrfachvererbung ist nicht erlaubt (SPEC 4.4)
                complain(p)
                return
            }
        }
    }
    if !expect(p, A_LBRACE) {
        return
    }
    let ki: u32 = gc.gc_class_add(gr(p), name)
    if ki == NONE {
        // 'gc class ...' ist bereits deklariert
        complain(p)
        return
    }
    if base != 0 {
        gc.gc_base_set(gr(p), ki, base)
    }
    while true {
        while eat(p, A_COMMA) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let ft: u32 = ty(p)
        if ft == ast.NOTHING {
            break
        }
        if !gc.gc_field_add(gr(p), ki, fname, ft) {
            // feld ist bereits deklariert
            complain(p)
        }
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
}

fn par_run(p: *mut Parser) {
    if has_gen(p) {
        var so: [u8; 7] = "size_of"
        (*p).sonr = intern.intern_find(lexer.lex_names(lx(p)), (&so[0]) as u64, 7)
    }
    extensions_search(p)
    own_search(p)
    if (*p).not_core {
        return
    }
    module_upfront(p)
    while true {
        while eat(p, A_SEMI) {}
        if at_end(p) {
            break
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        let a: u32 = kind(p, 0)
        // `#[no_gc]` gehoert vor eine FUNKTION (attrs.rs, Ziel::Funktion),
        // `#[must_consume]` vor beides (attrs.rs, Ziel::Beides) — Runde 36.
        if (*p).nogc_pending == 1 && a != A_KWFN && a != A_HASH {
            complain(p)
            (*p).nogc_pending = 0
        }
        if (*p).mc_pending == 1 && a != A_KWFN && a != A_KWSTRUCT && a != A_HASH {
            complain(p)
            (*p).mc_pending = 0
        }
        if a == A_HASH && has_gc(p) {
            // `#[no_gc]` vor einer Funktion (Runde 34, SPEC 3.5.4),
            // `#[must_consume]` vor Funktion oder Struct (Runde 36). Andere
            // Attribute faengt die Vorabsuche als nicht-Kern ab.
            attr(p)
        } else if a == A_IDENT && has_gc(p) && is_gc_class(p) {
            gc_class_decl(p)
        } else if a == A_IDENT && is_interface(p) {
            interface_decl(p)
        } else if a == A_IDENT && is_impl(p) {
            impl_decl(p)
        } else if a == A_KWFN {
            fn_decl(p)
        } else if a == A_KWSTRUCT {
            struct_decl(p)
        } else if a == A_KWENUM && has_mu(p) {
            enum_decl(p)
        } else if a == A_KWERROR && has_fe(p) {
            error_decl(p)
        } else if a == A_KWCOMPTIME && has_time(p) {
            comptime_decl(p)
        } else if a == A_KWCONST {
            const_decl(p)
        } else if a == A_KWPROFILE {
            profile_decl(p)
        } else if a == A_KWIMPORT {
            import_decl(p)
        } else if a == A_KWEXPORT {
            export_decl(p)
        } else {
            // Alles Uebrige gehoert zu den nicht portierten Erweiterungen
            // (`enum`, `error`, `gc class`, `comptime`, Attribute) oder ist
            // schlicht falsch.
            // Ein BEZEICHNER auf oberster Ebene kann in Stufe 0 nur ein
            // Haken sein — `gc class Name { … }`. Der gehoert wie `enum`,
            // `error`, `comptime` und Attribute zu den nicht portierten
            // Erweiterungen.
            if a == A_KWENUM || a == A_KWERROR || a == A_KWCOMPTIME || a == A_HASH || a == A_IDENT {
                (*p).not_core = true
            }
            complain(p)
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    if vec_len[u32](&(*p).hoist) > 0 {
        // f"..." auf ITEM-Ebene (z. B. in einer `const`): es gibt keine
        // Anweisung, vor die die Textsegmente gehoben werden koennten.
        complain(p)
    }
}
