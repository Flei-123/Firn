// SPDX-License-Identifier: MPL-2.0
// lib/firnc1/parser.fi -- THE FIRN PARSER, WRITTEN IN FIRN.
//
// Recursive descent, no generator -- exactly like `compiler/src/parser.rs`.
// It builds into `ast.Tree`: nodes are addressed by `Vec` index rather than by
// pointer (docs/SELF_HOSTING.md section 2.4).
//
// SCOPE: the CORE LANGUAGE. Anything that keeps its tree outside `Program` --
// `enum`/`match`, error unions, generic templates, `gc class`, attributes,
// `comptime` -- is out of scope. Such files are counted and skipped in the
// comparison, not silently ignored.
//
// OUT OF SCOPE AS WELL: error recovery. `firnc0` collects up to forty
// messages and keeps reading; this parser reports the first one and stops.
// That is honestly less -- and it does not matter for the comparison, because
// it only ever runs on sources that `firnc0` reads without errors.
//
// A RULE THAT IS EASILY MISSED: an operator at the START OF A LINE does NOT
// continue the expression while no bracket is open (`next()`).
// That is why
//     a
//     - b
// parses as two statements, not as a subtraction.

import rt
import vec
import intern
import lexer
import ast
import mono
import pattern
import err
import gc
import iface
import report
import tokname

export { Parser, par_new, par_new_module, par_free, par_run, par_error, par_tree,
    par_file_set, par_pend,
    par_not_core, par_tree_take, par_gen_set, par_mu_set,
    par_fe_set, par_time_set, par_gc_set, par_if_set,
    // ROUND FIRN-ENV -- the build time environment (env.rs).
    par_env_set,
    // type aliases: does a lexer declare one (the module order depends on it)
    lex_has_alias }

// token kinds from lexer.fi (in the same order as in compiler/src/lexer.rs)
// "no value"
const NONE: u32 = 4294967295

const A_INT: u32 = 0
const A_IDENT: u32 = 1
const A_FLOAT: u32 = 2
// ROUND 71 (lexer.fi): the float literal with the suffix `f`.
const A_FLOATF32: u32 = 83
const A_STR: u32 = 3
const A_KWFN: u32 = 4
const A_KWLET: u32 = 5
const A_KWVAR: u32 = 6
const A_KWIF: u32 = 7
const A_KWELSE: u32 = 8
const A_KWWHILE: u32 = 9
const A_KWRETURN: u32 = 10
const A_KWSTRUCT: u32 = 11
const A_KWCONST: u32 = 12
const A_KWPROFILE: u32 = 13
const A_KWAS: u32 = 14
const A_KWMUT: u32 = 15
const A_KWTRUE: u32 = 16
const A_KWFALSE: u32 = 17
const A_KWSYSCALL: u32 = 18
const A_KWEXTERN: u32 = 19
const A_KWBREAK: u32 = 20
const A_KWCONTINUE: u32 = 21
const A_KWDEFER: u32 = 22
const A_KWERRDEFER: u32 = 23
const A_KWCOMPTIME: u32 = 24
const A_KWFOR: u32 = 25
const A_KWIN: u32 = 26
const A_KWIMPORT: u32 = 27
const A_KWEXPORT: u32 = 28
const A_KWENUM: u32 = 29
const A_KWMATCH: u32 = 30
const A_KWERROR: u32 = 31
const A_KWTRY: u32 = 32
const A_KWCATCH: u32 = 33
const A_LPAREN: u32 = 34
const A_RPAREN: u32 = 35
const A_LBRACE: u32 = 36
const A_RBRACE: u32 = 37
const A_LBRACKET: u32 = 38
const A_RBRACKET: u32 = 39
const A_COMMA: u32 = 40
const A_COLON: u32 = 41
const A_SEMI: u32 = 42
const A_DOT: u32 = 43
const A_DOTDOT: u32 = 44
const A_ARROW: u32 = 45
const A_ASSIGN: u32 = 46
const A_PLUS: u32 = 47
const A_MINUS: u32 = 48
const A_STAR: u32 = 49
const A_SLASH: u32 = 50
const A_PERCENT: u32 = 51
const A_AMP: u32 = 52
const A_PIPE: u32 = 53
const A_CARET: u32 = 54
const A_SHL: u32 = 55
const A_SHR: u32 = 56
const A_ANDAND: u32 = 57
const A_OROR: u32 = 58
const A_NOT: u32 = 59
const A_QUESTION: u32 = 60
const A_HASH: u32 = 61
const A_EQEQ: u32 = 62
const A_NOTEQ: u32 = 63
const A_LT: u32 = 64
const A_LE: u32 = 65
const A_GT: u32 = 66
const A_GE: u32 = 67
const A_EOF: u32 = 68
const A_FSTR: u32 = 69
// ROUND 68: `~`, the bitwise complement.
const A_TILDE: u32 = 70
// ROUND 70 (lexer.fi): the compound assignments and the two step operators.
const A_PLUSEQ: u32 = 71
const A_MINUSEQ: u32 = 72
const A_STAREQ: u32 = 73
const A_SLASHEQ: u32 = 74
const A_PERCENTEQ: u32 = 75
const A_AMPEQ: u32 = 76
const A_PIPEEQ: u32 = 77
const A_CARETEQ: u32 = 78
const A_SHLEQ: u32 = 79
const A_SHREQ: u32 = 80
const A_PLUSPLUS: u32 = 81
const A_MINUSMINUS: u32 = 82
// ROUND 72 (lexer.fi): `+% -% *%` and `+| -| *|` -- SPEC 13, item L9.
const A_PLUSPERCENT: u32 = 84
const A_MINUSPERCENT: u32 = 85
const A_STARPERCENT: u32 = 86
const A_PLUSPIPE: u32 = 87
const A_MINUSPIPE: u32 = 88
const A_STARPIPE: u32 = 89
// ROUND 89 (SPEC 14.1.statics) -- see lexer.fi for why 90 and not 34.
const A_KWSTATIC: u32 = 90

// binary operators -- in the same order as `ast::BinOp`.
const B_ADD: u32 = 0
const B_SUB: u32 = 1
const B_MUL: u32 = 2
const B_DIV: u32 = 3
const B_REM: u32 = 4
const B_AND: u32 = 5
const B_OR: u32 = 6
const B_XOR: u32 = 7
const B_SHL: u32 = 8
const B_SHR: u32 = 9
const B_EQ: u32 = 10
const B_NE: u32 = 11
const B_LT: u32 = 12
const B_LE: u32 = 13
const B_GT: u32 = 14
const B_GE: u32 = 15
const B_LAND: u32 = 16
const B_LOR: u32 = 17
// ROUND 72 (ast.rs::BinOp) -- the explicit forms that are NEVER checked,
// in any build level. `+% -% *%` keep the low order bits, `+| -| *|` clamp
// to the type's own MIN/MAX. Same precedence as the operators they are
// spelled after: `+%`/`-%`/`+|`/`-|` bind like `+`, `*%`/`*|` like `*`.
const B_ADDWRAP: u32 = 18
const B_SUBWRAP: u32 = 19
const B_MULWRAP: u32 = 20
const B_ADDSAT: u32 = 21
const B_SUBSAT: u32 = 22
const B_MULSAT: u32 = 23

// unary operators
const U_NEG: u32 = 0
const U_NOT: u32 = 1
const U_ADDR: u32 = 2
const U_DEREF: u32 = 3
// ROUND 68: `~x`, the bitwise complement. Deliberately NOT the same
// operator as `!`: `!` negates a bool, `~` flips every bit.
const U_BITNOT: u32 = 4
// ROUND REF: `inout x` -- the address of `x`, which must be modifiable.
const U_INOUT: u32 = 5

struct Parser {
    lx: u64, // pointer to the lexer
    pos: usize,
    n: usize,
    tree: ast.Tree,
    // MODULE SYSTEM. If `alias` is set, this file is not the root file:
    // every identifier it declares ITSELF at the top level is prefixed with `alias__`.
    // That way all files live in ONE tree without two functions that happen to
    // share a name getting in each other's way. `firnc0` does the same in
    // `modules.rs`, only after parsing rather than during it.
    alias: u32,
    own: Vec[u32], // top level names declared by this file
    foreign: u64, // shared tree (0 = we use our own)
    multi: bool, // several files are compiled (`module__x`); an interpolation copy keeps it, `foreign` alone cannot tell
    module: Vec[u32], // intern numbers of the module aliases (for `module.x`)
    module_to: Vec[u32], // parallel to `module`: the module name behind the alias (`import a.b as c`: c -> b)
    scratch: rt.Buf, // builds up qualified names
    parens: usize, // open parentheses (for `next()`)
    no_slit: usize, // > 0: no struct literal at the top level
    err: usize,
    pend: report.Pend,
    dmsg: rt.Buf,
    not_core: bool, // file uses an extension that is not ported
    // ROUND REF: the reference parameters of the function being parsed
    // (`x: &T` flag 0, `x: inout T` flag 1, +2 when the target is an array).
    // Twin of `refparam.rs`: the rewrite (`p.f` -> `(*p).f`) happens while
    // parsing instead of in a pass afterwards. Scoped like `local`: `loc_on`
    // remembers the length (`rp_mark`), `loc_off` cuts back to it.
    rp_name: Vec[u32],
    rp_flag: Vec[u32],
    rp_mark: Vec[u32],
    // r664: 1 while the parameter list of a PLAIN function is parsed
    // (`x: T = <const-expr>` is allowed there and nowhere else).
    defaults_ok: u32,
    // r727: return type node + 1 of the function being parsed (0 = unknown); `return |x| e`
    // stores it in the statement for lamsugar.fi.
    cur_ret: u32,
    // r725 -- `e?` on an Option: quadruples (hidden name, operand, opt_none call) in
    // `qpend`, the finished statements in `qpre` (`block` drains them BEFORE the statement).
    qpend: Vec[u32],
    qpre: Vec[u32],
    no_q: u32,
    loop_depth: u32,
    stmt_depth: u32,
    // r704: 1 inside `impl T {..}` (methods take defaults), 0 in `impl I for T`.
    meth_defaults: u32,
    // ROUND REF4: a statement the NEXT `block` puts in front of its own (the
    // `let x = a[i]` of `for x in array`). `ast.NOTHING` = none.
    pre_stmt: u32,
    pre_stmt2: u32,
    // r708: the hidden bindings of `for (a, b) in ..` (any number); the NEXT `block` puts them in front
    pre_list: Vec[u32],
    // wf-py: innermost statement of the comprehension being parsed (NOTHING = none) and the
    // hoisted f-string parts of its element (collsugar.rs)
    comp_leaf: u32,
    comp_pre: Vec[u32],
    // GENERIC TEMPLATES. The store sits OUTSIDE the parser because it has to be
    // shared by all files of a translation: the root file may use `Vec[i32]`
    // while `Vec[T]` is declared in some module.
    // 0 = no registry; then generics count as an extension that is not ported.
    gen: u64,
    // Registry of enumerations and pattern matches (round 32). Built like
    // `gen`: the store sits outside the parser because it has to be shared by
    // all files of a translation.
    // 0 = no registry; then `enum`/`match` are not ported.
    mu: u64,
    // Registry of the error sets and unions (round 33). Built like `mu`:
    // one store for all files of the translation.
    // 0 = no registry; then `error`/`try`/`catch` are not ported.
    feh: u64,
    // ROUND 35: `comptime { ... }` is recognised. No registry outside the tree
    // is needed -- the blocks are held as block numbers in the tree itself
    // (`ast.ct_block`), and the interpreter lives in time.fi. Only the FLAG belongs
    // here, because `extensions_search` has to know before parsing whether the
    // keyword is core language (the same handover as in rounds 31-33).
    time: bool,
    // ROUND 34: registry of the gc classes (`gc.fi`). Built like `mu`/`feh`:
    // one store for all files of the translation, because class names are
    // visible program wide. 0 = no registry; then
    // `gc class`, `Gc[T]`, `x.as?[C]` and `#[no_gc]` are not ported.
    gcr: u64,
    // ROUND 46: registry of the interfaces (`iface.fi`). Built the same way
    // as `gcr`. 0 = no registry; then `interface` blocks are still parsed
    // correctly, but they are not kept -- which is enough for
    // `bin/astdump.fi`, whose reference (`ast_canon.rs`) does not print them
    // either.
    ifr: u64,
    // The `#[no_gc]` attribute in front of the next function declaration.
    nogc_pending: u32,
    // ROUND 52: `#[interrupt]` in front of the next function (SPEC 2).
    int_pending: u32,
    // ROUND 89: `#[panic_handler]` seen, waiting for the function it belongs to.
    ph_pending: u32,
    // The `#[must_consume]` attribute in front of the next fn or struct
    // declaration (round 36, attrs.rs -- Target::Both).
    mc_pending: u32,
    lay_pending: u32,
    // ROUND 75 (SPEC 14.5): the interned argument of `#[link_name(...)]`
    // in front of the next 'extern fn'; MEANINGFUL only when
    // `link_pending_set` is true (0 is a perfectly ordinary intern number,
    // not a sentinel -- see `codegen.fi`'s `extern_link_of`).
    link_pending: u32,
    link_pending_set: bool,
    // ROUND 75 (SPEC 14.5): `#[export_c]` in front of the next fn.
    export_pending: u32,
    tpoff: u32, // start of the current type parameter list
    // Intern number of `size_of`, or -1. `size_of` is NOT a keyword
    // (sizeof.rs) -- it can only be recognised by its spelling.
    sonr: i64,
    // r169: intern numbers of `has_gc`, `gc_track`, `gc_untrack`, or -1.
    hgnr: i64,
    gtnr: i64,
    gunr: i64,
    // LOCAL NAMES, as a stack of scopes. A parameter or a local variable
    // SHADOWS an entry of the same name in the same file.
    local: Vec[u32],
    llimit: Vec[u32],
    // ROUND 39, interpolation: the hidden `let _fsegK_N` bindings for the
    // text segments -- `block` hoists them in front of the next statement.
    hoist: Vec[u32],
    // > 0: an interpolation is already running -- nesting is not supported yet.
    interp: u32,
    // ROUND 79: the number of the file being parsed, in the file table of
    // the TREE (`ast.file_add`). It goes into the packed position of every
    // node this parser makes, so that a message out of a module names the
    // module and not the root file.
    file: u32,
    // ROUND 79: `#[allow_escape]` in front of the next function (attrs.rs).
    esc_pending: u32,
    // ROUND ARM-FREESTANDING: `#[arch(...)]` in front of the next function
    // (archsel.rs in firnc0). 0 = nothing said, 1 = this machine, 2 = another
    // machine, so the declaration is parsed and THROWN AWAY. This stage
    // generates x86-64 and nothing else, so 1 means `x86_64` -- and that is
    // written down here rather than assumed, because the day this file grows
    // an A64 code generator is the day the constant has to move.
    arch_pending: u32,
    // ROUND 79: `[T; _]` is only allowed where an initializer follows that
    // the length can be taken from -- the type of a `let`/`var`. `let_stmt`
    // switches this on around exactly that call; everywhere else a `_` is
    // refused right here, so `ast.LEN_INFER` never leaves the parser.
    infer_len_ok: bool,
    // ROUND FIRN-ENV (compiler/src/env.rs) -- the build time environment for
    // `__env_or`/`__env_has`. Not a global and not a second registry: the
    // same handover `gen`/`mu`/`feh`/`gcr`/`ifr` use, because the
    // environment belongs to the TRANSLATION and not to one file.
    //
    //   estart   the start block of the process (`[argc][argv..][0][envp..]`).
    //            0 means: no environment is visible, so every variable
    //            counts as unset and every `__env_or` yields its default.
    //            That is the state the small drivers are in, and it is the
    //            reason they translate reproducibly.
    //   eallow_p/n  the EXTRA permitted prefixes, comma separated
    //            (`--env-allow=`). `FIRN_` is permitted without any of them.
    //   enotes   an `rt.Buf` collecting the manifest of `--env-log`, or 0.
    estart: u64,
    eallow_p: u64,
    eallow_n: usize,
    enotes: u64,
    // TYPE ALIASES (`type X = T`, twin of compiler/src/alias.rs). One entry
    // per declaration of THIS file; `alias_search` fills the table before
    // the first item is parsed, so the order of the declarations is free.
    //   al_name   the name AFTER module renaming (`m__Idx`)
    //   al_head   token index of the word `type`
    //   al_pos    token index of the first token of the target
    //   al_end    token index behind the target (once resolved)
    //   al_state  0 = not read, 1 = being read, 2 = done, 3 = failed
    //   al_node   the type node of the target (state 2)
    //   al_bad    1 = declared twice or clashing with a struct: read to
    //             find its end, never used
    // ROUND TUPLES: statements that stand right AFTER the statement being
    // parsed (`block` appends them) -- the bindings of `let (a, b) = f()` --
    // and the number of hidden tuple bindings made so far (`__tup#<k>#<n>`;
    // compiler/src/parser.rs counts the same way).
    after: Vec[u32],
    tup_seq: u32,
    al_name: Vec[u32],
    al_head: Vec[u32],
    al_pos: Vec[u32],
    al_end: Vec[u32],
    al_state: Vec[u32],
    al_node: Vec[u32],
    al_bad: Vec[u32],
}

fn par_new(lx: u64) -> Parser {
    var p: Parser = Parser {
        lx: lx, pos: 0, n: 0,
        tree: ast.tree_new(),
        alias: NONE, own: vec_new[u32](), foreign: 0, multi: false,
        module: vec_new[u32](),
        module_to: vec_new[u32](),
        scratch: rt.buf_new(),
        parens: 0, no_slit: 0, err: 0, pend: report.pend_new(), dmsg: rt.buf_new(), not_core: false,
        rp_name: vec_new[u32](), rp_flag: vec_new[u32](), rp_mark: vec_new[u32](),
        defaults_ok: 0,
        cur_ret: 0,
        qpend: vec_new[u32](), qpre: vec_new[u32](), no_q: 0, loop_depth: 0, stmt_depth: 0,
        meth_defaults: 0,
        pre_stmt: ast.NOTHING,
        pre_stmt2: ast.NOTHING,
        pre_list: vec_new[u32](),
        comp_leaf: ast.NOTHING, comp_pre: vec_new[u32](),
        gen: 0, mu: 0, feh: 0, time: false, gcr: 0, ifr: 0, nogc_pending: 0, int_pending: 0, ph_pending: 0, mc_pending: 0, lay_pending: 0,
        link_pending: 0, link_pending_set: false, export_pending: 0, tpoff: 0, sonr: -1, hgnr: -1, gtnr: -1, gunr: -1,
        local: vec_new[u32](), llimit: vec_new[u32](),
        hoist: vec_new[u32](), interp: 0,
        file: 0, esc_pending: 0, arch_pending: 0, infer_len_ok: false,
        estart: 0, eallow_p: 0, eallow_n: 0, enotes: 0,
        after: vec_new[u32](), tup_seq: 0,
        al_name: vec_new[u32](), al_head: vec_new[u32](), al_pos: vec_new[u32](),
        al_end: vec_new[u32](), al_state: vec_new[u32](), al_node: vec_new[u32](),
        al_bad: vec_new[u32](),
    }
    p.n = lexer.lex_count(lx as *mut lexer.Lexer)
    // ROUND 83: a parser that owns its tree registers the file it is about
    // to read, right here. `firnc1.fi` does it itself for the modules of a
    // real translation (`par_file_set`, round 79), but the small drivers --
    // `bin/firdump.fi`, `bin/astdump.fi` and their kind -- never did, and
    // since the checked arithmetic bakes the file name into the panic
    // message at LOWERING time, a tree without a file table made
    // `firdump` print `at :13:13` while `firnc0` printed the path
    // (found by tools/atomic/run.sh, which compares the two FIR texts
    // octet for octet). Round 72 could not run into this: it carried the
    // intern number of the name in the position itself.
    var nb: rt.Buf = rt.buf_new()
    lexer.lex_file_name(lx as *mut lexer.Lexer, &nb)
    p.file = ast.file_add(&p.tree, rt.buf_ptr(&nb), rt.buf_len(&nb))
    rt.buf_free(&nb)
    return p
}

// Like `par_new`, but into a SHARED tree and with a module alias.
// `alias == NONE` means the root file (no renaming).
fn par_new_module(lx: u64, tree: u64, alias: u32) -> Parser {
    var p: Parser = par_new(lx)
    p.foreign = tree
    p.multi = true
    p.alias = alias
    return p
}

// ROUND 79: which file of the tree's file table this parser reads. Again
// BEFORE `par_run`.
fn par_file_set(p: *mut Parser, f: u32) { (*p).file = f }

// The packed position of the token `k` ahead (round 79). At the end of the
// stream the position of the last token, so that a message never loses its
// place.
fn at_pos(p: *mut Parser, k: usize) -> u64 {
    var i: usize = (*p).pos + k
    if i >= (*p).n {
        if (*p).n == 0 {
            return ast.pos_pack((*p).file, 1, 1)
        }
        i = (*p).n - 1
    }
    return ast.pos_pack((*p).file, lexer.lex_line(lx(p), i), lexer.lex_col(lx(p), i))
}

// Register the store for the generic templates. MUST happen before `par_run`.
fn par_gen_set(p: *mut Parser, g: u64) { (*p).gen = g }

// Register the store for enumerations and matches. Again BEFORE `par_run`.
fn par_mu_set(p: *mut Parser, m: u64) { (*p).mu = m }

// Register the store for the error unions. Again BEFORE `par_run`.
fn par_fe_set(p: *mut Parser, f: u64) { (*p).feh = f }

fn gn(p: *mut Parser) -> *mut mono.Gen { return (*p).gen as *mut mono.Gen }
fn has_gen(p: *mut Parser) -> bool { return (*p).gen != 0 }
fn mn(p: *mut Parser) -> *mut pattern.Pat { return (*p).mu as *mut pattern.Pat }
fn has_mu(p: *mut Parser) -> bool { return (*p).mu != 0 }
fn fh(p: *mut Parser) -> *mut err.Error { return (*p).feh as *mut err.Error }
fn has_fe(p: *mut Parser) -> bool { return (*p).feh != 0 }

// ROUND 35: register `comptime` blocks.
fn par_time_set(p: *mut Parser) { (*p).time = true }
fn has_time(p: *mut Parser) -> bool { return (*p).time }

// ROUND FIRN-ENV: the build time environment. Again BEFORE `par_run` --
// `__env_or` is resolved WHILE parsing, so afterwards would be too late.
fn par_env_set(p: *mut Parser, start: u64, allow_p: u64, allow_n: usize, notes: u64) {
    (*p).estart = start
    (*p).eallow_p = allow_p
    (*p).eallow_n = allow_n
    (*p).enotes = notes
}

// ROUND 34: register the gc registry. Again BEFORE `par_run`.
fn par_gc_set(p: *mut Parser, g: u64) { (*p).gcr = g }
fn par_if_set(p: *mut Parser, f: u64) { (*p).ifr = f }
fn ifr(p: *mut Parser) -> *mut iface.If { return (*p).ifr as *mut iface.If }
fn has_if(p: *mut Parser) -> bool { return (*p).ifr != 0 }
fn gr(p: *mut Parser) -> *mut gc.Gc { return (*p).gcr as *mut gc.Gc }
fn has_gc(p: *mut Parser) -> bool { return (*p).gcr != 0 }

fn par_tree_take(p: *mut Parser) -> *mut ast.Tree {
    return par_tree(p)
}

fn par_free(p: *mut Parser) {
    // A SHARED tree belongs to the caller.
    if (*p).foreign == 0 {
        ast.tree_free(&(*p).tree)
    }
    vec_free[u32](&(*p).module)
    vec_free[u32](&(*p).module_to)
    vec_free[u32](&(*p).own)
    rt.buf_free(&(*p).scratch)
    report.pend_free(&(*p).pend)
    rt.buf_free(&(*p).dmsg)
    vec_free[u32](&(*p).local)
    vec_free[u32](&(*p).llimit)
    vec_free[u32](&(*p).hoist)
    vec_free[u32](&(*p).qpend)
    vec_free[u32](&(*p).qpre)
    vec_free[u32](&(*p).rp_name)
    vec_free[u32](&(*p).rp_flag)
    vec_free[u32](&(*p).rp_mark)
    vec_free[u32](&(*p).after)
    vec_free[u32](&(*p).pre_list)
    vec_free[u32](&(*p).comp_pre)
    vec_free[u32](&(*p).al_name)
    vec_free[u32](&(*p).al_head)
    vec_free[u32](&(*p).al_pos)
    vec_free[u32](&(*p).al_end)
    vec_free[u32](&(*p).al_state)
    vec_free[u32](&(*p).al_node)
    vec_free[u32](&(*p).al_bad)
}

fn par_error(p: *mut Parser) -> usize { return (*p).err }
fn par_pend(p: *mut Parser) -> *mut report.Pend { return &(*p).pend }
fn par_tree(p: *mut Parser) -> *mut ast.Tree {
    if (*p).foreign != 0 {
        return (*p).foreign as *mut ast.Tree
    }
    return &(*p).tree
}
fn par_not_core(p: *mut Parser) -> bool { return (*p).not_core }

fn lx(p: *mut Parser) -> *mut lexer.Lexer { return (*p).lx as *mut lexer.Lexer }

// ------------------------------------------------------------- token access

fn kind(p: *mut Parser, k: usize) -> u32 {
    if (*p).pos + k >= (*p).n {
        return A_EOF
    }
    return lexer.lex_kind(lx(p), (*p).pos + k)
}

fn tok_nr(p: *mut Parser, k: usize) -> u32 {
    if (*p).pos + k >= (*p).n {
        return 0
    }
    return lexer.lex_nr(lx(p), (*p).pos + k)
}

fn number(p: *mut Parser) -> u64 {
    if (*p).pos >= (*p).n {
        return 0
    }
    return lexer.lex_number(lx(p), (*p).pos)
}

fn line(p: *mut Parser, i: usize) -> u32 {
    if i >= (*p).n {
        return 0
    }
    return lexer.lex_line(lx(p), i)
}

// ROUND 72 (parser.rs::span/join) -- WHERE an expression begins.
//
// `firnc0` carries a span on every AST node and builds a compound node's
// span with `join(left, right)`, whose BOTH branches keep the left
// operand's file, line and column. So the rule the tree needs is exactly
// this: a leaf takes the token it starts at, a compound takes its left
// (or base) operand, and `( e )` is transparent because the parenthesised
// form returns the inner node itself. `pos_default` writes only into a
// node that has none yet, which is what makes the parenthesis case fall
// out for free.
fn pos_now(p: *mut Parser) -> u64 {
    return at_pos(p, 0)
}

fn pos_default(p: *mut Parser, e: u32, v: u64) {
    if e == NONE {
        return
    }
    let b: *mut ast.Tree = par_tree(p)
    if e as usize >= ast.expr_count(b) {
        return
    }
    if ast.pos_line(ast.expr_pos(b, e)) == 0 {
        ast.expr_pos_set(b, e, v)
    }
    // r196: a node is defaulted right after its last token was consumed, so
    // this is also the moment its marker width is known
    len_default(p, e)
}

// A compound node takes the position of the operand it is built on.
fn pos_from(p: *mut Parser, e: u32, source: u32) {
    if e == NONE || source == NONE {
        return
    }
    let b: *mut ast.Tree = par_tree(p)
    if e as usize >= ast.expr_count(b) || source as usize >= ast.expr_count(b) {
        return
    }
    ast.expr_pos_set(b, e, ast.expr_pos(b, source))
}

fn at_end(p: *mut Parser) -> bool { return kind(p, 0) == A_EOF }

fn actual(p: *mut Parser, a: u32) -> bool { return kind(p, 0) == a }

fn next_bump(p: *mut Parser) {
    if (*p).pos < (*p).n {
        (*p).pos = (*p).pos + 1
    }
}

fn eat(p: *mut Parser, a: u32) -> bool {
    if actual(p, a) {
        next_bump(p)
        return true
    }
    return false
}

// Is the current token at the START OF A LINE?
fn line_start(p: *mut Parser) -> bool {
    if (*p).pos == 0 {
        return true
    }
    if (*p).pos >= (*p).n {
        return true
    }
    return line(p, (*p).pos) > line(p, (*p).pos - 1)
}

// ROUND 68 -- the tokens that carry an expression over a line break.
// Every one of them is INFIX ONLY: no statement of the language may begin
// with it, so the reading is unambiguous. `*`, `(` and `[` are deliberately
// NOT in the list -- a line may legitimately begin with `*p = 0`, with
// `(*p).f = 0` or with an index, and none of those may silently become a
// multiplication, a call or an index belonging to the line before.
fn continues_line(a: u32) -> bool {
    if a == A_PLUS || a == A_MINUS || a == A_SLASH || a == A_PERCENT {
        return true
    }
    if a == A_AMP || a == A_PIPE || a == A_CARET || a == A_SHL || a == A_SHR {
        return true
    }
    if a == A_ANDAND || a == A_OROR {
        return true
    }
    if a == A_EQEQ || a == A_NOTEQ || a == A_LT || a == A_LE || a == A_GT || a == A_GE {
        return true
    }
    if a == A_DOT || a == A_KWAS {
        return true
    }
    return false
}

// May the expression continue with the current token?
fn next(p: *mut Parser) -> bool {
    if (*p).parens > 0 {
        return true
    }
    if !line_start(p) {
        return true
    }
    return continues_line(kind(p, 0))
}

// `..=`: is the current `=` glued to the `..` before it (same line, next column)?
fn continues_dd(p: *mut Parser) -> bool {
    if (*p).pos == 0 || (*p).pos >= (*p).n {
        return false
    }
    let i: usize = (*p).pos
    return lexer.lex_line(lx(p), i - 1) == lexer.lex_line(lx(p), i)
    && lexer.lex_col(lx(p), i - 1) + 2 == lexer.lex_col(lx(p), i)
}

fn tok_span(p: *mut Parser) -> u32 {
    if (*p).pos >= (*p).n {
        return 1
    }
    return lexer.lex_length(lx(p), (*p).pos)
}

fn push_found(p: *mut Parser) {
    var f1: [u8; 9] = ", found '"
    rt.buf_push_bytes(&(*p).dmsg, (&f1[0]) as u64, 9)
    tokname.tok_text(lx(p), (*p).pos, &(*p).dmsg)
    rt.buf_push(&(*p).dmsg, 39 as u8)
}

fn complain_done(p: *mut Parser) {
    if (*p).err == 0 {
        report.pend_add(&(*p).pend, at_pos(p, 0), tok_span(p), &(*p).dmsg)
    }
    (*p).err = (*p).err + 1
}

fn complain(p: *mut Parser) {
    if (*p).err == 0 {
        var u1: [u8; 12] = "unexpected '"
        rt.buf_clear(&(*p).dmsg)
        rt.buf_push_bytes(&(*p).dmsg, (&u1[0]) as u64, 12)
        tokname.tok_text(lx(p), (*p).pos, &(*p).dmsg)
        rt.buf_push(&(*p).dmsg, 39 as u8)
    }
    complain_done(p)
}

fn complain_outside_loop(p: *mut Parser, pos: u64, span: u32, word: u64, word_n: usize) {
    if (*p).err == 0 {
        var q1: [u8; 1] = "'"
        var q2: [u8; 19] = "' is outside a loop"
        rt.buf_clear(&(*p).dmsg)
        rt.buf_push_bytes(&(*p).dmsg, (&q1[0]) as u64, 1)
        rt.buf_push_bytes(&(*p).dmsg, word, word_n)
        rt.buf_push_bytes(&(*p).dmsg, (&q2[0]) as u64, 19)
        report.pend_add(&(*p).pend, pos, span, &(*p).dmsg)
    }
    (*p).err = (*p).err + 1
}

fn complain_found(p: *mut Parser, head: u64, head_n: usize) {
    if (*p).err == 0 {
        rt.buf_clear(&(*p).dmsg)
        rt.buf_push_bytes(&(*p).dmsg, head, head_n)
        push_found(p)
    }
    complain_done(p)
}

fn expect_in(p: *mut Parser, a: u32, ctx: u64, ctx_n: usize) -> bool {
    if eat(p, a) {
        return true
    }
    if (*p).err == 0 {
        var e1: [u8; 10] = "expected '"
        rt.buf_clear(&(*p).dmsg)
        rt.buf_push_bytes(&(*p).dmsg, (&e1[0]) as u64, 10)
        tokname.tok_kind_text(a, &(*p).dmsg)
        rt.buf_push(&(*p).dmsg, 39 as u8)
        if ctx_n > 0 {
            rt.buf_push(&(*p).dmsg, 32 as u8)
            rt.buf_push_bytes(&(*p).dmsg, ctx, ctx_n)
        }
        push_found(p)
    }
    complain_done(p)
    return false
}

fn expect(p: *mut Parser, a: u32) -> bool {
    return expect_in(p, a, 0, 0)
}

// -------------------------------------------------------------------- names

// Joins two names with a separator and interns the result.
fn join(p: *mut Parser, a: u32, sep: u64, tn: usize, b: u32) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    rt.buf_clear(&(*p).scratch)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, a), intern.intern_length(it, a))
    rt.buf_push_bytes(&(*p).scratch, sep, tn)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, b), intern.intern_length(it, b))
    return intern.intern_number(it, rt.buf_ptr(&(*p).scratch), rt.buf_len(&(*p).scratch)) as u32
}

// Is `nr` an identifier that THIS file declares at the top level?
fn is_own(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).own) {
        if vec_at[u32](&(*p).own, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

// Rename an identifier of this file to `alias__name`. In the root file
// everything stays as it is.
// ------------------------------------------------------------- local names
//
// `fn par_new(lx: u64)` in a file that has `fn lx(..)` too: inside the body
// `lx` is the PARAMETER. Without this list it was renamed to `parser__lx`
// and was gone -- which only showed up during self compilation in
// round 31, because until then no module had a parameter named like one of
// its own functions. `modules.rs::Renamer` keeps the same list.
//
// ONLY VALUES are shadowed. A call `lx(p)` still means the function
// (`Renamer::resolve` with `is_value = false`), and a TYPE NAME
// always does.
fn loc_on(p: *mut Parser) {
    vec_push[u32](&(*p).llimit, vec_len[u32](&(*p).local) as u32)
    vec_push[u32](&(*p).rp_mark, vec_len[u32](&(*p).rp_name) as u32)
}

fn loc_off(p: *mut Parser) {
    if vec_len[u32](&(*p).llimit) == 0 {
        return
    }
    let g: u32 = vec_pop[u32](&(*p).llimit)
    while vec_len[u32](&(*p).local) > g as usize {
        vec_pop[u32](&(*p).local)
    }
    if vec_len[u32](&(*p).rp_mark) > 0 {
        let rg: u32 = vec_pop[u32](&(*p).rp_mark)
        while vec_len[u32](&(*p).rp_name) > rg as usize {
            vec_pop[u32](&(*p).rp_name)
            vec_pop[u32](&(*p).rp_flag)
        }
    }
}

// ---------------------------------------------------- reference parameters

// Index of the reference parameter `nr`, or -1.
fn rp_find(p: *mut Parser, nr: u32) -> i64 {
    var i: usize = vec_len[u32](&(*p).rp_name)
    while i > 0 {
        i = i - 1
        if vec_at[u32](&(*p).rp_name, i) == nr {
            return i as i64
        }
    }
    return -1
}

// Is the current token the word `inout`?
fn at_inout(p: *mut Parser) -> bool {
    if !actual(p, A_IDENT) {
        return false
    }
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let nr: u32 = tok_nr(p, 0)
    if intern.intern_length(it, nr) != 5 {
        return false
    }
    var w: [u8; 5] = "inout"
    return same_bytes(intern.intern_ptr(it, nr), (&w[0]) as u64, 5)
}

// Does the token AFTER the current one begin a type (or an operand)? Tells
// the keyword-like `inout T` / `inout x` from a variable named `inout`.
fn next_starts_type(p: *mut Parser) -> bool {
    let k: u32 = kind(p, 1)
    return k == A_IDENT || k == A_STAR || k == A_LBRACKET || k == A_KWFN
}

// `p` as the base of `.f` (indexing = false) or `[i]` (true): a reference
// parameter is dereferenced automatically.
fn rp_base(p: *mut Parser, e: u32, indexing: bool) -> u32 {
    if vec_len[u32](&(*p).rp_name) == 0 {
        return e
    }
    let b: *mut ast.Tree = par_tree(p)
    if ast.e_kind(b, e) != ast.E_ID {
        return e
    }
    let i: i64 = rp_find(p, ast.e_a(b, e))
    if i < 0 {
        return e
    }
    let fl: u32 = vec_at[u32](&(*p).rp_flag, i as usize)
    if indexing && (fl & 2) == 0 {
        return e
    }
    let d: u32 = ast.expr_new(b, ast.E_UN, U_DEREF, e, 0, 0)
    ast.expr_pos_set(b, d, ast.expr_pos(b, e))
    return d
}

// The write-through-`&T` check: is this place rooted in a read-only
// reference parameter? A bare name is the business of the ordinary check.
fn rp_readonly_write(p: *mut Parser, target: u32) -> bool {
    if vec_len[u32](&(*p).rp_name) == 0 {
        return false
    }
    let b: *mut ast.Tree = par_tree(p)
    if ast.e_kind(b, target) == ast.E_ID {
        return false
    }
    var x: u32 = target
    var guard: u32 = 0
    while guard < 1000 {
        guard = guard + 1
        let k: u32 = ast.e_kind(b, x)
        if k == ast.E_ID {
            let i: i64 = rp_find(p, ast.e_a(b, x))
            if i < 0 {
                return false
            }
            return (vec_at[u32](&(*p).rp_flag, i as usize) & 1) == 0
        }
        if k == ast.E_FIELD || k == ast.E_IDX {
            x = ast.e_a(b, x)
        } else if k == ast.E_UN && ast.e_a(b, x) == U_DEREF {
            x = ast.e_b(b, x)
        } else {
            return false
        }
    }
    return false
}

// A name that would hide a reference parameter is refused.
fn rp_shadow(p: *mut Parser, nr: u32) {
    if rp_find(p, nr) >= 0 {
        complain(p)
    }
}

fn loc_add(p: *mut Parser, nr: u32) { vec_push[u32](&(*p).local, nr) }

fn is_local(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).local) {
        if vec_at[u32](&(*p).local, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

fn renamed(p: *mut Parser, nr: u32) -> u32 {
    if (*p).alias == NONE {
        return nr
    }
    if !is_own(p, nr) {
        return nr
    }
    var tr: [u8; 2] = "__"
    return join(p, (*p).alias, (&tr[0]) as u64, 2, nr)
}

// Builds `module.x` and interns it.
// `module.x` becomes the SINGLE identifier `module.x` (root mode, so that the
// comparison against `firnc0 --emit=ast-canon` holds), or `module__x` once
// several files are really being compiled. Both express the same idea:
// two pieces become one unambiguous identifier.
fn qualify(p: *mut Parser, module: u32, name: u32) -> u32 {
    if (*p).multi {
        var tr: [u8; 2] = "__"
        return join(p, module_target(p, module), (&tr[0]) as u64, 2, name)
    }
    var pt: [u8; 1] = "."
    return join(p, module, (&pt[0]) as u64, 1, name)
}

fn is_module(p: *mut Parser, nr: u32) -> bool {
    var i: usize = 0
    while i < vec_len[u32](&(*p).module) {
        if vec_at[u32](&(*p).module, i) == nr {
            return true
        }
        i = i + 1
    }
    return false
}

// `import a.b as c`: the module name behind the alias `c` (`b`); any other
// name stays as it is (twin of `modules.rs`, alias -> last path part).
fn module_target(p: *mut Parser, nr: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*p).module) {
        if vec_at[u32](&(*p).module, i) == nr {
            return vec_at[u32](&(*p).module_to, i)
        }
        i = i + 1
    }
    return nr
}

// The identifier has already been read; if it is a module alias followed by
// a `.`, this builds `module.member` from it.
fn renamed_value(p: *mut Parser, nr: u32, value: bool) -> u32 {
    if value {
        if is_local(p, nr) {
            return nr
        }
    }
    return renamed(p, nr)
}

fn maybe_qualified(p: *mut Parser, nr: u32, value: bool) -> u32 {
    if !is_module(p, nr) {
        return renamed_value(p, nr, value)
    }
    if !actual(p, A_DOT) {
        return renamed_value(p, nr, value)
    }
    if kind(p, 1) != A_IDENT {
        return renamed_value(p, nr, value)
    }
    let m: u32 = tok_nr(p, 1)
    next_bump(p)
    next_bump(p)
    return qualify(p, nr, m)
}

// ------------------------------------------------------------- generics
//
// `[T, U: Int]` at the DECLARATION, `[i32, u8]` at the USE. Square brackets
// instead of angle brackets, so that `<` stays unambiguous (SPEC 12).

// Type parameter list of a template. The parameters go into the registry;
// all that is returned here is whether it worked.
fn ty_param_list(p: *mut Parser) -> bool {
    if !expect(p, A_LBRACKET) {
        return false
    }
    let off: u32 = mono.gen_tp_start(gn(p))
    (*p).tpoff = off
    while true {
        if actual(p, A_RBRACKET) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            return false
        }
        let name: u32 = tok_nr(p, 0)
        next_bump(p)
        if mono.gen_tp_duplicate(gn(p), off, name) {
            complain(p)
            return false
        }
        mono.gen_tp_add(gn(p), name)
        // ROUND 50: `T: A + B + C` -- the bounds are chained with `+` and
        // all of them hold at once. An unknown identifier is not a mistake,
        // it is the name of an interface;
        // it is checked at instantiation time.
        if eat(p, A_COLON) {
            while true {
                if !actual(p, A_IDENT) {
                    complain(p)
                    return false
                }
                let snr: u32 = tok_nr(p, 0)
                let sa: u32 = mono.gen_bound(gn(p), snr)
                if !mono.gen_tp_bound_add(gn(p), sa, snr) {
                    // the same bound appears twice
                    complain(p)
                    return false
                }
                next_bump(p)
                if !eat(p, A_PLUS) {
                    break
                }
            }
        }
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    if !expect(p, A_RBRACKET) {
        return false
    }
    if mono.gen_tp_start(gn(p)) == off {
        complain(p)
        return false
    }
    return true
}

// Type arguments at a use site: `[i32, *mut u8]`.
fn ty_args(p: *mut Parser, out: *mut Vec[u32]) -> bool {
    if !expect(p, A_LBRACKET) {
        return false
    }
    while true {
        if actual(p, A_RBRACKET) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        let t: u32 = ty(p)
        if t == ast.NOTHING {
            return false
        }
        vec_push[u32](out, t)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    if !expect(p, A_RBRACKET) {
        return false
    }
    if vec_len[u32](out) == 0 {
        complain(p)
        return false
    }
    return true
}

// ------------------------------------------------------------- type aliases
//
// `type Idx = u32` is another name for the SAME type, not a new type. It
// never reaches the type checker: a use is replaced, while parsing, by the
// node of the target. Twin of compiler/src/alias.rs -- read that file for the
// reasoning; this one only says how the stage 1 parser does it.
//
//   * the declarations of a file are found up front (`alias_search`), so the
//     order of the declarations does not matter, and an alias may name an
//     alias that stands further down;
//   * a use in another file finds the node in the registry of `mono.Gen`
//     (`gen_alias_find`) -- `firnc1.fi` parses a module before the files
//     that import it as soon as any file declares an alias;
//   * the target node is SHARED, like every unchanged node in `mono.fi`.

// Returned by `alias_lookup` for an alias that is broken (reported already).
const ALIAS_FAIL: u32 = 4294967294

// Is the token at the ABSOLUTE index `i` the head of `type NAME =` (1) or of
// `type NAME [` (2, a generic alias, refused)? 0 = neither. `type` is not a
// keyword: it is an identifier that can start an item and nothing else.
fn alias_head_at(p: *mut Parser, i: usize) -> u32 {
    if i + 2 >= (*p).n {
        return 0
    }
    if lexer.lex_kind(lx(p), i) != A_IDENT {
        return 0
    }
    var tw: [u8; 4] = "type"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, lexer.lex_nr(lx(p), i), (&tw[0]) as u64, 4) {
        return 0
    }
    if lexer.lex_kind(lx(p), i + 1) != A_IDENT {
        return 0
    }
    let k: u32 = lexer.lex_kind(lx(p), i + 2)
    if k == A_ASSIGN {
        return 1
    }
    if k == A_LBRACKET {
        return 2
    }
    return 0
}

// Does the lexer hold a `type NAME =` at the top level? (`firnc1.fi` asks
// before it parses anything: with aliases the modules are parsed in the
// order of their imports.) Free function over a lexer, no parser needed.
fn lex_has_alias(lxp: u64) -> bool {
    let l: *mut lexer.Lexer = lxp as *mut lexer.Lexer
    let n: usize = lexer.lex_count(l)
    let it: *mut intern.Interner = lexer.lex_names(l)
    var tw: [u8; 4] = "type"
    var depth: i64 = 0
    var i: usize = 0
    while i + 2 < n {
        let k: u32 = lexer.lex_kind(l, i)
        if k == A_LBRACE {
            depth = depth + 1
        }
        if k == A_RBRACE {
            depth = depth - 1
        }
        if depth == 0 && k == A_IDENT && lexer.lex_kind(l, i + 1) == A_IDENT
        && lexer.lex_kind(l, i + 2) == A_ASSIGN {
            if intern.intern_equal(it, lexer.lex_nr(l, i), (&tw[0]) as u64, 4) {
                return true
            }
        }
        i = i + 1
    }
    return false
}

// Index of the alias `q` (final spelling) of THIS file, or -1. A "bad"
// entry never answers: of two declarations the first one counts.
fn alias_find(p: *mut Parser, q: u32) -> i64 {
    var i: usize = 0
    while i < vec_len[u32](&(*p).al_name) {
        if vec_at[u32](&(*p).al_name, i) == q && vec_at[u32](&(*p).al_bad, i) == 0 {
            return i as i64
        }
        i = i + 1
    }
    return -1
}

// Reads the target of the alias `i` (once): jump to it, parse a type, come
// back. Nested aliases resolve through the same `ty`, so a chain works in
// any order, and a second visit of an entry being read is a cycle.
fn alias_resolve(p: *mut Parser, i: usize) {
    if vec_at[u32](&(*p).al_state, i) != 0 {
        return
    }
    vec_set[u32](&(*p).al_state, i, 1)
    let save_pos: usize = (*p).pos
    let save_len: bool = (*p).infer_len_ok
    let save_slit: usize = (*p).no_slit
    let save_parens: usize = (*p).parens
    (*p).pos = vec_at[u32](&(*p).al_pos, i) as usize
    (*p).infer_len_ok = false
    (*p).no_slit = 0
    (*p).parens = 0
    let t: u32 = ty(p)
    let end: usize = (*p).pos
    (*p).pos = save_pos
    (*p).infer_len_ok = save_len
    (*p).no_slit = save_slit
    (*p).parens = save_parens
    vec_set[u32](&(*p).al_end, i, end as u32)
    if t == ast.NOTHING || vec_at[u32](&(*p).al_bad, i) != 0 {
        vec_set[u32](&(*p).al_state, i, 3)
        return
    }
    vec_set[u32](&(*p).al_node, i, t)
    vec_set[u32](&(*p).al_state, i, 2)
    if has_gen(p) {
        mono.gen_alias_add(gn(p), vec_at[u32](&(*p).al_name, i), t)
    }
}

// The type a name stands for when it is an alias: its node. `NONE` = not an
// alias, `ALIAS_FAIL` = an alias that is broken (the error is counted).
fn alias_lookup(p: *mut Parser, q: u32) -> u32 {
    let i: i64 = alias_find(p, q)
    if i >= 0 {
        alias_resolve(p, i as usize)
        let st: u32 = vec_at[u32](&(*p).al_state, i as usize)
        if st == 2 {
            return vec_at[u32](&(*p).al_node, i as usize)
        }
        // being read (a cycle) or failed earlier
        complain(p)
        return ALIAS_FAIL
    }
    if has_gen(p) {
        let n: u32 = mono.gen_alias_find(gn(p), q)
        if n != NONE {
            return n
        }
    }
    return NONE
}

// Finds the declarations of this file (top level only) and reads all of
// them. Before the item loop: the order of the declarations is free.
fn alias_search(p: *mut Parser) {
    var depth: i64 = 0
    var i: usize = 0
    while i < (*p).n {
        let k: u32 = lexer.lex_kind(lx(p), i)
        if k == A_LBRACE {
            depth = depth + 1
        }
        if k == A_RBRACE {
            depth = depth - 1
        }
        if depth == 0 && alias_head_at(p, i) == 1 {
            vec_push[u32](&(*p).al_name, renamed(p, lexer.lex_nr(lx(p), i + 1)))
            vec_push[u32](&(*p).al_head, i as u32)
            vec_push[u32](&(*p).al_pos, (i + 3) as u32)
            vec_push[u32](&(*p).al_end, (i + 3) as u32)
            vec_push[u32](&(*p).al_state, 0)
            vec_push[u32](&(*p).al_node, ast.NOTHING)
            vec_push[u32](&(*p).al_bad, 0)
        }
        i = i + 1
    }
    let cnt: usize = vec_len[u32](&(*p).al_name)
    if cnt == 0 {
        return
    }
    // declared twice / the name of a struct of this file
    var a: usize = 0
    while a < cnt {
        var b: usize = 0
        while b < a {
            if vec_at[u32](&(*p).al_name, b) == vec_at[u32](&(*p).al_name, a) {
                vec_set[u32](&(*p).al_bad, a, 1)
                complain(p)
            }
            b = b + 1
        }
        let raw: u32 = lexer.lex_nr(lx(p), vec_at[u32](&(*p).al_head, a) as usize + 1)
        var k2: usize = 0
        while k2 + 1 < (*p).n {
            if lexer.lex_kind(lx(p), k2) == A_KWSTRUCT && lexer.lex_kind(lx(p), k2 + 1) == A_IDENT {
                if lexer.lex_nr(lx(p), k2 + 1) == raw {
                    vec_set[u32](&(*p).al_bad, a, 1)
                    complain(p)
                }
            }
            k2 = k2 + 1
        }
        a = a + 1
    }
    var r: usize = 0
    while r < cnt {
        alias_resolve(p, r)
        r = r + 1
    }
}

// The item `type NAME = T` itself: read already, skip over it.
fn alias_item(p: *mut Parser) {
    if alias_head_at(p, (*p).pos) == 2 {
        // `type V[T] = ...`: no generic aliases
        complain(p)
        return
    }
    var i: usize = 0
    while i < vec_len[u32](&(*p).al_head) {
        if vec_at[u32](&(*p).al_head, i) as usize == (*p).pos {
            let e: usize = vec_at[u32](&(*p).al_end, i) as usize
            if e > (*p).pos {
                (*p).pos = e
                return
            }
        }
        i = i + 1
    }
    complain(p)
}

// `P { .. }` with `type P = Point`: the name of the struct literal becomes the
// target's. `name` is in final spelling already. Anything but a plain name is
// refused.
fn alias_struct_name(p: *mut Parser, name: u32) -> u32 {
    let r: u32 = alias_lookup(p, name)
    if r == NONE {
        return name
    }
    if r == ALIAS_FAIL {
        return name
    }
    if ast.t_kind(par_tree(p), r) != ast.T_NAME {
        complain(p)
        return name
    }
    return ast.t_a(par_tree(p), r)
}

// `size_of[Idx]()` and `impl Idx { .. }`: the same, for a name that is read
// without being renamed first. `raw` is the source spelling; the answer is
// the target's name or `raw` itself.
fn alias_plain_name(p: *mut Parser, raw: u32) -> u32 {
    let r: u32 = alias_lookup(p, renamed(p, raw))
    if r == NONE {
        return raw
    }
    if r == ALIAS_FAIL {
        return raw
    }
    if ast.t_kind(par_tree(p), r) != ast.T_NAME {
        complain(p)
        return raw
    }
    return ast.t_a(par_tree(p), r)
}

// -------------------------------------------------------------------- types

fn ty(p: *mut Parser) -> u32 {
    let at: u64 = at_pos(p, 0)
    let r: u32 = ty_inner(p)
    if r != ast.NOTHING && ast.ty_pos(par_tree(p), r) == 0 {
        ast.ty_pos_set(par_tree(p), r, at)
    }
    return r
}

fn ty_inner(p: *mut Parser) -> u32 {
    // ROUND TUPLES (parser.rs::parse_type_inner): `(T1, T2, ..)`, at least
    // two elements.
    if actual(p, A_LPAREN) {
        next_bump(p)
        var tl: Vec[u32] = vec_new[u32]()
        while !actual(p, A_RPAREN) {
            let et: u32 = ty(p)
            if et == ast.NOTHING {
                vec_free[u32](&tl)
                return ast.NOTHING
            }
            vec_push[u32](&tl, et)
            if actual(p, A_COMMA) {
                next_bump(p)
                continue
            }
            break
        }
        var cx41: [u8; 39] = "after the element types of a tuple type"
        if !expect_in(p, A_RPAREN, (&cx41[0]) as u64, 39) {
            vec_free[u32](&tl)
            return ast.NOTHING
        }
        if vec_len[u32](&tl) < 2 {
            complain(p)
            vec_free[u32](&tl)
            return ast.NOTHING
        }
        // the element types have to lie WITHOUT GAPS in `children` (see the
        // function type below)
        let toff: u32 = ast.child_start(par_tree(p))
        var tk: usize = 0
        while tk < vec_len[u32](&tl) {
            ast.child_add(par_tree(p), vec_at[u32](&tl, tk))
            tk = tk + 1
        }
        let tcnt: u64 = vec_len[u32](&tl) as u64
        vec_free[u32](&tl)
        return ast.ty_new(par_tree(p), ast.T_TUP, ast.NOTHING, ((toff as u64) << 32) | tcnt)
    }
    // ROUND 58 (fnval.rs): `fn(T1, T2) -> R`, the type of a function VALUE.
    // Unambiguous: in a type position the keyword `fn` can mean nothing
    // else, and a declaration always carries a name after it.
    if actual(p, A_KWFN) {
        next_bump(p)
        var cx38: [u8; 29] = "after 'fn' in a function type"
        if !expect_in(p, A_LPAREN, (&cx38[0]) as u64, 29) {
            return ast.NOTHING
        }
        var par: Vec[u32] = vec_new[u32]()
        var ok: bool = true
        if !actual(p, A_RPAREN) {
            var more: bool = true
            while more {
                let pt: u32 = ty(p)
                if pt == ast.NOTHING {
                    ok = false
                    more = false
                } else {
                    vec_push[u32](&par, pt)
                    if actual(p, A_COMMA) {
                        next_bump(p)
                        if actual(p, A_RPAREN) {
                            more = false
                        }
                    } else {
                        more = false
                    }
                }
            }
        }
        if !ok {
            vec_free[u32](&par)
            return ast.NOTHING
        }
        var cx40: [u8; 39] = "after the parameters of a function type"
        if !expect_in(p, A_RPAREN, (&cx40[0]) as u64, 39) {
            vec_free[u32](&par)
            return ast.NOTHING
        }
        var ret: u32 = ast.NOTHING
        if actual(p, A_ARROW) {
            next_bump(p)
            ret = ty(p)
            if ret == ast.NOTHING {
                vec_free[u32](&par)
                return ast.NOTHING
            }
        }
        // The parameter types have to lie WITHOUT GAPS in `children`; a
        // nested function type would otherwise push its own list in
        // between, which is why they were collected first.
        let off: u32 = ast.child_start(par_tree(p))
        var k: usize = 0
        while k < vec_len[u32](&par) {
            ast.child_add(par_tree(p), vec_at[u32](&par, k))
            k = k + 1
        }
        let cnt: u64 = vec_len[u32](&par) as u64
        vec_free[u32](&par)
        return ast.ty_new(par_tree(p), ast.T_FN, ret, ((off as u64) << 32) | cnt)
    }
    if actual(p, A_STAR) {
        next_bump(p)
        var m: u64 = 0
        if eat(p, A_KWMUT) {
            m = 1
        }
        let inner: u32 = ty(p)
        if inner == ast.NOTHING {
            return ast.NOTHING
        }
        return ast.ty_new(par_tree(p), ast.T_PTR, inner, m)
    }
    if actual(p, A_LBRACKET) {
        next_bump(p)
        let elem: u32 = ty(p)
        if elem == ast.NOTHING {
            return ast.NOTHING
        }
        var cx42: [u8; 39] = "after the element type of an array type"
        if !expect_in(p, A_SEMI, (&cx42[0]) as u64, 39) {
            return ast.NOTHING
        }
        // ROUND 79 (gap 10 of docs/ROUND66.md): `[u8; _]` -- the length comes
        // out of the initializer. `let_stmt` fills it in as soon as it has
        // read the initializer, so `LEN_INFER` never reaches the type
        // resolution.
        var len: u64 = ast.LEN_INFER
        if actual(p, A_IDENT) {
            var us: [u8; 1] = "_"
            let itn: *mut intern.Interner = lexer.lex_names(lx(p))
            if !intern.intern_equal(itn, tok_nr(p, 0), (&us[0]) as u64, 1) {
                complain(p)
                return ast.NOTHING
            }
            // Only where an initializer follows -- a parameter, a field and
            // a `const` have to write the number out.
            if !(*p).infer_len_ok {
                complain(p)
                return ast.NOTHING
            }
        } else {
            if !actual(p, A_INT) {
                complain(p)
                return ast.NOTHING
            }
            len = number(p)
        }
        next_bump(p)
        var cx39: [u8; 22] = "after the array length"
        if !expect_in(p, A_RBRACKET, (&cx39[0]) as u64, 22) {
            return ast.NOTHING
        }
        return ast.ty_new(par_tree(p), ast.T_ARR, elem, len)
    }
    if actual(p, A_IDENT) {
        let nr: u32 = tok_nr(p, 0)
        next_bump(p)
        // ROUND 34 (gc.rs::hook_type): `Gc[C]` and `GcWeak[C]`. The type sits
        // in the tree as the placeholder `__gc#p:C` / `__gc#w:C` and is
        // resolved only during type resolution. Class names are visible
        // program wide -- so NO module renaming.
        if has_gc(p) && actual(p, A_LBRACKET) {
            var kind_nr: u32 = 0
            var g1: [u8; 2] = "Gc"
            var g2: [u8; 6] = "GcWeak"
            let it2: *mut intern.Interner = lexer.lex_names(lx(p))
            if intern.intern_equal(it2, nr, (&g1[0]) as u64, 2) {
                kind_nr = 1
            }
            if intern.intern_equal(it2, nr, (&g2[0]) as u64, 6) {
                kind_nr = 2
            }
            // ROUND 53 (gc.rs::hook_type): `GcVec[E]` and `GcMap[K,V]`.
            // Both are pointers to the runtime classes `GcVec`/`GcMap`
            // (lib/gc/gcvec.fi, lib/gc/gcmap.fi) -- `GcVec[Gc[Node]]` is
            // therefore exactly `Gc[GcVec]`. The type arguments are parsed in
            // FULL (a typo should still be caught) and then thrown away:
            // stage 0 has no generic `gc class`; the element type is checked at
            // each access, not at the container.
            var g3: [u8; 5] = "GcVec"
            var g4: [u8; 5] = "GcMap"
            if intern.intern_equal(it2, nr, (&g3[0]) as u64, 5) {
                kind_nr = 3
            }
            if intern.intern_equal(it2, nr, (&g4[0]) as u64, 5) {
                kind_nr = 4
            }
            if kind_nr == 3 || kind_nr == 4 {
                next_bump(p)
                var arg_count: u32 = 0
                var next: bool = true
                while next {
                    let ta: u32 = ty(p)
                    if ta == ast.NOTHING {
                        return ast.NOTHING
                    }
                    arg_count = arg_count + 1
                    if actual(p, A_COMMA) {
                        next_bump(p)
                    } else {
                        next = false
                    }
                }
                var should: u32 = 1
                if kind_nr == 4 {
                    should = 2
                }
                if arg_count != should {
                    complain(p)
                    return ast.NOTHING
                }
                if !expect(p, A_RBRACKET) {
                    return ast.NOTHING
                }
                rt.buf_clear(&(*p).scratch)
                var px5: [u8; 7] = "__gc#p:"
                rt.buf_push_bytes(&(*p).scratch, (&px5[0]) as u64, 7)
                if kind_nr == 3 {
                    rt.buf_push_bytes(&(*p).scratch, (&g3[0]) as u64, 5)
                } else {
                    rt.buf_push_bytes(&(*p).scratch, (&g4[0]) as u64, 5)
                }
                let pn5: u32 = intern.intern_number(it2, rt.buf_ptr(&(*p).scratch),
                    rt.buf_len(&(*p).scratch)) as u32
                return ast.ty_new(par_tree(p), ast.T_NAME, pn5, 0)
            }
            if kind_nr != 0 {
                next_bump(p)
                if !actual(p, A_IDENT) {
                    complain(p)
                    return ast.NOTHING
                }
                var kn: u32 = tok_nr(p, 0)
                next_bump(p)
                // Round GAPS (gc.rs::gc_ty_arg): `Gc[module.Class]` -- class
                // names are global, the last segment is the class.
                while actual(p, A_DOT) && kind(p, 1) == A_IDENT {
                    next_bump(p)
                    kn = tok_nr(p, 0)
                    next_bump(p)
                }
                if !expect(p, A_RBRACKET) {
                    return ast.NOTHING
                }
                rt.buf_clear(&(*p).scratch)
                if kind_nr == 1 {
                    var px1: [u8; 7] = "__gc#p:"
                    rt.buf_push_bytes(&(*p).scratch, (&px1[0]) as u64, 7)
                } else {
                    var px2: [u8; 7] = "__gc#w:"
                    rt.buf_push_bytes(&(*p).scratch, (&px2[0]) as u64, 7)
                }
                rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it2, kn),
                    intern.intern_length(it2, kn))
                let pn: u32 = intern.intern_number(it2, rt.buf_ptr(&(*p).scratch),
                    rt.buf_len(&(*p).scratch)) as u32
                return ast.ty_new(par_tree(p), ast.T_NAME, pn, 0)
            }
        }
        // `E!T` -- an error union (errors.rs::hook_type). The parser puts the
        // entry into the registry and a placeholder `__eu#<n>` into the tree;
        // the type checker resolves it later. The order matters: `!` comes
        // BEFORE the `[` of the generics, exactly as in stage 0
        // (`hook_type` runs before `hook_generic_type`).
        if has_fe(p) && actual(p, A_NOT) {
            next_bump(p)
            let inner: u32 = ty(p)
            if inner == ast.NOTHING {
                return ast.NOTHING
            }
            let pi: u32 = err.error_pending_add(fh(p), nr, inner)
            let it: *mut intern.Interner = lexer.lex_names(lx(p))
            rt.buf_clear(&(*p).scratch)
            var eu: [u8; 5] = "__eu#"
            rt.buf_push_bytes(&(*p).scratch, (&eu[0]) as u64, 5)
            rt.buf_push_dec_u64(&(*p).scratch, pi as u64)
            let pn: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
                rt.buf_len(&(*p).scratch)) as u32
            return ast.ty_new(par_tree(p), ast.T_NAME, pn, 0)
        }
        // r707: `mod.Box[i32]` -- the generic names hold program wide, so
        // the module part is dropped (firnc0: sema_generic.rs::
        // hook_qual_generic_type).
        var gnr: u32 = nr
        if has_gen(p) && is_module(p, nr) && actual(p, A_DOT) && kind(p, 1) == A_IDENT && kind(p, 2) == A_LBRACKET {
            if mono.gen_is_struct(gn(p), tok_nr(p, 1)) {
                gnr = tok_nr(p, 1)
                next_bump(p)
                next_bump(p)
            }
        }
        // `Idx[3]` with `type Idx = ...`: an alias takes no type arguments
        if actual(p, A_LBRACKET) && alias_find(p, renamed(p, gnr)) >= 0 {
            complain(p)
            return ast.NOTHING
        }
        // A `[` after a type name is a generic instantiation.
        if actual(p, A_LBRACKET) {
            var generic: bool = false
            if has_gen(p) {
                generic = mono.gen_is_struct(gn(p), gnr)
            }
            if !generic {
                (*p).not_core = true
                complain(p)
                return ast.NOTHING
            }
            var targs: Vec[u32] = vec_new[u32]()
            let ok: bool = ty_args(p, &targs)
            if !ok {
                vec_free[u32](&targs)
                return ast.NOTHING
            }
            let m: u32 = mono.gen_instance(gn(p), gnr, &targs, false)
            vec_free[u32](&targs)
            return ast.ty_new(par_tree(p), ast.T_NAME, m, 0)
        }
        // ROUND 46 (iface.rs::hook_type): `dyn I` -- the interface value.
        // It becomes a SINGLE identifier containing a space; type resolution
        // sorts it out later. Interface names are visible program wide and
        // are NOT renamed.
        var dw: [u8; 3] = "dyn"
        let itd: *mut intern.Interner = lexer.lex_names(lx(p))
        if intern.intern_equal(itd, nr, (&dw[0]) as u64, 3) && actual(p, A_IDENT) {
            let inr: u32 = tok_nr(p, 0)
            next_bump(p)
            rt.buf_clear(&(*p).scratch)
            var dw2: [u8; 4] = "dyn "
            rt.buf_push_bytes(&(*p).scratch, (&dw2[0]) as u64, 4)
            rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(itd, inr),
                intern.intern_length(itd, inr))
            let dn: u32 = intern.intern_number(itd, rt.buf_ptr(&(*p).scratch),
                rt.buf_len(&(*p).scratch)) as u32
            return ast.ty_new(par_tree(p), ast.T_NAME, dn, 0)
        }
        let q: u32 = maybe_qualified(p, nr, false)
        // A name that is an alias IS its target: the node of the target
        // (twin of `alias::hook_use`).
        let al: u32 = alias_lookup(p, q)
        if al == ALIAS_FAIL {
            return ast.NOTHING
        }
        if al != NONE {
            return al
        }
        return ast.ty_new(par_tree(p), ast.T_NAME, q, 0)
    }
    var ty1: [u8; 15] = "expected a type"
    complain_found(p, (&ty1[0]) as u64, 15)
    return ast.NOTHING
}

// -------------------------------------------------------------- expressions

fn expr(p: *mut Parser) -> u32 {
    var e: u32 = or_expr(p)
    // `expr catch fallback` or `expr catch |f| fallback` -- binds more
    // WEAKLY than any operator and is left associative; the fallback is
    // an or expression (errors.rs::hook_catch). The tree holds a call
    // `__catch#` with two arguments; the binding itself lives in the
    // registry.
    if has_fe(p) {
        while actual(p, A_KWCATCH) {
            next_bump(p)
            var bind: u32 = NONE
            if actual(p, A_PIPE) {
                next_bump(p)
                if !actual(p, A_IDENT) {
                    complain(p)
                    return e
                }
                bind = tok_nr(p, 0)
                next_bump(p)
                if !expect(p, A_PIPE) {
                    return e
                }
            }
            // The binding is a LOCAL name -- visible only inside the fallback
            // and left out of the module renaming, just like the binding of a
            // pattern (round 32).
            if bind != NONE {
                loc_on(p)
                loc_add(p, bind)
            }
            let rhs: u32 = or_expr(p)
            if bind != NONE {
                loc_off(p)
            }
            var tmp: Vec[u32] = vec_new[u32]()
            vec_push[u32](&tmp, e)
            vec_push[u32](&tmp, rhs)
            let off: u32 = list_store(p, &tmp)
            vec_free[u32](&tmp)
            var cn: [u8; 8] = "__catch#"
            let it: *mut intern.Interner = lexer.lex_names(lx(p))
            let name: u32 = intern.intern_number(it, (&cn[0]) as u64, 8) as u32
            let old_e: u32 = e
            e = ast.expr_new(par_tree(p), ast.E_CALL, name, off, 2, 0)
            pos_from(p, e, old_e)
            if bind != NONE {
                err.error_cb_set(fh(p), e, bind)
            }
        }
    }
    return e
}

// Expression without a struct literal at the top level (conditions).
fn cond_expr(p: *mut Parser) -> u32 {
    (*p).no_slit = (*p).no_slit + 1
    let e: u32 = expr(p)
    (*p).no_slit = (*p).no_slit - 1
    return e
}

// Expression in parentheses or arguments: struct literals are allowed there.
fn inner_expr(p: *mut Parser) -> u32 {
    let remembered: usize = (*p).no_slit
    (*p).no_slit = 0
    (*p).parens = (*p).parens + 1
    let e: u32 = expr(p)
    (*p).parens = (*p).parens - 1
    (*p).no_slit = remembered
    return e
}

fn or_expr(p: *mut Parser) -> u32 {
    var left: u32 = and_expr(p)
    while actual(p, A_OROR) && next(p) {
        next_bump(p)
        (*p).no_q = (*p).no_q + 1
        let right: u32 = and_expr(p)
        (*p).no_q = (*p).no_q - 1
        let old_left: u32 = left
        left = ast.expr_new(par_tree(p), ast.E_BIN, B_LOR, left, right, 0)
        pos_from(p, left, old_left)
    }
    return left
}

fn and_expr(p: *mut Parser) -> u32 {
    var left: u32 = cmp_expr(p)
    while actual(p, A_ANDAND) && next(p) {
        next_bump(p)
        (*p).no_q = (*p).no_q + 1
        let right: u32 = cmp_expr(p)
        (*p).no_q = (*p).no_q - 1
        let old_left: u32 = left
        left = ast.expr_new(par_tree(p), ast.E_BIN, B_LAND, left, right, 0)
        pos_from(p, left, old_left)
    }
    return left
}

// -1 = no comparison operator
fn cmp_op(a: u32) -> i32 {
    if a == A_EQEQ { return B_EQ as i32 }
    if a == A_NOTEQ { return B_NE as i32 }
    if a == A_LT { return B_LT as i32 }
    if a == A_LE { return B_LE as i32 }
    if a == A_GT { return B_GT as i32 }
    if a == A_GE { return B_GE as i32 }
    return -1
}

// Comparisons are NOT associative (SPEC 10.1: exactly one comparison).
fn cmp_expr(p: *mut Parser) -> u32 {
    let left: u32 = add_expr(p)
    let op: i32 = cmp_op(kind(p, 0))
    if op < 0 || !next(p) {
        return left
    }
    next_bump(p)
    let right: u32 = add_expr(p)
    var e: u32 = ast.expr_new(par_tree(p), ast.E_BIN, op as u32, left, right, 0)
    pos_from(p, e, left)
    while cmp_op(kind(p, 0)) >= 0 && next(p) {
        complain(p)
        let op2: i32 = cmp_op(kind(p, 0))
        next_bump(p)
        let r2: u32 = add_expr(p)
        let old_e: u32 = e
        e = ast.expr_new(par_tree(p), ast.E_BIN, op2 as u32, e, r2, 0)
        pos_from(p, e, old_e)
    }
    return e
}

fn add_op(a: u32) -> i32 {
    if a == A_PLUS { return B_ADD as i32 }
    if a == A_MINUS { return B_SUB as i32 }
    if a == A_PIPE { return B_OR as i32 }
    if a == A_CARET { return B_XOR as i32 }
    // ROUND 72: explicit wrap/saturate, same precedence as `+`/`-`.
    if a == A_PLUSPERCENT { return B_ADDWRAP as i32 }
    if a == A_MINUSPERCENT { return B_SUBWRAP as i32 }
    if a == A_PLUSPIPE { return B_ADDSAT as i32 }
    if a == A_MINUSPIPE { return B_SUBSAT as i32 }
    return -1
}

fn add_expr(p: *mut Parser) -> u32 {
    var left: u32 = mul_expr(p)
    while add_op(kind(p, 0)) >= 0 && next(p) {
        let op: i32 = add_op(kind(p, 0))
        next_bump(p)
        let right: u32 = mul_expr(p)
        let old_left: u32 = left
        left = ast.expr_new(par_tree(p), ast.E_BIN, op as u32, left, right, 0)
        pos_from(p, left, old_left)
    }
    return left
}

fn mul_op(a: u32) -> i32 {
    if a == A_STAR { return B_MUL as i32 }
    if a == A_SLASH { return B_DIV as i32 }
    if a == A_PERCENT { return B_REM as i32 }
    if a == A_AMP { return B_AND as i32 }
    if a == A_SHL { return B_SHL as i32 }
    if a == A_SHR { return B_SHR as i32 }
    // ROUND 72: explicit wrap/saturate multiply, same precedence as `*`.
    if a == A_STARPERCENT { return B_MULWRAP as i32 }
    if a == A_STARPIPE { return B_MULSAT as i32 }
    return -1
}

fn mul_expr(p: *mut Parser) -> u32 {
    var left: u32 = un_expr(p)
    while mul_op(kind(p, 0)) >= 0 && next(p) {
        let op: i32 = mul_op(kind(p, 0))
        next_bump(p)
        let right: u32 = un_expr(p)
        let old_left: u32 = left
        left = ast.expr_new(par_tree(p), ast.E_BIN, op as u32, left, right, 0)
        pos_from(p, left, old_left)
    }
    return left
}

// ROUND 79 -- the position of every OPERAND. `un_expr` is the point every
// operand of an expression goes through, so one wrapper here gives `&x`,
// `f(a)`, `x` and every literal the place of its FIRST token -- exactly
// what `Expr::span` is in `firnc0`. Binary nodes get none and need none:
// no message of the escape analysis points at one.
fn un_expr(p: *mut Parser) -> u32 {
    let at: u64 = at_pos(p, 0)
    let e: u32 = un_expr_inner(p)
    if ast.expr_pos(par_tree(p), e) == 0 {
        ast.expr_pos_set(par_tree(p), e, at)
    }
    len_default(p, e)
    return e
}

// ROUND r196 -- the width of the marker of the operand `e` that was just
// parsed: from its position to the end of the LAST token consumed, when both
// sit on one line (`Parser::join` of firnc0 clips a span to its first line
// the same way; a multi-line operand keeps the width of its first token).
// Only a node without a width gets one: `( e )` returns the inner node, which
// already has its own.
fn len_default(p: *mut Parser, e: u32) {
    if e == NONE {
        return
    }
    let b: *mut ast.Tree = par_tree(p)
    if e as usize >= ast.expr_count(b) || ast.expr_len(b, e) != 0 {
        return
    }
    let pos: u64 = ast.expr_pos(b, e)
    if ast.pos_line(pos) == 0 || (*p).pos == 0 || (*p).pos > (*p).n {
        return
    }
    var last: usize = (*p).pos - 1
    let l: *mut lexer.Lexer = lx(p)
    // firnc0 ends the span of a block at its LAST STATEMENT, not at the `}`,
    // so an `if` expression stops before the closing brace of its else branch
    if ast.e_kind(b, e) == ast.E_IFEX && last > 0 && lexer.lex_kind(l, last) == A_RBRACE {
        last = last - 1
    }
    let eline: u32 = lexer.lex_line(l, last)
    let ecol: u32 = lexer.lex_col(l, last) + lexer.lex_length(l, last)
    var n: u32 = 0
    if eline == ast.pos_line(pos) && ecol > ast.pos_col(pos) {
        n = ecol - ast.pos_col(pos)
    } else {
        // the first token of the operand
        var first: usize = (*p).pos
        while first > 0 && (lexer.lex_line(l, first - 1) > ast.pos_line(pos)
            || (lexer.lex_line(l, first - 1) == ast.pos_line(pos)
                && lexer.lex_col(l, first - 1) >= ast.pos_col(pos))) {
            first = first - 1
        }
        n = lexer.lex_length(l, first)
    }
    ast.expr_len_set(b, e, n)
}

fn un_expr_inner(p: *mut Parser) -> u32 {
    let a: u32 = kind(p, 0)
    // ROUND REF: `inout x` as an argument is the address of `x`.
    if at_inout(p) && next_starts_type(p) {
        next_bump(p)
        let io: u32 = un_expr(p)
        let ib: *mut ast.Tree = par_tree(p)
        if ast.e_kind(ib, io) == ast.E_ID {
            let ri: i64 = rp_find(p, ast.e_a(ib, io))
            if ri >= 0 {
                // A reborrow. A read-only `&T` cannot be handed on as `inout`.
                if (vec_at[u32](&(*p).rp_flag, ri as usize) & 1) == 0 {
                    complain(p)
                }
                return io
            }
        }
        return ast.expr_new(ib, ast.E_UN, U_INOUT, io, 0, 0)
    }
    var op: i32 = -1
    if a == A_MINUS { op = U_NEG as i32 }
    else if a == A_NOT { op = U_NOT as i32 }
    else if a == A_AMP { op = U_ADDR as i32 }
    else if a == A_STAR { op = U_DEREF as i32 }
    else if a == A_TILDE { op = U_BITNOT as i32 }
    if op < 0 {
        return after_expr(p)
    }
    next_bump(p)
    let inner: u32 = un_expr(p)
    // ROUND REF: `&p` on a reference parameter passes the reference on.
    if op == U_ADDR as i32 && ast.e_kind(par_tree(p), inner) == ast.E_ID {
        if rp_find(p, ast.e_a(par_tree(p), inner)) >= 0 {
            return inner
        }
    }
    return ast.expr_new(par_tree(p), ast.E_UN, op as u32, inner, 0, 0)
}

// COLLECT into a scratch list first, then move it into `children` in one go.
//
// The obvious way -- appending each argument straight away -- breaks as soon
// as an argument contains a call of its own: its arguments then land
// RIGHT IN THE MIDDLE of the outer list. That is what happened on the first
// attempt: `f(a, g(b))` came out as `f(a, b, g(b))`. Child lists have to be
// contiguous, so the inner list is finished first.
fn list_store(p: *mut Parser, tmp: *mut Vec[u32]) -> u32 {
    let off: u32 = ast.child_start(par_tree(p))
    var i: usize = 0
    while i < vec_len[u32](tmp) {
        ast.child_add(par_tree(p), vec_at[u32](tmp, i))
        i = i + 1
    }
    return off
}

// Argument list, the '(' already consumed. The arguments go into a SCRATCH
// BUFFER and are moved into `children` in one go -- a nested call would
// otherwise drop its own list in between (the same lesson as in
// `list_store`). For a method call the receiver is already in there.
fn call_args_in(p: *mut Parser, tmp: *mut Vec[u32]) {
    while true {
        if actual(p, A_RPAREN) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        var e: u32 = ast.NOTHING
        if actual(p, A_IDENT) && kind(p, 1) == A_COLON && kind(p, 2) != A_COLON {
            // r664: named argument `name: expr`
            let nm: u32 = tok_nr(p, 0)
            let npos: u64 = at_pos(p, 0)
            next_bump(p)
            next_bump(p)
            let v: u32 = inner_expr(p)
            e = ast.expr_new(par_tree(p), ast.E_NAMED, nm, v, 0, 0)
            ast.expr_pos_set(par_tree(p), e, npos)
        } else {
            e = inner_expr(p)
        }
        vec_push[u32](tmp, e)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    var cx8: [u8; 23] = "after the argument list"
    expect_in(p, A_RPAREN, (&cx8[0]) as u64, 23)
}

fn call_args(p: *mut Parser) -> u32 {
    var tmp: Vec[u32] = vec_new[u32]()
    call_args_in(p, &tmp)
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    return off
}

// ROUND 45 (impls.rs): `"method " ++ <ident>` -- the callee of a method call
// that is not resolved yet. The space makes it an identifier that nothing in
// the source text can ever collide with.
fn method_call_name(p: *mut Parser, nr: u32) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    rt.buf_clear(&(*p).scratch)
    var w: [u8; 7] = "method "
    rt.buf_push_bytes(&(*p).scratch, (&w[0]) as u64, 7)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, nr),
        intern.intern_length(it, nr))
    return intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
}

// r712 -- `i64` cast of a slice bound; an omitted bound is the literal `dflt`.
// The cast takes the span of the bound (parser.rs: `esp = e.span`), the omitted bound the span of the colon.
fn slice_bound(p: *mut Parser, x0: u32, dflt: u64, colon: u64) -> u32 {
    var x: u32 = x0
    if x == NONE {
        x = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, dflt)
        ast.expr_pos_set(par_tree(p), x, colon)
    }
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    var w: [u8; 3] = "i64"
    let nr: u32 = intern.intern_number(it, (&w[0]) as u64, 3) as u32
    let t: u32 = ast.ty_new(par_tree(p), ast.T_NAME, nr, 0)
    let cast: u32 = ast.expr_new(par_tree(p), ast.E_AS, x, t, 0, 0)
    ast.expr_pos_set(par_tree(p), cast, ast.expr_pos(par_tree(p), x))
    return cast
}

// r712 (parser.rs::slice_rest) -- `x[a:b]` is the method call
// `x.slice(a as i64, b as i64)`. The current token is the first `:`.
fn slice_rest(p: *mut Parser, base: u32, lo: u32) -> u32 {
    let colon: u64 = pos_now(p)
    next_bump(p)
    var hi: u32 = NONE
    if !actual(p, A_RBRACKET) && !actual(p, A_COLON) {
        hi = inner_expr(p)
    }
    // r738 (parser.rs::slice_rest): `x[a:b:c]` -- extended slice with a step
    var has_step: bool = false
    var st: u32 = NONE
    if actual(p, A_COLON) {
        next_bump(p)
        has_step = true
        if !actual(p, A_RBRACKET) {
            st = inner_expr(p)
        }
    }
    var cx29: [u8; 15] = "after the slice"
    expect_in(p, A_RBRACKET, (&cx29[0]) as u64, 15)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if has_step {
        // r744: an omitted bound is marked by the `flags` argument (bit 0 = start,
        // bit 1 = stop), never by a magic value
        var fl: u64 = 0
        if lo == NONE { fl = fl | 1 }
        if hi == NONE { fl = fl | 2 }
        let sa: u32 = slice_bound(p, lo, 0, colon)
        let sb: u32 = slice_bound(p, hi, 0, colon)
        let sc: u32 = slice_bound(p, st, 1, colon)
        let sf: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, fl)
        ast.expr_pos_set(par_tree(p), sf, colon)
        var ws: [u8; 10] = "slice_step"
        let nrs: u32 = intern.intern_number(it, (&ws[0]) as u64, 10) as u32
        let mnames: u32 = method_call_name(p, nrs)
        var tmps: Vec[u32] = vec_new[u32]()
        vec_push[u32](&tmps, base)
        vec_push[u32](&tmps, sa)
        vec_push[u32](&tmps, sb)
        vec_push[u32](&tmps, sc)
        vec_push[u32](&tmps, sf)
        let offs: u32 = list_store(p, &tmps)
        vec_free[u32](&tmps)
        return ast.expr_new(par_tree(p), ast.E_CALL, mnames, offs, 5, 0)
    }
    let a: u32 = slice_bound(p, lo, 0, colon)
    let b: u32 = slice_bound(p, hi, 9223372036854775807, colon)
    var w: [u8; 5] = "slice"
    let nr: u32 = intern.intern_number(it, (&w[0]) as u64, 5) as u32
    let mname: u32 = method_call_name(p, nr)
    var tmp: Vec[u32] = vec_new[u32]()
    vec_push[u32](&tmp, base)
    vec_push[u32](&tmp, a)
    vec_push[u32](&tmp, b)
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    return ast.expr_new(par_tree(p), ast.E_CALL, mname, off, 3, 0)
}

fn after_expr(p: *mut Parser) -> u32 {
    var e: u32 = basic_expr(p)
    // ROUND 72: every postfix form -- field, index, call, method call,
    // `as` -- has `join(e.span, ...)` as its span in `firnc0`, which is
    // the BASE expression's start. It never moves along the chain, so one
    // word read once is enough.
    let base_pos: u64 = ast.expr_pos(par_tree(p), e)
    while true {
        if !next(p) {
            return e
        }
        let a: u32 = kind(p, 0)
        if a == A_QUESTION {
            e = question_op(p, e)
            continue
        }
        if a == A_DOT {
            next_bump(p)
            // ROUND 34 (gc.rs::hook_postfix): `x.as?[C]` -- the checked
            // downcast. In the tree it is a call `__gc#as:C`.
            if has_gc(p) && actual(p, A_KWAS) && kind(p, 1) == A_QUESTION {
                next_bump(p)
                next_bump(p)
                if !expect(p, A_LBRACKET) {
                    return e
                }
                if !actual(p, A_IDENT) {
                    complain(p)
                    return e
                }
                let kn: u32 = tok_nr(p, 0)
                next_bump(p)
                if !expect(p, A_RBRACKET) {
                    return e
                }
                let it4: *mut intern.Interner = lexer.lex_names(lx(p))
                rt.buf_clear(&(*p).scratch)
                var px5: [u8; 8] = "__gc#as:"
                rt.buf_push_bytes(&(*p).scratch, (&px5[0]) as u64, 8)
                rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it4, kn),
                    intern.intern_length(it4, kn))
                let an: u32 = intern.intern_number(it4, rt.buf_ptr(&(*p).scratch),
                    rt.buf_len(&(*p).scratch)) as u32
                var tmp4: Vec[u32] = vec_new[u32]()
                vec_push[u32](&tmp4, e)
                let off4: u32 = list_store(p, &tmp4)
                vec_free[u32](&tmp4)
                e = ast.expr_new(par_tree(p), ast.E_CALL, an, off4, 1, 0)
                pos_default(p, e, base_pos)
                continue
            }
            // ROUND TUPLES -- `t.0`: the lexer reads the digits behind a `.`
            // as an integer (lexer.fi::lex_tuple_index). The field is
            // called by the digits.
            if actual(p, A_INT) {
                let inr: u32 = index_name(p, number(p))
                next_bump(p)
                e = rp_base(p, e, false)
                e = ast.expr_new(par_tree(p), ast.E_FIELD, e, inr, 0, 0)
                pos_default(p, e, base_pos)
                continue
            }
            if !actual(p, A_IDENT) {
                complain(p)
                return e
            }
            let nr: u32 = tok_nr(p, 0)
            let nm_at: u64 = at_pos(p, 0)
            next_bump(p)
            // ROUND 45 (impls.rs::hook_method_call): if a parenthesis
            // follows, this is a METHOD CALL. The receiver becomes the
            // first argument; which function is meant is decided by the
            // type checker, from the receiver type.
            // The parenthesis has to be on the SAME line (`next`) -- otherwise
            // a following statement that starts with `(` would turn into
            // a method call on the field access before it.
            if next(p) && actual(p, A_LPAREN) {
                next_bump(p)
                var mtmp: Vec[u32] = vec_new[u32]()
                vec_push[u32](&mtmp, e)
                call_args_in(p, &mtmp)
                let mname: u32 = method_call_name(p, nr)
                let mlaen: u32 = vec_len[u32](&mtmp) as u32
                let moff: u32 = list_store(p, &mtmp)
                vec_free[u32](&mtmp)
                e = ast.expr_new(par_tree(p), ast.E_CALL, mname, moff, mlaen, 0)
                pos_default(p, e, base_pos)
                continue
            }
            e = rp_base(p, e, false)
            e = ast.expr_new(par_tree(p), ast.E_FIELD, e, nr, 0, 0)
            ast.expr_aux_set(par_tree(p), e, nm_at)
            pos_default(p, e, base_pos)
        } else if a == A_LBRACKET {
            // `sum[i32](a, b)` -- a call of a generic template. This is
            // the only place where a `[` after an expression does NOT mean
            // indexing; the IDENTIFIER decides.
            var template: bool = false
            if has_gen(p) && ast.e_kind(par_tree(p), e) == ast.E_ID {
                template = mono.gen_is_fn(gn(p), ast.e_a(par_tree(p), e))
            }
            if template {
                let base: u32 = ast.e_a(par_tree(p), e)
                var targs: Vec[u32] = vec_new[u32]()
                let ok: bool = ty_args(p, &targs)
                if !ok {
                    vec_free[u32](&targs)
                    return e
                }
                let m: u32 = mono.gen_instance(gn(p), base, &targs, true)
                vec_free[u32](&targs)
                if !actual(p, A_LPAREN) {
                    // r718: `id[i32]` without a call = the instance as a fn value
                    e = ast.expr_new(par_tree(p), ast.E_ID, m, 0, 0, 0)
                    pos_default(p, e, base_pos)
                    continue
                }
                next_bump(p)
                let off: u32 = call_args(p)
                let len: u32 = ast.child_count(par_tree(p)) - off
                e = ast.expr_new(par_tree(p), ast.E_CALL, m, off, len, 0)
                pos_default(p, e, base_pos)
            } else {
                next_bump(p)
                // r712 (parser.rs::slice_rest): `x[a:b]`, `x[a:]`, `x[:b]`, `x[:]`
                var slice_lo: u32 = NONE
                var is_slice: bool = actual(p, A_COLON)
                if !is_slice {
                    slice_lo = inner_expr(p)
                    is_slice = actual(p, A_COLON)
                }
                if is_slice {
                    e = slice_rest(p, e, slice_lo)
                    pos_default(p, e, base_pos)
                    continue
                }
                let idx: u32 = slice_lo
                var cx1: [u8; 15] = "after the index"
                expect_in(p, A_RBRACKET, (&cx1[0]) as u64, 15)
                e = rp_base(p, e, true)
                e = ast.expr_new(par_tree(p), ast.E_IDX, e, idx, 0, 0)
                pos_default(p, e, base_pos)
            }
        } else if a == A_LPAREN {
            // r728 (parser.rs HOOK callidx): `v[i](x)`, `(expr)(x)` -- the
            // callee is the receiver of the hidden method `__call`.
            if ast.e_kind(par_tree(p), e) != ast.E_ID {
                next_bump(p)
                var ctmp: Vec[u32] = vec_new[u32]()
                vec_push[u32](&ctmp, e)
                call_args_in(p, &ctmp)
                let cit: *mut intern.Interner = lexer.lex_names(lx(p))
                var cw: [u8; 6] = "__call"
                let cnr: u32 = intern.intern_number(cit, (&cw[0]) as u64, 6) as u32
                let cname: u32 = method_call_name(p, cnr)
                let clen: u32 = vec_len[u32](&ctmp) as u32
                let coff: u32 = list_store(p, &ctmp)
                vec_free[u32](&ctmp)
                e = ast.expr_new(par_tree(p), ast.E_CALL, cname, coff, clen, 0)
                pos_default(p, e, base_pos)
                continue
            }
            let name: u32 = ast.e_a(par_tree(p), e)
            next_bump(p)
            let off: u32 = call_args(p)
            let len: u32 = ast.child_count(par_tree(p)) - off
            // HOOK env (round FIRN-ENV, compiler/src/env.rs): `__env_or(...)`
            // and `__env_has(...)` do not become a call at all -- they become
            // the LITERAL they stand for, here and now. `firnc0` folds at the
            // same place and in the same ORDER, so both compilers create the
            // same number of nodes and `_fseg...` of an interpolation gets
            // the same name on both sides (tools/parser_compare.sh).
            let ek: u32 = env_kind(p, name)
            if ek != 0 {
                e = env_call(p, ek, off, len)
            } else {
                e = ast.expr_new(par_tree(p), ast.E_CALL, name, off, len, 0)
            }
            pos_default(p, e, base_pos)
        } else if a == A_KWAS {
            next_bump(p)
            // Round GAPS (wrapcast.rs): `x as% T`, never checked -- the
            // flag sits in `c` (every other cast has 0 there).
            var wrapping: u32 = 0
            if actual(p, A_PERCENT) {
                next_bump(p)
                wrapping = 1
            }
            let t: u32 = ty(p)
            if t == ast.NOTHING {
                return e
            }
            e = ast.expr_new(par_tree(p), ast.E_AS, e, t, wrapping, 0)
            pos_default(p, e, base_pos)
        } else {
            return e
        }
    }
    return e
}

// `Type{ field: value, ... }` -- the '{' has not been consumed yet.
fn struct_literal(p: *mut Parser, name0: u32) -> u32 {
    // HOOK alias: `P { .. }` with `type P = Point` builds a `Point`
    let name: u32 = alias_struct_name(p, name0)
    next_bump(p)
    var tmp: Vec[u32] = vec_new[u32]()
    var fps: Vec[u64] = vec_new[u64]()
    while true {
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        vec_push[u64](&fps, at_pos(p, 0))
        next_bump(p)
        var cx35: [u8; 42] = "after the field name in the struct literal"
        if !expect_in(p, A_COLON, (&cx35[0]) as u64, 42) {
            break
        }
        let value: u32 = inner_expr(p)
        vec_push[u32](&tmp, fname)
        vec_push[u32](&tmp, value)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    var cx36: [u8; 32] = "at the end of the struct literal"
    expect_in(p, A_RBRACE, (&cx36[0]) as u64, 32)
    let len: u32 = vec_len[u32](&tmp) as u32 / 2
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    let fp0: u64 = ast.fpos_count(par_tree(p)) + 1
    var fi: usize = 0
    while fi < vec_len[u64](&fps) {
        ast.fpos_add(par_tree(p), vec_at[u64](&fps, fi))
        fi = fi + 1
    }
    vec_free[u64](&fps)
    let se: u32 = ast.expr_new(par_tree(p), ast.E_SLIT, name, off, len, 0)
    ast.expr_aux_set(par_tree(p), se, fp0)
    return se
}

// A string literal becomes an ARRAY LITERAL of integers -- exactly as in
// `firnc0`. Its type is therefore `[u8; N]` or `[u16; N]`, and type checker
// and lowering need nothing special. The routine reads from the lexer it is
// handed, so that interpolation can reuse it for its own text segments
// (round 39).
fn alit_out_lit(p: *mut Parser, lx2: *mut lexer.Lexer, k: usize) -> u32 {
    let la: u32 = lexer.lex_lit_kind(lx2, k)
    let n: usize = lexer.lex_lit_len(lx2, k)
    var tmp: Vec[u32] = vec_new[u32]()
    var i: usize = 0
    while i < n {
        var w: u64 = 0
        if la == 2 {
            w = lexer.lex_lit_unit(lx2, k, i) as u64
        } else {
            w = lexer.lex_lit_byte(lx2, k, i) as u64
        }
        vec_push[u32](&tmp, ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, w))
        i = i + 1
    }
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    return ast.expr_new(par_tree(p), ast.E_ALIT, 0, off, n as u32, 0)
}

// -------------------------------------------------------- inline assembly
//
// ROUND 52 (compiler/src/core.rs). Grammar:
//
//   asm_expr     = "asm" "(" str_lit { "," asm_op } ")" ;
//   asm_op       = "in"      "(" str_lit ")" expr
//                | "out"     "(" str_lit ")"            (ROUND 52: the value)
//                | "out"     "(" str_lit ")" expr       (ROUND 68: memory)
//                | "clobber" "(" str_lit ")" ;
//
// The tree holds a call `asm$<number>` with the INPUT EXPRESSIONS as its
// arguments; template, registers and clobbers live in the tree registry
// (`ast.asm_add`). `firnc0` splits it exactly the same way, which is why
// `--emit=ast-canon` prints the same text on both sides.

// The string literal at the current position, as an interned number.
fn lit_intern(p: *mut Parser) -> u32 {
    let k: usize = tok_nr(p, 0) as usize
    let n: usize = lexer.lex_lit_len(lx(p), k)
    rt.buf_clear(&(*p).scratch)
    var i: usize = 0
    while i < n {
        rt.buf_push(&(*p).scratch, lexer.lex_lit_byte(lx(p), k, i))
        i = i + 1
    }
    next_bump(p)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    return intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
}

fn asm_block(p: *mut Parser) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    next_bump(p)
    next_bump(p)
    let template: u32 = lit_intern(p)
    var out: u32 = ast.NOTHING
    var regs: Vec[u32] = vec_new[u32]()
    var clobs: Vec[u32] = vec_new[u32]()
    var args: Vec[u32] = vec_new[u32]()
    // ROUND 68: the MEMORY outputs. Their address expressions go into the
    // SAME argument list, behind the inputs -- type check and lowering
    // split the list at the number of inputs.
    var oregs: Vec[u32] = vec_new[u32]()
    var oargs: Vec[u32] = vec_new[u32]()
    var ow: [u8; 3] = "out"
    var cw: [u8; 7] = "clobber"
    while eat(p, A_COMMA) {
        if actual(p, A_RPAREN) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        var which: u32 = 3
        if actual(p, A_KWIN) {
            next_bump(p)
            which = 0
        } else if actual(p, A_IDENT) && intern.intern_equal(it, tok_nr(p, 0), (&ow[0]) as u64, 3) {
            next_bump(p)
            which = 1
        } else if actual(p, A_IDENT) && intern.intern_equal(it, tok_nr(p, 0), (&cw[0]) as u64, 7) {
            next_bump(p)
            which = 2
        }
        if which == 3 {
            complain(p)
            break
        }
        if !expect(p, A_LPAREN) {
            break
        }
        if !actual(p, A_STR) {
            complain(p)
            break
        }
        let reg: u32 = lit_intern(p)
        if !expect(p, A_RPAREN) {
            break
        }
        if which == 0 {
            vec_push[u32](&regs, reg)
            vec_push[u32](&args, inner_expr(p))
        } else if which == 1 {
            // ROUND 68: `out("rdx") p` -- with an expression behind it the
            // register goes into `*p`, and of those there may be any
            // number. Without one it stays the VALUE of the expression,
            // and of those there is still at most one.
            if actual(p, A_COMMA) || actual(p, A_RPAREN) || at_end(p) {
                if out != ast.NOTHING {
                    complain(p)
                }
                out = reg
            } else {
                vec_push[u32](&oregs, reg)
                vec_push[u32](&oargs, inner_expr(p))
            }
        } else {
            vec_push[u32](&clobs, reg)
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RPAREN)
    var oi: usize = 0
    while oi < vec_len[u32](&oargs) {
        vec_push[u32](&args, vec_at[u32](&oargs, oi))
        oi = oi + 1
    }
    vec_free[u32](&oargs)
    let blk: u32 = ast.asm_add(par_tree(p), template, out, &regs, &oregs, &clobs)
    vec_free[u32](&regs)
    vec_free[u32](&oregs)
    vec_free[u32](&clobs)
    rt.buf_clear(&(*p).scratch)
    var pw: [u8; 4] = "asm$"
    rt.buf_push_bytes(&(*p).scratch, (&pw[0]) as u64, 4)
    rt.buf_push_dec_u64(&(*p).scratch, blk as u64)
    let name: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
    let off: u32 = list_store(p, &args)
    let len: u32 = vec_len[u32](&args) as u32
    vec_free[u32](&args)
    return ast.expr_new(par_tree(p), ast.E_CALL, name, off, len, 0)
}

// ROUND 70 (parser.rs::compound_op) -- which arithmetic operator does this
// compound assignment carry? NONE for every other token.
//
// The numbers are the ones of `E_BIN` (add sub mul div rem and or xor shl
// shr = 0..9). The table is the whole definition: `x op= e` is exactly
// `x = x op e`.
fn compound_op(k: u32) -> u32 {
    if k == A_PLUSEQ { return 0 }
    if k == A_MINUSEQ { return 1 }
    if k == A_STAREQ { return 2 }
    if k == A_SLASHEQ { return 3 }
    if k == A_PERCENTEQ { return 4 }
    if k == A_AMPEQ { return 5 }
    if k == A_PIPEEQ { return 6 }
    if k == A_CARETEQ { return 7 }
    if k == A_SHLEQ { return 8 }
    if k == A_SHREQ { return 9 }
    return NONE
}

// ------------------------------------------------------------- HOOK env
//
// ROUND FIRN-ENV -- build time environment variables, the twin of
// `compiler/src/env.rs` and `compiler/src/parser.rs::env_call`. The
// reasoning stands there in full; what stands here is the same rule, in
// the same order:
//
//   1. the name has to be a text literal, shaped `A-Z 0-9 _`, at most
//      ENV_MAX_NAME octets long, and its prefix has to be permitted
//      (`FIRN_` always, plus whatever `--env-allow=` added);
//   2. is it set, the value is checked (at most ENV_MAX_VALUE octets, no
//      control characters, valid UTF-8) and becomes the literal;
//   3. is it not set, the second argument -- itself a text literal -- does.
//
// A name that is NOT permitted is an error whether the variable is set or
// not. An error that depended on the environment would be a second way for
// two builds to differ without anybody noticing.

const ENV_MAX_NAME: usize = 64
const ENV_MAX_VALUE: usize = 4096

// Do these two octet sequences agree?
fn same_bytes(a: u64, b: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if rt.ld8(a, i) != rt.ld8(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 0 = no intrinsic, 1 = `__env_or`, 2 = `__env_has`.
fn env_kind(p: *mut Parser, nr: u32) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let q: u64 = intern.intern_ptr(it, nr)
    let n: usize = intern.intern_length(it, nr)
    var w1: [u8; 8] = "__env_or"
    var w2: [u8; 9] = "__env_has"
    if n == 8 {
        if same_bytes(q, (&w1[0]) as u64, 8) {
            return 1
        }
    }
    if n == 9 {
        if same_bytes(q, (&w2[0]) as u64, 9) {
            return 2
        }
    }
    return 0
}

// The octets of a text literal into `out`. `false` for everything else --
// `u"..."` (WTF-16) included: a build time constant is octets.
fn env_lit_octets(p: *mut Parser, e: u32, out: *mut rt.Buf) -> bool {
    let b: *mut ast.Tree = par_tree(p)
    if ast.e_kind(b, e) != ast.E_TEXT {
        return false
    }
    if ast.e_b(b, e) != 0 {
        return false
    }
    let lit: u32 = ast.e_a(b, e)
    if ast.e_kind(b, lit) != ast.E_ALIT {
        return false
    }
    let off: u32 = ast.e_b(b, lit)
    let cnt: u32 = ast.e_c(b, lit)
    rt.buf_clear(out)
    var i: u32 = 0
    while i < cnt {
        let el: u32 = ast.child_at(b, off + i)
        if ast.e_kind(b, el) != ast.E_INT {
            return false
        }
        let v: u64 = ast.e_number(b, el)
        if v > 255 {
            return false
        }
        rt.buf_push(out, v as u8)
        i = i + 1
    }
    return true
}

// The array literal of exactly these octets, and the text literal around
// it -- node for node what `text_literal` builds out of a written `"..."`.
fn env_text_node(p: *mut Parser, q: u64, n: usize) -> u32 {
    var tmp: Vec[u32] = vec_new[u32]()
    var i: usize = 0
    while i < n {
        vec_push[u32](&tmp, ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0,
                rt.ld8(q, i) as u64))
        i = i + 1
    }
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    let alit: u32 = ast.expr_new(par_tree(p), ast.E_ALIT, 0, off, n as u32, 0)
    return ast.expr_new(par_tree(p), ast.E_TEXT, alit, 0, 0, 0)
}

// Is this octet permitted in the name of an environment variable?
fn env_name_octet(c: u8, first: bool) -> bool {
    if c >= 65 as u8 && c <= 90 as u8 {
        return true
    }
    if c == 95 as u8 {
        return true
    }
    if !first && c >= 48 as u8 && c <= 57 as u8 {
        return true
    }
    return false
}

// Does the name start with a permitted prefix? `FIRN_` always; everything
// else has to stand in the comma separated list of `--env-allow=`.
fn env_prefix_ok(p: *mut Parser, q: u64, n: usize) -> bool {
    var d: [u8; 5] = "FIRN_"
    if n >= 5 {
        if same_bytes(q, (&d[0]) as u64, 5) {
            return true
        }
    }
    let ap: u64 = (*p).eallow_p
    let an: usize = (*p).eallow_n
    var i: usize = 0
    while i < an {
        var j: usize = i
        while j < an {
            if rt.ld8(ap, j) == 44 as u8 {
                break
            }
            j = j + 1
        }
        let plen: usize = j - i
        if plen > 0 && plen <= n {
            if same_bytes(q, ap + i as u64, plen) {
                return true
            }
        }
        i = j + 1
    }
    return false
}

// Name check -- SHAPE and prefix. Independent of the environment.
fn env_name_ok(p: *mut Parser, q: u64, n: usize) -> bool {
    if n == 0 || n > ENV_MAX_NAME {
        return false
    }
    var i: usize = 0
    while i < n {
        if !env_name_octet(rt.ld8(q, i), i == 0) {
            return false
        }
        i = i + 1
    }
    return env_prefix_ok(p, q, n)
}

// Valid UTF-8? Overlong forms, surrogates and code points above U+10FFFF
// are refused -- the same rule `std::str::from_utf8` follows in `firnc0`.
fn env_utf8_ok(q: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let c0: u32 = rt.ld8(q, i) as u32
        if c0 < 128 {
            i = i + 1
        } else {
            var w: usize = 0
            var cp: u32 = 0
            if c0 >= 194 && c0 <= 223 {
                w = 2
                cp = c0 - 192
            } else if c0 >= 224 && c0 <= 239 {
                w = 3
                cp = c0 - 224
            } else if c0 >= 240 && c0 <= 244 {
                w = 4
                cp = c0 - 240
            } else {
                return false
            }
            if i + w > n {
                return false
            }
            var j: usize = 1
            while j < w {
                let cb: u32 = rt.ld8(q, i + j) as u32
                if cb < 128 || cb > 191 {
                    return false
                }
                cp = (cp * 64) + (cb - 128)
                j = j + 1
            }
            if w == 3 && cp < 2048 {
                return false
            }
            if w == 4 && cp < 65536 {
                return false
            }
            if cp > 1114111 {
                return false
            }
            if cp >= 55296 && cp <= 57343 {
                return false
            }
            i = i + w
        }
    }
    return true
}

// Value check -- length, control characters, UTF-8.
fn env_value_ok(q: u64, n: usize) -> bool {
    if n > ENV_MAX_VALUE {
        return false
    }
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(q, i)
        if c < 32 as u8 || c == 127 as u8 {
            return false
        }
        i = i + 1
    }
    return env_utf8_ok(q, n)
}

// Look the variable up in the start block. `envp` follows `argv`:
//     [argc][argv0]..[argvN][0][envp0]..[0][auxv..]
// `true` = set; the value lands in `out`.
fn env_find(p: *mut Parser, q: u64, n: usize, out: *mut rt.Buf) -> bool {
    let start: u64 = (*p).estart
    if start == 0 {
        return false
    }
    var i: usize = 1 + rt.arg_count(start) + 1
    while true {
        let e: u64 = rt.ld64(start, i)
        if e == 0 {
            break
        }
        var j: usize = 0
        var equal: bool = true
        while j < n {
            if rt.ld8(e, j) != rt.ld8(q, j) {
                equal = false
                break
            }
            j = j + 1
        }
        if equal && rt.ld8(e, n) == 61 as u8 {
            let v: u64 = e + n as u64 + 1
            rt.buf_clear(out)
            rt.buf_push_bytes(out, v, rt.c_length(v))
            return true
        }
        i = i + 1
    }
    return false
}

// One line of the manifest of `--env-log`, character for character the one
// `env.rs::manifest` prints.
fn env_note(p: *mut Parser, nq: u64, nn: usize, vq: u64, vn: usize, from_env: bool) {
    if (*p).enotes == 0 {
        return
    }
    let nb: *mut rt.Buf = (*p).enotes as *mut rt.Buf
    var head: [u8; 5] = "env: "
    rt.buf_push_bytes(nb, (&head[0]) as u64, 5)
    rt.buf_push_bytes(nb, nq, nn)
    var mid: [u8; 4] = " = \""
    rt.buf_push_bytes(nb, (&mid[0]) as u64, 4)
    rt.buf_push_bytes(nb, vq, vn)
    var tail1: [u8; 16] = "\" (environment)\n"
    var tail2: [u8; 12] = "\" (default)\n"
    if from_env {
        rt.buf_push_bytes(nb, (&tail1[0]) as u64, 16)
    } else {
        rt.buf_push_bytes(nb, (&tail2[0]) as u64, 12)
    }
}

// The `__env_has` line: `?` instead of `=`, so that a `false` cannot be
// read as a value.
fn env_note_has(p: *mut Parser, nq: u64, nn: usize, set: bool) {
    if (*p).enotes == 0 {
        return
    }
    let nb: *mut rt.Buf = (*p).enotes as *mut rt.Buf
    var head: [u8; 5] = "env: "
    rt.buf_push_bytes(nb, (&head[0]) as u64, 5)
    rt.buf_push_bytes(nb, nq, nn)
    var t: [u8; 8] = " ? true\n"
    var f: [u8; 9] = " ? false\n"
    if set {
        rt.buf_push_bytes(nb, (&t[0]) as u64, 8)
    } else {
        rt.buf_push_bytes(nb, (&f[0]) as u64, 9)
    }
}

// The fold itself. `kind` is 1 for `__env_or` and 2 for `__env_has`; `off`
// and `len` describe the argument list already parsed.
fn env_call(p: *mut Parser, kind: u32, off: u32, len: u32) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    var want: u32 = 1
    if kind == 1 {
        want = 2
    }
    if len != want {
        complain(p)
        return ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
    }
    var nm: rt.Buf = rt.buf_new()
    defer rt.buf_free(&nm)
    if !env_lit_octets(p, ast.child_at(b, off), &nm) {
        complain(p)
        return ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
    }
    let nq: u64 = rt.buf_ptr(&nm)
    let nn: usize = rt.buf_len(&nm)
    if !env_name_ok(p, nq, nn) {
        complain(p)
        return ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
    }
    var val: rt.Buf = rt.buf_new()
    defer rt.buf_free(&val)
    let set: bool = env_find(p, nq, nn, &val)
    if set {
        if !env_value_ok(rt.buf_ptr(&val), rt.buf_len(&val)) {
            complain(p)
            return ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
        }
    }
    if kind == 2 {
        env_note_has(p, nq, nn, set)
        var w: u32 = 0
        if set {
            w = 1
        }
        return ast.expr_new(b, ast.E_BOOL, w, 0, 0, 0)
    }
    if !set {
        if !env_lit_octets(p, ast.child_at(b, off + 1), &val) {
            complain(p)
            return ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
        }
    }
    env_note(p, nq, nn, rt.buf_ptr(&val), rt.buf_len(&val), set)
    return env_text_node(p, rt.buf_ptr(&val), rt.buf_len(&val))
}

fn text_literal(p: *mut Parser) -> u32 {
    let k: usize = tok_nr(p, 0) as usize
    let wide: u32 = lexer.lex_lit_kind(lx(p), k)
    next_bump(p)
    // ROUND 70 (strtype.rs): the empty literal is no longer an error HERE --
    // `""` is a valid, empty `str`. Where an array is wanted the same
    // message comes from the type check, which is the only place that knows
    // the context.
    let alit: u32 = alit_out_lit(p, lx(p), k)
    var w: u32 = 0
    if wide == 2 {
        w = 1
    }
    return ast.expr_new(par_tree(p), ast.E_TEXT, alit, w, 0, 0)
}

// ------------------------------------------------------------ interpolation
//
// `f"..."` (round 39): AT COMPILE TIME the parser splits the body into a
// chain of calls on the Fmt builder from `std.io` -- no varargs and no
// parsing at run time. The same translation as in firnc0
// (`parser.rs::interpolation`): `f"x = {x}!"` turns into
// `io.fmt_text(io.fmt_number(io.fmt_text(io.fmt_new(), &_fseg0_0[0], 6),
//                       (x) as i64), &_fseg0_1[0], 1)`.
// The text segments are hoisted in front of the enclosing statement as hidden
// `let _fsegK_N: [u8; N]` (`block` drains `hoist`). Anyone writing `f"..."`
// needs `import std.io`.

// Name of a hidden text segment: `_fseg<node count>`. `firnc0` numbers them
// by its `ExprId` (`_fseg{next_id}`); here the node count of the shared
// tree is the same number -- and that keeps the canonical trees of both
// compilers character identical (tools/parser_compare.sh).
fn interp_seg_name(p: *mut Parser, state: usize) -> u32 {
    var b: rt.Buf = rt.buf_new()
    defer rt.buf_free(&b)
    var t: [u8; 5] = "_fseg"
    rt.buf_push_bytes(&b, (&t[0]) as u64, 5)
    rt.buf_push_dec_u64(&b, state as u64)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    return intern.intern_number(it, rt.buf_ptr(&b), rt.buf_len(&b)) as u32
}

// A text segment: lex `"` + body + `"` again (by construction the decoding
// is the same as for a handwritten literal), register it as a hidden
// `let _fsegK_N: [u8; N]` and append
// `io.fmt_text(chain, &_fsegK_N[0] as u64, N)` to the chain.
fn interp_text(p: *mut Parser, chain: u32, io_nr: u32, k: usize, of: usize, to: usize) -> u32 {
    var source: rt.Buf = rt.buf_new()
    defer rt.buf_free(&source)
    rt.buf_push(&source, 34 as u8)
    var i: usize = of
    while i < to {
        rt.buf_push(&source, lexer.lex_lit_byte(lx(p), k, i))
        i = i + 1
    }
    rt.buf_push(&source, 34 as u8)
    var dname: [u8; 9] = "<segment>"
    var l2: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&source), rt.buf_len(&source),
        lexer.lex_kw_ptr(lx(p)), lexer.lex_kw_len(lx(p)), (&dname[0]) as u64, 9)
    lexer.lex_names_set(&l2, lexer.lex_names(lx(p)) as u64)
    lexer.lex_run(&l2)
    if lexer.lex_error(&l2) > 0 {
        complain(p)
        lexer.lex_free(&l2)
        return chain
    }
    let state: usize = vec_len[u32](&(*par_tree(p)).e_kind)
    let alit: u32 = alit_out_lit(p, (&l2) as *mut lexer.Lexer, 0)
    lexer.lex_free(&l2)
    let elen: u32 = ast.e_c(par_tree(p), alit)
    if elen == 0 {
        return chain
    }
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let seg_name: u32 = interp_seg_name(p, state)
    var u8t: [u8; 2] = "u8"
    let u8nr: u32 = intern.intern_number(it, (&u8t[0]) as u64, 2) as u32
    let u8typ: u32 = ast.ty_new(par_tree(p), ast.T_NAME, u8nr, 0)
    let arrtyp: u32 = ast.ty_new(par_tree(p), ast.T_ARR, u8typ, elen as u64)
    let var_s: u32 = ast.stmt_new(par_tree(p), ast.S_LET, seg_name, arrtyp, alit, 0)
    vec_push[u32](&(*p).hoist, var_s)
    let id: u32 = ast.expr_new(par_tree(p), ast.E_ID, seg_name, 0, 0, 0)
    let null: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    let idx: u32 = ast.expr_new(par_tree(p), ast.E_IDX, id, null, 0, 0)
    let addr: u32 = ast.expr_new(par_tree(p), ast.E_UN, U_ADDR, idx, 0, 0)
    var u64t: [u8; 3] = "u64"
    let u64nr: u32 = intern.intern_number(it, (&u64t[0]) as u64, 3) as u32
    let u64typ: u32 = ast.ty_new(par_tree(p), ast.T_NAME, u64nr, 0)
    let ptr: u32 = ast.expr_new(par_tree(p), ast.E_AS, addr, u64typ, 0, 0)
    let len: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, elen as u64)
    var ft: [u8; 8] = "fmt_text"
    let text_nr: u32 = qualify(p, io_nr, intern.intern_number(it, (&ft[0]) as u64, 8) as u32)
    let aoff: u32 = ast.child_start(par_tree(p))
    ast.child_add(par_tree(p), chain)
    ast.child_add(par_tree(p), ptr)
    ast.child_add(par_tree(p), len)
    return ast.expr_new(par_tree(p), ast.E_CALL, text_nr, aoff, 3, 0)
}

// r665 -- index of the spec colon in lit bytes [from, to): the first `:`
// outside brackets, quotes and `::`; `to` when there is none.
fn fspec_split(p: *mut Parser, k: usize, from: usize, to: usize) -> usize {
    var depth: i32 = 0
    var i: usize = from
    while i < to {
        let c: u32 = lexer.lex_lit_byte(lx(p), k, i) as u32
        if c == 34 {
            i = i + 1
            while i < to && (lexer.lex_lit_byte(lx(p), k, i) as u32) != 34 {
                if (lexer.lex_lit_byte(lx(p), k, i) as u32) == 92 {
                    i = i + 1
                }
                i = i + 1
            }
            i = i + 1
            continue
        }
        if c == 40 || c == 91 {
            depth = depth + 1
        } else if c == 41 || c == 93 {
            depth = depth - 1
        } else if c == 58 && depth == 0 {
            if i + 1 < to && (lexer.lex_lit_byte(lx(p), k, i + 1) as u32) == 58 {
                i = i + 2
                continue
            }
            return i
        }
        i = i + 1
    }
    return to
}

fn fspec_is_align(c: u32) -> bool {
    return c == 60 || c == 62 || c == 94 || c == 61
}

fn fspec_align_code(c: u32) -> u64 {
    if c == 60 {
        return 1
    }
    if c == 62 {
        return 2
    }
    if c == 94 {
        return 3
    }
    return 4
}

// One code point at byte `i` (UTF-8); `*len` gets its byte length (0 = invalid).
fn fspec_cp(p: *mut Parser, k: usize, i: usize, to: usize, len: *mut usize) -> u32 {
    let b0: u32 = lexer.lex_lit_byte(lx(p), k, i) as u32
    *len = 0
    if b0 < 128 {
        *len = 1
        return b0
    }
    var n: usize = 0
    var cp: u32 = 0
    if b0 >= 192 && b0 < 224 {
        n = 2
        cp = b0 & 31
    } else if b0 >= 224 && b0 < 240 {
        n = 3
        cp = b0 & 15
    } else if b0 >= 240 && b0 < 248 {
        n = 4
        cp = b0 & 7
    } else {
        return 0
    }
    if i + n > to {
        return 0
    }
    var q: usize = 1
    while q < n {
        let c: u32 = lexer.lex_lit_byte(lx(p), k, i + q) as u32
        if (c & 192) != 128 {
            return 0
        }
        cp = (cp << 6) | (c & 63)
        q = q + 1
    }
    *len = n
    return cp
}

// Range of a nested `{...}` field starting at `i` (the `{`): inner start / end.
fn fspec_field(p: *mut Parser, k: usize, i: usize, to: usize, a: *mut usize, b: *mut usize) -> bool {
    var j: usize = i + 1
    while j < to && (lexer.lex_lit_byte(lx(p), k, j) as u32) != 125 {
        if (lexer.lex_lit_byte(lx(p), k, j) as u32) == 123 {
            return false
        }
        j = j + 1
    }
    if j >= to || j == i + 1 {
        return false
    }
    *a = i + 1
    *b = j
    return true
}

// Source ranges of the nested width / precision fields (from == to: none).
struct FSpecF {
    wa: usize,
    wb: usize,
    pa: usize,
    pb: usize,
}

// The same grammar and packing as compiler/src/fmtspec.rs::parse_spec.
fn fspec_parse(p: *mut Parser, k: usize, from: usize, to: usize, out: *mut u64, fr: *mut FSpecF) -> bool {
    var i: usize = from
    var fill: u64 = 32
    var fill_set: bool = false
    var align: u64 = 0
    (*fr).wa = 0
    (*fr).wb = 0
    (*fr).pa = 0
    (*fr).pb = 0
    var c0len: usize = 0
    var cp0: u32 = 0
    if to > from {
        cp0 = fspec_cp(p, k, from, to, &c0len)
    }
    if to > from && c0len == 0 {
        return false
    }
    if to > from && from + c0len < to && fspec_is_align(lexer.lex_lit_byte(lx(p), k, from + c0len) as u32) {
        if cp0 > 65535 {
            return false
        }
        fill = cp0 as u64
        fill_set = true
        align = fspec_align_code(lexer.lex_lit_byte(lx(p), k, from + c0len) as u32)
        i = from + c0len + 1
    } else if to > from && fspec_is_align(lexer.lex_lit_byte(lx(p), k, from) as u32) {
        align = fspec_align_code(lexer.lex_lit_byte(lx(p), k, from) as u32)
        i = from + 1
    }
    var flags: u64 = 0
    if i < to {
        let c: u32 = lexer.lex_lit_byte(lx(p), k, i) as u32
        if c == 43 {
            flags = flags | 2048
            i = i + 1
        } else if c == 32 {
            flags = flags | 4096
            i = i + 1
        } else if c == 45 {
            i = i + 1
        }
    }
    if i < to && (lexer.lex_lit_byte(lx(p), k, i) as u32) == 35 {
        flags = flags | 8192
        i = i + 1
    }
    if i < to && (lexer.lex_lit_byte(lx(p), k, i) as u32) == 48 {
        if !fill_set {
            fill = 48
        }
        if align == 0 {
            align = 4
        }
        i = i + 1
    }
    var width: u64 = 0
    if i < to && (lexer.lex_lit_byte(lx(p), k, i) as u32) == 123 {
        var wa: usize = 0
        var wb: usize = 0
        if !fspec_field(p, k, i, to, &wa, &wb) {
            return false
        }
        (*fr).wa = wa
        (*fr).wb = wb
        i = wb + 1
    } else {
        while i < to {
            let d: u32 = lexer.lex_lit_byte(lx(p), k, i) as u32
            if d < 48 || d > 57 {
                break
            }
            width = width * 10 + (d - 48) as u64
            if width > 65535 {
                return false
            }
            i = i + 1
        }
    }
    if i < to && (lexer.lex_lit_byte(lx(p), k, i) as u32) == 44 {
        flags = flags | 16384
        i = i + 1
    } else if i < to && (lexer.lex_lit_byte(lx(p), k, i) as u32) == 95 {
        flags = flags | 32768
        i = i + 1
    }
    var prec1: u64 = 0
    if i < to && (lexer.lex_lit_byte(lx(p), k, i) as u32) == 46 {
        i = i + 1
        if i < to && (lexer.lex_lit_byte(lx(p), k, i) as u32) == 123 {
            var pa: usize = 0
            var pb: usize = 0
            if !fspec_field(p, k, i, to, &pa, &pb) {
                return false
            }
            (*fr).pa = pa
            (*fr).pb = pb
            prec1 = 1
            i = pb + 1
        } else {
            let start: usize = i
            var pr: u64 = 0
            while i < to {
                let d: u32 = lexer.lex_lit_byte(lx(p), k, i) as u32
                if d < 48 || d > 57 {
                    break
                }
                pr = pr * 10 + (d - 48) as u64
                if pr > 65534 {
                    return false
                }
                i = i + 1
            }
            if i == start {
                return false
            }
            prec1 = pr + 1
        }
    }
    var ty: u64 = 0
    if i < to {
        let c: u32 = lexer.lex_lit_byte(lx(p), k, i) as u32
        // d x X o b f F e E g G c n s %
        if c != 100 && c != 120 && c != 88 && c != 111 && c != 98 && c != 102 && c != 70 && c != 115 && c != 37
        && c != 101 && c != 69 && c != 103 && c != 71 && c != 99 && c != 110 {
            return false
        }
        ty = c as u64
        i = i + 1
    }
    if i < to {
        return false
    }
    *out = (fill & 255) | (align << 8) | flags | (width << 16) | (prec1 << 32) | (ty << 48) | ((fill >> 8) << 56)
    return true
}

// Lex + parse ONE expression out of the literal bytes [of, to); NOTHING on error.
fn interp_sub(p: *mut Parser, k: usize, of: usize, to: usize) -> u32 {
    var source: rt.Buf = rt.buf_new()
    defer rt.buf_free(&source)
    // r774 (parser.rs::interp_sub): the fragment stands at its REAL place -- pad lines and
    // columns beforehand (a literal is one line), so every node reports the source position.
    let ftok: usize = (*p).pos
    let fline: u32 = lexer.lex_line(lx(p), ftok)
    let fcol: u32 = lexer.lex_col(lx(p), ftok)
    var pl: u32 = 1
    while pl < fline {
        rt.buf_push(&source, 10 as u8)
        pl = pl + 1
    }
    var pc: usize = 0
    while pc < (fcol as usize) + 1 + of {
        rt.buf_push(&source, 32 as u8)
        pc = pc + 1
    }
    var i: usize = of
    while i < to {
        rt.buf_push(&source, lexer.lex_lit_byte(lx(p), k, i))
        i = i + 1
    }
    var dname: [u8; 12] = "<expression>"
    var l2: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&source), rt.buf_len(&source),
        lexer.lex_kw_ptr(lx(p)), lexer.lex_kw_len(lx(p)), (&dname[0]) as u64, 12)
    lexer.lex_names_set(&l2, lexer.lex_names(lx(p)) as u64)
    lexer.lex_run(&l2)
    if lexer.lex_error(&l2) > 0 {
        complain(p)
        lexer.lex_free(&l2)
        return ast.NOTHING
    }
    // The copy shares everything that expressions need (tree, registries,
    // modules, local names); `interp = 1` blocks nesting.
    // The tree is shared THROUGH `foreign`: in root mode (foreign == 0, the
    // dump tools) `par_tree` would otherwise point at the COPY's own tree --
    // the expression nodes would sit in a stack frame and be dead after the
    // return (segfault in astdump on `f"{x}"`).
    var sub: Parser = (*p)
    sub.foreign = par_tree(p) as u64
    sub.lx = (&l2) as u64
    sub.pos = 0
    sub.n = lexer.lex_count(&l2)
    sub.parens = 0
    sub.no_slit = 0
    sub.interp = 1
    let e: u32 = inner_expr(&sub)
    (*p).err = sub.err
    if sub.not_core {
        (*p).not_core = true
    }
    let whole: bool = actual(&sub, A_EOF)
    lexer.lex_free(&l2)
    if !whole {
        complain(p)
        return ast.NOTHING
    }
    return e
}

// An expression segment: lex the fragment again, parse ONE expression from
// it with a copy of the parser (same tree, same registries, same intern
// table, same local names) and append it to the chain as
// `io.fmt_number(chain, (expr) as i64)`.
fn interp_expr(p: *mut Parser, chain: u32, io_nr: u32, k: usize, of: usize, to_all: usize) -> u32 {
    // r665: `{expr:spec}` -- split at the first `:` outside brackets, quotes and `::`
    var to: usize = to_all
    var has_spec: bool = false
    var spec: u64 = 0
    var fr: FSpecF = FSpecF { wa: 0, wb: 0, pa: 0, pb: 0 }
    let colon: usize = fspec_split(p, k, of, to_all)
    if colon < to_all {
        to = colon
        has_spec = true
        if !fspec_parse(p, k, colon + 1, to_all, &spec, &fr) {
            complain(p)
            return chain
        }
    }
    let e: u32 = interp_sub(p, k, of, to)
    if e == ast.NOTHING {
        return chain
    }
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    // ROUND 70 -- NO `as i64` any more. Which builder step is right depends
    // on the TYPE of the expression, and only the type check knows that.
    // `io.fmt_value` is the placeholder that the type check and the lowering
    // both resolve, out of the same material (sema::fmt_target).
    if has_spec {
        var sz: [u8; 8] = "fmt_spec"
        let spec_nr: u32 = qualify(p, io_nr, intern.intern_number(it, (&sz[0]) as u64, 8) as u32)
        var slit: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, spec)
        if fr.wb > fr.wa || fr.pb > fr.pa {
            // r699: nested fields -> io.spec_dyn(spec, (w) as i64, (p) as i64)
            var wexpr: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
            var pexpr: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 99999)
            var i64s: [u8; 3] = "i64"
            let i64_nr: u32 = intern.intern_number(it, (&i64s[0]) as u64, 3) as u32
            if fr.wb > fr.wa {
                let we: u32 = interp_sub(p, k, fr.wa, fr.wb)
                if we == ast.NOTHING {
                    return chain
                }
                let wt: u32 = ast.ty_new(par_tree(p), ast.T_NAME, i64_nr, 0)
                wexpr = ast.expr_new(par_tree(p), ast.E_AS, we, wt, 0, 0)
            }
            if fr.pb > fr.pa {
                let pe: u32 = interp_sub(p, k, fr.pa, fr.pb)
                if pe == ast.NOTHING {
                    return chain
                }
                let pt: u32 = ast.ty_new(par_tree(p), ast.T_NAME, i64_nr, 0)
                pexpr = ast.expr_new(par_tree(p), ast.E_AS, pe, pt, 0, 0)
            }
            var dz: [u8; 8] = "spec_dyn"
            let dyn_nr: u32 = qualify(p, io_nr, intern.intern_number(it, (&dz[0]) as u64, 8) as u32)
            let doff: u32 = ast.child_start(par_tree(p))
            ast.child_add(par_tree(p), slit)
            ast.child_add(par_tree(p), wexpr)
            ast.child_add(par_tree(p), pexpr)
            slit = ast.expr_new(par_tree(p), ast.E_CALL, dyn_nr, doff, 3, 0)
        }
        let soff: u32 = ast.child_start(par_tree(p))
        ast.child_add(par_tree(p), chain)
        ast.child_add(par_tree(p), e)
        ast.child_add(par_tree(p), slit)
        return ast.expr_new(par_tree(p), ast.E_CALL, spec_nr, soff, 3, 0)
    }
    var fz: [u8; 9] = "fmt_value"
    let number_nr: u32 = qualify(p, io_nr, intern.intern_number(it, (&fz[0]) as u64, 9) as u32)
    let aoff: u32 = ast.child_start(par_tree(p))
    ast.child_add(par_tree(p), chain)
    ast.child_add(par_tree(p), e)
    return ast.expr_new(par_tree(p), ast.E_CALL, number_nr, aoff, 2, 0)
}

// r774: firnc0 gives EVERY node it builds for an f-string (the `io.fmt_*` chain, the segment
// index/address/cast, the hoisted segment lets) the span of the f-string token, so a panic
// text points at the f-string. The nodes below are created without a position; give all that
// are still unplaced the position of the token (nodes parsed from `{..}` already have theirs).
fn interpolation(p: *mut Parser) -> u32 {
    let at: u64 = pos_now(p)
    let b: *mut ast.Tree = par_tree(p)
    let e0: usize = ast.expr_count(b)
    let s0: usize = vec_len[u32](&(*b).s_kind)
    let r: u32 = interpolation_core(p)
    var i: usize = e0
    while i < ast.expr_count(b) {
        if ast.pos_line(ast.expr_pos(b, i as u32)) == 0 {
            ast.expr_pos_set(b, i as u32, at)
        }
        i = i + 1
    }
    var j: usize = s0
    while j < vec_len[u32](&(*b).s_kind) {
        if ast.pos_line(ast.stmt_pos(b, j as u32)) == 0 {
            ast.stmt_pos_set(b, j as u32, at)
        }
        j = j + 1
    }
    return r
}

fn interpolation_core(p: *mut Parser) -> u32 {
    let k: usize = tok_nr(p, 0) as usize
    let n: usize = lexer.lex_lit_len(lx(p), k)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if (*p).interp > 0 {
        // An f"..." inside the expression of an f"..." -- not yet (round 39).
        complain(p)
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    var io_t: [u8; 2] = "io"
    let io_nr: u32 = intern.intern_number(it, (&io_t[0]) as u64, 2) as u32
    if !is_module(p, io_nr) {
        // Without `import std.io` the building blocks do not exist -- the same
        // situation as a handwritten `io.` without the import.
        complain(p)
    }
    var fn_t: [u8; 7] = "fmt_new"
    let new_nr: u32 = qualify(p, io_nr, intern.intern_number(it, (&fn_t[0]) as u64, 7) as u32)
    var chain: u32 = ast.expr_new(par_tree(p), ast.E_CALL, new_nr, ast.child_start(par_tree(p)), 0, 0)
    var i: usize = 0
    var text_of: usize = 0
    while i < n {
        let b: u32 = lexer.lex_lit_byte(lx(p), k, i) as u32
        if (b == 123 || b == 125) && i + 1 < n && (lexer.lex_lit_byte(lx(p), k, i + 1) as u32) == b {
            // r664: `{{` / `}}` are literal braces: close the text segment right
            // after the FIRST brace and skip the second.
            chain = interp_text(p, chain, io_nr, k, text_of, i + 1)
            i = i + 2
            text_of = i
            continue
        }
        if b == 125 {
            // '}' without '{'
            complain(p)
            break
        }
        if b == 92 {
            // escaping belongs to the text segment
            i = i + 2
            continue
        }
        if b != 123 {
            i = i + 1
            continue
        }
        if i > text_of {
            chain = interp_text(p, chain, io_nr, k, text_of, i)
        }
        var j: usize = i + 1
        var closed: bool = false
        var depth: i32 = 0
        var in_spec: bool = false
        var nest: bool = false
        while j < n {
            let b2: u32 = lexer.lex_lit_byte(lx(p), k, j) as u32
            if b2 == 34 {
                // r664: a nested text literal is skipped as a whole (it may hold braces)
                j = j + 1
                while j < n && (lexer.lex_lit_byte(lx(p), k, j) as u32) != 34 {
                    if (lexer.lex_lit_byte(lx(p), k, j) as u32) == 92 {
                        j = j + 1
                    }
                    j = j + 1
                }
                j = j + 1
                continue
            }
            if !in_spec {
                if b2 == 40 || b2 == 91 {
                    depth = depth + 1
                } else if b2 == 41 || b2 == 93 {
                    depth = depth - 1
                } else if b2 == 58 && depth == 0 {
                    if j + 1 < n && (lexer.lex_lit_byte(lx(p), k, j + 1) as u32) == 58 {
                        j = j + 2
                        continue
                    }
                    in_spec = true
                }
            }
            if b2 == 123 {
                // r699: one level of nested `{w}` / `{p}` fields in the spec only
                if in_spec && !nest {
                    nest = true
                    j = j + 1
                    continue
                }
                complain(p)
                break
            }
            if b2 == 125 {
                if nest {
                    nest = false
                    j = j + 1
                    continue
                }
                closed = true
                break
            }
            j = j + 1
        }
        if !closed {
            complain(p)
            break
        }
        chain = interp_expr(p, chain, io_nr, k, i + 1, j)
        i = j + 1
        text_of = i
    }
    if text_of < n {
        chain = interp_text(p, chain, io_nr, k, text_of, n)
    }
    next_bump(p)
    return chain
}

// `size_of[TypeName]()`, `has_gc[TypeName]()`, `gc_track[TypeName](p, n)`,
// `gc_untrack[TypeName](p)` -- the intrinsic name has been read, the `[` is next.
// `kind`: 0 = size_of, 1 = has_gc, 2 = gc_track, 3 = gc_untrack.
//
// DELIBERATELY ONLY A TYPE NAME, not a full type expression, as in `sizeof.rs`.
fn size_of_expr(p: *mut Parser, kind: u32) -> u32 {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    // HOOK alias: `size_of[Idx]()` with `type Idx = u32` is `size_of[u32]()`
    let tn: u32 = alias_plain_name(p, tok_nr(p, 0))
    next_bump(p)
    if !expect(p, A_RBRACKET) {
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    if !expect(p, A_LPAREN) {
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    let t: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tn, 0)
    let name: u32 = mono.gen_intr_name(gn(p), kind, t)
    let num: u64 = ((t as u64) + 1) | ((kind as u64) << 32)
    if kind < 2 {
        if !expect(p, A_RPAREN) {
            return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
        }
        return ast.expr_new(par_tree(p), ast.E_CALL, name, 0, 0, num)
    }
    var tmp: Vec[u32] = vec_new[u32]()
    call_args_in(p, &tmp)
    let off: u32 = list_store(p, &tmp)
    let len: u32 = vec_len[u32](&tmp) as u32
    vec_free[u32](&tmp)
    return ast.expr_new(par_tree(p), ast.E_CALL, name, off, len, num)
}

// ROUND 72: a leaf expression starts at the token it is read from. A
// parenthesised expression returns the INNER node, which already has its
// own position -- `pos_default` leaves that one alone, which is exactly
// why `(b as u64) - (a as u64)` reports the column of `b` and not of `(`.
fn basic_expr(p: *mut Parser) -> u32 {
    let start: u64 = pos_now(p)
    let e: u32 = basic_expr_at(p)
    pos_default(p, e, start)
    return e
}

fn basic_expr_at(p: *mut Parser) -> u32 {
    let a: u32 = kind(p, 0)
    // ROUND FUI-ALL (include.rs): `__include_str("file")` is the text of
    // a file next to the SOURCE file, as a `str` literal.
    if a == A_IDENT && kind(p, 1) == A_LPAREN && kind(p, 2) == A_STR
    && kind(p, 3) == A_RPAREN && is_include_str(p) {
        return include_str(p)
    }
    // HOOK ifexpr: `if c { a } else { b }` AS AN EXPRESSION. The `if`
    // STATEMENT is caught in `stmt_inner` before this and never arrives here.
    if a == A_KWIF {
        return if_expr(p)
    }
    // `try expr` -- the operand is a UNARY expression, and the call is
    // named `__try#` (errors.rs::hook_primary, TRY_NAME).
    if a == A_KWTRY && has_fe(p) {
        next_bump(p)
        let inner: u32 = un_expr(p)
        let off: u32 = ast.child_start(par_tree(p))
        ast.child_add(par_tree(p), inner)
        var tn: [u8; 6] = "__try#"
        let it: *mut intern.Interner = lexer.lex_names(lx(p))
        let name: u32 = intern.intern_number(it, (&tn[0]) as u64, 6) as u32
        return ast.expr_new(par_tree(p), ast.E_CALL, name, off, 1, 0)
    }
    if a == A_INT {
        let v: u64 = number(p)
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, v)
    }
    if a == A_FLOAT {
        let v: u64 = number(p)
        // ROUND 71: field `a` carries the binary32 pattern of the same text.
        // The canonical printing keeps showing `number` alone, so the tree
        // dump stays what it was (print.fi, ast_canon.rs).
        let single: u32 = lexer.lex_nr(lx(p), (*p).pos)
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_FLOAT, single, 0, 0, v)
    }
    if a == A_FLOATF32 {
        let v: u64 = number(p)
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_FLOAT32, 0, 0, 0, v)
    }
    if a == A_STR {
        return text_literal(p)
    }
    if a == A_FSTR {
        return interpolation(p)
    }
    if a == A_KWTRUE {
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_BOOL, 1, 0, 0, 0)
    }
    if a == A_KWFALSE {
        next_bump(p)
        return ast.expr_new(par_tree(p), ast.E_BOOL, 0, 0, 0, 0)
    }
    if a == A_LPAREN {
        next_bump(p)
        let e: u32 = inner_expr(p)
        // ROUND TUPLES -- `(a, b, ..)`: a tuple literal, read as a struct
        // literal with a name no source can write and fields `0`, `1`, ..
        // (parser.rs, ast::TUPLE_LIT).
        if actual(p, A_COMMA) {
            return tuple_literal(p, e)
        }
        var cx7: [u8; 34] = "after the parenthesized expression"
        expect_in(p, A_RPAREN, (&cx7[0]) as u64, 34)
        return e
    }
    // r751: untyped comprehension `[e for ..]` / `{k: v for ..}` / `{e for ..}`
    if (a == A_LBRACKET || a == A_LBRACE) && (*p).err == 0 {
        var ce: u32 = 0
        if coll_expr(p, &ce) {
            return ce
        }
    }
    if a == A_LBRACKET {
        next_bump(p)
        var tmp: Vec[u32] = vec_new[u32]()
        var done: bool = false
        if !actual(p, A_RBRACKET) && !at_end(p) {
            let first: u32 = inner_expr(p)
            if actual(p, A_KWFOR) {
                // wf-py: a comprehension needs a declared Vec[T] / Dict[V] type (collsugar.rs)
                complain(p)
            }
            if actual(p, A_SEMI) {
                next_bump(p)
                let count: u32 = inner_expr(p)
                var cx6: [u8; 42] = "after the length of the repetition literal"
                expect_in(p, A_RBRACKET, (&cx6[0]) as u64, 42)
                vec_free[u32](&tmp)
                return ast.expr_new(par_tree(p), ast.E_AWDH, first, count, 0, 0)
            }
            vec_push[u32](&tmp, first)
            if !eat(p, A_COMMA) {
                var cx5: [u8; 39] = "after the elements of the array literal"
                expect_in(p, A_RBRACKET, (&cx5[0]) as u64, 39)
                done = true
            }
        }
        while !done {
            if actual(p, A_RBRACKET) || at_end(p) {
                break
            }
            let before: usize = (*p).pos
            let e: u32 = inner_expr(p)
            vec_push[u32](&tmp, e)
            if !eat(p, A_COMMA) {
                break
            }
            if (*p).pos == before {
                next_bump(p)
            }
        }
        if !done {
            var cx4: [u8; 39] = "after the elements of the array literal"
            expect_in(p, A_RBRACKET, (&cx4[0]) as u64, 39)
        }
        let len: u32 = vec_len[u32](&tmp) as u32
        let off: u32 = list_store(p, &tmp)
        vec_free[u32](&tmp)
        return ast.expr_new(par_tree(p), ast.E_ALIT, 0, off, len, 0)
    }
    // ROUND 58 (fnval.rs): the closure literal. `fn(` in an expression can
    // be nothing else -- a DECLARATION always carries a name after `fn`.
    if a == A_KWFN {
        return lambda(p, false)
    }
    // r715 (lambda.rs): `|x| expr` / `|a, b| { .. }` -- a `|` at the START of
    // an operand cannot be anything else.
    if a == A_PIPE || a == A_OROR {
        return lambda_sugar(p, false)
    }
    if a == A_KWSYSCALL {
        next_bump(p)
        var cx3: [u8; 15] = "after 'syscall'"
        expect_in(p, A_LPAREN, (&cx3[0]) as u64, 15)
        let off: u32 = call_args(p)
        let len: u32 = ast.child_count(par_tree(p)) - off
        return ast.expr_new(par_tree(p), ast.E_SYSCALL, 0, off, len, 0)
    }
    if a == A_IDENT {
        // ROUND 52 (core.rs::hook_primary): `asm("...", in("dx") p, out("rax"),
        // clobber("memory"))`. ONLY if `asm` is directly followed by `(` and a
        // string literal -- otherwise `asm` stays an ordinary identifier
        // and no new keyword is introduced.
        var asmw: [u8; 3] = "asm"
        let is_asm: bool = intern.intern_equal(lexer.lex_names(lx(p)), tok_nr(p, 0), (&asmw[0]) as u64, 3)
        if is_asm && kind(p, 1) == A_LPAREN && kind(p, 2) == A_STR {
            return asm_block(p)
        }
        let nr: u32 = tok_nr(p, 0)
        next_bump(p)
        // ROUND 34 (gc.rs::hook_primary): `gc C{ ... }`, `gc_null[C]()` and
        // `weak_null[C]()`.
        if has_gc(p) {
            let it3: *mut intern.Interner = lexer.lex_names(lx(p))
            var gw2: [u8; 2] = "gc"
            if intern.intern_equal(it3, nr, (&gw2[0]) as u64, 2) {
                // ROUND 58: `gc fn(...) { ... }` -- the capturing closure.
                if actual(p, A_KWFN) {
                    return lambda(p, true)
                }
                if actual(p, A_PIPE) || actual(p, A_OROR) {
                    return lambda_sugar(p, true)
                }
                // Round GAPS (gc.rs::hook_primary): `gc module.Class { ... }`.
                if actual(p, A_IDENT) && kind(p, 1) == A_DOT && kind(p, 2) == A_IDENT
                && kind(p, 3) == A_LBRACE {
                    next_bump(p)
                    next_bump(p)
                }
                if actual(p, A_IDENT) && kind(p, 1) == A_LBRACE {
                    var cw2: [u8; 5] = "class"
                    if !intern.intern_equal(it3, tok_nr(p, 0), (&cw2[0]) as u64, 5) {
                        let kn: u32 = tok_nr(p, 0)
                        next_bump(p)
                        // "gc C" -- with a space, so it can never be an
                        // identifier from the source text.
                        var tr2: [u8; 1] = " "
                        let whole: u32 = join(p, nr, (&tr2[0]) as u64, 1, kn)
                        // no_slit does not apply here: the brace belongs to
                        // the allocation, not to the control structure.
                        let lit: u32 = struct_literal(p, whole)
                        var tmp2: Vec[u32] = vec_new[u32]()
                        vec_push[u32](&tmp2, lit)
                        let off2: u32 = list_store(p, &tmp2)
                        vec_free[u32](&tmp2)
                        return ast.expr_new(par_tree(p), ast.E_CALL, whole, off2, 1, 0)
                    }
                }
            }
            var gn1: [u8; 7] = "gc_null"
            var gn2: [u8; 9] = "weak_null"
            let is_gnull: bool = intern.intern_equal(it3, nr, (&gn1[0]) as u64, 7)
            let is_wnull: bool = intern.intern_equal(it3, nr, (&gn2[0]) as u64, 9)
            if (is_gnull || is_wnull) && actual(p, A_LBRACKET) {
                next_bump(p)
                if !actual(p, A_IDENT) {
                    complain(p)
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                var kn: u32 = tok_nr(p, 0)
                next_bump(p)
                // Round GAPS: `gc_null[module.Class]()`.
                while actual(p, A_DOT) && kind(p, 1) == A_IDENT {
                    next_bump(p)
                    kn = tok_nr(p, 0)
                    next_bump(p)
                }
                if !expect(p, A_RBRACKET) {
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                if !expect(p, A_LPAREN) {
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                if !expect(p, A_RPAREN) {
                    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                }
                if is_gnull {
                    // `0 as Gc[C]` -- the null value is the null pointer.
                    rt.buf_clear(&(*p).scratch)
                    var px3: [u8; 7] = "__gc#p:"
                    rt.buf_push_bytes(&(*p).scratch, (&px3[0]) as u64, 7)
                    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it3, kn),
                        intern.intern_length(it3, kn))
                    let tn: u32 = intern.intern_number(it3, rt.buf_ptr(&(*p).scratch),
                        rt.buf_len(&(*p).scratch)) as u32
                    let tn2: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tn, 0)
                    let null: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                    return ast.expr_new(par_tree(p), ast.E_AS, null, tn2, 0, 0)
                }
                // `GcWeak[C]{ __p: 0, __s: 0 }` -- the empty weak reference.
                rt.buf_clear(&(*p).scratch)
                var px4: [u8; 7] = "GcWeak["
                rt.buf_push_bytes(&(*p).scratch, (&px4[0]) as u64, 7)
                rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it3, kn),
                    intern.intern_length(it3, kn))
                rt.buf_push(&(*p).scratch, 93 as u8)
                let wn: u32 = intern.intern_number(it3, rt.buf_ptr(&(*p).scratch),
                    rt.buf_len(&(*p).scratch)) as u32
                var wp2: [u8; 3] = "__p"
                var ws2: [u8; 3] = "__s"
                let wp_n: u32 = intern.intern_number(it3, (&wp2[0]) as u64, 3) as u32
                let ws_n: u32 = intern.intern_number(it3, (&ws2[0]) as u64, 3) as u32
                let n1: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                let n2: u32 = ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
                var tmp3: Vec[u32] = vec_new[u32]()
                vec_push[u32](&tmp3, wp_n)
                vec_push[u32](&tmp3, n1)
                vec_push[u32](&tmp3, ws_n)
                vec_push[u32](&tmp3, n2)
                let off3: u32 = list_store(p, &tmp3)
                vec_free[u32](&tmp3)
                return ast.expr_new(par_tree(p), ast.E_SLIT, wn, off3, 2, 0)
            }
        }
        // `size_of[T]()` -- the type text goes into the CALLEE NAME
        // (`size_of$i32`, sizeof.rs) and the type node into `e_number` as
        // well; both are resolved only in the type checker, which knows the
        // struct table.
        if (*p).sonr >= 0 && nr as i64 == (*p).sonr && actual(p, A_LBRACKET) {
            return size_of_expr(p, 0)
        }
        if (*p).hgnr >= 0 && nr as i64 == (*p).hgnr && actual(p, A_LBRACKET) {
            return size_of_expr(p, 1)
        }
        if (*p).gtnr >= 0 && nr as i64 == (*p).gtnr && actual(p, A_LBRACKET) {
            return size_of_expr(p, 2)
        }
        if (*p).gunr >= 0 && nr as i64 == (*p).gunr && actual(p, A_LBRACKET) {
            return size_of_expr(p, 3)
        }
        // `Vec[i32]{ ... }` -- a literal of a generic struct.
        var gstruct: bool = false
        var gsnr: u32 = nr
        if has_gen(p) && actual(p, A_LBRACKET) {
            gstruct = mono.gen_is_struct(gn(p), nr)
        } else if has_gen(p) && is_module(p, nr) && actual(p, A_DOT) && kind(p, 1) == A_IDENT && kind(p, 2) == A_LBRACKET {
            // r707: `mod.Box[i32]{ .. }` -- the module part is dropped
            if mono.gen_is_struct(gn(p), tok_nr(p, 1)) {
                gsnr = tok_nr(p, 1)
                next_bump(p)
                next_bump(p)
                gstruct = true
            }
        }
        if gstruct {
            var targs: Vec[u32] = vec_new[u32]()
            let ok: bool = ty_args(p, &targs)
            if !ok {
                vec_free[u32](&targs)
                return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
            }
            let m: u32 = mono.gen_instance(gn(p), gsnr, &targs, false)
            vec_free[u32](&targs)
            if actual(p, A_LBRACE) && (*p).no_slit == 0 {
                return struct_literal(p, m)
            }
            complain(p)
            return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
        }
        // `Enum::Variant(..)` -- the enum constructor. Recognised by its
        // SHAPE (`IDENT :: IDENT`), not through a registry -- exactly like
        // `sema_match.rs::hook_primary`. `::` is TWO colon tokens; there is
        // no token of its own for it.
        // r744: `v[big::2]` (a step slice with a name before `::`) is no enum path: a name follows `::`
        if actual(p, A_COLON) && kind(p, 1) == A_COLON && kind(p, 2) == A_IDENT {
            if !has_mu(p) {
                (*p).not_core = true
                complain(p)
                return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
            }
            next_bump(p)
            next_bump(p)
            if !actual(p, A_IDENT) {
                complain(p)
                return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
            }
            let vn: u32 = tok_nr(p, 0)
            next_bump(p)
            // The whole `Enum::Variant` becomes ONE identifier. NO renaming:
            // enum names are visible program wide (SPEC 14.1).
            var dp: [u8; 2] = "::"
            let full: u32 = join(p, nr, (&dp[0]) as u64, 2, vn)
            var aoff: u32 = 0
            var alen: u32 = 0
            if actual(p, A_LPAREN) {
                next_bump(p)
                aoff = call_args(p)
                alen = ast.child_count(par_tree(p)) - aoff
            }
            return ast.expr_new(par_tree(p), ast.E_CALL, full, aoff, alen, 0)
        }
        // `mod.fn[T](..)` -- a qualified call of a generic template. The
        // generic names hold program wide, so the module part is dropped
        // here: the result is the bare template name, and the postfix loop
        // reads `[T](..)` exactly like an unqualified call (firnc0:
        // sema_generic.rs::hook_generic_call).
        if has_gen(p) && is_module(p, nr) && actual(p, A_DOT) && kind(p, 1) == A_IDENT && kind(p, 2) == A_LBRACKET {
            let gm: u32 = tok_nr(p, 1)
            if mono.gen_is_fn(gn(p), gm) {
                next_bump(p)
                next_bump(p)
                return ast.expr_new(par_tree(p), ast.E_ID, gm, 0, 0, 0)
            }
        }
        // If a `(` follows, this is a CALLEE NAME -- a local variable does
        // not shadow it (`Renamer::resolve`, is_value = false). The `(` has
        // to be on the SAME line (`next`), exactly as in the postfix loop:
        // `x = kind` followed by a line that starts with `(*p).f = 0` is
        // a plain value, and a parameter `kind` must still hide the
        // function `kind` there.
        let q: u32 = maybe_qualified(p, nr, !(next(p) && actual(p, A_LPAREN)))
        if actual(p, A_LBRACE) && (*p).no_slit == 0 {
            return struct_literal(p, q)
        }
        return ast.expr_new(par_tree(p), ast.E_ID, q, 0, 0, 0)
    }
    var be1: [u8; 22] = "expected an expression"
    complain_found(p, (&be1[0]) as u64, 22)
    next_bump(p)
    return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
}

// --------------------------------------------------------------- statements

// End of statement: ';', a line break or '}'.
fn end_stmt(p: *mut Parser) {
    var had: bool = false
    while actual(p, A_SEMI) {
        next_bump(p)
        had = true
    }
    if had || actual(p, A_RBRACE) || at_end(p) || line_start(p) {
        return
    }
    var es1: [u8; 50] = "expected ';' or an end of line after the statement"
    complain_found(p, (&es1[0]) as u64, 50)
}

fn block(p: *mut Parser) -> u32 {
    var bx0: [u8; 23] = "at the start of a block"
    return block_in(p, (&bx0[0]) as u64, 23)
}

fn block_in(p: *mut Parser, ctx: u64, ctx_n: usize) -> u32 {
    if !expect_in(p, A_LBRACE, ctx, ctx_n) {
        return ast.block_new(par_tree(p), 0, 0)
    }
    loc_on(p)
    // The statement numbers are collected first and moved into `slist` only
    // at the end -- nested blocks would otherwise cut in between.
    var own: Vec[u32] = vec_new[u32]()
    if (*p).pre_stmt != ast.NOTHING {
        vec_push[u32](&own, (*p).pre_stmt)
        (*p).pre_stmt = ast.NOTHING
    }
    if (*p).pre_stmt2 != ast.NOTHING {
        vec_push[u32](&own, (*p).pre_stmt2)
        (*p).pre_stmt2 = ast.NOTHING
    }
    var pli: usize = 0
    while pli < vec_len[u32](&(*p).pre_list) {
        vec_push[u32](&own, vec_at[u32](&(*p).pre_list, pli))
        pli = pli + 1
    }
    vec_clear[u32](&(*p).pre_list)
    // r751: statements hoisted by the condition in front of this block (`if f([e for ..]) {`)
    // belong in front of the statement that owns the block, not into it
    var outer_hoist: Vec[u32] = vec_new[u32]()
    var oh: usize = 0
    while oh < vec_len[u32](&(*p).hoist) {
        vec_push[u32](&outer_hoist, vec_at[u32](&(*p).hoist, oh))
        oh = oh + 1
    }
    vec_clear[u32](&(*p).hoist)
    while true {
        if actual(p, A_RBRACE) {
            break
        }
        if at_end(p) {
            var bx1: [u8; 36] = "expected '}' at the end of the block"
            complain_found(p, (&bx1[0]) as u64, 36)
            break
        }
        if eat(p, A_SEMI) {
            continue
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        let s: u32 = stmt(p)
        // The hidden text segments of an interpolation go BEFORE the
        // statement that contains it (round 39).
        var hi: usize = 0
        while hi < vec_len[u32](&(*p).hoist) {
            vec_push[u32](&own, vec_at[u32](&(*p).hoist, hi))
            hi = hi + 1
        }
        vec_clear[u32](&(*p).hoist)
        // r725: the `?` statements stand in front of the statement as well
        var qj: usize = 0
        while qj < vec_len[u32](&(*p).qpre) {
            vec_push[u32](&own, vec_at[u32](&(*p).qpre, qj))
            qj = qj + 1
        }
        vec_clear[u32](&(*p).qpre)
        vec_push[u32](&own, s)
        // ROUND TUPLES: the bindings of `let (a, b) = ..` follow it
        var ai: usize = 0
        while ai < vec_len[u32](&(*p).after) {
            vec_push[u32](&own, vec_at[u32](&(*p).after, ai))
            ai = ai + 1
        }
        vec_clear[u32](&(*p).after)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    // ROUND 79: the closing brace is where the frame of this block dies --
    // the escape analysis has to name that place.
    let closing: u64 = at_pos(p, 0)
    eat(p, A_RBRACE)
    let off: u32 = vec_len[u32](&(*par_tree(p)).slist) as u32
    var i: usize = 0
    while i < vec_len[u32](&own) {
        vec_push[u32](&(*par_tree(p)).slist, vec_at[u32](&own, i))
        i = i + 1
    }
    let len: u32 = vec_len[u32](&own) as u32
    vec_free[u32](&own)
    loc_off(p)
    let bi: u32 = ast.block_new(par_tree(p), off, len)
    ast.block_end_set(par_tree(p), bi, closing)
    vec_clear[u32](&(*p).hoist)
    var oi: usize = 0
    while oi < vec_len[u32](&outer_hoist) {
        vec_push[u32](&(*p).hoist, vec_at[u32](&outer_hoist, oi))
        oi = oi + 1
    }
    vec_free[u32](&outer_hoist)
    return bi
}

// ---------------------------------------------------------------- tuples
//
// Twin of the tuple parts of compiler/src/parser.rs; docs/TUPLES.md says what
// they mean. A tuple is a struct whose fields are called `0`, `1`, ...; the
// type checker makes the struct from the types of the elements.

// The interned name of the field `n` of a tuple: its decimal digits.
fn index_name(p: *mut Parser, n: u64) -> u32 {
    rt.buf_clear(&(*p).scratch)
    rt.buf_push_dec_u64(&(*p).scratch, n)
    return intern.intern_number(lexer.lex_names(lx(p)), rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
}

// The interned name of a hidden tuple binding: `__tup#<k>#<n>`.
fn tuple_temp_name(p: *mut Parser, count: usize) -> u32 {
    rt.buf_clear(&(*p).scratch)
    var pf: [u8; 6] = "__tup#"
    rt.buf_push_bytes(&(*p).scratch, (&pf[0]) as u64, 6)
    rt.buf_push_dec_u64(&(*p).scratch, (*p).tup_seq as u64)
    rt.buf_push(&(*p).scratch, 35 as u8)
    rt.buf_push_dec_u64(&(*p).scratch, count as u64)
    (*p).tup_seq = (*p).tup_seq + 1
    return intern.intern_number(lexer.lex_names(lx(p)), rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
}

// `(a, b, ..)`: the first element has been read, a `,` is next.
fn tuple_literal(p: *mut Parser, first: u32) -> u32 {
    var tmp: Vec[u32] = vec_new[u32]()
    var count: u32 = 0
    vec_push[u32](&tmp, index_name(p, 0))
    vec_push[u32](&tmp, first)
    count = 1
    while eat(p, A_COMMA) {
        if actual(p, A_RPAREN) {
            break
        }
        let x: u32 = inner_expr(p)
        vec_push[u32](&tmp, index_name(p, count as u64))
        vec_push[u32](&tmp, x)
        count = count + 1
    }
    var cx37: [u8; 29] = "after the elements of a tuple"
    expect_in(p, A_RPAREN, (&cx37[0]) as u64, 29)
    if count < 2 {
        complain(p)
    }
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    var nm: [u8; 7] = "(tuple)"
    let name: u32 = intern.intern_number(lexer.lex_names(lx(p)), (&nm[0]) as u64, 7) as u32
    return ast.expr_new(par_tree(p), ast.E_SLIT, name, off, count, 0)
}

// A pattern of `let (a, b) = ..` as a flat list, in the order it was read:
//   name   [0, identifier]
//   `_`    [1, 0]
//   tuple  [2, number of elements] followed by the encoded elements
// Returns false (and counts the error) if it is none of the three.
fn tuple_pattern(p: *mut Parser, enc: *mut Vec[u32]) -> bool {
    if actual(p, A_IDENT) {
        let nr: u32 = tok_nr(p, 0)
        next_bump(p)
        var us: [u8; 1] = "_"
        if intern.intern_equal(lexer.lex_names(lx(p)), nr, (&us[0]) as u64, 1) {
            vec_push[u32](enc, 1)
            vec_push[u32](enc, 0)
        } else {
            vec_push[u32](enc, 0)
            vec_push[u32](enc, nr)
        }
        return true
    }
    if !actual(p, A_LPAREN) {
        complain(p)
        return false
    }
    next_bump(p)
    let hdr: usize = vec_len[u32](enc)
    vec_push[u32](enc, 2)
    vec_push[u32](enc, 0)
    var count: u32 = 0
    while !actual(p, A_RPAREN) {
        if !tuple_pattern(p, enc) {
            return false
        }
        count = count + 1
        if actual(p, A_COMMA) {
            next_bump(p)
            continue
        }
        break
    }
    if !expect(p, A_RPAREN) {
        return false
    }
    if count < 2 {
        complain(p)
        return false
    }
    vec_set[u32](enc, hdr + 1, count)
    return true
}

// The statements that take the tuple `tmp` apart: one `let` per name, one
// hidden `let __tup#<k>#<n>` per nested tuple (parser.rs::tuple_bindings).
// `cur` stands on the header of the pattern that belongs to `tmp`.
fn tuple_bindings(p: *mut Parser, enc: *mut Vec[u32], cur: *mut usize, tmp: u32, kind_s: u32,
    out: *mut Vec[u32]) {
    let count: u32 = vec_at[u32](enc, *cur + 1)
    *cur = *cur + 2
    var i: u32 = 0
    while i < count {
        let k: u32 = vec_at[u32](enc, *cur)
        let v: u32 = vec_at[u32](enc, *cur + 1)
        if k == 1 {
            *cur = *cur + 2
            i = i + 1
            continue
        }
        let base: u32 = ast.expr_new(par_tree(p), ast.E_ID, tmp, 0, 0, 0)
        let field: u32 = ast.expr_new(par_tree(p), ast.E_FIELD, base, index_name(p, i as u64), 0, 0)
        if k == 0 {
            *cur = *cur + 2
            vec_push[u32](out, ast.stmt_new(par_tree(p), kind_s, v, ast.NOTHING, field, 0))
            rp_shadow(p, v)
            loc_add(p, v)
        } else {
            let sub: u32 = tuple_temp_name(p, v as usize)
            vec_push[u32](out, ast.stmt_new(par_tree(p), ast.S_LET, sub, ast.NOTHING, field, 0))
            tuple_bindings(p, enc, cur, sub, kind_s, out)
        }
        i = i + 1
    }
}

// `let (a, b) = e` is `let t = e; let a = t.0; let b = t.1`. The hidden `t`
// carries the number of names in its own name (`__tup#<k>#<n>`): the type
// checker refuses a tuple of another size there. `kind_s` is `S_LET` or
// `S_VAR` for the names.
fn let_tuple(p: *mut Parser, kind_s: u32) -> u32 {
    var enc: Vec[u32] = vec_new[u32]()
    if !tuple_pattern(p, &enc) {
        vec_free[u32](&enc)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    var t: u32 = ast.NOTHING
    if eat(p, A_COLON) {
        t = ty(p)
        if t == ast.NOTHING {
            vec_free[u32](&enc)
            return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
        }
    }
    if !expect(p, A_ASSIGN) {
        vec_free[u32](&enc)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let init: u32 = expr(p)
    end_stmt(p)
    let tmp: u32 = tuple_temp_name(p, vec_at[u32](&enc, 1) as usize)
    var cur: usize = 0
    tuple_bindings(p, &enc, &cur, tmp, kind_s, &(*p).after)
    vec_free[u32](&enc)
    return ast.stmt_new(par_tree(p), ast.S_LET, tmp, t, init, 0)
}

fn let_stmt(p: *mut Parser) -> u32 {
    var kind_s: u32 = ast.S_LET
    if actual(p, A_KWVAR) {
        kind_s = ast.S_VAR
    }
    next_bump(p)
    // ROUND TUPLES -- `let (a, b) = f()`
    if actual(p, A_LPAREN) {
        return let_tuple(p, kind_s)
    }
    if !actual(p, A_IDENT) {
        var ls1: [u8; 27] = "expected a name after 'let'"
        var ls2: [u8; 27] = "expected a name after 'var'"
        if kind_s == ast.S_VAR {
            complain_found(p, (&ls2[0]) as u64, 27)
            return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
        }
        complain_found(p, (&ls1[0]) as u64, 27)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    rp_shadow(p, name)
    var t: u32 = ast.NOTHING
    if eat(p, A_COLON) {
        // ROUND 79: `[T; _]` is allowed HERE and only here.
        (*p).infer_len_ok = true
        t = ty(p)
        (*p).infer_len_ok = false
        if t == ast.NOTHING {
            return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
        }
    }
    if !expect(p, A_ASSIGN) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    // wf-py: `let x: Vec[T] = [..]` / `Dict[V] = {..}` (collsugar.rs)
    if t != ast.NOTHING && (*p).err == 0 {
        var cs: u32 = 0
        if coll_init(p, t, true, name, at_pos(p, 0), &cs) {
            loc_add(p, name)
            return cs
        }
    }
    let init: u32 = expr(p)
    end_stmt(p)
    // ROUND 79: `[T; _]` -- now that the initializer has been read, the
    // length is known. Only the OUTERMOST one; `[[u8; _]; 3]` stays an error.
    if t != ast.NOTHING {
        let b: *mut ast.Tree = par_tree(p)
        if ast.t_kind(b, t) == ast.T_ARR && ast.t_b(b, t) == ast.LEN_INFER {
            let n: u64 = literal_length(p, init)
            if n == ast.LEN_INFER {
                complain(p)
                return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
            }
            ast.ty_b_set(b, t, n)
        }
    }
    // Visible ONLY FROM NOW ON: `let x = x + 1` means the outer `x` on the right.
    loc_add(p, name)
    return ast.stmt_new(par_tree(p), kind_s, name, t, init, 0)
}

// ROUND 79: how many elements does this initializer have? `LEN_INFER` means
// "not a literal". Twin of `Parser::literal_length` in
// `compiler/src/parser.rs`.
fn literal_length(p: *mut Parser, e: u32) -> u64 {
    let b: *mut ast.Tree = par_tree(p)
    let a: u32 = ast.e_kind(b, e)
    // A text literal carries its array literal of octets inside (round 70);
    // its length is the one that counts, a written `\0` included.
    if a == ast.E_TEXT {
        return literal_length(p, ast.e_a(b, e))
    }
    if a == ast.E_ALIT {
        return ast.e_c(b, e) as u64
    }
    if a == ast.E_AWDH {
        let n: u32 = ast.e_b(b, e)
        if ast.e_kind(b, n) == ast.E_INT {
            return ast.e_number(b, n)
        }
        return ast.LEN_INFER
    }
    return ast.LEN_INFER
}

// ROUND IFEXPR -- the same grammar as `ifexpr.rs::parse_if`:
// `if cond { expr } else { expr }`, `else if` without braces allowed, and
// each branch is exactly ONE expression.
fn if_expr(p: *mut Parser) -> u32 {
    next_bump(p)
    let cond: u32 = cond_expr(p)
    if !expect(p, A_LBRACE) {
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    let then_v: u32 = expr(p)
    if !expect(p, A_RBRACE) {
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    // Without `else` the expression would have no value in one of the two
    // cases. As a statement `if` works without it -- as an expression it does not.
    if !actual(p, A_KWELSE) {
        complain(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    next_bump(p)
    var else_v: u32 = 0
    if actual(p, A_KWIF) {
        else_v = if_expr(p)
    } else {
        if !expect(p, A_LBRACE) {
            return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
        }
        else_v = expr(p)
        if !expect(p, A_RBRACE) {
            return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
        }
    }
    return ast.expr_new(par_tree(p), ast.E_IFEX, cond, then_v, else_v, 0)
}

// r719 (parser.rs::let_some_head) -- `let Some(<pat>) = <expr>` after `if` / `while`. Returns the
// interned hidden name `__opt#<line>_<col>` (0 after an error) and sets `*scrut`; the pattern
// bindings (reading `<hidden>.val`) are appended to `binds`.
fn let_some_head(p: *mut Parser, hpos: u64, scrut: *mut u32, binds: *mut Vec[u32]) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    next_bump(p)
    var sw: [u8; 4] = "Some"
    if !actual(p, A_IDENT) || !intern.intern_equal(lexer.lex_names(lx(p)), tok_nr(p, 0), (&sw[0]) as u64, 4) {
        complain(p)
        return 0
    }
    next_bump(p)
    if !expect(p, A_LPAREN) {
        return 0
    }
    var enc: Vec[u32] = vec_new[u32]()
    if !tuple_pattern(p, &enc) {
        vec_free[u32](&enc)
        return 0
    }
    if !expect(p, A_RPAREN) || !expect(p, A_ASSIGN) {
        vec_free[u32](&enc)
        return 0
    }
    var si: usize = 0
    while si < vec_len[u32](&enc) {
        if vec_at[u32](&enc, si) == 0 {
            rp_shadow(p, vec_at[u32](&enc, si + 1))
        }
        si = si + 2
    }
    *scrut = cond_expr(p)
    rt.buf_clear(&(*p).scratch)
    var hw: [u8; 6] = "__opt#"
    rt.buf_push_bytes(&(*p).scratch, (&hw[0]) as u64, 6)
    rt.buf_push_dec_u64(&(*p).scratch, ast.pos_line(hpos) as u64)
    rt.buf_push(&(*p).scratch, 95 as u8)
    rt.buf_push_dec_u64(&(*p).scratch, ast.pos_col(hpos) as u64)
    let tmp: u32 = intern.intern_number(lexer.lex_names(lx(p)), rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
    let val: u32 = opt_field(p, tmp, false, hpos)
    loc_on(p)
    var cur: usize = 0
    bind_pat(p, &enc, &cur, val, binds)
    vec_free[u32](&enc)
    return tmp
}

// `<tmp>.has` / `<tmp>.val` as an expression node.
fn opt_field(p: *mut Parser, tmp: u32, is_has: bool, hpos: u64) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    let base: u32 = ast.expr_new(b, ast.E_ID, tmp, 0, 0, 0)
    pos_default(p, base, hpos)
    var hs: [u8; 3] = "has"
    var vs: [u8; 3] = "val"
    var nr: u32 = 0
    if is_has {
        nr = intern.intern_number(lexer.lex_names(lx(p)), (&hs[0]) as u64, 3) as u32
    } else {
        nr = intern.intern_number(lexer.lex_names(lx(p)), (&vs[0]) as u64, 3) as u32
    }
    let e: u32 = ast.expr_new(b, ast.E_FIELD, base, nr, 0, 0)
    pos_default(p, e, hpos)
    return e
}

fn if_stmt(p: *mut Parser) -> u32 {
    let hpos: u64 = at_pos(p, 0)
    next_bump(p)
    if actual(p, A_KWLET) {
        return if_let(p, hpos)
    }
    let cond: u32 = cond_expr(p)
    var cx26: [u8; 27] = "after the condition of 'if'"
    let then: u32 = block_in(p, (&cx26[0]) as u64, 27)
    var els: u32 = ast.NOTHING
    if actual(p, A_KWELSE) {
        next_bump(p)
        if actual(p, A_KWIF) {
            els = stmt_no_pre(p)
        } else {
            var cx25: [u8; 12] = "after 'else'"
            let b: u32 = block_in(p, (&cx25[0]) as u64, 12)
            els = ast.stmt_new(par_tree(p), ast.S_BLOCK, b, 0, 0, 0)
        }
    }
    return ast.stmt_new(par_tree(p), ast.S_IF, cond, then, els, 0)
}

// `if let Some(p) = e { A } else { B }` -> `{ let __opt#L_C = e; if __opt#L_C.has { <binds> A } else { B } }`
fn if_let(p: *mut Parser, hpos: u64) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    var binds: Vec[u32] = vec_new[u32]()
    var scrut: u32 = 0
    let tmp: u32 = let_some_head(p, hpos, &scrut, &binds)
    if tmp == 0 {
        vec_free[u32](&binds)
        return ast.stmt_new(b, ast.S_BREAK, 0, 0, 0, 0)
    }
    var bi: usize = 0
    while bi < vec_len[u32](&binds) {
        vec_push[u32](&(*p).pre_list, vec_at[u32](&binds, bi))
        bi = bi + 1
    }
    vec_free[u32](&binds)
    var cx24: [u8; 31] = "after the condition of 'if let'"
    let then: u32 = block_in(p, (&cx24[0]) as u64, 31)
    loc_off(p)
    var els: u32 = ast.NOTHING
    if actual(p, A_KWELSE) {
        next_bump(p)
        if actual(p, A_KWIF) {
            els = stmt_no_pre(p)
        } else {
            var cx23: [u8; 12] = "after 'else'"
            let eb: u32 = block_in(p, (&cx23[0]) as u64, 12)
            els = ast.stmt_new(b, ast.S_BLOCK, eb, 0, 0, 0)
        }
    }
    let cond: u32 = opt_field(p, tmp, true, hpos)
    let hidden: u32 = ast.stmt_new(b, ast.S_LET, tmp, ast.NOTHING, scrut, 0)
    let ifs: u32 = ast.stmt_new(b, ast.S_IF, cond, then, els, 0)
    let off: u32 = vec_len[u32](&(*b).slist) as u32
    vec_push[u32](&(*b).slist, hidden)
    vec_push[u32](&(*b).slist, ifs)
    let blk: u32 = ast.block_new(b, off, 2)
    ast.block_end_set(b, blk, ast.block_end(b, then))
    return ast.stmt_new(b, ast.S_BLOCK, blk, 0, 0, 0)
}

// `while let Some(p) = e { A }` -> `while true { let __opt#L_C = e; if !__opt#L_C.has { break }; <binds> A }`
fn while_let(p: *mut Parser, hpos: u64) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    var binds: Vec[u32] = vec_new[u32]()
    var scrut: u32 = 0
    (*p).no_q = (*p).no_q + 1
    let tmp: u32 = let_some_head(p, hpos, &scrut, &binds)
    (*p).no_q = (*p).no_q - 1
    if tmp == 0 {
        vec_free[u32](&binds)
        return ast.stmt_new(b, ast.S_BREAK, 0, 0, 0, 0)
    }
    let hidden: u32 = ast.stmt_new(b, ast.S_LET, tmp, ast.NOTHING, scrut, 0)
    let has: u32 = opt_field(p, tmp, true, hpos)
    let not: u32 = ast.expr_new(b, ast.E_UN, U_NOT, has, 0, 0)
    pos_default(p, not, hpos)
    let brk: u32 = ast.stmt_new(b, ast.S_BREAK, 0, 0, 0, 0)
    let boff: u32 = vec_len[u32](&(*b).slist) as u32
    vec_push[u32](&(*b).slist, brk)
    let bblk: u32 = ast.block_new(b, boff, 1)
    ast.block_end_set(b, bblk, hpos)
    let ifs: u32 = ast.stmt_new(b, ast.S_IF, not, bblk, ast.NOTHING, 0)
    vec_push[u32](&(*p).pre_list, hidden)
    vec_push[u32](&(*p).pre_list, ifs)
    var bi: usize = 0
    while bi < vec_len[u32](&binds) {
        vec_push[u32](&(*p).pre_list, vec_at[u32](&binds, bi))
        bi = bi + 1
    }
    vec_free[u32](&binds)
    (*p).loop_depth = (*p).loop_depth + 1
    var cx43: [u8; 34] = "after the condition of 'while let'"
    let body: u32 = block_in(p, (&cx43[0]) as u64, 34)
    (*p).loop_depth = (*p).loop_depth - 1
    loc_off(p)
    let t: u32 = ast.expr_new(b, ast.E_BOOL, 1, 0, 0, 0)
    pos_default(p, t, hpos)
    return ast.stmt_new(b, ast.S_WHILE, t, body, 0, 0)
}

fn while_stmt(p: *mut Parser) -> u32 {
    let hpos: u64 = at_pos(p, 0)
    next_bump(p)
    if actual(p, A_KWLET) {
        return while_let(p, hpos)
    }
    (*p).no_q = (*p).no_q + 1
    let cond: u32 = cond_expr(p)
    (*p).no_q = (*p).no_q - 1
    (*p).loop_depth = (*p).loop_depth + 1
    var cx44: [u8; 30] = "after the condition of 'while'"
    let body: u32 = block_in(p, (&cx44[0]) as u64, 30)
    (*p).loop_depth = (*p).loop_depth - 1
    return ast.stmt_new(par_tree(p), ast.S_WHILE, cond, body, 0, 0)
}

// ROUND REF4 (foreach.rs) -- may the array expression be evaluated twice? A
// name, a field path, `*p`, or an index by a name / number.
fn fe_place_ok(p: *mut Parser, e: u32) -> bool {
    let b: *mut ast.Tree = par_tree(p)
    let k: u32 = ast.e_kind(b, e)
    if k == ast.E_ID {
        return true
    }
    if k == ast.E_FIELD {
        return fe_place_ok(p, ast.e_a(b, e))
    }
    if k == ast.E_UN && ast.e_a(b, e) == U_DEREF {
        return fe_place_ok(p, ast.e_b(b, e))
    }
    if k == ast.E_IDX {
        let ik: u32 = ast.e_kind(b, ast.e_b(b, e))
        return fe_place_ok(p, ast.e_a(b, e)) && (ik == ast.E_ID || ik == ast.E_INT)
    }
    return false
}

// A copy of such a place with fresh node numbers.
fn fe_clone(p: *mut Parser, e: u32) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    let k: u32 = ast.e_kind(b, e)
    var n: u32 = e
    if k == ast.E_ID {
        n = ast.expr_new(b, ast.E_ID, ast.e_a(b, e), 0, 0, 0)
    } else if k == ast.E_INT {
        n = ast.expr_new(b, ast.E_INT, ast.e_a(b, e), ast.e_b(b, e), ast.e_c(b, e), ast.e_number(b, e))
    } else if k == ast.E_FIELD {
        let base: u32 = fe_clone(p, ast.e_a(b, e))
        n = ast.expr_new(b, ast.E_FIELD, base, ast.e_b(b, e), 0, 0)
    } else if k == ast.E_UN {
        let inner: u32 = fe_clone(p, ast.e_b(b, e))
        n = ast.expr_new(b, ast.E_UN, ast.e_a(b, e), inner, 0, 0)
    } else if k == ast.E_IDX {
        let base2: u32 = fe_clone(p, ast.e_a(b, e))
        let idx: u32 = fe_clone(p, ast.e_b(b, e))
        n = ast.expr_new(b, ast.E_IDX, base2, idx, 0, 0)
    }
    if n != e {
        ast.expr_pos_set(b, n, ast.expr_pos(b, e))
    }
    return n
}

// `for name in arr { body }` becomes
//     for __each#L_C in 0 as usize..__each_len(arr) { let name = arr[__each#L_C]; body }
fn for_each(p: *mut Parser, name: u32, arr: u32, fpos: u64, npos: u64, comp: bool) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    if !fe_place_ok(p, arr) {
        complain(p)
        return ast.stmt_new(b, ast.S_BREAK, 0, 0, 0, 0)
    }
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    rt.buf_clear(&(*p).scratch)
    var hw: [u8; 7] = "__each#"
    rt.buf_push_bytes(&(*p).scratch, (&hw[0]) as u64, 7)
    rt.buf_push_dec_u64(&(*p).scratch, ast.pos_line(fpos) as u64)
    rt.buf_push(&(*p).scratch, 95 as u8)
    rt.buf_push_dec_u64(&(*p).scratch, ast.pos_col(fpos) as u64)
    let idx_nr: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
    var lw: [u8; 10] = "__each_len"
    let len_nr: u32 = intern.intern_number(it, (&lw[0]) as u64, 10) as u32
    let arr_len: u32 = fe_clone(p, arr)
    var tmp: Vec[u32] = vec_new[u32]()
    vec_push[u32](&tmp, arr_len)
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    let len_call: u32 = ast.expr_new(b, ast.E_CALL, len_nr, off, 1, 0)
    let lit: u32 = ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
    var uw: [u8; 5] = "usize"
    let un: u32 = intern.intern_number(it, (&uw[0]) as u64, 5) as u32
    let uty: u32 = ast.ty_new(b, ast.T_NAME, un, 0)
    let zero: u32 = ast.expr_new(b, ast.E_AS, lit, uty, 0, 0)
    let apos: u64 = ast.expr_pos(b, arr)
    pos_default(p, len_call, apos)
    pos_default(p, lit, apos)
    pos_default(p, zero, apos)
    // r664: indexing=false -- the hidden counter walks any sequence behind a reference parameter
    let base: u32 = rp_base(p, fe_clone(p, arr), false)
    let at: u32 = ast.expr_new(b, ast.E_ID, idx_nr, 0, 0, 0)
    pos_default(p, at, npos)
    let elem: u32 = ast.expr_new(b, ast.E_IDX, base, at, 0, 0)
    pos_default(p, elem, apos)
    rp_shadow(p, name)
    let bind: u32 = ast.stmt_new(b, ast.S_LET, name, ast.NOTHING, elem, 0)
    ast.stmt_pos_set(b, bind, npos)
    loc_on(p)
    loc_add(p, name)
    loc_add(p, idx_nr)
    (*p).pre_stmt = bind
    let body: u32 = block_c(p, comp)
    (*p).pre_stmt = ast.NOTHING
    loc_off(p)
    return ast.stmt_new(b, ast.S_FOR, idx_nr, zero, len_call, body)
}

// r708 (parser.rs::bind_pat) -- bind the pattern at `*cur` to `init`: a name is one `let`,
// `_` nothing, a nested tuple a hidden `let __tup#<k>#<n>` plus its parts.
fn bind_pat(p: *mut Parser, enc: *mut Vec[u32], cur: *mut usize, init: u32, out: *mut Vec[u32]) {
    let k: u32 = vec_at[u32](enc, *cur)
    let v: u32 = vec_at[u32](enc, *cur + 1)
    if k == 1 {
        *cur = *cur + 2
        return
    }
    if k == 0 {
        *cur = *cur + 2
        vec_push[u32](out, ast.stmt_new(par_tree(p), ast.S_LET, v, ast.NOTHING, init, 0))
        rp_shadow(p, v)
        loc_add(p, v)
        return
    }
    let tmp: u32 = tuple_temp_name(p, v as usize)
    vec_push[u32](out, ast.stmt_new(par_tree(p), ast.S_LET, tmp, ast.NOTHING, init, 0))
    tuple_bindings(p, enc, cur, tmp, ast.S_LET, out)
}

// `v[__each#L_C]` of a clone of `arr`.
fn fe_elem(p: *mut Parser, arr: u32, idx_nr: u32, apos: u64) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    let base: u32 = rp_base(p, fe_clone(p, arr), false)
    let at: u32 = ast.expr_new(b, ast.E_ID, idx_nr, 0, 0, 0)
    pos_default(p, at, apos)
    let elem: u32 = ast.expr_new(b, ast.E_IDX, base, at, 0, 0)
    pos_default(p, elem, apos)
    return elem
}

// r666 / r708 (foreach.rs::build_pair) -- `for (a, b) in enumerate(v) { body }`,
// `for (a, b) in zip(x, y) { body }` and `for (a, b) in vec_of_tuples { body }`:
//     for __each#L_C in 0 as usize..__each_len(v) { let a = __each#L_C; let b = v[__each#L_C]; body }
// zip walks to the shorter length: `if la < lb { la } else { lb }`. Any part may be a nested
// pattern; without enumerate/zip the whole pattern belongs to the element.
fn for_pair(p: *mut Parser, fpos: u64, comp: bool) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    var enc: Vec[u32] = vec_new[u32]()
    if !tuple_pattern(p, &enc) {
        vec_free[u32](&enc)
        return ast.stmt_new(b, ast.S_BREAK, 0, 0, 0, 0)
    }
    var cx20: [u8; 22] = "after the loop pattern"
    if !expect_in(p, A_KWIN, (&cx20[0]) as u64, 22) {
        vec_free[u32](&enc)
        return ast.stmt_new(b, ast.S_BREAK, 0, 0, 0, 0)
    }
    var si: usize = 0
    while si < vec_len[u32](&enc) {
        if vec_at[u32](&enc, si) == 0 {
            rp_shadow(p, vec_at[u32](&enc, si + 1))
        }
        si = si + 2
    }
    let src: u32 = cond_expr(p)
    if !comp && !actual(p, A_LBRACE) {
        vec_free[u32](&enc)
        complain(p)
        return ast.stmt_new(b, ast.S_BREAK, 0, 0, 0, 0)
    }
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    var ew: [u8; 9] = "enumerate"
    var zw: [u8; 3] = "zip"
    let enum_nr: u32 = intern.intern_number(it, (&ew[0]) as u64, 9) as u32
    let zip_nr: u32 = intern.intern_number(it, (&zw[0]) as u64, 3) as u32
    let two: bool = vec_at[u32](&enc, 1) == 2
    var is_enum: bool = false
    var is_zip: bool = false
    var arg0: u32 = src
    var arg1: u32 = 0
    if ast.e_kind(b, src) == ast.E_CALL && two {
        let cnr: u32 = ast.e_a(b, src)
        let coff: u32 = ast.e_b(b, src)
        let ccount: u32 = ast.e_c(b, src)
        if cnr == enum_nr && ccount == 1 {
            is_enum = true
            arg0 = ast.child_at(b, coff)
        }
        if cnr == zip_nr && ccount == 2 {
            is_zip = true
            arg0 = ast.child_at(b, coff)
            arg1 = ast.child_at(b, coff + 1)
        }
    }
    if !fe_place_ok(p, arg0) || (is_zip && !fe_place_ok(p, arg1)) {
        vec_free[u32](&enc)
        complain(p)
        return ast.stmt_new(b, ast.S_BREAK, 0, 0, 0, 0)
    }
    rt.buf_clear(&(*p).scratch)
    var hw: [u8; 7] = "__each#"
    rt.buf_push_bytes(&(*p).scratch, (&hw[0]) as u64, 7)
    rt.buf_push_dec_u64(&(*p).scratch, ast.pos_line(fpos) as u64)
    rt.buf_push(&(*p).scratch, 95 as u8)
    rt.buf_push_dec_u64(&(*p).scratch, ast.pos_col(fpos) as u64)
    let idx_nr: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
    var lw: [u8; 10] = "__each_len"
    let len_nr: u32 = intern.intern_number(it, (&lw[0]) as u64, 10) as u32
    let apos: u64 = ast.expr_pos(b, src)
    var len_e: u32 = fe_len_call(p, len_nr, arg0, apos)
    if is_zip {
        let la: u32 = len_e
        let lb: u32 = fe_len_call(p, len_nr, arg1, apos)
        let la2: u32 = fe_len_call(p, len_nr, arg0, apos)
        let lb2: u32 = fe_len_call(p, len_nr, arg1, apos)
        let cond: u32 = ast.expr_new(b, ast.E_BIN, B_LT, la, lb, 0)
        pos_default(p, cond, apos)
        len_e = ast.expr_new(b, ast.E_IFEX, cond, la2, lb2, 0)
        pos_default(p, len_e, apos)
    }
    let lit: u32 = ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
    var uw: [u8; 5] = "usize"
    let un: u32 = intern.intern_number(it, (&uw[0]) as u64, 5) as u32
    let uty: u32 = ast.ty_new(b, ast.T_NAME, un, 0)
    let zero: u32 = ast.expr_new(b, ast.E_AS, lit, uty, 0, 0)
    pos_default(p, lit, apos)
    pos_default(p, zero, apos)
    // the value expressions first (they name the sequences OUTSIDE the body scope)
    var e0: u32 = 0
    var e1: u32 = 0
    if is_enum {
        e0 = ast.expr_new(b, ast.E_ID, idx_nr, 0, 0, 0)
        pos_default(p, e0, apos)
        e1 = fe_elem(p, arg0, idx_nr, apos)
    } else if is_zip {
        e0 = fe_elem(p, arg0, idx_nr, apos)
        e1 = fe_elem(p, arg1, idx_nr, apos)
    } else {
        e0 = fe_elem(p, arg0, idx_nr, apos)
    }
    loc_on(p)
    loc_add(p, idx_nr)
    var binds: Vec[u32] = vec_new[u32]()
    var cur: usize = 0
    if is_enum || is_zip {
        cur = 2
        bind_pat(p, &enc, &cur, e0, &binds)
        bind_pat(p, &enc, &cur, e1, &binds)
    } else {
        bind_pat(p, &enc, &cur, e0, &binds)
    }
    var bi: usize = 0
    while bi < vec_len[u32](&binds) {
        vec_push[u32](&(*p).pre_list, vec_at[u32](&binds, bi))
        bi = bi + 1
    }
    vec_free[u32](&binds)
    vec_free[u32](&enc)
    let body: u32 = block_c(p, comp)
    loc_off(p)
    return ast.stmt_new(b, ast.S_FOR, idx_nr, zero, len_e, body)
}

// `__each_len(clone of arr)` as an expression node.
fn fe_len_call(p: *mut Parser, len_nr: u32, arr: u32, apos: u64) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    let c: u32 = fe_clone(p, arr)
    var tmp: Vec[u32] = vec_new[u32]()
    vec_push[u32](&tmp, c)
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    let call: u32 = ast.expr_new(b, ast.E_CALL, len_nr, off, 1, 0)
    pos_default(p, call, apos)
    return call
}

fn for_stmt(p: *mut Parser) -> u32 { return for_stmt_c(p, false) }

// wf-py: `comp` = the loop is a clause of a comprehension; its body is the rest of the clauses.
fn for_stmt_c(p: *mut Parser, comp: bool) -> u32 {
    let fpos: u64 = at_pos(p, 0)
    next_bump(p)
    if actual(p, A_LPAREN) {
        return for_pair(p, fpos, comp)
    }
    if !actual(p, A_IDENT) {
        complain(p)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let name: u32 = tok_nr(p, 0)
    let npos: u64 = at_pos(p, 0)
    next_bump(p)
    var cx22: [u8; 19] = "after the loop name"
    if !expect_in(p, A_KWIN, (&cx22[0]) as u64, 19) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    rp_shadow(p, name)
    let of: u32 = cond_expr(p)
    // ROUND REF4: `for x in array { .. }` -- no `..`, the body follows.
    if (!comp && actual(p, A_LBRACE)) || (comp && !actual(p, A_DOTDOT)) {
        return for_each(p, name, of, fpos, npos, comp)
    }
    var cx21: [u8; 34] = "between start and end of the range"
    if !expect_in(p, A_DOTDOT, (&cx21[0]) as u64, 34) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    // ROUND REF2: `start..=end` -- the `=` must follow the `..` DIRECTLY.
    var incl: u32 = 0
    if actual(p, A_ASSIGN) && continues_dd(p) {
        next_bump(p)
        incl = 1
    }
    let to: u32 = cond_expr(p)
    loc_on(p)
    loc_add(p, name)
    let body: u32 = block_c(p, comp)
    loc_off(p)
    let fs: u32 = ast.stmt_new(par_tree(p), ast.S_FOR, name, of, to, body)
    ast.s_f_set(par_tree(p), fs, incl)
    return fs
}

// ------------------------------------------------- wf-py: collection sugar
//
// Twin of compiler/src/collsugar.rs (list/dict literals and comprehensions for `Vec[T]` /
// `Dict[V]` with a DECLARED target type). Read the header there for the desugaring.

// The body of a `for` clause: a `{ block }`, or (comprehension) the rest of the clauses.
fn block_c(p: *mut Parser, comp: bool) -> u32 {
    (*p).loop_depth = (*p).loop_depth + 1
    var r: u32 = 0
    if !comp {
        r = block(p)
    } else {
        r = comp_clauses(p)
    }
    (*p).loop_depth = (*p).loop_depth - 1
    return r
}

// Statement `add_fn(&target, args..)`; `a1`/`a2` are the value expressions (a2 = NOTHING: none).
fn coll_add(p: *mut Parser, target: u32, add_fn: u32, a1: u32, a2: u32, at: u64) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    let id: u32 = ast.expr_new(b, ast.E_ID, target, 0, 0, 0)
    pos_default(p, id, at)
    let addr: u32 = ast.expr_new(b, ast.E_UN, U_ADDR, id, 0, 0)
    pos_default(p, addr, at)
    var args: Vec[u32] = vec_new[u32]()
    vec_push[u32](&args, addr)
    vec_push[u32](&args, a1)
    var n: u32 = 2
    if a2 != ast.NOTHING {
        vec_push[u32](&args, a2)
        n = 3
    }
    let off: u32 = list_store(p, &args)
    vec_free[u32](&args)
    let call: u32 = ast.expr_new(b, ast.E_CALL, add_fn, off, n, 0)
    pos_default(p, call, at)
    let st: u32 = ast.stmt_new(b, ast.S_EXPR, call, 0, 0, 0)
    ast.stmt_pos_set(b, st, at)
    return st
}

// Moves the hoisted statements from index `h0` on into `out`.
fn coll_take_hoist(p: *mut Parser, h0: usize, out: *mut Vec[u32]) {
    var i: usize = h0
    while i < vec_len[u32](&(*p).hoist) {
        vec_push[u32](out, vec_at[u32](&(*p).hoist, i))
        i = i + 1
    }
    vec_shorten[u32](&(*p).hoist, h0)
}

// The clauses of a comprehension, innermost last, as statements appended to `out`.
fn comp_stmts(p: *mut Parser, out: *mut Vec[u32]) {
    if (*p).err > 0 || at_end(p) {
        return
    }
    let b: *mut ast.Tree = par_tree(p)
    if actual(p, A_KWFOR) {
        let h0: usize = vec_len[u32](&(*p).hoist)
        let st: u32 = for_stmt_c(p, true)
        coll_take_hoist(p, h0, out)
        vec_push[u32](out, st)
    } else if actual(p, A_KWIF) {
        let ipos: u64 = at_pos(p, 0)
        next_bump(p)
        let h0: usize = vec_len[u32](&(*p).hoist)
        let cond: u32 = cond_expr(p)
        coll_take_hoist(p, h0, out)
        let then: u32 = comp_clauses(p)
        let ifs: u32 = ast.stmt_new(b, ast.S_IF, cond, then, ast.NOTHING, 0)
        ast.stmt_pos_set(b, ifs, ipos)
        vec_push[u32](out, ifs)
    } else {
        var i: usize = 0
        while i < vec_len[u32](&(*p).comp_pre) {
            vec_push[u32](out, vec_at[u32](&(*p).comp_pre, i))
            i = i + 1
        }
        vec_clear[u32](&(*p).comp_pre)
        if (*p).comp_leaf == ast.NOTHING {
            complain(p)
        } else {
            vec_push[u32](out, (*p).comp_leaf)
            (*p).comp_leaf = ast.NOTHING
        }
    }
}

// `comp_stmts` as a block (the body of a `for` / `if` clause).
fn comp_clauses(p: *mut Parser) -> u32 {
    loc_on(p)
    var own: Vec[u32] = vec_new[u32]()
    if (*p).pre_stmt != ast.NOTHING {
        vec_push[u32](&own, (*p).pre_stmt)
        (*p).pre_stmt = ast.NOTHING
    }
    if (*p).pre_stmt2 != ast.NOTHING {
        vec_push[u32](&own, (*p).pre_stmt2)
        (*p).pre_stmt2 = ast.NOTHING
    }
    var pli: usize = 0
    while pli < vec_len[u32](&(*p).pre_list) {
        vec_push[u32](&own, vec_at[u32](&(*p).pre_list, pli))
        pli = pli + 1
    }
    vec_clear[u32](&(*p).pre_list)
    comp_stmts(p, &own)
    let closing: u64 = at_pos(p, 0)
    let off: u32 = vec_len[u32](&(*par_tree(p)).slist) as u32
    var i: usize = 0
    while i < vec_len[u32](&own) {
        vec_push[u32](&(*par_tree(p)).slist, vec_at[u32](&own, i))
        i = i + 1
    }
    let len: u32 = vec_len[u32](&own) as u32
    vec_free[u32](&own)
    loc_off(p)
    let bi: u32 = ast.block_new(par_tree(p), off, len)
    ast.block_end_set(par_tree(p), bi, closing)
    return bi
}

// Registers the names bound by the top-level `for PAT in` clauses of the bracket group
// that follows the current position as locals (the element expression comes first in the source).
fn comp_loop_vars(p: *mut Parser) {
    var depth: i64 = 1 // the opening bracket is already consumed
    var k: usize = 0
    while true {
        let a: u32 = kind(p, k)
        if a == A_LPAREN || a == A_LBRACKET || a == A_LBRACE {
            depth = depth + 1
        } else if a == A_RPAREN || a == A_RBRACKET || a == A_RBRACE {
            depth = depth - 1
            if depth <= 0 {
                return
            }
        } else if a == A_EOF {
            return
        } else if depth == 1 && a == A_KWFOR {
            var j: usize = k + 1
            while kind(p, j) != A_KWIN && kind(p, j) != A_EOF && kind(p, j) != A_RBRACKET && kind(p, j) != A_RBRACE {
                if kind(p, j) == A_IDENT {
                    loc_add(p, tok_nr(p, j))
                }
                j = j + 1
            }
        }
        k = k + 1
    }
}

// Entry (twin of `Parser::coll_init`): the current token stands right behind `=` / `return`;
// `t` is the declared type node. true: handled, `*out` is the `let` / `return` statement and the
// extra statements are queued in `after` / `qpre`. false: nothing consumed.
fn coll_init(p: *mut Parser, t: u32, dest_let: bool, lname: u32, spos: u64, out: *mut u32) -> bool {
    if !has_gen(p) {
        return false
    }
    let b: *mut ast.Tree = par_tree(p)
    if ast.t_kind(b, t) != ast.T_NAME {
        return false
    }
    let tname: u32 = ast.t_a(b, t)
    let ck: u32 = mono.coll_kind(gn(p), tname)
    if ck == 0 {
        return false
    }
    let is_dict: bool = ck == 2
    let is_set: bool = ck == 3
    var open: u32 = A_LBRACKET
    var close: u32 = A_RBRACKET
    if is_dict || is_set {
        open = A_LBRACE
        close = A_RBRACE
    }
    if !actual(p, open) {
        return false
    }
    // look ahead over the bracket group: a top-level `for` / `:`
    var depth: i64 = 0
    var has_for: bool = false
    var colon: bool = false
    var k: usize = 0
    while true {
        let a: u32 = kind(p, k)
        if a == A_LPAREN || a == A_LBRACKET || a == A_LBRACE {
            depth = depth + 1
        } else if a == A_RPAREN || a == A_RBRACKET || a == A_RBRACE {
            depth = depth - 1
            if depth <= 0 {
                break
            }
        } else if a == A_EOF {
            return false
        } else if depth == 1 && a == A_KWFOR {
            has_for = true
        } else if depth == 1 && a == A_COLON {
            colon = true
        }
        k = k + 1
    }
    if is_dict && !colon && !has_for && kind(p, 1) != A_RBRACE {
        return false
    }
    // `{ k: v }` is no set literal
    if is_set && colon {
        return false
    }
    var wnew: u32 = 0
    var wadd: u32 = 1
    if is_dict {
        wnew = 2
        wadd = 3
    }
    if is_set {
        wnew = 4
        wadd = 5
    }
    let new_fn: u32 = mono.coll_fn(gn(p), tname, wnew)
    let add_fn: u32 = mono.coll_fn(gn(p), tname, wadd)
    if new_fn == ast.NOTHING || add_fn == ast.NOTHING {
        return false
    }
    var dest: u32 = 1
    if dest_let {
        dest = 0
    }
    return coll_core(p, is_dict, is_set, has_for, t, new_fn, add_fn, dest, lname, out)
}

// The interned marker names of an UNTYPED comprehension (r751): 0 = the marker type
// `__infer_coll`, 1/2 = `__coll_new_vec` / `__coll_add_vec`, 3/4 = dict, 5/6 = set.
// `lamsugar.fi` finds the element type later and renames them to the real instances.
fn coll_marker_nr(p: *mut Parser, which: u32) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if which == 0 {
        var w0: [u8; 12] = "__infer_coll"
        return intern.intern_number(it, (&w0[0]) as u64, 12) as u32
    }
    if which == 1 {
        var w1: [u8; 14] = "__coll_new_vec"
        return intern.intern_number(it, (&w1[0]) as u64, 14) as u32
    }
    if which == 2 {
        var w2: [u8; 14] = "__coll_add_vec"
        return intern.intern_number(it, (&w2[0]) as u64, 14) as u32
    }
    if which == 3 {
        var w3: [u8; 15] = "__coll_new_dict"
        return intern.intern_number(it, (&w3[0]) as u64, 15) as u32
    }
    if which == 4 {
        var w4: [u8; 15] = "__coll_add_dict"
        return intern.intern_number(it, (&w4[0]) as u64, 15) as u32
    }
    if which == 5 {
        var w5: [u8; 14] = "__coll_new_set"
        return intern.intern_number(it, (&w5[0]) as u64, 14) as u32
    }
    var w6: [u8; 14] = "__coll_add_set"
    return intern.intern_number(it, (&w6[0]) as u64, 14) as u32
}

// The interned library function `vec_new` .. `set_put` (which 0..5, as `mono.coll_fn`).
fn coll_lib_nr(p: *mut Parser, which: u32) -> u32 {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if which == 0 {
        var w0: [u8; 7] = "vec_new"
        return intern.intern_number(it, (&w0[0]) as u64, 7) as u32
    }
    if which == 1 {
        var w1: [u8; 8] = "vec_push"
        return intern.intern_number(it, (&w1[0]) as u64, 8) as u32
    }
    if which == 2 {
        var w2: [u8; 8] = "dict_new"
        return intern.intern_number(it, (&w2[0]) as u64, 8) as u32
    }
    if which == 3 {
        var w3: [u8; 8] = "dict_set"
        return intern.intern_number(it, (&w3[0]) as u64, 8) as u32
    }
    if which == 4 {
        var w4: [u8; 7] = "set_new"
        return intern.intern_number(it, (&w4[0]) as u64, 7) as u32
    }
    var w5: [u8; 7] = "set_put"
    return intern.intern_number(it, (&w5[0]) as u64, 7) as u32
}

// r751 (twin of `Parser::coll_infer_kind`): 1 / 2 / 3 when the bracket group at the current token
// is an UNTYPED list / dict / set comprehension whose library functions are imported; 0 otherwise.
fn coll_infer_kind(p: *mut Parser) -> u32 {
    if !has_gen(p) || (*p).err > 0 {
        return 0
    }
    let is_vec: bool = actual(p, A_LBRACKET)
    if !is_vec && !actual(p, A_LBRACE) {
        return 0
    }
    var depth: i64 = 0
    var has_for: bool = false
    var colon: bool = false
    var k: usize = 0
    while true {
        let a: u32 = kind(p, k)
        if a == A_LPAREN || a == A_LBRACKET || a == A_LBRACE {
            depth = depth + 1
        } else if a == A_RPAREN || a == A_RBRACKET || a == A_RBRACE {
            depth = depth - 1
            if depth <= 0 {
                break
            }
        } else if a == A_EOF {
            return 0
        } else if depth == 1 && a == A_KWFOR {
            has_for = true
        } else if depth == 1 && a == A_COLON {
            colon = true
        }
        k = k + 1
    }
    if !has_for {
        return 0
    }
    var which: u32 = 0
    var res: u32 = 1
    if !is_vec && colon {
        which = 2
        res = 2
    } else if !is_vec {
        which = 4
        res = 3
    }
    if !mono.gen_is_fn(gn(p), coll_lib_nr(p, which)) || !mono.gen_is_fn(gn(p), coll_lib_nr(p, which + 1)) {
        return 0
    }
    return res
}

// r751: an untyped comprehension in expression position (`let x = [e for ..]`, an argument, ..).
// The current token is the opening bracket. true: `*out` is the expression (the hidden variable);
// its statements are hoisted in front of the statement. false: nothing consumed.
fn coll_expr(p: *mut Parser, out: *mut u32) -> bool {
    let ck: u32 = coll_infer_kind(p)
    if ck == 0 {
        return false
    }
    let nw: u32 = coll_marker_nr(p, 1 + (ck - 1) * 2)
    let ad: u32 = coll_marker_nr(p, 2 + (ck - 1) * 2)
    return coll_core(p, ck == 2, ck == 3, true, ast.NOTHING, nw, ad, 2, 0, out)
}

// The body of `coll_init` / `coll_expr`. `dest`: 0 = `let` (lname), 1 = `return`, 2 = expression
// (r751: untyped, `t0` = NOTHING, the type is the marker `__infer_coll`).
fn coll_core(p: *mut Parser, is_dict: bool, is_set: bool, has_for: bool, t0: u32, new_fn: u32,
    add_fn: u32, dest: u32, lname: u32, out: *mut u32) -> bool {
    let b: *mut ast.Tree = par_tree(p)
    var close: u32 = A_RBRACKET
    if is_dict || is_set {
        close = A_RBRACE
    }
    var t: u32 = t0
    if dest == 2 {
        t = ast.ty_new(b, ast.T_NAME, coll_marker_nr(p, 0), 0)
    }
    let open_pos: u64 = at_pos(p, 0)
    next_bump(p)
    var target: u32 = lname
    if dest != 0 {
        rt.buf_clear(&(*p).scratch)
        var lw: [u8; 5] = "__lc#"
        rt.buf_push_bytes(&(*p).scratch, (&lw[0]) as u64, 5)
        rt.buf_push_dec_u64(&(*p).scratch, ast.pos_line(open_pos) as u64)
        rt.buf_push(&(*p).scratch, 95 as u8)
        rt.buf_push_dec_u64(&(*p).scratch, ast.pos_col(open_pos) as u64)
        target = intern.intern_number(lexer.lex_names(lx(p)), rt.buf_ptr(&(*p).scratch),
            rt.buf_len(&(*p).scratch)) as u32
        loc_add(p, target)
    }
    var noargs: Vec[u32] = vec_new[u32]()
    let noff: u32 = list_store(p, &noargs)
    vec_free[u32](&noargs)
    let init: u32 = ast.expr_new(b, ast.E_CALL, new_fn, noff, 0, 0)
    pos_default(p, init, open_pos)
    (*p).parens = (*p).parens + 1
    (*p).no_q = (*p).no_q + 1
    let remembered: usize = (*p).no_slit
    (*p).no_slit = 0
    var body: Vec[u32] = vec_new[u32]()
    if !actual(p, close) {
        let h0: usize = vec_len[u32](&(*p).hoist)
        // The element is parsed BEFORE its loops: the loop variables must already
        // count as locals, or they get renamed like a global of the same name.
        if has_for {
            loc_on(p)
            comp_loop_vars(p)
        }
        let first: u32 = expr(p)
        var second: u32 = ast.NOTHING
        if is_dict {
            if expect(p, A_COLON) {
                second = expr(p)
            }
        }
        if has_for {
            loc_off(p)
        }
        if (*p).err > 0 {
            // fall through to the closing code
        } else if actual(p, A_KWFOR) {
            // comprehension: the hoisted f-string parts of the element run per iteration
            coll_take_hoist(p, h0, &(*p).comp_pre)
            (*p).comp_leaf = coll_add(p, target, add_fn, first, second, open_pos)
            comp_stmts(p, &body)
        } else {
            vec_push[u32](&body, coll_add(p, target, add_fn, first, second, open_pos))
            while (*p).err == 0 && eat(p, A_COMMA) && !actual(p, close) {
                let k2: u32 = expr(p)
                var v2: u32 = ast.NOTHING
                if is_dict {
                    if !expect(p, A_COLON) {
                        break
                    }
                    v2 = expr(p)
                }
                vec_push[u32](&body, coll_add(p, target, add_fn, k2, v2, open_pos))
            }
        }
    }
    (*p).no_slit = remembered
    (*p).no_q = (*p).no_q - 1
    (*p).parens = (*p).parens - 1
    expect(p, close)
    if dest != 2 {
        end_stmt(p)
    }
    if (*p).err > 0 {
        vec_free[u32](&body)
        if dest == 2 {
            let z: u32 = ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
            pos_default(p, z, open_pos)
            *out = z
        } else {
            *out = ast.stmt_new(b, ast.S_BREAK, 0, 0, 0, 0)
        }
        return true
    }
    var bi: usize = 0
    if dest == 2 {
        vec_push[u32](&(*p).hoist, ast.stmt_new(b, ast.S_VAR, target, t, init, 0))
        while bi < vec_len[u32](&body) {
            vec_push[u32](&(*p).hoist, vec_at[u32](&body, bi))
            bi = bi + 1
        }
        vec_free[u32](&body)
        let ev: u32 = ast.expr_new(b, ast.E_ID, target, 0, 0, 0)
        pos_default(p, ev, open_pos)
        *out = ev
        return true
    }
    if dest == 0 {
        while bi < vec_len[u32](&body) {
            vec_push[u32](&(*p).after, vec_at[u32](&body, bi))
            bi = bi + 1
        }
        vec_free[u32](&body)
        *out = ast.stmt_new(b, ast.S_VAR, lname, t, init, 0)
        return true
    }
    vec_push[u32](&(*p).qpre, ast.stmt_new(b, ast.S_VAR, target, t, init, 0))
    while bi < vec_len[u32](&body) {
        vec_push[u32](&(*p).qpre, vec_at[u32](&body, bi))
        bi = bi + 1
    }
    vec_free[u32](&body)
    let value: u32 = ast.expr_new(b, ast.E_ID, target, 0, 0, 0)
    pos_default(p, value, open_pos)
    let rs: u32 = ast.stmt_new(b, ast.S_RET, value, 0, 0, 0)
    ast.s_b_set(b, rs, (*p).cur_ret)
    *out = rs
    return true
}

fn return_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    var value: u32 = ast.NOTHING
    var has: bool = true
    if actual(p, A_SEMI) || actual(p, A_RBRACE) || at_end(p) || line_start(p) {
        has = false
    }
    if has && (*p).cur_ret != 0 && (*p).err == 0 {
        var cs: u32 = 0
        if coll_init(p, (*p).cur_ret - 1, false, 0, at_pos(p, 0), &cs) {
            return cs
        }
    }
    if has {
        value = expr(p)
    }
    end_stmt(p)
    let rs: u32 = ast.stmt_new(par_tree(p), ast.S_RET, value, 0, 0, 0)
    if value != ast.NOTHING {
        ast.s_b_set(par_tree(p), rs, (*p).cur_ret)
    }
    return rs
}

// ROUND 79 -- the position of every statement, taken at its FIRST token.
// `Stmt::span` in `firnc0` is the same place (`Parser::join` starts there),
// so `return &x` gets reported at the `return` in both compilers.
fn stmt(p: *mut Parser) -> u32 {
    let at: u64 = at_pos(p, 0)
    let qbase: usize = vec_len[u32](&(*p).qpend)
    (*p).stmt_depth = (*p).stmt_depth + 1
    let s: u32 = stmt_inner(p)
    (*p).stmt_depth = (*p).stmt_depth - 1
    ast.stmt_pos_set(par_tree(p), s, at)
    // r725: `let <tmp> = e; if !<tmp>.has { return opt_none[U]() }` per `?`
    let b: *mut ast.Tree = par_tree(p)
    var qi: usize = qbase
    while qi < vec_len[u32](&(*p).qpend) {
        let tmp: u32 = vec_at[u32](&(*p).qpend, qi)
        let inner: u32 = vec_at[u32](&(*p).qpend, qi + 1)
        let nonec: u32 = vec_at[u32](&(*p).qpend, qi + 2)
        let hid: u32 = ast.stmt_new(b, ast.S_LET, tmp, ast.NOTHING, inner, 0)
        let has: u32 = opt_field(p, tmp, true, at)
        let not: u32 = ast.expr_new(b, ast.E_UN, U_NOT, has, 0, 0)
        pos_default(p, not, at)
        let rs: u32 = ast.stmt_new(b, ast.S_RET, nonec, 0, 0, 0)
        ast.s_b_set(b, rs, (*p).cur_ret)
        let roff: u32 = vec_len[u32](&(*b).slist) as u32
        vec_push[u32](&(*b).slist, rs)
        let rblk: u32 = ast.block_new(b, roff, 1)
        ast.block_end_set(b, rblk, at)
        let ifs: u32 = ast.stmt_new(b, ast.S_IF, not, rblk, ast.NOTHING, 0)
        vec_push[u32](&(*p).qpre, hid)
        vec_push[u32](&(*p).qpre, ifs)
        qi = qi + 4
    }
    vec_shorten[u32](&(*p).qpend, qbase)
    return s
}

// r725 -- a statement parsed where nothing drains `qpre` (`defer`, `else if`).
fn stmt_no_pre(p: *mut Parser) -> u32 {
    let s: u32 = stmt(p)
    if vec_len[u32](&(*p).qpre) > 0 {
        vec_clear[u32](&(*p).qpre)
        complain(p)
    }
    return s
}

// r725 -- `e?` (current token: the `?`). See parser.rs::question_op.
fn question_op(p: *mut Parser, e: u32) -> u32 {
    let qpos: u64 = at_pos(p, 0)
    next_bump(p)
    if (*p).stmt_depth == 0 || (*p).no_q > 0 || (*p).cur_ret == 0 || !has_gen(p) {
        complain(p)
        return e
    }
    let b: *mut ast.Tree = par_tree(p)
    let rty: u32 = (*p).cur_ret - 1
    if ast.t_kind(b, rty) != ast.T_NAME {
        complain(p)
        return e
    }
    let m: u32 = mono.option_none_name(gn(p), ast.t_a(b, rty))
    if m == ast.NOTHING {
        complain(p)
        return e
    }
    var none_args: Vec[u32] = vec_new[u32]()
    let noff: u32 = list_store(p, &none_args)
    vec_free[u32](&none_args)
    let nonec: u32 = ast.expr_new(b, ast.E_CALL, m, noff, 0, 0)
    pos_default(p, nonec, qpos)
    rt.buf_clear(&(*p).scratch)
    var qw: [u8; 4] = "__q#"
    rt.buf_push_bytes(&(*p).scratch, (&qw[0]) as u64, 4)
    rt.buf_push_dec_u64(&(*p).scratch, ast.pos_line(qpos) as u64)
    rt.buf_push(&(*p).scratch, 95 as u8)
    rt.buf_push_dec_u64(&(*p).scratch, ast.pos_col(qpos) as u64)
    let tmp: u32 = intern.intern_number(lexer.lex_names(lx(p)), rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
    vec_push[u32](&(*p).qpend, tmp)
    vec_push[u32](&(*p).qpend, e)
    vec_push[u32](&(*p).qpend, nonec)
    vec_push[u32](&(*p).qpend, 0 as u32)
    // firnc0 gives the `.val` node the span of operand + `?`: it starts where the operand starts.
    return opt_field(p, tmp, false, ast.expr_pos(b, e))
}

// r749 -- `with NAME = expr { body }` (twin of `Parser::at_with_stmt`): the word `with`
// followed by `NAME =`. `with` stays a usable identifier.
fn at_with(p: *mut Parser) -> bool {
    if kind(p, 0) != A_IDENT || kind(p, 1) != A_IDENT || kind(p, 2) != A_ASSIGN {
        return false
    }
    var ww: [u8; 4] = "with"
    let wnr: u32 = intern.intern_number(lexer.lex_names(lx(p)), (&ww[0]) as u64, 4) as u32
    return tok_nr(p, 0) == wnr
}

// r749 -- `with NAME = expr { body }` is the block `{ let NAME = expr; defer NAME.close(); body }`;
// `with a = x, b = y { .. }` nests in source order, so the bindings close in reverse.
// Twin of `Parser::with_stmt`.
fn with_stmt(p: *mut Parser) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    next_bump(p) // 'with'
    var names: Vec[u32] = vec_new[u32]()
    var inits: Vec[u32] = vec_new[u32]()
    var poss: Vec[u64] = vec_new[u64]()
    loc_on(p)
    while true {
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let name: u32 = tok_nr(p, 0)
        let npos: u64 = at_pos(p, 0)
        next_bump(p)
        rp_shadow(p, name)
        var cx46: [u8; 36] = "after the name in a 'with' statement"
        if !expect_in(p, A_ASSIGN, (&cx46[0]) as u64, 36) {
            break
        }
        let init: u32 = cond_expr(p)
        // visible only from now on
        loc_add(p, name)
        vec_push[u32](&names, name)
        vec_push[u32](&inits, init)
        vec_push[u64](&poss, npos)
        if (*p).err > 0 || !eat(p, A_COMMA) {
            break
        }
    }
    if (*p).err > 0 || vec_len[u32](&names) == 0 {
        loc_off(p)
        vec_free[u32](&names)
        vec_free[u32](&inits)
        vec_free[u64](&poss)
        return ast.stmt_new(b, ast.S_BREAK, 0, 0, 0, 0)
    }
    var cx45: [u8; 23] = "after the 'with' header"
    let body: u32 = block_in(p, (&cx45[0]) as u64, 23)
    loc_off(p)
    var wc: [u8; 5] = "close"
    let cnr: u32 = intern.intern_number(lexer.lex_names(lx(p)), (&wc[0]) as u64, 5) as u32
    let cname: u32 = method_call_name(p, cnr)
    var own: Vec[u32] = vec_new[u32]()
    var i: usize = 0
    while i < vec_len[u32](&names) {
        let name: u32 = vec_at[u32](&names, i)
        let npos: u64 = vec_at[u64](&poss, i)
        let ls: u32 = ast.stmt_new(b, ast.S_LET, name, ast.NOTHING, vec_at[u32](&inits, i), 0)
        ast.stmt_pos_set(b, ls, npos)
        vec_push[u32](&own, ls)
        let id: u32 = ast.expr_new(b, ast.E_ID, name, 0, 0, 0)
        pos_default(p, id, npos)
        var cargs: Vec[u32] = vec_new[u32]()
        vec_push[u32](&cargs, id)
        let coff: u32 = list_store(p, &cargs)
        vec_free[u32](&cargs)
        let call: u32 = ast.expr_new(b, ast.E_CALL, cname, coff, 1, 0)
        pos_default(p, call, npos)
        let es: u32 = ast.stmt_new(b, ast.S_EXPR, call, 0, 0, 0)
        ast.stmt_pos_set(b, es, npos)
        let ds: u32 = ast.stmt_new(b, ast.S_DEFER, es, 0, 0, 0)
        ast.stmt_pos_set(b, ds, npos)
        vec_push[u32](&own, ds)
        i = i + 1
    }
    let boff: u32 = ast.b_off(b, body)
    let blen: u32 = ast.b_len(b, body)
    var j: u32 = 0
    while j < blen {
        vec_push[u32](&own, vec_at[u32](&(*b).slist, (boff + j) as usize))
        j = j + 1
    }
    let off: u32 = vec_len[u32](&(*b).slist) as u32
    var k: usize = 0
    while k < vec_len[u32](&own) {
        vec_push[u32](&(*b).slist, vec_at[u32](&own, k))
        k = k + 1
    }
    let nb: u32 = ast.block_new(b, off, vec_len[u32](&own) as u32)
    ast.block_end_set(b, nb, ast.block_end(b, body))
    vec_free[u32](&own)
    vec_free[u32](&names)
    vec_free[u32](&inits)
    vec_free[u64](&poss)
    return ast.stmt_new(b, ast.S_BLOCK, nb, 0, 0, 0)
}

fn stmt_inner(p: *mut Parser) -> u32 {
    if at_with(p) {
        return with_stmt(p)
    }
    let a: u32 = kind(p, 0)
    if a == A_KWLET || a == A_KWVAR {
        return let_stmt(p)
    }
    if a == A_KWIF {
        return if_stmt(p)
    }
    if a == A_KWWHILE {
        return while_stmt(p)
    }
    if a == A_KWFOR {
        return for_stmt(p)
    }
    if a == A_KWBREAK {
        let jpos: u64 = at_pos(p, 0)
        let jspan: u32 = tok_span(p)
        next_bump(p)
        if (*p).loop_depth == 0 {
            var jw: [u8; 5] = "break"
            complain_outside_loop(p, jpos, jspan, (&jw[0]) as u64, 5)
        }
        end_stmt(p)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    if a == A_KWCONTINUE {
        let jpos: u64 = at_pos(p, 0)
        let jspan: u32 = tok_span(p)
        next_bump(p)
        if (*p).loop_depth == 0 {
            var jw: [u8; 8] = "continue"
            complain_outside_loop(p, jpos, jspan, (&jw[0]) as u64, 8)
        }
        end_stmt(p)
        return ast.stmt_new(par_tree(p), ast.S_CONT, 0, 0, 0, 0)
    }
    if a == A_KWDEFER || a == A_KWERRDEFER {
        var kind_s: u32 = ast.S_DEFER
        if a == A_KWERRDEFER {
            kind_s = ast.S_ERRDEFER
        }
        next_bump(p)
        let inner: u32 = stmt_no_pre(p)
        return ast.stmt_new(par_tree(p), kind_s, inner, 0, 0, 0)
    }
    if a == A_KWRETURN {
        return return_stmt(p)
    }
    if a == A_LBRACE {
        let b: u32 = block(p)
        return ast.stmt_new(par_tree(p), ast.S_BLOCK, b, 0, 0, 0)
    }
    if a == A_KWMATCH {
        if !has_mu(p) {
            (*p).not_core = true
            complain(p)
            return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
        }
        return match_stmt(p)
    }
    if a == A_KWCATCH {
        // `catch` never starts a statement -- so this is an ordinary syntax
        // error, just as in stage 0. (`try` goes down the expression path.)
        complain(p)
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let e: u32 = expr(p)
    // ROUND 70 (parser.rs): `x += e` and `x++`. Both are STATEMENTS -- the
    // parser sees them only here, and that is exactly why there is no
    // `y = x++`.
    let cop: u32 = compound_op(kind(p, 0))
    if cop != NONE {
        next_bump(p)
        let cv: u32 = expr(p)
        end_stmt(p)
        if rp_readonly_write(p, e) { complain(p) }
        return ast.stmt_new(par_tree(p), ast.S_ZUWOP, e, cv, cop, 0)
    }
    if actual(p, A_PLUSPLUS) || actual(p, A_MINUSMINUS) {
        var up: u32 = 0
        if actual(p, A_PLUSPLUS) {
            up = 1
        }
        next_bump(p)
        end_stmt(p)
        if rp_readonly_write(p, e) { complain(p) }
        return ast.stmt_new(par_tree(p), ast.S_STEP, e, up, 0, 0)
    }
    if actual(p, A_ASSIGN) {
        next_bump(p)
        let v: u32 = expr(p)
        end_stmt(p)
        // r738 (parser.rs): `x[a:b] = w` is the method call `x.slice_assign(a, b, w)`;
        // an extended slice `x[a:b:c] = w` is refused
        if ast.e_kind(par_tree(p), e) == ast.E_CALL && ast.e_c(par_tree(p), e) == 3 {
            let it2: *mut intern.Interner = lexer.lex_names(lx(p))
            var wsl: [u8; 5] = "slice"
            let nrl: u32 = intern.intern_number(it2, (&wsl[0]) as u64, 5) as u32
            if ast.e_a(par_tree(p), e) == method_call_name(p, nrl) {
                let ob: u32 = ast.e_b(par_tree(p), e)
                var wsa: [u8; 12] = "slice_assign"
                let nra: u32 = intern.intern_number(it2, (&wsa[0]) as u64, 12) as u32
                let mnamea: u32 = method_call_name(p, nra)
                var tmpa: Vec[u32] = vec_new[u32]()
                vec_push[u32](&tmpa, ast.child_at(par_tree(p), ob))
                vec_push[u32](&tmpa, ast.child_at(par_tree(p), ob + 1))
                vec_push[u32](&tmpa, ast.child_at(par_tree(p), ob + 2))
                vec_push[u32](&tmpa, v)
                let offa: u32 = list_store(p, &tmpa)
                vec_free[u32](&tmpa)
                let call: u32 = ast.expr_new(par_tree(p), ast.E_CALL, mnamea, offa, 4, 0)
                return ast.stmt_new(par_tree(p), ast.S_EXPR, call, 0, 0, 0)
            }
        }
        if ast.e_kind(par_tree(p), e) == ast.E_CALL && ast.e_c(par_tree(p), e) == 5 {
            let it3: *mut intern.Interner = lexer.lex_names(lx(p))
            var wst: [u8; 10] = "slice_step"
            let nrt: u32 = intern.intern_number(it3, (&wst[0]) as u64, 10) as u32
            if ast.e_a(par_tree(p), e) == method_call_name(p, nrt) {
                // r744: `x[a:b:c] = w` is `x.slice_assign(a, b, c, flags, w)`
                let ob5: u32 = ast.e_b(par_tree(p), e)
                var wsa5: [u8; 12] = "slice_assign"
                let nra5: u32 = intern.intern_number(it3, (&wsa5[0]) as u64, 12) as u32
                let mname5: u32 = method_call_name(p, nra5)
                var tmp5: Vec[u32] = vec_new[u32]()
                vec_push[u32](&tmp5, ast.child_at(par_tree(p), ob5))
                vec_push[u32](&tmp5, ast.child_at(par_tree(p), ob5 + 1))
                vec_push[u32](&tmp5, ast.child_at(par_tree(p), ob5 + 2))
                vec_push[u32](&tmp5, ast.child_at(par_tree(p), ob5 + 3))
                vec_push[u32](&tmp5, ast.child_at(par_tree(p), ob5 + 4))
                vec_push[u32](&tmp5, v)
                let off5: u32 = list_store(p, &tmp5)
                vec_free[u32](&tmp5)
                let call5: u32 = ast.expr_new(par_tree(p), ast.E_CALL, mname5, off5, 6, 0)
                return ast.stmt_new(par_tree(p), ast.S_EXPR, call5, 0, 0, 0)
            }
        }
        if rp_readonly_write(p, e) { complain(p) }
        return ast.stmt_new(par_tree(p), ast.S_ZUW, e, v, 0, 0)
    }
    end_stmt(p)
    return ast.stmt_new(par_tree(p), ast.S_EXPR, e, 0, 0, 0)
}

// --------------------------------------------------------------- declarations

// ROUND 58 (fnval.rs) -- the closure literal.
//
//   fn(a: i32) -> i32 { ... }        captures nothing, record in .rodata
//   gc fn(a: i32) -> i32 { ... }     captures, record in the GC heap
//
// The body becomes a FUNCTION OF THE TREE straight away (`__closure#N`),
// whose LAST parameter is the record. That way the type resolution, the
// lowering and the code generator walk over it like over any other
// function; only the type check runs the body a second time, in place, and
// works out from that what is captured.
fn lambda(p: *mut Parser, heap: bool) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    // The name: `__closure#<number>`. The `#` is no identifier character,
    // so no source text can ever write it.
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    next_bump(p)
    if !expect(p, A_LPAREN) {
        return ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
    }
    loc_on(p)
    let poff: u32 = param_list(p)
    expect(p, A_RPAREN)
    let plen: u32 = ast.param_start(b) - poff
    var ret: u32 = ast.NOTHING
    if actual(p, A_ARROW) {
        next_bump(p)
        ret = ty(p)
        if ret == ast.NOTHING {
            loc_off(p)
            return ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
        }
    }
    if !actual(p, A_LBRACE) {
        complain(p)
        loc_off(p)
        return ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
    }
    // The record arrives as the LAST parameter, typed `*mut u8`. It has to
    // sit directly behind the closure parameters -- they lie contiguously
    // in `pa_*`, and the body is parsed only afterwards.
    var uw: [u8; 2] = "u8"
    let unr: u32 = intern.intern_number(it, (&uw[0]) as u64, 2) as u32
    let uty: u32 = ast.ty_new(b, ast.T_NAME, unr, 0)
    let pty: u32 = ast.ty_new(b, ast.T_PTR, uty, 1)
    rt.buf_clear(&(*p).scratch)
    var ew: [u8; 6] = "__env#"
    rt.buf_push_bytes(&(*p).scratch, (&ew[0]) as u64, 6)
    let ename: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
    ast.param_add(b, ename, pty)
    loc_add(p, ename)
    // The body: a struct literal state of the surrounding condition must
    // not reach into it.
    let saved: usize = (*p).no_slit
    (*p).no_slit = 0
    let saved_ret: u32 = (*p).cur_ret
    (*p).cur_ret = 0
    if ret != ast.NOTHING {
        (*p).cur_ret = ret + 1
    }
    let body: u32 = block(p)
    (*p).cur_ret = saved_ret
    (*p).no_slit = saved
    loc_off(p)
    // The name only now: a closure nested in the body took its number first.
    rt.buf_clear(&(*p).scratch)
    var cw: [u8; 10] = "__closure#"
    rt.buf_push_bytes(&(*p).scratch, (&cw[0]) as u64, 10)
    rt.buf_push_dec_u64(&(*p).scratch, ast.closure_take(b) as u64)
    let cname: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
    if has_gen(p) && mono.gen_in_template(gn(p)) {
        mono.gen_closure_template(gn(p), cname, poff, plen + 1, ret, body)
    } else {
        ast.fn_add(b, cname, poff, plen + 1, ret, body, 0, 0, 0, 0, 0, 0, 0)
    }
    var packed: u64 = 0
    if ret != ast.NOTHING {
        packed = (ret as u64 + 1) << 1
    }
    if heap {
        packed = packed | 1
    }
    return ast.expr_new(b, ast.E_LAMBDA, cname, poff, plen, packed)
}

// r715 (compiler/src/lambda.rs) -- the lambda sugar `|x, y: T| [-> R] expr` or
// `{ block }`. Untyped parameters get the type NOTHING and the lambda a mark
// in `e_number` (LAM_* bits, see lamsugar.fi); `lamsugar.run` fills in the
// types from the expected `fn(..)` type after the parse, before the type
// check. The current token is the opening `|` (or `||`).
fn lambda_sugar(p: *mut Parser, heap: bool) -> u32 {
    let b: *mut ast.Tree = par_tree(p)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    loc_on(p)
    let poff: u32 = ast.param_start(b)
    var infer: bool = false
    if actual(p, A_OROR) {
        next_bump(p)
    } else {
        next_bump(p)
        while !actual(p, A_PIPE) && !at_end(p) {
            if !actual(p, A_IDENT) {
                complain(p)
                break
            }
            let name: u32 = tok_nr(p, 0)
            let pat: u64 = at_pos(p, 0)
            next_bump(p)
            var t: u32 = ast.NOTHING
            if actual(p, A_COLON) {
                next_bump(p)
                t = ty(p)
                if t == ast.NOTHING {
                    break
                }
            } else {
                infer = true
            }
            let pidx: u32 = ast.param_add(b, name, t)
            ast.param_pos_set(b, pidx, pat)
            loc_add(p, name)
            if !eat(p, A_COMMA) {
                break
            }
        }
        expect(p, A_PIPE)
    }
    let plen: u32 = ast.param_start(b) - poff
    var ret: u32 = ast.NOTHING
    if actual(p, A_ARROW) {
        next_bump(p)
        ret = ty(p)
        if ret == ast.NOTHING {
            loc_off(p)
            return ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
        }
    }
    var uw: [u8; 2] = "u8"
    let unr: u32 = intern.intern_number(it, (&uw[0]) as u64, 2) as u32
    let uty: u32 = ast.ty_new(b, ast.T_NAME, unr, 0)
    let pty: u32 = ast.ty_new(b, ast.T_PTR, uty, 1)
    rt.buf_clear(&(*p).scratch)
    var ew: [u8; 6] = "__env#"
    rt.buf_push_bytes(&(*p).scratch, (&ew[0]) as u64, 6)
    let ename: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
    ast.param_add(b, ename, pty)
    loc_add(p, ename)
    var mark: u64 = 0
    var body: u32 = 0
    if actual(p, A_LBRACE) {
        let saved: usize = (*p).no_slit
        (*p).no_slit = 0
        let saved_ret: u32 = (*p).cur_ret
        (*p).cur_ret = 0
        if ret != ast.NOTHING {
            (*p).cur_ret = ret + 1
        }
        body = block(p)
        (*p).cur_ret = saved_ret
        (*p).no_slit = saved
        if ret == ast.NOTHING {
            mark = mark | 2305843009213693952
            infer = true
        }
    } else {
        let epos: u64 = at_pos(p, 0)
        (*p).no_q = (*p).no_q + 1
        let ex: u32 = expr(p)
        (*p).no_q = (*p).no_q - 1
        var own: Vec[u32] = vec_new[u32]()
        var hi: usize = 0
        while hi < vec_len[u32](&(*p).hoist) {
            vec_push[u32](&own, vec_at[u32](&(*p).hoist, hi))
            hi = hi + 1
        }
        vec_clear[u32](&(*p).hoist)
        var sk: u32 = ast.S_RET
        if ret == ast.NOTHING {
            sk = ast.S_EXPR
            mark = mark | 4611686018427387904
            infer = true
        }
        let st: u32 = ast.stmt_new(b, sk, ex, 0, 0, 0)
        ast.stmt_pos_set(b, st, epos)
        vec_push[u32](&own, st)
        let off: u32 = ast.slist_start(b)
        var i: usize = 0
        while i < vec_len[u32](&own) {
            ast.slist_add(b, vec_at[u32](&own, i))
            i = i + 1
        }
        body = ast.block_new(b, off, vec_len[u32](&own) as u32)
        ast.block_end_set(b, body, epos)
        vec_free[u32](&own)
    }
    loc_off(p)
    // The name only now: a lambda nested in the body took its number first.
    rt.buf_clear(&(*p).scratch)
    var cw: [u8; 10] = "__closure#"
    rt.buf_push_bytes(&(*p).scratch, (&cw[0]) as u64, 10)
    rt.buf_push_dec_u64(&(*p).scratch, ast.closure_take(b) as u64)
    let cname: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
    if has_gen(p) && mono.gen_in_template(gn(p)) {
        mono.gen_closure_template(gn(p), cname, poff, plen + 1, ret, body)
    } else {
        ast.fn_add(b, cname, poff, plen + 1, ret, body, 0, 0, 0, 0, 0, 0, 0)
    }
    var packed: u64 = mark
    if ret != ast.NOTHING {
        packed = packed | ((ret as u64 + 1) << 1)
    }
    if heap {
        packed = packed | 1
    }
    if infer {
        packed = packed | 1152921504606846976
    }
    return ast.expr_new(b, ast.E_LAMBDA, cname, poff, plen, packed)
}

fn param_list(p: *mut Parser) -> u32 {
    let off: u32 = vec_len[u32](&(*par_tree(p)).pa_name) as u32
    var seen_default: bool = false
    while true {
        if actual(p, A_RPAREN) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let name: u32 = tok_nr(p, 0)
        // ROUND 79 (escape.fi): where the parameter stands. Its slot lies in
        // the frame like any local, so `&p` can escape too.
        let pat: u64 = at_pos(p, 0)
        next_bump(p)
        var cx28: [u8; 24] = "after the parameter name"
        if !expect_in(p, A_COLON, (&cx28[0]) as u64, 24) {
            break
        }
        // ROUND REF: `x: &T` / `x: inout T` -- reference parameters. The type
        // becomes `*T` / `*mut T`; the body is rewritten while it is parsed.
        var rk: u32 = 0
        if actual(p, A_AMP) {
            next_bump(p)
            rk = 1
        } else if at_inout(p) && (next_starts_type(p) || kind(p, 1) == A_LPAREN) {
            // ROUND TUPLES: `x: inout (A, B)` -- after the colon a type is
            // coming, so a `(` is a tuple type
            next_bump(p)
            rk = 2
        }
        var t: u32 = ty(p)
        if t == ast.NOTHING {
            break
        }
        if rk != 0 {
            var fl: u32 = 0
            var pm: u64 = 0
            if rk == 2 {
                fl = 1
                pm = 1
            }
            if ast.t_kind(par_tree(p), t) == ast.T_ARR {
                fl = fl | 2
            }
            vec_push[u32](&(*p).rp_name, name)
            vec_push[u32](&(*p).rp_flag, fl)
            t = ast.ty_new(par_tree(p), ast.T_PTR, t, pm)
        }
        let pidx: u32 = ast.param_add(par_tree(p), name, t)
        ast.param_pos_set(par_tree(p), pidx, pat)
        // r664: `= <const-expr>` makes the parameter optional.
        if actual(p, A_ASSIGN) {
            next_bump(p)
            if (*p).defaults_ok == 0 || rk != 0 {
                complain(p)
            }
            let dv: u32 = inner_expr(p)
            ast.param_def_set(par_tree(p), pidx, dv)
            seen_default = true
        } else if seen_default {
            // a required parameter cannot follow an optional one
            complain(p)
        }
        loc_add(p, name)
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    return off
}

// `fn IDENT[T: Int](..) -> R { .. }`
//
// THE NAME STAYS UNCHANGED, even inside a module: generic names are visible
// program wide and are used unqualified (`vec_push[i32](..)`).
// That is why `own_search` keeps them out of the renaming list as well.
//
// The template does NOT go into the function list of the tree -- the type
// checker would trip over `T` and `--emit=ast-canon` would print it, which
// `firnc0` does not. Its nodes are in the tree; only the entry points are
// recorded.
fn fn_template(p: *mut Parser, name: u32) {
    if !ty_param_list(p) {
        return
    }
    let toff: u32 = (*p).tpoff
    let tlen: u32 = mono.gen_tp_start(gn(p)) - toff
    if !expect(p, A_LPAREN) {
        return
    }
    // While the body is parsed, all instantiations are ABSTRACT: `Vec[T]` is
    // not work yet, it is a rule.
    mono.gen_depth_on(gn(p))
    loc_on(p)
    (*p).defaults_ok = 1 // r704: templates take defaults
    let poff: u32 = param_list(p)
    (*p).defaults_ok = 0
    expect(p, A_RPAREN)
    let plen: u32 = ast.param_start(par_tree(p)) - poff
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            loc_off(p)
            mono.gen_depth_off(gn(p))
            return
        }
    }
    let saved_ret: u32 = (*p).cur_ret
    (*p).cur_ret = 0
    if ret != ast.NOTHING {
        (*p).cur_ret = ret + 1
    }
    var cx19: [u8; 33] = "at the start of the function body"
    let body: u32 = block_in(p, (&cx19[0]) as u64, 33)
    (*p).cur_ret = saved_ret
    loc_off(p)
    mono.gen_depth_off(gn(p))
    mono.gen_fn_template(gn(p), name, toff, tlen, poff, plen, ret, body)
}

// `struct IDENT[T] { field: T, .. }`
fn struct_template(p: *mut Parser, name: u32) {
    if !ty_param_list(p) {
        return
    }
    let toff: u32 = (*p).tpoff
    let tlen: u32 = mono.gen_tp_start(gn(p)) - toff
    if !expect(p, A_LBRACE) {
        return
    }
    mono.gen_depth_on(gn(p))
    let off: u32 = ast.field_start(par_tree(p))
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let t: u32 = ty(p)
        if t == ast.NOTHING {
            break
        }
        ast.field_add(par_tree(p), fname, t)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    mono.gen_depth_off(gn(p))
    let flen: u32 = ast.field_start(par_tree(p)) - off
    mono.gen_struct_template(gn(p), name, toff, tlen, off, flen)
}

fn fn_decl(p: *mut Parser) {
    // ROUND 75 (SPEC 14.5): 'extern fn' -- a declaration WITHOUT a body,
    // closed with ';' instead of a block.
    let is_extern: bool = actual(p, A_KWEXTERN)
    if is_extern {
        next_bump(p)
    }
    let fn_at: u64 = at_pos(p, 0)
    var cx15: [u8; 38] = "at the start of a function declaration"
    if !expect_in(p, A_KWFN, (&cx15[0]) as u64, 38) {
        return
    }
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let raw: u32 = tok_nr(p, 0)
    next_bump(p)
    // A type parameter list turns it into a generic TEMPLATE.
    if actual(p, A_LBRACKET) {
        if !has_gen(p) {
            (*p).not_core = true
            complain(p)
            return
        }
        if is_extern {
            // 'extern fn name[T](...)' does not exist -- an extern
            // declaration names a concrete, foreign symbol, and there is
            // nothing to monomorphize. Treated as a plain syntax error,
            // the same shape every other place here uses.
            complain(p)
            return
        }
        fn_template(p, raw)
        return
    }
    let name: u32 = renamed(p, raw)
    var cx16: [u8; 23] = "after the function name"
    if !expect_in(p, A_LPAREN, (&cx16[0]) as u64, 23) {
        return
    }
    loc_on(p)
    if !is_extern {
        (*p).defaults_ok = 1
    }
    let poff: u32 = param_list(p)
    (*p).defaults_ok = 0
    var cx17: [u8; 24] = "after the parameter list"
    expect_in(p, A_RPAREN, (&cx17[0]) as u64, 24)
    let plen: u32 = vec_len[u32](&(*par_tree(p)).pa_name) as u32 - poff
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            loc_off(p)
            return
        }
    }
    if is_extern {
        loc_off(p)
        var cx18: [u8; 32] = "after an 'extern fn' declaration"
        expect_in(p, A_SEMI, (&cx18[0]) as u64, 32)
        let empty_body: u32 = ast.block_new(par_tree(p), 0, 0)
        var ls: u32 = 0
        if (*p).link_pending_set { ls = 1 }
        // ROUND ARM-FREESTANDING: `#[arch(...)]` for another machine. The
        // declaration was PARSED (so a syntax error in it is still an error
        // on both machines) and is now simply not added to the tree.
        if (*p).arch_pending != 2 {
            ast.fn_add(par_tree(p), name, poff, plen, ret, empty_body, 0, 0, 0,
                1, (*p).link_pending, ls, 0)
        }
        (*p).arch_pending = 0
        (*p).link_pending = 0
        (*p).link_pending_set = false
        (*p).nogc_pending = 0
        (*p).mc_pending = 0
        (*p).int_pending = 0
        (*p).ph_pending = 0
        (*p).export_pending = 0
        (*p).esc_pending = 0
        return
    }
    let saved_ret: u32 = (*p).cur_ret
    (*p).cur_ret = 0
    if ret != ast.NOTHING {
        (*p).cur_ret = ret + 1
    }
    var cx14: [u8; 33] = "at the start of the function body"
    let body: u32 = block_in(p, (&cx14[0]) as u64, 33)
    (*p).cur_ret = saved_ret
    loc_off(p)
    // ROUND ARM-FREESTANDING: the body of another machine's variant is
    // parsed and then dropped. Parsing it is not wasted work -- it is what
    // makes a syntax error in the A64 version an error on x86 too, so that
    // one machine cannot rot while the other is green.
    if (*p).arch_pending == 2 {
        (*p).arch_pending = 0
        (*p).esc_pending = 0
        (*p).nogc_pending = 0
        (*p).mc_pending = 0
        (*p).int_pending = 0
        (*p).ph_pending = 0
        (*p).export_pending = 0
        (*p).link_pending = 0
        (*p).link_pending_set = false
        return
    }
    (*p).arch_pending = 0
    ast.fn_add(par_tree(p), name, poff, plen, ret, body, (*p).nogc_pending,
        (*p).mc_pending, (*p).int_pending, 0, 0, 0, (*p).export_pending)
    // ROUND 89: this function ends every panic (SPEC 13). The name is the
    // one AFTER module renaming, which is the symbol the code generator
    // emits it under.
    if (*p).ph_pending == 1 {
        ast.panic_handler_set(par_tree(p), name)
        (*p).ph_pending = 0
    }
    // ROUND 79 (escape.fi): the way out and the place the frame dies.
    let fi: usize = ast.fn_count(par_tree(p)) - 1
    ast.fn_esc_set(par_tree(p), fi, (*p).esc_pending)
    ast.fn_end_set(par_tree(p), fi, ast.block_end(par_tree(p), body))
    ast.fn_pos_set(par_tree(p), fi, fn_at)
    (*p).esc_pending = 0
    (*p).nogc_pending = 0
    (*p).mc_pending = 0
    (*p).int_pending = 0
    (*p).export_pending = 0
    if (*p).link_pending_set {
        // '#[link_name(...)]' in front of a function WITH a body: caught
        // here rather than in the prescan, since only fn_decl knows
        // whether the declaration turned out to be 'extern'.
        complain(p)
        (*p).link_pending = 0
        (*p).link_pending_set = false
    }
}

fn struct_decl(p: *mut Parser) {
    let st_at: u64 = at_pos(p, 0)
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let raw: u32 = tok_nr(p, 0)
    next_bump(p)
    if actual(p, A_LBRACKET) {
        if !has_gen(p) {
            (*p).not_core = true
            complain(p)
            return
        }
        struct_template(p, raw)
        return
    }
    let name: u32 = renamed(p, raw)
    var cx33: [u8; 21] = "after the struct name"
    if !expect_in(p, A_LBRACE, (&cx33[0]) as u64, 21) {
        return
    }
    let off: u32 = vec_len[u32](&(*par_tree(p)).fd_name) as u32
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        next_bump(p)
        var cx32: [u8; 20] = "after the field name"
        if !expect_in(p, A_COLON, (&cx32[0]) as u64, 20) {
            break
        }
        let t: u32 = ty(p)
        if t == ast.NOTHING {
            break
        }
        ast.field_add(par_tree(p), fname, t)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    var cx34: [u8; 36] = "at the end of the struct declaration"
    expect_in(p, A_RBRACE, (&cx34[0]) as u64, 36)
    let len: u32 = vec_len[u32](&(*par_tree(p)).fd_name) as u32 - off
    ast.structure_add(par_tree(p), name, off, len, (*p).mc_pending | (*p).lay_pending)
    ast.structure_pos_set(par_tree(p), ast.structure_count(par_tree(p)) - 1, st_at)
    (*p).mc_pending = 0
    (*p).lay_pending = 0
}

fn const_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let name: u32 = renamed(p, tok_nr(p, 0))
    next_bump(p)
    var cx11: [u8; 28] = "after the name of a constant"
    if !expect_in(p, A_COLON, (&cx11[0]) as u64, 28) {
        return
    }
    let t: u32 = ty(p)
    if t == ast.NOTHING {
        return
    }
    var cx10: [u8; 28] = "after the type of a constant"
    if !expect_in(p, A_ASSIGN, (&cx10[0]) as u64, 28) {
        return
    }
    let w: u32 = expr(p)
    end_stmt(p)
    ast.const_add(par_tree(p), name, t, w)
}

// ROUND 89 -- `static NAME: T = value` / `static mut NAME: T = value`
// (SPEC 14.1.statics). The same shape as `const_decl` above with exactly
// one extra token; what differs is what the back end does with it, not the
// syntax.
fn static_decl(p: *mut Parser) {
    next_bump(p)
    let m: bool = eat(p, A_KWMUT)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let name: u32 = renamed(p, tok_nr(p, 0))
    next_bump(p)
    var cx31: [u8; 35] = "after the name of a global variable"
    if !expect_in(p, A_COLON, (&cx31[0]) as u64, 35) {
        return
    }
    let t: u32 = ty(p)
    if t == ast.NOTHING {
        return
    }
    var cx30: [u8; 35] = "after the type of a global variable"
    if !expect_in(p, A_ASSIGN, (&cx30[0]) as u64, 35) {
        return
    }
    let w: u32 = expr(p)
    end_stmt(p)
    ast.static_add(par_tree(p), name, t, w, m)
}

fn import_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    rt.buf_clear(&(*p).scratch)
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    var last: u32 = tok_nr(p, 0)
    rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, last), intern.intern_length(it, last))
    next_bump(p)
    while actual(p, A_DOT) && kind(p, 1) == A_IDENT {
        next_bump(p)
        last = tok_nr(p, 0)
        rt.buf_push(&(*p).scratch, 46 as u8)
        rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, last), intern.intern_length(it, last))
        next_bump(p)
    }
    // `import a.b as c`: the module is reached under the name `c`.
    var chosen: u32 = last
    if actual(p, A_KWAS) {
        next_bump(p)
        if !actual(p, A_IDENT) {
            complain(p)
            return
        }
        chosen = tok_nr(p, 0)
        next_bump(p)
    }
    let path: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch), rt.buf_len(&(*p).scratch)) as u32
    ast.imp_add(par_tree(p), path, chosen)
    vec_push[u32](&(*p).module, chosen)
    vec_push[u32](&(*p).module_to, last)
    end_stmt(p)
}

fn export_decl(p: *mut Parser) {
    next_bump(p)
    var cx12: [u8; 14] = "after 'export'"
    if !expect_in(p, A_LBRACE, (&cx12[0]) as u64, 14) {
        return
    }
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        ast.exp_add(par_tree(p), tok_nr(p, 0))
        next_bump(p)
    }
    var cx13: [u8; 29] = "at the end of the export list"
    expect_in(p, A_RBRACE, (&cx13[0]) as u64, 29)
}

fn profile_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    ast.profile_set(par_tree(p), tok_nr(p, 0))
    next_bump(p)
    end_stmt(p)
}

// ------------------------------------------------------ enum and match
//
// Port of the parser hooks from `sema_match.rs`. The ARMS of a `match` are
// NOT in the tree but in the pattern registry (`pattern.fi`); the tree
// only holds a call `__match#<number>` without arguments. That way a
// generic template can substitute the arms per instantiation as well, and
// `--emit=ast-canon` prints exactly what stage 0 prints.

// `::` is two colon tokens directly after one another.
fn colon(p: *mut Parser, k: usize) -> bool {
    return kind(p, k) == A_COLON && kind(p, k + 1) == A_COLON
}

// `enum IDENT { A, B(i32), C(Point, bool) }`
fn enum_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    // NO renaming: enum names are visible program wide (SPEC 14.1).
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    if !expect(p, A_LBRACE) {
        return
    }
    let ei: u32 = pattern.pat_enum_add(mn(p), name)
    while true {
        while eat(p, A_COMMA) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let vname: u32 = tok_nr(p, 0)
        next_bump(p)
        let toff: u32 = pattern.pat_vt_start(mn(p))
        var tlen: u32 = 0
        if eat(p, A_LPAREN) {
            while true {
                if actual(p, A_RPAREN) || at_end(p) {
                    break
                }
                let vor2: usize = (*p).pos
                let t: u32 = ty(p)
                if t == ast.NOTHING {
                    break
                }
                pattern.pat_vt_add(mn(p), t)
                tlen = tlen + 1
                if !eat(p, A_COMMA) {
                    break
                }
                if (*p).pos == vor2 {
                    next_bump(p)
                }
            }
            expect(p, A_RPAREN)
        }
        pattern.pat_variant_add(mn(p), ei, vname, toff, tlen)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    if pattern.pat_e_vlen(mn(p), ei) == 0 {
        // An enum without a variant is an error (as in stage 0).
        complain(p)
    }
}

// `error IDENT { A, B, C }` -- an error set (errors.rs::errors_decl).
// The name is NOT renamed: error sets are visible program wide, just like
// enum names (SPEC 14.1). Codes start at 1, in order of declaration.
fn error_decl(p: *mut Parser) {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    if !expect(p, A_LBRACE) {
        return
    }
    let mi: u32 = err.error_set_add(fh(p), name)
    if mi == NONE {
        // this error set is already declared
        complain(p)
    }
    var n: u32 = 0
    while true {
        while eat(p, A_COMMA) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let vn: u32 = tok_nr(p, 0)
        next_bump(p)
        // A variant declared twice is an error (as in stage 0).
        if mi != NONE {
            if !err.error_variant_add(fh(p), mi, vn) {
                complain(p)
            }
        }
        n = n + 1
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    if n == 0 {
        // An error set without a variant is an error (as in stage 0).
        complain(p)
    }
}

// An integer in a pattern, optionally signed.
fn pattern_int(p: *mut Parser, good: *mut bool) -> i64 {
    var neg: bool = false
    if eat(p, A_MINUS) {
        neg = true
    }
    if !actual(p, A_INT) {
        complain(p)
        *good = false
        return 0
    }
    let v: u64 = number(p)
    next_bump(p)
    if neg {
        return 0 - (v as i64)
    }
    return v as i64
}

// A pattern (SPEC 6.3). Bindings are registered as local names right
// away -- the body of the arm is parsed afterwards and has to see them.
fn pattern(p: *mut Parser, depth: u32) -> u32 {
    if depth > 32 {
        complain(p)
        return ast.NOTHING
    }
    let a: u32 = kind(p, 0)
    if a == A_KWTRUE {
        next_bump(p)
        return pattern.pat_mu_add(mn(p), pattern.MU_BOOL, 1, 0, 0, 0, 0, 0)
    }
    if a == A_KWFALSE {
        next_bump(p)
        return pattern.pat_mu_add(mn(p), pattern.MU_BOOL, 0, 0, 0, 0, 0, 0)
    }
    if a == A_INT || a == A_MINUS {
        var good: bool = true
        let lo: i64 = pattern_int(p, &good)
        if !good {
            return ast.NOTHING
        }
        if actual(p, A_DOTDOT) {
            next_bump(p)
            var incl: u32 = 0
            if eat(p, A_ASSIGN) {
                incl = 1
            }
            let hi: i64 = pattern_int(p, &good)
            if !good {
                return ast.NOTHING
            }
            // An empty range is an error (as in stage 0).
            if incl == 1 {
                if hi < lo {
                    complain(p)
                    return ast.NOTHING
                }
            } else {
                if hi <= lo {
                    complain(p)
                    return ast.NOTHING
                }
            }
            return pattern.pat_mu_add(mn(p), pattern.MU_RANGE, incl, 0, lo, hi, 0, 0)
        }
        return pattern.pat_mu_add(mn(p), pattern.MU_INT, 0, 0, lo, 0, 0, 0)
    }
    if a == A_IDENT {
        let nr: u32 = tok_nr(p, 0)
        let ipos: u64 = at_pos(p, 0)
        next_bump(p)
        let it: *mut intern.Interner = lexer.lex_names(lx(p))
        var us: [u8; 1] = "_"
        if intern.intern_equal(it, nr, (&us[0]) as u64, 1) {
            return pattern.pat_mu_add(mn(p), pattern.MU_WILD, 0, 0, 0, 0, 0, 0)
        }
        if colon(p, 0) {
            next_bump(p)
            next_bump(p)
            return variants_pattern(p, nr, depth)
        }
        // Round GAPS: `module.NAME` -- a qualified constant as a pattern
        // (sema_match.rs `Pattern::Const`). A BIND with the qualified name and
        // mu_b = 1: sema turns it into the constant's value (`pattern_check`)
        // and reports a qualified name that is no constant (it never binds).
        if actual(p, A_DOT) && kind(p, 1) == A_IDENT {
            let member: u32 = tok_nr(p, 1)
            next_bump(p)
            next_bump(p)
            let q: u32 = qualify(p, nr, member)
            let cp: u32 = pattern.pat_mu_add(mn(p), pattern.MU_BIND, q, 1, 0, 0, 0, 0)
            pattern.pat_mu_pos_set(mn(p), cp, ipos)
            return cp
        }
        // binding of the whole value
        loc_add(p, nr)
        // mu_b = renamed spelling + 2 when the name is one of this module's own
        // top-level names: a constant of the module is written bare in its
        // patterns (modules.rs rewrites it), so sema looks that name up too.
        var bind_b: u32 = 0
        let rn: u32 = renamed(p, nr)
        if rn != nr {
            bind_b = rn + 2
        }
        let bind: u32 = pattern.pat_mu_add(mn(p), pattern.MU_BIND, nr, bind_b, 0, 0, 0, 0)
        pattern.pat_mu_pos_set(mn(p), bind, ipos)
        return bind
    }
    if colon(p, 0) {
        // `::Variant` -- the enum part is missing and is taken from the
        // type of the subject.
        next_bump(p)
        next_bump(p)
        return variants_pattern(p, ast.NOTHING, depth)
    }
    complain(p)
    return ast.NOTHING
}

// `Variant(subpattern, ..)` -- the variant name has not been consumed yet.
fn variants_pattern(p: *mut Parser, ename: u32, depth: u32) -> u32 {
    if !actual(p, A_IDENT) {
        complain(p)
        return ast.NOTHING
    }
    let vname: u32 = tok_nr(p, 0)
    next_bump(p)
    var soff: u32 = 0
    var slen: u32 = 0
    if eat(p, A_LPAREN) {
        var tmp: Vec[u32] = vec_new[u32]()
        while true {
            if actual(p, A_RPAREN) || at_end(p) {
                break
            }
            let before: usize = (*p).pos
            let sub: u32 = pattern(p, depth + 1)
            if sub == ast.NOTHING {
                break
            }
            vec_push[u32](&tmp, sub)
            if !eat(p, A_COMMA) {
                break
            }
            if (*p).pos == before {
                next_bump(p)
            }
        }
        expect(p, A_RPAREN)
        // COLLECT first, then store in one go -- the inner patterns have
        // already stored children of their own.
        soff = pattern.pat_children_start(mn(p))
        var i: usize = 0
        while i < vec_len[u32](&tmp) {
            pattern.pat_child_add(mn(p), vec_at[u32](&tmp, i))
            i = i + 1
        }
        slen = vec_len[u32](&tmp) as u32
        vec_free[u32](&tmp)
    }
    return pattern.pat_mu_add(mn(p), pattern.MU_VARIANT, ename, vname, 0, 0, soff, slen)
}

// `match subject { pattern => { .. } .. }` as a statement. It becomes the
// call `__match#<number>` without arguments; the arms live in the registry.
fn match_stmt(p: *mut Parser) -> u32 {
    next_bump(p)
    // `match` inside a generic template is not supported -- the arms live
    // in the registry, and a template could not substitute them per
    // instantiation (an error in stage 0 as well).
    if has_gen(p) {
        if mono.gen_in_template(gn(p)) {
            (*p).not_core = true
            complain(p)
        }
    }
    // The subject may not contain a struct literal at the top level --
    // otherwise `match X { .. }` could not be told from the block.
    let subj: u32 = cond_expr(p)
    if !expect(p, A_LBRACE) {
        return ast.stmt_new(par_tree(p), ast.S_BREAK, 0, 0, 0, 0)
    }
    let mi: u32 = pattern.pat_match_add(mn(p), subj)
    while true {
        while eat(p, A_COMMA) || eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        // The bindings of the pattern are visible in the body -- and only there.
        loc_on(p)
        let pat: u32 = pattern(p, 0)
        if pat == ast.NOTHING {
            loc_off(p)
            break
        }
        // Round GAPS: `A | B =>` -- alternatives (sema_match.rs Pattern::Or).
        // Not ported to stage 1: the file counts as not core (exit 3), like
        // the other unported extensions; the alternatives are only skipped.
        while actual(p, A_PIPE) {
            (*p).not_core = true
            next_bump(p)
            if pattern(p, 0) == ast.NOTHING {
                break
            }
        }
        // `=>` is two tokens: `=` and `>`.
        if !(actual(p, A_ASSIGN) && kind(p, 1) == A_GT) {
            complain(p)
            loc_off(p)
            break
        }
        next_bump(p)
        next_bump(p)
        if !actual(p, A_LBRACE) {
            complain(p)
            loc_off(p)
            break
        }
        let body: u32 = block(p)
        loc_off(p)
        pattern.pat_arm_add(mn(p), mi, pat, body)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
    if pattern.pat_m_alen(mn(p), mi) == 0 {
        complain(p)
    }
    // The callee name carries the number: `__match#<mi>`.
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    rt.buf_clear(&(*p).scratch)
    var pfx: [u8; 8] = "__match#"
    rt.buf_push_bytes(&(*p).scratch, (&pfx[0]) as u64, 8)
    rt.buf_push_dec_u64(&(*p).scratch, mi as u64)
    let name: u32 = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
        rt.buf_len(&(*p).scratch)) as u32
    let e: u32 = ast.expr_new(par_tree(p), ast.E_CALL, name, 0, 0, 0)
    return ast.stmt_new(par_tree(p), ast.S_EXPR, e, 0, 0, 0)
}

// Prescan: collect all `import` aliases so that `module.x` is recognised
// from the FIRST line onwards. `firnc0` does the same.
fn module_upfront(p: *mut Parser) {
    var i: usize = 0
    while i + 1 < (*p).n {
        if lexer.lex_kind(lx(p), i) == A_KWIMPORT {
            var j: usize = i + 1
            var last: u32 = ast.NOTHING
            while j < (*p).n {
                if lexer.lex_kind(lx(p), j) != A_IDENT {
                    break
                }
                last = lexer.lex_nr(lx(p), j)
                j = j + 1
                if j >= (*p).n {
                    break
                }
                if lexer.lex_kind(lx(p), j) != A_DOT {
                    break
                }
                j = j + 1
            }
            // `import a.b as c`: the name is `c`, the module behind it `b`
            var chosen: u32 = last
            if j + 1 < (*p).n && lexer.lex_kind(lx(p), j) == A_KWAS && lexer.lex_kind(lx(p), j + 1) == A_IDENT {
                chosen = lexer.lex_nr(lx(p), j + 1)
            }
            if last != ast.NOTHING {
                vec_push[u32](&(*p).module, chosen)
                vec_push[u32](&(*p).module_to, last)
            }
        }
        i = i + 1
    }
}

// ROUND 82: is this identifier one of the vector/crypto names of round 82,
// or the type name `v128`? Matched by PREFIX, so that the list does not have
// to be repeated here every time an intrinsic is added -- the prefixes are
// reserved for them (SPEC 8.6).
fn simd_word(p: *mut Parser, nr: u32) -> bool {
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    var w_ty: [u8; 4] = "v128"
    if intern.intern_equal(it, nr, (&w_ty[0]) as u64, 4) {
        return true
    }
    var p1: [u8; 7] = "__v128_"
    var p2: [u8; 5] = "__aes"
    var p3: [u8; 8] = "__sha256"
    var p4: [u8; 11] = "__pclmulqdq"
    var p5: [u8; 8] = "__crc32_"
    var p6: [u8; 14] = "__cpu_features"
    return intern.intern_prefix(it, nr, (&p1[0]) as u64, 7)
    || intern.intern_prefix(it, nr, (&p2[0]) as u64, 5)
    || intern.intern_prefix(it, nr, (&p3[0]) as u64, 8)
    || intern.intern_prefix(it, nr, (&p4[0]) as u64, 11)
    || intern.intern_prefix(it, nr, (&p5[0]) as u64, 8)
    || intern.intern_prefix(it, nr, (&p6[0]) as u64, 14)
}

// Prescan for extensions that this parser does NOT understand.
//
// Better here than in the middle of the descent: this way it is settled before
// the first node whether the file is core language at all, and the comparison
// counts it cleanly as "not core" instead of as a deviation. In the TOKEN STREAM:
//
//   enum | match | error | try | catch | comptime | '#'   keywords
//   '?'                                                    `x.as?[C]`
//   '::'                                                   `Enum::Variant`
//   IDENT '['  after 'fn'/'struct'  generic template -- an extension ONLY
//                                   while no template registry has been
//                                   registered (round 31)
//   IDENT '!'                                              error union `E!T`
//   the identifier `gc`                                    `gc class`, `gc C{}`
fn extensions_search(p: *mut Parser) {
    // Intern number of the identifier "gc" -- if it appears in the text at all.
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    var gc_word: [u8; 2] = "gc"
    let gc_nr: i64 = intern.intern_find(it, (&gc_word[0]) as u64, 2)
    // The constant time intrinsics (`ct.rs`, SPEC 9.2/9.3) are ordinary
    // identifiers, not keywords -- they can only be recognised by their
    // SPELLING. Anyone who writes a `select` function of their own falls
    // out here by mistake; that is the cautious direction.
    var ct1: [u8; 6] = "select"
    var ct2: [u8; 7] = "barrier"
    var ct3: [u8; 11] = "secure_zero"
    let ct1_nr: i64 = intern.intern_find(it, (&ct1[0]) as u64, 6)
    let ct2_nr: i64 = intern.intern_find(it, (&ct2[0]) as u64, 7)
    let ct3_nr: i64 = intern.intern_find(it, (&ct3[0]) as u64, 11)

    var i: usize = 0
    while i < (*p).n {
        let a: u32 = lexer.lex_kind(lx(p), i)
        if a == A_KWENUM || a == A_KWMATCH {
            // Belongs to the core language AS SOON AS the pattern registry is
            // registered -- the same handover as for the generic templates
            // (round 31).
            if !has_mu(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_KWERROR || a == A_KWTRY || a == A_KWCATCH {
            // Belongs to the core language AS SOON AS the error registry
            // is registered -- the same handover as for `enum`/`match`
            // (round 32).
            if !has_fe(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_KWERRDEFER {
            // ROUND 36: belongs to the core language as soon as the error
            // registry is registered -- the error path comes from
            // `err.fi`/`lower.fi` (`ret_term_error`), the same
            // handover as for `error`/`try`/`catch` (round 33).
            if !has_fe(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_KWCOMPTIME {
            // ROUND 35: belongs to the core language as soon as `par_time_set`
            // has run -- the same handover as in rounds 31-33.
            if !has_time(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_HASH {
            // ROUND 34: `#[no_gc]` belongs to the core language as soon as the
            // gc registry is registered -- every OTHER attribute
            // (`#[must_consume]`, ...) stays an extension that is not
            // ported, as before.
            var ok_attr: bool = false
            if has_gc(p) && i + 3 < (*p).n {
                if lexer.lex_kind(lx(p), i + 1) == A_LBRACKET && lexer.lex_kind(lx(p), i + 3) == A_RBRACKET {
                    if lexer.lex_kind(lx(p), i + 2) == A_IDENT {
                        var an: [u8; 5] = "no_gc"
                        var mc: [u8; 12] = "must_consume"
                        // Round 36: both attributes implemented (attrs.rs).
                        // Round 52: plus `#[interrupt]` and `#[allow_fp]`.
                        var iw: [u8; 9] = "interrupt"
                        var fw: [u8; 8] = "allow_fp"
                        // Round 75: plus `#[export_c]` (`#[link_name(...)]`
                        // has one argument and is shaped differently --
                        // checked separately below).
                        var ec: [u8; 8] = "export_c"
                        // Round 79: plus `#[allow_escape]` (escape.fi).
                        var esw: [u8; 12] = "allow_escape"
                        // Round 89: plus `#[panic_handler]` (SPEC 13).
                        var phw: [u8; 13] = "panic_handler"
                        // ROUND 94: plus `#[test]` (attrs.rs, testrun.rs). The
                        // attribute is KNOWN here so that a file full of test
                        // cases counts as core language for both compilers;
                        // the runner itself (`--test`) is firnc0's, and this
                        // stage compiles a marked function as an ordinary one.
                        var tw: [u8; 4] = "test"
                        // ROUND FUI-ALL: plus `#[inline]` / `#[no_inline]`.
                        var inw: [u8; 6] = "inline"
                        var niw: [u8; 9] = "no_inline"
                        var pkw: [u8; 6] = "packed"
                        let anr: u32 = lexer.lex_nr(lx(p), i + 2)
                        let itn: *mut intern.Interner = lexer.lex_names(lx(p))
                        ok_attr = intern.intern_equal(itn, anr, (&an[0]) as u64, 5) ||
                        intern.intern_equal(itn, anr, (&mc[0]) as u64, 12) ||
                        intern.intern_equal(itn, anr, (&iw[0]) as u64, 9) ||
                        intern.intern_equal(itn, anr, (&fw[0]) as u64, 8) ||
                        intern.intern_equal(itn, anr, (&esw[0]) as u64, 12) ||
                        intern.intern_equal(itn, anr, (&phw[0]) as u64, 13) ||
                        intern.intern_equal(itn, anr, (&tw[0]) as u64, 4) ||
                        intern.intern_equal(itn, anr, (&ec[0]) as u64, 8) ||
                        intern.intern_equal(itn, anr, (&inw[0]) as u64, 6) ||
                        intern.intern_equal(itn, anr, (&niw[0]) as u64, 9) ||
                        intern.intern_equal(itn, anr, (&pkw[0]) as u64, 6)
                    }
                }
            }
            // Round 75: `#[link_name(c_symbol)]` -- '#' '[' IDENT '(' IDENT ')' ']',
            // six tokens instead of four.
            if !ok_attr && has_gc(p) && i + 6 < (*p).n {
                if lexer.lex_kind(lx(p), i + 1) == A_LBRACKET
                && lexer.lex_kind(lx(p), i + 2) == A_IDENT
                && lexer.lex_kind(lx(p), i + 3) == A_LPAREN
                && lexer.lex_kind(lx(p), i + 4) == A_IDENT
                && lexer.lex_kind(lx(p), i + 5) == A_RPAREN
                && lexer.lex_kind(lx(p), i + 6) == A_RBRACKET
                {
                    var ln: [u8; 9] = "link_name"
                    // ROUND ARM-FREESTANDING: `#[arch(x86_64)]` has the same
                    // six token shape (archsel.rs).
                    var arw: [u8; 4] = "arch"
                    let anr: u32 = lexer.lex_nr(lx(p), i + 2)
                    let itn: *mut intern.Interner = lexer.lex_names(lx(p))
                    ok_attr = intern.intern_equal(itn, anr, (&ln[0]) as u64, 9) ||
                    intern.intern_equal(itn, anr, (&arw[0]) as u64, 4)
                }
            }
            if !ok_attr && has_gc(p) && i + 6 < (*p).n {
                if lexer.lex_kind(lx(p), i + 1) == A_LBRACKET
                && lexer.lex_kind(lx(p), i + 2) == A_IDENT
                && lexer.lex_kind(lx(p), i + 3) == A_LPAREN
                && lexer.lex_kind(lx(p), i + 4) == A_INT
                && lexer.lex_kind(lx(p), i + 5) == A_RPAREN
                && lexer.lex_kind(lx(p), i + 6) == A_RBRACKET
                {
                    var alw: [u8; 5] = "align"
                    let anr: u32 = lexer.lex_nr(lx(p), i + 2)
                    let itn: *mut intern.Interner = lexer.lex_names(lx(p))
                    ok_attr = intern.intern_equal(itn, anr, (&alw[0]) as u64, 5)
                }
            }
            if !ok_attr {
                (*p).not_core = true
                return
            }
        }
        if a == A_QUESTION {
            // ROUND 34: `?` belongs only to `x.as?[C]` -- core with registry.
            if !has_gc(p) {
                (*p).not_core = true
                return
            }
        }
        if a == A_COLON && i + 1 < (*p).n {
            if lexer.lex_kind(lx(p), i + 1) == A_COLON {
                if !has_mu(p) {
                    (*p).not_core = true
                    return
                }
            }
        }
        if a == A_IDENT {
            let nr: i64 = lexer.lex_nr(lx(p), i) as i64
            // ROUND 82: the vector and crypto instructions
            // (compiler/src/simd.rs). This parser knows neither the type
            // `v128` nor the 42 `__v128_*` / `__aes*` / `__sha256*` /
            // `__pclmulqdq` / `__crc32_*` / `__cpu_features` intrinsics, and
            // `codegen.fi` could not emit them either -- it has no register
            // allocation and no xmm class. Recognised by their SPELLING here,
            // so that a file like `tests/1613_crypto.fi` counts cleanly as
            // "not core" in `tools/self_compare.sh` instead of appearing as a
            // FAULTY -- which is exactly what it did before this line
            // existed. Porting it belongs to the round that gives
            // `lib/firnc1` a code generator with registers.
            if simd_word(p, lexer.lex_nr(lx(p), i)) {
                (*p).not_core = true
                return
            }
            // Round GAPS (include.rs): `__include_str` reads a file relative
            // to the SOURCE file -- this parser does not know that path.
            var incw: [u8; 13] = "__include_str"
            // ROUND FUI-ALL: ported (`include_str` below) -- core now.
            let _incw_known: bool = intern.intern_equal(lexer.lex_names(lx(p)),
                lexer.lex_nr(lx(p), i), (&incw[0]) as u64, 13)
            if gc_nr >= 0 && nr == gc_nr {
                // ROUND 34: `gc`/`gc class`/`gc C{}` belong to the core language
                // as soon as the gc registry is registered (the same
                // handover as in rounds 31-33, 35).
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if ct1_nr >= 0 && nr == ct1_nr {
                // ROUND 36: `select(b, a, b)` is ported (ct.rs) -- the same
                // handover as for `barrier`: core as soon as the gc
                // registry is registered; the dump tools stay
                // at "not core", because their stage 0 side prints
                // `Op::Select`.
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if ct2_nr >= 0 && nr == ct2_nr {
                // ROUND 34: `barrier(x)` is the opaque barrier from
                // ct.rs -- for the behaviour (and this stage has no
                // optimizer) it is the identity. It belongs to the
                // core language as soon as the gc registry is registered:
                // that registry needs it (tests/modules/dom.fi), and only the
                // real compiler registers it -- the dump tools
                // stay at "not core", because their stage 0 side prints
                // the opaque part (`Op::Barrier`).
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if ct3_nr >= 0 && nr == ct3_nr {
                // ROUND 36: `secure_zero(p, n)` is ported (ct.rs) --
                // the same handover as for `select`.
                if !has_gc(p) {
                    (*p).not_core = true
                    return
                }
            }
            if i + 1 < (*p).n && lexer.lex_kind(lx(p), i + 1) == A_NOT {
                // `E!T` -- an error union is IDENT followed by `!`.
                if !has_fe(p) {
                    (*p).not_core = true
                    return
                }
            }
            if i > 0 && i + 1 < (*p).n && !has_gen(p) {
                let before: u32 = lexer.lex_kind(lx(p), i - 1)
                if before == A_KWFN || before == A_KWSTRUCT {
                    if lexer.lex_kind(lx(p), i + 1) == A_LBRACKET {
                        (*p).not_core = true
                        return
                    }
                }
            }
        }
        i = i + 1
    }
}

// Collects the names that this file declares at the top level. Only those
// are renamed -- a use from another module is written qualified there
// anyway.
fn own_search(p: *mut Parser) {
    if (*p).alias == NONE {
        return
    }
    var i: usize = 0
    while i + 1 < (*p).n {
        // ROUND 45: the methods of an `impl` block are called `Type__method`
        // and never appear under their short name in the module. `firnc0`
        // collects the names only AFTER parsing (modules.rs) and does not
        // see them either -- without this skip the two would drift apart.
        if is_impl_at(p, i) {
            i = impl_end(p, i)
            continue
        }
        // ROUND 46: the same for `interface I { fn ... }`. The methods of an
        // interface are not names of the module -- `firnc0` never sees them
        // either (the block does not even end up in the tree).
        if is_interface_at(p, i) {
            i = impl_end(p, i)
            continue
        }
        let a: u32 = lexer.lex_kind(lx(p), i)
        // HOOK alias: `type NAME = T` declares a name of this module
        if a == A_IDENT && alias_head_at(p, i) == 1 {
            vec_push[u32](&(*p).own, lexer.lex_nr(lx(p), i + 1))
        }
        // ROUND 89: `static mut NAME` puts one token between the keyword
        // and the name; `static NAME` does not. Everything else in this
        // scan has the name at i+1.
        if a == A_KWSTATIC {
            var at: usize = i + 1
            if lexer.lex_kind(lx(p), at) == A_KWMUT { at = at + 1 }
            if at < (*p).n && lexer.lex_kind(lx(p), at) == A_IDENT {
                vec_push[u32](&(*p).own, lexer.lex_nr(lx(p), at))
            }
            i = i + 1
            continue
        }
        if a == A_KWFN || a == A_KWSTRUCT || a == A_KWCONST {
            if lexer.lex_kind(lx(p), i + 1) == A_IDENT {
                // A generic template keeps its name: generic names are
                // visible PROGRAM WIDE and are used
                // unqualified. Renaming them would make `vec_push[i32](..)`
                // impossible to find from the root file.
                var generic: bool = false
                if a != A_KWCONST && i + 2 < (*p).n {
                    generic = lexer.lex_kind(lx(p), i + 2) == A_LBRACKET
                }
                if !generic {
                    vec_push[u32](&(*p).own, lexer.lex_nr(lx(p), i + 1))
                }
            }
        }
        i = i + 1
    }
}

// ROUND 35: `comptime { ... }` at the top level. The body is an
// ordinary block -- the same statements, the same shadowing of
// local names, the same module renaming. The block does NOT go into
// a function but into `ast.ct_block` as a number; the interpreter in
// time.fi runs it before the type check (after compiler/src/comptime.rs).
fn comptime_decl(p: *mut Parser) {
    next_bump(p)
    var cx9: [u8; 16] = "after 'comptime'"
    let b: u32 = block_in(p, (&cx9[0]) as u64, 16)
    ast.ct_add(par_tree(p), b)
}

// ROUND 34: is there a `gc class` at this position? (hook_item in gc.rs)
fn is_gc_class(p: *mut Parser) -> bool {
    if !actual(p, A_IDENT) {
        return false
    }
    var gw: [u8; 2] = "gc"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, tok_nr(p, 0), (&gw[0]) as u64, 2) {
        return false
    }
    if kind(p, 1) != A_IDENT {
        return false
    }
    var cw: [u8; 5] = "class"
    return intern.intern_equal(it, tok_nr(p, 1), (&cw[0]) as u64, 5)
}

// ROUND 45 (impls.rs::hook_item): is there an `impl Type {` at this position?
// `impl` is NOT a keyword but an identifier in a position where
// nothing else may appear -- the same trick as for `gc class`.
fn is_impl(p: *mut Parser) -> bool {
    if !actual(p, A_IDENT) {
        return false
    }
    var iw: [u8; 4] = "impl"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, tok_nr(p, 0), (&iw[0]) as u64, 4) {
        return false
    }
    if kind(p, 1) != A_IDENT {
        return false
    }
    if kind(p, 2) == A_LBRACE {
        return true
    }
    // ROUND 46: `impl Interface for Type {`. `for` is a keyword
    // and makes the shape unambiguous.
    if kind(p, 2) != A_KWFOR {
        return false
    }
    if kind(p, 3) != A_IDENT {
        return false
    }
    return kind(p, 4) == A_LBRACE
}

// ROUND 46 (iface.rs::hook_item): an `interface IDENT {` at this position?
fn is_interface(p: *mut Parser) -> bool {
    if !actual(p, A_IDENT) {
        return false
    }
    var iw: [u8; 9] = "interface"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, tok_nr(p, 0), (&iw[0]) as u64, 9) {
        return false
    }
    if kind(p, 1) != A_IDENT {
        return false
    }
    return kind(p, 2) == A_LBRACE
}

// The same, but at an ABSOLUTE token position (for the prescan).
fn is_interface_at(p: *mut Parser, i: usize) -> bool {
    if i + 2 >= (*p).n {
        return false
    }
    if lexer.lex_kind(lx(p), i) != A_IDENT {
        return false
    }
    var iw: [u8; 9] = "interface"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, lexer.lex_nr(lx(p), i), (&iw[0]) as u64, 9) {
        return false
    }
    if lexer.lex_kind(lx(p), i + 1) != A_IDENT {
        return false
    }
    return lexer.lex_kind(lx(p), i + 2) == A_LBRACE
}

// The same, but at an ABSOLUTE token position (for the prescan).
fn is_impl_at(p: *mut Parser, i: usize) -> bool {
    if i + 2 >= (*p).n {
        return false
    }
    if lexer.lex_kind(lx(p), i) != A_IDENT {
        return false
    }
    var iw: [u8; 4] = "impl"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    if !intern.intern_equal(it, lexer.lex_nr(lx(p), i), (&iw[0]) as u64, 4) {
        return false
    }
    if lexer.lex_kind(lx(p), i + 1) != A_IDENT {
        return false
    }
    if lexer.lex_kind(lx(p), i + 2) == A_LBRACE {
        return true
    }
    if i + 4 >= (*p).n {
        return false
    }
    if lexer.lex_kind(lx(p), i + 2) != A_KWFOR {
        return false
    }
    if lexer.lex_kind(lx(p), i + 3) != A_IDENT {
        return false
    }
    return lexer.lex_kind(lx(p), i + 4) == A_LBRACE
}

// The position AFTER the closing brace of the block at `i`. The search
// starts at the FIRST brace -- `impl T {` and `impl I for T {` (and
// `interface I {` too) are therefore the same case.
fn impl_end(p: *mut Parser, i: usize) -> usize {
    var k: usize = i + 2
    while k < (*p).n {
        if lexer.lex_kind(lx(p), k) == A_LBRACE {
            break
        }
        k = k + 1
    }
    var depth: usize = 0
    while k < (*p).n {
        let a: u32 = lexer.lex_kind(lx(p), k)
        if a == A_LBRACE {
            depth = depth + 1
        }
        if a == A_RBRACE {
            depth = depth - 1
            if depth == 0 {
                return k + 1
            }
        }
        k = k + 1
    }
    return k
}

// The receiver of a method: `self`, `*self` or `*mut self`.
// Firn has no references -- the receiver is written like any other
// parameter of the language (impls.rs, section "The receiver").
fn self_param(p: *mut Parser, tname0: u32) -> bool {
    var sw: [u8; 4] = "self"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let snr: u32 = intern.intern_number(it, (&sw[0]) as u64, 4) as u32
    // ROUND 46: for a `gc class` the receiver carries the INTERNAL struct
    // name `"gc K"` -- `*self` therefore becomes exactly `Gc[K]`. Whether `K`
    // is a class is known from the registry, which is filled during
    // parsing, so `gc class K` has to come BEFORE the `impl` block
    // (docs/ROUND46.md section 9). Literally as in impls.rs::self_param.
    var tname: u32 = tname0
    var class: bool = false
    if has_gc(p) && gc.gc_is_class(gr(p), tname0) {
        class = true
        rt.buf_clear(&(*p).scratch)
        var gw: [u8; 3] = "gc "
        rt.buf_push_bytes(&(*p).scratch, (&gw[0]) as u64, 3)
        rt.buf_push_bytes(&(*p).scratch, intern.intern_ptr(it, tname0),
            intern.intern_length(it, tname0))
        tname = intern.intern_number(it, rt.buf_ptr(&(*p).scratch),
            rt.buf_len(&(*p).scratch)) as u32
    }
    if actual(p, A_IDENT) && tok_nr(p, 0) == snr {
        if class {
            // a 'gc class' value only ever lives on the GC heap
            complain(p)
            return false
        }
        next_bump(p)
        let t: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tname, 0)
        ast.param_add(par_tree(p), snr, t)
        loc_add(p, snr)
        return true
    }
    if actual(p, A_STAR) {
        var m: u64 = 0
        var k: usize = 1
        if kind(p, 1) == A_KWMUT {
            m = 1
            k = 2
        }
        if kind(p, k) == A_IDENT && tok_nr(p, k) == snr {
            next_bump(p)
            if m == 1 {
                next_bump(p)
            }
            next_bump(p)
            let inner: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tname, 0)
            let t: u32 = ast.ty_new(par_tree(p), ast.T_PTR, inner, m)
            ast.param_add(par_tree(p), snr, t)
            loc_add(p, snr)
            return true
        }
    }
    // ROUND REF3: `&self` (read-only) and `inout self` (modifiable).
    var rk: u32 = 0
    if actual(p, A_AMP) && kind(p, 1) == A_IDENT && tok_nr(p, 1) == snr {
        rk = 1
    } else if at_inout(p) && kind(p, 1) == A_IDENT && tok_nr(p, 1) == snr {
        rk = 2
    }
    if rk != 0 {
        next_bump(p)
        next_bump(p)
        var m2: u64 = 0
        var fl: u32 = 0
        if rk == 2 {
            m2 = 1
            fl = 1
        }
        let inner2: u32 = ast.ty_new(par_tree(p), ast.T_NAME, tname, 0)
        let t2: u32 = ast.ty_new(par_tree(p), ast.T_PTR, inner2, m2)
        ast.param_add(par_tree(p), snr, t2)
        loc_add(p, snr)
        vec_push[u32](&(*p).rp_name, snr)
        vec_push[u32](&(*p).rp_flag, fl)
        return true
    }
    complain(p)
    return false
}

// A method becomes the ordinary function `Type__method`. After that it is
// nothing special any more -- the same type check, the same lowering.
fn methods_decl(p: *mut Parser, tname: u32) {
    let fn_at: u64 = at_pos(p, 0)
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let mnr: u32 = tok_nr(p, 0)
    next_bump(p)
    if actual(p, A_LBRACKET) {
        complain(p)
        return
    }
    var tr: [u8; 2] = "__"
    let name: u32 = join(p, tname, (&tr[0]) as u64, 2, mnr)
    if !expect(p, A_LPAREN) {
        return
    }
    loc_on(p)
    let poff: u32 = ast.param_start(par_tree(p))
    if !self_param(p, tname) {
        loc_off(p)
        return
    }
    if eat(p, A_COMMA) {
        (*p).defaults_ok = (*p).meth_defaults
        param_list(p)
        (*p).defaults_ok = 0
    }
    expect(p, A_RPAREN)
    let plen: u32 = ast.param_start(par_tree(p)) - poff
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            loc_off(p)
            return
        }
    }
    let saved_ret: u32 = (*p).cur_ret
    (*p).cur_ret = 0
    if ret != ast.NOTHING {
        (*p).cur_ret = ret + 1
    }
    var cx27: [u8; 33] = "at the start of the function body"
    let body: u32 = block_in(p, (&cx27[0]) as u64, 33)
    (*p).cur_ret = saved_ret
    loc_off(p)
    ast.fn_add(par_tree(p), name, poff, plen, ret, body, 0, 0, 0, 0, 0, 0, 0)
    ast.fn_pos_set(par_tree(p), ast.fn_count(par_tree(p)) - 1, fn_at)
}

// ROUND 46 (iface.rs::interface_decl): `interface I { fn m(*self) -> T ... }`.
// The block goes into the registry (`iface.fi`), NOT into the tree --
// interface names are visible program wide and are not renamed. Without a
// registry (astdump) the block is parsed correctly and then discarded.
fn interface_decl(p: *mut Parser) {
    next_bump(p)
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    var ii: u32 = NONE
    if has_if(p) {
        ii = iface.if_add(ifr(p), lexer.lex_names(lx(p)), name)
        if ii == NONE {
            // this interface is already declared
            complain(p)
            return
        }
    }
    if !expect(p, A_LBRACE) {
        return
    }
    while true {
        while eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_KWFN) {
            complain(p)
            break
        }
        if !interfaces_method(p, ii) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
}

// A method of the interface: `fn m(<receiver>[, param...]) [-> T]`
// -- WITHOUT a body. The receiver MUST be a pointer: through the table
// only the data pointer is available.
fn interfaces_method(p: *mut Parser, ii: u32) -> bool {
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return false
    }
    let mnr: u32 = tok_nr(p, 0)
    next_bump(p)
    if actual(p, A_LBRACKET) {
        complain(p)
        return false
    }
    if !expect(p, A_LPAREN) {
        return false
    }
    var sw: [u8; 4] = "self"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let snr: u32 = intern.intern_number(it, (&sw[0]) as u64, 4) as u32
    if !actual(p, A_STAR) {
        complain(p)
        return false
    }
    var k: usize = 1
    if kind(p, 1) == A_KWMUT {
        k = 2
    }
    if kind(p, k) != A_IDENT || tok_nr(p, k) != snr {
        complain(p)
        return false
    }
    next_bump(p)
    if k == 2 {
        next_bump(p)
    }
    next_bump(p)
    var ptypes: Vec[u32] = vec_new[u32]()
    if eat(p, A_COMMA) {
        while true {
            if actual(p, A_RPAREN) || at_end(p) {
                break
            }
            let before: usize = (*p).pos
            if !actual(p, A_IDENT) {
                complain(p)
                vec_free[u32](&ptypes)
                return false
            }
            next_bump(p)
            if !expect(p, A_COLON) {
                vec_free[u32](&ptypes)
                return false
            }
            let pt: u32 = ty(p)
            if pt == ast.NOTHING {
                vec_free[u32](&ptypes)
                return false
            }
            vec_push[u32](&ptypes, pt)
            if !eat(p, A_COMMA) {
                break
            }
            if (*p).pos == before {
                next_bump(p)
            }
        }
    }
    if !expect(p, A_RPAREN) {
        vec_free[u32](&ptypes)
        return false
    }
    var ret: u32 = ast.NOTHING
    if eat(p, A_ARROW) {
        ret = ty(p)
        if ret == ast.NOTHING {
            vec_free[u32](&ptypes)
            return false
        }
    }
    if actual(p, A_LBRACE) {
        // an interface method has no body
        complain(p)
        vec_free[u32](&ptypes)
        return false
    }
    // ROUND 50: does the signature mention `Self`? Then its types depend on
    // the implementing type and are resolved per implementation.
    var has_self: bool = false
    var hi: usize = 0
    while hi < vec_len[u32](&ptypes) {
        if iface.if_names_self(par_tree(p), lexer.lex_names(lx(p)),
            vec_at[u32](&ptypes, hi)) {
            has_self = true
        }
        hi = hi + 1
    }
    if iface.if_names_self(par_tree(p), lexer.lex_names(lx(p)), ret) {
        has_self = true
    }
    if ii != NONE {
        if !iface.if_method_add(ifr(p), ii, mnr, &ptypes, ret, has_self) {
            // this interface already has that method
            complain(p)
            vec_free[u32](&ptypes)
            return false
        }
    }
    vec_free[u32](&ptypes)
    return true
}

// ROUND 70 (impls.rs::impl_decl): `impl Ord for int` means
// `impl Ord for i32`. Only the SECOND spelling of a primitive type is
// folded onto the canonical one, so that exactly ONE method name
// (`i32__less`) can come into being; everything else passes through
// untouched. The two tables stand in the same order -- entry k of the one
// is entry k of the other (types.fi::alias_ty).
//
// ROUND 88: `string` is entry 13 and stands for `str`. This pair does NOT
// belong to `types.fi::alias_ty` (that one hands out primitive kinds, and
// `str` is a struct), but it belongs HERE: `impl Ord for string` has to
// create the same method as `impl Ord for str`, and this table works on
// NAMES, not on kind numbers. The empty places 8..10 (`usize`, `isize`,
// `bool`) keep their meaning -- a name is never empty, so they can never
// be hit.
fn canon_alias(p: *mut Parser, nr: u32) -> u32 {
    var from: [u8; 66] = "sbyte|short|int|long|byte|ushort|uint|ulong||||double|float|string"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let q: u64 = intern.intern_ptr(it, nr)
    let n: usize = intern.intern_length(it, nr)
    var i: usize = 0
    var k: i32 = 0
    var start: usize = 0
    while i <= 66 {
        var end: bool = i == 66
        if !end {
            end = from[i] == 124 as u8
        }
        if end {
            if i - start == n && n > 0 {
                if rt.mem_eq((&from[start]) as u64, q, n) {
                    return canon_at(it, k)
                }
            }
            k = k + 1
            start = i + 1
        }
        i = i + 1
    }
    return nr
}

// The k-th name of the canonical table as an interner number.
fn canon_at(it: *mut intern.Interner, k: i32) -> u32 {
    var to: [u8; 58] = "i8|i16|i32|i64|u8|u16|u32|u64|usize|isize|bool|f64|f32|str"
    var j: usize = 0
    var m: i32 = 0
    var start: usize = 0
    while j <= 58 {
        var end: bool = j == 58
        if !end {
            end = to[j] == 124 as u8
        }
        if end {
            if m == k {
                return intern.intern_number(it, (&to[start]) as u64, j - start) as u32
            }
            m = m + 1
            start = j + 1
        }
        j = j + 1
    }
    return 0
}

fn impl_decl(p: *mut Parser) {
    next_bump(p)
    let first: u32 = tok_nr(p, 0)
    next_bump(p)
    // ROUND 46 (iface.rs): `impl Interface for Type`. The block creates
    // THE SAME functions as `impl Type` -- the interface merely states
    // in addition what has to be there. The registry stores the type
    // name exactly as it appears in the source text (without a module
    // prefix): `firnc0` only has the raw name at this point either.
    var raw: u32 = first
    var is_for: bool = false
    if actual(p, A_KWFOR) {
        next_bump(p)
        if !actual(p, A_IDENT) {
            complain(p)
            return
        }
        raw = tok_nr(p, 0)
        next_bump(p)
        is_for = true
    }
    // HOOK alias: `impl Idx` with `type Idx = Point` is `impl Point`
    raw = alias_plain_name(p, raw)
    // ROUND 70: `int` -> `i32` BEFORE the module renaming.
    raw = canon_alias(p, raw)
    let tname: u32 = renamed(p, raw)
    if is_for && has_if(p) {
        iface.if_impl_add(ifr(p), first, raw)
    }
    (*p).meth_defaults = 1
    if is_for {
        (*p).meth_defaults = 0
    }
    if !expect(p, A_LBRACE) {
        return
    }
    while true {
        while eat(p, A_SEMI) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_KWFN) {
            complain(p)
            break
        }
        methods_decl(p, tname)
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
}

// `#[no_gc]`, `#[must_consume]`, `#[link_name(...)]` and `#[export_c]` --
// the implemented attributes (attrs.rs). `no_gc`/`must_consume`/
// `interrupt`/`allow_fp` take 0 arguments (parentheses are an error);
// `link_name` takes exactly 1 (an identifier); `export_c` takes 0.
// Any other name is caught by the prescan as not core beforehand.
fn attr(p: *mut Parser) {
    next_bump(p)
    var cx2: [u8; 9] = "after '#'"
    if !expect_in(p, A_LBRACKET, (&cx2[0]) as u64, 9) {
        return
    }
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    var an: [u8; 5] = "no_gc"
    var mc: [u8; 12] = "must_consume"
    // ROUND 52 (attrs.rs): `#[interrupt]` and `#[allow_fp]` (SPEC 2).
    var iw: [u8; 9] = "interrupt"
    var fw: [u8; 8] = "allow_fp"
    // ROUND 75 (attrs.rs, SPEC 14.5): `#[link_name(...)]` and `#[export_c]`.
    var ln: [u8; 9] = "link_name"
    var ec: [u8; 8] = "export_c"
    // ROUND 79 (attrs.rs): `#[allow_escape]` -- the way out of the escape
    // analysis, 0 arguments.
    var esw: [u8; 12] = "allow_escape"
    // ROUND 89 (attrs.rs, SPEC 13): `#[panic_handler]` -- this function
    // ends every panic, 0 arguments.
    var phw: [u8; 13] = "panic_handler"
    // ROUND 94 (attrs.rs, testrun.rs): `#[test]` -- a test case, 0 arguments.
    var tw: [u8; 4] = "test"
    // ROUND ARM-FREESTANDING (archsel.rs): `#[arch(x86_64)]` -- this
    // definition belongs to ONE machine. Exactly one argument, an identifier.
    var arw: [u8; 4] = "arch"
    // ROUND FUI-ALL (attrs.rs, round EINBETTEN): `#[inline]` and
    // `#[no_inline]` -- hints for firnc0's inliner, 0 arguments. This stage
    // does not inline across functions, so both are accepted and leave
    // nothing in the tree; before, a file with either one made the whole
    // program "not core" (exit 3, no message), which is how fUi's canvas.fi
    // kept every fUi program away from firnc1 (fUi r90).
    var inw: [u8; 6] = "inline"
    var niw: [u8; 9] = "no_inline"
    var pkw: [u8; 6] = "packed"
    var alw: [u8; 5] = "align"
    let it: *mut intern.Interner = lexer.lex_names(lx(p))
    let is_pk: bool = intern.intern_equal(it, tok_nr(p, 0), (&pkw[0]) as u64, 6)
    let is_al: bool = intern.intern_equal(it, tok_nr(p, 0), (&alw[0]) as u64, 5)
    let is_inl: bool = intern.intern_equal(it, tok_nr(p, 0), (&inw[0]) as u64, 6) ||
    intern.intern_equal(it, tok_nr(p, 0), (&niw[0]) as u64, 9)
    let is_nogc: bool = intern.intern_equal(it, tok_nr(p, 0), (&an[0]) as u64, 5)
    let is_mc: bool = intern.intern_equal(it, tok_nr(p, 0), (&mc[0]) as u64, 12)
    let is_int: bool = intern.intern_equal(it, tok_nr(p, 0), (&iw[0]) as u64, 9)
    let is_fp: bool = intern.intern_equal(it, tok_nr(p, 0), (&fw[0]) as u64, 8)
    let is_link: bool = intern.intern_equal(it, tok_nr(p, 0), (&ln[0]) as u64, 9)
    let is_export: bool = intern.intern_equal(it, tok_nr(p, 0), (&ec[0]) as u64, 8)
    let is_esc: bool = intern.intern_equal(it, tok_nr(p, 0), (&esw[0]) as u64, 12)
    let is_ph: bool = intern.intern_equal(it, tok_nr(p, 0), (&phw[0]) as u64, 13)
    let is_test: bool = intern.intern_equal(it, tok_nr(p, 0), (&tw[0]) as u64, 4)
    let is_arch: bool = intern.intern_equal(it, tok_nr(p, 0), (&arw[0]) as u64, 4)
    if !is_nogc && !is_mc && !is_int && !is_fp && !is_link && !is_export && !is_esc && !is_ph
    && !is_test && !is_arch && !is_inl && !is_pk && !is_al {
        complain(p)
        return
    }
    next_bump(p)
    if is_arch {
        if !expect(p, A_LPAREN) {
            return
        }
        if !actual(p, A_IDENT) {
            complain(p)
            return
        }
        // The name of THIS machine. Everything else is another machine and
        // the declaration behind it is thrown away in `fn_decl`.
        var xw: [u8; 6] = "x86_64"
        var aw: [u8; 7] = "aarch64"
        let mine: bool = intern.intern_equal(it, tok_nr(p, 0), (&xw[0]) as u64, 6)
        let other: bool = intern.intern_equal(it, tok_nr(p, 0), (&aw[0]) as u64, 7)
        if !mine && !other {
            // An unknown machine name is an ERROR and not a silent removal
            // -- the same rule firnc0 follows (archsel.rs).
            complain(p)
            return
        }
        if mine {
            (*p).arch_pending = 1
        } else {
            (*p).arch_pending = 2
        }
        next_bump(p)
        if !expect(p, A_RPAREN) {
            return
        }
    } else if is_al {
        if !expect(p, A_LPAREN) {
            return
        }
        if !actual(p, A_INT) {
            complain(p)
            return
        }
        let av: u64 = number(p)
        next_bump(p)
        if av == 0 || av > 4096 || (av & (av - 1)) != 0 || ((*p).lay_pending >> 8) != 0 {
            complain(p)
            return
        }
        (*p).lay_pending = (*p).lay_pending | ((av as u32) << 8)
        if !expect(p, A_RPAREN) {
            return
        }
    } else if is_link {
        if !expect(p, A_LPAREN) {
            return
        }
        if !actual(p, A_IDENT) {
            complain(p)
            return
        }
        (*p).link_pending = tok_nr(p, 0)
        (*p).link_pending_set = true
        next_bump(p)
        if !expect(p, A_RPAREN) {
            return
        }
    } else if actual(p, A_LPAREN) {
        complain(p)
        return
    }
    if !expect(p, A_RBRACKET) {
        return
    }
    if is_mc {
        (*p).mc_pending = 1
    } else if is_pk {
        (*p).lay_pending = (*p).lay_pending | 2
    } else if is_al {
        // recorded above
    } else if is_int {
        (*p).int_pending = 1
    } else if is_ph {
        (*p).ph_pending = 1
    } else if is_inl {
        // A hint only (see above): nothing to record.
    } else if is_test {
        // ROUND 94: `#[test]` marks a case for `firnc --test`. This stage has
        // no test mode, so nothing of it is left in the tree -- the function
        // is compiled like any other.
    } else if is_fp {
        // `#[allow_fp]` allows floating point in the kernel profile; nothing
        // of it is left in the tree, because this stage does not enforce the
        // profile bans (docs/ROUND52.md, "Open points").
    } else if is_link {
        // `link_pending` is already set above.
    } else if is_export {
        (*p).export_pending = 1
    } else if is_esc {
        (*p).esc_pending = 1
    } else {
        (*p).nogc_pending = 1
    }
}

// `gc class IDENT [extends Base] { field: Type, ... }` (gc_class_decl in
// gc.rs). The class goes into the registry (`gc.fi`), NOT into the
// tree -- class names are visible program wide and are not renamed.
fn gc_class_decl(p: *mut Parser) {
    next_bump(p)
    next_bump(p)
    if !actual(p, A_IDENT) {
        complain(p)
        return
    }
    let name: u32 = tok_nr(p, 0)
    next_bump(p)
    var base: u32 = 0
    if actual(p, A_IDENT) {
        var ew: [u8; 7] = "extends"
        let it: *mut intern.Interner = lexer.lex_names(lx(p))
        if intern.intern_equal(it, tok_nr(p, 0), (&ew[0]) as u64, 7) {
            next_bump(p)
            if !actual(p, A_IDENT) {
                complain(p)
                return
            }
            base = tok_nr(p, 0)
            next_bump(p)
            if actual(p, A_COMMA) {
                // multiple inheritance is not allowed (SPEC 4.4)
                complain(p)
                return
            }
        }
    }
    if !expect(p, A_LBRACE) {
        return
    }
    let ki: u32 = gc.gc_class_add(gr(p), name)
    if ki == NONE {
        // this 'gc class ...' is already declared
        complain(p)
        return
    }
    if base != 0 {
        gc.gc_base_set(gr(p), ki, base)
    }
    while true {
        while eat(p, A_COMMA) {}
        if actual(p, A_RBRACE) || at_end(p) {
            break
        }
        let before: usize = (*p).pos
        if !actual(p, A_IDENT) {
            complain(p)
            break
        }
        let fname: u32 = tok_nr(p, 0)
        next_bump(p)
        if !expect(p, A_COLON) {
            break
        }
        let ft: u32 = ty(p)
        if ft == ast.NOTHING {
            break
        }
        if !gc.gc_field_add(gr(p), ki, fname, ft) {
            // this field is already declared
            complain(p)
        }
        if !eat(p, A_COMMA) {
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    expect(p, A_RBRACE)
}

fn par_run(p: *mut Parser) {
    if has_gen(p) {
        var so: [u8; 7] = "size_of"
        (*p).sonr = intern.intern_find(lexer.lex_names(lx(p)), (&so[0]) as u64, 7)
        var hg: [u8; 6] = "has_gc"
        (*p).hgnr = intern.intern_find(lexer.lex_names(lx(p)), (&hg[0]) as u64, 6)
        var gt: [u8; 8] = "gc_track"
        (*p).gtnr = intern.intern_find(lexer.lex_names(lx(p)), (&gt[0]) as u64, 8)
        var gu: [u8; 10] = "gc_untrack"
        (*p).gunr = intern.intern_find(lexer.lex_names(lx(p)), (&gu[0]) as u64, 10)
    }
    extensions_search(p)
    own_search(p)
    if (*p).not_core {
        return
    }
    module_upfront(p)
    // HOOK alias: read the `type X = T` declarations of this file up front
    alias_search(p)
    while true {
        while eat(p, A_SEMI) {}
        if at_end(p) {
            break
        }
        if (*p).err > 0 {
            break
        }
        let before: usize = (*p).pos
        let a: u32 = kind(p, 0)
        // `#[no_gc]` belongs in front of a FUNCTION (attrs.rs, Target::Func),
        // `#[must_consume]` in front of either (attrs.rs, Target::Both), round 36.
        if (*p).nogc_pending == 1 && a != A_KWFN && a != A_KWEXTERN && a != A_HASH {
            complain(p)
            (*p).nogc_pending = 0
        }
        if (*p).lay_pending != 0 && a != A_KWSTRUCT && a != A_HASH {
            complain(p)
            (*p).lay_pending = 0
        }
        if (*p).mc_pending == 1 && a != A_KWFN && a != A_KWEXTERN && a != A_KWSTRUCT && a != A_HASH {
            complain(p)
            (*p).mc_pending = 0
        }
        // ROUND 75: `#[link_name(...)]` and `#[export_c]` belong in front
        // of a function (or another attribute) exactly like `#[no_gc]`.
        if (*p).link_pending_set && a != A_KWFN && a != A_KWEXTERN && a != A_HASH {
            complain(p)
            (*p).link_pending = 0
            (*p).link_pending_set = false
        }
        if (*p).export_pending == 1 && a != A_KWFN && a != A_KWEXTERN && a != A_HASH {
            complain(p)
            (*p).export_pending = 0
        }
        // ROUND ARM-FREESTANDING: `#[arch(...)]` belongs in front of a
        // function, exactly like `#[no_gc]` (attrs.rs: Target::Func).
        if (*p).arch_pending > 0 && a != A_KWFN && a != A_KWEXTERN && a != A_HASH {
            complain(p)
            (*p).arch_pending = 0
        }
        if a == A_HASH && has_gc(p) {
            // `#[no_gc]` in front of a function (round 34, SPEC 3.5.4),
            // `#[must_consume]` in front of a function or struct (round 36).
            // Other attributes are caught by the prescan as not core.
            attr(p)
        } else if a == A_IDENT && has_gc(p) && is_gc_class(p) {
            gc_class_decl(p)
        } else if a == A_IDENT && alias_head_at(p, (*p).pos) != 0 {
            alias_item(p)
        } else if a == A_IDENT && is_interface(p) {
            interface_decl(p)
        } else if a == A_IDENT && is_impl(p) {
            impl_decl(p)
        } else if a == A_KWFN || a == A_KWEXTERN {
            fn_decl(p)
        } else if a == A_KWSTRUCT {
            struct_decl(p)
        } else if a == A_KWENUM && has_mu(p) {
            enum_decl(p)
        } else if a == A_KWERROR && has_fe(p) {
            error_decl(p)
        } else if a == A_KWCOMPTIME && has_time(p) {
            comptime_decl(p)
        } else if a == A_KWCONST {
            const_decl(p)
        } else if a == A_KWSTATIC {
            static_decl(p)
        } else if a == A_KWPROFILE {
            profile_decl(p)
        } else if a == A_KWIMPORT {
            import_decl(p)
        } else if a == A_KWEXPORT {
            export_decl(p)
        } else {
            // Everything left over is one of the extensions that are not
            // ported (`enum`, `error`, `gc class`, `comptime`, attributes) or is
            // simply wrong.
            // An IDENTIFIER at the top level can only be a hook in
            // stage 0 -- `gc class C { ... }`. Like `enum`, `error`,
            // `comptime` and the attributes, it is one of the extensions
            // that are not ported.
            if a == A_KWENUM || a == A_KWERROR || a == A_KWCOMPTIME || a == A_HASH || a == A_IDENT {
                (*p).not_core = true
            }
            var pr1: [u8; 100] = "expected 'fn', 'struct', 'const', 'static', 'comptime', 'import', 'export' or 'profile' at top level"
            complain_found(p, (&pr1[0]) as u64, 100)
            break
        }
        if (*p).pos == before {
            next_bump(p)
        }
    }
    if vec_len[u32](&(*p).hoist) > 0 {
        // f"..." at ITEM level (say inside a `const`): there is no
        // statement in front of which the text segments could be hoisted.
        complain(p)
    }
}

// ------------------------------------------------------------ __include_str
//
// ROUND FUI-ALL, the stage-1 half of compiler/src/include.rs. The path is
// taken RELATIVE TO THE DIRECTORY OF THE FILE BEING PARSED -- the same rule
// as firnc0 -- and the file's bytes become an ordinary text literal, so
// everything after the parser sees `"...contents..."`. Before this, a file
// that used it made the whole program "not core" (exit 3), and fUi's
// gpu.fi (the shader sources) uses it: no fUi program could be built by
// firnc1 (fUi r90).
fn is_include_str(p: *mut Parser) -> bool {
    var incw: [u8; 13] = "__include_str"
    return intern.intern_equal(lexer.lex_names(lx(p)), tok_nr(p, 0),
        (&incw[0]) as u64, 13)
}

fn include_str(p: *mut Parser) -> u32 {
    next_bump(p) // __include_str
    next_bump(p) // (
    let k: usize = tok_nr(p, 0) as usize
    var path: rt.Buf = rt.buf_new()
    defer rt.buf_free(&path)
    // the directory of the current file, with its slash
    var fname: rt.Buf = rt.buf_new()
    defer rt.buf_free(&fname)
    lexer.lex_file_name(lx(p), &fname)
    let fp: u64 = rt.buf_ptr(&fname)
    var cut: usize = 0
    var j: usize = 0
    while j < rt.buf_len(&fname) {
        if *((fp + j as u64) as *mut u8) == 47 as u8 {
            cut = j + 1
        }
        j = j + 1
    }
    let n: usize = lexer.lex_lit_len(lx(p), k)
    var abs: bool = false
    if n > 0 && lexer.lex_lit_byte(lx(p), k, 0) == 47 as u8 {
        abs = true
    }
    if !abs {
        rt.buf_push_bytes(&path, fp, cut)
    }
    var i: usize = 0
    while i < n {
        rt.buf_push(&path, lexer.lex_lit_byte(lx(p), k, i))
        i = i + 1
    }
    rt.buf_push(&path, 0 as u8)
    next_bump(p) // "file"
    expect(p, A_RPAREN)
    var body: rt.Buf = rt.buf_new()
    defer rt.buf_free(&body)
    if !rt.read_file(rt.buf_ptr(&path), &body) {
        complain(p)
        return ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0, 0)
    }
    var tmp: Vec[u32] = vec_new[u32]()
    let bp: u64 = rt.buf_ptr(&body)
    let bn: usize = rt.buf_len(&body)
    var q: usize = 0
    while q < bn {
        vec_push[u32](&tmp, ast.expr_new(par_tree(p), ast.E_INT, 0, 0, 0,
                (*((bp + q as u64) as *mut u8)) as u64))
        q = q + 1
    }
    let off: u32 = list_store(p, &tmp)
    vec_free[u32](&tmp)
    let alit: u32 = ast.expr_new(par_tree(p), ast.E_ALIT, 0, off, bn as u32, 0)
    return ast.expr_new(par_tree(p), ast.E_TEXT, alit, 0, 0, 0)
}
