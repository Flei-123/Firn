// SPDX-License-Identifier: MPL-2.0

import rt
import vec
import ast
import diag

export { Pend, pend_new, pend_free, pend_add, pend_count, pend_render, pend_mark_typed, pend_is_typed }

struct Pend {
    pos: Vec[u64],
    len: Vec[u32],
    off: Vec[u32],
    msg_len: Vec[u32],
    txt: rt.Buf,
    typed: bool,
}

fn pend_new() -> Pend {
    return Pend {
        pos: vec_new[u64](), len: vec_new[u32](),
        off: vec_new[u32](), msg_len: vec_new[u32](),
        txt: rt.buf_new(), typed: false,
    }
}

fn pend_free(d: *mut Pend) {
    vec_free[u64](&(*d).pos)
    vec_free[u32](&(*d).len)
    vec_free[u32](&(*d).off)
    vec_free[u32](&(*d).msg_len)
    rt.buf_free(&(*d).txt)
}

fn pend_count(d: *mut Pend) -> usize { return vec_len[u64](&(*d).pos) }

fn pend_mark_typed(d: *mut Pend) { (*d).typed = true }

fn pend_is_typed(d: *mut Pend) -> bool { return (*d).typed }

fn pend_add(d: *mut Pend, pos: u64, length: u32, msg: *mut rt.Buf) {
    vec_push[u64](&(*d).pos, pos)
    vec_push[u32](&(*d).len, length)
    vec_push[u32](&(*d).off, rt.buf_len(&(*d).txt) as u32)
    vec_push[u32](&(*d).msg_len, rt.buf_len(msg) as u32)
    rt.buf_push_bytes(&(*d).txt, rt.buf_ptr(msg), rt.buf_len(msg))
}

fn pend_render(d: *mut Pend, tree: *mut ast.Tree, out: *mut rt.Buf) {
    var dg: diag.Diags = diag.diag_new()
    var src_ptr: Vec[u64] = vec_new[u64]()
    var src_len: Vec[u64] = vec_new[u64]()
    var src_file: Vec[u32] = vec_new[u32]()
    var src_nr: Vec[u32] = vec_new[u32]()
    var path: rt.Buf = rt.buf_new()
    var text: rt.Buf = rt.buf_new()
    let none: u32 = 4294967295

    var i: usize = 0
    while i < pend_count(d) {
        let pos: u64 = vec_at[u64](&(*d).pos, i)
        let file: u32 = ast.pos_file(pos)
        var nr: u32 = none
        var k: usize = 0
        while k < vec_len[u32](&src_file) {
            if vec_at[u32](&src_file, k) == file {
                nr = vec_at[u32](&src_nr, k)
            }
            k = k + 1
        }
        if nr == none {
            var fp: u64 = 0
            var name_n: usize = 0
            if (file as usize) < ast.file_count(tree) {
                fp = ast.file_ptr(tree, file)
                name_n = ast.file_length(tree, file)
            }
            rt.buf_clear(&path)
            rt.buf_push_bytes(&path, fp, name_n)
            rt.buf_push(&path, 0 as u8)
            rt.buf_clear(&text)
            var sp: u64 = 0
            var sn: usize = 0
            if rt.read_file(rt.buf_ptr(&path), &text) {
                sn = rt.buf_len(&text)
                sp = rt.heap_alloc(sn + 1)
                if sp != 0 {
                    rt.mem_copy(sp, rt.buf_ptr(&text), sn)
                } else {
                    sn = 0
                }
            }
            nr = diag.diag_file(&dg, fp, name_n, sp, sn)
            vec_push[u64](&src_ptr, sp)
            vec_push[u64](&src_len, sn as u64)
            vec_push[u32](&src_file, file)
            vec_push[u32](&src_nr, nr)
        }
        diag.diag_error(&dg, nr, ast.pos_line(pos), ast.pos_col(pos),
            vec_at[u32](&(*d).len, i),
            rt.buf_ptr(&(*d).txt) + vec_at[u32](&(*d).off, i) as u64,
            vec_at[u32](&(*d).msg_len, i) as usize)
        i = i + 1
    }

    diag.diag_render(&dg, out)

    i = 0
    while i < vec_len[u64](&src_ptr) {
        let sp2: u64 = vec_at[u64](&src_ptr, i)
        if sp2 != 0 {
            rt.heap_free(sp2, vec_at[u64](&src_len, i) as usize + 1)
        }
        i = i + 1
    }
    vec_free[u64](&src_ptr)
    vec_free[u64](&src_len)
    vec_free[u32](&src_file)
    vec_free[u32](&src_nr)
    rt.buf_free(&path)
    rt.buf_free(&text)
    diag.diag_free(&dg)
}
