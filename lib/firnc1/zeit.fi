// lib/firnc1/zeit.fi — DER COMPTIME-INTERPRETER (Runde 35).
//
// Portierung von `compiler/src/comptime.rs`: fuehrt `comptime { ... }`-Bloecke
// zur UEBERSETZUNGSZEIT aus. Was sie per `emit_roh`/`emit_zahl` schreiben, ist
// FIRN-QUELLTEXT, den derselbe Lauf lexen, parsen und ans Programm anhaengen
// kann — danach sieht der Typpruefer keinen Unterschied zu handgeschriebenem
// Quelltext (SPEC §6.4, Abnahmepunkt 6).
//
// UMFANG (wie Stufe 0): Ganzzahlen und bool; let/var, Zuweisung an lokale
// Namen, if/else, while, for, break, continue, return, Bloecke; alle
// Operatoren mit Kurzschluss bei &&/||; Aufrufe weiterer Funktionen des
// Programms (auch rekursiv); die Intrinsics `emit_roh`, `emit_zahl`,
// `datei_groesse`, `datei_byte`.
//
// GRENZEN (wie Stufe 0): hoechstens MAX_SCHRITTE ausgefuehrte Anweisungen und
// MAX_TIEFE verschachtelte Aufrufe — ein comptime darf den Compiler nicht
// aufhaengen. Keine Zeiger, Arrays, Structs, syscall, Gleitkomma.
//
// UNTERSCHIEDE ZU STUFE 0, ehrlich benannt:
//   * Werte sind i64, nicht i128 — Verschiebeweiten gelten 0..63.
//   * `x as T` reicht den Wert durch: Stufe 0 liest den Zieltyp aus den
//     Typangaben des Typpruefers, die beim Blocklauf noch LEER sind, und
//     faellt dort ebenfalls auf i64 zurueck (comptime.rs, ExprKind::Cast).
//   * `emit_roh` prueft kein UTF-8 — ungueltige Oktette meldet der Lexer des
//     erzeugten Textes eine Stufe spaeter, mit besserer Ortsangabe.
//
// SICHERHEIT (DESIGNZIELE §3, Lieferkette): `datei_*` liest NUR relativ zur
// Wurzelquelldatei — kein absoluter Pfad, kein `..` als Pfadteil.

import rt
import vec
import intern
import ast

export { Zeit, zeit_neu, zeit_frei, zeit_lauf, zeit_fehler, zeit_ausgabe }

const MAX_SCHRITTE: u64 = 2000000
const MAX_TIEFE: i64 = 64

// Ergebnis einer ausgefuehrten Anweisung (Fluss in comptime.rs).
const F_WEITER: u32 = 0
const F_RET: u32 = 1
const F_BREAK: u32 = 2
const F_CONT: u32 = 3

// Unäre Operatoren (parser.fi)
const U_NEG: u32 = 0
const U_NOT: u32 = 1

// Binäre Operatoren (parser.fi)
const B_ADD: u32 = 0
const B_SUB: u32 = 1
const B_MUL: u32 = 2
const B_DIV: u32 = 3
const B_REM: u32 = 4
const B_AND: u32 = 5
const B_OR: u32 = 6
const B_XOR: u32 = 7
const B_SHL: u32 = 8
const B_SHR: u32 = 9
const B_EQ: u32 = 10
const B_NE: u32 = 11
const B_LT: u32 = 12
const B_LE: u32 = 13
const B_GT: u32 = 14
const B_GE: u32 = 15
const B_LAND: u32 = 16
const B_LOR: u32 = 17

struct Zeit {
    baum: u64,           // *mut ast.Baum
    it: u64,             // *mut intern.Interner
    ausgabe: rt.Buf,     // der per emit_* aufgebaute Quelltext
    basis: rt.Buf,       // Verzeichnis der Wurzelquelldatei (mit Schraegstrich)
    schritte: u64,
    ret: i64,            // Rueckgabewert, wenn der Fluss F_RET ist
    fehler: usize,
    // UMGEBUNG: ein flacher Stapel aus (Name, Wert); `fgrenze` merkt die
    // Anfaenge der Bereiche. Gesucht wird von oben nach unten — ein neuerer
    // Eintrag desselben Namens verdeckt den aelteren (wie die HashMap-Stapel
    // in comptime.rs).
    uname: Vec[u32],
    uwert: Vec[i64],
    fgrenze: Vec[u32],
    // DATEI-ZWISCHENSPEICHER: einmal gelesen, danach Byte fuer Byte aus
    // `dalle`. Namen und Inhalte liegen je in EINEM Puffer (nur angehaengt,
    // nie veraendert — darum genuegen Versatz und Laenge).
    dnamen: rt.Buf,
    doff: Vec[u32],
    dlen: Vec[u32],
    dalle: rt.Buf,
    ioff: Vec[u32],
    ilen: Vec[u32],
    // Namensnummern der Intrinsics, einmal beim Anlegen besorgt.
    n_emit_roh: u32,
    n_emit_zahl: u32,
    n_groesse: u32,
    n_byte: u32,
}

fn zeit_neu(baum: u64, it: u64, basis: u64, basis_n: usize) -> Zeit {
    var z: Zeit = Zeit{
        baum: baum, it: it,
        ausgabe: rt.buf_neu(), basis: rt.buf_neu(),
        schritte: 0, ret: 0, fehler: 0,
        uname: vec_neu[u32](), uwert: vec_neu[i64](), fgrenze: vec_neu[u32](),
        dnamen: rt.buf_neu(), doff: vec_neu[u32](), dlen: vec_neu[u32](),
        dalle: rt.buf_neu(), ioff: vec_neu[u32](), ilen: vec_neu[u32](),
        n_emit_roh: 0, n_emit_zahl: 0, n_groesse: 0, n_byte: 0,
    }
    rt.buf_push_bytes(&z.basis, basis, basis_n)
    let ip: *mut intern.Interner = it as *mut intern.Interner
    var w1: [u8; 8] = "emit_roh"
    var w2: [u8; 9] = "emit_zahl"
    var w3: [u8; 13] = "datei_groesse"
    var w4: [u8; 10] = "datei_byte"
    z.n_emit_roh = intern.intern_nummer(ip, (&w1[0]) as u64, 8) as u32
    z.n_emit_zahl = intern.intern_nummer(ip, (&w2[0]) as u64, 9) as u32
    z.n_groesse = intern.intern_nummer(ip, (&w3[0]) as u64, 13) as u32
    z.n_byte = intern.intern_nummer(ip, (&w4[0]) as u64, 10) as u32
    return z
}

fn zeit_frei(z: *mut Zeit) {
    rt.buf_frei(&(*z).ausgabe)
    rt.buf_frei(&(*z).basis)
    vec_frei[u32](&(*z).uname)
    vec_frei[i64](&(*z).uwert)
    vec_frei[u32](&(*z).fgrenze)
    rt.buf_frei(&(*z).dnamen)
    vec_frei[u32](&(*z).doff)
    vec_frei[u32](&(*z).dlen)
    rt.buf_frei(&(*z).dalle)
    vec_frei[u32](&(*z).ioff)
    vec_frei[u32](&(*z).ilen)
}

fn zeit_fehler(z: *mut Zeit) -> usize { return (*z).fehler }
fn zeit_ausgabe(z: *mut Zeit) -> *mut rt.Buf { return &(*z).ausgabe }

// Meldet einen Fehler: "comptime: <msg>" auf stderr, dann zaehlen. Stufe 0
// meldet die Quellposition mit; der Baum dieser Stufe fuehrt keine
// Positionen, also bleibt es bei der Meldung.
fn kaputt(z: *mut Zeit, msg: u64, n: usize) {
    if (*z).fehler == 0 {
        var kopf: [u8; 10] = "comptime: "
        rt.schreib_alles(2, (&kopf[0]) as u64, 10)
        rt.schreib_alles(2, msg, n)
        var nl: [u8; 1] = "\n"
        rt.schreib_alles(2, (&nl[0]) as u64, 1)
    }
    (*z).fehler = (*z).fehler + 1
}

// ------------------------------------------------------------ Umgebung

fn frame_auf(z: *mut Zeit) {
    vec_push[u32](&(*z).fgrenze, vec_len[u32](&(*z).uname) as u32)
}

// Kein `vec_kuerzen` in der Laufzeit (lib/rt/vec.fi) — mit `vec_pop` bis zur
// Zielgroesse nachgebaut. Der Bereich schrumpft immer nur um den, den
// `frame_auf` gerade aufgemacht hat, also ist das kein unbeschraenktes Loop.
fn frame_zu(z: *mut Zeit) {
    let anfang: u32 = vec_at[u32](&(*z).fgrenze, vec_len[u32](&(*z).fgrenze) - 1)
    while vec_len[u32](&(*z).uname) > anfang as usize {
        vec_pop[u32](&(*z).uname)
        vec_pop[i64](&(*z).uwert)
    }
    vec_pop[u32](&(*z).fgrenze)
}

fn setz_lokal(z: *mut Zeit, name: u32, wert: i64) {
    vec_push[u32](&(*z).uname, name)
    vec_push[i64](&(*z).uwert, wert)
}

// Sucht von OBEN nach UNTEN (neuester Stand zuerst) und liefert den Platz in
// `uwert`, oder -1.
fn slot_suchen(z: *mut Zeit, name: u32) -> i64 {
    var i: i64 = vec_len[u32](&(*z).uname) as i64 - 1
    while i >= 0 {
        if vec_at[u32](&(*z).uname, i as usize) == name {
            return i
        }
        i = i - 1
    }
    return -1
}

// ------------------------------------------------------------- Dateien

// Liest eine Datendatei — EINMAL, danach aus dem Zwischenspeicher. Liefert
// den Platz in ioff/ilen, oder -1 (Fehler ist dann schon gemeldet).
//
// SICHERHEIT (DESIGNZIELE §3): nur RELATIV zur Wurzelquelldatei, kein
// absoluter Pfad, kein `..` als Pfadteil — eine eingebundene Bibliothek darf
// beim Bauen nicht aus dem Verzeichnis ausbrechen.
fn lies_datei(z: *mut Zeit, pfad: u64, n: usize) -> i64 {
    var m1: [u8; 47] = "leerer dateiname                               "
    if n == 0 {
        kaputt(z, (&m1[0]) as u64, 15)
        return -1
    }
    if rt.ld8(pfad, 0) == 47 as u8 {
        var m2: [u8; 64] = "absoluter pfad — erlaubt sind nur pfade relativ zur quelldatei"
        kaputt(z, (&m2[0]) as u64, 63)
        return -1
    }
    if rt.ld8(pfad, 0) == 92 as u8 {
        var m2b: [u8; 64] = "absoluter pfad — erlaubt sind nur pfade relativ zur quelldatei"
        kaputt(z, (&m2b[0]) as u64, 63)
        return -1
    }
    // `..` als ganzer Pfadteil ist verboten (Teil von `a..b` ist erlaubt).
    var i: usize = 0
    while i < n {
        var j: usize = i
        while j < n {
            if rt.ld8(pfad, j) == 47 as u8 {
                break
            }
            j = j + 1
        }
        if j - i == 2 {
            if rt.ld8(pfad, i) == 46 as u8 {
                if rt.ld8(pfad, i + 1) == 46 as u8 {
                    var m3: [u8; 65] = "'..' im pfad — der zugriff bleibt im verzeichnis der quelldatei"
                    kaputt(z, (&m3[0]) as u64, 62)
                    return -1
                }
            }
        }
        i = j + 1
    }
    // Schon gelesen?
    var k: usize = 0
    while k < vec_len[u32](&(*z).doff) {
        if vec_at[u32](&(*z).dlen, k) as usize == n {
            let anf: u64 = rt.buf_ptr(&(*z).dnamen) + vec_at[u32](&(*z).doff, k) as u64
            if rt.mem_eq(anf, pfad, n) {
                return k as i64
            }
        }
        k = k + 1
    }
    // Lesen: <basis><pfad>\0
    var voll: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&voll)
    rt.buf_push_bytes(&voll, rt.buf_ptr(&(*z).basis), rt.buf_len(&(*z).basis))
    rt.buf_push_bytes(&voll, pfad, n)
    rt.buf_push(&voll, 0 as u8)
    var inhalt: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&inhalt)
    if !rt.lies_datei(rt.buf_ptr(&voll), &inhalt) {
        var m4: [u8; 18] = "datei nicht lesbar"
        kaputt(z, (&m4[0]) as u64, 18)
        return -1
    }
    let platz: u32 = vec_len[u32](&(*z).doff) as u32
    vec_push[u32](&(*z).doff, rt.buf_len(&(*z).dnamen) as u32)
    vec_push[u32](&(*z).dlen, n as u32)
    rt.buf_push_bytes(&(*z).dnamen, pfad, n)
    vec_push[u32](&(*z).ioff, rt.buf_len(&(*z).dalle) as u32)
    vec_push[u32](&(*z).ilen, rt.buf_len(&inhalt) as u32)
    rt.buf_push_bytes(&(*z).dalle, rt.buf_ptr(&inhalt), rt.buf_len(&inhalt))
    return platz as i64
}

// --------------------------------------------------------- Ausdruecke

fn rechne(z: *mut Zeit, op: u32, a: i64, b: i64) -> i64 {
    if op == B_ADD { return a + b }
    if op == B_SUB { return a - b }
    if op == B_MUL { return a * b }
    if op == B_DIV {
        if b == 0 {
            var m: [u8; 19] = "division durch null"
            kaputt(z, (&m[0]) as u64, 19)
            return 0
        }
        return a / b
    }
    if op == B_REM {
        if b == 0 {
            var m: [u8; 28] = "rest bei division durch null"
            kaputt(z, (&m[0]) as u64, 28)
            return 0
        }
        return a % b
    }
    if op == B_AND { return a & b }
    if op == B_OR { return a | b }
    if op == B_XOR { return a ^ b }
    if op == B_SHL {
        if b < 0 { return versatz_fehler(z) }
        if b > 63 { return versatz_fehler(z) }
        return a << b as u64
    }
    if op == B_SHR {
        if b < 0 { return versatz_fehler(z) }
        if b > 63 { return versatz_fehler(z) }
        return a >> b as u64
    }
    if op == B_EQ { if a == b { return 1 } return 0 }
    if op == B_NE { if a != b { return 1 } return 0 }
    if op == B_LT { if a < b { return 1 } return 0 }
    if op == B_LE { if a <= b { return 1 } return 0 }
    if op == B_GT { if a > b { return 1 } return 0 }
    if op == B_GE { if a >= b { return 1 } return 0 }
    if op == B_LAND { if a != 0 { if b != 0 { return 1 } } return 0 }
    if op == B_LOR { if a != 0 { return 1 } if b != 0 { return 1 } return 0 }
    var m: [u8; 20] = "unbekannter operator"
    kaputt(z, (&m[0]) as u64, 20)
    return 0
}

fn versatz_fehler(z: *mut Zeit) -> i64 {
    var m: [u8; 32] = "verschiebeweite ausserhalb 0..63"
    kaputt(z, (&m[0]) as u64, 32)
    return 0
}

// Der Text eines Zeichenkettenliterals: der Parser hat "abc" bereits in ein
// Array-Literal aus Oktetten verwandelt (Runde 8) — hier wird es
// zurueckgelesen. Darum braucht `emit_roh` keine Zeichenketten im Interpreter.
fn literal_text(z: *mut Zeit, e: u32, aus: *mut rt.Buf) -> bool {
    let b: *mut ast.Baum = (*z).baum as *mut ast.Baum
    if ast.e_art(b, e) != ast.E_ALIT {
        var m: [u8; 33] = "erwartet ein zeichenkettenliteral"
        kaputt(z, (&m[0]) as u64, 33)
        return false
    }
    let off: u32 = ast.e_b(b, e)
    let n: u32 = ast.e_c(b, e)
    var i: u32 = 0
    while i < n {
        let k: u32 = ast.kind_at(b, off + i)
        if ast.e_art(b, k) != ast.E_INT {
            var m2: [u8; 33] = "erwartet ein zeichenkettenliteral"
            kaputt(z, (&m2[0]) as u64, 33)
            return false
        }
        let w: u64 = ast.e_zahl(b, k)
        if w > 255 {
            var m3: [u8; 33] = "erwartet ein zeichenkettenliteral"
            kaputt(z, (&m3[0]) as u64, 33)
            return false
        }
        rt.buf_push(aus, w as u8)
        i = i + 1
    }
    return true
}

fn ausdruck(z: *mut Zeit, e: u32, tiefe: i64) -> i64 {
    let b: *mut ast.Baum = (*z).baum as *mut ast.Baum
    let a: u32 = ast.e_art(b, e)
    if a == ast.E_INT {
        return ast.e_zahl(b, e) as i64
    }
    if a == ast.E_BOOL {
        // Der Wert steht bei E_BOOL in e_a (0 oder 1), nicht in e_zahl.
        return ast.e_a(b, e) as i64
    }
    if a == ast.E_ID {
        let platz: i64 = slot_suchen(z, ast.e_a(b, e))
        if platz >= 0 {
            return vec_at[i64](&(*z).uwert, platz as usize)
        }
        // Programmweite Konstanten sind hier NICHT sichtbar: die Bloecke
        // laufen vor der Typpruefung (SPEC §14.1.comptime), wie in Stufe 0.
        var m: [u8; 27] = "name ist hier nicht bekannt"
        kaputt(z, (&m[0]) as u64, 27)
        return 0
    }
    if a == ast.E_UN {
        let op: u32 = ast.e_a(b, e)
        let v: i64 = ausdruck(z, ast.e_b(b, e), tiefe)
        if op == U_NEG { return 0 - v }
        if op == U_NOT { if v == 0 { return 1 } return 0 }
        var m: [u8; 53] = "zeigeroperationen gibt es zur uebersetzungszeit nicht"
        kaputt(z, (&m[0]) as u64, 52)
        return 0
    }
    if a == ast.E_BIN {
        let op: u32 = ast.e_a(b, e)
        let links: i64 = ausdruck(z, ast.e_b(b, e), tiefe)
        if (*z).fehler > 0 { return 0 }
        // Kurzschluss beibehalten: `false && f()` ruft `f` nicht.
        if op == B_LAND {
            if links == 0 { return 0 }
        }
        if op == B_LOR {
            if links != 0 { return 1 }
        }
        let rechts: i64 = ausdruck(z, ast.e_c(b, e), tiefe)
        if (*z).fehler > 0 { return 0 }
        return rechne(z, op, links, rechts)
    }
    if a == ast.E_AS {
        // Stufe 0 liest den Zieltyp aus den Typangaben des Typpruefers; die
        // sind beim Blocklauf LEER, und dort gilt der Rueckfall i64. Dieser
        // Interpreter rechnet durchgaengig in i64 — der Wert geht durch.
        return ausdruck(z, ast.e_a(b, e), tiefe)
    }
    if a == ast.E_RUF {
        let name: u32 = ast.e_a(b, e)
        let off: u32 = ast.e_b(b, e)
        let n: u32 = ast.e_c(b, e)
        // EMIT: die einzigen Nebenwirkungen, die ein comptime haben darf —
        // sie schreiben in den Quelltextpuffer (SPEC §6.4).
        if name == (*z).n_emit_roh {
            if n != 1 {
                var m: [u8; 38] = "'emit_roh' erwartet genau ein argument"
                kaputt(z, (&m[0]) as u64, 38)
                return 0
            }
            literal_text(z, ast.kind_at(b, off), &(*z).ausgabe)
            return 0
        }
        if name == (*z).n_emit_zahl {
            if n != 1 {
                var m: [u8; 39] = "'emit_zahl' erwartet genau ein argument"
                kaputt(z, (&m[0]) as u64, 39)
                return 0
            }
            let v: i64 = ausdruck(z, ast.kind_at(b, off), tiefe)
            rt.buf_push_dez_i64(&(*z).ausgabe, v)
            return v
        }
        // DATENZUGRIFF ZUR UEBERSETZUNGSZEIT — byteweise, damit der
        // Interpreter weder Zeichenketten noch Arrays braucht.
        if name == (*z).n_groesse {
            if n != 1 {
                var m: [u8; 43] = "'datei_groesse' erwartet genau ein argument"
                kaputt(z, (&m[0]) as u64, 43)
                return 0
            }
            var pfad: rt.Buf = rt.buf_neu()
            defer rt.buf_frei(&pfad)
            if !literal_text(z, ast.kind_at(b, off), &pfad) {
                return 0
            }
            let d: i64 = lies_datei(z, rt.buf_ptr(&pfad), rt.buf_len(&pfad))
            if d < 0 { return 0 }
            return vec_at[u32](&(*z).ilen, d as usize) as i64
        }
        if name == (*z).n_byte {
            if n != 2 {
                var m: [u8; 36] = "'datei_byte' erwartet pfad und index"
                kaputt(z, (&m[0]) as u64, 37)
                return 0
            }
            var pfad2: rt.Buf = rt.buf_neu()
            defer rt.buf_frei(&pfad2)
            if !literal_text(z, ast.kind_at(b, off), &pfad2) {
                return 0
            }
            let idx: i64 = ausdruck(z, ast.kind_at(b, off + 1), tiefe)
            if (*z).fehler > 0 { return 0 }
            let d2: i64 = lies_datei(z, rt.buf_ptr(&pfad2), rt.buf_len(&pfad2))
            if d2 < 0 { return 0 }
            let ges: i64 = vec_at[u32](&(*z).ilen, d2 as usize) as i64
            if idx < 0 { return -1 }
            if idx >= ges { return -1 }
            let anf: u64 = rt.buf_ptr(&(*z).dalle) + vec_at[u32](&(*z).ioff, d2 as usize) as u64
            return rt.ld8(anf, idx as usize) as i64
        }
        // Gewoehnlicher Aufruf: Argumente auswerten, dann die Funktion.
        var werte: Vec[i64] = vec_neu[i64]()
        defer vec_frei[i64](&werte)
        var i: u32 = 0
        while i < n {
            vec_push[i64](&werte, ausdruck(z, ast.kind_at(b, off + i), tiefe))
            if (*z).fehler > 0 {
                return 0
            }
            i = i + 1
        }
        return ruf_auf(z, name, &werte, tiefe + 1)
    }
    var m: [u8; 61] = "hier sind nur literale, namen, operatoren und aufrufe erlaubt"
    kaputt(z, (&m[0]) as u64, 61)
    return 0
}

// Ruft die Funktion `name` mit bereits ausgewerteten Argumenten auf.
fn ruf_auf(z: *mut Zeit, name: u32, werte: *mut Vec[i64], tiefe: i64) -> i64 {
    let b: *mut ast.Baum = (*z).baum as *mut ast.Baum
    if tiefe >= MAX_TIEFE {
        var m: [u8; 34] = "mehr als 64 verschachtelte aufrufe"
        kaputt(z, (&m[0]) as u64, 34)
        return 0
    }
    var fi: i64 = -1
    var i: usize = 0
    while i < ast.fn_anzahl(b) {
        if ast.fn_name(b, i) == name {
            fi = i as i64
            break
        }
        i = i + 1
    }
    if fi < 0 {
        var m: [u8; 35] = "ist keine funktion dieses programms"
        kaputt(z, (&m[0]) as u64, 35)
        return 0
    }
    let fu: usize = fi as usize
    let poff: u32 = ast.fn_poff(b, fu)
    let plen: u32 = ast.fn_plen(b, fu)
    if plen as usize != vec_len[i64](werte) {
        var m: [u8; 40] = "falsche argumentzahl fuer diese funktion"
        kaputt(z, (&m[0]) as u64, 40)
        return 0
    }
    frame_auf(z)
    var k: u32 = 0
    while k < plen {
        setz_lokal(z, ast.param_name(b, poff + k), vec_at[i64](werte, k as usize))
        k = k + 1
    }
    let fluss: u32 = block(z, ast.fn_rumpf(b, fu), tiefe)
    frame_zu(z)
    if fluss == F_RET {
        return (*z).ret
    }
    // Eine Funktion ohne `return` liefert 0.
    return 0
}

// ---------------------------------------------------------- Anweisungen

fn block(z: *mut Zeit, bi: u32, tiefe: i64) -> u32 {
    let b: *mut ast.Baum = (*z).baum as *mut ast.Baum
    frame_auf(z)
    var fluss: u32 = F_WEITER
    let off: u32 = ast.b_off(b, bi)
    let n: u32 = ast.b_len(b, bi)
    var i: u32 = 0
    while i < n {
        fluss = anweisung(z, ast.sliste_at(b, off + i), tiefe)
        if fluss != F_WEITER {
            break
        }
        if (*z).fehler > 0 {
            break
        }
        i = i + 1
    }
    frame_zu(z)
    return fluss
}

fn schritt(z: *mut Zeit) -> bool {
    (*z).schritte = (*z).schritte + 1
    if (*z).schritte > MAX_SCHRITTE {
        var m: [u8; 45] = "mehr als 2000000 schritte — endlosschleife?"
        kaputt(z, (&m[0]) as u64, 45)
        return false
    }
    return true
}

fn anweisung(z: *mut Zeit, si: u32, tiefe: i64) -> u32 {
    if !schritt(z) {
        return F_RET
    }
    let b: *mut ast.Baum = (*z).baum as *mut ast.Baum
    let a: u32 = ast.s_art(b, si)
    if a == ast.S_LET || a == ast.S_VAR {
        let v: i64 = ausdruck(z, ast.s_c(b, si), tiefe)
        if (*z).fehler > 0 { return F_RET }
        setz_lokal(z, ast.s_a(b, si), v)
        return F_WEITER
    }
    if a == ast.S_ZUW {
        // Nur Zuweisungen an eine lokale Variable — kein Feld, kein Index,
        // kein Zeiger (comptime.rs, Stmt::Assign).
        let ziel: u32 = ast.s_a(b, si)
        if ast.e_art(b, ziel) != ast.E_ID {
            var m: [u8; 63] = "nur zuweisungen an eine lokale variable (kein feld, kein index)"
            kaputt(z, (&m[0]) as u64, 68)
            return F_RET
        }
        let v: i64 = ausdruck(z, ast.s_b(b, si), tiefe)
        if (*z).fehler > 0 { return F_RET }
        let platz: i64 = slot_suchen(z, ast.e_a(b, ziel))
        if platz < 0 {
            var m2: [u8; 25] = "ist keine lokale variable"
            kaputt(z, (&m2[0]) as u64, 25)
            return F_RET
        }
        vec_setzen[i64](&(*z).uwert, platz as usize, v)
        return F_WEITER
    }
    if a == ast.S_EXPR {
        ausdruck(z, ast.s_a(b, si), tiefe)
        if (*z).fehler > 0 { return F_RET }
        return F_WEITER
    }
    if a == ast.S_BLOCK {
        return block(z, ast.s_a(b, si), tiefe)
    }
    if a == ast.S_RET {
        let w: u32 = ast.s_a(b, si)
        if w == ast.NICHTS {
            (*z).ret = 0
        } else {
            (*z).ret = ausdruck(z, w, tiefe)
        }
        return F_RET
    }
    if a == ast.S_IF {
        let bed: i64 = ausdruck(z, ast.s_a(b, si), tiefe)
        if (*z).fehler > 0 { return F_RET }
        if bed != 0 {
            return block(z, ast.s_b(b, si), tiefe)
        }
        let sonst: u32 = ast.s_c(b, si)
        if sonst != ast.NICHTS {
            return anweisung(z, sonst, tiefe)
        }
        return F_WEITER
    }
    if a == ast.S_WHILE {
        while true {
            if !schritt(z) {
                return F_RET
            }
            let bed: i64 = ausdruck(z, ast.s_a(b, si), tiefe)
            if (*z).fehler > 0 { return F_RET }
            if bed == 0 {
                return F_WEITER
            }
            let fluss: u32 = block(z, ast.s_b(b, si), tiefe)
            if fluss == F_RET { return F_RET }
            if fluss == F_BREAK { return F_WEITER }
        }
    }
    if a == ast.S_FOR {
        let von: i64 = ausdruck(z, ast.s_b(b, si), tiefe)
        if (*z).fehler > 0 { return F_RET }
        let bis: i64 = ausdruck(z, ast.s_c(b, si), tiefe)
        if (*z).fehler > 0 { return F_RET }
        var i: i64 = von
        while i < bis {
            if !schritt(z) {
                return F_RET
            }
            // Ein eigener Bereich je Runde — die Laufvariable gehoert ihm
            // (comptime.rs schiebt je Runde eine neue Ebene).
            frame_auf(z)
            setz_lokal(z, ast.s_a(b, si), i)
            let fluss: u32 = block(z, ast.s_d(b, si), tiefe)
            frame_zu(z)
            if fluss == F_RET { return F_RET }
            if fluss == F_BREAK { return F_WEITER }
            i = i + 1
        }
        return F_WEITER
    }
    if a == ast.S_BREAK { return F_BREAK }
    if a == ast.S_CONT { return F_CONT }
    if a == ast.S_DEFER || a == ast.S_ERRDEFER {
        var m: [u8; 63] = "'defer' und 'errdefer' sind zur uebersetzungszeit nicht erlaubt"
        kaputt(z, (&m[0]) as u64, 61)
        return F_RET
    }
    var m: [u8; 51] = "diese anweisung gibt es zur uebersetzungszeit nicht"
    kaputt(z, (&m[0]) as u64, 51)
    return F_RET
}

// -------------------------------------------------------------- der Lauf

// Fuehrt alle `comptime { ... }`-Bloecke des Programms aus; der erzeugte
// Quelltext steht danach in `ausgabe`. Der Lauf findet VOR der Typpruefung
// statt: die Bloecke duerfen deshalb keine programmweiten Konstanten
// benutzen, wohl aber jede Funktion des Programms aufrufen.
fn zeit_lauf(z: *mut Zeit) {
    let b: *mut ast.Baum = (*z).baum as *mut ast.Baum
    var i: usize = 0
    while i < ast.ct_anzahl(b) {
        frame_auf(z)
        block(z, ast.ct_block(b, i), 0)
        frame_zu(z)
        if (*z).fehler > 0 {
            return
        }
        i = i + 1
    }
}
