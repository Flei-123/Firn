import rt
import vec
import prelude

struct Ctx {
    orig: u64,
    src: u64,
    n: usize,
    ns: Vec[usize],
    ne: Vec[usize],
    fixed: Vec[usize],
    es: Vec[usize],
    ee: Vec[usize],
    ed_s: Vec[usize],
    ed_e: Vec[usize],
    ed_ts: Vec[usize],
    sp: Vec[usize],
    sk: Vec[usize],
    vec_imported: bool,
}

fn ctx_new(src: u64, n: usize) -> Ctx {
    return Ctx {
        orig: src, src: src, n: n,
        ns: vec_new[usize](), ne: vec_new[usize](), fixed: vec_new[usize](), es: vec_new[usize](), ee: vec_new[usize](),
        ed_s: vec_new[usize](), ed_e: vec_new[usize](), ed_ts: vec_new[usize](),
        sp: vec_new[usize](), sk: vec_new[usize](), vec_imported: false,
    }
}

fn ctx_free(cx: *mut Ctx) {
    vec_free[usize](&(*cx).ns)
    vec_free[usize](&(*cx).ne)
    vec_free[usize](&(*cx).fixed)
    vec_free[usize](&(*cx).es)
    vec_free[usize](&(*cx).ee)
    vec_free[usize](&(*cx).ed_s)
    vec_free[usize](&(*cx).ed_e)
    vec_free[usize](&(*cx).ed_ts)
    vec_free[usize](&(*cx).sp)
    vec_free[usize](&(*cx).sk)
}

fn at(src: u64, i: usize) -> u8 {
    return prelude.at(src, i)
}

fn skip_space(src: u64, n: usize, i0: usize) -> usize {
    var i: usize = i0
    while i < n && at(src, i) <= 32 { i = i + 1 }
    return i
}

fn ident_end(src: u64, n: usize, i0: usize) -> usize {
    var i: usize = i0
    while i < n && prelude.is_ident_byte(at(src, i)) { i = i + 1 }
    return i
}

fn same_text(a: u64, a0: usize, a1: usize, b: u64, b0: usize, b1: usize) -> bool {
    if a1 - a0 != b1 - b0 { return false }
    var k: usize = 0
    while k < a1 - a0 {
        if at(a, a0 + k) != at(b, b0 + k) { return false }
        k = k + 1
    }
    return true
}

fn is_word(src: u64, s: usize, e: usize, lit: str) -> bool {
    unsafe { return same_text(src, s, e, lit.p as u64, 0, lit.n) }
}

fn dots_start(src: u64, n: usize, s: usize, e: usize) -> usize {
    let n0: usize = skip_space(src, n, s)
    let n1: usize = ident_end(src, n, n0)
    if n0 == n1 { return e }
    let colon: usize = skip_space(src, n, n1)
    if colon >= e || at(src, colon) != 58 { return e }
    let dots: usize = skip_space(src, n, colon + 1)
    if dots + 1 < e && at(src, dots) == 46 && at(src, dots + 1) == 46 { return dots }
    return e
}

fn is_method(src: u64, n: usize, s: usize, e: usize) -> bool {
    var i: usize = skip_space(src, n, s)
    if i < e && at(src, i) == 42 {
        i = skip_space(src, n, i + 1)
        let m: usize = ident_end(src, n, i)
        if is_word(src, i, m, "mut") { i = skip_space(src, n, m) }
    }
    let w: usize = ident_end(src, n, i)
    return is_word(src, i, w, "self")
}

fn declaration(cx: *mut Ctx, name_s: usize, name_e: usize, open: usize) {
    let src: u64 = (*cx).src
    let n: usize = (*cx).n
    var starts: Vec[usize] = vec_new[usize]()
    var ends: Vec[usize] = vec_new[usize]()
    let close: usize = prelude.split_args(src, n, open, &starts, &ends)
    let na: usize = vec_len[usize](&starts)
    if close < n && na > 0 {
        let s: usize = vec_at[usize](&starts, na - 1)
        let e: usize = vec_at[usize](&ends, na - 1)
        let dots: usize = dots_start(src, n, s, e)
        let ts: usize = skip_space(src, n, dots + 2)
        var te: usize = e
        while te > ts && at(src, te - 1) <= 32 { te = te - 1 }
        if dots < e && ts < te {
            vec_push[usize](&(*cx).ed_s, dots)
            vec_push[usize](&(*cx).ed_e, te)
            vec_push[usize](&(*cx).ed_ts, ts)
            if !is_method(src, n, vec_at[usize](&starts, 0), vec_at[usize](&ends, 0)) {
                vec_push[usize](&(*cx).ns, name_s)
                vec_push[usize](&(*cx).ne, name_e)
                vec_push[usize](&(*cx).fixed, na - 1)
                vec_push[usize](&(*cx).es, ts)
                vec_push[usize](&(*cx).ee, te)
            }
        }
    }
    vec_free[usize](&starts)
    vec_free[usize](&ends)
}

fn read_import(cx: *mut Ctx, i0: usize) -> usize {
    let src: u64 = (*cx).src
    let n: usize = (*cx).n
    var i: usize = i0
    while true {
        while i < n && (at(src, i) == 32 || at(src, i) == 9) { i = i + 1 }
        let s: usize = i
        i = ident_end(src, n, i)
        if s == i { break }
        (*cx).vec_imported = is_word(src, s, i, "vec")
        if i < n && at(src, i) == 46 {
            i = i + 1
        } else {
            break
        }
    }
    return i
}

fn scan_declarations(cx: *mut Ctx) {
    let src: u64 = (*cx).src
    let n: usize = (*cx).n
    var prev_fn: bool = false
    var i: usize = 0
    while i < n {
        let c: u8 = at(src, i)
        if c == 47 && i + 1 < n && at(src, i + 1) == 47 {
            while i < n && at(src, i) != 10 { i = i + 1 }
        } else if c == 47 && i + 1 < n && at(src, i + 1) == 42 {
            i = i + 2
            while i + 1 < n && !(at(src, i) == 42 && at(src, i + 1) == 47) { i = i + 1 }
            i = i + 2
            if i > n { i = n }
        } else if c == 34 || c == 39 {
            i = prelude.skip_quoted(src, n, i, c)
            prev_fn = false
        } else if prelude.is_ident_start(c) {
            let start: usize = i
            i = ident_end(src, n, i)
            if is_word(src, start, i, "import") {
                i = read_import(cx, i)
                prev_fn = false
            } else {
                if prev_fn {
                    let open: usize = skip_space(src, n, i)
                    if open < n && at(src, open) == 40 { declaration(cx, start, i, open) }
                }
                prev_fn = is_word(src, start, i, "fn")
            }
        } else {
            if c > 32 { prev_fn = false }
            i = i + 1
        }
    }
}

fn put(out: *mut rt.Buf, s: str) {
    unsafe { rt.buf_push_bytes(out, s.p as u64, s.n) }
}

fn put_range(out: *mut rt.Buf, src: u64, s: usize, e: usize) {
    rt.buf_push_bytes(out, src +% s as u64, e - s)
}

fn apply_edits(cx: *mut Ctx, out: *mut rt.Buf) {
    var pos: usize = 0
    var k: usize = 0
    while k < vec_len[usize](&(*cx).ed_s) {
        let dots: usize = vec_at[usize](&(*cx).ed_s, k)
        let te: usize = vec_at[usize](&(*cx).ed_e, k)
        let ts: usize = vec_at[usize](&(*cx).ed_ts, k)
        put_range(out, (*cx).orig, pos, dots)
        put(out, "Vec[")
        put_range(out, (*cx).orig, ts, te)
        put(out, "]")
        pos = te
        k = k + 1
    }
    put_range(out, (*cx).orig, pos, (*cx).n)
}

fn find_decl(cx: *mut Ctx, s: usize, e: usize) -> usize {
    var k: usize = 0
    while k < vec_len[usize](&(*cx).ns) {
        if same_text((*cx).src, s, e, (*cx).orig, vec_at[usize](&(*cx).ns, k), vec_at[usize](&(*cx).ne, k)) { return k }
        k = k + 1
    }
    return vec_len[usize](&(*cx).ns)
}

fn note_site(cx: *mut Ctx, s: usize, e: usize) {
    let k: usize = find_decl(cx, s, e)
    if k < vec_len[usize](&(*cx).ns) && prelude.next_non_space((*cx).src, (*cx).n, e) == 40 {
        vec_push[usize](&(*cx).sp, s)
        vec_push[usize](&(*cx).sk, k)
    }
}

fn interpolated_sites(cx: *mut Ctx, quote: usize) -> usize {
    let src: u64 = (*cx).src
    let n: usize = (*cx).n
    var depth: usize = 0
    var i: usize = quote + 1
    while i < n && at(src, i) != 10 && !(at(src, i) == 34 && depth == 0) {
        let c: u8 = at(src, i)
        var step: usize = 1
        if c == 92 {
            i = i + 1
        } else if c == 123 {
            depth = depth + 1
        } else if c == 125 {
            if depth > 0 { depth = depth - 1 }
        } else if depth > 0 && prelude.is_ident_start(c) {
            let end: usize = ident_end(src, n, i)
            let after_dot: bool = i > 0 && (at(src, i - 1) == 46 || prelude.is_ident_byte(at(src, i - 1)))
            if !after_dot { note_site(cx, i, end) }
            i = end
            step = 0
        }
        i = i + step
    }
    i = i + 1
    if i > n { return n }
    return i
}

fn scan_sites(cx: *mut Ctx) {
    let src: u64 = (*cx).src
    let n: usize = (*cx).n
    var prev_fn: bool = false
    var prev_dot: bool = false
    var i: usize = 0
    while i < n {
        let c: u8 = at(src, i)
        if c == 47 && i + 1 < n && at(src, i + 1) == 47 {
            while i < n && at(src, i) != 10 { i = i + 1 }
        } else if c == 47 && i + 1 < n && at(src, i + 1) == 42 {
            i = i + 2
            while i + 1 < n && !(at(src, i) == 42 && at(src, i + 1) == 47) { i = i + 1 }
            i = i + 2
            if i > n { i = n }
        } else if c == 34 && i > 0 && at(src, i - 1) == 102 && (i < 2 || !prelude.is_ident_byte(at(src, i - 2))) {
            i = interpolated_sites(cx, i)
            prev_dot = false
            prev_fn = false
        } else if c == 34 || c == 39 {
            i = prelude.skip_quoted(src, n, i, c)
            prev_dot = false
            prev_fn = false
        } else if c == 46 {
            prev_dot = true
            i = i + 1
        } else if prelude.is_ident_start(c) {
            let start: usize = i
            i = ident_end(src, n, i)
            if !prev_dot && !prev_fn { note_site(cx, start, i) }
            prev_fn = is_word(src, start, i, "fn")
            prev_dot = false
        } else {
            if c > 32 { prev_dot = false }
            i = i + 1
        }
    }
}

fn put_pack_open(cx: *mut Ctx, out: *mut rt.Buf, k: usize, extra: usize) {
    var j: usize = 0
    while j < extra {
        put(out, "vec.vec_with[")
        put_range(out, (*cx).orig, vec_at[usize](&(*cx).es, k), vec_at[usize](&(*cx).ee, k))
        put(out, "](")
        j = j + 1
    }
    put(out, "vec.vec_new[")
    put_range(out, (*cx).orig, vec_at[usize](&(*cx).es, k), vec_at[usize](&(*cx).ee, k))
    put(out, "]()")
}

fn emit_call(cx: *mut Ctx, k: usize, starts: *mut Vec[usize], ends: *mut Vec[usize], given: usize, out: *mut rt.Buf) {
    let fixed: usize = vec_at[usize](&(*cx).fixed, k)
    put_range(out, (*cx).orig, vec_at[usize](&(*cx).ns, k), vec_at[usize](&(*cx).ne, k))
    rt.buf_push(out, 40 as u8)
    var i: usize = 0
    while i < fixed {
        emit(cx, vec_at[usize](starts, i), vec_at[usize](ends, i), out)
        rt.buf_push(out, 44 as u8)
        i = i + 1
    }
    put_pack_open(cx, out, k, given - fixed)
    while i < given {
        put(out, ", ")
        emit(cx, vec_at[usize](starts, i), vec_at[usize](ends, i), out)
        rt.buf_push(out, 41 as u8)
        i = i + 1
    }
    rt.buf_push(out, 41 as u8)
}

fn emit(cx: *mut Ctx, from: usize, to: usize, out: *mut rt.Buf) {
    var pos: usize = from
    var si: usize = 0
    while si < vec_len[usize](&(*cx).sp) {
        let p: usize = vec_at[usize](&(*cx).sp, si)
        let k: usize = vec_at[usize](&(*cx).sk, si)
        si = si + 1
        if p >= to { break }
        if p >= pos {
            var starts: Vec[usize] = vec_new[usize]()
            var ends: Vec[usize] = vec_new[usize]()
            let open: usize = skip_space((*cx).src, (*cx).n, p + vec_at[usize](&(*cx).ne, k) - vec_at[usize](&(*cx).ns, k))
            let close: usize = prelude.split_args((*cx).src, (*cx).n, open, &starts, &ends)
            var given: usize = vec_len[usize](&starts)
            if given == 1 && vec_at[usize](&starts, 0) == vec_at[usize](&ends, 0) { given = 0 }
            if close < to && given >= vec_at[usize](&(*cx).fixed, k) {
                put_range(out, (*cx).src, pos, p)
                emit_call(cx, k, &starts, &ends, given, out)
                pos = close + 1
            }
            vec_free[usize](&starts)
            vec_free[usize](&ends)
        }
    }
    put_range(out, (*cx).src, pos, to)
}

fn pv_run(src: u64, n: usize, out: *mut rt.Buf) -> bool {
    if !prelude.contains(src, n, 46 as u8, "..") { return false }
    if prelude.contains(src, n, 112 as u8, "profile kernel") { return false }
    var cx: Ctx = ctx_new(src, n)
    defer ctx_free(&cx)
    scan_declarations(&cx)
    if vec_len[usize](&cx.ed_s) == 0 { return false }
    var declared: rt.Buf = rt.buf_new()
    defer rt.buf_free(&declared)
    apply_edits(&cx, &declared)
    cx.src = rt.buf_ptr(&declared)
    cx.n = rt.buf_len(&declared)
    scan_sites(&cx)
    if !cx.vec_imported { put(out, "import std.vec; ") }
    emit(&cx, 0, cx.n, out)
    return true
}
