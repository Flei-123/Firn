// SPDX-License-Identifier: MPL-2.0

import vec
import pattern

export { variant_covered }

const NONE: u32 = 4294967295

fn is_wild(m: *mut pattern.Pat, p: u32) -> bool {
    return p == NONE || pattern.pat_irrefutable(m, p)
}

fn push_tail(rows: *mut Vec[u32], out: *mut Vec[u32], r: usize, w: usize) {
    var c: usize = 1
    while c < w {
        vec_push[u32](out, vec_at[u32](rows, r * w + c))
        c = c + 1
    }
}

fn cover_default(m: *mut pattern.Pat, rows: *mut Vec[u32], n: usize, w: usize) -> bool {
    var out: Vec[u32] = vec_new[u32]()
    var cnt: usize = 0
    var r: usize = 0
    while r < n {
        if is_wild(m, vec_at[u32](rows, r * w)) {
            push_tail(rows, &out, r, w)
            cnt = cnt + 1
        }
        r = r + 1
    }
    let ok: bool = cover_all(m, &out, cnt, w - 1)
    vec_free[u32](&out)
    return ok
}

fn cover_bool_value(m: *mut pattern.Pat, rows: *mut Vec[u32], n: usize, w: usize, value: u32) -> bool {
    var out: Vec[u32] = vec_new[u32]()
    var cnt: usize = 0
    var r: usize = 0
    while r < n {
        let p: u32 = vec_at[u32](rows, r * w)
        if is_wild(m, p) || (pattern.pat_mu_kind(m, p) == pattern.MU_BOOL && pattern.pat_mu_a(m, p) == value) {
            push_tail(rows, &out, r, w)
            cnt = cnt + 1
        }
        r = r + 1
    }
    let ok: bool = cover_all(m, &out, cnt, w - 1)
    vec_free[u32](&out)
    return ok
}

fn cover_variant_rows(m: *mut pattern.Pat, rows: *mut Vec[u32], n: usize, w: usize, vi: u32) -> bool {
    let vname: u32 = pattern.pat_v_name(m, vi)
    let arity: usize = pattern.pat_v_tlen(m, vi) as usize
    var out: Vec[u32] = vec_new[u32]()
    var cnt: usize = 0
    var r: usize = 0
    while r < n {
        let p: u32 = vec_at[u32](rows, r * w)
        var take: bool = false
        var j: usize = 0
        if is_wild(m, p) {
            take = true
            while j < arity {
                vec_push[u32](&out, NONE)
                j = j + 1
            }
        } else if pattern.pat_mu_kind(m, p) == pattern.MU_VARIANT && pattern.pat_mu_b(m, p) == vname {
            take = true
            let soff: u32 = pattern.pat_mu_soff(m, p)
            let slen: usize = pattern.pat_mu_slen(m, p) as usize
            while j < arity {
                if j < slen {
                    vec_push[u32](&out, pattern.pat_mu_child(m, soff + j as u32))
                } else {
                    vec_push[u32](&out, NONE)
                }
                j = j + 1
            }
        }
        if take {
            push_tail(rows, &out, r, w)
            cnt = cnt + 1
        }
        r = r + 1
    }
    let ok: bool = cover_all(m, &out, cnt, arity + w - 1)
    vec_free[u32](&out)
    return ok
}

fn cover_enum(m: *mut pattern.Pat, rows: *mut Vec[u32], n: usize, w: usize, ei: u32) -> bool {
    let voff: u32 = pattern.pat_e_voff(m, ei)
    let vlen: u32 = pattern.pat_e_vlen(m, ei)
    var v: u32 = 0
    while v < vlen {
        if !cover_variant_rows(m, rows, n, w, voff + v) {
            return false
        }
        v = v + 1
    }
    return true
}

fn cover_all(m: *mut pattern.Pat, rows: *mut Vec[u32], n: usize, w: usize) -> bool {
    if n == 0 {
        return false
    }
    if w == 0 {
        return true
    }
    var first: u32 = NONE
    var r: usize = 0
    while r < n && first == NONE {
        let p: u32 = vec_at[u32](rows, r * w)
        if !is_wild(m, p) {
            first = p
        }
        r = r + 1
    }
    if first == NONE {
        return cover_default(m, rows, n, w)
    }
    let k: u32 = pattern.pat_mu_kind(m, first)
    if k == pattern.MU_VARIANT && pattern.pat_mu_ei(m, first) != NONE {
        return cover_enum(m, rows, n, w, pattern.pat_mu_ei(m, first))
    }
    if k == pattern.MU_BOOL {
        return cover_bool_value(m, rows, n, w, 1) && cover_bool_value(m, rows, n, w, 0)
    }
    return cover_default(m, rows, n, w)
}

fn variant_covered(m: *mut pattern.Pat, aoff: u32, alen: u32, vi: u32) -> bool {
    var rows: Vec[u32] = vec_new[u32]()
    var ai: u32 = 0
    while ai < alen {
        vec_push[u32](&rows, pattern.pat_a_pat(m, aoff + ai))
        ai = ai + 1
    }
    let ok: bool = cover_variant_rows(m, &rows, alen as usize, 1, vi)
    vec_free[u32](&rows)
    return ok
}
