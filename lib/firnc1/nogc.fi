// SPDX-License-Identifier: MPL-2.0
// lib/firnc1/nogc.fi -- the `#[no_gc]` promise for hot paths, checked
// transitively (SPEC 3.5.4). Fifteenth part of stage 1: the port of
// `compiler/src/nogc.rs` (round 34).
//
// Inside a `#[no_gc]` function these are forbidden:
//  1. GC allocation (and every call that could trigger a collection),
//  2. calling a function WITHOUT `#[no_gc]`,
//  3. writing a `Gc[T]`/`GcWeak[T]` pointer into a field or array
//     element (insertion barrier).
//
// Because every called function has to carry `#[no_gc]` itself, the promise
// holds for the whole call tree -- across module boundaries as well (by
// then the names have been rewritten to `module__name`, and the checker
// sees a flat tree). The GC queries (1 and 3) come from `gc.fi` -- exactly
// the two contract functions whose signatures stage 0 fixes.
//
// Scope, honestly stated (like stage 0):
//  * Every call in the body is checked, INCLUDING the body blocks
//    of `match` arms -- they do not sit in the tree but in the
//    registry of `pattern.fi`.
//  * Callee names produced by the compiler (`__match#N`, `__try#`, `__catch#`,
//    `Enum::Variant`) are not function calls; their arguments are
//    searched through all the same.
//  * Calls of names that do not exist at all are reported by the type
//    check itself -- there is no second error for them here.

import rt
import vec
import intern
import ast
import types
import pattern
import gc
import sema
import report

export { nogc_check }

const NONE: u32 = 4294967295

// Deepest nesting level of `match` arms that is still inspected
// (a second safeguard against runaway recursion, as in stage 0).
const MAX_DEPTH: u32 = 256

struct Checker {
    sm: u64, // the type checker (type table of the expressions)
    mu: u64, // pattern registry
    gcr: u64, // GC registry
    it: u64, // interner
    m_name: Vec[u32], // function names ->
    m_flag: Vec[u32], // 1 = has `#[no_gc]`
    err: usize,
    depth: u32, // nesting depth of the `match` body blocks
    who: u32,
    fpos: Vec[u64],
    fspan: Vec[u32],
    foff: Vec[u32],
    flen: Vec[u32],
    ftxt: rt.Buf,
    msg: rt.Buf,
}

fn names(p: *mut Checker) -> *mut intern.Interner { return (*p).it as *mut intern.Interner }
fn gcr(p: *mut Checker) -> *mut gc.Gc { return (*p).gcr as *mut gc.Gc }
fn table(p: *mut Checker) -> *mut types.Types {
    return sema.sema_types((*p).sm as *mut sema.Sema)
}
fn mul(p: *mut Checker) -> *mut pattern.Pat { return (*p).mu as *mut pattern.Pat }

// 0 = unknown (reported by the type check itself), 1 = marked, 2 = cold.
fn marking(p: *mut Checker, name: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*p).m_name) {
        if vec_at[u32](&(*p).m_name, i) == name {
            if vec_at[u32](&(*p).m_flag, i) == 1 {
                return 1
            }
            return 2
        }
        i = i + 1
    }
    return 0
}

// A callee name produced by the compiler itself: it contains `#` or `::`,
// so it can never come from a source text identifier.
fn is_method_call(it: *mut intern.Interner, name: u32) -> bool {
    var w: [u8; 7] = "method "
    return intern.intern_prefix(it, name, (&w[0]) as u64, 7)
}

fn is_interner_name(it: *mut intern.Interner, nr: u32) -> bool {
    let p: u64 = intern.intern_ptr(it, nr)
    let n: usize = intern.intern_length(it, nr)
    var i: usize = 0
    while i < n {
        let b: u8 = rt.ld8(p, i)
        if b == 35 as u8 {
            return true
        }
        if b == 58 as u8 && i + 1 < n && rt.ld8(p, i + 1) == 58 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

// The actual pass. Returns the number of violations.
fn nogc_check(sm: u64, mu: u64, gcr2: u64, it: u64) -> usize {
    var p: Checker = Checker {
        sm: sm, mu: mu, gcr: gcr2, it: it,
        m_name: vec_new[u32](), m_flag: vec_new[u32](),
        err: 0, depth: 0, who: NONE,
        fpos: vec_new[u64](), fspan: vec_new[u32](), foff: vec_new[u32](), flen: vec_new[u32](),
        ftxt: rt.buf_new(), msg: rt.buf_new(),
    }
    let b: *mut ast.Tree = sema.sema_tree(p.sm as *mut sema.Sema)
    // Collect the markings. For names declared twice (which the type
    // check reports as an error of its own) the stricter entry wins: marked
    // stays marked.
    var i: usize = 0
    while i < ast.fn_count(b) {
        let nm: u32 = ast.fn_name(b, i)
        let fl: u32 = ast.fn_nogc(b, i)
        var j: usize = 0
        var hit: bool = false
        while j < vec_len[u32](&p.m_name) {
            if vec_at[u32](&p.m_name, j) == nm {
                if fl == 1 {
                    vec_set[u32](&p.m_flag, j, 1)
                }
                hit = true
            }
            j = j + 1
        }
        if !hit {
            vec_push[u32](&p.m_name, nm)
            vec_push[u32](&p.m_flag, fl)
        }
        i = i + 1
    }
    var a: bool = false
    i = 0
    while i < vec_len[u32](&p.m_flag) {
        if vec_at[u32](&p.m_flag, i) == 1 {
            a = true
        }
        i = i + 1
    }
    if a {
        i = 0
        while i < ast.fn_count(b) {
            if ast.fn_nogc(b, i) == 1 {
                p.who = ast.fn_name(b, i)
                check_block(&p, b, ast.fn_body(b, i))
            }
            i = i + 1
        }
    }
    flush(&p, sema.sema_pend(p.sm as *mut sema.Sema))
    let out: usize = p.err
    vec_free[u32](&p.m_name)
    vec_free[u32](&p.m_flag)
    vec_free[u64](&p.fpos)
    vec_free[u32](&p.fspan)
    vec_free[u32](&p.foff)
    vec_free[u32](&p.flen)
    rt.buf_free(&p.ftxt)
    rt.buf_free(&p.msg)
    return out
}

fn finding_same(p: *mut Checker, x: usize, y: usize) -> bool {
    if vec_at[u64](&(*p).fpos, x) != vec_at[u64](&(*p).fpos, y) {
        return false
    }
    let n: usize = vec_at[u32](&(*p).flen, x) as usize
    if n != vec_at[u32](&(*p).flen, y) as usize {
        return false
    }
    let bx: u64 = rt.buf_ptr(&(*p).ftxt) + vec_at[u32](&(*p).foff, x) as u64
    let by: u64 = rt.buf_ptr(&(*p).ftxt) + vec_at[u32](&(*p).foff, y) as u64
    var i: usize = 0
    while i < n {
        if rt.ld8(bx, i) != rt.ld8(by, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn flush(p: *mut Checker, pend: *mut report.Pend) {
    let n: usize = vec_len[u64](&(*p).fpos)
    var order: Vec[u32] = vec_new[u32]()
    var i: usize = 0
    while i < n {
        var j: usize = vec_len[u32](&order)
        vec_push[u32](&order, i as u32)
        while j > 0 && vec_at[u64](&(*p).fpos, vec_at[u32](&order, j - 1) as usize) > vec_at[u64](&(*p).fpos, i) {
            vec_set[u32](&order, j, vec_at[u32](&order, j - 1))
            j = j - 1
        }
        vec_set[u32](&order, j, i as u32)
        i = i + 1
    }
    var prev: usize = n
    i = 0
    while i < n {
        let k: usize = vec_at[u32](&order, i) as usize
        if prev == n || !finding_same(p, prev, k) {
            rt.buf_clear(&(*p).msg)
            rt.buf_push_bytes(&(*p).msg, rt.buf_ptr(&(*p).ftxt) + vec_at[u32](&(*p).foff, k) as u64, vec_at[u32](&(*p).flen, k) as usize)
            report.pend_add(pend, vec_at[u64](&(*p).fpos, k), vec_at[u32](&(*p).fspan, k), &(*p).msg)
        } else {
            (*p).err = (*p).err - 1
        }
        prev = k
        i = i + 1
    }
    vec_free[u32](&order)
}

fn find_double_underscore(it: *mut intern.Interner, name: u32, from: usize) -> i64 {
    let ptr: u64 = intern.intern_ptr(it, name)
    let n: usize = intern.intern_length(it, name)
    var i: usize = from
    while i + 1 < n {
        if rt.ld8(ptr, i) == 95 as u8 && rt.ld8(ptr, i + 1) == 95 as u8 {
            return i as i64
        }
        i = i + 1
    }
    return -1
}

fn push_readable(buf: *mut rt.Buf, it: *mut intern.Interner, name: u32) {
    let ptr: u64 = intern.intern_ptr(it, name)
    let n: usize = intern.intern_length(it, name)
    var split: i64 = -1
    if !(n > 0 && rt.ld8(ptr, 0) == 95 as u8) && !is_interner_name(it, name) {
        let first: i64 = find_double_underscore(it, name, 0)
        if first > 0 && (first as usize) + 2 < n && find_double_underscore(it, name, (first as usize) + 2) < 0 {
            split = first
        }
    }
    if split < 0 {
        rt.buf_push_bytes(buf, ptr, n)
        return
    }
    rt.buf_push_bytes(buf, ptr, split as usize)
    rt.buf_push(buf, 46 as u8)
    rt.buf_push_bytes(buf, ptr + (split as u64) + 2, n - (split as usize) - 2)
}

fn readable_len(it: *mut intern.Interner, name: u32) -> u32 {
    var tmp: rt.Buf = rt.buf_new()
    push_readable(&tmp, it, name)
    let n: u32 = rt.buf_len(&tmp) as u32
    rt.buf_free(&tmp)
    return n
}

fn begin_finding(p: *mut Checker, pos: u64, span: u32) {
    rt.buf_clear(&(*p).msg)
    vec_push[u64](&(*p).fpos, pos)
    vec_push[u32](&(*p).fspan, span)
    vec_push[u32](&(*p).foff, rt.buf_len(&(*p).ftxt) as u32)
    var q: [u8; 1] = "'"
    rt.buf_push_bytes(&(*p).msg, (&q[0]) as u64, 1)
    push_readable(&(*p).msg, names(p), (*p).who)
}

fn end_finding(p: *mut Checker) {
    vec_push[u32](&(*p).flen, rt.buf_len(&(*p).msg) as u32)
    rt.buf_push_bytes(&(*p).ftxt, rt.buf_ptr(&(*p).msg), rt.buf_len(&(*p).msg))
    (*p).err = (*p).err + 1
}

fn put_lit(p: *mut Checker, text: u64, n: usize) {
    rt.buf_push_bytes(&(*p).msg, text, n)
}

fn put_name(p: *mut Checker, name: u32) {
    rt.buf_push_bytes(&(*p).msg, intern.intern_ptr(names(p), name), intern.intern_length(names(p), name))
}

fn report_alloc(p: *mut Checker, pos: u64, name: u32) {
    begin_finding(p, pos, readable_len(names(p), name))
    var t1: [u8; 49] = "' is #[no_gc], but allocates on the GC heap via '"
    put_lit(p, (&t1[0]) as u64, 49)
    push_readable(&(*p).msg, names(p), name)
    var t2: [u8; 1] = "'"
    put_lit(p, (&t2[0]) as u64, 1)
    end_finding(p)
}

fn report_closure_alloc(p: *mut Checker, pos: u64, span: u32) {
    begin_finding(p, pos, span)
    var t1: [u8; 49] = "' is #[no_gc], but allocates on the GC heap via '"
    put_lit(p, (&t1[0]) as u64, 49)
    var t2: [u8; 11] = "gc fn(…)'"
    put_lit(p, (&t2[0]) as u64, 11)
    end_finding(p)
}

fn report_method(p: *mut Checker, pos: u64, name: u32) {
    begin_finding(p, pos, intern.intern_length(names(p), name) as u32 - 7)
    var t1: [u8; 37] = "' is #[no_gc], but calls the method '"
    put_lit(p, (&t1[0]) as u64, 37)
    rt.buf_push_bytes(&(*p).msg, intern.intern_ptr(names(p), name) + 7, intern.intern_length(names(p), name) - 7)
    var t2: [u8; 1] = "'"
    put_lit(p, (&t2[0]) as u64, 1)
    end_finding(p)
}

fn report_call(p: *mut Checker, pos: u64, name: u32) {
    begin_finding(p, pos, readable_len(names(p), name))
    var t1: [u8; 26] = "' is #[no_gc], but calls '"
    put_lit(p, (&t1[0]) as u64, 26)
    push_readable(&(*p).msg, names(p), name)
    var t2: [u8; 18] = "' without #[no_gc]"
    put_lit(p, (&t2[0]) as u64, 18)
    end_finding(p)
}

fn report_write_field(p: *mut Checker, pos: u64, field: u32) {
    begin_finding(p, pos, intern.intern_length(names(p), field) as u32)
    var t1: [u8; 45] = "' is #[no_gc], but writes into the GC field '"
    put_lit(p, (&t1[0]) as u64, 45)
    put_name(p, field)
    var t2: [u8; 1] = "'"
    put_lit(p, (&t2[0]) as u64, 1)
    end_finding(p)
}

fn report_write_elem(p: *mut Checker, pos: u64, span: u32) {
    begin_finding(p, pos, span)
    var t1: [u8; 53] = "' is #[no_gc], but writes into a GC element in memory"
    put_lit(p, (&t1[0]) as u64, 53)
    end_finding(p)
}

fn report_write_deref(p: *mut Checker, pos: u64, span: u32) {
    begin_finding(p, pos, span)
    var t1: [u8; 58] = "' is #[no_gc], but writes into a GC field behind a pointer"
    put_lit(p, (&t1[0]) as u64, 58)
    end_finding(p)
}

fn check_block(p: *mut Checker, b: *mut ast.Tree, bi: u32) {
    var k: u32 = 0
    while k < ast.b_len(b, bi) {
        check_stmt(p, b, ast.slist_at(b, ast.b_off(b, bi) + k))
        k = k + 1
    }
}

fn check_stmt(p: *mut Checker, b: *mut ast.Tree, i: u32) {
    let a: u32 = ast.s_kind(b, i)
    if a == ast.S_LET || a == ast.S_VAR {
        check_expr(p, b, ast.s_c(b, i))
        return
    }
    if a == ast.S_ZUW || a == ast.S_ZUWOP {
        check_write_target(p, b, ast.s_a(b, i))
        check_expr(p, b, ast.s_a(b, i))
        check_expr(p, b, ast.s_b(b, i))
        return
    }
    // ROUND 70: the step writes into the target as well, and has no value.
    if a == ast.S_STEP {
        check_write_target(p, b, ast.s_a(b, i))
        check_expr(p, b, ast.s_a(b, i))
        return
    }
    if a == ast.S_IF {
        check_expr(p, b, ast.s_a(b, i))
        check_block(p, b, ast.s_b(b, i))
        if ast.s_c(b, i) != ast.NOTHING {
            check_stmt(p, b, ast.s_c(b, i))
        }
        return
    }
    if a == ast.S_WHILE {
        check_expr(p, b, ast.s_a(b, i))
        check_block(p, b, ast.s_b(b, i))
        return
    }
    if a == ast.S_FOR {
        check_expr(p, b, ast.s_b(b, i))
        check_expr(p, b, ast.s_c(b, i))
        check_block(p, b, ast.s_d(b, i))
        return
    }
    if a == ast.S_RET {
        if ast.s_a(b, i) != ast.NOTHING {
            check_expr(p, b, ast.s_a(b, i))
        }
        return
    }
    if a == ast.S_EXPR {
        check_expr(p, b, ast.s_a(b, i))
        return
    }
    if a == ast.S_BLOCK {
        check_block(p, b, ast.s_a(b, i))
        return
    }
    if a == ast.S_DEFER || a == ast.S_ERRDEFER {
        // The deferred body runs in the same frame and follows
        // the same rules.
        check_stmt(p, b, ast.s_a(b, i))
        return
    }
    // S_BREAK / S_CONT: no calls.
}

// Rule 3: writing a GC pointer into a field (or into an array element).
// A plain assignment to a local variable stays on the
// stack, needs no insertion barrier and is allowed.
fn check_write_target(p: *mut Checker, b: *mut ast.Tree, target: u32) {
    let ty: u32 = sema.sema_ty((*p).sm as *mut sema.Sema, target)
    if !gc.gc_is_gc_ref(gcr(p), table(p), ty) {
        return
    }
    let a: u32 = ast.e_kind(b, target)
    if a == ast.E_FIELD {
        report_write_field(p, name_pos(b, target), ast.e_b(b, target))
        return
    }
    if a == ast.E_IDX {
        // `local_array[i]` lives on the stack -- allowed.
        if ast.e_kind(b, ast.e_a(b, target)) == ast.E_ID {
            return
        }
        report_write_elem(p, ast.expr_pos(b, target), ast.expr_len(b, target))
        return
    }
    if a == ast.E_UN && ast.e_a(b, target) == 3 {
        report_write_deref(p, ast.expr_pos(b, target), ast.expr_len(b, target))
        return
    }
}

fn name_pos(b: *mut ast.Tree, e: u32) -> u64 {
    let a: u64 = ast.expr_aux(b, e)
    if a != 0 {
        return a
    }
    return ast.expr_pos(b, e)
}

fn check_expr(p: *mut Checker, b: *mut ast.Tree, e: u32) {
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_CALL {
        let name: u32 = ast.e_a(b, e)
        check_call(p, name, name_pos(b, e))
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            check_expr(p, b, ast.child_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        check_match_cases(p, name)
        return
    }
    // ROUND IFEXPR
    if a == ast.E_IFEX {
        check_expr(p, b, ast.e_a(b, e))
        check_expr(p, b, ast.e_b(b, e))
        check_expr(p, b, ast.e_c(b, e))
        return
    }
    if a == ast.E_UN {
        check_expr(p, b, ast.e_b(b, e))
        return
    }
    if a == ast.E_BIN {
        check_expr(p, b, ast.e_b(b, e))
        check_expr(p, b, ast.e_c(b, e))
        return
    }
    if a == ast.E_FIELD {
        check_expr(p, b, ast.e_a(b, e))
        return
    }
    if a == ast.E_IDX {
        check_expr(p, b, ast.e_a(b, e))
        check_expr(p, b, ast.e_b(b, e))
        return
    }
    if a == ast.E_SYSCALL || a == ast.E_ALIT {
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            check_expr(p, b, ast.child_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        return
    }
    // ROUND 70 (strtype.rs): the text literal carries its array literal inside.
    if a == ast.E_TEXT {
        check_expr(p, b, ast.e_a(b, e))
        return
    }
    if a == ast.E_AS {
        check_expr(p, b, ast.e_a(b, e))
        return
    }
    if a == ast.E_SLIT {
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            check_expr(p, b, ast.child_at(b, ast.e_b(b, e) + k * 2 + 1))
            k = k + 1
        }
        return
    }
    if a == ast.E_AWDH {
        check_expr(p, b, ast.e_a(b, e))
        check_expr(p, b, ast.e_b(b, e))
        return
    }
    if a == ast.E_LAMBDA {
        if (ast.e_number(b, e) & 1) == 1 {
            report_closure_alloc(p, ast.expr_pos(b, e), ast.expr_len(b, e))
        }
        let lf: i64 = ast.fn_find(b, ast.e_a(b, e))
        if lf >= 0 {
            check_block(p, b, ast.fn_body(b, lf as usize))
        }
        return
    }
    // E_INT / E_FLOAT / E_BOOL / E_ID: leaves.
}

fn check_call(p: *mut Checker, name: u32, pos: u64) {
    // Rule 1: GC allocation -- can trigger a collection.
    if gc.gc_is_alloc_call(gcr(p), names(p), name) {
        report_alloc(p, pos, name)
        return
    }
    // ROUND 45 (nogc.rs): a method call cannot be resolved here --
    // which function is behind it is known only from the type of the receiver.
    // Reject it explicitly instead of stepping over it silently: a hole
    // in a promise would be worse than a missing convenience.
    if is_method_call(names(p), name) {
        report_method(p, pos, name)
        return
    }
    if is_interner_name(names(p), name) {
        return
    }
    // Rule 2: call without #[no_gc] -- breaks the chain.
    if marking(p, name) == 2 {
        report_call(p, pos, name)
        return
    }
}

// `match` sits in the tree as the call `__match#N`; the body blocks of
// the arms live in the registry of `pattern.fi`. Without this descent
// every state machine would be a blind spot (tests/541, tests/neg/nogc_match_case).
fn check_match_cases(p: *mut Checker, name: u32) {
    if (*p).mu == 0 {
        return
    }
    if !pattern.pat_is_matchname(names(p), name) {
        return
    }
    let mi: u32 = pattern.pat_match_number(names(p), name)
    let m: *mut pattern.Pat = mul(p)
    let b: *mut ast.Tree = sema.sema_tree((*p).sm as *mut sema.Sema)
    if (*p).depth >= MAX_DEPTH {
        return
    }
    (*p).depth = (*p).depth + 1
    check_expr(p, b, pattern.pat_m_subj(m, mi))
    let aoff: u32 = pattern.pat_m_aoff(m, mi)
    let alen: u32 = pattern.pat_m_alen(m, mi)
    var k: u32 = 0
    while k < alen {
        check_block(p, b, pattern.pat_a_block(m, aoff + k))
        k = k + 1
    }
    (*p).depth = (*p).depth - 1
}
