// lib/firnc1/nogc.fi — die `#[no_gc]`-Zusage fuer heisse Pfade, transitiv
// geprueft (SPEC 3.5.4). Fuenfzehnter Teil von Stufe 1: die Portierung von
// `compiler/src/nogc.rs` (Runde 34).
//
// In einer `#[no_gc]`-Funktion sind verboten:
//  1. GC-Allokation (und jeder Aufruf, der einen Sammellauf ausloesen kann),
//  2. Aufruf einer Funktion OHNE `#[no_gc]`,
//  3. Schreiben eines `Gc[T]`/`GcWeak[T]`-Zeigers in ein Feld oder ein
//     Feldelement (Einfuegebarriere).
//
// Weil jede aufgerufene Funktion selbst `#[no_gc]` tragen muss, gilt die
// Zusage fuer den ganzen Aufrufbaum — auch ueber Modulgrenzen hinweg (die
// Namen sind dann schon zu `modul__name` umgeschrieben, der Pruefer sieht
// den flachen Baum). Die GC-Abfragen (1 und 3) kommen aus `gc.fi` — genau
// die zwei Vertragsfunktionen, deren Signaturen in Stufe 0 festgelegt sind.
//
// Umfang, ehrlich benannt (wie Stufe 0):
//  * Geprueft werden alle Aufrufe im Rumpf, EINSCHLIESSLICH der Rumpfbloecke
//    von `match`-Faellen — die liegen nicht im Baum, sondern in der
//    Registrierung von `pattern.fi`.
//  * Compilerinterne Aufrufnamen (`__match#N`, `__try#`, `__catch#`,
//    `Enum::Variante`) sind keine Funktionsaufrufe; ihre Argumente werden
//    trotzdem durchsucht.
//  * Aufrufe eines Namens, den es gar nicht gibt, meldet die Typpruefung
//    selbst — hier gibt es dafuer keinen zweiten Fehler.

import rt
import vec
import intern
import ast
import types
import pattern
import gc
import sema

export { nogc_check }

const KEIN: u32 = 4294967295

// Hoechste Schachtelung von `match`-Faellen, in die hineingesehen wird
// (zweite Sicherung gegen eine Rekursionsexplosion, wie in Stufe 0).
const MAX_TIEFE: u32 = 256

struct Checker {
    sm: u64,            // der Typpruefer (Typtabelle der Ausdruecke)
    mu: u64,            // Muster-Registrierung
    gcr: u64,           // GC-Registrierung
    it: u64,            // Interner
    m_name: Vec[u32],   // Funktionsname ->
    m_flag: Vec[u32],   // 1 = traegt `#[no_gc]`
    err: usize,
    depth: u32,         // Schachtelungstiefe der `match`-Rumpfbloecke
}

fn names(p: *mut Checker) -> *mut intern.Interner { return (*p).it as *mut intern.Interner }
fn gcr(p: *mut Checker) -> *mut gc.Gc { return (*p).gcr as *mut gc.Gc }
fn table(p: *mut Checker) -> *mut types.Types {
    return sema.sema_types((*p).sm as *mut sema.Sema)
}
fn mul(p: *mut Checker) -> *mut pattern.Pat { return (*p).mu as *mut pattern.Pat }

// 0 = unbekannt (meldet die Typpruefung selbst), 1 = markiert, 2 = kalt.
fn marking(p: *mut Checker, name: u32) -> u32 {
    var i: usize = 0
    while i < vec_len[u32](&(*p).m_name) {
        if vec_at[u32](&(*p).m_name, i) == name {
            if vec_at[u32](&(*p).m_flag, i) == 1 {
                return 1
            }
            return 2
        }
        i = i + 1
    }
    return 0
}

// Compilerintern erzeugter Aufrufname: enthaelt `#` oder `::`, kann also
// nie aus einem Bezeichner des Quelltextes entstehen.
fn is_method_call(it: *mut intern.Interner, name: u32) -> bool {
    var w: [u8; 8] = "methode "
    return intern.intern_prefix(it, name, (&w[0]) as u64, 8)
}

fn is_interner_name(it: *mut intern.Interner, nr: u32) -> bool {
    let p: u64 = intern.intern_ptr(it, nr)
    let n: usize = intern.intern_length(it, nr)
    var i: usize = 0
    while i < n {
        let b: u8 = rt.ld8(p, i)
        if b == 35 as u8 {
            return true
        }
        if b == 58 as u8 && i + 1 < n && rt.ld8(p, i + 1) == 58 as u8 {
            return true
        }
        i = i + 1
    }
    return false
}

// Der eigentliche Durchlauf. Rueckgabe: Zahl der Verstoesse.
fn nogc_check(sm: u64, mu: u64, gcr2: u64, it: u64) -> usize {
    var p: Checker = Checker{
        sm: sm, mu: mu, gcr: gcr2, it: it,
        m_name: vec_new[u32](), m_flag: vec_new[u32](),
        err: 0, depth: 0,
    }
    let b: *mut ast.Tree = sema.sema_tree(p.sm as *mut sema.Sema)
    // Die Markierungen einsammeln. Bei doppelt deklarierten Namen (eigener
    // Fehler der Typpruefung) zaehlt die strengere Angabe: markiert bleibt
    // markiert.
    var i: usize = 0
    while i < ast.fn_count(b) {
        let nm: u32 = ast.fn_name(b, i)
        let fl: u32 = ast.fn_nogc(b, i)
        var j: usize = 0
        var hit: bool = false
        while j < vec_len[u32](&p.m_name) {
            if vec_at[u32](&p.m_name, j) == nm {
                if fl == 1 {
                    vec_set[u32](&p.m_flag, j, 1)
                }
                hit = true
            }
            j = j + 1
        }
        if !hit {
            vec_push[u32](&p.m_name, nm)
            vec_push[u32](&p.m_flag, fl)
        }
        i = i + 1
    }
    var a: bool = false
    i = 0
    while i < vec_len[u32](&p.m_flag) {
        if vec_at[u32](&p.m_flag, i) == 1 {
            a = true
        }
        i = i + 1
    }
    if a {
        i = 0
        while i < ast.fn_count(b) {
            if ast.fn_nogc(b, i) == 1 {
                check_block(&p, b, ast.fn_body(b, i))
            }
            i = i + 1
        }
    }
    let out: usize = p.err
    vec_free[u32](&p.m_name)
    vec_free[u32](&p.m_flag)
    return out
}

fn check_block(p: *mut Checker, b: *mut ast.Tree, bi: u32) {
    var k: u32 = 0
    while k < ast.b_len(b, bi) {
        check_stmt(p, b, ast.slist_at(b, ast.b_off(b, bi) + k))
        k = k + 1
    }
}

fn check_stmt(p: *mut Checker, b: *mut ast.Tree, i: u32) {
    let a: u32 = ast.s_kind(b, i)
    if a == ast.S_LET || a == ast.S_VAR {
        check_expr(p, b, ast.s_c(b, i))
        return
    }
    if a == ast.S_ZUW {
        check_write_target(p, b, ast.s_a(b, i))
        check_expr(p, b, ast.s_a(b, i))
        check_expr(p, b, ast.s_b(b, i))
        return
    }
    if a == ast.S_IF {
        check_expr(p, b, ast.s_a(b, i))
        check_block(p, b, ast.s_b(b, i))
        if ast.s_c(b, i) != ast.NICHTS {
            check_stmt(p, b, ast.s_c(b, i))
        }
        return
    }
    if a == ast.S_WHILE {
        check_expr(p, b, ast.s_a(b, i))
        check_block(p, b, ast.s_b(b, i))
        return
    }
    if a == ast.S_FOR {
        check_expr(p, b, ast.s_b(b, i))
        check_expr(p, b, ast.s_c(b, i))
        check_block(p, b, ast.s_d(b, i))
        return
    }
    if a == ast.S_RET {
        if ast.s_a(b, i) != ast.NICHTS {
            check_expr(p, b, ast.s_a(b, i))
        }
        return
    }
    if a == ast.S_EXPR {
        check_expr(p, b, ast.s_a(b, i))
        return
    }
    if a == ast.S_BLOCK {
        check_block(p, b, ast.s_a(b, i))
        return
    }
    if a == ast.S_DEFER || a == ast.S_ERRDEFER {
        // Der aufgeschobene Rumpf laeuft im selben Rahmen und unterliegt
        // denselben Regeln.
        check_stmt(p, b, ast.s_a(b, i))
        return
    }
    // S_BREAK / S_CONT: keine Aufrufe.
}

// Regel 3: Schreiben eines GC-Zeigers in ein Feld (oder in ein Feldelement).
// Eine reine Zuweisung an eine oertliche Veraenderliche liegt auf dem
// Stapel, braucht keine Einfuegebarriere und ist erlaubt.
fn check_write_target(p: *mut Checker, b: *mut ast.Tree, target: u32) {
    let ty: u32 = sema.sema_ty((*p).sm as *mut sema.Sema, target)
    if !gc.gc_is_gc_ref(gcr(p), table(p), ty) {
        return
    }
    let a: u32 = ast.e_kind(b, target)
    if a == ast.E_FELD {
        (*p).err = (*p).err + 1
        return
    }
    if a == ast.E_IDX {
        // `lokales_feld[i]` liegt auf dem Stapel — erlaubt.
        if ast.e_kind(b, ast.e_a(b, target)) == ast.E_ID {
            return
        }
        (*p).err = (*p).err + 1
        return
    }
    if a == ast.E_UN && ast.e_a(b, target) == 3 {
        (*p).err = (*p).err + 1
        return
    }
}

fn check_expr(p: *mut Checker, b: *mut ast.Tree, e: u32) {
    let a: u32 = ast.e_kind(b, e)
    if a == ast.E_RUF {
        let name: u32 = ast.e_a(b, e)
        check_call(p, name)
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            check_expr(p, b, ast.child_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        check_match_cases(p, name)
        return
    }
    if a == ast.E_UN {
        check_expr(p, b, ast.e_b(b, e))
        return
    }
    if a == ast.E_BIN {
        check_expr(p, b, ast.e_b(b, e))
        check_expr(p, b, ast.e_c(b, e))
        return
    }
    if a == ast.E_FELD {
        check_expr(p, b, ast.e_a(b, e))
        return
    }
    if a == ast.E_IDX {
        check_expr(p, b, ast.e_a(b, e))
        check_expr(p, b, ast.e_b(b, e))
        return
    }
    if a == ast.E_SYSCALL || a == ast.E_ALIT {
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            check_expr(p, b, ast.child_at(b, ast.e_b(b, e) + k))
            k = k + 1
        }
        return
    }
    if a == ast.E_AS {
        check_expr(p, b, ast.e_a(b, e))
        return
    }
    if a == ast.E_SLIT {
        var k: u32 = 0
        while k < ast.e_c(b, e) {
            check_expr(p, b, ast.child_at(b, ast.e_b(b, e) + k * 2 + 1))
            k = k + 1
        }
        return
    }
    if a == ast.E_AWDH {
        check_expr(p, b, ast.e_a(b, e))
        check_expr(p, b, ast.e_b(b, e))
        return
    }
    // E_INT / E_FLOAT / E_BOOL / E_ID: Blaetter.
}

fn check_call(p: *mut Checker, name: u32) {
    // Regel 1: GC-Allokation — kann einen Sammellauf ausloesen.
    if gc.gc_is_alloc_call(gcr(p), names(p), name) {
        (*p).err = (*p).err + 1
        return
    }
    // RUNDE 45 (nogc.rs): ein Methodenaufruf ist hier nicht aufloesbar —
    // welche Funktion dahintersteht, weiss nur der Typ des Empfaengers.
    // Ausdruecklich ablehnen statt stillschweigend uebergehen: ein Loch in
    // einer Zusage waere schlimmer als eine fehlende Bequemlichkeit.
    if is_method_call(names(p), name) {
        (*p).err = (*p).err + 1
        return
    }
    if is_interner_name(names(p), name) {
        return
    }
    // Regel 2: Aufruf ohne #[no_gc] — bricht die Kette.
    if marking(p, name) == 2 {
        (*p).err = (*p).err + 1
        return
    }
}

// `match` steht als Aufruf `__match#N` im Baum; die Rumpfbloecke der Faelle
// liegen in der Registrierung von `pattern.fi`. Ohne diesen Abstieg waere
// jede Zustandsmaschine ein blinder Fleck (tests/541, tests/neg/nogc_match_fall).
fn check_match_cases(p: *mut Checker, name: u32) {
    if (*p).mu == 0 {
        return
    }
    if !pattern.pat_is_matchname(names(p), name) {
        return
    }
    let mi: u32 = pattern.pat_match_number(names(p), name)
    let m: *mut pattern.Pat = mul(p)
    let b: *mut ast.Tree = sema.sema_tree((*p).sm as *mut sema.Sema)
    if (*p).depth >= MAX_TIEFE {
        return
    }
    (*p).depth = (*p).depth + 1
    check_expr(p, b, pattern.pat_m_subj(m, mi))
    let aoff: u32 = pattern.pat_m_aoff(m, mi)
    let alen: u32 = pattern.pat_m_alen(m, mi)
    var k: u32 = 0
    while k < alen {
        check_block(p, b, pattern.pat_a_block(m, aoff + k))
        k = k + 1
    }
    (*p).depth = (*p).depth - 1
}
