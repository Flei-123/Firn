// SPDX-License-Identifier: MPL-2.0

import vec

export { Deps, deps_new, deps_free, deps_begin, deps_note, deps_end, deps_stale, deps_changed }

struct Deps {
    start: Vec[u32],
    count: Vec[u32],
    pool: Vec[u32],
    seen: Vec[u32],
    changed: Vec[u32],
    run: u32,
    open: bool,
}

fn deps_new(n: usize) -> Deps {
    var d: Deps = Deps {
        start: vec_new[u32](), count: vec_new[u32](), pool: vec_new[u32](),
        seen: vec_new[u32](), changed: vec_new[u32](), run: 0, open: false,
    }
    var i: usize = 0
    while i < n {
        vec_push[u32](&d.start, 0)
        vec_push[u32](&d.count, 0)
        vec_push[u32](&d.seen, 0)
        vec_push[u32](&d.changed, 0)
        i = i + 1
    }
    return d
}

fn deps_free(d: *mut Deps) {
    vec_free[u32](&(*d).start)
    vec_free[u32](&(*d).count)
    vec_free[u32](&(*d).pool)
    vec_free[u32](&(*d).seen)
    vec_free[u32](&(*d).changed)
}

fn deps_begin(d: *mut Deps, fi: usize) {
    (*d).run = (*d).run + 1
    (*d).open = true
    vec_set[u32](&(*d).start, fi, vec_len[u32](&(*d).pool) as u32)
}

fn deps_note(d: *mut Deps, callee: usize) {
    if !(*d).open {
        return
    }
    if vec_at[u32](&(*d).seen, callee) == (*d).run {
        return
    }
    vec_set[u32](&(*d).seen, callee, (*d).run)
    vec_push[u32](&(*d).pool, callee as u32)
}

fn deps_end(d: *mut Deps, fi: usize) {
    (*d).open = false
    vec_set[u32](&(*d).count, fi, (vec_len[u32](&(*d).pool) as u32) - vec_at[u32](&(*d).start, fi))
}

fn deps_changed(d: *mut Deps, fi: usize, round: u32) {
    vec_set[u32](&(*d).changed, fi, round)
}

fn deps_stale(d: *mut Deps, fi: usize, round: u32) -> bool {
    let s: u32 = vec_at[u32](&(*d).start, fi)
    let n: u32 = vec_at[u32](&(*d).count, fi)
    var k: u32 = 0
    while k < n {
        let c: u32 = vec_at[u32](&(*d).pool, (s + k) as usize)
        if vec_at[u32](&(*d).changed, c as usize) == round {
            return true
        }
        k = k + 1
    }
    return false
}
