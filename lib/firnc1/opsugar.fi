// SPDX-License-Identifier: MPL-2.0
import rt
import intern
import ast

export { KIND_NONE, KIND_ARITH, KIND_EQ, KIND_ORD, KIND_NEG, bin_kind, plain_name,
    rewrite_binary, rewrite_neg }

const KIND_NONE: u32 = 0
const KIND_ARITH: u32 = 1
const KIND_EQ: u32 = 2
const KIND_ORD: u32 = 3
const KIND_NEG: u32 = 4

const OP_ADD: u32 = 0
const OP_SUB: u32 = 1
const OP_MUL: u32 = 2
const OP_DIV: u32 = 3
const OP_EQ: u32 = 10
const OP_NE: u32 = 11
const OP_GE: u32 = 15
const UN_NEG: u32 = 0
const UN_NOT: u32 = 1

fn bin_kind(op: u32) -> u32 {
    if op >= OP_ADD && op <= OP_DIV {
        return KIND_ARITH
    }
    if op == OP_EQ || op == OP_NE {
        return KIND_EQ
    }
    if op > OP_NE && op <= OP_GE {
        return KIND_ORD
    }
    return KIND_NONE
}

fn name_of(it: *mut intern.Interner, prefix: u64, prefix_len: usize, word: u64, word_len: usize) -> u32 {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, prefix, prefix_len)
    rt.buf_push_bytes(&b, word, word_len)
    let nr: u32 = intern.intern_number(it, rt.buf_ptr(&b), rt.buf_len(&b)) as u32
    rt.buf_free(&b)
    return nr
}

fn plain_name(it: *mut intern.Interner, kind: u32, op: u32) -> u32 {
    var add: [u8; 3] = "add"
    var sub: [u8; 3] = "sub"
    var mul: [u8; 3] = "mul"
    var div: [u8; 3] = "div"
    var eq: [u8; 2] = "eq"
    var cmp: [u8; 3] = "cmp"
    var neg: [u8; 3] = "neg"
    if kind == KIND_EQ {
        return intern.intern_number(it, (&eq[0]) as u64, 2) as u32
    }
    if kind == KIND_ORD {
        return intern.intern_number(it, (&cmp[0]) as u64, 3) as u32
    }
    if kind == KIND_NEG {
        return intern.intern_number(it, (&neg[0]) as u64, 3) as u32
    }
    if op == OP_ADD {
        return intern.intern_number(it, (&add[0]) as u64, 3) as u32
    }
    if op == OP_SUB {
        return intern.intern_number(it, (&sub[0]) as u64, 3) as u32
    }
    if op == OP_MUL {
        return intern.intern_number(it, (&mul[0]) as u64, 3) as u32
    }
    return intern.intern_number(it, (&div[0]) as u64, 3) as u32
}

fn call_name(it: *mut intern.Interner, plain: u32) -> u32 {
    var w: [u8; 7] = "method "
    return name_of(it, (&w[0]) as u64, 7, intern.intern_ptr(it, plain), intern.intern_length(it, plain))
}

fn call_node(b: *mut ast.Tree, it: *mut intern.Interner, e: u32, plain: u32, first: u32, second: u32, count: u32) -> u32 {
    let off: u32 = ast.child_start(b)
    ast.child_add(b, first)
    if count == 2 {
        ast.child_add(b, second)
    }
    let c: u32 = ast.expr_new(b, ast.E_CALL, call_name(it, plain), off, count, 0)
    ast.expr_pos_set(b, c, ast.expr_pos(b, e))
    ast.expr_len_set(b, c, ast.expr_len(b, e))
    ast.expr_aux_set(b, c, ast.expr_pos(b, e))
    return c
}

fn rewrite_binary(b: *mut ast.Tree, it: *mut intern.Interner, e: u32, kind: u32, plain: u32) {
    let op: u32 = ast.e_a(b, e)
    let l: u32 = ast.e_b(b, e)
    let r: u32 = ast.e_c(b, e)
    let c: u32 = call_node(b, it, e, plain, l, r, 2)
    if kind == KIND_ARITH {
        ast.e_kind_set(b, e, ast.E_CALL)
        ast.e_a_set(b, e, ast.e_a(b, c))
        ast.e_b_set(b, e, ast.e_b(b, c))
        ast.e_c_set(b, e, 2)
        ast.expr_aux_set(b, e, ast.expr_pos(b, e))
        return
    }
    if kind == KIND_EQ {
        if op == OP_EQ {
            ast.e_kind_set(b, e, ast.E_CALL)
            ast.e_a_set(b, e, ast.e_a(b, c))
            ast.e_b_set(b, e, ast.e_b(b, c))
            ast.e_c_set(b, e, 2)
            ast.expr_aux_set(b, e, ast.expr_pos(b, e))
            return
        }
        ast.e_kind_set(b, e, ast.E_UN)
        ast.e_a_set(b, e, UN_NOT)
        ast.e_b_set(b, e, c)
        return
    }
    let z: u32 = ast.expr_new(b, ast.E_INT, 0, 0, 0, 0)
    ast.expr_pos_set(b, z, ast.expr_pos(b, e))
    ast.expr_len_set(b, z, ast.expr_len(b, e))
    ast.e_b_set(b, e, c)
    ast.e_c_set(b, e, z)
}

fn rewrite_neg(b: *mut ast.Tree, it: *mut intern.Interner, e: u32, plain: u32) {
    let inner: u32 = ast.e_b(b, e)
    let c: u32 = call_node(b, it, e, plain, inner, 0, 1)
    ast.e_kind_set(b, e, ast.E_CALL)
    ast.e_a_set(b, e, ast.e_a(b, c))
    ast.e_b_set(b, e, ast.e_b(b, c))
    ast.e_c_set(b, e, 1)
    ast.expr_aux_set(b, e, ast.expr_pos(b, e))
}
