fn gctext_write(b: *mut rt.Buf, with_collections: bool) {
    var limit: u64 = GCTEXT_N
    if with_collections {
        limit = GCTEXT_ALL
    }
    var written: u64 = 0
    var i: usize = 0
    while i < 30090 {
        let v: u64 = GCTEXT_WORDS[i]
        var k: u64 = 0
        while k < 8 {
            if written >= limit {
                return
            }
            rt.buf_push(b, ((v >> (k * 8)) & 255) as u8)
            written = written + 1
            k = k + 1
        }
        i = i + 1
    }
}
