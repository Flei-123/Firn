// SPDX-License-Identifier: MPL-2.0

import rt
import intern
import lexer
import diag

export { gcfree_scan, gcfree_report, gcfree_index, gcfree_what, NOT_FOUND }

const NOT_FOUND: u64 = 18446744073709551615
const KIND_IDENT: u32 = 1
const KIND_FN: u32 = 4
const KIND_LBRACKET: u32 = 38
const WHAT_CLASS: u32 = 1
const WHAT_FN: u32 = 2
const WHAT_GC: u32 = 3
const WHAT_WEAK: u32 = 4
const WHAT_COLLECTION: u32 = 5
const WHAT_SHIFT: u64 = 8

fn kind_at(base: u64, i: usize) -> u32 {
    return *((base +% (i as u64) *% 4) as *mut u32)
}

fn starts_with(p: u64, n: usize, prefix: u64, pn: usize) -> bool {
    if n < pn {
        return false
    }
    return rt.mem_eq(p, prefix, pn)
}

fn is_collection_name(p: u64, n: usize) -> bool {
    var vec_up: [u8; 5] = "GcVec"
    var map_up: [u8; 5] = "GcMap"
    var vec_low: [u8; 6] = "gcvec_"
    var map_low: [u8; 6] = "gcmap_"
    return starts_with(p, n, (&vec_up[0]) as u64, 5) || starts_with(p, n, (&map_up[0]) as u64, 5)
        || starts_with(p, n, (&vec_low[0]) as u64, 6) || starts_with(p, n, (&map_low[0]) as u64, 6)
}

fn pack(index: usize, what: u32) -> u64 {
    return ((index as u64) << WHAT_SHIFT) | (what as u64)
}

fn gcfree_index(found: u64) -> usize {
    return (found >> WHAT_SHIFT) as usize
}

fn gcfree_what(found: u64) -> u32 {
    return (found & 255) as u32
}

fn gcfree_scan(l: *mut lexer.Lexer, it: *mut intern.Interner) -> u64 {
    var w_gc: [u8; 2] = "gc"
    var w_class: [u8; 5] = "class"
    var w_gc_t: [u8; 2] = "Gc"
    var w_weak: [u8; 6] = "GcWeak"
    let gc_nr: u32 = intern.intern_number(it, (&w_gc[0]) as u64, 2) as u32
    let class_nr: u32 = intern.intern_number(it, (&w_class[0]) as u64, 5) as u32
    let gc_t_nr: u32 = intern.intern_number(it, (&w_gc_t[0]) as u64, 2) as u32
    let weak_nr: u32 = intern.intern_number(it, (&w_weak[0]) as u64, 6) as u32
    let n: usize = lexer.lex_count(l)
    let kp: u64 = lexer.lex_kind_ptr(l)
    let np: u64 = lexer.lex_nr_ptr(l)
    var i: usize = 0
    while i < n {
        if kind_at(kp, i) != KIND_IDENT {
            i = i + 1
            continue
        }
        let nr: u32 = kind_at(np, i)
        var next: u32 = 0
        if i + 1 < n {
            next = kind_at(kp, i + 1)
        }
        if nr == gc_nr && next == KIND_IDENT && kind_at(np, i + 1) == class_nr {
            return pack(i, WHAT_CLASS)
        }
        if nr == gc_nr && next == KIND_FN {
            return pack(i, WHAT_FN)
        }
        if (nr == gc_t_nr || nr == weak_nr) && next == KIND_LBRACKET {
            if nr == gc_t_nr {
                return pack(i, WHAT_GC)
            }
            return pack(i, WHAT_WEAK)
        }
        if is_collection_name(intern.intern_ptr(it, nr), intern.intern_length(it, nr)) {
            return pack(i, WHAT_COLLECTION)
        }
        i = i + 1
    }
    return NOT_FOUND
}

fn gcfree_report(l: *mut lexer.Lexer, found: u64) {
    let at: usize = gcfree_index(found)
    let what: u32 = gcfree_what(found)
    var t_class: [u8; 10] = "'gc class'"
    var t_fn: [u8; 7] = "'gc fn'"
    var t_gc: [u8; 7] = "'Gc[T]'"
    var t_weak: [u8; 11] = "'GcWeak[T]'"
    var t_coll: [u8; 13] = "'GcVec/GcMap'"
    var t_suffix: [u8; 56] = " needs the garbage collector, which '--no-gc' leaves out"
    var t_help: [u8; 72] = "own heap values with Vec, Box, Rc or std.str.Bytes (ownership-only mode)"
    var msg: rt.Buf = rt.buf_new()
    if what == WHAT_CLASS {
        rt.buf_push_bytes(&msg, (&t_class[0]) as u64, 10)
    } else if what == WHAT_FN {
        rt.buf_push_bytes(&msg, (&t_fn[0]) as u64, 7)
    } else if what == WHAT_GC {
        rt.buf_push_bytes(&msg, (&t_gc[0]) as u64, 7)
    } else if what == WHAT_WEAK {
        rt.buf_push_bytes(&msg, (&t_weak[0]) as u64, 11)
    } else {
        rt.buf_push_bytes(&msg, (&t_coll[0]) as u64, 13)
    }
    rt.buf_push_bytes(&msg, (&t_suffix[0]) as u64, 56)
    diag.diag_error_help(lexer.lex_diags(l), lexer.lex_file_index(l), lexer.lex_line(l, at),
        lexer.lex_col(l, at), lexer.lex_length(l, at), rt.buf_ptr(&msg), rt.buf_len(&msg),
        (&t_help[0]) as u64, 72)
    rt.buf_free(&msg)
}
