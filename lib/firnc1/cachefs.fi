// SPDX-License-Identifier: MPL-2.0
// lib/firnc1/cachefs.fi -- file system calls of the compile cache.

import rt
import vec

export {
    FileInfo, fs_info_new, fs_stat, fs_is_file, fs_read_prefix, fs_write_atomic, fs_mkdir_all,
    fs_touch, fs_list, fs_pid, fs_now_ns, fs_unlink,
}

const SYS_FSTAT: i64 = 5
const SYS_STAT: i64 = 4
const SYS_GETPID: i64 = 39
const SYS_RENAME: i64 = 82
const SYS_MKDIR: i64 = 83
const SYS_GETDENTS64: i64 = 217
const SYS_CLOCK_GETTIME: i64 = 228
const SYS_UTIMENSAT: i64 = 280
const AT_FDCWD: i64 = -100
const O_NEW: i64 = 193
const MODE_FILE: i64 = 420
const MODE_DIR: i64 = 493

struct FileInfo {
    size: u64,
    mtime_ns: u64,
    regular: bool,
}

fn fs_info_new() -> FileInfo {
    return FileInfo { size: 0, mtime_ns: 0, regular: false }
}

fn fs_stat(path: u64, out: *mut FileInfo) -> bool {
    var st: [u64; 18] = [0; 18]
    if syscall(SYS_STAT, path as i64, (&st[0]) as u64 as i64, 0, 0, 0, 0) < 0 {
        return false
    }
    (*out).size = st[6]
    (*out).mtime_ns = st[11] * 1000000000 + st[12]
    (*out).regular = (st[3] & 61440) == 32768
    return true
}

fn fs_is_file(path: u64) -> bool {
    var info: FileInfo = fs_info_new()
    return fs_stat(path, &info) && info.regular
}

fn fs_pid() -> u64 {
    return syscall(SYS_GETPID, 0, 0, 0, 0, 0, 0) as u64
}

fn fs_now_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(SYS_CLOCK_GETTIME, 0, (&ts[0]) as u64 as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000000 + (ts[1] as u64)
}

fn fs_unlink(path: u64) -> bool {
    return rt.unlink_file(path)
}

fn fs_touch(path: u64) {
    syscall(SYS_UTIMENSAT, AT_FDCWD, path as i64, 0, 0, 0, 0)
}

fn fs_mkdir_all(path: u64, n: usize) -> bool {
    var tmp: rt.Buf = rt.buf_new()
    var i: usize = 1
    while i <= n {
        if i == n || rt.ld8(path, i) == 47 as u8 {
            rt.buf_clear(&tmp)
            rt.buf_push_bytes(&tmp, path, i)
            rt.buf_push(&tmp, 0 as u8)
            syscall(SYS_MKDIR, rt.buf_ptr(&tmp) as i64, MODE_DIR, 0, 0, 0, 0)
        }
        i = i + 1
    }
    rt.buf_free(&tmp)
    var info: FileInfo = fs_info_new()
    return fs_stat(path, &info) && !info.regular
}

fn fs_read_prefix(path: u64, out: *mut rt.Buf, want: usize) -> i64 {
    let fd: i64 = syscall(2, path as i64, 0, 0, 0, 0, 0)
    if fd < 0 {
        return -1
    }
    var st: [u64; 18] = [0; 18]
    if syscall(SYS_FSTAT, fd, (&st[0]) as u64 as i64, 0, 0, 0, 0) < 0 {
        syscall(3, fd, 0, 0, 0, 0, 0)
        return -1
    }
    rt.buf_reserve(out, rt.buf_len(out) + want)
    var got: usize = 0
    var more: bool = true
    while more && got < want {
        let r: i64 = syscall(0, fd, (rt.buf_ptr(out) + (rt.buf_len(out) + got) as u64) as i64,
            (want - got) as i64, 0, 0, 0)
        if r <= 0 {
            more = false
        } else {
            got = got + r as usize
        }
    }
    rt.buf_set_len(out, rt.buf_len(out) + got)
    syscall(3, fd, 0, 0, 0, 0, 0)
    return st[6] as i64
}

fn fs_write_atomic(dir: u64, dir_n: usize, target: u64, p: u64, n: usize, nonce: u64) -> bool {
    var tmp: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&tmp, dir, dir_n)
    var tag: [u8; 6] = "/.tmp-"
    rt.buf_push_bytes(&tmp, (&tag[0]) as u64, 6)
    rt.buf_push_dec_u64(&tmp, fs_pid())
    rt.buf_push(&tmp, 45 as u8)
    rt.buf_push_dec_u64(&tmp, nonce)
    rt.buf_push(&tmp, 0 as u8)
    let fd: i64 = syscall(2, rt.buf_ptr(&tmp) as i64, O_NEW, MODE_FILE, 0, 0, 0)
    var ok: bool = fd >= 0
    if ok {
        ok = rt.write_everything(fd, p, n)
        syscall(3, fd, 0, 0, 0, 0, 0)
    }
    if ok {
        ok = syscall(SYS_RENAME, rt.buf_ptr(&tmp) as i64, target as i64, 0, 0, 0, 0) == 0
    }
    if !ok {
        rt.unlink_file(rt.buf_ptr(&tmp))
    }
    rt.buf_free(&tmp)
    return ok
}

fn is_dots(name: u64) -> bool {
    if rt.ld8(name, 0) != 46 as u8 {
        return false
    }
    if rt.ld8(name, 1) == 0 as u8 {
        return true
    }
    return rt.ld8(name, 1) == 46 as u8 && rt.ld8(name, 2) == 0 as u8
}

fn fs_list(dir: u64, names: *mut rt.Buf, offs: *mut Vec[u32]) -> bool {
    let fd: i64 = syscall(2, dir as i64, 65536, 0, 0, 0, 0)
    if fd < 0 {
        return false
    }
    var chunk: rt.Buf = rt.buf_new()
    rt.buf_reserve(&chunk, 32768)
    var more: bool = true
    while more {
        let r: i64 = syscall(SYS_GETDENTS64, fd, rt.buf_ptr(&chunk) as i64, 32768, 0, 0, 0)
        if r <= 0 {
            more = false
        } else {
            var at: usize = 0
            while at < r as usize {
                let base: u64 = rt.buf_ptr(&chunk) + at as u64
                let reclen: usize = rt.ld16(base, 8) as usize
                let name: u64 = base + 19
                if !is_dots(name) {
                    vec_push[u32](offs, rt.buf_len(names) as u32)
                    rt.buf_push_bytes(names, name, rt.c_length(name) + 1)
                }
                at = at + reclen
            }
        }
    }
    rt.buf_free(&chunk)
    syscall(3, fd, 0, 0, 0, 0, 0)
    return true
}
