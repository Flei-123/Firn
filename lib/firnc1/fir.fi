// lib/firnc1/fir.fi — DIE ZWISCHENDARSTELLUNG, IN FIRN.
//
// Siebter Teil von Stufe 1: die Portierung von `compiler/src/fir.rs`.
// Dieselben Zusicherungen wie dort (docs/FIR.md):
//
//   * typisiert — jede Instruktion hat einen Ergebnistyp
//   * SSA-artig — jede Instruktion definiert hoechstens EINEN Wert `%n`
//   * Basisbloecke mit GENAU EINEM Terminator am Ende
//   * KEINE Phi-Knoten: veraenderliche Variablen liegen in `alloca`-Plaetzen
//     und werden mit `load`/`store` angesprochen
//
// AUFBAU wie ueberall in Stufe 1: Struktur der Felder. Weil die Bloecke
// waehrend des Lowerings ABWECHSELND gefuellt werden, kann die Instruktions-
// liste eines Blocks nicht einfach ein Bereich in einem gemeinsamen Feld sein.
// Sie ist es trotzdem — sie zieht beim Wachsen ans Ende um. Das kostet
// Kopien, haelt aber alles in einem einzigen `Vec` und braucht keine
// verkettete Liste.
//
// DIE TEXTFORM IST VERTRAG: Oktett fuer Oktett wie `firnc0 --emit=fir-raw`.

import rt
import vec
import intern

export { Fir, fir_neu, fir_frei,
         T_I8, T_I16, T_I32, T_I64, T_U8, T_U16, T_U32, T_U64,
         T_BOOL, T_F64, T_PTR, T_VOID,
         O_CONST, O_BIN, O_CMP, O_UN, O_CAST, O_ALLOCA, O_LOAD, O_STORE,
         O_PTRADD, O_CALL, O_SYSCALL, O_COPYMEM, O_GCADDR, O_SELECT, O_SECZERO,
         O_ATOMADD, O_CALLI, O_VTAB, O_SPAWN, O_TLS, O_ATOMCAS,
         TERM_UNSET, TERM_BR, TERM_BRCOND, TERM_RET, TERM_SWITCH, KEIN,
         fn_neu, fn_anzahl, block_neu, block_anzahl,
         inst_dazu, inst_void_dazu, alloca_dazu, arg_dazu, arg_anfang,
         term_setzen, ist_terminiert,
         wert_anzahl, param_wert, fir_text, fty_bytes, fty_bits, fty_name,
         inst_anzahl, inst_bei, arg_bei, i_art_von, i_ty_von, i_dst_von,
         i_a_von, i_b_von, i_c_von, i_zahl_von, i_aoff_von, i_alen_von,
         b_term_von, b_t1_von, b_t2_von, b_t3_von, f_ret_von, f_plen_von,
         f_poff_von, p_typ_von, f_name_von,
         term_switch, sw_anfang, sw_dazu, b_t4_von, b_t5_von,
         sw_schluessel, sw_ziel }

const T_I8: u32 = 0
const T_I16: u32 = 1
const T_I32: u32 = 2
const T_I64: u32 = 3
const T_U8: u32 = 4
const T_U16: u32 = 5
const T_U32: u32 = 6
const T_U64: u32 = 7
const T_BOOL: u32 = 8
const T_F64: u32 = 9
const T_PTR: u32 = 10
const T_VOID: u32 = 11

const O_CONST: u32 = 0
const O_BIN: u32 = 1
const O_CMP: u32 = 2
const O_UN: u32 = 3
const O_CAST: u32 = 4
const O_ALLOCA: u32 = 5
const O_LOAD: u32 = 6
const O_STORE: u32 = 7
const O_PTRADD: u32 = 8
const O_CALL: u32 = 9
const O_SYSCALL: u32 = 10
const O_COPYMEM: u32 = 11
// Runde 34: Adresse des GC-Zustandsblocks (i_zahl: 1 = vorher die
// callee-saved Register dorthin retten — `Op::GcAddr { regs }` in Stufe 0).
const O_GCADDR: u32 = 12
// Runde 36 (ct.rs, SPEC §9.2/§9.3): datenunabhaengige Auswahl (`cmov`, kein
// Sprung) und das Nullen, das nie wegoptimiert werden darf (`rep stosb`).
const O_SELECT: u32 = 13
const O_SECZERO: u32 = 14
// Runde 47 (atomar.rs): atomares Lesen-Addieren-Schreiben, `lock xadd`.
// i_a = Adresse, i_b = Summand, Ergebnis ist der ALTE Wert. Immer 64 Bit.
const O_ATOMADD: u32 = 15
// Runde 46 (iface.rs): der dynamische Versand. `O_CALLI` ruft ueber einen
// ZEIGER (i_a = Ziel, Argumente wie bei `O_CALL`), `O_VTAB` liefert die
// Adresse einer Methodentafel (i_a = Name der Schnittstelle, i_b = Name des
// Typs; das Label heisst `.L__iface.<I>.<T>`).
const O_CALLI: u32 = 16
const O_VTAB: u32 = 17
// Runde 49 (faden.rs) — die Nummern 20 bis 29 sind fuer diese Runde
// reserviert; 18 und 19 bleiben frei fuer die parallel laufenden Runden.
//   O_SPAWN   i_a = Argument, i_b = obere Stapeladresse, i_c = TID-Wort.
//             Ergebnis: Fadenkennung (> 0) bzw. negativer Fehlerwert.
//   O_TLS     kein Operand. Ergebnis: eigener Fadenblock aus `fs:0`.
//   O_ATOMCAS i_a = Adresse, i_b = erwarteter Wert, i_c = neuer Wert.
//             Ergebnis: der VORGEFUNDENE Wert.
const O_SPAWN: u32 = 20
const O_TLS: u32 = 21
const O_ATOMCAS: u32 = 22

const TERM_UNSET: u32 = 0
const TERM_BR: u32 = 1
const TERM_BRCOND: u32 = 2
const TERM_RET: u32 = 3
// `switch` (Runde 32, `Term::Switch` in fir.rs): b_t1 = Schluesselwert,
// b_t2 = Auffangblock, b_t3 = Anfang der Fallliste in `sw_key`/`sw_ziel`,
// b_t4 = Laenge, b_t5 = Schluesseltyp. Die Fallliste ist flach, weil ein
// Terminator sonst nur drei Felder haette.
const TERM_SWITCH: u32 = 4

const KEIN: u32 = 4294967295

struct Fir {
    f_name: Vec[u32]
    f_ret: Vec[u32]
    f_poff: Vec[u32]
    f_plen: Vec[u32]
    f_boff: Vec[u32]
    f_blen: Vec[u32]
    f_werte: Vec[u32]
    p_typ: Vec[u32]
    b_ioff: Vec[u32]
    b_ilen: Vec[u32]
    b_term: Vec[u32]
    b_t1: Vec[u32]
    b_t2: Vec[u32]
    b_t3: Vec[u32]
    b_t4: Vec[u32]
    b_t5: Vec[u32]
    b_iliste: Vec[u32]
    i_art: Vec[u32]
    i_ty: Vec[u32]
    i_dst: Vec[u32]
    i_a: Vec[u32]
    i_b: Vec[u32]
    i_c: Vec[u32]
    i_zahl: Vec[u64]
    i_aoff: Vec[u32]
    i_alen: Vec[u32]
    i_args: Vec[u32]
    // Falllisten aller `switch`-Terminatoren, hintereinander
    sw_key: Vec[i64]
    sw_ziel: Vec[u32]
}

fn fir_neu() -> Fir {
    return Fir{
        f_name: vec_neu[u32](), f_ret: vec_neu[u32](),
        f_poff: vec_neu[u32](), f_plen: vec_neu[u32](),
        f_boff: vec_neu[u32](), f_blen: vec_neu[u32](), f_werte: vec_neu[u32](),
        p_typ: vec_neu[u32](),
        b_ioff: vec_neu[u32](), b_ilen: vec_neu[u32](),
        b_term: vec_neu[u32](), b_t1: vec_neu[u32](), b_t2: vec_neu[u32](), b_t3: vec_neu[u32](),
        b_t4: vec_neu[u32](), b_t5: vec_neu[u32](),
        b_iliste: vec_neu[u32](),
        i_art: vec_neu[u32](), i_ty: vec_neu[u32](), i_dst: vec_neu[u32](),
        i_a: vec_neu[u32](), i_b: vec_neu[u32](), i_c: vec_neu[u32](),
        i_zahl: vec_neu[u64](), i_aoff: vec_neu[u32](), i_alen: vec_neu[u32](),
        i_args: vec_neu[u32](),
        sw_key: vec_neu[i64](), sw_ziel: vec_neu[u32](),
    }
}

fn fir_frei(f: *mut Fir) {
    vec_frei[u32](&(*f).f_name)
    vec_frei[u32](&(*f).f_ret)
    vec_frei[u32](&(*f).f_poff)
    vec_frei[u32](&(*f).f_plen)
    vec_frei[u32](&(*f).f_boff)
    vec_frei[u32](&(*f).f_blen)
    vec_frei[u32](&(*f).f_werte)
    vec_frei[u32](&(*f).p_typ)
    vec_frei[u32](&(*f).b_ioff)
    vec_frei[u32](&(*f).b_ilen)
    vec_frei[u32](&(*f).b_term)
    vec_frei[u32](&(*f).b_t1)
    vec_frei[u32](&(*f).b_t2)
    vec_frei[u32](&(*f).b_t3)
    vec_frei[u32](&(*f).b_t4)
    vec_frei[u32](&(*f).b_t5)
    vec_frei[u32](&(*f).b_iliste)
    vec_frei[u32](&(*f).i_art)
    vec_frei[u32](&(*f).i_ty)
    vec_frei[u32](&(*f).i_dst)
    vec_frei[u32](&(*f).i_a)
    vec_frei[u32](&(*f).i_b)
    vec_frei[u32](&(*f).i_c)
    vec_frei[u64](&(*f).i_zahl)
    vec_frei[u32](&(*f).i_aoff)
    vec_frei[u32](&(*f).i_alen)
    vec_frei[u32](&(*f).i_args)
    vec_frei[i64](&(*f).sw_key)
    vec_frei[u32](&(*f).sw_ziel)
}

fn fty_bits(t: u32) -> u32 {
    if t == T_I8 || t == T_U8 || t == T_BOOL { return 8 }
    if t == T_I16 || t == T_U16 { return 16 }
    if t == T_I32 || t == T_U32 { return 32 }
    if t == T_VOID { return 0 }
    return 64
}

fn fty_bytes(t: u32) -> u64 {
    return (fty_bits(t) / 8) as u64
}

fn fty_name(b: *mut rt.Buf, t: u32) {
    var tab: [u8; 47] = "i8|i16|i32|i64|u8|u16|u32|u64|bool|f64|ptr|void"
    var i: usize = 0
    var nr: u32 = 0
    var start: usize = 0
    while i <= 47 {
        var ende: bool = i == 47
        if !ende {
            ende = tab[i] == 124 as u8
        }
        if ende {
            if nr == t {
                rt.buf_push_bytes(b, (&tab[start]) as u64, i - start)
                return
            }
            nr = nr + 1
            start = i + 1
        }
        i = i + 1
    }
}

// --------------------------------------------------------------- Anlegen

fn arg_anfang(f: *mut Fir) -> u32 { return vec_len[u32](&(*f).i_args) as u32 }
fn arg_dazu(f: *mut Fir, v: u32) { vec_push[u32](&(*f).i_args, v) }

fn fn_neu(f: *mut Fir, name: u32, ret: u32, poff: u32, plen: u32) -> u32 {
    let i: u32 = vec_len[u32](&(*f).f_name) as u32
    vec_push[u32](&(*f).f_name, name)
    vec_push[u32](&(*f).f_ret, ret)
    vec_push[u32](&(*f).f_poff, poff)
    vec_push[u32](&(*f).f_plen, plen)
    vec_push[u32](&(*f).f_boff, vec_len[u32](&(*f).b_term) as u32)
    vec_push[u32](&(*f).f_blen, 0)
    vec_push[u32](&(*f).f_werte, plen)
    block_neu(f, i)
    return i
}

fn fn_anzahl(f: *mut Fir) -> usize { return vec_len[u32](&(*f).f_name) }

fn param_wert(f: *mut Fir, fi: u32, k: u32) -> u32 { return k }

fn block_neu(f: *mut Fir, fi: u32) -> u32 {
    let nr: u32 = vec_at[u32](&(*f).f_blen, fi as usize)
    vec_push[u32](&(*f).b_ioff, vec_len[u32](&(*f).b_iliste) as u32)
    vec_push[u32](&(*f).b_ilen, 0)
    vec_push[u32](&(*f).b_term, TERM_UNSET)
    vec_push[u32](&(*f).b_t1, KEIN)
    vec_push[u32](&(*f).b_t2, KEIN)
    vec_push[u32](&(*f).b_t3, KEIN)
    vec_push[u32](&(*f).b_t4, KEIN)
    vec_push[u32](&(*f).b_t5, KEIN)
    vec_setzen[u32](&(*f).f_blen, fi as usize, nr + 1)
    return nr
}

fn block_anzahl(f: *mut Fir, fi: u32) -> u32 { return vec_at[u32](&(*f).f_blen, fi as usize) }
fn wert_anzahl(f: *mut Fir, fi: u32) -> u32 { return vec_at[u32](&(*f).f_werte, fi as usize) }

fn neuer_wert(f: *mut Fir, fi: u32) -> u32 {
    let v: u32 = vec_at[u32](&(*f).f_werte, fi as usize)
    vec_setzen[u32](&(*f).f_werte, fi as usize, v + 1)
    return v
}

fn inst_anlegen(f: *mut Fir, art: u32, ty: u32, dst: u32, a: u32, b: u32, c: u32,
                zahl: u64, aoff: u32, alen: u32) -> u32 {
    let i: u32 = vec_len[u32](&(*f).i_art) as u32
    vec_push[u32](&(*f).i_art, art)
    vec_push[u32](&(*f).i_ty, ty)
    vec_push[u32](&(*f).i_dst, dst)
    vec_push[u32](&(*f).i_a, a)
    vec_push[u32](&(*f).i_b, b)
    vec_push[u32](&(*f).i_c, c)
    vec_push[u64](&(*f).i_zahl, zahl)
    vec_push[u32](&(*f).i_aoff, aoff)
    vec_push[u32](&(*f).i_alen, alen)
    return i
}

// Haengt `nr` an die Instruktionsliste von Block `g` an (globale Blocknummer).
fn liste_anhaengen(f: *mut Fir, g: u32, nr: u32) {
    let off: u32 = vec_at[u32](&(*f).b_ioff, g as usize)
    let laen: u32 = vec_at[u32](&(*f).b_ilen, g as usize)
    let ende: u32 = vec_len[u32](&(*f).b_iliste) as u32
    if off + laen == ende {
        vec_push[u32](&(*f).b_iliste, nr)
        vec_setzen[u32](&(*f).b_ilen, g as usize, laen + 1)
        return
    }
    let neu: u32 = ende
    var k: u32 = 0
    while k < laen {
        vec_push[u32](&(*f).b_iliste, vec_at[u32](&(*f).b_iliste, (off + k) as usize))
        k = k + 1
    }
    vec_push[u32](&(*f).b_iliste, nr)
    vec_setzen[u32](&(*f).b_ioff, g as usize, neu)
    vec_setzen[u32](&(*f).b_ilen, g as usize, laen + 1)
}

fn global(f: *mut Fir, fi: u32, bb: u32) -> u32 {
    return vec_at[u32](&(*f).f_boff, fi as usize) + bb
}

fn inst_dazu(f: *mut Fir, fi: u32, bb: u32, art: u32, ty: u32,
             a: u32, b: u32, c: u32, zahl: u64, aoff: u32, alen: u32) -> u32 {
    let v: u32 = neuer_wert(f, fi)
    let nr: u32 = inst_anlegen(f, art, ty, v, a, b, c, zahl, aoff, alen)
    liste_anhaengen(f, global(f, fi, bb), nr)
    return v
}

fn inst_void_dazu(f: *mut Fir, fi: u32, bb: u32, art: u32, ty: u32,
                  a: u32, b: u32, c: u32, zahl: u64, aoff: u32, alen: u32) {
    let nr: u32 = inst_anlegen(f, art, ty, KEIN, a, b, c, zahl, aoff, alen)
    liste_anhaengen(f, global(f, fi, bb), nr)
}

// Eine Alloca gehoert IMMER in den Eintrittsblock, hinter die schon
// vorhandenen Allocas. Die NUMMER folgt trotzdem der Reihenfolge des
// Anlegens — deshalb stimmt die gedruckte Reihenfolge nicht mit den Nummern
// ueberein, und genau so macht es `firnc0` auch.
fn alloca_dazu(f: *mut Fir, fi: u32, groesse: u64, ausricht: u64) -> u32 {
    let v: u32 = neuer_wert(f, fi)
    let nr: u32 = inst_anlegen(f, O_ALLOCA, T_PTR, v, 0, 0, 0, groesse, 0, ausricht as u32)
    let g: u32 = global(f, fi, 0)
    let off: u32 = vec_at[u32](&(*f).b_ioff, g as usize)
    let laen: u32 = vec_at[u32](&(*f).b_ilen, g as usize)
    var n: u32 = 0
    while n < laen {
        let inr: u32 = vec_at[u32](&(*f).b_iliste, (off + n) as usize)
        if vec_at[u32](&(*f).i_art, inr as usize) != O_ALLOCA {
            break
        }
        n = n + 1
    }
    let neu: u32 = vec_len[u32](&(*f).b_iliste) as u32
    var k: u32 = 0
    while k < n {
        vec_push[u32](&(*f).b_iliste, vec_at[u32](&(*f).b_iliste, (off + k) as usize))
        k = k + 1
    }
    vec_push[u32](&(*f).b_iliste, nr)
    k = n
    while k < laen {
        vec_push[u32](&(*f).b_iliste, vec_at[u32](&(*f).b_iliste, (off + k) as usize))
        k = k + 1
    }
    vec_setzen[u32](&(*f).b_ioff, g as usize, neu)
    vec_setzen[u32](&(*f).b_ilen, g as usize, laen + 1)
    return v
}

// Der ERSTE gesetzte Terminator gewinnt — genau wie `Func::set_term`.
fn term_setzen(f: *mut Fir, fi: u32, bb: u32, art: u32, t1: u32, t2: u32, t3: u32) {
    let g: u32 = global(f, fi, bb)
    if vec_at[u32](&(*f).b_term, g as usize) != TERM_UNSET {
        return
    }
    vec_setzen[u32](&(*f).b_term, g as usize, art)
    vec_setzen[u32](&(*f).b_t1, g as usize, t1)
    vec_setzen[u32](&(*f).b_t2, g as usize, t2)
    vec_setzen[u32](&(*f).b_t3, g as usize, t3)
}

fn ist_terminiert(f: *mut Fir, fi: u32, bb: u32) -> bool {
    return vec_at[u32](&(*f).b_term, global(f, fi, bb) as usize) != TERM_UNSET
}

// `switch`-Terminator setzen (der ERSTE Terminator gewinnt, wie immer).
// `off`/`len` zeigen in die flachen Falllisten `sw_key`/`sw_ziel`.
fn term_switch(f: *mut Fir, fi: u32, bb: u32, val: u32, ty: u32, def: u32,
               off: u32, len: u32) {
    let g: u32 = global(f, fi, bb)
    if vec_at[u32](&(*f).b_term, g as usize) != TERM_UNSET {
        return
    }
    vec_setzen[u32](&(*f).b_term, g as usize, TERM_SWITCH)
    vec_setzen[u32](&(*f).b_t1, g as usize, val)
    vec_setzen[u32](&(*f).b_t2, g as usize, def)
    vec_setzen[u32](&(*f).b_t3, g as usize, off)
    vec_setzen[u32](&(*f).b_t4, g as usize, len)
    vec_setzen[u32](&(*f).b_t5, g as usize, ty)
}

fn sw_anfang(f: *mut Fir) -> u32 { return vec_len[i64](&(*f).sw_key) as u32 }
fn sw_dazu(f: *mut Fir, key: i64, ziel: u32) {
    vec_push[i64](&(*f).sw_key, key)
    vec_push[u32](&(*f).sw_ziel, ziel)
}
fn sw_schluessel(f: *mut Fir, i: u32) -> i64 { return vec_at[i64](&(*f).sw_key, i as usize) }
fn sw_ziel(f: *mut Fir, i: u32) -> u32 { return vec_at[u32](&(*f).sw_ziel, i as usize) }

// -------------------------------------------------------------- Textform
//
// VERTRAG: Oktett fuer Oktett wie `fir::Module::to_text`.

fn wert(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, 37 as u8)
    rt.buf_push_dez_u64(b, v as u64)
}

fn wortliste(f: *mut Fir, b: *mut rt.Buf, off: u32, laen: u32) {
    var k: u32 = 0
    while k < laen {
        if k > 0 {
            rt.buf_push(b, 44 as u8)
            rt.buf_push(b, 32 as u8)
        }
        wert(b, vec_at[u32](&(*f).i_args, (off + k) as usize))
        k = k + 1
    }
}

fn binop_name(b: *mut rt.Buf, op: u32) {
    var tab: [u8; 38] = "add|sub|mul|div|rem|and|or|xor|shl|shr"
    var i: usize = 0
    var nr: u32 = 0
    var start: usize = 0
    while i <= 38 {
        var ende: bool = i == 38
        if !ende {
            ende = tab[i] == 124 as u8
        }
        if ende {
            if nr == op {
                rt.buf_push_bytes(b, (&tab[start]) as u64, i - start)
                return
            }
            nr = nr + 1
            start = i + 1
        }
        i = i + 1
    }
}

fn cmpop_name(b: *mut rt.Buf, op: u32) {
    var tab: [u8; 17] = "eq|ne|lt|le|gt|ge"
    var i: usize = 0
    var nr: u32 = 0
    var start: usize = 0
    while i <= 17 {
        var ende: bool = i == 17
        if !ende {
            ende = tab[i] == 124 as u8
        }
        if ende {
            if nr == op {
                rt.buf_push_bytes(b, (&tab[start]) as u64, i - start)
                return
            }
            nr = nr + 1
            start = i + 1
        }
        i = i + 1
    }
}

fn punkt_typ(b: *mut rt.Buf, t: u32) {
    rt.buf_push(b, 46 as u8)
    fty_name(b, t)
}

fn drucke_inst(f: *mut Fir, it: *mut intern.Interner, b: *mut rt.Buf, nr: u32) {
    let art: u32 = vec_at[u32](&(*f).i_art, nr as usize)
    let ty: u32 = vec_at[u32](&(*f).i_ty, nr as usize)
    let dst: u32 = vec_at[u32](&(*f).i_dst, nr as usize)
    var zwei: [u8; 2] = "  "
    rt.buf_push_bytes(b, (&zwei[0]) as u64, 2)
    if dst != KEIN {
        wert(b, dst)
        var gl: [u8; 3] = " = "
        rt.buf_push_bytes(b, (&gl[0]) as u64, 3)
    }
    let a: u32 = vec_at[u32](&(*f).i_a, nr as usize)
    let c: u32 = vec_at[u32](&(*f).i_b, nr as usize)
    if art == O_CONST {
        var w: [u8; 5] = "const"
        rt.buf_push_bytes(b, (&w[0]) as u64, 5)
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        // VORZEICHEN NUR BEI VORZEICHENBEHAFTETEN TYPEN. `const.u64` mit dem
        // groessten Wert muss 18446744073709551615 lauten, nicht -1 — im Rust-
        // Compiler steht dort ein i128, und der druckt den Wert, wie er ist.
        let roh: u64 = vec_at[u64](&(*f).i_zahl, nr as usize)
        if ty == T_I8 || ty == T_I16 || ty == T_I32 || ty == T_I64 {
            rt.buf_push_dez_i64(b, roh as i64)
        } else {
            rt.buf_push_dez_u64(b, roh)
        }
        return
    }
    if art == O_BIN {
        binop_name(b, vec_at[u32](&(*f).i_c, nr as usize))
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        wert(b, a)
        var komma: [u8; 2] = ", "
        rt.buf_push_bytes(b, (&komma[0]) as u64, 2)
        wert(b, c)
        return
    }
    if art == O_CMP {
        var w: [u8; 3] = "cmp"
        rt.buf_push_bytes(b, (&w[0]) as u64, 3)
        rt.buf_push(b, 46 as u8)
        cmpop_name(b, vec_at[u32](&(*f).i_c, nr as usize))
        punkt_typ(b, vec_at[u64](&(*f).i_zahl, nr as usize) as u32)
        rt.buf_push(b, 32 as u8)
        wert(b, a)
        var komma: [u8; 2] = ", "
        rt.buf_push_bytes(b, (&komma[0]) as u64, 2)
        wert(b, c)
        return
    }
    if art == O_UN {
        if vec_at[u32](&(*f).i_c, nr as usize) == 0 {
            var w: [u8; 3] = "neg"
            rt.buf_push_bytes(b, (&w[0]) as u64, 3)
        } else {
            var w2: [u8; 3] = "not"
            rt.buf_push_bytes(b, (&w2[0]) as u64, 3)
        }
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        wert(b, a)
        return
    }
    if art == O_CAST {
        var w: [u8; 4] = "cast"
        rt.buf_push_bytes(b, (&w[0]) as u64, 4)
        punkt_typ(b, vec_at[u32](&(*f).i_c, nr as usize))
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        wert(b, a)
        return
    }
    if art == O_ALLOCA {
        var w: [u8; 16] = "alloca.ptr size="
        rt.buf_push_bytes(b, (&w[0]) as u64, 16)
        rt.buf_push_dez_u64(b, vec_at[u64](&(*f).i_zahl, nr as usize))
        var w2: [u8; 7] = " align="
        rt.buf_push_bytes(b, (&w2[0]) as u64, 7)
        rt.buf_push_dez_u64(b, vec_at[u32](&(*f).i_alen, nr as usize) as u64)
        return
    }
    if art == O_LOAD {
        var w: [u8; 4] = "load"
        rt.buf_push_bytes(b, (&w[0]) as u64, 4)
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        wert(b, a)
        return
    }
    if art == O_STORE {
        var w: [u8; 5] = "store"
        rt.buf_push_bytes(b, (&w[0]) as u64, 5)
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        wert(b, c)
        var komma: [u8; 2] = ", "
        rt.buf_push_bytes(b, (&komma[0]) as u64, 2)
        wert(b, a)
        return
    }
    if art == O_PTRADD {
        var w: [u8; 11] = "ptradd.ptr "
        rt.buf_push_bytes(b, (&w[0]) as u64, 11)
        wert(b, a)
        var komma: [u8; 2] = ", "
        rt.buf_push_bytes(b, (&komma[0]) as u64, 2)
        wert(b, c)
        return
    }
    if art == O_CALL {
        var w: [u8; 4] = "call"
        rt.buf_push_bytes(b, (&w[0]) as u64, 4)
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        rt.buf_push(b, 64 as u8)
        rt.buf_push_bytes(b, intern.intern_zeiger(it, a), intern.intern_laenge(it, a))
        rt.buf_push(b, 40 as u8)
        wortliste(f, b, vec_at[u32](&(*f).i_aoff, nr as usize),
                  vec_at[u32](&(*f).i_alen, nr as usize))
        rt.buf_push(b, 41 as u8)
        return
    }
    if art == O_CALLI {
        // `calli.<ty> %ziel(%a, %b)` — wie Op::CallIndirect in Stufe 0.
        var wci: [u8; 5] = "calli"
        rt.buf_push_bytes(b, (&wci[0]) as u64, 5)
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        wert(b, a)
        rt.buf_push(b, 40 as u8)
        wortliste(f, b, vec_at[u32](&(*f).i_aoff, nr as usize),
                  vec_at[u32](&(*f).i_alen, nr as usize))
        rt.buf_push(b, 41 as u8)
        return
    }
    if art == O_VTAB {
        // `vtab.ptr @<Schnittstelle>.<Typ>` — wie Op::VtabAddr in Stufe 0.
        var wvt: [u8; 10] = "vtab.ptr @"
        rt.buf_push_bytes(b, (&wvt[0]) as u64, 10)
        rt.buf_push_bytes(b, intern.intern_zeiger(it, a), intern.intern_laenge(it, a))
        rt.buf_push(b, 46 as u8)
        rt.buf_push_bytes(b, intern.intern_zeiger(it, c), intern.intern_laenge(it, c))
        return
    }
    if art == O_SYSCALL {
        var w: [u8; 7] = "syscall"
        rt.buf_push_bytes(b, (&w[0]) as u64, 7)
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        wortliste(f, b, vec_at[u32](&(*f).i_aoff, nr as usize),
                  vec_at[u32](&(*f).i_alen, nr as usize))
        return
    }
    if art == O_SELECT {
        // `select.<ty> %cond, %a, %b` — wie Op::Select in Stufe 0.
        var wsel: [u8; 6] = "select"
        rt.buf_push_bytes(b, (&wsel[0]) as u64, 6)
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        wert(b, a)
        var ks: [u8; 2] = ", "
        rt.buf_push_bytes(b, (&ks[0]) as u64, 2)
        wert(b, c)
        rt.buf_push_bytes(b, (&ks[0]) as u64, 2)
        wert(b, vec_at[u32](&(*f).i_c, nr as usize))
        return
    }
    if art == O_SECZERO {
        // `secure_zero %addr, %size` — wie Op::SecureZero in Stufe 0.
        var wsz: [u8; 12] = "secure_zero "
        rt.buf_push_bytes(b, (&wsz[0]) as u64, 12)
        wert(b, a)
        var ks2: [u8; 2] = ", "
        rt.buf_push_bytes(b, (&ks2[0]) as u64, 2)
        wert(b, c)
        return
    }
    if art == O_ATOMADD {
        // `atomadd.<ty> %addr, %val` — wie Op::AtomicAdd in Stufe 0.
        var wat: [u8; 7] = "atomadd"
        rt.buf_push_bytes(b, (&wat[0]) as u64, 7)
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        wert(b, a)
        var ka: [u8; 2] = ", "
        rt.buf_push_bytes(b, (&ka[0]) as u64, 2)
        wert(b, c)
        return
    }
    if art == O_ATOMCAS {
        // `atomcas.<ty> %addr, %erwartet, %neu` — wie Op::AtomicCas in Stufe 0.
        var wacs: [u8; 7] = "atomcas"
        rt.buf_push_bytes(b, (&wacs[0]) as u64, 7)
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        wert(b, a)
        var kcs: [u8; 2] = ", "
        rt.buf_push_bytes(b, (&kcs[0]) as u64, 2)
        wert(b, c)
        rt.buf_push_bytes(b, (&kcs[0]) as u64, 2)
        wert(b, vec_at[u32](&(*f).i_c, nr as usize))
        return
    }
    if art == O_SPAWN {
        // `spawn.<ty> %arg, %stapel, %ctid` — wie Op::ThreadSpawn in Stufe 0.
        var wsp: [u8; 5] = "spawn"
        rt.buf_push_bytes(b, (&wsp[0]) as u64, 5)
        punkt_typ(b, ty)
        rt.buf_push(b, 32 as u8)
        wert(b, a)
        var ksp: [u8; 2] = ", "
        rt.buf_push_bytes(b, (&ksp[0]) as u64, 2)
        wert(b, c)
        rt.buf_push_bytes(b, (&ksp[0]) as u64, 2)
        wert(b, vec_at[u32](&(*f).i_c, nr as usize))
        return
    }
    if art == O_TLS {
        // `fadenselbst.<ty>` — wie Op::ThreadSelf in Stufe 0.
        var wtl: [u8; 11] = "fadenselbst"
        rt.buf_push_bytes(b, (&wtl[0]) as u64, 11)
        punkt_typ(b, ty)
        return
    }
    if art == O_GCADDR {
        var wg: [u8; 12] = "gc_state.ptr"
        rt.buf_push_bytes(b, (&wg[0]) as u64, 12)
        if vec_at[u64](&(*f).i_zahl, nr as usize) == 1 {
            var rg: [u8; 6] = " regs="
            rt.buf_push_bytes(b, (&rg[0]) as u64, 6)
            rt.buf_push_dez_u64(b, 1)
        }
        return
    }
    // copymem
    var w: [u8; 8] = "copymem "
    rt.buf_push_bytes(b, (&w[0]) as u64, 8)
    wert(b, a)
    var komma: [u8; 2] = ", "
    rt.buf_push_bytes(b, (&komma[0]) as u64, 2)
    wert(b, c)
    var w2: [u8; 7] = ", size="
    rt.buf_push_bytes(b, (&w2[0]) as u64, 7)
    rt.buf_push_dez_u64(b, vec_at[u64](&(*f).i_zahl, nr as usize))
}

fn drucke_term(f: *mut Fir, b: *mut rt.Buf, g: u32) {
    var zwei: [u8; 2] = "  "
    rt.buf_push_bytes(b, (&zwei[0]) as u64, 2)
    let art: u32 = vec_at[u32](&(*f).b_term, g as usize)
    let t1: u32 = vec_at[u32](&(*f).b_t1, g as usize)
    if art == TERM_BR {
        var w: [u8; 5] = "br bb"
        rt.buf_push_bytes(b, (&w[0]) as u64, 5)
        rt.buf_push_dez_u64(b, t1 as u64)
        return
    }
    if art == TERM_BRCOND {
        var w: [u8; 7] = "brcond "
        rt.buf_push_bytes(b, (&w[0]) as u64, 7)
        wert(b, t1)
        var w2: [u8; 4] = ", bb"
        rt.buf_push_bytes(b, (&w2[0]) as u64, 4)
        rt.buf_push_dez_u64(b, vec_at[u32](&(*f).b_t2, g as usize) as u64)
        rt.buf_push_bytes(b, (&w2[0]) as u64, 4)
        rt.buf_push_dez_u64(b, vec_at[u32](&(*f).b_t3, g as usize) as u64)
        return
    }
    if art == TERM_SWITCH {
        // `switch.u32 %17 [0 => bb6, 1 => bb7] default bb5` — Textform aus
        // fir.rs, Zeichen fuer Zeichen.
        var w: [u8; 7] = "switch."
        rt.buf_push_bytes(b, (&w[0]) as u64, 7)
        fty_name(b, vec_at[u32](&(*f).b_t5, g as usize))
        rt.buf_push(b, 32 as u8)
        wert(b, t1)
        var w2: [u8; 2] = " ["
        rt.buf_push_bytes(b, (&w2[0]) as u64, 2)
        let off: u32 = vec_at[u32](&(*f).b_t3, g as usize)
        let len: u32 = vec_at[u32](&(*f).b_t4, g as usize)
        var k: u32 = 0
        while k < len {
            if k > 0 {
                var komma: [u8; 2] = ", "
                rt.buf_push_bytes(b, (&komma[0]) as u64, 2)
            }
            rt.buf_push_dez_i64(b, sw_schluessel(f, off + k))
            var w3: [u8; 6] = " => bb"
            rt.buf_push_bytes(b, (&w3[0]) as u64, 6)
            rt.buf_push_dez_u64(b, sw_ziel(f, off + k) as u64)
            k = k + 1
        }
        var w4: [u8; 12] = "] default bb"
        rt.buf_push_bytes(b, (&w4[0]) as u64, 12)
        rt.buf_push_dez_u64(b, vec_at[u32](&(*f).b_t2, g as usize) as u64)
        return
    }
    var w: [u8; 3] = "ret"
    rt.buf_push_bytes(b, (&w[0]) as u64, 3)
    if t1 != KEIN {
        rt.buf_push(b, 32 as u8)
        wert(b, t1)
    }
}

fn fir_text(f: *mut Fir, it: *mut intern.Interner, b: *mut rt.Buf) {
    var kopf: [u8; 9] = "; FIR v0\n"
    rt.buf_push_bytes(b, (&kopf[0]) as u64, 9)
    var fi: usize = 0
    while fi < fn_anzahl(f) {
        var w: [u8; 4] = "fn @"
        rt.buf_push_bytes(b, (&w[0]) as u64, 4)
        let nm: u32 = vec_at[u32](&(*f).f_name, fi)
        rt.buf_push_bytes(b, intern.intern_zeiger(it, nm), intern.intern_laenge(it, nm))
        rt.buf_push(b, 40 as u8)
        let poff: u32 = vec_at[u32](&(*f).f_poff, fi)
        let plen: u32 = vec_at[u32](&(*f).f_plen, fi)
        var k: u32 = 0
        while k < plen {
            if k > 0 {
                var komma: [u8; 2] = ", "
                rt.buf_push_bytes(b, (&komma[0]) as u64, 2)
            }
            wert(b, k)
            var dp: [u8; 2] = ": "
            rt.buf_push_bytes(b, (&dp[0]) as u64, 2)
            fty_name(b, vec_at[u32](&(*f).p_typ, (poff + k) as usize))
            k = k + 1
        }
        var pf: [u8; 5] = ") -> "
        rt.buf_push_bytes(b, (&pf[0]) as u64, 5)
        fty_name(b, vec_at[u32](&(*f).f_ret, fi))
        var auf: [u8; 3] = " {\n"
        rt.buf_push_bytes(b, (&auf[0]) as u64, 3)
        let boff: u32 = vec_at[u32](&(*f).f_boff, fi)
        var bb: u32 = 0
        while bb < vec_at[u32](&(*f).f_blen, fi) {
            let g: u32 = boff + bb
            var bw: [u8; 2] = "bb"
            rt.buf_push_bytes(b, (&bw[0]) as u64, 2)
            rt.buf_push_dez_u64(b, bb as u64)
            var dz: [u8; 2] = ":\n"
            rt.buf_push_bytes(b, (&dz[0]) as u64, 2)
            let ioff: u32 = vec_at[u32](&(*f).b_ioff, g as usize)
            var n: u32 = 0
            while n < vec_at[u32](&(*f).b_ilen, g as usize) {
                drucke_inst(f, it, b, vec_at[u32](&(*f).b_iliste, (ioff + n) as usize))
                rt.buf_push(b, 10 as u8)
                n = n + 1
            }
            drucke_term(f, b, g)
            rt.buf_push(b, 10 as u8)
            bb = bb + 1
        }
        var zu: [u8; 2] = "}\n"
        rt.buf_push_bytes(b, (&zu[0]) as u64, 2)
        fi = fi + 1
    }
}

// ------------------------------------------------- Zugriff fuer den Codegen

fn inst_anzahl(f: *mut Fir, fi: u32, bb: u32) -> u32 {
    return vec_at[u32](&(*f).b_ilen, global(f, fi, bb) as usize)
}

fn inst_bei(f: *mut Fir, fi: u32, bb: u32, k: u32) -> u32 {
    let g: u32 = global(f, fi, bb)
    return vec_at[u32](&(*f).b_iliste, (vec_at[u32](&(*f).b_ioff, g as usize) + k) as usize)
}

fn arg_bei(f: *mut Fir, i: u32) -> u32 { return vec_at[u32](&(*f).i_args, i as usize) }
fn i_art_von(f: *mut Fir, i: u32) -> u32 { return vec_at[u32](&(*f).i_art, i as usize) }
fn i_ty_von(f: *mut Fir, i: u32) -> u32 { return vec_at[u32](&(*f).i_ty, i as usize) }
fn i_dst_von(f: *mut Fir, i: u32) -> u32 { return vec_at[u32](&(*f).i_dst, i as usize) }
fn i_a_von(f: *mut Fir, i: u32) -> u32 { return vec_at[u32](&(*f).i_a, i as usize) }
fn i_b_von(f: *mut Fir, i: u32) -> u32 { return vec_at[u32](&(*f).i_b, i as usize) }
fn i_c_von(f: *mut Fir, i: u32) -> u32 { return vec_at[u32](&(*f).i_c, i as usize) }
fn i_zahl_von(f: *mut Fir, i: u32) -> u64 { return vec_at[u64](&(*f).i_zahl, i as usize) }
fn i_aoff_von(f: *mut Fir, i: u32) -> u32 { return vec_at[u32](&(*f).i_aoff, i as usize) }
fn i_alen_von(f: *mut Fir, i: u32) -> u32 { return vec_at[u32](&(*f).i_alen, i as usize) }

fn b_term_von(f: *mut Fir, fi: u32, bb: u32) -> u32 {
    return vec_at[u32](&(*f).b_term, global(f, fi, bb) as usize)
}
fn b_t1_von(f: *mut Fir, fi: u32, bb: u32) -> u32 {
    return vec_at[u32](&(*f).b_t1, global(f, fi, bb) as usize)
}
fn b_t2_von(f: *mut Fir, fi: u32, bb: u32) -> u32 {
    return vec_at[u32](&(*f).b_t2, global(f, fi, bb) as usize)
}
fn b_t3_von(f: *mut Fir, fi: u32, bb: u32) -> u32 {
    return vec_at[u32](&(*f).b_t3, global(f, fi, bb) as usize)
}
fn b_t4_von(f: *mut Fir, fi: u32, bb: u32) -> u32 {
    return vec_at[u32](&(*f).b_t4, global(f, fi, bb) as usize)
}
fn b_t5_von(f: *mut Fir, fi: u32, bb: u32) -> u32 {
    return vec_at[u32](&(*f).b_t5, global(f, fi, bb) as usize)
}
fn f_ret_von(f: *mut Fir, fi: u32) -> u32 { return vec_at[u32](&(*f).f_ret, fi as usize) }
fn f_plen_von(f: *mut Fir, fi: u32) -> u32 { return vec_at[u32](&(*f).f_plen, fi as usize) }
fn f_poff_von(f: *mut Fir, fi: u32) -> u32 { return vec_at[u32](&(*f).f_poff, fi as usize) }
fn p_typ_von(f: *mut Fir, i: u32) -> u32 { return vec_at[u32](&(*f).p_typ, i as usize) }
fn f_name_von(f: *mut Fir, fi: u32) -> u32 { return vec_at[u32](&(*f).f_name, fi as usize) }
