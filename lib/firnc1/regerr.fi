import vec

export { RegErr, regerr_new, regerr_free, regerr_add, regerr_count, regerr_code, regerr_pos, regerr_arg }

const REGERR_ARGS: usize = 6

struct RegErr {
    code: Vec[u32],
    pos: Vec[u64],
    arg: Vec[u64],
}

fn regerr_new() -> RegErr {
    return RegErr { code: vec_new[u32](), pos: vec_new[u64](), arg: vec_new[u64]() }
}

fn regerr_free(r: *mut RegErr) {
    vec_free[u32](&(*r).code)
    vec_free[u64](&(*r).pos)
    vec_free[u64](&(*r).arg)
}

fn regerr_count(r: *mut RegErr) -> usize { return vec_len[u32](&(*r).code) }

fn regerr_add(r: *mut RegErr, code: u32, pos: u64, a0: u64, a1: u64, a2: u64, a3: u64, a4: u64, a5: u64) {
    vec_push[u32](&(*r).code, code)
    vec_push[u64](&(*r).pos, pos)
    vec_push[u64](&(*r).arg, a0)
    vec_push[u64](&(*r).arg, a1)
    vec_push[u64](&(*r).arg, a2)
    vec_push[u64](&(*r).arg, a3)
    vec_push[u64](&(*r).arg, a4)
    vec_push[u64](&(*r).arg, a5)
}

fn regerr_code(r: *mut RegErr, i: usize) -> u32 { return vec_at[u32](&(*r).code, i) }
fn regerr_pos(r: *mut RegErr, i: usize) -> u64 { return vec_at[u64](&(*r).pos, i) }
fn regerr_arg(r: *mut RegErr, i: usize, k: usize) -> u64 { return vec_at[u64](&(*r).arg, i * REGERR_ARGS + k) }
