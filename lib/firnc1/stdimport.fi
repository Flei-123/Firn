// SPDX-License-Identifier: MPL-2.0
import rt
import derive_decl
import prelude
import std_modules

const MAX_MODULES: usize = 128

struct StdScan {
    dotted: [u32; 128],
    other: [u32; 128],
    declared: [u32; 128],
    imported: [u32; 128],
    types_used: [u32; 128],
    types_declared: [u32; 128],
}

fn std_scan_new() -> StdScan {
    return StdScan { dotted: [0 as u32; 128], other: [0 as u32; 128], declared: [0 as u32; 128], imported: [0 as u32; 128], types_used: [0 as u32; 128], types_declared: [0 as u32; 128] }
}

fn module_find(src: u64, s: usize, e: usize) -> i64 {
    let len: usize = e - s
    if len < 2 || len > 12 { return 0 - 1 }
    let base: u64 = (&std_modules.STD_MODULE_TEXT[0]) as u64
    var i: usize = 0
    var idx: i64 = 0
    var start: usize = 0
    while i <= std_modules.STD_MODULE_TEXT_LEN {
        var name_end: bool = i == std_modules.STD_MODULE_TEXT_LEN
        if !name_end { name_end = prelude.at(base, i) == 124 }
        if name_end {
            if i - start == len && same_bytes(base +% start as u64, src +% s as u64, len) { return idx }
            idx = idx + 1
            start = i + 1
        }
        i = i + 1
    }
    return 0 - 1
}

fn same_bytes(a: u64, b: u64, n: usize) -> bool {
    unsafe { return rt.mem_eq(a, b, n) }
}

fn skip_blanks(src: u64, i0: usize, end: usize) -> usize {
    var i: usize = i0
    while i < end && (prelude.at(src, i) == 32 || prelude.at(src, i) == 9) { i = i + 1 }
    return i
}

fn is_dotted_use(src: u64, after: usize, end: usize) -> bool {
    let i: usize = skip_blanks(src, after, end)
    return i + 1 < end && prelude.at(src, i) == 46 && prelude.at(src, i + 1) != 46
}

fn read_import(sc: *mut StdScan, src: u64, i0: usize, end: usize) -> usize {
    var i: usize = i0
    var last_s: usize = 0
    var last_e: usize = 0
    while true {
        i = skip_blanks(src, i, end)
        let s: usize = i
        while i < end && prelude.is_ident_byte(prelude.at(src, i)) { i = i + 1 }
        if s == i { break }
        last_s = s
        last_e = i
        if i >= end || prelude.at(src, i) != 46 { break }
        i = i + 1
    }
    if last_e > last_s {
        let m: i64 = module_find(src, last_s, last_e)
        if m >= 0 { (*sc).imported[m as usize] = 1 }
    }
    return i
}

fn expression_end(src: u64, n: usize, open: usize, end: usize) -> usize {
    var depth: i32 = 1
    var k: usize = open + 1
    while k < end && depth > 0 {
        let c: u8 = prelude.at(src, k)
        if c == 34 {
            k = prelude.skip_quoted(src, n, k, 34 as u8)
        } else {
            if c == 123 { depth = depth + 1 }
            if c == 125 { depth = depth - 1 }
            k = k + 1
        }
    }
    return k
}

fn spec_start(src: u64, from: usize, to: usize) -> usize {
    var i: usize = from
    while i < to {
        if prelude.at(src, i) == 58 {
            if i + 1 < to && prelude.at(src, i + 1) == 58 {
                i = i + 2
            } else {
                return i
            }
        } else {
            i = i + 1
        }
    }
    return to
}

fn scan_interpolation(sc: *mut StdScan, src: u64, n: usize, quote: usize, end: usize) -> usize {
    var j: usize = quote + 1
    while j < end && prelude.at(src, j) != 34 && prelude.at(src, j) != 10 {
        let c: u8 = prelude.at(src, j)
        if c == 92 {
            j = j + 2
        } else if c == 123 && j + 1 < n && prelude.at(src, j + 1) == 123 {
            j = j + 2
        } else if c == 123 {
            let close: usize = expression_end(src, n, j, end)
            var stop: usize = j + 1
            if close > 0 && close - 1 > stop { stop = close - 1 }
            scan_range(sc, src, n, j + 1, spec_start(src, j + 1, stop))
            j = close
        } else {
            j = j + 1
        }
    }
    if j + 1 > end { return end }
    return j + 1
}

fn is_fstring_quote(src: u64, i: usize) -> bool {
    if i < 1 || prelude.at(src, i - 1) != 102 { return false }
    return i < 2 || !prelude.is_ident_byte(prelude.at(src, i - 2))
}

fn note_module(sc: *mut StdScan, src: u64, s: usize, e: usize, prev_fn: bool, end: usize) {
    let m: i64 = module_find(src, s, e)
    if m < 0 { return }
    let k: usize = m as usize
    if prev_fn {
        (*sc).declared[k] = (*sc).declared[k] + 1
    } else if is_dotted_use(src, e, end) {
        (*sc).dotted[k] = (*sc).dotted[k] + 1
    } else {
        (*sc).other[k] = (*sc).other[k] + 1
    }
}

fn module_find_lit(name: str) -> i64 {
    return module_find(name.p as u64, 0, name.n)
}

fn type_bit(src: u64, s: usize, e: usize) -> u32 {
    if derive_decl.dv_eq_lit(src, s, e, "Vec") { return 1 }
    if derive_decl.dv_eq_lit(src, s, e, "Map") { return 2 }
    if derive_decl.dv_eq_lit(src, s, e, "Set") { return 4 }
    return 0
}

fn note_type(sc: *mut StdScan, src: u64, s: usize, e: usize, declaration: bool, end: usize) {
    let bit: u32 = type_bit(src, s, e)
    if bit == 0 { return }
    var module: i64 = module_find_lit("map")
    if bit == 1 { module = module_find_lit("vec") }
    if module < 0 { return }
    let k: usize = module as usize
    if declaration {
        (*sc).types_declared[k] = (*sc).types_declared[k] | bit
        return
    }
    let after: usize = skip_blanks(src, e, end)
    if after < end && prelude.at(src, after) == 91 {
        (*sc).types_used[k] = (*sc).types_used[k] | bit
    }
}

fn is_declaration_word(src: u64, s: usize, e: usize) -> bool {
    return derive_decl.dv_eq_lit(src, s, e, "struct") || derive_decl.dv_eq_lit(src, s, e, "enum")
    || derive_decl.dv_eq_lit(src, s, e, "interface") || derive_decl.dv_eq_lit(src, s, e, "type")
}

fn scan_range(sc: *mut StdScan, src: u64, n: usize, from: usize, end: usize) {
    var i: usize = from
    var prev_dot: bool = false
    var prev_fn: bool = false
    var prev_decl: bool = false
    while i < end {
        let c: u8 = prelude.at(src, i)
        if c == 47 && i + 1 < end && prelude.at(src, i + 1) == 47 {
            while i < n && prelude.at(src, i) != 10 { i = i + 1 }
        } else if c == 47 && i + 1 < end && prelude.at(src, i + 1) == 42 {
            i = i + 2
            while i + 1 < n && !(prelude.at(src, i) == 42 && prelude.at(src, i + 1) == 47) { i = i + 1 }
            i = i + 2
            if i > n { i = n }
        } else if c == 34 && is_fstring_quote(src, i) {
            i = scan_interpolation(sc, src, n, i, end)
            prev_dot = false
            prev_fn = false
        } else if c == 34 || c == 39 {
            i = prelude.skip_quoted(src, n, i, c)
            prev_dot = false
            prev_fn = false
        } else if c == 46 {
            prev_dot = true
            i = i + 1
        } else if prelude.is_ident_start(c) {
            let s: usize = i
            while i < end && prelude.is_ident_byte(prelude.at(src, i)) { i = i + 1 }
            if derive_decl.dv_eq_lit(src, s, i, "import") {
                i = read_import(sc, src, i, end)
                prev_fn = false
                prev_decl = false
            } else {
                if !prev_dot {
                    note_type(sc, src, s, i, prev_decl, end)
                    note_module(sc, src, s, i, prev_fn, end)
                }
                prev_fn = derive_decl.dv_eq_lit(src, s, i, "fn")
                prev_decl = is_declaration_word(src, s, i)
            }
            prev_dot = false
        } else {
            if c > 32 { prev_dot = false }
            i = i + 1
        }
    }
}

fn module_name_at(k: usize, out: *mut rt.Buf) {
    let base: u64 = (&std_modules.STD_MODULE_TEXT[0]) as u64
    var i: usize = 0
    var idx: usize = 0
    var start: usize = 0
    while i <= std_modules.STD_MODULE_TEXT_LEN {
        var name_end: bool = i == std_modules.STD_MODULE_TEXT_LEN
        if !name_end { name_end = prelude.at(base, i) == 124 }
        if name_end {
            if idx == k {
                unsafe { rt.buf_push_bytes(out, base +% start as u64, i - start) }
                return
            }
            idx = idx + 1
            start = i + 1
        }
        i = i + 1
    }
}

fn si_run(src: u64, n: usize, out: *mut rt.Buf) -> bool {
    if prelude.pl_off() { return false }
    if prelude.contains(src, n, 112 as u8, "profile kernel") { return false }
    var sc: StdScan = std_scan_new()
    scan_range(&sc, src, n, 0, n)
    var any: bool = false
    var k: usize = 0
    while k < std_modules.STD_MODULE_COUNT && k < MAX_MODULES {
        let dotted_use: bool = sc.dotted[k] > 0 && sc.other[k] == 0 && sc.declared[k] == 0
        let type_use: bool = (sc.types_used[k] & (sc.types_declared[k] ^ 7)) != 0
        if (dotted_use || type_use) && sc.imported[k] == 0 {
            prelude.put(out, "import std.")
            module_name_at(k, out)
            prelude.put(out, "; ")
            any = true
        }
        k = k + 1
    }
    if !any { return false }
    unsafe { rt.buf_push_bytes(out, src, n) }
    return true
}
