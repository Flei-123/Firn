import intern
import ast

export { wrap_builder, is_builder_call }

fn is_builder_call(b: *mut ast.Tree, e: u32) -> bool {
    return ast.e_kind(b, e) == ast.E_CALL && ast.e_number(b, e) == 0
}

fn wrap_builder(b: *mut ast.Tree, it: *mut intern.Interner, e: u32) -> u32 {
    let copy: u32 = ast.expr_new(b, ast.e_kind(b, e), ast.e_a(b, e), ast.e_b(b, e), ast.e_c(b, e), ast.e_number(b, e))
    ast.expr_pos_set(b, copy, ast.expr_pos(b, e))
    ast.expr_len_set(b, copy, ast.expr_len(b, e))
    let off: u32 = ast.child_start(b)
    ast.child_add(b, copy)
    var callee: [u8; 14] = "io__fmt_string"
    let nr: u32 = intern.intern_number(it, (&callee[0]) as u64, 14) as u32
    ast.e_kind_set(b, e, ast.E_CALL)
    ast.e_a_set(b, e, nr)
    ast.e_b_set(b, e, off)
    ast.e_c_set(b, e, 1)
    ast.e_number_set(b, e, 0)
    return copy
}
