// SPDX-License-Identifier: MPL-2.0

import rt
import types
import cvalue
import construn

export { encode_value }

const BITS_PER_BYTE: i64 = 8
const BYTE_MASK: i64 = 255

fn fail_unsupported(z: *mut construn.Run, pos: u64, width: u32) -> bool {
    if construn.fail_begin(z, pos, width, false) {
        construn.put_text(z, "a 'static' computed by a call must be an integer, a bool or an array of those")
    }
    return false
}

fn encode_array(z: *mut construn.Run, node: u32, t: u32, out: *mut rt.Buf, pos: u64, width: u32) -> bool {
    let tt: *mut types.Types = construn.run_tree_types(z)
    let pool: *mut cvalue.Pool = construn.run_pool(z)
    if !cvalue.pool_is_arr(pool, node) {
        return fail_unsupported(z, pos, width)
    }
    let want: u64 = types.ty_n(tt, t)
    let have: u32 = cvalue.pool_len(pool, node)
    if have as u64 != want {
        if construn.fail_begin(z, pos, width, false) {
            construn.put_text(z, "the array has ")
            construn.put_int(z, want as i64)
            construn.put_text(z, " elements, the value has ")
            construn.put_int(z, have as i64)
        }
        return false
    }
    var i: u32 = 0
    while i < have {
        if !encode_value(z, cvalue.pool_kid(pool, node, i), types.ty_a(tt, t), out, pos, width) {
            return false
        }
        i = i + 1
    }
    return true
}

fn encode_value(z: *mut construn.Run, node: u32, t: u32, out: *mut rt.Buf, pos: u64, width: u32) -> bool {
    let tt: *mut types.Types = construn.run_tree_types(z)
    let pool: *mut cvalue.Pool = construn.run_pool(z)
    let k: u32 = types.ty_kind(tt, t)
    if k == types.K_ARR {
        return encode_array(z, node, t, out, pos, width)
    }
    if k > types.K_BOOL || cvalue.pool_is_arr(pool, node) {
        return fail_unsupported(z, pos, width)
    }
    let v: i64 = cvalue.cut(cvalue.pool_val(pool, node), k)
    let size: i64 = types.size_of(tt, t) as i64
    var i: i64 = 0
    while i < size {
        rt.buf_push(out, ((v >> (i * BITS_PER_BYTE)) & BYTE_MASK) as u8)
        i = i + 1
    }
    return true
}
