// SPDX-License-Identifier: MPL-2.0
// lib/firnc1/lamsugar.fi -- r715 LAMBDA SUGAR, the type resolution (twin of
// compiler/src/lambda.rs; docs/CLOSURES.md "Lambda sugar").
//
//   sort_stable_by[T](v, |a, b| (*a).x < (*b).x)     expression body
//   apply(|x| { return x + 1 })                      block body
//   let f: fn(i32) -> i32 = |x| x * 2                expected type from the let
//   let g = |x: i32, y: i32| -> i32 x + y            fully typed, no context
//   try gc |x| x + n                                 capturing form
//
// The parser (`lambda_sugar` in parser.fi) builds the ordinary closure
// function with untyped parameters (type NOTHING) and marks the `E_LAMBDA`
// node in `e_number`:
//   bit 60  some type is still open (untyped parameter or no result type)
//   bit 61  block body without result type   (`|x| { .. }`)
//   bit 62  expression body without result type (`|x| expr`)
// `run` finds the expected `fn(..) -> R` type -- parameter of a plain call
// (also `try` in front), `let x: T = ..` -- copies the parameter types and
// the result type into the closure function and turns an expression body
// into `return <expr>`. After that the lambda is exactly `fn(x: T) -> R {..}`
// and no later stage knows about the sugar. A lambda without a usable
// expected type is an error (counted; the caller reports).
//
// Also: `return <lambda>` (parser stores the result type in the S_RET statement) and struct
// literal fields. Not mirrored (stage 0 only): method calls.

import rt
import vec
import intern
import ast
import err

export { run, ty_same, Hk, declared_anywhere, declared_fn_var, CALL_MODE }

const NONE: u32 = 4294967295
// r742b: `hook(gp, call_node, CALL_MODE)` = infer the type arguments of the generic callee
// of this `E_CALL` from its value arguments (`apply_g(id, 4)`).
const CALL_MODE: u32 = 4294967294

// r742: the generic-function hook. `hook(gp, node, expected)` is implemented by
// mono.fi (`gen_infer_value`): node is an `E_ID` naming a generic function and
// `expected` a `fn(..)` type -> the type arguments are inferred, the instance is
// registered and the node renamed. `expected == NONE` only asks "is it a candidate?"
// (returns 1). gp == 0: no hook (callers without a generic registry).
struct Hk {
    gp: u64,
    hook: fn(u64, u32, u32, u64) -> u32,
}

fn use_hook(hk: *mut Hk, b: *mut ast.Tree, node: u32, pt: u32) -> u32 {
    if (*hk).gp == 0 || node == ast.NOTHING || pt == ast.NOTHING {
        return 0
    }
    if ast.e_kind(b, node) != ast.E_ID || ast.t_kind(b, pt) != ast.T_FN {
        return 0
    }
    let f: fn(u64, u32, u32, u64) -> u32 = (*hk).hook
    return f((*hk).gp, node, pt, 0)
}

// r742b: `atys` = the evident type node of every argument (NOTHING = unknown).
fn use_call_hook(hk: *mut Hk, node: u32, atys: *mut Vec[u32]) -> u32 {
    if (*hk).gp == 0 {
        return 0
    }
    let f: fn(u64, u32, u32, u64) -> u32 = (*hk).hook
    return f((*hk).gp, node, CALL_MODE, atys as u64)
}

// Is `nm` declared as a parameter, `let`, `var` or loop variable anywhere? Then a bare
// use of the name might be that variable and is left alone (flat tree, no scopes).
fn declared_anywhere(b: *mut ast.Tree, nm: u32) -> bool {
    let np: usize = vec_len[u32](&(*b).pa_name)
    var i: usize = 0
    while i < np {
        if vec_at[u32](&(*b).pa_name, i) == nm {
            return true
        }
        i = i + 1
    }
    let ns: usize = vec_len[u32](&(*b).s_kind)
    var s: usize = 0
    while s < ns {
        let k: u32 = ast.s_kind(b, s as u32)
        if (k == ast.S_LET || k == ast.S_VAR || k == ast.S_FOR) && ast.s_a(b, s as u32) == nm {
            return true
        }
        s = s + 1
    }
    return false
}

// r742b: is `nm` declared anywhere as a variable that could be a function value (declared
// `fn(..)` type, or no declared type at all)? A bare use of a generic function name is then
// left alone. Variables of other types (`count: i32`) do not hide the generic function.
fn declared_fn_var(b: *mut ast.Tree, nm: u32) -> bool {
    let np: usize = vec_len[u32](&(*b).pa_name)
    var i: usize = 0
    while i < np {
        if vec_at[u32](&(*b).pa_name, i) == nm {
            let t: u32 = ast.param_ty(b, i as u32)
            if t == ast.NOTHING || ast.t_kind(b, t) == ast.T_FN {
                return true
            }
        }
        i = i + 1
    }
    let ns: usize = vec_len[u32](&(*b).s_kind)
    var s: usize = 0
    while s < ns {
        let k: u32 = ast.s_kind(b, s as u32)
        if (k == ast.S_LET || k == ast.S_VAR || k == ast.S_FOR) && ast.s_a(b, s as u32) == nm {
            let t: u32 = ast.s_b(b, s as u32)
            if k == ast.S_FOR || t == ast.NOTHING || ast.t_kind(b, t) == ast.T_FN {
                return true
            }
        }
        s = s + 1
    }
    return false
}

// r742: `Type.m` (no call) -> the plain function `Type__m` whose first parameter is `self`.
fn method_values(b: *mut ast.Tree, it: *mut intern.Interner, fmap: *mut Vec[u32], sflag: *mut Vec[u32]) {
    var sw: [u8; 4] = "self"
    let self_nr: u32 = intern.intern_number(it, (&sw[0]) as u64, 4) as u32
    var us: [u8; 2] = "__"
    let total: usize = ast.expr_count(b)
    var e: usize = 0
    while e < total {
        if ast.e_kind(b, e as u32) == ast.E_FIELD {
            let base: u32 = ast.e_a(b, e as u32)
            if base != ast.NOTHING && ast.e_kind(b, base) == ast.E_ID {
                let sn: u32 = ast.e_a(b, base)
                if (sn as usize) < vec_len[u32](sflag) && vec_at[u32](sflag, sn as usize) != 0
                && !declared_anywhere(b, sn) {
                    let mn: u32 = ast.e_b(b, e as u32)
                    var kl: rt.Buf = rt.buf_new()
                    rt.buf_push_bytes(&kl, intern.intern_ptr(it, sn), intern.intern_length(it, sn))
                    rt.buf_push_bytes(&kl, (&us[0]) as u64, 2)
                    rt.buf_push_bytes(&kl, intern.intern_ptr(it, mn), intern.intern_length(it, mn))
                    let nm: u32 = intern.intern_number(it, rt.buf_ptr(&kl), rt.buf_len(&kl)) as u32
                    rt.buf_free(&kl)
                    if (nm as usize) < vec_len[u32](fmap) {
                        let fi: u32 = vec_at[u32](fmap, nm as usize)
                        if fi != NONE && ast.fn_plen(b, fi as usize) > 0
                        && ast.param_name(b, ast.fn_poff(b, fi as usize)) == self_nr {
                            ast.e_kind_set(b, e as u32, ast.E_ID)
                            ast.e_a_set(b, e as u32, nm)
                            ast.e_b_set(b, e as u32, 0)
                            ast.e_c_set(b, e as u32, 0)
                        }
                    }
                }
            }
        }
        e = e + 1
    }
}
const LAM_OPEN: u64 = 1152921504606846976
const LAM_BLK: u64 = 2305843009213693952
const LAM_EXPR: u64 = 4611686018427387904

fn is_open(b: *mut ast.Tree, e: u32) -> bool {
    if ast.e_kind(b, e) != ast.E_LAMBDA {
        return false
    }
    return (ast.e_number(b, e) & LAM_OPEN) != 0
}

// The lambda behind `e`, looking through one `try`: NONE if `e` is none.
fn lambda_of(b: *mut ast.Tree, it: *mut intern.Interner, e: u32) -> u32 {
    if ast.e_kind(b, e) == ast.E_LAMBDA {
        return e
    }
    if ast.e_kind(b, e) == ast.E_CALL && ast.e_number(b, e) == 0
    && err.error_is_tryname(it, ast.e_a(b, e)) && ast.e_c(b, e) == 1 {
        let inner: u32 = ast.child_at(b, ast.e_b(b, e))
        if ast.e_kind(b, inner) == ast.E_LAMBDA {
            return inner
        }
    }
    return NONE
}

// r732 -- structural equality of two type nodes (twin of `ty_key` in lambda.rs).
fn ty_same(b: *mut ast.Tree, x: u32, y: u32) -> bool {
    if x == ast.NOTHING || y == ast.NOTHING {
        return x == y
    }
    if x == y {
        return true
    }
    let k: u32 = ast.t_kind(b, x)
    if k != ast.t_kind(b, y) {
        return false
    }
    if k == ast.T_NAME {
        return ast.t_a(b, x) == ast.t_a(b, y)
    }
    if k == ast.T_PTR || k == ast.T_ARR {
        return ast.t_b(b, x) == ast.t_b(b, y) && ty_same(b, ast.t_a(b, x), ast.t_a(b, y))
    }
    // T_FN / T_TUP: result type + element types
    if !ty_same(b, ast.t_a(b, x), ast.t_a(b, y)) {
        return false
    }
    let xb: u64 = ast.t_b(b, x)
    let yb: u64 = ast.t_b(b, y)
    let xc: u32 = (xb & 4294967295) as u32
    if xc != ((yb & 4294967295) as u32) {
        return false
    }
    let xo: u32 = (xb >> 32) as u32
    let yo: u32 = (yb >> 32) as u32
    var i: u32 = 0
    while i < xc {
        if !ty_same(b, ast.child_at(b, xo + i), ast.child_at(b, yo + i)) {
            return false
        }
        i = i + 1
    }
    return true
}

// r732 -- the declared parameter type at position `k` of EVERY method `m` (function
// `<Type>__m` whose first parameter is `self`) taking `cnt` parameters; NOTHING when
// there is no such method or two candidates disagree (twin of lambda.rs `msigs`).
fn method_param_type(b: *mut ast.Tree, it: *mut intern.Interner, name: u32,
    cnt: u32, k: u32) -> u32 {
    var sw: [u8; 4] = "self"
    let self_nr: u32 = intern.intern_number(it, (&sw[0]) as u64, 4) as u32
    let mlen: usize = intern.intern_length(it, name) - 7
    let mptr: u64 = intern.intern_ptr(it, name) + 7
    var rep: u32 = ast.NOTHING
    var have: bool = false
    let nf: usize = ast.fn_count(b)
    var f: usize = 0
    while f < nf {
        let plen: u32 = ast.fn_plen(b, f)
        let poff: u32 = ast.fn_poff(b, f)
        if plen == cnt && plen > 0 && ast.param_name(b, poff) == self_nr {
            let fnm: u32 = ast.fn_name(b, f)
            let fl: usize = intern.intern_length(it, fnm)
            let fp: u64 = intern.intern_ptr(it, fnm)
            // last "__"
            var i: usize = fl
            var at: usize = fl
            while i >= 2 {
                i = i - 1
                if *((fp + (i as u64)) as *mut u8) == (95 as u8) && *((fp + (i as u64) - 1) as *mut u8) == (95 as u8) {
                    at = i + 1
                    break
                }
            }
            if at < fl && fl - at == mlen && rt.mem_eq(fp + (at as u64), mptr, mlen) {
                let pt: u32 = ast.param_ty(b, poff + k)
                if !have {
                    rep = pt
                    have = true
                } else if !ty_same(b, rep, pt) {
                    return ast.NOTHING
                }
            }
        }
        f = f + 1
    }
    return rep
}

// r739: `-> AllocError!fn(..)` -- the expected type of `return gc |x| ..` is the error
// union placeholder `__eu#<n>`; the lambda wants its payload (twin of the
// `pending_inner` step in lambda.rs::resolve). `ef` may be 0 (no error registry).
fn unwrap_eu(b: *mut ast.Tree, it: *mut intern.Interner, ef: *mut err.Error, pt: u32) -> u32 {
    if pt == ast.NOTHING || ef as u64 == 0 || ast.t_kind(b, pt) != ast.T_NAME {
        return pt
    }
    let ph: i64 = err.error_placeholder(it, ast.t_a(b, pt))
    if ph < 0 || (ph as usize) >= vec_len[u32](&(*ef).p_te) {
        return pt
    }
    return vec_at[u32](&(*ef).p_te, ph as usize)
}

// Fill in lambda `lam` from the expected type node `pt`. Returns the number
// of errors (0 or 1).
fn resolve(b: *mut ast.Tree, fmap: *mut Vec[u32], lam: u32, pt: u32) -> u32 {
    if pt == ast.NOTHING || ast.t_kind(b, pt) != ast.T_FN {
        return 0
    }
    let name: u32 = ast.e_a(b, lam)
    if (name as usize) >= vec_len[u32](fmap) {
        return 0
    }
    let fi: u32 = vec_at[u32](fmap, name as usize)
    if fi == NONE {
        return 0
    }
    let tb: u64 = ast.t_b(b, pt)
    let coff: u32 = (tb >> 32) as u32
    let ccnt: u32 = (tb & 4294967295) as u32
    let nump: u32 = ast.fn_plen(b, fi as usize) - 1
    var num: u64 = ast.e_number(b, lam)
    if nump != ccnt {
        // wrong number of parameters: leave the mark, `run` counts it
        return 0
    }
    let poff: u32 = ast.fn_poff(b, fi as usize)
    var i: u32 = 0
    while i < nump {
        if ast.param_ty(b, poff + i) == ast.NOTHING {
            ast.param_ty_set(b, poff + i, ast.child_at(b, coff + i))
        }
        i = i + 1
    }
    if (num & (LAM_BLK | LAM_EXPR)) != 0 {
        let rt_node: u32 = ast.t_a(b, pt)
        ast.fn_ret_set(b, fi as usize, rt_node)
        if (num & LAM_EXPR) != 0 && rt_node != ast.NOTHING {
            // expression body -> `return <expr>`
            let blk: u32 = ast.fn_body(b, fi as usize)
            if ast.b_len(b, blk) > 0 {
                let last: u32 = ast.slist_at(b, ast.b_off(b, blk) + ast.b_len(b, blk) - 1)
                if ast.s_kind(b, last) == ast.S_EXPR {
                    ast.s_kind_set(b, last, ast.S_RET)
                }
            }
        }
        num = num & 1
        if rt_node != ast.NOTHING {
            num = num | ((rt_node as u64 + 1) << 1)
        }
    } else {
        num = num & ((LAM_OPEN | LAM_BLK | LAM_EXPR) ^ 18446744073709551615)
    }
    ast.e_number_set(b, lam, num)
    return 0
}

// Declared type node of field `fname` of struct `sname` (NOTHING if unknown).
fn field_type(b: *mut ast.Tree, sname: u32, fname: u32) -> u32 {
    let n: usize = ast.structure_count(b)
    var i: usize = 0
    while i < n {
        if ast.structure_name(b, i) == sname {
            let off: u32 = ast.structure_foff(b, i)
            let len: u32 = ast.structure_flen(b, i)
            var k: u32 = 0
            while k < len {
                if ast.field_name(b, off + k) == fname {
                    return ast.field_ty(b, off + k)
                }
                k = k + 1
            }
            return ast.NOTHING
        }
        i = i + 1
    }
    return ast.NOTHING
}

// ---------------------------------------------------------------- r740
// `s.f = |x| ..` / `v[i] = gc |x| ..` / `f = |x| ..` -- the expected type is the
// DECLARED type of the assignment target (twin of lambda.rs `expr_ty` + the
// `Stmt::Assign` arm). The type of a target is derived without a type check from
// what is evident: parameters, `let x: T`, `let x = S{..}` / `let x = f(..)`,
// fields, `*p`, `a[i]` (array element / `Vec[T]` element via the struct's elem).

fn env_find(names: *mut Vec[u32], tys: *mut Vec[u32], name: u32) -> u32 {
    var i: usize = vec_len[u32](names)
    while i > 0 {
        i = i - 1
        if vec_at[u32](names, i) == name {
            return vec_at[u32](tys, i)
        }
    }
    return ast.NOTHING
}

fn strip_ptr(b: *mut ast.Tree, t: u32) -> u32 {
    var x: u32 = t
    while x != ast.NOTHING && ast.t_kind(b, x) == ast.T_PTR {
        x = ast.t_a(b, x)
    }
    return x
}

fn struct_at(b: *mut ast.Tree, name: u32) -> i64 {
    let n: usize = ast.structure_count(b)
    var i: usize = 0
    while i < n {
        if ast.structure_name(b, i) == name {
            return i as i64
        }
        i = i + 1
    }
    return -1
}

fn ty_of(b: *mut ast.Tree, it: *mut intern.Interner, ef: *mut err.Error, fmap: *mut Vec[u32],
    names: *mut Vec[u32], tys: *mut Vec[u32], e: u32) -> u32 {
    if e == ast.NOTHING {
        return ast.NOTHING
    }
    let k: u32 = ast.e_kind(b, e)
    if k == ast.E_ID {
        let t0: u32 = env_find(names, tys, ast.e_a(b, e))
        if t0 != ast.NOTHING || declared_anywhere(b, ast.e_a(b, e)) {
            return t0
        }
        // r742b: a module static / const
        let nm0: u32 = ast.e_a(b, e)
        var gi: usize = 0
        while gi < ast.static_count(b) {
            if ast.static_name(b, gi) == nm0 {
                return ast.static_ty(b, gi)
            }
            gi = gi + 1
        }
        gi = 0
        while gi < ast.const_count(b) {
            if ast.const_name(b, gi) == nm0 {
                return ast.const_ty(b, gi)
            }
            gi = gi + 1
        }
        return ast.NOTHING
    }
    if k == ast.E_AS {
        return ast.e_b(b, e)
    }
    if k == ast.E_UN && ast.e_a(b, e) == 2 {
        let inner: u32 = ty_of(b, it, ef, fmap, names, tys, ast.e_b(b, e))
        if inner == ast.NOTHING {
            return ast.NOTHING
        }
        return ast.ty_new(b, ast.T_PTR, inner, 1)
    }
    if k == ast.E_SLIT {
        return ast.ty_new(b, ast.T_NAME, ast.e_a(b, e), 0)
    }
    if k == ast.E_CALL && ast.e_number(b, e) == 0 && ast.e_c(b, e) > 0 {
        var mw: [u8; 7] = "method "
        let cn: u32 = ast.e_a(b, e)
        if intern.intern_prefix(it, cn, (&mw[0]) as u64, 7) {
            // r742: `obj.method()` -- the receiver type picks `Type__method`
            let rt0: u32 = strip_ptr(b, ty_of(b, it, ef, fmap, names, tys, ast.child_at(b, ast.e_b(b, e))))
            if rt0 == ast.NOTHING || ast.t_kind(b, rt0) != ast.T_NAME {
                return ast.NOTHING
            }
            let sn: u32 = ast.t_a(b, rt0)
            let mn: u32 = intern.intern_ab(it, cn, 7)
            var us: [u8; 2] = "__"
            var kl: rt.Buf = rt.buf_new()
            rt.buf_push_bytes(&kl, intern.intern_ptr(it, sn), intern.intern_length(it, sn))
            rt.buf_push_bytes(&kl, (&us[0]) as u64, 2)
            rt.buf_push_bytes(&kl, intern.intern_ptr(it, mn), intern.intern_length(it, mn))
            let fnm: u32 = intern.intern_number(it, rt.buf_ptr(&kl), rt.buf_len(&kl)) as u32
            rt.buf_free(&kl)
            if (fnm as usize) < vec_len[u32](fmap) && vec_at[u32](fmap, fnm as usize) != NONE {
                return ast.fn_ret(b, vec_at[u32](fmap, fnm as usize) as usize)
            }
            return ast.NOTHING
        }
        if ast.e_c(b, e) == 1 && err.error_is_tryname(it, cn) {
            // `try f()` -- the payload of the error union
            let at: u32 = ty_of(b, it, ef, fmap, names, tys, ast.child_at(b, ast.e_b(b, e)))
            let pl: u32 = unwrap_eu(b, it, ef, at)
            if pl != at {
                return pl
            }
            return ast.NOTHING
        }
    }
    if k == ast.E_CALL && ast.e_number(b, e) == 0 {
        let nm: u32 = ast.e_a(b, e)
        if (nm as usize) < vec_len[u32](fmap) {
            let fi: u32 = vec_at[u32](fmap, nm as usize)
            if fi != NONE {
                return ast.fn_ret(b, fi as usize)
            }
        }
        return ast.NOTHING
    }
    if k == ast.E_UN && ast.e_a(b, e) == 3 {
        let t: u32 = ty_of(b, it, ef, fmap, names, tys, ast.e_b(b, e))
        if t != ast.NOTHING && ast.t_kind(b, t) == ast.T_PTR {
            return ast.t_a(b, t)
        }
        return ast.NOTHING
    }
    if k == ast.E_FIELD {
        let t: u32 = strip_ptr(b, ty_of(b, it, ef, fmap, names, tys, ast.e_a(b, e)))
        if t != ast.NOTHING && ast.t_kind(b, t) == ast.T_NAME {
            return field_type(b, ast.t_a(b, t), ast.e_b(b, e))
        }
        return ast.NOTHING
    }
    if k == ast.E_IDX {
        let t: u32 = strip_ptr(b, ty_of(b, it, ef, fmap, names, tys, ast.e_a(b, e)))
        if t == ast.NOTHING {
            return ast.NOTHING
        }
        if ast.t_kind(b, t) == ast.T_ARR {
            return ast.t_a(b, t)
        }
        if ast.t_kind(b, t) == ast.T_NAME {
            let si: i64 = struct_at(b, ast.t_a(b, t))
            if si >= 0 {
                return ast.structure_elem(b, si as usize)
            }
        }
        return ast.NOTHING
    }
    return ast.NOTHING
}

// r750 (twin of lambda.rs `bound_method`) -- `try x.m` (x a pointer variable, `m` a method of its
// struct, no call): the operand `x.m` becomes the closure `gc |a0, ..| x.m(a0, ..)`. The parameter
// and result types come from the method, so no expected type is needed. The node is changed in
// place into an `E_LAMBDA` over a new closure function; the type check finds the captured `x`.
// Anything that is not that shape is left alone (stage 0 reports the errors).
fn bound_method(b: *mut ast.Tree, it: *mut intern.Interner, fmap: *mut Vec[u32],
    names: *mut Vec[u32], tys: *mut Vec[u32], ef: *mut err.Error, e: u32) {
    if ast.e_kind(b, e) != ast.E_FIELD {
        return
    }
    let base: u32 = ast.e_a(b, e)
    if base == ast.NOTHING || ast.e_kind(b, base) != ast.E_ID {
        return
    }
    let rt_ty: u32 = ty_of(b, it, ef, fmap, names, tys, base)
    if rt_ty == ast.NOTHING || ast.t_kind(b, rt_ty) != ast.T_PTR {
        return
    }
    let st: u32 = strip_ptr(b, rt_ty)
    if st == ast.NOTHING || ast.t_kind(b, st) != ast.T_NAME {
        return
    }
    let sn: u32 = ast.t_a(b, st)
    let mn: u32 = ast.e_b(b, e)
    if field_type(b, sn, mn) != ast.NOTHING {
        return
    }
    var us: [u8; 2] = "__"
    var kl: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&kl, intern.intern_ptr(it, sn), intern.intern_length(it, sn))
    rt.buf_push_bytes(&kl, (&us[0]) as u64, 2)
    rt.buf_push_bytes(&kl, intern.intern_ptr(it, mn), intern.intern_length(it, mn))
    let fnm: u32 = intern.intern_number(it, rt.buf_ptr(&kl), rt.buf_len(&kl)) as u32
    rt.buf_free(&kl)
    if (fnm as usize) >= vec_len[u32](fmap) || vec_at[u32](fmap, fnm as usize) == NONE {
        return
    }
    let mf: u32 = vec_at[u32](fmap, fnm as usize)
    let mplen: u32 = ast.fn_plen(b, mf as usize)
    if mplen == 0 {
        return
    }
    let mpoff: u32 = ast.fn_poff(b, mf as usize)
    let ret: u32 = ast.fn_ret(b, mf as usize)
    let pos: u64 = ast.expr_pos(b, e)

    // the closure parameters `__bm_a<i>` (typed like the method's) and the record
    let poff: u32 = ast.param_start(b)
    var k: u32 = 1
    while k < mplen {
        var pw: [u8; 6] = "__bm_a"
        kl = rt.buf_new()
        rt.buf_push_bytes(&kl, (&pw[0]) as u64, 6)
        rt.buf_push_dec_u64(&kl, (k - 1) as u64)
        let pnm: u32 = intern.intern_number(it, rt.buf_ptr(&kl), rt.buf_len(&kl)) as u32
        rt.buf_free(&kl)
        ast.param_add(b, pnm, ast.param_ty(b, mpoff + k))
        k = k + 1
    }
    var uw: [u8; 2] = "u8"
    let unr: u32 = intern.intern_number(it, (&uw[0]) as u64, 2) as u32
    let uty: u32 = ast.ty_new(b, ast.T_NAME, unr, 0)
    let pty: u32 = ast.ty_new(b, ast.T_PTR, uty, 1)
    var ew: [u8; 6] = "__env#"
    let ename: u32 = intern.intern_number(it, (&ew[0]) as u64, 6) as u32
    ast.param_add(b, ename, pty)

    // the body: `return x.m(a0, ..)` (or just the call when the method has no result)
    var mw: [u8; 7] = "method "
    kl = rt.buf_new()
    rt.buf_push_bytes(&kl, (&mw[0]) as u64, 7)
    rt.buf_push_bytes(&kl, intern.intern_ptr(it, mn), intern.intern_length(it, mn))
    let cnm: u32 = intern.intern_number(it, rt.buf_ptr(&kl), rt.buf_len(&kl)) as u32
    rt.buf_free(&kl)
    let aoff: u32 = ast.child_start(b)
    ast.child_add(b, base)
    k = 1
    while k < mplen {
        let ai: u32 = ast.expr_new(b, ast.E_ID, ast.param_name(b, poff + k - 1), 0, 0, 0)
        ast.expr_pos_set(b, ai, pos)
        ast.child_add(b, ai)
        k = k + 1
    }
    let call: u32 = ast.expr_new(b, ast.E_CALL, cnm, aoff, mplen, 0)
    ast.expr_pos_set(b, call, pos)
    var sk: u32 = ast.S_EXPR
    if ret != ast.NOTHING {
        sk = ast.S_RET
    }
    let stm: u32 = ast.stmt_new(b, sk, call, 0, 0, 0)
    ast.stmt_pos_set(b, stm, pos)
    let soff: u32 = ast.slist_start(b)
    ast.slist_add(b, stm)
    let body: u32 = ast.block_new(b, soff, 1)
    ast.block_end_set(b, body, pos)

    var cw: [u8; 10] = "__closure#"
    kl = rt.buf_new()
    rt.buf_push_bytes(&kl, (&cw[0]) as u64, 10)
    rt.buf_push_dec_u64(&kl, ast.fn_count(b) as u64)
    let cname: u32 = intern.intern_number(it, rt.buf_ptr(&kl), rt.buf_len(&kl)) as u32
    rt.buf_free(&kl)
    ast.fn_add(b, cname, poff, mplen, ret, body, 0, 0, 0, 0, 0, 0, 0)
    var packed: u64 = 1
    if ret != ast.NOTHING {
        packed = packed | ((ret as u64 + 1) << 1)
    }
    ast.e_kind_set(b, e, ast.E_LAMBDA)
    ast.e_a_set(b, e, cname)
    ast.e_b_set(b, e, poff)
    ast.e_c_set(b, e, mplen - 1)
    ast.e_number_set(b, e, packed)
}

// r742b: every plain call inside the expression `e` (depth first). A call whose callee is a
// generic function (not in the function table) gets the evident argument types from the
// environment and may be renamed to an instance by the hook.
fn calls_in_expr(b: *mut ast.Tree, it: *mut intern.Interner, ef: *mut err.Error, hk: *mut Hk,
    fmap: *mut Vec[u32], names: *mut Vec[u32], tys: *mut Vec[u32], e: u32) {
    if e == ast.NOTHING {
        return
    }
    let k: u32 = ast.e_kind(b, e)
    if k == ast.E_UN || k == ast.E_NAMED {
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.e_b(b, e))
    } else if k == ast.E_BIN {
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.e_b(b, e))
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.e_c(b, e))
    } else if k == ast.E_FIELD || k == ast.E_AS {
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.e_a(b, e))
    } else if k == ast.E_IDX {
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.e_a(b, e))
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.e_b(b, e))
    } else if k == ast.E_IFEX {
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.e_a(b, e))
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.e_b(b, e))
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.e_c(b, e))
    } else if k == ast.E_SLIT {
        var q: u32 = 0
        while q < ast.e_c(b, e) {
            calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.child_at(b, ast.e_b(b, e) + q * 2 + 1))
            q = q + 1
        }
    } else if k == ast.E_ALIT {
        var q: u32 = 0
        while q < ast.e_c(b, e) {
            calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.child_at(b, ast.e_b(b, e) + q))
            q = q + 1
        }
    } else if k == ast.E_CALL && ast.e_number(b, e) == 0 {
        let off: u32 = ast.e_b(b, e)
        let cnt: u32 = ast.e_c(b, e)
        if cnt == 1 && err.error_is_tryname(it, ast.e_a(b, e)) {
            bound_method(b, it, fmap, names, tys, ef, ast.child_at(b, off))
        }
        var q: u32 = 0
        while q < cnt {
            calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.child_at(b, off + q))
            q = q + 1
        }
        var mw: [u8; 7] = "method "
        let name: u32 = ast.e_a(b, e)
        if !intern.intern_prefix(it, name, (&mw[0]) as u64, 7) && !err.error_is_tryname(it, name)
        && ((name as usize) >= vec_len[u32](fmap) || vec_at[u32](fmap, name as usize) == NONE) {
            var atys: Vec[u32] = vec_new[u32]()
            q = 0
            while q < cnt {
                vec_push[u32](&atys, ty_of(b, it, ef, fmap, names, tys, ast.child_at(b, off + q)))
                q = q + 1
            }
            use_call_hook(hk, e, &atys)
            vec_free[u32](&atys)
        }
    }
}

fn assign_stmt(b: *mut ast.Tree, it: *mut intern.Interner, ef: *mut err.Error, hk: *mut Hk,
    fmap: *mut Vec[u32], names: *mut Vec[u32], tys: *mut Vec[u32], st: u32) {
    let k: u32 = ast.s_kind(b, st)
    if k == ast.S_LET || k == ast.S_VAR {
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.s_c(b, st))
        var t: u32 = ast.s_b(b, st)
        if t == ast.NOTHING {
            t = ty_of(b, it, ef, fmap, names, tys, ast.s_c(b, st))
        }
        vec_push[u32](names, ast.s_a(b, st))
        vec_push[u32](tys, t)
        return
    }
    if k == ast.S_ZUW || k == ast.S_ZUWOP {
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.s_a(b, st))
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.s_b(b, st))
    }
    if k == ast.S_RET || k == ast.S_EXPR {
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.s_a(b, st))
        return
    }
    if k == ast.S_IF || k == ast.S_WHILE {
        calls_in_expr(b, it, ef, hk, fmap, names, tys, ast.s_a(b, st))
    }
    if k == ast.S_ZUW {
        let tgt: u32 = ty_of(b, it, ef, fmap, names, tys, ast.s_a(b, st))
        use_hook(hk, b, ast.s_b(b, st), tgt)
        let lam: u32 = lambda_of(b, it, ast.s_b(b, st))
        if lam != NONE && is_open(b, lam) {
            let t: u32 = ty_of(b, it, ef, fmap, names, tys, ast.s_a(b, st))
            resolve(b, fmap, lam, unwrap_eu(b, it, ef, t))
        }
        return
    }
    if k == ast.S_IF {
        assign_block(b, it, ef, hk, fmap, names, tys, ast.s_b(b, st))
        if ast.s_c(b, st) != ast.NOTHING {
            assign_stmt(b, it, ef, hk, fmap, names, tys, ast.s_c(b, st))
        }
        return
    }
    if k == ast.S_WHILE {
        assign_block(b, it, ef, hk, fmap, names, tys, ast.s_b(b, st))
        return
    }
    if k == ast.S_FOR {
        // r742: the loop variable shadows an outer name of another type
        let fmark: usize = vec_len[u32](names)
        vec_push[u32](names, ast.s_a(b, st))
        vec_push[u32](tys, ast.NOTHING)
        assign_block(b, it, ef, hk, fmap, names, tys, ast.s_d(b, st))
        while vec_len[u32](names) > fmark {
            vec_pop[u32](names)
            vec_pop[u32](tys)
        }
        return
    }
    if k == ast.S_BLOCK {
        assign_block(b, it, ef, hk, fmap, names, tys, ast.s_a(b, st))
        return
    }
    if k == ast.S_DEFER || k == ast.S_ERRDEFER {
        assign_stmt(b, it, ef, hk, fmap, names, tys, ast.s_a(b, st))
        return
    }
}

fn assign_block(b: *mut ast.Tree, it: *mut intern.Interner, ef: *mut err.Error, hk: *mut Hk,
    fmap: *mut Vec[u32], names: *mut Vec[u32], tys: *mut Vec[u32], blk: u32) {
    // r742: block scoping -- what the block declares ends with it
    let mark: usize = vec_len[u32](names)
    var i: u32 = 0
    let n: u32 = ast.b_len(b, blk)
    while i < n {
        assign_stmt(b, it, ef, hk, fmap, names, tys, ast.slist_at(b, ast.b_off(b, blk) + i))
        i = i + 1
    }
    while vec_len[u32](names) > mark {
        vec_pop[u32](names)
        vec_pop[u32](tys)
    }
}

fn run_assign(b: *mut ast.Tree, it: *mut intern.Interner, ef: *mut err.Error, hk: *mut Hk,
    fmap: *mut Vec[u32]) {
    var names: Vec[u32] = vec_new[u32]()
    var tys: Vec[u32] = vec_new[u32]()
    let nf: usize = ast.fn_count(b)
    var f: usize = 0
    while f < nf {
        vec_clear[u32](&names)
        vec_clear[u32](&tys)
        let poff: u32 = ast.fn_poff(b, f)
        var k: u32 = 0
        while k < ast.fn_plen(b, f) {
            vec_push[u32](&names, ast.param_name(b, poff + k))
            vec_push[u32](&tys, ast.param_ty(b, poff + k))
            k = k + 1
        }
        if ast.fn_extern(b, f) == 0 {
            assign_block(b, it, ef, hk, fmap, &names, &tys, ast.fn_body(b, f))
        }
        f = f + 1
    }
    vec_free[u32](&names)
    vec_free[u32](&tys)
}

// Resolves every lambda that sits in a place with a known expected type and
// counts the ones that remain open. Cheap when the program uses no sugar.
fn run(b: *mut ast.Tree, it: *mut intern.Interner, ef: *mut err.Error, gp: u64,
    hook: fn(u64, u32, u32, u64) -> u32) -> u32 {
    var hkv: Hk = Hk { gp: gp, hook: hook }
    let hk: *mut Hk = &hkv
    let total: usize = ast.expr_count(b)
    var any: bool = false
    var i: usize = 0
    // r742: struct names (for `Type.m` as a value)
    var sflag: Vec[u32] = vec_new[u32]()
    defer vec_free[u32](&sflag)
    var maxs: u32 = 0
    let nst: usize = ast.structure_count(b)
    var si: usize = 0
    while si < nst {
        if ast.structure_name(b, si) > maxs {
            maxs = ast.structure_name(b, si)
        }
        si = si + 1
    }
    if nst > 0 {
        var z0: usize = 0
        while z0 <= (maxs as usize) {
            vec_push[u32](&sflag, 0)
            z0 = z0 + 1
        }
        si = 0
        while si < nst {
            vec_set[u32](&sflag, ast.structure_name(b, si) as usize, 1)
            si = si + 1
        }
    }
    while i < total {
        let ki: u32 = ast.e_kind(b, i as u32)
        if is_open(b, i as u32) {
            any = true
            break
        }
        // r742: a generic function name (candidate for inference) or `Type.m`
        if gp != 0 && ki == ast.E_ID {
            let f0: fn(u64, u32, u32, u64) -> u32 = hook
            if f0(gp, i as u32, NONE, 0) == 1 {
                any = true
                break
            }
        }
        // r750: `try x.m` (bound method value)
        if ki == ast.E_CALL && ast.e_number(b, i as u32) == 0 && ast.e_c(b, i as u32) == 1
        && err.error_is_tryname(it, ast.e_a(b, i as u32))
        && ast.e_kind(b, ast.child_at(b, ast.e_b(b, i as u32))) == ast.E_FIELD {
            any = true
            break
        }
        if ki == ast.E_FIELD {
            let bs: u32 = ast.e_a(b, i as u32)
            if bs != ast.NOTHING && ast.e_kind(b, bs) == ast.E_ID {
                let sn0: u32 = ast.e_a(b, bs)
                if (sn0 as usize) < vec_len[u32](&sflag) && vec_at[u32](&sflag, sn0 as usize) != 0 {
                    any = true
                    break
                }
            }
        }
        i = i + 1
    }
    if !any {
        return 0
    }
    // interned name -> function number
    let nf: usize = ast.fn_count(b)
    var maxn: u32 = 0
    var f: usize = 0
    while f < nf {
        if ast.fn_name(b, f) > maxn {
            maxn = ast.fn_name(b, f)
        }
        f = f + 1
    }
    var fmap: Vec[u32] = vec_new[u32]()
    var z: usize = 0
    while z <= (maxn as usize) {
        vec_push[u32](&fmap, NONE)
        z = z + 1
    }
    f = 0
    while f < nf {
        vec_set[u32](&fmap, ast.fn_name(b, f) as usize, f as u32)
        f = f + 1
    }
    var errors: u32 = 0
    method_values(b, it, &fmap, &sflag)
    var mw: [u8; 7] = "method "
    // arguments of plain calls
    var e: usize = 0
    while e < total {
        if ast.e_kind(b, e as u32) == ast.E_CALL && ast.e_number(b, e as u32) == 0 {
            let name: u32 = ast.e_a(b, e as u32)
            if intern.intern_prefix(it, name, (&mw[0]) as u64, 7) {
                // r732: method call -- `method m(recv, args..)`
                let off: u32 = ast.e_b(b, e as u32)
                let cnt: u32 = ast.e_c(b, e as u32)
                var k: u32 = 1
                while k < cnt {
                    use_hook(hk, b, ast.child_at(b, off + k), method_param_type(b, it, name, cnt, k))
                    let lam: u32 = lambda_of(b, it, ast.child_at(b, off + k))
                    if lam != NONE && is_open(b, lam) {
                        let pt: u32 = method_param_type(b, it, name, cnt, k)
                        errors = errors + resolve(b, &fmap, lam, unwrap_eu(b, it, ef, pt))
                    }
                    k = k + 1
                }
            } else if (name as usize) < vec_len[u32](&fmap) && !err.error_is_tryname(it, name) {
                let fi: u32 = vec_at[u32](&fmap, name as usize)
                if fi != NONE {
                    let off: u32 = ast.e_b(b, e as u32)
                    let cnt: u32 = ast.e_c(b, e as u32)
                    let pof: u32 = ast.fn_poff(b, fi as usize)
                    let pln: u32 = ast.fn_plen(b, fi as usize)
                    var k: u32 = 0
                    while k < cnt && k < pln {
                        use_hook(hk, b, ast.child_at(b, off + k), ast.param_ty(b, pof + k))
                        let lam: u32 = lambda_of(b, it, ast.child_at(b, off + k))
                        if lam != NONE && is_open(b, lam) {
                            errors = errors + resolve(b, &fmap, lam, unwrap_eu(b, it, ef, ast.param_ty(b, pof + k)))
                        }
                        k = k + 1
                    }
                }
            }
        }
        e = e + 1
    }
    // `let x: T = lambda` / `var x: T = lambda`
    let ns: usize = vec_len[u32](&(*b).s_kind)
    var s: usize = 0
    while s < ns {
        let k2: u32 = ast.s_kind(b, s as u32)
        if (k2 == ast.S_LET || k2 == ast.S_VAR) && ast.s_b(b, s as u32) != ast.NOTHING {
            use_hook(hk, b, ast.s_c(b, s as u32), ast.s_b(b, s as u32))
            let lam: u32 = lambda_of(b, it, ast.s_c(b, s as u32))
            if lam != NONE && is_open(b, lam) {
                errors = errors + resolve(b, &fmap, lam, unwrap_eu(b, it, ef, ast.s_b(b, s as u32)))
            }
        }
        s = s + 1
    }
    // `return lambda` -- expected type = the declared result type (parser stores type node + 1)
    s = 0
    while s < ns {
        if ast.s_kind(b, s as u32) == ast.S_RET && ast.s_b(b, s as u32) != 0
        && ast.s_a(b, s as u32) != ast.NOTHING {
            use_hook(hk, b, ast.s_a(b, s as u32), ast.s_b(b, s as u32) - 1)
            let lam: u32 = lambda_of(b, it, ast.s_a(b, s as u32))
            if lam != NONE && is_open(b, lam) {
                errors = errors + resolve(b, &fmap, lam, unwrap_eu(b, it, ef, ast.s_b(b, s as u32) - 1))
            }
        }
        s = s + 1
    }
    // r740: assignments `target = lambda`
    run_assign(b, it, ef, hk, &fmap)
    // struct literal fields `S { f: lambda }`
    e = 0
    while e < total {
        if ast.e_kind(b, e as u32) == ast.E_SLIT {
            let off: u32 = ast.e_b(b, e as u32)
            let cnt: u32 = ast.e_c(b, e as u32)
            var k: u32 = 0
            while k < cnt {
                use_hook(hk, b, ast.child_at(b, off + k * 2 + 1), field_type(b, ast.e_a(b, e as u32), ast.child_at(b, off + k * 2)))
                let lam: u32 = lambda_of(b, it, ast.child_at(b, off + k * 2 + 1))
                if lam != NONE && is_open(b, lam) {
                    let ft: u32 = field_type(b, ast.e_a(b, e as u32), ast.child_at(b, off + k * 2))
                    errors = errors + resolve(b, &fmap, lam, unwrap_eu(b, it, ef, ft))
                }
                k = k + 1
            }
        }
        e = e + 1
    }
    // whatever is still open has no usable expected type (the closure functions of
    // template bodies are not in the function table: those nodes are copied per instance)
    e = 0
    while e < total {
        if is_open(b, e as u32) {
            let cn: u32 = ast.e_a(b, e as u32)
            if (cn as usize) < vec_len[u32](&fmap) && vec_at[u32](&fmap, cn as usize) != NONE {
                errors = errors + 1
            }
        }
        e = e + 1
    }
    vec_free[u32](&fmap)
    return errors
}
