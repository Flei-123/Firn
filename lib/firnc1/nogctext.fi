fn nogctext_write(b: *mut rt.Buf, with_threads: bool) {
    var limit: u64 = NOGCTEXT_N
    if with_threads {
        limit = NOGCTEXT_ALL
    }
    var written: u64 = 0
    var i: usize = 0
    while i < 978 {
        let v: u64 = NOGCTEXT_WORDS[i]
        var k: u64 = 0
        while k < 8 {
            if written >= limit {
                return
            }
            rt.buf_push(b, ((v >> (k * 8)) & 255) as u8)
            written = written + 1
            k = k + 1
        }
        i = i + 1
    }
}
