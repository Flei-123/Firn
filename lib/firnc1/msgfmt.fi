import rt
import intern
import types

export { fmt_msg }

fn push_op(out: *mut rt.Buf, index: usize) {
    var words: [u8; 61] = "+ - * / % & | ^ << >> == != < <= > >= && || +% -% *% +| -| *|"
    var at: usize = 0
    var w: usize = 0
    var i: usize = 0
    while i <= 61 {
        if i == 61 || words[i] == 32 as u8 {
            if w == index {
                rt.buf_push_bytes(out, (&words[0]) as u64 + at as u64, i - at)
                return
            }
            w = w + 1
            at = i + 1
        }
        i = i + 1
    }
}


fn fmt_msg(out: *mut rt.Buf, tmpl: u64, n: usize, ty: *mut types.Types, it: *mut intern.Interner,
        a0: u64, a1: u64, a2: u64, a3: u64) {
    var k: usize = 0
    var used: usize = 0
    while k < n {
        let c: u8 = *((tmpl + k as u64) as *mut u8)
        if c == 37 as u8 && k + 1 < n {
            let d: u8 = *((tmpl + k as u64 + 1) as *mut u8)
            var a: u64 = a0
            if used == 1 { a = a1 }
            if used == 2 { a = a2 }
            if used == 3 { a = a3 }
            if d == 116 as u8 {
                types.name_of(ty, it, out, a as u32)
                used = used + 1
            } else if d == 110 as u8 {
                rt.buf_push_bytes(out, intern.intern_ptr(it, a as u32), intern.intern_length(it, a as u32))
                used = used + 1
            } else if d == 111 as u8 {
                push_op(out, a as usize)
                used = used + 1
            } else if d == 100 as u8 {
                rt.buf_push_dec_u64(out, a)
                used = used + 1
            } else if d == 105 as u8 {
                rt.buf_push_dec_i64(out, a as i64)
                used = used + 1
            } else {
                rt.buf_push(out, d)
            }
            k = k + 2
        } else {
            rt.buf_push(out, c)
            k = k + 1
        }
    }
}
