// SPDX-License-Identifier: MPL-2.0

import rt
import ast

export { Unsafety, uns_new, uns_free, uns_mode_set, uns_scope_add, uns_enter, uns_leave,
    uns_level, uns_warn, MODE_OFF, MODE_WARN, MODE_ERROR }

const MODE_OFF: u32 = 0
const MODE_WARN: u32 = 1
const MODE_ERROR: u32 = 2

struct Unsafety {
    mode: u32,
    depth: u32,
    scope: rt.Buf,
    scope_count: u32,
}

fn uns_new() -> Unsafety {
    return Unsafety { mode: 0, depth: 0, scope: rt.buf_new(), scope_count: 0 }
}

fn uns_free(u: *mut Unsafety) {
    rt.buf_free(&(*u).scope)
}

fn uns_mode_set(u: *mut Unsafety, mode: u32) { (*u).mode = mode }

fn uns_scope_add(u: *mut Unsafety, p: u64, n: usize) {
    rt.buf_push_bytes(&(*u).scope, p, n)
    rt.buf_push(&(*u).scope, 0 as u8)
    (*u).scope_count = (*u).scope_count + 1
}

fn uns_enter(u: *mut Unsafety) { (*u).depth = (*u).depth + 1 }

fn uns_leave(u: *mut Unsafety) { (*u).depth = (*u).depth - 1 }

fn contains(hay: u64, hn: usize, needle: u64, nn: usize) -> bool {
    if nn > hn {
        return false
    }
    var i: usize = 0
    while i + nn <= hn {
        if rt.mem_eq(hay + i as u64, needle, nn) {
            return true
        }
        i = i + 1
    }
    return false
}

fn in_scope(u: *mut Unsafety, tree: *mut ast.Tree, pos: u64) -> bool {
    if (*u).scope_count == 0 {
        return true
    }
    let file: u32 = ast.pos_file(pos)
    if (file as usize) >= ast.file_count(tree) {
        return false
    }
    let name: u64 = ast.file_ptr(tree, file)
    let name_n: usize = ast.file_length(tree, file)
    let base: u64 = rt.buf_ptr(&(*u).scope)
    let total: usize = rt.buf_len(&(*u).scope)
    var start: usize = 0
    var i: usize = 0
    while i < total {
        if rt.ld8(base, i) == 0 as u8 {
            if contains(name, name_n, base + start as u64, i - start) {
                return true
            }
            start = i + 1
        }
        i = i + 1
    }
    return false
}

fn uns_level(u: *mut Unsafety, tree: *mut ast.Tree, pos: u64) -> u32 {
    if (*u).depth > 0 || (*u).mode == 0 {
        return 0
    }
    if !in_scope(u, tree, pos) {
        return 0
    }
    return (*u).mode
}

fn uns_warn(tree: *mut ast.Tree, pos: u64, msg: *mut rt.Buf) {
    var out: rt.Buf = rt.buf_new()
    let file: u32 = ast.pos_file(pos)
    if (file as usize) < ast.file_count(tree) {
        rt.buf_push_bytes(&out, ast.file_ptr(tree, file), ast.file_length(tree, file))
    }
    rt.buf_push(&out, 58 as u8)
    rt.buf_push_dec_u64(&out, ast.pos_line(pos) as u64)
    rt.buf_push(&out, 58 as u8)
    rt.buf_push_dec_u64(&out, ast.pos_col(pos) as u64)
    var warn: [u8; 10] = ": warning:"
    rt.buf_push_bytes(&out, (&warn[0]) as u64, 10)
    rt.buf_push(&out, 32 as u8)
    rt.buf_push_bytes(&out, rt.buf_ptr(msg), rt.buf_len(msg))
    rt.buf_push(&out, 10 as u8)
    rt.write_everything(2, rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
}
