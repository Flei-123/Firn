// SPDX-License-Identifier: MPL-2.0
// lib/firnc1/cachekey.fi -- the key of the compile cache (same recipe as compiler/src/buildcache.rs).

import rt
import vec
import sha256
import package

export { key_new, key_free, key_field, key_identity, key_start, key_file, key_manifest, key_finish }

fn key_new() -> sha256.Hash {
    return sha256.hash_new()
}

fn key_free(h: *mut sha256.Hash) {
    sha256.hash_free(h)
}

fn key_field(h: *mut sha256.Hash, tag: u64, tag_n: usize, p: u64, n: usize) {
    sha256.hash_push(h, tag, tag_n)
    sha256.hash_byte(h, 10 as u8)
    sha256.hash_dec(h, n as u64)
    sha256.hash_byte(h, 10 as u8)
    sha256.hash_push(h, p, n)
    sha256.hash_byte(h, 10 as u8)
}

fn is_arg(a: u64, lit: u64) -> bool {
    var i: usize = 0
    while rt.ld8(lit, i) != 0 as u8 {
        if rt.ld8(a, i) != rt.ld8(lit, i) {
            return false
        }
        i = i + 1
    }
    return rt.ld8(a, i) == 0 as u8
}

fn starts(a: u64, lit: u64) -> bool {
    var i: usize = 0
    while rt.ld8(lit, i) != 0 as u8 {
        if rt.ld8(a, i) != rt.ld8(lit, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn hash_arguments(h: *mut sha256.Hash, start: u64) {
    var o_opt: [u8; 3] = "-o\0"
    var nc_opt: [u8; 11] = "--no-cache\0"
    var dd_opt: [u8; 3] = "--\0"
    var tag: [u8; 3] = "arg"
    var i: usize = 1
    while i < rt.arg_count(start) {
        let a: u64 = rt.arg_ptr(start, i)
        if is_arg(a, (&o_opt[0]) as u64) {
            i = i + 2
        } else {
            let skip: bool = is_arg(a, (&nc_opt[0]) as u64)
                || (starts(a, (&o_opt[0]) as u64) && !starts(a, (&dd_opt[0]) as u64))
            if !skip {
                key_field(h, (&tag[0]) as u64, 3, a, rt.c_length(a))
            }
            i = i + 1
        }
    }
}

fn name_length(p: u64) -> usize {
    var n: usize = 0
    while rt.ld8(p, n) != 61 as u8 && rt.ld8(p, n) != 0 as u8 {
        n = n + 1
    }
    return n
}

fn excluded_env(p: u64, n: usize) -> bool {
    var a: [u8; 15] = "FIRN_CACHE_DIR\0"
    var b: [u8; 18] = "FIRN_CACHE_MAX_MB\0"
    var c: [u8; 14] = "FIRN_NO_CACHE\0"
    var d: [u8; 15] = "FIRN_CACHE_LOG\0"
    return same_name(p, n, (&a[0]) as u64) || same_name(p, n, (&b[0]) as u64)
        || same_name(p, n, (&c[0]) as u64) || same_name(p, n, (&d[0]) as u64)
}

fn same_name(p: u64, n: usize, lit: u64) -> bool {
    return rt.c_length(lit) == n && starts(p, lit)
}

fn env_less(a: u64, b: u64) -> bool {
    let an: usize = name_length(a)
    let bn: usize = name_length(b)
    var i: usize = 0
    while i < an && i < bn {
        if rt.ld8(a, i) != rt.ld8(b, i) {
            return rt.ld8(a, i) < rt.ld8(b, i)
        }
        i = i + 1
    }
    if an != bn {
        return an < bn
    }
    return package.str_less(a + an as u64 + 1, rt.c_length(a) - an - 1,
        b + bn as u64 + 1, rt.c_length(b) - bn - 1)
}

fn hash_environment(h: *mut sha256.Hash, start: u64) {
    var pick: Vec[u64] = vec_new[u64]()
    var prefix: [u8; 6] = "FIRN\0\0"
    var i: usize = 1 + rt.arg_count(start) + 1
    var p: u64 = rt.ld64(start, i)
    while p != 0 {
        if starts(p, (&prefix[0]) as u64) && !excluded_env(p, name_length(p)) {
            var at: usize = vec_len[u64](&pick)
            vec_push[u64](&pick, p)
            while at > 0 && env_less(p, vec_at[u64](&pick, at - 1)) {
                vec_set[u64](&pick, at, vec_at[u64](&pick, at - 1))
                at = at - 1
            }
            vec_set[u64](&pick, at, p)
        }
        i = i + 1
        p = rt.ld64(start, i)
    }
    var t_env: [u8; 3] = "env"
    var t_val: [u8; 3] = "val"
    var k: usize = 0
    while k < vec_len[u64](&pick) {
        let q: u64 = vec_at[u64](&pick, k)
        let nn: usize = name_length(q)
        key_field(h, (&t_env[0]) as u64, 3, q, nn)
        key_field(h, (&t_val[0]) as u64, 3, q + nn as u64 + 1, rt.c_length(q) - nn - 1)
        k = k + 1
    }
    vec_free[u64](&pick)
}

fn key_identity(start: u64, out: *mut rt.Buf) {
    var h: sha256.Hash = key_new()
    hash_identity(&h, start)
    key_finish(&h, out)
    key_free(&h)
}

fn key_start(h: *mut sha256.Hash, identity: *mut rt.Buf) {
    var t_identity: [u8; 8] = "identity"
    key_field(h, (&t_identity[0]) as u64, 8, rt.buf_ptr(identity), rt.buf_len(identity))
}

fn hash_identity(h: *mut sha256.Hash, start: u64) {
    var exe_path: [u8; 15] = "/proc/self/exe\0"
    var exe: rt.Buf = rt.buf_new()
    rt.read_file((&exe_path[0]) as u64, &exe)
    var sum: rt.Buf = rt.buf_new()
    sha256.sha256_hex(&sum, rt.buf_ptr(&exe), rt.buf_len(&exe))
    var t_compiler: [u8; 8] = "compiler"
    key_field(h, (&t_compiler[0]) as u64, 8, rt.buf_ptr(&sum), rt.buf_len(&sum))
    rt.buf_free(&exe)
    rt.buf_free(&sum)
    var cwd: rt.Buf = rt.buf_new()
    package.work_dir(&cwd)
    var t_cwd: [u8; 3] = "cwd"
    key_field(h, (&t_cwd[0]) as u64, 3, rt.buf_ptr(&cwd), rt.buf_len(&cwd))
    rt.buf_free(&cwd)
    hash_arguments(h, start)
    hash_environment(h, start)
}

fn key_file(h: *mut sha256.Hash, path: u64, path_n: usize, src: u64, src_n: usize) {
    var t_path: [u8; 4] = "path"
    var t_src: [u8; 3] = "src"
    key_field(h, (&t_path[0]) as u64, 4, path, path_n)
    key_field(h, (&t_src[0]) as u64, 3, src, src_n)
}

fn key_manifest(h: *mut sha256.Hash, path: u64) {
    var t_manifest: [u8; 8] = "manifest"
    var t_body: [u8; 13] = "manifest-body"
    key_field(h, (&t_manifest[0]) as u64, 8, path, rt.c_length(path))
    var body: rt.Buf = rt.buf_new()
    rt.read_file(path, &body)
    key_field(h, (&t_body[0]) as u64, 13, rt.buf_ptr(&body), rt.buf_len(&body))
    rt.buf_free(&body)
}

fn key_finish(h: *mut sha256.Hash, out: *mut rt.Buf) {
    rt.buf_clear(out)
    sha256.hash_hex(h, out)
}
