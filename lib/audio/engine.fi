// SPDX-License-Identifier: MPL-2.0
// lib/audio/engine.fi -- audio.engine: a game audio engine after the design of
// AULOS (C++, /root/projects/aulos). Events, voices, buses, 3D, master limiter.
// Function-by-function mapping: docs/AUDIO.md.
//
//     import audio.engine
//
//     var e: engine.Engine = engine.engine_new(48000 as u32, 64 as u32)
//     engine.engine_ensure_bus(&e, "sfx", "master")
//     let s: i32 = engine.engine_add_sample(&e, f32_ptr, frames, 1 as u32)   // or engine_load_wav / engine_load_mp3
//     let ev: i32 = engine.engine_add_event(&e, "step", engine.engine_bus_id(&e, "sfx"))
//     engine.engine_event_add_sample(&e, ev, s)
//     let h: u32 = engine.engine_play_3d(&e, ev, -1, 3.0, 0.0, -4.0)         // handle
//     engine.engine_update(&e)                                                // once per frame
//     engine.engine_render(&e, out_f32_stereo, 1024)                          // offline, or
//     engine.engine_pump(&e, &sink, 4096)                                     // into an audio.sink
//
// THE MATH IS AULOS' MATH, IN f32 (same order of operations):
//   voice gain   = base_volume * user_volume * fade * param curves (* 3D attenuation)
//   2D mono      = centre pan law cos/sin(pi/4) = 0.70710678 per side; 2D stereo passes at 1.0
//   3D           = inverse (min / (min + rolloff * (d - min))) or linear rolloff; pan from
//                  dot(rel, right) / distance, equal power: cos/sin((pan + 1) * pi/4)
//   Doppler      = (343 - k * v_listener) / (343 - k * v_source), clamped 0.25 .. 4
//   per block    = gains ramp linearly over the 128 frame block (no zipper noise)
//   buses        = deepest first into their parent, own gain ramps per block, mute is a flag
//   limiter      = master, ceiling 0.97, attack 1 ms, release 250 ms
//
// HONEST DIFFERENCES TO AULOS (see docs/AUDIO.md):
// E1  Done: JSON banks are read by audio.bank (lib/audio/bank.fi); events can still be built with calls.
// E2  Mutex mode by default; engine_audio_start switches to LOCK FREE (SPSC command + reclaim rings, atomics,
//     audio thread). Commands still land at the START of the next render, like Aulos. See docs/AUDIO.md.
// E3  Sample rate conversion is plain linear interpolation (Aulos: miniaudio's
//     resampler with a low pass). Same rate = no conversion = bit identical decode.
// E4  A parameter curve holds up to 16 points, an event up to 16 samples / 8 parameters.
// E5  sin/cos/exp are `std.math` (f64, rounded to f32): up to 1 ulp(f32) from libm's float versions.
import std.rt
import std.math
import std.str
import std.hash
import audio.sink
import audio.ring
import std.time
import ton.mp3
import ton.mp3_tab

export {
    Engine, EventDef, ParamMap, Stats, Sample, Bus, Voice, Shared, Cmd, Reclaim, Targets,
    engine_new, engine_free, engine_ensure_bus, engine_bus_id,
    engine_set_bus_volume, engine_get_bus_volume, engine_set_bus_mute, engine_get_bus_mute,
    engine_bus_effective_volume,
    engine_add_sample, engine_load_wav, engine_load_mp3, engine_sample_frames, engine_sample_count, engine_event_count,
    engine_sample_adopt_last, engine_sample_in_use, engine_sample_release, engine_sample_retarget, engine_sample_room, engine_sample_free_slots, engine_event_set_sample, engine_event_slot_sample, MAX_SAMPLES, MAX_EVENTS, engine_event_set_slot, engine_event_slot_volume, engine_event_slot_pitch, engine_events_clear, engine_param_pool_used, engine_sample_id_pool_used,
    engine_add_event, engine_event_add_sample, engine_event_add_param, engine_event, engine_find_event,
    engine_set_listener, engine_play, engine_play_3d, engine_stop, engine_stop_all, engine_is_playing,
    engine_set_position, engine_set_volume, engine_set_pitch, engine_set_param,
    engine_update, engine_render, engine_pump, engine_stats,
    PARAM_VOLUME, PARAM_PITCH, PARAM_LOWPASS,
    // E1 helpers for audio.bank (names as pointer + length)
    engine_bus_make, engine_bus_init, engine_bus_set_parent, engine_bus_rebuild, engine_event_replace,
    AudioStats,
    // E2: lock free mode, audio thread
    engine_set_lockfree, engine_is_lockfree, engine_audio_start, engine_audio_stop, engine_audio_running,
    engine_audio_stats, audio_main, AUDIO_KIND,
    // PCM streaming voices (audio.ring)
    engine_play_stream, engine_stream_stop, engine_stream_set, engine_stream_playing, MAX_STREAMS,
}

const BLOCK: usize = 128
const MAX_PARAMS: usize = 8
const MAX_BUSES: usize = 32
const MAX_SAMPLES: usize = 4096
const MAX_EVENTS: usize = 2048
const MAX_POOL: usize = 16384
const NAME_TAB: usize = 8192 // event name index (open addressing, i32 = event id + 1, 0 = empty); >= 2 * MAX_EVENTS
const CMD_CAP: usize = 4096
const PARAM_VOLUME: u32 = 0
const PARAM_PITCH: u32 = 1
const PARAM_LOWPASS: u32 = 2

const CMD_START: u32 = 0
const CMD_STOP: u32 = 1
const CMD_STOP_ALL: u32 = 2
const CMD_SET_POSITION: u32 = 3
const CMD_SET_VOLUME: u32 = 4
const CMD_SET_PITCH: u32 = 5
const CMD_SET_PARAM: u32 = 6
const CMD_LISTENER: u32 = 7
const CMD_STREAM_START: u32 = 8
const CMD_STREAM_STOP: u32 = 9
const CMD_STREAM_SET: u32 = 10
const MAX_STREAMS: usize = 16
const STREAM_CAP: usize = 1024 // frames buffered per stream voice (stereo f32)
const AUDIO_KIND: u64 = 1634952804 // thread kind for the dispatcher, see engine_audio_start

struct Sample {
    data: u64, // f32, interleaved
    frames: u64,
    channels: u32,
}

struct ParamMap {
    name_p: u64,
    name_n: usize,
    target: u32,
    default_value: f32,
    curve_first: u32, // index into the curve pool
    curve_n: u32,
}

struct EventDef {
    name_p: u64,
    name_n: usize,
    sample_first: u32, // index into the sample id pool
    sample_n: u32,
    bus: i32,
    volume: f32,
    volume_random: f32,
    pitch: f32,
    pitch_random: f32,
    looping: bool,
    priority: i32,
    spatial: bool,
    min_distance: f32,
    max_distance: f32,
    rolloff: i32, // 0 inverse, 1 linear
    rolloff_factor: f32,
    doppler: f32,
    max_instances: i32,
    lowpass_hz: f32,
    param_first: u32,
    param_n: u32,
}

struct Bus {
    name_p: u64,
    name_n: usize,
    parent: i32,
    target: f32,
    muted: bool,
    current: f32,
    buffer: u64, // BLOCK * 2 f32
}

struct Voice {
    playing: bool,
    generation: u32,
    event_id: i32,
    sample_id: i32,
    bus: i32,
    cursor: f64,
    base_pitch: f32,
    base_volume: f32,
    user_volume: f32,
    user_pitch: f32,
    looping: bool,
    spatial: bool,
    px: f32, py: f32, pz: f32,
    vx: f32, vy: f32, vz: f32,
    param_values: [f32; 8],
    fade: f32,
    fade_delta: f32,
    stopping: bool,
    gain_l: f32,
    gain_r: f32,
    primed: bool,
    lp_l: f32, lp_r: f32, lp2_l: f32, lp2_r: f32,
}

struct Shared {
    generation: u32,
    active: bool,
    event_plus_one: u32,
    priority: u32,
    sequence: u64,
}

struct Cmd {
    kind: u32,
    slot: u32,
    generation: u32,
    a: i32,
    b: i32,
    bus_override: i32,
    f0: f32, f1: f32,
    px: f32, py: f32, pz: f32,
    vx: f32, vy: f32, vz: f32,
    fx: f32, fy: f32, fz: f32, // listener only: forward
    ux: f32, uy: f32, uz: f32, // listener only: up
    ptr: u64, // stream start: ring block
}

// One PCM streaming voice (audio thread owns it). Source: an audio.ring of S16LE frames.
struct Stream {
    active: bool,
    stopping: bool,
    primed: bool,
    generation: u32,
    blk: u64,
    channels: u32,
    src_rate: u32,
    bus: i32,
    volume: f32,
    pan: f32,
    fade: f32,
    fade_delta: f32,
    gain_l: f32,
    gain_r: f32,
    cursor: f64,
    fill: usize,
    buf: u64, // STREAM_CAP stereo f32 frames
    tmp: u64, // STREAM_CAP stereo s16 frames
}

struct Reclaim {
    slot: u32,
    generation: u32,
}

struct Stats {
    active_voices: u32,
    max_voices: u32,
    started: u64,
    stolen: u64,
    dropped: u64,
    commands_dropped: u64,
    peak_left: f32,
    peak_right: f32,
    peak_hold_left: f32, // highest block peak since the engine started (peak_left = the last block only)
    peak_hold_right: f32,
    stream_underruns: u64,
}

struct Engine {
    rate: u32,
    max_voices: u32,
    lock: u64, // address of one word (futex mutex)
    samples: u64, n_samples: usize,
    free_ids: u64, n_free_samples: usize,
    events: u64, n_events: usize,
    name_tab: u64, // NAME_TAB * i32, see engine_find_event
    buses: u64, n_buses: usize,
    bus_order: u64, // i32 per bus, deepest first
    params: u64, n_params: usize,
    curve_x: u64, curve_y: u64, n_curve: usize,
    sample_ids: u64, n_sample_ids: usize,
    slot_vol: u64, slot_pit: u64, // f32 per sample id slot (parallel to sample_ids): per-entry volume / pitch factor (default 1.0)
    voices: u64, shared: u64,
    free_list: u64, n_free: usize,
    cmds: u64, cmd_head: usize, cmd_tail: usize,
    reclaims: u64, rc_head: usize, rc_tail: usize,
    sequence: u64,
    rng: u32,
    lx: f32, ly: f32, lz: f32,
    fx: f32, fy: f32, fz: f32,
    ux: f32, uy: f32, uz: f32,
    lvx: f32, lvy: f32, lvz: f32,
    started: u64, stolen: u64, dropped: u64, cmd_dropped: u64,
    active: u32,
    lim_gain: f32,
    peak_l: f32, peak_r: f32,
    peak_hold_l: f32, peak_hold_r: f32,
    scratch: u64, // 4096 stereo f32 for pump
    pcm_out: u64, // 4096 stereo s16 for pump
    lockfree: bool, // true = no mutex (one control thread + one audio thread), see engine_set_lockfree
    streams: u64, // MAX_STREAMS * Stream
    stream_claim: u64, // u64 per slot: last generation handed out (control thread)
    stream_done: u64, // u64 per slot: generation that ended (audio thread)
    underruns: usize,
    audio: u64, // control block of the audio thread (0 = none)
    audio_handle: u64,
}

// ----------------------------------------------------------------- memory helpers

fn at[T](base: u64, i: usize) -> *mut T {
    return (base + (bytes_of[T](i)) as u64) as *mut T
}

fn bytes_of[T](n: usize) -> usize {
    return n * size_of[T]()
}

fn alloc_zero[T](n: usize) -> u64 {
    let p: u64 = rt.heap_alloc(bytes_of[T](n))
    if p != 0 {
        rt.mem_set(p, 0 as u8, bytes_of[T](n))
    }
    return p
}

fn ldf(p: u64, i: usize) -> f32 {
    return *((p + (i * 4) as u64) as *mut f32)
}

fn stf(p: u64, i: usize, v: f32) {
    *((p + (i * 4) as u64) as *mut f32) = v
}

fn copy_name(p: u64, n: usize) -> u64 {
    let q: u64 = rt.heap_alloc(n + 1)
    if q != 0 {
        rt.mem_copy(q, p, n)
    }
    return q
}

fn name_eq(ap: u64, an: usize, bp: u64, bn: usize) -> bool {
    if an != bn {
        return false
    }
    var i: usize = 0
    while i < an {
        if rt.ld8(ap, i) != rt.ld8(bp, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn clampf(v: f32, lo: f32, hi: f32) -> f32 {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

fn absf(v: f32) -> f32 {
    if v < 0.0 {
        return 0.0 - v
    }
    return v
}

fn lock(e: *mut Engine) {
    if (*e).lockfree {
        return
    }
    thread_lock((*e).lock as *mut u64)
}

fn unlock(e: *mut Engine) {
    if (*e).lockfree {
        return
    }
    thread_unlock((*e).lock as *mut u64)
}

// Atomic load = `lock xadd [p], 0` (a full barrier on x86-64, ldaxr/stlxr loop on aarch64): everything the
// other side wrote BEFORE it published this word is visible afterwards.
fn ld_acq(p: *mut usize) -> usize {
    return __atomic_add(p as *mut u64, 0 as u64) as usize
}

// Publish `v` into a word that only THIS thread writes (`old` = its current value). `lock cmpxchg` is a full barrier:
// all stores before it are visible to a thread that reads the new value with ld_acq.
fn st_rel(p: *mut usize, old: usize, v: usize) {
    __atomic_swap(p as *mut u64, old as u64, v as u64)
}

fn ld_acq64(p: u64) -> u64 {
    return __atomic_add(p as *mut u64, 0 as u64)
}

fn st_rel64(p: u64, v: u64) {
    __atomic_swap(p as *mut u64, ld_acq64(p), v)
}

// ------------------------------------------------------------------------ lifetime

// Aulos: aul_create (offline form; the device is an `audio.sink`, see engine_pump).
fn engine_new(rate: u32, max_voices: u32) -> Engine {
    var mv: u32 = max_voices
    if mv == 0 as u32 {
        mv = 64 as u32
    }
    if mv > 65534 as u32 {
        mv = 65534 as u32
    }
    var r: u32 = rate
    if r == 0 as u32 {
        r = 48000 as u32
    }
    var e: Engine = Engine {
        rate: r, max_voices: mv, lock: alloc_zero[u64](1),
        samples: alloc_zero[Sample](MAX_SAMPLES), n_samples: 0, free_ids: alloc_zero[i32](MAX_SAMPLES), n_free_samples: 0,
        events: alloc_zero[EventDef](MAX_EVENTS), n_events: 0,
        name_tab: alloc_zero[i32](NAME_TAB),
        buses: alloc_zero[Bus](MAX_BUSES), n_buses: 0,
        bus_order: alloc_zero[i32](MAX_BUSES),
        params: alloc_zero[ParamMap](MAX_POOL), n_params: 0,
        curve_x: alloc_zero[f32](MAX_POOL), curve_y: alloc_zero[f32](MAX_POOL), n_curve: 0,
        sample_ids: alloc_zero[i32](MAX_POOL), n_sample_ids: 0,
        slot_vol: alloc_zero[f32](MAX_POOL), slot_pit: alloc_zero[f32](MAX_POOL),
        voices: alloc_zero[Voice](mv as usize), shared: alloc_zero[Shared](mv as usize),
        free_list: alloc_zero[u32](mv as usize), n_free: 0,
        cmds: alloc_zero[Cmd](CMD_CAP), cmd_head: 0, cmd_tail: 0,
        reclaims: alloc_zero[Reclaim](CMD_CAP), rc_head: 0, rc_tail: 0,
        sequence: 1, rng: 19088743 as u32,
        lx: 0.0, ly: 0.0, lz: 0.0, fx: 0.0, fy: 0.0, fz: 0.0 - 1.0, ux: 0.0, uy: 1.0, uz: 0.0,
        lvx: 0.0, lvy: 0.0, lvz: 0.0,
        started: 0, stolen: 0, dropped: 0, cmd_dropped: 0, active: 0 as u32,
        lim_gain: 1.0, peak_l: 0.0, peak_r: 0.0, peak_hold_l: 0.0, peak_hold_r: 0.0,
        scratch: rt.heap_alloc(4096 * 2 * 4), pcm_out: rt.heap_alloc(4096 * 2 * 2),
        lockfree: false, streams: alloc_zero[Stream](MAX_STREAMS),
        stream_claim: alloc_zero[u64](MAX_STREAMS), stream_done: alloc_zero[u64](MAX_STREAMS),
        underruns: 0, audio: 0, audio_handle: 0,
    }
    var si: usize = 0
    while si < MAX_STREAMS {
        let st: *mut Stream = at[Stream](e.streams, si)
        (*st).buf = alloc_zero[f32](STREAM_CAP * 2)
        (*st).tmp = alloc_zero[i16](STREAM_CAP * 2)
        si = si + 1
    }
    // slot 0 is handed out first, like Aulos' free list (filled back to front)
    var i: u32 = 0 as u32
    while i < mv {
        stu32(e.free_list, i as usize, mv - 1 as u32 - i)
        i = i + 1 as u32
    }
    e.n_free = mv as usize
    var k: usize = 0
    while k < mv as usize {
        (*at[Shared](e.shared, k)).generation = 1 as u32
        k = k + 1
    }
    engine_ensure_bus(&e, "master", "")
    return e
}

fn stu32(p: u64, i: usize, v: u32) {
    *((p + (i * 4) as u64) as *mut u32) = v
}

fn ldu32(p: u64, i: usize) -> u32 {
    return *((p + (i * 4) as u64) as *mut u32)
}

fn engine_free(e: *mut Engine) {
    var i: usize = 0
    while i < (*e).n_samples {
        let s: *mut Sample = at[Sample]((*e).samples, i)
        if (*s).data != 0 {
            rt.heap_free((*s).data, ((*s).frames * (*s).channels as u64 * 4) as usize)
        }
        i = i + 1
    }
    i = 0
    while i < (*e).n_buses {
        let b: *mut Bus = at[Bus]((*e).buses, i)
        rt.heap_free((*b).buffer, BLOCK * 2 * 4)
        rt.heap_free((*b).name_p, (*b).name_n + 1)
        i = i + 1
    }
    i = 0
    while i < (*e).n_events {
        let ev: *mut EventDef = at[EventDef]((*e).events, i)
        rt.heap_free((*ev).name_p, (*ev).name_n + 1)
        i = i + 1
    }
    i = 0
    while i < (*e).n_params {
        free_param_name(e, i)
        i = i + 1
    }
    let mv: usize = (*e).max_voices as usize
    rt.heap_free((*e).lock, 8)
    rt.heap_free((*e).samples, bytes_of[Sample](MAX_SAMPLES))
    rt.heap_free((*e).free_ids, bytes_of[i32](MAX_SAMPLES))
    rt.heap_free((*e).events, bytes_of[EventDef](MAX_EVENTS))
    rt.heap_free((*e).name_tab, NAME_TAB * 4)
    rt.heap_free((*e).buses, bytes_of[Bus](MAX_BUSES))
    rt.heap_free((*e).bus_order, MAX_BUSES * 4)
    rt.heap_free((*e).params, bytes_of[ParamMap](MAX_POOL))
    rt.heap_free((*e).curve_x, MAX_POOL * 4)
    rt.heap_free((*e).curve_y, MAX_POOL * 4)
    rt.heap_free((*e).sample_ids, MAX_POOL * 4)
    rt.heap_free((*e).slot_vol, MAX_POOL * 4)
    rt.heap_free((*e).slot_pit, MAX_POOL * 4)
    rt.heap_free((*e).voices, bytes_of[Voice](mv))
    rt.heap_free((*e).shared, bytes_of[Shared](mv))
    rt.heap_free((*e).free_list, mv * 4)
    rt.heap_free((*e).cmds, bytes_of[Cmd](CMD_CAP))
    rt.heap_free((*e).reclaims, bytes_of[Reclaim](CMD_CAP))
    rt.heap_free((*e).scratch, 4096 * 2 * 4)
    rt.heap_free((*e).pcm_out, 4096 * 2 * 2)
    var sf: usize = 0
    while sf < MAX_STREAMS {
        let st: *mut Stream = at[Stream]((*e).streams, sf)
        rt.heap_free((*st).buf, STREAM_CAP * 2 * 4)
        rt.heap_free((*st).tmp, STREAM_CAP * 2 * 2)
        sf = sf + 1
    }
    rt.heap_free((*e).streams, bytes_of[Stream](MAX_STREAMS))
    rt.heap_free((*e).stream_claim, MAX_STREAMS * 8)
    rt.heap_free((*e).stream_done, MAX_STREAMS * 8)
    (*e).n_samples = 0
    (*e).n_free_samples = 0
    (*e).n_buses = 0
    (*e).n_events = 0
    (*e).n_params = 0
}

// ---------------------------------------------------------------------------- buses

// Id of a bus by name, or -1.
fn engine_bus_id(e: *mut Engine, name: str) -> i32 {
    var i: usize = 0
    while i < (*e).n_buses {
        let b: *mut Bus = at[Bus]((*e).buses, i)
        if name_eq((*b).name_p, (*b).name_n, name.p as u64, name.length()) {
            return i as i32
        }
        i = i + 1
    }
    return -1
}

fn find_or_create_bus(e: *mut Engine, name: str) -> i32 {
    let id: i32 = engine_bus_id(e, name)
    if id >= 0 {
        return id
    }
    if (*e).n_buses >= MAX_BUSES {
        return -1
    }
    let i: usize = (*e).n_buses
    let b: *mut Bus = at[Bus]((*e).buses, i)
    (*b).name_p = copy_name(name.p as u64, name.length())
    (*b).name_n = name.length()
    (*b).parent = -1
    (*b).target = 1.0
    (*b).muted = false
    (*b).current = 1.0
    (*b).buffer = alloc_zero[f32](BLOCK * 2)
    (*e).n_buses = i + 1
    return i as i32
}

fn bus_depth(e: *mut Engine, i: usize) -> i32 {
    var d: i32 = 0
    var p: i32 = (*at[Bus]((*e).buses, i)).parent
    var guard: usize = 0
    while p >= 0 && guard < (*e).n_buses {
        d = d + 1
        guard = guard + 1
        p = (*at[Bus]((*e).buses, p as usize)).parent
    }
    return d
}

// deepest first, stable (Aulos: std::sort over a handful of buses = insertion sort)
fn rebuild_bus_order(e: *mut Engine) {
    let n: usize = (*e).n_buses
    var i: usize = 0
    while i < n {
        *at[i32]((*e).bus_order, i) = i as i32
        i = i + 1
    }
    i = 1
    while i < n {
        let key: i32 = *at[i32]((*e).bus_order, i)
        let kd: i32 = bus_depth(e, key as usize)
        var j: usize = i
        while j > 0 && bus_depth(e, (*at[i32]((*e).bus_order, j - 1)) as usize) < kd {
            *at[i32]((*e).bus_order, j) = *at[i32]((*e).bus_order, j - 1)
            j = j - 1
        }
        *at[i32]((*e).bus_order, j) = key
        i = i + 1
    }
}

// Aulos: aul_ensure_bus. `parent` may be "" (no parent), applied only to a new bus. 1 = exists afterwards.
fn engine_ensure_bus(e: *mut Engine, name: str, parent: str) -> bool {
    if name.length() == 0 {
        return false
    }
    lock(e)
    let id: i32 = find_or_create_bus(e, name)
    if id < 0 {
        unlock(e)
        return false
    }
    let b: *mut Bus = at[Bus]((*e).buses, id as usize)
    if parent.length() > 0 && (*b).parent < 0 && !name_eq(name.p as u64, name.length(), parent.p as u64, parent.length()) {
        (*b).parent = find_or_create_bus(e, parent)
    }
    rebuild_bus_order(e)
    unlock(e)
    return true
}

fn engine_set_bus_volume(e: *mut Engine, name: str, volume: f32) {
    let id: i32 = engine_bus_id(e, name)
    if id < 0 {
        return
    }
    var v: f32 = volume
    if v < 0.0 {
        v = 0.0
    }
    (*at[Bus]((*e).buses, id as usize)).target = v
}

fn engine_get_bus_volume(e: *mut Engine, name: str) -> f32 {
    let id: i32 = engine_bus_id(e, name)
    if id < 0 {
        return 0.0
    }
    return (*at[Bus]((*e).buses, id as usize)).target
}

fn engine_set_bus_mute(e: *mut Engine, name: str, muted: bool) {
    let id: i32 = engine_bus_id(e, name)
    if id < 0 {
        return
    }
    (*at[Bus]((*e).buses, id as usize)).muted = muted
}

fn engine_get_bus_mute(e: *mut Engine, name: str) -> bool {
    let id: i32 = engine_bus_id(e, name)
    if id < 0 {
        return false
    }
    return (*at[Bus]((*e).buses, id as usize)).muted
}

// What the mixer applies right now: 0 while muted, else the (smoothed) volume.
fn engine_bus_effective_volume(e: *mut Engine, name: str) -> f32 {
    let id: i32 = engine_bus_id(e, name)
    if id < 0 {
        return 0.0
    }
    let b: *mut Bus = at[Bus]((*e).buses, id as usize)
    if (*b).muted {
        return 0.0
    }
    return (*b).current
}

// -------------------------------------------------------------------------- samples

// Copies `frames` frames (interleaved f32, 1 or 2 channels) into the engine. Id or -1.
fn engine_add_sample(e: *mut Engine, data: u64, frames: u64, channels: u32) -> i32 {
    if ((*e).n_samples >= MAX_SAMPLES && (*e).n_free_samples == 0) || frames == 0 || channels == 0 as u32 {
        return -1
    }
    let n: usize = (frames * channels as u64 * 4) as usize
    let p: u64 = rt.heap_alloc(n)
    if p == 0 {
        return -1
    }
    rt.mem_copy(p, data, n)
    var i: usize = (*e).n_samples
    if (*e).n_free_samples > 0 {
        (*e).n_free_samples = (*e).n_free_samples - 1
        let fid: i32 = *at[i32]((*e).free_ids, (*e).n_free_samples)
        i = fid as usize
    } else {
        (*e).n_samples = i + 1
    }
    let s: *mut Sample = at[Sample]((*e).samples, i)
    (*s).channels = channels
    (*s).frames = frames
    (*s).data = p
    return i as i32
}

fn engine_sample_room(e: *mut Engine) -> usize {
    return MAX_SAMPLES - (*e).n_samples + (*e).n_free_samples
}

fn engine_sample_free_slots(e: *mut Engine) -> usize {
    return (*e).n_free_samples
}

fn engine_sample_in_use(e: *mut Engine, id: i32) -> bool {
    var i: u32 = 0 as u32
    while i < (*e).max_voices {
        let v: *mut Voice = at[Voice]((*e).voices, i as usize)
        if (*v).playing && (*v).sample_id == id {
            return true
        }
        i = i + 1 as u32
    }
    return false
}

fn engine_sample_retarget(e: *mut Engine, from: i32, to: i32) -> usize {
    var k: usize = 0
    var i: usize = 0
    while i < (*e).n_sample_ids {
        let q: *mut i32 = at[i32]((*e).sample_ids, i)
        if *q == from {
            *q = to
            k = k + 1
        }
        i = i + 1
    }
    return k
}

fn engine_sample_release(e: *mut Engine, id: i32) -> bool {
    if id < 0 || id as usize >= (*e).n_samples || (*e).n_free_samples >= MAX_SAMPLES {
        return false
    }
    let s: *mut Sample = at[Sample]((*e).samples, id as usize)
    if (*s).data == 0 || engine_sample_in_use(e, id) {
        return false
    }
    let d: u64 = (*s).data
    let n: usize = ((*s).frames * (*s).channels as u64 * 4) as usize
    (*s).frames = 0 as u64
    (*s).data = 0
    rt.heap_free(d, n)
    *at[i32]((*e).free_ids, (*e).n_free_samples) = id
    (*e).n_free_samples = (*e).n_free_samples + 1
    return true
}

fn engine_sample_frames(e: *mut Engine, id: i32) -> u64 {
    if id < 0 || id as usize >= (*e).n_samples {
        return 0
    }
    return (*at[Sample]((*e).samples, id as usize)).frames
}

fn engine_sample_count(e: *mut Engine) -> usize {
    return (*e).n_samples
}

fn engine_event_count(e: *mut Engine) -> usize {
    return (*e).n_events
}

// Hot reload without a leak: the LAST sample (just added) takes over slot `old`; the old PCM is freed and the table shrinks by one,
// so every event that points at `old` plays the new data. Refused (false) while the audio thread runs (it may read the old PCM),
// when `old` is the last slot itself or out of range. The caller then keeps the new sample as an extra id.
fn engine_sample_adopt_last(e: *mut Engine, old: i32) -> bool {
    if old < 0 || (old as usize) + 1 >= (*e).n_samples || (*e).n_samples == 0 || (*e).n_free_samples > 0 {
        return false
    }
    if engine_audio_running(e) {
        return false
    }
    let last: usize = (*e).n_samples - 1
    let dst: *mut Sample = at[Sample]((*e).samples, old as usize)
    let src: *mut Sample = at[Sample]((*e).samples, last)
    if (*dst).data != 0 {
        rt.heap_free((*dst).data, ((*dst).frames * (*dst).channels as u64 * 4) as usize)
    }
    *dst = *src
    (*src).data = 0
    (*src).frames = 0
    (*e).n_samples = last
    return true
}

// Linear sample rate conversion into a fresh buffer (E3). Returns the new frame count; `out` gets the buffer.
fn resample_linear(src: u64, frames: u64, channels: u32, from: u32, to: u32, out: *mut u64) -> u64 {
    let nf: u64 = frames * to as u64 / from as u64
    let ch: usize = channels as usize
    let buf: u64 = rt.heap_alloc((nf * channels as u64 * 4) as usize)
    var i: u64 = 0
    while i < nf {
        let pos: f64 = (i as f64) * (from as f64) / (to as f64)
        var i0: u64 = pos as u64
        if i0 >= frames {
            i0 = frames - 1
        }
        var i1: u64 = i0 + 1
        if i1 >= frames {
            i1 = i0
        }
        let fr: f32 = (pos - (i0 as f64)) as f32
        var c: usize = 0
        while c < ch {
            let a: f32 = ldf(src, i0 as usize * ch + c)
            let b: f32 = ldf(src, i1 as usize * ch + c)
            stf(buf, i as usize * ch + c, a + (b - a) * fr)
            c = c + 1
        }
        i = i + 1
    }
    *out = buf
    return nf
}

// Adds PCM decoded elsewhere, converting the rate if needed.
fn add_decoded(e: *mut Engine, data: u64, frames: u64, channels: u32, rate: u32) -> i32 {
    if rate == (*e).rate || rate == 0 as u32 {
        return engine_add_sample(e, data, frames, channels)
    }
    var cv: u64 = 0
    let nf: u64 = resample_linear(data, frames, channels, rate, (*e).rate, &cv)
    if cv == 0 || nf == 0 {
        return -1
    }
    let id: i32 = engine_add_sample(e, cv, nf, channels)
    rt.heap_free(cv, (nf * channels as u64 * 4) as usize)
    return id
}

fn rd16(p: u64, o: usize) -> u32 {
    return (rt.ld8(p, o) as u32) | ((rt.ld8(p, o + 1) as u32) << 8)
}

fn rd32(p: u64, o: usize) -> u32 {
    return rd16(p, o) | (rd16(p, o + 2) << 16)
}

// RIFF/WAVE from memory: PCM 8/16/24/32 bit and IEEE float32, 1 or 2 channels (more: the first two).
// Same conversion as miniaudio: s16 -> f32 = s / 32768. Returns the sample id or -1.
fn engine_load_wav(e: *mut Engine, p: u64, n: usize) -> i32 {
    if n < 44 || rd32(p, 0) != 1179011410 as u32 || rd32(p, 8) != 1163280727 as u32 {
        return -1
    }
    var pos: usize = 12
    var fmt_tag: u32 = 0 as u32
    var ch: u32 = 0 as u32
    var rate: u32 = 0 as u32
    var bits: u32 = 0 as u32
    var data_at: usize = 0
    var data_n: usize = 0
    while pos + 8 <= n {
        let id: u32 = rd32(p, pos)
        var sz: usize = rd32(p, pos + 4) as usize
        if id == 544501094 as u32 { // "fmt "
            fmt_tag = rd16(p, pos + 8)
            ch = rd16(p, pos + 10)
            rate = rd32(p, pos + 12)
            bits = rd16(p, pos + 22)
            if fmt_tag == 65534 as u32 && sz >= 26 {
                fmt_tag = rd16(p, pos + 32) // WAVE_FORMAT_EXTENSIBLE: sub format
            }
        } else if id == 1635017060 as u32 { // "data"
            data_at = pos + 8
            if data_at + sz > n {
                sz = n - data_at
            }
            data_n = sz
            break
        }
        pos = pos + 8 + sz + (sz & 1)
    }
    if data_at == 0 || ch == 0 as u32 || rate == 0 as u32 {
        return -1
    }
    let bps: usize = (bits / 8 as u32) as usize
    if bps == 0 || (fmt_tag != 1 as u32 && fmt_tag != 3 as u32) {
        return -1
    }
    let frames: usize = data_n / (bps * ch as usize)
    if frames == 0 {
        return -1
    }
    var oc: u32 = ch
    if oc > 2 as u32 {
        oc = 2 as u32
    }
    let buf: u64 = rt.heap_alloc(frames * oc as usize * 4)
    var f: usize = 0
    while f < frames {
        var c: usize = 0
        while c < oc as usize {
            let o: usize = data_at + (f * ch as usize + c) * bps
            var v: f32 = 0.0
            if fmt_tag == 3 as u32 && bps == 4 {
                v = std_math_f32(rd32(p, o))
            } else if bps == 1 {
                v = ((rt.ld8(p, o) as i32 - 128) as f32) / 128.0
            } else if bps == 2 {
                var s: i32 = rd16(p, o) as i32
                if s >= 32768 {
                    s = s - 65536
                }
                v = (s as f32) / 32768.0
            } else if bps == 3 {
                var s: i32 = (rd16(p, o) | ((rt.ld8(p, o + 2) as u32) << 16)) as i32
                if s >= 8388608 {
                    s = s - 16777216
                }
                v = (s as f32) / 8388608.0
            } else if bps == 4 {
                let u: u32 = rd32(p, o)
                var s: i64 = u as i64
                if s >= 2147483648 {
                    s = s - 4294967296
                }
                v = (s as f32) / 2147483648.0
            }
            stf(buf, f * oc as usize + c, v)
            c = c + 1
        }
        f = f + 1
    }
    let id: i32 = add_decoded(e, buf, frames as u64, oc, rate)
    rt.heap_free(buf, frames * oc as usize * 4)
    return id
}

fn std_math_f32(bits: u32) -> f32 {
    return math.math_f32(bits)
}

// Position of "Xing"/"Info" in a frame (offset from the frame start), or 0.
fn xing_tag_at(f: u64) -> usize {
    let h1: u32 = rt.ld8(f, 1) as u32
    let h3: u32 = rt.ld8(f, 3) as u32
    let mpeg1: bool = ((h1 >> 3) & 3 as u32) == 3 as u32
    let mono: bool = ((h3 >> 6) & 3 as u32) == 3 as u32
    var side: usize = 32
    if mpeg1 && mono {
        side = 17
    } else if !mpeg1 && mono {
        side = 9
    } else if !mpeg1 {
        side = 17
    }
    var at: usize = 4 + side
    if (h1 & 1 as u32) == 0 as u32 {
        at = at + 2 // CRC
    }
    let t: u32 = rd32(f, at)
    if t == 1735289176 as u32 || t == 1868983881 as u32 { // "Xing" / "Info"
        return at
    }
    return 0
}

// LAME extension of the tag: encoder delay (true) or end padding (false) in frames. 0 if there is none.
fn lame_delay(f: u64, tag_at: usize, frame_bytes: usize, want_delay: bool) -> usize {
    var o: usize = tag_at + 4
    let flags: u32 = rd32(f, o) >> 24 // big endian flags: the last octet
    o = o + 4
    if (flags & 1 as u32) != 0 as u32 { o = o + 4 }
    if (flags & 2 as u32) != 0 as u32 { o = o + 4 }
    if (flags & 4 as u32) != 0 as u32 { o = o + 100 }
    if (flags & 8 as u32) != 0 as u32 { o = o + 4 }
    if o + 24 > frame_bytes {
        return 0
    }
    if rt.ld8(f, o) != 76 as u8 { // "LAME" / "Lavc" (ffmpeg's libmp3lame): the 9 octet encoder string
        return 0
    }
    let b0: u32 = rt.ld8(f, o + 21) as u32
    let b1: u32 = rt.ld8(f, o + 22) as u32
    let b2: u32 = rt.ld8(f, o + 23) as u32
    if want_delay {
        return ((b0 << 4) | (b1 >> 4)) as usize
    }
    return (((b1 & 15 as u32) << 8) | b2) as usize
}

// MP3 from memory (lib/ton/mp3.fi), whole file -> one memory sample. s16 -> f32 = s / 32768.
fn engine_load_mp3(e: *mut Engine, p: u64, n: usize) -> i32 {
    let tabs: mp3_tab.Tabs = mp3_tab.tabs_new()
    var t: mp3_tab.Tabs = tabs
    var dec: mp3.Mp3Dec = mp3.mp3_new()
    var scr: mp3.Mp3Scratch = mp3.mp3_scratch_new()
    var info: mp3.Mp3Info = mp3.Mp3Info { frame_bytes: 0, frame_offset: 0, channels: 0, hz: 0, layer: 0, bitrate_kbps: 0 }
    let pcm: u64 = rt.heap_alloc(2304 * 2)
    var cap: usize = 1 << 16 // frames * channels (f32 count)
    var buf: u64 = rt.heap_alloc(cap * 4)
    var used: usize = 0
    var chans: i32 = 0
    var hz: i32 = 0
    var pos: usize = 0
    var delay: usize = 0 // gapless: LAME encoder delay / end padding in frames (from the Xing/Info tag)
    var padding: usize = 0
    var first: bool = true
    while pos < n {
        let got: i32 = mp3.mp3_decode_frame(&t, &dec, &scr, p + pos as u64, (n - pos) as i32, pcm, &info)
        if info.frame_bytes == 0 {
            break
        }
        let frame_at: u64 = p + (pos + info.frame_offset as usize) as u64
        let frame_bytes: usize = info.frame_bytes as usize
        pos = pos + info.frame_bytes as usize
        if got > 0 {
            if chans == 0 {
                chans = info.channels
                hz = info.hz
            }
            if info.channels != chans {
                continue
            }
            if first {
                first = false
                // a Xing/Info frame is metadata, not sound (dr_mp3 / miniaudio drop it too)
                let tag_at: usize = xing_tag_at(frame_at)
                if tag_at != 0 {
                    delay = lame_delay(frame_at, tag_at, frame_bytes, true)
                    padding = lame_delay(frame_at, tag_at, frame_bytes, false)
                    continue
                }
            }
            let cnt: usize = got as usize * chans as usize
            if used + cnt > cap {
                var ncap: usize = cap * 2
                while used + cnt > ncap {
                    ncap = ncap * 2
                }
                let nb: u64 = rt.heap_alloc(ncap * 4)
                rt.mem_copy(nb, buf, used * 4)
                rt.heap_free(buf, cap * 4)
                buf = nb
                cap = ncap
            }
            var i: usize = 0
            while i < cnt {
                var s: i32 = rd16(pcm, i * 2) as i32
                if s >= 32768 {
                    s = s - 65536
                }
                stf(buf, used + i, (s as f32) / 32768.0)
                i = i + 1
            }
            used = used + cnt
        }
    }
    rt.heap_free(pcm, 2304 * 2)
    var id: i32 = -1
    if chans > 0 && used > 0 {
        let all: usize = used / chans as usize
        // LAME gapless: skip encoder delay + the 529 frame decoder delay, trim padding - 529 at the end
        var from: usize = 0
        var upto: usize = all
        if delay > 0 || padding > 0 {
            from = delay + 529
            if padding > 529 && padding - 529 < all {
                upto = all - (padding - 529)
            }
        }
        if from >= upto {
            from = 0
            upto = all
        }
        id = add_decoded(e, buf + (from * chans as usize * 4) as u64, (upto - from) as u64, chans as u32, hz as u32)
    }
    rt.heap_free(buf, cap * 4)
    return id
}

// --------------------------------------------------------------------------- events

// New event, defaults as in a bank without fields. Returns the id or -1. Add its samples and
// parameters BEFORE adding the next event (they share contiguous pools).
fn engine_add_event(e: *mut Engine, name: str, bus: i32) -> i32 {
    if (*e).n_events >= MAX_EVENTS || bus < 0 || bus as usize >= (*e).n_buses {
        return -1
    }
    let i: usize = (*e).n_events
    let ev: *mut EventDef = at[EventDef]((*e).events, i)
    (*ev).name_p = copy_name(name.p as u64, name.length())
    (*ev).name_n = name.length()
    (*ev).sample_first = (*e).n_sample_ids as u32
    (*ev).sample_n = 0 as u32
    (*ev).bus = bus
    (*ev).volume = 1.0
    (*ev).volume_random = 0.0
    (*ev).pitch = 1.0
    (*ev).pitch_random = 0.0
    (*ev).looping = false
    (*ev).priority = 128
    (*ev).spatial = false
    (*ev).min_distance = 1.0
    (*ev).max_distance = 100.0
    (*ev).rolloff = 0
    (*ev).rolloff_factor = 1.0
    (*ev).doppler = 0.0
    (*ev).max_instances = 0
    (*ev).lowpass_hz = 22000.0
    (*ev).param_first = (*e).n_params as u32
    (*ev).param_n = 0 as u32
    (*e).n_events = i + 1
    name_index_add(e, i)
    return i as i32
}

// Direct access to the fields (volume, pitch, loop, spatial, distances, ...).
fn engine_event(e: *mut Engine, id: i32) -> *mut EventDef {
    if id < 0 || id as usize >= (*e).n_events {
        return 0 as *mut EventDef
    }
    return at[EventDef]((*e).events, id as usize)
}

// Name index: open addressing over NAME_TAB slots; the FIRST event of a name wins (same as a front-to-back scan).
fn name_slot(p: u64, n: usize) -> usize {
    return (hash.fnv1a64(p, n) % (NAME_TAB as u64)) as usize
}

fn name_index_add(e: *mut Engine, id: usize) {
    let ev: *mut EventDef = at[EventDef]((*e).events, id)
    var k: usize = name_slot((*ev).name_p, (*ev).name_n)
    var tries: usize = 0
    while tries < NAME_TAB {
        let cur: i32 = *at[i32]((*e).name_tab, k)
        if cur == 0 {
            *at[i32]((*e).name_tab, k) = (id as i32) + 1
            return
        }
        let o: *mut EventDef = at[EventDef]((*e).events, (cur - 1) as usize)
        if name_eq((*o).name_p, (*o).name_n, (*ev).name_p, (*ev).name_n) {
            return // an older event of this name already owns the key
        }
        k = (k + 1) % NAME_TAB
        tries = tries + 1
    }
}

fn name_index_rebuild(e: *mut Engine) {
    rt.mem_set((*e).name_tab, 0 as u8, NAME_TAB * 4)
    var i: usize = 0
    while i < (*e).n_events {
        name_index_add(e, i)
        i = i + 1
    }
}

fn engine_find_event(e: *mut Engine, name: str) -> i32 {
    var k: usize = name_slot(name.p as u64, name.length())
    var tries: usize = 0
    while tries < NAME_TAB {
        let cur: i32 = *at[i32]((*e).name_tab, k)
        if cur == 0 {
            return -1
        }
        let ev: *mut EventDef = at[EventDef]((*e).events, (cur - 1) as usize)
        if name_eq((*ev).name_p, (*ev).name_n, name.p as u64, name.length()) {
            return cur - 1
        }
        k = (k + 1) % NAME_TAB
        tries = tries + 1
    }
    return -1
}

// Only for the LAST event added (E4: at most 16 samples).
fn engine_event_add_sample(e: *mut Engine, ev: i32, sample: i32) -> bool {
    if ev < 0 || ev as usize + 1 != (*e).n_events || sample < 0 || sample as usize >= (*e).n_samples {
        return false
    }
    let d: *mut EventDef = at[EventDef]((*e).events, ev as usize)
    if (*d).sample_n >= 16 as u32 || (*e).n_sample_ids >= MAX_POOL {
        return false
    }
    *at[i32]((*e).sample_ids, (*e).n_sample_ids) = sample
    stf((*e).slot_vol, (*e).n_sample_ids, 1.0)
    stf((*e).slot_pit, (*e).n_sample_ids, 1.0)
    (*e).n_sample_ids = (*e).n_sample_ids + 1
    (*d).sample_n = (*d).sample_n + 1 as u32
    return true
}

fn engine_event_set_sample(e: *mut Engine, ev: i32, k: usize, sample: i32) -> bool {
    if ev < 0 || ev as usize >= (*e).n_events || sample < 0 || sample as usize >= (*e).n_samples {
        return false
    }
    let d: *mut EventDef = at[EventDef]((*e).events, ev as usize)
    if k >= (*d).sample_n as usize {
        return false
    }
    *at[i32]((*e).sample_ids, (*d).sample_first as usize + k) = sample
    return true
}

fn engine_event_slot_sample(e: *mut Engine, ev: i32, k: usize) -> i32 {
    if ev < 0 || ev as usize >= (*e).n_events {
        return -1
    }
    let d: *mut EventDef = at[EventDef]((*e).events, ev as usize)
    if k >= (*d).sample_n as usize {
        return -1
    }
    return *at[i32]((*e).sample_ids, (*d).sample_first as usize + k)
}

// Per-slot factors of the LAST event (slot k = k-th engine_event_add_sample call): a voice that picks this slot plays at
// event volume * vol and event pitch * pit (vanilla sounds.json: volume / pitch of one entry). Default 1.0 / 1.0.
fn engine_event_set_slot(e: *mut Engine, ev: i32, k: usize, vol: f32, pit: f32) -> bool {
    if ev < 0 || ev as usize + 1 != (*e).n_events {
        return false
    }
    let d: *mut EventDef = at[EventDef]((*e).events, ev as usize)
    if k >= (*d).sample_n as usize {
        return false
    }
    var v: f32 = vol
    var q: f32 = pit
    if v < 0.0 { v = 0.0 }
    if q < 0.01 { q = 0.01 }
    stf((*e).slot_vol, (*d).sample_first as usize + k, v)
    stf((*e).slot_pit, (*d).sample_first as usize + k, q)
    return true
}

fn engine_event_slot_volume(e: *mut Engine, ev: i32, k: usize) -> f32 {
    let d: *mut EventDef = engine_event(e, ev)
    if d as u64 == 0 || k >= (*d).sample_n as usize { return 0.0 }
    return ldf((*e).slot_vol, (*d).sample_first as usize + k)
}

fn engine_event_slot_pitch(e: *mut Engine, ev: i32, k: usize) -> f32 {
    let d: *mut EventDef = engine_event(e, ev)
    if d as u64 == 0 || k >= (*d).sample_n as usize { return 0.0 }
    return ldf((*e).slot_pit, (*d).sample_first as usize + k)
}

// Pool fill levels (tests: a hot reload must not make them grow).
fn engine_param_pool_used(e: *mut Engine) -> usize { return (*e).n_params }
fn engine_sample_id_pool_used(e: *mut Engine) -> usize { return (*e).n_sample_ids }

// Parameter with a piecewise linear curve (xs ascending). Only for the LAST event (E4: 8 params, 16 points).
fn engine_event_add_param(e: *mut Engine, ev: i32, name: str, target: u32, default_value: f32,
    n: usize, xs: u64, ys: u64) -> bool {
    if ev < 0 || ev as usize + 1 != (*e).n_events || n == 0 || n > 16 {
        return false
    }
    let d: *mut EventDef = at[EventDef]((*e).events, ev as usize)
    if (*d).param_n >= MAX_PARAMS as u32 || (*e).n_params >= MAX_POOL || (*e).n_curve + n > MAX_POOL {
        return false
    }
    let pm: *mut ParamMap = at[ParamMap]((*e).params, (*e).n_params)
    (*pm).name_p = copy_name(name.p as u64, name.length())
    (*pm).name_n = name.length()
    (*pm).target = target
    (*pm).default_value = default_value
    (*pm).curve_first = (*e).n_curve as u32
    (*pm).curve_n = n as u32
    var i: usize = 0
    while i < n {
        stf((*e).curve_x, (*e).n_curve + i, ldf(xs, i))
        stf((*e).curve_y, (*e).n_curve + i, ldf(ys, i))
        i = i + 1
    }
    (*e).n_curve = (*e).n_curve + n
    (*e).n_params = (*e).n_params + 1
    (*d).param_n = (*d).param_n + 1 as u32
    return true
}

fn evaluate_curve(e: *mut Engine, first: u32, n: u32, x: f32, fallback: f32) -> f32 {
    if n == 0 as u32 {
        return fallback
    }
    let f: usize = first as usize
    let last: usize = f + n as usize - 1
    if x <= ldf((*e).curve_x, f) {
        return ldf((*e).curve_y, f)
    }
    if x >= ldf((*e).curve_x, last) {
        return ldf((*e).curve_y, last)
    }
    var i: usize = f + 1
    while i <= last {
        if x <= ldf((*e).curve_x, i) {
            let x0: f32 = ldf((*e).curve_x, i - 1)
            let y0: f32 = ldf((*e).curve_y, i - 1)
            let x1: f32 = ldf((*e).curve_x, i)
            let y1: f32 = ldf((*e).curve_y, i)
            let span: f32 = x1 - x0
            if span <= 0.000000001 {
                return y1
            }
            let t: f32 = (x - x0) / span
            return y0 + (y1 - y0) * t
        }
        i = i + 1
    }
    return ldf((*e).curve_y, last)
}

// ------------------------------------------------------------------------- commands

// Control thread = producer of the command ring, audio thread = consumer. The slot is written first, the head is
// published with a full barrier afterwards (st_rel), the consumer reads the head with ld_acq. Single producer, single
// consumer: no CAS retry loop is needed, st_rel only uses cmpxchg as a "store + full barrier".
fn push_cmd(e: *mut Engine, c: Cmd) -> bool {
    let head: usize = (*e).cmd_head
    let next: usize = (head + 1) % CMD_CAP
    if next == ld_acq(&(*e).cmd_tail) {
        (*e).cmd_dropped = (*e).cmd_dropped + 1
        return false
    }
    *at[Cmd]((*e).cmds, head) = c
    st_rel(&(*e).cmd_head, head, next)
    return true
}

fn new_cmd(kind: u32) -> Cmd {
    return Cmd { kind: kind, slot: 0 as u32, generation: 0 as u32, a: 0, b: 0, bus_override: -1,
        f0: 0.0, f1: 0.0, px: 0.0, py: 0.0, pz: 0.0, vx: 0.0, vy: 0.0, vz: 0.0,
        fx: 0.0, fy: 0.0, fz: 0.0, ux: 0.0, uy: 0.0, uz: 0.0, ptr: 0 }
}

// Audio thread = producer of the reclaim ring, control thread (engine_update) = consumer.
fn push_reclaim(e: *mut Engine, slot: u32, generation: u32) {
    let head: usize = (*e).rc_head
    let next: usize = (head + 1) % CMD_CAP
    if next == ld_acq(&(*e).rc_tail) {
        return
    }
    let r: *mut Reclaim = at[Reclaim]((*e).reclaims, head)
    (*r).slot = slot
    (*r).generation = generation
    st_rel(&(*e).rc_head, head, next)
}

// A handle is (slot + 1) | generation << 16; stale handles are no-ops. Returns the slot or -1.
fn decode_handle(e: *mut Engine, h: u32, gen_out: *mut u32) -> i64 {
    if h == 0 as u32 {
        return -1
    }
    let slot: u32 = (h & 65535 as u32) - 1 as u32
    let g: u32 = h >> 16
    if slot >= (*e).max_voices {
        return -1
    }
    if (*at[Shared]((*e).shared, slot as usize)).generation != g {
        return -1
    }
    *gen_out = g
    return slot as i64
}

fn next_random(e: *mut Engine) -> u32 {
    var x: u32 = (*e).rng
    x = x ^ (x << 13)
    x = x ^ (x >> 17)
    x = x ^ (x << 5)
    (*e).rng = x
    return x
}

fn random_bipolar(e: *mut Engine) -> f32 {
    return (((next_random(e) >> 8) as f32) / 8388608.0) - 1.0
}

// ----------------------------------------------------------------------- game thread

fn acquire_slot(e: *mut Engine, priority: i32, out: *mut u32) -> bool {
    if (*e).n_free > 0 {
        (*e).n_free = (*e).n_free - 1
        *out = ldu32((*e).free_list, (*e).n_free)
        return true
    }
    var best: i64 = -1
    var best_pri: u32 = 0 as u32
    var best_seq: u64 = 0
    var i: usize = 0
    while i < (*e).max_voices as usize {
        let s: *mut Shared = at[Shared]((*e).shared, i)
        if !(*s).active {
            best = i as i64
            best_pri = 0 as u32
            best_seq = 0
            break
        }
        if best < 0 || (*s).priority < best_pri || ((*s).priority == best_pri && (*s).sequence < best_seq) {
            best = i as i64
            best_pri = (*s).priority
            best_seq = (*s).sequence
        }
        i = i + 1
    }
    if best < 0 {
        return false
    }
    if best_pri as i64 > priority as i64 {
        return false
    }
    (*e).stolen = (*e).stolen + 1
    *out = best as u32
    return true
}

fn enforce_instance_limit(e: *mut Engine, event_id: i32, limit: i32) {
    if limit <= 0 {
        return
    }
    while true {
        var count: i32 = 0
        var oldest: i64 = -1
        var oldest_seq: u64 = 0
        var i: usize = 0
        while i < (*e).max_voices as usize {
            let s: *mut Shared = at[Shared]((*e).shared, i)
            if (*s).active && (*s).event_plus_one as i64 == event_id as i64 + 1 {
                count = count + 1
                if oldest < 0 || (*s).sequence < oldest_seq {
                    oldest = i as i64
                    oldest_seq = (*s).sequence
                }
            }
            i = i + 1
        }
        if count < limit || oldest < 0 {
            return
        }
        var c: Cmd = new_cmd(CMD_STOP)
        c.slot = oldest as u32
        c.generation = (*at[Shared]((*e).shared, oldest as usize)).generation
        push_cmd(e, c)
        let s: *mut Shared = at[Shared]((*e).shared, oldest as usize)
        (*s).active = false
        (*s).event_plus_one = 0 as u32
        (*s).priority = 0 as u32
        stu32((*e).free_list, (*e).n_free, oldest as u32)
        (*e).n_free = (*e).n_free + 1
    }
}

// Aulos: aul_play / aul_play_3d / aul_play_on_bus / aul_play_3d_on_bus. bus < 0 = the event's own bus.
// Returns a handle, 0 = nothing started.
fn start_event(e: *mut Engine, event_id: i32, bus: i32, spatial: bool, x: f32, y: f32, z: f32) -> u32 {
    if event_id < 0 || event_id as usize >= (*e).n_events {
        return 0 as u32
    }
    lock(e)
    let def: *mut EventDef = at[EventDef]((*e).events, event_id as usize)
    var bus_override: i32 = -1
    if bus >= 0 && (bus as usize) < (*e).n_buses {
        bus_override = bus
    }
    enforce_instance_limit(e, event_id, (*def).max_instances)
    var slot: u32 = 0 as u32
    if !acquire_slot(e, (*def).priority, &slot) {
        (*e).dropped = (*e).dropped + 1
        unlock(e)
        return 0 as u32
    }
    let sh: *mut Shared = at[Shared]((*e).shared, slot as usize)
    var generation: u32 = ((*sh).generation + 1 as u32) & 65535 as u32
    if generation == 0 as u32 {
        generation = 1 as u32
    }
    let pick: u32 = next_random(e) % (*def).sample_n
    let slot_ix: usize = (*def).sample_first as usize + pick as usize
    let sample_id: i32 = *at[i32]((*e).sample_ids, slot_ix)
    var volume: f32 = (*def).volume * (1.0 + (*def).volume_random * random_bipolar(e)) * ldf((*e).slot_vol, slot_ix)
    var pitch: f32 = (*def).pitch * (1.0 + (*def).pitch_random * random_bipolar(e)) * ldf((*e).slot_pit, slot_ix)
    if volume < 0.0 {
        volume = 0.0
    }
    if pitch < 0.01 {
        pitch = 0.01
    }
    let seq: u64 = (*e).sequence
    (*e).sequence = seq + 1
    (*sh).generation = generation
    (*sh).event_plus_one = event_id as u32 + 1 as u32
    var pri: i32 = (*def).priority
    if pri < 0 {
        pri = 0
    }
    (*sh).priority = pri as u32
    (*sh).sequence = seq
    (*sh).active = true
    var c: Cmd = new_cmd(CMD_START)
    c.slot = slot
    c.generation = generation
    c.a = event_id
    c.b = sample_id
    c.bus_override = bus_override
    c.f0 = volume
    c.f1 = pitch
    if spatial || (*def).spatial {
        c.px = x
        c.py = y
        c.pz = z
    }
    if !push_cmd(e, c) {
        (*sh).active = false
        (*sh).event_plus_one = 0 as u32
        stu32((*e).free_list, (*e).n_free, slot)
        (*e).n_free = (*e).n_free + 1
        unlock(e)
        return 0 as u32
    }
    (*e).started = (*e).started + 1
    unlock(e)
    return (slot + 1 as u32) | (generation << 16)
}

fn engine_play(e: *mut Engine, event_id: i32, bus: i32) -> u32 {
    return start_event(e, event_id, bus, false, 0.0, 0.0, 0.0)
}

fn engine_play_3d(e: *mut Engine, event_id: i32, bus: i32, x: f32, y: f32, z: f32) -> u32 {
    return start_event(e, event_id, bus, true, x, y, z)
}

fn engine_stop(e: *mut Engine, h: u32, fade_seconds: f32) {
    var g: u32 = 0 as u32
    lock(e)
    let slot: i64 = decode_handle(e, h, &g)
    if slot >= 0 {
        var c: Cmd = new_cmd(CMD_STOP)
        c.slot = slot as u32
        c.generation = g
        if fade_seconds > 0.0 {
            c.f0 = fade_seconds
        }
        push_cmd(e, c)
    }
    unlock(e)
}

fn engine_stop_all(e: *mut Engine, fade_seconds: f32) {
    lock(e)
    var c: Cmd = new_cmd(CMD_STOP_ALL)
    if fade_seconds > 0.0 {
        c.f0 = fade_seconds
    }
    push_cmd(e, c)
    unlock(e)
}

// Stays true after a one-shot ended until the next engine_update (same as aul_is_playing).
fn engine_is_playing(e: *mut Engine, h: u32) -> bool {
    var g: u32 = 0 as u32
    lock(e)
    let slot: i64 = decode_handle(e, h, &g)
    var r: bool = false
    if slot >= 0 {
        r = (*at[Shared]((*e).shared, slot as usize)).active
    }
    unlock(e)
    return r
}

fn engine_set_position(e: *mut Engine, h: u32, x: f32, y: f32, z: f32, vx: f32, vy: f32, vz: f32) {
    var g: u32 = 0 as u32
    lock(e)
    let slot: i64 = decode_handle(e, h, &g)
    if slot >= 0 {
        var c: Cmd = new_cmd(CMD_SET_POSITION)
        c.slot = slot as u32
        c.generation = g
        c.px = x
        c.py = y
        c.pz = z
        c.vx = vx
        c.vy = vy
        c.vz = vz
        push_cmd(e, c)
    }
    unlock(e)
}

fn engine_set_volume(e: *mut Engine, h: u32, volume: f32) {
    var g: u32 = 0 as u32
    lock(e)
    let slot: i64 = decode_handle(e, h, &g)
    if slot >= 0 {
        var c: Cmd = new_cmd(CMD_SET_VOLUME)
        c.slot = slot as u32
        c.generation = g
        c.f0 = volume
        if volume < 0.0 {
            c.f0 = 0.0
        }
        push_cmd(e, c)
    }
    unlock(e)
}

fn engine_set_pitch(e: *mut Engine, h: u32, pitch: f32) {
    var g: u32 = 0 as u32
    lock(e)
    let slot: i64 = decode_handle(e, h, &g)
    if slot >= 0 {
        var c: Cmd = new_cmd(CMD_SET_PITCH)
        c.slot = slot as u32
        c.generation = g
        c.f0 = pitch
        if pitch < 0.01 {
            c.f0 = 0.01
        }
        push_cmd(e, c)
    }
    unlock(e)
}

// Unknown names are ignored (the sound designer owns the list).
fn engine_set_param(e: *mut Engine, h: u32, name: str, value: f32) {
    var g: u32 = 0 as u32
    lock(e)
    let slot: i64 = decode_handle(e, h, &g)
    if slot >= 0 {
        let ev1: u32 = (*at[Shared]((*e).shared, slot as usize)).event_plus_one
        if ev1 != 0 as u32 {
            let def: *mut EventDef = at[EventDef]((*e).events, (ev1 - 1 as u32) as usize)
            var idx: i32 = -1
            var i: usize = 0
            while i < (*def).param_n as usize {
                let pm: *mut ParamMap = at[ParamMap]((*e).params, (*def).param_first as usize + i)
                if name_eq((*pm).name_p, (*pm).name_n, name.p as u64, name.length()) {
                    idx = i as i32
                    break
                }
                i = i + 1
            }
            if idx >= 0 {
                var c: Cmd = new_cmd(CMD_SET_PARAM)
                c.slot = slot as u32
                c.generation = g
                c.a = idx
                c.f0 = value
                push_cmd(e, c)
            }
        }
    }
    unlock(e)
}

// Aulos: aul_set_listener. Right handed, looks down its forward axis, right = cross(forward, up).
fn engine_set_listener(e: *mut Engine, px: f32, py: f32, pz: f32, fx: f32, fy: f32, fz: f32,
    ux: f32, uy: f32, uz: f32, vx: f32, vy: f32, vz: f32) {
    // a command, so the 12 numbers arrive together at the start of a render call (no torn listener)
    var c: Cmd = new_cmd(CMD_LISTENER)
    c.px = px
    c.py = py
    c.pz = pz
    c.fx = fx
    c.fy = fy
    c.fz = fz
    c.ux = ux
    c.uy = uy
    c.uz = uz
    c.vx = vx
    c.vy = vy
    c.vz = vz
    lock(e)
    push_cmd(e, c)
    unlock(e)
}

// Aulos: aul_update. Once per frame: finished voices go back to the free list.
fn engine_update(e: *mut Engine) {
    lock(e)
    let rc_end: usize = ld_acq(&(*e).rc_head)
    while (*e).rc_tail != rc_end {
        let r: *mut Reclaim = at[Reclaim]((*e).reclaims, (*e).rc_tail)
        let slot: u32 = (*r).slot
        let g: u32 = (*r).generation
        st_rel(&(*e).rc_tail, (*e).rc_tail, ((*e).rc_tail + 1) % CMD_CAP)
        if slot >= (*e).max_voices {
            continue
        }
        let s: *mut Shared = at[Shared]((*e).shared, slot as usize)
        if (*s).generation != g {
            continue // stolen
        }
        if !(*s).active {
            continue // already back
        }
        (*s).active = false
        (*s).event_plus_one = 0 as u32
        (*s).priority = 0 as u32
        stu32((*e).free_list, (*e).n_free, slot)
        (*e).n_free = (*e).n_free + 1
    }
    unlock(e)
}

fn engine_stats(e: *mut Engine) -> Stats {
    return Stats { active_voices: (*e).active, max_voices: (*e).max_voices, started: (*e).started,
        stolen: (*e).stolen, dropped: (*e).dropped, commands_dropped: (*e).cmd_dropped,
        peak_left: (*e).peak_l, peak_right: (*e).peak_r,
        peak_hold_left: (*e).peak_hold_l, peak_hold_right: (*e).peak_hold_r, stream_underruns: ld_acq(&(*e).underruns) as u64 }
}

// ------------------------------------------------------------- PCM streaming voices (audio.ring)

fn end_stream(e: *mut Engine, k: usize) {
    let st: *mut Stream = at[Stream]((*e).streams, k)
    (*st).active = false
    st_rel64((*e).stream_done + (k * 8) as u64, (*st).generation as u64)
}

fn stream_begin_stop(e: *mut Engine, k: usize, fade: f32) {
    let st: *mut Stream = at[Stream]((*e).streams, k)
    if fade <= 0.0 {
        end_stream(e, k)
    } else {
        (*st).stopping = true
        (*st).fade_delta = 0.0 - 1.0 / (fade * ((*e).rate as f32))
    }
}

fn stop_all_streams(e: *mut Engine, fade: f32) {
    var k: usize = 0
    while k < MAX_STREAMS {
        if (*at[Stream]((*e).streams, k)).active {
            stream_begin_stop(e, k, fade)
        }
        k = k + 1
    }
}

fn process_stream_cmd(e: *mut Engine, c: *mut Cmd) {
    let k: usize = (*c).slot as usize
    if k >= MAX_STREAMS {
        return
    }
    let st: *mut Stream = at[Stream]((*e).streams, k)
    if (*c).kind == CMD_STREAM_START {
        var r: ring.Ring = ring.Ring { blk: (*c).ptr }
        (*st).active = true
        (*st).stopping = false
        (*st).primed = false
        (*st).generation = (*c).generation
        (*st).blk = (*c).ptr
        (*st).channels = ring.ring_channels(&r)
        (*st).src_rate = (*c).b as u32
        (*st).bus = (*c).a
        if (*st).bus < 0 || (*st).bus as usize >= (*e).n_buses {
            (*st).bus = 0
        }
        (*st).volume = (*c).f0
        (*st).pan = (*c).f1
        (*st).fade = 1.0
        (*st).fade_delta = 0.0
        (*st).gain_l = 0.0
        (*st).gain_r = 0.0
        (*st).cursor = 0.0
        (*st).fill = 0
        return
    }
    if !(*st).active || (*st).generation != (*c).generation {
        return
    }
    if (*c).kind == CMD_STREAM_STOP {
        stream_begin_stop(e, k, (*c).f0)
    } else if (*c).kind == CMD_STREAM_SET {
        (*st).volume = (*c).f0
        (*st).pan = (*c).f1
    }
}

fn s16_to_f32(x: u16) -> f32 {
    var v: i32 = x as i32
    if v >= 32768 {
        v = v - 65536
    }
    return (v as f32) / 32768.0
}

// Adds every active stream voice to its bus for one block. Reads the ring (this thread is the ring's consumer),
// converts S16 to f32, resamples linearly to the engine rate, applies volume/pan with a gain ramp over the block.
// A dry ring is a gap (silence) and counted; a finished and drained ring ends the voice.
fn render_streams(e: *mut Engine, frames: usize) {
    let pi: f32 = 3.14159265358979323846
    let ff: f32 = frames as f32
    let out_rate: f64 = (*e).rate as f64
    var k: usize = 0
    while k < MAX_STREAMS {
        let st: *mut Stream = at[Stream]((*e).streams, k)
        k = k + 1
        if !(*st).active {
            continue
        }
        var r: ring.Ring = ring.Ring { blk: (*st).blk }
        let channels: usize = (*st).channels as usize
        let space: usize = STREAM_CAP - (*st).fill
        if space > 0 {
            let got: usize = ring.ring_read(&r, (*st).tmp, space)
            var q: usize = 0
            while q < got {
                var l: f32 = 0.0
                var rr: f32 = 0.0
                if channels == 1 {
                    l = s16_to_f32(rt.ld16((*st).tmp, q))
                    rr = l
                } else {
                    l = s16_to_f32(rt.ld16((*st).tmp, q * 2))
                    rr = s16_to_f32(rt.ld16((*st).tmp, q * 2 + 1))
                }
                stf((*st).buf, ((*st).fill + q) * 2, l)
                stf((*st).buf, ((*st).fill + q) * 2 + 1, rr)
                q = q + 1
            }
            (*st).fill = (*st).fill + got
        }
        let fin: bool = ring.ring_is_finished(&r)
        let volume: f32 = (*st).volume * (*st).fade
        var pl: f32 = 1.0
        var pr: f32 = 1.0
        if channels >= 2 {
            if (*st).pan > 0.0 {
                pl = 1.0 - (*st).pan
            } else if (*st).pan < 0.0 {
                pr = 1.0 + (*st).pan
            }
        } else {
            let angle: f32 = (clampf((*st).pan, 0.0 - 1.0, 1.0) + 1.0) * (pi * 0.25)
            pl = cosf(angle)
            pr = sinf(angle)
        }
        let tl: f32 = volume * pl
        let tr: f32 = volume * pr
        if !(*st).primed {
            (*st).gain_l = tl
            (*st).gain_r = tr
            (*st).primed = true
        }
        let step_l: f32 = (tl - (*st).gain_l) / ff
        let step_r: f32 = (tr - (*st).gain_r) / ff
        let ratio: f64 = ((*st).src_rate as f64) / out_rate
        let dst: u64 = (*at[Bus]((*e).buses, (*st).bus as usize)).buffer
        var ended: bool = false
        var under: bool = false
        var n: usize = 0
        while n < frames {
            let i0: usize = (*st).cursor as usize
            if i0 >= (*st).fill {
                if fin {
                    ended = true
                } else {
                    under = true
                }
                break
            }
            var i1: usize = i0 + 1
            let frac: f32 = ((*st).cursor - (i0 as f64)) as f32
            if i1 >= (*st).fill {
                if frac > 0.0 && !fin {
                    under = true
                    break
                }
                i1 = i0
            }
            let a0: f32 = ldf((*st).buf, i0 * 2)
            let b0: f32 = ldf((*st).buf, i1 * 2)
            let a1: f32 = ldf((*st).buf, i0 * 2 + 1)
            let b1: f32 = ldf((*st).buf, i1 * 2 + 1)
            let left: f32 = a0 + (b0 - a0) * frac
            let right: f32 = a1 + (b1 - a1) * frac
            (*st).gain_l = (*st).gain_l + step_l
            (*st).gain_r = (*st).gain_r + step_r
            stf(dst, n * 2, ldf(dst, n * 2) + left * (*st).gain_l)
            stf(dst, n * 2 + 1, ldf(dst, n * 2 + 1) + right * (*st).gain_r)
            (*st).cursor = (*st).cursor + ratio
            if (*st).stopping {
                (*st).fade = (*st).fade + (*st).fade_delta
                if (*st).fade <= 0.0 {
                    (*st).fade = 0.0
                    ended = true
                    break
                }
            }
            n = n + 1
        }
        // drop what was consumed
        var used: usize = (*st).cursor as usize
        if used > (*st).fill {
            used = (*st).fill
        }
        if used > 0 {
            var m: usize = 0
            while m < ((*st).fill - used) * 2 {
                stf((*st).buf, m, ldf((*st).buf, used * 2 + m))
                m = m + 1
            }
            (*st).fill = (*st).fill - used
            (*st).cursor = (*st).cursor - (used as f64)
        }
        if !ended && fin && (*st).fill == 0 {
            ended = true
        }
        if under {
            (*e).underruns = (*e).underruns + 1
        }
        if ended {
            end_stream(e, k - 1)
        }
    }
}

// Plays PCM from an `audio.ring` (S16LE, 1 or 2 channels, any rate between rate/16 and 4 x rate of the engine) on a
// bus (-1 = master). The caller keeps writing into the ring (producer); the engine reads it on the audio thread.
// Close the ring (`ring_close_write`) to let the voice end after the last frame. Returns a stream handle, 0 = none.
fn engine_play_stream(e: *mut Engine, r: *mut ring.Ring, rate: u32, bus: i32, volume: f32, pan: f32) -> u32 {
    if ring.ring_blk(r) == 0 || rate == 0 as u32 {
        return 0 as u32
    }
    let ratio: f64 = (rate as f64) / ((*e).rate as f64)
    if ratio > 4.0 || ratio < 0.0625 {
        return 0 as u32
    }
    lock(e)
    var slot: i64 = -1
    var old: u64 = 0
    var k: usize = 0
    while k < MAX_STREAMS {
        let c: u64 = ld_acq64((*e).stream_claim + (k * 8) as u64)
        let d: u64 = ld_acq64((*e).stream_done + (k * 8) as u64)
        if c == d {
            slot = k as i64
            old = c
            break
        }
        k = k + 1
    }
    if slot < 0 {
        unlock(e)
        return 0 as u32
    }
    var g: u64 = (old + 1) & 16777215
    if g == 0 {
        g = 1
    }
    var cmd: Cmd = new_cmd(CMD_STREAM_START)
    cmd.slot = slot as u32
    cmd.generation = g as u32
    cmd.ptr = ring.ring_blk(r)
    cmd.a = bus
    cmd.b = rate as i32
    cmd.f0 = volume
    cmd.f1 = pan
    if !push_cmd(e, cmd) {
        unlock(e)
        return 0 as u32
    }
    st_rel64((*e).stream_claim + (slot as usize * 8) as u64, g)
    unlock(e)
    return ((slot as u32) + 1 as u32) | ((g as u32) << 8)
}

fn stream_slot(e: *mut Engine, h: u32, g: *mut u64) -> i64 {
    if h == 0 as u32 {
        return -1
    }
    let k: u32 = (h & 255 as u32)
    if k == 0 as u32 || k as usize > MAX_STREAMS {
        return -1
    }
    let gen: u64 = (h >> 8) as u64
    if ld_acq64((*e).stream_claim + ((k as usize - 1) * 8) as u64) != gen {
        return -1
    }
    *g = gen
    return (k - 1 as u32) as i64
}

fn engine_stream_stop(e: *mut Engine, h: u32, fade_seconds: f32) {
    var g: u64 = 0
    lock(e)
    let k: i64 = stream_slot(e, h, &g)
    if k >= 0 {
        var c: Cmd = new_cmd(CMD_STREAM_STOP)
        c.slot = k as u32
        c.generation = g as u32
        if fade_seconds > 0.0 {
            c.f0 = fade_seconds
        }
        push_cmd(e, c)
    }
    unlock(e)
}

fn engine_stream_set(e: *mut Engine, h: u32, volume: f32, pan: f32) {
    var g: u64 = 0
    lock(e)
    let k: i64 = stream_slot(e, h, &g)
    if k >= 0 {
        var c: Cmd = new_cmd(CMD_STREAM_SET)
        c.slot = k as u32
        c.generation = g as u32
        c.f0 = volume
        c.f1 = pan
        if volume < 0.0 {
            c.f0 = 0.0
        }
        push_cmd(e, c)
    }
    unlock(e)
}

// True from engine_play_stream until the voice ended (ring drained after close, or stopped).
fn engine_stream_playing(e: *mut Engine, h: u32) -> bool {
    var g: u64 = 0
    let k: i64 = stream_slot(e, h, &g)
    if k < 0 {
        return false
    }
    return ld_acq64((*e).stream_done + (k as usize * 8) as u64) != g
}

// ---------------------------------------------------------------- lock free mode + audio thread
//
// engine_set_lockfree(true): no mutex. Rules (the same as Aulos): ONE control thread calls the API (play, stop, set_*,
// update, listener, bus volume/mute, streams), ONE audio thread calls engine_render / engine_pump. They only share
// the command ring (control -> audio), the reclaim ring (audio -> control), the stream done words and a few aligned
// 32/64 bit values (bus volume/mute, stats). Configuration (buses, events, samples, bank loading) must happen while
// no audio thread runs (engine_audio_stop first) -- Aulos stops its device for that, too.
fn engine_set_lockfree(e: *mut Engine, on: bool) {
    (*e).lockfree = on
}

fn engine_is_lockfree(e: *mut Engine) -> bool {
    return (*e).lockfree
}

// control block of the audio thread, in 64 bit words
const AU_ENGINE: u64 = 0
const AU_SINK: u64 = 1
const AU_STOP: u64 = 2
const AU_FRAMES: u64 = 3
const AU_LOOPS: u64 = 4
const AU_SLEEPS: u64 = 5
const AU_RUNNING: u64 = 6
const AU_NS_TOTAL: u64 = 7
const AU_NS_MAX: u64 = 8
const AU_PUMPS: u64 = 9
const AU_CHUNK: u64 = 10
const AU_WORDS: usize = 12

struct AudioStats {
    running: bool,
    frames: u64,
    pumps: u64,
    sleeps: u64,
    render_ns_total: u64,
    render_ns_max: u64,
}

fn au_word(blk: u64, w: u64) -> u64 {
    return blk + w * 8
}

// What the program's `__thread_work(kind, arg)` dispatcher calls for AUDIO_KIND:
//     fn __thread_work(kind: u64, arg: u64) -> u64 {
//         if kind == engine.AUDIO_KIND { return engine.audio_main(arg) }
//         return 0
//     }
// (a library cannot define the dispatcher: there is one per program, see std.pool.)
fn audio_main(blk: u64) -> u64 {
    let e: *mut Engine = ld_acq64(au_word(blk, AU_ENGINE)) as *mut Engine
    let s: *mut sink.Sink = ld_acq64(au_word(blk, AU_SINK)) as *mut sink.Sink
    let chunk: usize = ld_acq64(au_word(blk, AU_CHUNK)) as usize
    st_rel64(au_word(blk, AU_RUNNING), 1)
    while ld_acq64(au_word(blk, AU_STOP)) == 0 {
        let t0: u64 = time.monotonic_ns()
        let n: usize = engine_pump(e, s, chunk)
        if n > 0 {
            let dt: u64 = time.monotonic_ns() - t0
            st_rel64(au_word(blk, AU_FRAMES), ld_acq64(au_word(blk, AU_FRAMES)) + n as u64)
            st_rel64(au_word(blk, AU_PUMPS), ld_acq64(au_word(blk, AU_PUMPS)) + 1)
            st_rel64(au_word(blk, AU_NS_TOTAL), ld_acq64(au_word(blk, AU_NS_TOTAL)) + dt)
            if dt > ld_acq64(au_word(blk, AU_NS_MAX)) {
                st_rel64(au_word(blk, AU_NS_MAX), dt)
            }
        } else {
            st_rel64(au_word(blk, AU_SLEEPS), ld_acq64(au_word(blk, AU_SLEEPS)) + 1)
            thread_sleep(1 as u64)
        }
    }
    st_rel64(au_word(blk, AU_RUNNING), 0)
    return 0
}

// Starts the audio thread: it renders into `s` (stereo) whenever the sink has room (chunks of at most `chunk`
// frames, 64 .. 4096) and sleeps 1 ms otherwise. Switches the engine to lock free mode. Call from the control thread
// with no API call of another thread in flight. `e` and `s` must stay alive (and in place) until engine_audio_stop.
fn engine_audio_start(e: *mut Engine, s: *mut sink.Sink, chunk: usize) -> bool {
    if (*e).audio != 0 || sink.sink_channels(s) != 2 as u32 {
        return false
    }
    var ch: usize = chunk
    if ch < 64 {
        ch = 64
    }
    if ch > 4096 {
        ch = 4096
    }
    let blk: u64 = alloc_zero[u64](AU_WORDS)
    if blk == 0 {
        return false
    }
    rt.st64(blk, AU_ENGINE as usize, e as u64)
    rt.st64(blk, AU_SINK as usize, s as u64)
    rt.st64(blk, AU_CHUNK as usize, ch as u64)
    (*e).lockfree = true
    let h: u64 = thread_start(AUDIO_KIND, blk)
    if h == 0 {
        (*e).lockfree = false
        rt.heap_free(blk, AU_WORDS * 8)
        return false
    }
    (*e).audio = blk
    (*e).audio_handle = h
    return true
}

fn engine_audio_running(e: *mut Engine) -> bool {
    if (*e).audio == 0 {
        return false
    }
    return ld_acq64(au_word((*e).audio, AU_RUNNING)) != 0
}

fn engine_audio_stats(e: *mut Engine) -> AudioStats {
    if (*e).audio == 0 {
        return AudioStats { running: false, frames: 0, pumps: 0, sleeps: 0, render_ns_total: 0, render_ns_max: 0 }
    }
    let b: u64 = (*e).audio
    return AudioStats { running: ld_acq64(au_word(b, AU_RUNNING)) != 0, frames: ld_acq64(au_word(b, AU_FRAMES)),
        pumps: ld_acq64(au_word(b, AU_PUMPS)), sleeps: ld_acq64(au_word(b, AU_SLEEPS)),
        render_ns_total: ld_acq64(au_word(b, AU_NS_TOTAL)), render_ns_max: ld_acq64(au_word(b, AU_NS_MAX)) }
}

// Stops and joins the audio thread, back to the mutex mode. Returns the frames it rendered.
fn engine_audio_stop(e: *mut Engine) -> u64 {
    if (*e).audio == 0 {
        return 0
    }
    let b: u64 = (*e).audio
    st_rel64(au_word(b, AU_STOP), 1)
    thread_wait((*e).audio_handle)
    let frames: u64 = ld_acq64(au_word(b, AU_FRAMES))
    rt.heap_free(b, AU_WORDS * 8)
    (*e).audio = 0
    (*e).audio_handle = 0
    (*e).lockfree = false
    return frames
}

// ------------------------------------------------------------ helpers for audio.bank (E1)

// Bus by name, created when missing (no parent). -1 = table full. Call the rebuild after parents changed.
fn engine_bus_make(e: *mut Engine, name: str) -> i32 {
    lock(e)
    let id: i32 = find_or_create_bus(e, name)
    unlock(e)
    return id
}

// Volume without a ramp (target and current), like Aulos does at bank load.
fn engine_bus_init(e: *mut Engine, id: i32, volume: f32) {
    if id < 0 || id as usize >= (*e).n_buses {
        return
    }
    let b: *mut Bus = at[Bus]((*e).buses, id as usize)
    (*b).target = volume
    (*b).current = volume
}

fn engine_bus_set_parent(e: *mut Engine, id: i32, parent: i32) {
    if id < 0 || id as usize >= (*e).n_buses || parent == id || parent >= (*e).n_buses as i32 {
        return
    }
    (*at[Bus]((*e).buses, id as usize)).parent = parent
}

fn engine_bus_rebuild(e: *mut Engine) {
    rebuild_bus_order(e)
}

// Makes the LAST event (just built) the definition of event `old` (same name): voices that play `old` continue
// with the new definition, the table gets no duplicate. Sample/param pools are index based, so this is a move.
fn engine_event_replace(e: *mut Engine, old: i32) -> bool {
    if old < 0 || (old as usize) + 1 >= (*e).n_events {
        return false
    }
    let last: usize = (*e).n_events - 1
    let dst: *mut EventDef = at[EventDef]((*e).events, old as usize)
    let src: *mut EventDef = at[EventDef]((*e).events, last)
    rt.heap_free((*dst).name_p, (*dst).name_n + 1)
    // Reload without growth: the new ids / params sit at the pool tails (the event was just built); when they fit into the old range
    // they are copied there and the tails are given back, so a hot reload of the same event does not eat the pools.
    var first: u32 = (*src).sample_first
    if (*src).sample_first as usize + (*src).sample_n as usize == (*e).n_sample_ids && (*src).sample_n <= (*dst).sample_n && (*dst).sample_first < (*src).sample_first {
        var k: usize = 0
        while k < (*src).sample_n as usize {
            let di: usize = (*dst).sample_first as usize + k
            let si: usize = (*src).sample_first as usize + k
            *at[i32]((*e).sample_ids, di) = *at[i32]((*e).sample_ids, si)
            stf((*e).slot_vol, di, ldf((*e).slot_vol, si))
            stf((*e).slot_pit, di, ldf((*e).slot_pit, si))
            k = k + 1
        }
        first = (*dst).sample_first
        (*e).n_sample_ids = (*src).sample_first as usize
    }
    // params: the old ones are dead (their names are freed); the new ones move into the old range when they fit (maps + curve points)
    var pfirst: u32 = (*src).param_first
    if (*src).param_n > 0 as u32 {
        let sn: usize = (*src).param_n as usize
        let sp0: usize = (*src).param_first as usize
        let sc0: usize = (*at[ParamMap]((*e).params, sp0)).curve_first as usize
        var spts: usize = 0
        var q: usize = 0
        while q < sn {
            spts = spts + (*at[ParamMap]((*e).params, sp0 + q)).curve_n as usize
            q = q + 1
        }
        var dpts: usize = 0
        q = 0
        while q < (*dst).param_n as usize {
            dpts = dpts + (*at[ParamMap]((*e).params, (*dst).param_first as usize + q)).curve_n as usize
            q = q + 1
        }
        let dp0: usize = (*dst).param_first as usize
        if (*dst).param_n > 0 as u32 && dp0 < sp0 && sp0 + sn == (*e).n_params && sc0 + spts == (*e).n_curve && sn <= (*dst).param_n as usize && spts <= dpts {
            let dc0: usize = (*at[ParamMap]((*e).params, dp0)).curve_first as usize
            var j: usize = 0
            while j < spts {
                stf((*e).curve_x, dc0 + j, ldf((*e).curve_x, sc0 + j))
                stf((*e).curve_y, dc0 + j, ldf((*e).curve_y, sc0 + j))
                j = j + 1
            }
            q = 0
            var off: usize = 0
            while q < sn {
                let sm: *mut ParamMap = at[ParamMap]((*e).params, sp0 + q)
                let dm: *mut ParamMap = at[ParamMap]((*e).params, dp0 + q)
                rt.heap_free((*dm).name_p, (*dm).name_n + 1) // the old name of that map
                *dm = *sm
                (*dm).curve_first = (dc0 + off) as u32
                off = off + (*sm).curve_n as usize
                q = q + 1
            }
            // old maps beyond the new count: names are freed, they stay as dead entries in the pool
            while q < (*dst).param_n as usize {
                let dm: *mut ParamMap = at[ParamMap]((*e).params, dp0 + q)
                rt.heap_free((*dm).name_p, (*dm).name_n + 1)
                (*dm).name_p = 0
                (*dm).name_n = 0
                (*dm).curve_n = 0 as u32
                q = q + 1
            }
            (*e).n_params = sp0
            (*e).n_curve = sc0
            pfirst = (*dst).param_first
        } else {
            q = 0
            while q < (*dst).param_n as usize {
                free_param_name(e, (*dst).param_first as usize + q)
                q = q + 1
            }
        }
    } else {
        var q: usize = 0
        while q < (*dst).param_n as usize {
            free_param_name(e, (*dst).param_first as usize + q)
            q = q + 1
        }
    }
    *dst = *src
    (*dst).sample_first = first
    (*dst).param_first = pfirst
    (*e).n_events = last
    name_index_rebuild(e) // the removed last slot may be in the index
    return true
}

fn free_param_name(e: *mut Engine, i: usize) {
    let pm: *mut ParamMap = at[ParamMap]((*e).params, i)
    if (*pm).name_p != 0 {
        rt.heap_free((*pm).name_p, (*pm).name_n + 1)
        (*pm).name_p = 0
        (*pm).name_n = 0
    }
}

// Drops EVERY event (names, params, id pools) but keeps samples and buses -- for a source switch (mcplay O key: original sounds without the
// synth events). Refused (false) while the audio thread runs. The caller reloads the events (a bank that remembers its samples by hash
// finds them again) and must have stopped its voices and forgotten cached event ids.
fn engine_events_clear(e: *mut Engine) -> bool {
    if engine_audio_running(e) {
        return false
    }
    var i: usize = 0
    while i < (*e).n_events {
        let ev: *mut EventDef = at[EventDef]((*e).events, i)
        rt.heap_free((*ev).name_p, (*ev).name_n + 1)
        i = i + 1
    }
    i = 0
    while i < (*e).n_params {
        free_param_name(e, i)
        i = i + 1
    }
    (*e).n_events = 0
    (*e).n_params = 0
    (*e).n_curve = 0
    (*e).n_sample_ids = 0
    rt.mem_set((*e).name_tab, 0 as u8, NAME_TAB * 4)
    engine_stop_all(e, 0.0)
    return true
}

// ------------------------------------------------------------------- audio thread

fn voice_reset(v: *mut Voice) {
    (*v).playing = false
    (*v).generation = 0 as u32
    (*v).event_id = -1
    (*v).sample_id = -1
    (*v).bus = 0
    (*v).cursor = 0.0
    (*v).base_pitch = 1.0
    (*v).base_volume = 1.0
    (*v).user_volume = 1.0
    (*v).user_pitch = 1.0
    (*v).looping = false
    (*v).spatial = false
    (*v).px = 0.0
    (*v).py = 0.0
    (*v).pz = 0.0
    (*v).vx = 0.0
    (*v).vy = 0.0
    (*v).vz = 0.0
    var i: usize = 0
    while i < MAX_PARAMS {
        (*v).param_values[i] = 0.0
        i = i + 1
    }
    (*v).fade = 1.0
    (*v).fade_delta = 0.0
    (*v).stopping = false
    (*v).gain_l = 0.0
    (*v).gain_r = 0.0
    (*v).primed = false
    (*v).lp_l = 0.0
    (*v).lp_r = 0.0
    (*v).lp2_l = 0.0
    (*v).lp2_r = 0.0
}

fn start_stop(e: *mut Engine, v: *mut Voice, slot: u32, fade: f32) {
    if fade <= 0.0 {
        (*v).playing = false
        push_reclaim(e, slot, (*v).generation)
    } else {
        (*v).stopping = true
        (*v).fade_delta = 0.0 - 1.0 / (fade * ((*e).rate as f32))
    }
}

fn process_commands(e: *mut Engine) {
    let end: usize = ld_acq(&(*e).cmd_head)
    while (*e).cmd_tail != end {
        let c: *mut Cmd = at[Cmd]((*e).cmds, (*e).cmd_tail)
        let tail0: usize = (*e).cmd_tail
        // the slot may be reused by the producer once the tail moved on: copy what we need first
        var cmd: Cmd = *c
        st_rel(&(*e).cmd_tail, tail0, (tail0 + 1) % CMD_CAP)
        process_one(e, &cmd)
    }
}

fn process_one(e: *mut Engine, c: *mut Cmd) {
    {
        if (*c).kind == CMD_LISTENER {
            (*e).lx = (*c).px
            (*e).ly = (*c).py
            (*e).lz = (*c).pz
            (*e).fx = (*c).fx
            (*e).fy = (*c).fy
            (*e).fz = (*c).fz
            (*e).ux = (*c).ux
            (*e).uy = (*c).uy
            (*e).uz = (*c).uz
            (*e).lvx = (*c).vx
            (*e).lvy = (*c).vy
            (*e).lvz = (*c).vz
            return
        }
        if (*c).kind >= CMD_STREAM_START {
            process_stream_cmd(e, c)
            return
        }
        if (*c).kind == CMD_STOP_ALL {
            var i: u32 = 0 as u32
            while i < (*e).max_voices {
                let v: *mut Voice = at[Voice]((*e).voices, i as usize)
                if (*v).playing {
                    start_stop(e, v, i, (*c).f0)
                }
                i = i + 1 as u32
            }
            stop_all_streams(e, (*c).f0)
            return
        }
        if (*c).slot >= (*e).max_voices {
            return
        }
        let v: *mut Voice = at[Voice]((*e).voices, (*c).slot as usize)
        if (*c).kind == CMD_START {
            voice_reset(v)
            (*v).playing = true
            (*v).generation = (*c).generation
            (*v).event_id = (*c).a
            (*v).sample_id = (*c).b
            (*v).base_volume = (*c).f0
            (*v).base_pitch = (*c).f1
            (*v).px = (*c).px
            (*v).py = (*c).py
            (*v).pz = (*c).pz
            (*v).vx = (*c).vx
            (*v).vy = (*c).vy
            (*v).vz = (*c).vz
            let def: *mut EventDef = at[EventDef]((*e).events, (*c).a as usize)
            (*v).bus = (*def).bus
            if (*c).bus_override >= 0 && ((*c).bus_override as usize) < (*e).n_buses {
                (*v).bus = (*c).bus_override
            }
            (*v).looping = (*def).looping
            (*v).spatial = (*def).spatial
            var p: usize = 0
            while p < (*def).param_n as usize && p < MAX_PARAMS {
                (*v).param_values[p] = (*at[ParamMap]((*e).params, (*def).param_first as usize + p)).default_value
                p = p + 1
            }
            return
        }
        if !(*v).playing || (*v).generation != (*c).generation {
            return
        }
        if (*c).kind == CMD_STOP {
            start_stop(e, v, (*c).slot, (*c).f0)
        } else if (*c).kind == CMD_SET_POSITION {
            (*v).px = (*c).px
            (*v).py = (*c).py
            (*v).pz = (*c).pz
            (*v).vx = (*c).vx
            (*v).vy = (*c).vy
            (*v).vz = (*c).vz
        } else if (*c).kind == CMD_SET_VOLUME {
            (*v).user_volume = (*c).f0
        } else if (*c).kind == CMD_SET_PITCH {
            (*v).user_pitch = (*c).f0
        } else if (*c).kind == CMD_SET_PARAM {
            if (*c).a >= 0 && (*c).a < MAX_PARAMS as i32 {
                (*v).param_values[(*c).a as usize] = (*c).f0
            }
        }
    }
}

struct Targets {
    gain_l: f32,
    gain_r: f32,
    pitch: f64,
    cutoff: f32,
}

fn vlen(x: f32, y: f32, z: f32) -> f32 {
    return math.sqrt32(x * x + y * y + z * z)
}

// normalized, (0,0,0) for tiny vectors
fn vnorm(x: f32, y: f32, z: f32, ox: *mut f32, oy: *mut f32, oz: *mut f32) {
    let l: f32 = vlen(x, y, z)
    if l < 0.000001 {
        *ox = 0.0
        *oy = 0.0
        *oz = 0.0
        return
    }
    *ox = x / l
    *oy = y / l
    *oz = z / l
}

fn cosf(x: f32) -> f32 {
    return math.cos(x as f64) as f32
}

fn sinf(x: f32) -> f32 {
    return math.sin(x as f64) as f32
}

fn expf(x: f32) -> f32 {
    return math.exp(x as f64) as f32
}

// Aulos: aulComputeVoiceTargets -- gains, pitch, cutoff for one block.
fn compute_targets(e: *mut Engine, v: *mut Voice, def: *mut EventDef, stereo_source: bool) -> Targets {
    let pi: f32 = 3.14159265358979323846
    var volume: f32 = (*v).base_volume * (*v).user_volume * (*v).fade
    var pitch: f64 = ((*v).base_pitch as f64) * ((*v).user_pitch as f64)
    var cutoff: f32 = (*def).lowpass_hz
    var p: usize = 0
    while p < (*def).param_n as usize && p < MAX_PARAMS {
        let m: *mut ParamMap = at[ParamMap]((*e).params, (*def).param_first as usize + p)
        let mapped: f32 = evaluate_curve(e, (*m).curve_first, (*m).curve_n, (*v).param_values[p], 1.0)
        if (*m).target == PARAM_VOLUME {
            volume = volume * mapped
        } else if (*m).target == PARAM_PITCH {
            pitch = pitch * (mapped as f64)
        } else if (*m).target == PARAM_LOWPASS {
            if mapped < cutoff {
                cutoff = mapped
            }
        }
        p = p + 1
    }
    var pan_l: f32 = 0.70710678
    var pan_r: f32 = 0.70710678
    if (*v).spatial {
        let rx: f32 = (*v).px - (*e).lx
        let ry: f32 = (*v).py - (*e).ly
        let rz: f32 = (*v).pz - (*e).lz
        let distance: f32 = vlen(rx, ry, rz)
        var attenuation: f32 = 0.0
        let d: f32 = clampf(distance, (*def).min_distance, (*def).max_distance)
        if (*def).rolloff == 1 {
            let span: f32 = (*def).max_distance - (*def).min_distance
            if span <= 0.000001 {
                attenuation = 1.0
            } else {
                attenuation = ((*def).max_distance - d) / span
            }
        } else {
            attenuation = (*def).min_distance / ((*def).min_distance + (*def).rolloff_factor * (d - (*def).min_distance))
        }
        volume = volume * clampf(attenuation, 0.0, 1.0)
        // right = normalized(cross(normalized(forward), normalized(up)))
        var fx: f32 = 0.0
        var fy: f32 = 0.0
        var fz: f32 = 0.0
        var ux: f32 = 0.0
        var uy: f32 = 0.0
        var uz: f32 = 0.0
        vnorm((*e).fx, (*e).fy, (*e).fz, &fx, &fy, &fz)
        vnorm((*e).ux, (*e).uy, (*e).uz, &ux, &uy, &uz)
        let cx: f32 = fy * uz - fz * uy
        let cy: f32 = fz * ux - fx * uz
        let cz: f32 = fx * uy - fy * ux
        var rgx: f32 = 0.0
        var rgy: f32 = 0.0
        var rgz: f32 = 0.0
        vnorm(cx, cy, cz, &rgx, &rgy, &rgz)
        var pan: f32 = 0.0
        if distance > 0.00001 {
            pan = clampf((rx * rgx + ry * rgy + rz * rgz) / distance, 0.0 - 1.0, 1.0)
        }
        let angle: f32 = (pan + 1.0) * (pi * 0.25)
        pan_l = cosf(angle)
        pan_r = sinf(angle)
        if (*def).doppler > 0.0 {
            var dx: f32 = 0.0
            var dy: f32 = 0.0
            var dz: f32 = 0.0
            vnorm((*e).lx - (*v).px, (*e).ly - (*v).py, (*e).lz - (*v).pz, &dx, &dy, &dz)
            let sl: f32 = dx * (*e).lvx + dy * (*e).lvy + dz * (*e).lvz
            let ss: f32 = dx * (*v).vx + dy * (*v).vy + dz * (*v).vz
            let num: f32 = 343.0 - (*def).doppler * sl
            let den: f32 = 343.0 - (*def).doppler * ss
            if den > 0.001 && num > 0.001 {
                pitch = pitch * (clampf(num / den, 0.25, 4.0) as f64)
            }
        }
    }
    if stereo_source && !(*v).spatial {
        pan_l = 1.0
        pan_r = 1.0
    }
    var op: f64 = pitch
    if op < 0.01 {
        op = 0.01
    } else if op > 16.0 {
        op = 16.0
    }
    return Targets { gain_l: volume * pan_l, gain_r: volume * pan_r, pitch: op, cutoff: cutoff }
}

fn render_block(e: *mut Engine, out: u64, frames: usize) {
    let pi: f32 = 3.14159265358979323846
    let nb: usize = (*e).n_buses
    var b: usize = 0
    while b < nb {
        rt.mem_set((*at[Bus]((*e).buses, b)).buffer, 0 as u8, frames * 2 * 4)
        b = b + 1
    }
    rt.mem_set(out, 0 as u8, frames * 2 * 4)
    let sample_rate: f64 = (*e).rate as f64
    var active_count: u32 = 0 as u32
    let ff: f32 = frames as f32

    var i: u32 = 0 as u32
    while i < (*e).max_voices {
        let v: *mut Voice = at[Voice]((*e).voices, i as usize)
        i = i + 1 as u32
        if !(*v).playing {
            continue
        }
        active_count = active_count + 1 as u32
        let def: *mut EventDef = at[EventDef]((*e).events, (*v).event_id as usize)
        let smp: *mut Sample = at[Sample]((*e).samples, (*v).sample_id as usize)
        let t: Targets = compute_targets(e, v, def, (*smp).channels >= 2 as u32)
        if !(*v).primed {
            (*v).gain_l = t.gain_l
            (*v).gain_r = t.gain_r
            (*v).primed = true
        }
        let step_l: f32 = (t.gain_l - (*v).gain_l) / ff
        let step_r: f32 = (t.gain_r - (*v).gain_r) / ff
        let use_filter: bool = (t.cutoff as f64) < sample_rate * 0.45
        var filter_a: f32 = 1.0
        if use_filter {
            let fc: f32 = clampf(t.cutoff, 20.0, (sample_rate * 0.45) as f32)
            filter_a = 1.0 - expf((0.0 - 2.0) * pi * fc / ((*e).rate as f32))
        }
        let dst: u64 = (*at[Bus]((*e).buses, (*v).bus as usize)).buffer
        let channels: usize = (*smp).channels as usize
        let sample_frames: u64 = (*smp).frames
        let data: u64 = (*smp).data
        var finished: bool = false
        var n: usize = 0
        while n < frames {
            if (*v).cursor >= (sample_frames as f64) {
                if (*v).looping {
                    (*v).cursor = (*v).cursor - (sample_frames as f64)
                    if (*v).cursor < 0.0 {
                        (*v).cursor = 0.0
                    }
                } else {
                    finished = true
                    break
                }
            }
            let i0: u64 = (*v).cursor as u64
            var i1: u64 = i0 + 1
            if i1 >= sample_frames {
                if (*v).looping {
                    i1 = 0
                } else {
                    i1 = i0
                }
            }
            let frac: f32 = ((*v).cursor - (i0 as f64)) as f32
            var left: f32 = 0.0
            var right: f32 = 0.0
            if channels == 1 {
                let a: f32 = ldf(data, i0 as usize)
                let bb: f32 = ldf(data, i1 as usize)
                left = a + (bb - a) * frac
                right = left
            } else {
                let a0: f32 = ldf(data, i0 as usize * channels)
                let b0: f32 = ldf(data, i1 as usize * channels)
                let a1: f32 = ldf(data, i0 as usize * channels + 1)
                let b1: f32 = ldf(data, i1 as usize * channels + 1)
                left = a0 + (b0 - a0) * frac
                right = a1 + (b1 - a1) * frac
            }
            if use_filter {
                (*v).lp_l = (*v).lp_l + filter_a * (left - (*v).lp_l)
                (*v).lp2_l = (*v).lp2_l + filter_a * ((*v).lp_l - (*v).lp2_l)
                if channels == 1 {
                    left = (*v).lp2_l
                    right = left
                } else {
                    (*v).lp_r = (*v).lp_r + filter_a * (right - (*v).lp_r)
                    (*v).lp2_r = (*v).lp2_r + filter_a * ((*v).lp_r - (*v).lp2_r)
                    left = (*v).lp2_l
                    right = (*v).lp2_r
                }
            }
            (*v).gain_l = (*v).gain_l + step_l
            (*v).gain_r = (*v).gain_r + step_r
            stf(dst, n * 2, ldf(dst, n * 2) + left * (*v).gain_l)
            stf(dst, n * 2 + 1, ldf(dst, n * 2 + 1) + right * (*v).gain_r)
            (*v).cursor = (*v).cursor + t.pitch
            if (*v).stopping {
                (*v).fade = (*v).fade + (*v).fade_delta
                if (*v).fade <= 0.0 {
                    (*v).fade = 0.0
                    finished = true
                    break
                }
            }
            n = n + 1
        }
        if finished {
            (*v).playing = false
            push_reclaim(e, i - 1 as u32, (*v).generation)
        }
    }

    render_streams(e, frames)

    // fold buses into their parents, deepest first
    var k: usize = 0
    while k < nb {
        let bus: *mut Bus = at[Bus]((*e).buses, (*at[i32]((*e).bus_order, k)) as usize)
        k = k + 1
        var target: f32 = (*bus).target
        if (*bus).muted {
            target = 0.0
        }
        var gain: f32 = (*bus).current
        let step: f32 = (target - gain) / ff
        let src: u64 = (*bus).buffer
        var d: u64 = out
        if (*bus).parent >= 0 {
            d = (*at[Bus]((*e).buses, (*bus).parent as usize)).buffer
        }
        var n: usize = 0
        while n < frames {
            gain = gain + step
            stf(d, n * 2, ldf(d, n * 2) + ldf(src, n * 2) * gain)
            stf(d, n * 2 + 1, ldf(d, n * 2 + 1) + ldf(src, n * 2 + 1) * gain)
            n = n + 1
        }
        (*bus).current = target
    }

    // master limiter: ceiling 0.97, attack ~1 ms, release ~250 ms
    let ceiling: f32 = 0.97
    let rate_f: f32 = (*e).rate as f32
    let atk: f32 = 1.0 - expf((0.0 - 1.0) / (0.001 * rate_f))
    let rel: f32 = 1.0 - expf((0.0 - 1.0) / (0.25 * rate_f))
    var g: f32 = (*e).lim_gain
    var n2: usize = 0
    while n2 < frames {
        var pk: f32 = absf(ldf(out, n2 * 2))
        let pr: f32 = absf(ldf(out, n2 * 2 + 1))
        if pr > pk {
            pk = pr
        }
        var want: f32 = 1.0
        if pk > ceiling {
            want = ceiling / pk
        }
        if want < g {
            g = g + atk * (want - g)
        } else {
            g = g + rel * (want - g)
        }
        if g > 1.0 {
            g = 1.0
        }
        if g < 0.0 {
            g = 0.0
        }
        stf(out, n2 * 2, ldf(out, n2 * 2) * g)
        stf(out, n2 * 2 + 1, ldf(out, n2 * 2 + 1) * g)
        n2 = n2 + 1
    }
    (*e).lim_gain = g

    var pl: f32 = 0.0
    var pr2: f32 = 0.0
    var m: usize = 0
    while m < frames {
        let a: f32 = absf(ldf(out, m * 2))
        let c: f32 = absf(ldf(out, m * 2 + 1))
        if a > pl {
            pl = a
        }
        if c > pr2 {
            pr2 = c
        }
        m = m + 1
    }
    (*e).peak_l = pl
    (*e).peak_r = pr2
    if pl > (*e).peak_hold_l { (*e).peak_hold_l = pl }
    if pr2 > (*e).peak_hold_r { (*e).peak_hold_r = pr2 }
    (*e).active = active_count
}

// Aulos: aul_render. `out` = interleaved stereo f32, `frames` frames. Commands queued so far
// apply at the start; the work goes in blocks of 128 frames.
fn engine_render(e: *mut Engine, out: u64, frames: usize) {
    lock(e)
    process_commands(e)
    var done: usize = 0
    while done < frames {
        var blk: usize = BLOCK
        if frames - done < blk {
            blk = frames - done
        }
        render_block(e, out + (done * 8) as u64, blk)
        done = done + blk
    }
    unlock(e)
}

// Renders what the sink has room for (max 4096 frames) and writes it as S16 (clamped,
// round half up: floor(x * 32767 + 0.5)). Returns the frames written.
fn engine_pump(e: *mut Engine, s: *mut sink.Sink, max_frames: usize) -> usize {
    if sink.sink_channels(s) != 2 as u32 {
        return 0
    }
    var n: usize = sink.sink_writable(s)
    if n > max_frames {
        n = max_frames
    }
    if n > 4096 {
        n = 4096
    }
    if n == 0 {
        return 0
    }
    engine_render(e, (*e).scratch, n)
    var i: usize = 0
    while i < n * 2 {
        let x: f32 = clampf(ldf((*e).scratch, i), 0.0 - 1.0, 1.0)
        let q: f64 = math.floor((x as f64) * 32767.0 + 0.5)
        var iv: i64 = q as i64
        if iv < 0 {
            iv = iv + 65536
        }
        rt.st16((*e).pcm_out, i, iv as u16)
        i = i + 1
    }
    if !sink.sink_write(s, (*e).pcm_out, n) {
        return 0
    }
    return n
}
