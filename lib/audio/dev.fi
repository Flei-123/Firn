// SPDX-License-Identifier: MPL-2.0
// lib/audio/dev.fi -- audio.dev: the sound device of this platform. Linux: PulseAudio.
//
// One interface, one file per platform (`dev.windows.fi` = waveOut,
// `dev_macos.fi`, `lib/@android/audio/dev.fi`, `dev_osum.fi` = stubs); `audio.sink` is
// written against it and adds files, the volume and the CRC. Nothing outside
// `audio.sink` is meant to call this.
//
//   dev_open(app, rate, channels) -> Dev      open a stream (S16LE, interleaved)
//   dev_is_open(d)                            false: no device, or it went away
//   dev_writable(d)                           how many FRAMES can be written right now
//   dev_write(d, p, frames)                   write them (blocks while the device is full)
//   dev_drain(d) / dev_flush(d) / dev_pause(d, on) / dev_close(d)
import std.rt
import audio.pulse

export { Dev, dev_open, dev_is_open, dev_writable, dev_write, dev_drain, dev_flush, dev_pause, dev_close, dev_null }

struct Dev {
    p: pulse.Pulse,
    open: bool,
    channels: u32,
}

fn dev_null() -> Dev {
    return Dev { p: pulse.pulse_null(), open: false, channels: 2 as u32 }
}

fn dev_open(app: str, rate: u32, channels: u32) -> Dev {
    var d: Dev = dev_null()
    d.channels = channels
    d.p = pulse.pulse_connect(app)
    if pulse.pulse_is_open(&d.p) && pulse.pulse_open_stream(&d.p, rate, channels, app) {
        d.open = true
    } else {
        pulse.pulse_close(&d.p)
    }
    return d
}

fn dev_is_open(d: *mut Dev) -> bool {
    return (*d).open
}

fn dev_writable(d: *mut Dev) -> usize {
    if !(*d).open {
        return 0
    }
    let n: usize = pulse.pulse_writable(&(*d).p)
    if !pulse.pulse_stream_open(&(*d).p) {
        (*d).open = false // the server went away or ended the stream
        return 0
    }
    return n / ((*d).channels as usize * 2)
}

fn dev_write(d: *mut Dev, p: u64, frames: usize) -> bool {
    if !(*d).open {
        return false
    }
    if !pulse.pulse_write(&(*d).p, p, frames * ((*d).channels as usize) * 2) {
        (*d).open = false
        return false
    }
    return true
}

fn dev_drain(d: *mut Dev) -> bool {
    return (*d).open && pulse.pulse_drain(&(*d).p)
}

fn dev_flush(d: *mut Dev) -> bool {
    return (*d).open && pulse.pulse_flush(&(*d).p)
}

// Holds the playing (on) or lets it go on (off); what was written stays queued.
fn dev_pause(d: *mut Dev, on: bool) -> bool {
    return (*d).open && pulse.pulse_cork(&(*d).p, on)
}

fn dev_close(d: *mut Dev) {
    pulse.pulse_close(&(*d).p)
    (*d).open = false
}
