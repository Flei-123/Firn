// SPDX-License-Identifier: MPL-2.0
// lib/audio/formant_table.fi -- audio.formant_table: vowel and consonant data for formant synthesis.
//
//     import audio.formant_table
//     let f1: f64 = formant_table.vowel_f(formant_table.VOWEL_AH, 0)       // 730.0 Hz
//     let bw2: f64 = formant_table.vowel_bw(formant_table.VOWEL_AH, 1)     // 90.0 Hz
//     let v: i32 = formant_table.vowel_by_name("ee")                        // VOWEL_EE, or -1
//
// SOURCE of the vowel formants F1 .. F3: Peterson & Barney (1952), "Control methods used in a study of the
// vowels", J. Acoust. Soc. Am. 24(2), Table V, averages of the MALE speakers (76 speakers, American English,
// words h-V-d). The bandwidths are the default values of the Klatt (1980) cascade/parallel synthesiser
// (B1 = 60, B2 = 90, B3 = 150 Hz), a little wider for the ends of the vowel space where the singing voice is
// less sharp. The relative levels of the three formants (1.0 / 0.9 / 0.7) are tuned by ear/spectrum for the
// parallel formant bank of audio.formant; with the falling slope of a sawtooth they give a natural tilt.
//
// | id | name | example word | F1  | F2   | F3   |
// |----|------|--------------|-----|------|------|
// | 0  | ah   | hod          | 730 | 1090 | 2440 |
// | 1  | ee   | heed         | 270 | 2290 | 3010 |
// | 2  | oo   | who'd        | 300 | 870  | 2240 |
// | 3  | ae   | had          | 660 | 1720 | 2410 |
// | 4  | oh   | hawed        | 570 | 840  | 2410 |
// | 5  | eh   | head         | 530 | 1840 | 2480 |
// | 6  | ih   | hid          | 390 | 1990 | 2550 |
// | 7  | uh   | hud          | 640 | 1190 | 2390 |
// | 8  | uu   | hood         | 440 | 1020 | 2240 |
// | 9  | er   | heard        | 490 | 1350 | 1690 |
//
// CONSONANTS (ids only; the sound itself is made by audio.formant_cons): noise fricatives s sh f z v, plosives
// b d g p t k, nasals m n. Place of articulation, centre frequency and Q of the noise bands are in
// `cons_center` / `cons_q`.
//
// HONEST
// T1  One average male vowel set. Female or child voices are approximated by the `shift` factor of the formant
//     functions (about 1.17 for women, 1.3 for children); no real second data set.
// T2  The vowels are targets of a single sustained vowel. Real vowels move with their neighbours
//     (co-articulation); here only the smooth transition in audio.formant moves them.
import std.rt

export {
    VOWEL_AH, VOWEL_EE, VOWEL_OO, VOWEL_AE, VOWEL_OH, VOWEL_EH, VOWEL_IH, VOWEL_UH, VOWEL_UU, VOWEL_ER,
    VOWEL_COUNT,
    CONS_NONE, CONS_S, CONS_SH, CONS_F, CONS_Z, CONS_V, CONS_B, CONS_D, CONS_G, CONS_P, CONS_T, CONS_K,
    CONS_M, CONS_N, CONS_COUNT,
    vowel_f, vowel_bw, vowel_gain, vowel_name, vowel_by_name,
    cons_by_name, cons_name, cons_is_plosive, cons_is_fricative, cons_is_nasal, cons_voiced,
    cons_center, cons_q, cons_gain, cons_ms,
}

const VOWEL_AH: i32 = 0
const VOWEL_EE: i32 = 1
const VOWEL_OO: i32 = 2
const VOWEL_AE: i32 = 3
const VOWEL_OH: i32 = 4
const VOWEL_EH: i32 = 5
const VOWEL_IH: i32 = 6
const VOWEL_UH: i32 = 7
const VOWEL_UU: i32 = 8
const VOWEL_ER: i32 = 9
const VOWEL_COUNT: i32 = 10

const CONS_NONE: i32 = 0
const CONS_S: i32 = 1
const CONS_SH: i32 = 2
const CONS_F: i32 = 3
const CONS_Z: i32 = 4
const CONS_V: i32 = 5
const CONS_B: i32 = 6
const CONS_D: i32 = 7
const CONS_G: i32 = 8
const CONS_P: i32 = 9
const CONS_T: i32 = 10
const CONS_K: i32 = 11
const CONS_M: i32 = 12
const CONS_N: i32 = 13
const CONS_COUNT: i32 = 14

// Formant k (0 = F1, 1 = F2, 2 = F3) of vowel v in Hz. Unknown v -> schwa-like neutral tube (500 / 1500 / 2500).
fn vowel_f(v: i32, k: i32) -> f64 {
    if v == VOWEL_AH {
        if k == 0 { return 730.0 }
        if k == 1 { return 1090.0 }
        return 2440.0
    }
    if v == VOWEL_EE {
        if k == 0 { return 270.0 }
        if k == 1 { return 2290.0 }
        return 3010.0
    }
    if v == VOWEL_OO {
        if k == 0 { return 300.0 }
        if k == 1 { return 870.0 }
        return 2240.0
    }
    if v == VOWEL_AE {
        if k == 0 { return 660.0 }
        if k == 1 { return 1720.0 }
        return 2410.0
    }
    if v == VOWEL_OH {
        if k == 0 { return 570.0 }
        if k == 1 { return 840.0 }
        return 2410.0
    }
    if v == VOWEL_EH {
        if k == 0 { return 530.0 }
        if k == 1 { return 1840.0 }
        return 2480.0
    }
    if v == VOWEL_IH {
        if k == 0 { return 390.0 }
        if k == 1 { return 1990.0 }
        return 2550.0
    }
    if v == VOWEL_UH {
        if k == 0 { return 640.0 }
        if k == 1 { return 1190.0 }
        return 2390.0
    }
    if v == VOWEL_UU {
        if k == 0 { return 440.0 }
        if k == 1 { return 1020.0 }
        return 2240.0
    }
    if v == VOWEL_ER {
        if k == 0 { return 490.0 }
        if k == 1 { return 1350.0 }
        return 1690.0
    }
    if k == 0 { return 500.0 }
    if k == 1 { return 1500.0 }
    return 2500.0
}

// Bandwidth (Hz) of formant k. Klatt defaults; closed back vowels and ee get a slightly wider F1 so the
// 270-300 Hz formant does not become a single ringing harmonic.
fn vowel_bw(v: i32, k: i32) -> f64 {
    if k == 0 {
        if v == VOWEL_EE || v == VOWEL_OO { return 70.0 }
        return 60.0
    }
    if k == 1 { return 90.0 }
    return 150.0
}

// Relative level of formant k in the parallel bank.
fn vowel_gain(k: i32) -> f64 {
    if k == 0 { return 1.0 }
    if k == 1 { return 0.9 }
    return 0.7
}

fn vowel_name(v: i32) -> str {
    if v == VOWEL_AH { return "ah" }
    if v == VOWEL_EE { return "ee" }
    if v == VOWEL_OO { return "oo" }
    if v == VOWEL_AE { return "ae" }
    if v == VOWEL_OH { return "oh" }
    if v == VOWEL_EH { return "eh" }
    if v == VOWEL_IH { return "ih" }
    if v == VOWEL_UH { return "uh" }
    if v == VOWEL_UU { return "uu" }
    if v == VOWEL_ER { return "er" }
    return "?"
}

fn same(s: str, lit: str) -> bool {
    if s.length() != lit.length() { return false }
    return rt.mem_eq(s.p as u64, lit.p as u64, s.length())
}

// "ah" -> VOWEL_AH ..., unknown -> -1
fn vowel_by_name(s: str) -> i32 {
    var v: i32 = 0
    while v < VOWEL_COUNT {
        if same(s, vowel_name(v)) { return v }
        v = v + 1
    }
    return -1
}

fn cons_name(c: i32) -> str {
    if c == CONS_S { return "s" }
    if c == CONS_SH { return "sh" }
    if c == CONS_F { return "f" }
    if c == CONS_Z { return "z" }
    if c == CONS_V { return "v" }
    if c == CONS_B { return "b" }
    if c == CONS_D { return "d" }
    if c == CONS_G { return "g" }
    if c == CONS_P { return "p" }
    if c == CONS_T { return "t" }
    if c == CONS_K { return "k" }
    if c == CONS_M { return "m" }
    if c == CONS_N { return "n" }
    return ""
}

// "sh" -> CONS_SH ..., "" -> CONS_NONE, unknown -> -1
fn cons_by_name(s: str) -> i32 {
    if s.length() == 0 { return CONS_NONE }
    var c: i32 = 1
    while c < CONS_COUNT {
        if same(s, cons_name(c)) { return c }
        c = c + 1
    }
    return -1
}

fn cons_is_plosive(c: i32) -> bool {
    return c >= CONS_B && c <= CONS_K
}

fn cons_is_fricative(c: i32) -> bool {
    return c >= CONS_S && c <= CONS_V
}

fn cons_is_nasal(c: i32) -> bool {
    return c == CONS_M || c == CONS_N
}

// voiced: the vocal folds vibrate (z v b d g m n)
fn cons_voiced(c: i32) -> bool {
    return c == CONS_Z || c == CONS_V || c == CONS_B || c == CONS_D || c == CONS_G || c == CONS_M || c == CONS_N
}

// Centre frequency (Hz) of the noise band: fricatives s high, sh middle, f broad; plosive bursts by place:
// labial (b p) low, alveolar (d t) high, velar (g k) middle.
fn cons_center(c: i32) -> f64 {
    if c == CONS_S || c == CONS_Z { return 7000.0 }
    if c == CONS_SH { return 3200.0 }
    if c == CONS_F || c == CONS_V { return 5500.0 }
    if c == CONS_B || c == CONS_P { return 700.0 }
    if c == CONS_D || c == CONS_T { return 4500.0 }
    if c == CONS_G || c == CONS_K { return 1800.0 }
    return 1000.0
}

fn cons_q(c: i32) -> f64 {
    if c == CONS_S || c == CONS_Z { return 1.6 }
    if c == CONS_SH { return 1.8 }
    if c == CONS_F || c == CONS_V { return 0.5 }
    if c == CONS_B || c == CONS_P { return 0.8 }
    if c == CONS_D || c == CONS_T { return 1.2 }
    if c == CONS_G || c == CONS_K { return 1.5 }
    return 1.0
}

// Level of the noise band (the BP has 0 dB at its centre; f is wide and quiet).
fn cons_gain(c: i32) -> f64 {
    if c == CONS_S { return 1.0 }
    if c == CONS_Z { return 0.55 }
    if c == CONS_SH { return 1.1 }
    if c == CONS_F { return 0.35 }
    if c == CONS_V { return 0.2 }
    if cons_is_plosive(c) { return 1.0 }
    return 0.0
}

// Typical length of the consonant segment in ms (fricatives; plosives: closure + 12 ms burst + aspiration;
// nasals: murmur).
fn cons_ms(c: i32) -> f64 {
    if c == CONS_S || c == CONS_SH { return 90.0 }
    if c == CONS_F { return 80.0 }
    if c == CONS_Z || c == CONS_V { return 70.0 }
    if c == CONS_B || c == CONS_D || c == CONS_G { return 40.0 }
    if c == CONS_P || c == CONS_T || c == CONS_K { return 60.0 }
    if c == CONS_M || c == CONS_N { return 60.0 }
    return 0.0
}
