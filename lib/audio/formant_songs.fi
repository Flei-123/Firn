// SPDX-License-Identifier: MPL-2.0
// lib/audio/formant_songs.fi -- audio.formant_songs: public-domain demo songs for audio.formant_seq.
//
//     import audio.formant_seq
//     import audio.formant_songs
//     var s: formant_seq.Seq = formant_seq.seq_new(44100)
//     formant_songs.daisy_bell(&s, 800.0, 6)       // 800 ms per beat, all 6 lines
//
// "Daisy Bell (Bicycle Built for Two)", Harry Dacre, 1892 -- public domain. The melody is written down in C major
// (3/4), one syllable per note. Pitches in MIDI numbers (60 = C4).
//
// HONEST
// S1  The melody was written down from memory. The opening ("Dai-sy, Dai-sy", E-C, D-G) and the range
//     (G3 .. A4, an octave and a bit) are reliable; the later lines are an approximation of the tune with the
//     right rhythm of the text -- compare with the 1892 score (IMSLP) before using it for anything else.
// S2  The words are split into syllables and mapped on the 10 vowels / 14 consonants of audio.formant_table;
//     l and r have no sound of their own (they are left out), "th" is sung as d. It is a robot choir, not a
//     pronunciation guide.
import audio.formant_seq
import audio.formant_table

export { daisy_bell, DAISY_LINES }

const DAISY_LINES: i32 = 6

// one syllable
fn syl(s: *mut formant_seq.Seq, beat_ms: f64, beats: f64, midi: f64, v1: i32, v2: i32, cb: i32, ca: i32, legato: bool) {
    formant_seq.seq_note_midi(s, beat_ms * beats, midi, v1, v2, cb, ca, 0.9, legato)
}

// Appends the first `lines` (1 .. 6) lines of the chorus. beat_ms = length of a quarter note.
fn daisy_bell(s: *mut formant_seq.Seq, beat_ms: f64, lines: i32) {
    let AH: i32 = formant_table.VOWEL_AH
    let EE: i32 = formant_table.VOWEL_EE
    let OO: i32 = formant_table.VOWEL_OO
    let AE: i32 = formant_table.VOWEL_AE
    let OH: i32 = formant_table.VOWEL_OH
    let EH: i32 = formant_table.VOWEL_EH
    let IH: i32 = formant_table.VOWEL_IH
    let UH: i32 = formant_table.VOWEL_UH
    let UU: i32 = formant_table.VOWEL_UU
    let ER: i32 = formant_table.VOWEL_ER
    let N0: i32 = formant_table.CONS_NONE
    let S: i32 = formant_table.CONS_S
    let SH: i32 = formant_table.CONS_SH
    let F: i32 = formant_table.CONS_F
    let Z: i32 = formant_table.CONS_Z
    let V: i32 = formant_table.CONS_V
    let B: i32 = formant_table.CONS_B
    let D: i32 = formant_table.CONS_D
    let G: i32 = formant_table.CONS_G
    let P: i32 = formant_table.CONS_P
    let T: i32 = formant_table.CONS_T
    let K: i32 = formant_table.CONS_K
    let M: i32 = formant_table.CONS_M
    let N: i32 = formant_table.CONS_N
    let m: f64 = beat_ms
    // line 1: Dai-sy, Dai-sy
    if lines >= 1 {
        syl(s, m, 3.0, 64.0, EH, EE, D, N0, true)
        syl(s, m, 3.0, 60.0, EE, 0 - 1, Z, N0, false)
        syl(s, m, 3.0, 62.0, EH, EE, D, N0, true)
        syl(s, m, 3.0, 55.0, EE, 0 - 1, Z, N0, false)
        // give me your an-swer, do
        syl(s, m, 1.0, 64.0, IH, 0 - 1, G, V, true)
        syl(s, m, 1.0, 65.0, EE, 0 - 1, M, N0, true)
        syl(s, m, 1.0, 67.0, EE, OH, N0, N0, true)
        syl(s, m, 2.0, 69.0, AE, 0 - 1, N0, N, true)
        syl(s, m, 1.0, 67.0, ER, 0 - 1, S, N0, true)
        syl(s, m, 3.0, 64.0, OO, 0 - 1, D, N0, false)
    }
    // line 2: I'm half cra-zy, all for the love of you
    if lines >= 2 {
        syl(s, m, 1.0, 67.0, AH, IH, N0, M, true)
        syl(s, m, 1.0, 67.0, AE, 0 - 1, N0, F, true)
        syl(s, m, 1.0, 69.0, AE, 0 - 1, K, N0, true)
        syl(s, m, 2.0, 67.0, EE, 0 - 1, Z, N0, true)
        syl(s, m, 1.0, 64.0, OH, 0 - 1, N0, N0, true)
        syl(s, m, 1.0, 62.0, OH, 0 - 1, F, N0, true)
        syl(s, m, 1.0, 62.0, UH, 0 - 1, D, N0, true)
        syl(s, m, 1.0, 64.0, UH, 0 - 1, N0, V, true)
        syl(s, m, 1.0, 62.0, UH, 0 - 1, N0, V, true)
        syl(s, m, 3.0, 60.0, EE, OO, N0, N0, false)
    }
    // line 3: It won't be a styl-ish mar-riage
    if lines >= 3 {
        syl(s, m, 0.5, 67.0, IH, 0 - 1, N0, T, true)
        syl(s, m, 0.5, 67.0, OO, OH, N0, N, true)
        syl(s, m, 0.5, 67.0, EE, 0 - 1, B, N0, true)
        syl(s, m, 0.5, 67.0, UH, 0 - 1, N0, N0, true)
        syl(s, m, 1.0, 69.0, AH, IH, S, N0, true)
        syl(s, m, 0.5, 67.0, IH, 0 - 1, N0, SH, true)
        syl(s, m, 1.0, 65.0, AH, 0 - 1, M, N0, true)
        syl(s, m, 2.0, 65.0, IH, 0 - 1, N0, SH, false)
    }
    // line 4: I can't af-ford a car-riage
    if lines >= 4 {
        syl(s, m, 0.5, 64.0, AH, IH, N0, N0, true)
        syl(s, m, 1.0, 64.0, AE, 0 - 1, K, N, true)
        syl(s, m, 0.5, 64.0, AE, 0 - 1, N0, F, true)
        syl(s, m, 1.0, 64.0, OH, 0 - 1, F, D, true)
        syl(s, m, 0.5, 65.0, UH, 0 - 1, N0, N0, true)
        syl(s, m, 1.0, 67.0, AH, 0 - 1, K, N0, true)
        syl(s, m, 2.5, 64.0, IH, 0 - 1, N0, SH, false)
    }
    // line 5: But you'll look sweet up-on the seat of a bi-cy-cle
    if lines >= 5 {
        syl(s, m, 0.5, 62.0, UH, 0 - 1, B, T, true)
        syl(s, m, 0.5, 62.0, EE, OO, N0, N0, true)
        syl(s, m, 0.5, 64.0, UU, 0 - 1, N0, K, true)
        syl(s, m, 1.5, 65.0, EE, 0 - 1, S, T, true)
        syl(s, m, 0.5, 67.0, UH, 0 - 1, N0, P, true)
        syl(s, m, 0.5, 67.0, AH, 0 - 1, N0, N, true)
        syl(s, m, 0.5, 65.0, UH, 0 - 1, D, N0, true)
        syl(s, m, 0.5, 64.0, EE, 0 - 1, S, T, true)
        syl(s, m, 0.5, 64.0, UH, 0 - 1, N0, V, true)
        syl(s, m, 0.5, 62.0, UH, 0 - 1, N0, N0, true)
        syl(s, m, 1.0, 64.0, AH, IH, B, N0, true)
        syl(s, m, 1.0, 65.0, AH, IH, S, N0, true)
        syl(s, m, 1.0, 67.0, UH, 0 - 1, K, N0, true)
    }
    // line 6: built for two
    if lines >= 6 {
        syl(s, m, 1.0, 69.0, IH, 0 - 1, B, T, true)
        syl(s, m, 1.0, 67.0, OH, 0 - 1, F, N0, true)
        syl(s, m, 1.0, 64.0, OO, 0 - 1, T, N0, true)
        syl(s, m, 3.0, 60.0, OO, 0 - 1, N0, N0, false)
        formant_seq.seq_rest(s, m * 1.0)
    }
}
