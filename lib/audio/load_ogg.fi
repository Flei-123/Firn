// SPDX-License-Identifier: MPL-2.0
// lib/audio/load_ogg.fi -- Ogg Vorbis samples for audio.engine (counterpart of engine_load_wav / engine_load_mp3).
//
//     import audio.engine
//     import audio.load_ogg
//
//     let id: i32 = load_ogg.ogg_load(&e, data_ptr, data_len)   // sample id or -1
//
// Decodes with ton.vorbis_file, keeps at most the first two channels (as engine_load_wav does) and converts to the
// engine rate with linear interpolation when it differs. Damaged packets are skipped; a file without any audio fails.
import std.rt
import audio.engine
import ton.vorbis_file

export {
    ogg_load,
}

fn lo_ldf(p: u64, i: usize) -> f32 {
    return *((p + (i * 4) as u64) as *mut f32)
}

fn lo_stf(p: u64, i: usize, v: f32) {
    *((p + (i * 4) as u64) as *mut f32) = v
}

fn ogg_load(e: *mut engine.Engine, p: u64, n: usize) -> i32 {
    var pcm: rt.Buf = rt.buf_new()
    var info: vorbis_file.VfInfo = vorbis_file.vf_info()
    let st: i32 = vorbis_file.vf_decode_f32(p, n, &pcm, &info)
    if st != 0 || info.frames <= 0 || info.channels <= 0 {
        rt.buf_free(&pcm)
        return -1
    }
    let frames: usize = info.frames as usize
    let ich: usize = info.channels as usize
    var och: usize = ich
    if och > 2 {
        och = 2
    }
    let rate: u32 = info.rate as u32
    var out_frames: usize = frames
    var step: f64 = 1.0
    if rate != 0 as u32 && rate != (*e).rate {
        out_frames = frames * ((*e).rate as usize) / (rate as usize)
        step = (rate as f64) / ((*e).rate as f64)
    }
    if out_frames == 0 {
        rt.buf_free(&pcm)
        return -1
    }
    let size: usize = out_frames * och * 4
    let buf: u64 = rt.heap_alloc(size)
    if buf == 0 {
        rt.buf_free(&pcm)
        return -1
    }
    let src: u64 = rt.buf_ptr(&pcm)
    var i: usize = 0
    while i < out_frames {
        let pos: f64 = (i as f64) * step
        var i0: usize = pos as usize
        if i0 >= frames {
            i0 = frames - 1
        }
        var i1: usize = i0 + 1
        if i1 >= frames {
            i1 = i0
        }
        let fr: f32 = (pos - (i0 as f64)) as f32
        var c: usize = 0
        while c < och {
            let a: f32 = lo_ldf(src, i0 * ich + c)
            let b: f32 = lo_ldf(src, i1 * ich + c)
            lo_stf(buf, i * och + c, a + (b - a) * fr)
            c = c + 1
        }
        i = i + 1
    }
    let id: i32 = engine.engine_add_sample(e, buf, out_frames as u64, och as u32)
    rt.heap_free(buf, size)
    rt.buf_free(&pcm)
    return id
}
