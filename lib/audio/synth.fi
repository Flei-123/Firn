// SPDX-License-Identifier: MPL-2.0
// lib/audio/synth.fi -- audio.synth: test tones, in integers only.
//
//     import audio.synth
//     var ph: u32 = 0 as u32
//     ph = synth.sine_fill(buf_ptr, 4800, 2, 440, 48000, 20000, ph)    // S16LE, both channels equal
//
// The sine is a CORDIC (24 iterations, 32-bit phase, Q30 values): no floating
// point, so the samples are EXACTLY the same on every platform and the Python
// reference in tools/audio/check.py reproduces them bit for bit, and compares
// them with `math.sin` (error at most 2 steps of 16 bit at full scale).
//
// PHASE: a u32, 2^32 = one full turn. `sine_fill` returns the phase after the
// last frame, so a tone can continue across calls without a click.
//
// HONEST
// Y1  Frequencies up to rate/2 (the phase step is freq * 2^32 / rate, rounded
//     down; at 48 kHz the frequency error is below 0.00002 Hz).
// Y2  `amp` is the peak of the S16 sample (0 .. 32767).
import std.rt

export { sine_fill, sine_q30, phase_step }

const K_GAIN: i64 = 652032874 // product of 1/sqrt(1 + 4^-i), i < 24, times 2^30

fn atan_turn(i: u64) -> i64 {
    // atan(2^-i) in 2^32-per-turn units
    if i == 0 { return 536870912 }
    if i == 1 { return 316933406 }
    if i == 2 { return 167458907 }
    if i == 3 { return 85004756 }
    if i == 4 { return 42667331 }
    if i == 5 { return 21354465 }
    if i == 6 { return 10679838 }
    if i == 7 { return 5340245 }
    if i == 8 { return 2670163 }
    if i == 9 { return 1335087 }
    if i == 10 { return 667544 }
    if i == 11 { return 333772 }
    if i == 12 { return 166886 }
    if i == 13 { return 83443 }
    if i == 14 { return 41722 }
    if i == 15 { return 20861 }
    if i == 16 { return 10430 }
    if i == 17 { return 5215 }
    if i == 18 { return 2608 }
    if i == 19 { return 1304 }
    if i == 20 { return 652 }
    if i == 21 { return 326 }
    if i == 22 { return 163 }
    return 81
}

// sin(2 pi phase / 2^32) in Q30 (about -2^30 .. 2^30).
fn sine_q30(phase: u32) -> i64 {
    let ph: u64 = phase as u64
    let quad: u64 = ph >> 30
    var z: i64 = (ph & 1073741823) as i64
    var x: i64 = K_GAIN
    var y: i64 = 0
    var i: u64 = 0
    while i < 24 {
        let dx: i64 = y >> i
        let dy: i64 = x >> i
        if z >= 0 {
            x = x - dx
            y = y + dy
            z = z - atan_turn(i)
        } else {
            x = x + dx
            y = y - dy
            z = z + atan_turn(i)
        }
        i = i + 1
    }
    // x = cos(theta), y = sin(theta), theta in [0, 90 degrees)
    if quad == 0 { return y }
    if quad == 1 { return x }
    if quad == 2 { return 0 - y }
    return 0 - x
}

// freq (Hz) -> phase step per frame
fn phase_step(freq: u32, rate: u32) -> u32 {
    return ((freq as u64) * 4294967296 / (rate as u64)) as u32
}

// Writes `frames` frames of a sine of `freq` Hz; returns the phase after them.
fn sine_fill(out: u64, frames: usize, channels: u32, freq: u32, rate: u32, amp: u32, phase: u32) -> u32 {
    let step: u64 = phase_step(freq, rate) as u64
    var ph: u64 = phase as u64
    var f: usize = 0
    var idx: usize = 0
    while f < frames {
        let s: i64 = sine_q30(ph as u32) * (amp as i64) / 1073741824
        let v: u16 = (s & 65535) as u16
        rt.st16(out, idx, v)
        idx = idx + 1
        if channels == 2 as u32 {
            rt.st16(out, idx, v)
            idx = idx + 1
        }
        ph = (ph + step) & 4294967295
        f = f + 1
    }
    return ph as u32
}
