// SPDX-License-Identifier: MPL-2.0
// lib/audio/synth_osc.fi -- audio.synth_osc: deterministic sound sources (oscillators, noise, envelopes, plucks, notes).
//
//     import audio.synth_osc
//     let n: usize = 44100
//     let buf: u64 = synth_osc.sig_new(n)                       // n f64 samples, zeroed
//     let fr: u64 = synth_osc.sig_const(n, 440.0)              // per-sample frequency in Hz
//     synth_osc.osc_fill(buf, n, 44100.0, synth_osc.WAVE_SAW, fr, 0, 0.0, 0.5, 0.0)
//     synth_osc.sig_free(buf, n)
//
// SIGNALS are arrays of f64 (address + length). Nominal range -1 .. 1; the final level is set by `normalize` /
// the recipe, not by the sources.
//
// DETERMINISM (same convention as mc_sky): only + - * / and comparisons on f64, NO libm, NO FMA. The sine comes
// from a 4096 point table built with the integer CORDIC of audio.synth (sine_q30) and linear interpolation, the
// exponential `pow2` from a Taylor series, the random numbers from an integer xorshift64*. The samples are
// therefore the same on every platform and tools/sounds/check.py reproduces them exactly.
//
// HONEST
// O1  Saw, square and pulse are band-limited with PolyBLEP (good, not perfect near Nyquist); the triangle is
//     the naive one (harmonics fall with 1/n^2, aliasing is far below -60 dB at musical pitches).
// O2  The sine table has linear interpolation: error about 3e-7 (-130 dB), below S16 resolution.
// O3  Pink noise is the 6 pole Kellet filter (+-0.5 dB from 9 Hz to Nyquist at 44.1 kHz), brown is a leaky integrator.
import std.rt
import audio.synth

export {
    Rng, rng_new, rng_next, rng_f64, rng_sym, rng_range, mix_seed,
    gf, pf, sig_new, sig_free, sig_const, sig_copy,
    ffloor, fract, pow2, fabs, sin_turn, cos_turn, tan_pi, db_to_gain,
    WAVE_SINE, WAVE_TRI, WAVE_SAW, WAVE_SQUARE, WAVE_PULSE, NOISE_WHITE, NOISE_PINK, NOISE_BROWN,
    osc_fill, noise_fill, shape, env_fill, pluck_fill, add_voice,
}

const LN2: f64 = 0.6931471805599453
const LOG2_10: f64 = 3.321928094887362
const TAU_TABLE: usize = 4096

const WAVE_SINE: i32 = 0
const WAVE_TRI: i32 = 1
const WAVE_SAW: i32 = 2
const WAVE_SQUARE: i32 = 3
const WAVE_PULSE: i32 = 4
const NOISE_WHITE: i32 = 0
const NOISE_PINK: i32 = 1
const NOISE_BROWN: i32 = 2

static mut SIN_TAB: u64 = 0

// ------------------------------------------------------------------------------------------------ f64 arrays

fn gf(p: u64, i: usize) -> f64 {
    return *((p + (i * 8) as u64) as *mut f64)
}

fn pf(p: u64, i: usize, v: f64) {
    *((p + (i * 8) as u64) as *mut f64) = v
}

// n zeroed samples (at least 1 so the address is valid)
fn sig_new(n: usize) -> u64 {
    var m: usize = n
    if m == 0 { m = 1 }
    let p: u64 = rt.heap_alloc(m * 8)
    rt.mem_set(p, 0 as u8, m * 8)
    return p
}

fn sig_free(p: u64, n: usize) {
    var m: usize = n
    if m == 0 { m = 1 }
    rt.heap_free(p, m * 8)
}

fn sig_const(n: usize, v: f64) -> u64 {
    let p: u64 = sig_new(n)
    var i: usize = 0
    while i < n {
        pf(p, i, v)
        i = i + 1
    }
    return p
}

fn sig_copy(src: u64, n: usize) -> u64 {
    let p: u64 = sig_new(n)
    rt.mem_copy(p, src, n * 8)
    return p
}

// ------------------------------------------------------------------------------------------------ math (no libm)

fn fabs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

// floor for |x| < 2^62
fn ffloor(x: f64) -> f64 {
    let i: i64 = x as i64
    let f: f64 = i as f64
    if f > x { return f - 1.0 }
    return f
}

fn fract(x: f64) -> f64 {
    return x - ffloor(x)
}

// 2^x, x clamped to -80 .. 80. Taylor series of e^(f ln2), f in [0,1), then exact doubling.
fn pow2(x0: f64) -> f64 {
    var x: f64 = x0
    if x > 80.0 { x = 80.0 }
    if x < 0.0 - 80.0 { x = 0.0 - 80.0 }
    let n: f64 = ffloor(x)
    let e: f64 = (x - n) * LN2
    var term: f64 = 1.0
    var sum: f64 = 1.0
    var k: i64 = 1
    while k <= 14 {
        term = term * e / (k as f64)
        sum = sum + term
        k = k + 1
    }
    var ni: i64 = n as i64
    while ni > 0 {
        sum = sum * 2.0
        ni = ni - 1
    }
    while ni < 0 {
        sum = sum * 0.5
        ni = ni + 1
    }
    return sum
}

// dB -> linear amplitude
fn db_to_gain(db: f64) -> f64 {
    return pow2(db * LOG2_10 / 20.0)
}

fn sin_init() {
    if SIN_TAB != 0 { return }
    let p: u64 = sig_new(TAU_TABLE + 1)
    var i: usize = 0
    while i <= TAU_TABLE {
        let ph: u64 = ((i as u64) * 1048576) & 4294967295 // 2^32 / 4096
        pf(p, i, (synth.sine_q30(ph as u32) as f64) / 1073741824.0)
        i = i + 1
    }
    SIN_TAB = p
}

// sin(2 pi t), t in turns (any real number)
fn sin_turn(t: f64) -> f64 {
    sin_init()
    let f: f64 = fract(t) * 4096.0
    let i: usize = f as usize
    let w: f64 = f - (i as f64)
    let a: f64 = gf(SIN_TAB, i)
    let b: f64 = gf(SIN_TAB, i + 1)
    return a + (b - a) * w
}

fn cos_turn(t: f64) -> f64 {
    return sin_turn(t + 0.25)
}

// tan(pi x), x in (0, 0.5)
fn tan_pi(x: f64) -> f64 {
    return sin_turn(x * 0.5) / cos_turn(x * 0.5)
}

// ------------------------------------------------------------------------------------------------ random numbers

struct Rng {
    s: u64,
}

fn mix_seed(a: u64, b: u64) -> u64 {
    var z: u64 = (a *% 6364136223846793005 as u64) +% (b +% 1442695040888963407 as u64)
    z = z ^ (z >> 29)
    z = z *% 14181476777654086739 as u64
    z = z ^ (z >> 32)
    return z
}

fn rng_new(seed: u64) -> Rng {
    var z: u64 = seed +% 11400714819323198485 as u64
    z = (z ^ (z >> 30)) *% 13787848793156543929 as u64
    z = (z ^ (z >> 27)) *% 10723151780598845931 as u64
    z = z ^ (z >> 31)
    if z == 0 { z = 88172645463325252 }
    return Rng { s: z }
}

// xorshift64*
fn rng_next(r: *mut Rng) -> u64 {
    var x: u64 = (*r).s
    x = x ^ (x >> 12)
    x = x ^ (x << 25)
    x = x ^ (x >> 27)
    (*r).s = x
    return x *% 2685821657736338717 as u64
}

// [0, 1)
fn rng_f64(r: *mut Rng) -> f64 {
    return ((rng_next(r) >> 11) as f64) * 1.1102230246251565e-16
}

// [-1, 1)
fn rng_sym(r: *mut Rng) -> f64 {
    return rng_f64(r) * 2.0 - 1.0
}

fn rng_range(r: *mut Rng, lo: f64, hi: f64) -> f64 {
    return lo + (hi - lo) * rng_f64(r)
}

// ------------------------------------------------------------------------------------------------ oscillators

fn blep(t: f64, dt: f64) -> f64 {
    if t < dt {
        let x: f64 = t / dt
        return x + x - x * x - 1.0
    }
    if t > 1.0 - dt {
        let x: f64 = (t - 1.0) / dt
        return x * x + x + x + 1.0
    }
    return 0.0
}

// Phase accumulating oscillator, amplitude 1. `freq` = array of Hz per sample. `pm` = array (0 = none) of phase
// modulation in turns times `pm_depth`. `width` = pulse width (0.01 .. 0.99, used by WAVE_PULSE).
fn osc_fill(out: u64, n: usize, rate: f64, wave: i32, freq: u64, pm: u64, pm_depth: f64, width: f64, phase0: f64) {
    var ph: f64 = fract(phase0)
    var w: f64 = width
    if w < 0.01 { w = 0.01 }
    if w > 0.99 { w = 0.99 }
    var i: usize = 0
    while i < n {
        let f: f64 = gf(freq, i)
        var dt: f64 = f / rate
        if dt < 0.0 { dt = 0.0 - dt }
        if dt > 0.49 { dt = 0.49 }
        var p: f64 = ph
        if pm != 0 {
            p = fract(ph + pm_depth * gf(pm, i))
        }
        var v: f64 = 0.0
        if wave == WAVE_SINE {
            v = sin_turn(p)
        } else if wave == WAVE_TRI {
            if p < 0.5 { v = 4.0 * p - 1.0 } else { v = 3.0 - 4.0 * p }
        } else if wave == WAVE_SAW {
            v = 2.0 * p - 1.0 - blep(p, dt)
        } else if wave == WAVE_SQUARE {
            if p < 0.5 { v = 1.0 } else { v = 0.0 - 1.0 }
            v = v + blep(p, dt)
            v = v - blep(fract(p + 0.5), dt)
        } else {
            if p < w { v = 1.0 } else { v = 0.0 - 1.0 }
            v = v + blep(p, dt)
            v = v - blep(fract(p + 1.0 - w), dt)
        }
        pf(out, i, v)
        ph = ph + f / rate
        ph = ph - ffloor(ph)
        i = i + 1
    }
}

// ------------------------------------------------------------------------------------------------ noise

// Fills `n` samples of noise, about -1 .. 1.
fn noise_fill(out: u64, n: usize, color: i32, seed: u64) {
    var r: Rng = rng_new(seed)
    var b0: f64 = 0.0
    var b1: f64 = 0.0
    var b2: f64 = 0.0
    var b3: f64 = 0.0
    var b4: f64 = 0.0
    var b5: f64 = 0.0
    var b6: f64 = 0.0
    var last: f64 = 0.0
    var i: usize = 0
    while i < n {
        let w: f64 = rng_sym(&r)
        var v: f64 = w
        if color == NOISE_PINK {
            b0 = 0.99886 * b0 + w * 0.0555179
            b1 = 0.99332 * b1 + w * 0.0750759
            b2 = 0.969 * b2 + w * 0.153852
            b3 = 0.8665 * b3 + w * 0.3104856
            b4 = 0.55 * b4 + w * 0.5329522
            b5 = (0.0 - 0.7616) * b5 - w * 0.016898
            v = (b0 + b1 + b2 + b3 + b4 + b5 + b6 + w * 0.5362) * 0.11
            b6 = w * 0.115926
        } else if color == NOISE_BROWN {
            last = (last + 0.02 * w) / 1.02
            v = last * 3.5
        }
        pf(out, i, v)
        i = i + 1
    }
}

// ------------------------------------------------------------------------------------------------ envelopes

// Curve shape 0..1 -> 0..1. c = 0 linear; c > 0 slow start / fast end; c < 0 fast start / slow end (exponential
// decay look): (2^(c u) - 1) / (2^c - 1).
fn shape(u: f64, c: f64) -> f64 {
    if c > 0.0 - 0.001 && c < 0.001 { return u }
    return (pow2(c * u) - 1.0) / (pow2(c) - 1.0)
}

// Multi segment envelope. `pts` = np triples (t_ms, level, curve) of f64, t ascending. Before the first point the
// level of the first, after the last the level of the last. The curve of a point shapes the segment ENDING there.
fn env_fill(out: u64, n: usize, rate: f64, pts: u64, np: usize) {
    var k: usize = 0
    var i: usize = 0
    while i < n {
        let t: f64 = (i as f64) * 1000.0 / rate
        while k + 1 < np && gf(pts, (k + 1) * 3) <= t {
            k = k + 1
        }
        var v: f64 = 0.0
        if np == 0 {
            v = 0.0
        } else if t <= gf(pts, 0) {
            v = gf(pts, 1)
        } else if k + 1 >= np {
            v = gf(pts, k * 3 + 1)
        } else {
            let t0: f64 = gf(pts, k * 3)
            let t1: f64 = gf(pts, (k + 1) * 3)
            let l0: f64 = gf(pts, k * 3 + 1)
            let l1: f64 = gf(pts, (k + 1) * 3 + 1)
            var u: f64 = 0.0
            if t1 > t0 { u = (t - t0) / (t1 - t0) }
            v = l0 + (l1 - l0) * shape(u, gf(pts, (k + 1) * 3 + 2))
        }
        pf(out, i, v)
        i = i + 1
    }
}

// ------------------------------------------------------------------------------------------------ voices

// Karplus-Strong plucked string, written (added) from sample `at`. `damp` 0 (bright, long) .. 1 (dull, short).
fn pluck_fill(out: u64, n: usize, rate: f64, at: usize, freq: f64, damp: f64, gain: f64, seed: u64) {
    var len: usize = (rate / freq) as usize
    if len < 2 { len = 2 }
    let line: u64 = sig_new(len)
    var r: Rng = rng_new(seed)
    var j: usize = 0
    while j < len {
        pf(line, j, rng_sym(&r))
        j = j + 1
    }
    var keep: f64 = 0.5 + 0.499 * (1.0 - damp)
    var pos: usize = 0
    var i: usize = at
    while i < n {
        let nxt: usize = (pos + 1) % len
        let cur: f64 = gf(line, pos)
        pf(out, i, gf(out, i) + cur * gain)
        pf(line, pos, (cur + gf(line, nxt)) * keep)
        pos = nxt
        i = i + 1
    }
    sig_free(line, len)
}

// Adds one soft voice (sine + 2nd and 3rd partial, attack/decay in ms) from sample `at`. Used by the note
// generator; `decay_ms` is the time constant-ish of the exponential fall (-6 curve over 3 * decay_ms).
fn add_voice(out: u64, n: usize, rate: f64, at: usize, freq: f64, gain: f64, attack_ms: f64, decay_ms: f64, h2: f64, h3: f64) {
    let total: f64 = attack_ms + decay_ms * 3.0
    var len: usize = (total * rate / 1000.0) as usize
    if at + len > n { len = n - at }
    var ph: f64 = 0.0
    let dt: f64 = freq / rate
    var i: usize = 0
    while i < len {
        let t: f64 = (i as f64) * 1000.0 / rate
        var e: f64 = 0.0
        if t < attack_ms {
            e = t / attack_ms
        } else {
            e = shape((t - attack_ms) / (decay_ms * 3.0), 0.0 - 6.0)
            e = 1.0 - e
        }
        let s: f64 = sin_turn(ph) + h2 * sin_turn(ph * 2.0) + h3 * sin_turn(ph * 3.0)
        pf(out, at + i, gf(out, at + i) + s * e * gain)
        ph = ph + dt
        ph = ph - ffloor(ph)
        i = i + 1
    }
}
