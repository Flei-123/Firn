// lib/dom/dom.fi — DOM-Prototyp in Firn (Abnahmepunkt 2, PLAN.md §3).
//
// ZWECK: der Nachweis, dass das gewaehlte Speichermodell (Opt-in-Tracing-GC,
// SPEC §3.5) genau das traegt, woran ein Zaehlverweis scheitert — den
// ZYKLISCHEN Objektgraphen eines DOM. Jede hier gebaute Zyklenart kommt in
// einer echten Browser-Engine wirklich vor:
//
//   1. Knoten <-> Kind      Eltern- UND Kinderzeiger, beide STARK; die
//                           Kinderliste ist eine `GcVec` (Runde 53).
//   2. Element extends Node Vererbung mit Attributen als `GcMap`, deren
//                           WERTE selbst auf dem GC-Heap liegen.
//   3. Knoten <-> Listener  Der Knoten haelt seine Listener in einer `GcVec`,
//                           jeder Listener haelt seinen Knoten (Gecko musste
//                           dafuer einen Zyklensammler nachruesten).
//   4. Sammlung -> Wurzel   Eine live `HTMLCollection` haelt ihren Wurzelknoten.
//   5. Observer -> GcWeak   Haelt sein Ziel NICHT am Leben (Gegenprobe).
//   6. Knoten <-> Wrapper   Der simulierte JS-Wrapper haelt den Knoten, der
//                           Knoten haelt den Wrapper.
//
// Ein Zaehlverweis gibt in 1, 3 und 6 NIE frei. Der Nachweis, dass Firn das
// aufloest, steht in tests/560_dom_cycles.fi und im Dauerlauf
// lib/dom/soak_gc.fi (Messung: tools/dom_soak/run.sh).
//
// ------------------------------------------------------------- Runde 53
//
// Bis Runde 52 stand hier: „Stufe 0 hat keine Sammlungen mit veraenderlicher
// Laenge. Deshalb: Kinderliste als einfach verkettete Geschwisterkette, feste
// Attributzahl." Beides ist weg. Der Baum benutzt jetzt
//
//     kinder:   GcVec[Gc[Node]]        (SPEC §3.5.2)
//     listener: GcVec[Gc[Listener]]
//     attrs:    GcMap[Atom, Gc[Str]]
//
// und damit laufen die Zyklen 1, 2 und 3 UEBER SAMMLUNGEN — genau der Fall,
// den `SPEC.md` §3.5.2 als DOM-Grundlage beschreibt und den der Sammler seit
// Runde 53 einsammeln kann. Die Sammlungen werden ERST BEI BEDARF angelegt:
// ein Blattknoten ohne Attribute und ohne Listener kostet weiterhin genau ein
// Objekt, und das ist im DOM der haeufigste Knoten ueberhaupt.
//
// Stufe 0 hat weiterhin keine Methoden — statt `parent.children.push(child)`
// steht hier `dom_kind_anhaengen(eltern, kind)`.

export {
    Node, Elem, Listener, Collection, Wrapper, Observer, Str,
    DOM_KIND_NODE, DOM_KIND_ELEM, DOM_KIND_TEXT,
    DOM_OBJECTS_PER_SET,
    dom_node_new, dom_elem_new,
    dom_append_child, dom_children_count, dom_child, dom_remove_child,
    dom_listener_append, dom_listener_count, dom_listener,
    dom_collection_new, dom_collection_refresh, dom_wrapper_append,
    dom_observer_new,
    dom_attr_set, dom_attr_read, dom_attr_remove,
    dom_attr_number,
    dom_cycle_build, dom_cycle_discard, dom_scrub_deep,
    dom_self_test, dom_observer_test, dom_observer_lives, dom_observer_create
}

// --------------------------------------------------------------- Klassen

// Ein Knoten haelt seine Eltern STARK. Damit ist der Zyklus echt und nicht
// per `GcWeak` wegdefiniert — genau das ist der Punkt des Nachweises.
gc class Node {
    parent: Gc[Node],
    children: GcVec[Gc[Node]],
    listener: GcVec[Gc[Listener]],
    wrapper: Gc[Wrapper],
    id: u32,
    kind: u32,
}

// Praefixlayout (SPEC §4.4): die geerbten Felder liegen vorne, deshalb ist
// jede `Gc[Element]` kostenlos eine `Gc[Node]`.
gc class Elem extends Node {
    attrs: GcMap[u32, Gc[Str]],
}

// Der Attributwert liegt auf dem GC-Heap — sonst waere die Wertspalte der
// `GcMap` nur eine Zahl und der Sammler haette dort nichts zu verfolgen.
gc class Str {
    id: u32,
    length: u32,
}

gc class Listener {
    target: Gc[Node],
    ty: u32,
}

gc class Collection {
    root: Gc[Node],
    length: u32,
}

gc class Wrapper {
    node: Gc[Node],
    id: u32,
}

// Der Observer haelt sein Ziel SCHWACH — er darf es nicht am Leben halten.
gc class Observer {
    target: GcWeak[Node],
    hit: u32,
}

const DOM_KIND_NODE: u32 = 1
const DOM_KIND_ELEM: u32 = 2
const DOM_KIND_TEXT: u32 = 3

// Ein Satz aus dom_zyklus_bauen(), Objekt fuer Objekt:
//   1  Wurzelelement
//   3  Attributtabelle (GcMap) + ihr Slot-Puffer + ein Str als Wert
//   3  Kindknoten
//   2  Kinderliste (GcVec) + ihr Slot-Puffer
//   3  Listener + Listenerliste (GcVec) + ihr Slot-Puffer
//   1  Sammlung
//   1  Wrapper
// Vor Runde 53 waren es 7 — die Sammlungen kosten die Differenz, und genau
// das ist der Preis dafuer, dass der Baum jetzt beliebig breit werden darf.
const DOM_OBJECTS_PER_SET: u64 = 14

// ------------------------------------------------------------- Erzeugung

fn dom_node_new(id: u32, kind: u32) -> AllocError!Gc[Node] {
    return try gc Node{
        parent: gc_null[Node](),
        children: gc_null[GcVec](),
        listener: gc_null[GcVec](),
        wrapper: gc_null[Wrapper](),
        id: id,
        kind: kind,
    }
}

fn dom_elem_new(id: u32) -> AllocError!Gc[Elem] {
    return try gc Elem{
        parent: gc_null[Node](),
        children: gc_null[GcVec](),
        listener: gc_null[GcVec](),
        wrapper: gc_null[Wrapper](),
        id: id,
        kind: DOM_KIND_ELEM,
        attrs: gc_null[GcMap](),
    }
}

// ------------------------------------------------------------ Baumstruktur

// Haengt `kind` an `eltern` an — BEIDE Richtungen stark. Das ist Zyklus 1,
// und er laeuft jetzt ueber eine `GcVec`: Elter -> GcVec -> Kind -> Elter.
//
// Die Kinderliste entsteht beim ERSTEN Kind. Ein Blatt bleibt damit so
// billig wie vorher.
fn dom_append_child(parent: Gc[Node], kind: Gc[Node]) -> AllocError!bool {
    if parent.children == gc_null[GcVec]() {
        parent.children = try gcvec_new()
    }
    if !(try gcvec_append[Node](parent.children, kind)) {
        return false
    }
    kind.parent = parent
    return true
}

fn dom_children_count(parent: Gc[Node]) -> u32 {
    if parent.children == gc_null[GcVec]() {
        return 0
    }
    return gcvec_length(parent.children) as u32
}

fn dom_child(parent: Gc[Node], i: u64) -> Gc[Node] {
    if parent.children == gc_null[GcVec]() {
        return gc_null[Node]()
    }
    return gcvec_read[Node](parent.children, i)
}

// `removeChild`: die Reihenfolge der Geschwister bleibt erhalten, und der
// Rueckverweis wird geloest — sonst haelt das Kind seinen alten Elter weiter.
fn dom_remove_child(parent: Gc[Node], i: u64) -> bool {
    if parent.children == gc_null[GcVec]() {
        return false
    }
    let k: Gc[Node] = gcvec_read[Node](parent.children, i)
    if k == gc_null[Node]() {
        return false
    }
    if !gcvec_remove(parent.children, i) {
        return false
    }
    k.parent = gc_null[Node]()
    return true
}

// Zyklus 3: der Knoten haelt seine Listener in einer `GcVec`, jeder Listener
// haelt seinen Knoten zurueck.
fn dom_listener_append(node: Gc[Node], ty: u32) -> AllocError!Gc[Listener] {
    if node.listener == gc_null[GcVec]() {
        node.listener = try gcvec_new()
    }
    let l: Gc[Listener] = try gc Listener{ target: node, ty: ty }
    if !(try gcvec_append[Listener](node.listener, l)) {
        return gc_null[Listener]()
    }
    return l
}

fn dom_listener_count(node: Gc[Node]) -> u32 {
    if node.listener == gc_null[GcVec]() {
        return 0
    }
    return gcvec_length(node.listener) as u32
}

fn dom_listener(node: Gc[Node], i: u64) -> Gc[Listener] {
    if node.listener == gc_null[GcVec]() {
        return gc_null[Listener]()
    }
    return gcvec_read[Listener](node.listener, i)
}

// Zyklus 4: eine live Sammlung haelt ihre Wurzel.
fn dom_collection_new(root: Gc[Node]) -> AllocError!Gc[Collection] {
    return try gc Collection{ root: root, length: 0 }
}

fn dom_collection_refresh(s: Gc[Collection]) -> u32 {
    let n: u32 = dom_children_count(s.root)
    s.length = n
    return n
}

// Zyklus 6: JS-Wrapper <-> Knoten.
fn dom_wrapper_append(node: Gc[Node], id: u32) -> AllocError!Gc[Wrapper] {
    let w = try gc Wrapper{ node: node, id: id }
    node.wrapper = w
    return w
}

// Gegenprobe 5: schwacher Verweis, haelt das Ziel NICHT.
fn dom_observer_new(target: Gc[Node]) -> AllocError!Gc[Observer] {
    return try gc Observer{ target: weak(target), hit: 0 }
}

// ------------------------------------------------------------- Attribute
//
// `attrs: GcMap[Atom, Gc[Str]]` (SPEC §3.5.2). Der Schluessel ist die
// Atom-Kennung, der Wert ein Objekt auf dem GC-Heap. Die Kennungen 0 und 1
// sind reserviert (GCMAP_LEER/GCMAP_GRAB); 0 war schon vorher „nicht
// vorhanden".

fn dom_attr_set(e: Gc[Elem], name: u32, value: u32) -> AllocError!bool {
    if name < 2 {
        return false
    }
    if e.attrs == gc_null[GcMap]() {
        e.attrs = try gcmap_new(false, true)
    }
    let s: Gc[Str] = try gc Str{ id: value, length: 0 }
    return try gcmap_set_value[Str](e.attrs, name as u64, s)
}

// 0 = nicht vorhanden (die Atom-Kennung 0 ist reserviert).
fn dom_attr_read(e: Gc[Elem], name: u32) -> u32 {
    if e.attrs == gc_null[GcMap]() {
        return 0
    }
    let s: Gc[Str] = gcmap_get_value[Str](e.attrs, name as u64)
    if s == gc_null[Str]() {
        return 0
    }
    return s.id
}

fn dom_attr_remove(e: Gc[Elem], name: u32) -> bool {
    if e.attrs == gc_null[GcMap]() {
        return false
    }
    return gcmap_remove(e.attrs, name as u64)
}

fn dom_attr_number(e: Gc[Elem]) -> u32 {
    if e.attrs == gc_null[GcMap]() {
        return 0
    }
    return gcmap_size(e.attrs) as u32
}

// ---------------------------------------------------------- Dauerlauf-Satz

// Baut EINEN vollstaendigen Zyklus-Satz (Arten 1, 2, 3, 4 und 6) und liefert
// die Zahl der dabei angelegten Objekte.
//
// EHRLICHER HINWEIS: Stufe 0 hat keine globalen Variablen. Der Satz haengt
// deshalb ausschliesslich an den Rahmenzellen DIESER Funktion und ist mit der
// Rueckkehr unerreichbar — genau das ist fuer den Dauerlauf gewollt. Ein
// Zaehlverweis wuerde hier nichts freigeben (Kind haelt Eltern, Eltern halten
// ihre GcVec, die GcVec haelt das Kind; Listener haelt Knoten, Knoten haelt
// seine Listenerliste).
fn dom_cycle_build() -> AllocError!u64 {
    let w = try dom_elem_new(1)
    let root: Gc[Node] = w
    if !(try dom_attr_set(w, 7, 42)) {
        return 0
    }

    var i: u32 = 0
    while i < 3 {
        let k = try dom_node_new(100 + i, DOM_KIND_TEXT)
        if !(try dom_append_child(root, k)) {
            return 0
        }
        // Rueckverweis pruefen, damit der Zyklus nicht wegoptimiert wird.
        if k.parent != root {
            return 0
        }
        i = i + 1
    }

    let l = try dom_listener_append(root, 5)
    if l.target != root {
        return 0
    }
    let s = try dom_collection_new(root)
    if dom_collection_refresh(s) != 3 {
        return 0
    }
    let wr = try dom_wrapper_append(root, 9)
    if wr.node != root {
        return 0
    }
    return DOM_OBJECTS_PER_SET
}

// Laesst den zuletzt gebauten Satz sicher unerreichbar werden.
//
// Der Satz ist mit der Rueckkehr aus `dom_zyklus_bauen()` bereits nicht mehr
// erreichbar; was bleiben kann, sind ALTE ZEIGER in aufgegebenen Stapelrahmen.
// Der Stapelscan des Sammlers ist konservativ (SPEC §3.5.3) — ein solcher
// Altzeiger haelt ein laengst totes Objekt am Leben. Diese Funktion legt einen
// tiefen, mit Nullen beschriebenen Rahmen ueber genau diesen Bereich. Das ist
// der ehrliche Preis des konservativen Scans, hier bezahlt statt verschwiegen.
fn dom_cycle_discard() {
    dom_scrub_deep(3)
}

// Der Selbstaufruf ist Absicht und keine Spielerei: eine rekursive Funktion
// wird NIE eingebettet (compiler/src/inline.rs). Nur dadurch liegen die
// genullten Rahmen wirklich UNTERHALB des Aufrufers — eingebettet waeren sie
// Teil seines eigenen, LEBENDEN Rahmens und wuerden gar nichts saeubern.
// Dieselbe Bauart benutzt die Laufzeit in lib/gc/gc.fi (`__gc_scrub_tief`).
fn dom_scrub_deep(n: u64) {
    var buffer: [u64; 512] = [0; 512]
    var i: usize = 0
    while i < 512 {
        buffer[i] = 0
        i = i + 1
    }
    barrier(&buffer)
    if n > 0 {
        dom_scrub_deep(n - 1)
    }
}

// ---------------------------------------------------------- Selbsttest

// Prueft jede Zyklenart einzeln. 0 = alles in Ordnung, sonst Fehlercode.
fn dom_self_test() -> i32 {
    // --- Art 1: Eltern <-> Kind ueber eine GcVec, beide stark
    let e = dom_elem_new(1) catch gc_null[Elem]()
    if e == gc_null[Elem]() {
        return 1
    }
    let root: Gc[Node] = e
    let k1 = dom_node_new(11, DOM_KIND_TEXT) catch gc_null[Node]()
    let k2 = dom_node_new(12, DOM_KIND_TEXT) catch gc_null[Node]()
    if k1 == gc_null[Node]() || k2 == gc_null[Node]() {
        return 2
    }
    if !(dom_append_child(root, k1) catch false) {
        return 3
    }
    if !(dom_append_child(root, k2) catch false) {
        return 3
    }
    if dom_child(root, 0) != k1 || dom_child(root, 1) != k2 {
        return 3
    }
    if k1.parent != root || k2.parent != root {
        return 4
    }
    if dom_child(k1.parent, 0) != k1 {
        return 5
    }
    if dom_children_count(root) != 2 {
        return 6
    }

    // --- Art 2: Vererbung und Attribute in einer GcMap
    if !(dom_attr_set(e, 7, 42) catch false) {
        return 7
    }
    if !(dom_attr_set(e, 8, 43) catch false) {
        return 8
    }
    if dom_attr_read(e, 7) != 42 || dom_attr_read(e, 8) != 43 {
        return 9
    }
    if dom_attr_read(e, 99) != 0 {
        return 10
    }
    // Die Attributzahl ist nicht mehr auf vier begrenzt.
    var a: u32 = 10
    while a < 200 {
        if !(dom_attr_set(e, a, a * 2) catch false) {
            return 24
        }
        a = a + 1
    }
    if dom_attr_number(e) != 192 {
        return 25
    }
    if dom_attr_read(e, 150) != 300 {
        return 26
    }
    if !dom_attr_remove(e, 150) {
        return 27
    }
    if dom_attr_read(e, 150) != 0 || dom_attr_number(e) != 191 {
        return 28
    }
    // Aufwaertsumwandlung ist kostenlos, abwaerts nur geprueft.
    if root.as?[Elem] == gc_null[Elem]() {
        return 11
    }
    if k1.as?[Elem] != gc_null[Elem]() {
        return 12
    }

    // --- Art 3: Knoten <-> Listener ueber eine GcVec
    let l = dom_listener_append(root, 5) catch gc_null[Listener]()
    if l == gc_null[Listener]() {
        return 13
    }
    if dom_listener(root, 0) != l || l.target != root {
        return 14
    }
    if dom_listener(dom_listener(root, 0).target, 0) != l {
        return 15
    }

    // --- Art 4: Sammlung haelt ihre Wurzel
    let s = dom_collection_new(root) catch gc_null[Collection]()
    if s == gc_null[Collection]() {
        return 16
    }
    if dom_collection_refresh(s) != 2 || s.root != root {
        return 17
    }

    // --- Art 6: Knoten <-> JS-Wrapper
    let w = dom_wrapper_append(root, 9) catch gc_null[Wrapper]()
    if w == gc_null[Wrapper]() {
        return 18
    }
    if root.wrapper != w || w.node != root {
        return 19
    }

    // Ein Sammellauf mitten im Betrieb darf nichts Erreichbares wegnehmen —
    // auch nicht aus den Sammlungen.
    let before: u64 = gc_collections()
    gc_collect()
    if gc_collections() != before + 1 {
        return 20
    }
    if dom_listener(root, 0).target != root || w.node.wrapper != w {
        return 21
    }
    if dom_children_count(root) != 2 {
        return 22
    }
    if dom_attr_read(e, 7) != 42 {
        return 23
    }

    // --- Baumumbau: removeChild loest den Rueckverweis
    if !dom_remove_child(root, 0) {
        return 29
    }
    if dom_children_count(root) != 1 {
        return 30
    }
    if dom_child(root, 0) != k2 {
        return 31
    }
    if k1.parent != gc_null[Node]() {
        return 32
    }

    // --- Breite: 5000 Kinder an EINEM Knoten. Genau das war vor Runde 53
    // nicht moeglich (feste Attributzahl, verkettete Liste ohne Index).
    let wide = dom_elem_new(2) catch gc_null[Elem]()
    if wide == gc_null[Elem]() {
        return 33
    }
    let bw: Gc[Node] = wide
    var i: u32 = 0
    while i < 5000 {
        let k = dom_node_new(1000 + i, DOM_KIND_TEXT) catch gc_null[Node]()
        if k == gc_null[Node]() {
            return 34
        }
        if !(dom_append_child(bw, k) catch false) {
            return 35
        }
        i = i + 1
    }
    gc_collect()
    gc_collect()
    if dom_children_count(bw) != 5000 {
        return 36
    }
    var j: u64 = 0
    while j < 5000 {
        let k: Gc[Node] = dom_child(bw, j)
        if k == gc_null[Node]() {
            return 37
        }
        if k.id != 1000 + j as u32 {
            return 38
        }
        if k.parent != bw {
            return 39
        }
        j = j + 1
    }

    return 0
}

// --- Art 5: Observer ueber GcWeak haelt sein Ziel NICHT.
//
// BEWUSST EINE EIGENE FUNKTION, und das ist der interessante Teil des
// Nachweises: der Stapelscan ist KONSERVATIV (SPEC §3.5.3). Stuende diese
// Pruefung im Rumpf von `dom_selbsttest`, laege dort noch eine alte Kopie des
// starken Zeigers in einer Rahmenzelle dieser LEBENDEN Funktion — und ein
// konservativer Sammler muss eine solche Zelle als Wurzel behandeln. Das Ziel
// ueberlebte dann, und der Test wuerde eine Eigenschaft messen, die die
// Sprache gar nicht zusagt.
//
// Nachgemessen: genau so verhaelt es sich. Mit `--no-pass=inline` besteht die
// Pruefung auch im Rumpf von `dom_selbsttest`, mit Einbettung nicht — die
// eingebetteten Zellen werden Teil des lebenden Rahmens. Deshalb steht sie
// hier, mit flachem Aufrufer und ohne weitere lebende Gc-Werte.
//
// 0 = das nur schwach beobachtete Ziel wurde eingesammelt.
fn dom_observer_test() -> i32 {
    var beo: Gc[Observer] = gc_null[Observer]()
    let rc: i32 = dom_observer_create(&beo)
    if rc != 0 {
        return rc
    }
    if beo == gc_null[Observer]() {
        return 4
    }
    // Solange der starke Zeiger im Rahmen von `dom_observer_anlegen` lebte,
    // war das Ziel erreichbar; jetzt haengt es nur noch am schwachen Verweis.
    if !dom_observer_lives(beo, 1) {
        return 5
    }
    dom_cycle_discard()
    // Runde 49: erst die toten Rahmen saeubern, dann sammeln — sonst haelt
    // ein Bitmuster in einem nicht ueberschriebenen Rahmenplatz das Ziel am
    // Leben, und der Test misst die Rahmenaufteilung statt den schwachen
    // Verweis (gc.fi::gc_stapel_saeubern).
    gc_stack_clean()
    gc_collect()
    if dom_observer_lives(beo, 1) {
        return 6
    }
    // Der Beobachter selbst lebt weiter — nur sein Ziel ist fort.
    if beo.hit != 0 {
        return 7
    }
    return 0
}

// Lebt das Ziel des Beobachters noch? Die Antwort ist ein `bool` — und das ist
// keine Kosmetik: wuerde hier ein `Gc[Node]` zurueckgegeben, laege der starke
// Zeiger in einer Rahmenzelle des LEBENDEN Aufrufers, und der konservative
// Scan muesste ihn als Wurzel behandeln. Die Frage wuerde ihre eigene Antwort
// veraendern. Nachgemessen: mit `stark(b.ziel)` unmittelbar im Aufrufer faellt
// die Pruefung unter `--no-opt` durch, mit dieser Fassung besteht sie in allen
// drei Baustufen.
//
// Der Selbstaufruf haelt die Funktion aus dem Einbetter heraus (inline.rs) —
// eingebettet laege der starke Zeiger wieder im lebenden Rahmen.
fn dom_observer_lives(b: Gc[Observer], depth: u64) -> bool {
    if depth > 0 {
        return dom_observer_lives(b, depth - 1)
    }
    return strong(b.target) != gc_null[Node]()
}

// Legt ein Ziel an, das NUR schwach beobachtet wird: der starke Zeiger lebt
// ausschliesslich im Rahmen dieser Funktion.
// Der Selbstaufruf haelt die Funktion aus dem Einbetter heraus (inline.rs,
// Runde 49): eingebettet lagen `ziel` und `b` in Rahmenplaetzen des LEBENDEN
// Aufrufers `dom_observer_test`, und der konservative Scan hielt das Ziel
// damit am Leben — der Test haette dann die Rahmenaufteilung gemessen statt
// den schwachen Verweis.
fn dom_observer_create(out: *mut Gc[Observer]) -> i32 {
    return dom_observer_create_t(out, 1)
}

fn dom_observer_create_t(out: *mut Gc[Observer], depth: u64) -> i32 {
    if depth > 0 {
        return dom_observer_create_t(out, depth - 1)
    }
    let target = dom_node_new(77, DOM_KIND_NODE) catch gc_null[Node]()
    if target == gc_null[Node]() {
        return 1
    }
    let b = dom_observer_new(target) catch gc_null[Observer]()
    if b == gc_null[Observer]() {
        return 2
    }
    if strong(b.target) != target {
        return 3
    }
    *out = b
    return 0
}
