// lib/dom/soak_leak.fi — GEGENPROBE zum Dauerlauf: derselbe DOM-Zyklensatz,
// aber mit ZAEHLVERWEISEN statt `Gc[T]`.
//
// Diese Fassung MUSS lecken. Sie ist der Beweis, dass die Messung in
// tools/dom_soak/run.sh ueberhaupt etwas misst: bleibt sie gruen, ist das
// Messverfahren kaputt und run.sh bricht ab. Ein Dauerlauf, der nur die
// gewuenschte Fassung prueft, ist keine Messung, sondern eine Behauptung.
//
// Selbst enthalten: eigener Zaehlverweis-Halde ueber mmap(2), KEIN `import`
// von lib/rc und KEINE gc-Klasse — damit die Sammler-Laufzeit gar nicht erst
// eingezogen wird (compiler/src/modules.rs zieht sie nur bei `gc class`).
// Verglichen werden so wirklich zwei Speichermodelle.
//
// Der Zaehler ist KORREKT: azyklischer Muell wird sehr wohl freigegeben (die
// Sammlung im Satz hat keinen Rueckverweis und verschwindet jedes Mal). Nur
// die Zyklen bleiben — genau der Fall, an dem Gecko den Zyklensammler
// nachruesten musste und den DESIGNZIELE/SPEC §3.5 als Grund fuer den
// Tracing-GC nennen.
//
// Objektaufbau (128 Byte, Runde 53). Der Satz bildet den GC-Satz aus
// lib/dom/dom.fi OBJEKT FUER OBJEKT nach — auch die Sammlungen und ihre
// Slot-Puffer, sonst waeren nicht mehr dieselben zwei Graphen verglichen:
//   [0]   Zaehler
//   [8]   eltern        [16]  kinderliste   [24]  puffer der kinderliste
//   [32]  element 0     [40]  element 1     [48]  element 2
//   [56]  listenerliste [64]  wrapper       [72]  wurzel
//   [80]  ziel          [88]  attrtabelle   [96]  attrwert (Str)
//   [104] naechstes     [112] reserviert    [120] Freiliste-Verkettung
// Alle Spalten von [8] bis [112] sind VERWEISE und werden beim Freigeben
// generisch losgelassen — deshalb kostet eine neue Spalte hier keine neue
// Zeile in `lk_lassen`.

import meas

const BUDGET_MS: i64 = 600000  // SOAK_BUDGET_MS
const ZYKLEN_MAX: i64 = 100000000  // SOAK_ZYKLEN_MAX
const STICHPROBE: i64 = 1000  // SOAK_STICHPROBE

const SYS_MMAP: i64 = 9
const PROT_RW: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34

const OBJ_BYTES: u64 = 128
const CHUNK_BYTES: u64 = 1048576

// Zustandsblock der Halde
const H_CHUNKS: u64 = 0
const H_BUMP: u64 = 8
const H_ENDE: u64 = 16
const H_FREI: u64 = 24
const H_LEBENDE: u64 = 32
const H_BYTES: u64 = 40

// Objektfelder
const F_ZAEHLER: u64 = 0
const F_ELTERN: u64 = 8
const F_KINDER: u64 = 16
const F_PUFFER: u64 = 24
const F_E0: u64 = 32
const F_E1: u64 = 40
const F_E2: u64 = 48
const F_LISTENER: u64 = 56
const F_WRAPPER: u64 = 64
const F_WURZEL: u64 = 72
const F_ZIEL: u64 = 80
const F_ATTRS: u64 = 88
const F_WERT: u64 = 96
const F_NAECHST: u64 = 104
const F_FREI: u64 = 120
// Verweisspalten: [F_SLOT0, F_SLOT0 + F_SLOTS*8)
const F_SLOT0: u64 = 8
const F_SLOTS: u64 = 14

fn lk_ld(a: u64) -> u64 {
    return *(a as *mut u64)
}

fn lk_st(a: u64, v: u64) {
    *(a as *mut u64) = v
}

// Ohne feste Adresse, ohne MAP_FIXED; ein Fehlschlag ist sichtbar (0).
fn lk_mmap(n: u64) -> u64 {
    let len: u64 = (n + 4095) / 4096 * 4096
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_RW, MAP_PRIVATE_ANON, -1, 0)
    if r < 0 && r > -4096 {
        return 0
    }
    if r == 0 {
        return 0
    }
    return r as u64
}

fn lk_heap_new() -> u64 {
    return lk_mmap(64)
}

fn lk_chunk_new(h: u64) -> bool {
    let c: u64 = lk_mmap(CHUNK_BYTES)
    if c == 0 {
        return false
    }
    lk_st(c, lk_ld(h + H_CHUNKS))
    lk_st(h + H_CHUNKS, c)
    lk_st(h + H_BUMP, c + 64)
    lk_st(h + H_ENDE, c + CHUNK_BYTES)
    lk_st(h + H_BYTES, lk_ld(h + H_BYTES) + CHUNK_BYTES)
    return true
}

// Neues Objekt mit Zaehler 1 (die Referenz des Aufrufers). 0 = Speicher aus.
fn lk_alloc(h: u64) -> u64 {
    var o: u64 = lk_ld(h + H_FREI)
    if o != 0 {
        lk_st(h + H_FREI, lk_ld(o + F_FREI))
    } else {
        if lk_ld(h + H_BUMP) + OBJ_BYTES > lk_ld(h + H_ENDE) {
            if !lk_chunk_new(h) {
                return 0
            }
        }
        o = lk_ld(h + H_BUMP)
        lk_st(h + H_BUMP, o + OBJ_BYTES)
    }
    var i: u64 = 0
    while i < OBJ_BYTES {
        lk_st(o + i, 0)
        i = i + 8
    }
    lk_st(o + F_ZAEHLER, 1)
    lk_st(h + H_LEBENDE, lk_ld(h + H_LEBENDE) + 1)
    return o
}

fn lk_hold(o: u64) {
    if o == 0 {
        return
    }
    lk_st(o + F_ZAEHLER, lk_ld(o + F_ZAEHLER) + 1)
}

// Zaehler herunter; bei 0 die gehaltenen Verweise loslassen und den Block
// zurueckgeben. Genau das erreicht einen Zyklus NIE.
fn lk_let(h: u64, o: u64) {
    if o == 0 {
        return
    }
    let z: u64 = lk_ld(o + F_ZAEHLER)
    if z > 1 {
        lk_st(o + F_ZAEHLER, z - 1)
        return
    }
    lk_st(o + F_ZAEHLER, 0)
    // Erst ALLE Spalten sichern und nullen, dann loslassen: waehrend des
    // Loslassens kann dieses Objekt erneut betreten werden.
    var saved: [u64; 14] = [0; 14]
    var i: u64 = 0
    while i < F_SLOTS {
        saved[i as usize] = lk_ld(o + F_SLOT0 + i * 8)
        lk_st(o + F_SLOT0 + i * 8, 0)
        i = i + 1
    }
    i = 0
    while i < F_SLOTS {
        lk_let(h, saved[i as usize])
        i = i + 1
    }
    lk_st(o + F_FREI, lk_ld(h + H_FREI))
    lk_st(h + H_FREI, o)
    lk_st(h + H_LEBENDE, lk_ld(h + H_LEBENDE) - 1)
}

// Starke Zuweisung: erst halten, dann schreiben, dann das Alte loslassen.
fn lk_set(h: u64, o: u64, field: u64, value: u64) {
    let old: u64 = lk_ld(o + field)
    lk_hold(value)
    lk_st(o + field, value)
    lk_let(h, old)
}

// Ein vollstaendiger Zyklensatz, Aufbau OBJEKT FUER OBJEKT identisch zu
// dom.dom_zyklus_bauen() (Runde 53, 14 Objekte):
//   1 Wurzel
//   3 Attributtabelle + ihr Puffer + ein Wertobjekt (Str)
//   3 Kinder mit starkem Elternverweis
//   2 Kinderliste + ihr Puffer
//   3 Listenerliste + ihr Puffer + der Listener
//   1 Sammlung
//   1 Wrapper
// Liefert die Zahl der angelegten Objekte, 0 bei Speichermangel.
fn lk_set_build(h: u64) -> u64 {
    let root: u64 = lk_alloc(h)
    if root == 0 {
        return 0
    }

    // --- Attribute: Tabelle -> Puffer -> Wert (Zyklus 2 ohne Rueckverweis)
    let at: u64 = lk_alloc(h)
    if at == 0 {
        lk_let(h, root)
        return 0
    }
    lk_set(h, root, F_ATTRS, at)
    lk_let(h, at)
    let ap: u64 = lk_alloc(h)
    if ap == 0 {
        lk_let(h, root)
        return 0
    }
    lk_set(h, at, F_PUFFER, ap)
    lk_let(h, ap)
    let av: u64 = lk_alloc(h)
    if av == 0 {
        lk_let(h, root)
        return 0
    }
    lk_set(h, ap, F_WERT, av)
    lk_let(h, av)

    // --- Kinder: Wurzel -> Kinderliste -> Puffer -> Kind -> Wurzel.
    // Genau dieser Zyklus laeuft in der GC-Fassung ueber eine GcVec.
    let kl: u64 = lk_alloc(h)
    if kl == 0 {
        lk_let(h, root)
        return 0
    }
    lk_set(h, root, F_KINDER, kl)
    lk_let(h, kl)
    let kp: u64 = lk_alloc(h)
    if kp == 0 {
        lk_let(h, root)
        return 0
    }
    lk_set(h, kl, F_PUFFER, kp)
    lk_let(h, kp)
    var i: u64 = 0
    while i < 3 {
        let k: u64 = lk_alloc(h)
        if k == 0 {
            lk_let(h, root)
            return 0
        }
        lk_set(h, k, F_ELTERN, root)
        lk_set(h, kp, F_E0 + i * 8, k)
        lk_let(h, k)
        i = i + 1
    }

    // --- Listener: Wurzel -> Listenerliste -> Puffer -> Listener -> Wurzel
    let ll: u64 = lk_alloc(h)
    if ll == 0 {
        lk_let(h, root)
        return 0
    }
    lk_set(h, root, F_LISTENER, ll)
    lk_let(h, ll)
    let lp: u64 = lk_alloc(h)
    if lp == 0 {
        lk_let(h, root)
        return 0
    }
    lk_set(h, ll, F_PUFFER, lp)
    lk_let(h, lp)
    let l: u64 = lk_alloc(h)
    if l == 0 {
        lk_let(h, root)
        return 0
    }
    lk_set(h, l, F_ZIEL, root)
    lk_set(h, lp, F_E0, l)
    lk_let(h, l)

    // --- Sammlung: KEIN Rueckverweis, sie verschwindet gleich wieder.
    let s: u64 = lk_alloc(h)
    if s == 0 {
        lk_let(h, root)
        return 0
    }
    lk_set(h, s, F_WURZEL, root)
    lk_let(h, s)

    // --- Wrapper
    let w: u64 = lk_alloc(h)
    if w == 0 {
        lk_let(h, root)
        return 0
    }
    lk_set(h, w, F_ZIEL, root)
    lk_set(h, root, F_WRAPPER, w)
    lk_let(h, w)

    // Die letzte lokale Referenz auf die Wurzel wird abgegeben. Ein
    // Tracing-Sammler wuerde den ganzen Satz jetzt einsammeln; der Zaehler
    // kann es nicht: Kind haelt Eltern, Eltern halten ihre Kinderliste,
    // die Kinderliste haelt das Kind.
    lk_let(h, root)
    return 14
}

// Kopfzeile 1 des Protokolls
fn t_kopf1() {
    var t: [u8; 33] = [
        35, 32, 102, 105, 114, 110, 45, 100, 111, 109, 45, 115, 111, 97, 107,
        32, 118, 49, 32, 118, 97, 114, 105, 97, 110, 116, 101, 61, 108, 101,
        99, 107, 10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 33)
}
// Kopfzeile 2: die Spaltennamen
fn t_kopf2() {
    var t: [u8; 76] = [
        35, 32, 115, 112, 97, 108, 116, 101, 110, 58, 32, 116, 95, 109, 115,
        9, 122, 121, 107, 108, 101, 110, 9, 114, 115, 115, 95, 107, 105, 98,
        9, 108, 101, 98, 101, 110, 100, 101, 9, 115, 97, 109, 109, 101, 108,
        108, 97, 101, 117, 102, 101, 9, 104, 101, 97, 112, 95, 98, 121, 116,
        101, 115, 9, 112, 97, 117, 115, 101, 95, 109, 97, 120, 95, 110, 115,
        10,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 76)
}
// Schlusszeile, Teil 1
fn t_done() {
    var t: [u8; 16] = [
        35, 32, 102, 101, 114, 116, 105, 103, 32, 122, 121, 107, 108, 101, 110,
        61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 16)
}
// Schlusszeile, Teil 2
fn t_tms() {
    var t: [u8; 6] = [
        32, 116, 95, 109, 115, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 6)
}
// Schlusszeile, Teil 3
fn t_runs() {
    var t: [u8; 14] = [
        32, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 14)
}
// Schlusszeile, Teil 4
fn t_rss() {
    var t: [u8; 9] = [
        32, 114, 115, 115, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 9)
}
// Fehlerzeile
fn t_error() {
    var t: [u8; 14] = [
        35, 32, 102, 101, 104, 108, 101, 114, 32, 99, 111, 100, 101, 61,
    ]
    let p: u64 = (&t) as u64
    meas.meas_write(p, 14)
}

// Eine Datenzeile des Protokolls. Die Spalte `sammellaeufe` ist hier immer 0 —
// diese Fassung hat keinen Sammler. `rss_kib` ist NIE 0: genau daran wird das
// Leck sichtbar.
fn line(t_ms: u64, cycles: u64, rss: u64, live: u64, runs: u64, heap: u64, pause: u64) {
    meas.meas_u64(t_ms)
    meas.meas_tab()
    meas.meas_u64(cycles)
    meas.meas_tab()
    meas.meas_u64(rss)
    meas.meas_tab()
    meas.meas_u64(live)
    meas.meas_tab()
    meas.meas_u64(runs)
    meas.meas_tab()
    meas.meas_u64(heap)
    meas.meas_tab()
    meas.meas_u64(pause)
    meas.meas_nl()
}

fn err(code: u64) -> i32 {
    t_error()
    meas.meas_u64(code)
    meas.meas_nl()
    return code as i32
}

fn main() -> i32 {
    let h: u64 = lk_heap_new()
    if h == 0 {
        return err(2)
    }
    t_kopf1()
    t_kopf2()
    let rss0: u64 = meas.meas_rss_kib()
    if rss0 == 0 {
        return err(3)
    }
    let t0: u64 = meas.meas_now_ms()
    line(0, 0, rss0, lk_ld(h + H_LEBENDE), 0, lk_ld(h + H_BYTES), 0)

    var cycles: u64 = 0
    var since: i64 = 0
    var t: u64 = 0
    var run: bool = true
    while run {
        let n: u64 = lk_set_build(h)
        if n != 14 {
            return err(4)
        }
        cycles = cycles + 1
        since = since + 1
        if since >= STICHPROBE {
            since = 0
            t = meas.meas_now_ms() - t0
            let rss: u64 = meas.meas_rss_kib()
            if rss == 0 {
                return err(5)
            }
            line(t, cycles, rss, lk_ld(h + H_LEBENDE), 0, lk_ld(h + H_BYTES), 0)
            if t >= BUDGET_MS as u64 || cycles >= ZYKLEN_MAX as u64 {
                run = false
            }
        }
    }
    t_done()
    meas.meas_u64(cycles)
    t_tms()
    meas.meas_u64(t)
    t_runs()
    meas.meas_u64(0)
    t_rss()
    meas.meas_u64(meas.meas_rss_kib())
    meas.meas_nl()
    return 0
}
