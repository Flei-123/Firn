// lib/dom/mess.fi — Ausgabe, Zeit und Speicherverbrauch fuer den Dauerlauf.
//
// Reines Firn, KEINE gc-Klasse: dieses Modul wird auch von der absichtlich
// leckenden Vergleichsfassung (`soak_leck.fi`) benutzt, und dort darf die
// Sammler-Laufzeit gar nicht erst eingezogen werden. Nur so vergleicht die
// Messung wirklich zwei Speichermodelle und nicht zwei Programme mit
// unterschiedlicher Laufzeitausstattung.
//
// Stufe 0 hat keine Zeichenketten im Quelltext (SPEC §14.1). Text wird
// deshalb als Byte-Array geschrieben — unschoen, aber ehrlich: es steht nichts
// im Programm, was die Sprache nicht wirklich kann.

export {
    mess_schreib, mess_u64, mess_i64, mess_tab, mess_nl, mess_zeichen,
    mess_jetzt_ms, mess_rss_kib, mess_seitengroesse
}

const SYS_READ: i64 = 0
const SYS_WRITE: i64 = 1
const SYS_OPEN: i64 = 2
const SYS_CLOSE: i64 = 3
const SYS_CLOCK_GETTIME: i64 = 228
const CLOCK_MONOTONIC: i64 = 1

// x86_64-Linux: 4 KiB. Bewusst fest verdrahtet — `getpagesize` braeuchte
// entweder das auxv oder libc; beides hat Stufe 0 nicht.
fn mess_seitengroesse() -> u64 {
    return 4096
}

fn mess_schreib(p: u64, n: i64) {
    if n <= 0 {
        return
    }
    var geschrieben: i64 = 0
    while geschrieben < n {
        let r: i64 = syscall(SYS_WRITE, 1, (p + geschrieben as u64) as i64, n - geschrieben, 0, 0, 0)
        if r <= 0 {
            return
        }
        geschrieben = geschrieben + r
    }
}

fn mess_zeichen(c: u8) {
    var puf: [u8; 1] = [0; 1]
    puf[0] = c
    let p: u64 = (&puf) as u64
    mess_schreib(p, 1)
}

fn mess_tab() {
    mess_zeichen(9)
}

fn mess_nl() {
    mess_zeichen(10)
}

fn mess_u64(v: u64) {
    var puf: [u8; 24] = [0; 24]
    var i: usize = 24
    var x: u64 = v
    if x == 0 {
        i = i - 1
        puf[i] = 48
    }
    while x > 0 {
        i = i - 1
        puf[i] = (48 + x % 10) as u8
        x = x / 10
    }
    let p: u64 = (&puf) as u64
    mess_schreib(p + i as u64, (24 - i) as i64)
}

fn mess_i64(v: i64) {
    if v < 0 {
        mess_zeichen(45)
        mess_u64((0 - v) as u64)
        return
    }
    mess_u64(v as u64)
}

// Monotone Zeit in Millisekunden.
fn mess_jetzt_ms() -> u64 {
    var ts: [u64; 2] = [0; 2]
    let p: u64 = (&ts) as u64
    syscall(SYS_CLOCK_GETTIME, CLOCK_MONOTONIC, p as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

// Wirklich belegter Hauptspeicher in KiB: Feld 2 aus /proc/self/statm
// (resident pages) mal Seitengroesse. Das ist die Zahl, an der ein Leck
// sichtbar wird — unabhaengig davon, was die Laufzeit ueber sich selbst sagt.
// 0 bedeutet: nicht lesbar (der Aufrufer muss das als Fehler behandeln).
fn mess_rss_kib() -> u64 {
    var pfad: [u8; 20] = [
        47, 112, 114, 111, 99, 47, 115, 101, 108, 102, 47, 115, 116, 97, 116,
        109, 0, 0, 0, 0,
    ]
    var puf: [u8; 128] = [0; 128]
    let pp: u64 = (&pfad) as u64
    let fd: i64 = syscall(SYS_OPEN, pp as i64, 0, 0, 0, 0, 0)
    if fd < 0 {
        return 0
    }
    let bp: u64 = (&puf) as u64
    let n: i64 = syscall(SYS_READ, fd, bp as i64, 120, 0, 0, 0)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    if n <= 0 {
        return 0
    }
    let len: usize = n as usize
    // Feld 1 (Gesamtgroesse) ueberspringen, Feld 2 (resident) lesen.
    var i: usize = 0
    while i < len && puf[i] != 32 {
        i = i + 1
    }
    while i < len && puf[i] == 32 {
        i = i + 1
    }
    var wert: u64 = 0
    var stellen: u64 = 0
    while i < len && puf[i] >= 48 && puf[i] <= 57 {
        wert = wert * 10 + (puf[i] - 48) as u64
        stellen = stellen + 1
        i = i + 1
    }
    if stellen == 0 {
        return 0
    }
    return wert * mess_seitengroesse() / 1024
}
