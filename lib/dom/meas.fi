// SPDX-License-Identifier: GPL-2.0-only
// lib/dom/meas.fi -- output, time and memory consumption for the endurance run.
//
// Pure Firn, NO gc class: this module is used by the deliberately leaking
// comparison version (`soak_leak.fi`) too, and there the collector runtime
// must not be pulled in at all. Only that way does the measurement really
// compare two memory models and not two programs with different runtime
// equipment.
//
// Stage 0 has no strings in the source text (SPEC 14.1). Text is therefore
// written as a byte array -- ugly, but honest: nothing stands in the program
// that the language cannot really do.

export {
    meas_write, meas_u64, meas_i64, meas_tab, meas_nl, meas_char,
    meas_now_ms, meas_rss_kib, meas_page_size
}

const SYS_READ: i64 = 0
const SYS_WRITE: i64 = 1
const SYS_OPEN: i64 = 2
const SYS_CLOSE: i64 = 3
const SYS_CLOCK_GETTIME: i64 = 228
const CLOCK_MONOTONIC: i64 = 1

// x86_64 Linux: 4 KiB. Hard wired deliberately -- `getpagesize` would need
// either the auxv or libc; stage 0 has neither.
fn meas_page_size() -> u64 {
    return 4096
}

fn meas_write(p: u64, n: i64) {
    if n <= 0 {
        return
    }
    var written: i64 = 0
    while written < n {
        let r: i64 = syscall(SYS_WRITE, 1, (p + written as u64) as i64, n - written, 0, 0, 0)
        if r <= 0 {
            return
        }
        written = written + r
    }
}

fn meas_char(c: u8) {
    var buf: [u8; 1] = [0; 1]
    buf[0] = c
    let p: u64 = (&buf) as u64
    meas_write(p, 1)
}

fn meas_tab() {
    meas_char(9)
}

fn meas_nl() {
    meas_char(10)
}

fn meas_u64(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var i: usize = 24
    var x: u64 = v
    if x == 0 {
        i = i - 1
        buf[i] = 48
    }
    while x > 0 {
        i = i - 1
        buf[i] = (48 + x % 10) as u8
        x = x / 10
    }
    let p: u64 = (&buf) as u64
    meas_write(p + i as u64, (24 - i) as i64)
}

fn meas_i64(v: i64) {
    if v < 0 {
        meas_char(45)
        meas_u64((0 - v) as u64)
        return
    }
    meas_u64(v as u64)
}

// Monotonic time in milliseconds.
fn meas_now_ms() -> u64 {
    var ts: [u64; 2] = [0; 2]
    let p: u64 = (&ts) as u64
    syscall(SYS_CLOCK_GETTIME, CLOCK_MONOTONIC, p as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

// The main memory really in use in KiB: field 2 of /proc/self/statm
// (resident pages) times the page size. That is the number a leak becomes
// visible in -- independently of what the runtime says about itself.
// 0 means: not readable (the caller has to treat that as an error).
fn meas_rss_kib() -> u64 {
    var path: [u8; 17] = "/proc/self/statm\0"
    var buf: [u8; 128] = [0; 128]
    let pp: u64 = (&path) as u64
    let fd: i64 = syscall(SYS_OPEN, pp as i64, 0, 0, 0, 0, 0)
    if fd < 0 {
        return 0
    }
    let bp: u64 = (&buf) as u64
    let n: i64 = syscall(SYS_READ, fd, bp as i64, 120, 0, 0, 0)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    if n <= 0 {
        return 0
    }
    let len: usize = n as usize
    // Skip field 1 (the total size), read field 2 (resident).
    var i: usize = 0
    while i < len && buf[i] != 32 {
        i = i + 1
    }
    while i < len && buf[i] == 32 {
        i = i + 1
    }
    var value: u64 = 0
    var digits: u64 = 0
    while i < len && buf[i] >= 48 && buf[i] <= 57 {
        value = value * 10 + (buf[i] - 48) as u64
        digits = digits + 1
        i = i + 1
    }
    if digits == 0 {
        return 0
    }
    return value * meas_page_size() / 1024
}
