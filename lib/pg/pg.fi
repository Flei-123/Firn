// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.net
import std.md5
import tls.tls
import tls.x509
import pg.pgscram
import pg.pgwire as w

export {
    Pg, PgResult, PgParams,
    pg_new, pg_free, pg_connect, pg_is_open, pg_close,
    pg_query, pg_query_params, pg_prepare, pg_exec_prepared, pg_deallocate,
    pg_error, pg_error_code, pg_txn_status,
    result_new, result_free, result_nrows, result_ncols, result_col_name, result_col_oid,
    result_value, result_tag,
    params_new, params_free, params_clear, params_text, params_null,
    TLS_OFF, TLS_REQUIRE,
}

const TLS_OFF: u32 = 0
const TLS_REQUIRE: u32 = 1
const READ_CHUNK: usize = 16384
const MAX_MESSAGE: usize = 268435456

struct Pg {
    conn: net.Conn,
    secure: bool,
    t: tls.Tls,
    store: x509.Store,
    inb: rt.Buf,
    inpos: usize,
    out: rt.Buf,
    open: bool,
    txn: u8,
    err: rt.Buf,
    code: [u8; 5],
    scram: pgscram.Scram,
}

struct PgResult {
    ncols: usize,
    nrows: usize,
    names: rt.Buf,
    oids: rt.Buf,
    data: rt.Buf,
    rows: rt.Buf,
    tag: rt.Buf,
}

struct PgParams {
    count: usize,
    data: rt.Buf,
}

fn pg_new() -> Pg {
    return Pg { conn: net.conn_from_fd(0 - 1), secure: false, t: tls.tls_new(),
        store: x509.store_new(), inb: rt.buf_new(), inpos: 0, out: rt.buf_new(),
        open: false, txn: 73 as u8, err: rt.buf_new(), code: [48; 5],
        scram: pgscram.scram_new() }
}

fn pg_free(c: *mut Pg) {
    if (*c).secure { tls.tls_free(&(*c).t) }
    x509.store_free(&(*c).store)
    pgscram.scram_free(&(*c).scram)
    rt.buf_free(&(*c).inb)
    rt.buf_free(&(*c).out)
    rt.buf_free(&(*c).err)
    if net.conn_is_open(&(*c).conn) { net.close(&(*c).conn) }
}

fn pg_is_open(c: *mut Pg) -> bool { return (*c).open }
fn pg_txn_status(c: *mut Pg) -> u8 { return (*c).txn }
fn pg_error(c: *mut Pg) -> str { return rt.buf_str(&(*c).err) }
fn pg_error_code(c: *mut Pg) -> u64 { return (&(*c).code[0]) as u64 }

fn result_new() -> PgResult {
    return PgResult { ncols: 0, nrows: 0, names: rt.buf_new(), oids: rt.buf_new(),
        data: rt.buf_new(), rows: rt.buf_new(), tag: rt.buf_new() }
}

fn result_clear(r: *mut PgResult) {
    (*r).ncols = 0
    (*r).nrows = 0
    rt.buf_clear(&(*r).names)
    rt.buf_clear(&(*r).oids)
    rt.buf_clear(&(*r).data)
    rt.buf_clear(&(*r).rows)
}

fn result_free(r: *mut PgResult) {
    rt.buf_free(&(*r).names)
    rt.buf_free(&(*r).oids)
    rt.buf_free(&(*r).data)
    rt.buf_free(&(*r).rows)
    rt.buf_free(&(*r).tag)
}

fn result_nrows(r: *mut PgResult) -> usize { return (*r).nrows }
fn result_ncols(r: *mut PgResult) -> usize { return (*r).ncols }
fn result_tag(r: *mut PgResult) -> str { return rt.buf_str(&(*r).tag) }

fn result_col_oid(r: *mut PgResult, col: usize) -> u32 {
    return rt.ld32((*r).oids.ptr, col)
}

fn result_col_name(r: *mut PgResult, col: usize) -> str {
    var at: usize = 0
    var i: usize = 0
    while i < col {
        while rt.ld8((*r).names.ptr, at) != 0 as u8 { at = at + 1 }
        at = at + 1
        i = i + 1
    }
    var e: usize = at
    while rt.ld8((*r).names.ptr, e) != 0 as u8 { e = e + 1 }
    return str { p: ((*r).names.ptr + at as u64) as *mut u8, n: e - at }
}

fn result_value(r: *mut PgResult, row: usize, col: usize, p: *mut u64, n: *mut usize) -> bool {
    if row >= (*r).nrows || col >= (*r).ncols { return false }
    let at: usize = rt.ld32((*r).rows.ptr, row * (*r).ncols + col) as usize
    let len: u32 = rt.ld32((*r).data.ptr + at as u64, 0)
    if len == 4294967295 as u32 { return false }
    *p = (*r).data.ptr + (at + 4) as u64
    *n = len as usize
    return true
}

fn params_new() -> PgParams {
    return PgParams { count: 0, data: rt.buf_new() }
}

fn params_free(q: *mut PgParams) { rt.buf_free(&(*q).data) }

fn params_clear(q: *mut PgParams) {
    (*q).count = 0
    rt.buf_clear(&(*q).data)
}

fn params_text(q: *mut PgParams, p: u64, n: usize) {
    w.put_i32(&(*q).data, n as u32)
    rt.buf_push_bytes(&(*q).data, p, n)
    (*q).count = (*q).count + 1
}

fn params_null(q: *mut PgParams) {
    w.put_i32(&(*q).data, 4294967295 as u32)
    (*q).count = (*q).count + 1
}

fn raw_write(c: *mut Pg, p: u64, n: usize) -> bool {
    if (*c).secure {
        let ok: bool = tls.tls_write(&(*c).t, p, n) catch false
        return ok
    }
    let k: usize = net.write_all(&(*c).conn, p, n) catch 0
    return k == n
}

fn flush_out(c: *mut Pg) -> bool {
    let ok: bool = raw_write(c, (*c).out.ptr, (*c).out.len)
    rt.buf_clear(&(*c).out)
    if !ok { (*c).open = false }
    return ok
}

fn fill(c: *mut Pg) -> bool {
    if (*c).inpos > 0 && (*c).inpos == (*c).inb.len {
        rt.buf_clear(&(*c).inb)
        (*c).inpos = 0
    }
    let have: usize = (*c).inb.len
    rt.buf_reserve(&(*c).inb, have + READ_CHUNK)
    var k: usize = 0
    if (*c).secure {
        k = tls.tls_read(&(*c).t, (*c).inb.ptr + have as u64, READ_CHUNK) catch 0
    } else {
        k = net.read(&(*c).conn, (*c).inb.ptr + have as u64, READ_CHUNK) catch 0
    }
    if k == 0 { return false }
    rt.buf_set_len(&(*c).inb, have + k)
    return true
}

fn need(c: *mut Pg, n: usize) -> bool {
    while (*c).inb.len - (*c).inpos < n {
        if !fill(c) { return false }
    }
    return true
}

fn set_error(c: *mut Pg, msg: str) {
    rt.buf_clear(&(*c).err)
    rt.buf_push_bytes(&(*c).err, msg.p as u64, msg.n)
}

fn read_message(c: *mut Pg, kind: *mut u8, p: *mut u64, n: *mut usize) -> bool {
    if (*c).inpos > 0 && (*c).inpos == (*c).inb.len {
        rt.buf_clear(&(*c).inb)
        (*c).inpos = 0
    }
    if !need(c, 5) {
        (*c).open = false
        return false
    }
    let base: u64 = (*c).inb.ptr + (*c).inpos as u64
    let len: usize = w.be32(base, 1) as usize
    if len < 4 || len > MAX_MESSAGE {
        (*c).open = false
        return false
    }
    if !need(c, 1 + len) {
        (*c).open = false
        return false
    }
    let at: u64 = (*c).inb.ptr + (*c).inpos as u64
    *kind = rt.ld8(at, 0)
    *p = at + 5
    *n = len - 4
    (*c).inpos = (*c).inpos + 1 + len
    return true
}

fn parse_error(c: *mut Pg, p: u64, n: usize) {
    rt.buf_clear(&(*c).err)
    var i: usize = 0
    var msg: usize = 0
    var msg_len: usize = 0
    var sev: usize = 0
    var sev_len: usize = 0
    while i < n && rt.ld8(p, i) != 0 as u8 {
        let f: u8 = rt.ld8(p, i)
        var e: usize = i + 1
        while e < n && rt.ld8(p, e) != 0 as u8 { e = e + 1 }
        if f == 67 as u8 && e - i - 1 == 5 { rt.mem_copy((&(*c).code[0]) as u64, p + (i + 1) as u64, 5) }
        if f == 77 as u8 {
            msg = i + 1
            msg_len = e - i - 1
        }
        if f == 83 as u8 {
            sev = i + 1
            sev_len = e - i - 1
        }
        i = e + 1
    }
    rt.buf_push_bytes(&(*c).err, p + sev as u64, sev_len)
    rt.buf_push(&(*c).err, 58 as u8)
    rt.buf_push(&(*c).err, 32 as u8)
    rt.buf_push_bytes(&(*c).err, p + msg as u64, msg_len)
}

fn send_password(c: *mut Pg, body: u64, n: usize) -> bool {
    let m: usize = w.begin(&(*c).out, 112 as u8)
    rt.buf_push_bytes(&(*c).out, body, n)
    w.finish(&(*c).out, m)
    return flush_out(c)
}

fn auth_md5(c: *mut Pg, user: str, password: str, salt: u64) -> bool {
    var inner: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&inner, password.p as u64, password.n)
    rt.buf_push_bytes(&inner, user.p as u64, user.n)
    var d: [u8; 16] = [0; 16]
    md5.md5(inner.ptr, inner.len, (&d[0]) as u64)
    rt.buf_free(&inner)
    var hex1: rt.Buf = rt.buf_new()
    w.put_hex(&hex1, (&d[0]) as u64, 16)
    rt.buf_push_bytes(&hex1, salt, 4)
    md5.md5(hex1.ptr, hex1.len, (&d[0]) as u64)
    rt.buf_free(&hex1)
    var msg: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&msg, "md5".p as u64, 3)
    w.put_hex(&msg, (&d[0]) as u64, 16)
    rt.buf_push(&msg, 0 as u8)
    let ok: bool = send_password(c, msg.ptr, msg.len)
    rt.buf_free(&msg)
    return ok
}

fn auth_sasl(c: *mut Pg) -> bool {
    var first: rt.Buf = rt.buf_new()
    if !pgscram.scram_first(&(*c).scram, &first) {
        rt.buf_free(&first)
        return false
    }
    let mech: str = "SCRAM-SHA-256"
    let m: usize = w.begin(&(*c).out, 112 as u8)
    w.put_cstr(&(*c).out, mech)
    w.put_i32(&(*c).out, first.len as u32)
    rt.buf_push_bytes(&(*c).out, first.ptr, first.len)
    w.finish(&(*c).out, m)
    rt.buf_free(&first)
    return flush_out(c)
}

fn auth_step(c: *mut Pg, user: str, password: str, p: u64, n: usize) -> bool {
    let code: u32 = w.be32(p, 0)
    if code == 0 { return true }
    if code == 3 {
        var msg: rt.Buf = rt.buf_new()
        w.put_cstr(&msg, password)
        let ok: bool = send_password(c, msg.ptr, msg.len)
        rt.buf_free(&msg)
        return ok
    }
    if code == 5 && n >= 8 { return auth_md5(c, user, password, p + 4) }
    if code == 10 { return auth_sasl(c) }
    if code == 11 {
        var fin: rt.Buf = rt.buf_new()
        let ok: bool = pgscram.scram_final(&(*c).scram, password.p as u64, password.n, p + 4, n - 4, &fin)
        if !ok {
            rt.buf_free(&fin)
            set_error(c, "SCRAM: invalid server-first-message")
            return false
        }
        let sent: bool = send_password(c, fin.ptr, fin.len)
        rt.buf_free(&fin)
        return sent
    }
    if code == 12 {
        if !pgscram.scram_verify(&(*c).scram, p + 4, n - 4) {
            set_error(c, "SCRAM: server signature mismatch")
            return false
        }
        return true
    }
    set_error(c, "unsupported authentication method")
    return false
}

fn startup_loop(c: *mut Pg, user: str, password: str) -> bool {
    while true {
        var kind: u8 = 0
        var p: u64 = 0
        var n: usize = 0
        if !read_message(c, &kind, &p, &n) {
            set_error(c, "connection closed during startup")
            return false
        }
        if kind == 69 as u8 {
            parse_error(c, p, n)
            return false
        }
        if kind == 82 as u8 {
            if n < 4 || !auth_step(c, user, password, p, n) {
                if (*c).err.len == 0 { set_error(c, "authentication failed") }
                return false
            }
        } else if kind == 90 as u8 {
            if n >= 1 { (*c).txn = rt.ld8(p, 0) }
            (*c).open = true
            return true
        }
    }
    return false
}

fn open_tcp(c: *mut Pg, addr: u32, port: u16) -> bool {
    var err: i64 = 0
    (*c).conn = net.connect_tcp_err(addr, port, &err) catch net.conn_from_fd(0 - 1)
    if !net.conn_is_open(&(*c).conn) {
        set_error(c, "tcp connect failed")
        return false
    }
    let nd: bool = net.set_no_delay(&(*c).conn, true) catch false
    return true
}

fn start_tls(c: *mut Pg, host: str, roots: u64, rn: usize, now: u64) -> bool {
    w.put_i32(&(*c).out, 8)
    w.put_i32(&(*c).out, 80877103)
    if !flush_out(c) { return false }
    var b: [u8; 1] = [0; 1]
    let k: usize = net.read(&(*c).conn, (&b[0]) as u64, 1) catch 0
    if k != 1 || b[0] != 83 as u8 {
        set_error(c, "server refused TLS")
        return false
    }
    x509.store_load_pem(&(*c).store, roots, rn)
    if !tls.tls_init(&(*c).t, &(*c).conn, &(*c).store, host.p as u64, host.n, now) {
        set_error(c, "tls init failed")
        return false
    }
    (*c).secure = true
    let ok: bool = tls.tls_handshake(&(*c).t) catch false
    if !ok { set_error(c, "tls handshake failed") }
    return ok
}

fn pg_connect(c: *mut Pg, addr: u32, port: u16, user: str, password: str, database: str,
    tls_mode: u32, host: str, roots: u64, rn: usize, now: u64) -> bool {
    rt.buf_clear(&(*c).err)
    if !open_tcp(c, addr, port) { return false }
    if tls_mode == TLS_REQUIRE && !start_tls(c, host, roots, rn, now) { return false }
    w.startup(&(*c).out, user, database)
    if !flush_out(c) {
        set_error(c, "write failed")
        return false
    }
    return startup_loop(c, user, password)
}

fn pg_close(c: *mut Pg) {
    if (*c).open {
        let m: usize = w.begin(&(*c).out, 88 as u8)
        w.finish(&(*c).out, m)
        flush_out(c)
    }
    (*c).open = false
}

fn on_row_description(r: *mut PgResult, p: u64, n: usize) -> bool {
    result_clear(r)
    if n < 2 { return false }
    let cols: usize = w.be16(p, 0) as usize
    var at: usize = 2
    var i: usize = 0
    while i < cols {
        var e: usize = at
        while e < n && rt.ld8(p, e) != 0 as u8 { e = e + 1 }
        if e + 19 > n { return false }
        rt.buf_push_bytes(&(*r).names, p + at as u64, e - at)
        rt.buf_push(&(*r).names, 0 as u8)
        w.put_u32le(&(*r).oids, w.be32(p, e + 7))
        at = e + 19
        i = i + 1
    }
    (*r).ncols = cols
    return true
}

fn on_data_row(r: *mut PgResult, p: u64, n: usize) -> bool {
    if n < 2 || w.be16(p, 0) as usize != (*r).ncols { return false }
    var at: usize = 2
    var i: usize = 0
    while i < (*r).ncols {
        if at + 4 > n { return false }
        let len: u32 = w.be32(p, at)
        w.put_u32le(&(*r).rows, (*r).data.len as u32)
        w.put_u32le(&(*r).data, len)
        at = at + 4
        if len != 4294967295 as u32 {
            if at + len as usize > n { return false }
            rt.buf_push_bytes(&(*r).data, p + at as u64, len as usize)
            at = at + len as usize
        }
        i = i + 1
    }
    (*r).nrows = (*r).nrows + 1
    return true
}

fn collect(c: *mut Pg, r: *mut PgResult) -> bool {
    var failed: bool = false
    result_clear(r)
    rt.buf_clear(&(*r).tag)
    rt.buf_clear(&(*c).err)
    while true {
        var kind: u8 = 0
        var p: u64 = 0
        var n: usize = 0
        if !read_message(c, &kind, &p, &n) {
            set_error(c, "connection lost")
            return false
        }
        if kind == 90 as u8 {
            if n >= 1 { (*c).txn = rt.ld8(p, 0) }
            return !failed
        }
        if kind == 69 as u8 {
            parse_error(c, p, n)
            failed = true
        } else if kind == 84 as u8 {
            if !on_row_description(r, p, n) { return protocol_error(c) }
        } else if kind == 68 as u8 {
            if !on_data_row(r, p, n) { return protocol_error(c) }
        } else if kind == 67 as u8 {
            rt.buf_clear(&(*r).tag)
            var e: usize = 0
            while e < n && rt.ld8(p, e) != 0 as u8 { e = e + 1 }
            rt.buf_push_bytes(&(*r).tag, p, e)
        } else if kind == 71 as u8 || kind == 72 as u8 || kind == 87 as u8 {
            return protocol_error(c)
        }
    }
    return false
}

fn protocol_error(c: *mut Pg) -> bool {
    set_error(c, "protocol error")
    (*c).open = false
    return false
}

fn pg_query(c: *mut Pg, sql: str, r: *mut PgResult) -> bool {
    if !(*c).open { return false }
    let m: usize = w.begin(&(*c).out, 81 as u8)
    w.put_cstr(&(*c).out, sql)
    w.finish(&(*c).out, m)
    if !flush_out(c) { return false }
    return collect(c, r)
}

fn send_extended(c: *mut Pg, name: str, sql: str, parse: bool, q: *mut PgParams) -> bool {
    if parse { w.parse(&(*c).out, name, sql) }
    w.bind(&(*c).out, name, (*q).count, &(*q).data)
    w.describe_portal(&(*c).out)
    w.execute(&(*c).out)
    w.sync(&(*c).out)
    return flush_out(c)
}

fn pg_query_params(c: *mut Pg, sql: str, q: *mut PgParams, r: *mut PgResult) -> bool {
    if !(*c).open { return false }
    if !send_extended(c, "", sql, true, q) { return false }
    return collect(c, r)
}

fn pg_prepare(c: *mut Pg, name: str, sql: str) -> bool {
    if !(*c).open { return false }
    w.parse(&(*c).out, name, sql)
    w.sync(&(*c).out)
    if !flush_out(c) { return false }
    var r: PgResult = result_new()
    let ok: bool = collect(c, &r)
    result_free(&r)
    return ok
}

fn pg_exec_prepared(c: *mut Pg, name: str, q: *mut PgParams, r: *mut PgResult) -> bool {
    if !(*c).open { return false }
    if !send_extended(c, name, "", false, q) { return false }
    return collect(c, r)
}

fn pg_deallocate(c: *mut Pg, name: str) -> bool {
    if !(*c).open { return false }
    w.close_statement(&(*c).out, name)
    w.sync(&(*c).out)
    if !flush_out(c) { return false }
    var r: PgResult = result_new()
    let ok: bool = collect(c, &r)
    result_free(&r)
    return ok
}
