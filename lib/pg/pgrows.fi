// SPDX-License-Identifier: MPL-2.0
import std.rt
import pg.pgwire as w

export {
    PgResult, PgParams,
    result_new, result_clear, result_free, result_nrows, result_ncols, result_col_name,
    result_col_oid, result_value, result_tag,
    params_new, params_free, params_clear, params_text, params_null,
    on_row_description, on_data_row,
}

struct PgResult {
    ncols: usize,
    nrows: usize,
    names: rt.Buf,
    oids: rt.Buf,
    data: rt.Buf,
    rows: rt.Buf,
    tag: rt.Buf,
}

struct PgParams {
    count: usize,
    data: rt.Buf,
}

fn result_new() -> PgResult {
    return PgResult { ncols: 0, nrows: 0, names: rt.buf_new(), oids: rt.buf_new(),
        data: rt.buf_new(), rows: rt.buf_new(), tag: rt.buf_new() }
}

fn result_clear(r: *mut PgResult) {
    (*r).ncols = 0
    (*r).nrows = 0
    rt.buf_clear(&(*r).names)
    rt.buf_clear(&(*r).oids)
    rt.buf_clear(&(*r).data)
    rt.buf_clear(&(*r).rows)
}

fn result_free(r: *mut PgResult) {
    rt.buf_free(&(*r).names)
    rt.buf_free(&(*r).oids)
    rt.buf_free(&(*r).data)
    rt.buf_free(&(*r).rows)
    rt.buf_free(&(*r).tag)
}

fn result_nrows(r: *mut PgResult) -> usize { return (*r).nrows }

fn result_ncols(r: *mut PgResult) -> usize { return (*r).ncols }

fn result_tag(r: *mut PgResult) -> str { return rt.buf_str(&(*r).tag) }

fn result_col_oid(r: *mut PgResult, col: usize) -> u32 {
    return rt.ld32((*r).oids.ptr, col)
}

fn result_col_name(r: *mut PgResult, col: usize) -> str {
    var at: usize = 0
    var i: usize = 0
    while i < col {
        while rt.ld8((*r).names.ptr, at) != 0 as u8 { at = at + 1 }
        at = at + 1
        i = i + 1
    }
    var e: usize = at
    while rt.ld8((*r).names.ptr, e) != 0 as u8 { e = e + 1 }
    return str { p: ((*r).names.ptr + at as u64) as *mut u8, n: e - at }
}

fn result_value(r: *mut PgResult, row: usize, col: usize, p: *mut u64, n: *mut usize) -> bool {
    if row >= (*r).nrows || col >= (*r).ncols { return false }
    let at: usize = rt.ld32((*r).rows.ptr, row * (*r).ncols + col) as usize
    let len: u32 = rt.ld32((*r).data.ptr + at as u64, 0)
    if len == 4294967295 as u32 { return false }
    *p = (*r).data.ptr + (at + 4) as u64
    *n = len as usize
    return true
}

fn params_new() -> PgParams {
    return PgParams { count: 0, data: rt.buf_new() }
}

fn params_free(q: *mut PgParams) { rt.buf_free(&(*q).data) }

fn params_clear(q: *mut PgParams) {
    (*q).count = 0
    rt.buf_clear(&(*q).data)
}

fn params_text(q: *mut PgParams, p: u64, n: usize) {
    w.put_i32(&(*q).data, n as u32)
    rt.buf_push_bytes(&(*q).data, p, n)
    (*q).count = (*q).count + 1
}

fn params_null(q: *mut PgParams) {
    w.put_i32(&(*q).data, 4294967295 as u32)
    (*q).count = (*q).count + 1
}

fn on_row_description(r: *mut PgResult, p: u64, n: usize) -> bool {
    result_clear(r)
    if n < 2 { return false }
    let cols: usize = w.be16(p, 0) as usize
    var at: usize = 2
    var i: usize = 0
    while i < cols {
        var e: usize = at
        while e < n && rt.ld8(p, e) != 0 as u8 { e = e + 1 }
        if e + 19 > n { return false }
        rt.buf_push_bytes(&(*r).names, p + at as u64, e - at)
        rt.buf_push(&(*r).names, 0 as u8)
        w.put_u32le(&(*r).oids, w.be32(p, e + 7))
        at = e + 19
        i = i + 1
    }
    (*r).ncols = cols
    return true
}

fn on_data_row(r: *mut PgResult, p: u64, n: usize) -> bool {
    if n < 2 || w.be16(p, 0) as usize != (*r).ncols { return false }
    var at: usize = 2
    var i: usize = 0
    while i < (*r).ncols {
        if at + 4 > n { return false }
        let len: u32 = w.be32(p, at)
        w.put_u32le(&(*r).rows, (*r).data.len as u32)
        w.put_u32le(&(*r).data, len)
        at = at + 4
        if len != 4294967295 as u32 {
            if at + len as usize > n { return false }
            rt.buf_push_bytes(&(*r).data, p + at as u64, len as usize)
            at = at + len as usize
        }
        i = i + 1
    }
    (*r).nrows = (*r).nrows + 1
    return true
}
