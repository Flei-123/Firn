// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    begin, finish, put_i32, put_i16, put_u32le, put_hex, put_cstr, be32, be16,
    startup, parse, bind, describe_portal, execute, sync, close_statement,
}

const PROTOCOL_3_0: u32 = 196608

fn put_i32(out: *mut rt.Buf, v: u32) {
    rt.buf_push(out, ((v >> 24) & 255) as u8)
    rt.buf_push(out, ((v >> 16) & 255) as u8)
    rt.buf_push(out, ((v >> 8) & 255) as u8)
    rt.buf_push(out, (v & 255) as u8)
}

fn put_i16(out: *mut rt.Buf, v: u32) {
    rt.buf_push(out, ((v >> 8) & 255) as u8)
    rt.buf_push(out, (v & 255) as u8)
}

fn put_u32le(out: *mut rt.Buf, v: u32) {
    rt.buf_push(out, (v & 255) as u8)
    rt.buf_push(out, ((v >> 8) & 255) as u8)
    rt.buf_push(out, ((v >> 16) & 255) as u8)
    rt.buf_push(out, ((v >> 24) & 255) as u8)
}

fn put_hex(out: *mut rt.Buf, p: u64, n: usize) {
    let digits: str = "0123456789abcdef"
    var i: usize = 0
    while i < n {
        let b: u8 = rt.ld8(p, i)
        rt.buf_push(out, rt.ld8(digits.p as u64, (b >> 4) as usize))
        rt.buf_push(out, rt.ld8(digits.p as u64, (b & 15 as u8) as usize))
        i = i + 1
    }
}

fn put_cstr(out: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(out, s.p as u64, s.n)
    rt.buf_push(out, 0 as u8)
}

fn be32(p: u64, at: usize) -> u32 {
    return ((rt.ld8(p, at) as u32) << 24) | ((rt.ld8(p, at + 1) as u32) << 16)
    | ((rt.ld8(p, at + 2) as u32) << 8) | (rt.ld8(p, at + 3) as u32)
}

fn be16(p: u64, at: usize) -> u32 {
    return ((rt.ld8(p, at) as u32) << 8) | (rt.ld8(p, at + 1) as u32)
}

fn begin(out: *mut rt.Buf, kind: u8) -> usize {
    let at: usize = (*out).len
    rt.buf_push(out, kind)
    put_i32(out, 0)
    return at
}

fn finish(out: *mut rt.Buf, at: usize) {
    let len: usize = (*out).len - at - 1
    rt.st8((*out).ptr, at + 1, ((len >> 24) & 255) as u8)
    rt.st8((*out).ptr, at + 2, ((len >> 16) & 255) as u8)
    rt.st8((*out).ptr, at + 3, ((len >> 8) & 255) as u8)
    rt.st8((*out).ptr, at + 4, (len & 255) as u8)
}

fn startup(out: *mut rt.Buf, user: str, database: str) {
    let at: usize = (*out).len
    put_i32(out, 0)
    put_i32(out, PROTOCOL_3_0)
    put_cstr(out, "user")
    put_cstr(out, user)
    put_cstr(out, "database")
    put_cstr(out, database)
    put_cstr(out, "client_encoding")
    put_cstr(out, "UTF8")
    rt.buf_push(out, 0 as u8)
    let len: usize = (*out).len - at
    rt.st8((*out).ptr, at, ((len >> 24) & 255) as u8)
    rt.st8((*out).ptr, at + 1, ((len >> 16) & 255) as u8)
    rt.st8((*out).ptr, at + 2, ((len >> 8) & 255) as u8)
    rt.st8((*out).ptr, at + 3, (len & 255) as u8)
}

fn parse(out: *mut rt.Buf, name: str, sql: str) {
    let m: usize = begin(out, 80 as u8)
    put_cstr(out, name)
    put_cstr(out, sql)
    put_i16(out, 0)
    finish(out, m)
}

fn bind(out: *mut rt.Buf, name: str, count: usize, values: *mut rt.Buf) {
    let m: usize = begin(out, 66 as u8)
    put_cstr(out, "")
    put_cstr(out, name)
    put_i16(out, 0)
    put_i16(out, count as u32)
    rt.buf_push_bytes(out, (*values).ptr, (*values).len)
    put_i16(out, 0)
    finish(out, m)
}

fn describe_portal(out: *mut rt.Buf) {
    let m: usize = begin(out, 68 as u8)
    rt.buf_push(out, 80 as u8)
    put_cstr(out, "")
    finish(out, m)
}

fn execute(out: *mut rt.Buf) {
    let m: usize = begin(out, 69 as u8)
    put_cstr(out, "")
    put_i32(out, 0)
    finish(out, m)
}

fn sync(out: *mut rt.Buf) {
    let m: usize = begin(out, 83 as u8)
    finish(out, m)
}

fn close_statement(out: *mut rt.Buf, name: str) {
    let m: usize = begin(out, 67 as u8)
    rt.buf_push(out, 83 as u8)
    put_cstr(out, name)
    finish(out, m)
}
