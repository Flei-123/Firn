// lib/cuda/loader.fi -- cuda.loader: library names of the CUDA driver and NVRTC (Linux twin of loader.windows.fi).
export {
    driver_name, nvrtc_count, nvrtc_name, prepare,
}

fn driver_name() -> str {
    return "libcuda.so.1"
}

fn nvrtc_count() -> usize {
    return 5
}

fn nvrtc_name(i: usize) -> str {
    if i == 0 {
        return "libnvrtc.so.12"
    }
    if i == 1 {
        return "libnvrtc.so.13"
    }
    if i == 2 {
        return "libnvrtc.so"
    }
    if i == 3 {
        return "/usr/local/cuda/lib64/libnvrtc.so"
    }
    if i == 4 {
        return "/usr/lib/x86_64-linux-gnu/libnvrtc.so.12"
    }
    return ""
}

fn prepare(i: usize) {
}
