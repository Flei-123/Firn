// SPDX-License-Identifier: MPL-2.0
// lib/cuda/cutil.fi -- cuda.cutil: NUL-terminated string buffers for the C ABI of the CUDA libraries.
import std.rt
import std.str

export {
    put_str, put_u32, cstr_alloc, cstr_free,
}

fn put_str(buf: u64, off: usize, s: str) -> usize {
    let n: usize = s.length()
    var i: usize = 0
    while i < n {
        rt.st8(buf, off + i, s.chars(i))
        i = i + 1
    }
    return off + n
}

fn put_u32(buf: u64, off: usize, v: u32) -> usize {
    var digits: [u8; 10] = [0; 10]
    var n: usize = 0
    var x: u32 = v
    if x == 0 {
        rt.st8(buf, off, 48 as u8)
        return off + 1
    }
    while x > 0 {
        digits[n] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    var i: usize = 0
    while i < n {
        rt.st8(buf, off + i, digits[n - 1 - i])
        i = i + 1
    }
    return off + n
}

fn cstr_alloc(s: str) -> u64 {
    let n: usize = s.length()
    let p: u64 = rt.heap_alloc(n + 1)
    if p == 0 {
        return 0
    }
    put_str(p, 0, s)
    rt.st8(p, n, 0 as u8)
    return p
}

fn cstr_free(p: u64, n: usize) {
    if p != 0 {
        rt.heap_free(p, n + 1)
    }
}
