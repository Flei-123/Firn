// lib/cuda/driver.fi -- cuda.driver: NVIDIA CUDA Driver API through std.dynlib (nvcuda.dll / libcuda.so.1): context, device memory, copies, errors.
import std.rt
import std.dynlib as dl
import std.io as io
import cuda.loader as ldr

export {
    init, is_ready, lib, check, last_error, arch, device_name_into, info_line,
    alloc, free, upload, download, copy, memset32, sync, mem_free, mem_total,
    scratch_addr, proc,
}

const NSLOT: usize = 64
const S_LIB: usize = 0
const S_READY: usize = 1
const S_ERR: usize = 2
const S_CTX: usize = 3
const S_DEV: usize = 4
const S_ARCH: usize = 5
const S_SCRATCH: usize = 8
const F_BASE: usize = 16
const NFN: usize = 16

const F_INIT: usize = 16
const F_DEVICE_GET: usize = 17
const F_ATTR: usize = 18
const F_NAME: usize = 19
const F_RETAIN: usize = 20
const F_SET_CTX: usize = 21
const F_ALLOC: usize = 22
const F_FREE: usize = 23
const F_HTOD: usize = 24
const F_DTOH: usize = 25
const F_DTOD: usize = 26
const F_MEMSET32: usize = 27
const F_SYNC: usize = 28
const F_MEMINFO: usize = 29
const F_ERRNAME: usize = 30
const F_COUNT: usize = 31

static mut state_block: u64 = 0

fn blk() -> u64 {
    if state_block == 0 {
        state_block = rt.heap_alloc(NSLOT * 8)
    }
    return state_block
}

fn scratch_addr(k: usize) -> u64 {
    return blk() + ((S_SCRATCH + k) * 8) as u64
}

fn fname(i: usize) -> str {
    if i == 0 {
        return "cuInit"
    }
    if i == 1 {
        return "cuDeviceGet"
    }
    if i == 2 {
        return "cuDeviceGetAttribute"
    }
    if i == 3 {
        return "cuDeviceGetName"
    }
    if i == 4 {
        return "cuDevicePrimaryCtxRetain"
    }
    if i == 5 {
        return "cuCtxSetCurrent"
    }
    if i == 6 {
        return "cuMemAlloc_v2"
    }
    if i == 7 {
        return "cuMemFree_v2"
    }
    if i == 8 {
        return "cuMemcpyHtoD_v2"
    }
    if i == 9 {
        return "cuMemcpyDtoH_v2"
    }
    if i == 10 {
        return "cuMemcpyDtoD_v2"
    }
    if i == 11 {
        return "cuMemsetD32_v2"
    }
    if i == 12 {
        return "cuCtxSynchronize"
    }
    if i == 13 {
        return "cuMemGetInfo_v2"
    }
    if i == 14 {
        return "cuGetErrorName"
    }
    return "cuDeviceGetCount"
}

fn is_ready() -> bool {
    return rt.ld64(blk(), S_READY) != 0
}

fn lib() -> u64 {
    return rt.ld64(blk(), S_LIB)
}

fn proc(name: str) -> u64 {
    return dl.sym(rt.ld64(blk(), S_LIB), name)
}

fn last_error() -> i32 {
    return rt.ld64(blk(), S_ERR) as i32
}

fn arch() -> u32 {
    return rt.ld64(blk(), S_ARCH) as u32
}

fn report(code: u64, what: str) {
    io.eprint("cuda: ")
    io.eprint(what)
    io.eprint(" failed: ")
    let b: u64 = blk()
    let f: u64 = rt.ld64(b, F_ERRNAME)
    if f != 0 {
        rt.st64(b, S_SCRATCH, 0)
        dl.ci2(f, code, scratch_addr(0))
        let p: u64 = rt.ld64(b, S_SCRATCH)
        if p != 0 {
            io.eprint_c(p)
        }
    }
    io.eprint_line("")
}

fn check(r: u64, what: str) -> bool {
    let code: u64 = r & 4294967295
    if code == 0 {
        return true
    }
    rt.st64(blk(), S_ERR, code)
    report(code, what)
    return false
}

fn resolve_all(h: u64) -> bool {
    var i: usize = 0
    while i < NFN {
        let p: u64 = dl.sym(h, fname(i))
        if p == 0 {
            return false
        }
        rt.st64(blk(), F_BASE + i, p)
        i = i + 1
    }
    return true
}

fn init() -> bool {
    let b: u64 = blk()
    if rt.ld64(b, S_READY) != 0 {
        return true
    }
    let h: u64 = dl.open(ldr.driver_name())
    if h == 0 {
        return false
    }
    rt.st64(b, S_LIB, h)
    if !resolve_all(h) {
        return false
    }
    if !check(dl.ci1(rt.ld64(b, F_INIT), 0), "cuInit") {
        return false
    }
    rt.st64(b, S_SCRATCH, 0)
    if !check(dl.ci2(rt.ld64(b, F_COUNT), scratch_addr(0), 0), "cuDeviceGetCount") {
        return false
    }
    rt.st64(b, S_SCRATCH, 0)
    if !check(dl.ci2(rt.ld64(b, F_DEVICE_GET), scratch_addr(0), 0), "cuDeviceGet") {
        return false
    }
    let dev: u64 = rt.ld64(b, S_SCRATCH) & 4294967295
    rt.st64(b, S_DEV, dev)
    rt.st64(b, S_SCRATCH, 0)
    if !check(dl.ci2(rt.ld64(b, F_RETAIN), scratch_addr(0), dev), "cuDevicePrimaryCtxRetain") {
        return false
    }
    let ctx: u64 = rt.ld64(b, S_SCRATCH)
    rt.st64(b, S_CTX, ctx)
    if !check(dl.ci1(rt.ld64(b, F_SET_CTX), ctx), "cuCtxSetCurrent") {
        return false
    }
    rt.st64(b, S_SCRATCH, 0)
    rt.st64(b, S_SCRATCH + 1, 0)
    dl.ci3(rt.ld64(b, F_ATTR), scratch_addr(0), 75, dev)
    dl.ci3(rt.ld64(b, F_ATTR), scratch_addr(1), 76, dev)
    let major: u64 = rt.ld64(b, S_SCRATCH) & 4294967295
    let minor: u64 = rt.ld64(b, S_SCRATCH + 1) & 4294967295
    rt.st64(b, S_ARCH, major * 10 + minor)
    rt.st64(b, S_READY, 1)
    return true
}

fn device_name_into(buf: u64, cap: usize) -> bool {
    let b: u64 = blk()
    if rt.ld64(b, S_READY) == 0 {
        return false
    }
    return check(dl.ci3(rt.ld64(b, F_NAME), buf, cap as u64, rt.ld64(b, S_DEV)), "cuDeviceGetName")
}

fn mem_pair() -> bool {
    let b: u64 = blk()
    rt.st64(b, S_SCRATCH, 0)
    rt.st64(b, S_SCRATCH + 1, 0)
    return check(dl.ci2(rt.ld64(b, F_MEMINFO), scratch_addr(0), scratch_addr(1)), "cuMemGetInfo")
}

fn mem_free() -> u64 {
    if !mem_pair() {
        return 0
    }
    return rt.ld64(blk(), S_SCRATCH)
}

fn mem_total() -> u64 {
    if !mem_pair() {
        return 0
    }
    return rt.ld64(blk(), S_SCRATCH + 1)
}

fn info_line() {
    if !is_ready() {
        io.print_line("cuda: not initialized")
        return
    }
    let nb: u64 = rt.heap_alloc(256)
    if nb == 0 {
        return
    }
    io.print("cuda device: ")
    if device_name_into(nb, 255) {
        io.print_c(nb)
    }
    io.print_line("")
    rt.heap_free(nb, 256)
}

fn alloc(bytes: u64) -> u64 {
    let b: u64 = blk()
    rt.st64(b, S_SCRATCH, 0)
    if !check(dl.ci2(rt.ld64(b, F_ALLOC), scratch_addr(0), bytes), "cuMemAlloc") {
        return 0
    }
    return rt.ld64(b, S_SCRATCH)
}

fn free(p: u64) {
    if p != 0 {
        check(dl.ci1(rt.ld64(blk(), F_FREE), p), "cuMemFree")
    }
}

fn upload(dev: u64, host: u64, bytes: u64) -> bool {
    return check(dl.ci3(rt.ld64(blk(), F_HTOD), dev, host, bytes), "cuMemcpyHtoD")
}

fn download(host: u64, dev: u64, bytes: u64) -> bool {
    return check(dl.ci3(rt.ld64(blk(), F_DTOH), host, dev, bytes), "cuMemcpyDtoH")
}

fn copy(dst: u64, src: u64, bytes: u64) -> bool {
    return check(dl.ci3(rt.ld64(blk(), F_DTOD), dst, src, bytes), "cuMemcpyDtoD")
}

fn memset32(dev: u64, value: u32, count: u64) -> bool {
    return check(dl.ci3(rt.ld64(blk(), F_MEMSET32), dev, value as u64, count), "cuMemsetD32")
}

fn sync() -> bool {
    return check(dl.ci0(rt.ld64(blk(), F_SYNC)), "cuCtxSynchronize")
}
