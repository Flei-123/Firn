// lib/cuda/loader.windows.fi -- cuda.loader: DLL names of the CUDA driver and NVRTC on Windows (searches the default toolkit folders).
import std.dynlib as dl
import cuda.cutil as cx

export {
    driver_name, nvrtc_count, nvrtc_name, prepare,
}

fn driver_name() -> str {
    return "nvcuda.dll"
}

fn nvrtc_count() -> usize {
    return 11
}

fn toolkit(i: usize) -> str {
    if i == 1 {
        return "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.8\\bin"
    }
    if i == 2 {
        return "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.9\\bin"
    }
    if i == 3 {
        return "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.6\\bin"
    }
    if i == 4 {
        return "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.5\\bin"
    }
    if i == 5 {
        return "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.4\\bin"
    }
    if i == 6 {
        return "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.3\\bin"
    }
    if i == 7 {
        return "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.2\\bin"
    }
    if i == 8 {
        return "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.1\\bin"
    }
    if i == 9 {
        return "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v12.0\\bin"
    }
    if i == 10 {
        return "C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v13.0\\bin"
    }
    return ""
}

fn nvrtc_name(i: usize) -> str {
    if i == 0 {
        return "nvrtc64_120_0.dll"
    }
    if i == 10 {
        return "nvrtc64_130_0.dll"
    }
    return "nvrtc64_120_0.dll"
}

fn prepare(i: usize) {
    if i == 0 {
        return
    }
    let k: u64 = dl.open("kernel32.dll")
    let f: u64 = dl.sym(k, "SetDllDirectoryA")
    if f == 0 {
        return
    }
    let dir: str = toolkit(i)
    let p: u64 = cx.cstr_alloc(dir)
    if p == 0 {
        return
    }
    dl.ci1(f, p)
}
