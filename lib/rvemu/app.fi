// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.io
import std.vec
import rvemu.machine as mc
import rvemu.options as op
import rvemu.loader as ld
import rvemu.custom as cu
import rvemu.exec as ex
import rvemu.result as rs

export { app_main, apply_isa }

fn say(s: str) {
    io.eprint(s)
}

fn apply_isa(m: *mut mc.Machine, isa: str) -> bool {
    var i: usize = 4
    if isa.n < 5 || rt.ld8(isa.p as u64, 0) != 114 || rt.ld8(isa.p as u64, 1) != 118 {
        return false
    }
    while i < isa.n && rt.ld8(isa.p as u64, i) != 95 {
        let c: u8 = rt.ld8(isa.p as u64, i)
        if c == 109 || c == 77 {
            (*m).ext_m = true
        } else if c != 105 && c != 73 && c != 103 && c != 71 {
            return false
        }
        i = i + 1
    }
    return true
}

fn load_image(m: *mut mc.Machine, o: *mut op.Options) -> i32 {
    var data: rt.Buf = rt.buf_new()
    var path: u64 = (*o).elf
    if path == 0 {
        path = (*o).bin
    }
    if path == 0 {
        path = (*o).hex
    }
    if path == 0 || !rt.read_file(path, &data) {
        rt.buf_free(&data)
        return 100
    }
    var status: i32 = 0
    if (*o).elf != 0 {
        status = ld.load_elf(m, rt.buf_ptr(&data), rt.buf_len(&data))
    } else if (*o).bin != 0 {
        status = ld.load_bin(m, (*o).base, rt.buf_ptr(&data), rt.buf_len(&data))
    } else {
        status = ld.load_hex(m, (*o).base, rt.buf_ptr(&data), rt.buf_len(&data))
    }
    rt.buf_free(&data)
    return status
}

fn load_isa_json(m: *mut mc.Machine, path: u64) -> i32 {
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(path, &data) {
        rt.buf_free(&data)
        return 100
    }
    let status: i32 = cu.load_custom(m, rt.buf_ptr(&data), rt.buf_len(&data))
    rt.buf_free(&data)
    return status
}

fn configure(m: *mut mc.Machine, o: *mut op.Options) -> bool {
    var i: usize = 0
    while i < vec_len[op.RamSpec](&(*o).ram) {
        let r: *mut op.RamSpec = vec_elem_ptr[op.RamSpec](&(*o).ram, i)
        if !mc.add_ram(m, (*r).base, (*r).size) {
            say("rvemu: cannot allocate ram\n")
            return false
        }
        i = i + 1
    }
    if (*o).uart != 0 {
        (*m).uart_on = true
        (*m).uart_base = ((*o).uart & 4294967295) as u32
    }
    if (*o).finisher != 0 {
        (*m).fin_on = true
        (*m).fin_base = ((*o).finisher & 4294967295) as u32
    }
    (*m).pc = (*o).reset
    (*m).log_commits = (*o).commits != 0
    if !apply_isa(m, (*o).isa) {
        say("rvemu: unsupported --isa (supported: rv32i, rv32im, rv32ig)\n")
        return false
    }
    if (*o).isa_json != 0 && load_isa_json(m, (*o).isa_json) != 0 {
        say("rvemu: cannot load --isa-json\n")
        return false
    }
    return true
}

fn write_outputs(m: *mut mc.Machine, o: *mut op.Options) {
    if (*o).commits != 0 {
        rt.write_file((*o).commits, rt.buf_ptr(&(*m).commits), rt.buf_len(&(*m).commits))
    }
    if (*o).result != 0 {
        var b: rt.Buf = rt.buf_new()
        rs.result_json(m, &b)
        rt.write_file((*o).result, rt.buf_ptr(&b), rt.buf_len(&b))
        rt.buf_free(&b)
    }
}

fn app_main(start: u64) -> i32 {
    var o: op.Options = op.options_new()
    if !op.parse_options(start, &o) {
        say("rvemu: bad option ")
        say(o.bad_flag)
        say("\nusage: rvemu (--elf f | --bin f | --hex f) --ram base:size [--ram ...] [--base n] [--reset n] [--uart base] [--finisher base] [--max-instr n] [--isa rv32im] [--isa-json f] [--result f] [--commits f]\n")
        return 2
    }
    var m: mc.Machine = mc.machine_new()
    if !configure(&m, &o) {
        return 2
    }
    let loaded: i32 = load_image(&m, &o)
    if loaded != 0 {
        say("rvemu: cannot load program image\n")
        return 2
    }
    ex.run(&m, o.max_instr)
    write_outputs(&m, &o)
    var code: i32 = 1
    if m.status == mc.STATUS_EXIT {
        code = 0
    }
    mc.machine_free(&m)
    return code
}
