import std.rt
import std.vec
import rvemu.alu as alu

export { compile_semantics, eval_semantics }

const OP_NUM: u32 = 0
const OP_VAR: u32 = 1
const OP_NEG: u32 = 2
const OP_NOT: u32 = 3
const OP_BIN: u32 = 4
const OP_CALL: u32 = 5

const BIN_ADD: u32 = 0
const BIN_SUB: u32 = 1
const BIN_MUL: u32 = 2
const BIN_AND: u32 = 3
const BIN_OR: u32 = 4
const BIN_XOR: u32 = 5
const BIN_SHL: u32 = 6
const BIN_SHR: u32 = 7

const STACK_MAX: usize = 64

struct Parser {
    p: u64,
    n: usize,
    i: usize,
    ok: bool,
    code: *mut Vec[u32],
}

fn is_space(c: u32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13
}

fn is_digit(c: u32) -> bool {
    return c >= 48 && c <= 57
}

fn is_alpha(c: u32) -> bool {
    return (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95
}

fn skip(s: *mut Parser) {
    while (*s).i < (*s).n && is_space(rt.ld8((*s).p, (*s).i) as u32) {
        (*s).i = (*s).i + 1
    }
}

fn peek(s: *mut Parser) -> u32 {
    skip(s)
    if (*s).i >= (*s).n {
        return 0
    }
    return rt.ld8((*s).p, (*s).i) as u32
}

fn peek2(s: *mut Parser) -> u32 {
    if (*s).i + 1 >= (*s).n {
        return 0
    }
    return rt.ld8((*s).p, (*s).i + 1) as u32
}

fn emit(s: *mut Parser, op: u32, arg: u32) {
    vec_push[u32]((*s).code, op)
    vec_push[u32]((*s).code, arg)
}

fn fail(s: *mut Parser) {
    (*s).ok = false
}

fn binary_op(s: *mut Parser) -> i32 {
    let c: u32 = peek(s)
    if c == 43 {
        return BIN_ADD as i32
    }
    if c == 45 {
        return BIN_SUB as i32
    }
    if c == 42 {
        return BIN_MUL as i32
    }
    if c == 38 {
        return BIN_AND as i32
    }
    if c == 124 {
        return BIN_OR as i32
    }
    if c == 94 {
        return BIN_XOR as i32
    }
    if c == 60 && peek2(s) == 60 {
        return BIN_SHL as i32
    }
    if c == 62 && peek2(s) == 62 {
        return BIN_SHR as i32
    }
    return -1
}

fn op_level(op: u32) -> u32 {
    if op == BIN_OR {
        return 0
    }
    if op == BIN_XOR {
        return 1
    }
    if op == BIN_AND {
        return 2
    }
    if op == BIN_SHL || op == BIN_SHR {
        return 3
    }
    if op == BIN_ADD || op == BIN_SUB {
        return 4
    }
    return 5
}

fn function_id(s: *mut Parser, start: usize, n: usize) -> i32 {
    let names: [str; 18] = ["popcount", "clz", "ctz", "rotl", "rotr", "min", "max", "mins", "maxs", "sext8", "sext16", "zext8", "zext16", "sra", "abs", "mulh", "mulhu", "bswap"]
    var k: usize = 0
    while k < 18 {
        if names[k].n == n && rt.mem_eq(names[k].p as u64, (*s).p + (start as u64), n) {
            return k as i32
        }
        k = k + 1
    }
    return -1
}

fn function_arity(id: u32) -> usize {
    if id == 3 || id == 4 || id == 5 || id == 6 || id == 7 || id == 8 || id == 13 || id == 15 || id == 16 {
        return 2
    }
    return 1
}

fn number_literal(s: *mut Parser) {
    var v: u64 = 0
    var base: u64 = 10
    if rt.ld8((*s).p, (*s).i) == 48 && (*s).i + 1 < (*s).n {
        let x: u32 = peek2(s)
        if x == 120 || x == 88 {
            base = 16
            (*s).i = (*s).i + 2
        } else if x == 98 || x == 66 {
            base = 2
            (*s).i = (*s).i + 2
        }
    }
    var any: bool = false
    while (*s).i < (*s).n {
        let c: u32 = rt.ld8((*s).p, (*s).i) as u32
        var d: u64 = 99
        if is_digit(c) {
            d = (c - 48) as u64
        } else if base == 16 && c >= 97 && c <= 102 {
            d = (c - 87) as u64
        } else if base == 16 && c >= 65 && c <= 70 {
            d = (c - 55) as u64
        }
        if d >= base {
            break
        }
        v = (v *% base +% d) & 4294967295
        any = true
        (*s).i = (*s).i + 1
    }
    if !any {
        fail(s)
        return
    }
    emit(s, OP_NUM, v as u32)
}

fn variable_id(s: *mut Parser, start: usize, n: usize) -> i32 {
    if n == 3 && rt.ld8((*s).p, start) == 114 && rt.ld8((*s).p, start + 1) == 115 {
        let d: u8 = rt.ld8((*s).p, start + 2)
        if d == 49 {
            return 0
        }
        if d == 50 {
            return 1
        }
    }
    if n == 3 && rt.ld8((*s).p, start) == 105 && rt.ld8((*s).p, start + 1) == 109 && rt.ld8((*s).p, start + 2) == 109 {
        return 2
    }
    return -1
}

fn primary(s: *mut Parser) {
    let c: u32 = peek(s)
    if is_digit(c) {
        number_literal(s)
        return
    }
    if c == 40 {
        (*s).i = (*s).i + 1
        level(s, 0)
        if peek(s) != 41 {
            fail(s)
            return
        }
        (*s).i = (*s).i + 1
        return
    }
    if !is_alpha(c) {
        fail(s)
        return
    }
    let start: usize = (*s).i
    while (*s).i < (*s).n && (is_alpha(rt.ld8((*s).p, (*s).i) as u32) || is_digit(rt.ld8((*s).p, (*s).i) as u32)) {
        (*s).i = (*s).i + 1
    }
    let len: usize = (*s).i - start
    if peek(s) == 40 {
        let f: i32 = function_id(s, start, len)
        if f < 0 {
            fail(s)
            return
        }
        (*s).i = (*s).i + 1
        var count: usize = 0
        if peek(s) != 41 {
            level(s, 0)
            count = 1
            while peek(s) == 44 {
                (*s).i = (*s).i + 1
                level(s, 0)
                count = count + 1
            }
        }
        if peek(s) != 41 || count != function_arity(f as u32) {
            fail(s)
            return
        }
        (*s).i = (*s).i + 1
        emit(s, OP_CALL, f as u32)
        return
    }
    let v: i32 = variable_id(s, start, len)
    if v < 0 {
        fail(s)
        return
    }
    emit(s, OP_VAR, v as u32)
}

fn unary(s: *mut Parser) {
    let c: u32 = peek(s)
    if c == 45 || c == 126 {
        (*s).i = (*s).i + 1
        unary(s)
        if c == 45 {
            emit(s, OP_NEG, 0)
        } else {
            emit(s, OP_NOT, 0)
        }
        return
    }
    primary(s)
}

fn level(s: *mut Parser, n: u32) {
    if !(*s).ok {
        return
    }
    if n >= 6 {
        unary(s)
        return
    }
    level(s, n + 1)
    while (*s).ok {
        let op: i32 = binary_op(s)
        if op < 0 || op_level(op as u32) != n {
            break
        }
        if op == BIN_SHL as i32 || op == BIN_SHR as i32 {
            (*s).i = (*s).i + 2
        } else {
            (*s).i = (*s).i + 1
        }
        level(s, n + 1)
        emit(s, OP_BIN, op as u32)
    }
}

fn compile_semantics(text: str, code: *mut Vec[u32]) -> bool {
    var s: Parser = Parser { p: text.p as u64, n: text.n, i: 0, ok: true, code: code }
    skip(&s)
    if s.i + 1 < s.n && rt.ld8(s.p, s.i) == 114 && rt.ld8(s.p, s.i + 1) == 100 {
        var j: usize = s.i + 2
        while j < s.n && is_space(rt.ld8(s.p, j) as u32) {
            j = j + 1
        }
        if j < s.n && rt.ld8(s.p, j) == 61 && !(j + 1 < s.n && rt.ld8(s.p, j + 1) == 61) {
            s.i = j + 1
        }
    }
    level(&s, 0)
    if peek(&s) != 0 {
        s.ok = false
    }
    return s.ok && vec_len[u32](code) > 0
}

fn call_function(id: u32, a: u32, b: u32) -> u32 {
    if id == 0 {
        return alu.popcount(a)
    }
    if id == 1 {
        return alu.clz(a)
    }
    if id == 2 {
        return alu.ctz(a)
    }
    if id == 3 {
        return alu.rotl(a, b)
    }
    if id == 4 {
        return alu.rotr(a, b)
    }
    if id == 5 {
        if a < b {
            return a
        }
        return b
    }
    if id == 6 {
        if a > b {
            return a
        }
        return b
    }
    if id == 7 {
        return alu.min_signed(a, b)
    }
    if id == 8 {
        return alu.max_signed(a, b)
    }
    if id == 9 {
        return alu.sext8(a)
    }
    if id == 10 {
        return alu.sext16(a)
    }
    if id == 11 {
        return a & 255
    }
    if id == 12 {
        return a & 65535
    }
    if id == 13 {
        return alu.sra(a, b)
    }
    if id == 14 {
        return alu.abs32(a)
    }
    if id == 15 {
        return alu.mulh(a, b)
    }
    if id == 16 {
        return alu.mulhu(a, b)
    }
    return alu.bswap(a)
}

fn binary(op: u32, a: u32, b: u32) -> u32 {
    if op == BIN_ADD {
        return a +% b
    }
    if op == BIN_SUB {
        return a -% b
    }
    if op == BIN_MUL {
        return a *% b
    }
    if op == BIN_AND {
        return a & b
    }
    if op == BIN_OR {
        return a | b
    }
    if op == BIN_XOR {
        return a ^ b
    }
    if op == BIN_SHL {
        return a << (b & 31)
    }
    return a >> (b & 31)
}

fn eval_semantics(code: *mut Vec[u32], rs1: u32, rs2: u32, imm: u32) -> u32 {
    var stack: [u32; 64] = [0 as u32; 64]
    var sp: usize = 0
    var pc: usize = 0
    let n: usize = vec_len[u32](code)
    while pc + 1 < n {
        let op: u32 = vec_at[u32](code, pc)
        let arg: u32 = vec_at[u32](code, pc + 1)
        pc = pc + 2
        if op == OP_NUM {
            stack[sp] = arg
            sp = sp + 1
        } else if op == OP_VAR {
            if arg == 0 {
                stack[sp] = rs1
            } else if arg == 1 {
                stack[sp] = rs2
            } else {
                stack[sp] = imm
            }
            sp = sp + 1
        } else if op == OP_NEG {
            stack[sp - 1] = 0 -% stack[sp - 1]
        } else if op == OP_NOT {
            stack[sp - 1] = ~stack[sp - 1]
        } else if op == OP_BIN {
            sp = sp - 1
            stack[sp - 1] = binary(arg, stack[sp - 1], stack[sp])
        } else {
            if function_arity(arg) == 2 {
                sp = sp - 1
                stack[sp - 1] = call_function(arg, stack[sp - 1], stack[sp])
            } else {
                stack[sp - 1] = call_function(arg, stack[sp - 1], 0)
            }
        }
    }
    if sp == 0 {
        return 0
    }
    return stack[sp - 1]
}
