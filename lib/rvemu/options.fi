// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.vec

export { Options, RamSpec, options_new, parse_options, parse_number, arg_text }

struct RamSpec {
    base: u32,
    size: u32,
}

struct Options {
    elf: u64,
    bin: u64,
    hex: u64,
    base: u32,
    reset: u32,
    ram: Vec[RamSpec],
    uart: u64,
    finisher: u64,
    max_instr: u64,
    result: u64,
    commits: u64,
    isa_json: u64,
    isa: str,
    bad_flag: str,
}

fn options_new() -> Options {
    return Options {
        elf: 0,
        bin: 0,
        hex: 0,
        base: 2147483648 as u32,
        reset: 2147483648 as u32,
        ram: vec_new[RamSpec](),
        uart: 0,
        finisher: 0,
        max_instr: 100000000,
        result: 0,
        commits: 0,
        isa_json: 0,
        isa: "rv32i",
        bad_flag: "",
    }
}

fn arg_text(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    if p == 0 {
        return ""
    }
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn parse_number(s: str, out: *mut u64) -> bool {
    var v: u64 = 0
    var base: u64 = 10
    var i: usize = 0
    if s.n > 2 && rt.ld8(s.p as u64, 0) == 48 && (rt.ld8(s.p as u64, 1) == 120 || rt.ld8(s.p as u64, 1) == 88) {
        base = 16
        i = 2
    }
    if i >= s.n {
        return false
    }
    while i < s.n {
        let c: u32 = rt.ld8(s.p as u64, i) as u32
        var d: u64 = 99
        if c >= 48 && c <= 57 {
            d = (c - 48) as u64
        } else if c >= 97 && c <= 102 {
            d = (c - 87) as u64
        } else if c >= 65 && c <= 70 {
            d = (c - 55) as u64
        }
        if d >= base {
            return false
        }
        v = v *% base +% d
        i = i + 1
    }
    *out = v
    return true
}

fn parse_ram(s: str, out: *mut RamSpec) -> bool {
    var colon: usize = s.n
    var i: usize = 0
    while i < s.n {
        if rt.ld8(s.p as u64, i) == 58 {
            colon = i
        }
        i = i + 1
    }
    if colon == s.n {
        return false
    }
    var base: u64 = 0
    var size: u64 = 0
    let a: bool = parse_number(str { p: s.p, n: colon }, &base)
    let b: bool = parse_number(str { p: (s.p as u64 + (colon as u64) + 1) as *mut u8, n: s.n - colon - 1 }, &size)
    if !a || !b || size == 0 {
        return false
    }
    *out = RamSpec { base: base as u32, size: size as u32 }
    return true
}

fn number_option(v: str, out: *mut u64, o: *mut Options, name: str) {
    if !parse_number(v, out) {
        (*o).bad_flag = name
    }
}

fn parse_options(start: u64, o: *mut Options) -> bool {
    let n: usize = rt.arg_count(start)
    var i: usize = 1
    while i < n && (*o).bad_flag.n == 0 {
        let a: str = arg_text(start, i)
        if i + 1 >= n {
            (*o).bad_flag = a
            return false
        }
        let v: str = arg_text(start, i + 1)
        let vp: u64 = rt.arg_ptr(start, i + 1)
        var num: u64 = 0
        if a == "--elf" {
            (*o).elf = vp
        } else if a == "--bin" {
            (*o).bin = vp
        } else if a == "--hex" {
            (*o).hex = vp
        } else if a == "--result" {
            (*o).result = vp
        } else if a == "--commits" {
            (*o).commits = vp
        } else if a == "--isa-json" {
            (*o).isa_json = vp
        } else if a == "--isa" {
            (*o).isa = v
        } else if a == "--base" {
            number_option(v, &num, o, a)
            (*o).base = num as u32
        } else if a == "--reset" {
            number_option(v, &num, o, a)
            (*o).reset = num as u32
        } else if a == "--uart" {
            number_option(v, &num, o, a)
            (*o).uart = num | 4294967296
        } else if a == "--finisher" {
            number_option(v, &num, o, a)
            (*o).finisher = num | 4294967296
        } else if a == "--max-instr" {
            number_option(v, &num, o, a)
            (*o).max_instr = num
        } else if a == "--ram" {
            var spec: RamSpec = RamSpec { base: 0, size: 0 }
            if parse_ram(v, &spec) {
                vec_push[RamSpec](&(*o).ram, spec)
            } else {
                (*o).bad_flag = a
            }
        } else {
            (*o).bad_flag = a
        }
        i = i + 2
    }
    return (*o).bad_flag.n == 0
}
