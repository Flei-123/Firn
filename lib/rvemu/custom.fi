import std.rt
import std.vec
import std.json
import std.str
import rvemu.machine as mc
import rvemu.semantics as sem

export { load_custom, CUSTOM_OK, CUSTOM_BAD_JSON, CUSTOM_BAD_SEMANTICS }

const CUSTOM_OK: i32 = 0
const CUSTOM_BAD_JSON: i32 = 1
const CUSTOM_BAD_SEMANTICS: i32 = 2

const FORMAT_R: u32 = 0
const FORMAT_I: u32 = 1
const FORMAT_S: u32 = 2
const FORMAT_U: u32 = 3

fn parse_hex_span(s: str.Span) -> u32 {
    var v: u64 = 0
    var i: usize = 0
    if s.n > 2 && rt.ld8(s.p as u64, 0) == 48 {
        i = 2
    }
    while i < s.n {
        let c: u32 = rt.ld8(s.p as u64, i) as u32
        var d: u32 = 0
        if c >= 48 && c <= 57 {
            d = c - 48
        } else if c >= 97 && c <= 102 {
            d = c - 87
        } else if c >= 65 && c <= 70 {
            d = c - 55
        }
        v = ((v << 4) | (d as u64)) & 4294967295
        i = i + 1
    }
    return v as u32
}

fn span_is(s: str.Span, lit: str) -> bool {
    return s.n == lit.n && rt.mem_eq(s.p as u64, lit.p as u64, lit.n)
}

fn format_of(s: str.Span) -> u32 {
    if span_is(s, "I") {
        return FORMAT_I
    }
    if span_is(s, "S") {
        return FORMAT_S
    }
    if span_is(s, "U") {
        return FORMAT_U
    }
    return FORMAT_R
}

fn has_operand(d: *mut json.Json, list: u32, name: str) -> bool {
    var c: u32 = json.json_child(d, list)
    while c != json.JSON_NONE {
        if span_is(json.json_string(d, c), name) {
            return true
        }
        c = json.json_next(d, c)
    }
    return false
}

fn field(d: *mut json.Json, obj: u32, key: str) -> u32 {
    return json.json_get(d, obj, key.p as u64, key.n)
}

fn load_entry(d: *mut json.Json, e: u32, m: *mut mc.Machine) -> i32 {
    let sem_node: u32 = field(d, e, "semantics")
    let text: str.Span = json.json_string(d, sem_node)
    var code: Vec[u32] = vec_new[u32]()
    let ok: bool = text.n > 0 && sem.compile_semantics(str { p: text.p, n: text.n }, &code)
    if !ok {
        vec_free[u32](&code)
        if text.n == 0 {
            return CUSTOM_OK
        }
        return CUSTOM_BAD_SEMANTICS
    }
    let item: mc.Custom = mc.Custom {
        pattern: parse_hex_span(json.json_string(d, field(d, e, "match"))),
        mask: parse_hex_span(json.json_string(d, field(d, e, "mask"))),
        format: format_of(json.json_string(d, field(d, e, "format"))),
        has_rd: has_operand(d, field(d, e, "operands"), "rd"),
        code: code,
    }
    vec_push[mc.Custom](&(*m).custom, item)
    return CUSTOM_OK
}

fn load_custom(m: *mut mc.Machine, p: u64, n: usize) -> i32 {
    var d: json.Json = json.json_new()
    let parsed: bool = json.json_parse(&d, p, n) catch | e | false
    if !parsed || !json.json_valid(&d) {
        json.json_free(&d)
        return CUSTOM_BAD_JSON
    }
    let list: u32 = field(&d, json.json_root(&d), "instructions")
    var status: i32 = CUSTOM_OK
    var e: u32 = json.json_child(&d, list)
    while e != json.JSON_NONE && status == CUSTOM_OK {
        status = load_entry(&d, e, m)
        e = json.json_next(&d, e)
    }
    json.json_free(&d)
    return status
}
