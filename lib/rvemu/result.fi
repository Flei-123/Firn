import std.rt
import rvemu.machine as mc

export { result_json, status_name }

fn put(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn put_field(b: *mut rt.Buf, name: str, v: u64) {
    put(b, "\"")
    put(b, name)
    put(b, "\":")
    rt.buf_push_dec_u64(b, v)
}

fn status_name(status: u32) -> str {
    if status == mc.STATUS_EXIT {
        return "exit"
    }
    if status == mc.STATUS_TRAP {
        return "trap"
    }
    return "timeout"
}

fn result_json(m: *mut mc.Machine, b: *mut rt.Buf) {
    put(b, "{\"status\":\"")
    put(b, status_name((*m).status))
    put(b, "\",")
    put_field(b, "exit_code", (*m).exit_code as u64)
    put(b, ",\"cycles\":null,")
    put_field(b, "instret", (*m).instret)
    put(b, ",")
    put_field(b, "trap_pc", (*m).trap_pc as u64)
    put(b, ",\"perf\":{")
    put_field(b, "stall_cycles", 0)
    put(b, ",")
    put_field(b, "branches", (*m).branches)
    put(b, ",")
    put_field(b, "branch_misses", (*m).branch_taken)
    put(b, ",")
    put_field(b, "loads", (*m).loads)
    put(b, ",")
    put_field(b, "stores", (*m).stores)
    put(b, ",")
    put_field(b, "cache_accesses", 0)
    put(b, ",")
    put_field(b, "cache_misses", 0)
    put(b, "}}\n")
}
