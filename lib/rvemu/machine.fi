import std.rt
import std.vec

export { Machine, Region, Custom, machine_new, machine_free, add_ram, reg_get, reg_set, STATUS_RUNNING, STATUS_EXIT, STATUS_TRAP, STATUS_TIMEOUT }

const STATUS_RUNNING: u32 = 0
const STATUS_EXIT: u32 = 1
const STATUS_TRAP: u32 = 2
const STATUS_TIMEOUT: u32 = 3

struct Region {
    base: u32,
    size: u32,
    data: u64,
}

struct Custom {
    pattern: u32,
    mask: u32,
    format: u32,
    has_rd: bool,
    code: Vec[u32],
}

struct Machine {
    regs: u64,
    pc: u32,
    instret: u64,
    ext_m: bool,
    ram_base: u32,
    ram_size: u32,
    ram: u64,
    regions: Vec[Region],
    uart_on: bool,
    uart_base: u32,
    fin_on: bool,
    fin_base: u32,
    exit_valid: bool,
    exit_code: u32,
    trap_pc: u32,
    status: u32,
    out: rt.Buf,
    commits: rt.Buf,
    log_commits: bool,
    custom: Vec[Custom],
    loads: u64,
    stores: u64,
    branches: u64,
    branch_taken: u64,
}

fn machine_new() -> Machine {
    let regs: u64 = rt.heap_alloc(128)
    rt.mem_set(regs, 0 as u8, 128)
    return Machine {
        regs: regs,
        pc: 0,
        instret: 0,
        ext_m: false,
        ram_base: 0,
        ram_size: 0,
        ram: 0,
        regions: vec_new[Region](),
        uart_on: false,
        uart_base: 0,
        fin_on: false,
        fin_base: 0,
        exit_valid: false,
        exit_code: 0,
        trap_pc: 0,
        status: STATUS_RUNNING,
        out: rt.buf_new(),
        commits: rt.buf_new(),
        log_commits: false,
        custom: vec_new[Custom](),
        loads: 0,
        stores: 0,
        branches: 0,
        branch_taken: 0,
    }
}

fn machine_free(m: *mut Machine) {
    rt.heap_free((*m).regs, 128)
    rt.buf_free(&(*m).out)
    rt.buf_free(&(*m).commits)
}

fn add_ram(m: *mut Machine, base: u32, size: u32) -> bool {
    let words: usize = ((size as usize) + 3) / 4 * 4
    if words == 0 {
        return false
    }
    let data: u64 = rt.heap_alloc(words)
    if data == 0 {
        return false
    }
    rt.mem_set(data, 0 as u8, words)
    if (*m).ram == 0 {
        (*m).ram_base = base
        (*m).ram_size = size
        (*m).ram = data
        return true
    }
    return vec_push[Region](&(*m).regions, Region { base: base, size: size, data: data })
}

fn reg_get(m: *mut Machine, i: u32) -> u32 {
    return rt.ld32((*m).regs, i as usize)
}

fn reg_set(m: *mut Machine, i: u32, v: u32) {
    rt.st32((*m).regs, i as usize, v)
}
