// SPDX-License-Identifier: MPL-2.0
export {
    popcount, clz, ctz, rotl, rotr, sext8, sext16, sra, abs32, mulh, mulhu, mulhsu,
    div_signed, div_unsigned, rem_signed, rem_unsigned, bswap, min_signed, max_signed,
    imm_i, imm_s, imm_b, imm_j, imm_u,
}

const SIGN_BIT: u32 = 2147483648
const ALL_ONES: u32 = 4294967295

fn popcount(v: u32) -> u32 {
    var x: u32 = v
    var n: u32 = 0
    while x != 0 {
        x = x & (x - 1)
        n = n + 1
    }
    return n
}

fn clz(v: u32) -> u32 {
    if v == 0 {
        return 32
    }
    var n: u32 = 0
    var x: u32 = v
    while (x & SIGN_BIT) == 0 {
        x = x << 1
        n = n + 1
    }
    return n
}

fn ctz(v: u32) -> u32 {
    if v == 0 {
        return 32
    }
    var n: u32 = 0
    var x: u32 = v
    while (x & 1) == 0 {
        x = x >> 1
        n = n + 1
    }
    return n
}

fn rotl(a: u32, n: u32) -> u32 {
    let k: u32 = n & 31
    if k == 0 {
        return a
    }
    return (a << k) | (a >> (32 - k))
}

fn rotr(a: u32, n: u32) -> u32 {
    let k: u32 = n & 31
    if k == 0 {
        return a
    }
    return (a >> k) | (a << (32 - k))
}

fn sext8(a: u32) -> u32 {
    return ((((a & 255) << 24) as% i32) >> 24) as% u32
}

fn sext16(a: u32) -> u32 {
    return ((((a & 65535) << 16) as% i32) >> 16) as% u32
}

fn sra(a: u32, n: u32) -> u32 {
    return ((a as% i32) >> (n & 31)) as% u32
}

fn abs32(a: u32) -> u32 {
    if (a & SIGN_BIT) != 0 {
        return 0 -% a
    }
    return a
}

fn min_signed(a: u32, b: u32) -> u32 {
    if (a as% i32) < (b as% i32) {
        return a
    }
    return b
}

fn max_signed(a: u32, b: u32) -> u32 {
    if (a as% i32) > (b as% i32) {
        return a
    }
    return b
}

fn bswap(a: u32) -> u32 {
    return ((a & 255) << 24) | ((a & 65280) << 8) | ((a >> 8) & 65280) | (a >> 24)
}

fn mulh(a: u32, b: u32) -> u32 {
    let p: i64 = ((a as% i32) as i64) * ((b as% i32) as i64)
    return (p >> 32) as% u32
}

fn mulhsu(a: u32, b: u32) -> u32 {
    let p: i64 = ((a as% i32) as i64) * (b as i64)
    return (p >> 32) as% u32
}

fn mulhu(a: u32, b: u32) -> u32 {
    let p: u64 = (a as u64) * (b as u64)
    return (p >> 32) as% u32
}

fn div_signed(a: u32, b: u32) -> u32 {
    if b == 0 {
        return ALL_ONES
    }
    if a == SIGN_BIT && b == ALL_ONES {
        return a
    }
    return ((a as% i32) / (b as% i32)) as% u32
}

fn div_unsigned(a: u32, b: u32) -> u32 {
    if b == 0 {
        return ALL_ONES
    }
    return a / b
}

fn rem_signed(a: u32, b: u32) -> u32 {
    if b == 0 {
        return a
    }
    if a == SIGN_BIT && b == ALL_ONES {
        return 0
    }
    return ((a as% i32) % (b as% i32)) as% u32
}

fn rem_unsigned(a: u32, b: u32) -> u32 {
    if b == 0 {
        return a
    }
    return a % b
}

fn imm_i(insn: u32) -> u32 {
    return ((insn as% i32) >> 20) as% u32
}

fn imm_s(insn: u32) -> u32 {
    return ((((insn as% i32) >> 25) as% u32) << 5) | ((insn >> 7) & 31)
}

fn imm_b(insn: u32) -> u32 {
    return ((((insn as% i32) >> 31) as% u32) << 12) | ((insn & 128) << 4) | ((insn >> 20) & 2016) | ((insn >> 7) & 30)
}

fn imm_j(insn: u32) -> u32 {
    return ((((insn as% i32) >> 31) as% u32) << 20) | (insn & 1044480) | ((insn >> 9) & 2048) | ((insn >> 20) & 2046)
}

fn imm_u(insn: u32) -> u32 {
    return insn & 4294963200
}
