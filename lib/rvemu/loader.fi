import std.rt
import rvemu.machine as mc
import rvemu.bus as bus

export { load_elf, load_bin, load_hex, LOAD_OK, LOAD_BAD_ELF, LOAD_OUTSIDE, LOAD_BAD_HEX }

const LOAD_OK: i32 = 0
const LOAD_BAD_ELF: i32 = 1
const LOAD_OUTSIDE: i32 = 2
const LOAD_BAD_HEX: i32 = 3

const PT_LOAD: u32 = 1

fn poke_byte(m: *mut mc.Machine, addr: u32, v: u8) -> bool {
    let word: u32 = addr & 4294967292
    let shift: u32 = (addr & 3) * 8
    let off: u32 = word -% (*m).ram_base
    var inside: bool = off < (*m).ram_size
    var i: usize = 0
    let n: usize = vec_len[mc.Region](&(*m).regions)
    while !inside && i < n {
        let r: *mut mc.Region = vec_elem_ptr[mc.Region](&(*m).regions, i)
        if word -% (*r).base < (*r).size {
            inside = true
        }
        i = i + 1
    }
    if !inside {
        return false
    }
    bus.write_word(m, word, (v as u32) << shift, 1 << (addr & 3))
    return true
}

fn copy_bytes(m: *mut mc.Machine, addr: u32, p: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if !poke_byte(m, addr +% (i as u32), rt.ld8(p, i)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn load_bin(m: *mut mc.Machine, base: u32, p: u64, n: usize) -> i32 {
    if !copy_bytes(m, base, p, n) {
        return LOAD_OUTSIDE
    }
    return LOAD_OK
}

fn le32(p: u64, off: usize) -> u32 {
    return (rt.ld8(p, off) as u32) | ((rt.ld8(p, off + 1) as u32) << 8) | ((rt.ld8(p, off + 2) as u32) << 16) | ((rt.ld8(p, off + 3) as u32) << 24)
}

fn le16(p: u64, off: usize) -> u32 {
    return (rt.ld8(p, off) as u32) | ((rt.ld8(p, off + 1) as u32) << 8)
}

fn load_elf(m: *mut mc.Machine, p: u64, n: usize) -> i32 {
    if n < 52 || rt.ld8(p, 0) != 127 || rt.ld8(p, 1) != 69 || rt.ld8(p, 2) != 76 || rt.ld8(p, 3) != 70 || rt.ld8(p, 4) != 1 || rt.ld8(p, 5) != 1 {
        return LOAD_BAD_ELF
    }
    let phoff: usize = le32(p, 28) as usize
    let phsize: usize = le16(p, 42) as usize
    let phnum: usize = le16(p, 44) as usize
    var i: usize = 0
    while i < phnum {
        let ph: usize = phoff + i * phsize
        if ph + 32 > n {
            return LOAD_BAD_ELF
        }
        if le32(p, ph) == PT_LOAD {
            let offset: usize = le32(p, ph + 4) as usize
            let paddr: u32 = le32(p, ph + 12)
            let filesz: usize = le32(p, ph + 16) as usize
            if offset + filesz > n {
                return LOAD_BAD_ELF
            }
            if !copy_bytes(m, paddr, p + (offset as u64), filesz) {
                return LOAD_OUTSIDE
            }
        }
        i = i + 1
    }
    return LOAD_OK
}

fn hex_digit(c: u32) -> i32 {
    if c >= 48 && c <= 57 {
        return (c - 48) as i32
    }
    if c >= 97 && c <= 102 {
        return (c - 87) as i32
    }
    if c >= 65 && c <= 70 {
        return (c - 55) as i32
    }
    return -1
}

fn load_hex(m: *mut mc.Machine, base: u32, p: u64, n: usize) -> i32 {
    var addr: u32 = base
    var word: u32 = 0
    var digits: u32 = 0
    var i: usize = 0
    while i <= n {
        var c: u32 = 10
        if i < n {
            c = rt.ld8(p, i) as u32
        }
        let d: i32 = hex_digit(c)
        if d >= 0 {
            word = (word << 4) | (d as u32)
            digits = digits + 1
        } else {
            if digits > 8 {
                return LOAD_BAD_HEX
            }
            if digits > 0 {
                if !copy_word(m, addr, word) {
                    return LOAD_OUTSIDE
                }
                addr = addr +% 4
            }
            word = 0
            digits = 0
        }
        i = i + 1
    }
    return LOAD_OK
}

fn copy_word(m: *mut mc.Machine, addr: u32, word: u32) -> bool {
    var k: u32 = 0
    while k < 4 {
        if !poke_byte(m, addr + k, ((word >> (k * 8)) & 255) as u8) {
            return false
        }
        k = k + 1
    }
    return true
}
