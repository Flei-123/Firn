// SPDX-License-Identifier: MPL-2.0
// lib/photo/sharpen.fi -- photo.sharpen: gentle unsharp mask with halo protection.
//
//     sharpen.sharpen(&display_image, 0.6f, 1.2f, 0.004f)     // amount, radius (sigma px), noise floor
//
// Works on the DISPLAY-referred (sRGB encoded) luma and adds the same change to all channels (no colour
// fringes). detail = Y - gauss(Y). Three guards against the "over-sharpened Xiaomi look":
//   * coring: detail below `floor` (about the noise level) is left alone, so noise is not amplified;
//   * soft limiter: d / (1 + |d| / 0.12) - strong edges are boosted less than faint ones;
//   * halo clamp: the result may leave the 3x3 neighbourhood range of the ORIGINAL luma by at most 0.02.
import photo.image
import photo.filter
import photo.par

export {
    sharpen,
}

struct SharpCtx {
    im: *mut image.Image,
    y: *mut image.Image,
    bl: *mut image.Image,
    mn: *mut image.Image,
    mx: *mut image.Image,
    amount: f32,
    floor: f32,
}

fn sharpen_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut SharpCtx = ctx as *mut SharpCtx
    let im: *mut image.Image = (*k).im
    let w: i32 = (*im).w
    let floor: f32 = (*k).floor
    var yy: i32 = lo as i32
    while yy < (hi as i32) {
        var x: i32 = 0
        while x < w {
            let l: f32 = image.img_get((*k).y, 0, x, yy)
            var d: f32 = l - image.img_get((*k).bl, 0, x, yy)
            var m: f32 = d
            if m < 0.0f { m = 0.0f - m }
            if m <= floor {
                d = 0.0f
            } else {
                // subtract the floor so the response starts at zero
                if d > 0.0f { d = d - floor } else { d = d + floor }
            }
            var ad: f32 = d
            if ad < 0.0f { ad = 0.0f - ad }
            d = d / (1.0f + ad / 0.12f)
            var nl: f32 = l + (*k).amount * d
            let lo2: f32 = image.img_get((*k).mn, 0, x, yy) - 0.02f
            let hi2: f32 = image.img_get((*k).mx, 0, x, yy) + 0.02f
            if nl < lo2 { nl = lo2 }
            if nl > hi2 { nl = hi2 }
            let delta: f32 = nl - l
            var c: i32 = 0
            while c < 3 {
                image.img_set(im, c, x, yy, image.fclampf(image.img_get(im, c, x, yy) + delta, 0.0f, 1.0f))
                c = c + 1
            }
            x = x + 1
        }
        yy = yy + 1
    }
}

fn sharpen(im: *mut image.Image, amount: f32, radius: f32, floor: f32) {
    let h: i32 = (*im).h
    var y: image.Image = image.img_luma(im)
    var bl: image.Image = filter.gauss_blur(&y, radius)
    var mn: image.Image = image.img_new(1, 1, 1)
    var mx: image.Image = image.img_new(1, 1, 1)
    image.img_free(&mn)
    image.img_free(&mx)
    filter.local_minmax(&y, &mn, &mx)
    var k: SharpCtx = SharpCtx { im: im, y: &y, bl: &bl, mn: &mn, mx: &mx, amount: amount, floor: floor }
    par.rows(h, 16, sharpen_rows, (&k) as u64)
    image.img_free(&y)
    image.img_free(&bl)
    image.img_free(&mn)
    image.img_free(&mx)
}
