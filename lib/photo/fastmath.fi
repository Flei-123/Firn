// SPDX-License-Identifier: MPL-2.0
// lib/photo/fastmath.fi -- photo.fastmath: f32 log / exp / pow for per pixel loops (rational approximations,
// relative error < 1e-5, no f64 calls), and the sRGB encode built on them.
//
//     import photo.fastmath
//
//     fastmath.lnf(x) / fastmath.expf(x) / fastmath.powf(b, e) / fastmath.srgb_encode(x)
import std.core

export {
    log2f, pow2f, lnf, expf, powf, srgb_encode,
}

fn log2f(x: f32) -> f32 {
    if x <= 0.0f { return 0.0f - 126.0f }
    let bits: i32 = core.f32_bits(x) as i32
    let e: i32 = (bits - 1059760811) >> 23
    let t: f32 = core.bits_f32((bits - (e << 23)) as u32) - 1.0f
    var yp: f32 = 0.7424587332782057f * t + 1.4287160470083755f
    yp = yp * t - 0.000001850383340051831f
    var yq: f32 = 0.1740934300336685f * t + 1.0096718572241148f
    yq = yq * t + 0.9903281427759072f
    return yp / yq + (e as f32)
}

fn pow2f(x: f32) -> f32 {
    var v: f32 = x
    if v < 0.0f - 126.0f { return 0.0f }
    if v > 127.0f { v = 127.0f }
    var fl: i32 = v as i32
    if (fl as f32) > v { fl = fl - 1 }
    let e: f32 = core.bits_f32(((fl + 127) << 23) as u32)
    let frac: f32 = v - (fl as f32)
    var num: f32 = frac + 10.1749063f
    num = num * frac + 48.8687798f
    num = num * frac + 98.5506591f
    var den: f32 = frac * 0.210242958f - 0.0222328856f
    den = den * frac - 19.441499f
    den = den * frac + 98.5506633f
    return (num * e) / den
}

fn lnf(x: f32) -> f32 {
    return log2f(x) * 0.6931471805599453f
}

fn expf(x: f32) -> f32 {
    return pow2f(x * 1.4426950408889634f)
}

fn powf(b: f32, e: f32) -> f32 {
    if b <= 0.0f { return 0.0f }
    return pow2f(log2f(b) * e)
}

fn srgb_encode(x: f32) -> f32 {
    if x <= 0.0f { return 0.0f }
    if x >= 1.0f { return 1.0f }
    if x <= 0.0031308f { return 12.92f * x }
    return 1.055f * powf(x, 0.4166666666666667f) - 0.055f
}
