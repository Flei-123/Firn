// SPDX-License-Identifier: MPL-2.0
// lib/photo/merge.fi -- photo.merge: robust burst merge with ghost rejection and exposure bracketing.
//
//     var b: merge.Burst = merge.burst_new()
//     merge.burst_add(&b, frame0, 1.0f)           // owns the image; 2nd argument = exposure gain (1 = normal)
//     merge.burst_add(&b, frame1, 1.0f)
//     merge.burst_add(&b, short_frame, 0.25f)     // a bracketed frame with a quarter of the exposure
//     var out: image.Image = ...                  // filled by merge_burst
//     merge.merge_burst(&b, 0, &nm, &out, &var_plane, &wsum)
//     merge.burst_free(&b)
//
// Frames are LINEAR RGB (3 channels, 0..1 sensor range, 1 = clipped). `gain` is the exposure of the frame
// relative to a normal exposure; the merge divides by it, so the output is in scene radiance units of the
// reference frame (it may exceed 1.0 when a short frame recovered clipped highlights).
// METHOD per alternate frame: tile alignment (photo.align) -> sample at the per-pixel flow -> normalised
// difference to the reference in units of the expected noise (from the (S, O) model) -> 3x3 mean -> soft weight
// exp(-max(0, T - 1.5) / 1.5) (Wiener-like: a pixel that differs by more than noise explains is a mover or a
// misalignment and is ignored) -> inverse-variance weighting -> weighted mean. Clipped pixels get weight 0
// in any frame. `var_plane` is the expected noise variance of the result (channel G, radiance units) and
// `wsum` the summed weights (about the number of frames that contributed).
import std.rt
import photo.image
import photo.align
import photo.noise
import photo.filter
import photo.par

export {
    Burst, BURST_MAX,
    MergeOpts, merge_default, burst_new, burst_add, burst_free, merge_burst, merge_burst_opts, CLIP,
}

const BURST_MAX: i32 = 24
const CLIP: f32 = 0.97f

struct Burst {
    n: i32,
    frames: [image.Image; 24],
    gain: [f32; 24],
}

fn burst_new() -> Burst {
    return Burst { n: 0, frames: [image.Image { w: 0, h: 0, ch: 0, px: 0 as u64 }; 24], gain: [1.0f; 24] }
}

// Takes ownership of `im` (3 channels). Returns false when the burst is full.
fn burst_add(b: *mut Burst, im: image.Image, gain: f32) -> bool {
    if (*b).n >= BURST_MAX { return false }
    (*b).frames[(*b).n as usize] = im
    (*b).gain[(*b).n as usize] = gain
    (*b).n = (*b).n + 1
    return true
}

fn burst_free(b: *mut Burst) {
    var i: i32 = 0
    while i < (*b).n {
        image.img_free(&(*b).frames[i as usize])
        i = i + 1
    }
    (*b).n = 0
}

// A pixel counts as clipped when it or any pixel of its 3x3 neighbourhood is at the sensor limit (a bilinear
// sample next to a clipped pixel is an under-estimate and must not be trusted).
fn is_clipped(im: *mut image.Image, x: i32, y: i32) -> bool {
    var dy: i32 = -1
    while dy <= 1 {
        var dx: i32 = -1
        while dx <= 1 {
            if image.img_getc(im, 0, x + dx, y + dy) > CLIP || image.img_getc(im, 1, x + dx, y + dy) > CLIP || image.img_getc(im, 2, x + dx, y + dy) > CLIP {
                return true
            }
            dx = dx + 1
        }
        dy = dy + 1
    }
    return false
}

// Tuning of the temporal filter. thr/soft: a pixel whose normalised difference T (1 = pure noise) is above
// `thr` gets weight exp(-(T - thr) / soft); larger values accept more (night mode: very noisy, the difference
// statistic itself is noisy). align_blur: Gaussian sigma applied to the luma used for ALIGNMENT only (0 = none),
// which keeps the tile search from locking onto noise in dark frames.
struct MergeOpts {
    thr: f32,
    soft: f32,
    align_blur: f32,
    clip_bound: f32,
    edge_gate: f32,
}

// clip_bound (0..1): where the REFERENCE is clipped its value is only a lower bound of the scene. An alternate
// sample that is clearly DARKER than that bound (flicker, a shifted glyph, a misaligned edge) is rejected instead of
// being accepted blindly (older versions gave every pixel with a clipped reference the full weight, which
// punches holes into bright text). edge_gate (0..1): on strong reference edges (thin strokes) the 3x3 MEAN of T
// dilutes a misalignment with quiet neighbours; the gate switches towards the 3x3 MAXIMUM there, so a ghosting
// edge gets weight 0 and the sharp reference pixel wins. 0 = old behaviour for both.
fn merge_default() -> MergeOpts {
    return MergeOpts { thr: 1.5f, soft: 1.5f, align_blur: 0.0f, clip_bound: 1.0f, edge_gate: 0.0f }
}

fn merge_burst(b: *mut Burst, ref_idx: i32, nm: *mut noise.NoiseModel, out: *mut image.Image, var_plane: *mut image.Image, wsum: *mut image.Image) {
    var mo: MergeOpts = merge_default()
    merge_burst_opts(b, ref_idx, nm, &mo, out, var_plane, wsum)
}

// Bilinear sample setup shared by the three channels of one position (the same index / weight arithmetic as
// image.img_sample, so every channel value is bit-identical to calling img_sample per channel).
struct Bil {
    i00: i32,
    i10: i32,
    i01: i32,
    i11: i32,
    ax: f32,
    ay: f32,
}

#[inline]
fn bil_setup(w: i32, h: i32, x: f32, y: f32) -> Bil {
    var fx: f32 = x
    var fy: f32 = y
    if fx < 0.0f { fx = 0.0f }
    if fy < 0.0f { fy = 0.0f }
    let mx: f32 = (w - 1) as f32
    let my: f32 = (h - 1) as f32
    if fx > mx { fx = mx }
    if fy > my { fy = my }
    var x0: i32 = fx as i32
    var y0: i32 = fy as i32
    if x0 > w - 2 { x0 = w - 2 }
    if y0 > h - 2 { y0 = h - 2 }
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    let ax: f32 = fx - (x0 as f32)
    let ay: f32 = fy - (y0 as f32)
    var x1: i32 = x0 + 1
    var y1: i32 = y0 + 1
    if x1 >= w { x1 = x0 }
    if y1 >= h { y1 = y0 }
    return Bil { i00: y0 * w + x0, i10: y0 * w + x1, i01: y1 * w + x0, i11: y1 * w + x1, ax: ax, ay: ay }
}

// plane = base address of one channel plane
#[inline]
fn bil_get(plane: u64, b: *mut Bil) -> f32 {
    let a: f32 = *((plane + ((*b).i00 as u64) * (4 as u64)) as *mut f32) * (1.0f - (*b).ax) + *((plane + ((*b).i10 as u64) * (4 as u64)) as *mut f32) * (*b).ax
    let c: f32 = *((plane + ((*b).i01 as u64) * (4 as u64)) as *mut f32) * (1.0f - (*b).ax) + *((plane + ((*b).i11 as u64) * (4 as u64)) as *mut f32) * (*b).ax
    return a * (1.0f - (*b).ay) + c * (*b).ay
}

#[inline]
fn plane_at(im: *mut image.Image, c: i32) -> u64 {
    return (*im).px + (c as u64) * ((*im).w as u64) * ((*im).h as u64) * (4 as u64)
}

struct ClipCtx {
    im: *mut image.Image,
    m: *mut image.Image,
    d: *mut image.Image,
}

fn clip_mask_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut ClipCtx = ctx as *mut ClipCtx
    let w: i32 = (*(*k).im).w
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < w {
            var v: f32 = 0.0f
            if image.img_get((*k).im, 0, x, y) > CLIP || image.img_get((*k).im, 1, x, y) > CLIP || image.img_get((*k).im, 2, x, y) > CLIP {
                v = 1.0f
            }
            image.img_set((*k).m, 0, x, y, v)
            x = x + 1
        }
        y = y + 1
    }
}

fn clip_dilate_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut ClipCtx = ctx as *mut ClipCtx
    let w: i32 = (*(*k).im).w
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < w {
            var v: f32 = 0.0f
            var dy: i32 = -1
            while dy <= 1 {
                var dx: i32 = -1
                while dx <= 1 {
                    if image.img_getc((*k).m, 0, x + dx, y + dy) > 0.5f { v = 1.0f }
                    dx = dx + 1
                }
                dy = dy + 1
            }
            image.img_set((*k).d, 0, x, y, v)
            x = x + 1
        }
        y = y + 1
    }
}

// 1 channel map: 1 where `is_clipped(im, x, y)` is true, else 0.
fn clip_map(im: *mut image.Image) -> image.Image {
    var m: image.Image = image.img_new((*im).w, (*im).h, 1)
    var d: image.Image = image.img_new((*im).w, (*im).h, 1)
    var k: ClipCtx = ClipCtx { im: im, m: &m, d: &d }
    par.rows((*im).h, 16, clip_mask_rows, (&k) as u64)
    par.rows((*im).h, 16, clip_dilate_rows, (&k) as u64)
    image.img_free(&m)
    return d
}

// Everything the row loops of one merge need.
struct MergeCtx {
    rf: *mut image.Image,
    af: *mut image.Image,
    acc: *mut image.Image,
    vnum: *mut image.Image,
    tmap: *mut image.Image,
    wmap: *mut image.Image,
    wsum: *mut image.Image,
    out: *mut image.Image,
    var_plane: *mut image.Image,
    nm: *mut noise.NoiseModel,
    fl: *mut align.Flow,
    rclip: *mut image.Image,
    aclip: *mut image.Image,
    gr: f32,
    ga: f32,
    thr: f32,
    soft: f32,
    cb: f32,
    eg: f32,
    cmap: *mut image.Image,
}

fn ref_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut MergeCtx = ctx as *mut MergeCtx
    let w: i32 = (*(*k).rf).w
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < w {
            var wr: f32 = 1.0f
            if image.img_get((*k).rclip, 0, x, y) > 0.5f { wr = 0.0f }
            var c: i32 = 0
            while c < 3 {
                image.img_set((*k).acc, c, x, y, wr * image.img_get((*k).rf, c, x, y) / (*k).gr)
                c = c + 1
            }
            let vg: f32 = noise.variance((*k).nm, 1, image.img_get((*k).rf, 1, x, y)) / ((*k).gr * (*k).gr)
            image.img_set((*k).wsum, 0, x, y, wr)
            image.img_set((*k).vnum, 0, x, y, wr * wr * vg)
            x = x + 1
        }
        y = y + 1
    }
}

// edge strength of the reference (green, 3x3 range in units of the expected noise sigma) -> gate 0..1
fn cmap_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut MergeCtx = ctx as *mut MergeCtx
    let w: i32 = (*(*k).rf).w
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < w {
            var mn: f32 = 1.0e9f
            var mx: f32 = 0.0f - 1.0e9f
            var dy: i32 = -1
            while dy <= 1 {
                var dx: i32 = -1
                while dx <= 1 {
                    let v: f32 = image.img_getc((*k).rf, 1, x + dx, y + dy)
                    if v < mn { mn = v }
                    if v > mx { mx = v }
                    dx = dx + 1
                }
                dy = dy + 1
            }
            let sg: f32 = noise.sigma_of((*k).nm, 1, image.img_get((*k).rf, 1, x, y)) / (*k).gr
            var e: f32 = ((mx - mn) / (sg + 1.0e-6f) - 6.0f) / 10.0f
            if e < 0.0f { e = 0.0f }
            if e > 1.0f { e = 1.0f }
            image.img_set((*k).cmap, 0, x, y, e * e * (3.0f - 2.0f * e))
            x = x + 1
        }
        y = y + 1
    }
}

// T of a pixel whose reference is clipped: a clipped channel only tells "scene >= bound", so only an alternate
// sample BELOW the bound counts as a difference (in units of the expected noise); brighter is fine.
fn clip_bound_t(k: *mut MergeCtx, x: i32, y: i32, ap0: u64, ap1: u64, ap2: u64, bl: *mut Bil) -> f32 {
    let gr: f32 = (*k).gr
    let ga: f32 = (*k).ga
    var t: f32 = 0.0f
    var c: i32 = 0
    while c < 3 {
        let rv: f32 = image.img_get((*k).rf, c, x, y)
        if rv > CLIP {
            var ap: u64 = ap0
            if c == 1 { ap = ap1 }
            if c == 2 { ap = ap2 }
            let av: f32 = bil_get(ap, bl)
            let d: f32 = rv / gr - av / ga
            if d > 0.0f {
                let va: f32 = noise.variance((*k).nm, c, av) / (ga * ga) + noise.variance((*k).nm, c, rv) / (gr * gr)
                t = t + (*k).cb * d * d / va
            }
        }
        c = c + 1
    }
    return t
}

// pass 1: normalised squared difference T (mean over channels, expected 1 for pure noise)
fn pass1_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut MergeCtx = ctx as *mut MergeCtx
    let w: i32 = (*(*k).rf).w
    let h: i32 = (*(*k).rf).h
    let rf: *mut image.Image = (*k).rf
    let af: *mut image.Image = (*k).af
    let gr: f32 = (*k).gr
    let ga: f32 = (*k).ga
    let ap0: u64 = plane_at(af, 0)
    let ap1: u64 = plane_at(af, 1)
    let ap2: u64 = plane_at(af, 2)
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < w {
            var dx: f32 = 0.0f
            var dy: f32 = 0.0f
            align.flow_at((*k).fl, x as f32, y as f32, &dx, &dy)
            let sx: f32 = (x as f32) + dx
            let sy: f32 = (y as f32) + dy
            var bl: Bil = bil_setup(w, h, sx, sy)
            var t: f32 = 0.0f
            var av: f32 = bil_get(ap0, &bl)
            var rv: f32 = image.img_get(rf, 0, x, y)
            var d: f32 = av / ga - rv / gr
            var va: f32 = noise.variance((*k).nm, 0, av) / (ga * ga) + noise.variance((*k).nm, 0, rv) / (gr * gr)
            t = t + d * d / va
            av = bil_get(ap1, &bl)
            rv = image.img_get(rf, 1, x, y)
            d = av / ga - rv / gr
            va = noise.variance((*k).nm, 1, av) / (ga * ga) + noise.variance((*k).nm, 1, rv) / (gr * gr)
            t = t + d * d / va
            av = bil_get(ap2, &bl)
            rv = image.img_get(rf, 2, x, y)
            d = av / ga - rv / gr
            va = noise.variance((*k).nm, 2, av) / (ga * ga) + noise.variance((*k).nm, 2, rv) / (gr * gr)
            t = t + d * d / va
            if image.img_get((*k).rclip, 0, x, y) > 0.5f {
                t = 0.0f
                if (*k).cb > 0.0f {
                    // lower bound test: only channels that are clipped themselves, only samples darker than the bound
                    t = clip_bound_t(k, x, y, ap0, ap1, ap2, &bl)
                }
            }
            image.img_set((*k).tmap, 0, x, y, t / 3.0f)
            // mark clipped alt samples with a huge T
            if image.img_getc((*k).aclip, 0, (sx + 0.5f) as i32, (sy + 0.5f) as i32) > 0.5f {
                image.img_set((*k).tmap, 0, x, y, 1.0e6f)
            }
            x = x + 1
        }
        y = y + 1
    }
}

// pass 2: 3x3 mean of T (clipped marks stay huge) -> weight
fn pass2_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut MergeCtx = ctx as *mut MergeCtx
    let w: i32 = (*(*k).rf).w
    let h: i32 = (*(*k).rf).h
    let tp: u64 = (*(*k).tmap).px
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < w {
            var s: f32 = 0.0f
            var mx: f32 = 0.0f
            if x >= 1 && x < w - 1 && y >= 1 && y < h - 1 {
                let c: i32 = y * w + x
                var r: i32 = -1
                while r <= 1 {
                    var q: i32 = c + r * w - 1
                    var n: i32 = 0
                    while n < 3 {
                        let v: f32 = *((tp + (q as u64) * (4 as u64)) as *mut f32)
                        if v > mx { mx = v }
                        s = s + v
                        q = q + 1
                        n = n + 1
                    }
                    r = r + 1
                }
            } else {
                var dy: i32 = -1
                while dy <= 1 {
                    var dx: i32 = -1
                    while dx <= 1 {
                        let v: f32 = image.img_getc((*k).tmap, 0, x + dx, y + dy)
                        if v > mx { mx = v }
                        s = s + v
                        dx = dx + 1
                    }
                    dy = dy + 1
                }
            }
            var tt: f32 = s / 9.0f
            if (*k).eg > 0.0f {
                // max over the real (not clip-marked) neighbours
                var mr: f32 = 0.0f
                var ey: i32 = -1
                while ey <= 1 {
                    var ex: i32 = -1
                    while ex <= 1 {
                        let v: f32 = image.img_getc((*k).tmap, 0, x + ex, y + ey)
                        if v > mr && v < 1.0e5f { mr = v }
                        ex = ex + 1
                    }
                    ey = ey + 1
                }
                let gate: f32 = (*k).eg * image.img_get((*k).cmap, 0, x, y)
                if mr > tt && tt < 1.0e5f { tt = tt + gate * (mr - tt) }
            }
            var wgt: f32 = image.expneg(image.fmaxf(tt - (*k).thr, 0.0f) / (*k).soft)
            if image.img_get((*k).tmap, 0, x, y) > 1.0e5f { wgt = 0.0f }
            image.img_set((*k).wmap, 0, x, y, wgt)
            x = x + 1
        }
        y = y + 1
    }
}

// pass 3: accumulate the weighted alternate samples
fn pass3_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut MergeCtx = ctx as *mut MergeCtx
    let w: i32 = (*(*k).rf).w
    let h: i32 = (*(*k).rf).h
    let af: *mut image.Image = (*k).af
    let ga: f32 = (*k).ga
    let gr: f32 = (*k).gr
    let ap0: u64 = plane_at(af, 0)
    let ap1: u64 = plane_at(af, 1)
    let ap2: u64 = plane_at(af, 2)
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < w {
            let wm: f32 = image.img_get((*k).wmap, 0, x, y)
            // the weight is multiplied by rel (> 0) afterwards, so wm == 0 means no contribution at all
            if wm > 0.0f {
                var dx: f32 = 0.0f
                var dy: f32 = 0.0f
                align.flow_at((*k).fl, x as f32, y as f32, &dx, &dy)
                let sx: f32 = (x as f32) + dx
                let sy: f32 = (y as f32) + dy
                var bl: Bil = bil_setup(w, h, sx, sy)
                let ag: f32 = bil_get(ap1, &bl)
                let va: f32 = noise.variance((*k).nm, 1, ag) / (ga * ga)
                let vr: f32 = noise.variance((*k).nm, 1, image.img_get((*k).rf, 1, x, y)) / (gr * gr)
                // inverse-variance weight relative to the reference, bounded
                var rel: f32 = vr / va
                if rel > 4.0f { rel = 4.0f }
                let wgt: f32 = wm * rel
                if wgt > 0.0f {
                    image.img_set((*k).acc, 0, x, y, image.img_get((*k).acc, 0, x, y) + wgt * bil_get(ap0, &bl) / ga)
                    image.img_set((*k).acc, 1, x, y, image.img_get((*k).acc, 1, x, y) + wgt * ag / ga)
                    image.img_set((*k).acc, 2, x, y, image.img_get((*k).acc, 2, x, y) + wgt * bil_get(ap2, &bl) / ga)
                    image.img_set((*k).wsum, 0, x, y, image.img_get((*k).wsum, 0, x, y) + wgt)
                    image.img_set((*k).vnum, 0, x, y, image.img_get((*k).vnum, 0, x, y) + wgt * wgt * va)
                }
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn final_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut MergeCtx = ctx as *mut MergeCtx
    let w: i32 = (*(*k).rf).w
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < w {
            let ws: f32 = image.img_get((*k).wsum, 0, x, y)
            if ws > 1.0e-3f {
                var c: i32 = 0
                while c < 3 {
                    image.img_set((*k).out, c, x, y, image.img_get((*k).acc, c, x, y) / ws)
                    c = c + 1
                }
                image.img_set((*k).var_plane, 0, x, y, image.img_get((*k).vnum, 0, x, y) / (ws * ws))
            } else {
                var c: i32 = 0
                while c < 3 {
                    image.img_set((*k).out, c, x, y, image.img_get((*k).rf, c, x, y) / (*k).gr)
                    c = c + 1
                }
                image.img_set((*k).var_plane, 0, x, y, noise.variance((*k).nm, 1, image.img_get((*k).rf, 1, x, y)) / ((*k).gr * (*k).gr))
                image.img_set((*k).wsum, 0, x, y, 1.0f)
            }
            x = x + 1
        }
        y = y + 1
    }
}

struct NormCtx {
    la: *mut image.Image,
    gr: f32,
    ga: f32,
}

fn norm_luma_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut NormCtx = ctx as *mut NormCtx
    var n: u64 = lo
    while n < hi {
        let p: *mut f32 = ((*(*k).la).px + n * (4 as u64)) as *mut f32
        *p = image.fminf(*p * (*k).gr / (*k).ga, 1.0f)
        n = n + 1
    }
}

// Merge the burst around frame `ref_idx`. `out` (3 ch), `var_plane` and `wsum` (1 ch) are created here.
// Every pass runs its rows through photo.par (disjoint rows, the weights of pass 3 only read pass 2's map).
fn merge_burst_opts(b: *mut Burst, ref_idx: i32, nm: *mut noise.NoiseModel, mo: *mut MergeOpts, out: *mut image.Image, var_plane: *mut image.Image, wsum: *mut image.Image) {
    let rf: *mut image.Image = &(*b).frames[ref_idx as usize]
    let w: i32 = (*rf).w
    let h: i32 = (*rf).h
    let gr: f32 = (*b).gain[ref_idx as usize]
    *out = image.img_new(w, h, 3)
    *var_plane = image.img_new(w, h, 1)
    *wsum = image.img_new(w, h, 1)
    var acc: image.Image = image.img_new(w, h, 3)
    var vnum: image.Image = image.img_new(w, h, 1)
    var tmap: image.Image = image.img_new(w, h, 1)
    var wmap: image.Image = image.img_new(w, h, 1)
    var cmap: image.Image = image.img_new(w, h, 1)
    var rclip: image.Image = clip_map(rf)
    var aclip: image.Image = image.img_new(1, 1, 1)
    var fl: align.Flow = align.Flow { tw: 0, th: 0, dx: 0 as u64, dy: 0 as u64, err: 0 as u64 }
    var mc: MergeCtx = MergeCtx {
        rf: rf, af: rf, acc: &acc, vnum: &vnum, tmap: &tmap, wmap: &wmap, wsum: wsum, out: out, var_plane: var_plane, nm: nm,
        fl: &fl, rclip: &rclip, aclip: &aclip, gr: gr, ga: gr, thr: (*mo).thr, soft: (*mo).soft,
        cb: (*mo).clip_bound, eg: (*mo).edge_gate, cmap: &cmap,
    }
    par.rows(h, 16, ref_rows, (&mc) as u64)
    if (*mo).edge_gate > 0.0f { par.rows(h, 16, cmap_rows, (&mc) as u64) }

    var lr: image.Image = image.img_luma(rf)
    if (*mo).align_blur > 0.0f {
        let lb: image.Image = filter.gauss_blur(&lr, (*mo).align_blur)
        image.img_free(&lr)
        lr = lb
    }
    var pr: align.Pyr = align.pyr_build(&lr)
    image.img_free(&lr)

    var j: i32 = 0
    while j < (*b).n {
        if j == ref_idx {
            j = j + 1
            continue
        }
        let af: *mut image.Image = &(*b).frames[j as usize]
        let ga: f32 = (*b).gain[j as usize]
        // alignment on exposure-normalised luma
        var la: image.Image = image.img_luma(af)
        var nc: NormCtx = NormCtx { la: &la, gr: gr, ga: ga }
        par.rows(w * h, 65536, norm_luma_rows, (&nc) as u64)
        // the reference luma must be exposure-normalised the same way: reference luma is at gain gr already
        if (*mo).align_blur > 0.0f {
            let lb: image.Image = filter.gauss_blur(&la, (*mo).align_blur)
            image.img_free(&la)
            la = lb
        }
        var pa: align.Pyr = align.pyr_build(&la)
        image.img_free(&la)
        fl = align.align_flow(&pr, &pa)
        align.pyr_free(&pa)
        image.img_free(&aclip)
        aclip = clip_map(af)
        mc.af = af
        mc.ga = ga
        par.rows(h, 8, pass1_rows, (&mc) as u64)
        par.rows(h, 8, pass2_rows, (&mc) as u64)
        par.rows(h, 8, pass3_rows, (&mc) as u64)
        align.flow_free(&fl)
        j = j + 1
    }
    align.pyr_free(&pr)
    par.rows(h, 16, final_rows, (&mc) as u64)
    image.img_free(&rclip)
    image.img_free(&aclip)
    image.img_free(&acc)
    image.img_free(&vnum)
    image.img_free(&tmap)
    image.img_free(&wmap)
    image.img_free(&cmap)
}
