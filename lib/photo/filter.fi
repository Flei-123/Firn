// SPDX-License-Identifier: MPL-2.0
// lib/photo/filter.fi -- photo.filter: separable blurs, guided filter, local min/max on 1 channel planes.
//
//     var b: image.Image = filter.box_blur(&plane, 8)        // (2r+1)^2 mean, border clamped, f64 running sums
//     var g: image.Image = filter.gauss_blur(&plane, 1.2f)   // true Gaussian, radius ceil(3 sigma)
//     var base: image.Image = filter.guided(&plane, &guide, 12, 0.01f)   // edge preserving smoothing (He et al.)
//
// All functions take the plane of channel `c` of an image and return a NEW 1-channel image.
import std.rt
import photo.image
import photo.par

export {
    box_blur, gauss_blur, guided, local_minmax, plane_of,
}

// Copy of channel c as its own 1-channel image.
fn plane_of(im: *mut image.Image, c: i32) -> image.Image {
    var d: image.Image = image.img_new((*im).w, (*im).h, 1)
    rt.mem_copy(d.px, image.img_plane(im, c), ((*im).w as usize) * ((*im).h as usize) * 4)
    return d
}

struct BoxCtx {
    src: *mut image.Image,
    tmp: *mut image.Image,
    d: *mut image.Image,
    r: i32,
    inv: f64,
}

fn box_h_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut BoxCtx = ctx as *mut BoxCtx
    let w: i32 = (*(*k).src).w
    let r: i32 = (*k).r
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var s: f64 = 0.0
        var q: i32 = -r
        while q <= r {
            s = s + (image.img_getc((*k).src, 0, q, y) as f64)
            q = q + 1
        }
        var x: i32 = 0
        while x < w {
            image.img_set((*k).tmp, 0, x, y, (s * (*k).inv) as f32)
            s = s + (image.img_getc((*k).src, 0, x + r + 1, y) as f64) - (image.img_getc((*k).src, 0, x - r, y) as f64)
            x = x + 1
        }
        y = y + 1
    }
}

fn box_v_cols(ctx: u64, lo: u64, hi: u64) {
    let k: *mut BoxCtx = ctx as *mut BoxCtx
    let h: i32 = (*(*k).src).h
    let r: i32 = (*k).r
    var x2: i32 = lo as i32
    while x2 < (hi as i32) {
        var s: f64 = 0.0
        var q: i32 = -r
        while q <= r {
            s = s + (image.img_getc((*k).tmp, 0, x2, q) as f64)
            q = q + 1
        }
        var y2: i32 = 0
        while y2 < h {
            image.img_set((*k).d, 0, x2, y2, (s * (*k).inv) as f32)
            s = s + (image.img_getc((*k).tmp, 0, x2, y2 + r + 1) as f64) - (image.img_getc((*k).tmp, 0, x2, y2 - r) as f64)
            y2 = y2 + 1
        }
        x2 = x2 + 1
    }
}

fn box_blur(src: *mut image.Image, r: i32) -> image.Image {
    let w: i32 = (*src).w
    let h: i32 = (*src).h
    var tmp: image.Image = image.img_new(w, h, 1)
    var d: image.Image = image.img_new(w, h, 1)
    var k: BoxCtx = BoxCtx { src: src, tmp: &tmp, d: &d, r: r, inv: 1.0 / ((2 * r + 1) as f64) }
    par.rows(h, 16, box_h_rows, (&k) as u64)
    par.rows(w, 16, box_v_cols, (&k) as u64)
    image.img_free(&tmp)
    return d
}

struct GaussCtx {
    src: *mut image.Image,
    tmp: *mut image.Image,
    d: *mut image.Image,
    kern: *mut f32,
    r: i32,
}

#[inline]
fn kw(k: *mut GaussCtx, i: i32) -> f32 {
    return *(((*k).kern as u64 + (i as u64) * (4 as u64)) as *mut f32)
}

fn gauss_h_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut GaussCtx = ctx as *mut GaussCtx
    let w: i32 = (*(*k).src).w
    let r: i32 = (*k).r
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < w {
            var s: f32 = 0.0f
            var q: i32 = -r
            while q <= r {
                s = s + kw(k, q + r) * image.img_getc((*k).src, 0, x + q, y)
                q = q + 1
            }
            image.img_set((*k).tmp, 0, x, y, s)
            x = x + 1
        }
        y = y + 1
    }
}

fn gauss_v_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut GaussCtx = ctx as *mut GaussCtx
    let w: i32 = (*(*k).src).w
    let r: i32 = (*k).r
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < w {
            var s: f32 = 0.0f
            var q: i32 = -r
            while q <= r {
                s = s + kw(k, q + r) * image.img_getc((*k).tmp, 0, x, y + q)
                q = q + 1
            }
            image.img_set((*k).d, 0, x, y, s)
            x = x + 1
        }
        y = y + 1
    }
}

fn gauss_blur(src: *mut image.Image, sigma: f32) -> image.Image {
    var r: i32 = ((sigma * 3.0f) + 0.999f) as i32
    if r < 1 { r = 1 }
    var kern: [f32; 33] = [0.0f; 33]
    if r > 16 { r = 16 }
    var sum: f32 = 0.0f
    var i: i32 = -r
    while i <= r {
        let v: f32 = image.expneg(((i * i) as f32) / (2.0f * sigma * sigma))
        kern[(i + r) as usize] = v
        sum = sum + v
        i = i + 1
    }
    i = 0
    while i <= 2 * r {
        kern[i as usize] = kern[i as usize] / sum
        i = i + 1
    }
    let w: i32 = (*src).w
    let h: i32 = (*src).h
    var tmp: image.Image = image.img_new(w, h, 1)
    var d: image.Image = image.img_new(w, h, 1)
    var k: GaussCtx = GaussCtx { src: src, tmp: &tmp, d: &d, kern: &kern[0], r: r }
    par.rows(h, 16, gauss_h_rows, (&k) as u64)
    par.rows(h, 16, gauss_v_rows, (&k) as u64)
    image.img_free(&tmp)
    return d
}

// Guided filter with a single-channel guide: q = mean(a) * guide + mean(b), a = var / (var + eps).
// guide == src gives the classic edge preserving smoothing; eps is in the squared units of the data.
struct GuidedCtx {
    guide: *mut image.Image,
    src: *mut image.Image,
    a: u64,
    b: u64,
    c: u64,
    d: u64,
    e: u64,
    f: u64,
    g: u64,
    eps: f32,
}

// ii = guide^2, ip = guide * src
fn guided_prod(ctx: u64, lo: u64, hi: u64) {
    let k: *mut GuidedCtx = ctx as *mut GuidedCtx
    var n: u64 = lo
    while n < hi {
        let g: f32 = *(((*(*k).guide).px + n * (4 as u64)) as *mut f32)
        let s: f32 = *(((*(*k).src).px + n * (4 as u64)) as *mut f32)
        *((((*k).a) + n * (4 as u64)) as *mut f32) = g * g
        *((((*k).b) + n * (4 as u64)) as *mut f32) = g * s
        n = n + 1
    }
}

// a, b from the box means (c = mean guide, d = mean src, e = mean ii, f = mean ip)
fn guided_ab(ctx: u64, lo: u64, hi: u64) {
    let k: *mut GuidedCtx = ctx as *mut GuidedCtx
    var n: u64 = lo
    while n < hi {
        let o: u64 = n * (4 as u64)
        let m1: f32 = *((((*k).c) + o) as *mut f32)
        let m2: f32 = *((((*k).d) + o) as *mut f32)
        let vr: f32 = *((((*k).e) + o) as *mut f32) - m1 * m1
        let cv: f32 = *((((*k).f) + o) as *mut f32) - m1 * m2
        let av: f32 = cv / (vr + (*k).eps)
        *((((*k).a) + o) as *mut f32) = av
        *((((*k).b) + o) as *mut f32) = m2 - av * m1
        n = n + 1
    }
}

// q = mean(a) * guide + mean(b)  (a = f, b = g are the box means)
fn guided_out(ctx: u64, lo: u64, hi: u64) {
    let k: *mut GuidedCtx = ctx as *mut GuidedCtx
    var n: u64 = lo
    while n < hi {
        let o: u64 = n * (4 as u64)
        *((((*k).a) + o) as *mut f32) = *((((*k).f) + o) as *mut f32) * *(((*(*k).guide).px + o) as *mut f32) + *((((*k).g) + o) as *mut f32)
        n = n + 1
    }
}

fn guided(src: *mut image.Image, guide: *mut image.Image, r: i32, eps: f32) -> image.Image {
    let w: i32 = (*src).w
    let h: i32 = (*src).h
    var ii: image.Image = image.img_new(w, h, 1)
    var ip: image.Image = image.img_new(w, h, 1)
    var k: GuidedCtx = GuidedCtx { guide: guide, src: src, a: ii.px, b: ip.px, c: 0 as u64, d: 0 as u64, e: 0 as u64, f: 0 as u64, g: 0 as u64, eps: eps }
    par.rows(w * h, 65536, guided_prod, (&k) as u64)
    var mi: image.Image = box_blur(guide, r)
    var mp: image.Image = box_blur(src, r)
    var mii: image.Image = box_blur(&ii, r)
    var mip: image.Image = box_blur(&ip, r)
    var a: image.Image = image.img_new(w, h, 1)
    var b: image.Image = image.img_new(w, h, 1)
    k.a = a.px
    k.b = b.px
    k.c = mi.px
    k.d = mp.px
    k.e = mii.px
    k.f = mip.px
    par.rows(w * h, 65536, guided_ab, (&k) as u64)
    var ma: image.Image = box_blur(&a, r)
    var mb: image.Image = box_blur(&b, r)
    var q: image.Image = image.img_new(w, h, 1)
    k.a = q.px
    k.f = ma.px
    k.g = mb.px
    par.rows(w * h, 65536, guided_out, (&k) as u64)
    image.img_free(&ii)
    image.img_free(&ip)
    image.img_free(&mi)
    image.img_free(&mp)
    image.img_free(&mii)
    image.img_free(&mip)
    image.img_free(&a)
    image.img_free(&b)
    image.img_free(&ma)
    image.img_free(&mb)
    return q
}

// 3x3 local minimum and maximum of a plane (for halo limiting): out_min / out_max are created here.
struct MinMaxCtx {
    src: *mut image.Image,
    omin: *mut image.Image,
    omax: *mut image.Image,
}

fn minmax_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut MinMaxCtx = ctx as *mut MinMaxCtx
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < (*(*k).src).w {
            var vlo: f32 = 1.0e30f
            var vhi: f32 = -1.0e30f
            var dy: i32 = -1
            while dy <= 1 {
                var dx: i32 = -1
                while dx <= 1 {
                    let v: f32 = image.img_getc((*k).src, 0, x + dx, y + dy)
                    if v < vlo { vlo = v }
                    if v > vhi { vhi = v }
                    dx = dx + 1
                }
                dy = dy + 1
            }
            image.img_set((*k).omin, 0, x, y, vlo)
            image.img_set((*k).omax, 0, x, y, vhi)
            x = x + 1
        }
        y = y + 1
    }
}

fn local_minmax(src: *mut image.Image, out_min: *mut image.Image, out_max: *mut image.Image) {
    *out_min = image.img_new((*src).w, (*src).h, 1)
    *out_max = image.img_new((*src).w, (*src).h, 1)
    var k: MinMaxCtx = MinMaxCtx { src: src, omin: out_min, omax: out_max }
    par.rows((*src).h, 16, minmax_rows, (&k) as u64)
}
