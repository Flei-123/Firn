// SPDX-License-Identifier: MPL-2.0
// lib/photo/stagelog.fi -- photo.stagelog: wall time per pipeline stage of the photo job that runs right now.
//
//     import photo.stagelog
//
//     stagelog.start()                  // clear, the clock starts
//     ...work...
//     stagelog.tick("demosaic")         // adds the time since the last tick / start to "demosaic"
//     stagelog.count() / stagelog.name_at(i) / stagelog.ms_at(i) / stagelog.total_ms()
//
// One table for the process: only the single photo job thread ticks (par.rows workers never do).
import std.time

export {
    start, tick, count, name_p, name_n, ns_at, ms_at, total_ms, MAX_STAGES,
}

const MAX_STAGES: i32 = 32

static mut sl_p: [u64; 32] = [0; 32]
static mut sl_n: [usize; 32] = [0; 32]
static mut sl_ns: [u64; 32] = [0; 32]
static mut sl_count: i32 = 0
static mut sl_last: u64 = 0
static mut sl_t0: u64 = 0

fn start() {
    sl_count = 0
    sl_last = time.monotonic_ns()
    sl_t0 = sl_last
}

fn same(i: i32, s: str) -> bool {
    if sl_n[i as usize] != s.n { return false }
    if sl_p[i as usize] == s.p as u64 { return true }
    var k: usize = 0
    while k < s.n {
        if *((sl_p[i as usize] + k as u64) as *mut u8) != *((s.p as u64 + k as u64) as *mut u8) { return false }
        k = k + 1
    }
    return true
}

fn tick(s: str) {
    let now: u64 = time.monotonic_ns()
    let d: u64 = now - sl_last
    sl_last = now
    var i: i32 = 0
    while i < sl_count {
        if same(i, s) {
            sl_ns[i as usize] = sl_ns[i as usize] + d
            return
        }
        i = i + 1
    }
    if sl_count >= MAX_STAGES { return }
    sl_p[sl_count as usize] = s.p as u64
    sl_n[sl_count as usize] = s.n
    sl_ns[sl_count as usize] = d
    sl_count = sl_count + 1
}

fn count() -> i32 {
    return sl_count
}

fn name_p(i: i32) -> u64 {
    return sl_p[i as usize]
}

fn name_n(i: i32) -> usize {
    return sl_n[i as usize]
}

fn ns_at(i: i32) -> u64 {
    return sl_ns[i as usize]
}

fn ms_at(i: i32) -> i64 {
    return ((sl_ns[i as usize] + 500000) / 1000000) as i64
}

fn total_ms() -> i64 {
    return ((sl_last - sl_t0 + 500000) / 1000000) as i64
}
