// SPDX-License-Identifier: MPL-2.0
// lib/photo/synth.fi -- photo.synth: synthetic bursts for tests and measurements.
//
//     var rng: image.Rng = image.rng_new(5 as u64)
//     var f: image.Image = synth.synth_frame(&scene, 1.3f, -0.7f, 1.0f, 2.0e-3f, 2.0e-5f, &rng)
//     synth.synth_burst(&scene, 8, 1.0f, 2.0e-3f, 2.0e-5f, 3.0f, &rng, &burst)
//
// A frame = the scene shifted by (dx, dy) pixels (bilinear, hand shake), times the exposure `gain`, plus noise with
// the variance S * x + O of the sensor model (x = the noise free value after the gain), clipped to 0..1 (the
// sensor saturates). `synth_burst` adds `n` frames of gain 1 to the burst: frame 0 has shift 0 (the reference),
// the others follow a random walk of at most `max_shift` pixels with sub-pixel parts.
import photo.image
import photo.merge

export {
    synth_frame, synth_burst,
}

fn synth_frame(scene: *mut image.Image, dx: f32, dy: f32, gain: f32, s: f32, o: f32, rng: *mut image.Rng) -> image.Image {
    var f: image.Image = image.shift_image(scene, dx, dy)
    var i: i32 = 0
    let n: i32 = f.w * f.h * f.ch
    while i < n {
        let p: *mut f32 = (f.px + (i as u64) * (4 as u64)) as *mut f32
        let x: f32 = *p * gain
        let v: f32 = x + image.sqrtf(s * x + o) * image.rng_gauss(rng)
        *p = image.fclampf(v, 0.0f, 1.0f)
        i = i + 1
    }
    return f
}

fn synth_burst(scene: *mut image.Image, n: i32, gain: f32, s: f32, o: f32, max_shift: f32, rng: *mut image.Rng, b: *mut merge.Burst) {
    var dx: f32 = 0.0f
    var dy: f32 = 0.0f
    var k: i32 = 0
    while k < n {
        if k > 0 {
            dx = dx + (image.rng_uniform(rng) - 0.5f) * max_shift
            dy = dy + (image.rng_uniform(rng) - 0.5f) * max_shift
            dx = image.fclampf(dx, 0.0f - max_shift, max_shift)
            dy = image.fclampf(dy, 0.0f - max_shift, max_shift)
        }
        merge.burst_add(b, synth_frame(scene, dx, dy, gain, s, o, rng), gain)
        k = k + 1
    }
}
