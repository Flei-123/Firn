// SPDX-License-Identifier: MPL-2.0
// lib/photo/focus.fi -- photo.focus: focus stacking + focus step planning (FirnCam core).
//
//     var n: i32 = focus.plan_focus(&meta, 0.2f, 4.0f, 8, &steps[0])  // diopters, far -> near, from SensorMeta
//     ... shoot one frame per step (every frame is a 3 channel linear/sRGB image, 0..1) ...
//     var o: focus.FocusOpts = focus.focus_default()
//     focus.focus_stack(&burst, &o, &out, &depth)     // burst = merge.Burst (gain ignored); out 3 ch, depth 1 ch
//
// ALIGNMENT: every frame is warped onto the reference frame (the middle one) with the dense tile flow of
// photo.align on slightly blurred luma. Focus breathing (scale change of a few 0.1 %) and hand shake are no
// special case: the per-tile translations ARE the scale / shift / local warp field. The search radius of the
// pyramid covers several pixels of residual per level, so frames must overlap the way a hand held series does.
// FUSION: Laplacian pyramid (Burt-Adelson). Per level and pixel every frame gets the weight
// (E / E_ref)^power, E = Gaussian smoothed |band-pass luma| = local sharpness at that scale; band-pass
// coefficients are averaged with those weights (soft maximum: no seams, noise of flat regions averages out
// instead of being picked), the low-pass residual is the plain mean. `depth` = weight-averaged frame index at
// the finest level (0 .. n-1): a coarse depth map for free (usable as the mask of photo.portrait.bokeh after a
// threshold).
// PLANNING: the depth of field in diopters is 2 * N * c / f^2 (c = circle of confusion = sensor width / 1500);
// steps are spaced 0.85 of it. Without lens fields in the metadata a generic step of 0.8 diopter is used.
import std.rt
import std.math
import photo.image
import photo.meta
import photo.align
import photo.filter
import photo.merge
import photo.par

export {
    FocusOpts, focus_default, focus_legacy, plan_focus, focus_stack, pick_ref, fallback_frac, fallback_count, fallback_global_count,
}

const MAXLEV: i32 = 5

// Statistics of the safety net of the LAST focus_stack call (see `safety_net`): share of the image that fell back to
// the reference frame, and how many calls (since start) used any fallback / the global one.
static mut fb_frac: f32 = 0.0f
static mut fb_calls: i32 = 0
static mut fb_global: i32 = 0

fn fallback_frac() -> f32 {
    return fb_frac
}

fn fallback_count() -> i32 {
    return fb_calls
}

fn fallback_global_count() -> i32 {
    return fb_global
}

struct FocusOpts {
    ref_idx: i32,
    power: f32,
    energy_sigma: f32,
    align_blur: f32,
    // robust stack (see below); all switches 0 = the first FirnCam stack (kept for measurements)
    one_map: i32, // ONE weight map from the two finest levels for all levels (else weights per level)
    base_ref: i32, // coarsest low-pass from the reference frame (else the mean of all frames)
    norm_expo: i32, // brightness normalisation of every frame to the reference (global ratio + local gain map)
    consist: i32, // consistency map against the reference (moving content, flicker, exposure)
    auto_ref: i32, // reference = sharpest frame of the middle half (1), of all frames (2), else frame n / 2
    ref_floor: f32, // sharpness energy below which the reference wins (noise free units)
    consist_tau: f32, // tolerance factor of the consistency map (1 = 15 % relative difference)
    ref_boost: f32, // weight factor of the reference frame (>1: other frames must be clearly sharper to contribute)
    noise_s: f32, // noise model of the frames (variance = s * value + o) for the noise floor, 0 = none
    noise_o: f32,
    noise_k: f32, // scale of the noise floor that is subtracted from the sharpness energy (calibration of the model)
    avg_from: i32, // pyramid levels >= this average all consistent frames (noise) instead of picking the sharpest; 99 = off
    avg_ref_w: f32, // weight of the reference frame in that average (others: their consistency, 0..1)
    net: i32, // safety net: blend back to the reference frame where the stack is blurrier / deviates (ghost, halo, fringe)
    net_tol: f32, // tolerance of the low-pass deviation (1 = 20 % relative + noise) before the reference takes over
    warp_cubic: i32, // frames are warped onto the reference with a Catmull-Rom kernel (1) instead of bilinear (0): keeps detail
}

fn focus_default() -> FocusOpts {
    return FocusOpts {
        ref_idx: -1, power: 4.0f, energy_sigma: 1.5f, align_blur: 1.2f,
        one_map: 1, base_ref: 1, norm_expo: 1, consist: 1, auto_ref: 2, ref_floor: 0.0f, consist_tau: 0.45f, ref_boost: 4.0f, noise_s: 0.0f, noise_o: 0.0f,
        noise_k: 1.0f, avg_from: 99, avg_ref_w: 1.0f, net: 1, net_tol: 1.0f, warp_cubic: 0,
    }
}

// the first FirnCam stack (weights per level, mean low-pass, frame n / 2, no normalisation / consistency)
fn focus_legacy() -> FocusOpts {
    var o: FocusOpts = focus_default()
    o.one_map = 0
    o.base_ref = 0
    o.norm_expo = 0
    o.consist = 0
    o.auto_ref = 0
    o.net = 0
    return o
}

// Diopter steps from far_d to near_d (ascending diopters), at most max_n (<= 16). Returns the count.
fn plan_focus(m: *mut meta.SensorMeta, far_d: f32, near_d: f32, max_n: i32, out: *mut f32) -> i32 {
    var near: f32 = near_d
    var far: f32 = far_d
    if (*m).has_focus {
        if (*m).min_focus_distance > 0.0f && near > (*m).min_focus_distance { near = (*m).min_focus_distance }
        if (*m).hyperfocal_distance > 0.0f && far < (*m).hyperfocal_distance { far = (*m).hyperfocal_distance }
    }
    if far > near { far = near }
    var step: f32 = 0.8f
    if (*m).focal_length > 0.0f && (*m).aperture > 0.0f && (*m).sensor_width > 0.0f {
        let f: f32 = (*m).focal_length * 0.001f
        let c: f32 = (*m).sensor_width * 0.001f / 1500.0f
        step = 0.85f * 2.0f * (*m).aperture * c / (f * f)
    }
    var cap: i32 = max_n
    if cap > 16 { cap = 16 }
    var n: i32 = (((near - far) / step) + 0.999f) as i32 + 1
    if n < 1 { n = 1 }
    if n > cap { n = cap }
    var i: i32 = 0
    while i < n {
        var d: f32 = near
        if n > 1 { d = far + (near - far) * (i as f32) / ((n - 1) as f32) }
        *((out as u64 + (i as u64) * (4 as u64)) as *mut f32) = d
        i = i + 1
    }
    return n
}

struct Lap {
    n: i32,
    l: [image.Image; 5],
}

fn lap_free(p: *mut Lap) {
    var i: i32 = 0
    while i < (*p).n {
        image.img_free(&(*p).l[i as usize])
        i = i + 1
    }
    (*p).n = 0
}

fn zero_im() -> image.Image {
    return image.Image { w: 0, h: 0, ch: 0, px: 0 as u64 }
}

// blur (sigma 1) + 2x subsample of a 3 channel image
fn down3(src: *mut image.Image) -> image.Image {
    let w: i32 = ((*src).w + 1) / 2
    let h: i32 = ((*src).h + 1) / 2
    var d: image.Image = image.img_new(w, h, 3)
    var c: i32 = 0
    while c < 3 {
        var pl: image.Image = filter.plane_of(src, c)
        var bl: image.Image = filter.gauss_blur(&pl, 1.0f)
        var y: i32 = 0
        while y < h {
            var x: i32 = 0
            while x < w {
                image.img_set(&d, c, x, y, image.img_getc(&bl, 0, 2 * x, 2 * y))
                x = x + 1
            }
            y = y + 1
        }
        image.img_free(&pl)
        image.img_free(&bl)
        c = c + 1
    }
    return d
}

fn up_sample(src: *mut image.Image, c: i32, x: i32, y: i32) -> f32 {
    return image.img_sample(src, c, ((x as f32) + 0.5f) * 0.5f - 0.5f, ((y as f32) + 0.5f) * 0.5f - 0.5f)
}

struct LapCtx {
    a: *mut image.Image,
    up: *mut image.Image,
    d: *mut image.Image,
}

fn lap_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut LapCtx = ctx as *mut LapCtx
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < (*(*k).a).w {
            var c: i32 = 0
            while c < 3 {
                image.img_set((*k).d, c, x, y, image.img_get((*k).a, c, x, y) - up_sample((*k).up, c, x, y))
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
}

// Laplacian pyramid: l[0..n-2] band-pass, l[n-1] the low-pass residual.
fn lap_build(im: *mut image.Image, levels: i32) -> Lap {
    var g: [image.Image; 5] = [zero_im(); 5]
    g[0] = image.img_copy(im)
    var n: i32 = 1
    while n < levels {
        g[n as usize] = down3(&g[(n - 1) as usize])
        n = n + 1
    }
    var p: Lap = Lap { n: n, l: [zero_im(); 5] }
    var k: i32 = 0
    while k < n - 1 {
        let a: *mut image.Image = &g[k as usize]
        var d: image.Image = image.img_new((*a).w, (*a).h, 3)
        var lc: LapCtx = LapCtx { a: a, up: &g[(k + 1) as usize], d: &d }
        par.rows((*a).h, 8, lap_rows, (&lc) as u64)
        p.l[k as usize] = d
        k = k + 1
    }
    p.l[(n - 1) as usize] = g[(n - 1) as usize]
    k = 0
    while k < n - 1 {
        image.img_free(&g[k as usize])
        k = k + 1
    }
    return p
}

struct EnergyCtx {
    band: *mut image.Image,
    e: *mut image.Image,
}

fn energy_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut EnergyCtx = ctx as *mut EnergyCtx
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < (*(*k).band).w {
            let l: f32 = 0.299f * image.img_get((*k).band, 0, x, y) + 0.587f * image.img_get((*k).band, 1, x, y) + 0.114f * image.img_get((*k).band, 2, x, y)
            image.img_set((*k).e, 0, x, y, image.fmaxf(l, 0.0f - l))
            x = x + 1
        }
        y = y + 1
    }
}

// Gaussian smoothed |luma| of a band-pass level, as sharpness energy.
fn energy_of(band: *mut image.Image, sigma: f32) -> image.Image {
    var e: image.Image = image.img_new((*band).w, (*band).h, 1)
    var k: EnergyCtx = EnergyCtx { band: band, e: &e }
    par.rows((*band).h, 8, energy_rows, (&k) as u64)
    let s: image.Image = filter.gauss_blur(&e, sigma)
    image.img_free(&e)
    return s
}

// Catmull-Rom weights for the fraction t
fn cubic_w(t: f32, w: *mut [f32; 4]) {
    (*w)[0] = ((0.0f - 0.5f * t + 1.0f) * t - 0.5f) * t
    (*w)[1] = (1.5f * t - 2.5f) * t * t + 1.0f
    (*w)[2] = ((0.0f - 1.5f * t + 2.0f) * t + 0.5f) * t
    (*w)[3] = (0.5f * t - 0.5f) * t * t
}

fn sample_cubic(im: *mut image.Image, c: i32, x: f32, y: f32) -> f32 {
    var fx: f32 = x
    var fy: f32 = y
    if fx < 0.0f { fx = 0.0f }
    if fy < 0.0f { fy = 0.0f }
    let mx: f32 = ((*im).w - 1) as f32
    let my: f32 = ((*im).h - 1) as f32
    if fx > mx { fx = mx }
    if fy > my { fy = my }
    let x0: i32 = fx as i32
    let y0: i32 = fy as i32
    var wx: [f32; 4] = [0.0f; 4]
    var wy: [f32; 4] = [0.0f; 4]
    cubic_w(fx - (x0 as f32), &wx)
    cubic_w(fy - (y0 as f32), &wy)
    var acc: f32 = 0.0f
    var j: i32 = 0
    while j < 4 {
        var row: f32 = 0.0f
        var i: i32 = 0
        while i < 4 {
            row = row + wx[i as usize] * image.img_getc(im, c, x0 - 1 + i, y0 - 1 + j)
            i = i + 1
        }
        acc = acc + wy[j as usize] * row
        j = j + 1
    }
    return acc
}

struct WarpCtx {
    af: *mut image.Image,
    fl: *mut align.Flow,
    d: *mut image.Image,
    cubic: bool,
}

fn warp_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut WarpCtx = ctx as *mut WarpCtx
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < (*(*k).d).w {
            var dx: f32 = 0.0f
            var dy: f32 = 0.0f
            align.flow_at((*k).fl, x as f32, y as f32, &dx, &dy)
            var c: i32 = 0
            while c < 3 {
                if (*k).cubic {
                    image.img_set((*k).d, c, x, y, sample_cubic((*k).af, c, (x as f32) + dx, (y as f32) + dy))
                } else {
                    image.img_set((*k).d, c, x, y, image.img_sample((*k).af, c, (x as f32) + dx, (y as f32) + dy))
                }
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn warp_to_ref(af: *mut image.Image, fl: *mut align.Flow, cubic: bool) -> image.Image {
    var d: image.Image = image.img_new((*af).w, (*af).h, 3)
    var k: WarpCtx = WarpCtx { af: af, fl: fl, d: &d, cubic: cubic }
    par.rows((*af).h, 8, warp_rows, (&k) as u64)
    return d
}

// One level of the reconstruction: weighted band-pass sum / weight (+ the upsampled coarser result).
struct ReconCtx {
    a: *mut image.Image,
    ws: *mut image.Image,
    prev: *mut image.Image,
    has_prev: bool,
    nxt: *mut image.Image,
}

fn recon_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut ReconCtx = ctx as *mut ReconCtx
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < (*(*k).a).w {
            let wv: f32 = image.img_get((*k).ws, 0, x, y)
            var c: i32 = 0
            while c < 3 {
                var v: f32 = image.img_get((*k).a, c, x, y) / wv
                if (*k).has_prev { v = v + up_sample((*k).prev, c, x, y) }
                image.img_set((*k).nxt, c, x, y, v)
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn recon_level(a: *mut image.Image, ws: *mut image.Image, prev: *mut image.Image, has_prev: bool) -> image.Image {
    var nxt: image.Image = image.img_new((*a).w, (*a).h, 3)
    var k: ReconCtx = ReconCtx { a: a, ws: ws, prev: prev, has_prev: has_prev, nxt: &nxt }
    par.rows((*a).h, 8, recon_rows, (&k) as u64)
    return nxt
}

// ---------------------------------------------------------------- robust stack (reference + consistent detail)
//
// WHY: with the first version (weights per pyramid level, low-pass = mean of all frames, no brightness / motion
// check) a bright TV in a dark room came out with halos, colour fringes, smeared text and a veil: strongly
// defocused frames spill a glow around bright parts that survives in the coarse levels, frames with another AE /
// display flicker / moving video disagree with the reference and were averaged in as ghosts.
// NOW: (1) the reference is the sharpest frame of the middle half, (2) every frame is brightness-normalised to it
// (global median ratio + a smooth local gain map, both on a coarse grid), (3) a consistency map on that grid
// (blurred luma difference to the reference, tolerant to defocus differences) switches off frames that disagree,
// (4) ONE weight map (noise-floor-free sharpness of the two finest levels, reference favoured where nothing is
// sharp) is reduced to all levels, (5) the coarsest low-pass comes from the reference only.

fn lev_size(w: i32, h: i32, k: i32, ow: *mut i32, oh: *mut i32) {
    var cw: i32 = w
    var ch: i32 = h
    var i: i32 = 0
    while i < k {
        cw = (cw + 1) / 2
        ch = (ch + 1) / 2
        i = i + 1
    }
    *ow = cw
    *oh = ch
}

// blur (sigma 1) + 2x subsample of a 1 channel image
fn down1(src: *mut image.Image) -> image.Image {
    let w: i32 = ((*src).w + 1) / 2
    let h: i32 = ((*src).h + 1) / 2
    var d: image.Image = image.img_new(w, h, 1)
    var bl: image.Image = filter.gauss_blur(src, 1.0f)
    var y: i32 = 0
    while y < h {
        var x: i32 = 0
        while x < w {
            image.img_set(&d, 0, x, y, image.img_getc(&bl, 0, 2 * x, 2 * y))
            x = x + 1
        }
        y = y + 1
    }
    image.img_free(&bl)
    return d
}

// mean luma on a coarse grid of f x f pixel cells
fn grid_luma(im: *mut image.Image, f: i32) -> image.Image {
    let gw: i32 = ((*im).w + f - 1) / f
    let gh: i32 = ((*im).h + f - 1) / f
    var g: image.Image = image.img_new(gw, gh, 1)
    var y: i32 = 0
    while y < gh {
        var x: i32 = 0
        while x < gw {
            var s: f32 = 0.0f
            var n: f32 = 0.0f
            var yy: i32 = y * f
            while yy < (y + 1) * f && yy < (*im).h {
                var xx: i32 = x * f
                while xx < (x + 1) * f && xx < (*im).w {
                    s = s + 0.2126f * image.img_get(im, 0, xx, yy) + 0.7152f * image.img_get(im, 1, xx, yy) + 0.0722f * image.img_get(im, 2, xx, yy)
                    n = n + 1.0f
                    xx = xx + 1
                }
                yy = yy + 1
            }
            image.img_set(&g, 0, x, y, s / n)
            x = x + 1
        }
        y = y + 1
    }
    return g
}

// median of the log ratio reference / frame over the pixels that are neither dark nor bright (robust against the
// TV, moving parts and clipping): the global exposure ratio of the two grids
fn global_gain(gr: *mut image.Image, gl: *mut image.Image) -> f32 {
    var hist: [i32; 129] = [0; 129]
    var cnt: i32 = 0
    let n: i32 = (*gr).w * (*gr).h
    var i: i32 = 0
    while i < n {
        let a: f32 = *(((*gr).px + (i as u64) * (4 as u64)) as *mut f32)
        let b: f32 = *(((*gl).px + (i as u64) * (4 as u64)) as *mut f32)
        if a > 0.02f && a < 0.7f && b > 0.02f && b < 0.7f {
            var t: f32 = ((math.ln((a / b) as f64) as f32) + 0.64f) / 0.01f
            if t < 0.0f { t = 0.0f }
            if t > 128.0f { t = 128.0f }
            let k: i32 = t as i32
            hist[k as usize] = hist[k as usize] + 1
            cnt = cnt + 1
        }
        i = i + 1
    }
    if cnt < 16 { return 1.0f }
    var acc: i32 = 0
    var k: i32 = 0
    while k < 129 {
        acc = acc + hist[k as usize]
        if acc * 2 >= cnt { break }
        k = k + 1
    }
    let lr: f32 = (k as f32) * 0.01f - 0.64f + 0.005f
    return math.exp(lr as f64) as f32
}

// smooth local gain map reference / frame on the grid (display flicker bands, brightness fades), clamped
fn gain_grid(gr: *mut image.Image, gl: *mut image.Image, sg: f32) -> image.Image {
    var br: image.Image = filter.gauss_blur(gr, sg)
    var bl: image.Image = filter.gauss_blur(gl, sg)
    var g: image.Image = image.img_new((*gr).w, (*gr).h, 1)
    var y: i32 = 0
    while y < (*gr).h {
        var x: i32 = 0
        while x < (*gr).w {
            var v: f32 = (image.img_get(&br, 0, x, y) + 0.004f) / (image.img_get(&bl, 0, x, y) + 0.004f)
            if v < 0.5f { v = 0.5f }
            if v > 2.0f { v = 2.0f }
            image.img_set(&g, 0, x, y, v)
            x = x + 1
        }
        y = y + 1
    }
    image.img_free(&br)
    image.img_free(&bl)
    return g
}

fn scale_img(im: *mut image.Image, g: f32) {
    let n: i32 = (*im).w * (*im).h * (*im).ch
    var i: i32 = 0
    while i < n {
        let p: *mut f32 = ((*im).px + (i as u64) * (4 as u64)) as *mut f32
        *p = *p * g
        i = i + 1
    }
}

struct GainCtx {
    im: *mut image.Image,
    gg: *mut image.Image,
    f: i32,
}

fn gain_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut GainCtx = ctx as *mut GainCtx
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < (*(*k).im).w {
            let g: f32 = image.img_sample((*k).gg, 0, ((x as f32) + 0.5f) / ((*k).f as f32) - 0.5f, ((y as f32) + 0.5f) / ((*k).f as f32) - 0.5f)
            var c: i32 = 0
            while c < 3 {
                image.img_set((*k).im, c, x, y, image.img_get((*k).im, c, x, y) * g)
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn apply_gain(im: *mut image.Image, gg: *mut image.Image, f: i32) {
    var k: GainCtx = GainCtx { im: im, gg: gg, f: f }
    par.rows((*im).h, 8, gain_rows, (&k) as u64)
}

// mean RGB of f x f blocks (3 channels)
fn grid_rgb(im: *mut image.Image, f: i32) -> image.Image {
    let gw: i32 = ((*im).w + f - 1) / f
    let gh: i32 = ((*im).h + f - 1) / f
    var g: image.Image = image.img_new(gw, gh, 3)
    var y: i32 = 0
    while y < gh {
        var x: i32 = 0
        while x < gw {
            var c: i32 = 0
            while c < 3 {
                var s: f32 = 0.0f
                var n: f32 = 0.0f
                var yy: i32 = y * f
                while yy < (y + 1) * f && yy < (*im).h {
                    var xx: i32 = x * f
                    while xx < (x + 1) * f && xx < (*im).w {
                        s = s + image.img_get(im, c, xx, yy)
                        n = n + 1.0f
                        xx = xx + 1
                    }
                    yy = yy + 1
                }
                image.img_set(&g, c, x, y, s / n)
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return g
}

fn blur3(g: *mut image.Image, sigma: f32) -> image.Image {
    var out: image.Image = image.img_new((*g).w, (*g).h, 3)
    var c: i32 = 0
    while c < 3 {
        var ch: image.Image = image.img_new((*g).w, (*g).h, 1)
        var y: i32 = 0
        while y < (*g).h {
            var x: i32 = 0
            while x < (*g).w {
                image.img_set(&ch, 0, x, y, image.img_get(g, c, x, y))
                x = x + 1
            }
            y = y + 1
        }
        let bl: image.Image = filter.gauss_blur(&ch, sigma)
        y = 0
        while y < (*g).h {
            var x: i32 = 0
            while x < (*g).w {
                image.img_set(&out, c, x, y, image.img_get(&bl, 0, x, y))
                x = x + 1
            }
            y = y + 1
        }
        image.img_free(&ch)
        image.img_free(&bl)
        c = c + 1
    }
    return out
}

// Consistency of a frame with the reference on the block grid: 1 = same content (up to 15 % * tau relative
// difference in ANY colour channel), -> 0 = moving content / flicker / exposure change. Colour channels matter
// (a video block can change hue at equal luma); the map is eroded by one cell so blends near moving edges are rejected.
fn consist_grid(gref_c: *mut image.Image, gl: *mut image.Image, tau: f32) -> image.Image {
    var a: image.Image = blur3(gl, 1.2f)
    var c: image.Image = image.img_new((*gl).w, (*gl).h, 1)
    var y: i32 = 0
    while y < (*gl).h {
        var x: i32 = 0
        while x < (*gl).w {
            var t: f32 = 0.0f
            var ch: i32 = 0
            while ch < 3 {
                let va: f32 = image.img_get(&a, ch, x, y)
                let vb: f32 = image.img_get(gref_c, ch, x, y)
                var d: f32 = va - vb
                if d < 0.0f { d = 0.0f - d }
                let tc: f32 = d / ((0.003f + 0.15f * 0.5f * (va + vb)) * tau)
                if tc > t { t = tc }
                ch = ch + 1
            }
            image.img_set(&c, 0, x, y, image.expneg(t * t))
            x = x + 1
        }
        y = y + 1
    }
    image.img_free(&a)
    // erode: minimum over the 3x3 neighbourhood
    var e: image.Image = image.img_new((*gl).w, (*gl).h, 1)
    y = 0
    while y < (*gl).h {
        var x: i32 = 0
        while x < (*gl).w {
            var m: f32 = 1.0f
            var dy: i32 = -1
            while dy <= 1 {
                var dx: i32 = -1
                while dx <= 1 {
                    var xx: i32 = x + dx
                    var yy: i32 = y + dy
                    if xx < 0 { xx = 0 }
                    if yy < 0 { yy = 0 }
                    if xx >= (*gl).w { xx = (*gl).w - 1 }
                    if yy >= (*gl).h { yy = (*gl).h - 1 }
                    let v: f32 = image.img_get(&c, 0, xx, yy)
                    if v < m { m = v }
                    dx = dx + 1
                }
                dy = dy + 1
            }
            image.img_set(&e, 0, x, y, m)
            x = x + 1
        }
        y = y + 1
    }
    image.img_free(&c)
    return e
}

// sharpest frame of the middle half (relative to its mean brightness), else frame n / 2
fn pick_ref(b: *mut merge.Burst, o: *mut FocusOpts) -> i32 {
    let n: i32 = (*b).n
    if (*o).ref_idx >= 0 && (*o).ref_idx < n { return (*o).ref_idx }
    if (*o).auto_ref == 0 { return n / 2 }
    var best: i32 = n / 2
    var bs: f32 = -1.0f
    var i: i32 = n / 4
    var i_end: i32 = n - 1 - n / 4
    if (*o).auto_ref >= 2 {
        i = 0
        i_end = n - 1
    }
    while i <= i_end {
        let s: f32 = image.sharpness(&(*b).frames[i as usize], 1)
        let m: f32 = image.img_mean(&(*b).frames[i as usize], 1)
        let rs: f32 = s / (m * m + 1.0e-6f)
        if rs > bs {
            bs = rs
            best = i
        }
        i = i + 1
    }
    return best
}

struct WeightCtx {
    o: *mut FocusOpts,
    gl: *mut image.Image,
    gf: i32,
    cg: *mut image.Image,
    has_c: bool,
    is_ref: bool,
    sq: bool,
    e0: *mut image.Image,
    e1: *mut image.Image,
    wm: *mut image.Image,
}

fn weight_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut WeightCtx = ctx as *mut WeightCtx
    let o: *mut FocusOpts = (*k).o
    let gf: i32 = (*k).gf
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < (*(*k).wm).w {
            var s: f32 = image.img_get((*k).e0, 0, x, y) + 2.0f * image.img_sample((*k).e1, 0, ((x as f32) + 0.5f) * 0.5f - 0.5f, ((y as f32) + 0.5f) * 0.5f - 0.5f)
            if (*o).noise_s > 0.0f || (*o).noise_o > 0.0f {
                var lum: f32 = image.img_sample((*k).gl, 0, ((x as f32) + 0.5f) / (gf as f32) - 0.5f, ((y as f32) + 0.5f) / (gf as f32) - 0.5f)
                if lum < 0.0f { lum = 0.0f }
                s = s - (*o).noise_k * image.sqrtf((*o).noise_s * lum + (*o).noise_o)
                if s < 0.0f { s = 0.0f }
            }
            var ev: f32 = s * 30.0f + 1.0e-3f
            if (*k).is_ref { ev = ev + 30.0f * (*o).ref_floor }
            var wt: f32 = ev * ev
            if (*k).sq { wt = wt * wt }
            if (*k).is_ref { wt = wt * (*o).ref_boost }
            if (*k).has_c && !(*k).is_ref {
                wt = wt * image.img_sample((*k).cg, 0, ((x as f32) + 0.5f) / (gf as f32) - 0.5f, ((y as f32) + 0.5f) / (gf as f32) - 0.5f)
            }
            image.img_set((*k).wm, 0, x, y, wt)
            x = x + 1
        }
        y = y + 1
    }
}

// weights of one frame for every level (1 channel images, same sizes as the pyramid)
fn weight_pyr(lp: *mut Lap, levels: i32, o: *mut FocusOpts, gl: *mut image.Image, gf: i32, cg: *mut image.Image, has_c: bool, is_ref: bool) -> Lap {
    var wp: Lap = Lap { n: levels, l: [zero_im(); 5] }
    let w0: i32 = (*lp).l[0].w
    let h0: i32 = (*lp).l[0].h
    var sq: bool = false
    if (*o).power > 3.0f { sq = true }
    if (*o).one_map != 0 && levels >= 3 {
        var e0: image.Image = energy_of(&(*lp).l[0], (*o).energy_sigma)
        var e1: image.Image = energy_of(&(*lp).l[1], (*o).energy_sigma)
        var wm: image.Image = image.img_new(w0, h0, 1)
        var wc: WeightCtx = WeightCtx { o: o, gl: gl, gf: gf, cg: cg, has_c: has_c, is_ref: is_ref, sq: sq, e0: &e0, e1: &e1, wm: &wm }
        par.rows(h0, 8, weight_rows, (&wc) as u64)
        image.img_free(&e0)
        image.img_free(&e1)
        wp.l[0] = filter.gauss_blur(&wm, 2.0f)
        image.img_free(&wm)
        var k: i32 = 1
        while k < levels {
            if k >= (*o).avg_from {
                let wl: *mut image.Image = &(*lp).l[k as usize]
                var wa: image.Image = image.img_new((*wl).w, (*wl).h, 1)
                let sc: f32 = (gf as f32) / ((1 << (k as u32)) as f32)
                var yy: i32 = 0
                while yy < (*wl).h {
                    var xx: i32 = 0
                    while xx < (*wl).w {
                        var wv: f32 = (*o).avg_ref_w
                        if !is_ref {
                            wv = 1.0f
                            if has_c { wv = image.img_sample(cg, 0, ((xx as f32) + 0.5f) / sc - 0.5f, ((yy as f32) + 0.5f) / sc - 0.5f) }
                        }
                        image.img_set(&wa, 0, xx, yy, wv)
                        xx = xx + 1
                    }
                    yy = yy + 1
                }
                wp.l[k as usize] = wa
            } else {
                wp.l[k as usize] = down1(&wp.l[(k - 1) as usize])
            }
            k = k + 1
        }
        return wp
    }
    // per level weights (the first stack)
    var k: i32 = 0
    while k < levels {
        let band: *mut image.Image = &(*lp).l[k as usize]
        var wk: image.Image = image.img_new((*band).w, (*band).h, 1)
        if k < levels - 1 {
            var e: image.Image = energy_of(band, (*o).energy_sigma)
            var y: i32 = 0
            while y < (*band).h {
                var x: i32 = 0
                while x < (*band).w {
                    let ev: f32 = image.img_get(&e, 0, x, y) * 30.0f + 1.0e-4f
                    var wt: f32 = ev * ev
                    if sq { wt = wt * wt }
                    if has_c && !is_ref {
                        let sc: f32 = (gf as f32) / ((1 << (k as u32)) as f32)
                        wt = wt * image.img_sample(cg, 0, ((x as f32) + 0.5f) / sc - 0.5f, ((y as f32) + 0.5f) / sc - 0.5f)
                    }
                    image.img_set(&wk, 0, x, y, wt)
                    x = x + 1
                }
                y = y + 1
            }
            image.img_free(&e)
        } else {
            image.img_fill(&wk, 1.0f)
        }
        wp.l[k as usize] = wk
        k = k + 1
    }
    return wp
}

struct AccCtx {
    band: *mut image.Image,
    wk: *mut image.Image,
    acc: *mut image.Image,
    wsum: *mut image.Image,
    dnum: *mut image.Image,
    last: bool,
    first: bool,
    fi: f32,
}

fn acc_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut AccCtx = ctx as *mut AccCtx
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < (*(*k).band).w {
            var wt: f32 = image.img_get((*k).wk, 0, x, y)
            if (*k).last { wt = 1.0f }
            var c: i32 = 0
            while c < 3 {
                image.img_set((*k).acc, c, x, y, image.img_get((*k).acc, c, x, y) + wt * image.img_get((*k).band, c, x, y))
                c = c + 1
            }
            image.img_set((*k).wsum, 0, x, y, image.img_get((*k).wsum, 0, x, y) + wt)
            if (*k).first {
                image.img_set((*k).dnum, 0, x, y, image.img_get((*k).dnum, 0, x, y) + wt * (*k).fi)
            }
            x = x + 1
        }
        y = y + 1
    }
}

// Add the Laplacian pyramid `lp` of frame `i` (weights `wp`) to the weighted accumulators.
fn accumulate_frame(lp: *mut Lap, wp: *mut Lap, i: i32, levels: i32, base_ref: bool, is_ref: bool, acc: *mut Lap, wsum: *mut Lap, dnum: *mut image.Image) {
    var k: i32 = 0
    while k < levels {
        let band: *mut image.Image = &(*lp).l[k as usize]
        let last: bool = k == levels - 1
        if last && base_ref && !is_ref {
            k = k + 1
            continue
        }
        var c: AccCtx = AccCtx { band: band, wk: &(*wp).l[k as usize], acc: &(*acc).l[k as usize], wsum: &(*wsum).l[k as usize], dnum: dnum, last: last, first: k == 0, fi: i as f32 }
        par.rows((*band).h, 8, acc_rows, (&c) as u64)
        k = k + 1
    }
}

// Pyramid depth: halve until the smaller side would drop below 32 pixels (at most MAXLEV levels).
fn pyr_levels(w: i32, h: i32) -> i32 {
    var lv: i32 = 1
    var m: i32 = w
    if h < m { m = h }
    while lv < MAXLEV {
        if m < 32 { break }
        m = (m + 1) / 2
        lv = lv + 1
    }
    return lv
}

// ---------------------------------------------------------------- safety net (stack never worse than its reference)
//
// The stack is the weighted fusion of aligned frames; when alignment fails (heavy motion), a frame is moving or
// flickering in a way the consistency map misses, or the fusion simply smears, it can end up WORSE than the single
// reference frame. No ground truth exists in the app, so the check uses the frames only:
//   (a) low-pass deviation: |blur(stack) - blur(ref)| per colour channel against 4 % * net_tol of the value + a
//       noise floor. A good stack keeps the reference's low frequencies (ghosts, halos, colour fringes and a veil
//       all change them); beyond 2x the tolerance the pixel is taken from the reference.
//   (b) sharpness: where the reference has real texture (energy > 3x the noise floor) the stack must keep >= 80 %
//       of its energy (< 60 %: reference). In flat areas the stack must not be NOISIER than the reference (energy
//       ratio > 1.5: reference); there it is supposed to be smoother.
// The two confidences are combined (min), smoothed (sigma 2: no seams) and blend stack -> reference per pixel.
// fallback_frac() = share of pixels with confidence < 0.5; above 60 % the whole frame is the reference
// (fallback_global_count()).

fn net_energy(im: *mut image.Image) -> image.Image {
    var l: image.Image = image.img_luma(im)
    var bl: image.Image = filter.gauss_blur(&l, 1.0f)
    var e: image.Image = image.img_new((*im).w, (*im).h, 1)
    var i: i32 = 0
    let n: i32 = (*im).w * (*im).h
    while i < n {
        let a: f32 = *(((l.px) + (i as u64) * (4 as u64)) as *mut f32)
        let b: f32 = *(((bl.px) + (i as u64) * (4 as u64)) as *mut f32)
        var d: f32 = a - b
        if d < 0.0f { d = 0.0f - d }
        *(((e.px) + (i as u64) * (4 as u64)) as *mut f32) = d
        i = i + 1
    }
    let r: image.Image = filter.gauss_blur(&e, 2.0f)
    image.img_free(&l)
    image.img_free(&bl)
    image.img_free(&e)
    return r
}

struct NetCtx {
    out: *mut image.Image,
    rf: *mut image.Image,
    los: *mut image.Image,
    lor: *mut image.Image,
    es: *mut image.Image,
    er: *mut image.Image,
    lr: *mut image.Image,
    cm: *mut image.Image,
    ns: f32,
    no: f32,
    tol: f32,
}

fn net_rows(ctx: u64, lo: u64, hi: u64) {
    let k: *mut NetCtx = ctx as *mut NetCtx
    let w: i32 = (*(*k).out).w
    var y: i32 = lo as i32
    while y < (hi as i32) {
        var x: i32 = 0
        while x < w {
            var lum: f32 = image.img_get((*k).lr, 0, x, y)
            if lum < 0.0f { lum = 0.0f }
            let nf: f32 = image.sqrtf((*k).ns * lum + (*k).no)
            var dev: f32 = 0.0f
            var ch: i32 = 0
            while ch < 3 {
                let a: f32 = image.img_get((*k).los, ch, x, y)
                let b: f32 = image.img_get((*k).lor, ch, x, y)
                var d: f32 = a - b
                if d < 0.0f { d = 0.0f - d }
                // the low-pass of the reference carries noise of ~ nf / 9 (sigma 2.5); 4 % relative drift is the limit
                let t: f32 = d / (0.002f + 0.5f * nf + 0.02f * (a + b) * (*k).tol)
                if t > dev { dev = t }
                ch = ch + 1
            }
            var c1: f32 = 2.0f - dev
            if c1 < 0.0f { c1 = 0.0f }
            if c1 > 1.0f { c1 = 1.0f }
            let er: f32 = image.img_get((*k).er, 0, x, y)
            let es: f32 = image.img_get((*k).es, 0, x, y)
            var c2: f32 = 1.0f
            if er > 3.0f * nf + 1.0e-4f {
                // textured: the stack must keep the reference's detail
                c2 = (es / er - 0.6f) / 0.2f
                if c2 < 0.0f { c2 = 0.0f }
                if c2 > 1.0f { c2 = 1.0f }
            } else {
                // flat: the stack must not be noisier than the reference (fusion that picks noise peaks)
                c2 = (1.5f - es / (er + 0.5f * nf + 1.0e-5f)) / 0.3f
                if c2 < 0.0f { c2 = 0.0f }
                if c2 > 1.0f { c2 = 1.0f }
            }
            var c: f32 = c1
            if c2 < c { c = c2 }
            image.img_set((*k).cm, 0, x, y, c)
            x = x + 1
        }
        y = y + 1
    }
}

fn safety_net(out: *mut image.Image, rf: *mut image.Image, o: *mut FocusOpts) {
    let w: i32 = (*out).w
    let h: i32 = (*out).h
    var los: image.Image = blur3(out, 2.5f)
    var lor: image.Image = blur3(rf, 2.5f)
    var es: image.Image = net_energy(out)
    var er: image.Image = net_energy(rf)
    var lr: image.Image = image.img_luma(rf)
    var cm: image.Image = image.img_new(w, h, 1)
    var k: NetCtx = NetCtx { out: out, rf: rf, los: &los, lor: &lor, es: &es, er: &er, lr: &lr, cm: &cm, ns: (*o).noise_s, no: (*o).noise_o, tol: (*o).net_tol }
    par.rows(h, 8, net_rows, (&k) as u64)
    var cb: image.Image = filter.gauss_blur(&cm, 2.0f)
    var low: i32 = 0
    var y: i32 = 0
    while y < h {
        var x: i32 = 0
        while x < w {
            let c: f32 = image.img_get(&cb, 0, x, y)
            if c < 0.5f { low = low + 1 }
            var ch: i32 = 0
            while ch < 3 {
                let a: f32 = image.img_get(out, ch, x, y)
                let b: f32 = image.img_get(rf, ch, x, y)
                image.img_set(out, ch, x, y, b + (a - b) * c)
                ch = ch + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    fb_frac = (low as f32) / ((w * h) as f32)
    if fb_frac > 0.001f { fb_calls = fb_calls + 1 }
    if fb_frac > 0.6f {
        fb_global = fb_global + 1
        y = 0
        while y < h {
            var x: i32 = 0
            while x < w {
                var ch: i32 = 0
                while ch < 3 {
                    image.img_set(out, ch, x, y, image.img_get(rf, ch, x, y))
                    ch = ch + 1
                }
                x = x + 1
            }
            y = y + 1
        }
    }
    image.img_free(&los)
    image.img_free(&lor)
    image.img_free(&es)
    image.img_free(&er)
    image.img_free(&lr)
    image.img_free(&cm)
    image.img_free(&cb)
}

fn focus_stack(b: *mut merge.Burst, o: *mut FocusOpts, out: *mut image.Image, depth: *mut image.Image) {
    let n: i32 = (*b).n
    let r: i32 = pick_ref(b, o)
    let w: i32 = (*b).frames[r as usize].w
    let h: i32 = (*b).frames[r as usize].h
    let levels: i32 = pyr_levels(w, h)
    var gf: i32 = w / 160
    if gf < 3 { gf = 3 } // defocus blur must not look like changed content: cells of >= 3 px
    if gf > 8 { gf = 8 }
    var lr: image.Image = image.img_luma(&(*b).frames[r as usize])
    if (*o).align_blur > 0.0f {
        let lb: image.Image = filter.gauss_blur(&lr, (*o).align_blur)
        image.img_free(&lr)
        lr = lb
    }
    var pr: align.Pyr = align.pyr_build(&lr)
    image.img_free(&lr)
    // reference grids: plain luma, blurred for the consistency check
    var gref: image.Image = grid_luma(&(*b).frames[r as usize], gf)
    var gref3: image.Image = grid_rgb(&(*b).frames[r as usize], gf)
    var gref_c: image.Image = blur3(&gref3, 1.2f)
    image.img_free(&gref3)
    var acc: Lap = Lap { n: levels, l: [zero_im(); 5] }
    var wsum: Lap = Lap { n: levels, l: [zero_im(); 5] }
    var lv0: i32 = 0
    while lv0 < levels {
        var lw: i32 = 0
        var lh: i32 = 0
        lev_size(w, h, lv0, &lw, &lh)
        acc.l[lv0 as usize] = image.img_new(lw, lh, 3)
        wsum.l[lv0 as usize] = image.img_new(lw, lh, 1)
        image.img_fill(&acc.l[lv0 as usize], 0.0f)
        image.img_fill(&wsum.l[lv0 as usize], 0.0f)
        lv0 = lv0 + 1
    }
    var dnum: image.Image = image.img_new(w, h, 1)
    image.img_fill(&dnum, 0.0f)
    var i: i32 = 0
    while i < n {
        var wf: image.Image = image.img_copy(&(*b).frames[i as usize])
        if i != r {
            var la: image.Image = image.img_luma(&(*b).frames[i as usize])
            if (*o).align_blur > 0.0f {
                let lb: image.Image = filter.gauss_blur(&la, (*o).align_blur)
                image.img_free(&la)
                la = lb
            }
            var pa: align.Pyr = align.pyr_build(&la)
            image.img_free(&la)
            var fl: align.Flow = align.align_flow(&pr, &pa)
            align.pyr_free(&pa)
            image.img_free(&wf)
            wf = warp_to_ref(&(*b).frames[i as usize], &fl, (*o).warp_cubic != 0)
            align.flow_free(&fl)
        }
        var gl: image.Image = grid_luma(&wf, gf)
        var cg: image.Image = image.img_new(1, 1, 1)
        var has_c: bool = false
        if i != r {
            if (*o).norm_expo != 0 {
                let g: f32 = global_gain(&gref, &gl)
                scale_img(&wf, g)
                scale_img(&gl, g)
                var gg: image.Image = gain_grid(&gref, &gl, 3.0f)
                apply_gain(&wf, &gg, gf)
                image.img_free(&gg)
                image.img_free(&gl)
                gl = grid_luma(&wf, gf)
            }
            if (*o).consist != 0 {
                image.img_free(&cg)
                var gl3: image.Image = grid_rgb(&wf, gf)
                cg = consist_grid(&gref_c, &gl3, (*o).consist_tau)
                image.img_free(&gl3)
                has_c = true
            }
        }
        var lp: Lap = lap_build(&wf, levels)
        image.img_free(&wf)
        var wp: Lap = weight_pyr(&lp, levels, o, &gl, gf, &cg, has_c, i == r && (*o).one_map != 0)
        accumulate_frame(&lp, &wp, i, levels, (*o).base_ref != 0, i == r, &acc, &wsum, &dnum)
        lap_free(&lp)
        lap_free(&wp)
        image.img_free(&gl)
        image.img_free(&cg)
        i = i + 1
    }
    align.pyr_free(&pr)
    image.img_free(&gref)
    image.img_free(&gref_c)
    // normalise and reconstruct from the coarsest level (the result lives in *out while it is built)
    *out = zero_im()
    var lv: i32 = levels - 1
    while lv >= 0 {
        var has_prev: bool = false
        if lv < levels - 1 { has_prev = true }
        var nxt: image.Image = recon_level(&acc.l[lv as usize], &wsum.l[lv as usize], out, has_prev)
        if has_prev { image.img_free(out) }
        *out = nxt
        lv = lv - 1
    }
    *depth = image.img_new(w, h, 1)
    var y: i32 = 0
    while y < h {
        var x: i32 = 0
        while x < w {
            image.img_set(depth, 0, x, y, image.img_get(&dnum, 0, x, y) / image.img_get(&wsum.l[0], 0, x, y))
            x = x + 1
        }
        y = y + 1
    }
    image.img_free(&dnum)
    lap_free(&acc)
    lap_free(&wsum)
    fb_frac = 0.0f
    if (*o).net != 0 { safety_net(out, &(*b).frames[r as usize], o) }
}
