// SPDX-License-Identifier: MPL-2.0
// lib/photo/tonemap.fi -- photo.tonemap: natural local tone mapping without halos.
//
//     var o: tonemap.ToneOpts = tonemap.tone_default()
//     tonemap.tonemap(&linear_image, &o)       // in place: linear radiance (may exceed 1) -> linear 0..1
//
// Base / detail split in the LOG domain: base = guided filter of ln(Y) (edge preserving, so a bright sky next to a
// dark roof produces no halo), detail = ln(Y) - base. The base is compressed around the highlights: the
// 99th percentile of the base maps to `white` (0.92), and the slope `c` (1 = no compression) is chosen so that the
// MEDIAN lands at `mid` (0.18) but never below `min_slope` (0.45): shadows are lifted softly, never flattened.
// The detail layer is kept (gain `detail`, default 1.05), so texture stays crisp while the contrast between
// regions shrinks. The shadow lift is CAPPED: at the median the base is raised by at most `max_lift` (1.3 = +30 %),
// so a dark room with a bright TV stays a dark room (the mood of the scene is kept) instead of turning into a
// flat grey picture with a raised black point. Colour: RGB is scaled by Y'/Y, with the chroma ratio raised to `sat` (0.95) so lifted
// shadows do not turn neon. A soft knee rolls the last 8 % into white. No exposure constants of a device:
// everything comes from the percentiles of the picture itself.
import std.rt
import std.math
import photo.image
import photo.filter
import photo.par

export {
    ToneOpts, tone_default, tonemap,
}

struct ToneOpts {
    strength: f32,
    detail: f32,
    sat: f32,
    white: f32,
    mid: f32,
    min_slope: f32,
    max_gain: f32,
    max_lift: f32,
}

fn tone_default() -> ToneOpts {
    return ToneOpts { strength: 1.0f, detail: 1.05f, sat: 0.95f, white: 0.92f, mid: 0.18f, min_slope: 0.45f, max_gain: 8.0f, max_lift: 1.3f }
}

fn flnf(x: f32) -> f32 {
    return math.ln(x as f64) as f32
}

fn fexpf(x: f32) -> f32 {
    return math.exp(x as f64) as f32
}

// value of the histogram percentile q (0..1) of a plane (bins over [lo, hi])
fn percentile(p: *mut image.Image, lo: f32, hi: f32, q: f32) -> f32 {
    var hist: [i32; 256] = [0; 256]
    let n: i32 = (*p).w * (*p).h
    let sc: f32 = 255.0f / (hi - lo + 1.0e-9f)
    var i: i32 = 0
    while i < n {
        var b: i32 = ((*(((*p).px + (i as u64) * (4 as u64)) as *mut f32) - lo) * sc) as i32
        if b < 0 { b = 0 }
        if b > 255 { b = 255 }
        hist[b as usize] = hist[b as usize] + 1
        i = i + 1
    }
    let target: i32 = ((n as f32) * q) as i32
    var acc: i32 = 0
    var k: i32 = 0
    while k < 256 {
        acc = acc + hist[k as usize]
        if acc >= target { break }
        k = k + 1
    }
    return lo + ((k as f32) + 0.5f) / sc
}

struct LogCtx {
    yl: *mut image.Image,
    ll: *mut image.Image,
}

fn log_range(ctx: u64, lo: u64, hi: u64) {
    let k: *mut LogCtx = ctx as *mut LogCtx
    var n: u64 = lo
    while n < hi {
        let o4: u64 = n * (4 as u64)
        var v: f32 = *(((*(*k).yl).px + o4) as *mut f32)
        if v < 1.0e-5f { v = 1.0e-5f }
        *(((*(*k).ll).px + o4) as *mut f32) = flnf(v)
        n = n + 1
    }
}

struct ToneCtx {
    im: *mut image.Image,
    yl: *mut image.Image,
    ll: *mut image.Image,
    base: *mut image.Image,
    o: *mut ToneOpts,
    lw: f32,
    p99: f32,
    c: f32,
}

fn tone_range(ctx: u64, lo: u64, hi: u64) {
    let k: *mut ToneCtx = ctx as *mut ToneCtx
    let im: *mut image.Image = (*k).im
    let o: *mut ToneOpts = (*k).o
    let w: i32 = (*im).w
    let h: i32 = (*im).h
    var n: u64 = lo
    while n < hi {
        let o4: u64 = n * (4 as u64)
        let b: f32 = *(((*(*k).base).px + o4) as *mut f32)
        let l: f32 = *(((*(*k).ll).px + o4) as *mut f32)
        var d: f32 = (l - b) * (*o).detail
        d = image.fclampf(d, -1.2f, 1.2f)
        let nb: f32 = (*k).lw + (b - (*k).p99) * (*k).c
        var ny: f32 = fexpf(nb + d)
        // soft knee for the top 8 %
        if ny > 0.85f {
            let t: f32 = ny - 0.85f
            ny = 0.85f + 0.15f * (1.0f - image.expneg(t * 6.0f)) * 1.0f
            if ny > 1.0f { ny = 1.0f }
        }
        var y0: f32 = *(((*(*k).yl).px + o4) as *mut f32)
        if y0 < 1.0e-5f { y0 = 1.0e-5f }
        var ch: i32 = 0
        while ch < 3 {
            let cv: f32 = *(((*im).px + ((ch * w * h) as u64) * (4 as u64) + o4) as *mut f32)
            var ratio: f32 = cv / y0
            if ratio < 0.0f { ratio = 0.0f }
            // chroma ratio ** sat
            var rs: f32 = ratio
            if (*o).sat < 0.999f && ratio > 1.0e-4f {
                rs = fexpf((*o).sat * flnf(ratio))
            }
            *(((*im).px + ((ch * w * h) as u64) * (4 as u64) + o4) as *mut f32) = image.fclampf(ny * rs, 0.0f, 1.0f)
            ch = ch + 1
        }
        n = n + 1
    }
}

fn tonemap(im: *mut image.Image, o: *mut ToneOpts) {
    let w: i32 = (*im).w
    let h: i32 = (*im).h
    var yl: image.Image = image.img_luma(im)
    var ll: image.Image = image.img_new(w, h, 1)
    var lg: LogCtx = LogCtx { yl: &yl, ll: &ll }
    par.rows(w * h, 65536, log_range, (&lg) as u64)
    var lo: f32 = 1.0e30f
    var hi: f32 = -1.0e30f
    var n: i32 = 0
    while n < w * h {
        let l: f32 = *((ll.px + (n as u64) * (4 as u64)) as *mut f32)
        if l < lo { lo = l }
        if l > hi { hi = l }
        n = n + 1
    }
    var r: i32 = (w + h) / 64
    if r < 3 { r = 3 }
    var base: image.Image = filter.guided(&ll, &ll, r, 0.04f)
    let p99: f32 = percentile(&base, lo, hi, 0.99f)
    let p50: f32 = percentile(&base, lo, hi, 0.50f)
    // output white level: highlights never get a stronger lift than max_gain
    var white: f32 = (*o).white
    let cap: f32 = fexpf(p99) * (*o).max_gain
    if cap < white { white = cap }
    let lw: f32 = flnf(white)
    var c: f32 = 1.0f
    let dlt: f32 = p99 - p50
    if dlt > 0.05f {
        c = (lw - flnf((*o).mid)) / dlt
        if c < (*o).min_slope { c = (*o).min_slope }
        if c > 1.0f { c = 1.0f }
    }
    // cap the lift of the median: lift(p50) = (lw - p99) + (1 - c) * dlt must stay <= ln(max_lift)
    if dlt > 0.05f && (*o).max_lift > 0.0f {
        let lim: f32 = 1.0f - (flnf((*o).max_lift) - (lw - p99)) / dlt
        if c < lim { c = lim }
        if c > 1.0f { c = 1.0f }
    }
    c = 1.0f - (*o).strength * (1.0f - c)
    var tc: ToneCtx = ToneCtx { im: im, yl: &yl, ll: &ll, base: &base, o: o, lw: lw, p99: p99, c: c }
    par.rows(w * h, 65536, tone_range, (&tc) as u64)
    image.img_free(&yl)
    image.img_free(&ll)
    image.img_free(&base)
}
