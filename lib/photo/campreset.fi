// lib/photo/campreset.fi -- photo.campreset: speed presets of the RAW photo job (Fast, Balanced, Ultra).
import photo.camjob

export {
    FAST, BALANCED, ULTRA, COUNT, frames, max_px, name, next, clamp, apply, preview_max_px, apply_preview,
}

const FAST: i32 = 0
const BALANCED: i32 = 1
const ULTRA: i32 = 2
const COUNT: i32 = 3

fn clamp(p: i32) -> i32 {
    if p < 0 || p >= COUNT { return ULTRA }
    return p
}

fn next(p: i32) -> i32 {
    return (clamp(p) + 1) % COUNT
}

fn name(p: i32) -> str {
    if p == FAST { return "F" }
    if p == BALANCED { return "B" }
    return "U"
}

fn frames(p: i32) -> i32 {
    if p == FAST { return 1 }
    if p == BALANCED { return 3 }
    return 4
}

fn max_px(p: i32) -> i32 {
    if p == FAST { return 2400000 }
    if p == BALANCED { return 2400000 }
    return 9500000
}

fn preview_max_px() -> i32 {
    return 800000
}

fn apply(j: *mut camjob.Job, p: i32) {
    (*j).max_px = max_px(p)
    if p == ULTRA { return }
    (*j).dn_rad = 2
    (*j).aa_edge = 0.0f
    (*j).aa_chroma = 0.0f
    (*j).sr = 0.0f
    if p == FAST { (*j).flicker = 0.0f }
}

fn apply_preview(j: *mut camjob.Job) {
    (*j).max_px = preview_max_px()
    (*j).dn_rad = 1
    (*j).sr = 0.0f
    (*j).flicker = 0.0f
    (*j).aa_edge = 0.0f
    (*j).aa_chroma = 0.0f
    (*j).quality = 85
}
