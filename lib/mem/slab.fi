// SPDX-License-Identifier: MPL-2.0
import std.rt

export { Slab, slab_new, slab_alloc, slab_free, slab_live, slab_chunks, slab_destroy }

const SLAB_CHUNK_BYTES: usize = 65536
const SLAB_CHUNK_HEADER: usize = 16
const SLAB_MIN_ITEM: usize = 8

struct Slab {
    item: usize,
    head: u64,
    chunks: u64,
    chunk_count: usize,
    live: usize,
}

fn slab_new(item: usize) -> Slab {
    var size: usize = item
    if size < SLAB_MIN_ITEM {
        size = SLAB_MIN_ITEM
    }
    size = (size + 7) / 8 * 8
    return Slab { item: size, head: 0, chunks: 0, chunk_count: 0, live: 0 }
}

fn slab_grow(s: *mut Slab) -> bool {
    let c: u64 = rt.heap_alloc(SLAB_CHUNK_BYTES)
    if c == 0 {
        return false
    }
    *(c as *mut u64) = (*s).chunks
    (*s).chunks = c
    (*s).chunk_count = (*s).chunk_count + 1
    let per: usize = (SLAB_CHUNK_BYTES - SLAB_CHUNK_HEADER) / (*s).item
    var i: usize = per
    while i > 0 {
        i = i - 1
        let p: u64 = c + (SLAB_CHUNK_HEADER + i * (*s).item) as u64
        *(p as *mut u64) = (*s).head
        (*s).head = p
    }
    return true
}

fn slab_alloc(s: *mut Slab) -> u64 {
    if (*s).head == 0 {
        if !slab_grow(s) {
            return 0
        }
    }
    let p: u64 = (*s).head
    (*s).head = *(p as *mut u64)
    (*s).live = (*s).live + 1
    return p
}

fn slab_free(s: *mut Slab, p: u64) {
    if p == 0 {
        return
    }
    *(p as *mut u64) = (*s).head
    (*s).head = p
    (*s).live = (*s).live - 1
}

fn slab_live(s: *mut Slab) -> usize {
    return (*s).live
}

fn slab_chunks(s: *mut Slab) -> usize {
    return (*s).chunk_count
}

fn slab_destroy(s: *mut Slab) {
    var c: u64 = (*s).chunks
    while c != 0 {
        let next: u64 = *(c as *mut u64)
        rt.heap_free(c, SLAB_CHUNK_BYTES)
        c = next
    }
    (*s).chunks = 0
    (*s).head = 0
    (*s).chunk_count = 0
    (*s).live = 0
}
