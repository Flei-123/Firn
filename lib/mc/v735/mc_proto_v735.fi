    v.sem[mc_sem.SEM_PLAY_C2S_CONFIGURATION_ACKNOWLEDGED] = -1
    v.sem[mc_sem.SEM_CONFIG_S2C_SELECT_KNOWN_PACKS] = -1
    v.sem[mc_sem.SEM_CONFIG_C2S_SELECT_KNOWN_PACKS] = -1
    v.sem[mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY] = 0
    v.sem[mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY_LIVING] = 2
    v.sem[mc_sem.SEM_PLAY_S2C_NAMED_ENTITY_SPAWN] = 4
