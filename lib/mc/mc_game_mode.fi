const MODE_SURVIVAL: i32 = 0
const MODE_CREATIVE: i32 = 1
const MODE_ADVENTURE: i32 = 2
const MODE_SPECTATOR: i32 = 3

fn gm_creative(mode: i32, fallback: bool) -> bool {
    if mode < 0 { return fallback }
    return mode == MODE_CREATIVE || mode == MODE_SPECTATOR
}

fn gm_instant_break(mode: i32, fallback: bool) -> bool {
    if mode < 0 { return fallback }
    return mode == MODE_CREATIVE
}

fn gm_may_break(mode: i32) -> bool {
    return mode != MODE_ADVENTURE && mode != MODE_SPECTATOR
}
