import std.rt
import mc.mc_serverlist
import mc.mc_menu_addr
import mc.mc_gui_ui
import mc.mc_gui_tex
import mc.mc_gui_pack

export {
    MultiState, multi_new, multi_free, multi_frame, address_frame, multi_visible_rows,
    MA_NONE, MA_BACK, MA_JOIN, MA_ADD, MA_EDIT, MA_DIRECT, MA_DELETE, MA_REFRESH, AD_NONE, AD_OK, AD_CANCEL, ROW_PITCH, LIST_TOP,
}

const MA_NONE: i32 = 0
const MA_BACK: i32 = 1
const MA_JOIN: i32 = 2
const MA_ADD: i32 = 3
const MA_EDIT: i32 = 4
const MA_DIRECT: i32 = 5
const MA_DELETE: i32 = 6
const MA_REFRESH: i32 = 7
const AD_NONE: i32 = 0
const AD_OK: i32 = 1
const AD_CANCEL: i32 = 2
const ROW_PITCH: i32 = 36
const LIST_TOP: i32 = 32
const LIST_BOTTOM_PAD: i32 = 64
const ROW_W: i32 = 305
const DOUBLE_MS: u64 = 400 as u64
const NO_ROW: i32 = 0 - 1

struct MultiState {
    sel: i32,
    last_row: i32,
    last_ms: u64,
}

fn multi_new() -> MultiState {
    return MultiState { sel: NO_ROW, last_row: NO_ROW, last_ms: 0 as u64 }
}

fn multi_free(m: *mut MultiState) {
    (*m).sel = NO_ROW
}

fn multi_visible_rows(uh: i32) -> i32 {
    return (uh - LIST_BOTTOM_PAD - LIST_TOP - 4) / ROW_PITCH
}

fn row_text(sl: *mut mc_serverlist.ServerList, i: i32, out: *mut rt.Buf) {
    rt.buf_clear(out)
    var n: usize = mc_serverlist.sl_len(sl, i)
    let p: u64 = mc_serverlist.sl_ptr(sl, i)
    let tail: str = ":25565"
    if n > tail.n && rt.mem_eq(p + (n - tail.n) as u64, tail.p as u64, tail.n) { n = n - tail.n }
    rt.buf_push_bytes(out, p, n)
}

fn multi_frame(u: *mut mc_gui_ui.Ui, m: *mut MultiState, sl: *mut mc_serverlist.ServerList) -> i32 {
    var act: i32 = MA_NONE
    mc_gui_ui.ui_list_background(u, LIST_TOP, (*u).uh - LIST_BOTTOM_PAD)
    let cx: i32 = (*u).uw / 2
    mc_gui_ui.ui_label_c(u, cx, 20, mc_gui_ui.COLOR_WHITE, mc_gui_ui.ui_lang(u, "multiplayer.title", "Play Multiplayer"))
    let count: i32 = mc_serverlist.sl_count(sl)
    let rows: i32 = multi_visible_rows((*u).uh)
    if (*m).sel >= count { (*m).sel = NO_ROW }
    var name: rt.Buf = rt.buf_new()
    var i: i32 = 0
    while i < count && i < rows {
        let top: i32 = LIST_TOP + 4 + i * ROW_PITCH
        let left: i32 = cx - ROW_W / 2
        if mc_gui_ui.ui_hover(u, left, top - 2, ROW_W, ROW_PITCH) && (*u).pressed && (*u).my >= LIST_TOP && (*u).my < (*u).uh - LIST_BOTTOM_PAD {
            (*m).sel = i
            if (*m).last_row == i && (*u).ms - (*m).last_ms < DOUBLE_MS { act = MA_JOIN }
            (*m).last_row = i
            (*m).last_ms = (*u).ms
        }
        if (*m).sel == i {
            mc_gui_ui.ui_rect(u, left, top - 2, ROW_W, 36, 0xFF808080)
            mc_gui_ui.ui_rect(u, left + 1, top - 1, ROW_W - 2, 34, 0xFF000000)
        }
        mc_gui_ui.ui_server_icon(u, left + 1, top)
        row_text(sl, i, &name)
        mc_gui_ui.ui_label_bytes(u, left + 35, top + 1, mc_gui_ui.COLOR_WHITE, rt.buf_ptr(&name), rt.buf_len(&name))
        i = i + 1
    }
    rt.buf_free(&name)
    let have: bool = (*m).sel >= 0
    let by1: i32 = (*u).uh - 52
    let by2: i32 = (*u).uh - 28
    if mc_gui_ui.ui_button(u, cx - 154, by1, 100, mc_gui_ui.ui_lang(u, "selectServer.select", "Join Server"), have) { act = MA_JOIN }
    if mc_gui_ui.ui_button(u, cx - 50, by1, 100, mc_gui_ui.ui_lang(u, "selectServer.direct", "Direct Connection"), true) { act = MA_DIRECT }
    if mc_gui_ui.ui_button(u, cx + 4 + 50, by1, 100, mc_gui_ui.ui_lang(u, "selectServer.add", "Add Server"), true) { act = MA_ADD }
    if mc_gui_ui.ui_button(u, cx - 154, by2, 72, mc_gui_ui.ui_lang(u, "selectServer.edit", "Edit"), have) { act = MA_EDIT }
    if mc_gui_ui.ui_button(u, cx - 76, by2, 72, mc_gui_ui.ui_lang(u, "selectServer.delete", "Delete"), have) { act = MA_DELETE }
    if mc_gui_ui.ui_button(u, cx + 4, by2, 72, mc_gui_ui.ui_lang(u, "selectServer.refresh", "Refresh"), true) { act = MA_REFRESH }
    if mc_gui_ui.ui_button(u, cx + 4 + 76, by2, 75, mc_gui_ui.ui_lang(u, "gui.cancel", "Cancel"), true) { act = MA_BACK }
    return act
}

fn address_frame(u: *mut mc_gui_ui.Ui, title: str, label: str, confirm: str, field: *mut rt.Buf, label_y: i32, field_y: i32, ok_y: i32) -> i32 {
    mc_gui_ui.ui_dirt(u, 0x404040)
    let cx: i32 = (*u).uw / 2
    mc_gui_ui.ui_label_c(u, cx, 17, mc_gui_ui.COLOR_WHITE, title)
    mc_gui_ui.ui_label(u, cx - 100, label_y, 0xA0A0A0, label)
    if (*u).focus < 0 { (*u).focus = 0 }
    mc_gui_ui.ui_field(u, 0, cx - 100, field_y, 200, 20, field, 128)
    var res: i32 = AD_NONE
    var hn: usize = 0
    var pt: i32 = 0
    let valid: bool = mc_menu_addr.addr_parse(rt.buf_ptr(field), rt.buf_len(field), &hn, &pt)
    if mc_gui_ui.ui_button(u, cx - 100, ok_y, 200, confirm, valid) || ((*u).key_enter && valid) { res = AD_OK }
    if mc_gui_ui.ui_button(u, cx - 100, ok_y + 24, 200, mc_gui_ui.ui_lang(u, "gui.cancel", "Cancel"), true) || (*u).key_esc { res = AD_CANCEL }
    return res
}
