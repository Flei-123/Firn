import std.rt
import mc.mc_serverlist
import mc.mc_menu_addr
import mc.mc_gui_ui
import mc.mc_gui_tex
import mc.mc_gui_pack
import mc.mc_menu_ping

export {
    MultiState, multi_new, multi_free, multi_frame, address_frame, multi_visible_rows,
    MA_NONE, MA_BACK, MA_JOIN, MA_ADD, MA_EDIT, MA_DIRECT, MA_DELETE, MA_REFRESH, AD_NONE, AD_OK, AD_CANCEL, ROW_PITCH, LIST_TOP,
}

const MA_NONE: i32 = 0
const MA_BACK: i32 = 1
const MA_JOIN: i32 = 2
const MA_ADD: i32 = 3
const MA_EDIT: i32 = 4
const MA_DIRECT: i32 = 5
const MA_DELETE: i32 = 6
const MA_REFRESH: i32 = 7
const AD_NONE: i32 = 0
const AD_OK: i32 = 1
const AD_CANCEL: i32 = 2
const ROW_PITCH: i32 = 36
const LIST_TOP: i32 = 32
const LIST_BOTTOM_PAD: i32 = 64
const ROW_W: i32 = 305
const DOUBLE_MS: u64 = 400 as u64
const NO_ROW: i32 = 0 - 1
const MOTD_COLOR: u32 = 0x808080
const ERROR_COLOR: u32 = 0xAA0000
const PING_ICON_W: i32 = 10
const PING_ICON_H: i32 = 8
const PING_ICON_V: i32 = 176
const PING_FAIL_V: i32 = 216
const SCROLL_ID: i32 = 301

struct MultiState {
    sel: i32,
    last_row: i32,
    last_ms: u64,
    scroll: i32,
}

fn multi_new() -> MultiState {
    return MultiState { sel: NO_ROW, last_row: NO_ROW, last_ms: 0 as u64, scroll: 0 }
}

fn multi_free(m: *mut MultiState) {
    (*m).sel = NO_ROW
}

fn multi_visible_rows(uh: i32) -> i32 {
    return (uh - LIST_BOTTOM_PAD - LIST_TOP - 4) / ROW_PITCH
}

fn row_text(sl: *mut mc_serverlist.ServerList, i: i32, out: *mut rt.Buf) {
    rt.buf_clear(out)
    var n: usize = mc_serverlist.sl_len(sl, i)
    let p: u64 = mc_serverlist.sl_ptr(sl, i)
    let tail: str = ":25565"
    if n > tail.n && rt.mem_eq(p + (n - tail.n) as u64, tail.p as u64, tail.n) { n = n - tail.n }
    rt.buf_push_bytes(out, p, n)
}

fn fit_len(u: *mut mc_gui_ui.Ui, p: u64, n: usize, max_w: i32) -> usize {
    var k: usize = n
    while k > 0 && mc_gui_ui.ui_text_width(u, str { p: p as *u8, n: k }) > max_w { k = k - 1 }
    return k
}

fn draw_line(u: *mut mc_gui_ui.Ui, x: i32, y: i32, rgb: u32, p: u64, n: usize, max_w: i32) {
    mc_gui_ui.ui_label_bytes(u, x, y, rgb, p, fit_len(u, p, n, max_w))
}

fn draw_motd(u: *mut mc_gui_ui.Ui, x: i32, y: i32, p: u64, n: usize, max_w: i32) {
    var e: usize = 0
    while e < n && rt.ld8(p, e) != 10 as u8 { e = e + 1 }
    draw_line(u, x, y, MOTD_COLOR, p, e, max_w)
    if e + 1 < n {
        var e2: usize = e + 1
        while e2 < n && rt.ld8(p, e2) != 10 as u8 { e2 = e2 + 1 }
        draw_line(u, x, y + 9, MOTD_COLOR, p + (e + 1) as u64, e2 - e - 1, max_w)
    }
}

fn ping_level(ms: u64) -> i32 {
    if ms < 150 as u64 { return 0 }
    if ms < 300 as u64 { return 1 }
    if ms < 600 as u64 { return 2 }
    if ms < 1000 as u64 { return 3 }
    return 4
}

fn draw_ping_icon(u: *mut mc_gui_ui.Ui, x: i32, y: i32, su: i32, sv: i32) {
    let s: i32 = (*u).s
    mc_gui_tex.gtex_draw((*u).r, &(*(*u).pk).icons, x * s, y * s, PING_ICON_W * s, PING_ICON_H * s, su, sv, PING_ICON_W, PING_ICON_H, 0xFFFFFFFF as u32)
}

fn draw_status(u: *mut mc_gui_ui.Ui, slot: u64, left: i32, top: i32, index: i32) {
    let tx: i32 = left + 35
    let text_w: i32 = ROW_W - 35 - 5
    let ix: i32 = left + ROW_W - 15
    if slot == 0 as u64 || rt.ld64(slot, mc_menu_ping.PW_STATE) == mc_menu_ping.PS_PENDING {
        mc_gui_ui.ui_label(u, tx, top + 12, MOTD_COLOR, mc_gui_ui.ui_lang(u, "multiplayer.status.pinging", "Pinging..."))
        var k: i32 = (((*u).ms / 100 as u64) as i32 + index * 2) & 7
        if k > 4 { k = 8 - k }
        draw_ping_icon(u, ix, top, PING_ICON_W, PING_ICON_V + k * PING_ICON_H)
        return
    }
    if rt.ld64(slot, mc_menu_ping.PW_STATE) == mc_menu_ping.PS_FAILED {
        mc_gui_ui.ui_label(u, tx, top + 12, ERROR_COLOR, mc_gui_ui.ui_lang(u, "multiplayer.status.cannot_connect", "Can't connect to server"))
        draw_ping_icon(u, ix, top, 0, PING_FAIL_V)
        return
    }
    var cnt: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&cnt, rt.ld64(slot, mc_menu_ping.PW_ONLINE) as i64)
    rt.buf_push(&cnt, 47 as u8)
    rt.buf_push_dec_i64(&cnt, rt.ld64(slot, mc_menu_ping.PW_MAX) as i64)
    let cw: i32 = mc_gui_ui.ui_text_width(u, rt.buf_str(&cnt))
    mc_gui_ui.ui_label_bytes(u, ix - 2 - cw, top + 1, MOTD_COLOR, rt.buf_ptr(&cnt), rt.buf_len(&cnt))
    rt.buf_free(&cnt)
    draw_ping_icon(u, ix, top, 0, PING_ICON_V + ping_level(rt.ld64(slot, mc_menu_ping.PW_LATENCY)) * PING_ICON_H)
    draw_motd(u, tx, top + 12, rt.ld64(slot, mc_menu_ping.PW_MOTD), rt.ld64(slot, mc_menu_ping.PW_MOTD_N) as usize, text_w)
}

fn draw_row_icon(u: *mut mc_gui_ui.Ui, slot: u64, x: i32, y: i32) {
    var t: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    if mc_menu_ping.slot_icon(slot, &t) {
        let s: i32 = (*u).s
        mc_gui_tex.gtex_draw((*u).r, &t, x * s, y * s, 32 * s, 32 * s, 0, 0, t.w, t.h, 0xFFFFFFFF as u32)
    } else {
        mc_gui_ui.ui_server_icon(u, x, y)
    }
}

fn multi_frame(u: *mut mc_gui_ui.Ui, m: *mut MultiState, sl: *mut mc_serverlist.ServerList, pb: *mut mc_menu_ping.PingBoard) -> i32 {
    var act: i32 = MA_NONE
    mc_menu_ping.board_tick(pb, sl)
    mc_gui_ui.ui_list_background(u, LIST_TOP, (*u).uh - LIST_BOTTOM_PAD)
    let cx: i32 = (*u).uw / 2
    mc_gui_ui.ui_label_c(u, cx, 20, mc_gui_ui.COLOR_WHITE, mc_gui_ui.ui_lang(u, "multiplayer.title", "Play Multiplayer"))
    let count: i32 = mc_serverlist.sl_count(sl)
    let rows: i32 = multi_visible_rows((*u).uh)
    if (*m).sel >= count { (*m).sel = NO_ROW }
    var name: rt.Buf = rt.buf_new()
    (*m).scroll = mc_gui_ui.ui_scroll(u, SCROLL_ID, cx + ROW_W / 2 + 6, LIST_TOP, (*u).uh - LIST_BOTTOM_PAD, count, rows, (*m).scroll)
    var i: i32 = (*m).scroll
    while i < count && i < (*m).scroll + rows {
        let top: i32 = LIST_TOP + 4 + (i - (*m).scroll) * ROW_PITCH
        let left: i32 = cx - ROW_W / 2
        if mc_gui_ui.ui_hover(u, left, top - 2, ROW_W, ROW_PITCH) && (*u).pressed && (*u).my >= LIST_TOP && (*u).my < (*u).uh - LIST_BOTTOM_PAD {
            (*m).sel = i
            if (*m).last_row == i && (*u).ms - (*m).last_ms < DOUBLE_MS { act = MA_JOIN }
            (*m).last_row = i
            (*m).last_ms = (*u).ms
        }
        if (*m).sel == i {
            mc_gui_ui.ui_rect(u, left, top - 2, ROW_W, 36, 0xFF808080)
            mc_gui_ui.ui_rect(u, left + 1, top - 1, ROW_W - 2, 34, 0xFF000000)
        }
        let slot: u64 = mc_menu_ping.board_get(pb, sl, i)
        draw_row_icon(u, slot, left + 1, top)
        row_text(sl, i, &name)
        mc_gui_ui.ui_label_bytes(u, left + 35, top + 1, mc_gui_ui.COLOR_WHITE, rt.buf_ptr(&name), rt.buf_len(&name))
        draw_status(u, slot, left, top, i)
        i = i + 1
    }
    rt.buf_free(&name)
    let have: bool = (*m).sel >= 0
    let by1: i32 = (*u).uh - 52
    let by2: i32 = (*u).uh - 28
    if mc_gui_ui.ui_button(u, cx - 154, by1, 100, mc_gui_ui.ui_lang(u, "selectServer.select", "Join Server"), have) { act = MA_JOIN }
    if mc_gui_ui.ui_button(u, cx - 50, by1, 100, mc_gui_ui.ui_lang(u, "selectServer.direct", "Direct Connection"), true) { act = MA_DIRECT }
    if mc_gui_ui.ui_button(u, cx + 4 + 50, by1, 100, mc_gui_ui.ui_lang(u, "selectServer.add", "Add Server"), true) { act = MA_ADD }
    if mc_gui_ui.ui_button(u, cx - 154, by2, 72, mc_gui_ui.ui_lang(u, "selectServer.edit", "Edit"), have) { act = MA_EDIT }
    if mc_gui_ui.ui_button(u, cx - 76, by2, 72, mc_gui_ui.ui_lang(u, "selectServer.delete", "Delete"), have) { act = MA_DELETE }
    if mc_gui_ui.ui_button(u, cx + 4, by2, 72, mc_gui_ui.ui_lang(u, "selectServer.refresh", "Refresh"), true) { act = MA_REFRESH }
    if mc_gui_ui.ui_button(u, cx + 4 + 76, by2, 75, mc_gui_ui.ui_lang(u, "gui.cancel", "Cancel"), true) { act = MA_BACK }
    return act
}

fn address_frame(u: *mut mc_gui_ui.Ui, title: str, label: str, confirm: str, field: *mut rt.Buf, label_y: i32, field_y: i32, ok_y: i32) -> i32 {
    mc_gui_ui.ui_dirt(u, 0x404040)
    let cx: i32 = (*u).uw / 2
    mc_gui_ui.ui_label_c(u, cx, 17, mc_gui_ui.COLOR_WHITE, title)
    mc_gui_ui.ui_label(u, cx - 100, label_y, 0xA0A0A0, label)
    if (*u).focus < 0 { (*u).focus = 0 }
    mc_gui_ui.ui_field(u, 0, cx - 100, field_y, 200, 20, field, 128)
    var res: i32 = AD_NONE
    var hn: usize = 0
    var pt: i32 = 0
    let valid: bool = mc_menu_addr.addr_parse(rt.buf_ptr(field), rt.buf_len(field), &hn, &pt)
    if mc_gui_ui.ui_button(u, cx - 100, ok_y, 200, confirm, valid) || ((*u).key_enter && valid) { res = AD_OK }
    if mc_gui_ui.ui_button(u, cx - 100, ok_y + 24, 200, mc_gui_ui.ui_lang(u, "gui.cancel", "Cancel"), true) || (*u).key_esc { res = AD_CANCEL }
    return res
}
