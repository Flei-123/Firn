import std.rt
import mc.mc_raster
import mc.mc_gui_tex
import mc.mc_item_src
import mc.mc_hud_vfont
import mc.mc_slot_hint

export { InvUi, iui_new, iui_free, iui_open, iui_ok, iui_panel_w, iui_panel_h, iui_draw_bg, iui_draw_hint, iui_slot_xy, iui_slot_at, iui_text, iui_count, iui_count_col, YELLOW }

const PANEL_W: i32 = 176
const PANEL_H: i32 = 166
const PLAYER_SLOTS: i32 = 46
const OFFHAND: i32 = 45
const TEXT_DARK: u32 = 0xFF404040
const WHITE: u32 = 0xFFFFFFFF
const YELLOW: u32 = 0xFF55FFFF

struct InvUi {
    bg: mc_gui_tex.GuiTex,
    hint: mc_slot_hint.SlotHint,
}

fn iui_new() -> InvUi { return InvUi { bg: mc_gui_tex.gtex_empty(), hint: mc_slot_hint.shint_new() } }

fn iui_free(u: *mut InvUi) {
    mc_gui_tex.gtex_free(&(*u).bg)
    mc_slot_hint.shint_free(&(*u).hint)
}

fn iui_ok(u: *mut InvUi) -> bool { return mc_gui_tex.gtex_ok(&(*u).bg) }

fn iui_panel_w() -> i32 { return PANEL_W }

fn iui_panel_h() -> i32 { return PANEL_H }

fn iui_open(u: *mut InvUi, src: *mut mc_item_src.ItemSrc) -> bool {
    let path: str = "assets/minecraft/textures/gui/container/inventory.png"
    mc_slot_hint.shint_open(&(*u).hint, src)
    return mc_item_src.isrc_tex(src, path.p as u64, path.length(), &(*u).bg)
}

fn iui_draw_hint(u: *mut InvUi, r: *mut mc_raster.Raster, ws: i32, gx: i32, gy: i32, s: i32) {
    let which: i32 = mc_slot_hint.shint_armor(ws)
    if which >= 0 { mc_slot_hint.shint_draw(r, &(*u).hint, which, gx, gy, s) }
}

fn iui_slot_xy(ws: i32, x: *mut i32, y: *mut i32) -> bool {
    if ws < 0 || ws >= PLAYER_SLOTS { return false }
    if ws == 0 {
        *x = 154
        *y = 28
    } else if ws < 5 {
        *x = 98 + 18 * ((ws - 1) % 2)
        *y = 18 + 18 * ((ws - 1) / 2)
    } else if ws < 9 {
        *x = 8
        *y = 8 + 18 * (ws - 5)
    } else if ws < 36 {
        *x = 8 + 18 * ((ws - 9) % 9)
        *y = 84 + 18 * ((ws - 9) / 9)
    } else if ws < 45 {
        *x = 8 + 18 * (ws - 36)
        *y = 142
    } else {
        *x = 77
        *y = 62
    }
    return true
}

fn iui_draw_bg(u: *mut InvUi, r: *mut mc_raster.Raster, px: i32, py: i32, s: i32) {
    mc_gui_tex.gtex_draw(r, &(*u).bg, px, py, PANEL_W * s, PANEL_H * s, 0, 0, PANEL_W, PANEL_H, WHITE)
    iui_text(r, px + 97 * s, py + 8 * s, s, "Crafting", TEXT_DARK, false)
}

fn iui_slot_at(px: i32, py: i32, s: i32, mx: i32, my: i32) -> i32 {
    if mx < px || my < py || mx >= px + PANEL_W * s || my >= py + PANEL_H * s { return 0 - 999 }
    var ws: i32 = 0
    var x: i32 = 0
    var y: i32 = 0
    while ws < PLAYER_SLOTS {
        iui_slot_xy(ws, &x, &y)
        let gx: i32 = px + x * s
        let gy: i32 = py + y * s
        if mx >= gx && my >= gy && mx < gx + 16 * s && my < gy + 16 * s { return ws }
        ws = ws + 1
    }
    return 0 - 1
}

fn fill_cols(n: usize, colour: u32) -> u64 {
    let p: u64 = rt.heap_alloc(n * 4 + 4)
    var i: usize = 0
    while i < n {
        rt.st32(p, i, colour)
        i = i + 1
    }
    return p
}

fn iui_text(r: *mut mc_raster.Raster, x: i32, y: i32, s: i32, text: str, colour: u32, shadow: bool) -> i32 {
    let n: usize = text.length()
    let cols: u64 = fill_cols(n, colour)
    let w: i32 = mc_hud_vfont.vtext_line(r, x, y, s, 255, text.p as u64, cols, 0 as u64, 0, n, shadow, 0 as u32)
    rt.heap_free(cols, n * 4 + 4)
    return w
}

fn iui_count(r: *mut mc_raster.Raster, ix: i32, iy: i32, s: i32, count: i32) {
    iui_count_col(r, ix, iy, s, count, WHITE)
}

fn iui_count_col(r: *mut mc_raster.Raster, ix: i32, iy: i32, s: i32, count: i32, colour: u32) {
    if count <= 1 { return }
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, count as i64)
    let n: usize = rt.buf_len(&b)
    let cols: u64 = fill_cols(n, colour)
    let w: i32 = mc_hud_vfont.vtext_width(rt.buf_ptr(&b), 0 as u64, 0, n)
    mc_hud_vfont.vtext_line(r, ix + (19 - 2 - w) * s, iy + 9 * s, s, 255, rt.buf_ptr(&b), cols, 0 as u64, 0, n, true, 0 as u32)
    rt.heap_free(cols, n * 4 + 4)
    rt.buf_free(&b)
}
