import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_hud_vfont
import mc.mc_styled
import mc.mc_tablist
import mc.mc_tab_art

export { tablist_ui_draw, TabLayout, tablist_layout, styled_lines, ROW_PITCH, COL_GAP, BG_FRAME, BG_CELL }

const ROW_PITCH: i32 = 9
const COL_GAP: i32 = 5
const MAX_ROWS: i32 = 20
const BG_FRAME: u32 = 0x80000000
const BG_CELL: u32 = 0x20FFFFFF
const NAME_WHITE: u32 = 0xFFFFFFFF
const NAME_SPECTATOR: u32 = 0x90FFFFFF
const PING_ICON_W: i32 = 11
const HEAD_W: i32 = 9
const MARGIN: i32 = 50
const TOP: i32 = 10

struct TabLayout {
    count: i32,
    rows: i32,
    cols: i32,
    cell_w: i32,
    x0: i32,
    total_w: i32,
}

fn tablist_layout(count: i32, widest: i32, heads: bool, width: i32) -> TabLayout {
    var rows: i32 = count
    var cols: i32 = 1
    while rows > MAX_ROWS {
        cols = cols + 1
        rows = (count + cols - 1) / cols
    }
    var head: i32 = 0
    if heads { head = HEAD_W }
    var cw: i32 = cols * (head + widest + PING_ICON_W + 2)
    if cw > width - MARGIN { cw = width - MARGIN }
    cw = cw / cols
    let total: i32 = cw * cols + (cols - 1) * COL_GAP
    return TabLayout { count: count, rows: rows, cols: cols, cell_w: cw, x0: width / 2 - total / 2, total_w: total }
}

fn push_pair(out: *mut rt.Buf, a: usize, b: usize) {
    var i: usize = 0
    while i < 8 {
        rt.buf_push(out, 0)
        i = i + 1
    }
    let n: usize = rt.buf_len(out) / 4
    rt.st32(rt.buf_ptr(out), n - 2, a as u32)
    rt.st32(rt.buf_ptr(out), n - 1, b as u32)
}

fn styled_lines(st: *mut mc_styled.Styled, max_w: i32, out: *mut rt.Buf) -> i32 {
    rt.buf_clear(out)
    let p: u64 = mc_styled.styled_text(st)
    let fl: u64 = mc_styled.styled_flags(st)
    let n: usize = mc_styled.styled_len(st)
    if n == 0 { return 0 }
    var lines: i32 = 0
    var i: usize = 0
    while i <= n && lines < 64 {
        var e: usize = i
        while e < n && rt.ld8(p, e) != 10 as u8 { e = e + 1 }
        var from: usize = i
        if e == from {
            push_pair(out, from, 0)
            lines = lines + 1
        }
        while from < e && lines < 64 {
            let take: usize = mc_hud_vfont.vtext_wrap(p, fl, from, e - from, max_w)
            push_pair(out, from, take)
            lines = lines + 1
            from = from + take
        }
        i = e + 1
    }
    return lines
}

fn lines_widest(st: *mut mc_styled.Styled, lines: *mut rt.Buf, count: i32) -> i32 {
    var w: i32 = 0
    var k: i32 = 0
    while k < count {
        let from: usize = rt.ld32(rt.buf_ptr(lines), (k * 2) as usize) as usize
        let len: usize = rt.ld32(rt.buf_ptr(lines), (k * 2 + 1) as usize) as usize
        let lw: i32 = mc_hud_vfont.vtext_width(mc_styled.styled_text(st), mc_styled.styled_flags(st), from, from + len)
        if lw > w { w = lw }
        k = k + 1
    }
    return w
}

fn draw_lines(r: *mut mc_raster.Raster, s: i32, st: *mut mc_styled.Styled, lines: *mut rt.Buf, count: i32, cx: i32, y: i32, now: u64) {
    var k: i32 = 0
    while k < count {
        let from: usize = rt.ld32(rt.buf_ptr(lines), (k * 2) as usize) as usize
        let len: usize = rt.ld32(rt.buf_ptr(lines), (k * 2 + 1) as usize) as usize
        let lw: i32 = mc_hud_vfont.vtext_width(mc_styled.styled_text(st), mc_styled.styled_flags(st), from, from + len)
        mc_hud_vfont.vtext_line(r, (cx - lw / 2) * s, (y + k * ROW_PITCH) * s, s, 255, mc_styled.styled_text(st), mc_styled.styled_colors(st), mc_styled.styled_flags(st), from, from + len, true, (now / 50 as u64) as u32)
        k = k + 1
    }
}

fn entry_width(tl: *mut mc_tablist.TabList, k: usize, sc: *mut mc_styled.Styled) -> i32 {
    if mc_tablist.tab_has_display(tl, k) {
        mc_tablist.tab_display_styled(tl, k, sc)
        return mc_hud_vfont.vtext_width(mc_styled.styled_text(sc), mc_styled.styled_flags(sc), 0, mc_styled.styled_len(sc))
    }
    return mc_hud_vfont.vtext_width(mc_tablist.tab_name_ptr(tl, k), 0 as u64, 0, mc_tablist.tab_name_len(tl, k))
}

fn draw_name(r: *mut mc_raster.Raster, s: i32, tl: *mut mc_tablist.TabList, k: usize, x: i32, y: i32, sc: *mut mc_styled.Styled, now: u64) {
    let spectator: bool = mc_tablist.tab_gamemode(tl, k) == mc_tablist.GM_SPECTATOR
    if mc_tablist.tab_has_display(tl, k) {
        mc_tablist.tab_display_styled(tl, k, sc)
        mc_hud_vfont.vtext_line(r, x * s, y * s, s, 255, mc_styled.styled_text(sc), mc_styled.styled_colors(sc), mc_styled.styled_flags(sc), 0, mc_styled.styled_len(sc), true, (now / 50 as u64) as u32)
        return
    }
    var cols: [u32; 64] = [0; 64]
    var fls: [u8; 64] = [0; 64]
    var n: usize = mc_tablist.tab_name_len(tl, k)
    if n > 64 { n = 64 }
    var c: u32 = NAME_WHITE
    var f: u8 = 0 as u8
    if spectator {
        c = NAME_SPECTATOR
        f = mc_hud_vfont.VF_ITALIC as u8
    }
    var i: usize = 0
    while i < n {
        cols[i] = c
        fls[i] = f
        i = i + 1
    }
    mc_hud_vfont.vtext_line(r, x * s, y * s, s, 255, mc_tablist.tab_name_ptr(tl, k), (&cols[0]) as u64, (&fls[0]) as u64, 0, n, true, 0 as u32)
}

fn tablist_ui_draw(tl: *mut mc_tablist.TabList, r: *mut mc_raster.Raster, s: i32, heads: bool, now: u64) {
    var order: [u32; 80] = [0; 80]
    let count: usize = mc_tablist.tab_order(tl, (&order[0]) as u64)
    let width: i32 = (*r).w / s
    var scratch: mc_styled.Styled = mc_styled.styled_new()
    var widest: i32 = 0
    var i: usize = 0
    while i < count {
        let w: i32 = entry_width(tl, order[i] as usize, &scratch)
        if w > widest { widest = w }
        i = i + 1
    }
    let lay: TabLayout = tablist_layout(count as i32, widest, heads, width)
    var hl: rt.Buf = rt.buf_new()
    var fl: rt.Buf = rt.buf_new()
    let hn: i32 = styled_lines(mc_tablist.tab_header(tl), width - MARGIN, &hl)
    let fn_: i32 = styled_lines(mc_tablist.tab_footer(tl), width - MARGIN, &fl)
    var total: i32 = lay.total_w
    let hw: i32 = lines_widest(mc_tablist.tab_header(tl), &hl, hn)
    let fw: i32 = lines_widest(mc_tablist.tab_footer(tl), &fl, fn_)
    if hw > total { total = hw }
    if fw > total { total = fw }
    let cx: i32 = width / 2
    var y: i32 = TOP
    if hn > 0 {
        mc_hud.hud_rect(r, (cx - total / 2 - 1) * s, (y - 1) * s, (total + 2) * s, (hn * ROW_PITCH + 1) * s, BG_FRAME)
        draw_lines(r, s, mc_tablist.tab_header(tl), &hl, hn, cx, y, now)
        y = y + hn * ROW_PITCH
    }
    mc_hud.hud_rect(r, (cx - total / 2 - 1) * s, (y - 1) * s, (total + 2) * s, (lay.rows * ROW_PITCH + 1) * s, BG_FRAME)
    var w: i32 = 0
    while w < lay.count {
        let col: i32 = w / lay.rows
        let row: i32 = w % lay.rows
        let cell_x: i32 = lay.x0 + col * lay.cell_w + col * COL_GAP
        let cell_y: i32 = y + row * ROW_PITCH
        mc_hud.hud_rect(r, cell_x * s, cell_y * s, lay.cell_w * s, 8 * s, BG_CELL)
        let k: usize = order[w as usize] as usize
        var nx: i32 = cell_x
        if heads {
            mc_tab_art.tabart_face(r, nx * s, cell_y * s, s, (mc_tablist.tab_uuid_hash(tl, k) & 1) == 1)
            nx = nx + HEAD_W
        }
        draw_name(r, s, tl, k, nx, cell_y, &scratch, now)
        mc_tab_art.tabart_ping(r, (cell_x + lay.cell_w - PING_ICON_W) * s, cell_y * s, s, mc_tablist.tab_ping_level(mc_tablist.tab_latency(tl, k)))
        w = w + 1
    }
    y = y + lay.rows * ROW_PITCH + 1
    if fn_ > 0 {
        mc_hud.hud_rect(r, (cx - total / 2 - 1) * s, (y - 1) * s, (total + 2) * s, (fn_ * ROW_PITCH + 1) * s, BG_FRAME)
        draw_lines(r, s, mc_tablist.tab_footer(tl), &fl, fn_, cx, y, now)
    }
    rt.buf_free(&hl)
    rt.buf_free(&fl)
    mc_styled.styled_free(&scratch)
}
