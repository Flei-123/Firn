import mc.mc_raster
import mc.mc_hud

export { offhand_cell_x, offhand_cell_y, offhand_ui_draw, OFFHAND_SLOT }

const OFFHAND_SLOT: i32 = 45
const BACK: u32 = 0x78000000
const LINE: u32 = 0xFF8B8B8B
const GAP: i32 = 24

fn offhand_cell_x(r: *mut mc_raster.Raster, scale: i32) -> i32 {
    return ((*r).w - 181 * scale) / 2 - GAP * scale
}

fn offhand_cell_y(r: *mut mc_raster.Raster, scale: i32) -> i32 {
    return (*r).h - 23 * scale
}

fn offhand_ui_draw(r: *mut mc_raster.Raster, scale: i32) {
    let x: i32 = offhand_cell_x(r, scale)
    let y: i32 = offhand_cell_y(r, scale)
    mc_hud.hud_rect(r, x, y, 22 * scale, 22 * scale, BACK)
    mc_hud.hud_rect(r, x, y, 22 * scale, scale, LINE)
    mc_hud.hud_rect(r, x, y + 21 * scale, 22 * scale, scale, LINE)
    mc_hud.hud_rect(r, x, y + scale, scale, 20 * scale, LINE)
    mc_hud.hud_rect(r, x + 21 * scale, y + scale, scale, 20 * scale, LINE)
}
