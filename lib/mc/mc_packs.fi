// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_packs.fi -- resource pack manager of the voxel client: pack list (config file / argument / auto discovery),
// atlas (re)build, animation clock, hot reload, backend upload. Docs: docs/mc/resourcepacks.md.
//
//     var m: mc_packs.ResMgr = mc_packs.res_new()
//     mc_packs.res_add_list(&m, "packs/a.zip,packs/b.zip")      // argument: first = top priority
//     mc_packs.res_load_config(&m, "packs.txt")                  // optional config file (see below)
//     mc_packs.res_autodiscover(&m, "")                          // <minecraft dir>/resourcepacks/*.zip (run time only), lowest priority
//     mc_packs.res_set_protocol(&m, 763)                         // pack_format mismatch -> warning only
//     mc_packs.res_build_tables(&m, &registry, &tables)          // extended tile ids (depend on the game version, not on packs)
//     mc_packs.res_reload_upload(&m, &backend)                   // open packs, build atlas, upload;  call again = hot reload
//     mc_packs.res_tick(&m, tick, &backend)                      // animated tiles; re-uploads when something changed
//
// Config file (text, one setting per line, `#` comments, unknown lines ignored):
//     pack=<path>            a pack ZIP, relative paths are relative to the config file; a bare path without `=` works too
//     tile=<16|32|64|..>     atlas tile size (default: biggest block texture of the packs, rounded up to a power of two)
//     tile_max=<n>           clamp for the automatic size (default 64)
//     auto=<0|1>             discover packs in the minecraft dir (default 0)
//     mcdir=<path>           minecraft dir for auto discovery (default: %APPDATA%/.minecraft, ~/Library/Application Support/minecraft, ~/.minecraft)
//     sounds=<synth|original|both>   sound source for mc_audio (default synth; read with res_sounds_mode; mcplay: key O toggles synth <-> packs)
// Hot reload keeps every mesh: tile ids come from the game version only. The atlas memory is rebuilt, so call res_upload (the
// backend's upload_atlas) afterwards -- res_reload_upload does both.
import std.rt
import std.fs
import std.env
import std.dir
import std.io
import mc.mc_vanilla
import mc.mc_texture
import mc.mc_texext
import mc.mc_registry
import mc.mc_mesh
import mc.mc_backend
import mc.mc_blocktex
import paint.png
import mc.mc_assets

export {
    ResMgr, SOUNDS_SYNTH, SOUNDS_ORIGINAL, SOUNDS_BOTH,
    res_new, res_free, res_add_path, res_add_list, res_load_config, res_load_config_text, res_autodiscover, res_set_protocol,
    res_build_tables, res_reload, res_upload, res_reload_upload, res_tick, res_pack_count, res_path_count, res_warn_count,
    res_warn_text, res_sounds_mode, res_toggle_sounds, res_sounds_name, res_tile_size, res_setup_env, res_on_key, res_env_wanted, RES_KEY_RELOAD,
    res_use_vanilla, res_vanilla_wanted,
}

// Key code that triggers a pack hot reload in a windowed client (ASCII 'T', like vanilla F3+T). The window layer maps its key event to
// this value and calls res_on_key.
const RES_KEY_RELOAD: i32 = 84

const SOUNDS_SYNTH: i32 = 0
const SOUNDS_ORIGINAL: i32 = 1
const SOUNDS_BOTH: i32 = 2
const MAX_PATHS: usize = 64

struct ResMgr {
    paths: rt.Buf, // pack paths, one per line (priority order)
    npaths: usize,
    stack: mc_assets.PackStack,
    anim: mc_assets.AnimSet,
    atlas: mc_texture.Atlas,
    ex: mc_texext.TexExt,
    tile_cfg: i32, // 0 = auto
    tile_max: i32,
    auto_on: bool,
    mcdir: rt.Buf,
    sounds: i32,
    sounds_pref: i32, // pack mode the toggle returns to (the last non-synth mode; both when none was ever set)
    expected: i32, // expected resource pack_format of the game version (-1 unknown)
    warn: rt.Buf,
    nwarn: i32,
    tile_now: i32,
    vanilla: bool,
}

fn res_new() -> ResMgr {
    return ResMgr {
        paths: rt.buf_new(), npaths: 0, stack: mc_assets.stack_new(), anim: mc_assets.animset_new(),
        atlas: mc_texture.atlas_new(0, 0, 0), ex: mc_texext.texext_new(), tile_cfg: 0, tile_max: 64, auto_on: false,
        mcdir: rt.buf_new(), sounds: SOUNDS_SYNTH, sounds_pref: SOUNDS_BOTH, expected: 0 - 1, warn: rt.buf_new(), nwarn: 0, tile_now: 0, vanilla: false,
    }
}

fn res_free(m: *mut ResMgr) {
    mc_assets.animset_free(&(*m).anim)
    mc_assets.stack_free(&(*m).stack)
    mc_texture.atlas_free(&(*m).atlas)
    mc_texext.texext_free(&(*m).ex)
    rt.buf_free(&(*m).paths)
    rt.buf_free(&(*m).mcdir)
    rt.buf_free(&(*m).warn)
}

fn res_pack_count(m: *mut ResMgr) -> usize { return (*m).stack.n }
fn res_path_count(m: *mut ResMgr) -> usize { return (*m).npaths }
fn res_warn_count(m: *mut ResMgr) -> i32 { return (*m).nwarn }
fn res_sounds_mode(m: *mut ResMgr) -> i32 { return (*m).sounds }

// Runtime switch (mcplay key O): pack sounds off (synth) <-> back to the last pack mode (config / MC_PACK_SOUNDS, default both).
// Returns the new mode; the caller reloads the sounds (see mcplay audio_sounds_toggle).
fn res_toggle_sounds(m: *mut ResMgr) -> i32 {
    if (*m).sounds != SOUNDS_SYNTH {
        (*m).sounds_pref = (*m).sounds
        (*m).sounds = SOUNDS_SYNTH
    } else {
        (*m).sounds = (*m).sounds_pref
    }
    return (*m).sounds
}

fn res_sounds_name(mode: i32) -> str {
    if mode == SOUNDS_ORIGINAL { return "original" }
    if mode == SOUNDS_BOTH { return "both" }
    return "synth"
}
fn res_tile_size(m: *mut ResMgr) -> i32 { return (*m).tile_now }

// The warnings (one per line) as a string view into the manager (valid until the next reload).
fn res_warn_text(m: *mut ResMgr) -> str {
    return str { p: rt.buf_data(&(*m).warn), n: rt.buf_len(&(*m).warn) }
}

fn warn_begin(m: *mut ResMgr) {
    (*m).nwarn = (*m).nwarn + 1
}

fn warn_lit(m: *mut ResMgr, s: str) {
    rt.buf_push_bytes(&(*m).warn, s.p as u64, s.length())
}

// Appends a path (priority order). Duplicates are ignored. false = list full or empty path.
fn res_add_path(m: *mut ResMgr, path: str) -> bool {
    let n: usize = path.length()
    if n == 0 || (*m).npaths >= MAX_PATHS { return false }
    // duplicate check
    let all: u64 = rt.buf_ptr(&(*m).paths)
    let tot: usize = rt.buf_len(&(*m).paths)
    var i: usize = 0
    while i < tot {
        var e: usize = i
        while e < tot && rt.ld8(all, e) != 10 as u8 { e = e + 1 }
        if e - i == n && rt.mem_eq(all + i as u64, path.p as u64, n) { return true }
        i = e + 1
    }
    rt.buf_push_bytes(&(*m).paths, path.p as u64, n)
    rt.buf_push(&(*m).paths, 10 as u8)
    (*m).npaths = (*m).npaths + 1
    return true
}

// "a.zip,b.zip" (comma separated, e.g. a command line argument or an environment variable). Returns the number added.
fn res_add_list(m: *mut ResMgr, list: str) -> i32 {
    let p: u64 = list.p as u64
    let n: usize = list.length()
    var added: i32 = 0
    var i: usize = 0
    while i < n {
        var e: usize = i
        while e < n && rt.ld8(p, e) != 44 as u8 { e = e + 1 }
        let part: str = str { p: (p + i as u64) as *mut u8, n: e - i }
        if res_add_path(m, part) { added = added + 1 }
        i = e + 1
    }
    return added
}

fn is_space(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 13 as u8
}

fn starts_with(p: u64, n: usize, key: str) -> bool {
    let k: usize = key.length()
    return n >= k && rt.mem_eq(p, key.p as u64, k)
}

// "original" / "both" / anything else = synth.
fn parse_sounds_mode(p: u64, n: usize) -> i32 {
    if starts_with(p, n, "original") { return SOUNDS_ORIGINAL }
    if starts_with(p, n, "both") { return SOUNDS_BOTH }
    return SOUNDS_SYNTH
}

fn parse_int(p: u64, n: usize) -> i32 {
    var v: i32 = 0
    var i: usize = 0
    while i < n && rt.ld8(p, i) >= 48 as u8 && rt.ld8(p, i) <= 57 as u8 && v < 100000 {
        v = v * 10 + ((rt.ld8(p, i) as i32) - 48)
        i = i + 1
    }
    return v
}

// Directory part of `path` including the trailing slash ("" when none).
fn dir_len(p: u64, n: usize) -> usize {
    var i: usize = n
    while i > 0 {
        let c: u8 = rt.ld8(p, i - 1)
        if c == 47 as u8 || c == 92 as u8 { return i }
        i = i - 1
    }
    return 0
}

fn is_abs(p: u64, n: usize) -> bool {
    if n == 0 { return false }
    let c: u8 = rt.ld8(p, 0)
    if c == 47 as u8 || c == 92 as u8 { return true }
    return n > 1 && rt.ld8(p, 1) == 58 as u8
}

// Parses config text (see the file header). `base` = directory prefix (with slash) for relative pack paths, may be "".
fn res_load_config_text(m: *mut ResMgr, text: str, base: str) -> i32 {
    let p: u64 = text.p as u64
    let n: usize = text.length()
    var lines: i32 = 0
    var i: usize = 0
    while i < n {
        var e: usize = i
        while e < n && rt.ld8(p, e) != 10 as u8 { e = e + 1 }
        var a: usize = i
        var b: usize = e
        while a < b && is_space(rt.ld8(p, a)) { a = a + 1 }
        while b > a && is_space(rt.ld8(p, b - 1)) { b = b - 1 }
        i = e + 1
        if b == a || rt.ld8(p, a) == 35 as u8 { continue }
        let q: u64 = p + a as u64
        let l: usize = b - a
        lines = lines + 1
        if starts_with(q, l, "tile_max=") {
            let v: i32 = parse_int(q + 9 as u64, l - 9)
            if v >= 1 { (*m).tile_max = v }
        } else if starts_with(q, l, "tile=") {
            (*m).tile_cfg = parse_int(q + 5 as u64, l - 5)
        } else if starts_with(q, l, "auto=") {
            (*m).auto_on = parse_int(q + 5 as u64, l - 5) != 0
        } else if starts_with(q, l, "mcdir=") {
            rt.buf_clear(&(*m).mcdir)
            rt.buf_push_bytes(&(*m).mcdir, q + 6 as u64, l - 6)
        } else if starts_with(q, l, "sounds=") {
            (*m).sounds = parse_sounds_mode(q + 7 as u64, l - 7)
        } else {
            var off: usize = 0
            if starts_with(q, l, "pack=") { off = 5 }
            let rp: u64 = q + off as u64
            let rl: usize = l - off
            if rl > 0 {
                var full: rt.Buf = rt.buf_new()
                if !is_abs(rp, rl) && base.length() > 0 { rt.buf_push_bytes(&full, base.p as u64, base.length()) }
                rt.buf_push_bytes(&full, rp, rl)
                res_add_path(m, str { p: rt.buf_data(&full), n: rt.buf_len(&full) })
                rt.buf_free(&full)
            }
        }
    }
    return lines
}

// Reads a config file. Returns false when it cannot be read.
fn res_load_config(m: *mut ResMgr, path: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(path, &b) catch | e | (0)
    if got == 0 {
        rt.buf_free(&b)
        return false
    }
    let dl: usize = dir_len(path.p as u64, path.length())
    let base: str = str { p: path.p, n: dl }
    res_load_config_text(m, str { p: rt.buf_data(&b), n: rt.buf_len(&b) }, base)
    rt.buf_free(&b)
    return true
}

// Default minecraft directory of the local installation into `out` ("" if nothing can be derived).
fn default_mcdir(out: *mut rt.Buf) {
    let appdata: str = env.get("APPDATA")
    if appdata.length() > 0 {
        rt.buf_push_bytes(out, appdata.p as u64, appdata.length())
        let s: str = "/.minecraft"
        rt.buf_push_bytes(out, s.p as u64, s.length())
        return
    }
    let home: str = env.get("HOME")
    if home.length() == 0 { return }
    var mac: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&mac, home.p as u64, home.length())
    let ms: str = "/Library/Application Support/minecraft"
    rt.buf_push_bytes(&mac, ms.p as u64, ms.length())
    if fs.is_dir(str { p: rt.buf_data(&mac), n: rt.buf_len(&mac) }) {
        rt.buf_push_bytes(out, rt.buf_ptr(&mac), rt.buf_len(&mac))
        rt.buf_free(&mac)
        return
    }
    rt.buf_free(&mac)
    rt.buf_push_bytes(out, home.p as u64, home.length())
    let ls: str = "/.minecraft"
    rt.buf_push_bytes(out, ls.p as u64, ls.length())
}

fn name_lt(p: u64, ao: usize, al: usize, bo: usize, bl: usize) -> bool {
    var i: usize = 0
    while i < al && i < bl {
        let x: u8 = rt.ld8(p, ao + i)
        let y: u8 = rt.ld8(p, bo + i)
        if x < y { return true }
        if x > y { return false }
        i = i + 1
    }
    return al < bl
}

// Adds the *.zip files of <mcdir>/resourcepacks (name order) with the LOWEST priority (after everything added so far).
// mcdir "" = the manager's `mcdir=` setting, else the default of this machine. Looks only at run time at the player's own
// folder; nothing is copied. Returns the number of packs found.
fn res_autodiscover(m: *mut ResMgr, mcdir: str) -> i32 {
    var root: rt.Buf = rt.buf_new()
    if mcdir.length() > 0 {
        rt.buf_push_bytes(&root, mcdir.p as u64, mcdir.length())
    } else if rt.buf_len(&(*m).mcdir) > 0 {
        rt.buf_push_bytes(&root, rt.buf_ptr(&(*m).mcdir), rt.buf_len(&(*m).mcdir))
    } else {
        default_mcdir(&root)
    }
    if rt.buf_len(&root) == 0 {
        rt.buf_free(&root)
        return 0
    }
    let sub: str = "/resourcepacks"
    rt.buf_push_bytes(&root, sub.p as u64, sub.length())
    var d: dir.Dir = dir.open(str { p: rt.buf_data(&root), n: rt.buf_len(&root) })
    var names: rt.Buf = rt.buf_new()
    var offs: [usize; 64] = [0; 64]
    var lens: [usize; 64] = [0; 64]
    var cnt: usize = 0
    if dir.is_open(&d) {
        while dir.next(&d) && cnt < 64 {
            let nl: usize = d.name.length()
            let np: u64 = d.name.p as u64
            if nl > 4 && rt.ld8(np, nl - 4) == 46 as u8 && (rt.ld8(np, nl - 3) | 32 as u8) == 122 as u8 &&
            (rt.ld8(np, nl - 2) | 32 as u8) == 105 as u8 && (rt.ld8(np, nl - 1) | 32 as u8) == 112 as u8 {
                offs[cnt] = rt.buf_len(&names)
                lens[cnt] = nl
                rt.buf_push_bytes(&names, np, nl)
                cnt = cnt + 1
            }
        }
    }
    dir.close(&d)
    // insertion sort by name
    var i: usize = 1
    while i < cnt {
        let o: usize = offs[i]
        let l: usize = lens[i]
        var j: usize = i
        while j > 0 && name_lt(rt.buf_ptr(&names), o, l, offs[j - 1], lens[j - 1]) {
            offs[j] = offs[j - 1]
            lens[j] = lens[j - 1]
            j = j - 1
        }
        offs[j] = o
        lens[j] = l
        i = i + 1
    }
    var added: i32 = 0
    i = 0
    while i < cnt {
        var full: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&full, rt.buf_ptr(&root), rt.buf_len(&root))
        rt.buf_push(&full, 47 as u8)
        rt.buf_push_bytes(&full, rt.buf_ptr(&names) + offs[i] as u64, lens[i])
        if res_add_path(m, str { p: rt.buf_data(&full), n: rt.buf_len(&full) }) { added = added + 1 }
        rt.buf_free(&full)
        i = i + 1
    }
    rt.buf_free(&names)
    rt.buf_free(&root)
    return added
}

// Expected resource pack_format for a game protocol (mc_blocktex table, from versions.json); unknown protocol = no warnings.
fn res_set_protocol(m: *mut ResMgr, protocol: i32) {
    (*m).expected = mc_blocktex.pack_format_for_protocol(protocol)
}

// Builds the block tables with extended tile ids for `reg`. Do this once per game version (before the first reload).
fn res_build_tables(m: *mut ResMgr, reg: *mut mc_registry.Registry, tb: *mut mc_mesh.MeshTables) {
    mc_texext.tex_build_tables_ext(reg, tb, &(*m).ex)
}

fn pow2_ceil(v: i32) -> i32 {
    var p: i32 = 1
    while p < v && p < 4096 { p = p * 2 }
    return p
}

// Tile size for the packs of the stack: configured, else the widest of a few common block textures, clamped to [16, tile_max].
fn pick_tile_size(m: *mut ResMgr) -> i32 {
    var ts: i32 = (*m).tile_cfg
    if ts < 1 {
        var best: i32 = 16
        var pi: usize = 0
        while pi < (*m).stack.n {
            var k: u32 = 1
            while k <= 6 {
                let name: str = mc_assets.tile_file(k)
                var im: png.Image = png.image_new()
                if mc_assets.pack_load_block(&(*m).stack.packs[pi], name, &im) {
                    let w: i32 = png.image_width(&im) as i32
                    if w > best { best = w }
                    png.image_free(&im)
                }
                k = k + 1
            }
            pi = pi + 1
        }
        ts = pow2_ceil(best)
        if ts > (*m).tile_max { ts = (*m).tile_max }
    }
    if ts < 1 { ts = 16 }
    return pow2_ceil(ts)
}

// (Re)opens every pack of the list, rebuilds the atlas (defaults + extended tiles + packs + animations at tick 0). Problems are
// warnings (res_warn_text): unreadable / invalid packs are skipped, a pack for another game version only warns. Returns the
// number of packs in use. The atlas pointer changes: run res_upload (or use res_reload_upload).
fn res_reload(m: *mut ResMgr) -> i32 {
    mc_assets.animset_free(&(*m).anim)
    mc_assets.stack_free(&(*m).stack)
    rt.buf_clear(&(*m).warn)
    (*m).nwarn = 0
    let all: u64 = rt.buf_ptr(&(*m).paths)
    let tot: usize = rt.buf_len(&(*m).paths)
    var i: usize = 0
    while i < tot {
        var e: usize = i
        while e < tot && rt.ld8(all, e) != 10 as u8 { e = e + 1 }
        let path: str = str { p: (all + i as u64) as *mut u8, n: e - i }
        var pk: mc_assets.Pack = mc_assets.pack_empty()
        let rc: i32 = mc_assets.pack_open_file(&pk, path)
        if rc != mc_assets.ASSET_OK {
            warn_begin(m)
            warn_lit(m, "cannot use pack (code ")
            rt.buf_push_dec_i64(&(*m).warn, rc as i64)
            warn_lit(m, "): ")
            warn_lit(m, path)
            rt.buf_push(&(*m).warn, 10 as u8)
        } else {
            if !mc_assets.pack_format_ok(&pk, (*m).expected) {
                warn_begin(m)
                warn_lit(m, "pack_format ")
                rt.buf_push_dec_i64(&(*m).warn, pk.fmin as i64)
                warn_lit(m, "..")
                rt.buf_push_dec_i64(&(*m).warn, pk.fmax as i64)
                warn_lit(m, " but the game version wants ")
                rt.buf_push_dec_i64(&(*m).warn, (*m).expected as i64)
                warn_lit(m, ": ")
                warn_lit(m, path)
                rt.buf_push(&(*m).warn, 10 as u8)
            }
            let sc: i32 = mc_assets.stack_push(&(*m).stack, &pk)
            if sc != mc_assets.ASSET_OK {
                warn_begin(m)
                warn_lit(m, "too many packs, ignored: ")
                warn_lit(m, path)
                rt.buf_push(&(*m).warn, 10 as u8)
            }
        }
        i = e + 1
    }
    let ts: i32 = pick_tile_size(m)
    mc_texture.atlas_free(&(*m).atlas)
    (*m).atlas = mc_texext.texext_atlas_new(ts, &(*m).ex)
    (*m).tile_now = ts
    mc_assets.assets_apply_ext(&(*m).stack, &(*m).atlas, &(*m).ex, &(*m).anim)
    return (*m).stack.n as i32
}

// Hands the atlas to the render back end (upload_atlas of the back end table: CPU rasterizer or GL texture array).
fn res_upload(m: *mut ResMgr, b: *mut mc_backend.Backend) {
    (*b).upload_atlas((*b).obj, (&(*m).atlas) as u64)
}

fn res_reload_upload(m: *mut ResMgr, b: *mut mc_backend.Backend) -> i32 {
    let n: i32 = res_reload(m)
    res_upload(m, b)
    return n
}

// Animated tiles for game tick `tick`; uploads the atlas when at least one tile changed. Returns the number of changed tiles.
fn res_tick(m: *mut ResMgr, tick: i64, b: *mut mc_backend.Backend) -> i32 {
    let c: i32 = mc_assets.anim_update(&(*m).anim, &(*m).atlas, tick)
    if c > 0 { res_upload(m, b) }
    return c
}

// ---- client wiring: environment + hot-reload key -----------------------------------------------------
// MC_PACKS="a.zip,b.zip" (first = top priority), MC_PACK_CONFIG=<file> (see res_load_config_text), MC_PACK_AUTO=1 (scan <mcdir>/resourcepacks),
// MC_PACK_DIR=<minecraft dir> (default: the installation of the player), MC_PACK_TILE=<px> (tile size override),
// MC_PACK_SOUNDS=synth|original|both (sound source, overrides `sounds=` of the config).
// All unset = packs are off (res_env_wanted false) and a client keeps its built-in look.
fn res_env_wanted() -> bool {
    return env.has("MC_PACKS") || env.has("MC_PACK_CONFIG") || env.has("MC_PACK_AUTO")
}

// Fills `m` from the environment (no reload yet). Returns the number of pack paths that are queued.
fn res_setup_env(m: *mut ResMgr, protocol: i32) -> i32 {
    res_set_protocol(m, protocol)
    if env.has("MC_PACK_TILE") {
        let t: str = env.get("MC_PACK_TILE")
        let v: i32 = parse_int(t.p as u64, t.length())
        if v > 0 { (*m).tile_cfg = v }
    }
    if env.has("MC_PACK_CONFIG") {
        res_load_config(m, env.get("MC_PACK_CONFIG"))
    }
    if env.has("MC_PACKS") {
        res_add_list(m, env.get("MC_PACKS"))
    }
    // MC_PACK_SOUNDS=synth|original|both overrides the config's `sounds=`
    if env.has("MC_PACK_SOUNDS") {
        let sm: str = env.get("MC_PACK_SOUNDS")
        (*m).sounds = parse_sounds_mode(sm.p as u64, sm.length())
    }
    var auto: bool = (*m).auto_on
    if env.has("MC_PACK_AUTO") {
        let a: str = env.get("MC_PACK_AUTO")
        if a.length() > 0 && rt.ld8(a.p as u64, 0) != 48 as u8 { auto = true }
    }
    if auto {
        var dir: str = ""
        if env.has("MC_PACK_DIR") { dir = env.get("MC_PACK_DIR") }
        res_autodiscover(m, dir)
    }
    if (*m).vanilla { res_add_vanilla(m, protocol) }
    return (*m).npaths as i32
}

fn res_use_vanilla(m: *mut ResMgr) {
    (*m).vanilla = true
}

fn res_vanilla_wanted(protocol: i32) -> bool {
    var path: rt.Buf = rt.buf_new()
    let rc: i32 = mc_vanilla.vanilla_ensure(protocol, &path)
    rt.buf_free(&path)
    if rc == mc_vanilla.VANILLA_OK { return true }
    if rc != mc_vanilla.VANILLA_OFF {
        io.fmt_eprint_line(f"mcplay: vanilla resources unavailable ({mc_vanilla.vanilla_status_text(rc)}) -- built-in textures")
    }
    return false
}

fn res_add_vanilla(m: *mut ResMgr, protocol: i32) {
    var path: rt.Buf = rt.buf_new()
    let rc: i32 = mc_vanilla.vanilla_ensure(protocol, &path)
    if rc == mc_vanilla.VANILLA_OK {
        if res_add_path(m, rt.buf_str(&path)) {
            io.fmt_eprint_line(f"mcplay: vanilla resources from {rt.buf_str(&path)}")
        }
    }
    rt.buf_free(&path)
}

// Key event of the window layer: the reload key re-reads all packs and re-uploads the atlas. Returns the number of packs in use,
// -1 when `key` is not the reload key.
fn res_on_key(m: *mut ResMgr, b: *mut mc_backend.Backend, key: i32) -> i32 {
    if key != RES_KEY_RELOAD { return 0 - 1 }
    return res_reload_upload(m, b)
}
