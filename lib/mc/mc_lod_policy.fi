export { LodPlan, LOD_FULL_RING, LOD_UNSET, lod_plan }

const LOD_FULL_RING: i32 = 8
const LOD_UNSET: i32 = 0 - 1

struct LodPlan {
    view: i32,
    lod: i32,
}

fn lod_plan(requested_view: i32, lod_env: i32) -> LodPlan {
    if lod_env == 0 {
        return LodPlan { view: requested_view, lod: 0 }
    }
    if lod_env > 0 {
        return LodPlan { view: requested_view, lod: lod_env }
    }
    if requested_view > LOD_FULL_RING {
        return LodPlan { view: LOD_FULL_RING, lod: requested_view }
    }
    return LodPlan { view: requested_view, lod: 0 }
}
