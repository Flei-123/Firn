// SPDX-License-Identifier: MPL-2.0
export { ViewSync, vs_new, vs_poll, vs_applied, vs_locked, vs_wire }

struct ViewSync {
    applied: i32,
    locked: bool,
}

fn vs_new(initial: i32, locked: bool) -> ViewSync {
    return ViewSync { applied: initial, locked: locked }
}

fn vs_applied(v: *mut ViewSync) -> i32 { return (*v).applied }

fn vs_locked(v: *mut ViewSync) -> bool { return (*v).locked }

fn vs_poll(v: *mut ViewSync, wanted: i32, dragging: bool) -> i32 {
    if (*v).locked || dragging || wanted <= 0 || wanted == (*v).applied { return 0 }
    (*v).applied = wanted
    return wanted
}

fn vs_wire(view: i32, lod: i32) -> i32 {
    if lod > view { return lod }
    return view
}
