import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_launch_cfg
import mc.mc_serverlist
import mc.mc_hostname
import input.raw

export {
    StartForm, form_new, form_free, form_set, form_char, form_keys, form_validate, form_port, form_draw, form_to_cfg, form_from_cfg,
    form_text_ptr, form_text_len, form_pointer, form_submit, form_save, form_remove, Box, field_box, row_box, button_box,
    BTN_JOIN, BTN_SAVE, BTN_REMOVE, BTN_QUIT, LAYOUT_W, LAYOUT_H,
    FIELD_HOST, FIELD_PORT, FIELD_NAME, FIELDS, ERR_NONE, ERR_HOST, ERR_PORT, ERR_NAME, HOST_MAX, PORT_MAX, NAME_MAX,
    BG_COLOR, BOX_COLOR, BOX_ACTIVE,
}

const FIELD_HOST: i32 = 0
const FIELD_PORT: i32 = 1
const FIELD_NAME: i32 = 2
const FIELDS: i32 = 3
const ERR_NONE: i32 = 0
const ERR_HOST: i32 = 1
const ERR_PORT: i32 = 2
const ERR_NAME: i32 = 3
const HOST_MAX: usize = 28
const PORT_MAX: usize = 5
const NAME_MAX: usize = 16

const SC_ESC: u32 = 1
const SC_BACKSPACE: u32 = 14
const SC_TAB: u32 = 15
const SC_ENTER: u32 = 28
const SC_KP_ENTER: u32 = 96
const SC_UP: u32 = 103
const SC_DOWN: u32 = 108

const BG_COLOR: u32 = 0xFF2A2A2A
const BOX_COLOR: u32 = 0xFF101010
const BOX_ACTIVE: u32 = 0xFFE0E0E0
const TEXT_COLOR: u32 = 0xFFFFFFFF
const LABEL_COLOR: u32 = 0xFFAAAAAA
const ERROR_COLOR: u32 = 0xFF5555FF
const SHADOW: u32 = 0xFF3F3F3F

const DOUBLE_MS: u64 = 400 as u64
const LAYOUT_W: i32 = 320
const LAYOUT_H: i32 = 240
const COL_X: i32 = 134
const COL_W: i32 = 180
const FIELD_Y: i32 = 56
const FIELD_PITCH: i32 = 34
const LIST_X: i32 = 8
const LIST_Y: i32 = 68
const LIST_W: i32 = 114
const ROW_H: i32 = 12
const ROW_CHARS: usize = 18
const BTN_Y: i32 = 176
const BTN_W: i32 = 43
const BTN_H: i32 = 16
const BTN_PITCH: i32 = 46
const BTN_COUNT: i32 = 4
const BTN_JOIN: i32 = 0
const BTN_SAVE: i32 = 1
const BTN_REMOVE: i32 = 2
const BTN_QUIT: i32 = 3
const SERVERS_ROWS: i32 = 8
const ROW_ID: i32 = 10
const BTN_ID: i32 = 30
const NO_HIT: i32 = 0 - 1
const ROW_SELECTED: u32 = 0xFF3A3A5A
const ROW_HOVER: u32 = 0xFF262626
const BTN_HOVER: u32 = 0xFF3C3C3C
const EDGE_HOVER: u32 = 0xFFCCCCCC

struct Box {
    x: i32,
    y: i32,
    w: i32,
    h: i32,
}

struct StartForm {
    host: rt.Buf,
    port: rt.Buf,
    name: rt.Buf,
    servers: mc_serverlist.ServerList,
    active: i32,
    problem: i32,
    hover: i32,
    click_row: i32,
    click_ms: u64,
    submitted: bool,
    cancelled: bool,
}

fn form_new() -> StartForm {
    var f: StartForm = StartForm {
        host: rt.buf_new(), port: rt.buf_new(), name: rt.buf_new(), servers: mc_serverlist.sl_new(), active: FIELD_HOST, problem: ERR_NONE,
        hover: NO_HIT, click_row: NO_HIT, click_ms: 0 as u64, submitted: false, cancelled: false,
    }
    let dp: str = "25565"
    form_set(&f, FIELD_PORT, dp.p as u64, dp.n)
    return f
}

fn form_free(f: *mut StartForm) {
    rt.buf_free(&(*f).host)
    rt.buf_free(&(*f).port)
    rt.buf_free(&(*f).name)
    mc_serverlist.sl_free(&(*f).servers)
}

fn field_buf(f: *mut StartForm, k: i32) -> *mut rt.Buf {
    if k == FIELD_HOST { return &(*f).host }
    if k == FIELD_PORT { return &(*f).port }
    return &(*f).name
}

fn field_max(k: i32) -> usize {
    if k == FIELD_HOST { return HOST_MAX }
    if k == FIELD_PORT { return PORT_MAX }
    return NAME_MAX
}

fn form_text_ptr(f: *mut StartForm, k: i32) -> u64 {
    return rt.buf_ptr(field_buf(f, k))
}

fn form_text_len(f: *mut StartForm, k: i32) -> usize {
    return rt.buf_len(field_buf(f, k))
}

fn accepts(k: i32, code: u32) -> bool {
    let digit: bool = code >= 48 as u32 && code <= 57 as u32
    if k == FIELD_PORT { return digit }
    if k == FIELD_HOST { return mc_hostname.host_char_ok(code) }
    let upper: bool = code >= 65 as u32 && code <= 90 as u32
    let lower: bool = code >= 97 as u32 && code <= 122 as u32
    return digit || upper || lower || code == 95 as u32
}

fn form_set(f: *mut StartForm, k: i32, p: u64, n: usize) {
    let b: *mut rt.Buf = field_buf(f, k)
    rt.buf_clear(b)
    var m: usize = n
    if m > field_max(k) { m = field_max(k) }
    var i: usize = 0
    while i < m {
        let ch: u8 = rt.ld8(p, i)
        if accepts(k, ch as u32) { rt.buf_push(b, ch) }
        i = i + 1
    }
}

fn form_char(f: *mut StartForm, code: u32) -> bool {
    let b: *mut rt.Buf = field_buf(f, (*f).active)
    if !accepts((*f).active, code) || rt.buf_len(b) >= field_max((*f).active) { return false }
    rt.buf_push(b, code as u8)
    (*f).problem = ERR_NONE
    return true
}

fn host_ok(p: u64, n: usize) -> bool {
    return mc_hostname.host_valid(p, n)
}

fn form_port(f: *mut StartForm) -> i32 {
    let n: usize = rt.buf_len(&(*f).port)
    if n == 0 { return 0 - 1 }
    var v: i32 = 0
    var i: usize = 0
    while i < n {
        v = v * 10 + (rt.ld8(rt.buf_ptr(&(*f).port), i) as i32 - 48)
        i = i + 1
    }
    if v <= 0 || v > 65535 { return 0 - 1 }
    return v
}

fn form_validate(f: *mut StartForm) -> i32 {
    if !host_ok(rt.buf_ptr(&(*f).host), rt.buf_len(&(*f).host)) { return ERR_HOST }
    if form_port(f) < 0 { return ERR_PORT }
    if rt.buf_len(&(*f).name) == 0 { return ERR_NAME }
    return ERR_NONE
}

fn form_keys(f: *mut StartForm, rw: *mut raw.Raw) {
    if raw.key_pressed(rw, SC_ESC) {
        (*f).cancelled = true
        return
    }
    if raw.key_pressed(rw, SC_TAB) || raw.key_pressed(rw, SC_DOWN) { (*f).active = ((*f).active + 1) % FIELDS }
    if raw.key_pressed(rw, SC_UP) { (*f).active = ((*f).active + FIELDS - 1) % FIELDS }
    if raw.key_pressed(rw, SC_BACKSPACE) {
        let b: *mut rt.Buf = field_buf(f, (*f).active)
        if rt.buf_len(b) > 0 { (*b).len = (*b).len - 1 }
        (*f).problem = ERR_NONE
    }
    if raw.key_pressed(rw, SC_ENTER) || raw.key_pressed(rw, SC_KP_ENTER) { form_submit(f) }
}

fn form_submit(f: *mut StartForm) {
    let e: i32 = form_validate(f)
    (*f).problem = e
    if e == ERR_NONE {
        mc_serverlist.sl_add(&(*f).servers, rt.buf_ptr(&(*f).host), rt.buf_len(&(*f).host), form_port(f))
        (*f).submitted = true
    } else {
        (*f).active = e - 1
    }
}

fn form_save(f: *mut StartForm) {
    if !host_ok(rt.buf_ptr(&(*f).host), rt.buf_len(&(*f).host)) {
        (*f).problem = ERR_HOST
        (*f).active = FIELD_HOST
        return
    }
    if form_port(f) < 0 {
        (*f).problem = ERR_PORT
        (*f).active = FIELD_PORT
        return
    }
    (*f).problem = ERR_NONE
    mc_serverlist.sl_add(&(*f).servers, rt.buf_ptr(&(*f).host), rt.buf_len(&(*f).host), form_port(f))
}

fn current_index(f: *mut StartForm) -> i32 {
    let port: i32 = form_port(f)
    if port < 0 { return NO_HIT }
    return mc_serverlist.sl_find(&(*f).servers, rt.buf_ptr(&(*f).host), rt.buf_len(&(*f).host), port)
}

fn form_remove(f: *mut StartForm) {
    mc_serverlist.sl_remove(&(*f).servers, current_index(f))
}

fn set_port(f: *mut StartForm, v: i32) {
    rt.buf_clear(&(*f).port)
    rt.buf_push_dec_i64(&(*f).port, v as i64)
}

fn choose_server(f: *mut StartForm, i: i32) {
    var h: rt.Buf = rt.buf_new()
    mc_serverlist.sl_host(&(*f).servers, i, &h)
    form_set(f, FIELD_HOST, rt.buf_ptr(&h), rt.buf_len(&h))
    rt.buf_free(&h)
    set_port(f, mc_serverlist.sl_port(&(*f).servers, i))
    (*f).problem = ERR_NONE
    (*f).active = FIELD_NAME
}

fn origin_x(w: i32, s: i32) -> i32 {
    return (w - LAYOUT_W * s) / 2
}

fn origin_y(h: i32, s: i32) -> i32 {
    return (h - LAYOUT_H * s) / 2
}

fn field_box(w: i32, h: i32, s: i32, k: i32) -> Box {
    return Box { x: origin_x(w, s) + COL_X * s, y: origin_y(h, s) + (FIELD_Y + k * FIELD_PITCH) * s, w: COL_W * s, h: 28 * s }
}

fn row_box(w: i32, h: i32, s: i32, i: i32) -> Box {
    return Box { x: origin_x(w, s) + LIST_X * s, y: origin_y(h, s) + (LIST_Y + i * ROW_H) * s, w: LIST_W * s, h: ROW_H * s }
}

fn button_box(w: i32, h: i32, s: i32, b: i32) -> Box {
    return Box { x: origin_x(w, s) + (COL_X + b * BTN_PITCH) * s, y: origin_y(h, s) + BTN_Y * s, w: BTN_W * s, h: BTN_H * s }
}

fn box_has(b: Box, mx: i32, my: i32) -> bool {
    return mx >= b.x && my >= b.y && mx < b.x + b.w && my < b.y + b.h
}

fn pick_target(f: *mut StartForm, w: i32, h: i32, s: i32, mx: i32, my: i32) -> i32 {
    var k: i32 = 0
    while k < FIELDS {
        if box_has(field_box(w, h, s, k), mx, my) { return k }
        k = k + 1
    }
    var b: i32 = 0
    while b < BTN_COUNT {
        if box_has(button_box(w, h, s, b), mx, my) { return BTN_ID + b }
        b = b + 1
    }
    var i: i32 = 0
    while i < mc_serverlist.sl_count(&(*f).servers) {
        if box_has(row_box(w, h, s, i), mx, my) { return ROW_ID + i }
        i = i + 1
    }
    return NO_HIT
}

fn press_button(f: *mut StartForm, b: i32) {
    if b == BTN_JOIN { form_submit(f) }
    if b == BTN_SAVE { form_save(f) }
    if b == BTN_REMOVE { form_remove(f) }
    if b == BTN_QUIT { (*f).cancelled = true }
}

fn press_target(f: *mut StartForm, id: i32, ms: u64) {
    if id < 0 { return }
    if id < FIELDS {
        (*f).active = id
        return
    }
    if id >= BTN_ID {
        press_button(f, id - BTN_ID)
        return
    }
    let row: i32 = id - ROW_ID
    choose_server(f, row)
    if (*f).click_row == row && ms - (*f).click_ms < DOUBLE_MS {
        (*f).click_row = NO_HIT
        form_submit(f)
        return
    }
    (*f).click_row = row
    (*f).click_ms = ms
}

fn form_pointer(f: *mut StartForm, w: i32, h: i32, s: i32, mx: i32, my: i32, clicked: bool, ms: u64) {
    let id: i32 = pick_target(f, w, h, s, mx, my)
    (*f).hover = id
    if clicked { press_target(f, id, ms) }
}

fn form_from_cfg(f: *mut StartForm, c: *mut mc_launch_cfg.LaunchCfg) {
    if rt.buf_len(&(*c).host) > 0 { form_set(f, FIELD_HOST, rt.buf_ptr(&(*c).host), rt.buf_len(&(*c).host)) }
    if rt.buf_len(&(*c).name) > 0 { form_set(f, FIELD_NAME, rt.buf_ptr(&(*c).name), rt.buf_len(&(*c).name)) }
    if (*c).port > 0 && (*c).port <= 65535 { set_port(f, (*c).port) }
    mc_serverlist.sl_copy(&(*f).servers, &(*c).servers)
    (*f).active = FIELD_HOST
    if rt.buf_len(&(*f).host) > 0 { (*f).active = FIELD_NAME }
}

fn form_to_cfg(f: *mut StartForm, c: *mut mc_launch_cfg.LaunchCfg) {
    rt.buf_clear(&(*c).host)
    rt.buf_clear(&(*c).name)
    rt.buf_push_bytes(&(*c).host, rt.buf_ptr(&(*f).host), rt.buf_len(&(*f).host))
    rt.buf_push_bytes(&(*c).name, rt.buf_ptr(&(*f).name), rt.buf_len(&(*f).name))
    (*c).port = form_port(f)
    mc_serverlist.sl_copy(&(*c).servers, &(*f).servers)
}

fn draw_field(f: *mut StartForm, r: *mut mc_raster.Raster, s: i32, k: i32, label: str, blink: bool) {
    let fb: Box = field_box((*r).w, (*r).h, s, k)
    let bx: i32 = fb.x
    let y: i32 = fb.y
    let on: bool = (*f).active == k
    mc_hud.hud_text(r, bx, y, s, LABEL_COLOR, SHADOW, label)
    var edge: u32 = LABEL_COLOR
    if (*f).hover == k { edge = EDGE_HOVER }
    if on { edge = BOX_ACTIVE }
    if (*f).problem == k + 1 { edge = ERROR_COLOR }
    mc_hud.hud_rect(r, bx - s, y + 10 * s, fb.w + 2 * s, 16 * s, edge)
    mc_hud.hud_rect(r, bx, y + 11 * s, fb.w, 14 * s, BOX_COLOR)
    let n: usize = form_text_len(f, k)
    mc_hud.hud_text_bytes(r, bx + 4 * s, y + 14 * s, s, TEXT_COLOR, SHADOW, form_text_ptr(f, k), n)
    if on && blink {
        mc_hud.hud_rect(r, bx + 4 * s + mc_hud.hud_text_width(n, s) + s, y + 13 * s, s, 9 * s, TEXT_COLOR)
    }
}

fn centered(r: *mut mc_raster.Raster, s: i32, y: i32, c: u32, t: str) {
    mc_hud.hud_text(r, (*r).w / 2 - mc_hud.hud_text_width(t.n, s) / 2, y, s, c, SHADOW, t)
}

fn row_text_len(f: *mut StartForm, i: i32) -> usize {
    var n: usize = mc_serverlist.sl_len(&(*f).servers, i)
    let p: u64 = mc_serverlist.sl_ptr(&(*f).servers, i)
    let tail: str = ":25565"
    if n > tail.n {
        var same: bool = true
        var k: usize = 0
        while k < tail.n {
            if rt.ld8(p, n - tail.n + k) != tail.chars(k) { same = false }
            k = k + 1
        }
        if same { n = n - tail.n }
    }
    if n > ROW_CHARS { n = ROW_CHARS }
    return n
}

fn draw_list(f: *mut StartForm, r: *mut mc_raster.Raster, s: i32) {
    let top: Box = row_box((*r).w, (*r).h, s, 0)
    mc_hud.hud_text(r, top.x, top.y - 12 * s, s, LABEL_COLOR, SHADOW, "Servers")
    mc_hud.hud_rect(r, top.x - s, top.y - s, top.w + 2 * s, SERVERS_ROWS * ROW_H * s + 2 * s, LABEL_COLOR)
    mc_hud.hud_rect(r, top.x, top.y, top.w, SERVERS_ROWS * ROW_H * s, BOX_COLOR)
    let count: i32 = mc_serverlist.sl_count(&(*f).servers)
    if count == 0 {
        mc_hud.hud_text(r, top.x + 3 * s, top.y + 3 * s, s, LABEL_COLOR, SHADOW, "(none saved)")
    }
    let cur: i32 = current_index(f)
    var i: i32 = 0
    while i < count {
        let rb: Box = row_box((*r).w, (*r).h, s, i)
        if (*f).hover == ROW_ID + i { mc_hud.hud_rect(r, rb.x, rb.y, rb.w, rb.h, ROW_HOVER) }
        if cur == i { mc_hud.hud_rect(r, rb.x, rb.y, rb.w, rb.h, ROW_SELECTED) }
        mc_hud.hud_text_bytes(r, rb.x + 3 * s, rb.y + 3 * s, s, TEXT_COLOR, SHADOW, mc_serverlist.sl_ptr(&(*f).servers, i), row_text_len(f, i))
        i = i + 1
    }
}

fn draw_button(f: *mut StartForm, r: *mut mc_raster.Raster, s: i32, b: i32, label: str) {
    let bb: Box = button_box((*r).w, (*r).h, s, b)
    var edge: u32 = LABEL_COLOR
    var fill: u32 = BOX_COLOR
    if (*f).hover == BTN_ID + b {
        edge = BOX_ACTIVE
        fill = BTN_HOVER
    }
    mc_hud.hud_rect(r, bb.x - s, bb.y - s, bb.w + 2 * s, bb.h + 2 * s, edge)
    mc_hud.hud_rect(r, bb.x, bb.y, bb.w, bb.h, fill)
    mc_hud.hud_text(r, bb.x + bb.w / 2 - mc_hud.hud_text_width(label.n, s) / 2, bb.y + 4 * s, s, TEXT_COLOR, SHADOW, label)
}

fn form_draw(f: *mut StartForm, r: *mut mc_raster.Raster, s: i32, ms: u64) {
    mc_hud.hud_rect(r, 0, 0, (*r).w, (*r).h, BG_COLOR)
    let oy: i32 = origin_y((*r).h, s)
    centered(r, s * 2, oy + 12 * s, TEXT_COLOR, "mcplay")
    centered(r, s, oy + 34 * s, LABEL_COLOR, "Join a server")
    let blink: bool = (ms / 500 as u64) % 2 as u64 == 0 as u64
    draw_list(f, r, s)
    draw_field(f, r, s, FIELD_HOST, "Server address", blink)
    draw_field(f, r, s, FIELD_PORT, "Port", blink)
    draw_field(f, r, s, FIELD_NAME, "Player name", blink)
    draw_button(f, r, s, BTN_JOIN, "Join")
    draw_button(f, r, s, BTN_SAVE, "Save")
    draw_button(f, r, s, BTN_REMOVE, "Remove")
    draw_button(f, r, s, BTN_QUIT, "Quit")
    if (*f).problem == ERR_HOST { centered(r, s, oy + 160 * s, ERROR_COLOR, "Address like play.example.com or 192.168.1.20") }
    if (*f).problem == ERR_PORT { centered(r, s, oy + 160 * s, ERROR_COLOR, "Port must be 1 to 65535") }
    if (*f).problem == ERR_NAME { centered(r, s, oy + 160 * s, ERROR_COLOR, "Enter a player name") }
    centered(r, s, oy + 208 * s, LABEL_COLOR, "Tab next  Enter join  Click select  Esc quit")
}
