import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_launch_cfg
import input.raw

export {
    StartForm, form_new, form_free, form_set, form_char, form_keys, form_validate, form_port, form_draw, form_to_cfg, form_from_cfg,
    form_text_ptr, form_text_len,
    FIELD_HOST, FIELD_PORT, FIELD_NAME, FIELDS, ERR_NONE, ERR_HOST, ERR_PORT, ERR_NAME, HOST_MAX, PORT_MAX, NAME_MAX,
    BG_COLOR, BOX_COLOR, BOX_ACTIVE,
}

const FIELD_HOST: i32 = 0
const FIELD_PORT: i32 = 1
const FIELD_NAME: i32 = 2
const FIELDS: i32 = 3
const ERR_NONE: i32 = 0
const ERR_HOST: i32 = 1
const ERR_PORT: i32 = 2
const ERR_NAME: i32 = 3
const HOST_MAX: usize = 15
const PORT_MAX: usize = 5
const NAME_MAX: usize = 16

const SC_ESC: u32 = 1
const SC_BACKSPACE: u32 = 14
const SC_TAB: u32 = 15
const SC_ENTER: u32 = 28
const SC_KP_ENTER: u32 = 96
const SC_UP: u32 = 103
const SC_DOWN: u32 = 108

const BG_COLOR: u32 = 0xFF2A2A2A
const BOX_COLOR: u32 = 0xFF101010
const BOX_ACTIVE: u32 = 0xFFE0E0E0
const TEXT_COLOR: u32 = 0xFFFFFFFF
const LABEL_COLOR: u32 = 0xFFAAAAAA
const ERROR_COLOR: u32 = 0xFF5555FF
const SHADOW: u32 = 0xFF3F3F3F

struct StartForm {
    host: rt.Buf,
    port: rt.Buf,
    name: rt.Buf,
    active: i32,
    problem: i32,
    submitted: bool,
    cancelled: bool,
}

fn form_new() -> StartForm {
    var f: StartForm = StartForm {
        host: rt.buf_new(), port: rt.buf_new(), name: rt.buf_new(), active: FIELD_HOST, problem: ERR_NONE, submitted: false, cancelled: false,
    }
    let dp: str = "25565"
    form_set(&f, FIELD_PORT, dp.p as u64, dp.n)
    return f
}

fn form_free(f: *mut StartForm) {
    rt.buf_free(&(*f).host)
    rt.buf_free(&(*f).port)
    rt.buf_free(&(*f).name)
}

fn field_buf(f: *mut StartForm, k: i32) -> *mut rt.Buf {
    if k == FIELD_HOST { return &(*f).host }
    if k == FIELD_PORT { return &(*f).port }
    return &(*f).name
}

fn field_max(k: i32) -> usize {
    if k == FIELD_HOST { return HOST_MAX }
    if k == FIELD_PORT { return PORT_MAX }
    return NAME_MAX
}

fn form_text_ptr(f: *mut StartForm, k: i32) -> u64 {
    return rt.buf_ptr(field_buf(f, k))
}

fn form_text_len(f: *mut StartForm, k: i32) -> usize {
    return rt.buf_len(field_buf(f, k))
}

fn accepts(k: i32, code: u32) -> bool {
    let digit: bool = code >= 48 as u32 && code <= 57 as u32
    if k == FIELD_PORT { return digit }
    if k == FIELD_HOST { return digit || code == 46 as u32 }
    let upper: bool = code >= 65 as u32 && code <= 90 as u32
    let lower: bool = code >= 97 as u32 && code <= 122 as u32
    return digit || upper || lower || code == 95 as u32
}

fn form_set(f: *mut StartForm, k: i32, p: u64, n: usize) {
    let b: *mut rt.Buf = field_buf(f, k)
    rt.buf_clear(b)
    var m: usize = n
    if m > field_max(k) { m = field_max(k) }
    var i: usize = 0
    while i < m {
        let ch: u8 = rt.ld8(p, i)
        if accepts(k, ch as u32) { rt.buf_push(b, ch) }
        i = i + 1
    }
}

fn form_char(f: *mut StartForm, code: u32) -> bool {
    let b: *mut rt.Buf = field_buf(f, (*f).active)
    if !accepts((*f).active, code) || rt.buf_len(b) >= field_max((*f).active) { return false }
    rt.buf_push(b, code as u8)
    (*f).problem = ERR_NONE
    return true
}

fn host_ok(p: u64, n: usize) -> bool {
    var parts: i32 = 0
    var val: i32 = 0
    var digits: i32 = 0
    var i: usize = 0
    while i <= n {
        var c: u8 = 46 as u8
        if i < n { c = rt.ld8(p, i) }
        if c == 46 as u8 {
            if digits == 0 || val > 255 { return false }
            parts = parts + 1
            val = 0
            digits = 0
        } else {
            val = val * 10 + (c as i32 - 48)
            digits = digits + 1
            if digits > 3 { return false }
        }
        i = i + 1
    }
    return parts == 4
}

fn form_port(f: *mut StartForm) -> i32 {
    let n: usize = rt.buf_len(&(*f).port)
    if n == 0 { return 0 - 1 }
    var v: i32 = 0
    var i: usize = 0
    while i < n {
        v = v * 10 + (rt.ld8(rt.buf_ptr(&(*f).port), i) as i32 - 48)
        i = i + 1
    }
    if v <= 0 || v > 65535 { return 0 - 1 }
    return v
}

fn form_validate(f: *mut StartForm) -> i32 {
    if !host_ok(rt.buf_ptr(&(*f).host), rt.buf_len(&(*f).host)) { return ERR_HOST }
    if form_port(f) < 0 { return ERR_PORT }
    if rt.buf_len(&(*f).name) == 0 { return ERR_NAME }
    return ERR_NONE
}

fn form_keys(f: *mut StartForm, rw: *mut raw.Raw) {
    if raw.key_pressed(rw, SC_ESC) {
        (*f).cancelled = true
        return
    }
    if raw.key_pressed(rw, SC_TAB) || raw.key_pressed(rw, SC_DOWN) { (*f).active = ((*f).active + 1) % FIELDS }
    if raw.key_pressed(rw, SC_UP) { (*f).active = ((*f).active + FIELDS - 1) % FIELDS }
    if raw.key_pressed(rw, SC_BACKSPACE) {
        let b: *mut rt.Buf = field_buf(f, (*f).active)
        if rt.buf_len(b) > 0 { (*b).len = (*b).len - 1 }
        (*f).problem = ERR_NONE
    }
    if raw.key_pressed(rw, SC_ENTER) || raw.key_pressed(rw, SC_KP_ENTER) {
        let e: i32 = form_validate(f)
        (*f).problem = e
        if e == ERR_NONE {
            (*f).submitted = true
        } else {
            (*f).active = e - 1
        }
    }
}

fn form_from_cfg(f: *mut StartForm, c: *mut mc_launch_cfg.LaunchCfg) {
    if rt.buf_len(&(*c).host) > 0 { form_set(f, FIELD_HOST, rt.buf_ptr(&(*c).host), rt.buf_len(&(*c).host)) }
    if rt.buf_len(&(*c).name) > 0 { form_set(f, FIELD_NAME, rt.buf_ptr(&(*c).name), rt.buf_len(&(*c).name)) }
    if (*c).port > 0 && (*c).port <= 65535 {
        var digits: [u8; 8] = [0; 8]
        var n: usize = 0
        var v: i32 = (*c).port
        while v > 0 {
            digits[n] = (48 + v % 10) as u8
            n = n + 1
            v = v / 10
        }
        rt.buf_clear(&(*f).port)
        while n > 0 {
            n = n - 1
            rt.buf_push(&(*f).port, digits[n])
        }
    }
    (*f).active = FIELD_HOST
    if rt.buf_len(&(*f).host) > 0 { (*f).active = FIELD_NAME }
}

fn form_to_cfg(f: *mut StartForm, c: *mut mc_launch_cfg.LaunchCfg) {
    rt.buf_clear(&(*c).host)
    rt.buf_clear(&(*c).name)
    rt.buf_push_bytes(&(*c).host, rt.buf_ptr(&(*f).host), rt.buf_len(&(*f).host))
    rt.buf_push_bytes(&(*c).name, rt.buf_ptr(&(*f).name), rt.buf_len(&(*f).name))
    (*c).port = form_port(f)
}

fn draw_field(f: *mut StartForm, r: *mut mc_raster.Raster, s: i32, k: i32, label: str, y: i32, blink: bool) {
    let bx: i32 = (*r).w / 2 - 100 * s
    let on: bool = (*f).active == k
    mc_hud.hud_text(r, bx, y, s, LABEL_COLOR, SHADOW, label)
    var edge: u32 = LABEL_COLOR
    if on { edge = BOX_ACTIVE }
    if (*f).problem == k + 1 { edge = ERROR_COLOR }
    mc_hud.hud_rect(r, bx - s, y + 10 * s, 202 * s, 16 * s, edge)
    mc_hud.hud_rect(r, bx, y + 11 * s, 200 * s, 14 * s, BOX_COLOR)
    let n: usize = form_text_len(f, k)
    mc_hud.hud_text_bytes(r, bx + 4 * s, y + 14 * s, s, TEXT_COLOR, SHADOW, form_text_ptr(f, k), n)
    if on && blink {
        mc_hud.hud_rect(r, bx + 4 * s + mc_hud.hud_text_width(n, s) + s, y + 13 * s, s, 9 * s, TEXT_COLOR)
    }
}

fn centered(r: *mut mc_raster.Raster, s: i32, y: i32, c: u32, t: str) {
    mc_hud.hud_text(r, (*r).w / 2 - mc_hud.hud_text_width(t.n, s) / 2, y, s, c, SHADOW, t)
}

fn form_draw(f: *mut StartForm, r: *mut mc_raster.Raster, s: i32, ms: u64) {
    mc_hud.hud_rect(r, 0, 0, (*r).w, (*r).h, BG_COLOR)
    let top: i32 = (*r).h / 2 - 80 * s
    centered(r, s * 2, top, TEXT_COLOR, "mcplay")
    centered(r, s, top + 22 * s, LABEL_COLOR, "Join a server")
    let blink: bool = (ms / 500 as u64) % 2 as u64 == 0 as u64
    draw_field(f, r, s, FIELD_HOST, "Server address (IPv4)", top + 40 * s, blink)
    draw_field(f, r, s, FIELD_PORT, "Port", top + 70 * s, blink)
    draw_field(f, r, s, FIELD_NAME, "Player name", top + 100 * s, blink)
    if (*f).problem == ERR_HOST { centered(r, s, top + 132 * s, ERROR_COLOR, "Address must be like 192.168.1.20") }
    if (*f).problem == ERR_PORT { centered(r, s, top + 132 * s, ERROR_COLOR, "Port must be 1 to 65535") }
    if (*f).problem == ERR_NAME { centered(r, s, top + 132 * s, ERROR_COLOR, "Enter a player name") }
    centered(r, s, top + 150 * s, LABEL_COLOR, "Tab next   Enter join   Esc quit")
}
