// SPDX-License-Identifier: MPL-2.0
import std.math
import mc.mc_audio
import mc.mc_registry

export {
    SndEv, sev_new, sev_water_tick, sev_dig_tick, sev_dig_reset, sev_hurt, sev_damage_name, sev_cadence_hit, sev_swim_volume,
    SEV_DIG_PERIOD_MS, SEV_STEP_WATER,
}

const SEV_DIG_PERIOD_MS: u64 = 200 as u64
const SEV_STEP_WATER: f64 = 1.6666666666666667

struct SndEv {
    started: bool,
    wet: bool,
    px: f64,
    py: f64,
    pz: f64,
    swim_dist: f64,
    dig_n: i64,
    n_played: u64,
}

fn sev_new() -> SndEv {
    return SndEv { started: false, wet: false, px: 0.0, py: 0.0, pz: 0.0, swim_dist: 0.0, dig_n: 0 - 1, n_played: 0 as u64 }
}

fn sev_cadence_hit(elapsed_ms: u64, last_n: i64) -> bool {
    return ((elapsed_ms / SEV_DIG_PERIOD_MS) as i64) > last_n
}

fn sev_swim_volume(dx: f64, dy: f64, dz: f64) -> f32 {
    let v: f64 = math.sqrt(dx * dx * 0.2 + dy * dy + dz * dz * 0.2) * 0.35
    if v > 1.0 { return 1.0 as f32 }
    return v as f32
}

fn play(m: *mut mc_audio.McAudio, s: *mut SndEv, name: str, cat: i32, x: f64, y: f64, z: f64, vol: f32, pitch: f32) {
    if mc_audio.mca_play_at(m, name, cat, x, y, z, vol, pitch) != 0 as u32 { (*s).n_played = (*s).n_played + 1 as u64 }
}

fn sev_water_tick(m: *mut mc_audio.McAudio, s: *mut SndEv, wet: bool, x: f64, y: f64, z: f64) {
    if !(*s).started {
        (*s).started = true
        (*s).wet = wet
        (*s).px = x
        (*s).py = y
        (*s).pz = z
        return
    }
    let dx: f64 = x - (*s).px
    let dy: f64 = y - (*s).py
    let dz: f64 = z - (*s).pz
    (*s).px = x
    (*s).py = y
    (*s).pz = z
    if dx * dx + dz * dz > 9.0 {
        (*s).wet = wet
        return
    }
    if wet != (*s).wet {
        (*s).wet = wet
        (*s).swim_dist = 0.0
        let v: f64 = math.sqrt(dx * dx * 0.2 + dy * dy + dz * dz * 0.2) * 20.0 * 0.2
        var vol: f32 = v as f32
        if vol > 1.0 { vol = 1.0 }
        if vol < 0.05 { vol = 0.05 }
        var name: str = "entity.player.splash"
        if vol >= 0.25 { name = "entity.player.splash.high_speed" }
        play(m, s, name, mc_audio.CAT_PLAYERS, x, y, z, vol, 1.0 as f32)
        return
    }
    if !wet { return }
    (*s).swim_dist = (*s).swim_dist + math.sqrt(dx * dx + dy * dy + dz * dz)
    if (*s).swim_dist >= SEV_STEP_WATER {
        (*s).swim_dist = (*s).swim_dist - SEV_STEP_WATER
        if (*s).swim_dist >= SEV_STEP_WATER { (*s).swim_dist = 0.0 }
        play(m, s, "entity.player.swim", mc_audio.CAT_PLAYERS, x, y, z, sev_swim_volume(dx * 20.0, dy * 20.0, dz * 20.0), 1.0 as f32)
    }
}

fn sev_dig_reset(s: *mut SndEv) {
    (*s).dig_n = 0 - 1
}

fn sev_dig_tick(m: *mut mc_audio.McAudio, s: *mut SndEv, reg: *mut mc_registry.Registry, state: i32, bx: i32, by: i32, bz: i32, elapsed_ms: u64) -> bool {
    if !sev_cadence_hit(elapsed_ms, (*s).dig_n) { return false }
    (*s).dig_n = (elapsed_ms / SEV_DIG_PERIOD_MS) as i64
    if mc_audio.mca_block_sound(m, reg, state, mc_audio.ACT_HIT, bx, by, bz) != 0 as u32 {
        (*s).n_played = (*s).n_played + 1 as u64
        return true
    }
    return false
}

fn sev_damage_name(type_id: i32, protocol: i32) -> str {
    if protocol == 763 {
        if type_id == 5 { return "entity.player.hurt_drown" }
        if type_id == 19 || type_id == 22 || type_id == 28 { return "entity.player.hurt_on_fire" }
        if type_id == 37 { return "entity.player.hurt_sweet_berry_bush" }
        if type_id == 15 { return "entity.player.hurt_freeze" }
    }
    return "entity.player.hurt"
}

fn sev_hurt(m: *mut mc_audio.McAudio, s: *mut SndEv, type_id: i32, protocol: i32, dead: bool, x: f64, y: f64, z: f64) {
    if dead {
        play(m, s, "entity.player.death", mc_audio.CAT_PLAYERS, x, y, z, 1.0 as f32, 1.0 as f32)
        return
    }
    play(m, s, sev_damage_name(type_id, protocol), mc_audio.CAT_PLAYERS, x, y, z, 1.0 as f32, 1.0 as f32)
}
