import mc.mc_math

export { CODE_STABLE, CODE_SAGGING, is_scaffold_code, resolve_cell }

const CODE_STABLE: i32 = 728
const CODE_SAGGING: i32 = 729
const TOP_EPS: f64 = 0.00001
const SAG_HEIGHT_SIXTEENTHS: i32 = 2

fn is_scaffold_code(c: i32) -> bool { return c == CODE_STABLE || c == CODE_SAGGING }

fn resolve_cell(code: i32, cell_y: i32, feet_y: f64, descending: bool) -> i32 {
    let top: f64 = (cell_y as f64) + 1.0
    if feet_y > top - TOP_EPS && !descending { return 1 }
    if code == CODE_SAGGING && feet_y > (cell_y as f64) - TOP_EPS { return mc_math.SHAPE_BASE + mc_math.K_LOW + SAG_HEIGHT_SIXTEENTHS }
    return 0
}
