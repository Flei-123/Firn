// SPDX-License-Identifier: MPL-2.0
export {
    menu_kind, menu_slots, menu_cols, menu_result, menu_shift_predicted, menu_name,
    MK_NONE, MK_GENERIC, MK_DISPENSER, MK_ANVIL, MK_BEACON, MK_BLAST, MK_BREWING, MK_CRAFT, MK_ENCHANT, MK_FURNACE, MK_GRIND, MK_HOPPER, MK_LECTERN, MK_LOOM,
    MK_MERCHANT, MK_SHULKER, MK_SMITHING, MK_SMOKER, MK_CARTO, MK_STONECUT, MK_HORSE,
}

const MK_NONE: i32 = 0 - 1
const MK_GENERIC: i32 = 0
const MK_DISPENSER: i32 = 1
const MK_ANVIL: i32 = 2
const MK_BEACON: i32 = 3
const MK_BLAST: i32 = 4
const MK_BREWING: i32 = 5
const MK_CRAFT: i32 = 6
const MK_ENCHANT: i32 = 7
const MK_FURNACE: i32 = 8
const MK_GRIND: i32 = 9
const MK_HOPPER: i32 = 10
const MK_LECTERN: i32 = 11
const MK_LOOM: i32 = 12
const MK_MERCHANT: i32 = 13
const MK_SHULKER: i32 = 14
const MK_SMITHING: i32 = 15
const MK_SMOKER: i32 = 16
const MK_CARTO: i32 = 17
const MK_STONECUT: i32 = 18
const MK_HORSE: i32 = 19

const SMITHING_TEMPLATE_PROTOCOL: i32 = 763
const CRAFTER_PROTOCOL: i32 = 765
const SMITHING_PROTOCOL: i32 = 735

fn menu_name(mk: i32) -> str {
    if mk == MK_GENERIC { return "generic" }
    if mk == MK_DISPENSER { return "dispenser" }
    if mk == MK_ANVIL { return "anvil" }
    if mk == MK_BEACON { return "beacon" }
    if mk == MK_BLAST { return "blast_furnace" }
    if mk == MK_BREWING { return "brewing_stand" }
    if mk == MK_CRAFT { return "crafting" }
    if mk == MK_ENCHANT { return "enchantment" }
    if mk == MK_FURNACE { return "furnace" }
    if mk == MK_GRIND { return "grindstone" }
    if mk == MK_HOPPER { return "hopper" }
    if mk == MK_LECTERN { return "lectern" }
    if mk == MK_LOOM { return "loom" }
    if mk == MK_MERCHANT { return "merchant" }
    if mk == MK_SHULKER { return "shulker_box" }
    if mk == MK_SMITHING { return "smithing" }
    if mk == MK_SMOKER { return "smoker" }
    if mk == MK_CARTO { return "cartography_table" }
    if mk == MK_STONECUT { return "stonecutter" }
    if mk == MK_HORSE { return "horse" }
    return "unknown"
}

fn menu_kind(typ: i32, protocol: i32) -> i32 {
    if typ < 0 { return MK_NONE }
    if typ <= 5 { return MK_GENERIC }
    if typ == 6 { return MK_DISPENSER }
    var t: i32 = typ
    if protocol >= CRAFTER_PROTOCOL {
        if typ == 7 { return MK_NONE }
        t = typ - 1
    }
    if t == 7 { return MK_ANVIL }
    if t == 8 { return MK_BEACON }
    if t == 9 { return MK_BLAST }
    if t == 10 { return MK_BREWING }
    if t == 11 { return MK_CRAFT }
    if t == 12 { return MK_ENCHANT }
    if t == 13 { return MK_FURNACE }
    if t == 14 { return MK_GRIND }
    if t == 15 { return MK_HOPPER }
    if t == 16 { return MK_LECTERN }
    if t == 17 { return MK_LOOM }
    if t == 18 { return MK_MERCHANT }
    if t == 19 { return MK_SHULKER }
    if t == 20 { return MK_SMITHING }
    if t == 21 { return MK_SMOKER }
    if t == 22 { return MK_CARTO }
    if t == 23 { return MK_STONECUT }
    return MK_NONE
}

fn menu_slots(mk: i32, typ: i32, protocol: i32) -> i32 {
    if mk == MK_GENERIC { return 9 * (typ + 1) }
    if mk == MK_DISPENSER { return 9 }
    if mk == MK_ANVIL || mk == MK_GRIND || mk == MK_MERCHANT || mk == MK_CARTO || mk == MK_FURNACE || mk == MK_BLAST || mk == MK_SMOKER { return 3 }
    if mk == MK_BEACON || mk == MK_LECTERN { return 1 }
    if mk == MK_BREWING || mk == MK_HOPPER { return 5 }
    if mk == MK_CRAFT { return 10 }
    if mk == MK_ENCHANT || mk == MK_STONECUT { return 2 }
    if mk == MK_LOOM { return 4 }
    if mk == MK_SHULKER { return 27 }
    if mk == MK_SMITHING {
        if protocol >= SMITHING_TEMPLATE_PROTOCOL { return 4 }
        if protocol >= SMITHING_PROTOCOL { return 3 }
        return 0 - 1
    }
    return 0 - 1
}

fn menu_cols(mk: i32) -> i32 {
    if mk == MK_DISPENSER { return 3 }
    if mk == MK_HOPPER { return 5 }
    if mk == MK_GENERIC || mk == MK_SHULKER { return 9 }
    return 3
}

fn menu_result(mk: i32, n: i32) -> i32 {
    if mk == MK_CRAFT { return 0 }
    if mk == MK_FURNACE || mk == MK_BLAST || mk == MK_SMOKER || mk == MK_ANVIL || mk == MK_GRIND || mk == MK_MERCHANT || mk == MK_CARTO { return 2 }
    if mk == MK_LOOM || mk == MK_SMITHING { return n - 1 }
    if mk == MK_STONECUT { return 1 }
    return 0 - 1
}

fn menu_shift_predicted(mk: i32) -> bool {
    return mk == MK_GENERIC || mk == MK_DISPENSER || mk == MK_HOPPER || mk == MK_SHULKER || mk == MK_HORSE
}
