import std.rt
import std.fs
import std.env
import std.str
import zip.zip
import mc.mc_vanilla
import mc.mc_vanilla_snd
import mc.mc_assetindex
import mc.mc_gui_tex
import mc.mc_gui_font
import mc.mc_gui_lang

export {
    GuiPack, gpack_new, gpack_free, gpack_open, gpack_ok, gpack_entry, gpack_asset, gpack_tex, gpack_text, gpack_version, VERSION_DEFAULT,
}

const VERSION_DEFAULT: i32 = 763
const WIDGETS: str = "assets/minecraft/textures/gui/widgets.png"
const LOGO: str = "assets/minecraft/textures/gui/title/minecraft.png"
const EDITION: str = "assets/minecraft/textures/gui/title/edition.png"
const OPTIONS_BG: str = "assets/minecraft/textures/gui/options_background.png"
const FONT_ASCII: str = "assets/minecraft/textures/font/ascii.png"
const SERVER_ICON: str = "assets/minecraft/textures/misc/unknown_server.png"
const ACCESSIBILITY: str = "assets/minecraft/textures/gui/accessibility.png"
const ICONS: str = "assets/minecraft/textures/gui/icons.png"
const PANORAMA_OVERLAY: str = "assets/minecraft/textures/gui/title/background/panorama_overlay.png"
const LANG: str = "assets/minecraft/lang/en_us.json"
const SPLASHES: str = "assets/minecraft/texts/splashes.txt"

struct GuiPack {
    jar: rt.Buf,
    z: zip.ZipReader,
    zip_open: bool,
    assets: rt.Buf,
    index_raw: rt.Buf,
    aidx: mc_assetindex.AssetIndex,
    have_index: bool,
    version: rt.Buf,
    widgets: mc_gui_tex.GuiTex,
    logo: mc_gui_tex.GuiTex,
    edition: mc_gui_tex.GuiTex,
    options_bg: mc_gui_tex.GuiTex,
    server_icon: mc_gui_tex.GuiTex,
    accessibility: mc_gui_tex.GuiTex,
    icons: mc_gui_tex.GuiTex,
    overlay: mc_gui_tex.GuiTex,
    font: mc_gui_font.GuiFont,
    lang_raw: rt.Buf,
    lang: mc_gui_lang.GuiLang,
    splashes: rt.Buf,
}

fn gpack_new() -> GuiPack {
    return GuiPack {
        jar: rt.buf_new(), z: zip.zip_reader_empty(), zip_open: false, assets: rt.buf_new(), index_raw: rt.buf_new(),
        aidx: mc_assetindex.aidx_new(), have_index: false, version: rt.buf_new(),
        widgets: mc_gui_tex.gtex_empty(), logo: mc_gui_tex.gtex_empty(), edition: mc_gui_tex.gtex_empty(), options_bg: mc_gui_tex.gtex_empty(), server_icon: mc_gui_tex.gtex_empty(),
        accessibility: mc_gui_tex.gtex_empty(), icons: mc_gui_tex.gtex_empty(), overlay: mc_gui_tex.gtex_empty(),
        font: mc_gui_font.gfont_empty(), lang_raw: rt.buf_new(), lang: mc_gui_lang.glang_empty(), splashes: rt.buf_new(),
    }
}

fn gpack_free(p: *mut GuiPack) {
    mc_gui_tex.gtex_free(&(*p).widgets)
    mc_gui_tex.gtex_free(&(*p).logo)
    mc_gui_tex.gtex_free(&(*p).edition)
    mc_gui_tex.gtex_free(&(*p).options_bg)
    mc_gui_tex.gtex_free(&(*p).server_icon)
    mc_gui_tex.gtex_free(&(*p).accessibility)
    mc_gui_tex.gtex_free(&(*p).icons)
    mc_gui_tex.gtex_free(&(*p).overlay)
    mc_gui_font.gfont_free(&(*p).font)
    mc_gui_lang.glang_free(&(*p).lang)
    mc_assetindex.aidx_free(&(*p).aidx)
    if (*p).zip_open { zip.zip_reader_free(&(*p).z) }
    (*p).zip_open = false
    rt.buf_free(&(*p).jar)
    rt.buf_free(&(*p).assets)
    rt.buf_free(&(*p).index_raw)
    rt.buf_free(&(*p).version)
    rt.buf_free(&(*p).lang_raw)
    rt.buf_free(&(*p).splashes)
}

fn gpack_ok(p: *mut GuiPack) -> bool {
    return (*p).zip_open && mc_gui_tex.gtex_ok(&(*p).widgets) && mc_gui_font.gfont_ok(&(*p).font)
}

fn gpack_version(p: *mut GuiPack) -> str {
    return rt.buf_str(&(*p).version)
}

fn gpack_entry(p: *mut GuiPack, name: str, out: *mut rt.Buf) -> bool {
    if !(*p).zip_open { return false }
    let idx: i64 = zip.zip_find(&(*p).z, name)
    if idx < 0 { return false }
    let got: usize = zip.zip_extract(&(*p).z, idx as usize, out) catch | e | (0)
    return got > 0
}

fn gpack_asset(p: *mut GuiPack, name: str, out: *mut rt.Buf) -> bool {
    if !(*p).have_index { return false }
    let e: u32 = mc_assetindex.aidx_lookup(&(*p).aidx, name.p as u64, name.length())
    if e == 0xFFFFFFFF as u32 { return false }
    var path: rt.Buf = rt.buf_new()
    let ok: bool = mc_assetindex.aidx_object_path(rt.buf_str(&(*p).assets), mc_assetindex.aidx_hash(&(*p).aidx, e), &path)
    var got: usize = 0
    if ok { got = fs.read_file(rt.buf_str(&path), out) catch | er | (0) }
    rt.buf_free(&path)
    return got > 0
}

fn gpack_tex(p: *mut GuiPack, name: str, out: *mut mc_gui_tex.GuiTex) -> bool {
    var raw: rt.Buf = rt.buf_new()
    var ok: bool = gpack_entry(p, name, &raw)
    if ok { ok = mc_gui_tex.gtex_from_png(rt.buf_ptr(&raw), rt.buf_len(&raw), out) }
    rt.buf_free(&raw)
    return ok
}

fn gpack_text(p: *mut GuiPack, name: str, out: *mut rt.Buf) -> bool {
    return gpack_entry(p, name, out)
}

fn load_index(p: *mut GuiPack, jar: str, version: str) {
    var assets: rt.Buf = rt.buf_new()
    var id: rt.Buf = rt.buf_new()
    if mc_vanilla_snd.vsnd_locate(jar, version, &assets, &id) {
        var ip: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&ip, rt.buf_ptr(&assets), rt.buf_len(&assets))
        rt.buf_push_bytes(&ip, "/indexes/".p as u64, 9)
        rt.buf_push_bytes(&ip, rt.buf_ptr(&id), rt.buf_len(&id))
        rt.buf_push_bytes(&ip, ".json".p as u64, 5)
        let got: usize = fs.read_file(rt.buf_str(&ip), &(*p).index_raw) catch | e | (0)
        if got > 0 && mc_assetindex.aidx_parse(&(*p).aidx, rt.buf_ptr(&(*p).index_raw), rt.buf_len(&(*p).index_raw)) {
            (*p).have_index = true
            rt.buf_push_bytes(&(*p).assets, rt.buf_ptr(&assets), rt.buf_len(&assets))
        }
        rt.buf_free(&ip)
    }
    rt.buf_free(&assets)
    rt.buf_free(&id)
}

fn gpack_open(p: *mut GuiPack, protocol: i32) -> bool {
    var jar: rt.Buf = rt.buf_new()
    let rc: i32 = mc_vanilla.vanilla_resolve(protocol, &jar)
    if rc != mc_vanilla.VANILLA_OK {
        rt.buf_free(&jar)
        return false
    }
    let version: str = mc_vanilla.vanilla_version_name(protocol)
    rt.buf_push_bytes(&(*p).version, version.p as u64, version.length())
    let got: usize = fs.read_file(rt.buf_str(&jar), &(*p).jar) catch | e | (0)
    var why: i32 = 0
    if got > 0 { (*p).z = zip.zip_reader_open(rt.buf_ptr(&(*p).jar), rt.buf_len(&(*p).jar)) catch | e | (zip.zip_reader_empty()) }
    if got > 0 && zip.zip_entry_count(&(*p).z) > 0 { (*p).zip_open = true }
    if !(*p).zip_open {
        rt.buf_free(&jar)
        return false
    }
    gpack_tex(p, WIDGETS, &(*p).widgets)
    gpack_tex(p, LOGO, &(*p).logo)
    gpack_tex(p, EDITION, &(*p).edition)
    gpack_tex(p, OPTIONS_BG, &(*p).options_bg)
    gpack_tex(p, SERVER_ICON, &(*p).server_icon)
    gpack_tex(p, ACCESSIBILITY, &(*p).accessibility)
    gpack_tex(p, ICONS, &(*p).icons)
    gpack_tex(p, PANORAMA_OVERLAY, &(*p).overlay)
    var fraw: rt.Buf = rt.buf_new()
    if gpack_entry(p, FONT_ASCII, &fraw) { mc_gui_font.gfont_init(&(*p).font, rt.buf_ptr(&fraw), rt.buf_len(&fraw)) }
    rt.buf_free(&fraw)
    if gpack_entry(p, LANG, &(*p).lang_raw) { mc_gui_lang.glang_load(&(*p).lang, rt.buf_ptr(&(*p).lang_raw), rt.buf_len(&(*p).lang_raw)) }
    gpack_entry(p, SPLASHES, &(*p).splashes)
    load_index(p, rt.buf_str(&jar), version)
    rt.buf_free(&jar)
    return gpack_ok(p)
}
