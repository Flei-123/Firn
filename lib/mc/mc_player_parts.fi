// SPDX-License-Identifier: MPL-2.0
import mc.mc_pskin
import mc.mc_vox

export {
    PlayerCubes, PartDef, pc_new, pc_free, pc_build, pc_built, part_def,
    PART_HEAD, PART_BODY, PART_RARM, PART_LARM, PART_RLEG, PART_LLEG, PART_COUNT,
}

const PART_HEAD: usize = 0
const PART_BODY: usize = 1
const PART_RARM: usize = 2
const PART_LARM: usize = 3
const PART_RLEG: usize = 4
const PART_LLEG: usize = 5
const PART_COUNT: usize = 6
const CUBE_SIZE: u32 = 1040

struct PartDef {
    u: i32, v: i32, ou: i32, ov: i32,
    w: i32, h: i32, d: i32,
    cx: f64, cy: f64, cz: f64,
    px: f64, py: f64, pz: f64,
    infl: f64,
}

struct PlayerCubes {
    parts: [mc_vox.CubeList; 6],
    built: bool,
    slim: bool,
    avg: [u32; 6],
}

fn pc_new() -> PlayerCubes {
    return PlayerCubes { parts: [mc_vox.cl_new(); 6], built: false, slim: false, avg: [0 as u32; 6] }
}

fn pc_free(pc: *mut PlayerCubes) {
    var i: usize = 0
    while i < PART_COUNT {
        mc_vox.cl_free(&(*pc).parts[i])
        i = i + 1
    }
    (*pc).built = false
}

fn pc_built(pc: *mut PlayerCubes) -> bool { return (*pc).built }

fn part_def(i: usize, slim: bool) -> PartDef {
    var aw: i32 = 4
    var ax: f64 = 6.0
    if slim {
        aw = 3
        ax = 5.5
    }
    if i == PART_HEAD { return PartDef { u: 0, v: 0, ou: 32, ov: 0, w: 8, h: 8, d: 8, cx: 0.0, cy: 28.0, cz: 0.0, px: 0.0, py: 24.0, pz: 0.0, infl: 0.5 } }
    if i == PART_BODY { return PartDef { u: 16, v: 16, ou: 16, ov: 32, w: 8, h: 12, d: 4, cx: 0.0, cy: 18.0, cz: 0.0, px: 0.0, py: 24.0, pz: 0.0, infl: 0.25 } }
    if i == PART_RARM { return PartDef { u: 40, v: 16, ou: 40, ov: 32, w: aw, h: 12, d: 4, cx: ax, cy: 18.0, cz: 0.0, px: 5.0, py: 22.0, pz: 0.0, infl: 0.25 } }
    if i == PART_LARM { return PartDef { u: 32, v: 48, ou: 48, ov: 48, w: aw, h: 12, d: 4, cx: 0.0 - ax, cy: 18.0, cz: 0.0, px: 0.0 - 5.0, py: 22.0, pz: 0.0, infl: 0.25 } }
    if i == PART_RLEG { return PartDef { u: 0, v: 16, ou: 0, ov: 32, w: 4, h: 12, d: 4, cx: 2.0, cy: 6.0, cz: 0.0, px: 2.0, py: 12.0, pz: 0.0, infl: 0.25 } }
    return PartDef { u: 16, v: 48, ou: 0, ov: 48, w: 4, h: 12, d: 4, cx: 0.0 - 2.0, cy: 6.0, cz: 0.0, px: 0.0 - 2.0, py: 12.0, pz: 0.0, infl: 0.25 }
}

fn face_pixel(s: *mut mc_pskin.Skin, u: i32, v: i32, w: i32, h: i32, d: i32, ix: i32, iy: i32, iz: i32) -> u32 {
    if iz == d - 1 { return mc_pskin.skin_px(s, u + d + (w - 1 - ix), v + d + (h - 1 - iy)) }
    if iz == 0 { return mc_pskin.skin_px(s, u + 2 * d + w + ix, v + d + (h - 1 - iy)) }
    if iy == h - 1 { return mc_pskin.skin_px(s, u + d + (w - 1 - ix), v + iz) }
    if iy == 0 { return mc_pskin.skin_px(s, u + d + w + (w - 1 - ix), v + (d - 1 - iz)) }
    if ix == w - 1 { return mc_pskin.skin_px(s, u + iz, v + d + (h - 1 - iy)) }
    return mc_pskin.skin_px(s, u + d + w + (d - 1 - iz), v + d + (h - 1 - iy))
}

fn on_shell(w: i32, h: i32, d: i32, ix: i32, iy: i32, iz: i32) -> bool {
    return ix == 0 || ix == w - 1 || iy == 0 || iy == h - 1 || iz == 0 || iz == d - 1
}

fn build_layer(cl: *mut mc_vox.CubeList, s: *mut mc_pskin.Skin, pd: *mut PartDef, u: i32, v: i32, infl: f64) {
    let w: i32 = (*pd).w
    let h: i32 = (*pd).h
    let d: i32 = (*pd).d
    let kx: f64 = ((w as f64) + 2.0 * infl) / (w as f64)
    let ky: f64 = ((h as f64) + 2.0 * infl) / (h as f64)
    let kz: f64 = ((d as f64) + 2.0 * infl) / (d as f64)
    var size: u32 = CUBE_SIZE
    if infl > 0.0 { size = CUBE_SIZE + ((infl * 200.0) as u32) }
    var ix: i32 = 0
    while ix < w {
        var iy: i32 = 0
        while iy < h {
            var iz: i32 = 0
            while iz < d {
                if on_shell(w, h, d, ix, iy, iz) {
                    let c: u32 = face_pixel(s, u, v, w, h, d, ix, iy, iz)
                    if (c >> 24 as u32) >= 128 as u32 {
                        let x: f64 = ((ix as f64) + 0.5 - (w as f64) * 0.5) * kx + (*pd).cx - (*pd).px
                        let y: f64 = ((iy as f64) + 0.5 - (h as f64) * 0.5) * ky + (*pd).cy - (*pd).py
                        let z: f64 = ((iz as f64) + 0.5 - (d as f64) * 0.5) * kz + (*pd).cz - (*pd).pz
                        mc_vox.cl_add(cl, x, y, z, mc_vox.rgb_of(c), size)
                    }
                }
                iz = iz + 1
            }
            iy = iy + 1
        }
        ix = ix + 1
    }
}

fn pc_build(pc: *mut PlayerCubes, s: *mut mc_pskin.Skin) {
    var i: usize = 0
    while i < PART_COUNT {
        mc_vox.cl_clear(&(*pc).parts[i])
        var pd: PartDef = part_def(i, mc_pskin.skin_is_slim(s))
        build_layer(&(*pc).parts[i], s, &pd, pd.u, pd.v, 0.0)
        build_layer(&(*pc).parts[i], s, &pd, pd.ou, pd.ov, pd.infl)
        (*pc).avg[i] = mc_pskin.skin_average(s, pd.u, pd.v, 2 * (pd.w + pd.d), pd.d + pd.h)
        i = i + 1
    }
    (*pc).slim = mc_pskin.skin_is_slim(s)
    (*pc).built = true
}
