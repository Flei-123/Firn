import mc.mc_camera
import mc.mc_math
import mc.mc_entity_draw
import mc.mc_snowfall

export { entlist_add_snowfall }

const REACH: f64 = 0.5
const FLAKE_SIZE: f64 = 0.055
const COLOR_R: i32 = 246
const COLOR_G: i32 = 249
const COLOR_B: i32 = 255

fn entlist_add_snowfall(l: *mut mc_entity_draw.EntList, s: *mut mc_snowfall.Snowfall, cam: *mut mc_camera.Camera, now_ms: u64) -> usize {
    var added: usize = 0
    var k: usize = 0
    while k < mc_snowfall.SNOW_MAX {
        let i: usize = k
        k = k + 1
        let age: i32 = mc_snowfall.snowfall_age_ms(s, i, now_ms)
        if age < 0 { continue }
        let x: f64 = mc_snowfall.snowfall_x(s, i, age)
        let y: f64 = mc_snowfall.snowfall_y(s, i, age)
        let z: f64 = mc_snowfall.snowfall_z(s, i, age)
        if mc_math.frustum_test_box(&(*cam).frustum, x - REACH, y - REACH, z - REACH, x + REACH, y + REACH, z + REACH) == 0 { continue }
        mc_entity_draw.entlist_add_box(l, x, y, z, FLAKE_SIZE, FLAKE_SIZE, FLAKE_SIZE, COLOR_R, COLOR_G, COLOR_B)
        added = added + 1
    }
    return added
}
