import std.rt
import mc.mc_tip_util

export { comp_max_damage, comp_attr_modifiers, comp_potion_contents, comp_hide_tooltip, comp_hide_additional, comp_tooltip_display, comp_enchantments, comp_stored_enchantments, comp_unbreakable, effect_name, potion_name, attr_name, slot_name, effect_harmful, effect_instant }

const EFFECTS: str = "speed slowness haste mining_fatigue strength instant_health instant_damage jump_boost nausea regeneration resistance fire_resistance water_breathing invisibility blindness night_vision hunger weakness poison wither health_boost absorption saturation glowing levitation luck unluck slow_falling conduit_power dolphins_grace bad_omen hero_of_the_village darkness trial_omen raid_omen wind_charged weaving oozing infested breath_of_the_nautilus"
const POTIONS: str = "water mundane thick awkward night_vision long_night_vision invisibility long_invisibility leaping long_leaping strong_leaping fire_resistance long_fire_resistance swiftness long_swiftness strong_swiftness slowness long_slowness strong_slowness turtle_master long_turtle_master strong_turtle_master water_breathing long_water_breathing healing strong_healing harming strong_harming poison long_poison strong_poison regeneration long_regeneration strong_regeneration strength long_strength strong_strength weakness long_weakness luck slow_falling long_slow_falling wind_charged weaving oozing infested"
const ATTRS_V767: str = "generic.armor generic.armor_toughness generic.attack_damage generic.attack_knockback generic.attack_speed player.block_break_speed player.block_interaction_range generic.burning_time generic.explosion_knockback_resistance player.entity_interaction_range generic.fall_damage_multiplier generic.flying_speed generic.follow_range generic.gravity generic.jump_strength generic.knockback_resistance generic.luck generic.max_absorption generic.max_health player.mining_efficiency generic.movement_efficiency generic.movement_speed generic.oxygen_bonus generic.safe_fall_distance generic.scale player.sneaking_speed zombie.spawn_reinforcements generic.step_height player.submerged_mining_speed player.sweeping_damage_ratio generic.water_movement_efficiency"
const ATTRS_V770: str = "armor armor_toughness attack_damage attack_knockback attack_speed block_break_speed block_interaction_range burning_time explosion_knockback_resistance entity_interaction_range fall_damage_multiplier flying_speed follow_range gravity jump_strength knockback_resistance luck max_absorption max_health mining_efficiency movement_efficiency movement_speed oxygen_bonus safe_fall_distance scale sneaking_speed spawn_reinforcements step_height submerged_mining_speed sweeping_damage_ratio tempt_range water_movement_efficiency"
const ATTRS_V772: str = "armor armor_toughness attack_damage attack_knockback attack_speed block_break_speed block_interaction_range burning_time camera_distance explosion_knockback_resistance entity_interaction_range fall_damage_multiplier flying_speed follow_range gravity jump_strength knockback_resistance luck max_absorption max_health mining_efficiency movement_efficiency movement_speed oxygen_bonus safe_fall_distance scale sneaking_speed spawn_reinforcements step_height submerged_mining_speed sweeping_damage_ratio tempt_range water_movement_efficiency waypoint_transmit_range waypoint_receive_range"
const SLOTS: str = "any mainhand offhand hand feet legs chest head armor body saddle"
const HARMFUL: str = "slowness mining_fatigue instant_damage nausea blindness hunger weakness poison wither levitation unluck darkness wind_charged weaving oozing infested"
const INSTANT: str = "instant_health instant_damage saturation"

fn comp_max_damage() -> i32 { return 2 }

fn comp_attr_modifiers(protocol: i32) -> i32 {
    if protocol <= 767 { return 12 }
    if protocol <= 772 { return 13 }
    return 16
}

fn comp_hide_tooltip(protocol: i32) -> i32 {
    if protocol <= 767 { return 15 }
    if protocol <= 769 { return 16 }
    return 0 - 1
}

fn comp_hide_additional(protocol: i32) -> i32 {
    if protocol <= 767 { return 14 }
    if protocol <= 769 { return 15 }
    return 0 - 1
}

fn comp_tooltip_display(protocol: i32) -> i32 {
    if protocol <= 769 { return 0 - 1 }
    if protocol <= 772 { return 15 }
    return 18
}

fn comp_enchantments(protocol: i32) -> i32 {
    if protocol <= 767 { return 9 }
    if protocol <= 772 { return 10 }
    return 13
}

fn comp_stored_enchantments(protocol: i32) -> i32 {
    if protocol <= 767 { return 23 }
    if protocol <= 769 { return 33 }
    if protocol <= 772 { return 34 }
    if protocol <= 774 { return 41 }
    return 42
}

fn comp_unbreakable() -> i32 { return 4 }

fn comp_potion_contents(protocol: i32) -> i32 {
    if protocol <= 767 { return 31 }
    if protocol <= 769 { return 41 }
    if protocol <= 772 { return 42 }
    if protocol <= 774 { return 49 }
    return 51
}

fn effect_name(id: i64, out_p: *mut u64, out_n: *mut usize) -> bool {
    if id < 0 || id > 200 { return false }
    return mc_tip_util.nth_word(EFFECTS.p as u64, EFFECTS.n, id as i32, 32 as u8, out_p, out_n)
}

fn potion_name(id: i64, out_p: *mut u64, out_n: *mut usize) -> bool {
    if id < 0 || id > 200 { return false }
    return mc_tip_util.nth_word(POTIONS.p as u64, POTIONS.n, id as i32, 32 as u8, out_p, out_n)
}

fn attr_name(protocol: i32, id: i64, out_p: *mut u64, out_n: *mut usize) -> bool {
    if id < 0 || id > 200 { return false }
    if protocol <= 767 { return mc_tip_util.nth_word(ATTRS_V767.p as u64, ATTRS_V767.n, id as i32, 32 as u8, out_p, out_n) }
    if protocol <= 770 { return mc_tip_util.nth_word(ATTRS_V770.p as u64, ATTRS_V770.n, id as i32, 32 as u8, out_p, out_n) }
    return mc_tip_util.nth_word(ATTRS_V772.p as u64, ATTRS_V772.n, id as i32, 32 as u8, out_p, out_n)
}

fn slot_name(id: i64, out_p: *mut u64, out_n: *mut usize) -> bool {
    if id < 0 || id > 20 { return false }
    return mc_tip_util.nth_word(SLOTS.p as u64, SLOTS.n, id as i32, 32 as u8, out_p, out_n)
}

fn has_word(list: str, p: u64, n: usize) -> bool {
    var k: i32 = 0
    var wp: u64 = 0
    var wn: usize = 0
    while mc_tip_util.nth_word(list.p as u64, list.n, k, 32 as u8, &wp, &wn) {
        if wn == n && rt.mem_eq(wp, p, n) { return true }
        k = k + 1
    }
    return false
}

fn effect_harmful(p: u64, n: usize) -> bool { return has_word(HARMFUL, p, n) }

fn effect_instant(p: u64, n: usize) -> bool { return has_word(INSTANT, p, n) }
