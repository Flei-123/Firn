import std.rt
import mc.mc_chat
import mc.mc_client
import mc.mc_cont_net

export {
    ContAct, act_new, act_free, act_enchant_ok, act_enchant_allowed, act_enchant_click, act_name_sync, act_name_sync_named, act_name_char, act_name_backspace,
    act_name_wipe, act_name_delete, act_name_left, act_name_right, act_name_home, act_name_end, act_name_cursor,
    act_name_ptr, act_name_len, act_name_clear, NAME_MAX_CHARS,
}

const NAME_MAX_CHARS: usize = 50

struct ContAct {
    field: mc_chat.Chat,
    win: i32,
    item: i32,
    sent_name: u32,
    sent_button: u32,
    def: rt.Buf,
}

fn act_new() -> ContAct {
    return ContAct { field: mc_chat.chat_new(), win: 0 - 1, item: 0 - 1, sent_name: 0 as u32, sent_button: 0 as u32, def: rt.buf_new() }
}

fn act_free(a: *mut ContAct) {
    mc_chat.chat_free(&(*a).field)
    rt.buf_free(&(*a).def)
}

fn act_name_ptr(a: *mut ContAct) -> u64 { return mc_chat.chat_input_ptr(&(*a).field) }

fn act_name_len(a: *mut ContAct) -> usize { return mc_chat.chat_input_len(&(*a).field) }

fn act_name_clear(a: *mut ContAct) {
    mc_chat.chat_input_clear(&(*a).field)
}

fn name_chars(a: *mut ContAct) -> usize {
    let p: u64 = mc_chat.chat_input_ptr(&(*a).field)
    let n: usize = mc_chat.chat_input_len(&(*a).field)
    var count: usize = 0
    var i: usize = 0
    while i < n {
        let b: u8 = *((p + (i as u64)) as *u8)
        if b < 128 as u8 || b >= 192 as u8 { count = count + 1 }
        i = i + 1
    }
    return count
}

fn is_default_name(a: *mut ContAct) -> bool {
    let n: usize = mc_chat.chat_input_len(&(*a).field)
    if n == 0 || n != rt.buf_len(&(*a).def) { return false }
    let p: u64 = mc_chat.chat_input_ptr(&(*a).field)
    let d: u64 = rt.buf_ptr(&(*a).def)
    var i: usize = 0
    while i < n {
        if rt.ld8(p, i) != rt.ld8(d, i) { return false }
        i = i + 1
    }
    return true
}

fn send_name(a: *mut ContAct, cl: *mut mc_client.Client) {
    var text: str = str { p: mc_chat.chat_input_ptr(&(*a).field) as *u8, n: mc_chat.chat_input_len(&(*a).field) }
    if is_default_name(a) { text = str { p: text.p, n: 0 } }
    if mc_cont_net.cn_send_rename(cl, text) { (*a).sent_name = (*a).sent_name + (1 as u32) }
}

fn act_enchant_ok(cost: i32, lapis: i32, idx: i32, creative: bool) -> bool {
    if idx < 0 || idx > 2 || cost <= 0 { return false }
    return creative || lapis > idx
}

fn act_enchant_allowed(cost: i32, lapis: i32, xp: i32, idx: i32, creative: bool) -> bool {
    if !act_enchant_ok(cost, lapis, idx, creative) { return false }
    return creative || (xp >= cost && xp > idx)
}

fn act_enchant_click(a: *mut ContAct, cl: *mut mc_client.Client, win: i32, idx: i32, cost: i32, lapis: i32, xp: i32, creative: bool) -> bool {
    if win <= 0 || !act_enchant_allowed(cost, lapis, xp, idx, creative) { return false }
    if !mc_cont_net.cn_send_button(cl, win, idx) { return false }
    (*a).sent_button = (*a).sent_button + (1 as u32)
    return true
}

fn act_name_sync(a: *mut ContAct, cl: *mut mc_client.Client, win: i32, item: i32) {
    act_name_sync_named(a, cl, win, item, 0 as u64, 0)
}

fn prefill(a: *mut ContAct, np: u64, nn: usize) {
    rt.buf_clear(&(*a).def)
    rt.buf_push_bytes(&(*a).def, np, nn)
    mc_chat.chat_input_set(&(*a).field, np, nn)
}

fn act_name_sync_named(a: *mut ContAct, cl: *mut mc_client.Client, win: i32, item: i32, np: u64, nn: usize) {
    if win != (*a).win {
        (*a).win = win
        (*a).item = item
        prefill(a, np, nn)
        return
    }
    if item == (*a).item { return }
    (*a).item = item
    prefill(a, np, nn)
    send_name(a, cl)
}

fn act_name_char(a: *mut ContAct, cl: *mut mc_client.Client, code: u32) -> bool {
    if name_chars(a) >= NAME_MAX_CHARS { return false }
    if !mc_chat.chat_input_char(&(*a).field, code) { return false }
    send_name(a, cl)
    return true
}

fn act_name_backspace(a: *mut ContAct, cl: *mut mc_client.Client) -> bool {
    if mc_chat.chat_input_len(&(*a).field) == 0 { return false }
    mc_chat.chat_input_backspace(&(*a).field)
    send_name(a, cl)
    return true
}

fn act_name_wipe(a: *mut ContAct, cl: *mut mc_client.Client) -> bool {
    if mc_chat.chat_input_len(&(*a).field) == 0 { return false }
    mc_chat.chat_input_clear(&(*a).field)
    send_name(a, cl)
    return true
}

fn act_name_delete(a: *mut ContAct, cl: *mut mc_client.Client) -> bool {
    if mc_chat.chat_input_cursor(&(*a).field) >= mc_chat.chat_input_len(&(*a).field) { return false }
    mc_chat.chat_input_delete(&(*a).field)
    send_name(a, cl)
    return true
}

fn act_name_left(a: *mut ContAct) { mc_chat.chat_input_left(&(*a).field) }
fn act_name_right(a: *mut ContAct) { mc_chat.chat_input_right(&(*a).field) }
fn act_name_home(a: *mut ContAct) { mc_chat.chat_input_home(&(*a).field) }
fn act_name_end(a: *mut ContAct) { mc_chat.chat_input_end(&(*a).field) }
fn act_name_cursor(a: *mut ContAct) -> usize { return mc_chat.chat_input_cursor(&(*a).field) }
