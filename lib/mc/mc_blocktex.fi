// Expected resource pack_format of a game protocol; -1 = not in the table (unverified / unknown).
fn pack_format_for_protocol(protocol: i32) -> i32 {
    if protocol == 47 { return 1 }
    if protocol == 340 { return 3 }
    if protocol == 498 { return 4 }
    if protocol == 578 { return 5 }
    if protocol == 735 { return 5 }
    if protocol == 736 { return 5 }
    if protocol == 754 { return 6 }
    if protocol == 756 { return 7 }
    if protocol == 757 { return 8 }
    if protocol == 758 { return 8 }
    if protocol == 759 { return 9 }
    if protocol == 760 { return 9 }
    if protocol == 761 { return 12 }
    if protocol == 762 { return 13 }
    if protocol == 763 { return 15 }
    if protocol == 764 { return 18 }
    if protocol == 765 { return 22 }
    if protocol == 766 { return 32 }
    if protocol == 767 { return 34 }
    if protocol == 768 { return 42 }
    if protocol == 769 { return 46 }
    if protocol == 770 { return 55 }
    if protocol == 771 { return 63 }
    if protocol == 772 { return 64 }
    if protocol == 773 { return 69 }
    if protocol == 774 { return 75 }
    if protocol == 775 { return 84 }
    return -1
}
