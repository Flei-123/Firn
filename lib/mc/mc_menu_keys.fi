import std.rt
import mc.mc_gui_ui
import mc.mc_keybinds

export { KeysUi, keysui_new, keysui_reset, keys_frame }

const NO_ACTION: i32 = 0 - 1
const LIST_TOP: i32 = 32
const LIST_PAD_BOTTOM: i32 = 32
const ROW_H: i32 = 20
const KEY_W: i32 = 75
const RESET_W: i32 = 50
const KEY_X: i32 = 105
const RESET_X: i32 = 190
const ROW_W: i32 = 240
const SCROLL_ID: i32 = 300
const ESC_CODE: i32 = 1
const COLOR_LISTEN: u32 = 0xFFFF55
const COLOR_CONFLICT: u32 = 0xFF5555

struct KeysUi {
    listen: i32,
    scroll: i32,
}

fn keysui_new() -> KeysUi {
    return KeysUi { listen: NO_ACTION, scroll: 0 }
}

fn keysui_reset(s: *mut KeysUi) {
    (*s).listen = NO_ACTION
    (*s).scroll = 0
}

fn push_s(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn same_text(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    return rt.mem_eq(a.p as u64, b.p as u64, a.n)
}

fn category_fallback(cat: str) -> str {
    if same_text(cat, "key.categories.movement") { return "Movement" }
    if same_text(cat, "key.categories.gameplay") { return "Gameplay" }
    if same_text(cat, "key.categories.inventory") { return "Inventory" }
    if same_text(cat, "key.categories.creative") { return "Creative Mode" }
    if same_text(cat, "key.categories.multiplayer") { return "Multiplayer" }
    return "Miscellaneous"
}

fn total_rows() -> i32 {
    var n: i32 = 0
    var a: i32 = 0
    var last: str = ""
    while a < mc_keybinds.KB_COUNT {
        let cat: str = mc_keybinds.kb_category(a)
        if !same_text(cat, last) {
            n = n + 1
            last = cat
        }
        n = n + 1
        a = a + 1
    }
    return n
}

fn widest_name(u: *mut mc_gui_ui.Ui) -> i32 {
    var w: i32 = 0
    var a: i32 = 0
    while a < mc_keybinds.KB_COUNT {
        let nm: str = mc_keybinds.kb_name(a)
        let tw: i32 = mc_gui_ui.ui_text_width(u, mc_gui_ui.ui_lang(u, nm, nm))
        if tw > w { w = tw }
        a = a + 1
    }
    return w
}

fn apply_capture(s: *mut KeysUi, kb: *mut mc_keybinds.Keybinds, code: i32) {
    var bound: i32 = code
    if code == ESC_CODE { bound = 0 }
    mc_keybinds.kb_set(kb, (*s).listen, bound)
    (*s).listen = NO_ACTION
    mc_keybinds.kb_save_default(kb)
}

fn key_label(u: *mut mc_gui_ui.Ui, kb: *mut mc_keybinds.Keybinds, a: i32, listening: bool, out: *mut rt.Buf) -> u32 {
    rt.buf_clear(out)
    var inner: rt.Buf = rt.buf_new()
    mc_keybinds.kb_key_label(kb, a, &inner)
    if rt.buf_len(&inner) == 0 { push_s(&inner, mc_gui_ui.ui_lang(u, "key.keyboard.unknown", "Not bound")) }
    var col: u32 = mc_gui_ui.COLOR_TEXT
    if listening {
        push_s(out, "> ")
        rt.buf_push_bytes(out, rt.buf_ptr(&inner), rt.buf_len(&inner))
        push_s(out, " <")
        col = COLOR_LISTEN
    } else if mc_keybinds.kb_conflict(kb, a) != mc_keybinds.KB_NONE {
        push_s(out, "[ ")
        rt.buf_push_bytes(out, rt.buf_ptr(&inner), rt.buf_len(&inner))
        push_s(out, " ]")
        col = COLOR_CONFLICT
    } else {
        rt.buf_push_bytes(out, rt.buf_ptr(&inner), rt.buf_len(&inner))
    }
    rt.buf_free(&inner)
    return col
}

fn key_button(u: *mut mc_gui_ui.Ui, x: i32, y: i32, label: str, col: u32) -> bool {
    let hit: bool = mc_gui_ui.ui_button(u, x, y, KEY_W, "", true)
    mc_gui_ui.ui_label_c(u, x + KEY_W / 2, y + 6, col, label)
    return hit
}

fn keys_frame(u: *mut mc_gui_ui.Ui, s: *mut KeysUi, kb: *mut mc_keybinds.Keybinds) -> bool {
    mc_gui_ui.ui_dirt(u, 0x404040)
    let cx: i32 = (*u).uw / 2
    let bottom: i32 = (*u).uh - LIST_PAD_BOTTOM
    if (*s).listen != NO_ACTION && (*u).cap != 0 {
        apply_capture(s, kb, (*u).cap)
        (*u).pressed = false
        (*u).key_esc = false
    }
    let listening: bool = (*s).listen != NO_ACTION
    if listening { (*u).pressed = false }
    mc_gui_ui.ui_list_background(u, LIST_TOP, bottom)
    mc_gui_ui.ui_label_c(u, cx, 16, mc_gui_ui.COLOR_WHITE, mc_gui_ui.ui_lang(u, "controls.title", "Controls"))
    let total: i32 = total_rows()
    let shown: i32 = (bottom - LIST_TOP - 4) / ROW_H
    (*s).scroll = mc_gui_ui.ui_scroll(u, SCROLL_ID, cx + 150, LIST_TOP, bottom, total, shown, (*s).scroll)
    let name_w: i32 = widest_name(u)
    let x0: i32 = cx - ROW_W / 2 - 15
    var lb: rt.Buf = rt.buf_new()
    var row: i32 = 0
    var a: i32 = 0
    var last: str = ""
    while a < mc_keybinds.KB_COUNT {
        let cat: str = mc_keybinds.kb_category(a)
        if !same_text(cat, last) {
            last = cat
            let ry: i32 = LIST_TOP + 4 + (row - (*s).scroll) * ROW_H
            if row >= (*s).scroll && row < (*s).scroll + shown {
                mc_gui_ui.ui_label_c(u, cx, ry + 6 + 4, mc_gui_ui.COLOR_WHITE, mc_gui_ui.ui_lang(u, cat, category_fallback(cat)))
            }
            row = row + 1
        }
        if row >= (*s).scroll && row < (*s).scroll + shown {
            let ry: i32 = LIST_TOP + 4 + (row - (*s).scroll) * ROW_H
            let nm: str = mc_keybinds.kb_name(a)
            mc_gui_ui.ui_label(u, x0 + 90 - name_w, ry + 6, mc_gui_ui.COLOR_WHITE, mc_gui_ui.ui_lang(u, nm, nm))
            let col: u32 = key_label(u, kb, a, (*s).listen == a, &lb)
            if key_button(u, x0 + KEY_X, ry, rt.buf_str(&lb), col) { (*s).listen = a }
            if mc_gui_ui.ui_button(u, x0 + RESET_X, ry, RESET_W, mc_gui_ui.ui_lang(u, "controls.reset", "Reset"), !mc_keybinds.kb_is_default(kb, a)) {
                mc_keybinds.kb_reset(kb, a)
                mc_keybinds.kb_save_default(kb)
            }
        }
        row = row + 1
        a = a + 1
    }
    rt.buf_free(&lb)
    if mc_gui_ui.ui_button(u, cx - 155, (*u).uh - 29, 150, mc_gui_ui.ui_lang(u, "controls.resetAll", "Reset Keys"), true) {
        mc_keybinds.kb_reset_all(kb)
        mc_keybinds.kb_save_default(kb)
        (*s).listen = NO_ACTION
    }
    let done: bool = mc_gui_ui.ui_button(u, cx + 5, (*u).uh - 29, 150, mc_gui_ui.ui_lang(u, "gui.done", "Done"), true)
    if (*s).listen != NO_ACTION { return false }
    return done || (*u).key_esc
}
