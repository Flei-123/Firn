// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_inv.fi -- the player inventory (window 0) from the server packets, for demos/mcplay.
//
//   inv_new()/inv_free(i)                    46 slots (item id, count): 0 craft result, 1-4 craft grid, 5-8 armour, 9-35 main, 36-44 hotbar, 45 off hand
//   inv_slot_format(protocol)                1 = slot layout "present bool, varint item, i8 count, NBT" (1.13.2 .. 1.20.4),
//                                            2 = data components "varint count (0 = empty), varint item, added/removed component counts" (1.20.5+), else 0
//   inv_on_window_items_v(i, ver, body)      Window Items / Set Slot of ANY supported version: <= 1.20.4 by the hand reader below, 1.20.5+ by the generated packet
//   inv_on_set_slot_v(i, ver, body)          schema (mc_schema.walk_values; it knows every component type, so the components are skipped exactly)
//   inv_on_window_items(i, protocol, body)   Window Items (container_set_content) of window 0: stateId (1.17.1+), slot array, carried item
//   inv_on_set_slot(i, protocol, body)       Set Slot of window 0
//   inv_hotbar_item(i, k) / inv_hotbar_count(i, k)    hotbar slot k = 0..8 (item -1 = empty)
//   inv_held_item(i, k)                      item id in hand when hotbar slot k is selected
//   inv_set(i, slot, item, count)            local update (the server does not echo Set Creative Slot)
//   inv_send_creative(cl, slot, item, count) Set Creative Slot (creative mode only): puts `count` x `item` into inventory slot `slot`
//
//   inv_set_efficiency_id(i, id)            enchantment registry id of "minecraft:efficiency" for 1.21+ (mc_client.enchant_efficiency; -1 = unknown)
//   inv_eff(i, slot) / inv_held_eff(i, k)   Efficiency level of the stack (0 = none): <= 1.20.4 from the item NBT "Enchantments" (string ids),
//                                            1.20.5+ from the enchantments component (varint enchantment id = the registry id above)
//   inv_cursor_item(i) / inv_cursor_count(i) the carried stack (Window Items carried item, Set Slot window -1, Set Cursor Item 1.21.2+)
//   inv_use_registry(i, reg)                 stack sizes for the click prediction (mc_registry.reg_item_stack; default 64)
//   inv_click(cl, i, slot, button, mode)     Click Container for window 0 (all versions with a slot layout, 1.21.5+ hashed stacks): sends the packet with the
//                                            predicted result (modes 0 = click, 1 = shift click, 2 = hotbar swap, 4 = drop, 5 = drag, 6 = double click; only
//                                            the crafting result slot is left to the server) and applies it locally. The changed-slot list is the diff of
//                                            the slots before / after. The server answers with Set Slot / Window Items whenever the prediction was wrong.
//   inv_drag_begin/add/end(cl, i, ...)       Drag (mode 5) over several slots (type 0 = split evenly, 1 = one each)
//   inv_drop_slot(cl, i, slot, all)          Drop (mode 4) of a slot via Click Container
//   inv_local_drop(i, slot, all)             local part of the "Drop Item" player action (the caller sends the action)
//   Container windows (chest, shulker box, hopper, dispenser / dropper; window id != 0): inv_on_open_window_v / inv_on_close_window_v track the
//   open window, its slots live behind the player slots (internal index 46 + k = container slot k; the 36 player slots of the window map to
//   the internal slots 9..44). Window Items / Set Slot / Click Container of that window are translated (win_to_int / int_to_win), shift click
//   goes container -> player (reverse) and player -> container (vanilla ChestMenu.quickMoveStack). Other menu types (crafting table, furnace,
//   anvil, ...) are tracked as "unsupported" (inv_window_slots = -1): their items are ignored and clicks are not sent.
//   inv_window(i) / inv_window_slots(i) / inv_win_item(i, k) / inv_win_count(i, k) / inv_close_window(cl, i)
import std.rt
import std.bytes
import mc.mc_client
import mc.mc_sem
import mc.mc_version
import mc.mc_nbt
import mc.mc_schema
import mc.mc_registry
import mc.mc_hash

export {
    Inv, inv_new, inv_free, inv_slot_format, inv_on_window_items, inv_on_set_slot, inv_on_window_items_v, inv_on_set_slot_v, inv_hotbar_item, inv_hotbar_count, inv_held_item,
    inv_item, inv_count, inv_set, inv_send_creative, inv_clear, INV_SLOTS, INV_HOTBAR0, INV_MAIN0,
    inv_eff, inv_held_eff, inv_set_efficiency_id, inv_cursor_item, inv_cursor_count, inv_use_registry, inv_on_set_cursor_v,
    inv_click, inv_click_build, inv_drop_slot, inv_local_drop, inv_set_eff, inv_click_kind, inv_sig, inv_max_stack, inv_cursor_sig,
    inv_set_enchant_keys, inv_patch_of, inv_hash_off, inv_set_creative, inv_drag_begin, inv_drag_add, inv_drag_end,
    INV_CAP, inv_on_open_window_v, inv_on_close_window_v, inv_close_window, inv_local_close, inv_window, inv_window_slots,
    inv_win_item, inv_win_count, inv_win_to_int, inv_int_to_win, inv_window_size,
}

const SLOT_CUR: i32 = 1000
const CLICK_OUTSIDE: i32 = 0 - 999

const INV_SLOTS: usize = 46
// component hash patches of hashed stacks (1.21.5+): scratch of the stack being parsed and the table by stack signature
const PS_LEN: usize = 48 // [0,8) added types, [8,16) added hashes, [16,24) removed types, [24,32) enchantment key hashes, [32,40) level hashes, 40 n_add, 41 n_rem, 42 n_ench, 43 enchantments seen, 44 pending enchantment id
const PT_CAP: usize = 64
const PT_STRIDE: usize = 20 // [0] signature (0 = free), [1] n_add, [2,10) types, [10,18) hashes, [18] n_rem, [19] packed removed types (4 x 8 bit)
const INV_CAP: usize = 100 // 46 player-window slots + up to 54 container slots
const CONT0: i32 = 46
const INV_HOTBAR0: i32 = 36
const INV_MAIN0: i32 = 9

struct Inv {
    ids: u64, // u32 [46], item id + 1 (0 = empty)
    counts: u64, // i32 [46]
    effs: u64, // u32 [46], Efficiency level of the stack
    sigs: u64, // u32 [46], hash of the component list of the stack (0 = no components), 1.20.5+
    maxs: u64, // u32 [46], max_stack_size component of the stack (0 = registry default)
    cur_sig: i32, // the same two values for the carried stack
    cur_max: i32,
    cur_id: i32, // carried stack: item id (-1 = empty), count, Efficiency level
    cur_count: i32,
    cur_eff: i32,
    eff_id: i32, // enchantment registry id of efficiency (1.21+), -1 = unknown
    reg: u64, // *mut mc_registry.Registry for stack sizes, 0 = none
    state_id: i32,
    action: i32, // click counter of the legacy (<= 1.16.5) Click Window packet
    n_updates: u32,
    n_srv: u32, // 1.20.5+ packets (Window Items / Set Slot / Set Cursor Item) applied from the server; unlike n_updates local click predictions do not count
    hash_off: bool, // test switch: hashed stacks are sent without component hashes (the server must then re-send the slot)
    n_clicks: u32,
    bad: u32,
    qc_status: i32, // drag (quick craft) state: 0 = none, 1 = collecting slots
    qc_type: i32,
    qc_mask: u64, // dragged-over slots, bit k = internal slot k (k < 64)
    qc_hi: u64, // bit k = internal slot 64 + k
    win: i32, // open window id (0 = the player window)
    win_n: i32, // container slots of the open window (-1 = a window type we cannot model)
    creative: bool, // drag type 2 (clone) is only valid in creative
    pscr: u64, // u32 [PS_LEN], component hashes of the stack being parsed (hashed stacks, 1.21.5+)
    ptab: u64, // u32 [PT_CAP * PT_STRIDE], component hash patches by stack signature
    pt_next: i32,
    ek: u64, // borrowed: u32 [ek_n], hash of the registry key string of every minecraft:enchantment entry (index = registry id)
    ek_n: i32,
}

fn inv_new() -> Inv {
    var v: Inv = Inv { ids: rt.heap_alloc(INV_CAP * 4), counts: rt.heap_alloc(INV_CAP * 4), effs: rt.heap_alloc(INV_CAP * 4),
        sigs: rt.heap_alloc(INV_CAP * 4), maxs: rt.heap_alloc(INV_CAP * 4), cur_sig: 0, cur_max: 0,
        cur_id: 0 - 1, cur_count: 0, cur_eff: 0, eff_id: 0 - 1, reg: 0, state_id: 0, action: 1, n_updates: 0 as u32, n_srv: 0 as u32, hash_off: false, n_clicks: 0 as u32, bad: 0 as u32, qc_status: 0, qc_type: 0, qc_mask: 0 as u64, qc_hi: 0 as u64, win: 0, win_n: 0, creative: false,
        pscr: rt.heap_alloc(PS_LEN * 4), ptab: rt.heap_alloc(PT_CAP * PT_STRIDE * 4), pt_next: 0, ek: 0, ek_n: 0 }
    inv_clear(&v)
    var z: usize = 0
    while z < PT_CAP * PT_STRIDE { rt.st32(v.ptab, z, 0 as u32); z = z + 1 }
    z = 0
    while z < PS_LEN { rt.st32(v.pscr, z, 0 as u32); z = z + 1 }
    return v
}

fn inv_free(v: *mut Inv) {
    rt.heap_free((*v).ids, INV_CAP * 4)
    rt.heap_free((*v).counts, INV_CAP * 4)
    rt.heap_free((*v).effs, INV_CAP * 4)
    rt.heap_free((*v).sigs, INV_CAP * 4)
    rt.heap_free((*v).maxs, INV_CAP * 4)
    rt.heap_free((*v).pscr, PS_LEN * 4)
    rt.heap_free((*v).ptab, PT_CAP * PT_STRIDE * 4)
    (*v).pscr = 0
    (*v).ptab = 0
    (*v).ids = 0
    (*v).counts = 0
    (*v).effs = 0
    (*v).sigs = 0
    (*v).maxs = 0
}

fn inv_set_efficiency_id(v: *mut Inv, id: i32) { (*v).eff_id = id }
fn inv_use_registry(v: *mut Inv, reg: *mut mc_registry.Registry) { (*v).reg = reg as u64 }
fn inv_cursor_item(v: *mut Inv) -> i32 { return (*v).cur_id }
fn inv_cursor_count(v: *mut Inv) -> i32 { return (*v).cur_count }

fn inv_eff(v: *mut Inv, slot: i32) -> i32 {
    if slot < 0 || slot as usize >= INV_CAP { return 0 }
    return rt.ld32((*v).effs, slot as usize) as i32
}
fn inv_held_eff(v: *mut Inv, k: i32) -> i32 { return inv_eff(v, INV_HOTBAR0 + k) }

// component signature of a stack (0 = no components; equal signatures = same component list, 1.20.5+) and its max_stack_size component (0 = none)
fn inv_sig(v: *mut Inv, slot: i32) -> i32 {
    if slot < 0 || slot as usize >= INV_CAP { return 0 }
    return rt.ld32((*v).sigs, slot as usize) as i32
}
fn inv_max_stack(v: *mut Inv, slot: i32) -> i32 {
    if slot < 0 || slot as usize >= INV_CAP { return 0 }
    return rt.ld32((*v).maxs, slot as usize) as i32
}
fn inv_cursor_sig(v: *mut Inv) -> i32 { return (*v).cur_sig }

fn set_extra(v: *mut Inv, slot: i32, sig: i32, mx: i32) {
    if slot == SLOT_CUR { (*v).cur_sig = sig; (*v).cur_max = mx; return }
    if slot < 0 || slot as usize >= INV_CAP { return }
    rt.st32((*v).sigs, slot as usize, sig as u32)
    rt.st32((*v).maxs, slot as usize, mx as u32)
}

// sets the Efficiency level of a slot (SLOT_CUR = the carried stack)
fn inv_set_eff(v: *mut Inv, slot: i32, lvl: i32) {
    if slot == SLOT_CUR { (*v).cur_eff = lvl; return }
    if slot < 0 || slot as usize >= INV_CAP { return }
    rt.st32((*v).effs, slot as usize, lvl as u32)
}

fn inv_clear(v: *mut Inv) {
    var i: usize = 0
    while i < INV_CAP {
        rt.st32((*v).ids, i, 0 as u32)
        rt.st32((*v).counts, i, 0 as u32)
        rt.st32((*v).effs, i, 0 as u32)
        rt.st32((*v).sigs, i, 0 as u32)
        rt.st32((*v).maxs, i, 0 as u32)
        i = i + 1
    }
    (*v).cur_id = 0 - 1
    (*v).cur_count = 0
    (*v).cur_eff = 0
    (*v).cur_sig = 0
    (*v).cur_max = 0
    (*v).qc_status = 0
    (*v).qc_mask = 0 as u64
    (*v).qc_hi = 0 as u64
    (*v).win = 0
    (*v).win_n = 0
}

// ---- container windows: window slot <-> internal slot ----

fn inv_window(v: *mut Inv) -> i32 { return (*v).win }
fn inv_window_slots(v: *mut Inv) -> i32 { return (*v).win_n }

// number of internal slots in play: 46 (player window) or 46 + container slots
fn nint(v: *mut Inv) -> i32 {
    if (*v).win != 0 && (*v).win_n > 0 { return CONT0 + (*v).win_n }
    return INV_SLOTS as i32
}

// slots in the open window as the server numbers them (46 for window 0, container slots + 36 otherwise; 0 = unsupported window)
fn inv_window_size(v: *mut Inv) -> i32 {
    if (*v).win == 0 { return INV_SLOTS as i32 }
    if (*v).win_n <= 0 { return 0 }
    return (*v).win_n + 36
}

// is the internal slot part of the open window (window 0: all 46; a container: the container slots and the 36 main + hotbar slots)?
fn in_win(v: *mut Inv, k: i32) -> bool {
    if k < 0 { return false }
    if (*v).win == 0 || (*v).win_n <= 0 { return (k as usize) < INV_SLOTS }
    return (k >= 9 && k < 45) || (k >= CONT0 && k < CONT0 + (*v).win_n)
}

// window slot number (as in the packets) -> internal slot; -2 = outside the window
fn inv_win_to_int(v: *mut Inv, ws: i32) -> i32 {
    if ws < 0 { return 0 - 2 }
    if (*v).win == 0 || (*v).win_n <= 0 {
        if (ws as usize) < INV_SLOTS { return ws }
        return 0 - 2
    }
    let n: i32 = (*v).win_n
    if ws < n { return CONT0 + ws }
    if ws < n + 36 { return 9 + (ws - n) }
    return 0 - 2
}

// internal slot -> window slot number; -2 = not part of the window
fn inv_int_to_win(v: *mut Inv, k: i32) -> i32 {
    if !in_win(v, k) { return 0 - 2 }
    if (*v).win == 0 || (*v).win_n <= 0 { return k }
    if k >= CONT0 { return k - CONT0 }
    return (*v).win_n + (k - 9)
}

// container slot k (0-based) of the open container
fn inv_win_item(v: *mut Inv, k: i32) -> i32 {
    if k < 0 || (*v).win_n <= 0 || k >= (*v).win_n { return 0 - 1 }
    return inv_item(v, CONT0 + k)
}
fn inv_win_count(v: *mut Inv, k: i32) -> i32 {
    if k < 0 || (*v).win_n <= 0 || k >= (*v).win_n { return 0 }
    return inv_count(v, CONT0 + k)
}

fn clear_container(v: *mut Inv) {
    var i: usize = CONT0 as usize
    while i < INV_CAP {
        rt.st32((*v).ids, i, 0 as u32)
        rt.st32((*v).counts, i, 0 as u32)
        rt.st32((*v).effs, i, 0 as u32)
        rt.st32((*v).sigs, i, 0 as u32)
        rt.st32((*v).maxs, i, 0 as u32)
        i = i + 1
    }
}

// forget the open container (server Close Window or local close)
fn inv_local_close(v: *mut Inv) {
    (*v).win = 0
    (*v).win_n = 0
    clear_container(v)
    (*v).qc_status = 0
    (*v).qc_mask = 0 as u64
    (*v).qc_hi = 0 as u64
}

// slot count of a menu type id (1.14+ registry): generic_9x1 .. generic_9x6 = 0..5, generic_3x3 = 6; others are not modelled (-1)
fn menu_slots(typ: i32) -> i32 {
    if typ >= 0 && typ <= 5 { return 9 * (typ + 1) }
    if typ == 6 { return 9 }
    return 0 - 1
}

fn str_is(p: u64, n: usize, lit: str) -> bool { return n == lit.n && line_is(p, n, lit) }

// Open Window (s2c). 1.14+: varint window id, varint menu type, title. 1.13.2: u8 id, type string, title string, u8 slot count.
fn inv_on_open_window_v(v: *mut Inv, ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let protocol: i32 = (*ver).protocol
    if inv_slot_format(protocol) == 0 { return false }
    var id: i32 = 0
    var n: i32 = 0 - 1
    if protocol >= 477 {
        id = bytes.get_varint(b) catch (0 - 1)
        let typ: i32 = bytes.get_varint(b) catch (0 - 1)
        if id < 0 { (*v).bad = (*v).bad + 1 as u32; return false }
        n = menu_slots(typ)
    } else {
        let id8: u8 = bytes.get_u8(b) catch (255 as u8)
        id = id8 as i32
        var tn: usize = 0
        let tp: u64 = bytes.get_string(b, &tn) catch 0
        var wn: usize = 0
        let wp: u64 = bytes.get_string(b, &wn) catch 0
        let cnt: u8 = bytes.get_u8(b) catch (255 as u8)
        if tp == 0 || wp == 0 || cnt == 255 as u8 { (*v).bad = (*v).bad + 1 as u32; return false }
        if str_is(tp, tn, "minecraft:container") || str_is(tp, tn, "minecraft:chest") || str_is(tp, tn, "minecraft:shulker_box")
        || str_is(tp, tn, "minecraft:hopper") || str_is(tp, tn, "minecraft:dispenser") || str_is(tp, tn, "minecraft:dropper") {
            if (cnt as i32) > 0 && (cnt as i32) <= 54 { n = cnt as i32 }
        }
    }
    if id == 0 { return false }
    clear_container(v)
    (*v).qc_status = 0
    (*v).qc_mask = 0 as u64
    (*v).qc_hi = 0 as u64
    (*v).win = id
    (*v).win_n = n
    return true
}

// Close Window (s2c): u8 id up to 1.21.1, varint id from 1.21.3 (protocol 768)
fn inv_on_close_window_v(v: *mut Inv, ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    var id: i32 = 0 - 1
    if (*ver).protocol >= 768 {
        id = bytes.get_varint(b) catch (0 - 1)
    } else {
        let id8: u8 = bytes.get_u8(b) catch (255 as u8)
        if id8 != 255 as u8 { id = id8 as i32 }
    }
    if id < 0 || id != (*v).win { return false }
    inv_local_close(v)
    return true
}

// Close Window (c2s) of the open window, then forget it locally
fn inv_close_window(cl: *mut mc_client.Client, v: *mut Inv) -> bool {
    if (*v).win == 0 { return false }
    var b: bytes.Bytes = bytes.bytes_new()
    if (*cl).ver.protocol >= 768 { bytes.put_varint(&b, (*v).win) } else { bytes.put_u8(&b, (*v).win as u8) }
    let ok: bool = mc_client.client_send(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_CLOSE_WINDOW, &b)
    bytes.bytes_free(&b)
    inv_local_close(v)
    return ok
}

fn inv_slot_format(protocol: i32) -> i32 {
    if protocol >= 404 && protocol <= 765 { return 1 }
    if protocol >= 766 { return 2 }
    return 0
}

fn inv_item(v: *mut Inv, slot: i32) -> i32 {
    if slot < 0 || slot as usize >= INV_CAP { return 0 - 1 }
    return (rt.ld32((*v).ids, slot as usize) as i32) - 1 // stored +1: 0 = empty
}

fn inv_count(v: *mut Inv, slot: i32) -> i32 {
    if slot < 0 || slot as usize >= INV_CAP { return 0 }
    return rt.ld32((*v).counts, slot as usize) as i32
}

fn inv_hotbar_item(v: *mut Inv, k: i32) -> i32 { return inv_item(v, INV_HOTBAR0 + k) }
fn inv_hotbar_count(v: *mut Inv, k: i32) -> i32 { return inv_count(v, INV_HOTBAR0 + k) }
fn inv_held_item(v: *mut Inv, k: i32) -> i32 { return inv_item(v, INV_HOTBAR0 + k) }

fn inv_set(v: *mut Inv, slot: i32, item: i32, count: i32) { put_slot(v, slot, item, count) }

fn put_slot(v: *mut Inv, slot: i32, item: i32, count: i32) {
    if slot == SLOT_CUR {
        if item < 0 || count <= 0 { (*v).cur_id = 0 - 1; (*v).cur_count = 0 } else { (*v).cur_id = item; (*v).cur_count = count }
        (*v).cur_eff = 0
        (*v).cur_sig = 0
        (*v).cur_max = 0
        (*v).n_updates = (*v).n_updates + 1 as u32
        return
    }
    if slot < 0 || slot as usize >= INV_CAP { return }
    rt.st32((*v).effs, slot as usize, 0 as u32)
    rt.st32((*v).sigs, slot as usize, 0 as u32)
    rt.st32((*v).maxs, slot as usize, 0 as u32)
    if item < 0 || count <= 0 {
        rt.st32((*v).ids, slot as usize, 0 as u32)
        rt.st32((*v).counts, slot as usize, 0 as u32)
    } else {
        rt.st32((*v).ids, slot as usize, (item + 1) as u32)
        rt.st32((*v).counts, slot as usize, count as u32)
    }
    (*v).n_updates = (*v).n_updates + 1 as u32
}

fn named(d: *mut mc_nbt.Doc, n: u32, lit: str) -> u32 { return mc_nbt.nbt_get(d, n, lit.p as u64, lit.n) }

// Efficiency level from the item NBT (<= 1.20.4): "Enchantments" is a list of {id: "minecraft:efficiency", lvl: N}
fn nbt_efficiency(d: *mut mc_nbt.Doc) -> i32 {
    let root: u32 = mc_nbt.doc_root(d)
    let en: u32 = named(d, root, "Enchantments")
    if en == 0 as u32 || mc_nbt.nbt_kind(d, en) != 9 as u8 { return 0 }
    var e: u32 = mc_nbt.nbt_first(d, en)
    var guard: i32 = 0
    while e != 0 as u32 && guard < 64 {
        let idn: u32 = named(d, e, "id")
        if idn != 0 as u32 && mc_nbt.nbt_kind(d, idn) == 8 as u8 {
            var n: usize = 0
            let p: u64 = mc_nbt.nbt_str(d, idn, &n)
            if n >= 10 && line_is(p + ((n - 10) as u64), 10, "efficiency") {
                let ln: u32 = named(d, e, "lvl")
                if ln != 0 as u32 { return mc_nbt.nbt_i64(d, ln) as i32 }
            }
        }
        e = mc_nbt.nbt_next(d, e)
        guard = guard + 1
    }
    return 0
}

// Reads one slot value (present bool, varint item, i8 count, optional NBT). item = -1 for an empty slot. false = malformed.
fn read_slot(b: *mut bytes.Bytes, protocol: i32, item: *mut i32, count: *mut i32, eff: *mut i32) -> bool {
    *item = 0 - 1
    *count = 0
    *eff = 0
    let present: bool = bytes.get_bool(b) catch false
    if !present { return true }
    let it: i32 = bytes.get_varint(b) catch (0 - 1)
    if it < 0 { return false }
    let n: i8 = bytes.get_i8(b) catch (0 as i8)
    let tag: u8 = bytes.get_u8(b) catch (255 as u8)
    if tag == 255 as u8 { return false }
    if tag != 0 as u8 {
        // a compound follows (named root up to 1.20.1; nameless since 1.20.2): step back and parse it
        bytes.bytes_set_pos(b, bytes.bytes_pos(b) - 1)
        var d: mc_nbt.Doc = mc_nbt.doc_new()
        let ok: bool = mc_nbt.doc_parse(&d, b, protocol >= 764, false) catch false
        if ok { *eff = nbt_efficiency(&d) }
        mc_nbt.doc_free(&d)
        if !ok { return false }
    }
    *item = it
    *count = n as i32
    return true
}

fn put_slot_e(v: *mut Inv, slot: i32, item: i32, count: i32, eff: i32) {
    put_slot(v, slot, item, count)
    if item >= 0 && count > 0 { inv_set_eff(v, slot, eff) }
}

fn inv_on_window_items(v: *mut Inv, protocol: i32, b: *mut bytes.Bytes) -> bool {
    if inv_slot_format(protocol) != 1 { return false }
    let wid: u8 = bytes.get_u8(b) catch (255 as u8)
    var mapw: bool = false
    if wid != 0 as u8 {
        if wid == 255 as u8 || wid as i32 != (*v).win || (*v).win_n <= 0 { return false }
        mapw = true
    }
    if protocol >= 756 { (*v).state_id = bytes.get_varint(b) catch 0 }
    var n: i32 = 0
    if protocol >= 756 {
        n = bytes.get_varint(b) catch (0 - 1)
    } else {
        let n16: i16 = bytes.get_i16(b) catch ((0 - 1) as i16)
        n = n16 as i32
    }
    if n < 0 || n > 128 { (*v).bad = (*v).bad + 1 as u32; return false }
    var i: i32 = 0
    while i < n {
        var item: i32 = 0 - 1
        var cnt: i32 = 0
        var eff: i32 = 0
        if !read_slot(b, protocol, &item, &cnt, &eff) { (*v).bad = (*v).bad + 1 as u32; return false }
        var ti: i32 = i
        if mapw { ti = inv_win_to_int(v, i) }
        put_slot_e(v, ti, item, cnt, eff)
        i = i + 1
    }
    if protocol >= 756 {
        // the carried item (1.17.1+); 1.16.5 has none
        var item: i32 = 0 - 1
        var cnt: i32 = 0
        var eff: i32 = 0
        if !read_slot(b, protocol, &item, &cnt, &eff) { (*v).bad = (*v).bad + 1 as u32; return false }
        put_slot_e(v, SLOT_CUR, item, cnt, eff)
    }
    return true
}

fn inv_on_set_slot(v: *mut Inv, protocol: i32, b: *mut bytes.Bytes) -> bool {
    if inv_slot_format(protocol) != 1 { return false }
    let wid: i8 = bytes.get_i8(b) catch ((0 - 2) as i8)
    var mapw: bool = false
    if wid != 0 as i8 && wid != (0 - 1) as i8 {
        if wid as i32 != (*v).win || (*v).win_n <= 0 { return false }
        mapw = true
    }
    if protocol >= 756 { (*v).state_id = bytes.get_varint(b) catch 0 }
    let slot16: i16 = bytes.get_i16(b) catch ((0 - 1) as i16)
    var slot: i32 = slot16 as i32
    if mapw { slot = inv_win_to_int(v, slot) }
    if wid == (0 - 1) as i8 {
        // window -1 slot -1 = the carried stack
        if slot != 0 - 1 { return false }
        slot = SLOT_CUR
    }
    var item: i32 = 0 - 1
    var cnt: i32 = 0
    var eff: i32 = 0
    if !read_slot(b, protocol, &item, &cnt, &eff) { (*v).bad = (*v).bad + 1 as u32; return false }
    put_slot_e(v, slot, item, cnt, eff)
    return true
}

// ---- 1.20.5+ (data components): the generated packet schema walks the packet, the dump lines carry the fields we need ----

fn line_is(ln: u64, n: usize, lit: str) -> bool {
    if n < lit.n { return false }
    var i: usize = 0
    while i < lit.n {
        if rt.ld8(ln, i) != rt.ld8(lit.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

// decimal at p[0..n) (optional '-'); ok = false when there is any other character
fn parse_dec(p: u64, n: usize, ok: *mut bool) -> i32 {
    var i: usize = 0
    var neg: bool = false
    var r: i64 = 0
    *ok = n > 0
    if n > 0 && rt.ld8(p, 0) == 45 as u8 { neg = true; i = 1; *ok = n > 1 }
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 { *ok = false; return 0 }
        r = r * 10 + ((c as i64) - 48)
        if r > 2000000000 { *ok = false; return 0 }
        i = i + 1
    }
    if neg { r = 0 - r }
    return r as i32
}

// Component type id of `max_stack_size` (custom_data 0, max_stack_size 1, max_damage 2, damage 3 in every 1.21.x registry)
const COMP_MAX_STACK: i32 = 1

fn fnv_bytes(h: u64, p: u64, n: usize) -> u64 {
    var r: u64 = h
    var i: usize = 0
    while i < n {
        r = ((r ^ (rt.ld8(p, i) as u64)) * 16777619) & 4294967295
        i = i + 1
    }
    return ((r ^ 61) * 16777619) & 4294967295 // line separator
}

// ---- component hashes of the hashed stacks (1.21.5+) ------------------------------------------------------------------------
// data component type ids (minecraft-data SlotComponentType) of the components we can hash; -1 = protocol without hashed stacks.
// k: 0 max_stack_size, 1 max_damage, 2 damage, 3 unbreakable, 4 custom_name, 5 item_name, 6 rarity, 7 enchantments, 8 repair_cost, 9 enchantment_glint_override
fn hc_type(protocol: i32, k: i32) -> i32 {
    if protocol == 770 || protocol == 772 {
        if k == 0 { return 1 } else if k == 1 { return 2 } else if k == 2 { return 3 } else if k == 3 { return 4 } else if k == 4 { return 5 }
        else if k == 5 { return 6 } else if k == 6 { return 9 } else if k == 7 { return 10 } else if k == 8 { return 16 } else { return 18 }
    }
    if protocol == 774 || protocol == 775 {
        if k == 0 { return 1 } else if k == 1 { return 2 } else if k == 2 { return 3 } else if k == 3 { return 4 } else if k == 4 { return 6 }
        else if k == 5 { return 9 } else if k == 6 { return 12 } else if k == 7 { return 13 } else if k == 8 { return 19 } else { return 21 }
    }
    return 0 - 1
}

fn inv_hash_off(v: *mut Inv, off: bool) { (*v).hash_off = off }

fn inv_set_enchant_keys(v: *mut Inv, keys: u64, n: i32) {
    (*v).ek = keys
    (*v).ek_n = n
}

fn ps_reset(v: *mut Inv) {
    var i: usize = 40
    while i < 45 { rt.st32((*v).pscr, i, 0 as u32); i = i + 1 }
}

fn ps_n(v: *mut Inv, i: usize) -> i32 { return rt.ld32((*v).pscr, i) as i32 }

fn ps_add(v: *mut Inv, t: i32, h: u32) {
    let n: i32 = ps_n(v, 40)
    if n >= 8 { return }
    rt.st32((*v).pscr, n as usize, t as u32)
    rt.st32((*v).pscr, 8 + n as usize, h)
    rt.st32((*v).pscr, 40, (n + 1) as u32)
}

fn ps_rem(v: *mut Inv, t: i32) {
    let n: i32 = ps_n(v, 41)
    if n >= 4 { return }
    rt.st32((*v).pscr, 16 + n as usize, t as u32)
    rt.st32((*v).pscr, 41, (n + 1) as u32)
}

// one enchantment entry (registry id, level); an id without a known key hash makes the whole component unhashable (n_ench = 99)
fn ps_ench(v: *mut Inv, id: i32, level: i32) {
    let n: i32 = ps_n(v, 42)
    if n >= 8 { rt.st32((*v).pscr, 42, 99 as u32); return }
    if n == 99 { return }
    if id < 0 || id >= (*v).ek_n || (*v).ek == 0 { rt.st32((*v).pscr, 42, 99 as u32); return }
    rt.st32((*v).pscr, 24 + n as usize, rt.ld32((*v).ek, id as usize))
    rt.st32((*v).pscr, 32 + n as usize, mc_hash.hash_int(level))
    rt.st32((*v).pscr, 42, (n + 1) as u32)
}

// simple component value `V` (the text of a `components[K].data=V` line) -> hash, by component type; false = type or value not supported
fn hc_data(protocol: i32, ct: i32, vp: u64, vn: usize, out: *mut u32) -> bool {
    var okn: bool = false
    if ct == hc_type(protocol, 0) || ct == hc_type(protocol, 1) || ct == hc_type(protocol, 2) || ct == hc_type(protocol, 8) {
        let x: i32 = parse_dec(vp, vn, &okn)
        if !okn { return false }
        (*out) = mc_hash.hash_int(x)
        return true
    }
    if ct == hc_type(protocol, 9) {
        if vn == 4 && line_is(vp, 4, "true") { (*out) = mc_hash.hash_bool(true); return true }
        if vn == 5 && line_is(vp, 5, "false") { (*out) = mc_hash.hash_bool(false); return true }
        return false
    }
    if ct == hc_type(protocol, 6) {
        let x: i32 = parse_dec(vp, vn, &okn)
        if !okn || x < 0 || x > 3 { return false }
        if x == 0 { (*out) = mc_hash.hash_string("common".p as u64, "common".n) }
        else if x == 1 { (*out) = mc_hash.hash_string("uncommon".p as u64, "uncommon".n) }
        else if x == 2 { (*out) = mc_hash.hash_string("rare".p as u64, "rare".n) }
        else { (*out) = mc_hash.hash_string("epic".p as u64, "epic".n) }
        return true
    }
    if ct == hc_type(protocol, 4) || ct == hc_type(protocol, 5) {
        // anonymous NBT `hex:08 LLLL text`: only a plain string name (a styled name is a compound and stays unhashed)
        if vn < 12 || !line_is(vp, 4, "hex:") { return false }
        if hex_byte(vp, 4) != 8 { return false }
        let ln: i32 = (hex_byte(vp, 6) << 8) | hex_byte(vp, 8)
        if ln < 0 || (ln as usize) * 2 + 10 != vn || ln > 200 { return false }
        let sb: u64 = rt.heap_alloc(256)
        var k: i32 = 0
        while k < ln { rt.st8(sb, k as usize, hex_byte(vp, 10 + (k as usize) * 2) as u8); k = k + 1 }
        (*out) = mc_hash.hash_string(sb, ln as usize)
        rt.heap_free(sb, 256)
        return true
    }
    return false
}

fn hex_nib(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 { return (c as i32) - 48 }
    if c >= 97 as u8 && c <= 102 as u8 { return (c as i32) - 87 }
    return 0 - 1
}

// byte at hex digit offset `o` of the text at p (-1 on a bad digit)
fn hex_byte(p: u64, o: usize) -> i32 {
    let a: i32 = hex_nib(rt.ld8(p, o))
    let b: i32 = hex_nib(rt.ld8(p, o + 1))
    if a < 0 || b < 0 { return 0 - 1 }
    return a * 16 + b
}

// type-only components (no data line): unbreakable = the unit record {} = an empty map
fn ps_on_type(v: *mut Inv, protocol: i32, ct: i32) {
    if ct == hc_type(protocol, 3) { ps_add(v, ct, mc_hash.hash_map(0, 0, 0)) }
    if ct == hc_type(protocol, 7) { rt.st32((*v).pscr, 43, 1 as u32) }
}

// closes the stack being parsed: registers the patch under its signature
fn patch_register(v: *mut Inv, protocol: i32, sig: i32) {
    if sig == 0 || hc_type(protocol, 0) < 0 { ps_reset(v); return }
    if ps_n(v, 43) != 0 && ps_n(v, 42) != 99 {
        let n: i32 = ps_n(v, 42)
        ps_add(v, hc_type(protocol, 7), mc_hash.hash_map((*v).pscr + 96, (*v).pscr + 128, n as usize))
    }
    var e: usize = PT_CAP
    var i: usize = 0
    while i < PT_CAP { if rt.ld32((*v).ptab, i * PT_STRIDE) == (sig as u32) { e = i }; i = i + 1 }
    if e == PT_CAP { e = (*v).pt_next as usize; (*v).pt_next = (((*v).pt_next + 1) as usize % PT_CAP) as i32 }
    let t: u64 = (*v).ptab + ((e * PT_STRIDE * 4) as u64)
    rt.st32(t, 0, sig as u32)
    rt.st32(t, 1, ps_n(v, 40) as u32)
    var k: usize = 0
    while k < 8 {
        rt.st32(t, 2 + k, rt.ld32((*v).pscr, k))
        rt.st32(t, 10 + k, rt.ld32((*v).pscr, 8 + k))
        k = k + 1
    }
    rt.st32(t, 18, ps_n(v, 41) as u32)
    var pk: u32 = 0 as u32
    k = 0
    while k < 4 { pk = pk | ((rt.ld32((*v).pscr, 16 + k) & (255 as u32)) << ((k * 8) as u32)); k = k + 1 }
    rt.st32(t, 19, pk)
    ps_reset(v)
}

// the component hash patch of the stack with signature `sig` (no components / unknown signature = nothing added)
fn inv_patch_of(v: *mut Inv, sig: i32, h: *mut mc_hash.HStack) {
    if sig == 0 || (*v).hash_off { return }
    var i: usize = 0
    while i < PT_CAP {
        if rt.ld32((*v).ptab, i * PT_STRIDE) == (sig as u32) {
            let t: u64 = (*v).ptab + ((i * PT_STRIDE * 4) as u64)
            let na: i32 = rt.ld32(t, 1) as i32
            var k: i32 = 0
            while k < na && k < 8 { mc_hash.hstack_add(h, rt.ld32(t, 2 + k as usize) as i32, rt.ld32(t, 10 + k as usize)); k = k + 1 }
            let nr: i32 = rt.ld32(t, 18) as i32
            let pk: u32 = rt.ld32(t, 19)
            k = 0
            while k < nr && k < 4 { mc_hash.hstack_remove(h, ((pk >> ((k * 8) as u32)) & (255 as u32)) as i32); k = k + 1 }
            return
        }
        i = i + 1
    }
}

// stores the signature of the component list (0 when the stack has none) and the max_stack_size of the stack at `slot`
fn flush_extra(v: *mut Inv, protocol: i32, slot: i32, h: u64, n: i32, mx: i32) {
    var sig: i32 = 0
    if n > 0 { sig = ((h & 2147483647) | 1) as i32 }
    set_extra(v, slot, sig, mx)
    patch_register(v, protocol, sig)
}

// Component type id of `enchantments` per protocol (minecraft-data SlotComponentType): 767 -> 9, 769/772 -> 10, 774/775 -> 13
fn ench_comp_type(protocol: i32) -> i32 {
    if protocol <= 767 { return 9 }
    if protocol <= 772 { return 10 }
    return 13
}

// Runs the schema of packet `sem` over the body and applies the slot lines to the inventory.
// window_items: `items[N].itemCount` then `items[N].itemId`, the carried stack `carriedItem.*`; set_slot: `slot=S`, `item.itemCount`, `item.itemId`
// (window -1 / slot -1 = carried stack); set_cursor_item: `contents.*`. Component lines `<prefix>.components[K].type=T` and
// `<prefix>.components[K].data.enchantments[J].id|level=X` give the Efficiency level; nested slots have longer paths and are ignored.
fn apply_components(v: *mut Inv, ver: *mut mc_version.Version, sem: usize, b: *mut bytes.Bytes) -> bool {
    let id: i32 = mc_version.version_pid(ver, sem)
    if id < 0 { return false }
    let sch: u64 = (*ver).schema_of(mc_version.ST_PLAY, mc_version.DIR_S2C, id)
    if sch == 0 as u64 { return false }
    let kind: i32 = sem_kind(sem)
    let p0: usize = bytes.bytes_pos(b)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk_values(sch, b, &out)
    bytes.bytes_set_pos(b, p0)
    if !ok {
        rt.buf_free(&out)
        (*v).bad = (*v).bad + 1 as u32
        return false
    }
    let base: u64 = rt.buf_ptr(&out)
    let total: usize = rt.buf_len(&out)
    let ect: i32 = ench_comp_type((*ver).protocol)
    var pos: usize = 0
    var target: i32 = 0 - 1 // set_slot: the slot number
    var win_cur: bool = false
    var pend_n: i32 = 0 - 1
    var pend_c: i32 = 0
    var comp_type: i32 = 0 - 1
    var ench_cur: i32 = 0 - 1
    var good: bool = true
    var acc_tgt: i32 = 0 - 1 // stack whose component lines are being hashed
    var acc_h: u64 = 2166136261
    var acc_n: i32 = 0
    var acc_mx: i32 = 0
    var n_win_ok: bool = kind == 2
    var wmap: bool = false
    while pos < total && good {
        var e: usize = pos
        while e < total && rt.ld8(base, e) != 10 as u8 { e = e + 1 }
        let ln: u64 = base + (pos as u64)
        let n: usize = e - pos
        pos = e + 1
        var eq: usize = 0
        while eq < n && rt.ld8(ln, eq) != 61 as u8 { eq = eq + 1 }
        if eq >= n { continue }
        let vp: u64 = ln + ((eq + 1) as u64)
        let vn: usize = n - eq - 1
        var okn: bool = false
        if eq == 8 && line_is(ln, 8, "windowId") {
            let w: i32 = parse_dec(vp, vn, &okn)
            if !okn { good = false } else if w == 0 { n_win_ok = true } else if w == (*v).win && (*v).win_n > 0 && kind != 2 { n_win_ok = true; wmap = true } else if kind == 1 && (w == 0 - 1 || w == 255) { n_win_ok = true; win_cur = true } else { good = false }
        } else if eq == 7 && line_is(ln, 7, "stateId") {
            let st: i32 = parse_dec(vp, vn, &okn)
            if okn { (*v).state_id = st }
        } else if kind == 1 && eq == 4 && line_is(ln, 4, "slot") {
            target = parse_dec(vp, vn, &okn)
            if !okn { good = false }
            if good && wmap { target = inv_win_to_int(v, target) }
            if good && win_cur {
                if target != 0 - 1 { good = false } else { target = SLOT_CUR }
            }
        } else {
            // which stack does the line belong to?
            var tgt: i32 = 0 - 1
            var po: usize = 0
            if kind == 0 && line_is(ln, eq, "items[") {
                var q: usize = 6
                while q < eq && rt.ld8(ln, q) != 93 as u8 { q = q + 1 }
                let idx: i32 = parse_dec(ln + 6 as u64, q - 6, &okn)
                if q < eq && okn && q + 1 < eq && rt.ld8(ln, q + 1) == 46 as u8 { tgt = idx; po = q + 2; if wmap { tgt = inv_win_to_int(v, idx) } }
            } else if kind == 0 && line_is(ln, eq, "carriedItem.") {
                tgt = SLOT_CUR
                po = 12
            } else if kind == 1 && line_is(ln, eq, "item.") {
                tgt = target
                po = 5
            } else if kind == 2 && line_is(ln, eq, "contents.") {
                tgt = SLOT_CUR
                po = 9
            }
            if tgt != 0 - 1 && po < eq {
                let fp: u64 = ln + (po as u64)
                let fnn: usize = eq - po
                if acc_tgt != 0 - 1 && !(fnn == 9 && line_is(fp, 9, "itemCount")) && !(fnn == 6 && line_is(fp, 6, "itemId")) && tgt == acc_tgt {
                    // component entries (indexed paths) make up the signature; the counts of a plain stack stay out so it hashes to 0
                    var has_ix: bool = false
                    var hq: usize = 0
                    while hq < fnn { if rt.ld8(fp, hq) == 91 as u8 { has_ix = true }; hq = hq + 1 }
                    if has_ix {
                        acc_h = fnv_bytes(acc_h, fp, fnn)
                        acc_h = fnv_bytes(acc_h, vp, vn)
                        acc_n = acc_n + 1
                    }
                }
                if fnn == 9 && line_is(fp, 9, "itemCount") {
                    if acc_tgt != 0 - 1 { flush_extra(v, (*ver).protocol, acc_tgt, acc_h, acc_n, acc_mx) }
                    acc_tgt = 0 - 1
                    acc_h = 2166136261
                    acc_n = 0
                    acc_mx = 0
                    ps_reset(v)
                    let c: i32 = parse_dec(vp, vn, &okn)
                    comp_type = 0 - 1
                    ench_cur = 0 - 1
                    if okn && c <= 0 {
                        put_slot(v, tgt, 0 - 1, 0)
                        pend_n = 0 - 1
                    } else if okn {
                        pend_n = tgt
                        pend_c = c
                        acc_tgt = tgt
                    }
                } else if fnn == 6 && line_is(fp, 6, "itemId") {
                    if tgt == pend_n && pend_c > 0 {
                        let it: i32 = parse_dec(vp, vn, &okn)
                        if okn { put_slot(v, tgt, it, pend_c) }
                    }
                    pend_n = 0 - 1
                } else if fnn > 18 && line_is(fp, fnn, "removeComponents[") && hc_type((*ver).protocol, 0) >= 0 {
                    var r2: usize = 17
                    while r2 < fnn && rt.ld8(fp, r2) != 93 as u8 { r2 = r2 + 1 }
                    if r2 + 6 < fnn + 1 && fnn - r2 - 2 == 4 && line_is(fp + ((r2 + 2) as u64), 4, "type") {
                        let rt2: i32 = parse_dec(vp, vn, &okn)
                        if okn { ps_rem(v, rt2) }
                    }
                } else if fnn > 12 && line_is(fp, fnn, "components[") {
                    var r: usize = 11
                    while r < fnn && rt.ld8(fp, r) != 93 as u8 { r = r + 1 }
                    if r + 2 < fnn && rt.ld8(fp, r + 1) == 46 as u8 {
                        let rp: u64 = fp + ((r + 2) as u64)
                        let rn: usize = fnn - r - 2
                        // hashed stacks (1.21.5+): the value of every component we can hash
                        if hc_type((*ver).protocol, 0) >= 0 && comp_type >= 0 {
                            if rn == 4 && line_is(rp, 4, "data") {
                                var hv: u32 = 0 as u32
                                if hc_data((*ver).protocol, comp_type, vp, vn, &hv) { ps_add(v, comp_type, hv) }
                            } else if comp_type == hc_type((*ver).protocol, 7) && rn > 19 && line_is(rp, 19, "data.enchantments[") {
                                var t2: usize = 18
                                while t2 < rn && rt.ld8(rp, t2) != 93 as u8 { t2 = t2 + 1 }
                                if t2 + 1 < rn && rt.ld8(rp, t2 + 1) == 46 as u8 {
                                    let sp2: u64 = rp + ((t2 + 2) as u64)
                                    let sn2: usize = rn - t2 - 2
                                    if sn2 == 2 && line_is(sp2, 2, "id") {
                                        let eid: i32 = parse_dec(vp, vn, &okn)
                                        if okn { rt.st32((*v).pscr, 44, (eid + 1) as u32) } else { rt.st32((*v).pscr, 42, 99 as u32) }
                                    } else if sn2 == 5 && line_is(sp2, 5, "level") {
                                        let lv2: i32 = parse_dec(vp, vn, &okn)
                                        let pe: i32 = ps_n(v, 44) - 1
                                        if okn && pe >= 0 { ps_ench(v, pe, lv2) } else { rt.st32((*v).pscr, 42, 99 as u32) }
                                    }
                                }
                            }
                        }
                        if rn == 4 && line_is(rp, 4, "type") {
                            comp_type = parse_dec(vp, vn, &okn)
                            if !okn { comp_type = 0 - 1 }
                            if comp_type >= 0 { ps_on_type(v, (*ver).protocol, comp_type) }
                        } else if comp_type == COMP_MAX_STACK && rn == 4 && line_is(rp, 4, "data") {
                            let m: i32 = parse_dec(vp, vn, &okn)
                            if okn && m > 0 && m <= 99 { acc_mx = m }
                        } else if comp_type == ect && (*v).eff_id >= 0 && rn > 19 && line_is(rp, 19, "data.enchantments[") {
                            var t: usize = 18
                            while t < rn && rt.ld8(rp, t) != 93 as u8 { t = t + 1 }
                            if t + 1 < rn && rt.ld8(rp, t + 1) == 46 as u8 {
                                let sp: u64 = rp + ((t + 2) as u64)
                                let sn: usize = rn - t - 2
                                if sn == 2 && line_is(sp, 2, "id") {
                                    ench_cur = parse_dec(vp, vn, &okn)
                                    if !okn { ench_cur = 0 - 1 }
                                } else if sn == 5 && line_is(sp, 5, "level") && ench_cur == (*v).eff_id {
                                    let lv: i32 = parse_dec(vp, vn, &okn)
                                    if okn { inv_set_eff(v, tgt, lv) }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    if acc_tgt != 0 - 1 { flush_extra(v, (*ver).protocol, acc_tgt, acc_h, acc_n, acc_mx) }
    rt.buf_free(&out)
    if !good || !n_win_ok { return false }
    (*v).n_srv = (*v).n_srv + 1 as u32
    return true
}

fn sem_kind(sem: usize) -> i32 {
    if sem == mc_sem.SEM_PLAY_S2C_WINDOW_ITEMS { return 0 }
    if sem == mc_sem.SEM_PLAY_S2C_SET_SLOT { return 1 }
    return 2
}

// Window Items of window 0, any supported version (hand reader up to 1.20.4, packet schema from 1.20.5)
fn inv_on_window_items_v(v: *mut Inv, ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let f: i32 = inv_slot_format((*ver).protocol)
    if f == 1 { return inv_on_window_items(v, (*ver).protocol, b) }
    if f == 2 { return apply_components(v, ver, mc_sem.SEM_PLAY_S2C_WINDOW_ITEMS, b) }
    return false
}

// Set Cursor Item (1.21.2+): the carried stack
fn inv_on_set_cursor_v(v: *mut Inv, ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    if inv_slot_format((*ver).protocol) != 2 { return false }
    return apply_components(v, ver, mc_sem.SEM_PLAY_S2C_SET_CURSOR_ITEM, b)
}

fn inv_on_set_slot_v(v: *mut Inv, ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let f: i32 = inv_slot_format((*ver).protocol)
    if f == 1 { return inv_on_set_slot(v, (*ver).protocol, b) }
    if f == 2 { return apply_components(v, ver, mc_sem.SEM_PLAY_S2C_SET_SLOT, b) }
    return false
}

// Set Creative Slot: i16 slot + slot value (no NBT / no components; 1.20.5+: count, item, 0 added, 0 removed)
fn inv_send_creative(cl: *mut mc_client.Client, slot: i32, item: i32, count: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_i16(&b, slot as i16)
    let comp: bool = inv_slot_format((*cl).ver.protocol) == 2
    if item < 0 || count <= 0 {
        if comp { bytes.put_varint(&b, 0) } else { bytes.put_bool(&b, false) }
    } else if comp {
        bytes.put_varint(&b, count)
        bytes.put_varint(&b, item)
        bytes.put_varint(&b, 0)
        bytes.put_varint(&b, 0)
    } else {
        bytes.put_bool(&b, true)
        bytes.put_varint(&b, item)
        bytes.put_i8(&b, count as i8)
        bytes.put_u8(&b, 0 as u8)
    }
    let ok: bool = mc_client.client_send(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_SET_CREATIVE_SLOT, &b)
    bytes.bytes_free(&b)
    return ok
}

// ---- Click Container (window 0) ---------------------------------------------------------------------------------------

// slot encoding of the click packets: 0 = none (no slot layout), 1 = "present bool, item, i8 count, NBT" (1.13.2 .. 1.20.4),
// 2 = data components (1.20.5 .. 1.21.4), 3 = hashed stacks "option(item, count, added hashes, removed ids)" (1.21.5+, protocol 770+)
fn inv_click_kind(protocol: i32) -> i32 {
    let f: i32 = inv_slot_format(protocol)
    if f == 1 { return 1 }
    if f == 2 && protocol >= 770 { return 3 }
    if f == 2 { return 2 }
    return 0
}

fn put_click_slot(v: *mut Inv, b: *mut bytes.Bytes, kind: i32, item: i32, count: i32, sig: i32) {
    let empty: bool = item < 0 || count <= 0
    if kind == 1 {
        if empty { bytes.put_bool(b, false); return }
        bytes.put_bool(b, true)
        bytes.put_varint(b, item)
        bytes.put_i8(b, count as i8)
        bytes.put_u8(b, 0 as u8)
    } else if kind == 2 {
        if empty { bytes.put_varint(b, 0); return }
        bytes.put_varint(b, count)
        bytes.put_varint(b, item)
        bytes.put_varint(b, 0)
        bytes.put_varint(b, 0)
    } else {
        // hashed stack (1.21.5+): item, count and the CRC32C of every component of the stack's patch (inv_patch_of)
        var h: mc_hash.HStack = mc_hash.hstack_empty()
        h.present = !empty
        h.item = item
        h.count = count
        if !empty { inv_patch_of(v, sig, &h) }
        mc_hash.hstack_put(b, &h)
    }
}

// one stack as plain values: item (-1 = empty), count, Efficiency level, component signature, max_stack_size component
struct Stk {
    item: i32,
    count: i32,
    eff: i32,
    sig: i32,
    mx: i32,
}

fn stack_max(v: *mut Inv, s: *mut Stk) -> i32 {
    if (*s).mx > 0 { return (*s).mx }
    if (*v).reg == 0 { return 64 }
    let m: i32 = mc_registry.reg_item_stack((*v).reg as *mut mc_registry.Registry, (*s).item)
    if m <= 0 { return 64 }
    return m
}

// stack at `slot` (SLOT_CUR = carried)
fn load(v: *mut Inv, slot: i32, o: *mut Stk) {
    if slot == SLOT_CUR {
        (*o).item = (*v).cur_id
        (*o).count = (*v).cur_count
        (*o).eff = (*v).cur_eff
        (*o).sig = (*v).cur_sig
        (*o).mx = (*v).cur_max
        return
    }
    (*o).item = inv_item(v, slot)
    (*o).count = inv_count(v, slot)
    (*o).eff = inv_eff(v, slot)
    (*o).sig = inv_sig(v, slot)
    (*o).mx = inv_max_stack(v, slot)
}

fn store(v: *mut Inv, slot: i32, s: *mut Stk) {
    put_slot_e(v, slot, (*s).item, (*s).count, (*s).eff)
    if (*s).item >= 0 && (*s).count > 0 { set_extra(v, slot, (*s).sig, (*s).mx) }
}

// the same stack with another count (an emptied stack stays empty)
fn stk_n(s: *mut Stk, n: i32, o: *mut Stk) {
    (*o).item = (*s).item
    (*o).count = n
    (*o).eff = (*s).eff
    (*o).sig = (*s).sig
    (*o).mx = (*s).mx
}

fn stk_empty(o: *mut Stk) {
    (*o).item = 0 - 1
    (*o).count = 0
    (*o).eff = 0
    (*o).sig = 0
    (*o).mx = 0
}

fn stk_new() -> Stk { return Stk { item: 0 - 1, count: 0, eff: 0, sig: 0, mx: 0 } }

// ---- helpers of the shift click / double click / drag prediction (vanilla InventoryMenu + AbstractContainerMenu) ----

fn name_ends(p: u64, n: usize, lit: str) -> bool {
    if n < lit.n { return false }
    var i: usize = 0
    while i < lit.n {
        if rt.ld8(p, n - lit.n + i) != rt.ld8(lit.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

// the inventory slot an item can be worn in: 5 helmet, 6 chest (also elytra), 7 leggings, 8 boots, 45 off hand (shield), 0 = none.
// Judged by the registry name (no equippable data in the registry); without a registry nothing is armour.
fn equip_slot(v: *mut Inv, item: i32) -> i32 {
    if (*v).reg == 0 || item < 0 { return 0 }
    var n: usize = 0
    let p: u64 = mc_registry.reg_item_name((*v).reg as *mut mc_registry.Registry, item, &n)
    if p == 0 || n == 0 { return 0 }
    if name_ends(p, n, "_helmet") || name_ends(p, n, "carved_pumpkin") || name_ends(p, n, "_head") || name_ends(p, n, "_skull") { return 5 }
    if name_ends(p, n, "_chestplate") || name_ends(p, n, "elytra") { return 6 }
    if name_ends(p, n, "_leggings") { return 7 }
    if name_ends(p, n, "_boots") { return 8 }
    if name_ends(p, n, "shield") { return 45 }
    return 0
}

// Slot.mayPlace: the result slot takes nothing, an armour slot only its armour piece
fn may_place(v: *mut Inv, slot: i32, s: *mut Stk) -> bool {
    if slot == 0 { return false }
    if slot >= 5 && slot <= 8 { return equip_slot(v, (*s).item) == slot }
    return true
}

fn same_stack(a: *mut Stk, b: *mut Stk) -> bool {
    return (*a).item >= 0 && (*a).count > 0 && (*b).item >= 0 && (*b).count > 0 && (*a).item == (*b).item && (*a).eff == (*b).eff && (*a).sig == (*b).sig
}

// AbstractContainerMenu.moveItemStackTo on the working copy `src` over the slots [start, end): first merge into equal stacks, then fill the
// first empty slot. `src` keeps the remainder. true = something moved.
fn move_to(v: *mut Inv, src: *mut Stk, start: i32, end: i32, reverse: bool) -> bool {
    var moved: bool = false
    var t: Stk = stk_new()
    var sl: Stk = stk_new()
    let smax: i32 = stack_max(v, src)
    if smax > 1 {
        var k: i32 = start
        if reverse { k = end - 1 }
        while (*src).count > 0 && k >= start && k < end {
            load(v, k, &sl)
            if same_stack(&sl, src) {
                let total: i32 = sl.count + (*src).count
                if total <= smax {
                    (*src).count = 0
                    stk_n(&sl, total, &t)
                    store(v, k, &t)
                    moved = true
                } else if sl.count < smax {
                    (*src).count = (*src).count - (smax - sl.count)
                    stk_n(&sl, smax, &t)
                    store(v, k, &t)
                    moved = true
                }
            }
            if reverse { k = k - 1 } else { k = k + 1 }
        }
    }
    if (*src).count > 0 {
        var k2: i32 = start
        if reverse { k2 = end - 1 }
        while k2 >= start && k2 < end {
            load(v, k2, &sl)
            if (sl.item < 0 || sl.count <= 0) && may_place(v, k2, src) {
                store(v, k2, src)
                (*src).count = 0
                moved = true
                break
            }
            if reverse { k2 = k2 - 1 } else { k2 = k2 + 1 }
        }
    }
    return moved
}

// InventoryMenu.quickMoveStack of `index`: `ret` = copy of the stack before the move (item -1 = nothing moved). false = not predictable (result slot).
fn quick_move(v: *mut Inv, index: i32, ret: *mut Stk) -> bool {
    stk_empty(ret)
    if index == 0 { return false }
    var orig: Stk = stk_new()
    load(v, index, &orig)
    if orig.item < 0 || orig.count <= 0 { return true }
    var w: Stk = stk_new()
    stk_n(&orig, orig.count, &w)
    var moved: bool = false
    if (*v).win != 0 && (*v).win_n > 0 {
        // ChestMenu / HopperMenu / DispenserMenu.quickMoveStack: container -> player (main + hotbar, from the back), player -> container
        if index >= CONT0 { moved = move_to(v, &w, 9, 45, true) } else { moved = move_to(v, &w, CONT0, CONT0 + (*v).win_n, false) }
    } else if index < 9 {
        moved = move_to(v, &w, 9, 45, false)
    } else {
        let eq: i32 = equip_slot(v, orig.item)
        if eq >= 5 && eq <= 8 && inv_item(v, eq) < 0 {
            moved = move_to(v, &w, eq, eq + 1, false)
        } else if eq == 45 && inv_item(v, 45) < 0 {
            moved = move_to(v, &w, 45, 46, false)
        } else if index < 36 {
            moved = move_to(v, &w, 36, 45, false)
        } else if index < 45 {
            moved = move_to(v, &w, 9, 36, false)
        } else {
            moved = move_to(v, &w, 9, 45, false)
        }
    }
    if !moved { return true }
    if w.count <= 0 { put_slot(v, index, 0 - 1, 0) } else { store(v, index, &w) }
    if w.count != orig.count { stk_n(&orig, orig.count, ret) }
    return true
}

// ClickType.QUICK_MOVE: quickMoveStack repeated while the slot still holds the moved item. `lg` = what a legacy (<= 1.16.5) client reports as
// the clicked stack: the copy of the last move made while the slot still held the item (empty when the slot was emptied).
fn shift_click(v: *mut Inv, slot: i32, lg: *mut Stk) -> bool {
    stk_empty(lg)
    if slot <= 0 { return false }
    var r: Stk = stk_new()
    var sl: Stk = stk_new()
    if !quick_move(v, slot, &r) { return false }
    var guard: i32 = 0
    while r.item >= 0 && r.count > 0 && guard < 64 {
        load(v, slot, &sl)
        if !(sl.item >= 0 && sl.count > 0 && sl.item == r.item) { break }
        stk_n(&r, r.count, lg)
        quick_move(v, slot, &r)
        guard = guard + 1
    }
    return true
}

// ClickType.PICKUP_ALL (double click): with a carried stack and a clicked slot that is empty, collect equal stacks from all slots
// (two passes: not-full stacks first, then full ones). Left button walks the slots up, right button down. The result slot is skipped.
fn pickup_all(v: *mut Inv, slot: i32, button: i32) -> bool {
    if !in_win(v, slot) { return false }
    var cu: Stk = stk_new()
    var sl: Stk = stk_new()
    var t: Stk = stk_new()
    load(v, SLOT_CUR, &cu)
    load(v, slot, &sl)
    if cu.item < 0 || cu.count <= 0 { return true }
    if sl.item >= 0 && sl.count > 0 { return true }
    let cmax: i32 = stack_max(v, &cu)
    let wsz: i32 = inv_window_size(v)
    var first: i32 = 0
    var step: i32 = 1
    if button != 0 { first = wsz - 1; step = 0 - 1 }
    var pass: i32 = 0
    while pass < 2 {
        var wsn: i32 = first
        while wsn >= 0 && wsn < wsz && cu.count < cmax {
            let m: i32 = inv_win_to_int(v, wsn)
            if m != 0 && m >= 0 {
                load(v, m, &sl)
                if same_stack(&sl, &cu) && sl.count <= cmax {
                    if !(pass == 0 && sl.count == stack_max(v, &sl)) {
                        var take: i32 = cmax - cu.count
                        if sl.count < take { take = sl.count }
                        stk_n(&sl, sl.count - take, &t)
                        if t.count <= 0 { put_slot(v, m, 0 - 1, 0) } else { store(v, m, &t) }
                        cu.count = cu.count + take
                    }
                }
            }
            wsn = wsn + step
        }
        pass = pass + 1
    }
    store(v, SLOT_CUR, &cu)
    return true
}

fn qc_reset(v: *mut Inv) {
    (*v).qc_status = 0
    (*v).qc_mask = 0 as u64
    (*v).qc_hi = 0 as u64
}

fn mask_has(v: *mut Inv, k: i32) -> bool {
    if k < 0 || k >= 128 { return false }
    if k < 64 { return (((*v).qc_mask >> (k as u64)) & 1 as u64) != 0 as u64 }
    return (((*v).qc_hi >> ((k - 64) as u64)) & 1 as u64) != 0 as u64
}

fn mask_set(v: *mut Inv, k: i32) {
    if k < 0 || k >= 128 { return }
    if k < 64 { (*v).qc_mask = (*v).qc_mask | ((1 as u64) << (k as u64)) } else { (*v).qc_hi = (*v).qc_hi | ((1 as u64) << ((k - 64) as u64)) }
}

fn mask_count(v: *mut Inv) -> i32 {
    var n: i32 = 0
    var k: i32 = 0
    while k < nint(v) {
        if mask_has(v, k) { n = n + 1 }
        k = k + 1
    }
    return n
}

fn inv_set_creative(v: *mut Inv, on: bool) { (*v).creative = on }

// ClickType.QUICKCRAFT (drag): button = status | type << 2; status 0 = start (slot -999), 1 = add a slot, 2 = end (slot -999); type 0 = split evenly
// (left button), 1 = one each (right button), 2 = clone (creative). Distribution happens at the end packet only.
fn drag(v: *mut Inv, slot: i32, button: i32) -> bool {
    let status: i32 = button & 3
    let typ: i32 = (button >> 2) & 3
    let prev: i32 = (*v).qc_status
    (*v).qc_status = status
    var cu: Stk = stk_new()
    load(v, SLOT_CUR, &cu)
    if (prev != 1 || status != 2) && prev != status { qc_reset(v); return true }
    if cu.item < 0 || cu.count <= 0 { qc_reset(v); return true }
    if status == 0 {
        (*v).qc_type = typ
        if typ == 0 || typ == 1 || (typ == 2 && (*v).creative) {
            (*v).qc_status = 1
            (*v).qc_mask = 0 as u64
            (*v).qc_hi = 0 as u64
        } else { qc_reset(v) }
        return true
    }
    if status == 1 {
        if !in_win(v, slot) { return true }
        var sl: Stk = stk_new()
        load(v, slot, &sl)
        let free: bool = sl.item < 0 || sl.count <= 0
        let eqv: bool = same_stack(&sl, &cu) && sl.count <= stack_max(v, &cu)
        if (free || eqv) && may_place(v, slot, &cu) && ((*v).qc_type == 2 || cu.count > mask_count(v)) {
            mask_set(v, slot)
        }
        return true
    }
    if status == 2 {
        let ty: i32 = (*v).qc_type
        let n: i32 = mask_count(v)
        if n == 1 {
            var only: i32 = 0 - 1
            var k: i32 = 0
            while k < nint(v) { if mask_has(v, k) { only = k }; k = k + 1 }
            qc_reset(v)
            var lg0: Stk = stk_new()
            if ty == 0 || ty == 1 { return predict(v, only, ty, 0, &lg0) != 0 }
            return true
        }
        if n > 1 {
            let omax: i32 = stack_max(v, &cu)
            var left: i32 = cu.count
            var sl2: Stk = stk_new()
            var t: Stk = stk_new()
            var k2: i32 = 0
            while k2 < nint(v) {
                if mask_has(v, k2) {
                    load(v, k2, &sl2)
                    let free2: bool = sl2.item < 0 || sl2.count <= 0
                    let eq2: bool = same_stack(&sl2, &cu) && sl2.count <= omax
                    if (free2 || eq2) && may_place(v, k2, &cu) && (ty == 2 || cu.count >= n) {
                        var have: i32 = 0
                        if !free2 { have = sl2.count }
                        var per: i32 = 1
                        if ty == 0 { per = cu.count / n }
                        if ty == 2 { per = omax }
                        var put: i32 = per + have
                        if put > omax { put = omax }
                        left = left - (put - have)
                        stk_n(&cu, put, &t)
                        store(v, k2, &t)
                    }
                }
                k2 = k2 + 1
            }
            stk_n(&cu, left, &t)
            if left <= 0 { stk_empty(&t) }
            store(v, SLOT_CUR, &t)
        }
        qc_reset(v)
        return true
    }
    qc_reset(v)
    return true
}

// Applies one click to the local inventory (vanilla ClickType PICKUP / QUICK_MOVE / SWAP / QUICKCRAFT / THROW / PICKUP_ALL).
// Stacks merge only when item, Efficiency and the whole component list agree (vanilla isSameItemSameComponents); the limit is the
// max_stack_size component when the stack has one.
// Returns 0 = not predicted (crafting result, unknown mode): nothing is changed; 1 = predicted, a legacy packet reports the slot as it was;
// 2 = predicted, a legacy packet reports `lg` (shift click: the moved copy, double click / drag: nothing).
fn predict(v: *mut Inv, slot: i32, button: i32, mode: i32, lg: *mut Stk) -> i32 {
    stk_empty(lg)
    var cu: Stk = stk_new()
    var t: Stk = stk_new()
    var t2: Stk = stk_new()
    if mode == 5 {
        if drag(v, slot, button) { return 2 }
        return 0
    }
    // any other click ends a drag in progress
    if (*v).qc_status != 0 { qc_reset(v); return 2 }
    load(v, SLOT_CUR, &cu)
    if (mode == 0 || mode == 1) && (button == 0 || button == 1) && slot == CLICK_OUTSIDE {
        if cu.item < 0 { return 1 }
        if button == 0 { stk_empty(&t) } else { stk_n(&cu, cu.count - 1, &t) }
        store(v, SLOT_CUR, &t)
        return 1
    }
    if mode == 6 {
        if pickup_all(v, slot, button) { return 2 }
        return 0
    }
    if slot <= 0 || !in_win(v, slot) { return 0 }
    var sl: Stk = stk_new()
    load(v, slot, &sl)
    if mode == 1 && (button == 0 || button == 1) {
        if shift_click(v, slot, lg) { return 2 }
        return 0
    }
    if mode == 0 && (button == 0 || button == 1) {
        if cu.item < 0 && sl.item < 0 { return 1 }
        if cu.item >= 0 && sl.item >= 0 && cu.item == sl.item && cu.eff == sl.eff && cu.sig == sl.sig {
            let mx: i32 = stack_max(v, &sl)
            var mv: i32 = cu.count
            if button == 1 { mv = 1 }
            if sl.count + mv > mx { mv = mx - sl.count }
            if mv <= 0 { return 1 }
            stk_n(&sl, sl.count + mv, &t)
            store(v, slot, &t)
            stk_n(&cu, cu.count - mv, &t2)
            store(v, SLOT_CUR, &t2)
            return 1
        }
        if button == 0 || (cu.item >= 0 && sl.item >= 0) {
            // swap (left click: also move whole stacks to / from an empty side)
            store(v, slot, &cu)
            store(v, SLOT_CUR, &sl)
            return 1
        }
        if cu.item < 0 {
            // right click on a stack with an empty hand: take half (rounded up)
            let take: i32 = (sl.count + 1) / 2
            stk_n(&sl, take, &t)
            store(v, SLOT_CUR, &t)
            stk_n(&sl, sl.count - take, &t2)
            store(v, slot, &t2)
            return 1
        }
        // right click with a stack on an empty slot: put one
        stk_n(&cu, 1, &t)
        store(v, slot, &t)
        stk_n(&cu, cu.count - 1, &t2)
        store(v, SLOT_CUR, &t2)
        return 1
    }
    if mode == 2 {
        var other: i32 = 0 - 1
        if button >= 0 && button <= 8 { other = INV_HOTBAR0 + button }
        if button == 40 { other = 45 }
        if other < 0 || other == slot { return 0 }
        load(v, other, &t)
        store(v, slot, &t)
        store(v, other, &sl)
        return 1
    }
    if mode == 4 && (button == 0 || button == 1) {
        if cu.item >= 0 || sl.item < 0 { return 1 }
        if button == 1 { stk_empty(&t) } else { stk_n(&sl, sl.count - 1, &t) }
        store(v, slot, &t)
        return 1
    }
    return 0
}

// Builds the Click Container body for window 0 (with the predicted result) and applies the prediction to the local inventory.
// The changed-slot list is the difference between the slots before and after the click (like the vanilla client).
// false = this protocol has no slot layout (nothing built, nothing changed).
fn inv_click_build(v: *mut Inv, protocol: i32, slot: i32, button: i32, mode: i32, b: *mut bytes.Bytes) -> bool {
    let kind: i32 = inv_click_kind(protocol)
    if kind == 0 { return false }
    // the stack the client believes is in the slot (legacy packets carry it)
    if (*v).win != 0 && (*v).win_n <= 0 { return false } // a window we cannot model: do not send blind clicks
    let wslot: i32 = slot // the number in the packet
    var islot: i32 = slot // the internal slot of the prediction
    if (*v).win != 0 && slot >= 0 { islot = inv_win_to_int(v, slot) }
    var ps: Stk = stk_new()
    if islot >= 0 { load(v, islot, &ps) }
    var pi: i32 = ps.item
    var pc: i32 = ps.count
    // snapshot of all slots (item, count, Efficiency, signature) to find the changed ones afterwards
    let snap: u64 = rt.heap_alloc(INV_CAP * 16)
    var q: usize = 0
    while q < INV_CAP {
        rt.st32(snap, q * 4, (inv_item(v, q as i32) + 1) as u32)
        rt.st32(snap, q * 4 + 1, inv_count(v, q as i32) as u32)
        rt.st32(snap, q * 4 + 2, inv_eff(v, q as i32) as u32)
        rt.st32(snap, q * 4 + 3, inv_sig(v, q as i32) as u32)
        q = q + 1
    }
    var lg: Stk = stk_new()
    let pred: i32 = predict(v, islot, button, mode, &lg)
    if pred == 2 {
        pi = lg.item
        pc = lg.count
    }
    if protocol < 756 {
        bytes.put_u8(b, (*v).win as u8)
        bytes.put_i16(b, wslot as i16)
        bytes.put_i8(b, button as i8)
        bytes.put_i16(b, (*v).action as i16)
        (*v).action = (*v).action + 1
        bytes.put_i8(b, mode as i8)
        put_click_slot(v, b, kind, pi, pc, 0)
    } else {
        if protocol >= 768 { bytes.put_varint(b, (*v).win) } else { bytes.put_u8(b, (*v).win as u8) }
        bytes.put_varint(b, (*v).state_id)
        bytes.put_i16(b, wslot as i16)
        bytes.put_i8(b, button as i8)
        bytes.put_varint(b, mode)
        let wsz: i32 = inv_window_size(v)
        var n: i32 = 0
        var ws: i32 = 0
        while ws < wsz {
            let ki: i32 = inv_win_to_int(v, ws)
            if pred != 0 && ki >= 0 && slot_changed(v, snap, ki as usize) { n = n + 1 }
            ws = ws + 1
        }
        bytes.put_varint(b, n)
        ws = 0
        while ws < wsz {
            let ki2: i32 = inv_win_to_int(v, ws)
            if pred != 0 && ki2 >= 0 && slot_changed(v, snap, ki2 as usize) { bytes.put_i16(b, ws as i16); put_click_slot(v, b, kind, inv_item(v, ki2), inv_count(v, ki2), inv_sig(v, ki2)) }
            ws = ws + 1
        }
        put_click_slot(v, b, kind, (*v).cur_id, (*v).cur_count, (*v).cur_sig)
    }
    rt.heap_free(snap, INV_CAP * 16)
    return true
}

fn slot_changed(v: *mut Inv, snap: u64, k: usize) -> bool {
    return (rt.ld32(snap, k * 4) as i32) - 1 != inv_item(v, k as i32) || rt.ld32(snap, k * 4 + 1) as i32 != inv_count(v, k as i32)
    || rt.ld32(snap, k * 4 + 2) as i32 != inv_eff(v, k as i32) || rt.ld32(snap, k * 4 + 3) as i32 != inv_sig(v, k as i32)
}

// Click Container for window 0: builds the packet (see inv_click_build), sends it, counts it.
fn inv_click(cl: *mut mc_client.Client, v: *mut Inv, slot: i32, button: i32, mode: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    if !inv_click_build(v, (*cl).ver.protocol, slot, button, mode, &b) {
        bytes.bytes_free(&b)
        return false
    }
    let ok: bool = mc_client.client_send(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK, &b)
    bytes.bytes_free(&b)
    if ok { (*v).n_clicks = (*v).n_clicks + 1 as u32 }
    return ok
}

// Drag (mode 5) over several slots: begin (slot -999), add each slot, end (slot -999). type 0 = split the carried stack evenly (left button),
// 1 = one item each (right button). The distribution is predicted at the end packet like the server does it.
fn inv_drag_begin(cl: *mut mc_client.Client, v: *mut Inv, typ: i32) -> bool { return inv_click(cl, v, CLICK_OUTSIDE, typ * 4, 5) }
fn inv_drag_add(cl: *mut mc_client.Client, v: *mut Inv, slot: i32, typ: i32) -> bool { return inv_click(cl, v, slot, 1 + typ * 4, 5) }
fn inv_drag_end(cl: *mut mc_client.Client, v: *mut Inv, typ: i32) -> bool { return inv_click(cl, v, CLICK_OUTSIDE, 2 + typ * 4, 5) }

fn inv_drop_slot(cl: *mut mc_client.Client, v: *mut Inv, slot: i32, all: bool) -> bool {
    var btn: i32 = 0
    if all { btn = 1 }
    return inv_click(cl, v, slot, btn, 4)
}

// local part of the Drop Item player action (status 4 = one, 3 = the whole stack) on a hotbar / inventory slot
fn inv_local_drop(v: *mut Inv, slot: i32, all: bool) -> bool {
    let it: i32 = inv_item(v, slot)
    let c: i32 = inv_count(v, slot)
    if it < 0 || c <= 0 { return false }
    let e: i32 = inv_eff(v, slot)
    if all { put_slot(v, slot, 0 - 1, 0) } else { put_slot_e(v, slot, it, c - 1, e) }
    return true
}
