// SPDX-License-Identifier: MPL-2.0
import std.bytes

export {
    CrackAnims, crack_anims_new, crack_anims_on_packet, crack_anims_expire, crack_anims_count, crack_anims_at, crack_anims_clear,
    CRACK_ANIM_MAX, CRACK_ANIM_TTL_MS,
}

const CRACK_ANIM_MAX: usize = 32
const CRACK_ANIM_TTL_MS: u64 = 20000

struct CrackAnims {
    used: [bool; 32],
    eid: [i32; 32],
    x: [i32; 32],
    y: [i32; 32],
    z: [i32; 32],
    stage: [i32; 32],
    t: [u64; 32],
    updates: u64,
    clears: u64,
    bad: u64,
}

fn crack_anims_new() -> CrackAnims {
    return CrackAnims {
        used: [false; 32], eid: [0; 32], x: [0; 32], y: [0; 32], z: [0; 32], stage: [0; 32], t: [0 as u64; 32],
        updates: 0 as u64, clears: 0 as u64, bad: 0 as u64,
    }
}

fn crack_anims_clear(a: *mut CrackAnims) {
    var i: usize = 0
    while i < CRACK_ANIM_MAX {
        (*a).used[i] = false
        i = i + 1
    }
}

fn find_eid(a: *mut CrackAnims, eid: i32) -> i32 {
    var i: usize = 0
    while i < CRACK_ANIM_MAX {
        if (*a).used[i] && (*a).eid[i] == eid { return i as i32 }
        i = i + 1
    }
    return 0 - 1
}

fn find_free(a: *mut CrackAnims) -> i32 {
    var i: usize = 0
    var oldest: usize = 0
    while i < CRACK_ANIM_MAX {
        if !(*a).used[i] { return i as i32 }
        if (*a).t[i] < (*a).t[oldest] { oldest = i }
        i = i + 1
    }
    return oldest as i32
}

fn crack_anims_on_packet(a: *mut CrackAnims, b: *mut bytes.Bytes, now: u64) -> bool {
    let eid: i32 = bytes.get_varint(b) catch (0 - 1)
    var x: i32 = 0
    var y: i32 = 0
    var z: i32 = 0
    let okp: bool = bytes.get_position(b, &x, &y, &z) catch false
    let st: i32 = (bytes.get_i8(b) catch ((0 - 100) as i8)) as i32
    if !okp || st == 0 - 100 {
        (*a).bad = (*a).bad + 1 as u64
        return false
    }
    var slot: i32 = find_eid(a, eid)
    if st < 0 || st > 9 {
        if slot >= 0 { (*a).used[slot as usize] = false }
        (*a).clears = (*a).clears + 1 as u64
        return true
    }
    if slot < 0 { slot = find_free(a) }
    let s: usize = slot as usize
    (*a).used[s] = true
    (*a).eid[s] = eid
    (*a).x[s] = x
    (*a).y[s] = y
    (*a).z[s] = z
    (*a).stage[s] = st
    (*a).t[s] = now
    (*a).updates = (*a).updates + 1 as u64
    return true
}

fn crack_anims_expire(a: *mut CrackAnims, now: u64) {
    var i: usize = 0
    while i < CRACK_ANIM_MAX {
        if (*a).used[i] && now - (*a).t[i] > CRACK_ANIM_TTL_MS { (*a).used[i] = false }
        i = i + 1
    }
}

fn crack_anims_count(a: *mut CrackAnims) -> i32 {
    var n: i32 = 0
    var i: usize = 0
    while i < CRACK_ANIM_MAX {
        if (*a).used[i] { n = n + 1 }
        i = i + 1
    }
    return n
}

fn crack_anims_at(a: *mut CrackAnims, k: i32, x: *mut i32, y: *mut i32, z: *mut i32, stage: *mut i32) -> bool {
    var n: i32 = 0
    var i: usize = 0
    while i < CRACK_ANIM_MAX {
        if (*a).used[i] {
            if n == k {
                *x = (*a).x[i]
                *y = (*a).y[i]
                *z = (*a).z[i]
                *stage = (*a).stage[i]
                return true
            }
            n = n + 1
        }
        i = i + 1
    }
    return false
}
