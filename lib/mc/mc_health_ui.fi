import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_health
import input.raw

export { health_ui_draw, health_ui_keys, HEART_FULL, HEART_COLOR, FOOD_COLOR, EMPTY_COLOR, DEATH_TINT }

const SC_R: u32 = 19
const SC_SPACE: u32 = 57
const SC_KP_ENTER: u32 = 96
const ICON: i32 = 9
const STEP: i32 = 8
const ICONS: i32 = 10
const HEART_COLOR: u32 = 0xFF2B2BE0
const HEART_FULL: u32 = 0xFF2B2BE0
const FOOD_COLOR: u32 = 0xFF2D6BB5
const BONE_COLOR: u32 = 0xFFD8E0E0
const EMPTY_COLOR: u32 = 0xFF303030
const OUTLINE: u32 = 0xFF000000
const SHINE: u32 = 0xFFC8C8FF
const DEATH_TINT: u32 = 0x780000A0
const TITLE_COLOR: u32 = 0xFFFFFFFF
const MSG_COLOR: u32 = 0xFFE0E0E0
const HINT_COLOR: u32 = 0xFFAAAAAA
const SHADOW: u32 = 0xFF3F3F3F

const KIND_HEART: i32 = 0
const KIND_FOOD: i32 = 1
const STATE_EMPTY: i32 = 0
const STATE_HALF: i32 = 1
const STATE_FULL: i32 = 2

fn heart_row(i: i32) -> u32 {
    if i == 0 { return 0xC6 as u32 }
    if i == 1 { return 0x1EF as u32 }
    if i >= 2 && i <= 4 { return 0x1FF as u32 }
    if i == 5 { return 0xFE as u32 }
    if i == 6 { return 0x7C as u32 }
    if i == 7 { return 0x38 as u32 }
    if i == 8 { return 0x10 as u32 }
    return 0 as u32
}

fn food_row(i: i32) -> u32 {
    if i == 0 { return 0x0E as u32 }
    if i == 1 { return 0x1F as u32 }
    if i == 2 { return 0x3F as u32 }
    if i == 3 { return 0x7E as u32 }
    if i == 4 { return 0xFC as u32 }
    if i == 5 { return 0xF0 as u32 }
    if i == 6 { return 0x1B0 as u32 }
    if i == 7 { return 0x180 as u32 }
    return 0 as u32
}

fn row_of(kind: i32, i: i32) -> u32 {
    if kind == KIND_HEART { return heart_row(i) }
    return food_row(i)
}

fn col_mask(c0: i32, c1: i32) -> u32 {
    var m: u32 = 0 as u32
    var c: i32 = c0
    while c < c1 {
        m = m | (1 as u32 << ((ICON - 1 - c) as u32))
        c = c + 1
    }
    return m
}

fn runs(r: *mut mc_raster.Raster, x: i32, y: i32, s: i32, row: u32, grow: bool, color: u32) {
    var c: i32 = 0
    while c < ICON {
        if (row & (1 as u32 << ((ICON - 1 - c) as u32))) != 0 as u32 {
            var e: i32 = c
            while e + 1 < ICON && (row & (1 as u32 << ((ICON - 2 - e) as u32))) != 0 as u32 { e = e + 1 }
            let w: i32 = e - c + 1
            if grow {
                mc_hud.hud_rect(r, x + (c - 1) * s, y, (w + 2) * s, s, color)
                mc_hud.hud_rect(r, x + c * s, y - s, w * s, 3 * s, color)
            } else {
                mc_hud.hud_rect(r, x + c * s, y, w * s, s, color)
            }
            c = e + 1
        } else {
            c = c + 1
        }
    }
}

fn outline(r: *mut mc_raster.Raster, x: i32, y: i32, s: i32, kind: i32) {
    var i: i32 = 0
    while i < ICON {
        runs(r, x, y + i * s, s, row_of(kind, i), true, OUTLINE)
        i = i + 1
    }
}

fn fill(r: *mut mc_raster.Raster, x: i32, y: i32, s: i32, kind: i32, state: i32) {
    var main: u32 = HEART_COLOR
    if kind == KIND_FOOD { main = FOOD_COLOR }
    var live: u32 = col_mask(0, ICON)
    if state == STATE_HALF {
        if kind == KIND_HEART { live = col_mask(0, 5) } else { live = col_mask(4, ICON) }
    }
    var i: i32 = 0
    while i < ICON {
        let row: u32 = row_of(kind, i)
        runs(r, x, y + i * s, s, row, false, EMPTY_COLOR)
        if state != STATE_EMPTY {
            var col: u32 = main
            if kind == KIND_FOOD && i >= 6 { col = BONE_COLOR }
            runs(r, x, y + i * s, s, row & live, false, col)
        }
        i = i + 1
    }
    if kind == KIND_HEART && state != STATE_EMPTY {
        mc_hud.hud_rect(r, x + s, y + 2 * s, s, s, SHINE)
    }
}

fn state_of(value: i32, i: i32) -> i32 {
    if value >= 2 * (i + 1) { return STATE_FULL }
    if value == 2 * i + 1 { return STATE_HALF }
    return STATE_EMPTY
}

fn bar(r: *mut mc_raster.Raster, s: i32, kind: i32, value: i32, x0: i32, y: i32, dir: i32) {
    var pass: i32 = 0
    while pass < 2 {
        var i: i32 = 0
        while i < ICONS {
            var x: i32 = x0 + i * STEP * s
            if dir < 0 { x = x0 - ICON * s - i * STEP * s }
            if pass == 0 { outline(r, x, y, s, kind) } else { fill(r, x, y, s, kind, state_of(value, i)) }
            i = i + 1
        }
        pass = pass + 1
    }
}

fn draw_centered(r: *mut mc_raster.Raster, y: i32, s: i32, color: u32, p: u64, n: usize) {
    var m: usize = n
    let cols: usize = ((*r).w / (6 * s)) as usize
    if m > cols { m = cols }
    let w: i32 = mc_hud.hud_text_width(m, s)
    mc_hud.hud_text_bytes(r, ((*r).w - w) / 2, y, s, color, SHADOW, p, m)
}

fn draw_death(h: *mut mc_health.Health, r: *mut mc_raster.Raster, s: i32) {
    mc_hud.hud_rect(r, 0, 0, (*r).w, (*r).h, DEATH_TINT)
    let top: i32 = (*r).h / 3
    let t: str = "Du bist gestorben!"
    draw_centered(r, top, s * 3, TITLE_COLOR, t.p as u64, t.n)
    let n: usize = mc_health.health_message_len(h)
    if n > 0 { draw_centered(r, top + 36 * s, s, MSG_COLOR, mc_health.health_message_ptr(h), n) }
    let hint: str = "Enter / R / Klick: Respawn"
    draw_centered(r, top + 56 * s, s, HINT_COLOR, hint.p as u64, hint.n)
}

fn health_ui_draw(h: *mut mc_health.Health, r: *mut mc_raster.Raster, s: i32) {
    if mc_health.health_visible(h) && !(*h).dead {
        let bw: i32 = 181 * s
        let x0: i32 = ((*r).w - bw) / 2
        let y: i32 = (*r).h - 34 * s
        bar(r, s, KIND_HEART, mc_health.health_hearts_x2(h), x0, y, 1)
        bar(r, s, KIND_FOOD, (*h).food, x0 + bw, y, 0 - 1)
    }
    if (*h).dead { draw_death(h, r, s) }
}

fn health_ui_keys(h: *mut mc_health.Health, rw: *mut raw.Raw) -> bool {
    if !(*h).dead { return false }
    if raw.key_pressed(rw, raw.KEY_ENTER) || raw.key_pressed(rw, SC_KP_ENTER) || raw.key_pressed(rw, SC_R) || raw.key_pressed(rw, SC_SPACE) { return true }
    return raw.mouse_pressed(rw, raw.MB_LEFT)
}
