import std.rt
import mc.mc_tip_lines
import mc.mc_item_names
import mc.mc_name_match
import mc.mc_tip_util

export { attr_line, attr_header }

const C_GRAY: i32 = 0xAAAAAA
const C_BLUE: i32 = 0x5555FF
const C_RED: i32 = 0xFF5555
const C_DGREEN: i32 = 0x00AA00

fn attr_header(t: *mut mc_tip_lines.TipLines, key_p: u64, key_n: usize, fallback: str, rgb: i32) {
    mc_tip_lines.tl_add_blank(t)
    var hv: rt.Buf = rt.buf_new()
    if !mc_item_names.names_find(key_p, key_n, &hv) { rt.buf_push_bytes(&hv, fallback.p as u64, fallback.n) }
    mc_tip_lines.tl_add_plain(t, rgb, 0 as u32, rt.buf_ptr(&hv), rt.buf_len(&hv))
    rt.buf_free(&hv)
}

fn attr_line(t: *mut mc_tip_lines.TipLines, np: u64, nn: usize, amount_x100: i64, opv: i64, base: bool) {
    var bp: u64 = 0
    var bn: usize = 0
    mc_tip_util.bare(np, nn, &bp, &bn)
    var amount: i64 = amount_x100
    if opv == 0 && mc_name_match.nm_suffix(bp, bn, "knockback_resistance") { amount = amount * 10 }
    if opv != 0 { amount = amount * 100 }
    var num: rt.Buf = rt.buf_new()
    mc_tip_util.put_hundredths(&num, amount)
    var an2: rt.Buf = rt.buf_new()
    mc_item_names.names_attr(np, nn, &an2)
    var key: rt.Buf = rt.buf_new()
    var fb: rt.Buf = rt.buf_new()
    var rgb: i32 = C_BLUE
    rt.buf_push_bytes(&key, "attribute.modifier.".p as u64, 19)
    if base {
        rgb = C_DGREEN
        rt.buf_push_bytes(&key, "equals.".p as u64, 7)
        rt.buf_push(&fb, 32 as u8)
    } else if amount < 0 {
        rgb = C_RED
        rt.buf_push_bytes(&key, "take.".p as u64, 5)
        rt.buf_push(&fb, 45 as u8)
    } else {
        rt.buf_push_bytes(&key, "plus.".p as u64, 5)
        rt.buf_push(&fb, 43 as u8)
    }
    rt.buf_push_dec_i64(&key, opv)
    rt.buf_push_bytes(&fb, "%s".p as u64, 2)
    if opv != 0 { rt.buf_push(&fb, 37 as u8); rt.buf_push(&fb, 37 as u8) }
    rt.buf_push_bytes(&fb, " %s".p as u64, 3)
    var tmpl: rt.Buf = rt.buf_new()
    if base { rt.buf_push(&tmpl, 32 as u8) }
    var found: rt.Buf = rt.buf_new()
    if mc_item_names.names_find(rt.buf_ptr(&key), rt.buf_len(&key), &found) {
        rt.buf_push_bytes(&tmpl, rt.buf_ptr(&found), rt.buf_len(&found))
    } else {
        rt.buf_push_bytes(&tmpl, rt.buf_ptr(&fb), rt.buf_len(&fb))
    }
    var line: rt.Buf = rt.buf_new()
    mc_tip_util.put_fmt(&line, rt.buf_ptr(&tmpl), rt.buf_len(&tmpl), rt.buf_ptr(&num), rt.buf_len(&num), rt.buf_ptr(&an2), rt.buf_len(&an2))
    mc_tip_lines.tl_add_plain(t, rgb, 0 as u32, rt.buf_ptr(&line), rt.buf_len(&line))
    rt.buf_free(&num)
    rt.buf_free(&an2)
    rt.buf_free(&key)
    rt.buf_free(&fb)
    rt.buf_free(&tmpl)
    rt.buf_free(&found)
    rt.buf_free(&line)
}
