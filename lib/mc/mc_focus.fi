export { FL_RELEASE, FL_PAUSE, focus_loss_plan, may_grab }

const FL_RELEASE: u32 = 1
const FL_PAUSE: u32 = 2

fn focus_loss_plan(grabbed: bool, pause_active: bool, pause_ready: bool, chat_open: bool, inv_open: bool, dead: bool) -> u32 {
    var plan: u32 = 0 as u32
    if grabbed {
        plan = plan | FL_RELEASE
    }
    if grabbed && !pause_active && pause_ready && !chat_open && !inv_open && !dead {
        plan = plan | FL_PAUSE
    }
    return plan
}

fn may_grab(focused: bool, pause_active: bool, chat_open: bool, inv_open: bool, dead: bool) -> bool {
    return focused && !pause_active && !chat_open && !inv_open && !dead
}
