import std.rt
import std.math
import mc.mc_world_view

export {
    FluidProbe, MV_LADDER, MV_WATER, MV_LAVA, FLUID_ACCEL, FLUID_JUMP, FLUID_SHALLOW, CLIMB_MAX, CLIMB_UP, EXIT_BOOST, LEDGE_LIFT,
    fluid_kind, kind_is_water, kind_is_lava, kind_is_fluid, kind_amount, fluid_surface, fluid_probe, fluid_drag, swim_boost, climb_clamp,
}

const MV_LADDER: i32 = 5
const MV_WATER: i32 = 16
const MV_LAVA: i32 = 32
const FLUID_ACCEL: f64 = 0.02
const FLUID_JUMP: f64 = 0.04
const FLUID_SHALLOW: f64 = 0.4
const CLIMB_MAX: f64 = 0.15
const CLIMB_UP: f64 = 0.2
const EXIT_BOOST: f64 = 0.3
const LEDGE_LIFT: f64 = 0.6
const WATER_DRAG: f64 = 0.8
const WATER_DRAG_SPRINT: f64 = 0.9
const WATER_SINK: f64 = 0.005
const LAVA_DRAG: f64 = 0.5
const LAVA_DRAG_SHALLOW_Y: f64 = 0.8
const LAVA_SINK: f64 = 0.02
const DEFLATE: f64 = 0.001

struct FluidProbe {
    water_h: f64,
    lava_h: f64,
    eye_water: bool,
    head_wet: bool,
    climb: bool,
}

fn fluid_kind(lava: bool, amount: i32) -> i32 {
    var a: i32 = amount
    if a < 1 { a = 1 }
    if a > 8 { a = 8 }
    if lava { return MV_LAVA + a }
    return MV_WATER + a
}

fn kind_is_water(k: i32) -> bool { return k > MV_WATER && k <= MV_WATER + 8 }

fn kind_is_lava(k: i32) -> bool { return k > MV_LAVA && k <= MV_LAVA + 8 }

fn kind_is_fluid(k: i32) -> bool { return kind_is_water(k) || kind_is_lava(k) }

fn kind_amount(k: i32) -> i32 {
    if kind_is_water(k) { return k - MV_WATER }
    if kind_is_lava(k) { return k - MV_LAVA }
    return 0
}

fn fluid_surface(k: i32, above: i32) -> f64 {
    if (kind_is_water(k) && kind_is_water(above)) || (kind_is_lava(k) && kind_is_lava(above)) { return 1.0 }
    return (kind_amount(k) as f64) / 9.0
}

fn fluid_probe(v: *mut mc_world_view.WorldView, mv: u64, x: f64, y: f64, z: f64, h: f64, eye: f64, out: *mut FluidProbe) {
    (*out).water_h = 0.0
    (*out).lava_h = 0.0
    (*out).eye_water = false
    (*out).head_wet = false
    (*out).climb = false
    let x0: i32 = math.floor(x - 0.3 + DEFLATE) as i32
    let x1: i32 = math.floor(x + 0.3 - DEFLATE) as i32
    let y0: i32 = math.floor(y + DEFLATE) as i32
    let y1: i32 = math.floor(y + h - DEFLATE) as i32
    let z0: i32 = math.floor(z - 0.3 + DEFLATE) as i32
    let z1: i32 = math.floor(z + 0.3 - DEFLATE) as i32
    var bz: i32 = z0
    while bz <= z1 {
        var by: i32 = y0
        while by <= y1 {
            var bx: i32 = x0
            while bx <= x1 {
                let k: i32 = mc_world_view.view_kind(v, mv, bx, by, bz)
                if kind_is_fluid(k) {
                    let top: f64 = (by as f64) + fluid_surface(k, mc_world_view.view_kind(v, mv, bx, by + 1, bz))
                    if top >= y {
                        if kind_is_water(k) {
                            (*out).water_h = math.fmax((*out).water_h, top - y)
                        } else {
                            (*out).lava_h = math.fmax((*out).lava_h, top - y)
                        }
                    }
                }
                bx = bx + 1
            }
            by = by + 1
        }
        bz = bz + 1
    }
    let fx: i32 = math.floor(x) as i32
    let fz: i32 = math.floor(z) as i32
    let ey: i32 = math.floor(y + eye) as i32
    let ek: i32 = mc_world_view.view_kind(v, mv, fx, ey, fz)
    if kind_is_water(ek) {
        let etop: f64 = (ey as f64) + fluid_surface(ek, mc_world_view.view_kind(v, mv, fx, ey + 1, fz))
        (*out).eye_water = etop > y + eye
    }
    (*out).head_wet = kind_is_fluid(mc_world_view.view_kind(v, mv, fx, math.floor(y + 0.9) as i32, fz))
    (*out).climb = mc_world_view.view_kind(v, mv, fx, math.floor(y) as i32, fz) == MV_LADDER
}

fn fluid_drag(lava: bool, sprinting: bool, shallow: bool, vx: *mut f64, vy: *mut f64, vz: *mut f64) {
    if lava {
        var fy: f64 = LAVA_DRAG
        if shallow { fy = LAVA_DRAG_SHALLOW_Y }
        *vx = *vx * LAVA_DRAG
        *vz = *vz * LAVA_DRAG
        *vy = *vy * fy
        if shallow { *vy = *vy - WATER_SINK }
        *vy = *vy - LAVA_SINK
        return
    }
    var f: f64 = WATER_DRAG
    if sprinting { f = WATER_DRAG_SPRINT }
    *vx = *vx * f
    *vz = *vz * f
    *vy = *vy * WATER_DRAG
    if !sprinting { *vy = *vy - WATER_SINK }
}

fn swim_boost(vy: *mut f64, look_y: f64, jump: bool, head_wet: bool) {
    var e: f64 = 0.06
    if look_y < 0.0 - 0.2 { e = 0.085 }
    if look_y <= 0.0 || jump || head_wet { *vy = *vy + (look_y - *vy) * e }
}

fn climb_clamp(vx: *mut f64, vy: *mut f64, vz: *mut f64, sneaking: bool) {
    *vx = math.fmax(0.0 - CLIMB_MAX, math.fmin(*vx, CLIMB_MAX))
    *vz = math.fmax(0.0 - CLIMB_MAX, math.fmin(*vz, CLIMB_MAX))
    *vy = math.fmax(*vy, 0.0 - CLIMB_MAX)
    if sneaking && *vy < 0.0 { *vy = 0.0 }
}
