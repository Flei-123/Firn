import std.rt
import mc.mc_item_names

export { tk_builtin, tk_resolve }

struct Entry {
    key: str,
    name: str,
}

fn entry(k: str, n: str) -> Entry { return Entry { key: k, name: n } }

fn entry_at(i: i32) -> Entry {
    if i == 0 { return entry("container.chest", "Chest") }
    if i == 1 { return entry("container.chestDouble", "Large Chest") }
    if i == 2 { return entry("container.hopper", "Item Hopper") }
    if i == 3 { return entry("container.dispenser", "Dispenser") }
    if i == 4 { return entry("container.dropper", "Dropper") }
    if i == 5 { return entry("container.shulkerBox", "Shulker Box") }
    if i == 6 { return entry("container.barrel", "Barrel") }
    if i == 7 { return entry("container.enderchest", "Ender Chest") }
    if i == 8 { return entry("container.crafting", "Crafting") }
    if i == 9 { return entry("container.furnace", "Furnace") }
    if i == 10 { return entry("container.blast_furnace", "Blast Furnace") }
    if i == 11 { return entry("container.smoker", "Smoker") }
    if i == 12 { return entry("container.enchant", "Enchant") }
    if i == 13 { return entry("container.repair", "Repair & Name") }
    if i == 14 { return entry("container.brewing", "Brewing Stand") }
    if i == 15 { return entry("container.grindstone_title", "Repair & Disenchant") }
    if i == 16 { return entry("container.stonecutter", "Stonecutter") }
    if i == 17 { return entry("container.loom", "Loom") }
    if i == 18 { return entry("container.upgrade", "Upgrade Gear") }
    if i == 19 { return entry("container.cartography_table", "Cartography Table") }
    if i == 20 { return entry("container.beacon", "Beacon") }
    if i == 21 { return entry("container.lectern", "Lectern") }
    if i == 22 { return entry("container.inventory", "Inventory") }
    if i == 23 { return entry("container.creative", "Item Selection") }
    if i == 24 { return entry("container.jukebox", "Jukebox") }
    if i == 25 { return entry("container.crafter", "Crafter") }
    if i == 26 { return entry("container.chiseled_bookshelf", "Chiseled Bookshelf") }
    if i == 27 { return entry("entity.minecraft.horse", "Horse") }
    if i == 28 { return entry("entity.minecraft.donkey", "Donkey") }
    if i == 29 { return entry("entity.minecraft.mule", "Mule") }
    if i == 30 { return entry("entity.minecraft.llama", "Llama") }
    if i == 31 { return entry("entity.minecraft.trader_llama", "Trader Llama") }
    if i == 32 { return entry("entity.minecraft.skeleton_horse", "Skeleton Horse") }
    if i == 33 { return entry("entity.minecraft.zombie_horse", "Zombie Horse") }
    if i == 34 { return entry("entity.minecraft.villager", "Villager") }
    if i == 35 { return entry("entity.minecraft.wandering_trader", "Wandering Trader") }
    if i == 36 { return entry("entity.minecraft.chest_minecart", "Minecart with Chest") }
    if i == 37 { return entry("entity.minecraft.hopper_minecart", "Minecart with Hopper") }
    if i == 38 { return entry("entity.minecraft.furnace_minecart", "Minecart with Furnace") }
    return entry("", "")
}

const ENTRY_COUNT: i32 = 39

fn tk_builtin(p: u64, n: usize) -> str {
    var i: i32 = 0
    while i < ENTRY_COUNT {
        let e: Entry = entry_at(i)
        if e.key.n == n && rt.mem_eq(p, e.key.p as u64, n) { return e.name }
        i = i + 1
    }
    return str { p: p as *u8, n: 0 }
}

fn tk_resolve(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    if mc_item_names.names_find(p, n, out) { return true }
    let b: str = tk_builtin(p, n)
    if b.n == 0 { return false }
    rt.buf_push_bytes(out, b.p as u64, b.n)
    return true
}
