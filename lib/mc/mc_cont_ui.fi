import mc.mc_raster
import mc.mc_gui_tex
import mc.mc_item_src
import mc.mc_hud_vfont
import mc.mc_inv_ui

export { ContUi, cui_new, cui_free, cui_open, cui_ok, cui_kind, cui_panel_w, cui_panel_h, cui_slot_xy, cui_slot_at, cui_draw, KIND_GENERIC, KIND_DISPENSER, KIND_HOPPER, KIND_CRAFT, KIND_FURNACE }

const PANEL_W: i32 = 176
const KIND_GENERIC: i32 = 0
const KIND_DISPENSER: i32 = 1
const KIND_HOPPER: i32 = 2
const KIND_CRAFT: i32 = 3
const KIND_FURNACE: i32 = 4
const TEXT_DARK: u32 = 0xFF404040
const WHITE: u32 = 0xFFFFFFFF

struct ContUi {
    tex: [mc_gui_tex.GuiTex; 5],
    loaded: bool,
}

fn cui_new() -> ContUi {
    return ContUi { tex: [mc_gui_tex.gtex_empty(); 5], loaded: false }
}

fn cui_free(u: *mut ContUi) {
    var k: usize = 0
    while k < 5 {
        mc_gui_tex.gtex_free(&(*u).tex[k])
        k = k + 1
    }
    (*u).loaded = false
}

fn cui_ok(u: *mut ContUi) -> bool { return (*u).loaded }

fn tex_path(kind: i32) -> str {
    if kind == KIND_DISPENSER { return "assets/minecraft/textures/gui/container/dispenser.png" }
    if kind == KIND_HOPPER { return "assets/minecraft/textures/gui/container/hopper.png" }
    if kind == KIND_CRAFT { return "assets/minecraft/textures/gui/container/crafting_table.png" }
    if kind == KIND_FURNACE { return "assets/minecraft/textures/gui/container/furnace.png" }
    return "assets/minecraft/textures/gui/container/generic_54.png"
}

fn cui_open(u: *mut ContUi, src: *mut mc_item_src.ItemSrc) -> bool {
    var k: i32 = 0
    var all: bool = true
    while k < 5 {
        let path: str = tex_path(k)
        if !mc_item_src.isrc_tex(src, path.p as u64, path.length(), &(*u).tex[k as usize]) { all = false }
        k = k + 1
    }
    (*u).loaded = all
    return all
}

fn cui_kind(n: i32, cols: i32) -> i32 {
    if n == 10 { return KIND_CRAFT }
    if n == 3 { return KIND_FURNACE }
    if n == 5 { return KIND_HOPPER }
    if n == 9 && cols == 3 { return KIND_DISPENSER }
    if n > 0 && n % 9 == 0 && n <= 54 { return KIND_GENERIC }
    return 0 - 1
}

fn cui_panel_w() -> i32 { return PANEL_W }

fn cui_panel_h(kind: i32, n: i32) -> i32 {
    if kind == KIND_GENERIC { return 114 + (n / 9) * 18 }
    if kind == KIND_HOPPER { return 133 }
    return 166
}

fn main_y(kind: i32, n: i32) -> i32 {
    if kind == KIND_GENERIC { return 31 + (n / 9) * 18 }
    if kind == KIND_HOPPER { return 51 }
    return 84
}

fn cui_slot_xy(kind: i32, n: i32, ws: i32, x: *mut i32, y: *mut i32) -> bool {
    if ws < 0 || ws >= n + 36 { return false }
    if ws >= n + 27 {
        *x = 8 + 18 * (ws - n - 27)
        *y = main_y(kind, n) + 58
        return true
    }
    if ws >= n {
        let k: i32 = ws - n
        *x = 8 + 18 * (k % 9)
        *y = main_y(kind, n) + 18 * (k / 9)
        return true
    }
    if kind == KIND_GENERIC {
        *x = 8 + 18 * (ws % 9)
        *y = 18 + 18 * (ws / 9)
    } else if kind == KIND_DISPENSER {
        *x = 62 + 18 * (ws % 3)
        *y = 17 + 18 * (ws / 3)
    } else if kind == KIND_HOPPER {
        *x = 44 + 18 * ws
        *y = 20
    } else if kind == KIND_CRAFT {
        if ws == 0 {
            *x = 124
            *y = 35
        } else {
            *x = 30 + 18 * ((ws - 1) % 3)
            *y = 17 + 18 * ((ws - 1) / 3)
        }
    } else {
        if ws == 0 {
            *x = 56
            *y = 17
        } else if ws == 1 {
            *x = 56
            *y = 53
        } else {
            *x = 116
            *y = 35
        }
    }
    return true
}

fn cui_slot_at(kind: i32, n: i32, px: i32, py: i32, s: i32, mx: i32, my: i32) -> i32 {
    if mx < px || my < py || mx >= px + PANEL_W * s || my >= py + cui_panel_h(kind, n) * s { return 0 - 999 }
    var ws: i32 = 0
    var x: i32 = 0
    var y: i32 = 0
    while ws < n + 36 {
        cui_slot_xy(kind, n, ws, &x, &y)
        let gx: i32 = px + x * s
        let gy: i32 = py + y * s
        if mx >= gx && my >= gy && mx < gx + 16 * s && my < gy + 16 * s { return ws }
        ws = ws + 1
    }
    return 0 - 1
}

fn default_title(kind: i32) -> str {
    if kind == KIND_CRAFT { return "Crafting" }
    if kind == KIND_FURNACE { return "Furnace" }
    if kind == KIND_HOPPER { return "Item Hopper" }
    if kind == KIND_DISPENSER { return "Dispenser" }
    return "Chest"
}

fn cui_draw(r: *mut mc_raster.Raster, u: *mut ContUi, kind: i32, n: i32, px: i32, py: i32, s: i32, tp: u64, tn: usize) {
    let h: i32 = cui_panel_h(kind, n)
    let t: *mut mc_gui_tex.GuiTex = &(*u).tex[kind as usize]
    if kind == KIND_GENERIC {
        let top: i32 = (n / 9) * 18 + 17
        mc_gui_tex.gtex_draw(r, t, px, py, PANEL_W * s, top * s, 0, 0, PANEL_W, top, WHITE)
        mc_gui_tex.gtex_draw(r, t, px, py + top * s, PANEL_W * s, 96 * s, 0, 126, PANEL_W, 96, WHITE)
    } else {
        mc_gui_tex.gtex_draw(r, t, px, py, PANEL_W * s, h * s, 0, 0, PANEL_W, h, WHITE)
    }
    var title: str = default_title(kind)
    if tn > 0 { title = str { p: tp as *u8, n: tn } }
    var tx: i32 = 8
    if kind == KIND_CRAFT {
        tx = 29
    } else if kind == KIND_DISPENSER || kind == KIND_FURNACE {
        tx = (PANEL_W - mc_hud_vfont.vtext_width(title.p as u64, 0 as u64, 0, title.length())) / 2
    }
    mc_inv_ui.iui_text(r, px + tx * s, py + 6 * s, s, title, TEXT_DARK, false)
    mc_inv_ui.iui_text(r, px + 8 * s, py + (h - 94) * s, s, "Inventory", TEXT_DARK, false)
}
