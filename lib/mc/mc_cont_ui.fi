import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_gui_tex
import mc.mc_item_src
import mc.mc_hud_vfont
import mc.mc_inv_ui
import mc.mc_menu

export {
    ContUi, ContView, cui_new, cui_free, cui_open, cui_ok, cui_kind, cui_kind_of, cui_panel_w, cui_panel_h, cui_slot_xy, cui_slot_at, cui_draw, cui_draw_extras,
    cview_new, cview_free, cui_enchant_at, cui_name_field_xy, cui_kind_ready,
    KIND_GENERIC, KIND_DISPENSER, KIND_HOPPER, KIND_CRAFT, KIND_FURNACE, KIND_ANVIL, KIND_ENCHANT, KIND_BREWING, KIND_MERCHANT, KIND_GRIND, KIND_STONECUT,
    KIND_LOOM, KIND_SMITHING, KIND_CARTO, KIND_BLAST, KIND_SMOKER, KIND_HORSE, KIND_COUNT,
}

const PANEL_W: i32 = 176
const MERCHANT_W: i32 = 276
const MERCHANT_PLAYER_DX: i32 = 100
const KIND_GENERIC: i32 = 0
const KIND_DISPENSER: i32 = 1
const KIND_HOPPER: i32 = 2
const KIND_CRAFT: i32 = 3
const KIND_FURNACE: i32 = 4
const KIND_ANVIL: i32 = 5
const KIND_ENCHANT: i32 = 6
const KIND_BREWING: i32 = 7
const KIND_MERCHANT: i32 = 8
const KIND_GRIND: i32 = 9
const KIND_STONECUT: i32 = 10
const KIND_LOOM: i32 = 11
const KIND_SMITHING: i32 = 12
const KIND_CARTO: i32 = 13
const KIND_BLAST: i32 = 14
const KIND_SMOKER: i32 = 15
const KIND_HORSE: i32 = 16
const KIND_COUNT: i32 = 17
const BASE_KINDS: i32 = 5
const TEXT_DARK: u32 = 0xFF404040
const WHITE: u32 = 0xFFFFFFFF
const COST_OK: u32 = 0xFF20FF80
const COST_BAD: u32 = 0xFF6060FF
const ENCHANT_ON: u32 = 0xFF20FF80
const ENCHANT_OFF: u32 = 0xFF107F40
const DIGITS: str = "0123456789"
const PROP_LIT_TIME: i32 = 0
const PROP_LIT_DURATION: i32 = 1
const PROP_COOK_TIME: i32 = 2
const PROP_COOK_TOTAL: i32 = 3
const PROP_BREW_TIME: i32 = 0
const PROP_BREW_FUEL: i32 = 1
const BREW_TOTAL: i32 = 400
const BREW_FUEL_MAX: i32 = 20
const TOO_EXPENSIVE: i32 = 40

struct ContUi {
    tex: [mc_gui_tex.GuiTex; 17],
    loaded: bool,
}

struct ContView {
    props: [i32; 12],
    present: [bool; 5],
    lapis: i32,
    name_p: u64,
    name_n: usize,
    mx: i32,
    my: i32,
    creative: bool,
    edit: bool,
    num: rt.Buf,
}

fn cui_new() -> ContUi {
    return ContUi { tex: [mc_gui_tex.gtex_empty(); 17], loaded: false }
}

fn cview_new() -> ContView {
    return ContView {
        props: [0; 12], present: [false; 5], lapis: 0, name_p: 0 as u64, name_n: 0, mx: 0 - 1, my: 0 - 1, creative: false, edit: false, num: rt.buf_new(),
    }
}

fn cview_free(v: *mut ContView) {
    rt.buf_free(&(*v).num)
}

fn cui_free(u: *mut ContUi) {
    var k: i32 = 0
    while k < KIND_COUNT {
        mc_gui_tex.gtex_free(&(*u).tex[k as usize])
        k = k + 1
    }
    (*u).loaded = false
}

fn cui_ok(u: *mut ContUi) -> bool { return (*u).loaded }

fn cui_kind_ready(u: *mut ContUi, kind: i32) -> bool {
    if kind < 0 || kind >= KIND_COUNT { return false }
    return mc_gui_tex.gtex_ok(&(*u).tex[kind as usize])
}

fn tex_path(kind: i32) -> str {
    if kind == KIND_DISPENSER { return "assets/minecraft/textures/gui/container/dispenser.png" }
    if kind == KIND_HOPPER { return "assets/minecraft/textures/gui/container/hopper.png" }
    if kind == KIND_CRAFT { return "assets/minecraft/textures/gui/container/crafting_table.png" }
    if kind == KIND_FURNACE { return "assets/minecraft/textures/gui/container/furnace.png" }
    if kind == KIND_ANVIL { return "assets/minecraft/textures/gui/container/anvil.png" }
    if kind == KIND_ENCHANT { return "assets/minecraft/textures/gui/container/enchanting_table.png" }
    if kind == KIND_BREWING { return "assets/minecraft/textures/gui/container/brewing_stand.png" }
    if kind == KIND_MERCHANT { return "assets/minecraft/textures/gui/container/villager2.png" }
    if kind == KIND_GRIND { return "assets/minecraft/textures/gui/container/grindstone.png" }
    if kind == KIND_STONECUT { return "assets/minecraft/textures/gui/container/stonecutter.png" }
    if kind == KIND_LOOM { return "assets/minecraft/textures/gui/container/loom.png" }
    if kind == KIND_SMITHING { return "assets/minecraft/textures/gui/container/smithing.png" }
    if kind == KIND_CARTO { return "assets/minecraft/textures/gui/container/cartography_table.png" }
    if kind == KIND_BLAST { return "assets/minecraft/textures/gui/container/blast_furnace.png" }
    if kind == KIND_SMOKER { return "assets/minecraft/textures/gui/container/smoker.png" }
    if kind == KIND_HORSE { return "assets/minecraft/textures/gui/container/horse.png" }
    return "assets/minecraft/textures/gui/container/generic_54.png"
}

fn cui_open(u: *mut ContUi, src: *mut mc_item_src.ItemSrc) -> bool {
    var k: i32 = 0
    var base: bool = true
    while k < KIND_COUNT {
        let path: str = tex_path(k)
        let ok: bool = mc_item_src.isrc_tex(src, path.p as u64, path.length(), &(*u).tex[k as usize])
        if !ok && k < BASE_KINDS { base = false }
        k = k + 1
    }
    (*u).loaded = base
    return base
}

fn cui_kind(n: i32, cols: i32) -> i32 {
    if n == 10 { return KIND_CRAFT }
    if n == 3 { return KIND_FURNACE }
    if n == 5 { return KIND_HOPPER }
    if n == 9 && cols == 3 { return KIND_DISPENSER }
    if n > 0 && n % 9 == 0 && n <= 54 { return KIND_GENERIC }
    return 0 - 1
}

fn cui_kind_of(mk: i32, n: i32, cols: i32) -> i32 {
    if mk == mc_menu.MK_ANVIL { return KIND_ANVIL }
    if mk == mc_menu.MK_ENCHANT { return KIND_ENCHANT }
    if mk == mc_menu.MK_BREWING { return KIND_BREWING }
    if mk == mc_menu.MK_MERCHANT { return KIND_MERCHANT }
    if mk == mc_menu.MK_GRIND { return KIND_GRIND }
    if mk == mc_menu.MK_STONECUT { return KIND_STONECUT }
    if mk == mc_menu.MK_LOOM { return KIND_LOOM }
    if mk == mc_menu.MK_SMITHING && n == 4 { return KIND_SMITHING }
    if mk == mc_menu.MK_CARTO { return KIND_CARTO }
    if mk == mc_menu.MK_BLAST { return KIND_BLAST }
    if mk == mc_menu.MK_SMOKER { return KIND_SMOKER }
    if mk == mc_menu.MK_HORSE { return KIND_HORSE }
    if mk == mc_menu.MK_BEACON || mk == mc_menu.MK_LECTERN || mk == mc_menu.MK_SMITHING { return 0 - 1 }
    return cui_kind(n, cols)
}

fn is_furnace(kind: i32) -> bool {
    return kind == KIND_FURNACE || kind == KIND_BLAST || kind == KIND_SMOKER
}

fn cui_panel_w(kind: i32) -> i32 {
    if kind == KIND_MERCHANT { return MERCHANT_W }
    return PANEL_W
}

fn cui_panel_h(kind: i32, n: i32) -> i32 {
    if kind == KIND_GENERIC { return 114 + (n / 9) * 18 }
    if kind == KIND_HOPPER { return 133 }
    return 166
}

fn main_y(kind: i32, n: i32) -> i32 {
    if kind == KIND_GENERIC { return 31 + (n / 9) * 18 }
    if kind == KIND_HOPPER { return 51 }
    return 84
}

fn put(ox: *mut i32, oy: *mut i32, x: i32, y: i32) {
    *ox = x
    *oy = y
}

fn container_xy(kind: i32, n: i32, ws: i32, x: *mut i32, y: *mut i32) {
    if kind == KIND_GENERIC {
        put(x, y, 8 + 18 * (ws % 9), 18 + 18 * (ws / 9))
    } else if kind == KIND_DISPENSER {
        put(x, y, 62 + 18 * (ws % 3), 17 + 18 * (ws / 3))
    } else if kind == KIND_HOPPER {
        put(x, y, 44 + 18 * ws, 20)
    } else if kind == KIND_CRAFT {
        if ws == 0 { put(x, y, 124, 35) } else { put(x, y, 30 + 18 * ((ws - 1) % 3), 17 + 18 * ((ws - 1) / 3)) }
    } else if is_furnace(kind) {
        if ws == 0 { put(x, y, 56, 17) } else if ws == 1 { put(x, y, 56, 53) } else { put(x, y, 116, 35) }
    } else if kind == KIND_ANVIL {
        if ws == 0 { put(x, y, 27, 47) } else if ws == 1 { put(x, y, 76, 47) } else { put(x, y, 134, 47) }
    } else if kind == KIND_ENCHANT {
        if ws == 0 { put(x, y, 15, 47) } else { put(x, y, 35, 47) }
    } else if kind == KIND_BREWING {
        if ws == 0 { put(x, y, 56, 51) } else if ws == 1 { put(x, y, 79, 58) } else if ws == 2 { put(x, y, 102, 51) } else if ws == 3 { put(x, y, 79, 17) } else { put(x, y, 17, 17) }
    } else if kind == KIND_MERCHANT {
        if ws == 0 { put(x, y, 136, 37) } else if ws == 1 { put(x, y, 162, 37) } else { put(x, y, 220, 37) }
    } else if kind == KIND_GRIND {
        if ws == 0 { put(x, y, 49, 19) } else if ws == 1 { put(x, y, 49, 40) } else { put(x, y, 129, 34) }
    } else if kind == KIND_STONECUT {
        if ws == 0 { put(x, y, 20, 33) } else { put(x, y, 143, 33) }
    } else if kind == KIND_LOOM {
        if ws == 0 { put(x, y, 13, 26) } else if ws == 1 { put(x, y, 33, 26) } else if ws == 2 { put(x, y, 23, 45) } else { put(x, y, 143, 58) }
    } else if kind == KIND_SMITHING {
        if ws == 0 { put(x, y, 8, 48) } else if ws == 1 { put(x, y, 26, 48) } else if ws == 2 { put(x, y, 44, 48) } else { put(x, y, 98, 48) }
    } else if kind == KIND_CARTO {
        if ws == 0 { put(x, y, 15, 15) } else if ws == 1 { put(x, y, 15, 52) } else { put(x, y, 145, 39) }
    } else {
        if ws == 0 {
            put(x, y, 8, 18)
        } else if ws == 1 {
            put(x, y, 8, 36)
        } else {
            let cols: i32 = (n - 2) / 3
            let k: i32 = ws - 2
            put(x, y, 80 + 18 * (k % cols), 18 + 18 * (k / cols))
        }
    }
}

fn cui_slot_xy(kind: i32, n: i32, ws: i32, x: *mut i32, y: *mut i32) -> bool {
    if ws < 0 || ws >= n + 36 { return false }
    var dx: i32 = 0
    if kind == KIND_MERCHANT { dx = MERCHANT_PLAYER_DX }
    if ws >= n + 27 {
        put(x, y, dx + 8 + 18 * (ws - n - 27), main_y(kind, n) + 58)
        return true
    }
    if ws >= n {
        let k: i32 = ws - n
        put(x, y, dx + 8 + 18 * (k % 9), main_y(kind, n) + 18 * (k / 9))
        return true
    }
    container_xy(kind, n, ws, x, y)
    return true
}

fn cui_slot_at(kind: i32, n: i32, px: i32, py: i32, s: i32, mx: i32, my: i32) -> i32 {
    if mx < px || my < py || mx >= px + cui_panel_w(kind) * s || my >= py + cui_panel_h(kind, n) * s { return 0 - 999 }
    var ws: i32 = 0
    var x: i32 = 0
    var y: i32 = 0
    while ws < n + 36 {
        cui_slot_xy(kind, n, ws, &x, &y)
        let gx: i32 = px + x * s
        let gy: i32 = py + y * s
        if mx >= gx && my >= gy && mx < gx + 16 * s && my < gy + 16 * s { return ws }
        ws = ws + 1
    }
    return 0 - 1
}

fn cui_enchant_at(px: i32, py: i32, s: i32, mx: i32, my: i32) -> i32 {
    var i: i32 = 0
    while i < 3 {
        let gx: i32 = px + 60 * s
        let gy: i32 = py + (14 + 19 * i) * s
        if mx >= gx && my >= gy && mx < gx + 108 * s && my < gy + 19 * s { return i }
        i = i + 1
    }
    return 0 - 1
}

fn cui_name_field_xy(kind: i32, x: *mut i32, y: *mut i32, w: *mut i32) -> bool {
    if kind != KIND_ANVIL { return false }
    put(x, y, 62, 24)
    *w = 103
    return true
}

fn default_title(kind: i32) -> str {
    if kind == KIND_CRAFT { return "Crafting" }
    if kind == KIND_FURNACE { return "Furnace" }
    if kind == KIND_BLAST { return "Blast Furnace" }
    if kind == KIND_SMOKER { return "Smoker" }
    if kind == KIND_HOPPER { return "Item Hopper" }
    if kind == KIND_DISPENSER { return "Dispenser" }
    if kind == KIND_ANVIL { return "Repair & Name" }
    if kind == KIND_ENCHANT { return "Enchant" }
    if kind == KIND_BREWING { return "Brewing Stand" }
    if kind == KIND_MERCHANT { return "Villager" }
    if kind == KIND_GRIND { return "Repair & Disenchant" }
    if kind == KIND_STONECUT { return "Stonecutter" }
    if kind == KIND_LOOM { return "Loom" }
    if kind == KIND_SMITHING { return "Upgrade Gear" }
    if kind == KIND_CARTO { return "Cartography Table" }
    if kind == KIND_HORSE { return "Horse" }
    return "Chest"
}

fn title_x(kind: i32, title: str) -> i32 {
    if kind == KIND_CRAFT { return 29 }
    if kind == KIND_ANVIL { return 60 }
    if kind == KIND_ENCHANT { return 12 }
    if kind == KIND_SMITHING { return 44 }
    if kind == KIND_MERCHANT { return 49 }
    if kind == KIND_DISPENSER || is_furnace(kind) || kind == KIND_BREWING {
        return (PANEL_W - mc_hud_vfont.vtext_width(title.p as u64, 0 as u64, 0, title.length())) / 2
    }
    return 8
}

fn title_y(kind: i32) -> i32 {
    if kind == KIND_SMITHING { return 15 }
    return 6
}

fn inventory_x(kind: i32) -> i32 {
    if kind == KIND_MERCHANT { return MERCHANT_PLAYER_DX + 8 }
    return 8
}

fn cui_draw(r: *mut mc_raster.Raster, u: *mut ContUi, kind: i32, n: i32, px: i32, py: i32, s: i32, tp: u64, tn: usize) {
    let h: i32 = cui_panel_h(kind, n)
    let w: i32 = cui_panel_w(kind)
    let t: *mut mc_gui_tex.GuiTex = &(*u).tex[kind as usize]
    if kind == KIND_GENERIC {
        let top: i32 = (n / 9) * 18 + 17
        mc_gui_tex.gtex_draw(r, t, px, py, PANEL_W * s, top * s, 0, 0, PANEL_W, top, WHITE)
        mc_gui_tex.gtex_draw(r, t, px, py + top * s, PANEL_W * s, 96 * s, 0, 126, PANEL_W, 96, WHITE)
    } else {
        mc_gui_tex.gtex_draw(r, t, px, py, w * s, h * s, 0, 0, w, h, WHITE)
    }
    if kind == KIND_HORSE { draw_horse_slots(r, t, n, px, py, s) }
    var title: str = default_title(kind)
    if tn > 0 { title = str { p: tp as *u8, n: tn } }
    mc_inv_ui.iui_text(r, px + title_x(kind, title) * s, py + title_y(kind) * s, s, title, TEXT_DARK, false)
    mc_inv_ui.iui_text(r, px + inventory_x(kind) * s, py + (h - 94) * s, s, "Inventory", TEXT_DARK, false)
}

fn draw_horse_slots(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, n: i32, px: i32, py: i32, s: i32) {
    mc_gui_tex.gtex_draw(r, t, px + 7 * s, py + 17 * s, 18 * s, 18 * s, 18, 220, 18, 18, WHITE)
    mc_gui_tex.gtex_draw(r, t, px + 7 * s, py + 35 * s, 18 * s, 18 * s, 0, 220, 18, 18, WHITE)
    let cols: i32 = (n - 2) / 3
    if cols > 0 { mc_gui_tex.gtex_draw(r, t, px + 79 * s, py + 17 * s, cols * 18 * s, 54 * s, 0, 166, cols * 18, 54, WHITE) }
}

fn push_number(b: *mut rt.Buf, v: i32) {
    rt.buf_clear(b)
    var n: i32 = v
    if n < 0 { n = 0 }
    var div: i32 = 1
    while n / div >= 10 { div = div * 10 }
    while div > 0 {
        rt.buf_push_bytes(b, DIGITS.p as u64 + (((n / div) % 10) as u64), 1)
        div = div / 10
    }
}

fn blit(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, px: i32, py: i32, s: i32, x: i32, y: i32, sx: i32, sy: i32, w: i32, h: i32) {
    if w <= 0 || h <= 0 { return }
    mc_gui_tex.gtex_draw(r, t, px + x * s, py + y * s, w * s, h * s, sx, sy, w, h, WHITE)
}

fn draw_furnace_progress(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, v: *mut ContView, px: i32, py: i32, s: i32) {
    let lit: i32 = (*v).props[PROP_LIT_TIME as usize]
    var dur: i32 = (*v).props[PROP_LIT_DURATION as usize]
    if dur == 0 { dur = 200 }
    if lit > 0 {
        var k: i32 = lit * 13 / dur
        if k > 13 { k = 13 }
        blit(r, t, px, py, s, 56, 36 + 12 - k, 176, 12 - k, 14, k + 1)
    }
    let cook: i32 = (*v).props[PROP_COOK_TIME as usize]
    let total: i32 = (*v).props[PROP_COOK_TOTAL as usize]
    var wd: i32 = 0
    if total > 0 && cook > 0 { wd = cook * 24 / total }
    if wd > 24 { wd = 24 }
    blit(r, t, px, py, s, 79, 34, 176, 14, wd + 1, 16)
}

fn bubble_len(i: i32) -> i32 {
    if i == 0 { return 29 }
    if i == 1 { return 24 }
    if i == 2 { return 20 }
    if i == 3 { return 16 }
    if i == 4 { return 11 }
    if i == 5 { return 6 }
    return 0
}

fn draw_brewing_progress(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, v: *mut ContView, px: i32, py: i32, s: i32) {
    let brew: i32 = (*v).props[PROP_BREW_TIME as usize]
    var fuel: i32 = (*v).props[PROP_BREW_FUEL as usize]
    if fuel > BREW_FUEL_MAX { fuel = BREW_FUEL_MAX }
    var fw: i32 = (18 * fuel + BREW_FUEL_MAX - 1) / BREW_FUEL_MAX
    if fw > 18 { fw = 18 }
    blit(r, t, px, py, s, 60, 44, 176, 29, fw, 4)
    if brew > 0 {
        let ah: i32 = (28 * (BREW_TOTAL - brew)) / BREW_TOTAL
        blit(r, t, px, py, s, 97, 16, 176, 0, 9, ah)
        let bl: i32 = bubble_len((brew / 2) % 7)
        if bl > 0 { blit(r, t, px, py, s, 63, 14 + 29 - bl, 185, 29 - bl, 12, bl) }
    }
}

fn draw_anvil(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, v: *mut ContView, px: i32, py: i32, s: i32) {
    var fy: i32 = 182
    if (*v).present[0] { fy = 166 }
    blit(r, t, px, py, s, 59, 20, 0, fy, 110, 16)
    if (*v).name_n > 0 {
        let name: str = str { p: (*v).name_p as *u8, n: (*v).name_n }
        mc_inv_ui.iui_text(r, px + 62 * s, py + 26 * s, s, name, WHITE, true)
    }
    if (*v).edit {
        let nw: i32 = mc_hud_vfont.vtext_width((*v).name_p, 0 as u64, 0, (*v).name_n)
        mc_inv_ui.iui_text(r, px + (62 + nw) * s, py + 26 * s, s, "_", WHITE, true)
    }
    if ((*v).present[0] || (*v).present[1]) && !(*v).present[2] { blit(r, t, px, py, s, 99, 45, 176, 0, 28, 21) }
    let cost: i32 = (*v).props[0]
    if cost <= 0 || !(*v).present[2] { return }
    var label: str = "Too Expensive!"
    var col: u32 = COST_BAD
    if cost < TOO_EXPENSIVE || (*v).creative {
        push_number(&(*v).num, cost)
        label = rt.buf_str(&(*v).num)
        col = COST_OK
    }
    var text_w: i32 = mc_hud_vfont.vtext_width(label.p as u64, 0 as u64, 0, label.length())
    var prefix: str = ""
    if cost < TOO_EXPENSIVE || (*v).creative {
        prefix = "Enchantment Cost: "
        text_w = text_w + mc_hud_vfont.vtext_width(prefix.p as u64, 0 as u64, 0, prefix.length())
    }
    let x: i32 = PANEL_W - 8 - text_w - 2
    mc_hud.hud_rect(r, px + (x - 2) * s, py + 67 * s, (PANEL_W - 8 - x + 2) * s, 12 * s, 0x4F000000 as u32)
    var tx: i32 = x
    if prefix.length() > 0 {
        mc_inv_ui.iui_text(r, px + tx * s, py + 69 * s, s, prefix, col, true)
        tx = tx + mc_hud_vfont.vtext_width(prefix.p as u64, 0 as u64, 0, prefix.length())
    }
    mc_inv_ui.iui_text(r, px + tx * s, py + 69 * s, s, label, col, true)
}

fn draw_enchant(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, v: *mut ContView, px: i32, py: i32, s: i32) {
    var i: i32 = 0
    while i < 3 {
        let cost: i32 = (*v).props[i as usize]
        let by: i32 = 14 + 19 * i
        if cost <= 0 {
            blit(r, t, px, py, s, 60, by, 0, 185, 108, 19)
        } else {
            let enabled: bool = (*v).lapis > i || (*v).creative
            if !enabled {
                blit(r, t, px, py, s, 60, by, 0, 185, 108, 19)
                blit(r, t, px, py, s, 61, by + 1, 16 * i, 239, 16, 16)
            } else {
                var sy: i32 = 166
                if cui_enchant_at(px, py, s, (*v).mx, (*v).my) == i { sy = 204 }
                blit(r, t, px, py, s, 60, by, 0, sy, 108, 19)
                blit(r, t, px, py, s, 61, by + 1, 16 * i, 223, 16, 16)
            }
            push_number(&(*v).num, cost)
            let label: str = rt.buf_str(&(*v).num)
            let lw: i32 = mc_hud_vfont.vtext_width(label.p as u64, 0 as u64, 0, label.length())
            var col: u32 = ENCHANT_OFF
            if enabled { col = ENCHANT_ON }
            mc_inv_ui.iui_text(r, px + (60 + 106 - lw) * s, py + (by + 10) * s, s, label, col, true)
        }
        i = i + 1
    }
}

fn cui_draw_extras(r: *mut mc_raster.Raster, u: *mut ContUi, kind: i32, n: i32, px: i32, py: i32, s: i32, v: *mut ContView) {
    if kind < 0 || kind >= KIND_COUNT { return }
    let t: *mut mc_gui_tex.GuiTex = &(*u).tex[kind as usize]
    if is_furnace(kind) { draw_furnace_progress(r, t, v, px, py, s) }
    if kind == KIND_BREWING { draw_brewing_progress(r, t, v, px, py, s) }
    if kind == KIND_ANVIL { draw_anvil(r, t, v, px, py, s) }
    if kind == KIND_ENCHANT { draw_enchant(r, t, v, px, py, s) }
}
