import mc.mc_slide

export { BOUNCE_LIVING, BOUNCE_OTHER, bounces, landed_vy, fall_multiplier }

const BOUNCE_LIVING: f64 = 1.0
const BOUNCE_OTHER: f64 = 0.8

fn bounces(kind: i32, sneaking: bool) -> bool {
    return kind == mc_slide.MV_SLIME && !sneaking
}

fn landed_vy(kind: i32, vy: f64, sneaking: bool, living: bool) -> f64 {
    if !bounces(kind, sneaking) || vy >= 0.0 { return 0.0 }
    if living { return 0.0 - vy * BOUNCE_LIVING }
    return 0.0 - vy * BOUNCE_OTHER
}

fn fall_multiplier(kind: i32, sneaking: bool) -> f64 {
    if bounces(kind, sneaking) { return 0.0 }
    return 1.0
}
