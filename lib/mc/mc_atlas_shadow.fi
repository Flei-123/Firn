import std.rt
import mc.mc_texture

export {
    AtlasShadow, shadow_new, shadow_free, shadow_store, shadow_matches, shadow_tile_changed, shadow_tile_gather, shadow_changed_list,
}

struct AtlasShadow {
    px: u64,
    bytes: usize,
    tile: i32,
    cols: i32,
    rows: i32,
}

fn shadow_new() -> AtlasShadow {
    return AtlasShadow { px: 0, bytes: 0, tile: 0, cols: 0, rows: 0 }
}

fn shadow_free(s: *mut AtlasShadow) {
    if (*s).px != 0 {
        rt.heap_free((*s).px, (*s).bytes)
    }
    (*s).px = 0
    (*s).bytes = 0
    (*s).tile = 0
    (*s).cols = 0
    (*s).rows = 0
}

fn shadow_store(s: *mut AtlasShadow, at: *mut mc_texture.Atlas) {
    let bytes: usize = ((*at).w as usize) * ((*at).h as usize) * 4
    if (*s).px != 0 && (*s).bytes != bytes {
        rt.heap_free((*s).px, (*s).bytes)
        (*s).px = 0
    }
    if (*s).px == 0 {
        (*s).px = rt.heap_alloc(bytes)
        (*s).bytes = bytes
    }
    if (*s).px == 0 {
        (*s).bytes = 0
        return
    }
    rt.mem_copy((*s).px, (*at).px, bytes)
    (*s).tile = (*at).tile
    (*s).cols = (*at).cols
    (*s).rows = (*at).rows
}

fn shadow_matches(s: *mut AtlasShadow, at: *mut mc_texture.Atlas) -> bool {
    if (*s).px == 0 { return false }
    if (*s).tile != (*at).tile || (*s).cols != (*at).cols || (*s).rows != (*at).rows { return false }
    return (*s).bytes == ((*at).w as usize) * ((*at).h as usize) * 4
}

fn shadow_tile_changed(s: *mut AtlasShadow, at: *mut mc_texture.Atlas, g: usize) -> bool {
    let t: usize = (*at).tile as usize
    let row: usize = t * 4
    let stride: usize = ((*at).w as usize) * 4
    let col: usize = g % ((*at).cols as usize)
    let rw: usize = g / ((*at).cols as usize)
    var y: usize = 0
    while y < t {
        let off: usize = (rw * t + y) * stride + col * row
        if !rt.mem_eq((*s).px + off as u64, (*at).px + off as u64, row) { return true }
        y = y + 1
    }
    return false
}

fn shadow_tile_gather(s: *mut AtlasShadow, at: *mut mc_texture.Atlas, g: usize, out: u64) {
    let t: usize = (*at).tile as usize
    let row: usize = t * 4
    let stride: usize = ((*at).w as usize) * 4
    let col: usize = g % ((*at).cols as usize)
    let rw: usize = g / ((*at).cols as usize)
    var y: usize = 0
    while y < t {
        let off: usize = (rw * t + y) * stride + col * row
        rt.mem_copy(out + (y * row) as u64, (*at).px + off as u64, row)
        rt.mem_copy((*s).px + off as u64, (*at).px + off as u64, row)
        y = y + 1
    }
}

fn shadow_changed_list(s: *mut AtlasShadow, at: *mut mc_texture.Atlas, limit: usize, out: u64) -> usize {
    var n: usize = 0
    var g: usize = 0
    while g < limit {
        if shadow_tile_changed(s, at, g) {
            rt.st32(out, n, g as u32)
            n = n + 1
        }
        g = g + 1
    }
    return n
}
