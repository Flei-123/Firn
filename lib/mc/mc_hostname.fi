import std.rt
import net.dns
import net.ip6

export { host_valid, host_char_ok, is_bracketed, bracket_inner_ptr, bracket_inner_len, HOST_NAME_MAX, LABEL_MAX }

const HOST_NAME_MAX: usize = 253
const LABEL_MAX: usize = 63

fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn is_alpha(c: u8) -> bool {
    return (c >= 65 as u8 && c <= 90 as u8) || (c >= 97 as u8 && c <= 122 as u8)
}

fn host_char_ok(code: u32) -> bool {
    if code > 127 as u32 { return false }
    let c: u8 = code as u8
    return is_digit(c) || is_alpha(c) || c == 46 as u8 || c == 45 as u8 || c == 91 as u8 || c == 93 as u8 || c == 58 as u8
}

fn is_bracketed(p: u64, n: usize) -> bool {
    return n >= 4 && rt.ld8(p, 0) == 91 as u8 && rt.ld8(p, n - 1) == 93 as u8
}

fn bracket_inner_ptr(p: u64, n: usize) -> u64 {
    if is_bracketed(p, n) { return p + 1 as u64 }
    return p
}

fn bracket_inner_len(p: u64, n: usize) -> usize {
    if is_bracketed(p, n) { return n - 2 }
    return n
}

fn ip6_literal_ok(p: u64, n: usize) -> bool {
    var lit: [u8; 16] = [0; 16]
    return ip6.ip6_parse(p, n, &lit)
}

fn numeric_only(p: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if !is_digit(c) && c != 46 as u8 { return false }
        i = i + 1
    }
    return true
}

fn host_valid(p: u64, n: usize) -> bool {
    if n == 0 || n > HOST_NAME_MAX { return false }
    if is_bracketed(p, n) { return ip6_literal_ok(p + 1 as u64, n - 2) }
    if numeric_only(p, n) {
        var addr: u32 = 0
        return dns.dns_parse_ipv4(p, n, &addr)
    }
    var label: usize = 0
    var last: u8 = 46 as u8
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if !host_char_ok(c as u32) || c == 91 as u8 || c == 93 as u8 || c == 58 as u8 { return false }
        if c == 46 as u8 {
            if label == 0 || last == 45 as u8 { return false }
            label = 0
        } else {
            if c == 45 as u8 && label == 0 { return false }
            label = label + 1
            if label > LABEL_MAX { return false }
        }
        last = c
        i = i + 1
    }
    return label > 0 && last != 45 as u8
}
