// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_flat.fi -- the flattening table reader: legacy block states (1.8 - 1.12.2,
// `id << 4 | meta`) -> 1.13+ (1.20.1) global block state ids.
//
// The table is generated by tools/mcgen/gen_flat.py out of tools/mcgen/legacy_flat.json and
// minecraft-data into lib/mc/v340/mc_flat_v340.fi (only a blob and `flat_make()`); everything that
// READS the blob is here. BLOB: "FLT1", then 4096 entries of 3 octets of 7 bits, least significant
// group first (ASCII clean, so it can be a Firn string literal).
//
// Unknown meta combinations of a block fall back to meta 0 of the same id (decided by the
// generator, see its header); a legacy id without a block maps to 0 (air); a value outside the table
// (>= 4096, i.e. a block id above 255) maps to 0 as well.
//
// The expanded table (`Flat.tab`, 4096 x u16 on the heap) is what mc_chunk.chunk_remap_blocks takes.

import std.rt

export { Flat, flat_open, flat_ok, flat_get, flat_table, flat_len, flat_free, FLAT_STATES }

const FLAT_STATES: usize = 4096

struct Flat {
    tab: u64, // u16 [4096], 0 = the blob was not valid
}

// Expands the blob into a heap table. Check it with flat_ok.
fn flat_open(blob: u64) -> Flat {
    var f: Flat = Flat { tab: 0 }
    if blob == 0 || rt.ld8(blob, 0) != 70 as u8 || rt.ld8(blob, 1) != 76 as u8 || rt.ld8(blob, 2) != 84 as u8 || rt.ld8(blob, 3) != 49 as u8 {
        return f
    }
    let t: u64 = rt.heap_alloc(FLAT_STATES * 2)
    if t == 0 {
        return f
    }
    var i: usize = 0
    while i < FLAT_STATES {
        let a: usize = 4 + i * 3
        let v: u32 = (rt.ld8(blob, a) as u32) | ((rt.ld8(blob, a + 1) as u32) << 7) | ((rt.ld8(blob, a + 2) as u32) << 14)
        rt.st16(t, i, v as u16)
        i = i + 1
    }
    f.tab = t
    return f
}

fn flat_ok(f: *mut Flat) -> bool { return (*f).tab != 0 }

fn flat_free(f: *mut Flat) {
    if (*f).tab != 0 {
        rt.heap_free((*f).tab, FLAT_STATES * 2)
    }
    (*f).tab = 0
}

// The 1.20.1 state id of the legacy state `legacy` (= id << 4 | meta); 0 (air) out of range.
fn flat_get(f: *mut Flat, legacy: u32) -> u16 {
    if (*f).tab == 0 || legacy as usize >= FLAT_STATES {
        return 0 as u16
    }
    return rt.ld16((*f).tab, legacy as usize)
}

// the raw u16 table for mc_chunk.chunk_remap_blocks
fn flat_table(f: *mut Flat) -> u64 { return (*f).tab }
fn flat_len(f: *mut Flat) -> usize { return FLAT_STATES }
