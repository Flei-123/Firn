import std.rt
import std.math
import mc.mc_world_view
import mc.mc_move_fluid

export { FlowSolids, flow_vector, flow_push, PUSH_WATER, PUSH_LAVA }

const PUSH_WATER: f64 = 0.014
const PUSH_LAVA: f64 = 0.0023333333333333335
const PUSH_MIN: f64 = 0.0045000000000000005
const PUSH_REST: f64 = 0.003
const SHALLOW: f64 = 0.4
const DEFLATE: f64 = 0.001
const BELOW_HEIGHT: f64 = 0.8888889
const FALL_PULL: f64 = 6.0

struct FlowSolids {
    solid: u64,
    n: usize,
}

fn dir_x(i: i32) -> i32 {
    if i == 0 { return 1 }
    if i == 1 { return 0 - 1 }
    return 0
}

fn dir_z(i: i32) -> i32 {
    if i == 2 { return 1 }
    if i == 3 { return 0 - 1 }
    return 0
}

fn same_fluid(a: i32, b: i32) -> bool {
    return (mc_move_fluid.kind_is_water(a) && mc_move_fluid.kind_is_water(b)) || (mc_move_fluid.kind_is_lava(a) && mc_move_fluid.kind_is_lava(b))
}

fn own_height(k: i32) -> f64 {
    return (mc_move_fluid.kind_amount(k) as f64) / 9.0
}

fn solid_class(v: *mut mc_world_view.WorldView, mv: u64, s: *mut FlowSolids, x: i32, y: i32, z: i32) -> u16 {
    let id: i32 = mc_world_view.view_id(v, x, y, z)
    if id < 0 || (id as usize) >= (*s).n { return 0 as u16 }
    if mc_move_fluid.kind_is_fluid(mc_world_view.view_kind(v, mv, x, y, z)) { return 0 as u16 }
    return rt.ld16((*s).solid, id as usize)
}

fn blocks_motion(v: *mut mc_world_view.WorldView, mv: u64, s: *mut FlowSolids, x: i32, y: i32, z: i32) -> bool {
    if mc_move_fluid.kind_is_climb(mc_world_view.view_kind(v, mv, x, y, z)) { return false }
    return solid_class(v, mv, s, x, y, z) != 0 as u16
}

fn solid_face(v: *mut mc_world_view.WorldView, mv: u64, s: *mut FlowSolids, x: i32, y: i32, z: i32) -> bool {
    return solid_class(v, mv, s, x, y, z) == 1 as u16
}

fn normalize3(x: *mut f64, y: *mut f64, z: *mut f64) {
    let l: f64 = math.sqrt(*x * *x + *y * *y + *z * *z)
    if l < 0.00001 {
        *x = 0.0
        *y = 0.0
        *z = 0.0
        return
    }
    *x = *x / l
    *y = *y / l
    *z = *z / l
}

fn flow_vector(v: *mut mc_world_view.WorldView, mv: u64, s: *mut FlowSolids, bx: i32, by: i32, bz: i32, k: i32, ox: *mut f64, oy: *mut f64, oz: *mut f64) {
    let own: f64 = own_height(k)
    var fx: f64 = 0.0
    var fz: f64 = 0.0
    var i: i32 = 0
    while i < 4 {
        let nx: i32 = bx + dir_x(i)
        let nz: i32 = bz + dir_z(i)
        let nk: i32 = mc_world_view.view_kind(v, mv, nx, by, nz)
        var f1: f64 = 0.0
        if mc_move_fluid.kind_is_fluid(nk) {
            if same_fluid(k, nk) { f1 = own - own_height(nk) }
        } else if !blocks_motion(v, mv, s, nx, by, nz) {
            let bk: i32 = mc_world_view.view_kind(v, mv, nx, by - 1, nz)
            if same_fluid(k, bk) {
                let f: f64 = own_height(bk)
                if f > 0.0 { f1 = own - (f - BELOW_HEIGHT) }
            }
        }
        fx = fx + (dir_x(i) as f64) * f1
        fz = fz + (dir_z(i) as f64) * f1
        i = i + 1
    }
    var vx: f64 = fx
    var vy: f64 = 0.0
    var vz: f64 = fz
    if mc_move_fluid.kind_is_falling(k) {
        var d: i32 = 0
        var found: bool = false
        while d < 4 && !found {
            let nx: i32 = bx + dir_x(d)
            let nz: i32 = bz + dir_z(d)
            if solid_face(v, mv, s, nx, by, nz) || solid_face(v, mv, s, nx, by + 1, nz) { found = true }
            d = d + 1
        }
        if found {
            normalize3(&vx, &vy, &vz)
            vy = vy - FALL_PULL
        }
    }
    normalize3(&vx, &vy, &vz)
    *ox = vx
    *oy = vy
    *oz = vz
}

fn flow_push(v: *mut mc_world_view.WorldView, mv: u64, s: *mut FlowSolids, x: f64, y: f64, z: f64, h: f64, lava: bool, vx: *mut f64, vy: *mut f64, vz: *mut f64) {
    let min_y: f64 = y + DEFLATE
    let x0: i32 = math.floor(x - 0.3 + DEFLATE) as i32
    let x1: i32 = math.floor(x + 0.3 - DEFLATE) as i32
    let y0: i32 = math.floor(min_y) as i32
    let y1: i32 = math.floor(y + h - DEFLATE) as i32
    let z0: i32 = math.floor(z - 0.3 + DEFLATE) as i32
    let z1: i32 = math.floor(z + 0.3 - DEFLATE) as i32
    var depth: f64 = 0.0
    var sx: f64 = 0.0
    var sy: f64 = 0.0
    var sz: f64 = 0.0
    var count: i32 = 0
    var bz: i32 = z0
    while bz <= z1 {
        var by: i32 = y0
        while by <= y1 {
            var bx: i32 = x0
            while bx <= x1 {
                let k: i32 = mc_world_view.view_kind(v, mv, bx, by, bz)
                var wanted: bool = mc_move_fluid.kind_is_water(k)
                if lava { wanted = mc_move_fluid.kind_is_lava(k) }
                if wanted {
                    let top: f64 = (by as f64) + mc_move_fluid.fluid_surface(k, mc_world_view.view_kind(v, mv, bx, by + 1, bz))
                    if top >= min_y {
                        depth = math.fmax(depth, top - min_y)
                        var fx: f64 = 0.0
                        var fy: f64 = 0.0
                        var fz: f64 = 0.0
                        flow_vector(v, mv, s, bx, by, bz, k, &fx, &fy, &fz)
                        if depth < SHALLOW {
                            fx = fx * depth
                            fy = fy * depth
                            fz = fz * depth
                        }
                        sx = sx + fx
                        sy = sy + fy
                        sz = sz + fz
                        count = count + 1
                    }
                }
                bx = bx + 1
            }
            by = by + 1
        }
        bz = bz + 1
    }
    if count == 0 || sx * sx + sy * sy + sz * sz <= 0.0 { return }
    var scale: f64 = PUSH_WATER
    if lava { scale = PUSH_LAVA }
    let inv: f64 = scale / (count as f64)
    var px: f64 = sx * inv
    var py: f64 = sy * inv
    var pz: f64 = sz * inv
    if math.fabs(*vx) < PUSH_REST && math.fabs(*vz) < PUSH_REST && math.sqrt(px * px + py * py + pz * pz) < PUSH_MIN {
        normalize3(&px, &py, &pz)
        px = px * PUSH_MIN
        py = py * PUSH_MIN
        pz = pz * PUSH_MIN
    }
    *vx = *vx + px
    *vy = *vy + py
    *vz = *vz + pz
}
