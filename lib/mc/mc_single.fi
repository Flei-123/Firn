import std.env
import std.osinfo

export { single_wanted, single_acquire, SINGLE_PORT }

const SINGLE_PORT: i32 = 38419
const SYS_SOCKET: i64 = 41
const SYS_BIND: i64 = 49
const SYS_LISTEN: i64 = 50
const AF_INET: i64 = 2
const SOCK_STREAM: i64 = 1

fn single_wanted() -> bool {
    var on: bool = osinfo.is_windows()
    if env.has("MCPLAY_SINGLE") {
        let v: str = env.get("MCPLAY_SINGLE")
        if v.length() > 0 { on = v.chars(0) == 49 as u8 }
    }
    return on
}

fn single_port() -> i32 {
    if env.has("MCPLAY_SINGLE_PORT") {
        let v: str = env.get("MCPLAY_SINGLE_PORT")
        var n: i32 = 0
        var i: usize = 0
        while i < v.length() {
            let ch: u8 = v.chars(i)
            if ch < 48 as u8 || ch > 57 as u8 { return SINGLE_PORT }
            n = n * 10 + (ch as i32 - 48)
            i = i + 1
        }
        if n > 0 && n < 65536 { return n }
    }
    return SINGLE_PORT
}

fn single_acquire() -> bool {
    let fd: i64 = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM, 0, 0, 0, 0)
    if fd < 0 { return true }
    let port: i32 = single_port()
    var sa: [u8; 16] = [0; 16]
    sa[0] = 2 as u8
    sa[2] = ((port / 256) % 256) as u8
    sa[3] = (port % 256) as u8
    sa[4] = 127 as u8
    sa[7] = 1 as u8
    if syscall(SYS_BIND, fd, (&sa[0]) as i64, 16, 0, 0, 0) < 0 { return false }
    syscall(SYS_LISTEN, fd, 1, 0, 0, 0, 0)
    return true
}
