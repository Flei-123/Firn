import std.rt
import std.env
import std.fs
import std.osinfo
import mc.mc_launch_cfg

export { single_wanted, single_acquire }

const SYS_OPEN: i64 = 2
const SYS_FLOCK: i64 = 73
const O_RDWR_CREAT: i64 = 66
const LOCK_EX_NB: i64 = 6

fn single_wanted() -> bool {
    var on: bool = osinfo.is_windows()
    if env.has("MCPLAY_SINGLE") {
        let v: str = env.get("MCPLAY_SINGLE")
        if v.length() > 0 { on = v.chars(0) == 49 as u8 }
    }
    return on
}

fn parent_len(path: str) -> usize {
    var i: usize = path.length()
    while i > 0 {
        if path.chars(i - 1) == 47 as u8 { return i - 1 }
        i = i - 1
    }
    return 0
}

fn single_acquire() -> bool {
    var path: rt.Buf = rt.buf_new()
    if !mc_launch_cfg.cfg_default_path(&path) {
        rt.buf_free(&path)
        return true
    }
    let base: str = str { p: rt.buf_data(&path), n: rt.buf_len(&path) }
    let pl: usize = parent_len(base)
    if pl > 0 { fs.mkdir_all(base.part(0, pl)) catch false }
    rt.buf_push_bytes(&path, ".lock".p as u64, 5)
    rt.buf_push(&path, 0 as u8)
    let fd: i64 = syscall(SYS_OPEN, rt.buf_ptr(&path) as i64, O_RDWR_CREAT, 384, 0, 0, 0)
    rt.buf_free(&path)
    if fd < 0 { return true }
    return syscall(SYS_FLOCK, fd, LOCK_EX_NB, 0, 0, 0, 0) >= 0
}
