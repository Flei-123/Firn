import std.rt
import std.bytes
import mc.mc_version
import mc.mc_sem
import mc.mc_schema

export {
    Trades, tr_new, tr_clear, tr_on_list, tr_count, tr_window, tr_level, tr_xp, tr_regular, tr_restock, tr_selected, tr_scroll, tr_visible,
    tr_max_scroll, tr_scroll_by, tr_select, tr_index_of_row, tr_item_a, tr_base_a, tr_cost_a, tr_item_b, tr_count_b, tr_item_r, tr_count_r,
    tr_out_of_stock, tr_uses, tr_max_uses, tr_trade_xp, tr_price_cost, tr_set_scroll, TR_CAP, TR_ROWS,
}

const TR_CAP: usize = 64
const TR_ROWS: i32 = 7
const MAX_STACK: i32 = 64

struct Trades {
    win: i32,
    n: i32,
    level: i32,
    xp: i32,
    regular: bool,
    restock: bool,
    sel: i32,
    scroll: i32,
    dropped: i32,
    a_item: [i32; 64],
    a_base: [i32; 64],
    a_cost: [i32; 64],
    b_item: [i32; 64],
    b_n: [i32; 64],
    r_item: [i32; 64],
    r_n: [i32; 64],
    uses: [i32; 64],
    max_uses: [i32; 64],
    t_xp: [i32; 64],
    disabled: [bool; 64],
}

fn tr_new() -> Trades {
    return Trades {
        win: 0 - 1, n: 0, level: 0, xp: 0, regular: false, restock: false, sel: 0, scroll: 0, dropped: 0,
        a_item: [0 - 1; 64], a_base: [0; 64], a_cost: [0; 64], b_item: [0 - 1; 64], b_n: [0; 64], r_item: [0 - 1; 64], r_n: [0; 64],
        uses: [0; 64], max_uses: [0; 64], t_xp: [0; 64], disabled: [false; 64],
    }
}

fn tr_clear(t: *mut Trades) {
    *t = tr_new()
}

fn tr_window(t: *mut Trades) -> i32 { return (*t).win }

fn tr_count(t: *mut Trades) -> i32 { return (*t).n }

fn tr_level(t: *mut Trades) -> i32 { return (*t).level }

fn tr_xp(t: *mut Trades) -> i32 { return (*t).xp }

fn tr_regular(t: *mut Trades) -> bool { return (*t).regular }

fn tr_restock(t: *mut Trades) -> bool { return (*t).restock }

fn tr_selected(t: *mut Trades) -> i32 { return (*t).sel }

fn tr_scroll(t: *mut Trades) -> i32 { return (*t).scroll }

fn in_range(t: *mut Trades, i: i32) -> bool { return i >= 0 && i < (*t).n }

fn tr_item_a(t: *mut Trades, i: i32) -> i32 {
    if !in_range(t, i) { return 0 - 1 }
    return (*t).a_item[i as usize]
}

fn tr_base_a(t: *mut Trades, i: i32) -> i32 {
    if !in_range(t, i) { return 0 }
    return (*t).a_base[i as usize]
}

fn tr_cost_a(t: *mut Trades, i: i32) -> i32 {
    if !in_range(t, i) { return 0 }
    return (*t).a_cost[i as usize]
}

fn tr_item_b(t: *mut Trades, i: i32) -> i32 {
    if !in_range(t, i) { return 0 - 1 }
    return (*t).b_item[i as usize]
}

fn tr_count_b(t: *mut Trades, i: i32) -> i32 {
    if !in_range(t, i) { return 0 }
    return (*t).b_n[i as usize]
}

fn tr_item_r(t: *mut Trades, i: i32) -> i32 {
    if !in_range(t, i) { return 0 - 1 }
    return (*t).r_item[i as usize]
}

fn tr_count_r(t: *mut Trades, i: i32) -> i32 {
    if !in_range(t, i) { return 0 }
    return (*t).r_n[i as usize]
}

fn tr_uses(t: *mut Trades, i: i32) -> i32 {
    if !in_range(t, i) { return 0 }
    return (*t).uses[i as usize]
}

fn tr_max_uses(t: *mut Trades, i: i32) -> i32 {
    if !in_range(t, i) { return 0 }
    return (*t).max_uses[i as usize]
}

fn tr_trade_xp(t: *mut Trades, i: i32) -> i32 {
    if !in_range(t, i) { return 0 }
    return (*t).t_xp[i as usize]
}

fn tr_out_of_stock(t: *mut Trades, i: i32) -> bool {
    if !in_range(t, i) { return false }
    return (*t).disabled[i as usize] || ((*t).max_uses[i as usize] > 0 && (*t).uses[i as usize] >= (*t).max_uses[i as usize])
}

fn tr_max_scroll(t: *mut Trades) -> i32 {
    if (*t).n <= TR_ROWS { return 0 }
    return (*t).n - TR_ROWS
}

fn tr_set_scroll(t: *mut Trades, v: i32) {
    var s: i32 = v
    let mx: i32 = tr_max_scroll(t)
    if s > mx { s = mx }
    if s < 0 { s = 0 }
    (*t).scroll = s
}

fn tr_scroll_by(t: *mut Trades, delta: i32) {
    tr_set_scroll(t, (*t).scroll + delta)
}

fn tr_visible(t: *mut Trades) -> i32 {
    var v: i32 = (*t).n - (*t).scroll
    if v > TR_ROWS { v = TR_ROWS }
    if v < 0 { v = 0 }
    return v
}

fn tr_index_of_row(t: *mut Trades, row: i32) -> i32 {
    if row < 0 || row >= tr_visible(t) { return 0 - 1 }
    return (*t).scroll + row
}

fn tr_select(t: *mut Trades, i: i32) -> bool {
    if !in_range(t, i) { return false }
    (*t).sel = i
    return true
}

fn f32_of_bits(bits: u32) -> f32 {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_i32(&b, bytes.bits_i32(bits))
    bytes.bytes_set_pos(&b, 0)
    let v: f32 = bytes.get_f32(&b) catch (0.0 as f32)
    bytes.bytes_free(&b)
    return v
}

fn tr_price_cost(base: i32, special: i32, demand: i32, mult: f32) -> i32 {
    var bump: i32 = 0
    let scaled: f32 = ((base as f32) * (demand as f32)) * mult
    if scaled > (0.0 as f32) { bump = scaled as i32 }
    var cost: i32 = base + bump + special
    if cost < 1 { cost = 1 }
    if cost > MAX_STACK { cost = MAX_STACK }
    return cost
}

fn parse_dec(p: u64, n: usize, ok: *mut bool) -> i32 {
    var i: usize = 0
    var neg: bool = false
    var r: i64 = 0
    *ok = n > 0
    if n > 0 && rt.ld8(p, 0) == 45 as u8 { neg = true; i = 1; *ok = n > 1 }
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 { *ok = false; return 0 }
        r = r * 10 + ((c as i64) - 48)
        if r > 2000000000 { *ok = false; return 0 }
        i = i + 1
    }
    if neg { r = 0 - r }
    return r as i32
}

fn hex_value(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 { return (c as i32) - 48 }
    if c >= 97 as u8 && c <= 102 as u8 { return (c as i32) - 87 }
    return 0 - 1
}

fn parse_hex_bits(p: u64, n: usize, ok: *mut bool) -> u32 {
    *ok = n > 2 && n <= 10 && rt.ld8(p, 0) == 48 as u8 && rt.ld8(p, 1) == 120 as u8
    if !*ok { return 0 as u32 }
    var r: u32 = 0 as u32
    var i: usize = 2
    while i < n {
        let h: i32 = hex_value(rt.ld8(p, i))
        if h < 0 { *ok = false; return 0 as u32 }
        r = (r << 4 as u32) | (h as u32)
        i = i + 1
    }
    return r
}

fn has_prefix(p: u64, n: usize, lit: str) -> bool {
    if n < lit.n { return false }
    var i: usize = 0
    while i < lit.n {
        if rt.ld8(p, i) != rt.ld8(lit.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

fn is_name(p: u64, n: usize, lit: str) -> bool {
    return n == lit.n && has_prefix(p, n, lit)
}

struct Raw {
    a_item: i32,
    a_n: i32,
    b_item: i32,
    b_n: i32,
    r_item: i32,
    r_n: i32,
    special: i32,
    demand: i32,
    mult: f32,
    uses: i32,
    max_uses: i32,
    xp: i32,
    disabled: bool,
    b_present: bool,
}

fn raw_new() -> Raw {
    return Raw {
        a_item: 0 - 1, a_n: 0, b_item: 0 - 1, b_n: 0, r_item: 0 - 1, r_n: 0, special: 0, demand: 0, mult: 0.0 as f32, uses: 0, max_uses: 0, xp: 0,
        disabled: false, b_present: true,
    }
}

fn commit(t: *mut Trades, idx: i32, r: *mut Raw) {
    if idx < 0 { return }
    if idx as usize >= TR_CAP {
        (*t).dropped = (*t).dropped + 1
        return
    }
    let k: usize = idx as usize
    var ai: i32 = (*r).a_item
    if (*r).a_n <= 0 { ai = 0 - 1 }
    var bi: i32 = (*r).b_item
    if (*r).b_n <= 0 || !(*r).b_present { bi = 0 - 1 }
    var ri: i32 = (*r).r_item
    if (*r).r_n <= 0 { ri = 0 - 1 }
    (*t).a_item[k] = ai
    (*t).a_base[k] = (*r).a_n
    (*t).a_cost[k] = tr_price_cost((*r).a_n, (*r).special, (*r).demand, (*r).mult)
    if ai < 0 { (*t).a_cost[k] = 0 }
    (*t).b_item[k] = bi
    (*t).b_n[k] = (*r).b_n
    (*t).r_item[k] = ri
    (*t).r_n[k] = (*r).r_n
    (*t).uses[k] = (*r).uses
    (*t).max_uses[k] = (*r).max_uses
    (*t).t_xp[k] = (*r).xp
    (*t).disabled[k] = (*r).disabled
    if idx + 1 > (*t).n { (*t).n = idx + 1 }
}

fn apply_trade_field(r: *mut Raw, f: u64, fnn: usize, vp: u64, vn: usize, opt: bool) {
    var ok: bool = false
    if opt {
        if is_name(f, fnn, "inputItem2") { (*r).b_present = vn == 1 && rt.ld8(vp, 0) == 49 as u8 }
        return
    }
    if has_prefix(f, fnn, "inputItem1.") {
        let sub: u64 = f + 11 as u64
        let sn: usize = fnn - 11
        if is_name(sub, sn, "itemId") { (*r).a_item = parse_dec(vp, vn, &ok) }
        if is_name(sub, sn, "itemCount") { (*r).a_n = parse_dec(vp, vn, &ok) }
    } else if has_prefix(f, fnn, "inputItem2.") {
        let sub: u64 = f + 11 as u64
        let sn: usize = fnn - 11
        if is_name(sub, sn, "itemId") { (*r).b_item = parse_dec(vp, vn, &ok) }
        if is_name(sub, sn, "itemCount") { (*r).b_n = parse_dec(vp, vn, &ok) }
        if is_name(sub, sn, "present") { (*r).b_present = vn == 4 && has_prefix(vp, vn, "true") }
    } else if has_prefix(f, fnn, "outputItem.") {
        let sub: u64 = f + 11 as u64
        let sn: usize = fnn - 11
        if is_name(sub, sn, "itemId") { (*r).r_item = parse_dec(vp, vn, &ok) }
        if is_name(sub, sn, "itemCount") { (*r).r_n = parse_dec(vp, vn, &ok) }
    } else if is_name(f, fnn, "tradeDisabled") {
        (*r).disabled = vn == 4 && has_prefix(vp, vn, "true")
    } else if is_name(f, fnn, "nbTradeUses") {
        (*r).uses = parse_dec(vp, vn, &ok)
    } else if is_name(f, fnn, "maximumNbTradeUses") {
        (*r).max_uses = parse_dec(vp, vn, &ok)
    } else if is_name(f, fnn, "xp") {
        (*r).xp = parse_dec(vp, vn, &ok)
    } else if is_name(f, fnn, "specialPrice") {
        (*r).special = parse_dec(vp, vn, &ok)
    } else if is_name(f, fnn, "demand") {
        (*r).demand = parse_dec(vp, vn, &ok)
    } else if is_name(f, fnn, "priceMultiplier") {
        let bits: u32 = parse_hex_bits(vp, vn, &ok)
        if ok { (*r).mult = f32_of_bits(bits) }
    }
}

fn apply_lines(t: *mut Trades, base: u64, total: usize) -> bool {
    var pos: usize = 0
    var cur: i32 = 0 - 1
    var r: Raw = raw_new()
    var good: bool = true
    while pos < total {
        var e: usize = pos
        while e < total && rt.ld8(base, e) != 10 as u8 { e = e + 1 }
        let ln: u64 = base + (pos as u64)
        let n: usize = e - pos
        pos = e + 1
        var eq: usize = 0
        while eq < n && rt.ld8(ln, eq) != 61 as u8 && rt.ld8(ln, eq) != 63 as u8 { eq = eq + 1 }
        if eq >= n { continue }
        var vo: usize = eq + 1
        if rt.ld8(ln, eq) == 63 as u8 { vo = eq + 2 }
        let vp: u64 = ln + (vo as u64)
        var vn: usize = 0
        if vo <= n { vn = n - vo }
        var ok: bool = false
        if is_name(ln, eq, "windowId") {
            (*t).win = parse_dec(vp, vn, &ok)
            if !ok { good = false }
        } else if is_name(ln, eq, "villagerLevel") {
            (*t).level = parse_dec(vp, vn, &ok)
        } else if is_name(ln, eq, "experience") {
            (*t).xp = parse_dec(vp, vn, &ok)
        } else if is_name(ln, eq, "isRegularVillager") {
            (*t).regular = vn == 4 && has_prefix(vp, vn, "true")
        } else if is_name(ln, eq, "canRestock") {
            (*t).restock = vn == 4 && has_prefix(vp, vn, "true")
        } else if has_prefix(ln, eq, "trades[") {
            var q: usize = 7
            while q < eq && rt.ld8(ln, q) != 93 as u8 { q = q + 1 }
            let idx: i32 = parse_dec(ln + 7 as u64, q - 7, &ok)
            if !ok || q + 1 >= eq || rt.ld8(ln, q + 1) != 46 as u8 { continue }
            if idx != cur {
                commit(t, cur, &r)
                cur = idx
                r = raw_new()
            }
            apply_trade_field(&r, ln + (q + 2) as u64, eq - q - 2, vp, vn, rt.ld8(ln, eq) == 63 as u8)
        }
    }
    commit(t, cur, &r)
    return good
}

fn tr_on_list(t: *mut Trades, ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let id: i32 = mc_version.version_pid(ver, mc_sem.SEM_PLAY_S2C_TRADE_LIST)
    if id < 0 { return false }
    let sch: u64 = (*ver).schema_of(mc_version.ST_PLAY, mc_version.DIR_S2C, id)
    if sch == 0 as u64 { return false }
    let p0: usize = bytes.bytes_pos(b)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk_values(sch, b, &out)
    bytes.bytes_set_pos(b, p0)
    if !ok {
        rt.buf_free(&out)
        return false
    }
    let keep_sel: i32 = (*t).sel
    let keep_scroll: i32 = (*t).scroll
    tr_clear(t)
    let good: bool = apply_lines(t, rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
    if !good {
        tr_clear(t)
        return false
    }
    if keep_sel >= 0 && keep_sel < (*t).n { (*t).sel = keep_sel }
    tr_set_scroll(t, keep_scroll)
    return true
}
