export { skin_u, skin_v, SKIN_EDGE, face_k }

const SKIN_EDGE: f64 = 0.02

fn face_k(face: i32) -> i32 {
    if face < 2 { return 204 }
    if face == 2 { return 256 }
    if face == 3 { return 128 }
    return 153
}

fn clampf(v: f64, lo: f64, hi: f64) -> f64 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn skin_u(face: i32, tx: f64, tz: f64, u0: f64, w: f64, d: f64) -> f64 {
    var lo: f64 = u0
    var hi: f64 = u0 + d
    var t: f64 = 0.0
    if face == 0 {
        t = 1.0 - tz
    } else if face == 1 {
        lo = u0 + d + w
        hi = lo + d
        t = tz
    } else if face == 2 || face == 4 {
        lo = u0 + d
        hi = lo + w
        t = tx
    } else if face == 3 {
        lo = u0 + d + w
        hi = lo + w
        t = tx
    } else {
        lo = u0 + d + w + d
        hi = lo + w
        t = 1.0 - tx
    }
    return clampf(lo + (hi - lo) * t, lo + SKIN_EDGE, hi - SKIN_EDGE)
}

fn skin_v(face: i32, ty: f64, tz: f64, v0: f64, h: f64, d: f64) -> f64 {
    var lo: f64 = v0
    var hi: f64 = v0 + d
    var t: f64 = 0.0
    if face == 2 {
        t = 1.0 - tz
    } else if face == 3 {
        t = tz
    } else {
        lo = v0 + d
        hi = lo + h
        t = ty
    }
    return clampf(lo + (hi - lo) * t, lo + SKIN_EDGE, hi - SKIN_EDGE)
}
