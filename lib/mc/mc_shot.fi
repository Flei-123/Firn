import std.rt
import std.fs
import std.time
import mc.mc_launch_cfg
import html.mem
import paint.canvas
import paint.png

export { shot_path, shot_save }

const DIR_NAME: str = "/screenshots"
const EXT: str = ".png"

fn push_dec2(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (48 + (v / 10 as u32) % 10 as u32) as u8)
    rt.buf_push(b, (48 + v % 10 as u32) as u8)
}

fn push_lit(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn parent_len(path: u64, n: usize) -> usize {
    var i: usize = n
    while i > 0 {
        let ch: u8 = rt.ld8(path, i - 1)
        if ch == 47 as u8 || ch == 92 as u8 { return i - 1 }
        i = i - 1
    }
    return 0
}

fn shot_path(out: *mut rt.Buf, now_unix_ms: i64) -> bool {
    var base: rt.Buf = rt.buf_new()
    if !mc_launch_cfg.cfg_default_path(&base) {
        rt.buf_free(&base)
        return false
    }
    let pl: usize = parent_len(rt.buf_ptr(&base), rt.buf_len(&base))
    if pl == 0 {
        rt.buf_free(&base)
        return false
    }
    rt.buf_push_bytes(out, rt.buf_ptr(&base), pl)
    push_lit(out, DIR_NAME)
    fs.mkdir_all(rt.buf_str(out)) catch false
    rt.buf_push(out, 47 as u8)
    let t: time.DateTime = time.civil_from_unix(now_unix_ms)
    rt.buf_push_dec_i64(out, t.year as i64)
    rt.buf_push(out, 45 as u8)
    push_dec2(out, t.month)
    rt.buf_push(out, 45 as u8)
    push_dec2(out, t.day)
    rt.buf_push(out, 95 as u8)
    push_dec2(out, t.hour)
    rt.buf_push(out, 46 as u8)
    push_dec2(out, t.minute)
    rt.buf_push(out, 46 as u8)
    push_dec2(out, t.second)
    push_lit(out, EXT)
    rt.buf_push(out, 0 as u8)
    rt.buf_free(&base)
    return true
}

fn shot_save(px: u64, w: i32, h: i32, out: *mut rt.Buf) -> bool {
    if px == 0 as u64 || w <= 0 || h <= 0 { return false }
    if !shot_path(out, time.now_unix_ms()) { return false }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, w as usize, h as usize) { return false }
    rt.mem_copy(canvas.canvas_pixels(&cv) as u64, px, (w as usize) * (h as usize) * 4)
    var enc: mem.Buf = mem.buf_new()
    var ok: bool = png.write_png(&cv, &enc)
    if ok { ok = rt.write_file(rt.buf_ptr(out), mem.buf_ptr(&enc) as u64, mem.buf_len(&enc)) }
    mem.buf_free(&enc)
    canvas.canvas_free(&cv)
    return ok
}
