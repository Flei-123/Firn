// SPDX-License-Identifier: MPL-2.0
import std.math

export { ray_clear }

fn ray_clear(solid: fn(u64, i32, i32, i32) -> bool, ud: u64, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) -> bool {
    let dx: f64 = bx - ax
    let dy: f64 = by - ay
    let dz: f64 = bz - az
    var x: i32 = math.floor(ax) as i32
    var y: i32 = math.floor(ay) as i32
    var z: i32 = math.floor(az) as i32
    var sx: i32 = 0
    var sy: i32 = 0
    var sz: i32 = 0
    var tx: f64 = 1.0e30
    var ty: f64 = 1.0e30
    var tz: f64 = 1.0e30
    var ddx: f64 = 1.0e30
    var ddy: f64 = 1.0e30
    var ddz: f64 = 1.0e30
    if dx > 0.0 {
        sx = 1
        ddx = 1.0 / dx
        tx = ((x + 1) as f64 - ax) * ddx
    } else if dx < 0.0 {
        sx = 0 - 1
        ddx = 0.0 - 1.0 / dx
        tx = (ax - (x as f64)) * ddx
    }
    if dy > 0.0 {
        sy = 1
        ddy = 1.0 / dy
        ty = ((y + 1) as f64 - ay) * ddy
    } else if dy < 0.0 {
        sy = 0 - 1
        ddy = 0.0 - 1.0 / dy
        ty = (ay - (y as f64)) * ddy
    }
    if dz > 0.0 {
        sz = 1
        ddz = 1.0 / dz
        tz = ((z + 1) as f64 - az) * ddz
    } else if dz < 0.0 {
        sz = 0 - 1
        ddz = 0.0 - 1.0 / dz
        tz = (az - (z as f64)) * ddz
    }
    let t_end: f64 = 1.0 - 1.0e-6
    var steps: i32 = 0
    while steps < 512 {
        if solid(ud, x, y, z) { return false }
        var t: f64 = tx
        if ty < t { t = ty }
        if tz < t { t = tz }
        if t >= t_end { return true }
        if tx <= ty && tx <= tz {
            x = x + sx
            tx = tx + ddx
        } else if ty <= tz {
            y = y + sy
            ty = ty + ddy
        } else {
            z = z + sz
            tz = tz + ddz
        }
        steps = steps + 1
    }
    return true
}
