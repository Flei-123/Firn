import std.rt
import mc.mc_raster
import mc.mc_gui_tex
import mc.mc_item_src

export {
    SlotHint, shint_new, shint_free, shint_open, shint_ok, shint_has, shint_draw, shint_cycle, shint_armor,
    SH_HELMET, SH_CHESTPLATE, SH_LEGGINGS, SH_BOOTS, SH_SHIELD, SH_LAPIS, SH_BANNER, SH_DYE, SH_PATTERN, SH_FUEL, SH_COUNT,
    CYCLE_TEMPLATE, CYCLE_BASE, CYCLE_ADDITION,
}

const SH_HELMET: i32 = 0
const SH_CHESTPLATE: i32 = 1
const SH_LEGGINGS: i32 = 2
const SH_BOOTS: i32 = 3
const SH_SHIELD: i32 = 4
const SH_LAPIS: i32 = 5
const SH_SWORD: i32 = 6
const SH_PICKAXE: i32 = 7
const SH_AXE: i32 = 8
const SH_HOE: i32 = 9
const SH_SHOVEL: i32 = 10
const SH_INGOT: i32 = 11
const SH_REDSTONE: i32 = 12
const SH_QUARTZ: i32 = 13
const SH_DIAMOND: i32 = 14
const SH_EMERALD: i32 = 15
const SH_AMETHYST: i32 = 16
const SH_TRIM: i32 = 17
const SH_UPGRADE: i32 = 18
const SH_BANNER: i32 = 19
const SH_DYE: i32 = 20
const SH_PATTERN: i32 = 21
const SH_FUEL: i32 = 22
const SH_COUNT: i32 = 23
const CYCLE_TEMPLATE: i32 = 0
const CYCLE_BASE: i32 = 1
const CYCLE_ADDITION: i32 = 2
const CYCLE_MS: u64 = 1500 as u64
const ICON: i32 = 16
const WHITE: u32 = 0xFFFFFFFF

struct SlotHint {
    tex: [mc_gui_tex.GuiTex; 23],
}

fn shint_new() -> SlotHint {
    return SlotHint { tex: [mc_gui_tex.gtex_empty(); 23] }
}

fn shint_free(h: *mut SlotHint) {
    var k: i32 = 0
    while k < SH_COUNT {
        mc_gui_tex.gtex_free(&(*h).tex[k as usize])
        k = k + 1
    }
}

fn shint_ok(h: *mut SlotHint) -> bool {
    return shint_has(h, SH_HELMET)
}

fn shint_has(h: *mut SlotHint, which: i32) -> bool {
    if which < 0 || which >= SH_COUNT { return false }
    return mc_gui_tex.gtex_ok(&(*h).tex[which as usize])
}

fn short_name(which: i32) -> str {
    if which == SH_HELMET { return "helmet" }
    if which == SH_CHESTPLATE { return "chestplate" }
    if which == SH_LEGGINGS { return "leggings" }
    if which == SH_BOOTS { return "boots" }
    if which == SH_SHIELD { return "shield" }
    if which == SH_LAPIS { return "lapis_lazuli" }
    if which == SH_SWORD { return "sword" }
    if which == SH_PICKAXE { return "pickaxe" }
    if which == SH_AXE { return "axe" }
    if which == SH_HOE { return "hoe" }
    if which == SH_SHOVEL { return "shovel" }
    if which == SH_INGOT { return "ingot" }
    if which == SH_REDSTONE { return "redstone_dust" }
    if which == SH_QUARTZ { return "quartz" }
    if which == SH_DIAMOND { return "diamond" }
    if which == SH_EMERALD { return "emerald" }
    if which == SH_AMETHYST { return "amethyst_shard" }
    if which == SH_TRIM { return "smithing_template_armor_trim" }
    if which == SH_UPGRADE { return "smithing_template_netherite_upgrade" }
    if which == SH_BANNER { return "banner" }
    if which == SH_DYE { return "dye" }
    if which == SH_PATTERN { return "banner_pattern" }
    return "brewing_fuel"
}

fn push_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.length())
}

fn load_one(src: *mut mc_item_src.ItemSrc, prefix: str, name: str, out: *mut mc_gui_tex.GuiTex) -> bool {
    var b: rt.Buf = rt.buf_new()
    push_str(&b, prefix)
    push_str(&b, name)
    push_str(&b, ".png")
    let ok: bool = mc_item_src.isrc_tex_full(src, rt.buf_ptr(&b), rt.buf_len(&b), out)
    rt.buf_free(&b)
    return ok
}

fn shint_open(h: *mut SlotHint, src: *mut mc_item_src.ItemSrc) -> bool {
    var k: i32 = 0
    while k < SH_COUNT {
        let name: str = short_name(k)
        let t: *mut mc_gui_tex.GuiTex = &(*h).tex[k as usize]
        var ok: bool = load_one(src, "assets/minecraft/textures/gui/sprites/container/slot/", name, t)
        if !ok && k <= SH_SHIELD { ok = load_one(src, "assets/minecraft/textures/item/empty_armor_slot_", name, t) }
        if !ok && k > SH_SHIELD { ok = load_one(src, "assets/minecraft/textures/item/empty_slot_", name, t) }
        k = k + 1
    }
    return shint_ok(h)
}

fn shint_draw(r: *mut mc_raster.Raster, h: *mut SlotHint, which: i32, x: i32, y: i32, s: i32) {
    if !shint_has(h, which) { return }
    let t: *mut mc_gui_tex.GuiTex = &(*h).tex[which as usize]
    mc_gui_tex.gtex_draw(r, t, x, y, ICON * s, ICON * s, 0, 0, (*t).w, (*t).h, WHITE)
}

fn shint_armor(ws: i32) -> i32 {
    if ws >= 5 && ws <= 8 { return ws - 5 }
    if ws == 45 { return SH_SHIELD }
    return 0 - 1
}

fn cycle_len(group: i32) -> i32 {
    if group == CYCLE_TEMPLATE { return 2 }
    if group == CYCLE_BASE { return 9 }
    return 7
}

fn cycle_at(group: i32, i: i32) -> i32 {
    if group == CYCLE_TEMPLATE {
        if i == 0 { return SH_TRIM }
        return SH_UPGRADE
    }
    if group == CYCLE_BASE {
        if i == 0 { return SH_HELMET }
        if i == 1 { return SH_SWORD }
        if i == 2 { return SH_CHESTPLATE }
        if i == 3 { return SH_PICKAXE }
        if i == 4 { return SH_LEGGINGS }
        if i == 5 { return SH_AXE }
        if i == 6 { return SH_BOOTS }
        if i == 7 { return SH_HOE }
        return SH_SHOVEL
    }
    if i == 0 { return SH_INGOT }
    if i == 1 { return SH_REDSTONE }
    if i == 2 { return SH_LAPIS }
    if i == 3 { return SH_QUARTZ }
    if i == 4 { return SH_DIAMOND }
    if i == 5 { return SH_EMERALD }
    return SH_AMETHYST
}

fn shint_cycle(group: i32, now_ms: u64) -> i32 {
    let n: i32 = cycle_len(group)
    return cycle_at(group, ((now_ms / CYCLE_MS) % (n as u64)) as i32)
}
