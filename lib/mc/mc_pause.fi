import std.rt
import std.env
import mc.mc_raster
import mc.mc_hud
import mc.mc_gui_pack
import mc.mc_gui_ui
import mc.mc_menu_opts
import mc.mc_opts
import mc.mc_launch_cfg
import mc.mc_keybinds

export {
    Pause,
    pause_bind_keys, pause_set_capture, pause_wanted, pause_ready, pause_active, pause_open, pause_close, pause_release, pause_frame, pause_opts, pause_take_changed, pause_load_opts, pause_persist, pause_init_from_cfg,
    PA_NONE, PA_RESUME, PA_DISCONNECT,
}

const PA_NONE: i32 = 0
const PA_RESUME: i32 = 1
const PA_DISCONNECT: i32 = 2
const SCREEN_MAIN: i32 = 0
const SCREEN_OPTIONS: i32 = 1
const PACK_UNTRIED: i32 = 0
const PACK_OK: i32 = 1
const PACK_FAILED: i32 = 2
const STATE_BYTES: usize = 32768
const GRID_H: i32 = 166
const WIDE_W: i32 = 204
const HALF_W: i32 = 98

struct Pause {
    active: bool,
    pack_state: i32,
    pk: mc_gui_pack.GuiPack,
    ui: mc_gui_ui.Ui,
    ou: mc_menu_opts.OptsUi,
    opts: mc_opts.Opts,
    screen: i32,
    changed: bool,
    skip_esc: bool,
    protocol: i32,
    kb: *mut mc_keybinds.Keybinds,
    own_kb: mc_keybinds.Keybinds,
    cap: i32,
}

static mut PAUSE_PTR: u64 = 0 as u64

fn state() -> *mut Pause {
    if PAUSE_PTR == 0 as u64 {
        let p: u64 = rt.heap_alloc(STATE_BYTES)
        PAUSE_PTR = p
        let s: *mut Pause = p as *mut Pause
        *s = Pause {
            active: false, pack_state: PACK_UNTRIED, pk: mc_gui_pack.gpack_new(), ui: mc_gui_ui.ui_new(), ou: mc_menu_opts.optui_new(),
            opts: mc_opts.opts_new(), screen: SCREEN_MAIN, changed: false, skip_esc: false, protocol: 0, kb: 0 as *mut mc_keybinds.Keybinds, own_kb: mc_keybinds.kb_new(), cap: 0,
        }
        (*s).ui.in_game = true
    }
    return PAUSE_PTR as *mut Pause
}

fn pause_bind_keys(kb: *mut mc_keybinds.Keybinds) {
    (*state()).kb = kb
}

fn pause_set_capture(code: i32) {
    (*state()).cap = code
}

fn pause_wanted() -> bool {
    if env.has("MCPLAY_PAUSE") && env.get("MCPLAY_PAUSE").length() > 0 && env.get("MCPLAY_PAUSE").chars(0) == 48 as u8 { return false }
    return true
}

fn pause_ready(protocol: i32) -> bool {
    if !pause_wanted() { return false }
    let s: *mut Pause = state()
    if (*s).pack_state == PACK_UNTRIED {
        (*s).protocol = protocol
        if mc_gui_pack.gpack_open(&(*s).pk, protocol) { (*s).pack_state = PACK_OK } else { (*s).pack_state = PACK_FAILED }
    }
    return (*s).pack_state == PACK_OK
}

fn pause_active() -> bool {
    if PAUSE_PTR == 0 as u64 { return false }
    return (*state()).active
}

fn pause_opts() -> *mut mc_opts.Opts {
    return &(*state()).opts
}

fn pause_load_opts(o: *mut mc_opts.Opts) {
    (*state()).opts = *o
}

fn pause_take_changed() -> bool {
    let s: *mut Pause = state()
    let c: bool = (*s).changed
    (*s).changed = false
    return c
}

fn pause_open() {
    let s: *mut Pause = state()
    (*s).active = true
    (*s).screen = SCREEN_MAIN
    (*s).skip_esc = true
    mc_menu_opts.optui_reset(&(*s).ou)
}

fn pause_close() {
    (*state()).active = false
}

fn pause_release() {
    if PAUSE_PTR == 0 as u64 { return }
    let s: *mut Pause = PAUSE_PTR as *mut Pause
    mc_gui_pack.gpack_free(&(*s).pk)
    mc_gui_ui.ui_free(&(*s).ui)
    rt.heap_free(PAUSE_PTR, STATE_BYTES)
    PAUSE_PTR = 0 as u64
}

fn pause_persist() {
    let s: *mut Pause = state()
    var path: rt.Buf = rt.buf_new()
    if mc_launch_cfg.cfg_default_path(&path) {
        var cfg: mc_launch_cfg.LaunchCfg = mc_launch_cfg.cfg_new()
        let ps: str = rt.buf_str(&path)
        mc_launch_cfg.cfg_load(ps, &cfg)
        cfg.opts = (*s).opts
        mc_launch_cfg.cfg_save(ps, &cfg)
        mc_launch_cfg.cfg_free(&cfg)
    }
    rt.buf_free(&path)
}

fn main_screen(u: *mut mc_gui_ui.Ui) -> i32 {
    let cx: i32 = (*u).uw / 2
    let y0: i32 = ((*u).uh - GRID_H) / 4
    mc_gui_ui.ui_label_c(u, cx, 40, mc_gui_ui.COLOR_WHITE, mc_gui_ui.ui_lang(u, "menu.game", "Game Menu"))
    var act: i32 = PA_NONE
    if mc_gui_ui.ui_button(u, cx - 102, y0 + 50, WIDE_W, mc_gui_ui.ui_lang(u, "menu.returnToGame", "Back to Game"), true) { act = PA_RESUME }
    mc_gui_ui.ui_button(u, cx - 102, y0 + 74, HALF_W, mc_gui_ui.ui_lang(u, "gui.advancements", "Advancements"), false)
    mc_gui_ui.ui_button(u, cx + 4, y0 + 74, HALF_W, mc_gui_ui.ui_lang(u, "gui.stats", "Statistics"), false)
    mc_gui_ui.ui_button(u, cx - 102, y0 + 98, HALF_W, mc_gui_ui.ui_lang(u, "menu.sendFeedback", "Give Feedback"), false)
    mc_gui_ui.ui_button(u, cx + 4, y0 + 98, HALF_W, mc_gui_ui.ui_lang(u, "menu.reportBugs", "Report Bugs"), false)
    if mc_gui_ui.ui_button(u, cx - 102, y0 + 122, HALF_W, mc_gui_ui.ui_lang(u, "menu.options", "Options..."), true) { act = 3 }
    mc_gui_ui.ui_button(u, cx + 4, y0 + 122, HALF_W, mc_gui_ui.ui_lang(u, "menu.shareToLan", "Open to LAN"), false)
    if mc_gui_ui.ui_button(u, cx - 102, y0 + 146, WIDE_W, mc_gui_ui.ui_lang(u, "menu.disconnect", "Disconnect"), true) { act = PA_DISCONNECT }
    return act
}

fn pause_frame(r: *mut mc_raster.Raster, mx: i32, my: i32, pressed: bool, down: bool, wheel: i32, ms: u64, esc: bool) -> i32 {
    let s: *mut Pause = state()
    if !(*s).active || (*s).pack_state != PACK_OK { return PA_NONE }
    let u: *mut mc_gui_ui.Ui = &(*s).ui
    mc_gui_ui.ui_begin(u, r, &(*s).pk, mc_hud.hud_scale((*r).w, (*r).h), mx, my, pressed, ms)
    mc_gui_ui.ui_set_down(u, down, wheel)
    (*u).key_esc = esc && !(*s).skip_esc
    (*s).skip_esc = false
    (*u).cap = (*s).cap
    (*s).cap = 0
    var kb: *mut mc_keybinds.Keybinds = (*s).kb
    if kb == 0 as *mut mc_keybinds.Keybinds { kb = &(*s).own_kb }
    var res: i32 = PA_NONE
    if (*s).screen == SCREEN_MAIN {
        mc_gui_ui.ui_dirt(u, 0x404040)
        let a: i32 = main_screen(u)
        if a == 3 {
            (*s).screen = SCREEN_OPTIONS
            mc_menu_opts.optui_reset(&(*s).ou)
        } else if a != PA_NONE {
            res = a
        } else if (*u).key_esc {
            res = PA_RESUME
        }
    } else {
        if mc_menu_opts.optui_frame(u, &(*s).ou, &(*s).opts, kb) { (*s).screen = SCREEN_MAIN }
        if (*s).ou.changed {
            (*s).ou.changed = false
            (*s).changed = true
        }
    }
    mc_gui_ui.ui_end_frame(u)
    return res
}

fn pause_init_from_cfg() -> bool {
    var path: rt.Buf = rt.buf_new()
    var ok: bool = false
    if mc_launch_cfg.cfg_default_path(&path) {
        var cfg: mc_launch_cfg.LaunchCfg = mc_launch_cfg.cfg_new()
        if mc_launch_cfg.cfg_load(rt.buf_str(&path), &cfg) {
            (*state()).opts = cfg.opts
            ok = true
        }
        mc_launch_cfg.cfg_free(&cfg)
    }
    rt.buf_free(&path)
    return ok
}
