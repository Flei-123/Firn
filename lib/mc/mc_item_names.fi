// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.str
import mc.mc_text

export { names_load, names_ok, names_tr, names_find, names_title, names_item, names_ench, names_attr, names_release }

const STATE_BYTES: usize = 4096

struct Names {
    tr: mc_text.Translations,
    raw: rt.Buf,
    ok: bool,
}

static mut NAMES_PTR: u64 = 0

fn state() -> *mut Names {
    if NAMES_PTR == 0 as u64 {
        let p: u64 = rt.heap_alloc(STATE_BYTES)
        NAMES_PTR = p
        let s: *mut Names = p as *mut Names
        *s = Names { tr: mc_text.tr_new(), raw: rt.buf_new(), ok: false }
    }
    return NAMES_PTR as *mut Names
}

fn names_release() {
    if NAMES_PTR == 0 as u64 { return }
    let s: *mut Names = NAMES_PTR as *mut Names
    mc_text.tr_free(&(*s).tr)
    rt.buf_free(&(*s).raw)
    rt.heap_free(NAMES_PTR, STATE_BYTES)
    NAMES_PTR = 0 as u64
}

fn names_load(p: u64, n: usize) -> bool {
    let s: *mut Names = state()
    rt.buf_clear(&(*s).raw)
    rt.buf_push_bytes(&(*s).raw, p, n)
    (*s).ok = mc_text.tr_load(&(*s).tr, rt.buf_ptr(&(*s).raw), rt.buf_len(&(*s).raw))
    return (*s).ok
}

fn names_ok() -> bool {
    if NAMES_PTR == 0 as u64 { return false }
    return (*state()).ok
}

fn names_tr() -> *mut mc_text.Translations { return &(*state()).tr }

fn names_find(kp: u64, kn: usize, out: *mut rt.Buf) -> bool {
    if !names_ok() { return false }
    let sp: str.Span = mc_text.tr_find(&(*state()).tr, kp, kn)
    if sp.n == 0 { return false }
    rt.buf_push_bytes(out, sp.p as u64, sp.n)
    return true
}

fn names_title(p: u64, n: usize, out: *mut rt.Buf) {
    var up: bool = true
    var i: usize = 0
    while i < n {
        var ch: u8 = rt.ld8(p, i)
        if ch == 95 as u8 {
            rt.buf_push(out, 32 as u8)
            up = true
        } else {
            if up && ch >= 97 as u8 && ch <= 122 as u8 { ch = ch - 32 as u8 }
            rt.buf_push(out, ch)
            up = false
        }
        i = i + 1
    }
}

fn strip_ns(p: u64, n: usize, out_p: *mut u64, out_n: *mut usize) -> bool {
    var i: usize = 0
    while i < n && rt.ld8(p, i) != 58 as u8 { i = i + 1 }
    if i >= n {
        *out_p = p
        *out_n = n
        return true
    }
    *out_p = p + ((i + 1) as u64)
    *out_n = n - i - 1
    return i == 9 && rt.mem_eq(p, "minecraft".p as u64, 9)
}

fn scoped(a: str, b: str, p: u64, n: usize, out: *mut rt.Buf) {
    var ip: u64 = 0
    var inn: usize = 0
    let vanilla: bool = strip_ns(p, n, &ip, &inn)
    if vanilla && names_ok() {
        var k: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&k, a.p as u64, a.n)
        rt.buf_push_bytes(&k, ip, inn)
        var hit: bool = names_find(rt.buf_ptr(&k), rt.buf_len(&k), out)
        if !hit && b.n > 0 {
            rt.buf_clear(&k)
            rt.buf_push_bytes(&k, b.p as u64, b.n)
            rt.buf_push_bytes(&k, ip, inn)
            hit = names_find(rt.buf_ptr(&k), rt.buf_len(&k), out)
        }
        rt.buf_free(&k)
        if hit { return }
    }
    names_title(ip, inn, out)
}

fn names_item(p: u64, n: usize, out: *mut rt.Buf) {
    scoped("item.minecraft.", "block.minecraft.", p, n, out)
}

fn names_ench(p: u64, n: usize, out: *mut rt.Buf) {
    scoped("enchantment.minecraft.", "", p, n, out)
}

fn names_attr(p: u64, n: usize, out: *mut rt.Buf) {
    var ip: u64 = 0
    var inn: usize = 0
    let vanilla: bool = strip_ns(p, n, &ip, &inn)
    if vanilla && names_ok() {
        var k: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&k, "attribute.name.".p as u64, 15)
        rt.buf_push_bytes(&k, ip, inn)
        var hit: bool = names_find(rt.buf_ptr(&k), rt.buf_len(&k), out)
        if !hit {
            rt.buf_clear(&k)
            rt.buf_push_bytes(&k, "attribute.name.generic.".p as u64, 23)
            rt.buf_push_bytes(&k, ip, inn)
            hit = names_find(rt.buf_ptr(&k), rt.buf_len(&k), out)
        }
        rt.buf_free(&k)
        if hit { return }
    }
    var dot: usize = 0
    var i: usize = 0
    while i < inn {
        if rt.ld8(ip, i) == 46 as u8 { dot = i + 1 }
        i = i + 1
    }
    names_title(ip + (dot as u64), inn - dot, out)
}
