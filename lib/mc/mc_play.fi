// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_play.fi -- window free play logic for demos/mcplay: key map, block face numbers, Block Update decoding and the
// serverbound senders (position, dig, place, hotbar slot, swing). Everything here runs without a window or a GPU.
//
//     mc_play.key_bit(scancode)            -> mc_input.K_* bit (0 = not a movement key); Linux evdev scancodes (input.raw)
//     mc_play.hotbar_of(scancode)          -> 0..8 for the keys 1..9, else -1
//     mc_play.face_of(nx, ny, nz)          -> protocol face 0..5 (0 -Y, 1 +Y, 2 -Z, 3 +Z, 4 -X, 5 +X), -1 for no face
//     mc_play.decode_block_change(b, &x, &y, &z, &state)                    Block Update (1.9+): u64 position + varint state
//     mc_play.multi_begin(b, protocol, &x0, &y0, &z0, &n); multi_next(b, &x, &y, &z, &state)   Multi Block Change
//
// 1.20.1 layouts (protocol 763; minecraft-data, see docs/mc/play.md): Block Update = position u64 (x26 z26 y12) + varint state.
// Multi Block Change = u64 section (x22 z22 y20, signed) + varint n + n * varlong (state << 12 | lx << 8 | lz << 4 | ly); protocols
// 751..762 have a bool (trust edges) between the section and the count. Pre-1.9 (protocol < 107) is not decoded here.
import std.rt
import std.bytes
import std.time
import mc.mc_client
import mc.mc_encode
import mc.mc_sem
import mc.mc_version
import mc.mc_input

export {
    key_bit, hotbar_of, face_of, decode_block_change, multi_begin, multi_next,
    send_pos_look, send_dig, send_place, send_slot, send_sneak, send_loaded, send_swing, send_chat, send_command, send_client_command,
    send_attack, send_interact, send_interact_at, send_use_item, section_of,
    CLIENT_RESPAWN, CLIENT_STATS, USE_ATTACK,
    DIG_START, DIG_CANCEL, DIG_FINISH, DIG_RELEASE_USE, HAND_MAIN, USE_INTERACT, USE_INTERACT_AT,
}

const DIG_START: i32 = 0
const DIG_CANCEL: i32 = 1
const DIG_FINISH: i32 = 2
const DIG_RELEASE_USE: i32 = 5
const HAND_MAIN: i32 = 0
const CLIENT_RESPAWN: i32 = 0
const CLIENT_STATS: i32 = 1
const USE_ATTACK: i32 = 1
const USE_INTERACT: i32 = 0
const USE_INTERACT_AT: i32 = 2

// Linux evdev scancodes (input.raw): W 17, A 30, S 31, D 32, Space 57, LShift 42, LCtrl 29, digits 2..10.
fn key_bit(sc: u32) -> u32 {
    if sc == 17 as u32 { return mc_input.K_FORWARD }
    if sc == 31 as u32 { return mc_input.K_BACK }
    if sc == 30 as u32 { return mc_input.K_LEFT }
    if sc == 32 as u32 { return mc_input.K_RIGHT }
    if sc == 57 as u32 { return mc_input.K_JUMP }
    if sc == 42 as u32 { return mc_input.K_SNEAK }
    if sc == 29 as u32 { return mc_input.K_SPRINT }
    return 0 as u32
}

fn hotbar_of(sc: u32) -> i32 {
    if sc >= 2 as u32 && sc <= 10 as u32 { return (sc as i32) - 2 }
    return 0 - 1
}

// Face that was entered by the pick ray (Pick.nx/ny/nz points back to the ray origin) -> the face number of the dig / place packets.
fn face_of(nx: i32, ny: i32, nz: i32) -> i32 {
    if ny < 0 { return 0 }
    if ny > 0 { return 1 }
    if nz < 0 { return 2 }
    if nz > 0 { return 3 }
    if nx < 0 { return 4 }
    if nx > 0 { return 5 }
    return 0 - 1
}

fn decode_block_change(b: *mut bytes.Bytes, x: *mut i32, y: *mut i32, z: *mut i32, state: *mut i32) -> bool {
    let ok: bool = bytes.get_position(b, x, y, z) catch false
    if !ok { return false }
    let s: i32 = bytes.get_varint(b) catch (0 - 1)
    if s < 0 { return false }
    *state = s
    return true
}

// Section coordinates (sx, sy, sz) of a Multi Block Change header, signed fields of the u64 (x22 z22 y20).
fn section_of(v: u64, sx: *mut i32, sy: *mut i32, sz: *mut i32) {
    var x: i64 = (v >> 42 as u64) as i64
    var z: i64 = ((v >> 20 as u64) & 4194303 as u64) as i64
    var y: i64 = (v & 1048575 as u64) as i64
    if x >= 2097152 { x = x - 4194304 }
    if z >= 2097152 { z = z - 4194304 }
    if y >= 524288 { y = y - 1048576 }
    *sx = x as i32
    *sy = y as i32
    *sz = z as i32
}

// Reads the header; returns the number of records (-1 = bad packet). (x0, y0, z0) = block origin of the section.
fn multi_begin(b: *mut bytes.Bytes, protocol: i32, x0: *mut i32, y0: *mut i32, z0: *mut i32) -> i32 {
    let v: u64 = bytes.get_u64(b) catch 0
    var sx: i32 = 0
    var sy: i32 = 0
    var sz: i32 = 0
    section_of(v, &sx, &sy, &sz)
    *x0 = sx * 16
    *y0 = sy * 16
    *z0 = sz * 16
    if protocol >= 751 && protocol < 763 {
        bytes.get_bool(b) catch false
    }
    let n: i32 = bytes.get_varint(b) catch (0 - 1)
    if n < 0 || n > 4096 { return 0 - 1 }
    return n
}

// One record: absolute block position + state id. false when the packet ends early.
fn multi_next(b: *mut bytes.Bytes, x0: i32, y0: i32, z0: i32, x: *mut i32, y: *mut i32, z: *mut i32, state: *mut i32) -> bool {
    var bad: bool = false
    let r: i64 = bytes.get_varlong(b) catch 0 - 1
    if r < 0 { bad = true }
    if bad { return false }
    *state = (r >> 12 as i64) as i32
    *x = x0 + (((r >> 8 as i64) & 15 as i64) as i32)
    *z = z0 + (((r >> 4 as i64) & 15 as i64) as i32)
    *y = y0 + ((r & 15 as i64) as i32)
    return true
}

// ---------------------------------------------------------------- senders (schema driven, any version with the packet)

fn send_pos_look(cl: *mut mc_client.Client, x: f64, y: f64, z: f64, yaw: f64, pitch: f64, on_ground: bool) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_f64(&v, "x", x)
    mc_encode.vals_f64(&v, "y", y)
    mc_encode.vals_f64(&v, "z", z)
    mc_encode.vals_f32(&v, "yaw", yaw as f32)
    mc_encode.vals_f32(&v, "pitch", pitch as f32)
    mc_encode.vals_bool(&v, "onGround", on_ground)
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_POSITION_LOOK, &v)
    rt.buf_free(&v)
    return ok
}

fn send_dig(cl: *mut mc_client.Client, status: i32, x: i32, y: i32, z: i32, face: i32, seq: i32) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "status", status as i64)
    mc_encode.vals_i64(&v, "location.x", x as i64)
    mc_encode.vals_i64(&v, "location.y", y as i64)
    mc_encode.vals_i64(&v, "location.z", z as i64)
    mc_encode.vals_i64(&v, "face", face as i64)
    mc_encode.vals_i64(&v, "sequence", seq as i64)
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_BLOCK_DIG, &v)
    rt.buf_free(&v)
    return ok
}

// Place against the block (x, y, z) on its `face`; the cursor is the middle of the face.
fn send_place(cl: *mut mc_client.Client, x: i32, y: i32, z: i32, face: i32, seq: i32) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "hand", HAND_MAIN as i64)
    mc_encode.vals_i64(&v, "location.x", x as i64)
    mc_encode.vals_i64(&v, "location.y", y as i64)
    mc_encode.vals_i64(&v, "location.z", z as i64)
    mc_encode.vals_i64(&v, "direction", face as i64)
    mc_encode.vals_f32(&v, "cursorX", 0.5f)
    mc_encode.vals_f32(&v, "cursorY", 0.5f)
    mc_encode.vals_f32(&v, "cursorZ", 0.5f)
    mc_encode.vals_bool(&v, "insideBlock", false)
    mc_encode.vals_bool(&v, "worldBorderHit", false) // 1.21.2+
    mc_encode.vals_i64(&v, "sequence", seq as i64)
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_BLOCK_PLACE, &v)
    rt.buf_free(&v)
    return ok
}

// Tell the server that the player starts / stops sneaking. The server decides from this state whether a right click on a block uses the block
// (chest opens) or places the held item (sneaking with an item in hand). Measured against the real servers (tools/mcclient/sneak_probe.sh):
// up to 1.21.1 (protocol 767) Entity Action 0 / 1 (press / release shift key); 1.21.2 - 1.21.5 (768 - 770) the server reads Player Input
// (shift) only for predicates and still takes the sneak state from Entity Action (1.21.4 / 1.21.5 ignore Player Input for sneaking), so
// both packets go out like the vanilla client does; 1.21.6+ (771+) removed Entity Action 0 / 1, Player Input (shift) sets the state
// (1.21.8 proven). `eid` is the own entity id of Join Game.
fn send_sneak(cl: *mut mc_client.Client, eid: i32, on: bool) -> bool {
    var ok: bool = true
    let proto: i32 = (*cl).ver.protocol
    if proto < 771 {
        var v: rt.Buf = rt.buf_new()
        mc_encode.vals_i64(&v, "entityId", eid as i64)
        if on { mc_encode.vals_i64(&v, "actionId", 0) } else { mc_encode.vals_i64(&v, "actionId", 1) }
        mc_encode.vals_i64(&v, "jumpBoost", 0)
        ok = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_ENTITY_ACTION, &v)
        rt.buf_free(&v)
    }
    if proto >= 768 {
        var v2: rt.Buf = rt.buf_new()
        mc_encode.vals_bool(&v2, "inputs.shift", on)
        let ok2: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_PLAYER_INPUT, &v2)
        rt.buf_free(&v2)
        ok = ok && ok2
    }
    return ok
}

// Player Loaded (1.21.4+, protocol 769): the vanilla client sends it once the world around the player has arrived. Until then (or until the
// server's own timeout of ~3 s) the server IGNORES Entity Action / Player Input, so a sneak sent right after the join is lost (measured with
// tools/mcclient/sneak_probe.sh on 1.21.4). Returns true when nothing had to be sent (older protocol) or the packet went out.
fn send_loaded(cl: *mut mc_client.Client) -> bool {
    if (*cl).ver.protocol < 769 { return true }
    var v: rt.Buf = rt.buf_new()
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_PLAYER_LOADED, &v)
    rt.buf_free(&v)
    return ok
}

fn send_slot(cl: *mut mc_client.Client, slot: i32) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "slotId", slot as i64)
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_HELD_ITEM_SLOT, &v)
    rt.buf_free(&v)
    return ok
}

fn send_swing(cl: *mut mc_client.Client, seq: i32) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "hand", HAND_MAIN as i64)
    mc_encode.vals_i64(&v, "sequence", seq as i64)
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_ARM_ANIMATION, &v)
    rt.buf_free(&v)
    return ok
}

fn chat_stamp(v: *mut rt.Buf) {
    mc_encode.vals_i64(v, "timestamp", time.now_unix_ms())
    mc_encode.vals_i64(v, "salt", 0)
}

// Unsigned chat message (online-mode=false). 1.19.0 / 1.19.1 / 1.19.2 (759 - 760) need signed previews: refused (false).
fn send_chat(cl: *mut mc_client.Client, p: u64, n: usize) -> bool {
    let proto: i32 = (*cl).ver.protocol
    if proto >= 759 && proto < 761 { return false }
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_text(&v, "message", p, n)
    if proto >= 761 {
        chat_stamp(&v)
        mc_encode.vals_i64(&v, "offset", 0)
        mc_encode.vals_raw(&v, "acknowledged", "hex:000000")
    }
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_CHAT, &v)
    rt.buf_free(&v)
    return ok
}

// `p / n` = the command WITHOUT the leading slash. Before 1.19.3 a command is a chat message that starts with '/'.
fn send_command(cl: *mut mc_client.Client, p: u64, n: usize) -> bool {
    let proto: i32 = (*cl).ver.protocol
    if proto < 761 {
        var line: rt.Buf = rt.buf_new()
        rt.buf_push(&line, 47)
        rt.buf_push_bytes(&line, p, n)
        let ok0: bool = send_chat(cl, rt.buf_ptr(&line), rt.buf_len(&line))
        rt.buf_free(&line)
        return ok0
    }
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_text(&v, "command", p, n)
    if proto < 766 {
        chat_stamp(&v)
        mc_encode.vals_raw(&v, "argumentSignatures", "#0")
        mc_encode.vals_i64(&v, "messageCount", 0)
        mc_encode.vals_raw(&v, "acknowledged", "hex:000000")
    }
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_CHAT_COMMAND, &v)
    rt.buf_free(&v)
    return ok
}

fn send_client_command(cl: *mut mc_client.Client, action: i32) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "actionId", action as i64)
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_CLIENT_COMMAND, &v)
    rt.buf_free(&v)
    return ok
}

fn send_attack(cl: *mut mc_client.Client, target: i32, sneaking: bool) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "target", target as i64)
    mc_encode.vals_i64(&v, "mouse", USE_ATTACK as i64)
    mc_encode.vals_bool(&v, "sneaking", sneaking)
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_USE_ENTITY, &v)
    rt.buf_free(&v)
    return ok
}

fn send_interact(cl: *mut mc_client.Client, target: i32, sneaking: bool) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "target", target as i64)
    mc_encode.vals_i64(&v, "mouse", USE_INTERACT as i64)
    mc_encode.vals_i64(&v, "hand", HAND_MAIN as i64)
    mc_encode.vals_bool(&v, "sneaking", sneaking)
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_USE_ENTITY, &v)
    rt.buf_free(&v)
    return ok
}

fn send_interact_at(cl: *mut mc_client.Client, target: i32, hx: f64, hy: f64, hz: f64, sneaking: bool) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "target", target as i64)
    mc_encode.vals_i64(&v, "mouse", USE_INTERACT_AT as i64)
    mc_encode.vals_f32(&v, "x", hx as f32)
    mc_encode.vals_f32(&v, "y", hy as f32)
    mc_encode.vals_f32(&v, "z", hz as f32)
    mc_encode.vals_i64(&v, "hand", HAND_MAIN as i64)
    mc_encode.vals_bool(&v, "sneaking", sneaking)
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_USE_ENTITY, &v)
    rt.buf_free(&v)
    return ok
}

fn send_use_item(cl: *mut mc_client.Client, seq: i32, yaw: f64, pitch: f64) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "hand", HAND_MAIN as i64)
    mc_encode.vals_i64(&v, "sequence", seq as i64)
    if (*cl).ver.protocol >= 767 {
        mc_encode.vals_f32(&v, "rotation.x", yaw as f32)
        mc_encode.vals_f32(&v, "rotation.y", pitch as f32)
    }
    let ok: bool = mc_client.client_send_values(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_USE_ITEM, &v)
    rt.buf_free(&v)
    return ok
}
