import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_gui_tex
import mc.mc_gui_font
import mc.mc_gui_lang
import mc.mc_gui_pack

export {
    Ui, ui_new, ui_free, ui_begin, ui_end_frame, ui_button, ui_label, ui_label_c, ui_rect, ui_dirt, ui_field, ui_hover, ui_text_width, ui_lang, ui_label_bytes, ui_list_background, ui_server_icon, ui_set_down, ui_slider, ui_gradient, ui_scrollbar, ui_scroll, DRAG_NONE,
    abgr, COLOR_WHITE, COLOR_TEXT, COLOR_HOVER, COLOR_DISABLED, COLOR_GRAY, COLOR_RED, COLOR_YELLOW, FOCUS_NONE,
}

const COLOR_WHITE: u32 = 0xFFFFFF
const COLOR_TEXT: u32 = 0xE0E0E0
const COLOR_HOVER: u32 = 0xFFFFA0
const COLOR_DISABLED: u32 = 0xA0A0A0
const COLOR_GRAY: u32 = 0x808080
const COLOR_RED: u32 = 0xFF5555
const COLOR_YELLOW: u32 = 0xFFFF00
const FOCUS_NONE: i32 = 0 - 1
const DRAG_NONE: i32 = 0 - 1
const BTN_H: i32 = 20
const WIDGET_STATE_STEP: i32 = 20
const WIDGET_V_BASE: i32 = 46

struct Ui {
    r: *mut mc_raster.Raster,
    pk: *mut mc_gui_pack.GuiPack,
    s: i32,
    uw: i32,
    uh: i32,
    mx: i32,
    my: i32,
    pressed: bool,
    ms: u64,
    key_esc: bool,
    key_enter: bool,
    key_back: bool,
    key_tab: bool,
    typed: rt.Buf,
    focus: i32,
    down: bool,
    drag: i32,
    wheel: i32,
    in_game: bool,
    cap: i32,
}

fn ui_new() -> Ui {
    return Ui {
        r: 0 as *mut mc_raster.Raster, pk: 0 as *mut mc_gui_pack.GuiPack, s: 1, uw: 0, uh: 0, mx: 0, my: 0, pressed: false, ms: 0 as u64,
        key_esc: false, key_enter: false, key_back: false, key_tab: false, typed: rt.buf_new(), focus: FOCUS_NONE, down: false, drag: DRAG_NONE, wheel: 0, in_game: false, cap: 0,
    }
}

fn ui_free(u: *mut Ui) {
    rt.buf_free(&(*u).typed)
}

fn abgr(rgb: u32) -> u32 {
    return 0xFF000000 as u32 | ((rgb & 255 as u32) << 16 as u32) | (rgb & 0xFF00 as u32) | ((rgb >> 16 as u32) & 255 as u32)
}

fn ui_begin(u: *mut Ui, r: *mut mc_raster.Raster, pk: *mut mc_gui_pack.GuiPack, s: i32, mx: i32, my: i32, pressed: bool, ms: u64) {
    (*u).r = r
    (*u).pk = pk
    (*u).s = s
    (*u).uw = ((*r).w + s - 1) / s
    (*u).uh = ((*r).h + s - 1) / s
    (*u).mx = mx / s
    (*u).my = my / s
    (*u).pressed = pressed
    (*u).ms = ms
}

fn ui_end_frame(u: *mut Ui) {
    (*u).key_esc = false
    (*u).key_enter = false
    (*u).key_back = false
    (*u).key_tab = false
    (*u).pressed = false
    (*u).wheel = 0
    (*u).cap = 0
    if !(*u).down { (*u).drag = DRAG_NONE }
    rt.buf_clear(&(*u).typed)
}

fn ui_set_down(u: *mut Ui, down: bool, wheel: i32) {
    (*u).down = down
    (*u).wheel = wheel
}

fn ui_lang(u: *mut Ui, key: str, fallback: str) -> str {
    return mc_gui_lang.glang_get(&(*(*u).pk).lang, key, fallback)
}

fn ui_hover(u: *mut Ui, x: i32, y: i32, w: i32, h: i32) -> bool {
    return (*u).mx >= x && (*u).my >= y && (*u).mx < x + w && (*u).my < y + h
}

fn ui_text_width(u: *mut Ui, t: str) -> i32 {
    return mc_gui_font.gfont_width(&(*(*u).pk).font, t)
}

fn ui_rect(u: *mut Ui, x: i32, y: i32, w: i32, h: i32, argb: u32) {
    let a: u32 = argb & 0xFF000000 as u32
    var c: u32 = abgr(argb)
    if a != 0 as u32 { c = (a) | (c & 0xFFFFFF as u32) }
    mc_hud.hud_rect((*u).r, x * (*u).s, y * (*u).s, w * (*u).s, h * (*u).s, c)
}

fn ui_label(u: *mut Ui, x: i32, y: i32, rgb: u32, t: str) {
    mc_gui_font.gfont_draw((*u).r, &(*(*u).pk).font, x * (*u).s, y * (*u).s, (*u).s, abgr(rgb), true, t)
}

fn ui_label_c(u: *mut Ui, cx: i32, y: i32, rgb: u32, t: str) {
    mc_gui_font.gfont_draw_centered((*u).r, &(*(*u).pk).font, cx * (*u).s, y * (*u).s, (*u).s, abgr(rgb), true, t)
}

fn ui_dirt(u: *mut Ui, rgb_mul: u32) {
    if (*u).in_game {
        ui_gradient(u, 0, 0, (*u).uw, (*u).uh, 0xC0101010 as u32, 0xD0101010 as u32)
        return
    }
    let r: *mut mc_raster.Raster = (*u).r
    mc_gui_tex.gtex_draw_tiled(r, &(*(*u).pk).options_bg, 0, 0, (*r).w, (*r).h, 32 * (*u).s, abgr(rgb_mul))
}

fn ui_button(u: *mut Ui, x: i32, y: i32, w: i32, label: str, enabled: bool) -> bool {
    let hov: bool = enabled && ui_hover(u, x, y, w, BTN_H)
    var state: i32 = 1
    var col: u32 = COLOR_TEXT
    if !enabled {
        state = 0
        col = COLOR_DISABLED
    } else if hov {
        state = 2
        col = COLOR_HOVER
    }
    let v: i32 = WIDGET_V_BASE + state * WIDGET_STATE_STEP
    let s: i32 = (*u).s
    let half: i32 = w / 2
    let wt: *mut mc_gui_tex.GuiTex = &(*(*u).pk).widgets
    mc_gui_tex.gtex_draw((*u).r, wt, x * s, y * s, half * s, BTN_H * s, 0, v, half, BTN_H, 0xFFFFFFFF as u32)
    mc_gui_tex.gtex_draw((*u).r, wt, (x + half) * s, y * s, half * s, BTN_H * s, 200 - half, v, half, BTN_H, 0xFFFFFFFF as u32)
    ui_label_c(u, x + w / 2, y + (BTN_H - 8) / 2, col, label)
    return hov && (*u).pressed
}

fn push_typed(u: *mut Ui, f: *mut rt.Buf, max: usize) {
    var i: usize = 0
    while i < rt.buf_len(&(*u).typed) {
        let c: u8 = rt.buf_at(&(*u).typed, i)
        if c >= 32 as u8 && c < 127 as u8 && rt.buf_len(f) < max { rt.buf_push(f, c) }
        i = i + 1
    }
    if (*u).key_back && rt.buf_len(f) > 0 { (*f).len = (*f).len - 1 }
}

fn ui_field(u: *mut Ui, id: i32, x: i32, y: i32, w: i32, h: i32, f: *mut rt.Buf, max: usize) {
    if (*u).pressed && ui_hover(u, x, y, w, h) { (*u).focus = id }
    let on: bool = (*u).focus == id
    var edge: u32 = 0xFFA0A0A0
    if on { edge = 0xFFFFFFFF }
    ui_rect(u, x, y, w, h, edge)
    ui_rect(u, x + 1, y + 1, w - 2, h - 2, 0xFF000000)
    if on { push_typed(u, f, max) }
    let ty: i32 = y + (h - 8) / 2
    mc_gui_font.gfont_draw_bytes((*u).r, &(*(*u).pk).font, (x + 4) * (*u).s, ty * (*u).s, (*u).s, abgr(COLOR_TEXT), true, rt.buf_ptr(f), rt.buf_len(f))
    if on && ((*u).ms / 500 as u64) % 2 as u64 == 0 as u64 {
        let tw: i32 = mc_gui_font.gfont_bytes_width(&(*(*u).pk).font, rt.buf_ptr(f), rt.buf_len(f))
        ui_rect(u, x + 4 + tw, ty, 1, 9, 0xFFE0E0E0)
    }
}

fn ui_label_bytes(u: *mut Ui, x: i32, y: i32, rgb: u32, p: u64, n: usize) {
    mc_gui_font.gfont_draw_bytes((*u).r, &(*(*u).pk).font, x * (*u).s, y * (*u).s, (*u).s, abgr(rgb), true, p, n)
}

fn ui_list_background(u: *mut Ui, y0: i32, y1: i32) {
    ui_dirt(u, 0x404040)
    let s: i32 = (*u).s
    let r: *mut mc_raster.Raster = (*u).r
    var y: i32 = y0 * s
    while y < y1 * s {
        var x: i32 = 0
        while x < (*r).w {
            let t: *mut mc_gui_tex.GuiTex = &(*(*u).pk).options_bg
            let cell: i32 = 32 * s
            let c: u32 = mc_gui_tex.gtex_get(t, (x % cell) * (*t).w / cell, (y % cell) * (*t).h / cell)
            mc_gui_tex.gtex_blend(r, x, y, tint_rgb(c, 0x202020))
            x = x + 1
        }
        y = y + 1
    }
    var g: i32 = 0
    while g < 4 {
        let a: u32 = (255 - g * 64) as u32
        ui_rect(u, 0, y0 + g, (*u).uw, 1, (a << 24 as u32) | 0x000000)
        ui_rect(u, 0, y1 - 1 - g, (*u).uw, 1, (a << 24 as u32) | 0x000000)
        g = g + 1
    }
}

fn tint_rgb(c: u32, rgb: u32) -> u32 {
    let m: u32 = abgr(rgb)
    let b: u32 = ((c >> 16 as u32) & 255 as u32) * ((m >> 16 as u32) & 255 as u32) / 255 as u32
    let g: u32 = ((c >> 8 as u32) & 255 as u32) * ((m >> 8 as u32) & 255 as u32) / 255 as u32
    let rr: u32 = (c & 255 as u32) * (m & 255 as u32) / 255 as u32
    return (c & 0xFF000000 as u32) | (b << 16 as u32) | (g << 8 as u32) | rr
}

fn ui_server_icon(u: *mut Ui, x: i32, y: i32) {
    let t: *mut mc_gui_tex.GuiTex = &(*(*u).pk).server_icon
    let s: i32 = (*u).s
    if mc_gui_tex.gtex_ok(t) {
        mc_gui_tex.gtex_draw((*u).r, t, x * s, y * s, 32 * s, 32 * s, 0, 0, (*t).w, (*t).h, 0xFFFFFFFF as u32)
    } else {
        ui_rect(u, x, y, 32, 32, 0xFF303030)
    }
}

fn ui_gradient(u: *mut Ui, x: i32, y: i32, w: i32, h: i32, top_argb: u32, bottom_argb: u32) {
    if h <= 0 { return }
    let s: i32 = (*u).s
    var j: i32 = 0
    while j < h * s {
        let t: i32 = (j * 255) / (h * s)
        var ch: u32 = 0
        var out: u32 = 0
        var sh: u32 = 0 as u32
        while sh < 32 as u32 {
            let a: u32 = (top_argb >> sh) & 255 as u32
            let b: u32 = (bottom_argb >> sh) & 255 as u32
            ch = (a * ((255 - t) as u32) + b * (t as u32)) / 255 as u32
            out = out | (ch << sh)
            sh = sh + 8 as u32
        }
        let al: u32 = out & 0xFF000000 as u32
        let c: u32 = abgr(out & 0xFFFFFF as u32)
        mc_hud.hud_rect((*u).r, x * s, y * s + j, w * s, 1, al | (c & 0xFFFFFF as u32))
        j = j + 1
    }
}

fn ui_slider(u: *mut Ui, id: i32, x: i32, y: i32, w: i32, label: str, value: *mut i32, lo: i32, hi: i32) -> bool {
    var changed: bool = false
    let hov: bool = ui_hover(u, x, y, w, BTN_H)
    if hov && (*u).pressed { (*u).drag = id }
    if (*u).drag == id && (*u).down && hi > lo {
        var v: i32 = lo + (((*u).mx - x - 4) * (hi - lo) + (w - 8) / 2) / (w - 8)
        if v < lo { v = lo }
        if v > hi { v = hi }
        if v != *value {
            *value = v
            changed = true
        }
    }
    let s: i32 = (*u).s
    let half: i32 = w / 2
    let wt: *mut mc_gui_tex.GuiTex = &(*(*u).pk).widgets
    mc_gui_tex.gtex_draw((*u).r, wt, x * s, y * s, half * s, BTN_H * s, 0, WIDGET_V_BASE, half, BTN_H, 0xFFFFFFFF as u32)
    mc_gui_tex.gtex_draw((*u).r, wt, (x + half) * s, y * s, half * s, BTN_H * s, 200 - half, WIDGET_V_BASE, half, BTN_H, 0xFFFFFFFF as u32)
    var frac: i32 = 0
    if hi > lo { frac = ((*value - lo) * (w - 8)) / (hi - lo) }
    var state: i32 = 1
    if hov || (*u).drag == id { state = 2 }
    let v0: i32 = WIDGET_V_BASE + state * WIDGET_STATE_STEP
    mc_gui_tex.gtex_draw((*u).r, wt, (x + frac) * s, y * s, 4 * s, BTN_H * s, 0, v0, 4, BTN_H, 0xFFFFFFFF as u32)
    mc_gui_tex.gtex_draw((*u).r, wt, (x + frac + 4) * s, y * s, 4 * s, BTN_H * s, 196, v0, 4, BTN_H, 0xFFFFFFFF as u32)
    var col: u32 = COLOR_TEXT
    if hov || (*u).drag == id { col = COLOR_HOVER }
    ui_label_c(u, x + w / 2, y + (BTN_H - 8) / 2, col, label)
    return changed
}

fn ui_scrollbar(u: *mut Ui, x: i32, y0: i32, y1: i32, total: i32, shown: i32, offset: i32) {
    if total <= shown { return }
    let track: i32 = y1 - y0
    var bar: i32 = track * shown / total
    if bar < 32 { bar = 32 }
    if bar > track - 8 { bar = track - 8 }
    let span: i32 = total - shown
    var by: i32 = y0 + (track - bar) * offset / span
    if by < y0 { by = y0 }
    ui_rect(u, x, y0, 6, track, 0xFF000000)
    ui_rect(u, x, by, 6, bar, 0xFF808080)
    ui_rect(u, x, by, 5, bar - 1, 0xFFC0C0C0)
}

fn ui_scroll(u: *mut Ui, id: i32, x: i32, y0: i32, y1: i32, total: i32, shown: i32, offset: i32) -> i32 {
    let span: i32 = total - shown
    if span <= 0 { return 0 }
    var off: i32 = offset - (*u).wheel
    let track: i32 = y1 - y0
    if (*u).pressed && ui_hover(u, x - 2, y0, 10, track) { (*u).drag = id }
    if (*u).drag == id && (*u).down {
        off = (((*u).my - y0) * span + track / 2) / track
    }
    if off < 0 { off = 0 }
    if off > span { off = span }
    ui_scrollbar(u, x, y0, y1, total, shown, off)
    return off
}
