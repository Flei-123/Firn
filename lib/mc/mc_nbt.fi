// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_nbt.fi -- NBT as a TREE (the DOM layer over the pull reader of std.nbt).
//
// std.nbt reads and writes NBT in one pass, which is what a packet decoder wants. For registries,
// dimension codecs, block entities and level data a program wants to ask "what is under
// `element/min_y`?" and to change and write a value back. This file reads a whole NBT value into a
// Doc (an arena of nodes plus a blob for strings and arrays), gives typed getters and writes it back.
//
//   * both root forms: a NAMED root (files, and network NBT up to 1.20.1) and the NAMELESS root of the
//     network since 1.20.2 (`anon` argument);
//   * lists keep their element type and order, compounds keep the order of their entries, strings and
//     arrays are kept as the raw octets: reading and writing back is BYTE IDENTICAL for every input
//     that parses;
//   * hostile input: nesting at most MAX_DEPTH (512, the vanilla limit), a list / array count is
//     checked against the octets that are really left BEFORE anything is reserved, at most MAX_NODES
//     nodes and MAX_BLOB octets per Doc; every failure is an error, never an out-of-bounds read.
//
// Node 0 is a reserved "none" node: every lookup that finds nothing returns 0.
//
// The arena grows by reallocation, so node numbers (u32) and not pointers are the handles.

import std.rt
import std.bytes
import std.nbt

export {
    Doc, TreeError,
    doc_new, doc_free, doc_parse, doc_root, doc_node_count,
    nbt_kind, nbt_elem_kind, nbt_count, nbt_name, nbt_get, nbt_at, nbt_first, nbt_next,
    nbt_i64, nbt_f64, nbt_f32, nbt_str, nbt_arr_ptr, nbt_arr_i32, nbt_arr_i64,
    doc_write, doc_write_node, nbt_set_i64, doc_snbt, doc_root_name,
    MAX_DEPTH, MAX_NODES, MAX_BLOB,
}

const MAX_DEPTH: i32 = 512
const MAX_NODES: u32 = 4194304
const MAX_BLOB: usize = 268435456

error TreeError {
    Underflow, // the octets end inside a value
    BadTag, // a type octet above 12, or a list of End with elements
    TooDeep, // more than MAX_DEPTH nested containers
    Range, // a negative length
    TooBig, // more than MAX_NODES nodes / MAX_BLOB octets
    Memory, // out of memory
    Trailing, // octets left behind the root value (doc_parse with strict = true)
    Shape, // the root is not a compound
}

struct Node {
    kind: u8, // nbt.TAG_*
    elem: u8, // list: the element type
    name_off: u32, // blob offset of the entry name (compound children)
    name_len: u32,
    count: u32, // children of a list / compound, elements of an array, octets of a string
    first: u32, // first child
    last: u32, // last child (for appending)
    next: u32, // next sibling
    data: u64, // scalar payload bits, or the blob offset of a string / array payload
}

struct Doc {
    nodes: u64, // array of Node
    n: u32,
    cap: u32,
    blob: rt.Buf,
    root: u32,
    root_name_off: u32,
    root_name_len: u32,
    anon: bool,
}

// size_of[Node]() is "unknown type" in an imported module (BLOCKER.md): measure the stride
fn node_size() -> usize {
    var a: [Node; 2] = [Node { kind: 0 as u8, elem: 0 as u8, name_off: 0 as u32, name_len: 0 as u32, count: 0 as u32,
            first: 0 as u32, last: 0 as u32, next: 0 as u32, data: 0 as u64 }; 2]
    return ((&a[1]) as u64 - (&a[0]) as u64) as usize
}

fn doc_new() -> Doc {
    let d: Doc = Doc { nodes: 0, n: 0 as u32, cap: 0 as u32, blob: rt.buf_new(), root: 0 as u32, root_name_off: 0 as u32,
        root_name_len: 0 as u32, anon: false }
    return d
}

fn doc_free(d: *mut Doc) {
    if (*d).nodes != 0 {
        rt.heap_free((*d).nodes, ((*d).cap as usize) * node_size())
    }
    rt.buf_free(&(*d).blob)
    (*d).nodes = 0
    (*d).n = 0 as u32
    (*d).cap = 0 as u32
    (*d).root = 0 as u32
}

fn nodep(d: *mut Doc, i: u32) -> *mut Node {
    return ((*d).nodes + (i as usize * node_size()) as u64) as *mut Node
}

fn doc_root(d: *mut Doc) -> u32 { return (*d).root }
fn doc_node_count(d: *mut Doc) -> u32 { return (*d).n }

// appends a node, returns its number or 0 on failure; node 0 is created first as the "none" node
fn new_node(d: *mut Doc, kind: u8) -> u32 {
    if (*d).n >= MAX_NODES {
        return 0 as u32
    }
    if (*d).n == (*d).cap {
        var nc: u32 = (*d).cap * 2 as u32
        if nc == 0 as u32 {
            nc = 64 as u32
        }
        let nn: u64 = rt.heap_alloc((nc as usize) * node_size())
        if nn == 0 {
            return 0 as u32
        }
        if (*d).nodes != 0 {
            rt.mem_copy(nn, (*d).nodes, ((*d).n as usize) * node_size())
            rt.heap_free((*d).nodes, ((*d).cap as usize) * node_size())
        }
        (*d).nodes = nn
        (*d).cap = nc
    }
    let i: u32 = (*d).n
    (*d).n = i + 1 as u32
    let p: *mut Node = nodep(d, i)
    (*p).kind = kind
    (*p).elem = 0 as u8
    (*p).name_off = 0 as u32
    (*p).name_len = 0 as u32
    (*p).count = 0 as u32
    (*p).first = 0 as u32
    (*p).last = 0 as u32
    (*p).next = 0 as u32
    (*p).data = 0 as u64
    return i
}

// copies `n` octets into the blob, returns the offset or -1
fn blob_put(d: *mut Doc, p: u64, n: usize) -> i64 {
    if (*d).blob.len + n > MAX_BLOB {
        return 0 - 1
    }
    let off: usize = (*d).blob.len
    rt.buf_push_bytes(&(*d).blob, p, n)
    if (*d).blob.len != off + n {
        return 0 - 1
    }
    return off as i64
}

fn append_child(d: *mut Doc, parent: u32, child: u32) {
    let pp: *mut Node = nodep(d, parent)
    if (*pp).first == 0 as u32 {
        (*pp).first = child
    } else {
        let lp: *mut Node = nodep(d, (*pp).last)
        (*lp).next = child
    }
    (*pp).last = child
    (*pp).count = (*pp).count + 1 as u32
}

// the smallest payload a value of this type can have (guards list counts)
fn min_payload(tag: u8) -> usize {
    if tag == nbt.TAG_BYTE {
        return 1
    }
    if tag == nbt.TAG_SHORT {
        return 2
    }
    if tag == nbt.TAG_INT || tag == nbt.TAG_FLOAT {
        return 4
    }
    if tag == nbt.TAG_LONG || tag == nbt.TAG_DOUBLE {
        return 8
    }
    if tag == nbt.TAG_BYTE_ARRAY || tag == nbt.TAG_INT_ARRAY || tag == nbt.TAG_LONG_ARRAY {
        return 4
    }
    if tag == nbt.TAG_STRING {
        return 2
    }
    if tag == nbt.TAG_LIST {
        return 5
    }
    return 1 // compound: its End octet
}

// u16 length + octets (a name or a string): the span stays valid while `b` lives
fn read_span16(b: *mut bytes.Bytes, n: *mut usize) -> TreeError!u64 {
    *n = 0
    if bytes.bytes_remaining(b) < 2 {
        return TreeError::Underflow
    }
    let l: usize = (bytes.get_u16(b) catch 0 as u16) as usize
    if bytes.bytes_remaining(b) < l {
        return TreeError::Underflow
    }
    *n = l
    return bytes.get_span(b, l) catch 0
}

// reads the payload of type `tag` into node `at`
fn read_payload(d: *mut Doc, b: *mut bytes.Bytes, tag: u8, depth: i32, at: u32) -> TreeError!bool {
    if depth > MAX_DEPTH {
        return TreeError::TooDeep
    }
    if tag == nbt.TAG_BYTE {
        if bytes.bytes_remaining(b) < 1 {
            return TreeError::Underflow
        }
        (*nodep(d, at)).data = (bytes.get_i8(b) catch 0 as i8) as i64 as u64
        return true
    }
    if tag == nbt.TAG_SHORT {
        if bytes.bytes_remaining(b) < 2 {
            return TreeError::Underflow
        }
        (*nodep(d, at)).data = (bytes.get_i16(b) catch 0 as i16) as i64 as u64
        return true
    }
    if tag == nbt.TAG_INT {
        if bytes.bytes_remaining(b) < 4 {
            return TreeError::Underflow
        }
        (*nodep(d, at)).data = (bytes.get_i32(b) catch 0) as i64 as u64
        return true
    }
    if tag == nbt.TAG_LONG {
        if bytes.bytes_remaining(b) < 8 {
            return TreeError::Underflow
        }
        (*nodep(d, at)).data = (bytes.get_i64(b) catch 0) as u64
        return true
    }
    if tag == nbt.TAG_FLOAT {
        if bytes.bytes_remaining(b) < 4 {
            return TreeError::Underflow
        }
        (*nodep(d, at)).data = (bytes.get_u32(b) catch 0 as u32) as u64
        return true
    }
    if tag == nbt.TAG_DOUBLE {
        if bytes.bytes_remaining(b) < 8 {
            return TreeError::Underflow
        }
        (*nodep(d, at)).data = bytes.get_u64(b) catch 0 as u64
        return true
    }
    if tag == nbt.TAG_STRING {
        var sl: usize = 0
        let sp: u64 = try read_span16(b, &sl)
        let off: i64 = blob_put(d, sp, sl)
        if off < 0 {
            return TreeError::TooBig
        }
        (*nodep(d, at)).data = off as u64
        (*nodep(d, at)).count = sl as u32
        return true
    }
    if tag == nbt.TAG_BYTE_ARRAY || tag == nbt.TAG_INT_ARRAY || tag == nbt.TAG_LONG_ARRAY {
        var w: usize = 1
        if tag == nbt.TAG_INT_ARRAY {
            w = 4
        } else if tag == nbt.TAG_LONG_ARRAY {
            w = 8
        }
        let cnt: i32 = nbt.nbt_read_array_len(b, w) catch 0 - 1
        if cnt < 0 {
            return TreeError::Range
        }
        let n: usize = (cnt as usize) * w
        let sp: u64 = bytes.get_span(b, n) catch 0
        if sp == 0 && n != 0 {
            return TreeError::Underflow
        }
        let off: i64 = blob_put(d, sp, n)
        if off < 0 {
            return TreeError::TooBig
        }
        (*nodep(d, at)).data = off as u64
        (*nodep(d, at)).count = cnt as u32
        return true
    }
    if tag == nbt.TAG_LIST {
        var elem: u8 = 0
        var cnt: i32 = 0
        if !(nbt.nbt_read_list_header(b, &elem, &cnt) catch false) {
            return TreeError::Range
        }
        if elem > nbt.TAG_LONG_ARRAY {
            return TreeError::BadTag
        }
        if elem == nbt.TAG_END && cnt > 0 {
            return TreeError::BadTag
        }
        (*nodep(d, at)).elem = elem
        if cnt > 0 && (cnt as usize) > bytes.bytes_remaining(b) / min_payload(elem) {
            return TreeError::Underflow
        }
        var i: i32 = 0
        while i < cnt {
            let c: u32 = new_node(d, elem)
            if c == 0 as u32 {
                return TreeError::TooBig
            }
            append_child(d, at, c)
            try read_payload(d, b, elem, depth + 1, c)
            i = i + 1
        }
        return true
    }
    if tag == nbt.TAG_COMPOUND {
        while true {
            let t: u8 = nbt.nbt_read_type(b) catch 255 as u8
            if t == 255 as u8 {
                return TreeError::Underflow
            }
            if t == nbt.TAG_END {
                return true
            }
            var nl: usize = 0
            let np: u64 = try read_span16(b, &nl)
            let c: u32 = new_node(d, t)
            if c == 0 as u32 {
                return TreeError::TooBig
            }
            let off: i64 = blob_put(d, np, nl)
            if off < 0 {
                return TreeError::TooBig
            }
            (*nodep(d, c)).name_off = off as u32
            (*nodep(d, c)).name_len = nl as u32
            append_child(d, at, c)
            try read_payload(d, b, t, depth + 1, c)
        }
    }
    return TreeError::BadTag
}

// Reads one NBT value from the cursor of `b`: `anon` = the nameless root of the 1.20.2+ network
// form. The root must be a compound. With `strict` the octets behind the value are an error.
fn doc_parse(d: *mut Doc, b: *mut bytes.Bytes, anon: bool, strict: bool) -> TreeError!bool {
    doc_free(d)
    (*d).blob = rt.buf_new()
    (*d).anon = anon
    new_node(d, 0 as u8) // node 0: none
    let t: u8 = nbt.nbt_read_type(b) catch 255 as u8
    if t == 255 as u8 {
        return TreeError::Underflow
    }
    if t != nbt.TAG_COMPOUND {
        return TreeError::Shape
    }
    if !anon {
        var nl: usize = 0
        let np: u64 = try read_span16(b, &nl)
        let off: i64 = blob_put(d, np, nl)
        if off < 0 {
            return TreeError::TooBig
        }
        (*d).root_name_off = off as u32
        (*d).root_name_len = nl as u32
    }
    let r: u32 = new_node(d, nbt.TAG_COMPOUND)
    if r == 0 as u32 {
        return TreeError::Memory
    }
    (*d).root = r
    try read_payload(d, b, nbt.TAG_COMPOUND, 1, r)
    if strict && bytes.bytes_remaining(b) != 0 {
        return TreeError::Trailing
    }
    return true
}

// ---- getters ----------------------------------------------------------------------
fn nbt_kind(d: *mut Doc, n: u32) -> u8 { return (*nodep(d, n)).kind }
fn nbt_elem_kind(d: *mut Doc, n: u32) -> u8 { return (*nodep(d, n)).elem }
fn nbt_count(d: *mut Doc, n: u32) -> u32 { return (*nodep(d, n)).count }
fn nbt_first(d: *mut Doc, n: u32) -> u32 { return (*nodep(d, n)).first }
fn nbt_next(d: *mut Doc, n: u32) -> u32 { return (*nodep(d, n)).next }

// the entry name of a compound child (pointer into the blob, not NUL terminated)
fn nbt_name(d: *mut Doc, n: u32, len: *mut usize) -> u64 {
    *len = (*nodep(d, n)).name_len as usize
    return (*d).blob.ptr + (*nodep(d, n)).name_off as u64
}

fn doc_root_name(d: *mut Doc, len: *mut usize) -> u64 {
    *len = (*d).root_name_len as usize
    return (*d).blob.ptr + (*d).root_name_off as u64
}

// child `name` of compound `n`, or 0
fn nbt_get(d: *mut Doc, n: u32, name: u64, nl: usize) -> u32 {
    if (*nodep(d, n)).kind != nbt.TAG_COMPOUND {
        return 0 as u32
    }
    var c: u32 = (*nodep(d, n)).first
    while c != 0 as u32 {
        let cp: *mut Node = nodep(d, c)
        if (*cp).name_len as usize == nl && rt.mem_eq((*d).blob.ptr + (*cp).name_off as u64, name, nl) {
            return c
        }
        c = (*cp).next
    }
    return 0 as u32
}

// element `i` of list `n`, or 0
fn nbt_at(d: *mut Doc, n: u32, i: u32) -> u32 {
    if (*nodep(d, n)).kind != nbt.TAG_LIST || i >= (*nodep(d, n)).count {
        return 0 as u32
    }
    var c: u32 = (*nodep(d, n)).first
    var k: u32 = 0 as u32
    while k < i && c != 0 as u32 {
        c = (*nodep(d, c)).next
        k = k + 1 as u32
    }
    return c
}

// any integer type (byte, short, int, long) as i64; 0 for other kinds
fn nbt_i64(d: *mut Doc, n: u32) -> i64 {
    let k: u8 = (*nodep(d, n)).kind
    if k >= nbt.TAG_BYTE && k <= nbt.TAG_LONG {
        return (*nodep(d, n)).data as i64
    }
    return 0
}

fn nbt_f32(d: *mut Doc, n: u32) -> u32 {
    return (*nodep(d, n)).data as u32
}

// the bits of a double / float widened to f64 are the caller's business; this returns the f64 bits
fn nbt_f64(d: *mut Doc, n: u32) -> u64 {
    return (*nodep(d, n)).data
}

fn nbt_str(d: *mut Doc, n: u32, len: *mut usize) -> u64 {
    *len = (*nodep(d, n)).count as usize
    return (*d).blob.ptr + (*nodep(d, n)).data
}

// raw big-endian payload of an array node
fn nbt_arr_ptr(d: *mut Doc, n: u32) -> u64 {
    return (*d).blob.ptr + (*nodep(d, n)).data
}

fn nbt_arr_i32(d: *mut Doc, n: u32, i: u32) -> i32 {
    let p: u64 = nbt_arr_ptr(d, n) + (i as u64) * 4 as u64
    let v: u32 = ((rt.ld8(p, 0) as u32) << 24) | ((rt.ld8(p, 1) as u32) << 16) | ((rt.ld8(p, 2) as u32) << 8) | (rt.ld8(p, 3) as u32)
    return bytes.bits_i32(v)
}

fn nbt_arr_i64(d: *mut Doc, n: u32, i: u32) -> i64 {
    let p: u64 = nbt_arr_ptr(d, n) + (i as u64) * 8 as u64
    var v: u64 = 0
    var k: usize = 0
    while k < 8 {
        v = (v << 8) | (rt.ld8(p, k) as u64)
        k = k + 1
    }
    return bytes.bits_i64(v)
}

// ---- writing ------------------------------------------------------------------------
fn put_name(b: *mut bytes.Bytes, p: u64, n: usize) {
    bytes.put_u16(b, n as u16)
    bytes.put_raw(b, p, n)
}

fn write_payload(d: *mut Doc, n: u32, b: *mut bytes.Bytes) {
    let np: *mut Node = nodep(d, n)
    let k: u8 = (*np).kind
    if k == nbt.TAG_BYTE {
        bytes.put_i8(b, (*np).data as i64 as i8)
    } else if k == nbt.TAG_SHORT {
        bytes.put_i16(b, (*np).data as i64 as i16)
    } else if k == nbt.TAG_INT {
        bytes.put_i32(b, (*np).data as i64 as i32)
    } else if k == nbt.TAG_LONG {
        bytes.put_i64(b, (*np).data as i64)
    } else if k == nbt.TAG_FLOAT {
        bytes.put_u32(b, (*np).data as u32)
    } else if k == nbt.TAG_DOUBLE {
        bytes.put_u64(b, (*np).data)
    } else if k == nbt.TAG_STRING {
        put_name(b, (*d).blob.ptr + (*np).data, (*np).count as usize)
    } else if k == nbt.TAG_BYTE_ARRAY {
        bytes.put_i32(b, (*np).count as i32)
        bytes.put_raw(b, (*d).blob.ptr + (*np).data, (*np).count as usize)
    } else if k == nbt.TAG_INT_ARRAY {
        bytes.put_i32(b, (*np).count as i32)
        bytes.put_raw(b, (*d).blob.ptr + (*np).data, (*np).count as usize * 4)
    } else if k == nbt.TAG_LONG_ARRAY {
        bytes.put_i32(b, (*np).count as i32)
        bytes.put_raw(b, (*d).blob.ptr + (*np).data, (*np).count as usize * 8)
    } else if k == nbt.TAG_LIST {
        bytes.put_u8(b, (*np).elem)
        bytes.put_i32(b, (*np).count as i32)
        var c: u32 = (*np).first
        while c != 0 as u32 {
            write_payload(d, c, b)
            c = (*nodep(d, c)).next
        }
    } else if k == nbt.TAG_COMPOUND {
        var c: u32 = (*np).first
        while c != 0 as u32 {
            let cp: *mut Node = nodep(d, c)
            bytes.put_u8(b, (*cp).kind)
            put_name(b, (*d).blob.ptr + (*cp).name_off as u64, (*cp).name_len as usize)
            write_payload(d, c, b)
            c = (*cp).next
        }
        bytes.put_u8(b, nbt.TAG_END)
    }
}

// Writes the document as it was read: the root's name unless the Doc was read as `anon`.
fn doc_write(d: *mut Doc, b: *mut bytes.Bytes) {
    bytes.put_u8(b, nbt.TAG_COMPOUND)
    if !(*d).anon {
        put_name(b, (*d).blob.ptr + (*d).root_name_off as u64, (*d).root_name_len as usize)
    }
    write_payload(d, (*d).root, b)
}

fn doc_write_node(d: *mut Doc, n: u32, b: *mut bytes.Bytes) {
    write_payload(d, n, b)
}

fn nbt_set_i64(d: *mut Doc, n: u32, v: i64) -> bool {
    let k: u8 = (*nodep(d, n)).kind
    if k < nbt.TAG_BYTE || k > nbt.TAG_LONG { return false }
    (*nodep(d, n)).data = v as u64
    return true
}

// ---- SNBT (readable text, for logs) ---------------------------------------------------
fn snbt_str(out: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push(out, 34 as u8)
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 34 as u8 || c == 92 as u8 {
            rt.buf_push(out, 92 as u8)
        }
        rt.buf_push(out, c)
        i = i + 1
    }
    rt.buf_push(out, 34 as u8)
}

fn snbt_node(d: *mut Doc, n: u32, out: *mut rt.Buf) {
    let np: *mut Node = nodep(d, n)
    let k: u8 = (*np).kind
    if k == nbt.TAG_BYTE {
        rt.buf_push_dec_i64(out, (*np).data as i64)
        rt.buf_push(out, 98 as u8)
    } else if k == nbt.TAG_SHORT {
        rt.buf_push_dec_i64(out, (*np).data as i64)
        rt.buf_push(out, 115 as u8)
    } else if k == nbt.TAG_INT {
        rt.buf_push_dec_i64(out, (*np).data as i64)
    } else if k == nbt.TAG_LONG {
        rt.buf_push_dec_i64(out, (*np).data as i64)
        rt.buf_push(out, 76 as u8)
    } else if k == nbt.TAG_FLOAT {
        rt.buf_push_bytes(out, "f32:0x".p as u64, 6)
        rt.buf_push_hex_u64(out, (*np).data, 8)
    } else if k == nbt.TAG_DOUBLE {
        rt.buf_push_bytes(out, "f64:0x".p as u64, 6)
        rt.buf_push_hex_u64(out, (*np).data, 16)
    } else if k == nbt.TAG_STRING {
        snbt_str(out, (*d).blob.ptr + (*np).data, (*np).count as usize)
    } else if k == nbt.TAG_BYTE_ARRAY || k == nbt.TAG_INT_ARRAY || k == nbt.TAG_LONG_ARRAY {
        rt.buf_push(out, 91 as u8)
        if k == nbt.TAG_BYTE_ARRAY {
            rt.buf_push_bytes(out, "B;".p as u64, 2)
        } else if k == nbt.TAG_INT_ARRAY {
            rt.buf_push_bytes(out, "I;".p as u64, 2)
        } else {
            rt.buf_push_bytes(out, "L;".p as u64, 2)
        }
        var i: u32 = 0 as u32
        while i < (*np).count {
            if i > 0 as u32 {
                rt.buf_push(out, 44 as u8)
            }
            if k == nbt.TAG_BYTE_ARRAY {
                rt.buf_push_dec_i64(out, bytes.bits_i8(rt.ld8((*d).blob.ptr + (*np).data, i as usize)) as i64)
            } else if k == nbt.TAG_INT_ARRAY {
                rt.buf_push_dec_i64(out, nbt_arr_i32(d, n, i) as i64)
            } else {
                rt.buf_push_dec_i64(out, nbt_arr_i64(d, n, i))
            }
            i = i + 1 as u32
        }
        rt.buf_push(out, 93 as u8)
    } else if k == nbt.TAG_LIST {
        rt.buf_push(out, 91 as u8)
        var c: u32 = (*np).first
        while c != 0 as u32 {
            snbt_node(d, c, out)
            c = (*nodep(d, c)).next
            if c != 0 as u32 {
                rt.buf_push(out, 44 as u8)
            }
        }
        rt.buf_push(out, 93 as u8)
    } else if k == nbt.TAG_COMPOUND {
        rt.buf_push(out, 123 as u8)
        var c: u32 = (*np).first
        while c != 0 as u32 {
            let cp: *mut Node = nodep(d, c)
            snbt_str(out, (*d).blob.ptr + (*cp).name_off as u64, (*cp).name_len as usize)
            rt.buf_push(out, 58 as u8)
            snbt_node(d, c, out)
            c = (*cp).next
            if c != 0 as u32 {
                rt.buf_push(out, 44 as u8)
            }
        }
        rt.buf_push(out, 125 as u8)
    }
}

// Appends the readable form of the whole document to `out`. Floats are shown as their bit pattern.
fn doc_snbt(d: *mut Doc, out: *mut rt.Buf) {
    snbt_node(d, (*d).root, out)
}
