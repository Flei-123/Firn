export { MV_ICE, MV_PACKED_ICE, MV_BLUE_ICE, MV_SLIME, MU_DEFAULT, kind_friction, accel_scale, drag_factor }

const MV_ICE: i32 = 8
const MV_BLUE_ICE: i32 = 9
const MV_SLIME: i32 = 10
const MV_PACKED_ICE: i32 = 11
const MU_DEFAULT: f64 = 0.6
const MU_ICE: f64 = 0.98
const MU_BLUE_ICE: f64 = 0.989
const MU_SLIME: f64 = 0.8
const BASE_DRAG: f64 = 0.91

fn kind_friction(k: i32) -> f64 {
    if k == MV_ICE || k == MV_PACKED_ICE { return MU_ICE }
    if k == MV_BLUE_ICE { return MU_BLUE_ICE }
    if k == MV_SLIME { return MU_SLIME }
    return MU_DEFAULT
}

fn accel_scale(mu: f64) -> f64 {
    let r: f64 = MU_DEFAULT / mu
    return r * r * r
}

fn drag_factor(mu: f64, on_ground: bool) -> f64 {
    if on_ground { return mu * BASE_DRAG }
    return BASE_DRAG
}
