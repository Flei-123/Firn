import std.rt
import std.fs
import zip.zip
import mc.mc_assets
import mc.mc_vanilla
import mc.mc_gui_tex

export { ItemSrc, isrc_new, isrc_free, isrc_open, isrc_ok, isrc_read, isrc_read_str, isrc_tex, isrc_stack }

struct ItemSrc {
    st: mc_assets.PackStack,
    ok: bool,
}

fn isrc_new() -> ItemSrc {
    return ItemSrc { st: mc_assets.stack_new(), ok: false }
}

fn isrc_free(s: *mut ItemSrc) {
    mc_assets.stack_free(&(*s).st)
    (*s).ok = false
}

fn isrc_ok(s: *mut ItemSrc) -> bool { return (*s).ok }

fn isrc_stack(s: *mut ItemSrc) -> *mut mc_assets.PackStack { return &(*s).st }

fn isrc_open(s: *mut ItemSrc, protocol: i32) -> bool {
    if (*s).ok { return true }
    var jar: rt.Buf = rt.buf_new()
    let rc: i32 = mc_vanilla.vanilla_resolve(protocol, &jar)
    if rc != mc_vanilla.VANILLA_OK {
        rt.buf_free(&jar)
        return false
    }
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    let got: usize = fs.read_file(rt.buf_str(&jar), &pk.data) catch | e | (0)
    rt.buf_free(&jar)
    if got == 0 { return false }
    var bad: bool = false
    pk.z = zip.zip_reader_open(rt.buf_ptr(&pk.data), rt.buf_len(&pk.data)) catch | e | (zip.zip_reader_empty())
    if zip.zip_entry_count(&pk.z) == 0 { bad = true }
    if bad {
        rt.buf_free(&pk.data)
        return false
    }
    pk.open = true
    pk.fmin = 0
    pk.fmax = 1000
    if mc_assets.stack_push(&(*s).st, &pk) != mc_assets.ASSET_OK { return false }
    (*s).ok = true
    return true
}

fn isrc_read(s: *mut ItemSrc, p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var i: usize = 0
    while i < (*s).st.n {
        let pk: *mut mc_assets.Pack = &(*s).st.packs[i]
        let idx: i64 = mc_assets.pack_find_bytes(pk, p, n)
        if idx >= 0 {
            rt.buf_clear(out)
            let got: usize = zip.zip_extract(&(*pk).z, idx as usize, out) catch | e | (0)
            if got > 0 { return true }
        }
        i = i + 1
    }
    return false
}

fn isrc_read_str(s: *mut ItemSrc, path: str, out: *mut rt.Buf) -> bool {
    return isrc_read(s, path.p as u64, path.length(), out)
}

fn isrc_tex(s: *mut ItemSrc, p: u64, n: usize, out: *mut mc_gui_tex.GuiTex) -> bool {
    var raw: rt.Buf = rt.buf_new()
    var ok: bool = isrc_read(s, p, n, &raw)
    var full: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    if ok { ok = mc_gui_tex.gtex_from_png(rt.buf_ptr(&raw), rt.buf_len(&raw), &full) }
    rt.buf_free(&raw)
    if !ok { return false }
    var side: i32 = full.w
    if full.h < side { side = full.h }
    if !mc_gui_tex.gtex_blank(out, side, side) {
        mc_gui_tex.gtex_free(&full)
        return false
    }
    var y: i32 = 0
    while y < side {
        var x: i32 = 0
        while x < side {
            mc_gui_tex.gtex_set(out, x, y, mc_gui_tex.gtex_get(&full, x, y))
            x = x + 1
        }
        y = y + 1
    }
    mc_gui_tex.gtex_free(&full)
    return true
}
