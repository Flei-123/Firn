import std.rt
import mc.mc_session
import mc.mc_mesh

export {
    Opts, opts_new, opts_parse, opts_text, opts_clamp, opts_view_effective, opts_fov_value,
    SMOOTH_MAX, BRIGHTNESS_DEFAULT, opts_look_flags, opts_gamma256,
    OPT_VOLUMES, FOV_MIN, FOV_MAX, FOV_DEFAULT, VIEW_MIN, VIEW_MAX, VIEW_DEFAULT, GUI_SCALE_MAX,
}

const OPT_VOLUMES: i32 = 10
const FOV_MIN: i32 = 30
const FOV_MAX: i32 = 110
const FOV_DEFAULT: i32 = 70
const VIEW_MIN: i32 = 2
const VIEW_MAX: i32 = 32
const VIEW_DEFAULT: i32 = 12
const GUI_SCALE_MAX: i32 = 4
const SMOOTH_MAX: i32 = 2
const BRIGHTNESS_DEFAULT: i32 = 50

struct Opts {
    fov: i32,
    view: i32,
    vol: [i32; 10],
    fullscreen: i32,
    vsync: i32,
    gui_scale: i32,
    hide_hud_hints: i32,
    smooth_light: i32,
    brightness: i32,
}

fn opts_new() -> Opts {
    return Opts { fov: FOV_DEFAULT, view: 0, vol: [100; 10], fullscreen: 0, vsync: 1, gui_scale: 0, hide_hud_hints: 0, smooth_light: SMOOTH_MAX, brightness: BRIGHTNESS_DEFAULT }
}

fn clamp_i(v: i32, lo: i32, hi: i32) -> i32 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn opts_clamp(o: *mut Opts) {
    (*o).fov = clamp_i((*o).fov, FOV_MIN, FOV_MAX)
    if (*o).view > 0 { (*o).view = clamp_i((*o).view, VIEW_MIN, VIEW_MAX) }
    var i: usize = 0
    while i < OPT_VOLUMES as usize {
        (*o).vol[i] = clamp_i((*o).vol[i], 0, 100)
        i = i + 1
    }
    (*o).fullscreen = clamp_i((*o).fullscreen, 0, 1)
    (*o).vsync = clamp_i((*o).vsync, 0, 1)
    (*o).gui_scale = clamp_i((*o).gui_scale, 0, GUI_SCALE_MAX)
    (*o).hide_hud_hints = clamp_i((*o).hide_hud_hints, 0, 1)
    (*o).smooth_light = clamp_i((*o).smooth_light, 0, SMOOTH_MAX)
    (*o).brightness = clamp_i((*o).brightness, 0, 100)
}

fn opts_view_effective(o: *mut Opts) -> i32 {
    if (*o).view <= 0 { return VIEW_DEFAULT }
    return (*o).view
}

fn opts_fov_value(o: *mut Opts) -> f64 {
    return (*o).fov as f64
}

fn vol_key(i: usize) -> str {
    let keys: [str; 10] = ["opt_vol0", "opt_vol1", "opt_vol2", "opt_vol3", "opt_vol4", "opt_vol5", "opt_vol6", "opt_vol7", "opt_vol8", "opt_vol9"]
    return keys[i]
}

fn opts_parse(p: u64, n: usize, o: *mut Opts) {
    (*o).fov = mc_session.session_int(p, n, "opt_fov", FOV_DEFAULT)
    (*o).view = mc_session.session_int(p, n, "view", 0)
    var i: usize = 0
    while i < OPT_VOLUMES as usize {
        (*o).vol[i] = mc_session.session_int(p, n, vol_key(i), 100)
        i = i + 1
    }
    (*o).fullscreen = mc_session.session_int(p, n, "opt_fullscreen", 0)
    (*o).vsync = mc_session.session_int(p, n, "opt_vsync", 1)
    (*o).gui_scale = mc_session.session_int(p, n, "opt_gui_scale", 0)
    (*o).hide_hud_hints = mc_session.session_int(p, n, "opt_hide_hints", 0)
    (*o).smooth_light = mc_session.session_int(p, n, "opt_ao", SMOOTH_MAX)
    (*o).brightness = mc_session.session_int(p, n, "opt_gamma", BRIGHTNESS_DEFAULT)
    opts_clamp(o)
}

fn push_line(out: *mut rt.Buf, key: str, v: i32) {
    rt.buf_push_bytes(out, key.p as u64, key.n)
    rt.buf_push(out, 61 as u8)
    rt.buf_push_dec_i64(out, v as i64)
    rt.buf_push(out, 10 as u8)
}

fn opts_is_default(o: *mut Opts) -> bool {
    var i: usize = 0
    while i < OPT_VOLUMES as usize {
        if (*o).vol[i] != 100 { return false }
        i = i + 1
    }
    return (*o).fov == FOV_DEFAULT && (*o).fullscreen == 0 && (*o).vsync == 1 && (*o).gui_scale == 0 && (*o).hide_hud_hints == 0 && (*o).smooth_light == SMOOTH_MAX && (*o).brightness == BRIGHTNESS_DEFAULT
}

fn opts_text(o: *mut Opts, out: *mut rt.Buf) {
    if opts_is_default(o) { return }
    push_line(out, "opt_fov", (*o).fov)
    var i: usize = 0
    while i < OPT_VOLUMES as usize {
        push_line(out, vol_key(i), (*o).vol[i])
        i = i + 1
    }
    push_line(out, "opt_fullscreen", (*o).fullscreen)
    push_line(out, "opt_vsync", (*o).vsync)
    push_line(out, "opt_gui_scale", (*o).gui_scale)
    push_line(out, "opt_hide_hints", (*o).hide_hud_hints)
    push_line(out, "opt_ao", (*o).smooth_light)
    push_line(out, "opt_gamma", (*o).brightness)
}

fn opts_look_flags(o: *mut Opts) -> u32 {
    if (*o).smooth_light >= SMOOTH_MAX { return mc_mesh.F_AO }
    if (*o).smooth_light == 1 { return mc_mesh.F_AO | mc_mesh.F_FLAT_LIGHT }
    return mc_mesh.F_FLAT_LIGHT
}

fn opts_gamma256(o: *mut Opts) -> i32 {
    return ((*o).brightness * 256) / 100
}
