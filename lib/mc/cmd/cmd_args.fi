// SPDX-License-Identifier: MPL-2.0
// lib/mc/cmd/cmd_args.fi -- Minecraft argument types on top of lib/brigadier: parsers with Vanilla errors, result structs and the type hook.
import std.rt
import brigadier.mem as m
import brigadier.text as tx
import brigadier.exc as ex
import brigadier.reader as rd
import brigadier.argtype as at
import brigadier.javanum as jn
import mc.cmd.cmd_tree as ct

export { QUIRK_TIME_NO_CONTEXT, args_set_quirks, Coord, Coords, IntRange, args_bind, args_hook, args_describe, args_kind_of, coords_world, V3, range_has_min, range_has_max,
    PK_NONE, PK_GAMEMODE, PK_TIME, PK_IDENTIFIER, PK_INT_RANGE, PK_BLOCK_POS, PK_VEC3, PK_VEC2, PK_COLUMN_POS, PK_ROTATION, PK_MESSAGE }

const PK_NONE: i32 = 0
const PK_GAMEMODE: i32 = 1
const PK_TIME: i32 = 2
const PK_IDENTIFIER: i32 = 3
const PK_INT_RANGE: i32 = 4
const PK_BLOCK_POS: i32 = 5
const PK_VEC3: i32 = 6
const PK_VEC2: i32 = 7
const PK_COLUMN_POS: i32 = 8
const PK_ROTATION: i32 = 9
const PK_MESSAGE: i32 = 10

const QUIRK_TIME_NO_CONTEXT: i32 = 1

const CH_CARET: u32 = 94
const CH_TILDE: u32 = 126
const CH_SPACE: u32 = 32
const CH_DOT: u32 = 46
const CH_MINUS: u32 = 45

struct Coord {
    relative: bool,
    value: f64,
}

struct Coords {
    local: bool,
    x: Coord,
    y: Coord,
    z: Coord,
}

struct IntRange {
    has_min: bool,
    min: i32,
    has_max: bool,
    max: i32,
}

fn range_has_min(r: *mut IntRange) -> bool {
    return (*r).has_min
}

fn range_has_max(r: *mut IntRange) -> bool {
    return (*r).has_max
}

fn args_kind_of(parser: str) -> i32 {
    if ct.str_eq(parser, "minecraft:gamemode") { return PK_GAMEMODE }
    if ct.str_eq(parser, "minecraft:time") { return PK_TIME }
    if ct.str_eq(parser, "minecraft:resource_location") { return PK_IDENTIFIER }
    if ct.str_eq(parser, "minecraft:int_range") { return PK_INT_RANGE }
    if ct.str_eq(parser, "minecraft:block_pos") { return PK_BLOCK_POS }
    if ct.str_eq(parser, "minecraft:vec3") { return PK_VEC3 }
    if ct.str_eq(parser, "minecraft:vec2") { return PK_VEC2 }
    if ct.str_eq(parser, "minecraft:column_pos") { return PK_COLUMN_POS }
    if ct.str_eq(parser, "minecraft:rotation") { return PK_ROTATION }
    if ct.str_eq(parser, "minecraft:message") { return PK_MESSAGE }
    return PK_NONE
}

fn props_min(props: str) -> i64 {
    if props.n < 5 {
        return 0
    }
    if rt.ld8(props.p as u64, 0) != 109 as u8 || rt.ld8(props.p as u64, 1) != 105 as u8 || rt.ld8(props.p as u64, 2) != 110 as u8 {
        return 0
    }
    var i: usize = 4
    var neg: bool = false
    if rt.ld8(props.p as u64, i) == 45 as u8 {
        neg = true
        i = i + 1
    }
    var v: i64 = 0
    while i < props.n {
        let c: u8 = rt.ld8(props.p as u64, i)
        if c < 48 as u8 || c > 57 as u8 {
            break
        }
        v = v * 10 + (c as i64 - 48)
        i = i + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

fn args_bind(t: *mut ct.CmdTree) {
    var i: usize = 0
    while i < m.arr_len[ct.Spec](&(*t).specs) {
        let sp: *mut ct.Spec = m.arr_at[ct.Spec](&(*t).specs, i)
        (*sp).kind = args_kind_of((*sp).parser)
        if (*sp).kind == PK_TIME {
            (*sp).p0 = props_min((*sp).props)
        }
        i = i + 1
    }
}

fn args_set_quirks(t: *mut ct.CmdTree, quirks: i32) {
    var i: usize = 0
    while i < m.arr_len[ct.Spec](&(*t).specs) {
        (*m.arr_at[ct.Spec](&(*t).specs, i)).quirks = quirks
        i = i + 1
    }
}

fn fail_bare(err: *mut ex.Exc, text: tx.U16) {
    *err = ex.Exc { kind: ex.EX_CUSTOM, msg: text, input: tx.u16_empty(), cursor: 0 - 1 }
}

fn fail_text(r: *mut rd.Reader, err: *mut ex.Exc, text: tx.U16) {
    *err = ex.Exc { kind: ex.EX_CUSTOM, msg: text, input: (*r).s, cursor: (*r).cursor as i64 }
}

fn fail_str(r: *mut rd.Reader, err: *mut ex.Exc, text: str) {
    fail_text(r, err, tx.u16_from_str((*r).a, text))
}

fn is_ascii_eq(t: tx.U16, s: str) -> bool {
    if t.n != s.n {
        return false
    }
    var i: usize = 0
    while i < s.n {
        if tx.u16_at(t, i) != rt.ld8(s.p as u64, i) as u32 {
            return false
        }
        i = i + 1
    }
    return true
}

fn parse_gamemode(r: *mut rd.Reader, out: *mut at.Value, err: *mut ex.Exc) -> bool {
    let name: tx.U16 = rd.read_unquoted(r)
    var mode: i64 = 0 - 1
    if is_ascii_eq(name, "survival") { mode = 0 }
    if is_ascii_eq(name, "creative") { mode = 1 }
    if is_ascii_eq(name, "adventure") { mode = 2 }
    if is_ascii_eq(name, "spectator") { mode = 3 }
    if mode < 0 {
        var b: m.Arr[u16] = tx.b16_new()
        tx.b16_ascii((*r).a, &b, "Unknown game mode: ")
        tx.b16_text((*r).a, &b, name)
        fail_text(r, err, tx.b16_view(&b))
        return false
    }
    *out = at.Value { kind: at.VK_CUSTOM, i: mode, f: 0.0, s: name }
    return true
}

fn java_round(v: f32) -> i32 {
    if v != v {
        return 0
    }
    let x: f64 = (v as f64) + 0.5
    if x >= 2147483647.0 {
        return 2147483647
    }
    if x <= 0.0 - 2147483648.0 {
        return 0 - 2147483647 - 1
    }
    var f: i64 = x as i64
    if (f as f64) > x {
        f = f - 1
    }
    return f as i32
}

fn parse_time(r: *mut rd.Reader, minimum: i64, quirks: i32, out: *mut at.Value, err: *mut ex.Exc) -> bool {
    var f: f32 = 0.0f
    if !rd.read_float(r, &f, err) {
        return false
    }
    let unit: tx.U16 = rd.read_unquoted(r)
    var mult: f32 = 1.0f
    if is_ascii_eq(unit, "d") {
        mult = 24000.0f
    } else if is_ascii_eq(unit, "s") {
        mult = 20.0f
    } else if is_ascii_eq(unit, "t") || unit.n == 0 {
        mult = 1.0f
    } else {
        if (quirks & QUIRK_TIME_NO_CONTEXT) != 0 {
            fail_bare(err, tx.u16_from_str((*r).a, "Invalid unit"))
        } else {
            fail_str(r, err, "Invalid unit")
        }
        return false
    }
    let ticks: i32 = java_round(f * mult)
    if (ticks as i64) < minimum {
        var b: m.Arr[u16] = tx.b16_new()
        tx.b16_ascii((*r).a, &b, "The tick count must not be less than ")
        tx.b16_i64((*r).a, &b, minimum)
        tx.b16_ascii((*r).a, &b, ": found ")
        tx.b16_i64((*r).a, &b, ticks as i64)
        if (quirks & QUIRK_TIME_NO_CONTEXT) != 0 {
            fail_bare(err, tx.b16_view(&b))
        } else {
            fail_text(r, err, tx.b16_view(&b))
        }
        return false
    }
    *out = at.Value { kind: at.VK_CUSTOM, i: ticks as i64, f: 0.0, s: tx.u16_empty() }
    return true
}

fn id_char(c: u32) -> bool {
    return (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || c == 95 || c == 58 || c == 47 || c == 46 || c == 45
}

fn id_ns_char(c: u32) -> bool {
    return (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || c == 95 || c == 46 || c == 45
}

fn id_path_char(c: u32) -> bool {
    return id_ns_char(c) || c == 47
}

fn parse_identifier(r: *mut rd.Reader, out: *mut at.Value, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    while rd.can_read(r) && id_char(rd.peek(r)) {
        rd.skip(r)
    }
    let t: tx.U16 = tx.u16_sub((*r).s, start, (*r).cursor)
    var colon: usize = t.n
    var i: usize = 0
    while i < t.n {
        if tx.u16_at(t, i) == 58 {
            colon = i
            break
        }
        i = i + 1
    }
    var ns: tx.U16 = tx.u16_from_str((*r).a, "minecraft")
    var path: tx.U16 = t
    var ok: bool = true
    if colon < t.n {
        if colon > 0 {
            ns = tx.u16_sub(t, 0, colon)
        }
        path = tx.u16_sub(t, colon + 1, t.n)
    }
    i = 0
    while i < ns.n {
        if !id_ns_char(tx.u16_at(ns, i)) {
            ok = false
        }
        i = i + 1
    }
    i = 0
    while i < path.n {
        if !id_path_char(tx.u16_at(path, i)) {
            ok = false
        }
        i = i + 1
    }
    if !ok {
        (*r).cursor = start
        fail_str(r, err, "Invalid ID")
        return false
    }
    var b: m.Arr[u16] = tx.b16_new()
    tx.b16_text((*r).a, &b, ns)
    tx.b16_ascii((*r).a, &b, ":")
    tx.b16_text((*r).a, &b, path)
    *out = at.Value { kind: at.VK_CUSTOM, i: 0, f: 0.0, s: tx.b16_view(&b) }
    return true
}

fn range_char(r: *mut rd.Reader) -> bool {
    let c: u32 = rd.peek(r)
    if (c >= 48 && c <= 57) || c == CH_MINUS {
        return true
    }
    if c == CH_DOT {
        return !rd.can_read_n(r, 2) || rd.peek_at(r, 1) != CH_DOT
    }
    return false
}

fn range_number(r: *mut rd.Reader, start: usize, present: *mut bool, v: *mut i32, err: *mut ex.Exc) -> bool {
    let s0: usize = (*r).cursor
    while rd.can_read(r) && range_char(r) {
        rd.skip(r)
    }
    let t: tx.U16 = tx.u16_sub((*r).s, s0, (*r).cursor)
    if t.n == 0 {
        *present = false
        return true
    }
    if !jn.parse_int(t, v) {
        (*r).cursor = start
        *err = ex.exc_builtin((*r).a, ex.EX_INVALID_INT, (*r).s, (*r).cursor, t, tx.u16_empty())
        return false
    }
    *present = true
    return true
}

fn parse_int_range(r: *mut rd.Reader, out: *mut at.Value, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    if !rd.can_read(r) {
        fail_str(r, err, "Expected value or range of values")
        return false
    }
    let res: *mut IntRange = m.arena_obj[IntRange]((*r).a) as *mut IntRange
    (*res).has_min = false
    (*res).has_max = false
    (*res).min = 0
    (*res).max = 0
    if !range_number(r, start, &(*res).has_min, &(*res).min, err) {
        return false
    }
    if rd.can_read_n(r, 2) && rd.peek(r) == CH_DOT && rd.peek_at(r, 1) == CH_DOT {
        rd.skip(r)
        rd.skip(r)
        if !range_number(r, start, &(*res).has_max, &(*res).max, err) {
            return false
        }
    } else {
        (*res).has_max = (*res).has_min
        (*res).max = (*res).min
    }
    if !(*res).has_min && !(*res).has_max {
        (*r).cursor = start
        fail_str(r, err, "Expected value or range of values")
        return false
    }
    if (*res).has_min && (*res).has_max && (*res).min > (*res).max {
        (*r).cursor = start
        fail_str(r, err, "Min cannot be bigger than max")
        return false
    }
    *out = at.Value { kind: at.VK_CUSTOM, i: res as u64 as i64, f: 0.0, s: tx.u16_empty() }
    return true
}

fn coord_int(r: *mut rd.Reader, out: *mut Coord, err: *mut ex.Exc) -> bool {
    if rd.can_read(r) && rd.peek(r) == CH_CARET {
        fail_str(r, err, "Cannot mix world & local coordinates (everything must either use ^ or not)")
        return false
    }
    if !rd.can_read(r) {
        fail_str(r, err, "Expected a block position")
        return false
    }
    var relative: bool = false
    if rd.peek(r) == CH_TILDE {
        relative = true
        rd.skip(r)
    }
    var value: f64 = 0.0
    if rd.can_read(r) && rd.peek(r) != CH_SPACE {
        if relative {
            if !rd.read_double(r, &value, err) {
                return false
            }
        } else {
            var iv: i32 = 0
            if !rd.read_int(r, &iv, err) {
                return false
            }
            value = iv as f64
        }
    }
    *out = Coord { relative: relative, value: value }
    return true
}

fn has_dot(r: *mut rd.Reader, start: usize) -> bool {
    var i: usize = start
    while i < (*r).cursor {
        if tx.u16_at((*r).s, i) == CH_DOT {
            return true
        }
        i = i + 1
    }
    return false
}

fn coord_double(r: *mut rd.Reader, center: bool, out: *mut Coord, err: *mut ex.Exc) -> bool {
    if rd.can_read(r) && rd.peek(r) == CH_CARET {
        fail_str(r, err, "Cannot mix world & local coordinates (everything must either use ^ or not)")
        return false
    }
    if !rd.can_read(r) {
        fail_str(r, err, "Expected a coordinate")
        return false
    }
    let start: usize = (*r).cursor
    var relative: bool = false
    if rd.peek(r) == CH_TILDE {
        relative = true
        rd.skip(r)
    }
    var value: f64 = 0.0
    if rd.can_read(r) && rd.peek(r) != CH_SPACE {
        if !rd.read_double(r, &value, err) {
            return false
        }
    }
    if center && !relative && !has_dot(r, start) {
        value = value + 0.5
    }
    *out = Coord { relative: relative, value: value }
    return true
}

fn need_space(r: *mut rd.Reader, start: usize, count: i32, err: *mut ex.Exc) -> bool {
    if !rd.can_read(r) || rd.peek(r) != CH_SPACE {
        (*r).cursor = start
        if count == 3 {
            fail_str(r, err, "Incomplete (expected 3 coordinates)")
        } else {
            fail_str(r, err, "Incomplete (expected 2 coordinates)")
        }
        return false
    }
    rd.skip(r)
    return true
}

fn coord_origin() -> Coord {
    return Coord { relative: true, value: 0.0 }
}

fn local_part(r: *mut rd.Reader, start: usize, out: *mut f64, err: *mut ex.Exc) -> bool {
    if !rd.can_read(r) {
        fail_str(r, err, "Expected a coordinate")
        return false
    }
    if !rd.can_read(r) || rd.peek(r) != CH_CARET {
        (*r).cursor = start
        fail_str(r, err, "Cannot mix world & local coordinates (everything must either use ^ or not)")
        return false
    }
    rd.skip(r)
    var v: f64 = 0.0
    if rd.can_read(r) && rd.peek(r) != CH_SPACE {
        if !rd.read_double(r, &v, err) {
            return false
        }
    }
    *out = v
    return true
}

fn parse_local(r: *mut rd.Reader, res: *mut Coords, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    var l: f64 = 0.0
    var u: f64 = 0.0
    var f: f64 = 0.0
    if !local_part(r, start, &l, err) { return false }
    if !need_space(r, start, 3, err) { return false }
    if !local_part(r, start, &u, err) { return false }
    if !need_space(r, start, 3, err) { return false }
    if !local_part(r, start, &f, err) { return false }
    (*res).local = true
    (*res).x = Coord { relative: false, value: l }
    (*res).y = Coord { relative: false, value: u }
    (*res).z = Coord { relative: false, value: f }
    return true
}

fn new_coords(r: *mut rd.Reader) -> *mut Coords {
    let c: *mut Coords = m.arena_obj[Coords]((*r).a) as *mut Coords
    (*c).local = false
    (*c).x = coord_origin()
    (*c).y = coord_origin()
    (*c).z = coord_origin()
    return c
}

fn coords_value(c: *mut Coords) -> at.Value {
    return at.Value { kind: at.VK_CUSTOM, i: c as u64 as i64, f: 0.0, s: tx.u16_empty() }
}

fn parse_block_pos(r: *mut rd.Reader, out: *mut at.Value, err: *mut ex.Exc) -> bool {
    let c: *mut Coords = new_coords(r)
    if rd.can_read(r) && rd.peek(r) == CH_CARET {
        if !parse_local(r, c, err) { return false }
        *out = coords_value(c)
        return true
    }
    let start: usize = (*r).cursor
    if !coord_int(r, &(*c).x, err) { return false }
    if !need_space(r, start, 3, err) { return false }
    if !coord_int(r, &(*c).y, err) { return false }
    if !need_space(r, start, 3, err) { return false }
    if !coord_int(r, &(*c).z, err) { return false }
    *out = coords_value(c)
    return true
}

fn parse_vec3(r: *mut rd.Reader, out: *mut at.Value, err: *mut ex.Exc) -> bool {
    let c: *mut Coords = new_coords(r)
    if rd.can_read(r) && rd.peek(r) == CH_CARET {
        if !parse_local(r, c, err) { return false }
        *out = coords_value(c)
        return true
    }
    let start: usize = (*r).cursor
    if !coord_double(r, true, &(*c).x, err) { return false }
    if !need_space(r, start, 3, err) { return false }
    if !coord_double(r, false, &(*c).y, err) { return false }
    if !need_space(r, start, 3, err) { return false }
    if !coord_double(r, true, &(*c).z, err) { return false }
    *out = coords_value(c)
    return true
}

fn parse_vec2(r: *mut rd.Reader, out: *mut at.Value, err: *mut ex.Exc) -> bool {
    let c: *mut Coords = new_coords(r)
    let start: usize = (*r).cursor
    if !rd.can_read(r) {
        fail_str(r, err, "Incomplete (expected 2 coordinates)")
        return false
    }
    if !coord_double(r, true, &(*c).x, err) { return false }
    if !need_space(r, start, 2, err) { return false }
    if !coord_double(r, true, &(*c).z, err) { return false }
    *out = coords_value(c)
    return true
}

fn parse_column_pos(r: *mut rd.Reader, out: *mut at.Value, err: *mut ex.Exc) -> bool {
    let c: *mut Coords = new_coords(r)
    let start: usize = (*r).cursor
    if !rd.can_read(r) {
        fail_str(r, err, "Incomplete (expected 2 coordinates)")
        return false
    }
    if !coord_int(r, &(*c).x, err) { return false }
    if !need_space(r, start, 2, err) { return false }
    if !coord_int(r, &(*c).z, err) { return false }
    *out = coords_value(c)
    return true
}

fn parse_rotation(r: *mut rd.Reader, out: *mut at.Value, err: *mut ex.Exc) -> bool {
    let c: *mut Coords = new_coords(r)
    let start: usize = (*r).cursor
    if !rd.can_read(r) {
        fail_str(r, err, "Incomplete (expected 2 coordinates)")
        return false
    }
    if !coord_double(r, false, &(*c).y, err) { return false }
    if !need_space(r, start, 2, err) { return false }
    if !coord_double(r, false, &(*c).x, err) { return false }
    *out = coords_value(c)
    return true
}

fn parse_message(r: *mut rd.Reader, out: *mut at.Value) -> bool {
    let t: tx.U16 = rd.read_rest(r)
    *out = at.Value { kind: at.VK_CUSTOM, i: 0, f: 0.0, s: t }
    return true
}

fn args_hook(user: u64, custom: i32, rp: u64, outp: u64, errp: u64) -> bool {
    let t: *mut ct.CmdTree = user as *mut ct.CmdTree
    let sp: *mut ct.Spec = ct.tree_spec(t, custom)
    let r: *mut rd.Reader = rp as *mut rd.Reader
    let out: *mut at.Value = outp as *mut at.Value
    let err: *mut ex.Exc = errp as *mut ex.Exc
    let k: i32 = (*sp).kind
    if k == PK_GAMEMODE { return parse_gamemode(r, out, err) }
    if k == PK_TIME { return parse_time(r, (*sp).p0, (*sp).quirks, out, err) }
    if k == PK_IDENTIFIER { return parse_identifier(r, out, err) }
    if k == PK_INT_RANGE { return parse_int_range(r, out, err) }
    if k == PK_BLOCK_POS { return parse_block_pos(r, out, err) }
    if k == PK_VEC3 { return parse_vec3(r, out, err) }
    if k == PK_VEC2 { return parse_vec2(r, out, err) }
    if k == PK_COLUMN_POS { return parse_column_pos(r, out, err) }
    if k == PK_ROTATION { return parse_rotation(r, out, err) }
    if k == PK_MESSAGE { return parse_message(r, out) }
    fail_str(r, err, "Unsupported argument type")
    return false
}

struct V3 {
    x: f64,
    y: f64,
    z: f64,
}

fn coords_world(c: *mut Coords, bx: f64, by: f64, bz: f64) -> V3 {
    var r: V3 = V3 { x: (*c).x.value, y: (*c).y.value, z: (*c).z.value }
    if (*c).x.relative { r.x = r.x + bx }
    if (*c).y.relative { r.y = r.y + by }
    if (*c).z.relative { r.z = r.z + bz }
    return r
}

fn put_double_text(a: *mut m.Arena, out: *mut rt.Buf, v: f64) {
    var b: m.Arr[u16] = tx.b16_new()
    jn.put_double(a, &b, v)
    ct.push_str(out, tx.u16_to_str(a, tx.b16_view(&b)))
}

fn describe_coord(a: *mut m.Arena, out: *mut rt.Buf, c: *mut Coord) {
    ct.push_str(out, "WorldCoordinate[relative=")
    if (*c).relative {
        ct.push_str(out, "true")
    } else {
        ct.push_str(out, "false")
    }
    ct.push_str(out, ", value=")
    put_double_text(a, out, (*c).value)
    ct.push_str(out, "]")
}

fn describe_opt(out: *mut rt.Buf, present: bool, v: i32) {
    if present {
        ct.push_str(out, "Optional[")
        rt.buf_push_dec_i64(out, v as i64)
        ct.push_str(out, "]")
    } else {
        ct.push_str(out, "Optional.empty")
    }
}

fn args_describe(a: *mut m.Arena, kind: i32, v: *mut at.Value, out: *mut rt.Buf) {
    if kind == PK_GAMEMODE {
        ct.push_str(out, tx.u16_to_str(a, (*v).s))
    } else if kind == PK_TIME {
        rt.buf_push_dec_i64(out, (*v).i)
    } else if kind == PK_IDENTIFIER {
        ct.push_str(out, tx.u16_to_str(a, (*v).s))
    } else if kind == PK_INT_RANGE {
        let rg: *mut IntRange = (*v).i as u64 as *mut IntRange
        ct.push_str(out, "min=")
        describe_opt(out, (*rg).has_min, (*rg).min)
        ct.push_str(out, " max=")
        describe_opt(out, (*rg).has_max, (*rg).max)
    } else if kind == PK_MESSAGE {
        ct.push_str(out, "text=")
        ct.push_str(out, tx.u16_to_str(a, (*v).s))
    } else {
        let c: *mut Coords = (*v).i as u64 as *mut Coords
        if (*c).local {
            ct.push_str(out, "LocalCoordinates[left=")
            put_double_text(a, out, (*c).x.value)
            ct.push_str(out, ", up=")
            put_double_text(a, out, (*c).y.value)
            ct.push_str(out, ", forwards=")
            put_double_text(a, out, (*c).z.value)
            ct.push_str(out, "]")
        } else {
            ct.push_str(out, "WorldCoordinates[x=")
            describe_coord(a, out, &(*c).x)
            ct.push_str(out, ", y=")
            describe_coord(a, out, &(*c).y)
            ct.push_str(out, ", z=")
            describe_coord(a, out, &(*c).z)
            ct.push_str(out, "]")
        }
    }
}
