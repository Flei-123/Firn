// lib/mc/cmd/cmd_snbt.fi -- structural SNBT compound skipper (balanced brackets, quoted strings) for selector nbt filters.
import brigadier.text as tx
import brigadier.exc as ex
import brigadier.reader as rd

export { snbt_skip_compound }

const CH_OPEN_BRACE: u32 = 123
const CH_CLOSE_BRACE: u32 = 125
const CH_OPEN_SQUARE: u32 = 91
const CH_CLOSE_SQUARE: u32 = 93

fn snbt_skip_compound(r: *mut rd.Reader, err: *mut ex.Exc) -> bool {
    if !rd.can_read(r) || rd.peek(r) != CH_OPEN_BRACE {
        return rd.expect_char(r, CH_OPEN_BRACE, err)
    }
    var depth: i32 = 0
    while true {
        if !rd.can_read(r) {
            return rd.expect_char(r, CH_CLOSE_BRACE, err)
        }
        let c: u32 = rd.peek(r)
        if rd.is_quoted_start(c) {
            rd.skip(r)
            var t: tx.U16 = tx.u16_empty()
            if !rd.read_string_until(r, c, &t, err) {
                return false
            }
            continue
        }
        rd.skip(r)
        if c == CH_OPEN_BRACE || c == CH_OPEN_SQUARE {
            depth = depth + 1
        } else if c == CH_CLOSE_BRACE || c == CH_CLOSE_SQUARE {
            depth = depth - 1
            if depth == 0 {
                return true
            }
        }
    }
    return true
}
