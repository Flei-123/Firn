// SPDX-License-Identifier: MPL-2.0
// lib/mc/cmd/cmd_range.fi -- min..max range reader for int, double and float-degree bounds.
import std.rt
import brigadier.bmem as m
import brigadier.text as tx
import brigadier.exc as ex
import brigadier.reader as rd
import brigadier.javanum as jn
import mc.cmd.cmd_fail as cf

export { Range, RK_INT, RK_DOUBLE, RK_FLOAT, range_parse, range_negative, range_describe }

const RK_INT: i32 = 0
const RK_DOUBLE: i32 = 1
const RK_FLOAT: i32 = 2

const CH_DOT: u32 = 46
const CH_MINUS: u32 = 45
const MSG_EMPTY: str = "Expected value or range of values"

struct Range {
    kind: i32,
    has_min: bool,
    has_max: bool,
    min: f64,
    max: f64,
}

fn range_char(r: *mut rd.Reader) -> bool {
    let c: u32 = rd.peek(r)
    if (c >= 48 && c <= 57) || c == CH_MINUS {
        return true
    }
    if c == CH_DOT {
        return !rd.can_read_n(r, 2) || rd.peek_at(r, 1) != CH_DOT
    }
    return false
}

fn range_number(r: *mut rd.Reader, kind: i32, start: usize, present: *mut bool, v: *mut f64, err: *mut ex.Exc) -> bool {
    let s0: usize = (*r).cursor
    while rd.can_read(r) && range_char(r) {
        rd.skip(r)
    }
    let t: tx.U16 = tx.u16_sub((*r).s, s0, (*r).cursor)
    if t.n == 0 {
        *present = false
        return true
    }
    var ok: bool = false
    var bad: i32 = ex.EX_INVALID_INT
    if kind == RK_INT {
        var iv: i32 = 0
        ok = jn.parse_int(t, &iv)
        *v = iv as f64
    } else if kind == RK_DOUBLE {
        bad = ex.EX_INVALID_DOUBLE
        ok = jn.parse_double((*r).a, t, v)
    } else {
        bad = ex.EX_INVALID_FLOAT
        var fv: f32 = 0.0f
        ok = jn.parse_float((*r).a, t, &fv)
        *v = fv as f64
    }
    if !ok {
        (*r).cursor = start
        *err = ex.exc_builtin((*r).a, bad, (*r).s, (*r).cursor, t, tx.u16_empty())
        return false
    }
    *present = true
    return true
}

fn range_parse(r: *mut rd.Reader, kind: i32, out: *mut Range, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    *out = Range { kind: kind, has_min: false, has_max: false, min: 0.0, max: 0.0 }
    if !rd.can_read(r) {
        cf.fail_str(r, err, MSG_EMPTY)
        return false
    }
    if !range_number(r, kind, start, &(*out).has_min, &(*out).min, err) {
        return false
    }
    if rd.can_read_n(r, 2) && rd.peek(r) == CH_DOT && rd.peek_at(r, 1) == CH_DOT {
        rd.skip(r)
        rd.skip(r)
        if !range_number(r, kind, start, &(*out).has_max, &(*out).max, err) {
            return false
        }
    } else {
        (*out).has_max = (*out).has_min
        (*out).max = (*out).min
    }
    if !(*out).has_min && !(*out).has_max {
        (*r).cursor = start
        cf.fail_str(r, err, MSG_EMPTY)
        return false
    }
    if kind != RK_FLOAT && (*out).has_min && (*out).has_max && (*out).min > (*out).max {
        (*r).cursor = start
        cf.fail_str(r, err, "Min cannot be bigger than max")
        return false
    }
    return true
}

fn range_negative(g: *mut Range) -> bool {
    return ((*g).has_min && (*g).min < 0.0) || ((*g).has_max && (*g).max < 0.0)
}

fn describe_bound(a: *mut m.BumpArena, out: *mut rt.Buf, kind: i32, present: bool, v: f64) {
    if !present {
        push_text(out, "Optional.empty")
        return
    }
    push_text(out, "Optional[")
    if kind == RK_INT {
        rt.buf_push_dec_i64(out, v as i64)
    } else {
        var b: m.Arr[u16] = tx.b16_new()
        if kind == RK_DOUBLE {
            jn.put_double(a, &b, v)
        } else {
            jn.put_float(a, &b, v as f32)
        }
        push_text(out, tx.u16_to_str(a, tx.b16_view(&b)))
    }
    push_text(out, "]")
}

fn push_text(out: *mut rt.Buf, s: str) {
    var i: usize = 0
    while i < s.n {
        rt.buf_push(out, rt.ld8(s.p as u64, i))
        i = i + 1
    }
}

fn range_describe(a: *mut m.BumpArena, out: *mut rt.Buf, g: *mut Range) {
    push_text(out, "[")
    describe_bound(a, out, (*g).kind, (*g).has_min, (*g).min)
    push_text(out, "..")
    describe_bound(a, out, (*g).kind, (*g).has_max, (*g).max)
    push_text(out, "]")
}
