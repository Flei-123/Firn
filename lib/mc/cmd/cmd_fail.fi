// lib/mc/cmd/cmd_fail.fi -- error construction helpers shared by the Minecraft argument parsers.
import std.rt
import brigadier.bmem as m
import brigadier.text as tx
import brigadier.exc as ex
import brigadier.reader as rd

export { fail_bare, fail_text, fail_str, fail_at, is_ascii_eq, text_has_prefix }

fn fail_bare(err: *mut ex.Exc, text: tx.U16) {
    *err = ex.Exc { kind: ex.EX_CUSTOM, msg: text, input: tx.u16_empty(), cursor: 0 - 1 }
}

fn fail_text(r: *mut rd.Reader, err: *mut ex.Exc, text: tx.U16) {
    *err = ex.Exc { kind: ex.EX_CUSTOM, msg: text, input: (*r).s, cursor: (*r).cursor as i64 }
}

fn fail_str(r: *mut rd.Reader, err: *mut ex.Exc, text: str) {
    fail_text(r, err, tx.u16_from_str((*r).a, text))
}

fn is_ascii_eq(t: tx.U16, s: str) -> bool {
    if t.n != s.n {
        return false
    }
    var i: usize = 0
    while i < s.n {
        if tx.u16_at(t, i) != rt.ld8(s.p as u64, i) as u32 {
            return false
        }
        i = i + 1
    }
    return true
}
fn fail_at(r: *mut rd.Reader, err: *mut ex.Exc, text: tx.U16, cursor: usize) {
    *err = ex.Exc { kind: ex.EX_CUSTOM, msg: text, input: (*r).s, cursor: cursor as i64 }
}

fn text_has_prefix(t: tx.U16, s: str) -> bool {
    if t.n < s.n {
        return false
    }
    var i: usize = 0
    while i < s.n {
        if tx.u16_at(t, i) != rt.ld8(s.p as u64, i) as u32 {
            return false
        }
        i = i + 1
    }
    return true
}
