// lib/mc/cmd/cmd_id.fi -- resource location reader.
import brigadier.bmem as m
import brigadier.text as tx
import brigadier.exc as ex
import brigadier.reader as rd
import brigadier.argtype as at
import mc.cmd.cmd_fail as cf

export { parse_identifier }

const CH_DOT: u32 = 46

fn id_char(c: u32) -> bool {
    return (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || c == 95 || c == 58 || c == 47 || c == 46 || c == 45
}

fn id_ns_char(c: u32) -> bool {
    return (c >= 48 && c <= 57) || (c >= 97 && c <= 122) || c == 95 || c == 46 || c == 45
}

fn id_path_char(c: u32) -> bool {
    return id_ns_char(c) || c == 47
}

fn parse_identifier(r: *mut rd.Reader, out: *mut at.Value, err: *mut ex.Exc) -> bool {
    let start: usize = (*r).cursor
    while rd.can_read(r) && id_char(rd.peek(r)) {
        rd.skip(r)
    }
    let t: tx.U16 = tx.u16_sub((*r).s, start, (*r).cursor)
    var colon: usize = t.n
    var i: usize = 0
    while i < t.n {
        if tx.u16_at(t, i) == 58 {
            colon = i
            break
        }
        i = i + 1
    }
    var ns: tx.U16 = tx.u16_from_str((*r).a, "minecraft")
    var path: tx.U16 = t
    var ok: bool = true
    if colon < t.n {
        if colon > 0 {
            ns = tx.u16_sub(t, 0, colon)
        }
        path = tx.u16_sub(t, colon + 1, t.n)
    }
    i = 0
    while i < ns.n {
        if !id_ns_char(tx.u16_at(ns, i)) {
            ok = false
        }
        i = i + 1
    }
    i = 0
    while i < path.n {
        if !id_path_char(tx.u16_at(path, i)) {
            ok = false
        }
        i = i + 1
    }
    if !ok {
        (*r).cursor = start
        cf.fail_str(r, err, "Invalid ID")
        return false
    }
    var b: m.Arr[u16] = tx.b16_new()
    tx.b16_text((*r).a, &b, ns)
    tx.b16_ascii((*r).a, &b, ":")
    tx.b16_text((*r).a, &b, path)
    *out = at.Value { kind: at.VK_CUSTOM, i: 0, f: 0.0, s: tx.b16_view(&b) }
    return true
}
