// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_dig_sel.fi -- picks the generated break-time table (lib/mc/vNNN/mc_dig_vNNN.fi) of a protocol.
//
//   dig_for_protocol(protocol)   DigData of that version; check mc_dig.dig_ok (false = no table generated for it)
//
// Tables exist for the versions whose inventory slots mc_inv decodes (1.13.2 .. 1.20.4: 754 1.16.5, 758 1.18.2, 762 1.19.4,
// 763 1.20.1, 764 1.20.2; 1.20.5+ with data components: 767 1.21.1, 769 1.21.4, 772 1.21.8, 774 1.21.11, 775 26.1 - those
// from the items' `minecraft:tool` components and block tags, see gen_dig.py). Generator: tools/mcgen/gen_dig.py <minecraft-data/data> <version> <protocol> <out.fi>.
import mc.mc_dig
import mc.v754.mc_dig_v754
import mc.v758.mc_dig_v758
import mc.v762.mc_dig_v762
import mc.v763.mc_dig_v763
import mc.v764.mc_dig_v764
import mc.v767.mc_dig_v767
import mc.v769.mc_dig_v769
import mc.v772.mc_dig_v772
import mc.v774.mc_dig_v774
import mc.v775.mc_dig_v775

export { dig_for_protocol }

fn dig_for_protocol(protocol: i32) -> mc_dig.DigData {
    if protocol == 754 { return mc_dig_v754.dig_make() }
    if protocol == 758 { return mc_dig_v758.dig_make() }
    if protocol == 762 { return mc_dig_v762.dig_make() }
    if protocol == 763 { return mc_dig_v763.dig_make() }
    if protocol == 764 { return mc_dig_v764.dig_make() }
    if protocol == 767 { return mc_dig_v767.dig_make() }
    if protocol == 769 { return mc_dig_v769.dig_make() }
    if protocol == 772 { return mc_dig_v772.dig_make() }
    if protocol == 774 { return mc_dig_v774.dig_make() }
    if protocol == 775 { return mc_dig_v775.dig_make() }
    return mc_dig.dig_open(0 as u64)
}
