import std.rt
import mc.mc_text

export { Styled, styled_new, styled_free, styled_clear, styled_from_doc, styled_len, styled_text, styled_colors, styled_flags, styled_argb }

struct Styled {
    text: rt.Buf,
    colors: rt.Buf,
    flags: rt.Buf,
}

fn styled_new() -> Styled {
    return Styled { text: rt.buf_new(), colors: rt.buf_new(), flags: rt.buf_new() }
}

fn styled_free(s: *mut Styled) {
    rt.buf_free(&(*s).text)
    rt.buf_free(&(*s).colors)
    rt.buf_free(&(*s).flags)
}

fn styled_clear(s: *mut Styled) {
    rt.buf_clear(&(*s).text)
    rt.buf_clear(&(*s).colors)
    rt.buf_clear(&(*s).flags)
}

fn styled_len(s: *mut Styled) -> usize { return rt.buf_len(&(*s).text) }
fn styled_text(s: *mut Styled) -> u64 { return rt.buf_ptr(&(*s).text) }
fn styled_colors(s: *mut Styled) -> u64 { return rt.buf_ptr(&(*s).colors) }
fn styled_flags(s: *mut Styled) -> u64 { return rt.buf_ptr(&(*s).flags) }

fn styled_argb(rgb: i32) -> u32 {
    if rgb < 0 { return 0xFFFFFFFF }
    let r: u32 = ((rgb >> 16) & 255) as u32
    let g: u32 = ((rgb >> 8) & 255) as u32
    let b: u32 = (rgb & 255) as u32
    return 0xFF000000 | (b << 16) | (g << 8) | r
}

fn push_color(s: *mut Styled, argb: u32) {
    let n: usize = rt.buf_len(&(*s).colors)
    var i: usize = 0
    while i < 4 {
        rt.buf_push(&(*s).colors, 0)
        i = i + 1
    }
    rt.st32(rt.buf_ptr(&(*s).colors), n / 4, argb)
}

fn styled_from_doc(s: *mut Styled, doc: *mut mc_text.TextDoc, base: u32) {
    let n: usize = mc_text.text_len(doc)
    let p: u64 = mc_text.text_ptr(doc)
    let spans: usize = mc_text.text_span_count(doc)
    var span: usize = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        var col: u32 = base
        var fl: u32 = 0 as u32
        while span < spans && mc_text.text_span_off(doc, span) + mc_text.text_span_len(doc, span) <= i { span = span + 1 }
        if span < spans && mc_text.text_span_off(doc, span) <= i {
            let sc: i32 = mc_text.text_span_color(doc, span)
            if sc >= 0 { col = styled_argb(sc) }
            fl = mc_text.text_span_flags(doc, span)
        }
        if c >= 128 as u8 && c < 192 as u8 {
        } else {
            var g: u8 = c
            if c >= 192 as u8 || (c < 32 as u8 && c != 10 as u8) { g = 63 as u8 }
            rt.buf_push(&(*s).text, g)
            rt.buf_push(&(*s).flags, fl as u8)
            push_color(s, col)
        }
        i = i + 1
    }
}
