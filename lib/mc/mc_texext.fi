// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_texext.fi -- "extended tiles": one atlas tile per (block, face class) texture slot so that resource packs reach
// EVERY solid block (stairs/slabs use their material), with separate top / side / bottom textures.
//
// Data: lib/mc/mc_blocktex.fi (GENERATED by tools/mcgen/gen_blocktex.py from minecraft-data block names; nothing by hand).
// Tile ids: 1..58 = the default pack (mc_texture), EXT_BASE + i = extended tile i (i = compact index, assigned in registry order
// by tex_build_tables_ext, so the ids depend on the game version only -- never on the loaded packs; meshes stay valid across a
// pack reload). Every extended tile starts as a copy of the default tile the old rules (mc_texture.tex_tiles_for_name) give the
// block, so without packs the picture is the same as before.
//
//     var ex: mc_texext.TexExt = mc_texext.texext_new()
//     mc_texext.tex_build_tables_ext(&registry, &tables, &ex)        // instead of mc_texture.tex_build_tables
//     var atlas: mc_texture.Atlas = mc_texext.texext_atlas_new(32, &ex)   // defaults upscaled; packs: mc_assets.assets_apply_ext
import std.rt
import mc.mc_texture
import mc.mc_registry
import mc.mc_mesh
import mc.mc_blocktex
import mc.mc_lod_tint

export {
    TexExt, EXT_BASE, EXT_COLS, texext_new, texext_free, tex_build_tables_ext, texext_atlas_new, texext_count,
    texext_tile_id, texext_twins_fill, texext_cand, texext_default, texext_lookup,
}

const EXT_BASE: u32 = 64
const EXT_COLS: i32 = 32
const MODEL_ONLY_DEFAULT: u32 = 1

struct TexExt {
    n: usize, // extended tiles in use (compact)
    glob: u64, // u16 per compact index -> global slot index (BT_TILES record)
    def: u64, // u16 per compact index -> default tile id (1..58)
    map: u64, // u16 per global slot index -> compact + 1 (0 = unassigned)
    tile_off: u64, // u32 per global slot -> byte offset of its record in BT_TILES
    block_off: u64, // u32 per block record -> byte offset in BT_BLOCKS (sorted: binary search)
    tiles: u64, // the MeshTables.tiles of the last tex_build_tables_ext (holds the tint twin table)
    ntwin: usize, // tint twin tiles after the extended tiles (mc_lod_tint)
}

fn texext_new() -> TexExt {
    var e: TexExt = TexExt { n: 0, glob: 0, def: 0, map: 0, tile_off: 0, block_off: 0, tiles: 0, ntwin: 0 }
    let nt: usize = mc_blocktex.BT_TILE_COUNT
    let nb: usize = mc_blocktex.BT_BLOCK_COUNT
    e.glob = rt.heap_alloc(nt * 2)
    e.def = rt.heap_alloc(nt * 2)
    e.map = rt.heap_alloc(nt * 2)
    e.tile_off = rt.heap_alloc(nt * 4)
    e.block_off = rt.heap_alloc(nb * 4)
    var i: usize = 0
    while i < nt {
        rt.st16(e.glob, i, 0 as u16)
        rt.st16(e.def, i, 0 as u16)
        rt.st16(e.map, i, 0 as u16)
        i = i + 1
    }
    // record offsets (records are zero terminated)
    let tp: u64 = mc_blocktex.BT_TILES.p as u64
    let tl: usize = mc_blocktex.BT_TILES.n
    var pos: usize = 0
    i = 0
    while i < nt && pos < tl {
        rt.st32(e.tile_off, i, pos as u32)
        while pos < tl && rt.ld8(tp, pos) != 0 as u8 { pos = pos + 1 }
        pos = pos + 1
        i = i + 1
    }
    let bp: u64 = mc_blocktex.BT_BLOCKS.p as u64
    let bl: usize = mc_blocktex.BT_BLOCKS.n
    pos = 0
    i = 0
    while i < nb && pos < bl {
        rt.st32(e.block_off, i, pos as u32)
        while pos < bl && rt.ld8(bp, pos) != 0 as u8 { pos = pos + 1 }
        pos = pos + 1
        i = i + 1
    }
    return e
}

fn texext_free(e: *mut TexExt) {
    if (*e).glob != 0 {
        let nt: usize = mc_blocktex.BT_TILE_COUNT
        rt.heap_free((*e).glob, nt * 2)
        rt.heap_free((*e).def, nt * 2)
        rt.heap_free((*e).map, nt * 2)
        rt.heap_free((*e).tile_off, nt * 4)
        rt.heap_free((*e).block_off, mc_blocktex.BT_BLOCK_COUNT * 4)
    }
    (*e).glob = 0
    (*e).n = 0
}

fn texext_count(e: *mut TexExt) -> usize { return (*e).n }

// Tile id of compact index i.
fn texext_tile_id(i: usize) -> u32 { return EXT_BASE + (i as u32) }

// Default tile (1..58) the extended tile i is copied from.
fn texext_default(e: *mut TexExt, i: usize) -> u32 { return rt.ld16((*e).def, i) as u32 }

// k-th candidate file name (without .png) of extended tile i: (ptr, len) via out params; false when k is past the list.
fn texext_cand(e: *mut TexExt, i: usize, k: usize, p: *mut u64, n: *mut usize) -> bool {
    if i >= (*e).n { return false }
    let g: usize = rt.ld16((*e).glob, i) as usize
    let base: u64 = mc_blocktex.BT_TILES.p as u64
    let tl: usize = mc_blocktex.BT_TILES.n
    var pos: usize = rt.ld32((*e).tile_off, g) as usize
    var cur: usize = 0
    while cur < k {
        while pos < tl && rt.ld8(base, pos) != 44 as u8 && rt.ld8(base, pos) != 0 as u8 { pos = pos + 1 }
        if pos >= tl || rt.ld8(base, pos) == 0 as u8 { return false }
        pos = pos + 1
        cur = cur + 1
    }
    var m: usize = 0
    while pos + m < tl && rt.ld8(base, pos + m) != 44 as u8 && rt.ld8(base, pos + m) != 0 as u8 { m = m + 1 }
    if m == 0 { return false }
    *p = base + pos as u64
    *n = m
    return true
}

// Compares the block name (np, nl) with the name part of record `off` of BT_BLOCKS: -1 / 0 / 1.
fn cmp_name(np: u64, nl: usize, off: usize) -> i32 {
    let bp: u64 = mc_blocktex.BT_BLOCKS.p as u64
    var i: usize = 0
    while true {
        var a: u32 = 0 as u32
        if i < nl { a = rt.ld8(np, i) as u32 }
        var b: u32 = rt.ld8(bp, off + i) as u32
        if b == 32 as u32 || b == 0 as u32 { b = 0 as u32 }
        if a < b { return 0 - 1 }
        if a > b { return 1 }
        if a == 0 as u32 { return 0 }
        i = i + 1
    }
    return 0
}

fn read_num(p: u64, pos: *mut usize) -> u32 {
    var v: u32 = 0 as u32
    while rt.ld8(p, *pos) >= 48 as u8 && rt.ld8(p, *pos) <= 57 as u8 {
        v = v * 10 as u32 + ((rt.ld8(p, *pos) as u32) - 48 as u32)
        *pos = *pos + 1
    }
    return v
}

// Slot indices (side, top, bottom) of the block named (np, nl) in the generated table; false = unknown name.
fn texext_lookup(e: *mut TexExt, np: u64, nl: usize, out: *mut [u32; 3]) -> bool {
    var lo: i64 = 0
    var hi: i64 = (mc_blocktex.BT_BLOCK_COUNT as i64) - 1
    let bp: u64 = mc_blocktex.BT_BLOCKS.p as u64
    while lo <= hi {
        let mid: i64 = (lo + hi) / 2
        let off: usize = rt.ld32((*e).block_off, mid as usize) as usize
        let c: i32 = cmp_name(np, nl, off)
        if c == 0 {
            var pos: usize = off + nl + 1
            (*out)[0] = read_num(bp, &pos)
            pos = pos + 1
            (*out)[1] = read_num(bp, &pos)
            pos = pos + 1
            (*out)[2] = read_num(bp, &pos)
            return true
        }
        if c < 0 { hi = mid - 1 } else { lo = mid + 1 }
    }
    return false
}

// Compact id of global slot g (assigning the next one when new); `deft` = default tile of the first user.
fn assign(e: *mut TexExt, g: u32, deft: u32) -> u32 {
    let m: u32 = rt.ld16((*e).map, g as usize) as u32
    if m != 0 as u32 { return EXT_BASE + m - 1 as u32 }
    let i: usize = (*e).n
    rt.st16((*e).glob, i, g as u16)
    rt.st16((*e).def, i, deft as u16)
    rt.st16((*e).map, g as usize, (i + 1) as u16)
    (*e).n = i + 1
    return EXT_BASE + (i as u32)
}

// Like mc_texture.tex_build_tables, but every visible face gets an extended tile (side / top / bottom slot of the block name).
// Faces the old rules leave empty stay 0; unknown names keep the old default tile. The table `ex` is reset first.
fn tex_build_tables_ext(r: *mut mc_registry.Registry, t: *mut mc_mesh.MeshTables, ex: *mut TexExt) {
    let nt: usize = mc_blocktex.BT_TILE_COUNT
    var i: usize = 0
    while i < nt {
        rt.st16((*ex).map, i, 0 as u16)
        i = i + 1
    }
    (*ex).n = 0
    (*ex).ntwin = 0
    (*ex).tiles = (*t).tiles
    mc_lod_tint.twin_clear((*t).tiles)
    let ns: i32 = mc_registry.reg_state_count(r)
    var lim: i32 = ns
    if lim > 32768 { lim = 32768 }
    var b: i32 = 0
    var faces: [u16; 6] = [0 as u16; 6]
    var slot: [u32; 3] = [0 as u32; 3]
    var out: [u16; 6] = [0 as u16; 6]
    while b < mc_registry.reg_block_count(r) {
        var len: usize = 0
        let p: u64 = mc_registry.reg_block_name(r, b, &len)
        let fl: u32 = mc_registry.reg_block_flags(r, b)
        let solid: bool = (fl & mc_registry.RF_SOLID) != 0 as u32
        var opq: u8 = 0 as u8
        if solid && (fl & mc_registry.RF_TRANSPARENT) == 0 as u32 { opq = 1 as u8 }
        mc_texture.tex_tiles_for_name(p, len, solid, &faces)
        var f: usize = 0
        while f < 6 {
            out[f] = faces[f]
            f = f + 1
        }
        if texext_lookup(ex, p, len, &slot) {
            // face order -x +x -y +y -z +z ; slot order side top bottom
            f = 0
            while f < 6 {
                if faces[f] != 0 as u16 {
                    var which: usize = 0
                    if f == 2 { which = 2 }
                    if f == 3 { which = 1 }
                    if (*ex).n < 60000 {
                        out[f] = assign(ex, slot[which], faces[f] as u32) as u16
                    }
                }
                f = f + 1
            }
        }
        let tcls: u32 = mc_lod_tint.twin_class_of_name(p, len)
        if tcls != mc_lod_tint.CLS_NONE { mc_lod_tint.twin_mark((*t).tiles, out[3] as u32, tcls) }
        var st: i32 = mc_registry.reg_block_min_state(r, b)
        while st <= mc_registry.reg_block_max_state(r, b) && st < lim {
            rt.st8((*t).opaque, st as usize, opq)
            f = 0
            while f < 6 {
                rt.st16((*t).tiles, (st as usize) * 6 + f, out[f])
                f = f + 1
            }
            st = st + 1
        }
        b = b + 1
    }
    var g: usize = 0
    while g < nt {
        assign(ex, g as u32, MODEL_ONLY_DEFAULT)
        g = g + 1
    }
    (*ex).ntwin = mc_lod_tint.twin_assign((*t).tiles, EXT_BASE + ((*ex).n as u32))
}

// An atlas with room for the default pack and the `ex.n` extended tiles, tile size `ts` (power of two): defaults drawn / upscaled,
// every extended tile copied from its default tile. Free with atlas_free.
fn texext_atlas_new(ts: i32, ex: *mut TexExt) -> mc_texture.Atlas {
    let total: i32 = (EXT_BASE as i32) + ((*ex).n as i32) + ((*ex).ntwin as i32)
    var rows: i32 = (total + EXT_COLS - 1) / EXT_COLS
    if rows < 2 { rows = 2 }
    var a: mc_texture.Atlas = mc_texture.atlas_new(ts, EXT_COLS, rows)
    if a.px == 0 { return a }
    mc_texture.atlas_fill_default(&a)
    var i: usize = 0
    while i < (*ex).n {
        mc_texture.atlas_copy_tile(&a, EXT_BASE + (i as u32), texext_default(ex, i))
        i = i + 1
    }
    texext_twins_fill(&a, ex)
    mc_texture.atlas_build_avg(&a)
    return a
}

fn texext_twins_fill(a: *mut mc_texture.Atlas, ex: *mut TexExt) {
    if (*ex).tiles == 0 || (*ex).ntwin == 0 { return }
    mc_lod_tint.twins_fill(a, (*ex).tiles, EXT_BASE + ((*ex).n as u32) - 1 as u32)
}
