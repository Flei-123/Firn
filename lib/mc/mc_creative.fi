import std.rt
import mc.mc_registry
import mc.mc_creative_rules

export {
    Creative, cr_new, cr_free, cr_build, cr_ready, cr_select, cr_tab, cr_count, cr_rows, cr_max_scroll, cr_scroll, cr_scroll_rows, cr_set_scroll_from_px, cr_item,
    cr_tab_title, cr_tab_icon, cr_query_push, cr_query_pop, cr_query_clear, cr_query_ptr, cr_query_len, cr_has_scrollbar, cr_is_search, cr_in_tab, cr_focus, cr_set_focus,
    CR_COLS, CR_ROWS, CR_PAGE, CR_QUERY_MAX,
}

const CR_COLS: i32 = 9
const CR_ROWS: i32 = 5
const CR_PAGE: i32 = 45
const CR_QUERY_MAX: usize = 48

struct Creative {
    tab: i32,
    scroll: i32,
    masks: u64,
    nitems: i32,
    list: u64,
    n: i32,
    query: [u8; 48],
    qn: usize,
    focus: bool,
    ready: bool,
}

fn cr_new() -> Creative {
    return Creative { tab: 0, scroll: 0, masks: 0 as u64, nitems: 0, list: 0 as u64, n: 0, query: [0 as u8; 48], qn: 0, focus: false, ready: false }
}

fn cr_free(cr: *mut Creative) {
    if (*cr).ready {
        rt.heap_free((*cr).masks, ((*cr).nitems as usize) * 4 + 4)
        rt.heap_free((*cr).list, ((*cr).nitems as usize) * 4 + 4)
    }
    (*cr).ready = false
    (*cr).n = 0
}

fn cr_ready(cr: *mut Creative) -> bool { return (*cr).ready }

fn cr_tab(cr: *mut Creative) -> i32 { return (*cr).tab }

fn cr_count(cr: *mut Creative) -> i32 { return (*cr).n }

fn cr_focus(cr: *mut Creative) -> bool { return (*cr).focus && (*cr).tab == mc_creative_rules.TAB_SEARCH }

fn cr_set_focus(cr: *mut Creative, on: bool) { (*cr).focus = on }

fn cr_is_search(cr: *mut Creative) -> bool { return (*cr).tab == mc_creative_rules.TAB_SEARCH }

fn cr_has_scrollbar(cr: *mut Creative) -> bool { return (*cr).tab != mc_creative_rules.TAB_INVENTORY }

fn cr_query_ptr(cr: *mut Creative) -> u64 { return (&(*cr).query[0]) as u64 }

fn cr_query_len(cr: *mut Creative) -> usize { return (*cr).qn }

fn cr_build(cr: *mut Creative, reg: *mut mc_registry.Registry) -> bool {
    if (*cr).ready { return true }
    let total: i32 = mc_registry.reg_item_count(reg)
    if total <= 0 { return false }
    (*cr).nitems = total
    (*cr).masks = rt.heap_alloc((total as usize) * 4 + 4)
    (*cr).list = rt.heap_alloc((total as usize) * 4 + 4)
    var i: i32 = 0
    while i < total {
        var n: usize = 0
        let p: u64 = mc_registry.reg_item_name(reg, i, &n)
        var block: bool = false
        if p != 0 as u64 { block = mc_registry.reg_block_by_name(reg, p, n) >= 0 }
        var m: u32 = 0 as u32
        if p != 0 as u64 { m = mc_creative_rules.rules_mask(p, n, block) }
        rt.st32((*cr).masks, i as usize, m)
        i = i + 1
    }
    (*cr).ready = true
    cr_refill(cr, reg)
    return true
}

fn cr_in_tab(cr: *mut Creative, item: i32, tab: i32) -> bool {
    if !(*cr).ready || item < 0 || item >= (*cr).nitems { return false }
    return (rt.ld32((*cr).masks, item as usize) & mc_creative_rules.rules_bit(tab)) != 0 as u32
}

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 { return c + 32 as u8 }
    return c
}

fn contains_query(cr: *mut Creative, p: u64, n: usize) -> bool {
    if (*cr).qn == 0 { return true }
    if n < (*cr).qn { return false }
    var start: usize = 0
    while start + (*cr).qn <= n {
        var k: usize = 0
        var ok: bool = true
        while k < (*cr).qn {
            var ch: u8 = lower(rt.ld8(p, start + k))
            if ch == 95 as u8 { ch = 32 as u8 }
            if ch != (*cr).query[k] { ok = false }
            k = k + 1
        }
        if ok { return true }
        start = start + 1
    }
    return false
}

fn cr_refill(cr: *mut Creative, reg: *mut mc_registry.Registry) {
    (*cr).n = 0
    var i: i32 = 0
    while i < (*cr).nitems {
        let m: u32 = rt.ld32((*cr).masks, i as usize)
        var take: bool = false
        if (*cr).tab == mc_creative_rules.TAB_SEARCH {
            take = m != 0 as u32
            if take {
                var n: usize = 0
                let p: u64 = mc_registry.reg_item_name(reg, i, &n)
                take = contains_query(cr, p, n)
            }
        } else if (*cr).tab != mc_creative_rules.TAB_INVENTORY {
            take = (m & mc_creative_rules.rules_bit((*cr).tab)) != 0 as u32
        }
        if take {
            rt.st32((*cr).list, (*cr).n as usize, i as u32)
            (*cr).n = (*cr).n + 1
        }
        i = i + 1
    }
    (*cr).scroll = 0
}

fn cr_select(cr: *mut Creative, reg: *mut mc_registry.Registry, tab: i32) {
    if tab < 0 || tab >= mc_creative_rules.TAB_COUNT { return }
    (*cr).tab = tab
    (*cr).focus = tab == mc_creative_rules.TAB_SEARCH
    if (*cr).ready { cr_refill(cr, reg) }
}

fn cr_query_push(cr: *mut Creative, reg: *mut mc_registry.Registry, code: u32) -> bool {
    if (*cr).tab != mc_creative_rules.TAB_SEARCH || !(*cr).focus { return false }
    if code < 32 as u32 || code > 126 as u32 || (*cr).qn >= CR_QUERY_MAX { return false }
    (*cr).query[(*cr).qn] = lower(code as u8)
    (*cr).qn = (*cr).qn + 1
    if (*cr).ready { cr_refill(cr, reg) }
    return true
}

fn cr_query_pop(cr: *mut Creative, reg: *mut mc_registry.Registry) -> bool {
    if (*cr).qn == 0 { return false }
    (*cr).qn = (*cr).qn - 1
    if (*cr).ready { cr_refill(cr, reg) }
    return true
}

fn cr_query_clear(cr: *mut Creative, reg: *mut mc_registry.Registry) {
    (*cr).qn = 0
    if (*cr).ready { cr_refill(cr, reg) }
}

fn cr_rows(cr: *mut Creative) -> i32 { return ((*cr).n + CR_COLS - 1) / CR_COLS }

fn cr_max_scroll(cr: *mut Creative) -> i32 {
    let m: i32 = cr_rows(cr) - CR_ROWS
    if m < 0 { return 0 }
    return m
}

fn cr_scroll(cr: *mut Creative) -> i32 { return (*cr).scroll }

fn cr_scroll_rows(cr: *mut Creative, d: i32) {
    var v: i32 = (*cr).scroll + d
    if v < 0 { v = 0 }
    if v > cr_max_scroll(cr) { v = cr_max_scroll(cr) }
    (*cr).scroll = v
}

fn cr_set_scroll_from_px(cr: *mut Creative, rel_y: i32, track: i32, handle: i32) {
    let mx: i32 = cr_max_scroll(cr)
    if mx <= 0 || track <= handle {
        (*cr).scroll = 0
        return
    }
    var num: i32 = (rel_y - handle / 2) * mx
    let den: i32 = track - handle
    if num < 0 { num = 0 }
    var v: i32 = (num + den / 2) / den
    if v > mx { v = mx }
    (*cr).scroll = v
}

fn cr_item(cr: *mut Creative, k: i32) -> i32 {
    if k < 0 || k >= CR_PAGE { return 0 - 1 }
    let idx: i32 = (*cr).scroll * CR_COLS + k
    if idx >= (*cr).n { return 0 - 1 }
    return rt.ld32((*cr).list, idx as usize) as i32
}

fn cr_tab_title(tab: i32) -> str {
    if tab == mc_creative_rules.TAB_BUILDING { return "Building Blocks" }
    if tab == mc_creative_rules.TAB_COLORED { return "Colored Blocks" }
    if tab == mc_creative_rules.TAB_NATURAL { return "Natural Blocks" }
    if tab == mc_creative_rules.TAB_FUNCTIONAL { return "Functional Blocks" }
    if tab == mc_creative_rules.TAB_REDSTONE { return "Redstone Blocks" }
    if tab == mc_creative_rules.TAB_SEARCH { return "Search Items" }
    if tab == mc_creative_rules.TAB_TOOLS { return "Tools & Utilities" }
    if tab == mc_creative_rules.TAB_COMBAT { return "Combat" }
    if tab == mc_creative_rules.TAB_FOOD { return "Food & Drinks" }
    if tab == mc_creative_rules.TAB_INGREDIENTS { return "Ingredients" }
    if tab == mc_creative_rules.TAB_SPAWN { return "Spawn Eggs" }
    return "Inventory"
}

fn cr_tab_icon(tab: i32) -> str {
    if tab == mc_creative_rules.TAB_BUILDING { return "bricks" }
    if tab == mc_creative_rules.TAB_COLORED { return "cyan_dye" }
    if tab == mc_creative_rules.TAB_NATURAL { return "grass_block" }
    if tab == mc_creative_rules.TAB_FUNCTIONAL { return "oak_sign" }
    if tab == mc_creative_rules.TAB_REDSTONE { return "redstone" }
    if tab == mc_creative_rules.TAB_SEARCH { return "compass" }
    if tab == mc_creative_rules.TAB_TOOLS { return "diamond_pickaxe" }
    if tab == mc_creative_rules.TAB_COMBAT { return "netherite_sword" }
    if tab == mc_creative_rules.TAB_FOOD { return "golden_apple" }
    if tab == mc_creative_rules.TAB_INGREDIENTS { return "iron_ingot" }
    if tab == mc_creative_rules.TAB_SPAWN { return "pig_spawn_egg" }
    return "chest"
}
