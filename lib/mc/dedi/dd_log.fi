// SPDX-License-Identifier: MPL-2.0
// lib/mc/dedi/dd_log.fi -- console log in the vanilla line format "[HH:MM:SS INFO]: text" on stdout and in logs/latest.log.

import std.rt
import std.io
import std.fs
import std.time

export { log_open, log_info, log_warn, log_error, log_close }

static mut g_path: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }
static mut g_open: bool = false

fn log_open(root: str) {
    var dir: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&dir, root.p as u64, root.n)
    if root.n > 0 { rt.buf_push(&dir, 47 as u8) }
    rt.buf_push_bytes(&dir, "logs".p as u64, 4)
    fs.mkdir_all(rt.buf_str(&dir)) catch false
    rt.buf_clear(&g_path)
    rt.buf_push_bytes(&g_path, rt.buf_ptr(&dir), rt.buf_len(&dir))
    rt.buf_push_bytes(&g_path, "/latest.log".p as u64, 11)
    rt.buf_push(&g_path, 0 as u8)
    io.write_file(rt.buf_ptr(&g_path), 0, 0)
    g_open = true
    rt.buf_free(&dir)
}

fn log_close() {
    g_open = false
}

fn two(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (48 + v / 10) as u8)
    rt.buf_push(b, (48 + v % 10) as u8)
}

fn emit(level: str, text: str) {
    var line: rt.Buf = rt.buf_new()
    let now: i64 = time.now_unix_ms()
    let t: time.DateTime = time.local_from_unix(now) catch | e | time.civil_from_unix(now)
    rt.buf_push(&line, 91 as u8)
    two(&line, t.hour)
    rt.buf_push(&line, 58 as u8)
    two(&line, t.minute)
    rt.buf_push(&line, 58 as u8)
    two(&line, t.second)
    rt.buf_push(&line, 32 as u8)
    rt.buf_push_bytes(&line, level.p as u64, level.n)
    rt.buf_push_bytes(&line, "]: ".p as u64, 3)
    rt.buf_push_bytes(&line, text.p as u64, text.n)
    rt.buf_push(&line, 10 as u8)
    io.print_bytes(rt.buf_ptr(&line), rt.buf_len(&line))
    if g_open { io.append_file(rt.buf_ptr(&g_path), rt.buf_ptr(&line), rt.buf_len(&line)) }
    rt.buf_free(&line)
}

fn log_info(text: str) { emit("INFO", text) }

fn log_warn(text: str) { emit("WARN", text) }

fn log_error(text: str) { emit("ERROR", text) }
