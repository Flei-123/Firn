// SPDX-License-Identifier: MPL-2.0
// lib/mc/dedi/dd_signal.fi -- SIGTERM and SIGINT as a pollable file descriptor (signalfd), so the main loop can stop the server cleanly.

export { signal_open, signal_pending }

const SYS_READ: i64 = 0
const SYS_SIGPROCMASK: i64 = 14
const SYS_SIGNALFD4: i64 = 289
const SIG_BLOCK: i64 = 0
const MASK_TERM_INT: u64 = 16386
const SFD_NONBLOCK: i64 = 2048
const SFD_CLOEXEC: i64 = 524288
const SIGINFO_BYTES: usize = 128

fn signal_open() -> i64 {
    var mask: u64 = MASK_TERM_INT
    let ptr: i64 = (&mask) as u64 as i64
    if syscall(SYS_SIGPROCMASK, SIG_BLOCK, ptr, 0, 8, 0, 0) != 0 { return 0 - 1 }
    return syscall(SYS_SIGNALFD4, 0 - 1, ptr, 8, SFD_NONBLOCK + SFD_CLOEXEC, 0, 0)
}

fn signal_pending(fd: i64) -> bool {
    if fd < 0 { return false }
    var info: [u8; 128] = [0; 128]
    let got: i64 = syscall(SYS_READ, fd, (&info[0]) as u64 as i64, SIGINFO_BYTES as i64, 0, 0, 0)
    return got > 0
}
