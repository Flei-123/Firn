// SPDX-License-Identifier: MPL-2.0
// lib/mc/dedi/dd_props.fi -- server.properties: key=value lines kept verbatim, so unknown keys and comments survive a rewrite.

import std.rt
import std.io
import mc.dedi.dd_text as tx

export { Props, props_new, props_free, props_set_text, props_load, props_save, props_get, props_has, props_set, props_merge, props_int, props_bool, props_text }

struct Props {
    text: rt.Buf,
}

fn props_new() -> Props {
    return Props { text: rt.buf_new() }
}

fn props_free(p: *mut Props) {
    rt.buf_free(&(*p).text)
}

fn props_text(p: *mut Props) -> str {
    return rt.buf_str(&(*p).text)
}

fn props_set_text(p: *mut Props, text: str) {
    rt.buf_clear(&(*p).text)
    rt.buf_push_bytes(&(*p).text, text.p as u64, text.n)
}

fn props_load(p: *mut Props, path_c: u64) -> bool {
    var raw: rt.Buf = rt.buf_new()
    if !io.read_file(path_c, &raw) {
        rt.buf_free(&raw)
        return false
    }
    props_set_text(p, rt.buf_str(&raw))
    rt.buf_free(&raw)
    return true
}

fn props_save(p: *mut Props, path_c: u64) -> bool {
    return io.write_file(path_c, rt.buf_ptr(&(*p).text), rt.buf_len(&(*p).text))
}

fn line_end(t: str, from: usize) -> usize {
    var j: usize = from
    while j < t.n && rt.ld8(t.p as u64, j) != 10 as u8 { j = j + 1 }
    return j
}

fn find(p: *mut Props, key: str, vstart: *mut usize, vend: *mut usize) -> bool {
    let t: str = props_text(p)
    var i: usize = 0
    while i < t.n {
        let e: usize = line_end(t, i)
        let first: u8 = rt.ld8(t.p as u64, i)
        if e > i && first != 35 as u8 && first != 33 as u8 {
            var k: usize = i
            while k < e && rt.ld8(t.p as u64, k) != 61 as u8 { k = k + 1 }
            if k < e && tx.eq(tx.sub(t, i, k), key) {
                var ve: usize = e
                if ve > k + 1 && rt.ld8(t.p as u64, ve - 1) == 13 as u8 { ve = ve - 1 }
                *vstart = k + 1
                *vend = ve
                return true
            }
        }
        i = e + 1
    }
    return false
}

fn props_has(p: *mut Props, key: str) -> bool {
    var a: usize = 0
    var b: usize = 0
    return find(p, key, &a, &b)
}

fn props_get(p: *mut Props, key: str, fallback: str) -> str {
    var a: usize = 0
    var b: usize = 0
    if !find(p, key, &a, &b) { return fallback }
    return tx.sub(props_text(p), a, b)
}

fn props_int(p: *mut Props, key: str, fallback: i64) -> i64 {
    return tx.parse_int(props_get(p, key, ""), fallback)
}

fn props_bool(p: *mut Props, key: str, fallback: bool) -> bool {
    let v: str = props_get(p, key, "")
    if tx.eq_ci(v, "true") { return true }
    if tx.eq_ci(v, "false") { return false }
    return fallback
}

fn props_set(p: *mut Props, key: str, value: str) {
    var a: usize = 0
    var b: usize = 0
    var out: rt.Buf = rt.buf_new()
    let t: str = props_text(p)
    if find(p, key, &a, &b) {
        rt.buf_push_bytes(&out, t.p as u64, a)
        rt.buf_push_bytes(&out, value.p as u64, value.n)
        rt.buf_push_bytes(&out, (t.p as u64) + (b as u64), t.n - b)
    } else {
        rt.buf_push_bytes(&out, t.p as u64, t.n)
        if t.n > 0 && rt.ld8(t.p as u64, t.n - 1) != 10 as u8 { rt.buf_push(&out, 10 as u8) }
        rt.buf_push_bytes(&out, key.p as u64, key.n)
        rt.buf_push(&out, 61 as u8)
        rt.buf_push_bytes(&out, value.p as u64, value.n)
        rt.buf_push(&out, 10 as u8)
    }
    props_set_text(p, rt.buf_str(&out))
    rt.buf_free(&out)
}

fn props_merge(p: *mut Props, defaults: str) -> bool {
    var added: bool = false
    var i: usize = 0
    while i < defaults.n {
        let e: usize = line_end(defaults, i)
        var k: usize = i
        while k < e && rt.ld8(defaults.p as u64, k) != 61 as u8 { k = k + 1 }
        if k < e {
            let key: str = tx.sub(defaults, i, k)
            if !props_has(p, key) {
                props_set(p, key, tx.sub(defaults, k + 1, e))
                added = true
            }
        }
        i = e + 1
    }
    return added
}
