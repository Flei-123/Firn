// lib/mc/dedi/dd_cfg.fi -- turns server.properties into the server Config; keys without an effect yet are only parsed.

import std.rt
import std.net
import mc.server.sv_state
import mc.dedi.dd_text as tx
import mc.dedi.dd_props as pr
import mc.dedi.dd_state
import mc.dedi.dd_log

export { config_from_props, gamemode_of, sync_lists, ip_of, MAX_PLAYERS_CAP }

const MAX_PLAYERS_CAP: i32 = 32
const VIEW_MIN: i64 = 2
const VIEW_MAX: i64 = 32

fn gamemode_of(v: str) -> i32 {
    if tx.eq_ci(v, "survival") { return 0 }
    if tx.eq_ci(v, "creative") { return 1 }
    if tx.eq_ci(v, "adventure") { return 2 }
    if tx.eq_ci(v, "spectator") { return 3 }
    let n: i64 = tx.parse_int(v, 0 - 1)
    if n >= 0 && n <= 3 { return n as i32 }
    return 0 - 1
}

fn octet(s: str, out: *mut u8) -> bool {
    let n: i64 = tx.parse_int(s, 0 - 1)
    if n < 0 || n > 255 { return false }
    *out = n as u8
    return true
}

fn ip_of(v: str) -> u32 {
    let t: str = tx.trim(v)
    var o: [u8; 4] = [0; 4]
    var k: usize = 0
    var start: usize = 0
    var i: usize = 0
    var ok: bool = t.n > 0
    while ok && i <= t.n {
        if i == t.n || rt.ld8(t.p as u64, i) == 46 as u8 {
            if k >= 4 || !octet(tx.sub(t, start, i), &o[k]) { ok = false } else { k = k + 1 }
            start = i + 1
        }
        i = i + 1
    }
    if !ok || k != 4 { return net.ipv4(0 as u8, 0 as u8, 0 as u8, 0 as u8) }
    return net.ipv4(o[0], o[1], o[2], o[3])
}

fn sync_lists(srv: *mut sv_state.Server) {
    let d: *mut dd_state.Dedi = dd_state.dedi_get()
    (*srv).cfg.ops = rt.buf_str(&(*d).ops)
    (*srv).cfg.whitelist = rt.buf_str(&(*d).whitelist)
}

fn config_from_props(p: *mut pr.Props, cfg: *mut sv_state.Config, port: *mut u16, level_name: *mut str) {
    let d: *mut dd_state.Dedi = dd_state.dedi_get()
    *port = pr.props_int(p, "server-port", 25565) as u16
    (*cfg).bind_addr = ip_of(pr.props_get(p, "server-ip", ""))
    (*cfg).motd = tx.copy(pr.props_get(p, "motd", "A Firn Minecraft Server"))
    var maxp: i64 = pr.props_int(p, "max-players", 20)
    if maxp > MAX_PLAYERS_CAP as i64 {
        dd_log.log_warn("max-players is capped at 32 by this server build")
        maxp = MAX_PLAYERS_CAP as i64
    }
    if maxp < 1 { maxp = 1 }
    (*cfg).max_players = maxp as i32
    var gm: i32 = gamemode_of(pr.props_get(p, "gamemode", "survival"))
    if gm < 0 {
        dd_log.log_warn("Invalid gamemode, using survival")
        gm = 0
    }
    (*cfg).game_mode = gm
    var view: i64 = pr.props_int(p, "view-distance", 10)
    if view < VIEW_MIN { view = VIEW_MIN }
    if view > VIEW_MAX { view = VIEW_MAX }
    (*cfg).view = view as i32
    (*cfg).quiet_joins = true
    (*cfg).compression = pr.props_int(p, "network-compression-threshold", 256) as i32
    (*cfg).whitelist_on = pr.props_bool(p, "white-list", false)
    (*d).enforce_whitelist = pr.props_bool(p, "enforce-whitelist", false)
    (*d).op_level = pr.props_int(p, "op-permission-level", 4) as i32
    *level_name = tx.copy(pr.props_get(p, "level-name", "world"))
    if pr.props_bool(p, "online-mode", false) {
        dd_log.log_warn("online-mode=true is not supported yet: running in offline mode")
    }
}
