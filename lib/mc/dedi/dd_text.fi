// SPDX-License-Identifier: MPL-2.0
// lib/mc/dedi/dd_text.fi -- small string helpers of the dedicated server: compare, slice, trim, split word, parse int.

import std.rt

export { eq, eq_ci, sub, trim, parse_int, split_word, lower_byte, copy }

fn lower_byte(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 { return c + 32 as u8 }
    return c
}

fn eq(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    if a.n == 0 { return true }
    return rt.mem_eq(a.p as u64, b.p as u64, a.n)
}

fn eq_ci(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if lower_byte(rt.ld8(a.p as u64, i)) != lower_byte(rt.ld8(b.p as u64, i)) { return false }
        i = i + 1
    }
    return true
}

fn sub(s: str, from: usize, to: usize) -> str {
    let base: u64 = s.p as u64
    let off: u64 = from as u64
    return str { p: (base + off) as *mut u8, n: to - from }
}

fn is_space(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 13 as u8 || c == 10 as u8
}

fn trim(s: str) -> str {
    var a: usize = 0
    var b: usize = s.n
    while a < b && is_space(rt.ld8(s.p as u64, a)) { a = a + 1 }
    while b > a && is_space(rt.ld8(s.p as u64, b - 1)) { b = b - 1 }
    return sub(s, a, b)
}

fn parse_int(s: str, fallback: i64) -> i64 {
    let t: str = trim(s)
    if t.n == 0 { return fallback }
    var i: usize = 0
    var neg: bool = false
    if rt.ld8(t.p as u64, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    if i >= t.n { return fallback }
    var v: i64 = 0
    while i < t.n {
        let d: u8 = rt.ld8(t.p as u64, i)
        if d < 48 as u8 || d > 57 as u8 { return fallback }
        v = v * 10 + (d - 48 as u8) as i64
        i = i + 1
    }
    if neg { return 0 - v }
    return v
}

fn split_word(s: str, rest: *mut str) -> str {
    let t: str = trim(s)
    var i: usize = 0
    while i < t.n && !is_space(rt.ld8(t.p as u64, i)) { i = i + 1 }
    *rest = trim(sub(t, i, t.n))
    return sub(t, 0, i)
}

fn copy(s: str) -> str {
    return __str_copy(s)
}
