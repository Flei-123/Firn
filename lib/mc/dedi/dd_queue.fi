// SPDX-License-Identifier: MPL-2.0
// lib/mc/dedi/dd_queue.fi -- single producer single consumer line queue between the stdin thread and the server thread, plus the stop flag.

import std.rt

export { queue_new, queue_push, queue_pop, stop_request, stop_requested }

const SLOTS: usize = 64
const SLOT_BYTES: usize = 512
const W_HEAD: usize = 0
const W_TAIL: usize = 1
const W_STOP: usize = 2
const HEADER_BYTES: usize = 64

fn queue_new() -> u64 {
    let total: usize = HEADER_BYTES + SLOTS * SLOT_BYTES
    let q: u64 = rt.heap_alloc(total)
    rt.mem_set(q, 0 as u8, total)
    return q
}

fn word(q: u64, i: usize) -> *mut u64 {
    return (q + (i * 8) as u64) as *mut u64
}

fn slot_ptr(q: u64, index: u64) -> u64 {
    let k: usize = (index % SLOTS as u64) as usize
    return q + (HEADER_BYTES + k * SLOT_BYTES) as u64
}

fn queue_push(q: u64, p: u64, n: usize) -> bool {
    let head: u64 = __atomic_add(word(q, W_HEAD), 0 as u64)
    let tail: u64 = __atomic_add(word(q, W_TAIL), 0 as u64)
    if head - tail >= SLOTS as u64 { return false }
    var len: usize = n
    if len > SLOT_BYTES - 8 { len = SLOT_BYTES - 8 }
    let s: u64 = slot_ptr(q, head)
    rt.st64(s, 0, len as u64)
    rt.mem_copy(s + 8 as u64, p, len)
    __atomic_add(word(q, W_HEAD), 1 as u64)
    return true
}

fn queue_pop(q: u64, out: *mut rt.Buf) -> bool {
    let head: u64 = __atomic_add(word(q, W_HEAD), 0 as u64)
    let tail: u64 = __atomic_add(word(q, W_TAIL), 0 as u64)
    if head == tail { return false }
    let s: u64 = slot_ptr(q, tail)
    let len: usize = rt.ld64(s, 0) as usize
    rt.buf_clear(out)
    rt.buf_push_bytes(out, s + 8 as u64, len)
    __atomic_add(word(q, W_TAIL), 1 as u64)
    return true
}

fn stop_request(q: u64) {
    __atomic_add(word(q, W_STOP), 1 as u64)
}

fn stop_requested(q: u64) -> bool {
    return __atomic_add(word(q, W_STOP), 0 as u64) != 0 as u64
}
