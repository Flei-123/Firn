// SPDX-License-Identifier: MPL-2.0
// lib/mc/dedi/dd_console.fi -- stdin reader thread: assembles lines and hands them to the console queue.

import std.rt
import mc.dedi.dd_queue

export { CONSOLE_KIND, console_main }

const CONSOLE_KIND: u64 = 1668246627
const SYS_READ: i64 = 0
const STDIN: i64 = 0

fn console_main(queue: u64) -> u64 {
    var line: rt.Buf = rt.buf_new()
    var c: [u8; 1] = [0]
    while true {
        let got: i64 = syscall(SYS_READ, STDIN, (&c[0]) as u64 as i64, 1, 0, 0, 0)
        if got != 1 { break }
        if c[0] == 10 as u8 {
            var n: usize = rt.buf_len(&line)
            if n > 0 && rt.buf_at(&line, n - 1) == 13 as u8 { n = n - 1 }
            if n > 0 { dd_queue.queue_push(queue, rt.buf_ptr(&line), n) }
            rt.buf_clear(&line)
        } else {
            rt.buf_push(&line, c[0])
        }
    }
    rt.buf_free(&line)
    return 0 as u64
}
