// lib/mc/dedi/dd_state.fi -- state of the dedicated server wrapper: file root, operator and whitelist lists, console queue, join tracking.

import std.rt
import mc.server.sv_state

export { Dedi, dedi_new, dedi_get, dedi_path, SEEN_MAX }

const SEEN_MAX: usize = 32

struct Dedi {
    srv: *mut sv_state.Server,
    queue: u64,
    root: rt.Buf,
    ops: rt.Buf,
    whitelist: rt.Buf,
    op_level: i32,
    enforce_whitelist: bool,
    seen: [bool; 32],
    seen_name: [u8; 512],
    seen_len: [usize; 32],
}

static mut g_dedi: u64 = 0

fn dd_size_gen[T]() -> usize {
    return size_of[T]()
}

fn dedi_new(queue: u64) -> *mut Dedi {
    let p: u64 = rt.heap_alloc(dd_size_gen[Dedi]())
    rt.mem_set(p, 0 as u8, dd_size_gen[Dedi]())
    let d: *mut Dedi = p as *mut Dedi
    (*d).queue = queue
    (*d).op_level = 4
    g_dedi = p
    return d
}

fn dedi_get() -> *mut Dedi {
    return g_dedi as *mut Dedi
}

fn dedi_path(d: *mut Dedi, out: *mut rt.Buf, name: str) {
    rt.buf_clear(out)
    let root: str = rt.buf_str(&(*d).root)
    if root.n > 0 {
        rt.buf_push_bytes(out, root.p as u64, root.n)
        rt.buf_push(out, 47 as u8)
    }
    rt.buf_push_bytes(out, name.p as u64, name.n)
    rt.buf_push(out, 0 as u8)
}
