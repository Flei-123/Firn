// SPDX-License-Identifier: MPL-2.0
// lib/mc/dedi/dd_phase.fi -- server thread phase of the dedicated server: runs queued console lines and logs joins and leaves.

import std.rt
import mc.server.sv_state
import mc.server.sv_phase
import mc.dedi.dd_state
import mc.dedi.dd_queue
import mc.dedi.dd_cmds
import mc.dedi.dd_cfg
import mc.dedi.dd_log

export { dedi_setup }

const LINES_PER_TICK: i32 = 8

fn log_player(name: str, tail: str) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, name.p as u64, name.n)
    rt.buf_push_bytes(&b, tail.p as u64, tail.n)
    dd_log.log_info(rt.buf_str(&b))
    rt.buf_free(&b)
}

fn track_sessions(srv: *mut sv_state.Server) {
    let d: *mut dd_state.Dedi = dd_state.dedi_get()
    var i: usize = 0
    while i < sv_state.MAX_SESSIONS {
        let s: *mut sv_state.Session = sv_state.session_at(srv, i)
        let online: bool = (*s).used && (*s).joined && !(*s).closing
        if online && !(*d).seen[i] {
            (*d).seen[i] = true
            rt.mem_copy(((&(*d).seen_name[0]) as u64) + (i * 16) as u64, (&(*s).name[0]) as u64, (*s).name_n)
            (*d).seen_len[i] = (*s).name_n
            log_player(str { p: (&(*s).name[0]) as *mut u8, n: (*s).name_n }, " joined the game")
        } else if !online && (*d).seen[i] {
            (*d).seen[i] = false
            let base: u64 = ((&(*d).seen_name[0]) as u64) + (i * 16) as u64
            log_player(str { p: base as *mut u8, n: (*d).seen_len[i] }, " left the game")
        }
        i = i + 1
    }
}

fn phase_console(ctx: u64) {
    let srv: *mut sv_state.Server = ctx as *mut sv_state.Server
    let d: *mut dd_state.Dedi = dd_state.dedi_get()
    var line: rt.Buf = rt.buf_new()
    var n: i32 = 0
    while n < LINES_PER_TICK && dd_queue.queue_pop((*d).queue, &line) {
        dd_cmds.console_execute(srv, rt.buf_str(&line))
        n = n + 1
    }
    rt.buf_free(&line)
    track_sessions(srv)
}

fn dedi_setup(srv: *mut sv_state.Server) {
    let d: *mut dd_state.Dedi = dd_state.dedi_get()
    (*d).srv = srv
    dd_cfg.sync_lists(srv)
    sv_phase.phases_add(&(*srv).phases, "console", phase_console)
}
