import mc.mc_sky

export { skylight_time_of_day, skylight_darken256, skylight_vanilla_day }

const TWO_PI_DEG: f64 = 360.0

fn frac(x: f64) -> f64 {
    var f: f64 = x - (x as i64 as f64)
    if f < 0.0 { f = f + 1.0 }
    return f
}

fn skylight_time_of_day(ticks: i64) -> f64 {
    let d: f64 = frac((ticks as f64) / 24000.0 - 0.25)
    let e: f64 = 0.5 - mc_sky.sky_cos_deg(d * 180.0) / 2.0
    return (d * 2.0 + e) / 3.0
}

fn skylight_darken256(ticks: i64, rain256: i32, thunder256: i32) -> i32 {
    let tod: f64 = skylight_time_of_day(ticks)
    var g: f64 = 1.0 - (mc_sky.sky_cos_deg(tod * TWO_PI_DEG) * 2.0 + 0.2)
    if g < 0.0 { g = 0.0 }
    if g > 1.0 { g = 1.0 }
    g = 1.0 - g
    g = g * (1.0 - (rain256 as f64) / 256.0 * 5.0 / 16.0)
    g = g * (1.0 - (thunder256 as f64) / 256.0 * 5.0 / 16.0)
    return ((g * 0.8 + 0.2) * 256.0 + 0.5) as i32
}

fn skylight_vanilla_day(ticks: i64, rain256: i32, thunder256: i32) -> i32 {
    return 0 - 1 - skylight_darken256(ticks, rain256, thunder256)
}
