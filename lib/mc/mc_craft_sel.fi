// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_craft_sel.fi -- picks the generated recipe table (lib/mc/vNNN/mc_rcp_vNNN.fi) of a protocol.
//
//   recipes_for_protocol(protocol)   Recipes of that version; check mc_craft.craft_ok (false = no table generated for it)
//
// Tables exist for the versions whose inventory slots mc_inv decodes (same list as mc_dig_sel). Generator: tools/mcgen/gen_recipes.py <minecraft-data/data> <version> <protocol> <out.fi>.
import mc.mc_craft
import mc.v754.mc_rcp_v754
import mc.v758.mc_rcp_v758
import mc.v762.mc_rcp_v762
import mc.v763.mc_rcp_v763
import mc.v764.mc_rcp_v764
import mc.v767.mc_rcp_v767
import mc.v769.mc_rcp_v769
import mc.v770.mc_rcp_v770
import mc.v772.mc_rcp_v772
import mc.v774.mc_rcp_v774
import mc.v775.mc_rcp_v775

export { recipes_for_protocol }

fn recipes_for_protocol(protocol: i32) -> mc_craft.Recipes {
    if protocol == 754 { return mc_rcp_v754.recipes_make() }
    if protocol == 758 { return mc_rcp_v758.recipes_make() }
    if protocol == 762 { return mc_rcp_v762.recipes_make() }
    if protocol == 763 { return mc_rcp_v763.recipes_make() }
    if protocol == 764 { return mc_rcp_v764.recipes_make() }
    if protocol == 767 { return mc_rcp_v767.recipes_make() }
    if protocol == 769 { return mc_rcp_v769.recipes_make() }
    if protocol == 770 { return mc_rcp_v770.recipes_make() }
    if protocol == 772 { return mc_rcp_v772.recipes_make() }
    if protocol == 774 { return mc_rcp_v774.recipes_make() }
    if protocol == 775 { return mc_rcp_v775.recipes_make() }
    return mc_craft.craft_open(0 as u64)
}
