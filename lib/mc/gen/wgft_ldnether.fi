import std.json
import std.jsonstr
import mc.gen.wgft_def
import mc.gen.wgft_ldctx
import mc.gen.wgft_ldprov
import mc.gen.wgft_ldstate

export { load }

fn state_code(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32) -> i32 {
    return wgft_ldctx.reg_code(l, wgft_ldprov.state_name(d, node)) as i32
}

fn load_glowstone(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat) {
    (*f).kind = wgft_def.FK_GLOWSTONE
    (*f).p[0] = wgft_ldctx.reg_code(l, "glowstone") as i32
    (*f).p[1] = wgft_ldctx.reg_code(l, "netherrack") as i32
    (*f).p[2] = wgft_ldctx.reg_code(l, "basalt") as i32
    (*f).p[3] = wgft_ldctx.reg_code(l, "blackstone") as i32
}

fn load_blobs(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, cfg: u32) {
    (*f).kind = wgft_def.FK_BLOBS
    (*f).p[0] = state_code(l, d, jsonstr.get(d, cfg, "target"))
    (*f).p[1] = state_code(l, d, jsonstr.get(d, cfg, "state"))
    var lo: i32 = 0
    var hi: i32 = 0
    if !wgft_ldprov.int_range(l, d, jsonstr.get(d, cfg, "radius"), &lo, &hi) { (*l).ok = false }
    (*f).p[2] = lo
    (*f).p[3] = hi
}

fn load_netveg(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, cfg: u32) {
    (*f).kind = wgft_def.FK_NETHER_VEG
    (*f).p[0] = wgft_ldstate.load_provider(l, d, jsonstr.get(d, cfg, "state_provider"))
    (*f).p[1] = wgft_ldctx.num_or_fail(l, d, cfg, "spread_width")
    (*f).p[2] = wgft_ldctx.num_or_fail(l, d, cfg, "spread_height")
}

fn load(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, ty: str, cfg: u32) -> bool {
    if ty == "glowstone_blob" {
        load_glowstone(l, f)
        return true
    }
    if ty == "netherrack_replace_blobs" {
        load_blobs(l, f, d, cfg)
        return true
    }
    if ty == "nether_forest_vegetation" {
        load_netveg(l, f, d, cfg)
        return true
    }
    return false
}
