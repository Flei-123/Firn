import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch

export { try_place_leaf }

fn try_place_leaf(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    let cur: u16 = wgft_region.block_at(r, x, y, z)
    if !(*ft).tree_ok[cur as usize] { return false }
    var fam: usize = (*t).fam as usize
    if (*t).fam_w1 > 0 && mg_random.rng_next_int_bound(rng, (*t).fam_w0 + (*t).fam_w1) >= (*t).fam_w0 { fam = (*t).fam_alt as usize }
    if (*ft).wet[cur as usize] { fam = fam + wgft_def.MAX_FAMS }
    wgft_region.set_block(r, x, y, z, (*ft).fam_code[fam][7])
    wgft_tscratch.note_leaf(sc, x, y, z)
    return true
}
