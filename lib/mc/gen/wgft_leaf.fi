import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch

export { try_place_leaf }

fn try_place_leaf(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    if !(*ft).tree_ok[wgft_region.block_at(r, x, y, z) as usize] { return false }
    wgft_region.set_block(r, x, y, z, (*ft).fam_code[(*t).fam as usize][7])
    wgft_tscratch.note_leaf(sc, x, y, z)
    return true
}
