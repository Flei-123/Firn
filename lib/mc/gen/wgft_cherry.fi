// SPDX-License-Identifier: MPL-2.0
import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch
import mc.gen.wgft_trunk

export { place_cherry_trunk }

fn max_i32(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

fn abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

fn uniform(rng: *mut mg_random.Rng, lo: i32, hi: i32) -> i32 {
    return mg_random.rng_next_int_bound(rng, hi - lo + 1) + lo
}

fn pick_count(rng: *mut mg_random.Rng, c: *wgft_def.CherryCfg) -> i32 {
    var total: i32 = 0
    var i: usize = 0
    while i < (*c).n {
        total = total + (*c).weight[i]
        i = i + 1
    }
    var roll: i32 = mg_random.rng_next_int_bound(rng, total)
    i = 0
    while i < (*c).n {
        roll = roll - (*c).weight[i]
        if roll < 0 { return (*c).val[i] }
        i = i + 1
    }
    return (*c).val[0]
}

fn axis_code(t: *wgft_def.TreeCfg, d: i32) -> u8 {
    if d == 1 || d == 3 { return (*t).trunk_code_x }
    return (*t).trunk_code_z
}

#[allow_fp]
fn branch(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32, d: i32, start: i32, forced_long: bool) {
    let c: *wgft_def.CherryCfg = &(*t).cherry
    var cx: i32 = x
    var cy: i32 = y + start
    var cz: i32 = z
    let end_off: i32 = free - 1 + uniform(rng, (*c).end_lo, (*c).end_hi)
    let long: bool = forced_long || end_off < start
    var len: i32 = uniform(rng, (*c).len_lo, (*c).len_hi)
    if long { len = len + 1 }
    let tx: i32 = x + wgft_trunk.step_x(d) * len
    let ty: i32 = y + end_off
    let tz: i32 = z + wgft_trunk.step_z(d) * len
    var steps: i32 = 1
    if long { steps = 2 }
    var s: i32 = 0
    while s < steps {
        cx = cx + wgft_trunk.step_x(d)
        cz = cz + wgft_trunk.step_z(d)
        wgft_trunk.place_log(r, sc, axis_code(t, d), cx, cy, cz)
        s = s + 1
    }
    let up: bool = ty > cy
    while true {
        let dist: i32 = abs_i32(tx - cx) + abs_i32(ty - cy) + abs_i32(tz - cz)
        if dist == 0 {
            wgft_tscratch.add_attach(sc, tx, ty + 1, tz, 0)
            return
        }
        let p: f32 = (abs_i32(ty - cy) as f32) / (dist as f32)
        let vertical: bool = mg_random.rng_next_float(rng) < p
        if vertical {
            if up { cy = cy + 1 } else { cy = cy - 1 }
            wgft_trunk.place_log(r, sc, (*t).trunk_code, cx, cy, cz)
        } else {
            cx = cx + wgft_trunk.step_x(d)
            cz = cz + wgft_trunk.step_z(d)
            wgft_trunk.place_log(r, sc, axis_code(t, d), cx, cy, cz)
        }
    }
}

fn place_cherry_trunk(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    let c: *wgft_def.CherryCfg = &(*t).cherry
    wgft_trunk.set_dirt(r, sc, t, x, y - 1, z)
    let s1: i32 = max_i32(0, free - 1 + uniform(rng, (*c).start_lo, (*c).start_hi))
    var s2: i32 = max_i32(0, free - 1 + uniform(rng, (*c).start_lo, (*c).start_hi - 1))
    if s2 >= s1 { s2 = s2 + 1 }
    let count: i32 = pick_count(rng, c)
    let three: bool = count == 3
    let two: bool = count >= 2
    var top: i32 = s1 + 1
    if three {
        top = free
    } else if two {
        top = max_i32(s1, s2) + 1
    }
    var i: i32 = 0
    while i < top {
        wgft_trunk.place_log(r, sc, (*t).trunk_code, x, y + i, z)
        i = i + 1
    }
    if three { wgft_tscratch.add_attach(sc, x, y + top, z, 0) }
    let d: i32 = mg_random.rng_next_int_bound(rng, 4)
    branch(r, sc, rng, t, free, x, y, z, d, s1, s1 < top - 1)
    if two { branch(r, sc, rng, t, free, x, y, z, (d + 2) % 4, s2, s2 < top - 1) }
}
