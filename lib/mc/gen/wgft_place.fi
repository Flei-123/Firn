// SPDX-License-Identifier: MPL-2.0
import mc.gen.mg_random
import mc.gen.wgsr_bio
import mc.gen.wgsr_def
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_pred
import mc.gen.wgft_ctx
import mc.gen.wgft_body
import mc.gen.wgft_mod
import mc.gen.wgft_rootsys

export { run_feature }

fn biome_allows(c: *wgft_ctx.PlaceCtx, x: i32, y: i32, z: i32) -> bool {
    let b: i32 = wgft_ctx.biome_here((*c).r, x, y, z)
    return (((*(*(*c).r).ft).bmask[b as usize][((*c).fi / 64) as usize]) >> (((*c).fi % 64) as u64)) & (1 as u64) != (0 as u64)
}

fn run_patch(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let sub: *wgft_def.Feat = &(*(*(*c).r).ft).subs[(*f).p[3] as usize]
    let xz: i32 = (*f).p[1] + 1
    let yy: i32 = (*f).p[2] + 1
    var count: i32 = 0
    var t: i32 = 0
    while t < (*f).p[0] {
        let ax: i32 = mg_random.rng_next_int_bound((*c).rng, xz)
        let bx: i32 = mg_random.rng_next_int_bound((*c).rng, xz)
        let ay: i32 = mg_random.rng_next_int_bound((*c).rng, yy)
        let by: i32 = mg_random.rng_next_int_bound((*c).rng, yy)
        let az: i32 = mg_random.rng_next_int_bound((*c).rng, xz)
        let bz: i32 = mg_random.rng_next_int_bound((*c).rng, xz)
        if run_ops(c, sub, 0, x + ax - bx, y + ay - by, z + az - bz) { count = count + 1 }
        t = t + 1
    }
    return count > 0
}

fn run_select(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let n: i32 = (*f).p[0]
    if (*f).p[7] != 0 {
        let pick: i32 = mg_random.rng_next_int_bound((*c).rng, n)
        return run_ops(c, &(*(*(*c).r).ft).subs[(*f).p[2 + (pick as usize)] as usize], 0, x, y, z)
    }
    var k: i32 = 0
    while k < n {
        if mg_random.rng_next_float((*c).rng) < (*f).sel_chance[k as usize] {
            return run_ops(c, &(*(*(*c).r).ft).subs[(*f).p[2 + (k as usize)] as usize], 0, x, y, z)
        }
        k = k + 1
    }
    return run_ops(c, &(*(*(*c).r).ft).subs[(*f).p[1] as usize], 0, x, y, z)
}

fn run_root(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    if !(*(*r).ft).air[wgft_region.block_at(r, x, y, z) as usize] { return false }
    let sub: *wgft_def.Feat = &(*(*r).ft).subs[(*f).sub as usize]
    var i: i32 = 0
    while i < (*f).p[3] {
        let cy: i32 = y + i + 1
        let verdict: i32 = wgft_rootsys.candidate(r, f, x, cy, z)
        if verdict == wgft_rootsys.CAND_ABORT { return true }
        if verdict == wgft_rootsys.CAND_TRY && run_ops(c, sub, 0, x, cy, z) {
            wgft_rootsys.place_dirt(c, f, x, y, z, y + i)
            wgft_rootsys.place_roots(c, f, x, y, z)
            return true
        }
        i = i + 1
    }
    return true
}

fn run_bool_select(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    var pick: i32 = (*f).p[1]
    if mg_random.rng_next_bool((*c).rng) { pick = (*f).p[0] }
    return run_ops(c, &(*(*(*c).r).ft).subs[pick as usize], 0, x, y, z)
}

fn run_ops(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, i: usize, x: i32, y: i32, z: i32) -> bool {
    if i >= (*f).nops {
        if (*f).kind == wgft_def.FK_PATCH { return run_patch(c, f, x, y, z) }
        if (*f).kind == wgft_def.FK_SELECTOR { return run_select(c, f, x, y, z) }
        if (*f).kind == wgft_def.FK_ROOT { return run_root(c, f, x, y, z) }
        if (*f).kind == wgft_def.FK_BOOL_SELECT { return run_bool_select(c, f, x, y, z) }
        return wgft_body.run_body(c, f, x, y, z)
    }
    let op: wgft_def.Op = (*f).ops[i]
    var placed: bool = false
    if op.kind == wgft_def.OP_BIOME {
        if biome_allows(c, x, y, z) { placed = run_ops(c, f, i + 1, x, y, z) }
        return placed
    }
    var next: wgft_mod.Step = wgft_mod.apply(c, &op, x, y, z)
    var k: i32 = 0
    while k < next.count {
        if run_ops(c, f, i + 1, next.x, next.y, next.z) { placed = true }
        k = k + 1
    }
    return placed
}

fn run_feature(c: *wgft_ctx.PlaceCtx, x: i32, y: i32, z: i32) {
    run_ops(c, (*c).f, 0, x, y, z)
}
