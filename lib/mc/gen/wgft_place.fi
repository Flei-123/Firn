import mc.gen.mg_random
import mc.gen.wgsr_bio
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_ore

export { PlaceCtx, run_feature }

struct PlaceCtx {
    r: *mut wgft_region.Region,
    rng: *mut mg_random.Rng,
    f: *wgft_def.Feat,
    fi: i32,
}

fn biome_allows(c: *PlaceCtx, x: i32, y: i32, z: i32) -> bool {
    var q: [i32; 3] = [0, 0, 0]
    wgsr_bio.zoom_pick((*(*(*c).r).ft).zoom_seed, x, y, z, &q[0])
    let b: i32 = wgft_region.biome_at((*c).r, q[0], q[1], q[2])
    return ((*(*(*c).r).ft).bmask[b as usize] >> ((*c).fi as u64)) & (1 as u64) != (0 as u64)
}

fn height_trapezoid(rng: *mut mg_random.Rng, lo: i32, hi: i32) -> i32 {
    if lo > hi { return lo }
    let d: i32 = hi - lo
    if d == 0 { return lo + mg_random.rng_next_int_bound(rng, 1) }
    let a: i32 = d / 2
    let b: i32 = d - a
    let first: i32 = mg_random.rng_next_int_bound(rng, b + 1)
    let second: i32 = mg_random.rng_next_int_bound(rng, a + 1)
    return lo + first + second
}

fn height_uniform(rng: *mut mg_random.Rng, lo: i32, hi: i32) -> i32 {
    if lo > hi { return lo }
    return mg_random.rng_next_int_bound(rng, hi - lo + 1) + lo
}

fn run_ops(c: *PlaceCtx, i: usize, x: i32, y: i32, z: i32) {
    let f: *wgft_def.Feat = (*c).f
    if i >= (*f).nops {
        if (*f).scattered {
            wgft_ore.place_scattered((*c).r, (*c).rng, f, x, y, z)
        } else {
            wgft_ore.place_ore((*c).r, (*c).rng, f, x, y, z)
        }
        return
    }
    let op: wgft_def.Op = (*f).ops[i]
    if op.kind == wgft_def.OP_COUNT {
        var k: i32 = 0
        while k < op.a {
            run_ops(c, i + 1, x, y, z)
            k = k + 1
        }
    } else if op.kind == wgft_def.OP_COUNT_UNIFORM {
        let n: i32 = mg_random.rng_next_int_bound((*c).rng, op.b - op.a + 1) + op.a
        var k: i32 = 0
        while k < n {
            run_ops(c, i + 1, x, y, z)
            k = k + 1
        }
    } else if op.kind == wgft_def.OP_SQUARE {
        let nx: i32 = mg_random.rng_next_int_bound((*c).rng, 16) + x
        let nz: i32 = mg_random.rng_next_int_bound((*c).rng, 16) + z
        run_ops(c, i + 1, nx, y, nz)
    } else if op.kind == wgft_def.OP_RARITY {
        if mg_random.rng_next_float((*c).rng) < 1.0f / (op.a as f32) {
            run_ops(c, i + 1, x, y, z)
        }
    } else if op.kind == wgft_def.OP_HEIGHT_UNIFORM {
        run_ops(c, i + 1, x, height_uniform((*c).rng, op.a, op.b), z)
    } else if op.kind == wgft_def.OP_HEIGHT_TRAPEZOID {
        run_ops(c, i + 1, x, height_trapezoid((*c).rng, op.a, op.b), z)
    } else if op.kind == wgft_def.OP_BIOME {
        if biome_allows(c, x, y, z) { run_ops(c, i + 1, x, y, z) }
    }
}

fn run_feature(c: *PlaceCtx, x: i32, y: i32, z: i32) {
    run_ops(c, 0, x, y, z)
}
