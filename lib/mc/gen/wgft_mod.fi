import mc.gen.mg_random
import mc.gen.wgsr_def
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_pred
import mc.gen.wgft_ctx
import noise.psimplex

export { Step, apply }

struct Step {
    count: i32,
    x: i32,
    y: i32,
    z: i32,
}

fn pass(x: i32, y: i32, z: i32) -> Step {
    return Step { count: 1, x: x, y: y, z: z }
}

fn drop() -> Step {
    return Step { count: 0, x: 0, y: 0, z: 0 }
}

fn height_trapezoid(rng: *mut mg_random.Rng, lo: i32, hi: i32) -> i32 {
    if lo > hi { return lo }
    let d: i32 = hi - lo
    if d == 0 { return lo + mg_random.rng_next_int_bound(rng, 1) }
    let a: i32 = d / 2
    let b: i32 = d - a
    let first: i32 = mg_random.rng_next_int_bound(rng, b + 1)
    let second: i32 = mg_random.rng_next_int_bound(rng, a + 1)
    return lo + first + second
}

fn height_uniform(rng: *mut mg_random.Rng, lo: i32, hi: i32) -> i32 {
    if lo > hi { return lo }
    return mg_random.rng_next_int_bound(rng, hi - lo + 1) + lo
}

fn range_int(rng: *mut mg_random.Rng, lo: i32, hi: i32) -> i32 {
    if lo >= hi { return lo }
    return mg_random.rng_next_int_bound(rng, hi - lo + 1) + lo
}

fn height_biased(rng: *mut mg_random.Rng, lo: i32, hi: i32, inner: i32) -> i32 {
    if hi - lo - inner + 1 <= 0 { return lo }
    let a: i32 = range_int(rng, lo + inner, hi)
    let b: i32 = range_int(rng, lo, a - 1)
    return range_int(rng, lo, b - 1 + inner)
}

fn sample_int(rng: *mut mg_random.Rng, lo: i32, hi: i32, uniform: bool) -> i32 {
    if !uniform { return lo }
    return mg_random.rng_next_int_bound(rng, hi - lo + 1) + lo
}

#[allow_fp]
fn ceil_i32(v: f64) -> i32 {
    let t: i32 = v as i32
    if v > (t as f64) { return t + 1 }
    return t
}

#[allow_fp]
fn info_noise(r: *wgft_region.Region, x: f64, z: f64) -> f64 {
    let sd: *wgsr_def.SrDef = (*(*r).ft).sd as *wgsr_def.SrDef
    return psimplex.psimplex_value(&(*sd).i_noise, x, z, false)
}

#[allow_fp]
fn noise_threshold(r: *wgft_region.Region, op: *wgft_def.Op, x: i32, z: i32) -> Step {
    let v: f64 = info_noise(r, (x as f64) / 200.0, (z as f64) / 200.0)
    if v < (*op).f { return Step { count: (*op).a, x: x, y: 0, z: z } }
    return Step { count: (*op).b, x: x, y: 0, z: z }
}

#[allow_fp]
fn noise_based(r: *wgft_region.Region, op: *wgft_def.Op, x: i32, z: i32) -> i32 {
    let v: f64 = info_noise(r, (x as f64) / (*op).f, (z as f64) / (*op).f)
    return ceil_i32((v + (*op).g) * ((*op).a as f64))
}

fn env_scan(r: *mut wgft_region.Region, op: *wgft_def.Op, x: i32, y: i32, z: i32) -> Step {
    let ft: *wgft_def.FtDef = (*r).ft
    var cy: i32 = y
    if (*op).c >= 0 && !wgft_pred.test(r, (*op).c, x, cy, z) { return drop() }
    var i: i32 = 0
    while i < (*op).d {
        if wgft_pred.test(r, (*op).b, x, cy, z) { return pass(x, cy, z) }
        cy = cy + (*op).a
        if cy < (*ft).min_y || cy >= (*ft).min_y + (*ft).height { return drop() }
        if (*op).c >= 0 && !wgft_pred.test(r, (*op).c, x, cy, z) { break }
        i = i + 1
    }
    if wgft_pred.test(r, (*op).b, x, cy, z) { return pass(x, cy, z) }
    return drop()
}

fn apply(c: *wgft_ctx.PlaceCtx, op: *wgft_def.Op, x: i32, y: i32, z: i32) -> Step {
    let r: *mut wgft_region.Region = (*c).r
    let rng: *mut mg_random.Rng = (*c).rng
    let k: u8 = (*op).kind
    if k == wgft_def.OP_COUNT { return Step { count: (*op).a, x: x, y: y, z: z } }
    if k == wgft_def.OP_COUNT_UNIFORM {
        var n: i32 = mg_random.rng_next_int_bound(rng, (*op).b - (*op).a + 1) + (*op).a
        if (*op).e == 1 {
            if n < (*op).c { n = (*op).c }
            if n > (*op).d { n = (*op).d }
        }
        return Step { count: n, x: x, y: y, z: z }
    }
    if k == wgft_def.OP_COUNT_WEIGHTED {
        var total: i32 = 0
        var i: usize = 0
        while i < ((*op).a as usize) {
            total = total + (*op).w[i]
            i = i + 1
        }
        var roll: i32 = mg_random.rng_next_int_bound(rng, total)
        i = 0
        while i < ((*op).a as usize) {
            roll = roll - (*op).w[i]
            if roll < 0 { return Step { count: (*op).v[i], x: x, y: y, z: z } }
            i = i + 1
        }
        return drop()
    }
    if k == wgft_def.OP_SQUARE {
        let nx: i32 = mg_random.rng_next_int_bound(rng, 16) + x
        let nz: i32 = mg_random.rng_next_int_bound(rng, 16) + z
        return pass(nx, y, nz)
    }
    if k == wgft_def.OP_RARITY {
        if mg_random.rng_next_float(rng) < 1.0f / ((*op).a as f32) { return pass(x, y, z) }
        return drop()
    }
    if k == wgft_def.OP_HEIGHT_UNIFORM { return pass(x, height_uniform(rng, (*op).a, (*op).b), z) }
    if k == wgft_def.OP_HEIGHT_BIASED { return pass(x, height_biased(rng, (*op).a, (*op).b, (*op).c), z) }
    if k == wgft_def.OP_HEIGHT_TRAPEZOID { return pass(x, height_trapezoid(rng, (*op).a, (*op).b), z) }
    if k == wgft_def.OP_HEIGHTMAP {
        let h: i32 = wgft_region.height_of(r, (*op).a as usize, x, z)
        if h > (*r).min_y { return pass(x, h, z) }
        return drop()
    }
    if k == wgft_def.OP_RANDOM_OFFSET {
        let nx: i32 = x + sample_int(rng, (*op).a, (*op).b, ((*op).e & 1) != 0)
        let ny: i32 = y + sample_int(rng, (*op).c, (*op).d, ((*op).e & 2) != 0)
        let nz: i32 = z + sample_int(rng, (*op).a, (*op).b, ((*op).e & 1) != 0)
        return pass(nx, ny, nz)
    }
    if k == wgft_def.OP_NOISE_THRESHOLD {
        var s: Step = noise_threshold(r, op, x, z)
        s.y = y
        return s
    }
    if k == wgft_def.OP_NOISE_BASED { return Step { count: noise_based(r, op, x, z), x: x, y: y, z: z } }
    if k == wgft_def.OP_WATER_DEPTH {
        let floor: i32 = wgft_region.height_of(r, wgft_def.HM_FLOOR, x, z)
        let surf: i32 = wgft_region.height_of(r, wgft_def.HM_SURFACE, x, z)
        if surf - floor <= (*op).a { return pass(x, y, z) }
        return drop()
    }
    if k == wgft_def.OP_PRED_FILTER {
        if wgft_pred.test(r, (*op).a, x, y, z) { return pass(x, y, z) }
        return drop()
    }
    if k == wgft_def.OP_ENV_SCAN { return env_scan(r, op, x, y, z) }
    if k == wgft_def.OP_SURF_REL {
        let h: i64 = wgft_region.height_of(r, (*op).a as usize, x, z) as i64
        if h + ((*op).b as i64) <= (y as i64) && (y as i64) <= h + ((*op).c as i64) { return pass(x, y, z) }
        return drop()
    }
    return drop()
}
