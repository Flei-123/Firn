import mc.gen.wgdf_fluid
import mc.gen.wgbio_source
import mc.gen.wgsr_def
import mc.gen.wgsr_ctx
import mc.gen.wgsr_rules
import mc.gen.wgsr_ext

export { surface_chunk }

const AIR: u8 = 65
const INT_MIN: i32 = -2147483647 - 1
const INT_MAX: i32 = 2147483647
const WAY_BELOW_MIN_Y: i32 = -2032

fn is_fluid(code: u8) -> bool {
    return code == wgdf_fluid.STATE_WATER || code == wgdf_fluid.STATE_LAVA
}

fn stone_floor(c: *mut wgsr_ctx.SrCtx, y: i32) -> i32 {
    var k: i32 = y - 1
    while k >= (*c).min_y - 1 {
        let code: u8 = wgsr_ctx.ctx_get(c, k)
        if code == AIR || is_fluid(code) { return k + 1 }
        k = k - 1
    }
    return WAY_BELOW_MIN_Y
}

fn column(c: *mut wgsr_ctx.SrCtx, d: *wgsr_def.SrDef, lx: i32, lz: i32, has_bio: bool) {
    let x: i32 = (*c).cx * 16 + lx
    let z: i32 = (*c).cz * 16 + lz
    wgsr_ctx.ctx_column(c, x, z)
    let height: i32 = wgsr_ctx.ctx_hm(c, lx, lz)
    var biome: i32 = 0 - 1
    if has_bio {
        var by: i32 = height
        if (*d).legacy { by = 0 }
        biome = wgsr_ctx.ctx_biome_at(c, x, by, z)
        if biome == (*d).b_eroded { wgsr_ext.eroded_badlands(c, x, z, height) }
    }
    wgsr_ctx.ctx_xz_begin(c)
    var above: i32 = 0
    var water: i32 = INT_MIN
    var floor_y: i32 = INT_MAX
    var y: i32 = wgsr_ctx.ctx_hm(c, lx, lz)
    while y >= (*c).min_y {
        let code: u8 = wgsr_ctx.ctx_get(c, y)
        if code == AIR {
            above = 0
            water = INT_MIN
        } else if is_fluid(code) {
            if water == INT_MIN { water = y + 1 }
        } else {
            if floor_y >= y { floor_y = stone_floor(c, y) }
            above = above + 1
            wgsr_ctx.ctx_y_begin(c, above, y - floor_y + 1, water, y)
            if code == wgdf_fluid.STATE_SOLID {
                let r: i32 = wgsr_rules.rule_apply(c, (*d).root)
                if r >= 0 { wgsr_ctx.ctx_set(c, y, r as u8) }
            }
        }
        y = y - 1
    }
    if biome >= 0 && (biome == (*d).b_frozen || biome == (*d).b_deep_frozen) {
        wgsr_ext.frozen_ocean(c, biome, wgsr_ctx.ctx_min_surface(c), x, z, height)
    }
}

fn surface_chunk(c: *mut wgsr_ctx.SrCtx) {
    let d: *wgsr_def.SrDef = (*c).def
    let has_bio: bool = (*c).zoom.bs != (0 as *mut wgbio_source.BioSource)
    var lx: i32 = 0
    while lx < 16 {
        var lz: i32 = 0
        while lz < 16 {
            column(c, d, lx, lz, has_bio)
            lz = lz + 1
        }
        lx = lx + 1
    }
}
