import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region

export { place }

fn is_air(r: *wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    return (*(*r).ft).air[wgft_region.block_at(r, x, y, z) as usize]
}

fn hang_off(c: *wgft_ctx.PlaceCtx, basalt: u16, x: i32, y: i32, z: i32) -> bool {
    if mg_random.rng_next_int_bound((*c).rng, 10) != 0 {
        wgft_region.set_block((*c).r, x, y, z, basalt)
        return true
    }
    return false
}

fn base_hang_off(c: *wgft_ctx.PlaceCtx, basalt: u16, x: i32, y: i32, z: i32) {
    if mg_random.rng_next_bool((*c).rng) { wgft_region.set_block((*c).r, x, y, z, basalt) }
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let basalt: u16 = (*f).p[0] as u16
    if !is_air(r, x, y, z) || is_air(r, x, y + 1, z) { return false }
    var cy: i32 = y
    var n: bool = true
    var s: bool = true
    var w: bool = true
    var e: bool = true
    while is_air(r, x, cy, z) {
        if cy < (*r).min_y || cy >= (*r).min_y + (*r).height { return true }
        wgft_region.set_block(r, x, cy, z, basalt)
        n = n && hang_off(c, basalt, x, cy, z - 1)
        s = s && hang_off(c, basalt, x, cy, z + 1)
        w = w && hang_off(c, basalt, x - 1, cy, z)
        e = e && hang_off(c, basalt, x + 1, cy, z)
        cy = cy - 1
    }
    cy = cy + 1
    base_hang_off(c, basalt, x, cy, z - 1)
    base_hang_off(c, basalt, x, cy, z + 1)
    base_hang_off(c, basalt, x - 1, cy, z)
    base_hang_off(c, basalt, x + 1, cy, z)
    cy = cy - 1
    var dx: i32 = 0 - 3
    while dx < 4 {
        var dz: i32 = 0 - 3
        while dz < 4 {
            var ax: i32 = dx
            if ax < 0 { ax = 0 - ax }
            var az: i32 = dz
            if az < 0 { az = 0 - az }
            if mg_random.rng_next_int_bound((*c).rng, 10) < 10 - ax * az {
                var py: i32 = cy
                var left: i32 = 3
                while is_air(r, x + dx, py - 1, z + dz) {
                    py = py - 1
                    left = left - 1
                    if left <= 0 { break }
                }
                if !is_air(r, x + dx, py - 1, z + dz) { wgft_region.set_block(r, x + dx, py, z + dz, basalt) }
            }
            dz = dz + 1
        }
        dx = dx + 1
    }
    return true
}
