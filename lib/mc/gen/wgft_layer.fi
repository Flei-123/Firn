import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region

export { collect, MAX_LAYER_POSITIONS }

const MAX_LAYER_POSITIONS: usize = 1024
const NO_GROUND: i32 = 2147483647

fn is_empty(ft: *wgft_def.FtDef, code: u16) -> bool {
    return (*ft).air[code as usize] || (*ft).fluid[code as usize]
}

fn ground_y(r: *mut wgft_region.Region, x: i32, start: i32, z: i32, layer: i32) -> i32 {
    let ft: *wgft_def.FtDef = (*r).ft
    var found: i32 = 0
    var state: u16 = wgft_region.block_at(r, x, start, z)
    var y: i32 = start
    while y >= (*r).min_y + 1 {
        let below: u16 = wgft_region.block_at(r, x, y - 1, z)
        if !is_empty(ft, below) && is_empty(ft, state) && below != (*ft).bedrock_code {
            if found == layer { return y }
            found = found + 1
        }
        state = below
        y = y - 1
    }
    return NO_GROUND
}

fn collect(c: *wgft_ctx.PlaceCtx, n: i32, x: i32, z: i32, ox: *mut [i32; 1024], oy: *mut [i32; 1024], oz: *mut [i32; 1024]) -> usize {
    let r: *mut wgft_region.Region = (*c).r
    var total: usize = 0
    var layer: i32 = 0
    var found: bool = true
    while found {
        found = false
        var i: i32 = 0
        while i < n {
            let px: i32 = mg_random.rng_next_int_bound((*c).rng, 16) + x
            let pz: i32 = mg_random.rng_next_int_bound((*c).rng, 16) + z
            let top: i32 = wgft_region.height_of(r, wgft_def.HM_MOTION, px, pz)
            let py: i32 = ground_y(r, px, top, pz, layer)
            if py != NO_GROUND && total < MAX_LAYER_POSITIONS {
                (*ox)[total] = px
                (*oy)[total] = py
                (*oz)[total] = pz
                total = total + 1
                found = true
            }
            i = i + 1
        }
        layer = layer + 1
    }
    return total
}
