// SPDX-License-Identifier: MPL-2.0
// lib/mc/gen/wgdf_ops.fi -- density function node kinds and the type-name registry (name -> kind, version independent).

export {
    OP_CONST, OP_ADD, OP_MUL, OP_MIN, OP_MAX, OP_ABS, OP_SQUARE, OP_CUBE, OP_HALF_NEG, OP_QUARTER_NEG, OP_SQUEEZE,
    OP_CLAMP, OP_YGRAD, OP_NOISE, OP_SHIFTED_NOISE, OP_SHIFT_A, OP_SHIFT_B, OP_SHIFT, OP_RANGE_CHOICE, OP_WEIRD,
    OP_MARKER, OP_BLEND_DENSITY, OP_BLEND_ALPHA, OP_BLEND_OFFSET, OP_OLD_BLENDED, OP_END_ISLANDS, OP_SPLINE,
    OP_BEARDIFIER, OP_UNKNOWN, op_by_name,
}

const OP_UNKNOWN: i32 = -1
const OP_CONST: i32 = 0
const OP_ADD: i32 = 1
const OP_MUL: i32 = 2
const OP_MIN: i32 = 3
const OP_MAX: i32 = 4
const OP_ABS: i32 = 5
const OP_SQUARE: i32 = 6
const OP_CUBE: i32 = 7
const OP_HALF_NEG: i32 = 8
const OP_QUARTER_NEG: i32 = 9
const OP_SQUEEZE: i32 = 10
const OP_CLAMP: i32 = 11
const OP_YGRAD: i32 = 12
const OP_NOISE: i32 = 13
const OP_SHIFTED_NOISE: i32 = 14
const OP_SHIFT_A: i32 = 15
const OP_SHIFT_B: i32 = 16
const OP_SHIFT: i32 = 17
const OP_RANGE_CHOICE: i32 = 18
const OP_WEIRD: i32 = 19
const OP_MARKER: i32 = 20
const OP_BLEND_DENSITY: i32 = 21
const OP_BLEND_ALPHA: i32 = 22
const OP_BLEND_OFFSET: i32 = 23
const OP_OLD_BLENDED: i32 = 24
const OP_END_ISLANDS: i32 = 25
const OP_SPLINE: i32 = 26
const OP_BEARDIFIER: i32 = 27

fn op_by_name(n: str) -> i32 {
    if n == "constant" { return OP_CONST }
    if n == "add" { return OP_ADD }
    if n == "mul" { return OP_MUL }
    if n == "min" { return OP_MIN }
    if n == "max" { return OP_MAX }
    if n == "abs" { return OP_ABS }
    if n == "square" { return OP_SQUARE }
    if n == "cube" { return OP_CUBE }
    if n == "half_negative" { return OP_HALF_NEG }
    if n == "quarter_negative" { return OP_QUARTER_NEG }
    if n == "squeeze" { return OP_SQUEEZE }
    if n == "clamp" { return OP_CLAMP }
    if n == "y_clamped_gradient" { return OP_YGRAD }
    if n == "noise" { return OP_NOISE }
    if n == "shifted_noise" { return OP_SHIFTED_NOISE }
    if n == "shift_a" { return OP_SHIFT_A }
    if n == "shift_b" { return OP_SHIFT_B }
    if n == "shift" { return OP_SHIFT }
    if n == "range_choice" { return OP_RANGE_CHOICE }
    if n == "weird_scaled_sampler" { return OP_WEIRD }
    if n == "interpolated" || n == "flat_cache" || n == "cache_2d" || n == "cache_once" || n == "cache_all_in_cell" { return OP_MARKER }
    if n == "blend_density" { return OP_BLEND_DENSITY }
    if n == "blend_alpha" { return OP_BLEND_ALPHA }
    if n == "blend_offset" { return OP_BLEND_OFFSET }
    if n == "old_blended_noise" { return OP_OLD_BLENDED }
    if n == "end_islands" { return OP_END_ISLANDS }
    if n == "spline" { return OP_SPLINE }
    if n == "beardifier" { return OP_BEARDIFIER }
    return OP_UNKNOWN
}
