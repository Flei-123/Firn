// lib/mc/gen/wgdf_veins.fi -- OreVeinifier of the noise fill (copper and iron veins), bit identical to Java.
import std.math
import noise.interp
import mc.gen.mg_random
import mc.gen.wgdf_graph
import mc.gen.wgdf_eval
import mc.gen.wgdf_fluid

export { vein_state, vein_factory }

fn vein_factory(g: *wgdf_graph.WgGraph, ns: *wgdf_eval.WgNoises) -> mg_random.PosFactory {
    var r0: mg_random.Rng = mg_random.rng_xoro((*ns).seed)
    if (*g).legacy_random {
        r0 = mg_random.rng_legacy((*ns).seed)
    }
    let root: mg_random.PosFactory = mg_random.rng_fork_positional(&r0)
    let name: str = "minecraft:ore"
    var r: mg_random.Rng = mg_random.pos_from_hash_of(&root, name.p as u64, name.n)
    return mg_random.rng_fork_positional(&r)
}

#[allow_fp]
fn vein_state(g: *wgdf_graph.WgGraph, ns: *wgdf_eval.WgNoises, pf: *mg_random.PosFactory, toggle: i32, ridged: i32, gap: i32, x: i32, y: i32, z: i32) -> u8 {
    let t: f64 = wgdf_eval.eval(g, ns, toggle, x, y, z)
    var copper: bool = false
    var max_y: i32 = -8
    var min_y: i32 = -60
    if t > 0.0 {
        copper = true
        max_y = 50
        min_y = 0
    }
    let abs_t: f64 = math.fabs(t)
    let to_top: i32 = max_y - y
    let to_bottom: i32 = y - min_y
    if to_bottom < 0 || to_top < 0 {
        return 0
    }
    var edge_dist: i32 = to_top
    if to_bottom < edge_dist {
        edge_dist = to_bottom
    }
    let edge: f64 = interp.clamped_map(edge_dist as f64, 0.0, 20.0, -0.2, 0.0)
    let threshold: f32 = 0.4f
    if abs_t + edge < (threshold as f64) {
        return 0
    }
    var r: mg_random.Rng = mg_random.pos_at(pf, x, y, z)
    let solidness: f32 = 0.7f
    if mg_random.rng_next_float(&r) > solidness {
        return 0
    }
    if wgdf_eval.eval(g, ns, ridged, x, y, z) >= 0.0 {
        return 0
    }
    let hi: f32 = 0.6f
    let rich_lo: f32 = 0.1f
    let rich_hi: f32 = 0.3f
    let richness: f64 = interp.clamped_map(abs_t, threshold as f64, hi as f64, rich_lo as f64, rich_hi as f64)
    let skip: f32 = -0.3f
    var ore: u8 = wgdf_fluid.STATE_IRON_ORE
    var raw: u8 = wgdf_fluid.STATE_RAW_IRON
    var filler: u8 = wgdf_fluid.STATE_TUFF
    if copper {
        ore = wgdf_fluid.STATE_COPPER_ORE
        raw = wgdf_fluid.STATE_RAW_COPPER
        filler = wgdf_fluid.STATE_GRANITE
    }
    let roll: f64 = mg_random.rng_next_float(&r) as f64
    if roll < richness && wgdf_eval.eval(g, ns, gap, x, y, z) > (skip as f64) {
        let raw_chance: f32 = 0.02f
        if mg_random.rng_next_float(&r) < raw_chance {
            return raw
        }
        return ore
    }
    return filler
}
