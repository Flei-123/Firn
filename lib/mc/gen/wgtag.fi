import std.rt
import std.json
import std.jsonstr
import mc.gen.wgdf_graph
import mc.gen.wgdf_load
import mc.gen.wgsr_def

export { NameSet, set_new, set_free, set_has, set_add, tag_collect, code_name, tag_mask, name_mask }

const MAX_NAMES: usize = 256
const NAME_LEN: usize = 40

struct NameSet {
    n: usize,
    names: [[u8; 40]; 256],
    lens: [usize; 256],
}

fn set_new() -> *mut NameSet {
    let s: *mut NameSet = rt.heap_alloc(wgdf_graph.wg_size_of[NameSet]()) as *mut NameSet
    rt.mem_set(s as u64, 0 as u8, wgdf_graph.wg_size_of[NameSet]())
    return s
}

fn set_free(s: *mut NameSet) {
    rt.heap_free(s as u64, wgdf_graph.wg_size_of[NameSet]())
}

fn set_has(s: *NameSet, name: str) -> bool {
    var i: usize = 0
    while i < (*s).n {
        if (*s).lens[i] == name.n && rt.mem_eq((&(*s).names[i][0]) as u64, name.p as u64, name.n) { return true }
        i = i + 1
    }
    return false
}

fn set_add(s: *mut NameSet, name: str) {
    if set_has(s, name) || (*s).n >= MAX_NAMES || name.n > NAME_LEN { return }
    rt.mem_copy((&(*s).names[(*s).n][0]) as u64, name.p as u64, name.n)
    (*s).lens[(*s).n] = name.n
    (*s).n = (*s).n + 1
}

fn tag_collect(root: str, tag: str, out: *mut NameSet, depth: i32) {
    if depth > 6 { return }
    var raw: rt.Buf = rt.buf_new()
    var doc: json.Json = json.json_new()
    if wgdf_load.read_doc(root, "tags/blocks", tag, &raw, &doc) {
        let vals: u32 = jsonstr.get(&doc, json.json_root(&doc), "values")
        let cnt: usize = json.json_count(&doc, vals)
        var k: usize = 0
        while k < cnt {
            let v: str = jsonstr.string(&doc, json.json_child_at(&doc, vals, k))
            if v.n > 0 && *(v.p) == 35 {
                tag_collect(root, wgdf_load.strip_ns(str { p: ((v.p as u64) + 1) as *mut u8, n: v.n - 1 }), out, depth + 1)
            } else {
                set_add(out, wgdf_load.strip_ns(v))
            }
            k = k + 1
        }
    }
    json.json_free(&doc)
    rt.buf_free(&raw)
}

fn code_name(sd: *wgsr_def.SrDef, code: i32) -> str {
    if code == 83 { return str { p: &(*sd).default_name[0], n: (*sd).default_len } }
    if code == 65 { return "air" }
    if code == 87 { return "water" }
    if code == 76 { return "lava" }
    if code == 67 { return "copper_ore" }
    if code == 99 { return "raw_copper_block" }
    if code == 71 { return "granite" }
    if code == 73 { return "deepslate_iron_ore" }
    if code == 105 { return "raw_iron_block" }
    if code == 84 { return "tuff" }
    if code >= wgsr_def.FIRST_CODE && (code - wgsr_def.FIRST_CODE) < (wgsr_def.block_count(sd) as i32) {
        return wgsr_def.block_name(sd, (code - wgsr_def.FIRST_CODE) as usize)
    }
    return ""
}

fn tag_mask(root: str, sd: *wgsr_def.SrDef, tag: str, out: u64) {
    let set: *mut NameSet = set_new()
    tag_collect(root, tag, set, 0)
    var code: i32 = 0
    while code < 256 {
        let nm: str = code_name(sd, code)
        *((out + (code as u64)) as *mut bool) = nm.n > 0 && set_has(set, nm)
        code = code + 1
    }
    set_free(set)
}

fn name_mask(sd: *wgsr_def.SrDef, name: str, out: u64) {
    var code: i32 = 0
    while code < 256 {
        let nm: str = code_name(sd, code)
        *((out + (code as u64)) as *mut bool) = nm.n > 0 && nm == name
        code = code + 1
    }
}
