import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch
import mc.gen.wgft_hive
import mc.gen.wgft_alter

export { decorate_all }

fn decorate_all(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg) {
    var i: usize = 0
    while i < (*t).ndecos {
        let dc: *wgft_def.DecoCfg = &(*t).decos[i]
        if (*dc).kind == wgft_def.DK_BEEHIVE {
            wgft_hive.decorate(r, sc, rng, dc)
        } else if (*dc).kind == wgft_def.DK_ALTER_GROUND {
            wgft_alter.decorate(r, sc, rng, dc)
        }
        i = i + 1
    }
}
