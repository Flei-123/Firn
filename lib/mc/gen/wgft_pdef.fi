export { StateProv, MAX_NOISES, SP_SIMPLE, SP_WEIGHTED, SP_THRESHOLD, SP_NOISE, SP_DUAL, MAX_PROVS, MAX_PROV_STATES }

const MAX_PROVS: usize = 64
const MAX_NOISES: usize = 12
const MAX_PROV_STATES: usize = 16

const SP_SIMPLE: u8 = 0
const SP_WEIGHTED: u8 = 1
const SP_THRESHOLD: u8 = 2
const SP_NOISE: u8 = 3
const SP_DUAL: u8 = 4

struct StateProv {
    kind: u8,
    n: usize,
    codes: [u16; 16],
    weights: [i32; 16],
    total: i32,
    dflt: u16,
    high_chance: f32,
    threshold: f32,
    nlow: usize,
    low: [u16; 8],
    nhigh: usize,
    high: [u16; 8],
    scale: f32,
    slow_scale: f32,
    variety_lo: i32,
    variety_hi: i32,
    noise: i32,
    slow: i32,
}
