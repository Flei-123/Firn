import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_cdef
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_pred
import mc.gen.wgft_prov

export { place }

fn sample_height(rng: *mut mg_random.Rng, h: *wgft_cdef.HeightCfg) -> i32 {
    var e: usize = 0
    if (*h).weighted {
        var pick: i32 = mg_random.rng_next_int_bound(rng, (*h).total)
        while e + 1 < (*h).n && pick >= (*h).w[e] {
            pick = pick - (*h).w[e]
            e = e + 1
        }
    }
    if (*h).uni[e] { return mg_random.rng_next_int_bound(rng, (*h).hi[e] - (*h).lo[e] + 1) + (*h).lo[e] }
    return (*h).lo[e]
}

fn cut_counts(counts: *mut [i32; 3], n: usize, total: i32, at: i32, tip: bool) {
    var rest: i32 = total - at
    var step: i32 = 0 - 1
    var i: i32 = (n as i32) - 1
    if tip {
        step = 1
        i = 0
    }
    while i >= 0 && i < (n as i32) && rest > 0 {
        let c: i32 = (*counts)[i as usize]
        var take: i32 = rest
        if c < take { take = c }
        rest = rest - take
        (*counts)[i as usize] = c - take
        i = i + step
    }
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    let col: *wgft_cdef.ColCfg = &(*ft).cols[(*f).p[0] as usize]
    var counts: [i32; 3] = [0, 0, 0]
    var total: i32 = 0
    var k: usize = 0
    while k < (*col).nlayers {
        counts[k] = sample_height((*c).rng, &(*col).heights[k])
        total = total + counts[k]
        k = k + 1
    }
    if total == 0 { return false }
    var i: i32 = 0
    while i < total {
        if !wgft_pred.test(r, (*col).allowed, x, y + (*col).dir * (i + 1), z) {
            cut_counts(&counts, (*col).nlayers, total, i, (*col).tip)
            break
        }
        i = i + 1
    }
    var py: i32 = y
    k = 0
    while k < (*col).nlayers {
        var j: i32 = 0
        while j < counts[k] {
            let code: u16 = wgft_prov.pick(ft, &(*ft).provs[(*col).prov[k] as usize], (*c).rng, x, py, z)
            wgft_region.set_block(r, x, py, z, code)
            py = py + (*col).dir
            j = j + 1
        }
        k = k + 1
    }
    return true
}
