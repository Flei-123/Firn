import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_manhattan

export { place }

fn is_clear(r: *wgft_region.Region, contents: u16, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    let here: u16 = wgft_region.block_at(r, x, y, z)
    if here == contents || (*ft).no_delta[here as usize] { return false }
    if (*ft).air[wgft_region.block_at(r, x, y - 1, z) as usize] { return false }
    if !(*ft).air[wgft_region.block_at(r, x, y + 1, z) as usize] { return false }
    if (*ft).air[wgft_region.block_at(r, x, y, z - 1) as usize] { return false }
    if (*ft).air[wgft_region.block_at(r, x, y, z + 1) as usize] { return false }
    if (*ft).air[wgft_region.block_at(r, x - 1, y, z) as usize] { return false }
    if (*ft).air[wgft_region.block_at(r, x + 1, y, z) as usize] { return false }
    return true
}

fn sample(rng: *mut mg_random.Rng, lo: i32, hi: i32) -> i32 {
    return mg_random.rng_next_int_bound(rng, hi - lo + 1) + lo
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let contents: u16 = (*f).p[0] as u16
    let rim: u16 = (*f).p[1] as u16
    var placed: bool = false
    let with_rim: bool = mg_random.rng_next_double((*c).rng) < 0.9
    var rx: i32 = 0
    var rz: i32 = 0
    if with_rim { rx = sample((*c).rng, (*f).p[2], (*f).p[3]) }
    if with_rim { rz = sample((*c).rng, (*f).p[2], (*f).p[3]) }
    let rim_on: bool = with_rim && rx != 0 && rz != 0
    let s1: i32 = sample((*c).rng, (*f).p[4], (*f).p[5])
    let s2: i32 = sample((*c).rng, (*f).p[4], (*f).p[5])
    var limit: i32 = s1
    if s2 > limit { limit = s2 }
    var it: wgft_manhattan.Walk = wgft_manhattan.walk_new(s1, 0, s2)
    while wgft_manhattan.walk_next(&it) {
        if it.depth > limit { break }
        let px: i32 = x + it.dx
        let py: i32 = y + it.dy
        let pz: i32 = z + it.dz
        if is_clear(r, contents, px, py, pz) {
            if rim_on {
                placed = true
                wgft_region.set_block(r, px, py, pz, rim)
            }
            if is_clear(r, contents, px + rx, py, pz + rz) {
                placed = true
                wgft_region.set_block(r, px + rx, py, pz + rz, contents)
            }
        }
    }
    return placed
}
