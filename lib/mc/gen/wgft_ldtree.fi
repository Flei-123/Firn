import std.rt
import std.json
import std.jsonstr
import mc.gen.wgsr_def
import mc.gen.wgft_def
import mc.gen.wgft_ldctx
import mc.gen.wgft_ldcherry

export { load_tree, provider_state, state_name }

fn int_range(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32, lo: *mut i32, hi: *mut i32) -> bool {
    if json.json_kind(d, node) == json.JSON_NUMBER {
        *lo = json.json_number(d, node) as i32
        *hi = *lo
        return false
    }
    let ty: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, node, "type")))
    let v: u32 = jsonstr.get(d, node, "value")
    if ty == "constant" {
        *lo = json.json_number(d, v) as i32
        *hi = *lo
        return false
    }
    if ty == "uniform" {
        *lo = wgft_ldctx.num_or_fail(l, d, v, "min_inclusive")
        *hi = wgft_ldctx.num_or_fail(l, d, v, "max_inclusive")
        return true
    }
    (*l).ok = false
    return false
}

fn provider_state(l: *mut wgft_ldctx.Ld, d: *mut json.Json, prov: u32) -> u32 {
    if wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, prov, "type"))) != "simple_state_provider" { (*l).ok = false }
    return jsonstr.get(d, prov, "state")
}

fn state_name(d: *mut json.Json, state: u32) -> str {
    return wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, state, "Name")))
}

fn reg_joined(l: *mut wgft_ldctx.Ld, a: str, b: str) -> u8 {
    var buf: [u8; 64] = [0 as u8; 64]
    if a.n + b.n > 64 {
        (*l).ok = false
        return 0
    }
    var k: usize = 0
    while k < a.n {
        buf[k] = rt.ld8(a.p as u64, k)
        k = k + 1
    }
    var j: usize = 0
    while j < b.n {
        buf[a.n + j] = rt.ld8(b.p as u64, j)
        j = j + 1
    }
    let c: i32 = wgsr_def.block_code((*l).sdef, (&buf[0]) as u64, a.n + b.n)
    if c < 0 || c > 255 {
        (*l).ok = false
        return 0
    }
    return c as u8
}

#[allow_escape]
fn leaf_code(l: *mut wgft_ldctx.Ld, base: str, dist: i32) -> u8 {
    var tail: [u8; 12] = [91 as u8, 100 as u8, 105 as u8, 115 as u8, 116 as u8, 97 as u8, 110 as u8, 99 as u8, 101 as u8, 61 as u8, 48 as u8, 93 as u8]
    tail[10] = (48 + dist) as u8
    return reg_joined(l, base, str { p: &tail[0], n: 12 })
}

fn family_of(l: *mut wgft_ldctx.Ld, base: str) -> i32 {
    let def: *mut wgft_def.FtDef = (*l).def
    let first: u8 = leaf_code(l, base, 1)
    var f: usize = 0
    while f < (*def).nfams {
        if (*def).fam_code[f][1] == first { return f as i32 }
        f = f + 1
    }
    if (*def).nfams >= wgft_def.MAX_FAMS {
        (*l).ok = false
        return 0
    }
    let fi: usize = (*def).nfams
    (*def).nfams = (*def).nfams + 1
    var d: i32 = 1
    while d <= 7 {
        let c: u8 = leaf_code(l, base, d)
        (*def).fam_code[fi][d as usize] = c
        (*def).leaf_dist[c as usize] = d as u8
        (*def).leaf_fam[c as usize] = fi as u8
        d = d + 1
    }
    return fi as i32
}

fn load_trunk(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, node: u32) {
    let ty: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, node, "type")))
    if ty == "straight_trunk_placer" {
        (*t).trunk = wgft_def.TK_STRAIGHT
    } else if ty == "fancy_trunk_placer" {
        (*t).trunk = wgft_def.TK_FANCY
    } else if ty == "forking_trunk_placer" {
        (*t).trunk = wgft_def.TK_FORKING
    } else if ty == "giant_trunk_placer" {
        (*t).trunk = wgft_def.TK_GIANT
    } else if ty == "mega_jungle_trunk_placer" {
        (*t).trunk = wgft_def.TK_MEGA_JUNGLE
    } else if ty == "dark_oak_trunk_placer" {
        (*t).trunk = wgft_def.TK_DARK_OAK
    } else if ty == "cherry_trunk_placer" {
        (*t).trunk = wgft_def.TK_CHERRY
        wgft_ldcherry.load_trunk(l, t, d, node)
    } else {
        (*l).ok = false
    }
    (*t).base = wgft_ldctx.num_or_fail(l, d, node, "base_height")
    (*t).rand_a = wgft_ldctx.num_or_fail(l, d, node, "height_rand_a")
    (*t).rand_b = wgft_ldctx.num_or_fail(l, d, node, "height_rand_b")
}

fn load_foliage(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, node: u32) {
    let ty: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, node, "type")))
    (*t).rad_uni = int_range(l, d, jsonstr.get(d, node, "radius"), &(*t).rad_lo, &(*t).rad_hi)
    (*t).off_uni = int_range(l, d, jsonstr.get(d, node, "offset"), &(*t).off_lo, &(*t).off_hi)
    if ty == "blob_foliage_placer" {
        (*t).fol = wgft_def.FL_BLOB
        (*t).h_lo = wgft_ldctx.num_or_fail(l, d, node, "height")
        (*t).h_hi = (*t).h_lo
        (*t).h_uni = false
    } else if ty == "spruce_foliage_placer" {
        (*t).fol = wgft_def.FL_SPRUCE
        (*t).h_uni = int_range(l, d, jsonstr.get(d, node, "trunk_height"), &(*t).h_lo, &(*t).h_hi)
    } else if ty == "fancy_foliage_placer" {
        (*t).fol = wgft_def.FL_FANCY
        (*t).h_lo = wgft_ldctx.num_or_fail(l, d, node, "height")
        (*t).h_hi = (*t).h_lo
        (*t).h_uni = false
    } else if ty == "acacia_foliage_placer" {
        (*t).fol = wgft_def.FL_ACACIA
        (*t).h_lo = 0
        (*t).h_hi = 0
        (*t).h_uni = false
    } else if ty == "bush_foliage_placer" || ty == "jungle_foliage_placer" {
        (*t).fol = wgft_def.FL_BUSH
        if ty == "jungle_foliage_placer" { (*t).fol = wgft_def.FL_MEGA_JUNGLE }
        (*t).h_lo = wgft_ldctx.num_or_fail(l, d, node, "height")
        (*t).h_hi = (*t).h_lo
        (*t).h_uni = false
    } else if ty == "mega_pine_foliage_placer" {
        (*t).fol = wgft_def.FL_MEGA_PINE
        (*t).h_uni = int_range(l, d, jsonstr.get(d, node, "crown_height"), &(*t).h_lo, &(*t).h_hi)
    } else if ty == "dark_oak_foliage_placer" {
        (*t).fol = wgft_def.FL_DARK_OAK
        (*t).h_lo = 4
        (*t).h_hi = 4
        (*t).h_uni = false
    } else if ty == "cherry_foliage_placer" {
        (*t).fol = wgft_def.FL_CHERRY
        (*t).h_lo = wgft_ldctx.num_or_fail(l, d, node, "height")
        (*t).h_hi = (*t).h_lo
        (*t).h_uni = false
        wgft_ldcherry.load_foliage(l, t, d, node)
    } else if ty == "pine_foliage_placer" {
        (*t).fol = wgft_def.FL_PINE
        (*t).h_uni = int_range(l, d, jsonstr.get(d, node, "height"), &(*t).h_lo, &(*t).h_hi)
    } else {
        (*l).ok = false
    }
}

fn load_size(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, ms: u32) {
    let ty: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, ms, "type")))
    (*t).fs_limit = wgft_ldctx.num_or_default(d, ms, "limit", 1)
    (*t).fs_lower = wgft_ldctx.num_or_default(d, ms, "lower_size", 0)
    (*t).fs_upper = wgft_ldctx.num_or_default(d, ms, "upper_size", 1)
    (*t).fs_clip = wgft_ldctx.num_or_default(d, ms, "min_clipped_height", 0 - 1)
    if ty == "two_layers_feature_size" {
        (*t).fs_kind = 0
    } else if ty == "three_layers_feature_size" {
        (*t).fs_kind = 1
        (*t).fs_upper_limit = wgft_ldctx.num_or_default(d, ms, "upper_limit", 1)
        (*t).fs_middle = wgft_ldctx.num_or_default(d, ms, "middle_size", 1)
    } else {
        (*l).ok = false
    }
}

fn register_vines(l: *mut wgft_ldctx.Ld) {
    let def: *mut wgft_def.FtDef = (*l).def
    (*def).vine_code[0] = reg_joined(l, "vine", "[east=true]")
    (*def).vine_code[1] = reg_joined(l, "vine", "[west=true]")
    (*def).vine_code[2] = reg_joined(l, "vine", "[south=true]")
    (*def).vine_code[3] = reg_joined(l, "vine", "[north=true]")
}

fn register_cocoa(l: *mut wgft_ldctx.Ld) {
    let def: *mut wgft_def.FtDef = (*l).def
    var ages: [str; 3] = ["cocoa[age=0,facing=", "cocoa[age=1,facing=", "cocoa[age=2,facing="]
    var faces: [str; 4] = ["north]", "east]", "south]", "west]"]
    var a: usize = 0
    while a < 3 {
        var f: usize = 0
        while f < 4 {
            (*def).cocoa_code[a * 4 + f] = reg_joined(l, ages[a], faces[f])
            f = f + 1
        }
        a = a + 1
    }
}

fn add_deco(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, kind: u8, code: u8, prob: f32) {
    if (*t).ndecos >= wgft_def.MAX_DECOS {
        (*l).ok = false
        return
    }
    (*t).decos[(*t).ndecos] = wgft_def.DecoCfg { kind: kind, code: code, prob: prob }
    (*t).ndecos = (*t).ndecos + 1
}

#[allow_fp]
fn load_one_deco(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, dec: u32) {
    let ty: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, dec, "type")))
    if ty == "beehive" {
        add_deco(l, t, wgft_def.DK_BEEHIVE, wgft_ldctx.reg_code(l, "bee_nest"), json.json_number(d, jsonstr.get(d, dec, "probability")) as f32)
    } else if ty == "alter_ground" {
        let st: u32 = provider_state(l, d, jsonstr.get(d, dec, "provider"))
        add_deco(l, t, wgft_def.DK_ALTER_GROUND, wgft_ldctx.reg_code(l, state_name(d, st)), 1.0f)
    } else if ty == "trunk_vine" {
        register_vines(l)
        add_deco(l, t, wgft_def.DK_TRUNK_VINE, 0, 1.0f)
    } else if ty == "leave_vine" {
        register_vines(l)
        add_deco(l, t, wgft_def.DK_LEAVE_VINE, 0, json.json_number(d, jsonstr.get(d, dec, "probability")) as f32)
    } else if ty == "cocoa" {
        register_cocoa(l)
        add_deco(l, t, wgft_def.DK_COCOA, 0, json.json_number(d, jsonstr.get(d, dec, "probability")) as f32)
    } else {
        (*l).ok = false
    }
}

fn load_decorators(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, node: u32) {
    let n: usize = json.json_count(d, node) as usize
    var i: usize = 0
    while i < n {
        load_one_deco(l, t, d, json.json_child_at(d, node, i))
        i = i + 1
    }
}
fn load_tree(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, cfg: u32) {
    let def: *mut wgft_def.FtDef = (*l).def
    if (*def).ntrees >= wgft_def.MAX_TREES {
        (*l).ok = false
        return
    }
    let ti: usize = (*def).ntrees
    (*def).ntrees = (*def).ntrees + 1
    let t: *mut wgft_def.TreeCfg = &(*def).trees[ti]
    (*f).kind = wgft_def.FK_TREE
    (*f).p[0] = ti as i32
    if jsonstr.get(d, cfg, "root_placer") != wgft_ldctx.NONE_NODE { (*l).ok = false }
    load_decorators(l, t, d, jsonstr.get(d, cfg, "decorators"))
    (*t).ignore_vines = json.json_kind(d, jsonstr.get(d, cfg, "ignore_vines")) == json.JSON_TRUE
    load_trunk(l, t, d, jsonstr.get(d, cfg, "trunk_placer"))
    load_foliage(l, t, d, jsonstr.get(d, cfg, "foliage_placer"))
    load_size(l, t, d, jsonstr.get(d, cfg, "minimum_size"))
    let trunk: u32 = provider_state(l, d, jsonstr.get(d, cfg, "trunk_provider"))
    if jsonstr.string(d, jsonstr.get(d, jsonstr.get(d, trunk, "Properties"), "axis")) != "y" { (*l).ok = false }
    (*t).trunk_code = reg_joined(l, state_name(d, trunk), "[axis=y]")
    (*t).trunk_code_x = reg_joined(l, state_name(d, trunk), "[axis=x]")
    (*t).trunk_code_z = reg_joined(l, state_name(d, trunk), "[axis=z]")
    let dirt: u32 = provider_state(l, d, jsonstr.get(d, cfg, "dirt_provider"))
    (*t).dirt_code = wgft_ldctx.reg_code(l, state_name(d, dirt))
    let leaves: u32 = provider_state(l, d, jsonstr.get(d, cfg, "foliage_provider"))
    (*t).fam = family_of(l, state_name(d, leaves))
    (*t).force_dirt = json.json_kind(d, jsonstr.get(d, cfg, "force_dirt")) == json.JSON_TRUE
}
