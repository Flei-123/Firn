import mc.gen.wgft_jdef

export { treeify_bin, tree_insert, split_tree_bin }

fn rotate_left(s: *mut wgft_jdef.JSet, root: i32, p: i32) -> i32 {
    if p < 0 { return root }
    let r: i32 = (*s).rt[p as usize]
    if r < 0 { return root }
    var out: i32 = root
    let rl: i32 = (*s).lf[r as usize]
    (*s).rt[p as usize] = rl
    if rl >= 0 { (*s).pr[rl as usize] = p }
    let pp: i32 = (*s).pr[p as usize]
    (*s).pr[r as usize] = pp
    if pp < 0 {
        out = r
        (*s).rd[r as usize] = false
    } else if (*s).lf[pp as usize] == p {
        (*s).lf[pp as usize] = r
    } else {
        (*s).rt[pp as usize] = r
    }
    (*s).lf[r as usize] = p
    (*s).pr[p as usize] = r
    return out
}

fn rotate_right(s: *mut wgft_jdef.JSet, root: i32, p: i32) -> i32 {
    if p < 0 { return root }
    let l: i32 = (*s).lf[p as usize]
    if l < 0 { return root }
    var out: i32 = root
    let lr: i32 = (*s).rt[l as usize]
    (*s).lf[p as usize] = lr
    if lr >= 0 { (*s).pr[lr as usize] = p }
    let pp: i32 = (*s).pr[p as usize]
    (*s).pr[l as usize] = pp
    if pp < 0 {
        out = l
        (*s).rd[l as usize] = false
    } else if (*s).rt[pp as usize] == p {
        (*s).rt[pp as usize] = l
    } else {
        (*s).lf[pp as usize] = l
    }
    (*s).rt[l as usize] = p
    (*s).pr[p as usize] = l
    return out
}

fn balance_insertion(s: *mut wgft_jdef.JSet, root0: i32, x0: i32) -> i32 {
    var root: i32 = root0
    var x: i32 = x0
    (*s).rd[x as usize] = true
    while true {
        var xp: i32 = (*s).pr[x as usize]
        if xp < 0 {
            (*s).rd[x as usize] = false
            return x
        }
        if !(*s).rd[xp as usize] { return root }
        var xpp: i32 = (*s).pr[xp as usize]
        if xpp < 0 { return root }
        let xppl: i32 = (*s).lf[xpp as usize]
        if xp == xppl {
            let xppr: i32 = (*s).rt[xpp as usize]
            if xppr >= 0 && (*s).rd[xppr as usize] {
                (*s).rd[xppr as usize] = false
                (*s).rd[xp as usize] = false
                (*s).rd[xpp as usize] = true
                x = xpp
            } else {
                if x == (*s).rt[xp as usize] {
                    x = xp
                    root = rotate_left(s, root, x)
                    xp = (*s).pr[x as usize]
                    xpp = 0 - 1
                    if xp >= 0 { xpp = (*s).pr[xp as usize] }
                }
                if xp >= 0 {
                    (*s).rd[xp as usize] = false
                    if xpp >= 0 {
                        (*s).rd[xpp as usize] = true
                        root = rotate_right(s, root, xpp)
                    }
                }
            }
        } else {
            if xppl >= 0 && (*s).rd[xppl as usize] {
                (*s).rd[xppl as usize] = false
                (*s).rd[xp as usize] = false
                (*s).rd[xpp as usize] = true
                x = xpp
            } else {
                if x == (*s).lf[xp as usize] {
                    x = xp
                    root = rotate_right(s, root, x)
                    xp = (*s).pr[x as usize]
                    xpp = 0 - 1
                    if xp >= 0 { xpp = (*s).pr[xp as usize] }
                }
                if xp >= 0 {
                    (*s).rd[xp as usize] = false
                    if xpp >= 0 {
                        (*s).rd[xpp as usize] = true
                        root = rotate_left(s, root, xpp)
                    }
                }
            }
        }
    }
    return root
}

fn move_root_to_front(s: *mut wgft_jdef.JSet, root: i32) {
    if root < 0 { return }
    let idx: usize = ((*s).hs[root as usize] & (((*s).cap as i64) - 1)) as usize
    let first: i32 = (*s).head[idx]
    if root == first { return }
    (*s).head[idx] = root
    let rp: i32 = (*s).pv[root as usize]
    let rn: i32 = (*s).nx[root as usize]
    if rn >= 0 { (*s).pv[rn as usize] = rp }
    if rp >= 0 { (*s).nx[rp as usize] = rn }
    if first >= 0 { (*s).pv[first as usize] = root }
    (*s).nx[root as usize] = first
    (*s).pv[root as usize] = 0 - 1
}

fn tie_dir(s: *wgft_jdef.JSet, a: i32, b: i32) -> i32 {
    let ua: usize = a as usize
    let ub: usize = b as usize
    if (*s).ky[ua] != (*s).ky[ub] {
        if (*s).ky[ua] < (*s).ky[ub] { return 0 - 1 }
        return 1
    }
    if (*s).kz[ua] != (*s).kz[ub] {
        if (*s).kz[ua] < (*s).kz[ub] { return 0 - 1 }
        return 1
    }
    if (*s).kx[ua] <= (*s).kx[ub] { return 0 - 1 }
    return 1
}

fn descend_dir(s: *wgft_jdef.JSet, x: i32, p: i32) -> i32 {
    let ph: i64 = (*s).hs[p as usize]
    let h: i64 = (*s).hs[x as usize]
    if ph > h { return 0 - 1 }
    if ph < h { return 1 }
    return tie_dir(s, x, p)
}

fn treeify_from(s: *mut wgft_jdef.JSet, start: i32) {
    var root: i32 = 0 - 1
    var x: i32 = start
    while x >= 0 {
        let next: i32 = (*s).nx[x as usize]
        (*s).lf[x as usize] = 0 - 1
        (*s).rt[x as usize] = 0 - 1
        if root < 0 {
            (*s).pr[x as usize] = 0 - 1
            (*s).rd[x as usize] = false
            root = x
        } else {
            var p: i32 = root
            while true {
                let dir: i32 = descend_dir(s, x, p)
                let xp: i32 = p
                if dir <= 0 { p = (*s).lf[xp as usize] } else { p = (*s).rt[xp as usize] }
                if p < 0 {
                    (*s).pr[x as usize] = xp
                    if dir <= 0 { (*s).lf[xp as usize] = x } else { (*s).rt[xp as usize] = x }
                    root = balance_insertion(s, root, x)
                    break
                }
            }
        }
        x = next
    }
    move_root_to_front(s, root)
}

fn treeify_bin(s: *mut wgft_jdef.JSet, idx: usize) {
    var e: i32 = (*s).head[idx]
    var tl: i32 = 0 - 1
    while e >= 0 {
        (*s).pv[e as usize] = tl
        tl = e
        e = (*s).nx[e as usize]
    }
    (*s).tree[idx] = true
    treeify_from(s, (*s).head[idx])
}

fn tree_insert(s: *mut wgft_jdef.JSet, idx: usize, x: i32) {
    var root: i32 = (*s).head[idx]
    while (*s).pr[root as usize] >= 0 {
        root = (*s).pr[root as usize]
    }
    var p: i32 = root
    while true {
        let dir: i32 = descend_dir(s, x, p)
        let xp: i32 = p
        if dir <= 0 { p = (*s).lf[xp as usize] } else { p = (*s).rt[xp as usize] }
        if p < 0 {
            let xpn: i32 = (*s).nx[xp as usize]
            (*s).nx[x as usize] = xpn
            (*s).lf[x as usize] = 0 - 1
            (*s).rt[x as usize] = 0 - 1
            if dir <= 0 { (*s).lf[xp as usize] = x } else { (*s).rt[xp as usize] = x }
            (*s).nx[xp as usize] = x
            (*s).pr[x as usize] = xp
            (*s).pv[x as usize] = xp
            if xpn >= 0 { (*s).pv[xpn as usize] = x }
            move_root_to_front(s, balance_insertion(s, root, x))
            break
        }
    }
}

fn split_tree_bin(s: *mut wgft_jdef.JSet, j: usize, bit: usize) {
    var lo_head: i32 = 0 - 1
    var lo_tail: i32 = 0 - 1
    var hi_head: i32 = 0 - 1
    var hi_tail: i32 = 0 - 1
    var lc: usize = 0
    var hc: usize = 0
    var e: i32 = (*s).head[j]
    while e >= 0 {
        let next: i32 = (*s).nx[e as usize]
        (*s).nx[e as usize] = 0 - 1
        if ((*s).hs[e as usize] & (bit as i64)) == 0 {
            (*s).pv[e as usize] = lo_tail
            if lo_tail < 0 { lo_head = e } else { (*s).nx[lo_tail as usize] = e }
            lo_tail = e
            lc = lc + 1
        } else {
            (*s).pv[e as usize] = hi_tail
            if hi_tail < 0 { hi_head = e } else { (*s).nx[hi_tail as usize] = e }
            hi_tail = e
            hc = hc + 1
        }
        e = next
    }
    (*s).head[j] = lo_head
    (*s).head[j + bit] = hi_head
    (*s).tree[j] = false
    (*s).tree[j + bit] = false
    if lo_head >= 0 && lc > wgft_jdef.UNTREEIFY_MAX {
        (*s).tree[j] = true
        if hi_head >= 0 { treeify_from(s, lo_head) }
    }
    if hi_head >= 0 && hc > wgft_jdef.UNTREEIFY_MAX {
        (*s).tree[j + bit] = true
        if lo_head >= 0 { treeify_from(s, hi_head) }
    }
}
