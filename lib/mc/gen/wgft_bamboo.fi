import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region

export { place }

fn podzol_disc(r: *mut wgft_region.Region, ft: *wgft_def.FtDef, x: i32, z: i32, rad: i32) {
    var ox: i32 = 0 - rad
    while ox <= rad {
        var oz: i32 = 0 - rad
        while oz <= rad {
            if ox * ox + oz * oz <= rad * rad {
                let hy: i32 = wgft_region.height_of(r, wgft_def.HM_SURFACE, x + ox, z + oz) - 1
                if (*ft).dirt[wgft_region.block_at(r, x + ox, hy, z + oz) as usize] {
                    wgft_region.set_block(r, x + ox, hy, z + oz, (*ft).bamboo_code[4])
                }
            }
            oz = oz + 1
        }
        ox = ox + 1
    }
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    if !(*ft).air[wgft_region.block_at(r, x, y, z) as usize] { return false }
    if !(*ft).bamboo_on[wgft_region.block_at(r, x, y - 1, z) as usize] { return false }
    let height: i32 = mg_random.rng_next_int_bound((*c).rng, 12) + 5
    if mg_random.rng_next_float((*c).rng) < (*f).discard {
        let rad: i32 = mg_random.rng_next_int_bound((*c).rng, 4) + 1
        podzol_disc(r, ft, x, z, rad)
    }
    var top: i32 = y
    var n: i32 = 0
    while n < height && (*ft).air[wgft_region.block_at(r, x, top, z) as usize] {
        wgft_region.set_block(r, x, top, z, (*ft).bamboo_code[0])
        top = top + 1
        n = n + 1
    }
    if top - y >= 3 {
        wgft_region.set_block(r, x, top, z, (*ft).bamboo_code[1])
        wgft_region.set_block(r, x, top - 1, z, (*ft).bamboo_code[2])
        wgft_region.set_block(r, x, top - 2, z, (*ft).bamboo_code[3])
    }
    return true
}
