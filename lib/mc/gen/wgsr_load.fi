import std.rt
import std.json
import std.jsonstr
import mc.gen.wgdf_graph
import mc.gen.wgdf_load
import mc.gen.wgbio_source
import mc.gen.wgsr_def

export { def_load }

const NONE_NODE: u32 = 4294967295

struct Ld {
    def: *mut wgsr_def.SrDef,
    g: *mut wgdf_graph.WgGraph,
    root: str,
    bio: *mut wgbio_source.BioSource,
    doc: *mut json.Json,
    ok: bool,
}

fn bare(s: str) -> str {
    return wgdf_load.strip_ns(s)
}

fn block_of(l: *mut Ld, name: str) -> i32 {
    let n: str = bare(name)
    let c: i32 = wgsr_def.block_code((*l).def, n.p as u64, n.n)
    if c < 0 { (*l).ok = false }
    return c
}

fn noise_of(l: *mut Ld, name: str) -> i32 {
    let s: i32 = wgdf_load.noise_slot((*l).g, (*l).root, name)
    if s < 0 { (*l).ok = false }
    return s
}

fn anchor_y(l: *mut Ld, j: u32) -> i32 {
    let d: *mut json.Json = (*l).doc
    let def: *mut wgsr_def.SrDef = (*l).def
    let a: u32 = jsonstr.get(d, j, "absolute")
    if a != NONE_NODE { return json.json_number(d, a) as i32 }
    let b: u32 = jsonstr.get(d, j, "above_bottom")
    if b != NONE_NODE { return (*def).min_y + (json.json_number(d, b) as i32) }
    let t: u32 = jsonstr.get(d, j, "below_top")
    if t != NONE_NODE { return (*def).min_y + (*def).height - 1 - (json.json_number(d, t) as i32) }
    (*l).ok = false
    return 0
}

fn add_cond(l: *mut Ld, kind: u8) -> i32 {
    let def: *mut wgsr_def.SrDef = (*l).def
    if (*def).nc >= wgsr_def.MAX_CONDS {
        (*l).ok = false
        return 0
    }
    let i: usize = (*def).nc
    (*def).nc = i + 1
    (*def).ck[i] = kind
    return i as i32
}

fn add_rule(l: *mut Ld, kind: u8, a: i32, b: i32) -> i32 {
    let def: *mut wgsr_def.SrDef = (*l).def
    if (*def).nr >= wgsr_def.MAX_RULES {
        (*l).ok = false
        return 0
    }
    let i: usize = (*def).nr
    (*def).nr = i + 1
    (*def).rk[i] = kind
    (*def).ra[i] = a
    (*def).rb[i] = b
    return i as i32
}

fn int_field(l: *mut Ld, j: u32, key: str) -> i32 {
    return wgdf_load.num_or((*l).doc, j, key, 0.0) as i32
}

fn bool_field(l: *mut Ld, j: u32, key: str) -> i32 {
    if json.json_bool((*l).doc, jsonstr.get((*l).doc, j, key)) { return 1 }
    return 0
}

fn set_mask(def: *mut wgsr_def.SrDef, c: i32, idx: usize) {
    if idx < 64 {
        (*def).cm0[c as usize] = (*def).cm0[c as usize] | ((1 as u64) << (idx as u64))
    } else {
        (*def).cm1[c as usize] = (*def).cm1[c as usize] | ((1 as u64) << ((idx - 64) as u64))
    }
}

fn load_biome_mask(l: *mut Ld, c: i32, j: u32) {
    let d: *mut json.Json = (*l).doc
    let arr: u32 = jsonstr.get(d, j, "biome_is")
    let cnt: usize = json.json_count(d, arr)
    var k: usize = 0
    while k < cnt {
        let nm: str = bare(jsonstr.string(d, json.json_child_at(d, arr, k)))
        if (*l).bio != (0 as *mut wgbio_source.BioSource) {
            let nb: usize = wgbio_source.bio_name_count((*l).bio)
            var i: usize = 0
            while i < nb && i < 128 {
                if wgbio_source.bio_name((*l).bio, i) == nm { set_mask((*l).def, c, i) }
                i = i + 1
            }
        }
        k = k + 1
    }
}

fn gradient_index(l: *mut Ld, name: str) -> i32 {
    let def: *mut wgsr_def.SrDef = (*l).def
    var full: [u8; 48] = [0; 48]
    var n: usize = 0
    var prefixed: bool = name.n > 10 && (name.p as u64) != 0 && rt.mem_eq(name.p as u64, "minecraft:".p as u64, 10)
    if !prefixed {
        rt.mem_copy((&full[0]) as u64, "minecraft:".p as u64, 10)
        n = 10
    }
    if n + name.n > 48 {
        (*l).ok = false
        return 0
    }
    rt.mem_copy(((&full[0]) as u64) + (n as u64), name.p as u64, name.n)
    n = n + name.n
    var i: usize = 0
    while i < (*def).ngrad {
        if (*def).glen[i] == n && rt.mem_eq((&(*def).gname[i][0]) as u64, (&full[0]) as u64, n) { return i as i32 }
        i = i + 1
    }
    if (*def).ngrad >= wgsr_def.MAX_GRADIENTS {
        (*l).ok = false
        return 0
    }
    rt.mem_copy((&(*def).gname[(*def).ngrad][0]) as u64, (&full[0]) as u64, n)
    (*def).glen[(*def).ngrad] = n
    (*def).ngrad = (*def).ngrad + 1
    return ((*def).ngrad as i32) - 1
}

fn load_cond(l: *mut Ld, j: u32) -> i32 {
    let d: *mut json.Json = (*l).doc
    let def: *mut wgsr_def.SrDef = (*l).def
    let ty: str = bare(jsonstr.string(d, jsonstr.get(d, j, "type")))
    if ty == "not" {
        let child: i32 = load_cond(l, jsonstr.get(d, j, "invert"))
        let c: i32 = add_cond(l, wgsr_def.CK_NOT)
        (*def).ci0[c as usize] = child
        return c
    }
    if ty == "above_preliminary_surface" { return add_cond(l, wgsr_def.CK_PRELIM) }
    if ty == "steep" { return add_cond(l, wgsr_def.CK_STEEP) }
    if ty == "temperature" { return add_cond(l, wgsr_def.CK_TEMP) }
    if ty == "hole" { return add_cond(l, wgsr_def.CK_HOLE) }
    if ty == "biome" {
        let c: i32 = add_cond(l, wgsr_def.CK_BIOME)
        load_biome_mask(l, c, j)
        return c
    }
    if ty == "noise_threshold" {
        let c: i32 = add_cond(l, wgsr_def.CK_NOISE)
        (*def).ci0[c as usize] = noise_of(l, jsonstr.string(d, jsonstr.get(d, j, "noise")))
        (*def).cf0[c as usize] = wgdf_load.num_or(d, j, "min_threshold", 0.0 - 1.0e300)
        (*def).cf1[c as usize] = wgdf_load.num_or(d, j, "max_threshold", 1.0e300)
        return c
    }
    if ty == "stone_depth" {
        let c: i32 = add_cond(l, wgsr_def.CK_DEPTH)
        (*def).ci0[c as usize] = int_field(l, j, "offset")
        (*def).ci1[c as usize] = bool_field(l, j, "add_surface_depth")
        (*def).ci2[c as usize] = int_field(l, j, "secondary_depth_range")
        if bare(jsonstr.string(d, jsonstr.get(d, j, "surface_type"))) == "ceiling" { (*def).ci3[c as usize] = 1 }
        return c
    }
    if ty == "water" {
        let c: i32 = add_cond(l, wgsr_def.CK_WATER)
        (*def).ci0[c as usize] = int_field(l, j, "offset")
        (*def).ci1[c as usize] = int_field(l, j, "surface_depth_multiplier")
        (*def).ci2[c as usize] = bool_field(l, j, "add_stone_depth")
        return c
    }
    if ty == "y_above" {
        let c: i32 = add_cond(l, wgsr_def.CK_Y)
        (*def).ci0[c as usize] = anchor_y(l, jsonstr.get(d, j, "anchor"))
        (*def).ci1[c as usize] = int_field(l, j, "surface_depth_multiplier")
        (*def).ci2[c as usize] = bool_field(l, j, "add_stone_depth")
        return c
    }
    if ty == "vertical_gradient" {
        let c: i32 = add_cond(l, wgsr_def.CK_GRADIENT)
        (*def).ci0[c as usize] = anchor_y(l, jsonstr.get(d, j, "true_at_and_below"))
        (*def).ci1[c as usize] = anchor_y(l, jsonstr.get(d, j, "false_at_and_above"))
        (*def).ci2[c as usize] = gradient_index(l, jsonstr.string(d, jsonstr.get(d, j, "random_name")))
        return c
    }
    (*l).ok = false
    return 0
}

fn load_rule(l: *mut Ld, j: u32) -> i32 {
    let d: *mut json.Json = (*l).doc
    let def: *mut wgsr_def.SrDef = (*l).def
    let ty: str = bare(jsonstr.string(d, jsonstr.get(d, j, "type")))
    if ty == "block" {
        let name: str = jsonstr.string(d, jsonstr.get(d, jsonstr.get(d, j, "result_state"), "Name"))
        return add_rule(l, wgsr_def.RK_BLOCK, block_of(l, name), 0)
    }
    if ty == "bandlands" { return add_rule(l, wgsr_def.RK_BAND, 0, 0) }
    if ty == "condition" {
        let c: i32 = load_cond(l, jsonstr.get(d, j, "if_true"))
        let r: i32 = load_rule(l, jsonstr.get(d, j, "then_run"))
        return add_rule(l, wgsr_def.RK_COND, c, r)
    }
    if ty == "sequence" {
        let arr: u32 = jsonstr.get(d, j, "sequence")
        let cnt: usize = json.json_count(d, arr)
        var tmp: [i32; 64] = [0; 64]
        if cnt > 64 {
            (*l).ok = false
            return 0
        }
        var k: usize = 0
        while k < cnt {
            tmp[k] = load_rule(l, json.json_child_at(d, arr, k))
            k = k + 1
        }
        if (*def).ni + cnt > wgsr_def.MAX_ITEMS {
            (*l).ok = false
            return 0
        }
        let start: usize = (*def).ni
        k = 0
        while k < cnt {
            (*def).items[start + k] = tmp[k]
            k = k + 1
        }
        (*def).ni = start + cnt
        return add_rule(l, wgsr_def.RK_SEQ, start as i32, cnt as i32)
    }
    (*l).ok = false
    return 0
}

fn load_biome_temps(l: *mut Ld) {
    let def: *mut wgsr_def.SrDef = (*l).def
    (*def).b_eroded = 0 - 1
    (*def).b_frozen = 0 - 1
    (*def).b_deep_frozen = 0 - 1
    if (*l).bio == (0 as *mut wgbio_source.BioSource) { return }
    let nb: usize = wgbio_source.bio_name_count((*l).bio)
    (*def).nbio = nb
    var i: usize = 0
    while i < nb && i < 96 {
        let nm: str = wgbio_source.bio_name((*l).bio, i)
        if nm == "eroded_badlands" { (*def).b_eroded = i as i32 }
        if nm == "frozen_ocean" { (*def).b_frozen = i as i32 }
        if nm == "deep_frozen_ocean" { (*def).b_deep_frozen = i as i32 }
        var raw: rt.Buf = rt.buf_new()
        var bd: json.Json = json.json_new()
        if wgdf_load.read_doc((*l).root, "biome", nm, &raw, &bd) {
            let r: u32 = json.json_root(&bd)
            let t: f64 = wgdf_load.num_or(&bd, r, "temperature", 0.5)
            (*def).bio_temp[i] = t as f32
            if wgdf_load.str_or(&bd, r, "temperature_modifier") == "frozen" { (*def).bio_frozen[i] = true }
        }
        json.json_free(&bd)
        rt.buf_free(&raw)
        i = i + 1
    }
}

fn preload_blocks(def: *mut wgsr_def.SrDef) {
    var names: [str; 9] = ["white_terracotta", "orange_terracotta", "terracotta", "yellow_terracotta", "brown_terracotta", "red_terracotta", "light_gray_terracotta", "packed_ice", "snow_block"]
    var i: usize = 0
    while i < 9 {
        wgsr_def.block_code(def, names[i].p as u64, names[i].n)
        i = i + 1
    }
}

fn load_noises(l: *mut Ld) {
    let def: *mut wgsr_def.SrDef = (*l).def
    (*def).s_surface = noise_of(l, "minecraft:surface")
    (*def).s_secondary = noise_of(l, "minecraft:surface_secondary")
    (*def).s_bands = noise_of(l, "minecraft:clay_bands_offset")
    (*def).s_bpillar = noise_of(l, "minecraft:badlands_pillar")
    (*def).s_broof = noise_of(l, "minecraft:badlands_pillar_roof")
    (*def).s_bsurf = noise_of(l, "minecraft:badlands_surface")
    (*def).s_ipillar = noise_of(l, "minecraft:iceberg_pillar")
    (*def).s_iroof = noise_of(l, "minecraft:iceberg_pillar_roof")
    (*def).s_isurf = noise_of(l, "minecraft:iceberg_surface")
}

fn def_load(def: *mut wgsr_def.SrDef, g: *mut wgdf_graph.WgGraph, root: str, dim: str, bio: *mut wgbio_source.BioSource) -> bool {
    var raw: rt.Buf = rt.buf_new()
    var doc: json.Json = json.json_new()
    if !wgdf_load.read_doc(root, "noise_settings", dim, &raw, &doc) {
        json.json_free(&doc)
        rt.buf_free(&raw)
        return false
    }
    let r: u32 = json.json_root(&doc)
    let rule: u32 = jsonstr.get(&doc, r, "surface_rule")
    var l: Ld = Ld { def: def, g: g, root: root, bio: bio, doc: &doc, ok: rule != NONE_NODE }
    (*def).min_y = (*g).min_y
    (*def).height = (*g).height
    (*def).sea_level = (*g).sea_level
    (*def).legacy = (*g).legacy_random
    (*def).default_len = (*g).default_block_len
    rt.mem_copy((&(*def).default_name[0]) as u64, (&(*g).default_block[0]) as u64, (*g).default_block_len)
    (*def).n_initial = wgdf_graph.router_find(g, "initial_density_without_jaggedness")
    preload_blocks(def)
    load_noises(&l)
    load_biome_temps(&l)
    if l.ok { (*def).root = load_rule(&l, rule) }
    json.json_free(&doc)
    rt.buf_free(&raw)
    return l.ok
}
