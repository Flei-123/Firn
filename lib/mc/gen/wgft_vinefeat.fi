import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region

export { place }

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    if !(*ft).air[wgft_region.block_at(r, x, y, z) as usize] { return false }
    var dx: [i32; 5] = [0, 0, 0, 0 - 1, 1]
    var dy: [i32; 5] = [1, 0, 0, 0, 0]
    var dz: [i32; 5] = [0, 0 - 1, 1, 0, 0]
    var slot: [usize; 5] = [4, 3, 2, 1, 0]
    var i: usize = 0
    while i < 5 {
        if (*ft).attach[wgft_region.block_at(r, x + dx[i], y + dy[i], z + dz[i]) as usize] {
            wgft_region.set_block(r, x, y, z, (*ft).vine_code[slot[i]])
            return true
        }
        i = i + 1
    }
    return false
}
