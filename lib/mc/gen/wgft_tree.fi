import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_jset
import mc.gen.wgft_tscratch
import mc.gen.wgft_foliage
import mc.gen.wgft_leafupd

export { place }

fn tree_height(rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg) -> i32 {
    let a: i32 = mg_random.rng_next_int_bound(rng, (*t).rand_a + 1)
    let b: i32 = mg_random.rng_next_int_bound(rng, (*t).rand_b + 1)
    return (*t).base + a + b
}

fn foliage_height(rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, height: i32) -> i32 {
    if (*t).fol == wgft_def.FL_BLOB { return (*t).h_lo }
    let v: i32 = wgft_foliage.sample_int(rng, (*t).h_lo, (*t).h_hi, (*t).h_uni)
    if (*t).fol == wgft_def.FL_SPRUCE {
        var h: i32 = height - v
        if h < 4 { h = 4 }
        return h
    }
    return v
}

fn foliage_radius(rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, span: i32) -> i32 {
    var radius: i32 = wgft_foliage.sample_int(rng, (*t).rad_lo, (*t).rad_hi, (*t).rad_uni)
    if (*t).fol == wgft_def.FL_PINE {
        var bound: i32 = span + 1
        if bound < 1 { bound = 1 }
        radius = radius + mg_random.rng_next_int_bound(rng, bound)
    }
    return radius
}

fn is_free(ft: *wgft_def.FtDef, code: u8) -> bool {
    return (*ft).tree_ok[code as usize] || (*ft).logs[code as usize]
}

fn max_free_height(r: *mut wgft_region.Region, t: *wgft_def.TreeCfg, height: i32, x: i32, y: i32, z: i32) -> i32 {
    let ft: *wgft_def.FtDef = (*r).ft
    var yy: i32 = 0
    while yy <= height + 1 {
        var size: i32 = (*t).fs_upper
        if yy < (*t).fs_limit { size = (*t).fs_lower }
        var dx: i32 = 0 - size
        while dx <= size {
            var dz: i32 = 0 - size
            while dz <= size {
                if !is_free(ft, wgft_region.block_at(r, x + dx, y + yy, z + dz)) { return yy - 2 }
                dz = dz + 1
            }
            dx = dx + 1
        }
        yy = yy + 1
    }
    return height
}

fn put_trunk(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, code: u8, x: i32, y: i32, z: i32) {
    wgft_region.set_block(r, x, y, z, code)
    wgft_jset.js_add(&(*sc).logs, x, y, z)
    wgft_tscratch.scratch_note(sc, x, y, z)
}

fn place_trunk(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    let ft: *wgft_def.FtDef = (*r).ft
    if (*t).force_dirt || !(*ft).tree_dirt[wgft_region.block_at(r, x, y - 1, z) as usize] {
        put_trunk(r, sc, (*t).dirt_code, x, y - 1, z)
    }
    var i: i32 = 0
    while i < free {
        if (*ft).tree_ok[wgft_region.block_at(r, x, y + i, z) as usize] { put_trunk(r, sc, (*t).trunk_code, x, y + i, z) }
        i = i + 1
    }
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    let rng: *mut mg_random.Rng = (*c).rng
    let t: *wgft_def.TreeCfg = &(*ft).trees[(*f).p[0] as usize]
    let height: i32 = tree_height(rng, t)
    let fh: i32 = foliage_height(rng, t, height)
    let radius: i32 = foliage_radius(rng, t, height - fh)
    if y < (*r).min_y + 1 || y + height + 1 > (*r).min_y + (*r).height { return false }
    let free: i32 = max_free_height(r, t, height, x, y, z)
    if !(free >= height || ((*t).fs_clip >= 0 && free >= (*t).fs_clip)) { return false }
    let sc: *mut wgft_tscratch.TreeScratch = (*r).scratch as *mut wgft_tscratch.TreeScratch
    wgft_tscratch.scratch_begin(sc)
    place_trunk(r, sc, t, free, x, y, z)
    wgft_foliage.place_foliage(r, sc, rng, t, x, y + free, z, fh, radius)
    if (*sc).logs.size == 0 && (*sc).foliage.size == 0 { return false }
    wgft_leafupd.update_leaves(r, sc)
    return true
}
