import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_jset
import mc.gen.wgft_tscratch
import mc.gen.wgft_foliage
import mc.gen.wgft_trunk
import mc.gen.wgft_fancy
import mc.gen.wgft_cherry
import mc.gen.wgft_upwards
import mc.gen.wgft_roots
import mc.gen.wgft_deco
import mc.gen.wgft_leafupd

export { place }

fn tree_height(rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg) -> i32 {
    let a: i32 = mg_random.rng_next_int_bound(rng, (*t).rand_a + 1)
    let b: i32 = mg_random.rng_next_int_bound(rng, (*t).rand_b + 1)
    return (*t).base + a + b
}

fn foliage_height(rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, height: i32) -> i32 {
    if (*t).fol == wgft_def.FL_BLOB || (*t).fol == wgft_def.FL_CHERRY || (*t).fol == wgft_def.FL_FANCY || (*t).fol == wgft_def.FL_BUSH || (*t).fol == wgft_def.FL_MEGA_JUNGLE { return (*t).h_lo }
    if (*t).fol == wgft_def.FL_ACACIA { return 0 }
    if (*t).fol == wgft_def.FL_DARK_OAK { return 4 }
    let v: i32 = wgft_foliage.sample_int(rng, (*t).h_lo, (*t).h_hi, (*t).h_uni)
    if (*t).fol == wgft_def.FL_SPRUCE {
        var h: i32 = height - v
        if h < 4 { h = 4 }
        return h
    }
    return v
}

fn foliage_radius(rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, span: i32) -> i32 {
    var radius: i32 = wgft_foliage.sample_int(rng, (*t).rad_lo, (*t).rad_hi, (*t).rad_uni)
    if (*t).fol == wgft_def.FL_PINE {
        var bound: i32 = span + 1
        if bound < 1 { bound = 1 }
        radius = radius + mg_random.rng_next_int_bound(rng, bound)
    }
    return radius
}

fn feature_size(t: *wgft_def.TreeCfg, height: i32, yy: i32) -> i32 {
    if yy < (*t).fs_limit { return (*t).fs_lower }
    if (*t).fs_kind == 1 {
        if yy >= height - (*t).fs_upper_limit { return (*t).fs_upper }
        return (*t).fs_middle
    }
    return (*t).fs_upper
}

fn free_code(ft: *wgft_def.FtDef, t: *wgft_def.TreeCfg, code: u16) -> bool {
    if (*t).trunk == wgft_def.TK_UPWARDS { return (*ft).up_free[code as usize] }
    return wgft_trunk.is_free(ft, code)
}

fn max_free_height(r: *mut wgft_region.Region, t: *wgft_def.TreeCfg, height: i32, x: i32, y: i32, z: i32) -> i32 {
    let ft: *wgft_def.FtDef = (*r).ft
    var yy: i32 = 0
    while yy <= height + 1 {
        let size: i32 = feature_size(t, height, yy)
        var dx: i32 = 0 - size
        while dx <= size {
            var dz: i32 = 0 - size
            while dz <= size {
                let code: u16 = wgft_region.block_at(r, x + dx, y + yy, z + dz)
                if !free_code(ft, t, code) || (!(*t).ignore_vines && (*ft).vine[code as usize]) { return yy - 2 }
                dz = dz + 1
            }
            dx = dx + 1
        }
        yy = yy + 1
    }
    return height
}

fn place_trunk(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    if (*t).trunk == wgft_def.TK_FANCY {
        wgft_fancy.place_fancy(r, sc, rng, t, free, x, y, z)
    } else if (*t).trunk == wgft_def.TK_FORKING {
        wgft_trunk.place_forking(r, sc, rng, t, free, x, y, z)
    } else if (*t).trunk == wgft_def.TK_CHERRY {
        wgft_cherry.place_cherry_trunk(r, sc, rng, t, free, x, y, z)
    } else if (*t).trunk == wgft_def.TK_UPWARDS {
        wgft_upwards.place_upwards(r, sc, rng, t, free, x, y, z)
    } else if (*t).trunk == wgft_def.TK_GIANT {
        wgft_trunk.place_giant(r, sc, t, free, x, y, z)
    } else if (*t).trunk == wgft_def.TK_MEGA_JUNGLE {
        wgft_trunk.place_mega_jungle(r, sc, rng, t, free, x, y, z)
    } else if (*t).trunk == wgft_def.TK_DARK_OAK {
        wgft_trunk.place_dark_oak(r, sc, rng, t, free, x, y, z)
    } else {
        wgft_trunk.place_straight(r, sc, t, free, x, y, z)
    }
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    let rng: *mut mg_random.Rng = (*c).rng
    let t: *wgft_def.TreeCfg = &(*ft).trees[(*f).p[0] as usize]
    let height: i32 = tree_height(rng, t)
    let fh: i32 = foliage_height(rng, t, height)
    let radius: i32 = foliage_radius(rng, t, height - fh)
    var ty: i32 = y
    if (*t).root.present { ty = y + wgft_foliage.sample_int(rng, (*t).root.off_lo, (*t).root.off_hi, (*t).root.off_uni) }
    var lo: i32 = y
    var hi: i32 = ty
    if ty < y {
        lo = ty
        hi = y
    }
    if lo < (*r).min_y + 1 || hi + height + 1 > (*r).min_y + (*r).height { return false }
    let free: i32 = max_free_height(r, t, height, x, ty, z)
    if !(free >= height || ((*t).fs_clip >= 0 && free >= (*t).fs_clip)) { return false }
    let sc: *mut wgft_tscratch.TreeScratch = (*r).scratch as *mut wgft_tscratch.TreeScratch
    wgft_tscratch.scratch_begin(sc)
    if (*t).root.present && !wgft_roots.place_roots(r, sc, rng, t, x, y, z, ty) { return false }
    place_trunk(r, sc, rng, t, free, x, ty, z)
    wgft_foliage.place_foliage(r, sc, rng, t, fh, radius)
    if (*sc).logs.size == 0 && (*sc).foliage.size == 0 { return false }
    wgft_deco.decorate_all(r, sc, rng, t)
    wgft_leafupd.update_leaves(r, sc)
    return true
}
