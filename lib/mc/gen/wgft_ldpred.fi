import std.json
import std.jsonstr
import mc.gen.wgft_def
import mc.gen.wgft_ldctx

export { load_pred }

fn offset_of(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32, p: *mut wgft_def.Pred) {
    let o: u32 = jsonstr.get(d, node, "offset")
    if o == wgft_ldctx.NONE_NODE { return }
    (*p).ox = json.json_number(d, json.json_child_at(d, o, 0)) as i32
    (*p).oy = json.json_number(d, json.json_child_at(d, o, 1)) as i32
    (*p).oz = json.json_number(d, json.json_child_at(d, o, 2)) as i32
}

fn load_pred(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32) -> i32 {
    let def: *mut wgft_def.FtDef = (*l).def
    if (*def).npreds >= wgft_def.MAX_PREDS {
        (*l).ok = false
        return 0
    }
    let idx: i32 = (*def).npreds as i32
    (*def).npreds = (*def).npreds + 1
    let p: *mut wgft_def.Pred = &(*def).preds[idx as usize]
    (*p).mask = 0 - 1
    (*p).ox = 0
    (*p).oy = 0
    (*p).oz = 0
    (*p).n = 0
    let ty: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, node, "type")))
    if ty == "true" {
        (*p).kind = wgft_def.PK_TRUE
    } else if ty == "matching_blocks" {
        (*p).kind = wgft_def.PK_MATCH
        (*p).mask = wgft_ldctx.alloc_mask(l)
        wgft_ldctx.names_mask(l, d, jsonstr.get(d, node, "blocks"), (*p).mask)
        offset_of(l, d, node, p)
    } else if ty == "solid" {
        (*p).kind = wgft_def.PK_SOLID
        offset_of(l, d, node, p)
    } else if ty == "matching_fluids" {
        (*p).kind = wgft_def.PK_WATER
        offset_of(l, d, node, p)
        if wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, node, "fluids"))) != "water" { (*l).ok = false }
    } else if ty == "inside_world_bounds" {
        (*p).kind = wgft_def.PK_INSIDE
        offset_of(l, d, node, p)
    } else if ty == "not" {
        (*p).kind = wgft_def.PK_NOT
        (*p).n = 1
        let k: i32 = load_pred(l, d, jsonstr.get(d, node, "predicate"))
        (*def).preds[idx as usize].kids[0] = k
    } else if ty == "any_of" || ty == "all_of" {
        if ty == "any_of" { (*p).kind = wgft_def.PK_ANY } else { (*p).kind = wgft_def.PK_ALL }
        let arr: u32 = jsonstr.get(d, node, "predicates")
        let cnt: usize = json.json_count(d, arr)
        if cnt > 4 { (*l).ok = false }
        var k: usize = 0
        while k < cnt && k < 4 {
            let kid: i32 = load_pred(l, d, json.json_child_at(d, arr, k))
            (*def).preds[idx as usize].kids[k] = kid
            k = k + 1
        }
        (*def).preds[idx as usize].n = k
    } else {
        (*l).ok = false
    }
    return idx
}
