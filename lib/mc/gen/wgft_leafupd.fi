import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_jset
import mc.gen.wgft_tscratch
import mc.gen.wgft_edges

export { update_leaves }

const MAX_DIST: i32 = 7

fn optional_distance(ft: *wgft_def.FtDef, code: u16) -> i32 {
    if (*ft).logs[code as usize] { return 0 }
    let d: u8 = (*ft).leaf_dist[code as usize]
    if d > (0 as u8) { return d as i32 }
    return 0 - 1
}

fn update_leaves(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch) {
    let ft: *wgft_def.FtDef = (*r).ft
    let volume: usize = (((*sc).max_x - (*sc).min_x + 1) * ((*sc).max_y - (*sc).min_y + 1) * ((*sc).max_z - (*sc).min_z + 1)) as usize
    if volume > wgft_tscratch.VOXEL_CAP { return }
    var i: usize = 0
    while i < volume {
        (*sc).voxel[i] = false
        i = i + 1
    }
    var di: usize = 0
    while di < (*sc).n_deco {
        if wgft_tscratch.in_box(sc, (*sc).deco_x[di], (*sc).deco_y[di], (*sc).deco_z[di]) {
            (*sc).voxel[wgft_tscratch.voxel_index(sc, (*sc).deco_x[di], (*sc).deco_y[di], (*sc).deco_z[di])] = true
        }
        di = di + 1
    }
    var xs: [i32; 3072] = [0; 3072]
    var ys: [i32; 3072] = [0; 3072]
    var zs: [i32; 3072] = [0; 3072]
    let n: usize = wgft_jset.js_collect(&(*sc).logs, &xs, &ys, &zs)
    i = 0
    while i < n {
        wgft_jset.js_add(&(*sc).buckets[0], xs[i], ys[i], zs[i])
        i = i + 1
    }
    var dir_dx: [i32; 6] = [0, 0, 0, 0, 0 - 1, 1]
    var dir_dy: [i32; 6] = [0 - 1, 1, 0, 0, 0, 0]
    var dir_dz: [i32; 6] = [0, 0, 0 - 1, 1, 0, 0]
    var d: i32 = 0
    var pos: [i32; 3] = [0, 0, 0]
    while d < MAX_DIST {
        if !wgft_jset.js_pop_first(&(*sc).buckets[d as usize], &pos) {
            d = d + 1
        } else if wgft_tscratch.in_box(sc, pos[0], pos[1], pos[2]) {
            if d != 0 {
                let cur: u16 = wgft_region.block_at(r, pos[0], pos[1], pos[2])
                let fam: u8 = (*ft).leaf_fam[cur as usize]
                wgft_region.set_block(r, pos[0], pos[1], pos[2], (*ft).fam_code[fam as usize][d as usize])
            }
            (*sc).voxel[wgft_tscratch.voxel_index(sc, pos[0], pos[1], pos[2])] = true
            var k: usize = 0
            while k < 6 {
                let nx: i32 = pos[0] + dir_dx[k]
                let ny: i32 = pos[1] + dir_dy[k]
                let nz: i32 = pos[2] + dir_dz[k]
                if wgft_tscratch.in_box(sc, nx, ny, nz) && !(*sc).voxel[wgft_tscratch.voxel_index(sc, nx, ny, nz)] {
                    let od: i32 = optional_distance(ft, wgft_region.block_at(r, nx, ny, nz))
                    if od >= 0 {
                        var nd: i32 = d + 1
                        if od < nd { nd = od }
                        if nd < MAX_DIST {
                            wgft_jset.js_add(&(*sc).buckets[nd as usize], nx, ny, nz)
                            if nd < d { d = nd }
                        }
                    }
                }
                k = k + 1
            }
        }
    }
    wgft_edges.update_edges(r, sc)
}
