import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_jset
import mc.gen.wgft_tscratch

export { update_leaves }

const MAX_DIST: i32 = 7

fn inside(sc: *wgft_tscratch.TreeScratch, x: i32, y: i32, z: i32) -> bool {
    return x >= (*sc).min_x && x <= (*sc).max_x && y >= (*sc).min_y && y <= (*sc).max_y && z >= (*sc).min_z && z <= (*sc).max_z
}

fn voxel_index(sc: *wgft_tscratch.TreeScratch, x: i32, y: i32, z: i32) -> usize {
    let sx: i32 = (*sc).max_x - (*sc).min_x + 1
    let sy: i32 = (*sc).max_y - (*sc).min_y + 1
    return ((((x - (*sc).min_x) * sy + (y - (*sc).min_y)) * ((*sc).max_z - (*sc).min_z + 1)) + (z - (*sc).min_z)) as usize
}

fn optional_distance(ft: *wgft_def.FtDef, code: u8) -> i32 {
    if (*ft).logs[code as usize] { return 0 }
    let d: u8 = (*ft).leaf_dist[code as usize]
    if d > (0 as u8) { return d as i32 }
    return 0 - 1
}

fn is_orphan(r: *mut wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    if !(*ft).dbl[wgft_region.block_at(r, x, y, z) as usize] { return false }
    return !(*ft).dbl[wgft_region.block_at(r, x, y + 1, z) as usize] && !(*ft).dbl[wgft_region.block_at(r, x, y - 1, z) as usize]
}

fn clear_orphan(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, x: i32, y: i32, z: i32) {
    if inside(sc, x, y, z) && (*sc).voxel[voxel_index(sc, x, y, z)] { return }
    if is_orphan(r, x, y, z) { wgft_region.set_block(r, x, y, z, (*(*r).ft).air_code) }
}

fn update_edges(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch) {
    var x: i32 = (*sc).min_x
    while x <= (*sc).max_x {
        var y: i32 = (*sc).min_y
        while y <= (*sc).max_y {
            var z: i32 = (*sc).min_z
            while z <= (*sc).max_z {
                if (*sc).voxel[voxel_index(sc, x, y, z)] {
                    clear_orphan(r, sc, x, y - 1, z)
                    clear_orphan(r, sc, x, y + 1, z)
                }
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
}

fn update_leaves(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch) {
    let ft: *wgft_def.FtDef = (*r).ft
    let volume: usize = (((*sc).max_x - (*sc).min_x + 1) * ((*sc).max_y - (*sc).min_y + 1) * ((*sc).max_z - (*sc).min_z + 1)) as usize
    if volume > wgft_tscratch.VOXEL_CAP { return }
    var i: usize = 0
    while i < volume {
        (*sc).voxel[i] = false
        i = i + 1
    }
    if (*sc).has_deco && inside(sc, (*sc).deco_x, (*sc).deco_y, (*sc).deco_z) {
        (*sc).voxel[voxel_index(sc, (*sc).deco_x, (*sc).deco_y, (*sc).deco_z)] = true
    }
    var xs: [i32; 1024] = [0; 1024]
    var ys: [i32; 1024] = [0; 1024]
    var zs: [i32; 1024] = [0; 1024]
    let n: usize = wgft_jset.js_collect(&(*sc).logs, &xs, &ys, &zs)
    i = 0
    while i < n {
        wgft_jset.js_add(&(*sc).buckets[0], xs[i], ys[i], zs[i])
        i = i + 1
    }
    var dir_dx: [i32; 6] = [0, 0, 0, 0, 0 - 1, 1]
    var dir_dy: [i32; 6] = [0 - 1, 1, 0, 0, 0, 0]
    var dir_dz: [i32; 6] = [0, 0, 0 - 1, 1, 0, 0]
    var d: i32 = 0
    var pos: [i32; 3] = [0, 0, 0]
    while d < MAX_DIST {
        if !wgft_jset.js_pop_first(&(*sc).buckets[d as usize], &pos) {
            d = d + 1
        } else if inside(sc, pos[0], pos[1], pos[2]) {
            if d != 0 {
                let cur: u8 = wgft_region.block_at(r, pos[0], pos[1], pos[2])
                let fam: u8 = (*ft).leaf_fam[cur as usize]
                wgft_region.set_block(r, pos[0], pos[1], pos[2], (*ft).fam_code[fam as usize][d as usize])
            }
            (*sc).voxel[voxel_index(sc, pos[0], pos[1], pos[2])] = true
            var k: usize = 0
            while k < 6 {
                let nx: i32 = pos[0] + dir_dx[k]
                let ny: i32 = pos[1] + dir_dy[k]
                let nz: i32 = pos[2] + dir_dz[k]
                if inside(sc, nx, ny, nz) && !(*sc).voxel[voxel_index(sc, nx, ny, nz)] {
                    let od: i32 = optional_distance(ft, wgft_region.block_at(r, nx, ny, nz))
                    if od >= 0 {
                        var nd: i32 = d + 1
                        if od < nd { nd = od }
                        if nd < MAX_DIST {
                            wgft_jset.js_add(&(*sc).buckets[nd as usize], nx, ny, nz)
                            if nd < d { d = nd }
                        }
                    }
                }
                k = k + 1
            }
        }
    }
    update_edges(r, sc)
}
