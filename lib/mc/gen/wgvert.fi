import std.json
import std.jsonstr

export { anchor_y }

const NONE_NODE: u32 = 4294967295

fn anchor_y(d: *mut json.Json, j: u32, min_y: i32, height: i32, ok: *mut bool) -> i32 {
    let a: u32 = jsonstr.get(d, j, "absolute")
    if a != NONE_NODE { return json.json_number(d, a) as i32 }
    let b: u32 = jsonstr.get(d, j, "above_bottom")
    if b != NONE_NODE { return min_y + (json.json_number(d, b) as i32) }
    let t: u32 = jsonstr.get(d, j, "below_top")
    if t != NONE_NODE { return min_y + height - 1 - (json.json_number(d, t) as i32) }
    *ok = false
    return 0
}
