import std.rt
import std.crypto.sha256
import mc.gen.mg_random
import mc.gen.mg_noise
import noise.psimplex
import mc.gen.wgsr_def

export { def_seed, def_noises_init }

const CODE_WHITE: u8 = 128
const CODE_ORANGE: u8 = 129
const CODE_TERRACOTTA: u8 = 130
const CODE_YELLOW: u8 = 131
const CODE_BROWN: u8 = 132
const CODE_RED: u8 = 133
const CODE_LIGHT_GRAY: u8 = 134

fn make_bands(r: *mut mg_random.Rng, bands: *mut [u8; 192], base: i32, code: u8) {
    let count: i32 = mg_random.rng_next_int_bound(r, 10) + 6
    var k: i32 = 0
    while k < count {
        let width: i32 = base + mg_random.rng_next_int_bound(r, 3)
        let at: i32 = mg_random.rng_next_int_bound(r, 192)
        var w: i32 = 0
        while at + w < 192 && w < width {
            (*bands)[(at + w) as usize] = code
            w = w + 1
        }
        k = k + 1
    }
}

fn bands_build(r: *mut mg_random.Rng, bands: *mut [u8; 192]) {
    var i: usize = 0
    while i < 192 {
        (*bands)[i] = CODE_TERRACOTTA
        i = i + 1
    }
    var p: i32 = 0
    while p < 192 {
        p = p + mg_random.rng_next_int_bound(r, 5) + 1
        if p < 192 { (*bands)[p as usize] = CODE_ORANGE }
        p = p + 1
    }
    make_bands(r, bands, 1, CODE_YELLOW)
    make_bands(r, bands, 2, CODE_BROWN)
    make_bands(r, bands, 1, CODE_RED)
    let want: i32 = mg_random.rng_next_int_bound(r, 7) + 9
    var done: i32 = 0
    var q: i32 = 0
    while done < want && q < 192 {
        (*bands)[q as usize] = CODE_WHITE
        if q - 1 > 0 && mg_random.rng_next_bool(r) { (*bands)[(q - 1) as usize] = CODE_LIGHT_GRAY }
        if q + 1 < 192 && mg_random.rng_next_bool(r) { (*bands)[(q + 1) as usize] = CODE_LIGHT_GRAY }
        done = done + 1
        q = q + mg_random.rng_next_int_bound(r, 16) + 4
    }
}

fn zoom_seed_of(seed: i64) -> i64 {
    var inb: [u8; 8] = [0; 8]
    var out: [u8; 32] = [0; 32]
    var k: usize = 0
    while k < 8 {
        inb[k] = (((seed as u64) >> ((k * 8) as u64)) & 255) as u8
        k = k + 1
    }
    sha256.sha256((&inb[0]) as u64, 8, (&out[0]) as u64)
    var v: u64 = 0
    k = 0
    while k < 8 {
        v = v | ((out[k] as u64) << ((k * 8) as u64))
        k = k + 1
    }
    return v as i64
}

fn noises_init_one(set_lo: i32, set_hi: i32, seed: i64) -> psimplex.PerlinSimplex {
    var r: mg_random.Rng = mg_random.rng_wrap(mg_random.rng_legacy(seed))
    let set: mg_noise.OctaveSet = mg_noise.octave_range(set_lo, set_hi)
    return mg_noise.psimplex_create(&r, &set)
}

fn def_noises_init(d: *mut wgsr_def.SrDef) {
    (*d).t_noise = noises_init_one(0, 0, 1234)
    (*d).f_noise = noises_init_one(0 - 2, 0, 3456)
    (*d).i_noise = noises_init_one(0, 0, 2345)
}

fn def_seed(d: *mut wgsr_def.SrDef, seed: i64) {
    var r0: mg_random.Rng = mg_random.rng_xoro(seed)
    if (*d).legacy { r0 = mg_random.rng_legacy(seed) }
    (*d).root_pf = mg_random.rng_fork_positional(&r0)
    let cb: str = "minecraft:clay_bands"
    var br: mg_random.Rng = mg_random.pos_from_hash_of(&(*d).root_pf, cb.p as u64, cb.n)
    bands_build(&br, &(*d).bands)
    var i: usize = 0
    while i < (*d).ngrad {
        var gr: mg_random.Rng = mg_random.pos_from_hash_of(&(*d).root_pf, (&(*d).gname[i][0]) as u64, (*d).glen[i])
        (*d).grad_pf[i] = mg_random.rng_fork_positional(&gr)
        i = i + 1
    }
    (*d).zoom_seed = zoom_seed_of(seed)
    (*d).ready = true
}
