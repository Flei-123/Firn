// SPDX-License-Identifier: MPL-2.0
import std.rt

export { PS_ENTRIES, PS_BYTES, ps_get, ps_put, ps_release }

const PS_ENTRIES: usize = 32768
const PS_BYTES: usize = 32768 * 13

fn ps_index(qx: i32, qz: i32) -> usize {
    let h: i32 = (qx *% 73856093) ^ (qz *% 19349663)
    return ((h ^ (h >> 15)) & 32767) as usize
}

fn ps_get(slot: *mut u64, qx: i32, qz: i32, out: *mut i32) -> bool {
    if *slot == 0 { return false }
    let i: usize = ps_index(qx, qz)
    let base: u64 = *slot
    let tx: *mut i32 = (base + ((i * 4) as u64)) as *mut i32
    let tz: *mut i32 = (base + ((PS_ENTRIES * 4 + i * 4) as u64)) as *mut i32
    let tv: *mut i32 = (base + ((PS_ENTRIES * 8 + i * 4) as u64)) as *mut i32
    let ok: *mut u8 = (base + ((PS_ENTRIES * 12 + i) as u64)) as *mut u8
    if *ok != 0 as u8 && *tx == qx && *tz == qz {
        *out = *tv
        return true
    }
    return false
}

fn ps_put(slot: *mut u64, qx: i32, qz: i32, v: i32) {
    if *slot == 0 {
        *slot = rt.heap_alloc(PS_BYTES)
        rt.mem_set(*slot, 0 as u8, PS_BYTES)
    }
    let i: usize = ps_index(qx, qz)
    let base: u64 = *slot
    *((base + ((i * 4) as u64)) as *mut i32) = qx
    *((base + ((PS_ENTRIES * 4 + i * 4) as u64)) as *mut i32) = qz
    *((base + ((PS_ENTRIES * 8 + i * 4) as u64)) as *mut i32) = v
    *((base + ((PS_ENTRIES * 12 + i) as u64)) as *mut u8) = 1 as u8
}

fn ps_release(slot: *mut u64) {
    if *slot != 0 {
        rt.heap_free(*slot, PS_BYTES)
        *slot = 0
    }
}
