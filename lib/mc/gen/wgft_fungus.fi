import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_nvines

export { place }

struct Fungus {
    base: u16,
    stem: u16,
    hat: u16,
    decor: u16,
    mask: i32,
    vine_head: u16,
    vine_plant: u16,
    wart: bool,
}

fn is_air(r: *wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    return (*(*r).ft).air[wgft_region.block_at(r, x, y, z) as usize]
}

fn replaceable(r: *wgft_region.Region, fg: *Fungus, x: i32, y: i32, z: i32, extra: bool) -> bool {
    let b: u16 = wgft_region.block_at(r, x, y, z)
    if (*(*r).ft).repl[b as usize] { return true }
    return extra && (*(*r).ft).masks[(*fg).mask as usize][b as usize]
}

fn try_weeping(c: *wgft_ctx.PlaceCtx, fg: *Fungus, x: i32, y: i32, z: i32) {
    let r: *mut wgft_region.Region = (*c).r
    if !is_air(r, x, y - 1, z) { return }
    var n: i32 = wgft_nvines.between((*c).rng, 1, 5)
    if mg_random.rng_next_int_bound((*c).rng, 7) == 0 { n = n * 2 }
    wgft_nvines.weeping_column(c, (*fg).vine_head, (*fg).vine_plant, x, y - 1, z, n, 23, 25)
}

fn place_stem(c: *wgft_ctx.PlaceCtx, fg: *Fungus, x: i32, y: i32, z: i32, h: i32, big: bool) {
    let r: *mut wgft_region.Region = (*c).r
    var s: i32 = 0
    if big { s = 1 }
    var dx: i32 = 0 - s
    while dx <= s {
        var dz: i32 = 0 - s
        while dz <= s {
            let corner: bool = big && dx * dx == s * s && dz * dz == s * s
            var dy: i32 = 0
            while dy < h {
                if replaceable(r, fg, x + dx, y + dy, z + dz, true) {
                    if corner {
                        if mg_random.rng_next_float((*c).rng) < 0.1f { wgft_region.set_block(r, x + dx, y + dy, z + dz, (*fg).stem) }
                    } else {
                        wgft_region.set_block(r, x + dx, y + dy, z + dz, (*fg).stem)
                    }
                }
                dy = dy + 1
            }
            dz = dz + 1
        }
        dx = dx + 1
    }
}

fn hat_block(c: *wgft_ctx.PlaceCtx, fg: *Fungus, x: i32, y: i32, z: i32, decor_p: f32, hat_p: f32, vine_p: f32) {
    let r: *mut wgft_region.Region = (*c).r
    if mg_random.rng_next_float((*c).rng) < decor_p {
        wgft_region.set_block(r, x, y, z, (*fg).decor)
    } else if mg_random.rng_next_float((*c).rng) < hat_p {
        wgft_region.set_block(r, x, y, z, (*fg).hat)
        if mg_random.rng_next_float((*c).rng) < vine_p { try_weeping(c, fg, x, y, z) }
    }
}

fn hat_drop(c: *wgft_ctx.PlaceCtx, fg: *Fungus, x: i32, y: i32, z: i32) {
    let r: *mut wgft_region.Region = (*c).r
    if wgft_region.block_at(r, x, y - 1, z) == (*fg).hat {
        wgft_region.set_block(r, x, y, z, (*fg).hat)
    } else if (mg_random.rng_next_float((*c).rng) as f64) < 0.15 {
        wgft_region.set_block(r, x, y, z, (*fg).hat)
        if (*fg).wart && mg_random.rng_next_int_bound((*c).rng, 11) == 0 { try_weeping(c, fg, x, y, z) }
    }
}

fn place_hat(c: *wgft_ctx.PlaceCtx, fg: *Fungus, x: i32, y: i32, z: i32, h: i32, big: bool) {
    let r: *mut wgft_region.Region = (*c).r
    var hs: i32 = mg_random.rng_next_int_bound((*c).rng, 1 + h / 3) + 5
    if h < hs { hs = h }
    let hb: i32 = h - hs
    var yy: i32 = hb
    while yy <= h {
        var rad: i32 = 1
        if yy < h - mg_random.rng_next_int_bound((*c).rng, 3) { rad = 2 }
        if hs > 8 && yy < hb + 4 { rad = 3 }
        if big { rad = rad + 1 }
        var dx: i32 = 0 - rad
        while dx <= rad {
            var dz: i32 = 0 - rad
            while dz <= rad {
                let edge_x: bool = dx == 0 - rad || dx == rad
                let edge_z: bool = dz == 0 - rad || dz == rad
                let inner: bool = !edge_x && !edge_z && yy != h
                let corner: bool = edge_x && edge_z
                let px: i32 = x + dx
                let py: i32 = y + yy
                let pz: i32 = z + dz
                if replaceable(r, fg, px, py, pz, false) {
                    var w: f32 = 0.0f
                    if yy < hb + 3 {
                        if !inner { hat_drop(c, fg, px, py, pz) }
                    } else if inner {
                        if (*fg).wart { w = 0.1f }
                        hat_block(c, fg, px, py, pz, 0.1f, 0.2f, w)
                    } else if corner {
                        if (*fg).wart { w = 0.083f }
                        hat_block(c, fg, px, py, pz, 0.01f, 0.7f, w)
                    } else {
                        if (*fg).wart { w = 0.07f }
                        hat_block(c, fg, px, py, pz, 0.0005f, 0.98f, w)
                    }
                }
                dz = dz + 1
            }
            dx = dx + 1
        }
        yy = yy + 1
    }
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let fg: Fungus = Fungus {
        base: (*f).p[0] as u16,
        stem: (*f).p[1] as u16,
        hat: (*f).p[2] as u16,
        decor: (*f).p[3] as u16,
        mask: (*f).p[4],
        vine_head: (*f).p[5] as u16,
        vine_plant: (*f).p[6] as u16,
        wart: (*f).p[7] != 0,
    }
    if wgft_region.block_at(r, x, y - 1, z) != fg.base { return false }
    var h: i32 = wgft_nvines.between((*c).rng, 4, 13)
    if mg_random.rng_next_int_bound((*c).rng, 12) == 0 { h = h * 2 }
    if y + h + 1 >= (*r).height { return false }
    let big: bool = mg_random.rng_next_float((*c).rng) < 0.06f
    wgft_region.set_block(r, x, y, z, (*(*r).ft).air_code)
    place_stem(c, &fg, x, y, z, h, big)
    place_hat(c, &fg, x, y, z, h, big)
    return true
}
