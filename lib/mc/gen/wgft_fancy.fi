// SPDX-License-Identifier: MPL-2.0
import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch
import mc.gen.wgft_trunk
import noise.jnum
import std.math

export { place_fancy }

const MAX_COORDS: usize = 48

struct Coords {
    n: usize,
    px: [i32; 48],
    py: [i32; 48],
    pz: [i32; 48],
    base: [i32; 48],
}

fn abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

fn max_i32(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

#[allow_fp]
fn tree_shape(h: i32, y: i32) -> f32 {
    let hf: f32 = h as f32
    if (y as f32) < hf * 0.3f { return 0.0f - 1.0f }
    let half: f32 = hf / 2.0f
    let diff: f32 = half - (y as f32)
    var s: f32 = math.sqrt32(half * half - diff * diff)
    if diff == 0.0f {
        s = half
    } else {
        var ad: f32 = diff
        if ad < 0.0f { ad = 0.0f - diff }
        if ad >= half { return 0.0f }
    }
    return s * 0.5f
}

#[allow_fp]
fn limb_offset(i: i32, step: f32) -> i32 {
    return jnum.floor_i32(((0.5f + (i as f32) * step) as f64))
}

fn log_code(t: *wgft_def.TreeCfg, fx: i32, fz: i32, px: i32, pz: i32) -> u8 {
    let dx: i32 = abs_i32(px - fx)
    let dz: i32 = abs_i32(pz - fz)
    let m: i32 = max_i32(dx, dz)
    if m > 0 {
        if dx == m { return (*t).trunk_code_x }
        return (*t).trunk_code_z
    }
    return (*t).trunk_code
}

#[allow_fp]
fn make_limb(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, fx: i32, fy: i32, fz: i32, tx: i32, ty: i32, tz: i32, place: bool) -> bool {
    if !place && fx == tx && fy == ty && fz == tz { return true }
    let ft: *wgft_def.FtDef = (*r).ft
    let dx: i32 = tx - fx
    let dy: i32 = ty - fy
    let dz: i32 = tz - fz
    let steps: i32 = max_i32(abs_i32(dx), max_i32(abs_i32(dy), abs_i32(dz)))
    var sx: f32 = 0.0f
    var sy: f32 = 0.0f
    var sz: f32 = 0.0f
    if steps > 0 {
        sx = (dx as f32) / (steps as f32)
        sy = (dy as f32) / (steps as f32)
        sz = (dz as f32) / (steps as f32)
    }
    var i: i32 = 0
    while i <= steps {
        let px: i32 = fx + limb_offset(i, sx)
        let py: i32 = fy + limb_offset(i, sy)
        let pz: i32 = fz + limb_offset(i, sz)
        if place {
            wgft_trunk.place_log(r, sc, log_code(t, fx, fz, px, pz), px, py, pz)
        } else if !wgft_trunk.is_free(ft, wgft_region.block_at(r, px, py, pz)) {
            return false
        }
        i = i + 1
    }
    return true
}

#[allow_fp]
fn trim_branches(h: i32, dy: i32) -> bool {
    return (dy as f64) >= (h as f64) * 0.2
}

#[allow_fp]
fn place_fancy(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    let h: i32 = free + 2
    let trunk_h: i32 = jnum.floor_i32((h as f64) * 0.618)
    wgft_trunk.set_dirt(r, sc, t, x, y - 1, z)
    let top_base: i32 = y + trunk_h
    var cur: i32 = h - 5
    var co: Coords = Coords { n: 0, px: [0; 48], py: [0; 48], pz: [0; 48], base: [0; 48] }
    co.px[0] = x
    co.py[0] = y + cur
    co.pz[0] = z
    co.base[0] = top_base
    co.n = 1
    while cur >= 0 {
        let shape: f32 = tree_shape(h, cur)
        if !(shape < 0.0f) {
            let reach: f64 = (shape as f64) * ((mg_random.rng_next_float(rng) as f64) + 0.328)
            let ang: f64 = ((mg_random.rng_next_float(rng) * 2.0f) as f64) * math.PI()
            let ex: i32 = x + jnum.floor_i32(reach * math.sin(ang) + 0.5)
            let ey: i32 = y + cur - 1
            let ez: i32 = z + jnum.floor_i32(reach * math.cos(ang) + 0.5)
            if make_limb(r, sc, t, ex, ey, ez, ex, ey + 5, ez, false) {
                let ddx: i32 = x - ex
                let ddz: i32 = z - ez
                let low: f64 = (ey as f64) - math.sqrt(((ddx * ddx + ddz * ddz) as f64)) * 0.381
                var by: i32 = top_base
                if !(low > (top_base as f64)) { by = jnum.d2i(low) }
                if make_limb(r, sc, t, x, by, z, ex, ey, ez, false) && co.n < MAX_COORDS {
                    co.px[co.n] = ex
                    co.py[co.n] = ey
                    co.pz[co.n] = ez
                    co.base[co.n] = by
                    co.n = co.n + 1
                }
            }
        }
        cur = cur - 1
    }
    make_limb(r, sc, t, x, y, z, x, y + trunk_h, z, true)
    var i: usize = 0
    while i < co.n {
        let b: i32 = co.base[i]
        let same: bool = x == co.px[i] && b == co.py[i] && z == co.pz[i]
        if !same && trim_branches(h, b - y) { make_limb(r, sc, t, x, b, z, co.px[i], co.py[i], co.pz[i], true) }
        i = i + 1
    }
    i = 0
    while i < co.n {
        if trim_branches(h, co.base[i] - y) { wgft_tscratch.add_attach(sc, co.px[i], co.py[i], co.pz[i], 0) }
        i = i + 1
    }
}
