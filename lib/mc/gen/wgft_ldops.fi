import std.json
import std.jsonstr
import mc.gen.wgvert
import mc.gen.wgft_def
import mc.gen.wgft_ldctx
import mc.gen.wgft_ldpred

export { load_placement }

fn load_weighted(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, dist: u32) {
    let cnt: usize = json.json_count(d, dist)
    if cnt == 0 || cnt > wgft_def.MAX_WEIGHTS {
        (*l).ok = false
        return
    }
    var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_COUNT_WEIGHTED)
    op.a = cnt as i32
    var k: usize = 0
    while k < cnt {
        let e: u32 = json.json_child_at(d, dist, k)
        var lo: i32 = 0
        var hi: i32 = 0
        if load_int_provider(l, d, jsonstr.get(d, e, "data"), &lo, &hi) != 0 { (*l).ok = false }
        op.v[k] = lo
        op.w[k] = wgft_ldctx.num_or_fail(l, d, e, "weight")
        k = k + 1
    }
    wgft_ldctx.push_op(l, f, op)
}

fn load_count(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, c: u32) {
    if json.json_kind(d, c) == json.JSON_NUMBER {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_COUNT)
        op.a = json.json_number(d, c) as i32
        wgft_ldctx.push_op(l, f, op)
        return
    }
    let ty: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, c, "type")))
    let v: u32 = jsonstr.get(d, c, "value")
    if ty == "clamped" {
        let src: u32 = jsonstr.get(d, v, "source")
        let sv: u32 = jsonstr.get(d, src, "value")
        if wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, src, "type"))) != "uniform" { (*l).ok = false }
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_COUNT_UNIFORM)
        op.a = wgft_ldctx.num_or_fail(l, d, sv, "min_inclusive")
        op.b = wgft_ldctx.num_or_fail(l, d, sv, "max_inclusive")
        op.c = wgft_ldctx.num_or_fail(l, d, v, "min_inclusive")
        op.d = wgft_ldctx.num_or_fail(l, d, v, "max_inclusive")
        op.e = 1
        wgft_ldctx.push_op(l, f, op)
    } else if ty == "uniform" {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_COUNT_UNIFORM)
        op.a = wgft_ldctx.num_or_fail(l, d, v, "min_inclusive")
        op.b = wgft_ldctx.num_or_fail(l, d, v, "max_inclusive")
        wgft_ldctx.push_op(l, f, op)
    } else if ty == "weighted_list" {
        load_weighted(l, f, d, jsonstr.get(d, c, "distribution"))
    } else if ty == "constant" {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_COUNT)
        op.a = json.json_number(d, v) as i32
        wgft_ldctx.push_op(l, f, op)
    } else {
        (*l).ok = false
    }
}

fn load_height(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, h: u32) {
    let ty: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, h, "type")))
    let def: *wgft_def.FtDef = (*l).def
    var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_HEIGHT_UNIFORM)
    op.a = wgvert.anchor_y(d, jsonstr.get(d, h, "min_inclusive"), (*def).min_y, (*def).height, &(*l).ok)
    op.b = wgvert.anchor_y(d, jsonstr.get(d, h, "max_inclusive"), (*def).min_y, (*def).height, &(*l).ok)
    if jsonstr.get(d, h, "plateau") != wgft_ldctx.NONE_NODE { (*l).ok = false }
    if ty == "trapezoid" {
        op.kind = wgft_def.OP_HEIGHT_TRAPEZOID
    } else if ty == "very_biased_to_bottom" {
        op.kind = wgft_def.OP_HEIGHT_BIASED
        op.c = wgft_ldctx.num_or_default(d, h, "inner", 1)
    } else if ty != "uniform" {
        (*l).ok = false
    }
    wgft_ldctx.push_op(l, f, op)
}

fn heightmap_kind(l: *mut wgft_ldctx.Ld, name: str) -> i32 {
    if name == "WORLD_SURFACE_WG" || name == "WORLD_SURFACE" { return wgft_def.HM_SURFACE as i32 }
    if name == "OCEAN_FLOOR_WG" || name == "OCEAN_FLOOR" { return wgft_def.HM_FLOOR as i32 }
    if name == "MOTION_BLOCKING" { return wgft_def.HM_MOTION as i32 }
    if name == "MOTION_BLOCKING_NO_LEAVES" { return wgft_def.HM_MOTION_NO_LEAVES as i32 }
    (*l).ok = false
    return 0
}

fn load_int_provider(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32, lo: *mut i32, hi: *mut i32) -> i32 {
    if json.json_kind(d, node) == json.JSON_NUMBER {
        *lo = json.json_number(d, node) as i32
        *hi = *lo
        return 0
    }
    let ty: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, node, "type")))
    if ty == "constant" {
        *lo = wgft_ldctx.num_or_fail(l, d, node, "value")
        *hi = *lo
        return 0
    }
    if ty == "uniform" {
        *lo = wgft_ldctx.num_or_fail(l, d, node, "min_inclusive")
        *hi = wgft_ldctx.num_or_fail(l, d, node, "max_inclusive")
        return 1
    }
    (*l).ok = false
    return 0
}

fn direction_dy(l: *mut wgft_ldctx.Ld, name: str) -> i32 {
    if name == "up" { return 1 }
    if name == "down" { return 0 - 1 }
    (*l).ok = false
    return 0
}

fn load_one(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, m: u32) {
    let ty: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, m, "type")))
    if ty == "count" {
        load_count(l, f, d, jsonstr.get(d, m, "count"))
    } else if ty == "in_square" {
        wgft_ldctx.push_op(l, f, wgft_ldctx.blank_op(wgft_def.OP_SQUARE))
    } else if ty == "rarity_filter" {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_RARITY)
        op.a = wgft_ldctx.num_or_fail(l, d, m, "chance")
        wgft_ldctx.push_op(l, f, op)
    } else if ty == "height_range" {
        load_height(l, f, d, jsonstr.get(d, m, "height"))
    } else if ty == "biome" {
        wgft_ldctx.push_op(l, f, wgft_ldctx.blank_op(wgft_def.OP_BIOME))
    } else if ty == "heightmap" {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_HEIGHTMAP)
        op.a = heightmap_kind(l, jsonstr.string(d, jsonstr.get(d, m, "heightmap")))
        wgft_ldctx.push_op(l, f, op)
    } else if ty == "random_offset" {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_RANDOM_OFFSET)
        op.e = load_int_provider(l, d, jsonstr.get(d, m, "xz_spread"), &op.a, &op.b)
        op.e = op.e | (load_int_provider(l, d, jsonstr.get(d, m, "y_spread"), &op.c, &op.d) << 1)
        wgft_ldctx.push_op(l, f, op)
    } else if ty == "noise_threshold_count" {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_NOISE_THRESHOLD)
        op.a = wgft_ldctx.num_or_fail(l, d, m, "below_noise")
        op.b = wgft_ldctx.num_or_fail(l, d, m, "above_noise")
        op.f = json.json_number(d, jsonstr.get(d, m, "noise_level"))
        wgft_ldctx.push_op(l, f, op)
    } else if ty == "noise_based_count" {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_NOISE_BASED)
        op.a = wgft_ldctx.num_or_fail(l, d, m, "noise_to_count_ratio")
        op.f = json.json_number(d, jsonstr.get(d, m, "noise_factor"))
        op.g = json.json_number(d, jsonstr.get(d, m, "noise_offset"))
        wgft_ldctx.push_op(l, f, op)
    } else if ty == "surface_water_depth_filter" {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_WATER_DEPTH)
        op.a = wgft_ldctx.num_or_fail(l, d, m, "max_water_depth")
        wgft_ldctx.push_op(l, f, op)
    } else if ty == "block_predicate_filter" {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_PRED_FILTER)
        op.a = wgft_ldpred.load_pred(l, d, jsonstr.get(d, m, "predicate"))
        wgft_ldctx.push_op(l, f, op)
    } else if ty == "environment_scan" {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_ENV_SCAN)
        op.a = direction_dy(l, wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, m, "direction_of_search"))))
        op.b = wgft_ldpred.load_pred(l, d, jsonstr.get(d, m, "target_condition"))
        let al: u32 = jsonstr.get(d, m, "allowed_search_condition")
        if al == wgft_ldctx.NONE_NODE { op.c = 0 - 1 } else { op.c = wgft_ldpred.load_pred(l, d, al) }
        op.d = wgft_ldctx.num_or_fail(l, d, m, "max_steps")
        wgft_ldctx.push_op(l, f, op)
    } else if ty == "surface_relative_threshold_filter" {
        var op: wgft_def.Op = wgft_ldctx.blank_op(wgft_def.OP_SURF_REL)
        op.a = heightmap_kind(l, jsonstr.string(d, jsonstr.get(d, m, "heightmap")))
        op.b = wgft_ldctx.num_or_default(d, m, "min_inclusive", 0 - 2147483647 - 1)
        op.c = wgft_ldctx.num_or_default(d, m, "max_inclusive", 2147483647)
        wgft_ldctx.push_op(l, f, op)
    } else {
        (*l).ok = false
    }
}

fn load_placement(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, arr: u32) {
    let cnt: usize = json.json_count(d, arr)
    var k: usize = 0
    while k < cnt {
        load_one(l, f, d, json.json_child_at(d, arr, k))
        k = k + 1
    }
}
