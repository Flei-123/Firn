import std.rt
import mc.gen.wgdf_graph
import mc.gen.wgft_jset

export { VegScratch, veg_new, veg_free }

struct VegScratch {
    first: wgft_jset.JSet,
    second: wgft_jset.JSet,
    tx: [i32; 3072],
    ty: [i32; 3072],
    tz: [i32; 3072],
    ox: [i32; 3072],
    oy: [i32; 3072],
    oz: [i32; 3072],
}

fn veg_new() -> *mut VegScratch {
    let n: usize = wgdf_graph.wg_size_of[VegScratch]()
    let s: *mut VegScratch = rt.heap_alloc(n) as *mut VegScratch
    rt.mem_set(s as u64, 0 as u8, n)
    return s
}

fn veg_free(s: *mut VegScratch) {
    rt.heap_free(s as u64, wgdf_graph.wg_size_of[VegScratch]())
}
