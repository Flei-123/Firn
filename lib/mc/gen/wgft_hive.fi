import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_jset
import mc.gen.wgft_tscratch

export { decorate }

fn is_air_at(r: *mut wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    return (*(*r).ft).air[wgft_region.block_at(r, x, y, z) as usize]
}

fn try_side(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, x: i32, y: i32, z: i32) -> bool {
    if !is_air_at(r, x, y, z) || !is_air_at(r, x, y, z + 1) { return false }
    wgft_region.set_block(r, x, y, z, (*t).hive_code)
    (*sc).has_deco = true
    (*sc).deco_x = x
    (*sc).deco_y = y
    (*sc).deco_z = z
    wgft_tscratch.scratch_note(sc, x, y, z)
    return true
}

fn hive_level(sc: *wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng) -> i32 {
    if (*sc).foliage.size > 0 {
        var lvl: i32 = (*sc).fo_min_y - 1
        if (*sc).lg_min_y + 1 > lvl { lvl = (*sc).lg_min_y + 1 }
        return lvl
    }
    let lvl: i32 = (*sc).lg_min_y + 1 + mg_random.rng_next_int_bound(rng, 3)
    if lvl < (*sc).lg_max_y { return lvl }
    return (*sc).lg_max_y
}

#[allow_fp]
fn decorate(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg) {
    if !(*t).has_hive { return }
    if mg_random.rng_next_float(rng) >= (*t).hive_p { return }
    let lvl: i32 = hive_level(sc, rng)
    var xs: [i32; 1024] = [0; 1024]
    var ys: [i32; 1024] = [0; 1024]
    var zs: [i32; 1024] = [0; 1024]
    let n: usize = wgft_jset.js_collect(&(*sc).logs, &xs, &ys, &zs)
    var i: usize = 0
    while i < n {
        if ys[i] == lvl {
            if try_side(r, sc, t, xs[i] + 1, lvl, zs[i]) { return }
            if try_side(r, sc, t, xs[i], lvl, zs[i] + 1) { return }
            if try_side(r, sc, t, xs[i] - 1, lvl, zs[i]) { return }
        }
        i = i + 1
    }
}
