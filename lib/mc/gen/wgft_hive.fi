import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_jset
import mc.gen.wgft_tscratch

export { decorate }

fn is_air_at(r: *mut wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    return (*(*r).ft).air[wgft_region.block_at(r, x, y, z) as usize]
}

fn try_side(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, dc: *wgft_def.DecoCfg, x: i32, y: i32, z: i32) -> bool {
    if !is_air_at(r, x, y, z) || !is_air_at(r, x, y, z + 1) { return false }
    wgft_region.set_block(r, x, y, z, (*dc).code)
    wgft_tscratch.add_deco(sc, x, y, z)
    return true
}

fn hive_level(sc: *wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng) -> i32 {
    if (*sc).foliage.size > 0 {
        var lvl: i32 = (*sc).fo_min_y - 1
        if (*sc).lg_min_y + 1 > lvl { lvl = (*sc).lg_min_y + 1 }
        return lvl
    }
    let lvl: i32 = (*sc).lg_min_y + 1 + mg_random.rng_next_int_bound(rng, 3)
    if lvl < (*sc).lg_max_y { return lvl }
    return (*sc).lg_max_y
}

#[allow_fp]
fn decorate(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, dc: *wgft_def.DecoCfg) {
    if mg_random.rng_next_float(rng) >= (*dc).prob { return }
    let lvl: i32 = hive_level(sc, rng)
    var xs: [i32; 3072] = [0; 3072]
    var ys: [i32; 3072] = [0; 3072]
    var zs: [i32; 3072] = [0; 3072]
    let n: usize = wgft_jset.js_collect(&(*sc).logs, &xs, &ys, &zs)
    var i: usize = 0
    while i < n {
        if ys[i] == lvl {
            if try_side(r, sc, dc, xs[i] + 1, lvl, zs[i]) { return }
            if try_side(r, sc, dc, xs[i], lvl, zs[i] + 1) { return }
            if try_side(r, sc, dc, xs[i] - 1, lvl, zs[i]) { return }
        }
        i = i + 1
    }
}
