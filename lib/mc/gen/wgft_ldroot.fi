import std.rt
import std.json
import std.jsonstr
import mc.gen.wgtag
import mc.gen.wgsr_def
import mc.gen.wgft_def
import mc.gen.wgft_ldctx
import mc.gen.wgft_ldpred
import mc.gen.wgft_ldprov

export { load_root_system }

fn state_code(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32) -> u16 {
    let st: u32 = wgft_ldprov.provider_state(l, d, node)
    return wgft_ldctx.reg_code(l, wgft_ldprov.state_name(d, st))
}

fn load_root_system(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, cfg: u32, sub: i32) {
    (*f).kind = wgft_def.FK_ROOT
    (*f).sub = sub
    (*f).p[0] = wgft_ldctx.num_or_fail(l, d, cfg, "required_vertical_space_for_tree")
    (*f).p[1] = wgft_ldctx.num_or_fail(l, d, cfg, "root_radius")
    (*f).p[2] = wgft_ldctx.num_or_fail(l, d, cfg, "root_placement_attempts")
    (*f).p[3] = wgft_ldctx.num_or_fail(l, d, cfg, "root_column_max_height")
    (*f).p[4] = wgft_ldctx.num_or_fail(l, d, cfg, "hanging_root_radius")
    (*f).p[5] = wgft_ldctx.num_or_fail(l, d, cfg, "hanging_roots_vertical_span")
    (*f).p[6] = wgft_ldctx.num_or_fail(l, d, cfg, "hanging_root_placement_attempts")
    (*f).p[7] = wgft_ldctx.num_or_fail(l, d, cfg, "allowed_vertical_water_for_tree")
    (*f).out_code[0] = state_code(l, d, jsonstr.get(d, cfg, "root_state_provider"))
    (*f).out_code[1] = state_code(l, d, jsonstr.get(d, cfg, "hanging_root_state_provider"))
    (*f).rule_pred[0] = wgft_ldpred.load_pred(l, d, jsonstr.get(d, cfg, "allowed_tree_position"))
    let raw: str = jsonstr.string(d, jsonstr.get(d, cfg, "root_replaceable"))
    if raw.n > 1 && rt.ld8(raw.p as u64, 0) == 35 {
        let tag: str = wgft_ldctx.bare(str { p: ((raw.p as u64) + 1) as *mut u8, n: raw.n - 1 })
        wgtag.tag_mask((*l).root, (*l).sdef, tag, (&(*f).test[0][0]) as u64, (wgsr_def.CODE_SPACE as i32))
    } else {
        (*l).ok = false
    }
}
