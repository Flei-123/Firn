import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_jset
import mc.gen.wgft_tscratch
import mc.gen.wgft_ysort

export { trunk_vine, leave_vine, cocoa }

fn is_air_at(r: *mut wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    return (*(*r).ft).air[wgft_region.block_at(r, x, y, z) as usize]
}

fn put(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, x: i32, y: i32, z: i32, code: u16) {
    wgft_region.set_block(r, x, y, z, code)
    wgft_tscratch.add_deco(sc, x, y, z)
}

fn side_dx(k: usize) -> i32 {
    if k == 0 { return 0 - 1 }
    if k == 1 { return 1 }
    return 0
}

fn side_dz(k: usize) -> i32 {
    if k == 2 { return 0 - 1 }
    if k == 3 { return 1 }
    return 0
}

fn trunk_vine(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng) {
    let ft: *wgft_def.FtDef = (*r).ft
    let n: usize = wgft_ysort.collect_sorted(sc, &(*sc).logs)
    var i: usize = 0
    while i < n {
        var k: usize = 0
        while k < 4 {
            if mg_random.rng_next_int_bound(rng, 3) > 0 {
                let px: i32 = (*sc).sx[i] + side_dx(k)
                let pz: i32 = (*sc).sz[i] + side_dz(k)
                if is_air_at(r, px, (*sc).sy[i], pz) { put(r, sc, px, (*sc).sy[i], pz, (*ft).vine_code[k]) }
            }
            k = k + 1
        }
        i = i + 1
    }
}

fn hanging(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, x: i32, y: i32, z: i32, code: u16) {
    put(r, sc, x, y, z, code)
    var left: i32 = 4
    var yy: i32 = y - 1
    while is_air_at(r, x, yy, z) && left > 0 {
        put(r, sc, x, yy, z, code)
        yy = yy - 1
        left = left - 1
    }
}

#[allow_fp]
fn leave_vine(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, dc: *wgft_def.DecoCfg) {
    let ft: *wgft_def.FtDef = (*r).ft
    let n: usize = wgft_ysort.collect_sorted(sc, &(*sc).foliage)
    var i: usize = 0
    while i < n {
        var k: usize = 0
        while k < 4 {
            if mg_random.rng_next_float(rng) < (*dc).prob {
                let px: i32 = (*sc).sx[i] + side_dx(k)
                let pz: i32 = (*sc).sz[i] + side_dz(k)
                if is_air_at(r, px, (*sc).sy[i], pz) { hanging(r, sc, px, (*sc).sy[i], pz, (*ft).vine_code[k]) }
            }
            k = k + 1
        }
        i = i + 1
    }
}

#[allow_fp]
fn cocoa(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, dc: *wgft_def.DecoCfg) {
    let ft: *wgft_def.FtDef = (*r).ft
    if mg_random.rng_next_float(rng) >= (*dc).prob { return }
    let n: usize = wgft_ysort.collect_sorted(sc, &(*sc).logs)
    if n == 0 { return }
    let base: i32 = (*sc).sy[0]
    var i: usize = 0
    while i < n {
        if (*sc).sy[i] - base <= 2 {
            var face: usize = 0
            while face < 4 {
                if mg_random.rng_next_float(rng) <= 0.25f {
                    let px: i32 = (*sc).sx[i] - cocoa_dx(face)
                    let pz: i32 = (*sc).sz[i] - cocoa_dz(face)
                    if is_air_at(r, px, (*sc).sy[i], pz) {
                        let age: i32 = mg_random.rng_next_int_bound(rng, 3)
                        put(r, sc, px, (*sc).sy[i], pz, (*ft).cocoa_code[(age as usize) * 4 + face])
                    }
                }
                face = face + 1
            }
        }
        i = i + 1
    }
}

fn cocoa_dx(face: usize) -> i32 {
    if face == 1 { return 1 }
    if face == 3 { return 0 - 1 }
    return 0
}

fn cocoa_dz(face: usize) -> i32 {
    if face == 0 { return 0 - 1 }
    if face == 2 { return 1 }
    return 0
}
