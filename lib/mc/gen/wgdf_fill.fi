import std.mem
import mc.gen.wgdf_graph
import mc.gen.wgdf_eval

export { STATE_SOLID, STATE_AIR, STATE_WATER, STATE_LAVA, fill_begin, fill_end, fill_state, fill_chunk }

const STATE_SOLID: u8 = 83
const STATE_AIR: u8 = 65
const STATE_WATER: u8 = 87
const STATE_LAVA: u8 = 76

fn fill_begin(g: *wgdf_graph.WgGraph, ns: *mut wgdf_eval.WgNoises, min_x: i32, min_z: i32) {
    if (*ns).grid == 0 {
        (*ns).grid = mem.alloc(wgdf_eval.GRID_BYTES)
    }
    let gr: *mut wgdf_eval.FillGrid = (*ns).grid as *mut wgdf_eval.FillGrid
    let cw: i32 = (*g).size_h * 4
    let ch: i32 = (*g).size_v * 4
    (*gr).corner_mode = false
    (*gr).min_x = min_x
    (*gr).min_z = min_z
    (*gr).cw = cw
    (*gr).ch = ch
    (*gr).cells_x = 16 / cw
    (*gr).cells_y = (*g).height / ch
    (*gr).cell_min_y = wgdf_eval.floor_div((*g).min_y, ch)
    (*gr).next_slot = 0
    var i: usize = 0
    while i < 3072 {
        (*gr).slot_of[i] = -1
        i = i + 1
    }
}

fn fill_end(ns: *mut wgdf_eval.WgNoises) {
    if (*ns).grid != 0 {
        mem.free((*ns).grid, wgdf_eval.GRID_BYTES)
        (*ns).grid = 0
    }
}

fn fluid_state(g: *wgdf_graph.WgGraph, y: i32) -> u8 {
    var lava_level: i32 = -54
    if (*g).sea_level < lava_level {
        lava_level = (*g).sea_level
    }
    if y < lava_level {
        return STATE_LAVA
    }
    if y < (*g).sea_level {
        if (*g).fluid == 1 { return STATE_WATER }
        if (*g).fluid == 2 { return STATE_LAVA }
    }
    return STATE_AIR
}

fn fill_state(g: *wgdf_graph.WgGraph, ns: *wgdf_eval.WgNoises, root: i32, x: i32, y: i32, z: i32) -> u8 {
    if wgdf_eval.eval(g, ns, root, x, y, z) > 0.0 {
        return STATE_SOLID
    }
    return fluid_state(g, y)
}

fn fill_chunk(g: *wgdf_graph.WgGraph, ns: *mut wgdf_eval.WgNoises, root: i32, cx: i32, cz: i32, cached: bool, out: *mut u8) {
    let min_x: i32 = cx * 16
    let min_z: i32 = cz * 16
    if cached {
        fill_begin(g, ns, min_x, min_z)
    }
    var yi: i32 = 0
    while yi < (*g).height {
        var lz: i32 = 0
        while lz < 16 {
            var lx: i32 = 0
            while lx < 16 {
                let st: u8 = fill_state(g, ns, root, min_x + lx, (*g).min_y + yi, min_z + lz)
                *(((out as u64) + ((((yi * 16 + lz) * 16 + lx) as usize) as u64)) as *mut u8) = st
                lx = lx + 1
            }
            lz = lz + 1
        }
        yi = yi + 1
    }
    fill_end(ns)
}
