import std.mem
import mc.gen.mg_random
import mc.gen.wgdf_graph
import mc.gen.wgdf_eval
import mc.gen.wgdf_fluid
import mc.gen.wgdf_aquifer
import mc.gen.wgdf_veins

export { FillCtx, fill_begin, fill_end, fill_state, fill_chunk }

struct FillCtx {
    root: i32,
    aq: u64,
    ore_pf: mg_random.PosFactory,
    n_toggle: i32,
    n_ridged: i32,
    n_gap: i32,
    ore_on: bool,
}

fn fill_begin(g: *wgdf_graph.WgGraph, ns: *mut wgdf_eval.WgNoises, min_x: i32, min_z: i32) {
    if (*ns).grid == 0 {
        (*ns).grid = mem.alloc(wgdf_eval.GRID_BYTES)
    }
    let gr: *mut wgdf_eval.FillGrid = (*ns).grid as *mut wgdf_eval.FillGrid
    let cw: i32 = (*g).size_h * 4
    let ch: i32 = (*g).size_v * 4
    (*gr).corner_mode = false
    (*gr).min_x = min_x
    (*gr).min_z = min_z
    (*gr).cw = cw
    (*gr).ch = ch
    (*gr).cells_x = 16 / cw
    (*gr).cells_y = (*g).height / ch
    (*gr).cell_min_y = wgdf_eval.floor_div((*g).min_y, ch)
    (*gr).next_slot = 0
    var i: usize = 0
    while i < 3072 {
        (*gr).slot_of[i] = -1
        i = i + 1
    }
}

fn fill_end(ns: *mut wgdf_eval.WgNoises) {
    if (*ns).grid != 0 {
        mem.free((*ns).grid, wgdf_eval.GRID_BYTES)
        (*ns).grid = 0
    }
}

fn ctx_new(g: *wgdf_graph.WgGraph, ns: *wgdf_eval.WgNoises, root: i32, min_x: i32, min_z: i32) -> FillCtx {
    var c: FillCtx = FillCtx {
        root: root, aq: 0, ore_pf: wgdf_veins.vein_factory(g, ns),
        n_toggle: wgdf_graph.router_find(g, "vein_toggle"),
        n_ridged: wgdf_graph.router_find(g, "vein_ridged"),
        n_gap: wgdf_graph.router_find(g, "vein_gap"),
        ore_on: (*g).ore_veins,
    }
    if (*g).aquifers {
        c.aq = wgdf_aquifer.aquifer_new(g, ns, min_x, min_z) as u64
    }
    return c
}

fn ctx_free(c: *mut FillCtx) {
    if (*c).aq != 0 {
        wgdf_aquifer.aquifer_free((*c).aq as *mut wgdf_aquifer.Aquifer)
        (*c).aq = 0
    }
}

fn fill_state(g: *wgdf_graph.WgGraph, ns: *wgdf_eval.WgNoises, c: *FillCtx, x: i32, y: i32, z: i32) -> u8 {
    let density: f64 = wgdf_eval.eval(g, ns, (*c).root, x, y, z)
    var st: u8 = 0
    if (*c).aq != 0 {
        st = wgdf_aquifer.aquifer_substance(g, ns, (*c).aq as *mut wgdf_aquifer.Aquifer, x, y, z, density)
    } else if !(density > 0.0) {
        let f: wgdf_fluid.Fluid = wgdf_fluid.fluid_global(g, y)
        st = wgdf_fluid.fluid_at(&f, y)
    }
    if st != 0 {
        return st
    }
    if (*c).ore_on {
        st = wgdf_veins.vein_state(g, ns, &(*c).ore_pf, (*c).n_toggle, (*c).n_ridged, (*c).n_gap, x, y, z)
        if st != 0 {
            return st
        }
    }
    return wgdf_fluid.STATE_SOLID
}

fn fill_chunk(g: *wgdf_graph.WgGraph, ns: *mut wgdf_eval.WgNoises, root: i32, cx: i32, cz: i32, cached: bool, out: *mut u8) {
    let min_x: i32 = cx * 16
    let min_z: i32 = cz * 16
    if cached {
        fill_begin(g, ns, min_x, min_z)
    }
    var c: FillCtx = ctx_new(g, ns, root, min_x, min_z)
    var yi: i32 = 0
    while yi < (*g).height {
        var lz: i32 = 0
        while lz < 16 {
            var lx: i32 = 0
            while lx < 16 {
                let st: u8 = fill_state(g, ns, &c, min_x + lx, (*g).min_y + yi, min_z + lz)
                *(((out as u64) + ((((yi * 16 + lz) * 16 + lx) as usize) as u64)) as *mut u8) = st
                lx = lx + 1
            }
            lz = lz + 1
        }
        yi = yi + 1
    }
    ctx_free(&c)
    fill_end(ns)
}
