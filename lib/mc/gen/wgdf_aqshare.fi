// SPDX-License-Identifier: MPL-2.0
import std.rt
import mc.gen.wgdf_fluid

export { AqShare, AQSHARE_BYTES, share_new, share_free, share_reset, share_get, share_put, prelim_get, prelim_put }

const SHARE_X: i32 = 8
const SHARE_Z: i32 = 10
const SHARE_Y: i32 = 48
const SHARE_CELLS: usize = 3840
const AQSHARE_BYTES: usize = 131072
const PRELIM_SIDE: i32 = 64
const PRELIM_CELLS: usize = 4096
const CELL_EMPTY: u64 = 0
const CELL_BUSY: u64 = 1
const CELL_READY: u64 = 2

struct AqShare {
    base_gx: i32,
    base_gz: i32,
    min_gy: i32,
    base_qx: i32,
    base_qz: i32,
    pstate: [u64; 4096],
    pval: [i32; 4096],
    state: [u64; 3840],
    level: [i32; 3840],
    ty: [u8; 3840],
}

fn share_new(min_gy: i32) -> *mut AqShare {
    let s: *mut AqShare = rt.heap_alloc(AQSHARE_BYTES) as *mut AqShare
    (*s).base_gx = 0
    (*s).base_gz = 0
    (*s).min_gy = min_gy
    (*s).base_qx = 0
    (*s).base_qz = 0
    var i: usize = 0
    while i < SHARE_CELLS {
        (*s).state[i] = CELL_EMPTY
        i = i + 1
    }
    i = 0
    while i < PRELIM_CELLS {
        (*s).pstate[i] = CELL_EMPTY
        i = i + 1
    }
    return s
}

fn share_free(s: *mut AqShare) {
    rt.heap_free(s as u64, AQSHARE_BYTES)
}

fn share_reset(s: *mut AqShare, tile_x: i32, tile_z: i32) {
    (*s).base_gx = tile_x - 3
    (*s).base_gz = tile_z - 3
    (*s).base_qx = tile_x * 4 - 28
    (*s).base_qz = tile_z * 4 - 28
    var i: usize = 0
    while i < SHARE_CELLS {
        (*s).state[i] = CELL_EMPTY
        i = i + 1
    }
    i = 0
    while i < PRELIM_CELLS {
        (*s).pstate[i] = CELL_EMPTY
        i = i + 1
    }
}

fn cell_index(s: *AqShare, gx: i32, gy: i32, gz: i32) -> i32 {
    let a: i32 = gx - (*s).base_gx
    let b: i32 = gy - (*s).min_gy
    let c: i32 = gz - (*s).base_gz
    if a < 0 || a >= SHARE_X || c < 0 || c >= SHARE_Z || b < 0 || b >= SHARE_Y {
        return 0 - 1
    }
    return (c * SHARE_X + a) * SHARE_Y + b
}

fn share_get(s: *AqShare, gx: i32, gy: i32, gz: i32, out: *mut wgdf_fluid.Fluid) -> bool {
    let at: i32 = cell_index(s, gx, gy, gz)
    if at < 0 {
        return false
    }
    let u: usize = at as usize
    if __atomic_add((&(*s).state[u]) as *mut u64, 0) != CELL_READY {
        return false
    }
    *out = wgdf_fluid.Fluid { level: (*s).level[u], ty: (*s).ty[u] }
    return true
}

fn share_put(s: *mut AqShare, gx: i32, gy: i32, gz: i32, f: wgdf_fluid.Fluid) {
    let at: i32 = cell_index(s, gx, gy, gz)
    if at < 0 {
        return
    }
    let u: usize = at as usize
    let p: *mut u64 = (&(*s).state[u]) as *mut u64
    if __atomic_swap(p, CELL_EMPTY, CELL_BUSY) == CELL_EMPTY {
        (*s).level[u] = f.level
        (*s).ty[u] = f.ty
        __atomic_add(p, 1)
    }
}

fn prelim_index(s: *AqShare, qx: i32, qz: i32) -> i32 {
    let a: i32 = qx - (*s).base_qx
    let c: i32 = qz - (*s).base_qz
    if a < 0 || a >= PRELIM_SIDE || c < 0 || c >= PRELIM_SIDE {
        return 0 - 1
    }
    return c * PRELIM_SIDE + a
}

fn prelim_get(s: *AqShare, qx: i32, qz: i32, out: *mut i32) -> bool {
    let at: i32 = prelim_index(s, qx, qz)
    if at < 0 {
        return false
    }
    let u: usize = at as usize
    if __atomic_add((&(*s).pstate[u]) as *mut u64, 0) != CELL_READY {
        return false
    }
    *out = (*s).pval[u]
    return true
}

fn prelim_put(s: *mut AqShare, qx: i32, qz: i32, v: i32) {
    let at: i32 = prelim_index(s, qx, qz)
    if at < 0 {
        return
    }
    let u: usize = at as usize
    let p: *mut u64 = (&(*s).pstate[u]) as *mut u64
    if __atomic_swap(p, CELL_EMPTY, CELL_BUSY) == CELL_EMPTY {
        (*s).pval[u] = v
        __atomic_add(p, 1)
    }
}
