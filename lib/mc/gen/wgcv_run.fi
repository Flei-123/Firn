import std.rt
import mc.gen.mg_random
import mc.gen.wgdf_graph
import mc.gen.wgdf_eval
import mc.gen.wgdf_aquifer
import mc.gen.wgbio_source
import mc.gen.wgsr_ctx
import mc.gen.wgcv_def
import mc.gen.wgcv_apply
import mc.gen.wgcv_cave
import mc.gen.wgcv_canyon

export { carve_chunk, START_CACHE_SLOTS }

const RADIUS: i32 = 8
const START_CACHE_SLOTS: usize = 16384
const COORD_MASK: u64 = 268435455

fn set_large_feature_seed(r: *mut mg_random.Rng, seed: i64, sx: i32, sz: i32) {
    mg_random.rng_set_seed(r, seed)
    let a: i64 = mg_random.rng_next_long(r)
    let b: i64 = mg_random.rng_next_long(r)
    mg_random.rng_set_seed(r, (((sx as i64) *% a) ^ ((sz as i64) *% b)) ^ seed)
}

fn cache_slot(cache: u64, sx: i32, sz: i32) -> u64 {
    let h: u64 = (((sx as i64) *% 73856093) ^ ((sz as i64) *% 19349663)) as% u64
    return cache + ((h % (START_CACHE_SLOTS as u64)) * 8)
}

fn start_biome(bs: *mut wgbio_source.BioSource, g: *wgdf_graph.WgGraph, ns: *wgdf_eval.WgNoises, cache: u64, sx: i32, sz: i32) -> usize {
    let ux: u64 = ((sx as i64) as% u64) & COORD_MASK
    let uz: u64 = ((sz as i64) as% u64) & COORD_MASK
    let tag: u64 = (ux << 36) | (uz << 8)
    if cache != 0 {
        let e: u64 = *(cache_slot(cache, sx, sz) as *u64)
        if (e >> 8) == (tag >> 8) && (e & 255) != 0 { return ((e & 255) - 1) as usize }
    }
    let b: usize = wgbio_source.bio_sample(bs, g, ns, sx * 4, 0, sz * 4)
    if cache != 0 { *(cache_slot(cache, sx, sz) as *mut u64) = tag | ((b as u64) + 1) }
    return b
}

fn carve_chunk(cv: *wgcv_def.CvDef, c: *mut wgsr_ctx.SrCtx, g: *wgdf_graph.WgGraph, ns: *wgdf_eval.WgNoises, bs: *mut wgbio_source.BioSource, seed: i64, cx: i32, cz: i32, cache: u64) {
    var aq: *mut wgdf_aquifer.Aquifer = 0 as *mut wgdf_aquifer.Aquifer
    if (*g).aquifers { aq = wgdf_aquifer.aquifer_new(g, ns, cx * 16, cz * 16) }
    let mask_bytes: usize = ((*cv).height as usize) * 256
    let mask: u64 = rt.heap_alloc(mask_bytes)
    rt.mem_set(mask, 0 as u8, mask_bytes)
    var run: wgcv_apply.CvRun = wgcv_apply.CvRun { def: cv, car: &(*cv).carvers[0], c: c, g: g, ns: ns, aq: aq, mask: mask, cx: cx, cz: cz }
    var rng: mg_random.Rng = mg_random.rng_legacy(0)
    var dx: i32 = 0 - RADIUS
    while dx <= RADIUS {
        var dz: i32 = 0 - RADIUS
        while dz <= RADIUS {
            let sx: i32 = cx + dx
            let sz: i32 = cz + dz
            let b: usize = start_biome(bs, g, ns, cache, sx, sz)
            var k: usize = 0
            while k < ((*cv).bio_n[b] as usize) {
                let car: *wgcv_def.Carver = &(*cv).carvers[(*cv).bio_c[b][k] as usize]
                set_large_feature_seed(&rng, seed +% (k as i64), sx, sz)
                if mg_random.rng_next_float(&rng) <= (*car).prob {
                    run.car = car
                    if (*car).kind == wgcv_def.KIND_CANYON {
                        wgcv_canyon.canyon_carve(&run, &rng, sx, sz)
                    } else {
                        wgcv_cave.cave_carve(&run, &rng, sx, sz)
                    }
                }
                k = k + 1
            }
            dz = dz + 1
        }
        dx = dx + 1
    }
    rt.heap_free(mask, mask_bytes)
    if aq != (0 as *mut wgdf_aquifer.Aquifer) { wgdf_aquifer.aquifer_free(aq) }
}
