import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_endput

export { place }

fn kind_at(r: *wgft_region.Region, x: i32, y: i32, z: i32) -> u8 {
    return (*(*r).ft).end_kind[wgft_region.block_at(r, x, y, z) as usize]
}

fn is_chorus(k: u8) -> bool {
    return k == wgft_def.EK_CHORUS_PLANT || k == wgft_def.EK_CHORUS_FLOWER
}

fn bit(cond: bool, shift: usize) -> usize {
    if cond { return (1 as usize) << shift }
    return 0
}

fn state_at(r: *wgft_region.Region, x: i32, y: i32, z: i32) -> u16 {
    let below: u8 = kind_at(r, x, y - 1, z)
    let down: bool = is_chorus(below) || below == wgft_def.EK_END_STONE
    let idx: usize = bit(down, 0) | bit(is_chorus(kind_at(r, x + 1, y, z)), 1) | bit(is_chorus(kind_at(r, x, y, z - 1)), 2) | bit(is_chorus(kind_at(r, x, y, z + 1)), 3) | bit(is_chorus(kind_at(r, x, y + 1, z)), 4) | bit(is_chorus(kind_at(r, x - 1, y, z)), 5)
    return (*(*r).ft).end_chorus[idx]
}

fn put_state(r: *mut wgft_region.Region, x: i32, y: i32, z: i32) {
    wgft_endput.put(r, x, y, z, state_at(r, x, y, z))
}

fn dir_x(d: i32) -> i32 {
    if d == 1 { return 1 }
    if d == 3 { return 0 - 1 }
    return 0
}

fn dir_z(d: i32) -> i32 {
    if d == 0 { return 0 - 1 }
    if d == 2 { return 1 }
    return 0
}

fn neighbours_empty(r: *wgft_region.Region, x: i32, y: i32, z: i32, skip: i32) -> bool {
    var d: i32 = 0
    while d < 4 {
        if d != skip && !wgft_endput.is_air(r, x + dir_x(d), y, z + dir_z(d)) { return false }
        d = d + 1
    }
    return true
}

fn abs_i(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

fn grow(c: *wgft_ctx.PlaceCtx, bx: i32, by: i32, bz: i32, ox: i32, oz: i32, spread: i32, depth: i32) {
    let r: *mut wgft_region.Region = (*c).r
    var height: i32 = mg_random.rng_next_int_bound((*c).rng, 4) + 1
    if depth == 0 { height = height + 1 }
    var j: i32 = 0
    while j < height {
        let py: i32 = by + j + 1
        if !neighbours_empty(r, bx, py, bz, 0 - 1) { return }
        put_state(r, bx, py, bz)
        put_state(r, bx, py - 1, bz)
        j = j + 1
    }
    var grown: bool = false
    if depth < 4 {
        var branches: i32 = mg_random.rng_next_int_bound((*c).rng, 4)
        if depth == 0 { branches = branches + 1 }
        var k: i32 = 0
        while k < branches {
            let d: i32 = mg_random.rng_next_int_bound((*c).rng, 4)
            let px: i32 = bx + dir_x(d)
            let py: i32 = by + height
            let pz: i32 = bz + dir_z(d)
            let back: i32 = (d + 2) % 4
            if abs_i(px - ox) < spread && abs_i(pz - oz) < spread && wgft_endput.is_air(r, px, py, pz) && wgft_endput.is_air(r, px, py - 1, pz) && neighbours_empty(r, px, py, pz, back) {
                grown = true
                put_state(r, px, py, pz)
                put_state(r, px + dir_x(back), py, pz + dir_z(back))
                grow(c, px, py, pz, ox, oz, spread, depth + 1)
            }
            k = k + 1
        }
    }
    if !grown { wgft_endput.put(r, bx, by + height, bz, (*(*r).ft).end_flower) }
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    if !wgft_endput.is_air(r, x, y, z) { return false }
    if kind_at(r, x, y - 1, z) != wgft_def.EK_END_STONE { return false }
    put_state(r, x, y, z)
    grow(c, x, y, z, x, z, 8, 0)
    return true
}
