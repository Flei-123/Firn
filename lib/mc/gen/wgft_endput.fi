import mc.gen.wgft_region

export { put, is_air }

fn put(r: *mut wgft_region.Region, x: i32, y: i32, z: i32, code: u16) {
    if wgft_region.can_write(r, x, z) { wgft_region.set_block(r, x, y, z, code) }
}

fn is_air(r: *wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    return (*(*r).ft).air[wgft_region.block_at(r, x, y, z) as usize]
}
