fn def_bytes() -> usize {
    return wgdf_graph.wg_size_of[FtDef]()
}

fn def_new(min_y: i32, height: i32) -> *mut FtDef {
    let d: *mut FtDef = rt.heap_alloc(def_bytes()) as *mut FtDef
    rt.mem_set(d as u64, 0 as u8, def_bytes())
    (*d).min_y = min_y
    (*d).height = height
    wgmth.sin_fill((&(*d).sin[0]) as u64)
    return d
}

fn def_free(d: *mut FtDef) {
    rt.heap_free(d as u64, def_bytes())
}

fn find_feat(d: *FtDef, p: u64, n: usize) -> i32 {
    var i: usize = 0
    while i < (*d).n {
        if (*d).flen[i] == n && rt.mem_eq((&(*d).fname[i][0]) as u64, p, n) { return i as i32 }
        i = i + 1
    }
    return 0 - 1
}
