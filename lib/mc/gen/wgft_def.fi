export {
    Op, Pred, Feat, FtDef, TreeCfg, MAX_TREES, MAX_FAMS, MAX_FEATS, MAX_SUBS, MAX_OPS, MAX_TARGETS, MAX_BIOMES, MAX_PREDS, MAX_MASKS, MASK_WORDS,
    OP_COUNT, OP_COUNT_UNIFORM, OP_SQUARE, OP_RARITY, OP_HEIGHT_UNIFORM, OP_HEIGHT_TRAPEZOID, OP_BIOME,
    OP_HEIGHTMAP, OP_RANDOM_OFFSET, OP_NOISE_THRESHOLD, OP_NOISE_BASED, OP_WATER_DEPTH, OP_PRED_FILTER, OP_ENV_SCAN, OP_SURF_REL,
    PK_TRUE, PK_MATCH, PK_NOT, PK_ANY, PK_ALL, PK_SOLID, PK_WATER, PK_INSIDE, PK_SURVIVE,
    FK_ORE, FK_SCATTERED, FK_SIMPLE_BLOCK, FK_PATCH, FK_DISK, FK_SPRING, FK_FREEZE, FK_LAKE, FK_TREE, FK_SELECTOR,
    TK_STRAIGHT, FL_BLOB, FL_SPRUCE, FL_PINE, OP_COUNT_WEIGHTED, MAX_WEIGHTS, MAX_SELECT_CHILDREN,
    HM_FLOOR, HM_SURFACE, HM_MOTION, HM_MOTION_NO_LEAVES, HM_KINDS,
    def_bytes, def_new, def_free, find_feat,
}

const MAX_FEATS: usize = 128
const MAX_SUBS: usize = 96
const MAX_TREES: usize = 32
const MAX_FAMS: usize = 12
const MAX_SELECT_CHILDREN: usize = 4
const MAX_WEIGHTS: usize = 4
const MAX_OPS: usize = 8
const MAX_TARGETS: usize = 2
const MAX_BIOMES: usize = 96
const MAX_PREDS: usize = 96
const MAX_MASKS: usize = 64
const MASK_WORDS: usize = 2

const OP_COUNT: u8 = 0
const OP_COUNT_UNIFORM: u8 = 1
const OP_SQUARE: u8 = 2
const OP_RARITY: u8 = 3
const OP_HEIGHT_UNIFORM: u8 = 4
const OP_HEIGHT_TRAPEZOID: u8 = 5
const OP_BIOME: u8 = 6
const OP_HEIGHTMAP: u8 = 7
const OP_RANDOM_OFFSET: u8 = 8
const OP_NOISE_THRESHOLD: u8 = 9
const OP_NOISE_BASED: u8 = 10
const OP_WATER_DEPTH: u8 = 11
const OP_PRED_FILTER: u8 = 12
const OP_ENV_SCAN: u8 = 13
const OP_SURF_REL: u8 = 14
const OP_COUNT_WEIGHTED: u8 = 15

const PK_TRUE: u8 = 0
const PK_MATCH: u8 = 1
const PK_NOT: u8 = 2
const PK_ANY: u8 = 3
const PK_ALL: u8 = 4
const PK_SOLID: u8 = 5
const PK_WATER: u8 = 6
const PK_INSIDE: u8 = 7
const PK_SURVIVE: u8 = 8

const FK_ORE: u8 = 0
const FK_SCATTERED: u8 = 1
const FK_SIMPLE_BLOCK: u8 = 2
const FK_PATCH: u8 = 3
const FK_DISK: u8 = 4
const FK_SPRING: u8 = 5
const FK_FREEZE: u8 = 6
const FK_LAKE: u8 = 7
const FK_TREE: u8 = 8
const FK_SELECTOR: u8 = 9

const TK_STRAIGHT: u8 = 0
const FL_BLOB: u8 = 0
const FL_SPRUCE: u8 = 1
const FL_PINE: u8 = 2

const HM_FLOOR: usize = 0
const HM_SURFACE: usize = 1
const HM_MOTION: usize = 2
const HM_MOTION_NO_LEAVES: usize = 3
const HM_KINDS: usize = 4

struct Op {
    kind: u8,
    a: i32,
    b: i32,
    c: i32,
    d: i32,
    e: i32,
    f: f64,
    g: f64,
    w: [i32; 4],
    v: [i32; 4],
}

struct Pred {
    kind: u8,
    mask: i32,
    ox: i32,
    oy: i32,
    oz: i32,
    n: usize,
    kids: [i32; 4],
}

struct Feat {
    step: i32,
    index: i32,
    kind: u8,
    size: i32,
    discard: f32,
    nops: usize,
    ops: [Op; 8],
    ntargets: usize,
    out_code: [u8; 2],
    test: [[bool; 256]; 2],
    p: [i32; 8],
    surv: i32,
    double_plant: bool,
    nrules: usize,
    rule_pred: [i32; 2],
    rule_code: [u8; 2],
    fallback: u8,
    sel_chance: [f32; 4],
}

struct TreeCfg {
    trunk: u8,
    fol: u8,
    base: i32,
    rand_a: i32,
    rand_b: i32,
    rad_lo: i32,
    rad_hi: i32,
    rad_uni: bool,
    off_lo: i32,
    off_hi: i32,
    off_uni: bool,
    h_lo: i32,
    h_hi: i32,
    h_uni: bool,
    fs_limit: i32,
    fs_lower: i32,
    fs_upper: i32,
    fs_clip: i32,
    trunk_code: u8,
    dirt_code: u8,
    fam: i32,
    force_dirt: bool,
}

struct FtDef {
    n: usize,
    nsubs: usize,
    npreds: usize,
    nmasks: usize,
    feats: [Feat; 128],
    subs: [Feat; 96],
    preds: [Pred; 96],
    masks: [[bool; 256]; 64],
    fname: [[u8; 40]; 128],
    flen: [usize; 128],
    nbio: usize,
    bmask: [[u64; 2]; 96],
    min_y: i32,
    height: i32,
    zoom_seed: i64,
    motion: [bool; 256],
    air: [bool; 256],
    fluid: [bool; 256],
    leaves: [bool; 256],
    dirt: [bool; 256],
    dry: [bool; 256],
    full_top: [bool; 256],
    no_replace: [bool; 256],
    lava_keep: [bool; 256],
    cave_air_code: u8,
    water_code: u8,
    air_code: u8,
    snow_code: u8,
    ice_code: u8,
    trees: [TreeCfg; 32],
    ntrees: usize,
    nfams: usize,
    fam_code: [[u8; 8]; 12],
    leaf_dist: [u8; 256],
    leaf_fam: [u8; 256],
    tree_ok: [bool; 256],
    tree_dirt: [bool; 256],
    logs: [bool; 256],
    sd: u64,
    sin: [f32; 65536],
}

fn def_bytes() -> usize {
    return wgdf_graph.wg_size_of[FtDef]()
}

fn def_new(min_y: i32, height: i32) -> *mut FtDef {
    let d: *mut FtDef = rt.heap_alloc(def_bytes()) as *mut FtDef
    rt.mem_set(d as u64, 0 as u8, def_bytes())
    (*d).min_y = min_y
    (*d).height = height
    wgmth.sin_fill((&(*d).sin[0]) as u64)
    return d
}

fn def_free(d: *mut FtDef) {
    rt.heap_free(d as u64, def_bytes())
}

fn find_feat(d: *FtDef, p: u64, n: usize) -> i32 {
    var i: usize = 0
    while i < (*d).n {
        if (*d).flen[i] == n && rt.mem_eq((&(*d).fname[i][0]) as u64, p, n) { return i as i32 }
        i = i + 1
    }
    return 0 - 1
}
