import std.rt
import mc.gen.wgdf_graph
import mc.gen.wgmth

export {
    Op, Feat, FtDef, MAX_FEATS, MAX_OPS, MAX_TARGETS, MAX_BIOMES,
    OP_COUNT, OP_COUNT_UNIFORM, OP_SQUARE, OP_RARITY, OP_HEIGHT_UNIFORM, OP_HEIGHT_TRAPEZOID, OP_BIOME,
    def_bytes, def_new, def_free, find_feat,
}

const MAX_FEATS: usize = 48
const MAX_OPS: usize = 6
const MAX_TARGETS: usize = 2
const MAX_BIOMES: usize = 96

const OP_COUNT: u8 = 0
const OP_COUNT_UNIFORM: u8 = 1
const OP_SQUARE: u8 = 2
const OP_RARITY: u8 = 3
const OP_HEIGHT_UNIFORM: u8 = 4
const OP_HEIGHT_TRAPEZOID: u8 = 5
const OP_BIOME: u8 = 6

struct Op {
    kind: u8,
    a: i32,
    b: i32,
}

struct Feat {
    step: i32,
    index: i32,
    scattered: bool,
    size: i32,
    discard: f32,
    nops: usize,
    ops: [Op; 6],
    ntargets: usize,
    out_code: [u8; 2],
    test: [[bool; 256]; 2],
}

struct FtDef {
    n: usize,
    feats: [Feat; 48],
    fname: [[u8; 40]; 48],
    flen: [usize; 48],
    nbio: usize,
    bmask: [u64; 96],
    min_y: i32,
    height: i32,
    zoom_seed: i64,
    motion: [bool; 256],
    air: [bool; 256],
    sin: [f32; 65536],
}

fn def_bytes() -> usize {
    return wgdf_graph.wg_size_of[FtDef]()
}

fn def_new(min_y: i32, height: i32) -> *mut FtDef {
    let d: *mut FtDef = rt.heap_alloc(def_bytes()) as *mut FtDef
    rt.mem_set(d as u64, 0 as u8, def_bytes())
    (*d).min_y = min_y
    (*d).height = height
    wgmth.sin_fill((&(*d).sin[0]) as u64)
    return d
}

fn def_free(d: *mut FtDef) {
    rt.heap_free(d as u64, def_bytes())
}

fn find_feat(d: *FtDef, p: u64, n: usize) -> i32 {
    var i: usize = 0
    while i < (*d).n {
        if (*d).flen[i] == n && rt.mem_eq((&(*d).fname[i][0]) as u64, p, n) { return i as i32 }
        i = i + 1
    }
    return 0 - 1
}
