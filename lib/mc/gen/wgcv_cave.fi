// SPDX-License-Identifier: MPL-2.0
import mc.gen.mg_random
import mc.gen.wgcv_def
import mc.gen.wgcv_prov
import mc.gen.wgcv_apply

export { cave_carve }

const RANGE_BLOCKS: i32 = 112

#[allow_fp]
fn can_reach(run: *wgcv_apply.CvRun, x: f64, z: f64, i: i32, len: i32, th: f32) -> bool {
    let dx: f64 = x - (((*run).cx * 16 + 8) as f64)
    let dz: f64 = z - (((*run).cz * 16 + 8) as f64)
    let dl: f64 = (len - i) as f64
    let r: f64 = (th + 2.0f + 16.0f) as f64
    return dx * dx + dz * dz - dl * dl <= r * r
}

#[allow_fp]
fn tunnel(run: *wgcv_apply.CvRun, seed: i64, x0: f64, y0: f64, z0: f64, hr: f64, vr: f64, th: f32, yaw0: f32, pitch0: f32, from: i32, len: i32, yscale: f64, sk: *wgcv_apply.Skip) {
    let d: *wgcv_def.CvDef = (*run).def
    let pi: f32 = 3.1415927f
    let half_pi: f32 = 1.5707964f
    var r: mg_random.Rng = mg_random.rng_legacy(seed)
    let branch_at: i32 = mg_random.rng_next_int_bound(&r, len / 2) + len / 4
    let steep: bool = mg_random.rng_next_int_bound(&r, 6) == 0
    var x: f64 = x0
    var y: f64 = y0
    var z: f64 = z0
    var yaw: f32 = yaw0
    var pitch: f32 = pitch0
    var yaw_d: f32 = 0.0f
    var pitch_d: f32 = 0.0f
    var i: i32 = from
    while i < len {
        let rad: f64 = 1.5 + (wgcv_def.sin_f(d, pi * (i as f32) / (len as f32)) * th) as f64
        let vrad: f64 = rad * yscale
        let cp: f32 = wgcv_def.cos_f(d, pitch)
        x = x + (wgcv_def.cos_f(d, yaw) * cp) as f64
        y = y + wgcv_def.sin_f(d, pitch) as f64
        z = z + (wgcv_def.sin_f(d, yaw) * cp) as f64
        if steep { pitch = pitch * 0.92f } else { pitch = pitch * 0.7f }
        pitch = pitch + pitch_d * 0.1f
        yaw = yaw + yaw_d * 0.1f
        pitch_d = pitch_d * 0.9f
        yaw_d = yaw_d * 0.75f
        let a1: f32 = mg_random.rng_next_float(&r)
        let a2: f32 = mg_random.rng_next_float(&r)
        let a3: f32 = mg_random.rng_next_float(&r)
        pitch_d = pitch_d + (a1 - a2) * a3 * 2.0f
        let b1: f32 = mg_random.rng_next_float(&r)
        let b2: f32 = mg_random.rng_next_float(&r)
        let b3: f32 = mg_random.rng_next_float(&r)
        yaw_d = yaw_d + (b1 - b2) * b3 * 4.0f
        if i == branch_at && th > 1.0f {
            let s1: i64 = mg_random.rng_next_long(&r)
            let t1: f32 = mg_random.rng_next_float(&r) * 0.5f + 0.5f
            tunnel(run, s1, x, y, z, hr, vr, t1, yaw - half_pi, pitch / 3.0f, i, len, 1.0, sk)
            let s2: i64 = mg_random.rng_next_long(&r)
            let t2: f32 = mg_random.rng_next_float(&r) * 0.5f + 0.5f
            tunnel(run, s2, x, y, z, hr, vr, t2, yaw + half_pi, pitch / 3.0f, i, len, 1.0, sk)
            return
        }
        if mg_random.rng_next_int_bound(&r, 4) != 0 {
            if !can_reach(run, x, z, i, len, th) { return }
            wgcv_apply.carve_ellipsoid(run, x, y, z, rad * hr, vrad * vr, sk)
        }
        i = i + 1
    }
}

#[allow_fp]
fn thickness(r: *mut mg_random.Rng, nether: bool) -> f32 {
    let a: f32 = mg_random.rng_next_float(r)
    let b: f32 = mg_random.rng_next_float(r)
    if nether { return (a * 2.0f + b) * 2.0f }
    var t: f32 = a * 2.0f + b
    if mg_random.rng_next_int_bound(r, 10) == 0 {
        let c: f32 = mg_random.rng_next_float(r)
        let e: f32 = mg_random.rng_next_float(r)
        t = t * (c * e * 3.0f + 1.0f)
    }
    return t
}

#[allow_fp]
fn cave_carve(run: *wgcv_apply.CvRun, r: *mut mg_random.Rng, cx: i32, cz: i32) {
    let car: *wgcv_def.Carver = (*run).car
    let nether: bool = (*car).kind == wgcv_def.KIND_NETHER
    var bound: i32 = 15
    if nether { bound = 10 }
    let count: i32 = mg_random.rng_next_int_bound(r, mg_random.rng_next_int_bound(r, mg_random.rng_next_int_bound(r, bound) + 1) + 1)
    let two_pi: f32 = 6.2831855f
    let half_pi: f32 = 1.5707964f
    var yscale_main: f64 = 1.0
    if nether { yscale_main = 5.0 }
    var n: i32 = 0
    while n < count {
        let x: f64 = (cx * 16 + mg_random.rng_next_int_bound(r, 16)) as f64
        let y: f64 = wgcv_prov.sample_y_uniform(r, (*car).y_lo, (*car).y_hi) as f64
        let z: f64 = (cz * 16 + mg_random.rng_next_int_bound(r, 16)) as f64
        let hr: f64 = wgcv_prov.fp_sample(r, &(*car).hr) as f64
        let vr: f64 = wgcv_prov.fp_sample(r, &(*car).vr) as f64
        let floor: f64 = wgcv_prov.fp_sample(r, &(*car).floor) as f64
        let sk: wgcv_apply.Skip = wgcv_apply.Skip { kind: wgcv_apply.SKIP_CAVE, floor: floor, factors: 0 as u64 }
        var tunnels: i32 = 1
        if mg_random.rng_next_int_bound(r, 4) == 0 {
            let ys: f64 = wgcv_prov.fp_sample(r, &(*car).yscale) as f64
            let radius: f32 = 1.0f + mg_random.rng_next_float(r) * 6.0f
            let rr: f64 = 1.5 + (wgcv_def.sin_f((*run).def, half_pi) * radius) as f64
            wgcv_apply.carve_ellipsoid(run, x + 1.0, y, z, rr, rr * ys, &sk)
            tunnels = tunnels + mg_random.rng_next_int_bound(r, 4)
        }
        var t: i32 = 0
        while t < tunnels {
            let yaw: f32 = mg_random.rng_next_float(r) * two_pi
            let pitch: f32 = (mg_random.rng_next_float(r) - 0.5f) / 4.0f
            let th: f32 = thickness(r, nether)
            let len: i32 = RANGE_BLOCKS - mg_random.rng_next_int_bound(r, RANGE_BLOCKS / 4)
            let seed: i64 = mg_random.rng_next_long(r)
            tunnel(run, seed, x, y, z, hr, vr, th, yaw, pitch, 0, len, yscale_main, &sk)
            t = t + 1
        }
        n = n + 1
    }
}
