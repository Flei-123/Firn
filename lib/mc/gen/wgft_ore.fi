import mc.gen.mg_random
import mc.gen.wgmth
import mc.gen.wgft_def
import mc.gen.wgft_region
import std.math
import noise.jnum

export { place_ore, place_scattered }

const MAX_SIZE: usize = 64

#[allow_fp]
fn ceil_f32(f: f32) -> i32 {
    let i: i32 = f as i32
    if f > (i as f32) { return i + 1 }
    return i
}

fn adjacent_to_air(r: *wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    let air: *[bool; 512] = &(*(*r).ft).air
    if (*air)[wgft_region.block_at(r, x - 1, y, z) as usize] { return true }
    if (*air)[wgft_region.block_at(r, x + 1, y, z) as usize] { return true }
    if (*air)[wgft_region.block_at(r, x, y - 1, z) as usize] { return true }
    if (*air)[wgft_region.block_at(r, x, y + 1, z) as usize] { return true }
    if (*air)[wgft_region.block_at(r, x, y, z - 1) as usize] { return true }
    return (*air)[wgft_region.block_at(r, x, y, z + 1) as usize]
}

#[allow_fp]
fn can_place(r: *wgft_region.Region, rng: *mut mg_random.Rng, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    var skip: bool = true
    if (*f).discard > 0.0f {
        if (*f).discard >= 1.0f {
            skip = false
        } else {
            skip = mg_random.rng_next_float(rng) >= (*f).discard
        }
    }
    if skip { return true }
    return !adjacent_to_air(r, x, y, z)
}

fn try_place(r: *mut wgft_region.Region, rng: *mut mg_random.Rng, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let cur: u16 = wgft_region.block_at(r, x, y, z)
    var t: usize = 0
    while t < (*f).ntargets {
        if (*f).test[t][cur as usize] && can_place(r, rng, f, x, y, z) {
            wgft_region.set_block(r, x, y, z, (*f).out_code[t])
            return true
        }
        t = t + 1
    }
    return false
}

fn if_max(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

#[allow_fp]
fn do_place(r: *mut wgft_region.Region, rng: *mut mg_random.Rng, f: *wgft_def.Feat, x0: f64, x1: f64, z0: f64, z1: f64, y0: f64, y1: f64, bx: i32, by: i32, bz: i32, w: i32, h: i32) {
    let n: i32 = (*f).size
    let pts: *mut [f64; 256] = &(*r).pts
    let sin: u64 = (&(*(*r).ft).sin[0]) as u64
    var i: i32 = 0
    while i < n {
        let t: f32 = (i as f32) / (n as f32)
        let td: f64 = t as f64
        let px: f64 = x0 + td * (x1 - x0)
        let py: f64 = y0 + td * (y1 - y0)
        let pz: f64 = z0 + td * (z1 - z0)
        let d: f64 = mg_random.rng_next_double(rng) * (n as f64) / 16.0
        let pi_f: f32 = 3.1415927f
        let s: f32 = wgmth.sin_lookup(sin, pi_f * t)
        let rad: f64 = (((s + 1.0f) as f64) * d + 1.0) / 2.0
        (*pts)[(i * 4) as usize] = px
        (*pts)[(i * 4 + 1) as usize] = py
        (*pts)[(i * 4 + 2) as usize] = pz
        (*pts)[(i * 4 + 3) as usize] = rad
        i = i + 1
    }
    var a: i32 = 0
    while a < n - 1 {
        if !((*pts)[(a * 4 + 3) as usize] <= 0.0) {
            var b: i32 = a + 1
            while b < n {
                if !((*pts)[(b * 4 + 3) as usize] <= 0.0) {
                    let dx: f64 = (*pts)[(a * 4) as usize] - (*pts)[(b * 4) as usize]
                    let dy: f64 = (*pts)[(a * 4 + 1) as usize] - (*pts)[(b * 4 + 1) as usize]
                    let dz: f64 = (*pts)[(a * 4 + 2) as usize] - (*pts)[(b * 4 + 2) as usize]
                    let dr: f64 = (*pts)[(a * 4 + 3) as usize] - (*pts)[(b * 4 + 3) as usize]
                    if dr * dr > dx * dx + dy * dy + dz * dz {
                        if dr > 0.0 {
                            (*pts)[(b * 4 + 3) as usize] = 0.0 - 1.0
                        } else {
                            (*pts)[(a * 4 + 3) as usize] = 0.0 - 1.0
                        }
                    }
                }
                b = b + 1
            }
        }
        a = a + 1
    }
    wgft_region.vis_begin(r)
    let top: i32 = (*r).min_y + (*r).height
    var j: i32 = 0
    while j < n {
        let rad: f64 = (*pts)[(j * 4 + 3) as usize]
        if !(rad < 0.0) {
            let cx: f64 = (*pts)[(j * 4) as usize]
            let cy: f64 = (*pts)[(j * 4 + 1) as usize]
            let cz: f64 = (*pts)[(j * 4 + 2) as usize]
            let lx: i32 = if_max(jnum.floor_i32(cx - rad), bx)
            let ly: i32 = if_max(jnum.floor_i32(cy - rad), by)
            let lz: i32 = if_max(jnum.floor_i32(cz - rad), bz)
            let hx: i32 = if_max(jnum.floor_i32(cx + rad), lx)
            let hy: i32 = if_max(jnum.floor_i32(cy + rad), ly)
            let hz: i32 = if_max(jnum.floor_i32(cz + rad), lz)
            var x: i32 = lx
            while x <= hx {
                let ex: f64 = (((x as f64) + 0.5) - cx) / rad
                if ex * ex < 1.0 {
                    var y: i32 = ly
                    while y <= hy {
                        let ey: f64 = (((y as f64) + 0.5) - cy) / rad
                        if ex * ex + ey * ey < 1.0 {
                            var z: i32 = lz
                            while z <= hz {
                                let ez: f64 = (((z as f64) + 0.5) - cz) / rad
                                if ex * ex + ey * ey + ez * ez < 1.0 && y >= (*r).min_y && y < top {
                                    let idx: i32 = (x - bx) + (y - by) * w + (z - bz) * w * h
                                    if !wgft_region.vis_test_set(r, idx) && wgft_region.can_write(r, x, z) {
                                        try_place(r, rng, f, x, y, z)
                                    }
                                }
                                z = z + 1
                            }
                        }
                        y = y + 1
                    }
                }
                x = x + 1
            }
        }
        j = j + 1
    }
}

#[allow_fp]
fn place_ore(r: *mut wgft_region.Region, rng: *mut mg_random.Rng, f: *wgft_def.Feat, x: i32, y: i32, z: i32) {
    let pi_f: f32 = 3.1415927f
    let ang: f32 = mg_random.rng_next_float(rng) * pi_f
    let sz: f32 = ((*f).size as f32) / 8.0f
    let q: i32 = ceil_f32(((((*f).size as f32) / 16.0f) * 2.0f + 1.0f) / 2.0f)
    let sn: f64 = math.sin(ang as f64) * (sz as f64)
    let cs: f64 = math.cos(ang as f64) * (sz as f64)
    let x0: f64 = (x as f64) + sn
    let x1: f64 = (x as f64) - sn
    let z0: f64 = (z as f64) + cs
    let z1: f64 = (z as f64) - cs
    let y0: f64 = ((y + mg_random.rng_next_int_bound(rng, 3) - 2) as i32) as f64
    let y1: f64 = ((y + mg_random.rng_next_int_bound(rng, 3) - 2) as i32) as f64
    let cz: i32 = ceil_f32(sz)
    let bx: i32 = x - cz - q
    let by: i32 = y - 2 - q
    let bz: i32 = z - cz - q
    let w: i32 = 2 * (cz + q)
    let h: i32 = 2 * (2 + q)
    var ix: i32 = bx
    while ix <= bx + w {
        var iz: i32 = bz
        while iz <= bz + w {
            if by <= wgft_region.floor_open(r, ix, iz) {
                do_place(r, rng, f, x0, x1, z0, z1, y0, y1, bx, by, bz, w, h)
                return
            }
            iz = iz + 1
        }
        ix = ix + 1
    }
}

#[allow_fp]
fn offset_one(rng: *mut mg_random.Rng, k: i32) -> i32 {
    let a: f32 = mg_random.rng_next_float(rng)
    let b: f32 = mg_random.rng_next_float(rng)
    let v: f64 = ((a - b) * (k as f32)) as f64 + 0.5
    return jnum.floor_i32(v)
}

fn place_scattered(r: *mut wgft_region.Region, rng: *mut mg_random.Rng, f: *wgft_def.Feat, x: i32, y: i32, z: i32) {
    let cnt: i32 = mg_random.rng_next_int_bound(rng, (*f).size + 1)
    var i: i32 = 0
    while i < cnt {
        var k: i32 = i
        if k > 7 { k = 7 }
        let ox: i32 = offset_one(rng, k)
        let oy: i32 = offset_one(rng, k)
        let oz: i32 = offset_one(rng, k)
        let px: i32 = x + ox
        let py: i32 = y + oy
        let pz: i32 = z + oz
        let cur: u16 = wgft_region.block_at(r, px, py, pz)
        var t: usize = 0
        while t < (*f).ntargets {
            if (*f).test[t][cur as usize] && can_place(r, rng, f, px, py, pz) {
                if wgft_region.can_write(r, px, pz) && py >= (*r).min_y && py < (*r).min_y + (*r).height {
                    wgft_region.set_block(r, px, py, pz, (*f).out_code[t])
                }
                t = (*f).ntargets
            } else {
                t = t + 1
            }
        }
        i = i + 1
    }
}
