import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch
import mc.gen.wgmth

export { is_free, set_dirt, place_log, place_straight, place_forking, place_giant, place_dark_oak, place_mega_jungle }

fn is_free(ft: *wgft_def.FtDef, code: u8) -> bool {
    return (*ft).tree_ok[code as usize] || (*ft).logs[code as usize]
}

fn set_dirt(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, x: i32, y: i32, z: i32) {
    let ft: *wgft_def.FtDef = (*r).ft
    if (*t).force_dirt || !(*ft).tree_dirt[wgft_region.block_at(r, x, y, z) as usize] {
        wgft_region.set_block(r, x, y, z, (*t).dirt_code)
        wgft_tscratch.note_log(sc, x, y, z)
    }
}

fn place_log(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, code: u8, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    if !(*ft).tree_ok[wgft_region.block_at(r, x, y, z) as usize] { return false }
    wgft_region.set_block(r, x, y, z, code)
    wgft_tscratch.note_log(sc, x, y, z)
    return true
}

fn place_straight(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    set_dirt(r, sc, t, x, y - 1, z)
    var i: i32 = 0
    while i < free {
        place_log(r, sc, (*t).trunk_code, x, y + i, z)
        i = i + 1
    }
    wgft_tscratch.add_attach(sc, x, y + free, z, 0)
}

fn step_x(dir: i32) -> i32 {
    if dir == 1 { return 1 }
    if dir == 3 { return 0 - 1 }
    return 0
}

fn step_z(dir: i32) -> i32 {
    if dir == 0 { return 0 - 1 }
    if dir == 2 { return 1 }
    return 0
}

fn place_forking(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    set_dirt(r, sc, t, x, y - 1, z)
    let dir_a: i32 = mg_random.rng_next_int_bound(rng, 4)
    let bend_at: i32 = free - mg_random.rng_next_int_bound(rng, 4) - 1
    var bend_left: i32 = 3 - mg_random.rng_next_int_bound(rng, 3)
    var cx: i32 = x
    var cz: i32 = z
    var top: i32 = 0 - 1
    var i: i32 = 0
    while i < free {
        let cy: i32 = y + i
        if i >= bend_at && bend_left > 0 {
            cx = cx + step_x(dir_a)
            cz = cz + step_z(dir_a)
            bend_left = bend_left - 1
        }
        if place_log(r, sc, (*t).trunk_code, cx, cy, cz) { top = cy + 1 }
        i = i + 1
    }
    if top >= 0 { wgft_tscratch.add_attach(sc, cx, top, cz, 1) }
    cx = x
    cz = z
    let dir_b: i32 = mg_random.rng_next_int_bound(rng, 4)
    if dir_b == dir_a { return }
    let start: i32 = bend_at - mg_random.rng_next_int_bound(rng, 2) - 1
    var count: i32 = 1 + mg_random.rng_next_int_bound(rng, 3)
    top = 0 - 1
    var k: i32 = start
    while k < free && count > 0 {
        if k >= 1 {
            let cy: i32 = y + k
            cx = cx + step_x(dir_b)
            cz = cz + step_z(dir_b)
            if place_log(r, sc, (*t).trunk_code, cx, cy, cz) { top = cy + 1 }
        }
        k = k + 1
        count = count - 1
    }
    if top >= 0 { wgft_tscratch.add_attach(sc, cx, top, cz, 0) }
}

fn set_dirt_square(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, x: i32, y: i32, z: i32) {
    set_dirt(r, sc, t, x, y - 1, z)
    set_dirt(r, sc, t, x + 1, y - 1, z)
    set_dirt(r, sc, t, x, y - 1, z + 1)
    set_dirt(r, sc, t, x + 1, y - 1, z + 1)
}

fn place_giant(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    set_dirt_square(r, sc, t, x, y, z)
    var i: i32 = 0
    while i < free {
        place_log(r, sc, (*t).trunk_code, x, y + i, z)
        if i < free - 1 {
            place_log(r, sc, (*t).trunk_code, x + 1, y + i, z)
            place_log(r, sc, (*t).trunk_code, x + 1, y + i, z + 1)
            place_log(r, sc, (*t).trunk_code, x, y + i, z + 1)
        }
        i = i + 1
    }
    wgft_tscratch.add_attach_dbl(sc, x, y + free, z, 0, true)
}

fn air_or_leaves(r: *mut wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    let code: u8 = wgft_region.block_at(r, x, y, z)
    return (*ft).air[code as usize] || (*ft).leaves[code as usize]
}

fn place_dark_oak(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    set_dirt_square(r, sc, t, x, y, z)
    let dir: i32 = mg_random.rng_next_int_bound(rng, 4)
    let bend_at: i32 = free - mg_random.rng_next_int_bound(rng, 4)
    var bend_left: i32 = 2 - mg_random.rng_next_int_bound(rng, 3)
    var cx: i32 = x
    var cz: i32 = z
    let top_y: i32 = y + free - 1
    var i: i32 = 0
    while i < free {
        if i >= bend_at && bend_left > 0 {
            cx = cx + step_x(dir)
            cz = cz + step_z(dir)
            bend_left = bend_left - 1
        }
        let cy: i32 = y + i
        if air_or_leaves(r, cx, cy, cz) {
            place_log(r, sc, (*t).trunk_code, cx, cy, cz)
            place_log(r, sc, (*t).trunk_code, cx + 1, cy, cz)
            place_log(r, sc, (*t).trunk_code, cx, cy, cz + 1)
            place_log(r, sc, (*t).trunk_code, cx + 1, cy, cz + 1)
        }
        i = i + 1
    }
    wgft_tscratch.add_attach_dbl(sc, cx, top_y, cz, 0, true)
    var ax: i32 = 0 - 1
    while ax <= 2 {
        var az: i32 = 0 - 1
        while az <= 2 {
            if (ax < 0 || ax > 1 || az < 0 || az > 1) && mg_random.rng_next_int_bound(rng, 3) <= 0 {
                let len: i32 = mg_random.rng_next_int_bound(rng, 3) + 2
                var k: i32 = 0
                while k < len {
                    place_log(r, sc, (*t).trunk_code, x + ax, top_y - k - 1, z + az)
                    k = k + 1
                }
                wgft_tscratch.add_attach_dbl(sc, cx + ax, top_y, cz + az, 0, false)
            }
            az = az + 1
        }
        ax = ax + 1
    }
}

#[allow_fp]
fn place_mega_jungle(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    place_giant(r, sc, t, free, x, y, z)
    let tab: u64 = (&(*(*r).ft).sin[0]) as u64
    var h: i32 = free - 2 - mg_random.rng_next_int_bound(rng, 4)
    while h > free / 2 {
        let angle: f32 = mg_random.rng_next_float(rng) * 6.2831855f
        var px: i32 = 0
        var pz: i32 = 0
        var k: i32 = 0
        while k < 5 {
            px = (1.5f + wgmth.cos_lookup(tab, angle) * (k as f32)) as i32
            pz = (1.5f + wgmth.sin_lookup(tab, angle) * (k as f32)) as i32
            place_log(r, sc, (*t).trunk_code, x + px, y + h - 3 + k / 2, z + pz)
            k = k + 1
        }
        wgft_tscratch.add_attach_dbl(sc, x + px, y + h, z + pz, 0 - 2, false)
        h = h - (2 + mg_random.rng_next_int_bound(rng, 4))
    }
}
