import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch

export { is_free, set_dirt, place_log, place_straight, place_forking }

fn is_free(ft: *wgft_def.FtDef, code: u8) -> bool {
    return (*ft).tree_ok[code as usize] || (*ft).logs[code as usize]
}

fn set_dirt(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, x: i32, y: i32, z: i32) {
    let ft: *wgft_def.FtDef = (*r).ft
    if (*t).force_dirt || !(*ft).tree_dirt[wgft_region.block_at(r, x, y, z) as usize] {
        wgft_region.set_block(r, x, y, z, (*t).dirt_code)
        wgft_tscratch.note_log(sc, x, y, z)
    }
}

fn place_log(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, code: u8, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    if !(*ft).tree_ok[wgft_region.block_at(r, x, y, z) as usize] { return false }
    wgft_region.set_block(r, x, y, z, code)
    wgft_tscratch.note_log(sc, x, y, z)
    return true
}

fn place_straight(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    set_dirt(r, sc, t, x, y - 1, z)
    var i: i32 = 0
    while i < free {
        place_log(r, sc, (*t).trunk_code, x, y + i, z)
        i = i + 1
    }
    wgft_tscratch.add_attach(sc, x, y + free, z, 0)
}

fn step_x(dir: i32) -> i32 {
    if dir == 1 { return 1 }
    if dir == 3 { return 0 - 1 }
    return 0
}

fn step_z(dir: i32) -> i32 {
    if dir == 0 { return 0 - 1 }
    if dir == 2 { return 1 }
    return 0
}

fn place_forking(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    set_dirt(r, sc, t, x, y - 1, z)
    let dir_a: i32 = mg_random.rng_next_int_bound(rng, 4)
    let bend_at: i32 = free - mg_random.rng_next_int_bound(rng, 4) - 1
    var bend_left: i32 = 3 - mg_random.rng_next_int_bound(rng, 3)
    var cx: i32 = x
    var cz: i32 = z
    var top: i32 = 0 - 1
    var i: i32 = 0
    while i < free {
        let cy: i32 = y + i
        if i >= bend_at && bend_left > 0 {
            cx = cx + step_x(dir_a)
            cz = cz + step_z(dir_a)
            bend_left = bend_left - 1
        }
        if place_log(r, sc, (*t).trunk_code, cx, cy, cz) { top = cy + 1 }
        i = i + 1
    }
    if top >= 0 { wgft_tscratch.add_attach(sc, cx, top, cz, 1) }
    cx = x
    cz = z
    let dir_b: i32 = mg_random.rng_next_int_bound(rng, 4)
    if dir_b == dir_a { return }
    let start: i32 = bend_at - mg_random.rng_next_int_bound(rng, 2) - 1
    var count: i32 = 1 + mg_random.rng_next_int_bound(rng, 3)
    top = 0 - 1
    var k: i32 = start
    while k < free && count > 0 {
        if k >= 1 {
            let cy: i32 = y + k
            cx = cx + step_x(dir_b)
            cz = cz + step_z(dir_b)
            if place_log(r, sc, (*t).trunk_code, cx, cy, cz) { top = cy + 1 }
        }
        k = k + 1
        count = count - 1
    }
    if top >= 0 { wgft_tscratch.add_attach(sc, cx, top, cz, 0) }
}
