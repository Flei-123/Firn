import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_pred

export { CAND_SKIP, CAND_TRY, CAND_ABORT, candidate, place_dirt, place_roots }

const CAND_SKIP: i32 = 0
const CAND_TRY: i32 = 1
const CAND_ABORT: i32 = 2

fn space_for_tree(r: *mut wgft_region.Region, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    var i: i32 = 1
    while i <= (*f).p[0] {
        let code: u16 = wgft_region.block_at(r, x, y + i, z)
        if !(*ft).air[code as usize] && !((*ft).wet[code as usize] && i + 1 <= (*f).p[7]) { return false }
        i = i + 1
    }
    return true
}

fn candidate(r: *mut wgft_region.Region, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> i32 {
    let ft: *wgft_def.FtDef = (*r).ft
    if !wgft_pred.test(r, (*f).rule_pred[0], x, y, z) || !space_for_tree(r, f, x, y, z) { return CAND_SKIP }
    if !(*ft).motion[wgft_region.block_at(r, x, y - 1, z) as usize] { return CAND_ABORT }
    return CAND_TRY
}

fn offset(rng: *mut mg_random.Rng, bound: i32) -> i32 {
    let a: i32 = mg_random.rng_next_int_bound(rng, bound)
    let b: i32 = mg_random.rng_next_int_bound(rng, bound)
    return a - b
}

fn place_dirt(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32, top: i32) {
    let r: *mut wgft_region.Region = (*c).r
    var yy: i32 = y
    while yy < top {
        var t: i32 = 0
        while t < (*f).p[2] {
            let px: i32 = x + offset((*c).rng, (*f).p[1])
            let pz: i32 = z + offset((*c).rng, (*f).p[1])
            if (*f).test[0][wgft_region.block_at(r, px, yy, pz) as usize] { wgft_region.set_block(r, px, yy, pz, (*f).out_code[0]) }
            t = t + 1
        }
        yy = yy + 1
    }
}

fn place_roots(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    var t: i32 = 0
    while t < (*f).p[6] {
        let px: i32 = x + offset((*c).rng, (*f).p[4])
        let py: i32 = y + offset((*c).rng, (*f).p[5])
        let pz: i32 = z + offset((*c).rng, (*f).p[4])
        if (*ft).air[wgft_region.block_at(r, px, py, pz) as usize] && (*ft).solid[wgft_region.block_at(r, px, py + 1, pz) as usize] {
            wgft_region.set_block(r, px, py, pz, (*f).out_code[1])
        }
        t = t + 1
    }
}
