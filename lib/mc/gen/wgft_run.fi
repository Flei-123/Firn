import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_place

export { decorate }

fn set_decoration_seed(rng: *mut mg_random.Rng, seed: i64, x: i32, z: i32) -> i64 {
    mg_random.rng_set_seed(rng, seed)
    let a: i64 = mg_random.rng_next_long(rng) | 1
    let b: i64 = mg_random.rng_next_long(rng) | 1
    let s: i64 = (((x as i64) *% a) +% ((z as i64) *% b)) ^ seed
    mg_random.rng_set_seed(rng, s)
    return s
}

fn neighbour_mask(r: *wgft_region.Region, nx: i32, nz: i32) -> u64 {
    var m: u64 = 0 as u64
    var az: i32 = 0 - 1
    while az <= 1 {
        var ax: i32 = 0 - 1
        while ax <= 1 {
            m = m | wgft_region.present_mask(r, nx + ax, nz + az)
            ax = ax + 1
        }
        az = az + 1
    }
    return m
}

fn decorate(r: *mut wgft_region.Region, seed: i64, cx: i32, cz: i32) {
    let ft: *wgft_def.FtDef = (*r).ft
    var rng: mg_random.Rng = mg_random.rng_wrap(mg_random.rng_xoro(0))
    var c: wgft_place.PlaceCtx = wgft_place.PlaceCtx { r: r, rng: &rng, f: &(*ft).feats[0], fi: 0 }
    var dz: i32 = 0 - 1
    while dz <= 1 {
        var dx: i32 = 0 - 1
        while dx <= 1 {
            let nx: i32 = cx + dx
            let nz: i32 = cz + dz
            (*r).nx = nx
            (*r).nz = nz
            let base: i64 = set_decoration_seed(&rng, seed, nx * 16, nz * 16)
            let set: u64 = neighbour_mask(r, nx, nz)
            var i: usize = 0
            while i < (*ft).n {
                if ((set >> (i as u64)) & (1 as u64)) != (0 as u64) {
                    let f: *wgft_def.Feat = &(*ft).feats[i]
                    mg_random.rng_set_seed(&rng, base +% ((*f).index as i64) +% ((10000 * (*f).step) as i64))
                    c.f = f
                    c.fi = i as i32
                    wgft_place.run_feature(&c, nx * 16, (*r).min_y, nz * 16)
                }
                i = i + 1
            }
            dx = dx + 1
        }
        dz = dz + 1
    }
}
