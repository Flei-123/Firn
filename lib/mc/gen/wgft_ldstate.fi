import std.rt
import std.json
import std.jsonstr
import noise.perlin
import mc.gen.mg_random
import mc.gen.mg_noise
import mc.gen.wgft_def
import mc.gen.wgft_pdef
import mc.gen.wgft_ldctx
import mc.gen.wgft_surv
import mc.gen.wgft_ldprov
import mc.gen.wgft_ldpetals

export { load_provider }

fn entry_code(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32) -> u16 {
    let name: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, node, "Name")))
    let kind: i32 = wgft_surv.kind_of(name)
    if kind < 0 {
        (*l).ok = false
        return 0
    }
    var code: u16 = 0
    if wgft_ldpetals.is_petals(name) {
        code = wgft_ldpetals.petals_code(l, d, node)
    } else {
        code = wgft_ldctx.reg_code(l, name)
    }
    (*(*l).def).st_surv[code as usize] = kind as u8
    return code
}

fn load_list(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32, out: *mut [u16; 8]) -> usize {
    let cnt: usize = json.json_count(d, node)
    if cnt == 0 || cnt > 8 {
        (*l).ok = false
        return 0
    }
    var k: usize = 0
    while k < cnt {
        (*out)[k] = entry_code(l, d, json.json_child_at(d, node, k))
        k = k + 1
    }
    return cnt
}

fn load_noise(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32, seed: i64) -> i32 {
    let def: *mut wgft_def.FtDef = (*l).def
    if (*def).nnoises >= wgft_pdef.MAX_NOISES {
        (*l).ok = false
        return 0
    }
    let slot: usize = (*def).nnoises
    (*def).nnoises = (*def).nnoises + 1
    let first: i32 = wgft_ldctx.num_or_fail(l, d, node, "firstOctave")
    let amp_node: u32 = jsonstr.get(d, node, "amplitudes")
    let cnt: usize = json.json_count(d, amp_node)
    var amps: [f64; 32] = [0.0; 32]
    if cnt == 0 || cnt > 32 {
        (*l).ok = false
        amps[0] = 1.0
    } else {
        var k: usize = 0
        while k < cnt {
            amps[k] = json.json_number(d, json.json_child_at(d, amp_node, k))
            k = k + 1
        }
    }
    var count: i32 = cnt as i32
    if count < 1 || count > 32 { count = 1 }
    var r: mg_random.Rng = mg_random.rng_wrap(mg_random.rng_legacy(seed))
    (*def).noises[slot] = mg_noise.normal_create(&r, first, &amps, count, true)
    return slot as i32
}

fn load_noise_base(l: *mut wgft_ldctx.Ld, p: *mut wgft_pdef.StateProv, d: *mut json.Json, node: u32) -> i64 {
    let seed: i64 = json.json_number(d, jsonstr.get(d, node, "seed")) as i64
    (*p).scale = json.json_number(d, jsonstr.get(d, node, "scale")) as f32
    (*p).noise = load_noise(l, d, jsonstr.get(d, node, "noise"), seed)
    return seed
}

fn load_weighted(l: *mut wgft_ldctx.Ld, p: *mut wgft_pdef.StateProv, d: *mut json.Json, node: u32) {
    let entries: u32 = jsonstr.get(d, node, "entries")
    let cnt: usize = json.json_count(d, entries)
    if cnt == 0 || cnt > wgft_pdef.MAX_PROV_STATES {
        (*l).ok = false
        return
    }
    var k: usize = 0
    var total: i32 = 0
    while k < cnt {
        let e: u32 = json.json_child_at(d, entries, k)
        (*p).codes[k] = entry_code(l, d, jsonstr.get(d, e, "data"))
        (*p).weights[k] = wgft_ldctx.num_or_fail(l, d, e, "weight")
        total = total + (*p).weights[k]
        k = k + 1
    }
    (*p).n = cnt
    (*p).total = total
}

fn load_states(l: *mut wgft_ldctx.Ld, p: *mut wgft_pdef.StateProv, d: *mut json.Json, node: u32) {
    let states: u32 = jsonstr.get(d, node, "states")
    let cnt: usize = json.json_count(d, states)
    if cnt == 0 || cnt > wgft_pdef.MAX_PROV_STATES {
        (*l).ok = false
        return
    }
    var k: usize = 0
    while k < cnt {
        (*p).codes[k] = entry_code(l, d, json.json_child_at(d, states, k))
        k = k + 1
    }
    (*p).n = cnt
}

fn load_threshold(l: *mut wgft_ldctx.Ld, p: *mut wgft_pdef.StateProv, d: *mut json.Json, node: u32) {
    load_noise_base(l, p, d, node)
    (*p).threshold = json.json_number(d, jsonstr.get(d, node, "threshold")) as f32
    (*p).high_chance = json.json_number(d, jsonstr.get(d, node, "high_chance")) as f32
    (*p).dflt = entry_code(l, d, jsonstr.get(d, node, "default_state"))
    (*p).nlow = load_list(l, d, jsonstr.get(d, node, "low_states"), &(*p).low)
    (*p).nhigh = load_list(l, d, jsonstr.get(d, node, "high_states"), &(*p).high)
}

fn load_dual(l: *mut wgft_ldctx.Ld, p: *mut wgft_pdef.StateProv, d: *mut json.Json, node: u32) {
    let seed: i64 = load_noise_base(l, p, d, node)
    load_states(l, p, d, node)
    (*p).slow_scale = json.json_number(d, jsonstr.get(d, node, "slow_scale")) as f32
    (*p).slow = load_noise(l, d, jsonstr.get(d, node, "slow_noise"), seed)
    let variety: u32 = jsonstr.get(d, node, "variety")
    if json.json_count(d, variety) != 2 {
        (*l).ok = false
        return
    }
    (*p).variety_lo = json.json_number(d, json.json_child_at(d, variety, 0)) as i32
    (*p).variety_hi = json.json_number(d, json.json_child_at(d, variety, 1)) as i32
    if (*p).variety_lo < 1 || (*p).variety_hi + 1 > (wgft_pdef.MAX_PROV_STATES as i32) { (*l).ok = false }
}

fn load_randint(l: *mut wgft_ldctx.Ld, p: *mut wgft_pdef.StateProv, d: *mut json.Json, node: u32) {
    (*p).noise = load_provider(l, d, jsonstr.get(d, node, "source"))
    var lo: i32 = 0
    var hi: i32 = 0
    (*p).rand_uni = wgft_ldprov.int_range(l, d, jsonstr.get(d, node, "values"), &lo, &hi)
    (*p).variety_lo = lo
    (*p).variety_hi = hi
}

fn load_provider(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32) -> i32 {
    let def: *mut wgft_def.FtDef = (*l).def
    if (*def).nprovs >= wgft_pdef.MAX_PROVS {
        (*l).ok = false
        return 0
    }
    let idx: usize = (*def).nprovs
    (*def).nprovs = (*def).nprovs + 1
    let p: *mut wgft_pdef.StateProv = &(*def).provs[idx]
    let ty: str = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, node, "type")))
    if ty == "simple_state_provider" {
        (*p).kind = wgft_pdef.SP_SIMPLE
        (*p).n = 1
        (*p).codes[0] = entry_code(l, d, jsonstr.get(d, node, "state"))
    } else if ty == "weighted_state_provider" {
        (*p).kind = wgft_pdef.SP_WEIGHTED
        load_weighted(l, p, d, node)
    } else if ty == "noise_threshold_provider" {
        (*p).kind = wgft_pdef.SP_THRESHOLD
        load_threshold(l, p, d, node)
    } else if ty == "noise_provider" {
        (*p).kind = wgft_pdef.SP_NOISE
        load_noise_base(l, p, d, node)
        load_states(l, p, d, node)
    } else if ty == "dual_noise_provider" {
        (*p).kind = wgft_pdef.SP_DUAL
        load_dual(l, p, d, node)
    } else if ty == "randomized_int_state_provider" {
        (*p).kind = wgft_pdef.SP_RANDINT
        load_randint(l, p, d, node)
    } else {
        (*l).ok = false
    }
    return idx as i32
}
