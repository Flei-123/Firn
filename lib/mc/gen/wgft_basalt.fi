import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region

export { place }

fn abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

fn sample(rng: *mut mg_random.Rng, lo: i32, hi: i32, uniform: bool) -> i32 {
    if !uniform { return lo }
    return mg_random.rng_next_int_bound(rng, hi - lo + 1) + lo
}

fn air_or_lava_ocean(r: *wgft_region.Region, sea: i32, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    let code: u16 = wgft_region.block_at(r, x, y, z)
    return (*ft).air[code as usize] || (code == (*ft).lava_code && y <= sea)
}

fn can_place_at(r: *wgft_region.Region, sea: i32, x: i32, y: i32, z: i32) -> bool {
    if !air_or_lava_ocean(r, sea, x, y, z) { return false }
    let ft: *wgft_def.FtDef = (*r).ft
    let below: u16 = wgft_region.block_at(r, x, y - 1, z)
    return !(*ft).air[below as usize] && !(*ft).no_column[below as usize]
}

fn find_surface(r: *wgft_region.Region, sea: i32, x: i32, y: i32, z: i32, dist: i32) -> i32 {
    var cy: i32 = y
    var left: i32 = dist
    while cy > (*r).min_y + 1 && left > 0 {
        left = left - 1
        if can_place_at(r, sea, x, cy, z) { return cy }
        cy = cy - 1
    }
    return 0 - 1000000
}

fn find_air(r: *wgft_region.Region, x: i32, y: i32, z: i32, dist: i32) -> i32 {
    let ft: *wgft_def.FtDef = (*r).ft
    var cy: i32 = y
    var left: i32 = dist
    while cy < (*r).min_y + (*r).height && left > 0 {
        left = left - 1
        let code: u16 = wgft_region.block_at(r, x, cy, z)
        if (*ft).no_column[code as usize] { return 0 - 1000000 }
        if (*ft).air[code as usize] { return cy }
        cy = cy + 1
    }
    return 0 - 1000000
}

fn place_column(r: *mut wgft_region.Region, sea: i32, basalt: u16, x: i32, y: i32, z: i32, h: i32, reach: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    var placed: bool = false
    var pz: i32 = z - reach
    while pz <= z + reach {
        var px: i32 = x - reach
        while px <= x + reach {
            let dist: i32 = abs_i32(px - x) + abs_i32(pz - z)
            var sy: i32 = 0 - 1000000
            if air_or_lava_ocean(r, sea, px, y, pz) {
                sy = find_surface(r, sea, px, y, pz, dist)
            } else {
                sy = find_air(r, px, y, pz, dist)
            }
            if sy != 0 - 1000000 {
                var left: i32 = h - dist / 2
                var cy: i32 = sy
                while left >= 0 {
                    if air_or_lava_ocean(r, sea, px, cy, pz) {
                        wgft_region.set_block(r, px, cy, pz, basalt)
                        cy = cy + 1
                        placed = true
                    } else {
                        if wgft_region.block_at(r, px, cy, pz) != basalt { break }
                        cy = cy + 1
                    }
                    left = left - 1
                }
            }
            px = px + 1
        }
        pz = pz + 1
    }
    return placed
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let sea: i32 = (*(*r).ft).sea_level
    let basalt: u16 = (*f).p[6] as u16
    if !can_place_at(r, sea, x, y, z) { return false }
    let h: i32 = sample((*c).rng, (*f).p[0], (*f).p[1], (*f).p[2] != 0)
    let clustered: bool = mg_random.rng_next_float((*c).rng) < 0.9f
    var span: i32 = 8
    var n: i32 = 15
    if clustered {
        span = 5
        n = 50
    }
    if h < span { span = h }
    var placed: bool = false
    var i: i32 = 0
    while i < n {
        let px: i32 = x - span + mg_random.rng_next_int_bound((*c).rng, 2 * span + 1)
        let py: i32 = y + mg_random.rng_next_int_bound((*c).rng, 1)
        let pz: i32 = z - span + mg_random.rng_next_int_bound((*c).rng, 2 * span + 1)
        let d: i32 = h - (abs_i32(px - x) + abs_i32(pz - z))
        if d >= 0 {
            let reach: i32 = sample((*c).rng, (*f).p[3], (*f).p[4], (*f).p[5] != 0)
            if place_column(r, sea, basalt, px, py, pz, d, reach) { placed = true }
        }
        i = i + 1
    }
    return placed
}
