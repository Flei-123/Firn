import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_pred

export { place }

fn pick_code(r: *mut wgft_region.Region, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> u8 {
    var i: usize = 0
    while i < (*f).nrules {
        if wgft_pred.test(r, (*f).rule_pred[i], x, y, z) { return (*f).rule_code[i] }
        i = i + 1
    }
    return (*f).fallback
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let top: i32 = y + (*f).p[0]
    let bottom: i32 = y - (*f).p[0] - 1
    let radius: i32 = mg_random.rng_next_int_bound((*c).rng, (*f).p[2] - (*f).p[1] + 1) + (*f).p[1]
    var placed: bool = false
    var dz: i32 = 0 - radius
    while dz <= radius {
        var dx: i32 = 0 - radius
        while dx <= radius {
            if dx * dx + dz * dz <= radius * radius {
                var yy: i32 = top
                while yy > bottom {
                    if wgft_pred.test(r, (*f).p[3], x + dx, yy, z + dz) {
                        wgft_region.set_block(r, x + dx, yy, z + dz, pick_code(r, f, x + dx, yy, z + dz))
                        placed = true
                    }
                    yy = yy - 1
                }
            }
            dx = dx + 1
        }
        dz = dz + 1
    }
    return placed
}
