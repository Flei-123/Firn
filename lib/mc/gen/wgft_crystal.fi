import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_spike
import mc.gen.wgft_run

export { CrystalSpawn, crystal_for_chunk }

struct CrystalSpawn {
    x: f64,
    y: f64,
    z: f64,
    yaw: f32,
}

fn spike_feature_index(ft: *wgft_def.FtDef) -> i32 {
    var i: usize = 0
    while i < (*ft).n {
        if (*ft).feats[i].kind == wgft_def.FK_END_SPIKE { return i as i32 }
        i = i + 1
    }
    return 0 - 1
}

fn crystal_for_chunk(ft: *wgft_def.FtDef, seed: i64, cx: i32, cz: i32, out: *mut CrystalSpawn) -> bool {
    if ft as u64 == 0 as u64 { return false }
    var info: wgft_spike.SpikeInfo = wgft_spike.SpikeInfo { cx: 0, cz: 0, height: 0, radius: 0, guarded: false }
    if !wgft_spike.spike_in_chunk(seed, cx, cz, &info) { return false }
    let fi: i32 = spike_feature_index(ft)
    if fi < 0 { return false }
    let f: *wgft_def.Feat = &(*ft).feats[fi as usize]
    var rng: mg_random.Rng = mg_random.rng_wrap(mg_random.rng_xoro(0))
    let base: i64 = wgft_run.set_decoration_seed(&rng, seed, cx * 16, cz * 16)
    mg_random.rng_set_seed(&rng, base +% ((*f).index as i64) +% ((10000 * (*f).step) as i64))
    let yaw: f32 = mg_random.rng_next_float(&rng) * 360.0f
    *out = CrystalSpawn { x: (info.cx as f64) + 0.5, y: (info.height + 1) as f64, z: (info.cz as f64) + 0.5, yaw: yaw }
    return true
}
