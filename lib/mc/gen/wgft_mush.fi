import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_mushshape

export { place }

fn height_of(rng: *mut mg_random.Rng) -> i32 {
    var h: i32 = mg_random.rng_next_int_bound(rng, 3) + 4
    if mg_random.rng_next_int_bound(rng, 12) == 0 { h = h * 2 }
    return h
}

fn valid_radius(red: bool, r: i32, yy: i32) -> i32 {
    if red { return wgft_mushshape.red_valid_radius(r, yy) }
    return wgft_mushshape.brown_valid_radius(r, yy)
}

fn is_valid(rg: *mut wgft_region.Region, red: bool, r: i32, h: i32, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*rg).ft
    if y < (*rg).min_y + 1 || y + h + 1 >= (*rg).min_y + (*rg).height { return false }
    if !(*ft).dirt[wgft_region.block_at(rg, x, y - 1, z) as usize] { return false }
    var yy: i32 = 0
    while yy <= h {
        let rr: i32 = valid_radius(red, r, yy)
        var dx: i32 = 0 - rr
        while dx <= rr {
            var dz: i32 = 0 - rr
            while dz <= rr {
                let code: u8 = wgft_region.block_at(rg, x + dx, y + yy, z + dz)
                if !(*ft).air[code as usize] && !(*ft).leaves[code as usize] { return false }
                dz = dz + 1
            }
            dx = dx + 1
        }
        yy = yy + 1
    }
    return true
}

fn put_cap(rg: *mut wgft_region.Region, mi: usize, idx: i32, x: i32, y: i32, z: i32) {
    let ft: *wgft_def.FtDef = (*rg).ft
    if (*ft).solid[wgft_region.block_at(rg, x, y, z) as usize] { return }
    wgft_region.set_block(rg, x, y, z, (*ft).mush_cap[mi][idx as usize])
}

fn cap_brown(rg: *mut wgft_region.Region, f: *wgft_def.Feat, h: i32, x: i32, y: i32, z: i32) {
    let r: i32 = (*f).p[1]
    var dx: i32 = 0 - r
    while dx <= r {
        var dz: i32 = 0 - r
        while dz <= r {
            let bits: i32 = wgft_mushshape.brown_bits(r, dx, dz)
            if bits >= 0 { put_cap(rg, (*f).p[0] as usize, bits + (*f).p[3], x + dx, y + h, z + dz) }
            dz = dz + 1
        }
        dx = dx + 1
    }
}

fn cap_red(rg: *mut wgft_region.Region, f: *wgft_def.Feat, h: i32, x: i32, y: i32, z: i32) {
    let r: i32 = (*f).p[1]
    var k: i32 = 0
    while k < 4 {
        let rr: i32 = wgft_mushshape.red_radius(r, k)
        var dx: i32 = 0 - rr
        while dx <= rr {
            var dz: i32 = 0 - rr
            while dz <= rr {
                let idx: i32 = wgft_mushshape.red_bits(r, k, dx, dz)
                if idx >= 0 { put_cap(rg, (*f).p[0] as usize, idx, x + dx, y + h - 3 + k, z + dz) }
                dz = dz + 1
            }
            dx = dx + 1
        }
        k = k + 1
    }
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let rg: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*rg).ft
    let red: bool = (*f).p[2] == 1
    let h: i32 = height_of((*c).rng)
    if !is_valid(rg, red, (*f).p[1], h, x, y, z) { return false }
    if red { cap_red(rg, f, h, x, y, z) } else { cap_brown(rg, f, h, x, y, z) }
    var yy: i32 = 0
    while yy < h {
        if !(*ft).solid[wgft_region.block_at(rg, x, y + yy, z) as usize] {
            wgft_region.set_block(rg, x, y + yy, z, (*ft).mush_stem[(*f).p[0] as usize])
        }
        yy = yy + 1
    }
    return true
}
