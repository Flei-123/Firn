// SPDX-License-Identifier: MPL-2.0
import std.rt
import mc.gen.wgdf_graph
import mc.gen.wgdf_eval
import mc.gen.wgbio_table
import mc.gen.wgbio_tree

export { BioSource, bio_open, bio_close, bio_sample, bio_fill_chunk, bio_name, bio_name_count, bio_preset_of }

struct BioSource {
    tab: wgbio_table.BioTable,
    tree: wgbio_tree.BioTree,
    nodes: [i32; 6],
}

fn bio_preset_of(dim: str) -> str {
    if dim == "nether" { return "nether" }
    if dim == "end" { return "" }
    return "overworld"
}

fn push_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn bio_open(g: *wgdf_graph.WgGraph, root: str, preset: str) -> *mut BioSource {
    if preset.n == 0 { return 0 as *mut BioSource }
    var path: rt.Buf = rt.buf_new()
    push_str(&path, root)
    push_str(&path, "/biome_source/")
    push_str(&path, preset)
    push_str(&path, ".tsv")
    rt.buf_push(&path, 0 as u8)
    var raw: rt.Buf = rt.buf_new()
    let ok: bool = rt.read_file(rt.buf_ptr(&path), &raw)
    rt.buf_free(&path)
    if !ok {
        rt.buf_free(&raw)
        return 0 as *mut BioSource
    }
    let s: *mut BioSource = rt.heap_alloc(wgbio_table.wgbio_bytes_of[BioSource]()) as *mut BioSource
    (*s).tab.vals = 0 as u64
    (*s).tab.names_of = 0 as u64
    let good: bool = wgbio_table.table_load(&(*s).tab, &raw)
    rt.buf_free(&raw)
    (*s).nodes[0] = wgdf_graph.router_find(g, "temperature")
    (*s).nodes[1] = wgdf_graph.router_find(g, "vegetation")
    (*s).nodes[2] = wgdf_graph.router_find(g, "continents")
    (*s).nodes[3] = wgdf_graph.router_find(g, "erosion")
    (*s).nodes[4] = wgdf_graph.router_find(g, "depth")
    (*s).nodes[5] = wgdf_graph.router_find(g, "ridges")
    var k: usize = 0
    var all: bool = good
    while k < 6 {
        if (*s).nodes[k] < 0 { all = false }
        k = k + 1
    }
    if !all {
        wgbio_table.table_free(&(*s).tab)
        rt.heap_free(s as u64, wgbio_table.wgbio_bytes_of[BioSource]())
        return 0 as *mut BioSource
    }
    wgbio_tree.tree_build(&(*s).tree, &(*s).tab)
    return s
}

fn bio_close(s: *mut BioSource) {
    wgbio_tree.tree_free(&(*s).tree)
    wgbio_table.table_free(&(*s).tab)
    rt.heap_free(s as u64, wgbio_table.wgbio_bytes_of[BioSource]())
}

fn bio_name(s: *mut BioSource, idx: usize) -> str {
    return wgbio_table.table_name(&(*s).tab, idx)
}

fn bio_name_count(s: *mut BioSource) -> usize {
    return wgbio_table.table_name_count(&(*s).tab)
}

fn quantize(v: f64) -> i64 {
    let f: f32 = v as f32
    let scale: f32 = 10000.0
    return (f * scale) as i64
}

fn bio_sample(s: *mut BioSource, g: *wgdf_graph.WgGraph, ns: *wgdf_eval.WgNoises, qx: i32, qy: i32, qz: i32) -> usize {
    let x: i32 = qx * 4
    let y: i32 = qy * 4
    let z: i32 = qz * 4
    var target: [i64; 7] = [0; 7]
    var k: usize = 0
    while k < 6 {
        target[k] = quantize(wgdf_eval.eval(g, ns, (*s).nodes[k], x, y, z))
        k = k + 1
    }
    let e: usize = wgbio_tree.tree_search(&(*s).tree, &target)
    return wgbio_table.table_entry_name(&(*s).tab, e)
}

fn bio_fill_chunk(s: *mut BioSource, g: *wgdf_graph.WgGraph, ns: *wgdf_eval.WgNoises, cx: i32, cz: i32, out: *mut u8) {
    let qy0: i32 = wgdf_eval.floor_div((*g).min_y, 4)
    let cells: i32 = (*g).height / 4
    var iy: i32 = 0
    while iy < cells {
        let sec: usize = (iy / 4) as usize
        let y4: usize = (iy % 4) as usize
        var z4: i32 = 0
        while z4 < 4 {
            var x4: i32 = 0
            while x4 < 4 {
                let n: usize = bio_sample(s, g, ns, cx * 4 + x4, qy0 + iy, cz * 4 + z4)
                *(((out as u64) + ((sec * 64 + y4 * 16 + (z4 as usize) * 4 + (x4 as usize)) as u64)) as *mut u8) = n as u8
                x4 = x4 + 1
            }
            z4 = z4 + 1
        }
        iy = iy + 1
    }
}
