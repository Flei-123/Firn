// SPDX-License-Identifier: MPL-2.0
// lib/mc/gen/wgdf_end.fi -- EndIslandDensityFunction (end_islands), bit identical to Java (float math).
import std.math
import noise.simplex
import mc.gen.mg_random
import mc.gen.mg_noise

export { end_islands_build, end_islands_value }

fn end_islands_build(seed: i64) -> simplex.Simplex {
    var r: mg_random.Rng = mg_random.rng_legacy(seed)
    mg_random.rng_consume(&r, 17292)
    return mg_noise.simplex_from_rng(&r)
}

#[allow_fp]
fn clamp32(v: f32, lo: f32, hi: f32) -> f32 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

#[allow_fp]
fn height_value(sn: *simplex.Simplex, px: i32, pz: i32) -> f32 {
    let hx: i32 = px / 2
    let hz: i32 = pz / 2
    let rx: i32 = px % 2
    let rz: i32 = pz % 2
    let dist: f32 = math.sqrt32(((px *% px) +% (pz *% pz)) as f32)
    var best: f32 = clamp32(100.0f - dist * 8.0f, 0.0f - 100.0f, 80.0f)
    let thr: f32 = -0.9f
    var dx: i32 = -12
    while dx <= 12 {
        var dz: i32 = -12
        while dz <= 12 {
            let ax: i64 = (hx + dx) as i64
            let az: i64 = (hz + dz) as i64
            if ax * ax + az * az > 4096 && simplex.simplex_value2(sn, ax as f64, az as f64) < (thr as f64) {
                let fa: f32 = math.fabs32(ax as f32)
                let fb: f32 = math.fabs32(az as f32)
                let m: f32 = (math.fmod((fa * 3439.0f + fb * 147.0f) as f64, 13.0) as f32) + 9.0f
                let ex: f32 = (rx - dx * 2) as f32
                let ez: f32 = (rz - dz * 2) as f32
                var v: f32 = 100.0f - math.sqrt32(ex * ex + ez * ez) * m
                v = clamp32(v, 0.0f - 100.0f, 80.0f)
                if v > best { best = v }
            }
            dz = dz + 1
        }
        dx = dx + 1
    }
    return best
}

#[allow_fp]
fn end_islands_value(sn: *simplex.Simplex, x: i32, z: i32) -> f64 {
    return ((height_value(sn, x / 8, z / 8) as f64) - 8.0) / 128.0
}
