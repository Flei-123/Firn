import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_endisle
import mc.gen.wgft_spike
import mc.gen.wgft_chorus
import mc.gen.wgft_gateway

export { place }

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let k: u8 = (*f).kind
    if k == wgft_def.FK_END_ISLAND { return wgft_endisle.place(c, f, x, y, z) }
    if k == wgft_def.FK_END_SPIKE { return wgft_spike.place(c, f, x, y, z) }
    if k == wgft_def.FK_CHORUS { return wgft_chorus.place(c, f, x, y, z) }
    if k == wgft_def.FK_GATEWAY { return wgft_gateway.place(c, f, x, y, z) }
    return false
}
