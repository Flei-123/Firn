// lib/mc/gen/wgdf_fluid.fi -- block state codes of the noise fill and the global fluid picker (FluidStatus).
import mc.gen.wgdf_graph

export {
    STATE_SOLID, STATE_AIR, STATE_WATER, STATE_LAVA, STATE_COPPER_ORE, STATE_RAW_COPPER, STATE_GRANITE,
    STATE_IRON_ORE, STATE_RAW_IRON, STATE_TUFF, Fluid, fluid_global, fluid_at,
}

const STATE_SOLID: u8 = 83
const STATE_AIR: u8 = 65
const STATE_WATER: u8 = 87
const STATE_LAVA: u8 = 76
const STATE_COPPER_ORE: u8 = 67
const STATE_RAW_COPPER: u8 = 99
const STATE_GRANITE: u8 = 71
const STATE_IRON_ORE: u8 = 73
const STATE_RAW_IRON: u8 = 105
const STATE_TUFF: u8 = 84

struct Fluid {
    level: i32,
    ty: u8,
}

fn fluid_global(g: *wgdf_graph.WgGraph, y: i32) -> Fluid {
    var lava_below: i32 = -54
    if (*g).sea_level < lava_below {
        lava_below = (*g).sea_level
    }
    if y < lava_below {
        return Fluid { level: -54, ty: STATE_LAVA }
    }
    var ty: u8 = STATE_AIR
    if (*g).fluid == 1 { ty = STATE_WATER }
    if (*g).fluid == 2 { ty = STATE_LAVA }
    return Fluid { level: (*g).sea_level, ty: ty }
}

fn fluid_at(f: *Fluid, y: i32) -> u8 {
    if y < (*f).level {
        return (*f).ty
    }
    return STATE_AIR
}
