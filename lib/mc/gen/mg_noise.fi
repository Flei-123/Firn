// SPDX-License-Identifier: MPL-2.0
// lib/mc/gen/mg_noise.fi -- creation of the world-generation noises from a random stream, in the order Minecraft draws:
// ImprovedNoise, PerlinNoise (legacy and positional init), NormalNoise, SimplexNoise, PerlinSimplexNoise, BlendedNoise.
import noise.improved
import noise.simplex
import noise.perlin
import noise.psimplex
import noise.jnum
import mc.gen.mg_random

export {
    OctaveSet, octave_range, improved_from_rng, simplex_from_rng, perlin_create, perlin_create_set,
    normal_create, blended_create, psimplex_create,
}

struct OctaveSet {
    v: [i32; 32],
    n: i32,
}

fn octave_range(lo: i32, hi: i32) -> OctaveSet {
    var s: OctaveSet = OctaveSet { v: [0; 32], n: 0 }
    var i: i32 = lo
    while i <= hi {
        s.v[s.n as usize] = i
        s.n = s.n + 1
        i = i + 1
    }
    return s
}

fn octave_has(s: *OctaveSet, o: i32) -> bool {
    var i: i32 = 0
    while i < (*s).n {
        if (*s).v[i as usize] == o {
            return true
        }
        i = i + 1
    }
    return false
}

#[allow_fp]
fn improved_from_rng(r: *mut mg_random.Rng) -> improved.Improved {
    let xo: f64 = mg_random.rng_next_double(r) * 256.0
    let yo: f64 = mg_random.rng_next_double(r) * 256.0
    let zo: f64 = mg_random.rng_next_double(r) * 256.0
    var n: improved.Improved = improved.improved_new(xo, yo, zo)
    var i: i32 = 0
    while i < 256 {
        let j: i32 = mg_random.rng_next_int_bound(r, 256 - i)
        improved.improved_swap(&n, i, i + j)
        i = i + 1
    }
    return n
}

#[allow_fp]
fn simplex_from_rng(r: *mut mg_random.Rng) -> simplex.Simplex {
    let xo: f64 = mg_random.rng_next_double(r) * 256.0
    let yo: f64 = mg_random.rng_next_double(r) * 256.0
    let zo: f64 = mg_random.rng_next_double(r) * 256.0
    var n: simplex.Simplex = simplex.simplex_new(xo, yo, zo)
    var i: i32 = 0
    while i < 256 {
        let j: i32 = mg_random.rng_next_int_bound(r, 256 - i)
        simplex.simplex_swap(&n, i, j + i)
        i = i + 1
    }
    return n
}

fn octave_name(buf: *mut [u8; 32], o: i32) -> usize {
    let pre: [u8; 7] = "octave_"
    var n: usize = 0
    while n < 7 {
        (*buf)[n] = pre[n]
        n = n + 1
    }
    var v: i64 = o as i64
    if v < 0 {
        (*buf)[n] = 45 as u8
        n = n + 1
        v = 0 - v
    }
    var digits: [u8; 12] = [0; 12]
    var d: usize = 0
    if v == 0 {
        digits[0] = 48 as u8
        d = 1
    }
    while v > 0 {
        digits[d] = (48 + v % 10) as u8
        v = v / 10
        d = d + 1
    }
    while d > 0 {
        d = d - 1
        (*buf)[n] = digits[d]
        n = n + 1
    }
    return n
}

fn skip_octave(r: *mut mg_random.Rng) {
    mg_random.rng_consume(r, 262)
}

fn perlin_create(r: *mut mg_random.Rng, first_octave: i32, amps: *[f64; 32], count: i32, new_init: bool) -> perlin.Perlin {
    var p: perlin.Perlin = perlin.perlin_empty(first_octave, count)
    let j: i32 = 0 - first_octave
    if new_init {
        let prf: mg_random.PosFactory = mg_random.rng_fork_positional(r)
        var k: i32 = 0
        while k < count {
            if (*amps)[k as usize] != 0.0 {
                var name: [u8; 32] = [0; 32]
                let nn: usize = octave_name(&name, first_octave + k)
                var sub: mg_random.Rng = mg_random.pos_from_hash_of(&prf, (&name[0]) as u64, nn)
                perlin.perlin_set(&p, k, (*amps)[k as usize], improved_from_rng(&sub))
            }
            k = k + 1
        }
    } else {
        let first: improved.Improved = improved_from_rng(r)
        if j >= 0 && j < count {
            if (*amps)[j as usize] != 0.0 {
                perlin.perlin_set(&p, j, (*amps)[j as usize], first)
            }
        }
        var i1: i32 = j - 1
        while i1 >= 0 {
            if i1 < count {
                if (*amps)[i1 as usize] != 0.0 {
                    perlin.perlin_set(&p, i1, (*amps)[i1 as usize], improved_from_rng(r))
                } else {
                    skip_octave(r)
                }
            } else {
                skip_octave(r)
            }
            i1 = i1 - 1
        }
    }
    perlin.perlin_finish(&p)
    return p
}

fn perlin_create_set(r: *mut mg_random.Rng, set: *OctaveSet, new_init: bool) -> perlin.Perlin {
    let i: i32 = 0 - (*set).v[0]
    let j: i32 = (*set).v[((*set).n - 1) as usize]
    let k: i32 = i + j + 1
    var amps: [f64; 32] = [0.0; 32]
    var m: i32 = 0
    while m < (*set).n {
        amps[((*set).v[m as usize] + i) as usize] = 1.0
        m = m + 1
    }
    return perlin_create(r, 0 - i, &amps, k, new_init)
}

fn normal_create(r: *mut mg_random.Rng, first_octave: i32, amps: *[f64; 32], count: i32, new_init: bool) -> perlin.Normal {
    let a: perlin.Perlin = perlin_create(r, first_octave, amps, count, new_init)
    let b: perlin.Perlin = perlin_create(r, first_octave, amps, count, new_init)
    var n: perlin.Normal = perlin.Normal { first: a, second: b, value_factor: 0.0, max_value: 0.0 }
    perlin.normal_finish(&n)
    return n
}

fn blended_create(r: *mut mg_random.Rng, xz_scale: f64, y_scale: f64, xz_factor: f64, y_factor: f64, smear: f64) -> perlin.Blended {
    let s16: OctaveSet = octave_range(-15, 0)
    let s8: OctaveSet = octave_range(-7, 0)
    let a: perlin.Perlin = perlin_create_set(r, &s16, false)
    let b: perlin.Perlin = perlin_create_set(r, &s16, false)
    let c: perlin.Perlin = perlin_create_set(r, &s8, false)
    return perlin.blended_new(a, b, c, xz_scale, y_scale, xz_factor, y_factor, smear)
}

#[allow_fp]
fn psimplex_create(r: *mut mg_random.Rng, set: *OctaveSet) -> psimplex.PerlinSimplex {
    let i: i32 = 0 - (*set).v[0]
    let j: i32 = (*set).v[((*set).n - 1) as usize]
    let k: i32 = i + j + 1
    var p: psimplex.PerlinSimplex = psimplex.psimplex_empty(k)
    let base: simplex.Simplex = simplex_from_rng(r)
    let l: i32 = j
    if j >= 0 && j < k && octave_has(set, 0) {
        psimplex.psimplex_set(&p, j, base)
    }
    var i1: i32 = j + 1
    while i1 < k {
        if i1 >= 0 && octave_has(set, l - i1) {
            psimplex.psimplex_set(&p, i1, simplex_from_rng(r))
        } else {
            mg_random.rng_consume(r, 263)
        }
        i1 = i1 + 1
    }
    if j > 0 {
        let j1: i64 = jnum.d2l(simplex.simplex_value3(&base, base.xo, base.yo, base.zo) * 9223372036854775807.0)
        var rs: mg_random.Rng = mg_random.rng_wrap(mg_random.rng_legacy(j1))
        var l1: i32 = l - 1
        while l1 >= 0 {
            if l1 < k && octave_has(set, l - l1) {
                psimplex.psimplex_set(&p, l1, simplex_from_rng(&rs))
            } else {
                mg_random.rng_consume(&rs, 263)
            }
            l1 = l1 - 1
        }
    }
    psimplex.psimplex_finish(&p, j)
    return p
}
