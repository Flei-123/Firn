// lib/mc/gen/mg_wgen.fi -- seeding recipes of WorldgenRandom: decoration, feature, structure and slime-chunk seeds.
import mc.gen.mg_random

export {
    set_decoration_seed, set_feature_seed, set_large_feature_seed, set_large_feature_with_salt, seed_slime_chunk,
}

fn set_decoration_seed(r: *mut mg_random.Rng, seed: i64, x: i32, z: i32) -> i64 {
    mg_random.rng_set_seed(r, seed)
    let a: i64 = mg_random.rng_next_long(r) | 1
    let b: i64 = mg_random.rng_next_long(r) | 1
    let k: i64 = ((x as i64) *% a +% (z as i64) *% b) ^ seed
    mg_random.rng_set_seed(r, k)
    return k
}

fn set_feature_seed(r: *mut mg_random.Rng, seed: i64, index: i32, step: i32) {
    mg_random.rng_set_seed(r, seed +% (index as i64) +% ((10000 *% step) as i64))
}

fn set_large_feature_seed(r: *mut mg_random.Rng, seed: i64, x: i32, z: i32) {
    mg_random.rng_set_seed(r, seed)
    let a: i64 = mg_random.rng_next_long(r)
    let b: i64 = mg_random.rng_next_long(r)
    mg_random.rng_set_seed(r, ((x as i64) *% a) ^ ((z as i64) *% b) ^ seed)
}

fn set_large_feature_with_salt(r: *mut mg_random.Rng, seed: i64, x: i32, z: i32, salt: i32) {
    mg_random.rng_set_seed(r, (x as i64) *% 341873128712 +% (z as i64) *% 132897987541 +% seed +% (salt as i64))
}

fn seed_slime_chunk(x: i32, z: i32, seed: i64, salt: i64) -> mg_random.Rng {
    let a: i64 = (x *% x *% 4987142) as i64
    let b: i64 = (x *% 5947611) as i64
    let c: i64 = ((z *% z) as i64) *% 4392871
    let d: i64 = (z *% 389711) as i64
    return mg_random.rng_legacy((seed +% a +% b +% c +% d) ^ salt)
}
