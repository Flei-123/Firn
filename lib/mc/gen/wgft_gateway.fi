import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_endput

export { place }

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let gateway: u16 = (*f).p[0] as u16
    let bedrock: u16 = (*f).p[1] as u16
    let air: u16 = (*f).p[2] as u16
    var dx: i32 = 0 - 1
    while dx <= 1 {
        var dy: i32 = 0 - 2
        while dy <= 2 {
            var dz: i32 = 0 - 1
            while dz <= 1 {
                let mx: bool = dx == 0
                let my: bool = dy == 0
                let mz: bool = dz == 0
                let far: bool = dy == 2 || dy == (0 - 2)
                var code: u16 = air
                if mx && my && mz {
                    code = gateway
                } else if my {
                    code = air
                } else if far && mx && mz {
                    code = bedrock
                } else if (mx || mz) && !far {
                    code = bedrock
                }
                wgft_endput.put(r, x + dx, y + dy, z + dz, code)
                dz = dz + 1
            }
            dy = dy + 1
        }
        dx = dx + 1
    }
    return true
}
