import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch
import mc.gen.wgft_trunk
import mc.gen.wgft_foliage

export { place_upwards, valid_pos }

fn valid_pos(ft: *wgft_def.FtDef, code: u16) -> bool {
    return (*ft).tree_ok[code as usize] || (*ft).grow_logs[code as usize]
}

fn place_log(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, x: i32, y: i32, z: i32) -> bool {
    if !valid_pos((*r).ft, wgft_region.block_at(r, x, y, z)) { return false }
    wgft_region.set_block(r, x, y, z, (*t).trunk_code)
    wgft_tscratch.note_log(sc, x, y, z)
    return true
}

fn place_branch(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, height: i32, x: i32, base_y: i32, z: i32, dir: i32, start: i32, steps: i32) {
    var top: i32 = base_y + start
    var cx: i32 = x
    var cz: i32 = z
    var k: i32 = start
    var left: i32 = steps
    while k < height && left > 0 {
        if k >= 1 {
            let yy: i32 = base_y + k
            cx = cx + wgft_trunk.step_x(dir)
            cz = cz + wgft_trunk.step_z(dir)
            top = yy
            if place_log(r, sc, t, cx, yy, cz) { top = yy + 1 }
            wgft_tscratch.add_attach(sc, cx, yy, cz, 0)
        }
        k = k + 1
        left = left - 1
    }
    if top - base_y > 1 {
        wgft_tscratch.add_attach(sc, cx, top, cz, 0)
        wgft_tscratch.add_attach(sc, cx, top - 2, cz, 0)
    }
}

#[allow_fp]
fn place_upwards(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    let u: *wgft_def.UpwardsCfg = &(*t).upwards
    var i: i32 = 0
    while i < free {
        let yy: i32 = y + i
        if place_log(r, sc, t, x, yy, z) && i < free - 1 && mg_random.rng_next_float(rng) < (*u).prob {
            let dir: i32 = mg_random.rng_next_int_bound(rng, 4)
            let first: i32 = wgft_foliage.sample_int(rng, (*u).len_lo, (*u).len_hi, (*u).len_uni)
            let second: i32 = wgft_foliage.sample_int(rng, (*u).len_lo, (*u).len_hi, (*u).len_uni)
            var start: i32 = first - second - 1
            if start < 0 { start = 0 }
            let steps: i32 = wgft_foliage.sample_int(rng, (*u).steps_lo, (*u).steps_hi, (*u).steps_uni)
            place_branch(r, sc, t, free, x, yy, z, dir, start, steps)
        }
        if i == free - 1 { wgft_tscratch.add_attach(sc, x, yy + 1, z, 0) }
        i = i + 1
    }
}
