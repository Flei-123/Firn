import std.rt
import std.json
import std.jsonstr
import mc.gen.wgsr_def
import mc.gen.wgft_def
import mc.gen.wgft_ldctx
import mc.gen.wgft_ldtree
import mc.gen.wgft_mushshape

export { load_mushroom }

fn put_str(buf: u64, pos: usize, s: str) -> usize {
    var i: usize = 0
    while i < s.n {
        rt.st8(buf, pos + i, rt.ld8(s.p as u64, i))
        i = i + 1
    }
    return pos + s.n
}

fn bool_str(b: bool) -> str {
    if b { return "1" }
    return "0"
}

fn prop_bool(d: *mut json.Json, props: u32, key: str) -> bool {
    let n: u32 = jsonstr.get(d, props, key)
    if n == wgft_ldctx.NONE_NODE { return true }
    return jsonstr.string(d, n) == "true"
}

fn reg_faces(l: *mut wgft_ldctx.Ld, base: str, down: bool, east: bool, north: bool, south: bool, up: bool, west: bool) -> u8 {
    var buf: [u8; 128] = [0 as u8; 128]
    let p: u64 = (&buf[0]) as u64
    var n: usize = put_str(p, 0, base)
    n = put_str(p, n, "[")
    n = put_str(p, n, bool_str(down))
    n = put_str(p, n, bool_str(east))
    n = put_str(p, n, bool_str(north))
    n = put_str(p, n, bool_str(south))
    n = put_str(p, n, bool_str(up))
    n = put_str(p, n, bool_str(west))
    n = put_str(p, n, "]")
    let c: i32 = wgsr_def.block_code((*l).sdef, p, n)
    if c < 0 || c > 255 {
        (*l).ok = false
        return 0
    }
    return c as u8
}

fn reg_cap(l: *mut wgft_ldctx.Ld, base: str, down: bool, bits: i32, up: bool) -> u8 {
    return reg_faces(l, base, down, (bits / 4) % 2 == 1, (bits / 2) % 2 == 1, bits % 2 == 1, up, (bits / 8) % 2 == 1)
}

fn note_cap(l: *mut wgft_ldctx.Ld, mi: usize, base: str, down: bool, idx: i32) {
    let def: *mut wgft_def.FtDef = (*l).def
    if (*def).mush_cap[mi][idx as usize] != (0 as u8) { return }
    (*def).mush_cap[mi][idx as usize] = reg_cap(l, base, down, idx % 16, idx >= 16)
}

fn enumerate_brown(l: *mut wgft_ldctx.Ld, mi: usize, base: str, down: bool, up: bool, r: i32) {
    var x: i32 = 0 - r
    while x <= r {
        var z: i32 = 0 - r
        while z <= r {
            let bits: i32 = wgft_mushshape.brown_bits(r, x, z)
            if bits >= 0 {
                var idx: i32 = bits
                if up { idx = idx + 16 }
                note_cap(l, mi, base, down, idx)
            }
            z = z + 1
        }
        x = x + 1
    }
}

fn enumerate_red(l: *mut wgft_ldctx.Ld, mi: usize, base: str, down: bool, r: i32) {
    var k: i32 = 0
    while k < 4 {
        let rr: i32 = wgft_mushshape.red_radius(r, k)
        var x: i32 = 0 - rr
        while x <= rr {
            var z: i32 = 0 - rr
            while z <= rr {
                let idx: i32 = wgft_mushshape.red_bits(r, k, x, z)
                if idx >= 0 { note_cap(l, mi, base, down, idx) }
                z = z + 1
            }
            x = x + 1
        }
        k = k + 1
    }
}

fn load_mushroom(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, cfg: u32, red: bool) {
    let def: *mut wgft_def.FtDef = (*l).def
    if (*def).nmush >= 4 {
        (*l).ok = false
        return
    }
    let mi: usize = (*def).nmush
    (*def).nmush = mi + 1
    (*f).kind = wgft_def.FK_MUSHROOM
    let r: i32 = wgft_ldctx.num_or_fail(l, d, cfg, "foliage_radius")
    let cap: u32 = wgft_ldtree.provider_state(l, d, jsonstr.get(d, cfg, "cap_provider"))
    let stem: u32 = wgft_ldtree.provider_state(l, d, jsonstr.get(d, cfg, "stem_provider"))
    let cap_props: u32 = jsonstr.get(d, cap, "Properties")
    let stem_props: u32 = jsonstr.get(d, stem, "Properties")
    let cap_name: str = wgft_ldtree.state_name(d, cap)
    let down: bool = prop_bool(d, cap_props, "down")
    let up: bool = prop_bool(d, cap_props, "up")
    var i: usize = 0
    while i < 32 {
        (*def).mush_cap[mi][i] = 0
        i = i + 1
    }
    if red { enumerate_red(l, mi, cap_name, down, r) } else { enumerate_brown(l, mi, cap_name, down, up, r) }
    (*def).mush_stem[mi] = reg_faces(l, wgft_ldtree.state_name(d, stem), prop_bool(d, stem_props, "down"), prop_bool(d, stem_props, "east"), prop_bool(d, stem_props, "north"), prop_bool(d, stem_props, "south"), prop_bool(d, stem_props, "up"), prop_bool(d, stem_props, "west"))
    (*f).p[0] = mi as i32
    (*f).p[1] = r
    if red { (*f).p[2] = 1 } else { (*f).p[2] = 0 }
    if up { (*f).p[3] = 16 } else { (*f).p[3] = 0 }
}
