import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_glow
import mc.gen.wgft_blobs
import mc.gen.wgft_netveg
import mc.gen.wgft_basalt
import mc.gen.wgft_delta
import mc.gen.wgft_pillar
import mc.gen.wgft_nvines

export { place }

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let k: u8 = (*f).kind
    if k == wgft_def.FK_GLOWSTONE { return wgft_glow.place(c, f, x, y, z) }
    if k == wgft_def.FK_BLOBS { return wgft_blobs.place(c, f, x, y, z) }
    if k == wgft_def.FK_NETHER_VEG { return wgft_netveg.place(c, f, x, y, z) }
    if k == wgft_def.FK_BASALT_COLS { return wgft_basalt.place(c, f, x, y, z) }
    if k == wgft_def.FK_DELTA { return wgft_delta.place(c, f, x, y, z) }
    if k == wgft_def.FK_PILLAR { return wgft_pillar.place(c, f, x, y, z) }
    if k == wgft_def.FK_WEEPING { return wgft_nvines.place_weeping(c, f, x, y, z) }
    if k == wgft_def.FK_TWISTING { return wgft_nvines.place_twisting(c, f, x, y, z) }
    return false
}
