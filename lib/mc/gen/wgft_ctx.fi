import mc.gen.mg_random
import mc.gen.wgsr_bio
import mc.gen.wgft_def
import mc.gen.wgft_region

export { PlaceCtx, biome_here }

struct PlaceCtx {
    r: *mut wgft_region.Region,
    rng: *mut mg_random.Rng,
    f: *wgft_def.Feat,
    fi: i32,
}

fn biome_here(r: *mut wgft_region.Region, x: i32, y: i32, z: i32) -> i32 {
    var q: [i32; 3] = [0, 0, 0]
    wgsr_bio.zoom_pick((*(*r).ft).zoom_seed, x, y, z, &q[0])
    return wgft_region.biome_at(r, q[0], q[1], q[2])
}
