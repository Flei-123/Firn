import mc.gen.wgsr_bio
import mc.gen.wgsr_def
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region

export { place }

#[allow_fp]
fn warm(r: *wgft_region.Region, biome: i32, x: i32, y: i32, z: i32) -> bool {
    let sd: *wgsr_def.SrDef = (*(*r).ft).sd as *wgsr_def.SrDef
    let t: f32 = wgsr_bio.temperature_at(sd, biome, x, y, z)
    return t >= 0.15f
}

fn snow_survives(ft: *wgft_def.FtDef, below: u8) -> bool {
    if (*ft).masks[0][below as usize] { return false }
    if (*ft).masks[1][below as usize] { return true }
    return (*ft).full_top[below as usize]
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    var ix: i32 = 0
    while ix < 16 {
        var iz: i32 = 0
        while iz < 16 {
            let px: i32 = x + ix
            let pz: i32 = z + iz
            let h: i32 = wgft_region.height_of(r, wgft_def.HM_MOTION, px, pz)
            let biome: i32 = wgft_ctx.biome_here(r, px, h, pz)
            let by: i32 = h - 1
            if by >= (*ft).min_y && by < (*ft).min_y + (*ft).height && !warm(r, biome, px, by, pz) {
                if wgft_region.block_at(r, px, by, pz) == (*ft).water_code {
                    wgft_region.set_block(r, px, by, pz, (*ft).ice_code)
                }
            }
            if h >= (*ft).min_y && h < (*ft).min_y + (*ft).height && !warm(r, biome, px, h, pz) {
                let here: u8 = wgft_region.block_at(r, px, h, pz)
                if (*ft).air[here as usize] || here == (*ft).snow_code {
                    if snow_survives(ft, wgft_region.block_at(r, px, by, pz)) {
                        wgft_region.set_block(r, px, h, pz, (*ft).snow_code)
                    }
                }
            }
            iz = iz + 1
        }
        ix = ix + 1
    }
    return true
}
