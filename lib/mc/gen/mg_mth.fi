// SPDX-License-Identifier: MPL-2.0
// lib/mc/gen/mg_mth.fi -- the integer helpers of Minecraft world generation (Mth.getSeed and the Java string hash).
import std.rt

export { get_seed, java_string_hash_utf8 }

fn get_seed(x: i32, y: i32, z: i32) -> i64 {
    var i: i64 = ((x *% 3129871) as i64) ^ ((z as i64) *% 116129781) ^ (y as i64)
    i = i *% i *% 42317861 +% i *% 11
    return i >> 16
}

fn utf8_next(p: u64, n: usize, at: *mut usize) -> u32 {
    let b0: u32 = rt_ld(p, *at) as u32
    var need: usize = 0
    var cp: u32 = b0
    if b0 >= 240 as u32 {
        need = 3
        cp = b0 & 7 as u32
    } else if b0 >= 224 as u32 {
        need = 2
        cp = b0 & 15 as u32
    } else if b0 >= 192 as u32 {
        need = 1
        cp = b0 & 31 as u32
    }
    *at = *at + 1
    var k: usize = 0
    while k < need && *at < n {
        cp = (cp << 6) | ((rt_ld(p, *at) as u32) & 63 as u32)
        *at = *at + 1
        k = k + 1
    }
    return cp
}

fn rt_ld(p: u64, i: usize) -> u8 {
    return rt.ld8(p, i)
}

fn java_string_hash_utf8(p: u64, n: usize) -> i32 {
    var h: i32 = 0
    var at: usize = 0
    while at < n {
        let cp: u32 = utf8_next(p, n, &at)
        if cp >= 65536 as u32 {
            let v: u32 = cp - 65536 as u32
            h = h *% 31 +% ((55296 as u32 + (v >> 10)) as i32)
            h = h *% 31 +% ((56320 as u32 + (v & 1023 as u32)) as i32)
        } else {
            h = h *% 31 +% (cp as i32)
        }
    }
    return h
}
