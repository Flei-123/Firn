import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_endput

export { place, SpikeInfo, spike_in_chunk }

const SPIKES: i32 = 10

struct SpikeInfo {
    cx: i32,
    cz: i32,
    height: i32,
    radius: i32,
    guarded: bool,
}

fn center_x(i: i32) -> i32 {
    var xs: [i32; 10] = [42, 33, 12, 0 - 13, 0 - 34, 0 - 42, 0 - 34, 0 - 13, 12, 33]
    return xs[i as usize]
}

fn center_z(i: i32) -> i32 {
    var zs: [i32; 10] = [0, 24, 39, 39, 24, 0 - 1, 0 - 25, 0 - 40, 0 - 40, 0 - 25]
    return zs[i as usize]
}

fn shuffled_order(seed: i64, order: *mut [i32; 10]) {
    var lr: mg_random.Rng = mg_random.rng_legacy(seed)
    let key: i64 = mg_random.rng_next_long(&lr) & 65535
    var rr: mg_random.Rng = mg_random.rng_legacy(key)
    var i: i32 = 0
    while i < SPIKES {
        (*order)[i as usize] = i
        i = i + 1
    }
    i = SPIKES
    while i > 1 {
        let j: i32 = mg_random.rng_next_int_bound(&rr, i)
        let tmp: i32 = (*order)[(i - 1) as usize]
        (*order)[(i - 1) as usize] = (*order)[j as usize]
        (*order)[j as usize] = tmp
        i = i - 1
    }
}

fn place_cage(r: *mut wgft_region.Region, bars: *[u16; 16], cx: i32, cz: i32, height: i32) {
    var dx: i32 = 0 - 2
    while dx <= 2 {
        var dz: i32 = 0 - 2
        while dz <= 2 {
            var l: i32 = 0
            while l <= 3 {
                let edge_x: bool = dx == 2 || dx == (0 - 2)
                let edge_z: bool = dz == 2 || dz == (0 - 2)
                let top: bool = l == 3
                if edge_x || edge_z || top {
                    let ns: bool = edge_x || top
                    let ew: bool = edge_z || top
                    var idx: usize = 0
                    if ns && dz != (0 - 2) { idx = idx | 1 }
                    if ns && dz != 2 { idx = idx | 2 }
                    if ew && dx != (0 - 2) { idx = idx | 4 }
                    if ew && dx != 2 { idx = idx | 8 }
                    wgft_endput.put(r, cx + dx, height + l, cz + dz, (*bars)[idx])
                }
                l = l + 1
            }
            dz = dz + 1
        }
        dx = dx + 1
    }
}

fn place_spike(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, cx: i32, cz: i32, radius: i32, height: i32, guarded: bool) {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    let obsidian: u16 = (*f).p[0] as u16
    let bedrock: u16 = (*f).p[1] as u16
    let air: u16 = (*ft).air_code as u16
    var x: i32 = cx - radius
    while x <= cx + radius {
        var z: i32 = cz - radius
        while z <= cz + radius {
            let inside: bool = (x - cx) * (x - cx) + (z - cz) * (z - cz) <= radius * radius + 1
            var y: i32 = (*r).min_y
            while y <= height + 10 {
                if inside && y < height {
                    wgft_endput.put(r, x, y, z, obsidian)
                } else if y > 65 {
                    wgft_endput.put(r, x, y, z, air)
                }
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
    if guarded { place_cage(r, &(*ft).end_bars, cx, cz, height) }
    mg_random.rng_next_float((*c).rng)
    wgft_endput.put(r, cx, height, cz, bedrock)
}

fn spike_in_chunk(seed: i64, chunk_x: i32, chunk_z: i32, out: *mut SpikeInfo) -> bool {
    var order: [i32; 10] = [0; 10]
    shuffled_order(seed, &order)
    var i: i32 = 0
    while i < SPIKES {
        let cx: i32 = center_x(i)
        let cz: i32 = center_z(i)
        if (cx >> 4) == chunk_x && (cz >> 4) == chunk_z {
            let k: i32 = order[i as usize]
            *out = SpikeInfo { cx: cx, cz: cz, height: 76 + k * 3, radius: 2 + k / 3, guarded: k == 1 || k == 2 }
            return true
        }
        i = i + 1
    }
    return false
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    var order: [i32; 10] = [0; 10]
    shuffled_order((*c).seed, &order)
    var i: i32 = 0
    while i < SPIKES {
        let cx: i32 = center_x(i)
        let cz: i32 = center_z(i)
        if (cx >> 4) == (x >> 4) && (cz >> 4) == (z >> 4) {
            let k: i32 = order[i as usize]
            place_spike(c, f, cx, cz, 2 + k / 3, 76 + k * 3, k == 1 || k == 2)
        }
        i = i + 1
    }
    return true
}
