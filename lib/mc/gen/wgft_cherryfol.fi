import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_jset
import mc.gen.wgft_leaf
import mc.gen.wgft_tscratch
import mc.gen.wgft_trunk

export { place_cherry }

fn abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

#[allow_fp]
fn skip(rng: *mut mg_random.Rng, c: *wgft_def.CherryCfg, dx: i32, dy: i32, dz: i32, radius: i32) -> bool {
    if dy == 0 - 1 && (dx == radius || dz == radius) && mg_random.rng_next_float(rng) < (*c).wide_hole { return true }
    let corner: bool = dx == radius && dz == radius
    if radius > 2 { return corner || (dx + dz > radius * 2 - 2 && mg_random.rng_next_float(rng) < (*c).corner_hole) }
    return corner && mg_random.rng_next_float(rng) < (*c).corner_hole
}

fn row(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, radius: i32, dy: i32) {
    var dx: i32 = 0 - radius
    while dx <= radius {
        var dz: i32 = 0 - radius
        while dz <= radius {
            if !skip(rng, &(*t).cherry, abs_i32(dx), dy, abs_i32(dz), radius) { wgft_leaf.try_place_leaf(r, sc, t, ox + dx, oy + dy, oz + dz) }
            dz = dz + 1
        }
        dx = dx + 1
    }
}

#[allow_fp]
fn try_extension(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, chance: f32, ox: i32, oy: i32, oz: i32, x: i32, y: i32, z: i32) -> bool {
    if abs_i32(x - ox) + abs_i32(y - (oy - 1)) + abs_i32(z - oz) >= 7 { return false }
    if mg_random.rng_next_float(rng) > chance { return false }
    return wgft_leaf.try_place_leaf(r, sc, t, x, y, z)
}

fn hanging(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, radius: i32, dy: i32) {
    row(r, sc, rng, t, ox, oy, oz, radius, dy)
    let c: *wgft_def.CherryCfg = &(*t).cherry
    var d: i32 = 0
    while d < 4 {
        let cw: i32 = (d + 1) % 4
        var px: i32 = ox + wgft_trunk.step_x(cw) * radius - wgft_trunk.step_x(d) * radius
        var pz: i32 = oz + wgft_trunk.step_z(cw) * radius - wgft_trunk.step_z(d) * radius
        let py: i32 = oy + dy - 1
        var k: i32 = 0 - radius
        while k < radius {
            if wgft_jset.js_contains(&(*sc).foliage, px, py + 1, pz) {
                if try_extension(r, sc, rng, t, (*c).hang, ox, oy, oz, px, py, pz) {
                    try_extension(r, sc, rng, t, (*c).hang_ext, ox, oy, oz, px, py - 1, pz)
                }
            }
            k = k + 1
            px = px + wgft_trunk.step_x(d)
            pz = pz + wgft_trunk.step_z(d)
        }
        d = d + 1
    }
}

fn place_cherry(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32, radius_off: i32) {
    let py: i32 = oy + off
    let rr: i32 = radius + radius_off - 1
    row(r, sc, rng, t, ox, py, oz, rr - 2, fh - 3)
    row(r, sc, rng, t, ox, py, oz, rr - 1, fh - 4)
    var yy: i32 = fh - 5
    while yy >= 0 {
        row(r, sc, rng, t, ox, py, oz, rr, yy)
        yy = yy - 1
    }
    hanging(r, sc, rng, t, ox, py, oz, rr, 0 - 1)
    hanging(r, sc, rng, t, ox, py, oz, rr - 1, 0 - 2)
}
