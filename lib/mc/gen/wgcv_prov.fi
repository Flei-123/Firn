import mc.gen.mg_random
import mc.gen.wgcv_def

export { fp_const, fp_uniform, fp_trapezoid, fp_sample, sample_y_uniform }

fn fp_const(v: f32) -> wgcv_def.Fp {
    return wgcv_def.Fp { kind: wgcv_def.FP_CONST, a: v, b: 0.0f, c: 0.0f }
}

fn fp_uniform(lo: f32, hi: f32) -> wgcv_def.Fp {
    return wgcv_def.Fp { kind: wgcv_def.FP_UNIFORM, a: lo, b: hi, c: 0.0f }
}

fn fp_trapezoid(lo: f32, hi: f32, plateau: f32) -> wgcv_def.Fp {
    return wgcv_def.Fp { kind: wgcv_def.FP_TRAPEZOID, a: lo, b: hi, c: plateau }
}

#[allow_fp]
fn fp_sample(r: *mut mg_random.Rng, p: *wgcv_def.Fp) -> f32 {
    if (*p).kind == wgcv_def.FP_CONST { return (*p).a }
    if (*p).kind == wgcv_def.FP_UNIFORM {
        let f: f32 = mg_random.rng_next_float(r)
        return f * ((*p).b - (*p).a) + (*p).a
    }
    let span: f32 = (*p).b - (*p).a
    let side: f32 = (span - (*p).c) / 2.0f
    let mid: f32 = span - side
    let f1: f32 = mg_random.rng_next_float(r)
    let f2: f32 = mg_random.rng_next_float(r)
    return (*p).a + f1 * mid + f2 * side
}

fn sample_y_uniform(r: *mut mg_random.Rng, lo: i32, hi: i32) -> i32 {
    if lo > hi { return lo }
    return mg_random.rng_next_int_bound(r, hi - lo + 1) + lo
}
