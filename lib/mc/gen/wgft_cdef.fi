export { HeightCfg, ColCfg, MAX_COLS, MAX_COL_LAYERS, MAX_HEIGHT_ENTRIES }

const MAX_COLS: usize = 48
const MAX_COL_LAYERS: usize = 3
const MAX_HEIGHT_ENTRIES: usize = 4

struct HeightCfg {
    weighted: bool,
    n: usize,
    lo: [i32; 4],
    hi: [i32; 4],
    uni: [bool; 4],
    w: [i32; 4],
    total: i32,
}

struct ColCfg {
    dir: i32,
    nlayers: usize,
    allowed: i32,
    tip: bool,
    heights: [HeightCfg; 3],
    prov: [i32; 3],
}
