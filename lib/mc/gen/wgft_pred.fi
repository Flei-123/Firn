import mc.gen.wgft_def
import mc.gen.wgft_region

export { test }

fn test(r: *mut wgft_region.Region, pi: i32, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    let p: *wgft_def.Pred = &(*ft).preds[pi as usize]
    let px: i32 = x + (*p).ox
    let py: i32 = y + (*p).oy
    let pz: i32 = z + (*p).oz
    let k: u8 = (*p).kind
    if k == wgft_def.PK_TRUE { return true }
    if k == wgft_def.PK_MATCH { return (*ft).masks[(*p).mask as usize][wgft_region.block_at(r, px, py, pz) as usize] }
    if k == wgft_def.PK_SOLID { return (*ft).motion[wgft_region.block_at(r, px, py, pz) as usize] && !(*ft).fluid[wgft_region.block_at(r, px, py, pz) as usize] }
    if k == wgft_def.PK_WATER { return wgft_region.block_at(r, px, py, pz) == (*ft).water_code }
    if k == wgft_def.PK_INSIDE { return py >= (*ft).min_y && py < (*ft).min_y + (*ft).height }
    if k == wgft_def.PK_SURVIVE { return (*ft).dirt[wgft_region.block_at(r, px, py - 1, pz) as usize] }
    if k == wgft_def.PK_NOT { return !test(r, (*p).kids[0], x, y, z) }
    var i: usize = 0
    if k == wgft_def.PK_ANY {
        while i < (*p).n {
            if test(r, (*p).kids[i], x, y, z) { return true }
            i = i + 1
        }
        return false
    }
    while i < (*p).n {
        if !test(r, (*p).kids[i], x, y, z) { return false }
        i = i + 1
    }
    return true
}
