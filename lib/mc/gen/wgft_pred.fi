import mc.gen.wgft_def
import mc.gen.wgft_region

export { test, sturdy_face }

fn sturdy_face(ft: *wgft_def.FtDef, face: i32, code: u16) -> bool {
    if face == wgft_def.FACE_UP { return (*ft).sturdy_up[code as usize] }
    if face == wgft_def.FACE_DOWN { return (*ft).sturdy_down[code as usize] }
    return (*ft).sturdy_side[code as usize]
}

fn test(r: *mut wgft_region.Region, pi: i32, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    let p: *wgft_def.Pred = &(*ft).preds[pi as usize]
    let px: i32 = x + (*p).ox
    let py: i32 = y + (*p).oy
    let pz: i32 = z + (*p).oz
    let k: u8 = (*p).kind
    if k == wgft_def.PK_TRUE { return true }
    if k == wgft_def.PK_MATCH { return (*ft).masks[(*p).mask as usize][wgft_region.block_at(r, px, py, pz) as usize] }
    if k == wgft_def.PK_SOLID { return (*ft).is_solid[wgft_region.block_at(r, px, py, pz) as usize] }
    if k == wgft_def.PK_STURDY { return sturdy_face(ft, (*p).mask, wgft_region.block_at(r, px, py, pz)) }
    if k == wgft_def.PK_WATER { return wgft_region.block_at(r, px, py, pz) == (*ft).water_code }
    if k == wgft_def.PK_INSIDE { return py >= (*ft).min_y && py < (*ft).min_y + (*ft).height }
    if k == wgft_def.PK_SURVIVE {
        let below: u16 = wgft_region.block_at(r, px, py - 1, pz)
        return (*ft).dirt[below as usize] || ((*p).mask > 0 && below as i32 == (*p).mask - 1)
    }
    if k == wgft_def.PK_NOT { return !test(r, (*p).kids[0], x, y, z) }
    var i: usize = 0
    if k == wgft_def.PK_ANY {
        while i < (*p).n {
            if test(r, (*p).kids[i], x, y, z) { return true }
            i = i + 1
        }
        return false
    }
    while i < (*p).n {
        if !test(r, (*p).kids[i], x, y, z) { return false }
        i = i + 1
    }
    return true
}
