import std.rt
import std.json
import std.jsonstr
import mc.gen.wgdf_load
import mc.gen.wgsr_def
import mc.gen.wgtag
import mc.gen.wgft_def

export { Ld, NONE_NODE, bare, push_op, num_or_fail, num_or_default, reg_code, names_mask, alloc_mask, blank_op, defer_tag_mask }

const NONE_NODE: u32 = 4294967295

struct Ld {
    def: *mut wgft_def.FtDef,
    sdef: *mut wgsr_def.SrDef,
    root: str,
    ok: bool,
}

fn bare(s: str) -> str {
    return wgdf_load.strip_ns(s)
}

fn blank_op(kind: u8) -> wgft_def.Op {
    return wgft_def.Op { kind: kind, a: 0, b: 0, c: 0, d: 0, e: 0, f: 0.0, g: 0.0, w: [0, 0, 0, 0], v: [0, 0, 0, 0] }
}

fn push_op(l: *mut Ld, f: *mut wgft_def.Feat, op: wgft_def.Op) {
    if (*f).nops >= wgft_def.MAX_OPS {
        (*l).ok = false
        return
    }
    (*f).ops[(*f).nops] = op
    (*f).nops = (*f).nops + 1
}

fn num_or_fail(l: *mut Ld, d: *mut json.Json, j: u32, key: str) -> i32 {
    let n: u32 = jsonstr.get(d, j, key)
    if n == NONE_NODE {
        (*l).ok = false
        return 0
    }
    return json.json_number(d, n) as i32
}

fn num_or_default(d: *mut json.Json, j: u32, key: str, fallback: i32) -> i32 {
    let n: u32 = jsonstr.get(d, j, key)
    if n == NONE_NODE { return fallback }
    return json.json_number(d, n) as i32
}

fn reg_code(l: *mut Ld, name: str) -> u16 {
    if name == "copper_ore" { return 67 }
    if name == "granite" { return 71 }
    if name == "deepslate_iron_ore" { return 73 }
    if name == "tuff" { return 84 }
    let c: i32 = wgsr_def.block_code((*l).sdef, name.p as u64, name.n)
    if c < 0 || c >= (wgsr_def.CODE_SPACE as i32) {
        (*l).ok = false
        return 0
    }
    return c as u16
}

fn alloc_mask(l: *mut Ld) -> i32 {
    let def: *mut wgft_def.FtDef = (*l).def
    if (*def).nmasks >= wgft_def.MAX_MASKS {
        (*l).ok = false
        return 0
    }
    let m: i32 = (*def).nmasks as i32
    (*def).nmasks = (*def).nmasks + 1
    var c: usize = 0
    while c < wgsr_def.CODE_SPACE {
        (*def).masks[m as usize][c] = false
        c = c + 1
    }
    return m
}

fn names_mask(l: *mut Ld, d: *mut json.Json, node: u32, out: i32) {
    let def: *mut wgft_def.FtDef = (*l).def
    var names: [str; 32] = [""; 32]
    var n: usize = 0
    if json.json_kind(d, node) == json.JSON_STRING {
        names[0] = bare(jsonstr.string(d, node))
        n = 1
    } else {
        let cnt: usize = json.json_count(d, node)
        var k: usize = 0
        while k < cnt && k < 32 {
            names[k] = bare(jsonstr.string(d, json.json_child_at(d, node, k)))
            k = k + 1
        }
        n = k
    }
    var i: usize = 0
    while i < n {
        reg_code(l, names[i])
        var tmp: [bool; 512] = [false; 512]
        wgtag.name_mask((*l).sdef, names[i], (&tmp[0]) as u64, (wgsr_def.CODE_SPACE as i32))
        var c: usize = 0
        while c < wgsr_def.CODE_SPACE {
            if tmp[c] { (*def).masks[out as usize][c] = true }
            c = c + 1
        }
        i = i + 1
    }
}

fn defer_tag_mask(l: *mut Ld, tag: str, mask: i32) {
    let def: *mut wgft_def.FtDef = (*l).def
    if (*def).ntagmasks >= 32 || tag.n > 40 {
        (*l).ok = false
        return
    }
    let i: usize = (*def).ntagmasks
    (*def).ntagmasks = i + 1
    (*def).tagmask_idx[i] = mask
    (*def).tagmask_len[i] = tag.n
    rt.mem_copy((&(*def).tagmask_name[i][0]) as u64, tag.p as u64, tag.n)
}
