import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_endput

export { place }

fn ceil_pos(v: f32) -> i32 {
    let t: i32 = v as i32
    if (t as f32) < v { return t + 1 }
    return t
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let code: u16 = (*f).p[0] as u16
    var radius: f32 = (mg_random.rng_next_int_bound((*c).rng, 3) as f32) + 4.0
    var layer: i32 = 0
    while radius > 0.5 {
        let hi: i32 = ceil_pos(radius)
        let lim: f32 = (radius + 1.0) * (radius + 1.0)
        var dx: i32 = 0 - hi
        while dx <= hi {
            var dz: i32 = 0 - hi
            while dz <= hi {
                if ((dx * dx + dz * dz) as f32) <= lim { wgft_endput.put(r, x + dx, y + layer, z + dz, code) }
                dz = dz + 1
            }
            dx = dx + 1
        }
        radius = radius - ((mg_random.rng_next_int_bound((*c).rng, 2) as f32) + 0.5)
        layer = layer - 1
    }
    return true
}
