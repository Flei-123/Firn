import std.json
import std.jsonstr
import mc.gen.wgft_def
import mc.gen.wgft_ldctx
import mc.gen.wgft_ldprov

export { load_bending, load_upwards, load_spread, load_root, load_attached }

const LOGS_TAG: str = "#minecraft:mangrove_logs_can_grow_through"
const ROOTS_TAG: str = "#minecraft:mangrove_roots_can_grow_through"

fn number_at(d: *mut json.Json, node: u32, key: str) -> f64 {
    return json.json_number(d, jsonstr.get(d, node, key))
}

#[allow_fp]
fn load_upwards(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, node: u32) {
    (*t).trunk = wgft_def.TK_UPWARDS
    let u: *mut wgft_def.UpwardsCfg = &(*t).upwards
    (*u).prob = number_at(d, node, "place_branch_per_log_probability") as f32
    (*u).len_uni = wgft_ldprov.int_range(l, d, jsonstr.get(d, node, "extra_branch_length"), &(*u).len_lo, &(*u).len_hi)
    (*u).steps_uni = wgft_ldprov.int_range(l, d, jsonstr.get(d, node, "extra_branch_steps"), &(*u).steps_lo, &(*u).steps_hi)
    if jsonstr.string(d, jsonstr.get(d, node, "can_grow_through")) != LOGS_TAG { (*l).ok = false }
}

fn load_bending(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, node: u32) {
    (*t).bend.min_leaf = 1
    let ml: u32 = jsonstr.get(d, node, "min_height_for_leaves")
    if ml != wgft_ldctx.NONE_NODE { (*t).bend.min_leaf = json.json_number(d, ml) as i32 }
    (*t).bend.uni = wgft_ldprov.int_range(l, d, jsonstr.get(d, node, "bend_length"), &(*t).bend.lo, &(*t).bend.hi)
}

fn load_spread(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, node: u32) {
    (*t).fol = wgft_def.FL_SPREAD
    (*t).h_uni = wgft_ldprov.int_range(l, d, jsonstr.get(d, node, "foliage_height"), &(*t).h_lo, &(*t).h_hi)
    (*t).spread_attempts = wgft_ldctx.num_or_fail(l, d, node, "leaf_placement_attempts")
}

#[allow_fp]
fn load_above(l: *mut wgft_ldctx.Ld, c: *mut wgft_def.RootCfg, d: *mut json.Json, node: u32) {
    let above: u32 = jsonstr.get(d, node, "above_root_placement")
    if above == wgft_ldctx.NONE_NODE { return }
    (*c).above_present = true
    (*c).above_chance = number_at(d, above, "above_root_placement_chance") as f32
    let st: u32 = wgft_ldprov.provider_state(l, d, jsonstr.get(d, above, "above_root_provider"))
    (*c).above_code = wgft_ldctx.reg_code(l, wgft_ldprov.state_name(d, st))
}

#[allow_fp]
fn load_root(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, node: u32) {
    if node == wgft_ldctx.NONE_NODE { return }
    if wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, node, "type"))) != "mangrove_root_placer" {
        (*l).ok = false
        return
    }
    let c: *mut wgft_def.RootCfg = &(*t).root
    (*c).present = true
    (*c).off_uni = wgft_ldprov.int_range(l, d, jsonstr.get(d, node, "trunk_offset_y"), &(*c).off_lo, &(*c).off_hi)
    let place: u32 = jsonstr.get(d, node, "mangrove_root_placement")
    (*c).max_len = wgft_ldctx.num_or_fail(l, d, place, "max_root_length")
    (*c).max_width = wgft_ldctx.num_or_fail(l, d, place, "max_root_width")
    (*c).skew = number_at(d, place, "random_skew_chance") as f32
    if jsonstr.string(d, jsonstr.get(d, place, "can_grow_through")) != ROOTS_TAG { (*l).ok = false }
    let root: u32 = wgft_ldprov.provider_state(l, d, jsonstr.get(d, node, "root_provider"))
    let root_name: str = wgft_ldprov.state_name(d, root)
    (*c).root_code = wgft_ldctx.reg_code(l, root_name)
    (*c).root_wet_code = wgft_ldprov.reg_joined(l, root_name, "[waterlogged=true]")
    let muddy: u32 = wgft_ldprov.provider_state(l, d, jsonstr.get(d, place, "muddy_roots_provider"))
    (*c).muddy_code = wgft_ldctx.reg_code(l, wgft_ldprov.state_name(d, muddy))
    (*c).mud_code = wgft_ldctx.reg_code(l, "mud")
    load_above(l, c, d, node)
}

fn direction_index(name: str) -> u8 {
    if name == "down" { return 0 }
    if name == "up" { return 1 }
    if name == "north" { return 2 }
    if name == "south" { return 3 }
    if name == "west" { return 4 }
    return 5
}

#[allow_fp]
fn load_attached(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, dec: u32) {
    if (*t).ndecos >= wgft_def.MAX_DECOS {
        (*l).ok = false
        return
    }
    let prov: u32 = jsonstr.get(d, dec, "block_provider")
    var age_lo: i32 = 0
    var age_hi: i32 = 0
    var age_n: i32 = 0
    var source: u32 = prov
    if wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, prov, "type"))) == "randomized_int_state_provider" {
        if jsonstr.string(d, jsonstr.get(d, prov, "property")) != "age" { (*l).ok = false }
        if wgft_ldprov.int_range(l, d, jsonstr.get(d, prov, "values"), &age_lo, &age_hi) { age_n = age_hi - age_lo + 1 }
        source = jsonstr.get(d, prov, "source")
    }
    let st: u32 = wgft_ldprov.provider_state(l, d, source)
    var cfg: wgft_def.DecoCfg = wgft_def.DecoCfg {
        kind: wgft_def.DK_ATTACHED,
        code: wgft_ldctx.reg_code(l, wgft_ldprov.state_name(d, st)),
        prob: number_at(d, dec, "probability") as f32,
        ex_xz: wgft_ldctx.num_or_fail(l, d, dec, "exclusion_radius_xz"),
        ex_y: wgft_ldctx.num_or_fail(l, d, dec, "exclusion_radius_y"),
        empty: wgft_ldctx.num_or_fail(l, d, dec, "required_empty_blocks"),
        age_n: age_n,
        ndirs: 0,
        dirs: [0 as u8; 6],
    }
    let dirs: u32 = jsonstr.get(d, dec, "directions")
    let n: usize = json.json_count(d, dirs)
    if n == 0 || n > 6 { (*l).ok = false }
    var i: usize = 0
    while i < n && i < 6 {
        cfg.dirs[i] = direction_index(wgft_ldctx.bare(jsonstr.string(d, json.json_child_at(d, dirs, i))))
        cfg.ndirs = i + 1
        i = i + 1
    }
    (*t).decos[(*t).ndecos] = cfg
    (*t).ndecos = (*t).ndecos + 1
}
