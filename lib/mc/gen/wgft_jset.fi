// SPDX-License-Identifier: MPL-2.0
export { JSet, NODE_CAP, js_clear, js_add, js_contains, js_pop_first, js_collect }

const NODE_CAP: usize = 3072
const TABLE_CAP: usize = 4096
const MIN_TABLE: usize = 16
const TREEIFY_MIN_TABLE: usize = 64

struct JSet {
    cap: usize,
    size: usize,
    low: usize,
    used: usize,
    free: i32,
    head: [i32; 4096],
    kx: [i32; 3072],
    ky: [i32; 3072],
    kz: [i32; 3072],
    hs: [i64; 3072],
    nx: [i32; 3072],
}

fn spread(x: i32, y: i32, z: i32) -> i64 {
    let h: i64 = ((((y as i64) + (z as i64) * 31) * 31) + (x as i64)) & 4294967295
    return h ^ (h >> 16)
}

fn js_clear(s: *mut JSet) {
    (*s).cap = MIN_TABLE
    (*s).size = 0
    (*s).low = MIN_TABLE
    (*s).used = 0
    (*s).free = 0 - 1
    var i: usize = 0
    while i < MIN_TABLE {
        (*s).head[i] = 0 - 1
        i = i + 1
    }
}

fn resize(s: *mut JSet) {
    let old: usize = (*s).cap
    if old * 2 > TABLE_CAP { return }
    var j: usize = 0
    while j < old {
        var lo_head: i32 = 0 - 1
        var lo_tail: i32 = 0 - 1
        var hi_head: i32 = 0 - 1
        var hi_tail: i32 = 0 - 1
        var n: i32 = (*s).head[j]
        while n >= 0 {
            let next: i32 = (*s).nx[n as usize]
            (*s).nx[n as usize] = 0 - 1
            if ((*s).hs[n as usize] & (old as i64)) == 0 {
                if lo_tail < 0 { lo_head = n } else { (*s).nx[lo_tail as usize] = n }
                lo_tail = n
            } else {
                if hi_tail < 0 { hi_head = n } else { (*s).nx[hi_tail as usize] = n }
                hi_tail = n
            }
            n = next
        }
        (*s).head[j] = lo_head
        (*s).head[j + old] = hi_head
        j = j + 1
    }
    (*s).cap = old * 2
    (*s).low = 0
}

fn js_add(s: *mut JSet, x: i32, y: i32, z: i32) -> bool {
    let h: i64 = spread(x, y, z)
    let idx: usize = (h & (((*s).cap as i64) - 1)) as usize
    var n: i32 = (*s).head[idx]
    var last: i32 = 0 - 1
    var count: usize = 0
    while n >= 0 {
        let u: usize = n as usize
        if (*s).kx[u] == x && (*s).ky[u] == y && (*s).kz[u] == z { return false }
        last = n
        n = (*s).nx[u]
        count = count + 1
    }
    var node: i32 = 0 - 1
    if (*s).free >= 0 {
        node = (*s).free
        (*s).free = (*s).nx[node as usize]
    } else if (*s).used < NODE_CAP {
        node = (*s).used as i32
        (*s).used = (*s).used + 1
    } else {
        return false
    }
    let u: usize = node as usize
    (*s).kx[u] = x
    (*s).ky[u] = y
    (*s).kz[u] = z
    (*s).hs[u] = h
    (*s).nx[u] = 0 - 1
    if last < 0 { (*s).head[idx] = node } else { (*s).nx[last as usize] = node }
    if idx < (*s).low { (*s).low = idx }
    (*s).size = (*s).size + 1
    if count >= 8 && (*s).cap < TREEIFY_MIN_TABLE { resize(s) }
    if (*s).size > ((*s).cap * 3) / 4 { resize(s) }
    return true
}

fn js_contains(s: *JSet, x: i32, y: i32, z: i32) -> bool {
    let h: i64 = spread(x, y, z)
    let idx: usize = (h & (((*s).cap as i64) - 1)) as usize
    var n: i32 = (*s).head[idx]
    while n >= 0 {
        let u: usize = n as usize
        if (*s).kx[u] == x && (*s).ky[u] == y && (*s).kz[u] == z { return true }
        n = (*s).nx[u]
    }
    return false
}

fn js_pop_first(s: *mut JSet, out: *mut [i32; 3]) -> bool {
    var b: usize = (*s).low
    while b < (*s).cap && (*s).head[b] < 0 {
        b = b + 1
    }
    (*s).low = b
    if b >= (*s).cap { return false }
    let node: i32 = (*s).head[b]
    let u: usize = node as usize
    (*out)[0] = (*s).kx[u]
    (*out)[1] = (*s).ky[u]
    (*out)[2] = (*s).kz[u]
    (*s).head[b] = (*s).nx[u]
    (*s).nx[u] = (*s).free
    (*s).free = node
    (*s).size = (*s).size - 1
    return true
}

fn js_collect(s: *JSet, xs: *mut [i32; 3072], ys: *mut [i32; 3072], zs: *mut [i32; 3072]) -> usize {
    var count: usize = 0
    var b: usize = 0
    while b < (*s).cap {
        var n: i32 = (*s).head[b]
        while n >= 0 {
            let u: usize = n as usize
            (*xs)[count] = (*s).kx[u]
            (*ys)[count] = (*s).ky[u]
            (*zs)[count] = (*s).kz[u]
            count = count + 1
            n = (*s).nx[u]
        }
        b = b + 1
    }
    return count
}
