// SPDX-License-Identifier: MPL-2.0
import mc.gen.wgft_jdef
import mc.gen.wgft_jtree

export { js_clear, js_add, js_contains, js_pop_first, js_collect }

fn js_clear(s: *mut wgft_jdef.JSet) {
    (*s).cap = wgft_jdef.MIN_TABLE
    (*s).size = 0
    (*s).low = wgft_jdef.MIN_TABLE
    (*s).used = 0
    (*s).free = 0 - 1
    var i: usize = 0
    while i < wgft_jdef.MIN_TABLE {
        (*s).head[i] = 0 - 1
        (*s).tree[i] = false
        i = i + 1
    }
}

fn split_plain_bin(s: *mut wgft_jdef.JSet, j: usize, old: usize) {
    var lo_head: i32 = 0 - 1
    var lo_tail: i32 = 0 - 1
    var hi_head: i32 = 0 - 1
    var hi_tail: i32 = 0 - 1
    var n: i32 = (*s).head[j]
    while n >= 0 {
        let next: i32 = (*s).nx[n as usize]
        (*s).nx[n as usize] = 0 - 1
        if ((*s).hs[n as usize] & (old as i64)) == 0 {
            if lo_tail < 0 { lo_head = n } else { (*s).nx[lo_tail as usize] = n }
            lo_tail = n
        } else {
            if hi_tail < 0 { hi_head = n } else { (*s).nx[hi_tail as usize] = n }
            hi_tail = n
        }
        n = next
    }
    (*s).head[j] = lo_head
    (*s).head[j + old] = hi_head
    (*s).tree[j] = false
    (*s).tree[j + old] = false
}

fn resize(s: *mut wgft_jdef.JSet) {
    let old: usize = (*s).cap
    if old * 2 > wgft_jdef.TABLE_CAP { return }
    (*s).cap = old * 2
    (*s).low = 0
    var j: usize = 0
    while j < old {
        if (*s).tree[j] {
            wgft_jtree.split_tree_bin(s, j, old)
        } else {
            split_plain_bin(s, j, old)
        }
        j = j + 1
    }
}

fn js_add(s: *mut wgft_jdef.JSet, x: i32, y: i32, z: i32) -> bool {
    let h: i64 = wgft_jdef.spread_hash(x, y, z)
    let idx: usize = (h & (((*s).cap as i64) - 1)) as usize
    var n: i32 = (*s).head[idx]
    var last: i32 = 0 - 1
    var count: usize = 0
    while n >= 0 {
        let u: usize = n as usize
        if (*s).kx[u] == x && (*s).ky[u] == y && (*s).kz[u] == z { return false }
        last = n
        n = (*s).nx[u]
        count = count + 1
    }
    var node: i32 = 0 - 1
    if (*s).free >= 0 {
        node = (*s).free
        (*s).free = (*s).nx[node as usize]
    } else if (*s).used < wgft_jdef.NODE_CAP {
        node = (*s).used as i32
        (*s).used = (*s).used + 1
    } else {
        return false
    }
    let u: usize = node as usize
    (*s).kx[u] = x
    (*s).ky[u] = y
    (*s).kz[u] = z
    (*s).hs[u] = h
    (*s).nx[u] = 0 - 1
    (*s).pv[u] = 0 - 1
    (*s).lf[u] = 0 - 1
    (*s).rt[u] = 0 - 1
    (*s).pr[u] = 0 - 1
    (*s).rd[u] = false
    let was_tree: bool = (*s).tree[idx]
    if last < 0 {
        (*s).head[idx] = node
    } else if was_tree {
        wgft_jtree.tree_insert(s, idx, node)
    } else {
        (*s).nx[last as usize] = node
    }
    if idx < (*s).low { (*s).low = idx }
    (*s).size = (*s).size + 1
    if !was_tree && count >= wgft_jdef.TREEIFY_COUNT {
        if (*s).cap < wgft_jdef.TREEIFY_MIN_TABLE { resize(s) } else { wgft_jtree.treeify_bin(s, idx) }
    }
    if (*s).size > ((*s).cap * 3) / 4 { resize(s) }
    return true
}

fn js_contains(s: *wgft_jdef.JSet, x: i32, y: i32, z: i32) -> bool {
    let h: i64 = wgft_jdef.spread_hash(x, y, z)
    let idx: usize = (h & (((*s).cap as i64) - 1)) as usize
    var n: i32 = (*s).head[idx]
    while n >= 0 {
        let u: usize = n as usize
        if (*s).kx[u] == x && (*s).ky[u] == y && (*s).kz[u] == z { return true }
        n = (*s).nx[u]
    }
    return false
}

fn js_pop_first(s: *mut wgft_jdef.JSet, out: *mut [i32; 3]) -> bool {
    var b: usize = (*s).low
    while b < (*s).cap && (*s).head[b] < 0 {
        b = b + 1
    }
    (*s).low = b
    if b >= (*s).cap { return false }
    (*s).tree[b] = false
    let node: i32 = (*s).head[b]
    let u: usize = node as usize
    (*out)[0] = (*s).kx[u]
    (*out)[1] = (*s).ky[u]
    (*out)[2] = (*s).kz[u]
    (*s).head[b] = (*s).nx[u]
    (*s).nx[u] = (*s).free
    (*s).free = node
    (*s).size = (*s).size - 1
    return true
}

fn js_collect(s: *wgft_jdef.JSet, xs: *mut [i32; 3072], ys: *mut [i32; 3072], zs: *mut [i32; 3072]) -> usize {
    var count: usize = 0
    var b: usize = 0
    while b < (*s).cap {
        var n: i32 = (*s).head[b]
        while n >= 0 {
            let u: usize = n as usize
            (*xs)[count] = (*s).kx[u]
            (*ys)[count] = (*s).ky[u]
            (*zs)[count] = (*s).kz[u]
            count = count + 1
            n = (*s).nx[u]
        }
        b = b + 1
    }
    return count
}
