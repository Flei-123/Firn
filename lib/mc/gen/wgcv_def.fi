import std.rt
import std.math
import mc.gen.wgdf_graph

export {
    Fp, Carver, CvDef, KIND_CAVE, KIND_NETHER, KIND_CANYON, FP_CONST, FP_UNIFORM, FP_TRAPEZOID,
    MAX_CARVERS, MAX_PER_BIOME, MAX_BIOMES, def_bytes, def_new, def_free, sin_f, cos_f, find_carver,
}

const KIND_CAVE: u8 = 0
const KIND_NETHER: u8 = 1
const KIND_CANYON: u8 = 2
const FP_CONST: u8 = 0
const FP_UNIFORM: u8 = 1
const FP_TRAPEZOID: u8 = 2
const MAX_CARVERS: usize = 4
const MAX_PER_BIOME: usize = 4
const MAX_BIOMES: usize = 96

struct Fp {
    kind: u8,
    a: f32,
    b: f32,
    c: f32,
}

struct Carver {
    kind: u8,
    prob: f32,
    y_lo: i32,
    y_hi: i32,
    lava: i32,
    hr: Fp,
    vr: Fp,
    floor: Fp,
    yscale: Fp,
    dist: Fp,
    hrf: Fp,
    vrot: Fp,
    thick: Fp,
    vrc: f32,
    vrd: f32,
    smooth: i32,
    repl: [bool; 256],
}

struct CvDef {
    n: usize,
    carvers: [Carver; 4],
    cname: [[u8; 40]; 4],
    clen: [usize; 4],
    nbio: usize,
    bio_n: [u8; 96],
    bio_c: [[u8; 4]; 96],
    code_cave_air: u8,
    code_grass: i32,
    code_mycelium: i32,
    code_dirt: i32,
    min_y: i32,
    height: i32,
    sin: [f32; 65536],
}

fn def_bytes() -> usize {
    return wgdf_graph.wg_size_of[CvDef]()
}

#[allow_fp]
fn def_new(min_y: i32, height: i32) -> *mut CvDef {
    let d: *mut CvDef = rt.heap_alloc(def_bytes()) as *mut CvDef
    rt.mem_set(d as u64, 0 as u8, def_bytes())
    (*d).min_y = min_y
    (*d).height = height
    let pi: f64 = 3.141592653589793
    var i: usize = 0
    while i < 65536 {
        (*d).sin[i] = math.sin((i as f64) * pi * 2.0 / 65536.0) as f32
        i = i + 1
    }
    return d
}

fn def_free(d: *mut CvDef) {
    rt.heap_free(d as u64, def_bytes())
}

#[allow_fp]
fn sin_f(d: *CvDef, f: f32) -> f32 {
    let k: i32 = (f * 10430.378f) as i32
    return (*d).sin[(k & 65535) as usize]
}

#[allow_fp]
fn cos_f(d: *CvDef, f: f32) -> f32 {
    let k: i32 = (f * 10430.378f + 16384.0f) as i32
    return (*d).sin[(k & 65535) as usize]
}

fn find_carver(d: *CvDef, p: u64, n: usize) -> i32 {
    var i: usize = 0
    while i < (*d).n {
        if (*d).clen[i] == n && rt.mem_eq((&(*d).cname[i][0]) as u64, p, n) { return i as i32 }
        i = i + 1
    }
    return 0 - 1
}
