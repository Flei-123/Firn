import std.mem
import std.rt

export { MEMO_ENTRIES, MEMO_BYTES, memo_get, memo_put, memo_release }

const MEMO_ENTRIES: usize = 16384
const MEMO_STRIDE: usize = 24
const MEMO_BYTES: usize = 16384 * 24

fn memo_index(n: i32, x: i32, z: i32) -> usize {
    let h: i32 = (x *% 73856093) ^ (z *% 19349663) ^ (n *% 83492791)
    return ((h ^ (h >> 14)) & 16383) as usize
}

fn memo_get(slot: *mut u64, n: i32, x: i32, z: i32, out: *mut f64) -> bool {
    if *slot == 0 { return false }
    let e: u64 = *slot + ((memo_index(n, x, z) * MEMO_STRIDE) as u64)
    if *(e as *mut i32) == n && *((e + 4 as u64) as *mut i32) == x && *((e + 8 as u64) as *mut i32) == z {
        *out = *((e + 16 as u64) as *mut f64)
        return true
    }
    return false
}

fn memo_put(slot: *mut u64, n: i32, x: i32, z: i32, v: f64) {
    if *slot == 0 {
        *slot = mem.alloc(MEMO_BYTES)
        rt.mem_set(*slot, 255 as u8, MEMO_BYTES)
    }
    let e: u64 = *slot + ((memo_index(n, x, z) * MEMO_STRIDE) as u64)
    *(e as *mut i32) = n
    *((e + 4 as u64) as *mut i32) = x
    *((e + 8 as u64) as *mut i32) = z
    *((e + 16 as u64) as *mut f64) = v
}

fn memo_release(slot: *mut u64) {
    if *slot != 0 {
        mem.free(*slot, MEMO_BYTES)
        *slot = 0
    }
}
