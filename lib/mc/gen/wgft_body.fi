import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_ore
import mc.gen.wgft_simple
import mc.gen.wgft_disk
import mc.gen.wgft_spring
import mc.gen.wgft_freeze
import mc.gen.wgft_lake
import mc.gen.wgft_tree
import mc.gen.wgft_mush
import mc.gen.wgft_bamboo
import mc.gen.wgft_column
import mc.gen.wgft_vinefeat

export { run_body }

fn run_body(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let k: u8 = (*f).kind
    if k == wgft_def.FK_ORE {
        wgft_ore.place_ore((*c).r, (*c).rng, f, x, y, z)
        return true
    }
    if k == wgft_def.FK_SCATTERED {
        wgft_ore.place_scattered((*c).r, (*c).rng, f, x, y, z)
        return true
    }
    if k == wgft_def.FK_SIMPLE_BLOCK { return wgft_simple.place(c, f, x, y, z) }
    if k == wgft_def.FK_DISK { return wgft_disk.place(c, f, x, y, z) }
    if k == wgft_def.FK_SPRING { return wgft_spring.place(c, f, x, y, z) }
    if k == wgft_def.FK_FREEZE { return wgft_freeze.place(c, f, x, y, z) }
    if k == wgft_def.FK_LAKE { return wgft_lake.place(c, f, x, y, z) }
    if k == wgft_def.FK_TREE { return wgft_tree.place(c, f, x, y, z) }
    if k == wgft_def.FK_MUSHROOM { return wgft_mush.place(c, f, x, y, z) }
    if k == wgft_def.FK_BAMBOO { return wgft_bamboo.place(c, f, x, y, z) }
    if k == wgft_def.FK_COLUMN { return wgft_column.place(c, f, x, y, z) }
    if k == wgft_def.FK_VINES { return wgft_vinefeat.place(c, f, x, y, z) }
    return false
}
