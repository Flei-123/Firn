// SPDX-License-Identifier: MPL-2.0
import noise.perlin
import mc.gen.mg_random
import mc.gen.wgft_pdef
import mc.gen.wgft_def

export { pick }

#[allow_fp]
fn noise_at(n: *perlin.Normal, x: f64, y: f64, z: f64, s: f64) -> f64 {
    return perlin.normal_value(n, x * s, y * s, z * s)
}

#[allow_fp]
fn state_index(v: f64, n: usize) -> usize {
    var t: f64 = (1.0 + v) / 2.0
    if t < 0.0 { t = 0.0 }
    if t > 0.9999 { t = 0.9999 }
    return ((t * (n as f64)) as i32) as usize
}

#[allow_fp]
fn slow_at(ft: *wgft_def.FtDef, p: *wgft_pdef.StateProv, x: i32, y: i32, z: i32) -> f64 {
    let s: f32 = (*p).slow_scale
    return perlin.normal_value(&(*ft).noises[(*p).slow as usize], (((x as f32) * s) as f64), (((y as f32) * s) as f64), (((z as f32) * s) as f64))
}

#[allow_fp]
fn variety_count(p: *wgft_pdef.StateProv, v: f64) -> usize {
    let lo: f64 = (*p).variety_lo as f64
    let hi: f64 = ((*p).variety_hi + 1) as f64
    let t: f64 = (v - (0.0 - 1.0)) / 2.0
    var out: f64 = lo
    if t < 0.0 {
        out = lo
    } else if t > 1.0 {
        out = hi
    } else {
        out = lo + t * (hi - lo)
    }
    return (out as i32) as usize
}

#[allow_fp]
fn pick_dual(ft: *wgft_def.FtDef, p: *wgft_pdef.StateProv, x: i32, y: i32, z: i32) -> u16 {
    let cnt: usize = variety_count(p, slow_at(ft, p, x, y, z))
    var sub: [u16; 16] = [0; 16]
    var i: usize = 0
    while i < cnt {
        let off: i32 = i as i32
        let v: f64 = slow_at(ft, p, x + off * 54545, y, z + off * 34234)
        sub[i] = (*p).codes[state_index(v, (*p).n)]
        i = i + 1
    }
    let s: f64 = (*p).scale as f64
    return sub[state_index(noise_at(&(*ft).noises[(*p).noise as usize], x as f64, y as f64, z as f64, s), cnt)]
}

#[allow_fp]
fn pick_threshold(ft: *wgft_def.FtDef, p: *wgft_pdef.StateProv, rng: *mut mg_random.Rng, x: i32, y: i32, z: i32) -> u16 {
    let v: f64 = noise_at(&(*ft).noises[(*p).noise as usize], x as f64, y as f64, z as f64, (*p).scale as f64)
    if v < ((*p).threshold as f64) {
        return (*p).low[mg_random.rng_next_int_bound(rng, (*p).nlow as i32) as usize]
    }
    if mg_random.rng_next_float(rng) < (*p).high_chance {
        return (*p).high[mg_random.rng_next_int_bound(rng, (*p).nhigh as i32) as usize]
    }
    return (*p).dflt
}

fn pick_weighted(p: *wgft_pdef.StateProv, rng: *mut mg_random.Rng) -> u16 {
    var roll: i32 = mg_random.rng_next_int_bound(rng, (*p).total)
    var i: usize = 0
    while i < (*p).n {
        roll = roll - (*p).weights[i]
        if roll < 0 { return (*p).codes[i] }
        i = i + 1
    }
    return (*p).codes[0]
}

#[allow_fp]
fn pick_randint(ft: *wgft_def.FtDef, p: *wgft_pdef.StateProv, rng: *mut mg_random.Rng, x: i32, y: i32, z: i32) -> u16 {
    let code: u16 = pick(ft, &(*ft).provs[(*p).noise as usize], rng, x, y, z)
    if (*p).rand_uni { mg_random.rng_next_int_bound(rng, (*p).variety_hi - (*p).variety_lo + 1) }
    return code
}

#[allow_fp]
fn pick(ft: *wgft_def.FtDef, p: *wgft_pdef.StateProv, rng: *mut mg_random.Rng, x: i32, y: i32, z: i32) -> u16 {
    let k: u8 = (*p).kind
    if k == wgft_pdef.SP_WEIGHTED { return pick_weighted(p, rng) }
    if k == wgft_pdef.SP_THRESHOLD { return pick_threshold(ft, p, rng, x, y, z) }
    if k == wgft_pdef.SP_NOISE {
        return (*p).codes[state_index(noise_at(&(*ft).noises[(*p).noise as usize], x as f64, y as f64, z as f64, (*p).scale as f64), (*p).n)]
    }
    if k == wgft_pdef.SP_DUAL { return pick_dual(ft, p, x, y, z) }
    if k == wgft_pdef.SP_RANDINT { return pick_randint(ft, p, rng, x, y, z) }
    return (*p).codes[0]
}
