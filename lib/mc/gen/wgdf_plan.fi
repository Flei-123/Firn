// SPDX-License-Identifier: MPL-2.0
// lib/mc/gen/wgdf_plan.fi -- load-time specialization of a wgdf_graph: constant folding and constant-operand opcodes.
import mc.gen.wgdf_graph
import mc.gen.wgdf_ops

export { specialize }

fn is_const(g: *wgdf_graph.WgGraph, n: i32) -> bool {
    return n >= 0 && (*g).op[n as usize] == wgdf_ops.OP_CONST
}

#[allow_fp]
fn fold_add(g: *mut wgdf_graph.WgGraph, u: usize, ca: i32, cb: i32) -> bool {
    if is_const(g, ca) && is_const(g, cb) {
        (*g).p0[u] = (*g).p0[ca as usize] + (*g).p0[cb as usize]
        (*g).op[u] = wgdf_ops.OP_CONST
        return true
    }
    if is_const(g, cb) {
        (*g).p0[u] = (*g).p0[cb as usize]
        (*g).op[u] = wgdf_ops.OP_ADD_C
        return true
    }
    if is_const(g, ca) {
        (*g).p0[u] = (*g).p0[ca as usize]
        (*g).a[u] = cb
        (*g).op[u] = wgdf_ops.OP_ADD_C
        return true
    }
    return false
}

#[allow_fp]
fn fold_mul(g: *mut wgdf_graph.WgGraph, u: usize, ca: i32, cb: i32) -> bool {
    if is_const(g, ca) && is_const(g, cb) {
        let x: f64 = (*g).p0[ca as usize]
        if x == 0.0 {
            (*g).p0[u] = 0.0
        } else {
            (*g).p0[u] = x * (*g).p0[cb as usize]
        }
        (*g).op[u] = wgdf_ops.OP_CONST
        return true
    }
    if is_const(g, cb) {
        (*g).p0[u] = (*g).p0[cb as usize]
        (*g).op[u] = wgdf_ops.OP_MUL_CR
        return true
    }
    if is_const(g, ca) {
        (*g).p0[u] = (*g).p0[ca as usize]
        (*g).a[u] = cb
        (*g).op[u] = wgdf_ops.OP_MUL_CL
        return true
    }
    return false
}

fn fold_minmax(g: *mut wgdf_graph.WgGraph, u: usize, ca: i32, cb: i32, op_cr: i32, op_cl: i32) -> bool {
    if is_const(g, ca) && is_const(g, cb) {
        return false
    }
    if is_const(g, cb) {
        (*g).p0[u] = (*g).p0[cb as usize]
        (*g).op[u] = op_cr
        return true
    }
    if is_const(g, ca) {
        (*g).p0[u] = (*g).p0[ca as usize]
        (*g).a[u] = cb
        (*g).op[u] = op_cl
        return true
    }
    return false
}

fn specialize(g: *mut wgdf_graph.WgGraph) {
    var i: i32 = 0
    while i < (*g).n_nodes {
        let u: usize = i as usize
        let op: i32 = (*g).op[u]
        let ca: i32 = (*g).a[u]
        let cb: i32 = (*g).b[u]
        if op == wgdf_ops.OP_ADD {
            fold_add(g, u, ca, cb)
        } else if op == wgdf_ops.OP_MUL {
            fold_mul(g, u, ca, cb)
        } else if op == wgdf_ops.OP_MIN {
            fold_minmax(g, u, ca, cb, wgdf_ops.OP_MIN_CR, wgdf_ops.OP_MIN_CL)
        } else if op == wgdf_ops.OP_MAX {
            fold_minmax(g, u, ca, cb, wgdf_ops.OP_MAX_CR, wgdf_ops.OP_MAX_CL)
        }
        i = i + 1
    }
}
