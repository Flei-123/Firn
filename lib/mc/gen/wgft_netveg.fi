import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_prov
import mc.gen.wgft_surv

export { place }

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    if !(*ft).nylium[wgft_region.block_at(r, x, y - 1, z) as usize] { return false }
    if y < (*r).min_y + 1 || y + 1 >= (*r).min_y + (*r).height { return false }
    let sw: i32 = (*f).p[1]
    let sh: i32 = (*f).p[2]
    var placed: i32 = 0
    var i: i32 = 0
    while i < sw * sw {
        let ax: i32 = mg_random.rng_next_int_bound((*c).rng, sw)
        let bx: i32 = mg_random.rng_next_int_bound((*c).rng, sw)
        let ay: i32 = mg_random.rng_next_int_bound((*c).rng, sh)
        let by: i32 = mg_random.rng_next_int_bound((*c).rng, sh)
        let az: i32 = mg_random.rng_next_int_bound((*c).rng, sw)
        let bz: i32 = mg_random.rng_next_int_bound((*c).rng, sw)
        let px: i32 = x + ax - bx
        let py: i32 = y + ay - by
        let pz: i32 = z + az - bz
        let code: u16 = wgft_prov.pick(ft, &(*ft).provs[(*f).p[0] as usize], (*c).rng, px, py, pz)
        if (*ft).air[wgft_region.block_at(r, px, py, pz) as usize] && py > (*r).min_y && wgft_surv.can_survive(r, (*ft).st_surv[code as usize] as i32, px, py, pz) {
            wgft_region.set_block(r, px, py, pz, code)
            placed = placed + 1
        }
        i = i + 1
    }
    return placed > 0
}
