import std.math
import noise.jnum
import mc.gen.mg_random
import mc.gen.wgdf_fluid
import mc.gen.wgsr_def
import mc.gen.wgsr_ctx
import mc.gen.wgsr_bio

export { eroded_badlands, frozen_ocean }

const AIR: u8 = 65

fn min_f(a: f64, b: f64) -> f64 {
    if a < b { return a }
    return b
}

#[allow_fp]
fn eroded_badlands(c: *mut wgsr_ctx.SrCtx, x: i32, z: i32, height: i32) {
    let d: *wgsr_def.SrDef = (*c).def
    let a: f64 = min_f(math.fabs(wgsr_ctx.noise_val((*c).ns, (*d).s_bsurf, x as f64, 0.0, z as f64) * 8.25), wgsr_ctx.noise_val((*c).ns, (*d).s_bpillar, (x as f64) * 0.2, 0.0, (z as f64) * 0.2) * 15.0)
    if a <= 0.0 { return }
    let b: f64 = math.fabs(wgsr_ctx.noise_val((*c).ns, (*d).s_broof, (x as f64) * 0.75, 0.0, (z as f64) * 0.75) * 1.5)
    let top: f64 = 64.0 + min_f(a * a * 2.5, math.ceil(b * 50.0) + 24.0)
    let t: i32 = jnum.floor_i32(top)
    if height > t { return }
    var y: i32 = t
    while y >= (*c).min_y {
        let code: u8 = wgsr_ctx.ctx_get(c, y)
        if code == wgdf_fluid.STATE_SOLID { break }
        if code == wgdf_fluid.STATE_WATER { return }
        y = y - 1
    }
    y = t
    while y >= (*c).min_y && wgsr_ctx.ctx_get(c, y) == AIR {
        wgsr_ctx.ctx_set(c, y, wgdf_fluid.STATE_SOLID)
        y = y - 1
    }
}

#[allow_fp]
fn frozen_ocean(c: *mut wgsr_ctx.SrCtx, biome: i32, min_level: i32, x: i32, z: i32, height: i32) {
    let d: *wgsr_def.SrDef = (*c).def
    let a: f64 = min_f(math.fabs(wgsr_ctx.noise_val((*c).ns, (*d).s_isurf, x as f64, 0.0, z as f64) * 8.25), wgsr_ctx.noise_val((*c).ns, (*d).s_ipillar, (x as f64) * 1.28, 0.0, (z as f64) * 1.28) * 15.0)
    if a <= 1.8 { return }
    let b: f64 = math.fabs(wgsr_ctx.noise_val((*c).ns, (*d).s_iroof, (x as f64) * 1.17, 0.0, (z as f64) * 1.17) * 1.5)
    var top: f64 = min_f(a * a * 1.2, math.ceil(b * 40.0) + 14.0)
    let melt_lim: f32 = 0.1
    if wgsr_bio.temperature_at(d, biome, x, 63, z) > melt_lim { top = top - 2.0 }
    let sea: i32 = (*d).sea_level
    var low: f64 = 0.0
    if top > 2.0 {
        low = (sea as f64) - top - 7.0
        top = top + (sea as f64)
    } else {
        top = 0.0
    }
    let top_i: i32 = jnum.d2i(top)
    let low_i: i32 = jnum.d2i(low)
    var r: mg_random.Rng = mg_random.pos_at(&(*d).root_pf, x, 0, z)
    let snow_max: i32 = 2 + mg_random.rng_next_int_bound(&r, 4)
    let snow_min_y: i32 = sea + 18 + mg_random.rng_next_int_bound(&r, 10)
    var snow: i32 = 0
    var y: i32 = height
    if top_i + 1 > y { y = top_i + 1 }
    while y >= min_level {
        let code: u8 = wgsr_ctx.ctx_get(c, y)
        var hit: bool = false
        if code == AIR && y < top_i && mg_random.rng_next_double(&r) > 0.01 { hit = true }
        if !hit && code == wgdf_fluid.STATE_WATER && y > low_i && y < sea && low != 0.0 && mg_random.rng_next_double(&r) > 0.15 { hit = true }
        if hit {
            if snow <= snow_max && y > snow_min_y {
                wgsr_ctx.ctx_set(c, y, wgsr_def.CODE_SNOW)
                snow = snow + 1
            } else {
                wgsr_ctx.ctx_set(c, y, wgsr_def.CODE_ICE)
            }
        }
        y = y - 1
    }
}
