import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_manhattan

export { place }

fn find_target(r: *mut wgft_region.Region, x: i32, y: i32, z: i32, target: u16) -> i32 {
    var cy: i32 = y
    if cy < (*r).min_y + 1 { cy = (*r).min_y + 1 }
    if cy > (*r).min_y + (*r).height - 1 { cy = (*r).min_y + (*r).height - 1 }
    while cy > (*r).min_y + 1 {
        if wgft_region.block_at(r, x, cy, z) == target { return cy }
        cy = cy - 1
    }
    return 0 - 1000000
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let target: u16 = (*f).p[0] as u16
    let state: u16 = (*f).p[1] as u16
    let ty: i32 = find_target(r, x, y, z, target)
    if ty == 0 - 1000000 { return false }
    let lo: i32 = (*f).p[2]
    let hi: i32 = (*f).p[3]
    let rx: i32 = mg_random.rng_next_int_bound((*c).rng, hi - lo + 1) + lo
    let ry: i32 = mg_random.rng_next_int_bound((*c).rng, hi - lo + 1) + lo
    let rz: i32 = mg_random.rng_next_int_bound((*c).rng, hi - lo + 1) + lo
    var limit: i32 = rx
    if ry > limit { limit = ry }
    if rz > limit { limit = rz }
    var it: wgft_manhattan.Walk = wgft_manhattan.walk_new(rx, ry, rz)
    var placed: bool = false
    while wgft_manhattan.walk_next(&it) {
        if it.depth > limit { break }
        let px: i32 = x + it.dx
        let py: i32 = ty + it.dy
        let pz: i32 = z + it.dz
        if wgft_region.block_at(r, px, py, pz) == target {
            wgft_region.set_block(r, px, py, pz, state)
            placed = true
        }
    }
    return placed
}
