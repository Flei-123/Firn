// SPDX-License-Identifier: MPL-2.0
import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch
import mc.gen.wgft_trunk

export { place_roots }

const LIST_CAP: usize = 192

struct PosList {
    n: usize,
    x: [i32; 192],
    y: [i32; 192],
    z: [i32; 192],
}

struct RootCtx {
    r: *mut wgft_region.Region,
    sc: *mut wgft_tscratch.TreeScratch,
    rng: *mut mg_random.Rng,
    cfg: *wgft_def.RootCfg,
    tx: i32,
    ty: i32,
    tz: i32,
}

fn can_place(ft: *wgft_def.FtDef, code: u16) -> bool {
    return (*ft).tree_ok[code as usize] || (*ft).grow_roots[code as usize]
}

fn push(list: *mut PosList, x: i32, y: i32, z: i32) {
    if (*list).n >= LIST_CAP { return }
    let i: usize = (*list).n
    (*list).x[i] = x
    (*list).y[i] = y
    (*list).z[i] = z
    (*list).n = i + 1
}

fn abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

#[allow_fp]
fn potential(c: *RootCtx, x: i32, y: i32, z: i32, dir: i32, out: *mut PosList) {
    let cfg: *wgft_def.RootCfg = (*c).cfg
    let dist: i32 = abs_i32(x - (*c).tx) + abs_i32(y - (*c).ty) + abs_i32(z - (*c).tz)
    let sx: i32 = x + wgft_trunk.step_x(dir)
    let sz: i32 = z + wgft_trunk.step_z(dir)
    (*out).n = 0
    if dist > (*cfg).max_width - 3 && dist <= (*cfg).max_width {
        push(out, x, y - 1, z)
        if mg_random.rng_next_float((*c).rng) < (*cfg).skew { push(out, sx, y - 1, sz) }
    } else if dist > (*cfg).max_width {
        push(out, x, y - 1, z)
    } else if mg_random.rng_next_float((*c).rng) < (*cfg).skew {
        push(out, x, y - 1, z)
    } else if mg_random.rng_next_bool((*c).rng) {
        push(out, sx, y, sz)
    } else {
        push(out, x, y - 1, z)
    }
}

fn simulate(c: *RootCtx, x: i32, y: i32, z: i32, dir: i32, list: *mut PosList, depth: i32) -> bool {
    let max: i32 = (*(*c).cfg).max_len
    if depth == max || (*list).n as i32 > max { return false }
    var cand: PosList = PosList { n: 0, x: [0; 192], y: [0; 192], z: [0; 192] }
    potential(c, x, y, z, dir, &cand)
    var i: usize = 0
    while i < cand.n {
        if can_place((*(*c).r).ft, wgft_region.block_at((*c).r, cand.x[i], cand.y[i], cand.z[i])) {
            push(list, cand.x[i], cand.y[i], cand.z[i])
            if !simulate(c, cand.x[i], cand.y[i], cand.z[i], dir, list, depth + 1) { return false }
        }
        i = i + 1
    }
    return true
}

fn put(c: *RootCtx, x: i32, y: i32, z: i32, code: u16) {
    wgft_region.set_block((*c).r, x, y, z, code)
    wgft_tscratch.add_deco((*c).sc, x, y, z)
}

#[allow_fp]
fn place_one(c: *RootCtx, x: i32, y: i32, z: i32) {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    let cfg: *wgft_def.RootCfg = (*c).cfg
    let cur: u16 = wgft_region.block_at(r, x, y, z)
    if cur == (*cfg).mud_code || cur == (*cfg).muddy_code {
        put(c, x, y, z, (*cfg).muddy_code)
        return
    }
    if !can_place(ft, cur) { return }
    var code: u16 = (*cfg).root_code
    if (*ft).wet[cur as usize] { code = (*cfg).root_wet_code }
    put(c, x, y, z, code)
    if !(*cfg).above_present { return }
    if mg_random.rng_next_float((*c).rng) < (*cfg).above_chance && (*ft).air[wgft_region.block_at(r, x, y + 1, z) as usize] {
        put(c, x, y + 1, z, (*cfg).above_code)
    }
}

fn place_roots(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, ty: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    let c: RootCtx = RootCtx { r: r, sc: sc, rng: rng, cfg: &(*t).root, tx: ox, ty: ty, tz: oz }
    var yy: i32 = oy
    while yy < ty {
        if !can_place(ft, wgft_region.block_at(r, ox, yy, oz)) { return false }
        yy = yy + 1
    }
    var all: PosList = PosList { n: 0, x: [0; 192], y: [0; 192], z: [0; 192] }
    push(&all, ox, ty - 1, oz)
    var dir: i32 = 0
    while dir < 4 {
        let sx: i32 = ox + wgft_trunk.step_x(dir)
        let sz: i32 = oz + wgft_trunk.step_z(dir)
        var part: PosList = PosList { n: 0, x: [0; 192], y: [0; 192], z: [0; 192] }
        if !simulate(&c, sx, ty, sz, dir, &part, 0) { return false }
        var k: usize = 0
        while k < part.n {
            push(&all, part.x[k], part.y[k], part.z[k])
            k = k + 1
        }
        push(&all, sx, ty, sz)
        dir = dir + 1
    }
    var i: usize = 0
    while i < all.n {
        place_one(&c, all.x[i], all.y[i], all.z[i])
        i = i + 1
    }
    return true
}
