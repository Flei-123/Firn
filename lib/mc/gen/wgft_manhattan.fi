// SPDX-License-Identifier: MPL-2.0
export { Walk, walk_new, walk_next }

struct Walk {
    rx: i32,
    ry: i32,
    rz: i32,
    limit: i32,
    depth_now: i32,
    max_x: i32,
    max_y: i32,
    x: i32,
    y: i32,
    mirror: bool,
    dx: i32,
    dy: i32,
    dz: i32,
    depth: i32,
}

fn walk_new(rx: i32, ry: i32, rz: i32) -> Walk {
    return Walk { rx: rx, ry: ry, rz: rz, limit: rx + ry + rz, depth_now: 0, max_x: 0, max_y: 0, x: 0, y: 0, mirror: false, dx: 0, dy: 0, dz: 0, depth: 0 }
}

fn abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

fn min_i32(a: i32, b: i32) -> i32 {
    if a < b { return a }
    return b
}

fn walk_next(w: *mut Walk) -> bool {
    if (*w).mirror {
        (*w).mirror = false
        (*w).dz = 0 - (*w).dz
        return true
    }
    while true {
        if (*w).y > (*w).max_y {
            (*w).x = (*w).x + 1
            if (*w).x > (*w).max_x {
                (*w).depth_now = (*w).depth_now + 1
                if (*w).depth_now > (*w).limit { return false }
                (*w).max_x = min_i32((*w).rx, (*w).depth_now)
                (*w).x = 0 - (*w).max_x
            }
            (*w).max_y = min_i32((*w).ry, (*w).depth_now - abs_i32((*w).x))
            (*w).y = 0 - (*w).max_y
        }
        let dx: i32 = (*w).x
        let dy: i32 = (*w).y
        let dz: i32 = (*w).depth_now - abs_i32(dx) - abs_i32(dy)
        (*w).y = (*w).y + 1
        if dz <= (*w).rz {
            (*w).mirror = dz != 0
            (*w).dx = dx
            (*w).dy = dy
            (*w).dz = dz
            (*w).depth = abs_i32(dx) + abs_i32(dy) + abs_i32(dz)
            return true
        }
    }
    return false
}
