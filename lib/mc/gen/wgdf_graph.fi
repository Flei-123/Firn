// SPDX-License-Identifier: MPL-2.0
// lib/mc/gen/wgdf_graph.fi -- the loaded density function graph: node arena, spline arena, noise parameter table, router roots.
import mc.gen.wgdf_ops

export {
    MAX_NODES, MAX_SPLINES, MAX_POINTS, MAX_NOISES, MAX_REFS, MAX_ROUTER, NAME_LEN,
    WgGraph, graph_bytes, wg_size_of, graph_new, new_node, new_spline, name_set, name_eq, ref_find, router_find,
}

const MAX_NODES: usize = 3072
const MAX_SPLINES: usize = 768
const MAX_POINTS: usize = 6144
const MAX_NOISES: usize = 96
const MAX_REFS: usize = 512
const MAX_ROUTER: usize = 24
const NAME_LEN: usize = 96

struct WgGraph {
    n_nodes: i32,
    op: [i32; 3072],
    a: [i32; 3072],
    b: [i32; 3072],
    c: [i32; 3072],
    d: [i32; 3072],
    e: [i32; 3072],
    p0: [f64; 3072],
    p1: [f64; 3072],
    p2: [f64; 3072],
    p3: [f64; 3072],
    p4: [f64; 3072],
    n_spl: i32,
    spl_coord: [i32; 768],
    spl_const: [f32; 768],
    spl_first: [i32; 768],
    spl_count: [i32; 768],
    n_pts: i32,
    pt_loc: [f32; 6144],
    pt_der: [f32; 6144],
    pt_val: [i32; 6144],
    n_noise: i32,
    nz_name: [[u8; 96]; 96],
    nz_name_len: [usize; 96],
    nz_first: [i32; 96],
    nz_count: [i32; 96],
    nz_amp: [[f64; 32]; 96],
    n_ref: i32,
    ref_name: [[u8; 96]; 512],
    ref_len: [usize; 512],
    ref_node: [i32; 512],
    n_router: i32,
    router_name: [[u8; 40]; 24],
    router_len: [usize; 24],
    router_node: [i32; 24],
    min_y: i32,
    height: i32,
    size_h: i32,
    size_v: i32,
    sea_level: i32,
    legacy_random: bool,
    aquifers: bool,
    ore_veins: bool,
    n_blended: i32,
    fluid: i32,
    default_block: [u8; 32],
    default_block_len: usize,
}

fn graph_bytes() -> usize {
    return wg_size_of[WgGraph]()
}

fn wg_size_of[T]() -> usize {
    return size_of[T]()
}

fn graph_new() -> WgGraph {
    return WgGraph {
        n_nodes: 0, op: [0; 3072], a: [0; 3072], b: [0; 3072], c: [0; 3072], d: [0; 3072], e: [0; 3072],
        p0: [0.0; 3072], p1: [0.0; 3072], p2: [0.0; 3072], p3: [0.0; 3072], p4: [0.0; 3072],
        n_spl: 0, spl_coord: [0; 768], spl_const: [0.0; 768], spl_first: [0; 768], spl_count: [0; 768],
        n_pts: 0, pt_loc: [0.0; 6144], pt_der: [0.0; 6144], pt_val: [0; 6144],
        n_noise: 0, nz_name: [[0; 96]; 96], nz_name_len: [0; 96], nz_first: [0; 96], nz_count: [0; 96], nz_amp: [[0.0; 32]; 96],
        n_ref: 0, ref_name: [[0; 96]; 512], ref_len: [0; 512], ref_node: [0; 512],
        n_router: 0, router_name: [[0; 40]; 24], router_len: [0; 24], router_node: [0; 24],
        min_y: -64, height: 384, size_h: 1, size_v: 2, sea_level: 63, legacy_random: false, aquifers: true, ore_veins: true,
        n_blended: 0, fluid: 0, default_block: [0; 32], default_block_len: 0,
    }
}

fn new_node(g: *mut WgGraph, op: i32) -> i32 {
    let i: i32 = (*g).n_nodes
    (*g).n_nodes = i + 1
    (*g).op[i as usize] = op
    return i
}

fn new_spline(g: *mut WgGraph) -> i32 {
    let i: i32 = (*g).n_spl
    (*g).n_spl = i + 1
    (*g).spl_coord[i as usize] = -1
    (*g).spl_first[i as usize] = 0
    (*g).spl_count[i as usize] = 0
    return i
}

fn name_eq(a: *[u8; 96], al: usize, b: str) -> bool {
    if al != b.n {
        return false
    }
    var i: usize = 0
    while i < al {
        if (*a)[i] != (*(((b.p as u64) + (i as u64)) as *u8)) {
            return false
        }
        i = i + 1
    }
    return true
}

fn name_set(dst: *mut [u8; 96], src: str) -> usize {
    var n: usize = src.n
    if n > 95 {
        n = 95
    }
    var i: usize = 0
    while i < n {
        (*dst)[i] = *(((src.p as u64) + (i as u64)) as *u8)
        i = i + 1
    }
    return n
}

fn ref_find(g: *WgGraph, name: str) -> i32 {
    var i: i32 = 0
    while i < (*g).n_ref {
        if name_eq(&(*g).ref_name[i as usize], (*g).ref_len[i as usize], name) {
            return (*g).ref_node[i as usize]
        }
        i = i + 1
    }
    return -1
}

fn router_find(g: *WgGraph, name: str) -> i32 {
    var i: i32 = 0
    while i < (*g).n_router {
        let l: usize = (*g).router_len[i as usize]
        if l == name.n {
            var same: bool = true
            var k: usize = 0
            while k < l {
                if (*g).router_name[i as usize][k] != *(((name.p as u64) + (k as u64)) as *u8) {
                    same = false
                }
                k = k + 1
            }
            if same {
                return (*g).router_node[i as usize]
            }
        }
        i = i + 1
    }
    return -1
}
