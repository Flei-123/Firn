import std.rt
import std.json
import mc.gen.wgsr_def
import mc.gen.wgft_def
import mc.gen.wgft_ldctx

export { load }

const NAME_LIMIT: usize = 64

fn append(buf: *mut [u8; 64], n: usize, s: str) -> usize {
    var i: usize = 0
    while i < s.n {
        if n + i < NAME_LIMIT { (*buf)[n + i] = rt.ld8(s.p as u64, i) }
        i = i + 1
    }
    return n + s.n
}

fn reg_variant(l: *mut wgft_ldctx.Ld, base: str, keys: *[str; 6], count: usize, mask: usize) -> u16 {
    var buf: [u8; 64] = [0 as u8; 64]
    var n: usize = append(&buf, 0, base)
    var first: bool = true
    var i: usize = 0
    while i < count {
        if ((mask >> i) & 1) != 0 {
            if first { n = append(&buf, n, "[") } else { n = append(&buf, n, ",") }
            first = false
            n = append(&buf, n, (*keys)[i])
            n = append(&buf, n, "=true")
        }
        i = i + 1
    }
    if !first { n = append(&buf, n, "]") }
    if n > NAME_LIMIT { return 0 }
    let c: i32 = wgsr_def.block_code((*l).sdef, (&buf[0]) as u64, n)
    if c < 0 || c >= (wgsr_def.CODE_SPACE as i32) {
        (*l).ok = false
        return 0
    }
    return c as u16
}

fn mark_kind(l: *mut wgft_ldctx.Ld, code: u16, kind: u8) {
    (*(*l).def).end_kind[code as usize] = kind
}

fn load_chorus(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat) {
    (*f).kind = wgft_def.FK_CHORUS
    var keys: [str; 6] = ["down", "east", "north", "south", "up", "west"]
    var mask: usize = 0
    while mask < 64 {
        let code: u16 = reg_variant(l, "chorus_plant", &keys, 6, mask)
        (*(*l).def).end_chorus[mask] = code
        if code != 0 { mark_kind(l, code, wgft_def.EK_CHORUS_PLANT) }
        mask = mask + 1
    }
    let flower: u16 = wgft_ldctx.reg_code(l, "chorus_flower[age=5]")
    (*(*l).def).end_flower = flower
    mark_kind(l, flower, wgft_def.EK_CHORUS_FLOWER)
    mark_kind(l, wgft_ldctx.reg_code(l, "end_stone"), wgft_def.EK_END_STONE)
}

fn load_spike(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat) {
    (*f).kind = wgft_def.FK_END_SPIKE
    (*f).p[0] = wgft_ldctx.reg_code(l, "obsidian") as i32
    (*f).p[1] = wgft_ldctx.reg_code(l, "bedrock") as i32
    var mask: usize = 0
    while mask < 16 {
        var sorted: [str; 6] = ["east", "north", "south", "west", "", ""]
        var bits: usize = 0
        if (mask & 1) != 0 { bits = bits | 2 }
        if (mask & 2) != 0 { bits = bits | 4 }
        if (mask & 4) != 0 { bits = bits | 8 }
        if (mask & 8) != 0 { bits = bits | 1 }
        (*(*l).def).end_bars[mask] = reg_variant(l, "iron_bars", &sorted, 4, bits)
        mask = mask + 1
    }
}

fn load(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, ty: str, cfg: u32) -> bool {
    if ty == "end_island" {
        (*f).kind = wgft_def.FK_END_ISLAND
        (*f).p[0] = wgft_ldctx.reg_code(l, "end_stone") as i32
        return true
    }
    if ty == "end_spike" {
        load_spike(l, f)
        return true
    }
    if ty == "chorus_plant" {
        load_chorus(l, f)
        return true
    }
    if ty == "end_gateway" {
        (*f).kind = wgft_def.FK_GATEWAY
        (*f).p[0] = wgft_ldctx.reg_code(l, "end_gateway") as i32
        (*f).p[1] = wgft_ldctx.reg_code(l, "bedrock") as i32
        (*f).p[2] = wgft_ldctx.reg_code(l, "air") as i32
        return true
    }
    return false
}
