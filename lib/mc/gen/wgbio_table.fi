// SPDX-License-Identifier: MPL-2.0
import std.rt

export { bytes_of, BioTable, BIO_STRIDE, BIO_NAME_MAX, BIO_BIAS, table_bytes, table_load, table_free, table_val, table_name, table_name_count, table_entry_name }

const BIO_STRIDE: usize = 14
const BIO_NAME_MAX: usize = 40
const BIO_BIAS: i64 = 1000000
const MAX_NAMES: usize = 96

struct BioTable {
    n: usize,
    vals: u64,
    names_of: u64,
    name_bytes: [[u8; 40]; 96],
    name_len: [usize; 96],
    name_count: usize,
}

fn table_bytes() -> usize {
    return bytes_of[BioTable]()
}

fn name_index(t: *mut BioTable, p: u64, n: usize) -> i32 {
    var i: usize = 0
    while i < (*t).name_count {
        if (*t).name_len[i] == n {
            var same: bool = true
            var k: usize = 0
            while k < n {
                if (*t).name_bytes[i][k] != rt.ld8(p, k) { same = false }
                k = k + 1
            }
            if same { return i as i32 }
        }
        i = i + 1
    }
    if (*t).name_count >= MAX_NAMES || n > BIO_NAME_MAX { return 0 - 1 }
    var k: usize = 0
    while k < n {
        (*t).name_bytes[(*t).name_count][k] = rt.ld8(p, k)
        k = k + 1
    }
    (*t).name_len[(*t).name_count] = n
    (*t).name_count = (*t).name_count + 1
    return ((*t).name_count - 1) as i32
}

fn parse_int(p: u64, at: usize, end: usize, out: *mut i64) -> usize {
    var i: usize = at
    var neg: bool = false
    if i < end && rt.ld8(p, i) == 45 {
        neg = true
        i = i + 1
    }
    var v: i64 = 0
    while i < end {
        let c: u8 = rt.ld8(p, i)
        if c < 48 || c > 57 { break }
        v = v * 10 + ((c - 48) as i64)
        i = i + 1
    }
    if neg { v = 0 - v }
    *out = v
    return i
}

fn count_lines(p: u64, n: usize) -> usize {
    var c: usize = 0
    var i: usize = 0
    while i < n {
        if rt.ld8(p, i) == 10 { c = c + 1 }
        i = i + 1
    }
    return c
}

fn table_load(t: *mut BioTable, raw: *mut rt.Buf) -> bool {
    let p: u64 = rt.buf_ptr(raw)
    let len: usize = rt.buf_len(raw)
    let lines: usize = count_lines(p, len)
    if lines == 0 { return false }
    (*t).n = lines
    (*t).name_count = 0
    (*t).vals = rt.heap_alloc(lines * BIO_STRIDE * 4)
    (*t).names_of = rt.heap_alloc(lines * 2)
    var e: usize = 0
    var i: usize = 0
    while i < len && e < lines {
        let start: usize = i
        while i < len && rt.ld8(p, i) != 9 { i = i + 1 }
        let ni: i32 = name_index(t, p + (start as u64), i - start)
        if ni < 0 { return false }
        rt.st16((*t).names_of, e, ni as u16)
        var k: usize = 0
        while k < 13 {
            i = i + 1
            var v: i64 = 0
            i = parse_int(p, i, len, &v)
            rt.st32((*t).vals, e * BIO_STRIDE + k, (v + BIO_BIAS) as u32)
            k = k + 1
        }
        rt.st32((*t).vals, e * BIO_STRIDE + 13, 0 as u32)
        while i < len && rt.ld8(p, i) != 10 { i = i + 1 }
        i = i + 1
        e = e + 1
    }
    return e == lines
}

fn table_free(t: *mut BioTable) {
    if (*t).vals != 0 { rt.heap_free((*t).vals, (*t).n * BIO_STRIDE * 4) }
    if (*t).names_of != 0 { rt.heap_free((*t).names_of, (*t).n * 2) }
}

fn table_val(t: *mut BioTable, e: usize, k: usize) -> i64 {
    return (rt.ld32((*t).vals, e * BIO_STRIDE + k) as i64) - BIO_BIAS
}

fn table_name(t: *mut BioTable, idx: usize) -> str {
    return str { p: &(*t).name_bytes[idx][0], n: (*t).name_len[idx] }
}

fn table_name_count(t: *mut BioTable) -> usize {
    return (*t).name_count
}

fn table_entry_name(t: *mut BioTable, e: usize) -> usize {
    return rt.ld16((*t).names_of, e) as usize
}

fn bytes_of[T]() -> usize {
    return size_of[T]()
}
