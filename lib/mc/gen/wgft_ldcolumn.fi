import std.json
import std.jsonstr
import mc.gen.wgft_def
import mc.gen.wgft_cdef
import mc.gen.wgft_ldctx
import mc.gen.wgft_ldpred
import mc.gen.wgft_ldprov
import mc.gen.wgft_ldstate

export { load_column }

fn load_height(l: *mut wgft_ldctx.Ld, h: *mut wgft_cdef.HeightCfg, d: *mut json.Json, node: u32) {
    (*h).weighted = false
    (*h).n = 1
    (*h).total = 0
    var ty: str = ""
    if json.json_kind(d, node) != json.JSON_NUMBER { ty = wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, node, "type"))) }
    if ty != "weighted_list" {
        (*h).uni[0] = wgft_ldprov.int_range(l, d, node, &(*h).lo[0], &(*h).hi[0])
        return
    }
    let dist: u32 = jsonstr.get(d, node, "distribution")
    let cnt: usize = json.json_count(d, dist)
    if cnt == 0 || cnt > wgft_cdef.MAX_HEIGHT_ENTRIES {
        (*l).ok = false
        return
    }
    (*h).weighted = true
    (*h).n = cnt
    var k: usize = 0
    while k < cnt {
        let e: u32 = json.json_child_at(d, dist, k)
        (*h).uni[k] = wgft_ldprov.int_range(l, d, jsonstr.get(d, e, "data"), &(*h).lo[k], &(*h).hi[k])
        (*h).w[k] = wgft_ldctx.num_or_fail(l, d, e, "weight")
        (*h).total = (*h).total + (*h).w[k]
        k = k + 1
    }
}

fn load_column(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, cfg: u32) {
    let def: *mut wgft_def.FtDef = (*l).def
    (*f).kind = wgft_def.FK_COLUMN
    if (*def).ncols >= wgft_cdef.MAX_COLS {
        (*l).ok = false
        return
    }
    let ci: usize = (*def).ncols
    (*def).ncols = (*def).ncols + 1
    (*f).p[0] = ci as i32
    let col: *mut wgft_cdef.ColCfg = &(*def).cols[ci]
    (*col).dir = 0 - 1
    if wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, cfg, "direction"))) == "up" { (*col).dir = 1 }
    (*col).tip = json.json_kind(d, jsonstr.get(d, cfg, "prioritize_tip")) == json.JSON_TRUE
    (*col).allowed = wgft_ldpred.load_pred(l, d, jsonstr.get(d, cfg, "allowed_placement"))
    let layers: u32 = jsonstr.get(d, cfg, "layers")
    let cnt: usize = json.json_count(d, layers)
    if cnt == 0 || cnt > wgft_cdef.MAX_COL_LAYERS {
        (*l).ok = false
        return
    }
    (*col).nlayers = cnt
    var k: usize = 0
    while k < cnt {
        let ly: u32 = json.json_child_at(d, layers, k)
        load_height(l, &(*col).heights[k], d, jsonstr.get(d, ly, "height"))
        (*col).prov[k] = wgft_ldstate.load_provider(l, d, jsonstr.get(d, ly, "provider"))
        k = k + 1
    }
}
