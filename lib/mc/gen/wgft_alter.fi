import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_jset
import mc.gen.wgft_tscratch

export { decorate }

fn abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

fn place_block_at(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, dc: *wgft_def.DecoCfg, x: i32, y: i32, z: i32) {
    let ft: *wgft_def.FtDef = (*r).ft
    var k: i32 = 2
    while k >= 0 - 3 {
        let code: u16 = wgft_region.block_at(r, x, y + k, z)
        if (*ft).dirt[code as usize] {
            wgft_region.set_block(r, x, y + k, z, (*dc).code)
            wgft_tscratch.add_deco(sc, x, y + k, z)
            return
        }
        if !(*ft).air[code as usize] && k < 0 { return }
        k = k - 1
    }
}

fn place_circle(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, dc: *wgft_def.DecoCfg, x: i32, y: i32, z: i32) {
    var dx: i32 = 0 - 2
    while dx <= 2 {
        var dz: i32 = 0 - 2
        while dz <= 2 {
            if abs_i32(dx) != 2 || abs_i32(dz) != 2 { place_block_at(r, sc, dc, x + dx, y, z + dz) }
            dz = dz + 1
        }
        dx = dx + 1
    }
}

fn decorate(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, dc: *wgft_def.DecoCfg) {
    if (*sc).logs.size == 0 { return }
    var xs: [i32; 3072] = [0; 3072]
    var ys: [i32; 3072] = [0; 3072]
    var zs: [i32; 3072] = [0; 3072]
    let n: usize = wgft_jset.js_collect(&(*sc).logs, &xs, &ys, &zs)
    let base: i32 = (*sc).lg_min_y
    var i: usize = 0
    while i < n {
        if ys[i] == base {
            place_circle(r, sc, dc, xs[i] - 1, base, zs[i] - 1)
            place_circle(r, sc, dc, xs[i] + 2, base, zs[i] - 1)
            place_circle(r, sc, dc, xs[i] - 1, base, zs[i] + 2)
            place_circle(r, sc, dc, xs[i] + 2, base, zs[i] + 2)
            var k: i32 = 0
            while k < 5 {
                let v: i32 = mg_random.rng_next_int_bound(rng, 64)
                let px: i32 = v % 8
                let pz: i32 = v / 8
                if px == 0 || px == 7 || pz == 0 || pz == 7 { place_circle(r, sc, dc, xs[i] - 3 + px, base, zs[i] - 3 + pz) }
                k = k + 1
            }
        }
        i = i + 1
    }
}
