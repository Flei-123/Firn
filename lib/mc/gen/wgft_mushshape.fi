export { brown_bits, red_bits, red_radius, red_up, brown_valid_radius, red_valid_radius }

fn flag(b: bool, v: i32) -> i32 {
    if b { return v }
    return 0
}

fn brown_bits(r: i32, x: i32, z: i32) -> i32 {
    let xe: bool = x == 0 - r || x == r
    let ze: bool = z == 0 - r || z == r
    if xe && ze { return 0 - 1 }
    let w: bool = x == 0 - r || (ze && x == 1 - r)
    let e: bool = x == r || (ze && x == r - 1)
    let n: bool = z == 0 - r || (xe && z == 1 - r)
    let s: bool = z == r || (xe && z == r - 1)
    return flag(w, 8) + flag(e, 4) + flag(n, 2) + flag(s, 1)
}

fn red_radius(r: i32, k: i32) -> i32 {
    if k < 3 { return r }
    return r - 1
}

fn red_up(k: i32) -> bool {
    return k >= 2
}

fn red_bits(r: i32, k: i32, x: i32, z: i32) -> i32 {
    let rr: i32 = red_radius(r, k)
    let xe: bool = x == 0 - rr || x == rr
    let ze: bool = z == 0 - rr || z == rr
    if k < 3 && xe == ze { return 0 - 1 }
    let inner: i32 = r - 2
    return flag(red_up(k), 16) + flag(x < 0 - inner, 8) + flag(x > inner, 4) + flag(z < 0 - inner, 2) + flag(z > inner, 1)
}

fn brown_valid_radius(r: i32, yy: i32) -> i32 {
    if yy <= 3 { return 0 }
    return r
}

fn red_valid_radius(r: i32, yy: i32) -> i32 {
    return 0
}
