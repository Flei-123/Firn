// SPDX-License-Identifier: MPL-2.0
export { SlotMap, SLOT_CAP, slots_init, slots_find, slots_take }

const SLOT_CAP: usize = 1024
const BUCKETS: usize = 512

struct SlotMap {
    kx: [i32; 1024],
    kz: [i32; 1024],
    used: [bool; 1024],
    next: [i32; 1024],
    head: [i32; 512],
    cursor: usize,
}

fn slots_init(m: *mut SlotMap) {
    var i: usize = 0
    while i < SLOT_CAP {
        (*m).used[i] = false
        (*m).next[i] = 0 - 1
        i = i + 1
    }
    i = 0
    while i < BUCKETS {
        (*m).head[i] = 0 - 1
        i = i + 1
    }
    (*m).cursor = 0
}

#[inline]
fn bucket_of(cx: i32, cz: i32) -> usize {
    return (((cx & 31) * 7 + (cz & 31) * 13 + ((cx >> 5) & 15) * 29 + ((cz >> 5) & 15) * 61) & 511) as usize
}

fn slots_find(m: *SlotMap, cx: i32, cz: i32) -> i32 {
    var s: i32 = (*m).head[bucket_of(cx, cz)]
    while s >= 0 {
        if (*m).kx[s as usize] == cx && (*m).kz[s as usize] == cz { return s }
        s = (*m).next[s as usize]
    }
    return 0 - 1
}

fn unlink(m: *mut SlotMap, s: usize) {
    let b: usize = bucket_of((*m).kx[s], (*m).kz[s])
    var cur: i32 = (*m).head[b]
    if cur == (s as i32) {
        (*m).head[b] = (*m).next[s]
    } else {
        while cur >= 0 {
            let nx: i32 = (*m).next[cur as usize]
            if nx == (s as i32) {
                (*m).next[cur as usize] = (*m).next[s]
                break
            }
            cur = nx
        }
    }
    (*m).used[s] = false
    (*m).next[s] = 0 - 1
}

fn slots_take(m: *mut SlotMap, cx: i32, cz: i32, keep_x: i32, keep_z: i32, keep_w: i32, keep_h: i32) -> usize {
    var tries: usize = 0
    var s: usize = (*m).cursor
    while tries < SLOT_CAP {
        s = (*m).cursor
        (*m).cursor = ((*m).cursor + 1) % SLOT_CAP
        tries = tries + 1
        if !(*m).used[s] { break }
        let dx: i32 = (*m).kx[s] - keep_x
        let dz: i32 = (*m).kz[s] - keep_z
        if !(dx >= 0 && dx < keep_w && dz >= 0 && dz < keep_h) { break }
    }
    if (*m).used[s] { unlink(m, s) }
    let b: usize = bucket_of(cx, cz)
    (*m).kx[s] = cx
    (*m).kz[s] = cz
    (*m).used[s] = true
    (*m).next[s] = (*m).head[b]
    (*m).head[b] = s as i32
    return s
}
