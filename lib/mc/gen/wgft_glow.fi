import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region

export { place }

fn glow_neighbours(r: *mut wgft_region.Region, glow: u16, x: i32, y: i32, z: i32) -> i32 {
    var n: i32 = 0
    if wgft_region.block_at(r, x, y - 1, z) == glow { n = n + 1 }
    if wgft_region.block_at(r, x, y + 1, z) == glow { n = n + 1 }
    if wgft_region.block_at(r, x, y, z - 1) == glow { n = n + 1 }
    if wgft_region.block_at(r, x, y, z + 1) == glow { n = n + 1 }
    if wgft_region.block_at(r, x - 1, y, z) == glow { n = n + 1 }
    if wgft_region.block_at(r, x + 1, y, z) == glow { n = n + 1 }
    return n
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    if !(*ft).air[wgft_region.block_at(r, x, y, z) as usize] { return false }
    let above: i32 = wgft_region.block_at(r, x, y + 1, z) as i32
    if above != (*f).p[1] && above != (*f).p[2] && above != (*f).p[3] { return false }
    let glow: u16 = (*f).p[0] as u16
    wgft_region.set_block(r, x, y, z, glow)
    var i: i32 = 0
    while i < 1500 {
        let dx1: i32 = mg_random.rng_next_int_bound((*c).rng, 8)
        let dx2: i32 = mg_random.rng_next_int_bound((*c).rng, 8)
        let dy: i32 = mg_random.rng_next_int_bound((*c).rng, 12)
        let dz1: i32 = mg_random.rng_next_int_bound((*c).rng, 8)
        let dz2: i32 = mg_random.rng_next_int_bound((*c).rng, 8)
        let px: i32 = x + dx1 - dx2
        let py: i32 = y - dy
        let pz: i32 = z + dz1 - dz2
        if (*ft).air[wgft_region.block_at(r, px, py, pz) as usize] && glow_neighbours(r, glow, px, py, pz) == 1 {
            wgft_region.set_block(r, px, py, pz, glow)
        }
        i = i + 1
    }
    return true
}
