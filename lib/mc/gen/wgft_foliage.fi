import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_jset
import mc.gen.wgft_tscratch

export { sample_int, place_foliage }

fn sample_int(rng: *mut mg_random.Rng, lo: i32, hi: i32, uniform: bool) -> i32 {
    if !uniform { return lo }
    return mg_random.rng_next_int_bound(rng, hi - lo + 1) + lo
}

fn abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

fn skip_location(t: *wgft_def.TreeCfg, rng: *mut mg_random.Rng, dx: i32, dy: i32, dz: i32, radius: i32) -> bool {
    let ax: i32 = abs_i32(dx)
    let az: i32 = abs_i32(dz)
    if (*t).fol == wgft_def.FL_BLOB {
        return ax == radius && az == radius && (mg_random.rng_next_int_bound(rng, 2) == 0 || dy == 0)
    }
    return ax == radius && az == radius && radius > 0
}

fn try_place_leaf(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, t: *wgft_def.TreeCfg, x: i32, y: i32, z: i32) {
    let ft: *wgft_def.FtDef = (*r).ft
    if !(*ft).tree_ok[wgft_region.block_at(r, x, y, z) as usize] { return }
    wgft_region.set_block(r, x, y, z, (*ft).fam_code[(*t).fam as usize][7])
    wgft_jset.js_add(&(*sc).foliage, x, y, z)
    wgft_tscratch.scratch_note(sc, x, y, z)
}

fn place_row(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, radius: i32, dy: i32) {
    var dx: i32 = 0 - radius
    while dx <= radius {
        var dz: i32 = 0 - radius
        while dz <= radius {
            if !skip_location(t, rng, dx, dy, dz, radius) { try_place_leaf(r, sc, t, ox + dx, oy + dy, oz + dz) }
            dz = dz + 1
        }
        dx = dx + 1
    }
}

fn place_blob(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32) {
    var yy: i32 = off
    while yy >= off - fh {
        var rr: i32 = radius - 1 - yy / 2
        if rr < 0 { rr = 0 }
        place_row(r, sc, rng, t, ox, oy, oz, rr, yy)
        yy = yy - 1
    }
}

fn place_spruce(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32) {
    var cur: i32 = mg_random.rng_next_int_bound(rng, 2)
    var a: i32 = 1
    var b: i32 = 0
    var yy: i32 = off
    while yy >= 0 - fh {
        place_row(r, sc, rng, t, ox, oy, oz, cur, yy)
        if cur >= a {
            cur = b
            b = 1
            a = a + 1
            if a > radius { a = radius }
        } else {
            cur = cur + 1
        }
        yy = yy - 1
    }
}

fn place_pine(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32) {
    var cur: i32 = 0
    var yy: i32 = off
    while yy >= off - fh {
        place_row(r, sc, rng, t, ox, oy, oz, cur, yy)
        if cur >= 1 && yy == off - fh + 1 {
            cur = cur - 1
        } else if cur < radius {
            cur = cur + 1
        }
        yy = yy - 1
    }
}

fn place_foliage(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32) {
    let off: i32 = sample_int(rng, (*t).off_lo, (*t).off_hi, (*t).off_uni)
    if (*t).fol == wgft_def.FL_BLOB {
        place_blob(r, sc, rng, t, ox, oy, oz, fh, radius, off)
    } else if (*t).fol == wgft_def.FL_SPRUCE {
        place_spruce(r, sc, rng, t, ox, oy, oz, fh, radius, off)
    } else {
        place_pine(r, sc, rng, t, ox, oy, oz, fh, radius, off)
    }
}
