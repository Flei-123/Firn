import mc.gen.mg_random
import noise.jnum
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_jset
import mc.gen.wgft_tscratch
import mc.gen.wgft_leaf
import mc.gen.wgft_cherryfol
import mc.gen.wgft_spread

export { sample_int, place_foliage }

fn sample_int(rng: *mut mg_random.Rng, lo: i32, hi: i32, uniform: bool) -> i32 {
    if !uniform { return lo }
    return mg_random.rng_next_int_bound(rng, hi - lo + 1) + lo
}

fn abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

fn min_i32(a: i32, b: i32) -> i32 {
    if a < b { return a }
    return b
}

fn skip_location(t: *wgft_def.TreeCfg, rng: *mut mg_random.Rng, ax: i32, dy: i32, az: i32, radius: i32, dbl: bool) -> bool {
    if (*t).fol == wgft_def.FL_MEGA_PINE || (*t).fol == wgft_def.FL_MEGA_JUNGLE { return ax + az >= 7 || ax * ax + az * az > radius * radius }
    if (*t).fol == wgft_def.FL_BUSH { return ax == radius && az == radius && mg_random.rng_next_int_bound(rng, 2) == 0 }
    if (*t).fol == wgft_def.FL_DARK_OAK {
        if dy == 0 - 1 && !dbl { return ax == radius && az == radius }
        if dy == 1 { return ax + az > radius * 2 - 2 }
        return false
    }
    if (*t).fol == wgft_def.FL_BLOB {
        return ax == radius && az == radius && (mg_random.rng_next_int_bound(rng, 2) == 0 || dy == 0)
    }
    if (*t).fol == wgft_def.FL_FANCY {
        let qx: i32 = 2 * ax + 1
        let qz: i32 = 2 * az + 1
        return qx * qx + qz * qz > 4 * radius * radius
    }
    if (*t).fol == wgft_def.FL_ACACIA {
        if dy == 0 { return (ax > 1 || az > 1) && ax != 0 && az != 0 }
        return ax == radius && az == radius && radius > 0
    }
    return ax == radius && az == radius && radius > 0
}

fn skip_signed(t: *wgft_def.TreeCfg, rng: *mut mg_random.Rng, dx: i32, dy: i32, dz: i32, radius: i32, dbl: bool) -> bool {
    if (*t).fol == wgft_def.FL_DARK_OAK && dy == 0 && dbl && (dx == 0 - radius || dx >= radius) && (dz == 0 - radius || dz >= radius) { return true }
    if dbl { return skip_location(t, rng, min_i32(abs_i32(dx), abs_i32(dx - 1)), dy, min_i32(abs_i32(dz), abs_i32(dz - 1)), radius, dbl) }
    return skip_location(t, rng, abs_i32(dx), dy, abs_i32(dz), radius, dbl)
}

fn place_row(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, radius: i32, dy: i32, dbl: bool) {
    var extra: i32 = 0
    if dbl { extra = 1 }
    var dx: i32 = 0 - radius
    while dx <= radius + extra {
        var dz: i32 = 0 - radius
        while dz <= radius + extra {
            if !skip_signed(t, rng, dx, dy, dz, radius, dbl) { wgft_leaf.try_place_leaf(r, sc, rng, t, ox + dx, oy + dy, oz + dz) }
            dz = dz + 1
        }
        dx = dx + 1
    }
}

fn place_blob(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32, radius_off: i32) {
    var yy: i32 = off
    while yy >= off - fh {
        var rr: i32 = radius + radius_off - 1 - yy / 2
        if rr < 0 { rr = 0 }
        place_row(r, sc, rng, t, ox, oy, oz, rr, yy, false)
        yy = yy - 1
    }
}

fn place_spruce(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32) {
    var cur: i32 = mg_random.rng_next_int_bound(rng, 2)
    var a: i32 = 1
    var b: i32 = 0
    var yy: i32 = off
    while yy >= 0 - fh {
        place_row(r, sc, rng, t, ox, oy, oz, cur, yy, false)
        if cur >= a {
            cur = b
            b = 1
            a = a + 1
            if a > radius { a = radius }
        } else {
            cur = cur + 1
        }
        yy = yy - 1
    }
}

fn place_pine(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32) {
    var cur: i32 = 0
    var yy: i32 = off
    while yy >= off - fh {
        place_row(r, sc, rng, t, ox, oy, oz, cur, yy, false)
        if cur >= 1 && yy == off - fh + 1 {
            cur = cur - 1
        } else if cur < radius {
            cur = cur + 1
        }
        yy = yy - 1
    }
}

fn place_fancy(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32) {
    var yy: i32 = off
    while yy >= off - fh {
        var rr: i32 = radius
        if yy != off && yy != off - fh { rr = radius + 1 }
        place_row(r, sc, rng, t, ox, oy, oz, rr, yy, false)
        yy = yy - 1
    }
}

fn place_acacia(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32, radius_off: i32) {
    let top: i32 = oy + off
    place_row(r, sc, rng, t, ox, top, oz, radius + radius_off, 0 - 1 - fh, false)
    place_row(r, sc, rng, t, ox, top, oz, radius - 1, 0 - fh, false)
    place_row(r, sc, rng, t, ox, top, oz, radius + radius_off - 1, 0, false)
}

#[allow_fp]
fn place_mega_pine(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32, radius_off: i32, dbl: bool) {
    var prev: i32 = 0
    var yy: i32 = oy - fh + off
    while yy <= oy + off {
        let dy: i32 = oy - yy
        let cur: i32 = radius + radius_off + jnum.floor_i32((((dy as f32) / (fh as f32) * 3.5f) as f64))
        var rr: i32 = cur
        if dy > 0 && cur == prev && (yy & 1) == 0 { rr = cur + 1 }
        place_row(r, sc, rng, t, ox, yy, oz, rr, 0, dbl)
        prev = cur
        yy = yy + 1
    }
}

fn place_mega_jungle(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32, radius_off: i32, dbl: bool) {
    var h: i32 = fh
    if !dbl { h = 1 + mg_random.rng_next_int_bound(rng, 2) }
    var yy: i32 = off
    while yy >= off - h {
        place_row(r, sc, rng, t, ox, oy, oz, radius + radius_off + 1 - yy, yy, dbl)
        yy = yy - 1
    }
}

fn place_bush(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, off: i32, radius_off: i32, dbl: bool) {
    var yy: i32 = off
    while yy >= off - fh {
        place_row(r, sc, rng, t, ox, oy, oz, radius + radius_off - 1 - yy, yy, dbl)
        yy = yy - 1
    }
}

fn place_dark_oak(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, radius: i32, off: i32, dbl: bool) {
    let top: i32 = oy + off
    if dbl {
        place_row(r, sc, rng, t, ox, top, oz, radius + 2, 0 - 1, dbl)
        place_row(r, sc, rng, t, ox, top, oz, radius + 3, 0, dbl)
        place_row(r, sc, rng, t, ox, top, oz, radius + 2, 1, dbl)
        if mg_random.rng_next_bool(rng) { place_row(r, sc, rng, t, ox, top, oz, radius, 2, dbl) }
    } else {
        place_row(r, sc, rng, t, ox, top, oz, radius + 2, 0 - 1, dbl)
        place_row(r, sc, rng, t, ox, top, oz, radius + 1, 0, dbl)
    }
}

fn place_one(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32, radius_off: i32, dbl: bool) {
    let off: i32 = sample_int(rng, (*t).off_lo, (*t).off_hi, (*t).off_uni)
    if (*t).fol == wgft_def.FL_BLOB {
        place_blob(r, sc, rng, t, ox, oy, oz, fh, radius, off, radius_off)
    } else if (*t).fol == wgft_def.FL_SPRUCE {
        place_spruce(r, sc, rng, t, ox, oy, oz, fh, radius, off)
    } else if (*t).fol == wgft_def.FL_PINE {
        place_pine(r, sc, rng, t, ox, oy, oz, fh, radius, off)
    } else if (*t).fol == wgft_def.FL_FANCY {
        place_fancy(r, sc, rng, t, ox, oy, oz, fh, radius, off)
    } else if (*t).fol == wgft_def.FL_MEGA_PINE {
        place_mega_pine(r, sc, rng, t, ox, oy, oz, fh, radius, off, radius_off, dbl)
    } else if (*t).fol == wgft_def.FL_MEGA_JUNGLE {
        place_mega_jungle(r, sc, rng, t, ox, oy, oz, fh, radius, off, radius_off, dbl)
    } else if (*t).fol == wgft_def.FL_BUSH {
        place_bush(r, sc, rng, t, ox, oy, oz, fh, radius, off, radius_off, dbl)
    } else if (*t).fol == wgft_def.FL_CHERRY {
        wgft_cherryfol.place_cherry(r, sc, rng, t, ox, oy, oz, fh, radius, off, radius_off)
    } else if (*t).fol == wgft_def.FL_SPREAD {
        wgft_spread.place_spread(r, sc, rng, t, ox, oy, oz, fh, radius)
    } else if (*t).fol == wgft_def.FL_DARK_OAK {
        place_dark_oak(r, sc, rng, t, ox, oy, oz, radius, off, dbl)
    } else {
        place_acacia(r, sc, rng, t, ox, oy, oz, fh, radius, off, radius_off)
    }
}

fn place_foliage(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, fh: i32, radius: i32) {
    var i: usize = 0
    while i < (*sc).n_attach {
        place_one(r, sc, rng, t, (*sc).at_x[i], (*sc).at_y[i], (*sc).at_z[i], fh, radius, (*sc).at_off[i], (*sc).at_dbl[i])
        i = i + 1
    }
}
