import std.json
import std.jsonstr
import mc.gen.wgft_def
import mc.gen.wgft_ldctx

export { load_trunk, load_foliage }

fn load_pair(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32, lo: *mut i32, hi: *mut i32) {
    if node == wgft_ldctx.NONE_NODE {
        (*l).ok = false
        return
    }
    var body: u32 = node
    if jsonstr.get(d, node, "type") != wgft_ldctx.NONE_NODE { body = jsonstr.get(d, node, "value") }
    *lo = wgft_ldctx.num_or_fail(l, d, body, "min_inclusive")
    *hi = wgft_ldctx.num_or_fail(l, d, body, "max_inclusive")
}

fn load_count(l: *mut wgft_ldctx.Ld, c: *mut wgft_def.CherryCfg, d: *mut json.Json, node: u32) {
    if json.json_kind(d, node) == json.JSON_NUMBER {
        (*c).n = 1
        (*c).val[0] = json.json_number(d, node) as i32
        (*c).weight[0] = 1
        return
    }
    let dist: u32 = jsonstr.get(d, node, "distribution")
    if dist == wgft_ldctx.NONE_NODE {
        (*l).ok = false
        return
    }
    let n: usize = json.json_count(d, dist)
    if n == 0 || n > 3 {
        (*l).ok = false
        return
    }
    (*c).n = n
    var i: usize = 0
    while i < n {
        let e: u32 = json.json_child_at(d, dist, i)
        (*c).val[i] = wgft_ldctx.num_or_fail(l, d, e, "data")
        (*c).weight[i] = wgft_ldctx.num_or_fail(l, d, e, "weight")
        i = i + 1
    }
}

fn load_trunk(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, node: u32) {
    let c: *mut wgft_def.CherryCfg = &(*t).cherry
    load_count(l, c, d, jsonstr.get(d, node, "branch_count"))
    load_pair(l, d, jsonstr.get(d, node, "branch_horizontal_length"), &(*c).len_lo, &(*c).len_hi)
    load_pair(l, d, jsonstr.get(d, node, "branch_start_offset_from_top"), &(*c).start_lo, &(*c).start_hi)
    load_pair(l, d, jsonstr.get(d, node, "branch_end_offset_from_top"), &(*c).end_lo, &(*c).end_hi)
}

#[allow_fp]
fn load_foliage(l: *mut wgft_ldctx.Ld, t: *mut wgft_def.TreeCfg, d: *mut json.Json, node: u32) {
    let c: *mut wgft_def.CherryCfg = &(*t).cherry
    (*c).wide_hole = json.json_number(d, jsonstr.get(d, node, "wide_bottom_layer_hole_chance")) as f32
    (*c).corner_hole = json.json_number(d, jsonstr.get(d, node, "corner_hole_chance")) as f32
    (*c).hang = json.json_number(d, jsonstr.get(d, node, "hanging_leaves_chance")) as f32
    (*c).hang_ext = json.json_number(d, jsonstr.get(d, node, "hanging_leaves_extension_chance")) as f32
}
