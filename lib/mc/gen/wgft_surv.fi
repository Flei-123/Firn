import mc.gen.wgft_def
import mc.gen.wgft_region

export { SV_NONE, SV_BUSH, SV_DRY, SV_LILY, kind_of, is_double, can_survive }

const SV_NONE: i32 = 0
const SV_BUSH: i32 = 1
const SV_DRY: i32 = 2
const SV_LILY: i32 = 3

fn kind_of(name: str) -> i32 {
    if name == "pumpkin" || name == "melon" { return SV_NONE }
    if name == "dead_bush" { return SV_DRY }
    if name == "lily_pad" { return SV_LILY }
    if name == "grass" || name == "fern" || name == "tall_grass" || name == "large_fern" || name == "sunflower" || name == "lilac" || name == "rose_bush" || name == "peony" { return SV_BUSH }
    if name == "dandelion" || name == "poppy" || name == "blue_orchid" || name == "allium" || name == "azure_bluet" || name == "red_tulip" || name == "orange_tulip" || name == "white_tulip" || name == "pink_tulip" || name == "oxeye_daisy" || name == "cornflower" || name == "lily_of_the_valley" || name == "wither_rose" || name == "torchflower" || name == "sweet_berry_bush" { return SV_BUSH }
    return 0 - 1
}

fn is_double(name: str) -> bool {
    return name == "tall_grass" || name == "large_fern" || name == "sunflower" || name == "lilac" || name == "rose_bush" || name == "peony"
}

fn can_survive(r: *wgft_region.Region, kind: i32, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    let below: u8 = wgft_region.block_at(r, x, y - 1, z)
    if kind == SV_NONE { return true }
    if kind == SV_BUSH { return (*ft).dirt[below as usize] }
    if kind == SV_DRY { return (*ft).dry[below as usize] }
    let here: u8 = wgft_region.block_at(r, x, y, z)
    return (below == (*ft).water_code || below == (*ft).ice_code) && !(*ft).fluid[here as usize]
}
