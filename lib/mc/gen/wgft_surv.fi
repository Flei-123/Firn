import std.rt
import mc.gen.wgft_def
import mc.gen.wgft_region

export { is_thin, SV_NONE, SV_BUSH, SV_DRY, SV_LILY, SV_AZALEA, SV_CARPET, SV_SPORE, SV_DRIP, kind_of, is_double, is_ground_plant, can_survive }

const SV_NONE: i32 = 0
const SV_BUSH: i32 = 1
const SV_DRY: i32 = 2
const SV_LILY: i32 = 3
const SV_AZALEA: i32 = 4
const SV_CARPET: i32 = 5
const SV_SPORE: i32 = 6
const SV_DRIP: i32 = 7

fn is_ground_plant(kind: i32) -> bool {
    return kind >= SV_BUSH && kind <= SV_LILY
}

fn kind_of(name: str) -> i32 {
    if name == "pumpkin" || name == "melon" { return SV_NONE }
    if name == "cave_vines" || name == "cave_vines_plant" || name == "big_dripleaf" || name == "big_dripleaf_stem" { return SV_NONE }
    if name == "azalea" || name == "flowering_azalea" { return SV_AZALEA }
    if name == "moss_carpet" { return SV_CARPET }
    if starts_with(name, "pink_petals") { return SV_BUSH }
    if name == "spore_blossom" { return SV_SPORE }
    if name == "small_dripleaf" { return SV_DRIP }
    if name == "dead_bush" { return SV_DRY }
    if name == "lily_pad" { return SV_LILY }
    if name == "grass" || name == "fern" || name == "tall_grass" || name == "large_fern" || name == "sunflower" || name == "lilac" || name == "rose_bush" || name == "peony" { return SV_BUSH }
    if name == "dandelion" || name == "poppy" || name == "blue_orchid" || name == "allium" || name == "azure_bluet" || name == "red_tulip" || name == "orange_tulip" || name == "white_tulip" || name == "pink_tulip" || name == "oxeye_daisy" || name == "cornflower" || name == "lily_of_the_valley" || name == "wither_rose" || name == "torchflower" || name == "sweet_berry_bush" { return SV_BUSH }
    return 0 - 1
}

fn is_double(name: str) -> bool {
    return name == "tall_grass" || name == "large_fern" || name == "sunflower" || name == "lilac" || name == "rose_bush" || name == "peony" || name == "small_dripleaf"
}

fn can_survive(r: *wgft_region.Region, kind: i32, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    let below: u16 = wgft_region.block_at(r, x, y - 1, z)
    if kind == SV_NONE { return true }
    if kind == SV_BUSH { return (*ft).dirt[below as usize] }
    if kind == SV_DRY { return (*ft).dry[below as usize] }
    if kind == SV_AZALEA { return (*ft).dirt[below as usize] || below == (*ft).clay_code }
    if kind == SV_CARPET { return !(*ft).air[below as usize] }
    let here: u16 = wgft_region.block_at(r, x, y, z)
    if kind == SV_SPORE { return (*ft).sturdy_down[wgft_region.block_at(r, x, y + 1, z) as usize] && !(*ft).wet[here as usize] }
    if kind == SV_DRIP { return (*ft).drip_on[below as usize] || ((*ft).wet[here as usize] && (*ft).dirt[below as usize]) }
    return (below == (*ft).water_code || below == (*ft).ice_code) && !(*ft).fluid[here as usize]
}

fn is_thin(name: str) -> bool {
    return starts_with(name, "bamboo[") || name == "cocoa" || name == "bamboo" || name == "bamboo_sapling" || name == "azalea" || name == "flowering_azalea" || name == "big_dripleaf" || ends_with(name, "_sapling") || ends_with(name, "_propagule") || ends_with(name, "_fence") || ends_with(name, "_slab") || ends_with(name, "_stairs")
}

fn starts_with(s: str, prefix: str) -> bool {
    if s.n < prefix.n { return false }
    return rt.mem_eq(s.p as u64, prefix.p as u64, prefix.n)
}

fn ends_with(s: str, suffix: str) -> bool {
    if s.n < suffix.n { return false }
    return rt.mem_eq((s.p as u64) + ((s.n - suffix.n) as u64), suffix.p as u64, suffix.n)
}
