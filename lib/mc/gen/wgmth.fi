import std.math

export { sin_fill, sin_lookup, cos_lookup }

#[allow_fp]
fn sin_fill(tab: u64) {
    let pi: f64 = 3.141592653589793
    var i: usize = 0
    while i < 65536 {
        *((tab + (i as u64) * 4) as *mut f32) = math.sin((i as f64) * pi * 2.0 / 65536.0) as f32
        i = i + 1
    }
}

#[allow_fp]
fn sin_lookup(tab: u64, f: f32) -> f32 {
    let k: i32 = (f * 10430.378f) as i32
    return *((tab + ((k & 65535) as u64) * 4) as *f32)
}

#[allow_fp]
fn cos_lookup(tab: u64, f: f32) -> f32 {
    let k: i32 = (f * 10430.378f + 16384.0f) as i32
    return *((tab + ((k & 65535) as u64) * 4) as *f32)
}
