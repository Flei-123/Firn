import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_surv
import mc.gen.wgft_prov

export { place }

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    let code: u16 = wgft_prov.pick(ft, &(*ft).provs[(*f).p[0] as usize], (*c).rng, x, y, z)
    if !wgft_surv.can_survive(r, (*ft).st_surv[code as usize] as i32, x, y, z) { return false }
    if (*ft).dbl[code as usize] {
        if !(*ft).air[wgft_region.block_at(r, x, y + 1, z) as usize] { return false }
        wgft_region.set_block(r, x, y, z, code)
        wgft_region.set_block(r, x, y + 1, z, code)
        return true
    }
    wgft_region.set_block(r, x, y, z, code)
    return true
}
