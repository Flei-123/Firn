import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region
import mc.gen.wgft_surv

export { place }

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    if !wgft_surv.can_survive(r, (*f).surv, x, y, z) { return false }
    if (*f).double_plant {
        if !(*(*r).ft).air[wgft_region.block_at(r, x, y + 1, z) as usize] { return false }
        wgft_region.set_block(r, x, y, z, (*f).out_code[0])
        wgft_region.set_block(r, x, y + 1, z, (*f).out_code[0])
        return true
    }
    wgft_region.set_block(r, x, y, z, (*f).out_code[0])
    return true
}
