import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch
import mc.gen.wgft_surv

export { update_edges }

const DIR_DOWN: i32 = 0
const DIR_UP: i32 = 1

fn is_orphan(r: *mut wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    if !(*ft).dbl[wgft_region.block_at(r, x, y, z) as usize] { return false }
    return !(*ft).dbl[wgft_region.block_at(r, x, y + 1, z) as usize] && !(*ft).dbl[wgft_region.block_at(r, x, y - 1, z) as usize]
}

fn clear_orphan(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, x: i32, y: i32, z: i32) {
    if wgft_tscratch.in_box(sc, x, y, z) && (*sc).voxel[wgft_tscratch.voxel_index(sc, x, y, z)] { return }
    if is_orphan(r, x, y, z) { wgft_region.set_block(r, x, y, z, (*(*r).ft).air_code) }
}

fn vine_face(ft: *wgft_def.FtDef, code: u16) -> i32 {
    var k: usize = 0
    while k < 4 {
        if (*ft).vine_code[k] == code { return k as i32 }
        k = k + 1
    }
    return 0 - 1
}

fn face_dx(k: i32) -> i32 {
    if k == 0 { return 1 }
    if k == 1 { return 0 - 1 }
    return 0
}

fn face_dz(k: i32) -> i32 {
    if k == 2 { return 1 }
    if k == 3 { return 0 - 1 }
    return 0
}

fn update_vine(r: *mut wgft_region.Region, x: i32, y: i32, z: i32) {
    let ft: *wgft_def.FtDef = (*r).ft
    let k: i32 = vine_face(ft, wgft_region.block_at(r, x, y, z))
    if k < 0 { return }
    if (*ft).attach[wgft_region.block_at(r, x + face_dx(k), y, z + face_dz(k)) as usize] { return }
    if wgft_region.block_at(r, x, y + 1, z) == (*ft).vine_code[k as usize] { return }
    wgft_region.set_block(r, x, y, z, (*ft).air_code)
}

fn update_plant(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, x: i32, y: i32, z: i32) {
    if wgft_tscratch.in_box(sc, x, y, z) && (*sc).voxel[wgft_tscratch.voxel_index(sc, x, y, z)] { return }
    let ft: *wgft_def.FtDef = (*r).ft
    let code: u16 = wgft_region.block_at(r, x, y, z)
    let kind: i32 = (*ft).st_surv[code as usize] as i32
    if kind == 0 || (*ft).dbl[code as usize] { return }
    if !wgft_surv.can_survive(r, kind, x, y, z) { wgft_region.set_block(r, x, y, z, (*ft).air_code) }
}

fn consume(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, dir: i32, x: i32, y: i32, z: i32) {
    var qx: i32 = x
    var qy: i32 = y
    var qz: i32 = z
    if dir == 0 { qy = y - 1 }
    if dir == 1 { qy = y + 1 }
    if dir == 2 { qz = z - 1 }
    if dir == 3 { qz = z + 1 }
    if dir == 4 { qx = x - 1 }
    if dir == 5 { qx = x + 1 }
    if dir != DIR_DOWN { update_vine(r, x, y, z) }
    if dir != DIR_UP { update_vine(r, qx, qy, qz) }
    if dir == DIR_DOWN || dir == DIR_UP { clear_orphan(r, sc, qx, qy, qz) }
    update_plant(r, sc, qx, qy, qz)
}

fn voxel_full(sc: *wgft_tscratch.TreeScratch, x: i32, y: i32, z: i32) -> bool {
    return (*sc).voxel[wgft_tscratch.voxel_index(sc, x, y, z)]
}

fn scan_pass(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, pass: i32) {
    let sx: i32 = (*sc).max_x - (*sc).min_x + 1
    let sy: i32 = (*sc).max_y - (*sc).min_y + 1
    let sz: i32 = (*sc).max_z - (*sc).min_z + 1
    var size_a: i32 = sx
    var size_b: i32 = sy
    var size_c: i32 = sz
    var neg_dir: i32 = 2
    if pass == 1 {
        size_a = sz
        size_b = sx
        size_c = sy
        neg_dir = 0
    }
    if pass == 2 {
        size_a = sy
        size_b = sz
        size_c = sx
        neg_dir = 4
    }
    var a: i32 = 0
    while a < size_a {
        var b: i32 = 0
        while b < size_b {
            var prev: bool = false
            var c: i32 = 0
            while c <= size_c {
                var cur: bool = false
                var x: i32 = (*sc).min_x + a
                var y: i32 = (*sc).min_y + b
                var z: i32 = (*sc).min_z + c
                if pass == 1 {
                    z = (*sc).min_z + a
                    x = (*sc).min_x + b
                    y = (*sc).min_y + c
                }
                if pass == 2 {
                    y = (*sc).min_y + a
                    z = (*sc).min_z + b
                    x = (*sc).min_x + c
                }
                if c != size_c { cur = voxel_full(sc, x, y, z) }
                if !prev && cur { consume(r, sc, neg_dir, x, y, z) }
                if prev && !cur {
                    var px: i32 = x
                    var py: i32 = y
                    var pz: i32 = z
                    if pass == 0 { pz = z - 1 }
                    if pass == 1 { py = y - 1 }
                    if pass == 2 { px = x - 1 }
                    consume(r, sc, neg_dir + 1, px, py, pz)
                }
                prev = cur
                c = c + 1
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn update_edges(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch) {
    scan_pass(r, sc, 0)
    scan_pass(r, sc, 1)
    scan_pass(r, sc, 2)
}
