// SPDX-License-Identifier: MPL-2.0
import noise.jnum
import mc.gen.mg_random
import mc.gen.wgsr_def
import mc.gen.wgsr_ctx

export { cond_eval, rule_apply }

const INT_MIN: i32 = -2147483647 - 1

fn mask_has(d: *wgsr_def.SrDef, c: i32, b: i32) -> bool {
    if b < 64 { return (((*d).cm0[c as usize] >> (b as u64)) & 1) != 0 }
    if b < 128 { return (((*d).cm1[c as usize] >> ((b - 64) as u64)) & 1) != 0 }
    return false
}

#[allow_fp]
fn depth_cond(c: *mut wgsr_ctx.SrCtx, i: usize) -> bool {
    let d: *wgsr_def.SrDef = (*c).def
    var stone: i32 = (*c).d_above
    if (*d).ci3[i] == 1 { stone = (*c).d_below }
    var sd: i32 = 0
    if (*d).ci1[i] != 0 { sd = (*c).depth_s }
    var sec: i32 = 0
    let range: i32 = (*d).ci2[i]
    if range != 0 {
        let t: f64 = (wgsr_ctx.ctx_secondary(c) + 1.0) / 2.0
        sec = jnum.d2i(0.0 + t * (range as f64))
    }
    return stone <= 1 +% (*d).ci0[i] +% sd +% sec
}

#[allow_fp]
fn gradient_cond(c: *mut wgsr_ctx.SrCtx, i: usize) -> bool {
    let d: *wgsr_def.SrDef = (*c).def
    let y: i32 = (*c).y
    let lo: i32 = (*d).ci0[i]
    let hi: i32 = (*d).ci1[i]
    if y <= lo { return true }
    if y >= hi { return false }
    let delta: f64 = ((y as f64) - (lo as f64)) / ((hi as f64) - (lo as f64))
    let p: f64 = 1.0 + delta * (0.0 - 1.0)
    var r: mg_random.Rng = mg_random.pos_at(&(*d).grad_pf[(*d).ci2[i] as usize], (*c).x, y, (*c).z)
    let f: f32 = mg_random.rng_next_float(&r)
    return (f as f64) < p
}

fn cond_eval(c: *mut wgsr_ctx.SrCtx, ci: i32) -> bool {
    let d: *wgsr_def.SrDef = (*c).def
    let i: usize = ci as usize
    let k: u8 = (*d).ck[i]
    if k == wgsr_def.CK_BIOME { return mask_has(d, ci, wgsr_ctx.ctx_biome(c)) }
    if k == wgsr_def.CK_DEPTH { return depth_cond(c, i) }
    if k == wgsr_def.CK_Y {
        var add: i32 = 0
        if (*d).ci2[i] != 0 { add = (*c).d_above }
        return (*c).y +% add >= (*d).ci0[i] +% (*c).depth_s *% (*d).ci1[i]
    }
    if k == wgsr_def.CK_WATER {
        if (*c).water_h == INT_MIN { return true }
        var add: i32 = 0
        if (*d).ci2[i] != 0 { add = (*c).d_above }
        return (*c).y +% add >= (*c).water_h +% (*d).ci0[i] +% (*c).depth_s *% (*d).ci1[i]
    }
    if k == wgsr_def.CK_NOISE {
        let v: f64 = wgsr_ctx.ctx_noise(c, (*d).ci0[i])
        return v >= (*d).cf0[i] && v <= (*d).cf1[i]
    }
    if k == wgsr_def.CK_GRADIENT { return gradient_cond(c, i) }
    if k == wgsr_def.CK_NOT { return !cond_eval(c, (*d).ci0[i]) }
    if k == wgsr_def.CK_STEEP { return wgsr_ctx.ctx_steep(c) }
    if k == wgsr_def.CK_TEMP { return wgsr_ctx.ctx_cold(c) }
    if k == wgsr_def.CK_HOLE { return (*c).depth_s <= 0 }
    return wgsr_ctx.ctx_min_surface(c) <= (*c).y
}

#[allow_fp]
fn band_code(c: *mut wgsr_ctx.SrCtx) -> i32 {
    let d: *wgsr_def.SrDef = (*c).def
    let v: f64 = wgsr_ctx.ctx_noise(c, (*d).s_bands) * 4.0
    let off: i32 = jnum.floor_i32(v + 0.5)
    let n: i32 = ((*c).y + off + 192) % 192
    return (*d).bands[n as usize] as i32
}

fn rule_apply(c: *mut wgsr_ctx.SrCtx, ri: i32) -> i32 {
    let d: *wgsr_def.SrDef = (*c).def
    let i: usize = ri as usize
    let k: u8 = (*d).rk[i]
    if k == wgsr_def.RK_BLOCK { return (*d).ra[i] }
    if k == wgsr_def.RK_COND {
        if cond_eval(c, (*d).ra[i]) { return rule_apply(c, (*d).rb[i]) }
        return 0 - 1
    }
    if k == wgsr_def.RK_SEQ {
        var j: i32 = 0
        while j < (*d).rb[i] {
            let r: i32 = rule_apply(c, (*d).items[((*d).ra[i] + j) as usize])
            if r >= 0 { return r }
            j = j + 1
        }
        return 0 - 1
    }
    return band_code(c)
}
