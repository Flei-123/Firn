import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region

export { place_weeping, place_twisting }

fn is_air(r: *wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    return (*(*r).ft).air[wgft_region.block_at(r, x, y, z) as usize]
}

fn between(rng: *mut mg_random.Rng, lo: i32, hi: i32) -> i32 {
    if lo >= hi { return lo }
    return mg_random.rng_next_int_bound(rng, hi - lo + 1) + lo
}

fn column_length(rng: *mut mg_random.Rng, max_len: i32) -> i32 {
    var n: i32 = between(rng, 1, max_len)
    if mg_random.rng_next_int_bound(rng, 6) == 0 { n = n * 2 }
    if mg_random.rng_next_int_bound(rng, 5) == 0 { n = 1 }
    return n
}

fn grow_wart(c: *wgft_ctx.PlaceCtx, wart: u16, rock: u16, x: i32, y: i32, z: i32) {
    let r: *mut wgft_region.Region = (*c).r
    wgft_region.set_block(r, x, y, z, wart)
    var i: i32 = 0
    while i < 200 {
        let dx: i32 = mg_random.rng_next_int_bound((*c).rng, 6) - mg_random.rng_next_int_bound((*c).rng, 6)
        let dy: i32 = mg_random.rng_next_int_bound((*c).rng, 2) - mg_random.rng_next_int_bound((*c).rng, 5)
        let dz: i32 = mg_random.rng_next_int_bound((*c).rng, 6) - mg_random.rng_next_int_bound((*c).rng, 6)
        let px: i32 = x + dx
        let py: i32 = y + dy
        let pz: i32 = z + dz
        if is_air(r, px, py, pz) {
            var n: i32 = 0
            let b0: u16 = wgft_region.block_at(r, px, py - 1, pz)
            let b1: u16 = wgft_region.block_at(r, px, py + 1, pz)
            let b2: u16 = wgft_region.block_at(r, px, py, pz - 1)
            let b3: u16 = wgft_region.block_at(r, px, py, pz + 1)
            let b4: u16 = wgft_region.block_at(r, px - 1, py, pz)
            let b5: u16 = wgft_region.block_at(r, px + 1, py, pz)
            if b0 == rock || b0 == wart { n = n + 1 }
            if b1 == rock || b1 == wart { n = n + 1 }
            if b2 == rock || b2 == wart { n = n + 1 }
            if b3 == rock || b3 == wart { n = n + 1 }
            if b4 == rock || b4 == wart { n = n + 1 }
            if b5 == rock || b5 == wart { n = n + 1 }
            if n == 1 { wgft_region.set_block(r, px, py, pz, wart) }
        }
        i = i + 1
    }
}

fn weeping_column(c: *wgft_ctx.PlaceCtx, head: u16, plant: u16, x: i32, y: i32, z: i32, len: i32) {
    let r: *mut wgft_region.Region = (*c).r
    var cy: i32 = y
    var i: i32 = 0
    while i <= len {
        if is_air(r, x, cy, z) {
            if i == len || !is_air(r, x, cy - 1, z) {
                wgft_region.set_block(r, x, cy, z, head)
                let age: i32 = between((*c).rng, 17, 25)
                break
            }
            wgft_region.set_block(r, x, cy, z, plant)
        }
        cy = cy - 1
        i = i + 1
    }
}

fn twisting_column(c: *wgft_ctx.PlaceCtx, head: u16, plant: u16, x: i32, y: i32, z: i32, len: i32) {
    let r: *mut wgft_region.Region = (*c).r
    var cy: i32 = y
    var i: i32 = 1
    while i <= len {
        if is_air(r, x, cy, z) {
            if i == len || !is_air(r, x, cy + 1, z) {
                wgft_region.set_block(r, x, cy, z, head)
                let age: i32 = between((*c).rng, 17, 25)
                break
            }
            wgft_region.set_block(r, x, cy, z, plant)
        }
        cy = cy + 1
        i = i + 1
    }
}

fn place_weeping(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let wart: u16 = (*f).p[0] as u16
    let rock: u16 = (*f).p[1] as u16
    if !is_air(r, x, y, z) { return false }
    let above: u16 = wgft_region.block_at(r, x, y + 1, z)
    if above != rock && above != wart { return false }
    grow_wart(c, wart, rock, x, y, z)
    var i: i32 = 0
    while i < 100 {
        let dx: i32 = mg_random.rng_next_int_bound((*c).rng, 8) - mg_random.rng_next_int_bound((*c).rng, 8)
        let dy: i32 = mg_random.rng_next_int_bound((*c).rng, 2) - mg_random.rng_next_int_bound((*c).rng, 7)
        let dz: i32 = mg_random.rng_next_int_bound((*c).rng, 8) - mg_random.rng_next_int_bound((*c).rng, 8)
        let px: i32 = x + dx
        let py: i32 = y + dy
        let pz: i32 = z + dz
        if is_air(r, px, py, pz) {
            let roof: u16 = wgft_region.block_at(r, px, py + 1, pz)
            if roof == rock || roof == wart {
                let len: i32 = column_length((*c).rng, 8)
                weeping_column(c, (*f).p[2] as u16, (*f).p[3] as u16, px, py, pz, len)
            }
        }
        i = i + 1
    }
    return true
}

fn invalid_location(r: *wgft_region.Region, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    if !is_air(r, x, y, z) { return true }
    let below: i32 = wgft_region.block_at(r, x, y - 1, z) as i32
    return below != (*f).p[5] && below != (*f).p[6] && below != (*f).p[7]
}

fn first_air_above_ground(r: *wgft_region.Region, x: i32, y: i32, z: i32, out_y: *mut i32) -> bool {
    var cy: i32 = y
    while true {
        cy = cy - 1
        if cy < (*r).min_y || cy >= (*r).min_y + (*r).height { return false }
        if !is_air(r, x, cy, z) { break }
    }
    *out_y = cy + 1
    return true
}

fn place_twisting(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    if invalid_location(r, f, x, y, z) { return false }
    let sw: i32 = (*f).p[0]
    let sh: i32 = (*f).p[1]
    var i: i32 = 0
    while i < sw * sw {
        let px: i32 = x + between((*c).rng, 0 - sw, sw)
        let py0: i32 = y + between((*c).rng, 0 - sh, sh)
        let pz: i32 = z + between((*c).rng, 0 - sw, sw)
        var py: i32 = py0
        if first_air_above_ground(r, px, py0, pz, &py) && !invalid_location(r, f, px, py, pz) {
            let len: i32 = column_length((*c).rng, (*f).p[2])
            twisting_column(c, (*f).p[3] as u16, (*f).p[4] as u16, px, py, pz, len)
        }
        i = i + 1
    }
    return true
}
