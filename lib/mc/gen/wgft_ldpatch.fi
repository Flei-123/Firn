import std.json
import std.jsonstr
import mc.gen.wgft_def
import mc.gen.wgft_ldctx
import mc.gen.wgft_ldprov

export { load_veg_patch, FLAG_XZ_UNIFORM, FLAG_DEPTH_UNIFORM, FLAG_WATERLOGGED }

const FLAG_XZ_UNIFORM: i32 = 1
const FLAG_DEPTH_UNIFORM: i32 = 2
const FLAG_WATERLOGGED: i32 = 4

fn load_veg_patch(l: *mut wgft_ldctx.Ld, f: *mut wgft_def.Feat, d: *mut json.Json, cfg: u32, waterlogged: bool, sub: i32) {
    (*f).kind = wgft_def.FK_VEG_PATCH
    (*f).sub = sub
    var flags: i32 = 0
    if wgft_ldprov.int_range(l, d, jsonstr.get(d, cfg, "xz_radius"), &(*f).p[0], &(*f).p[1]) { flags = flags + FLAG_XZ_UNIFORM }
    if wgft_ldprov.int_range(l, d, jsonstr.get(d, cfg, "depth"), &(*f).p[2], &(*f).p[3]) { flags = flags + FLAG_DEPTH_UNIFORM }
    if waterlogged { flags = flags + FLAG_WATERLOGGED }
    (*f).p[7] = flags
    (*f).p[4] = wgft_ldctx.num_or_fail(l, d, cfg, "vertical_range")
    (*f).p[5] = 0 - 1
    if wgft_ldctx.bare(jsonstr.string(d, jsonstr.get(d, cfg, "surface"))) == "ceiling" { (*f).p[5] = 1 }
    (*f).sel_chance[0] = json.json_number(d, jsonstr.get(d, cfg, "extra_edge_column_chance")) as f32
    (*f).sel_chance[1] = json.json_number(d, jsonstr.get(d, cfg, "vegetation_chance")) as f32
    (*f).sel_chance[2] = json.json_number(d, jsonstr.get(d, cfg, "extra_bottom_block_chance")) as f32
    let ground: u32 = jsonstr.get(d, cfg, "ground_state")
    (*f).out_code[0] = wgft_ldctx.reg_code(l, wgft_ldprov.state_name(d, wgft_ldprov.provider_state(l, d, ground)))
    let rep: str = jsonstr.string(d, jsonstr.get(d, cfg, "replaceable"))
    if rep.n < 2 || *(rep.p) != (35 as u8) {
        (*l).ok = false
        return
    }
    (*f).p[6] = wgft_ldctx.alloc_mask(l)
    wgft_ldctx.defer_tag_mask(l, wgft_ldctx.bare(str { p: ((rep.p as u64) + 1) as *mut u8, n: rep.n - 1 }), (*f).p[6])
}
