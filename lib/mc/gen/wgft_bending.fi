import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch
import mc.gen.wgft_trunk
import mc.gen.wgft_foliage

export { place_bending }

fn place_bending(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, free: i32, x: i32, y: i32, z: i32) {
    let dir: i32 = mg_random.rng_next_int_bound(rng, 4)
    let last: i32 = free - 1
    var cx: i32 = x
    var cy: i32 = y
    var cz: i32 = z
    wgft_trunk.set_dirt(r, sc, t, x, y - 1, z)
    var i: i32 = 0
    while i <= last {
        if i + 1 >= last + mg_random.rng_next_int_bound(rng, 2) {
            cx = cx + wgft_trunk.step_x(dir)
            cz = cz + wgft_trunk.step_z(dir)
        }
        wgft_trunk.place_log(r, sc, (*t).trunk_code, cx, cy, cz)
        if i >= (*t).bend.min_leaf { wgft_tscratch.add_attach(sc, cx, cy, cz, 0) }
        cy = cy + 1
        i = i + 1
    }
    let bend: i32 = wgft_foliage.sample_int(rng, (*t).bend.lo, (*t).bend.hi, (*t).bend.uni)
    var j: i32 = 0
    while j <= bend {
        wgft_trunk.place_log(r, sc, (*t).trunk_code, cx, cy, cz)
        wgft_tscratch.add_attach(sc, cx, cy, cz, 0)
        cx = cx + wgft_trunk.step_x(dir)
        cz = cz + wgft_trunk.step_z(dir)
        j = j + 1
    }
}
