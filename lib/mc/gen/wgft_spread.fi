import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch
import mc.gen.wgft_leaf

export { place_spread }

fn offset(rng: *mut mg_random.Rng, bound: i32) -> i32 {
    let a: i32 = mg_random.rng_next_int_bound(rng, bound)
    let b: i32 = mg_random.rng_next_int_bound(rng, bound)
    return a - b
}

fn place_spread(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, t: *wgft_def.TreeCfg, ox: i32, oy: i32, oz: i32, fh: i32, radius: i32) {
    var i: i32 = 0
    while i < (*t).spread_attempts {
        let dx: i32 = offset(rng, radius)
        let dy: i32 = offset(rng, fh)
        let dz: i32 = offset(rng, radius)
        wgft_leaf.try_place_leaf(r, sc, t, ox + dx, oy + dy, oz + dz)
        i = i + 1
    }
}
