export { JSet, NODE_CAP, TABLE_CAP, MIN_TABLE, TREEIFY_MIN_TABLE, TREEIFY_COUNT, UNTREEIFY_MAX, spread_hash }

const NODE_CAP: usize = 3072
const TABLE_CAP: usize = 4096
const MIN_TABLE: usize = 16
const TREEIFY_MIN_TABLE: usize = 64
const TREEIFY_COUNT: usize = 8
const UNTREEIFY_MAX: usize = 6

struct JSet {
    cap: usize,
    size: usize,
    low: usize,
    used: usize,
    free: i32,
    head: [i32; 4096],
    tree: [bool; 4096],
    kx: [i32; 3072],
    ky: [i32; 3072],
    kz: [i32; 3072],
    hs: [i64; 3072],
    nx: [i32; 3072],
    pv: [i32; 3072],
    lf: [i32; 3072],
    rt: [i32; 3072],
    pr: [i32; 3072],
    rd: [bool; 3072],
}

fn spread_hash(x: i32, y: i32, z: i32) -> i64 {
    let h: i64 = ((((y as i64) + (z as i64) * 31) * 31) + (x as i64)) & 4294967295
    let m: i64 = h ^ (h >> 16)
    if m >= 2147483648 { return m - 4294967296 }
    return m
}
