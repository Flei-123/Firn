import std.rt
import mc.gen.mg_random
import mc.gen.wgdf_fluid
import mc.gen.wgdf_graph
import noise.psimplex

export {
    SrDef, def_bytes, def_new, def_free, block_code, block_find, block_name, block_count, FIRST_CODE,
    CODE_ICE, CODE_SNOW, RK_BLOCK, RK_SEQ, RK_COND, RK_BAND,
    CK_PRELIM, CK_BIOME, CK_NOISE, CK_NOT, CK_STEEP, CK_DEPTH, CK_TEMP, CK_GRADIENT, CK_WATER, CK_Y, CK_HOLE,
    MAX_RULES, MAX_CONDS, MAX_ITEMS, MAX_BLOCKS, MAX_GRADIENTS, BAND_COUNT,
}

const FIRST_CODE: i32 = 128
const CODE_ICE: u8 = 135
const CODE_SNOW: u8 = 136
const MAX_RULES: usize = 1024
const MAX_CONDS: usize = 512
const MAX_ITEMS: usize = 2048
const MAX_BLOCKS: usize = 96
const MAX_GRADIENTS: usize = 16
const BAND_COUNT: usize = 192

const RK_BLOCK: u8 = 0
const RK_SEQ: u8 = 1
const RK_COND: u8 = 2
const RK_BAND: u8 = 3

const CK_PRELIM: u8 = 0
const CK_BIOME: u8 = 1
const CK_NOISE: u8 = 2
const CK_NOT: u8 = 3
const CK_STEEP: u8 = 4
const CK_DEPTH: u8 = 5
const CK_TEMP: u8 = 6
const CK_GRADIENT: u8 = 7
const CK_WATER: u8 = 8
const CK_Y: u8 = 9
const CK_HOLE: u8 = 10

struct SrDef {
    nr: usize,
    nc: usize,
    ni: usize,
    root: i32,
    rk: [u8; 1024],
    ra: [i32; 1024],
    rb: [i32; 1024],
    ck: [u8; 512],
    ci0: [i32; 512],
    ci1: [i32; 512],
    ci2: [i32; 512],
    ci3: [i32; 512],
    cf0: [f64; 512],
    cf1: [f64; 512],
    cm0: [u64; 512],
    cm1: [u64; 512],
    items: [i32; 2048],
    nblocks: usize,
    bname: [[u8; 32]; 96],
    blen: [usize; 96],
    default_name: [u8; 32],
    default_len: usize,
    n_initial: i32,
    sea_level: i32,
    min_y: i32,
    height: i32,
    legacy: bool,
    s_surface: i32,
    s_secondary: i32,
    s_bands: i32,
    s_bpillar: i32,
    s_broof: i32,
    s_bsurf: i32,
    s_ipillar: i32,
    s_iroof: i32,
    s_isurf: i32,
    nbio: usize,
    bio_temp: [f32; 96],
    bio_frozen: [bool; 96],
    b_eroded: i32,
    b_frozen: i32,
    b_deep_frozen: i32,
    ngrad: usize,
    gname: [[u8; 48]; 16],
    glen: [usize; 16],
    grad_pf: [mg_random.PosFactory; 16],
    root_pf: mg_random.PosFactory,
    bands: [u8; 192],
    zoom_seed: i64,
    t_noise: psimplex.PerlinSimplex,
    f_noise: psimplex.PerlinSimplex,
    i_noise: psimplex.PerlinSimplex,
    ready: bool,
}

fn def_bytes() -> usize {
    return wgdf_graph.wg_size_of[SrDef]()
}

fn def_new() -> *mut SrDef {
    let d: *mut SrDef = rt.heap_alloc(def_bytes()) as *mut SrDef
    rt.mem_set(d as u64, 0 as u8, def_bytes())
    return d
}

fn def_free(d: *mut SrDef) {
    rt.heap_free(d as u64, def_bytes())
}

fn name_is(d: *SrDef, i: usize, p: u64, n: usize) -> bool {
    if (*d).blen[i] != n { return false }
    var k: usize = 0
    while k < n {
        if (*d).bname[i][k] != rt.ld8(p, k) { return false }
        k = k + 1
    }
    return true
}

fn block_code(d: *mut SrDef, p: u64, n: usize) -> i32 {
    if n == (*d).default_len {
        var same: bool = true
        var k: usize = 0
        while k < n {
            if (*d).default_name[k] != rt.ld8(p, k) { same = false }
            k = k + 1
        }
        if same { return wgdf_fluid.STATE_SOLID as i32 }
    }
    if n == 3 && rt.ld8(p, 0) == 97 && rt.ld8(p, 1) == 105 && rt.ld8(p, 2) == 114 { return wgdf_fluid.STATE_AIR as i32 }
    if n == 5 && rt.mem_eq(p, "water".p as u64, 5) { return wgdf_fluid.STATE_WATER as i32 }
    if n == 4 && rt.mem_eq(p, "lava".p as u64, 4) { return wgdf_fluid.STATE_LAVA as i32 }
    var i: usize = 0
    while i < (*d).nblocks {
        if name_is(d, i, p, n) { return FIRST_CODE + (i as i32) }
        i = i + 1
    }
    if (*d).nblocks >= MAX_BLOCKS || n > 32 { return 0 - 1 }
    var k: usize = 0
    while k < n {
        (*d).bname[(*d).nblocks][k] = rt.ld8(p, k)
        k = k + 1
    }
    (*d).blen[(*d).nblocks] = n
    (*d).nblocks = (*d).nblocks + 1
    return FIRST_CODE + ((*d).nblocks as i32) - 1
}

fn block_find(d: *SrDef, p: u64, n: usize) -> i32 {
    var i: usize = 0
    while i < (*d).nblocks {
        if name_is(d, i, p, n) { return FIRST_CODE + (i as i32) }
        i = i + 1
    }
    return 0 - 1
}

fn block_count(d: *SrDef) -> usize {
    return (*d).nblocks
}

fn block_name(d: *SrDef, i: usize) -> str {
    return str { p: &(*d).bname[i][0], n: (*d).blen[i] }
}
