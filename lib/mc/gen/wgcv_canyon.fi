// SPDX-License-Identifier: MPL-2.0
import mc.gen.mg_random
import mc.gen.wgcv_def
import mc.gen.wgcv_prov
import mc.gen.wgcv_apply

export { canyon_carve }

const RANGE_BLOCKS: i32 = 112
const MAX_DEPTH: usize = 512

#[allow_fp]
fn can_reach(run: *wgcv_apply.CvRun, x: f64, z: f64, i: i32, len: i32, th: f32) -> bool {
    let dx: f64 = x - (((*run).cx * 16 + 8) as f64)
    let dz: f64 = z - (((*run).cz * 16 + 8) as f64)
    let dl: f64 = (len - i) as f64
    let r: f64 = (th + 2.0f + 16.0f) as f64
    return dx * dx + dz * dz - dl * dl <= r * r
}

#[allow_fp]
fn width_factors(run: *wgcv_apply.CvRun, r: *mut mg_random.Rng, out: *mut [f32; 512]) {
    let depth: i32 = (*(*run).def).height
    var f: f32 = 1.0f
    var i: i32 = 0
    while i < depth && (i as usize) < MAX_DEPTH {
        if i == 0 || mg_random.rng_next_int_bound(r, (*(*run).car).smooth) == 0 {
            let a: f32 = mg_random.rng_next_float(r)
            let b: f32 = mg_random.rng_next_float(r)
            f = 1.0f + a * b
        }
        (*out)[i as usize] = f * f
        i = i + 1
    }
}

#[allow_fp]
fn vertical_radius(run: *wgcv_apply.CvRun, r: *mut mg_random.Rng, base: f64, len: f32, i: f32) -> f64 {
    let car: *wgcv_def.Carver = (*run).car
    var h: f32 = 0.5f - i / len
    if h < 0.0f { h = 0.0f - h }
    let t: f32 = 1.0f - h * 2.0f
    let k: f32 = (*car).vrd + (*car).vrc * t
    let u: f32 = mg_random.rng_next_float(r) * (1.0f - 0.75f) + 0.75f
    return (k as f64) * base * (u as f64)
}

#[allow_fp]
fn canyon_run(run: *wgcv_apply.CvRun, seed: i64, x0: f64, y0: f64, z0: f64, th: f32, yaw0: f32, pitch0: f32, len: i32, yscale: f64) {
    let d: *wgcv_def.CvDef = (*run).def
    let car: *wgcv_def.Carver = (*run).car
    let pi: f32 = 3.1415927f
    var r: mg_random.Rng = mg_random.rng_legacy(seed)
    var fac: [f32; 512] = [1.0f; 512]
    width_factors(run, &r, &fac)
    let sk: wgcv_apply.Skip = wgcv_apply.Skip { kind: wgcv_apply.SKIP_CANYON, floor: 0.0, factors: (&fac[0]) as u64 }
    var x: f64 = x0
    var y: f64 = y0
    var z: f64 = z0
    var yaw: f32 = yaw0
    var pitch: f32 = pitch0
    var yaw_d: f32 = 0.0f
    var pitch_d: f32 = 0.0f
    var i: i32 = 0
    while i < len {
        var rad: f64 = 1.5 + (wgcv_def.sin_f(d, (i as f32) * pi / (len as f32)) * th) as f64
        let vbase: f64 = rad * yscale
        rad = rad * (wgcv_prov.fp_sample(&r, &(*car).hrf) as f64)
        let vrad: f64 = vertical_radius(run, &r, vbase, len as f32, i as f32)
        let cp: f32 = wgcv_def.cos_f(d, pitch)
        let sp: f32 = wgcv_def.sin_f(d, pitch)
        x = x + (wgcv_def.cos_f(d, yaw) * cp) as f64
        y = y + sp as f64
        z = z + (wgcv_def.sin_f(d, yaw) * cp) as f64
        pitch = pitch * 0.7f
        pitch = pitch + pitch_d * 0.05f
        yaw = yaw + yaw_d * 0.05f
        pitch_d = pitch_d * 0.8f
        yaw_d = yaw_d * 0.5f
        let a1: f32 = mg_random.rng_next_float(&r)
        let a2: f32 = mg_random.rng_next_float(&r)
        let a3: f32 = mg_random.rng_next_float(&r)
        pitch_d = pitch_d + (a1 - a2) * a3 * 2.0f
        let b1: f32 = mg_random.rng_next_float(&r)
        let b2: f32 = mg_random.rng_next_float(&r)
        let b3: f32 = mg_random.rng_next_float(&r)
        yaw_d = yaw_d + (b1 - b2) * b3 * 4.0f
        if mg_random.rng_next_int_bound(&r, 4) != 0 {
            if !can_reach(run, x, z, i, len, th) { return }
            wgcv_apply.carve_ellipsoid(run, x, y, z, rad, vrad, &sk)
        }
        i = i + 1
    }
}

#[allow_fp]
fn canyon_carve(run: *wgcv_apply.CvRun, r: *mut mg_random.Rng, cx: i32, cz: i32) {
    let car: *wgcv_def.Carver = (*run).car
    let two_pi: f32 = 6.2831855f
    let x: f64 = (cx * 16 + mg_random.rng_next_int_bound(r, 16)) as f64
    let y: f64 = wgcv_prov.sample_y_uniform(r, (*car).y_lo, (*car).y_hi) as f64
    let z: f64 = (cz * 16 + mg_random.rng_next_int_bound(r, 16)) as f64
    let yaw: f32 = mg_random.rng_next_float(r) * two_pi
    let pitch: f32 = wgcv_prov.fp_sample(r, &(*car).vrot)
    let yscale: f64 = wgcv_prov.fp_sample(r, &(*car).yscale) as f64
    let th: f32 = wgcv_prov.fp_sample(r, &(*car).thick)
    let len: i32 = ((RANGE_BLOCKS as f32) * wgcv_prov.fp_sample(r, &(*car).dist)) as i32
    let seed: i64 = mg_random.rng_next_long(r)
    canyon_run(run, seed, x, y, z, th, yaw, pitch, len, yscale)
}
