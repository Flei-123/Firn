import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region

export { place }

const CELLS: usize = 2048

fn at(x: i32, z: i32, y: i32) -> usize {
    return (((x * 16 + z) * 8) + y) as usize
}

#[allow_fp]
fn carve_blobs(rng: *mut mg_random.Rng, mask: *mut [bool; 2048]) {
    let blobs: i32 = mg_random.rng_next_int_bound(rng, 4) + 4
    var i: i32 = 0
    while i < blobs {
        let sx: f64 = mg_random.rng_next_double(rng) * 6.0 + 3.0
        let sy: f64 = mg_random.rng_next_double(rng) * 4.0 + 2.0
        let sz: f64 = mg_random.rng_next_double(rng) * 6.0 + 3.0
        let cx: f64 = mg_random.rng_next_double(rng) * (16.0 - sx - 2.0) + 1.0 + sx / 2.0
        let cy: f64 = mg_random.rng_next_double(rng) * (8.0 - sy - 4.0) + 2.0 + sy / 2.0
        let cz: f64 = mg_random.rng_next_double(rng) * (16.0 - sz - 2.0) + 1.0 + sz / 2.0
        var x: i32 = 1
        while x < 15 {
            var z: i32 = 1
            while z < 15 {
                var y: i32 = 1
                while y < 7 {
                    let dx: f64 = ((x as f64) - cx) / (sx / 2.0)
                    let dy: f64 = ((y as f64) - cy) / (sy / 2.0)
                    let dz: f64 = ((z as f64) - cz) / (sz / 2.0)
                    if dx * dx + dy * dy + dz * dz < 1.0 { (*mask)[at(x, z, y)] = true }
                    y = y + 1
                }
                z = z + 1
            }
            x = x + 1
        }
        i = i + 1
    }
}

fn is_edge(mask: *[bool; 2048], x: i32, z: i32, y: i32) -> bool {
    if (*mask)[at(x, z, y)] { return false }
    if x < 15 && (*mask)[at(x + 1, z, y)] { return true }
    if x > 0 && (*mask)[at(x - 1, z, y)] { return true }
    if z < 15 && (*mask)[at(x, z + 1, y)] { return true }
    if z > 0 && (*mask)[at(x, z - 1, y)] { return true }
    if y < 7 && (*mask)[at(x, z, y + 1)] { return true }
    if y > 0 && (*mask)[at(x, z, y - 1)] { return true }
    return false
}

fn write(r: *mut wgft_region.Region, x: i32, y: i32, z: i32, code: u16) {
    if wgft_region.can_write(r, x, z) { wgft_region.set_block(r, x, y, z, code) }
}

fn blocked(r: *mut wgft_region.Region, mask: *[bool; 2048], ox: i32, oy: i32, oz: i32, fluid: u16) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    var x: i32 = 0
    while x < 16 {
        var z: i32 = 0
        while z < 16 {
            var y: i32 = 0
            while y < 8 {
                if is_edge(mask, x, z, y) {
                    let b: u16 = wgft_region.block_at(r, ox + x, oy + y, oz + z)
                    if y >= 4 && (*ft).fluid[b as usize] { return true }
                    if y < 4 && !(*ft).motion[b as usize] && b != fluid { return true }
                }
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
    return false
}

fn fill_pool(r: *mut wgft_region.Region, mask: *[bool; 2048], ox: i32, oy: i32, oz: i32, fluid: u16) {
    let ft: *wgft_def.FtDef = (*r).ft
    var x: i32 = 0
    while x < 16 {
        var z: i32 = 0
        while z < 16 {
            var y: i32 = 0
            while y < 8 {
                if (*mask)[at(x, z, y)] {
                    let b: u16 = wgft_region.block_at(r, ox + x, oy + y, oz + z)
                    if !(*ft).no_replace[b as usize] {
                        if y >= 4 { write(r, ox + x, oy + y, oz + z, (*ft).cave_air_code) } else { write(r, ox + x, oy + y, oz + z, fluid) }
                    }
                }
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
}

fn fill_barrier(c: *wgft_ctx.PlaceCtx, mask: *[bool; 2048], ox: i32, oy: i32, oz: i32, barrier: u16) {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    var x: i32 = 0
    while x < 16 {
        var z: i32 = 0
        while z < 16 {
            var y: i32 = 0
            while y < 8 {
                if is_edge(mask, x, z, y) && (y < 4 || mg_random.rng_next_int_bound((*c).rng, 2) != 0) {
                    let b: u16 = wgft_region.block_at(r, ox + x, oy + y, oz + z)
                    if (*ft).motion[b as usize] && !(*ft).lava_keep[b as usize] { write(r, ox + x, oy + y, oz + z, barrier) }
                }
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    if y <= (*r).min_y + 4 { return false }
    let oy: i32 = y - 4
    var mask: [bool; 2048] = [false; 2048]
    carve_blobs((*c).rng, &mask)
    let fluid: u16 = (*f).out_code[0]
    if blocked(r, &mask, x, oy, z, fluid) { return false }
    fill_pool(r, &mask, x, oy, z, fluid)
    fill_barrier(c, &mask, x, oy, z, (*f).out_code[1])
    return true
}
