import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_jset
import mc.gen.wgft_ldpatch
import mc.gen.wgft_pred
import mc.gen.wgft_region
import mc.gen.wgft_vscratch

export { sample_xz, ground_patch, scratch_of }

fn scratch_of(r: *mut wgft_region.Region) -> *mut wgft_vscratch.VegScratch {
    if (*r).veg == 0 { (*r).veg = wgft_vscratch.veg_new() as u64 }
    return (*r).veg as *mut wgft_vscratch.VegScratch
}

fn sample_range(rng: *mut mg_random.Rng, lo: i32, hi: i32, uniform: bool) -> i32 {
    if uniform { return mg_random.rng_next_int_bound(rng, hi - lo + 1) + lo }
    return lo
}

fn sample_xz(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat) -> i32 {
    return sample_range((*c).rng, (*f).p[0], (*f).p[1], ((*f).p[7] & wgft_ldpatch.FLAG_XZ_UNIFORM) != 0) + 1
}

fn place_ground(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, gy: i32, z: i32, depth: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    let ground: u16 = (*f).out_code[0]
    var y: i32 = gy
    var k: i32 = 0
    while k < depth {
        let existing: u16 = wgft_region.block_at(r, x, y, z)
        if existing != ground {
            if !(*ft).masks[(*f).p[6] as usize][existing as usize] { return k != 0 }
            wgft_region.set_block(r, x, y, z, ground)
            y = y + (*f).p[5]
        }
        k = k + 1
    }
    return true
}

fn try_column(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, sc: *mut wgft_vscratch.VegScratch, px: i32, oy: i32, pz: i32) {
    let r: *mut wgft_region.Region = (*c).r
    let ft: *wgft_def.FtDef = (*r).ft
    let dirv: i32 = (*f).p[5]
    let reach: i32 = (*f).p[4]
    var y: i32 = oy
    var k: i32 = 0
    while (*ft).air[wgft_region.block_at(r, px, y, pz) as usize] && k < reach {
        y = y + dirv
        k = k + 1
    }
    k = 0
    while !(*ft).air[wgft_region.block_at(r, px, y, pz) as usize] && k < reach {
        y = y - dirv
        k = k + 1
    }
    let gy: i32 = y + dirv
    if !(*ft).air[wgft_region.block_at(r, px, y, pz) as usize] { return }
    var ground_face: i32 = wgft_def.FACE_DOWN
    if dirv < 0 { ground_face = wgft_def.FACE_UP }
    if !wgft_pred.sturdy_face(ft, ground_face, wgft_region.block_at(r, px, gy, pz)) { return }
    var depth: i32 = sample_range((*c).rng, (*f).p[2], (*f).p[3], ((*f).p[7] & wgft_ldpatch.FLAG_DEPTH_UNIFORM) != 0)
    if (*f).sel_chance[2] > (0.0 as f32) && mg_random.rng_next_float((*c).rng) < (*f).sel_chance[2] { depth = depth + 1 }
    if place_ground(c, f, px, gy, pz, depth) { wgft_jset.js_add(&(*sc).first, px, gy, pz) }
}

fn exposed(r: *mut wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    let ft: *wgft_def.FtDef = (*r).ft
    if !(*ft).sturdy_side[wgft_region.block_at(r, x, y, z - 1) as usize] { return true }
    if !(*ft).sturdy_side[wgft_region.block_at(r, x + 1, y, z) as usize] { return true }
    if !(*ft).sturdy_side[wgft_region.block_at(r, x, y, z + 1) as usize] { return true }
    if !(*ft).sturdy_side[wgft_region.block_at(r, x - 1, y, z) as usize] { return true }
    return !(*ft).sturdy_up[wgft_region.block_at(r, x, y - 1, z) as usize]
}

fn flood(c: *wgft_ctx.PlaceCtx, sc: *mut wgft_vscratch.VegScratch, n: usize) -> usize {
    let r: *mut wgft_region.Region = (*c).r
    wgft_jset.js_clear(&(*sc).second)
    var i: usize = 0
    while i < n {
        if !exposed(r, (*sc).tx[i], (*sc).ty[i], (*sc).tz[i]) { wgft_jset.js_add(&(*sc).second, (*sc).tx[i], (*sc).ty[i], (*sc).tz[i]) }
        i = i + 1
    }
    let m: usize = wgft_jset.js_collect(&(*sc).second, &(*sc).ox, &(*sc).oy, &(*sc).oz)
    i = 0
    while i < m {
        wgft_region.set_block(r, (*sc).ox[i], (*sc).oy[i], (*sc).oz[i], (*(*r).ft).water_code)
        i = i + 1
    }
    return m
}

fn ground_patch(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, sc: *mut wgft_vscratch.VegScratch, x: i32, y: i32, z: i32, rx: i32, rz: i32) -> usize {
    wgft_jset.js_clear(&(*sc).first)
    let edge_chance: f32 = (*f).sel_chance[0]
    var i: i32 = 0 - rx
    while i <= rx {
        let edge_x: bool = i == 0 - rx || i == rx
        var j: i32 = 0 - rz
        while j <= rz {
            let edge_z: bool = j == 0 - rz || j == rz
            let corner: bool = edge_x && edge_z
            let rim: bool = (edge_x || edge_z) && !corner
            var take: bool = !corner
            if take && rim {
                take = false
                if edge_chance != (0.0 as f32) && !(mg_random.rng_next_float((*c).rng) > edge_chance) { take = true }
            }
            if take { try_column(c, f, sc, x + i, y, z + j) }
            j = j + 1
        }
        i = i + 1
    }
    if ((*f).p[7] & wgft_ldpatch.FLAG_WATERLOGGED) == 0 {
        return wgft_jset.js_collect(&(*sc).first, &(*sc).ox, &(*sc).oy, &(*sc).oz)
    }
    let n: usize = wgft_jset.js_collect(&(*sc).first, &(*sc).tx, &(*sc).ty, &(*sc).tz)
    return flood(c, sc, n)
}
