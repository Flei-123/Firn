import std.rt
import std.json
import std.jsonstr
import mc.gen.wgft_ldctx
import mc.gen.wgsr_def

export { is_petals, petals_code }

const PETALS: str = "pink_petals"
const PART_COUNT: usize = 5

fn is_petals(name: str) -> bool {
    return name == PETALS
}

fn copy_part(buf: *mut [u8; 64], at: usize, part: str) -> usize {
    var k: usize = 0
    while k < part.n && at + k < 64 {
        (*buf)[at + k] = rt.ld8(part.p as u64, k)
        k = k + 1
    }
    return at + k
}

fn petals_code(l: *mut wgft_ldctx.Ld, d: *mut json.Json, node: u32) -> u16 {
    let props: u32 = jsonstr.get(d, node, "Properties")
    if props == wgft_ldctx.NONE_NODE { return wgft_ldctx.reg_code(l, PETALS) }
    let facing: str = jsonstr.string(d, jsonstr.get(d, props, "facing"))
    let amount: str = jsonstr.string(d, jsonstr.get(d, props, "flower_amount"))
    var buf: [u8; 64] = [0 as u8; 64]
    var parts: [str; 5] = [PETALS, "[facing=", facing, ",flower_amount=", amount]
    var at: usize = 0
    var i: usize = 0
    while i < PART_COUNT {
        at = copy_part(&buf, at, parts[i])
        i = i + 1
    }
    if at >= 63 {
        (*l).ok = false
        return 0
    }
    buf[at] = 93 as u8
    at = at + 1
    let c: i32 = wgsr_def.block_code((*l).sdef, (&buf[0]) as u64, at)
    if c < 0 || c >= (wgsr_def.CODE_SPACE as i32) {
        (*l).ok = false
        return 0
    }
    return c as u16
}
