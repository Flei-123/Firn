import mc.gen.wgft_jdef
import mc.gen.wgft_jset
import mc.gen.wgft_tscratch

export { collect_sorted }

fn collect_sorted(sc: *mut wgft_tscratch.TreeScratch, set: *wgft_jdef.JSet) -> usize {
    let n: usize = wgft_jset.js_collect(set, &(*sc).tx, &(*sc).ty, &(*sc).tz)
    if n == 0 { return 0 }
    var lo: i32 = (*sc).ty[0]
    var hi: i32 = (*sc).ty[0]
    var i: usize = 0
    while i < n {
        if (*sc).ty[i] < lo { lo = (*sc).ty[i] }
        if (*sc).ty[i] > hi { hi = (*sc).ty[i] }
        i = i + 1
    }
    let span: usize = (hi - lo + 2) as usize
    var start: [i32; 512] = [0; 512]
    if span > 512 {
        i = 0
        while i < n {
            (*sc).sx[i] = (*sc).tx[i]
            (*sc).sy[i] = (*sc).ty[i]
            (*sc).sz[i] = (*sc).tz[i]
            i = i + 1
        }
        return n
    }
    i = 0
    while i < n {
        start[((*sc).ty[i] - lo + 1) as usize] = start[((*sc).ty[i] - lo + 1) as usize] + 1
        i = i + 1
    }
    i = 1
    while i < span {
        start[i] = start[i] + start[i - 1]
        i = i + 1
    }
    i = 0
    while i < n {
        let b: usize = ((*sc).ty[i] - lo) as usize
        let at: usize = start[b] as usize
        start[b] = start[b] + 1
        (*sc).sx[at] = (*sc).tx[i]
        (*sc).sy[at] = (*sc).ty[i]
        (*sc).sz[at] = (*sc).tz[i]
        i = i + 1
    }
    return n
}
