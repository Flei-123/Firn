import std.rt
import std.json
import std.jsonstr
import mc.gen.wgdf_load
import mc.gen.wgsr_def
import mc.gen.wgtag
import mc.gen.wgft_def

export { apply_block_flags }

const BIT_KNOWN: u8 = 1
const BIT_SOLID: u8 = 2
const BIT_UP: u8 = 4
const BIT_DOWN: u8 = 8
const BIT_SIDE: u8 = 16

fn mark_list(d: *mut json.Json, list: u32, bit: u8, name_ptr: u64, name_len: u64, bits: u64) {
    var c: u32 = json.json_child(d, list)
    while c != json.JSON_NONE {
        let s: str = jsonstr.string(d, c)
        var code: usize = 0
        while code < wgsr_def.CODE_SPACE {
            if rt.ld64(name_len, code) == (s.n as u64) && rt.mem_eq(rt.ld64(name_ptr, code), s.p as u64, s.n) {
                rt.st8(bits, code, rt.ld8(bits, code) | bit)
            }
            code = code + 1
        }
        c = json.json_next(d, c)
    }
}

fn apply_block_flags(def: *mut wgft_def.FtDef, sd: *wgsr_def.SrDef, root: str) {
    var raw: rt.Buf = rt.buf_new()
    var doc: json.Json = json.json_new()
    if wgdf_load.read_doc(root, "block_flags", "flags", &raw, &doc) {
        var name_ptr: [u64; 512] = [0; 512]
        var name_len: [u64; 512] = [0; 512]
        var bits: [u8; 512] = [0; 512]
        var code: usize = 0
        while code < wgsr_def.CODE_SPACE {
            let nm: str = wgtag.code_name(sd, code as i32)
            name_ptr[code] = nm.p as u64
            name_len[code] = nm.n as u64
            code = code + 1
        }
        let top: u32 = json.json_root(&doc)
        let np: u64 = (&name_ptr[0]) as u64
        let nl: u64 = (&name_len[0]) as u64
        let bp: u64 = (&bits[0]) as u64
        mark_list(&doc, jsonstr.get(&doc, top, "all"), BIT_KNOWN, np, nl, bp)
        mark_list(&doc, jsonstr.get(&doc, top, "solid"), BIT_SOLID, np, nl, bp)
        mark_list(&doc, jsonstr.get(&doc, top, "sturdy_up"), BIT_UP, np, nl, bp)
        mark_list(&doc, jsonstr.get(&doc, top, "sturdy_down"), BIT_DOWN, np, nl, bp)
        mark_list(&doc, jsonstr.get(&doc, top, "sturdy_side"), BIT_SIDE, np, nl, bp)
        code = 0
        while code < wgsr_def.CODE_SPACE {
            let b: u8 = bits[code]
            if (b & BIT_KNOWN) != 0 {
                (*def).is_solid[code] = (b & BIT_SOLID) != 0
                (*def).sturdy_up[code] = (b & BIT_UP) != 0
                (*def).sturdy_down[code] = (b & BIT_DOWN) != 0
                (*def).sturdy_side[code] = (b & BIT_SIDE) != 0
            }
            code = code + 1
        }
    }
    json.json_free(&doc)
    rt.buf_free(&raw)
}
