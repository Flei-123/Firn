import std.rt
import std.json
import std.jsonstr
import mc.gen.wgdf_load
import mc.gen.wgbio_source
import mc.gen.wgsr_def
import mc.gen.wgtag
import mc.gen.wgvert
import mc.gen.wgft_def

export { ft_load }

const NONE_NODE: u32 = 4294967295

struct Ld {
    def: *mut wgft_def.FtDef,
    sdef: *mut wgsr_def.SrDef,
    root: str,
    ok: bool,
}

fn bare(s: str) -> str {
    return wgdf_load.strip_ns(s)
}

fn ore_code(sd: *mut wgsr_def.SrDef, name: str) -> u8 {
    if name == "copper_ore" { return 67 }
    if name == "granite" { return 71 }
    if name == "deepslate_iron_ore" { return 73 }
    if name == "tuff" { return 84 }
    let c: i32 = wgsr_def.block_code(sd, name.p as u64, name.n)
    if c < 0 || c > 255 { return 0 }
    return c as u8
}

fn push_op(l: *mut Ld, f: *mut wgft_def.Feat, kind: u8, a: i32, b: i32) {
    if (*f).nops >= wgft_def.MAX_OPS {
        (*l).ok = false
        return
    }
    (*f).ops[(*f).nops] = wgft_def.Op { kind: kind, a: a, b: b }
    (*f).nops = (*f).nops + 1
}

fn num_or_fail(l: *mut Ld, d: *mut json.Json, j: u32, key: str) -> i32 {
    let n: u32 = jsonstr.get(d, j, key)
    if n == NONE_NODE {
        (*l).ok = false
        return 0
    }
    return json.json_number(d, n) as i32
}

fn load_count(l: *mut Ld, f: *mut wgft_def.Feat, d: *mut json.Json, c: u32) {
    if json.json_kind(d, c) == json.JSON_NUMBER {
        push_op(l, f, wgft_def.OP_COUNT, json.json_number(d, c) as i32, 0)
        return
    }
    let ty: str = bare(jsonstr.string(d, jsonstr.get(d, c, "type")))
    let v: u32 = jsonstr.get(d, c, "value")
    if ty == "uniform" {
        push_op(l, f, wgft_def.OP_COUNT_UNIFORM, num_or_fail(l, d, v, "min_inclusive"), num_or_fail(l, d, v, "max_inclusive"))
    } else if ty == "constant" {
        push_op(l, f, wgft_def.OP_COUNT, json.json_number(d, v) as i32, 0)
    } else {
        (*l).ok = false
    }
}

fn load_height(l: *mut Ld, f: *mut wgft_def.Feat, d: *mut json.Json, h: u32) {
    let ty: str = bare(jsonstr.string(d, jsonstr.get(d, h, "type")))
    let def: *wgft_def.FtDef = (*l).def
    let lo: i32 = wgvert.anchor_y(d, jsonstr.get(d, h, "min_inclusive"), (*def).min_y, (*def).height, &(*l).ok)
    let hi: i32 = wgvert.anchor_y(d, jsonstr.get(d, h, "max_inclusive"), (*def).min_y, (*def).height, &(*l).ok)
    if jsonstr.get(d, h, "plateau") != NONE_NODE { (*l).ok = false }
    if ty == "uniform" {
        push_op(l, f, wgft_def.OP_HEIGHT_UNIFORM, lo, hi)
    } else if ty == "trapezoid" {
        push_op(l, f, wgft_def.OP_HEIGHT_TRAPEZOID, lo, hi)
    } else {
        (*l).ok = false
    }
}

fn load_placement(l: *mut Ld, f: *mut wgft_def.Feat, d: *mut json.Json, arr: u32) {
    let cnt: usize = json.json_count(d, arr)
    var k: usize = 0
    while k < cnt {
        let m: u32 = json.json_child_at(d, arr, k)
        let ty: str = bare(jsonstr.string(d, jsonstr.get(d, m, "type")))
        if ty == "count" {
            load_count(l, f, d, jsonstr.get(d, m, "count"))
        } else if ty == "in_square" {
            push_op(l, f, wgft_def.OP_SQUARE, 0, 0)
        } else if ty == "rarity_filter" {
            push_op(l, f, wgft_def.OP_RARITY, num_or_fail(l, d, m, "chance"), 0)
        } else if ty == "height_range" {
            load_height(l, f, d, jsonstr.get(d, m, "height"))
        } else if ty == "biome" {
            push_op(l, f, wgft_def.OP_BIOME, 0, 0)
        } else {
            (*l).ok = false
        }
        k = k + 1
    }
}

fn load_targets(l: *mut Ld, f: *mut wgft_def.Feat, d: *mut json.Json, cfg: u32) {
    let ts: u32 = jsonstr.get(d, cfg, "targets")
    let cnt: usize = json.json_count(d, ts)
    if cnt == 0 || cnt > wgft_def.MAX_TARGETS {
        (*l).ok = false
        return
    }
    var k: usize = 0
    while k < cnt {
        let t: u32 = json.json_child_at(d, ts, k)
        let st: u32 = jsonstr.get(d, t, "state")
        let name: str = bare(jsonstr.string(d, jsonstr.get(d, st, "Name")))
        let code: u8 = ore_code((*l).sdef, name)
        if code == 0 { (*l).ok = false }
        (*f).out_code[k] = code
        let tg: u32 = jsonstr.get(d, t, "target")
        let pt: str = bare(jsonstr.string(d, jsonstr.get(d, tg, "predicate_type")))
        let at: u64 = (&(*f).test[k][0]) as u64
        if pt == "tag_match" {
            wgtag.tag_mask((*l).root, (*l).sdef, bare(jsonstr.string(d, jsonstr.get(d, tg, "tag"))), at)
        } else if pt == "block_match" {
            wgtag.name_mask((*l).sdef, bare(jsonstr.string(d, jsonstr.get(d, tg, "block"))), at)
        } else {
            (*l).ok = false
        }
        k = k + 1
    }
    (*f).ntargets = cnt
}

#[allow_escape]
fn load_feature(l: *mut Ld, name: str, step: i32, index: i32) -> bool {
    var raw: rt.Buf = rt.buf_new()
    var pd: json.Json = json.json_new()
    if !wgdf_load.read_doc((*l).root, "placed_feature", name, &raw, &pd) {
        json.json_free(&pd)
        rt.buf_free(&raw)
        return false
    }
    let def: *mut wgft_def.FtDef = (*l).def
    var loaded: bool = false
    var raw2: rt.Buf = rt.buf_new()
    var cd: json.Json = json.json_new()
    let cname: str = bare(jsonstr.string(&pd, jsonstr.get(&pd, json.json_root(&pd), "feature")))
    if wgdf_load.read_doc((*l).root, "configured_feature", cname, &raw2, &cd) {
        let cr: u32 = json.json_root(&cd)
        let ty: str = bare(jsonstr.string(&cd, jsonstr.get(&cd, cr, "type")))
        if (ty == "ore" || ty == "scattered_ore") && (*def).n < wgft_def.MAX_FEATS && name.n <= 40 {
            let f: *mut wgft_def.Feat = &(*def).feats[(*def).n]
            (*f).nops = 0
            (*f).step = step
            (*f).index = index
            (*f).scattered = ty == "scattered_ore"
            let cfg: u32 = jsonstr.get(&cd, cr, "config")
            (*f).size = num_or_fail(l, &cd, cfg, "size")
            if (*f).size > 64 { (*l).ok = false }
            (*f).discard = json.json_number(&cd, jsonstr.get(&cd, cfg, "discard_chance_on_air_exposure")) as f32
            load_targets(l, f, &cd, cfg)
            load_placement(l, f, &pd, jsonstr.get(&pd, json.json_root(&pd), "placement"))
            rt.mem_copy((&(*def).fname[(*def).n][0]) as u64, name.p as u64, name.n)
            (*def).flen[(*def).n] = name.n
            (*def).n = (*def).n + 1
            loaded = true
        }
    }
    json.json_free(&cd)
    rt.buf_free(&raw2)
    json.json_free(&pd)
    rt.buf_free(&raw)
    return loaded
}

fn load_order(l: *mut Ld, order: str) {
    var raw: rt.Buf = rt.buf_new()
    var doc: json.Json = json.json_new()
    if !wgdf_load.read_doc((*l).root, "feature_order", order, &raw, &doc) {
        (*l).ok = false
    } else {
        let steps: u32 = jsonstr.get(&doc, json.json_root(&doc), "steps")
        let ns: usize = json.json_count(&doc, steps)
        var j: usize = 0
        while j < ns {
            let st: u32 = json.json_child_at(&doc, steps, j)
            let cnt: usize = json.json_count(&doc, st)
            var k: usize = 0
            while k < cnt {
                let nm: str = jsonstr.string(&doc, json.json_child_at(&doc, st, k))
                load_feature(l, nm, j as i32, k as i32)
                k = k + 1
            }
            j = j + 1
        }
    }
    json.json_free(&doc)
    rt.buf_free(&raw)
}

fn load_biome_mask(l: *mut Ld, bi: usize, name: str) {
    let def: *mut wgft_def.FtDef = (*l).def
    var raw: rt.Buf = rt.buf_new()
    var bd: json.Json = json.json_new()
    if wgdf_load.read_doc((*l).root, "biome", name, &raw, &bd) {
        let fs: u32 = jsonstr.get(&bd, json.json_root(&bd), "features")
        let ns: usize = json.json_count(&bd, fs)
        var j: usize = 0
        while j < ns {
            let st: u32 = json.json_child_at(&bd, fs, j)
            let cnt: usize = json.json_count(&bd, st)
            var k: usize = 0
            while k < cnt {
                let nm: str = bare(jsonstr.string(&bd, json.json_child_at(&bd, st, k)))
                let fi: i32 = wgft_def.find_feat(def, nm.p as u64, nm.n)
                if fi >= 0 { (*def).bmask[bi] = (*def).bmask[bi] | ((1 as u64) << (fi as u64)) }
                k = k + 1
            }
            j = j + 1
        }
    } else {
        (*l).ok = false
    }
    json.json_free(&bd)
    rt.buf_free(&raw)
}

fn build_masks(def: *mut wgft_def.FtDef, sd: *wgsr_def.SrDef) {
    var code: i32 = 0
    while code < 256 {
        let nm: str = wgtag.code_name(sd, code)
        let is_air: bool = nm == "air" || nm == "cave_air" || nm == "void_air"
        (*def).air[code as usize] = is_air
        (*def).motion[code as usize] = !(is_air || nm == "water" || nm == "lava" || nm == "powder_snow" || nm == "snow")
        code = code + 1
    }
}

fn ft_load(root: str, dim: str, sd: *mut wgsr_def.SrDef, bio: *mut wgbio_source.BioSource, min_y: i32, height: i32, zoom_seed: i64) -> *mut wgft_def.FtDef {
    if bio == (0 as *mut wgbio_source.BioSource) || dim == "end" { return 0 as *mut wgft_def.FtDef }
    let def: *mut wgft_def.FtDef = wgft_def.def_new(min_y, height)
    (*def).zoom_seed = zoom_seed
    var l: Ld = Ld { def: def, sdef: sd, root: root, ok: true }
    var order: str = "overworld"
    if dim == "nether" { order = "nether" }
    load_order(&l, order)
    (*def).n = 0
    load_order(&l, order)
    let nb: usize = wgbio_source.bio_name_count(bio)
    (*def).nbio = nb
    var i: usize = 0
    while i < nb && i < wgft_def.MAX_BIOMES && l.ok {
        load_biome_mask(&l, i, wgbio_source.bio_name(bio, i))
        i = i + 1
    }
    build_masks(def, sd)
    if !l.ok || (*def).n == 0 {
        wgft_def.def_free(def)
        return 0 as *mut wgft_def.FtDef
    }
    return def
}
