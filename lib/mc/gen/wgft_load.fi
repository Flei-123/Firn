import std.rt
import std.json
import std.jsonstr
import mc.gen.wgdf_load
import mc.gen.wgbio_source
import mc.gen.wgsr_def
import mc.gen.wgtag
import mc.gen.wgft_def
import mc.gen.wgft_ldctx
import mc.gen.wgft_ldops
import mc.gen.wgft_ldbody
import mc.gen.wgft_surv
import mc.gen.wgft_ldprov
import mc.gen.wgft_ldflags

export { ft_load }

#[allow_escape]
fn load_feature(l: *mut wgft_ldctx.Ld, name: str, step: i32, index: i32) {
    var raw: rt.Buf = rt.buf_new()
    var pd: json.Json = json.json_new()
    if wgdf_load.read_doc((*l).root, "placed_feature", name, &raw, &pd) {
        let def: *mut wgft_def.FtDef = (*l).def
        if (*def).n >= wgft_def.MAX_FEATS || name.n > 40 {
            (*l).ok = false
        } else {
            let f: *mut wgft_def.Feat = &(*def).feats[(*def).n]
            wgft_ldbody.reset_feat(f, step, index)
            let root: u32 = json.json_root(&pd)
            wgft_ldops.load_placement(l, f, &pd, jsonstr.get(&pd, root, "placement"))
            wgft_ldbody.load_cfg(l, f, &pd, jsonstr.get(&pd, root, "feature"))
            rt.mem_copy((&(*def).fname[(*def).n][0]) as u64, name.p as u64, name.n)
            (*def).flen[(*def).n] = name.n
            (*def).n = (*def).n + 1
        }
    }
    json.json_free(&pd)
    rt.buf_free(&raw)
}

fn load_order(l: *mut wgft_ldctx.Ld, order: str) {
    let def: *mut wgft_def.FtDef = (*l).def
    (*def).n = 0
    (*def).nsubs = 0
    (*def).npreds = 0
    (*def).nmasks = 0
    (*def).ntagmasks = 0
    let cannot: i32 = wgft_ldctx.alloc_mask(l)
    let can: i32 = wgft_ldctx.alloc_mask(l)
    wgtag.tag_mask((*l).root, (*l).sdef, "snow_layer_cannot_survive_on", (&(*def).masks[cannot as usize][0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask((*l).root, (*l).sdef, "snow_layer_can_survive_on", (&(*def).masks[can as usize][0]) as u64, (wgsr_def.CODE_SPACE as i32))
    var raw: rt.Buf = rt.buf_new()
    var doc: json.Json = json.json_new()
    if !wgdf_load.read_doc((*l).root, "feature_order", order, &raw, &doc) {
        (*l).ok = false
    } else {
        let steps: u32 = jsonstr.get(&doc, json.json_root(&doc), "steps")
        let ns: usize = json.json_count(&doc, steps)
        var j: usize = 0
        while j < ns {
            let st: u32 = json.json_child_at(&doc, steps, j)
            let cnt: usize = json.json_count(&doc, st)
            var k: usize = 0
            while k < cnt {
                load_feature(l, jsonstr.string(&doc, json.json_child_at(&doc, st, k)), j as i32, k as i32)
                k = k + 1
            }
            j = j + 1
        }
    }
    json.json_free(&doc)
    rt.buf_free(&raw)
}

fn load_biome_mask(l: *mut wgft_ldctx.Ld, bi: usize, name: str) {
    let def: *mut wgft_def.FtDef = (*l).def
    var raw: rt.Buf = rt.buf_new()
    var bd: json.Json = json.json_new()
    if wgdf_load.read_doc((*l).root, "biome", name, &raw, &bd) {
        let fs: u32 = jsonstr.get(&bd, json.json_root(&bd), "features")
        let ns: usize = json.json_count(&bd, fs)
        var j: usize = 0
        while j < ns {
            let st: u32 = json.json_child_at(&bd, fs, j)
            let cnt: usize = json.json_count(&bd, st)
            var k: usize = 0
            while k < cnt {
                let nm: str = wgft_ldctx.bare(jsonstr.string(&bd, json.json_child_at(&bd, st, k)))
                let fi: i32 = wgft_def.find_feat(def, nm.p as u64, nm.n)
                if fi >= 0 {
                    let w: usize = (fi / 64) as usize
                    (*def).bmask[bi][w] = (*def).bmask[bi][w] | ((1 as u64) << ((fi % 64) as u64))
                }
                k = k + 1
            }
            j = j + 1
        }
    } else {
        (*l).ok = false
    }
    json.json_free(&bd)
    rt.buf_free(&raw)
}

fn ends_with(s: str, suffix: str) -> bool {
    if s.n < suffix.n { return false }
    return rt.mem_eq((s.p as u64) + ((s.n - suffix.n) as u64), suffix.p as u64, suffix.n)
}

fn plain_plant(nm: str) -> bool {
    return nm == "vine" || nm == "glow_lichen" || nm == "sugar_cane" || nm == "seagrass" || nm == "tall_seagrass" || nm == "kelp" || nm == "kelp_plant" || nm == "fire" || nm == "soul_fire" || nm == "crimson_roots" || nm == "warped_roots" || nm == "weeping_vines" || nm == "weeping_vines_plant" || nm == "twisting_vines" || nm == "twisting_vines_plant" || nm == "nether_sprouts" || nm == "crimson_fungus" || nm == "warped_fungus" || nm == "brown_mushroom" || nm == "red_mushroom" || nm == "bamboo_sapling" || nm == "moss_carpet" || nm == "mangrove_propagule" || nm == "hanging_roots" || nm == "cave_vines" || nm == "cave_vines_plant" || nm == "spore_blossom" || nm == "small_dripleaf" || nm == "big_dripleaf_stem"
}

fn build_masks(def: *mut wgft_def.FtDef, sd: *wgsr_def.SrDef, root: str) {
    var code: i32 = 0
    while code < (wgsr_def.CODE_SPACE as i32) {
        let nm: str = wgtag.code_name(sd, code)
        let is_air: bool = nm == "air" || nm == "cave_air" || nm == "void_air"
        let is_fluid: bool = nm == "water" || nm == "lava"
        let plant: bool = wgft_surv.is_ground_plant(wgft_surv.kind_of(nm)) || plain_plant(nm)
        (*def).air[code as usize] = is_air
        (*def).fluid[code as usize] = is_fluid
        (*def).leaves[code as usize] = ends_with(nm, "_leaves")
        (*def).motion[code as usize] = !(is_air || is_fluid || nm == "powder_snow" || nm == "snow" || plant)
        (*def).full_top[code as usize] = (*def).motion[code as usize] && nm != "cactus"
        let fortress: bool = nm == "bedrock" || nm == "nether_bricks" || nm == "nether_brick_fence" || nm == "nether_brick_stairs" || nm == "nether_wart" || nm == "chest" || nm == "spawner"
        (*def).no_delta[code as usize] = fortress
        (*def).no_column[code as usize] = fortress || nm == "lava" || nm == "magma_block" || nm == "soul_sand"
        code = code + 1
    }
    wgtag.tag_mask(root, sd, "features_cannot_replace", (&(*def).no_replace[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask(root, sd, "lava_pool_stone_cannot_replace", (&(*def).lava_keep[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask(root, sd, "bamboo_plantable_on", (&(*def).bamboo_on[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask(root, sd, "nylium", (&(*def).nylium[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask(root, sd, "soul_fire_base_blocks", (&(*def).soul_base[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask(root, sd, "mushroom_grow_block", (&(*def).mush_on[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask(root, sd, "dirt", (&(*def).dirt[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask(root, sd, "small_dripleaf_placeable", (&(*def).drip_on[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask(root, sd, "dead_bush_may_place_on", (&(*def).dry[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    build_tree_masks(def, sd, root)
    var rc: i32 = 0
    while rc < (wgsr_def.CODE_SPACE as i32) {
        let rn: str = wgtag.code_name(sd, rc)
        (*def).roots_on[rc as usize] = (*def).nylium[rc as usize] || (*def).dirt[rc as usize] || rn == "soul_soil" || rn == "farmland"
        rc = rc + 1
    }
    var t: usize = 0
    while t < (*def).ntagmasks {
        let name: str = str { p: &(*def).tagmask_name[t][0], n: (*def).tagmask_len[t] }
        wgtag.tag_mask(root, sd, name, (&(*def).masks[(*def).tagmask_idx[t] as usize][0]) as u64, (wgsr_def.CODE_SPACE as i32))
        t = t + 1
    }
}

fn is_wet(sd: *wgsr_def.SrDef, code: i32, nm: str) -> bool {
    if nm == "water" || nm == "seagrass" || nm == "tall_seagrass" || nm == "kelp" || nm == "kelp_plant" || nm == "bubble_column" { return true }
    return ends_with(wgsr_def.code_name_of(sd, code), "waterlogged=true]")
}

fn build_tree_masks(def: *mut wgft_def.FtDef, sd: *wgsr_def.SrDef, root: str) {
    var replaceable: [bool; 512] = [false; 512]
    wgtag.tag_mask(root, sd, "replaceable_by_trees", (&replaceable[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask(root, sd, "logs", (&(*def).logs[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask(root, sd, "mangrove_logs_can_grow_through", (&(*def).grow_logs[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    wgtag.tag_mask(root, sd, "mangrove_roots_can_grow_through", (&(*def).grow_roots[0]) as u64, (wgsr_def.CODE_SPACE as i32))
    var code: usize = 0
    while code < wgsr_def.CODE_SPACE {
        let nm: str = wgtag.code_name(sd, code as i32)
        (*def).dbl[code] = wgft_surv.is_double(nm)
        (*def).vine[code] = nm == "vine"
        (*def).attach[code] = (*def).motion[code] && !wgft_surv.is_thin(nm)
        (*def).solid[code] = (*def).attach[code] && !(*def).leaves[code]
        (*def).is_solid[code] = (*def).motion[code] && !(*def).fluid[code]
        (*def).sturdy_up[code] = (*def).solid[code]
        (*def).sturdy_down[code] = (*def).solid[code]
        (*def).sturdy_side[code] = (*def).solid[code]
        (*def).tree_ok[code] = (*def).air[code] || replaceable[code]
        (*def).up_free[code] = (*def).tree_ok[code] || (*def).logs[code] || (*def).grow_logs[code]
        (*def).wet[code] = is_wet(sd, code as i32, nm)
        (*def).tree_dirt[code] = (*def).dirt[code] && nm != "grass_block" && nm != "mycelium"
        code = code + 1
    }
}

fn register_wet(l: *mut wgft_ldctx.Ld) {
    let def: *mut wgft_def.FtDef = (*l).def
    var names: [str; 3] = ["small_dripleaf", "big_dripleaf", "big_dripleaf_stem"]
    var i: usize = 0
    while i < 3 {
        let dry: u16 = wgft_ldctx.reg_code(l, names[i])
        (*def).wet_of[dry as usize] = wgft_ldprov.reg_joined(l, names[i], "[waterlogged=true]")
        i = i + 1
    }
}

fn ft_load(root: str, dim: str, sd: *mut wgsr_def.SrDef, bio: *mut wgbio_source.BioSource, min_y: i32, height: i32, zoom_seed: i64) -> *mut wgft_def.FtDef {
    if bio == (0 as *mut wgbio_source.BioSource) || dim == "end" { return 0 as *mut wgft_def.FtDef }
    let def: *mut wgft_def.FtDef = wgft_def.def_new(min_y, height)
    (*def).zoom_seed = zoom_seed
    (*def).sd = sd as u64
    var l: wgft_ldctx.Ld = wgft_ldctx.Ld { def: def, sdef: sd, root: root, ok: true }
    (*def).water_code = wgft_ldctx.reg_code(&l, "water")
    (*def).air_code = wgft_ldctx.reg_code(&l, "air")
    (*def).ice_code = wgft_ldctx.reg_code(&l, "ice")
    (*def).snow_code = wgft_ldctx.reg_code(&l, "snow")
    (*def).cave_air_code = wgft_ldctx.reg_code(&l, "cave_air")
    (*def).clay_code = wgft_ldctx.reg_code(&l, "clay")
    (*def).bedrock_code = wgft_ldctx.reg_code(&l, "bedrock")
    (*def).lava_code = wgft_ldctx.reg_code(&l, "lava")
    (*def).sea_level = 63
    register_wet(&l)
    var order: str = "overworld"
    if dim == "nether" {
        order = "nether"
        (*def).sea_level = 32
    }
    load_order(&l, order)
    load_order(&l, order)
    let nb: usize = wgbio_source.bio_name_count(bio)
    (*def).nbio = nb
    var i: usize = 0
    while i < nb && i < wgft_def.MAX_BIOMES && l.ok {
        load_biome_mask(&l, i, wgbio_source.bio_name(bio, i))
        i = i + 1
    }
    build_masks(def, sd, root)
    wgft_ldflags.apply_block_flags(def, sd, root)
    if !l.ok || (*def).n == 0 {
        wgft_def.def_free(def)
        return 0 as *mut wgft_def.FtDef
    }
    return def
}
