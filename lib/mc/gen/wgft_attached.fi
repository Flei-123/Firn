// SPDX-License-Identifier: MPL-2.0
import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_region
import mc.gen.wgft_tscratch
import mc.gen.wgft_ysort

export { decorate }

const MAX_PLACED: usize = 512

fn dir_dx(k: u8) -> i32 {
    if k == 4 { return 0 - 1 }
    if k == 5 { return 1 }
    return 0
}

fn dir_dy(k: u8) -> i32 {
    if k == 0 { return 0 - 1 }
    if k == 1 { return 1 }
    return 0
}

fn dir_dz(k: u8) -> i32 {
    if k == 2 { return 0 - 1 }
    if k == 3 { return 1 }
    return 0
}

fn abs_i32(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

fn shuffle(sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, n: usize) {
    var i: usize = n
    while i > 1 {
        let j: usize = mg_random.rng_next_int_bound(rng, i as i32) as usize
        let tx: i32 = (*sc).sx[i - 1]
        let ty: i32 = (*sc).sy[i - 1]
        let tz: i32 = (*sc).sz[i - 1]
        (*sc).sx[i - 1] = (*sc).sx[j]
        (*sc).sy[i - 1] = (*sc).sy[j]
        (*sc).sz[i - 1] = (*sc).sz[j]
        (*sc).sx[j] = tx
        (*sc).sy[j] = ty
        (*sc).sz[j] = tz
        i = i - 1
    }
}

fn excluded(dc: *wgft_def.DecoCfg, px: *[i32; 512], py: *[i32; 512], pz: *[i32; 512], count: usize, x: i32, y: i32, z: i32) -> bool {
    var i: usize = 0
    while i < count {
        if abs_i32(x - (*px)[i]) <= (*dc).ex_xz && abs_i32(y - (*py)[i]) <= (*dc).ex_y && abs_i32(z - (*pz)[i]) <= (*dc).ex_xz { return true }
        i = i + 1
    }
    return false
}

fn empty_run(r: *mut wgft_region.Region, dc: *wgft_def.DecoCfg, x: i32, y: i32, z: i32, dir: u8) -> bool {
    var k: i32 = 1
    while k <= (*dc).empty {
        if !(*(*r).ft).air[wgft_region.block_at(r, x + dir_dx(dir) * k, y + dir_dy(dir) * k, z + dir_dz(dir) * k) as usize] { return false }
        k = k + 1
    }
    return true
}

#[allow_fp]
fn decorate(r: *mut wgft_region.Region, sc: *mut wgft_tscratch.TreeScratch, rng: *mut mg_random.Rng, dc: *wgft_def.DecoCfg) {
    let n: usize = wgft_ysort.collect_sorted(sc, &(*sc).foliage)
    shuffle(sc, rng, n)
    var px: [i32; 512] = [0; 512]
    var py: [i32; 512] = [0; 512]
    var pz: [i32; 512] = [0; 512]
    var placed: usize = 0
    var i: usize = 0
    while i < n {
        let dir: u8 = (*dc).dirs[mg_random.rng_next_int_bound(rng, (*dc).ndirs as i32) as usize]
        let x: i32 = (*sc).sx[i] + dir_dx(dir)
        let y: i32 = (*sc).sy[i] + dir_dy(dir)
        let z: i32 = (*sc).sz[i] + dir_dz(dir)
        if !excluded(dc, &px, &py, &pz, placed, x, y, z) && mg_random.rng_next_float(rng) < (*dc).prob && empty_run(r, dc, (*sc).sx[i], (*sc).sy[i], (*sc).sz[i], dir) {
            if placed < MAX_PLACED {
                px[placed] = x
                py[placed] = y
                pz[placed] = z
                placed = placed + 1
            }
            if (*dc).age_n > 0 { mg_random.rng_next_int_bound(rng, (*dc).age_n) }
            wgft_region.set_block(r, x, y, z, (*dc).code)
            wgft_tscratch.add_deco(sc, x, y, z)
        }
        i = i + 1
    }
}
