import mc.gen.mg_random
import mc.gen.wgft_def
import mc.gen.wgft_ctx
import mc.gen.wgft_region

export { place }

fn is_water(r: *wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    return wgft_region.block_at(r, x, y, z) == (*(*r).ft).water_code
}

fn water_or_air(r: *wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    return is_water(r, x, y, z) || (*(*r).ft).air[wgft_region.block_at(r, x, y, z) as usize]
}

fn valid_position(r: *wgft_region.Region, x: i32, y: i32, z: i32) -> bool {
    if water_or_air(r, x, y, z) || water_or_air(r, x, y - 1, z) { return false }
    return !water_or_air(r, x, y, z - 1) && !water_or_air(r, x + 1, y, z) && !water_or_air(r, x, y, z + 1) && !water_or_air(r, x - 1, y, z)
}

fn floor_y(r: *wgft_region.Region, x: i32, y: i32, z: i32, range: i32, out: *mut i32) -> bool {
    if !is_water(r, x, y, z) { return false }
    var cy: i32 = y
    var i: i32 = 1
    while i < range && is_water(r, x, cy, z) {
        cy = cy - 1
        i = i + 1
    }
    if is_water(r, x, cy, z) { return false }
    *out = cy
    return true
}

fn place(c: *wgft_ctx.PlaceCtx, f: *wgft_def.Feat, x: i32, y: i32, z: i32) -> bool {
    let r: *mut wgft_region.Region = (*c).r
    var fy: i32 = 0
    if !floor_y(r, x, y, z, (*f).p[0], &fy) { return false }
    let rad: i32 = (*f).p[2]
    let prob: f32 = ((*f).p[1] as f32) / 16777216.0f
    var placed: bool = false
    var dz: i32 = 0 - rad
    while dz <= rad {
        var dy: i32 = 0 - rad
        while dy <= rad {
            var dx: i32 = 0 - rad
            while dx <= rad {
                if mg_random.rng_next_float((*c).rng) < prob && valid_position(r, x + dx, fy + dy, z + dz) {
                    wgft_region.set_block(r, x + dx, fy + dy, z + dz, (*f).p[3] as u16)
                    placed = true
                }
                dx = dx + 1
            }
            dy = dy + 1
        }
        dz = dz + 1
    }
    return placed
}
