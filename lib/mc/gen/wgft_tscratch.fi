import std.rt
import mc.gen.wgdf_graph
import mc.gen.wgft_jset

export { TreeScratch, VOXEL_CAP, MAX_ATTACH, scratch_new, scratch_free, scratch_begin, scratch_note, note_log, note_leaf, add_attach }

const VOXEL_CAP: usize = 32768
const MAX_ATTACH: usize = 48

struct TreeScratch {
    logs: wgft_jset.JSet,
    foliage: wgft_jset.JSet,
    buckets: [wgft_jset.JSet; 7],
    voxel: [bool; 32768],
    min_x: i32,
    min_y: i32,
    min_z: i32,
    max_x: i32,
    max_y: i32,
    max_z: i32,
    has_box: bool,
    lg_min_y: i32,
    lg_max_y: i32,
    fo_min_y: i32,
    n_attach: usize,
    at_x: [i32; 48],
    at_y: [i32; 48],
    at_z: [i32; 48],
    at_off: [i32; 48],
    has_deco: bool,
    deco_x: i32,
    deco_y: i32,
    deco_z: i32,
}

fn scratch_new() -> *mut TreeScratch {
    let n: usize = wgdf_graph.wg_size_of[TreeScratch]()
    let s: *mut TreeScratch = rt.heap_alloc(n) as *mut TreeScratch
    rt.mem_set(s as u64, 0 as u8, n)
    return s
}

fn scratch_free(s: *mut TreeScratch) {
    rt.heap_free(s as u64, wgdf_graph.wg_size_of[TreeScratch]())
}

fn scratch_begin(s: *mut TreeScratch) {
    wgft_jset.js_clear(&(*s).logs)
    wgft_jset.js_clear(&(*s).foliage)
    var i: usize = 0
    while i < 7 {
        wgft_jset.js_clear(&(*s).buckets[i])
        i = i + 1
    }
    (*s).has_box = false
    (*s).n_attach = 0
    (*s).has_deco = false
}

fn scratch_note(s: *mut TreeScratch, x: i32, y: i32, z: i32) {
    if !(*s).has_box {
        (*s).min_x = x
        (*s).max_x = x
        (*s).min_y = y
        (*s).max_y = y
        (*s).min_z = z
        (*s).max_z = z
        (*s).has_box = true
        return
    }
    if x < (*s).min_x { (*s).min_x = x }
    if x > (*s).max_x { (*s).max_x = x }
    if y < (*s).min_y { (*s).min_y = y }
    if y > (*s).max_y { (*s).max_y = y }
    if z < (*s).min_z { (*s).min_z = z }
    if z > (*s).max_z { (*s).max_z = z }
}

fn note_log(s: *mut TreeScratch, x: i32, y: i32, z: i32) {
    if wgft_jset.js_add(&(*s).logs, x, y, z) {
        if (*s).logs.size == 1 {
            (*s).lg_min_y = y
            (*s).lg_max_y = y
        } else {
            if y < (*s).lg_min_y { (*s).lg_min_y = y }
            if y > (*s).lg_max_y { (*s).lg_max_y = y }
        }
    }
    scratch_note(s, x, y, z)
}

fn note_leaf(s: *mut TreeScratch, x: i32, y: i32, z: i32) {
    if wgft_jset.js_add(&(*s).foliage, x, y, z) {
        if (*s).foliage.size == 1 || y < (*s).fo_min_y { (*s).fo_min_y = y }
    }
    scratch_note(s, x, y, z)
}

fn add_attach(s: *mut TreeScratch, x: i32, y: i32, z: i32, radius_offset: i32) {
    if (*s).n_attach >= MAX_ATTACH { return }
    let i: usize = (*s).n_attach
    (*s).at_x[i] = x
    (*s).at_y[i] = y
    (*s).at_z[i] = z
    (*s).at_off[i] = radius_offset
    (*s).n_attach = i + 1
}
