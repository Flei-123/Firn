import mc.gen.wgdf_graph
import mc.gen.wgdf_eval
import mc.gen.wgdf_pscache
import mc.gen.wgdf_aqshare

export { prelim_level }

const INT_MAX: i32 = 2147483647

fn prelim_level(g: *wgdf_graph.WgGraph, ns: *wgdf_eval.WgNoises, node: i32, x: i32, z: i32) -> i32 {
    let qx: i32 = wgdf_eval.floor_div(x, 4)
    let qz: i32 = wgdf_eval.floor_div(z, 4)
    var hit: i32 = 0
    if wgdf_pscache.ps_get(&(*(ns as *mut wgdf_eval.WgNoises)).ps, qx, qz, &hit) {
        return hit
    }
    let share: u64 = (*ns).aqs
    if share != 0 && wgdf_aqshare.prelim_get(share as *wgdf_aqshare.AqShare, qx, qz, &hit) {
        wgdf_pscache.ps_put(&(*(ns as *mut wgdf_eval.WgNoises)).ps, qx, qz, hit)
        return hit
    }
    var result: i32 = INT_MAX
    let cell_h: i32 = (*g).size_v * 4
    var y: i32 = (*g).min_y + (*g).height
    while y >= (*g).min_y {
        if wgdf_eval.eval_direct(g, ns, node, qx * 4, y, qz * 4) > 0.390625 {
            result = y
            y = (*g).min_y - 1
        } else {
            y = y - cell_h
        }
    }
    wgdf_pscache.ps_put(&(*(ns as *mut wgdf_eval.WgNoises)).ps, qx, qz, result)
    if share != 0 {
        wgdf_aqshare.prelim_put(share as *mut wgdf_aqshare.AqShare, qx, qz, result)
    }
    return result
}
