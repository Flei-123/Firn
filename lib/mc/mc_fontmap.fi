// lib/mc/mc_fontmap.fi -- unicode code point -> glyph code of the vanilla ascii.png atlas (0x20-0x7E direct, 0x80-0xFF the upper half), UTF-8 decoding.

import std.rt

export { fontmap_decode, fontmap_glyph, fontmap_utf8_to_glyphs, GLYPH_MISSING }

const GLYPH_MISSING: u32 = 63
const UPPER: str = "ÇüéâäàåçêëèïîìÄÅÉæÆôöòûùÿÖÜø£Ø×ƒáíóúñÑªº¿®¬½¼¡«»░▒▓│┤╡╢╖╕╣║╗╝╜╛┐└┴┬├─┼╞╟╚╔╩╦╠═╬╧╨╤╥╙╘╒╓╫╪┘┌█▄▌▐▀αßΓπΣσμτΦΘΩδ∞∅∈∩≡±≥≤⌠⌡÷≈°∙·√ⁿ²■ "

fn fontmap_decode(p: u64, n: usize, i: usize, out: *mut u32) -> usize {
    let c: u32 = rt.ld8(p, i) as u32
    if c < 128 as u32 {
        *out = c
        return 1
    }
    var need: usize = 0
    var cp: u32 = 0 as u32
    if c >= 240 as u32 && c < 248 as u32 {
        need = 3
        cp = c & 7 as u32
    } else if c >= 224 as u32 && c < 240 as u32 {
        need = 2
        cp = c & 15 as u32
    } else if c >= 192 as u32 && c < 224 as u32 {
        need = 1
        cp = c & 31 as u32
    } else {
        *out = 65533 as u32
        return 1
    }
    if i + need >= n {
        *out = 65533 as u32
        return 1
    }
    var k: usize = 1
    while k <= need {
        let d: u32 = rt.ld8(p, i + k) as u32
        if d < 128 as u32 || d >= 192 as u32 {
            *out = 65533 as u32
            return k
        }
        cp = (cp << 6 as u32) | (d & 63 as u32)
        k = k + 1
    }
    *out = cp
    return need + 1
}

fn fontmap_glyph(cp: u32) -> u32 {
    if cp >= 32 as u32 && cp < 127 as u32 { return cp }
    if cp < 128 as u32 { return GLYPH_MISSING }
    var idx: u32 = 0 as u32
    var i: usize = 0
    while i < UPPER.n {
        var c: u32 = 0 as u32
        let used: usize = fontmap_decode(UPPER.p as u64, UPPER.n, i, &c)
        if c == cp { return 128 as u32 + idx }
        idx = idx + 1 as u32
        i = i + used
    }
    return GLYPH_MISSING
}

fn fontmap_utf8_to_glyphs(p: u64, n: usize, out: *mut rt.Buf, cursor: usize, cursor_out: *mut usize) {
    var i: usize = 0
    while i < n {
        if i == cursor { *cursor_out = rt.buf_len(out) }
        var cp: u32 = 0 as u32
        let used: usize = fontmap_decode(p, n, i, &cp)
        rt.buf_push(out, fontmap_glyph(cp) as u8)
        i = i + used
    }
    if cursor >= n { *cursor_out = rt.buf_len(out) }
}
