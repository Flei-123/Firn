// lib/mc/mc_chunk.fi -- chunk columns as PALETTE SECTIONS (M0, GDD 6).
//
// The server sends a chunk column as a `map_chunk` packet. This file turns it
// into the engine's own world representation:
//
//   Chunk   = x, z, a list of Sections, heightmaps, counters
//   Section = 16x16x16 blocks + 4x4x4 biomes, each stored as a Container
//   Container = PALETTE (distinct global ids, u16) + DENSE index array
//
// The wire format has three shapes of a "paletted container": a single value
// (bits per entry 0), an indirect palette (few distinct values, small
// indexes) and a direct one (global ids, 15 bits for blocks). Those shapes are
// a property of the PROTOCOL VERSION, not of the engine, so the decoder
// normalises all three into ONE internal form:
//
//   * 1 distinct value  -> only the palette, no index array at all ("air
//     costs nothing", GDD 6.1)
//   * n distinct values -> palette of n global ids + indexes packed densely at
//     ceil(log2(n)) bits each, entries are allowed to span two 64 bit words
//     (the wire format does not allow that; the engine format does, because
//     padding costs memory and the section is read-only after decoding)
//
// A direct (global) container therefore shrinks to its real palette; an
// indirect one is re-packed with exactly the bits it needs. What the wire sent
// and what the engine keeps are different on purpose; the dump (dump.fi)
// resolves back to global ids, so it can be compared with a decoder that
// knows nothing about this representation.
//
// The numbers that belong to the protocol version (the largest indirect bit
// count of blocks and of biomes) are constants at the top, in one place, so
// that GDD 8.6 ("version = data") can move them into the version
// description later.

import std.bytes
import std.rt
import std.nbt
import mc.mc_version

export {
    Container, Section, Chunk, Scratch,
    scratch_new, scratch_free, scratch_set_sky,
    chunk_decode, chunk_decode_anon, chunk_decode_19, chunk_decode_114, chunk_decode_legacy8, chunk_is_unload_legacy8, Legacy8Bulk, legacy8_bulk_open, legacy8_bulk_next, legacy8_bulk_complete, legacy8_bulk_free, legacy8_data_len, chunk_decode_for, container_remap, chunk_remap_blocks, chunk_merge_update, chunk_format_supported, chunk_free, chunk_section, chunk_alloc, chunk_release,
    container_get, container_bits, container_palette_size,
    BLOCKS_PER_SECTION, BIOMES_PER_SECTION, HM_ENTRIES, HM_MAX, HM_NAME_MAX,
}

// ---- version dependent constants (1.20.1) -----------------------------------
const BLOCK_MAX_INDIRECT_BITS: u32 = 8 // above this the blocks are sent as global ids
const BIOME_MAX_INDIRECT_BITS: u32 = 3
const GLOBAL_BITS_MAX: u32 = 15 // global ids must fit this many bits
const HM_BITS: u32 = 9 // bits of one heightmap entry (world height 384 -> 9)

// ---- sizes -------------------------------------------------------------------
const BLOCKS_PER_SECTION: usize = 4096
const BIOMES_PER_SECTION: usize = 64
const MAX_SECTIONS: usize = 64 // a column is never taller than 1024 blocks
const HM_ENTRIES: usize = 256
const HM_MAX: usize = 4
const HM_NAME_MAX: usize = 32
const NONE16: u16 = 65535
const WD_WORDS: usize = 1024 // 4096 entries x 15 bits = 960 words at most

struct Container {
    bits: u32, // bits per index in `data`; 0 = single value, no index array
    pal_n: u32, // number of palette entries
    pal: u64, // u16 array [pal_n] of global ids
    data: u64, // dense u64 words, or 0
    words: usize, // number of words in `data`
}

struct Section {
    count: i32, // the blockCount short as sent
    blocks: Container, // 4096 entries, index (y*16 + z)*16 + x
    biomes: Container, // 64 entries, index (y*4 + z)*4 + x
}

struct Chunk {
    x: i32,
    z: i32,
    nsec: usize,
    secs: u64, // array of Section
    nbe: i32, // number of block entities in the packet
    nhm: usize,
    hm_name: [u8; 128], // HM_MAX names of up to HM_NAME_MAX octets
    hm_nlen: [usize; 4],
    hm_val: u64, // HM_MAX * HM_ENTRIES u16 values, or 0
    sky_n: i32, // light arrays in the packet
    block_n: i32,
    light_hash: u64, // FNV-1a over all light arrays as sent
    bio: u64, // 256 biome octets of a ground-up CF_SECTIONS_19 column (index z*16+x), or 0
    ground_up: i32, // CF_SECTIONS_19: 1 = whole column, 0 = section update (the caller must not replace a column with it)
    sec_mask: i32, // CF_SECTIONS_19 / 114: bit i = section i was sent in this packet (other formats: 65535)
}

// Reusable scratch memory for the decoder (one per decoding thread).
struct Scratch {
    ids: u64, // u16 [4096]  resolved global ids of one container
    map: u64, // u16 [32768] global id -> palette index, NONE16 = not present
    pal: u64, // u16 [4096]  wire palette
    idx: u64, // u16 [4096]  new palette indexes
    wd: u64, // u64 [1024] raw long words of one legacy section (CF_SECTIONS_19)
    sky: bool, // the dimension has sky light (CF_SECTIONS_19 sections carry a sky light array then)
}

fn scratch_new() -> Scratch {
    var s: Scratch = Scratch { ids: 0, map: 0, pal: 0, idx: 0, wd: 0, sky: true }
    s.ids = rt.heap_alloc(BLOCKS_PER_SECTION * 2)
    s.map = rt.heap_alloc(32768 * 2)
    s.pal = rt.heap_alloc(BLOCKS_PER_SECTION * 2)
    s.idx = rt.heap_alloc(BLOCKS_PER_SECTION * 2)
    s.wd = rt.heap_alloc(WD_WORDS * 8)
    var i: usize = 0
    if s.map != 0 {
        while i < 32768 {
            rt.st16(s.map, i, NONE16)
            i = i + 1
        }
    }
    return s
}

// Tells the decoder whether the dimension of the next chunks has sky light (CF_SECTIONS_19 only).
fn scratch_set_sky(s: *mut Scratch, sky: bool) {
    (*s).sky = sky
}

fn scratch_free(s: *mut Scratch) {
    rt.heap_free((*s).ids, BLOCKS_PER_SECTION * 2)
    rt.heap_free((*s).map, 32768 * 2)
    rt.heap_free((*s).pal, BLOCKS_PER_SECTION * 2)
    rt.heap_free((*s).idx, BLOCKS_PER_SECTION * 2)
    rt.heap_free((*s).wd, WD_WORDS * 8)
    (*s).wd = 0
    (*s).ids = 0
    (*s).map = 0
    (*s).pal = 0
    (*s).idx = 0
}

// ------------------------------------------------------------------ Containers

fn container_empty() -> Container {
    return Container { bits: 0 as u32, pal_n: 0 as u32, pal: 0, data: 0, words: 0 }
}

fn container_free(c: *mut Container) {
    if (*c).pal != 0 {
        rt.heap_free((*c).pal, ((*c).pal_n as usize) * 2)
    }
    if (*c).data != 0 {
        rt.heap_free((*c).data, (*c).words * 8)
    }
    (*c).pal = 0
    (*c).data = 0
    (*c).pal_n = 0 as u32
    (*c).words = 0
    (*c).bits = 0 as u32
}

fn container_bits(c: *mut Container) -> u32 { return (*c).bits }
fn container_palette_size(c: *mut Container) -> u32 { return (*c).pal_n }

// The global id at index `i`.
fn container_get(c: *mut Container, i: usize) -> u16 {
    if (*c).bits == 0 as u32 {
        return rt.ld16((*c).pal, 0)
    }
    let b: usize = (*c).bits as usize
    let bit: usize = i * b
    let w: usize = bit / 64
    let off: u32 = (bit % 64) as u32
    var v: u64 = rt.ld64((*c).data, w) >> off
    if off as usize + b > 64 {
        v = v | (rt.ld64((*c).data, w + 1) << (64 as u32 - off))
    }
    let mask: u64 = (1 as u64 << (b as u32)) - 1 as u64
    return rt.ld16((*c).pal, (v & mask) as usize)
}

// smallest b >= 1 with 2^b >= n
fn bits_for(n: u32) -> u32 {
    var b: u32 = 1 as u32
    while (1 as u32 << b) < n {
        b = b + 1 as u32
    }
    return b
}

// Builds the normalised container out of the `n` resolved ids in `sc.ids`.
fn container_build(sc: *mut Scratch, n: usize, out: *mut Container) -> BytesError!bool {
    var pn: u32 = 0 as u32
    var i: usize = 0
    while i < n {
        let id: u16 = rt.ld16((*sc).ids, i)
        var k: u16 = rt.ld16((*sc).map, id as usize)
        if k == NONE16 {
            k = pn as u16
            rt.st16((*sc).map, id as usize, k)
            rt.st16((*sc).pal, pn as usize, id)
            pn = pn + 1 as u32
        }
        rt.st16((*sc).idx, i, k)
        i = i + 1
    }
    // leave the map clean for the next container
    var j: u32 = 0 as u32
    while j < pn {
        rt.st16((*sc).map, rt.ld16((*sc).pal, j as usize) as usize, NONE16)
        j = j + 1 as u32
    }
    let pal: u64 = rt.heap_alloc((pn as usize) * 2)
    if pal == 0 {
        return BytesError::OutOfMemory
    }
    rt.mem_copy(pal, (*sc).pal, (pn as usize) * 2)
    (*out).pal = pal
    (*out).pal_n = pn
    if pn == 1 as u32 {
        (*out).bits = 0 as u32
        (*out).data = 0
        (*out).words = 0
        return true
    }
    let b: u32 = bits_for(pn)
    let words: usize = (n * (b as usize) + 63) / 64
    let data: u64 = rt.heap_alloc(words * 8)
    if data == 0 {
        rt.heap_free(pal, (pn as usize) * 2)
        (*out).pal = 0
        (*out).pal_n = 0 as u32
        return BytesError::OutOfMemory
    }
    var w: usize = 0
    while w < words {
        rt.st64(data, w, 0 as u64)
        w = w + 1
    }
    i = 0
    while i < n {
        let v: u64 = rt.ld16((*sc).idx, i) as u64
        let bit: usize = i * (b as usize)
        let wi: usize = bit / 64
        let off: u32 = (bit % 64) as u32
        rt.st64(data, wi, rt.ld64(data, wi) | (v << off))
        if off as usize + (b as usize) > 64 {
            rt.st64(data, wi + 1, rt.ld64(data, wi + 1) | (v >> (64 as u32 - off)))
        }
        i = i + 1
    }
    (*out).bits = b
    (*out).data = data
    (*out).words = words
    return true
}

// One paletted container of `n` entries off the wire.
fn container_decode(b: *mut bytes.Bytes, n: usize, max_indirect: u32,
    sc: *mut Scratch, out: *mut Container) -> BytesError!bool {
    *out = container_empty()
    let bpe: u32 = (try bytes.get_u8(b)) as u32
    if bpe > GLOBAL_BITS_MAX {
        return BytesError::Range
    }
    if bpe == 0 as u32 {
        let v: i32 = try bytes.get_varint(b)
        if v < 0 || v > 32767 {
            return BytesError::Range
        }
        let dl: i32 = try bytes.get_varint(b)
        if dl < 0 {
            return BytesError::Range
        }
        try bytes.bytes_skip(b, (dl as usize) * 8)
        var i: usize = 0
        while i < n {
            rt.st16((*sc).ids, i, v as u16)
            i = i + 1
        }
        return try container_build(sc, n, out)
    }
    var pn: usize = 0
    let indirect: bool = bpe <= max_indirect
    if indirect {
        let pl: i32 = try bytes.get_varint(b)
        if pl < 1 || pl > 4096 {
            return BytesError::Range
        }
        pn = pl as usize
        var k: usize = 0
        while k < pn {
            let e: i32 = try bytes.get_varint(b)
            if e < 0 || e > 32767 {
                return BytesError::Range
            }
            rt.st16((*sc).pal, k, e as u16)
            k = k + 1
        }
    }
    let dl: i32 = try bytes.get_varint(b)
    if dl < 0 {
        return BytesError::Range
    }
    let epl: usize = 64 / (bpe as usize)
    let need: usize = (n + epl - 1) / epl
    if dl as usize != need {
        return BytesError::Range
    }
    if bytes.bytes_remaining(b) < need * 8 {
        return BytesError::Underflow
    }
    let mask: u64 = (1 as u64 << bpe) - 1 as u64
    var i: usize = 0
    var wi: usize = 0
    while wi < need {
        let word: u64 = try bytes.get_u64(b)
        var e: usize = 0
        while e < epl && i < n {
            let v: usize = ((word >> ((e as u32) * bpe)) & mask) as usize
            if indirect {
                if v >= pn {
                    return BytesError::Range
                }
                rt.st16((*sc).ids, i, rt.ld16((*sc).pal, v))
            } else {
                rt.st16((*sc).ids, i, v as u16)
            }
            i = i + 1
            e = e + 1
        }
        wi = wi + 1
    }
    return try container_build(sc, n, out)
}

// --------------------------------------------------------------------- Chunks

// size_of[Section]() is "unknown type" inside a non-root module (BLOCKER.md,
// 2026-10-11); the stride is measured from a two element array instead.
fn section_size() -> usize {
    var a: [Section; 2] = [Section { count: 0, blocks: container_empty(),
            biomes: container_empty() }; 2]
    return ((&a[1]) as u64 - (&a[0]) as u64) as usize
}

fn chunk_section(c: *mut Chunk, i: usize) -> *mut Section {
    return ((*c).secs + (i * section_size()) as u64) as *mut Section
}

fn chunk_free(c: *mut Chunk) {
    var i: usize = 0
    while i < (*c).nsec {
        let s: *mut Section = chunk_section(c, i)
        container_free(&(*s).blocks)
        container_free(&(*s).biomes)
        i = i + 1
    }
    if (*c).secs != 0 {
        rt.heap_free((*c).secs, (*c).nsec * section_size())
    }
    if (*c).hm_val != 0 {
        rt.heap_free((*c).hm_val, HM_MAX * HM_ENTRIES * 2)
    }
    if (*c).bio != 0 {
        rt.heap_free((*c).bio, 256)
    }
    (*c).bio = 0
    (*c).secs = 0
    (*c).hm_val = 0
    (*c).nsec = 0
    (*c).nhm = 0
}

// A heap allocated Chunk (the world keeps pointers to them). Same
// non-root-module size_of workaround as section_size().
fn chunk_size() -> usize {
    var a: [Chunk; 2] = [Chunk { x: 0, z: 0, nsec: 0, secs: 0, nbe: 0, nhm: 0,
            hm_name: [0; 128], hm_nlen: [0; 4], hm_val: 0, sky_n: 0, block_n: 0,
            light_hash: 0 as u64, bio: 0, ground_up: 1, sec_mask: 65535 }; 2]
    return ((&a[1]) as u64 - (&a[0]) as u64) as usize
}

fn chunk_alloc() -> u64 {
    let p: u64 = rt.heap_alloc(chunk_size())
    if p == 0 {
        return 0
    }
    let c: *mut Chunk = p as *mut Chunk
    (*c).x = 0
    (*c).z = 0
    (*c).nsec = 0
    (*c).secs = 0
    (*c).nbe = 0
    (*c).nhm = 0
    (*c).hm_val = 0
    (*c).sky_n = 0
    (*c).block_n = 0
    (*c).light_hash = 0 as u64
    (*c).bio = 0
    (*c).ground_up = 1
    (*c).sec_mask = 65535
    var i: usize = 0
    while i < 4 {
        (*c).hm_nlen[i] = 0
        i = i + 1
    }
    return p
}

fn chunk_release(p: u64) {
    chunk_free(p as *mut Chunk)
    rt.heap_free(p, chunk_size())
}

fn fnv_step(h: u64, by: u8) -> u64 {
    return (h ^ (by as u64)) *% 1099511628211 as u64
}

// Heightmaps: one NBT compound whose entries are long arrays of 9 bit values,
// 7 per long (no value spans two longs).
fn read_heightmaps(b: *mut bytes.Bytes, c: *mut Chunk, anon: bool) -> BytesError!bool {
    // the root compound is named (empty name) up to 1.20.1 and nameless from 1.20.2 (FLAG_NBT_ANON)
    if anon {
        if !(nbt.nbt_read_root_anon(b) catch false) {
            return BytesError::Range
        }
    } else {
        var rn: usize = 0
        let rp: u64 = nbt.nbt_read_root(b, &rn) catch 0
        if rp == 0 && bytes.bytes_remaining(b) == 0 {
            return BytesError::Underflow
        }
    }
    (*c).hm_val = rt.heap_alloc(HM_MAX * HM_ENTRIES * 2)
    if (*c).hm_val == 0 {
        return BytesError::OutOfMemory
    }
    while true {
        let t: u8 = nbt.nbt_read_type(b) catch 255 as u8
        if t == 255 as u8 {
            return BytesError::Range
        }
        if t == nbt.TAG_END {
            return true
        }
        var nl: usize = 0
        let np: u64 = nbt.nbt_read_name(b, &nl) catch 0
        if np == 0 && nl == 0 {
            // an empty name is legal, but a failed read leaves no span either;
            // the following read will notice a damaged buffer
        }
        if t == nbt.TAG_LONG_ARRAY && (*c).nhm < HM_MAX && nl <= HM_NAME_MAX {
            let cnt: i32 = nbt.nbt_read_array_len(b, 8) catch 0 - 1
            if cnt < 0 {
                return BytesError::Range
            }
            let per: usize = 64 / (HM_BITS as usize)
            if (cnt as usize) != (HM_ENTRIES + per - 1) / per {
                return BytesError::Range
            }
            let slot: usize = (*c).nhm
            var q: usize = 0
            while q < nl {
                (*c).hm_name[slot * HM_NAME_MAX + q] = rt.ld8(np, q)
                q = q + 1
            }
            (*c).hm_nlen[slot] = nl
            let mask: u64 = (1 as u64 << HM_BITS) - 1 as u64
            var i: usize = 0
            var li: usize = 0
            while li < (cnt as usize) {
                let word: u64 = try bytes.get_u64(b)
                var e: usize = 0
                while e < per && i < HM_ENTRIES {
                    let v: u64 = (word >> ((e as u32) * HM_BITS)) & mask
                    rt.st16((*c).hm_val, slot * HM_ENTRIES + i, v as u16)
                    i = i + 1
                    e = e + 1
                }
                li = li + 1
            }
            (*c).nhm = slot + 1
        } else {
            nbt.nbt_skip_payload(b, t) catch false
        }
    }
    return true
}

// The `chunkData` buffer: sections until the buffer is used up.
fn read_sections(data: *mut bytes.Bytes, c: *mut Chunk, sc: *mut Scratch, want: usize) -> BytesError!bool {
    // The number of sections is NOT announced in the packet. A client knows it from the
    // dimension (height / 16, mc_dimension.fi): `want` > 0 parses exactly that many and IGNORES
    // what follows -- the vanilla server pads the buffer with zero octets (measured: 16 octets
    // after the 24 sections of an overworld column), and those must not be read as sections.
    // `want` == 0 means "until the data is used up" (selftest, unknown dimension).
    let cap: usize = MAX_SECTIONS
    let base: u64 = rt.heap_alloc(cap * section_size())
    if base == 0 {
        return BytesError::OutOfMemory
    }
    (*c).secs = base
    var n: usize = 0
    while bytes.bytes_remaining(data) > 0 && (want == 0 || n < want) {
        if n >= cap {
            (*c).nsec = n
            return BytesError::Range
        }
        let s: *mut Section = ((*c).secs + (n * section_size()) as u64) as *mut Section
        (*s).blocks = container_empty()
        (*s).biomes = container_empty()
        (*c).nsec = n + 1
        (*s).count = (try bytes.get_i16(data)) as i32
        try container_decode(data, BLOCKS_PER_SECTION, BLOCK_MAX_INDIRECT_BITS, sc, &(*s).blocks)
        try container_decode(data, BIOMES_PER_SECTION, BIOME_MAX_INDIRECT_BITS, sc, &(*s).biomes)
        n = n + 1
    }
    return true
}

// Skips one block entity: packed x/z (u8), y (i16), type (varint), optional NBT.
fn skip_block_entity(b: *mut bytes.Bytes, anon: bool) -> BytesError!bool {
    try bytes.get_u8(b)
    try bytes.get_i16(b)
    try bytes.get_varint(b)
    let t: u8 = try bytes.get_u8(b)
    if t == 0 as u8 {
        return true // no NBT
    }
    // the type octet has been read; a named root follows (u16 name length) unless it is nameless (1.20.2+)
    if !anon {
        let nl: u16 = try bytes.get_u16(b)
        try bytes.bytes_skip(b, nl as usize)
    }
    nbt.nbt_skip_payload(b, t) catch false
    return true
}

// Counted arrays of i64 (the light masks): returns the count, skips the data.
fn skip_long_array(b: *mut bytes.Bytes) -> BytesError!i32 {
    let n: i32 = try bytes.get_varint(b)
    if n < 0 || n > 4096 {
        return BytesError::Range
    }
    try bytes.bytes_skip(b, (n as usize) * 8)
    return n
}

// Counted array of light arrays; hashes their octets into `h`.
fn read_light(b: *mut bytes.Bytes, h: *mut u64) -> BytesError!i32 {
    let n: i32 = try bytes.get_varint(b)
    if n < 0 || n > 4096 {
        return BytesError::Range
    }
    var i: i32 = 0
    while i < n {
        let l: i32 = try bytes.get_varint(b)
        if l < 0 || l as usize > bytes.bytes_remaining(b) {
            return BytesError::Range
        }
        let p: u64 = try bytes.get_span(b, l as usize)
        var k: usize = 0
        while k < (l as usize) {
            *h = fnv_step(*h, rt.ld8(p, k))
            k = k + 1
        }
        i = i + 1
    }
    return n
}

// ---------------------------------------------------------------- version strategies
//
// The chunk packet and the section layout differ between game versions
// (mc_version.CF_*). The decoded result -- Chunk / Section / Container above -- does NOT:
// it is the version neutral world model. A format is a decoding STRATEGY that fills
// that model; adding a version with a known format needs no change here, a new format
// is one more function plus one `if` in chunk_decode_for (docs/MC-VERSIONS.md).
//
//   CF_CONTAINERS_118  implemented (chunk_decode below)         1.18 - 1.20.x
//   CF_SECTIONS_114    implemented for 1.16.2 - 1.16.5 (chunk_decode_114): bitmask of sections, heightmaps
//                      NBT, separate light packet, biomes as int array, longs do not span  (1.14/1.15/1.17: open)
//   CF_SECTIONS_19     implemented (chunk_decode_19): paletted blocks only, inline light, biome
//                      bytes, block ids are id<<4|meta (no flattening)  1.9 - 1.12.2 (1.13 differs, see docs/MC-VERSIONS.md)
//   CF_LEGACY_8        implemented (chunk_decode_legacy8 + legacy8_bulk_*): unpaletted u16 LE arrays,
//                      light per column, map_chunk_bulk, unload = empty ground-up column  1.8 - 1.8.9
fn chunk_format_supported(fmt: i32) -> bool {
    return fmt == mc_version.CF_CONTAINERS_118 || fmt == mc_version.CF_SECTIONS_19
    || fmt == mc_version.CF_SECTIONS_114 || fmt == mc_version.CF_LEGACY_8
}

// Strategy dispatch on the version's chunk format. Returns BytesError::Range for a
// format that has no decoder yet (the caller reports "unsupported chunk format").
fn chunk_decode_for(v: *mut mc_version.Version, b: *mut bytes.Bytes, sc: *mut Scratch,
    c: *mut Chunk, nsec: usize) -> BytesError!bool {
    if (*v).chunk_format == mc_version.CF_CONTAINERS_118 {
        return try chunk_decode_anon(b, sc, c, nsec, mc_version.version_has(v, mc_version.FLAG_NBT_ANON))
    }
    if (*v).chunk_format == mc_version.CF_SECTIONS_19 {
        return try chunk_decode_19(b, sc, c)
    }
    if (*v).chunk_format == mc_version.CF_SECTIONS_114 {
        return try chunk_decode_114(b, sc, c, (*v).protocol)
    }
    if (*v).chunk_format == mc_version.CF_LEGACY_8 {
        return try chunk_decode_legacy8(b, sc, c)
    }
    return BytesError::Range
}

// Decodes a whole `map_chunk` body (cursor behind the packet id) into `c`.
// On error `c` may be half built: call chunk_free on it either way.
fn chunk_decode(b: *mut bytes.Bytes, sc: *mut Scratch, c: *mut Chunk, nsec: usize) -> BytesError!bool {
    return try chunk_decode_anon(b, sc, c, nsec, false)
}

// Same with the NBT root convention of the version: `anon` = nameless root compounds (1.20.2+, FLAG_NBT_ANON).
fn chunk_decode_anon(b: *mut bytes.Bytes, sc: *mut Scratch, c: *mut Chunk, nsec: usize, anon: bool) -> BytesError!bool {
    (*c).x = try bytes.get_i32(b)
    (*c).z = try bytes.get_i32(b)
    (*c).nsec = 0
    (*c).secs = 0
    (*c).nhm = 0
    (*c).hm_val = 0
    (*c).nbe = 0
    (*c).sky_n = 0
    (*c).block_n = 0
    (*c).light_hash = 14695981039346656037 as u64
    try read_heightmaps(b, c, anon)
    // chunkData: varint length + octets, decoded in place as a sub view
    let dl: i32 = try bytes.get_varint(b)
    if dl < 0 || dl as usize > bytes.bytes_remaining(b) {
        return BytesError::Range
    }
    let dp: u64 = try bytes.get_span(b, dl as usize)
    var data: bytes.Bytes = bytes.Bytes { data: dp, cap: dl as usize, len: dl as usize, pos: 0, bad: false }
    try read_sections(&data, c, sc, nsec)
    if nsec > 0 && (*c).nsec != nsec {
        return BytesError::Underflow // fewer sections than the dimension has
    }
    // block entities
    let nbe: i32 = try bytes.get_varint(b)
    if nbe < 0 || nbe > 65536 {
        return BytesError::Range
    }
    var i: i32 = 0
    while i < nbe {
        try skip_block_entity(b, anon)
        i = i + 1
    }
    (*c).nbe = nbe
    // four masks (counts only), then the sky and block light arrays
    try skip_long_array(b)
    try skip_long_array(b)
    try skip_long_array(b)
    try skip_long_array(b)
    var h: u64 = (*c).light_hash
    (*c).sky_n = try read_light(b, &h)
    (*c).block_n = try read_light(b, &h)
    (*c).light_hash = h
    if bytes.bytes_remaining(b) != 0 {
        return BytesError::Range // the packet must be consumed exactly
    }
    return true
}

// ------------------------------------------------------------ CF_SECTIONS_19 (1.9 - 1.12.2)
//
// map_chunk body: x (i32), z (i32), groundUp (bool), bitMap (varint, bit i = section i present),
// chunkData (varint length + octets), block entities (varint count + NBT compounds).
// chunkData, per present section (lowest first):
//     bits per block (u8), palette length (varint; 0 = no palette, the values are direct ids),
//     palette entries (varint), data length in longs (varint), the packed longs
//     -- in this format an entry MAY span two longs (unlike 1.16+) --,
//     2048 octets block light, 2048 octets sky light (only if the dimension has a sky);
// a ground-up column ends with 256 biome octets. A block value is `id << 4 | metadata`.
//
// The neutral Chunk gets all 16 sections (an absent one is all air, count 0), `count` is the
// number of non-air blocks (the format has no blockCount), the biomes of a section are the
// single value 0 (the real biomes are the column array `Chunk.bio`).

// Decodes one legacy section container (4096 entries) into `out`; ids stay in `sc.ids`.
fn legacy_container_decode(b: *mut bytes.Bytes, sc: *mut Scratch, out: *mut Container) -> BytesError!bool {
    *out = container_empty()
    var bpe: u32 = (try bytes.get_u8(b)) as u32
    if bpe > GLOBAL_BITS_MAX {
        return BytesError::Range
    }
    if bpe < 4 as u32 {
        bpe = 4 as u32 // servers never send fewer; the value is clamped like the reference client does
    }
    let pl: i32 = try bytes.get_varint(b)
    if pl < 0 || pl > 4096 {
        return BytesError::Range
    }
    var k: i32 = 0
    while k < pl {
        let e: i32 = try bytes.get_varint(b)
        if e < 0 || e > 32767 {
            return BytesError::Range
        }
        rt.st16((*sc).pal, k as usize, e as u16)
        k = k + 1
    }
    let dl: i32 = try bytes.get_varint(b)
    let need: usize = (BLOCKS_PER_SECTION * (bpe as usize) + 63) / 64
    if dl < 0 || (dl as usize) != need || need > WD_WORDS {
        return BytesError::Range
    }
    if bytes.bytes_remaining(b) < need * 8 {
        return BytesError::Underflow
    }
    var w: usize = 0
    while w < need {
        rt.st64((*sc).wd, w, try bytes.get_u64(b))
        w = w + 1
    }
    let mask: u64 = (1 as u64 << bpe) - 1 as u64
    var i: usize = 0
    while i < BLOCKS_PER_SECTION {
        let bit: usize = i * (bpe as usize)
        let wi: usize = bit / 64
        let off: u32 = (bit % 64) as u32
        var v: u64 = rt.ld64((*sc).wd, wi) >> off
        if off as usize + (bpe as usize) > 64 {
            v = v | (rt.ld64((*sc).wd, wi + 1) << (64 as u32 - off))
        }
        v = v & mask
        if pl > 0 {
            if (v as i32) >= pl {
                return BytesError::Range
            }
            rt.st16((*sc).ids, i, rt.ld16((*sc).pal, v as usize))
        } else {
            rt.st16((*sc).ids, i, v as u16)
        }
        i = i + 1
    }
    return try container_build(sc, BLOCKS_PER_SECTION, out)
}

// all-zero container of `n` entries (air blocks, biome 0)
fn container_zero(sc: *mut Scratch, n: usize, out: *mut Container) -> BytesError!bool {
    var i: usize = 0
    while i < n {
        rt.st16((*sc).ids, i, 0 as u16)
        i = i + 1
    }
    return try container_build(sc, n, out)
}

fn hash_span(h: *mut u64, p: u64, n: usize) {
    var k: usize = 0
    while k < n {
        *h = fnv_step(*h, rt.ld8(p, k))
        k = k + 1
    }
}

// Decodes a whole 1.9 - 1.12.2 `map_chunk` body (cursor behind the packet id). Whether the sky
// light arrays are present depends on the dimension: set it with scratch_set_sky. On error `c`
// may be half built: call chunk_free on it either way.
fn chunk_decode_19(b: *mut bytes.Bytes, sc: *mut Scratch, c: *mut Chunk) -> BytesError!bool {
    (*c).x = try bytes.get_i32(b)
    (*c).z = try bytes.get_i32(b)
    let gu: u8 = try bytes.get_u8(b)
    (*c).ground_up = 0
    if gu != 0 as u8 {
        (*c).ground_up = 1
    }
    (*c).nsec = 0
    (*c).secs = 0
    (*c).nhm = 0
    (*c).hm_val = 0
    (*c).bio = 0
    (*c).nbe = 0
    (*c).sky_n = 0
    (*c).block_n = 0
    (*c).light_hash = 14695981039346656037 as u64
    let mask: i32 = try bytes.get_varint(b)
    if mask < 0 || mask > 65535 {
        return BytesError::Range
    }
    (*c).sec_mask = mask
    let dl: i32 = try bytes.get_varint(b)
    if dl < 0 || dl as usize > bytes.bytes_remaining(b) {
        return BytesError::Range
    }
    let dp: u64 = try bytes.get_span(b, dl as usize)
    var data: bytes.Bytes = bytes.Bytes { data: dp, cap: dl as usize, len: dl as usize, pos: 0, bad: false }
    let base: u64 = rt.heap_alloc(16 * section_size())
    if base == 0 {
        return BytesError::OutOfMemory
    }
    (*c).secs = base
    var h: u64 = (*c).light_hash
    var i: usize = 0
    while i < 16 {
        let s: *mut Section = ((*c).secs + (i * section_size()) as u64) as *mut Section
        (*s).blocks = container_empty()
        (*s).biomes = container_empty()
        (*c).nsec = i + 1
        (*s).count = 0
        if ((mask >> (i as u32)) & 1) != 0 {
            try legacy_container_decode(&data, sc, &(*s).blocks)
            var nonair: i32 = 0
            var q: usize = 0
            while q < BLOCKS_PER_SECTION {
                if rt.ld16((*sc).ids, q) != 0 as u16 {
                    nonair = nonair + 1
                }
                q = q + 1
            }
            (*s).count = nonair
            if bytes.bytes_remaining(&data) < 2048 {
                return BytesError::Underflow
            }
            hash_span(&h, try bytes.get_span(&data, 2048), 2048)
            (*c).block_n = (*c).block_n + 1
            if (*sc).sky {
                if bytes.bytes_remaining(&data) < 2048 {
                    return BytesError::Underflow
                }
                hash_span(&h, try bytes.get_span(&data, 2048), 2048)
                (*c).sky_n = (*c).sky_n + 1
            }
        } else {
            try container_zero(sc, BLOCKS_PER_SECTION, &(*s).blocks)
        }
        try container_zero(sc, BIOMES_PER_SECTION, &(*s).biomes)
        i = i + 1
    }
    (*c).light_hash = h
    if (*c).ground_up == 1 {
        if bytes.bytes_remaining(&data) < 256 {
            return BytesError::Underflow
        }
        let bp: u64 = try bytes.get_span(&data, 256)
        (*c).bio = rt.heap_alloc(256)
        if (*c).bio == 0 {
            return BytesError::OutOfMemory
        }
        rt.mem_copy((*c).bio, bp, 256)
    }
    if bytes.bytes_remaining(&data) != 0 {
        return BytesError::Range // the section data must be consumed exactly (a wrong sky light flag shows up here)
    }
    // block entities: varint count, then that many NBT compounds (named roots)
    let nbe: i32 = try bytes.get_varint(b)
    if nbe < 0 || nbe > 65536 {
        return BytesError::Range
    }
    var n: i32 = 0
    while n < nbe {
        let t: u8 = nbt.nbt_read_type(b) catch 255 as u8
        if t != nbt.TAG_COMPOUND {
            return BytesError::Range
        }
        let nl: u16 = try bytes.get_u16(b)
        try bytes.bytes_skip(b, nl as usize)
        if !(nbt.nbt_skip_payload(b, t) catch false) {
            return BytesError::Range
        }
        n = n + 1
    }
    (*c).nbe = nbe
    if bytes.bytes_remaining(b) != 0 {
        return BytesError::Range // the packet must be consumed exactly
    }
    return true
}

// ------------------------------------------------------------ CF_SECTIONS_114 (1.16.2 - 1.16.5)
//
// map_chunk body (protocol 751 - 754): x (i32), z (i32), groundUp (bool), bitMap (varint, bit i = section i
// present), heightmaps (named NBT compound), biomes (ONLY when groundUp: varint count = 1024, then that many
// varints), chunkData (varint length + octets), block entities (varint count + NBT compounds).
// chunkData, per present section (lowest first):
//     blockCount (i16), bits per block (u8), [palette length (varint) + entries (varint) when bits <= 8],
//     data length in longs (varint), the packed longs -- an entry NEVER spans two longs (unlike 1.9 - 1.12.2).
// Direct (global) ids use 15 bits in 1.16.5. There is NO light in this packet (separate update_light packet,
// not decoded: sky/block counts are 0 and the light hash is the FNV offset basis).
// The 1024 biome entries are ordered (y*4 + z)*4 + x with y = 0..63 (4 block cells), so section i owns the
// entries i*64 .. i*64+63 in exactly the neutral Section.biomes order.
//
// A 1.16 column is always 256 blocks high (16 sections) -- datapack heights came with 1.17 -- so the
// number of sections does not depend on the dimension. An absent section is all air (count 0).
// 1.14 / 1.15 (longs span, 256 biome ints in 1.14) and 1.16.0 / 1.16.1 (extra ignoreOldData bool) and
// 1.17 (long array mask) are NOT covered; the caller gets BytesError::Range for those protocols.
const SECTIONS_114: usize = 16
const BIOMES_114: usize = 1024

fn chunk_decode_114(b: *mut bytes.Bytes, sc: *mut Scratch, c: *mut Chunk, protocol: i32) -> BytesError!bool {
    if protocol < 751 || protocol > 754 {
        return BytesError::Range
    }
    (*c).x = try bytes.get_i32(b)
    (*c).z = try bytes.get_i32(b)
    let gu: u8 = try bytes.get_u8(b)
    (*c).ground_up = 0
    if gu != 0 as u8 {
        (*c).ground_up = 1
    }
    (*c).nsec = 0
    (*c).secs = 0
    (*c).nhm = 0
    (*c).hm_val = 0
    (*c).bio = 0
    (*c).nbe = 0
    (*c).sky_n = 0
    (*c).block_n = 0
    (*c).light_hash = 14695981039346656037 as u64
    let mask: i32 = try bytes.get_varint(b)
    if mask < 0 || mask > 65535 {
        return BytesError::Range
    }
    (*c).sec_mask = mask
    try read_heightmaps(b, c, false)
    // biomes: 1024 varints, only in a ground-up column
    var bio: u64 = 0
    if (*c).ground_up == 1 {
        let bn: i32 = try bytes.get_varint(b)
        if bn != (BIOMES_114 as i32) {
            return BytesError::Range
        }
        bio = rt.heap_alloc(BIOMES_114 * 2)
        if bio == 0 {
            return BytesError::OutOfMemory
        }
        var q: usize = 0
        while q < BIOMES_114 {
            let e: i32 = bytes.get_varint(b) catch 0 - 1
            if e < 0 || e > 32767 {
                rt.heap_free(bio, BIOMES_114 * 2)
                return BytesError::Range
            }
            rt.st16(bio, q, e as u16)
            q = q + 1
        }
    }
    let r: bool = chunk_sections_114(b, sc, c, mask, bio) catch false
    if bio != 0 {
        rt.heap_free(bio, BIOMES_114 * 2)
    }
    if !r {
        return BytesError::Range
    }
    return true
}

// chunkData + block entities of a 1.16.2 - 1.16.5 packet; `bio` = the 1024 biome ids (u16) or 0.
fn chunk_sections_114(b: *mut bytes.Bytes, sc: *mut Scratch, c: *mut Chunk, mask: i32, bio: u64) -> BytesError!bool {
    let dl: i32 = try bytes.get_varint(b)
    if dl < 0 || dl as usize > bytes.bytes_remaining(b) {
        return BytesError::Range
    }
    let dp: u64 = try bytes.get_span(b, dl as usize)
    var data: bytes.Bytes = bytes.Bytes { data: dp, cap: dl as usize, len: dl as usize, pos: 0, bad: false }
    let base: u64 = rt.heap_alloc(SECTIONS_114 * section_size())
    if base == 0 {
        return BytesError::OutOfMemory
    }
    (*c).secs = base
    var i: usize = 0
    while i < SECTIONS_114 {
        let s: *mut Section = ((*c).secs + (i * section_size()) as u64) as *mut Section
        (*s).blocks = container_empty()
        (*s).biomes = container_empty()
        (*c).nsec = i + 1
        (*s).count = 0
        if ((mask >> (i as u32)) & 1) != 0 {
            (*s).count = (try bytes.get_i16(&data)) as i32
            try container_decode(&data, BLOCKS_PER_SECTION, BLOCK_MAX_INDIRECT_BITS, sc, &(*s).blocks)
        } else {
            try container_zero(sc, BLOCKS_PER_SECTION, &(*s).blocks)
        }
        // biomes of this section: its 64 entries of the column array (all 0 without one)
        var q: usize = 0
        while q < BIOMES_PER_SECTION {
            var v: u16 = 0 as u16
            if bio != 0 {
                v = rt.ld16(bio, i * BIOMES_PER_SECTION + q)
            }
            rt.st16((*sc).ids, q, v)
            q = q + 1
        }
        try container_build(sc, BIOMES_PER_SECTION, &(*s).biomes)
        i = i + 1
    }
    // block entities: varint count, then that many NBT compounds (named roots)
    let nbe: i32 = try bytes.get_varint(b)
    if nbe < 0 || nbe > 65536 {
        return BytesError::Range
    }
    var n: i32 = 0
    while n < nbe {
        let t: u8 = nbt.nbt_read_type(b) catch 255 as u8
        if t != nbt.TAG_COMPOUND {
            return BytesError::Range
        }
        let nl: u16 = try bytes.get_u16(b)
        try bytes.bytes_skip(b, nl as usize)
        if !(nbt.nbt_skip_payload(b, t) catch false) {
            return BytesError::Range
        }
        n = n + 1
    }
    (*c).nbe = nbe
    if bytes.bytes_remaining(b) != 0 {
        return BytesError::Range // the packet must be consumed exactly
    }
    return true
}

// ---------------------------------------------------------------- flattening remap

// Maps every value of `c` (n entries) through `table` (u16 [tn], e.g. the flattening table of
// mc_flat); a value >= tn becomes 0 (air). Two old values may map to ONE new value: the palette
// is then rebuilt (palette entries stay distinct, the index width shrinks if it can).
fn container_remap(sc: *mut Scratch, c: *mut Container, n: usize, table: u64, tn: usize) -> BytesError!bool {
    let pn: usize = (*c).pal_n as usize
    if pn == 0 {
        return true
    }
    var dup: bool = false
    var k: usize = 0
    while k < pn {
        let v: usize = rt.ld16((*c).pal, k) as usize
        var m: u16 = 0 as u16
        if v < tn {
            m = rt.ld16(table, v)
        }
        rt.st16((*sc).pal, k, m)
        if rt.ld16((*sc).map, m as usize) != NONE16 {
            dup = true
        } else {
            rt.st16((*sc).map, m as usize, k as u16)
        }
        k = k + 1
    }
    k = 0
    while k < pn {
        rt.st16((*sc).map, rt.ld16((*sc).pal, k) as usize, NONE16)
        k = k + 1
    }
    if !dup {
        rt.mem_copy((*c).pal, (*sc).pal, pn * 2)
        return true
    }
    var i: usize = 0
    while i < n {
        let v: usize = container_get(c, i) as usize
        var m: u16 = 0 as u16
        if v < tn {
            m = rt.ld16(table, v)
        }
        rt.st16((*sc).ids, i, m)
        i = i + 1
    }
    var nc: Container = container_empty()
    try container_build(sc, n, &nc)
    container_free(c)
    *c = nc
    return true
}

// Remaps the blocks of every section of `c` through `table` (legacy id << 4 | meta -> global state id) and
// recounts the non-air blocks (`Section.count`); biomes are not touched.
fn chunk_remap_blocks(c: *mut Chunk, sc: *mut Scratch, table: u64, tn: usize) -> BytesError!bool {
    var i: usize = 0
    while i < (*c).nsec {
        let s: *mut Section = chunk_section(c, i)
        try container_remap(sc, &(*s).blocks, BLOCKS_PER_SECTION, table, tn)
        var nonair: i32 = 0
        var q: usize = 0
        while q < BLOCKS_PER_SECTION {
            if container_get(&(*s).blocks, q) != 0 as u16 {
                nonair = nonair + 1
            }
            q = q + 1
        }
        (*s).count = nonair
        i = i + 1
    }
    return true
}

// ---------------------------------------------------------------- section updates

// CF_SECTIONS_19: merges a section update `upd` (groundUp = false) into the stored column `dst`: every
// section named in upd.sec_mask REPLACES the section of dst (the blocks container moves, `upd` keeps an
// empty one and may be released). Biomes, heightmaps and block entities of dst stay; the light counters
// add up, `light_hash` stays the hash of the original packet. Returns the number of sections merged.
fn chunk_merge_update(dst: *mut Chunk, upd: *mut Chunk) -> i32 {
    var merged: i32 = 0
    var i: usize = 0
    while i < (*dst).nsec && i < (*upd).nsec {
        if (((*upd).sec_mask >> (i as u32)) & 1) != 0 {
            let d: *mut Section = chunk_section(dst, i)
            let u: *mut Section = chunk_section(upd, i)
            container_free(&(*d).blocks)
            (*d).blocks = (*u).blocks
            (*u).blocks = container_empty()
            (*d).count = (*u).count
            merged = merged + 1
        }
        i = i + 1
    }
    (*dst).block_n = (*dst).block_n + (*upd).block_n
    (*dst).sky_n = (*dst).sky_n + (*upd).sky_n
    return merged
}

// ------------------------------------------------------------ CF_LEGACY_8 (1.8 - 1.8.9)
//
// map_chunk body: x (i32), z (i32), groundUp (bool), bitMap (u16, bit i = section i present),
// chunkData (varint length + octets). NO block entities and no block-entity count in this packet.
// chunkData, in this order (NOT per section):
//     every present section: 4096 blocks as u16 LITTLE endian (id << 4 | meta), index (y*16 + z)*16 + x,
//     every present section: 2048 octets block light,
//     every present section: 2048 octets sky light (only if the dimension has a sky),
//     groundUp: 256 biome octets.
// map_chunk_bulk body: skyLightSent (bool), count (varint), count x { x (i32), z (i32), bitMap (u16) },
// then the chunk data of all columns back to back (each laid out as above; every column of a bulk
// has groundUp = true, so every column ends with its 256 biome octets).
// A chunk UNLOAD is a map_chunk with groundUp = true, bitMap = 0 and an EMPTY chunkData (no biomes).
// Block values stay `id << 4 | meta` (no flattening). The neutral Chunk gets all 16 sections (an
// absent one is all air), `count` = number of non-air blocks, biomes of a section = single value 0
// (the real biomes are the column array Chunk.bio), light is hashed in wire order (all block light,
// then all sky light).

const L8_BLOCK_OCTETS: usize = 8192
const L8_LIGHT_OCTETS: usize = 2048

fn legacy8_popcount(m: i32) -> usize {
    var n: usize = 0
    var i: u32 = 0
    while i < 16 as u32 {
        if ((m >> i) & 1) != 0 {
            n = n + 1
        }
        i = i + 1 as u32
    }
    return n
}

// Octets of the chunk data of one column.
fn legacy8_data_len(mask: i32, ground_up: bool, sky: bool) -> usize {
    let n: usize = legacy8_popcount(mask)
    var per: usize = L8_BLOCK_OCTETS + L8_LIGHT_OCTETS
    if sky {
        per = per + L8_LIGHT_OCTETS
    }
    var len: usize = n * per
    if ground_up {
        len = len + 256
    }
    return len
}

// true for the "column is gone" form of Chunk (map_chunk, groundUp, bitMap 0, empty data)
fn chunk_is_unload_legacy8(c: *mut Chunk) -> bool {
    return (*c).ground_up == 1 && (*c).nsec == 0 && (*c).bio == 0
}

// Decodes the chunk data `data` of ONE column (must be consumed exactly) into `c`.
// On error `c` may be half built: call chunk_free on it either way.
fn legacy8_column(data: *mut bytes.Bytes, x: i32, z: i32, mask: i32, ground_up: bool, sky: bool,
    sc: *mut Scratch, c: *mut Chunk) -> BytesError!bool {
    (*c).x = x
    (*c).z = z
    (*c).ground_up = 0
    if ground_up {
        (*c).ground_up = 1
    }
    (*c).nsec = 0
    (*c).secs = 0
    (*c).nhm = 0
    (*c).hm_val = 0
    (*c).bio = 0
    (*c).nbe = 0
    (*c).sky_n = 0
    (*c).block_n = 0
    (*c).light_hash = 14695981039346656037 as u64
    if mask < 0 || mask > 65535 {
        return BytesError::Range
    }
    let nset: usize = legacy8_popcount(mask)
    if ground_up && mask == 0 && bytes.bytes_remaining(data) == 0 {
        return true // unload marker: no sections, no biomes (chunk_is_unload_legacy8)
    }
    let need: usize = legacy8_data_len(mask, ground_up, sky)
    if bytes.bytes_remaining(data) < need {
        return BytesError::Underflow
    }
    if bytes.bytes_remaining(data) != need {
        return BytesError::Range // wrong sky light assumption or garbage: never guess
    }
    var bp: u64 = 0
    var lp: u64 = 0
    var sp: u64 = 0
    if nset > 0 {
        bp = try bytes.get_span(data, nset * L8_BLOCK_OCTETS)
        lp = try bytes.get_span(data, nset * L8_LIGHT_OCTETS)
        if sky {
            sp = try bytes.get_span(data, nset * L8_LIGHT_OCTETS)
        }
    }
    var h: u64 = (*c).light_hash
    hash_span(&h, lp, nset * L8_LIGHT_OCTETS)
    if sky {
        hash_span(&h, sp, nset * L8_LIGHT_OCTETS)
        (*c).sky_n = nset as i32
    }
    (*c).block_n = nset as i32
    (*c).light_hash = h
    let base: u64 = rt.heap_alloc(16 * section_size())
    if base == 0 {
        return BytesError::OutOfMemory
    }
    (*c).secs = base
    var k: usize = 0
    var i: usize = 0
    while i < 16 {
        let s: *mut Section = ((*c).secs + (i * section_size()) as u64) as *mut Section
        (*s).blocks = container_empty()
        (*s).biomes = container_empty()
        (*c).nsec = i + 1
        (*s).count = 0
        if ((mask >> (i as u32)) & 1) != 0 {
            let sec: u64 = bp + (k * L8_BLOCK_OCTETS) as u64
            var nonair: i32 = 0
            var q: usize = 0
            while q < BLOCKS_PER_SECTION {
                let v: u16 = (rt.ld8(sec, q * 2) as u16) | ((rt.ld8(sec, q * 2 + 1) as u16) << 8)
                if v >= 32768 as u16 {
                    return BytesError::Range // beyond the id table of the neutral model (vanilla 1.8 stays below 4096 << 4)
                }
                rt.st16((*sc).ids, q, v)
                if v != 0 as u16 {
                    nonair = nonair + 1
                }
                q = q + 1
            }
            (*s).count = nonair
            try container_build(sc, BLOCKS_PER_SECTION, &(*s).blocks)
            k = k + 1
        } else {
            try container_zero(sc, BLOCKS_PER_SECTION, &(*s).blocks)
        }
        try container_zero(sc, BIOMES_PER_SECTION, &(*s).biomes)
        i = i + 1
    }
    if ground_up {
        let bio: u64 = try bytes.get_span(data, 256)
        (*c).bio = rt.heap_alloc(256)
        if (*c).bio == 0 {
            return BytesError::OutOfMemory
        }
        rt.mem_copy((*c).bio, bio, 256)
    }
    return true
}

// Decodes a whole 1.8 `map_chunk` body (cursor behind the packet id). Whether sky light is present
// comes from the dimension: scratch_set_sky. An unload (see above) yields a chunk for which
// chunk_is_unload_legacy8 is true. On error `c` may be half built: call chunk_free on it either way.
fn chunk_decode_legacy8(b: *mut bytes.Bytes, sc: *mut Scratch, c: *mut Chunk) -> BytesError!bool {
    let x: i32 = try bytes.get_i32(b)
    let z: i32 = try bytes.get_i32(b)
    let gu: u8 = try bytes.get_u8(b)
    let mask: i32 = (try bytes.get_u16(b)) as i32
    let dl: i32 = try bytes.get_varint(b)
    if dl < 0 || dl as usize > bytes.bytes_remaining(b) {
        return BytesError::Range
    }
    let dp: u64 = try bytes.get_span(b, dl as usize)
    var data: bytes.Bytes = bytes.Bytes { data: dp, cap: dl as usize, len: dl as usize, pos: 0, bad: false }
    try legacy8_column(&data, x, z, mask, gu != 0 as u8, (*sc).sky, sc, c)
    if bytes.bytes_remaining(b) != 0 {
        return BytesError::Range // the packet must be consumed exactly
    }
    return true
}

// ---- map_chunk_bulk: header first, then one call per column
struct Legacy8Bulk {
    sky: bool, // skyLightSent
    n: usize, // number of columns
    next: usize, // next column to decode
    meta: u64, // u64 [n*3]: x, z (as i32 sign extended), bitMap
}

// Reads the bulk header (skyLightSent, count, per-column metadata); the cursor then stands at the
// first column's data. Release with legacy8_bulk_free.
fn legacy8_bulk_open(b: *mut bytes.Bytes, h: *mut Legacy8Bulk) -> BytesError!bool {
    (*h).sky = false
    (*h).n = 0
    (*h).next = 0
    (*h).meta = 0
    let sky: u8 = try bytes.get_u8(b)
    let n: i32 = try bytes.get_varint(b)
    if n < 0 || n > 4096 {
        return BytesError::Range
    }
    if (n as usize) * 10 > bytes.bytes_remaining(b) {
        return BytesError::Underflow
    }
    (*h).sky = sky != 0 as u8
    if n > 0 {
        (*h).meta = rt.heap_alloc((n as usize) * 3 * 8)
        if (*h).meta == 0 {
            return BytesError::OutOfMemory
        }
        (*h).n = n as usize
    }
    var i: usize = 0
    while i < (*h).n {
        rt.st64((*h).meta, i * 3, (try bytes.get_i32(b)) as i64 as u64)
        rt.st64((*h).meta, i * 3 + 1, (try bytes.get_i32(b)) as i64 as u64)
        rt.st64((*h).meta, i * 3 + 2, (try bytes.get_u16(b)) as u64)
        i = i + 1
    }
    return true
}

// Decodes the next column of the bulk into `c` (a fresh chunk_alloc). Error if none is left.
fn legacy8_bulk_next(b: *mut bytes.Bytes, h: *mut Legacy8Bulk, sc: *mut Scratch, c: *mut Chunk) -> BytesError!bool {
    let i: usize = (*h).next
    if i >= (*h).n {
        return BytesError::Range
    }
    (*h).next = i + 1
    let x: i32 = rt.ld64((*h).meta, i * 3) as i64 as i32
    let z: i32 = rt.ld64((*h).meta, i * 3 + 1) as i64 as i32
    let mask: i32 = rt.ld64((*h).meta, i * 3 + 2) as i32
    let len: usize = legacy8_data_len(mask, true, (*h).sky)
    if len > bytes.bytes_remaining(b) {
        return BytesError::Underflow
    }
    let dp: u64 = try bytes.get_span(b, len)
    var data: bytes.Bytes = bytes.Bytes { data: dp, cap: len, len: len, pos: 0, bad: false }
    return try legacy8_column(&data, x, z, mask, true, (*h).sky, sc, c)
}

// true when every column was decoded and the packet is consumed exactly
fn legacy8_bulk_complete(b: *mut bytes.Bytes, h: *mut Legacy8Bulk) -> bool {
    return (*h).next == (*h).n && bytes.bytes_remaining(b) == 0
}

fn legacy8_bulk_free(h: *mut Legacy8Bulk) {
    if (*h).meta != 0 {
        rt.heap_free((*h).meta, (*h).n * 3 * 8)
    }
    (*h).meta = 0
    (*h).n = 0
    (*h).next = 0
}
