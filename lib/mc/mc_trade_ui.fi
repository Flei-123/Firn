import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_gui_tex
import mc.mc_item_src
import mc.mc_hud_vfont
import mc.mc_inv_ui
import mc.mc_trade

export {
    TradeUi, tui_new, tui_free, tui_open, tui_ok, tui_row_hit, tui_item_xy, tui_item_at, tui_scroller_hit, tui_scroll_from_y, tui_draw,
    TUI_COST_A, TUI_COST_B, TUI_RESULT, TUI_LEVEL_COUNT,
}

const TUI_COST_A: i32 = 0
const TUI_COST_B: i32 = 1
const TUI_RESULT: i32 = 2
const TUI_LEVEL_COUNT: i32 = 5
const PART_SCROLLER: usize = 0
const PART_SCROLLER_OFF: usize = 1
const PART_OUT_OF_STOCK: usize = 2
const PART_ARROW: usize = 3
const PART_ARROW_OFF: usize = 4
const PART_XP_BG: usize = 5
const PART_XP_CUR: usize = 6
const PART_XP_RES: usize = 7
const PART_COUNT: usize = 8
const LIST_X: i32 = 5
const LIST_Y: i32 = 17
const ROW_W: i32 = 88
const ROW_H: i32 = 20
const ITEM_DY: i32 = 2
const SCROLL_X: i32 = 94
const SCROLL_Y: i32 = 18
const SCROLL_H: i32 = 139
const SCROLL_W: i32 = 6
const SCROLL_KNOB: i32 = 27
const XP_X: i32 = 136
const XP_Y: i32 = 16
const XP_W: i32 = 100
const CROSS_X: i32 = 182
const CROSS_Y: i32 = 35
const ARROW_X: i32 = 60
const ARROW_DY: i32 = 3
const TEXT_DARK: u32 = 0xFF404040
const WHITE: u32 = 0xFFFFFFFF
const SHEET: str = "assets/minecraft/textures/gui/container/villager2.png"
const SPRITE_DIR: str = "assets/minecraft/textures/gui/sprites/container/villager/"

struct TradeUi {
    part: [mc_gui_tex.GuiTex; 8],
    loaded: bool,
    buf: rt.Buf,
}

fn tui_new() -> TradeUi {
    return TradeUi { part: [mc_gui_tex.gtex_empty(); 8], loaded: false, buf: rt.buf_new() }
}

fn tui_free(u: *mut TradeUi) {
    var k: usize = 0
    while k < PART_COUNT {
        mc_gui_tex.gtex_free(&(*u).part[k])
        k = k + 1
    }
    rt.buf_free(&(*u).buf)
    (*u).loaded = false
}

fn tui_ok(u: *mut TradeUi) -> bool { return (*u).loaded }

fn crop(sheet: *mut mc_gui_tex.GuiTex, x: i32, y: i32, w: i32, h: i32, out: *mut mc_gui_tex.GuiTex) -> bool {
    if !mc_gui_tex.gtex_blank(out, w, h) { return false }
    var j: i32 = 0
    while j < h {
        var i: i32 = 0
        while i < w {
            mc_gui_tex.gtex_set(out, i, j, mc_gui_tex.gtex_get(sheet, x + i, y + j))
            i = i + 1
        }
        j = j + 1
    }
    return true
}

fn open_sheet(u: *mut TradeUi, sheet: *mut mc_gui_tex.GuiTex) -> bool {
    var ok: bool = crop(sheet, 0, 199, 6, 27, &(*u).part[PART_SCROLLER])
    ok = ok && crop(sheet, 6, 199, 6, 27, &(*u).part[PART_SCROLLER_OFF])
    ok = ok && crop(sheet, 311, 0, 28, 21, &(*u).part[PART_OUT_OF_STOCK])
    ok = ok && crop(sheet, 15, 171, 10, 9, &(*u).part[PART_ARROW])
    ok = ok && crop(sheet, 25, 171, 10, 9, &(*u).part[PART_ARROW_OFF])
    ok = ok && crop(sheet, 0, 186, 102, 5, &(*u).part[PART_XP_BG])
    ok = ok && crop(sheet, 0, 191, 102, 5, &(*u).part[PART_XP_CUR])
    ok = ok && crop(sheet, 2, 182, 100, 3, &(*u).part[PART_XP_RES])
    return ok
}

fn load_sprite(src: *mut mc_item_src.ItemSrc, name: str, out: *mut mc_gui_tex.GuiTex) -> bool {
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, SPRITE_DIR.p as u64, SPRITE_DIR.n)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push_bytes(&path, ".png".p as u64, 4)
    let ok: bool = mc_item_src.isrc_tex_full(src, rt.buf_ptr(&path), rt.buf_len(&path), out)
    rt.buf_free(&path)
    return ok
}

fn open_sprites(u: *mut TradeUi, src: *mut mc_item_src.ItemSrc) -> bool {
    var ok: bool = load_sprite(src, "scroller", &(*u).part[PART_SCROLLER])
    ok = ok && load_sprite(src, "scroller_disabled", &(*u).part[PART_SCROLLER_OFF])
    ok = ok && load_sprite(src, "out_of_stock", &(*u).part[PART_OUT_OF_STOCK])
    ok = ok && load_sprite(src, "trade_arrow", &(*u).part[PART_ARROW])
    ok = ok && load_sprite(src, "trade_arrow_out_of_stock", &(*u).part[PART_ARROW_OFF])
    ok = ok && load_sprite(src, "experience_bar_background", &(*u).part[PART_XP_BG])
    ok = ok && load_sprite(src, "experience_bar_current", &(*u).part[PART_XP_CUR])
    var full: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    if ok && load_sprite(src, "experience_bar_result", &full) {
        ok = crop(&full, 1, 1, 100, 3, &(*u).part[PART_XP_RES])
    } else {
        ok = false
    }
    mc_gui_tex.gtex_free(&full)
    return ok
}

fn tui_open(u: *mut TradeUi, src: *mut mc_item_src.ItemSrc) -> bool {
    var sheet: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    var ok: bool = false
    if mc_item_src.isrc_tex_full(src, SHEET.p as u64, SHEET.n, &sheet) && sheet.w >= 340 && sheet.h >= 200 {
        ok = open_sheet(u, &sheet)
    } else {
        ok = open_sprites(u, src)
    }
    mc_gui_tex.gtex_free(&sheet)
    if !ok { tui_free(u) }
    (*u).loaded = ok
    return ok
}

fn tui_item_xy(row: i32, which: i32, x: *mut i32, y: *mut i32) {
    *y = LIST_Y + ITEM_DY + row * ROW_H
    if which == TUI_COST_A { *x = LIST_X + 5 }
    if which == TUI_COST_B { *x = LIST_X + 35 }
    if which == TUI_RESULT { *x = LIST_X + 68 }
}

fn tui_row_hit(px: i32, py: i32, s: i32, mx: i32, my: i32) -> i32 {
    let gx: i32 = px + LIST_X * s
    let gy: i32 = py + LIST_Y * s
    if mx < gx || mx >= gx + ROW_W * s || my < gy || my >= gy + mc_trade.TR_ROWS * ROW_H * s { return 0 - 1 }
    return (my - gy) / (ROW_H * s)
}

fn tui_item_at(px: i32, py: i32, s: i32, mx: i32, my: i32, rows: i32) -> i32 {
    var row: i32 = 0
    while row < rows {
        var which: i32 = 0
        while which < 3 {
            var x: i32 = 0
            var y: i32 = 0
            tui_item_xy(row, which, &x, &y)
            let gx: i32 = px + x * s
            let gy: i32 = py + y * s
            if mx >= gx && my >= gy && mx < gx + 16 * s && my < gy + 16 * s { return row * 3 + which }
            which = which + 1
        }
        row = row + 1
    }
    return 0 - 1
}

fn tui_scroller_hit(px: i32, py: i32, s: i32, mx: i32, my: i32) -> bool {
    return mx >= px + SCROLL_X * s && mx < px + (SCROLL_X + SCROLL_W) * s && my >= py + SCROLL_Y * s && my < py + (SCROLL_Y + SCROLL_H) * s
}

fn tui_scroll_from_y(t: *mut mc_trade.Trades, py: i32, s: i32, my: i32) {
    let mx: i32 = mc_trade.tr_max_scroll(t)
    if mx <= 0 { return }
    var rel: i32 = (my - py - SCROLL_Y * s - (SCROLL_KNOB * s) / 2) * 1000 / ((SCROLL_H - SCROLL_KNOB) * s)
    if rel < 0 { rel = 0 }
    if rel > 1000 { rel = 1000 }
    mc_trade.tr_set_scroll(t, (rel * mx + 500) / 1000)
}

fn blit(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, px: i32, py: i32, s: i32, x: i32, y: i32, w: i32, h: i32) {
    if w <= 0 || h <= 0 { return }
    mc_gui_tex.gtex_draw(r, t, px + x * s, py + y * s, w * s, h * s, 0, 0, w, h, WHITE)
}

fn rect(r: *mut mc_raster.Raster, px: i32, py: i32, s: i32, x: i32, y: i32, w: i32, h: i32, c: u32) {
    mc_hud.hud_rect(r, px + x * s, py + y * s, w * s, h * s, c)
}

fn draw_row_button(r: *mut mc_raster.Raster, px: i32, py: i32, s: i32, row: i32, hover: bool, selected: bool) {
    let x: i32 = LIST_X
    let y: i32 = LIST_Y + row * ROW_H
    var border: u32 = 0xFF000000
    var fill: u32 = 0xFF6F6F6F
    var high: u32 = 0xFFAAAAAA
    var shade: u32 = 0xFF515151
    if hover {
        border = 0xFFFFFFFF
        fill = 0xFF757575
        high = 0xFFAFAFAF
        shade = 0xFF565656
    }
    if selected {
        border = 0xFF000000
        fill = 0xFF2C2C2C
        high = 0xFF2F2F2F
        shade = 0xFF282828
    }
    rect(r, px, py, s, x, y, ROW_W, ROW_H, border)
    rect(r, px, py, s, x + 1, y + 1, ROW_W - 2, ROW_H - 2, fill)
    rect(r, px, py, s, x + 1, y + 1, ROW_W - 2, 1, high)
    rect(r, px, py, s, x + 1, y + ROW_H - 3, ROW_W - 2, 2, shade)
}

fn xp_min(level: i32) -> i32 {
    if level <= 1 { return 0 }
    if level == 2 { return 10 }
    if level == 3 { return 70 }
    if level == 4 { return 150 }
    return 250
}

fn draw_scroller(r: *mut mc_raster.Raster, u: *mut TradeUi, t: *mut mc_trade.Trades, px: i32, py: i32, s: i32) {
    let n: i32 = mc_trade.tr_count(t)
    let k: i32 = n + 1 - mc_trade.TR_ROWS
    if k > 1 {
        let l: i32 = SCROLL_H - (SCROLL_KNOB + (k - 1) * SCROLL_H / k)
        let m: i32 = 1 + l / k + SCROLL_H / k
        var o: i32 = mc_trade.tr_scroll(t) * m
        if o > 113 { o = 113 }
        if mc_trade.tr_scroll(t) == k - 1 { o = 113 }
        blit(r, &(*u).part[PART_SCROLLER], px, py, s, SCROLL_X, SCROLL_Y + o, SCROLL_W, SCROLL_KNOB)
    } else {
        blit(r, &(*u).part[PART_SCROLLER_OFF], px, py, s, SCROLL_X, SCROLL_Y, SCROLL_W, SCROLL_KNOB)
    }
}

fn draw_progress(r: *mut mc_raster.Raster, u: *mut TradeUi, t: *mut mc_trade.Trades, px: i32, py: i32, s: i32) {
    let level: i32 = mc_trade.tr_level(t)
    if !mc_trade.tr_regular(t) || level < 1 || level >= TUI_LEVEL_COUNT { return }
    blit(r, &(*u).part[PART_XP_BG], px, py, s, XP_X, XP_Y, 102, 5)
    let lo: i32 = xp_min(level)
    let xp: i32 = mc_trade.tr_xp(t)
    if xp < lo { return }
    let span: i32 = xp_min(level + 1) - lo
    var o: i32 = (XP_W * (xp - lo)) / span
    if o > XP_W { o = XP_W }
    mc_gui_tex.gtex_draw(r, &(*u).part[PART_XP_CUR], px + XP_X * s, py + XP_Y * s, (o + 1) * s, 5 * s, 0, 0, o + 1, 5, WHITE)
    let fut: i32 = mc_trade.tr_trade_xp(t, mc_trade.tr_selected(t))
    if fut <= 0 { return }
    var q: i32 = (XP_W * fut) / span
    if q > XP_W - o { q = XP_W - o }
    if q > 0 { mc_gui_tex.gtex_draw(r, &(*u).part[PART_XP_RES], px + (XP_X + o + 1) * s, py + (XP_Y + 1) * s, q * s, 3 * s, 0, 0, q, 3, WHITE) }
}

fn level_name(level: i32) -> str {
    if level == 1 { return "Novice" }
    if level == 2 { return "Apprentice" }
    if level == 3 { return "Journeyman" }
    if level == 4 { return "Expert" }
    return "Master"
}

fn draw_titles(r: *mut mc_raster.Raster, u: *mut TradeUi, t: *mut mc_trade.Trades, px: i32, py: i32, s: i32, tp: u64, tn: usize) {
    rt.buf_clear(&(*u).buf)
    var base: str = "Villager"
    if tn > 0 { base = str { p: tp as *u8, n: tn } }
    rt.buf_push_bytes(&(*u).buf, base.p as u64, base.n)
    let level: i32 = mc_trade.tr_level(t)
    if mc_trade.tr_regular(t) && level >= 1 && level <= TUI_LEVEL_COUNT {
        rt.buf_push_bytes(&(*u).buf, " - ".p as u64, 3)
        let name: str = level_name(level)
        rt.buf_push_bytes(&(*u).buf, name.p as u64, name.n)
    }
    let title: str = rt.buf_str(&(*u).buf)
    let w: i32 = mc_hud_vfont.vtext_width(title.p as u64, 0 as u64, 0, title.length())
    mc_inv_ui.iui_text(r, px + (49 + 276 / 2 - w / 2) * s, py + 6 * s, s, title, TEXT_DARK, false)
    let label: str = "Trades"
    let lw: i32 = mc_hud_vfont.vtext_width(label.p as u64, 0 as u64, 0, label.length())
    mc_inv_ui.iui_text(r, px + (5 - lw / 2 + 48) * s, py + 6 * s, s, label, TEXT_DARK, false)
}

fn tui_draw(r: *mut mc_raster.Raster, u: *mut TradeUi, t: *mut mc_trade.Trades, px: i32, py: i32, s: i32, mx: i32, my: i32, tp: u64, tn: usize) {
    draw_titles(r, u, t, px, py, s, tp, tn)
    if !(*u).loaded || mc_trade.tr_count(t) <= 0 { return }
    let hover: i32 = tui_row_hit(px, py, s, mx, my)
    let rows: i32 = mc_trade.tr_visible(t)
    var row: i32 = 0
    while row < rows {
        let idx: i32 = mc_trade.tr_index_of_row(t, row)
        draw_row_button(r, px, py, s, row, row == hover, idx == mc_trade.tr_selected(t))
        var ax: i32 = 0
        var ay: i32 = 0
        tui_item_xy(row, TUI_COST_A, &ax, &ay)
        var part: usize = PART_ARROW
        if mc_trade.tr_out_of_stock(t, idx) { part = PART_ARROW_OFF }
        blit(r, &(*u).part[part], px, py, s, ARROW_X, ay + ARROW_DY, 10, 9)
        row = row + 1
    }
    draw_scroller(r, u, t, px, py, s)
    draw_progress(r, u, t, px, py, s)
    if mc_trade.tr_out_of_stock(t, mc_trade.tr_selected(t)) { blit(r, &(*u).part[PART_OUT_OF_STOCK], px, py, s, CROSS_X, CROSS_Y, 28, 21) }
}
