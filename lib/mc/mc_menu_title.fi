import std.rt
import std.env
import std.math
import mc.mc_raster
import mc.mc_gui_tex
import mc.mc_gui_font
import mc.mc_gui_pack
import mc.mc_gui_ui
import mc.mc_panorama

export {
    TitleState, title_new, title_free, title_pick_splash, title_frame, title_splash_scale,
    ACT_NONE, ACT_SINGLE, ACT_MULTI, ACT_REALMS, ACT_OPTIONS, ACT_QUIT, ACT_LANGUAGE, ACT_ACCESS,
}

const ACT_NONE: i32 = 0
const ACT_SINGLE: i32 = 1
const ACT_MULTI: i32 = 2
const ACT_REALMS: i32 = 3
const ACT_OPTIONS: i32 = 4
const ACT_QUIT: i32 = 5
const ACT_LANGUAGE: i32 = 6
const ACT_ACCESS: i32 = 7
const ICON_V_LANGUAGE: i32 = 106
const ICON_STEP: i32 = 20
const SPLASH_COLOR: u32 = 0xFFFF00
const SPLASH_DEG: f64 = 0.3490658503988659
const LOGO_W: i32 = 256
const LOGO_H: i32 = 44
const EDITION_W: i32 = 128
const EDITION_H: i32 = 14
const TWO_PI: f64 = 6.283185307179586

struct TitleState {
    splash: rt.Buf,
    mask: mc_gui_tex.GuiTex,
    fixed_phase: bool,
}

fn title_new() -> TitleState {
    return TitleState { splash: rt.buf_new(), mask: mc_gui_tex.gtex_empty(), fixed_phase: false }
}

fn title_free(t: *mut TitleState) {
    rt.buf_free(&(*t).splash)
    mc_gui_tex.gtex_free(&(*t).mask)
}

fn title_pick_splash(t: *mut TitleState, pk: *mut mc_gui_pack.GuiPack, seed: u64) {
    rt.buf_clear(&(*t).splash)
    mc_gui_tex.gtex_free(&(*t).mask)
    if env.has("MCPLAY_MENU_SPLASH") && env.get("MCPLAY_MENU_SPLASH").length() > 0 {
        let s: str = env.get("MCPLAY_MENU_SPLASH")
        rt.buf_push_bytes(&(*t).splash, s.p as u64, s.length())
    } else {
        let p: u64 = rt.buf_ptr(&(*pk).splashes)
        let n: usize = rt.buf_len(&(*pk).splashes)
        var lines: usize = 0
        var i: usize = 0
        while i < n {
            if rt.ld8(p, i) == 10 as u8 { lines = lines + 1 }
            i = i + 1
        }
        if lines > 0 {
            var want: usize = (seed % (lines as u64)) as usize
            var start: usize = 0
            i = 0
            while i < n {
                if rt.ld8(p, i) == 10 as u8 {
                    if want == 0 {
                        var e: usize = i
                        if e > start && rt.ld8(p, e - 1) == 13 as u8 { e = e - 1 }
                        rt.buf_push_bytes(&(*t).splash, p + start as u64, e - start)
                        break
                    }
                    want = want - 1
                    start = i + 1
                }
                i = i + 1
            }
        }
    }
    if rt.buf_len(&(*t).splash) > 0 {
        mc_gui_font.gfont_mask(&(*pk).font, mc_gui_ui.abgr(SPLASH_COLOR), rt.buf_ptr(&(*t).splash), rt.buf_len(&(*t).splash), &(*t).mask)
    }
}

fn title_splash_scale(text_w: i32, phase_ms: u64, fixed: bool) -> f64 {
    var f: f64 = 1.8
    if !fixed {
        var sv: f64 = math.sin(((phase_ms % 1000 as u64) as f64) / 1000.0 * TWO_PI) * 0.1
        if sv < 0.0 { sv = 0.0 - sv }
        f = 1.8 - sv
    }
    return f * 100.0 / ((text_w + 32) as f64)
}

fn draw_splash(u: *mut mc_gui_ui.Ui, t: *mut TitleState) {
    if !mc_gui_tex.gtex_ok(&(*t).mask) { return }
    let s: i32 = (*u).s
    let tw: i32 = (*t).mask.w - 1
    let f: f64 = title_splash_scale(tw, (*u).ms, (*t).fixed_phase)
    let ox: f64 = ((*u).uw / 2 + 90) as f64
    let oy: f64 = 70.0
    let cs: f64 = math.cos(SPLASH_DEG)
    let sn: f64 = 0.0 - math.sin(SPLASH_DEG)
    let half_w: f64 = ((tw as f64) * 0.5 + 1.0) * f
    let ext: f64 = half_w + 10.0 * f + 2.0
    var x0: i32 = ((ox - ext) * (s as f64)) as i32
    var x1: i32 = ((ox + ext) * (s as f64)) as i32 + 1
    var y0: i32 = ((oy - ext) * (s as f64)) as i32
    var y1: i32 = ((oy + ext) * (s as f64)) as i32 + 1
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    if x1 > (*(*u).r).w { x1 = (*(*u).r).w }
    if y1 > (*(*u).r).h { y1 = (*(*u).r).h }
    var py: i32 = y0
    while py < y1 {
        var px: i32 = x0
        while px < x1 {
            let dx: f64 = ((px as f64) + 0.5) / (s as f64) - ox
            let dy: f64 = ((py as f64) + 0.5) / (s as f64) - oy
            let lx: f64 = (dx * cs + dy * sn) / f
            let ly: f64 = (0.0 - dx * sn + dy * cs) / f
            let fx: f64 = lx + (tw as f64) * 0.5
            let fy: f64 = ly + 8.0
            if fx >= 0.0 && fy >= 0.0 {
                mc_gui_tex.gtex_blend((*u).r, px, py, mc_gui_tex.gtex_get(&(*t).mask, fx as i32, fy as i32))
            }
            px = px + 1
        }
        py = py + 1
    }
}

fn icon_button(u: *mut mc_gui_ui.Ui, x: i32, y: i32, tex: *mut mc_gui_tex.GuiTex, v: i32) -> bool {
    let hov: bool = mc_gui_ui.ui_hover(u, x, y, 20, 20)
    var vv: i32 = v
    if hov { vv = v + ICON_STEP }
    let s: i32 = (*u).s
    mc_gui_tex.gtex_draw((*u).r, tex, x * s, y * s, 20 * s, 20 * s, 0, vv, 20, 20, 0xFFFFFFFF as u32)
    return hov && (*u).pressed
}

fn title_frame(u: *mut mc_gui_ui.Ui, t: *mut TitleState, pan: *mut mc_panorama.Panorama, spin: f64) -> i32 {
    let r: *mut mc_raster.Raster = (*u).r
    let pk: *mut mc_gui_pack.GuiPack = (*u).pk
    let s: i32 = (*u).s
    if mc_panorama.pan_ok(pan) {
        mc_panorama.pan_render(r, pan, spin)
    } else {
        mc_gui_ui.ui_dirt(u, 0x404040)
    }
    let lx: i32 = ((*u).uw / 2 - LOGO_W / 2) * s
    mc_gui_tex.gtex_draw(r, &(*pk).logo, lx, 30 * s, LOGO_W * s, LOGO_H * s, 0, 0, (*pk).logo.w, (*pk).logo.h * LOGO_H / 64, 0xFFFFFFFF as u32)
    mc_gui_tex.gtex_draw(r, &(*pk).edition, ((*u).uw / 2 - EDITION_W / 2) * s, (30 + LOGO_H - 7) * s, EDITION_W * s, EDITION_H * s, 0, 0, (*pk).edition.w, (*pk).edition.h * EDITION_H / 16, 0xFFFFFFFF as u32)
    draw_splash(u, t)
    var act: i32 = ACT_NONE
    let cx: i32 = (*u).uw / 2 - 100
    let j: i32 = (*u).uh / 4 + 48
    if mc_gui_ui.ui_button(u, cx, j, 200, mc_gui_ui.ui_lang(u, "menu.singleplayer", "Singleplayer"), true) { act = ACT_SINGLE }
    if mc_gui_ui.ui_button(u, cx, j + 24, 200, mc_gui_ui.ui_lang(u, "menu.multiplayer", "Multiplayer"), true) { act = ACT_MULTI }
    if mc_gui_ui.ui_button(u, cx, j + 48, 200, mc_gui_ui.ui_lang(u, "menu.online", "Minecraft Realms"), true) { act = ACT_REALMS }
    if icon_button(u, (*u).uw / 2 - 124, j + 84, &(*pk).widgets, ICON_V_LANGUAGE) { act = ACT_LANGUAGE }
    if mc_gui_ui.ui_button(u, cx, j + 84, 98, mc_gui_ui.ui_lang(u, "menu.options", "Options..."), true) { act = ACT_OPTIONS }
    if mc_gui_ui.ui_button(u, (*u).uw / 2 + 2, j + 84, 98, mc_gui_ui.ui_lang(u, "menu.quit", "Quit Game"), true) { act = ACT_QUIT }
    var ver: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&ver, "Minecraft ".p as u64, 10)
    rt.buf_push_bytes(&ver, rt.buf_ptr(&(*pk).version), rt.buf_len(&(*pk).version))
    rt.buf_push_bytes(&ver, "/mcplay".p as u64, 7)
    mc_gui_ui.ui_label(u, 2, (*u).uh - 10, mc_gui_ui.COLOR_WHITE, rt.buf_str(&ver))
    rt.buf_free(&ver)
    let copy: str = "Copyright Mojang AB. Do not distribute!"
    mc_gui_ui.ui_label(u, (*u).uw - mc_gui_ui.ui_text_width(u, copy) - 2, (*u).uh - 10, mc_gui_ui.COLOR_WHITE, copy)
    return act
}
