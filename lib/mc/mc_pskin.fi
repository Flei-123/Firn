import std.rt
import mc.mc_gui_tex

export {
    Skin, skin_new, skin_free, skin_ok, skin_px, skin_from_png, skin_default_for, skin_set_slim, skin_is_slim,
    skin_fill_default, skin_average, SKIN_W, SKIN_H,
}

const SKIN_W: i32 = 64
const SKIN_H: i32 = 64
const OPAQUE: u32 = 0xFF000000

struct Skin {
    t: mc_gui_tex.GuiTex,
    slim: bool,
}

fn skin_new() -> Skin {
    return Skin { t: mc_gui_tex.gtex_empty(), slim: false }
}

fn skin_free(s: *mut Skin) {
    mc_gui_tex.gtex_free(&(*s).t)
}

fn skin_ok(s: *mut Skin) -> bool {
    return (*s).t.w == SKIN_W && (*s).t.h == SKIN_H
}

fn skin_set_slim(s: *mut Skin, slim: bool) { (*s).slim = slim }

fn skin_is_slim(s: *mut Skin) -> bool { return (*s).slim }

fn skin_px(s: *mut Skin, x: i32, y: i32) -> u32 {
    return mc_gui_tex.gtex_get(&(*s).t, x, y)
}

fn copy_rect(s: *mut Skin, sx: i32, sy: i32, dx: i32, dy: i32, w: i32, h: i32, flip: bool) {
    var j: i32 = 0
    while j < h {
        var i: i32 = 0
        while i < w {
            var fx: i32 = i
            if flip { fx = w - 1 - i }
            mc_gui_tex.gtex_set(&(*s).t, dx + i, dy + j, mc_gui_tex.gtex_get(&(*s).t, sx + fx, sy + j))
            i = i + 1
        }
        j = j + 1
    }
}

fn mirror_box(s: *mut Skin, u: i32, v: i32, w: i32, h: i32, d: i32, du: i32, dv: i32) {
    copy_rect(s, u + d, v, du + d, dv, w, d, true)
    copy_rect(s, u + d + w, v, du + d + w, dv, w, d, true)
    copy_rect(s, u + d, v + d, du + d, dv + d, w, h, true)
    copy_rect(s, u + d + w + d, v + d, du + d + w + d, dv + d, w, h, true)
    copy_rect(s, u + d + w, v + d, du, dv + d, d, h, true)
    copy_rect(s, u, v + d, du + d + w, dv + d, d, h, true)
}

fn force_opaque(s: *mut Skin, x0: i32, y0: i32, x1: i32, y1: i32) {
    var y: i32 = y0
    while y < y1 {
        var x: i32 = x0
        while x < x1 {
            mc_gui_tex.gtex_set(&(*s).t, x, y, mc_gui_tex.gtex_get(&(*s).t, x, y) | OPAQUE)
            x = x + 1
        }
        y = y + 1
    }
}

fn skin_from_png(s: *mut Skin, data: u64, n: usize) -> bool {
    var src: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    if !mc_gui_tex.gtex_from_png(data, n, &src) { return false }
    let w: i32 = src.w
    let h: i32 = src.h
    let legacy: bool = w > 0 && h * 2 == w
    let square: bool = w > 0 && h == w
    if !legacy && !square || w < 64 || w % 64 != 0 {
        mc_gui_tex.gtex_free(&src)
        return false
    }
    let scale: i32 = w / 64
    skin_free(s)
    if !mc_gui_tex.gtex_blank(&(*s).t, SKIN_W, SKIN_H) {
        mc_gui_tex.gtex_free(&src)
        return false
    }
    var rows: i32 = SKIN_H
    if legacy { rows = 32 }
    var y: i32 = 0
    while y < rows {
        var x: i32 = 0
        while x < SKIN_W {
            mc_gui_tex.gtex_set(&(*s).t, x, y, mc_gui_tex.gtex_get(&src, x * scale, y * scale))
            x = x + 1
        }
        y = y + 1
    }
    mc_gui_tex.gtex_free(&src)
    if legacy {
        mirror_box(s, 40, 16, 4, 12, 4, 32, 48)
        mirror_box(s, 0, 16, 4, 12, 4, 16, 48)
        force_opaque(s, 0, 0, 32, 32)
        force_opaque(s, 0, 16, 64, 32)
        force_opaque(s, 16, 48, 48, 64)
        force_opaque(s, 32, 48, 64, 64)
    }
    return true
}

fn pack(r: i32, g: i32, b: i32) -> u32 {
    return OPAQUE | ((b as u32) << 16 as u32) | ((g as u32) << 8 as u32) | (r as u32)
}

fn fill(s: *mut Skin, x0: i32, y0: i32, w: i32, h: i32, c: u32) {
    var j: i32 = 0
    while j < h {
        var i: i32 = 0
        while i < w {
            mc_gui_tex.gtex_set(&(*s).t, x0 + i, y0 + j, c)
            i = i + 1
        }
        j = j + 1
    }
}

fn paint_box(s: *mut Skin, u: i32, v: i32, w: i32, h: i32, d: i32, c: u32) {
    fill(s, u, v, 2 * (w + d), d, 0 as u32)
    fill(s, u + d, v, 2 * w, d, c)
    fill(s, u, v + d, 2 * (w + d), h, c)
}

fn skin_fill_default(s: *mut Skin, slim: bool) {
    skin_free(s)
    mc_gui_tex.gtex_blank(&(*s).t, SKIN_W, SKIN_H)
    (*s).slim = slim
    let skin: u32 = pack(198, 142, 108)
    let hair: u32 = pack(68, 45, 24)
    let shirt: u32 = pack(0, 165, 165)
    let pants: u32 = pack(60, 60, 150)
    let shoe: u32 = pack(90, 90, 90)
    var aw: i32 = 4
    if slim { aw = 3 }
    paint_box(s, 0, 0, 8, 8, 8, skin)
    fill(s, 8, 0, 8, 2, hair)
    fill(s, 0, 8, 32, 2, hair)
    fill(s, 9, 12, 2, 1, pack(255, 255, 255))
    fill(s, 13, 12, 2, 1, pack(255, 255, 255))
    fill(s, 10, 12, 1, 1, pack(60, 40, 120))
    fill(s, 13, 12, 1, 1, pack(60, 40, 120))
    fill(s, 11, 14, 2, 1, pack(150, 90, 70))
    paint_box(s, 16, 16, 8, 12, 4, shirt)
    paint_box(s, 40, 16, aw, 12, 4, skin)
    fill(s, 40, 20, 4 * 2 + aw * 2, 4, shirt)
    paint_box(s, 32, 48, aw, 12, 4, skin)
    fill(s, 32, 52, 4 * 2 + aw * 2, 4, shirt)
    paint_box(s, 0, 16, 4, 12, 4, pants)
    paint_box(s, 16, 48, 4, 12, 4, pants)
    fill(s, 0, 26, 16, 2, shoe)
    fill(s, 16, 58, 16, 2, shoe)
}

fn skin_default_for(s: *mut Skin, hi: u64, lo: u64) {
    let h: u64 = hi ^ lo
    let fold: u64 = (h ^ (h >> 32 as u64)) & 1 as u64
    skin_fill_default(s, fold != 0 as u64)
}

fn skin_average(s: *mut Skin, x0: i32, y0: i32, w: i32, h: i32) -> u32 {
    var r: i32 = 0
    var g: i32 = 0
    var b: i32 = 0
    var n: i32 = 0
    var j: i32 = 0
    while j < h {
        var i: i32 = 0
        while i < w {
            let c: u32 = skin_px(s, x0 + i, y0 + j)
            if (c >> 24 as u32) >= 128 as u32 {
                r = r + ((c & 255 as u32) as i32)
                g = g + (((c >> 8 as u32) & 255 as u32) as i32)
                b = b + (((c >> 16 as u32) & 255 as u32) as i32)
                n = n + 1
            }
            i = i + 1
        }
        j = j + 1
    }
    if n == 0 { return pack(128, 128, 128) }
    return pack(r / n, g / n, b / n)
}
