// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    ServerList, sl_new, sl_free, sl_clear, sl_copy, sl_count, sl_ptr, sl_len, sl_find, sl_add, sl_remove, sl_host, sl_port,
    sl_load, sl_text, SERVERS_MAX,
}

const SERVERS_MAX: i32 = 8
const ENTRY_MAX: usize = 21

struct ServerList {
    lines: rt.Buf,
    count: i32,
}

fn sl_new() -> ServerList {
    return ServerList { lines: rt.buf_new(), count: 0 }
}

fn sl_free(l: *mut ServerList) {
    rt.buf_free(&(*l).lines)
}

fn sl_clear(l: *mut ServerList) {
    rt.buf_clear(&(*l).lines)
    (*l).count = 0
}

fn sl_copy(dst: *mut ServerList, src: *mut ServerList) {
    sl_clear(dst)
    rt.buf_push_bytes(&(*dst).lines, rt.buf_ptr(&(*src).lines), rt.buf_len(&(*src).lines))
    (*dst).count = (*src).count
}

fn sl_count(l: *mut ServerList) -> i32 {
    return (*l).count
}

fn entry_start(l: *mut ServerList, i: i32) -> usize {
    let p: u64 = rt.buf_ptr(&(*l).lines)
    let n: usize = rt.buf_len(&(*l).lines)
    var s: usize = 0
    var k: i32 = 0
    while k < i && s < n {
        if rt.ld8(p, s) == 10 as u8 { k = k + 1 }
        s = s + 1
    }
    return s
}

fn sl_len(l: *mut ServerList, i: i32) -> usize {
    if i < 0 || i >= (*l).count { return 0 }
    let p: u64 = rt.buf_ptr(&(*l).lines)
    let n: usize = rt.buf_len(&(*l).lines)
    let s: usize = entry_start(l, i)
    var e: usize = s
    while e < n && rt.ld8(p, e) != 10 as u8 { e = e + 1 }
    return e - s
}

fn sl_ptr(l: *mut ServerList, i: i32) -> u64 {
    return rt.buf_ptr(&(*l).lines) + entry_start(l, i) as u64
}

fn push_key(out: *mut rt.Buf, hp: u64, hn: usize, port: i32) {
    rt.buf_push_bytes(out, hp, hn)
    rt.buf_push(out, 58 as u8)
    rt.buf_push_dec_i64(out, port as i64)
}

fn same_bytes(a: u64, b: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if rt.ld8(a, i) != rt.ld8(b, i) { return false }
        i = i + 1
    }
    return true
}

fn sl_find(l: *mut ServerList, hp: u64, hn: usize, port: i32) -> i32 {
    var key: rt.Buf = rt.buf_new()
    push_key(&key, hp, hn, port)
    var found: i32 = 0 - 1
    var i: i32 = 0
    while i < (*l).count && found < 0 {
        if sl_len(l, i) == rt.buf_len(&key) && same_bytes(sl_ptr(l, i), rt.buf_ptr(&key), rt.buf_len(&key)) { found = i }
        i = i + 1
    }
    rt.buf_free(&key)
    return found
}

fn sl_remove(l: *mut ServerList, idx: i32) -> bool {
    if idx < 0 || idx >= (*l).count { return false }
    var old: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&old, rt.buf_ptr(&(*l).lines), rt.buf_len(&(*l).lines))
    let op: u64 = rt.buf_ptr(&old)
    let on: usize = rt.buf_len(&old)
    let s: usize = entry_start(l, idx)
    let e: usize = s + sl_len(l, idx) + 1
    rt.buf_clear(&(*l).lines)
    rt.buf_push_bytes(&(*l).lines, op, s)
    if e < on { rt.buf_push_bytes(&(*l).lines, op + e as u64, on - e) }
    (*l).count = (*l).count - 1
    rt.buf_free(&old)
    return true
}

fn sl_add(l: *mut ServerList, hp: u64, hn: usize, port: i32) -> bool {
    if hn == 0 || port <= 0 || port > 65535 { return false }
    let at: i32 = sl_find(l, hp, hn, port)
    if at >= 0 { sl_remove(l, at) }
    var old: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&old, rt.buf_ptr(&(*l).lines), rt.buf_len(&(*l).lines))
    rt.buf_clear(&(*l).lines)
    push_key(&(*l).lines, hp, hn, port)
    rt.buf_push(&(*l).lines, 10 as u8)
    rt.buf_push_bytes(&(*l).lines, rt.buf_ptr(&old), rt.buf_len(&old))
    (*l).count = (*l).count + 1
    rt.buf_free(&old)
    while (*l).count > SERVERS_MAX { sl_remove(l, (*l).count - 1) }
    return true
}

fn sl_host(l: *mut ServerList, i: i32, out: *mut rt.Buf) {
    let n: usize = sl_len(l, i)
    let p: u64 = sl_ptr(l, i)
    var k: usize = 0
    while k < n && rt.ld8(p, k) != 58 as u8 { k = k + 1 }
    rt.buf_push_bytes(out, p, k)
}

fn sl_port(l: *mut ServerList, i: i32) -> i32 {
    let n: usize = sl_len(l, i)
    let p: u64 = sl_ptr(l, i)
    var k: usize = 0
    while k < n && rt.ld8(p, k) != 58 as u8 { k = k + 1 }
    var v: i32 = 0
    k = k + 1
    while k < n {
        v = v * 10 + (rt.ld8(p, k) as i32 - 48)
        k = k + 1
    }
    return v
}

fn entry_ok(p: u64, n: usize) -> bool {
    if n < 3 || n > ENTRY_MAX { return false }
    var colons: i32 = 0
    var after: i32 = 0
    var before: i32 = 0
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 58 as u8 {
            colons = colons + 1
        } else if c >= 48 as u8 && c <= 57 as u8 {
            if colons == 0 { before = before + 1 } else { after = after + 1 }
        } else if c != 46 as u8 || colons > 0 {
            return false
        }
        i = i + 1
    }
    return colons == 1 && before > 0 && after > 0 && after <= 5
}

fn sl_load(p: u64, n: usize, l: *mut ServerList) {
    sl_clear(l)
    var i: usize = 0
    while i < n {
        var e: usize = i
        while e < n && rt.ld8(p, e) != 10 as u8 { e = e + 1 }
        var end: usize = e
        if end > i && rt.ld8(p, end - 1) == 13 as u8 { end = end - 1 }
        if end - i > 7 && rt.ld8(p, i) == 115 as u8 && rt.ld8(p, i + 1) == 101 as u8 && rt.ld8(p, i + 2) == 114 as u8 && rt.ld8(p, i + 3) == 118 as u8 && rt.ld8(p, i + 4) == 101 as u8 && rt.ld8(p, i + 5) == 114 as u8 && rt.ld8(p, i + 6) == 61 as u8 {
            let vp: u64 = p + (i + 7) as u64
            let vn: usize = end - i - 7
            if entry_ok(vp, vn) && (*l).count < SERVERS_MAX {
                var dup: bool = false
                var k: i32 = 0
                while k < (*l).count {
                    if sl_len(l, k) == vn && same_bytes(sl_ptr(l, k), vp, vn) { dup = true }
                    k = k + 1
                }
                if !dup {
                    rt.buf_push_bytes(&(*l).lines, vp, vn)
                    rt.buf_push(&(*l).lines, 10 as u8)
                    (*l).count = (*l).count + 1
                }
            }
        }
        i = e + 1
    }
}

fn sl_text(l: *mut ServerList, out: *mut rt.Buf) {
    var i: i32 = 0
    while i < (*l).count {
        let tag: str = "server="
        rt.buf_push_bytes(out, tag.p as u64, tag.n)
        rt.buf_push_bytes(out, sl_ptr(l, i), sl_len(l, i))
        rt.buf_push(out, 10 as u8)
        i = i + 1
    }
}
