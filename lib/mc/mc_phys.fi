// SPDX-License-Identifier: MPL-2.0
import std.math

export {
    GRAVITY, FLY_BASE, VEL_CUTOFF, JUMP_DELAY_TICKS, SPRINT_TAP_TICKS, FLY_VERTICAL_STEP, FLY_Y_DRAG,
    mth_sin, mth_cos, yaw_sin, yaw_cos, impulse_axis, scale_impulse, move_relative, attr_speed, ground_speed,
    air_speed, fly_speed, drag_h, drag_y, jump_power, sprint_jump_boost, cutoff, gravity_step, minor_collision,
    enough_impulse, eye_smooth, lerp,
}

const GRAVITY: f64 = 0.08
const VEL_CUTOFF: f64 = 0.003
const JUMP_DELAY_TICKS: i32 = 10
const SPRINT_TAP_TICKS: i32 = 7
const FLY_Y_DRAG: f64 = 0.6
const FLY_BASE: f32 = 0.05f
const FLY_VERTICAL_STEP: f32 = 3.0f
const DRAG_Y: f32 = 0.98f
const BASE_DRAG: f32 = 0.91f
const INPUT_SCALE: f32 = 0.98f
const SNEAK_INPUT: f32 = 0.3f
const USE_ITEM_INPUT: f32 = 0.2f
const SPEED_ATTR: f64 = 0.10000000149011612
const SPRINT_MOD: f64 = 0.30000001192092896
const AIR_SPEED: f32 = 0.02f
const AIR_SPEED_SPRINT: f32 = 0.025999999f
const JUMP_BASE: f32 = 0.42f
const JUMP_BOOST_STEP: f32 = 0.1f
const SPRINT_JUMP_PUSH: f32 = 0.2f
const FRICTION_CUBE: f32 = 0.21600002f
const SIN_SCALE: f32 = 10430.378f
const DEG_TO_RAD: f32 = 0.017453292f
const SPRINT_MIN_IMPULSE: f32 = 0.8f
const MINOR_ANGLE: f64 = 0.13962634
const EYE_EASE: f64 = 0.5

fn mth_sin(x: f32) -> f32 {
    let i: i64 = (x * SIN_SCALE) as i64
    let idx: i64 = i & 65535
    return math.sin((idx as f64) * math.PI() * 2.0 / 65536.0) as f32
}

fn mth_cos(x: f32) -> f32 {
    let i: i64 = (x * SIN_SCALE + 16384.0f) as i64
    let idx: i64 = i & 65535
    return math.sin((idx as f64) * math.PI() * 2.0 / 65536.0) as f32
}

fn yaw_sin(yaw: f64) -> f64 {
    return mth_sin((yaw as f32) * DEG_TO_RAD) as f64
}

fn yaw_cos(yaw: f64) -> f64 {
    return mth_cos((yaw as f32) * DEG_TO_RAD) as f64
}

fn impulse_axis(positive: bool, negative: bool) -> f32 {
    if positive == negative { return 0.0f }
    if positive { return 1.0f }
    return 0.0f - 1.0f
}

fn scale_impulse(raw: f32, slow: bool, using_item: bool) -> f32 {
    var v: f32 = raw
    if slow { v = v * SNEAK_INPUT }
    if using_item { v = v * USE_ITEM_INPUT }
    return v * INPUT_SCALE
}

fn enough_impulse(forward_scaled_pre: f32, under_water: bool) -> bool {
    if under_water { return forward_scaled_pre > 0.00001f }
    return forward_scaled_pre >= SPRINT_MIN_IMPULSE
}

fn move_relative(vx: *mut f64, vz: *mut f64, strafe: f32, forward: f32, speed: f32, yaw: f64) {
    let x: f64 = strafe as f64
    let z: f64 = forward as f64
    let d0: f64 = x * x + z * z
    if d0 < 0.0000001 { return }
    var ix: f64 = x
    var iz: f64 = z
    if d0 > 1.0 {
        let d: f64 = math.sqrt(d0)
        if d < 0.00001 {
            ix = 0.0
            iz = 0.0
        } else {
            ix = x / d
            iz = z / d
        }
    }
    let s: f64 = speed as f64
    let ax: f64 = ix * s
    let az: f64 = iz * s
    let sn: f64 = yaw_sin(yaw)
    let cs: f64 = yaw_cos(yaw)
    *vx = *vx + (ax * cs - az * sn)
    *vz = *vz + (az * cs + ax * sn)
}

fn attr_speed(sprinting: bool) -> f32 {
    var v: f64 = SPEED_ATTR
    if sprinting { v = v * (1.0 + SPRINT_MOD) }
    return v as f32
}

fn ground_speed(sprinting: bool, friction: f32) -> f32 {
    return attr_speed(sprinting) * (FRICTION_CUBE / (friction * friction * friction))
}

fn air_speed(sprinting: bool) -> f32 {
    if sprinting { return AIR_SPEED_SPRINT }
    return AIR_SPEED
}

fn fly_speed(sprinting: bool) -> f32 {
    if sprinting { return FLY_BASE * 2.0f }
    return FLY_BASE
}

fn drag_h(on_ground: bool, friction: f32) -> f64 {
    if on_ground { return (friction * BASE_DRAG) as f64 }
    return BASE_DRAG as f64
}

fn drag_y() -> f64 {
    return DRAG_Y as f64
}

fn jump_power(factor: f32, boost_level: i32) -> f64 {
    var p: f32 = JUMP_BASE * factor
    if boost_level > 0 { p = p + JUMP_BOOST_STEP * (boost_level as f32) }
    return p as f64
}

fn sprint_jump_boost(vx: *mut f64, vz: *mut f64, yaw: f64) {
    let f: f32 = (yaw as f32) * DEG_TO_RAD
    *vx = *vx + ((0.0f - mth_sin(f)) * SPRINT_JUMP_PUSH) as f64
    *vz = *vz + (mth_cos(f) * SPRINT_JUMP_PUSH) as f64
}

fn cutoff(v: f64) -> f64 {
    if math.fabs(v) < VEL_CUTOFF { return 0.0 }
    return v
}

fn gravity_step(vy: f64) -> f64 {
    return (vy - GRAVITY) * (DRAG_Y as f64)
}

fn minor_collision(strafe: f32, forward: f32, yaw: f64, mx: f64, mz: f64) -> bool {
    let sn: f64 = yaw_sin(yaw)
    let cs: f64 = yaw_cos(yaw)
    let xa: f64 = strafe as f64
    let za: f64 = forward as f64
    let d2: f64 = xa * cs - za * sn
    let d3: f64 = za * cs + xa * sn
    let d4: f64 = d2 * d2 + d3 * d3
    let d5: f64 = mx * mx + mz * mz
    if d4 < 0.00001 || d5 < 0.00001 { return false }
    let d6: f64 = d2 * mx + d3 * mz
    let c: f64 = d6 / math.sqrt(d4 * d5)
    return math.atan2(math.sqrt(math.fmax(0.0, 1.0 - c * c)), c) < MINOR_ANGLE
}

fn eye_smooth(cur: f64, target: f64) -> f64 {
    return cur + (target - cur) * EYE_EASE
}

fn lerp(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}
