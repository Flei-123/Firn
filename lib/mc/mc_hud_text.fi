import mc.mc_raster
import mc.mc_hud
import mc.mc_hud_vfont
import mc.mc_fontmap

export { htext_width, htext_bytes, htext }

fn htext_width(p: u64, n: usize, scale: i32) -> i32 {
    if !mc_hud_vfont.vfont_ok() { return mc_hud.hud_text_width(n, scale) }
    var w: i32 = 0
    var i: usize = 0
    while i < n {
        var cp: u32 = 0 as u32
        i = i + mc_fontmap.fontmap_decode(p, n, i, &cp)
        w = w + mc_hud_vfont.vfont_adv(mc_fontmap.fontmap_glyph(cp), 0 as u32)
    }
    return w * scale
}

fn pass(r: *mut mc_raster.Raster, x: i32, y: i32, scale: i32, c: u32, p: u64, n: usize) {
    var pen: i32 = 0
    var i: usize = 0
    while i < n {
        var cp: u32 = 0 as u32
        i = i + mc_fontmap.fontmap_decode(p, n, i, &cp)
        pen = pen + mc_hud_vfont.vfont_glyph(r, x + pen * scale, y, scale, c, 0 as u32, mc_fontmap.fontmap_glyph(cp), 0 as u32)
    }
}

fn htext_bytes(r: *mut mc_raster.Raster, x: i32, y: i32, scale: i32, c: u32, shadow: u32, p: u64, n: usize) {
    if !mc_hud_vfont.vfont_ok() {
        mc_hud.hud_text_bytes(r, x, y, scale, c, shadow, p, n)
        return
    }
    if (shadow >> 24 as u32) != 0 as u32 { pass(r, x + scale, y + scale, scale, shadow, p, n) }
    pass(r, x, y, scale, c, p, n)
}

fn htext(r: *mut mc_raster.Raster, x: i32, y: i32, scale: i32, c: u32, shadow: u32, text: str) {
    htext_bytes(r, x, y, scale, c, shadow, text.p as u64, text.n)
}
