// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_text_nbt.fi -- text components sent as network NBT (1.20.3+, protocol 765) -> JSON -> mc_text.
//
//   text_from_nbt(&doc, p, n, &tr)    p/n = the anonymous NBT field (root tag octet + payload, no name); string, compound and list roots
//   nbt_to_json(&doc, node, &out, 0)  one NBT node as JSON text (byte -> true/false, arrays -> [])

import std.rt
import std.bytes
import std.nbt
import mc.mc_nbt
import mc.mc_text

export { text_from_nbt, nbt_to_json }

const MAX_NODE_DEPTH: i32 = 32

fn json_string(out: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push(out, 34)
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 34 as u8 || c == 92 as u8 {
            rt.buf_push(out, 92)
            rt.buf_push(out, c)
        } else if c < 32 as u8 {
            rt.buf_push(out, 92)
            rt.buf_push(out, 117)
            rt.buf_push(out, 48)
            rt.buf_push(out, 48)
            rt.buf_push_hex_u64(out, c as u64, 2)
        } else {
            rt.buf_push(out, c)
        }
        i = i + 1
    }
    rt.buf_push(out, 34)
}

fn push_lit(out: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(out, s.p as u64, s.n)
}

fn nbt_to_json(d: *mut mc_nbt.Doc, n: u32, out: *mut rt.Buf, depth: i32) {
    if depth > MAX_NODE_DEPTH {
        push_lit(out, "null")
        return
    }
    let k: u8 = mc_nbt.nbt_kind(d, n)
    if k == nbt.TAG_STRING {
        var l: usize = 0
        let p: u64 = mc_nbt.nbt_str(d, n, &l)
        json_string(out, p, l)
    } else if k == nbt.TAG_COMPOUND {
        rt.buf_push(out, 123)
        var c: u32 = mc_nbt.nbt_first(d, n)
        var first: bool = true
        while c != 0 as u32 {
            if !first { rt.buf_push(out, 44) }
            first = false
            var nl: usize = 0
            let np: u64 = mc_nbt.nbt_name(d, c, &nl)
            json_string(out, np, nl)
            rt.buf_push(out, 58)
            nbt_to_json(d, c, out, depth + 1)
            c = mc_nbt.nbt_next(d, c)
        }
        rt.buf_push(out, 125)
    } else if k == nbt.TAG_LIST {
        rt.buf_push(out, 91)
        var c: u32 = mc_nbt.nbt_first(d, n)
        var first: bool = true
        while c != 0 as u32 {
            if !first { rt.buf_push(out, 44) }
            first = false
            nbt_to_json(d, c, out, depth + 1)
            c = mc_nbt.nbt_next(d, c)
        }
        rt.buf_push(out, 93)
    } else if k == nbt.TAG_BYTE {
        if mc_nbt.nbt_i64(d, n) != 0 { push_lit(out, "true") } else { push_lit(out, "false") }
    } else if k >= nbt.TAG_SHORT && k <= nbt.TAG_LONG {
        rt.buf_push_dec_i64(out, mc_nbt.nbt_i64(d, n))
    } else if k == nbt.TAG_FLOAT || k == nbt.TAG_DOUBLE {
        push_lit(out, "0")
    } else {
        push_lit(out, "[]")
    }
}

fn text_from_nbt(t: *mut mc_text.TextDoc, p: u64, n: usize, tr: *mut mc_text.Translations) -> bool {
    if n < 1 { return false }
    let tag: u8 = rt.ld8(p, 0)
    if tag == 0 as u8 { return false }
    var wrapped: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&wrapped, 10 as u8)
    bytes.put_u8(&wrapped, tag)
    bytes.put_u16(&wrapped, 1 as u16)
    bytes.put_u8(&wrapped, 120 as u8)
    bytes.put_raw(&wrapped, p + 1 as u64, n - 1)
    bytes.put_u8(&wrapped, 0 as u8)
    var d: mc_nbt.Doc = mc_nbt.doc_new()
    let ok: bool = mc_nbt.doc_parse(&d, &wrapped, true, false) catch false
    var res: bool = false
    if ok {
        let x: u32 = mc_nbt.nbt_get(&d, mc_nbt.doc_root(&d), "x".p as u64, 1)
        if x != 0 as u32 {
            var js: rt.Buf = rt.buf_new()
            nbt_to_json(&d, x, &js, 0)
            res = mc_text.text_from_json(t, rt.buf_ptr(&js), rt.buf_len(&js), tr)
            rt.buf_free(&js)
        }
    }
    mc_nbt.doc_free(&d)
    bytes.bytes_free(&wrapped)
    return res
}
