// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_packsnd.fi -- sounds of resource packs: assets/minecraft/sounds.json + sounds/**.ogg -> audio.bank events.
//
//     import mc.mc_packsnd
//     // synth bank first (our own sounds), then the packs on top (sounds=both) -- or only the packs (sounds=original)
//     let n: i32 = mc_packsnd.packsnd_apply(&m /*McAudio*/, &b /*Bank*/, &res.stack, mc_packs.res_sounds_mode(&res))
//
// Format read (public pack convention, names only -- we ship no sound):
//   sounds.json = { "<event>": { "replace": bool, "sounds": [ "path" | {"name":"path","volume":v,"pitch":p,"weight":w,"stream":b}, ... ] }, ... }
//   "path" = assets/minecraft/sounds/<path>.ogg ("ns:path" = assets/<ns>/sounds/<path>.ogg). OGG Vorbis only (audio.load_ogg).
// Rules (honest):
//   * Vanilla merge: for one event the sound lists of ALL packs are joined (top pack first). A pack with "replace": true cuts off every
//     pack BELOW it (its own list stays). Same file twice = once. Entries of type "event" (references) are ignored.
//   * The OGG file itself is searched in all packs, top first.
//   * Per event at most 16 samples (engine limit); the top pack wins the cut. Files / events are limited by PS_MAX_* AND by the free room
//     in the engine (2048 samples / events minus what the synth bank already uses). More are skipped and counted, never truncated silently.
//     An event without a single decodable file is not created.
//   * volume / pitch of the FIRST entry (of the top-most pack that has the event) is used; "stream" is ignored.
//   * "weight" (default 1, 1..1000): the engine picks uniformly from the max 16 sample slots of an event, so a file gets as many slots
//     (same sample id repeated) as its weight -- exact while the weights sum to <= 16, above that scaled proportionally (>= 1 slot
//     each; see acc_slots). All weights 1 = one slot per file = the old behaviour.
//   * Bus: "ui.*" -> ui, "music.*" / "music_disc.*" -> music, else sfx. An event of the pack REPLACES the synth event of the same name.
//   * sounds=synth: nothing is read. sounds=original: only the pack events exist (the caller loads no synth bank).
//     sounds=both: the caller loads the synth bank first; pack events replace event by event, synth fills the rest.
//   * Hot reload (apply again with the same Bank): every OGG is hashed (FNV-1a over the file bytes) and remembered in the bank under its
//     zip path. Same hash = the sample id is reused (no decode, no new sample). Changed file = decoded once, then moved into the OLD sample
//     slot (engine_sample_adopt_last) so the table does not grow; while the audio thread runs the new sample gets a fresh id instead.
//     Files that left the packs keep their sample (small, bounded by the pool).
import std.rt
import std.json
import std.str
import std.hash
import audio.engine
import audio.bank
import audio.load_ogg
import zip.zip
import mc.mc_assets
import mc.mc_audio
import mc.mc_packs

export {
    packsnd_apply, packsnd_build_text, PackSnd, PS_MAX_EVENTS, PS_MAX_FILES, PS_PER_EVENT, Acc, acc_new, acc_slots, acc_list,
}

const PS_MAX_EVENTS: usize = 1600
const PS_MAX_FILES: usize = 1600
const PS_PER_EVENT: usize = 16
const SOUNDS_JSON: str = "assets/minecraft/sounds.json"

struct PackSnd {
    events: i32, // events created
    files: i32, // OGG files decoded
    skipped_files: i32, // missing / undecodable / over the limit
    skipped_events: i32, // no usable file / over the limit / duplicate
    reused: i32, // files whose sample was reused from an earlier apply (same hash)
    replaced: i32, // files that changed since the earlier apply and took over their old sample slot
    decoded: i32, // files decoded in this apply
}

fn ps_new() -> PackSnd {
    return PackSnd { events: 0, files: 0, skipped_files: 0, skipped_events: 0, reused: 0, replaced: 0, decoded: 0 }
}

fn starts(p: u64, n: usize, pre: str) -> bool {
    if n < pre.length() { return false }
    return rt.mem_eq(p, pre.p as u64, pre.length())
}

fn push_s(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.length())
}

// v as decimal with 3 digits ("0.250"); v clamped to [0, 4].
fn push_milli(b: *mut rt.Buf, v: f64) {
    var x: f64 = v
    if x < 0.0 { x = 0.0 }
    if x > 4.0 { x = 4.0 }
    let m: i64 = (x * 1000.0 + 0.5) as i64
    rt.buf_push_dec_i64(b, m / 1000)
    rt.buf_push(b, 46 as u8)
    let f: i64 = m % 1000
    rt.buf_push(b, (48 + f / 100) as u8)
    rt.buf_push(b, (48 + (f / 10) % 10) as u8)
    rt.buf_push(b, (48 + f % 10) as u8)
}

// JSON string content: escape '"' and '\' (names are plain ASCII in practice; control bytes are dropped).
fn push_json_str(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push(b, 34 as u8)
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 34 as u8 || c == 92 as u8 {
            rt.buf_push(b, 92 as u8)
            rt.buf_push(b, c)
        } else if c >= 32 as u8 {
            rt.buf_push(b, c)
        }
        i = i + 1
    }
    rt.buf_push(b, 34 as u8)
}

// Zip path of a sound name: "path" -> assets/minecraft/sounds/path.ogg, "ns:path" -> assets/ns/sounds/path.ogg. false = unsafe name.
fn sound_path(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    if n == 0 || n > 200 { return false }
    var colon: usize = n
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 58 as u8 && colon == n { colon = i }
        if c == 92 as u8 || c == 0 as u8 { return false }
        if c == 46 as u8 && i + 1 < n && rt.ld8(p, i + 1) == 46 as u8 { return false } // ".."
        i = i + 1
    }
    if rt.ld8(p, 0) == 47 as u8 { return false }
    push_s(out, "assets/")
    if colon < n {
        rt.buf_push_bytes(out, p, colon)
        push_s(out, "/sounds/")
        rt.buf_push_bytes(out, p + colon as u64 + 1 as u64, n - colon - 1)
    } else {
        push_s(out, "minecraft/sounds/")
        rt.buf_push_bytes(out, p, n)
    }
    push_s(out, ".ogg")
    return true
}

// Finds `path` in the packs (top first); extracts it into `raw`. false = absent.
fn find_ogg(s: *mut mc_assets.PackStack, path: *mut rt.Buf, raw: *mut rt.Buf) -> bool {
    var pi: usize = 0
    while pi < (*s).n {
        let idx: i64 = mc_assets.pack_find_bytes(&(*s).packs[pi], rt.buf_ptr(path), rt.buf_len(path))
        if idx >= 0 {
            let got: usize = zip.zip_extract(&(*s).packs[pi].z, idx as usize, raw) catch | e | (0)
            if got > 0 { return true }
            rt.buf_clear(raw)
        }
        pi = pi + 1
    }
    return false
}

// Already emitted event name? (names of this apply, one per line in `seen`)
fn seen_has(seen: *mut rt.Buf, p: u64, n: usize) -> bool {
    let all: u64 = rt.buf_ptr(seen)
    let tot: usize = rt.buf_len(seen)
    var i: usize = 0
    while i < tot {
        var e: usize = i
        while e < tot && rt.ld8(all, e) != 10 as u8 { e = e + 1 }
        if e - i == n && rt.mem_eq(all + i as u64, p, n) { return true }
        i = e + 1
    }
    return false
}

// Everything one apply needs.
struct Ctx {
    s: *mut mc_assets.PackStack,
    e: *mut engine.Engine,
    b: *mut bank.Bank,
    st: PackSnd,
    files: rt.Buf, // zip paths usable in this apply (one per line)
    room_samples: i32, // free sample slots in the engine at the start
}

// One event while its lists are merged.
struct Acc {
    paths: rt.Buf, // zip paths of the distinct usable files, one per line (duplicate check + output order)
    n: usize,
    vol: f64,
    pit: f64,
    have_opts: bool,
    w: [i32; 16], // vanilla "weight" per file (default 1, clamped to 1..1000)
    cnt: [i32; 16], // slots per file in the event (see acc_slots)
}

fn acc_new() -> Acc {
    return Acc { paths: rt.buf_new(), n: 0, vol: 1.0, pit: 1.0, have_opts: false, w: [1; 16], cnt: [1; 16] }
}

// Weighted pick without engine support: the engine picks uniformly from the (max 16) sample slots of an event, so a file with weight w
// gets w of the slots (the same sample id several times). Exact while the weights sum to <= 16; above that they are scaled
// proportionally (rounded, every file keeps at least 1 slot, the biggest give slots back until 16 fit). All weights 1 = 1 slot each.
fn acc_slots(a: *mut Acc) {
    var total: i32 = 0
    var k: usize = 0
    while k < (*a).n { total = total + (*a).w[k]; k = k + 1 }
    var sum: i32 = 0
    k = 0
    while k < (*a).n {
        var c: i32 = (*a).w[k]
        if total > 16 {
            c = ((*a).w[k] * 16 + total / 2) / total
            if c < 1 { c = 1 }
        }
        (*a).cnt[k] = c
        sum = sum + c
        k = k + 1
    }
    while sum > 16 {
        var bi: usize = 0
        var bc: i32 = 0
        k = 0
        while k < (*a).n {
            if (*a).cnt[k] > bc { bc = (*a).cnt[k]; bi = k }
            k = k + 1
        }
        if bc <= 1 { break }
        (*a).cnt[bi] = (*a).cnt[bi] - 1
        sum = sum - 1
    }
}

// JSON string list of the event's samples: every file `cnt` times (after acc_slots).
fn acc_list(a: *mut Acc, out: *mut rt.Buf) {
    let all: u64 = rt.buf_ptr(&(*a).paths)
    let tot: usize = rt.buf_len(&(*a).paths)
    var i: usize = 0
    var k: usize = 0
    var first: bool = true
    while i < tot && k < (*a).n {
        var e: usize = i
        while e < tot && rt.ld8(all, e) != 10 as u8 { e = e + 1 }
        var r: i32 = 0
        while r < (*a).cnt[k] {
            if !first { rt.buf_push(out, 44 as u8) }
            first = false
            push_json_str(out, all + i as u64, e - i)
            r = r + 1
        }
        k = k + 1
        i = e + 1
    }
}

fn file_hash(p: u64, n: usize) -> u64 {
    let h: u64 = hash.fnv1a64(p, n)
    if h == 0 as u64 { return 1 as u64 }
    return h
}

// Makes `path` usable: decoded now, reused from an earlier apply (same hash) or moved into its old slot (changed). false = unusable.
fn resolve_file(c: *mut Ctx, path: *mut rt.Buf) -> bool {
    let pp: u64 = rt.buf_ptr(path)
    let pn: usize = rt.buf_len(path)
    if seen_has(&(*c).files, pp, pn) { return true }
    if (*c).st.files as usize >= PS_MAX_FILES {
        (*c).st.skipped_files = (*c).st.skipped_files + 1
        return false
    }
    var og: rt.Buf = rt.buf_new()
    if !find_ogg((*c).s, path, &og) {
        rt.buf_free(&og)
        (*c).st.skipped_files = (*c).st.skipped_files + 1
        return false
    }
    let nm: str = str { p: rt.buf_data(path), n: pn }
    let h: u64 = file_hash(rt.buf_ptr(&og), rt.buf_len(&og))
    var ok: bool = false
    let cached: i32 = bank.bank_cached_id((*c).b, nm, h)
    if cached >= 0 {
        (*c).st.reused = (*c).st.reused + 1
        ok = true
    } else if (*c).st.decoded >= (*c).room_samples {
        (*c).st.skipped_files = (*c).st.skipped_files + 1 // engine sample pool is full
    } else {
        let id: i32 = load_ogg.ogg_load((*c).e, rt.buf_ptr(&og), rt.buf_len(&og))
        if id >= 0 {
            (*c).st.decoded = (*c).st.decoded + 1
            let old: i32 = bank.bank_provide_hashed((*c).b, nm, h, id)
            if old >= 0 && old != id && (id as usize) + 1 == engine.engine_sample_count((*c).e) {
                if engine.engine_sample_adopt_last((*c).e, old) {
                    bank.bank_provide_hashed((*c).b, nm, h, old)
                    (*c).st.replaced = (*c).st.replaced + 1
                }
            }
            ok = true
        } else {
            (*c).st.skipped_files = (*c).st.skipped_files + 1
        }
    }
    rt.buf_free(&og)
    if ok {
        rt.buf_push_bytes(&(*c).files, pp, pn)
        rt.buf_push(&(*c).files, 10 as u8)
        (*c).st.files = (*c).st.files + 1
    }
    return ok
}

// Adds the entries of one "sounds" array to the event (top pack first, at most PS_PER_EVENT in total).
fn add_entries(c: *mut Ctx, d: *mut json.Json, arr: u32, a: *mut Acc) {
    var k: usize = 0
    let cnt: usize = json.json_count(d, arr)
    while k < cnt && (*a).n < PS_PER_EVENT {
        let it: u32 = json.json_child_at(d, arr, k)
        k = k + 1
        var nm: str.Span = str.span_empty()
        var has_name: bool = false
        var iv: f64 = 1.0
        var ip: f64 = 1.0
        var iw: i32 = 1
        if json.json_kind(d, it) == json.JSON_STRING {
            nm = json.json_string(d, it)
            has_name = true
        } else if json.json_kind(d, it) == json.JSON_OBJECT {
            let ty: u32 = json.json_get(d, it, "type".p as u64, 4)
            if ty != json.JSON_NONE && json.json_kind(d, ty) == json.JSON_STRING {
                let tv: str.Span = json.json_string(d, ty)
                if tv.n == 5 && rt.mem_eq(tv.p as u64, "event".p as u64, 5) { continue } // reference to another event
            }
            let nn: u32 = json.json_get(d, it, "name".p as u64, 4)
            if nn != json.JSON_NONE && json.json_kind(d, nn) == json.JSON_STRING {
                nm = json.json_string(d, nn)
                has_name = true
            }
            let vv: u32 = json.json_get(d, it, "volume".p as u64, 6)
            if vv != json.JSON_NONE && json.json_kind(d, vv) == json.JSON_NUMBER { iv = json.json_number(d, vv) }
            let pp: u32 = json.json_get(d, it, "pitch".p as u64, 5)
            if pp != json.JSON_NONE && json.json_kind(d, pp) == json.JSON_NUMBER { ip = json.json_number(d, pp) }
            let ww: u32 = json.json_get(d, it, "weight".p as u64, 6)
            if ww != json.JSON_NONE && json.json_kind(d, ww) == json.JSON_NUMBER {
                let wn: f64 = json.json_number(d, ww)
                if wn >= 1.0 { iw = wn as i32 }
                if wn > 1000.0 { iw = 1000 }
            }
        }
        if !has_name { (*c).st.skipped_files = (*c).st.skipped_files + 1; continue }
        var path: rt.Buf = rt.buf_new()
        if !sound_path(nm.p as u64, nm.n, &path) {
            rt.buf_free(&path)
            (*c).st.skipped_files = (*c).st.skipped_files + 1
            continue
        }
        if seen_has(&(*a).paths, rt.buf_ptr(&path), rt.buf_len(&path)) {
            rt.buf_free(&path)
            continue
        }
        if resolve_file(c, &path) {
            rt.buf_push_bytes(&(*a).paths, rt.buf_ptr(&path), rt.buf_len(&path))
            rt.buf_push(&(*a).paths, 10 as u8)
            (*a).w[(*a).n] = iw
            (*a).n = (*a).n + 1
            if !(*a).have_opts { (*a).vol = iv; (*a).pit = ip; (*a).have_opts = true }
        }
        rt.buf_free(&path)
    }
}

// Reads the sounds.json of every pack, decodes the OGG files into `e` (or reuses them), registers them in `b` (bank_provide_hashed, key =
// zip path) and writes an Aulos bank text with one event per pack event into `text`. Returns the statistics.
fn packsnd_build_text(s: *mut mc_assets.PackStack, e: *mut engine.Engine, b: *mut bank.Bank, text: *mut rt.Buf) -> PackSnd {
    var c: Ctx = Ctx { s: s, e: e, b: b, st: ps_new(), files: rt.buf_new(),
        room_samples: (engine.MAX_SAMPLES as i32) - (engine.engine_sample_count(e) as i32) }
    var seen: rt.Buf = rt.buf_new()
    let room_events: i32 = (engine.MAX_EVENTS as i32) - (engine.engine_event_count(e) as i32)
    var new_events: i32 = 0
    // parse every sounds.json once (kept alive until the end: lower packs are read again for each event)
    var raws: [rt.Buf; 8] = [rt.buf_new(); 8]
    var docs: [json.Json; 8] = [json.json_new(); 8]
    var oks: [bool; 8] = [false; 8]
    var pi: usize = 0
    while pi < (*s).n && pi < 8 {
        let sj: i64 = mc_assets.pack_find(&(*s).packs[pi], SOUNDS_JSON)
        if sj >= 0 {
            let got: usize = zip.zip_extract(&(*s).packs[pi].z, sj as usize, &raws[pi]) catch | e2 | (0)
            var ok: bool = false
            if got > 0 { ok = json.json_parse(&docs[pi], rt.buf_ptr(&raws[pi]), rt.buf_len(&raws[pi])) catch false }
            if ok && json.json_kind(&docs[pi], json.json_root(&docs[pi])) == json.JSON_OBJECT { oks[pi] = true }
        }
        pi = pi + 1
    }
    let np: usize = pi
    push_s(text, "{\"events\":[")
    var first: bool = true
    pi = 0
    while pi < np {
        if !oks[pi] { pi = pi + 1; continue }
        let root: u32 = json.json_root(&docs[pi])
        var ev: u32 = json.json_child(&docs[pi], root)
        while ev != json.JSON_NONE {
            let key: str.Span = json.json_key(&docs[pi], ev)
            ev = json.json_next(&docs[pi], ev)
            let kp: u64 = key.p as u64
            let kn: usize = key.n
            if kn == 0 || kn > 120 { c.st.skipped_events = c.st.skipped_events + 1; continue }
            if seen_has(&seen, kp, kn) { continue } // already merged from a higher pack
            rt.buf_push_bytes(&seen, kp, kn)
            rt.buf_push(&seen, 10 as u8)
            if (c.st.events as usize) >= PS_MAX_EVENTS { c.st.skipped_events = c.st.skipped_events + 1; continue }
            var is_new: bool = true
            if kn < 200 {
                var nm: rt.Buf = rt.buf_new()
                rt.buf_push_bytes(&nm, kp, kn)
                rt.buf_push(&nm, 0 as u8)
                is_new = engine.engine_find_event(e, str { p: rt.buf_data(&nm), n: kn }) < 0
                rt.buf_free(&nm)
            }
            if is_new && new_events >= room_events { c.st.skipped_events = c.st.skipped_events + 1; continue } // engine event table full
            var a: Acc = acc_new()
            var pj: usize = pi
            var any_list: bool = false
            while pj < np {
                if oks[pj] {
                    let r2: u32 = json.json_root(&docs[pj])
                    let obj: u32 = json.json_get(&docs[pj], r2, kp, kn)
                    if obj != json.JSON_NONE && json.json_kind(&docs[pj], obj) == json.JSON_OBJECT {
                        let arr: u32 = json.json_get(&docs[pj], obj, "sounds".p as u64, 6)
                        if arr != json.JSON_NONE && json.json_kind(&docs[pj], arr) == json.JSON_ARRAY {
                            any_list = true
                            add_entries(&c, &docs[pj], arr, &a)
                        }
                        let rp: u32 = json.json_get(&docs[pj], obj, "replace".p as u64, 7)
                        if rp != json.JSON_NONE && json.json_bool(&docs[pj], rp) { break } // cuts off the packs below
                    }
                }
                pj = pj + 1
            }
            if !any_list || a.n == 0 {
                c.st.skipped_events = c.st.skipped_events + 1
                rt.buf_free(&a.paths)
                continue
            }
            if !first { rt.buf_push(text, 44 as u8) }
            first = false
            push_s(text, "{\"name\":")
            push_json_str(text, kp, kn)
            push_s(text, ",\"bus\":")
            if starts(kp, kn, "ui.") {
                push_s(text, "\"ui\"")
            } else if starts(kp, kn, "music.") || starts(kp, kn, "music_disc.") {
                push_s(text, "\"music\"")
            } else {
                push_s(text, "\"sfx\"")
            }
            push_s(text, ",\"samples\":[")
            acc_slots(&a)
            acc_list(&a, text)
            push_s(text, "]")
            if a.vol > 0.0 && a.vol != 1.0 {
                push_s(text, ",\"volume\":")
                push_milli(text, a.vol)
            }
            if a.pit > 0.0 && a.pit != 1.0 {
                push_s(text, ",\"pitch\":")
                push_milli(text, a.pit)
            }
            push_s(text, "}")
            if is_new { new_events = new_events + 1 }
            c.st.events = c.st.events + 1
            rt.buf_free(&a.paths)
        }
        pi = pi + 1
    }
    push_s(text, "]}")
    var q: usize = 0
    while q < np {
        json.json_free(&docs[q])
        rt.buf_free(&raws[q])
        q = q + 1
    }
    rt.buf_free(&seen)
    rt.buf_free(&c.files)
    return c.st
}

// sounds= mode of the pack manager: SOUNDS_SYNTH (0) does nothing; ORIGINAL (1) and BOTH (2) load the pack events (the caller decides
// whether a synth bank was loaded before). Returns the number of events created, -1 on a bank error (mc_audio keeps what it had).
fn packsnd_apply(m: *mut mc_audio.McAudio, b: *mut bank.Bank, e: *mut engine.Engine, s: *mut mc_assets.PackStack, mode: i32) -> i32 {
    if mode == mc_packs.SOUNDS_SYNTH { return 0 }
    var text: rt.Buf = rt.buf_new()
    let st: PackSnd = packsnd_build_text(s, e, b, &text)
    var rc: i32 = 0 - 1
    if st.events > 0 {
        let r: i32 = mc_audio.mca_bank_load_text(m, b, rt.buf_ptr(&text), rt.buf_len(&text), "")
        if r == bank.BANK_OK { rc = st.events }
    } else {
        rc = 0
    }
    rt.buf_free(&text)
    return rc
}
