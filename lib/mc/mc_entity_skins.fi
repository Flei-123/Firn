import std.rt
import mc.mc_gui_tex
import mc.mc_gui_pack

export { EntitySkins, skins_new, skins_free, skins_open, skins_ok, SKIN_LAYERS }

const SKIN_LAYERS: i32 = 10
const LAYER_PIXELS: usize = 4096

struct EntitySkins {
    px: u64,
    ok: bool,
}

fn skins_new() -> EntitySkins {
    return EntitySkins { px: 0 as u64, ok: false }
}

fn skins_free(s: *mut EntitySkins) {
    if (*s).px != 0 as u64 { rt.heap_free((*s).px, (SKIN_LAYERS as usize) * LAYER_PIXELS * 4) }
    (*s).px = 0 as u64
    (*s).ok = false
}

fn skins_ok(s: *mut EntitySkins) -> bool {
    return (*s).ok
}

fn layer_path(i: i32) -> str {
    if i == 0 { return "assets/minecraft/textures/entity/zombie/zombie.png" }
    if i == 1 { return "assets/minecraft/textures/entity/skeleton/skeleton.png" }
    if i == 2 { return "assets/minecraft/textures/entity/creeper/creeper.png" }
    if i == 3 { return "assets/minecraft/textures/entity/pig/pig.png" }
    if i == 4 { return "assets/minecraft/textures/entity/cow/cow.png" }
    if i == 5 { return "assets/minecraft/textures/entity/sheep/sheep.png" }
    if i == 6 { return "assets/minecraft/textures/entity/sheep/sheep_fur.png" }
    if i == 7 { return "assets/minecraft/textures/entity/chicken.png" }
    if i == 8 { return "assets/minecraft/textures/entity/villager/villager.png" }
    return "assets/minecraft/textures/entity/spider/spider.png"
}

fn copy_layer(s: *mut EntitySkins, layer: i32, t: *mut mc_gui_tex.GuiTex) {
    var y: i32 = 0
    while y < 64 && y < (*t).h {
        var x: i32 = 0
        while x < 64 && x < (*t).w {
            rt.st32((*s).px, (layer as usize) * LAYER_PIXELS + (y as usize) * 64 + (x as usize), mc_gui_tex.gtex_get(t, x, y))
            x = x + 1
        }
        y = y + 1
    }
}

fn skins_open(s: *mut EntitySkins, protocol: i32) -> bool {
    skins_free(s)
    var pk: mc_gui_pack.GuiPack = mc_gui_pack.gpack_new()
    if !mc_gui_pack.gpack_open(&pk, protocol) {
        mc_gui_pack.gpack_free(&pk)
        return false
    }
    let total: usize = (SKIN_LAYERS as usize) * LAYER_PIXELS
    (*s).px = rt.heap_alloc(total * 4)
    if (*s).px == 0 as u64 {
        mc_gui_pack.gpack_free(&pk)
        return false
    }
    var i: usize = 0
    while i < total {
        rt.st32((*s).px, i, 0 as u32)
        i = i + 1
    }
    var got: i32 = 0
    var l: i32 = 0
    while l < SKIN_LAYERS {
        var t: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
        if mc_gui_pack.gpack_tex(&pk, layer_path(l), &t) {
            copy_layer(s, l, &t)
            got = got + 1
        }
        mc_gui_tex.gtex_free(&t)
        l = l + 1
    }
    mc_gui_pack.gpack_free(&pk)
    (*s).ok = got > 0
    return (*s).ok
}
