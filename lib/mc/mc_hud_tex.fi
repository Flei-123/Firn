import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_gui_tex
import mc.mc_gui_pack

export { HudTex, hudtex_new, hudtex_free, hudtex_open, hudtex_ok, hudtex_blit, hudtex_blit_invert }

const ICONS: str = "assets/minecraft/textures/gui/icons.png"
const BARS: str = "assets/minecraft/textures/gui/bars.png"
const UNDERWATER: str = "assets/minecraft/textures/misc/underwater.png"

struct HudTex {
    widgets: mc_gui_tex.GuiTex,
    icons: mc_gui_tex.GuiTex,
    bars: mc_gui_tex.GuiTex,
    underwater: mc_gui_tex.GuiTex,
}

fn hudtex_new() -> HudTex {
    return HudTex { widgets: mc_gui_tex.gtex_empty(), icons: mc_gui_tex.gtex_empty(), bars: mc_gui_tex.gtex_empty(), underwater: mc_gui_tex.gtex_empty() }
}

fn hudtex_free(h: *mut HudTex) {
    mc_gui_tex.gtex_free(&(*h).widgets)
    mc_gui_tex.gtex_free(&(*h).icons)
    mc_gui_tex.gtex_free(&(*h).bars)
    mc_gui_tex.gtex_free(&(*h).underwater)
}

fn hudtex_ok(h: *mut HudTex) -> bool {
    return mc_gui_tex.gtex_ok(&(*h).widgets) && mc_gui_tex.gtex_ok(&(*h).icons)
}

fn hudtex_open(h: *mut HudTex, protocol: i32) -> bool {
    var pk: mc_gui_pack.GuiPack = mc_gui_pack.gpack_new()
    if !mc_gui_pack.gpack_open(&pk, protocol) {
        mc_gui_pack.gpack_free(&pk)
        return false
    }
    (*h).widgets = pk.widgets
    pk.widgets = mc_gui_tex.gtex_empty()
    mc_gui_pack.gpack_tex(&pk, ICONS, &(*h).icons)
    mc_gui_pack.gpack_tex(&pk, BARS, &(*h).bars)
    mc_gui_pack.gpack_tex(&pk, UNDERWATER, &(*h).underwater)
    mc_gui_pack.gpack_free(&pk)
    return hudtex_ok(h)
}

fn texel(t: *mut mc_gui_tex.GuiTex, x: i32, y: i32) -> u32 {
    return mc_gui_tex.gtex_get(t, x, y)
}

fn hudtex_blit(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, x: i32, y: i32, s: i32, sx: i32, sy: i32, sw: i32, sh: i32) {
    if !mc_gui_tex.gtex_ok(t) { return }
    var j: i32 = 0
    while j < sh {
        var i: i32 = 0
        while i < sw {
            let c: u32 = texel(t, sx + i, sy + j)
            if (c >> 24 as u32) == 0 as u32 {
                i = i + 1
            } else {
                var k: i32 = i + 1
                while k < sw && texel(t, sx + k, sy + j) == c { k = k + 1 }
                mc_hud.hud_rect(r, x + i * s, y + j * s, (k - i) * s, s, c)
                i = k
            }
        }
        j = j + 1
    }
}

fn hudtex_blit_invert(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, x: i32, y: i32, s: i32, sx: i32, sy: i32, sw: i32, sh: i32) {
    if !mc_gui_tex.gtex_ok(t) { return }
    var j: i32 = 0
    while j < sh {
        var i: i32 = 0
        while i < sw {
            if (texel(t, sx + i, sy + j) >> 24 as u32) == 0 as u32 {
                i = i + 1
            } else {
                var k: i32 = i + 1
                while k < sw && (texel(t, sx + k, sy + j) >> 24 as u32) != 0 as u32 { k = k + 1 }
                mc_hud.hud_invert(r, x + i * s, y + j * s, (k - i) * s, s)
                i = k
            }
        }
        j = j + 1
    }
}
