import std.rt
import mc.mc_tip_lines
import mc.mc_item_tip

export { et_build, ET_PROP_CLUE, ET_PROP_LEVEL }

const ET_PROP_CLUE: i32 = 4
const ET_PROP_LEVEL: i32 = 7
const C_WHITE: i32 = 0xFFFFFF
const C_GRAY: i32 = 0xAAAAAA
const C_RED: i32 = 0xFF5555

fn prop(props: u64, k: i32) -> i32 {
    let u: u32 = rt.ld32(props, k as usize)
    if u >= (2147483648 as u32) { return 0 - ((0 as u32 -% u) as i32) }
    return u as i32
}

fn add_fmt(t: *mut mc_tip_lines.TipLines, rgb: i32, key: str, fallback: str, n: i32) {
    var num: rt.Buf = rt.buf_new()
    var line: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&num, n as i64)
    mc_item_tip.tip_lang_fmt(key, fallback, rt.buf_ptr(&num), rt.buf_len(&num), &line)
    mc_tip_lines.tl_add_plain(t, rgb, 0 as u32, rt.buf_ptr(&line), rt.buf_len(&line))
    rt.buf_free(&num)
    rt.buf_free(&line)
}

fn add_clue(t: *mut mc_tip_lines.TipLines, clue_id: i32, clue_level: i32, protocol: i32, ep: u64, en: usize) {
    var name: rt.Buf = rt.buf_new()
    var line: rt.Buf = rt.buf_new()
    if clue_id >= 0 && mc_item_tip.tip_enchant_text(protocol, ep, en, clue_id, clue_level, &name) {
        mc_item_tip.tip_lang_fmt("container.enchant.clue", "%s . . . ?", rt.buf_ptr(&name), rt.buf_len(&name), &line)
        mc_tip_lines.tl_add_plain(t, C_WHITE, 0 as u32, rt.buf_ptr(&line), rt.buf_len(&line))
    }
    rt.buf_free(&name)
    rt.buf_free(&line)
}

fn et_build(t: *mut mc_tip_lines.TipLines, idx: i32, props: u64, lapis: i32, xp: i32, creative: bool, protocol: i32, ep: u64, en: usize) {
    if idx < 0 || idx > 2 { return }
    let cost: i32 = prop(props, idx)
    if cost <= 0 { return }
    let clue: i32 = prop(props, ET_PROP_CLUE + idx)
    let level: i32 = prop(props, ET_PROP_LEVEL + idx)
    add_clue(t, clue, level, protocol, ep, en)
    if creative { return }
    mc_tip_lines.tl_add_blank(t)
    if xp < cost {
        add_fmt(t, C_RED, "container.enchant.level.requirement", "Level Requirement: %s", cost)
        return
    }
    var lc: i32 = C_GRAY
    if lapis <= idx { lc = C_RED }
    if idx == 0 {
        add_fmt(t, lc, "container.enchant.lapis.one", "1 Lapis Lazuli", 1)
        add_fmt(t, C_GRAY, "container.enchant.level.one", "1 Enchantment Level", 1)
    } else {
        add_fmt(t, lc, "container.enchant.lapis.many", "%s Lapis Lazuli", idx + 1)
        add_fmt(t, C_GRAY, "container.enchant.level.many", "%s Enchantment Levels", idx + 1)
    }
}
