import std.rt
import std.str
import std.json

export { GuiLang, glang_empty, glang_free, glang_load, glang_get, glang_ok }

struct GuiLang {
    d: json.Json,
    root: u32,
}

fn glang_empty() -> GuiLang {
    return GuiLang { d: json.json_new(), root: json.JSON_NONE }
}

fn glang_ok(l: *mut GuiLang) -> bool {
    return (*l).root != json.JSON_NONE
}

fn glang_free(l: *mut GuiLang) {
    json.json_free(&(*l).d)
    (*l).root = json.JSON_NONE
}

fn glang_load(l: *mut GuiLang, p: u64, n: usize) -> bool {
    let ok: bool = json.json_parse(&(*l).d, p, n) catch false
    if !ok { return false }
    let root: u32 = json.json_root(&(*l).d)
    if root == json.JSON_NONE || json.json_kind(&(*l).d, root) != json.JSON_OBJECT { return false }
    (*l).root = root
    return true
}

fn glang_get(l: *mut GuiLang, key: str, fallback: str) -> str {
    if (*l).root == json.JSON_NONE { return fallback }
    let v: u32 = json.json_get(&(*l).d, (*l).root, key.p as u64, key.length())
    if v == json.JSON_NONE || json.json_kind(&(*l).d, v) != json.JSON_STRING { return fallback }
    let s: str.Span = json.json_string(&(*l).d, v)
    if s.n == 0 { return fallback }
    return str { p: s.p as *u8, n: s.n }
}
