import mc.mc_client
import mc.mc_cont_net
import mc.mc_trade
import mc.mc_trade_ui

export { TradeAct, ta_new, ta_select, ta_press, ta_drag, ta_release, ta_wheel, ta_dragging }

struct TradeAct {
    sent: u32,
    dragging: bool,
    last: i32,
}

fn ta_new() -> TradeAct {
    return TradeAct { sent: 0 as u32, dragging: false, last: 0 - 1 }
}

fn ta_dragging(a: *mut TradeAct) -> bool { return (*a).dragging }

fn ta_select(a: *mut TradeAct, t: *mut mc_trade.Trades, cl: *mut mc_client.Client, idx: i32) -> bool {
    if !mc_trade.tr_select(t, idx) { return false }
    if !mc_cont_net.cn_send_trade(cl, idx) { return false }
    (*a).sent = (*a).sent + (1 as u32)
    (*a).last = idx
    return true
}

fn ta_press(a: *mut TradeAct, t: *mut mc_trade.Trades, cl: *mut mc_client.Client, px: i32, py: i32, s: i32, mx: i32, my: i32) -> bool {
    if mc_trade.tr_count(t) <= 0 { return false }
    if mc_trade_ui.tui_scroller_hit(px, py, s, mx, my) {
        (*a).dragging = true
        mc_trade_ui.tui_scroll_from_y(t, py, s, my)
        return true
    }
    let row: i32 = mc_trade_ui.tui_row_hit(px, py, s, mx, my)
    if row < 0 { return false }
    let idx: i32 = mc_trade.tr_index_of_row(t, row)
    if idx < 0 { return true }
    ta_select(a, t, cl, idx)
    return true
}

fn ta_drag(a: *mut TradeAct, t: *mut mc_trade.Trades, py: i32, s: i32, my: i32, down: bool) {
    if !(*a).dragging { return }
    if !down {
        (*a).dragging = false
        return
    }
    mc_trade_ui.tui_scroll_from_y(t, py, s, my)
}

fn ta_release(a: *mut TradeAct) {
    (*a).dragging = false
}

fn ta_wheel(t: *mut mc_trade.Trades, wheel: i64) {
    if wheel == 0 as i64 || mc_trade.tr_count(t) <= 0 { return }
    if wheel > 0 as i64 {
        mc_trade.tr_scroll_by(t, 0 - 1)
    } else {
        mc_trade.tr_scroll_by(t, 1)
    }
}
