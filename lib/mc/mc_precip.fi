import std.rt
import std.math
import mc.mc_registry
import mc.mc_world
import mc.mc_chunk
import mc.mc_precip_tab

export {
    Precip, precip_new, precip_update, precip_kind_by_name, precip_biome_kind, precip_biome_at, precip_covered, precip_exposure,
    PRECIP_NONE, PRECIP_RAIN, PRECIP_SNOW, EXPOSURE_MAX,
}

const PRECIP_NONE: i32 = 0
const PRECIP_RAIN: i32 = 1
const PRECIP_SNOW: i32 = 2
const EXPOSURE_MAX: i32 = 1000
const EXPOSURE_COVERED: i32 = 180
const EXPOSURE_STEP: i32 = 250
const UPDATE_MS: u64 = 250 as u64
const PREFIX_LEN: usize = 10

struct Precip {
    kind: i32,
    exposure: i32,
    covered: bool,
    biome: i32,
    last_ms: u64,
    water_block: i32,
    lava_block: i32,
    bound: bool,
}

fn precip_new() -> Precip {
    return Precip { kind: PRECIP_RAIN, exposure: EXPOSURE_MAX, covered: false, biome: 0 - 1, last_ms: 0 as u64, water_block: 0 - 1, lava_block: 0 - 1, bound: false }
}

fn precip_exposure(p: *mut Precip) -> i32 {
    return (*p).exposure
}

fn precip_kind_by_name(np: u64, nl: usize) -> i32 {
    let d: u64 = mc_precip_tab.PRECIP_DATA.p as u64
    let dn: usize = mc_precip_tab.PRECIP_LEN
    var name: u64 = np
    var len: usize = nl
    if len > PREFIX_LEN && rt.mem_eq(name, "minecraft:".p as u64, PREFIX_LEN) {
        name = name + (PREFIX_LEN as u64)
        len = len - PREFIX_LEN
    }
    var i: usize = 0
    while i < dn {
        var e: usize = i
        while e < dn && rt.ld8(d, e) != (59 as u8) { e = e + 1 }
        if e - i == len + 2 && rt.mem_eq(d + (i as u64), name, len) {
            return (rt.ld8(d, e - 1) as i32) - 48
        }
        i = e + 1
    }
    return 0 - 1
}

fn precip_biome_kind(reg: *mut mc_registry.Registry, id: i32) -> i32 {
    if id < 0 { return PRECIP_RAIN }
    let ri: i32 = mc_registry.reg_biome_find(reg, id)
    if ri < 0 { return PRECIP_RAIN }
    var nl: usize = 0
    let np: u64 = mc_registry.reg_biome_name(reg, ri, &nl)
    let k: i32 = precip_kind_by_name(np, nl)
    if k < 0 { return PRECIP_RAIN }
    return k
}

fn precip_biome_at(w: *mut mc_world.World, min_y: i32, x: i32, y: i32, z: i32) -> i32 {
    let cp: u64 = mc_world.world_find(w, mc_world.block_to_chunk(x), mc_world.block_to_chunk(z))
    if cp == 0 { return 0 - 1 }
    let c: *mut mc_chunk.Chunk = cp as *mut mc_chunk.Chunk
    let si: i32 = mc_world.section_index(y, min_y)
    if si < 0 || si as usize >= (*c).nsec { return 0 - 1 }
    let sec: *mut mc_chunk.Section = mc_chunk.chunk_section(c, si as usize)
    if (*sec).biomes.pal_n == 0 as u32 { return 0 - 1 }
    let cx: i32 = mc_world.block_in_chunk(x) / 4
    let cz: i32 = mc_world.block_in_chunk(z) / 4
    let cy: i32 = mc_world.floor_mod(y, 16) / 4
    return mc_chunk.container_get(&(*sec).biomes, ((cy * 4 + cz) * 4 + cx) as usize) as i32
}

fn state_at(w: *mut mc_world.World, min_y: i32, x: i32, y: i32, z: i32) -> i32 {
    let cp: u64 = mc_world.world_find(w, mc_world.block_to_chunk(x), mc_world.block_to_chunk(z))
    if cp == 0 { return 0 - 1 }
    let c: *mut mc_chunk.Chunk = cp as *mut mc_chunk.Chunk
    let si: i32 = mc_world.section_index(y, min_y)
    if si < 0 || si as usize >= (*c).nsec { return 0 - 1 }
    let sec: *mut mc_chunk.Section = mc_chunk.chunk_section(c, si as usize)
    let lx: i32 = mc_world.block_in_chunk(x)
    let lz: i32 = mc_world.block_in_chunk(z)
    let ly: i32 = mc_world.floor_mod(y, 16)
    return mc_chunk.container_get(&(*sec).blocks, ((ly * 16 + lz) * 16 + lx) as usize) as i32
}

fn bind(p: *mut Precip, reg: *mut mc_registry.Registry) {
    if (*p).bound { return }
    (*p).water_block = mc_registry.reg_block_by_name(reg, "water".p as u64, 5)
    (*p).lava_block = mc_registry.reg_block_by_name(reg, "lava".p as u64, 4)
    (*p).bound = true
}

fn blocks_precip(p: *mut Precip, reg: *mut mc_registry.Registry, state: i32) -> bool {
    if state <= 0 { return false }
    let b: i32 = mc_registry.reg_block_of_state(reg, state)
    if b < 0 { return false }
    if b == (*p).water_block || b == (*p).lava_block { return true }
    return (mc_registry.reg_block_flags(reg, b) & mc_registry.RF_SOLID) != 0 as u32
}

fn precip_covered(p: *mut Precip, w: *mut mc_world.World, reg: *mut mc_registry.Registry, min_y: i32, x: i32, y: i32, z: i32) -> bool {
    bind(p, reg)
    var yy: i32 = y
    while true {
        let st: i32 = state_at(w, min_y, x, yy, z)
        if st < 0 { return false }
        if blocks_precip(p, reg, st) { return true }
        yy = yy + 1
    }
    return false
}

fn approach(cur: i32, target: i32) -> i32 {
    if cur < target {
        if target - cur < EXPOSURE_STEP { return target }
        return cur + EXPOSURE_STEP
    }
    if cur - target < EXPOSURE_STEP { return target }
    return cur - EXPOSURE_STEP
}

fn precip_update(p: *mut Precip, w: *mut mc_world.World, reg: *mut mc_registry.Registry, min_y: i32, ex: f64, ey: f64, ez: f64, now_ms: u64) {
    if (*p).last_ms != 0 as u64 && now_ms - (*p).last_ms < UPDATE_MS { return }
    (*p).last_ms = now_ms
    let bx: i32 = math.floor(ex) as i32
    let by: i32 = math.floor(ey) as i32
    let bz: i32 = math.floor(ez) as i32
    (*p).biome = precip_biome_at(w, min_y, bx, by, bz)
    (*p).kind = precip_biome_kind(reg, (*p).biome)
    (*p).covered = precip_covered(p, w, reg, min_y, bx, by, bz)
    var target: i32 = EXPOSURE_MAX
    if (*p).covered { target = EXPOSURE_COVERED }
    (*p).exposure = approach((*p).exposure, target)
}
