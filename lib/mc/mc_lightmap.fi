export { LmRgb, lm_set_gamma, lm_gamma, lm_eval, lm_pack_day, lm_is_packed, lm_unpack_sky, lm_curve, LM_GAMMA_DEFAULT }

const LM_GAMMA_DEFAULT: i32 = 128
const LM_BLOCK_FACTOR: f64 = 1.5
const LM_AMBIENT_MIX: f64 = 0.04
const LM_AMBIENT_GRAY: f64 = 0.75
const LM_SKY_TINT_MIX: f64 = 0.35

static mut GAMMA: i32 = 128

fn lm_set_gamma(g: i32) {
    var v: i32 = g
    if v < 0 { v = 0 }
    if v > 256 { v = 256 }
    GAMMA = v
}

fn lm_gamma() -> i32 {
    return GAMMA
}

struct LmRgb {
    r: i64,
    g: i64,
    b: i64,
}

fn lm_pack_day(sky_darken256: i32) -> i32 {
    var s: i32 = sky_darken256
    if s < 0 { s = 0 }
    if s > 256 { s = 256 }
    return 0 - 1 - s
}

fn lm_is_packed(day: i32) -> bool {
    return day < 0
}

fn lm_unpack_sky(day: i32) -> i32 {
    return 0 - 1 - day
}

fn lm_curve(level: f64) -> f64 {
    let f: f64 = level / 15.0
    return f / (4.0 - 3.0 * f)
}

fn clamp01(v: f64) -> f64 {
    if v < 0.0 { return 0.0 }
    if v > 1.0 { return 1.0 }
    return v
}

fn mix(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

fn gamma_curve(v: f64) -> f64 {
    let q: f64 = 1.0 - v
    let q2: f64 = q * q
    return 1.0 - q2 * q2
}

fn channel(block: f64, sky: f64, gamma: f64) -> f64 {
    var v: f64 = block + sky
    v = mix(v, LM_AMBIENT_GRAY, LM_AMBIENT_MIX)
    v = clamp01(v)
    v = mix(v, gamma_curve(v), gamma)
    v = mix(v, LM_AMBIENT_GRAY, LM_AMBIENT_MIX)
    return clamp01(v)
}

fn lm_eval(sky_level: f64, block_level: f64, sky_darken256: i32, gamma256: i32) -> LmRgb {
    let sd: f64 = (sky_darken256 as f64) / 256.0
    let gm: f64 = (gamma256 as f64) / 256.0
    let m: f64 = lm_curve(sky_level) * (sd * 0.95 + 0.05)
    let n: f64 = lm_curve(block_level) * LM_BLOCK_FACTOR
    let br: f64 = n
    let bg: f64 = n * ((n * 0.6 + 0.4) * 0.6 + 0.4)
    let bb: f64 = n * (n * n * 0.6 + 0.4)
    let sr: f64 = mix(sd, 1.0, LM_SKY_TINT_MIX) * m
    let sb: f64 = 1.0 * m
    let r: f64 = channel(br, sr, gm)
    let g: f64 = channel(bg, sr, gm)
    let b: f64 = channel(bb, sb, gm)
    return LmRgb { r: (r * 256.0 + 0.5) as i64, g: (g * 256.0 + 0.5) as i64, b: (b * 256.0 + 0.5) as i64 }
}
