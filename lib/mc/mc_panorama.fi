// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.math
import mc.mc_raster
import mc.mc_gui_tex
import mc.mc_gui_pack

export { Panorama, pan_new, pan_free, pan_load, pan_ok, pan_render, pan_yaw, pan_pitch, FaceUv, pan_face_uv }

const FACES: usize = 6
const DEG: f64 = 0.017453292519943295
const FOV_DEG: f64 = 85.0

struct Panorama {
    faces: [mc_gui_tex.GuiTex; 6],
    loaded: usize,
}

struct FaceUv {
    face: i32,
    u: f64,
    v: f64,
}

fn pan_new() -> Panorama {
    return Panorama { faces: [mc_gui_tex.gtex_empty(); 6], loaded: 0 }
}

fn pan_free(p: *mut Panorama) {
    var i: usize = 0
    while i < FACES {
        mc_gui_tex.gtex_free(&(*p).faces[i])
        i = i + 1
    }
    (*p).loaded = 0
}

fn pan_ok(p: *mut Panorama) -> bool {
    return (*p).loaded == FACES
}

fn pan_load(p: *mut Panorama, pk: *mut mc_gui_pack.GuiPack) -> bool {
    var i: usize = 0
    while i < FACES {
        var name: rt.Buf = rt.buf_new()
        let pre: str = "minecraft/textures/gui/title/background/panorama_"
        rt.buf_push_bytes(&name, pre.p as u64, pre.length())
        rt.buf_push_dec_u64(&name, i as u64)
        rt.buf_push_bytes(&name, ".png".p as u64, 4)
        var raw: rt.Buf = rt.buf_new()
        var ok: bool = mc_gui_pack.gpack_asset(pk, rt.buf_str(&name), &raw)
        if ok { ok = mc_gui_tex.gtex_from_png(rt.buf_ptr(&raw), rt.buf_len(&raw), &(*p).faces[i]) }
        rt.buf_free(&raw)
        rt.buf_free(&name)
        if !ok || (*p).faces[i].w < 2 || (*p).faces[i].h < 2 {
            pan_free(p)
            return false
        }
        (*p).loaded = (*p).loaded + 1
        i = i + 1
    }
    return true
}

fn absf(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn pan_yaw(spin: f64) -> f64 {
    return 0.0 - spin * 0.1
}

fn pan_pitch(spin: f64) -> f64 {
    return math.sin(spin * 0.001) * 5.0 + 25.0
}

fn pan_face_uv(x: f64, y: f64, z: f64) -> FaceUv {
    let ax: f64 = absf(x)
    let ay: f64 = absf(y)
    let az: f64 = absf(z)
    if az >= ax && az >= ay {
        if z > 0.0 { return FaceUv { face: 0, u: 0.5 + 0.5 * x / az, v: 0.5 - 0.5 * y / az } }
        return FaceUv { face: 2, u: 0.5 - 0.5 * x / az, v: 0.5 - 0.5 * y / az }
    }
    if ax >= ay {
        if x > 0.0 { return FaceUv { face: 1, u: 0.5 - 0.5 * z / ax, v: 0.5 - 0.5 * y / ax } }
        return FaceUv { face: 3, u: 0.5 + 0.5 * z / ax, v: 0.5 - 0.5 * y / ax }
    }
    if y > 0.0 { return FaceUv { face: 4, u: 0.5 + 0.5 * x / ay, v: 0.5 + 0.5 * z / ay } }
    return FaceUv { face: 5, u: 0.5 + 0.5 * x / ay, v: 0.5 - 0.5 * z / ay }
}

fn texel(t: *mut mc_gui_tex.GuiTex, u: f64, v: f64) -> u32 {
    var x: i32 = (u * ((*t).w as f64)) as i32
    var y: i32 = (v * ((*t).h as f64)) as i32
    if x < 0 { x = 0 }
    if y < 0 { y = 0 }
    if x >= (*t).w { x = (*t).w - 1 }
    if y >= (*t).h { y = (*t).h - 1 }
    return rt.ld32((*t).px, (y as usize) * ((*t).w as usize) + (x as usize)) | (0xFF000000 as u32)
}

fn pan_render(r: *mut mc_raster.Raster, p: *mut Panorama, spin: f64) {
    if !pan_ok(p) { return }
    let yaw: f64 = pan_yaw(spin) * DEG
    let pit: f64 = pan_pitch(spin) * DEG
    let sy: f64 = math.sin(yaw)
    let cy: f64 = math.cos(yaw)
    let sp: f64 = math.sin(pit)
    let cp: f64 = math.cos(pit)
    let fx: f64 = sy * cp
    let fy: f64 = 0.0 - sp
    let fz: f64 = cy * cp
    let rx: f64 = cy
    let rz: f64 = 0.0 - sy
    let ux: f64 = sy * sp
    let uy: f64 = cp
    let uz: f64 = cy * sp
    let th: f64 = math.tan(FOV_DEG * DEG * 0.5)
    let asp: f64 = ((*r).w as f64) / ((*r).h as f64)
    var py: i32 = 0
    while py < (*r).h {
        let ny: f64 = (1.0 - ((py as f64) + 0.5) / ((*r).h as f64) * 2.0) * th
        var px: i32 = 0
        while px < (*r).w {
            let nx: f64 = (((px as f64) + 0.5) / ((*r).w as f64) * 2.0 - 1.0) * th * asp
            let dx: f64 = fx + rx * nx + ux * ny
            let dy: f64 = fy + uy * ny
            let dz: f64 = fz + rz * nx + uz * ny
            let fu: FaceUv = pan_face_uv(dx, dy, dz)
            rt.st32((*r).color, (py as usize) * ((*r).w as usize) + (px as usize), texel(&(*p).faces[fu.face as usize], fu.u, fu.v))
            px = px + 1
        }
        py = py + 1
    }
}
