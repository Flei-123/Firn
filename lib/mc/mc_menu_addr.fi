import std.rt
import mc.mc_hostname

export { addr_parse, DEFAULT_PORT }

const DEFAULT_PORT: i32 = 25565

fn all_digits(p: u64, n: usize) -> bool {
    if n == 0 || n > 5 { return false }
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 { return false }
        i = i + 1
    }
    return true
}

fn addr_parse(p: u64, n: usize, host_n: *mut usize, port: *mut i32) -> bool {
    *host_n = n
    *port = DEFAULT_PORT
    var k: usize = n
    while k > 0 && rt.ld8(p, k - 1) != 58 as u8 { k = k - 1 }
    if k > 0 && k < n && all_digits(p + k as u64, n - k) {
        var v: i32 = 0
        var i: usize = k
        while i < n {
            v = v * 10 + (rt.ld8(p, i) as i32 - 48)
            i = i + 1
        }
        if v <= 0 || v > 65535 { return false }
        let hn: usize = k - 1
        if mc_hostname.is_bracketed(p, n) || !mc_hostname.is_bracketed(p, hn) && hn > 0 {
            *host_n = hn
            *port = v
        }
    }
    return mc_hostname.host_valid(p, *host_n)
}
