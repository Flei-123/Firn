import mc.mc_item_name

export {
    use_kind_of, use_full_ms, use_progress_permille, use_bar_persists,
    USE_NONE, USE_BOW, USE_CROSSBOW, USE_TRIDENT, USE_EAT,
}

const USE_NONE: i32 = 0
const USE_BOW: i32 = 1
const USE_CROSSBOW: i32 = 2
const USE_TRIDENT: i32 = 3
const USE_EAT: i32 = 4

fn has(p: u64, n: usize, s: str) -> bool { return mc_item_name.name_has(p, n, s) }

fn excluded(p: u64, n: usize) -> bool {
    return has(p, n, "_spawn_egg") || has(p, n, "_seeds") || has(p, n, "_hide") || has(p, n, "_foot") || has(p, n, "fermented_")
    || has(p, n, "_on_a_stick") || has(p, n, "_bucket") || has(p, n, "splash_") || has(p, n, "lingering_") || has(p, n, "_boat") || has(p, n, "_block")
}

fn is_food(p: u64, n: usize) -> bool {
    if mc_item_name.name_is(p, n, "milk_bucket") || mc_item_name.name_is(p, n, "potion") { return true }
    if excluded(p, n) { return false }
    return has(p, n, "apple") || has(p, n, "melon_slice") || has(p, n, "berries") || has(p, n, "carrot") || has(p, n, "potato")
    || has(p, n, "beetroot") || has(p, n, "bread") || has(p, n, "cookie") || has(p, n, "pie") || has(p, n, "stew") || has(p, n, "soup")
    || has(p, n, "beef") || has(p, n, "porkchop") || has(p, n, "mutton") || has(p, n, "chicken") || has(p, n, "rabbit") || has(p, n, "cod")
    || has(p, n, "salmon") || has(p, n, "tropical_fish") || has(p, n, "pufferfish") || has(p, n, "rotten_flesh") || has(p, n, "spider_eye")
    || has(p, n, "chorus_fruit") || has(p, n, "dried_kelp") || has(p, n, "honey_bottle")
}

fn use_kind_of(p: u64, n: usize) -> i32 {
    if p == 0 as u64 { return USE_NONE }
    if mc_item_name.name_is(p, n, "bow") { return USE_BOW }
    if mc_item_name.name_is(p, n, "crossbow") { return USE_CROSSBOW }
    if mc_item_name.name_is(p, n, "trident") { return USE_TRIDENT }
    if is_food(p, n) { return USE_EAT }
    return USE_NONE
}

fn use_full_ms(kind: i32, p: u64, n: usize) -> u64 {
    if kind == USE_BOW { return 1000 as u64 }
    if kind == USE_CROSSBOW { return 1250 as u64 }
    if kind == USE_TRIDENT { return 500 as u64 }
    if mc_item_name.name_has(p, n, "dried_kelp") { return 800 as u64 }
    if mc_item_name.name_has(p, n, "honey_bottle") { return 2000 as u64 }
    return 1600 as u64
}

fn use_bar_persists(kind: i32) -> bool { return kind != USE_EAT }

fn use_progress_permille(kind: i32, full_ms: u64, elapsed: u64) -> i32 {
    if kind == USE_NONE || full_ms == 0 as u64 { return 0 - 1 }
    if elapsed >= full_ms {
        if use_bar_persists(kind) { return 1000 }
        return 0 - 1
    }
    return ((elapsed * 1000 as u64) / full_ms) as i32
}
