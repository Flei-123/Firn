export { InvDrag, idrag_new, idrag_press, idrag_hover, idrag_release, idrag_held, idrag_dragging, idrag_start_slot, idrag_button, idrag_type, EV_NONE, EV_BEGIN, EV_ADD, REL_CLICK, REL_END, REL_NONE }

const MAX_SLOTS: i32 = 96
const EV_NONE: i32 = 0
const EV_BEGIN: i32 = 1
const EV_ADD: i32 = 2
const REL_NONE: i32 = 0
const REL_CLICK: i32 = 1
const REL_END: i32 = 2

struct InvDrag {
    held: bool,
    dragging: bool,
    btn: i32,
    start: i32,
    n: i32,
    slots: [i32; 96],
}

fn idrag_new() -> InvDrag {
    return InvDrag { held: false, dragging: false, btn: 0, start: 0 - 1, n: 0, slots: [0; 96] }
}

fn idrag_held(d: *mut InvDrag) -> bool { return (*d).held }

fn idrag_dragging(d: *mut InvDrag) -> bool { return (*d).dragging }

fn idrag_start_slot(d: *mut InvDrag) -> i32 { return (*d).start }

fn idrag_button(d: *mut InvDrag) -> i32 { return (*d).btn }

fn idrag_type(d: *mut InvDrag) -> i32 {
    if (*d).btn == 1 { return 1 }
    return 0
}

fn idrag_press(d: *mut InvDrag, btn: i32, slot: i32) {
    (*d).held = true
    (*d).dragging = false
    (*d).btn = btn
    (*d).start = slot
    (*d).n = 0
}

fn contains(d: *mut InvDrag, slot: i32) -> bool {
    var i: i32 = 0
    while i < (*d).n {
        if (*d).slots[i as usize] == slot { return true }
        i = i + 1
    }
    return false
}

fn push(d: *mut InvDrag, slot: i32) {
    if (*d).n >= MAX_SLOTS { return }
    (*d).slots[(*d).n as usize] = slot
    (*d).n = (*d).n + 1
}

fn idrag_hover(d: *mut InvDrag, slot: i32) -> i32 {
    if !(*d).held || slot < 0 { return EV_NONE }
    if !(*d).dragging {
        if slot == (*d).start { return EV_NONE }
        (*d).dragging = true
        push(d, (*d).start)
        push(d, slot)
        return EV_BEGIN
    }
    if contains(d, slot) || (*d).n >= MAX_SLOTS { return EV_NONE }
    push(d, slot)
    return EV_ADD
}

fn idrag_release(d: *mut InvDrag) -> i32 {
    if !(*d).held { return REL_NONE }
    let was: bool = (*d).dragging
    (*d).held = false
    (*d).dragging = false
    if was { return REL_END }
    return REL_CLICK
}
