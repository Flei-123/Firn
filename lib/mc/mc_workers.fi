import std.cpus

export { workers_for_cores, workers_default, WORKERS_MIN, WORKERS_MAX, RESERVED_CORES }

const WORKERS_MIN: i32 = 2
const WORKERS_MAX: i32 = 12
const RESERVED_CORES: i32 = 2

fn workers_for_cores(cores: i32) -> i32 {
    var n: i32 = cores - RESERVED_CORES
    if n < WORKERS_MIN { n = WORKERS_MIN }
    if n > WORKERS_MAX { n = WORKERS_MAX }
    return n
}

fn workers_default() -> i32 {
    return workers_for_cores(cpus.cpu_count())
}
