import std.rt
import mc.mc_gui_ui

export { Notice, notice_new, notice_free, notice_clear, notice_set, notice_active, disc_frame, NOTICE_NONE, NOTICE_LOST, NOTICE_FAILED }

const NOTICE_NONE: i32 = 0
const NOTICE_LOST: i32 = 1
const NOTICE_FAILED: i32 = 2
const MAX_LINES: i32 = 8
const MAX_WIDTH: i32 = 300
const LINE_H: i32 = 10

struct Notice {
    kind: i32,
    text: rt.Buf,
}

fn notice_new() -> Notice {
    return Notice { kind: NOTICE_NONE, text: rt.buf_new() }
}

fn notice_free(n: *mut Notice) {
    rt.buf_free(&(*n).text)
}

fn notice_clear(n: *mut Notice) {
    (*n).kind = NOTICE_NONE
    rt.buf_clear(&(*n).text)
}

fn notice_set(n: *mut Notice, kind: i32, p: u64, len: usize) {
    rt.buf_clear(&(*n).text)
    if len > 0 { rt.buf_push_bytes(&(*n).text, p, len) }
    (*n).kind = kind
}

fn notice_active(n: *mut Notice) -> bool {
    return (*n).kind != NOTICE_NONE
}

fn line_end(u: *mut mc_gui_ui.Ui, p: u64, len: usize, start: usize, next: *mut usize) -> usize {
    var last_space: usize = 0
    var have_space: bool = false
    var i: usize = start
    while i < len {
        let ch: u8 = rt.ld8(p, i)
        if ch == 10 as u8 {
            *next = i + 1
            return i
        }
        let cut: str = str { p: (p + start as u64) as *u8, n: i + 1 - start }
        if mc_gui_ui.ui_text_width(u, cut) > MAX_WIDTH && i > start {
            if have_space {
                *next = last_space + 1
                return last_space
            }
            *next = i
            return i
        }
        if ch == 32 as u8 {
            last_space = i
            have_space = true
        }
        i = i + 1
    }
    *next = len
    return len
}

fn disc_frame(u: *mut mc_gui_ui.Ui, n: *mut Notice) -> bool {
    mc_gui_ui.ui_dirt(u, 0x404040)
    let cx: i32 = (*u).uw / 2
    let p: u64 = rt.buf_ptr(&(*n).text)
    let len: usize = rt.buf_len(&(*n).text)
    var lines: i32 = 0
    var start: usize = 0
    var rows: [usize; 16] = [0; 16]
    var ends: [usize; 16] = [0; 16]
    while start < len && lines < MAX_LINES {
        var next: usize = start
        let e: usize = line_end(u, p, len, start, &next)
        rows[lines as usize] = start
        ends[lines as usize] = e
        lines = lines + 1
        if next <= start { next = start + 1 }
        start = next
    }
    let total: i32 = 30 + lines * LINE_H + 24
    let top: i32 = (*u).uh / 2 - total / 2
    var title: str = mc_gui_ui.ui_lang(u, "disconnect.lost", "Connection Lost")
    if (*n).kind == NOTICE_FAILED { title = mc_gui_ui.ui_lang(u, "connect.failed", "Failed to connect to the server") }
    mc_gui_ui.ui_label_c(u, cx, top, mc_gui_ui.COLOR_WHITE, title)
    var i: i32 = 0
    while i < lines {
        let a: usize = rows[i as usize]
        let b: usize = ends[i as usize]
        let ln: str = str { p: (p + a as u64) as *u8, n: b - a }
        mc_gui_ui.ui_label_c(u, cx, top + 20 + i * LINE_H, mc_gui_ui.COLOR_GRAY, ln)
        i = i + 1
    }
    return mc_gui_ui.ui_button(u, cx - 100, top + 30 + lines * LINE_H, 200, mc_gui_ui.ui_lang(u, "gui.toMenu", "Back to Server List"), true)
}
