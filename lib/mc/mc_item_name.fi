import std.rt

export { name_has, name_is }

fn name_has(p: u64, n: usize, needle: str) -> bool {
    if needle.n > n { return false }
    var i: usize = 0
    while i + needle.n <= n {
        var j: usize = 0
        while j < needle.n && rt.ld8(p, i + j) == rt.ld8(needle.p as u64, j) { j = j + 1 }
        if j == needle.n { return true }
        i = i + 1
    }
    return false
}

fn name_is(p: u64, n: usize, lit: str) -> bool {
    return n == lit.n && rt.mem_eq(p, lit.p as u64, n)
}
