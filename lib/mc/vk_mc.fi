// SPDX-License-Identifier: MPL-2.0
// lib/mc/vk_mc.fi -- mc.vk_mc: the Vulkan back end of the voxel client (docs/VK-RENDERER.md). Same `mc_backend.Backend` table as the CPU
// rasterizer (the reference) and lib/gpu/gl_mc.fi:
//
//     var vb: vk_mc.VkBackend = vk_mc.vkbe_open(640, 360)           // loader + device (lavapipe allowed) + targets + pipelines
//     if vb.ok {
//         var b: mc_backend.Backend = vk_mc.vkbe_backend(&vb)
//         b.upload_atlas(b.obj, (&atlas) as u64)                       // texture array, staged copy + layout transitions
//         b.begin(b.obj, (&cam) as u64, 0xFFE6BE96 as u32)
//         let h: usize = b.mesh_upload(b.obj, key, verts, nverts, idx, nidx)    // staging buffer -> device local buffer (batched)
//         b.draw(b.obj, h, ox, oy, oz)
//         b.end(b.obj)                                                 // submit, signals the slot fence (frame in flight)
//         let px: u64 = b.present(b.obj)                               // waits for the last frame, RGBA, row 0 = top
//     }
//
// Parts: vk_mem (suballocating allocator), vk_desc (render pass + depth, descriptor sets, pipeline), vk_frame (frames in flight,
// barriers, immediate submit). Two frames in flight: every slot owns colour + depth image, framebuffer, UBO, read back buffer, descriptor
// set, command buffer, fence. `end` does not wait; `begin` waits for the slot it reuses; `present` waits for the newest frame.
// Mesh upload: vertices + indices of one mesh in ONE device buffer; the copy is recorded into the upload command buffer of the next
// frame slot (submitted before that frame, one barrier to vertex/index reads), staging buffers and freed meshes are released once the
// frame that could use them has finished. Shaders: lib/gpu/vk_shaders.fi (VK2, docs/VK-RENDERER.md): Frame UBO slices with dynamic offset,
// push constants 16 B (origin), pipeline cache from gpu.vk_life. Scene layer (roadmap r180): vkbe_sky (right after begin), draw_entities (Backend table, instanced unit cube, one draw), vkbe_tint,
// vkbe_hud(rec) (last, before end); each switches the pipeline through bind_pipe, UBO slices carry the sky / tint / invert values; HUD
// rectangles and entity instances live in a per-frame bump buffer (DYN_BYTES).
// THREADS: main thread only.

import std.rt
import std.time
import mc.mc_backend
import mc.mc_camera
import mc.mc_texture
import mc.mc_math
import mc.mc_sky
import gpu.vk
import gpu.vk_mem
import gpu.vk_desc
import gpu.vk_frame
import gpu.vk_shaders
import gpu.vk_life

export {
    VkBackend, vkbe_open, vkbe_open_cache, vkbe_on_rebuild, vkbe_close, vkbe_backend, vkbe_set_fog, vkbe_set_light, vkbe_resize, vkbe_device_name, vkbe_is_cpu,
    vkbe_draws, vkbe_tris, vkbe_frames, vkbe_layers_lost, vkbe_in_flight, vkbe_set_readback, vkbe_wait, vkbe_mem_stats,
    vkbe_live_meshes, vkbe_upload_bytes, vkbe_frame_ms, vkbe_sky, vkbe_tint, vkbe_hud, vkbe_blank, vkbe_open_into, vkbe_lost, vkbe_inject_lost,
    vkbe_open_win, vkbe_sc_on, vkbe_window_pixels, vkbe_sc_stat, SC_PRESENTS, SC_SKIPS, SC_REBUILDS, SC_OUT_OF_DATE, SC_SUBOPTIMAL, SC_FORMAT,
}

const SC_PRESENTS: i32 = 0 // vkbe_sc_stat selectors
const SC_SKIPS: i32 = 1 // frames that were rendered but not presented (acquire failed / swapchain not ready)
const SC_REBUILDS: i32 = 2
const SC_OUT_OF_DATE: i32 = 3
const SC_SUBOPTIMAL: i32 = 4
const SC_FORMAT: i32 = 5 // swapchain VkFormat (44 BGRA8, 37 RGBA8)
const NFR: usize = 2 // frames in flight
const UBO_STRIDE: usize = 512 // one `Frame` slice (320 octets used); >= minUniformBufferOffsetAlignment (256 at most)
const UBO_SLICES: usize = 256 // slices per frame slot: one per (pass / fade / light) state change
const UBO_BYTES: u64 = 131072 // UBO_STRIDE * UBO_SLICES
const DYN_BYTES: u64 = 4194304 // per frame slot: HUD rectangles + entity instances
const TB_BYTES: u64 = 256 // dummy texel buffers (pool mode off): zero filled
const PAGEL_SINGLE: u64 = 1073741824 // u_pagel >= 1048576: the whole atlas is ONE array (page 0)
const HUD_REC_BYTES: usize = 24 // one mc_hud.hud_record rectangle: x0 y0 x1 y1 colour mode (u32 each)
const CUBE_IB: u64 = 384 // byte offset of the 36 u16 cube indices (24 vertices * 16 octets before it)
const CUBE_BYTES: u64 = 512
const ENT_INST_BYTES: usize = 48 // 3 x vec4 per box instance
const MW: usize = 8 // words per mesh slot
const M_USED: usize = 0
const M_BUF: usize = 1
const M_BLK: usize = 2
const M_OFF: usize = 3
const M_SIZE: usize = 4
const M_IOFF: usize = 5
const M_NIDX: usize = 6
const M_KEY: usize = 7
const DW: usize = 6 // words per deferred release
const D_KIND: usize = 0 // 0 = mesh buffer (+ its allocation), 1 = staging buffer
const D_BUF: usize = 1
const D_BLK: usize = 2
const D_OFF: usize = 3
const D_SIZE: usize = 4
const D_TAG: usize = 5 // free once frames.done >= tag

struct FSlot {
    col: vk_mem.Img,
    dep: vk_mem.Img,
    fb: u64,
    ubo: vk_mem.Buf,
    rb: vk_mem.Buf, // read back buffer (w * h * 4)
    dyn: vk_mem.Buf, // per frame vertex data (HUD runs, entity instances), bump allocated, reset at begin
}

struct VkBackend {
    ok: bool,
    step: i32, // 0 ok, 1 = no Vulkan device/loader, 2 = function table, 3 = frames/descriptors, 4 = render pass/pipelines, 5 = targets, 6 = shaders
    v: vk.Vk,
    x: vk_mem.X,
    fr: vk_frame.Frames,
    d: vk_desc.Desc,
    life: vk_life.Life, // pipeline cache (v.cache) + device lost / swapchain bookkeeping
    cache_path: str,
    base: u64, // FRAME_SIZE octets: the per-frame part of the Frame UBO, copied into every slice
    nslice: usize, // slices baked in the current frame
    slice_off: u64, // dynamic offset of the newest slice
    ubo_over: u64, // slices that did not fit (state changes beyond UBO_SLICES in one frame)
    dirty: bool, // pass / fade / light changed since the last bake
    gran: vk_mem.Buf, // dummy texel buffers for bindings 5 / 6
    org: vk_mem.Buf,
    gran_view: u64,
    org_view: u64,
    w: i32,
    h: i32,
    rp: u64,
    playout: u64,
    pipe_op: vk_desc.VPipe,
    pipe_tr: vk_desc.VPipe,
    pipe_sky: vk_desc.VPipe,
    pipe_tint: vk_desc.VPipe,
    pipe_hud: vk_desc.VPipe,
    pipe_ent: vk_desc.VPipe,
    cube: vk_mem.Buf, // unit cube for the entity boxes: 24 vertices (pos f32 x3 + face f32) at 0, 36 u16 indices at CUBE_IB
    ents_drawn: u64,
    pipe_hud_inv: vk_desc.VPipe,
    dyn_top: u64,
    dyn_over: u64, // allocations that did not fit into DYN_BYTES in one frame
    inv_on: bool, // U_INVERT of the next bake (HUD invert runs)
    bound: u64, // pipeline currently bound in the recording command buffer (0 = none)
    fs: [FSlot; 2],
    atlas: vk_mem.Img,
    tile: i32,
    layers_lost: i32,
    meshes: u64, // mcap * MW words
    mcap: usize,
    live: usize,
    dfr: u64, // dcap * DW words
    dcap: usize,
    dn: usize,
    // frame state
    cur: usize, // slot being recorded
    next: usize, // slot the next begin uses
    in_frame: bool,
    has_last: bool,
    last: usize, // newest submitted slot
    trec: bool, // the upload command buffer of slot `next` is recording
    readback: bool,
    lost: bool, // a submit failed (or vkbe_inject_lost): the device is treated as lost; the caller closes and re-opens the back end
    inject_lost: bool, // simulated loss: the next end() does not submit and marks the back end lost (lavapipe never loses a device)
    trans: bool,
    cx: f64,
    cy: f64,
    cz: f64,
    fade_a: f64,
    fade_inv: f64,
    day: f64,
    tr: f64,
    tg: f64,
    tb: f64,
    fog_on: bool,
    fog_start: f64,
    fog_end: f64,
    fog_r: f64,
    fog_g: f64,
    fog_b: f64,
    draws: u64,
    tris: u64,
    frames: u64,
    upload_bytes: u64,
    t0_ns: u64,
    frame_ns: u64,
    push: u64, // 16 octets scratch for the push constants (origin.xyz + pool)
    vb: u64, // 8 octets: the vertex buffer handle for vkCmdBindVertexBuffers + offset
    // swapchain present (r195): the colour image is blitted into the swapchain image in end(); readback stays for shots / tests
    sc: vk.Sc,
    sc_on: bool, // a swapchain on the window exists and its images accept TRANSFER_DST
    sc_ready: bool, // false while minimised / a rebuild failed: frames are rendered but not presented
    sc_xid: u64,
    sc_mode: i32,
    sc_gen: u64, // life.sc_gen of the last swapchain the per-slot semaphores were made for
    sc_surface_lost: bool,
    sc_presents: u64,
    sc_skips: u64,
}

fn fslot_none() -> FSlot {
    return FSlot { col: vk_mem.img_none(), dep: vk_mem.img_none(), fb: 0, ubo: vk_mem.buf_none(), rb: vk_mem.buf_none(), dyn: vk_mem.buf_none() }
}

fn blank() -> VkBackend {
    return VkBackend { ok: false, step: 0, v: vk.vk_new(), x: vk_mem.x_new(),
        fr: vk_frame.Frames { ok: false, pool: 0, n: 0, w: 0, icmd: 0, ifence: 0, serial: 0, done: 0, tpending: false },
        d: vk_desc.desc_none(), life: vk_life.life_new(), cache_path: "", base: 0, nslice: 0, slice_off: 0, ubo_over: 0, dirty: true,
        gran: vk_mem.buf_none(), org: vk_mem.buf_none(), gran_view: 0, org_view: 0, w: 0, h: 0, rp: 0, playout: 0, pipe_op: vk_desc.vpipe_none(), pipe_tr: vk_desc.vpipe_none(), pipe_sky: vk_desc.vpipe_none(), pipe_tint: vk_desc.vpipe_none(), pipe_hud: vk_desc.vpipe_none(), pipe_ent: vk_desc.vpipe_none(), cube: vk_mem.buf_none(), ents_drawn: 0, pipe_hud_inv: vk_desc.vpipe_none(), dyn_top: 0, dyn_over: 0, inv_on: false, bound: 0,
        fs: [fslot_none(); 2], atlas: vk_mem.img_none(), tile: 0, layers_lost: 0, meshes: 0, mcap: 0, live: 0, dfr: 0, dcap: 0,
        dn: 0, cur: 0, next: 0, in_frame: false, has_last: false, last: 0, trec: false, readback: true, lost: false, inject_lost: false, trans: false,
        cx: 0.0, cy: 0.0, cz: 0.0, fade_a: 64.0, fade_inv: 0.0, day: 256.0, tr: 256.0, tg: 256.0, tb: 256.0, fog_on: false,
        fog_start: 20.0, fog_end: 90.0, fog_r: 150.0, fog_g: 190.0, fog_b: 230.0, draws: 0, tris: 0,
        frames: 0, upload_bytes: 0, t0_ns: 0, frame_ns: 0, push: 0, vb: 0,
        sc: vk.sc_blank(), sc_on: false, sc_ready: false, sc_xid: 0, sc_mode: 0, sc_gen: 0, sc_surface_lost: false, sc_presents: 0, sc_skips: 0 }
}

// The 24 vertices (x y z face as f32, faces -x +x -y +y -z +z) and 36 u16 indices of the unit cube -0.5 .. 0.5 (same order as gl_scene).
fn cube_fill(p: u64) {
    var f: usize = 0
    while f < 6 {
        let axis: usize = f / 2
        var sgn: f64 = 0.0 - 0.5
        if f % 2 == 1 { sgn = 0.5 }
        var k: usize = 0
        while k < 4 {
            var a: f64 = 0.0 - 0.5
            if k % 2 == 1 { a = 0.5 }
            var bb: f64 = 0.0 - 0.5
            if k / 2 == 1 { bb = 0.5 }
            var c: [f64; 3] = [0.0, 0.0, 0.0]
            c[axis] = sgn
            c[(axis + 1) % 3] = a
            c[(axis + 2) % 3] = bb
            let o: usize = (f * 4 + k) * 16
            vk_mem.wf(p, o, c[0])
            vk_mem.wf(p, o + 4, c[1])
            vk_mem.wf(p, o + 8, c[2])
            vk_mem.wf(p, o + 12, f as f64)
            k = k + 1
        }
        let base: u16 = (f * 4) as u16
        let ip: u64 = p + CUBE_IB + (f as u64) * (12 as u64)
        *(ip as *mut u16) = base
        *((ip + 2 as u64) as *mut u16) = base + 1 as u16
        *((ip + 4 as u64) as *mut u16) = base + 3 as u16
        *((ip + 6 as u64) as *mut u16) = base
        *((ip + 8 as u64) as *mut u16) = base + 3 as u16
        *((ip + 10 as u64) as *mut u16) = base + 2 as u16
        f = f + 1
    }
}

fn rec_f(p: u64, i: usize) -> f64 {
    return *((p + (i as u64) * (8 as u64)) as *mut f64)
}

// ---- targets (colour + depth + framebuffer + UBO + read back per slot) -------------------------------------------------------
fn targets_free(b: *mut VkBackend) {
    var i: usize = 0
    while i < NFR {
        if (*b).fs[i].fb != 0 {
            vk_mem.cx(&(*b).x, vk_mem.X_DESTROY_FB, (*b).x.dev, (*b).fs[i].fb, 0, 0, 0, 0, 0, 0, 0, 0)
            (*b).fs[i].fb = 0
        }
        vk_mem.img_free(&(*b).x, &(*b).fs[i].col)
        vk_mem.img_free(&(*b).x, &(*b).fs[i].dep)
        vk_mem.buf_free(&(*b).x, &(*b).fs[i].ubo)
        vk_mem.buf_free(&(*b).x, &(*b).fs[i].rb)
        vk_mem.buf_free(&(*b).x, &(*b).fs[i].dyn)
        i = i + 1
    }
}

fn targets_make(b: *mut VkBackend) -> bool {
    var i: usize = 0
    while i < NFR {
        // colour: render target + copy source
        (*b).fs[i].col = vk_mem.img_make(&(*b).x, (*b).w as u32, (*b).h as u32, 1 as u32, vk_desc.FMT_RGBA8, 0x11 as u64, 1 as u64)
        (*b).fs[i].dep = vk_desc.depth_make(&(*b).x, (*b).w as u32, (*b).h as u32)
        if !(*b).fs[i].col.ok || !(*b).fs[i].dep.ok {
            return false
        }
        (*b).fs[i].fb = vk_desc.fb_make2(&(*b).x, (*b).rp, (*b).fs[i].col.view, (*b).fs[i].dep.view, (*b).w as u32, (*b).h as u32)
        if (*b).fs[i].fb == 0 {
            return false
        }
        if !(*b).fs[i].ubo.ok {
            (*b).fs[i].ubo = vk_mem.buf_make(&(*b).x, UBO_BYTES, vk_mem.U_UNIFORM, vk_mem.MEM_STAGING)
            if !(*b).fs[i].ubo.ok {
                return false
            }
            vk_desc.desc_write_ubo(&(*b).x, &(*b).d, i, (*b).fs[i].ubo.buf, vk_shaders.FRAME_SIZE as u64)
        }
        (*b).fs[i].dyn = vk_mem.buf_make(&(*b).x, DYN_BYTES, vk_mem.U_VERTEX, vk_mem.MEM_STAGING)
        if !(*b).fs[i].dyn.ok {
            return false
        }
        (*b).fs[i].rb = vk_mem.buf_make(&(*b).x, ((*b).w as u64) * ((*b).h as u64) * 4, vk_mem.U_DST, vk_mem.MEM_STAGING)
        if !(*b).fs[i].rb.ok {
            return false
        }
        i = i + 1
    }
    return true
}

// Bindings 5 / 6 (pool mode) are not used by this backend yet (one draw per section): zero filled dummy texel buffers keep the
// descriptor sets complete.
fn texel_dummies(b: *mut VkBackend) -> bool {
    (*b).gran = vk_mem.buf_make(&(*b).x, TB_BYTES, vk_mem.U_TEXEL, vk_mem.MEM_STAGING)
    (*b).org = vk_mem.buf_make(&(*b).x, TB_BYTES, vk_mem.U_TEXEL, vk_mem.MEM_STAGING)
    if !(*b).gran.ok || !(*b).org.ok {
        return false
    }
    rt.mem_set((*b).gran.ptr, 0 as u8, TB_BYTES as usize)
    rt.mem_set((*b).org.ptr, 0 as u8, TB_BYTES as usize)
    (*b).gran_view = vk_desc.bview_make(&(*b).x, (*b).gran.buf, vk_desc.FMT_R32UI, TB_BYTES)
    (*b).org_view = vk_desc.bview_make(&(*b).x, (*b).org.buf, vk_desc.FMT_RGBA32F, TB_BYTES)
    if (*b).gran_view == 0 || (*b).org_view == 0 {
        return false
    }
    var i: usize = 0
    while i < NFR {
        vk_desc.desc_write_texel(&(*b).x, &(*b).d, i, vk_shaders.B_GRAN as u64, (*b).gran_view)
        vk_desc.desc_write_texel(&(*b).x, &(*b).d, i, vk_shaders.B_ORG as u64, (*b).org_view)
        i = i + 1
    }
    return true
}

fn vkbe_open(w: i32, h: i32) -> VkBackend {
    return vkbe_open_cache(w, h, "")
}

// `cache_path` != "": the pipeline cache lives in that file (loaded now when valid for this device, saved by vkbe_close).
// Opens IN PLACE (the structures keep pointers into `*b`: do not copy a VkBackend after this). false = see `b.step`.
fn vkbe_open_into(b: *mut VkBackend, w: i32, h: i32, cache_path: str) -> bool {
    return vkbe_open_win(b, w, h, cache_path, 0, 0)
}

// Like vkbe_open_into, plus a swapchain on the X11 window `xid` (mode 0 = xlib surface, 1 = xcb) when xid != 0: end() then blits the colour image
// into the swapchain image and presents it (Present = swapchain, no readback needed). No surface / swapchain / TRANSFER_DST support = the back
// end still opens, `vkbe_sc_on` is false and the caller presents the read back image as before. The window must exist (and be mapped).
fn vkbe_open_win(b: *mut VkBackend, w: i32, h: i32, cache_path: str, xid: u64, mode: i32) -> bool {
    *b = blank()
    (*b).w = w
    (*b).h = h
    (*b).cache_path = cache_path
    (*b).sc_xid = xid
    (*b).sc_mode = mode
    if !vk.open(&(*b).v, xid != 0, true) {
        (*b).step = 1
        return false
    }
    if !vk_mem.x_open(&(*b).x, &(*b).v) {
        (*b).step = 2
        return false
    }
    if !vk_life.life_open(&(*b).v, &(*b).life) {
        (*b).step = 2
        return false
    }
    vk_life.cache_open(&(*b).v, &(*b).life, cache_path) // never fails the open: pipelines also work uncached
    (*b).fr = vk_frame.frames_new(&(*b).x, NFR)
    (*b).d = vk_desc.desc_new(&(*b).x, NFR)
    if !(*b).fr.ok || !(*b).d.ok {
        (*b).step = 3
        return false
    }
    if !texel_dummies(b) {
        (*b).step = 3
        return false
    }
    (*b).rp = vk_desc.rpass_voxel(&(*b).x, vk_desc.FMT_RGBA8, vk_desc.FINAL_TRANSFER_SRC)
    (*b).playout = vk_desc.playout_make(&(*b).x, (*b).d.dsl)
    if (*b).rp == 0 || (*b).playout == 0 {
        (*b).step = 4
        return false
    }
    (*b).pipe_op = vk_desc.pipeline_voxel(&(*b).x, (*b).v.cache, (*b).rp, (*b).playout, vk_shaders.MC_VS.p as u64, vk_shaders.MC_VS.n,
        vk_shaders.MC_FS.p as u64, vk_shaders.MC_FS.n, false)
    (*b).pipe_tr = vk_desc.pipeline_voxel(&(*b).x, (*b).v.cache, (*b).rp, (*b).playout, vk_shaders.MC_VS.p as u64, vk_shaders.MC_VS.n,
        vk_shaders.MC_FS.p as u64, vk_shaders.MC_FS.n, true)
    var ssp: vk_desc.PipeSpec = vk_desc.spec_new(vk_shaders.SKY_VS.p as u64, vk_shaders.SKY_VS.n, vk_shaders.SKY_FS.p as u64, vk_shaders.SKY_FS.n)
    ssp.topo = vk_desc.TOPO_STRIP
    (*b).pipe_sky = vk_desc.pipeline_make(&(*b).x, (*b).v.cache, (*b).rp, (*b).playout, &ssp)
    // tint: the same strip, only where the world left depth < 1 (fragment depth 1.0 GREATER), no depth write, colour * tint (DST_COLOR, ZERO)
    var tsp: vk_desc.PipeSpec = vk_desc.spec_new(vk_shaders.TINT_VS.p as u64, vk_shaders.TINT_VS.n, vk_shaders.TINT_FS.p as u64, vk_shaders.TINT_FS.n)
    tsp.topo = vk_desc.TOPO_STRIP
    tsp.depth_test = true
    tsp.depth_op = vk_desc.CMP_GREATER
    tsp.blend = vk_desc.BLEND_MUL
    (*b).pipe_tint = vk_desc.pipeline_make(&(*b).x, (*b).v.cache, (*b).rp, (*b).playout, &tsp)
    // HUD: one instance per rectangle straight from the mc_hud.hud_record records (24 octets: x0 y0 x1 y1 colour mode), strip of 4; colour
    // only (alpha untouched), alpha blend or invert (mode 1, U_INVERT)
    var hsp: vk_desc.PipeSpec = vk_desc.spec_new(vk_shaders.HUD_VS.p as u64, vk_shaders.HUD_VS.n, vk_shaders.HUD_FS.p as u64, vk_shaders.HUD_FS.n)
    vk_desc.spec_bind(&hsp, HUD_REC_BYTES as u32, true)
    vk_desc.spec_attr(&hsp, 0 as u32, 0 as u32, vk_desc.FMT_R32G32B32A32_SINT, 0 as u32)
    vk_desc.spec_attr(&hsp, 1 as u32, 0 as u32, vk_desc.FMT_R32_UINT, 16 as u32)
    hsp.topo = vk_desc.TOPO_STRIP
    hsp.wmask = 7 as u32
    hsp.blend = vk_desc.BLEND_ALPHA
    (*b).pipe_hud = vk_desc.pipeline_make(&(*b).x, (*b).v.cache, (*b).rp, (*b).playout, &hsp)
    hsp.blend = vk_desc.BLEND_INVERT
    (*b).pipe_hud_inv = vk_desc.pipeline_make(&(*b).x, (*b).v.cache, (*b).rp, (*b).playout, &hsp)
    // entities: instanced unit cube (binding 0 per vertex: pos + face, binding 1 per instance: 3 x vec4), depth LESS with write, no culling
    var esp: vk_desc.PipeSpec = vk_desc.spec_new(vk_shaders.ENT_VS.p as u64, vk_shaders.ENT_VS.n, vk_shaders.ENT_FS.p as u64, vk_shaders.ENT_FS.n)
    vk_desc.spec_bind(&esp, vk_shaders.ENT_VERT_STRIDE as u32, false)
    vk_desc.spec_bind(&esp, vk_shaders.ENT_INST_STRIDE as u32, true)
    vk_desc.spec_attr(&esp, 0 as u32, 0 as u32, vk_desc.FMT_R32G32B32_SFLOAT, 0 as u32)
    vk_desc.spec_attr(&esp, 1 as u32, 0 as u32, vk_desc.FMT_R32_SFLOAT, 12 as u32)
    vk_desc.spec_attr(&esp, 2 as u32, 1 as u32, vk_desc.FMT_R32G32B32A32_SFLOAT, 0 as u32)
    vk_desc.spec_attr(&esp, 3 as u32, 1 as u32, vk_desc.FMT_R32G32B32A32_SFLOAT, 16 as u32)
    vk_desc.spec_attr(&esp, 4 as u32, 1 as u32, vk_desc.FMT_R32G32B32A32_SFLOAT, 32 as u32)
    esp.depth_test = true
    esp.depth_write = true
    (*b).pipe_ent = vk_desc.pipeline_make(&(*b).x, (*b).v.cache, (*b).rp, (*b).playout, &esp)
    (*b).cube = vk_mem.buf_make(&(*b).x, CUBE_BYTES, vk_mem.U_VERTEX | vk_mem.U_INDEX, vk_mem.MEM_STAGING)
    if (*b).cube.ok { cube_fill((*b).cube.ptr) }
    if !(*b).pipe_op.ok || !(*b).pipe_tr.ok || !(*b).pipe_sky.ok || !(*b).pipe_tint.ok || !(*b).pipe_hud.ok || !(*b).pipe_hud_inv.ok || !(*b).pipe_ent.ok || !(*b).cube.ok {
        (*b).step = 6
        return false
    }
    (*b).mcap = 64
    (*b).meshes = rt.heap_alloc((*b).mcap * MW * 8)
    rt.mem_set((*b).meshes, 0 as u8, (*b).mcap * MW * 8)
    (*b).dcap = 1024
    (*b).dfr = rt.heap_alloc((*b).dcap * DW * 8)
    (*b).push = rt.heap_alloc(64)
    (*b).base = rt.heap_alloc(vk_shaders.FRAME_SIZE)
    rt.mem_set((*b).base, 0 as u8, vk_shaders.FRAME_SIZE)
    (*b).vb = rt.heap_alloc(32)
    if !targets_make(b) {
        (*b).step = 5
        return false
    }
    (*b).ok = true
    if xid != 0 { sc_start(b) }
    return true
}

// Swapchain on the window (see vkbe_open_win). Failure only leaves sc_on false.
fn sc_start(b: *mut VkBackend) {
    if !vk.has_swapchain(&(*b).v) || !vk.has_surface_ext(&(*b).v) { return }
    if !vk.sc_open(&(*b).v, &(*b).sc, (*b).sc_xid, (*b).w, (*b).h, (*b).sc_mode) {
        vk.sc_close(&(*b).v, &(*b).sc)
        return
    }
    if !(*b).sc.xfer {
        vk.sc_close(&(*b).v, &(*b).sc)
        return
    }
    (*b).life.req_w = (*b).w
    (*b).life.req_h = (*b).h
    (*b).life.need_rebuild = false
    (*b).sc_gen = (*b).life.sc_gen
    (*b).sc_on = true
    (*b).sc_ready = true
}

// The swapchain needs a rebuild (size change, OUT_OF_DATE, SUBOPTIMAL, surface lost) or came back from minimised: wait for the frames, rebuild
// through vk_life, re-create the per-slot semaphores (a failed acquire / present may leave one signalled). Sets sc_ready.
fn sc_resync(b: *mut VkBackend) {
    vk_frame.frame_wait_all(&(*b).x, &(*b).fr)
    reap(b)
    if (*b).sc_surface_lost {
        (*b).sc_surface_lost = false
        if !vk_life.surface_recover(&(*b).v, &(*b).life, &(*b).sc, (*b).sc_xid, (*b).w, (*b).h, (*b).sc_mode) {
            (*b).sc_ready = false
            return
        }
    }
    let st: i32 = vk_life.sc_sync(&(*b).v, &(*b).life, &(*b).sc, (*b).w, (*b).h)
    if st == vk_life.LF_OK {
        if (*b).life.sc_gen != (*b).sc_gen {
            vk_frame.frame_sems_reset(&(*b).x, &(*b).fr)
            (*b).sc_gen = (*b).life.sc_gen
        }
        (*b).sc_ready = true
        return
    }
    (*b).sc_ready = false
    if st == vk_life.LF_DEVICE_LOST { (*b).lost = true }
}

// true when end() presents through a swapchain.
fn vkbe_sc_on(b: *mut VkBackend) -> bool {
    return (*b).sc_on
}

// What the X server shows in the window right now (w*h RGBA octets, waits for the queue first). false without a swapchain.
fn vkbe_window_pixels(b: *mut VkBackend, out: u64) -> bool {
    if !(*b).sc_on { return false }
    return vk.window_pixels(&(*b).v, &(*b).sc, out)
}

// Swapchain counters (SC_*), 0 without a swapchain.
fn vkbe_sc_stat(b: *mut VkBackend, which: i32) -> u64 {
    if which == SC_PRESENTS { return (*b).sc_presents }
    if which == SC_SKIPS { return (*b).sc_skips }
    if which == SC_REBUILDS { return (*b).life.rebuilds }
    if which == SC_OUT_OF_DATE { return (*b).life.out_of_date }
    if which == SC_SUBOPTIMAL { return (*b).life.suboptimal }
    if which == SC_FORMAT { return (*b).sc.fmt }
    return 0
}

fn vkbe_open_cache(w: i32, h: i32, cache_path: str) -> VkBackend {
    var b: VkBackend = blank()
    let ok: bool = vkbe_open_into(&b, w, h, cache_path)
    return b
}

fn vkbe_device_name(b: *mut VkBackend) -> u64 {
    return vk.device_name(&(*b).v)
}

fn vkbe_is_cpu(b: *mut VkBackend) -> bool {
    return vk.is_cpu(&(*b).v)
}

fn vkbe_draws(b: *mut VkBackend) -> u64 {
    return (*b).draws
}

fn vkbe_tris(b: *mut VkBackend) -> u64 {
    return (*b).tris
}

fn vkbe_frames(b: *mut VkBackend) -> u64 {
    return (*b).frames
}

fn vkbe_layers_lost(b: *mut VkBackend) -> i32 {
    return (*b).layers_lost
}

fn vkbe_live_meshes(b: *mut VkBackend) -> usize {
    return (*b).live
}

fn vkbe_upload_bytes(b: *mut VkBackend) -> u64 {
    return (*b).upload_bytes
}

// wall time of the last frame from begin to the end of present (ns)
fn vkbe_frame_ms(b: *mut VkBackend) -> f64 {
    return ((*b).frame_ns as f64) / 1000000.0
}

// frames submitted and not yet known to be finished
fn vkbe_in_flight(b: *mut VkBackend) -> u64 {
    return (*b).fr.serial - (*b).fr.done
}

fn vkbe_mem_stats(b: *mut VkBackend, out: *mut [u64; 4]) {
    vk_mem.mem_stats(&(*b).x, out)
}

// read back the colour image into the slot's host buffer at the end of every frame (default on); off = the frame only renders
// An empty (not open) back end value, e.g. for a struct field that is filled later.
fn vkbe_blank() -> VkBackend {
    return blank()
}

// true after a failed frame submit or a simulated loss; no GPU call is made on a lost back end (begin / end return at once).
fn vkbe_lost(b: *mut VkBackend) -> bool {
    return (*b).lost
}

// Tests: the next end() behaves as VK_ERROR_DEVICE_LOST (nothing is submitted).
fn vkbe_inject_lost(b: *mut VkBackend) {
    (*b).inject_lost = true
}

fn vkbe_set_readback(b: *mut VkBackend, on: bool) {
    (*b).readback = on
}

fn vkbe_set_light(b: *mut VkBackend, day: i32, tr: i32, tg: i32, tb: i32) {
    (*b).day = day as f64
    (*b).tr = tr as f64
    (*b).tg = tg as f64
    (*b).tb = tb as f64
    (*b).dirty = true
}

fn vkbe_set_fog(b: *mut VkBackend, on: bool, start: f64, end: f64, r: u32, g: u32, bl: u32) {
    (*b).fog_on = on
    (*b).fog_start = start
    (*b).fog_end = end
    (*b).fog_r = r as f64
    (*b).fog_g = g as f64
    (*b).fog_b = bl as f64
}

// ---- deferred releases ---------------------------------------------------------------------------------------------------
fn reap(b: *mut VkBackend) {
    var i: usize = 0
    var keep: usize = 0
    while i < (*b).dn {
        let q: usize = i * DW
        if rt.ld64((*b).dfr, q + D_TAG) <= (*b).fr.done {
            vk_mem.cx(&(*b).x, vk_mem.X_DESTROY_BUFFER, (*b).x.dev, rt.ld64((*b).dfr, q + D_BUF), 0, 0, 0, 0, 0, 0, 0, 0)
            var a: vk_mem.Alloc = vk_mem.alloc_none()
            a.ok = true
            a.blk = rt.ld64((*b).dfr, q + D_BLK) as usize
            a.off = rt.ld64((*b).dfr, q + D_OFF)
            a.size = rt.ld64((*b).dfr, q + D_SIZE)
            vk_mem.mem_free(&(*b).x, &a)
        } else {
            if keep != i {
                var k: usize = 0
                while k < DW {
                    rt.st64((*b).dfr, keep * DW + k, rt.ld64((*b).dfr, q + k))
                    k = k + 1
                }
            }
            keep = keep + 1
        }
        i = i + 1
    }
    (*b).dn = keep
}

fn defer_add(b: *mut VkBackend, kind: u64, buf: u64, blk: usize, off: u64, size: u64) {
    if (*b).dn >= (*b).dcap {
        // full: finish all frames, which releases everything
        vk_frame.frame_wait_all(&(*b).x, &(*b).fr)
        reap(b)
    }
    let q: usize = (*b).dn * DW
    rt.st64((*b).dfr, q + D_KIND, kind)
    rt.st64((*b).dfr, q + D_BUF, buf)
    rt.st64((*b).dfr, q + D_BLK, blk as u64)
    rt.st64((*b).dfr, q + D_OFF, off)
    rt.st64((*b).dfr, q + D_SIZE, size)
    rt.st64((*b).dfr, q + D_TAG, (*b).fr.serial + 1)
    (*b).dn = (*b).dn + 1
}

// ---- atlas -----------------------------------------------------------------------------------------------------------------
fn be_atlas(o: u64, a: u64) {
    let b: *mut VkBackend = o as *mut VkBackend
    let at: *mut mc_texture.Atlas = a as *mut mc_texture.Atlas
    if !(*b).ok || (*at).px == 0 {
        return
    }
    vk_frame.frame_wait_all(&(*b).x, &(*b).fr)
    reap(b)
    vk_mem.img_free(&(*b).x, &(*b).atlas)
    let t: usize = (*at).tile as usize
    var layers: usize = ((*at).cols as usize) * ((*at).rows as usize)
    (*b).layers_lost = 0
    if (layers as u64) > (*b).x.max_layers {
        (*b).layers_lost = (layers as i32) - ((*b).x.max_layers as i32)
        layers = (*b).x.max_layers as usize
    }
    var alloc_layers: usize = layers
    if alloc_layers < 2 {
        alloc_layers = 2 // the shaders sample a 2D_ARRAY view: a 1-layer image would get a plain 2D view
    }
    let row: usize = t * 4
    let lbytes: usize = t * row
    let stride: usize = ((*at).w as usize) * 4
    var st: vk_mem.Buf = vk_mem.buf_make(&(*b).x, (alloc_layers * lbytes) as u64, vk_mem.U_SRC, vk_mem.MEM_STAGING)
    if !st.ok {
        return
    }
    var l: usize = 0
    while l < layers {
        let col: usize = l % ((*at).cols as usize)
        let rw: usize = l / ((*at).cols as usize)
        var y: usize = 0
        while y < t {
            rt.mem_copy(st.ptr + (l * lbytes + y * row) as u64, (*at).px + ((rw * t + y) * stride + col * row) as u64, row)
            y = y + 1
        }
        l = l + 1
    }
    (*b).atlas = vk_mem.img_make(&(*b).x, (*at).tile as u32, (*at).tile as u32, alloc_layers as u32, vk_desc.FMT_RGBA8, 0x6 as u64, 1 as u64)
    if !(*b).atlas.ok {
        vk_mem.buf_free(&(*b).x, &st)
        return
    }
    let cmd: u64 = vk_frame.imm_begin(&(*b).x, &(*b).fr)
    // UNDEFINED -> TRANSFER_DST, copy all layers, -> SHADER_READ_ONLY (visible to the fragment shader)
    vk_frame.image_barrier(&(*b).x, cmd, (*b).atlas.img, 1, alloc_layers as u64, vk_frame.LAYOUT_UNDEFINED, vk_frame.LAYOUT_TRANSFER_DST,
        vk_frame.ST_TOP, vk_frame.ST_TRANSFER, 0, vk_frame.AC_TRANSFER_WRITE)
    (*b).x.top = 0
    let rg: u64 = vk_mem.xsa(&(*b).x, 56)
    vk_mem.w32(rg, 16, 1) // aspect colour
    vk_mem.w32(rg, 24, 0)
    vk_mem.w32(rg, 28, layers as u64)
    vk_mem.w32(rg, 44, t as u64)
    vk_mem.w32(rg, 48, t as u64)
    vk_mem.w32(rg, 52, 1)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_COPY_B2I, cmd, st.buf, (*b).atlas.img, vk_frame.LAYOUT_TRANSFER_DST, 1, rg, 0, 0, 0, 0)
    vk_frame.image_barrier(&(*b).x, cmd, (*b).atlas.img, 1, alloc_layers as u64, vk_frame.LAYOUT_TRANSFER_DST, vk_frame.LAYOUT_SHADER_READ,
        vk_frame.ST_TRANSFER, vk_frame.ST_FRAGMENT, vk_frame.AC_TRANSFER_WRITE, vk_frame.AC_SHADER_READ)
    vk_frame.imm_submit(&(*b).x, &(*b).fr)
    vk_mem.buf_free(&(*b).x, &st)
    (*b).tile = (*at).tile
    var i: usize = 0
    while i < NFR {
        vk_desc.desc_write_atlas(&(*b).x, &(*b).d, i, (*b).atlas.view)
        i = i + 1
    }
}

// ---- meshes ------------------------------------------------------------------------------------------------------------------
fn ensure_tcmd(b: *mut VkBackend) -> u64 {
    let c: u64 = vk_frame.frame_tcmd(&(*b).fr, (*b).next)
    if (*b).trec {
        return c
    }
    // the slot's previous use must be finished before its command buffer is reset
    vk_frame.frame_wait(&(*b).x, &(*b).fr, (*b).next)
    reap(b)
    if !vk_frame.cmd_begin(&(*b).x, c) {
        return 0
    }
    (*b).trec = true
    return c
}

fn be_upload(o: u64, key: u64, verts: u64, nverts: usize, idx: u64, nidx: usize) -> usize {
    let b: *mut VkBackend = o as *mut VkBackend
    if !(*b).ok || nverts == 0 || nidx < 3 {
        return 0
    }
    let vbytes: u64 = (nverts as u64) * 8
    let ioff: u64 = (vbytes + 15) / 16 * 16
    let total: u64 = ioff + (nidx as u64) * 4
    let c: u64 = ensure_tcmd(b)
    if c == 0 {
        return 0
    }
    var st: vk_mem.Buf = vk_mem.buf_make(&(*b).x, total, vk_mem.U_SRC, vk_mem.MEM_STAGING)
    if !st.ok {
        return 0
    }
    var dv: vk_mem.Buf = vk_mem.buf_make(&(*b).x, total, vk_mem.U_VERTEX | vk_mem.U_INDEX | vk_mem.U_DST, vk_mem.MEM_DEVICE)
    if !dv.ok {
        vk_mem.buf_free(&(*b).x, &st)
        return 0
    }
    rt.mem_copy(st.ptr, verts, nverts * 8)
    rt.mem_copy(st.ptr + ioff, idx, nidx * 4)
    (*b).x.top = 0
    let rg: u64 = vk_mem.xsa(&(*b).x, 24)
    vk_mem.w64(rg, 16, total)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_COPY_BUF, c, st.buf, dv.buf, 1, rg, 0, 0, 0, 0, 0)
    (*b).upload_bytes = (*b).upload_bytes + total
    // the staging buffer goes away once the frame that carries this copy has finished
    defer_add(b, 1, st.buf, st.a.blk, st.a.off, st.a.size)
    // slot in the mesh table
    var s: usize = 0
    while s < (*b).mcap && rt.ld64((*b).meshes, s * MW + M_USED) != 0 {
        s = s + 1
    }
    if s >= (*b).mcap {
        let ncap: usize = (*b).mcap * 2
        let nm: u64 = rt.heap_alloc(ncap * MW * 8)
        rt.mem_set(nm, 0 as u8, ncap * MW * 8)
        rt.mem_copy(nm, (*b).meshes, (*b).mcap * MW * 8)
        rt.heap_free((*b).meshes, (*b).mcap * MW * 8)
        (*b).meshes = nm
        (*b).mcap = ncap
    }
    let q: usize = s * MW
    rt.st64((*b).meshes, q + M_USED, 1)
    rt.st64((*b).meshes, q + M_BUF, dv.buf)
    rt.st64((*b).meshes, q + M_BLK, dv.a.blk as u64)
    rt.st64((*b).meshes, q + M_OFF, dv.a.off)
    rt.st64((*b).meshes, q + M_SIZE, dv.a.size)
    rt.st64((*b).meshes, q + M_IOFF, ioff)
    rt.st64((*b).meshes, q + M_NIDX, nidx as u64)
    rt.st64((*b).meshes, q + M_KEY, key)
    (*b).live = (*b).live + 1
    return s + 1
}

fn be_free(o: u64, h: usize) {
    let b: *mut VkBackend = o as *mut VkBackend
    if h < 1 || h > (*b).mcap {
        return
    }
    let q: usize = (h - 1) * MW
    if rt.ld64((*b).meshes, q + M_USED) == 0 {
        return
    }
    defer_add(b, 0, rt.ld64((*b).meshes, q + M_BUF), rt.ld64((*b).meshes, q + M_BLK) as usize, rt.ld64((*b).meshes, q + M_OFF),
        rt.ld64((*b).meshes, q + M_SIZE))
    rt.st64((*b).meshes, q + M_USED, 0)
    (*b).live = (*b).live - 1
}

// ---- frame ---------------------------------------------------------------------------------------------------------------------
fn be_begin(o: u64, cam: u64, rgba: u32) {
    let b: *mut VkBackend = o as *mut VkBackend
    let c: *mut mc_camera.Camera = cam as *mut mc_camera.Camera
    if !(*b).ok || (*b).in_frame || (*b).lost {
        return
    }
    if (*b).sc_on && ((*b).life.need_rebuild || (*b).sc_surface_lost || !(*b).sc_ready) { sc_resync(b) }
    if (*b).lost { return }
    (*b).t0_ns = (time.monotonic_ns() as u64)
    let s: usize = (*b).next
    (*b).cur = s
    vk_frame.frame_wait(&(*b).x, &(*b).fr, s)
    reap(b)
    (*b).cx = (*c).x
    (*b).cy = (*c).y
    (*b).cz = (*c).z
    // projection * view rotation (the camera translation is applied per draw on the CPU, f64)
    var rot: mc_math.Mat4 = (*c).view
    rot.m[12] = 0.0
    rot.m[13] = 0.0
    rot.m[14] = 0.0
    var rv: mc_math.Mat4 = mc_math.Mat4 { m: [0.0; 16] }
    mc_math.mat4_mul(&rv, &(*c).proj, &rot)
    // per-frame part of the Frame UBO (copied into a fresh slice whenever pass / fade / light change, see bake)
    let u: u64 = (*b).base
    var i: usize = 0
    while i < 16 {
        vk_mem.wf(u, vk_shaders.U_RV + i * 4, rv.m[i])
        i = i + 1
    }
    var fo: f64 = 0.0
    if (*b).fog_on { fo = 1.0 }
    vk_mem.wf(u, vk_shaders.U_FOG, fo)
    vk_mem.wf(u, vk_shaders.U_FOG + 4, (*b).fog_start)
    vk_mem.wf(u, vk_shaders.U_FOG + 8, (*b).fog_end)
    vk_mem.wf(u, vk_shaders.U_FOGC, (*b).fog_r)
    vk_mem.wf(u, vk_shaders.U_FOGC + 4, (*b).fog_g)
    vk_mem.wf(u, vk_shaders.U_FOGC + 8, (*b).fog_b)
    vk_mem.wf(u, vk_shaders.U_TILES, (*b).tile as f64)
    vk_mem.wf(u, vk_shaders.U_SIZE, (*b).w as f64)
    vk_mem.wf(u, vk_shaders.U_SIZE + 4, (*b).h as f64)
    vk_mem.w32(u, vk_shaders.U_PAGEL, PAGEL_SINGLE)
    vk_mem.w32(u, vk_shaders.U_FILTER, 0)
    vk_mem.wf(u, vk_shaders.U_H, (*b).h as f64)
    (*b).nslice = 0
    (*b).dyn_top = 0
    (*b).inv_on = false
    (*b).dirty = true
    let cmd: u64 = vk_frame.frame_cmd(&(*b).fr, s)
    vk_frame.cmd_begin(&(*b).x, cmd)
    (*b).x.top = 0
    let cv: u64 = vk_mem.xsa(&(*b).x, 32)
    vk_mem.wf(cv, 0, ((rgba & 255 as u32) as f64) / 255.0)
    vk_mem.wf(cv, 4, (((rgba >> 8 as u32) & 255 as u32) as f64) / 255.0)
    vk_mem.wf(cv, 8, (((rgba >> 16 as u32) & 255 as u32) as f64) / 255.0)
    vk_mem.wf(cv, 12, (((rgba >> 24 as u32) & 255 as u32) as f64) / 255.0)
    vk_mem.wf(cv, 16, 1.0) // depth
    let bi: u64 = vk_mem.xsa(&(*b).x, 64)
    vk_mem.w32(bi, 0, 43) // RENDER_PASS_BEGIN_INFO
    vk_mem.w64(bi, 16, (*b).rp)
    vk_mem.w64(bi, 24, (*b).fs[s].fb)
    vk_mem.w32(bi, 40, (*b).w as u64)
    vk_mem.w32(bi, 44, (*b).h as u64)
    vk_mem.w32(bi, 48, 2)
    vk_mem.w64(bi, 56, cv)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_BEGIN_RP, cmd, bi, 0, 0, 0, 0, 0, 0, 0, 0)
    (*b).bound = 0
    let vp: u64 = vk_mem.xsa(&(*b).x, 24)
    vk_mem.wf(vp, 4, (*b).h as f64) // negative height = y flip (Vulkan 1.1), GL rasterisation rules
    vk_mem.wf(vp, 8, (*b).w as f64)
    vk_mem.wf(vp, 12, 0.0 - ((*b).h as f64))
    vk_mem.wf(vp, 20, 1.0)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_SET_VP, cmd, 0, 1, vp, 0, 0, 0, 0, 0, 0)
    let sc: u64 = vk_mem.xsa(&(*b).x, 16)
    vk_mem.w32(sc, 8, (*b).w as u64)
    vk_mem.w32(sc, 12, (*b).h as u64)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_SET_SC, cmd, 0, 1, sc, 0, 0, 0, 0, 0, 0)
    (*b).trans = false
    (*b).fade_a = 64.0
    (*b).fade_inv = 0.0
    (*b).in_frame = true
}

// Bakes the current pass / fade / light state into a new UBO slice of the current frame slot and binds set 0 with its dynamic offset.
fn bake(b: *mut VkBackend, cmd: u64) {
    var n: usize = (*b).nslice
    if n >= UBO_SLICES {
        (*b).ubo_over = (*b).ubo_over + 1 as u64
        n = UBO_SLICES - 1
    } else {
        (*b).nslice = n + 1
    }
    let off: usize = n * UBO_STRIDE
    let dst: u64 = (*b).fs[(*b).cur].ubo.ptr + (off as u64)
    rt.mem_copy(dst, (*b).base, vk_shaders.FRAME_SIZE)
    vk_mem.wf(dst, vk_shaders.U_FADE, (*b).fade_a)
    vk_mem.wf(dst, vk_shaders.U_FADE + 4, (*b).fade_inv)
    vk_mem.wf(dst, vk_shaders.U_FADE + 8, (*b).h as f64)
    vk_mem.wf(dst, vk_shaders.U_LIGHT, (*b).day)
    vk_mem.wf(dst, vk_shaders.U_LIGHT + 4, (*b).tr)
    vk_mem.wf(dst, vk_shaders.U_LIGHT + 8, (*b).tg)
    vk_mem.wf(dst, vk_shaders.U_LIGHT + 12, (*b).tb)
    var tf: u64 = 0
    if (*b).trans { tf = 1 }
    vk_mem.w32(dst, vk_shaders.U_TRANS, tf)
    var iv: u64 = 0
    if (*b).inv_on { iv = 1 }
    vk_mem.w32(dst, vk_shaders.U_INVERT, iv)
    (*b).x.top = 0
    let ds: u64 = vk_mem.xsa(&(*b).x, 8)
    vk_mem.w64(ds, 0, vk_mem.r64((*b).d.sets, (*b).cur * 8))
    let dyn: u64 = vk_mem.xsa(&(*b).x, 8)
    vk_mem.w32(dyn, 0, off as u64)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_BIND_DS, cmd, 0, (*b).playout, 0, 1, ds, 1, dyn, 0, 0)
    (*b).dirty = false
}

// Binds `pipe` unless it is already bound (the voxel pass, sky, tint, entities and HUD alternate within one frame).
fn bind_pipe(b: *mut VkBackend, cmd: u64, pipe: u64) {
    if (*b).bound == pipe { return }
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_BIND_PIPE, cmd, 0, pipe, 0, 0, 0, 0, 0, 0, 0)
    (*b).bound = pipe
}

fn voxel_pipe(b: *mut VkBackend) -> u64 {
    if (*b).trans { return (*b).pipe_tr.pipe }
    return (*b).pipe_op.pipe
}

// The background of mc_sky.sky_draw_plain: one full-screen strip, colour only (depth and the clear colour stay). Call right after
// b.begin and before the first b.draw. Float maths in the shader: a pixel may differ by one level.
fn vkbe_sky(b: *mut VkBackend, cam: *mut mc_camera.Camera, sky: *mut mc_sky.Sky) {
    if !(*b).ok || !(*b).in_frame { return }
    let u: u64 = (*b).base
    let hw: f64 = ((*b).w as f64) * 0.5
    let hh: f64 = ((*b).h as f64) * 0.5
    vk_mem.wf(u, vk_shaders.U_R, (*cam).rx)
    vk_mem.wf(u, vk_shaders.U_R + 4, (*cam).ry)
    vk_mem.wf(u, vk_shaders.U_R + 8, (*cam).rz)
    vk_mem.wf(u, vk_shaders.U_U, (*cam).ux)
    vk_mem.wf(u, vk_shaders.U_U + 4, (*cam).uy)
    vk_mem.wf(u, vk_shaders.U_U + 8, (*cam).uz)
    vk_mem.wf(u, vk_shaders.U_F, (*cam).fx)
    vk_mem.wf(u, vk_shaders.U_F + 4, (*cam).fy)
    vk_mem.wf(u, vk_shaders.U_F + 8, (*cam).fz)
    vk_mem.wf(u, vk_shaders.U_CAM, hw)
    vk_mem.wf(u, vk_shaders.U_CAM + 4, hh)
    vk_mem.wf(u, vk_shaders.U_CAM + 8, hw / (*cam).tan_x)
    vk_mem.wf(u, vk_shaders.U_CAM + 12, hh / (*cam).tan_y)
    vk_mem.wf(u, vk_shaders.U_ZEN, (*sky).zr as f64)
    vk_mem.wf(u, vk_shaders.U_ZEN + 4, (*sky).zg as f64)
    vk_mem.wf(u, vk_shaders.U_ZEN + 8, (*sky).zb as f64)
    vk_mem.wf(u, vk_shaders.U_HOR, (*sky).hr as f64)
    vk_mem.wf(u, vk_shaders.U_HOR + 4, (*sky).hg as f64)
    vk_mem.wf(u, vk_shaders.U_HOR + 8, (*sky).hb as f64)
    vk_mem.wf(u, vk_shaders.U_GLC, (*sky).lr as f64)
    vk_mem.wf(u, vk_shaders.U_GLC + 4, (*sky).lg as f64)
    vk_mem.wf(u, vk_shaders.U_GLC + 8, (*sky).lb as f64)
    vk_mem.wf(u, vk_shaders.U_SUN, (*sky).sunx)
    vk_mem.wf(u, vk_shaders.U_SUN + 4, (*sky).suny)
    vk_mem.wf(u, vk_shaders.U_SUN + 8, (*sky).sunz)
    vk_mem.wf(u, vk_shaders.U_SUN + 12, (*sky).glow as f64)
    var d: u64 = 0
    if (*sky).discs { d = 1 }
    vk_mem.w32(u, vk_shaders.U_DISCS, d)
    let cmd: u64 = vk_frame.frame_cmd(&(*b).fr, (*b).cur)
    bake(b, cmd)
    bind_pipe(b, cmd, (*b).pipe_sky.pipe)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_DRAW, cmd, vk_shaders.SKY_VERTS as u64, 1, 0, 0, 0, 0, 0, 0, 0)
}

// mc_sky.sky_tint_frame on the GPU: multiplies every pixel that has geometry (depth < 1) by tint / 256. Call after the world (and the
// entities), before the HUD. Identity tints (256) draw nothing.
fn vkbe_tint(b: *mut VkBackend, sky: *mut mc_sky.Sky) {
    if !(*b).ok || !(*b).in_frame { return }
    if (*sky).tr >= 256 && (*sky).tg >= 256 && (*sky).tb >= 256 { return }
    let u: u64 = (*b).base
    vk_mem.wf(u, vk_shaders.U_TINT, ((*sky).tr as f64) / 256.0)
    vk_mem.wf(u, vk_shaders.U_TINT + 4, ((*sky).tg as f64) / 256.0)
    vk_mem.wf(u, vk_shaders.U_TINT + 8, ((*sky).tb as f64) / 256.0)
    let cmd: u64 = vk_frame.frame_cmd(&(*b).fr, (*b).cur)
    bake(b, cmd)
    bind_pipe(b, cmd, (*b).pipe_tint.pipe)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_DRAW, cmd, vk_shaders.SKY_VERTS as u64, 1, 0, 0, 0, 0, 0, 0, 0)
}

// Bump allocation in the per frame vertex buffer (16 aligned). 0xFFFFFFFFFFFFFFFF = does not fit (counted in dyn_over).
fn dyn_alloc(b: *mut VkBackend, n: u64) -> u64 {
    let off: u64 = ((*b).dyn_top + 15 as u64) / 16 as u64 * 16 as u64
    if off + n > DYN_BYTES {
        (*b).dyn_over = (*b).dyn_over + 1 as u64
        return 0xFFFFFFFFFFFFFFFF as u64
    }
    (*b).dyn_top = off + n
    return off
}

fn bind_dyn_vb(b: *mut VkBackend, cmd: u64, off: u64) {
    vk_mem.w64((*b).vb, 0, (*b).fs[(*b).cur].dyn.buf)
    vk_mem.w64((*b).vb, 8, off)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_BIND_VB, cmd, 0, 1, (*b).vb, (*b).vb + 8, 0, 0, 0, 0, 0)
}

// Draws the rectangles recorded by mc_hud.hud_record (6 u32 each: x0 y0 x1 y1 colour mode) over the frame, in the recorded order, one
// instanced draw per run of equal mode. Call last (after the tint), before b.end.
fn vkbe_hud(b: *mut VkBackend, rec: *mut rt.Buf) {
    if !(*b).ok || !(*b).in_frame { return }
    let n: usize = rt.buf_len(rec) / HUD_REC_BYTES
    if n == 0 { return }
    let off: u64 = dyn_alloc(b, (n * HUD_REC_BYTES) as u64)
    if off == 0xFFFFFFFFFFFFFFFF as u64 { return }
    let data: u64 = rt.buf_ptr(rec)
    rt.mem_copy((*b).fs[(*b).cur].dyn.ptr + off, data, n * HUD_REC_BYTES)
    let cmd: u64 = vk_frame.frame_cmd(&(*b).fr, (*b).cur)
    var i: usize = 0
    while i < n {
        let mode: u32 = rt.ld32(data, i * 6 + 5)
        var j: usize = i + 1
        while j < n && rt.ld32(data, j * 6 + 5) == mode {
            j = j + 1
        }
        (*b).inv_on = mode == 1 as u32
        bake(b, cmd)
        if (*b).inv_on {
            bind_pipe(b, cmd, (*b).pipe_hud_inv.pipe)
        } else {
            bind_pipe(b, cmd, (*b).pipe_hud.pipe)
        }
        bind_dyn_vb(b, cmd, off + (i * HUD_REC_BYTES) as u64)
        vk_mem.cx(&(*b).x, vk_mem.X_CMD_DRAW, cmd, 4, (j - i) as u64, 0, 0, 0, 0, 0, 0, 0)
        i = j
    }
    (*b).inv_on = false
    (*b).dirty = true
}

fn be_draw(o: u64, h: usize, ox: f64, oy: f64, oz: f64) -> u64 {
    let b: *mut VkBackend = o as *mut VkBackend
    if !(*b).in_frame || h < 1 || h > (*b).mcap {
        return 0 as u64
    }
    let q: usize = (h - 1) * MW
    if rt.ld64((*b).meshes, q + M_USED) == 0 {
        return 0 as u64
    }
    let nidx: u64 = rt.ld64((*b).meshes, q + M_NIDX)
    let cmd: u64 = vk_frame.frame_cmd(&(*b).fr, (*b).cur)
    if (*b).dirty {
        bake(b, cmd)
    }
    bind_pipe(b, cmd, voxel_pipe(b))
    let p: u64 = (*b).push
    vk_mem.wf(p, 0, ox - (*b).cx)
    vk_mem.wf(p, 4, oy - (*b).cy)
    vk_mem.wf(p, 8, oz - (*b).cz)
    vk_mem.w32(p, 12, 0) // u_pool: one draw per section
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_PUSH, cmd, (*b).playout, 0x1, 0, vk_desc.PUSH_BYTES, p, 0, 0, 0, 0)
    let buf: u64 = rt.ld64((*b).meshes, q + M_BUF)
    vk_mem.w64((*b).vb, 0, buf)
    vk_mem.w64((*b).vb, 8, 0)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_BIND_VB, cmd, 0, 1, (*b).vb, (*b).vb + 8, 0, 0, 0, 0, 0)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_BIND_IB, cmd, buf, rt.ld64((*b).meshes, q + M_IOFF), 1, 0, 0, 0, 0, 0, 0)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_DRAW_IDX, cmd, nidx, 1, 0, 0, 0, 0, 0, 0, 0)
    (*b).draws = (*b).draws + 1 as u64
    let t: u64 = nidx / 3
    (*b).tris = (*b).tris + t
    return t
}

fn be_set_pass(o: u64, pass: i32) {
    let b: *mut VkBackend = o as *mut VkBackend
    if !(*b).in_frame {
        return
    }
    let tr: bool = pass == mc_backend.PASS_TRANS
    if tr == (*b).trans {
        return
    }
    (*b).trans = tr
    (*b).dirty = true
}

fn be_set_light(o: u64, day: i32, tr: i32, tg: i32, tb: i32) {
    vkbe_set_light(o as *mut VkBackend, day, tr, tg, tb)
}

fn be_set_fade(o: u64, a: i32, inv: i32) {
    let b: *mut VkBackend = o as *mut VkBackend
    (*b).fade_a = a as f64
    (*b).fade_inv = inv as f64
    (*b).dirty = true
}

// Records the blit of slot colour image (TRANSFER_SRC, final layout of the render pass) into the acquired swapchain image `img` and leaves it in
// PRESENT_SRC. Format conversion (RGBA8 -> BGRA8) is done by the blit; sizes may differ (NEAREST).
fn sc_blit(b: *mut VkBackend, cmd: u64, img: u64) {
    let s: usize = (*b).cur
    vk_frame.image_barrier(&(*b).x, cmd, img, 1, 1, vk_frame.LAYOUT_UNDEFINED, vk_frame.LAYOUT_TRANSFER_DST,
        vk_frame.ST_TRANSFER | vk_frame.ST_COLOR_OUT, vk_frame.ST_TRANSFER, 0, vk_frame.AC_TRANSFER_WRITE)
    (*b).x.top = 0
    let r: u64 = vk_mem.xsa(&(*b).x, 80)
    vk_mem.w32(r, 0, 1) // srcSubresource: COLOR aspect, mip 0, layer 0, 1 layer
    vk_mem.w32(r, 12, 1)
    vk_mem.w32(r, 28, (*b).w as u64) // srcOffsets[1]
    vk_mem.w32(r, 32, (*b).h as u64)
    vk_mem.w32(r, 36, 1)
    vk_mem.w32(r, 40, 1) // dstSubresource
    vk_mem.w32(r, 52, 1)
    vk_mem.w32(r, 68, (*b).sc.w as u64) // dstOffsets[1]
    vk_mem.w32(r, 72, (*b).sc.h as u64)
    vk_mem.w32(r, 76, 1)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_BLIT, cmd, (*b).fs[s].col.img, vk_frame.LAYOUT_TRANSFER_SRC, img, vk_frame.LAYOUT_TRANSFER_DST, 1, r, 0, 0, 0)
    vk_frame.image_barrier(&(*b).x, cmd, img, 1, 1, vk_frame.LAYOUT_TRANSFER_DST, vk_frame.LAYOUT_PRESENT,
        vk_frame.ST_TRANSFER, vk_frame.ST_BOTTOM, vk_frame.AC_TRANSFER_WRITE, 0)
}

fn be_end(o: u64) {
    let b: *mut VkBackend = o as *mut VkBackend
    if !(*b).in_frame {
        return
    }
    let s: usize = (*b).cur
    let cmd: u64 = vk_frame.frame_cmd(&(*b).fr, s)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_END_RP, cmd, 0, 0, 0, 0, 0, 0, 0, 0, 0)
    if (*b).readback {
        (*b).x.top = 0
        let rg: u64 = vk_mem.xsa(&(*b).x, 56)
        vk_mem.w32(rg, 16, 1)
        vk_mem.w32(rg, 28, 1)
        vk_mem.w32(rg, 44, (*b).w as u64)
        vk_mem.w32(rg, 48, (*b).h as u64)
        vk_mem.w32(rg, 52, 1)
        vk_mem.cx(&(*b).x, vk_mem.X_CMD_COPY_I2B, cmd, (*b).fs[s].col.img, vk_frame.LAYOUT_TRANSFER_SRC, (*b).fs[s].rb.buf, 1, rg, 0, 0, 0, 0)
        vk_frame.mem_barrier(&(*b).x, cmd, vk_frame.ST_TRANSFER, vk_frame.ST_HOST, vk_frame.AC_TRANSFER_WRITE, vk_frame.AC_HOST_READ)
    }
    // swapchain present: acquire an image (signals the slot's acquire semaphore), blit colour -> swapchain image, to PRESENT_SRC
    var sc_idx: u64 = 0
    var sc_go: bool = false
    if (*b).sc_on && (*b).sc_ready && !(*b).inject_lost {
        let ra: u64 = vk.sc_acquire(&(*b).v, &(*b).sc, vk_frame.frame_sem_acq(&(*b).fr, s))
        let cls: i32 = vk_life.sc_note(&(*b).life, ra)
        if cls == vk_life.CLS_OK || cls == vk_life.CLS_SUBOPTIMAL {
            sc_go = true
            sc_idx = (*b).sc.idx
            sc_blit(b, cmd, vk.sc_image(&(*b).sc, sc_idx))
        } else if cls == vk_life.CLS_SURFACE_LOST {
            (*b).sc_surface_lost = true
        }
        if !sc_go { (*b).sc_skips = (*b).sc_skips + 1 as u64 }
    } else if (*b).sc_on {
        (*b).sc_skips = (*b).sc_skips + 1 as u64
    }
    vk_frame.cmd_end(&(*b).x, cmd)
    var pre: u64 = 0
    if (*b).trec {
        // uploads recorded for this slot: make them visible to the vertex / index fetch, then submit them BEFORE the frame
        let tc: u64 = vk_frame.frame_tcmd(&(*b).fr, s)
        vk_frame.mem_barrier(&(*b).x, tc, vk_frame.ST_TRANSFER, vk_frame.ST_VERTEX_INPUT, vk_frame.AC_TRANSFER_WRITE,
            vk_frame.AC_INDEX_READ | vk_frame.AC_VERTEX_READ)
        vk_frame.cmd_end(&(*b).x, tc)
        pre = tc
        (*b).trec = false
    }
    if (*b).inject_lost {
        (*b).inject_lost = false
        (*b).in_frame = false
        (*b).lost = true
        (*b).life.lost = true
        (*b).life.lost_count = (*b).life.lost_count + 1 as u64
        return
    }
    var wsem: u64 = 0
    var dsem: u64 = 0
    if sc_go {
        wsem = vk_frame.frame_sem_acq(&(*b).fr, s)
        dsem = vk_frame.frame_sem_done(&(*b).fr, s)
    }
    if !vk_frame.frame_submit(&(*b).x, &(*b).fr, s, pre, wsem, dsem) {
        (*b).in_frame = false
        (*b).lost = true
        (*b).life.lost = true
        (*b).life.lost_count = (*b).life.lost_count + 1 as u64
        return
    }
    if sc_go {
        let rp: u64 = vk.sc_present(&(*b).v, &(*b).sc, sc_idx, dsem)
        let pcls: i32 = vk_life.sc_note(&(*b).life, rp)
        if pcls == vk_life.CLS_DEVICE_LOST {
            (*b).lost = true
        } else if pcls == vk_life.CLS_SURFACE_LOST {
            (*b).sc_surface_lost = true
        } else if pcls == vk_life.CLS_OK || pcls == vk_life.CLS_SUBOPTIMAL {
            (*b).sc_presents = (*b).sc_presents + 1 as u64
        } else {
            (*b).sc_skips = (*b).sc_skips + 1 as u64 // OUT_OF_DATE: not shown, rebuilt before the next frame
        }
    }
    (*b).in_frame = false
    (*b).has_last = true
    (*b).last = s
    (*b).next = (s + 1) % NFR
    (*b).frames = (*b).frames + 1 as u64
}

fn vkbe_wait(b: *mut VkBackend) {
    vk_frame.frame_wait_all(&(*b).x, &(*b).fr)
    reap(b)
}

// Address of the newest frame (waits for it): w*h*4 octets RGBA, row 0 = top. 0 = no frame yet / read back off.
fn be_present(o: u64) -> u64 {
    let b: *mut VkBackend = o as *mut VkBackend
    if !(*b).has_last || !(*b).readback {
        return 0 as u64
    }
    vk_frame.frame_wait(&(*b).x, &(*b).fr, (*b).last)
    reap(b)
    (*b).frame_ns = (time.monotonic_ns() as u64) - (*b).t0_ns
    return (*b).fs[(*b).last].rb.ptr
}

fn be_read(o: u64, out: u64) {
    let b: *mut VkBackend = o as *mut VkBackend
    let p: u64 = be_present(o)
    if p != 0 {
        rt.mem_copy(out, p, ((*b).w as usize) * ((*b).h as usize) * 4)
    }
}

// b.draw_entities: n box records (mc_backend.ENT_WORDS f64 each, world coordinates: centre, size, yaw sin / cos, colour 0..255) as ONE instanced draw of
// the unit cube, depth tested against the world. Only between begin and end. Returns the boxes drawn. (No culling here: the depth test
// decides; GL culling only skips boxes that cannot be seen, the picture is byte equal.)
fn be_ents(o: u64, recs: u64, n: usize) -> u64 {
    let b: *mut VkBackend = o as *mut VkBackend
    if !(*b).ok || !(*b).in_frame || n == 0 {
        return 0 as u64
    }
    let off: u64 = dyn_alloc(b, (n * ENT_INST_BYTES) as u64)
    if off == 0xFFFFFFFFFFFFFFFF as u64 {
        return 0 as u64
    }
    let d: u64 = (*b).fs[(*b).cur].dyn.ptr + off
    var i: usize = 0
    while i < n {
        let e: u64 = recs + (i * mc_backend.ENT_BYTES) as u64
        let q: u64 = d + (i * ENT_INST_BYTES) as u64
        vk_mem.wf(q, 0, rec_f(e, 0) - (*b).cx)
        vk_mem.wf(q, 4, rec_f(e, 1) - (*b).cy)
        vk_mem.wf(q, 8, rec_f(e, 2) - (*b).cz)
        vk_mem.wf(q, 12, rec_f(e, 6))
        vk_mem.wf(q, 16, rec_f(e, 3))
        vk_mem.wf(q, 20, rec_f(e, 4))
        vk_mem.wf(q, 24, rec_f(e, 5))
        vk_mem.wf(q, 28, rec_f(e, 7))
        vk_mem.wf(q, 32, rec_f(e, 8))
        vk_mem.wf(q, 36, rec_f(e, 9))
        vk_mem.wf(q, 40, rec_f(e, 10))
        vk_mem.wf(q, 44, 0.0)
        i = i + 1
    }
    let cmd: u64 = vk_frame.frame_cmd(&(*b).fr, (*b).cur)
    if (*b).dirty {
        bake(b, cmd)
    }
    bind_pipe(b, cmd, (*b).pipe_ent.pipe)
    (*b).x.top = 0
    let vbs: u64 = vk_mem.xsa(&(*b).x, 32)
    vk_mem.w64(vbs, 0, (*b).cube.buf)
    vk_mem.w64(vbs, 8, (*b).fs[(*b).cur].dyn.buf)
    vk_mem.w64(vbs, 16, 0)
    vk_mem.w64(vbs, 24, off)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_BIND_VB, cmd, 0, 2, vbs, vbs + 16, 0, 0, 0, 0, 0)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_BIND_IB, cmd, (*b).cube.buf, CUBE_IB, 0, 0, 0, 0, 0, 0, 0)
    vk_mem.cx(&(*b).x, vk_mem.X_CMD_DRAW_IDX, cmd, 36, n as u64, 0, 0, 0, 0, 0, 0, 0)
    (*b).draws = (*b).draws + 1 as u64
    (*b).tris = (*b).tris + (12 * n) as u64
    (*b).ents_drawn = (*b).ents_drawn + n as u64
    return n as u64
}

// New target size (waits for all frames).
fn vkbe_resize(b: *mut VkBackend, w: i32, h: i32) -> bool {
    if !(*b).ok || (*b).in_frame {
        return false
    }
    vk_frame.frame_wait_all(&(*b).x, &(*b).fr)
    targets_free(b)
    (*b).w = w
    (*b).h = h
    (*b).has_last = false
    let ok: bool = targets_make(b)
    if (*b).sc_on { sc_resync(b) } // new window size: swapchain + per-slot semaphores
    return ok
}

// vk_life.Life.on_rebuild adapter: set `l.ud = (address of the VkBackend)` and `l.on_rebuild = vkbe_on_rebuild`; the depth image (and colour,
// framebuffer, read back) are re-created by vkbe_resize.
fn vkbe_on_rebuild(ud: u64, w: i32, h: i32) {
    let ok: bool = vkbe_resize(ud as *mut VkBackend, w, h)
}

fn vkbe_close(b: *mut VkBackend) {
    if !(*b).v.ok {
        return
    }
    if (*b).x.ok {
        vk_mem.x_idle(&(*b).x)
        (*b).fr.done = (*b).fr.serial
        reap(b)
        if (*b).sc_on { vk.sc_close(&(*b).v, &(*b).sc) }
        (*b).sc_on = false
        var s: usize = 0
        while s < (*b).mcap && (*b).meshes != 0 {
            if rt.ld64((*b).meshes, s * MW + M_USED) != 0 {
                vk_mem.cx(&(*b).x, vk_mem.X_DESTROY_BUFFER, (*b).x.dev, rt.ld64((*b).meshes, s * MW + M_BUF), 0, 0, 0, 0, 0, 0, 0, 0)
                rt.st64((*b).meshes, s * MW + M_USED, 0)
            }
            s = s + 1
        }
        targets_free(b)
        vk_mem.img_free(&(*b).x, &(*b).atlas)
        vk_desc.bview_free(&(*b).x, (*b).gran_view)
        vk_desc.bview_free(&(*b).x, (*b).org_view)
        vk_mem.buf_free(&(*b).x, &(*b).gran)
        vk_mem.buf_free(&(*b).x, &(*b).org)
        vk_desc.vpipe_free(&(*b).x, &(*b).pipe_op)
        vk_desc.vpipe_free(&(*b).x, &(*b).pipe_tr)
        vk_desc.vpipe_free(&(*b).x, &(*b).pipe_sky)
        vk_desc.vpipe_free(&(*b).x, &(*b).pipe_tint)
        vk_desc.vpipe_free(&(*b).x, &(*b).pipe_hud)
        vk_desc.vpipe_free(&(*b).x, &(*b).pipe_ent)
        vk_mem.buf_free(&(*b).x, &(*b).cube)
        vk_desc.vpipe_free(&(*b).x, &(*b).pipe_hud_inv)
        if (*b).playout != 0 {
            vk_mem.cx(&(*b).x, vk_mem.X_DESTROY_PLAYOUT, (*b).x.dev, (*b).playout, 0, 0, 0, 0, 0, 0, 0, 0)
        }
        if (*b).rp != 0 {
            vk_mem.cx(&(*b).x, vk_mem.X_DESTROY_RP, (*b).x.dev, (*b).rp, 0, 0, 0, 0, 0, 0, 0, 0)
        }
        vk_desc.desc_free(&(*b).x, &(*b).d)
        vk_frame.frames_free(&(*b).x, &(*b).fr)
        vk_mem.x_close(&(*b).x)
    }
    if (*b).life.ok {
        if !(*b).life.lost { vk_life.cache_save(&(*b).v, &(*b).life, (*b).cache_path) }
        vk_life.life_close(&(*b).v, &(*b).life)
    }
    if (*b).base != 0 {
        rt.heap_free((*b).base, vk_shaders.FRAME_SIZE)
        (*b).base = 0
    }
    vk.close(&(*b).v)
    (*b).ok = false
}

// The Vulkan back end as a `mc_backend.Backend` table (kind KIND_VK). `b` must outlive the table.
fn vkbe_backend(b: *mut VkBackend) -> mc_backend.Backend {
    var t: mc_backend.Backend = mc_backend.backend_new()
    t.kind = mc_backend.KIND_VK
    t.obj = b as u64
    t.upload_atlas = be_atlas
    t.mesh_upload = be_upload
    t.mesh_free = be_free
    t.begin = be_begin
    t.draw = be_draw
    t.end = be_end
    t.present = be_present
    t.read_pixels = be_read
    t.set_pass = be_set_pass
    t.set_light = be_set_light
    t.set_fade = be_set_fade
    t.ent_obj = b as u64
    t.draw_entities = be_ents
    return t
}
