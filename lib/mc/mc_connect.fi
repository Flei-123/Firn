import std.rt
import std.net
import net.dns
import net.addrinfo
import mc.mc_hostname

export { connect_host, CONNECT_STAGGER_MS, CONNECT_TOTAL_MS }

const CONNECT_STAGGER_MS: i64 = 250
const CONNECT_TOTAL_MS: i64 = 10000

fn connect_host(host: u64, hlen: usize, port: u16, which: *mut usize) -> net.Conn {
    var none: net.Conn = net.conn_from_fd(0 - 1)
    if port == 0 as u16 || !mc_hostname.host_valid(host, hlen) { return none }
    var res: dns.Resolver = dns.resolver_new()
    dns.resolver_init(&res)
    var list: addrinfo.AddrList = addrinfo.addrs_new()
    let ok: bool = addrinfo.addrs_resolve(&res, host, hlen, &list) catch false
    dns.resolver_free(&res)
    if !ok || list.n == 0 { return none }
    var err: i64 = 0
    return addrinfo.addrs_connect(&list, port, CONNECT_STAGGER_MS, CONNECT_TOTAL_MS, false, which, &err) catch none
}
