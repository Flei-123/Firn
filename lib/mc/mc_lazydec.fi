// SPDX-License-Identifier: MPL-2.0
import std.rt
import jobs.jobs
import audio.load_ogg

export {
    dj_new, dj_ready, dj_collect, dj_free, dj_get, dj_set, DJ_REC, DJ_DONE, DJ_HASH, DJ_NAME,
}

const J_TASK: usize = 0
const J_OGG: usize = 1
const J_OGG_N: usize = 2
const J_RATE: usize = 3
const J_DATA: usize = 4
const J_FRAMES: usize = 5
const J_CHANNELS: usize = 6
const J_OK: usize = 7
const DJ_REC: usize = 8
const DJ_DONE: usize = 9
const DJ_HASH: usize = 10
const DJ_NAME: usize = 11
const J_WORDS: usize = 12

fn dj_run(job: u64) -> u64 {
    var pcm: load_ogg.OggPcm = load_ogg.OggPcm { data: 0, frames: 0 as u64, channels: 0 as u32 }
    let ok: bool = load_ogg.ogg_decode(rt.ld64(job, J_OGG), rt.ld64(job, J_OGG_N) as usize, rt.ld64(job, J_RATE) as u32, &pcm)
    rt.st64(job, J_DATA, pcm.data)
    rt.st64(job, J_FRAMES, pcm.frames)
    rt.st64(job, J_CHANNELS, pcm.channels as u64)
    if ok { rt.st64(job, J_OK, 1) }
    return 1
}

fn dj_new(pool: u64, ogg_p: u64, ogg_n: usize, rate: u32) -> u64 {
    let j: u64 = rt.heap_alloc(J_WORDS * 8)
    if j == 0 { return 0 }
    var w: usize = 0
    while w < J_WORDS {
        rt.st64(j, w, 0)
        w = w + 1
    }
    let copy: u64 = rt.heap_alloc(ogg_n)
    if copy == 0 {
        rt.heap_free(j, J_WORDS * 8)
        return 0
    }
    rt.mem_copy(copy, ogg_p, ogg_n)
    rt.st64(j, J_OGG, copy)
    rt.st64(j, J_OGG_N, ogg_n as u64)
    rt.st64(j, J_RATE, rate as u64)
    let t: u64 = jobs.spawn(pool as *mut jobs.Jobs, dj_run, j)
    if t == 0 {
        rt.heap_free(copy, ogg_n)
        rt.heap_free(j, J_WORDS * 8)
        return 0
    }
    rt.st64(j, J_TASK, t)
    return j
}

fn dj_ready(j: u64) -> bool {
    return jobs.task_done(rt.ld64(j, J_TASK))
}

fn dj_collect(pool: u64, j: u64, out: *mut load_ogg.OggPcm) -> bool {
    jobs.join(pool as *mut jobs.Jobs, rt.ld64(j, J_TASK))
    rt.st64(j, J_TASK, 0)
    (*out).data = rt.ld64(j, J_DATA)
    (*out).frames = rt.ld64(j, J_FRAMES)
    (*out).channels = rt.ld64(j, J_CHANNELS) as u32
    return rt.ld64(j, J_OK) == 1
}

fn dj_free(j: u64) {
    rt.heap_free(rt.ld64(j, J_OGG), rt.ld64(j, J_OGG_N) as usize)
    rt.heap_free(j, J_WORDS * 8)
}

fn dj_get(j: u64, w: usize) -> u64 { return rt.ld64(j, w) }

fn dj_set(j: u64, w: usize, v: u64) { rt.st64(j, w, v) }
