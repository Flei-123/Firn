export { DigBot, digbot_new, digbot_step, DIGBOT_NONE, DIGBOT_START, DIGBOT_CANCEL }

const DIGBOT_NONE: i32 = 0
const DIGBOT_START: i32 = 1
const DIGBOT_CANCEL: i32 = 2

struct DigBot {
    on: bool,
    x: i32,
    y: i32,
    z: i32,
    hold_ms: u64,
    phase: i32,
    t0: u64,
}

fn digbot_new(on: bool, x: i32, y: i32, z: i32, hold_ms: u64) -> DigBot {
    return DigBot { on: on, x: x, y: y, z: z, hold_ms: hold_ms, phase: 0, t0: 0 as u64 }
}

fn digbot_step(b: *mut DigBot, now: u64, go: bool) -> i32 {
    if !(*b).on { return DIGBOT_NONE }
    if (*b).phase == 0 && go {
        (*b).phase = 1
        (*b).t0 = now
        return DIGBOT_START
    }
    if (*b).phase == 1 && now - (*b).t0 >= (*b).hold_ms {
        (*b).phase = 2
        return DIGBOT_CANCEL
    }
    return DIGBOT_NONE
}
