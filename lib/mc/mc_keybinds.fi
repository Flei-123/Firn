import std.rt
import std.fs
import mc.mc_session
import mc.mc_input
import mc.mc_launch_cfg
import mc.mc_keynames
import input.raw

export {
    Keybinds, kb_new, kb_count, kb_get, kb_set, kb_reset, kb_reset_all, kb_default, kb_is_default, kb_name, kb_category, kb_conflict, kb_action_of,
    kb_move_bits, kb_move_mask, kb_down, kb_pressed, kb_released, kb_hotbar_pressed, kb_parse, kb_text, kb_load, kb_save, kb_default_path, kb_key_label,
    kb_find, kb_mouse_code, kb_mouse_button, kb_capture, kb_save_default, kb_load_default,
    KB_NONE, KB_FORWARD, KB_LEFT, KB_BACK, KB_RIGHT, KB_JUMP, KB_SNEAK, KB_SPRINT, KB_ATTACK, KB_PICK, KB_USE, KB_DROP, KB_HOTBAR1,
    KB_INVENTORY, KB_SWAP, KB_SAVE_TOOLBAR, KB_LOAD_TOOLBAR, KB_PLAYERLIST, KB_CHAT, KB_COMMAND, KB_SOCIAL, KB_ADVANCEMENTS,
    KB_SCREENSHOT, KB_PERSPECTIVE, KB_SMOOTH, KB_FULLSCREEN, KB_SPECTATOR_OUTLINES, KB_COUNT,
}

const KB_NONE: i32 = 0 - 1
const KB_FORWARD: i32 = 0
const KB_LEFT: i32 = 1
const KB_BACK: i32 = 2
const KB_RIGHT: i32 = 3
const KB_JUMP: i32 = 4
const KB_SNEAK: i32 = 5
const KB_SPRINT: i32 = 6
const KB_ATTACK: i32 = 7
const KB_PICK: i32 = 8
const KB_USE: i32 = 9
const KB_DROP: i32 = 10
const KB_HOTBAR1: i32 = 11
const KB_INVENTORY: i32 = 20
const KB_SWAP: i32 = 21
const KB_SAVE_TOOLBAR: i32 = 22
const KB_LOAD_TOOLBAR: i32 = 23
const KB_PLAYERLIST: i32 = 24
const KB_CHAT: i32 = 25
const KB_COMMAND: i32 = 26
const KB_SOCIAL: i32 = 27
const KB_ADVANCEMENTS: i32 = 28
const KB_SCREENSHOT: i32 = 29
const KB_PERSPECTIVE: i32 = 30
const KB_SMOOTH: i32 = 31
const KB_FULLSCREEN: i32 = 32
const KB_SPECTATOR_OUTLINES: i32 = 33
const KB_COUNT: i32 = 34
const SLOTS: usize = 40

const REGISTRY: str = "key.forward 17 key.categories.movement\nkey.left 30 key.categories.movement\nkey.back 31 key.categories.movement\nkey.right 32 key.categories.movement\nkey.jump 57 key.categories.movement\nkey.sneak 42 key.categories.movement\nkey.sprint 29 key.categories.movement\nkey.attack 256 key.categories.gameplay\nkey.pickItem 258 key.categories.gameplay\nkey.use 257 key.categories.gameplay\nkey.drop 16 key.categories.inventory\nkey.hotbar.1 2 key.categories.inventory\nkey.hotbar.2 3 key.categories.inventory\nkey.hotbar.3 4 key.categories.inventory\nkey.hotbar.4 5 key.categories.inventory\nkey.hotbar.5 6 key.categories.inventory\nkey.hotbar.6 7 key.categories.inventory\nkey.hotbar.7 8 key.categories.inventory\nkey.hotbar.8 9 key.categories.inventory\nkey.hotbar.9 10 key.categories.inventory\nkey.inventory 18 key.categories.inventory\nkey.swapOffhand 33 key.categories.inventory\nkey.saveToolbarActivator 46 key.categories.creative\nkey.loadToolbarActivator 45 key.categories.creative\nkey.playerlist 15 key.categories.multiplayer\nkey.chat 20 key.categories.multiplayer\nkey.command 53 key.categories.multiplayer\nkey.socialInteractions 25 key.categories.multiplayer\nkey.advancements 38 key.categories.multiplayer\nkey.screenshot 60 key.categories.misc\nkey.togglePerspective 63 key.categories.misc\nkey.smoothCamera 0 key.categories.misc\nkey.fullscreen 87 key.categories.misc\nkey.spectatorOutlines 0 key.categories.misc\n"

struct Keybinds {
    codes: [i32; 40],
}

struct Line {
    start: usize,
    name_len: usize,
    code: i32,
    cat_start: usize,
    cat_len: usize,
}

fn kb_count() -> i32 {
    return KB_COUNT
}

fn kb_mouse_code(button: u32) -> i32 {
    if button == raw.MB_LEFT { return 256 }
    if button == raw.MB_RIGHT { return 257 }
    if button == raw.MB_MIDDLE { return 258 }
    return 256 + (button as i32)
}

fn kb_mouse_button(code: i32) -> u32 {
    if code == 257 { return raw.MB_RIGHT }
    if code == 258 { return raw.MB_MIDDLE }
    if code == 256 { return raw.MB_LEFT }
    return (code - 256) as u32
}

fn line_of(action: i32, ln: *mut Line) -> bool {
    if action < 0 || action >= KB_COUNT { return false }
    var i: usize = 0
    var n: i32 = 0
    while n < action {
        while REGISTRY.chars(i) != 10 as u8 { i = i + 1 }
        i = i + 1
        n = n + 1
    }
    (*ln).start = i
    var k: usize = i
    while REGISTRY.chars(k) != 32 as u8 { k = k + 1 }
    (*ln).name_len = k - i
    k = k + 1
    var v: i32 = 0
    while REGISTRY.chars(k) != 32 as u8 {
        v = v * 10 + ((REGISTRY.chars(k) as i32) - 48)
        k = k + 1
    }
    (*ln).code = v
    k = k + 1
    (*ln).cat_start = k
    while REGISTRY.chars(k) != 10 as u8 { k = k + 1 }
    (*ln).cat_len = k - (*ln).cat_start
    return true
}

fn empty_line() -> Line {
    return Line { start: 0, name_len: 0, code: 0, cat_start: 0, cat_len: 0 }
}

fn kb_default(action: i32) -> i32 {
    var ln: Line = empty_line()
    if !line_of(action, &ln) { return 0 }
    return ln.code
}

fn kb_name(action: i32) -> str {
    var ln: Line = empty_line()
    if !line_of(action, &ln) { return "" }
    return REGISTRY.part(ln.start, ln.name_len)
}

fn kb_category(action: i32) -> str {
    var ln: Line = empty_line()
    if !line_of(action, &ln) { return "" }
    return REGISTRY.part(ln.cat_start, ln.cat_len)
}

fn kb_find(name: str) -> i32 {
    var a: i32 = 0
    while a < KB_COUNT {
        let n: str = kb_name(a)
        if n.length() == name.length() {
            var same: bool = true
            var i: usize = 0
            while i < n.length() && same {
                if n.chars(i) != name.chars(i) { same = false }
                i = i + 1
            }
            if same { return a }
        }
        a = a + 1
    }
    return KB_NONE
}

fn kb_new() -> Keybinds {
    var kb: Keybinds = Keybinds { codes: [0; 40] }
    kb_reset_all(&kb)
    return kb
}

fn kb_reset_all(kb: *mut Keybinds) {
    var a: i32 = 0
    while a < KB_COUNT {
        (*kb).codes[a as usize] = kb_default(a)
        a = a + 1
    }
}

fn kb_get(kb: *mut Keybinds, action: i32) -> i32 {
    if action < 0 || action >= KB_COUNT { return 0 }
    return (*kb).codes[action as usize]
}

fn kb_set(kb: *mut Keybinds, action: i32, code: i32) -> bool {
    if action < 0 || action >= KB_COUNT { return false }
    if code < 0 || code > mc_keynames.KEY_CODE_MAX { return false }
    (*kb).codes[action as usize] = code
    return true
}

fn kb_reset(kb: *mut Keybinds, action: i32) -> bool {
    return kb_set(kb, action, kb_default(action))
}

fn kb_is_default(kb: *mut Keybinds, action: i32) -> bool {
    return kb_get(kb, action) == kb_default(action)
}

fn kb_conflict(kb: *mut Keybinds, action: i32) -> i32 {
    let code: i32 = kb_get(kb, action)
    if code == 0 { return KB_NONE }
    var a: i32 = 0
    while a < KB_COUNT {
        if a != action && (*kb).codes[a as usize] == code { return a }
        a = a + 1
    }
    return KB_NONE
}

fn kb_action_of(kb: *mut Keybinds, code: i32) -> i32 {
    if code == 0 { return KB_NONE }
    var a: i32 = 0
    while a < KB_COUNT {
        if (*kb).codes[a as usize] == code { return a }
        a = a + 1
    }
    return KB_NONE
}

fn kb_move_bits(kb: *mut Keybinds, code: i32) -> u32 {
    var m: u32 = 0 as u32
    if code == 0 { return m }
    if (*kb).codes[0] == code { m = m | mc_input.K_FORWARD }
    if (*kb).codes[1] == code { m = m | mc_input.K_LEFT }
    if (*kb).codes[2] == code { m = m | mc_input.K_BACK }
    if (*kb).codes[3] == code { m = m | mc_input.K_RIGHT }
    if (*kb).codes[4] == code { m = m | mc_input.K_JUMP }
    if (*kb).codes[5] == code { m = m | mc_input.K_SNEAK }
    if (*kb).codes[6] == code { m = m | mc_input.K_SPRINT }
    return m
}

fn kb_move_mask(kb: *mut Keybinds, r: *mut raw.Raw) -> u32 {
    var m: u32 = 0 as u32
    if kb_down(kb, r, KB_FORWARD) { m = m | mc_input.K_FORWARD }
    if kb_down(kb, r, KB_LEFT) { m = m | mc_input.K_LEFT }
    if kb_down(kb, r, KB_BACK) { m = m | mc_input.K_BACK }
    if kb_down(kb, r, KB_RIGHT) { m = m | mc_input.K_RIGHT }
    if kb_down(kb, r, KB_JUMP) { m = m | mc_input.K_JUMP }
    if kb_down(kb, r, KB_SNEAK) { m = m | mc_input.K_SNEAK }
    if kb_down(kb, r, KB_SPRINT) { m = m | mc_input.K_SPRINT }
    return m
}

fn kb_down(kb: *mut Keybinds, r: *mut raw.Raw, action: i32) -> bool {
    let code: i32 = kb_get(kb, action)
    if code <= 0 { return false }
    if code >= 256 { return raw.mouse_down(r, kb_mouse_button(code)) }
    return raw.key_down(r, code as u32)
}

fn kb_pressed(kb: *mut Keybinds, r: *mut raw.Raw, action: i32) -> bool {
    let code: i32 = kb_get(kb, action)
    if code <= 0 { return false }
    if code >= 256 { return raw.mouse_pressed(r, kb_mouse_button(code)) }
    return raw.key_pressed(r, code as u32)
}

fn kb_released(kb: *mut Keybinds, r: *mut raw.Raw, action: i32) -> bool {
    let code: i32 = kb_get(kb, action)
    if code <= 0 { return false }
    if code >= 256 { return raw.mouse_released(r, kb_mouse_button(code)) }
    return raw.key_released(r, code as u32)
}

fn kb_capture(r: *mut raw.Raw) -> i32 {
    var sc: u32 = 1 as u32
    while sc < 256 as u32 {
        if raw.key_pressed(r, sc) { return sc as i32 }
        sc = sc + 1 as u32
    }
    var b: u32 = 0 as u32
    while b < 7 as u32 {
        if raw.mouse_pressed(r, b) { return kb_mouse_code(b) }
        b = b + 1 as u32
    }
    return 0
}

fn kb_hotbar_pressed(kb: *mut Keybinds, r: *mut raw.Raw) -> i32 {
    var i: i32 = 0
    while i < 9 {
        if kb_pressed(kb, r, KB_HOTBAR1 + i) { return i }
        i = i + 1
    }
    return 0 - 1
}

fn kb_key_label(kb: *mut Keybinds, action: i32, out: *mut rt.Buf) {
    let code: i32 = kb_get(kb, action)
    if code == 0 || !mc_keynames.key_name(code, out) {
        let none: str = "Not bound"
        if code == 0 { rt.buf_push_bytes(out, none.p as u64, none.n) }
    }
}

fn kb_parse(kb: *mut Keybinds, p: u64, n: usize) {
    var a: i32 = 0
    while a < KB_COUNT {
        let v: i32 = mc_session.session_int(p, n, kb_name(a), 0 - 1)
        if v >= 0 { kb_set(kb, a, v) }
        a = a + 1
    }
}

fn push_number(out: *mut rt.Buf, value: i32) {
    var digits: [u8; 12] = [0; 12]
    var n: usize = 0
    var v: i32 = value
    if v <= 0 {
        digits[0] = 48 as u8
        n = 1
    }
    while v > 0 {
        digits[n] = (48 + v % 10) as u8
        n = n + 1
        v = v / 10
    }
    while n > 0 {
        n = n - 1
        rt.buf_push(out, digits[n])
    }
}

fn kb_text(kb: *mut Keybinds, out: *mut rt.Buf) {
    var a: i32 = 0
    while a < KB_COUNT {
        if !kb_is_default(kb, a) {
            let nm: str = kb_name(a)
            rt.buf_push_bytes(out, nm.p as u64, nm.n)
            rt.buf_push(out, 61 as u8)
            push_number(out, kb_get(kb, a))
            rt.buf_push(out, 10 as u8)
        }
        a = a + 1
    }
}

fn kb_default_path(out: *mut rt.Buf) -> bool {
    var base: rt.Buf = rt.buf_new()
    if !mc_launch_cfg.cfg_default_path(&base) {
        rt.buf_free(&base)
        return false
    }
    var n: usize = rt.buf_len(&base)
    if n > 4 && rt.buf_at(&base, n - 4) == 46 as u8 { n = n - 4 }
    rt.buf_push_bytes(out, rt.buf_ptr(&base), n)
    let suffix: str = "_keys.cfg"
    rt.buf_push_bytes(out, suffix.p as u64, suffix.n)
    rt.buf_free(&base)
    return true
}

fn kb_load(path: str, kb: *mut Keybinds) -> bool {
    var blob: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &blob) catch 0 as usize
    if n == 0 || rt.buf_len(&blob) == 0 {
        rt.buf_free(&blob)
        return false
    }
    kb_parse(kb, rt.buf_ptr(&blob), rt.buf_len(&blob))
    rt.buf_free(&blob)
    return true
}

fn parent_len(path: str) -> usize {
    var i: usize = path.length()
    while i > 0 {
        if path.chars(i - 1) == 47 as u8 { return i - 1 }
        i = i - 1
    }
    return 0
}

fn kb_save(path: str, kb: *mut Keybinds) -> bool {
    let pl: usize = parent_len(path)
    if pl > 0 { fs.mkdir_all(path.part(0, pl)) catch false }
    var text: rt.Buf = rt.buf_new()
    kb_text(kb, &text)
    let n: usize = fs.write_file(path, rt.buf_ptr(&text), rt.buf_len(&text)) catch 0 as usize
    let ok: bool = n == rt.buf_len(&text)
    rt.buf_free(&text)
    return ok
}

fn kb_save_default(kb: *mut Keybinds) -> bool {
    var path: rt.Buf = rt.buf_new()
    var ok: bool = false
    if kb_default_path(&path) { ok = kb_save(rt.buf_str(&path), kb) }
    rt.buf_free(&path)
    return ok
}

fn kb_load_default(kb: *mut Keybinds) -> bool {
    var path: rt.Buf = rt.buf_new()
    var ok: bool = false
    if kb_default_path(&path) { ok = kb_load(rt.buf_str(&path), kb) }
    rt.buf_free(&path)
    return ok
}
