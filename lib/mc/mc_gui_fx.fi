// SPDX-License-Identifier: MPL-2.0
import std.rt
import mc.mc_raster
import mc.mc_gui_tex

export { fx_blur, fx_fade_black, fx_overlay, fx_fade_alpha, FADE_MS }

const FADE_MS: u64 = 1000 as u64

fn avg3(a: u32, b: u32, c: u32) -> u32 {
    let r: u32 = ((a & 255 as u32) + (b & 255 as u32) + (c & 255 as u32)) / 3 as u32
    let g: u32 = (((a >> 8 as u32) & 255 as u32) + ((b >> 8 as u32) & 255 as u32) + ((c >> 8 as u32) & 255 as u32)) / 3 as u32
    let bl: u32 = (((a >> 16 as u32) & 255 as u32) + ((b >> 16 as u32) & 255 as u32) + ((c >> 16 as u32) & 255 as u32)) / 3 as u32
    return 0xFF000000 as u32 | (bl << 16 as u32) | (g << 8 as u32) | r
}

fn fx_blur(r: *mut mc_raster.Raster) {
    let w: usize = (*r).w as usize
    let h: usize = (*r).h as usize
    if w < 3 || h < 3 { return }
    let tmp: u64 = rt.heap_alloc(w * h * 4)
    if tmp == 0 { return }
    var y: usize = 0
    while y < h {
        let row: usize = y * w
        rt.st32(tmp, row, rt.ld32((*r).color, row))
        rt.st32(tmp, row + w - 1, rt.ld32((*r).color, row + w - 1))
        var x: usize = 1
        while x + 1 < w {
            rt.st32(tmp, row + x, avg3(rt.ld32((*r).color, row + x - 1), rt.ld32((*r).color, row + x), rt.ld32((*r).color, row + x + 1)))
            x = x + 1
        }
        y = y + 1
    }
    var x2: usize = 0
    while x2 < w {
        rt.st32((*r).color, x2, rt.ld32(tmp, x2))
        rt.st32((*r).color, (h - 1) * w + x2, rt.ld32(tmp, (h - 1) * w + x2))
        x2 = x2 + 1
    }
    y = 1
    while y + 1 < h {
        var x3: usize = 0
        while x3 < w {
            rt.st32((*r).color, y * w + x3, avg3(rt.ld32(tmp, (y - 1) * w + x3), rt.ld32(tmp, y * w + x3), rt.ld32(tmp, (y + 1) * w + x3)))
            x3 = x3 + 1
        }
        y = y + 1
    }
    rt.heap_free(tmp, w * h * 4)
}

fn fx_fade_alpha(started_ms: u64, now_ms: u64) -> i32 {
    if now_ms <= started_ms { return 0 }
    let d: u64 = now_ms - started_ms
    if d >= FADE_MS { return 255 }
    return ((d * 255 as u64) / FADE_MS) as i32
}

fn fx_fade_black(r: *mut mc_raster.Raster, alpha: i32) {
    if alpha >= 255 { return }
    let n: usize = ((*r).w as usize) * ((*r).h as usize)
    var i: usize = 0
    while i < n {
        let c: u32 = rt.ld32((*r).color, i)
        let rr: u32 = ((c & 255 as u32) * (alpha as u32)) / 255 as u32
        let gg: u32 = (((c >> 8 as u32) & 255 as u32) * (alpha as u32)) / 255 as u32
        let bb: u32 = (((c >> 16 as u32) & 255 as u32) * (alpha as u32)) / 255 as u32
        rt.st32((*r).color, i, 0xFF000000 as u32 | (bb << 16 as u32) | (gg << 8 as u32) | rr)
        i = i + 1
    }
}

fn fx_overlay(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, alpha: i32) {
    if !mc_gui_tex.gtex_ok(t) || alpha <= 0 { return }
    mc_gui_tex.gtex_draw(r, t, 0, 0, (*r).w, (*r).h, 0, 0, (*t).w, (*t).h, ((alpha as u32) << 24 as u32) | 0xFFFFFF as u32)
}
