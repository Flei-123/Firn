import std.math

export { DigProgress, dp_new, dp_start, dp_stop, dp_tick, dp_owed, dp_done, dp_stage, dp_fraction, TICK_MS }

const TICK_MS: u64 = 50 as u64

struct DigProgress {
    active: bool,
    progress: f64,
    ticks: i32,
    t0: u64,
}

fn dp_new() -> DigProgress {
    return DigProgress { active: false, progress: 0.0, ticks: 0, t0: 0 as u64 }
}

fn dp_start(p: *mut DigProgress, now: u64) {
    (*p).active = true
    (*p).progress = 0.0
    (*p).ticks = 0
    (*p).t0 = now
}

fn dp_stop(p: *mut DigProgress) {
    (*p).active = false
    (*p).progress = 0.0
    (*p).ticks = 0
}

fn dp_tick(p: *mut DigProgress, damage: f64) {
    (*p).ticks = (*p).ticks + 1
    (*p).progress = (*p).progress + damage
}

fn dp_owed(p: *mut DigProgress, now: u64) -> i32 {
    if !(*p).active || now <= (*p).t0 { return 0 }
    let due: i32 = ((now - (*p).t0) / TICK_MS) as i32
    if due <= (*p).ticks { return 0 }
    return due - (*p).ticks
}

fn dp_done(p: *mut DigProgress) -> bool {
    return (*p).active && (*p).progress >= 1.0
}

fn dp_stage(p: *mut DigProgress) -> i32 {
    if !(*p).active { return 0 - 1 }
    var s: i32 = math.floor((*p).progress * 10.0) as i32
    if s > 9 { s = 9 }
    if s < 0 { s = 0 }
    return s
}

fn dp_fraction(p: *mut DigProgress) -> f64 {
    if (*p).progress > 1.0 { return 1.0 }
    return (*p).progress
}
