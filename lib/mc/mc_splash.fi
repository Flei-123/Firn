import std.math
import mc.mc_registry
import mc.mc_world
import mc.mc_precip

export {
    Splash, splash_new, splash_reset, splash_update, splash_live, splash_age_milli,
    SPLASH_MAX, SPLASH_LIFE_MS, SPLASH_RADIUS,
}

const SPLASH_MAX: usize = 64
const SPLASH_LIFE_MS: u64 = 340 as u64
const SPLASH_RADIUS: i32 = 12
const RATE_PER_SEC: i64 = 70 as i64
const DT_CAP_MS: u64 = 250 as u64
const MAX_SPAWNS_PER_UPDATE: i32 = 24
const SCAN_UP: i32 = 24
const SCAN_DEPTH: i32 = 48
const MILLI: i64 = 1000 as i64
const SEED: u64 = 0x9E3779B97F4A7C15 as u64

struct Splash {
    x: [f64; 64],
    y: [f64; 64],
    z: [f64; 64],
    born: [u64; 64],
    head: usize,
    rng: u64,
    acc: i64,
    last_ms: u64,
    n_spawned: u64,
}

fn splash_new() -> Splash {
    return Splash { x: [0.0; 64], y: [0.0; 64], z: [0.0; 64], born: [0 as u64; 64], head: 0, rng: SEED, acc: 0 as i64, last_ms: 0 as u64, n_spawned: 0 as u64 }
}

fn splash_reset(s: *mut Splash) {
    var i: usize = 0
    while i < SPLASH_MAX {
        (*s).born[i] = 0 as u64
        i = i + 1
    }
    (*s).acc = 0 as i64
    (*s).last_ms = 0 as u64
}

fn next_rand(s: *mut Splash) -> u64 {
    var v: u64 = (*s).rng
    v = v ^ (v << 13 as u64)
    v = v ^ (v >> 7 as u64)
    v = v ^ (v << 17 as u64)
    (*s).rng = v
    return v
}

fn splash_age_milli(s: *mut Splash, i: usize, now_ms: u64) -> i32 {
    if (*s).born[i] == 0 as u64 { return 0 - 1 }
    if now_ms < (*s).born[i] { return 0 }
    let age: u64 = now_ms - (*s).born[i]
    if age >= SPLASH_LIFE_MS { return 0 - 1 }
    return ((age * 1000 as u64) / SPLASH_LIFE_MS) as i32
}

fn splash_live(s: *mut Splash, now_ms: u64) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < SPLASH_MAX {
        if splash_age_milli(s, i, now_ms) >= 0 { n = n + 1 }
        i = i + 1
    }
    return n
}

fn spawn_one(s: *mut Splash, p: *mut mc_precip.Precip, w: *mut mc_world.World, reg: *mut mc_registry.Registry, min_y: i32,
    bx: i32, by: i32, bz: i32, now_ms: u64) {
    let r: u64 = next_rand(s)
    let span: u64 = (SPLASH_RADIUS * 2 + 1) as u64
    let dx: i32 = ((r % span) as i32) - SPLASH_RADIUS
    let dz: i32 = (((r >> 16 as u64) % span) as i32) - SPLASH_RADIUS
    if dx * dx + dz * dz > SPLASH_RADIUS * SPLASH_RADIUS { return }
    let sy: i32 = mc_precip.precip_surface(p, w, reg, min_y, bx + dx, bz + dz, by + SCAN_UP, SCAN_DEPTH)
    if sy == mc_precip.SURFACE_NONE { return }
    let fx: f64 = ((r >> 32 as u64) & 1023 as u64) as f64 / 1024.0
    let fz: f64 = ((r >> 44 as u64) & 1023 as u64) as f64 / 1024.0
    let i: usize = (*s).head % SPLASH_MAX
    (*s).head = (*s).head + 1
    (*s).x[i] = ((bx + dx) as f64) + 0.1 + 0.8 * fx
    (*s).y[i] = ((sy + 1) as f64) + 0.01
    (*s).z[i] = ((bz + dz) as f64) + 0.1 + 0.8 * fz
    (*s).born[i] = now_ms
    (*s).n_spawned = (*s).n_spawned + 1 as u64
}

fn splash_update(s: *mut Splash, p: *mut mc_precip.Precip, w: *mut mc_world.World, reg: *mut mc_registry.Registry, min_y: i32,
    ex: f64, ey: f64, ez: f64, rain_milli: i32, kind: i32, now_ms: u64) {
    var dt: u64 = 0 as u64
    if (*s).last_ms != 0 as u64 && now_ms > (*s).last_ms { dt = now_ms - (*s).last_ms }
    (*s).last_ms = now_ms
    if dt > DT_CAP_MS { dt = DT_CAP_MS }
    if kind != mc_precip.PRECIP_RAIN || rain_milli <= 0 {
        (*s).acc = 0 as i64
        return
    }
    (*s).acc = (*s).acc + ((dt as i64) * RATE_PER_SEC * (rain_milli as i64)) / MILLI
    let bx: i32 = math.floor(ex) as i32
    let by: i32 = math.floor(ey) as i32
    let bz: i32 = math.floor(ez) as i32
    var tries: i32 = 0
    while (*s).acc >= MILLI && tries < MAX_SPAWNS_PER_UPDATE {
        (*s).acc = (*s).acc - MILLI
        tries = tries + 1
        spawn_one(s, p, w, reg, min_y, bx, by, bz, now_ms)
    }
    if (*s).acc >= MILLI { (*s).acc = 0 as i64 }
}
