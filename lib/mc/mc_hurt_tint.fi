export { HurtTable, hurt_new, hurt_mark, hurt_age, hurt_since, hurt_strength_permille, hurt_blend, HURT_TINT_MS, HURT_SLOTS }

const HURT_SLOTS: usize = 16
const HURT_TINT_MS: i64 = 500
const NONE_MS: u64 = 0 as u64

struct HurtTable {
    ids: [i32; 16],
    ms: [u64; 16],
    next: usize,
}

fn hurt_new() -> HurtTable {
    return HurtTable { ids: [0 - 1; 16], ms: [0 as u64; 16], next: 0 as usize }
}

fn find_slot(t: *mut HurtTable, eid: i32) -> i32 {
    var i: usize = 0
    while i < HURT_SLOTS {
        if (*t).ids[i] == eid && (*t).ms[i] != NONE_MS { return i as i32 }
        i = i + 1
    }
    return 0 - 1
}

fn hurt_mark(t: *mut HurtTable, eid: i32, now: u64) {
    var k: i32 = find_slot(t, eid)
    if k < 0 {
        k = (*t).next as i32
        (*t).next = ((*t).next + 1) % HURT_SLOTS
    }
    (*t).ids[k as usize] = eid
    (*t).ms[k as usize] = now
}

fn hurt_age(t: *mut HurtTable, eid: i32, now: u64) -> i64 {
    let k: i32 = find_slot(t, eid)
    if k < 0 { return 0 - 1 }
    let at: u64 = (*t).ms[k as usize]
    if now < at { return 0 - 1 }
    let age: i64 = (now - at) as i64
    if age >= HURT_TINT_MS { return 0 - 1 }
    return age
}

fn hurt_since(t: *mut HurtTable, eid: i32, now: u64) -> i64 {
    let k: i32 = find_slot(t, eid)
    if k < 0 { return 0 - 1 }
    let at: u64 = (*t).ms[k as usize]
    if now < at { return 0 - 1 }
    return (now - at) as i64
}

fn hurt_strength_permille(t: *mut HurtTable, eid: i32, now: u64) -> i32 {
    let age: i64 = hurt_age(t, eid, now)
    if age < 0 { return 0 }
    return 650
}

fn mix(c: i32, target: i32, k: i32) -> i32 {
    return c + ((target - c) * k) / 1000
}

fn hurt_blend(r: i32, g: i32, b: i32, k: i32) -> i32 {
    return mix(r, 255, k) | (mix(g, 0, k) << 8) | (mix(b, 0, k) << 16)
}
