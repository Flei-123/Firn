import std.rt
import mc.mc_item_src
import mc.mc_spr_set

export { crspr_open, crspr_tab_id, crspr_scroller_id, CRSPR_TABS_LOADED }

const CRSPR_TABS_LOADED: i32 = 28
const SCROLLER: i32 = 28
const SCROLLER_DIS: i32 = 29
const PREFIX: str = "assets/minecraft/textures/gui/sprites/container/creative_inventory/"
const DIGITS: str = "1234567"

fn crspr_tab_id(top: bool, selected: bool, col: i32) -> i32 {
    var id: i32 = col
    if !top { id = id + 14 }
    if selected { id = id + 7 }
    return id
}

fn crspr_scroller_id(enabled: bool) -> i32 {
    if enabled { return SCROLLER }
    return SCROLLER_DIS
}

fn tab_name(id: i32, b: *mut rt.Buf) {
    rt.buf_clear(b)
    var base: str = "tab_top_"
    if id >= 14 { base = "tab_bottom_" }
    rt.buf_push_bytes(b, base.p as u64, base.length())
    var state: str = "unselected_"
    if (id % 14) >= 7 { state = "selected_" }
    rt.buf_push_bytes(b, state.p as u64, state.length())
    rt.buf_push_bytes(b, DIGITS.p as u64 + ((id % 7) as u64), 1)
}

fn crspr_open(s: *mut mc_spr_set.SprSet, src: *mut mc_item_src.ItemSrc) -> bool {
    var k: i32 = 0
    var tabs: bool = true
    var nb: rt.Buf = rt.buf_new()
    while k < CRSPR_TABS_LOADED {
        tab_name(k, &nb)
        if !mc_spr_set.sset_load(s, src, k, PREFIX, rt.buf_str(&nb)) { tabs = false }
        k = k + 1
    }
    rt.buf_free(&nb)
    mc_spr_set.sset_load(s, src, SCROLLER, PREFIX, "scroller")
    mc_spr_set.sset_load(s, src, SCROLLER_DIS, PREFIX, "scroller_disabled")
    return tabs
}
