import std.bytes
import mc.mc_client
import mc.mc_chat_net

export { pkt_view, pkt_f32, pkt_varint, pkt_i32, pkt_i8 }

fn pkt_view(cl: *mut mc_client.Client, id: i32, name: str, b: *mut bytes.Bytes) -> bool {
    var p: u64 = 0
    var n: usize = 0
    if !mc_chat_net.field_of(cl, id, name, &p, &n) { return false }
    *b = bytes.Bytes { data: p, cap: n, len: n, pos: 0, bad: false }
    return true
}

fn pkt_f32(cl: *mut mc_client.Client, id: i32, name: str, out: *mut f32) -> bool {
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !pkt_view(cl, id, name, &v) || v.len != 4 { return false }
    *out = bytes.get_f32(&v) catch (0.0 as f32)
    return true
}

fn pkt_varint(cl: *mut mc_client.Client, id: i32, name: str, out: *mut i32) -> bool {
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !pkt_view(cl, id, name, &v) { return false }
    *out = bytes.get_varint(&v) catch (0 - 1)
    return true
}

fn pkt_i32(cl: *mut mc_client.Client, id: i32, name: str, out: *mut i32) -> bool {
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !pkt_view(cl, id, name, &v) || v.len != 4 { return false }
    *out = bytes.get_i32(&v) catch (0 - 1)
    return true
}

fn pkt_i8(cl: *mut mc_client.Client, id: i32, name: str, out: *mut i32) -> bool {
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !pkt_view(cl, id, name, &v) || v.len != 1 { return false }
    *out = (bytes.get_i8(&v) catch (0 as i8)) as i32
    return true
}
