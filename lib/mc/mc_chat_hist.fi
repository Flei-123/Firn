// SPDX-License-Identifier: MPL-2.0
import std.rt

export { ChatHist, hist_new, hist_free, hist_push, hist_step, hist_reset, HIST_MAX, HIST_LINE }

const HIST_MAX: usize = 100
const HIST_LINE: usize = 256

struct ChatHist {
    text: rt.Buf,
    lens: rt.Buf,
    head: usize,
    count: usize,
    pos: i32,
    draft: rt.Buf,
}

fn fill_zero(b: *mut rt.Buf, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push(b, 0)
        i = i + 1
    }
}

fn hist_new() -> ChatHist {
    var h: ChatHist = ChatHist { text: rt.buf_new(), lens: rt.buf_new(), head: 0, count: 0, pos: 0 - 1, draft: rt.buf_new() }
    fill_zero(&h.text, HIST_MAX * HIST_LINE)
    fill_zero(&h.lens, HIST_MAX * 4)
    return h
}

fn hist_free(h: *mut ChatHist) {
    rt.buf_free(&(*h).text)
    rt.buf_free(&(*h).lens)
    rt.buf_free(&(*h).draft)
}

fn slot_of(h: *mut ChatHist, k: usize) -> usize {
    return ((*h).head + HIST_MAX * 2 - 1 - k) % HIST_MAX
}

fn slot_len(h: *mut ChatHist, k: usize) -> usize {
    return rt.ld32(rt.buf_ptr(&(*h).lens), slot_of(h, k)) as usize
}

fn slot_ptr(h: *mut ChatHist, k: usize) -> u64 {
    return rt.buf_ptr(&(*h).text) + (slot_of(h, k) * HIST_LINE) as u64
}

fn hist_reset(h: *mut ChatHist) {
    (*h).pos = 0 - 1
    rt.buf_clear(&(*h).draft)
}

fn hist_push(h: *mut ChatHist, p: u64, n: usize) {
    hist_reset(h)
    if n == 0 || n > HIST_LINE { return }
    if (*h).count > 0 && slot_len(h, 0) == n && rt.mem_eq(slot_ptr(h, 0), p, n) { return }
    let idx: usize = (*h).head
    let dst: u64 = rt.buf_ptr(&(*h).text) + (idx * HIST_LINE) as u64
    var i: usize = 0
    while i < n {
        rt.st8(dst, i, rt.ld8(p, i))
        i = i + 1
    }
    rt.st32(rt.buf_ptr(&(*h).lens), idx, n as u32)
    (*h).head = (idx + 1) % HIST_MAX
    if (*h).count < HIST_MAX { (*h).count = (*h).count + 1 }
}

fn hist_step(h: *mut ChatHist, cur_p: u64, cur_n: usize, dir: i32, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    if dir < 0 {
        if (*h).count == 0 { return false }
        if (*h).pos < 0 {
            rt.buf_clear(&(*h).draft)
            rt.buf_push_bytes(&(*h).draft, cur_p, cur_n)
            (*h).pos = 0
        } else if ((*h).pos as usize) + 1 < (*h).count {
            (*h).pos = (*h).pos + 1
        } else {
            return false
        }
        rt.buf_push_bytes(out, slot_ptr(h, (*h).pos as usize), slot_len(h, (*h).pos as usize))
        return true
    }
    if (*h).pos < 0 { return false }
    if (*h).pos == 0 {
        (*h).pos = 0 - 1
        rt.buf_push_bytes(out, rt.buf_ptr(&(*h).draft), rt.buf_len(&(*h).draft))
        return true
    }
    (*h).pos = (*h).pos - 1
    rt.buf_push_bytes(out, slot_ptr(h, (*h).pos as usize), slot_len(h, (*h).pos as usize))
    return true
}
