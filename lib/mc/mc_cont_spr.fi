import mc.mc_raster
import mc.mc_item_src
import mc.mc_spr_set

export {
    cspr_open, cspr_draw, cspr_draw_part,
    CS_ENCH_SLOT, CS_ENCH_SLOT_HI, CS_ENCH_SLOT_DIS, CS_LEVEL, CS_LEVEL_DIS, CS_BUBBLES, CS_FUEL, CS_BREW,
    CS_ANVIL_FIELD, CS_ANVIL_FIELD_DIS, CS_ANVIL_ERR, CS_HORSE_CHEST, CS_SLOT, CS_COUNT,
}

const CS_ENCH_SLOT: i32 = 0
const CS_ENCH_SLOT_HI: i32 = 1
const CS_ENCH_SLOT_DIS: i32 = 2
const CS_LEVEL: i32 = 3
const CS_LEVEL_DIS: i32 = 6
const CS_BUBBLES: i32 = 9
const CS_FUEL: i32 = 10
const CS_BREW: i32 = 11
const CS_ANVIL_FIELD: i32 = 12
const CS_ANVIL_FIELD_DIS: i32 = 13
const CS_ANVIL_ERR: i32 = 14
const CS_HORSE_CHEST: i32 = 15
const CS_SLOT: i32 = 16
const CS_COUNT: i32 = 17
const PREFIX: str = "assets/minecraft/textures/gui/sprites/container/"

fn name_of(id: i32) -> str {
    if id == CS_ENCH_SLOT { return "enchanting_table/enchantment_slot" }
    if id == CS_ENCH_SLOT_HI { return "enchanting_table/enchantment_slot_highlighted" }
    if id == CS_ENCH_SLOT_DIS { return "enchanting_table/enchantment_slot_disabled" }
    if id == CS_LEVEL { return "enchanting_table/level_1" }
    if id == CS_LEVEL + 1 { return "enchanting_table/level_2" }
    if id == CS_LEVEL + 2 { return "enchanting_table/level_3" }
    if id == CS_LEVEL_DIS { return "enchanting_table/level_1_disabled" }
    if id == CS_LEVEL_DIS + 1 { return "enchanting_table/level_2_disabled" }
    if id == CS_LEVEL_DIS + 2 { return "enchanting_table/level_3_disabled" }
    if id == CS_BUBBLES { return "brewing_stand/bubbles" }
    if id == CS_FUEL { return "brewing_stand/fuel_length" }
    if id == CS_BREW { return "brewing_stand/brew_progress" }
    if id == CS_ANVIL_FIELD { return "anvil/text_field" }
    if id == CS_ANVIL_FIELD_DIS { return "anvil/text_field_disabled" }
    if id == CS_ANVIL_ERR { return "anvil/error" }
    if id == CS_HORSE_CHEST { return "horse/chest_slots" }
    return "slot"
}

fn cspr_open(s: *mut mc_spr_set.SprSet, src: *mut mc_item_src.ItemSrc) -> bool {
    var k: i32 = 0
    while k < CS_COUNT {
        mc_spr_set.sset_load(s, src, k, PREFIX, name_of(k))
        k = k + 1
    }
    return mc_spr_set.sset_any(s)
}

fn cspr_draw(r: *mut mc_raster.Raster, s: *mut mc_spr_set.SprSet, id: i32, px: i32, py: i32, sc: i32, x: i32, y: i32) {
    mc_spr_set.sset_draw(r, s, id, px + x * sc, py + y * sc, sc)
}

fn cspr_draw_part(r: *mut mc_raster.Raster, s: *mut mc_spr_set.SprSet, id: i32, px: i32, py: i32, sc: i32, x: i32, y: i32, sx: i32, sy: i32, w: i32, h: i32) {
    mc_spr_set.sset_draw_part(r, s, id, px + x * sc, py + y * sc, sc, sx, sy, w, h)
}
