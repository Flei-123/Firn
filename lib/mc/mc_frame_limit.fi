import mc.mc_opts

export {
    fl_vsync_on, fl_frame_ns, fl_label_unlimited, CPU_FALLBACK_FPS,
}

const CPU_FALLBACK_FPS: i32 = 60

fn fl_vsync_on(opt_vsync: i32, env_set: bool, env_vsync: i32) -> bool {
    if env_set { return env_vsync != 0 }
    return opt_vsync != 0
}

fn fl_label_unlimited(limit: i32) -> bool {
    return limit >= mc_opts.FPS_UNLIMITED
}

fn fl_frame_ns(opt_limit: i32, env_set: bool, env_fps: i32, gpu_present: bool) -> u64 {
    var fps: i32 = 0
    if env_set {
        fps = env_fps
    } else if !fl_label_unlimited(opt_limit) {
        fps = opt_limit
    }
    if fps <= 0 && !gpu_present { fps = CPU_FALLBACK_FPS }
    if fps <= 0 { return 0 as u64 }
    return 1000000000 as u64 / (fps as u64)
}
