import std.rt
import mc.mc_raster
import mc.mc_gui_tex
import mc.mc_item_src

export { SprSet, sset_new, sset_free, sset_load, sset_has, sset_any, sset_draw, sset_draw_part, SPR_MAX }

const SPR_MAX: i32 = 40
const WHITE: u32 = 0xFFFFFFFF

struct SprSet {
    tex: [mc_gui_tex.GuiTex; 40],
}

fn sset_new() -> SprSet {
    return SprSet { tex: [mc_gui_tex.gtex_empty(); 40] }
}

fn sset_free(s: *mut SprSet) {
    var k: i32 = 0
    while k < SPR_MAX {
        mc_gui_tex.gtex_free(&(*s).tex[k as usize])
        k = k + 1
    }
}

fn sset_load(s: *mut SprSet, src: *mut mc_item_src.ItemSrc, idx: i32, prefix: str, name: str) -> bool {
    if idx < 0 || idx >= SPR_MAX { return false }
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, prefix.p as u64, prefix.length())
    rt.buf_push_bytes(&b, name.p as u64, name.length())
    rt.buf_push_bytes(&b, ".png".p as u64, 4)
    let ok: bool = mc_item_src.isrc_tex_full(src, rt.buf_ptr(&b), rt.buf_len(&b), &(*s).tex[idx as usize])
    rt.buf_free(&b)
    return ok
}

fn sset_has(s: *mut SprSet, idx: i32) -> bool {
    if idx < 0 || idx >= SPR_MAX { return false }
    return mc_gui_tex.gtex_ok(&(*s).tex[idx as usize])
}

fn sset_any(s: *mut SprSet) -> bool {
    var k: i32 = 0
    while k < SPR_MAX {
        if mc_gui_tex.gtex_ok(&(*s).tex[k as usize]) { return true }
        k = k + 1
    }
    return false
}

fn sset_draw(r: *mut mc_raster.Raster, s: *mut SprSet, idx: i32, x: i32, y: i32, sc: i32) {
    if !sset_has(s, idx) { return }
    let t: *mut mc_gui_tex.GuiTex = &(*s).tex[idx as usize]
    mc_gui_tex.gtex_draw(r, t, x, y, (*t).w * sc, (*t).h * sc, 0, 0, (*t).w, (*t).h, WHITE)
}

fn sset_draw_part(r: *mut mc_raster.Raster, s: *mut SprSet, idx: i32, x: i32, y: i32, sc: i32, sx: i32, sy: i32, w: i32, h: i32) {
    if !sset_has(s, idx) || w <= 0 || h <= 0 { return }
    mc_gui_tex.gtex_draw(r, &(*s).tex[idx as usize], x, y, w * sc, h * sc, sx, sy, w, h, WHITE)
}
