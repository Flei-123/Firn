// SPDX-License-Identifier: MPL-2.0
import std.bytes

export { PathSum, path_sum_new, read_delta_path, read_position_path }

const BAD: i32 = 0 - 2147483647 - 1
const MAX_STEPS: i32 = 4096

struct PathSum {
    x: f64,
    y: f64,
    z: f64,
}

fn path_sum_new() -> PathSum {
    return PathSum { x: 0.0, y: 0.0, z: 0.0 }
}

fn read_varint(b: *mut bytes.Bytes, out: *mut i32) -> bool {
    if bytes.bytes_remaining(b) < 1 {
        return false
    }
    let v: i32 = bytes.get_varint(b) catch BAD
    *out = v
    return v != BAD
}

fn read_i16_triple(b: *mut bytes.Bytes, out: *mut PathSum) -> bool {
    if bytes.bytes_remaining(b) < 6 {
        return false
    }
    let a: i16 = bytes.get_i16(b) catch 0
    let c: i16 = bytes.get_i16(b) catch 0
    let d: i16 = bytes.get_i16(b) catch 0
    (*out).x = (*out).x + (a as f64) / 4096.0
    (*out).y = (*out).y + (c as f64) / 4096.0
    (*out).z = (*out).z + (d as f64) / 4096.0
    return true
}

fn read_f64_triple(b: *mut bytes.Bytes, out: *mut PathSum) -> bool {
    if bytes.bytes_remaining(b) < 24 {
        return false
    }
    (*out).x = bytes.get_f64(b) catch 0.0
    (*out).y = bytes.get_f64(b) catch 0.0
    (*out).z = bytes.get_f64(b) catch 0.0
    return true
}

fn read_delta_path(b: *mut bytes.Bytes, steps: i32, out: *mut PathSum) -> bool {
    if steps == 0 {
        return read_i16_triple(b, out)
    }
    if steps < 0 || steps > MAX_STEPS {
        return false
    }
    var i: i32 = 0
    while i < steps {
        var ticks: i32 = 0
        if !read_varint(b, &ticks) {
            return false
        }
        if !read_i16_triple(b, out) {
            return false
        }
        i = i + 1
    }
    return true
}

fn read_position_path(b: *mut bytes.Bytes, out: *mut PathSum) -> bool {
    var path_type: i32 = 0
    if !read_varint(b, &path_type) {
        return false
    }
    if path_type == 0 {
        return read_f64_triple(b, out)
    }
    var count: i32 = 0
    if !read_varint(b, &count) {
        return false
    }
    if count < 0 || count > MAX_STEPS {
        return false
    }
    var i: i32 = 0
    while i < count {
        if !read_f64_triple(b, out) {
            return false
        }
        var ticks: i32 = 0
        if !read_varint(b, &ticks) {
            return false
        }
        i = i + 1
    }
    return true
}
