import std.math
import mc.mc_xf
import mc.mc_vox
import mc.mc_camera
import mc.mc_entity_draw
import mc.mc_player_parts
import mc.mc_player_model
import mc.mc_held_item

export { hand_draw, EQUIP_MS }

const EQUIP_MS: u64 = 280 as u64
const PI: f64 = 3.141592653589793
const DEG: f64 = 0.017453292519943295

fn hand_origin(b: *mut mc_xf.Xf, cam: *mut mc_camera.Camera, ox: f64, oy: f64, oz: f64) {
    (*b).m[0] = (*cam).rx
    (*b).m[4] = (*cam).ry
    (*b).m[8] = (*cam).rz
    (*b).m[1] = (*cam).ux
    (*b).m[5] = (*cam).uy
    (*b).m[9] = (*cam).uz
    (*b).m[2] = (*cam).fx
    (*b).m[6] = (*cam).fy
    (*b).m[10] = (*cam).fz
    (*b).m[3] = (*cam).x + (*cam).rx * ox + (*cam).ux * oy + (*cam).fx * oz
    (*b).m[7] = (*cam).y + (*cam).ry * ox + (*cam).uy * oy + (*cam).fy * oz
    (*b).m[11] = (*cam).z + (*cam).rz * ox + (*cam).uz * oy + (*cam).fz * oz
}

fn hand_draw(l: *mut mc_entity_draw.EntList, pc: *mut mc_player_parts.PlayerCubes, h: *mut mc_held_item.Held, cam: *mut mc_camera.Camera,
    yaw: f64, swing: f64, equip: f64, use_kind: i32, time_s: f64) {
    var ox: f64 = 0.42
    var oy: f64 = 0.0 - 0.4 - (1.0 - equip) * 0.7
    var oz: f64 = 0.0 - 0.1
    var rx: f64 = 0.0 - 104.0
    var ry: f64 = 0.0 - 8.0
    var rz: f64 = 0.0
    if swing >= 0.0 && swing <= 1.0 {
        let s1: f64 = math.sin(swing * PI)
        let s2: f64 = math.sin(math.sqrt(swing) * PI)
        oz = oz + s1 * 0.18
        ox = ox - s2 * 0.2
        oy = oy - math.sin(math.sqrt(swing) * PI * 2.0) * 0.08
        rx = rx + s2 * 38.0
        ry = ry - s2 * 24.0
    }
    if use_kind == mc_player_model.ARM_EAT {
        let bob: f64 = math.fabs(math.cos(time_s * 14.0)) * 0.05
        ox = 0.18
        oy = 0.0 - 0.24 + bob
        oz = 0.15
        rx = 0.0 - 85.0
        ry = 0.0 - 28.0
    } else if use_kind == mc_player_model.ARM_BOW {
        ox = 0.22
        oy = 0.0 - 0.26
        oz = 0.12
        rx = 0.0 - 80.0
        ry = 0.0 - 10.0
    } else if use_kind == mc_player_model.ARM_BLOCK {
        ox = 0.3
        oy = 0.0 - 0.3
        oz = 0.05
        rx = 0.0 - 50.0
        ry = 0.0 - 30.0
    }
    var b: mc_xf.Xf = mc_xf.xf_ident()
    hand_origin(&b, cam, ox, oy, oz)
    mc_xf.xf_scale(&b, mc_player_model.PLAYER_UNIT)
    mc_xf.xf_rot_z(&b, rz)
    mc_xf.xf_rot_y(&b, ry)
    mc_xf.xf_rot_x(&b, rx)
    let ys: f64 = math.sin(yaw * DEG)
    let yc: f64 = 0.0 - math.cos(yaw * DEG)
    mc_vox.vox_emit(l, &(*pc).parts[mc_player_parts.PART_RARM], &b, mc_player_model.PLAYER_UNIT, ys, yc, 0)
    mc_player_model.draw_item(l, &b, h, ys, yc, 0, 0.55)
}
