import mc.mc_gui_ui

export { info_frame, options_frame, OPTIONS_COUNT }

const OPTIONS_COUNT: i32 = 12

fn option_key(i: i32) -> str {
    if i == 0 { return "options.fov" }
    if i == 1 { return "options.online" }
    if i == 2 { return "options.skinCustomisation" }
    if i == 3 { return "options.sounds" }
    if i == 4 { return "options.video" }
    if i == 5 { return "options.controls" }
    if i == 6 { return "options.language" }
    if i == 7 { return "options.chat" }
    if i == 8 { return "options.resourcepack" }
    if i == 9 { return "options.accessibility" }
    if i == 10 { return "options.telemetry" }
    return "options.credits_and_attribution"
}

fn option_fallback(i: i32) -> str {
    if i == 0 { return "Field of View" }
    if i == 1 { return "Online..." }
    if i == 2 { return "Skin Customization..." }
    if i == 3 { return "Music & Sounds..." }
    if i == 4 { return "Video Settings..." }
    if i == 5 { return "Controls..." }
    if i == 6 { return "Language..." }
    if i == 7 { return "Chat Settings..." }
    if i == 8 { return "Resource Packs..." }
    if i == 9 { return "Accessibility Settings..." }
    if i == 10 { return "Telemetry Data..." }
    return "Credits & Attribution"
}

fn info_frame(u: *mut mc_gui_ui.Ui, title: str, line1: str, line2: str) -> bool {
    mc_gui_ui.ui_dirt(u, 0x404040)
    let cx: i32 = (*u).uw / 2
    let top: i32 = (*u).uh / 2 - 36
    mc_gui_ui.ui_label_c(u, cx, top, mc_gui_ui.COLOR_WHITE, title)
    mc_gui_ui.ui_label_c(u, cx, top + 20, mc_gui_ui.COLOR_GRAY, line1)
    mc_gui_ui.ui_label_c(u, cx, top + 30, mc_gui_ui.COLOR_GRAY, line2)
    return mc_gui_ui.ui_button(u, cx - 100, top + 56, 200, mc_gui_ui.ui_lang(u, "gui.done", "Done"), true)
}

fn options_frame(u: *mut mc_gui_ui.Ui) -> bool {
    mc_gui_ui.ui_dirt(u, 0x404040)
    let cx: i32 = (*u).uw / 2
    mc_gui_ui.ui_label_c(u, cx, 15, mc_gui_ui.COLOR_WHITE, mc_gui_ui.ui_lang(u, "options.title", "Options"))
    var i: i32 = 0
    while i < OPTIONS_COUNT {
        var x: i32 = cx - 155 + (i % 2) * 160
        var w: i32 = 150
        var y: i32 = (*u).uh / 6 - 12 + 24 * (i / 2)
        if i == OPTIONS_COUNT - 1 {
            x = cx - 155 + 160 * 0
            w = 150
        }
        mc_gui_ui.ui_button(u, x, y, w, mc_gui_ui.ui_lang(u, option_key(i), option_fallback(i)), false)
        i = i + 1
    }
    return mc_gui_ui.ui_button(u, cx - 100, (*u).uh / 6 + 168, 200, mc_gui_ui.ui_lang(u, "gui.done", "Done"), true)
}
