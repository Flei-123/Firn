// SPDX-License-Identifier: MPL-2.0
import std.rt
import mc.mc_item_names

export { bare, next_line, find_tag, parse_num, split_tab, nth_word, put_fmt, lang_fmt, put_hundredths }

fn bare(p: u64, n: usize, out_p: *mut u64, out_n: *mut usize) {
    var i: usize = 0
    while i < n && rt.ld8(p, i) != 58 as u8 { i = i + 1 }
    if i >= n {
        *out_p = p
        *out_n = n
        return
    }
    *out_p = p + ((i + 1) as u64)
    *out_n = n - i - 1
}

fn next_line(rp: u64, rn: usize, pos: *mut usize, tag: *mut u8, lp: *mut u64, ln: *mut usize) -> bool {
    if *pos >= rn { return false }
    var e: usize = *pos
    while e < rn && rt.ld8(rp, e) != 10 as u8 { e = e + 1 }
    *tag = rt.ld8(rp, *pos)
    *lp = rp + ((*pos + 1) as u64)
    *ln = e - *pos - 1
    *pos = e + 1
    return true
}

fn find_tag(rp: u64, rn: usize, want: u8, out_p: *mut u64, out_n: *mut usize) -> bool {
    var pos: usize = 0
    var tag: u8 = 0 as u8
    var lp: u64 = 0
    var ln: usize = 0
    while next_line(rp, rn, &pos, &tag, &lp, &ln) {
        if tag == want {
            *out_p = lp
            *out_n = ln
            return true
        }
    }
    return false
}

fn parse_num(p: u64, n: usize, ok: *mut bool) -> i64 {
    var i: usize = 0
    var neg: bool = false
    var r: i64 = 0
    *ok = n > 0
    if n > 0 && rt.ld8(p, 0) == 45 as u8 { neg = true; i = 1; *ok = n > 1 }
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 { *ok = false; return 0 }
        r = r * 10 + ((c as i64) - 48)
        if r > 2000000000000 { *ok = false; return 0 }
        i = i + 1
    }
    if neg { r = 0 - r }
    return r
}

fn split_tab(p: u64, n: usize, from: usize, out_p: *mut u64, out_n: *mut usize) -> usize {
    var e: usize = from
    while e < n && rt.ld8(p, e) != 9 as u8 { e = e + 1 }
    *out_p = p + (from as u64)
    *out_n = e - from
    if e < n { return e + 1 }
    return n
}

fn nth_word(p: u64, n: usize, idx: i32, sep: u8, out_p: *mut u64, out_n: *mut usize) -> bool {
    var cur: i32 = 0
    var s: usize = 0
    var i: usize = 0
    while i <= n {
        if i == n || rt.ld8(p, i) == sep {
            if cur == idx {
                *out_p = p + (s as u64)
                *out_n = i - s
                return i > s
            }
            cur = cur + 1
            s = i + 1
        }
        i = i + 1
    }
    return false
}

fn put_fmt(out: *mut rt.Buf, tp: u64, tn: usize, ap: u64, an: usize, bp: u64, bn: usize) {
    var i: usize = 0
    var next: i32 = 0
    while i < tn {
        let c: u8 = rt.ld8(tp, i)
        var which: i32 = 0 - 1
        var adv: usize = 1
        if c == 37 as u8 && i + 1 < tn {
            let d: u8 = rt.ld8(tp, i + 1)
            if d == 37 as u8 {
                rt.buf_push(out, 37 as u8)
                i = i + 2
                continue
            }
            if d == 115 as u8 {
                which = next
                next = next + 1
                adv = 2
            } else if d >= 49 as u8 && d <= 50 as u8 && i + 3 < tn && rt.ld8(tp, i + 2) == 36 as u8 && rt.ld8(tp, i + 3) == 115 as u8 {
                which = (d as i32) - 49
                adv = 4
            }
        }
        if which == 0 {
            rt.buf_push_bytes(out, ap, an)
        } else if which == 1 {
            rt.buf_push_bytes(out, bp, bn)
        } else {
            rt.buf_push(out, c)
        }
        i = i + adv
    }
}

fn lang_fmt(key: str, fallback: str, ap: u64, an: usize, bp: u64, bn: usize, out: *mut rt.Buf) {
    var t: rt.Buf = rt.buf_new()
    if !mc_item_names.names_find(key.p as u64, key.n, &t) { rt.buf_push_bytes(&t, fallback.p as u64, fallback.n) }
    put_fmt(out, rt.buf_ptr(&t), rt.buf_len(&t), ap, an, bp, bn)
    rt.buf_free(&t)
}

fn put_hundredths(out: *mut rt.Buf, v: i64) {
    var a: i64 = v
    if a < 0 { a = 0 - a }
    rt.buf_push_dec_i64(out, a / 100)
    let f: i64 = a % 100
    if f != 0 {
        rt.buf_push(out, 46 as u8)
        rt.buf_push(out, (48 + f / 10) as u8)
        if (f % 10) != 0 { rt.buf_push(out, (48 + f % 10) as u8) }
    }
}
