// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_procmem.fi -- process memory for the benchmark harness (Linux: /proc/self/status). Windows twin: mc_procmem.windows.fi.
// rss_kb() = current resident set (VmRSS), peak_kb() = peak resident set (VmHWM), both in kB; 0 when unavailable.
import std.rt

export {
    rss_kb, peak_kb,
}

// value of "<name>:   <n> kB" in /proc/self/status (0 when missing)
fn status_kb(name: str) -> u64 {
    var b: rt.Buf = rt.buf_new()
    var path: [u8; 18] = "/proc/self/status\0"
    if !rt.read_file((&path[0]) as u64, &b) {
        rt.buf_free(&b)
        return 0 as u64
    }
    let p: u64 = rt.buf_ptr(&b)
    let n: usize = rt.buf_len(&b)
    var i: usize = 0
    var v: u64 = 0
    while i + name.n + 1 < n {
        var ok: bool = true
        var k: usize = 0
        while k < name.n {
            if rt.ld8(p, i + k) != name.chars(k) {
                ok = false
                break
            }
            k = k + 1
        }
        if ok && rt.ld8(p, i + name.n) == 58 as u8 && (i == 0 || rt.ld8(p, i - 1) == 10 as u8) {
            var j: usize = i + name.n + 1
            while j < n && (rt.ld8(p, j) == 32 as u8 || rt.ld8(p, j) == 9 as u8) {
                j = j + 1
            }
            while j < n && rt.ld8(p, j) >= 48 as u8 && rt.ld8(p, j) <= 57 as u8 {
                v = v * 10 as u64 + (rt.ld8(p, j) - 48 as u8) as u64
                j = j + 1
            }
            break
        }
        i = i + 1
    }
    rt.buf_free(&b)
    return v
}

fn rss_kb() -> u64 {
    return status_kb("VmRSS")
}

fn peak_kb() -> u64 {
    return status_kb("VmHWM")
}
