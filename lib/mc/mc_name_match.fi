import std.rt

export { nm_is, nm_prefix, nm_suffix }

fn nm_is(p: u64, n: usize, lit: str) -> bool {
    return n == lit.n && rt.mem_eq(p, lit.p as u64, lit.n)
}

fn nm_prefix(p: u64, n: usize, lit: str) -> bool {
    return n > lit.n && rt.mem_eq(p, lit.p as u64, lit.n)
}

fn nm_suffix(p: u64, n: usize, lit: str) -> bool {
    return n > lit.n && rt.mem_eq(p + ((n - lit.n) as u64), lit.p as u64, lit.n)
}
