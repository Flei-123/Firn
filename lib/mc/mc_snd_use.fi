import std.rt
import mc.mc_audio
import mc.mc_registry
import mc.mc_world

export {
    SU_NONE, SU_EAT, SU_DRINK, SU_BUCKET_WATER, SU_BUCKET_LAVA, SU_BUCKET_EMPTY,
    su_item_kind, su_block_interact, su_use_cadence_hit, su_use_name, su_bucket_name, su_prewarm_names, su_prewarm,
    SndUse, su_new, su_frame, su_interact, su_bucket, su_use_tick, su_lava_roll, SU_EAT_PERIOD_MS, SU_EAT_FINISH_MS,
}

const SU_NONE: i32 = 0
const SU_EAT: i32 = 1
const SU_DRINK: i32 = 2
const SU_BUCKET_WATER: i32 = 3
const SU_BUCKET_LAVA: i32 = 4
const SU_BUCKET_EMPTY: i32 = 5
const SU_EAT_PERIOD_MS: u64 = 200 as u64
const SU_EAT_FINISH_MS: u64 = 1600 as u64

fn b8(s: str, i: usize) -> u8 {
    return rt.ld8(s.p as u64, i)
}

fn starts(s: str, pre: str) -> bool {
    let k: usize = pre.length()
    if k > s.length() { return false }
    var j: usize = 0
    while j < k {
        if b8(s, j) != b8(pre, j) { return false }
        j = j + 1
    }
    return true
}

fn ends(s: str, suf: str) -> bool {
    let k: usize = suf.length()
    let n: usize = s.length()
    if k > n { return false }
    var j: usize = 0
    while j < k {
        if b8(s, n - k + j) != b8(suf, j) { return false }
        j = j + 1
    }
    return true
}

fn is_food(n: str) -> bool {
    if starts(n, "cooked_") { return true }
    if ends(n, "_stew") || ends(n, "_soup") || ends(n, "_berries") { return true }
    if n == "apple" || n == "golden_apple" || n == "enchanted_golden_apple" || n == "baked_potato" || n == "potato" || n == "poisonous_potato" { return true }
    if n == "beef" || n == "chicken" || n == "porkchop" || n == "mutton" || n == "rabbit" || n == "cod" || n == "salmon" || n == "tropical_fish" || n == "pufferfish" { return true }
    if n == "bread" || n == "carrot" || n == "golden_carrot" || n == "beetroot" || n == "melon_slice" || n == "cookie" || n == "dried_kelp" || n == "pumpkin_pie" { return true }
    if n == "rotten_flesh" || n == "spider_eye" || n == "chorus_fruit" || n == "sweet_berries" || n == "glow_berries" { return true }
    return false
}

fn su_item_kind(n: str) -> i32 {
    if n == "water_bucket" { return SU_BUCKET_WATER }
    if n == "lava_bucket" { return SU_BUCKET_LAVA }
    if n == "bucket" { return SU_BUCKET_EMPTY }
    if n == "potion" || n == "milk_bucket" || n == "honey_bottle" { return SU_DRINK }
    if is_food(n) { return SU_EAT }
    return SU_NONE
}

fn su_use_name(kind: i32) -> str {
    if kind == SU_EAT { return "entity.generic.eat" }
    if kind == SU_DRINK { return "entity.generic.drink" }
    return ""
}

fn su_bucket_name(kind: i32, fill: bool) -> str {
    if kind == SU_BUCKET_WATER { return "item.bucket.empty" }
    if kind == SU_BUCKET_LAVA { return "item.bucket.empty_lava" }
    if kind == SU_BUCKET_EMPTY && fill { return "item.bucket.fill" }
    return ""
}

fn su_use_cadence_hit(elapsed_ms: u64, last_n: i64) -> bool {
    return ((elapsed_ms / SU_EAT_PERIOD_MS) as i64) > last_n
}

fn su_block_interact(n: str, open: bool) -> str {
    if ends(n, "_button") {
        if starts(n, "stone") || starts(n, "polished_blackstone") { return "block.stone_button.click_on" }
        return "block.wooden_button.click_on"
    }
    if n == "lever" { return "block.lever.click" }
    if ends(n, "_trapdoor") {
        if starts(n, "iron") { if open { return "block.iron_trapdoor.close" } return "block.iron_trapdoor.open" }
        if open { return "block.wooden_trapdoor.close" } return "block.wooden_trapdoor.open"
    }
    if ends(n, "_door") {
        if starts(n, "iron") { return "" }
        if open { return "block.wooden_door.close" } return "block.wooden_door.open"
    }
    if ends(n, "_fence_gate") {
        if open { return "block.fence_gate.close" } return "block.fence_gate.open"
    }
    return ""
}

fn su_lava_roll(r: u64) -> i32 {
    let k: u64 = r % 200 as u64
    if k == 0 as u64 { return 1 }
    if k < 3 as u64 { return 2 }
    return 0
}

fn su_prewarm_names() -> i32 { return 22 }

fn name_at(i: i32) -> str {
    if i == 0 { return "entity.generic.eat" }
    if i == 1 { return "entity.generic.drink" }
    if i == 2 { return "entity.player.burp" }
    if i == 3 { return "entity.player.splash" }
    if i == 4 { return "entity.player.splash.high_speed" }
    if i == 5 { return "entity.player.swim" }
    if i == 6 { return "entity.player.hurt" }
    if i == 7 { return "item.bucket.empty" }
    if i == 8 { return "item.bucket.empty_lava" }
    if i == 9 { return "item.bucket.fill" }
    if i == 10 { return "block.lava.pop" }
    if i == 11 { return "block.lava.ambient" }
    if i == 12 { return "ambient.underwater.enter" }
    if i == 13 { return "ambient.underwater.exit" }
    if i == 14 { return "ambient.underwater.loop.additions" }
    if i == 15 { return "block.fire.ambient" }
    if i == 16 { return "entity.arrow.shoot" }
    if i == 17 { return "entity.player.attack.strong" }
    if i == 18 { return "entity.player.attack.weak" }
    if i == 19 { return "entity.player.attack.sweep" }
    if i == 20 { return "entity.player.attack.crit" }
    if i == 21 { return "entity.player.attack.knockback" }
    return ""
}

fn su_prewarm(m: *mut mc_audio.McAudio) -> i32 {
    var k: i32 = 0
    var i: i32 = 0
    while i < su_prewarm_names() {
        if mc_audio.mca_prewarm(m, name_at(i)) { k = k + 1 }
        i = i + 1
    }
    var mat: i32 = 1
    while mat < mc_audio.MAT_COUNT {
        var act: i32 = 0
        while act < 4 {
            if mc_audio.mca_prewarm(m, mc_audio.mca_block_sound_name(m, mat, act)) { k = k + 1 }
            act = act + 1
        }
        mat = mat + 1
    }
    return k
}

fn su_use_tick(m: *mut mc_audio.McAudio, kind: i32, elapsed_ms: u64, last_n: *mut i64, x: f64, y: f64, z: f64) -> bool {
    let nm: str = su_use_name(kind)
    if nm.length() == 0 { return false }
    if !su_use_cadence_hit(elapsed_ms, *last_n) { return false }
    *last_n = (elapsed_ms / SU_EAT_PERIOD_MS) as i64
    var pitch: f32 = 0.9 as f32 + ((*last_n % 3) as f32) * 0.05 as f32
    if kind == SU_DRINK { pitch = 1.0 as f32 }
    return mc_audio.mca_play_at(m, nm, mc_audio.CAT_PLAYERS, x, y, z, 0.5 as f32, pitch) != 0 as u32
}

struct SndUse {
    using: bool,
    t0: u64,
    n: i64,
    burped: bool,
    under: bool,
    started: bool,
    rng: u64,
    lava_id: i32,
    n_played: u64,
}

fn su_new() -> SndUse {
    return SndUse { using: false, t0: 0 as u64, n: 0 - 1, burped: false, under: false, started: false, rng: 88172645463325252 as u64, lava_id: 0 - 2, n_played: 0 as u64 }
}

fn next_rng(s: *mut SndUse) -> u64 {
    var x: u64 = (*s).rng
    x = x ^ (x << 13 as u64)
    x = x ^ (x >> 7 as u64)
    x = x ^ (x << 17 as u64)
    (*s).rng = x
    return x
}

fn item_name(reg: *mut mc_registry.Registry, item: i32) -> str {
    if item < 0 { return "" }
    var n: usize = 0
    let p: u64 = mc_registry.reg_item_name(reg, item, &n)
    if p == 0 as u64 { return "" }
    return str { p: p as *mut u8, n: n }
}

fn count(s: *mut SndUse, ok: bool) {
    if ok { (*s).n_played = (*s).n_played + 1 as u64 }
}

fn lava_scan(m: *mut mc_audio.McAudio, s: *mut SndUse, reg: *mut mc_registry.Registry, world: *mut mc_world.World, min_y: i32, x: f64, y: f64, z: f64) {
    if (*s).lava_id == 0 - 2 {
        (*s).lava_id = mc_registry.reg_block_by_name(reg, "lava".p as u64, 4)
    }
    if (*s).lava_id < 0 { return }
    let r: u64 = next_rng(s)
    let roll: i32 = su_lava_roll(r)
    if roll == 0 { return }
    let bx: i32 = x as i32
    let by: i32 = y as i32
    let bz: i32 = z as i32
    var dx: i32 = 0 - 4
    while dx <= 4 {
        var dz: i32 = 0 - 4
        while dz <= 4 {
            var dy: i32 = 0 - 2
            while dy <= 2 {
                let st: i32 = mc_audio.mca_state_at(world, min_y, bx + dx, by + dy, bz + dz)
                if st >= 0 && mc_registry.reg_block_of_state(reg, st) == (*s).lava_id {
                    var nm: str = "block.lava.ambient"
                    var vol: f32 = 0.2 as f32
                    if roll == 2 {
                        nm = "block.lava.pop"
                        vol = 0.2 as f32
                    }
                    count(s, mc_audio.mca_play_at(m, nm, mc_audio.CAT_BLOCKS, (bx + dx) as f64 + 0.5, (by + dy) as f64 + 0.5, (bz + dz) as f64 + 0.5, vol, 1.0 as f32) != 0 as u32)
                    return
                }
                dy = dy + 1
            }
            dz = dz + 1
        }
        dx = dx + 1
    }
}

fn su_frame(m: *mut mc_audio.McAudio, s: *mut SndUse, reg: *mut mc_registry.Registry, world: *mut mc_world.World, min_y: i32, item: i32, using: bool, hungry: bool, under: bool,
    now_ms: u64, x: f64, y: f64, z: f64, lava: bool) {
    let kind: i32 = su_item_kind(item_name(reg, item))
    let eating: bool = using && (kind == SU_DRINK || (kind == SU_EAT && hungry))
    if eating && !(*s).using {
        (*s).t0 = now_ms
        (*s).n = 0 - 1
        (*s).burped = false
    }
    (*s).using = eating
    if eating {
        let el: u64 = now_ms - (*s).t0
        count(s, su_use_tick(m, kind, el, &(*s).n, x, y + 1.4, z))
        if kind == SU_EAT && !(*s).burped && el >= SU_EAT_FINISH_MS {
            (*s).burped = true
            count(s, mc_audio.mca_play_at(m, "entity.player.burp", mc_audio.CAT_PLAYERS, x, y + 1.4, z, 0.5 as f32, 1.0 as f32) != 0 as u32)
        }
    }
    if !(*s).started {
        (*s).started = true
        (*s).under = under
    } else if under != (*s).under {
        (*s).under = under
        var nm: str = "ambient.underwater.exit"
        if under { nm = "ambient.underwater.enter" }
        count(s, mc_audio.mca_play_at(m, nm, mc_audio.CAT_AMBIENT, x, y + 1.6, z, 1.0 as f32, 1.0 as f32) != 0 as u32)
    }
    if lava { lava_scan(m, s, reg, world, min_y, x, y, z) }
}

fn su_bucket(m: *mut mc_audio.McAudio, s: *mut SndUse, reg: *mut mc_registry.Registry, item: i32, x: f64, y: f64, z: f64) -> bool {
    let nm: str = su_bucket_name(su_item_kind(item_name(reg, item)), false)
    if nm.length() == 0 { return false }
    let ok: bool = mc_audio.mca_play_at(m, nm, mc_audio.CAT_BLOCKS, x, y, z, 1.0 as f32, 1.0 as f32) != 0 as u32
    count(s, ok)
    return ok
}

fn su_interact(m: *mut mc_audio.McAudio, s: *mut SndUse, reg: *mut mc_registry.Registry, state: i32, bx: i32, by: i32, bz: i32) -> bool {
    if state < 0 { return false }
    let b: i32 = mc_registry.reg_block_of_state(reg, state)
    if b < 0 { return false }
    var n: usize = 0
    let p: u64 = mc_registry.reg_block_name(reg, b, &n)
    if p == 0 as u64 { return false }
    var txt: rt.Buf = rt.buf_new()
    mc_registry.reg_state_text(reg, state, &txt)
    let t: str = rt.buf_str(&txt)
    let open: bool = has_text(t, "open=true")
    rt.buf_free(&txt)
    let nm: str = su_block_interact(str { p: p as *mut u8, n: n }, open)
    if nm.length() == 0 { return false }
    let ok: bool = mc_audio.mca_play_at(m, nm, mc_audio.CAT_BLOCKS, bx as f64 + 0.5, by as f64 + 0.5, bz as f64 + 0.5, 1.0 as f32, 1.0 as f32) != 0 as u32
    count(s, ok)
    return ok
}

fn has_text(t: str, needle: str) -> bool {
    let k: usize = needle.length()
    let n: usize = t.length()
    if k == 0 || k > n { return false }
    var i: usize = 0
    while i + k <= n {
        var j: usize = 0
        while j < k && b8(t, i + j) == b8(needle, j) { j = j + 1 }
        if j == k { return true }
        i = i + 1
    }
    return false
}
