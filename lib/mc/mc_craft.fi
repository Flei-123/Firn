// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_craft.fi -- crafting recipe matcher over the generated tables (tools/mcgen/gen_recipes.py -> lib/mc/vNNN/mc_rcp_vNNN.fi).
//
//   craft_open(blob)                         reader over the generated blob (check craft_ok)
//   craft_match(r, grid, gw, count_out)      result item id of the grid (-1 = no recipe) and its count. `grid` = u32 [gw * gw] (rt.st32), cell = item id + 1
//                                            (0 = empty), row by row; gw = 2 (inventory) or 3 (crafting table).
//
// Matching = vanilla ShapedRecipe / ShapelessRecipe: the used cells are cut to their bounding box; a shaped recipe needs the same size and the
// same cells, also mirrored left-right; a shapeless recipe needs the same multiset. The first recipe in table order wins.
// BLOB: see tools/mcgen/gen_recipes.py ("RCP1").

import std.rt

export { Recipes, craft_open, craft_ok, craft_count, craft_match }

struct Recipes {
    blob: u64,
    n: u32,
}

fn n14(blob: u64, at: usize) -> u32 {
    return ((rt.ld8(blob, at) as u32) << 7) | (rt.ld8(blob, at + 1) as u32)
}

fn craft_open(blob: u64) -> Recipes {
    var r: Recipes = Recipes { blob: blob, n: 0 as u32 }
    if blob == 0 || rt.ld8(blob, 0) != 82 as u8 || rt.ld8(blob, 1) != 67 as u8 || rt.ld8(blob, 2) != 80 as u8 || rt.ld8(blob, 3) != 49 as u8 {
        r.blob = 0
        return r
    }
    r.n = n14(blob, 4)
    return r
}

fn craft_ok(r: *mut Recipes) -> bool { return (*r).blob != 0 }
fn craft_count(r: *mut Recipes) -> i32 { if (*r).blob == 0 { return 0 } else { return (*r).n as i32 } }

fn cell(g: u64, gw: i32, x: i32, y: i32) -> i32 { return rt.ld32(g, (y * gw + x) as usize) as i32 }

// result item id of the grid (-1 = no recipe); *count_out = result count
fn craft_match(r: *mut Recipes, g: u64, gw: i32, count_out: *mut i32) -> i32 {
    *count_out = 0
    if (*r).blob == 0 || gw < 1 || gw > 3 { return 0 - 1 }
    var minx: i32 = gw
    var maxx: i32 = 0 - 1
    var miny: i32 = gw
    var maxy: i32 = 0 - 1
    var used: i32 = 0
    var y: i32 = 0
    while y < gw {
        var x: i32 = 0
        while x < gw {
            if cell(g, gw, x, y) != 0 {
                used = used + 1
                if x < minx { minx = x }
                if x > maxx { maxx = x }
                if y < miny { miny = y }
                if y > maxy { maxy = y }
            }
            x = x + 1
        }
        y = y + 1
    }
    if used == 0 { return 0 - 1 }
    let bw: i32 = maxx - minx + 1
    let bh: i32 = maxy - miny + 1
    let blob: u64 = (*r).blob
    var at: usize = 6
    var i: u32 = 0 as u32
    while i < (*r).n {
        let kind: u8 = rt.ld8(blob, at)
        let a: i32 = rt.ld8(blob, at + 1) as i32
        let b: i32 = rt.ld8(blob, at + 2) as i32
        let res: i32 = n14(blob, at + 3) as i32
        let cnt: i32 = rt.ld8(blob, at + 5) as i32
        let cells_at: usize = at + 6
        var ncell: i32 = a
        if kind == 1 as u8 { ncell = a * b }
        if kind == 1 as u8 && a == bw && b == bh {
            var okf: bool = true
            var okm: bool = true
            var yy: i32 = 0
            while yy < bh && (okf || okm) {
                var xx: i32 = 0
                while xx < bw {
                    let want: i32 = n14(blob, cells_at + ((yy * bw + xx) * 2) as usize) as i32 // item id + 1
                    if cell(g, gw, minx + xx, miny + yy) != want { okf = false }
                    if cell(g, gw, minx + (bw - 1 - xx), miny + yy) != want { okm = false }
                    xx = xx + 1
                }
                yy = yy + 1
            }
            if okf || okm {
                *count_out = cnt
                return res
            }
        } else if kind == 2 as u8 && a == used {
            // multiset compare: every ingredient takes one equal unused cell
            var usedmask: i32 = 0
            var okl: bool = true
            var k: i32 = 0
            while k < a && okl {
                let want2: i32 = n14(blob, cells_at + (k * 2) as usize) as i32
                var found: bool = false
                var c: i32 = 0
                while c < gw * gw && !found {
                    if (usedmask & (1 << c)) == 0 && (rt.ld32(g, c as usize) as i32) == want2 {
                        usedmask = usedmask | (1 << c)
                        found = true
                    }
                    c = c + 1
                }
                if !found { okl = false }
                k = k + 1
            }
            if okl {
                *count_out = cnt
                return res
            }
        }
        at = cells_at + (ncell * 2) as usize
        i = i + 1 as u32
    }
    return 0 - 1
}
