// SPDX-License-Identifier: MPL-2.0
// lib/mc/save/save_patch.fi -- rewrites a chunk NBT with the edited sections replaced by block states built from global state ids.

import std.rt
import std.bytes
import std.nbt
import mc.mc_nbt
import mc.mc_registry
import mc.save.save_chunk

export { patch_chunk, PatchHooks, SEC_LO, SEC_HI }

const SEC_LO: i32 = 0 - 8
const SEC_HI: i32 = 27
const MIN_Y: i32 = 0 - 64
const CELLS: usize = 4096
const NONE: u16 = 65535
const PREFIX: str = "minecraft:"

struct PatchHooks {
    ctx: u64,
    edited: fn(u64, i32, i32, i32) -> bool,
}

struct PatchState {
    reg: *mut mc_registry.Registry,
    blocks: u64,
    mask: u64,
    hooks: PatchHooks,
    pos: u64,
    idx: u64,
    text: rt.Buf,
}

fn name_is(d: *mut mc_nbt.Doc, n: u32, want: str) -> bool {
    var l: usize = 0
    let p: u64 = mc_nbt.nbt_name(d, n, &l)
    return l == want.n && rt.mem_eq(p, want.p as u64, l)
}

fn copy_entry(d: *mut mc_nbt.Doc, n: u32, out: *mut bytes.Bytes) {
    var l: usize = 0
    let p: u64 = mc_nbt.nbt_name(d, n, &l)
    bytes.put_u8(out, mc_nbt.nbt_kind(d, n))
    nbt.nbt_name(out, p, l)
    mc_nbt.doc_write_node(d, n, out)
}

fn write_properties(st: *mut PatchState, out: *mut bytes.Bytes, from: usize) {
    let p: u64 = (*st).text.ptr
    let n: usize = (*st).text.len
    nbt.nbt_compound_begin(out, "Properties".p as u64, 10)
    var at: usize = from
    while at < n && rt.ld8(p, at) != 93 as u8 {
        let ks: usize = at
        while at < n && rt.ld8(p, at) != 61 as u8 { at = at + 1 }
        let ke: usize = at
        at = at + 1
        let vs: usize = at
        while at < n && rt.ld8(p, at) != 44 as u8 && rt.ld8(p, at) != 93 as u8 { at = at + 1 }
        nbt.nbt_string(out, p + ks as u64, ke - ks, p + vs as u64, at - vs)
        if at < n && rt.ld8(p, at) == 44 as u8 { at = at + 1 }
    }
    nbt.nbt_end(out)
}

fn write_palette_entry(st: *mut PatchState, state: i32, out: *mut bytes.Bytes) {
    rt.buf_clear(&(*st).text)
    rt.buf_push_bytes(&(*st).text, PREFIX.p as u64, PREFIX.n)
    let ok: bool = mc_registry.reg_state_text((*st).reg, state, &(*st).text)
    var e: usize = PREFIX.n
    while e < (*st).text.len && rt.ld8((*st).text.ptr, e) != 91 as u8 { e = e + 1 }
    if !ok {
        rt.buf_clear(&(*st).text)
        rt.buf_push_bytes(&(*st).text, "minecraft:air".p as u64, 13)
        e = 13
    }
    nbt.nbt_string(out, "Name".p as u64, 4, (*st).text.ptr, e)
    if e < (*st).text.len { write_properties(st, out, e + 1) }
    nbt.nbt_end(out)
}

fn write_section_blocks(st: *mut PatchState, sy: i32, out: *mut bytes.Bytes) {
    let base: usize = ((sy * 16 - MIN_Y) as usize) * 256
    rt.mem_set((*st).pos, 255 as u8, 65536 * 2)
    var states: [u16; 4096] = [0; 4096]
    var np: usize = 0
    var j: usize = 0
    while j < CELLS {
        let v: u16 = rt.ld16((*st).blocks, base + j)
        var k: u16 = rt.ld16((*st).pos, v as usize)
        if k == NONE {
            k = np as u16
            rt.st16((*st).pos, v as usize, k)
            states[np] = v
            np = np + 1
        }
        rt.st16((*st).idx, j, k)
        j = j + 1
    }
    nbt.nbt_compound_begin(out, "block_states".p as u64, 12)
    nbt.nbt_list_open(out, "palette".p as u64, 7, 10 as u8, np as i32)
    var i: usize = 0
    while i < np {
        write_palette_entry(st, states[i] as i32, out)
        i = i + 1
    }
    save_chunk.write_palette_data(out, (*st).idx, CELLS, np, 4, "data")
    nbt.nbt_end(out)
}

fn write_plains(out: *mut bytes.Bytes) {
    save_chunk.write_biomes(out, "minecraft:plains", 1, 0)
}

fn section_masked(st: *mut PatchState, sy: i32) -> bool {
    return ((*st).mask >> ((sy - SEC_LO) as u64)) & 1 as u64 != 0 as u64
}

fn skip_in_patched(d: *mut mc_nbt.Doc, n: u32) -> bool {
    return name_is(d, n, "block_states") || name_is(d, n, "SkyLight") || name_is(d, n, "BlockLight")
}

fn write_existing_section(d: *mut mc_nbt.Doc, st: *mut PatchState, sec: u32, sy: i32, out: *mut bytes.Bytes) {
    let patch: bool = section_masked(st, sy)
    var has_biomes: bool = false
    var c: u32 = mc_nbt.nbt_first(d, sec)
    while c != 0 as u32 {
        if name_is(d, c, "biomes") { has_biomes = true }
        if !(patch && skip_in_patched(d, c)) { copy_entry(d, c, out) }
        c = mc_nbt.nbt_next(d, c)
    }
    if patch {
        write_section_blocks(st, sy, out)
        if !has_biomes { write_plains(out) }
    }
    nbt.nbt_end(out)
}

fn write_new_section(st: *mut PatchState, sy: i32, out: *mut bytes.Bytes) {
    nbt.nbt_byte(out, "Y".p as u64, 1, sy as i8)
    write_section_blocks(st, sy, out)
    write_plains(out)
    nbt.nbt_end(out)
}

fn find_section(c: *mut save_chunk.Chunk, sy: i32) -> u32 {
    let ns: u32 = save_chunk.chunk_section_count(c)
    var i: u32 = 0
    while i < ns {
        let sec: u32 = save_chunk.chunk_section(c, i)
        if save_chunk.chunk_section_y(c, sec) == sy { return sec }
        i = i + 1
    }
    return 0 as u32
}

fn write_sections(c: *mut save_chunk.Chunk, st: *mut PatchState, out: *mut bytes.Bytes) {
    var count: i32 = 0
    var y: i32 = SEC_LO
    while y <= SEC_HI {
        if find_section(c, y) != 0 as u32 || section_masked(st, y) { count = count + 1 }
        y = y + 1
    }
    nbt.nbt_list_open(out, "sections".p as u64, 8, 10 as u8, count)
    y = SEC_LO
    while y <= SEC_HI {
        let sec: u32 = find_section(c, y)
        if sec != 0 as u32 {
            write_existing_section(&(*c).doc, st, sec, y, out)
        } else if section_masked(st, y) {
            write_new_section(st, y, out)
        }
        y = y + 1
    }
}

fn coord(d: *mut mc_nbt.Doc, n: u32, name: str) -> i32 {
    return mc_nbt.nbt_i64(d, mc_nbt.nbt_get(d, n, name.p as u64, name.n)) as i32
}

fn entity_kept(d: *mut mc_nbt.Doc, st: *mut PatchState, n: u32) -> bool {
    return !(*st).hooks.edited((*st).hooks.ctx, coord(d, n, "x"), coord(d, n, "y"), coord(d, n, "z"))
}

fn write_block_entities(d: *mut mc_nbt.Doc, st: *mut PatchState, list: u32, out: *mut bytes.Bytes) {
    var kept: i32 = 0
    var c: u32 = mc_nbt.nbt_first(d, list)
    while c != 0 as u32 {
        if entity_kept(d, st, c) { kept = kept + 1 }
        c = mc_nbt.nbt_next(d, c)
    }
    var elem: u8 = 10 as u8
    if kept == 0 { elem = 0 as u8 }
    nbt.nbt_list_open(out, "block_entities".p as u64, 14, elem, kept)
    c = mc_nbt.nbt_first(d, list)
    while c != 0 as u32 {
        if entity_kept(d, st, c) { mc_nbt.doc_write_node(d, c, out) }
        c = mc_nbt.nbt_next(d, c)
    }
}

fn patch_chunk(c: *mut save_chunk.Chunk, reg: *mut mc_registry.Registry, blocks: u64, mask: u64, hooks: PatchHooks, out: *mut bytes.Bytes) -> bool {
    if (*c).legacy { return false }
    var st: PatchState = PatchState { reg: reg, blocks: blocks, mask: mask, hooks: hooks, pos: rt.heap_alloc(65536 * 2),
        idx: rt.heap_alloc(CELLS * 2), text: rt.buf_new() }
    let d: *mut mc_nbt.Doc = &(*c).doc
    nbt.nbt_root_begin(out, "".p as u64, 0)
    var n: u32 = mc_nbt.nbt_first(d, (*c).level)
    while n != 0 as u32 {
        if name_is(d, n, "sections") {
        } else if name_is(d, n, "Heightmaps") || name_is(d, n, "isLightOn") {
        } else if name_is(d, n, "block_entities") {
            write_block_entities(d, &st, n, out)
        } else {
            copy_entry(d, n, out)
        }
        n = mc_nbt.nbt_next(d, n)
    }
    write_sections(c, &st, out)
    nbt.nbt_byte(out, "isLightOn".p as u64, 9, 0 as i8)
    nbt.nbt_end(out)
    rt.heap_free(st.pos, 65536 * 2)
    rt.heap_free(st.idx, CELLS * 2)
    rt.buf_free(&st.text)
    return true
}
