// SPDX-License-Identifier: MPL-2.0
// lib/mc/save/save_bits.fi -- the packed value arrays of chunk NBT (vanilla BitStorage).
// Since 1.16 (DataVersion 2529) values never cross a long: 64 / bits values per long, the rest of
// the long stays 0. Older worlds pack across long borders (spanning). Longs are big endian octets.
import std.rt

export {
    bits_for_palette, bits_values_per_long, bits_long_count,
    bits_unpack, bits_unpack_spanning, bits_pack,
}

fn bits_for_palette(n: usize) -> usize {
    var b: usize = 0
    while ((1 as usize) << b) < n {
        b = b + 1
    }
    return b
}

fn bits_values_per_long(bits: usize) -> usize {
    return 64 / bits
}

fn bits_long_count(count: usize, bits: usize) -> usize {
    let vpl: usize = 64 / bits
    return (count + vpl - 1) / vpl
}

fn ld64be(p: u64, i: usize) -> u64 {
    var v: u64 = 0
    var k: usize = 0
    while k < 8 {
        v = (v << 8 as u64) | (rt.ld8(p, i * 8 + k) as u64)
        k = k + 1
    }
    return v
}

fn push64be(out: *mut rt.Buf, v: u64) {
    var k: usize = 0
    while k < 8 {
        rt.buf_push(out, ((v >> ((56 - k * 8) as u64)) & 255 as u64) as u8)
        k = k + 1
    }
}

fn bits_unpack(src: u64, nlongs: usize, bits: usize, count: usize, out: u64) -> bool {
    if bits < 1 || bits > 32 || nlongs != bits_long_count(count, bits) {
        return false
    }
    let vpl: usize = 64 / bits
    let mask: u64 = (((1 as u64) << (bits as u64)) - 1 as u64)
    var cur: u64 = 0
    var i: usize = 0
    while i < count {
        if i % vpl == 0 {
            cur = ld64be(src, i / vpl)
        }
        rt.st16(out, i, ((cur >> (((i % vpl) * bits) as u64)) & mask) as u16)
        i = i + 1
    }
    return true
}

fn bits_unpack_spanning(src: u64, nlongs: usize, bits: usize, count: usize, out: u64) -> bool {
    if bits < 1 || bits > 32 || nlongs != (count * bits + 63) / 64 {
        return false
    }
    let mask: u64 = (((1 as u64) << (bits as u64)) - 1 as u64)
    var i: usize = 0
    while i < count {
        let at: usize = i * bits
        let w: usize = at / 64
        let sh: usize = at % 64
        var v: u64 = ld64be(src, w) >> (sh as u64)
        if sh + bits > 64 {
            v = v | (ld64be(src, w + 1) << ((64 - sh) as u64))
        }
        rt.st16(out, i, (v & mask) as u16)
        i = i + 1
    }
    return true
}

fn bits_pack(idx: u64, count: usize, bits: usize, out: *mut rt.Buf) -> usize {
    let vpl: usize = 64 / bits
    let n: usize = bits_long_count(count, bits)
    var li: usize = 0
    while li < n {
        var word: u64 = 0
        var k: usize = 0
        while k < vpl && li * vpl + k < count {
            word = word | ((rt.ld16(idx, li * vpl + k) as u64) << ((k * bits) as u64))
            k = k + 1
        }
        push64be(out, word)
        li = li + 1
    }
    return n
}
