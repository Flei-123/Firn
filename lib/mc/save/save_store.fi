// lib/mc/save/save_store.fi -- puts one chunk into a region: inline when it fits, otherwise as an external .mcc file.

import std.rt
import mc.mc_anvil
import mc.save.save_world

export { store_put_chunk }

fn store_put_chunk(dirpath: str, rx: i32, rz: i32, r: *mut mc_anvil.Region, lx: i32, lz: i32, data: u64, n: usize, ctype: u8, stamp: u32) -> bool {
    let w: bool = mc_anvil.region_write(r, lx, lz, data, n, ctype, stamp) catch false
    if w { return true }
    var packed: rt.Buf = rt.buf_new()
    let m: usize = mc_anvil.anvil_pack(ctype, data, n, &packed) catch 99999999999
    var mcc: rt.Buf = rt.buf_new()
    save_world.mcc_name(dirpath, rx * 32 + lx, rz * 32 + lz, &mcc)
    var good: bool = m != 99999999999 && rt.write_file(mcc.ptr, packed.ptr, m)
    if good {
        good = mc_anvil.region_mark_external(r, lx, lz, ctype, stamp) catch false
    }
    rt.buf_free(&mcc)
    rt.buf_free(&packed)
    return good
}
