import mc.mc_entity_draw

export { POSE_STAND, POSE_SNEAK, POSE_PRONE, pose_of, self_add }

const POSE_STAND: i32 = 0
const POSE_SNEAK: i32 = 1
const POSE_PRONE: i32 = 2

const SKIN_R: i32 = 200
const SKIN_G: i32 = 150
const SKIN_B: i32 = 110

fn pose_of(swimming: bool, low_pose: bool, crouched: bool, sneaking: bool) -> i32 {
    if swimming || low_pose { return POSE_PRONE }
    if sneaking || crouched { return POSE_SNEAK }
    return POSE_STAND
}

fn skin(l: *mut mc_entity_draw.EntList, x: f64, y: f64, z: f64, yaw: f64, dx: f64, dy: f64, dz: f64, sx: f64, sy: f64, sz: f64) {
    mc_entity_draw.entlist_add_part(l, x, y, z, yaw, dx, dy, dz, sx, sy, sz, SKIN_R, SKIN_G, SKIN_B)
}

fn shirt(l: *mut mc_entity_draw.EntList, x: f64, y: f64, z: f64, yaw: f64, dx: f64, dy: f64, dz: f64, sx: f64, sy: f64, sz: f64) {
    mc_entity_draw.entlist_add_part(l, x, y, z, yaw, dx, dy, dz, sx, sy, sz, 0, 165, 165)
}

fn pants(l: *mut mc_entity_draw.EntList, x: f64, y: f64, z: f64, yaw: f64, dx: f64, dy: f64, dz: f64, sx: f64, sy: f64, sz: f64) {
    mc_entity_draw.entlist_add_part(l, x, y, z, yaw, dx, dy, dz, sx, sy, sz, 60, 60, 150)
}

fn stand(l: *mut mc_entity_draw.EntList, x: f64, y: f64, z: f64, yaw: f64) {
    pants(l, x, y, z, yaw, 0.0 - 0.125, 0.375, 0.0, 0.25, 0.75, 0.25)
    pants(l, x, y, z, yaw, 0.125, 0.375, 0.0, 0.25, 0.75, 0.25)
    shirt(l, x, y, z, yaw, 0.0, 1.125, 0.0, 0.5, 0.75, 0.25)
    skin(l, x, y, z, yaw, 0.0 - 0.375, 1.125, 0.0, 0.25, 0.75, 0.25)
    skin(l, x, y, z, yaw, 0.375, 1.125, 0.0, 0.25, 0.75, 0.25)
    skin(l, x, y, z, yaw, 0.0, 1.75, 0.0, 0.5, 0.5, 0.5)
}

fn sneak(l: *mut mc_entity_draw.EntList, x: f64, y: f64, z: f64, yaw: f64) {
    pants(l, x, y, z, yaw, 0.0 - 0.125, 0.3, 0.0 - 0.05, 0.25, 0.6, 0.25)
    pants(l, x, y, z, yaw, 0.125, 0.3, 0.0 - 0.05, 0.25, 0.6, 0.25)
    shirt(l, x, y, z, yaw, 0.0, 0.85, 0.1, 0.5, 0.75, 0.25)
    skin(l, x, y, z, yaw, 0.0 - 0.375, 0.85, 0.1, 0.25, 0.75, 0.25)
    skin(l, x, y, z, yaw, 0.375, 0.85, 0.1, 0.25, 0.75, 0.25)
    skin(l, x, y, z, yaw, 0.0, 1.25, 0.2, 0.5, 0.5, 0.5)
}

fn prone(l: *mut mc_entity_draw.EntList, x: f64, y: f64, z: f64, yaw: f64) {
    pants(l, x, y, z, yaw, 0.0 - 0.125, 0.125, 0.0 - 0.75, 0.25, 0.25, 0.75)
    pants(l, x, y, z, yaw, 0.125, 0.125, 0.0 - 0.75, 0.25, 0.25, 0.75)
    shirt(l, x, y, z, yaw, 0.0, 0.125, 0.0, 0.5, 0.25, 0.75)
    skin(l, x, y, z, yaw, 0.0 - 0.375, 0.125, 0.0, 0.25, 0.25, 0.75)
    skin(l, x, y, z, yaw, 0.375, 0.125, 0.0, 0.25, 0.25, 0.75)
    skin(l, x, y, z, yaw, 0.0, 0.25, 0.625, 0.5, 0.5, 0.5)
}

fn self_add(l: *mut mc_entity_draw.EntList, x: f64, y: f64, z: f64, yaw: f64, pose: i32) {
    if pose == POSE_PRONE {
        prone(l, x, y, z, yaw)
    } else if pose == POSE_SNEAK {
        sneak(l, x, y, z, yaw)
    } else {
        stand(l, x, y, z, yaw)
    }
}
