// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_lod_tint.fi -- biome tint for LOD columns by tile twins (docs/mc/lod.md "LOD tint").
import std.rt
import mc.mc_texture

export {
    CLS_NONE, CLS_GRASS, CLS_FOLIAGE, CLS_BIRCH, CLS_SPRUCE, PAL_N, MAP_IDS, TWIN_BASE_OFF, TWIN_ENTRIES,
    twin_clear, twin_class_of_name, twin_mark, twin_assign, twin_tile, twin_class, twins_fill, pal_nearest, map_build, resolve_tile,
}

const CLS_NONE: u32 = 0
const CLS_GRASS: u32 = 1
const CLS_FOLIAGE: u32 = 2
const CLS_BIRCH: u32 = 3
const CLS_SPRUCE: u32 = 4
const PAL_N: usize = 8
const MAP_IDS: usize = 1024
const MAX_TILE: usize = 16384
const TWIN_BASE_OFF: usize = 32768 * 6
const TWIN_CLS_OFF: usize = TWIN_BASE_OFF + MAX_TILE
const TWIN_ENTRIES: usize = TWIN_CLS_OFF + MAX_TILE
const BIRCH_RGB: u32 = 0x80A755
const SPRUCE_RGB: u32 = 0x619961
const VALID_BIT: u32 = 0x1000000

fn pal_rgb(cls: u32, k: usize) -> u32 {
    if cls == CLS_GRASS {
        let g: [u32; 8] = [0x597536 as u32, 0x5BC83D as u32, 0x80B497 as u32, 0x79C05A as u32, 0x91BD59 as u32, 0x8BBA68 as u32, 0x90814D as u32, 0xBEB955 as u32]
        return g[k]
    }
    if cls == CLS_FOLIAGE {
        let f: [u32; 8] = [0x33BA0D as u32, 0x5D9C32 as u32, 0x60A17A as u32, 0x68A462 as u32, 0x77AB2F as u32, 0x6FA74A as u32, 0x9E814D as u32, 0xAEA42A as u32]
        return f[k]
    }
    if cls == CLS_BIRCH { return BIRCH_RGB }
    return SPRUCE_RGB
}

fn pal_count(cls: u32) -> usize {
    if cls == CLS_GRASS || cls == CLS_FOLIAGE { return PAL_N }
    return 1
}

fn twin_clear(tiles: u64) {
    var i: usize = 0
    while i < MAX_TILE * 2 {
        rt.st16(tiles, TWIN_BASE_OFF + i, 0 as u16)
        i = i + 1
    }
}

fn name_has_suffix(p: u64, n: usize, s: str) -> bool {
    let sl: usize = s.n
    if n < sl { return false }
    return rt.mem_eq(p + ((n - sl) as u64), s.p as u64, sl)
}

fn name_has_prefix(p: u64, n: usize, s: str) -> bool {
    let sl: usize = s.n
    if n < sl { return false }
    return rt.mem_eq(p, s.p as u64, sl)
}

fn twin_class_of_name(p: u64, n: usize) -> u32 {
    if n == 11 && rt.mem_eq(p, "grass_block".p as u64, 11) { return CLS_GRASS }
    if !name_has_suffix(p, n, "_leaves") { return CLS_NONE }
    if name_has_prefix(p, n, "birch_") { return CLS_BIRCH }
    if name_has_prefix(p, n, "spruce_") { return CLS_SPRUCE }
    if name_has_prefix(p, n, "oak_") || name_has_prefix(p, n, "jungle_") || name_has_prefix(p, n, "acacia_") ||
    name_has_prefix(p, n, "dark_oak_") || name_has_prefix(p, n, "mangrove_") {
        return CLS_FOLIAGE
    }
    return CLS_NONE
}

fn twin_mark(tiles: u64, tile: u32, cls: u32) {
    if tile == 0 as u32 || (tile as usize) >= MAX_TILE { return }
    if rt.ld16(tiles, TWIN_CLS_OFF + (tile as usize)) == 0 as u16 {
        rt.st16(tiles, TWIN_CLS_OFF + (tile as usize), cls as u16)
    }
}

fn twin_assign(tiles: u64, first: u32) -> usize {
    var used: usize = 0
    var t: usize = 1
    while t < MAX_TILE {
        let cls: u32 = rt.ld16(tiles, TWIN_CLS_OFF + t) as u32
        if cls != CLS_NONE {
            let base: usize = (first as usize) + used
            if base + pal_count(cls) < MAX_TILE {
                rt.st16(tiles, TWIN_BASE_OFF + t, base as u16)
                used = used + pal_count(cls)
            }
        }
        t = t + 1
    }
    return used
}

fn twin_class(tiles: u64, tile: u32) -> u32 {
    if (tile as usize) >= MAX_TILE { return CLS_NONE }
    if rt.ld16(tiles, TWIN_BASE_OFF + (tile as usize)) == 0 as u16 { return CLS_NONE }
    return rt.ld16(tiles, TWIN_CLS_OFF + (tile as usize)) as u32
}

fn twin_tile(tiles: u64, tile: u32, k: usize) -> u32 {
    if (tile as usize) >= MAX_TILE { return tile }
    let base: u32 = rt.ld16(tiles, TWIN_BASE_OFF + (tile as usize)) as u32
    if base == 0 as u32 { return tile }
    let cls: u32 = rt.ld16(tiles, TWIN_CLS_OFF + (tile as usize)) as u32
    var kk: usize = 0
    if pal_count(cls) > 1 && k < PAL_N { kk = k }
    return base + (kk as u32)
}

fn tint_texel(px: u32, rgb: u32) -> u32 {
    let r: u32 = (px >> 0 as u32) & 255 as u32
    let g: u32 = (px >> 8 as u32) & 255 as u32
    let b: u32 = (px >> 16 as u32) & 255 as u32
    let a: u32 = px >> 24 as u32
    let tr: u32 = (r * (((rgb >> 16 as u32) & 255 as u32) + 1 as u32)) >> 8 as u32
    let tg: u32 = (g * (((rgb >> 8 as u32) & 255 as u32) + 1 as u32)) >> 8 as u32
    let tb: u32 = (b * ((rgb & 255 as u32) + 1 as u32)) >> 8 as u32
    return mc_texture.pack_pixel(tr, tg, tb, a)
}

fn twins_fill(a: *mut mc_texture.Atlas, tiles: u64, last_src: u32) {
    var t: u32 = 1 as u32
    while t <= last_src {
        let cls: u32 = twin_class(tiles, t)
        if cls != CLS_NONE {
            var k: usize = 0
            while k < pal_count(cls) {
                let dst: u32 = twin_tile(tiles, t, k)
                let rgb: u32 = pal_rgb(cls, k)
                var y: i32 = 0
                while y < (*a).tile {
                    var x: i32 = 0
                    while x < (*a).tile {
                        let px: u32 = mc_texture.atlas_texel(a, t, x, y)
                        let x0: i32 = mc_texture.atlas_tile_x(a, dst)
                        let y0: i32 = mc_texture.atlas_tile_y(a, dst)
                        if x0 >= 0 && dst != t {
                            rt.st32((*a).px, ((y0 + y) * (*a).w + x0 + x) as usize, tint_texel(px, rgb))
                        }
                        x = x + 1
                    }
                    y = y + 1
                }
                k = k + 1
            }
        }
        t = t + 1 as u32
    }
}

fn dist2(a: u32, b: u32) -> u32 {
    let dr: i32 = (((a >> 16 as u32) & 255 as u32) as i32) - (((b >> 16 as u32) & 255 as u32) as i32)
    let dg: i32 = (((a >> 8 as u32) & 255 as u32) as i32) - (((b >> 8 as u32) & 255 as u32) as i32)
    let db: i32 = ((a & 255 as u32) as i32) - ((b & 255 as u32) as i32)
    return (dr * dr + dg * dg + db * db) as u32
}

fn pal_nearest(cls: u32, rgb: u32) -> usize {
    var best: usize = 0
    var bd: u32 = 0xFFFFFFFF as u32
    var k: usize = 0
    while k < pal_count(cls) {
        let d: u32 = dist2(pal_rgb(cls, k), rgb)
        if d < bd {
            bd = d
            best = k
        }
        k = k + 1
    }
    return best
}

fn map_build(btab: u64, out: u64) {
    var c: usize = 0
    while c < 2 {
        var cls: u32 = CLS_GRASS
        var dflt: u32 = 0x91BD59 as u32
        if c == 1 {
            cls = CLS_FOLIAGE
            dflt = 0x77AB2F as u32
        }
        var id: usize = 0
        while id < MAP_IDS {
            var col: u32 = dflt
            if btab != 0 {
                let e: u32 = rt.ld32(btab, c * MAP_IDS + id)
                if (e & VALID_BIT) != 0 as u32 { col = e & 0xFFFFFF as u32 }
            }
            rt.st8(out, c * MAP_IDS + id, pal_nearest(cls, col) as u8)
            id = id + 1
        }
        c = c + 1
    }
}

fn resolve_tile(tiles: u64, map: u64, tile: u32, bid: u16) -> u32 {
    if map == 0 { return tile }
    let cls: u32 = twin_class(tiles, tile)
    if cls == CLS_NONE { return tile }
    var k: usize = 0
    if cls == CLS_GRASS || cls == CLS_FOLIAGE {
        var id: usize = bid as usize
        if id >= MAP_IDS { id = 0 }
        k = rt.ld8(map, ((cls - 1 as u32) as usize) * MAP_IDS + id) as usize
    }
    return twin_tile(tiles, tile, k)
}
