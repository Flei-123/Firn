// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_schema.fi -- the runtime walker for the generated packet schemas.
//
// lib/mc/vNNN/mc_proto_vNNN.fi (GENERATED by tools/mcgen/gen_protocol.py) holds,
// for every packet of a Minecraft version, a small bytecode program that describes
// the layout of the packet BODY (the octets behind the packet id). This file
// interprets such a program over a received buffer. It does three things:
//
//   walk(schema, b, out)        does the buffer follow the schema, to the last
//                               octet? Optionally dumps `path=value` lines.
//   walk_prefix(schema, b, out) the same, but leftover octets are allowed;
//                               the read cursor stands behind the packet.
//   field_range(schema, name, b, off, len)
//                               where in the buffer does the TOP LEVEL field
//                               `name` lie (the payload of a buffer/string).
//
// ------------------------------------------------------------ WHAT IT GUARANTEES
//
// The buffer comes from a peer. The walker therefore
//   * never reads outside [pos, len): every read first checks what is left;
//   * never trusts a count: an array needs at least `minsz` octets per element
//     (computed by the generator), so `count <= remaining / minsz`; elements that
//     may be empty (minsz = 0, e.g. an array of void) are capped at MAX_EMPTY;
//   * has an operation budget that grows with the buffer, so even a hostile
//     zero-width loop ends;
//   * limits the nesting of NBT (MAX_NBT_DEPTH) and of schema calls (the schema
//     graph is acyclic, the generator refuses recursive types);
//   * allocates nothing and writes nothing outside `out` (it appends to the Buf
//     that the caller hands over). Its own state lives on the stack.
// It returns true only if the buffer was consumed EXACTLY (`walk`).
//
// The schema program itself is TRUSTED: it is generated code. A wrong handle is a
// programming error, not an attack, and is not checked.
//
// ------------------------------------------------------------------ HONEST LIMITS
//
// S1  Values of fields are only kept where a later `switch` / array count needs
//     them (the generator assigns REGISTERS). A string compared by a switch is
//     reduced to its 64 bit FNV-1a hash; a hash collision could pick the wrong
//     branch of a layout, never read outside the buffer.
// S2  `topBitSetTerminatedArray`: the walker looks at bit 7 of the FIRST octet of
//     an element and then walks the element normally. The real decoder clears the
//     bit before decoding; that only matters if the first field of the element
//     were something whose size depends on it. In 1.20.1 it is an i8.
// S3  NBT is skipped and structurally checked (tag ids, lengths, depth), not
//     decoded. The plain `nbt` type follows protodef exactly: type octet, u16 name
//     length + name, payload, EVEN for the type octet 0 (a vanilla server never
//     sends that; protodef would read a name too).
// S4  Floats are printed as raw bits (hex): this is a structure dump, not a
//     value printer.
// S5  `field_range`/`walk` need the program to be valid for the packet's
//     direction and state; the walker cannot know that.
//
// ----------------------------------------------------------------- BYTECODE
//
// The format is documented at the top of tools/mcgen/gen_protocol.py (the
// generator and this file hold the same opcode table; the generated module
// carries SCHEMA_FORMAT, and `format_ok(f)` here compares it).

import std.rt
import std.bytes

// ---- opcode table (must match tools/mcgen/gen_protocol.py)
const O_FIELD: u64 = 1
const O_SCALAR: u64 = 2
const O_VOID: u64 = 3
const O_CONTAINER: u64 = 4
const O_BITFIELD: u64 = 5
const O_BITFLAGS: u64 = 6
const O_STRING: u64 = 7
const O_BUFFER: u64 = 8
const O_RESTBUF: u64 = 9
const O_ARRAY: u64 = 10
const O_OPTION: u64 = 11
const O_SWITCH: u64 = 12
const O_CALL: u64 = 13
const O_TOPBIT: u64 = 14
const O_EMETA: u64 = 15
const O_NBT: u64 = 16
const O_REGHOLDER: u64 = 17
const O_REGSET: u64 = 18
const O_LPVEC3: u64 = 19
const O_RCALL: u64 = 20

// scalar kinds
const K_U8: u64 = 0
const K_I8: u64 = 1
const K_U16: u64 = 2
const K_I16: u64 = 3
const K_U32: u64 = 4
const K_I32: u64 = 5
const K_U64: u64 = 6
const K_I64: u64 = 7
const K_F32: u64 = 8
const K_F64: u64 = 9
const K_BOOL: u64 = 10
const K_VARINT: u64 = 11
const K_VARLONG: u64 = 12
const K_UUID: u64 = 13

const CK_CONST: u64 = 32
const CK_REG: u64 = 33

const SCHEMA_FORMAT: i32 = 2

// ---- limits
const MAX_EMPTY: u64 = 65536 // elements count for arrays whose elements may be empty
const MAX_NBT_DEPTH: u64 = 512 // the vanilla client allows 512 as well
const MAX_STR_DUMP: usize = 160 // octets of a string shown in a dump line
const PATH_MAX: usize = 1024
const REGS: usize = 128
const MAX_CALL_DEPTH: u64 = 64

struct W {
    data: u64, // address of the packet body
    len: usize, // its length
    pos: usize, // read cursor
    pc: u64, // address of the next op of the program
    bad: bool, // a check failed
    budget: u64, // remaining operations
    regs: u64, // address of REGS u64 registers (on the caller's stack)
    out: *mut rt.Buf, // dump target, only valid when `dump`
    dump: bool,
    vals: bool, // lossless value dump (walk_values): strings, uuids, blobs in full, presence lines
    path: u64, // address of PATH_MAX octets
    plen: usize,
    depth: u64, // container nesting: 1 = the top level container
    calls: u64,
    last: u64, // the value of the last scalar/string/bit field (for the registers)
    pay_off: usize, // payload range of the last buffer/string
    pay_len: usize,
    pay_valid: bool,
    want: u64, // field_range: address of the wanted name (0 = none)
    want_len: usize,
    got: bool,
    got_off: usize,
    got_len: usize,
}

// ------------------------------------------------------------ program reading

// One operand: 6 data bits per octet, bit 6 = more.
fn rd_u(w: *mut W) -> u64 {
    var v: u64 = 0
    var shift: u64 = 0
    while true {
        let b: u64 = rt.ld8((*w).pc, 0) as u64
        (*w).pc = (*w).pc + 1
        v = v | ((b & 63) << shift)
        if (b & 64) == 0 {
            return v
        }
        shift = shift + 6
        if shift > 60 {
            // 11 groups cover 66 bits; the generator emits at most that
            if shift > 66 {
                return v
            }
        }
    }
    return v
}

// ------------------------------------------------------------- data reading

fn left(w: *mut W) -> usize {
    return (*w).len - (*w).pos
}

fn fail(w: *mut W) {
    (*w).bad = true
}

// n octets big endian; the caller has checked left() >= n
fn be(w: *mut W, n: usize) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < n {
        v = (v << 8) | (rt.ld8((*w).data, (*w).pos + i) as u64)
        i = i + 1
    }
    (*w).pos = (*w).pos + n
    return v
}

fn rd_varint(w: *mut W) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while true {
        if (*w).pos >= (*w).len {
            fail(w)
            return 0
        }
        let b: u64 = rt.ld8((*w).data, (*w).pos) as u64
        (*w).pos = (*w).pos + 1
        v = v | ((b & 127) << (7 * i))
        if (b & 128) == 0 {
            // a varint is an i32: sign extend
            if (v & 2147483648) != 0 {
                return v | 18446744069414584320
            }
            return v & 4294967295
        }
        i = i + 1
        if i >= 5 {
            fail(w)
            return 0
        }
    }
    return v
}

fn rd_varlong(w: *mut W) -> u64 {
    var v: u64 = 0
    var i: u64 = 0
    while true {
        if (*w).pos >= (*w).len {
            fail(w)
            return 0
        }
        let b: u64 = rt.ld8((*w).data, (*w).pos) as u64
        (*w).pos = (*w).pos + 1
        v = v | ((b & 127) << (7 * i))
        if (b & 128) == 0 {
            return v
        }
        i = i + 1
        if i >= 10 {
            fail(w)
            return 0
        }
    }
    return v
}

// A scalar of `kind`. Returns the value sign extended (floats: raw bits).
fn rd_scalar(w: *mut W, kind: u64) -> u64 {
    if kind == K_VARINT {
        return rd_varint(w)
    }
    if kind == K_VARLONG {
        return rd_varlong(w)
    }
    var n: usize = 1
    if kind == K_U16 || kind == K_I16 {
        n = 2
    }
    if kind == K_U32 || kind == K_I32 || kind == K_F32 {
        n = 4
    }
    if kind == K_U64 || kind == K_I64 || kind == K_F64 {
        n = 8
    }
    if kind == K_UUID {
        n = 16
    }
    if left(w) < n {
        fail(w)
        return 0
    }
    if kind == K_UUID {
        // 16 octets: keep the first 8 as the "value"
        let hi: u64 = be(w, 8)
        be(w, 8)
        return hi
    }
    let v: u64 = be(w, n)
    if kind == K_I8 {
        if (v & 128) != 0 {
            return v | 18446744073709551360
        }
    }
    if kind == K_I16 {
        if (v & 32768) != 0 {
            return v | 18446744073709486080
        }
    }
    if kind == K_I32 {
        if (v & 2147483648) != 0 {
            return v | 18446744069414584320
        }
    }
    return v
}

// ------------------------------------------------------------------ dump output

fn path_push(w: *mut W, p: u64, n: usize, dot: bool) {
    if !(*w).dump {
        return
    }
    var need: usize = n
    if dot && (*w).plen > 0 {
        need = need + 1
    }
    if (*w).plen + need > PATH_MAX {
        return
    }
    if dot && (*w).plen > 0 {
        rt.st8((*w).path, (*w).plen, 46)
        (*w).plen = (*w).plen + 1
    }
    var i: usize = 0
    while i < n {
        rt.st8((*w).path, (*w).plen + i, rt.ld8(p, i))
        i = i + 1
    }
    (*w).plen = (*w).plen + n
}

fn path_index(w: *mut W, idx: u64) {
    if !(*w).dump {
        return
    }
    if (*w).plen + 24 > PATH_MAX {
        return
    }
    rt.st8((*w).path, (*w).plen, 91)
    (*w).plen = (*w).plen + 1
    // decimal digits
    var digits: [u8; 24] = [0; 24]
    var nd: usize = 0
    var v: u64 = idx
    if v == 0 {
        digits[0] = 48
        nd = 1
    }
    while v > 0 {
        digits[nd] = (48 + (v % 10)) as u8
        v = v / 10
        nd = nd + 1
    }
    while nd > 0 {
        nd = nd - 1
        rt.st8((*w).path, (*w).plen, digits[nd])
        (*w).plen = (*w).plen + 1
    }
    rt.st8((*w).path, (*w).plen, 93)
    (*w).plen = (*w).plen + 1
}

fn line_start(w: *mut W) {
    rt.buf_push_bytes((*w).out, (*w).path, (*w).plen)
    rt.buf_push((*w).out, 61)
}

fn line_start_q(w: *mut W) {
    rt.buf_push_bytes((*w).out, (*w).path, (*w).plen)
    rt.buf_push((*w).out, 63)
    rt.buf_push((*w).out, 61)
}

fn line_end(w: *mut W) {
    rt.buf_push((*w).out, 10)
}

fn dump_scalar(w: *mut W, kind: u64, v: u64) {
    if !(*w).dump {
        return
    }
    line_start(w)
    if kind == K_UUID && (*w).vals {
        // the whole 16 octets (the read cursor stands right behind them)
        rt.buf_push_bytes((*w).out, "uuid:".p as u64, 5)
        var u: usize = 0
        while u < 16 {
            rt.buf_push_hex_u64((*w).out, rt.ld8((*w).data, (*w).pos - 16 + u) as u64, 2)
            u = u + 1
        }
    } else if kind == K_F32 || kind == K_F64 || kind == K_UUID {
        rt.buf_push((*w).out, 48)
        rt.buf_push((*w).out, 120)
        var digits: usize = 8
        if kind == K_F64 || kind == K_UUID {
            digits = 16
        }
        rt.buf_push_hex_u64((*w).out, v, digits)
    } else if kind == K_BOOL {
        if v != 0 {
            rt.buf_push((*w).out, 116)
            rt.buf_push((*w).out, 114)
            rt.buf_push((*w).out, 117)
            rt.buf_push((*w).out, 101)
        } else {
            rt.buf_push((*w).out, 102)
            rt.buf_push((*w).out, 97)
            rt.buf_push((*w).out, 108)
            rt.buf_push((*w).out, 115)
            rt.buf_push((*w).out, 101)
        }
    } else if kind == K_U8 || kind == K_U16 || kind == K_U32 || kind == K_U64 {
        rt.buf_push_dec_u64((*w).out, v)
    } else {
        rt.buf_push_dec_i64((*w).out, v as i64)
    }
    line_end(w)
}

fn dump_text(w: *mut W, off: usize, n: usize) {
    if !(*w).dump {
        return
    }
    line_start(w)
    if (*w).vals {
        // the whole string, quoted; control octets, quote and backslash as \xHH
        rt.buf_push((*w).out, 34)
        var k: usize = 0
        while k < n {
            let c: u8 = rt.ld8((*w).data, off + k)
            if c < 32 || c == 127 || c == 34 || c == 92 {
                rt.buf_push((*w).out, 92)
                rt.buf_push((*w).out, 120)
                rt.buf_push_hex_u64((*w).out, c as u64, 2)
            } else {
                rt.buf_push((*w).out, c)
            }
            k = k + 1
        }
        rt.buf_push((*w).out, 34)
        line_end(w)
        return
    }
    var m: usize = n
    if m > MAX_STR_DUMP {
        m = MAX_STR_DUMP
    }
    var i: usize = 0
    while i < m {
        var c: u8 = rt.ld8((*w).data, off + i)
        if c < 32 || c == 127 {
            c = 46
        }
        rt.buf_push((*w).out, c)
        i = i + 1
    }
    line_end(w)
}

// "path=#N" : a payload of N octets (buffers, nbt)
fn dump_len(w: *mut W, n: usize) {
    if !(*w).dump {
        return
    }
    line_start(w)
    rt.buf_push((*w).out, 35)
    rt.buf_push_dec_u64((*w).out, n as u64)
    line_end(w)
}

// A payload of n octets at data+off: `path=#N` normally, `path=hex:...` in the value dump.
fn dump_blob(w: *mut W, off: usize, n: usize) {
    if !(*w).dump {
        return
    }
    if !(*w).vals {
        dump_len(w, n)
        return
    }
    line_start(w)
    rt.buf_push_bytes((*w).out, "hex:".p as u64, 4)
    var k: usize = 0
    while k < n {
        rt.buf_push_hex_u64((*w).out, rt.ld8((*w).data, off + k) as u64, 2)
        k = k + 1
    }
    line_end(w)
}

// value dump only: `path?=1` / `path?=0`, the presence of an option
fn dump_present(w: *mut W, present: bool) {
    line_start_q(w)
    if present {
        rt.buf_push((*w).out, 49)
    } else {
        rt.buf_push((*w).out, 48)
    }
    line_end(w)
}

// ---------------------------------------------------------------------- NBT

// Skips the payload of one tag of `tag` (1..12). Structure checks only.
fn nbt_payload(w: *mut W, tag: u64, depth: u64) {
    if (*w).bad {
        return
    }
    if depth > MAX_NBT_DEPTH {
        fail(w)
        return
    }
    if (*w).budget == 0 {
        fail(w)
        return
    }
    (*w).budget = (*w).budget - 1
    if tag == 1 {
        nbt_skip(w, 1)
    } else if tag == 2 {
        nbt_skip(w, 2)
    } else if tag == 3 || tag == 5 {
        nbt_skip(w, 4)
    } else if tag == 4 || tag == 6 {
        nbt_skip(w, 8)
    } else if tag == 7 {
        nbt_array(w, 1)
    } else if tag == 8 {
        if left(w) < 2 {
            fail(w)
            return
        }
        let n: u64 = be(w, 2)
        nbt_skip(w, n)
    } else if tag == 9 {
        if left(w) < 5 {
            fail(w)
            return
        }
        let et: u64 = be(w, 1)
        let n: u64 = be(w, 4)
        if n >= 2147483648 {
            fail(w)
            return
        }
        if et == 0 {
            // a list of "end" tags: only an empty one is sane
            if n != 0 {
                fail(w)
            }
            return
        }
        if et > 12 {
            fail(w)
            return
        }
        // every element takes at least one octet, except an empty compound/list
        // which take one as well (end tag / type octet), so n <= left
        if n > left(w) as u64 {
            fail(w)
            return
        }
        var i: u64 = 0
        while i < n {
            if (*w).bad {
                return
            }
            nbt_payload(w, et, depth + 1)
            i = i + 1
        }
    } else if tag == 10 {
        while true {
            if (*w).bad {
                return
            }
            if left(w) < 1 {
                fail(w)
                return
            }
            let t: u64 = be(w, 1)
            if t == 0 {
                return
            }
            if t > 12 {
                fail(w)
                return
            }
            if left(w) < 2 {
                fail(w)
                return
            }
            let nl: u64 = be(w, 2)
            nbt_skip(w, nl)
            nbt_payload(w, t, depth + 1)
        }
    } else if tag == 11 {
        nbt_array(w, 4)
    } else if tag == 12 {
        nbt_array(w, 8)
    } else {
        fail(w)
    }
}

fn nbt_skip(w: *mut W, n: u64) {
    if (*w).bad {
        return
    }
    if n > left(w) as u64 {
        fail(w)
        return
    }
    (*w).pos = (*w).pos + n as usize
}

// i32 count + count elements of `esz` octets
fn nbt_array(w: *mut W, esz: u64) {
    if left(w) < 4 {
        fail(w)
        return
    }
    let n: u64 = be(w, 4)
    if n >= 2147483648 {
        fail(w)
        return
    }
    if n > (left(w) as u64) / esz {
        fail(w)
        return
    }
    (*w).pos = (*w).pos + (n * esz) as usize
}

// mode: 0 named, 1 anonymous, 2 optional named, 3 optional anonymous
fn exec_nbt(w: *mut W, mode: u64) {
    let start: usize = (*w).pos
    if left(w) < 1 {
        fail(w)
        return
    }
    let tag: u64 = be(w, 1)
    if mode >= 2 && tag == 0 {
        dump_blob(w, start, 1)
        return
    }
    if tag > 12 {
        fail(w)
        return
    }
    if mode == 0 || mode == 2 {
        if left(w) < 2 {
            fail(w)
            return
        }
        let nl: u64 = be(w, 2)
        nbt_skip(w, nl)
    }
    if tag != 0 {
        nbt_payload(w, tag, 1)
    }
    if !(*w).bad {
        dump_blob(w, start, (*w).pos - start)
    }
}

// ---------------------------------------------------------------- the engine

// Executes ONE type op at w.pc; leaves w.pc behind it.
fn exec_type(w: *mut W) {
    if (*w).bad {
        return
    }
    if (*w).budget == 0 {
        fail(w)
        return
    }
    (*w).budget = (*w).budget - 1
    let op: u64 = rt.ld8((*w).pc, 0) as u64
    (*w).pc = (*w).pc + 1
    (*w).pay_valid = false
    if op == O_SCALAR {
        let kind: u64 = rd_u(w)
        rd_u(w)
        let v: u64 = rd_scalar(w, kind)
        (*w).last = v
        if !(*w).bad {
            dump_scalar(w, kind, v)
        }
    } else if op == O_VOID {
        (*w).last = 0
    } else if op == O_CONTAINER {
        let blen: u64 = rd_u(w)
        let end: u64 = (*w).pc + blen
        (*w).depth = (*w).depth + 1
        while (*w).pc < end {
            if (*w).bad {
                return
            }
            exec_field(w)
        }
        (*w).depth = (*w).depth - 1
        (*w).pc = end
    } else if op == O_BITFIELD {
        exec_bitfield(w)
    } else if op == O_BITFLAGS {
        exec_bitflags(w)
    } else if op == O_STRING {
        let kind: u64 = rd_u(w)
        rd_u(w)
        let n: u64 = rd_scalar(w, kind)
        if (*w).bad {
            return
        }
        if n > left(w) as u64 {
            fail(w)
            return
        }
        let off: usize = (*w).pos
        (*w).pos = (*w).pos + n as usize
        // FNV-1a 64, the same hash the generator uses for switch keys
        var h: u64 = 14695981039346656037
        var i: usize = 0
        while i < n as usize {
            h = (h ^ (rt.ld8((*w).data, off + i) as u64)) *% 1099511628211
            i = i + 1
        }
        (*w).last = h
        dump_text(w, off, n as usize)
        (*w).pay_off = off
        (*w).pay_len = n as usize
        (*w).pay_valid = true
    } else if op == O_BUFFER {
        let ck: u64 = rd_u(w)
        let ca: u64 = rd_u(w)
        var n: u64 = 0
        if ck == CK_CONST {
            n = ca
        } else if ck == CK_REG {
            n = rt.ld64((*w).regs, ca as usize)
        } else {
            n = rd_scalar(w, ck)
        }
        if (*w).bad {
            return
        }
        if n > left(w) as u64 {
            fail(w)
            return
        }
        let off: usize = (*w).pos
        (*w).pos = (*w).pos + n as usize
        dump_blob(w, off, n as usize)
        (*w).pay_off = off
        (*w).pay_len = n as usize
        (*w).pay_valid = true
    } else if op == O_RESTBUF {
        let off: usize = (*w).pos
        let n: usize = left(w)
        (*w).pos = (*w).len
        dump_blob(w, off, n)
        (*w).pay_off = off
        (*w).pay_len = n
        (*w).pay_valid = true
    } else if op == O_ARRAY {
        exec_array(w)
    } else if op == O_OPTION {
        let blen: u64 = rd_u(w)
        let end: u64 = (*w).pc + blen
        if left(w) < 1 {
            fail(w)
            return
        }
        let present: u64 = be(w, 1)
        if present > 1 {
            fail(w) // protodef: a bool is 0/1 for us; a stricter reading than JS, on purpose
            return
        }
        if (*w).dump {
            if (*w).vals {
                dump_present(w, present == 1)
            } else {
                dump_scalar(w, K_BOOL, present)
            }
        }
        if present == 1 {
            exec_type(w)
        }
        (*w).pc = end
    } else if op == O_SWITCH {
        exec_switch(w)
    } else if op == O_CALL {
        // 4 groups of 6 bits, zigzag, relative to the end of the operand
        var zz: u64 = 0
        var i: u64 = 0
        while i < 4 {
            zz = zz | ((rt.ld8((*w).pc, i as usize) as u64) << (6 * i))
            i = i + 1
        }
        (*w).pc = (*w).pc + 4
        let ret: u64 = (*w).pc
        var target: u64 = 0
        if (zz & 1) == 0 {
            target = ret + (zz >> 1)
        } else {
            target = ret - ((zz + 1) >> 1)
        }
        if (*w).calls >= MAX_CALL_DEPTH {
            fail(w)
            return
        }
        (*w).calls = (*w).calls + 1
        (*w).pc = target
        exec_type(w)
        (*w).calls = (*w).calls - 1
        (*w).pc = ret
    } else if op == O_TOPBIT {
        let blen: u64 = rd_u(w)
        let body: u64 = (*w).pc
        var idx: u64 = 0
        while true {
            if (*w).bad {
                return
            }
            if left(w) < 1 {
                fail(w)
                return
            }
            let first: u64 = rt.ld8((*w).data, (*w).pos) as u64
            let mark: usize = (*w).plen
            path_index(w, idx)
            (*w).pc = body
            exec_type(w)
            (*w).plen = mark
            idx = idx + 1
            if (first & 128) == 0 {
                break
            }
        }
        (*w).pc = body + blen
    } else if op == O_EMETA {
        let endv: u64 = rd_u(w)
        let blen: u64 = rd_u(w)
        let body: u64 = (*w).pc
        var idx: u64 = 0
        while true {
            if (*w).bad {
                return
            }
            if left(w) < 1 {
                fail(w)
                return
            }
            let first: u64 = rt.ld8((*w).data, (*w).pos) as u64
            if first == endv {
                (*w).pos = (*w).pos + 1
                break
            }
            let mark: usize = (*w).plen
            path_index(w, idx)
            (*w).pc = body
            exec_type(w)
            (*w).plen = mark
            idx = idx + 1
        }
        (*w).pc = body + blen
    } else if op == O_NBT {
        let mode: u64 = rd_u(w)
        exec_nbt(w, mode)
    } else if op == O_REGHOLDER {
        let nl: u64 = rd_u(w)
        let name1: u64 = (*w).pc
        (*w).pc = (*w).pc + nl
        let nl2: u64 = rd_u(w)
        let name2: u64 = (*w).pc
        (*w).pc = (*w).pc + nl2
        let blen: u64 = rd_u(w)
        let end: u64 = (*w).pc + blen
        let n: u64 = rd_varint(w)
        if (*w).bad {
            return
        }
        if (*w).vals {
            // value dump: `path.<idName>=<id>` or the inline value under `path.<inlineName>`
            let mark: usize = (*w).plen
            if n == 0 {
                path_push(w, name2, nl2 as usize, true)
                exec_type(w)
            } else {
                path_push(w, name1, nl as usize, true)
                dump_scalar(w, K_VARINT, n - 1)
            }
            (*w).plen = mark
        } else {
            dump_scalar(w, K_VARINT, n)
            if n == 0 {
                exec_type(w)
            }
        }
        (*w).pc = end
    } else if op == O_RCALL {
        exec_rcall(w)
    } else if op == O_REGSET {
        exec_regset(w)
    } else if op == O_LPVEC3 {
        exec_lpvec3(w)
    } else {
        fail(w)
    }
}

// A recursive reference (a type that holds itself, e.g. a slot component that holds a
// slot). Same operand as CALL. The callee may overwrite registers that the caller still
// needs (the same subroutine runs again), so the whole register file is saved here and
// restored after the call. Depth is limited by MAX_CALL_DEPTH.
fn exec_rcall(w: *mut W) {
    var zz: u64 = 0
    var i: u64 = 0
    while i < 4 {
        zz = zz | ((rt.ld8((*w).pc, i as usize) as u64) << (6 * i))
        i = i + 1
    }
    (*w).pc = (*w).pc + 4
    let ret: u64 = (*w).pc
    var target: u64 = 0
    if (zz & 1) == 0 {
        target = ret + (zz >> 1)
    } else {
        target = ret - ((zz + 1) >> 1)
    }
    if (*w).calls >= MAX_CALL_DEPTH {
        fail(w)
        return
    }
    var saved: [u64; 128] = [0; 128]
    var k: usize = 0
    while k < REGS {
        saved[k] = rt.ld64((*w).regs, k)
        k = k + 1
    }
    (*w).calls = (*w).calls + 1
    (*w).pc = target
    exec_type(w)
    (*w).calls = (*w).calls - 1
    (*w).pc = ret
    k = 0
    while k < REGS {
        rt.st64((*w).regs, k, saved[k])
        k = k + 1
    }
}

// lpVec3 (1.21.9+): u8 a; a == 0: a zero vector, nothing follows; else u8 b, u32 c and,
// when bit 2 of a is set, one varint (the scale extension): 6 or 6+varint octets.
fn exec_lpvec3(w: *mut W) {
    if left(w) < 1 {
        fail(w)
        return
    }
    let a: u64 = be(w, 1)
    var n: usize = 1
    if a != 0 {
        if left(w) < 5 {
            fail(w)
            return
        }
        be(w, 5)
        n = 6
        if (a & 4) != 0 {
            let before: usize = (*w).pos
            rd_varint(w)
            if (*w).bad {
                return
            }
            n = n + ((*w).pos - before)
        }
    }
    dump_blob(w, (*w).pos - n, n)
}

// registryEntryHolderSet: varint n; n == 0: the base type (a tag name); else n-1
// elements of the element type. The count is a claim of the peer: every element needs
// at least `minsz` octets (generator), so n-1 <= left/minsz; zero width elements are
// capped by MAX_EMPTY and the operation budget.
fn exec_regset(w: *mut W) {
    let nl1: u64 = rd_u(w)
    let name1: u64 = (*w).pc
    (*w).pc = (*w).pc + nl1
    let nl2: u64 = rd_u(w)
    let name2: u64 = (*w).pc
    (*w).pc = (*w).pc + nl2
    let minsz: u64 = rd_u(w)
    let blen1: u64 = rd_u(w)
    let base: u64 = (*w).pc
    (*w).pc = base + blen1
    let blen2: u64 = rd_u(w)
    let elem: u64 = (*w).pc
    let end: u64 = elem + blen2
    let n: u64 = rd_varint(w)
    if (*w).bad {
        return
    }
    let outer: usize = (*w).plen
    if !(*w).vals {
        dump_scalar(w, K_VARINT, n)
    }
    if n == 0 {
        if (*w).vals {
            path_push(w, name1, nl1 as usize, true)
        }
        (*w).pc = base
        exec_type(w)
        (*w).plen = outer
    } else {
        let cnt: u64 = n - 1
        if minsz > 0 {
            if cnt > (left(w) as u64) / minsz {
                fail(w)
                return
            }
        } else {
            if cnt > MAX_EMPTY {
                fail(w)
                return
            }
        }
        if (*w).vals {
            path_push(w, name2, nl2 as usize, true)
            dump_len(w, cnt as usize)
        }
        var i: u64 = 0
        while i < cnt {
            if (*w).bad {
                return
            }
            let mark: usize = (*w).plen
            path_index(w, i)
            (*w).pc = elem
            exec_type(w)
            (*w).plen = mark
            i = i + 1
        }
        (*w).plen = outer
    }
    (*w).pc = end
}

fn exec_field(w: *mut W) {
    let op: u64 = rt.ld8((*w).pc, 0) as u64
    (*w).pc = (*w).pc + 1
    if op != O_FIELD {
        fail(w)
        return
    }
    let nl: u64 = rd_u(w)
    let name: u64 = (*w).pc
    (*w).pc = (*w).pc + nl
    let reg1: u64 = rd_u(w)
    let mark: usize = (*w).plen
    if nl > 0 {
        path_push(w, name, nl as usize, true)
    }
    let start: usize = (*w).pos
    var wanted: bool = false
    if (*w).want != 0 && (*w).depth == 1 && !(*w).got && nl == (*w).want_len as u64 {
        wanted = rt.mem_eq(name, (*w).want, nl as usize)
    }
    exec_type(w)
    if (*w).bad {
        return
    }
    if reg1 != 0 {
        rt.st64((*w).regs, (reg1 - 1) as usize, (*w).last)
    }
    if wanted {
        (*w).got = true
        if (*w).pay_valid {
            (*w).got_off = (*w).pay_off
            (*w).got_len = (*w).pay_len
        } else {
            (*w).got_off = start
            (*w).got_len = (*w).pos - start
        }
    }
    (*w).plen = mark
}

fn exec_bitfield(w: *mut W) {
    let nbytes: u64 = rd_u(w)
    let nsub: u64 = rd_u(w)
    if left(w) < nbytes as usize {
        fail(w)
        return
    }
    let raw: u64 = be(w, nbytes as usize)
    var used: u64 = 0
    var i: u64 = 0
    while i < nsub {
        let size: u64 = rd_u(w)
        let signed: u64 = rd_u(w)
        let reg1: u64 = rd_u(w)
        let nl: u64 = rd_u(w)
        let name: u64 = (*w).pc
        (*w).pc = (*w).pc + nl
        let shift: u64 = nbytes * 8 - used - size
        var v: u64 = raw >> shift
        if size < 64 {
            v = v & ((1 << size) - 1)
        }
        if signed != 0 && size < 64 {
            if (v & (1 << (size - 1))) != 0 {
                v = v | (18446744073709551615 << size)
            }
        }
        used = used + size
        if reg1 != 0 {
            rt.st64((*w).regs, (reg1 - 1) as usize, v)
        }
        if (*w).dump {
            let mark: usize = (*w).plen
            path_push(w, name, nl as usize, true)
            if signed != 0 {
                dump_scalar(w, K_I64, v)
            } else {
                dump_scalar(w, K_U64, v)
            }
            (*w).plen = mark
        }
        i = i + 1
    }
    (*w).last = raw
}

fn exec_bitflags(w: *mut W) {
    let kind: u64 = rd_u(w)
    let nflags: u64 = rd_u(w)
    let raw: u64 = rd_scalar(w, kind)
    var i: u64 = 0
    while i < nflags {
        let bit: u64 = rd_u(w)
        let reg1: u64 = rd_u(w)
        let nl: u64 = rd_u(w)
        let name: u64 = (*w).pc
        (*w).pc = (*w).pc + nl
        let v: u64 = (raw >> bit) & 1
        if reg1 != 0 {
            rt.st64((*w).regs, (reg1 - 1) as usize, v)
        }
        if (*w).dump && !(*w).bad {
            let mark: usize = (*w).plen
            path_push(w, name, nl as usize, true)
            dump_scalar(w, K_BOOL, v)
            (*w).plen = mark
        }
        i = i + 1
    }
    (*w).last = raw
}

fn exec_array(w: *mut W) {
    let ck: u64 = rd_u(w)
    let ca: u64 = rd_u(w)
    let minsz: u64 = rd_u(w)
    let blen: u64 = rd_u(w)
    let body: u64 = (*w).pc
    var n: u64 = 0
    if ck == CK_CONST {
        n = ca
    } else if ck == CK_REG {
        n = rt.ld64((*w).regs, ca as usize)
    } else {
        n = rd_scalar(w, ck)
    }
    if (*w).bad {
        return
    }
    // The count is a claim of the peer. Each element needs at least `minsz`
    // octets; with minsz = 0 (void elements) a hard cap and the budget apply.
    if minsz > 0 {
        if n > (left(w) as u64) / minsz {
            fail(w)
            return
        }
    } else {
        if n > MAX_EMPTY {
            fail(w)
            return
        }
    }
    if (*w).dump {
        dump_len(w, n as usize)
    }
    var i: u64 = 0
    while i < n {
        if (*w).bad {
            return
        }
        let mark: usize = (*w).plen
        path_index(w, i)
        (*w).pc = body
        exec_type(w)
        (*w).plen = mark
        i = i + 1
    }
    (*w).pc = body + blen
}

fn exec_switch(w: *mut W) {
    let reg: u64 = rd_u(w)
    let ncases: u64 = rd_u(w)
    let val: u64 = rt.ld64((*w).regs, reg as usize)
    var chosen: u64 = 0
    var found: bool = false
    var i: u64 = 0
    while i < ncases {
        let key: u64 = rd_u(w)
        let blen: u64 = rd_u(w)
        if !found && key == val {
            chosen = (*w).pc
            found = true
        }
        (*w).pc = (*w).pc + blen
        i = i + 1
    }
    let dlen: u64 = rd_u(w)
    let dpc: u64 = (*w).pc
    let end: u64 = dpc + dlen
    if found {
        (*w).pc = chosen
    } else {
        (*w).pc = dpc
    }
    exec_type(w)
    (*w).pc = end
}

// ----------------------------------------------------------------- public API

fn format_ok(f: i32) -> bool {
    return f == SCHEMA_FORMAT
}

// Core: `exact` = the buffer must be consumed to the last octet.
fn run(schema: u64, b: *mut bytes.Bytes, out: *mut rt.Buf, want: u64, want_len: usize, exact: bool, off: *mut usize, olen: *mut usize, vals: bool) -> bool {
    if schema == 0 {
        return false
    }
    var regs: [u64; 128] = [0; 128]
    var path: [u8; 1024] = [0; 1024]
    var w: W = W {
        data: bytes.bytes_data(b),
        len: bytes.bytes_len(b),
        pos: bytes.bytes_pos(b),
        pc: schema,
        bad: false,
        budget: 0,
        regs: (&regs[0]) as u64,
        out: out,
        dump: false,
        vals: vals,
        path: (&path[0]) as u64,
        plen: 0,
        depth: 0,
        calls: 0,
        last: 0,
        pay_off: 0,
        pay_len: 0,
        pay_valid: false,
        want: want,
        want_len: want_len,
        got: false,
        got_off: 0,
        got_len: 0,
    }
    if (out as u64) != 0 {
        w.dump = true
    }
    let start: usize = w.pos
    if w.pos > w.len {
        return false
    }
    // Budget: a legitimate packet costs about one op per field; 64 per octet is
    // generous, the constant covers tiny packets with big schemas.
    w.budget = 4096 + 64 * ((w.len - w.pos) as u64)
    var i: usize = 0
    while i < REGS {
        regs[i] = 0
        i = i + 1
    }
    exec_type(&w)
    var ok: bool = !w.bad
    if ok && exact && w.pos != w.len {
        ok = false
    }
    if ok {
        bytes.bytes_set_pos(b, w.pos)
    }
    if want != 0 {
        if !w.got {
            ok = false
        } else {
            *off = w.got_off
            *olen = w.got_len
        }
    }
    if !ok {
        bytes.bytes_set_pos(b, start)
    }
    return ok
}

// Does the rest of `b` (from its read cursor) follow `schema` EXACTLY? With
// `out != 0` the scalar fields are appended as `path=value` lines. On true the
// cursor is at the end; on false it is where it was.
fn walk(schema: u64, b: *mut bytes.Bytes, out: *mut rt.Buf) -> bool {
    var o: usize = 0
    var l: usize = 0
    return run(schema, b, out, 0, 0, true, &o, &l, false)
}

// Like walk, but the dump is LOSSLESS: the value store that mc_encode.encode takes back
// (strings in full and quoted, uuids in full, buffers / NBT / lpVec3 as `hex:..`, options as
// `path?=0|1`, holders as `path.<id name>=N` or the inline value). `out` must not be 0.
fn walk_values(schema: u64, b: *mut bytes.Bytes, out: *mut rt.Buf) -> bool {
    var o: usize = 0
    var l: usize = 0
    return run(schema, b, out, 0, 0, true, &o, &l, true)
}

// Like walk, but octets behind the packet are allowed; the cursor stands behind it.
fn walk_prefix(schema: u64, b: *mut bytes.Bytes, out: *mut rt.Buf) -> bool {
    var o: usize = 0
    var l: usize = 0
    return run(schema, b, out, 0, 0, false, &o, &l, false)
}

// Walks the packet exactly (like `walk`) and reports where the TOP LEVEL field
// `name` (name_ptr/name_len, not NUL terminated) lies: *off is an offset from
// the start of the Bytes data, *len its length. For a buffer or string field
// that is the PAYLOAD (behind the length prefix); for anything else the whole
// field. false if the packet is malformed or has no such field. The cursor is
// not moved.
fn field_range(schema: u64, name_ptr: u64, name_len: usize, b: *mut bytes.Bytes, off: *mut usize, len: *mut usize) -> bool {
    let p: usize = bytes.bytes_pos(b)
    let ok: bool = run(schema, b, 0 as *mut rt.Buf, name_ptr, name_len, true, off, len, false)
    bytes.bytes_set_pos(b, p)
    return ok
}
