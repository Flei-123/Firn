// lib/mc/mc_input.fi -- player input -> camera, movement, block picking, selection box. Pure data, no window:
// the caller fills an InputEvents struct (mouse delta, key mask, edge flags) once per game tick (20 Hz).
//
//   * Mouse look: vanilla formula, degrees = pixels * (s*0.6+0.2)^3 * 8 * 0.15 with sensitivity s (default 0.5 -> 0.15 deg / pixel);
//     yaw grows to the right (0 = south, 90 = west), pitch > 0 looks down, clamped to +-90.
//   * Movement per tick: vanilla momentum physics (mc_phys: acceleration 0.098 * (0.6 / friction)^3 on the ground, 0.02 / 0.026 in the air, drag block friction * 0.91,
//     gravity vy = (vy - 0.08) * 0.98, jump 0.42 + sprint push 0.2, jump delay 10), box 0.6 x 1.8 (sneaking 1.5), eye 1.62 (1.27).
//     Fly mode (`flying`): momentum with flying speed 0.05; `noclip` additionally ignores all blocks. Collision: a 9x9x9 snapshot of the world around
//     the player (unloaded chunks count as solid) + mc_math.grid_move. Water, lava, ladders: see mc_move_fluid (kinds in Player.mv). Step-up (stepHeight 0.6, vanilla Entity.collide, see move_step)
//     only matters for partial shapes (solid table value 128 + k, see mc_math.shape_box / mc_shapes); the Auto-Jump option (`Player.autojump`, off by default) jumps against a 1 block step (see auto_jump_ok).
//   * Pick: Amanatides-Woo DDA directly over mc_world (reach 5, creative 6). Hit = block + entered face (normal) + distance.
//   * Selection box: the 12 edges of the block (+-0.002) as lines (near clipped, 1/16-pixel snapped, integer DDA, depth test
//     with a small tolerance, no depth write) -- tools/mc/input/ref.py repeats every rule.

import std.rt
import std.math
import mc.mc_math
import mc.mc_camera
import mc.mc_raster
import mc.mc_world
import mc.mc_world_view
import mc.mc_move_fluid
import mc.mc_fluid_flow
import mc.mc_scaffold
import mc.mc_slide
import mc.mc_bounce
import mc.mc_phys

export {
    InputEvents, InputTables, Player, Pick, input_events_new, player_new, player_free, player_look, player_tick,
    player_set_camera, player_set_camera_lerp, player_lerp_pos, player_lerp_eye, player_reach, player_eye, player_height, HEIGHT_STAND, HEIGHT_SNEAK, HEIGHT_LOW, EYE_STAND, EYE_SNEAK, EYE_LOW, input_pick, input_pick_camera, input_draw_box, input_draw_aabb, input_draw_aabb_b, world_block_id,
    K_FORWARD, K_BACK, K_LEFT, K_RIGHT, K_JUMP, K_SNEAK, K_SPRINT,
}

const K_FORWARD: u32 = 1
const K_BACK: u32 = 2
const K_LEFT: u32 = 4
const K_RIGHT: u32 = 8
const K_JUMP: u32 = 16
const K_SNEAK: u32 = 32
const K_SPRINT: u32 = 64

const DIAG: f64 = 0.7071067811865476
const SNAP_N: i32 = 9
const STEP_HEIGHT: f64 = 0.6 // vanilla stepHeight of the player
const AUTO_JUMP_HEAD: f64 = 1.25 // jump apex (0.42 start velocity)

struct InputEvents {
    dx: f64, dy: f64, // mouse movement in pixels since the last tick (right / down positive)
    keys: u32, // K_* bit mask (held keys)
    toggle_fly: bool, // edge: fly mode on / off
    toggle_noclip: bool, // edge: noclip on / off
    slot_delta: i32, // mouse wheel: hotbar slot change (any size, wraps)
}

// u8 per block id (ids >= n count as 0): pick = outlined / targetable (everything but air and fluids in vanilla),
// solid = blocks the player.
struct InputTables {
    pick: u64,
    solid: u64,
    n: usize,
}

struct Player {
    x: f64, y: f64, z: f64, // feet
    yaw: f64, pitch: f64, // degrees
    vy: f64, // vertical velocity in blocks per tick (ground mode)
    on_ground: bool,
    fall: f64, // fall distance in blocks (vanilla fallDistance; 0 on the ground), needed by the sneak edge clamp
    flying: bool,
    noclip: bool,
    creative: bool,
    sneaking: bool,
    sprinting: bool,
    swimming: bool,
    low_pose: bool,
    crouched: bool,
    autojump: bool, // vanilla "Auto-Jump" option (default OFF like the Java default): walking against a 1 block step jumps by itself
    sens: f64, // 0..1
    slot: i32, // selected hotbar slot 0..8
    snap: u64, // u16 [9^3] collision snapshot
    cls: u64, // u8 [256] class table (0 passable, 1 full cube, 128 + k partial shape k of mc_math.shape_box)
    mv: u64, // u8 [65536] movement kind per block state (mc_math.MV_*; mc_shapes.move_fill), all 0 = no slowdown blocks
    vx: f64, vz: f64, // horizontal velocity in blocks per tick, only kept while in a fluid
    stuck: i32, // set by the last move: 0 none, 1 cobweb, 2 sweet berry bush (vanilla stuckSpeedMultiplier), used by the next move
    wet: bool,
    jump_delay: i32, // vanilla noJumpDelay: ticks until the next jump while the jump key stays down
    aj_jump: bool, // auto-jump request: acts like the jump key on the next tick
    sprint_trigger: i32, // double-tap W window (vanilla sprintTriggerTime)
    enough_prev: bool, sneak_prev: bool, // last tick's forward impulse >= 0.8 / sneak key
    hcol: bool, minor: bool, // last move: horizontal collision / collision along the input direction
    jump_boost: i32, // Jump Boost level (amplifier + 1), 0 = none
    can_sprint: bool, using_item: bool,
    px: f64, py: f64, pz: f64, // feet position at the start of the last tick (render interpolation)
    eye: f64, eye_prev: f64, // smoothed eye height now / one tick ago
}

struct Pick {
    x: i32, y: i32, z: i32, // block
    nx: i32, ny: i32, nz: i32, // face that was entered (points back to the ray origin); 0,0,0 when the origin is inside the block
    dist: f64,
    id: i32,
}

fn input_events_new() -> InputEvents {
    return InputEvents { dx: 0.0, dy: 0.0, keys: 0 as u32, toggle_fly: false, toggle_noclip: false, slot_delta: 0 }
}

const CLS_N: usize = 65536

fn player_new(x: f64, y: f64, z: f64) -> Player {
    var p: Player = Player {
        x: x, y: y, z: z, yaw: 0.0, pitch: 0.0, vy: 0.0, on_ground: false, fall: 0.0, flying: false, noclip: false, creative: false,
        sneaking: false, sprinting: false, swimming: false, low_pose: false, crouched: false, autojump: false, sens: 0.5, slot: 0, snap: 0, cls: 0, mv: 0, vx: 0.0, vz: 0.0, stuck: 0, wet: false, jump_delay: 0, aj_jump: false, sprint_trigger: 0, enough_prev: false, sneak_prev: false,
        hcol: false, minor: false, jump_boost: 0, can_sprint: true, using_item: false, px: x, py: y, pz: z, eye: EYE_STAND, eye_prev: EYE_STAND,
    }
    p.snap = rt.heap_alloc((SNAP_N * SNAP_N * SNAP_N) as usize * 2)
    p.mv = rt.heap_alloc(CLS_N)
    p.cls = rt.heap_alloc(CLS_N * 2) // u16 class table (identity for shape codes >= 128): shape codes go up to 65535
    var k: usize = 0
    while k < CLS_N {
        var v: u16 = 1 as u16
        if k == 0 { v = 0 as u16 }
        if k >= 128 { v = k as u16 }
        rt.st16(p.cls, k, v)
        rt.st8(p.mv, k, 0 as u8)
        k = k + 1
    }
    return p
}

fn player_free(p: *mut Player) {
    if (*p).snap != 0 { rt.heap_free((*p).snap, (SNAP_N * SNAP_N * SNAP_N) as usize * 2) }
    if (*p).cls != 0 { rt.heap_free((*p).cls, CLS_N * 2) }
    if (*p).mv != 0 { rt.heap_free((*p).mv, CLS_N) }
    (*p).mv = 0
    (*p).snap = 0
    (*p).cls = 0
}

const HEIGHT_STAND: f64 = 1.8
const HEIGHT_SNEAK: f64 = 1.5
const HEIGHT_LOW: f64 = 0.6
const EYE_STAND: f64 = 1.62
const EYE_SNEAK: f64 = 1.27
const EYE_LOW: f64 = 0.4

fn player_eye(p: *mut Player) -> f64 {
    if (*p).low_pose { return EYE_LOW }
    if (*p).sneaking || (*p).crouched { return EYE_SNEAK }
    return EYE_STAND
}

fn player_height(p: *mut Player) -> f64 {
    if (*p).low_pose { return HEIGHT_LOW }
    if (*p).sneaking || (*p).crouched { return HEIGHT_SNEAK }
    return HEIGHT_STAND
}

fn pose_fits(p: *mut Player, g: *mut mc_math.BlockGrid, h: f64) -> bool {
    var m: mc_math.Aabb = mc_math.Aabb { x0: (*p).x - 0.3, y0: (*p).y, z0: (*p).z - 0.3, x1: (*p).x + 0.3, y1: (*p).y + h, z1: (*p).z + 0.3 }
    return moved_free(g, &m, 0.0, 0.0, 0.0)
}

fn pose_after(p: *mut Player, g: *mut mc_math.BlockGrid, swimming: bool) {
    (*p).crouched = false
    if swimming {
        (*p).low_pose = true
        return
    }
    var want: f64 = HEIGHT_STAND
    if (*p).sneaking && !(*p).flying { want = HEIGHT_SNEAK }
    if pose_fits(p, g, want) {
        (*p).low_pose = false
    } else if pose_fits(p, g, HEIGHT_SNEAK) {
        (*p).low_pose = false
        (*p).crouched = true
    } else {
        (*p).low_pose = true
    }
}

fn crawl_slowed(p: *mut Player, in_fluid: bool) -> bool {
    return (*p).crouched || ((*p).low_pose && !in_fluid)
}

fn player_reach(p: *mut Player) -> f64 {
    if (*p).creative { return 6.0 }
    return 5.0
}

fn wrap_yaw(yaw: f64) -> f64 {
    var y: f64 = yaw - 360.0 * math.floor((yaw + 180.0) / 360.0)
    if y >= 180.0 { y = y - 360.0 }
    return y
}

// Mouse delta (pixels) -> yaw / pitch.
fn player_look(p: *mut Player, dx: f64, dy: f64) {
    let f: f64 = (*p).sens * 0.6 + 0.2
    let k: f64 = (f * f * f * 8.0) * 0.15
    (*p).yaw = wrap_yaw((*p).yaw + dx * k)
    var pt: f64 = (*p).pitch + dy * k
    if pt > 90.0 { pt = 90.0 }
    if pt < -90.0 { pt = -90.0 }
    (*p).pitch = pt
}

fn player_lerp_pos(p: *mut Player, t: f64, ox: *mut f64, oy: *mut f64, oz: *mut f64) {
    let dx: f64 = (*p).x - (*p).px
    let dy: f64 = (*p).y - (*p).py
    let dz: f64 = (*p).z - (*p).pz
    var k: f64 = t
    if k < 0.0 { k = 0.0 }
    if k > 1.0 { k = 1.0 }
    if dx * dx + dy * dy + dz * dz > 16.0 { k = 1.0 }
    *ox = mc_phys.lerp((*p).px, (*p).x, k)
    *oy = mc_phys.lerp((*p).py, (*p).y, k)
    *oz = mc_phys.lerp((*p).pz, (*p).z, k)
}

fn player_lerp_eye(p: *mut Player, t: f64) -> f64 {
    return mc_phys.lerp((*p).eye_prev, (*p).eye, t)
}

fn player_set_camera_lerp(p: *mut Player, cam: *mut mc_camera.Camera, t: f64) {
    var x: f64 = 0.0
    var y: f64 = 0.0
    var z: f64 = 0.0
    player_lerp_pos(p, t, &x, &y, &z)
    mc_camera.camera_set_pos(cam, x, y + player_lerp_eye(p, t), z)
    mc_camera.camera_set_angles(cam, (*p).yaw, (*p).pitch)
    mc_camera.camera_update(cam)
}

fn player_set_camera(p: *mut Player, cam: *mut mc_camera.Camera) {
    mc_camera.camera_set_pos(cam, (*p).x, (*p).y + player_eye(p), (*p).z)
    mc_camera.camera_set_angles(cam, (*p).yaw, (*p).pitch)
    mc_camera.camera_update(cam)
}

// ---------------------------------------------------------------- world access (with a one chunk cache)

// block id in the world (min_y = world bottom, -64 in 1.20.1): -1 not loaded, -2 outside the stored height
fn world_block_id(w: *mut mc_world.World, min_y: i32, x: i32, y: i32, z: i32) -> i32 {
    var v: mc_world_view.WorldView = mc_world_view.view_new(w, min_y)
    return mc_world_view.view_id(&v, x, y, z)
}

fn table_flag(t: u64, n: usize, id: i32) -> bool {
    if id < 0 || (id as usize) >= n { return false }
    return rt.ld8(t, id as usize) != 0 as u8
}

// ---------------------------------------------------------------- movement

fn snapshot(p: *mut Player, v: *mut mc_world_view.WorldView, tb: *mut InputTables, out: *mut mc_math.BlockGrid) {
    let ox: i32 = (math.floor((*p).x) as i32) - 4
    let oy: i32 = (math.floor((*p).y) as i32) - 4
    let oz: i32 = (math.floor((*p).z) as i32) - 4
    var y: i32 = 0
    while y < SNAP_N {
        var z: i32 = 0
        while z < SNAP_N {
            var x: i32 = 0
            while x < SNAP_N {
                let id: i32 = mc_world_view.view_id(v, ox + x, oy + y, oz + z)
                var c: u16 = 0 as u16
                if id == -1 {
                    c = 1 as u16
                } else if id >= 0 && (id as usize) < (*tb).n {
                    let sv: u16 = rt.ld16((*tb).solid, id as usize)
                    if sv != 0 as u16 { c = 1 as u16 }
                    if sv >= 128 as u16 { c = sv } // partial shape code
                    if mc_scaffold.is_scaffold_code(sv as i32) { c = mc_scaffold.resolve_cell(sv as i32, oy + y, (*p).y, (*p).sneaking) as u16 }
                }
                rt.st16((*p).snap, ((y * SNAP_N + z) * SNAP_N + x) as usize, c)
                x = x + 1
            }
            z = z + 1
        }
        y = y + 1
    }
    *out = mc_math.grid_view(ox, oy, oz, SNAP_N, SNAP_N, SNAP_N, (*p).snap, (*p).cls, CLS_N as u32, false)
}

// Auto-Jump (vanilla option): true when the player stands on the ground, walks horizontally into an obstacle of at most one block, and a
// jump (apex 1.25) clears it: the box raised by 1.0 can take the same horizontal step and the box has 1.25 of headroom. Never while
// sneaking, flying or noclipping (the caller checks those).
fn auto_jump_ok(g: *mut mc_math.BlockGrid, b: *mut mc_math.Aabb, dx: f64, dz: f64) -> bool {
    var up: mc_math.Aabb = *b
    var r1: mc_math.MoveResult = mc_math.MoveResult { dx: 0.0, dy: 0.0, dz: 0.0, hit_x: false, hit_y: false, hit_z: false }
    mc_math.grid_move(g, &up, 0.0, AUTO_JUMP_HEAD, 0.0, &r1)
    if r1.dy < AUTO_JUMP_HEAD - 0.000000001 { return false } // ceiling too low for the jump
    var r2: mc_math.MoveResult = mc_math.MoveResult { dx: 0.0, dy: 0.0, dz: 0.0, hit_x: false, hit_y: false, hit_z: false }
    var step: mc_math.Aabb = *b
    step.y0 = step.y0 + 1.0
    step.y1 = step.y1 + 1.0
    mc_math.grid_move(g, &step, dx, 0.0, dz, &r2)
    if r2.hit_x || r2.hit_z { return false }
    // headroom at the landing spot: the jump apex (1.25) is 0.25 above the step
    var top: mc_math.Aabb = step
    top.x0 = top.x0 + r2.dx
    top.x1 = top.x1 + r2.dx
    top.z0 = top.z0 + r2.dz
    top.z1 = top.z1 + r2.dz
    var r3: mc_math.MoveResult = mc_math.MoveResult { dx: 0.0, dy: 0.0, dz: 0.0, hit_x: false, hit_y: false, hit_z: false }
    mc_math.grid_move(g, &top, 0.0, AUTO_JUMP_HEAD - 1.0, 0.0, &r3)
    return r3.dy >= AUTO_JUMP_HEAD - 1.0 - 0.000000001
}

// Vanilla 1.20.1 Entity.collide with stepHeight 0.6: a normal collision move; when that was blocked horizontally and the entity
// stood on the ground (or just hit the floor moving down), it is retried raised by the step height (once straight up with the box
// widened towards the move, once as a plain raise), the better horizontal result wins, then the box is lowered back onto the
// floor. Only partial shapes (slabs, stairs, carpets) can be stepped; a full block (1.0) is above 0.6.
fn move_step(g: *mut mc_math.BlockGrid, b: *mut mc_math.Aabb, dx: f64, dy: f64, dz: f64, was_ground: bool, out: *mut mc_math.MoveResult) {
    mc_math.grid_move(g, b, dx, dy, dz, out)
    let flag3: bool = was_ground || ((*out).hit_y && dy < 0.0)
    if !flag3 || !((*out).hit_x || (*out).hit_z) { return }
    var r1: mc_math.MoveResult = mc_math.MoveResult { dx: 0.0, dy: 0.0, dz: 0.0, hit_x: false, hit_y: false, hit_z: false }
    mc_math.grid_move(g, b, dx, STEP_HEIGHT, dz, &r1)
    var e: mc_math.Aabb = *b
    e.x0 = e.x0 + math.fmin(dx, 0.0)
    e.x1 = e.x1 + math.fmax(dx, 0.0)
    e.z0 = e.z0 + math.fmin(dz, 0.0)
    e.z1 = e.z1 + math.fmax(dz, 0.0)
    var r2: mc_math.MoveResult = mc_math.MoveResult { dx: 0.0, dy: 0.0, dz: 0.0, hit_x: false, hit_y: false, hit_z: false }
    mc_math.grid_move(g, &e, 0.0, STEP_HEIGHT, 0.0, &r2)
    var sx: f64 = r1.dx
    var sy: f64 = r1.dy
    var sz: f64 = r1.dz
    if r2.dy < STEP_HEIGHT {
        var m: mc_math.Aabb = *b
        m.y0 = m.y0 + r2.dy
        m.y1 = m.y1 + r2.dy
        var r3: mc_math.MoveResult = mc_math.MoveResult { dx: 0.0, dy: 0.0, dz: 0.0, hit_x: false, hit_y: false, hit_z: false }
        mc_math.grid_move(g, &m, dx, 0.0, dz, &r3)
        if r3.dx * r3.dx + r3.dz * r3.dz > sx * sx + sz * sz {
            sx = r3.dx
            sy = r2.dy
            sz = r3.dz
        }
    }
    if sx * sx + sz * sz > (*out).dx * (*out).dx + (*out).dz * (*out).dz {
        var m2: mc_math.Aabb = *b
        m2.x0 = m2.x0 + sx
        m2.x1 = m2.x1 + sx
        m2.y0 = m2.y0 + sy
        m2.y1 = m2.y1 + sy
        m2.z0 = m2.z0 + sz
        m2.z1 = m2.z1 + sz
        var r4: mc_math.MoveResult = mc_math.MoveResult { dx: 0.0, dy: 0.0, dz: 0.0, hit_x: false, hit_y: false, hit_z: false }
        mc_math.grid_move(g, &m2, 0.0, dy - sy, 0.0, &r4)
        (*out).dx = sx
        (*out).dy = sy + r4.dy
        (*out).dz = sz
        (*out).hit_x = dx != sx
        (*out).hit_z = dz != sz
        (*out).hit_y = dy != (*out).dy
    }
}

// ---- slowdown blocks (vanilla 1.20.1). Speed factor (Entity.getBlockSpeedFactor): soul sand and honey block 0.4, looked up at the block the feet
// are in, else the block 0.500001 below the feet; vanilla multiplies the velocity by it after every move. This model has no horizontal inertia
// (instant speed = the steady state of velocity = velocity * 0.546 + acceleration), so the steady state of velocity = velocity * 0.546 * f + a
// is used instead: speed_ratio(f) = (1 - 0.546) / (1 - 0.546 * f) = 0.581 for f = 0.4 (NOT 0.4). Jump factor (LivingEntity.getBlockJumpFactor):
// honey block 0.5 (jump velocity 0.42 * 0.5). Stuck (Entity.makeStuckInBlock, from checkInsideBlocks at the end of a move, used by the next
// move): cobweb (0.25, 0.05, 0.25), sweet berry bush (0.8, 0.75, 0.8); the whole velocity is zeroed, so the move is only the acceleration of
// this tick (ground 0.454 * speed, air 0.0196 / sprinting 0.02548) times the multiplier, and the fall distance is reset. Honey block wall slide
// (HoneyBlock.isSlidingDown / doSlideMovement): in the air, below the block top, falling faster than 0.08, touching the side of a honey
// block -> vy = -0.05, fall distance reset. Not modelled: flying (no factor / stuck), powder snow, fall damage, sounds.
const STUCK_WEB_Y: f64 = 0.05000000074505806
const BELOW: f64 = 0.500001

fn kind_speed(k: i32) -> f64 {
    if k == mc_math.MV_SOUL_SAND || k == mc_math.MV_HONEY { return 0.4f as f64 }
    return 1.0
}

fn kind_jump(k: i32) -> f64 {
    if k == mc_math.MV_HONEY { return 0.5 }
    return 1.0
}

// factor of the block the feet are in, else of the block below (jump = false: speed factor, true: jump factor)
fn block_factor(p: *mut Player, v: *mut mc_world_view.WorldView, jump: bool) -> f64 {
    let fx: i32 = math.floor((*p).x) as i32
    let fz: i32 = math.floor((*p).z) as i32
    let k0: i32 = mc_world_view.view_kind(v, (*p).mv, fx, math.floor((*p).y) as i32, fz)
    var f: f64 = kind_speed(k0)
    if jump { f = kind_jump(k0) }
    if f != 1.0 { return f }
    let k1: i32 = mc_world_view.view_kind(v, (*p).mv, fx, math.floor((*p).y - BELOW) as i32, fz)
    if jump { return kind_jump(k1) }
    return kind_speed(k1)
}

// vanilla Entity.checkInsideBlocks at the end of a move: cobweb / berry bush set `stuck`, a honey block may start the wall slide
fn check_inside(p: *mut Player, v: *mut mc_world_view.WorldView, h: f64) {
    let x0: i32 = math.floor((*p).x - 0.3 + 0.0000001) as i32
    let x1: i32 = math.floor((*p).x + 0.3 - 0.0000001) as i32
    let y0: i32 = math.floor((*p).y + 0.0000001) as i32
    let y1: i32 = math.floor((*p).y + h - 0.0000001) as i32
    let z0: i32 = math.floor((*p).z - 0.3 + 0.0000001) as i32
    let z1: i32 = math.floor((*p).z + 0.3 - 0.0000001) as i32
    var cz: i32 = z0
    while cz <= z1 {
        var cy: i32 = y0
        while cy <= y1 {
            var cx: i32 = x0
            while cx <= x1 {
                let k: i32 = mc_world_view.view_kind(v, (*p).mv, cx, cy, cz)
                if k == mc_math.MV_COBWEB {
                    (*p).stuck = 1
                    (*p).fall = 0.0
                } else if k == mc_math.MV_BERRY {
                    (*p).stuck = 2
                    (*p).fall = 0.0
                } else if k == mc_math.MV_HONEY && honey_sliding(p, cx, cy, cz) {
                    (*p).vy = -0.05
                    (*p).fall = 0.0
                }
                cx = cx + 1
            }
            cy = cy + 1
        }
        cz = cz + 1
    }
}

// vanilla HoneyBlock.isSlidingDown for the honey block at (cx, cy, cz)
fn honey_sliding(p: *mut Player, cx: i32, cy: i32, cz: i32) -> bool {
    if (*p).on_ground { return false }
    if (*p).y > (cy as f64) + 0.9375 - 0.0000001 { return false }
    if (*p).vy >= -0.08 { return false }
    let d0: f64 = math.fabs((cx as f64) + 0.5 - (*p).x)
    let d1: f64 = math.fabs((cz as f64) + 0.5 - (*p).z)
    let d2: f64 = 0.4375 + 0.3
    return d0 + 0.0000001 > d2 || d1 + 0.0000001 > d2
}

// ---- sneak edge (vanilla Player.maybeBackOffFromEdge): a sneaking player on the ground does not walk off a ledge. The horizontal move
// is cut in 0.05 steps while the box moved by (dx, -stepHeight, dz) would collide with nothing (no floor within stepHeight below).

// vanilla Level.noCollision(entity, box.move(dx, dy, dz))
fn moved_free(g: *mut mc_math.BlockGrid, b: *mut mc_math.Aabb, dx: f64, dy: f64, dz: f64) -> bool {
    var m: mc_math.Aabb = *b
    m.x0 = m.x0 + dx
    m.x1 = m.x1 + dx
    m.y0 = m.y0 + dy
    m.y1 = m.y1 + dy
    m.z0 = m.z0 + dz
    m.z1 = m.z1 + dz
    return !mc_math.grid_overlaps(g, &m)
}

// vanilla Player.isAboveGround: on the ground, or less than stepHeight into a fall with a floor within stepHeight below
fn above_ground(g: *mut mc_math.BlockGrid, b: *mut mc_math.Aabb, on_ground: bool, fall: f64) -> bool {
    if on_ground { return true }
    return fall < STEP_HEIGHT && !moved_free(g, b, 0.0, fall - STEP_HEIGHT, 0.0)
}

fn edge_shrink(d: f64) -> f64 {
    if d < 0.05 && d >= -0.05 { return 0.0 }
    if d > 0.0 { return d - 0.05 }
    return d + 0.05
}

// (dx, dz) after the edge clamp: x alone, z alone, then both together (exactly vanilla's three loops).
fn sneak_edge(g: *mut mc_math.BlockGrid, b: *mut mc_math.Aabb, dx: f64, dz: f64, ox: *mut f64, oz: *mut f64) {
    var d0: f64 = dx
    var d1: f64 = dz
    while d0 != 0.0 && moved_free(g, b, d0, 0.0 - STEP_HEIGHT, 0.0) { d0 = edge_shrink(d0) }
    while d1 != 0.0 && moved_free(g, b, 0.0, 0.0 - STEP_HEIGHT, d1) { d1 = edge_shrink(d1) }
    while d0 != 0.0 && d1 != 0.0 && moved_free(g, b, d0, 0.0 - STEP_HEIGHT, d1) {
        d0 = edge_shrink(d0)
        d1 = edge_shrink(d1)
    }
    *ox = d0
    *oz = d1
}

fn apply_flow(p: *mut Player, v: *mut mc_world_view.WorldView, tb: *mut InputTables, h: f64, in_water: bool, in_lava: bool) {
    var s: mc_fluid_flow.FlowSolids = mc_fluid_flow.FlowSolids { solid: (*tb).solid, n: (*tb).n }
    if in_water { mc_fluid_flow.flow_push(v, (*p).mv, &s, (*p).x, (*p).y, (*p).z, h, false, &(*p).vx, &(*p).vy, &(*p).vz) }
    if in_lava { mc_fluid_flow.flow_push(v, (*p).mv, &s, (*p).x, (*p).y, (*p).z, h, true, &(*p).vx, &(*p).vy, &(*p).vz) }
}

fn fluid_velocity(p: *mut Player, wx: f64, wz: f64, jump: bool, swimming: bool, in_water: bool, in_lava: bool, depth: f64, head_wet: bool) {
    var a: f64 = mc_move_fluid.FLUID_ACCEL
    if (*p).sneaking { a = a * 0.3 }
    (*p).vx = (*p).vx + wx * a
    (*p).vz = (*p).vz + wz * a
    if jump {
        if !(*p).on_ground || depth > mc_move_fluid.FLUID_SHALLOW {
            (*p).vy = (*p).vy + mc_move_fluid.FLUID_JUMP
        } else if (*p).on_ground {
            (*p).vy = 0.42
        }
    }
    if (*p).sneaking && in_water && !in_lava { (*p).vy = (*p).vy - mc_move_fluid.FLUID_JUMP }
    if swimming {
        let pr: f64 = (*p).pitch * (math.PI() / 180.0)
        mc_move_fluid.swim_boost(&(*p).vy, 0.0 - math.sin(pr), jump, head_wet)
    }
}

fn landing_vy(p: *mut Player, v: *mut mc_world_view.WorldView) -> f64 {
    let fx: i32 = math.floor((*p).x) as i32
    let fz: i32 = math.floor((*p).z) as i32
    let k: i32 = mc_world_view.view_kind(v, (*p).mv, fx, math.floor((*p).y - BELOW) as i32, fz)
    return mc_bounce.landed_vy(k, (*p).vy, (*p).sneaking, true)
}

fn ground_friction(p: *mut Player, v: *mut mc_world_view.WorldView) -> f64 {
    if !(*p).on_ground { return mc_slide.MU_DEFAULT }
    let fx: i32 = math.floor((*p).x) as i32
    let fz: i32 = math.floor((*p).z) as i32
    return mc_slide.kind_friction(mc_world_view.view_kind(v, (*p).mv, fx, math.floor((*p).y - BELOW) as i32, fz))
}

fn fluid_after_move(p: *mut Player, g: *mut mc_math.BlockGrid, b: *mut mc_math.Aabb, res: *mut mc_math.MoveResult, lava: bool, shallow: bool, swimming: bool, climb: bool) {
    let hit: bool = (*res).hit_x || (*res).hit_z
    if hit && climb { (*p).vy = mc_move_fluid.CLIMB_UP }
    mc_move_fluid.fluid_drag(lava, swimming, shallow, &(*p).vx, &(*p).vy, &(*p).vz)
    if hit {
        var m: mc_math.Aabb = *b
        m.x0 = m.x0 + (*res).dx
        m.x1 = m.x1 + (*res).dx
        m.y0 = m.y0 + (*res).dy
        m.y1 = m.y1 + (*res).dy
        m.z0 = m.z0 + (*res).dz
        m.z1 = m.z1 + (*res).dz
        if moved_free(g, &m, (*p).vx, (*p).vy + mc_move_fluid.LEDGE_LIFT - (*res).dy, (*p).vz) { (*p).vy = mc_move_fluid.EXIT_BOOST }
    }
}

fn update_sprint(p: *mut Player, keys: u32, fwd_now: bool, enough_now: bool, slow: bool, in_water: bool, eye_water: bool, hcol_stop: bool) {
    let sprint_key: bool = (keys & K_SPRINT) != 0 as u32
    let sneak_key: bool = (keys & K_SNEAK) != 0 as u32
    if (*p).sprint_trigger > 0 { (*p).sprint_trigger = (*p).sprint_trigger - 1 }
    let can: bool = (*p).can_sprint && !(*p).using_item
    if ((*p).on_ground || eye_water) && !(*p).sneak_prev && !(*p).enough_prev && enough_now && !(*p).sprinting && can {
        if (*p).sprint_trigger <= 0 && !sprint_key { (*p).sprint_trigger = mc_phys.SPRINT_TAP_TICKS } else { (*p).sprinting = true }
    }
    if !(*p).sprinting && (!in_water || eye_water) && enough_now && can && sprint_key { (*p).sprinting = true }
    if (*p).sprinting {
        let stop_base: bool = !fwd_now || !(*p).can_sprint
        let stop: bool = stop_base || hcol_stop || (in_water && !eye_water) || slow || (*p).using_item
        if (*p).swimming {
            if (!(*p).on_ground && !sneak_key && stop_base) || !in_water { (*p).sprinting = false }
        } else if stop {
            (*p).sprinting = false
        }
    }
    if sneak_key && !(*p).flying { (*p).sprinting = false }
    (*p).enough_prev = enough_now
    (*p).sneak_prev = sneak_key
}

fn start_jump(p: *mut Player, v: *mut mc_world_view.WorldView) {
    (*p).vy = mc_phys.jump_power(block_factor(p, v, true) as f32, (*p).jump_boost)
    if (*p).sprinting { mc_phys.sprint_jump_boost(&(*p).vx, &(*p).vz, (*p).yaw) }
    (*p).jump_delay = mc_phys.JUMP_DELAY_TICKS
}

fn horizontal_friction(p: *mut Player, v: *mut mc_world_view.WorldView) -> f32 {
    return ground_friction(p, v) as f32
}

// One game tick (20 Hz): key movement, gravity / fly, collision (vanilla LocalPlayer.aiStep + LivingEntity.travel + Entity.move order).
// `w` may be an empty world (everything unloaded = solid, so the player stands still in ground mode; use noclip / flying + noclip for a free camera).
fn player_tick(p: *mut Player, ev: *mut InputEvents, w: *mut mc_world.World, tb: *mut InputTables, min_y: i32) {
    if (*ev).toggle_fly {
        (*p).flying = !(*p).flying
        (*p).vy = 0.0
    }
    if (*ev).toggle_noclip { (*p).noclip = !(*p).noclip }
    if (*ev).slot_delta != 0 {
        (*p).slot = mc_world.floor_mod((*p).slot + (*ev).slot_delta, 9)
    }
    player_look(p, (*ev).dx, (*ev).dy)
    (*p).px = (*p).x
    (*p).py = (*p).y
    (*p).pz = (*p).z
    (*p).eye_prev = (*p).eye
    var v: mc_world_view.WorldView = mc_world_view.view_new(w, min_y)
    let keys: u32 = (*ev).keys
    (*p).sneaking = (keys & K_SNEAK) != 0 as u32
    let fwd: bool = (keys & K_FORWARD) != 0 as u32
    let h: f64 = player_height(p)
    var fp: mc_move_fluid.FluidProbe = mc_move_fluid.FluidProbe { water_h: 0.0, lava_h: 0.0, eye_water: false, head_wet: false, climb: false, scaffold: false }
    let physical: bool = !(*p).flying && !(*p).noclip
    if physical { mc_move_fluid.fluid_probe(&v, (*p).mv, (*p).x, (*p).y, (*p).z, h, player_eye(p), &fp) }
    let in_water: bool = fp.water_h > 0.0
    let in_lava: bool = fp.lava_h > 0.0
    let in_fluid: bool = in_water || in_lava
    (*p).wet = in_fluid
    let climbing: bool = fp.climb && !in_fluid
    let slowed: bool = crawl_slowed(p, in_fluid)
    let slow: bool = ((*p).sneaking && !(*p).flying) || slowed
    let raw_fwd: f32 = mc_phys.impulse_axis(fwd, (keys & K_BACK) != 0 as u32)
    let raw_left: f32 = mc_phys.impulse_axis((keys & K_LEFT) != 0 as u32, (keys & K_RIGHT) != 0 as u32)
    let strafe: f32 = mc_phys.scale_impulse(raw_left, slow, (*p).using_item)
    let forward: f32 = mc_phys.scale_impulse(raw_fwd, slow, (*p).using_item)
    let fwd_now: bool = raw_fwd > 0.00001f
    var pre_forward: f32 = raw_fwd
    if slow { pre_forward = pre_forward * 0.3f }
    let enough_now: bool = mc_phys.enough_impulse(pre_forward, fp.eye_water)
    let hcol_stop: bool = (*p).hcol && !(*p).minor
    update_sprint(p, keys, fwd_now, enough_now, slow, in_water, fp.eye_water, hcol_stop)
    let swimming: bool = (*p).sprinting && in_water && (fp.eye_water || (*p).swimming)
    (*p).swimming = swimming
    var mx: f64 = 0.0
    var mz: f64 = 0.0
    if (keys & K_RIGHT) != 0 as u32 { mx = mx + 1.0 }
    if (keys & K_LEFT) != 0 as u32 { mx = mx - 1.0 }
    if fwd { mz = mz + 1.0 }
    if (keys & K_BACK) != 0 as u32 { mz = mz - 1.0 }
    let yr: f64 = (*p).yaw * (math.PI() / 180.0)
    let sn: f64 = math.sin(yr)
    let cs: f64 = math.cos(yr)
    var wx: f64 = (0.0 - cs) * mx + (0.0 - sn) * mz
    var wz: f64 = (0.0 - sn) * mx + cs * mz
    if mx != 0.0 && mz != 0.0 {
        wx = wx * DIAG
        wz = wz * DIAG
    }
    let jump_key: bool = (keys & K_JUMP) != 0 as u32 || (*p).aj_jump
    (*p).aj_jump = false
    if (*p).jump_delay > 0 { (*p).jump_delay = (*p).jump_delay - 1 }
    if !jump_key { (*p).jump_delay = 0 }
    if (*p).noclip || (*p).flying {
        (*p).stuck = 0
    }
    if in_fluid {
        apply_flow(p, &v, tb, h, in_water, in_lava)
        fluid_velocity(p, wx, wz, jump_key, swimming, in_water, in_lava, fp.water_h + fp.lava_h, fp.head_wet)
    } else {
        (*p).vx = mc_phys.cutoff((*p).vx)
        (*p).vz = mc_phys.cutoff((*p).vz)
        (*p).vy = mc_phys.cutoff((*p).vy)
        if (*p).flying {
            var step: f64 = 0.0
            if (keys & K_JUMP) != 0 as u32 { step = step + 1.0 }
            if (*p).sneaking { step = step - 1.0 }
            (*p).vy = (*p).vy + step * ((mc_phys.FLY_BASE * mc_phys.FLY_VERTICAL_STEP) as f64)
        } else if jump_key && (*p).on_ground && (*p).jump_delay == 0 && !(*p).noclip {
            start_jump(p, &v)
        }
    }
    let was_ground: bool = (*p).on_ground
    var fric: f32 = 0.6f
    if !in_fluid && !(*p).noclip && was_ground { fric = horizontal_friction(p, &v) }
    if !in_fluid {
        var speed: f32 = mc_phys.air_speed((*p).sprinting)
        if (*p).flying || (*p).noclip {
            speed = mc_phys.fly_speed((*p).sprinting)
        } else if was_ground {
            speed = mc_phys.ground_speed((*p).sprinting, fric)
        }
        mc_phys.move_relative(&(*p).vx, &(*p).vz, strafe, forward, speed, (*p).yaw)
    }
    let stuck: i32 = (*p).stuck
    (*p).stuck = 0
    var dx: f64 = (*p).vx
    var dy: f64 = (*p).vy
    var dz: f64 = (*p).vz
    if climbing {
        mc_move_fluid.climb_clamp(&(*p).vx, &(*p).vy, &(*p).vz, (*p).sneaking && !fp.scaffold)
        dx = (*p).vx
        dy = (*p).vy
        dz = (*p).vz
        (*p).fall = 0.0
    }
    if stuck != 0 && !(*p).flying && !(*p).noclip && !in_fluid {
        var mxz: f64 = 0.25
        var myv: f64 = STUCK_WEB_Y
        if stuck == 2 {
            mxz = 0.8
            myv = 0.75
        }
        dx = dx * mxz
        dy = dy * myv
        dz = dz * mxz
        (*p).vx = 0.0
        (*p).vy = 0.0
        (*p).vz = 0.0
    }
    if (*p).noclip {
        (*p).low_pose = false
        (*p).crouched = false
        (*p).x = (*p).x + dx
        (*p).y = (*p).y + dy
        (*p).z = (*p).z + dz
        (*p).on_ground = false
        (*p).fall = 0.0
        (*p).hcol = false
        (*p).minor = false
        (*p).vx = (*p).vx * mc_phys.drag_h(false, 0.6f)
        (*p).vz = (*p).vz * mc_phys.drag_h(false, 0.6f)
        if (*p).flying { (*p).vy = (*p).vy * mc_phys.FLY_Y_DRAG } else { (*p).vy = mc_phys.gravity_step((*p).vy) }
        ease_eye(p)
        return
    }
    var g: mc_math.BlockGrid = mc_math.grid_view(0, 0, 0, 0, 0, 0, 0, 0, 0 as u32, false)
    snapshot(p, &v, tb, &g)
    var b: mc_math.Aabb = mc_math.Aabb { x0: (*p).x - 0.3, y0: (*p).y, z0: (*p).z - 0.3, x1: (*p).x + 0.3, y1: (*p).y + h, z1: (*p).z + 0.3 }
    var res: mc_math.MoveResult = mc_math.MoveResult { dx: 0.0, dy: 0.0, dz: 0.0, hit_x: false, hit_y: false, hit_z: false }
    var mdx: f64 = dx
    var mdz: f64 = dz
    if (*p).sneaking && !(*p).flying && !in_fluid && (dx != 0.0 || dz != 0.0) && above_ground(&g, &b, (*p).on_ground, (*p).fall) {
        sneak_edge(&g, &b, dx, dz, &mdx, &mdz)
    }
    move_step(&g, &b, mdx, dy, mdz, (*p).on_ground && !(*p).flying, &res)
    (*p).x = (*p).x + res.dx
    (*p).y = (*p).y + res.dy
    (*p).z = (*p).z + res.dz
    (*p).on_ground = res.hit_y && dy < 0.0
    pose_after(p, &g, swimming)
    (*p).hcol = res.hit_x || res.hit_z
    (*p).minor = (*p).hcol && mc_phys.minor_collision(strafe, forward, (*p).yaw, res.dx, res.dz)
    if res.hit_x && !in_fluid { (*p).vx = 0.0 }
    if res.hit_z && !in_fluid { (*p).vz = 0.0 }
    if (*p).on_ground || (*p).flying || in_fluid {
        (*p).fall = 0.0
    } else if res.dy < 0.0 {
        (*p).fall = (*p).fall - res.dy
    }
    var aj: bool = false
    if (*p).autojump && (*p).on_ground && !(*p).sneaking && !(*p).flying && (res.hit_x || res.hit_z) {
        aj = auto_jump_ok(&g, &b, dx, dz)
    }
    if (*p).flying {
        (*p).vy = dy * mc_phys.FLY_Y_DRAG
        (*p).vx = (*p).vx * mc_phys.drag_h(false, 0.6f)
        (*p).vz = (*p).vz * mc_phys.drag_h(false, 0.6f)
    } else if in_fluid {
        if res.hit_y { (*p).vy = 0.0 }
        if mc_move_fluid.bubble_effect(&v, (*p).mv, (*p).x, (*p).y, (*p).z, h, &(*p).vy) { (*p).fall = 0.0 }
        fluid_after_move(p, &g, &b, &res, in_lava, fp.lava_h + fp.water_h <= mc_move_fluid.FLUID_SHALLOW, in_water && (*p).sprinting, fp.climb)
    } else {
        if res.hit_y {
            if dy < 0.0 { (*p).vy = landing_vy(p, &v) } else { (*p).vy = 0.0 }
        }
        if climbing && (res.hit_x || res.hit_z || jump_key) { (*p).vy = mc_move_fluid.CLIMB_UP }
        if mc_move_fluid.bubble_effect(&v, (*p).mv, (*p).x, (*p).y, (*p).z, h, &(*p).vy) { (*p).fall = 0.0 }
        check_inside(p, &v, h)
        let sf: f64 = block_factor(p, &v, false)
        (*p).vx = (*p).vx * sf
        (*p).vz = (*p).vz * sf
        let drag: f64 = mc_phys.drag_h(was_ground, fric)
        (*p).vx = (*p).vx * drag
        (*p).vz = (*p).vz * drag
        (*p).vy = mc_phys.gravity_step((*p).vy)
        if aj { (*p).aj_jump = true }
    }
    ease_eye(p)
}

fn ease_eye(p: *mut Player) {
    (*p).eye = mc_phys.eye_smooth((*p).eye, player_eye(p))
}

// ---------------------------------------------------------------- picking

fn pick_hit(out: *mut Pick, x: i32, y: i32, z: i32, nx: i32, ny: i32, nz: i32, dist: f64, id: i32) {
    (*out).x = x
    (*out).y = y
    (*out).z = z
    (*out).nx = nx
    (*out).ny = ny
    (*out).nz = nz
    (*out).dist = dist
    (*out).id = id
}

// Voxel raycast over the world: first block with a non-zero `pick` entry that the ray o + t*d (d normalised, t in [0, reach])
// touches. Unloaded chunks count as air. An origin inside a pickable block is a hit at distance 0 with a zero normal.
fn input_pick(w: *mut mc_world.World, min_y: i32, tb: *mut InputTables, ox: f64, oy: f64, oz: f64, dx0: f64, dy0: f64, dz0: f64,
    reach: f64, out: *mut Pick) -> bool {
    let len: f64 = math.sqrt((dx0 * dx0 + dy0 * dy0) + dz0 * dz0)
    if !(len > 0.0) || !math.is_finite(len) { return false }
    if !math.is_finite(ox) || !math.is_finite(oy) || !math.is_finite(oz) || !(math.fabs(ox) < 1000000000.0)
    || !(math.fabs(oy) < 1000000000.0) || !(math.fabs(oz) < 1000000000.0) {
        return false
    }
    let dx: f64 = dx0 / len
    let dy: f64 = dy0 / len
    let dz: f64 = dz0 / len
    var v: mc_world_view.WorldView = mc_world_view.view_new(w, min_y)
    var cx: i32 = math.floor(ox) as i32
    var cy: i32 = math.floor(oy) as i32
    var cz: i32 = math.floor(oz) as i32
    var id: i32 = mc_world_view.view_id(&v, cx, cy, cz)
    if table_flag((*tb).pick, (*tb).n, id) {
        pick_hit(out, cx, cy, cz, 0, 0, 0, 0.0, id)
        return true
    }
    var sx: i32 = 0
    var sy: i32 = 0
    var sz: i32 = 0
    var tdx: f64 = math.INF()
    var tdy: f64 = math.INF()
    var tdz: f64 = math.INF()
    var tmx: f64 = math.INF()
    var tmy: f64 = math.INF()
    var tmz: f64 = math.INF()
    if dx > 0.0 {
        sx = 1
        tdx = 1.0 / dx
        tmx = ((cx + 1) as f64 - ox) / dx
    } else if dx < 0.0 {
        sx = -1
        tdx = -1.0 / dx
        tmx = (ox - cx as f64) / (0.0 - dx)
    }
    if dy > 0.0 {
        sy = 1
        tdy = 1.0 / dy
        tmy = ((cy + 1) as f64 - oy) / dy
    } else if dy < 0.0 {
        sy = -1
        tdy = -1.0 / dy
        tmy = (oy - cy as f64) / (0.0 - dy)
    }
    if dz > 0.0 {
        sz = 1
        tdz = 1.0 / dz
        tmz = ((cz + 1) as f64 - oz) / dz
    } else if dz < 0.0 {
        sz = -1
        tdz = -1.0 / dz
        tmz = (oz - cz as f64) / (0.0 - dz)
    }
    while true {
        var axis: i32 = 0
        var t: f64 = tmx
        if tmy < t {
            axis = 1
            t = tmy
        }
        if tmz < t {
            axis = 2
            t = tmz
        }
        if !(t <= reach) { return false }
        var nx: i32 = 0
        var ny: i32 = 0
        var nz: i32 = 0
        if axis == 0 {
            cx = cx + sx
            tmx = tmx + tdx
            nx = 0 - sx
        } else if axis == 1 {
            cy = cy + sy
            tmy = tmy + tdy
            ny = 0 - sy
        } else {
            cz = cz + sz
            tmz = tmz + tdz
            nz = 0 - sz
        }
        id = mc_world_view.view_id(&v, cx, cy, cz)
        if table_flag((*tb).pick, (*tb).n, id) {
            pick_hit(out, cx, cy, cz, nx, ny, nz, t, id)
            return true
        }
    }
    return false
}

// Pick along the view direction of an updated camera (origin = camera position).
fn input_pick_camera(w: *mut mc_world.World, min_y: i32, tb: *mut InputTables, cam: *mut mc_camera.Camera, reach: f64, out: *mut Pick) -> bool {
    return input_pick(w, min_y, tb, (*cam).x, (*cam).y, (*cam).z, (*cam).fx, (*cam).fy, (*cam).fz, reach, out)
}

// ---------------------------------------------------------------- selection box lines

fn floor_div64(a: i64, b: i64) -> i64 {
    var q: i64 = a / b
    if (a % b != 0 as i64) && ((a < 0 as i64) != (b < 0 as i64)) { q = q - 1 as i64 }
    return q
}

// one 3D line (world coordinates) into the colour buffer: near clip, project, snap to 1/16 pixel, integer DDA over the pixel cells,
// pixel written when 1/z * 1.002 > stored 1/z (depth is not written).
fn draw_line3(r: *mut mc_raster.Raster, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, rgba: u32) {
    draw_line3_b(r, ax, ay, az, bx, by, bz, rgba, 1.002, 0.0)
}

// Depth stored by the raster at pixel idx (1/z, 0 = nothing drawn).
fn depth_at(r: *mut mc_raster.Raster, idx: usize) -> f64 {
    return *(((*r).depth + (idx as u64) * (8 as u64)) as *mut f64)
}

// Slope-scaled depth bias (r253): the line pixel is snapped to the pixel grid, so the surface it lies on can be up to half a pixel away; on a face seen
// at a grazing angle 1/z changes by several percent per pixel and a flat 0.2 % bias z-fights. The largest 1/z step to the 4 neighbours (capped at 4 %
// of the stored depth, so a line behind the edge of a nearer object stays hidden) scales the extra bias.
fn depth_slope(r: *mut mc_raster.Raster, px: i64, py: i64, d: f64) -> f64 {
    let w: i64 = (*r).w as i64
    let h: i64 = (*r).h as i64
    var g: f64 = 0.0
    if px > 0 as i64 {
        let n: f64 = math.fabs(d - depth_at(r, ((py * w + px - 1 as i64) as usize)))
        if n > g { g = n }
    }
    if px + 1 as i64 < w {
        let n: f64 = math.fabs(d - depth_at(r, ((py * w + px + 1 as i64) as usize)))
        if n > g { g = n }
    }
    if py > 0 as i64 {
        let n: f64 = math.fabs(d - depth_at(r, (((py - 1 as i64) * w + px) as usize)))
        if n > g { g = n }
    }
    if py + 1 as i64 < h {
        let n: f64 = math.fabs(d - depth_at(r, (((py + 1 as i64) * w + px) as usize)))
        if n > g { g = n }
    }
    let cap: f64 = d * 0.04
    if g > cap { g = cap }
    return g
}

// draw_line3 with a configurable depth test: pixel written when iz * bias + slope * (local 1/z step) > stored 1/z.
fn draw_line3_b(r: *mut mc_raster.Raster, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64, rgba: u32, bias: f64, slope: f64) {
    let rax: f64 = ax - (*r).cx
    let ray: f64 = ay - (*r).cy
    let raz: f64 = az - (*r).cz
    let rbx: f64 = bx - (*r).cx
    let rby: f64 = by - (*r).cy
    let rbz: f64 = bz - (*r).cz
    var x0: f64 = (rax * (*r).rx + ray * (*r).ry) + raz * (*r).rz
    var y0: f64 = (rax * (*r).ux + ray * (*r).uy) + raz * (*r).uz
    var z0: f64 = (rax * (*r).fx + ray * (*r).fy) + raz * (*r).fz
    var x1: f64 = (rbx * (*r).rx + rby * (*r).ry) + rbz * (*r).rz
    var y1: f64 = (rbx * (*r).ux + rby * (*r).uy) + rbz * (*r).uz
    var z1: f64 = (rbx * (*r).fx + rby * (*r).fy) + rbz * (*r).fz
    let near: f64 = (*r).near
    if z0 < near && z1 < near { return }
    if z0 < near {
        let t: f64 = (near - z0) / (z1 - z0)
        x0 = x0 + (x1 - x0) * t
        y0 = y0 + (y1 - y0) * t
        z0 = near
    } else if z1 < near {
        let t: f64 = (near - z1) / (z0 - z1)
        x1 = x1 + (x0 - x1) * t
        y1 = y1 + (y0 - y1) * t
        z1 = near
    }
    let iz0: f64 = 1.0 / z0
    let iz1: f64 = 1.0 / z1
    let sx0: f64 = (*r).hw + (x0 * iz0) * (*r).fpx
    let sy0: f64 = (*r).hh - (y0 * iz0) * (*r).fpy
    let sx1: f64 = (*r).hw + (x1 * iz1) * (*r).fpx
    let sy1: f64 = (*r).hh - (y1 * iz1) * (*r).fpy
    let lim: f64 = 100000.0
    if !(math.fabs(sx0) < lim && math.fabs(sy0) < lim && math.fabs(sx1) < lim && math.fabs(sy1) < lim) { return }
    let px0: i64 = floor_div64(math.floor(sx0 * 16.0 + 0.5) as i64, 16 as i64)
    let py0: i64 = floor_div64(math.floor(sy0 * 16.0 + 0.5) as i64, 16 as i64)
    let px1: i64 = floor_div64(math.floor(sx1 * 16.0 + 0.5) as i64, 16 as i64)
    let py1: i64 = floor_div64(math.floor(sy1 * 16.0 + 0.5) as i64, 16 as i64)
    let ddx: i64 = px1 - px0
    let ddy: i64 = py1 - py0
    var adx: i64 = ddx
    if adx < 0 as i64 { adx = 0 as i64 - adx }
    var ady: i64 = ddy
    if ady < 0 as i64 { ady = 0 as i64 - ady }
    var n: i64 = adx
    if ady > n { n = ady }
    let w: i64 = (*r).w as i64
    let h: i64 = (*r).h as i64
    var i: i64 = 0
    while i <= n {
        var px: i64 = px0
        var py: i64 = py0
        var t: f64 = 0.0
        if n > 0 as i64 {
            px = px0 + floor_div64(2 as i64 * ddx * i + n, 2 as i64 * n)
            py = py0 + floor_div64(2 as i64 * ddy * i + n, 2 as i64 * n)
            t = (i as f64) / (n as f64)
        }
        if px >= 0 as i64 && py >= 0 as i64 && px < w && py < h {
            let iz: f64 = iz0 + (iz1 - iz0) * t
            let idx: usize = (py as usize) * (w as usize) + (px as usize)
            let d: f64 = depth_at(r, idx)
            var extra: f64 = 0.0
            if slope > 0.0 && d > 0.0 { extra = slope * depth_slope(r, px, py, d) }
            if iz * bias + extra > d { rt.st32((*r).color, idx, rgba) }
        }
        i = i + 1 as i64
    }
}

// The 12 edges of block (x, y, z), grown by 0.002 on every side (against z-fighting with the block faces).
fn input_draw_box(r: *mut mc_raster.Raster, x: i32, y: i32, z: i32, rgba: u32) {
    let e: f64 = 0.002
    let x0: f64 = (x as f64) - e
    let y0: f64 = (y as f64) - e
    let z0: f64 = (z as f64) - e
    let x1: f64 = (x as f64) + 1.0 + e
    let y1: f64 = (y as f64) + 1.0 + e
    let z1: f64 = (z as f64) + 1.0 + e
    // bottom ring, top ring, 4 verticals
    draw_line3(r, x0, y0, z0, x1, y0, z0, rgba)
    draw_line3(r, x1, y0, z0, x1, y0, z1, rgba)
    draw_line3(r, x1, y0, z1, x0, y0, z1, rgba)
    draw_line3(r, x0, y0, z1, x0, y0, z0, rgba)
    draw_line3(r, x0, y1, z0, x1, y1, z0, rgba)
    draw_line3(r, x1, y1, z0, x1, y1, z1, rgba)
    draw_line3(r, x1, y1, z1, x0, y1, z1, rgba)
    draw_line3(r, x0, y1, z1, x0, y1, z0, rgba)
    draw_line3(r, x0, y0, z0, x0, y1, z0, rgba)
    draw_line3(r, x1, y0, z0, x1, y1, z0, rgba)
    draw_line3(r, x1, y0, z1, x1, y1, z1, rgba)
    draw_line3(r, x0, y0, z1, x0, y1, z1, rgba)
}

// The 12 edges of an axis box (world coordinates), grown by 0.002 on every side: the selection box of a pack model (mc_model_pick).
fn input_draw_aabb(r: *mut mc_raster.Raster, bx0: f64, by0: f64, bz0: f64, bx1: f64, by1: f64, bz1: f64, rgba: u32) {
    input_draw_aabb_b(r, bx0, by0, bz0, bx1, by1, bz1, rgba, 1.002, 0.75)
}

// input_draw_aabb with an explicit depth test (see draw_line3_b); the default uses the slope-scaled bias against z-fighting with the model faces.
fn input_draw_aabb_b(r: *mut mc_raster.Raster, bx0: f64, by0: f64, bz0: f64, bx1: f64, by1: f64, bz1: f64, rgba: u32, bias: f64, slope: f64) {
    let e: f64 = 0.002
    let x0: f64 = bx0 - e
    let y0: f64 = by0 - e
    let z0: f64 = bz0 - e
    let x1: f64 = bx1 + e
    let y1: f64 = by1 + e
    let z1: f64 = bz1 + e
    draw_line3_b(r, x0, y0, z0, x1, y0, z0, rgba, bias, slope)
    draw_line3_b(r, x1, y0, z0, x1, y0, z1, rgba, bias, slope)
    draw_line3_b(r, x1, y0, z1, x0, y0, z1, rgba, bias, slope)
    draw_line3_b(r, x0, y0, z1, x0, y0, z0, rgba, bias, slope)
    draw_line3_b(r, x0, y1, z0, x1, y1, z0, rgba, bias, slope)
    draw_line3_b(r, x1, y1, z0, x1, y1, z1, rgba, bias, slope)
    draw_line3_b(r, x1, y1, z1, x0, y1, z1, rgba, bias, slope)
    draw_line3_b(r, x0, y1, z1, x0, y1, z0, rgba, bias, slope)
    draw_line3_b(r, x0, y0, z0, x0, y1, z0, rgba, bias, slope)
    draw_line3_b(r, x1, y0, z0, x1, y1, z0, rgba, bias, slope)
    draw_line3_b(r, x1, y0, z1, x1, y1, z1, rgba, bias, slope)
    draw_line3_b(r, x0, y0, z1, x0, y1, z1, rgba, bias, slope)
}
