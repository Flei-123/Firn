import std.rt

export {
    rules_mask, rules_hidden, rules_bit, rules_search_text,
    TAB_BUILDING, TAB_COLORED, TAB_NATURAL, TAB_FUNCTIONAL, TAB_REDSTONE, TAB_SEARCH, TAB_TOOLS, TAB_COMBAT, TAB_FOOD, TAB_INGREDIENTS, TAB_SPAWN, TAB_INVENTORY, TAB_COUNT,
}

const TAB_BUILDING: i32 = 0
const TAB_COLORED: i32 = 1
const TAB_NATURAL: i32 = 2
const TAB_FUNCTIONAL: i32 = 3
const TAB_REDSTONE: i32 = 4
const TAB_SEARCH: i32 = 5
const TAB_TOOLS: i32 = 6
const TAB_COMBAT: i32 = 7
const TAB_FOOD: i32 = 8
const TAB_INGREDIENTS: i32 = 9
const TAB_SPAWN: i32 = 10
const TAB_INVENTORY: i32 = 11
const TAB_COUNT: i32 = 12

const MODE_EXACT: i32 = 0
const MODE_PREFIX: i32 = 1
const MODE_SUFFIX: i32 = 2

const HIDDEN_EXACT: str = "air barrier light structure_void structure_block jigsaw command_block chain_command_block repeating_command_block command_block_minecart knowledge_book debug_stick spawner bedrock petrified_oak_slab farmland end_portal_frame reinforced_deepslate budding_amethyst written_book filled_map tipped_arrow chorus_plant"
const HIDDEN_PREFIX: str = "infested_"

const COLORS: str = "white orange magenta light_blue yellow lime pink gray light_gray cyan purple blue brown green red black"
const COLORED_REST: str = "wool carpet terracotta glazed_terracotta concrete concrete_powder stained_glass stained_glass_pane bed candle banner shulker_box"
const COLORED_EXACT: str = "terracotta shulker_box candle"

const BUILDING_EXACT: str = "stone granite andesite diorite deepslate tuff calcite"
const BUILDING_SUFFIX: str = "_door _trapdoor _fence_gate"

const NATURAL_EXACT: str = "dirt grass_block podzol mycelium coarse_dirt rooted_dirt mud muddy_mangrove_roots sand red_sand gravel clay moss_block moss_carpet stone granite andesite diorite deepslate tuff calcite dripstone_block pointed_dripstone amethyst_block small_amethyst_bud medium_amethyst_bud large_amethyst_bud amethyst_cluster netherrack soul_sand soul_soil basalt smooth_basalt blackstone crimson_nylium warped_nylium nether_wart_block warped_wart_block shroomlight obsidian crying_obsidian end_stone ice packed_ice blue_ice snow snow_block sponge wet_sponge hay_block pumpkin melon cactus sugar_cane bamboo kelp seagrass sea_pickle lily_pad vine glow_lichen sculk sculk_vein sculk_catalyst sculk_shrieker cobweb grass short_grass fern tall_grass large_fern dead_bush dandelion poppy blue_orchid allium azure_bluet red_tulip orange_tulip white_tulip pink_tulip oxeye_daisy cornflower lily_of_the_valley wither_rose sunflower lilac rose_bush peony torchflower pitcher_plant spore_blossom azalea flowering_azalea chorus_flower brown_mushroom red_mushroom crimson_fungus warped_fungus crimson_roots warped_roots nether_sprouts weeping_vines twisting_vines big_dripleaf small_dripleaf hanging_roots mangrove_roots turtle_egg sniffer_egg frogspawn dragon_egg ancient_debris bone_block magma_block"
const NATURAL_SUFFIX: str = "_ore _log _wood _leaves _sapling _propagule _stem _hyphae _coral _coral_fan _coral_block _mushroom_block"

const FUNCTIONAL_EXACT: str = "torch soul_torch lantern soul_lantern campfire soul_campfire crafting_table furnace blast_furnace smoker anvil chipped_anvil damaged_anvil grindstone stonecutter loom cartography_table fletching_table smithing_table brewing_stand cauldron enchanting_table bookshelf chiseled_bookshelf lectern composter barrel chest ender_chest beacon conduit item_frame glow_item_frame painting armor_stand flower_pot decorated_pot ladder scaffolding bell respawn_anchor lodestone end_crystal jukebox note_block chain jack_o_lantern shulker_box"
const FUNCTIONAL_SUFFIX: str = "_sign _hanging_sign _head _skull"

const REDSTONE_EXACT: str = "redstone redstone_block redstone_torch redstone_lamp repeater comparator piston sticky_piston observer hopper dispenser dropper lever tripwire_hook target daylight_detector note_block jukebox tnt rail powered_rail detector_rail activator_rail slime_block honey_block lightning_rod sculk_sensor calibrated_sculk_sensor trapped_chest bell lectern crafter"
const REDSTONE_SUFFIX: str = "_button _pressure_plate _door _trapdoor _fence_gate"

const TOOLS_EXACT: str = "shears flint_and_steel fishing_rod carrot_on_a_stick warped_fungus_on_a_stick compass recovery_compass clock spyglass lead name_tag saddle elytra brush map firework_rocket minecart goat_horn ender_pearl ender_eye experience_bottle writable_book egg snowball enchanted_book"
const TOOLS_SUFFIX: str = "_pickaxe _shovel _hoe _axe _bucket _minecart _boat _chest_boat _raft"
const TOOLS_PREFIX: str = "music_disc_"

const COMBAT_EXACT: str = "bow crossbow arrow spectral_arrow trident shield totem_of_undying"
const COMBAT_SUFFIX: str = "_sword _axe _helmet _chestplate _leggings _boots _horse_armor"

const FOOD_EXACT: str = "apple golden_apple enchanted_golden_apple melon_slice glistering_melon_slice sweet_berries glow_berries chorus_fruit carrot golden_carrot potato baked_potato poisonous_potato beetroot beetroot_soup bread cookie cake pumpkin_pie rabbit_stew mushroom_stew suspicious_stew milk_bucket honey_bottle dried_kelp beef porkchop mutton chicken rabbit cod salmon tropical_fish pufferfish rotten_flesh spider_eye potion splash_potion lingering_potion"
const FOOD_PREFIX: str = "cooked_"

const INGREDIENTS_EXACT: str = "coal charcoal diamond emerald lapis_lazuli quartz amethyst_shard raw_iron raw_copper raw_gold netherite_scrap stick string feather flint leather rabbit_hide rabbit_foot bone bone_meal paper book sugar gunpowder blaze_rod blaze_powder ghast_tear ender_pearl ender_eye slime_ball magma_cream nether_star prismarine_shard prismarine_crystals phantom_membrane nautilus_shell heart_of_the_sea scute turtle_scute armadillo_scute clay_ball brick nether_brick glowstone_dust fermented_spider_eye glass_bottle honeycomb ink_sac glow_ink_sac wheat wheat_seeds melon_seeds pumpkin_seeds beetroot_seeds torchflower_seeds pitcher_pod firework_star echo_shard disc_fragment_5 redstone cocoa_beans nether_wart dragon_breath spider_eye"
const INGREDIENTS_SUFFIX: str = "_ingot _nugget _dye _pottery_sherd _smithing_template"

const SPAWN_SUFFIX: str = "_spawn_egg"

fn rules_bit(tab: i32) -> u32 {
    var b: u32 = 1 as u32
    var i: i32 = 0
    while i < tab {
        b = b * 2 as u32
        i = i + 1
    }
    return b
}

fn match_at(p: u64, n: usize, lp: u64, from: usize, to: usize, mode: i32) -> bool {
    let w: usize = to - from
    if w == 0 { return false }
    if mode == MODE_EXACT {
        if n != w { return false }
    } else if w > n {
        return false
    }
    var off: usize = 0
    if mode == MODE_SUFFIX { off = n - w }
    var i: usize = 0
    while i < w {
        if rt.ld8(p, off + i) != rt.ld8(lp, from + i) { return false }
        i = i + 1
    }
    return true
}

fn in_list(p: u64, n: usize, list: str, mode: i32) -> bool {
    let lp: u64 = list.p as u64
    let ln: usize = list.n
    var s: usize = 0
    var i: usize = 0
    while i <= ln {
        if i == ln || rt.ld8(lp, i) == 32 as u8 {
            if match_at(p, n, lp, s, i, mode) { return true }
            s = i + 1
        }
        i = i + 1
    }
    return false
}

fn color_rest(p: u64, n: usize) -> usize {
    let lp: u64 = COLORS.p as u64
    let ln: usize = COLORS.n
    var s: usize = 0
    var i: usize = 0
    while i <= ln {
        if i == ln || rt.ld8(lp, i) == 32 as u8 {
            let w: usize = i - s
            if w > 0 && n > w + 1 && rt.ld8(p, w) == 95 as u8 && match_at(p, w, lp, s, i, MODE_EXACT) { return w + 1 }
            s = i + 1
        }
        i = i + 1
    }
    return 0
}

fn colored(p: u64, n: usize) -> bool {
    if in_list(p, n, COLORED_EXACT, MODE_EXACT) { return true }
    let rest: usize = color_rest(p, n)
    if rest == 0 { return false }
    return in_list(p + rest as u64, n - rest, COLORED_REST, MODE_EXACT)
}

fn rules_hidden(p: u64, n: usize) -> bool {
    if in_list(p, n, HIDDEN_EXACT, MODE_EXACT) { return true }
    return in_list(p, n, HIDDEN_PREFIX, MODE_PREFIX)
}

fn add(m: u32, tab: i32, hit: bool) -> u32 {
    if hit { return m | rules_bit(tab) }
    return m
}

fn rules_mask(p: u64, n: usize, is_block: bool) -> u32 {
    if rules_hidden(p, n) { return 0 as u32 }
    var m: u32 = 0 as u32
    m = add(m, TAB_SPAWN, in_list(p, n, SPAWN_SUFFIX, MODE_SUFFIX))
    m = add(m, TAB_COLORED, colored(p, n))
    m = add(m, TAB_BUILDING, in_list(p, n, BUILDING_EXACT, MODE_EXACT) || in_list(p, n, BUILDING_SUFFIX, MODE_SUFFIX))
    m = add(m, TAB_NATURAL, in_list(p, n, NATURAL_EXACT, MODE_EXACT) || in_list(p, n, NATURAL_SUFFIX, MODE_SUFFIX))
    m = add(m, TAB_FUNCTIONAL, in_list(p, n, FUNCTIONAL_EXACT, MODE_EXACT) || in_list(p, n, FUNCTIONAL_SUFFIX, MODE_SUFFIX))
    m = add(m, TAB_REDSTONE, in_list(p, n, REDSTONE_EXACT, MODE_EXACT) || in_list(p, n, REDSTONE_SUFFIX, MODE_SUFFIX))
    m = add(m, TAB_TOOLS, in_list(p, n, TOOLS_EXACT, MODE_EXACT) || in_list(p, n, TOOLS_SUFFIX, MODE_SUFFIX) || in_list(p, n, TOOLS_PREFIX, MODE_PREFIX))
    m = add(m, TAB_COMBAT, in_list(p, n, COMBAT_EXACT, MODE_EXACT) || in_list(p, n, COMBAT_SUFFIX, MODE_SUFFIX))
    m = add(m, TAB_FOOD, in_list(p, n, FOOD_EXACT, MODE_EXACT) || in_list(p, n, FOOD_PREFIX, MODE_PREFIX))
    m = add(m, TAB_INGREDIENTS, in_list(p, n, INGREDIENTS_EXACT, MODE_EXACT) || in_list(p, n, INGREDIENTS_SUFFIX, MODE_SUFFIX))
    if m == 0 as u32 {
        if is_block { m = rules_bit(TAB_BUILDING) } else { m = rules_bit(TAB_INGREDIENTS) }
    }
    return m
}

fn rules_search_text(p: u64, n: usize, out: *mut rt.Buf) {
    var i: usize = 0
    while i < n {
        var ch: u8 = rt.ld8(p, i)
        if ch == 95 as u8 { ch = 32 as u8 }
        rt.buf_push(out, ch)
        i = i + 1
    }
}
