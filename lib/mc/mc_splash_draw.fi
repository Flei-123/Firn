import mc.mc_camera
import mc.mc_math
import mc.mc_entity_draw
import mc.mc_splash

export { entlist_add_splashes }

const DROPLETS: usize = 4
const REACH: f64 = 0.4
const RING_START: f64 = 0.04
const RING_GROW: f64 = 0.22
const HOP_HEIGHT: f64 = 0.2
const SIZE_START: f64 = 0.065
const SIZE_MIN: f64 = 0.015
const DIAG: f64 = 0.7071
const COLOR_R: i32 = 190
const COLOR_G: i32 = 205
const COLOR_B: i32 = 235

fn entlist_add_splashes(l: *mut mc_entity_draw.EntList, s: *mut mc_splash.Splash, cam: *mut mc_camera.Camera, now_ms: u64) -> usize {
    var added: usize = 0
    var i: usize = 0
    while i < mc_splash.SPLASH_MAX {
        let age: i32 = mc_splash.splash_age_milli(s, i, now_ms)
        i = i + 1
        if age < 0 { continue }
        let k: usize = i - 1
        let x: f64 = (*s).x[k]
        let y: f64 = (*s).y[k]
        let z: f64 = (*s).z[k]
        if mc_math.frustum_test_box(&(*cam).frustum, x - REACH, y, z - REACH, x + REACH, y + REACH, z + REACH) == 0 { continue }
        let t: f64 = (age as f64) / 1000.0
        let ring: f64 = (RING_START + RING_GROW * t) * DIAG
        let hop: f64 = HOP_HEIGHT * 4.0 * t * (1.0 - t)
        var size: f64 = SIZE_START * (1.0 - t)
        if size < SIZE_MIN { size = SIZE_MIN }
        var d: usize = 0
        while d < DROPLETS {
            var sx: f64 = ring
            if d % 2 == 1 { sx = 0.0 - ring }
            var sz: f64 = ring
            if d / 2 == 1 { sz = 0.0 - ring }
            mc_entity_draw.entlist_add_box(l, x + sx, y + hop + size * 0.5, z + sz, size, size, size, COLOR_R, COLOR_G, COLOR_B)
            added = added + 1
            d = d + 1
        }
    }
    return added
}
