// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_shapes.fi -- partial collision shapes for the player collision (mc_input / mc_math.grid_move).
//
//     mc_shapes.shapes_fill(&reg, tables.solid, tables.n)
//
// Overwrites the entries of the InputTables.solid table (u16 per block state id) for slabs, stairs, carpets and snow layers with the
// shape codes of mc_math (128 + k, see mc_math.shape_box). Other entries stay as they are (0 passable, nonzero full cube). Without
// this call every block is a full cube or passable, so a slab can only be climbed by jumping. Slab / stairs / carpet / snow are the
// shapes that matter for step-up (stepHeight 0.6). Since s5 also: fences + fence gates + walls (1.5 high), doors, trapdoors, beds, chests
// (single and double halves; trapped / ender chest). Since s11 also: glass panes + iron bars, anvils, cauldrons, hoppers, honey block,
// farmland / dirt path (15/16), soul sand / mud (14/16).
// Every shape is checked against minecraft-data blockCollisionShapes (1.20): tools/mc/shapes/run.sh.
import std.rt
import mc.mc_registry
import mc.mc_math
import mc.mc_shape_data
import mc.mc_move_fluid

export { shapes_fill, shape_code_for_state, move_kind_for_state, move_fill, PASSABLE }

// Sentinel of shape_code_for_state: the state has no collision (0 means "keep the old table value").
const PASSABLE: i32 = 65535

fn ends_with(p: u64, n: usize, suf: str, sn: usize) -> bool {
    if n < sn { return false }
    let sp: u64 = suf.p as u64
    var i: usize = 0
    while i < sn {
        if rt.ld8(p, n - sn + i) != rt.ld8(sp, i) { return false }
        i = i + 1
    }
    return true
}

// true when `text` contains `needle` ("facing=north")
fn has(p: u64, n: usize, needle: str, nn: usize) -> bool {
    if n < nn { return false }
    let sp: u64 = needle.p as u64
    var i: usize = 0
    while i + nn <= n {
        var j: usize = 0
        while j < nn && rt.ld8(p, i + j) == rt.ld8(sp, j) {
            j = j + 1
        }
        if j == nn { return true }
        i = i + 1
    }
    return false
}

// index of the first occurrence of `needle` in the text, or n when absent
fn find(p: u64, n: usize, needle: str, nn: usize) -> usize {
    let sp: u64 = needle.p as u64
    var i: usize = 0
    while i + nn <= n {
        var j: usize = 0
        while j < nn && rt.ld8(p, i + j) == rt.ld8(sp, j) {
            j = j + 1
        }
        if j == nn { return i }
        i = i + 1
    }
    return n
}

// facing=north|south|west|east of a block state text -> 0 north, 1 south, 2 west, 3 east (north when absent)
fn facing_of(tp: u64, tn: usize) -> i32 {
    if has(tp, tn, "facing=south", 12) { return 1 }
    if has(tp, tn, "facing=west", 11) { return 2 }
    if has(tp, tn, "facing=east", 11) { return 3 }
    return 0
}

// Shape code of the s5 families (fence, wall, gate, door, trapdoor, bed, chest) for the state text, or 0 when `name` is none of them.
// PASSABLE (65535) = no collision (open fence gate, wall without post / arms).
fn ext_code(np: u64, nl: usize, tp: u64, tn: usize) -> i32 {
    if ends_with(np, nl, "_fence_gate", 11) {
        if has(tp, tn, "open=true", 9) { return PASSABLE }
        let f: i32 = facing_of(tp, tn)
        if f >= 2 { return mc_math.SHAPE_BASE + mc_math.K_GATE + 1 }
        return mc_math.SHAPE_BASE + mc_math.K_GATE
    }
    if ends_with(np, nl, "_fence", 6) {
        var m: i32 = 0
        if has(tp, tn, "north=true", 10) { m = m + 1 }
        if has(tp, tn, "south=true", 10) { m = m + 2 }
        if has(tp, tn, "west=true", 9) { m = m + 4 }
        if has(tp, tn, "east=true", 9) { m = m + 8 }
        return mc_math.SHAPE_BASE + mc_math.K_FENCE + m
    }
    if ends_with(np, nl, "_wall", 5) {
        var m: i32 = 0
        if has(tp, tn, "north=low", 9) || has(tp, tn, "north=tall", 10) { m = m + 1 }
        if has(tp, tn, "south=low", 9) || has(tp, tn, "south=tall", 10) { m = m + 2 }
        if has(tp, tn, "west=low", 8) || has(tp, tn, "west=tall", 9) { m = m + 4 }
        if has(tp, tn, "east=low", 8) || has(tp, tn, "east=tall", 9) { m = m + 8 }
        if has(tp, tn, "up=true", 7) { m = m + 16 }
        if m == 0 { return PASSABLE }
        return mc_math.SHAPE_BASE + mc_math.K_WALL + m
    }
    if ends_with(np, nl, "_trapdoor", 9) {
        if has(tp, tn, "open=true", 9) {
            return mc_math.SHAPE_BASE + mc_math.K_TRAP + mc_math.opposite_of(facing_of(tp, tn))
        }
        if has(tp, tn, "half=top", 8) { return mc_math.SHAPE_BASE + mc_math.K_TRAP + 4 }
        return mc_math.SHAPE_BASE + mc_math.K_TRAP + 5
    }
    if ends_with(np, nl, "_door", 5) {
        let f: i32 = facing_of(tp, tn)
        var d: i32 = mc_math.opposite_of(f)
        if has(tp, tn, "open=true", 9) {
            if has(tp, tn, "hinge=right", 11) { d = mc_math.right_of(f) } else { d = mc_math.left_of(f) }
        }
        return mc_math.SHAPE_BASE + mc_math.K_DOOR + d
    }
    if ends_with(np, nl, "_bed", 4) {
        let f: i32 = facing_of(tp, tn)
        var d: i32 = mc_math.opposite_of(f)
        if has(tp, tn, "part=head", 9) { d = f }
        return mc_math.SHAPE_BASE + mc_math.K_BED + d
    }
    if ends_with(np, nl, "chest", 5) && (nl == 5 || ends_with(np, nl, "_chest", 6)) {
        // chest / trapped_chest / ender_chest (ender chest has no type: single)
        if has(tp, tn, "type=left", 9) {
            return mc_math.SHAPE_BASE + mc_math.K_CHEST + 1 + mc_math.right_of(facing_of(tp, tn))
        }
        if has(tp, tn, "type=right", 10) {
            return mc_math.SHAPE_BASE + mc_math.K_CHEST + 1 + mc_math.left_of(facing_of(tp, tn))
        }
        return mc_math.SHAPE_BASE + mc_math.K_CHEST
    }
    if ends_with(np, nl, "glass_pane", 10) || (nl == 9 && ends_with(np, nl, "iron_bars", 9)) {
        var m: i32 = 0
        if has(tp, tn, "north=true", 10) { m = m + 1 }
        if has(tp, tn, "south=true", 10) { m = m + 2 }
        if has(tp, tn, "west=true", 9) { m = m + 4 }
        if has(tp, tn, "east=true", 9) { m = m + 8 }
        return mc_math.SHAPE_BASE + mc_math.K_PANE + m
    }
    if ends_with(np, nl, "anvil", 5) {
        let f: i32 = facing_of(tp, tn)
        if f >= 2 { return mc_math.SHAPE_BASE + mc_math.K_ANVIL + 1 }
        return mc_math.SHAPE_BASE + mc_math.K_ANVIL
    }
    if ends_with(np, nl, "cauldron", 8) { return mc_math.SHAPE_BASE + mc_math.K_CAULDRON }
    if nl == 6 && ends_with(np, nl, "hopper", 6) {
        var f: i32 = 0
        if has(tp, tn, "facing=north", 12) {
            f = 1
        } else if has(tp, tn, "facing=south", 12) {
            f = 2
        } else if has(tp, tn, "facing=west", 11) {
            f = 3
        } else if has(tp, tn, "facing=east", 11) {
            f = 4
        }
        return mc_math.SHAPE_BASE + mc_math.K_HOPPER + f
    }
    if nl == 11 && ends_with(np, nl, "honey_block", 11) { return mc_math.SHAPE_BASE + mc_math.K_HONEY }
    if (nl == 8 && ends_with(np, nl, "farmland", 8)) || (nl == 9 && ends_with(np, nl, "dirt_path", 9)) || (nl == 10 && ends_with(np, nl, "grass_path", 10)) {
        return mc_math.SHAPE_BASE + mc_math.K_LOW + 15
    }
    if (nl == 9 && ends_with(np, nl, "soul_sand", 9)) || (nl == 3 && ends_with(np, nl, "mud", 3)) {
        return mc_math.SHAPE_BASE + mc_math.K_LOW + 14
    }
    return 0
}

// true for the block names ext_code models (see there)
fn is_ext_name(np: u64, nl: usize) -> bool {
    return ends_with(np, nl, "_fence", 6) || ends_with(np, nl, "_fence_gate", 11) || ends_with(np, nl, "_wall", 5)
    || ends_with(np, nl, "_door", 5) || ends_with(np, nl, "_trapdoor", 9) || ends_with(np, nl, "_bed", 4) || ends_with(np, nl, "chest", 5)
    || ends_with(np, nl, "glass_pane", 10) || ends_with(np, nl, "iron_bars", 9) || ends_with(np, nl, "anvil", 5) || ends_with(np, nl, "cauldron", 8)
    || ends_with(np, nl, "hopper", 6) || ends_with(np, nl, "honey_block", 11) || ends_with(np, nl, "farmland", 8) || ends_with(np, nl, "dirt_path", 9)
    || ends_with(np, nl, "grass_path", 10) || ends_with(np, nl, "soul_sand", 9) || (nl == 3 && ends_with(np, nl, "mud", 3))
}

// Index of the block `np` in the generated table (mc_shape_data.names), or -1.
fn tab_block(np: u64, nl: usize) -> i32 {
    let t: str = mc_shape_data.names()
    let tp: u64 = t.p as u64
    var i: usize = 0
    var bi: i32 = 0
    while bi < mc_shape_data.NBLOCKS {
        var j: usize = 0
        while j < nl && rt.ld8(tp, i + j) == rt.ld8(np, j) {
            j = j + 1
        }
        if j == nl && rt.ld8(tp, i + nl) == 59 { return bi }
        // skip to the next name
        while rt.ld8(tp, i) != 59 {
            i = i + 1
        }
        i = i + 1
        bi = bi + 1
    }
    return -1
}

// Shape code of the generated table (mc_shape_data) for a state of block b: 0 when the block is not in it (or its state count differs
// from the 1.20 data), PASSABLE, 1 (full cube) or SHAPE_BASE + K_TAB + pool index.
fn tab_code(r: *mut mc_registry.Registry, b: i32, state: i32, np: u64, nl: usize) -> i32 {
    let bi: i32 = tab_block(np, nl)
    if bi < 0 { return 0 }
    let ro: str = mc_shape_data.rowoff()
    let first: i32 = mc_math.b26_at(ro, (bi as usize) * 4, 4)
    let next: i32 = mc_math.b26_at(ro, ((bi + 1) as usize) * 4, 4)
    let lo: i32 = mc_registry.reg_block_min_state(r, b)
    let n: i32 = mc_registry.reg_block_max_state(r, b) - lo + 1
    if n != next - first { return 0 }
    let v: i32 = mc_math.b26_at(mc_shape_data.states(), ((first + state - lo) as usize) * 2, 2)
    if v == 0 { return PASSABLE }
    if v == 1 { return 1 }
    return mc_math.SHAPE_BASE + mc_math.K_TAB + (v - 2)
}

// Shape code (0 = keep the old table value, else the new table value) of one block state.
fn shape_code_for_state(r: *mut mc_registry.Registry, state: i32) -> i32 {
    let b: i32 = mc_registry.reg_block_of_state(r, state)
    if b < 0 { return 0 }
    var nl: usize = 0
    let np: u64 = mc_registry.reg_block_name(r, b, &nl)
    let is_slab: bool = ends_with(np, nl, "_slab", 5)
    let is_stairs: bool = ends_with(np, nl, "_stairs", 7)
    let is_carpet: bool = ends_with(np, nl, "_carpet", 7)
    let is_snow: bool = nl == 4 && ends_with(np, nl, "snow", 4)
    let is_ext: bool = is_ext_name(np, nl)
    if is_ext {
        var et: rt.Buf = rt.buf_new()
        var ec: i32 = 0
        if mc_registry.reg_state_text(r, state, &et) {
            ec = ext_code(np, nl, rt.buf_ptr(&et), rt.buf_len(&et))
        }
        rt.buf_free(&et)
        return ec
    }
    if !is_slab && !is_stairs && !is_carpet && !is_snow {
        var tc: i32 = tab_code(r, b, state, np, nl)
        // OffsetType.XZ blocks: bamboo (max 0.25), pointed dripstone (max 0.125); the offset itself is added by mc_math.shape_box_at
        if tc > mc_math.SHAPE_BASE {
            if nl == 6 && ends_with(np, nl, "bamboo", 6) { tc = tc + mc_math.OFF_A }
            if nl == 17 && ends_with(np, nl, "pointed_dripstone", 17) { tc = tc + mc_math.OFF_B }
        }
        return tc
    }
    var t: rt.Buf = rt.buf_new()
    var code: i32 = 0
    if mc_registry.reg_state_text(r, state, &t) {
        let tp: u64 = rt.buf_ptr(&t)
        let tn: usize = rt.buf_len(&t)
        if is_carpet {
            code = mc_math.SHAPE_BASE + 3
        } else if is_slab {
            if has(tp, tn, "type=top", 8) {
                code = mc_math.SHAPE_BASE + 2
            } else if has(tp, tn, "type=double", 11) {
                code = 1
            } else {
                code = mc_math.SHAPE_BASE + 1
            }
        } else if is_snow {
            var layers: i32 = 1
            let at: usize = find(tp, tn, "layers=", 7)
            if at + 7 < tn { layers = (rt.ld8(tp, at + 7) as i32) - 48 }
            if layers >= 8 {
                code = 1
            } else if layers == 1 {
                code = 0
            } else {
                code = mc_math.SHAPE_BASE + 4 + (layers - 2)
            }
        } else {
            var f: i32 = 0
            if has(tp, tn, "facing=south", 12) {
                f = 1
            } else if has(tp, tn, "facing=west", 11) {
                f = 2
            } else if has(tp, tn, "facing=east", 11) {
                f = 3
            }
            var sh: i32 = 0
            if has(tp, tn, "shape=inner_left", 16) {
                sh = 1
            } else if has(tp, tn, "shape=inner_right", 17) {
                sh = 2
            } else if has(tp, tn, "shape=outer_left", 16) {
                sh = 3
            } else if has(tp, tn, "shape=outer_right", 17) {
                sh = 4
            }
            var half: i32 = 0
            if has(tp, tn, "half=top", 8) { half = 1 }
            code = mc_math.SHAPE_BASE + 16 + half * 20 + f * 5 + sh
        }
    }
    rt.buf_free(&t)
    // snow with one layer has no collision: signal "passable" with PASSABLE so shapes_fill can tell it from "keep"
    if is_snow && code == 0 { return PASSABLE }
    return code
}

// Fills the shape codes into `solid` (n entries).
fn shapes_fill(r: *mut mc_registry.Registry, solid: u64, n: usize) {
    var st: usize = 0
    while st < n && (st as i32) < mc_registry.reg_state_count(r) {
        let c: i32 = shape_code_for_state(r, st as i32)
        if c == PASSABLE {
            rt.st16(solid, st, 0 as u16)
        } else if c != 0 {
            rt.st16(solid, st, c as u16)
        }
        st = st + 1
    }
}

// Movement kind (mc_math.MV_*) of one block state: soul sand, honey block, cobweb ("web" before 1.13), sweet berry bush; 0 otherwise.
fn move_kind_for_state(r: *mut mc_registry.Registry, state: i32) -> i32 {
    let b: i32 = mc_registry.reg_block_of_state(r, state)
    if b < 0 { return 0 }
    var nl: usize = 0
    let np: u64 = mc_registry.reg_block_name(r, b, &nl)
    if nl == 9 && ends_with(np, nl, "soul_sand", 9) { return mc_math.MV_SOUL_SAND }
    if nl == 11 && ends_with(np, nl, "honey_block", 11) { return mc_math.MV_HONEY }
    if (nl == 6 && ends_with(np, nl, "cobweb", 6)) || (nl == 3 && ends_with(np, nl, "web", 3)) { return mc_math.MV_COBWEB }
    if nl == 16 && ends_with(np, nl, "sweet_berry_bush", 16) { return mc_math.MV_BERRY }
    return fluid_move_kind(r, state, np, nl)
}

fn name_is(np: u64, nl: usize, s: str) -> bool { return nl == s.n && ends_with(np, nl, s, s.n) }

fn is_climbable_name(np: u64, nl: usize) -> bool {
    return name_is(np, nl, "ladder") || name_is(np, nl, "vine") || name_is(np, nl, "scaffolding") || name_is(np, nl, "twisting_vines")
        || name_is(np, nl, "twisting_vines_plant") || name_is(np, nl, "weeping_vines") || name_is(np, nl, "weeping_vines_plant")
        || name_is(np, nl, "cave_vines") || name_is(np, nl, "cave_vines_plant")
}

fn is_water_plant_name(np: u64, nl: usize) -> bool {
    return name_is(np, nl, "seagrass") || name_is(np, nl, "tall_seagrass") || name_is(np, nl, "kelp") || name_is(np, nl, "kelp_plant")
        || name_is(np, nl, "bubble_column")
}

fn fluid_level_amount(tp: u64, tn: usize) -> i32 {
    let at: usize = find(tp, tn, "level=", 6)
    if at + 6 >= tn { return 8 }
    var lv: i32 = (rt.ld8(tp, at + 6) as i32) - 48
    if at + 7 < tn {
        let d: i32 = (rt.ld8(tp, at + 7) as i32) - 48
        if d >= 0 && d <= 9 { lv = lv * 10 + d }
    }
    if lv <= 0 || lv >= 8 { return 8 }
    return 8 - lv
}

fn fluid_move_kind(r: *mut mc_registry.Registry, state: i32, np: u64, nl: usize) -> i32 {
    let water: bool = name_is(np, nl, "water") || name_is(np, nl, "flowing_water")
    let lava: bool = name_is(np, nl, "lava") || name_is(np, nl, "flowing_lava")
    let climb: bool = is_climbable_name(np, nl)
    let plant: bool = is_water_plant_name(np, nl)
    var t: rt.Buf = rt.buf_new()
    var kind: i32 = 0
    let have: bool = mc_registry.reg_state_text(r, state, &t)
    let tp: u64 = rt.buf_ptr(&t)
    let tn: usize = rt.buf_len(&t)
    if water || lava {
        var amount: i32 = 8
        if have { amount = fluid_level_amount(tp, tn) }
        kind = mc_move_fluid.fluid_kind(lava, amount)
    } else if plant {
        kind = mc_move_fluid.fluid_kind(false, 8)
    } else if have && has(tp, tn, "waterlogged=true", 16) {
        kind = mc_move_fluid.fluid_kind(false, 8)
    } else if climb {
        kind = mc_move_fluid.MV_LADDER
    }
    rt.buf_free(&t)
    return kind
}

// Fills the u8 table `mv` (n entries, one per block state; Player.mv) with the movement kinds.
fn move_fill(r: *mut mc_registry.Registry, mv: u64, n: usize) {
    var st: usize = 0
    while st < n && (st as i32) < mc_registry.reg_state_count(r) {
        rt.st8(mv, st, move_kind_for_state(r, st as i32) as u8)
        st = st + 1
    }
}
