// SPDX-License-Identifier: MPL-2.0
import std.rt
import mc.mc_registry
import mc.mc_biome_fog_data

export { bfog_load, bfog_color, bfog_free, BFOG_DEFAULT, BFOG_MAX }

const BFOG_MAX: usize = 1024
const BFOG_DEFAULT: u32 = 329011 as u32
const ENTRY_TAIL: usize = 7
static mut TABLE: u64 = 0

fn hex_digit(c: u8) -> u32 {
    if c >= (97 as u8) { return ((c - (97 as u8)) as u32) + (10 as u32) }
    if c >= (65 as u8) { return ((c - (65 as u8)) as u32) + (10 as u32) }
    return (c - (48 as u8)) as u32
}

fn hex6(d: u64, o: usize) -> u32 {
    var v: u32 = 0 as u32
    var i: usize = 0
    while i < 6 {
        v = (v << (4 as u32)) | hex_digit(rt.ld8(d, o + i))
        i = i + 1
    }
    return v
}

fn find_entry(np: u64, nl: usize) -> i64 {
    let d: u64 = mc_biome_fog_data.BF_DATA.p as u64
    let dn: usize = mc_biome_fog_data.BF_LEN
    var i: usize = 0
    while i < dn {
        var e: usize = i
        while e < dn && rt.ld8(d, e) != (59 as u8) { e = e + 1 }
        if e - i > ENTRY_TAIL {
            let ln: usize = e - i - ENTRY_TAIL
            if ln == nl && rt.mem_eq(d + (i as u64), np, nl) { return (i + ln + 1) as i64 }
        }
        i = e + 1
    }
    return 0 - 1
}

fn bfog_free() {
    if TABLE != 0 {
        rt.heap_free(TABLE, BFOG_MAX * 4)
        TABLE = 0
    }
}

fn bfog_load(reg: *mut mc_registry.Registry) {
    bfog_free()
    TABLE = rt.heap_alloc(BFOG_MAX * 4)
    var i: usize = 0
    while i < BFOG_MAX {
        rt.st32(TABLE, i, BFOG_DEFAULT)
        i = i + 1
    }
    let d: u64 = mc_biome_fog_data.BF_DATA.p as u64
    let nb: i32 = mc_registry.reg_biome_count(reg)
    var bi: i32 = 0
    while bi < nb {
        var nl: usize = 0
        var np: u64 = mc_registry.reg_biome_name(reg, bi, &nl)
        let id: i32 = mc_registry.reg_biome_id(reg, bi)
        bi = bi + 1
        if id < 0 || (id as usize) >= BFOG_MAX { continue }
        if nl > 10 && rt.mem_eq(np, "minecraft:".p as u64, 10) {
            np = np + (10 as u64)
            nl = nl - 10
        }
        let o: i64 = find_entry(np, nl)
        if o >= 0 { rt.st32(TABLE, id as usize, hex6(d, o as usize)) }
    }
}

fn bfog_color(id: i32) -> u32 {
    if TABLE == 0 || id < 0 || (id as usize) >= BFOG_MAX { return BFOG_DEFAULT }
    return rt.ld32(TABLE, id as usize)
}
