// lib/mc/mc_world.fi -- the client's world store: decoded chunk columns by
// (x, z). It owns the Chunk allocations (see mc_chunk.fi). A chunk that is sent
// again replaces the old one. Coordinate math (block <-> chunk <-> section) lives
// in the helpers at the end.

import std.rt
import std.bytes
import mc.mc_chunk
import mc.mc_version
import mc.mc_lightpkt

export {
    World, world_new, world_free, world_put, world_count, world_chunk_at,
    world_find, world_remove, world_apply, world_update_light, ULIGHT_APPLIED, ULIGHT_ORPHAN, ULIGHT_BAD, ULIGHT_IGNORED, APPLY_STORED, APPLY_MERGED, APPLY_DROPPED, APPLY_NOMEM,
    floor_div, floor_mod, block_to_chunk, block_in_chunk, section_index,
}

struct World {
    n: usize,
    cap: usize,
    items: u64, // array of u64 = pointers to heap allocated Chunk
}

fn world_new() -> World {
    return World { n: 0, cap: 0, items: 0 }
}

fn world_count(w: *mut World) -> usize { return (*w).n }

fn world_free(w: *mut World) {
    var i: usize = 0
    while i < (*w).n {
        mc_chunk.chunk_release(rt.ld64((*w).items, i))
        i = i + 1
    }
    if (*w).items != 0 {
        rt.heap_free((*w).items, (*w).cap * 8)
    }
    (*w).items = 0
    (*w).n = 0
    (*w).cap = 0
}

fn world_chunk_at(w: *mut World, i: usize) -> *mut mc_chunk.Chunk {
    return rt.ld64((*w).items, i) as *mut mc_chunk.Chunk
}

// Stores a decoded chunk (the world takes ownership of `p`). A chunk that is
// sent again replaces the old one. Returns false when memory is out.
fn world_put(w: *mut World, p: u64) -> bool {
    let c: *mut mc_chunk.Chunk = p as *mut mc_chunk.Chunk
    var i: usize = 0
    while i < (*w).n {
        let o: *mut mc_chunk.Chunk = world_chunk_at(w, i)
        if (*o).x == (*c).x && (*o).z == (*c).z {
            mc_chunk.chunk_release(rt.ld64((*w).items, i))
            rt.st64((*w).items, i, p)
            return true
        }
        i = i + 1
    }
    if (*w).n == (*w).cap {
        var nc: usize = (*w).cap * 2
        if nc == 0 {
            nc = 64
        }
        let ni: u64 = rt.heap_alloc(nc * 8)
        if ni == 0 {
            return false
        }
        if (*w).items != 0 {
            rt.mem_copy(ni, (*w).items, (*w).n * 8)
            rt.heap_free((*w).items, (*w).cap * 8)
        }
        (*w).items = ni
        (*w).cap = nc
    }
    rt.st64((*w).items, (*w).n, p)
    (*w).n = (*w).n + 1
    return true
}

const APPLY_STORED: i32 = 1 // a whole column: stored (replacing an older one)
const APPLY_MERGED: i32 = 2 // a section update: merged into the stored column
const APPLY_DROPPED: i32 = 0 // a section update for a column the world does not have
const APPLY_NOMEM: i32 = 0 - 1

// Takes a decoded packet `p` (the world owns it from now on, in every case) and puts it into the world.
// A whole column replaces the stored one (world_put). A CF_SECTIONS_19 section update (ground_up == 0)
// is MERGED into the stored column (mc_chunk.chunk_merge_update) and `p` is released; an update for a
// column that is not stored is dropped (the server never sends one, and half a column is no column).
fn world_apply(w: *mut World, p: u64) -> i32 {
    let c: *mut mc_chunk.Chunk = p as *mut mc_chunk.Chunk
    if (*c).ground_up != 0 {
        if world_put(w, p) {
            return APPLY_STORED
        }
        mc_chunk.chunk_release(p)
        return APPLY_NOMEM
    }
    let d: u64 = world_find(w, (*c).x, (*c).z)
    if d == 0 {
        mc_chunk.chunk_release(p)
        return APPLY_DROPPED
    }
    mc_chunk.chunk_merge_update(d as *mut mc_chunk.Chunk, c)
    mc_chunk.chunk_release(p)
    return APPLY_MERGED
}

// chunk with coordinates (x, z), or 0
fn world_find(w: *mut World, x: i32, z: i32) -> u64 {
    var i: usize = 0
    while i < (*w).n {
        let o: *mut mc_chunk.Chunk = world_chunk_at(w, i)
        if (*o).x == x && (*o).z == z {
            return rt.ld64((*w).items, i)
        }
        i = i + 1
    }
    return 0
}

// Removes (and releases) the chunk at (x, z); true when there was one. The order of the rest is kept.
fn world_remove(w: *mut World, x: i32, z: i32) -> bool {
    var i: usize = 0
    while i < (*w).n {
        let o: *mut mc_chunk.Chunk = world_chunk_at(w, i)
        if (*o).x == x && (*o).z == z {
            mc_chunk.chunk_release(rt.ld64((*w).items, i))
            var j: usize = i + 1
            while j < (*w).n {
                rt.st64((*w).items, j - 1, rt.ld64((*w).items, j))
                j = j + 1
            }
            (*w).n = (*w).n - 1
            return true
        }
        i = i + 1
    }
    return false
}

// ------------------------------------------------------- coordinate math
// Floor division/modulo (Minecraft coordinates are negative on half the map and
// `/` truncates towards zero).
fn floor_div(a: i32, b: i32) -> i32 {
    var q: i32 = a / b
    if (a % b != 0) && ((a < 0) != (b < 0)) {
        q = q - 1
    }
    return q
}

fn floor_mod(a: i32, b: i32) -> i32 {
    return a - floor_div(a, b) * b
}

fn block_to_chunk(b: i32) -> i32 { return floor_div(b, 16) }
fn block_in_chunk(b: i32) -> i32 { return floor_mod(b, 16) }

// section index of block height y in a world whose lowest block is min_y
fn section_index(y: i32, min_y: i32) -> i32 { return floor_div(y - min_y, 16) }

// ---- update_light packet -> Chunk.light of the column
const ULIGHT_APPLIED: i32 = 1
const ULIGHT_ORPHAN: i32 = 0 // the column is not in the world (packet dropped)
const ULIGHT_BAD: i32 = 0 - 1 // does not decode / out of memory
const ULIGHT_IGNORED: i32 = 2 // chunk format without a separate light packet (1.8 - 1.12)

// Decodes the body of an update_light packet (cursor at the first field) and merges it into the column's Chunk.light.
// 1.14 - 1.16.5 (CF_SECTIONS_114): int masks, trustEdges from 1.16 (protocol 735); the merged state also drives the column's
// light_hash / sky_n / block_n. 1.18+: counted long masks; light_hash stays the map_chunk hash. Used by demos/mcclient
// (MC_KEEP_LIGHT) and the play client so lit rendering sees the light of 1.14 - 1.16.5 servers.
fn world_update_light(w: *mut World, chunk_format: i32, protocol: i32, b: *mut bytes.Bytes) -> i32 {
    if chunk_format != mc_version.CF_SECTIONS_114 && chunk_format != mc_version.CF_CONTAINERS_118 {
        return ULIGHT_IGNORED
    }
    var ld: mc_lightpkt.LightData = mc_lightpkt.lightdata_new()
    var ok: bool = false
    if chunk_format == mc_version.CF_SECTIONS_114 {
        ok = mc_lightpkt.lightdata_decode_114(b, &ld, protocol >= 735) catch false
    } else {
        ok = mc_lightpkt.lightdata_decode_118(b, &ld, true) catch false
    }
    if !ok {
        mc_lightpkt.lightdata_free(&ld)
        return ULIGHT_BAD
    }
    let p: u64 = world_find(w, ld.x, ld.z)
    if p == 0 {
        mc_lightpkt.lightdata_free(&ld)
        return ULIGHT_ORPHAN
    }
    let done: bool = mc_chunk.chunk_apply_light_update(p as *mut mc_chunk.Chunk, &ld, chunk_format == mc_version.CF_SECTIONS_114)
    mc_lightpkt.lightdata_free(&ld)
    if done { return ULIGHT_APPLIED }
    return ULIGHT_BAD
}
