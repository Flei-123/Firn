// lib/mc/mc_world.fi -- the client's world store: decoded chunk columns by
// (x, z). It owns the Chunk allocations (see mc_chunk.fi). A chunk that is sent
// again replaces the old one. Coordinate math (block <-> chunk <-> section) lives
// in the helpers at the end.

import std.rt
import mc.mc_chunk

export {
    World, world_new, world_free, world_put, world_count, world_chunk_at,
    world_find,
    floor_div, floor_mod, block_to_chunk, block_in_chunk, section_index,
}

struct World {
    n: usize,
    cap: usize,
    items: u64, // array of u64 = pointers to heap allocated Chunk
}

fn world_new() -> World {
    return World { n: 0, cap: 0, items: 0 }
}

fn world_count(w: *mut World) -> usize { return (*w).n }

fn world_free(w: *mut World) {
    var i: usize = 0
    while i < (*w).n {
        mc_chunk.chunk_release(rt.ld64((*w).items, i))
        i = i + 1
    }
    if (*w).items != 0 {
        rt.heap_free((*w).items, (*w).cap * 8)
    }
    (*w).items = 0
    (*w).n = 0
    (*w).cap = 0
}

fn world_chunk_at(w: *mut World, i: usize) -> *mut mc_chunk.Chunk {
    return rt.ld64((*w).items, i) as *mut mc_chunk.Chunk
}

// Stores a decoded chunk (the world takes ownership of `p`). A chunk that is
// sent again replaces the old one. Returns false when memory is out.
fn world_put(w: *mut World, p: u64) -> bool {
    let c: *mut mc_chunk.Chunk = p as *mut mc_chunk.Chunk
    var i: usize = 0
    while i < (*w).n {
        let o: *mut mc_chunk.Chunk = world_chunk_at(w, i)
        if (*o).x == (*c).x && (*o).z == (*c).z {
            mc_chunk.chunk_release(rt.ld64((*w).items, i))
            rt.st64((*w).items, i, p)
            return true
        }
        i = i + 1
    }
    if (*w).n == (*w).cap {
        var nc: usize = (*w).cap * 2
        if nc == 0 {
            nc = 64
        }
        let ni: u64 = rt.heap_alloc(nc * 8)
        if ni == 0 {
            return false
        }
        if (*w).items != 0 {
            rt.mem_copy(ni, (*w).items, (*w).n * 8)
            rt.heap_free((*w).items, (*w).cap * 8)
        }
        (*w).items = ni
        (*w).cap = nc
    }
    rt.st64((*w).items, (*w).n, p)
    (*w).n = (*w).n + 1
    return true
}

// chunk with coordinates (x, z), or 0
fn world_find(w: *mut World, x: i32, z: i32) -> u64 {
    var i: usize = 0
    while i < (*w).n {
        let o: *mut mc_chunk.Chunk = world_chunk_at(w, i)
        if (*o).x == x && (*o).z == z {
            return rt.ld64((*w).items, i)
        }
        i = i + 1
    }
    return 0
}

// ------------------------------------------------------- coordinate math
// Floor division/modulo (Minecraft coordinates are negative on half the map and
// `/` truncates towards zero).
fn floor_div(a: i32, b: i32) -> i32 {
    var q: i32 = a / b
    if (a % b != 0) && ((a < 0) != (b < 0)) {
        q = q - 1
    }
    return q
}

fn floor_mod(a: i32, b: i32) -> i32 {
    return a - floor_div(a, b) * b
}

fn block_to_chunk(b: i32) -> i32 { return floor_div(b, 16) }
fn block_in_chunk(b: i32) -> i32 { return floor_mod(b, 16) }

// section index of block height y in a world whose lowest block is min_y
fn section_index(y: i32, min_y: i32) -> i32 { return floor_div(y - min_y, 16) }
