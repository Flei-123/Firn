import std.rt
import std.math
import mc.mc_raster
import mc.mc_hud
import mc.mc_gui_tex
import mc.mc_gui_pack
import mc.mc_camera
import mc.mc_math

export {
    CrackTex, CrackBox, CrackVis, crack_tex_new, crack_tex_free, crack_tex_ok, crack_tex_open, crack_tex_from_stages,
    crack_stage, crack_color, crack_draw, crack_draw_vis, CRACK_STAGES, CRACK_ALL_FACES,
}

const CRACK_STAGES: i32 = 10
const CRACK_ALL_FACES: u32 = 63
const PATH_HEAD: str = "assets/minecraft/textures/block/destroy_stage_"
const PATH_TAIL: str = ".png"

struct CrackTex {
    atlas: mc_gui_tex.GuiTex,
    tw: i32,
    th: i32,
}

struct CrackVis {
    test: fn(u64, f64, f64, f64, f64, f64, f64) -> bool,
    ud: u64,
}

struct CrackBox {
    x0: f64,
    y0: f64,
    z0: f64,
    x1: f64,
    y1: f64,
    z1: f64,
}

fn crack_tex_new() -> CrackTex {
    return CrackTex { atlas: mc_gui_tex.gtex_empty(), tw: 0, th: 0 }
}

fn crack_tex_free(t: *mut CrackTex) {
    mc_gui_tex.gtex_free(&(*t).atlas)
    (*t).tw = 0
    (*t).th = 0
}

fn crack_tex_ok(t: *mut CrackTex) -> bool {
    return mc_gui_tex.gtex_ok(&(*t).atlas) && (*t).tw > 0 && (*t).th > 0
}

fn blit_stage(t: *mut CrackTex, stage: i32, src: *mut mc_gui_tex.GuiTex) -> bool {
    if (*src).w != (*t).tw || (*src).h != (*t).th { return false }
    var y: i32 = 0
    while y < (*t).th {
        var x: i32 = 0
        while x < (*t).tw {
            mc_gui_tex.gtex_set(&(*t).atlas, x, stage * (*t).th + y, mc_gui_tex.gtex_get(src, x, y))
            x = x + 1
        }
        y = y + 1
    }
    return true
}

fn crack_tex_from_stages(t: *mut CrackTex, stages: *mut [mc_gui_tex.GuiTex; 10]) -> bool {
    crack_tex_free(t)
    if !mc_gui_tex.gtex_ok(&(*stages)[0]) { return false }
    (*t).tw = (*stages)[0].w
    (*t).th = (*stages)[0].h
    if !mc_gui_tex.gtex_blank(&(*t).atlas, (*t).tw, (*t).th * CRACK_STAGES) {
        (*t).tw = 0
        (*t).th = 0
        return false
    }
    var i: i32 = 0
    while i < CRACK_STAGES {
        if !blit_stage(t, i, &(*stages)[i as usize]) {
            crack_tex_free(t)
            return false
        }
        i = i + 1
    }
    return true
}

fn stage_path(i: i32, out: *mut rt.Buf) {
    rt.buf_push_bytes(out, PATH_HEAD.p as u64, PATH_HEAD.length())
    var d: u8 = (48 + i) as u8
    rt.buf_push_bytes(out, (&d) as u64, 1)
    rt.buf_push_bytes(out, PATH_TAIL.p as u64, PATH_TAIL.length())
}

fn crack_tex_open(t: *mut CrackTex, protocol: i32) -> bool {
    var pk: mc_gui_pack.GuiPack = mc_gui_pack.gpack_new()
    if !mc_gui_pack.gpack_open(&pk, protocol) {
        mc_gui_pack.gpack_free(&pk)
        return false
    }
    var st: [mc_gui_tex.GuiTex; 10] = [mc_gui_tex.gtex_empty(); 10]
    var ok: bool = true
    var i: i32 = 0
    while i < CRACK_STAGES {
        var path: rt.Buf = rt.buf_new()
        stage_path(i, &path)
        if !mc_gui_pack.gpack_tex(&pk, rt.buf_str(&path), &st[i as usize]) { ok = false }
        rt.buf_free(&path)
        i = i + 1
    }
    mc_gui_pack.gpack_free(&pk)
    if ok { ok = crack_tex_from_stages(t, &st) }
    i = 0
    while i < CRACK_STAGES {
        mc_gui_tex.gtex_free(&st[i as usize])
        i = i + 1
    }
    return ok
}

fn crack_stage(elapsed_ms: u64, total_ms: u64) -> i32 {
    if total_ms == 0 as u64 { return 0 - 1 }
    var s: u64 = (elapsed_ms * 10 as u64) / total_ms
    if s > 9 as u64 { s = 9 as u64 }
    return s as i32
}

fn crack_color(texel: u32) -> u32 {
    if (texel >> 24 as u32) < 128 as u32 { return 0 as u32 }
    let k: u32 = (texel & 255 as u32) * 2 as u32
    if k < 255 as u32 { return (255 as u32 - k) << 24 as u32 }
    let a: u32 = (k - 255 as u32) / 2 as u32
    if a == 0 as u32 { return 0 as u32 }
    return (a << 24 as u32) | 0x00FFFFFF as u32
}

fn face_lo(b: *mut CrackBox, axis: i32) -> f64 {
    if axis == 0 { return (*b).x0 }
    if axis == 1 { return (*b).y0 }
    return (*b).z0
}

fn face_hi(b: *mut CrackBox, axis: i32) -> f64 {
    if axis == 0 { return (*b).x1 }
    if axis == 1 { return (*b).y1 }
    return (*b).z1
}

fn cam_axis(cam: *mut mc_camera.Camera, axis: i32) -> f64 {
    if axis == 0 { return (*cam).x }
    if axis == 1 { return (*cam).y }
    return (*cam).z
}

fn dir_axis(dx: f64, dy: f64, dz: f64, axis: i32) -> f64 {
    if axis == 0 { return dx }
    if axis == 1 { return dy }
    return dz
}

fn u_axis(axis: i32) -> i32 {
    if axis == 0 { return 2 }
    return 0
}

fn v_axis(axis: i32) -> i32 {
    if axis == 1 { return 2 }
    return 1
}

fn corner(b: *mut CrackBox, axis: i32, plane: f64, ua: f64, va: f64, out: *mut mc_math.Vec3) {
    var p: [f64; 3] = [0.0; 3]
    p[axis as usize] = plane
    p[u_axis(axis) as usize] = ua
    p[v_axis(axis) as usize] = va
    (*out).x = p[0]
    (*out).y = p[1]
    (*out).z = p[2]
}

fn screen_bounds(cam: *mut mc_camera.Camera, b: *mut CrackBox, axis: i32, plane: f64, out: *mut [i32; 4]) {
    var minx: f64 = 1.0e9
    var miny: f64 = 1.0e9
    var maxx: f64 = 0.0 - 1.0e9
    var maxy: f64 = 0.0 - 1.0e9
    var all: bool = true
    var k: i32 = 0
    while k < 4 {
        var ua: f64 = face_lo(b, u_axis(axis))
        if (k & 1) != 0 { ua = face_hi(b, u_axis(axis)) }
        var va: f64 = face_lo(b, v_axis(axis))
        if (k & 2) != 0 { va = face_hi(b, v_axis(axis)) }
        var c: mc_math.Vec3 = mc_math.v3(0.0, 0.0, 0.0)
        corner(b, axis, plane, ua, va, &c)
        var s: mc_math.Vec3 = mc_math.v3(0.0, 0.0, 0.0)
        if !mc_camera.camera_project(cam, c.x, c.y, c.z, &s) {
            all = false
        } else {
            if s.x < minx { minx = s.x }
            if s.y < miny { miny = s.y }
            if s.x > maxx { maxx = s.x }
            if s.y > maxy { maxy = s.y }
        }
        k = k + 1
    }
    if !all {
        (*out)[0] = 0
        (*out)[1] = 0
        (*out)[2] = (*cam).width
        (*out)[3] = (*cam).height
        return
    }
    var x0: i32 = math.floor(minx) as i32 - 1
    var y0: i32 = math.floor(miny) as i32 - 1
    var x1: i32 = math.floor(maxx) as i32 + 2
    var y1: i32 = math.floor(maxy) as i32 + 2
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    if x1 > (*cam).width { x1 = (*cam).width }
    if y1 > (*cam).height { y1 = (*cam).height }
    (*out)[0] = x0
    (*out)[1] = y0
    (*out)[2] = x1
    (*out)[3] = y1
}

fn texel_at(t: *mut CrackTex, stage: i32, fu: f64, fv: f64) -> u32 {
    var tx: i32 = math.floor(fu * ((*t).tw as f64)) as i32
    var ty: i32 = math.floor(fv * ((*t).th as f64)) as i32
    if tx < 0 { tx = 0 }
    if ty < 0 { ty = 0 }
    if tx >= (*t).tw { tx = (*t).tw - 1 }
    if ty >= (*t).th { ty = (*t).th - 1 }
    return mc_gui_tex.gtex_get(&(*t).atlas, tx, stage * (*t).th + ty)
}

fn draw_face(r: *mut mc_raster.Raster, cam: *mut mc_camera.Camera, t: *mut CrackTex, stage: i32, b: *mut CrackBox, axis: i32, plane: f64, vis: *mut CrackVis) {
    var bd: [i32; 4] = [0; 4]
    screen_bounds(cam, b, axis, plane, &bd)
    let ua: i32 = u_axis(axis)
    let va: i32 = v_axis(axis)
    let ulo: f64 = face_lo(b, ua)
    let uhi: f64 = face_hi(b, ua)
    let vlo: f64 = face_lo(b, va)
    let vhi: f64 = face_hi(b, va)
    let o: f64 = cam_axis(cam, axis)
    let w: f64 = (*cam).width as f64
    let h: f64 = (*cam).height as f64
    var py: i32 = bd[1]
    while py < bd[3] {
        let ny: f64 = (1.0 - 2.0 * ((py as f64) + 0.5) / h) * (*cam).tan_y
        var run_x: i32 = 0
        var run_c: u32 = 0 as u32
        var px: i32 = bd[0]
        while px <= bd[2] {
            var col: u32 = 0 as u32
            if px < bd[2] {
                let nx: f64 = (2.0 * ((px as f64) + 0.5) / w - 1.0) * (*cam).tan_x
                let dx: f64 = (*cam).fx + (*cam).rx * nx + (*cam).ux * ny
                let dy: f64 = (*cam).fy + (*cam).ry * nx + (*cam).uy * ny
                let dz: f64 = (*cam).fz + (*cam).rz * nx + (*cam).uz * ny
                let da: f64 = dir_axis(dx, dy, dz, axis)
                if da > 0.000001 || da < 0.0 - 0.000001 {
                    let tt: f64 = (plane - o) / da
                    if tt > 0.0 {
                        let hu: f64 = cam_axis(cam, ua) + tt * dir_axis(dx, dy, dz, ua)
                        let hv: f64 = cam_axis(cam, va) + tt * dir_axis(dx, dy, dz, va)
                        if hu >= ulo && hu < uhi && hv >= vlo && hv < vhi {
                            var fv: f64 = (hv - vlo) / (vhi - vlo)
                            if axis != 1 { fv = 1.0 - fv }
                            col = crack_color(texel_at(t, stage, (hu - ulo) / (uhi - ulo), fv))
                            if col != 0 as u32 && (vis as u64) != 0 as u64 {
                                if !(*vis).test((*vis).ud, (*cam).x, (*cam).y, (*cam).z, (*cam).x + tt * dx, (*cam).y + tt * dy, (*cam).z + tt * dz) { col = 0 as u32 }
                            }
                        }
                    }
                }
            }
            if col != run_c {
                if run_c != 0 as u32 { mc_hud.hud_rect(r, run_x, py, px - run_x, 1, run_c) }
                run_x = px
                run_c = col
            }
            px = px + 1
        }
        py = py + 1
    }
}

fn crack_draw(r: *mut mc_raster.Raster, cam: *mut mc_camera.Camera, t: *mut CrackTex, stage: i32, b: *mut CrackBox, open_faces: u32) {
    crack_draw_vis(r, cam, t, stage, b, open_faces, 0 as *mut CrackVis)
}

fn crack_draw_vis(r: *mut mc_raster.Raster, cam: *mut mc_camera.Camera, t: *mut CrackTex, stage: i32, b: *mut CrackBox, open_faces: u32, vis: *mut CrackVis) {
    if stage < 0 || stage >= CRACK_STAGES || !crack_tex_ok(t) { return }
    var axis: i32 = 0
    while axis < 3 {
        var side: i32 = 0
        while side < 2 {
            let bit: u32 = (1 as u32) << ((axis * 2 + side) as u32)
            if (open_faces & bit) != 0 as u32 {
                var plane: f64 = face_lo(b, axis)
                if side == 1 { plane = face_hi(b, axis) }
                let o: f64 = cam_axis(cam, axis)
                var facing: bool = o < plane
                if side == 1 { facing = o > plane }
                if facing { draw_face(r, cam, t, stage, b, axis, plane, vis) }
            }
            side = side + 1
        }
        axis = axis + 1
    }
}
