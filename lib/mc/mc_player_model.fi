import std.math
import mc.mc_xf
import mc.mc_vox
import mc.mc_player_parts
import mc.mc_held_item
import mc.mc_entity_draw

export {
    Pose, pose_new, pm_draw, pm_draw_far, PLAYER_UNIT,
    ARM_NONE, ARM_EAT, ARM_BOW, ARM_BLOCK,
}

const ARM_NONE: i32 = 0
const ARM_EAT: i32 = 1
const ARM_BOW: i32 = 2
const ARM_BLOCK: i32 = 3
const PLAYER_UNIT: f64 = 0.05859375
const DEG: f64 = 0.017453292519943295
const RAD_DEG: f64 = 57.29577951308232

struct Pose {
    x: f64, y: f64, z: f64,
    body_yaw: f64, head_yaw: f64, pitch: f64,
    phase: f64, amount: f64,
    sneak: bool, prone: bool,
    swing: f64,
    arm_mode: i32,
    use_t: f64,
    time_s: f64,
    tint_k: i32,
}

fn pose_new() -> Pose {
    return Pose { x: 0.0, y: 0.0, z: 0.0, body_yaw: 0.0, head_yaw: 0.0, pitch: 0.0, phase: 0.0, amount: 0.0, sneak: false, prone: false,
        swing: 0.0 - 1.0, arm_mode: ARM_NONE, use_t: 0.0, time_s: 0.0, tint_k: 0 }
}

fn wrap_deg(a: f64) -> f64 {
    var r: f64 = a
    while r > 180.0 { r = r - 360.0 }
    while r < 0.0 - 180.0 { r = r + 360.0 }
    return r
}

fn base_xf(p: *mut Pose, sy: f64, cy: f64) -> mc_xf.Xf {
    var b: mc_xf.Xf = mc_xf.xf_ident()
    b.m[0] = 0.0 - cy
    b.m[2] = 0.0 - sy
    b.m[8] = 0.0 - sy
    b.m[10] = cy
    b.m[3] = (*p).x
    b.m[7] = (*p).y
    b.m[11] = (*p).z
    if (*p).prone {
        b.m[7] = b.m[7] + 0.3
        mc_xf.xf_rot_x(&b, 90.0)
    }
    mc_xf.xf_scale(&b, PLAYER_UNIT)
    return b
}

fn part_xf(b: *mut mc_xf.Xf, pd: *mut mc_player_parts.PartDef, dy: f64, dz: f64, rx: f64, ry: f64, rz: f64) -> mc_xf.Xf {
    var x: mc_xf.Xf = mc_xf.xf_copy(b)
    mc_xf.xf_translate(&x, (*pd).px, (*pd).py + dy, (*pd).pz + dz)
    mc_xf.xf_rot_z(&x, rz)
    mc_xf.xf_rot_y(&x, ry)
    mc_xf.xf_rot_x(&x, rx)
    return x
}

fn draw_item(l: *mut mc_entity_draw.EntList, arm: *mut mc_xf.Xf, h: *mut mc_held_item.Held, ys: f64, yc: f64, tint_k: i32) {
    let kind: i32 = mc_held_item.held_kind(h)
    if kind == mc_held_item.HELD_NONE { return }
    var x: mc_xf.Xf = mc_xf.xf_copy(arm)
    var s: f64 = mc_held_item.held_scale(kind)
    if kind == mc_held_item.HELD_BLOCK {
        mc_xf.xf_translate(&x, 0.0, 0.0 - 9.0, 3.0)
    } else if kind == mc_held_item.HELD_SHIELD {
        mc_xf.xf_translate(&x, 2.5, 0.0 - 6.0, 1.0)
        mc_xf.xf_rot_y(&x, 90.0)
    } else {
        mc_xf.xf_translate(&x, 0.0, 0.0 - 9.0, 1.0)
        mc_xf.xf_rot_y(&x, 0.0 - 90.0)
        mc_xf.xf_translate(&x, 4.0 * s, 4.0 * s, 0.0)
    }
    mc_xf.xf_scale(&x, s)
    mc_vox.vox_emit(l, mc_held_item.held_cubes(h), &x, PLAYER_UNIT * s, ys, yc, tint_k)
}

fn swing_arm_angle(t: f64) -> f64 {
    if t < 0.0 || t > 1.0 { return 0.0 }
    return math.sin(math.sqrt(t) * 3.141592653589793) * 75.0 + math.sin(t * 3.141592653589793) * 20.0
}

fn pm_draw(l: *mut mc_entity_draw.EntList, pc: *mut mc_player_parts.PlayerCubes, p: *mut Pose, h: *mut mc_held_item.Held) {
    let rad: f64 = (*p).body_yaw * DEG
    let sy: f64 = math.sin(rad)
    let cy: f64 = math.cos(rad)
    var base: mc_xf.Xf = base_xf(p, sy, cy)
    let ph: f64 = (*p).phase * 0.6662
    let am: f64 = (*p).amount
    let head_rel: f64 = wrap_deg((*p).head_yaw - (*p).body_yaw)
    var body_rx: f64 = 0.0
    var head_dy: f64 = 0.0
    var body_dy: f64 = 0.0
    var arm_dy: f64 = 0.0
    var leg_dy: f64 = 0.0
    var leg_dz: f64 = 0.0
    var arm_add: f64 = 0.0
    if (*p).sneak && !(*p).prone {
        body_rx = 28.6
        head_dy = 0.0 - 4.2
        body_dy = 0.0 - 3.2
        arm_dy = 0.0 - 5.2 + 2.0
        leg_dy = 0.0 - 0.2
        leg_dz = 0.0 - 4.0
        arm_add = 22.9
    }
    var twist: f64 = 0.0
    var rarm_rx: f64 = math.cos(ph + 3.141592653589793) * RAD_DEG * am + arm_add
    var larm_rx: f64 = math.cos(ph) * RAD_DEG * am + arm_add
    var rarm_ry: f64 = 0.0
    var larm_ry: f64 = 0.0
    var rarm_rz: f64 = (1.0 + math.cos((*p).time_s * 1.8)) * 3.0
    var larm_rz: f64 = 0.0 - rarm_rz
    if (*p).swing >= 0.0 && (*p).swing <= 1.0 {
        rarm_rx = rarm_rx - swing_arm_angle((*p).swing)
        twist = math.sin(math.sqrt((*p).swing) * 6.283185307179586) * 11.0
    }
    if (*p).arm_mode == ARM_EAT {
        let bob: f64 = math.fabs(math.cos((*p).time_s * 14.0)) * 6.0
        rarm_rx = 0.0 - 95.0 + bob
        rarm_ry = 0.0 - 22.0
        rarm_rz = 0.0
    } else if (*p).arm_mode == ARM_BOW {
        rarm_rx = 0.0 - 90.0 - (*p).pitch
        rarm_ry = 0.0 - 8.0
        larm_rx = 0.0 - 90.0 - (*p).pitch
        larm_ry = 18.0
        larm_rz = 0.0
        rarm_rz = 0.0
    } else if (*p).arm_mode == ARM_BLOCK {
        rarm_rx = 0.0 - 45.0
        rarm_ry = 0.0 - 30.0
        rarm_rz = 0.0
    }
    let i_head: usize = mc_player_parts.PART_HEAD
    let ys: f64 = sy
    let yc: f64 = 0.0 - cy
    var pd: mc_player_parts.PartDef = mc_player_parts.part_def(i_head, (*pc).slim)
    var x: mc_xf.Xf = part_xf(&base, &pd, head_dy, 0.0, (*p).pitch, head_rel, 0.0)
    mc_vox.vox_emit(l, &(*pc).parts[i_head], &x, PLAYER_UNIT, ys, yc, (*p).tint_k)
    pd = mc_player_parts.part_def(mc_player_parts.PART_BODY, (*pc).slim)
    x = part_xf(&base, &pd, body_dy, 0.0, body_rx, twist, 0.0)
    mc_vox.vox_emit(l, &(*pc).parts[mc_player_parts.PART_BODY], &x, PLAYER_UNIT, ys, yc, (*p).tint_k)
    pd = mc_player_parts.part_def(mc_player_parts.PART_RARM, (*pc).slim)
    x = part_xf(&base, &pd, arm_dy, 0.0, rarm_rx, rarm_ry, rarm_rz)
    mc_vox.vox_emit(l, &(*pc).parts[mc_player_parts.PART_RARM], &x, PLAYER_UNIT, ys, yc, (*p).tint_k)
    draw_item(l, &x, h, ys, yc, (*p).tint_k)
    pd = mc_player_parts.part_def(mc_player_parts.PART_LARM, (*pc).slim)
    x = part_xf(&base, &pd, arm_dy, 0.0, larm_rx, larm_ry, larm_rz)
    mc_vox.vox_emit(l, &(*pc).parts[mc_player_parts.PART_LARM], &x, PLAYER_UNIT, ys, yc, (*p).tint_k)
    pd = mc_player_parts.part_def(mc_player_parts.PART_RLEG, (*pc).slim)
    x = part_xf(&base, &pd, leg_dy, leg_dz, math.cos(ph) * 80.0 * am, 0.0, 0.0)
    mc_vox.vox_emit(l, &(*pc).parts[mc_player_parts.PART_RLEG], &x, PLAYER_UNIT, ys, yc, (*p).tint_k)
    pd = mc_player_parts.part_def(mc_player_parts.PART_LLEG, (*pc).slim)
    x = part_xf(&base, &pd, leg_dy, leg_dz, math.cos(ph + 3.141592653589793) * 80.0 * am, 0.0, 0.0)
    mc_vox.vox_emit(l, &(*pc).parts[mc_player_parts.PART_LLEG], &x, PLAYER_UNIT, ys, yc, (*p).tint_k)
}

fn pm_draw_far(l: *mut mc_entity_draw.EntList, pc: *mut mc_player_parts.PlayerCubes, p: *mut Pose) {
    let yaw: f64 = (*p).body_yaw
    let dx: [f64; 6] = [0.0, 0.0, 0.375, 0.0 - 0.375, 0.125, 0.0 - 0.125]
    let dy: [f64; 6] = [1.75, 1.125, 1.125, 1.125, 0.375, 0.375]
    let sx: [f64; 6] = [0.5, 0.5, 0.25, 0.25, 0.25, 0.25]
    let sh: [f64; 6] = [0.5, 0.75, 0.75, 0.75, 0.75, 0.75]
    let sz: [f64; 6] = [0.5, 0.25, 0.25, 0.25, 0.25, 0.25]
    var i: usize = 0
    while i < 6 {
        let c: u32 = (*pc).avg[i]
        mc_entity_draw.entlist_add_part(l, (*p).x, (*p).y, (*p).z, yaw, dx[i], dy[i], 0.0, sx[i], sh[i], sz[i],
            (c & 255 as u32) as i32, ((c >> 8 as u32) & 255 as u32) as i32, ((c >> 16 as u32) & 255 as u32) as i32)
        i = i + 1
    }
}
