import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_tip_util
import mc.mc_item_dur
import mc.mc_name_match

export { deco_arm, deco_pre, deco_post, deco_bar_width, deco_bar_color, deco_is_foil }

const TAG_DAMAGE: u8 = 100
const TAG_ENCH: u8 = 101
const TAG_STORED: u8 = 115
const TAG_MAX_DAMAGE: u8 = 109
const SNAP_CAP: usize = 16384

static mut ARM_P: u64 = 0
static mut ARM_N: usize = 0
static mut ARM_ON: bool = false
static mut SNAP: u64 = 0
static mut SNAP_ON: bool = false

fn deco_arm(p: u64, n: usize, valid: bool) {
    ARM_P = p
    ARM_N = n
    ARM_ON = valid
}

fn deco_bar_width(max: i32, dmg: i64) -> i32 {
    if max <= 0 { return 0 }
    var left: i64 = (max as i64) - dmg
    if left < 0 { left = 0 }
    return ((left * 26 + (max as i64)) / ((max as i64) * 2)) as i32
}

fn deco_bar_color(max: i32, dmg: i64) -> u32 {
    var left: i64 = (max as i64) - dmg
    if left < 0 { left = 0 }
    let t: i64 = (left * 510) / (max as i64)
    let sec: i64 = t / 255
    let f: u32 = (t % 255) as u32
    var rr: u32 = 255
    var gg: u32 = 0
    if sec == 0 { gg = f }
    if sec == 1 { rr = 255 - f; gg = 255 }
    if sec >= 2 { rr = 0; gg = 255 }
    return (0xFF000000 as u32) | (gg << 8 as u32) | rr
}

fn deco_is_foil(ip: u64, inn: usize, mp: u64, mn: usize, has: bool) -> bool {
    if mc_name_match.nm_is(ip, inn, "enchanted_golden_apple") || mc_name_match.nm_is(ip, inn, "experience_bottle") || mc_name_match.nm_is(ip, inn, "nether_star") || mc_name_match.nm_is(ip, inn, "end_crystal") || mc_name_match.nm_is(ip, inn, "written_book") { return true }
    if !has { return false }
    var lp: u64 = 0
    var ln: usize = 0
    return mc_tip_util.find_tag(mp, mn, TAG_ENCH, &lp, &ln) || mc_tip_util.find_tag(mp, mn, TAG_STORED, &lp, &ln)
}

fn deco_pre(r: *mut mc_raster.Raster, x: i32, y: i32, s: i32, ip: u64, inn: usize) {
    SNAP_ON = false
    var bp: u64 = 0
    var bn: usize = 0
    mc_tip_util.bare(ip, inn, &bp, &bn)
    if !deco_is_foil(bp, bn, ARM_P, ARM_N, ARM_ON) { return }
    let side: i32 = 16 * s
    if (side * side) as usize > SNAP_CAP { return }
    if SNAP == 0 as u64 { SNAP = rt.heap_alloc(SNAP_CAP * 4) }
    var j: i32 = 0
    while j < side {
        let yy: i32 = y + j
        var i: i32 = 0
        while i < side {
            let xx: i32 = x + i
            var v: u32 = 0
            if xx >= 0 && yy >= 0 && xx < (*r).w && yy < (*r).h { v = rt.ld32((*r).color, (yy * (*r).w + xx) as usize) }
            rt.st32(SNAP, (j * side + i) as usize, v)
            i = i + 1
        }
        j = j + 1
    }
    SNAP_ON = true
}

fn glint_pixels(r: *mut mc_raster.Raster, x: i32, y: i32, s: i32, now: u64) {
    let side: i32 = 16 * s
    let phase: i32 = ((now / 12 as u64) % (side * 4) as u64) as i32
    var j: i32 = 0
    while j < side {
        let yy: i32 = y + j
        var i: i32 = 0
        while i < side {
            let xx: i32 = x + i
            if xx >= 0 && yy >= 0 && xx < (*r).w && yy < (*r).h {
                let at: usize = (yy * (*r).w + xx) as usize
                let cur: u32 = rt.ld32((*r).color, at)
                if cur != rt.ld32(SNAP, (j * side + i) as usize) {
                    var d: i32 = (i + j + phase) % (side * 2)
                    if d > side { d = side * 2 - d }
                    let a: u32 = (28 + (d * 36) / side) as u32
                    let cr: u32 = cur & 255
                    let cg: u32 = (cur >> 8 as u32) & 255
                    let cb: u32 = (cur >> 16 as u32) & 255
                    let nr: u32 = (cr * (255 - a) + 128 * a) / 255
                    let ng: u32 = (cg * (255 - a) + 64 * a) / 255
                    let nb: u32 = (cb * (255 - a) + 255 * a) / 255
                    rt.st32((*r).color, at, (0xFF000000 as u32) | (nb << 16 as u32) | (ng << 8 as u32) | nr)
                }
            }
            i = i + 1
        }
        j = j + 1
    }
}

fn deco_post(r: *mut mc_raster.Raster, x: i32, y: i32, s: i32, ip: u64, inn: usize, now: u64) {
    if SNAP_ON { glint_pixels(r, x, y, s, now) }
    SNAP_ON = false
    if !ARM_ON { return }
    var dp: u64 = 0
    var dn: usize = 0
    if !mc_tip_util.find_tag(ARM_P, ARM_N, TAG_DAMAGE, &dp, &dn) { return }
    var ok: bool = false
    let dmg: i64 = mc_tip_util.parse_num(dp, dn, &ok)
    if !ok || dmg <= 0 { return }
    var bp: u64 = 0
    var bn: usize = 0
    mc_tip_util.bare(ip, inn, &bp, &bn)
    var mx: i32 = mc_item_dur.dur_max(bp, bn)
    var mp: u64 = 0
    var mn: usize = 0
    if mc_tip_util.find_tag(ARM_P, ARM_N, TAG_MAX_DAMAGE, &mp, &mn) {
        var ok2: bool = false
        let cm: i64 = mc_tip_util.parse_num(mp, mn, &ok2)
        if ok2 && cm > 0 && cm < 1000000 { mx = cm as i32 }
    }
    if mx <= 0 { return }
    let w: i32 = deco_bar_width(mx, dmg)
    mc_hud.hud_rect(r, x + 2 * s, y + 13 * s, 13 * s, 2 * s, 0xFF000000 as u32)
    mc_hud.hud_rect(r, x + 2 * s, y + 13 * s, w * s, s, deco_bar_color(mx, dmg))
}
