fn blob_base() -> u64 {
    return SCHEMA_BLOB.p as u64
}

// Offset of the 6 octet table entry of (state, dir, id), or 0.
fn table_entry(state: i32, dir: i32, id: i32) -> usize {
    if id < 0 {
        return 0
    }
    var off: usize = 0
    var len: i32 = 0
    var k: i32 = state * 2 + dir
    if k == 0 {
        off = TAB_HANDSHAKE_C2S
        len = TAB_HANDSHAKE_C2S_LEN
    }
    if k == 1 {
        off = TAB_HANDSHAKE_S2C
        len = TAB_HANDSHAKE_S2C_LEN
    }
    if k == 2 {
        off = TAB_STATUS_C2S
        len = TAB_STATUS_C2S_LEN
    }
    if k == 3 {
        off = TAB_STATUS_S2C
        len = TAB_STATUS_S2C_LEN
    }
    if k == 4 {
        off = TAB_LOGIN_C2S
        len = TAB_LOGIN_C2S_LEN
    }
    if k == 5 {
        off = TAB_LOGIN_S2C
        len = TAB_LOGIN_S2C_LEN
    }
    if k == 6 {
        off = TAB_PLAY_C2S
        len = TAB_PLAY_C2S_LEN
    }
    if k == 7 {
        off = TAB_PLAY_S2C
        len = TAB_PLAY_S2C_LEN
    }
    if k == 8 {
        off = TAB_CONFIG_C2S
        len = TAB_CONFIG_C2S_LEN
    }
    if k == 9 {
        off = TAB_CONFIG_S2C
        len = TAB_CONFIG_S2C_LEN
    }
    if id >= len {
        return 0
    }
    return off + (id as usize) * 6
}

fn table_field(entry: usize, which: usize) -> usize {
    let base: u64 = blob_base()
    let i: usize = entry + which * 3
    let a: usize = rt.ld8(base, i) as usize
    let b: usize = rt.ld8(base, i + 1) as usize
    let c: usize = rt.ld8(base, i + 2) as usize
    return (a << 14) | (b << 7) | c
}

// NUL terminated packet name (a pointer into the blob) or 0.
fn packet_name(state: i32, dir: i32, id: i32) -> u64 {
    let e: usize = table_entry(state, dir, id)
    if e == 0 {
        return 0
    }
    let o: usize = table_field(e, 0)
    if o == 0 {
        return 0
    }
    return blob_base() + o as u64
}

// Handle for mc_schema.walk: the address of the packet's program, or 0.
fn packet_schema(state: i32, dir: i32, id: i32) -> u64 {
    let e: usize = table_entry(state, dir, id)
    if e == 0 {
        return 0
    }
    let o: usize = table_field(e, 1)
    if o == 0 {
        return 0
    }
    return blob_base() + o as u64
}

// Highest packet id + 1 of a (state, dir) table: for loops over all packets.
fn packet_id_limit(state: i32, dir: i32) -> i32 {
    var len: i32 = 0
    var k: i32 = state * 2 + dir
    if k == 0 {
        len = TAB_HANDSHAKE_C2S_LEN
    }
    if k == 1 {
        len = TAB_HANDSHAKE_S2C_LEN
    }
    if k == 2 {
        len = TAB_STATUS_C2S_LEN
    }
    if k == 3 {
        len = TAB_STATUS_S2C_LEN
    }
    if k == 4 {
        len = TAB_LOGIN_C2S_LEN
    }
    if k == 5 {
        len = TAB_LOGIN_S2C_LEN
    }
    if k == 6 {
        len = TAB_PLAY_C2S_LEN
    }
    if k == 7 {
        len = TAB_PLAY_S2C_LEN
    }
    if k == 8 {
        len = TAB_CONFIG_C2S_LEN
    }
    if k == 9 {
        len = TAB_CONFIG_S2C_LEN
    }
    return len
}

// The version object: protocol number, feature flags, chunk format, the semantic
// packet ids (mc_sem.fi) and the three lookup functions as function values.
fn version_make() -> mc_version.Version {
    var v: mc_version.Version = mc_version.version_empty()
    v.protocol = 764
    v.flags = mc_version.FLAG_COMPRESSION | mc_version.FLAG_PALETTE_CHUNKS | mc_version.FLAG_FLATTENING | mc_version.FLAG_HEIGHTMAPS | mc_version.FLAG_SIGNED_CHAT | mc_version.FLAG_LOGIN_UUID_REQUIRED | mc_version.FLAG_BIOME_CONTAINERS | mc_version.FLAG_CONFIG_PHASE | mc_version.FLAG_NBT_ANON | mc_version.FLAG_CHUNK_BATCHES
    v.chunk_format = mc_version.CF_CONTAINERS_118
    v.name = VERSION_NAME.p as u64
    v.name_len = 6
    v.id_limit = packet_id_limit
    v.name_of = packet_name
    v.schema_of = packet_schema
    v.registry_of = mc_reg_v764.registry_make
    v.sem[mc_sem.SEM_HANDSHAKE_C2S_SET_PROTOCOL] = 0
    v.sem[mc_sem.SEM_STATUS_C2S_PING_START] = 0
    v.sem[mc_sem.SEM_STATUS_C2S_PING] = 1
    v.sem[mc_sem.SEM_STATUS_S2C_SERVER_INFO] = 0
    v.sem[mc_sem.SEM_STATUS_S2C_PING] = 1
    v.sem[mc_sem.SEM_LOGIN_C2S_LOGIN_START] = 0
    v.sem[mc_sem.SEM_LOGIN_C2S_ENCRYPTION_BEGIN] = 1
    v.sem[mc_sem.SEM_LOGIN_C2S_PLUGIN_RESPONSE] = 2
    v.sem[mc_sem.SEM_LOGIN_C2S_LOGIN_ACKNOWLEDGED] = 3
    v.sem[mc_sem.SEM_LOGIN_S2C_DISCONNECT] = 0
    v.sem[mc_sem.SEM_LOGIN_S2C_ENCRYPTION_BEGIN] = 1
    v.sem[mc_sem.SEM_LOGIN_S2C_SUCCESS] = 2
    v.sem[mc_sem.SEM_LOGIN_S2C_COMPRESS] = 3
    v.sem[mc_sem.SEM_LOGIN_S2C_PLUGIN_REQUEST] = 4
    v.sem[mc_sem.SEM_CONFIG_C2S_SETTINGS] = 0
    v.sem[mc_sem.SEM_CONFIG_C2S_FINISH] = 2
    v.sem[mc_sem.SEM_CONFIG_C2S_KEEP_ALIVE] = 3
    v.sem[mc_sem.SEM_CONFIG_S2C_DISCONNECT] = 1
    v.sem[mc_sem.SEM_CONFIG_S2C_FINISH] = 2
    v.sem[mc_sem.SEM_CONFIG_S2C_KEEP_ALIVE] = 3
    v.sem[mc_sem.SEM_CONFIG_S2C_REGISTRY_DATA] = 5
    v.sem[mc_sem.SEM_PLAY_S2C_KEEP_ALIVE] = 36
    v.sem[mc_sem.SEM_PLAY_S2C_JOIN_GAME] = 41
    v.sem[mc_sem.SEM_PLAY_S2C_RESPAWN] = 67
    v.sem[mc_sem.SEM_PLAY_S2C_POSITION] = 62
    v.sem[mc_sem.SEM_PLAY_S2C_MAP_CHUNK] = 37
    v.sem[mc_sem.SEM_PLAY_S2C_UNLOAD_CHUNK] = 31
    v.sem[mc_sem.SEM_PLAY_S2C_UPDATE_LIGHT] = 40
    v.sem[mc_sem.SEM_PLAY_S2C_UPDATE_VIEW_POSITION] = 80
    v.sem[mc_sem.SEM_PLAY_S2C_BLOCK_CHANGE] = 9
    v.sem[mc_sem.SEM_PLAY_S2C_MULTI_BLOCK_CHANGE] = 69
    v.sem[mc_sem.SEM_PLAY_S2C_TILE_ENTITY_DATA] = 7
    v.sem[mc_sem.SEM_PLAY_S2C_KICK_DISCONNECT] = 27
    v.sem[mc_sem.SEM_PLAY_S2C_CHAT] = 55
    v.sem[mc_sem.SEM_PLAY_S2C_CHUNK_BATCH_START] = 13
    v.sem[mc_sem.SEM_PLAY_S2C_CHUNK_BATCH_FINISHED] = 12
    v.sem[mc_sem.SEM_PLAY_S2C_START_CONFIGURATION] = 101
    v.sem[mc_sem.SEM_PLAY_C2S_TELEPORT_CONFIRM] = 0
    v.sem[mc_sem.SEM_PLAY_C2S_KEEP_ALIVE] = 20
    v.sem[mc_sem.SEM_PLAY_C2S_SETTINGS] = 9
    v.sem[mc_sem.SEM_PLAY_C2S_POSITION] = 22
    v.sem[mc_sem.SEM_PLAY_C2S_POSITION_LOOK] = 23
    v.sem[mc_sem.SEM_PLAY_C2S_LOOK] = 24
    v.sem[mc_sem.SEM_PLAY_C2S_CUSTOM_PAYLOAD] = 15
    v.sem[mc_sem.SEM_PLAY_C2S_CHAT] = 5
    v.sem[mc_sem.SEM_PLAY_C2S_CHUNK_BATCH_RECEIVED] = 7
    v.sem[mc_sem.SEM_PLAY_C2S_CONFIGURATION_ACKNOWLEDGED] = 11
    v.sem[mc_sem.SEM_CONFIG_S2C_SELECT_KNOWN_PACKS] = -1
    v.sem[mc_sem.SEM_CONFIG_C2S_SELECT_KNOWN_PACKS] = -1
    return v
}

const VERSION_NAME: str = "1.20.2"
