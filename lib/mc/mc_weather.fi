// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.bytes
import mc.mc_client
import mc.mc_sem
import mc.mc_pkt_field

export {
    Weather, weather_new, weather_reset, weather_on_game_state, weather_on_packet, weather_on_respawn,
    weather_rain_milli, weather_thunder_milli, weather_sky_rain, weather_raining, weather_thundering, weather_active, weather_set_local,
    GS_RAIN_STOP, GS_RAIN_START, GS_RAIN_LEVEL, GS_THUNDER_LEVEL, LEVEL_MAX,
}

const GS_RAIN_START: i32 = 1
const GS_RAIN_STOP: i32 = 2
const GS_RAIN_LEVEL: i32 = 7
const GS_THUNDER_LEVEL: i32 = 8
const LEVEL_MAX: i32 = 1000
const SKY_RAIN_MAX: i32 = 192
const SKY_THUNDER_EXTRA: i32 = 64

struct Weather {
    raining: bool,
    rain: i32,
    thunder: i32,
    n_events: u64,
    kind: i32,
    exposure: i32,
}

fn weather_new() -> Weather {
    return Weather { raining: false, rain: 0, thunder: 0, n_events: 0 as u64, kind: 1, exposure: LEVEL_MAX }
}

fn weather_reset(w: *mut Weather) {
    (*w).raining = false
    (*w).rain = 0
    (*w).thunder = 0
}

fn clamp_level(v: i32) -> i32 {
    if v < 0 { return 0 }
    if v > LEVEL_MAX { return LEVEL_MAX }
    return v
}

fn level_from_f32(v: f32) -> i32 {
    let d: f64 = v as f64
    if !(d < 1000.0 && d > -1000.0) { return 0 }
    return clamp_level((d * 1000.0 + 0.5) as i32)
}

fn weather_on_game_state(w: *mut Weather, reason: i32, value: f32) -> bool {
    if reason == GS_RAIN_STOP {
        (*w).raining = false
        (*w).rain = LEVEL_MAX
    } else if reason == GS_RAIN_START {
        (*w).raining = true
        (*w).rain = 0
    } else if reason == GS_RAIN_LEVEL {
        (*w).rain = level_from_f32(value)
    } else if reason == GS_THUNDER_LEVEL {
        (*w).thunder = level_from_f32(value)
    } else {
        return false
    }
    (*w).n_events = (*w).n_events + 1 as u64
    return true
}

fn weather_set_local(w: *mut Weather, kind: i32, exposure: i32) {
    (*w).kind = kind
    (*w).exposure = clamp_level(exposure)
}

fn weather_rain_milli(w: *mut Weather) -> i32 {
    return (*w).rain
}

fn weather_thunder_milli(w: *mut Weather) -> i32 {
    return ((*w).thunder * (*w).rain) / LEVEL_MAX
}

fn weather_raining(w: *mut Weather) -> bool {
    return (*w).rain > 200
}

fn weather_thundering(w: *mut Weather) -> bool {
    return weather_thunder_milli(w) > 900
}

fn weather_active(w: *mut Weather) -> bool {
    return (*w).rain > 0
}

fn weather_sky_rain(w: *mut Weather) -> i32 {
    let base: i32 = ((*w).rain * SKY_RAIN_MAX) / LEVEL_MAX
    let extra: i32 = (weather_thunder_milli(w) * SKY_THUNDER_EXTRA) / LEVEL_MAX
    var v: i32 = base + extra
    if v > 256 { v = 256 }
    return v
}

fn weather_on_respawn(w: *mut Weather) {
    weather_reset(w)
}

fn weather_on_packet(w: *mut Weather, cl: *mut mc_client.Client, id: i32) -> bool {
    if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_GAME_STATE_CHANGE) {
        var reason: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
        var value: f32 = 0.0 as f32
        if mc_pkt_field.pkt_view(cl, id, "reason", &reason) && reason.len == 1 && mc_pkt_field.pkt_f32(cl, id, "gameMode", &value) {
            return weather_on_game_state(w, rt.ld8(reason.data, 0) as i32, value)
        }
        return false
    }
    if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_RESPAWN) {
        weather_on_respawn(w)
        return true
    }
    return false
}
