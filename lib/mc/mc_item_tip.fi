import std.rt
import mc.mc_text
import mc.mc_tip_lines
import mc.mc_item_names
import mc.mc_item_dur
import mc.mc_name_match

export { tip_build, tip_rarity_rgb }

const C_WHITE: i32 = 0xFFFFFF
const C_YELLOW: i32 = 0xFFFF55
const C_AQUA: i32 = 0x55FFFF
const C_PINK: i32 = 0xFF55FF
const C_GRAY: i32 = 0xAAAAAA
const C_RED: i32 = 0xFF5555
const C_BLUE: i32 = 0x5555FF
const C_PURPLE: i32 = 0xAA00AA
const F_ITALIC: u32 = 2

const TAG_DAMAGE: u8 = 100
const TAG_ENCH: u8 = 101
const TAG_STORED: u8 = 115
const TAG_ENCH_ID: u8 = 69
const TAG_STORED_ID: u8 = 83
const TAG_LORE: u8 = 108
const TAG_NAME: u8 = 110
const TAG_ITEM_NAME: u8 = 105
const TAG_UNBREAKABLE: u8 = 117
const TAG_ATTR: u8 = 97

const STATIC_ENCH: str = "protection fire_protection feather_falling blast_protection projectile_protection respiration aqua_affinity thorns depth_strider frost_walker binding_curse soul_speed swift_sneaking sharpness smite bane_of_arthropods knockback fire_aspect looting sweeping_edge efficiency silk_touch unbreaking fortune power punch flame infinity luck_of_the_sea lure loyalty impaling riptide channeling multishot quick_charge piercing mending vanishing_curse"
const SLOTS: str = "mainhand offhand feet legs chest head"
const ROMAN: str = "I II III IV V VI VII VIII IX X"

fn bare(p: u64, n: usize, out_p: *mut u64, out_n: *mut usize) {
    var i: usize = 0
    while i < n && rt.ld8(p, i) != 58 as u8 { i = i + 1 }
    if i >= n {
        *out_p = p
        *out_n = n
        return
    }
    *out_p = p + ((i + 1) as u64)
    *out_n = n - i - 1
}

fn base_rarity(p: u64, n: usize) -> i32 {
    if mc_name_match.nm_is(p, n, "enchanted_golden_apple") || mc_name_match.nm_is(p, n, "dragon_egg") || mc_name_match.nm_is(p, n, "command_block") { return 3 }
    if mc_name_match.nm_is(p, n, "chain_command_block") || mc_name_match.nm_is(p, n, "repeating_command_block") || mc_name_match.nm_is(p, n, "command_block_minecart") { return 3 }
    if mc_name_match.nm_is(p, n, "structure_block") || mc_name_match.nm_is(p, n, "jigsaw") || mc_name_match.nm_is(p, n, "debug_stick") { return 3 }
    if mc_name_match.nm_is(p, n, "golden_apple") || mc_name_match.nm_is(p, n, "beacon") || mc_name_match.nm_is(p, n, "conduit") { return 2 }
    if mc_name_match.nm_prefix(p, n, "music_disc_") { return 2 }
    if mc_name_match.nm_is(p, n, "nether_star") || mc_name_match.nm_is(p, n, "elytra") || mc_name_match.nm_is(p, n, "totem_of_undying") { return 1 }
    if mc_name_match.nm_is(p, n, "heart_of_the_sea") || mc_name_match.nm_is(p, n, "enchanted_book") || mc_name_match.nm_is(p, n, "experience_bottle") { return 1 }
    if mc_name_match.nm_is(p, n, "dragon_breath") || mc_name_match.nm_is(p, n, "wither_skeleton_skull") || mc_name_match.nm_is(p, n, "creeper_head") { return 1 }
    if mc_name_match.nm_is(p, n, "dragon_head") || mc_name_match.nm_is(p, n, "zombie_head") || mc_name_match.nm_is(p, n, "skeleton_skull") || mc_name_match.nm_is(p, n, "piglin_head") { return 1 }
    return 0
}

fn tip_rarity_rgb(item_p: u64, item_n: usize, enchanted: bool) -> i32 {
    var ip: u64 = 0
    var inn: usize = 0
    bare(item_p, item_n, &ip, &inn)
    var r: i32 = base_rarity(ip, inn)
    if enchanted {
        if r < 2 { r = 2 } else if r == 2 { r = 3 }
    }
    if r == 1 { return C_YELLOW }
    if r == 2 { return C_AQUA }
    if r == 3 { return C_PINK }
    return C_WHITE
}

fn next_line(rp: u64, rn: usize, pos: *mut usize, tag: *mut u8, lp: *mut u64, ln: *mut usize) -> bool {
    if *pos >= rn { return false }
    var e: usize = *pos
    while e < rn && rt.ld8(rp, e) != 10 as u8 { e = e + 1 }
    *tag = rt.ld8(rp, *pos)
    *lp = rp + ((*pos + 1) as u64)
    *ln = e - *pos - 1
    *pos = e + 1
    return true
}

fn find_tag(rp: u64, rn: usize, want: u8, out_p: *mut u64, out_n: *mut usize) -> bool {
    var pos: usize = 0
    var tag: u8 = 0 as u8
    var lp: u64 = 0
    var ln: usize = 0
    while next_line(rp, rn, &pos, &tag, &lp, &ln) {
        if tag == want {
            *out_p = lp
            *out_n = ln
            return true
        }
    }
    return false
}

fn parse_num(p: u64, n: usize, ok: *mut bool) -> i64 {
    var i: usize = 0
    var neg: bool = false
    var r: i64 = 0
    *ok = n > 0
    if n > 0 && rt.ld8(p, 0) == 45 as u8 { neg = true; i = 1; *ok = n > 1 }
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 { *ok = false; return 0 }
        r = r * 10 + ((c as i64) - 48)
        if r > 2000000000000 { *ok = false; return 0 }
        i = i + 1
    }
    if neg { r = 0 - r }
    return r
}

fn split_tab(p: u64, n: usize, from: usize, out_p: *mut u64, out_n: *mut usize) -> usize {
    var e: usize = from
    while e < n && rt.ld8(p, e) != 9 as u8 { e = e + 1 }
    *out_p = p + (from as u64)
    *out_n = e - from
    if e < n { return e + 1 }
    return n
}

fn nth_word(p: u64, n: usize, idx: i32, sep: u8, out_p: *mut u64, out_n: *mut usize) -> bool {
    var cur: i32 = 0
    var s: usize = 0
    var i: usize = 0
    while i <= n {
        if i == n || rt.ld8(p, i) == sep {
            if cur == idx {
                *out_p = p + (s as u64)
                *out_n = i - s
                return i > s
            }
            cur = cur + 1
            s = i + 1
        }
        i = i + 1
    }
    return false
}

fn put_fmt(out: *mut rt.Buf, tp: u64, tn: usize, ap: u64, an: usize, bp: u64, bn: usize) {
    var i: usize = 0
    var next: i32 = 0
    while i < tn {
        let c: u8 = rt.ld8(tp, i)
        var which: i32 = 0 - 1
        var adv: usize = 1
        if c == 37 as u8 && i + 1 < tn {
            let d: u8 = rt.ld8(tp, i + 1)
            if d == 37 as u8 {
                rt.buf_push(out, 37 as u8)
                i = i + 2
                continue
            }
            if d == 115 as u8 {
                which = next
                next = next + 1
                adv = 2
            } else if d >= 49 as u8 && d <= 50 as u8 && i + 3 < tn && rt.ld8(tp, i + 2) == 36 as u8 && rt.ld8(tp, i + 3) == 115 as u8 {
                which = (d as i32) - 49
                adv = 4
            }
        }
        if which == 0 {
            rt.buf_push_bytes(out, ap, an)
        } else if which == 1 {
            rt.buf_push_bytes(out, bp, bn)
        } else {
            rt.buf_push(out, c)
        }
        i = i + adv
    }
}

fn lang_fmt(key: str, fallback: str, ap: u64, an: usize, bp: u64, bn: usize, out: *mut rt.Buf) {
    var t: rt.Buf = rt.buf_new()
    if !mc_item_names.names_find(key.p as u64, key.n, &t) { rt.buf_push_bytes(&t, fallback.p as u64, fallback.n) }
    put_fmt(out, rt.buf_ptr(&t), rt.buf_len(&t), ap, an, bp, bn)
    rt.buf_free(&t)
}

fn put_hundredths(out: *mut rt.Buf, v: i64) {
    var a: i64 = v
    if a < 0 { a = 0 - a }
    rt.buf_push_dec_i64(out, a / 100)
    let f: i64 = a % 100
    if f != 0 {
        rt.buf_push(out, 46 as u8)
        rt.buf_push(out, (48 + f / 10) as u8)
        if (f % 10) != 0 { rt.buf_push(out, (48 + f % 10) as u8) }
    }
}

fn level_text(level: i64, out: *mut rt.Buf) {
    var key: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&key, "enchantment.level.".p as u64, 18)
    rt.buf_push_dec_i64(&key, level)
    if !mc_item_names.names_find(rt.buf_ptr(&key), rt.buf_len(&key), out) {
        var wp: u64 = 0
        var wn: usize = 0
        if level >= 1 && level <= 10 && nth_word(ROMAN.p as u64, ROMAN.n, (level - 1) as i32, 32 as u8, &wp, &wn) {
            rt.buf_push_bytes(out, wp, wn)
        } else {
            rt.buf_push_dec_i64(out, level)
        }
    }
    rt.buf_free(&key)
}

fn single_level(kp: u64, kn: usize) -> bool {
    var p: u64 = 0
    var n: usize = 0
    bare(kp, kn, &p, &n)
    if mc_name_match.nm_is(p, n, "mending") || mc_name_match.nm_is(p, n, "silk_touch") || mc_name_match.nm_is(p, n, "infinity") { return true }
    if mc_name_match.nm_is(p, n, "flame") || mc_name_match.nm_is(p, n, "channeling") || mc_name_match.nm_is(p, n, "multishot") { return true }
    if mc_name_match.nm_is(p, n, "aqua_affinity") || mc_name_match.nm_suffix(p, n, "_curse") { return true }
    return false
}

fn resolve_enchant(protocol: i32, ep: u64, en: usize, id: i64, out_p: *mut u64, out_n: *mut usize) -> bool {
    if id < 0 || id > 100000 { return false }
    if protocol < 767 { return nth_word(STATIC_ENCH.p as u64, STATIC_ENCH.n, id as i32, 32 as u8, out_p, out_n) }
    return nth_word(ep, en, id as i32, 10 as u8, out_p, out_n)
}

fn add_enchant(t: *mut mc_tip_lines.TipLines, tag: u8, protocol: i32, ep: u64, en: usize, lp: u64, ln: usize) {
    var kp: u64 = 0
    var kn: usize = 0
    var vp: u64 = 0
    var vn: usize = 0
    let at: usize = split_tab(lp, ln, 0, &kp, &kn)
    split_tab(lp, ln, at, &vp, &vn)
    var ok: bool = false
    let level: i64 = parse_num(vp, vn, &ok)
    if !ok { return }
    if tag == TAG_ENCH_ID || tag == TAG_STORED_ID {
        var id_ok: bool = false
        let id: i64 = parse_num(kp, kn, &id_ok)
        if !id_ok { return }
        var rp: u64 = 0
        var rn: usize = 0
        if !resolve_enchant(protocol, ep, en, id, &rp, &rn) { return }
        kp = rp
        kn = rn
    }
    var line: rt.Buf = rt.buf_new()
    mc_item_names.names_ench(kp, kn, &line)
    if !(level == 1 && single_level(kp, kn)) {
        rt.buf_push(&line, 32 as u8)
        level_text(level, &line)
    }
    var rgb: i32 = C_GRAY
    var bp: u64 = 0
    var bn: usize = 0
    bare(kp, kn, &bp, &bn)
    if mc_name_match.nm_suffix(bp, bn, "_curse") { rgb = C_RED }
    mc_tip_lines.tl_add_plain(t, rgb, 0 as u32, rt.buf_ptr(&line), rt.buf_len(&line))
    rt.buf_free(&line)
}

fn add_attribute_group(t: *mut mc_tip_lines.TipLines, rp: u64, rn: usize, slot_p: u64, slot_n: usize) {
    var started: bool = false
    var pos: usize = 0
    var tag: u8 = 0 as u8
    var lp: u64 = 0
    var ln: usize = 0
    while next_line(rp, rn, &pos, &tag, &lp, &ln) {
        if tag != TAG_ATTR { continue }
        var np: u64 = 0
        var nn: usize = 0
        var ap: u64 = 0
        var an: usize = 0
        var op: u64 = 0
        var on: usize = 0
        var sp: u64 = 0
        var sn: usize = 0
        var at: usize = split_tab(lp, ln, 0, &np, &nn)
        at = split_tab(lp, ln, at, &ap, &an)
        at = split_tab(lp, ln, at, &op, &on)
        split_tab(lp, ln, at, &sp, &sn)
        if sn != slot_n || !rt.mem_eq(sp, slot_p, slot_n) { continue }
        var ok: bool = false
        var amount: i64 = parse_num(ap, an, &ok)
        if !ok { continue }
        var opv: i64 = parse_num(op, on, &ok)
        if !ok { opv = 0 }
        if !started {
            started = true
            mc_tip_lines.tl_add_blank(t)
            var hk: rt.Buf = rt.buf_new()
            rt.buf_push_bytes(&hk, "item.modifiers.".p as u64, 15)
            rt.buf_push_bytes(&hk, slot_p, slot_n)
            var hv: rt.Buf = rt.buf_new()
            if !mc_item_names.names_find(rt.buf_ptr(&hk), rt.buf_len(&hk), &hv) { rt.buf_push_bytes(&hv, "When equipped:".p as u64, 14) }
            mc_tip_lines.tl_add_plain(t, C_GRAY, 0 as u32, rt.buf_ptr(&hv), rt.buf_len(&hv))
            rt.buf_free(&hk)
            rt.buf_free(&hv)
        }
        var bp: u64 = 0
        var bn: usize = 0
        bare(np, nn, &bp, &bn)
        if opv == 0 && mc_name_match.nm_is(bp, bn, "knockback_resistance") { amount = amount * 10 }
        var num: rt.Buf = rt.buf_new()
        put_hundredths(&num, amount)
        var an2: rt.Buf = rt.buf_new()
        mc_item_names.names_attr(np, nn, &an2)
        var key: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&key, "attribute.modifier.".p as u64, 19)
        var rgb: i32 = C_BLUE
        var fb: rt.Buf = rt.buf_new()
        if amount < 0 {
            rgb = C_RED
            rt.buf_push_bytes(&key, "take.".p as u64, 5)
            rt.buf_push(&fb, 45 as u8)
        } else {
            rt.buf_push_bytes(&key, "plus.".p as u64, 5)
            rt.buf_push(&fb, 43 as u8)
        }
        rt.buf_push_dec_i64(&key, opv)
        rt.buf_push_bytes(&fb, "%s".p as u64, 2)
        if opv != 0 { rt.buf_push(&fb, 37 as u8); rt.buf_push(&fb, 37 as u8) }
        rt.buf_push_bytes(&fb, " %s".p as u64, 3)
        var line: rt.Buf = rt.buf_new()
        var t2: rt.Buf = rt.buf_new()
        if !mc_item_names.names_find(rt.buf_ptr(&key), rt.buf_len(&key), &t2) { rt.buf_push_bytes(&t2, rt.buf_ptr(&fb), rt.buf_len(&fb)) }
        put_fmt(&line, rt.buf_ptr(&t2), rt.buf_len(&t2), rt.buf_ptr(&num), rt.buf_len(&num), rt.buf_ptr(&an2), rt.buf_len(&an2))
        mc_tip_lines.tl_add_plain(t, rgb, 0 as u32, rt.buf_ptr(&line), rt.buf_len(&line))
        rt.buf_free(&num)
        rt.buf_free(&an2)
        rt.buf_free(&key)
        rt.buf_free(&fb)
        rt.buf_free(&line)
        rt.buf_free(&t2)
    }
}

fn add_attributes(t: *mut mc_tip_lines.TipLines, rp: u64, rn: usize) {
    var wp: u64 = 0
    var wn: usize = 0
    var k: i32 = 0
    while nth_word(SLOTS.p as u64, SLOTS.n, k, 32 as u8, &wp, &wn) {
        add_attribute_group(t, rp, rn, wp, wn)
        k = k + 1
    }
}

fn add_name(t: *mut mc_tip_lines.TipLines, rp: u64, rn: usize, ip: u64, inn: usize, rgb: i32) {
    var np: u64 = 0
    var nn: usize = 0
    if find_tag(rp, rn, TAG_NAME, &np, &nn) {
        if mc_tip_lines.tl_add_json(t, rgb, F_ITALIC, np, nn, mc_item_names.names_tr()) { return }
    }
    if find_tag(rp, rn, TAG_ITEM_NAME, &np, &nn) {
        if mc_tip_lines.tl_add_json(t, rgb, 0 as u32, np, nn, mc_item_names.names_tr()) { return }
    }
    var b: rt.Buf = rt.buf_new()
    mc_item_names.names_item(ip, inn, &b)
    mc_tip_lines.tl_add_plain(t, rgb, 0 as u32, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn tip_build(t: *mut mc_tip_lines.TipLines, rp: u64, rn: usize, ip: u64, inn: usize, protocol: i32, ep: u64, en: usize) {
    var pos: usize = 0
    var tag: u8 = 0 as u8
    var lp: u64 = 0
    var ln: usize = 0
    var enchanted: bool = false
    var unbreakable: bool = false
    while next_line(rp, rn, &pos, &tag, &lp, &ln) {
        if tag == TAG_ENCH || tag == TAG_ENCH_ID { enchanted = true }
        if tag == TAG_UNBREAKABLE { unbreakable = true }
    }
    add_name(t, rp, rn, ip, inn, tip_rarity_rgb(ip, inn, enchanted))
    pos = 0
    while next_line(rp, rn, &pos, &tag, &lp, &ln) {
        if tag == TAG_ENCH || tag == TAG_STORED || tag == TAG_ENCH_ID || tag == TAG_STORED_ID { add_enchant(t, tag, protocol, ep, en, lp, ln) }
    }
    pos = 0
    while next_line(rp, rn, &pos, &tag, &lp, &ln) {
        if tag == TAG_LORE { mc_tip_lines.tl_add_json(t, C_PURPLE, F_ITALIC, lp, ln, mc_item_names.names_tr()) }
    }
    add_attributes(t, rp, rn)
    if unbreakable {
        var u: rt.Buf = rt.buf_new()
        if !mc_item_names.names_find("item.unbreakable".p as u64, 16, &u) { rt.buf_push_bytes(&u, "Unbreakable".p as u64, 11) }
        mc_tip_lines.tl_add_plain(t, C_BLUE, 0 as u32, rt.buf_ptr(&u), rt.buf_len(&u))
        rt.buf_free(&u)
        return
    }
    var dp: u64 = 0
    var dn: usize = 0
    if find_tag(rp, rn, TAG_DAMAGE, &dp, &dn) {
        var bp: u64 = 0
        var bn: usize = 0
        bare(ip, inn, &bp, &bn)
        let mx: i32 = mc_item_dur.dur_max(bp, bn)
        var ok: bool = false
        let dmg: i64 = parse_num(dp, dn, &ok)
        if ok && mx > 0 {
            var left: i64 = (mx as i64) - dmg
            if left < 0 { left = 0 }
            var a: rt.Buf = rt.buf_new()
            var b: rt.Buf = rt.buf_new()
            var line: rt.Buf = rt.buf_new()
            rt.buf_push_dec_i64(&a, left)
            rt.buf_push_dec_i64(&b, mx as i64)
            lang_fmt("item.durability", "Durability: %s / %s", rt.buf_ptr(&a), rt.buf_len(&a), rt.buf_ptr(&b), rt.buf_len(&b), &line)
            mc_tip_lines.tl_add_plain(t, C_WHITE, 0 as u32, rt.buf_ptr(&line), rt.buf_len(&line))
            rt.buf_free(&a)
            rt.buf_free(&b)
            rt.buf_free(&line)
        }
    }
}
