// SPDX-License-Identifier: MPL-2.0
export { ViewFog, WaterFogColor, wfc_new, wfc_step, wfog_vision, wfog_end, wfog_view, wfog_fov, WFOG_START, WFOG_FOV_SCALE, WFOG_BLEND_MS }

const WFOG_START: f64 = 0.0 - 8.0
const WFOG_FAR: f64 = 96.0
const WFOG_FOV_SCALE: f64 = 0.85714287
const WFOG_BLEND_MS: u64 = 5000 as u64
const WFOG_FLOOR: i32 = 24

struct WaterFogColor {
    target: u32,
    prev: u32,
    changed_ms: u64,
    init: bool,
}

struct ViewFog {
    under: bool,
    start: f64,
    end: f64,
    r: u32,
    g: u32,
    b: u32,
}

fn wfog_vision(ticks: i32) -> f64 {
    if ticks >= 600 { return 1.0 }
    let a: f64 = (ticks as f64) / 100.0
    var f2: f64 = a
    if f2 > 1.0 { f2 = 1.0 }
    var f3: f64 = 0.0
    if ticks >= 100 { f3 = ((ticks - 100) as f64) / 500.0 }
    if f3 > 1.0 { f3 = 1.0 }
    return f2 * 0.6 + f3 * 0.39999998
}

fn wfog_end(ticks: i32) -> f64 {
    var v: f64 = wfog_vision(ticks)
    if v < 0.25 { v = 0.25 }
    return WFOG_FAR * v
}

fn wfog_scale(c: u32, daylight: i32) -> u32 {
    var d: i32 = daylight
    if d < WFOG_FLOOR { d = WFOG_FLOOR }
    if d > 256 { d = 256 }
    return ((c as i32) * d / 256) as u32
}

fn wfc_new() -> WaterFogColor {
    return WaterFogColor { target: 0 as u32, prev: 0 as u32, changed_ms: 0 as u64, init: false }
}

fn lerp_channel(a: u32, b: u32, t: f64) -> u32 {
    let fa: f64 = a as f64
    let fb: f64 = b as f64
    return (fa + (fb - fa) * t) as u32
}

fn wfc_step(s: *mut WaterFogColor, biome_rgb: u32, now_ms: u64) -> u32 {
    if !(*s).init {
        (*s).init = true
        (*s).target = biome_rgb
        (*s).prev = biome_rgb
        (*s).changed_ms = now_ms
    }
    var t: f64 = ((now_ms - (*s).changed_ms) as f64) / (WFOG_BLEND_MS as f64)
    if t > 1.0 { t = 1.0 }
    let r: u32 = lerp_channel(((*s).prev >> 16 as u32) & 255 as u32, ((*s).target >> 16 as u32) & 255 as u32, t)
    let g: u32 = lerp_channel(((*s).prev >> 8 as u32) & 255 as u32, ((*s).target >> 8 as u32) & 255 as u32, t)
    let b: u32 = lerp_channel((*s).prev & 255 as u32, (*s).target & 255 as u32, t)
    let cur: u32 = (r << 16 as u32) | (g << 8 as u32) | b
    if (*s).target != biome_rgb {
        (*s).target = biome_rgb
        (*s).prev = cur
        (*s).changed_ms = now_ms
    }
    return cur
}

fn wfog_fov(base: f64, under: bool) -> f64 {
    if under { return base * WFOG_FOV_SCALE }
    return base
}

fn wfog_view(under: bool, ticks: i32, daylight: i32, start: f64, end: f64, r: u32, g: u32, b: u32, water_rgb: u32) -> ViewFog {
    if !under { return ViewFog { under: false, start: start, end: end, r: r, g: g, b: b } }
    return ViewFog { under: true, start: WFOG_START, end: wfog_end(ticks), r: wfog_scale((water_rgb >> 16 as u32) & 255 as u32, daylight), g: wfog_scale((water_rgb >> 8 as u32) & 255 as u32, daylight), b: wfog_scale(water_rgb & 255 as u32, daylight) }
}
