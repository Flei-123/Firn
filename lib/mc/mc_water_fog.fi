// SPDX-License-Identifier: MPL-2.0
export { ViewFog, wfog_vision, wfog_end, wfog_view, WFOG_START, WFOG_FOV_SCALE }

const WFOG_START: f64 = 0.0 - 8.0
const WFOG_FAR: f64 = 96.0
const WFOG_FOV_SCALE: f64 = 0.85714287
const WFOG_R: u32 = 5
const WFOG_G: u32 = 5
const WFOG_B: u32 = 51
const WFOG_FLOOR: i32 = 24

struct ViewFog {
    under: bool,
    start: f64,
    end: f64,
    r: u32,
    g: u32,
    b: u32,
}

fn wfog_vision(ticks: i32) -> f64 {
    if ticks >= 600 { return 1.0 }
    let a: f64 = (ticks as f64) / 100.0
    var f2: f64 = a
    if f2 > 1.0 { f2 = 1.0 }
    var f3: f64 = 0.0
    if ticks >= 100 { f3 = ((ticks - 100) as f64) / 500.0 }
    if f3 > 1.0 { f3 = 1.0 }
    return f2 * 0.6 + f3 * 0.39999998
}

fn wfog_end(ticks: i32) -> f64 {
    var v: f64 = wfog_vision(ticks)
    if v < 0.25 { v = 0.25 }
    return WFOG_FAR * v
}

fn wfog_scale(c: u32, daylight: i32) -> u32 {
    var d: i32 = daylight
    if d < WFOG_FLOOR { d = WFOG_FLOOR }
    if d > 256 { d = 256 }
    return ((c as i32) * d / 256) as u32
}

fn wfog_view(under: bool, ticks: i32, daylight: i32, start: f64, end: f64, r: u32, g: u32, b: u32) -> ViewFog {
    if !under { return ViewFog { under: false, start: start, end: end, r: r, g: g, b: b } }
    return ViewFog { under: true, start: WFOG_START, end: wfog_end(ticks), r: wfog_scale(WFOG_R, daylight), g: wfog_scale(WFOG_G, daylight), b: wfog_scale(WFOG_B, daylight) }
}
