// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_chat_lang.fi -- the few translation keys a server sends most (join / leave, chat types, deaths, common command answers) as a
// flat JSON object for mc_text.tr_load. Not a language file: keys that are missing are shown as the key itself.
//
//   lang_basic(&out)    appends the JSON object

import std.rt

export { lang_basic }

fn quoted(out: *mut rt.Buf, s: str) {
    rt.buf_push(out, 34)
    rt.buf_push_bytes(out, s.p as u64, s.n)
    rt.buf_push(out, 34)
}

fn kv(out: *mut rt.Buf, k: str, v: str) {
    if rt.buf_len(out) > 1 { rt.buf_push(out, 44) }
    quoted(out, k)
    rt.buf_push(out, 58)
    quoted(out, v)
}

fn lang_basic(out: *mut rt.Buf) {
    rt.buf_push(out, 123)
    kv(out, "multiplayer.player.joined", "%s joined the game")
    kv(out, "multiplayer.player.left", "%s left the game")
    kv(out, "multiplayer.player.joined.renamed", "%s (formerly known as %s) joined the game")
    kv(out, "chat.type.text", "<%s> %s")
    kv(out, "chat.type.announcement", "[%s] %s")
    kv(out, "chat.type.admin", "[%s: %s]")
    kv(out, "chat.type.emote", "* %s %s")
    kv(out, "chat.type.team.text", "%s <%s> %s")
    kv(out, "commands.message.display.incoming", "%s whispers to you: %s")
    kv(out, "commands.message.display.outgoing", "You whisper to %s: %s")
    kv(out, "commands.time.set", "Set the time to %s")
    kv(out, "commands.time.query", "The time is %s")
    kv(out, "commands.gamemode.success.self", "Set own game mode to %s")
    kv(out, "commands.gamemode.success.other", "Set %s's game mode to %s")
    kv(out, "commands.give.success.single", "Gave %s %s to %s")
    kv(out, "commands.give.success.multiple", "Gave %s %s to %s players")
    kv(out, "commands.teleport.success.entity.single", "Teleported %s to %s")
    kv(out, "commands.teleport.success.location.single", "Teleported %s to %s, %s, %s")
    kv(out, "commands.kill.success.single", "Killed %s")
    kv(out, "commands.effect.give.success.single", "Applied effect %s to %s")
    kv(out, "commands.weather.set.clear", "Set the weather to clear")
    kv(out, "commands.weather.set.rain", "Set the weather to rain")
    kv(out, "commands.weather.set.thunder", "Set the weather to rain & thunder")
    kv(out, "commands.setblock.success", "Changed the block at %s, %s, %s")
    kv(out, "commands.op.success", "Made %s a server operator")
    kv(out, "commands.deop.success", "Made %s no longer a server operator")
    kv(out, "commands.seed.success", "Seed: %s")
    kv(out, "commands.help.failed", "Unknown command or insufficient permissions")
    kv(out, "command.unknown.command", "Unknown or incomplete command, see below for error")
    kv(out, "command.context.here", "<--[HERE]")
    kv(out, "death.attack.generic", "%s died")
    kv(out, "death.attack.player", "%s was slain by %s")
    kv(out, "death.attack.mob", "%s was slain by %s")
    kv(out, "death.attack.arrow", "%s was shot by %s")
    kv(out, "death.attack.fall", "%s hit the ground too hard")
    kv(out, "death.attack.drown", "%s drowned")
    kv(out, "death.attack.lava", "%s tried to swim in lava")
    kv(out, "death.attack.inFire", "%s went up in flames")
    kv(out, "death.attack.onFire", "%s burned to death")
    kv(out, "death.attack.starve", "%s starved to death")
    kv(out, "death.attack.outOfWorld", "%s fell out of the world")
    kv(out, "death.attack.explosion", "%s blew up")
    kv(out, "death.attack.magic", "%s was killed by magic")
    kv(out, "death.attack.outsideBorder", "%s left the confines of this world")
    kv(out, "death.attack.genericKill", "%s was killed")
    kv(out, "death.fell.accident.generic", "%s fell from a high place")
    kv(out, "death.attack.cactus", "%s was pricked to death")
    kv(out, "death.attack.inWall", "%s suffocated in a wall")
    kv(out, "death.attack.lightningBolt", "%s was struck by lightning")
    kv(out, "death.attack.wither", "%s withered away")
    kv(out, "death.attack.thorns", "%s was killed trying to hurt %s")
    kv(out, "death.attack.fallingBlock", "%s was squashed by a falling block")
    kv(out, "death.attack.anvil", "%s was squashed by a falling anvil")
    kv(out, "death.attack.hotFloor", "%s discovered the floor was lava")
    kv(out, "death.attack.sweetBerryBush", "%s was poked to death by a sweet berry bush")
    kv(out, "entity.minecraft.zombie", "Zombie")
    kv(out, "entity.minecraft.skeleton", "Skeleton")
    kv(out, "entity.minecraft.creeper", "Creeper")
    kv(out, "entity.minecraft.spider", "Spider")
    kv(out, "entity.minecraft.player", "Player")
    rt.buf_push(out, 125)
}
