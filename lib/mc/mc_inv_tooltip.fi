import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_hud_vfont
import mc.mc_inv_ui

export { tip_title, tip_draw }

const BG: u32 = 0xF0100010
const BORDER_TOP: u32 = 0xFF5000FF
const BORDER_BOT: u32 = 0xFF28007F
const WHITE: u32 = 0xFFFFFFFF

fn tip_title(p: u64, n: usize, out: *mut rt.Buf) {
    var up: bool = true
    var i: usize = 0
    while i < n {
        var ch: u8 = rt.ld8(p, i)
        if ch == 95 as u8 {
            rt.buf_push(out, 32 as u8)
            up = true
        } else {
            if up && ch >= 97 as u8 && ch <= 122 as u8 { ch = ch - 32 as u8 }
            rt.buf_push(out, ch)
            up = false
        }
        i = i + 1
    }
}

fn tip_draw(r: *mut mc_raster.Raster, mx: i32, my: i32, s: i32, name_p: u64, name_n: usize) {
    var b: rt.Buf = rt.buf_new()
    tip_title(name_p, name_n, &b)
    let n: usize = rt.buf_len(&b)
    let tw: i32 = mc_hud_vfont.vtext_width(rt.buf_ptr(&b), 0 as u64, 0, n)
    var x: i32 = mx + 12 * s
    var y: i32 = my - 12 * s
    let w: i32 = (tw + 8) * s
    let h: i32 = 16 * s
    if x + w > (*r).w { x = mx - 12 * s - w }
    if x < 0 { x = 0 }
    if y < 0 { y = 0 }
    if y + h > (*r).h { y = (*r).h - h }
    mc_hud.hud_rect(r, x + s, y, w - 2 * s, h, BG)
    mc_hud.hud_rect(r, x, y + s, w, h - 2 * s, BG)
    mc_hud.hud_rect(r, x + s, y + s, w - 2 * s, s, BORDER_TOP)
    mc_hud.hud_rect(r, x + s, y + h - 2 * s, w - 2 * s, s, BORDER_BOT)
    mc_hud.hud_rect(r, x + s, y + s, s, h - 3 * s, BORDER_TOP)
    mc_hud.hud_rect(r, x + w - 2 * s, y + s, s, h - 3 * s, BORDER_BOT)
    mc_inv_ui.iui_text(r, x + 4 * s, y + 4 * s, s, str { p: rt.buf_ptr(&b) as *u8, n: n }, WHITE, true)
    rt.buf_free(&b)
}
