import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_hud_vfont
import mc.mc_tip_lines
import mc.mc_item_names
import mc.mc_item_tip

export { tip_title, tip_draw, tip_draw_lines, tip_draw_item, tip_box }

const BG: u32 = 0xF0100010
const BORDER_TOP: u32 = 0xFF5000FF
const BORDER_BOT: u32 = 0xFF28007F
const WHITE: i32 = 0xFFFFFF
const LINE_H: i32 = 10
const TITLE_GAP: i32 = 2

fn tip_title(p: u64, n: usize, out: *mut rt.Buf) {
    mc_item_names.names_title(p, n, out)
}

fn tip_box(t: *mut mc_tip_lines.TipLines, s: i32, out_w: *mut i32, out_h: *mut i32) {
    var tw: i32 = 0
    var i: usize = 0
    let n: usize = mc_tip_lines.tl_count(t)
    while i < n {
        let w: i32 = mc_hud_vfont.vtext_width(mc_tip_lines.tl_text(t) + (mc_tip_lines.tl_off(t, i) as u64), mc_tip_lines.tl_flags(t) + (mc_tip_lines.tl_off(t, i) as u64), 0, mc_tip_lines.tl_len(t, i))
        if w > tw { tw = w }
        i = i + 1
    }
    var h: i32 = 6 + LINE_H * (n as i32)
    if n > 1 { h = h + TITLE_GAP }
    *out_w = (tw + 8) * s
    *out_h = h * s
}

fn tip_draw_lines(r: *mut mc_raster.Raster, mx: i32, my: i32, s: i32, t: *mut mc_tip_lines.TipLines) {
    let n: usize = mc_tip_lines.tl_count(t)
    if n == 0 { return }
    var w: i32 = 0
    var h: i32 = 0
    tip_box(t, s, &w, &h)
    var x: i32 = mx + 12 * s
    var y: i32 = my - 12 * s
    if x + w > (*r).w { x = mx - 12 * s - w }
    if x < 0 { x = 0 }
    if y + h > (*r).h { y = (*r).h - h }
    if y < 0 { y = 0 }
    mc_hud.hud_rect(r, x + s, y, w - 2 * s, h, BG)
    mc_hud.hud_rect(r, x, y + s, w, h - 2 * s, BG)
    mc_hud.hud_rect(r, x + s, y + s, w - 2 * s, s, BORDER_TOP)
    mc_hud.hud_rect(r, x + s, y + h - 2 * s, w - 2 * s, s, BORDER_BOT)
    mc_hud.hud_rect(r, x + s, y + s, s, h - 3 * s, BORDER_TOP)
    mc_hud.hud_rect(r, x + w - 2 * s, y + s, s, h - 3 * s, BORDER_BOT)
    var ly: i32 = y + 4 * s
    var i: usize = 0
    while i < n {
        let off: usize = mc_tip_lines.tl_off(t, i)
        let len: usize = mc_tip_lines.tl_len(t, i)
        if len > 0 {
            mc_hud_vfont.vtext_line(r, x + 4 * s, ly, s, 255, mc_tip_lines.tl_text(t) + (off as u64), mc_tip_lines.tl_cols(t) + ((off * 4) as u64), mc_tip_lines.tl_flags(t) + (off as u64), 0, len, true, 0 as u32)
        }
        ly = ly + LINE_H * s
        if i == 0 && n > 1 { ly = ly + TITLE_GAP * s }
        i = i + 1
    }
}

fn tip_draw(r: *mut mc_raster.Raster, mx: i32, my: i32, s: i32, name_p: u64, name_n: usize) {
    var b: rt.Buf = rt.buf_new()
    tip_title(name_p, name_n, &b)
    var t: mc_tip_lines.TipLines = mc_tip_lines.tl_new()
    mc_tip_lines.tl_add_plain(&t, WHITE, 0 as u32, rt.buf_ptr(&b), rt.buf_len(&b))
    tip_draw_lines(r, mx, my, s, &t)
    mc_tip_lines.tl_free(&t)
    rt.buf_free(&b)
}

fn tip_draw_item(r: *mut mc_raster.Raster, mx: i32, my: i32, s: i32, rec_p: u64, rec_n: usize, item_p: u64, item_n: usize, protocol: i32, ench_p: u64, ench_n: usize) {
    var t: mc_tip_lines.TipLines = mc_tip_lines.tl_new()
    mc_item_tip.tip_build(&t, rec_p, rec_n, item_p, item_n, protocol, ench_p, ench_n)
    tip_draw_lines(r, mx, my, s, &t)
    mc_tip_lines.tl_free(&t)
}
