// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_model_mesh.fi -- mesher side of the resource pack models (r230 / r231): block state id -> state string -> baked quads (mc_model)
// -> atlas tiles, face culling and light -> one model quad stream per 16^3 section. OPT-IN (mcplay: MCPLAY_MODELS=1); without a ModelSet the
// whole mesher path is unchanged.
//
//     var ms: mc_model_mesh.ModelSet = mc_model_mesh.ms_new(&registry, &pack_stack, &texext)
//     mc_model_mesh.ms_prepare(&ms, pad, &tables)             // resolve every state of the padded section; models leave the cube mesher
//     ... normal mesh_padded(pad, tables) ...                 // model blocks have no faces there any more
//     let nq: usize = mc_model_mesh.ms_mesh(&ms, pad, lpad, &tables, wx, wy, wz, &out)    // out = rt.Buf of nq * MQ_WORDS f64
//     b.mesh_class(b.obj, MESH_MODEL); b.mesh_upload(b.obj, key, buf, nq * MQ_WORDS, dummy_idx, 1)      // CPU back end only
//
// WHICH BLOCKS: a state is a MODEL state when a pack (or the own built-in parents) gives it a blockstate with quads that are NOT exactly a unit
// cube (stairs, slabs, plants, fences ...). Unit cubes, states without blockstate and states without any usable quad stay with the greedy cube
// mesher (their tiles/textures come from the extended tile tables). So an empty PackStack changes nothing.
//
// STATE STRING (r231): reg_state_text gives "name[prop=value,...]" in registry order; ms_state_parts splits it into the block name and the
// "prop=value,..." list that blockstate_select expects (any order is fine there). Pre-flattening versions have no props -> "".
// SEED (r231): weighted variants are picked per block POSITION (mc_model.seed_from_pos). A state is baked for NVAR (4) seeds only when its blockstate
// really has a weighted list; otherwise all four share one bake.
// TEXTURES: model texture name ("block/oak_planks", "minecraft:block/x") -> atlas tile through the extended tile candidate names (mc_texext,
// the same names assets_apply_ext loads from the packs). A texture without an extended tile is NOT drawn (counted in ms.unmapped).
// CULL: a quad with a cullface is dropped when the neighbour cell in that direction is opaque (tables.opaque bit 0) or unknown (not loaded).
// LIGHT: sky / block nibble of the cell in FRONT of a culled-face quad (the neighbour), else of the cell itself; no light array = sky 15 / block 0.
// TINT (r236): a quad with a tintindex gets a colour by block class (grass / foliage / water / birch / spruce / lily pad / redstone wire; defaults =
// the plains colours, ms_set_tint changes them). BIOME TINT (r242): ms_load_biomes + ms_mesh_split_bio colour grass / foliage / water by the biome of the 4x4x4 cell
// blended over the vanilla biome blend radius (5x5 columns); the cube path has no biome colours.
// AO (r236): per corner 0..3 like the cube mesher (3 = open) for quads that lie flat on a cell face (dir 0..5); other quads stay 3.
// TRANSLUCENCY (r236 / r242): quads of glass / ice / slime / honey states AND quads whose texture is partly transparent (ms_set_atlas: >= 25% of the
// visible texels have alpha 1..254) go to the second stream (ms_mesh_split `out_t`, MESH_MODEL_T), drawn far to near with a src-alpha blend by the texel
// alpha; the rest is cut out at alpha 128. NOT done: smooth light per corner.
import std.rt
import std.core
import std.math
import mc.mc_model
import mc.mc_assets
import mc.mc_registry
import mc.mc_texext
import mc.mc_mesh
import mc.mc_chunk
import mc.mc_texture
import mc.mc_biome_zoom
import mc.mc_biome_tint

export {
    ModelSet, PQ_WORDS, ms_new, ms_blank, ms_reset, ms_free, ms_set_tint, ms_prepare, ms_patch_opaque, ms_mesh, ms_mesh_split, ms_state_parts, ms_kind, ms_resolve, ms_tex_tile, ms_quad_count,
    MQ_WORDS, K_UNKNOWN, K_PLAIN, K_MODEL, NVAR, BIO_OFF, BIO_BYTES, ms_load_biomes, ms_set_blend, ms_colormaps, ms_blend_color, ms_blend_color_w, ms_biome_color_xz, ms_set_seed, ms_clear_seed, ms_zoom_on, ms_has_biomes, ms_set_atlas, ms_tile_translucent, ms_snap_bio, ms_mesh_split_bio, ms_biome_color,
}

const MQ_WORDS: usize = 30 // output quad: x0..3 y0..3 z0..3 (block units, section relative), u0..3 v0..3 (tile units), tile, shade 0..256, sky, block, tint (R | G << 8 | B << 16, -1 none), flags (bit 0 translucent), ao0..3
const PQ_WORDS: usize = 30 // prepared quad: the first 24 as above (unit block coordinates), 24 cullface (-1 / 0..5), 25 direction (-1 / 0..5), 26 tint class (-1 none), 27 translucent, 28 flat on its face (ao), 29 unused
const NTINT: usize = 8
const BT_MAXID: usize = 1024 // biome ids covered by the per biome colour table
const BIO_OFF: usize = 11664 // byte offset of the biome grid behind a block pad (u16 [18^3])
const BIO_BYTES: usize = 432 // biome grid u16 [6 * 6 * 6]: cells x, y, z = -1..4 (one cell ring of the neighbour sections); index ((y + 1)*6 + z + 1)*6 + x + 1
const BLEND_MAX: i32 = 4 // largest blend radius the grid ring covers (4 blocks = one cell)
const NSTATE_MAX: usize = 32768
const NVAR: usize = 4
const NTEX: usize = 256
const K_UNKNOWN: u8 = 0
const K_PLAIN: u8 = 1 // cube mesher
const K_MODEL: u8 = 2
const UNBAKED: u32 = 4294967295 as u32

struct ModelSet {
    reg: *mut mc_registry.Registry,
    st: *mut mc_assets.PackStack,
    ex: *mut mc_texext.TexExt,
    kind: u64, // u8 [NSTATE_MAX]
    weighted: u64, // u8 [NSTATE_MAX]
    qptr: u64, // u64 [NSTATE_MAX * NVAR] prepared quads (PQ_WORDS f64 each)
    qcnt: u64, // u32 [NSTATE_MAX * NVAR], UNBAKED until baked
    tnames: u64, // u8 [NTEX * 64] texture names (zero terminated)
    ttiles: u64, // u32 [NTEX]
    ntex: usize,
    nmodel: usize, // model states resolved so far
    unmapped: usize, // quads dropped because their texture has no atlas tile
    lk: u64, // heap word: spin lock of the lazy bake (mesh jobs of several threads share one ModelSet)
    tint: [u32; 8], // 0xRRGGBB per tint class: 0 grass 1 foliage 2 water 3 birch 4 spruce 5 lily pad 6 redstone wire
    atlas: u64, // *mut mc_texture.Atlas or 0: texel alpha decides the translucent class too (ms_set_atlas)
    blend: i32, // biome blend radius in blocks (vanilla option biomeBlendRadius, default 2 = 5x5 columns; 0 = the cell colour only)
    cmap: u32, // bit0 grass.png / bit1 foliage.png of the pack drove the biome colours (ms_load_biomes)
    btab: u64, // u32 [3 * BT_MAXID] per biome id: grass / foliage / water, bit 24 = valid (0 = class colour), bit 25 (grass only) = swamp noise modifier; 0 = no biome tint (ms_load_biomes)
    zseed: u64, // hashed world seed of the Voronoi biome zoom (ms_set_seed)
    zoom: u32, // 1 = Voronoi zoom on (a seed is known), 0 = the 4x4x4 cell of the block
    swn: mc_biome_zoom.SwampNoise, // BIOME_INFO_NOISE of the swamp grass colour
}

fn ms_new(reg: *mut mc_registry.Registry, st: *mut mc_assets.PackStack, ex: *mut mc_texext.TexExt) -> ModelSet {
    var m: ModelSet = ModelSet { reg: reg, st: st, ex: ex, kind: 0, weighted: 0, qptr: 0, qcnt: 0, tnames: 0, ttiles: 0, ntex: 0,
        nmodel: 0, unmapped: 0, lk: 0, atlas: 0, blend: 2, cmap: 0 as u32, btab: 0, zseed: 0 as u64, zoom: 0 as u32, swn: mc_biome_zoom.swamp_new(),
        tint: [0x91BD59 as u32, 0x77AB2F as u32, 0x3F76E4 as u32, 0x80A755 as u32, 0x619961 as u32, 0x208030 as u32, 0x4B0000 as u32, 0xFFFFFF as u32] }
    m.lk = rt.heap_alloc(8)
    rt.st64(m.lk, 0, 0 as u64)
    m.kind = rt.heap_alloc(NSTATE_MAX)
    m.weighted = rt.heap_alloc(NSTATE_MAX)
    rt.mem_set(m.kind, 0 as u8, NSTATE_MAX)
    rt.mem_set(m.weighted, 0 as u8, NSTATE_MAX)
    m.qptr = rt.heap_alloc(NSTATE_MAX * NVAR * 8)
    m.qcnt = rt.heap_alloc(NSTATE_MAX * NVAR * 4)
    var i: usize = 0
    while i < NSTATE_MAX * NVAR {
        rt.st64(m.qptr, i, 0 as u64)
        rt.st32(m.qcnt, i, UNBAKED)
        i = i + 1
    }
    m.tnames = rt.heap_alloc(NTEX * 64)
    m.ttiles = rt.heap_alloc(NTEX * 4)
    rt.mem_set(m.tnames, 0 as u8, NTEX * 64)
    return m
}

// A ModelSet without tables (nothing allocated, ms_free is a no-op): placeholder for a struct field until ms_new runs.
fn ms_blank() -> ModelSet {
    return ModelSet { reg: 0 as u64 as *mut mc_registry.Registry, st: 0 as u64 as *mut mc_assets.PackStack, ex: 0 as u64 as *mut mc_texext.TexExt,
        kind: 0, weighted: 0, qptr: 0, qcnt: 0, tnames: 0, ttiles: 0, ntex: 0, nmodel: 0, unmapped: 0, lk: 0, atlas: 0, blend: 2, cmap: 0 as u32, btab: 0, zseed: 0 as u64, zoom: 0 as u32, swn: mc_biome_zoom.SwampNoise { p: [0 as u8; 256] },
        tint: [0 as u32; 8] }
}

// Forgets everything that was baked (same registry / pack stack / texture table pointers): after a pack reload the models and the texture ->
// tile mapping are read again. The caller must also drop the meshes of the world (wr_clear / wr_clear_b) and restore the cube tables.
fn ms_reset(m: *mut ModelSet) {
    let reg: *mut mc_registry.Registry = (*m).reg
    let st: *mut mc_assets.PackStack = (*m).st
    let ex: *mut mc_texext.TexExt = (*m).ex
    let tn: [u32; 8] = (*m).tint
    let had_bio: bool = (*m).btab != 0
    let at: u64 = (*m).atlas
    let bl: i32 = (*m).blend
    let zs: u64 = (*m).zseed
    let zz: u32 = (*m).zoom
    ms_free(m)
    *m = ms_new(reg, st, ex)
    (*m).tint = tn
    (*m).atlas = at
    (*m).blend = bl
    (*m).zseed = zs
    (*m).zoom = zz
    if had_bio { ms_load_biomes(m) }
}

// Colour 0xRRGGBB of a tint class (0 grass 1 foliage 2 water 3 birch 4 spruce 5 lily pad 6 redstone wire). Call before meshing (or follow with a remesh).
fn ms_set_tint(m: *mut ModelSet, cls: usize, rgb: u32) {
    if cls < NTINT { (*m).tint[cls] = rgb }
}

// ---- biome tint (r242) -------------------------------------------------------------------------------

fn hex6(p: u64, i: usize) -> u32 { return hexn(p, i, 6) }

fn hexn(p: u64, i: usize, n: usize) -> u32 {
    var v: u32 = 0 as u32
    var k: usize = 0
    while k < n {
        let c: u8 = rt.ld8(p, i + k)
        var d: u32 = 0 as u32
        if c >= (97 as u8) { d = (c - (87 as u8)) as u32 } else if c >= (65 as u8) { d = (c - (55 as u8)) as u32 } else { d = (c - (48 as u8)) as u32 }
        v = (v << (4 as u32)) | d
        k = k + 1
    }
    return v
}

// Offset of the value part of the entry `name` in a table of "name<tail bytes>" entries separated by ';' (tail = bytes after the name incl. the
// first ':'), or -1 when absent.
fn bt_find(d: u64, dn: usize, np: u64, nl: usize, tail: usize) -> i64 {
    var i: usize = 0
    while i < dn {
        var e: usize = i
        while e < dn && rt.ld8(d, e) != (59 as u8) { e = e + 1 }
        if e - i > tail {
            let ln: usize = e - i - tail
            if ln == nl && rt.mem_eq(d + (i as u64), np, nl) { return (i + ln + 1) as i64 }
        }
        i = e + 1
    }
    return 0 - 1
}

// Vanilla grass_color_modifier dark_forest: ((c & 0xFEFEFE) + 0x28340A) >> 1.
// true for the biomes whose grass colour modifier is SWAMP in 1.16 - 1.20.1: swamp, swamp_hills (up to 1.17), mangrove_swamp (1.19+).
fn bt_is_swamp(np: u64, nl: usize) -> bool {
    if nl == 5 && rt.mem_eq(np, "swamp".p as u64, 5) { return true }
    if nl == 11 && rt.mem_eq(np, "swamp_hills".p as u64, 11) { return true }
    if nl == 14 && rt.mem_eq(np, "mangrove_swamp".p as u64, 14) { return true }
    return false
}

fn dark_forest_mod(c: u32) -> u32 {
    return (((c & (16711422 as u32)) + (2634762 as u32)) >> (1 as u32))
}

// Reads the grass / foliage / water colour of every biome of the registry (matched by name against mc_biome_tint, generated by
// tools/mc/gen_biome_tint.py) into a table by biome id and turns the per biome tint ON: ms_mesh_split_bio then colours quads of tint class 0 / 1 / 2
// by the biome of their 4x4x4 cell, blended over the biome blend radius. Biomes without an entry keep the class colour. When the pack stack has
// assets/minecraft/textures/colormap/grass.png / foliage.png (256 x 256), the grass / foliage colour of every 1.20.1 biome WITHOUT an explicit
// colour comes from that colormap at the vanilla (temperature, downfall) cell (mc_biome_tint.BT_CLIM) instead of the built-in table.
fn ms_load_biomes(m: *mut ModelSet) {
    if (*m).btab == 0 { (*m).btab = rt.heap_alloc(3 * BT_MAXID * 4) }
    rt.mem_set((*m).btab, 0 as u8, 3 * BT_MAXID * 4)
    (*m).cmap = 0 as u32
    let d: u64 = mc_biome_tint.BT_DATA.p as u64
    let dn: usize = mc_biome_tint.BT_LEN
    let cd: u64 = mc_biome_tint.BT_CLIM.p as u64
    let cn: usize = mc_biome_tint.BT_CLIM_LEN
    var gmap: u64 = 0
    var fmap: u64 = 0
    if (*m).st != (0 as u64 as *mut mc_assets.PackStack) {
        let g: u64 = rt.heap_alloc(65536 * 4)
        if mc_assets.stack_load_colormap((*m).st, "grass", g) { gmap = g } else { rt.heap_free(g, 65536 * 4) }
        let f: u64 = rt.heap_alloc(65536 * 4)
        if mc_assets.stack_load_colormap((*m).st, "foliage", f) { fmap = f } else { rt.heap_free(f, 65536 * 4) }
    }
    if gmap != 0 { (*m).cmap = (*m).cmap | (1 as u32) }
    if fmap != 0 { (*m).cmap = (*m).cmap | (2 as u32) }
    let nb: i32 = mc_registry.reg_biome_count((*m).reg)
    var bi: i32 = 0
    while bi < nb {
        var nl: usize = 0
        var np: u64 = mc_registry.reg_biome_name((*m).reg, bi, &nl)
        let id: i32 = mc_registry.reg_biome_id((*m).reg, bi)
        bi = bi + 1
        if id < 0 || (id as usize) >= BT_MAXID { continue }
        if nl > 10 && rt.mem_eq(np, "minecraft:".p as u64, 10) {
            np = np + (10 as u64)
            nl = nl - 10
        }
        // entries are "name:GGGGGG:FFFFFF:WWWWWW" separated by ';'
        let oi: i64 = bt_find(d, dn, np, nl, 21)
        if oi < 0 { continue }
        let o: usize = oi as usize
        var gc: u32 = hex6(d, o)
        var fc: u32 = hex6(d, o + 7)
        let wc: u32 = hex6(d, o + 14)
        // colormap cell of the biome: "name:XXYY:F"
        let coi: i64 = bt_find(cd, cn, np, nl, 7)
        if coi >= 0 {
            let co: usize = coi as usize
            let cx: usize = hexn(cd, co, 2) as usize
            let cy: usize = hexn(cd, co + 2, 2) as usize
            let fl: u32 = hexn(cd, co + 5, 1)
            if gmap != 0 && (fl & (1 as u32)) == (0 as u32) {
                gc = rt.ld32(gmap, cy * 256 + cx) & (16777215 as u32)
                if (fl & (4 as u32)) != (0 as u32) { gc = dark_forest_mod(gc) }
            }
            if fmap != 0 && (fl & (2 as u32)) == (0 as u32) {
                fc = rt.ld32(fmap, cy * 256 + cx) & (16777215 as u32)
            }
        }
        // swamp grass modifier (vanilla BiomeSpecialEffects.GrassColorModifier.SWAMP): the colour comes from the column noise, not the table
        if bt_is_swamp(np, nl) { gc = gc + (33554432 as u32) }
        rt.st32((*m).btab, (id as usize), gc + (16777216 as u32))
        rt.st32((*m).btab, BT_MAXID + (id as usize), fc + (16777216 as u32))
        rt.st32((*m).btab, 2 * BT_MAXID + (id as usize), wc + (16777216 as u32))
    }
    if gmap != 0 { rt.heap_free(gmap, 65536 * 4) }
    if fmap != 0 { rt.heap_free(fmap, 65536 * 4) }
}

// Biome blend radius in blocks (vanilla biomeBlendRadius: 0 = off, default 2 = the 5x5 columns around a block); clamped to 0..BLEND_MAX (the
// biome grid carries one cell ring). Remesh afterwards.
fn ms_set_blend(m: *mut ModelSet, r: i32) {
    var v: i32 = r
    if v < 0 { v = 0 }
    if v > BLEND_MAX { v = BLEND_MAX }
    (*m).blend = v
}

// bit0 = grass.png and bit1 = foliage.png of the pack supplied the colours at the last ms_load_biomes.
fn ms_colormaps(m: *mut ModelSet) -> u32 { return (*m).cmap }

fn ms_has_biomes(m: *mut ModelSet) -> bool { return (*m).btab != 0 }

// ---- translucency by texel alpha (r242) ---------------------------------------------------------------

// The atlas whose texels decide the translucent class (call before meshing; the pointer stays valid across hot reloads, the pixels are read at bake time,
// so ms_reset after a reload). Without an atlas only the block names (glass / ice / slime / honey) decide.
fn ms_set_atlas(m: *mut ModelSet, a: *mut mc_texture.Atlas) {
    (*m).atlas = a as u64
}

// true when the atlas tile `tile` (1 based) is partly transparent: at least a quarter of its visible texels (alpha > 0) have alpha 1..254. Such a
// texture (ice, stained glass, honey, slime, custom glass) is blended in the translucent pass; textures that only have alpha 0 / 255 (leaves, plants,
// vanilla clear glass) and the odd soft edge texel stay cut out. false without an atlas.
fn ms_tile_translucent(m: *mut ModelSet, tile: u32) -> bool {
    if (*m).atlas == 0 || tile == 0 as u32 { return false }
    let a: *mut mc_texture.Atlas = (*m).atlas as *mut mc_texture.Atlas
    if (*a).px == 0 || (*a).cols < 1 || (*a).tile < 1 { return false }
    let t: i32 = (tile as i32) - 1
    let col: i32 = t % (*a).cols
    let row: i32 = t / (*a).cols
    if (row + 1) * (*a).tile > (*a).h { return false }
    var vis: usize = 0
    var part: usize = 0
    var y: i32 = 0
    while y < (*a).tile {
        var x: i32 = 0
        while x < (*a).tile {
            let px: u32 = rt.ld32((*a).px, (((row * (*a).tile + y) * (*a).w) + col * (*a).tile + x) as usize)
            let al: u32 = px >> (24 as u32)
            if al > (0 as u32) { vis = vis + 1 }
            if al > (0 as u32) && al < (255 as u32) { part = part + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return vis > 0 && part * 4 >= vis
}

fn zoom_clamp(v: i32) -> i32 {
    if v < 0 - 1 { return 0 - 1 }
    if v > 4 { return 4 }
    return v
}

// The biome id when the 8 cells (l..l+1, m..m+1, n..n+1; cell coordinates relative to the section, clamped to the grid like the pick result) around
// a block all hold the same biome, else -1. BiomeManager.getBiome always returns one of these 8 cells, so no Voronoi pick is needed then.
fn ms_zoom_cells_same(bio: u64, l: i32, m: i32, n: i32) -> i32 {
    let xa: i32 = zoom_clamp(l)
    let xb: i32 = zoom_clamp(l + 1)
    let ya: i32 = zoom_clamp(m)
    let yb: i32 = zoom_clamp(m + 1)
    let za: i32 = zoom_clamp(n)
    let zb: i32 = zoom_clamp(n + 1)
    let v: u16 = rt.ld16(bio, (((ya + 1) * 6 + za + 1) * 6 + xa + 1) as usize)
    if rt.ld16(bio, (((ya + 1) * 6 + za + 1) * 6 + xb + 1) as usize) != v { return 0 - 1 }
    if rt.ld16(bio, (((ya + 1) * 6 + zb + 1) * 6 + xa + 1) as usize) != v { return 0 - 1 }
    if rt.ld16(bio, (((ya + 1) * 6 + zb + 1) * 6 + xb + 1) as usize) != v { return 0 - 1 }
    if rt.ld16(bio, (((yb + 1) * 6 + za + 1) * 6 + xa + 1) as usize) != v { return 0 - 1 }
    if rt.ld16(bio, (((yb + 1) * 6 + za + 1) * 6 + xb + 1) as usize) != v { return 0 - 1 }
    if rt.ld16(bio, (((yb + 1) * 6 + zb + 1) * 6 + xa + 1) as usize) != v { return 0 - 1 }
    if rt.ld16(bio, (((yb + 1) * 6 + zb + 1) * 6 + xb + 1) as usize) != v { return 0 - 1 }
    return v as i32
}

// Colour 0xRRGGBB of tint class `cls` (0 grass 1 foliage 2 water) in biome `bid`, or the class colour when the biome has no entry.
fn ms_biome_color(m: *mut ModelSet, cls: usize, bid: usize) -> u32 {
    if (*m).btab != 0 && cls < 3 && bid < BT_MAXID {
        let e: u32 = rt.ld32((*m).btab, cls * BT_MAXID + bid)
        if (e >> (24 as u32)) != (0 as u32) { return e & (16777215 as u32) }
    }
    return (*m).tint[cls]
}

// Scratch of ONE ms_mesh_split_bio call (r258): the biome id of every (y, z, x) column position the blend windows of the section touch (zoom picks are
// shared by the neighbouring blocks and by the tint classes), the swamp grass colour of every column, the cell fiddles of mc_biome_zoom. Window
// = section + 4 blocks on each side (blend radius <= 4) -> 24 x 24 columns, 16 heights. Results are the same as without the cache.
const BC_W: i32 = 24

struct BlendCache {
    bz: mc_biome_zoom.BzCache,
    ids: u64, // u16 [16 * 24 * 24] biome id, 0xFFFF = not computed
    sw: u64, // u32 [24 * 24] swamp grass colour | 1 << 24, 0 = not computed
    pl: u64, // u32 [16 * 3 * 256] blended colour of every column per (height, tint class) layer (ms_blend_plane)
    pst: u64, // u8 [16 * 3] per layer: blocks blended one by one so far, 255 = plane computed
    pcol: u64, // u64 [24 * 24] scratch: packed column colours of ms_blend_plane
    phs: u64, // u64 [24 * 16] scratch: window sums along x
}

fn bcache_new(wx: i32, wy: i32, wz: i32) -> BlendCache {
    let ids: u64 = rt.heap_alloc((16 * BC_W * BC_W * 2) as usize)
    rt.mem_set(ids, 255 as u8, (16 * BC_W * BC_W * 2) as usize)
    let sw: u64 = rt.heap_alloc((BC_W * BC_W * 4) as usize)
    rt.mem_set(sw, 0 as u8, (BC_W * BC_W * 4) as usize)
    let pst: u64 = rt.heap_alloc(48)
    rt.mem_set(pst, 0 as u8, 48)
    return BlendCache { bz: mc_biome_zoom.bzc_new(wx, wy, wz), ids: ids, sw: sw, pl: rt.heap_alloc((16 * 3 * 256 * 4) as usize), pst: pst, pcol: rt.heap_alloc((BC_W * BC_W * 8) as usize), phs: rt.heap_alloc((BC_W * 16 * 8) as usize) }
}

fn bcache_free(c: *mut BlendCache) {
    mc_biome_zoom.bzc_free(&(*c).bz)
    rt.heap_free((*c).ids, (16 * BC_W * BC_W * 2) as usize)
    rt.heap_free((*c).sw, (BC_W * BC_W * 4) as usize)
    rt.heap_free((*c).pl, (16 * 3 * 256 * 4) as usize)
    rt.heap_free((*c).pst, 48)
    rt.heap_free((*c).pcol, (BC_W * BC_W * 8) as usize)
    rt.heap_free((*c).phs, (BC_W * 16 * 8) as usize)
}

// ms_biome_color of the block column (bx, bz): the grass colour of a swamp biome comes from the swamp noise of the column (vanilla
// GrassColorModifier.SWAMP: 0x4C763C / 0x6A7039), everything else is the table colour.
fn ms_biome_color_xz(m: *mut ModelSet, cls: usize, bid: usize, bx: i32, bz: i32) -> u32 {
    if (*m).btab != 0 && cls == 0 && bid < BT_MAXID {
        let e: u32 = rt.ld32((*m).btab, bid)
        if (e & (33554432 as u32)) != (0 as u32) { return mc_biome_zoom.swamp_grass(&(*m).swn, bx, bz) }
    }
    return ms_biome_color(m, cls, bid)
}

// ms_biome_color_xz with the swamp colour of the column read from / stored in the cache (`cx`, `cz` = window position of the column, 0..23; cache 0 = none).
fn ms_biome_color_xzc(m: *mut ModelSet, cls: usize, bid: usize, bx: i32, bz: i32, cache: *mut BlendCache, cx: i32, cz: i32) -> u32 {
    if (cache as u64) != (0 as u64) && (*m).btab != 0 && cls == 0 && bid < BT_MAXID {
        let e: u32 = rt.ld32((*m).btab, bid)
        if (e & (33554432 as u32)) != (0 as u32) {
            let si: usize = (cz * BC_W + cx) as usize
            var v: u32 = rt.ld32((*cache).sw, si)
            if v == (0 as u32) {
                v = mc_biome_zoom.swamp_grass(&(*m).swn, bx, bz) | (16777216 as u32)
                rt.st32((*cache).sw, si, v)
            }
            return v & (16777215 as u32)
        }
    }
    return ms_biome_color_xz(m, cls, bid, bx, bz)
}

// Hashed world seed (Join Game / Respawn `hashedSeed`) of the vanilla Voronoi biome zoom: with a seed every column takes its biome from
// BiomeManager.getBiome (mc_biome_zoom.bz_pick) instead of the plain 4x4x4 cell. Remesh afterwards (the meshes of earlier columns used the old mode).
fn ms_set_seed(m: *mut ModelSet, hashed_seed: i64) {
    (*m).zseed = hashed_seed as u64
    (*m).zoom = 1 as u32
}

// Back to the plain 4x4x4 cell biome (no seed known).
fn ms_clear_seed(m: *mut ModelSet) {
    (*m).zseed = 0 as u64
    (*m).zoom = 0 as u32
}

fn ms_zoom_on(m: *mut ModelSet) -> bool { return (*m).zoom != (0 as u32) }

fn bio_cell(sec: u64, i: usize) -> u16 {
    if sec == 0 || (*(sec as *mut mc_chunk.Section)).biomes.pal == 0 { return 0 as u16 }
    return mc_chunk.container_get(&(*(sec as *mut mc_chunk.Section)).biomes, i)
}

// Copies the biome grid (BIO_BYTES bytes: 6 x 6 x 6 u16 global ids, see BIO_BYTES) of the section `ptrs[13]` into `out`. `ptrs` = the 27 section
// pointers around it (index (dy+1)*9 + (dz+1)*3 + dx+1; 0 = absent), the ring cells come from the 26 neighbours; an absent neighbour repeats the
// nearest cell of the middle section. Call from the snapshot code while the section pointers are valid.
fn ms_snap_bio(ptrs: u64, out: u64) {
    let mid: u64 = rt.ld64(ptrs, 13)
    var gy: i32 = 0 - 1
    while gy < 5 {
        var dy: i32 = 0
        var ly: i32 = gy
        if gy < 0 {
            dy = 0 - 1
            ly = 3
        }
        if gy > 3 {
            dy = 1
            ly = 0
        }
        var gz: i32 = 0 - 1
        while gz < 5 {
            var dz: i32 = 0
            var lz: i32 = gz
            if gz < 0 {
                dz = 0 - 1
                lz = 3
            }
            if gz > 3 {
                dz = 1
                lz = 0
            }
            var gx: i32 = 0 - 1
            while gx < 5 {
                var dx: i32 = 0
                var lx: i32 = gx
                if gx < 0 {
                    dx = 0 - 1
                    lx = 3
                }
                if gx > 3 {
                    dx = 1
                    lx = 0
                }
                var sec: u64 = rt.ld64(ptrs, ((dy + 1) * 9 + (dz + 1) * 3 + (dx + 1)) as usize)
                var cy: i32 = ly
                if sec == 0 {
                    sec = mid
                    lx = gx
                    lz = gz
                    cy = gy
                    if lx < 0 { lx = 0 }
                    if lx > 3 { lx = 3 }
                    if lz < 0 { lz = 0 }
                    if lz > 3 { lz = 3 }
                    if cy < 0 { cy = 0 }
                    if cy > 3 { cy = 3 }
                }
                rt.st16(out, (((gy + 1) * 6 + gz + 1) * 6 + gx + 1) as usize, bio_cell(sec, ((cy * 4 + lz) * 4 + lx) as usize))
                gx = gx + 1
            }
            gz = gz + 1
        }
        gy = gy + 1
    }
}

// Colour of tint class `cls` of the block at section local (lx, y, z) like vanilla ClientLevel.calculateBlockTint: the per channel integer mean of the
// colours of the (2r+1)^2 columns around it at the same height. (wx, wy, wz) = block origin of the section (multiples of 16). The biome of a column
// is vanilla BiomeManager.getBiome (Voronoi zoom of the cells of the grid `bio`, ms_snap_bio) when a seed is set (ms_set_seed), else its plain 4x4x4 cell;
// the grass colour of swamp biomes comes from the column noise (ms_biome_color_xz).
fn ms_blend_color_w(m: *mut ModelSet, bio: u64, cls: usize, lx: i32, y: i32, z: i32, wx: i32, wy: i32, wz: i32) -> u32 {
    return ms_blend_color_c(m, bio, cls, lx, y, z, wx, wy, wz, 0 as *mut BlendCache)
}

// Biome id of the block column at window position (wcx, wcz) (= section local x / z + 4, 0..23) at section local height y: vanilla
// BiomeManager.getBiome (Voronoi zoom) when a seed is set, else the plain 4x4x4 cell. `cache` (0 = none) keeps zoom results per column.
fn ms_col_bid(m: *mut ModelSet, bio: u64, y: i32, wcx: i32, wcz: i32, wx: i32, wy: i32, wz: i32, cache: *mut BlendCache) -> usize {
    var cx2: i32 = wcx / 4 - 1
    var cy2: i32 = y / 4
    var cz2: i32 = wcz / 4 - 1
    let bx: i32 = wx + wcx - 4
    let bz: i32 = wz + wcz - 4
    if (*m).zoom != (0 as u32) {
        if (cache as u64) != (0 as u64) {
            let hit: usize = rt.ld16((*cache).ids, ((y * BC_W + wcz) * BC_W + wcx) as usize) as usize
            if hit != 65535 { return hit }
        }
        var bid: usize = 0
        // all 8 cells the zoom can pick from hold the same biome -> that is the biome, no pick needed
        let uni: i32 = ms_zoom_cells_same(bio, ((bx - 2) >> 2) - (wx >> 2), ((wy + y - 2) >> 2) - (wy >> 2), ((bz - 2) >> 2) - (wz >> 2))
        if uni >= 0 {
            bid = uni as usize
        } else {
            var q: mc_biome_zoom.BzQuart = mc_biome_zoom.BzQuart { x: 0, y: 0, z: 0 }
            if (cache as u64) != (0 as u64) {
                q = mc_biome_zoom.bz_pick_c(&(*cache).bz, (*m).zseed, bx, wy + y, bz)
            } else {
                q = mc_biome_zoom.bz_pick((*m).zseed, bx, wy + y, bz)
            }
            cx2 = q.x - (wx >> 2)
            cy2 = q.y - (wy >> 2)
            cz2 = q.z - (wz >> 2)
            if cx2 < 0 - 1 { cx2 = 0 - 1 }
            if cx2 > 4 { cx2 = 4 }
            if cy2 < 0 - 1 { cy2 = 0 - 1 }
            if cy2 > 4 { cy2 = 4 }
            if cz2 < 0 - 1 { cz2 = 0 - 1 }
            if cz2 > 4 { cz2 = 4 }
            bid = rt.ld16(bio, (((cy2 + 1) * 6 + cz2 + 1) * 6 + cx2 + 1) as usize) as usize
        }
        if (cache as u64) != (0 as u64) { rt.st16((*cache).ids, ((y * BC_W + wcz) * BC_W + wcx) as usize, bid as u16) }
        return bid
    }
    return rt.ld16(bio, (((cy2 + 1) * 6 + cz2 + 1) * 6 + cx2 + 1) as usize) as usize
}

// ms_blend_color_w with the per-section scratch `cache` (0 = none): lx, z in 0..15, y in 0..15 when a cache is given. Same result.
fn ms_blend_color_c(m: *mut ModelSet, bio: u64, cls: usize, lx: i32, y: i32, z: i32, wx: i32, wy: i32, wz: i32, cache: *mut BlendCache) -> u32 {
    let r: i32 = (*m).blend
    var sr: u32 = 0 as u32
    var sg: u32 = 0 as u32
    var sb: u32 = 0 as u32
    var n: u32 = 0 as u32
    var dz: i32 = 0 - r
    while dz <= r {
        var dx: i32 = 0 - r
        while dx <= r {
            let wcx: i32 = lx + dx + 4
            let wcz: i32 = z + dz + 4
            let bid: usize = ms_col_bid(m, bio, y, wcx, wcz, wx, wy, wz, cache)
            let c: u32 = ms_biome_color_xzc(m, cls, bid, wx + lx + dx, wz + z + dz, cache, wcx, wcz)
            sr = sr + ((c >> (16 as u32)) & (255 as u32))
            sg = sg + ((c >> (8 as u32)) & (255 as u32))
            sb = sb + (c & (255 as u32))
            n = n + (1 as u32)
            dx = dx + 1
        }
        dz = dz + 1
    }
    return (((sr / n) & (255 as u32)) << (16 as u32)) | (((sg / n) & (255 as u32)) << (8 as u32)) | ((sb / n) & (255 as u32))
}

// Blocks of ONE (height, tint class) layer that are blended one by one before the whole 16 x 16 layer is computed with separable window sums.
const PLANE_AT: u8 = 10 as u8

// Blended colours of ALL 16 x 16 columns of the layer (y, cls) at once: the packed per channel colour of every window column (r|g|b in three 16 bit lanes, max
// 81 * 255 per lane at radius 4: no carry) -> running sums along x -> running sums along z -> integer mean per channel (sum / n, like vanilla
// calculateBlockTint). Same values as ms_blend_color_c; the window columns are computed once instead of (2r+1)^2 times.
fn ms_blend_plane(m: *mut ModelSet, bio: u64, cls: usize, y: i32, wx: i32, wy: i32, wz: i32, cache: *mut BlendCache) {
    let r: i32 = (*m).blend
    let w2: i32 = 16 + 2 * r
    let nw: i32 = 2 * r + 1
    let nn: u32 = (nw * nw) as u32
    let col: u64 = (*cache).pcol
    let hs: u64 = (*cache).phs
    var jz: i32 = 0
    while jz < w2 {
        let wcz: i32 = jz + 4 - r
        var jx: i32 = 0
        while jx < w2 {
            let wcx: i32 = jx + 4 - r
            let bid: usize = ms_col_bid(m, bio, y, wcx, wcz, wx, wy, wz, cache)
            let c: u32 = ms_biome_color_xzc(m, cls, bid, wx + wcx - 4, wz + wcz - 4, cache, wcx, wcz)
            let pk: u64 = ((((c >> (16 as u32)) & (255 as u32)) as u64) << (32 as u64)) | ((((c >> (8 as u32)) & (255 as u32)) as u64) << (16 as u64)) | ((c & (255 as u32)) as u64)
            rt.st64(col, (jz * w2 + jx) as usize, pk)
            jx = jx + 1
        }
        // window sums along x of this row
        var s: u64 = 0 as u64
        var k: i32 = 0
        while k < nw {
            s = s + rt.ld64(col, (jz * w2 + k) as usize)
            k = k + 1
        }
        rt.st64(hs, (jz * 16) as usize, s)
        var x: i32 = 1
        while x < 16 {
            s = s + rt.ld64(col, (jz * w2 + x + nw - 1) as usize) - rt.ld64(col, (jz * w2 + x - 1) as usize)
            rt.st64(hs, (jz * 16 + x) as usize, s)
            x = x + 1
        }
        jz = jz + 1
    }
    let base: usize = ((y * 3) as usize + cls) * 256
    var x: i32 = 0
    while x < 16 {
        var s: u64 = 0 as u64
        var k: i32 = 0
        while k < nw {
            s = s + rt.ld64(hs, (k * 16 + x) as usize)
            k = k + 1
        }
        var z: i32 = 0
        while z < 16 {
            if z > 0 { s = s + rt.ld64(hs, ((z + nw - 1) * 16 + x) as usize) - rt.ld64(hs, ((z - 1) * 16 + x) as usize) }
            let sr: u32 = ((s >> (32 as u64)) & (65535 as u64)) as u32
            let sg: u32 = ((s >> (16 as u64)) & (65535 as u64)) as u32
            let sb: u32 = (s & (65535 as u64)) as u32
            rt.st32((*cache).pl, base + (z * 16 + x) as usize, (((sr / nn) & (255 as u32)) << (16 as u32)) | (((sg / nn) & (255 as u32)) << (8 as u32)) | ((sb / nn) & (255 as u32)))
            z = z + 1
        }
        x = x + 1
    }
}

// ms_blend_color_c through the layer planes: the first PLANE_AT - 1 blocks of a (height, class) layer are blended one by one, then the whole layer is
// computed by ms_blend_plane (cheaper from there on). Needs a cache; same values.
fn ms_blend_color_p(m: *mut ModelSet, bio: u64, cls: usize, lx: i32, y: i32, z: i32, wx: i32, wy: i32, wz: i32, cache: *mut BlendCache) -> u32 {
    if (*m).blend > 0 {
        let li: usize = (y * 3) as usize + cls
        var st: u8 = rt.ld8((*cache).pst, li)
        if st != (255 as u8) {
            st = st + (1 as u8)
            if st >= PLANE_AT {
                ms_blend_plane(m, bio, cls, y, wx, wy, wz, cache)
                st = 255 as u8
            }
            rt.st8((*cache).pst, li, st)
        }
        if st == (255 as u8) { return rt.ld32((*cache).pl, li * 256 + (z * 16 + lx) as usize) }
    }
    return ms_blend_color_c(m, bio, cls, lx, y, z, wx, wy, wz, cache)
}

// ms_blend_color_w for a section at the world origin.
fn ms_blend_color(m: *mut ModelSet, bio: u64, cls: usize, lx: i32, y: i32, z: i32) -> u32 {
    return ms_blend_color_w(m, bio, cls, lx, y, z, 0, 0, 0)
}

fn ms_lock(m: *mut ModelSet) {
    while __atomic_swap((*m).lk as *mut u64, 0 as u64, 1 as u64) != 0 as u64 {}
}

fn ms_unlock(m: *mut ModelSet) {
    __atomic_swap((*m).lk as *mut u64, 1 as u64, 0 as u64)
}

fn ms_free(m: *mut ModelSet) {
    if (*m).kind == 0 { return }
    var i: usize = 0
    while i < NSTATE_MAX * NVAR {
        let c: u32 = rt.ld32((*m).qcnt, i)
        let p: u64 = rt.ld64((*m).qptr, i)
        // variants of a non-weighted state share the pointer of variant 0: only the slot that owns it frees it
        if c != UNBAKED && c > 0 as u32 && p != 0 && (i % NVAR == 0 || rt.ld8((*m).weighted, i / NVAR) != 0 as u8) {
            rt.heap_free(p, (c as usize) * PQ_WORDS * 8)
        }
        i = i + 1
    }
    rt.heap_free((*m).kind, NSTATE_MAX)
    rt.heap_free((*m).weighted, NSTATE_MAX)
    rt.heap_free((*m).qptr, NSTATE_MAX * NVAR * 8)
    rt.heap_free((*m).qcnt, NSTATE_MAX * NVAR * 4)
    rt.heap_free((*m).tnames, NTEX * 64)
    rt.heap_free((*m).ttiles, NTEX * 4)
    rt.heap_free((*m).lk, 8)
    if (*m).btab != 0 {
        rt.heap_free((*m).btab, 3 * BT_MAXID * 4)
        (*m).btab = 0
    }
}

// ---- state string -------------------------------------------------------------------------------

// Splits "name[a=b,c=d]" (reg_state_text) of `state` into name and "a=b,c=d" (both appended to the cleared buffers). false = unknown state.
fn ms_state_parts(reg: *mut mc_registry.Registry, state: i32, name: *mut rt.Buf, props: *mut rt.Buf) -> bool {
    var full: rt.Buf = rt.buf_new()
    rt.buf_clear(name)
    rt.buf_clear(props)
    if !mc_registry.reg_state_text(reg, state, &full) {
        rt.buf_free(&full)
        return false
    }
    let p: u64 = rt.buf_ptr(&full)
    let n: usize = rt.buf_len(&full)
    var i: usize = 0
    while i < n && rt.ld8(p, i) != (91 as u8) { i = i + 1 }
    rt.buf_push_bytes(name, p, i)
    if i < n {
        var e: usize = n
        if rt.ld8(p, n - 1) == (93 as u8) { e = n - 1 }
        if e > i + 1 { rt.buf_push_bytes(props, p + ((i + 1) as u64), e - i - 1) }
    }
    rt.buf_free(&full)
    return true
}

// ---- texture name -> atlas tile -------------------------------------------------------------------

// "minecraft:block/oak_planks" / "block/oak_planks" -> the extended tile whose candidate file name is "oak_planks"; 0 = none.
fn ms_tex_tile(m: *mut ModelSet, nm: *mut mc_model.Name) -> u32 {
    // cache
    var t: usize = 0
    while t < (*m).ntex {
        var same: bool = true
        var i: usize = 0
        while i <= (*nm).n && i < 64 {
            if rt.ld8((*m).tnames, t * 64 + i) != (*nm).b[i] { same = false }
            i = i + 1
        }
        if same { return rt.ld32((*m).ttiles, t) }
        t = t + 1
    }
    // strip "minecraft:" and the folder ("block/" / "blocks/")
    var s: usize = 0
    if (*nm).n > 10 && rt.mem_eq(mc_model.name_ptr(nm), "minecraft:".p as u64, 10) { s = 10 }
    var k: usize = s
    var base: usize = s
    while k < (*nm).n {
        if (*nm).b[k] == (47 as u8) { base = k + 1 }
        k = k + 1
    }
    var tile: u32 = 0 as u32
    if base < (*nm).n {
        let np: u64 = mc_model.name_ptr(nm) + (base as u64)
        let nl: usize = (*nm).n - base
        var i: usize = 0
        while i < mc_texext.texext_count((*m).ex) && tile == 0 as u32 {
            var c: usize = 0
            var cp: u64 = 0
            var cl: usize = 0
            while tile == 0 as u32 && mc_texext.texext_cand((*m).ex, i, c, &cp, &cl) {
                if cl == nl && rt.mem_eq(cp, np, nl) { tile = mc_texext.texext_tile_id(i) }
                c = c + 1
            }
            i = i + 1
        }
    }
    if (*m).ntex < NTEX {
        var i: usize = 0
        while i <= (*nm).n && i < 64 {
            rt.st8((*m).tnames, (*m).ntex * 64 + i, (*nm).b[i])
            i = i + 1
        }
        rt.st32((*m).ttiles, (*m).ntex, tile)
        (*m).ntex = (*m).ntex + 1
    }
    return tile
}

// ---- classify + prepare -----------------------------------------------------------------------------

fn fabs(v: f64) -> f64 {
    if v < 0.0 { return 0.0 - v }
    return v
}

// Exactly six quads, each covering one whole face of the unit cube, all six directions: the cube mesher does that better (greedy, AO).
fn is_unit_cube(b: *mut mc_model.Baked) -> bool {
    if mc_model.baked_count(b) != 6 { return false }
    var seen: u32 = 0 as u32
    var i: usize = 0
    while i < 6 {
        var mn: [f64; 3] = [1000.0; 3]
        var mx: [f64; 3] = [0.0 - 1000.0; 3]
        var c: usize = 0
        while c < 4 {
            let x: f64 = mc_model.baked_f(b, i, mc_model.X0 + c)
            let y: f64 = mc_model.baked_f(b, i, mc_model.Y0 + c)
            let z: f64 = mc_model.baked_f(b, i, mc_model.Z0 + c)
            if x < mn[0] { mn[0] = x }
            if x > mx[0] { mx[0] = x }
            if y < mn[1] { mn[1] = y }
            if y > mx[1] { mx[1] = y }
            if z < mn[2] { mn[2] = z }
            if z > mx[2] { mx[2] = z }
            c = c + 1
        }
        var flat: i32 = 0 - 1
        var a: usize = 0
        while a < 3 {
            if fabs(mx[a] - mn[a]) < 0.0001 {
                if flat >= 0 { return false }
                flat = a as i32
                if !(fabs(mn[a]) < 0.0001 || fabs(mn[a] - 1.0) < 0.0001) { return false }
            } else {
                if !(fabs(mn[a]) < 0.0001 && fabs(mx[a] - 1.0) < 0.0001) { return false }
            }
            a = a + 1
        }
        if flat < 0 { return false }
        var side: i32 = 0
        if fabs(mn[flat as usize] - 1.0) < 0.0001 { side = 1 }
        // direction index 0 down, 1 up, 2 north, 3 south, 4 west, 5 east
        var dir: i32 = 0
        if flat == 1 { dir = side }
        if flat == 2 { dir = 2 + side }
        if flat == 0 { dir = 4 + side }
        seen = seen | ((1 as u32) << (dir as u32))
        i = i + 1
    }
    return seen == 63 as u32
}

fn shade_of(dir: i32, shade: bool) -> f64 {
    if !shade { return 256.0 }
    if dir == 0 { return 128.0 }
    if dir == 1 { return 256.0 }
    if dir == 2 || dir == 3 { return 153.0 }
    return 204.0
}

// 1.0 when the four corners of prepared quad `o` of `buf` all lie on the cell face `dir` (0 down 1 up 2 north 3 south 4 west 5 east) - the quad
// is then lit like a cube face (ao from the cells in front of it), else 0.0.
fn flat_on_face(buf: u64, o: usize, dir: i32) -> f64 {
    if dir < 0 || dir > 5 { return 0.0 }
    var axis: usize = 0
    if dir == 0 || dir == 1 { axis = 1 }
    if dir == 2 || dir == 3 { axis = 2 }
    var want: f64 = 0.0
    if dir % 2 == 1 { want = 1.0 }
    var c: usize = 0
    while c < 4 {
        let v: f64 = math.math_f64(rt.ld64(buf, o * PQ_WORDS + axis * 4 + c))
        if fabs(v - want) > 0.0001 { return 0.0 }
        c = c + 1
    }
    return 1.0
}

// byte search: does `h` (n bytes) contain the ASCII text `w`?
fn bytes_has(h: u64, n: usize, w: str) -> bool {
    let wl: usize = w.length()
    if wl > n { return false }
    var i: usize = 0
    while i + wl <= n {
        if rt.mem_eq(h + (i as u64), w.p as u64, wl) { return true }
        i = i + 1
    }
    return false
}

fn bytes_ends(h: u64, n: usize, w: str) -> bool {
    let wl: usize = w.length()
    if wl > n { return false }
    return rt.mem_eq(h + ((n - wl) as u64), w.p as u64, wl)
}

// Tint class of a block by its registry name (see the header); only used for quads that carry a tintindex.
fn tint_class(h: u64, n: usize) -> i32 {
    if bytes_has(h, n, "birch_leaves") { return 3 }
    if bytes_has(h, n, "spruce_leaves") { return 4 }
    if bytes_has(h, n, "leaves") || bytes_has(h, n, "vine") { return 1 }
    if bytes_has(h, n, "water") || bytes_has(h, n, "bubble_column") { return 2 }
    if bytes_has(h, n, "lily_pad") { return 5 }
    if bytes_has(h, n, "redstone_wire") { return 6 }
    return 0
}

// Translucent render class by block name: glass (all colours, panes), ice, frosted ice, slime, honey. Everything else is cut out at alpha 128.
fn is_translucent_name(h: u64, n: usize) -> bool {
    if bytes_has(h, n, "glass") || bytes_has(h, n, "slime_block") || bytes_has(h, n, "honey_block") { return true }
    if bytes_ends(h, n, "frosted_ice") { return true }
    if n == 3 && rt.mem_eq(h, "ice".p as u64, 3) { return true }
    if n >= 4 && bytes_ends(h, n, ":ice") { return true }
    return false
}

// Bakes state `s` for variant `v` (0..NVAR-1). Sets kind / weighted on v == 0. Returns the quad count (0 = nothing usable).
fn bake_state(m: *mut ModelSet, s: usize, v: usize) -> u32 {
    var name: rt.Buf = rt.buf_new()
    var props: rt.Buf = rt.buf_new()
    var cnt: u32 = 0 as u32
    if !ms_state_parts((*m).reg, s as i32, &name, &props) {
        rt.buf_free(&name)
        rt.buf_free(&props)
        if v == 0 { rt.st8((*m).kind, s, K_PLAIN) }
        return 0 as u32
    }
    let bname: str = str { p: rt.buf_ptr(&name) as *mut u8, n: rt.buf_len(&name) }
    let pstr: str = str { p: rt.buf_ptr(&props) as *mut u8, n: rt.buf_len(&props) }
    // distinct seeds with distinct residues for every weight total
    var seed: u32 = (v as u32) * (2654435761 as u32 / 4 as u32) + (v as u32)
    if v == 0 { seed = 0 as u32 }
    if v == 0 {
        var sel: mc_model.Selection = mc_model.selection_new()
        let nsel: i32 = mc_model.blockstate_select((*m).st, bname, pstr, seed, &sel)
        if nsel > 0 && sel.weighted { rt.st8((*m).weighted, s, 1 as u8) }
    }
    var b: mc_model.Baked = mc_model.baked_new()
    let nq: i32 = mc_model.blockstate_bake((*m).st, bname, pstr, seed, &b)
    var model: bool = false
    if nq > 0 && !is_unit_cube(&b) { model = true }
    if v == 0 && !model { rt.st8((*m).kind, s, K_PLAIN) }
    if model {
        let tcls: i32 = tint_class(rt.buf_ptr(&name), rt.buf_len(&name))
        var trn: f64 = 0.0
        if is_translucent_name(rt.buf_ptr(&name), rt.buf_len(&name)) { trn = 1.0 }
        let total: usize = mc_model.baked_count(&b)
        let buf: u64 = rt.heap_alloc(total * PQ_WORDS * 8)
        var tiles: [u32; 48] = [0 as u32; 48]
        var ti: usize = 0
        while ti < mc_model.baked_tex_count(&b) && ti < 48 {
            var tn: mc_model.Name = mc_model.name_new()
            if mc_model.baked_tex_name(&b, ti, &tn) { tiles[ti] = ms_tex_tile(m, &tn) }
            ti = ti + 1
        }
        var i: usize = 0
        var o: usize = 0
        while i < total {
            let ti2: usize = mc_model.baked_f(&b, i, mc_model.W_TEX) as usize
            var tile: u32 = 0 as u32
            if ti2 < 48 { tile = tiles[ti2] }
            if tile == 0 as u32 {
                (*m).unmapped = (*m).unmapped + 1
            } else {
                var c: usize = 0
                while c < 4 {
                    rt.st64(buf, o * PQ_WORDS + c, math.math_bits(mc_model.baked_f(&b, i, mc_model.X0 + c)))
                    rt.st64(buf, o * PQ_WORDS + 4 + c, math.math_bits(mc_model.baked_f(&b, i, mc_model.Y0 + c)))
                    rt.st64(buf, o * PQ_WORDS + 8 + c, math.math_bits(mc_model.baked_f(&b, i, mc_model.Z0 + c)))
                    rt.st64(buf, o * PQ_WORDS + 12 + c, math.math_bits(mc_model.baked_f(&b, i, mc_model.U0 + c) / 16.0))
                    rt.st64(buf, o * PQ_WORDS + 16 + c, math.math_bits(mc_model.baked_f(&b, i, mc_model.V0 + c) / 16.0))
                    c = c + 1
                }
                let dir: i32 = mc_model.baked_f(&b, i, mc_model.W_DIR) as i32
                let sh: bool = mc_model.baked_f(&b, i, mc_model.W_SHADE) > 0.5
                rt.st64(buf, o * PQ_WORDS + 20, math.math_bits(tile as f64))
                rt.st64(buf, o * PQ_WORDS + 21, math.math_bits(shade_of(dir, sh)))
                rt.st64(buf, o * PQ_WORDS + 22, math.math_bits(15.0))
                rt.st64(buf, o * PQ_WORDS + 23, math.math_bits(0.0))
                rt.st64(buf, o * PQ_WORDS + 24, math.math_bits(mc_model.baked_f(&b, i, mc_model.W_CULL)))
                rt.st64(buf, o * PQ_WORDS + 25, math.math_bits(dir as f64))
                var tc: f64 = 0.0 - 1.0
                if mc_model.baked_f(&b, i, mc_model.W_TINT) >= 0.0 { tc = tcls as f64 }
                rt.st64(buf, o * PQ_WORDS + 26, math.math_bits(tc))
                var qtrn: f64 = trn
                if qtrn < 0.5 && ms_tile_translucent(m, tile) { qtrn = 1.0 }
                rt.st64(buf, o * PQ_WORDS + 27, math.math_bits(qtrn))
                rt.st64(buf, o * PQ_WORDS + 28, math.math_bits(flat_on_face(buf, o, dir)))
                rt.st64(buf, o * PQ_WORDS + 29, math.math_bits(0.0))
                o = o + 1
            }
            i = i + 1
        }
        cnt = o as u32
        // keep the exact allocation size: ms_free frees count * PQ_WORDS * 8, so shrink the logical size to o
        if o == 0 {
            rt.heap_free(buf, total * PQ_WORDS * 8)
            rt.st64((*m).qptr, s * NVAR + v, 0 as u64)
        } else if o < total {
            let nb: u64 = rt.heap_alloc(o * PQ_WORDS * 8)
            rt.mem_copy(nb, buf, o * PQ_WORDS * 8)
            rt.heap_free(buf, total * PQ_WORDS * 8)
            rt.st64((*m).qptr, s * NVAR + v, nb)
        } else {
            rt.st64((*m).qptr, s * NVAR + v, buf)
        }
    }
    // published last: a thread that sees K_MODEL without the lock finds the quads (the counts are taken under the lock in ms_resolve)
    if v == 0 && model {
        rt.st8((*m).kind, s, K_MODEL)
        (*m).nmodel = (*m).nmodel + 1
    }
    mc_model.baked_free(&b)
    rt.buf_free(&name)
    rt.buf_free(&props)
    return cnt
}

// Kind of state `id` (bakes variant 0 on first use; thread safe: the bake runs under the ModelSet lock). Ids past the table and the mesher's UNKNOWN
// id are plain.
fn ms_kind(m: *mut ModelSet, id: u16) -> u8 {
    let s: usize = id as usize
    if s >= NSTATE_MAX || id == mc_mesh.UNKNOWN_ID { return K_PLAIN }
    var k: u8 = rt.ld8((*m).kind, s)
    if k != K_UNKNOWN { return k }
    ms_lock(m)
    k = rt.ld8((*m).kind, s)
    if k == K_UNKNOWN {
        let c: u32 = bake_state(m, s, 0)
        rt.st32((*m).qcnt, s * NVAR, c)
        k = rt.ld8((*m).kind, s)
        // a non weighted state shares its single bake with the other variants
        if k == K_MODEL && rt.ld8((*m).weighted, s) == 0 as u8 {
            var v: usize = 1
            while v < NVAR {
                rt.st64((*m).qptr, s * NVAR + v, rt.ld64((*m).qptr, s * NVAR))
                rt.st32((*m).qcnt, s * NVAR + v, c)
                v = v + 1
            }
        }
    }
    ms_unlock(m)
    return k
}

// Prepared quads of (state, variant): pointer + count. Bakes a weighted variant on demand (under the lock).
fn ms_resolve(m: *mut ModelSet, id: u16, v: usize, cnt: *mut u32) -> u64 {
    *cnt = 0 as u32
    if ms_kind(m, id) != K_MODEL { return 0 }
    let s: usize = id as usize
    var vv: usize = v
    if vv >= NVAR { vv = 0 }
    var c: u32 = rt.ld32((*m).qcnt, s * NVAR + vv)
    if c == UNBAKED {
        ms_lock(m)
        c = rt.ld32((*m).qcnt, s * NVAR + vv)
        if c == UNBAKED {
            c = bake_state(m, s, vv)
            rt.st32((*m).qcnt, s * NVAR + vv, c)
        }
        ms_unlock(m)
    }
    *cnt = c
    return rt.ld64((*m).qptr, s * NVAR + vv)
}

fn ms_quad_count(m: *mut ModelSet, id: u16) -> usize {
    var c: u32 = 0 as u32
    let p: u64 = ms_resolve(m, id, 0, &c)
    if p == 0 { return 0 }
    return c as usize
}

// Resolves every state of the padded section (18^3 u16) and removes the model states from the cube mesher's tables: no faces (tiles 0) and not
// opaque. Call BEFORE the cube meshing of the section (and of every section whose padded shell shows the state: the pad of the section includes it).
fn ms_prepare(m: *mut ModelSet, pad: u64, t: *mut mc_mesh.MeshTables) {
    var i: usize = 0
    while i < 5832 {
        let id: u16 = rt.ld16(pad, i)
        i = i + 1
        let s: usize = id as usize
        if s >= NSTATE_MAX || id == mc_mesh.UNKNOWN_ID { continue }
        if ms_kind(m, id) == K_MODEL {
            var f: usize = 0
            while f < 6 {
                rt.st16((*t).tiles, s * 6 + f, 0 as u16)
                f = f + 1
            }
            rt.st8((*t).opaque, s, 0 as u8)
        }
    }
}

// The same opaque-bit removal for a second opaque table (the caller's original while a private translucent copy is in use).
fn ms_patch_opaque(m: *mut ModelSet, opaque: u64) {
    var s: usize = 0
    while s < NSTATE_MAX {
        if rt.ld8((*m).kind, s) == K_MODEL { rt.st8(opaque, s, 0 as u8) }
        s = s + 1
    }
}

// ---- mesh -------------------------------------------------------------------------------------------

fn stq(out: *mut rt.Buf, w: usize, v: f64) {
    var bits: u64 = math.math_bits(v)
    rt.buf_push_bytes(out, (&bits) as u64, 8)
    if w == 0 { return }
}

// 1 when the cell at padded index `i` + (dx, dy, dz) is opaque (tables.opaque bit 0) - the AO occluder test. Unknown / not loaded cells do not occlude.
fn occludes(pad: u64, t: *mut mc_mesh.MeshTables, i: usize, dx: i32, dy: i32, dz: i32) -> i32 {
    let ni: i32 = (i as i32) + dy * 324 + dz * 18 + dx
    if ni < 0 || ni >= 5832 { return 0 }
    let nid: u16 = rt.ld16(pad, ni as usize)
    if nid == mc_mesh.UNKNOWN_ID || (nid as usize) >= 32768 { return 0 }
    if (rt.ld8((*t).opaque, nid as usize) & (1 as u8)) != (0 as u8) { return 1 }
    return 0
}

// AO of one corner of a quad lying on cell face `dir` (same rule as the cube mesher: both sides solid = 0, else 3 - sides - corner). (px, py, pz) =
// the corner in unit block coordinates; the two tangent axes pick the side by which half of the face the corner is in.
fn corner_ao(pad: u64, t: *mut mc_mesh.MeshTables, i: usize, dir: i32, px: f64, py: f64, pz: f64) -> f64 {
    var nx: i32 = 0
    var ny: i32 = 0
    var nz: i32 = 0
    var sg: i32 = 0 - 1
    if dir % 2 == 1 { sg = 1 }
    var a1x: i32 = 0
    var a1y: i32 = 0
    var a1z: i32 = 0
    var a2x: i32 = 0
    var a2y: i32 = 0
    var a2z: i32 = 0
    var p1: f64 = 0.0
    var p2: f64 = 0.0
    if dir == 0 || dir == 1 {
        ny = sg
        a1x = 1
        a2z = 1
        p1 = px
        p2 = pz
    } else if dir == 2 || dir == 3 {
        nz = sg
        a1x = 1
        a2y = 1
        p1 = px
        p2 = py
    } else {
        nx = sg
        a1y = 1
        a2z = 1
        p1 = py
        p2 = pz
    }
    var s1: i32 = 0 - 1
    var s2: i32 = 0 - 1
    if p1 >= 0.5 { s1 = 1 }
    if p2 >= 0.5 { s2 = 1 }
    let sa: i32 = occludes(pad, t, i, nx + s1 * a1x, ny + s1 * a1y, nz + s1 * a1z)
    let sb: i32 = occludes(pad, t, i, nx + s2 * a2x, ny + s2 * a2y, nz + s2 * a2z)
    if sa == 1 && sb == 1 { return 0.0 }
    let sc: i32 = occludes(pad, t, i, nx + s1 * a1x + s2 * a2x, ny + s1 * a1y + s2 * a2y, nz + s1 * a1z + s2 * a2z)
    return (3 - sa - sb - sc) as f64
}

// Model quads of the section, all in `out` (opaque first, then the translucent ones). See ms_mesh_split.
fn ms_mesh(m: *mut ModelSet, pad: u64, lpad: u64, t: *mut mc_mesh.MeshTables, wx: i32, wy: i32, wz: i32, out: *mut rt.Buf) -> usize {
    var tb: rt.Buf = rt.buf_new()
    let n0: usize = ms_mesh_split(m, pad, lpad, t, wx, wy, wz, out, &tb)
    rt.buf_push_bytes(out, rt.buf_ptr(&tb), rt.buf_len(&tb))
    let n: usize = n0 + rt.buf_len(&tb) / (MQ_WORDS * 8)
    rt.buf_free(&tb)
    return n
}

// Model quads of the section. pad = u16 [18^3], lpad = u8 [18^3] (sky << 4 | block) or 0, t = the cube tables (opaque bit 0 culls and occludes AO),
// (wx, wy, wz) = world position of the section's block (0, 0, 0) (the weighted-variant seed uses world block positions). Appends MQ_WORDS f64 per
// quad to `out` (cleared first); translucent quads (glass, ice ...) go to `out_t` (cleared too). Returns the opaque quad count; the translucent
// count is rt.buf_len(out_t) / (MQ_WORDS * 8). Tint, flags and AO: see MQ_WORDS.
fn ms_mesh_split(m: *mut ModelSet, pad: u64, lpad: u64, t: *mut mc_mesh.MeshTables, wx: i32, wy: i32, wz: i32, out: *mut rt.Buf, out_t: *mut rt.Buf) -> usize {
    return ms_mesh_split_bio(m, pad, lpad, t, wx, wy, wz, out, out_t, 0)
}

// ms_mesh_split with biome tint: `bio` = the BIO_BYTES grid of ms_snap_bio (0 = class colours only; also needs ms_load_biomes).
fn ms_mesh_split_bio(m: *mut ModelSet, pad: u64, lpad: u64, t: *mut mc_mesh.MeshTables, wx: i32, wy: i32, wz: i32, out: *mut rt.Buf, out_t: *mut rt.Buf, bio: u64) -> usize {
    rt.buf_clear(out)
    rt.buf_clear(out_t)
    var nq: usize = 0
    var bcache: BlendCache = BlendCache { bz: mc_biome_zoom.BzCache { cx0: 0, cy0: 0, cz0: 0, fv: 0, fd: 0 }, ids: 0, sw: 0, pl: 0, pst: 0, pcol: 0, phs: 0 }
    var bcache_on: bool = false
    var y: i32 = 0
    while y < 16 {
        var z: i32 = 0
        while z < 16 {
            var x: i32 = 0
            while x < 16 {
                let pi: usize = (((y + 1) * 18 + (z + 1)) * 18 + (x + 1)) as usize
                let id: u16 = rt.ld16(pad, pi)
                x = x + 1
                if (id as usize) >= NSTATE_MAX || id == mc_mesh.UNKNOWN_ID { continue }
                if rt.ld8((*m).kind, id as usize) == K_PLAIN { continue }
                var v: usize = 0
                if rt.ld8((*m).weighted, id as usize) != 0 as u8 {
                    v = (mc_model.seed_from_pos(wx + x - 1, wy + y, wz + z) % (NVAR as u32)) as usize
                }
                var bc: [u32; 3] = [0 as u32; 3] // blended biome colours of this block per tint class, bit 24 = computed
                var cnt: u32 = 0 as u32
                let q: u64 = ms_resolve(m, id, v, &cnt)
                if q == 0 { continue }
                var i: usize = 0
                while i < (cnt as usize) {
                    let cull: i32 = math.math_f64(rt.ld64(q, i * PQ_WORDS + 24)) as i32
                    var lc: usize = pi
                    var skip: bool = false
                    if cull >= 0 {
                        let dv: mc_model.V3 = mc_model.dir_vec(cull as usize)
                        let ni: usize = (((y + 1 + (dv.y as i32)) * 18 + (z + 1 + (dv.z as i32))) * 18 + (x - 1 + 1 + (dv.x as i32))) as usize
                        let nid: u16 = rt.ld16(pad, ni)
                        if nid == mc_mesh.UNKNOWN_ID {
                            skip = true
                        } else if ((nid as usize) < 32768) && (rt.ld8((*t).opaque, nid as usize) & (1 as u8)) != (0 as u8) {
                            skip = true
                        }
                        lc = ni
                    }
                    if !skip {
                        var sky: f64 = 15.0
                        var blk: f64 = 0.0
                        if lpad != 0 {
                            let lv: u8 = rt.ld8(lpad, lc)
                            sky = (lv >> (4 as u8)) as f64
                            blk = (lv & (15 as u8)) as f64
                        }
                        var dst: *mut rt.Buf = out
                        var trn: bool = false
                        if math.math_f64(rt.ld64(q, i * PQ_WORDS + 27)) > 0.5 {
                            dst = out_t
                            trn = true
                        }
                        var c: usize = 0
                        while c < 4 {
                            stq(dst, 1, math.math_f64(rt.ld64(q, i * PQ_WORDS + c)) + ((x - 1) as f64))
                            c = c + 1
                        }
                        c = 0
                        while c < 4 {
                            stq(dst, 1, math.math_f64(rt.ld64(q, i * PQ_WORDS + 4 + c)) + (y as f64))
                            c = c + 1
                        }
                        c = 0
                        while c < 4 {
                            stq(dst, 1, math.math_f64(rt.ld64(q, i * PQ_WORDS + 8 + c)) + (z as f64))
                            c = c + 1
                        }
                        c = 0
                        while c < 8 {
                            stq(dst, 1, math.math_f64(rt.ld64(q, i * PQ_WORDS + 12 + c)))
                            c = c + 1
                        }
                        stq(dst, 1, math.math_f64(rt.ld64(q, i * PQ_WORDS + 20)))
                        stq(dst, 1, math.math_f64(rt.ld64(q, i * PQ_WORDS + 21)))
                        stq(dst, 1, sky)
                        stq(dst, 1, blk)
                        // tint
                        let tcls: i32 = math.math_f64(rt.ld64(q, i * PQ_WORDS + 26)) as i32
                        var tv: f64 = 0.0 - 1.0
                        if tcls >= 0 && (tcls as usize) < NTINT {
                            var rgb: u32 = (*m).tint[tcls as usize]
                            if bio != 0 && tcls < 3 {
                                if (bc[tcls as usize] & (16777216 as u32)) == (0 as u32) {
                                    if !bcache_on {
                                        bcache = bcache_new(wx, wy, wz)
                                        bcache_on = true
                                    }
                                    bc[tcls as usize] = ms_blend_color_p(m, bio, tcls as usize, x - 1, y, z, wx, wy, wz, &bcache) | (16777216 as u32)
                                }
                                rgb = bc[tcls as usize] & (16777215 as u32)
                            }
                            tv = (((rgb >> (16 as u32)) & (255 as u32)) | (rgb & (65280 as u32)) | ((rgb & (255 as u32)) << (16 as u32))) as f64
                        }
                        stq(dst, 1, tv)
                        var fl: f64 = 0.0
                        if trn { fl = 1.0 }
                        stq(dst, 1, fl)
                        // ambient occlusion per corner
                        let flat: bool = math.math_f64(rt.ld64(q, i * PQ_WORDS + 28)) > 0.5
                        let dir: i32 = math.math_f64(rt.ld64(q, i * PQ_WORDS + 25)) as i32
                        c = 0
                        while c < 4 {
                            var ao: f64 = 3.0
                            if flat {
                                ao = corner_ao(pad, t, pi, dir, math.math_f64(rt.ld64(q, i * PQ_WORDS + c)), math.math_f64(rt.ld64(q, i * PQ_WORDS + 4 + c)),
                                    math.math_f64(rt.ld64(q, i * PQ_WORDS + 8 + c)))
                            }
                            stq(dst, 1, ao)
                            c = c + 1
                        }
                        if !trn { nq = nq + 1 }
                    }
                    i = i + 1
                }
            }
            z = z + 1
        }
        y = y + 1
    }
    if bcache_on { bcache_free(&bcache) }
    return nq
}
