// lib/mc/mc_chat_assets.fi -- loads the vanilla font glyph rows and the tab list art (ping icons, default heads) once from the client jar.
//
//   chatassets_load(protocol)    false when no vanilla jar is found (the built-in 6 px font stays in use)

import mc.mc_gui_pack
import mc.mc_hud_vfont
import mc.mc_tab_art

export { chatassets_load }

fn chatassets_load(protocol: i32) -> bool {
    var pk: mc_gui_pack.GuiPack = mc_gui_pack.gpack_new()
    if !mc_gui_pack.gpack_open(&pk, protocol) {
        mc_gui_pack.gpack_free(&pk)
        return false
    }
    let font_ok: bool = mc_hud_vfont.vfont_load(&pk.font)
    mc_tab_art.tabart_load(&pk)
    mc_gui_pack.gpack_free(&pk)
    return font_ok
}
