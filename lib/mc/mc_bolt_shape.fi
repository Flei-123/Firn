// SPDX-License-Identifier: MPL-2.0
import mc.mc_noise

export { BoltShape, bolt_shape_new, bolt_shape_build, bolt_seed, BOLT_SEGMENTS, BOLT_MAIN_SEGMENTS, BOLT_SEG_HEIGHT, BOLT_WORDS }

const BOLT_MAIN_SEGMENTS: usize = 8
const BOLT_SEGMENTS: usize = 14
const BOLT_SEG_HEIGHT: f64 = 16.0
const BOLT_WORDS: usize = 6
const STEP_BOUND: i32 = 11
const STEP_BIAS: i32 = 5
const BRANCHES: i32 = 3
const SEED_MIX: u64 = 11400714819323198485

struct BoltShape {
    n: usize,
    v: [f64; 84],
}

fn bolt_shape_new() -> BoltShape {
    return BoltShape { n: 0, v: [0.0; 84] }
}

fn bolt_seed(entity_id: i32) -> i64 {
    return (((entity_id as u64) + 1 as u64) *% SEED_MIX) as i64
}

fn step(g: *mut mc_noise.JavaRandom) -> f64 {
    return (mc_noise.jrandom_next_int_bound(g, STEP_BOUND) - STEP_BIAS) as f64
}

fn push_segment(s: *mut BoltShape, x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64) {
    let o: usize = (*s).n * BOLT_WORDS
    (*s).v[o] = x0
    (*s).v[o + 1] = y0
    (*s).v[o + 2] = z0
    (*s).v[o + 3] = x1
    (*s).v[o + 4] = y1
    (*s).v[o + 5] = z1
    (*s).n = (*s).n + 1
}

fn bolt_shape_build(s: *mut BoltShape, seed: i64) {
    (*s).n = 0
    var g: mc_noise.JavaRandom = mc_noise.jrandom_new(seed)
    var ax: [f64; 8] = [0.0; 8]
    var az: [f64; 8] = [0.0; 8]
    var fx: f64 = 0.0
    var fz: f64 = 0.0
    var i: i32 = 7
    while i >= 0 {
        ax[i as usize] = fx
        az[i as usize] = fz
        fx = fx + step(&g)
        fz = fz + step(&g)
        i = i - 1
    }
    var r: mc_noise.JavaRandom = mc_noise.jrandom_new(seed)
    var j: i32 = 0
    while j < BRANCHES {
        var top: i32 = 7
        var stop: i32 = 0
        if j > 0 {
            top = 7 - j
            stop = top - 2
        }
        var x: f64 = ax[top as usize] - fx
        var z: f64 = az[top as usize] - fz
        var k: i32 = top
        while k >= stop {
            let x0: f64 = x
            let z0: f64 = z
            x = x + step(&r)
            z = z + step(&r)
            push_segment(s, x0, ((k + 1) as f64) * BOLT_SEG_HEIGHT, z0, x, (k as f64) * BOLT_SEG_HEIGHT, z)
            k = k - 1
        }
        j = j + 1
    }
}
