// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_entity_draw.fi -- entity store (mc_entity) -> generic box models -> ONE record list for the back end.
//
// Every entity becomes a few flat coloured boxes of our own geometry (NO Mojang models / textures): living things and
// players = 6 boxes (head, body, 2 arms, 2 legs), objects = 1 box. Entities beyond `far_lod` blocks are a single box.
// Entities outside the camera frustum are skipped (one AABB test per entity, mc_math.frustum_test_box).
// The records (mc_backend.ENT_WORDS f64: x y z sx sy sz sin cos r g b flags) go to b.draw_entities: CPU = mc_raster.raster_draw_box
// (the reference), GL = ONE glDrawElementsInstanced for all boxes (gl_scene.scene_attach).
//
//     var l: mc_entity_draw.EntList = mc_entity_draw.entlist_new()
//     mc_entity_draw.entlist_build(&l, &store, &cam, 64.0, 24.0)
//     let drawn: u64 = mc_entity_draw.entlist_draw(&l, &backend)      // after the world draws
//     mc_entity_draw.entlist_free(&l)

import std.rt
import std.math
import mc.mc_entity
import mc.mc_camera
import mc.mc_math
import mc.mc_backend
import mc.mc_registry
import mc.mc_hurt_tint
import mc.mc_bolt_shape
import mc.mc_emodel
import mc.mc_emodel_pose
import mc.mc_entity_skins

export {
    EntList, entlist_new, entlist_free, entlist_clear, entlist_add_model, entlist_add_sized, entlist_build, entlist_build_reg, entlist_draw, entlist_boxes, entlist_set_hurt, entlist_set_bolt_type, entlist_add_bolt, entlist_set_skins, entlist_open_skins, entlist_set_death, entlist_skinned, entlist_add_box, entlist_add_part,
}

struct EntList {
    buf: rt.Buf, // ENT_BYTES per box
    n_in: u32, // entities seen by the last entlist_build
    n_culled: u32, // outside the frustum / too far
    n_lod: u32, // drawn as one box
    hurt: u64,
    now_ms: u64,
    tint_k: i32,
    n_tinted: u32,
    bolt_type: i32,
    n_bolts: u32,
    n_bolt_boxes: u32,
    sk: rt.Buf,
    models: mc_emodel.EModels,
    skins: mc_entity_skins.EntitySkins,
    skin_px: u64,
    skin_dirty: bool,
    death: u64,
    n_skinned: u32,
}

fn entlist_new() -> EntList {
    return EntList { buf: rt.buf_new(), n_in: 0 as u32, n_culled: 0 as u32, n_lod: 0 as u32, hurt: 0 as u64, now_ms: 0 as u64, tint_k: 0, n_tinted: 0 as u32, bolt_type: 0 - 1, n_bolts: 0 as u32, n_bolt_boxes: 0 as u32,
        sk: rt.buf_new(), models: mc_emodel.emodels_build(), skins: mc_entity_skins.skins_new(), skin_px: 0 as u64, skin_dirty: false, death: 0 as u64, n_skinned: 0 as u32 }
}

fn entlist_open_skins(l: *mut EntList, protocol: i32) -> bool {
    if !mc_entity_skins.skins_open(&(*l).skins, protocol) { return false }
    entlist_set_skins(l, (*l).skins.px)
    return true
}

fn entlist_set_skins(l: *mut EntList, px: u64) {
    if (*l).skin_px != px { (*l).skin_dirty = true }
    (*l).skin_px = px
}

fn entlist_set_death(l: *mut EntList, t: *mut mc_hurt_tint.HurtTable) {
    (*l).death = t as u64
}

fn entlist_skinned(l: *mut EntList) -> usize {
    return rt.buf_len(&(*l).sk) / mc_emodel_pose.SK_BYTES
}

fn skin_pose(l: *mut EntList, e: *mut mc_entity.Entity, eyaw: f64, epitch: f64) -> mc_emodel_pose.Pose {
    var p: mc_emodel_pose.Pose = mc_emodel_pose.pose_new()
    p.swing = (*e).swing
    p.amount = (*e).swing_amount
    p.age = ((*l).now_ms as f64) * 0.02
    p.head_pitch = epitch
    if (*l).tint_k > 0 {
        let k: f64 = ((*l).tint_k as f64) * 0.001
        p.tg = 255.0 * (1.0 - 0.6 * k)
        p.tb = p.tg
    }
    if (*l).death != 0 as u64 {
        let age: i64 = mc_hurt_tint.hurt_since((*l).death as *mut mc_hurt_tint.HurtTable, (*e).id, (*l).now_ms)
        if age >= 0 as i64 {
            var d: f64 = (age as f64) / 800.0
            if d > 1.0 { d = 1.0 }
            p.death = d
        }
    }
    return p
}

fn try_skinned(l: *mut EntList, e: *mut mc_entity.Entity, reg: *mut mc_registry.Registry, ex: f64, ey: f64, ez: f64, eyaw: f64, epitch: f64) -> bool {
    if (*l).skin_px == 0 as u64 || (reg as u64) == 0 as u64 || (*e).kind == mc_entity.KIND_PLAYER || (*e).type_id < 0 { return false }
    let ri: i32 = mc_registry.reg_entity_find(reg, (*e).type_id)
    if ri < 0 { return false }
    var nl: usize = 0
    let np: u64 = mc_registry.reg_entity_name(reg, ri, &nl)
    let mob: i32 = mc_emodel.emodel_find(&(*l).models, np, nl)
    if mob < 0 { return false }
    var pose: mc_emodel_pose.Pose = skin_pose(l, e, eyaw, epitch)
    mc_emodel_pose.emodel_emit(&(*l).models, mob, &pose, ex, ey, ez, eyaw, &(*l).sk)
    (*l).n_skinned = (*l).n_skinned + 1 as u32
    return true
}

fn entlist_set_hurt(l: *mut EntList, t: *mut mc_hurt_tint.HurtTable, now: u64) {
    (*l).hurt = t as u64
    (*l).now_ms = now
}

fn entlist_free(l: *mut EntList) {
    rt.buf_free(&(*l).buf)
    rt.buf_free(&(*l).sk)
    mc_entity_skins.skins_free(&(*l).skins)
    mc_emodel.emodels_free(&(*l).models)
}

fn entlist_clear(l: *mut EntList) {
    rt.buf_clear(&(*l).buf)
    rt.buf_clear(&(*l).sk)
    (*l).n_skinned = 0 as u32
    (*l).n_in = 0 as u32
    (*l).n_culled = 0 as u32
    (*l).n_lod = 0 as u32
    (*l).n_tinted = 0 as u32
    (*l).n_bolts = 0 as u32
    (*l).n_bolt_boxes = 0 as u32
}

const BOLT_MAX_DIST: f64 = 320.0
const BOLT_SLICES: usize = 16
const BOLT_REACH: f64 = 48.0
const BOLT_HEIGHT: f64 = 132.0
const BOLT_WIDTH: f64 = 0.35
const BOLT_BRANCH_WIDTH: f64 = 0.22
const BOLT_WIDTH_PER_BLOCK: f64 = 0.004
const BOLT_WIDTH_MAX: f64 = 1.2
const BOLT_R: i32 = 245
const BOLT_G: i32 = 245
const BOLT_B: i32 = 255
const FLAG_EMISSIVE: f64 = 0.0 - 1.0

fn entlist_set_bolt_type(l: *mut EntList, type_id: i32) {
    (*l).bolt_type = type_id
}

fn bolt_width(base: f64, dist: f64) -> f64 {
    var w: f64 = base + dist * BOLT_WIDTH_PER_BLOCK
    if w > BOLT_WIDTH_MAX { w = BOLT_WIDTH_MAX }
    return w
}

fn entlist_add_bolt(l: *mut EntList, x: f64, y: f64, z: f64, seed: i64, dist: f64) {
    var sh: mc_bolt_shape.BoltShape = mc_bolt_shape.bolt_shape_new()
    mc_bolt_shape.bolt_shape_build(&sh, seed)
    let boxes_before: usize = entlist_boxes(l)
    let slice_h: f64 = mc_bolt_shape.BOLT_SEG_HEIGHT / (BOLT_SLICES as f64)
    var i: usize = 0
    while i < sh.n {
        let o: usize = i * mc_bolt_shape.BOLT_WORDS
        var base: f64 = BOLT_WIDTH
        if i >= mc_bolt_shape.BOLT_MAIN_SEGMENTS { base = BOLT_BRANCH_WIDTH }
        let w: f64 = bolt_width(base, dist)
        var k: usize = 0
        while k < BOLT_SLICES {
            let t: f64 = ((k as f64) + 0.5) / (BOLT_SLICES as f64)
            let cx: f64 = x + sh.v[o] + (sh.v[o + 3] - sh.v[o]) * t
            let cy: f64 = y + sh.v[o + 1] + (sh.v[o + 4] - sh.v[o + 1]) * t
            let cz: f64 = z + sh.v[o + 2] + (sh.v[o + 5] - sh.v[o + 2]) * t
            push_emissive_box(l, cx, cy, cz, w, slice_h, w, BOLT_R, BOLT_G, BOLT_B)
            k = k + 1
        }
        i = i + 1
    }
    (*l).n_bolts = (*l).n_bolts + 1 as u32
    (*l).n_bolt_boxes = (*l).n_bolt_boxes + ((entlist_boxes(l) - boxes_before) as u32)
}

fn bolt_visible(l: *mut EntList, e: *mut mc_entity.Entity, ex: f64, ey: f64, ez: f64, cam: *mut mc_camera.Camera) -> bool {
    let dx: f64 = ex - (*cam).x
    let dz: f64 = ez - (*cam).z
    if dx * dx + dz * dz > BOLT_MAX_DIST * BOLT_MAX_DIST { return false }
    return mc_math.frustum_test_box(&(*cam).frustum, ex - BOLT_REACH, ey, ez - BOLT_REACH, ex + BOLT_REACH, ey + BOLT_HEIGHT, ez + BOLT_REACH) != 0
}

fn entlist_boxes(l: *mut EntList) -> usize {
    return rt.buf_len(&(*l).buf) / mc_backend.ENT_BYTES
}

fn push_box(l: *mut EntList, x: f64, y: f64, z: f64, sx: f64, sy: f64, sz: f64, ys: f64, yc: f64, r: i32, g: i32, b: i32) {
    var rr: i32 = r
    var gg: i32 = g
    var bb: i32 = b
    if (*l).tint_k > 0 {
        let packed: i32 = mc_hurt_tint.hurt_blend(r, g, b, (*l).tint_k)
        rr = packed & 255
        gg = (packed >> 8) & 255
        bb = (packed >> 16) & 255
    }
    var rec: [f64; 12] = [x, y, z, sx, sy, sz, ys, yc, rr as f64, gg as f64, bb as f64, 0.0]
    rt.buf_push_bytes(&(*l).buf, (&rec[0]) as u64, mc_backend.ENT_BYTES)
}

fn entlist_add_box(l: *mut EntList, x: f64, y: f64, z: f64, sx: f64, sy: f64, sz: f64, r: i32, g: i32, b: i32) {
    push_box(l, x, y, z, sx, sy, sz, 0.0, 1.0, r, g, b)
}

fn push_emissive_box(l: *mut EntList, x: f64, y: f64, z: f64, sx: f64, sy: f64, sz: f64, r: i32, g: i32, b: i32) {
    var rec: [f64; 12] = [x, y, z, sx, sy, sz, 0.0, 1.0, r as f64, g as f64, b as f64, FLAG_EMISSIVE]
    rt.buf_push_bytes(&(*l).buf, (&rec[0]) as u64, mc_backend.ENT_BYTES)
}

fn clamp255(v: i32) -> i32 {
    if v < 0 { return 0 }
    if v > 255 { return 255 }
    return v
}

// A part at local offset (dx, dz) from the feet position, rotated by the entity yaw (sin / cos).
fn part(l: *mut EntList, x: f64, y: f64, z: f64, ys: f64, yc: f64, dx: f64, dy: f64, dz: f64, sx: f64, sy: f64, sz: f64,
    r: i32, g: i32, b: i32) {
    push_box(l, x + (dx * yc + dz * ys), y + dy, z + (0.0 - dx * ys + dz * yc), sx, sy, sz, ys, yc,
        clamp255(r), clamp255(g), clamp255(b))
}

// Adds the box model of one entity. (x, y, z) = feet, yaw in degrees, `seed` picks the tint (deterministic), humanoid = 6 boxes.
fn entlist_add_model(l: *mut EntList, x: f64, y: f64, z: f64, yaw_deg: f64, seed: u64, humanoid: bool, lod: bool) {
    let rad: f64 = yaw_deg * 0.017453292519943295
    let ys: f64 = math.sin(rad)
    let yc: f64 = math.cos(rad)
    let h: u64 = (seed *% 11400714819323198485) >> 40
    let r: i32 = 60 + ((h & 127 as u64) as i32)
    let g: i32 = 60 + (((h >> 7 as u64) & 127 as u64) as i32)
    let b: i32 = 60 + (((h >> 14 as u64) & 127 as u64) as i32)
    if !humanoid {
        part(l, x, y, z, ys, yc, 0.0, 0.25, 0.0, 0.5, 0.5, 0.5, r, g, b)
        return
    }
    if lod {
        part(l, x, y, z, ys, yc, 0.0, 0.9, 0.0, 0.6, 1.8, 0.6, r, g, b)
        return
    }
    part(l, x, y, z, ys, yc, 0.0 - 0.125, 0.375, 0.0, 0.25, 0.75, 0.25, r - 30, g - 30, b - 30)
    part(l, x, y, z, ys, yc, 0.125, 0.375, 0.0, 0.25, 0.75, 0.25, r - 30, g - 30, b - 30)
    part(l, x, y, z, ys, yc, 0.0, 1.125, 0.0, 0.5, 0.75, 0.25, r, g, b)
    part(l, x, y, z, ys, yc, 0.0 - 0.375, 1.125, 0.0, 0.25, 0.75, 0.25, r + 20, g + 20, b + 20)
    part(l, x, y, z, ys, yc, 0.375, 1.125, 0.0, 0.25, 0.75, 0.25, r + 20, g + 20, b + 20)
    part(l, x, y, z, ys, yc, 0.0, 1.75, 0.0, 0.5, 0.5, 0.5, r + 60, g + 60, b + 60)
}

fn entlist_add_part(l: *mut EntList, x: f64, y: f64, z: f64, yaw_deg: f64, dx: f64, dy: f64, dz: f64, sx: f64, sy: f64, sz: f64,
    r: i32, g: i32, b: i32) {
    let rad: f64 = yaw_deg * 0.017453292519943295
    part(l, x, y, z, math.sin(rad), math.cos(rad), dx, dy, dz, sx, sy, sz, r, g, b)
}

// One box of the registry size (width x height x width, feet at y) for a non-humanoid entity; a few shades of the seed tint.
fn entlist_add_sized(l: *mut EntList, x: f64, y: f64, z: f64, yaw_deg: f64, seed: u64, w: f64, h: f64) {
    let rad: f64 = yaw_deg * 0.017453292519943295
    let ys: f64 = math.sin(rad)
    let yc: f64 = math.cos(rad)
    let hh: u64 = (seed *% 11400714819323198485) >> 40
    let r: i32 = 60 + ((hh & 127 as u64) as i32)
    let g: i32 = 60 + (((hh >> 7 as u64) & 127 as u64) as i32)
    let b: i32 = 60 + (((hh >> 14 as u64) & 127 as u64) as i32)
    part(l, x, y, z, ys, yc, 0.0, h * 0.5, 0.0, w, h, w, r, g, b)
}

// Replaces the list by the visible entities of `s`: frustum culling with the camera, `max_dist` blocks (0 = no limit),
// single box beyond `far_lod` blocks. Without a registry every non-player entity is the 0.5 block object box.
fn entlist_build(l: *mut EntList, s: *mut mc_entity.Store, cam: *mut mc_camera.Camera, max_dist: f64, far_lod: f64) {
    build_inner(l, s, cam, max_dist, far_lod, 0 as u64 as *mut mc_registry.Registry)
}

// Same, but non-player entities use the registry width / height of their type (entity type id -> mc_registry entity record).
fn entlist_build_reg(l: *mut EntList, s: *mut mc_entity.Store, cam: *mut mc_camera.Camera, max_dist: f64, far_lod: f64,
    reg: *mut mc_registry.Registry) {
    build_inner(l, s, cam, max_dist, far_lod, reg)
}

fn build_inner(l: *mut EntList, s: *mut mc_entity.Store, cam: *mut mc_camera.Camera, max_dist: f64, far_lod: f64,
    reg: *mut mc_registry.Registry) {
    entlist_clear(l)
    let cap: usize = mc_entity.store_slot_cap(s)
    var i: usize = 0
    while i < cap {
        let e: *mut mc_entity.Entity = mc_entity.store_at(s, i)
        i = i + 1
        if e as u64 == 0 { continue }
        (*l).n_in = (*l).n_in + 1 as u32
        // smoothed render state (mc_entity.store_interp) when it exists, else the network position
        var ex: f64 = (*e).x
        var ey: f64 = (*e).y
        var ez: f64 = (*e).z
        var eyaw: f64 = (*e).yaw
        if (*e).rinit {
            ex = (*e).rx
            ey = (*e).ry
            ez = (*e).rz
            eyaw = (*e).ryaw
        }
        // registry size of the type (0 = unknown / player / no registry)
        var bw: f64 = 0.0
        var bh: f64 = 0.0
        if (reg as u64) != 0 as u64 && (*e).kind != mc_entity.KIND_PLAYER && (*e).type_id >= 0 {
            let ri: i32 = mc_registry.reg_entity_find(reg, (*e).type_id)
            if ri >= 0 {
                bw = (mc_registry.reg_entity_width_milli(reg, ri) as f64) * 0.001
                bh = (mc_registry.reg_entity_height_milli(reg, ri) as f64) * 0.001
            }
        }
        if (*l).bolt_type >= 0 && (*e).type_id == (*l).bolt_type {
            if bolt_visible(l, e, ex, ey, ez, cam) {
                let bdx: f64 = ex - (*cam).x
                let bdz: f64 = ez - (*cam).z
                entlist_add_bolt(l, ex, ey, ez, mc_bolt_shape.bolt_seed((*e).id), math.sqrt(bdx * bdx + bdz * bdz))
            } else {
                (*l).n_culled = (*l).n_culled + 1 as u32
            }
            continue
        }
        let dx: f64 = ex - (*cam).x
        let dy: f64 = ey - (*cam).y
        let dz: f64 = ez - (*cam).z
        let d2: f64 = dx * dx + dy * dy + dz * dz
        if max_dist > 0.0 && d2 > max_dist * max_dist {
            (*l).n_culled = (*l).n_culled + 1 as u32
            continue
        }
        if mc_math.frustum_test_box(&(*cam).frustum, ex - 0.6 - bw * 0.5, ey, ez - 0.6 - bw * 0.5, ex + 0.6 + bw * 0.5, ey + 2.0 + bh, ez + 0.6 + bw * 0.5) == 0 {
            (*l).n_culled = (*l).n_culled + 1 as u32
            continue
        }
        var lod: bool = false
        if far_lod > 0.0 && d2 > far_lod * far_lod {
            lod = true
            (*l).n_lod = (*l).n_lod + 1 as u32
        }
        (*l).tint_k = 0
        if (*l).hurt != 0 as u64 { (*l).tint_k = mc_hurt_tint.hurt_strength_permille((*l).hurt as *mut mc_hurt_tint.HurtTable, (*e).id, (*l).now_ms) }
        if (*l).tint_k > 0 { (*l).n_tinted = (*l).n_tinted + 1 as u32 }
        if !lod && try_skinned(l, e, reg, ex, ey, ez, eyaw, (*e).rpitch) {
        } else if bw > 0.0 && bh > 0.0 {
            entlist_add_sized(l, ex, ey, ez, eyaw, ((*e).id as u64) + 1 as u64, bw, bh)
        } else {
            entlist_add_model(l, ex, ey, ez, eyaw, ((*e).id as u64) + 1 as u64, (*e).kind != mc_entity.KIND_OBJECT, lod)
        }
        (*l).tint_k = 0
    }
}

// Hands the list to the back end (b.draw_entities); returns the boxes drawn (0 on a back end without entity support).
fn entlist_draw(l: *mut EntList, b: *mut mc_backend.Backend) -> u64 {
    if (*l).skin_dirty {
        (*b).upload_skin((*b).ent_obj, (*l).skin_px, 10)
        (*l).skin_dirty = false
    }
    let ns: usize = entlist_skinned(l)
    if ns > 0 { (*b).draw_skinned((*b).ent_obj, rt.buf_ptr(&(*l).sk), ns) }
    let n: usize = entlist_boxes(l)
    if n == 0 { return 0 as u64 }
    return (*b).draw_entities((*b).ent_obj, rt.buf_ptr(&(*l).buf), n)
}
