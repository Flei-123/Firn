import std.rt
import mc.mc_tip_lines
import mc.mc_item_names
import mc.mc_item_regs
import mc.mc_name_match
import mc.mc_tip_util
import mc.mc_tip_attr

export { potion_tip, potion_item_key, potion_is_item }

const TAG_POTION: u8 = 112
const TAG_POTION_NAME: u8 = 113
const TAG_EFFECT: u8 = 102
const C_GRAY: i32 = 0xAAAAAA
const C_BLUE: i32 = 0x5555FF
const C_RED: i32 = 0xFF5555
const C_PURPLE: i32 = 0xAA00AA
const MAX_FX: usize = 16
const ROMAN: str = "I II III IV V VI VII VIII IX X"

const BASE_FX: str = "night_vision night_vision 0 3600;long_night_vision night_vision 0 9600;invisibility invisibility 0 3600;long_invisibility invisibility 0 9600;leaping jump_boost 0 3600;long_leaping jump_boost 0 9600;strong_leaping jump_boost 1 1800;fire_resistance fire_resistance 0 3600;long_fire_resistance fire_resistance 0 9600;swiftness speed 0 3600;long_swiftness speed 0 9600;strong_swiftness speed 1 1800;slowness slowness 0 1800;long_slowness slowness 0 4800;strong_slowness slowness 3 400;turtle_master slowness 3 400;turtle_master resistance 2 400;long_turtle_master slowness 3 800;long_turtle_master resistance 2 800;strong_turtle_master slowness 5 400;strong_turtle_master resistance 3 400;water_breathing water_breathing 0 3600;long_water_breathing water_breathing 0 9600;healing instant_health 0 1;strong_healing instant_health 1 1;harming instant_damage 0 1;strong_harming instant_damage 1 1;poison poison 0 900;long_poison poison 0 1800;strong_poison poison 1 432;regeneration regeneration 0 900;long_regeneration regeneration 0 1800;strong_regeneration regeneration 1 450;strength strength 0 3600;long_strength strength 0 9600;strong_strength strength 1 1800;weakness weakness 0 1800;long_weakness weakness 0 4800;luck luck 0 6000;slow_falling slow_falling 0 1800;long_slow_falling slow_falling 0 4800;wind_charged wind_charged 0 3600;weaving weaving 0 3600;oozing oozing 0 3600;infested infested 0 3600"
const EFFECT_ATTR: str = "speed movement_speed 2 20;slowness movement_speed 2 -15;haste attack_speed 2 10;mining_fatigue attack_speed 2 -10;strength attack_damage 0 300;weakness attack_damage 0 -400;health_boost max_health 0 400;absorption max_absorption 0 400;luck luck 0 100;unluck luck 0 -100"

struct Fx {
    name_p: u64,
    name_n: usize,
    amp: i64,
    dur: i64,
}

fn potion_is_item(p: u64, n: usize) -> bool {
    return mc_name_match.nm_is(p, n, "potion") || mc_name_match.nm_is(p, n, "splash_potion") || mc_name_match.nm_is(p, n, "lingering_potion") || mc_name_match.nm_is(p, n, "tipped_arrow")
}

fn word_is(wp: u64, wn: usize, lit: str) -> bool {
    return wn == lit.n && rt.mem_eq(wp, lit.p as u64, lit.n)
}

fn base_potion_name(rp: u64, rn: usize, out_p: *mut u64, out_n: *mut usize) -> bool {
    var vp: u64 = 0
    var vn: usize = 0
    if mc_tip_util.find_tag(rp, rn, TAG_POTION, &vp, &vn) {
        var ok: bool = false
        let id: i64 = mc_tip_util.parse_num(vp, vn, &ok)
        if ok { return mc_item_regs.potion_name(id, out_p, out_n) }
        return false
    }
    if mc_tip_util.find_tag(rp, rn, TAG_POTION_NAME, &vp, &vn) {
        mc_tip_util.bare(vp, vn, out_p, out_n)
        return *out_n > 0
    }
    return false
}

fn potion_item_key(item_p: u64, item_n: usize, rp: u64, rn: usize, out: *mut rt.Buf) {
    rt.buf_push_bytes(out, "item.minecraft.".p as u64, 15)
    rt.buf_push_bytes(out, item_p, item_n)
    rt.buf_push_bytes(out, ".effect.".p as u64, 8)
    var np: u64 = 0
    var nn: usize = 0
    if base_potion_name(rp, rn, &np, &nn) {
        rt.buf_push_bytes(out, np, nn)
    } else {
        rt.buf_push_bytes(out, "empty".p as u64, 5)
    }
}

fn fx_push(fx: u64, count: *mut usize, name_p: u64, name_n: usize, amp: i64, dur: i64) {
    if *count >= MAX_FX { return }
    let f: *mut Fx = (fx + ((*count * 32) as u64)) as *mut Fx
    (*f).name_p = name_p
    (*f).name_n = name_n
    (*f).amp = amp
    (*f).dur = dur
    *count = *count + 1
}

fn collect_base(fx: u64, count: *mut usize, rp: u64, rn: usize) {
    var pp: u64 = 0
    var pn: usize = 0
    if !base_potion_name(rp, rn, &pp, &pn) { return }
    var r: i32 = 0
    var row_p: u64 = 0
    var row_n: usize = 0
    while mc_tip_util.nth_word(BASE_FX.p as u64, BASE_FX.n, r, 59 as u8, &row_p, &row_n) {
        var wp: u64 = 0
        var wn: usize = 0
        if mc_tip_util.nth_word(row_p, row_n, 0, 32 as u8, &wp, &wn) && wn == pn && rt.mem_eq(wp, pp, pn) {
            var ep: u64 = 0
            var en: usize = 0
            var ap: u64 = 0
            var an: usize = 0
            var dp: u64 = 0
            var dn: usize = 0
            mc_tip_util.nth_word(row_p, row_n, 1, 32 as u8, &ep, &en)
            mc_tip_util.nth_word(row_p, row_n, 2, 32 as u8, &ap, &an)
            mc_tip_util.nth_word(row_p, row_n, 3, 32 as u8, &dp, &dn)
            var ok: bool = false
            let amp: i64 = mc_tip_util.parse_num(ap, an, &ok)
            let dur: i64 = mc_tip_util.parse_num(dp, dn, &ok)
            fx_push(fx, count, ep, en, amp, dur)
        }
        r = r + 1
    }
}

fn collect_custom(fx: u64, count: *mut usize, rp: u64, rn: usize) {
    var pos: usize = 0
    var tag: u8 = 0 as u8
    var lp: u64 = 0
    var ln: usize = 0
    while mc_tip_util.next_line(rp, rn, &pos, &tag, &lp, &ln) {
        if tag != TAG_EFFECT { continue }
        var ip: u64 = 0
        var inn: usize = 0
        var ap: u64 = 0
        var an: usize = 0
        var dp: u64 = 0
        var dn: usize = 0
        var at: usize = mc_tip_util.split_tab(lp, ln, 0, &ip, &inn)
        at = mc_tip_util.split_tab(lp, ln, at, &ap, &an)
        mc_tip_util.split_tab(lp, ln, at, &dp, &dn)
        var ok: bool = false
        let id: i64 = mc_tip_util.parse_num(ip, inn, &ok)
        if !ok { continue }
        let amp: i64 = mc_tip_util.parse_num(ap, an, &ok)
        let dur: i64 = mc_tip_util.parse_num(dp, dn, &ok)
        var np: u64 = 0
        var nn: usize = 0
        if mc_item_regs.effect_name(id, &np, &nn) { fx_push(fx, count, np, nn, amp, dur) }
    }
}

fn put_duration(out: *mut rt.Buf, ticks: i64) {
    var secs: i64 = ticks / 20
    var mins: i64 = secs / 60
    secs = secs % 60
    let hours: i64 = mins / 60
    mins = mins % 60
    if hours > 0 {
        rt.buf_push_dec_i64(out, hours)
        rt.buf_push(out, 58 as u8)
        rt.buf_push(out, (48 + mins / 10) as u8)
        rt.buf_push(out, (48 + mins % 10) as u8)
    } else {
        rt.buf_push_dec_i64(out, mins)
    }
    rt.buf_push(out, 58 as u8)
    rt.buf_push(out, (48 + secs / 10) as u8)
    rt.buf_push(out, (48 + secs % 10) as u8)
}

fn effect_title(f: *mut Fx, out: *mut rt.Buf) {
    var key: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&key, "effect.minecraft.".p as u64, 17)
    rt.buf_push_bytes(&key, (*f).name_p, (*f).name_n)
    var base: rt.Buf = rt.buf_new()
    if !mc_item_names.names_find(rt.buf_ptr(&key), rt.buf_len(&key), &base) { mc_item_names.names_title((*f).name_p, (*f).name_n, &base) }
    rt.buf_free(&key)
    if (*f).amp <= 0 {
        rt.buf_push_bytes(out, rt.buf_ptr(&base), rt.buf_len(&base))
        rt.buf_free(&base)
        return
    }
    var pot: rt.Buf = rt.buf_new()
    var pk: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&pk, "potion.potency.".p as u64, 15)
    rt.buf_push_dec_i64(&pk, (*f).amp)
    if !mc_item_names.names_find(rt.buf_ptr(&pk), rt.buf_len(&pk), &pot) {
        var wp: u64 = 0
        var wn: usize = 0
        if (*f).amp < 10 && mc_tip_util.nth_word(ROMAN.p as u64, ROMAN.n, ((*f).amp) as i32, 32 as u8, &wp, &wn) {
            rt.buf_push_bytes(&pot, wp, wn)
        } else {
            rt.buf_push_dec_i64(&pot, (*f).amp + 1)
        }
    }
    mc_tip_util.lang_fmt("potion.withAmplifier", "%s %s", rt.buf_ptr(&base), rt.buf_len(&base), rt.buf_ptr(&pot), rt.buf_len(&pot), out)
    rt.buf_free(&base)
    rt.buf_free(&pot)
    rt.buf_free(&pk)
}

fn add_effect_line(t: *mut mc_tip_lines.TipLines, f: *mut Fx, scale_div: i64) {
    var title: rt.Buf = rt.buf_new()
    effect_title(f, &title)
    var line: rt.Buf = rt.buf_new()
    var dur: i64 = (*f).dur
    if dur > 0 && scale_div > 1 { dur = dur / scale_div }
    if mc_item_regs.effect_instant((*f).name_p, (*f).name_n) || (dur >= 0 && dur <= 20) {
        rt.buf_push_bytes(&line, rt.buf_ptr(&title), rt.buf_len(&title))
    } else {
        var d: rt.Buf = rt.buf_new()
        if dur < 0 {
            if !mc_item_names.names_find("effect.duration.infinite".p as u64, 24, &d) { rt.buf_push_bytes(&d, "infinite".p as u64, 8) }
        } else {
            put_duration(&d, dur)
        }
        mc_tip_util.lang_fmt("potion.withDuration", "%s (%s)", rt.buf_ptr(&title), rt.buf_len(&title), rt.buf_ptr(&d), rt.buf_len(&d), &line)
        rt.buf_free(&d)
    }
    var rgb: i32 = C_BLUE
    if mc_item_regs.effect_harmful((*f).name_p, (*f).name_n) { rgb = C_RED }
    mc_tip_lines.tl_add_plain(t, rgb, 0 as u32, rt.buf_ptr(&line), rt.buf_len(&line))
    rt.buf_free(&title)
    rt.buf_free(&line)
}

fn add_applied(t: *mut mc_tip_lines.TipLines, fx: u64, count: usize) {
    var started: bool = false
    var i: usize = 0
    while i < count {
        let f: *mut Fx = (fx + ((i * 32) as u64)) as *mut Fx
        var r: i32 = 0
        var row_p: u64 = 0
        var row_n: usize = 0
        while mc_tip_util.nth_word(EFFECT_ATTR.p as u64, EFFECT_ATTR.n, r, 59 as u8, &row_p, &row_n) {
            var wp: u64 = 0
            var wn: usize = 0
            if mc_tip_util.nth_word(row_p, row_n, 0, 32 as u8, &wp, &wn) && wn == (*f).name_n && rt.mem_eq(wp, (*f).name_p, wn) {
                var ap: u64 = 0
                var an: usize = 0
                var op: u64 = 0
                var on: usize = 0
                var vp: u64 = 0
                var vn: usize = 0
                mc_tip_util.nth_word(row_p, row_n, 1, 32 as u8, &ap, &an)
                mc_tip_util.nth_word(row_p, row_n, 2, 32 as u8, &op, &on)
                mc_tip_util.nth_word(row_p, row_n, 3, 32 as u8, &vp, &vn)
                var ok: bool = false
                let opv: i64 = mc_tip_util.parse_num(op, on, &ok)
                let per: i64 = mc_tip_util.parse_num(vp, vn, &ok)
                if !started {
                    started = true
                    mc_tip_attr.attr_header(t, "potion.whenDrank".p as u64, 16, "When Applied:", C_PURPLE)
                }
                mc_tip_attr.attr_line(t, ap, an, per * ((*f).amp + 1), opv, false)
            }
            r = r + 1
        }
        i = i + 1
    }
}

fn potion_tip(t: *mut mc_tip_lines.TipLines, rp: u64, rn: usize, item_p: u64, item_n: usize) {
    let fx: u64 = rt.heap_alloc(MAX_FX * 32)
    var count: usize = 0
    collect_base(fx, &count, rp, rn)
    collect_custom(fx, &count, rp, rn)
    var scale_div: i64 = 1
    if mc_name_match.nm_is(item_p, item_n, "tipped_arrow") { scale_div = 8 }
    if mc_name_match.nm_is(item_p, item_n, "lingering_potion") { scale_div = 4 }
    if count == 0 {
        var e: rt.Buf = rt.buf_new()
        if !mc_item_names.names_find("effect.none".p as u64, 11, &e) { rt.buf_push_bytes(&e, "No Effects".p as u64, 10) }
        mc_tip_lines.tl_add_plain(t, C_GRAY, 0 as u32, rt.buf_ptr(&e), rt.buf_len(&e))
        rt.buf_free(&e)
        rt.heap_free(fx, MAX_FX * 32)
        return
    }
    var i: usize = 0
    while i < count {
        add_effect_line(t, (fx + ((i * 32) as u64)) as *mut Fx, scale_div)
        i = i + 1
    }
    add_applied(t, fx, count)
    rt.heap_free(fx, MAX_FX * 32)
}
