import std.rt
import std.math
import mc.mc_raster
import mc.mc_hud
import mc.mc_world
import mc.mc_registry
import mc.mc_precip

export { DebugInfo, dbg_new, dbg_lines, dbg_draw, dbg_facing }

const LEFT_MAX: i32 = 10
const BG: u32 = 0x90505050
const FG: u32 = 0xFFE0E0E0
const SHADOW: u32 = 0xFF3F3F3F

struct DebugInfo {
    protocol: i32,
    fps: i32,
    x: f64,
    y: f64,
    z: f64,
    yaw: f64,
    pitch: f64,
    min_y: i32,
    has_block: bool,
    bx: i32,
    by: i32,
    bz: i32,
    state: i32,
}

fn dbg_new() -> DebugInfo {
    return DebugInfo { protocol: 0, fps: 0, x: 0.0, y: 0.0, z: 0.0, yaw: 0.0, pitch: 0.0, min_y: 0, has_block: false, bx: 0, by: 0, bz: 0, state: 0 }
}

fn lit(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn num(b: *mut rt.Buf, v: i32) {
    rt.buf_push_dec_i64(b, v as i64)
}

fn floor_i(v: f64) -> i32 {
    return math.floor(v) as i32
}

fn dbg_facing(yaw: f64) -> i32 {
    var y: f64 = yaw - 360.0 * math.floor((yaw + 180.0) / 360.0)
    if y >= 0.0 - 45.0 && y < 45.0 { return 0 }
    if y >= 45.0 && y < 135.0 { return 1 }
    if y >= 0.0 - 135.0 && y < 0.0 - 45.0 { return 3 }
    return 2
}

fn push_facing(b: *mut rt.Buf, yaw: f64, pitch: f64) {
    let f: i32 = dbg_facing(yaw)
    lit(b, "Facing: ")
    if f == 0 { lit(b, "south (Towards positive Z)") }
    if f == 1 { lit(b, "west (Towards negative X)") }
    if f == 2 { lit(b, "north (Towards negative Z)") }
    if f == 3 { lit(b, "east (Towards positive X)") }
    lit(b, " (")
    mc_hud.hud_push_fixed(b, yaw, 1)
    lit(b, " / ")
    mc_hud.hud_push_fixed(b, pitch, 1)
    rt.buf_push(b, 41 as u8)
}

fn push_biome(b: *mut rt.Buf, d: *mut DebugInfo, w: *mut mc_world.World, reg: *mut mc_registry.Registry) {
    lit(b, "Biome: ")
    let bi: i32 = mc_precip.precip_biome_at(w, (*d).min_y, floor_i((*d).x), floor_i((*d).y), floor_i((*d).z))
    if bi < 0 {
        rt.buf_push(b, 45 as u8)
        return
    }
    var n: usize = 0
    let p: u64 = mc_registry.reg_biome_name(reg, bi, &n)
    lit(b, "minecraft:")
    rt.buf_push_bytes(b, p, n)
}

fn dbg_lines(d: *mut DebugInfo, w: *mut mc_world.World, reg: *mut mc_registry.Registry, k: i32, b: *mut rt.Buf) {
    let bx: i32 = floor_i((*d).x)
    let by: i32 = floor_i((*d).y)
    let bz: i32 = floor_i((*d).z)
    if k == 0 {
        lit(b, "mcplay (protocol ")
        num(b, (*d).protocol)
        rt.buf_push(b, 41 as u8)
    } else if k == 1 {
        num(b, (*d).fps)
        lit(b, " fps")
    } else if k == 3 {
        lit(b, "XYZ: ")
        mc_hud.hud_push_fixed(b, (*d).x, 3)
        lit(b, " / ")
        mc_hud.hud_push_fixed(b, (*d).y, 3)
        lit(b, " / ")
        mc_hud.hud_push_fixed(b, (*d).z, 3)
    } else if k == 4 {
        lit(b, "Block: ")
        num(b, bx)
        rt.buf_push(b, 32 as u8)
        num(b, by)
        rt.buf_push(b, 32 as u8)
        num(b, bz)
    } else if k == 5 {
        lit(b, "Chunk: ")
        num(b, mc_world.block_in_chunk(bx))
        rt.buf_push(b, 32 as u8)
        num(b, mc_world.block_in_chunk(by))
        rt.buf_push(b, 32 as u8)
        num(b, mc_world.block_in_chunk(bz))
        lit(b, " in ")
        num(b, mc_world.block_to_chunk(bx))
        rt.buf_push(b, 32 as u8)
        num(b, mc_world.floor_div(by, 16))
        rt.buf_push(b, 32 as u8)
        num(b, mc_world.block_to_chunk(bz))
    } else if k == 6 {
        push_facing(b, (*d).yaw, (*d).pitch)
    } else if k == 7 {
        push_biome(b, d, w, reg)
    }
}

fn target_line(d: *mut DebugInfo, reg: *mut mc_registry.Registry, k: i32, b: *mut rt.Buf) {
    if k == 0 {
        lit(b, "Targeted Block: ")
        num(b, (*d).bx)
        lit(b, ", ")
        num(b, (*d).by)
        lit(b, ", ")
        num(b, (*d).bz)
    } else {
        let blk: i32 = mc_registry.reg_block_of_state(reg, (*d).state)
        if blk < 0 { return }
        var n: usize = 0
        let p: u64 = mc_registry.reg_block_name(reg, blk, &n)
        lit(b, "minecraft:")
        rt.buf_push_bytes(b, p, n)
    }
}

fn strip(r: *mut mc_raster.Raster, s: i32, x: i32, y: i32, b: *mut rt.Buf, right: bool) {
    let n: usize = rt.buf_len(b)
    if n == 0 { return }
    let tw: i32 = mc_hud.hud_text_width(n, s)
    var px: i32 = x
    if right { px = (*r).w - x - tw }
    mc_hud.hud_rect(r, px - s, y - s, tw + 2 * s, 9 * s, BG)
    mc_hud.hud_text_bytes(r, px, y, s, FG, SHADOW, rt.buf_ptr(b), n)
}

fn dbg_draw(r: *mut mc_raster.Raster, s: i32, d: *mut DebugInfo, w: *mut mc_world.World, reg: *mut mc_registry.Registry) {
    var b: rt.Buf = rt.buf_new()
    var k: i32 = 0
    while k < LEFT_MAX {
        rt.buf_clear(&b)
        dbg_lines(d, w, reg, k, &b)
        strip(r, s, 2 * s, 2 * s + k * 10 * s, &b, false)
        k = k + 1
    }
    if (*d).has_block {
        k = 0
        while k < 2 {
            rt.buf_clear(&b)
            target_line(d, reg, k, &b)
            strip(r, s, 2 * s, 2 * s + (k + 3) * 10 * s, &b, true)
            k = k + 1
        }
    }
    rt.buf_free(&b)
}
