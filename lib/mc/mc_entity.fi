// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_entity.fi -- entity tracking: the store of every entity the server told us about.
//
// Fed with the raw bodies of the play packets (spawn object / living / player, teleport,
// relative move, look, entity position sync, velocity, destroy, player info / remove). The
// field layout of each packet is NOT written here: tools/mcgen/gen_entity.py generates it per
// protocol version from minecraft-data (lib/mc/mc_entity_layout.fi, token format in the
// generator header), the wire ids come from the Version object (mc_sem.SEM_PLAY_S2C_*). A new
// game version is therefore data only. Player names come from the player info packets, which
// are decoded by the generic schema walker (mc_schema.walk_values), also per version.
//
//   Store, store_new() / store_free(&s)
//   entity_on_packet(&s, &ver, id, &body) -> bool    true when `id` is an entity packet
//   store_get(&s, id) -> *mut Entity | 0             store_count(&s)    store_player_count(&s)
//   store_player_name(&s, hi, lo, &n) -> ptr | 0     entity_dump(&s, &out)   canonical text
//
// Units: x y z in blocks (f64; 1.8 fixed point /32 and 1.9+ deltas /4096 are converted),
// yaw / pitch in degrees (angle byte * 360 / 256, or the f32 of 1.21.2+). The unit conversion
// belongs to the layout type: i32 position -> /32, i8 delta -> /32, i16 delta -> /4096.
//
// Hostile input: every read is bounds checked, a truncated or over long packet changes
// NOTHING (all values are read first, then applied), counts are bounded by the octets left,
// the store holds at most MAX_ENTITIES / MAX_PLAYERS records (more are dropped and counted).
// A varint entity id of -2^31 is treated as a read failure (sentinel).

import std.rt
import std.bytes
import std.math
import std.io
import mc.mc_sem
import mc.mc_version
import mc.mc_schema
import mc.mc_entity_layout

export {
    Store, Entity, store_new, store_free, store_get, store_count, store_player_count,
    store_player_name, store_slot_cap, store_at, entity_on_packet, entity_dump, store_clear, store_interp, angle_delta,
    KIND_OBJECT, KIND_LIVING, KIND_PLAYER, MAX_ENTITIES, MAX_PLAYERS, NAME_MAX,
}

const KIND_OBJECT: i32 = 0
const KIND_LIVING: i32 = 1
const KIND_PLAYER: i32 = 2
const MAX_ENTITIES: usize = 1048576
const MAX_PLAYERS: usize = 65536
const NAME_MAX: usize = 32
const BAD: i32 = 0 - 2147483647 - 1

// records start with two key words so one table type serves both
struct Entity {
    k0: u64, // entity id (as u64)
    k1: u64, // 0
    id: i32,
    kind: i32,
    type_id: i32,
    has_uuid: bool,
    on_ground: bool,
    uuid_hi: u64,
    uuid_lo: u64,
    x: f64,
    y: f64,
    z: f64,
    yaw: f64,
    pitch: f64,
    vx: i32,
    vy: i32,
    vz: i32,
    name_len: usize,
    name: [u8; 32],
    // render state (store_interp): smoothed position / yaw / pitch that follow x y z yaw pitch; rinit = false until the first call (snap)
    rx: f64,
    ry: f64,
    rz: f64,
    ryaw: f64,
    rpitch: f64,
    rinit: bool,
}

struct Player {
    k0: u64, // uuid high
    k1: u64, // uuid low
    name_len: usize,
    name: [u8; 32],
}

struct Tab {
    slots: u64, // array of u64: 0 empty, 1 deleted, else a record pointer
    cap: usize,
    used: usize,
    tomb: usize,
}

struct Store {
    ents: Tab,
    plrs: Tab,
    spawns: u64,
    teleports: u64,
    moves: u64,
    looks: u64,
    destroys: u64,
    velocities: u64,
    infos: u64,
    misses: u64, // move / look / teleport for an unknown entity
    bad: u64, // entity packets that did not parse (nothing applied)
    dropped: u64, // spawns refused because the store is full
}

// ------------------------------------------------------------------ open addressing table

fn tab_new() -> Tab {
    return Tab { slots: 0, cap: 0, used: 0, tomb: 0 }
}

fn hash2(k0: u64, k1: u64) -> u64 {
    var h: u64 = (k0 *% 11400714819323198485) ^ (k1 *% 14029467366897019727)
    h = h ^ (h >> 29)
    h = h *% 13787848793156543929
    return h ^ (h >> 32)
}

fn tab_find(t: *mut Tab, k0: u64, k1: u64) -> u64 {
    if (*t).cap == 0 {
        return 0
    }
    let mask: usize = (*t).cap - 1
    var i: usize = (hash2(k0, k1) as usize) & mask
    var n: usize = 0
    while n < (*t).cap {
        let r: u64 = rt.ld64((*t).slots, i)
        if r == 0 as u64 {
            return 0
        }
        if r != 1 as u64 {
            if rt.ld64(r, 0) == k0 && rt.ld64(r, 1) == k1 {
                return r
            }
        }
        i = (i + 1) & mask
        n = n + 1
    }
    return 0
}

fn tab_raw_put(slots: u64, cap: usize, rec: u64) {
    let mask: usize = cap - 1
    var i: usize = (hash2(rt.ld64(rec, 0), rt.ld64(rec, 1)) as usize) & mask
    while rt.ld64(slots, i) != 0 as u64 {
        i = (i + 1) & mask
    }
    rt.st64(slots, i, rec)
}

fn tab_rebuild(t: *mut Tab, ncap: usize) -> bool {
    let ns: u64 = rt.heap_alloc(ncap * 8)
    if ns == 0 as u64 {
        return false
    }
    rt.mem_set(ns, 0 as u8, ncap * 8)
    var i: usize = 0
    while i < (*t).cap {
        let r: u64 = rt.ld64((*t).slots, i)
        if r > 1 as u64 {
            tab_raw_put(ns, ncap, r)
        }
        i = i + 1
    }
    if (*t).slots != 0 as u64 {
        rt.heap_free((*t).slots, (*t).cap * 8)
    }
    (*t).slots = ns
    (*t).cap = ncap
    (*t).tomb = 0
    return true
}

// inserts a record whose key is NOT in the table; false when out of memory
fn tab_insert(t: *mut Tab, rec: u64) -> bool {
    if ((*t).used + (*t).tomb + 1) * 2 > (*t).cap {
        var ncap: usize = 64
        if (*t).cap != 0 {
            ncap = (*t).cap
            if ((*t).used + 1) * 4 > (*t).cap {
                ncap = (*t).cap * 2
            }
        }
        if !tab_rebuild(t, ncap) {
            return false
        }
    }
    tab_raw_put((*t).slots, (*t).cap, rec)
    (*t).used = (*t).used + 1
    return true
}

// removes the record with the key and returns it (the caller frees it), 0 when absent
fn tab_remove(t: *mut Tab, k0: u64, k1: u64) -> u64 {
    if (*t).cap == 0 {
        return 0
    }
    let mask: usize = (*t).cap - 1
    var i: usize = (hash2(k0, k1) as usize) & mask
    var n: usize = 0
    while n < (*t).cap {
        let r: u64 = rt.ld64((*t).slots, i)
        if r == 0 as u64 {
            return 0
        }
        if r != 1 as u64 {
            if rt.ld64(r, 0) == k0 && rt.ld64(r, 1) == k1 {
                rt.st64((*t).slots, i, 1 as u64)
                (*t).used = (*t).used - 1
                (*t).tomb = (*t).tomb + 1
                return r
            }
        }
        i = (i + 1) & mask
        n = n + 1
    }
    return 0
}

// ------------------------------------------------------------------------------ the store

fn store_new() -> Store {
    return Store {
        ents: tab_new(), plrs: tab_new(), spawns: 0, teleports: 0, moves: 0, looks: 0,
        destroys: 0, velocities: 0, infos: 0, misses: 0, bad: 0, dropped: 0,
    }
}

fn ent_size() -> usize {
    var a: [Entity; 2] = [ent_empty(); 2]
    return ((&a[1]) as u64 - (&a[0]) as u64) as usize
}

fn plr_size() -> usize {
    var a: [Player; 2] = [Player { k0: 0, k1: 0, name_len: 0, name: [0 as u8; 32] }; 2]
    return ((&a[1]) as u64 - (&a[0]) as u64) as usize
}

fn ent_empty() -> Entity {
    return Entity {
        k0: 0, k1: 0, id: 0, kind: 0, type_id: 0 - 1, has_uuid: false, on_ground: false, uuid_hi: 0,
        uuid_lo: 0, x: 0.0, y: 0.0, z: 0.0, yaw: 0.0, pitch: 0.0, vx: 0, vy: 0, vz: 0, name_len: 0,
        name: [0 as u8; 32], rx: 0.0, ry: 0.0, rz: 0.0, ryaw: 0.0, rpitch: 0.0, rinit: false,
    }
}

fn free_tab(t: *mut Tab, size: usize) {
    var i: usize = 0
    while i < (*t).cap {
        let r: u64 = rt.ld64((*t).slots, i)
        if r > 1 as u64 {
            rt.heap_free(r, size)
        }
        i = i + 1
    }
    if (*t).slots != 0 as u64 {
        rt.heap_free((*t).slots, (*t).cap * 8)
    }
    (*t).slots = 0
    (*t).cap = 0
    (*t).used = 0
    (*t).tomb = 0
}

// forget everything (respawn / dimension change / reconnect); the counters stay
fn store_clear(s: *mut Store) {
    free_tab(&(*s).ents, ent_size())
}

fn store_free(s: *mut Store) {
    free_tab(&(*s).ents, ent_size())
    free_tab(&(*s).plrs, plr_size())
}

fn store_count(s: *mut Store) -> usize { return (*s).ents.used }
fn store_player_count(s: *mut Store) -> usize { return (*s).plrs.used }

// Iteration: slots 0 .. store_slot_cap-1; store_at returns the entity in slot i or 0 (empty / deleted slot).
fn store_slot_cap(s: *mut Store) -> usize { return (*s).ents.cap }

fn store_at(s: *mut Store, i: usize) -> *mut Entity {
    if i >= (*s).ents.cap { return 0 as u64 as *mut Entity }
    let r: u64 = rt.ld64((*s).ents.slots, i)
    if r <= 1 as u64 { return 0 as u64 as *mut Entity }
    return r as *mut Entity
}

fn store_get(s: *mut Store, id: i32) -> *mut Entity {
    return tab_find(&(*s).ents, (id as i64) as u64, 0 as u64) as *mut Entity
}

// the name of the player with this UUID: pointer to the octets (n = length), 0 when unknown
fn store_player_name(s: *mut Store, hi: u64, lo: u64, n: *mut usize) -> u64 {
    let p: u64 = tab_find(&(*s).plrs, hi, lo)
    if p == 0 as u64 {
        *n = 0
        return 0
    }
    *n = (*(p as *mut Player)).name_len
    return (&(*(p as *mut Player)).name[0]) as u64
}

fn plr_put(s: *mut Store, hi: u64, lo: u64, name: u64, n: usize) {
    var p: u64 = tab_find(&(*s).plrs, hi, lo)
    if p == 0 as u64 {
        if (*s).plrs.used >= MAX_PLAYERS {
            (*s).dropped = (*s).dropped + 1 as u64
            return
        }
        p = rt.heap_alloc(plr_size())
        if p == 0 as u64 {
            return
        }
        *(p as *mut Player) = Player { k0: hi, k1: lo, name_len: 0, name: [0 as u8; 32] }
        if !tab_insert(&(*s).plrs, p) {
            rt.heap_free(p, plr_size())
            return
        }
    }
    var m: usize = n
    if m > NAME_MAX {
        m = NAME_MAX
    }
    var i: usize = 0
    while i < m {
        (*(p as *mut Player)).name[i] = rt.ld8(name, i)
        i = i + 1
    }
    (*(p as *mut Player)).name_len = m
}

fn plr_del(s: *mut Store, hi: u64, lo: u64) {
    let p: u64 = tab_remove(&(*s).plrs, hi, lo)
    if p != 0 as u64 {
        rt.heap_free(p, plr_size())
    }
}

// --------------------------------------------------------------------- layout interpreter

struct Fields {
    id: i32,
    uuid_hi: u64,
    uuid_lo: u64,
    type_id: i32,
    x: f64,
    y: f64,
    z: f64,
    yaw: f64,
    pitch: f64,
    on_ground: bool,
    vx: i32,
    vy: i32,
    vz: i32,
    has_id: bool,
    has_uuid: bool,
    has_type: bool,
    has_pos: bool, // absolute
    has_rel: bool, // relative
    has_yaw: bool,
    has_pitch: bool,
    has_ground: bool,
    has_vel: bool,
}

fn fields_empty() -> Fields {
    return Fields {
        id: 0, uuid_hi: 0, uuid_lo: 0, type_id: 0 - 1, x: 0.0, y: 0.0, z: 0.0, yaw: 0.0, pitch: 0.0,
        on_ground: false, vx: 0, vy: 0, vz: 0, has_id: false, has_uuid: false, has_type: false,
        has_pos: false, has_rel: false, has_yaw: false, has_pitch: false, has_ground: false,
        has_vel: false,
    }
}

// one scalar of a layout type character: integers in `iv`, floats in `fv`
fn rd_scalar(b: *mut bytes.Bytes, ty: u8, iv: *mut i64, fv: *mut f64) -> bool {
    let left: usize = bytes.bytes_remaining(b)
    if ty == 118 as u8 { // v varint
        if left < 1 {
            return false
        }
        let v: i32 = bytes.get_varint(b) catch BAD
        *iv = v as i64
        return v != BAD
    }
    if ty == 98 as u8 || ty == 66 as u8 || ty == 111 as u8 { // b i8, B u8, o bool
        if left < 1 {
            return false
        }
        if ty == 98 as u8 {
            *iv = (bytes.get_i8(b) catch 0) as i64
        } else {
            *iv = (bytes.get_u8(b) catch 0) as i64
        }
        return true
    }
    if ty == 115 as u8 { // s i16
        if left < 2 {
            return false
        }
        *iv = (bytes.get_i16(b) catch 0) as i64
        return true
    }
    if ty == 105 as u8 { // i i32
        if left < 4 {
            return false
        }
        *iv = (bytes.get_i32(b) catch 0) as i64
        return true
    }
    if ty == 100 as u8 { // d f64
        if left < 8 {
            return false
        }
        *fv = bytes.get_f64(b) catch 0.0
        return true
    }
    if ty == 102 as u8 { // f f32
        if left < 4 {
            return false
        }
        let f: f32 = bytes.get_f32(b) catch 0.0
        *fv = f as f64
        return true
    }
    return false
}

fn skip_n(b: *mut bytes.Bytes, n: usize) -> bool {
    if bytes.bytes_remaining(b) < n {
        return false
    }
    // bytes_skip returns the NEW cursor position (not the count); an error leaves the cursor in place
    let p0: usize = bytes.bytes_pos(b)
    let p1: usize = bytes.bytes_skip(b, n) catch p0
    return p1 == p0 + n
}

// lpVec3: u8 lowest; 0 -> that is all, else 5 more octets and a varint when bit 2 of `lowest` is set
fn skip_lpvec3(b: *mut bytes.Bytes) -> bool {
    if bytes.bytes_remaining(b) < 1 {
        return false
    }
    let lo: u8 = bytes.get_u8(b) catch 0
    if lo == 0 as u8 {
        return true
    }
    if !skip_n(b, 5) {
        return false
    }
    if (lo & 4 as u8) != 0 as u8 {
        let v: i32 = bytes.get_varint(b) catch BAD
        return v != BAD
    }
    return true
}

// reads the prefix of the packet body described by `prog`; false on any short / bad read
fn parse_layout(prog: str, b: *mut bytes.Bytes, f: *mut Fields) -> bool {
    let n: usize = prog.n / 2
    var i: usize = 0
    while i < n {
        let role: u8 = rt.ld8(prog.p as u64, i * 2)
        let ty: u8 = rt.ld8(prog.p as u64, i * 2 + 1)
        var iv: i64 = 0
        var fv: f64 = 0.0
        if ty == 117 as u8 { // u uuid
            if bytes.bytes_remaining(b) < 16 {
                return false
            }
            var hi: u64 = 0
            var lo: u64 = 0
            let ok: bool = bytes.get_uuid(b, &hi, &lo) catch false
            if !ok {
                return false
            }
            if role == 85 as u8 { // U
                (*f).uuid_hi = hi
                (*f).uuid_lo = lo
                (*f).has_uuid = true
            }
        } else if ty == 86 as u8 { // V vec3i16
            if bytes.bytes_remaining(b) < 6 {
                return false
            }
            let a: i16 = bytes.get_i16(b) catch 0
            let c: i16 = bytes.get_i16(b) catch 0
            let d: i16 = bytes.get_i16(b) catch 0
            if role == 77 as u8 { // M
                (*f).vx = a as i32
                (*f).vy = c as i32
                (*f).vz = d as i32
                (*f).has_vel = true
            }
        } else if ty == 76 as u8 { // L lpVec3 (skipped only)
            if !skip_lpvec3(b) {
                return false
            }
        } else if role == 65 as u8 { // A: array of entity ids is handled by the caller
            return false
        } else {
            if !rd_scalar(b, ty, &iv, &fv) {
                return false
            }
            if role == 69 as u8 { // E
                (*f).id = iv as i32
                (*f).has_id = true
            } else if role == 84 as u8 { // T
                (*f).type_id = iv as i32
                (*f).has_type = true
            } else if role == 88 as u8 || role == 89 as u8 || role == 90 as u8 { // X Y Z
                var v: f64 = fv
                if ty == 105 as u8 {
                    v = (iv as f64) / 32.0
                }
                if role == 88 as u8 {
                    (*f).x = v
                } else if role == 89 as u8 {
                    (*f).y = v
                } else {
                    (*f).z = v
                }
                (*f).has_pos = true
            } else if role == 120 as u8 || role == 121 as u8 || role == 122 as u8 { // x y z deltas
                var v: f64 = 0.0
                if ty == 98 as u8 {
                    v = (iv as f64) / 32.0
                } else {
                    v = (iv as f64) / 4096.0
                }
                if role == 120 as u8 {
                    (*f).x = v
                } else if role == 121 as u8 {
                    (*f).y = v
                } else {
                    (*f).z = v
                }
                (*f).has_rel = true
            } else if role == 87 as u8 || role == 80 as u8 { // W yaw, P pitch
                var v: f64 = fv
                if ty == 98 as u8 {
                    v = (((iv & 255) * 360) as f64) / 256.0
                }
                if role == 87 as u8 {
                    (*f).yaw = v
                    (*f).has_yaw = true
                } else {
                    (*f).pitch = v
                    (*f).has_pitch = true
                }
            } else if role == 71 as u8 { // G
                (*f).on_ground = iv != 0
                (*f).has_ground = true
            }
        }
        i = i + 1
    }
    return true
}

// ------------------------------------------------------------------------ per frame smoothing

// Shortest signed difference a - b in degrees, in [-180, 180].
fn angle_delta(a: f64, b: f64) -> f64 {
    var d: f64 = a - b
    while d > 180.0 { d = d - 360.0 }
    while d <= 0.0 - 180.0 { d = d + 360.0 }
    return d
}

// Moves the render state of every entity toward its network state: exponential approach with time constant `tau` seconds
// (vanilla spreads a position update over 3 ticks = 0.15 s; tau 0.05 reaches 95 % in that time). The first call for an entity,
// and a jump of more than `snap` blocks (teleport, dimension change), sets the render state directly. dt in seconds.
// Returns the number of entities whose render position is still off by more than 1/1000 block (the ones that are moving).
fn store_interp(s: *mut Store, dt: f64, tau: f64, snap: f64) -> u64 {
    var a: f64 = 1.0
    if tau > 0.0 && dt < 10.0 * tau {
        a = 1.0 - math.exp(0.0 - dt / tau)
    }
    if dt <= 0.0 { a = 0.0 }
    var moving: u64 = 0 as u64
    let cap: usize = (*s).ents.cap
    var i: usize = 0
    while i < cap {
        let e: *mut Entity = store_at(s, i)
        i = i + 1
        if (e as u64) == 0 as u64 { continue }
        let dx: f64 = (*e).x - (*e).rx
        let dy: f64 = (*e).y - (*e).ry
        let dz: f64 = (*e).z - (*e).rz
        if !(*e).rinit || dx * dx + dy * dy + dz * dz > snap * snap {
            (*e).rx = (*e).x
            (*e).ry = (*e).y
            (*e).rz = (*e).z
            (*e).ryaw = (*e).yaw
            (*e).rpitch = (*e).pitch
            (*e).rinit = true
            continue
        }
        (*e).rx = (*e).rx + dx * a
        (*e).ry = (*e).ry + dy * a
        (*e).rz = (*e).rz + dz * a
        (*e).ryaw = (*e).ryaw + angle_delta((*e).yaw, (*e).ryaw) * a
        (*e).rpitch = (*e).rpitch + angle_delta((*e).pitch, (*e).rpitch) * a
        let ex: f64 = (*e).x - (*e).rx
        let ey: f64 = (*e).y - (*e).ry
        let ez: f64 = (*e).z - (*e).rz
        if ex * ex + ey * ey + ez * ez > 0.000001 { moving = moving + 1 as u64 }
    }
    return moving
}

// ----------------------------------------------------------------------------- applying

fn ent_spawn(s: *mut Store, f: *mut Fields, kind: i32) {
    var p: u64 = tab_find(&(*s).ents, ((*f).id as i64) as u64, 0 as u64)
    if p == 0 as u64 {
        if (*s).ents.used >= MAX_ENTITIES {
            (*s).dropped = (*s).dropped + 1 as u64
            return
        }
        p = rt.heap_alloc(ent_size())
        if p == 0 as u64 {
            (*s).dropped = (*s).dropped + 1 as u64
            return
        }
        *(p as *mut Entity) = ent_empty()
        (*(p as *mut Entity)).k0 = ((*f).id as i64) as u64
        if !tab_insert(&(*s).ents, p) {
            rt.heap_free(p, ent_size())
            (*s).dropped = (*s).dropped + 1 as u64
            return
        }
    } else {
        *(p as *mut Entity) = ent_empty()
        (*(p as *mut Entity)).k0 = ((*f).id as i64) as u64
    }
    let e: *mut Entity = p as *mut Entity
    (*e).id = (*f).id
    (*e).kind = kind
    (*e).type_id = (*f).type_id
    (*e).has_uuid = (*f).has_uuid
    (*e).uuid_hi = (*f).uuid_hi
    (*e).uuid_lo = (*f).uuid_lo
    (*e).x = (*f).x
    (*e).y = (*f).y
    (*e).z = (*f).z
    (*e).yaw = (*f).yaw
    (*e).pitch = (*f).pitch
    if (*f).has_uuid {
        var nl: usize = 0
        let np: u64 = store_player_name(s, (*f).uuid_hi, (*f).uuid_lo, &nl)
        if np != 0 as u64 {
            var i: usize = 0
            while i < nl {
                (*e).name[i] = rt.ld8(np, i)
                i = i + 1
            }
            (*e).name_len = nl
        }
    }
    (*s).spawns = (*s).spawns + 1 as u64
}

// move / look / teleport / sync of a known entity
fn ent_update(s: *mut Store, f: *mut Fields) {
    let e: *mut Entity = store_get(s, (*f).id)
    if (e as u64) == 0 as u64 {
        (*s).misses = (*s).misses + 1 as u64
        return
    }
    if (*f).has_pos {
        (*e).x = (*f).x
        (*e).y = (*f).y
        (*e).z = (*f).z
    }
    if (*f).has_rel {
        (*e).x = (*e).x + (*f).x
        (*e).y = (*e).y + (*f).y
        (*e).z = (*e).z + (*f).z
    }
    if (*f).has_yaw {
        (*e).yaw = (*f).yaw
    }
    if (*f).has_pitch {
        (*e).pitch = (*f).pitch
    }
    if (*f).has_ground {
        (*e).on_ground = (*f).on_ground
    }
}

fn do_destroy(s: *mut Store, v: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    // the ids are read twice: validate everything first, then remove
    let p0: usize = bytes.bytes_pos(b)
    let cnt: i32 = bytes.get_varint(b) catch BAD
    if cnt == BAD || cnt < 0 || (cnt as usize) > bytes.bytes_remaining(b) {
        return false
    }
    var i: i32 = 0
    while i < cnt {
        let id: i32 = bytes.get_varint(b) catch BAD
        if id == BAD {
            return false
        }
        i = i + 1
    }
    bytes.bytes_set_pos(b, p0)
    let c2: i32 = bytes.get_varint(b) catch BAD
    i = 0
    while i < c2 {
        let id: i32 = bytes.get_varint(b) catch BAD
        let p: u64 = tab_remove(&(*s).ents, (id as i64) as u64, 0 as u64)
        if p != 0 as u64 {
            rt.heap_free(p, ent_size())
        }
        i = i + 1
    }
    (*s).destroys = (*s).destroys + 1 as u64
    return true
}

// ---------------------------------------------------------------------------- player info

fn hexv(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return c as i32 - 48
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return c as i32 - 87
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return c as i32 - 55
    }
    return 0 - 1
}

// `uuid:xxxxxxxx-xxxx-...` at p[0..n) -> hi / lo
fn parse_uuid(p: u64, n: usize, hi: *mut u64, lo: *mut u64) -> bool {
    var i: usize = 0
    if n >= 5 && rt.ld8(p, 0) == 117 as u8 && rt.ld8(p, 4) == 58 as u8 {
        i = 5
    }
    var h: u64 = 0
    var l: u64 = 0
    var d: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        i = i + 1
        if c == 45 as u8 {
            continue
        }
        let x: i32 = hexv(c)
        if x < 0 || d >= 32 {
            return false
        }
        if d < 16 {
            h = (h << 4) | (x as u64)
        } else {
            l = (l << 4) | (x as u64)
        }
        d = d + 1
    }
    *hi = h
    *lo = l
    return d == 32
}

// a `"text"` value of the value store (escapes \xHH \" \\) -> out[0..32), returns the length
fn parse_text(p: u64, n: usize, out: *mut [u8; 32]) -> usize {
    var o: usize = 0
    var i: usize = 1 // behind the opening quote
    while i < n && o < NAME_MAX {
        let c: u8 = rt.ld8(p, i)
        if c == 34 as u8 {
            break
        }
        if c == 92 as u8 && i + 1 < n {
            let d: u8 = rt.ld8(p, i + 1)
            if d == 120 as u8 && i + 3 < n {
                let a: i32 = hexv(rt.ld8(p, i + 2))
                let b2: i32 = hexv(rt.ld8(p, i + 3))
                if a >= 0 && b2 >= 0 {
                    (*out)[o] = ((a * 16 + b2) as u8)
                    o = o + 1
                    i = i + 4
                    continue
                }
            }
            (*out)[o] = d
            o = o + 1
            i = i + 2
            continue
        }
        (*out)[o] = c
        o = o + 1
        i = i + 1
    }
    return o
}

// does the line (path part p[0..pn)) end with `.name` and not lie inside a properties array?
fn is_name_path(p: u64, pn: usize) -> bool {
    if pn < 5 {
        return false
    }
    if rt.ld8(p, pn - 5) != 46 as u8 || rt.ld8(p, pn - 4) != 110 as u8 || rt.ld8(p, pn - 3) != 97 as u8 || rt.ld8(p, pn - 2) != 109 as u8 || rt.ld8(p, pn - 1) != 101 as u8 {
        return false
    }
    // "properties" contains 'p' 'r' 'o' 'p': any "properties[" occurrence disqualifies
    var i: usize = 0
    while i + 11 <= pn {
        if rt.ld8(p, i) == 112 as u8 && rt.ld8(p, i + 1) == 114 as u8 && rt.ld8(p, i + 2) == 111 as u8 && rt.ld8(p, i + 3) == 112 as u8 && rt.ld8(p, i + 4) == 101 as u8 && rt.ld8(p, i + 5) == 114 as u8 && rt.ld8(p, i + 6) == 116 as u8 {
            return false
        }
        i = i + 1
    }
    return true
}

fn starts_with(p: u64, n: usize, lit: str) -> bool {
    if n < lit.n {
        return false
    }
    var i: usize = 0
    while i < lit.n {
        if rt.ld8(p, i) != rt.ld8(lit.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// Player Info (all versions) and Player Remove (1.19.3+), decoded by the generic walker.
fn do_player_info(s: *mut Store, v: *mut mc_version.Version, id: i32, b: *mut bytes.Bytes, is_remove: bool) -> bool {
    let sch: u64 = (*v).schema_of(mc_version.ST_PLAY, mc_version.DIR_S2C, id)
    if sch == 0 as u64 {
        return false
    }
    let p0: usize = bytes.bytes_pos(b)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk_values(sch, b, &out)
    bytes.bytes_set_pos(b, p0)
    if !ok {
        rt.buf_free(&out)
        return false
    }
    let base: u64 = rt.buf_ptr(&out)
    let total: usize = rt.buf_len(&out)
    // legacy (1.8 - 1.19.2) remove action: `action=4` with `remove_player` / numeric value
    var remove_all: bool = false
    var cur_hi: u64 = 0
    var cur_lo: u64 = 0
    var have_uuid: bool = false
    var pos: usize = 0
    while pos < total {
        var e: usize = pos
        while e < total && rt.ld8(base, e) != 10 as u8 {
            e = e + 1
        }
        let ln: u64 = base + (pos as u64)
        let n: usize = e - pos
        pos = e + 1
        var eq: usize = 0
        while eq < n && rt.ld8(ln, eq) != 61 as u8 {
            eq = eq + 1
        }
        if eq >= n {
            continue
        }
        let vp: u64 = ln + ((eq + 1) as u64)
        let vn: usize = n - eq - 1
        if is_remove {
            if starts_with(ln, eq, "players[") && eq > 0 && rt.ld8(ln, eq - 1) == 93 as u8 {
                if parse_uuid(vp, vn, &cur_hi, &cur_lo) {
                    plr_del(s, cur_hi, cur_lo)
                }
            }
        } else if eq == 6 && starts_with(ln, eq, "action") {
            // numeric 4 or the mapper name
            if (vn == 1 && rt.ld8(vp, 0) == 52 as u8) || starts_with(vp, vn, "remove_player") || starts_with(vp, vn, "\"remove_player") {
                remove_all = true
            }
        } else if starts_with(ln, eq, "data[") {
            // data[N].uuid / data[N].name / data[N].player.name
            var dot: usize = 5
            while dot < eq && rt.ld8(ln, dot) != 46 as u8 {
                dot = dot + 1
            }
            if dot + 5 == eq && rt.ld8(ln, dot + 1) == 117 as u8 && rt.ld8(ln, dot + 2) == 117 as u8 && rt.ld8(ln, dot + 3) == 105 as u8 && rt.ld8(ln, dot + 4) == 100 as u8 {
                have_uuid = parse_uuid(vp, vn, &cur_hi, &cur_lo)
                if have_uuid && remove_all {
                    plr_del(s, cur_hi, cur_lo)
                }
            } else if have_uuid && !remove_all && is_name_path(ln, eq) && vn >= 2 && rt.ld8(vp, 0) == 34 as u8 {
                var nm: [u8; 32] = [0 as u8; 32]
                let nl: usize = parse_text(vp, vn, &nm)
                plr_put(s, cur_hi, cur_lo, (&nm[0]) as u64, nl)
            }
        }
    }
    rt.buf_free(&out)
    (*s).infos = (*s).infos + 1 as u64
    return true
}

// -------------------------------------------------------------------------------- dispatch

// Handles the packet `id` (play, server to client) when it is an entity packet of this version
// and returns true; false = not an entity packet (nothing consumed). The body cursor is put back
// where it was. A packet that does not parse changes nothing and counts in `bad`.
fn entity_on_packet(s: *mut Store, v: *mut mc_version.Version, id: i32, body: *mut bytes.Bytes) -> bool {
    if id < 0 {
        return false
    }
    var sem: usize = 99
    if (*v).sem[mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY] == id {
        sem = mc_entity_layout.KIND_SPAWN_OBJECT
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY_LIVING] == id {
        sem = mc_entity_layout.KIND_SPAWN_LIVING
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_NAMED_ENTITY_SPAWN] == id {
        sem = mc_entity_layout.KIND_SPAWN_PLAYER
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_ENTITY_TELEPORT] == id {
        sem = mc_entity_layout.KIND_TELEPORT
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_REL_ENTITY_MOVE] == id {
        sem = mc_entity_layout.KIND_REL_MOVE
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_ENTITY_MOVE_LOOK] == id {
        sem = mc_entity_layout.KIND_MOVE_LOOK
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_ENTITY_LOOK] == id {
        sem = mc_entity_layout.KIND_LOOK
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_ENTITY_DESTROY] == id {
        sem = mc_entity_layout.KIND_DESTROY
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_ENTITY_VELOCITY] == id {
        sem = mc_entity_layout.KIND_VELOCITY
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_SYNC_ENTITY_POSITION] == id {
        sem = mc_entity_layout.KIND_SYNC_POSITION
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_PLAYER_INFO] == id {
        if !do_player_info(s, v, id, body, false) {
            (*s).bad = (*s).bad + 1 as u64
        }
        return true
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_PLAYER_REMOVE] == id {
        if !do_player_info(s, v, id, body, true) {
            (*s).bad = (*s).bad + 1 as u64
        }
        return true
    } else {
        return false
    }
    let prog: str = mc_entity_layout.layout((*v).protocol, sem)
    if prog.n == 0 {
        return false
    }
    let p0: usize = bytes.bytes_pos(body)
    if sem == mc_entity_layout.KIND_DESTROY {
        if !do_destroy(s, v, body) {
            (*s).bad = (*s).bad + 1 as u64
        }
        bytes.bytes_set_pos(body, p0)
        return true
    }
    var f: Fields = fields_empty()
    let ok: bool = parse_layout(prog, body, &f)
    bytes.bytes_set_pos(body, p0)
    if !ok || !f.has_id {
        (*s).bad = (*s).bad + 1 as u64
        return true
    }
    if sem <= mc_entity_layout.KIND_SPAWN_PLAYER {
        var kind: i32 = KIND_OBJECT
        if sem == mc_entity_layout.KIND_SPAWN_LIVING {
            kind = KIND_LIVING
        } else if sem == mc_entity_layout.KIND_SPAWN_PLAYER {
            kind = KIND_PLAYER
        }
        ent_spawn(s, &f, kind)
    } else if sem == mc_entity_layout.KIND_VELOCITY {
        let e: *mut Entity = store_get(s, f.id)
        if (e as u64) == 0 as u64 {
            (*s).misses = (*s).misses + 1 as u64
        } else if f.has_vel {
            (*e).vx = f.vx
            (*e).vy = f.vy
            (*e).vz = f.vz
            (*s).velocities = (*s).velocities + 1 as u64
        }
    } else {
        if sem == mc_entity_layout.KIND_TELEPORT || sem == mc_entity_layout.KIND_SYNC_POSITION {
            (*s).teleports = (*s).teleports + 1 as u64
        } else if sem == mc_entity_layout.KIND_LOOK {
            (*s).looks = (*s).looks + 1 as u64
        } else {
            (*s).moves = (*s).moves + 1 as u64
        }
        ent_update(s, &f)
    }
    return true
}

// ------------------------------------------------------------------------------------ dump

fn put_f(out: *mut rt.Buf, f: io.Fmt) {
    var g: io.Fmt = f
    rt.buf_push_bytes(out, rt.buf_ptr(&g.b), rt.buf_len(&g.b))
    io.fmt_free(g)
}

// Canonical text, sorted by entity id (numbers: floats as their raw IEEE bits, exact):
//   entities <n>
//   E <id> kind=<0|1|2> type=<n> uuid=<32 hex|-> name=<text|-> x=<16 hex> y=.. z=.. yaw=.. pitch=.. ground=<0|1>
fn entity_dump(s: *mut Store, out: *mut rt.Buf) {
    let n: usize = (*s).ents.used
    let order: u64 = rt.heap_alloc((n + 1) * 8)
    var m: usize = 0
    var i: usize = 0
    while i < (*s).ents.cap {
        let r: u64 = rt.ld64((*s).ents.slots, i)
        if r > 1 as u64 && m < n {
            // insertion into an array sorted by id
            var j: usize = m
            while j > 0 && (*(rt.ld64(order, j - 1) as *mut Entity)).id > (*(r as *mut Entity)).id {
                rt.st64(order, j, rt.ld64(order, j - 1))
                j = j - 1
            }
            rt.st64(order, j, r)
            m = m + 1
        }
        i = i + 1
    }
    put_text(out, "entities ")
    put_dec(out, m as i64)
    put_text(out, "\n")
    i = 0
    while i < m {
        let e: *mut Entity = rt.ld64(order, i) as *mut Entity
        put_text(out, "E ")
        put_dec(out, (*e).id as i64)
        put_text(out, " kind=")
        put_dec(out, (*e).kind as i64)
        put_text(out, " type=")
        put_dec(out, (*e).type_id as i64)
        put_text(out, " uuid=")
        if (*e).has_uuid {
            rt.buf_push_hex_u64(out, (*e).uuid_hi, 16)
            rt.buf_push_hex_u64(out, (*e).uuid_lo, 16)
        } else {
            put_text(out, "-")
        }
        put_text(out, " name=")
        if (*e).name_len == 0 {
            put_text(out, "-")
        } else {
            rt.buf_push_bytes(out, (&(*e).name[0]) as u64, (*e).name_len)
        }
        put_text(out, " x=")
        rt.buf_push_hex_u64(out, math.math_bits((*e).x), 16)
        put_text(out, " y=")
        rt.buf_push_hex_u64(out, math.math_bits((*e).y), 16)
        put_text(out, " z=")
        rt.buf_push_hex_u64(out, math.math_bits((*e).z), 16)
        put_text(out, " yaw=")
        rt.buf_push_hex_u64(out, math.math_bits((*e).yaw), 16)
        put_text(out, " pitch=")
        rt.buf_push_hex_u64(out, math.math_bits((*e).pitch), 16)
        put_text(out, " ground=")
        if (*e).on_ground {
            put_text(out, "1")
        } else {
            put_text(out, "0")
        }
        put_text(out, "\n")
        i = i + 1
    }
    rt.heap_free(order, (n + 1) * 8)
}

fn put_text(out: *mut rt.Buf, t: str) {
    rt.buf_push_bytes(out, t.p as u64, t.n)
}

fn put_dec(out: *mut rt.Buf, v: i64) {
    put_f(out, f"{v}")
}
