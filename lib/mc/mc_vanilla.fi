// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.fs
import std.env
import zip.zip

export {
    VANILLA_OK, VANILLA_OFF, VANILLA_NO_VERSION, VANILLA_NO_JAR, VANILLA_NO_CACHE_DIR, VANILLA_BAD_JAR, VANILLA_WRITE_FAILED, VANILLA_NO_ASSETS,
    vanilla_version_name, vanilla_status_text, vanilla_keep_entry, vanilla_cache_dir, vanilla_find_jar,
    vanilla_cache_file, vanilla_build_cache, vanilla_ensure, vanilla_jar_pack_format,
    vanilla_resolve, vanilla_add_meta, vanilla_dir_of, vanilla_write_cache,
}

const VANILLA_OK: i32 = 0
const VANILLA_OFF: i32 = 1
const VANILLA_NO_VERSION: i32 = 2
const VANILLA_NO_JAR: i32 = 3
const VANILLA_NO_CACHE_DIR: i32 = 4
const VANILLA_BAD_JAR: i32 = 5
const VANILLA_WRITE_FAILED: i32 = 6
const VANILLA_NO_ASSETS: i32 = 7

const KEEP_PREFIXES: i32 = 5

fn push(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.length())
}

fn keep_prefix(i: i32) -> str {
    if i == 0 { return "assets/minecraft/textures/block/" }
    if i == 1 { return "assets/minecraft/textures/blocks/" }
    if i == 2 { return "assets/minecraft/textures/colormap/" }
    if i == 3 { return "assets/minecraft/blockstates/" }
    return "assets/minecraft/models/block/"
}

fn starts_with(s: str, prefix: str) -> bool {
    let n: usize = prefix.length()
    if s.length() < n { return false }
    var i: usize = 0
    while i < n {
        if s.chars(i) != prefix.chars(i) { return false }
        i = i + 1
    }
    return true
}

fn vanilla_keep_entry(name: str) -> bool {
    if name.length() == 0 || name.chars(name.length() - 1) == 47 as u8 { return false }
    var i: i32 = 0
    while i < KEEP_PREFIXES {
        if starts_with(name, keep_prefix(i)) { return true }
        i = i + 1
    }
    return false
}

fn vanilla_version_name(protocol: i32) -> str {
    if env.has("MC_VANILLA_VERSION") {
        let v: str = env.get("MC_VANILLA_VERSION")
        if v.length() > 0 { return v }
    }
    if protocol == 47 { return "1.8.9" }
    if protocol == 340 { return "1.12.2" }
    if protocol == 754 { return "1.16.5" }
    if protocol == 763 { return "1.20.1" }
    if protocol == 764 { return "1.20.2" }
    if protocol == 767 { return "1.21.1" }
    if protocol == 769 { return "1.21.4" }
    if protocol == 772 { return "1.21.8" }
    if protocol == 774 { return "1.21.11" }
    if protocol == 775 { return "26.1" }
    return ""
}

fn vanilla_status_text(rc: i32) -> str {
    if rc == VANILLA_OK { return "ok" }
    if rc == VANILLA_OFF { return "disabled by MC_VANILLA=0" }
    if rc == VANILLA_NO_VERSION { return "no client version known for this protocol (set MC_VANILLA_VERSION)" }
    if rc == VANILLA_NO_JAR { return "no vanilla client jar found (set MC_VANILLA_JAR or install the game version in the launcher)" }
    if rc == VANILLA_NO_CACHE_DIR { return "no cache directory (set MC_VANILLA_CACHE)" }
    if rc == VANILLA_BAD_JAR { return "client jar is not a readable archive" }
    if rc == VANILLA_NO_ASSETS { return "no launcher asset index found for this version (set MC_VANILLA_ASSETS / MC_VANILLA_INDEX)" }
    return "cannot write the vanilla asset cache"
}

fn vanilla_cache_dir(out: *mut rt.Buf) -> bool {
    if env.has("MC_VANILLA_CACHE") {
        let c: str = env.get("MC_VANILLA_CACHE")
        if c.length() > 0 {
            push(out, c)
            return true
        }
    }
    let la: str = env.get("LOCALAPPDATA")
    if la.length() > 0 {
        push(out, la)
        push(out, "/mcplay")
        return true
    }
    let xdg: str = env.get("XDG_CACHE_HOME")
    if xdg.length() > 0 {
        push(out, xdg)
        push(out, "/mcplay")
        return true
    }
    let home: str = env.get("HOME")
    if home.length() > 0 {
        push(out, home)
        push(out, "/.cache/mcplay")
        return true
    }
    return false
}

fn jar_in_dir(dir: str, version: str, out: *mut rt.Buf) -> bool {
    if dir.length() == 0 { return false }
    var p: rt.Buf = rt.buf_new()
    push(&p, dir)
    push(&p, "/versions/")
    push(&p, version)
    push(&p, "/")
    push(&p, version)
    push(&p, ".jar")
    if fs.is_file(rt.buf_str(&p)) {
        rt.buf_push_bytes(out, rt.buf_ptr(&p), rt.buf_len(&p))
        rt.buf_free(&p)
        return true
    }
    rt.buf_free(&p)
    return false
}

fn jar_in_home_suffix(base: str, suffix: str, version: str, out: *mut rt.Buf) -> bool {
    if base.length() == 0 { return false }
    var d: rt.Buf = rt.buf_new()
    push(&d, base)
    push(&d, suffix)
    let ok: bool = jar_in_dir(rt.buf_str(&d), version, out)
    rt.buf_free(&d)
    return ok
}

fn vanilla_find_jar(version: str, out: *mut rt.Buf) -> bool {
    if env.has("MC_VANILLA_JAR") {
        let j: str = env.get("MC_VANILLA_JAR")
        if j.length() > 0 && fs.is_file(j) {
            push(out, j)
            return true
        }
    }
    if jar_in_dir(env.get("MC_VANILLA_DIR"), version, out) { return true }
    if jar_in_dir(env.get("MC_PACK_DIR"), version, out) { return true }
    if jar_in_home_suffix(env.get("APPDATA"), "/.minecraft", version, out) { return true }
    let home: str = env.get("HOME")
    if jar_in_home_suffix(home, "/Library/Application Support/minecraft", version, out) { return true }
    if jar_in_home_suffix(home, "/.minecraft", version, out) { return true }
    if jar_in_home_suffix(home, "/.local/share/minecraft", version, out) { return true }
    return false
}

fn vanilla_cache_file(version: str, jar_size: u64, out: *mut rt.Buf) -> bool {
    if !vanilla_cache_dir(out) { return false }
    push(out, "/vanilla-")
    push(out, version)
    push(out, "-")
    rt.buf_push_dec_u64(out, jar_size)
    push(out, ".zip")
    return true
}

fn vanilla_jar_pack_format(protocol: i32) -> i32 {
    if protocol == 47 { return 1 }
    if protocol == 340 { return 3 }
    if protocol == 754 { return 6 }
    if protocol == 763 { return 15 }
    if protocol == 764 { return 18 }
    if protocol == 767 { return 34 }
    if protocol == 769 { return 46 }
    if protocol == 772 { return 64 }
    if protocol == 774 { return 75 }
    if protocol == 775 { return 84 }
    return 0
}

fn vanilla_add_meta(w: *mut zip.ZipWriter, pack_format: i32) -> bool {
    var m: rt.Buf = rt.buf_new()
    push(&m, "{\"pack\":{\"pack_format\":")
    rt.buf_push_dec_i64(&m, pack_format as i64)
    push(&m, ",\"description\":\"vanilla assets cache\"}}")
    let ok: bool = zip.zip_add(w, "pack.mcmeta", rt.buf_ptr(&m), rt.buf_len(&m), true) catch | e | (false)
    rt.buf_free(&m)
    return ok
}

fn vanilla_dir_of(path: str) -> str {
    var n: usize = path.length()
    while n > 0 && path.chars(n - 1) != 47 as u8 { n = n - 1 }
    if n == 0 { return "" }
    return str { p: path.p, n: n - 1 }
}

fn vanilla_write_cache(dest: str, data: *mut rt.Buf) -> bool {
    let d: str = vanilla_dir_of(dest)
    if d.length() > 0 {
        fs.mkdir_all(d) catch | e | (false)
    }
    let ok: bool = fs.write_atomic(dest, rt.buf_ptr(data), rt.buf_len(data)) catch | e | (false)
    return ok
}

fn vanilla_build_cache(jar: str, dest: str, pack_format: i32, count: *mut i32) -> i32 {
    *count = 0
    var raw: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(jar, &raw) catch | e | (0)
    if got == 0 {
        rt.buf_free(&raw)
        return VANILLA_BAD_JAR
    }
    var z: zip.ZipReader = zip.zip_reader_empty()
    var opened: bool = true
    z = zip.zip_reader_open(rt.buf_ptr(&raw), rt.buf_len(&raw)) catch | e | (zip.zip_reader_empty())
    if zip.zip_entry_count(&z) == 0 { opened = false }
    if !opened {
        rt.buf_free(&raw)
        return VANILLA_BAD_JAR
    }
    var out: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&out)
    var rc: i32 = VANILLA_OK
    if !vanilla_add_meta(&w, pack_format) { rc = VANILLA_WRITE_FAILED }
    var kept: i32 = 0
    let total: usize = zip.zip_entry_count(&z)
    var i: usize = 0
    while i < total && rc == VANILLA_OK {
        let name: str = zip.zip_entry_name(&z, i)
        if !zip.zip_entry_is_dir(&z, i) && vanilla_keep_entry(name) {
            var body: rt.Buf = rt.buf_new()
            let n: usize = zip.zip_extract(&z, i, &body) catch | e | (0)
            let has_data: bool = n > 0 || zip.zip_entry_size(&z, i) == 0
            if !has_data {
                rc = VANILLA_BAD_JAR
            } else {
                let added: bool = zip.zip_add(&w, name, rt.buf_ptr(&body), rt.buf_len(&body), true) catch | e | (false)
                if added { kept = kept + 1 } else { rc = VANILLA_WRITE_FAILED }
            }
            rt.buf_free(&body)
        }
        i = i + 1
    }
    if rc == VANILLA_OK {
        let fin: usize = zip.zip_finish(&w) catch | e | (0)
        if fin == 0 { rc = VANILLA_WRITE_FAILED }
    }
    zip.zip_writer_free(&w)
    zip.zip_reader_free(&z)
    rt.buf_free(&raw)
    if rc == VANILLA_OK {
        if kept == 0 {
            rc = VANILLA_BAD_JAR
        } else if !vanilla_write_cache(dest, &out) {
            rc = VANILLA_WRITE_FAILED
        }
    }
    rt.buf_free(&out)
    *count = kept
    return rc
}

fn vanilla_resolve(protocol: i32, jar: *mut rt.Buf) -> i32 {
    if env.has("MC_VANILLA") {
        let f: str = env.get("MC_VANILLA")
        if f.length() > 0 && f.chars(0) == 48 as u8 { return VANILLA_OFF }
    }
    let version: str = vanilla_version_name(protocol)
    if version.length() == 0 { return VANILLA_NO_VERSION }
    if !vanilla_find_jar(version, jar) { return VANILLA_NO_JAR }
    return VANILLA_OK
}

fn vanilla_ensure(protocol: i32, out: *mut rt.Buf) -> i32 {
    var jar: rt.Buf = rt.buf_new()
    let found: i32 = vanilla_resolve(protocol, &jar)
    if found != VANILLA_OK {
        rt.buf_free(&jar)
        return found
    }
    let version: str = vanilla_version_name(protocol)
    let info: fs.FileInfo = fs.stat(rt.buf_str(&jar)) catch | e | fs.FileInfo { kind: 0 as u8, mode: 0 as u32, size: 0 as u64, mtime_ns: 0 }
    var cache: rt.Buf = rt.buf_new()
    var rc: i32 = VANILLA_OK
    if info.size == 0 as u64 {
        rc = VANILLA_BAD_JAR
    } else if !vanilla_cache_file(version, info.size, &cache) {
        rc = VANILLA_NO_CACHE_DIR
    } else if !fs.is_file(rt.buf_str(&cache)) {
        var kept: i32 = 0
        var pf: i32 = vanilla_jar_pack_format(protocol)
        if pf == 0 { pf = 15 }
        rc = vanilla_build_cache(rt.buf_str(&jar), rt.buf_str(&cache), pf, &kept)
    }
    if rc == VANILLA_OK {
        rt.buf_push_bytes(out, rt.buf_ptr(&cache), rt.buf_len(&cache))
    }
    rt.buf_free(&cache)
    rt.buf_free(&jar)
    return rc
}
