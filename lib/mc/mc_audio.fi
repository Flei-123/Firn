// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_audio.fi -- mc_audio: the Minecraft side of audio.engine (docs/mc/audio.md).
//
//     import audio.engine
//     import audio.bank
//     import mc.mc_audio
//
//     var e: engine.Engine = engine.engine_new(48000 as u32, 64 as u32)
//     var b: bank.Bank = bank.bank_new()
//     var m: mc_audio.McAudio = mc_audio.mca_new(&e)          // buses: master/music/sfx/ui + one per category
//     mc_audio.mca_bank_load_file(&m, &b, "assets/sounds.json")  // Aulos JSON bank, events = Minecraft sound names
//     ...per frame:
//     mc_audio.mca_update(&m, &cam, dt)                       // listener = camera, entity sources, engine_update
//     mc_audio.mca_block_sound(&m, &reg, state, mc_audio.ACT_BREAK, bx, by, bz)
//     mc_audio.mca_play_at(&m, "entity.zombie.ambient", mc_audio.CAT_HOSTILE, x, y, z, 1.0, 1.0)
//
// WHAT IT DOES
//   * Listener = mc_camera (position, forward, up) -> engine_set_listener. Source positions are sent RELATIVE to a
//     movable origin (f32 has 24 bits: at x = 3e6 a block would be 0.25 blocks coarse); the origin follows the camera
//     in steps of 256 blocks and all live sources are re-sent when it moves.
//   * Sources: a block position, a free point, an entity id (follows `mc_entity.Store`), or the UI (2D).
//   * Distance model = the Minecraft one: OpenAL AL_LINEAR_DISTANCE_CLAMPED, reference 1, range 16 blocks:
//     gain = clamp((range - d) / (range - 1), 0, 1); applied by the engine (rolloff "linear", min 1, max range).
//     `mca_mc_gain` / `mca_pan` / `mca_pan_lr` are the SAME f32 math as engine.compute_targets as pure functions
//     (tools/mc/audio: bit for bit against numpy).
//   * Block sounds: block name -> sound type (stone/wood/gravel/...), event "block.<type>.<step|break|place|hit|fall>",
//     volume/pitch per action as in SoundType (step 0.15/1.0, break+place 1.0/0.8, hit 0.25/0.5, fall 0.5/0.75).
//   * Event names -> engine events of the Aulos JSON bank (audio.bank). "minecraft:" is dropped. Unknown name = silence
//     (counted in `n_missing`), like Minecraft with a missing sound.
//   * Categories master/music/record/weather/blocks/hostile/neutral/players/ambient/voice (+ ui): every category is an
//     engine bus (mc.<name> under music / sfx / ui, master = the master bus). Volume per category and mute are bus calls,
//     so they act on running voices at once.
//   * Packets (1.20.1, protocol 763): Sound Effect, Entity Sound Effect, Stop Sound decoders -> `SoundPkt` -> `mca_apply_sound`.
//
// HONEST (docs/mc/audio.md)
// M1  The block registry has no sound type: it is derived from the block NAME (rules in `mca_material_of_name`).
// M2  The numeric sound id of a packet needs the id -> name list of the version: generated per version by
//     tools/mcgen/gen_sounds.py (lib/mc/vNNN/mc_snd_vNNN.fi), loaded with `mca_sound_table_load`; inline (named) sounds
//     work without it.
// M3  The range is per EVENT (volume > 1 does not widen it per voice); `mca_set_range` widens an event (thunder).
// M5  The engine's `spatial` flag belongs to the EVENT: an event played at a point becomes spatial for all later plays.
// M4  No occlusion, no reverb, no velocity for block sounds. Doppler only if the bank asks for it.
import std.rt
import std.math
import std.bytes
import std.io
import audio.engine
import audio.bank
import mc.mc_camera
import mc.mc_registry
import mc.mc_world
import mc.mc_chunk
import mc.mc_entity
import mc.mc_packet
import mc.mc_sem
import mc.mc_version

export {
    McAudio, SoundPkt, StopPkt, Walker,
    mca_new, mca_free, mca_bank_load_text, mca_bank_load_file, mca_update, mca_update_entities,
    mca_set_listener, mca_set_category_volume, mca_get_category_volume, mca_set_muted, mca_is_muted, mca_category_bus,
    mca_play_event, mca_play_at, mca_play_entity, mca_play_ui, mca_stop_entity, mca_stop_all, mca_set_range,
    mca_block_sound, mca_block_sound_name, mca_material_of_name, mca_material_name, mca_action_name,
    mca_state_at, mca_walker_new, mca_walk,
    mca_category_of_name, mca_category_of_event, mca_event_name, mca_find, mca_type_material,
    mca_mc_gain, mca_atten, mca_pan, mca_pan_lr,
    mca_sound_id_set, mca_sound_name, mca_decode_sound_effect, mca_decode_entity_sound, mca_decode_stop_sound,
    mca_apply_sound, mca_apply_stop,
    mca_sound_table_load, mca_sound_format, mca_decode_sound_v, mca_on_packet, mca_on_block_change, mca_set_block_change_sounds,
    mca_set_log, mca_world_event_sound, Ambient, mca_ambient_new, mca_ambient_tick,
    SF_NONE, SF_LEGACY, SF_CLASSIC, SF_HOLDER, SK_SOUND, SK_NAMED, SK_ENTITY,
    CAT_MASTER, CAT_MUSIC, CAT_RECORD, CAT_WEATHER, CAT_BLOCKS, CAT_HOSTILE, CAT_NEUTRAL, CAT_PLAYERS, CAT_AMBIENT,
    CAT_VOICE, CAT_UI, CAT_COUNT,
    ACT_STEP, ACT_BREAK, ACT_PLACE, ACT_HIT, ACT_FALL,
    MAT_NONE, MAT_STONE, MAT_WOOD, MAT_GRAVEL, MAT_GRASS, MAT_SAND, MAT_SNOW, MAT_GLASS, MAT_WOOL, MAT_METAL,
    MAT_DEEPSLATE, MAT_NETHERRACK, MAT_SLIME, MAT_BONE, MAT_COUNT,
    MAX_SOURCES, DEFAULT_RANGE,
}

// category numbers = the wire numbers of the soundSource enum (1.20.1), CAT_UI is ours
const CAT_MASTER: i32 = 0
const CAT_MUSIC: i32 = 1
const CAT_RECORD: i32 = 2
const CAT_WEATHER: i32 = 3
const CAT_BLOCKS: i32 = 4
const CAT_HOSTILE: i32 = 5
const CAT_NEUTRAL: i32 = 6
const CAT_PLAYERS: i32 = 7
const CAT_AMBIENT: i32 = 8
const CAT_VOICE: i32 = 9
const CAT_UI: i32 = 10
const CAT_COUNT: i32 = 11

const ACT_STEP: i32 = 0
const ACT_BREAK: i32 = 1
const ACT_PLACE: i32 = 2
const ACT_HIT: i32 = 3
const ACT_FALL: i32 = 4

const MAT_NONE: i32 = 0 - 1
const MAT_STONE: i32 = 0
const MAT_WOOD: i32 = 1
const MAT_GRAVEL: i32 = 2
const MAT_GRASS: i32 = 3
const MAT_SAND: i32 = 4
const MAT_SNOW: i32 = 5
const MAT_GLASS: i32 = 6
const MAT_WOOL: i32 = 7
const MAT_METAL: i32 = 8
const MAT_DEEPSLATE: i32 = 9
const MAT_NETHERRACK: i32 = 10
const MAT_SLIME: i32 = 11
const MAT_BONE: i32 = 12
const MAT_COUNT: i32 = 13

const MAX_SOURCES: usize = 128
const DEFAULT_RANGE: f32 = 16.0
const REBASE_STEP: f64 = 256.0
const REBASE_LIMIT: f64 = 1024.0
const STEP_DISTANCE: f64 = 1.6666666666666667 // Minecraft: moveDist += horizontal * 0.6, a step per 1.0 of it

struct McAudio {
    eng: *mut engine.Engine,
    // origin of the engine coordinates (world = origin + engine)
    ox: f64, oy: f64, oz: f64,
    // listener in world coordinates, previous one for the velocity
    lx: f64, ly: f64, lz: f64,
    has_listener: bool,
    cat_vol: [f32; 11],
    muted: bool,
    // events that already got the Minecraft distance model (bit per event id, 512 events)
    tuned: [u64; 8],
    // live sources (world coordinates; ent >= 0 follows the entity store)
    s_handle: [u32; 128],
    s_ent: [i32; 128],
    s_cat: [i32; 128],
    s_ev: [i32; 128],
    s_x: [f64; 128], s_y: [f64; 128], s_z: [f64; 128],
    dt: f64,
    name: rt.Buf, // scratch for event names
    // numeric sound id -> name (host filled), entries are (offset, length) u32 pairs into `sid_names`
    sid_tab: u64, sid_cap: usize,
    sid_names: rt.Buf,
    // counters
    n_played: u64, n_missing: u64, n_culled: u64, n_muted: u64, n_full: u64, n_rebase: u64,
    n_pkt: u64, n_bad: u64,
    log: bool, log_frame: u64, // event log (stderr line per started voice): log_frame = host-set sink frame position
    bc_sounds: bool, // block change heuristics on (default off: the server's world event / sound packets already say it)
}

// -------------------------------------------------------------------------------------------- small helpers

fn clampf(v: f32, lo: f32, hi: f32) -> f32 {
    if v < lo { return lo }
    if v > hi { return hi }
    return v
}

fn absd(v: f64) -> f64 {
    if v < 0.0 { return 0.0 - v }
    return v
}

fn mk(p: u64, n: usize) -> str {
    return str { p: p as *mut u8, n: n }
}

fn ld_b(p: u64, i: usize) -> u8 {
    return rt.ld8(p, i)
}

// does p[0..n) contain `needle`?
fn has(p: u64, n: usize, needle: str) -> bool {
    let k: usize = needle.length()
    if k == 0 || k > n { return false }
    let q: u64 = needle.p as u64
    var i: usize = 0
    while i + k <= n {
        var j: usize = 0
        while j < k && ld_b(p, i + j) == ld_b(q, j) {
            j = j + 1
        }
        if j == k { return true }
        i = i + 1
    }
    return false
}

fn starts(p: u64, n: usize, pre: str) -> bool {
    let k: usize = pre.length()
    if k > n { return false }
    let q: u64 = pre.p as u64
    var j: usize = 0
    while j < k {
        if ld_b(p, j) != ld_b(q, j) { return false }
        j = j + 1
    }
    return true
}

fn ends(p: u64, n: usize, suf: str) -> bool {
    let k: usize = suf.length()
    if k > n { return false }
    let q: u64 = suf.p as u64
    var j: usize = 0
    while j < k {
        if ld_b(p, n - k + j) != ld_b(q, j) { return false }
        j = j + 1
    }
    return true
}

fn same(p: u64, n: usize, s: str) -> bool {
    return n == s.length() && starts(p, n, s)
}

// ------------------------------------------------------------------------------------ pure spatial math (f32)
// Same operations in the same order as engine.compute_targets (the Aulos math), so the results are bit for bit.

fn vlen(x: f32, y: f32, z: f32) -> f32 {
    return math.sqrt32(x * x + y * y + z * z)
}

fn vnorm(x: f32, y: f32, z: f32, ox: *mut f32, oy: *mut f32, oz: *mut f32) {
    let l: f32 = vlen(x, y, z)
    if l < 0.000001 {
        *ox = 0.0
        *oy = 0.0
        *oz = 0.0
        return
    }
    *ox = x / l
    *oy = y / l
    *oz = z / l
}

// engine attenuation: linear (Minecraft / OpenAL clamped linear) or inverse
fn mca_atten(distance: f32, min_d: f32, max_d: f32, linear: bool, rolloff: f32) -> f32 {
    let d: f32 = clampf(distance, min_d, max_d)
    var a: f32 = 0.0
    if linear {
        let span: f32 = max_d - min_d
        if span <= 0.000001 {
            a = 1.0
        } else {
            a = (max_d - d) / span
        }
    } else {
        a = min_d / (min_d + rolloff * (d - min_d))
    }
    return clampf(a, 0.0, 1.0)
}

// Minecraft gain of a sound heard at `distance` blocks: volume (clamped to 1) times the linear fall off over `range`.
fn mca_mc_gain(volume: f32, distance: f32, range: f32) -> f32 {
    return clampf(volume, 0.0, 1.0) * mca_atten(distance, 1.0, range, true, 1.0)
}

// pan -1 (left) .. 1 (right) of the relative position (rx, ry, rz) for a listener looking along f with up u
fn mca_pan(rx: f32, ry: f32, rz: f32, fx0: f32, fy0: f32, fz0: f32, ux0: f32, uy0: f32, uz0: f32) -> f32 {
    let distance: f32 = vlen(rx, ry, rz)
    var fx: f32 = 0.0
    var fy: f32 = 0.0
    var fz: f32 = 0.0
    var ux: f32 = 0.0
    var uy: f32 = 0.0
    var uz: f32 = 0.0
    vnorm(fx0, fy0, fz0, &fx, &fy, &fz)
    vnorm(ux0, uy0, uz0, &ux, &uy, &uz)
    let cx: f32 = fy * uz - fz * uy
    let cy: f32 = fz * ux - fx * uz
    let cz: f32 = fx * uy - fy * ux
    var gx: f32 = 0.0
    var gy: f32 = 0.0
    var gz: f32 = 0.0
    vnorm(cx, cy, cz, &gx, &gy, &gz)
    if distance > 0.00001 {
        return clampf((rx * gx + ry * gy + rz * gz) / distance, 0.0 - 1.0, 1.0)
    }
    return 0.0
}

// equal power pan law of the engine: left = cos((pan + 1) * pi/4), right = sin(...)
fn mca_pan_lr(pan: f32, out_l: *mut f32, out_r: *mut f32) {
    let pi: f32 = 3.14159265358979323846
    let angle: f32 = (pan + 1.0) * (pi * 0.25)
    *out_l = math.cos(angle as f64) as f32
    *out_r = math.sin(angle as f64) as f32
}

// ------------------------------------------------------------------------------------------------ names

fn mca_material_name(mat: i32) -> str {
    if mat == MAT_WOOD { return "wood" }
    if mat == MAT_GRAVEL { return "gravel" }
    if mat == MAT_GRASS { return "grass" }
    if mat == MAT_SAND { return "sand" }
    if mat == MAT_SNOW { return "snow" }
    if mat == MAT_GLASS { return "glass" }
    if mat == MAT_WOOL { return "wool" }
    if mat == MAT_METAL { return "metal" }
    if mat == MAT_DEEPSLATE { return "deepslate" }
    if mat == MAT_NETHERRACK { return "netherrack" }
    if mat == MAT_SLIME { return "slime_block" }
    if mat == MAT_BONE { return "bone_block" }
    return "stone"
}

fn mca_action_name(act: i32) -> str {
    if act == ACT_BREAK { return "break" }
    if act == ACT_PLACE { return "place" }
    if act == ACT_HIT { return "hit" }
    if act == ACT_FALL { return "fall" }
    return "step"
}

fn action_volume(act: i32) -> f32 {
    if act == ACT_BREAK || act == ACT_PLACE { return 1.0 }
    if act == ACT_HIT { return 0.25 }
    if act == ACT_FALL { return 0.5 }
    return 0.15
}

fn action_pitch(act: i32) -> f32 {
    if act == ACT_BREAK || act == ACT_PLACE { return 0.8 }
    if act == ACT_HIT { return 0.5 }
    if act == ACT_FALL { return 0.75 }
    return 1.0
}

fn wood_species(p: u64, n: usize) -> bool {
    return starts(p, n, "oak_") || starts(p, n, "spruce_") || starts(p, n, "birch_") || starts(p, n, "jungle_")
    || starts(p, n, "acacia_") || starts(p, n, "dark_oak_") || starts(p, n, "mangrove_") || starts(p, n, "cherry_")
    || starts(p, n, "crimson_") || starts(p, n, "warped_") || starts(p, n, "stripped_") || starts(p, n, "bamboo_")
}

// M1: sound type from the block name ("stone", "oak_planks", "minecraft:glass_pane" ...). MAT_NONE = no sound
// (air, water, lava, light, barrier ...).
fn mca_material_of_name(p0: u64, n0: usize) -> i32 {
    var p: u64 = p0
    var n: usize = n0
    if starts(p, n, "minecraft:") {
        p = p + 10 as u64
        n = n - 10
    }
    if n == 0 { return MAT_NONE }
    if same(p, n, "air") || same(p, n, "cave_air") || same(p, n, "void_air") || same(p, n, "water") || same(p, n, "lava")
    || same(p, n, "light") || same(p, n, "barrier") || same(p, n, "structure_void") || same(p, n, "bubble_column") {
        return MAT_NONE
    }
    if has(p, n, "deepslate") { return MAT_DEEPSLATE }
    if same(p, n, "bedrock") || ends(p, n, "_ore") || has(p, n, "sandstone") || has(p, n, "nether_bricks") {
        if has(p, n, "nether_bricks") { return MAT_NETHERRACK }
        return MAT_STONE
    }
    if has(p, n, "netherrack") || has(p, n, "nylium") || has(p, n, "nether_wart_block") { return MAT_NETHERRACK }
    if has(p, n, "slime_block") { return MAT_SLIME }
    if has(p, n, "bone_block") { return MAT_BONE }
    if has(p, n, "glass") || has(p, n, "ice") || same(p, n, "beacon") || has(p, n, "sea_lantern") { return MAT_GLASS }
    if has(p, n, "powder_snow") || has(p, n, "snow") { return MAT_SNOW }
    if has(p, n, "wool") || has(p, n, "carpet") || has(p, n, "_bed") || has(p, n, "banner") { return MAT_WOOL }
    if has(p, n, "sand") { return MAT_SAND }
    if has(p, n, "gravel") || has(p, n, "dirt") || has(p, n, "clay") || has(p, n, "farmland") || has(p, n, "podzol")
    || has(p, n, "mycelium") || has(p, n, "mud") {
        return MAT_GRAVEL
    }
    if has(p, n, "grass") || has(p, n, "leaves") || has(p, n, "fern") || has(p, n, "sapling") || has(p, n, "vine")
    || has(p, n, "tulip") || has(p, n, "poppy") || has(p, n, "dandelion") || has(p, n, "orchid") || has(p, n, "allium")
    || has(p, n, "cornflower") || has(p, n, "lily") || has(p, n, "peony") || has(p, n, "lilac") || has(p, n, "rose_bush")
    || has(p, n, "wheat") || has(p, n, "carrots") || has(p, n, "potatoes") || has(p, n, "beetroots")
    || has(p, n, "sugar_cane") || has(p, n, "moss") || has(p, n, "azalea") {
        return MAT_GRASS
    }
    if has(p, n, "iron") || has(p, n, "gold_block") || has(p, n, "copper") || has(p, n, "chain") || has(p, n, "anvil")
    || has(p, n, "lantern") || has(p, n, "bell") || has(p, n, "hopper") || has(p, n, "cauldron") || has(p, n, "rail")
    || has(p, n, "netherite") || has(p, n, "diamond_block") || has(p, n, "emerald_block") {
        return MAT_METAL
    }
    if wood_species(p, n) || has(p, n, "planks") || has(p, n, "chest") || has(p, n, "barrel") || has(p, n, "bookshelf")
    || has(p, n, "crafting_table") || has(p, n, "note_block") || has(p, n, "jukebox") || has(p, n, "ladder")
    || has(p, n, "scaffolding") || has(p, n, "_sign") || has(p, n, "composter") || has(p, n, "loom")
    || has(p, n, "lectern") || has(p, n, "fletching") || has(p, n, "cartography") || has(p, n, "smithing") {
        return MAT_WOOD
    }
    return MAT_STONE
}

// Sound TYPE name of a block sound event ("cherry_wood", "nether_bricks", "azalea_leaves" from block.<type>.step) -> the nearest of
// our 13 synthesised materials. Server sound packets name ~120 types; the bank has 13. Heuristic by name, MAT_STONE when unknown.
fn mca_type_material(p: u64, n: usize) -> i32 {
    if has(p, n, "deepslate") { return MAT_DEEPSLATE }
    if has(p, n, "slime") || has(p, n, "honey") { return MAT_SLIME }
    if has(p, n, "bone") { return MAT_BONE }
    if has(p, n, "glass") || has(p, n, "amethyst") || has(p, n, "froglight") { return MAT_GLASS }
    if has(p, n, "snow") { return MAT_SNOW }
    if has(p, n, "wool") || has(p, n, "candle") || has(p, n, "carpet") { return MAT_WOOL }
    if has(p, n, "suspicious_sand") || same(p, n, "sand") { return MAT_SAND }
    if has(p, n, "gravel") || has(p, n, "mud") || has(p, n, "soul_") || has(p, n, "rooted_dirt") || has(p, n, "sponge") { return MAT_GRAVEL }
    if has(p, n, "netherrack") || has(p, n, "nether_bricks") || has(p, n, "nether_ore") || has(p, n, "nether_gold") || has(p, n, "nylium")
    || has(p, n, "wart_block") || has(p, n, "shroomlight") || has(p, n, "ancient_debris") { return MAT_NETHERRACK }
    if same(p, n, "metal") || has(p, n, "iron") || has(p, n, "copper") || same(p, n, "chain") || has(p, n, "lantern") || same(p, n, "anvil")
    || has(p, n, "netherite") || has(p, n, "lodestone") || has(p, n, "spawner") || has(p, n, "heavy_core") || has(p, n, "vault") { return MAT_METAL }
    if same(p, n, "wood") || ends(p, n, "_wood") || has(p, n, "hanging_sign") || same(p, n, "ladder") || same(p, n, "scaffolding")
    || has(p, n, "bookshelf") || same(p, n, "shelf") || same(p, n, "bamboo") || same(p, n, "stem") || same(p, n, "crop") { return MAT_WOOD }
    if same(p, n, "grass") || has(p, n, "leaves") || has(p, n, "vine") || has(p, n, "roots") || has(p, n, "moss") || has(p, n, "azalea")
    || has(p, n, "sapling") || has(p, n, "sprouts") || has(p, n, "fungus") || has(p, n, "berry") || has(p, n, "lily") || has(p, n, "petals")
    || has(p, n, "leaf_litter") || has(p, n, "dripleaf") || has(p, n, "spore") || has(p, n, "sculk") || has(p, n, "cobweb")
    || has(p, n, "frogspawn") || has(p, n, "wet_grass") || has(p, n, "nether_wart") || has(p, n, "wet_sponge") { return MAT_GRASS }
    return MAT_STONE
}

// Event id by name; a block sound of a type the bank does not have ("block.cherry_wood.step") falls back to the material event
// ("block.wood.step"). -1 = nothing to play.
fn mca_find(m: *mut McAudio, name: str) -> i32 {
    let nm: str = mca_event_name(name)
    let ev: i32 = engine.engine_find_event((*m).eng, nm)
    if ev >= 0 { return ev }
    let p: u64 = nm.p as u64
    let n: usize = nm.length()
    if !starts(p, n, "block.") || n < 9 { return 0 - 1 }
    var dot: usize = n - 1
    while dot > 6 && ld_b(p, dot) != 46 { dot = dot - 1 }
    if dot <= 6 || ld_b(p, dot) != 46 { return 0 - 1 }
    let mat: i32 = mca_type_material(p + 6 as u64, dot - 6)
    let mname: str = mca_material_name(mat)
    let alen: usize = n - dot - 1
    if alen == 0 || alen > 16 { return 0 - 1 }
    let tot: usize = 6 + mname.length() + 1 + alen
    let q: u64 = rt.heap_alloc(tot)
    if q == 0 { return 0 - 1 }
    rt.mem_copy(q, "block.".p as u64, 6)
    rt.mem_copy(q + 6 as u64, mname.p as u64, mname.length())
    rt.st8(q, 6 + mname.length(), 46 as u8)
    rt.mem_copy(q + (7 + mname.length()) as u64, p + (dot + 1) as u64, alen)
    let ev2: i32 = engine.engine_find_event((*m).eng, mk(q, tot))
    rt.heap_free(q, tot)
    return ev2
}

// Minecraft category name -> number (also "player"); -1 unknown
fn mca_category_of_name(p: u64, n: usize) -> i32 {
    if same(p, n, "master") { return CAT_MASTER }
    if same(p, n, "music") { return CAT_MUSIC }
    if same(p, n, "record") { return CAT_RECORD }
    if same(p, n, "weather") { return CAT_WEATHER }
    if same(p, n, "block") || same(p, n, "blocks") { return CAT_BLOCKS }
    if same(p, n, "hostile") { return CAT_HOSTILE }
    if same(p, n, "neutral") { return CAT_NEUTRAL }
    if same(p, n, "player") || same(p, n, "players") { return CAT_PLAYERS }
    if same(p, n, "ambient") { return CAT_AMBIENT }
    if same(p, n, "voice") { return CAT_VOICE }
    if same(p, n, "ui") { return CAT_UI }
    return 0 - 1
}

// category of a sound event by its name (the default of the game: sounds.json carries it, we guess from the prefix)
fn mca_category_of_event(p0: u64, n0: usize) -> i32 {
    var p: u64 = p0
    var n: usize = n0
    if starts(p, n, "minecraft:") {
        p = p + 10 as u64
        n = n - 10
    }
    if starts(p, n, "block.") { return CAT_BLOCKS }
    if starts(p, n, "ui.") { return CAT_UI }
    if starts(p, n, "music_disc.") { return CAT_RECORD }
    if starts(p, n, "music.") { return CAT_MUSIC }
    if starts(p, n, "weather.") || starts(p, n, "entity.lightning_bolt.") { return CAT_WEATHER }
    if starts(p, n, "ambient.") { return CAT_AMBIENT }
    if starts(p, n, "entity.player.") { return CAT_PLAYERS }
    if starts(p, n, "entity.") {
        if has(p, n, ".zombie") || has(p, n, ".skeleton") || has(p, n, ".creeper") || has(p, n, ".spider") || has(p, n, ".enderman")
        || has(p, n, ".witch") || has(p, n, ".blaze") || has(p, n, ".ghast") || has(p, n, ".phantom") || has(p, n, ".drowned")
        || has(p, n, ".husk") || has(p, n, ".stray") || has(p, n, ".pillager") || has(p, n, ".vindicator") || has(p, n, ".warden")
        || has(p, n, ".wither") || has(p, n, ".slime") || has(p, n, ".guardian") || has(p, n, ".silverfish") {
            return CAT_HOSTILE
        }
        return CAT_NEUTRAL
    }
    return CAT_BLOCKS
}

// "block.<type>.<action>" into the scratch buffer, returns it as str
fn mca_block_sound_name(m: *mut McAudio, mat: i32, act: i32) -> str {
    rt.buf_clear(&(*m).name)
    let a: str = "block."
    rt.buf_push_bytes(&(*m).name, a.p as u64, a.length())
    let t: str = mca_material_name(mat)
    rt.buf_push_bytes(&(*m).name, t.p as u64, t.length())
    rt.buf_push(&(*m).name, 46 as u8)
    let c: str = mca_action_name(act)
    rt.buf_push_bytes(&(*m).name, c.p as u64, c.length())
    return mk(rt.buf_data(&(*m).name) as u64, rt.buf_len(&(*m).name))
}

// the event name without "minecraft:"
fn mca_event_name(name: str) -> str {
    if starts(name.p as u64, name.length(), "minecraft:") {
        return mk(name.p as u64 + 10 as u64, name.length() - 10)
    }
    return name
}

// ------------------------------------------------------------------------------------------------ buses

fn mca_category_bus(cat: i32) -> str {
    if cat == CAT_MASTER { return "master" }
    if cat == CAT_MUSIC { return "mc.music" }
    if cat == CAT_RECORD { return "mc.record" }
    if cat == CAT_WEATHER { return "mc.weather" }
    if cat == CAT_BLOCKS { return "mc.blocks" }
    if cat == CAT_HOSTILE { return "mc.hostile" }
    if cat == CAT_NEUTRAL { return "mc.neutral" }
    if cat == CAT_PLAYERS { return "mc.players" }
    if cat == CAT_AMBIENT { return "mc.ambient" }
    if cat == CAT_VOICE { return "mc.voice" }
    return "mc.ui"
}

fn category_parent(cat: i32) -> str {
    if cat == CAT_MASTER { return "" }
    if cat == CAT_MUSIC || cat == CAT_RECORD { return "music" }
    if cat == CAT_UI { return "ui" }
    return "sfx"
}

fn make_buses(m: *mut McAudio) {
    let e: *mut engine.Engine = (*m).eng
    bank.bank_setup_buses(e)
    var c: i32 = 1
    while c < CAT_COUNT {
        engine.engine_ensure_bus(e, mca_category_bus(c), category_parent(c))
        c = c + 1
    }
}

// A new Minecraft audio layer on `e` (the engine outlives it). Creates the buses.
fn mca_new(e: *mut engine.Engine) -> McAudio {
    var m: McAudio = McAudio {
        eng: e, ox: 0.0, oy: 0.0, oz: 0.0, lx: 0.0, ly: 0.0, lz: 0.0, has_listener: false,
        cat_vol: [1.0; 11], muted: false, tuned: [0 as u64; 8],
        s_handle: [0 as u32; 128], s_ent: [0 - 1; 128], s_cat: [0; 128], s_ev: [0 - 1; 128],
        s_x: [0.0; 128], s_y: [0.0; 128], s_z: [0.0; 128], dt: 0.016,
        name: rt.buf_new(), sid_tab: 0, sid_cap: 0, sid_names: rt.buf_new(),
        n_played: 0 as u64, n_missing: 0 as u64, n_culled: 0 as u64, n_muted: 0 as u64, n_full: 0 as u64, n_rebase: 0 as u64,
        n_pkt: 0 as u64, n_bad: 0 as u64, log: false, log_frame: 0 as u64, bc_sounds: false,
    }
    make_buses(&m)
    return m
}

fn mca_free(m: *mut McAudio) {
    rt.buf_free(&(*m).name)
    rt.buf_free(&(*m).sid_names)
    if (*m).sid_tab != 0 {
        rt.heap_free((*m).sid_tab, (*m).sid_cap * 8)
    }
    (*m).sid_tab = 0
    (*m).sid_cap = 0
}

// Volume 0..1 of a category (a bus volume: running voices follow). Master = the master bus.
fn mca_set_category_volume(m: *mut McAudio, cat: i32, v: f32) {
    if cat < 0 || cat >= CAT_COUNT { return }
    let x: f32 = clampf(v, 0.0, 1.0)
    (*m).cat_vol[cat as usize] = x
    engine.engine_set_bus_volume((*m).eng, mca_category_bus(cat), x)
}

fn mca_get_category_volume(m: *mut McAudio, cat: i32) -> f32 {
    if cat < 0 || cat >= CAT_COUNT { return 0.0 }
    return (*m).cat_vol[cat as usize]
}

// on = one stdout line `audiolog frame=.. ev=.. cat=.. vol=.. pitch=..` per started voice; frame = host position (field log_frame)
fn mca_set_log(m: *mut McAudio, on: bool) { (*m).log = on }

// Mute everything (master bus flag, running voices go quiet at once; new sounds are not even started).
fn mca_set_muted(m: *mut McAudio, on: bool) {
    (*m).muted = on
    engine.engine_set_bus_mute((*m).eng, "master", on)
}

fn mca_is_muted(m: *mut McAudio) -> bool { return (*m).muted }

// Loads a bank (audio.bank refuses while the audio thread runs) and re-applies buses + volumes. Events of the new bank
// get the Minecraft distance model at their first play.
fn mca_bank_load_text(m: *mut McAudio, b: *mut bank.Bank, p: u64, n: usize, dir: str) -> i32 {
    let r: i32 = bank.bank_load_text(b, (*m).eng, p, n, dir)
    after_bank(m)
    return r
}

fn mca_bank_load_file(m: *mut McAudio, b: *mut bank.Bank, path: str) -> i32 {
    let r: i32 = bank.bank_load_file(b, (*m).eng, path)
    after_bank(m)
    return r
}

fn after_bank(m: *mut McAudio) {
    var i: usize = 0
    while i < 8 {
        (*m).tuned[i] = 0 as u64
        i = i + 1
    }
    make_buses(m)
    var c: i32 = 0
    while c < CAT_COUNT {
        engine.engine_set_bus_volume((*m).eng, mca_category_bus(c), (*m).cat_vol[c as usize])
        c = c + 1
    }
}

// ------------------------------------------------------------------------------------------ listener / origin

fn to_engine(m: *mut McAudio, w: f64, o: f64) -> f32 {
    return (w - o) as f32
}

fn send_listener(m: *mut McAudio, cam: *mut mc_camera.Camera, vx: f64, vy: f64, vz: f64) {
    engine.engine_set_listener((*m).eng, to_engine(m, (*cam).x, (*m).ox), to_engine(m, (*cam).y, (*m).oy), to_engine(m, (*cam).z, (*m).oz),
        (*cam).fx as f32, (*cam).fy as f32, (*cam).fz as f32, (*cam).ux as f32, (*cam).uy as f32, (*cam).uz as f32,
        vx as f32, vy as f32, vz as f32)
}

fn resend_sources(m: *mut McAudio) {
    var i: usize = 0
    while i < MAX_SOURCES {
        if (*m).s_handle[i] != 0 as u32 {
            engine.engine_set_position((*m).eng, (*m).s_handle[i], to_engine(m, (*m).s_x[i], (*m).ox), to_engine(m, (*m).s_y[i], (*m).oy),
                to_engine(m, (*m).s_z[i], (*m).oz), 0.0, 0.0, 0.0)
        }
        i = i + 1
    }
}

// Listener = the camera (call mc_camera.camera_update first). `dt` = seconds since the last call, for the velocity.
fn mca_set_listener(m: *mut McAudio, cam: *mut mc_camera.Camera, dt: f64) {
    var vx: f64 = 0.0
    var vy: f64 = 0.0
    var vz: f64 = 0.0
    if (*m).has_listener && dt > 0.0001 {
        vx = ((*cam).x - (*m).lx) / dt
        vy = ((*cam).y - (*m).ly) / dt
        vz = ((*cam).z - (*m).lz) / dt
    }
    var moved: bool = false
    if !(*m).has_listener {
        (*m).ox = math.floor((*cam).x / REBASE_STEP) * REBASE_STEP
        (*m).oy = math.floor((*cam).y / REBASE_STEP) * REBASE_STEP
        (*m).oz = math.floor((*cam).z / REBASE_STEP) * REBASE_STEP
    } else if absd((*cam).x - (*m).ox) > REBASE_LIMIT || absd((*cam).y - (*m).oy) > REBASE_LIMIT || absd((*cam).z - (*m).oz) > REBASE_LIMIT {
        (*m).ox = math.floor((*cam).x / REBASE_STEP) * REBASE_STEP
        (*m).oy = math.floor((*cam).y / REBASE_STEP) * REBASE_STEP
        (*m).oz = math.floor((*cam).z / REBASE_STEP) * REBASE_STEP
        (*m).n_rebase = (*m).n_rebase + 1 as u64
        moved = true
    }
    (*m).lx = (*cam).x
    (*m).ly = (*cam).y
    (*m).lz = (*cam).z
    (*m).has_listener = true
    (*m).dt = dt
    send_listener(m, cam, vx, vy, vz)
    if moved {
        resend_sources(m)
    }
}

// Once per frame: listener, sources that follow entities, finished voices out of the table, engine_update.
fn mca_update(m: *mut McAudio, cam: *mut mc_camera.Camera, dt: f64) {
    mca_set_listener(m, cam, dt)
    engine.engine_update((*m).eng)
    var i: usize = 0
    while i < MAX_SOURCES {
        if (*m).s_handle[i] != 0 as u32 && !engine.engine_is_playing((*m).eng, (*m).s_handle[i]) {
            (*m).s_handle[i] = 0 as u32
        }
        i = i + 1
    }
}

// Moves the sources that belong to an entity (position + velocity from the entity store).
fn mca_update_entities(m: *mut McAudio, st: *mut mc_entity.Store) {
    var i: usize = 0
    while i < MAX_SOURCES {
        if (*m).s_handle[i] != 0 as u32 && (*m).s_ent[i] >= 0 {
            let en: *mut mc_entity.Entity = mc_entity.store_get(st, (*m).s_ent[i])
            if en as u64 != 0 {
                var vx: f64 = 0.0
                var vy: f64 = 0.0
                var vz: f64 = 0.0
                if (*m).dt > 0.0001 {
                    vx = ((*en).x - (*m).s_x[i]) / (*m).dt
                    vy = ((*en).y - (*m).s_y[i]) / (*m).dt
                    vz = ((*en).z - (*m).s_z[i]) / (*m).dt
                }
                (*m).s_x[i] = (*en).x
                (*m).s_y[i] = (*en).y
                (*m).s_z[i] = (*en).z
                engine.engine_set_position((*m).eng, (*m).s_handle[i], to_engine(m, (*en).x, (*m).ox), to_engine(m, (*en).y, (*m).oy),
                    to_engine(m, (*en).z, (*m).oz), vx as f32, vy as f32, vz as f32)
            }
        }
        i = i + 1
    }
}

// ------------------------------------------------------------------------------------------------ playing

fn tune_event(m: *mut McAudio, ev: i32) {
    if ev < 0 || ev >= 512 { return }
    let w: usize = (ev / 64) as usize
    let bit: u64 = 1 as u64 << ((ev % 64) as u64)
    if ((*m).tuned[w] & bit) != 0 as u64 { return }
    (*m).tuned[w] = (*m).tuned[w] | bit
    let d: *mut engine.EventDef = engine.engine_event((*m).eng, ev)
    if d as u64 == 0 { return }
    (*d).spatial = true // the engine only reads the event's flag (Aulos); a 2D play of the same event would pan too
    (*d).min_distance = 1.0
    (*d).max_distance = DEFAULT_RANGE
    (*d).rolloff = 1
}

// Range (blocks) of one event, e.g. 64 for thunder. The event must exist in the bank.
fn mca_set_range(m: *mut McAudio, name: str, range: f32) -> bool {
    let ev: i32 = engine.engine_find_event((*m).eng, mca_event_name(name))
    if ev < 0 || range <= 1.0 { return false }
    tune_event(m, ev)
    let d: *mut engine.EventDef = engine.engine_event((*m).eng, ev)
    (*d).max_distance = range
    return true
}

fn remember(m: *mut McAudio, h: u32, ev: i32, cat: i32, ent: i32, x: f64, y: f64, z: f64) {
    var i: usize = 0
    while i < MAX_SOURCES {
        if (*m).s_handle[i] == 0 as u32 {
            (*m).s_handle[i] = h
            (*m).s_ent[i] = ent
            (*m).s_cat[i] = cat
            (*m).s_ev[i] = ev
            (*m).s_x[i] = x
            (*m).s_y[i] = y
            (*m).s_z[i] = z
            return
        }
        i = i + 1
    }
    (*m).n_full = (*m).n_full + 1 as u64
}

// Plays an engine event id. spatial: at the world point (x, y, z), else 2D. Returns the handle, 0 = nothing started
// (muted, unknown event, out of range).
fn mca_play_event(m: *mut McAudio, ev: i32, cat: i32, spatial: bool, ent: i32, x: f64, y: f64, z: f64, volume: f32, pitch: f32) -> u32 {
    if ev < 0 {
        (*m).n_missing = (*m).n_missing + 1 as u64
        return 0 as u32
    }
    if (*m).muted || volume <= 0.0 || (*m).cat_vol[cat as usize] <= 0.0 {
        (*m).n_muted = (*m).n_muted + 1 as u64
        return 0 as u32
    }
    let e: *mut engine.Engine = (*m).eng
    let bus: i32 = engine.engine_bus_id(e, mca_category_bus(cat))
    var h: u32 = 0 as u32
    if spatial {
        tune_event(m, ev)
        let d: *mut engine.EventDef = engine.engine_event(e, ev)
        let dx: f32 = (x - (*m).lx) as f32
        let dy: f32 = (y - (*m).ly) as f32
        let dz: f32 = (z - (*m).lz) as f32
        if (*m).has_listener && vlen(dx, dy, dz) >= (*d).max_distance {
            (*m).n_culled = (*m).n_culled + 1 as u64
            return 0 as u32
        }
        h = engine.engine_play_3d(e, ev, bus, to_engine(m, x, (*m).ox), to_engine(m, y, (*m).oy), to_engine(m, z, (*m).oz))
    } else {
        h = engine.engine_play(e, ev, bus)
    }
    if h == 0 as u32 { return 0 as u32 }
    engine.engine_set_volume(e, h, clampf(volume, 0.0, 1.0))
    engine.engine_set_pitch(e, h, pitch)
    (*m).n_played = (*m).n_played + 1 as u64
    if (*m).log {
        let d: *mut engine.EventDef = engine.engine_event(e, ev)
        let nm: str = mk((*d).name_p, (*d).name_n)
        let fr: u64 = (*m).log_frame
        let vp: i64 = (volume * 100.0) as i64
        let pp: i64 = (pitch * 100.0) as i64
        var sp: i64 = 0
        if spatial { sp = 1 }
        io.fmt_print(f"audiolog frame={fr} ev={nm} cat={cat} vol100={vp} pitch100={pp} spatial={sp}\n")
    }
    if spatial {
        remember(m, h, ev, cat, ent, x, y, z)
    }
    return h
}

// By name ("minecraft:entity.zombie.ambient" or "entity.zombie.ambient") at a world point.
fn mca_play_at(m: *mut McAudio, name: str, cat: i32, x: f64, y: f64, z: f64, volume: f32, pitch: f32) -> u32 {
    let ev: i32 = mca_find(m, name)
    return mca_play_event(m, ev, cat, true, 0 - 1, x, y, z, volume, pitch)
}

// By name, bound to an entity of the store: the voice follows it (mca_update_entities). 0 when the entity is unknown.
fn mca_play_entity(m: *mut McAudio, st: *mut mc_entity.Store, id: i32, name: str, cat: i32, volume: f32, pitch: f32) -> u32 {
    let en: *mut mc_entity.Entity = mc_entity.store_get(st, id)
    if en as u64 == 0 { return 0 as u32 }
    let ev: i32 = mca_find(m, name)
    return mca_play_event(m, ev, cat, true, id, (*en).x, (*en).y, (*en).z, volume, pitch)
}

// Menu click etc.: 2D on the ui bus.
fn mca_play_ui(m: *mut McAudio, name: str, volume: f32, pitch: f32) -> u32 {
    let ev: i32 = mca_find(m, name)
    return mca_play_event(m, ev, CAT_UI, false, 0 - 1, 0.0, 0.0, 0.0, volume, pitch)
}

fn mca_stop_entity(m: *mut McAudio, id: i32, fade: f32) {
    var i: usize = 0
    while i < MAX_SOURCES {
        if (*m).s_handle[i] != 0 as u32 && (*m).s_ent[i] == id {
            engine.engine_stop((*m).eng, (*m).s_handle[i], fade)
            (*m).s_handle[i] = 0 as u32
        }
        i = i + 1
    }
}

fn mca_stop_all(m: *mut McAudio, fade: f32) {
    engine.engine_stop_all((*m).eng, fade)
    var i: usize = 0
    while i < MAX_SOURCES {
        (*m).s_handle[i] = 0 as u32
        i = i + 1
    }
}

// ------------------------------------------------------------------------------------------------ blocks

// block state id at a block position, -1 when the chunk (or section) is not loaded. min_y = bottom of the dimension (-64).
fn mca_state_at(w: *mut mc_world.World, min_y: i32, x: i32, y: i32, z: i32) -> i32 {
    let cp: u64 = mc_world.world_find(w, mc_world.block_to_chunk(x), mc_world.block_to_chunk(z))
    if cp == 0 { return 0 - 1 }
    let c: *mut mc_chunk.Chunk = cp as *mut mc_chunk.Chunk
    let si: i32 = mc_world.section_index(y, min_y)
    if si < 0 || si as usize >= (*c).nsec { return 0 - 1 }
    let sec: *mut mc_chunk.Section = mc_chunk.chunk_section(c, si as usize)
    let lx: i32 = mc_world.block_in_chunk(x)
    let lz: i32 = mc_world.block_in_chunk(z)
    let ly: i32 = mc_world.floor_mod(y, 16)
    return mc_chunk.container_get(&(*sec).blocks, ((ly * 16 + lz) * 16 + lx) as usize) as i32
}

// Sound of a block state: step / break / place / hit / fall at the block centre. Returns the handle (0 = none).
fn mca_block_sound(m: *mut McAudio, reg: *mut mc_registry.Registry, state: i32, act: i32, bx: i32, by: i32, bz: i32) -> u32 {
    if state < 0 { return 0 as u32 }
    let b: i32 = mc_registry.reg_block_of_state(reg, state)
    if b < 0 { return 0 as u32 }
    var n: usize = 0
    let p: u64 = mc_registry.reg_block_name(reg, b, &n)
    let mat: i32 = mca_material_of_name(p, n)
    if mat == MAT_NONE { return 0 as u32 }
    let nm: str = mca_block_sound_name(m, mat, act)
    let ev: i32 = engine.engine_find_event((*m).eng, nm)
    return mca_play_event(m, ev, CAT_BLOCKS, true, 0 - 1, (bx as f64) + 0.5, (by as f64) + 0.5, (bz as f64) + 0.5,
        action_volume(act), action_pitch(act))
}

// Footstep / landing state of one walking entity (the player).
struct Walker {
    dist: f64,
    px: f64, pz: f64,
    started: bool,
    was_ground: bool,
    top: f64, // highest y since the feet left the ground
}

fn mca_walker_new() -> Walker {
    return Walker { dist: 0.0, px: 0.0, pz: 0.0, started: false, was_ground: true, top: 0.0 }
}

// Call once per tick with the feet position. Plays a step each 1/0.6 blocks of horizontal travel on the ground
// (not when sneaking) and a fall sound when landing after more than 1 block. Returns the number of sounds started.
fn mca_walk(m: *mut McAudio, w: *mut Walker, reg: *mut mc_registry.Registry, world: *mut mc_world.World, min_y: i32,
    x: f64, y: f64, z: f64, on_ground: bool, sneaking: bool) -> i32 {
    var started: i32 = 0
    if !(*w).started {
        (*w).started = true
        (*w).px = x
        (*w).pz = z
        (*w).top = y
        (*w).was_ground = on_ground
        return 0
    }
    let dx: f64 = x - (*w).px
    let dz: f64 = z - (*w).pz
    (*w).px = x
    (*w).pz = z
    let bx: i32 = math.floor(x) as i32
    let bz: i32 = math.floor(z) as i32
    let by: i32 = math.floor(y - 0.2) as i32
    if !on_ground {
        if (*w).was_ground || y > (*w).top { (*w).top = y }
        (*w).was_ground = false
        return 0
    }
    if !(*w).was_ground {
        let fall: f64 = (*w).top - y
        (*w).was_ground = true
        if fall > 1.0 {
            let st: i32 = mca_state_at(world, min_y, bx, by, bz)
            if mca_block_sound(m, reg, st, ACT_FALL, bx, by, bz) != 0 as u32 { started = started + 1 }
        }
        (*w).dist = 0.0
        (*w).top = y
        return started
    }
    (*w).top = y
    (*w).dist = (*w).dist + math.sqrt(dx * dx + dz * dz)
    if (*w).dist >= STEP_DISTANCE {
        (*w).dist = (*w).dist - STEP_DISTANCE
        if (*w).dist >= STEP_DISTANCE { (*w).dist = 0.0 }
        if !sneaking {
            let st: i32 = mca_state_at(world, min_y, bx, by, bz)
            if mca_block_sound(m, reg, st, ACT_STEP, bx, by, bz) != 0 as u32 { started = started + 1 }
        }
    }
    return started
}

// ---------------------------------------------------------------------------------------------- sound ids

// numeric sound id -> event name (as the version's registry lists it); the packets carry the id
fn mca_sound_id_set(m: *mut McAudio, id: i32, name: str) -> bool {
    if id < 0 || id > 65535 || name.length() > 255 { return false }
    if id as usize >= (*m).sid_cap {
        var cap: usize = (*m).sid_cap
        if cap == 0 { cap = 256 }
        while cap <= id as usize {
            cap = cap * 2
        }
        let t: u64 = rt.heap_alloc(cap * 8)
        if t == 0 { return false }
        rt.mem_set(t, 0 as u8, cap * 8)
        if (*m).sid_tab != 0 {
            rt.mem_copy(t, (*m).sid_tab, (*m).sid_cap * 8)
            rt.heap_free((*m).sid_tab, (*m).sid_cap * 8)
        }
        (*m).sid_tab = t
        (*m).sid_cap = cap
    }
    let off: usize = rt.buf_len(&(*m).sid_names)
    rt.buf_push_bytes(&(*m).sid_names, name.p as u64, name.length())
    rt.st32((*m).sid_tab, id as usize * 2, off as u32)
    rt.st32((*m).sid_tab, id as usize * 2 + 1, (name.length() + 1) as u32) // +1: 0 = unknown
    return true
}

// name of a registered id, "" when unknown
fn mca_sound_name(m: *mut McAudio, id: i32) -> str {
    if id < 0 || id as usize >= (*m).sid_cap { return "" }
    let l: u32 = rt.ld32((*m).sid_tab, id as usize * 2 + 1)
    if l == 0 as u32 { return "" }
    return mk(rt.buf_ptr(&(*m).sid_names) + rt.ld32((*m).sid_tab, id as usize * 2) as u64, (l - 1 as u32) as usize)
}

// -------------------------------------------------------------------------------------------- packet decoders

struct SoundPkt {
    id: i32, // registry id (soundId - 1), -1 for an inline (named) sound
    name_p: u64, name_n: usize, // inline name: points INTO the packet body
    has_range: bool, range: f32,
    category: i32,
    entity: i32, // -1 = a point
    x: f64, y: f64, z: f64, // block units (the wire has 1/8)
    volume: f32, pitch: f32,
    seed: i64,
}

struct StopPkt {
    flags: i32,
    category: i32, // -1 = all
    name_p: u64, name_n: usize, // n = 0: all names
}

fn empty_sound() -> SoundPkt {
    return SoundPkt { id: 0 - 1, name_p: 0, name_n: 0, has_range: false, range: 0.0, category: 0, entity: 0 - 1,
        x: 0.0, y: 0.0, z: 0.0, volume: 1.0, pitch: 1.0, seed: 0 as i64 }
}

// ItemSoundHolder: varint 0 = inline (identifier, optional float range), else registry id + 1
fn rd_holder(r: *mut mc_packet.Reader, o: *mut SoundPkt) {
    let sid: i32 = mc_packet.rd_varint(r)
    if sid < 0 {
        mc_packet.rd_fail(r, mc_packet.PE_NEGATIVE)
        return
    }
    if sid == 0 {
        var n: usize = 0
        (*o).name_p = mc_packet.rd_identifier(r, &n)
        (*o).name_n = n
        (*o).id = 0 - 1
        if mc_packet.rd_optional(r) {
            (*o).has_range = true
            (*o).range = mc_packet.rd_f32(r)
        }
    } else {
        (*o).id = sid - 1
    }
}

// Sound Effect (S2C, 1.20.1): holder, category, x y z (i32, 1/8 block), volume, pitch, seed. false = broken packet.
fn mca_decode_sound_effect(body: u64, n: usize, o: *mut SoundPkt) -> bool {
    var r: mc_packet.Reader = mc_packet.Reader { b: bytes.bytes_new(), err: 0 as u32 }
    mc_packet.reader_init(&r, body, n)
    *o = empty_sound()
    rd_holder(&r, o)
    (*o).category = mc_packet.rd_varint(&r)
    (*o).x = (mc_packet.rd_i32(&r) as f64) / 8.0
    (*o).y = (mc_packet.rd_i32(&r) as f64) / 8.0
    (*o).z = (mc_packet.rd_i32(&r) as f64) / 8.0
    (*o).volume = mc_packet.rd_f32(&r)
    (*o).pitch = mc_packet.rd_f32(&r)
    (*o).seed = mc_packet.rd_i64(&r)
    if !mc_packet.rd_ok(&r) || mc_packet.rd_remaining(&r) != 0 { return false }
    if (*o).category < 0 || (*o).category > CAT_VOICE { return false }
    return true
}

// Entity Sound Effect (S2C): holder, category, entity id (varint), volume, pitch, seed.
fn mca_decode_entity_sound(body: u64, n: usize, o: *mut SoundPkt) -> bool {
    var r: mc_packet.Reader = mc_packet.Reader { b: bytes.bytes_new(), err: 0 as u32 }
    mc_packet.reader_init(&r, body, n)
    *o = empty_sound()
    rd_holder(&r, o)
    (*o).category = mc_packet.rd_varint(&r)
    (*o).entity = mc_packet.rd_varint(&r)
    (*o).volume = mc_packet.rd_f32(&r)
    (*o).pitch = mc_packet.rd_f32(&r)
    (*o).seed = mc_packet.rd_i64(&r)
    if !mc_packet.rd_ok(&r) || mc_packet.rd_remaining(&r) != 0 { return false }
    if (*o).category < 0 || (*o).category > CAT_VOICE || (*o).entity < 0 { return false }
    return true
}

// Stop Sound (S2C): flags (1 = category, 2 = sound), [category varint], [identifier].
fn mca_decode_stop_sound(body: u64, n: usize, o: *mut StopPkt) -> bool {
    var r: mc_packet.Reader = mc_packet.Reader { b: bytes.bytes_new(), err: 0 as u32 }
    mc_packet.reader_init(&r, body, n)
    (*o).flags = mc_packet.rd_i8(&r) as i32
    (*o).category = 0 - 1
    (*o).name_p = 0
    (*o).name_n = 0
    if ((*o).flags & 1) != 0 {
        (*o).category = mc_packet.rd_varint(&r)
    }
    if ((*o).flags & 2) != 0 {
        var l: usize = 0
        (*o).name_p = mc_packet.rd_identifier(&r, &l)
        (*o).name_n = l
    }
    if !mc_packet.rd_ok(&r) || mc_packet.rd_remaining(&r) != 0 { return false }
    if (*o).flags < 0 || (*o).flags > 3 { return false }
    if (*o).category > CAT_VOICE { return false }
    return true
}

// Plays a decoded packet. Unknown numeric id (M2) = silence. Entity sounds need the entity in the store.
fn mca_apply_sound(m: *mut McAudio, p: *mut SoundPkt, st: *mut mc_entity.Store) -> u32 {
    var nm: str = ""
    if (*p).id >= 0 {
        nm = mca_sound_name(m, (*p).id)
    } else {
        nm = mk((*p).name_p, (*p).name_n)
    }
    if nm.length() == 0 {
        (*m).n_missing = (*m).n_missing + 1 as u64
        return 0 as u32
    }
    if (*p).entity >= 0 {
        return mca_play_entity(m, st, (*p).entity, nm, (*p).category, (*p).volume, (*p).pitch)
    }
    return mca_play_at(m, nm, (*p).category, (*p).x, (*p).y, (*p).z, (*p).volume, (*p).pitch)
}

// Stop Sound: stops the live voices that match category and / or name. Returns how many.
fn mca_apply_stop(m: *mut McAudio, p: *mut StopPkt) -> i32 {
    var ev: i32 = 0 - 1
    var by_name: bool = false
    if (*p).name_n > 0 {
        by_name = true
        ev = mca_find(m, mk((*p).name_p, (*p).name_n))
    }
    var k: i32 = 0
    var i: usize = 0
    while i < MAX_SOURCES {
        if (*m).s_handle[i] != 0 as u32 {
            var hit: bool = true
            if (*p).category >= 0 && (*m).s_cat[i] != (*p).category { hit = false }
            if by_name && (*m).s_ev[i] != ev { hit = false }
            if hit {
                engine.engine_stop((*m).eng, (*m).s_handle[i], 0.0)
                (*m).s_handle[i] = 0 as u32
                k = k + 1
            }
        }
        i = i + 1
    }
    return k
}

// ------------------------------------------------------------------------- sound table (generated per version)

// Loads the id -> name table of a version: `blob` is SND_BLOB.p of lib/mc/vNNN/mc_snd_vNNN.fi (names, NUL terminated,
// registry order), `first` = SND_FIRST (registry id of entry 0). Returns how many names were stored.
fn mca_sound_table_load(m: *mut McAudio, blob: u64, count: usize, first: i32) -> usize {
    var off: usize = 0
    var i: usize = 0
    while i < count {
        var n: usize = 0
        while ld_b(blob, off + n) != 0 as u8 {
            n = n + 1
        }
        if !mca_sound_id_set(m, first + (i as i32), mk(blob + off as u64, n)) { return i }
        off = off + n + 1
        i = i + 1
    }
    return count
}

// -------------------------------------------------------------------------- versioned sound packets

// Wire layouts of the sound packets (the field lists are in minecraft-data protocol.json):
//   SF_LEGACY  protocol <= 47 (1.8): only Named Sound Effect: name, x y z (i32 1/8), volume f32, pitch u8 (/63), no category
//   SF_CLASSIC 210..760 (1.10 - 1.19.2): Sound Effect = varint id; Named = identifier; category varint; x y z;
//              volume f32; pitch f32; seed i64 from 759 (1.19). Entity Sound Effect (1.14+) = id, category, entity varint, volume, pitch
//   SF_HOLDER  761+ (1.19.3+): holder (id + 1 or inline name + range), category, ..., seed (mca_decode_sound_effect)
const SF_NONE: i32 = 0
const SF_LEGACY: i32 = 1
const SF_CLASSIC: i32 = 2
const SF_HOLDER: i32 = 3
const SK_SOUND: i32 = 0
const SK_NAMED: i32 = 1
const SK_ENTITY: i32 = 2

fn mca_sound_format(proto: i32) -> i32 {
    if proto <= 0 { return SF_NONE }
    if proto <= 47 { return SF_LEGACY }
    if proto < 210 { return SF_NONE } // 1.9 - 1.9.4: byte pitch, not checked
    if proto < 761 { return SF_CLASSIC }
    return SF_HOLDER
}

// Decodes one sound packet body of `kind` (SK_*) in the layout `fmt` (mca_sound_format of the protocol). false = broken
// / unsupported. An inline name points into `body`.
fn mca_decode_sound_v(fmt: i32, proto: i32, kind: i32, body: u64, n: usize, o: *mut SoundPkt) -> bool {
    if fmt == SF_HOLDER {
        if kind == SK_SOUND { return mca_decode_sound_effect(body, n, o) }
        if kind == SK_ENTITY { return mca_decode_entity_sound(body, n, o) }
        return false
    }
    if fmt != SF_LEGACY && fmt != SF_CLASSIC { return false }
    if fmt == SF_LEGACY && kind != SK_NAMED { return false }
    var r: mc_packet.Reader = mc_packet.Reader { b: bytes.bytes_new(), err: 0 as u32 }
    mc_packet.reader_init(&r, body, n)
    *o = empty_sound()
    if kind == SK_NAMED {
        var l: usize = 0
        (*o).name_p = mc_packet.rd_identifier(&r, &l)
        (*o).name_n = l
    } else {
        let sid: i32 = mc_packet.rd_varint(&r)
        if sid < 0 { mc_packet.rd_fail(&r, mc_packet.PE_NEGATIVE) }
        (*o).id = sid
    }
    if fmt == SF_CLASSIC {
        (*o).category = mc_packet.rd_varint(&r)
    }
    if kind == SK_ENTITY {
        (*o).entity = mc_packet.rd_varint(&r)
    } else {
        (*o).x = (mc_packet.rd_i32(&r) as f64) / 8.0
        (*o).y = (mc_packet.rd_i32(&r) as f64) / 8.0
        (*o).z = (mc_packet.rd_i32(&r) as f64) / 8.0
    }
    (*o).volume = mc_packet.rd_f32(&r)
    if fmt == SF_LEGACY {
        (*o).pitch = (mc_packet.rd_u8(&r) as f32) / 63.0
    } else {
        (*o).pitch = mc_packet.rd_f32(&r)
    }
    if fmt == SF_CLASSIC && proto >= 759 {
        (*o).seed = mc_packet.rd_i64(&r)
    }
    if !mc_packet.rd_ok(&r) || mc_packet.rd_remaining(&r) != 0 { return false }
    if fmt == SF_LEGACY {
        (*o).category = mca_category_of_event((*o).name_p, (*o).name_n)
    }
    if (*o).category < 0 || (*o).category > CAT_VOICE { return false }
    if (*o).entity < 0 && kind == SK_ENTITY { return false }
    return true
}

// World event (effect id) -> sound event name, "" = none. Only the sounds the client itself makes for an event.
fn world_event_name(eff: i32) -> str {
    if eff == 1000 { return "block.dispenser.dispense" }
    if eff == 1001 { return "block.dispenser.fail" }
    if eff == 1002 { return "block.dispenser.launch" }
    if eff == 1005 { return "block.iron_door.open" }
    if eff == 1006 { return "block.wooden_door.open" }
    if eff == 1007 { return "block.wooden_trapdoor.open" }
    if eff == 1008 { return "block.fence_gate.open" }
    if eff == 1009 { return "block.fire.extinguish" }
    if eff == 1011 { return "block.iron_door.close" }
    if eff == 1012 { return "block.wooden_door.close" }
    if eff == 1013 { return "block.wooden_trapdoor.close" }
    if eff == 1014 { return "block.fence_gate.close" }
    if eff == 1036 { return "block.iron_trapdoor.open" }
    if eff == 1037 { return "block.iron_trapdoor.close" }
    return ""
}

// World event 2001 = block break (data = block state, flattened versions) -> break sound of that block; 1000.. = see above.
// `reg` may be null for everything but 2001. Returns the voice handle (0 = none).
fn mca_world_event_sound(m: *mut McAudio, reg: *mut mc_registry.Registry, eff: i32, data: i32, bx: i32, by: i32, bz: i32) -> u32 {
    if eff == 2001 {
        if reg as u64 == 0 { return 0 as u32 }
        return mca_block_sound(m, reg, data, ACT_BREAK, bx, by, bz)
    }
    let nm: str = world_event_name(eff)
    if nm.length() == 0 { return 0 as u32 }
    return mca_play_at(m, nm, CAT_BLOCKS, (bx as f64) + 0.5, (by as f64) + 0.5, (bz as f64) + 0.5, 1.0, 1.0)
}

// Client dispatch: call for every play packet (server to client) with its wire id and the body cursor. Returns true when
// `id` is a sound packet of this version (Sound Effect, Named Sound Effect, Entity Sound Effect, Stop Sound, World Event),
// which is then decoded and played / stopped; false = not ours (nothing consumed). A packet that does not parse changes
// nothing and counts in n_bad. The cursor is not moved.
fn mca_on_packet(m: *mut McAudio, v: *mut mc_version.Version, id: i32, body: *mut bytes.Bytes, st: *mut mc_entity.Store) -> bool {
    if id < 0 { return false }
    var kind: i32 = 0 - 1
    if (*v).sem[mc_sem.SEM_PLAY_S2C_SOUND_EFFECT] == id {
        kind = SK_SOUND
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_NAMED_SOUND_EFFECT] == id {
        kind = SK_NAMED
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_ENTITY_SOUND_EFFECT] == id {
        kind = SK_ENTITY
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_STOP_SOUND] == id {
        kind = 10
    } else if (*v).sem[mc_sem.SEM_PLAY_S2C_WORLD_EVENT] == id {
        kind = 11
    }
    if kind < 0 { return false }
    let pos: usize = bytes.bytes_pos(body)
    let n: usize = bytes.bytes_len(body) - pos
    let p: u64 = bytes.bytes_ptr(body) + pos as u64
    (*m).n_pkt = (*m).n_pkt + 1 as u64
    if kind <= SK_ENTITY {
        var sp: SoundPkt = empty_sound()
        if !mca_decode_sound_v(mca_sound_format((*v).protocol), (*v).protocol, kind, p, n, &sp) {
            (*m).n_bad = (*m).n_bad + 1 as u64
            return true
        }
        mca_apply_sound(m, &sp, st)
        return true
    }
    if kind == 10 {
        var stp: StopPkt = StopPkt { flags: 0, category: 0 - 1, name_p: 0, name_n: 0 }
        if !mca_decode_stop_sound(p, n, &stp) {
            (*m).n_bad = (*m).n_bad + 1 as u64
            return true
        }
        mca_apply_stop(m, &stp)
        return true
    }
    var r: mc_packet.Reader = mc_packet.Reader { b: bytes.bytes_new(), err: 0 as u32 }
    mc_packet.reader_init(&r, p, n)
    let eff: i32 = mc_packet.rd_i32(&r)
    var bx: i32 = 0
    var by: i32 = 0
    var bz: i32 = 0
    mc_packet.rd_position(&r, &bx, &by, &bz)
    let data: i32 = mc_packet.rd_i32(&r)
    mc_packet.rd_u8(&r)
    if !mc_packet.rd_ok(&r) || mc_packet.rd_remaining(&r) != 0 {
        (*m).n_bad = (*m).n_bad + 1 as u64
        return true
    }
    if eff == 2001 && mc_version.version_has(v, mc_version.FLAG_FLATTENING) {
        var reg: mc_registry.Registry = (*v).registry_of()
        mca_world_event_sound(m, &reg, eff, data, bx, by, bz)
    } else if eff != 2001 {
        mca_world_event_sound(m, 0 as *mut mc_registry.Registry, eff, data, bx, by, bz)
    }
    return true
}

// ------------------------------------------------------------------------- block changes (optional)

fn state_material(reg: *mut mc_registry.Registry, state: i32) -> i32 {
    if state < 0 { return MAT_NONE }
    let b: i32 = mc_registry.reg_block_of_state(reg, state)
    if b < 0 { return MAT_NONE }
    var n: usize = 0
    let p: u64 = mc_registry.reg_block_name(reg, b, &n)
    return mca_material_of_name(p, n)
}

// Block change heuristics (off by default: a vanilla server already sends the break event / place sound, a second sound
// would double it): for servers or hosts that predict. Solid -> air = break sound of the old block, air -> solid = place
// sound of the new one. Call BEFORE the change is applied to the world (the old state is read from it). Returns the handle.
fn mca_set_block_change_sounds(m: *mut McAudio, on: bool) {
    (*m).bc_sounds = on
}

fn mca_on_block_change(m: *mut McAudio, reg: *mut mc_registry.Registry, world: *mut mc_world.World, min_y: i32,
    x: i32, y: i32, z: i32, new_state: i32) -> u32 {
    if !(*m).bc_sounds { return 0 as u32 }
    let old: i32 = mca_state_at(world, min_y, x, y, z)
    if old == new_state { return 0 as u32 }
    let om: i32 = state_material(reg, old)
    let nm: i32 = state_material(reg, new_state)
    if om != MAT_NONE && nm == MAT_NONE { return mca_block_sound(m, reg, old, ACT_BREAK, x, y, z) }
    if om == MAT_NONE && nm != MAT_NONE { return mca_block_sound(m, reg, new_state, ACT_PLACE, x, y, z) }
    return 0 as u32
}

// ------------------------------------------------------------------------------------------ ambient

// Cave ambience (approximation of the game's mood sound): "mood" rises while the listener is in the dark and falls in the
// light; at 1.0 `ambient.cave` plays 4..16 blocks from the listener and the mood starts again. The host decides `dark`
// (light level at the feet). Deterministic: own LCG, no clock.
struct Ambient {
    mood: f64,
    rng: i64,
    n_played: u32,
}

fn mca_ambient_new(seed: i64) -> Ambient {
    return Ambient { mood: 0.0, rng: seed % 2147483648 as i64, n_played: 0 as u32 }
}

fn ambient_next(a: *mut Ambient) -> f64 {
    (*a).rng = ((*a).rng * 1103515245 as i64 + 12345 as i64) % 2147483648 as i64
    return ((*a).rng as f64) / 2147483648.0
}

// dt in seconds. Returns the voice handle when the cave sound started (0 = none).
fn mca_ambient_tick(m: *mut McAudio, a: *mut Ambient, dark: bool, dt: f64) -> u32 {
    if dark {
        (*a).mood = (*a).mood + dt / 60.0
    } else {
        (*a).mood = (*a).mood - dt / 20.0
        if (*a).mood < 0.0 { (*a).mood = 0.0 }
    }
    if (*a).mood < 1.0 || !(*m).has_listener { return 0 as u32 }
    (*a).mood = 0.0
    let ang: f64 = ambient_next(a) * 6.283185307179586
    let dist: f64 = 4.0 + ambient_next(a) * 12.0
    let h: u32 = mca_play_at(m, "ambient.cave", CAT_AMBIENT, (*m).lx + math.cos(ang) * dist, (*m).ly + (ambient_next(a) - 0.5) * 4.0,
        (*m).lz + math.sin(ang) * dist, 1.0, 1.0)
    if h != 0 as u32 { (*a).n_played = (*a).n_played + 1 as u32 }
    return h
}
