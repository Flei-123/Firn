// lib/mc/mc_model_pick.fi -- pick table for resource pack models (r236b): ray cast + selection box from the BAKED model quads (mc_model_mesh) instead of
// the whole voxel. OPT-IN: mcplay uses it only with MCPLAY_MODELS=1; without a ModelSet the caller keeps mc_input.input_pick (bit identical).
//
//     var hit: mc_input.Pick = ...
//     if mc_model_pick.mp_pick_camera(&world, min_y, &itb, &ms, &cam, reach, &hit) { ... }          // same contract as mc_input.input_pick_camera
//     mc_model_pick.mp_draw_box(&raster, &ms, &hit, rgba)                                             // model bounds instead of the unit cube
//
// RULES
//  * A MODEL cell (ms_kind == K_MODEL, i.e. the cells the model mesher draws) is hit only where the ray crosses one of its quads (two triangles per
//    quad, both sides, in block local coordinates). The ray passes through the empty part of a stair / slab / fence and goes on to the next cell.
//    The pick flag of the table is NOT consulted for model cells (the mesher clears the tiles of model states, so the flag may be gone).
//  * Hit distance = distance to the quad. Face normal = the dominant axis of the quad plane normal, turned toward the ray origin (so a
//    block placed against it lands next to the visible face). The weighted variant of the cell is the one the mesher draws (seed from position).
//  * Every other cell (plain cubes, partial shapes, air, fluids, unloaded) behaves exactly like mc_input.input_pick: pick flag, entry face, t of entry.
//  * Quads whose texture has no atlas tile are not baked (ms.unmapped), so they are not pickable either: pick = what is drawn.
//  * Selection box: axis box around all quads of the state (mp_bounds); a non-model hit draws the unit cube like before.
// NOT done: collision (the player still uses the shape codes of mc_shapes / mc_math: stairs and slabs are covered there; plant, fence and
// custom pack shapes would need the element boxes as collision boxes) -- docs/mc/resourcepacks.md.
import std.rt
import std.math
import mc.mc_model
import mc.mc_model_mesh
import mc.mc_input
import mc.mc_world
import mc.mc_raster
import mc.mc_camera

export { MpBox, mp_pick, mp_pick_camera, mp_bounds, mp_draw_box, mp_quads, mp_quad_t }

const PQ: usize = mc_model_mesh.PQ_WORDS // words per prepared quad: x0..3 y0..3 z0..3 ... cull at 24
const EPS: f64 = 0.000000001

struct MpBox {
    x0: f64, y0: f64, z0: f64,
    x1: f64, y1: f64, z1: f64,
}

struct Ray {
    ox: f64, oy: f64, oz: f64, // origin
    dx: f64, dy: f64, dz: f64, // unit direction
}

fn v3(x: f64, y: f64, z: f64) -> mc_model.V3 { return mc_model.V3 { x: x, y: y, z: z } }
fn vsub(a: mc_model.V3, b: mc_model.V3) -> mc_model.V3 { return v3(a.x - b.x, a.y - b.y, a.z - b.z) }
fn vdot(a: mc_model.V3, b: mc_model.V3) -> f64 { return (a.x * b.x + a.y * b.y) + a.z * b.z }
fn vcross(a: mc_model.V3, b: mc_model.V3) -> mc_model.V3 {
    return v3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)
}

fn miss() -> f64 { return 0.0 - 1.0 }

fn qf(q: u64, i: usize, k: usize) -> f64 { return math.math_f64(rt.ld64(q, i * PQ + k)) }

fn corner(q: u64, i: usize, c: usize) -> mc_model.V3 { return v3(qf(q, i, c), qf(q, i, 4 + c), qf(q, i, 8 + c)) }

// Moeller-Trumbore, both sides. t >= 0 or -1.
fn tri_t(a: mc_model.V3, b: mc_model.V3, c: mc_model.V3, o: mc_model.V3, d: mc_model.V3) -> f64 {
    let e1: mc_model.V3 = vsub(b, a)
    let e2: mc_model.V3 = vsub(c, a)
    let p: mc_model.V3 = vcross(d, e2)
    let det: f64 = vdot(e1, p)
    if math.fabs(det) < 0.000000000001 { return miss() }
    let inv: f64 = 1.0 / det
    let s: mc_model.V3 = vsub(o, a)
    let u: f64 = vdot(s, p) * inv
    if u < 0.0 - EPS || u > 1.0 + EPS { return miss() }
    let qv: mc_model.V3 = vcross(s, e1)
    let v: f64 = vdot(d, qv) * inv
    if v < 0.0 - EPS || u + v > 1.0 + EPS { return miss() }
    let t: f64 = vdot(e2, qv) * inv
    if t < 0.0 { return miss() }
    return t
}

// Distance along the ray (block local origin) to quad i of the prepared quads q; -1 = miss. nx / ny / nz = integer face normal toward the origin.
fn mp_quad_t(q: u64, i: usize, ray: *mut Ray, nx: *mut i32, ny: *mut i32, nz: *mut i32) -> f64 {
    let p0: mc_model.V3 = corner(q, i, 0)
    let p1: mc_model.V3 = corner(q, i, 1)
    let p2: mc_model.V3 = corner(q, i, 2)
    let p3: mc_model.V3 = corner(q, i, 3)
    let o: mc_model.V3 = v3((*ray).ox, (*ray).oy, (*ray).oz)
    let d: mc_model.V3 = v3((*ray).dx, (*ray).dy, (*ray).dz)
    var t: f64 = tri_t(p0, p1, p2, o, d)
    let t2: f64 = tri_t(p0, p2, p3, o, d)
    if t < 0.0 || (t2 >= 0.0 && t2 < t) { t = t2 }
    if t < 0.0 { return miss() }
    var n: mc_model.V3 = vcross(vsub(p1, p0), vsub(p2, p0))
    if vdot(n, n) < 0.000000000001 { n = vcross(vsub(p2, p0), vsub(p3, p0)) }
    if vdot(n, d) > 0.0 { n = v3(0.0 - n.x, 0.0 - n.y, 0.0 - n.z) }
    let ax: f64 = math.fabs(n.x)
    let ay: f64 = math.fabs(n.y)
    let az: f64 = math.fabs(n.z)
    *nx = 0
    *ny = 0
    *nz = 0
    if ax >= ay && ax >= az {
        if n.x > 0.0 { *nx = 1 } else { *nx = 0 - 1 }
    } else if ay >= az {
        if n.y > 0.0 { *ny = 1 } else { *ny = 0 - 1 }
    } else {
        if n.z > 0.0 { *nz = 1 } else { *nz = 0 - 1 }
    }
    return t
}

// Quads of the state drawn at world cell (x, y, z): pointer + count, 0 for a non-model cell. Same variant choice as ms_mesh.
fn mp_quads(m: *mut mc_model_mesh.ModelSet, id: i32, x: i32, y: i32, z: i32, cnt: *mut u32) -> u64 {
    *cnt = 0 as u32
    if id <= 0 || id >= 32768 { return 0 }
    if mc_model_mesh.ms_kind(m, id as u16) != mc_model_mesh.K_MODEL { return 0 }
    var v: usize = 0
    if rt.ld8((*m).weighted, id as usize) != 0 as u8 {
        v = (mc_model.seed_from_pos(x, y, z) % (mc_model_mesh.NVAR as u32)) as usize
    }
    return mc_model_mesh.ms_resolve(m, id as u16, v, cnt)
}

// Axis box around all quads of a model state (block local coordinates, 0..1 for normal models). false for a non-model state.
fn mp_bounds(m: *mut mc_model_mesh.ModelSet, id: i32, x: i32, y: i32, z: i32, out: *mut MpBox) -> bool {
    var cnt: u32 = 0 as u32
    let q: u64 = mp_quads(m, id, x, y, z, &cnt)
    if q == 0 || cnt == 0 as u32 { return false }
    var b: MpBox = MpBox { x0: 1000000.0, y0: 1000000.0, z0: 1000000.0, x1: 0.0 - 1000000.0, y1: 0.0 - 1000000.0, z1: 0.0 - 1000000.0 }
    var i: usize = 0
    while i < (cnt as usize) {
        var c: usize = 0
        while c < 4 {
            let px: f64 = qf(q, i, c)
            let py: f64 = qf(q, i, 4 + c)
            let pz: f64 = qf(q, i, 8 + c)
            if px < b.x0 { b.x0 = px }
            if py < b.y0 { b.y0 = py }
            if pz < b.z0 { b.z0 = pz }
            if px > b.x1 { b.x1 = px }
            if py > b.y1 { b.y1 = py }
            if pz > b.z1 { b.z1 = pz }
            c = c + 1
        }
        i = i + 1
    }
    *out = b
    return true
}

fn flag(t: u64, n: usize, id: i32) -> bool {
    if id < 0 || (id as usize) >= n { return false }
    return rt.ld8(t, id as usize) != 0 as u8
}

fn set_hit(out: *mut mc_input.Pick, x: i32, y: i32, z: i32, nx: i32, ny: i32, nz: i32, dist: f64, id: i32) {
    (*out).x = x
    (*out).y = y
    (*out).z = z
    (*out).nx = nx
    (*out).ny = ny
    (*out).nz = nz
    (*out).dist = dist
    (*out).id = id
}

// One cell. Model cell: nearest quad hit within reach; other cells: pick flag with the DDA entry data (en* = entry normal, et = entry t).
fn cell_hit(m: *mut mc_model_mesh.ModelSet, tb: *mut mc_input.InputTables, id: i32, cx: i32, cy: i32, cz: i32, ray: *mut Ray,
    en_x: i32, en_y: i32, en_z: i32, et: f64, reach: f64, out: *mut mc_input.Pick) -> bool {
    var cnt: u32 = 0 as u32
    let q: u64 = mp_quads(m, id, cx, cy, cz, &cnt)
    if q != 0 {
        var lr: Ray = Ray { ox: (*ray).ox - (cx as f64), oy: (*ray).oy - (cy as f64), oz: (*ray).oz - (cz as f64), dx: (*ray).dx, dy: (*ray).dy, dz: (*ray).dz }
        var best: f64 = miss()
        var bx: i32 = 0
        var by: i32 = 0
        var bz: i32 = 0
        var i: usize = 0
        while i < (cnt as usize) {
            var nx: i32 = 0
            var ny: i32 = 0
            var nz: i32 = 0
            let t: f64 = mp_quad_t(q, i, &lr, &nx, &ny, &nz)
            if t >= 0.0 && (best < 0.0 || t < best) {
                best = t
                bx = nx
                by = ny
                bz = nz
            }
            i = i + 1
        }
        if best >= 0.0 && best <= reach {
            set_hit(out, cx, cy, cz, bx, by, bz, best, id)
            return true
        }
        return false
    }
    if flag((*tb).pick, (*tb).n, id) {
        set_hit(out, cx, cy, cz, en_x, en_y, en_z, et, id)
        return true
    }
    return false
}

// Voxel walk like mc_input.input_pick, but model cells are tested against their quads. Unloaded chunks count as air.
fn mp_pick(w: *mut mc_world.World, min_y: i32, tb: *mut mc_input.InputTables, m: *mut mc_model_mesh.ModelSet,
    ox: f64, oy: f64, oz: f64, dx0: f64, dy0: f64, dz0: f64, reach: f64, out: *mut mc_input.Pick) -> bool {
    let len: f64 = math.sqrt((dx0 * dx0 + dy0 * dy0) + dz0 * dz0)
    if !(len > 0.0) || !math.is_finite(len) { return false }
    if !math.is_finite(ox) || !math.is_finite(oy) || !math.is_finite(oz) || !(math.fabs(ox) < 1000000000.0)
    || !(math.fabs(oy) < 1000000000.0) || !(math.fabs(oz) < 1000000000.0) {
        return false
    }
    let dx: f64 = dx0 / len
    let dy: f64 = dy0 / len
    let dz: f64 = dz0 / len
    var ray: Ray = Ray { ox: ox, oy: oy, oz: oz, dx: dx, dy: dy, dz: dz }
    var cx: i32 = math.floor(ox) as i32
    var cy: i32 = math.floor(oy) as i32
    var cz: i32 = math.floor(oz) as i32
    var id: i32 = mc_input.world_block_id(w, min_y, cx, cy, cz)
    if cell_hit(m, tb, id, cx, cy, cz, &ray, 0, 0, 0, 0.0, reach, out) { return true }
    var sx: i32 = 0
    var sy: i32 = 0
    var sz: i32 = 0
    var tdx: f64 = math.INF()
    var tdy: f64 = math.INF()
    var tdz: f64 = math.INF()
    var tmx: f64 = math.INF()
    var tmy: f64 = math.INF()
    var tmz: f64 = math.INF()
    if dx > 0.0 {
        sx = 1
        tdx = 1.0 / dx
        tmx = ((cx + 1) as f64 - ox) / dx
    } else if dx < 0.0 {
        sx = -1
        tdx = -1.0 / dx
        tmx = (ox - cx as f64) / (0.0 - dx)
    }
    if dy > 0.0 {
        sy = 1
        tdy = 1.0 / dy
        tmy = ((cy + 1) as f64 - oy) / dy
    } else if dy < 0.0 {
        sy = -1
        tdy = -1.0 / dy
        tmy = (oy - cy as f64) / (0.0 - dy)
    }
    if dz > 0.0 {
        sz = 1
        tdz = 1.0 / dz
        tmz = ((cz + 1) as f64 - oz) / dz
    } else if dz < 0.0 {
        sz = -1
        tdz = -1.0 / dz
        tmz = (oz - cz as f64) / (0.0 - dz)
    }
    while true {
        var axis: i32 = 0
        var t: f64 = tmx
        if tmy < t {
            axis = 1
            t = tmy
        }
        if tmz < t {
            axis = 2
            t = tmz
        }
        if !(t <= reach) { return false }
        var nx: i32 = 0
        var ny: i32 = 0
        var nz: i32 = 0
        if axis == 0 {
            cx = cx + sx
            tmx = tmx + tdx
            nx = 0 - sx
        } else if axis == 1 {
            cy = cy + sy
            tmy = tmy + tdy
            ny = 0 - sy
        } else {
            cz = cz + sz
            tmz = tmz + tdz
            nz = 0 - sz
        }
        id = mc_input.world_block_id(w, min_y, cx, cy, cz)
        if cell_hit(m, tb, id, cx, cy, cz, &ray, nx, ny, nz, t, reach, out) { return true }
    }
    return false
}

fn mp_pick_camera(w: *mut mc_world.World, min_y: i32, tb: *mut mc_input.InputTables, m: *mut mc_model_mesh.ModelSet, cam: *mut mc_camera.Camera,
    reach: f64, out: *mut mc_input.Pick) -> bool {
    return mp_pick(w, min_y, tb, m, (*cam).x, (*cam).y, (*cam).z, (*cam).fx, (*cam).fy, (*cam).fz, reach, out)
}

// Selection box of a hit: the bounds of the model quads for a model state, else the unit cube (mc_input.input_draw_box).
fn mp_draw_box(r: *mut mc_raster.Raster, m: *mut mc_model_mesh.ModelSet, pk: *mut mc_input.Pick, rgba: u32) {
    var b: MpBox = MpBox { x0: 0.0, y0: 0.0, z0: 0.0, x1: 1.0, y1: 1.0, z1: 1.0 }
    if mp_bounds(m, (*pk).id, (*pk).x, (*pk).y, (*pk).z, &b) {
        let fx: f64 = (*pk).x as f64
        let fy: f64 = (*pk).y as f64
        let fz: f64 = (*pk).z as f64
        mc_input.input_draw_aabb(r, fx + b.x0, fy + b.y0, fz + b.z0, fx + b.x1, fy + b.y1, fz + b.z1, rgba)
    } else {
        mc_input.input_draw_box(r, (*pk).x, (*pk).y, (*pk).z, rgba)
    }
}
