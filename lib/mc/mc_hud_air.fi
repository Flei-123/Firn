import mc.mc_input
import mc.mc_world
import mc.mc_world_view
import mc.mc_move_fluid

export { Air, air_new, air_tick, AIR_MAX }

const AIR_MAX: i32 = 300
const AIR_RECOVER: i32 = 4
const AIR_FLOOR: i32 = 0 - 20

struct Air {
    air: i32,
    under: bool,
}

fn air_new() -> Air {
    return Air { air: AIR_MAX, under: false }
}

fn air_tick(a: *mut Air, pl: *mut mc_input.Player, world: *mut mc_world.World, min_y: i32) {
    var v: mc_world_view.WorldView = mc_world_view.view_new(world, min_y)
    var fp: mc_move_fluid.FluidProbe = mc_move_fluid.FluidProbe { water_h: 0.0, lava_h: 0.0, eye_water: false, head_wet: false, climb: false, scaffold: false }
    mc_move_fluid.fluid_probe(&v, (*pl).mv, (*pl).x, (*pl).y, (*pl).z, mc_input.player_height(pl), mc_input.player_eye(pl), &fp)
    (*a).under = fp.eye_water
    if fp.eye_water {
        (*a).air = (*a).air - 1
        if (*a).air <= AIR_FLOOR { (*a).air = 0 }
    } else {
        (*a).air = (*a).air + AIR_RECOVER
        if (*a).air > AIR_MAX { (*a).air = AIR_MAX }
    }
}
