// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.io
import mc.mc_perf

export {
    Prof, prof_new, prof_free, prof_rec, prof_next, prof_report,
    PH_FRAME, PH_NET, PH_DRAW, PH_WORLD, PH_PRESENT, PH_CULL, PH_SUBMIT, PH_UPLOAD, PH_SDRAW, PH_DRAWS, PH_TRIS, PH_CALLS, PH_VISIBLE, PH_COUNT,
}

const PH_FRAME: usize = 0
const PH_NET: usize = 1
const PH_DRAW: usize = 2
const PH_WORLD: usize = 3
const PH_PRESENT: usize = 4
const PH_CULL: usize = 5
const PH_SUBMIT: usize = 6
const PH_UPLOAD: usize = 7
const PH_SDRAW: usize = 8
const PH_DRAWS: usize = 9
const PH_TRIS: usize = 10
const PH_CALLS: usize = 11
const PH_VISIBLE: usize = 12
const PH_COUNT: usize = 13
const CAP: usize = 16384

struct Prof {
    on: bool,
    n: usize,
    buf: u64,
}

fn prof_new(on: bool) -> Prof {
    var p: Prof = Prof { on: on, n: 0, buf: 0 as u64 }
    if on { p.buf = rt.heap_alloc(CAP * PH_COUNT * 8) }
    return p
}

fn prof_free(p: *mut Prof) {
    if (*p).on && (*p).buf != 0 as u64 { rt.heap_free((*p).buf, CAP * PH_COUNT * 8) }
    (*p).buf = 0 as u64
}

fn prof_rec(p: *mut Prof, ph: usize, v: u64) {
    if !(*p).on || (*p).n >= CAP { return }
    rt.st64((*p).buf, ph * CAP + (*p).n, v)
}

fn prof_next(p: *mut Prof) {
    if !(*p).on || (*p).n >= CAP { return }
    (*p).n = (*p).n + 1
}

fn name_of(ph: usize) -> str {
    if ph == PH_FRAME { return "frame" }
    if ph == PH_NET { return "net_tick" }
    if ph == PH_DRAW { return "draw_cpu" }
    if ph == PH_WORLD { return "world_cpu" }
    if ph == PH_PRESENT { return "present" }
    if ph == PH_DRAWS { return "draw_calls" }
    if ph == PH_CULL { return "cull" }
    if ph == PH_SUBMIT { return "submit" }
    if ph == PH_UPLOAD { return "upload" }
    if ph == PH_SDRAW { return "stream_draw" }
    if ph == PH_TRIS { return "tris" }
    if ph == PH_VISIBLE { return "visible" }
    return "gl_calls"
}

fn prof_report(p: *mut Prof) {
    if !(*p).on || (*p).n == 0 { return }
    var ph: usize = 0
    while ph < PH_COUNT {
        let a: u64 = (*p).buf + (ph * CAP * 8) as u64
        mc_perf.perf_sort(a, (*p).n)
        let p50: u64 = mc_perf.perf_percentile(a, (*p).n, 5000 as u64)
        let p95: u64 = mc_perf.perf_percentile(a, (*p).n, 9500 as u64)
        let mean: u64 = mc_perf.perf_mean(a, (*p).n)
        if ph < PH_DRAWS {
            io.fmt_print(f"mcplay: profile phase={name_of(ph)} n={(*p).n} p50_us={p50 / 1000 as u64} p95_us={p95 / 1000 as u64} mean_us={mean / 1000 as u64}\n")
        } else {
            io.fmt_print(f"mcplay: profile phase={name_of(ph)} n={(*p).n} p50={p50} p95={p95} mean={mean}\n")
        }
        ph = ph + 1
    }
}
