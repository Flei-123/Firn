// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.io
import mc.mc_perf
import std.time

export {
    Prof, prof_new, prof_free, prof_rec, prof_next, prof_report, prof_attach, prof_active, prof_active_now, prof_lap,
    PH_PUMP, PH_DRAIN, PH_SYNC, PH_TICKS, PH_PICK, PH_AUDIO, PH_ENTS, PH_PRE, PH_END, PH_POST, PH_LODD, PH_TRANSD, PH_COMPACT, PH_SKY, PH_CBFS, PH_CSORT, PH_CKN, PH_CINIT, PH_FLB, PH_FLG, PH_LREG, PH_WTICK, prof_add,
    PH_FRAME, PH_NET, PH_DRAW, PH_WORLD, PH_PRESENT, PH_CULL, PH_SUBMIT, PH_UPLOAD, PH_SDRAW, PH_DRAWS, PH_TRIS, PH_CALLS, PH_VISIBLE, PH_COUNT,
}

const PH_FRAME: usize = 0
const PH_NET: usize = 1
const PH_DRAW: usize = 2
const PH_WORLD: usize = 3
const PH_PRESENT: usize = 4
const PH_CULL: usize = 5
const PH_SUBMIT: usize = 6
const PH_UPLOAD: usize = 7
const PH_SDRAW: usize = 8
const PH_DRAWS: usize = 9
const PH_TRIS: usize = 10
const PH_CALLS: usize = 11
const PH_VISIBLE: usize = 12
const PH_PUMP: usize = 13
const PH_DRAIN: usize = 14
const PH_SYNC: usize = 15
const PH_TICKS: usize = 16
const PH_PICK: usize = 17
const PH_AUDIO: usize = 18
const PH_ENTS: usize = 19
const PH_PRE: usize = 20
const PH_END: usize = 21
const PH_POST: usize = 22
const PH_LODD: usize = 23
const PH_TRANSD: usize = 24
const PH_COMPACT: usize = 25
const PH_SKY: usize = 26
const PH_CBFS: usize = 27
const PH_CSORT: usize = 28
const PH_CKN: usize = 29
const PH_CINIT: usize = 30
const PH_FLB: usize = 31
const PH_FLG: usize = 32
const PH_LREG: usize = 33
const PH_WTICK: usize = 34
const PH_COUNT: usize = 35
static mut G_PROF: u64 = 0
const CAP: usize = 16384

struct Prof {
    on: bool,
    n: usize,
    buf: u64,
}

fn prof_new(on: bool) -> Prof {
    var p: Prof = Prof { on: on, n: 0, buf: 0 as u64 }
    if on {
        p.buf = rt.heap_alloc(CAP * PH_COUNT * 8)
        rt.mem_set(p.buf, 0 as u8, CAP * PH_COUNT * 8)
    }
    return p
}

fn prof_attach(p: *mut Prof) {
    G_PROF = p as u64
}

fn prof_active() -> bool {
    if G_PROF == 0 as u64 { return false }
    return (*(G_PROF as *mut Prof)).on
}

fn prof_active_now() -> u64 {
    return time.monotonic_ns()
}

fn prof_lap(ph: usize, t0: u64) -> u64 {
    if G_PROF == 0 as u64 { return 0 as u64 }
    let p: *mut Prof = G_PROF as *mut Prof
    if !(*p).on { return 0 as u64 }
    let t: u64 = time.monotonic_ns()
    prof_rec(p, ph, t - t0)
    return t
}

fn prof_free(p: *mut Prof) {
    if (*p).on && (*p).buf != 0 as u64 { rt.heap_free((*p).buf, CAP * PH_COUNT * 8) }
    (*p).buf = 0 as u64
}

fn prof_rec(p: *mut Prof, ph: usize, v: u64) {
    if !(*p).on || (*p).n >= CAP { return }
    rt.st64((*p).buf, ph * CAP + (*p).n, v)
}

fn prof_add(ph: usize, v: u64) {
    if G_PROF == 0 as u64 { return }
    let p: *mut Prof = G_PROF as *mut Prof
    if !(*p).on || (*p).n >= CAP { return }
    rt.st64((*p).buf, ph * CAP + (*p).n, rt.ld64((*p).buf, ph * CAP + (*p).n) + v)
}

fn prof_next(p: *mut Prof) {
    if !(*p).on || (*p).n >= CAP { return }
    (*p).n = (*p).n + 1
}

fn name_of(ph: usize) -> str {
    if ph == PH_FRAME { return "frame" }
    if ph == PH_NET { return "net_tick" }
    if ph == PH_DRAW { return "draw_cpu" }
    if ph == PH_WORLD { return "world_cpu" }
    if ph == PH_PRESENT { return "present" }
    if ph == PH_DRAWS { return "draw_calls" }
    if ph == PH_CULL { return "cull" }
    if ph == PH_SUBMIT { return "submit" }
    if ph == PH_UPLOAD { return "upload" }
    if ph == PH_SDRAW { return "stream_draw" }
    if ph == PH_TRIS { return "tris" }
    if ph == PH_VISIBLE { return "visible" }
    if ph == PH_PUMP { return "n_pump" }
    if ph == PH_DRAIN { return "n_drain" }
    if ph == PH_SYNC { return "n_sync" }
    if ph == PH_TICKS { return "n_ticks" }
    if ph == PH_PICK { return "n_pick" }
    if ph == PH_AUDIO { return "n_audio" }
    if ph == PH_ENTS { return "n_ents" }
    if ph == PH_PRE { return "d_pre" }
    if ph == PH_END { return "d_end" }
    if ph == PH_POST { return "d_post" }
    if ph == PH_LODD { return "s_lod_draw" }
    if ph == PH_TRANSD { return "s_trans_draw" }
    if ph == PH_COMPACT { return "s_compact" }
    if ph == PH_SKY { return "d_sky" }
    if ph == PH_CBFS { return "c_bfs" }
    if ph == PH_CSORT { return "c_sort" }
    if ph == PH_CKN { return "c_known" }
    if ph == PH_CINIT { return "c_init" }
    if ph == PH_FLB { return "fl_build" }
    if ph == PH_FLG { return "fl_gl" }
    if ph == PH_LREG { return "n_lreg" }
    if ph == PH_WTICK { return "n_wtick" }
    return "gl_calls"
}

fn prof_report(p: *mut Prof) {
    if !(*p).on || (*p).n == 0 { return }
    var ph: usize = 0
    while ph < PH_COUNT {
        let a: u64 = (*p).buf + (ph * CAP * 8) as u64
        mc_perf.perf_sort(a, (*p).n)
        let p50: u64 = mc_perf.perf_percentile(a, (*p).n, 5000 as u64)
        let p95: u64 = mc_perf.perf_percentile(a, (*p).n, 9500 as u64)
        let mean: u64 = mc_perf.perf_mean(a, (*p).n)
        if ph < PH_DRAWS || ph >= PH_PUMP {
            io.fmt_print(f"mcplay: profile phase={name_of(ph)} n={(*p).n} p50_us={p50 / 1000 as u64} p95_us={p95 / 1000 as u64} mean_us={mean / 1000 as u64}\n")
        } else {
            io.fmt_print(f"mcplay: profile phase={name_of(ph)} n={(*p).n} p50={p50} p95={p95} mean={mean}\n")
        }
        ph = ph + 1
    }
}
