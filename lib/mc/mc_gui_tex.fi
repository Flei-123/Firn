// SPDX-License-Identifier: MPL-2.0
import std.rt
import paint.png
import mc.mc_raster
import mc.mc_hud

export {
    GuiTex, gtex_empty, gtex_free, gtex_ok, gtex_from_png, gtex_blank, gtex_get, gtex_set, gtex_draw, gtex_draw_tiled, gtex_blend,
}

const MAX_GUI_PIXELS: u64 = 4194304

struct GuiTex {
    w: i32,
    h: i32,
    px: u64,
}

fn gtex_empty() -> GuiTex {
    return GuiTex { w: 0, h: 0, px: 0 as u64 }
}

fn gtex_ok(t: *mut GuiTex) -> bool {
    return (*t).px != 0 as u64 && (*t).w > 0 && (*t).h > 0
}

fn gtex_free(t: *mut GuiTex) {
    if (*t).px != 0 as u64 { rt.heap_free((*t).px, ((*t).w as usize) * ((*t).h as usize) * 4) }
    *t = gtex_empty()
}

fn gtex_blank(t: *mut GuiTex, w: i32, h: i32) -> bool {
    *t = gtex_empty()
    if w <= 0 || h <= 0 { return false }
    let n: usize = (w as usize) * (h as usize)
    let p: u64 = rt.heap_alloc(n * 4)
    if p == 0 as u64 { return false }
    var i: usize = 0
    while i < n {
        rt.st32(p, i, 0 as u32)
        i = i + 1
    }
    *t = GuiTex { w: w, h: h, px: p }
    return true
}

fn gtex_from_png(data: u64, n: usize, t: *mut GuiTex) -> bool {
    *t = gtex_empty()
    var im: png.Image = png.image_new()
    let ok: bool = png.decode_png_limited(data, n, MAX_GUI_PIXELS, &im)
    if !ok { return false }
    let w: usize = png.image_width(&im)
    let h: usize = png.image_height(&im)
    if w == 0 || h == 0 {
        png.image_free(&im)
        return false
    }
    if !gtex_blank(t, w as i32, h as i32) {
        png.image_free(&im)
        return false
    }
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let c: u32 = png.image_pixel(&im, x, y)
            let a: u32 = c >> 24 as u32
            let rr: u32 = (c >> 16 as u32) & 255 as u32
            let gg: u32 = (c >> 8 as u32) & 255 as u32
            let bb: u32 = c & 255 as u32
            rt.st32((*t).px, y * w + x, (a << 24 as u32) | (bb << 16 as u32) | (gg << 8 as u32) | rr)
            x = x + 1
        }
        y = y + 1
    }
    png.image_free(&im)
    return true
}

fn gtex_get(t: *mut GuiTex, x: i32, y: i32) -> u32 {
    if x < 0 || y < 0 || x >= (*t).w || y >= (*t).h { return 0 as u32 }
    return rt.ld32((*t).px, (y as usize) * ((*t).w as usize) + (x as usize))
}

fn gtex_set(t: *mut GuiTex, x: i32, y: i32, c: u32) {
    if x < 0 || y < 0 || x >= (*t).w || y >= (*t).h { return }
    rt.st32((*t).px, (y as usize) * ((*t).w as usize) + (x as usize), c)
}

fn gtex_blend(r: *mut mc_raster.Raster, x: i32, y: i32, c: u32) {
    let a: u32 = c >> 24 as u32
    if a == 0 as u32 { return }
    if x < 0 || y < 0 || x >= (*r).w || y >= (*r).h { return }
    if mc_hud.hud_recording() {
        mc_hud.hud_rect(r, x, y, 1, 1, c)
        return
    }
    let at: usize = (y as usize) * ((*r).w as usize) + (x as usize)
    if a == 255 as u32 {
        rt.st32((*r).color, at, c)
        return
    }
    let d: u32 = rt.ld32((*r).color, at)
    let ia: u32 = 255 as u32 - a
    let nr: u32 = ((c & 255 as u32) * a + (d & 255 as u32) * ia) / 255 as u32
    let ng: u32 = (((c >> 8 as u32) & 255 as u32) * a + ((d >> 8 as u32) & 255 as u32) * ia) / 255 as u32
    let nb: u32 = (((c >> 16 as u32) & 255 as u32) * a + ((d >> 16 as u32) & 255 as u32) * ia) / 255 as u32
    rt.st32((*r).color, at, 0xFF000000 as u32 | (nb << 16 as u32) | (ng << 8 as u32) | nr)
}

fn tint(c: u32, m: u32) -> u32 {
    if m == 0xFFFFFFFF as u32 { return c }
    let a: u32 = (c >> 24 as u32) * (m >> 24 as u32) / 255 as u32
    let b: u32 = ((c >> 16 as u32) & 255 as u32) * ((m >> 16 as u32) & 255 as u32) / 255 as u32
    let g: u32 = ((c >> 8 as u32) & 255 as u32) * ((m >> 8 as u32) & 255 as u32) / 255 as u32
    let rr: u32 = (c & 255 as u32) * (m & 255 as u32) / 255 as u32
    return (a << 24 as u32) | (b << 16 as u32) | (g << 8 as u32) | rr
}

fn gtex_draw(r: *mut mc_raster.Raster, t: *mut GuiTex, dx: i32, dy: i32, dw: i32, dh: i32, sx: i32, sy: i32, sw: i32, sh: i32, mul: u32) {
    if !gtex_ok(t) || dw <= 0 || dh <= 0 || sw <= 0 || sh <= 0 { return }
    if mc_hud.hud_recording() {
        gtex_draw_rec(r, t, dx, dy, dw, dh, sx, sy, sw, sh, mul)
        return
    }
    var j: i32 = 0
    while j < dh {
        let py: i32 = dy + j
        if py >= 0 && py < (*r).h {
            let ty: i32 = sy + ((2 * j + 1) * sh) / (2 * dh)
            var i: i32 = 0
            while i < dw {
                let px: i32 = dx + i
                if px >= 0 && px < (*r).w {
                    let tx: i32 = sx + ((2 * i + 1) * sw) / (2 * dw)
                    gtex_blend(r, px, py, tint(gtex_get(t, tx, ty), mul))
                }
                i = i + 1
            }
        }
        j = j + 1
    }
}

fn gtex_draw_rec(r: *mut mc_raster.Raster, t: *mut GuiTex, dx: i32, dy: i32, dw: i32, dh: i32, sx: i32, sy: i32, sw: i32, sh: i32, mul: u32) {
    var j: i32 = 0
    while j < dh {
        let ty: i32 = sy + ((2 * j + 1) * sh) / (2 * dh)
        var j2: i32 = j + 1
        while j2 < dh && sy + ((2 * j2 + 1) * sh) / (2 * dh) == ty { j2 = j2 + 1 }
        var i: i32 = 0
        while i < dw {
            let tx: i32 = sx + ((2 * i + 1) * sw) / (2 * dw)
            let c: u32 = tint(gtex_get(t, tx, ty), mul)
            var i2: i32 = i + 1
            while i2 < dw && sx + ((2 * i2 + 1) * sw) / (2 * dw) == tx { i2 = i2 + 1 }
            mc_hud.hud_rect(r, dx + i, dy + j, i2 - i, j2 - j, c)
            i = i2
        }
        j = j2
    }
}

fn gtex_draw_tiled(r: *mut mc_raster.Raster, t: *mut GuiTex, x: i32, y: i32, w: i32, h: i32, cell: i32, mul: u32) {
    if !gtex_ok(t) || cell <= 0 { return }
    var j: i32 = 0
    while j < h {
        var i: i32 = 0
        while i < w {
            let u: i32 = (i % cell) * (*t).w / cell
            let v: i32 = (j % cell) * (*t).h / cell
            gtex_blend(r, x + i, y + j, tint(gtex_get(t, u, v), mul))
            i = i + 1
        }
        j = j + 1
    }
}
