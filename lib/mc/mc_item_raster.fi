// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.math
import mc.mc_model
import mc.mc_gui_tex

export { iraster_draw, IRASTER_TINTS, shaded }

const IRASTER_TINTS: usize = 4
const COS_Y: f64 = -0.7071067811865476
const SIN_Y: f64 = -0.7071067811865476
const COS_X: f64 = 0.8660254037844386
const SIN_X: f64 = 0.5
const GUI_SCALE: f64 = 0.625
const EPS: f64 = 0.000001

struct Vtx { x: f64, y: f64, z: f64, u: f64, v: f64 }

fn vtx_new() -> Vtx { return Vtx { x: 0.0, y: 0.0, z: 0.0, u: 0.0, v: 0.0 } }

fn project(b: *mut mc_model.Baked, qi: usize, k: usize, size: i32, o: *mut Vtx) {
    let px: f64 = mc_model.baked_f(b, qi, mc_model.X0 + k) - 0.5
    let py: f64 = mc_model.baked_f(b, qi, mc_model.Y0 + k) - 0.5
    let pz: f64 = mc_model.baked_f(b, qi, mc_model.Z0 + k) - 0.5
    let x1: f64 = px * COS_Y + pz * SIN_Y
    let z1: f64 = 0.0 - px * SIN_Y + pz * COS_Y
    let y2: f64 = py * COS_X - z1 * SIN_X
    let z2: f64 = py * SIN_X + z1 * COS_X
    let sz: f64 = size as f64
    (*o).x = sz / 2.0 + x1 * GUI_SCALE * sz
    (*o).y = sz / 2.0 - y2 * GUI_SCALE * sz
    (*o).z = z2
    (*o).u = mc_model.baked_f(b, qi, mc_model.U0 + k)
    (*o).v = mc_model.baked_f(b, qi, mc_model.V0 + k)
}

fn shade_of(dir: i32) -> u32 {
    if dir == 1 { return 255 as u32 }
    if dir == 5 { return 163 as u32 }
    return 102 as u32
}

fn scale_channel(c: u32, m: u32) -> u32 {
    return (c * m) / 255 as u32
}

fn shaded(c: u32, shade: u32, tint: u32) -> u32 {
    let a: u32 = c >> 24 as u32
    var r: u32 = scale_channel(c & 255 as u32, shade)
    var g: u32 = scale_channel((c >> 8 as u32) & 255 as u32, shade)
    var b: u32 = scale_channel((c >> 16 as u32) & 255 as u32, shade)
    r = scale_channel(r, tint & 255 as u32)
    g = scale_channel(g, (tint >> 8 as u32) & 255 as u32)
    b = scale_channel(b, (tint >> 16 as u32) & 255 as u32)
    return (a << 24 as u32) | (b << 16 as u32) | (g << 8 as u32) | r
}

fn min3(a: f64, b: f64, c: f64) -> f64 {
    var m: f64 = a
    if b < m { m = b }
    if c < m { m = c }
    return m
}

fn max3(a: f64, b: f64, c: f64) -> f64 {
    var m: f64 = a
    if b > m { m = b }
    if c > m { m = c }
    return m
}

fn tri(a: *mut Vtx, b: *mut Vtx, c: *mut Vtx, tx: *mut mc_gui_tex.GuiTex, shade: u32, tint: u32, out: *mut mc_gui_tex.GuiTex, depth: u64) {
    let area: f64 = ((*b).x - (*a).x) * ((*c).y - (*a).y) - ((*c).x - (*a).x) * ((*b).y - (*a).y)
    if area < EPS && area > 0.0 - EPS { return }
    var x0: i32 = math.floor(min3((*a).x, (*b).x, (*c).x)) as i32
    var x1: i32 = math.ceil(max3((*a).x, (*b).x, (*c).x)) as i32
    var y0: i32 = math.floor(min3((*a).y, (*b).y, (*c).y)) as i32
    var y1: i32 = math.ceil(max3((*a).y, (*b).y, (*c).y)) as i32
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    if x1 > (*out).w { x1 = (*out).w }
    if y1 > (*out).h { y1 = (*out).h }
    var y: i32 = y0
    while y < y1 {
        var x: i32 = x0
        while x < x1 {
            let px: f64 = (x as f64) + 0.5
            let py: f64 = (y as f64) + 0.5
            let w0: f64 = (((*b).x - px) * ((*c).y - py) - ((*c).x - px) * ((*b).y - py)) / area
            let w1: f64 = (((*c).x - px) * ((*a).y - py) - ((*a).x - px) * ((*c).y - py)) / area
            let w2: f64 = 1.0 - w0 - w1
            if w0 >= 0.0 - EPS && w1 >= 0.0 - EPS && w2 >= 0.0 - EPS {
                let z: f64 = w0 * (*a).z + w1 * (*b).z + w2 * (*c).z
                let zi: u32 = ((z + 8.0) * 4096.0) as u32
                let at: usize = (y as usize) * ((*out).w as usize) + (x as usize)
                if zi > rt.ld32(depth, at) {
                    let u: f64 = w0 * (*a).u + w1 * (*b).u + w2 * (*c).u
                    let v: f64 = w0 * (*a).v + w1 * (*b).v + w2 * (*c).v
                    var sx: i32 = math.floor(u / 16.0 * ((*tx).w as f64)) as i32
                    var sy: i32 = math.floor(v / 16.0 * ((*tx).h as f64)) as i32
                    if sx < 0 { sx = 0 }
                    if sy < 0 { sy = 0 }
                    if sx >= (*tx).w { sx = (*tx).w - 1 }
                    if sy >= (*tx).h { sy = (*tx).h - 1 }
                    let col: u32 = mc_gui_tex.gtex_get(tx, sx, sy)
                    if (col >> 24 as u32) != 0 as u32 {
                        rt.st32(depth, at, zi)
                        mc_gui_tex.gtex_set(out, x, y, shaded(col, shade, tint))
                    }
                }
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn iraster_draw(b: *mut mc_model.Baked, tex: u64, ntex: usize, tints: u64, out: *mut mc_gui_tex.GuiTex) {
    let n: usize = (*out).w as usize * ((*out).h as usize)
    let depth: u64 = rt.heap_alloc(n * 4)
    var i: usize = 0
    while i < n {
        rt.st32(depth, i, 0 as u32)
        i = i + 1
    }
    var q: usize = 0
    while q < mc_model.baked_count(b) {
        let ti: usize = mc_model.baked_f(b, q, mc_model.W_TEX) as usize
        if ti < ntex {
            let tx: *mut mc_gui_tex.GuiTex = (tex + ((ti * 16) as u64)) as *mut mc_gui_tex.GuiTex
            if mc_gui_tex.gtex_ok(tx) {
                var tint: u32 = 0xFFFFFFFF as u32
                let tk: i32 = mc_model.baked_f(b, q, mc_model.W_TINT) as i32
                if tk >= 0 && (tk as usize) < IRASTER_TINTS { tint = rt.ld32(tints, tk as usize) }
                let shade: u32 = shade_of(mc_model.baked_f(b, q, mc_model.W_DIR) as i32)
                var v0: Vtx = vtx_new()
                var v1: Vtx = vtx_new()
                var v2: Vtx = vtx_new()
                var v3: Vtx = vtx_new()
                project(b, q, 0, (*out).w, &v0)
                project(b, q, 1, (*out).w, &v1)
                project(b, q, 2, (*out).w, &v2)
                project(b, q, 3, (*out).w, &v3)
                tri(&v0, &v1, &v2, tx, shade, tint, out, depth)
                tri(&v0, &v2, &v3, tx, shade, tint, out, depth)
            }
        }
        q = q + 1
    }
    rt.heap_free(depth, n * 4)
}
