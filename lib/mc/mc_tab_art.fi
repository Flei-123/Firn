import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_gui_pack
import mc.mc_gui_tex

export { tabart_load, tabart_ok, tabart_unload, tabart_ping, tabart_face, PING_W, PING_H, FACE_PX }

const PING_W: i32 = 10
const PING_H: i32 = 8
const PING_LEVELS: i32 = 6
const FACE_PX: i32 = 8
const ICONS: str = "assets/minecraft/textures/gui/icons.png"
const STEVE: str = "assets/minecraft/textures/entity/player/wide/steve.png"
const ALEX: str = "assets/minecraft/textures/entity/player/wide/alex.png"
const ICON_V: i32 = 176

static mut PING: u64 = 0
static mut FACES: u64 = 0

fn tabart_ok() -> bool { return PING != 0 as u64 }

fn tabart_unload() {
    if PING != 0 as u64 { rt.heap_free(PING, (PING_LEVELS * PING_W * PING_H * 4) as usize) }
    if FACES != 0 as u64 { rt.heap_free(FACES, (2 * FACE_PX * FACE_PX * 4) as usize) }
    PING = 0 as u64
    FACES = 0 as u64
}

fn copy_ping(icons: *mut mc_gui_tex.GuiTex, dst: u64) {
    var k: i32 = 0
    while k < PING_LEVELS {
        var y: i32 = 0
        while y < PING_H {
            var x: i32 = 0
            while x < PING_W {
                rt.st32(dst, (k * PING_W * PING_H + y * PING_W + x) as usize, mc_gui_tex.gtex_get(icons, x, ICON_V + k * PING_H + y))
                x = x + 1
            }
            y = y + 1
        }
        k = k + 1
    }
}

fn copy_face(skin: *mut mc_gui_tex.GuiTex, dst: u64, slot: i32) {
    var y: i32 = 0
    while y < FACE_PX {
        var x: i32 = 0
        while x < FACE_PX {
            var c: u32 = mc_gui_tex.gtex_get(skin, 8 + x, 8 + y)
            let hat: u32 = mc_gui_tex.gtex_get(skin, 40 + x, 8 + y)
            if (hat >> 24 as u32) != 0 as u32 { c = hat }
            rt.st32(dst, (slot * FACE_PX * FACE_PX + y * FACE_PX + x) as usize, c | 0xFF000000 as u32)
            x = x + 1
        }
        y = y + 1
    }
}

fn tabart_load(pk: *mut mc_gui_pack.GuiPack) -> bool {
    tabart_unload()
    var icons: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    var steve: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    var alex: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    let ok_i: bool = mc_gui_pack.gpack_tex(pk, ICONS, &icons)
    let ok_s: bool = mc_gui_pack.gpack_tex(pk, STEVE, &steve)
    let ok_a: bool = mc_gui_pack.gpack_tex(pk, ALEX, &alex)
    var ok: bool = false
    if ok_i && ok_s && ok_a && icons.h >= ICON_V + PING_LEVELS * PING_H && steve.h >= 16 && alex.h >= 16 {
        let ping: u64 = rt.heap_alloc((PING_LEVELS * PING_W * PING_H * 4) as usize)
        let faces: u64 = rt.heap_alloc((2 * FACE_PX * FACE_PX * 4) as usize)
        if ping != 0 as u64 && faces != 0 as u64 {
            copy_ping(&icons, ping)
            copy_face(&steve, faces, 0)
            copy_face(&alex, faces, 1)
            PING = ping
            FACES = faces
            ok = true
        }
    }
    mc_gui_tex.gtex_free(&icons)
    mc_gui_tex.gtex_free(&steve)
    mc_gui_tex.gtex_free(&alex)
    return ok
}

fn tabart_ping(r: *mut mc_raster.Raster, x: i32, y: i32, s: i32, level: i32) {
    var lv: i32 = level
    if lv < 0 { lv = 0 }
    if lv >= PING_LEVELS { lv = PING_LEVELS - 1 }
    if PING == 0 as u64 {
        mc_hud.hud_rect(r, x, y + 5 * s, 10 * s, 3 * s, 0xFF00FF00)
        return
    }
    var py: i32 = 0
    while py < PING_H {
        var px: i32 = 0
        while px < PING_W {
            let c: u32 = rt.ld32(PING, (lv * PING_W * PING_H + py * PING_W + px) as usize)
            if (c >> 24 as u32) != 0 as u32 { mc_hud.hud_rect(r, x + px * s, y + py * s, s, s, c) }
            px = px + 1
        }
        py = py + 1
    }
}

fn tabart_face(r: *mut mc_raster.Raster, x: i32, y: i32, s: i32, alex: bool) {
    var slot: i32 = 0
    if alex { slot = 1 }
    if FACES == 0 as u64 {
        mc_hud.hud_rect(r, x, y, FACE_PX * s, FACE_PX * s, 0xFF7F7F7F)
        return
    }
    var py: i32 = 0
    while py < FACE_PX {
        var px: i32 = 0
        while px < FACE_PX {
            let c: u32 = rt.ld32(FACES, (slot * FACE_PX * FACE_PX + py * FACE_PX + px) as usize)
            mc_hud.hud_rect(r, x + px * s, y + py * s, s, s, c)
            px = px + 1
        }
        py = py + 1
    }
}
