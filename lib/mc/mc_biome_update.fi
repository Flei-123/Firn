import std.rt
import std.bytes
import mc.mc_chunk
import mc.mc_world

export { biome_apply_packet, biome_update_x, biome_update_z, BIOME_UPDATE_MAX }

const BIOME_UPDATE_MAX: usize = 256
const COORD_BIAS: i32 = 1048576

fn biome_update_x(out: u64, i: usize) -> i32 { return (rt.ld32(out, i * 2) as i32) - COORD_BIAS }
fn biome_update_z(out: u64, i: usize) -> i32 { return (rt.ld32(out, i * 2 + 1) as i32) - COORD_BIAS }

fn apply_column(ch: *mut mc_chunk.Chunk, sc: *mut mc_chunk.Scratch, data: *mut bytes.Bytes) -> usize {
    var n: usize = 0
    while n < (*ch).nsec && bytes.bytes_remaining(data) > 0 {
        if !mc_chunk.section_replace_biomes(ch, n, sc, data) { return n }
        n = n + 1
    }
    return n
}

fn biome_apply_packet(world: *mut mc_world.World, sc: *mut mc_chunk.Scratch, body: *mut bytes.Bytes, out: u64) -> usize {
    var changed: usize = 0
    let count: i32 = bytes.get_varint(body) catch 0
    var i: i32 = 0
    while i < count {
        let cz: i32 = bytes.get_i32(body) catch 0
        let cx: i32 = bytes.get_i32(body) catch 0
        let len: i32 = bytes.get_varint(body) catch 0 - 1
        if len < 0 || len as usize > bytes.bytes_remaining(body) { return changed }
        let p: u64 = bytes.get_span(body, len as usize) catch 0
        if p == 0 && len > 0 { return changed }
        let found: u64 = mc_world.world_find(world, cx, cz)
        if found != 0 {
            var view: bytes.Bytes = bytes.Bytes { data: p, cap: len as usize, len: len as usize, pos: 0, bad: false }
            let done: usize = apply_column(found as *mut mc_chunk.Chunk, sc, &view)
            if done > 0 && changed < BIOME_UPDATE_MAX {
                rt.st32(out, changed * 2, (cx + COORD_BIAS) as u32)
                rt.st32(out, changed * 2 + 1, (cz + COORD_BIAS) as u32)
                changed = changed + 1
            }
        }
        i = i + 1
    }
    return changed
}
