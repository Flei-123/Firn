// lib/mc/mc_raster.fi -- CPU software rasterizer for mc_mesh output (no GPU, no window).
//
// Framebuffer: RGBA8, one u32 per pixel (byte order R G B A, 0xAABBGGRR), always alpha 255 after a
// clear. Depth buffer: f64 per pixel holding 1/z (view depth); 0.0 = infinitely far, larger = nearer.
//
// PIPELINE per triangle (mc_mesh quads are two triangles, vertex words are decoded here):
//   1. vertex -> camera-relative f64 -> view space (x right, y up, z along the view direction),
//      always the same operation order (docs/mc/raster.md; the python reference repeats it)
//   2. near clipping against z = near (Sutherland-Hodgman, 3 -> up to 4 vertices, attributes linear in view space)
//   3. perspective division, snap to 1/16 pixel fixed point (i64); from here on EVERYTHING that decides
//      coverage is integer: area sign (back face culling), edge functions, top-left fill rule
//   4. per covered pixel (centre at +0.5): 1/z interpolation, depth test (strictly nearer wins),
//      perspective correct u, v, ao (f64, fixed operation order), nearest texel from mc_texture's atlas
//      (tile-local wrap, so greedy quads repeat), alpha < 128 = cutout (no write), shading, fog
//   Shading (all integer): fq = floor(100 + 52 * ao) in 100..256, total = fq * face_k >> 8,
//   channel = channel * total_c >> 8, face_k = 204 (-x +x) 128 (-y) 256 (+y) 153 (-z +z).
//   LIGHT (vertex sky / block nibbles 0..15, interpolated perspective correct like ao, docs/mc/light.md):
//   s256 = floor(sky * day / 15 + 0.5), b256 = floor(block * 256 / 15 + 0.5) (day 0..256, raster_set_light),
//   per channel c: lum = max(s256, b256 * tint_c >> 8), lf_c = 24 + (lum * 232 >> 8), total_c = total * lf_c >> 8.
//   sky 15 / block 0 / day 256 gives lf = 256: the image is the same as without light.
//   Fog: t = clamp((z - start) / (end - start), 0, 1), f = floor(t * 256), colour = (c*(256-f) + fog*f) >> 8.
//
// The coverage rule makes the output a pure function of the inputs: same bits on every build stage,
// and the python reference (tools/mc/raster/ref.py) reproduces it byte for byte.
//
// BACKEND INTERFACE (docs/MC-RENDER.md 4): backend_upload_atlas / backend_mesh_upload / backend_mesh_free /
// backend_begin / backend_draw / backend_end / backend_present / backend_read_pixels are the functions a
// GPU backend has to provide with the same meaning; this file is the CPU implementation (and the reference).

import std.rt
import std.math
import html.mem
import std.crypto.sha256
import paint.canvas
import paint.png
import mc.mc_camera
import mc.mc_texture

export {
    Raster, Stats, raster_new, raster_free, raster_clear, raster_set_camera, raster_set_atlas,
    raster_set_fog, raster_set_cull, raster_set_edge_expand, raster_set_light, raster_draw_mesh, raster_draw_tri, raster_draw_tri8, VREC, raster_pixel,
    raster_hash, raster_hash_hex, raster_write_ppm, raster_write_png, raster_stats_reset,
    face_shade,
    backend_upload_atlas, backend_mesh_upload, backend_mesh_free, backend_begin, backend_draw,
    backend_end, backend_present, backend_read_pixels, backend_set_pass, backend_draw_entities, raster_draw_box,
    backend_set_fade, bayer8, backend_mesh_class, raster_draw_models, raster_draw_models_ex, MQ_WORDS,
}

const SLOT_WORDS: usize = 6
const MQ_WORDS: usize = 30 // f64 per model quad, see raster_draw_models

struct Stats {
    tris_in: u64, // triangles handed to the rasterizer
    tris_drawn: u64, // triangles that reached the pixel loop
    tris_culled: u64, // back faces
    tris_clipped: u64, // triangles cut by the near plane
    pixels: u64, // pixels written
}

struct Raster {
    w: i32,
    h: i32,
    color: u64, // u32 [w*h]
    depth: u64, // f64 [w*h]  1/z
    // camera (copied from mc_camera.Camera by raster_set_camera)
    cx: f64, cy: f64, cz: f64,
    rx: f64, ry: f64, rz: f64,
    ux: f64, uy: f64, uz: f64,
    fx: f64, fy: f64, fz: f64,
    near: f64,
    hw: f64, hh: f64, // half viewport
    fpx: f64, fpy: f64, // focal length in pixels
    // atlas
    apx: u64,
    atile: i32,
    acols: i32,
    aw: i32,
    // fog
    fog_on: bool,
    fog_start: f64,
    fog_end: f64,
    fog_r: u32, fog_g: u32, fog_b: u32,
    cull: bool,
    edge_exp: bool, // opaque pass: edges accept pixel centres ~1/64 px outside (default on, see draw_clipped_tri); off = exact top-left rule
    // light (raster_set_light)
    day: i64, // sky light multiplier 0..256
    tint_r: i64, tint_g: i64, tint_b: i64, // block light tint per channel 0..256
    lod_pass: bool, // PASS_LOD: opaque pass with the wider LOD edge expansion (LOD_EXP_DIV)
    trans: bool, // translucent pass: alpha blend over the colour buffer, depth test but NO depth write, alpha 0 = no write
    flat_on: bool, // flat colour mode (entity boxes): no texel fetch, colour flat_rgb (R | G << 8 | B << 16)
    flat_em: bool,
    flat_rgb: u32,
    skin_px: u64,
    skin_on: bool,
    skin_layer: i32,
    fade_a: i32, // LOD cross-fade (backend_set_fade): 64 = off; else a pixel is drawn where bayer8(x, y) < fade_a (fade_inv: >= fade_a)
    fade_inv: bool,
    mesh_cls: i32, // class of the NEXT backend_mesh_upload (backend_mesh_class): 2 = MESH_MODEL, 3 = MESH_MODEL_T (model quads, see raster_draw_models)
    qt: u32, // model quad tint (raster_draw_models): 0 = none, else R | G << 8 | B << 16 | 1 << 24, multiplies the texel (c * (t + 1) >> 8)
    // scratch
    vbuf: u64, // f64 [vcap * 8]
    vcap: usize,
    pa: u64, // f64 [8 * 8] clip input
    pb: u64, // f64 [8 * 8] clip output
    pc: u64, // f64 [3 * 8] raster_draw_tri converts 6 f64 records here
    // mesh slots (backend_mesh_upload): SLOT_WORDS u64 per slot = verts, nverts, idx, nidx, used, key
    slots: u64,
    slot_cap: usize,
    st: Stats,
}

// Vertex record = VREC f64: view x, view y, view z, u, v (tile units), ao, sky, block.
const VREC: usize = 8
// Darkest light factor out of 256 (sky 0 and block 0): caves are dim, not black.
const LIGHT_MIN: i64 = 24

fn ldd(p: u64, i: usize) -> f64 {
    return *((p + (i as u64) * (8 as u64)) as *mut f64)
}

fn stf(p: u64, i: usize, v: f64) {
    *((p + (i as u64) * (8 as u64)) as *mut f64) = v
}

fn raster_new(w: i32, h: i32) -> Raster {
    var r: Raster = Raster {
        w: w, h: h, color: 0, depth: 0,
        cx: 0.0, cy: 0.0, cz: 0.0, rx: -1.0, ry: 0.0, rz: 0.0, ux: 0.0, uy: 1.0, uz: 0.0,
        fx: 0.0, fy: 0.0, fz: 1.0, near: 0.05, hw: 0.0, hh: 0.0, fpx: 1.0, fpy: 1.0,
        apx: 0, atile: 16, acols: 16, aw: 256,
        fog_on: false, fog_start: 0.0, fog_end: 1.0, fog_r: 0 as u32, fog_g: 0 as u32, fog_b: 0 as u32,
        cull: true, edge_exp: true, day: 256, tint_r: 256, tint_g: 224, tint_b: 176, trans: false, lod_pass: false, flat_on: false, flat_rgb: 0 as u32, flat_em: false, skin_px: 0, skin_on: false, skin_layer: 0, fade_a: 64, fade_inv: false, mesh_cls: 0, qt: 0 as u32,
        vbuf: 0, vcap: 0, pa: 0, pb: 0, pc: 0, slots: 0, slot_cap: 0,
        st: Stats { tris_in: 0 as u64, tris_drawn: 0 as u64, tris_culled: 0 as u64, tris_clipped: 0 as u64, pixels: 0 as u64 },
    }
    if w < 1 || h < 1 { return r }
    let n: usize = (w as usize) * (h as usize)
    r.color = rt.heap_alloc(n * 4)
    r.depth = rt.heap_alloc(n * 8)
    r.pa = rt.heap_alloc(8 * VREC * 8)
    r.pb = rt.heap_alloc(8 * VREC * 8)
    r.pc = rt.heap_alloc(3 * VREC * 8)
    raster_clear(&r, 0xFF000000 as u32)
    return r
}

fn raster_free(r: *mut Raster) {
    if (*r).color != 0 {
        let n: usize = ((*r).w as usize) * ((*r).h as usize)
        rt.heap_free((*r).color, n * 4)
        rt.heap_free((*r).depth, n * 8)
        rt.heap_free((*r).pa, 8 * VREC * 8)
        rt.heap_free((*r).pb, 8 * VREC * 8)
        rt.heap_free((*r).pc, 3 * VREC * 8)
    }
    if (*r).vbuf != 0 { rt.heap_free((*r).vbuf, (*r).vcap * VREC * 8) }
    if (*r).slots != 0 { rt.heap_free((*r).slots, (*r).slot_cap * SLOT_WORDS * 8) }
    (*r).color = 0
    (*r).depth = 0
    (*r).vbuf = 0
    (*r).slots = 0
}

fn raster_stats_reset(r: *mut Raster) {
    (*r).st = Stats { tris_in: 0 as u64, tris_drawn: 0 as u64, tris_culled: 0 as u64, tris_clipped: 0 as u64, pixels: 0 as u64 }
}

// Fills the colour buffer with `rgba` (0xAABBGGRR) and the depth buffer with "infinitely far".
fn raster_clear(r: *mut Raster, rgba: u32) {
    let n: usize = ((*r).w as usize) * ((*r).h as usize)
    var i: usize = 0
    while i < n {
        rt.st32((*r).color, i, rgba)
        stf((*r).depth, i, 0.0)
        i = i + 1
    }
}

fn raster_set_camera(r: *mut Raster, c: *mut mc_camera.Camera) {
    (*r).cx = (*c).x
    (*r).cy = (*c).y
    (*r).cz = (*c).z
    (*r).rx = (*c).rx
    (*r).ry = (*c).ry
    (*r).rz = (*c).rz
    (*r).ux = (*c).ux
    (*r).uy = (*c).uy
    (*r).uz = (*c).uz
    (*r).fx = (*c).fx
    (*r).fy = (*c).fy
    (*r).fz = (*c).fz
    (*r).near = (*c).near
    (*r).hw = ((*r).w as f64) * 0.5
    (*r).hh = ((*r).h as f64) * 0.5
    (*r).fpx = (*r).hw / (*c).tan_x
    (*r).fpy = (*r).hh / (*c).tan_y
}

fn raster_set_atlas(r: *mut Raster, a: *mut mc_texture.Atlas) {
    (*r).apx = (*a).px
    (*r).atile = (*a).tile
    (*r).acols = (*a).cols
    (*r).aw = (*a).w
}

fn raster_set_fog(r: *mut Raster, on: bool, start: f64, end: f64, rgb_r: u32, rgb_g: u32, rgb_b: u32) {
    (*r).fog_on = on
    (*r).fog_start = start
    (*r).fog_end = end
    (*r).fog_r = rgb_r
    (*r).fog_g = rgb_g
    (*r).fog_b = rgb_b
}

// Light uniforms: day = sky light multiplier 0..256 (256 = full day, e.g. mc_sky.sky_light_day), tint = block
// light colour multipliers per channel 0..256 (warm: 256 224 176).
fn raster_set_light(r: *mut Raster, day: i32, tint_r: i32, tint_g: i32, tint_b: i32) {
    (*r).day = clamp256(day as i64)
    (*r).tint_r = clamp256(tint_r as i64)
    (*r).tint_g = clamp256(tint_g as i64)
    (*r).tint_b = clamp256(tint_b as i64)
}

fn clamp256(v: i64) -> i64 {
    if v < 0 as i64 { return 0 as i64 }
    if v > 256 as i64 { return 256 as i64 }
    return v
}

// light factor 24..256 of one channel (see the header): s256 = sky part, bl = block part (0..256), tint 0..256
fn light_factor(s256: i64, bl: i64, tint: i64) -> i64 {
    var lum: i64 = (bl * tint) / 256 as i64
    if s256 > lum { lum = s256 }
    return LIGHT_MIN + (lum * (256 as i64 - LIGHT_MIN)) / 256 as i64
}

// Edge expansion of the opaque pass on / off (default on). Off = the exact top-left rule everywhere (coverage unit tests).
fn raster_set_edge_expand(r: *mut Raster, on: bool) {
    (*r).edge_exp = on
}

fn raster_set_cull(r: *mut Raster, on: bool) {
    (*r).cull = on
}

fn raster_pixel(r: *mut Raster, x: i32, y: i32) -> u32 {
    if x < 0 || y < 0 || x >= (*r).w || y >= (*r).h { return 0 as u32 }
    return rt.ld32((*r).color, (y as usize) * ((*r).w as usize) + (x as usize))
}

// brightness of a face direction 0..5 (-x +x -y +y -z +z) out of 256
fn face_shade(face: u32) -> u32 {
    if face == 0 as u32 || face == 1 as u32 { return 204 as u32 }
    if face == 2 as u32 { return 128 as u32 }
    if face == 3 as u32 { return 256 as u32 }
    return 153 as u32
}

// ---- triangle ------------------------------------------------------------------------

// 8x8 ordered-dither (Bayer) threshold 0..63 of a pixel; the GL shader (lib/gpu/gl_mc.fi) uses the same bit formula
fn bayer8(x: i32, y: i32) -> i32 {
    let xr: i32 = (x ^ y) & 7
    let yy: i32 = y & 7
    return ((xr & 1) << 5) | ((yy & 1) << 4) | ((xr & 2) << 2) | ((yy & 2) << 1) | ((xr & 4) >> 1) | ((yy & 4) >> 2)
}

const LOD_EXP_DIV: i64 = 1

fn snap(v: f64) -> i64 {
    return math.floor(v * 16.0 + 0.5) as i64
}

const SPAN_NONE: i64 = 1099511627776 // "no pixel in this row"
const SPAN_MIN: i64 = 12 // boxes at most this many pixels wide skip the span setup

// floor(a / b) for b > 0.
fn floor_div(a: i64, b: i64) -> i64 {
    var q: i64 = a / b
    if a % b != 0 as i64 && a < 0 as i64 { q = q - 1 as i64 }
    return q
}

// Smallest k >= lo with c + s * k > 0 (c already includes the fill-rule bias). Returns a value above any real hi when
// no k exists (s == 0 and c <= 0).
fn iabs64(v: i64) -> i64 {
    if v < 0 as i64 { return 0 as i64 - v }
    return v
}

fn span_lo(lo: i64, c: i64, s: i64) -> i64 {
    if s == 0 as i64 {
        if c > 0 as i64 { return lo }
        return SPAN_NONE
    }
    if s > 0 as i64 {
        let k: i64 = floor_div(0 as i64 - c, s) + 1 as i64
        if k > lo { return k }
    }
    return lo
}

// Largest k <= hi with c + s * k > 0 (s < 0: k <= floor((c - 1) / -s)). Returns -(1 << 40) when no k exists.
fn span_hi(hi: i64, c: i64, s: i64) -> i64 {
    if s == 0 as i64 {
        if c > 0 as i64 { return hi }
        return 0 as i64 - SPAN_NONE
    }
    if s < 0 as i64 {
        let k: i64 = floor_div(c - 1 as i64, 0 as i64 - s)
        if k < hi { return k }
    }
    return hi
}

fn draw_clipped_tri(r: *mut Raster, a: u64, b: u64, c: u64, tile: u32, fk: u32) {
    // ---- screen space, fixed point
    let iz0: f64 = 1.0 / ldd(a, 2)
    let iz1: f64 = 1.0 / ldd(b, 2)
    let iz2: f64 = 1.0 / ldd(c, 2)
    let sx0: f64 = (*r).hw + (ldd(a, 0) * iz0) * (*r).fpx
    let sy0: f64 = (*r).hh - (ldd(a, 1) * iz0) * (*r).fpy
    let sx1: f64 = (*r).hw + (ldd(b, 0) * iz1) * (*r).fpx
    let sy1: f64 = (*r).hh - (ldd(b, 1) * iz1) * (*r).fpy
    let sx2: f64 = (*r).hw + (ldd(c, 0) * iz2) * (*r).fpx
    let sy2: f64 = (*r).hh - (ldd(c, 1) * iz2) * (*r).fpy
    let lim: f64 = 1000000.0
    if !(math.fabs(sx0) < lim && math.fabs(sy0) < lim && math.fabs(sx1) < lim && math.fabs(sy1) < lim
        && math.fabs(sx2) < lim && math.fabs(sy2) < lim) {
        return
    }
    let ax: i64 = snap(sx0)
    let ay: i64 = snap(sy0)
    var bx: i64 = snap(sx1)
    var by: i64 = snap(sy1)
    var cx: i64 = snap(sx2)
    var cy: i64 = snap(sy2)
    var area2: i64 = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)
    if area2 == 0 as i64 { return }
    if area2 > 0 as i64 {
        // back face (front faces are counter clockwise seen from outside = negative area with y down)
        if (*r).cull {
            (*r).st.tris_culled = (*r).st.tris_culled + 1 as u64
            return
        }
    }
    // attributes per vertex (swapped b / c when the winding is reversed so that area2 > 0 afterwards)
    let za: f64 = iz0
    var zb: f64 = iz1
    var zc: f64 = iz2
    let ua: f64 = ldd(a, 3) * iz0
    var ub: f64 = ldd(b, 3) * iz1
    var uc: f64 = ldd(c, 3) * iz2
    let va: f64 = ldd(a, 4) * iz0
    var vb: f64 = ldd(b, 4) * iz1
    var vc: f64 = ldd(c, 4) * iz2
    let oa: f64 = ldd(a, 5) * iz0
    var ob: f64 = ldd(b, 5) * iz1
    var oc: f64 = ldd(c, 5) * iz2
    let ka: f64 = ldd(a, 6) * iz0
    var kb: f64 = ldd(b, 6) * iz1
    var kc: f64 = ldd(c, 6) * iz2
    let la: f64 = ldd(a, 7) * iz0
    var lb: f64 = ldd(b, 7) * iz1
    var lc: f64 = ldd(c, 7) * iz2
    if area2 < 0 as i64 {
        let tx: i64 = bx
        let ty: i64 = by
        bx = cx
        by = cy
        cx = tx
        cy = ty
        let tz: f64 = zb
        zb = zc
        zc = tz
        let tu: f64 = ub
        ub = uc
        uc = tu
        let tv: f64 = vb
        vb = vc
        vc = tv
        let to: f64 = ob
        ob = oc
        oc = to
        let tk: f64 = kb
        kb = kc
        kc = tk
        let tl: f64 = lb
        lb = lc
        lc = tl
        area2 = 0 as i64 - area2
    }
    (*r).st.tris_drawn = (*r).st.tris_drawn + 1 as u64
    // ---- bounding box in pixels
    var minx: i64 = ax
    var maxx: i64 = ax
    var miny: i64 = ay
    var maxy: i64 = ay
    if bx < minx { minx = bx }
    if cx < minx { minx = cx }
    if bx > maxx { maxx = bx }
    if cx > maxx { maxx = cx }
    if by < miny { miny = by }
    if cy < miny { miny = cy }
    if by > maxy { maxy = by }
    if cy > maxy { maxy = cy }
    var px0: i64 = 0
    var py0: i64 = 0
    if minx > 0 as i64 { px0 = minx / 16 as i64 }
    if miny > 0 as i64 { py0 = miny / 16 as i64 }
    var px1: i64 = ((*r).w as i64) - 1
    var py1: i64 = ((*r).h as i64) - 1
    if maxx < 0 as i64 || maxy < 0 as i64 { return }
    if maxx / 16 as i64 < px1 { px1 = maxx / 16 as i64 }
    if maxy / 16 as i64 < py1 { py1 = maxy / 16 as i64 }
    if px0 > px1 || py0 > py1 { return }
    // ---- edge functions: w0 = E(b,c), w1 = E(c,a), w2 = E(a,b); E(p,q,x) = (qx-px)(xy-py) - (qy-py)(xx-px)
    // step per pixel in x: -dy * 16, in y: dx * 16
    let e0dx: i64 = cx - bx
    let e0dy: i64 = cy - by
    let e1dx: i64 = ax - cx
    let e1dy: i64 = ay - cy
    let e2dx: i64 = bx - ax
    let e2dy: i64 = by - ay
    var bias0: i64 = 0
    var bias1: i64 = 0
    var bias2: i64 = 0
    if e0dy < 0 as i64 || (e0dy == 0 as i64 && e0dx > 0 as i64) { bias0 = 1 }
    if e1dy < 0 as i64 || (e1dy == 0 as i64 && e1dx > 0 as i64) { bias1 = 1 }
    if e2dy < 0 as i64 || (e2dy == 0 as i64 && e2dx > 0 as i64) { bias2 = 1 }
    // Edge expansion (opaque pass only): each edge also accepts pixel centres up to ~1/3 snap unit (1/48 px) outside of it,
    // tol = (|dx| + |dy|) / 3 in E units (E = edge length * distance, l1 >= euclid). Neighbouring triangles whose shared vertices
    // snap one 1/16 px step apart (different section origins, T-junctions of greedy quads, a ray exactly on a block edge) leave a
    // 1 px see-through slit under the exact top-left rule; with the expansion they overlap instead (the depth test keeps the first).
    // Measured (tests/2861 C / 2917, LOD flight holes vs full detail): tol 0: 34 / 64..80, l1/4: 6 / 3..6 (best), l1/2: 7 / 5..8,
    // l1: 13 / 12..15, 3*l1: 37 / 33..42 (a wide band also grows the silhouette of full-detail columns).
    // r154 (18.10.): the divisor is 3 now (was 4). A T-junction vertex and the two line ends each snap up to 1/2 unit, so a crack can be up to
    // 1 unit wide; l1/4 per side left a 1-px pin hole (tests/2917 x62 y38, frame 4). /3: holes 1 -> 0, GL-vs-CPU chunk PSNR 36.9 -> 35.6 dB;
    // /2 closes it too but breaks the gpu gate (lit_* floor 38 dB). The LOD pass keeps its own wider band (LOD_EXP_DIV).
    // The translucent pass keeps the exact top-left rule (an overlap would blend twice). The python reference does the same.
    if (*r).edge_exp && !(*r).trans {
        var xdiv: i64 = 3 as i64
        if (*r).lod_pass { xdiv = LOD_EXP_DIV }
        bias0 = bias0 + (iabs64(e0dx) + iabs64(e0dy)) / xdiv
        bias1 = bias1 + (iabs64(e1dx) + iabs64(e1dy)) / xdiv
        bias2 = bias2 + (iabs64(e2dx) + iabs64(e2dy)) / xdiv
    }
    let area2f: f64 = area2 as f64
    let w: usize = (*r).w as usize
    let tsz: i32 = (*r).atile
    let tszf: f64 = tsz as f64
    let tmask: i64 = (tsz as i64) - 1
    let tcol: i64 = (((tile as i32) - 1) % (*r).acols) as i64
    let trow: i64 = (((tile as i32) - 1) / (*r).acols) as i64
    let tox: i64 = tcol * (tsz as i64)
    let toy: i64 = trow * (tsz as i64)
    let aw: i64 = (*r).aw as i64
    let fogd: f64 = (*r).fog_end - (*r).fog_start
    let dayf: f64 = (*r).day as f64
    var y: i64 = py0
    while y <= py1 {
        let pyf: i64 = y * 16 as i64 + 8 as i64
        var pxf: i64 = px0 * 16 as i64 + 8 as i64
        var E0: i64 = e0dx * (pyf - by) - e0dy * (pxf - bx)
        var E1: i64 = e1dx * (pyf - cy) - e1dy * (pxf - cx)
        var E2: i64 = e2dx * (pyf - ay) - e2dy * (pxf - ax)
        let s0: i64 = 0 as i64 - e0dy * 16 as i64
        let s1: i64 = 0 as i64 - e1dy * 16 as i64
        let s2: i64 = 0 as i64 - e2dy * 16 as i64
        // Exact covered span of this row: every edge value is linear in x, so "E + bias > 0" is a half-line in x. The
        // intersection is computed with integer floor division (no rounding, no tolerance), so exactly the pixels
        // the per-pixel test would accept are visited. Narrow boxes keep the plain scan (the divisions would cost more).
        var kmin: i64 = 0
        var kmax: i64 = px1 - px0
        if kmax >= SPAN_MIN {
            kmin = span_lo(kmin, E0 + bias0, s0)
            kmin = span_lo(kmin, E1 + bias1, s1)
            kmin = span_lo(kmin, E2 + bias2, s2)
            kmax = span_hi(kmax, E0 + bias0, s0)
            kmax = span_hi(kmax, E1 + bias1, s1)
            kmax = span_hi(kmax, E2 + bias2, s2)
            if kmin > kmax {
                y = y + 1 as i64
                continue
            }
            E0 = E0 + s0 * kmin
            E1 = E1 + s1 * kmin
            E2 = E2 + s2 * kmin
        }
        var x: i64 = px0 + kmin
        let xend: i64 = px0 + kmax
        while x <= xend {
            if E0 + bias0 > 0 as i64 && E1 + bias1 > 0 as i64 && E2 + bias2 > 0 as i64 {
                let f0: f64 = E0 as f64
                let f1: f64 = E1 as f64
                let f2: f64 = E2 as f64
                let sum: f64 = f0 * za + f1 * zb + f2 * zc
                let zinv: f64 = sum / area2f
                let idx: usize = (y as usize) * w + (x as usize)
                if zinv > ldd((*r).depth, idx) {
                    let u: f64 = (f0 * ua + f1 * ub + f2 * uc) / sum
                    let v: f64 = (f0 * va + f1 * vb + f2 * vc) / sum
                    let ao: f64 = (f0 * oa + f1 * ob + f2 * oc) / sum
                    let sk: f64 = (f0 * ka + f1 * kb + f2 * kc) / sum
                    let bk: f64 = (f0 * la + f1 * lb + f2 * lc) / sum
                    var tp: u32 = (*r).flat_rgb | 0xFF000000 as u32
                    if (*r).skin_on {
                        var sx: i64 = math.floor(u) as i64
                        var sy: i64 = math.floor(v) as i64
                        if sx < 0 as i64 { sx = 0 }
                        if sx > 63 as i64 { sx = 63 }
                        if sy < 0 as i64 { sy = 0 }
                        if sy > 63 as i64 { sy = 63 }
                        tp = rt.ld32((*r).skin_px, (((*r).skin_layer as i64) * 4096 as i64 + sy * 64 as i64 + sx) as usize)
                    } else if !(*r).flat_on {
                        let tx: i64 = (math.floor(u * tszf) as i64) & tmask
                        let ty: i64 = (math.floor(v * tszf) as i64) & tmask
                        tp = rt.ld32((*r).apx, ((toy + ty) * aw + tox + tx) as usize)
                    }
                    let alpha: u32 = tp >> 24 as u32
                    var visible: bool = alpha >= 128 as u32
                    if (*r).trans { visible = alpha >= 1 as u32 }
                    if visible && (*r).fade_a < 64 {
                        let bay: i32 = bayer8(x as i32, y as i32)
                        if (*r).fade_inv { visible = bay >= (*r).fade_a } else { visible = bay < (*r).fade_a }
                    }
                    if visible {
                        var fq: i64 = math.floor(100.0 + 52.0 * ao) as i64
                        if fq < 0 as i64 { fq = 0 }
                        if fq > 256 as i64 { fq = 256 }
                        let total: i64 = (fq * (fk as i64)) / 256 as i64
                        var s256: i64 = math.floor(sk * dayf / 15.0 + 0.5) as i64
                        var b256: i64 = math.floor(bk * 256.0 / 15.0 + 0.5) as i64
                        s256 = clamp256(s256)
                        b256 = clamp256(b256)
                        let tr: i64 = (total * light_factor(s256, b256, (*r).tint_r)) / 256 as i64
                        let tg: i64 = (total * light_factor(s256, b256, (*r).tint_g)) / 256 as i64
                        let tb: i64 = (total * light_factor(s256, b256, (*r).tint_b)) / 256 as i64
                        var t0r: i64 = (tp & 255 as u32) as i64
                        var t0g: i64 = ((tp >> 8 as u32) & 255 as u32) as i64
                        var t0b: i64 = ((tp >> 16 as u32) & 255 as u32) as i64
                        if (*r).qt != 0 as u32 {
                            t0r = (t0r * ((((*r).qt & 255 as u32) as i64) + 1 as i64)) / 256 as i64
                            t0g = (t0g * (((((*r).qt >> 8 as u32) & 255 as u32) as i64) + 1 as i64)) / 256 as i64
                            t0b = (t0b * (((((*r).qt >> 16 as u32) & 255 as u32) as i64) + 1 as i64)) / 256 as i64
                        }
                        var cr: i64 = (t0r * tr) / 256 as i64
                        var cg: i64 = (t0g * tg) / 256 as i64
                        var cb: i64 = (t0b * tb) / 256 as i64
                        if (*r).fog_on && !(*r).flat_em {
                            let z: f64 = 1.0 / zinv
                            var t: f64 = (z - (*r).fog_start) / fogd
                            if t < 0.0 { t = 0.0 }
                            if t > 1.0 { t = 1.0 }
                            let fg: i64 = math.floor(t * 256.0) as i64
                            cr = (cr * (256 as i64 - fg) + ((*r).fog_r as i64) * fg) / 256 as i64
                            cg = (cg * (256 as i64 - fg) + ((*r).fog_g as i64) * fg) / 256 as i64
                            cb = (cb * (256 as i64 - fg) + ((*r).fog_b as i64) * fg) / 256 as i64
                        }
                        if (*r).trans {
                            // src-alpha blend: (src * a + dst * (255 - a) + 127) / 255 per channel, depth is not written
                            let dst: u32 = rt.ld32((*r).color, idx)
                            let alpha_val: i64 = alpha as i64
                            cr = (cr * alpha_val + ((dst & 255 as u32) as i64) * (255 as i64 - alpha_val) + 127 as i64) / 255 as i64
                            cg = (cg * alpha_val + (((dst >> 8 as u32) & 255 as u32) as i64) * (255 as i64 - alpha_val) + 127 as i64) / 255 as i64
                            cb = (cb * alpha_val + (((dst >> 16 as u32) & 255 as u32) as i64) * (255 as i64 - alpha_val) + 127 as i64) / 255 as i64
                        } else {
                            stf((*r).depth, idx, zinv)
                        }
                        rt.st32((*r).color, idx, (cr as u32) | ((cg as u32) << 8 as u32) | ((cb as u32) << 16 as u32) | 0xFF000000 as u32)
                        (*r).st.pixels = (*r).st.pixels + 1 as u64
                    }
                }
            }
            E0 = E0 + s0
            E1 = E1 + s1
            E2 = E2 + s2
            pxf = pxf + 16 as i64
            x = x + 1 as i64
        }
        y = y + 1 as i64
    }
}

fn copy_vtx(dst: u64, di: usize, src: u64, si: usize) {
    var k: usize = 0
    while k < VREC {
        stf(dst, di * VREC + k, ldd(src, si * VREC + k))
        k = k + 1
    }
}

// Triangle from three view-space vertex records of 6 f64 each (x y z u v ao, at addresses a, b, c): no
// light attributes, the light is sky 15 / block 0. Clips against the near plane, culls, rasterizes.
// `tile` = atlas tile, `fk` = face brightness (face_shade).
fn raster_draw_tri(r: *mut Raster, a: u64, b: u64, c: u64, tile: u32, fk: u32) {
    let pc: u64 = (*r).pc
    var i: usize = 0
    while i < 3 {
        var src: u64 = a
        if i == 1 { src = b }
        if i == 2 { src = c }
        var k: usize = 0
        while k < 6 {
            stf(pc, i * VREC + k, ldd(src, k))
            k = k + 1
        }
        stf(pc, i * VREC + 6, 15.0)
        stf(pc, i * VREC + 7, 0.0)
        i = i + 1
    }
    raster_draw_tri8(r, pc, pc + (VREC * 8) as u64, pc + (VREC * 16) as u64, tile, fk)
}

// Same with 8 f64 records (x y z u v ao sky block).
fn raster_draw_tri8(r: *mut Raster, a: u64, b: u64, c: u64, tile: u32, fk: u32) {
    (*r).st.tris_in = (*r).st.tris_in + 1 as u64
    if tile == 0 as u32 { return }
    let near: f64 = (*r).near
    let za: f64 = ldd(a, 2)
    let zb: f64 = ldd(b, 2)
    let zc: f64 = ldd(c, 2)
    let ia: bool = za >= near
    let ib: bool = zb >= near
    let ic: bool = zc >= near
    if ia && ib && ic {
        draw_clipped_tri(r, a, b, c, tile, fk)
        return
    }
    if !ia && !ib && !ic { return }
    (*r).st.tris_clipped = (*r).st.tris_clipped + 1 as u64
    // Sutherland-Hodgman against z >= near
    let pa: u64 = (*r).pa
    let pb: u64 = (*r).pb
    copy_vtx(pa, 0, a, 0)
    copy_vtx(pa, 1, b, 0)
    copy_vtx(pa, 2, c, 0)
    var n: usize = 0
    var i: usize = 0
    while i < 3 {
        let j: usize = (i + 1) % 3
        let zi: f64 = ldd(pa, i * VREC + 2)
        let zj: f64 = ldd(pa, j * VREC + 2)
        let ini: bool = zi >= near
        let inj: bool = zj >= near
        if ini {
            copy_vtx(pb, n, pa, i)
            n = n + 1
        }
        if ini != inj {
            let t: f64 = (near - zi) / (zj - zi)
            var k: usize = 0
            while k < VREC {
                let vi: f64 = ldd(pa, i * VREC + k)
                let vj: f64 = ldd(pa, j * VREC + k)
                stf(pb, n * VREC + k, vi + (vj - vi) * t)
                k = k + 1
            }
            stf(pb, n * VREC + 2, near)
            n = n + 1
        }
        i = i + 1
    }
    if n >= 3 {
        draw_clipped_tri(r, pb, pb + (VREC * 8) as u64, pb + (VREC * 16) as u64, tile, fk)
    }
    if n >= 4 {
        draw_clipped_tri(r, pb, pb + (VREC * 16) as u64, pb + (VREC * 24) as u64, tile, fk)
    }
}

// ---- mesh ------------------------------------------------------------------------------

fn ensure_vbuf(r: *mut Raster, nverts: usize) {
    if nverts <= (*r).vcap { return }
    var cap: usize = (*r).vcap
    if cap < 256 { cap = 256 }
    while cap < nverts { cap = cap * 2 }
    if (*r).vbuf != 0 { rt.heap_free((*r).vbuf, (*r).vcap * VREC * 8) }
    (*r).vbuf = rt.heap_alloc(cap * VREC * 8)
    (*r).vcap = cap
}

// Draws one mc_mesh result: `verts` = nverts x 2 u32 (word0, word1), `idx` = nidx u32 (triangles),
// section origin (ox, oy, oz) in world block coordinates (the vertices are section relative 0..16).
fn raster_draw_mesh(r: *mut Raster, verts: u64, nverts: usize, idx: u64, nidx: usize, ox: f64, oy: f64, oz: f64) {
    if nverts == 0 || nidx < 3 { return }
    ensure_vbuf(r, nverts)
    let vb: u64 = (*r).vbuf
    var i: usize = 0
    while i < nverts {
        let w0: u32 = rt.ld32(verts, i * 2)
        let w1: u32 = rt.ld32(verts, i * 2 + 1)
        let wx: f64 = ox + ((w0 & 255 as u32) as f64)
        let wy: f64 = oy + (((w0 >> 8 as u32) & 255 as u32) as f64)
        let wz: f64 = oz + (((w0 >> 16 as u32) & 255 as u32) as f64)
        let rx: f64 = wx - (*r).cx
        let ry: f64 = wy - (*r).cy
        let rz: f64 = wz - (*r).cz
        stf(vb, i * VREC, rx * (*r).rx + ry * (*r).ry + rz * (*r).rz)
        stf(vb, i * VREC + 1, rx * (*r).ux + ry * (*r).uy + rz * (*r).uz)
        stf(vb, i * VREC + 2, rx * (*r).fx + ry * (*r).fy + rz * (*r).fz)
        stf(vb, i * VREC + 3, ((w1 >> 14 as u32) & 31 as u32) as f64)
        stf(vb, i * VREC + 4, ((w1 >> 19 as u32) & 31 as u32) as f64)
        stf(vb, i * VREC + 5, ((w0 >> 27 as u32) & 3 as u32) as f64)
        stf(vb, i * VREC + 6, ((w1 >> 24 as u32) & 15 as u32) as f64)
        stf(vb, i * VREC + 7, ((w1 >> 28 as u32) & 15 as u32) as f64)
        i = i + 1
    }
    var t: usize = 0
    while t + 2 < nidx {
        let i0: usize = rt.ld32(idx, t) as usize
        let i1: usize = rt.ld32(idx, t + 1) as usize
        let i2: usize = rt.ld32(idx, t + 2) as usize
        if i0 < nverts && i1 < nverts && i2 < nverts {
            let w0: u32 = rt.ld32(verts, i0 * 2)
            let w1: u32 = rt.ld32(verts, i0 * 2 + 1)
            let fk: u32 = face_shade((w0 >> 24 as u32) & 7 as u32)
            raster_draw_tri8(r, vb + (i0 * VREC * 8) as u64, vb + (i1 * VREC * 8) as u64, vb + (i2 * VREC * 8) as u64,
                w1 & 16383 as u32, fk)
        }
        t = t + 3
    }
}

// ---- model quads (MESH_MODEL, opt-in: lib/mc/mc_model_mesh.fi) ------------------------------------------------------

// One model quad = MQ_WORDS f64: x0..x3 (0..3), y0..y3 (4..7), z0..z3 (8..11) section relative block units, u0..u3 (12..15), v0..v3 (16..19) in
// TILE units (0..1 = the whole tile, v down), tile id (20), face brightness 0..256 (21, face_shade scale), sky (22), block (23) light 0..15,
// tint (24: R | G << 8 | B << 16 as a number, -1 = none; multiplies the texel), flags (25, bit 0 = translucent), ao0..ao3 (26..29, 0..3 like the cube
// mesher: 3 = open, 0 = fully occluded) per corner.
// Corners go round the quad; triangles (0 1 2) (0 2 3). Front faces are counter-clockwise seen from outside, like the mc_mesh quads.
fn raster_draw_models(r: *mut Raster, q: u64, nq: usize, ox: f64, oy: f64, oz: f64) {
    raster_draw_models_ex(r, q, nq, ox, oy, oz, false)
}

// Same with `sorted`: the quads are drawn FAR TO NEAR by the mean view depth of their corners (translucent mesh, MESH_MODEL_T): the blend order
// must not depend on the mesher's cell order.
fn raster_draw_models_ex(r: *mut Raster, q: u64, nq: usize, ox: f64, oy: f64, oz: f64, sorted: bool) {
    if nq == 0 { return }
    ensure_vbuf(r, 4)
    let vb: u64 = (*r).vbuf
    var ord: u64 = 0
    if sorted && nq > 1 {
        ord = rt.heap_alloc(nq * 16)
        var i0: usize = 0
        while i0 < nq {
            let b0: usize = i0 * MQ_WORDS
            var dsum: f64 = 0.0
            var k0: usize = 0
            while k0 < 4 {
                let ax: f64 = ox + ldd(q, b0 + k0) - (*r).cx
                let ay: f64 = oy + ldd(q, b0 + 4 + k0) - (*r).cy
                let az: f64 = oz + ldd(q, b0 + 8 + k0) - (*r).cz
                dsum = dsum + ax * (*r).fx + ay * (*r).fy + az * (*r).fz
                k0 = k0 + 1
            }
            stf(ord, nq + i0, dsum)
            rt.st64(ord, i0, i0 as u64)
            i0 = i0 + 1
        }
        // insertion sort, descending depth (stable); sections hold few translucent quads
        var a1: usize = 1
        while a1 < nq {
            let ki: u64 = rt.ld64(ord, a1)
            let kd: f64 = ldd(ord, nq + (ki as usize))
            var j: usize = a1
            while j > 0 && ldd(ord, nq + (rt.ld64(ord, j - 1) as usize)) < kd {
                rt.st64(ord, j, rt.ld64(ord, j - 1))
                j = j - 1
            }
            rt.st64(ord, j, ki)
            a1 = a1 + 1
        }
    }
    var i: usize = 0
    while i < nq {
        var qi: usize = i
        if ord != 0 { qi = rt.ld64(ord, i) as usize }
        let base: usize = qi * MQ_WORDS
        i = i + 1
        let tile: u32 = ldd(q, base + 20) as u32
        if tile == 0 as u32 { continue }
        var k: usize = 0
        while k < 4 {
            let rx: f64 = ox + ldd(q, base + k) - (*r).cx
            let ry: f64 = oy + ldd(q, base + 4 + k) - (*r).cy
            let rz: f64 = oz + ldd(q, base + 8 + k) - (*r).cz
            stf(vb, k * VREC, rx * (*r).rx + ry * (*r).ry + rz * (*r).rz)
            stf(vb, k * VREC + 1, rx * (*r).ux + ry * (*r).uy + rz * (*r).uz)
            stf(vb, k * VREC + 2, rx * (*r).fx + ry * (*r).fy + rz * (*r).fz)
            stf(vb, k * VREC + 3, ldd(q, base + 12 + k))
            stf(vb, k * VREC + 4, ldd(q, base + 16 + k))
            stf(vb, k * VREC + 5, ldd(q, base + 26 + k))
            stf(vb, k * VREC + 6, ldd(q, base + 22))
            stf(vb, k * VREC + 7, ldd(q, base + 23))
            k = k + 1
        }
        let tn: f64 = ldd(q, base + 24)
        if tn >= 0.0 { (*r).qt = (tn as u32) | 16777216 as u32 } else { (*r).qt = 0 as u32 }
        let fk: u32 = ldd(q, base + 21) as u32
        raster_draw_tri8(r, vb, vb + (VREC * 8) as u64, vb + (VREC * 16) as u64, tile, fk)
        raster_draw_tri8(r, vb, vb + (VREC * 16) as u64, vb + (VREC * 24) as u64, tile, fk)
    }
    (*r).qt = 0 as u32
    if ord != 0 { rt.heap_free(ord, nq * 16) }
}

// Class of the next backend_mesh_upload (0 / 1 = normal mesh, 2 = model quads: verts = nq * MQ_WORDS 8 byte units, idx = one dummy word).
fn backend_mesh_class(r: *mut Raster, c: i32) {
    (*r).mesh_cls = c
}

// ---- output -------------------------------------------------------------------------------

// SHA-256 over the colour buffer bytes (w*h*4, RGBA row major). out = 32 bytes at address `out`.
fn raster_hash(r: *mut Raster, out: u64) {
    sha256.sha256((*r).color, ((*r).w as usize) * ((*r).h as usize) * 4, out)
}

// Lower case hex of raster_hash into 64 bytes at address `out`.
fn raster_hash_hex(r: *mut Raster, out: u64) {
    let d: u64 = rt.heap_alloc(32)
    raster_hash(r, d)
    var i: usize = 0
    while i < 32 {
        let b: u32 = rt.ld8(d, i) as u32
        let hi: u32 = b >> 4 as u32
        let lo: u32 = b & 15 as u32
        var ch: u32 = 48 as u32 + hi
        if hi > 9 as u32 { ch = 87 as u32 + hi }
        rt.st8(out, i * 2, ch as u8)
        ch = 48 as u32 + lo
        if lo > 9 as u32 { ch = 87 as u32 + lo }
        rt.st8(out, i * 2 + 1, ch as u8)
        i = i + 1
    }
    rt.heap_free(d, 32)
}

fn to_canvas(r: *mut Raster, cv: *mut canvas.Canvas) -> bool {
    if !canvas.canvas_init(cv, (*r).w as usize, (*r).h as usize) { return false }
    let px: u64 = canvas.canvas_pixels(cv) as u64
    rt.mem_copy(px, (*r).color, ((*r).w as usize) * ((*r).h as usize) * 4)
    return true
}

fn raster_write_ppm(r: *mut Raster, path: u64) -> bool {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !to_canvas(r, &cv) { return false }
    var out: mem.Buf = mem.buf_new()
    png.write_ppm(&cv, &out)
    let ok: bool = rt.write_file(path, mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    mem.buf_free(&out)
    canvas.canvas_free(&cv)
    return ok
}

fn raster_write_png(r: *mut Raster, path: u64) -> bool {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !to_canvas(r, &cv) { return false }
    var out: mem.Buf = mem.buf_new()
    var ok: bool = png.write_png(&cv, &out)
    if ok { ok = rt.write_file(path, mem.buf_ptr(&out) as u64, mem.buf_len(&out)) }
    mem.buf_free(&out)
    canvas.canvas_free(&cv)
    return ok
}

// ---- backend interface (CPU implementation) -----------------------------------------------
// A GPU backend implements the same functions with the same meaning (docs/MC-RENDER.md 4).

fn backend_upload_atlas(r: *mut Raster, a: *mut mc_texture.Atlas) {
    raster_set_atlas(r, a)
}

// Copies a mesh into the backend; returns a handle (>= 1), 0 on failure. `key` is the caller's id
// (e.g. packed section coordinates) and is only stored.
fn backend_mesh_upload(r: *mut Raster, key: u64, verts: u64, nverts: usize, idx: u64, nidx: usize) -> usize {
    var s: usize = 0
    var found: bool = false
    while s < (*r).slot_cap {
        if rt.ld64((*r).slots, s * SLOT_WORDS + 4) == 0 as u64 {
            found = true
            break
        }
        s = s + 1
    }
    if !found {
        let ncap: usize = (*r).slot_cap * 2 + 64
        let ns: u64 = rt.heap_alloc(ncap * SLOT_WORDS * 8)
        if ns == 0 { return 0 }
        var i: usize = 0
        while i < ncap * SLOT_WORDS {
            var v: u64 = 0
            if i < (*r).slot_cap * SLOT_WORDS { v = rt.ld64((*r).slots, i) }
            rt.st64(ns, i, v)
            i = i + 1
        }
        if (*r).slots != 0 { rt.heap_free((*r).slots, (*r).slot_cap * SLOT_WORDS * 8) }
        s = (*r).slot_cap
        (*r).slots = ns
        (*r).slot_cap = ncap
    }
    var vp: u64 = 0
    var ip: u64 = 0
    if nverts > 0 {
        vp = rt.heap_alloc(nverts * 8)
        ip = rt.heap_alloc(nidx * 4)
        if vp == 0 || ip == 0 { return 0 }
        rt.mem_copy(vp, verts, nverts * 8)
        rt.mem_copy(ip, idx, nidx * 4)
    }
    let b: usize = s * SLOT_WORDS
    rt.st64((*r).slots, b, vp)
    rt.st64((*r).slots, b + 1, nverts as u64)
    rt.st64((*r).slots, b + 2, ip)
    rt.st64((*r).slots, b + 3, nidx as u64)
    if (*r).mesh_cls == 2 { rt.st64((*r).slots, b + 4, 2 as u64) } else if (*r).mesh_cls == 3 { rt.st64((*r).slots, b + 4, 3 as u64) } else { rt.st64((*r).slots, b + 4, 1 as u64) }
    rt.st64((*r).slots, b + 5, key)
    return s + 1
}

fn backend_mesh_free(r: *mut Raster, handle: usize) {
    if handle < 1 || handle > (*r).slot_cap { return }
    let b: usize = (handle - 1) * SLOT_WORDS
    if rt.ld64((*r).slots, b + 4) == 0 as u64 { return }
    let nv: usize = rt.ld64((*r).slots, b + 1) as usize
    let ni: usize = rt.ld64((*r).slots, b + 3) as usize
    if nv > 0 {
        rt.heap_free(rt.ld64((*r).slots, b), nv * 8)
        rt.heap_free(rt.ld64((*r).slots, b + 2), ni * 4)
    }
    rt.st64((*r).slots, b + 4, 0 as u64)
}

// New frame: camera + clear colour (sky). Depth is reset.
fn backend_begin(r: *mut Raster, c: *mut mc_camera.Camera, clear_rgba: u32) {
    raster_set_camera(r, c)
    raster_clear(r, clear_rgba)
}

// Draws the stored mesh `handle` with its section origin (world block coordinates).
fn backend_draw(r: *mut Raster, handle: usize, ox: f64, oy: f64, oz: f64) {
    if handle < 1 || handle > (*r).slot_cap { return }
    let b: usize = (handle - 1) * SLOT_WORDS
    if rt.ld64((*r).slots, b + 4) == 0 as u64 { return }
    if rt.ld64((*r).slots, b + 4) == 2 as u64 {
        raster_draw_models(r, rt.ld64((*r).slots, b), rt.ld64((*r).slots, b + 1) as usize / MQ_WORDS, ox, oy, oz)
        return
    }
    if rt.ld64((*r).slots, b + 4) == 3 as u64 {
        raster_draw_models_ex(r, rt.ld64((*r).slots, b), rt.ld64((*r).slots, b + 1) as usize / MQ_WORDS, ox, oy, oz, true)
        return
    }
    raster_draw_mesh(r, rt.ld64((*r).slots, b), rt.ld64((*r).slots, b + 1) as usize, rt.ld64((*r).slots, b + 2),
        rt.ld64((*r).slots, b + 3) as usize, ox, oy, oz)
}

fn backend_end(r: *mut Raster) {
    // nothing to flush on the CPU
    if (*r).color == 0 { return }
}

// CPU: the pixels are final after backend_end; a window layer converts them (RGBA -> BGRX).
// Returns the address of the colour buffer.
fn backend_present(r: *mut Raster) -> u64 {
    return (*r).color
}

fn backend_read_pixels(r: *mut Raster, out: u64) {
    rt.mem_copy(out, (*r).color, ((*r).w as usize) * ((*r).h as usize) * 4)
}

// PASS_OPAQUE (0) / PASS_TRANS (1): see mc_backend. The translucent pass blends over the colour buffer and keeps the depth.
fn backend_set_pass(r: *mut Raster, pass: i32) {
    (*r).trans = pass == 1
    (*r).lod_pass = pass == 2
}

// LOD cross-fade (docs/mc/lod.md): the following draws keep only the pixels with bayer8(x, y) < a (inv = false) or
// >= a (inv = true); a >= 64 = off. A fading-in and a fading-out mesh with the same `a` and opposite `inv` tile the
// screen exactly (screen-door), so there is no hole and no double cover between them.
fn backend_set_fade(r: *mut Raster, a: i32, inv: bool) {
    var v: i32 = a
    if v > 64 { v = 64 }
    if v < 0 { v = 0 }
    (*r).fade_a = v
    (*r).fade_inv = inv
}

// ---- entity boxes ---------------------------------------------------------------------------

// One flat coloured box (the reference of the instanced GL entity pass, lib/gpu/gl_ent_vs.glsl): centre (x, y, z) in world
// coordinates, size (sx, sy, sz) along the box axes, rotated about +Y by the yaw whose sine / cosine are given
// (p = (qx*c + qz*s, qy, -qx*s + qz*c)), colour 0..255. Shading = the world's with ao 3: channel * face_k >> 8, then fog.
// Faces and winding are those of mc_mesh (-x +x -y +y -z +z, counter clockwise from outside), so culling works.
fn raster_draw_box(r: *mut Raster, x: f64, y: f64, z: f64, sx: f64, sy: f64, sz: f64, ys: f64, yc: f64,
    cr: u32, cg: u32, cb: u32, em: bool) {
    ensure_vbuf(r, 4)
    let vb: u64 = (*r).vbuf
    let saved_on: bool = (*r).flat_on
    let saved_rgb: u32 = (*r).flat_rgb
    (*r).flat_on = true
    (*r).flat_em = em
    (*r).flat_rgb = (cr & 255 as u32) | ((cg & 255 as u32) << 8 as u32) | ((cb & 255 as u32) << 16 as u32)
    let half: [f64; 3] = [sx * 0.5, sy * 0.5, sz * 0.5]
    var f: usize = 0
    while f < 6 {
        let axis: usize = f / 2
        let ua: usize = (axis + 1) % 3
        let va: usize = (axis + 2) % 3
        var sgn: f64 = 0.0 - 1.0
        if f % 2 == 1 { sgn = 1.0 }
        var k: usize = 0
        while k < 4 {
            var su: f64 = 0.0 - 1.0
            var sv: f64 = 0.0 - 1.0
            if k == 1 || k == 2 { su = 1.0 }
            if k == 2 || k == 3 { sv = 1.0 }
            var q: [f64; 3] = [0.0, 0.0, 0.0]
            q[axis] = sgn * half[axis]
            q[ua] = su * half[ua]
            q[va] = sv * half[va]
            let wx: f64 = x + (q[0] * yc + q[2] * ys)
            let wy: f64 = y + q[1]
            let wz: f64 = z + (0.0 - q[0] * ys + q[2] * yc)
            let rx: f64 = wx - (*r).cx
            let ry: f64 = wy - (*r).cy
            let rz: f64 = wz - (*r).cz
            stf(vb, k * 6, rx * (*r).rx + ry * (*r).ry + rz * (*r).rz)
            stf(vb, k * 6 + 1, rx * (*r).ux + ry * (*r).uy + rz * (*r).uz)
            stf(vb, k * 6 + 2, rx * (*r).fx + ry * (*r).fy + rz * (*r).fz)
            stf(vb, k * 6 + 3, 0.0)
            stf(vb, k * 6 + 4, 0.0)
            stf(vb, k * 6 + 5, 3.0)
            k = k + 1
        }
        var fk: u32 = face_shade(f as u32)
        if em { fk = 256 as u32 }
        if f % 2 == 1 {
            raster_draw_tri(r, vb, vb + 48 as u64, vb + 96 as u64, 1 as u32, fk)
            raster_draw_tri(r, vb, vb + 96 as u64, vb + 144 as u64, 1 as u32, fk)
        } else {
            raster_draw_tri(r, vb, vb + 96 as u64, vb + 48 as u64, 1 as u32, fk)
            raster_draw_tri(r, vb, vb + 144 as u64, vb + 96 as u64, 1 as u32, fk)
        }
        f = f + 1
    }
    (*r).flat_on = saved_on
    (*r).flat_em = false
    (*r).flat_rgb = saved_rgb
}

// n boxes of mc_backend.ENT_WORDS f64 each (x y z sx sy sz sin cos r g b flags). Returns n.
fn backend_draw_entities(r: *mut Raster, recs: u64, n: usize) -> u64 {
    var i: usize = 0
    while i < n {
        let e: u64 = recs + (i * 96) as u64
        raster_draw_box(r, ldd(e, 0), ldd(e, 1), ldd(e, 2), ldd(e, 3), ldd(e, 4), ldd(e, 5), ldd(e, 6), ldd(e, 7),
            ldd(e, 8) as u32, ldd(e, 9) as u32, ldd(e, 10) as u32, ldd(e, 11) < 0.0 - 0.5)
        i = i + 1
    }
    return n as u64
}
