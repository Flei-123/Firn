// lib/mc/mc_raster.fi -- CPU software rasterizer for mc_mesh output (no GPU, no window).
//
// Framebuffer: RGBA8, one u32 per pixel (byte order R G B A, 0xAABBGGRR), always alpha 255 after a
// clear. Depth buffer: f64 per pixel holding 1/z (view depth); 0.0 = infinitely far, larger = nearer.
//
// PIPELINE per triangle (mc_mesh quads are two triangles, vertex words are decoded here):
//   1. vertex -> camera-relative f64 -> view space (x right, y up, z along the view direction),
//      always the same operation order (docs/mc/raster.md; the python reference repeats it)
//   2. near clipping against z = near (Sutherland-Hodgman, 3 -> up to 4 vertices, attributes linear in view space)
//   3. perspective division, snap to 1/16 pixel fixed point (i64); from here on EVERYTHING that decides
//      coverage is integer: area sign (back face culling), edge functions, top-left fill rule
//   4. per covered pixel (centre at +0.5): 1/z interpolation, depth test (strictly nearer wins),
//      perspective correct u, v, ao (f64, fixed operation order), nearest texel from mc_texture's atlas
//      (tile-local wrap, so greedy quads repeat), alpha < 128 = cutout (no write), shading, fog
//   Shading (all integer): fq = floor(100 + 52 * ao) in 100..256, total = fq * face_k >> 8,
//   channel = channel * total >> 8, face_k = 204 (-x +x) 128 (-y) 256 (+y) 153 (-z +z).
//   Fog: t = clamp((z - start) / (end - start), 0, 1), f = floor(t * 256), colour = (c*(256-f) + fog*f) >> 8.
//
// The coverage rule makes the output a pure function of the inputs: same bits on every build stage,
// and the python reference (tools/mc/raster/ref.py) reproduces it byte for byte.
//
// BACKEND INTERFACE (docs/MC-RENDER.md 4): backend_upload_atlas / backend_mesh_upload / backend_mesh_free /
// backend_begin / backend_draw / backend_end / backend_present / backend_read_pixels are the functions a
// GPU backend has to provide with the same meaning; this file is the CPU implementation (and the reference).

import std.rt
import std.math
import html.mem
import std.crypto.sha256
import paint.canvas
import paint.png
import mc.mc_camera
import mc.mc_texture

export {
    Raster, Stats, raster_new, raster_free, raster_clear, raster_set_camera, raster_set_atlas,
    raster_set_fog, raster_set_cull, raster_draw_mesh, raster_draw_tri, raster_pixel,
    raster_hash, raster_hash_hex, raster_write_ppm, raster_write_png, raster_stats_reset,
    face_shade,
    backend_upload_atlas, backend_mesh_upload, backend_mesh_free, backend_begin, backend_draw,
    backend_end, backend_present, backend_read_pixels,
}

const SLOT_WORDS: usize = 6

struct Stats {
    tris_in: u64, // triangles handed to the rasterizer
    tris_drawn: u64, // triangles that reached the pixel loop
    tris_culled: u64, // back faces
    tris_clipped: u64, // triangles cut by the near plane
    pixels: u64, // pixels written
}

struct Raster {
    w: i32,
    h: i32,
    color: u64, // u32 [w*h]
    depth: u64, // f64 [w*h]  1/z
    // camera (copied from mc_camera.Camera by raster_set_camera)
    cx: f64, cy: f64, cz: f64,
    rx: f64, ry: f64, rz: f64,
    ux: f64, uy: f64, uz: f64,
    fx: f64, fy: f64, fz: f64,
    near: f64,
    hw: f64, hh: f64, // half viewport
    fpx: f64, fpy: f64, // focal length in pixels
    // atlas
    apx: u64,
    atile: i32,
    acols: i32,
    aw: i32,
    // fog
    fog_on: bool,
    fog_start: f64,
    fog_end: f64,
    fog_r: u32, fog_g: u32, fog_b: u32,
    cull: bool,
    // scratch
    vbuf: u64, // f64 [vcap * 6]
    vcap: usize,
    pa: u64, // f64 [8 * 6] clip input
    pb: u64, // f64 [8 * 6] clip output
    // mesh slots (backend_mesh_upload): SLOT_WORDS u64 per slot = verts, nverts, idx, nidx, used, key
    slots: u64,
    slot_cap: usize,
    st: Stats,
}

fn ldd(p: u64, i: usize) -> f64 {
    return *((p + (i as u64) * (8 as u64)) as *mut f64)
}

fn stf(p: u64, i: usize, v: f64) {
    *((p + (i as u64) * (8 as u64)) as *mut f64) = v
}

fn raster_new(w: i32, h: i32) -> Raster {
    var r: Raster = Raster {
        w: w, h: h, color: 0, depth: 0,
        cx: 0.0, cy: 0.0, cz: 0.0, rx: -1.0, ry: 0.0, rz: 0.0, ux: 0.0, uy: 1.0, uz: 0.0,
        fx: 0.0, fy: 0.0, fz: 1.0, near: 0.05, hw: 0.0, hh: 0.0, fpx: 1.0, fpy: 1.0,
        apx: 0, atile: 16, acols: 16, aw: 256,
        fog_on: false, fog_start: 0.0, fog_end: 1.0, fog_r: 0 as u32, fog_g: 0 as u32, fog_b: 0 as u32,
        cull: true, vbuf: 0, vcap: 0, pa: 0, pb: 0, slots: 0, slot_cap: 0,
        st: Stats { tris_in: 0 as u64, tris_drawn: 0 as u64, tris_culled: 0 as u64, tris_clipped: 0 as u64, pixels: 0 as u64 },
    }
    if w < 1 || h < 1 { return r }
    let n: usize = (w as usize) * (h as usize)
    r.color = rt.heap_alloc(n * 4)
    r.depth = rt.heap_alloc(n * 8)
    r.pa = rt.heap_alloc(8 * 6 * 8)
    r.pb = rt.heap_alloc(8 * 6 * 8)
    raster_clear(&r, 0xFF000000 as u32)
    return r
}

fn raster_free(r: *mut Raster) {
    if (*r).color != 0 {
        let n: usize = ((*r).w as usize) * ((*r).h as usize)
        rt.heap_free((*r).color, n * 4)
        rt.heap_free((*r).depth, n * 8)
        rt.heap_free((*r).pa, 8 * 6 * 8)
        rt.heap_free((*r).pb, 8 * 6 * 8)
    }
    if (*r).vbuf != 0 { rt.heap_free((*r).vbuf, (*r).vcap * 6 * 8) }
    if (*r).slots != 0 { rt.heap_free((*r).slots, (*r).slot_cap * SLOT_WORDS * 8) }
    (*r).color = 0
    (*r).depth = 0
    (*r).vbuf = 0
    (*r).slots = 0
}

fn raster_stats_reset(r: *mut Raster) {
    (*r).st = Stats { tris_in: 0 as u64, tris_drawn: 0 as u64, tris_culled: 0 as u64, tris_clipped: 0 as u64, pixels: 0 as u64 }
}

// Fills the colour buffer with `rgba` (0xAABBGGRR) and the depth buffer with "infinitely far".
fn raster_clear(r: *mut Raster, rgba: u32) {
    let n: usize = ((*r).w as usize) * ((*r).h as usize)
    var i: usize = 0
    while i < n {
        rt.st32((*r).color, i, rgba)
        stf((*r).depth, i, 0.0)
        i = i + 1
    }
}

fn raster_set_camera(r: *mut Raster, c: *mut mc_camera.Camera) {
    (*r).cx = (*c).x
    (*r).cy = (*c).y
    (*r).cz = (*c).z
    (*r).rx = (*c).rx
    (*r).ry = (*c).ry
    (*r).rz = (*c).rz
    (*r).ux = (*c).ux
    (*r).uy = (*c).uy
    (*r).uz = (*c).uz
    (*r).fx = (*c).fx
    (*r).fy = (*c).fy
    (*r).fz = (*c).fz
    (*r).near = (*c).near
    (*r).hw = ((*r).w as f64) * 0.5
    (*r).hh = ((*r).h as f64) * 0.5
    (*r).fpx = (*r).hw / (*c).tan_x
    (*r).fpy = (*r).hh / (*c).tan_y
}

fn raster_set_atlas(r: *mut Raster, a: *mut mc_texture.Atlas) {
    (*r).apx = (*a).px
    (*r).atile = (*a).tile
    (*r).acols = (*a).cols
    (*r).aw = (*a).w
}

fn raster_set_fog(r: *mut Raster, on: bool, start: f64, end: f64, rgb_r: u32, rgb_g: u32, rgb_b: u32) {
    (*r).fog_on = on
    (*r).fog_start = start
    (*r).fog_end = end
    (*r).fog_r = rgb_r
    (*r).fog_g = rgb_g
    (*r).fog_b = rgb_b
}

fn raster_set_cull(r: *mut Raster, on: bool) {
    (*r).cull = on
}

fn raster_pixel(r: *mut Raster, x: i32, y: i32) -> u32 {
    if x < 0 || y < 0 || x >= (*r).w || y >= (*r).h { return 0 as u32 }
    return rt.ld32((*r).color, (y as usize) * ((*r).w as usize) + (x as usize))
}

// brightness of a face direction 0..5 (-x +x -y +y -z +z) out of 256
fn face_shade(face: u32) -> u32 {
    if face == 0 as u32 || face == 1 as u32 { return 204 as u32 }
    if face == 2 as u32 { return 128 as u32 }
    if face == 3 as u32 { return 256 as u32 }
    return 153 as u32
}

// ---- triangle ------------------------------------------------------------------------

// Vertex record = 6 f64 at address p: view x, view y, view z, u, v, ao (u, v in tile units).
fn snap(v: f64) -> i64 {
    return math.floor(v * 16.0 + 0.5) as i64
}

fn draw_clipped_tri(r: *mut Raster, a: u64, b: u64, c: u64, tile: u32, fk: u32) {
    // ---- screen space, fixed point
    let iz0: f64 = 1.0 / ldd(a, 2)
    let iz1: f64 = 1.0 / ldd(b, 2)
    let iz2: f64 = 1.0 / ldd(c, 2)
    let sx0: f64 = (*r).hw + (ldd(a, 0) * iz0) * (*r).fpx
    let sy0: f64 = (*r).hh - (ldd(a, 1) * iz0) * (*r).fpy
    let sx1: f64 = (*r).hw + (ldd(b, 0) * iz1) * (*r).fpx
    let sy1: f64 = (*r).hh - (ldd(b, 1) * iz1) * (*r).fpy
    let sx2: f64 = (*r).hw + (ldd(c, 0) * iz2) * (*r).fpx
    let sy2: f64 = (*r).hh - (ldd(c, 1) * iz2) * (*r).fpy
    let lim: f64 = 1000000.0
    if !(math.fabs(sx0) < lim && math.fabs(sy0) < lim && math.fabs(sx1) < lim && math.fabs(sy1) < lim
        && math.fabs(sx2) < lim && math.fabs(sy2) < lim) {
        return
    }
    var ax: i64 = snap(sx0)
    var ay: i64 = snap(sy0)
    var bx: i64 = snap(sx1)
    var by: i64 = snap(sy1)
    var cx: i64 = snap(sx2)
    var cy: i64 = snap(sy2)
    var area2: i64 = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)
    if area2 == 0 as i64 { return }
    if area2 > 0 as i64 {
        // back face (front faces are counter clockwise seen from outside = negative area with y down)
        if (*r).cull {
            (*r).st.tris_culled = (*r).st.tris_culled + 1 as u64
            return
        }
    }
    // attributes per vertex (swapped b / c when the winding is reversed so that area2 > 0 afterwards)
    var za: f64 = iz0
    var zb: f64 = iz1
    var zc: f64 = iz2
    var ua: f64 = ldd(a, 3) * iz0
    var ub: f64 = ldd(b, 3) * iz1
    var uc: f64 = ldd(c, 3) * iz2
    var va: f64 = ldd(a, 4) * iz0
    var vb: f64 = ldd(b, 4) * iz1
    var vc: f64 = ldd(c, 4) * iz2
    var oa: f64 = ldd(a, 5) * iz0
    var ob: f64 = ldd(b, 5) * iz1
    var oc: f64 = ldd(c, 5) * iz2
    if area2 < 0 as i64 {
        let tx: i64 = bx
        let ty: i64 = by
        bx = cx
        by = cy
        cx = tx
        cy = ty
        let tz: f64 = zb
        zb = zc
        zc = tz
        let tu: f64 = ub
        ub = uc
        uc = tu
        let tv: f64 = vb
        vb = vc
        vc = tv
        let to: f64 = ob
        ob = oc
        oc = to
        area2 = 0 as i64 - area2
    }
    (*r).st.tris_drawn = (*r).st.tris_drawn + 1 as u64
    // ---- bounding box in pixels
    var minx: i64 = ax
    var maxx: i64 = ax
    var miny: i64 = ay
    var maxy: i64 = ay
    if bx < minx { minx = bx }
    if cx < minx { minx = cx }
    if bx > maxx { maxx = bx }
    if cx > maxx { maxx = cx }
    if by < miny { miny = by }
    if cy < miny { miny = cy }
    if by > maxy { maxy = by }
    if cy > maxy { maxy = cy }
    var px0: i64 = 0
    var py0: i64 = 0
    if minx > 0 as i64 { px0 = minx / 16 as i64 }
    if miny > 0 as i64 { py0 = miny / 16 as i64 }
    var px1: i64 = ((*r).w as i64) - 1
    var py1: i64 = ((*r).h as i64) - 1
    if maxx < 0 as i64 || maxy < 0 as i64 { return }
    if maxx / 16 as i64 < px1 { px1 = maxx / 16 as i64 }
    if maxy / 16 as i64 < py1 { py1 = maxy / 16 as i64 }
    if px0 > px1 || py0 > py1 { return }
    // ---- edge functions: w0 = E(b,c), w1 = E(c,a), w2 = E(a,b); E(p,q,x) = (qx-px)(xy-py) - (qy-py)(xx-px)
    // step per pixel in x: -dy * 16, in y: dx * 16
    let e0dx: i64 = cx - bx
    let e0dy: i64 = cy - by
    let e1dx: i64 = ax - cx
    let e1dy: i64 = ay - cy
    let e2dx: i64 = bx - ax
    let e2dy: i64 = by - ay
    var bias0: i64 = 0
    var bias1: i64 = 0
    var bias2: i64 = 0
    if e0dy < 0 as i64 || (e0dy == 0 as i64 && e0dx > 0 as i64) { bias0 = 1 }
    if e1dy < 0 as i64 || (e1dy == 0 as i64 && e1dx > 0 as i64) { bias1 = 1 }
    if e2dy < 0 as i64 || (e2dy == 0 as i64 && e2dx > 0 as i64) { bias2 = 1 }
    let area2f: f64 = area2 as f64
    let w: usize = (*r).w as usize
    let tsz: i32 = (*r).atile
    let tszf: f64 = tsz as f64
    let tmask: i64 = (tsz as i64) - 1
    let tcol: i64 = (((tile as i32) - 1) % (*r).acols) as i64
    let trow: i64 = (((tile as i32) - 1) / (*r).acols) as i64
    let tox: i64 = tcol * (tsz as i64)
    let toy: i64 = trow * (tsz as i64)
    let aw: i64 = (*r).aw as i64
    let fogd: f64 = (*r).fog_end - (*r).fog_start
    var y: i64 = py0
    while y <= py1 {
        let pyf: i64 = y * 16 as i64 + 8 as i64
        var pxf: i64 = px0 * 16 as i64 + 8 as i64
        var E0: i64 = e0dx * (pyf - by) - e0dy * (pxf - bx)
        var E1: i64 = e1dx * (pyf - cy) - e1dy * (pxf - cx)
        var E2: i64 = e2dx * (pyf - ay) - e2dy * (pxf - ax)
        let s0: i64 = 0 as i64 - e0dy * 16 as i64
        let s1: i64 = 0 as i64 - e1dy * 16 as i64
        let s2: i64 = 0 as i64 - e2dy * 16 as i64
        var x: i64 = px0
        while x <= px1 {
            if E0 + bias0 > 0 as i64 && E1 + bias1 > 0 as i64 && E2 + bias2 > 0 as i64 {
                let f0: f64 = E0 as f64
                let f1: f64 = E1 as f64
                let f2: f64 = E2 as f64
                let sum: f64 = f0 * za + f1 * zb + f2 * zc
                let zinv: f64 = sum / area2f
                let idx: usize = (y as usize) * w + (x as usize)
                if zinv > ldd((*r).depth, idx) {
                    let u: f64 = (f0 * ua + f1 * ub + f2 * uc) / sum
                    let v: f64 = (f0 * va + f1 * vb + f2 * vc) / sum
                    let ao: f64 = (f0 * oa + f1 * ob + f2 * oc) / sum
                    let tx: i64 = (math.floor(u * tszf) as i64) & tmask
                    let ty: i64 = (math.floor(v * tszf) as i64) & tmask
                    let tp: u32 = rt.ld32((*r).apx, ((toy + ty) * aw + tox + tx) as usize)
                    if (tp >> 24 as u32) >= 128 as u32 {
                        var fq: i64 = math.floor(100.0 + 52.0 * ao) as i64
                        if fq < 0 as i64 { fq = 0 }
                        if fq > 256 as i64 { fq = 256 }
                        let total: i64 = (fq * (fk as i64)) / 256 as i64
                        var cr: i64 = (((tp & 255 as u32) as i64) * total) / 256 as i64
                        var cg: i64 = ((((tp >> 8 as u32) & 255 as u32) as i64) * total) / 256 as i64
                        var cb: i64 = ((((tp >> 16 as u32) & 255 as u32) as i64) * total) / 256 as i64
                        if (*r).fog_on {
                            let z: f64 = 1.0 / zinv
                            var t: f64 = (z - (*r).fog_start) / fogd
                            if t < 0.0 { t = 0.0 }
                            if t > 1.0 { t = 1.0 }
                            let fg: i64 = math.floor(t * 256.0) as i64
                            cr = (cr * (256 as i64 - fg) + ((*r).fog_r as i64) * fg) / 256 as i64
                            cg = (cg * (256 as i64 - fg) + ((*r).fog_g as i64) * fg) / 256 as i64
                            cb = (cb * (256 as i64 - fg) + ((*r).fog_b as i64) * fg) / 256 as i64
                        }
                        stf((*r).depth, idx, zinv)
                        rt.st32((*r).color, idx, (cr as u32) | ((cg as u32) << 8 as u32) | ((cb as u32) << 16 as u32) | 0xFF000000 as u32)
                        (*r).st.pixels = (*r).st.pixels + 1 as u64
                    }
                }
            }
            E0 = E0 + s0
            E1 = E1 + s1
            E2 = E2 + s2
            pxf = pxf + 16 as i64
            x = x + 1 as i64
        }
        y = y + 1 as i64
    }
}

fn copy_vtx(dst: u64, di: usize, src: u64, si: usize) {
    var k: usize = 0
    while k < 6 {
        stf(dst, di * 6 + k, ldd(src, si * 6 + k))
        k = k + 1
    }
}

// Triangle from three view-space vertex records (6 f64 each, at addresses a, b, c). Clips against the
// near plane, culls, rasterizes. `tile` = atlas tile, `fk` = face brightness (face_shade).
fn raster_draw_tri(r: *mut Raster, a: u64, b: u64, c: u64, tile: u32, fk: u32) {
    (*r).st.tris_in = (*r).st.tris_in + 1 as u64
    if tile == 0 as u32 { return }
    let near: f64 = (*r).near
    let za: f64 = ldd(a, 2)
    let zb: f64 = ldd(b, 2)
    let zc: f64 = ldd(c, 2)
    let ia: bool = za >= near
    let ib: bool = zb >= near
    let ic: bool = zc >= near
    if ia && ib && ic {
        draw_clipped_tri(r, a, b, c, tile, fk)
        return
    }
    if !ia && !ib && !ic { return }
    (*r).st.tris_clipped = (*r).st.tris_clipped + 1 as u64
    // Sutherland-Hodgman against z >= near
    let pa: u64 = (*r).pa
    let pb: u64 = (*r).pb
    copy_vtx(pa, 0, a, 0)
    copy_vtx(pa, 1, b, 0)
    copy_vtx(pa, 2, c, 0)
    var n: usize = 0
    var i: usize = 0
    while i < 3 {
        let j: usize = (i + 1) % 3
        let zi: f64 = ldd(pa, i * 6 + 2)
        let zj: f64 = ldd(pa, j * 6 + 2)
        let ini: bool = zi >= near
        let inj: bool = zj >= near
        if ini {
            copy_vtx(pb, n, pa, i)
            n = n + 1
        }
        if ini != inj {
            let t: f64 = (near - zi) / (zj - zi)
            var k: usize = 0
            while k < 6 {
                let vi: f64 = ldd(pa, i * 6 + k)
                let vj: f64 = ldd(pa, j * 6 + k)
                stf(pb, n * 6 + k, vi + (vj - vi) * t)
                k = k + 1
            }
            stf(pb, n * 6 + 2, near)
            n = n + 1
        }
        i = i + 1
    }
    if n >= 3 {
        draw_clipped_tri(r, pb, pb + (6 * 8) as u64, pb + (12 * 8) as u64, tile, fk)
    }
    if n >= 4 {
        draw_clipped_tri(r, pb, pb + (12 * 8) as u64, pb + (18 * 8) as u64, tile, fk)
    }
}

// ---- mesh ------------------------------------------------------------------------------

fn ensure_vbuf(r: *mut Raster, nverts: usize) {
    if nverts <= (*r).vcap { return }
    var cap: usize = (*r).vcap
    if cap < 256 { cap = 256 }
    while cap < nverts { cap = cap * 2 }
    if (*r).vbuf != 0 { rt.heap_free((*r).vbuf, (*r).vcap * 6 * 8) }
    (*r).vbuf = rt.heap_alloc(cap * 6 * 8)
    (*r).vcap = cap
}

// Draws one mc_mesh result: `verts` = nverts x 2 u32 (word0, word1), `idx` = nidx u32 (triangles),
// section origin (ox, oy, oz) in world block coordinates (the vertices are section relative 0..16).
fn raster_draw_mesh(r: *mut Raster, verts: u64, nverts: usize, idx: u64, nidx: usize, ox: f64, oy: f64, oz: f64) {
    if nverts == 0 || nidx < 3 { return }
    ensure_vbuf(r, nverts)
    let vb: u64 = (*r).vbuf
    var i: usize = 0
    while i < nverts {
        let w0: u32 = rt.ld32(verts, i * 2)
        let w1: u32 = rt.ld32(verts, i * 2 + 1)
        let wx: f64 = ox + ((w0 & 255 as u32) as f64)
        let wy: f64 = oy + (((w0 >> 8 as u32) & 255 as u32) as f64)
        let wz: f64 = oz + (((w0 >> 16 as u32) & 255 as u32) as f64)
        let rx: f64 = wx - (*r).cx
        let ry: f64 = wy - (*r).cy
        let rz: f64 = wz - (*r).cz
        stf(vb, i * 6, rx * (*r).rx + ry * (*r).ry + rz * (*r).rz)
        stf(vb, i * 6 + 1, rx * (*r).ux + ry * (*r).uy + rz * (*r).uz)
        stf(vb, i * 6 + 2, rx * (*r).fx + ry * (*r).fy + rz * (*r).fz)
        stf(vb, i * 6 + 3, ((w1 >> 16 as u32) & 255 as u32) as f64)
        stf(vb, i * 6 + 4, ((w1 >> 24 as u32) & 255 as u32) as f64)
        stf(vb, i * 6 + 5, ((w0 >> 27 as u32) & 3 as u32) as f64)
        i = i + 1
    }
    var t: usize = 0
    while t + 2 < nidx {
        let i0: usize = rt.ld32(idx, t) as usize
        let i1: usize = rt.ld32(idx, t + 1) as usize
        let i2: usize = rt.ld32(idx, t + 2) as usize
        if i0 < nverts && i1 < nverts && i2 < nverts {
            let w0: u32 = rt.ld32(verts, i0 * 2)
            let w1: u32 = rt.ld32(verts, i0 * 2 + 1)
            let fk: u32 = face_shade((w0 >> 24 as u32) & 7 as u32)
            raster_draw_tri(r, vb + (i0 * 48) as u64, vb + (i1 * 48) as u64, vb + (i2 * 48) as u64, w1 & 65535 as u32, fk)
        }
        t = t + 3
    }
}

// ---- output -------------------------------------------------------------------------------

// SHA-256 over the colour buffer bytes (w*h*4, RGBA row major). out = 32 bytes at address `out`.
fn raster_hash(r: *mut Raster, out: u64) {
    sha256.sha256((*r).color, ((*r).w as usize) * ((*r).h as usize) * 4, out)
}

// Lower case hex of raster_hash into 64 bytes at address `out`.
fn raster_hash_hex(r: *mut Raster, out: u64) {
    let d: u64 = rt.heap_alloc(32)
    raster_hash(r, d)
    var i: usize = 0
    while i < 32 {
        let b: u32 = rt.ld8(d, i) as u32
        let hi: u32 = b >> 4 as u32
        let lo: u32 = b & 15 as u32
        var ch: u32 = 48 as u32 + hi
        if hi > 9 as u32 { ch = 87 as u32 + hi }
        rt.st8(out, i * 2, ch as u8)
        ch = 48 as u32 + lo
        if lo > 9 as u32 { ch = 87 as u32 + lo }
        rt.st8(out, i * 2 + 1, ch as u8)
        i = i + 1
    }
    rt.heap_free(d, 32)
}

fn to_canvas(r: *mut Raster, cv: *mut canvas.Canvas) -> bool {
    if !canvas.canvas_init(cv, (*r).w as usize, (*r).h as usize) { return false }
    let px: u64 = canvas.canvas_pixels(cv) as u64
    rt.mem_copy(px, (*r).color, ((*r).w as usize) * ((*r).h as usize) * 4)
    return true
}

fn raster_write_ppm(r: *mut Raster, path: u64) -> bool {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !to_canvas(r, &cv) { return false }
    var out: mem.Buf = mem.buf_new()
    png.write_ppm(&cv, &out)
    let ok: bool = rt.write_file(path, mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    mem.buf_free(&out)
    canvas.canvas_free(&cv)
    return ok
}

fn raster_write_png(r: *mut Raster, path: u64) -> bool {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !to_canvas(r, &cv) { return false }
    var out: mem.Buf = mem.buf_new()
    var ok: bool = png.write_png(&cv, &out)
    if ok { ok = rt.write_file(path, mem.buf_ptr(&out) as u64, mem.buf_len(&out)) }
    mem.buf_free(&out)
    canvas.canvas_free(&cv)
    return ok
}

// ---- backend interface (CPU implementation) -----------------------------------------------
// A GPU backend implements the same functions with the same meaning (docs/MC-RENDER.md 4).

fn backend_upload_atlas(r: *mut Raster, a: *mut mc_texture.Atlas) {
    raster_set_atlas(r, a)
}

// Copies a mesh into the backend; returns a handle (>= 1), 0 on failure. `key` is the caller's id
// (e.g. packed section coordinates) and is only stored.
fn backend_mesh_upload(r: *mut Raster, key: u64, verts: u64, nverts: usize, idx: u64, nidx: usize) -> usize {
    var s: usize = 0
    var found: bool = false
    while s < (*r).slot_cap {
        if rt.ld64((*r).slots, s * SLOT_WORDS + 4) == 0 as u64 {
            found = true
            break
        }
        s = s + 1
    }
    if !found {
        let ncap: usize = (*r).slot_cap * 2 + 64
        let ns: u64 = rt.heap_alloc(ncap * SLOT_WORDS * 8)
        if ns == 0 { return 0 }
        var i: usize = 0
        while i < ncap * SLOT_WORDS {
            var v: u64 = 0
            if i < (*r).slot_cap * SLOT_WORDS { v = rt.ld64((*r).slots, i) }
            rt.st64(ns, i, v)
            i = i + 1
        }
        if (*r).slots != 0 { rt.heap_free((*r).slots, (*r).slot_cap * SLOT_WORDS * 8) }
        s = (*r).slot_cap
        (*r).slots = ns
        (*r).slot_cap = ncap
    }
    var vp: u64 = 0
    var ip: u64 = 0
    if nverts > 0 {
        vp = rt.heap_alloc(nverts * 8)
        ip = rt.heap_alloc(nidx * 4)
        if vp == 0 || ip == 0 { return 0 }
        rt.mem_copy(vp, verts, nverts * 8)
        rt.mem_copy(ip, idx, nidx * 4)
    }
    let b: usize = s * SLOT_WORDS
    rt.st64((*r).slots, b, vp)
    rt.st64((*r).slots, b + 1, nverts as u64)
    rt.st64((*r).slots, b + 2, ip)
    rt.st64((*r).slots, b + 3, nidx as u64)
    rt.st64((*r).slots, b + 4, 1 as u64)
    rt.st64((*r).slots, b + 5, key)
    return s + 1
}

fn backend_mesh_free(r: *mut Raster, handle: usize) {
    if handle < 1 || handle > (*r).slot_cap { return }
    let b: usize = (handle - 1) * SLOT_WORDS
    if rt.ld64((*r).slots, b + 4) == 0 as u64 { return }
    let nv: usize = rt.ld64((*r).slots, b + 1) as usize
    let ni: usize = rt.ld64((*r).slots, b + 3) as usize
    if nv > 0 {
        rt.heap_free(rt.ld64((*r).slots, b), nv * 8)
        rt.heap_free(rt.ld64((*r).slots, b + 2), ni * 4)
    }
    rt.st64((*r).slots, b + 4, 0 as u64)
}

// New frame: camera + clear colour (sky). Depth is reset.
fn backend_begin(r: *mut Raster, c: *mut mc_camera.Camera, clear_rgba: u32) {
    raster_set_camera(r, c)
    raster_clear(r, clear_rgba)
}

// Draws the stored mesh `handle` with its section origin (world block coordinates).
fn backend_draw(r: *mut Raster, handle: usize, ox: f64, oy: f64, oz: f64) {
    if handle < 1 || handle > (*r).slot_cap { return }
    let b: usize = (handle - 1) * SLOT_WORDS
    if rt.ld64((*r).slots, b + 4) == 0 as u64 { return }
    raster_draw_mesh(r, rt.ld64((*r).slots, b), rt.ld64((*r).slots, b + 1) as usize, rt.ld64((*r).slots, b + 2),
        rt.ld64((*r).slots, b + 3) as usize, ox, oy, oz)
}

fn backend_end(r: *mut Raster) {
    // nothing to flush on the CPU
    if (*r).color == 0 { return }
}

// CPU: the pixels are final after backend_end; a window layer converts them (RGBA -> BGRX).
// Returns the address of the colour buffer.
fn backend_present(r: *mut Raster) -> u64 {
    return (*r).color
}

fn backend_read_pixels(r: *mut Raster, out: u64) {
    rt.mem_copy(out, (*r).color, ((*r).w as usize) * ((*r).h as usize) * 4)
}
