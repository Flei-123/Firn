import std.rt
import mc.mc_raster
import mc.mc_skin
import mc.mc_emodel_pose

export { skin_draw_records, skin_set_pixels }

fn ldf32(p: u64, i: usize) -> f64 {
    return (*((p + (i as u64) * (4 as u64)) as *mut f32)) as f64
}

fn skin_set_pixels(r: *mut mc_raster.Raster, px: u64) {
    (*r).skin_px = px
}

fn pack_tint(tr: f64, tg: f64, tb: f64) -> u32 {
    var a: i64 = tr as i64
    var b: i64 = tg as i64
    var c: i64 = tb as i64
    if a < 0 as i64 { a = 0 as i64 }
    if b < 0 as i64 { b = 0 as i64 }
    if c < 0 as i64 { c = 0 as i64 }
    if a > 255 as i64 { a = 255 as i64 }
    if b > 255 as i64 { b = 255 as i64 }
    if c > 255 as i64 { c = 255 as i64 }
    return (a as u32) | ((b as u32) << 8 as u32) | ((c as u32) << 16 as u32)
}

fn dominant_face(nx: f64, ny: f64, nz: f64) -> u32 {
    var ax: f64 = nx
    var ay: f64 = ny
    var az: f64 = nz
    if ax < 0.0 { ax = 0.0 - ax }
    if ay < 0.0 { ay = 0.0 - ay }
    if az < 0.0 { az = 0.0 - az }
    if ax >= ay && ax >= az {
        if nx < 0.0 { return 0 as u32 }
        return 1 as u32
    }
    if ay >= az {
        if ny < 0.0 { return 2 as u32 }
        return 3 as u32
    }
    if nz < 0.0 { return 4 as u32 }
    return 5 as u32
}

fn draw_part(r: *mut mc_raster.Raster, e: u64) {
    let half: [f64; 3] = [ldf32(e, mc_emodel_pose.SK_SX) * 0.5, ldf32(e, mc_emodel_pose.SK_SX + 1) * 0.5, ldf32(e, mc_emodel_pose.SK_SX + 2) * 0.5]
    let cxw: f64 = ldf32(e, mc_emodel_pose.SK_CX)
    let cyw: f64 = ldf32(e, mc_emodel_pose.SK_CX + 1)
    let czw: f64 = ldf32(e, mc_emodel_pose.SK_CX + 2)
    var m: [f64; 9] = [0.0; 9]
    var i: usize = 0
    while i < 9 {
        m[i] = ldf32(e, mc_emodel_pose.SK_R + i)
        i = i + 1
    }
    let u0: f64 = ldf32(e, mc_emodel_pose.SK_U0)
    let v0: f64 = ldf32(e, mc_emodel_pose.SK_V0)
    let tw: f64 = ldf32(e, mc_emodel_pose.SK_W)
    let th: f64 = ldf32(e, mc_emodel_pose.SK_H)
    let td: f64 = ldf32(e, mc_emodel_pose.SK_D)
    let mirror: bool = ldf32(e, mc_emodel_pose.SK_MIRROR) > 0.5
    (*r).skin_layer = ldf32(e, mc_emodel_pose.SK_LAYER) as i32
    (*r).qt = pack_tint(ldf32(e, mc_emodel_pose.SK_TR), ldf32(e, mc_emodel_pose.SK_TR + 1), ldf32(e, mc_emodel_pose.SK_TR + 2))
    var vb: [f64; 24] = [0.0; 24]
    let vp: u64 = (&vb[0]) as u64
    var f: usize = 0
    while f < 6 {
        let axis: usize = f / 2
        let ua: usize = (axis + 1) % 3
        let va: usize = (axis + 2) % 3
        var sgn: f64 = 0.0 - 1.0
        if f % 2 == 1 { sgn = 1.0 }
        var nl: [f64; 3] = [0.0, 0.0, 0.0]
        nl[axis] = sgn
        let nwx: f64 = m[0] * nl[0] + m[1] * nl[1] + m[2] * nl[2]
        let nwy: f64 = m[3] * nl[0] + m[4] * nl[1] + m[5] * nl[2]
        let nwz: f64 = m[6] * nl[0] + m[7] * nl[1] + m[8] * nl[2]
        let fk: u32 = mc_raster.face_shade(dominant_face(nwx, nwy, nwz))
        var sf: i32 = f as i32
        if mirror && f < 2 { sf = 1 - (f as i32) }
        var k: usize = 0
        while k < 4 {
            var su: f64 = 0.0 - 1.0
            var sv: f64 = 0.0 - 1.0
            if k == 1 || k == 2 { su = 1.0 }
            if k == 2 || k == 3 { sv = 1.0 }
            var q: [f64; 3] = [0.0, 0.0, 0.0]
            q[axis] = sgn * half[axis]
            q[ua] = su * half[ua]
            q[va] = sv * half[va]
            let wx: f64 = cxw + m[0] * q[0] + m[1] * q[1] + m[2] * q[2]
            let wy: f64 = cyw + m[3] * q[0] + m[4] * q[1] + m[5] * q[2]
            let wz: f64 = czw + m[6] * q[0] + m[7] * q[1] + m[8] * q[2]
            let rx: f64 = wx - (*r).cx
            let ry: f64 = wy - (*r).cy
            let rz: f64 = wz - (*r).cz
            var tx: f64 = q[0] / (half[0] * 2.0) + 0.5
            let ty: f64 = q[1] / (half[1] * 2.0) + 0.5
            let tz: f64 = q[2] / (half[2] * 2.0) + 0.5
            if mirror { tx = 1.0 - tx }
            vb[k * 6] = rx * (*r).rx + ry * (*r).ry + rz * (*r).rz
            vb[k * 6 + 1] = rx * (*r).ux + ry * (*r).uy + rz * (*r).uz
            vb[k * 6 + 2] = rx * (*r).fx + ry * (*r).fy + rz * (*r).fz
            vb[k * 6 + 3] = mc_skin.skin_u(sf, tx, tz, u0, tw, td)
            vb[k * 6 + 4] = mc_skin.skin_v(sf, ty, tz, v0, th, td)
            vb[k * 6 + 5] = 3.0
            k = k + 1
        }
        if f % 2 == 1 {
            mc_raster.raster_draw_tri(r, vp, vp + 48 as u64, vp + 96 as u64, 1 as u32, fk)
            mc_raster.raster_draw_tri(r, vp, vp + 96 as u64, vp + 144 as u64, 1 as u32, fk)
        } else {
            mc_raster.raster_draw_tri(r, vp, vp + 96 as u64, vp + 48 as u64, 1 as u32, fk)
            mc_raster.raster_draw_tri(r, vp, vp + 144 as u64, vp + 96 as u64, 1 as u32, fk)
        }
        f = f + 1
    }
}

fn skin_draw_records(r: *mut mc_raster.Raster, recs: u64, n: usize) -> u64 {
    if (*r).skin_px == 0 as u64 { return 0 as u64 }
    let saved_qt: u32 = (*r).qt
    let saved_layer: i32 = (*r).skin_layer
    (*r).skin_on = true
    var i: usize = 0
    while i < n {
        draw_part(r, recs + (i * mc_emodel_pose.SK_BYTES) as u64)
        i = i + 1
    }
    (*r).skin_on = false
    (*r).qt = saved_qt
    (*r).skin_layer = saved_layer
    return n as u64
}
