// SPDX-License-Identifier: MPL-2.0
import std.rt
import mc.mc_text

export { TipLines, tl_new, tl_free, tl_clear, tl_count, tl_len, tl_off, tl_text, tl_flags, tl_cols, tl_add_plain, tl_add_json, tl_add_blank, tl_width_chars }

const MAX_LINES: usize = 48
const MAX_CHARS: usize = 160
const ALPHA: u32 = 0xFF000000

struct TipLines {
    text: rt.Buf,
    flags: rt.Buf,
    cols: rt.Buf,
    starts: rt.Buf,
}

fn tl_new() -> TipLines {
    return TipLines { text: rt.buf_new(), flags: rt.buf_new(), cols: rt.buf_new(), starts: rt.buf_new() }
}

fn tl_free(t: *mut TipLines) {
    rt.buf_free(&(*t).text)
    rt.buf_free(&(*t).flags)
    rt.buf_free(&(*t).cols)
    rt.buf_free(&(*t).starts)
}

fn tl_clear(t: *mut TipLines) {
    rt.buf_clear(&(*t).text)
    rt.buf_clear(&(*t).flags)
    rt.buf_clear(&(*t).cols)
    rt.buf_clear(&(*t).starts)
}

fn put32(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 8 as u32) & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 16 as u32) & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 24 as u32) & 255 as u32) as u8)
}

fn tl_count(t: *mut TipLines) -> usize { return rt.buf_len(&(*t).starts) / 8 }
fn tl_off(t: *mut TipLines, i: usize) -> usize { return rt.ld32(rt.buf_ptr(&(*t).starts), i * 2) as usize }
fn tl_len(t: *mut TipLines, i: usize) -> usize { return rt.ld32(rt.buf_ptr(&(*t).starts), i * 2 + 1) as usize }
fn tl_text(t: *mut TipLines) -> u64 { return rt.buf_ptr(&(*t).text) }
fn tl_flags(t: *mut TipLines) -> u64 { return rt.buf_ptr(&(*t).flags) }
fn tl_cols(t: *mut TipLines) -> u64 { return rt.buf_ptr(&(*t).cols) }

fn open_line(t: *mut TipLines) -> usize {
    return rt.buf_len(&(*t).text)
}

fn close_line(t: *mut TipLines, off: usize) {
    put32(&(*t).starts, off as u32)
    put32(&(*t).starts, (rt.buf_len(&(*t).text) - off) as u32)
}

fn put_char(t: *mut TipLines, c: u8, rgb: i32, flags: u32) {
    rt.buf_push(&(*t).text, c)
    rt.buf_push(&(*t).flags, flags as u8)
    put32(&(*t).cols, (rgb as u32) | ALPHA)
}

fn tl_add_blank(t: *mut TipLines) {
    if tl_count(t) >= MAX_LINES { return }
    close_line(t, open_line(t))
}

fn tl_add_plain(t: *mut TipLines, rgb: i32, flags: u32, p: u64, n: usize) {
    if tl_count(t) >= MAX_LINES { return }
    let off: usize = open_line(t)
    var i: usize = 0
    while i < n && i < MAX_CHARS {
        var c: u8 = rt.ld8(p, i)
        if c == 10 as u8 { c = 32 as u8 }
        put_char(t, c, rgb, flags)
        i = i + 1
    }
    close_line(t, off)
}

fn tl_add_json(t: *mut TipLines, rgb: i32, flags: u32, p: u64, n: usize, tr: *mut mc_text.Translations) -> bool {
    if tl_count(t) >= MAX_LINES { return false }
    var doc: mc_text.TextDoc = mc_text.text_new()
    if !mc_text.text_from_json_styled(&doc, p, n, tr, rgb, flags) {
        mc_text.text_free(&doc)
        return false
    }
    let off: usize = open_line(t)
    let base: u64 = mc_text.text_ptr(&doc)
    var s: usize = 0
    while s < mc_text.text_span_count(&doc) {
        var col: i32 = mc_text.text_span_color(&doc, s)
        if col == mc_text.NO_COLOR { col = rgb }
        let fl: u32 = mc_text.text_span_flags(&doc, s)
        let so: usize = mc_text.text_span_off(&doc, s)
        let sl: usize = mc_text.text_span_len(&doc, s)
        var k: usize = 0
        while k < sl && (rt.buf_len(&(*t).text) - off) < MAX_CHARS {
            var c: u8 = rt.ld8(base, so + k)
            if c == 10 as u8 { c = 32 as u8 }
            put_char(t, c, col, fl)
            k = k + 1
        }
        s = s + 1
    }
    close_line(t, off)
    mc_text.text_free(&doc)
    return true
}

fn tl_width_chars(t: *mut TipLines, i: usize) -> usize { return tl_len(t, i) }
