// SPDX-License-Identifier: MPL-2.0
import std.math
import mc.mc_raster
import mc.mc_hud
import mc.mc_gui_tex

export { wov_draw, WOV_TILES, WOV_ALPHA_NUM }

const WOV_TILES: i32 = 4
const WOV_ALPHA_NUM: u32 = 26 as u32
const WOV_MIN_LIGHT: i32 = 20

fn wrap16(n: i32) -> i32 {
    var m: i32 = n % 16
    if m < 0 { m = m + 16 }
    return m
}

fn to_px(v: f64, lim: i32) -> i32 {
    if v <= 0.0 { return 0 }
    if v >= (lim as f64) { return lim }
    return (v + 0.5) as i32
}

fn shade(c: u32, light: i32) -> u32 {
    let a: u32 = ((c >> 24 as u32) * WOV_ALPHA_NUM) >> 8 as u32
    let l: u32 = light as u32
    let b: u32 = (((c >> 16 as u32) & 255 as u32) * l) >> 8 as u32
    let g: u32 = (((c >> 8 as u32) & 255 as u32) * l) >> 8 as u32
    let r: u32 = ((c & 255 as u32) * l) >> 8 as u32
    return (a << 24 as u32) | (b << 16 as u32) | (g << 8 as u32) | r
}

fn wov_draw(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, yaw: f64, pitch: f64, daylight: i32) {
    if !mc_gui_tex.gtex_ok(t) { return }
    var light: i32 = daylight
    if light < WOV_MIN_LIGHT { light = WOV_MIN_LIGHT }
    if light > 255 { light = 255 }
    let cells: f64 = (WOV_TILES * 16) as f64
    let w: f64 = (*r).w as f64
    let h: f64 = (*r).h as f64
    let du: f64 = (0.0 - yaw) / 64.0 * 16.0
    let dv: f64 = pitch / 64.0 * 16.0
    let m_lo: i32 = math.floor(du) as i32
    let m_hi: i32 = math.floor(cells + du) as i32
    let n_lo: i32 = math.floor(dv) as i32
    let n_hi: i32 = math.floor(cells + dv) as i32
    var n: i32 = n_lo
    while n <= n_hi {
        let y0: i32 = to_px(((n as f64) - dv) * h / cells, (*r).h)
        let y1: i32 = to_px(((n + 1) as f64 - dv) * h / cells, (*r).h)
        if y1 > y0 {
            var m: i32 = m_lo
            while m <= m_hi {
                let x0: i32 = to_px(w * (1.0 - ((m + 1) as f64 - du) / cells), (*r).w)
                let x1: i32 = to_px(w * (1.0 - ((m as f64) - du) / cells), (*r).w)
                if x1 > x0 {
                    let c: u32 = shade(mc_gui_tex.gtex_get(t, wrap16(m), wrap16(n)), light)
                    mc_hud.hud_rect(r, x0, y0, x1 - x0, y1 - y0, c)
                }
                m = m + 1
            }
        }
        n = n + 1
    }
}
