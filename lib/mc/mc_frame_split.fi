// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.io
import mc.mc_hud
import mc.mc_prof
import std.time

export {
    fs_init, fs_ema, fs_set, fs_get, fs_frame, fs_stream, fs_gl, fs_backend, fs_line, fs_lap, fs_report, FS_LINES, FS_NONE, FS_ENTD, FS_ENTF, FS_HUDB, FS_HUDS, FS_SELB, FS_TRANS,
    FS_FRAME, FS_MAX, FS_NET, FS_INPUT, FS_AUDIO, FS_ENTS, FS_DRAW, FS_WORLD, FS_PRESENT, FS_CULL, FS_SUBMIT, FS_UPLOAD, FS_SDRAW,
    FS_DRAWS, FS_TRIS, FS_CALLS, FS_VISIBLE, FS_DRAWN, FS_PENDING, FS_INFLIGHT, FS_BACKEND, FS_WORKERS, FS_VIEW, FS_UPBYTES, FS_COUNT,
    BK_CPU, BK_GL, BK_VK,
}

const FS_FRAME: usize = 0
const FS_MAX: usize = 1
const FS_NET: usize = 2
const FS_INPUT: usize = 3
const FS_AUDIO: usize = 4
const FS_ENTS: usize = 5
const FS_DRAW: usize = 6
const FS_WORLD: usize = 7
const FS_PRESENT: usize = 8
const FS_CULL: usize = 9
const FS_SUBMIT: usize = 10
const FS_UPLOAD: usize = 11
const FS_SDRAW: usize = 12
const FS_DRAWS: usize = 13
const FS_TRIS: usize = 14
const FS_CALLS: usize = 15
const FS_VISIBLE: usize = 16
const FS_DRAWN: usize = 17
const FS_PENDING: usize = 18
const FS_INFLIGHT: usize = 19
const FS_BACKEND: usize = 20
const FS_WORKERS: usize = 21
const FS_VIEW: usize = 22
const FS_UPBYTES: usize = 23
const FS_ENTD: usize = 24
const FS_ENTF: usize = 25
const FS_HUDB: usize = 26
const FS_HUDS: usize = 27
const FS_SELB: usize = 28
const FS_TRANS: usize = 29
const FS_NONE: usize = 31
const FS_COUNT: usize = 32
const FS_LINES: i32 = 8
const BK_CPU: u64 = 0 as u64
const BK_GL: u64 = 1 as u64
const BK_VK: u64 = 2 as u64
const MAX_DECAY_FRAMES: u64 = 120 as u64

static mut G_FS: u64 = 0
static mut G_MAX_AGE: u64 = 0

fn fs_init() {
    if G_FS != 0 as u64 { return }
    G_FS = rt.heap_alloc(FS_COUNT * 8)
    rt.mem_set(G_FS, 0 as u8, FS_COUNT * 8)
}

fn fs_set(i: usize, v: u64) {
    if G_FS == 0 as u64 { return }
    rt.st64(G_FS, i, v)
}

fn fs_get(i: usize) -> u64 {
    if G_FS == 0 as u64 { return 0 as u64 }
    return rt.ld64(G_FS, i)
}

fn fs_ema(i: usize, v: u64) {
    if G_FS == 0 as u64 { return }
    let old: u64 = rt.ld64(G_FS, i)
    if old == 0 as u64 { rt.st64(G_FS, i, v) } else { rt.st64(G_FS, i, (old * 7 as u64 + v) / 8 as u64) }
}

fn fs_lap(i: usize, ph: usize, t0: u64) -> u64 {
    let t: u64 = time.monotonic_ns()
    if i != FS_NONE { fs_ema(i, t - t0) }
    mc_prof.prof_add(ph, t - t0)
    return t
}

fn fs_backend(kind: u64, workers: i32, view: i32) {
    fs_set(FS_BACKEND, kind)
    fs_set(FS_WORKERS, workers as u64)
    fs_set(FS_VIEW, view as u64)
}

fn fs_frame(net: u64, input: u64, audio: u64, ents: u64, draw: u64, world: u64, present: u64, frame: u64) {
    fs_ema(FS_NET, net)
    fs_ema(FS_INPUT, input)
    fs_ema(FS_AUDIO, audio)
    fs_ema(FS_ENTS, ents)
    fs_ema(FS_DRAW, draw)
    fs_ema(FS_WORLD, world)
    fs_ema(FS_PRESENT, present)
    fs_ema(FS_FRAME, frame)
    G_MAX_AGE = G_MAX_AGE + 1 as u64
    if frame >= fs_get(FS_MAX) || G_MAX_AGE >= MAX_DECAY_FRAMES {
        fs_set(FS_MAX, frame)
        G_MAX_AGE = 0 as u64
    }
}

fn fs_stream(cull_us: u64, submit_us: u64, upload_us: u64, draw_us: u64, visible: u64, drawn: u64, pending: u64, inflight: u64, drawn_trans: u64) {
    fs_set(FS_TRANS, drawn_trans)
    fs_ema(FS_CULL, cull_us * 1000 as u64)
    fs_ema(FS_SUBMIT, submit_us * 1000 as u64)
    fs_ema(FS_UPLOAD, upload_us * 1000 as u64)
    fs_ema(FS_SDRAW, draw_us * 1000 as u64)
    fs_set(FS_VISIBLE, visible)
    fs_set(FS_DRAWN, drawn)
    fs_set(FS_PENDING, pending)
    fs_set(FS_INFLIGHT, inflight)
}

fn fs_gl(draws: u64, tris: u64, calls: u64) {
    fs_set(FS_DRAWS, draws)
    fs_set(FS_TRIS, tris)
    fs_set(FS_CALLS, calls)
}

fn lit(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn dec(b: *mut rt.Buf, v: u64) {
    rt.buf_push_dec_i64(b, v as i64)
}

fn ms(b: *mut rt.Buf, ns: u64) {
    mc_hud.hud_push_fixed(b, (ns as f64) / 1000000.0, 1)
}

fn label_ms(b: *mut rt.Buf, name: str, i: usize) {
    lit(b, name)
    rt.buf_push(b, 32 as u8)
    ms(b, fs_get(i))
    rt.buf_push(b, 32 as u8)
    rt.buf_push(b, 32 as u8)
}

fn backend_name(k: u64) -> str {
    if k == BK_GL { return "GL" }
    if k == BK_VK { return "Vulkan" }
    return "CPU"
}

fn fs_line(k: i32, b: *mut rt.Buf) {
    if k == 0 {
        lit(b, "Gfx: ")
        lit(b, backend_name(fs_get(FS_BACKEND)))
        lit(b, "  workers: ")
        dec(b, fs_get(FS_WORKERS))
        lit(b, "  view: ")
        dec(b, fs_get(FS_VIEW))
    } else if k == 1 {
        lit(b, "Frame ")
        ms(b, fs_get(FS_FRAME))
        lit(b, " ms  worst ")
        ms(b, fs_get(FS_MAX))
    } else if k == 2 {
        label_ms(b, "net+tick", FS_NET)
        label_ms(b, "input", FS_INPUT)
        label_ms(b, "audio", FS_AUDIO)
        label_ms(b, "ent step", FS_ENTS)
    } else if k == 3 {
        label_ms(b, "draw", FS_DRAW)
        label_ms(b, "world", FS_WORLD)
        label_ms(b, "present", FS_PRESENT)
    } else if k == 4 {
        label_ms(b, "cull", FS_CULL)
        label_ms(b, "submit", FS_SUBMIT)
        label_ms(b, "upload", FS_UPLOAD)
        label_ms(b, "sdraw", FS_SDRAW)
    } else if k == 7 {
        label_ms(b, "ents", FS_ENTD)
        label_ms(b, "sel box", FS_SELB)
        label_ms(b, "ent flush", FS_ENTF)
        label_ms(b, "hud build", FS_HUDB)
        label_ms(b, "hud submit", FS_HUDS)
    } else if k == 5 {
        lit(b, "Sections vis ")
        dec(b, fs_get(FS_VISIBLE))
        lit(b, " drawn ")
        dec(b, fs_get(FS_DRAWN))
        lit(b, " pending ")
        dec(b, fs_get(FS_PENDING))
        lit(b, " jobs ")
        dec(b, fs_get(FS_INFLIGHT))
        lit(b, " trans ")
        dec(b, fs_get(FS_TRANS))
    } else if k == 6 {
        lit(b, "Draws ")
        dec(b, fs_get(FS_DRAWS))
        lit(b, " tris ")
        dec(b, fs_get(FS_TRIS))
        lit(b, " gl calls ")
        dec(b, fs_get(FS_CALLS))
    }
}

fn fs_report() {
    var b: rt.Buf = rt.buf_new()
    var k: i32 = 0
    while k < FS_LINES {
        rt.buf_clear(&b)
        fs_line(k, &b)
        io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
        io.print("\n")
        k = k + 1
    }
    rt.buf_free(&b)
}
