import mc.mc_raster
import mc.mc_hud
import mc.mc_gui_tex
import mc.mc_item_src
import mc.mc_inv_ui
import mc.mc_hud_vfont
import mc.mc_creative
import mc.mc_creative_rules
import mc.mc_spr_set
import mc.mc_creative_spr

export {
    CrUi, crui_sprites, crui_new, crui_free, crui_open, crui_ok, crui_panel_w, crui_panel_h, crui_slot_xy, crui_tab_xy, crui_tab_icon_xy, crui_hit, crui_draw,
    HIT_OUTSIDE, HIT_NONE, HIT_PICK0, HIT_TAB0, HIT_DELETE, HIT_SCROLL, HIT_SEARCH,
}

const PANEL_W: i32 = 195
const PANEL_H: i32 = 136
const TAB_W: i32 = 26
const TAB_H: i32 = 32
const HIT_OUTSIDE: i32 = 0 - 999
const HIT_NONE: i32 = 0 - 1
const HIT_PICK0: i32 = 100
const HIT_TAB0: i32 = 200
const HIT_DELETE: i32 = 300
const HIT_SCROLL: i32 = 301
const HIT_SEARCH: i32 = 302
const SCROLL_X: i32 = 175
const SCROLL_Y: i32 = 18
const SCROLL_TRACK: i32 = 112
const SCROLL_HANDLE: i32 = 15
const TEXT_DARK: u32 = 0xFF404040
const WHITE: u32 = 0xFFFFFFFF
const TEX_TABS: i32 = 0
const TEX_ITEMS: i32 = 1
const TEX_SEARCH: i32 = 2
const TEX_INVENTORY: i32 = 3

struct CrUi {
    tex: [mc_gui_tex.GuiTex; 4],
    spr: mc_spr_set.SprSet,
    tabs_spr: bool,
    loaded: bool,
}

fn crui_new() -> CrUi {
    return CrUi { tex: [mc_gui_tex.gtex_empty(); 4], spr: mc_spr_set.sset_new(), tabs_spr: false, loaded: false }
}

fn crui_free(u: *mut CrUi) {
    var k: usize = 0
    while k < 4 {
        mc_gui_tex.gtex_free(&(*u).tex[k])
        k = k + 1
    }
    mc_spr_set.sset_free(&(*u).spr)
    (*u).tabs_spr = false
    (*u).loaded = false
}

fn crui_ok(u: *mut CrUi) -> bool { return (*u).loaded }

fn crui_sprites(u: *mut CrUi) -> bool { return (*u).tabs_spr }

fn crui_panel_w() -> i32 { return PANEL_W }

fn crui_panel_h() -> i32 { return PANEL_H }

fn tex_path(k: i32) -> str {
    if k == TEX_TABS { return "assets/minecraft/textures/gui/container/creative_inventory/tabs.png" }
    if k == TEX_ITEMS { return "assets/minecraft/textures/gui/container/creative_inventory/tab_items.png" }
    if k == TEX_SEARCH { return "assets/minecraft/textures/gui/container/creative_inventory/tab_item_search.png" }
    return "assets/minecraft/textures/gui/container/creative_inventory/tab_inventory.png"
}

fn crui_open(u: *mut CrUi, src: *mut mc_item_src.ItemSrc) -> bool {
    var k: i32 = 0
    var all: bool = true
    while k < 4 {
        let path: str = tex_path(k)
        if !mc_item_src.isrc_tex(src, path.p as u64, path.n, &(*u).tex[k as usize]) && k != TEX_TABS { all = false }
        k = k + 1
    }
    (*u).tabs_spr = mc_creative_spr.crspr_open(&(*u).spr, src)
    if !(*u).tabs_spr && !mc_gui_tex.gtex_ok(&(*u).tex[TEX_TABS as usize]) { all = false }
    (*u).loaded = all
    return all
}

fn tab_is_top(tab: i32) -> bool { return tab <= mc_creative_rules.TAB_SEARCH }

fn tab_col(tab: i32) -> i32 {
    if tab == mc_creative_rules.TAB_SEARCH || tab == mc_creative_rules.TAB_INVENTORY { return 6 }
    if tab > mc_creative_rules.TAB_SEARCH { return tab - mc_creative_rules.TAB_TOOLS }
    return tab
}

fn crui_tab_xy(tab: i32, x: *mut i32, y: *mut i32) {
    let col: i32 = tab_col(tab)
    *x = 27 * col
    if col == 6 { *x = PANEL_W - 27 + 1 }
    if tab_is_top(tab) { *y = 0 - 28 } else { *y = PANEL_H - 4 }
}

fn crui_tab_icon_xy(tab: i32, x: *mut i32, y: *mut i32) {
    var tx: i32 = 0
    var ty: i32 = 0
    crui_tab_xy(tab, &tx, &ty)
    *x = tx + 5
    if tab_is_top(tab) { *y = ty + 9 } else { *y = ty + 7 }
}

fn crui_slot_xy(tab: i32, ws: i32, x: *mut i32, y: *mut i32) -> bool {
    if ws >= 36 && ws < 45 {
        *x = 9 + 18 * (ws - 36)
        *y = 112
        return true
    }
    if tab != mc_creative_rules.TAB_INVENTORY { return false }
    if ws >= 5 && ws < 9 {
        *x = 54 + 54 * ((ws - 5) / 2)
        *y = 6 + 27 * ((ws - 5) % 2)
        return true
    }
    if ws == 45 {
        *x = 35
        *y = 20
        return true
    }
    if ws >= 9 && ws < 36 {
        *x = 9 + 18 * ((ws - 9) % 9)
        *y = 54 + 18 * ((ws - 9) / 9)
        return true
    }
    return false
}

fn inside(mx: i32, my: i32, x: i32, y: i32, w: i32, h: i32) -> bool {
    return mx >= x && my >= y && mx < x + w && my < y + h
}

fn crui_hit(cr: *mut mc_creative.Creative, px: i32, py: i32, s: i32, mx: i32, my: i32) -> i32 {
    var t: i32 = 0
    while t < mc_creative_rules.TAB_COUNT {
        var tx: i32 = 0
        var ty: i32 = 0
        crui_tab_xy(t, &tx, &ty)
        if inside(mx, my, px + tx * s, py + ty * s, TAB_W * s, TAB_H * s) { return HIT_TAB0 + t }
        t = t + 1
    }
    if !inside(mx, my, px, py, PANEL_W * s, PANEL_H * s) { return HIT_OUTSIDE }
    let tab: i32 = mc_creative.cr_tab(cr)
    var ws: i32 = 0
    var x: i32 = 0
    var y: i32 = 0
    while ws < 46 {
        if crui_slot_xy(tab, ws, &x, &y) && inside(mx, my, px + x * s, py + y * s, 16 * s, 16 * s) { return ws }
        ws = ws + 1
    }
    if tab == mc_creative_rules.TAB_INVENTORY {
        if inside(mx, my, px + 173 * s, py + 112 * s, 16 * s, 16 * s) { return HIT_DELETE }
        return HIT_NONE
    }
    var k: i32 = 0
    while k < mc_creative.CR_PAGE {
        if inside(mx, my, px + (9 + 18 * (k % 9)) * s, py + (18 + 18 * (k / 9)) * s, 16 * s, 16 * s) { return HIT_PICK0 + k }
        k = k + 1
    }
    if inside(mx, my, px + SCROLL_X * s, py + SCROLL_Y * s, 14 * s, SCROLL_TRACK * s) { return HIT_SCROLL }
    if tab == mc_creative_rules.TAB_SEARCH && inside(mx, my, px + 82 * s, py + 6 * s, 80 * s, 9 * s) { return HIT_SEARCH }
    return HIT_NONE
}

fn fill(r: *mut mc_raster.Raster, x: i32, y: i32, w: i32, h: i32, c: u32) {
    mc_hud.hud_rect(r, x, y, w, h, c)
}

fn draw_tab(r: *mut mc_raster.Raster, u: *mut CrUi, px: i32, py: i32, s: i32, tab: i32, selected: bool) {
    var tx: i32 = 0
    var ty: i32 = 0
    crui_tab_xy(tab, &tx, &ty)
    let top: bool = tab_is_top(tab)
    if (*u).loaded && (*u).tabs_spr {
        mc_spr_set.sset_draw(r, &(*u).spr, mc_creative_spr.crspr_tab_id(top, selected, tab_col(tab)), px + tx * s, py + ty * s, s)
        return
    }
    if (*u).loaded {
        var sy: i32 = 0
        if !top { sy = 64 }
        if selected { sy = sy + 32 }
        mc_gui_tex.gtex_draw(r, &(*u).tex[TEX_TABS as usize], px + tx * s, py + ty * s, TAB_W * s, TAB_H * s, tab_col(tab) * TAB_W, sy, TAB_W, TAB_H, WHITE)
        return
    }
    var c: u32 = 0xFF707070
    if selected { c = 0xFFC6C6C6 }
    fill(r, px + tx * s, py + ty * s, TAB_W * s, 28 * s, c)
}

fn crui_draw(r: *mut mc_raster.Raster, u: *mut CrUi, cr: *mut mc_creative.Creative, px: i32, py: i32, s: i32) {
    let tab: i32 = mc_creative.cr_tab(cr)
    var t: i32 = 0
    while t < mc_creative_rules.TAB_COUNT {
        if t != tab { draw_tab(r, u, px, py, s, t, false) }
        t = t + 1
    }
    if (*u).loaded {
        var k: i32 = TEX_ITEMS
        if tab == mc_creative_rules.TAB_SEARCH { k = TEX_SEARCH }
        if tab == mc_creative_rules.TAB_INVENTORY { k = TEX_INVENTORY }
        mc_gui_tex.gtex_draw(r, &(*u).tex[k as usize], px, py, PANEL_W * s, PANEL_H * s, 0, 0, PANEL_W, PANEL_H, WHITE)
    } else {
        fill(r, px, py, PANEL_W * s, PANEL_H * s, 0xFFC6C6C6)
        var ws: i32 = 0
        var x: i32 = 0
        var y: i32 = 0
        while ws < 46 {
            if crui_slot_xy(tab, ws, &x, &y) { fill(r, px + x * s, py + y * s, 16 * s, 16 * s, 0xFF8B8B8B) }
            ws = ws + 1
        }
        var k: i32 = 0
        while k < mc_creative.CR_PAGE && tab != mc_creative_rules.TAB_INVENTORY {
            fill(r, px + (9 + 18 * (k % 9)) * s, py + (18 + 18 * (k / 9)) * s, 16 * s, 16 * s, 0xFF8B8B8B)
            k = k + 1
        }
    }
    draw_tab(r, u, px, py, s, tab, true)
    mc_inv_ui.iui_text(r, px + 8 * s, py + 6 * s, s, mc_creative.cr_tab_title(tab), TEXT_DARK, false)
    if mc_creative.cr_has_scrollbar(cr) {
        var off: i32 = 0
        let mx: i32 = mc_creative.cr_max_scroll(cr)
        if mx > 0 { off = ((SCROLL_TRACK - 17) * mc_creative.cr_scroll(cr)) / mx }
        var sx: i32 = 244
        if mx > 0 { sx = 232 }
        if (*u).loaded && (*u).tabs_spr {
            mc_spr_set.sset_draw(r, &(*u).spr, mc_creative_spr.crspr_scroller_id(mx > 0), px + SCROLL_X * s, py + (SCROLL_Y + off) * s, s)
        } else if (*u).loaded {
            mc_gui_tex.gtex_draw(r, &(*u).tex[TEX_TABS as usize], px + SCROLL_X * s, py + (SCROLL_Y + off) * s, 12 * s, SCROLL_HANDLE * s, sx, 0, 12, SCROLL_HANDLE, WHITE)
        } else {
            fill(r, px + SCROLL_X * s, py + (SCROLL_Y + off) * s, 12 * s, SCROLL_HANDLE * s, 0xFF606060)
        }
    }
    if tab == mc_creative_rules.TAB_SEARCH {
        let q: str = str { p: mc_creative.cr_query_ptr(cr) as *u8, n: mc_creative.cr_query_len(cr) }
        var w: i32 = 0
        if q.n > 0 {
            mc_inv_ui.iui_text(r, px + 84 * s, py + 7 * s, s, q, WHITE, true)
            w = mc_hud_vfont.vtext_width(q.p as u64, 0 as u64, 0, q.n)
        }
        if mc_creative.cr_focus(cr) { fill(r, px + (84 + w) * s, py + 7 * s, s, 9 * s, WHITE) }
    }
}
