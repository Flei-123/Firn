// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_procmem.windows.fi -- Windows twin of mc_procmem.fi: K32GetProcessMemoryInfo (kernel32, Win7+) via std.dynlib.
// PROCESS_MEMORY_COUNTERS (x64, 72 bytes): cb u32 @0, PageFaultCount u32 @4, PeakWorkingSetSize @8, WorkingSetSize @16 (SIZE_T).
import std.rt
import std.dynlib

export {
    rss_kb, peak_kb,
}

// which: 8 = PeakWorkingSetSize, 16 = WorkingSetSize; result in kB (0 on failure)
fn counters_kb(off: usize) -> u64 {
    let h: u64 = dynlib.open("kernel32.dll")
    if h == 0 {
        return 0 as u64
    }
    let f: u64 = dynlib.sym(h, "K32GetProcessMemoryInfo")
    if f == 0 {
        return 0 as u64
    }
    let m: u64 = rt.heap_alloc(80)
    var i: usize = 0
    while i < 10 {
        rt.st64(m, i, 0 as u64)
        i = i + 1
    }
    // cb = 72
    rt.st64(m, 0, 72 as u64)
    // GetCurrentProcess() pseudo handle = (HANDLE)-1
    let ok: u64 = dynlib.ci3(f, 0xFFFFFFFFFFFFFFFF as u64, m, 72 as u64)
    var v: u64 = 0
    if (ok & 0xFFFFFFFF as u64) != 0 {
        v = rt.ld64(m, off / 8)
    }
    return v / 1024 as u64
}

fn rss_kb() -> u64 {
    return counters_kb(16)
}

fn peak_kb() -> u64 {
    return counters_kb(8)
}
