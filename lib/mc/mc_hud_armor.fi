import std.rt
import mc.mc_inv
import mc.mc_registry

export { armor_points, ARMOR_SLOT_HEAD }

const ARMOR_SLOT_HEAD: i32 = 5
const MATERIALS: str = "leather_golden_chainmail_iron_diamond_netherite_"
const TABLE: str = "132125312541265238633863"
const TURTLE_POINTS: i32 = 2

fn contains(p: u64, n: usize, lit: str) -> bool {
    if lit.n > n { return false }
    var i: usize = 0
    while i + lit.n <= n {
        if rt.mem_eq(p + (i as u64), lit.p as u64, lit.n) { return true }
        i = i + 1
    }
    return false
}

fn piece_of(p: u64, n: usize) -> i32 {
    if contains(p, n, "_helmet") { return 0 }
    if contains(p, n, "_chestplate") { return 1 }
    if contains(p, n, "_leggings") { return 2 }
    if contains(p, n, "_boots") { return 3 }
    return 0 - 1
}

fn material_of(p: u64, n: usize) -> i32 {
    if contains(p, n, "leather") { return 0 }
    if contains(p, n, "golden") { return 1 }
    if contains(p, n, "chainmail") { return 2 }
    if contains(p, n, "iron") { return 3 }
    if contains(p, n, "diamond") { return 4 }
    if contains(p, n, "netherite") { return 5 }
    return 0 - 1
}

fn item_points(p: u64, n: usize, slot_piece: i32) -> i32 {
    if piece_of(p, n) != slot_piece { return 0 }
    if slot_piece == 0 && contains(p, n, "turtle") { return TURTLE_POINTS }
    let m: i32 = material_of(p, n)
    if m < 0 { return 0 }
    return (TABLE.chars((m * 4 + slot_piece) as usize) as i32) - 48
}

fn armor_points(inv: *mut mc_inv.Inv, reg: *mut mc_registry.Registry) -> i32 {
    var total: i32 = 0
    var k: i32 = 0
    while k < 4 {
        let item: i32 = mc_inv.inv_item(inv, ARMOR_SLOT_HEAD + k)
        if item >= 0 {
            var n: usize = 0
            let p: u64 = mc_registry.reg_item_name(reg, item, &n)
            total = total + item_points(p, n, k)
        }
        k = k + 1
    }
    return total
}
