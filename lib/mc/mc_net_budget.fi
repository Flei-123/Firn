export { nb_limit_ns, nb_over, NB_DEFAULT_US, NB_WARMUP_MS }

const NB_DEFAULT_US: i32 = 1500
const NB_WARMUP_MS: u64 = 4000
static mut NB_START_MS: u64 = 0

fn nb_limit_ns(now_ms: u64, have_pos: bool, env_set: bool, env_us: i32) -> u64 {
    if env_set {
        if env_us <= 0 { return 0 as u64 }
        return (env_us as u64) * 1000 as u64
    }
    if !have_pos { return 0 as u64 }
    if NB_START_MS == 0 as u64 { NB_START_MS = now_ms }
    if now_ms - NB_START_MS < NB_WARMUP_MS { return 0 as u64 }
    return (NB_DEFAULT_US as u64) * 1000 as u64
}

fn nb_over(start_ns: u64, now_ns: u64, limit_ns: u64) -> bool {
    if limit_ns == 0 as u64 { return false }
    return now_ns - start_ns >= limit_ns
}
