// SPDX-License-Identifier: MPL-2.0
import std.rt
import mc.mc_raster
import mc.mc_gui_tex

export {
    GuiFont, gfont_empty, gfont_free, gfont_ok, gfont_init, gfont_width, gfont_bytes_width, gfont_draw, gfont_draw_bytes, gfont_draw_centered,
    gfont_mask, GLYPH_H, shadow_of,
}

const GLYPH_H: i32 = 8
const CELL: i32 = 8
const SPACE_ADV: i32 = 4

struct GuiFont {
    atlas: mc_gui_tex.GuiTex,
    adv: u64,
}

fn gfont_empty() -> GuiFont {
    return GuiFont { atlas: mc_gui_tex.gtex_empty(), adv: 0 as u64 }
}

fn gfont_ok(f: *mut GuiFont) -> bool {
    return (*f).adv != 0 as u64 && mc_gui_tex.gtex_ok(&(*f).atlas)
}

fn gfont_free(f: *mut GuiFont) {
    mc_gui_tex.gtex_free(&(*f).atlas)
    if (*f).adv != 0 as u64 { rt.heap_free((*f).adv, 256 * 4) }
    *f = gfont_empty()
}

fn glyph_width(a: *mut mc_gui_tex.GuiTex, code: i32) -> i32 {
    let ox: i32 = (code % 16) * CELL
    let oy: i32 = (code / 16) * CELL
    var best: i32 = 0
    var y: i32 = 0
    while y < CELL {
        var x: i32 = 0
        while x < CELL {
            if (mc_gui_tex.gtex_get(a, ox + x, oy + y) >> 24 as u32) != 0 as u32 && x + 1 > best { best = x + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return best
}

fn gfont_init(f: *mut GuiFont, png_p: u64, png_n: usize) -> bool {
    *f = gfont_empty()
    if !mc_gui_tex.gtex_from_png(png_p, png_n, &(*f).atlas) { return false }
    if (*f).atlas.w != 128 || (*f).atlas.h != 128 {
        mc_gui_tex.gtex_free(&(*f).atlas)
        return false
    }
    (*f).adv = rt.heap_alloc(256 * 4)
    if (*f).adv == 0 as u64 {
        mc_gui_tex.gtex_free(&(*f).atlas)
        return false
    }
    var c: i32 = 0
    while c < 256 {
        var a: i32 = 0
        if c == 32 {
            a = SPACE_ADV
        } else {
            let w: i32 = glyph_width(&(*f).atlas, c)
            if w > 0 { a = w + 1 }
        }
        rt.st32((*f).adv, c as usize, a as u32)
        c = c + 1
    }
    return true
}

fn gfont_bytes_width(f: *mut GuiFont, p: u64, n: usize) -> i32 {
    if !gfont_ok(f) { return (n as i32) * 6 }
    var w: i32 = 0
    var i: usize = 0
    while i < n {
        w = w + (rt.ld32((*f).adv, rt.ld8(p, i) as usize) as i32)
        i = i + 1
    }
    return w
}

fn gfont_width(f: *mut GuiFont, t: str) -> i32 {
    return gfont_bytes_width(f, t.p as u64, t.n)
}

fn shadow_of(c: u32) -> u32 {
    return (c & 0xFF000000 as u32) | ((c & 0x00FCFCFC as u32) >> 2 as u32)
}

fn paint_glyphs(r: *mut mc_raster.Raster, f: *mut GuiFont, x: i32, y: i32, s: i32, c: u32, p: u64, n: usize) {
    var pen: i32 = 0
    var i: usize = 0
    while i < n {
        let code: i32 = rt.ld8(p, i) as i32
        let ox: i32 = (code % 16) * CELL
        let oy: i32 = (code / 16) * CELL
        var gy: i32 = 0
        while gy < CELL {
            var gx: i32 = 0
            while gx < CELL {
                let g: u32 = mc_gui_tex.gtex_get(&(*f).atlas, ox + gx, oy + gy)
                if (g >> 24 as u32) != 0 as u32 {
                    var yy: i32 = 0
                    while yy < s {
                        var xx: i32 = 0
                        while xx < s {
                            mc_gui_tex.gtex_blend(r, x + (pen + gx) * s + xx, y + gy * s + yy, c)
                            xx = xx + 1
                        }
                        yy = yy + 1
                    }
                }
                gx = gx + 1
            }
            gy = gy + 1
        }
        pen = pen + (rt.ld32((*f).adv, code as usize) as i32)
        i = i + 1
    }
}

fn gfont_draw_bytes(r: *mut mc_raster.Raster, f: *mut GuiFont, x: i32, y: i32, s: i32, c: u32, shadow: bool, p: u64, n: usize) {
    if !gfont_ok(f) { return }
    if shadow { paint_glyphs(r, f, x + s, y + s, s, shadow_of(c), p, n) }
    paint_glyphs(r, f, x, y, s, c, p, n)
}

fn gfont_draw(r: *mut mc_raster.Raster, f: *mut GuiFont, x: i32, y: i32, s: i32, c: u32, shadow: bool, t: str) {
    gfont_draw_bytes(r, f, x, y, s, c, shadow, t.p as u64, t.n)
}

fn gfont_draw_centered(r: *mut mc_raster.Raster, f: *mut GuiFont, cx: i32, y: i32, s: i32, c: u32, shadow: bool, t: str) {
    gfont_draw(r, f, cx - (gfont_width(f, t) / 2) * s, y, s, c, shadow, t)
}

fn gfont_mask(f: *mut GuiFont, c: u32, p: u64, n: usize, out: *mut mc_gui_tex.GuiTex) -> bool {
    let w: i32 = gfont_bytes_width(f, p, n)
    if !gfont_ok(f) || !mc_gui_tex.gtex_blank(out, w + 1, GLYPH_H + 1) { return false }
    var pass: i32 = 0
    while pass < 2 {
        var col: u32 = c
        var off: i32 = 0
        if pass == 0 {
            col = shadow_of(c)
            off = 1
        }
        var pen: i32 = 0
        var i: usize = 0
        while i < n {
            let code: i32 = rt.ld8(p, i) as i32
            let ox: i32 = (code % 16) * CELL
            let oy: i32 = (code / 16) * CELL
            var gy: i32 = 0
            while gy < CELL {
                var gx: i32 = 0
                while gx < CELL {
                    if (mc_gui_tex.gtex_get(&(*f).atlas, ox + gx, oy + gy) >> 24 as u32) != 0 as u32 {
                        mc_gui_tex.gtex_set(out, pen + gx + off, gy + off, col)
                    }
                    gx = gx + 1
                }
                gy = gy + 1
            }
            pen = pen + (rt.ld32((*f).adv, code as usize) as i32)
            i = i + 1
        }
        pass = pass + 1
    }
    return true
}
