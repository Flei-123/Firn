// SPDX-License-Identifier: MPL-2.0
import std.rt
import mc.mc_registry
import mc.mc_entity

export { Lightning, lightning_new, lightning_reset, lightning_poll, lightning_flash_milli, MAX_NEW, FLASH_DECAY_MS }

const RING: usize = 16
const MAX_NEW: usize = 4
const FLASH_DECAY_MS: u64 = 150 as u64
const FLASH_FULL: i32 = 1000
const BOLT_NAME: str = "lightning_bolt"
const NAME_LEN: usize = 14

struct Lightning {
    bolt_type: i32,
    bound: bool,
    seen: [i32; 16],
    seen_next: usize,
    present_ms: u64,
    has_present: bool,
    n_bolts: u64,
    new_n: usize,
    nx: [f64; 4],
    ny: [f64; 4],
    nz: [f64; 4],
}

fn lightning_new() -> Lightning {
    return Lightning {
        bolt_type: 0 - 1, bound: false, seen: [0 - 1; 16], seen_next: 0, present_ms: 0 as u64, has_present: false, n_bolts: 0 as u64,
        new_n: 0, nx: [0.0; 4], ny: [0.0; 4], nz: [0.0; 4],
    }
}

fn lightning_reset(l: *mut Lightning) {
    var i: usize = 0
    while i < RING {
        (*l).seen[i] = 0 - 1
        i = i + 1
    }
    (*l).seen_next = 0
    (*l).has_present = false
    (*l).new_n = 0
}

fn bind(l: *mut Lightning, reg: *mut mc_registry.Registry) {
    if (*l).bound { return }
    (*l).bound = true
    let n: i32 = mc_registry.reg_entity_count(reg)
    var i: i32 = 0
    while i < n {
        var nl: usize = 0
        let np: u64 = mc_registry.reg_entity_name(reg, i, &nl)
        if nl == NAME_LEN && rt.mem_eq(np, BOLT_NAME.p as u64, NAME_LEN) {
            (*l).bolt_type = mc_registry.reg_entity_id(reg, i)
            return
        }
        i = i + 1
    }
}

fn was_seen(l: *mut Lightning, id: i32) -> bool {
    var i: usize = 0
    while i < RING {
        if (*l).seen[i] == id { return true }
        i = i + 1
    }
    return false
}

fn mark_seen(l: *mut Lightning, id: i32) {
    (*l).seen[(*l).seen_next] = id
    (*l).seen_next = ((*l).seen_next + 1) % RING
}

fn lightning_poll(l: *mut Lightning, st: *mut mc_entity.Store, reg: *mut mc_registry.Registry, now_ms: u64) -> usize {
    bind(l, reg)
    (*l).new_n = 0
    if (*l).bolt_type < 0 { return 0 }
    let cap: usize = mc_entity.store_slot_cap(st)
    var present: bool = false
    var i: usize = 0
    while i < cap {
        let e: *mut mc_entity.Entity = mc_entity.store_at(st, i)
        i = i + 1
        if (e as u64) == 0 as u64 { continue }
        if (*e).type_id != (*l).bolt_type { continue }
        present = true
        if was_seen(l, (*e).id) { continue }
        mark_seen(l, (*e).id)
        (*l).n_bolts = (*l).n_bolts + 1 as u64
        if (*l).new_n < MAX_NEW {
            (*l).nx[(*l).new_n] = (*e).x
            (*l).ny[(*l).new_n] = (*e).y
            (*l).nz[(*l).new_n] = (*e).z
            (*l).new_n = (*l).new_n + 1
        }
    }
    if present {
        (*l).present_ms = now_ms
        (*l).has_present = true
    }
    return (*l).new_n
}

fn lightning_flash_milli(l: *mut Lightning, now_ms: u64) -> i32 {
    if !(*l).has_present { return 0 }
    if now_ms <= (*l).present_ms { return FLASH_FULL }
    let age: u64 = now_ms - (*l).present_ms
    if age >= FLASH_DECAY_MS { return 0 }
    return FLASH_FULL - ((age * FLASH_FULL as u64) / FLASH_DECAY_MS) as i32
}
