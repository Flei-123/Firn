import std.rt
import mc.mc_tip_lines
import mc.mc_tip_attr
import mc.mc_item_regs
import mc.mc_name_match
import mc.mc_tip_util

export { defattr_add }

const C_GRAY: i32 = 0xAAAAAA
const TIERS: str = "wooden golden stone iron diamond netherite leather chainmail"
const SWORD_DMG: str = "400 400 500 600 700 800"
const AXE_DMG: str = "700 700 900 900 900 1000"
const AXE_SPEED: str = "80 100 80 90 100 100"
const PICK_DMG: str = "200 200 300 400 500 600"
const SHOVEL_DMG: str = "250 250 350 450 550 650"
const HOE_SPEED: str = "100 100 200 300 400 400"
const ARMOR_HEAD: str = "0 2 0 2 3 3 1 2"
const ARMOR_CHEST: str = "0 5 0 6 8 8 3 5"
const ARMOR_LEGS: str = "0 3 0 5 6 6 2 4"
const ARMOR_FEET: str = "0 1 0 2 3 3 1 1"
const ATTR_ARMOR: i64 = 0
const ATTR_TOUGHNESS: i64 = 1
const ATTR_DAMAGE: i64 = 2
const ATTR_SPEED: i64 = 4
const ATTR_KNOCKBACK_RES: i64 = 15

fn tier_of(p: u64, n: usize) -> i32 {
    var wp: u64 = 0
    var wn: usize = 0
    var k: i32 = 0
    while mc_tip_util.nth_word(TIERS.p as u64, TIERS.n, k, 32 as u8, &wp, &wn) {
        if n > wn && rt.mem_eq(p, wp, wn) && rt.ld8(p, wn) == 95 as u8 { return k }
        k = k + 1
    }
    return 0 - 1
}

fn word_num(list: str, idx: i32) -> i64 {
    var wp: u64 = 0
    var wn: usize = 0
    var ok: bool = false
    if !mc_tip_util.nth_word(list.p as u64, list.n, idx, 32 as u8, &wp, &wn) { return 0 }
    let v: i64 = mc_tip_util.parse_num(wp, wn, &ok)
    if !ok { return 0 }
    return v
}

fn emit(t: *mut mc_tip_lines.TipLines, protocol: i32, attr: i64, amount: i64, base: bool) {
    var np: u64 = 0
    var nn: usize = 0
    if !mc_item_regs.attr_name(protocol, attr, &np, &nn) { return }
    var full: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&full, "minecraft:".p as u64, 10)
    rt.buf_push_bytes(&full, np, nn)
    mc_tip_attr.attr_line(t, rt.buf_ptr(&full), rt.buf_len(&full), amount, 0, base)
    rt.buf_free(&full)
}

fn header(t: *mut mc_tip_lines.TipLines, slot: str, fallback: str) {
    var key: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&key, "item.modifiers.".p as u64, 15)
    rt.buf_push_bytes(&key, slot.p as u64, slot.n)
    mc_tip_attr.attr_header(t, rt.buf_ptr(&key), rt.buf_len(&key), fallback, C_GRAY)
    rt.buf_free(&key)
}

fn weapon(t: *mut mc_tip_lines.TipLines, protocol: i32, damage: i64, speed: i64) {
    header(t, "mainhand", "When in Main Hand:")
    emit(t, protocol, ATTR_DAMAGE, damage, true)
    emit(t, protocol, ATTR_SPEED, speed, true)
}

fn armor(t: *mut mc_tip_lines.TipLines, protocol: i32, slot: str, fallback: str, points: i64, tier: i32) {
    if points <= 0 { return }
    header(t, slot, fallback)
    emit(t, protocol, ATTR_ARMOR, points * 100, false)
    if tier == 4 { emit(t, protocol, ATTR_TOUGHNESS, 200, false) }
    if tier == 5 {
        emit(t, protocol, ATTR_TOUGHNESS, 300, false)
        emit(t, protocol, ATTR_KNOCKBACK_RES, 10, false)
    }
}

fn defattr_add(t: *mut mc_tip_lines.TipLines, protocol: i32, ip: u64, inn: usize) {
    if mc_name_match.nm_suffix(ip, inn, "trident") { weapon(t, protocol, 900, 110); return }
    if inn == 4 && rt.mem_eq(ip, "mace".p as u64, 4) { weapon(t, protocol, 600, 60); return }
    if inn == 13 && rt.mem_eq(ip, "turtle_helmet".p as u64, 13) { armor(t, protocol, "head", "When on Head:", 2, 0 - 1); return }
    let tier: i32 = tier_of(ip, inn)
    if tier < 0 { return }
    if mc_name_match.nm_suffix(ip, inn, "_sword") && tier < 6 { weapon(t, protocol, word_num(SWORD_DMG, tier), 160); return }
    if mc_name_match.nm_suffix(ip, inn, "_pickaxe") && tier < 6 { weapon(t, protocol, word_num(PICK_DMG, tier), 120); return }
    if mc_name_match.nm_suffix(ip, inn, "_shovel") && tier < 6 { weapon(t, protocol, word_num(SHOVEL_DMG, tier), 100); return }
    if mc_name_match.nm_suffix(ip, inn, "_axe") && tier < 6 { weapon(t, protocol, word_num(AXE_DMG, tier), word_num(AXE_SPEED, tier)); return }
    if mc_name_match.nm_suffix(ip, inn, "_hoe") && tier < 6 { weapon(t, protocol, 100, word_num(HOE_SPEED, tier)); return }
    if mc_name_match.nm_suffix(ip, inn, "_helmet") { armor(t, protocol, "head", "When on Head:", word_num(ARMOR_HEAD, tier), tier); return }
    if mc_name_match.nm_suffix(ip, inn, "_chestplate") { armor(t, protocol, "chest", "When on Body:", word_num(ARMOR_CHEST, tier), tier); return }
    if mc_name_match.nm_suffix(ip, inn, "_leggings") { armor(t, protocol, "legs", "When on Legs:", word_num(ARMOR_LEGS, tier), tier); return }
    if mc_name_match.nm_suffix(ip, inn, "_boots") { armor(t, protocol, "feet", "When on Feet:", word_num(ARMOR_FEET, tier), tier); return }
}
