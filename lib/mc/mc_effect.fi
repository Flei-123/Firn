// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_effect.fi -- the mining related status effects of the OWN player (Haste, Mining Fatigue) from the packets
// Entity Effect / Remove Entity Effect, for the break time in mc_dig (dig_ticks_fx).
//
//   fx_new()                          no effects, own entity id unknown (-1)
//   fx_set_own(f, eid)                the entity id from Join Game (first field, i32)
//   fx_own_from_join(f, body)         reads that id from a Join Game body
//   fx_on_effect(f, protocol, body)   Entity Effect: entityId varint, effectId (i8 up to 1.17, varint 1.18+), amplifier (i8, varint 1.20.5+), duration varint, ...
//   fx_on_remove(f, protocol, body)   Remove Entity Effect: entityId varint, effectId
//   fx_haste(f) / fx_fatigue(f)       level = amplifier + 1, 0 = not active
//   fx_haste_id(protocol) / fx_fatigue_id(protocol)   effect ids: 3 / 4 up to 1.20.1, 2 / 3 since 1.20.2 (protocol 764; minecraft-data effects.json)
//
// Packets of other entities are ignored. The server sends Remove Entity Effect when an effect runs out, so durations are not tracked.
import std.bytes

export { Fx, fx_new, fx_set_own, fx_own_from_join, fx_on_effect, fx_on_remove, fx_haste, fx_fatigue, fx_clear, fx_haste_id, fx_fatigue_id }

struct Fx {
    own: i32,
    haste: i32,
    fatigue: i32,
}

fn fx_new() -> Fx { return Fx { own: 0 - 1, haste: 0, fatigue: 0 } }
fn fx_set_own(f: *mut Fx, eid: i32) { (*f).own = eid }
fn fx_haste(f: *mut Fx) -> i32 { return (*f).haste }
fn fx_fatigue(f: *mut Fx) -> i32 { return (*f).fatigue }
fn fx_clear(f: *mut Fx) {
    (*f).haste = 0
    (*f).fatigue = 0
}

fn fx_haste_id(protocol: i32) -> i32 {
    if protocol >= 764 { return 2 }
    return 3
}

fn fx_fatigue_id(protocol: i32) -> i32 {
    if protocol >= 764 { return 3 }
    return 4
}

// Join Game starts with the player's entity id as a big endian i32 in every supported version
fn fx_own_from_join(f: *mut Fx, b: *mut bytes.Bytes) -> bool {
    let p0: usize = bytes.bytes_pos(b)
    let e: i32 = bytes.get_i32(b) catch (0 - 1)
    bytes.bytes_set_pos(b, p0)
    if e < 0 { return false }
    (*f).own = e
    return true
}

fn read_effect_id(b: *mut bytes.Bytes, protocol: i32) -> i32 {
    if protocol >= 758 { return bytes.get_varint(b) catch (0 - 1) }
    let v: i8 = bytes.get_i8(b) catch ((0 - 1) as i8)
    return v as i32
}

fn fx_on_effect(f: *mut Fx, protocol: i32, b: *mut bytes.Bytes) -> bool {
    let eid: i32 = bytes.get_varint(b) catch (0 - 1)
    if eid < 0 || eid != (*f).own { return false }
    let id: i32 = read_effect_id(b, protocol)
    var amp: i32 = 0
    if protocol >= 766 {
        amp = bytes.get_varint(b) catch (0 - 1)
    } else {
        let a: i8 = bytes.get_i8(b) catch ((0 - 1) as i8)
        amp = a as i32
    }
    if id < 0 || amp < 0 { return false }
    if id == fx_haste_id(protocol) { (*f).haste = amp + 1; return true }
    if id == fx_fatigue_id(protocol) { (*f).fatigue = amp + 1; return true }
    return false
}

fn fx_on_remove(f: *mut Fx, protocol: i32, b: *mut bytes.Bytes) -> bool {
    let eid: i32 = bytes.get_varint(b) catch (0 - 1)
    if eid < 0 || eid != (*f).own { return false }
    let id: i32 = read_effect_id(b, protocol)
    if id == fx_haste_id(protocol) { (*f).haste = 0; return true }
    if id == fx_fatigue_id(protocol) { (*f).fatigue = 0; return true }
    return false
}
