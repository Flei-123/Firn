import std.rt
import mc.mc_item_regs
import mc.mc_tip_util

export { ih_line, ih_mask, HIDE_TAG, HIDE_ENCH, HIDE_POTION, HIDE_UNBREAKABLE, HIDE_ATTR, HIDE_ALL }

const HIDE_TAG: u8 = 107
const HIDE_ENCH: i64 = 1
const HIDE_POTION: i64 = 2
const HIDE_UNBREAKABLE: i64 = 4
const HIDE_ATTR: i64 = 8
const HIDE_ALL: i64 = 16

fn is_path(rp: u64, rn: usize, lit: str) -> bool {
    return rn == lit.n && rt.mem_eq(rp, lit.p as u64, lit.n)
}

fn starts(rp: u64, rn: usize, lit: str) -> bool {
    return rn >= lit.n && rt.mem_eq(rp, lit.p as u64, lit.n)
}

fn is_false(vp: u64, vn: usize) -> bool {
    return vn == 5 && rt.mem_eq(vp, "false".p as u64, 5)
}

fn is_true(vp: u64, vn: usize) -> bool {
    return vn == 4 && rt.mem_eq(vp, "true".p as u64, 4)
}

fn bit_of_component(protocol: i32, id: i64) -> i64 {
    if id == (mc_item_regs.comp_enchantments(protocol) as i64) || id == (mc_item_regs.comp_stored_enchantments(protocol) as i64) { return HIDE_ENCH }
    if id == (mc_item_regs.comp_potion_contents(protocol) as i64) { return HIDE_POTION }
    if id == (mc_item_regs.comp_unbreakable() as i64) { return HIDE_UNBREAKABLE }
    if id == (mc_item_regs.comp_attr_modifiers(protocol) as i64) { return HIDE_ATTR }
    return 0
}

fn ih_line(protocol: i32, ct: i32, rp: u64, rn: usize, vp: u64, vn: usize, out: *mut i64) -> bool {
    if ct < 0 { return false }
    if is_path(rp, rn, "type") {
        if ct == mc_item_regs.comp_hide_tooltip(protocol) { *out = HIDE_ALL; return true }
        if ct == mc_item_regs.comp_hide_additional(protocol) { *out = HIDE_ENCH + HIDE_POTION; return true }
        return false
    }
    if protocol <= 769 {
        if is_path(rp, rn, "data.showInTooltip") && is_false(vp, vn) {
            if ct == mc_item_regs.comp_enchantments(protocol) || ct == mc_item_regs.comp_stored_enchantments(protocol) { *out = HIDE_ENCH; return true }
            if ct == mc_item_regs.comp_unbreakable() { *out = HIDE_UNBREAKABLE; return true }
        }
        return false
    }
    if ct != mc_item_regs.comp_tooltip_display(protocol) { return false }
    if is_path(rp, rn, "data.hideTooltip") && is_true(vp, vn) { *out = HIDE_ALL; return true }
    if starts(rp, rn, "data.hiddenComponents[") {
        var ok: bool = false
        let id: i64 = mc_tip_util.parse_num(vp, vn, &ok)
        if !ok { return false }
        let bit: i64 = bit_of_component(protocol, id)
        if bit == 0 { return false }
        *out = bit
        return true
    }
    return false
}

fn ih_mask(rp: u64, rn: usize) -> i64 {
    var mask: i64 = 0
    var pos: usize = 0
    var tag: u8 = 0 as u8
    var lp: u64 = 0
    var ln: usize = 0
    while mc_tip_util.next_line(rp, rn, &pos, &tag, &lp, &ln) {
        if tag != HIDE_TAG { continue }
        var ok: bool = false
        let v: i64 = mc_tip_util.parse_num(lp, ln, &ok)
        if ok { mask = mask | v }
    }
    return mask
}
