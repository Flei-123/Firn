// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_session.fi -- FleiLauncher -> client hand-off (GDD 5a.2): the "session file".
//
// The launcher owns the account (Microsoft login, token refresh) and starts the client with ONE file that carries everything the client needs
// to join; the client has no login screen of its own. The file is plain text, one `key=value` per line, `#` starts a comment line:
//
//   host=127.0.0.1        server IPv4 literal              (required unless given on the command line)
//   port=25565            server port                      (required unless given on the command line)
//   name=Steve            player name                      (required unless given on the command line)
//   uuid=<32 hex>         profile id (dashes allowed)      (online login only)
//   mc_token=<token>      Minecraft access token           (online login only; absent = offline login)
//   protocol=763          protocol number                  (optional; MCPLAY_PROTOCOL wins, default 763)
//   view=6                view distance in chunks          (optional; MCPLAY_VIEW wins)
//
// Where the file comes from: `MCPLAY_SESSION_FILE=<path>` (a temporary file the launcher created with mode 0600; the client DELETES it after
// reading it unless MCPLAY_SESSION_KEEP=1) or `MCPLAY_SESSION_FILE=-` (the launcher writes the same text to the client's stdin and closes it).
// The token never appears on the command line or in the environment, so it is not visible in the process list. The client wipes its copy
// of the file text after use (`session_wipe`). Command line arguments (host port name) override the file's values of the same name.
import std.rt
import std.core

export { session_load, session_value, session_int, session_wipe, session_has }

// Value of the line `key=value` of the blob [p, n) appended to `out` (without the line end); false if the key is absent.
// Comment lines (first character `#`) never match. The first matching line wins.
fn session_value(p: u64, n: usize, key: str, out: *mut rt.Buf) -> bool {
    var i: usize = 0
    while i < n {
        var e: usize = i
        while e < n && rt.ld8(p, e) != 10 as u8 {
            e = e + 1
        }
        let kn: usize = key.length()
        if e - i > kn && rt.ld8(p, i) != 35 as u8 && rt.ld8(p, i + kn) == 61 as u8 {
            var same: bool = true
            var k: usize = 0
            while k < kn && same {
                if rt.ld8(p, i + k) != key.chars(k) {
                    same = false
                }
                k = k + 1
            }
            if same {
                var end: usize = e
                if end > i && rt.ld8(p, end - 1) == 13 as u8 {
                    end = end - 1
                }
                rt.buf_push_bytes(out, p + (i + kn + 1) as u64, end - i - kn - 1)
                return true
            }
        }
        i = e + 1
    }
    return false
}

// True if the key is present with a non empty value.
fn session_has(p: u64, n: usize, key: str) -> bool {
    var t: rt.Buf = rt.buf_new()
    let ok: bool = session_value(p, n, key, &t) && rt.buf_len(&t) > 0
    session_wipe(&t)
    rt.buf_free(&t)
    return ok
}

// Decimal value of the key; `fallback` if absent, empty or not a plain non negative number.
fn session_int(p: u64, n: usize, key: str, fallback: i32) -> i32 {
    var t: rt.Buf = rt.buf_new()
    var r: i32 = fallback
    if session_value(p, n, key, &t) && rt.buf_len(&t) > 0 && rt.buf_len(&t) <= 9 {
        let tp: u64 = rt.buf_ptr(&t)
        var v: i32 = 0
        var ok: bool = true
        var i: usize = 0
        while i < rt.buf_len(&t) {
            let c: u8 = rt.ld8(tp, i)
            if c < 48 as u8 || c > 57 as u8 {
                ok = false
            } else {
                v = v * 10 + (c as i32 - 48)
            }
            i = i + 1
        }
        if ok {
            r = v
        }
    }
    rt.buf_free(&t)
    return r
}

// Reads the session text into `out`: path "-" = stdin, otherwise the file at the NUL terminated path `path_c`. false if unreadable or empty.
fn session_load(path_c: u64, out: *mut rt.Buf) -> bool {
    var ok: bool = false
    if rt.c_length(path_c) == 1 && rt.ld8(path_c, 0) == 45 as u8 {
        ok = rt.read_stdin(out)
    } else {
        ok = rt.read_file(path_c, out)
    }
    return ok && rt.buf_len(out) > 0
}

// Overwrites the whole capacity of the buffer with zeros (token hygiene); the length is kept.
fn session_wipe(b: *mut rt.Buf) {
    let p: u64 = rt.buf_ptr(b)
    if p == 0 {
        return
    }
    var i: usize = 0
    while i < (*b).cap {
        rt.st8(p, i, 0 as u8)
        i = i + 1
    }
}
