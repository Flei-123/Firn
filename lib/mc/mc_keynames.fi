import std.rt

export { key_name, KEY_MOUSE_BASE, KEY_CODE_MAX }

const KEY_MOUSE_BASE: i32 = 256
const KEY_CODE_MAX: i32 = 263

const NAMES: str = "1 Escape\n2 1\n3 2\n4 3\n5 4\n6 5\n7 6\n8 7\n9 8\n10 9\n11 0\n12 -\n13 =\n14 Backspace\n15 Tab\n16 Q\n17 W\n18 E\n19 R\n20 T\n21 Y\n22 U\n23 I\n24 O\n25 P\n26 [\n27 ]\n28 Enter\n29 Left Control\n30 A\n31 S\n32 D\n33 F\n34 G\n35 H\n36 J\n37 K\n38 L\n39 ;\n40 '\n41 `\n42 Left Shift\n43 \\\n44 Z\n45 X\n46 C\n47 V\n48 B\n49 N\n50 M\n51 ,\n52 .\n53 /\n54 Right Shift\n55 Keypad *\n56 Left Alt\n57 Space\n58 Caps Lock\n59 F1\n60 F2\n61 F3\n62 F4\n63 F5\n64 F6\n65 F7\n66 F8\n67 F9\n68 F10\n87 F11\n88 F12\n96 Keypad Enter\n97 Right Control\n100 Right Alt\n102 Home\n103 Up\n104 Page Up\n105 Left\n106 Right\n107 End\n108 Down\n109 Page Down\n110 Insert\n111 Delete\n256 Left Button\n257 Right Button\n258 Middle Button\n259 Button 4\n260 Button 5\n261 Button 6\n262 Button 7\n263 Button 8\n"

fn read_number(s: str, i: usize, end: *mut usize) -> i32 {
    var v: i32 = 0
    var k: usize = i
    while k < s.length() && s.chars(k) >= 48 as u8 && s.chars(k) <= 57 as u8 {
        v = v * 10 + ((s.chars(k) as i32) - 48)
        k = k + 1
    }
    *end = k
    return v
}

fn key_name(code: i32, out: *mut rt.Buf) -> bool {
    var i: usize = 0
    while i < NAMES.length() {
        var e: usize = 0
        let c: i32 = read_number(NAMES, i, &e)
        var line_end: usize = e
        while line_end < NAMES.length() && NAMES.chars(line_end) != 10 as u8 {
            line_end = line_end + 1
        }
        if c == code {
            let start: usize = e + 1
            rt.buf_push_bytes(out, (NAMES.p as u64) + (start as u64), line_end - start)
            return true
        }
        i = line_end + 1
    }
    return false
}
