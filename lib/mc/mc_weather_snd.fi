// SPDX-License-Identifier: MPL-2.0
import mc.mc_audio
import mc.mc_weather
import mc.mc_precip

export {
    WeatherSnd, wsnd_new, wsnd_rain_step, wsnd_tick, wsnd_bolt, wsnd_rain_volume,
    SND_NONE, SND_RAIN, SND_RAIN_ROOF, RAIN_PERIOD_S, RAIN_MIN_MILLI,
}

const SND_NONE: i32 = 0
const SND_RAIN: i32 = 1
const SND_RAIN_ROOF: i32 = 2
const RAIN_PERIOD_S: f64 = 3.4
const RAIN_MIN_MILLI: i32 = 100
const RAIN_VOLUME: f32 = 0.55
const ROOF_VOLUME: f32 = 0.3
const ROOF_PITCH: f32 = 0.5
const THUNDER_RANGE: f32 = 1000.0
const IMPACT_RANGE: f32 = 64.0

struct WeatherSnd {
    timer: f64,
    rng: i64,
    ranges_set: bool,
    n_rain: u64,
    n_bolts: u64,
}

fn wsnd_new(seed: i64) -> WeatherSnd {
    return WeatherSnd { timer: RAIN_PERIOD_S, rng: seed % 2147483648 as i64, ranges_set: false, n_rain: 0 as u64, n_bolts: 0 as u64 }
}

fn next_unit(ws: *mut WeatherSnd) -> f64 {
    (*ws).rng = ((*ws).rng * 1103515245 as i64 + 12345 as i64) % 2147483648 as i64
    return ((*ws).rng as f64) / 2147483648.0
}

fn wsnd_rain_volume(rain_milli: i32, covered: bool) -> f32 {
    var base: f32 = RAIN_VOLUME
    if covered { base = ROOF_VOLUME }
    return base * (rain_milli as f32) / (mc_weather.LEVEL_MAX as f32)
}

fn wsnd_rain_step(ws: *mut WeatherSnd, rain_milli: i32, kind: i32, covered: bool, dt: f64) -> i32 {
    if rain_milli < RAIN_MIN_MILLI || kind != mc_precip.PRECIP_RAIN {
        (*ws).timer = RAIN_PERIOD_S
        return SND_NONE
    }
    (*ws).timer = (*ws).timer + dt
    if (*ws).timer < RAIN_PERIOD_S { return SND_NONE }
    (*ws).timer = 0.0
    if covered { return SND_RAIN_ROOF }
    return SND_RAIN
}

fn wsnd_tick(m: *mut mc_audio.McAudio, ws: *mut WeatherSnd, wx: *mut mc_weather.Weather, pc: *mut mc_precip.Precip, dt: f64) -> u32 {
    let rain: i32 = mc_weather.weather_rain_milli(wx)
    let act: i32 = wsnd_rain_step(ws, rain, (*pc).kind, (*pc).covered, dt)
    if act == SND_NONE { return 0 as u32 }
    var name: str = "weather.rain"
    var pitch: f32 = 1.0
    if act == SND_RAIN_ROOF {
        name = "weather.rain.above"
        pitch = ROOF_PITCH
    }
    let ev: i32 = mc_audio.mca_find(m, name)
    let h: u32 = mc_audio.mca_play_event(m, ev, mc_audio.CAT_WEATHER, false, 0 - 1, 0.0, 0.0, 0.0, wsnd_rain_volume(rain, (*pc).covered), pitch)
    if h != 0 as u32 { (*ws).n_rain = (*ws).n_rain + 1 as u64 }
    return h
}

fn wsnd_bolt(m: *mut mc_audio.McAudio, ws: *mut WeatherSnd, x: f64, y: f64, z: f64) -> u32 {
    if !(*ws).ranges_set {
        mc_audio.mca_set_range(m, "entity.lightning_bolt.thunder", THUNDER_RANGE)
        mc_audio.mca_set_range(m, "entity.lightning_bolt.impact", IMPACT_RANGE)
        (*ws).ranges_set = true
    }
    let tp: f32 = (0.8 + next_unit(ws) * 0.2) as f32
    let ip: f32 = (0.5 + next_unit(ws) * 0.2) as f32
    let h: u32 = mc_audio.mca_play_at(m, "entity.lightning_bolt.thunder", mc_audio.CAT_WEATHER, x, y, z, 1.0, tp)
    mc_audio.mca_play_at(m, "entity.lightning_bolt.impact", mc_audio.CAT_WEATHER, x, y, z, 1.0, ip)
    (*ws).n_bolts = (*ws).n_bolts + 1 as u64
    return h
}
