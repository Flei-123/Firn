import std.rt
import mc.mc_gui_ui
import mc.mc_gui_font

export { DeathUi, death_new, death_free, death_reset, death_frame, death_button_xy, DA_NONE, DA_RESPAWN, DA_TITLE, DEATH_ENABLE_MS }

const DA_NONE: i32 = 0
const DA_RESPAWN: i32 = 1
const DA_TITLE: i32 = 2
const DEATH_ENABLE_MS: u64 = 1000 as u64
const BTN_W: i32 = 200
const BTN_STEP: i32 = 24
const TOP_ARGB: u32 = 0x60500000
const BOTTOM_ARGB: u32 = 0xA0803030
const DIGITS: str = "0123456789"

struct DeathUi {
    confirm: bool,
    num: rt.Buf,
}

fn death_new() -> DeathUi {
    return DeathUi { confirm: false, num: rt.buf_new() }
}

fn death_free(d: *mut DeathUi) {
    rt.buf_free(&(*d).num)
}

fn death_reset(d: *mut DeathUi) {
    (*d).confirm = false
}

fn death_button_xy(uw: i32, uh: i32, k: i32, x: *mut i32, y: *mut i32) {
    *x = uw / 2 - BTN_W / 2
    *y = uh / 4 + 72 + k * BTN_STEP
}

fn push_number(b: *mut rt.Buf, v: i32) {
    rt.buf_clear(b)
    var n: i32 = v
    if n < 0 { n = 0 }
    var div: i32 = 1
    while n / div >= 10 { div = div * 10 }
    while div > 0 {
        let dg: i32 = (n / div) % 10
        rt.buf_push_bytes(b, DIGITS.p as u64 + (dg as u64), 1)
        div = div / 10
    }
}

fn draw_score(u: *mut mc_gui_ui.Ui, d: *mut DeathUi, score: i32, y: i32) {
    let label: str = mc_gui_ui.ui_lang(u, "deathScreen.score", "Score")
    let sep: str = ": "
    push_number(&(*d).num, score)
    let num: str = rt.buf_str(&(*d).num)
    let lw: i32 = mc_gui_ui.ui_text_width(u, label) + mc_gui_ui.ui_text_width(u, sep)
    let x: i32 = (*u).uw / 2 - (lw + mc_gui_ui.ui_text_width(u, num)) / 2
    mc_gui_ui.ui_label(u, x, y, mc_gui_ui.COLOR_WHITE, label)
    mc_gui_ui.ui_label(u, x + mc_gui_ui.ui_text_width(u, label), y, mc_gui_ui.COLOR_WHITE, sep)
    mc_gui_ui.ui_label(u, x + lw, y, 0xFFFF55 as u32, num)
}

fn draw_title(u: *mut mc_gui_ui.Ui, hardcore: bool) {
    var t: str = mc_gui_ui.ui_lang(u, "deathScreen.title", "You Died!")
    if hardcore { t = mc_gui_ui.ui_lang(u, "deathScreen.title.hardcore", "Game Over!") }
    let s: i32 = (*u).s
    mc_gui_font.gfont_draw_centered((*u).r, &(*(*u).pk).font, ((*u).uw / 2) * s, 60 * s, s * 2, mc_gui_ui.abgr(mc_gui_ui.COLOR_WHITE), true, t)
}

fn confirm_frame(u: *mut mc_gui_ui.Ui, d: *mut DeathUi) -> i32 {
    mc_gui_ui.ui_gradient(u, 0, 0, (*u).uw, (*u).uh, TOP_ARGB, BOTTOM_ARGB)
    let cx: i32 = (*u).uw / 2
    mc_gui_ui.ui_label_c(u, cx, 70, mc_gui_ui.COLOR_WHITE, mc_gui_ui.ui_lang(u, "deathScreen.quit.confirm", "Are you sure you want to quit?"))
    var act: i32 = DA_NONE
    let y: i32 = (*u).uh / 6 + 96
    if mc_gui_ui.ui_button(u, cx - 155, y, 150, mc_gui_ui.ui_lang(u, "deathScreen.titleScreen", "Title Screen"), true) { act = DA_TITLE }
    if mc_gui_ui.ui_button(u, cx + 5, y, 150, mc_gui_ui.ui_lang(u, "deathScreen.respawn", "Respawn"), true) { (*d).confirm = false; act = DA_RESPAWN }
    return act
}

fn death_frame(u: *mut mc_gui_ui.Ui, d: *mut DeathUi, hardcore: bool, msg_p: u64, msg_n: usize, score: i32, since_ms: u64) -> i32 {
    if (*d).confirm { return confirm_frame(u, d) }
    mc_gui_ui.ui_gradient(u, 0, 0, (*u).uw, (*u).uh, TOP_ARGB, BOTTOM_ARGB)
    draw_title(u, hardcore)
    let cx: i32 = (*u).uw / 2
    if msg_n > 0 {
        let m: str = str { p: msg_p as *u8, n: msg_n }
        mc_gui_ui.ui_label_c(u, cx, 85, mc_gui_ui.COLOR_WHITE, m)
    }
    draw_score(u, d, score, 100)
    let ready: bool = since_ms >= DEATH_ENABLE_MS
    var x: i32 = 0
    var y: i32 = 0
    var first: str = mc_gui_ui.ui_lang(u, "deathScreen.respawn", "Respawn")
    if hardcore { first = mc_gui_ui.ui_lang(u, "deathScreen.spectate", "Spectate World") }
    death_button_xy((*u).uw, (*u).uh, 0, &x, &y)
    var act: i32 = DA_NONE
    if mc_gui_ui.ui_button(u, x, y, BTN_W, first, ready) { act = DA_RESPAWN }
    death_button_xy((*u).uw, (*u).uh, 1, &x, &y)
    if mc_gui_ui.ui_button(u, x, y, BTN_W, mc_gui_ui.ui_lang(u, "deathScreen.titleScreen", "Title Screen"), ready) {
        if hardcore { act = DA_TITLE } else { (*d).confirm = true }
    }
    return act
}
