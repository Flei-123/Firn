// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_world_view.fi -- block lookups in mc_world with a one chunk cache (player movement, fluid probes).
//
//   view_new(&world, min_y)           a view over the world (min_y = world bottom, -64 in 1.20.1)
//   view_id(&v, x, y, z)              block id: -1 chunk not loaded, -2 outside the stored sections
//   view_kind(&v, mv, x, y, z)        movement kind (u8 table `mv`, one entry per block id) of the block; 0 when unknown

import std.rt
import mc.mc_world
import mc.mc_chunk

export { WorldView, view_new, view_id, view_kind }

struct WorldView {
    w: *mut mc_world.World,
    min_y: i32,
    cx: i32, cz: i32,
    chunk: u64,
    have: bool,
}

// block id at (x, y, z): -1 = chunk not loaded, -2 = above / below the stored sections
fn view_id(v: *mut WorldView, x: i32, y: i32, z: i32) -> i32 {
    let cx: i32 = mc_world.floor_div(x, 16)
    let cz: i32 = mc_world.floor_div(z, 16)
    if !(*v).have || cx != (*v).cx || cz != (*v).cz {
        (*v).chunk = mc_world.world_find((*v).w, cx, cz)
        (*v).cx = cx
        (*v).cz = cz
        (*v).have = true
    }
    if (*v).chunk == 0 { return -1 }
    let c: *mut mc_chunk.Chunk = (*v).chunk as *mut mc_chunk.Chunk
    let ly: i32 = y - (*v).min_y
    let sy: i32 = mc_world.floor_div(ly, 16)
    if sy < 0 || (sy as usize) >= (*c).nsec { return -2 }
    let sec: *mut mc_chunk.Section = mc_chunk.chunk_section(c, sy as usize)
    let i: usize = ((mc_world.floor_mod(ly, 16) * 16 + mc_world.floor_mod(z, 16)) * 16 + mc_world.floor_mod(x, 16)) as usize
    return mc_chunk.container_get(&(*sec).blocks, i) as i32
}

fn view_new(w: *mut mc_world.World, min_y: i32) -> WorldView {
    return WorldView { w: w, min_y: min_y, cx: 0, cz: 0, chunk: 0, have: false }
}

fn view_kind(v: *mut WorldView, mv: u64, x: i32, y: i32, z: i32) -> i32 {
    let id: i32 = view_id(v, x, y, z)
    if id < 0 || id >= 65536 { return 0 }
    return rt.ld8(mv, id as usize) as i32
}
