// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.json
import std.str

export {
    AssetIndex, aidx_new, aidx_free, aidx_parse, aidx_count, aidx_first, aidx_next, aidx_name,
    aidx_hash, aidx_lookup, aidx_hash_ok, aidx_object_path, aidx_version_index_id,
}

struct AssetIndex {
    d: json.Json,
    objects: u32,
}

fn aidx_new() -> AssetIndex {
    return AssetIndex { d: json.json_new(), objects: json.JSON_NONE }
}

fn aidx_free(ix: *mut AssetIndex) {
    json.json_free(&(*ix).d)
    (*ix).objects = json.JSON_NONE
}

fn aidx_parse(ix: *mut AssetIndex, p: u64, n: usize) -> bool {
    let ok: bool = json.json_parse(&(*ix).d, p, n) catch false
    if !ok { return false }
    let root: u32 = json.json_root(&(*ix).d)
    if root == json.JSON_NONE || json.json_kind(&(*ix).d, root) != json.JSON_OBJECT { return false }
    let obj: u32 = json.json_get(&(*ix).d, root, "objects".p as u64, 7)
    if obj == json.JSON_NONE || json.json_kind(&(*ix).d, obj) != json.JSON_OBJECT { return false }
    (*ix).objects = obj
    return true
}

fn aidx_count(ix: *mut AssetIndex) -> usize {
    if (*ix).objects == json.JSON_NONE { return 0 }
    return json.json_count(&(*ix).d, (*ix).objects)
}

fn aidx_first(ix: *mut AssetIndex) -> u32 {
    if (*ix).objects == json.JSON_NONE { return json.JSON_NONE }
    return json.json_child(&(*ix).d, (*ix).objects)
}

fn aidx_next(ix: *mut AssetIndex, e: u32) -> u32 {
    return json.json_next(&(*ix).d, e)
}

fn aidx_name(ix: *mut AssetIndex, e: u32) -> str.Span {
    return json.json_key(&(*ix).d, e)
}

fn aidx_hash(ix: *mut AssetIndex, e: u32) -> str.Span {
    if e == json.JSON_NONE { return str.span_empty() }
    let h: u32 = json.json_get(&(*ix).d, e, "hash".p as u64, 4)
    if h == json.JSON_NONE { return str.span_empty() }
    return json.json_string(&(*ix).d, h)
}

fn aidx_lookup(ix: *mut AssetIndex, name: u64, n: usize) -> u32 {
    if (*ix).objects == json.JSON_NONE { return json.JSON_NONE }
    return json.json_get(&(*ix).d, (*ix).objects, name, n)
}

fn aidx_hash_ok(h: str.Span) -> bool {
    if h.n < 3 || h.n > 64 { return false }
    var i: usize = 0
    while i < h.n {
        let c: u8 = rt.ld8(h.p as u64, i)
        let digit: bool = c >= 48 as u8 && c <= 57 as u8
        let lower: bool = c >= 97 as u8 && c <= 102 as u8
        if !digit && !lower { return false }
        i = i + 1
    }
    return true
}

fn push_s(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.length())
}

fn aidx_object_path(assets: str, h: str.Span, out: *mut rt.Buf) -> bool {
    if !aidx_hash_ok(h) { return false }
    push_s(out, assets)
    push_s(out, "/objects/")
    rt.buf_push_bytes(out, h.p as u64, 2)
    rt.buf_push(out, 47 as u8)
    rt.buf_push_bytes(out, h.p as u64, h.n)
    return true
}

fn string_member(d: *mut json.Json, obj: u32, key: str, out: *mut rt.Buf) -> bool {
    let v: u32 = json.json_get(d, obj, key.p as u64, key.length())
    if v == json.JSON_NONE || json.json_kind(d, v) != json.JSON_STRING { return false }
    let s: str.Span = json.json_string(d, v)
    if s.n == 0 || s.n > 64 { return false }
    var i: usize = 0
    while i < s.n {
        let c: u8 = rt.ld8(s.p as u64, i)
        if c == 47 as u8 || c == 92 as u8 || c == 0 as u8 { return false }
        i = i + 1
    }
    rt.buf_push_bytes(out, s.p as u64, s.n)
    return true
}

fn aidx_version_index_id(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: json.Json = json.json_new()
    var found: bool = false
    let ok: bool = json.json_parse(&d, p, n) catch false
    if ok {
        let root: u32 = json.json_root(&d)
        if root != json.JSON_NONE && json.json_kind(&d, root) == json.JSON_OBJECT {
            let ai: u32 = json.json_get(&d, root, "assetIndex".p as u64, 10)
            if ai != json.JSON_NONE && json.json_kind(&d, ai) == json.JSON_OBJECT {
                found = string_member(&d, ai, "id", out)
            }
            if !found { found = string_member(&d, root, "assets", out) }
        }
    }
    json.json_free(&d)
    return found
}
