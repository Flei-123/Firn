import std.rt
import mc.mc_raster
import mc.mc_camera
import mc.mc_world
import mc.mc_input
import mc.mc_blockset
import mc.mc_crack
import mc.mc_crack_anim
import mc.mc_ray_clear

export { crackv_open_faces, crackv_draw_block, crackv_draw_anims, crackv_unit_box }

fn solid_at(w: *mut mc_world.World, min_y: i32, itb: *mut mc_input.InputTables, x: i32, y: i32, z: i32) -> bool {
    let s: i32 = mc_blockset.world_get_block(w, min_y, x, y, z)
    if s < 0 || (s as usize) >= (*itb).n { return false }
    return rt.ld16((*itb).solid, s as usize) == 1 as u16
}

fn crackv_open_faces(w: *mut mc_world.World, min_y: i32, itb: *mut mc_input.InputTables, x: i32, y: i32, z: i32) -> u32 {
    var m: u32 = 0 as u32
    if !solid_at(w, min_y, itb, x - 1, y, z) { m = m | 1 as u32 }
    if !solid_at(w, min_y, itb, x + 1, y, z) { m = m | 2 as u32 }
    if !solid_at(w, min_y, itb, x, y - 1, z) { m = m | 4 as u32 }
    if !solid_at(w, min_y, itb, x, y + 1, z) { m = m | 8 as u32 }
    if !solid_at(w, min_y, itb, x, y, z - 1) { m = m | 16 as u32 }
    if !solid_at(w, min_y, itb, x, y, z + 1) { m = m | 32 as u32 }
    return m
}

fn crackv_unit_box(x: i32, y: i32, z: i32) -> mc_crack.CrackBox {
    return mc_crack.CrackBox { x0: x as f64, y0: y as f64, z0: z as f64, x1: (x + 1) as f64, y1: (y + 1) as f64, z1: (z + 1) as f64 }
}

struct WorldRay {
    w: *mut mc_world.World,
    min_y: i32,
    itb: *mut mc_input.InputTables,
    ox: i32,
    oy: i32,
    oz: i32,
}

fn world_solid(ud: u64, x: i32, y: i32, z: i32) -> bool {
    let wr: *mut WorldRay = ud as *mut WorldRay
    if x == (*wr).ox && y == (*wr).oy && z == (*wr).oz { return false }
    return solid_at((*wr).w, (*wr).min_y, (*wr).itb, x, y, z)
}

fn world_visible(ud: u64, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) -> bool {
    return mc_ray_clear.ray_clear(world_solid, ud, ax, ay, az, bx, by, bz)
}

fn crackv_draw_block(r: *mut mc_raster.Raster, cam: *mut mc_camera.Camera, t: *mut mc_crack.CrackTex, w: *mut mc_world.World, min_y: i32,
    itb: *mut mc_input.InputTables, x: i32, y: i32, z: i32, stage: i32, b: *mut mc_crack.CrackBox) {
    var wr: WorldRay = WorldRay { w: w, min_y: min_y, itb: itb, ox: x, oy: y, oz: z }
    var vis: mc_crack.CrackVis = mc_crack.CrackVis { test: world_visible, ud: (&wr) as u64 }
    mc_crack.crack_draw_vis(r, cam, t, stage, b, crackv_open_faces(w, min_y, itb, x, y, z), &vis)
}

fn crackv_draw_anims(r: *mut mc_raster.Raster, cam: *mut mc_camera.Camera, t: *mut mc_crack.CrackTex, a: *mut mc_crack_anim.CrackAnims,
    w: *mut mc_world.World, min_y: i32, itb: *mut mc_input.InputTables, now: u64) -> i32 {
    mc_crack_anim.crack_anims_expire(a, now)
    var n: i32 = mc_crack_anim.crack_anims_count(a)
    var i: i32 = 0
    while i < n {
        var x: i32 = 0
        var y: i32 = 0
        var z: i32 = 0
        var st: i32 = 0
        if mc_crack_anim.crack_anims_at(a, i, &x, &y, &z, &st) {
            var b: mc_crack.CrackBox = crackv_unit_box(x, y, z)
            crackv_draw_block(r, cam, t, w, min_y, itb, x, y, z, st, &b)
        }
        i = i + 1
    }
    return n
}
