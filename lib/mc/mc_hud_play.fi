import mc.mc_raster
import mc.mc_client
import mc.mc_sem
import mc.mc_chat_net
import mc.mc_pkt_field
import mc.mc_health
import mc.mc_inv
import mc.mc_registry
import mc.mc_input
import mc.mc_world
import mc.mc_hud_tex
import mc.mc_hud_state
import mc.mc_hud_vanilla
import mc.mc_hud_armor
import mc.mc_hud_air

export {
    HudPlay, hp_new, hp_free, hp_open, hp_vanilla, hp_on_packet, hp_tick, hp_draw_base, hp_draw_overlay,
    hp_toggle_hidden, hp_toggle_debug, hp_hidden, hp_debug, hp_set_debug, hp_hotbar_x, hp_hotbar_y,
}

const MODE_CREATIVE: i32 = 1
const MODE_SPECTATOR: i32 = 3

struct HudPlay {
    tex: mc_hud_tex.HudTex,
    st: mc_hud_state.HudState,
    view: mc_hud_vanilla.HudView,
    air: mc_hud_air.Air,
    vanilla: bool,
    hidden: bool,
    debug: bool,
}

fn hp_new() -> HudPlay {
    return HudPlay {
        tex: mc_hud_tex.hudtex_new(), st: mc_hud_state.hs_new(), view: mc_hud_vanilla.hv_new(), air: mc_hud_air.air_new(),
        vanilla: false, hidden: false, debug: false,
    }
}

fn hp_free(hp: *mut HudPlay) {
    mc_hud_tex.hudtex_free(&(*hp).tex)
}

fn hp_open(hp: *mut HudPlay, protocol: i32, enabled: bool) -> bool {
    (*hp).vanilla = false
    if !enabled { return false }
    (*hp).vanilla = mc_hud_tex.hudtex_open(&(*hp).tex, protocol)
    return (*hp).vanilla
}

fn hp_vanilla(hp: *mut HudPlay) -> bool {
    return (*hp).vanilla
}

fn hp_hidden(hp: *mut HudPlay) -> bool { return (*hp).hidden }

fn hp_debug(hp: *mut HudPlay) -> bool { return (*hp).debug }

fn hp_toggle_hidden(hp: *mut HudPlay) {
    (*hp).hidden = !(*hp).hidden
}

fn hp_toggle_debug(hp: *mut HudPlay) {
    (*hp).debug = !(*hp).debug
}

fn hp_set_debug(hp: *mut HudPlay, on: bool) {
    (*hp).debug = on
}

fn read_mode(cl: *mut mc_client.Client, id: i32, hp: *mut HudPlay, h: *mut mc_health.Health) {
    var m: i32 = 0
    if mc_pkt_field.pkt_i8(cl, id, "gameMode", &m) || mc_pkt_field.pkt_i8(cl, id, "gamemode", &m) || mc_pkt_field.pkt_i8(cl, id, "worldState.gamemode", &m) {
        (*h).mode = m & 255
    }
    var hc: i32 = 0
    if mc_pkt_field.pkt_i8(cl, id, "isHardcore", &hc) { (*hp).view.hardcore = hc != 0 }
}

fn hp_on_packet(hp: *mut HudPlay, net: *mut mc_chat_net.ChatNet, cl: *mut mc_client.Client, h: *mut mc_health.Health, id: i32, now: u64) -> bool {
    if mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_JOIN_GAME) || mc_client.client_is(cl, id, mc_sem.SEM_PLAY_S2C_RESPAWN) {
        read_mode(cl, id, hp, h)
        (*hp).air = mc_hud_air.air_new()
        return false
    }
    return mc_hud_state.hs_on_packet(&(*hp).st, net, cl, id, now)
}

fn hp_tick(hp: *mut HudPlay, h: *mut mc_health.Health, inv: *mut mc_inv.Inv, reg: *mut mc_registry.Registry, pl: *mut mc_input.Player, world: *mut mc_world.World, min_y: i32) {
    mc_hud_air.air_tick(&(*hp).air, pl, world, min_y)
    let v: *mut mc_hud_vanilla.HudView = &(*hp).view
    (*v).slot = (*pl).slot
    (*v).hp_x2 = (*h).hp
    var mx: i32 = 20
    if (*h).hp > mx { mx = (*h).hp + ((*h).hp & 1) }
    (*v).max_hp_x2 = mx
    (*v).food = (*h).food
    (*v).armor = mc_hud_armor.armor_points(inv, reg)
    (*v).air = (*hp).air.air
    (*v).underwater = (*hp).air.under || (*hp).air.air < mc_hud_air.AIR_MAX
    (*v).xp_x1000 = (*hp).st.xp_x1000
    (*v).level = (*hp).st.level
    let survival: bool = mc_health.health_visible(h) && (*h).mode != MODE_CREATIVE && (*h).mode != MODE_SPECTATOR
    (*v).show_bars = survival && !(*h).dead
    (*v).show_xp = survival
}

fn hp_hotbar_x(hp: *mut HudPlay, r: *mut mc_raster.Raster, s: i32) -> i32 {
    return mc_hud_vanilla.vh_hotbar_x(r, s)
}

fn hp_hotbar_y(hp: *mut HudPlay, r: *mut mc_raster.Raster, s: i32) -> i32 {
    return mc_hud_vanilla.vh_hotbar_y(r, s)
}

fn hp_draw_base(hp: *mut HudPlay, r: *mut mc_raster.Raster, s: i32) {
    if (*hp).hidden || !(*hp).vanilla { return }
    mc_hud_vanilla.vh_draw(r, &(*hp).tex, &(*hp).view, s)
}

fn hp_draw_overlay(hp: *mut HudPlay, r: *mut mc_raster.Raster, s: i32, now: u64) {
    if (*hp).hidden { return }
    if (*hp).vanilla { mc_hud_vanilla.vh_draw_bossbars(r, &(*hp).tex, &(*hp).st, s) }
    mc_hud_vanilla.vh_draw_title(r, &(*hp).st, s, now)
    mc_hud_vanilla.vh_draw_sidebar(r, &(*hp).st, s)
}
