// lib/mc/mc_crypto.fi -- the cryptography of the Minecraft login (protocol 763).
//
// During the Login state the server sends `encryption_begin`:
//
//     serverId (string), publicKey (X.509 SubjectPublicKeyInfo DER), verifyToken
//
// and the client answers `encryption_begin` with
//
//     sharedSecret = RSA-PKCS1-v1.5-encrypt(publicKey, 16 random octets)
//     verifyToken  = RSA-PKCS1-v1.5-encrypt(publicKey, the token it received)
//
// After that packet BOTH directions of the TCP stream are encrypted with
// AES-128 in CFB8 mode, key = IV = the shared secret. This file has exactly
// those three parts and nothing else:
//
//   1. rsa_key_from_spki       strict SubjectPublicKeyInfo DER -> RsaKey
//   2. rsa_encrypt_pkcs1       RSAES-PKCS1-v1_5 (RFC 8017 7.2.1), block type 2
//      shared_secret_new       16 octets from the kernel CSPRNG
//   3. Cfb8Stream              one stream per direction, in place, any chunking
//
// Honest limits:
//   * Only ENCRYPTION to a public key. No decryption, no key generation, no
//     signing (the client never needs them; the server side would).
//   * RSA public operations work on public data; `std.crypto.big` is not
//     constant time and does not need to be.
//   * PKCS#1 v1.5 encryption is what the protocol dictates. It is not a
//     recommendation (Bleichenbacher), but the client only ever ENCRYPTS.
//   * CFB8 uses one AES block encryption per octet. With AES-NI that is fast
//     (see docs/mc/crypto.md for measured numbers), without it much slower.
//
// Clean room: written from RFC 8017 / RFC 5280 / NIST SP 800-38A and checked
// against node's `crypto` module, never against Mojang code.

import std.rt
import std.crypto.aes
import std.crypto.rsa
import std.crypto.random
import tls.der

export {
    RsaKey, Cfb8Stream,
    CR_OK, CR_BAD_DER, CR_NOT_RSA, CR_BAD_KEY, CR_MSG_TOO_LONG, CR_RANDOM,
    CR_OUT_SMALL, CR_ARG,
    RSA_MAX_BYTES, RSA_MIN_BYTES, SHARED_SECRET_LEN,
    rsa_key_from_spki, rsa_key_bytes, rsa_key_bits, rsa_encrypt_pkcs1,
    shared_secret_new,
    cfb8_new, cfb8_new_soft, cfb8_encrypt, cfb8_decrypt, cfb8_wipe,
    error_name,
}

// ---- result codes -----------------------------------------------------------
const CR_OK: i32 = 0
const CR_BAD_DER: i32 = 1 // malformed / truncated / trailing bytes in the DER
const CR_NOT_RSA: i32 = 2 // well formed SubjectPublicKeyInfo, but not rsaEncryption
const CR_BAD_KEY: i32 = 3 // modulus size / exponent outside what is accepted
const CR_MSG_TOO_LONG: i32 = 4 // message longer than modulus - 11 octets
const CR_RANDOM: i32 = 5 // the kernel gave no random octets
const CR_OUT_SMALL: i32 = 6 // output buffer smaller than the modulus
const CR_ARG: i32 = 7 // empty key, null-ish argument

// ---- limits -------------------------------------------------------------------
const RSA_MAX_BYTES: usize = 512 // 4096 bit modulus (std.crypto.big holds 4352)
const RSA_MIN_BYTES: usize = 64 // 512 bit modulus; smaller keys are refused
const E_MAX_BYTES: usize = 8
const SHARED_SECRET_LEN: usize = 16

// The key in its own storage, so it stays valid after the packet buffer it came
// from is reused. `n` is big endian without leading zero octets.
struct RsaKey {
    n: [u8; 512],
    nlen: usize,
    e: [u8; 8],
    elen: usize,
}

fn error_name(code: i32) -> str {
    if code == CR_OK {
        return "ok"
    }
    if code == CR_BAD_DER {
        return "bad-der"
    }
    if code == CR_NOT_RSA {
        return "not-rsa"
    }
    if code == CR_BAD_KEY {
        return "bad-key"
    }
    if code == CR_MSG_TOO_LONG {
        return "message-too-long"
    }
    if code == CR_RANDOM {
        return "no-random"
    }
    if code == CR_OUT_SMALL {
        return "output-too-small"
    }
    if code == CR_ARG {
        return "bad-argument"
    }
    return "unknown"
}

// rsaEncryption, OID 1.2.840.113549.1.1.1, content octets only.
fn is_rsa_oid(d: *mut der.Der, off: usize, len: usize) -> bool {
    if len != 9 {
        return false
    }
    var want: [u8; 9] = [42, 134, 72, 134, 247, 13, 1, 1, 1]
    var i: usize = 0
    while i < 9 {
        if rt.ld8((*d).base, off + i) != want[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// Reads one INTEGER as an unsigned big endian number: refuses a negative one
// (high bit set) and strips leading zero octets. Returns the stripped offset
// and length through the out parameters.
fn read_uint(d: *mut der.Der, off: *mut usize, len: *mut usize) -> bool {
    var tag: u32 = 0
    var o: usize = 0
    var l: usize = 0
    if !der.der_read(d, &tag, &o, &l) {
        return false
    }
    if tag != der.T_INT || l == 0 {
        return false
    }
    if (rt.ld8((*d).base, o) & 128 as u8) != 0 as u8 {
        return false
    }
    while l > 1 && rt.ld8((*d).base, o) == 0 as u8 {
        o = o + 1
        l = l - 1
    }
    *off = o
    *len = l
    return true
}

// X.509 SubjectPublicKeyInfo (RFC 5280 4.1.2.7) holding an RSA key:
//
//   SEQUENCE { SEQUENCE { OID rsaEncryption, NULL },
//              BIT STRING { 00, SEQUENCE { INTEGER n, INTEGER e } } }
//
// Strict: every length is checked, trailing octets anywhere are an error, the
// parameters are NULL or absent, n is 512..4096 bits, e is odd and >= 3 and
// at most 8 octets. A damaged input gives an error code, never a crash.
fn rsa_key_from_spki(p: u64, n: usize, key: *mut RsaKey) -> i32 {
    (*key).nlen = 0
    (*key).elen = 0
    if p == 0 || n == 0 {
        return CR_ARG
    }
    var top: der.Der = der.der_open(p, 0, n)
    var spki: der.Der = der.der_open(p, 0, 0)
    if !der.der_enter(&top, der.T_SEQ, &spki) || !der.der_done(&top) {
        return CR_BAD_DER
    }
    var alg: der.Der = der.der_open(p, 0, 0)
    if !der.der_enter(&spki, der.T_SEQ, &alg) {
        return CR_BAD_DER
    }
    var tag: u32 = 0
    var off: usize = 0
    var len: usize = 0
    if !der.der_read(&alg, &tag, &off, &len) || tag != der.T_OID {
        return CR_BAD_DER
    }
    let rsa_oid: bool = is_rsa_oid(&alg, off, len)
    if !der.der_done(&alg) {
        if !der.der_read(&alg, &tag, &off, &len) || tag != der.T_NULL || len != 0 {
            if !rsa_oid {
                return CR_NOT_RSA
            }
            return CR_BAD_DER
        }
        if !der.der_done(&alg) {
            return CR_BAD_DER
        }
    }
    if !rsa_oid {
        return CR_NOT_RSA
    }
    if !der.der_read(&spki, &tag, &off, &len) || tag != der.T_BITSTRING {
        return CR_BAD_DER
    }
    if !der.der_done(&spki) {
        return CR_BAD_DER
    }
    if len < 2 || rt.ld8(p, off) != 0 as u8 {
        return CR_BAD_DER // no unused bits allowed in a key
    }
    var inner: der.Der = der.der_open(p, off + 1, len - 1)
    var body: der.Der = der.der_open(p, 0, 0)
    if !der.der_enter(&inner, der.T_SEQ, &body) || !der.der_done(&inner) {
        return CR_BAD_DER
    }
    var no: usize = 0
    var nl: usize = 0
    var eo: usize = 0
    var el: usize = 0
    if !read_uint(&body, &no, &nl) || !read_uint(&body, &eo, &el) {
        return CR_BAD_DER
    }
    if !der.der_done(&body) {
        return CR_BAD_DER
    }
    if nl < RSA_MIN_BYTES || nl > RSA_MAX_BYTES {
        return CR_BAD_KEY
    }
    if el > E_MAX_BYTES {
        return CR_BAD_KEY
    }
    // e must be odd and at least 3 (1 is the identity map and refused too)
    if (rt.ld8(p, eo + el - 1) & 1 as u8) == 0 as u8 {
        return CR_BAD_KEY
    }
    if el == 1 && rt.ld8(p, eo) < 3 as u8 {
        return CR_BAD_KEY
    }
    // the modulus must be odd (rsa_public_op / Montgomery need it)
    if (rt.ld8(p, no + nl - 1) & 1 as u8) == 0 as u8 {
        return CR_BAD_KEY
    }
    var i: usize = 0
    while i < nl {
        (*key).n[i] = rt.ld8(p, no + i)
        i = i + 1
    }
    i = 0
    while i < el {
        (*key).e[i] = rt.ld8(p, eo + i)
        i = i + 1
    }
    (*key).nlen = nl
    (*key).elen = el
    return CR_OK
}

// Size of the modulus in octets (= size of one ciphertext), 0 for an empty key.
fn rsa_key_bytes(key: *mut RsaKey) -> usize {
    return (*key).nlen
}

// Size of the modulus in bits (position of the highest set bit), 0 if empty.
fn rsa_key_bits(key: *mut RsaKey) -> usize {
    if (*key).nlen == 0 {
        return 0
    }
    var top: u32 = (*key).n[0] as u32
    var b: usize = 0
    while top != 0 {
        b = b + 1
        top = top >> 1
    }
    return ((*key).nlen - 1) * 8 + b
}

// n random octets, none of them 0.
fn random_nonzero(p: u64, n: usize) -> bool {
    if !random.random_bytes(p, n) {
        return false
    }
    var i: usize = 0
    var guard: usize = 0
    while i < n {
        while rt.ld8(p, i) == 0 as u8 {
            var b: [u8; 1] = [0; 1]
            if !random.random_bytes((&b[0]) as u64, 1) || guard > 100000 {
                return false
            }
            guard = guard + 1
            rt.st8(p, i, b[0])
        }
        i = i + 1
    }
    return true
}

// RSAES-PKCS1-v1_5 encryption (RFC 8017 7.2.1):
//
//   EM = 00 || 02 || PS || 00 || M      PS = >= 8 random NON-ZERO octets
//   C  = EM^e mod n                      (exactly `nlen` octets, big endian)
//
// `out` needs room for rsa_key_bytes(key) octets; `*outlen` receives that
// number. The message may be at most nlen - 11 octets. Padding is fresh random
// on every call, so two encryptions of the same message differ.
fn rsa_encrypt_pkcs1(key: *mut RsaKey, msg: u64, mlen: usize, out: u64,
    outcap: usize, outlen: *mut usize) -> i32 {
    *outlen = 0
    let k: usize = (*key).nlen
    if k == 0 || (*key).elen == 0 {
        return CR_ARG
    }
    if mlen + 11 > k {
        return CR_MSG_TOO_LONG
    }
    if outcap < k {
        return CR_OUT_SMALL
    }
    var em: [u8; 512] = [0; 512]
    em[0] = 0 as u8
    em[1] = 2 as u8
    let pslen: usize = k - mlen - 3
    if !random_nonzero((&em[2]) as u64, pslen) {
        return CR_RANDOM
    }
    em[2 + pslen] = 0 as u8
    var i: usize = 0
    while i < mlen {
        em[3 + pslen + i] = rt.ld8(msg, i)
        i = i + 1
    }
    if !rsa.rsa_public_op((&(*key).n[0]) as u64, k, (&(*key).e[0]) as u64,
        (*key).elen, (&em[0]) as u64, k, out) {
        return CR_BAD_KEY
    }
    *outlen = k
    return CR_OK
}

// 16 fresh octets from the kernel CSPRNG (getrandom, /dev/urandom fallback).
fn shared_secret_new(out: u64) -> bool {
    return random.random_bytes(out, SHARED_SECRET_LEN)
}

// ---- CFB8 stream -------------------------------------------------------------
//
// One Cfb8Stream per direction. The Minecraft protocol uses key = IV = the
// shared secret; the 16 octet shift register lives in the stream and advances
// by one octet per processed octet, so chunk boundaries never matter.

struct Cfb8Stream {
    aes: aes.Aes,
    iv: [u8; 16],
}

fn load16(secret: u64) -> [u8; 16] {
    var iv: [u8; 16] = [0; 16]
    var i: usize = 0
    while i < 16 {
        iv[i] = rt.ld8(secret, i)
        i = i + 1
    }
    return iv
}

// A stream with key = IV = the 16 octet `secret`. Uses AES-NI when the CPU has it.
fn cfb8_new(secret: u64) -> Cfb8Stream {
    return Cfb8Stream { aes: aes.aes128_new(secret), iv: load16(secret) }
}

// The same on the portable scalar path (for tests and CPUs without AES-NI).
fn cfb8_new_soft(secret: u64) -> Cfb8Stream {
    return Cfb8Stream { aes: aes.aes128_new_soft(secret), iv: load16(secret) }
}

// Encrypts `n` octets at `buf` in place.
fn cfb8_encrypt(s: *mut Cfb8Stream, buf: u64, n: usize) {
    aes.aes_cfb8_encrypt(&(*s).aes, (&(*s).iv[0]) as u64, buf, n, buf)
}


// Decryption of CFB8 is NOT serial: the keystream for octet i is the AES
// encryption of ciphertext octets i-16..i-1, which are all known in advance.
// So eight octets are pushed through the pipelined `aesenc` unit at once. The
// segment is first copied behind the 16 register octets into `scratch`
// (history || ciphertext), which also makes the in-place overwrite safe.
const SEG: usize = 4096

fn cfb8_decrypt_ni(s: *mut Cfb8Stream, buf: u64, n: usize) {
    let rk: u64 = (&(*s).aes.rk[0]) as u64
    let k0: v128 = __v128_load((rk + 0) as *u8)
    let k1: v128 = __v128_load((rk + 16) as *u8)
    let k2: v128 = __v128_load((rk + 32) as *u8)
    let k3: v128 = __v128_load((rk + 48) as *u8)
    let k4: v128 = __v128_load((rk + 64) as *u8)
    let k5: v128 = __v128_load((rk + 80) as *u8)
    let k6: v128 = __v128_load((rk + 96) as *u8)
    let k7: v128 = __v128_load((rk + 112) as *u8)
    let k8: v128 = __v128_load((rk + 128) as *u8)
    let k9: v128 = __v128_load((rk + 144) as *u8)
    let k10: v128 = __v128_load((rk + 160) as *u8)
    var scratch: [u8; 4128] = [0; 4128]
    let sc: u64 = (&scratch[0]) as u64
    var done: usize = 0
    while done < n {
        var m: usize = n - done
        if m > SEG {
            m = SEG
        }
        var i: usize = 0
        while i < 16 {
            rt.st8(sc, i, (*s).iv[i])
            i = i + 1
        }
        i = 0
        while i + 8 <= m {
            rt.st64(sc + 16, i / 8, rt.ld64(buf + done as u64, i / 8))
            i = i + 8
        }
        while i < m {
            rt.st8(sc, 16 + i, rt.ld8(buf, done + i))
            i = i + 1
        }
        var j: usize = 0
        while j + 8 <= m {
            var s0: v128 = __v128_xor(__v128_load((sc + (j + 0) as u64) as *u8), k0)
            var s1: v128 = __v128_xor(__v128_load((sc + (j + 1) as u64) as *u8), k0)
            var s2: v128 = __v128_xor(__v128_load((sc + (j + 2) as u64) as *u8), k0)
            var s3: v128 = __v128_xor(__v128_load((sc + (j + 3) as u64) as *u8), k0)
            var s4: v128 = __v128_xor(__v128_load((sc + (j + 4) as u64) as *u8), k0)
            var s5: v128 = __v128_xor(__v128_load((sc + (j + 5) as u64) as *u8), k0)
            var s6: v128 = __v128_xor(__v128_load((sc + (j + 6) as u64) as *u8), k0)
            var s7: v128 = __v128_xor(__v128_load((sc + (j + 7) as u64) as *u8), k0)
            s0 = __aesenc(s0, k1)
            s1 = __aesenc(s1, k1)
            s2 = __aesenc(s2, k1)
            s3 = __aesenc(s3, k1)
            s4 = __aesenc(s4, k1)
            s5 = __aesenc(s5, k1)
            s6 = __aesenc(s6, k1)
            s7 = __aesenc(s7, k1)
            s0 = __aesenc(s0, k2)
            s1 = __aesenc(s1, k2)
            s2 = __aesenc(s2, k2)
            s3 = __aesenc(s3, k2)
            s4 = __aesenc(s4, k2)
            s5 = __aesenc(s5, k2)
            s6 = __aesenc(s6, k2)
            s7 = __aesenc(s7, k2)
            s0 = __aesenc(s0, k3)
            s1 = __aesenc(s1, k3)
            s2 = __aesenc(s2, k3)
            s3 = __aesenc(s3, k3)
            s4 = __aesenc(s4, k3)
            s5 = __aesenc(s5, k3)
            s6 = __aesenc(s6, k3)
            s7 = __aesenc(s7, k3)
            s0 = __aesenc(s0, k4)
            s1 = __aesenc(s1, k4)
            s2 = __aesenc(s2, k4)
            s3 = __aesenc(s3, k4)
            s4 = __aesenc(s4, k4)
            s5 = __aesenc(s5, k4)
            s6 = __aesenc(s6, k4)
            s7 = __aesenc(s7, k4)
            s0 = __aesenc(s0, k5)
            s1 = __aesenc(s1, k5)
            s2 = __aesenc(s2, k5)
            s3 = __aesenc(s3, k5)
            s4 = __aesenc(s4, k5)
            s5 = __aesenc(s5, k5)
            s6 = __aesenc(s6, k5)
            s7 = __aesenc(s7, k5)
            s0 = __aesenc(s0, k6)
            s1 = __aesenc(s1, k6)
            s2 = __aesenc(s2, k6)
            s3 = __aesenc(s3, k6)
            s4 = __aesenc(s4, k6)
            s5 = __aesenc(s5, k6)
            s6 = __aesenc(s6, k6)
            s7 = __aesenc(s7, k6)
            s0 = __aesenc(s0, k7)
            s1 = __aesenc(s1, k7)
            s2 = __aesenc(s2, k7)
            s3 = __aesenc(s3, k7)
            s4 = __aesenc(s4, k7)
            s5 = __aesenc(s5, k7)
            s6 = __aesenc(s6, k7)
            s7 = __aesenc(s7, k7)
            s0 = __aesenc(s0, k8)
            s1 = __aesenc(s1, k8)
            s2 = __aesenc(s2, k8)
            s3 = __aesenc(s3, k8)
            s4 = __aesenc(s4, k8)
            s5 = __aesenc(s5, k8)
            s6 = __aesenc(s6, k8)
            s7 = __aesenc(s7, k8)
            s0 = __aesenc(s0, k9)
            s1 = __aesenc(s1, k9)
            s2 = __aesenc(s2, k9)
            s3 = __aesenc(s3, k9)
            s4 = __aesenc(s4, k9)
            s5 = __aesenc(s5, k9)
            s6 = __aesenc(s6, k9)
            s7 = __aesenc(s7, k9)
            s0 = __aesenclast(s0, k10)
            s1 = __aesenclast(s1, k10)
            s2 = __aesenclast(s2, k10)
            s3 = __aesenclast(s3, k10)
            s4 = __aesenclast(s4, k10)
            s5 = __aesenclast(s5, k10)
            s6 = __aesenclast(s6, k10)
            s7 = __aesenclast(s7, k10)
            rt.st8(buf, done + j + 0, rt.ld8(sc, 16 + j + 0) ^ (__v128_get_u32(s0, 0) & (255 as u32)) as u8)
            rt.st8(buf, done + j + 1, rt.ld8(sc, 16 + j + 1) ^ (__v128_get_u32(s1, 0) & (255 as u32)) as u8)
            rt.st8(buf, done + j + 2, rt.ld8(sc, 16 + j + 2) ^ (__v128_get_u32(s2, 0) & (255 as u32)) as u8)
            rt.st8(buf, done + j + 3, rt.ld8(sc, 16 + j + 3) ^ (__v128_get_u32(s3, 0) & (255 as u32)) as u8)
            rt.st8(buf, done + j + 4, rt.ld8(sc, 16 + j + 4) ^ (__v128_get_u32(s4, 0) & (255 as u32)) as u8)
            rt.st8(buf, done + j + 5, rt.ld8(sc, 16 + j + 5) ^ (__v128_get_u32(s5, 0) & (255 as u32)) as u8)
            rt.st8(buf, done + j + 6, rt.ld8(sc, 16 + j + 6) ^ (__v128_get_u32(s6, 0) & (255 as u32)) as u8)
            rt.st8(buf, done + j + 7, rt.ld8(sc, 16 + j + 7) ^ (__v128_get_u32(s7, 0) & (255 as u32)) as u8)
            j = j + 8
        }
        while j < m {
            var t: v128 = __v128_xor(__v128_load((sc + j as u64) as *u8), k0)
            t = __aesenc(t, k1)
            t = __aesenc(t, k2)
            t = __aesenc(t, k3)
            t = __aesenc(t, k4)
            t = __aesenc(t, k5)
            t = __aesenc(t, k6)
            t = __aesenc(t, k7)
            t = __aesenc(t, k8)
            t = __aesenc(t, k9)
            t = __aesenclast(t, k10)
            rt.st8(buf, done + j, rt.ld8(sc, 16 + j) ^ (__v128_get_u32(t, 0) & (255 as u32)) as u8)
            j = j + 1
        }
        i = 0
        while i < 16 {
            (*s).iv[i] = rt.ld8(sc, m + i)
            i = i + 1
        }
        done = done + m
    }
}

// Decrypts `n` octets at `buf` in place.
fn cfb8_decrypt(s: *mut Cfb8Stream, buf: u64, n: usize) {
    if (*s).aes.ni && n >= 16 {
        cfb8_decrypt_ni(s, buf, n)
        return
    }
    aes.aes_cfb8_decrypt(&(*s).aes, (&(*s).iv[0]) as u64, buf, n, buf)
}

// Overwrites the key schedule and the register (best effort, call when the
// connection closes).
fn cfb8_wipe(s: *mut Cfb8Stream) {
    var i: usize = 0
    while i < 240 {
        (*s).aes.rk[i] = 0 as u8
        i = i + 1
    }
    i = 0
    while i < 16 {
        (*s).iv[i] = 0 as u8
        i = i + 1
    }
}
