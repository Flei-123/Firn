import std.bytes
import mc.mc_client
import mc.mc_sem
import mc.mc_version

export { cn_send_rename, cn_send_button, cn_send_trade }

const VARINT_WINDOW_PROTOCOL: i32 = 768
const VARINT_BUTTON_PROTOCOL: i32 = 767

fn put_window(b: *mut bytes.Bytes, protocol: i32, win: i32) {
    if protocol >= VARINT_WINDOW_PROTOCOL { bytes.put_varint(b, win) } else { bytes.put_i8(b, win as i8) }
}

fn cn_send_rename(cl: *mut mc_client.Client, text: str) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_string(&b, text.p as u64, text.n)
    let ok: bool = mc_client.client_send(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_NAME_ITEM, &b)
    bytes.bytes_free(&b)
    return ok
}

fn cn_send_button(cl: *mut mc_client.Client, win: i32, button: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    put_window(&b, (*cl).ver.protocol, win)
    if (*cl).ver.protocol >= VARINT_BUTTON_PROTOCOL { bytes.put_varint(&b, button) } else { bytes.put_i8(&b, button as i8) }
    let ok: bool = mc_client.client_send(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_ENCHANT_ITEM, &b)
    bytes.bytes_free(&b)
    return ok
}

fn cn_send_trade(cl: *mut mc_client.Client, slot: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, slot)
    let ok: bool = mc_client.client_send(cl, mc_version.ST_PLAY, mc_sem.SEM_PLAY_C2S_SELECT_TRADE, &b)
    bytes.bytes_free(&b)
    return ok
}
