import std.rt
import mc.mc_xf
import mc.mc_backend
import mc.mc_entity_draw
import mc.mc_hurt_tint

export { Cube, CubeList, cl_new, cl_free, cl_clear, cl_add, cl_len, cl_at, vox_emit, vox_emit_one, rgb_of, CUBE_BYTES }

const CUBE_BYTES: usize = 32

struct Cube {
    x: f64,
    y: f64,
    z: f64,
    rgb: u32,
    size: u32,
}

struct CubeList {
    buf: rt.Buf,
}

fn cl_new() -> CubeList {
    return CubeList { buf: rt.buf_new() }
}

fn cl_free(c: *mut CubeList) {
    rt.buf_free(&(*c).buf)
}

fn cl_clear(c: *mut CubeList) {
    rt.buf_clear(&(*c).buf)
}

fn cl_len(c: *mut CubeList) -> usize {
    return rt.buf_len(&(*c).buf) / CUBE_BYTES
}

fn cl_at(c: *mut CubeList, i: usize) -> *mut Cube {
    return (rt.buf_ptr(&(*c).buf) + ((i * CUBE_BYTES) as u64)) as *mut Cube
}

fn cl_add(c: *mut CubeList, x: f64, y: f64, z: f64, rgb: u32, size_milli: u32) {
    var cube: Cube = Cube { x: x, y: y, z: z, rgb: rgb, size: size_milli }
    rt.buf_push_bytes(&(*c).buf, (&cube) as u64, CUBE_BYTES)
}

fn rgb_of(abgr: u32) -> u32 {
    return abgr & 0xFFFFFF as u32
}

fn push_rec(l: *mut mc_entity_draw.EntList, x: f64, y: f64, z: f64, s: f64, ys: f64, yc: f64, rgb: u32, tint_k: i32) {
    var r: i32 = (rgb & 255 as u32) as i32
    var g: i32 = ((rgb >> 8 as u32) & 255 as u32) as i32
    var b: i32 = ((rgb >> 16 as u32) & 255 as u32) as i32
    if tint_k > 0 {
        let packed: i32 = mc_hurt_tint.hurt_blend(r, g, b, tint_k)
        r = packed & 255
        g = (packed >> 8) & 255
        b = (packed >> 16) & 255
    }
    var rec: [f64; 12] = [x, y, z, s, s, s, ys, yc, r as f64, g as f64, b as f64, 0.0]
    rt.buf_push_bytes(&(*l).buf, (&rec[0]) as u64, mc_backend.ENT_BYTES)
}

fn vox_emit(l: *mut mc_entity_draw.EntList, cl: *mut CubeList, xf: *mut mc_xf.Xf, unit: f64, ys: f64, yc: f64, tint_k: i32) {
    let n: usize = cl_len(cl)
    var o: [f64; 3] = [0.0; 3]
    var i: usize = 0
    while i < n {
        let c: *mut Cube = cl_at(cl, i)
        mc_xf.xf_apply(xf, (*c).x, (*c).y, (*c).z, &o)
        push_rec(l, o[0], o[1], o[2], ((*c).size as f64) * 0.001 * unit, ys, yc, (*c).rgb, tint_k)
        i = i + 1
    }
}

fn vox_emit_one(l: *mut mc_entity_draw.EntList, x: f64, y: f64, z: f64, s: f64, ys: f64, yc: f64, rgb: u32, tint_k: i32) {
    push_rec(l, x, y, z, s, ys, yc, rgb, tint_k)
}
