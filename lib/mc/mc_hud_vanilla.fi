import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_hud_tex
import mc.mc_hud_state

export {
    HudView, hv_new, vh_gui_w, vh_gui_h, vh_draw, vh_draw_hotbar, vh_draw_crosshair, vh_draw_bars, vh_draw_xp, vh_draw_bossbars, vh_draw_title,
    vh_draw_sidebar, vh_hotbar_x, vh_hotbar_y,
}

const HEART_CONTAINER_U: i32 = 16
const HEART_FULL_U: i32 = 52
const HEART_HALF_U: i32 = 61
const HARDCORE_V: i32 = 45
const FOOD_V: i32 = 27
const ARMOR_V: i32 = 9
const AIR_V: i32 = 18
const LEVEL_COLOR: u32 = 0xFF20FF80
const OUTLINE_COLOR: u32 = 0xFF000000
const TEXT_WHITE: u32 = 0xFFFFFFFF
const SHADOW: u32 = 0xFF3F3F3F
const SCORE_RED: u32 = 0xFF5555FF
const SIDEBAR_BG: u32 = 0x50000000
const SIDEBAR_TITLE_BG: u32 = 0x66000000
const SIDEBAR_ROWS: i32 = 15
const AIR_FULL: i32 = 300

struct HudView {
    slot: i32,
    hp_x2: i32,
    max_hp_x2: i32,
    food: i32,
    armor: i32,
    air: i32,
    xp_x1000: i32,
    level: i32,
    show_bars: bool,
    show_xp: bool,
    hardcore: bool,
    underwater: bool,
}

fn hv_new() -> HudView {
    return HudView {
        slot: 0, hp_x2: 20, max_hp_x2: 20, food: 20, armor: 0, air: AIR_FULL, xp_x1000: 0, level: 0,
        show_bars: true, show_xp: true, hardcore: false, underwater: false,
    }
}

fn vh_gui_w(r: *mut mc_raster.Raster, s: i32) -> i32 {
    return ((*r).w + s - 1) / s
}

fn vh_gui_h(r: *mut mc_raster.Raster, s: i32) -> i32 {
    return ((*r).h + s - 1) / s
}

fn vh_hotbar_x(r: *mut mc_raster.Raster, s: i32) -> i32 {
    return (vh_gui_w(r, s) / 2 - 91) * s
}

fn vh_hotbar_y(r: *mut mc_raster.Raster, s: i32) -> i32 {
    return (vh_gui_h(r, s) - 22) * s
}

fn vh_draw_hotbar(r: *mut mc_raster.Raster, t: *mut mc_hud_tex.HudTex, slot: i32, s: i32) {
    let gx: i32 = vh_gui_w(r, s) / 2 - 91
    let gy: i32 = vh_gui_h(r, s) - 22
    mc_hud_tex.hudtex_blit(r, &(*t).widgets, gx * s, gy * s, s, 0, 0, 182, 22)
    var sl: i32 = slot
    if sl < 0 { sl = 0 }
    if sl > 8 { sl = 8 }
    mc_hud_tex.hudtex_blit(r, &(*t).widgets, (gx - 1 + sl * 20) * s, (gy - 1) * s, s, 0, 22, 24, 24)
}

fn vh_draw_crosshair(r: *mut mc_raster.Raster, t: *mut mc_hud_tex.HudTex, s: i32) {
    let gx: i32 = (vh_gui_w(r, s) - 15) / 2
    let gy: i32 = (vh_gui_h(r, s) - 15) / 2
    mc_hud_tex.hudtex_blit_invert(r, &(*t).icons, gx * s, gy * s, s, 0, 0, 15, 15)
}

fn icon(r: *mut mc_raster.Raster, t: *mut mc_hud_tex.HudTex, gx: i32, gy: i32, u: i32, v: i32, s: i32) {
    mc_hud_tex.hudtex_blit(r, &(*t).icons, gx * s, gy * s, s, u, v, 9, 9)
}

fn row_height(max_hp_x2: i32) -> i32 {
    let hearts: i32 = (max_hp_x2 + 1) / 2
    let rows: i32 = (hearts + 9) / 10
    var h: i32 = 10 - (rows - 2)
    if h < 3 { h = 3 }
    return h
}

fn vh_draw_bars(r: *mut mc_raster.Raster, t: *mut mc_hud_tex.HudTex, v: *mut HudView, s: i32) {
    let gw: i32 = vh_gui_w(r, s)
    let gh: i32 = vh_gui_h(r, s)
    let left: i32 = gw / 2 - 91
    let right: i32 = gw / 2 + 91
    let top: i32 = gh - 39
    var maxx2: i32 = (*v).max_hp_x2
    if maxx2 < 2 { maxx2 = 2 }
    let hearts: i32 = (maxx2 + 1) / 2
    let rows: i32 = (hearts + 9) / 10
    let rh: i32 = row_height(maxx2)
    var hv: i32 = 0
    if (*v).hardcore { hv = HARDCORE_V }
    var i: i32 = hearts - 1
    while i >= 0 {
        let x: i32 = left + (i % 10) * 8
        let y: i32 = top - (i / 10) * rh
        icon(r, t, x, y, HEART_CONTAINER_U, hv, s)
        if i * 2 + 1 < (*v).hp_x2 { icon(r, t, x, y, HEART_FULL_U, hv, s) }
        if i * 2 + 1 == (*v).hp_x2 { icon(r, t, x, y, HEART_HALF_U, hv, s) }
        i = i - 1
    }
    if (*v).armor > 0 {
        let ay: i32 = top - (rows - 1) * rh - 10
        var k: i32 = 0
        while k < 10 {
            let x: i32 = left + k * 8
            if k * 2 + 1 < (*v).armor { icon(r, t, x, ay, 34, ARMOR_V, s) }
            if k * 2 + 1 == (*v).armor { icon(r, t, x, ay, 25, ARMOR_V, s) }
            if k * 2 + 1 > (*v).armor { icon(r, t, x, ay, 16, ARMOR_V, s) }
            k = k + 1
        }
    }
    var k: i32 = 0
    while k < 10 {
        let x: i32 = right - k * 8 - 9
        icon(r, t, x, top, HEART_CONTAINER_U, FOOD_V, s)
        if k * 2 + 1 < (*v).food { icon(r, t, x, top, HEART_FULL_U, FOOD_V, s) }
        if k * 2 + 1 == (*v).food { icon(r, t, x, top, HEART_HALF_U, FOOD_V, s) }
        k = k + 1
    }
    if (*v).underwater || (*v).air < AIR_FULL {
        var air: i32 = (*v).air
        if air < 0 { air = 0 }
        let full: i32 = (((air - 2) * 10) + AIR_FULL - 1) / AIR_FULL
        let all: i32 = ((air * 10) + AIR_FULL - 1) / AIR_FULL
        var nf: i32 = full
        if nf < 0 { nf = 0 }
        var b: i32 = 0
        while b < all {
            let x: i32 = right - b * 8 - 9
            if b < nf { icon(r, t, x, top - 10, HEART_CONTAINER_U, AIR_V, s) } else { icon(r, t, x, top - 10, 25, AIR_V, s) }
            b = b + 1
        }
    }
}

fn vh_draw_xp(r: *mut mc_raster.Raster, t: *mut mc_hud_tex.HudTex, xp_x1000: i32, level: i32, s: i32) {
    let gw: i32 = vh_gui_w(r, s)
    let gh: i32 = vh_gui_h(r, s)
    let gx: i32 = gw / 2 - 91
    let gy: i32 = gh - 32 + 3
    mc_hud_tex.hudtex_blit(r, &(*t).icons, gx * s, gy * s, s, 0, 64, 182, 5)
    var w: i32 = (xp_x1000 * 183) / 1000
    if w > 182 { w = 182 }
    if w > 0 { mc_hud_tex.hudtex_blit(r, &(*t).icons, gx * s, gy * s, s, 0, 69, w, 5) }
    if level > 0 {
        var b: rt.Buf = rt.buf_new()
        mc_hud.hud_push_int(&b, level as i64)
        let tw: i32 = mc_hud.hud_text_width(rt.buf_len(&b), s)
        let x: i32 = (gw * s - tw) / 2
        let y: i32 = (gh - 31 - 4) * s
        let p: u64 = rt.buf_ptr(&b)
        let n: usize = rt.buf_len(&b)
        mc_hud.hud_text_bytes(r, x + s, y, s, OUTLINE_COLOR, mc_hud.HUD_NO_SHADOW, p, n)
        mc_hud.hud_text_bytes(r, x - s, y, s, OUTLINE_COLOR, mc_hud.HUD_NO_SHADOW, p, n)
        mc_hud.hud_text_bytes(r, x, y + s, s, OUTLINE_COLOR, mc_hud.HUD_NO_SHADOW, p, n)
        mc_hud.hud_text_bytes(r, x, y - s, s, OUTLINE_COLOR, mc_hud.HUD_NO_SHADOW, p, n)
        mc_hud.hud_text_bytes(r, x, y, s, LEVEL_COLOR, mc_hud.HUD_NO_SHADOW, p, n)
        rt.buf_free(&b)
    }
}

fn vh_draw(r: *mut mc_raster.Raster, t: *mut mc_hud_tex.HudTex, v: *mut HudView, s: i32) {
    vh_draw_crosshair(r, t, s)
    vh_draw_hotbar(r, t, (*v).slot, s)
    if (*v).show_bars { vh_draw_bars(r, t, v, s) }
    if (*v).show_xp { vh_draw_xp(r, t, (*v).xp_x1000, (*v).level, s) }
}

fn vh_draw_bossbars(r: *mut mc_raster.Raster, t: *mut mc_hud_tex.HudTex, hs: *mut mc_hud_state.HudState, s: i32) {
    let gw: i32 = vh_gui_w(r, s)
    let gh: i32 = vh_gui_h(r, s)
    var y: i32 = 12
    var i: usize = 0
    while i < mc_hud_state.BARS_MAX && y < gh / 3 {
        if (*hs).bar_used[i] {
            let gx: i32 = gw / 2 - 91
            let col: i32 = (*hs).bar_color[i]
            mc_hud_tex.hudtex_blit(r, &(*t).bars, gx * s, y * s, s, 0, col * 10, 182, 5)
            var d: i32 = (*hs).bar_div[i]
            if d > 0 && d <= 4 { mc_hud_tex.hudtex_blit(r, &(*t).bars, gx * s, y * s, s, 0, 70 + d * 10, 182, 5) }
            var w: i32 = ((*hs).bar_pct[i] * 183) / 1000
            if w > 182 { w = 182 }
            if w > 0 {
                mc_hud_tex.hudtex_blit(r, &(*t).bars, gx * s, y * s, s, 0, col * 10 + 5, w, 5)
                if d > 0 && d <= 4 { mc_hud_tex.hudtex_blit(r, &(*t).bars, gx * s, y * s, s, 0, 75 + d * 10, w, 5) }
            }
            let n: usize = mc_hud_state.hs_bar_text_len(hs, i)
            let tw: i32 = mc_hud.hud_text_width(n, s)
            mc_hud.hud_text_bytes(r, (gw * s - tw) / 2, (y - 9) * s, s, TEXT_WHITE, SHADOW, mc_hud_state.hs_bar_ptr(hs, i), n)
            y = y + 19
        }
        i = i + 1
    }
}

fn alpha_color(rgb: u32, a: i32) -> u32 {
    return ((a as u32) << 24 as u32) | (rgb & 0xFFFFFF as u32)
}

fn vh_draw_title(r: *mut mc_raster.Raster, hs: *mut mc_hud_state.HudState, s: i32, now: u64) {
    let a: i32 = mc_hud_state.hs_title_alpha(hs, now)
    if a <= 8 { return }
    let cx: i32 = (*r).w / 2
    let cy: i32 = (*r).h / 2
    let tn: usize = mc_hud_state.hs_title_len(hs)
    let sn: usize = mc_hud_state.hs_subtitle_len(hs)
    let ts: i32 = 4 * s
    let ss: i32 = 2 * s
    if tn > 0 {
        let w: i32 = mc_hud.hud_text_width(tn, ts)
        mc_hud.hud_text_bytes(r, cx - w / 2, cy - 10 * s - 4 * s, ts, alpha_color(0xFFFFFF as u32, a), mc_hud.HUD_NO_SHADOW, mc_hud_state.hs_title_ptr(hs), tn)
    }
    if sn > 0 {
        let w: i32 = mc_hud.hud_text_width(sn, ss)
        mc_hud.hud_text_bytes(r, cx - w / 2, cy + 5 * s - ss, ss, alpha_color(0xFFFFFF as u32, a), mc_hud.HUD_NO_SHADOW, mc_hud_state.hs_subtitle_ptr(hs), sn)
    }
}

fn vh_draw_sidebar(r: *mut mc_raster.Raster, hs: *mut mc_hud_state.HudState, s: i32) {
    let tl: usize = mc_hud_state.hs_sidebar_title_len(hs)
    if (*hs).sb_obj_len == 0 { return }
    var order: [i32; 64] = [0; 64]
    let total: i32 = mc_hud_state.hs_sidebar_row_order(hs, (&order[0]) as u64, 64)
    var n: i32 = total
    if n > SIDEBAR_ROWS { n = SIDEBAR_ROWS }
    var width: i32 = mc_hud.hud_text_width(tl, 1)
    var i: i32 = 0
    var digits: rt.Buf = rt.buf_new()
    while i < n {
        let at: usize = order[i as usize] as usize
        rt.buf_clear(&digits)
        mc_hud.hud_push_int(&digits, mc_hud_state.hs_score_value(hs, at) as i64)
        let w: i32 = mc_hud.hud_text_width(mc_hud_state.hs_score_name_len(hs, at), 1) + 6 + mc_hud.hud_text_width(rt.buf_len(&digits), 1)
        if w > width { width = w }
        i = i + 1
    }
    let gw: i32 = vh_gui_w(r, s)
    let gh: i32 = vh_gui_h(r, s)
    let rows_h: i32 = n * 9
    let y1: i32 = gh / 2 + rows_h / 3
    let x1: i32 = gw - 3 + 2
    let x0: i32 = gw - 3 - width
    let title_y: i32 = y1 - n * 9 - 9
    mc_hud.hud_rect(r, (x0 - 2) * s, (title_y - 1) * s, (x1 - x0 + 2) * s, 10 * s, SIDEBAR_TITLE_BG)
    mc_hud.hud_rect(r, (x0 - 2) * s, (title_y + 9) * s, (x1 - x0 + 2) * s, (n * 9 + 1) * s, SIDEBAR_BG)
    mc_hud.hud_text_bytes(r, (x0 + width / 2 - mc_hud.hud_text_width(tl, 1) / 2) * s, title_y * s, s, TEXT_WHITE, mc_hud.HUD_NO_SHADOW, mc_hud_state.hs_sidebar_title_ptr(hs), tl)
    i = 0
    while i < n {
        let at: usize = order[i as usize] as usize
        let y: i32 = y1 - (n - i) * 9 + 1
        mc_hud.hud_text_bytes(r, x0 * s, y * s, s, 0xFFFFFFFF as u32, mc_hud.HUD_NO_SHADOW, mc_hud_state.hs_score_name_ptr(hs, at), mc_hud_state.hs_score_name_len(hs, at))
        rt.buf_clear(&digits)
        mc_hud.hud_push_int(&digits, mc_hud_state.hs_score_value(hs, at) as i64)
        let w: i32 = mc_hud.hud_text_width(rt.buf_len(&digits), 1)
        mc_hud.hud_text_bytes(r, (x1 - 2 - w) * s, y * s, s, SCORE_RED, mc_hud.HUD_NO_SHADOW, rt.buf_ptr(&digits), rt.buf_len(&digits))
        i = i + 1
    }
    rt.buf_free(&digits)
}
