import std.rt
import std.json
import std.str
import mc.mc_item_src
import mc.mc_item_raster
import mc.mc_item_name
import mc.mc_model
import mc.mc_assets
import mc.mc_gui_tex
import mc.mc_registry
import mc.mc_raster

export { IconCache, icons_src, icons_new, icons_free, icons_open, icons_ok, icons_draw, icons_get }

const KIND_MISSING: i32 = 0
const KIND_FLAT: i32 = 1
const KIND_ENTITY: i32 = 2
const KIND_MODEL: i32 = 3
const MAX_DEPTH: usize = 10
const TEX_STRIDE: usize = 16
const MAX_TEX: usize = 48
const WHITE: u32 = 0xFFFFFFFF

struct IconCache {
    src: mc_item_src.ItemSrc,
    scale: i32,
    cap: i32,
    tex: u64,
    state: u64,
    grass: u32,
}

fn icons_new() -> IconCache {
    return IconCache { src: mc_item_src.isrc_new(), scale: 0, cap: 0, tex: 0 as u64, state: 0 as u64, grass: WHITE }
}

fn icons_ok(ic: *mut IconCache) -> bool { return mc_item_src.isrc_ok(&(*ic).src) && (*ic).cap > 0 }

fn slot_tex(ic: *mut IconCache, k: i32) -> *mut mc_gui_tex.GuiTex {
    return ((*ic).tex + ((k as usize * TEX_STRIDE) as u64)) as *mut mc_gui_tex.GuiTex
}

fn reset_slots(ic: *mut IconCache) {
    var k: i32 = 0
    while k < (*ic).cap {
        mc_gui_tex.gtex_free(slot_tex(ic, k))
        rt.st8((*ic).state, k as usize, 0 as u8)
        k = k + 1
    }
}

fn icons_free(ic: *mut IconCache) {
    if (*ic).cap > 0 {
        reset_slots(ic)
        rt.heap_free((*ic).tex, (*ic).cap as usize * TEX_STRIDE)
        rt.heap_free((*ic).state, (*ic).cap as usize)
    }
    (*ic).cap = 0
    (*ic).tex = 0 as u64
    (*ic).state = 0 as u64
    mc_item_src.isrc_free(&(*ic).src)
}

fn rgb(r: u32, g: u32, b: u32) -> u32 {
    return 0xFF000000 as u32 | (b << 16 as u32) | (g << 8 as u32) | r
}

fn sample_grass(ic: *mut IconCache) {
    let buf: u64 = rt.heap_alloc(65536 * 4)
    if mc_assets.stack_load_colormap(mc_item_src.isrc_stack(&(*ic).src), "grass", buf) {
        let c: u32 = rt.ld32(buf, 127 * 256 + 127)
        (*ic).grass = rgb((c >> 16 as u32) & 255 as u32, (c >> 8 as u32) & 255 as u32, c & 255 as u32)
    }
    rt.heap_free(buf, 65536 * 4)
}

fn icons_open(ic: *mut IconCache, protocol: i32, items: i32) -> bool {
    if icons_ok(ic) { return true }
    if items <= 0 || !mc_item_src.isrc_open(&(*ic).src, protocol) { return false }
    (*ic).cap = items
    (*ic).tex = rt.heap_alloc(items as usize * TEX_STRIDE)
    (*ic).state = rt.heap_alloc(items as usize)
    var k: i32 = 0
    while k < items {
        *slot_tex(ic, k) = mc_gui_tex.gtex_empty()
        rt.st8((*ic).state, k as usize, 0 as u8)
        k = k + 1
    }
    sample_grass(ic)
    return true
}

fn tint_of(ic: *mut IconCache, p: u64, n: usize, idx: i32) -> u32 {
    if idx != 0 { return WHITE }
    if mc_item_name.name_has(p, n, "leather_") { return rgb(0xA0 as u32, 0x65 as u32, 0x40 as u32) }
    if mc_item_name.name_is(p, n, "grass_block") || mc_item_name.name_is(p, n, "grass") || mc_item_name.name_is(p, n, "short_grass") { return (*ic).grass }
    if mc_item_name.name_is(p, n, "fern") || mc_item_name.name_is(p, n, "tall_grass") || mc_item_name.name_is(p, n, "large_fern") { return (*ic).grass }
    if mc_item_name.name_is(p, n, "lily_pad") { return rgb(0x20 as u32, 0x80 as u32, 0x30 as u32) }
    if mc_item_name.name_has(p, n, "_leaves") && !mc_item_name.name_has(p, n, "azalea") && !mc_item_name.name_has(p, n, "cherry") {
        if mc_item_name.name_is(p, n, "birch_leaves") { return rgb(0x80 as u32, 0xA7 as u32, 0x55 as u32) }
        if mc_item_name.name_is(p, n, "spruce_leaves") { return rgb(0x61 as u32, 0x99 as u32, 0x61 as u32) }
        return rgb(0x48 as u32, 0xB5 as u32, 0x18 as u32)
    }
    return WHITE
}

fn push_lit(b: *mut rt.Buf, s: str) { rt.buf_push_bytes(b, s.p as u64, s.length()) }

fn push_clean(b: *mut rt.Buf, p: u64, n: usize) {
    if n > 10 && rt.mem_eq(p, "minecraft:".p as u64, 10) {
        rt.buf_push_bytes(b, p + (10 as u64), n - 10)
        return
    }
    rt.buf_push_bytes(b, p, n)
}

fn jget(d: *mut json.Json, obj: u32, key: str) -> u32 {
    if obj == json.JSON_NONE { return json.JSON_NONE }
    if json.json_kind(d, obj) != json.JSON_OBJECT { return json.JSON_NONE }
    return json.json_get(d, obj, key.p as u64, key.length())
}

fn take_str(d: *mut json.Json, v: u32, out: *mut rt.Buf) {
    if rt.buf_len(out) > 0 { return }
    if v == json.JSON_NONE { return }
    if json.json_kind(d, v) != json.JSON_STRING { return }
    let sp: str.Span = json.json_string(d, v)
    push_clean(out, sp.p as u64, sp.n)
}

fn span_is(sp: str.Span, lit: str) -> bool {
    return sp.n == lit.length() && rt.mem_eq(sp.p as u64, lit.p as u64, sp.n)
}

fn scan_level(ic: *mut IconCache, cur: *mut rt.Buf, l0: *mut rt.Buf, l1: *mut rt.Buf, part: *mut rt.Buf, kind: *mut i32) -> bool {
    var path: rt.Buf = rt.buf_new()
    push_lit(&path, "assets/minecraft/models/")
    rt.buf_push_bytes(&path, rt.buf_ptr(cur), rt.buf_len(cur))
    push_lit(&path, ".json")
    var raw: rt.Buf = rt.buf_new()
    let ok: bool = mc_item_src.isrc_read(&(*ic).src, rt.buf_ptr(&path), rt.buf_len(&path), &raw)
    rt.buf_free(&path)
    var more: bool = false
    if ok {
        var d: json.Json = json.json_new()
        let pr: bool = json.json_parse(&d, rt.buf_ptr(&raw), rt.buf_len(&raw)) catch false
        if pr {
            let root: u32 = json.json_root(&d)
            let tx: u32 = jget(&d, root, "textures")
            take_str(&d, jget(&d, tx, "layer0"), l0)
            take_str(&d, jget(&d, tx, "layer1"), l1)
            take_str(&d, jget(&d, tx, "particle"), part)
            let par: u32 = jget(&d, root, "parent")
            if par != json.JSON_NONE && json.json_kind(&d, par) == json.JSON_STRING {
                let sp: str.Span = json.json_string(&d, par)
                if span_is(sp, "builtin/generated") {
                    *kind = KIND_FLAT
                } else if span_is(sp, "builtin/entity") {
                    *kind = KIND_ENTITY
                } else {
                    rt.buf_clear(cur)
                    push_clean(cur, sp.p as u64, sp.n)
                    more = true
                }
            }
        }
        json.json_free(&d)
    } else {
        *kind = KIND_MISSING
    }
    rt.buf_free(&raw)
    return more
}

fn scan_model(ic: *mut IconCache, p: u64, n: usize, l0: *mut rt.Buf, l1: *mut rt.Buf, part: *mut rt.Buf) -> i32 {
    var cur: rt.Buf = rt.buf_new()
    push_lit(&cur, "item/")
    rt.buf_push_bytes(&cur, p, n)
    var kind: i32 = KIND_MODEL
    var depth: usize = 0
    var more: bool = true
    while more && depth < MAX_DEPTH {
        more = scan_level(ic, &cur, l0, l1, part, &kind)
        depth = depth + 1
    }
    rt.buf_free(&cur)
    return kind
}

fn load_tex(ic: *mut IconCache, p: u64, n: usize, out: *mut mc_gui_tex.GuiTex) -> bool {
    var path: rt.Buf = rt.buf_new()
    push_lit(&path, "assets/minecraft/textures/")
    rt.buf_push_bytes(&path, p, n)
    push_lit(&path, ".png")
    let ok: bool = mc_item_src.isrc_tex(&(*ic).src, rt.buf_ptr(&path), rt.buf_len(&path), out)
    rt.buf_free(&path)
    return ok
}

fn paint_layer(ic: *mut IconCache, p: u64, n: usize, layer: i32, name: *mut rt.Buf, out: *mut mc_gui_tex.GuiTex) -> bool {
    if rt.buf_len(name) == 0 { return false }
    var t: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    if !load_tex(ic, rt.buf_ptr(name), rt.buf_len(name), &t) { return false }
    let tint: u32 = tint_of(ic, p, n, layer)
    var j: i32 = 0
    while j < (*out).h {
        var i: i32 = 0
        while i < (*out).w {
            let c: u32 = mc_gui_tex.gtex_get(&t, (i * t.w) / (*out).w, (j * t.h) / (*out).h)
            if (c >> 24 as u32) != 0 as u32 { mc_gui_tex.gtex_set(out, i, j, mc_item_raster.shaded(c, 255 as u32, tint)) }
            i = i + 1
        }
        j = j + 1
    }
    mc_gui_tex.gtex_free(&t)
    return true
}

fn build_flat(ic: *mut IconCache, p: u64, n: usize, l0: *mut rt.Buf, l1: *mut rt.Buf, size: i32, out: *mut mc_gui_tex.GuiTex) -> bool {
    if !mc_gui_tex.gtex_blank(out, size, size) { return false }
    let a: bool = paint_layer(ic, p, n, 0, l0, out)
    let b: bool = paint_layer(ic, p, n, 1, l1, out)
    if !a && !b {
        mc_gui_tex.gtex_free(out)
        return false
    }
    return true
}

fn build_model(ic: *mut IconCache, p: u64, n: usize, size: i32, out: *mut mc_gui_tex.GuiTex) -> bool {
    var name: rt.Buf = rt.buf_new()
    push_lit(&name, "item/")
    rt.buf_push_bytes(&name, p, n)
    var b: mc_model.Baked = mc_model.baked_new()
    let nq: i32 = mc_model.model_bake(mc_item_src.isrc_stack(&(*ic).src), rt.buf_str(&name), 0, 0, false, &b)
    rt.buf_free(&name)
    if nq <= 0 {
        mc_model.baked_free(&b)
        return false
    }
    let nt: usize = mc_model.baked_tex_count(&b)
    let tex: u64 = rt.heap_alloc(MAX_TEX * TEX_STRIDE)
    var k: usize = 0
    while k < MAX_TEX {
        *((tex + ((k * TEX_STRIDE) as u64)) as *mut mc_gui_tex.GuiTex) = mc_gui_tex.gtex_empty()
        k = k + 1
    }
    k = 0
    while k < nt && k < MAX_TEX {
        var nm: mc_model.Name = mc_model.name_new()
        if mc_model.baked_tex_name(&b, k, &nm) { load_tex(ic, mc_model.name_ptr(&nm), nm.n, (tex + ((k * TEX_STRIDE) as u64)) as *mut mc_gui_tex.GuiTex) }
        k = k + 1
    }
    let tints: u64 = rt.heap_alloc(mc_item_raster.IRASTER_TINTS * 4)
    k = 0
    while k < mc_item_raster.IRASTER_TINTS {
        rt.st32(tints, k, tint_of(ic, p, n, k as i32))
        k = k + 1
    }
    var ok: bool = mc_gui_tex.gtex_blank(out, size, size)
    if ok { mc_item_raster.iraster_draw(&b, tex, nt, tints, out) }
    k = 0
    while k < MAX_TEX {
        mc_gui_tex.gtex_free((tex + ((k * TEX_STRIDE) as u64)) as *mut mc_gui_tex.GuiTex)
        k = k + 1
    }
    rt.heap_free(tex, MAX_TEX * TEX_STRIDE)
    rt.heap_free(tints, mc_item_raster.IRASTER_TINTS * 4)
    mc_model.baked_free(&b)
    return ok
}

fn build_icon(ic: *mut IconCache, p: u64, n: usize, size: i32, out: *mut mc_gui_tex.GuiTex) -> bool {
    var l0: rt.Buf = rt.buf_new()
    var l1: rt.Buf = rt.buf_new()
    var part: rt.Buf = rt.buf_new()
    let kind: i32 = scan_model(ic, p, n, &l0, &l1, &part)
    var ok: bool = false
    if kind == KIND_FLAT { ok = build_flat(ic, p, n, &l0, &l1, size, out) }
    if kind == KIND_MODEL { ok = build_model(ic, p, n, size, out) }
    if !ok && kind != KIND_MISSING && rt.buf_len(&part) > 0 { ok = build_flat(ic, p, n, &part, &l1, size, out) }
    rt.buf_free(&l0)
    rt.buf_free(&l1)
    rt.buf_free(&part)
    return ok
}

fn icons_get(ic: *mut IconCache, reg: *mut mc_registry.Registry, item: i32, s: i32) -> *mut mc_gui_tex.GuiTex {
    if !icons_ok(ic) || item < 0 || item >= (*ic).cap || s <= 0 { return 0 as u64 as *mut mc_gui_tex.GuiTex }
    if s != (*ic).scale {
        reset_slots(ic)
        (*ic).scale = s
    }
    let st: u8 = rt.ld8((*ic).state, item as usize)
    if st == 1 as u8 { return slot_tex(ic, item) }
    if st == 2 as u8 { return 0 as u64 as *mut mc_gui_tex.GuiTex }
    var nl: usize = 0
    let np: u64 = mc_registry.reg_item_name(reg, item, &nl)
    var ok: bool = false
    if nl > 0 { ok = build_icon(ic, np, nl, 16 * s, slot_tex(ic, item)) }
    if ok {
        rt.st8((*ic).state, item as usize, 1 as u8)
        return slot_tex(ic, item)
    }
    rt.st8((*ic).state, item as usize, 2 as u8)
    return 0 as u64 as *mut mc_gui_tex.GuiTex
}

fn icons_draw(ic: *mut IconCache, r: *mut mc_raster.Raster, reg: *mut mc_registry.Registry, item: i32, x: i32, y: i32, s: i32) -> bool {
    let t: *mut mc_gui_tex.GuiTex = icons_get(ic, reg, item, s)
    if (t as u64) == 0 as u64 { return false }
    mc_gui_tex.gtex_draw(r, t, x, y, 16 * s, 16 * s, 0, 0, 16 * s, 16 * s, WHITE)
    return true
}

fn icons_src(ic: *mut IconCache) -> *mut mc_item_src.ItemSrc { return &(*ic).src }
