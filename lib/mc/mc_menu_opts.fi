import std.rt
import mc.mc_opts
import mc.mc_gui_ui
import mc.mc_menu_info
import mc.mc_menu_keys
import mc.mc_keybinds

export {
    OptsUi, optui_new, optui_frame, optui_reset,
    PAGE_ROOT, PAGE_SOUNDS, PAGE_VIDEO, PAGE_CONTROLS, PAGE_ACCESS,
}

const PAGE_ROOT: i32 = 0
const PAGE_SOUNDS: i32 = 1
const PAGE_VIDEO: i32 = 2
const PAGE_CONTROLS: i32 = 3
const PAGE_ACCESS: i32 = 4
const ROOT_COUNT: i32 = 12
const COL_W: i32 = 150
const BIG_W: i32 = 310
const FOV_NORMAL: i32 = 70
const SLIDER_BASE_ID: i32 = 100

struct OptsUi {
    page: i32,
    changed: bool,
    keys: mc_menu_keys.KeysUi,
}

fn optui_new() -> OptsUi {
    return OptsUi { page: PAGE_ROOT, changed: false, keys: mc_menu_keys.keysui_new() }
}

fn optui_reset(s: *mut OptsUi) {
    (*s).page = PAGE_ROOT
    (*s).changed = false
    mc_menu_keys.keysui_reset(&(*s).keys)
}

fn root_key(i: i32) -> str {
    if i == 0 { return "options.fov" }
    if i == 1 { return "options.online" }
    if i == 2 { return "options.skinCustomisation" }
    if i == 3 { return "options.sounds" }
    if i == 4 { return "options.video" }
    if i == 5 { return "options.controls" }
    if i == 6 { return "options.language" }
    if i == 7 { return "options.chat" }
    if i == 8 { return "options.resourcepack" }
    if i == 9 { return "options.accessibility.title" }
    if i == 10 { return "options.telemetry" }
    return "options.credits_and_attribution"
}

fn root_fallback(i: i32) -> str {
    if i == 0 { return "FOV" }
    if i == 1 { return "Online..." }
    if i == 2 { return "Skin Customization..." }
    if i == 3 { return "Music & Sounds..." }
    if i == 4 { return "Video Settings..." }
    if i == 5 { return "Controls..." }
    if i == 6 { return "Language..." }
    if i == 7 { return "Chat Settings..." }
    if i == 8 { return "Resource Packs..." }
    if i == 9 { return "Accessibility Settings..." }
    if i == 10 { return "Telemetry Data..." }
    return "Credits & Attribution"
}

fn cat_key(i: i32) -> str {
    if i == 0 { return "soundCategory.master" }
    if i == 1 { return "soundCategory.music" }
    if i == 2 { return "soundCategory.record" }
    if i == 3 { return "soundCategory.weather" }
    if i == 4 { return "soundCategory.block" }
    if i == 5 { return "soundCategory.hostile" }
    if i == 6 { return "soundCategory.neutral" }
    if i == 7 { return "soundCategory.player" }
    if i == 8 { return "soundCategory.ambient" }
    return "soundCategory.voice"
}

fn cat_fallback(i: i32) -> str {
    if i == 0 { return "Master Volume" }
    if i == 1 { return "Music" }
    if i == 2 { return "Jukebox/Note Blocks" }
    if i == 3 { return "Weather" }
    if i == 4 { return "Blocks" }
    if i == 5 { return "Hostile Creatures" }
    if i == 6 { return "Friendly Creatures" }
    if i == 7 { return "Players" }
    if i == 8 { return "Ambient/Environment" }
    return "Voice/Speech"
}

fn push_s(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn begin_label(b: *mut rt.Buf, name: str) {
    rt.buf_clear(b)
    push_s(b, name)
    push_s(b, ": ")
}

fn on_off(u: *mut mc_gui_ui.Ui, v: i32) -> str {
    if v != 0 { return mc_gui_ui.ui_lang(u, "options.on", "ON") }
    return mc_gui_ui.ui_lang(u, "options.off", "OFF")
}

fn frame_title(u: *mut mc_gui_ui.Ui, key: str, fallback: str) {
    mc_gui_ui.ui_dirt(u, 0x404040)
    mc_gui_ui.ui_label_c(u, (*u).uw / 2, 15, mc_gui_ui.COLOR_WHITE, mc_gui_ui.ui_lang(u, key, fallback))
}

fn done_button(u: *mut mc_gui_ui.Ui) -> bool {
    return mc_gui_ui.ui_button(u, (*u).uw / 2 - 100, (*u).uh / 6 + 168, 200, mc_gui_ui.ui_lang(u, "gui.done", "Done"), true)
}

fn fov_slider(u: *mut mc_gui_ui.Ui, s: *mut OptsUi, o: *mut mc_opts.Opts, x: i32, y: i32) {
    var b: rt.Buf = rt.buf_new()
    begin_label(&b, mc_gui_ui.ui_lang(u, "options.fov", "FOV"))
    if (*o).fov == FOV_NORMAL {
        push_s(&b, mc_gui_ui.ui_lang(u, "options.fov.min", "Normal"))
    } else if (*o).fov == mc_opts.FOV_MAX {
        push_s(&b, mc_gui_ui.ui_lang(u, "options.fov.max", "Quake Pro"))
    } else {
        rt.buf_push_dec_i64(&b, (*o).fov as i64)
    }
    if mc_gui_ui.ui_slider(u, SLIDER_BASE_ID, x, y, COL_W, rt.buf_str(&b), &(*o).fov, mc_opts.FOV_MIN, mc_opts.FOV_MAX) { (*s).changed = true }
    rt.buf_free(&b)
}

fn root_page(u: *mut mc_gui_ui.Ui, s: *mut OptsUi, o: *mut mc_opts.Opts) -> bool {
    frame_title(u, "options.title", "Options")
    let cx: i32 = (*u).uw / 2
    var i: i32 = 0
    while i < ROOT_COUNT {
        let x: i32 = cx - 155 + (i % 2) * 160
        let y: i32 = (*u).uh / 6 - 12 + 24 * (i / 2)
        if i == 0 {
            fov_slider(u, s, o, x, y)
        } else {
            let on: bool = i == 3 || i == 4 || i == 5 || i == 9
            if mc_gui_ui.ui_button(u, x, y, COL_W, mc_gui_ui.ui_lang(u, root_key(i), root_fallback(i)), on) {
                if i == 3 { (*s).page = PAGE_SOUNDS }
                if i == 4 { (*s).page = PAGE_VIDEO }
                if i == 5 { (*s).page = PAGE_CONTROLS }
                if i == 9 { (*s).page = PAGE_ACCESS }
            }
        }
        i = i + 1
    }
    return done_button(u) || (*u).key_esc
}

fn sounds_page(u: *mut mc_gui_ui.Ui, s: *mut OptsUi, o: *mut mc_opts.Opts) -> bool {
    frame_title(u, "options.sounds.title", "Music & Sound Options")
    let cx: i32 = (*u).uw / 2
    var b: rt.Buf = rt.buf_new()
    var i: i32 = 0
    while i < mc_opts.OPT_VOLUMES {
        begin_label(&b, mc_gui_ui.ui_lang(u, cat_key(i), cat_fallback(i)))
        if (*o).vol[i as usize] == 0 {
            push_s(&b, mc_gui_ui.ui_lang(u, "options.off", "OFF"))
        } else {
            rt.buf_push_dec_i64(&b, (*o).vol[i as usize] as i64)
            push_s(&b, "%")
        }
        var x: i32 = cx - 155
        var y: i32 = (*u).uh / 6 - 12
        var w: i32 = BIG_W
        if i > 0 {
            x = cx - 155 + ((i - 1) % 2) * 160
            y = (*u).uh / 6 - 12 + 24 * (1 + (i - 1) / 2)
            w = COL_W
        }
        if mc_gui_ui.ui_slider(u, SLIDER_BASE_ID + 1 + i, x, y, w, rt.buf_str(&b), &(*o).vol[i as usize], 0, 100) { (*s).changed = true }
        i = i + 1
    }
    rt.buf_free(&b)
    return done_button(u) || (*u).key_esc
}

fn video_page(u: *mut mc_gui_ui.Ui, s: *mut OptsUi, o: *mut mc_opts.Opts) -> bool {
    frame_title(u, "options.videoTitle", "Video Settings")
    let cx: i32 = (*u).uw / 2
    let y0: i32 = (*u).uh / 6 - 12
    var b: rt.Buf = rt.buf_new()
    var view: i32 = mc_opts.opts_view_effective(o)
    begin_label(&b, mc_gui_ui.ui_lang(u, "options.renderDistance", "Render Distance"))
    rt.buf_push_dec_i64(&b, view as i64)
    push_s(&b, " chunks")
    if mc_gui_ui.ui_slider(u, SLIDER_BASE_ID + 20, cx - 155, y0, COL_W, rt.buf_str(&b), &view, mc_opts.VIEW_MIN, mc_opts.VIEW_MAX) {
        (*o).view = view
        (*s).changed = true
    }
    begin_label(&b, mc_gui_ui.ui_lang(u, "options.guiScale", "GUI Scale"))
    if (*o).gui_scale == 0 {
        push_s(&b, mc_gui_ui.ui_lang(u, "options.guiScale.auto", "Auto"))
    } else {
        rt.buf_push_dec_i64(&b, (*o).gui_scale as i64)
    }
    if mc_gui_ui.ui_slider(u, SLIDER_BASE_ID + 21, cx + 5, y0, COL_W, rt.buf_str(&b), &(*o).gui_scale, 0, mc_opts.GUI_SCALE_MAX) { (*s).changed = true }
    begin_label(&b, mc_gui_ui.ui_lang(u, "options.vsync", "VSync"))
    push_s(&b, on_off(u, (*o).vsync))
    if mc_gui_ui.ui_button(u, cx - 155, y0 + 24, COL_W, rt.buf_str(&b), true) {
        (*o).vsync = 1 - (*o).vsync
        (*s).changed = true
    }
    begin_label(&b, mc_gui_ui.ui_lang(u, "options.fullscreen", "Fullscreen"))
    push_s(&b, on_off(u, (*o).fullscreen))
    if mc_gui_ui.ui_button(u, cx + 5, y0 + 24, COL_W, rt.buf_str(&b), true) {
        (*o).fullscreen = 1 - (*o).fullscreen
        (*s).changed = true
    }
    rt.buf_free(&b)
    return done_button(u) || (*u).key_esc
}

fn optui_frame(u: *mut mc_gui_ui.Ui, s: *mut OptsUi, o: *mut mc_opts.Opts, kb: *mut mc_keybinds.Keybinds) -> bool {
    var back: bool = false
    if (*s).page == PAGE_ROOT {
        return root_page(u, s, o)
    } else if (*s).page == PAGE_SOUNDS {
        back = sounds_page(u, s, o)
    } else if (*s).page == PAGE_VIDEO {
        back = video_page(u, s, o)
    } else if (*s).page == PAGE_CONTROLS {
        back = mc_menu_keys.keys_frame(u, &(*s).keys, kb)
    } else {
        back = mc_menu_info.info_frame(u, mc_gui_ui.ui_lang(u, "options.accessibility.title", "Accessibility Settings..."), "Accessibility options are not available yet.", "") || (*u).key_esc
    }
    if back { (*s).page = PAGE_ROOT }
    return false
}
