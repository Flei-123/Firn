import mc.mc_raster
import mc.mc_hud
import mc.mc_combat_fx

export { combat_ui_draw, USE_BAR_FILL, USE_BAR_FULL, HIT_MARK_MS, HURT_FLASH_MS, BAR_BACK, BAR_FILL, HIT_COLOR }

const HIT_MARK_MS: i64 = 300
const HURT_FLASH_MS: i64 = 400
const HURT_ALPHA_MAX: i64 = 110
const BAR_BACK: u32 = 0xA0404040
const BAR_FILL: u32 = 0xFFFFFFFF
const HIT_COLOR: u32 = 0xFF3030FF
const HURT_RGB: u32 = 0x000000D0
const BAR_HALF: i32 = 8
const BAR_DROP: i32 = 9
const USE_BAR_DROP: i32 = 13
const USE_BAR_FILL: u32 = 0xFFE6C84A
const USE_BAR_FULL: u32 = 0xFF6AE04A
const MARK_GAP: i32 = 3
const MARK_LEN: i32 = 4

fn draw_bar(r: *mut mc_raster.Raster, scale: i32, permille: i32) {
    let cx: i32 = (*r).w / 2
    let cy: i32 = (*r).h / 2
    let w: i32 = 2 * BAR_HALF * scale
    let x0: i32 = cx - BAR_HALF * scale
    let y0: i32 = cy + BAR_DROP * scale
    mc_hud.hud_rect(r, x0, y0, w, scale, BAR_BACK)
    mc_hud.hud_rect(r, x0, y0, (w * permille) / 1000, scale, BAR_FILL)
}

fn draw_use_bar(r: *mut mc_raster.Raster, scale: i32, permille: i32) {
    let cx: i32 = (*r).w / 2
    let cy: i32 = (*r).h / 2
    let w: i32 = 2 * BAR_HALF * scale
    let x0: i32 = cx - BAR_HALF * scale
    let y0: i32 = cy + USE_BAR_DROP * scale
    var col: u32 = USE_BAR_FILL
    if permille >= 1000 { col = USE_BAR_FULL }
    mc_hud.hud_rect(r, x0, y0, w, scale, BAR_BACK)
    mc_hud.hud_rect(r, x0, y0, (w * permille) / 1000, scale, col)
}

fn draw_hit_mark(r: *mut mc_raster.Raster, scale: i32) {
    let cx: i32 = (*r).w / 2
    let cy: i32 = (*r).h / 2
    var k: i32 = 0
    while k < MARK_LEN {
        let d: i32 = (MARK_GAP + k) * scale
        mc_hud.hud_rect(r, cx - d - scale, cy - d - scale, scale, scale, HIT_COLOR)
        mc_hud.hud_rect(r, cx + d, cy - d - scale, scale, scale, HIT_COLOR)
        mc_hud.hud_rect(r, cx - d - scale, cy + d, scale, scale, HIT_COLOR)
        mc_hud.hud_rect(r, cx + d, cy + d, scale, scale, HIT_COLOR)
        k = k + 1
    }
}

fn draw_hurt_flash(r: *mut mc_raster.Raster, age: i64) {
    let a: i64 = (HURT_ALPHA_MAX * (HURT_FLASH_MS - age)) / HURT_FLASH_MS
    if a <= 0 { return }
    let col: u32 = ((a as u32) << 24 as u32) | HURT_RGB
    let t: i32 = (*r).h / 10
    mc_hud.hud_rect(r, 0, 0, (*r).w, t, col)
    mc_hud.hud_rect(r, 0, (*r).h - t, (*r).w, t, col)
    mc_hud.hud_rect(r, 0, t, t, (*r).h - 2 * t, col)
    mc_hud.hud_rect(r, (*r).w - t, t, t, (*r).h - 2 * t, col)
}

fn combat_ui_draw(fx: *mut mc_combat_fx.CombatFx, r: *mut mc_raster.Raster, scale: i32, now: u64) {
    let pm: i32 = mc_combat_fx.cfx_strength_permille(fx, now)
    if pm < 1000 { draw_bar(r, scale, pm) }
    let use_pm: i32 = mc_combat_fx.cfx_use_progress(fx, now)
    if use_pm >= 0 { draw_use_bar(r, scale, use_pm) }
    let hit: i64 = mc_combat_fx.cfx_hit_age(fx, now)
    if hit >= 0 && hit < HIT_MARK_MS { draw_hit_mark(r, scale) }
    let hurt: i64 = mc_combat_fx.cfx_hurt_age(fx, now)
    if hurt >= 0 && hurt < HURT_FLASH_MS { draw_hurt_flash(r, hurt) }
}
