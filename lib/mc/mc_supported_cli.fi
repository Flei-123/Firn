// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_supported_cli.fi -- "--list-versions": prints the joinable versions manifest as JSON on stdout.

import std.rt
import std.io
import mc.mc_supported

export { list_requested, list_print }

const FLAG: str = "--list-versions"

fn list_requested(start: u64, argc: usize) -> bool {
    if argc < 2 { return false }
    let a: u64 = rt.arg_ptr(start, 1)
    return rt.c_length(a) == FLAG.n && rt.mem_eq(a, FLAG.p as u64, FLAG.n)
}

fn list_print() {
    io.print_line(mc_supported.JOINABLE_JSON)
}
