// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_version.fi -- the VERSION OBJECT (GDD 8.6: version = data).
//
// Everything that differs between Minecraft Java releases is described by one
// `Version` value and looked up at run time. The engine libraries (framing,
// compression, encryption, NBT, math, mesh, noise, net, the schema walker) never
// name a protocol number or a packet id; they receive a Version, or they work on
// the version-neutral world model (mc_chunk.Chunk / mc_world.World).
//
// What a Version carries
//
//   protocol / name   the protocol number and the release name ("1.20.1")
//   flags             FLAG_* feature switches the state machine and the codecs read
//   chunk_format      CF_*: which chunk decoding strategy (mc_chunk.chunk_decode)
//   sem[]             wire id of every SEMANTIC packet (mc_sem.fi), -1 = not in this version
//   id_limit/name_of/schema_of
//                     function values over the generated tables of the version
//                     (lib/mc/vNNN/mc_proto_vNNN.fi): iteration, names, schema programs
//   registry_of       function value returning the version's Registry (mc_registry.fi,
//                     generated lib/mc/vNNN/mc_reg_vNNN.fi): blocks, states, items, ...
//
// A Version is produced by the generated module of the version
// (`mc_proto_v763.version_make()`), or by `mc_versions.version_by_protocol`. The
// hand written facts (flags, chunk format) live in tools/mcgen/versions.json, the
// rest is generated from minecraft-data. Adding a version: docs/MC-VERSIONS.md.

import mc.mc_registry

export {
    Version, version_empty, version_has, version_pid,
    ST_HANDSHAKE, ST_STATUS, ST_LOGIN, ST_PLAY, ST_CONFIG,
    DIR_C2S, DIR_S2C,
    FLAG_COMPRESSION, FLAG_PALETTE_CHUNKS, FLAG_FLATTENING, FLAG_HEIGHTMAPS,
    FLAG_SIGNED_CHAT, FLAG_LOGIN_UUID_OPTIONAL, FLAG_LOGIN_UUID_REQUIRED,
    FLAG_BIOME_CONTAINERS, FLAG_CONFIG_PHASE, FLAG_NBT_ANON, FLAG_CHUNK_BATCHES, FLAG_HM_MAP, FLAG_SEC_FLUID, FLAG_TRUST_EDGES,
    CF_NONE, CF_LEGACY_8, CF_SECTIONS_19, CF_SECTIONS_114, CF_CONTAINERS_118,
}

// connection states (the index into the generated per-state tables)
const ST_HANDSHAKE: i32 = 0
const ST_STATUS: i32 = 1
const ST_LOGIN: i32 = 2
const ST_PLAY: i32 = 3
const ST_CONFIG: i32 = 4 // 1.20.2+ only

const DIR_C2S: i32 = 0 // "toServer" in minecraft-data
const DIR_S2C: i32 = 1 // "toClient"

// ---- feature flags ----------------------------------------------------------
const FLAG_COMPRESSION: u64 = 1 // Set Compression exists (since 1.8)
const FLAG_PALETTE_CHUNKS: u64 = 2 // chunk sections are paletted (1.9+)
const FLAG_FLATTENING: u64 = 4 // block states are flattened ids (1.13+), not id<<4|meta
const FLAG_HEIGHTMAPS: u64 = 8 // heightmaps as NBT in the chunk packet (1.14+)
const FLAG_SIGNED_CHAT: u64 = 16 // chat signatures, session keys (1.19+)
const FLAG_LOGIN_UUID_OPTIONAL: u64 = 32 // Login Start has an optional UUID (1.19 - 1.20.1)
const FLAG_LOGIN_UUID_REQUIRED: u64 = 64 // Login Start has a mandatory UUID (1.20.2+)
const FLAG_BIOME_CONTAINERS: u64 = 128 // biomes are paletted containers inside the sections (1.18+)
const FLAG_CONFIG_PHASE: u64 = 256 // Login -> Configuration -> Play (1.20.2+)
const FLAG_NBT_ANON: u64 = 512 // network NBT root has no name (1.20.2+)
const FLAG_CHUNK_BATCHES: u64 = 1024 // chunk batch start/finished + received (1.20.2+)
const FLAG_HM_MAP: u64 = 2048 // 1.21.5+ chunk shape: heightmaps are a varint keyed map (type enum + longs), not NBT, and paletted containers have no data array length
const FLAG_TRUST_EDGES: u64 = 8192 // 1.18 - 1.19.4: a trustEdges bool sits before the four light masks (map_chunk and update_light); removed in 1.20
const FLAG_SEC_FLUID: u64 = 4096 // 26.1 chunk sections: a second i16 (non-empty fluid count) follows the block count

// ---- chunk decoding strategies (mc_chunk.chunk_decode dispatches on these) ----
const CF_NONE: i32 = 0
const CF_LEGACY_8: i32 = 1 // 1.8: unpaletted short arrays per section
const CF_SECTIONS_19: i32 = 2 // 1.9 - 1.13: paletted blocks, light inline per section, biome array
const CF_SECTIONS_114: i32 = 3 // 1.14 - 1.17: section bitmask, heightmaps, light in its own packet
const CF_CONTAINERS_118: i32 = 4 // 1.18+: blocks AND biomes as paletted containers, no bitmask

struct Version {
    protocol: i32,
    flags: u64,
    chunk_format: i32,
    name: u64, // pointer to the release name (not NUL terminated)
    name_len: usize,
    sem: [i32; 128], // wire id per semantic packet, indexed by mc_sem.SEM_*
    id_limit: fn(i32, i32) -> i32, // (state, dir) -> highest id + 1
    name_of: fn(i32, i32, i32) -> u64, // (state, dir, id) -> NUL terminated name or 0
    schema_of: fn(i32, i32, i32) -> u64, // (state, dir, id) -> schema handle or 0
    registry_of: fn() -> mc_registry.Registry, // the blocks / items / entities / biomes tables
}

fn no_limit(state: i32, dir: i32) -> i32 { return 0 }
fn no_name(state: i32, dir: i32, id: i32) -> u64 { return 0 }
fn no_registry() -> mc_registry.Registry { return mc_registry.registry_open(0) }

fn version_empty() -> Version {
    return Version { protocol: 0, flags: 0 as u64, chunk_format: CF_NONE, name: 0,
        name_len: 0, sem: [0 - 1; 128], id_limit: no_limit, name_of: no_name,
        schema_of: no_name, registry_of: no_registry }
}

fn version_has(v: *mut Version, flag: u64) -> bool {
    return ((*v).flags & flag) != 0 as u64
}

// wire id of the semantic packet `sem` (mc_sem.SEM_*), -1 when this version has none
fn version_pid(v: *mut Version, sem: usize) -> i32 {
    return (*v).sem[sem]
}
