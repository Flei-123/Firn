// SPDX-License-Identifier: MPL-2.0
// lib/mc/mc_blockset.fi -- write ONE block into a decoded world (the decoder keeps containers read-only otherwise).
//
//     mc_blockset.world_set_block(&world, min_y, x, y, z, id)   // -> old id, -1 chunk not loaded, -2 outside the stored height
//
// A container is rebuilt from its 4096 resolved ids: palette in first-seen order, `bits` = smallest b >= 1 with 2^b >= palette
// size (0 = one value, no data), dense bit stream across u64 words (same layout mc_chunk.container_get reads). Cost ~ 4096 steps
// + 64 KiB scratch per call: meant for single block edits (break / place / block change packets), not for bulk loads.
// The caller marks the renderer (mc_render_world.wr_mark_block) afterwards.
import std.rt
import mc.mc_chunk
import mc.mc_world

export { container_set, world_set_block, world_get_block }

const N: usize = 4096
const NONE16: u16 = 65535

fn bits_for(n: u32) -> u32 {
    var b: u32 = 1 as u32
    while (1 as u32 << b) < n {
        b = b + 1 as u32
    }
    return b
}

fn drop_arrays(c: *mut mc_chunk.Container) {
    if (*c).pal != 0 {
        rt.heap_free((*c).pal, ((*c).pal_n as usize) * 2)
    }
    if (*c).data != 0 {
        rt.heap_free((*c).data, (*c).words * 8)
    }
    (*c).pal = 0
    (*c).data = 0
    (*c).pal_n = 0 as u32
    (*c).words = 0
    (*c).bits = 0 as u32
}

// Sets entry `i` (0..4095, index (y*16+z)*16+x) of a block container to the global id `id`. false = out of memory / bad index.
fn container_set(c: *mut mc_chunk.Container, i: usize, id: u16) -> bool {
    if i >= N {
        return false
    }
    let ids: u64 = rt.heap_alloc(N * 2)
    let map: u64 = rt.heap_alloc(32768 * 2)
    let pal: u64 = rt.heap_alloc(N * 2)
    let idx: u64 = rt.heap_alloc(N * 2)
    if ids == 0 || map == 0 || pal == 0 || idx == 0 {
        if ids != 0 { rt.heap_free(ids, N * 2) }
        if map != 0 { rt.heap_free(map, 32768 * 2) }
        if pal != 0 { rt.heap_free(pal, N * 2) }
        if idx != 0 { rt.heap_free(idx, N * 2) }
        return false
    }
    var k: usize = 0
    while k < N {
        rt.st16(ids, k, mc_chunk.container_get(c, k))
        k = k + 1
    }
    rt.st16(ids, i, id)
    k = 0
    while k < 32768 {
        rt.st16(map, k, NONE16)
        k = k + 1
    }
    var pn: usize = 0
    k = 0
    while k < N {
        let g: u16 = rt.ld16(ids, k)
        var p: u16 = rt.ld16(map, (g & 32767 as u16) as usize)
        if p == NONE16 {
            p = pn as u16
            rt.st16(map, (g & 32767 as u16) as usize, p)
            rt.st16(pal, pn, g)
            pn = pn + 1
        }
        rt.st16(idx, k, p)
        k = k + 1
    }
    drop_arrays(c)
    let np: u64 = rt.heap_alloc(pn * 2)
    if np == 0 {
        rt.heap_free(ids, N * 2)
        rt.heap_free(map, 32768 * 2)
        rt.heap_free(pal, N * 2)
        rt.heap_free(idx, N * 2)
        return false
    }
    k = 0
    while k < pn {
        rt.st16(np, k, rt.ld16(pal, k))
        k = k + 1
    }
    (*c).pal = np
    (*c).pal_n = pn as u32
    if pn == 1 {
        (*c).bits = 0 as u32
    } else {
        let b: u32 = bits_for(pn as u32)
        let words: usize = (N * (b as usize) + 63) / 64
        let data: u64 = rt.heap_alloc(words * 8)
        if data != 0 {
            k = 0
            while k < words {
                rt.st64(data, k, 0 as u64)
                k = k + 1
            }
            k = 0
            while k < N {
                let v: u64 = rt.ld16(idx, k) as u64
                let bit: usize = k * (b as usize)
                let w: usize = bit / 64
                let off: u32 = (bit % 64) as u32
                rt.st64(data, w, rt.ld64(data, w) | (v << off))
                if (off as usize) + (b as usize) > 64 {
                    rt.st64(data, w + 1, rt.ld64(data, w + 1) | (v >> (64 as u32 - off)))
                }
                k = k + 1
            }
            (*c).data = data
            (*c).words = words
            (*c).bits = b
        }
    }
    rt.heap_free(ids, N * 2)
    rt.heap_free(map, 32768 * 2)
    rt.heap_free(pal, N * 2)
    rt.heap_free(idx, N * 2)
    return (*c).bits != 0 as u32 || pn == 1
}

fn locate(w: *mut mc_world.World, min_y: i32, x: i32, y: i32, z: i32, sec: *mut *mut mc_chunk.Section, idx: *mut usize) -> i32 {
    let chunk: u64 = mc_world.world_find(w, mc_world.floor_div(x, 16), mc_world.floor_div(z, 16))
    if chunk == 0 {
        return 0 - 1
    }
    let c: *mut mc_chunk.Chunk = chunk as *mut mc_chunk.Chunk
    let ly: i32 = y - min_y
    let sy: i32 = mc_world.floor_div(ly, 16)
    if sy < 0 || (sy as usize) >= (*c).nsec {
        return 0 - 2
    }
    *sec = mc_chunk.chunk_section(c, sy as usize)
    *idx = ((mc_world.floor_mod(ly, 16) * 16 + mc_world.floor_mod(z, 16)) * 16 + mc_world.floor_mod(x, 16)) as usize
    return 0
}

// The block id at (x, y, z): -1 chunk not loaded, -2 outside the stored height.
fn world_get_block(w: *mut mc_world.World, min_y: i32, x: i32, y: i32, z: i32) -> i32 {
    var sec: *mut mc_chunk.Section = 0 as *mut mc_chunk.Section
    var idx: usize = 0
    let r: i32 = locate(w, min_y, x, y, z, &sec, &idx)
    if r != 0 {
        return r
    }
    return mc_chunk.container_get(&(*sec).blocks, idx) as i32
}

// Writes block `id` at (x, y, z). Returns the OLD id (>= 0), -1 chunk not loaded, -2 outside the stored height, -3 out of memory.
fn world_set_block(w: *mut mc_world.World, min_y: i32, x: i32, y: i32, z: i32, id: i32) -> i32 {
    var sec: *mut mc_chunk.Section = 0 as *mut mc_chunk.Section
    var idx: usize = 0
    let r: i32 = locate(w, min_y, x, y, z, &sec, &idx)
    if r != 0 {
        return r
    }
    let old: i32 = mc_chunk.container_get(&(*sec).blocks, idx) as i32
    if old == id {
        return old
    }
    if !container_set(&(*sec).blocks, idx, id as u16) {
        return 0 - 3
    }
    if old == 0 && id != 0 {
        (*sec).count = (*sec).count + 1
    }
    if old != 0 && id == 0 && (*sec).count > 0 {
        (*sec).count = (*sec).count - 1
    }
    return old
}
