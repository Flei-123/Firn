// lib/mc/mc_sky.fi -- deterministic sky: time of day -> sky / fog / light colours, sun and moon discs, background pass.
//
// Everything is a pure function of (ticks, rain): no libm (sine = a rational approximation built from + - * /),
// colours are integer lerps (a*(256-t) + b*t) >> 8, so the image is the same bit for bit on every build stage
// and tools/mc/sky/ref.py reproduces it exactly.
//
// TIME: ticks 0..23999 like the game (0 = sunrise, 6000 = noon, 12000 = sunset, 18000 = midnight); any i64 is wrapped.
// sky_set_time computes the Sky: sun direction (the moon is exactly opposite), daylight 0..256, sunset glow 0..256,
// zenith / horizon / fog colour and the light tint (multipliers 0..256 per channel for the world pixels).
// DRAW ORDER: raster_clear -> sky_draw (gradient + glow + discs into the colour buffer, depth untouched)
// -> world (the fog colour = sky_set_raster_fog) -> optional sky_tint_frame (tints pixels with depth > 0).

import std.rt
import std.math
import mc.mc_camera
import mc.mc_raster

export {
    Sky, sky_new, sky_set_time, sky_draw, sky_draw_plain, sky_set_raster_fog, sky_tint_frame, sky_sin_deg, sky_cos_deg,
}

const SUN_COS: f64 = 0.9976 // disc radius about 4 degrees
const MOON_COS: f64 = 0.9984 // about 3.2 degrees

struct Sky {
    time: i64, // wrapped to 0..23999
    rain: i32, // 0..256
    daylight: i32, // 0 (night) .. 256 (day)
    glow: i32, // sunset / sunrise strength 0..256
    discs: bool, // sun and moon are drawn (false in heavy rain)
    sunx: f64, suny: f64, sunz: f64, // unit-ish direction to the sun (world: +x east, +y up, +z south)
    zr: i32, zg: i32, zb: i32, // zenith
    hr: i32, hg: i32, hb: i32, // horizon
    fr: i32, fg: i32, fb: i32, // fog colour (= horizon)
    lr: i32, lg: i32, lb: i32, // sunset glow colour
    tr: i32, tg: i32, tb: i32, // light tint multipliers 0..256
}

fn sky_new() -> Sky {
    var s: Sky = Sky {
        time: 0, rain: 0, daylight: 0, glow: 0, discs: true,
        sunx: 1.0, suny: 0.0, sunz: 0.0,
        zr: 0, zg: 0, zb: 0, hr: 0, hg: 0, hb: 0, fr: 0, fg: 0, fb: 0, lr: 255, lg: 120, lb: 60,
        tr: 256, tg: 256, tb: 256,
    }
    sky_set_time(&s, 6000 as i64, 0)
    return s
}

// sine of an angle in degrees, x in [0, 360): Bhaskara's rational approximation (max error 0.0016)
fn sky_sin_deg(x: f64) -> f64 {
    var a: f64 = x
    var sign: f64 = 1.0
    if a > 180.0 {
        a = a - 180.0
        sign = -1.0
    }
    let p: f64 = a * (180.0 - a)
    return sign * ((4.0 * p) / (40500.0 - p))
}

fn sky_cos_deg(x: f64) -> f64 {
    var c: f64 = x + 90.0
    if c >= 360.0 { c = c - 360.0 }
    return sky_sin_deg(c)
}

fn lerp(a: i64, b: i64, t: i64) -> i64 {
    return (a * (256 as i64 - t) + b * t) >> 8 as i64
}

fn clamp01(x: f64) -> f64 {
    if x < 0.0 { return 0.0 }
    if x > 1.0 { return 1.0 }
    return x
}

fn sky_set_time(s: *mut Sky, ticks: i64, rain: i32) {
    var t: i64 = ticks % (24000 as i64)
    if t < 0 as i64 { t = t + 24000 as i64 }
    var rn: i64 = rain as i64
    if rn < 0 as i64 { rn = 0 }
    if rn > 256 as i64 { rn = 256 }
    (*s).time = t
    (*s).rain = rn as i32
    (*s).discs = rn < 128 as i64
    let ang: f64 = ((t as f64) * 360.0) / 24000.0
    let sn: f64 = sky_sin_deg(ang)
    let cs: f64 = sky_cos_deg(ang)
    (*s).sunx = cs
    (*s).suny = sn * 0.9
    (*s).sunz = sn * 0.4358898943540674
    let sy: f64 = (*s).suny
    let d: f64 = clamp01((sy + 0.1) / 0.3)
    let dl: i64 = math.floor(d * 256.0) as i64
    (*s).daylight = dl as i32
    var a: f64 = 1.0 - math.fabs(sy) / 0.35
    if a < 0.0 { a = 0.0 }
    var gl: i64 = math.floor((256.0 * a) * a) as i64
    gl = gl * (256 as i64 - rn) / 256 as i64
    (*s).glow = gl as i32
    // day / night colours, rain pulls both towards a grey that follows the daylight
    let gy: i64 = lerp(14 as i64, 150 as i64, dl)
    let gz: i64 = (gy * 3 as i64) / 4 as i64
    var zr: i64 = lerp(3 as i64, 82 as i64, dl)
    var zg: i64 = lerp(4 as i64, 131 as i64, dl)
    var zb: i64 = lerp(14 as i64, 235 as i64, dl)
    var hr: i64 = lerp(10 as i64, 190 as i64, dl)
    var hg: i64 = lerp(12 as i64, 214 as i64, dl)
    var hb: i64 = lerp(30 as i64, 255 as i64, dl)
    zr = lerp(zr, gz, rn)
    zg = lerp(zg, gz + 1 as i64, rn)
    zb = lerp(zb, gz + 4 as i64, rn)
    hr = lerp(hr, gy, rn)
    hg = lerp(hg, gy + 2 as i64, rn)
    hb = lerp(hb, gy + 6 as i64, rn)
    (*s).zr = zr as i32
    (*s).zg = zg as i32
    (*s).zb = zb as i32
    (*s).hr = hr as i32
    (*s).hg = hg as i32
    (*s).hb = hb as i32
    (*s).fr = hr as i32
    (*s).fg = hg as i32
    (*s).fb = hb as i32
    // light tint: night is dark blue, sunset is warm, rain is a bit grey
    var tr: i64 = lerp(96 as i64, 256 as i64, dl)
    var tg: i64 = lerp(110 as i64, 256 as i64, dl)
    var tb: i64 = lerp(190 as i64, 256 as i64, dl)
    let wg: i64 = gl / 2 as i64
    tr = lerp(tr, 256 as i64, wg)
    tg = lerp(tg, 224 as i64, wg)
    tb = lerp(tb, 184 as i64, wg)
    let rh: i64 = rn / 2 as i64
    tr = lerp(tr, 216 as i64, rh)
    tg = lerp(tg, 220 as i64, rh)
    tb = lerp(tb, 232 as i64, rh)
    (*s).tr = tr as i32
    (*s).tg = tg as i32
    (*s).tb = tb as i32
}

fn pack(r: i64, g: i64, b: i64) -> u32 {
    return (r as u32) | ((g as u32) << 8 as u32) | ((b as u32) << 16 as u32) | 0xFF000000 as u32
}

// Plain model of the background pass (one normalisation per pixel, no shortcuts). This is the definition of the image;
// `sky_draw` must produce exactly the same pixels (tests/2754_mc_sky.fi compares both on random scenes).
fn sky_draw_plain(s: *mut Sky, r: *mut mc_raster.Raster) {
    let w: i32 = (*r).w
    let h: i32 = (*r).h
    let glowf: f64 = (*s).glow as f64
    let zr: i64 = (*s).zr as i64
    let zg: i64 = (*s).zg as i64
    let zb: i64 = (*s).zb as i64
    let hr: i64 = (*s).hr as i64
    let hg: i64 = (*s).hg as i64
    let hb: i64 = (*s).hb as i64
    let lr: i64 = (*s).lr as i64
    let lg: i64 = (*s).lg as i64
    let lb: i64 = (*s).lb as i64
    var y: i32 = 0
    while y < h {
        let ey: f64 = ((*r).hh - ((y as f64) + 0.5)) / (*r).fpy
        var x: i32 = 0
        while x < w {
            let ex: f64 = (((x as f64) + 0.5) - (*r).hw) / (*r).fpx
            let dx: f64 = ((*r).fx + ex * (*r).rx) + ey * (*r).ux
            let dy: f64 = ((*r).fy + ex * (*r).ry) + ey * (*r).uy
            let dz: f64 = ((*r).fz + ex * (*r).rz) + ey * (*r).uz
            let len: f64 = math.sqrt((dx * dx + dy * dy) + dz * dz)
            let nx: f64 = dx / len
            let ny: f64 = dy / len
            let nz: f64 = dz / len
            let g: f64 = clamp01(ny * 1.6)
            let gg: f64 = 1.0 - (1.0 - g) * (1.0 - g)
            let f: i64 = math.floor(gg * 256.0) as i64
            var cr: i64 = lerp(hr, zr, f)
            var cg: i64 = lerp(hg, zg, f)
            var cb: i64 = lerp(hb, zb, f)
            let dsun: f64 = (nx * (*s).sunx + ny * (*s).suny) + nz * (*s).sunz
            if dsun > 0.0 && glowf > 0.0 {
                let d3: f64 = (dsun * dsun) * dsun
                let wgt: f64 = d3 * (1.0 - gg)
                let fg: i64 = math.floor(wgt * glowf) as i64
                cr = lerp(cr, lr, fg)
                cg = lerp(cg, lg, fg)
                cb = lerp(cb, lb, fg)
            }
            if (*s).discs {
                if dsun >= SUN_COS {
                    cr = 255
                    cg = 248
                    cb = 200
                } else if (0.0 - dsun) >= MOON_COS {
                    cr = 226
                    cg = 228
                    cb = 240
                }
            }
            rt.st32((*r).color, (y as usize) * (w as usize) + (x as usize), pack(cr, cg, cb))
            x = x + 1
        }
        y = y + 1
    }
}

// Per row state of the gradient search: the column part of the ray (3 tables of w f64: fx + ex*rx, fy + ex*ry,
// fz + ex*rz, same expressions as the plain model), the row part (ey * u) and the output f per column.
struct RowCtx {
    cols: u64, // 3 * w f64
    fcol: u64, // w u32: f = floor(256 gg) per column
    wn: usize,
    eyx: f64, eyy: f64, eyz: f64,
}

// gradient index f of column x, exactly the plain model (dx, dy, dz, len, ny, g, gg)
fn sky_f_at(c: *mut RowCtx, x: usize) -> u32 {
    let o: u64 = (x as u64) << (3 as u64)
    let ws: u64 = ((*c).wn as u64) << (3 as u64)
    let dx: f64 = *((((*c).cols) + o) as *mut f64) + (*c).eyx
    let dy: f64 = *((((*c).cols) + ws + o) as *mut f64) + (*c).eyy
    let dz: f64 = *((((*c).cols) + ws + ws + o) as *mut f64) + (*c).eyz
    let len: f64 = math.sqrt((dx * dx + dy * dy) + dz * dz)
    let ny: f64 = dy / len
    var g: f64 = ny * 1.6
    if g < 0.0 { g = 0.0 }
    if g > 1.0 { g = 1.0 }
    let gg: f64 = 1.0 - (1.0 - g) * (1.0 - g)
    return (gg * 256.0) as u32 // gg >= 0: truncation == floor
}

// Fills fcol[a..b] (both ends already set) for a segment on which ny is monotone: if both ends agree the whole
// segment has that value, otherwise bisect.
fn sky_fill(c: *mut RowCtx, a: usize, b: usize) {
    let fa: u32 = rt.ld32((*c).fcol, a)
    let fb: u32 = rt.ld32((*c).fcol, b)
    if b - a <= 1 { return }
    if fa == fb {
        var pp: u64 = (*c).fcol + (((a + 1) as u64) << (2 as u64))
        let pe: u64 = (*c).fcol + ((b as u64) << (2 as u64))
        while pp < pe {
            *(pp as *mut u32) = fa
            pp = pp + (4 as u64)
        }
        return
    }
    let m: usize = (a + b) / 2
    rt.st32((*c).fcol, m, sky_f_at(c, m))
    sky_fill(c, a, m)
    sky_fill(c, m, b)
}

// one pixel of the plain model from the (unnormalised) ray d
fn sky_pixel_plain(s: *mut Sky, dx: f64, dy: f64, dz: f64) -> u32 {
    let len: f64 = math.sqrt((dx * dx + dy * dy) + dz * dz)
    let nx: f64 = dx / len
    let ny: f64 = dy / len
    let nz: f64 = dz / len
    let g: f64 = clamp01(ny * 1.6)
    let gg: f64 = 1.0 - (1.0 - g) * (1.0 - g)
    let f: i64 = math.floor(gg * 256.0) as i64
    var cr: i64 = lerp((*s).hr as i64, (*s).zr as i64, f)
    var cg: i64 = lerp((*s).hg as i64, (*s).zg as i64, f)
    var cb: i64 = lerp((*s).hb as i64, (*s).zb as i64, f)
    let dsun: f64 = (nx * (*s).sunx + ny * (*s).suny) + nz * (*s).sunz
    if dsun > 0.0 && (*s).glow > 0 {
        let d3: f64 = (dsun * dsun) * dsun
        let wgt: f64 = d3 * (1.0 - gg)
        let fg: i64 = math.floor(wgt * ((*s).glow as f64)) as i64
        cr = lerp(cr, (*s).lr as i64, fg)
        cg = lerp(cg, (*s).lg as i64, fg)
        cb = lerp(cb, (*s).lb as i64, fg)
    }
    if (*s).discs {
        if dsun >= SUN_COS {
            cr = 255
            cg = 248
            cb = 200
        } else if (0.0 - dsun) >= MOON_COS {
            cr = 226
            cg = 228
            cb = 240
        }
    }
    return pack(cr, cg, cb)
}

// Glow pixel for a pixel the conservative test lets through (px = gradient colour, ss = |d|^2, du = d.sun):
// dsun and ny from one sqrt + one division; near an integer boundary of floor(d3 (1-gg) glow) the plain formulas decide.
fn sky_glow_pixel(s: *mut Sky, px: u32, dx: f64, dy: f64, dz: f64, ss: f64, du: f64, glowf: f64) -> u32 {
    let il: f64 = 1.0 / math.sqrt(ss)
    let dsun: f64 = du * il
    var g: f64 = (dy * il) * 1.6
    if g < 0.0 { g = 0.0 }
    if g > 1.0 { g = 1.0 }
    let gg: f64 = 1.0 - (1.0 - g) * (1.0 - g)
    let v: f64 = ((dsun * dsun) * dsun) * (1.0 - gg) * glowf
    let fg: i64 = v as i64
    let fr: f64 = v - (fg as f64)
    if dsun < 1.0e-7 || fr < 1.0e-7 || fr > 0.9999999 { return sky_pixel_plain(s, dx, dy, dz) }
    let k: i64 = 256 as i64 - fg
    let cr: i64 = (((px & 255 as u32) as i64) * k + (*s).lr as i64 * fg) >> 8 as i64
    let cg: i64 = ((((px >> 8 as u32) & 255 as u32) as i64) * k + (*s).lg as i64 * fg) >> 8 as i64
    let cb: i64 = ((((px >> 16 as u32) & 255 as u32) as i64) * k + (*s).lb as i64 * fg) >> 8 as i64
    return (cr as u32) | ((cg as u32) << 8 as u32) | ((cb as u32) << 16 as u32) | 0xFF000000 as u32
}

// One lit row: gradient colour from the table, glow where the conservative test passes (see sky_draw).
// Pointer walking instead of indexed helper calls: this loop is the hot spot of the sunset frame.
// d . sun is linear in the column: columns whose value is below -1e-3 cannot glow (they need d . sun > 0), they are
// plain table copies; only the (conservatively widened) range [lo, hi) gets the per pixel test.
fn sky_glow_row(s: *mut Sky, cols: u64, wn: usize, eyx: f64, eyy: f64, eyz: f64, fcol: u64, tab: u64, gsq: u64, out: u64) {
    let glowf: f64 = (*s).glow as f64
    let sunx: f64 = (*s).sunx
    let suny: f64 = (*s).suny
    let sunz: f64 = (*s).sunz
    let lr: i64 = (*s).lr as i64
    let lg: i64 = (*s).lg as i64
    let lb: i64 = (*s).lb as i64
    let step: u64 = 8 as u64
    let wb: u64 = (wn as u64) << (3 as u64)
    // du at the first and the last column (same expression as in the loop)
    let last: u64 = wb - step
    let d0: f64 = ((*(cols as *mut f64) + eyx) * sunx + (*((cols + wb) as *mut f64) + eyy) * suny) + (*((cols + wb + wb) as *mut f64) + eyz) * sunz
    let d1: f64 = ((*((cols + last) as *mut f64) + eyx) * sunx + (*((cols + wb + last) as *mut f64) + eyy) * suny) + (*((cols + wb + wb + last) as *mut f64) + eyz) * sunz
    var lo: usize = 0
    var hi: usize = wn
    let thr: f64 = -0.001
    if d0 < thr && d1 < thr {
        hi = 0
    } else if d0 < thr || d1 < thr {
        let xs: f64 = (thr - d0) / (d1 - d0) * ((wn as f64) - 1.0)
        if d0 < thr {
            var l: f64 = xs - 3.0
            if l < 0.0 { l = 0.0 }
            if l > (wn as f64) { l = wn as f64 }
            lo = l as usize
        } else {
            var h: f64 = xs + 4.0
            if h < 0.0 { h = 0.0 }
            if h > (wn as f64) { h = wn as f64 }
            hi = h as usize
        }
    }
    if hi < lo { hi = lo }
    var pdx: u64 = cols + ((lo as u64) << (3 as u64))
    var pdy: u64 = pdx + wb
    var pdz: u64 = pdy + wb
    var pf: u64 = fcol
    var po: u64 = out
    let pa: u64 = fcol + ((lo as u64) << (2 as u64))
    let pb: u64 = fcol + ((hi as u64) << (2 as u64))
    let pend: u64 = fcol + ((wn as u64) << (2 as u64))
    while pf < pa {
        *(po as *mut u32) = *((tab + ((*(pf as *mut u32)) as u64) * (4 as u64)) as *mut u32)
        pf = pf + (4 as u64)
        po = po + (4 as u64)
    }
    while pf < pb {
        let f: u64 = (*(pf as *mut u32)) as u64
        var px: u32 = *((tab + f * (4 as u64)) as *mut u32)
        let dx: f64 = *(pdx as *mut f64) + eyx
        let dy: f64 = *(pdy as *mut f64) + eyy
        let dz: f64 = *(pdz as *mut f64) + eyz
        let ss: f64 = (dx * dx + dy * dy) + dz * dz
        let du: f64 = (dx * sunx + dy * suny) + dz * sunz
        if du > 0.0 && du * du > *((gsq + f * step) as *mut f64) * ss {
            let il: f64 = 1.0 / math.sqrt(ss)
            let dsun: f64 = du * il
            var g: f64 = (dy * il) * 1.6
            if g < 0.0 { g = 0.0 }
            if g > 1.0 { g = 1.0 }
            let om: f64 = 1.0 - g
            let v: f64 = ((dsun * dsun) * dsun) * (om * om) * glowf
            let fg: i64 = v as i64
            let fr: f64 = v - (fg as f64)
            if dsun < 1.0e-7 || fr < 1.0e-7 || fr > 0.9999999 {
                px = sky_pixel_plain(s, dx, dy, dz)
            } else {
                let kk: i64 = 256 as i64 - fg
                let cr: i64 = (((px & 255 as u32) as i64) * kk + lr * fg) >> 8 as i64
                let cg: i64 = ((((px >> 8 as u32) & 255 as u32) as i64) * kk + lg * fg) >> 8 as i64
                let cb: i64 = ((((px >> 16 as u32) & 255 as u32) as i64) * kk + lb * fg) >> 8 as i64
                px = (cr as u32) | ((cg as u32) << 8 as u32) | ((cb as u32) << 16 as u32) | 0xFF000000 as u32
            }
        }
        *(po as *mut u32) = px
        pdx = pdx + step
        pdy = pdy + step
        pdz = pdz + step
        pf = pf + (4 as u64)
        po = po + (4 as u64)
    }
    while pf < pend {
        *(po as *mut u32) = *((tab + ((*(pf as *mut u32)) as u64) * (4 as u64)) as *mut u32)
        pf = pf + (4 as u64)
        po = po + (4 as u64)
    }
}

struct Box { x0: i32, x1: i32, y0: i32, y1: i32 } // inclusive pixel ranges; empty when x1 < x0

// Conservative screen box of the disc around direction (sx, sy, sz): every pixel whose normalised ray is within 0.12 rad
// of the direction lies inside (interval arithmetic on the camera basis; the discs are 0.07 rad); the whole screen when
// the direction is too close to the image plane.
fn sky_disc_box(r: *mut mc_raster.Raster, sx: f64, sy: f64, sz: f64) -> Box {
    let full: Box = Box { x0: 0, x1: (*r).w - 1, y0: 0, y1: (*r).h - 1 }
    let sf: f64 = (sx * (*r).fx + sy * (*r).fy) + sz * (*r).fz
    let sr: f64 = (sx * (*r).rx + sy * (*r).ry) + sz * (*r).rz
    let su: f64 = (sx * (*r).ux + sy * (*r).uy) + sz * (*r).uz
    let m: f64 = 0.12
    let amin: f64 = sf - m
    let amax: f64 = sf + m
    // a pixel ray makes an angle with the view axis of at most the corner angle: cos = 1 / sqrt(1 + tx^2 + ty^2)
    let tx: f64 = (*r).hw / (*r).fpx
    let ty: f64 = (*r).hh / (*r).fpy
    let cmin: f64 = 0.9 / math.sqrt(1.0 + tx * tx + ty * ty)
    if amax < cmin * 0.5 { return Box { x0: 0, x1: -1, y0: 0, y1: -1 } }
    if amin < 0.1 { return full }
    // ex = b / a with a in [amin, amax], b in [sr - m, sr + m]
    var exmin: f64 = (sr - m) / amin
    if sr - m >= 0.0 { exmin = (sr - m) / amax }
    var exmax: f64 = (sr + m) / amax
    if sr + m >= 0.0 { exmax = (sr + m) / amin }
    var eymin: f64 = (su - m) / amin
    if su - m >= 0.0 { eymin = (su - m) / amax }
    var eymax: f64 = (su + m) / amax
    if su + m >= 0.0 { eymax = (su + m) / amin }
    // pixel x = ex * fpx + hw - 0.5, pixel y = hh - ey * fpy - 0.5
    var x0: i64 = ((exmin * (*r).fpx + (*r).hw) as i64) - 2 as i64
    var x1: i64 = ((exmax * (*r).fpx + (*r).hw) as i64) + 2 as i64
    var y0: i64 = (((*r).hh - eymax * (*r).fpy) as i64) - 2 as i64
    var y1: i64 = (((*r).hh - eymin * (*r).fpy) as i64) + 2 as i64
    if exmin * (*r).fpx + (*r).hw < -1000000.0 || exmax * (*r).fpx + (*r).hw > 1000000.0 { return full }
    if (*r).hh - eymax * (*r).fpy < -1000000.0 || (*r).hh - eymin * (*r).fpy > 1000000.0 { return full }
    if x0 < 0 as i64 { x0 = 0 }
    if y0 < 0 as i64 { y0 = 0 }
    if x1 > ((*r).w as i64) - 1 as i64 { x1 = ((*r).w as i64) - 1 as i64 }
    if y1 > ((*r).h as i64) - 1 as i64 { y1 = ((*r).h as i64) - 1 as i64 }
    return Box { x0: x0 as i32, x1: x1 as i32, y0: y0 as i32, y1: y1 as i32 }
}

// Background pass: writes every pixel of the colour buffer (the depth buffer is not touched).
// `raster_set_camera` must have been called with the camera of this frame.
// The result is bit-identical to `sky_draw_plain` (the model of docs/mc/sky.md), only evaluated lazily:
//  * gradient colour = 257 entry table indexed by f = floor(256 gg); f is computed exactly for a few columns per row and
//    bisected: along one row ny is monotone left and right of one extremum (the ray moves on a great circle arc,
//    ny = (Py + ex ry) / |P + ex R| has a closed-form extremum column), so equal ends mean equal inside,
//  * glow: only where a conservative test on the unnormalised dot product (squares, no sqrt) says floor(d3 (1-gg) glow) can
//    be >= 1; there the value comes from one sqrt + one division and is re-done with the plain formulas when it lies within
//    1e-7 of an integer or of the dsun > 0 edge (rounding error is ~1e-12),
//  * sun / moon discs: exact plain-model pixels inside a conservative screen bounding box of each disc only.
fn sky_draw(s: *mut Sky, r: *mut mc_raster.Raster) {
    let w: i32 = (*r).w
    let h: i32 = (*r).h
    let glowi: i32 = (*s).glow
    let glowf: f64 = glowi as f64
    let discs: bool = (*s).discs
    let sunx: f64 = (*s).sunx
    let suny: f64 = (*s).suny
    let sunz: f64 = (*s).sunz
    let zr: i64 = (*s).zr as i64
    let zg: i64 = (*s).zg as i64
    let zb: i64 = (*s).zb as i64
    let hr: i64 = (*s).hr as i64
    let hg: i64 = (*s).hg as i64
    let hb: i64 = (*s).hb as i64
    let lr: i64 = (*s).lr as i64
    let lg: i64 = (*s).lg as i64
    let lb: i64 = (*s).lb as i64
    let hw: f64 = (*r).hw
    let hh: f64 = (*r).hh
    let fpx: f64 = (*r).fpx
    let fpy: f64 = (*r).fpy
    let fx: f64 = (*r).fx
    let fy: f64 = (*r).fy
    let fz: f64 = (*r).fz
    let rx: f64 = (*r).rx
    let ry: f64 = (*r).ry
    let rz: f64 = (*r).rz
    let ux: f64 = (*r).ux
    let uy: f64 = (*r).uy
    let uz: f64 = (*r).uz
    let col: u64 = (*r).color
    let wn: usize = w as usize
    // gradient colours and the glow thresholds per f: glow needs floor(d3 * (1 - gg) * glow) >= 1, i.e.
    // dsun^3 >= 1 / (glow * (1 - gg)) with 1 - gg < (257 - f) / 256; gsq[f] = (lower bound of dsun)^2 (safety factor 0.9)
    var tab: [u32; 257] = [0 as u32; 257]
    var gsq: [f64; 257] = [0.0; 257]
    var k: i64 = 0
    while k <= 256 as i64 {
        tab[k as usize] = pack(lerp(hr, zr, k), lerp(hg, zg, k), lerp(hb, zb, k))
        if glowi > 0 {
            let ub: f64 = ((257 as i64 - k) as f64) / 256.0
            var t: f64 = 0.0
            while (t + 0.01) * (t + 0.01) * (t + 0.01) * (glowf * ub) < 0.9 && t < 1.2 { t = t + 0.01 }
            gsq[k as usize] = t * t
        }
        k = k + 1
    }
    let lit: bool = glowi > 0
    var rc: RowCtx = RowCtx { cols: rt.heap_alloc(wn * 3 * 8), fcol: rt.heap_alloc(wn * 4), wn: wn, eyx: 0.0, eyy: 0.0, eyz: 0.0 }
    var cx: i32 = 0
    while cx < w {
        let ex: f64 = (((cx as f64) + 0.5) - hw) / fpx
        *((rc.cols + (cx as u64) * (8 as u64)) as *mut f64) = fx + ex * rx
        *((rc.cols + ((wn as u64) + (cx as u64)) * (8 as u64)) as *mut f64) = fy + ex * ry
        *((rc.cols + ((wn as u64) * (2 as u64) + (cx as u64)) * (8 as u64)) as *mut f64) = fz + ex * rz
        cx = cx + 1
    }
    // the bisection needs one extremum per row (an arc below 180 degrees): very wide lenses evaluate every pixel
    let fast: bool = hw < 4.0 * fpx
    var sunbox: Box = Box { x0: 0, x1: -1, y0: 0, y1: -1 }
    var moonbox: Box = Box { x0: 0, x1: -1, y0: 0, y1: -1 }
    if discs {
        sunbox = sky_disc_box(r, sunx, suny, sunz)
        moonbox = sky_disc_box(r, 0.0 - sunx, 0.0 - suny, 0.0 - sunz)
    }
    var y: i32 = 0
    while y < h {
        let ey: f64 = (hh - ((y as f64) + 0.5)) / fpy
        rc.eyx = ey * ux
        rc.eyy = ey * uy
        rc.eyz = ey * uz
        // ---- gradient index per column
        if fast {
            // extremum of ny along the row: d(ex) = P + ex R, ny = (Py + ex ry) / |d|, derivative zero at
            // ex* = (Py (P.R) - ry (P.P)) / ((P.R) ry - Py (R.R))  (the ex^2 terms cancel)
            let px: f64 = fx + rc.eyx
            let py: f64 = fy + rc.eyy
            let pz: f64 = fz + rc.eyz
            let pp: f64 = (px * px + py * py) + pz * pz
            let pr: f64 = (px * rx + py * ry) + pz * rz
            let rr: f64 = (rx * rx + ry * ry) + rz * rz
            let den: f64 = pr * ry - py * rr
            var xs: f64 = -10.0 // column of the extremum (outside = none)
            if den != 0.0 {
                let exs: f64 = (py * pr - ry * pp) / den
                xs = exs * fpx + hw - 0.5
            }
            var lo: i64 = -10 as i64
            var hi: i64 = -10 as i64
            if xs > -3.0 && xs < (wn as f64) + 3.0 {
                lo = (xs as i64) - 2 as i64 // truncation: within 1 column of floor; the 5 columns lo..hi are exact
                hi = lo + 4 as i64
            }
            // segments [0, lo-1] and [hi+1, w-1] are monotone; the columns lo..hi are evaluated one by one
            var a0: i64 = 0
            var b1: i64 = (wn as i64) - 1 as i64
            var seg_lo_end: i64 = b1
            var seg_hi_start: i64 = 0
            if lo != -10 as i64 {
                seg_lo_end = lo - 1 as i64
                seg_hi_start = hi + 1 as i64
                var e: i64 = lo
                if e < 0 as i64 { e = 0 }
                while e <= hi && e <= b1 {
                    rt.st32(rc.fcol, e as usize, sky_f_at(&rc, e as usize))
                    e = e + 1
                }
            } else {
                seg_hi_start = b1 + 1 as i64 // everything is one segment [0, w-1]
            }
            if seg_lo_end > b1 { seg_lo_end = b1 }
            if seg_lo_end >= a0 {
                rt.st32(rc.fcol, a0 as usize, sky_f_at(&rc, a0 as usize))
                rt.st32(rc.fcol, seg_lo_end as usize, sky_f_at(&rc, seg_lo_end as usize))
                sky_fill(&rc, a0 as usize, seg_lo_end as usize)
            }
            if seg_hi_start < a0 { seg_hi_start = a0 }
            if seg_hi_start <= b1 && lo != -10 as i64 {
                rt.st32(rc.fcol, seg_hi_start as usize, sky_f_at(&rc, seg_hi_start as usize))
                rt.st32(rc.fcol, b1 as usize, sky_f_at(&rc, b1 as usize))
                sky_fill(&rc, seg_hi_start as usize, b1 as usize)
            }
        } else {
            var q: usize = 0
            while q < wn {
                rt.st32(rc.fcol, q, sky_f_at(&rc, q))
                q = q + 1
            }
        }
        // ---- pixels
        let base: usize = (y as usize) * wn
        var x: usize = 0
        if lit {
            sky_glow_row(s, rc.cols, wn, rc.eyx, rc.eyy, rc.eyz, rc.fcol, (&tab[0]) as u64, (&gsq[0]) as u64, col + (base as u64) * (4 as u64))
        } else {
            var pf: u64 = rc.fcol
            var po: u64 = col + (base as u64) * (4 as u64)
            let pend: u64 = rc.fcol + (wn as u64) * (4 as u64)
            let tb: u64 = (&tab[0]) as u64
            while pf < pend {
                *(po as *mut u32) = *((tb + ((*(pf as *mut u32)) as u64) * (4 as u64)) as *mut u32)
                pf = pf + (4 as u64)
                po = po + (4 as u64)
            }
        }
        // ---- discs: plain-model pixels inside the boxes
        if discs {
            var bi: i32 = 0
            while bi < 2 {
                var bx: Box = sunbox
                if bi == 1 { bx = moonbox }
                if y >= bx.y0 && y <= bx.y1 {
                    var xx: i32 = bx.x0
                    while xx <= bx.x1 {
                        let u: usize = xx as usize
                        let dx: f64 = *((rc.cols + (u as u64) * (8 as u64)) as *mut f64) + rc.eyx
                        let dy: f64 = *((rc.cols + ((wn + u) as u64) * (8 as u64)) as *mut f64) + rc.eyy
                        let dz: f64 = *((rc.cols + ((wn * 2 + u) as u64) * (8 as u64)) as *mut f64) + rc.eyz
                        rt.st32(col, base + u, sky_pixel_plain(s, dx, dy, dz))
                        xx = xx + 1
                    }
                }
                bi = bi + 1
            }
        }
        y = y + 1
    }
    rt.heap_free(rc.cols, wn * 3 * 8)
    rt.heap_free(rc.fcol, wn * 4)
}

// Sets the rasterizer fog to the sky's fog colour (linear from `start` to `end` view depth).
fn sky_set_raster_fog(s: *mut Sky, r: *mut mc_raster.Raster, start: f64, end: f64) {
    mc_raster.raster_set_fog(r, true, start, end, (*s).fr as u32, (*s).fg as u32, (*s).fb as u32)
}

// Light tint for the world: every pixel with a depth entry (geometry was drawn there) is multiplied by the tint.
fn sky_tint_frame(s: *mut Sky, r: *mut mc_raster.Raster) {
    let n: usize = ((*r).w as usize) * ((*r).h as usize)
    let tr: i64 = (*s).tr as i64
    let tg: i64 = (*s).tg as i64
    let tb: i64 = (*s).tb as i64
    var i: usize = 0
    while i < n {
        if *(((*r).depth + (i as u64) * (8 as u64)) as *mut f64) > 0.0 {
            let p: u32 = rt.ld32((*r).color, i)
            let cr: i64 = (((p & 255 as u32) as i64) * tr) / 256 as i64
            let cg: i64 = ((((p >> 8 as u32) & 255 as u32) as i64) * tg) / 256 as i64
            let cb: i64 = ((((p >> 16 as u32) & 255 as u32) as i64) * tb) / 256 as i64
            rt.st32((*r).color, i, pack(cr, cg, cb))
        }
        i = i + 1
    }
}
