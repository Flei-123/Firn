// lib/mc/mc_mesh.fi -- chunk section -> vertex / index buffers on the CPU (no GPU).
//
// INPUT is a "padded" 18x18x18 block of ids: the 16^3 section plus a one block
// shell taken from the neighbours (needed for the faces on the section border
// and for ambient occlusion). Index of padded cell (x, y, z), each 0..17:
// (y*18 + z)*18 + x; the section block (bx, by, bz) is padded (bx+1, by+1, bz+1).
// Two ways to get it:
//   mesh_section  builds it from a mc_chunk.Section and its 6 FACE neighbours
//                 (edge / corner cells of the shell are "missing")
//   mesh_padded   takes a padded array the caller assembled (e.g. from a 3x3x3
//                 neighbourhood: then even the AO on section edges is exact)
//
// Block data comes from the caller's MeshTables:
//   opaque : u8  [32768]      bit 0 = hides the faces of its neighbours; bit 1 = translucent block (water, glass, ice:
//                             drawn in a second pass, see F_TRANS). Plain tables (0 / 1 only) have no translucent block.
//   tiles  : u16 [32768 * 6]  texture tile id per face (order -x +x -y +y -z +z);
//                             0 = this block has no face there (air, or an
//                             invisible block). Tiles are 1..65535.
// The id 65535 in the padded array means "unknown" (neighbour not loaded): faces
// toward an unknown cell are NOT emitted and it does not occlude (AO).
//
// OUTPUT (in the Mesher): 8 byte vertices + u32 indices (6 per quad).
//   word0 = x | y<<8 | z<<16 | face<<24 | ao<<27     x,y,z = 0..16 (block units
//                                                      inside the section)
//   word1 = tile | u<<14 | v<<19 | sky<<24 | block<<28
//           tile  14 bit, 1..16383 (MAX_TILE; a larger id from the tables is clamped to
//                 MAX_TILE; the GL texture array holds far fewer layers anyway:
//                 GL_MAX_ARRAY_TEXTURE_LAYERS is 256 minimum, 2048 typical)
//           u, v  5 bit, 0..w / 0..h of the quad (repeat the tile with them; a greedy
//                 quad is at most 16 long, so 5 bit are enough)
//           sky, block  4 bit each, 0..15: light of THIS corner (smooth lighting, see below)
// The vertex stays 8 bytes (VBO bytes per section unchanged; a 12 byte format would
// cost +50 % VBO for nothing, see docs/mc/light.md).
// face: 0 -x, 1 +x, 2 -y, 3 +y, 4 -z, 5 +z. ao: 0..3, 3 = fully lit, 0 = darkest.
// Vertex order of a quad (u axis = (axis+1)%3, v axis = (axis+2)%3): (0,0) (1,0)
// (1,1) (0,1); front faces are counter-clockwise seen from outside. The quad is
// split along the diagonal that joins the brighter pair of corners (anisotropy flip).
//
// LIGHT (F_LIGHT): the caller gives a padded light array next to the padded blocks
// (mesh_padded_lit): u8 [5832], same index as the blocks, sky = high nibble, block = low
// nibble. The light of a face corner = average of the non-opaque cells of the 2x2 cell
// patch in FRONT of the face that touches the corner (front cell, the two side cells, the
// diagonal cell; the diagonal is skipped when both side cells are opaque; unknown cells are
// skipped), sky and block separately, rounded half up. AO stays a separate 2 bit value; the
// shader multiplies both. Without F_LIGHT every corner is sky 15, block 0 (= the old look).
//
// MODES (flags): F_GREEDY merges equal faces into rectangles. Two faces merge when
// tile and AO AND LIGHT of all four corners are equal AND the corner value is constant along
// the direction of the merge (otherwise interpolation across the merged quad would
// shade differently from the single faces). Without F_GREEDY every visible face
// is one 1x1 quad (the reference). F_AO computes AO; without it all ao = 3 and
// merging is unrestricted. F_CULL_SAME hides the faces between two identical
// non-opaque blocks (glass next to glass). F_TRANS = second pass of the transparency split: only translucent blocks are
// meshed (a face is hidden by an opaque neighbour or by a translucent neighbour with the same tile, so a water body has
// only its surface); WITHOUT F_TRANS the translucent blocks are skipped (they do not hide faces behind them either).

import std.rt
import mc.mc_chunk

export {
    MeshTables, Mesher,
    F_GREEDY, F_AO, F_CULL_SAME, F_TRANS, F_LIGHT, MISSING_AIR, MISSING_UNKNOWN, UNKNOWN_ID, MAX_QUADS,
    MAX_TILE, LIGHT_DEFAULT,
    mesher_new, mesher_free, mesh_section, mesh_padded, mesh_padded_lit, mesh_used_bytes,
    vtx_x, vtx_y, vtx_z, vtx_face, vtx_ao, vtx_tile, vtx_u, vtx_v, vtx_sky, vtx_block,
    section_pack, section_free,
}

const F_GREEDY: u32 = 1
const F_AO: u32 = 2
const F_CULL_SAME: u32 = 4
const F_TRANS: u32 = 8 // translucent pass: mesh ONLY blocks flagged translucent (opaque table bit 1), else only the others
const F_LIGHT: u32 = 16
const MAX_TILE: u32 = 16383
// Padded light byte of a cell nobody lit: full sky light, no block light.
const LIGHT_DEFAULT: u8 = 240 as u8
const MISSING_AIR: u32 = 0
const MISSING_UNKNOWN: u32 = 1
const UNKNOWN_ID: u16 = 65535
const PADN: usize = 5832
// Upper bound of quads of one section in naive mode: every block can show all 6 faces (non-opaque
// blocks next to different non-opaque blocks, or next to each other without F_CULL_SAME) = 16^3 * 6.
// (The old bound 13056 assumed one visible face per neighbour pair and overflowed the buffers
// on leaf / glass sections: segfault in perf_components, tests/2950.)
const MAX_QUADS: usize = 24576
// The `mask` heap block holds the 16x16 slice mask (u64 [256]) followed by the scratch of mesh_run:
//   cls   u8 [5832]    per padded cell: bit 0 occludes (AO), bit 1 hides the face of a neighbour (opaque or unknown), bit 2 translucent
//   hrow  u32 [324]    per padded row (y * 18 + z): bit x = cell hides faces (cls bit 1)
//   mrow  u32 [324]    per padded row: bit x = interior cell whose block can show a face in this pass
//   cmask u16 [1536]   [(face * 16 + slice) * 16 + row]: bit column = face is visible
//   tab   u32 [32]     bit position of a single set bit (de Bruijn)
const MASK_BYTES: usize = 2048
const CLS_OFS: usize = 2048
const HROW_OFS: usize = 2048 + 5832
const MROW_OFS: usize = 2048 + 5832 + 1296
const CMASK_OFS: usize = 2048 + 5832 + 1296 + 1296
const TAB_OFS: usize = 2048 + 5832 + 1296 + 1296 + 3072
const MASK_ALLOC: usize = 2048 + 5832 + 1296 + 1296 + 3072 + 128

struct MeshTables {
    opaque: u64,
    tiles: u64,
}

struct Mesher {
    pad: u64, // u16 [5832]
    mask: u64, // u64 [256] + scratch (MASK_ALLOC bytes)
    lpad: u64, // u8 [5832] padded light, sky << 4 | block
    verts: u64, // u32 [MAX_QUADS * 4 * 2]
    idx: u64, // u32 [MAX_QUADS * 6]
    nverts: u32,
    nidx: u32,
    nquads: u32,
    nfaces: u32, // visible block faces found (== sum of quad areas)
}

fn mesher_new() -> Mesher {
    var m: Mesher = Mesher { pad: 0, mask: 0, lpad: 0, verts: 0, idx: 0, nverts: 0 as u32, nidx: 0 as u32,
        nquads: 0 as u32, nfaces: 0 as u32 }
    m.pad = rt.heap_alloc(PADN * 2)
    m.mask = rt.heap_alloc(MASK_ALLOC)
    m.lpad = rt.heap_alloc(PADN)
    mesher_init_tab(m.mask)
    m.verts = rt.heap_alloc(MAX_QUADS * 4 * 8)
    m.idx = rt.heap_alloc(MAX_QUADS * 6 * 4)
    return m
}

// de Bruijn table for bit_index: slot ((lb * 0x077CB531) >> 27) holds log2(lb)
fn mesher_init_tab(mask: u64) {
    let tab: u64 = mask + TAB_OFS as u64
    var k: usize = 0
    while k < 32 {
        let lb: u64 = 1 as u64 << (k as u32)
        rt.st32(tab, (((lb * 0x077CB531 as u64) & 0xFFFFFFFF as u64) >> 27 as u64) as usize, k as u32)
        k = k + 1
    }
}

fn mesher_free(m: *mut Mesher) {
    rt.heap_free((*m).pad, PADN * 2)
    rt.heap_free((*m).mask, MASK_ALLOC)
    rt.heap_free((*m).lpad, PADN)
    rt.heap_free((*m).verts, MAX_QUADS * 4 * 8)
    rt.heap_free((*m).idx, MAX_QUADS * 6 * 4)
    (*m).pad = 0
    (*m).mask = 0
    (*m).lpad = 0
    (*m).verts = 0
    (*m).idx = 0
}

// Bytes a caller has to upload: vertices + indices of the last mesh.
fn mesh_used_bytes(m: *mut Mesher) -> usize {
    return ((*m).nverts as usize) * 8 + ((*m).nidx as usize) * 4
}

// ---- vertex accessors (word0 / word1 as stored) --------------------------------
fn vtx_x(w0: u32) -> u32 { return w0 & 255 as u32 }
fn vtx_y(w0: u32) -> u32 { return (w0 >> 8 as u32) & 255 as u32 }
fn vtx_z(w0: u32) -> u32 { return (w0 >> 16 as u32) & 255 as u32 }
fn vtx_face(w0: u32) -> u32 { return (w0 >> 24 as u32) & 7 as u32 }
fn vtx_ao(w0: u32) -> u32 { return (w0 >> 27 as u32) & 3 as u32 }
fn vtx_tile(w1: u32) -> u32 { return w1 & 16383 as u32 }
fn vtx_u(w1: u32) -> u32 { return (w1 >> 14 as u32) & 31 as u32 }
fn vtx_v(w1: u32) -> u32 { return (w1 >> 19 as u32) & 31 as u32 }
fn vtx_sky(w1: u32) -> u32 { return (w1 >> 24 as u32) & 15 as u32 }
fn vtx_block(w1: u32) -> u32 { return (w1 >> 28 as u32) & 15 as u32 }

// ---- padded array ----------------------------------------------------------------

fn pad_fill(m: *mut Mesher, v: u16) {
    var i: usize = 0
    while i < PADN {
        rt.st16((*m).pad, i, v)
        i = i + 1
    }
}

// Copies the 16^3 blocks of `c` (index (y*16+z)*16+x) into the padded array at
// the shell offset (ox, oy, oz) (0 or 17 = a one-block layer; 1 = the interior).
fn section_to_pad(m: *mut Mesher, sec: *mut mc_chunk.Section) {
    var y: usize = 0
    while y < 16 {
        var z: usize = 0
        while z < 16 {
            var x: usize = 0
            while x < 16 {
                let id: u16 = mc_chunk.container_get(&(*sec).blocks, (y * 16 + z) * 16 + x)
                rt.st16((*m).pad, ((y + 1) * 18 + (z + 1)) * 18 + (x + 1), id)
                x = x + 1
            }
            z = z + 1
        }
        y = y + 1
    }
}

// One layer of a neighbour: face f of the neighbour that touches the section.
fn layer_to_pad(m: *mut Mesher, nb: *mut mc_chunk.Section, f: usize) {
    let axis: usize = f / 2
    var nl: usize = 15 // layer of the neighbour: its far side...
    var pl: usize = 0 // ...goes to the shell layer on this side
    if f % 2 == 1 {
        nl = 0
        pl = 17
    }
    var a: usize = 0
    while a < 16 {
        var b: usize = 0
        while b < 16 {
            // (a, b) run over the two other axes in (u, v) order: u = (axis+1)%3, v = (axis+2)%3
            var c: [usize; 3] = [0, 0, 0]
            c[axis] = nl
            c[(axis + 1) % 3] = a
            c[(axis + 2) % 3] = b
            let id: u16 = mc_chunk.container_get(&(*nb).blocks, (c[1] * 16 + c[2]) * 16 + c[0])
            c[axis] = pl
            c[(axis + 1) % 3] = a + 1
            c[(axis + 2) % 3] = b + 1
            rt.st16((*m).pad, (c[1] * 18 + c[2]) * 18 + c[0], id)
            b = b + 1
        }
        a = a + 1
    }
}

// ---- block predicates -------------------------------------------------------------

fn is_opaque(t: *mut MeshTables, id: u16) -> bool {
    if id >= 32768 as u16 { return false }
    return (rt.ld8((*t).opaque, id as usize) & 1 as u8) != 0 as u8
}

fn is_trans(t: *mut MeshTables, id: u16) -> bool {
    if id >= 32768 as u16 { return false }
    return (rt.ld8((*t).opaque, id as usize) & 2 as u8) != 0 as u8
}

// Does a block occlude (AO)? Unknown cells do not.
fn occludes(t: *mut MeshTables, id: u16) -> u32 {
    if id >= 32768 as u16 { return 0 as u32 }
    if (rt.ld8((*t).opaque, id as usize) & 1 as u8) != 0 as u8 { return 1 as u32 }
    return 0 as u32
}

// ---- corner values -----------------------------------------------------------------

// Brightness estimate of a corner value (ao | sky << 2 | block << 6): the larger light level
// times the AO factor of the shaders. With constant light it orders corners exactly like AO.
fn corner_bright(cv: u32) -> u32 {
    var l: u32 = (cv >> 2 as u32) & 15 as u32
    let b: u32 = (cv >> 6 as u32) & 15 as u32
    if b > l { l = b }
    return l * (100 as u32 + 52 as u32 * (cv & 3 as u32))
}

// Light of one face corner: cells a (front), b, c (the two side cells), d (diagonal) of the
// padded array at the given indexes. See the header: opaque / unknown cells are skipped, d is
// skipped when b and c are both opaque, average rounded half up. Returns sky << 2 | block << 6
// (the AO bits are left 0).
fn corner_light(m: *mut Mesher, t: *mut MeshTables, a: usize, b: usize, c: usize, d: usize) -> u32 {
    var ss: u32 = 0 as u32
    var sb: u32 = 0 as u32
    var n: u32 = 0 as u32
    let la: u32 = rt.ld8((*m).lpad, a) as u32
    ss = ss + (la >> 4 as u32)
    sb = sb + (la & 15 as u32)
    n = n + 1 as u32
    let cls: u64 = (*m).mask + CLS_OFS as u64
    let ob: bool = (rt.ld8(cls, b) & 2 as u8) != 0 as u8
    let oc: bool = (rt.ld8(cls, c) & 2 as u8) != 0 as u8
    if !ob {
        let lb: u32 = rt.ld8((*m).lpad, b) as u32
        ss = ss + (lb >> 4 as u32)
        sb = sb + (lb & 15 as u32)
        n = n + 1 as u32
    }
    if !oc {
        let lc: u32 = rt.ld8((*m).lpad, c) as u32
        ss = ss + (lc >> 4 as u32)
        sb = sb + (lc & 15 as u32)
        n = n + 1 as u32
    }
    if !(ob && oc) {
        if (rt.ld8(cls, d) & 2 as u8) == 0 as u8 {
            let ld: u32 = rt.ld8((*m).lpad, d) as u32
            ss = ss + (ld >> 4 as u32)
            sb = sb + (ld & 15 as u32)
            n = n + 1 as u32
        }
    }
    let sky: u32 = (ss * 2 as u32 + n) / (n * 2 as u32)
    let blk: u32 = (sb * 2 as u32 + n) / (n * 2 as u32)
    return (sky << 2 as u32) | (blk << 6 as u32)
}

// ---- emit -----------------------------------------------------------------------

// One quad: face f, plane coordinate pc, rectangle (u0, v0, w, h), tile and the
// four corner values (corner order (0,0) (1,0) (1,1) (0,1)): cv = ao | sky << 2 | block << 6.
fn emit_quad(m: *mut Mesher, f: usize, pc: usize, u0: usize, v0: usize, w: usize, h: usize,
    tile: u32, c0: u32, c1: u32, c2: u32, c3: u32) {
    let axis: usize = f / 2
    // the three coordinates sit at byte 0 (x), 1 (y), 2 (z) of word0: axis, u axis = (axis+1)%3, v axis = (axis+2)%3
    var sha: u32 = 0 as u32
    var shu: u32 = 8 as u32
    var shv: u32 = 16 as u32
    if axis == 1 {
        sha = 8 as u32
        shu = 16 as u32
        shv = 0 as u32
    } else if axis == 2 {
        sha = 16 as u32
        shu = 0 as u32
        shv = 8 as u32
    }
    let base0: u32 = ((pc as u32) << sha) | ((f as u32) << 24 as u32)
    let ul: u32 = (u0 as u32) << shu
    let uh: u32 = ((u0 + w) as u32) << shu
    let vl: u32 = (v0 as u32) << shv
    let vh: u32 = ((v0 + h) as u32) << shv
    let uw: u32 = (w as u32) << 14 as u32
    let vw: u32 = (h as u32) << 19 as u32
    let vbase: u32 = (*m).nverts
    let vp: u64 = (*m).verts + (vbase as u64) * 8 as u64
    // corner 0 (0,0), 1 (1,0), 2 (1,1), 3 (0,1)
    rt.st32(vp, 0, base0 | ul | vl | ((c0 & 3 as u32) << 27 as u32))
    rt.st32(vp, 1, tile | (((c0 >> 2 as u32) & 255 as u32) << 24 as u32))
    rt.st32(vp, 2, base0 | uh | vl | ((c1 & 3 as u32) << 27 as u32))
    rt.st32(vp, 3, tile | uw | (((c1 >> 2 as u32) & 255 as u32) << 24 as u32))
    rt.st32(vp, 4, base0 | uh | vh | ((c2 & 3 as u32) << 27 as u32))
    rt.st32(vp, 5, tile | uw | vw | (((c2 >> 2 as u32) & 255 as u32) << 24 as u32))
    rt.st32(vp, 6, base0 | ul | vh | ((c3 & 3 as u32) << 27 as u32))
    rt.st32(vp, 7, tile | vw | (((c3 >> 2 as u32) & 255 as u32) << 24 as u32))
    // diagonal: join the brighter pair of corners (brightness = light level * AO factor)
    // triangles (0 1 2)(0 2 3) or flipped (1 2 3)(1 3 0); negative faces swap the 2nd and 3rd index of each triangle
    var a0: u32 = 0 as u32
    var a1: u32 = 1 as u32
    var a2: u32 = 2 as u32
    var a3: u32 = 3 as u32
    if corner_bright(c1) + corner_bright(c3) > corner_bright(c0) + corner_bright(c2) {
        a0 = 1 as u32
        a1 = 2 as u32
        a2 = 3 as u32
        a3 = 0 as u32
    }
    // indices: (a0 a1 a2)(a0 a2 a3), the flipped diagonal reuses the same pattern with rotated corners
    let ip: u64 = (*m).idx + ((*m).nidx as u64) * 4 as u64
    rt.st32(ip, 0, vbase + a0)
    if f % 2 == 0 {
        rt.st32(ip, 1, vbase + a2)
        rt.st32(ip, 2, vbase + a1)
        rt.st32(ip, 3, vbase + a0)
        rt.st32(ip, 4, vbase + a3)
        rt.st32(ip, 5, vbase + a2)
    } else {
        rt.st32(ip, 1, vbase + a1)
        rt.st32(ip, 2, vbase + a2)
        rt.st32(ip, 3, vbase + a0)
        rt.st32(ip, 4, vbase + a2)
        rt.st32(ip, 5, vbase + a3)
    }
    (*m).nverts = vbase + 4 as u32
    (*m).nidx = (*m).nidx + 6 as u32
    (*m).nquads = (*m).nquads + 1 as u32
}

// ---- the mesher -------------------------------------------------------------------

// Number of set bits of a 16 bit value.
fn popc16(v0: u32) -> u32 {
    var v: u32 = v0 - ((v0 >> 1 as u32) & 0x5555 as u32)
    v = (v & 0x3333 as u32) + ((v >> 2 as u32) & 0x3333 as u32)
    v = (v + (v >> 4 as u32)) & 0x0F0F as u32
    return (v + (v >> 8 as u32)) & 31 as u32
}

// Index (0..31) of the single set bit `lb` (de Bruijn table in the mesher scratch).
fn bit_index(tab: u64, lb: u32) -> usize {
    return rt.ld32(tab, ((((lb as u64) * 0x077CB531 as u64) & 0xFFFFFFFF as u64) >> 27 as u64) as usize) as usize
}

// padded index of the cell in front of face f of cell p
fn front_of(p: usize, f: usize) -> usize {
    if f == 0 { return p - 1 }
    if f == 1 { return p + 1 }
    if f == 2 { return p - 324 }
    if f == 3 { return p + 324 }
    if f == 4 { return p - 18 }
    return p + 18
}

// Exact visibility of face f of cell p after the row bitmask pre-selection (which only knows "not hidden by an opaque /
// unknown neighbour"): the block has a tile on this face, and neither F_CULL_SAME nor the translucent pass hides it.
fn face_exact(m: *mut Mesher, t: *mut MeshTables, p: usize, f: usize, cull_same: bool, trans_pass: bool) -> bool {
    let pad: u64 = (*m).pad
    let a: u16 = rt.ld16(pad, p)
    var tile: u32 = rt.ld16((*t).tiles, (a as usize) * 6 + f) as u32
    if tile == 0 as u32 { return false }
    let fr: usize = front_of(p, f)
    let b: u16 = rt.ld16(pad, fr)
    if cull_same && b == a { return false }
    if trans_pass && (rt.ld8((*m).mask + CLS_OFS as u64, fr) & 4 as u8) != 0 as u8 {
        if tile > MAX_TILE { tile = MAX_TILE }
        if (rt.ld16((*t).tiles, (b as usize) * 6 + f) as u32) == tile { return false }
    }
    return true
}

// Mask key of the visible face f of cell p (fr = cell in front of it, su / sv = padded strides of the u / v axis):
// tile | corner values (ao | sky << 2 | block << 6) of the four corners << 16, 26, 36, 46 | bit 56.
fn face_key(m: *mut Mesher, t: *mut MeshTables, p: usize, f: usize, fr: usize, su: usize, sv: usize, use_ao: bool, use_light: bool) -> u64 {
    let cls: u64 = (*m).mask + CLS_OFS as u64
    let a: u16 = rt.ld16((*m).pad, p)
    var tile: u32 = rt.ld16((*t).tiles, (a as usize) * 6 + f) as u32
    if tile > MAX_TILE { tile = MAX_TILE }
    // corner values: ao | sky << 2 | block << 6 (default: ao 3, sky 15, block 0)
    var cv0: u32 = 3 as u32 | (15 as u32 << 2 as u32)
    var cv1: u32 = cv0
    var cv2: u32 = cv0
    var cv3: u32 = cv0
    if use_ao {
        let um: u32 = (rt.ld8(cls, fr - su) & 1 as u8) as u32
        let up: u32 = (rt.ld8(cls, fr + su) & 1 as u8) as u32
        let vm: u32 = (rt.ld8(cls, fr - sv) & 1 as u8) as u32
        let vp: u32 = (rt.ld8(cls, fr + sv) & 1 as u8) as u32
        let c00: u32 = (rt.ld8(cls, fr - su - sv) & 1 as u8) as u32
        let c10: u32 = (rt.ld8(cls, fr + su - sv) & 1 as u8) as u32
        let c11: u32 = (rt.ld8(cls, fr + su + sv) & 1 as u8) as u32
        let c01: u32 = (rt.ld8(cls, fr - su + sv) & 1 as u8) as u32
        cv0 = (cv0 & 0xFFFFFFFC as u32) | ao_level(um, vm, c00)
        cv1 = (cv1 & 0xFFFFFFFC as u32) | ao_level(up, vm, c10)
        cv2 = (cv2 & 0xFFFFFFFC as u32) | ao_level(up, vp, c11)
        cv3 = (cv3 & 0xFFFFFFFC as u32) | ao_level(um, vp, c01)
    }
    if use_light {
        // the 2x2 patch in front of the face per corner: (front, u side, v side, diagonal)
        let l00: u32 = corner_light(m, t, fr, fr - su, fr - sv, fr - su - sv)
        let l10: u32 = corner_light(m, t, fr, fr + su, fr - sv, fr + su - sv)
        let l11: u32 = corner_light(m, t, fr, fr + su, fr + sv, fr + su + sv)
        let l01: u32 = corner_light(m, t, fr, fr - su, fr + sv, fr - su + sv)
        cv0 = (cv0 & 3 as u32) | l00
        cv1 = (cv1 & 3 as u32) | l10
        cv2 = (cv2 & 3 as u32) | l11
        cv3 = (cv3 & 3 as u32) | l01
    }
    return (tile as u64) | ((cv0 as u64) << 16 as u64) | ((cv1 as u64) << 26 as u64) |
    ((cv2 as u64) << 36 as u64) | ((cv3 as u64) << 46 as u64) | (1 as u64 << 56 as u64)
}

// Meshes the interior of the padded array in (*m).pad. Clears the previous mesh.
//
// Pass 1 classifies every padded cell (cls) and builds, per padded row (y, z), two 18 bit masks: hide (opaque or unknown cell)
// and mesh (interior cell of a block that can show a face in this pass). Pass 2 selects the visible faces of a whole row at once
// (mesh & !hide of the neighbour row / shifted row) and files them by slice: cmask[face][slice][row] = bits of the column.
// Pass 3 walks the slices in the order face, slice, row, column (the order of the quads in the buffers).
fn mesh_run(m: *mut Mesher, t: *mut MeshTables, flags: u32) {
    (*m).nverts = 0 as u32
    (*m).nidx = 0 as u32
    (*m).nquads = 0 as u32
    (*m).nfaces = 0 as u32
    let greedy: bool = (flags & F_GREEDY) != 0 as u32
    let use_ao: bool = (flags & F_AO) != 0 as u32
    let cull_same: bool = (flags & F_CULL_SAME) != 0 as u32
    let use_light: bool = (flags & F_LIGHT) != 0 as u32
    let trans_pass: bool = (flags & F_TRANS) != 0 as u32
    let pad: u64 = (*m).pad
    let cls: u64 = (*m).mask + CLS_OFS as u64
    let hrow: u64 = (*m).mask + HROW_OFS as u64
    let mrow: u64 = (*m).mask + MROW_OFS as u64
    let cmask: u64 = (*m).mask + CMASK_OFS as u64
    let tab: u64 = (*m).mask + TAB_OFS as u64
    let opq: u64 = (*t).opaque
    let tiles: u64 = (*t).tiles

    // ---- pass 1
    var any_trans: bool = false
    var partial: bool = false // some block of this pass has a tile on some faces only
    var last_id: u32 = 65536 as u32
    var last_cls: u8 = 0 as u8
    var lid2: u32 = 65536 as u32
    var ltm: u32 = 0 as u32
    var y: usize = 0
    while y < 18 {
        var z: usize = 0
        while z < 18 {
            let rowp: usize = (y * 18 + z) * 18
            let inner: bool = y >= 1 && y <= 16 && z >= 1 && z <= 16
            var hb: u32 = 0 as u32
            var mb: u32 = 0 as u32
            var x: usize = 0
            while x < 18 {
                let id: u16 = rt.ld16(pad, rowp + x)
                if (id as u32) != last_id {
                    last_id = id as u32
                    last_cls = 0 as u8
                    if id == UNKNOWN_ID {
                        last_cls = 2 as u8
                    } else if id < 32768 as u16 {
                        let fl: u8 = rt.ld8(opq, id as usize)
                        if (fl & 1 as u8) != 0 as u8 { last_cls = 3 as u8 }
                        if (fl & 2 as u8) != 0 as u8 {
                            last_cls = last_cls | 4 as u8
                            any_trans = true
                        }
                    }
                }
                rt.st8(cls, rowp + x, last_cls)
                if (last_cls & 2 as u8) != 0 as u8 { hb = hb | (1 as u32 << (x as u32)) }
                if inner && x >= 1 && x <= 16 && id < 32768 as u16 {
                    if (id as u32) != lid2 {
                        lid2 = id as u32
                        ltm = 0 as u32
                        // translucent blocks only in the translucent pass, the others only in the opaque pass
                        if ((last_cls & 4 as u8) != 0 as u8) == trans_pass {
                            var ff: usize = 0
                            while ff < 6 {
                                if rt.ld16(tiles, (id as usize) * 6 + ff) != 0 as u16 { ltm = ltm | (1 as u32 << (ff as u32)) }
                                ff = ff + 1
                            }
                            if ltm != 0 as u32 && ltm != 63 as u32 { partial = true }
                        }
                    }
                    if ltm != 0 as u32 { mb = mb | (1 as u32 << (x as u32)) }
                }
                x = x + 1
            }
            rt.st32(hrow, y * 18 + z, hb)
            rt.st32(mrow, y * 18 + z, mb)
            z = z + 1
        }
        y = y + 1
    }
    // the translucent pass of a section without any translucent block meshes nothing
    if trans_pass && !any_trans { return }

    // ---- pass 2
    rt.mem_set(cmask, 0 as u8, 6 * 16 * 16 * 2)
    let exact: bool = cull_same || trans_pass || partial
    var nfaces: u32 = 0 as u32
    y = 0
    while y < 16 {
        var z: usize = 0
        while z < 16 {
            let ri: usize = (y + 1) * 18 + (z + 1)
            let mb: u32 = rt.ld32(mrow, ri)
            if mb != 0 as u32 {
                let hc: u32 = rt.ld32(hrow, ri)
                // columns 1..16 -> bit 0..15
                var c0: u32 = (mb & ((hc << 1 as u32) ^ 0x7FFFFFFF as u32)) >> 1 as u32
                var c1: u32 = (mb & ((hc >> 1 as u32) ^ 0x7FFFFFFF as u32)) >> 1 as u32
                var c2: u32 = 0 as u32
                var c3: u32 = 0 as u32
                var c4: u32 = 0 as u32
                var c5: u32 = 0 as u32
                c2 = (mb & (rt.ld32(hrow, ri - 18) ^ 0x7FFFFFFF as u32)) >> 1 as u32
                c3 = (mb & (rt.ld32(hrow, ri + 18) ^ 0x7FFFFFFF as u32)) >> 1 as u32
                c4 = (mb & (rt.ld32(hrow, ri - 1) ^ 0x7FFFFFFF as u32)) >> 1 as u32
                c5 = (mb & (rt.ld32(hrow, ri + 1) ^ 0x7FFFFFFF as u32)) >> 1 as u32
                c0 = c0 & 0xFFFF as u32
                c1 = c1 & 0xFFFF as u32
                c2 = c2 & 0xFFFF as u32
                c3 = c3 & 0xFFFF as u32
                c4 = c4 & 0xFFFF as u32
                c5 = c5 & 0xFFFF as u32
                let p0: usize = ((y + 1) * 18 + (z + 1)) * 18 + 1
                // -x / +x: slice x, row z, column y
                var f: usize = 0
                while f < 2 {
                    var c: u32 = c0
                    if f == 1 { c = c1 }
                    while c != 0 as u32 {
                        let lb: u32 = c ^ (c & (c - 1 as u32))
                        c = c ^ lb
                        let x: usize = bit_index(tab, lb)
                        if !exact || face_exact(m, t, p0 + x, f, cull_same, trans_pass) {
                            let ci: usize = (f * 16 + x) * 16 + z
                            rt.st16(cmask, ci, rt.ld16(cmask, ci) | (1 as u32 << (y as u32)) as u16)
                            nfaces = nfaces + 1 as u32
                        }
                    }
                    f = f + 1
                }
                // -y / +y: slice y, row x, column z
                f = 2
                while f < 4 {
                    var c: u32 = c2
                    if f == 3 { c = c3 }
                    while c != 0 as u32 {
                        let lb: u32 = c ^ (c & (c - 1 as u32))
                        c = c ^ lb
                        let x: usize = bit_index(tab, lb)
                        if !exact || face_exact(m, t, p0 + x, f, cull_same, trans_pass) {
                            let ci: usize = (f * 16 + y) * 16 + x
                            rt.st16(cmask, ci, rt.ld16(cmask, ci) | (1 as u32 << (z as u32)) as u16)
                            nfaces = nfaces + 1 as u32
                        }
                    }
                    f = f + 1
                }
                // -z / +z: slice z, row y, column x = the row mask itself
                f = 4
                while f < 6 {
                    var c: u32 = c4
                    if f == 5 { c = c5 }
                    if c != 0 as u32 {
                        if exact {
                            var rest: u32 = c
                            while rest != 0 as u32 {
                                let lb: u32 = rest ^ (rest & (rest - 1 as u32))
                                rest = rest ^ lb
                                if !face_exact(m, t, p0 + bit_index(tab, lb), f, cull_same, trans_pass) { c = c ^ lb }
                            }
                        }
                        rt.st16(cmask, (f * 16 + z) * 16 + y, c as u16)
                        nfaces = nfaces + popc16(c)
                    }
                    f = f + 1
                }
            }
            z = z + 1
        }
        y = y + 1
    }
    (*m).nfaces = nfaces
    if nfaces == 0 as u32 { return }

    // ---- pass 3
    let strides: [usize; 3] = [1, 324, 18]
    var f: usize = 0
    while f < 6 {
        let axis: usize = f / 2
        let ua: usize = (axis + 1) % 3
        let va: usize = (axis + 2) % 3
        let sa: usize = strides[axis]
        let su: usize = strides[ua]
        let sv: usize = strides[va]
        let pos_face: bool = f % 2 == 1
        var s: usize = 0
        while s < 16 {
            let cb: usize = (f * 16 + s) * 16
            var any: u32 = 0 as u32
            var j: usize = 0
            while j < 16 {
                any = any | (rt.ld16(cmask, cb + j) as u32)
                j = j + 1
            }
            if any != 0 as u32 {
                var pc: usize = s
                if pos_face { pc = s + 1 }
                if !greedy {
                    // every face is one 1x1 quad
                    j = 0
                    while j < 16 {
                        var c: u32 = rt.ld16(cmask, cb + j) as u32
                        while c != 0 as u32 {
                            let lb: u32 = c ^ (c & (c - 1 as u32))
                            c = c ^ lb
                            let i: usize = bit_index(tab, lb)
                            let p: usize = (s + 1) * sa + (i + 1) * su + (j + 1) * sv
                            var fr: usize = p - sa
                            if pos_face { fr = p + sa }
                            let key: u64 = face_key(m, t, p, f, fr, su, sv, use_ao, use_light)
                            emit_quad(m, f, pc, i, j, 1, 1, (key & 65535 as u64) as u32,
                                ((key >> 16 as u64) & 1023 as u64) as u32, ((key >> 26 as u64) & 1023 as u64) as u32,
                                ((key >> 36 as u64) & 1023 as u64) as u32, ((key >> 46 as u64) & 1023 as u64) as u32)
                        }
                        j = j + 1
                    }
                } else {
                    // keys of the slice cells that have a face (no clearing: the row bits in cmask say which keys are valid)
                    j = 0
                    while j < 16 {
                        var c: u32 = rt.ld16(cmask, cb + j) as u32
                        while c != 0 as u32 {
                            let lb: u32 = c ^ (c & (c - 1 as u32))
                            c = c ^ lb
                            let i: usize = bit_index(tab, lb)
                            let p: usize = (s + 1) * sa + (i + 1) * su + (j + 1) * sv
                            var fr: usize = p - sa
                            if pos_face { fr = p + sa }
                            rt.st64((*m).mask, j * 16 + i, face_key(m, t, p, f, fr, su, sv, use_ao, use_light))
                        }
                        j = j + 1
                    }
                    // merge: walk the remaining face bits of every row (lowest first = same order as a 16 x 16 scan);
                    // a merged rectangle clears its bits in cmask
                    j = 0
                    while j < 16 {
                        var rowbits: u32 = rt.ld16(cmask, cb + j) as u32
                        while rowbits != 0 as u32 {
                            let lb: u32 = rowbits ^ (rowbits & (rowbits - 1 as u32))
                            let i: usize = bit_index(tab, lb)
                            let key: u64 = rt.ld64((*m).mask, j * 16 + i)
                            let ao0: u32 = ((key >> 16 as u64) & 1023 as u64) as u32
                            let ao1: u32 = ((key >> 26 as u64) & 1023 as u64) as u32
                            let ao2: u32 = ((key >> 36 as u64) & 1023 as u64) as u32
                            let ao3: u32 = ((key >> 46 as u64) & 1023 as u64) as u32
                            var w: usize = 1
                            var h: usize = 1
                            if ao0 == ao1 && ao3 == ao2 {
                                while i + w < 16 && ((rowbits >> ((i + w) as u32)) & 1 as u32) != 0 as u32 &&
                                    rt.ld64((*m).mask, j * 16 + i + w) == key {
                                    w = w + 1
                                }
                            }
                            let wm: u32 = (((1 as u32) << (w as u32)) - 1 as u32) << (i as u32)
                            if ao0 == ao3 && ao1 == ao2 {
                                var grow: bool = true
                                while grow && j + h < 16 {
                                    if (((rt.ld16(cmask, cb + j + h) as u32) & wm) != wm) {
                                        grow = false
                                    } else {
                                        var q: usize = 0
                                        while q < w {
                                            if rt.ld64((*m).mask, (j + h) * 16 + i + q) != key { grow = false }
                                            q = q + 1
                                        }
                                        if grow { h = h + 1 }
                                    }
                                }
                            }
                            // clear the rectangle
                            var rj: usize = 0
                            while rj < h {
                                rt.st16(cmask, cb + j + rj, ((rt.ld16(cmask, cb + j + rj) as u32) & (wm ^ 0xFFFF as u32)) as u16)
                                rj = rj + 1
                            }
                            emit_quad(m, f, pc, i, j, w, h, (key & 65535 as u64) as u32, ao0, ao1, ao2, ao3)
                            rowbits = rt.ld16(cmask, cb + j) as u32
                        }
                        j = j + 1
                    }
                }
            }
            s = s + 1
        }
        f = f + 1
    }
}

// Classic voxel AO (0fps): two occluding sides = darkest; otherwise 3 - (sides + corner).
fn ao_level(s1: u32, s2: u32, c: u32) -> u32 {
    if s1 == 1 as u32 && s2 == 1 as u32 { return 0 as u32 }
    return 3 as u32 - (s1 + s2 + c)
}

// Meshes an already assembled padded array (u16 [5832], layout in the header).
// The array is copied; the Mesher keeps no pointer to it.
fn mesh_padded(m: *mut Mesher, pad: u64, t: *mut MeshTables, flags: u32) {
    rt.mem_copy((*m).pad, pad, PADN * 2)
    rt.mem_set((*m).lpad, LIGHT_DEFAULT, PADN)
    mesh_run(m, t, flags)
}

// Like mesh_padded plus a padded light array (u8 [5832], same index, sky << 4 | block); the
// light is only used when `flags` contains F_LIGHT. Also copied.
fn mesh_padded_lit(m: *mut Mesher, pad: u64, lpad: u64, t: *mut MeshTables, flags: u32) {
    rt.mem_copy((*m).pad, pad, PADN * 2)
    rt.mem_copy((*m).lpad, lpad, PADN)
    mesh_run(m, t, flags)
}

// Meshes `sec` with its 6 face neighbours. `nbrs` = address of 6 u64 (order -x +x
// -y +y -z +z), each the address of a mc_chunk.Section or 0 = not loaded. `missing`
// is MISSING_AIR (not loaded counts as air: border faces are drawn) or
// MISSING_UNKNOWN (not loaded = unknown: no faces toward it, no AO from it). The
// edge / corner cells of the shell (no face neighbour contains them) are "missing"
// as well.
fn mesh_section(m: *mut Mesher, sec: *mut mc_chunk.Section, nbrs: u64, missing: u32,
    t: *mut MeshTables, flags: u32) {
    rt.mem_set((*m).lpad, LIGHT_DEFAULT, PADN)
    if missing == MISSING_UNKNOWN {
        pad_fill(m, UNKNOWN_ID)
    } else {
        pad_fill(m, 0 as u16)
    }
    section_to_pad(m, sec)
    var f: usize = 0
    while f < 6 {
        let nb: u64 = rt.ld64(nbrs, f)
        if nb != 0 {
            layer_to_pad(m, nb as *mut mc_chunk.Section, f)
        }
        f = f + 1
    }
    mesh_run(m, t, flags)
}

// ---- test support: build / free a Section from 4096 plain ids ----------------------

// Packs `ids` (u16 [4096], index (y*16+z)*16+x) into a normalised palette container
// exactly like the chunk decoder does (1 distinct id = palette only, else dense
// indexes of ceil(log2(n)) bits). Biomes are left empty. Returns false on out of memory.
fn section_pack(ids: u64, out: *mut mc_chunk.Section) -> bool {
    let map: u64 = rt.heap_alloc(65536 * 2) // palette index + 1 per id, 0 = absent
    let pal: u64 = rt.heap_alloc(4096 * 2)
    if map == 0 || pal == 0 { return false }
    var pn: usize = 0
    var i: usize = 0
    while i < 4096 {
        let id: u16 = rt.ld16(ids, i)
        if rt.ld16(map, id as usize) == 0 as u16 {
            rt.st16(pal, pn, id)
            pn = pn + 1
            rt.st16(map, id as usize, pn as u16)
        }
        i = i + 1
    }
    var bits: u32 = 0 as u32
    var words: usize = 0
    var data: u64 = 0
    if pn > 1 {
        bits = 1 as u32
        while (1 as usize << bits) < pn { bits = bits + 1 as u32 }
        words = (4096 * (bits as usize) + 63) / 64
        data = rt.heap_alloc(words * 8)
        var k: usize = 0
        while k < 4096 {
            let idx: u64 = (rt.ld16(map, rt.ld16(ids, k) as usize) - 1 as u16) as u64
            let bit: usize = k * (bits as usize)
            let w: usize = bit / 64
            let off: u32 = (bit % 64) as u32
            rt.st64(data, w, rt.ld64(data, w) | (idx << off))
            if (off as usize) + (bits as usize) > 64 {
                rt.st64(data, w + 1, rt.ld64(data, w + 1) | (idx >> (64 as u32 - off)))
            }
            k = k + 1
        }
    }
    let pal2: u64 = rt.heap_alloc(pn * 2)
    rt.mem_copy(pal2, pal, pn * 2)
    rt.heap_free(map, 65536 * 2)
    rt.heap_free(pal, 4096 * 2)
    (*out).count = 0
    (*out).blocks.bits = bits
    (*out).blocks.pal_n = pn as u32
    (*out).blocks.pal = pal2
    (*out).blocks.data = data
    (*out).blocks.words = words
    (*out).biomes.bits = 0 as u32
    (*out).biomes.pal_n = 0 as u32
    (*out).biomes.pal = 0
    (*out).biomes.data = 0
    (*out).biomes.words = 0
    return true
}

// Frees what section_pack allocated.
fn section_free(sec: *mut mc_chunk.Section) {
    if (*sec).blocks.pal != 0 { rt.heap_free((*sec).blocks.pal, ((*sec).blocks.pal_n as usize) * 2) }
    if (*sec).blocks.data != 0 { rt.heap_free((*sec).blocks.data, (*sec).blocks.words * 8) }
    (*sec).blocks.pal = 0
    (*sec).blocks.data = 0
}
