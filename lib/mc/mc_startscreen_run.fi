import std.rt
import std.env
import window.window
import input.raw
import mc.mc_raster
import mc.mc_hud
import mc.mc_launch_cfg
import mc.mc_startscreen
import mc.mc_menu_run
import mc.mc_serverlist

export { startscreen_pick, PICK_OK, PICK_CANCELLED, PICK_NO_DISPLAY, WIN_W, WIN_H }

const PICK_OK: i32 = 0
const PICK_CANCELLED: i32 = 1
const PICK_NO_DISPLAY: i32 = 2
const WIN_W: i32 = 640
const WIN_H: i32 = 480
const FRAME_MS: i64 = 16

fn now_ms() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] * 1000 + ts[1] / 1000000) as u64
}

fn run_form(f: *mut mc_startscreen.StartForm) -> i32 {
    var win: window.Window = window.window_new()
    if !window.open_window(&win, 0) { return PICK_NO_DISPLAY }
    window.full_input(&win, true)
    if !window.make(&win, WIN_W as usize, WIN_H as usize) { return PICK_NO_DISPLAY }
    window.raw_input(&win, true)
    let ttl: str = "mcplay"
    window.title(&win, ttl.p as u64, ttl.n)
    window.show_window(&win)
    var rw: raw.Raw = raw.raw_new()
    var r: mc_raster.Raster = mc_raster.raster_new(WIN_W, WIN_H)
    let bgrx: u64 = rt.heap_alloc((WIN_W as usize) * (WIN_H as usize) * 4)
    var closed: bool = false
    while !(*f).submitted && !(*f).cancelled && !closed {
        raw.raw_begin(&rw)
        var k: u32 = window.next_event(&win)
        var guard: i32 = 0
        while k != window.EV_NONE && guard < 20000 {
            guard = guard + 1
            if k == window.EV_CHAR {
                mc_startscreen.form_char(f, window.ev_a(&win))
            } else if k == window.EV_CLOSED {
                closed = true
            } else if k != window.EV_CONFIGURE {
                raw.raw_feed(&rw, k, window.ev_a(&win), window.ev_x(&win), window.ev_y(&win), window.ev_state(&win))
            }
            k = window.next_event(&win)
        }
        raw.raw_end(&rw)
        mc_startscreen.form_keys(f, &rw)
        let ms: u64 = now_ms()
        let scale: i32 = mc_hud.hud_scale(WIN_W, WIN_H)
        mc_startscreen.form_pointer(f, WIN_W, WIN_H, scale, raw.mouse_x(&rw) as i32, raw.mouse_y(&rw) as i32, raw.mouse_pressed(&rw, 0 as u32), ms)
        mc_startscreen.form_draw(f, &r, scale, ms)
        window.to_bgrx(r.color, bgrx, (WIN_W as usize) * (WIN_H as usize))
        window.image(&win, bgrx, WIN_W as usize, WIN_H as usize, 0, 0)
        window.present(&win)
        window.wait_event(&win, FRAME_MS)
    }
    rt.heap_free(bgrx, (WIN_W as usize) * (WIN_H as usize) * 4)
    mc_raster.raster_free(&r)
    window.close_window(&win)
    if (*f).submitted { return PICK_OK }
    return PICK_CANCELLED
}

fn startscreen_pick(host: *mut rt.Buf, name: *mut rt.Buf, port: *mut i32, proto: *mut i32, view: *mut i32) -> i32 {
    var path: rt.Buf = rt.buf_new()
    var cfg: mc_launch_cfg.LaunchCfg = mc_launch_cfg.cfg_new()
    let have_path: bool = mc_launch_cfg.cfg_default_path(&path)
    var path_s: str = str { p: 0 as *u8, n: 0 }
    if have_path { path_s = str { p: rt.buf_data(&path), n: rt.buf_len(&path) } }
    var loaded: bool = false
    if have_path { loaded = mc_launch_cfg.cfg_load(path_s, &cfg) }
    var f: mc_startscreen.StartForm = mc_startscreen.form_new()
    mc_startscreen.form_from_cfg(&f, &cfg)
    if rt.buf_len(name) > 1 { mc_startscreen.form_set(&f, mc_startscreen.FIELD_NAME, rt.buf_ptr(name), rt.buf_len(name) - 1) }
    var res: i32 = PICK_OK
    let auto: bool = env.has("MCPLAY_START_AUTO") && env.get("MCPLAY_START_AUTO").n > 0 && env.get("MCPLAY_START_AUTO").chars(0) == 49 as u8
    if auto && loaded && mc_startscreen.form_validate(&f) == mc_startscreen.ERR_NONE {
        f.submitted = true
    } else {
        res = mc_menu_run.MENU_UNAVAILABLE
        if mc_menu_run.menu_wanted() { res = mc_menu_run.menu_run(&f, 763) }
        if res == mc_menu_run.MENU_UNAVAILABLE { res = run_form(&f) }
        if res == PICK_CANCELLED && have_path {
            mc_serverlist.sl_copy(&cfg.servers, &f.servers)
            mc_launch_cfg.cfg_save(path_s, &cfg)
        }
    }
    if res == PICK_OK {
        mc_startscreen.form_to_cfg(&f, &cfg)
        if have_path { mc_launch_cfg.cfg_save(path_s, &cfg) }
        rt.buf_clear(host)
        rt.buf_push_bytes(host, rt.buf_ptr(&cfg.host), rt.buf_len(&cfg.host))
        rt.buf_push(host, 0 as u8)
        rt.buf_clear(name)
        rt.buf_push_bytes(name, rt.buf_ptr(&cfg.name), rt.buf_len(&cfg.name))
        rt.buf_push(name, 0 as u8)
        *port = cfg.port
        *proto = cfg.protocol
        *view = cfg.view
    }
    mc_startscreen.form_free(&f)
    mc_launch_cfg.cfg_free(&cfg)
    rt.buf_free(&path)
    return res
}
