// SPDX-License-Identifier: MPL-2.0
import mc.mc_raster
import mc.mc_hud
import mc.mc_weather
import mc.mc_precip

export { weather_fx_draw, streak_layer, LAYER_COUNT, weather_fx_count, weather_fx_dim_alpha, weather_fx_effective_milli, STREAK_RGB, DIM_RGB, FLAKE_RGB }

const STREAK_RGB: u32 = 0x00F0C8B0
const DIM_RGB: u32 = 0x00000000
const FLAKE_RGB: u32 = 0x00FFFFFF
const FLAKE_ALPHA_MIN: i32 = 130
const FLAKE_ALPHA_SPAN: i32 = 90
const FLAKE_SWAY: i32 = 6
const AREA_PER_STREAK: i32 = 700
const SEGMENTS: i32 = 3
const LAYER_COUNT: i32 = 3
const STREAK_ALPHA_MIN: i32 = 60
const STREAK_ALPHA_SPAN: i32 = 70
const DIM_RAIN_ALPHA: i32 = 34
const DIM_THUNDER_ALPHA: i32 = 34

fn hash32(v: u32, salt: u32) -> u32 {
    var h: u32 = (v +% salt) *% 2654435761 as u32
    h = h ^ (h >> 15 as u32)
    h = h *% 2246822519 as u32
    h = h ^ (h >> 13 as u32)
    return h
}

fn weather_fx_count(w: i32, h: i32, rain_milli: i32) -> i32 {
    return ((w * h) / AREA_PER_STREAK * rain_milli) / mc_weather.LEVEL_MAX
}

fn weather_fx_dim_alpha(rain_milli: i32, thunder_milli: i32) -> i32 {
    return (rain_milli * DIM_RAIN_ALPHA + thunder_milli * DIM_THUNDER_ALPHA) / mc_weather.LEVEL_MAX
}

fn argb(alpha: i32, rgb: u32) -> u32 {
    return ((alpha as u32) << 24 as u32) | rgb
}

fn streak_layer(i: i32) -> i32 {
    return (hash32(i as u32, 83 as u32) % LAYER_COUNT as u32) as i32
}

fn draw_streak(r: *mut mc_raster.Raster, i: i32, ms: u64, scale: i32, alpha: i32) {
    let w: i32 = (*r).w
    let h: i32 = (*r).h
    let hx: u32 = hash32(i as u32, 11 as u32)
    let hy: u32 = hash32(i as u32, 29 as u32)
    let hs: u32 = hash32(i as u32, 47 as u32)
    let layer: i32 = streak_layer(i)
    var len: i32 = (3 + (hs % 5 as u32) as i32 + layer * 2) * scale
    if len < SEGMENTS { len = SEGMENTS }
    let seg: i32 = len / SEGMENTS
    let speed: i32 = (200 + (hs % 140 as u32) as i32 + layer * 90) * scale
    let span: i32 = h + len
    let fall: i32 = ((ms * speed as u64) / 1000 as u64 % span as u64) as i32
    let top: i32 = ((hy % span as u32) as i32 + fall) % span - len
    let x: i32 = (hx % w as u32) as i32
    var thick: i32 = (scale * (layer + 1) + 2) / 4
    if thick < 1 { thick = 1 }
    let a: i32 = alpha * (LAYER_COUNT - 1 + layer) / (2 * (LAYER_COUNT - 1))
    var k: i32 = 0
    while k < SEGMENTS {
        mc_hud.hud_rect(r, x + k * thick, top + k * seg, thick, seg, argb(a, STREAK_RGB))
        k = k + 1
    }
}

fn draw_flake(r: *mut mc_raster.Raster, i: i32, ms: u64, scale: i32, alpha: i32) {
    let w: i32 = (*r).w
    let h: i32 = (*r).h
    let hx: u32 = hash32(i as u32, 11 as u32)
    let hy: u32 = hash32(i as u32, 29 as u32)
    let hs: u32 = hash32(i as u32, 47 as u32)
    let size: i32 = 1 + (scale + (hs % 2 as u32) as i32) / 2
    let speed: i32 = (50 + (hs % 50 as u32) as i32) * scale
    let span: i32 = h + size
    let fall: i32 = ((ms * speed as u64) / 1000 as u64 % span as u64) as i32
    let top: i32 = ((hy % span as u32) as i32 + fall) % span - size
    let phase: i32 = (((ms / 40 as u64) as i32) + (hs % 64 as u32) as i32) % 32
    var tri: i32 = phase
    if tri > 16 { tri = 32 - tri }
    let x: i32 = ((hx % w as u32) as i32 + (tri - 8) * FLAKE_SWAY * scale / 8 + w) % w
    mc_hud.hud_rect(r, x, top, size, size, argb(alpha, FLAKE_RGB))
}

fn weather_fx_effective_milli(rain_milli: i32, exposure: i32) -> i32 {
    return (rain_milli * exposure) / mc_weather.LEVEL_MAX
}

fn weather_fx_draw(r: *mut mc_raster.Raster, scale: i32, wx: *mut mc_weather.Weather, ms: u64) {
    let rain: i32 = mc_weather.weather_rain_milli(wx)
    if rain <= 0 { return }
    let thunder: i32 = mc_weather.weather_thunder_milli(wx)
    let dim: i32 = weather_fx_dim_alpha(rain, thunder)
    if dim > 0 { mc_hud.hud_rect(r, 0, 0, (*r).w, (*r).h, argb(dim, DIM_RGB)) }
    let kind: i32 = (*wx).kind
    if kind == mc_precip.PRECIP_NONE { return }
    let n: i32 = weather_fx_count((*r).w, (*r).h, weather_fx_effective_milli(rain, (*wx).exposure))
    var i: i32 = 0
    if kind == mc_precip.PRECIP_SNOW {
        let fa: i32 = FLAKE_ALPHA_MIN + (FLAKE_ALPHA_SPAN * rain) / mc_weather.LEVEL_MAX
        while i < n {
            draw_flake(r, i, ms, scale, fa)
            i = i + 1
        }
        return
    }
    let alpha: i32 = STREAK_ALPHA_MIN + (STREAK_ALPHA_SPAN * rain) / mc_weather.LEVEL_MAX
    while i < n {
        draw_streak(r, i, ms, scale, alpha)
        i = i + 1
    }
}
