import mc.mc_client
import mc.mc_inv

export { imulti_group, imulti_quick_all, MODE_QUICK_MOVE, MODE_CLONE }

const MODE_QUICK_MOVE: i32 = 1
const MODE_CLONE: i32 = 3
const MAX_SLOTS: i32 = 96

fn imulti_group(v: *mut mc_inv.Inv, ws: i32, plain_container: bool, lo: *mut i32, hi: *mut i32) -> bool {
    let n: i32 = mc_inv.inv_window_slots(v)
    if mc_inv.inv_window(v) == 0 || n <= 0 {
        if ws >= 5 && ws <= 45 {
            *lo = 5
            *hi = 45
            return true
        }
        if ws >= 1 && ws <= 4 {
            *lo = 1
            *hi = 4
            return true
        }
        return false
    }
    if ws >= n && ws < n + 36 {
        *lo = n
        *hi = n + 35
        return true
    }
    if ws >= 0 && ws < n && plain_container {
        *lo = 0
        *hi = n - 1
        return true
    }
    return false
}

fn matches(v: *mut mc_inv.Inv, ws: i32, item: i32, sig: i32) -> bool {
    let k: i32 = mc_inv.inv_win_to_int(v, ws)
    return k >= 0 && mc_inv.inv_item(v, k) == item && mc_inv.inv_count(v, k) > 0 && mc_inv.inv_sig(v, k) == sig
}

fn imulti_quick_all(cl: *mut mc_client.Client, v: *mut mc_inv.Inv, lo: i32, hi: i32, item: i32, sig: i32) -> i32 {
    if item < 0 || hi - lo >= MAX_SLOTS { return 0 }
    var hit: [bool; 96] = [false; 96]
    var ws: i32 = lo
    while ws <= hi {
        hit[(ws - lo) as usize] = matches(v, ws, item, sig)
        ws = ws + 1
    }
    var sent: i32 = 0
    ws = lo
    while ws <= hi {
        if hit[(ws - lo) as usize] && matches(v, ws, item, sig) {
            if mc_inv.inv_click(cl, v, ws, 0, MODE_QUICK_MOVE) { sent = sent + 1 }
        }
        ws = ws + 1
    }
    return sent
}
