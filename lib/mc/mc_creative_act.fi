import mc.mc_client
import mc.mc_registry
import mc.mc_inv
import mc.mc_creative

export { cra_pick, cra_slot, cra_outside, cra_delete, cra_key_swap, cra_drop_pick, CRA_LEFT, CRA_RIGHT, CRA_MIDDLE }

const CRA_LEFT: i32 = 0
const CRA_RIGHT: i32 = 1
const CRA_MIDDLE: i32 = 2
const SLOT_CURSOR: i32 = 1000
const DROP_SLOT: i32 = 0 - 1
const INV_WINDOW_SLOTS: i32 = 46

fn max_stack(reg: *mut mc_registry.Registry, item: i32) -> i32 {
    let m: i32 = mc_registry.reg_item_stack(reg, item)
    if m <= 0 { return 1 }
    return m
}

fn set_cursor(inv: *mut mc_inv.Inv, item: i32, count: i32) {
    if item < 0 || count <= 0 {
        mc_inv.inv_set(inv, SLOT_CURSOR, 0 - 1, 0)
        return
    }
    mc_inv.inv_set(inv, SLOT_CURSOR, item, count)
}

fn put_slot(cl: *mut mc_client.Client, inv: *mut mc_inv.Inv, ws: i32, item: i32, count: i32, send: bool) {
    var it: i32 = item
    var n: i32 = count
    if n <= 0 {
        it = 0 - 1
        n = 0
    }
    mc_inv.inv_set(inv, ws, it, n)
    if send { mc_inv.inv_send_creative(cl, ws, it, n) }
}

fn cra_pick(cr: *mut mc_creative.Creative, reg: *mut mc_registry.Registry, inv: *mut mc_inv.Inv, k: i32, button: i32, shift: bool) {
    let item: i32 = mc_creative.cr_item(cr, k)
    let ci: i32 = mc_inv.inv_cursor_item(inv)
    let cc: i32 = mc_inv.inv_cursor_count(inv)
    if button == CRA_MIDDLE {
        if ci < 0 && item >= 0 { set_cursor(inv, item, max_stack(reg, item)) }
        return
    }
    if ci >= 0 && item == ci {
        let mx: i32 = max_stack(reg, item)
        if button == CRA_LEFT {
            if shift {
                set_cursor(inv, ci, mx)
            } else if cc < mx {
                set_cursor(inv, ci, cc + 1)
            }
        } else {
            set_cursor(inv, ci, cc - 1)
        }
        return
    }
    if item >= 0 && ci < 0 {
        var n: i32 = 1
        if shift { n = max_stack(reg, item) }
        set_cursor(inv, item, n)
        return
    }
    if button == CRA_RIGHT {
        set_cursor(inv, ci, cc - 1)
    } else {
        set_cursor(inv, 0 - 1, 0)
    }
}

fn cra_slot(cl: *mut mc_client.Client, reg: *mut mc_registry.Registry, inv: *mut mc_inv.Inv, ws: i32, button: i32, send: bool) {
    let ci: i32 = mc_inv.inv_cursor_item(inv)
    let cc: i32 = mc_inv.inv_cursor_count(inv)
    let si: i32 = mc_inv.inv_item(inv, ws)
    let sc: i32 = mc_inv.inv_count(inv, ws)
    if ci < 0 {
        if si < 0 || sc <= 0 { return }
        var take: i32 = sc
        if button == CRA_RIGHT { take = (sc + 1) / 2 }
        set_cursor(inv, si, take)
        put_slot(cl, inv, ws, si, sc - take, send)
        return
    }
    if si < 0 || sc <= 0 {
        var n: i32 = cc
        if button == CRA_RIGHT { n = 1 }
        put_slot(cl, inv, ws, ci, n, send)
        set_cursor(inv, ci, cc - n)
        return
    }
    if si == ci {
        let room: i32 = max_stack(reg, si) - sc
        var n: i32 = cc
        if button == CRA_RIGHT { n = 1 }
        if n > room { n = room }
        if n <= 0 { return }
        put_slot(cl, inv, ws, si, sc + n, send)
        set_cursor(inv, ci, cc - n)
        return
    }
    put_slot(cl, inv, ws, ci, cc, send)
    set_cursor(inv, si, sc)
}

fn cra_outside(cl: *mut mc_client.Client, inv: *mut mc_inv.Inv, button: i32, send: bool) {
    let ci: i32 = mc_inv.inv_cursor_item(inv)
    let cc: i32 = mc_inv.inv_cursor_count(inv)
    if ci < 0 { return }
    var n: i32 = cc
    if button == CRA_RIGHT { n = 1 }
    if send { mc_inv.inv_send_creative(cl, DROP_SLOT, ci, n) }
    set_cursor(inv, ci, cc - n)
}

fn cra_delete(cl: *mut mc_client.Client, inv: *mut mc_inv.Inv, shift: bool, send: bool) {
    if shift {
        var ws: i32 = 0
        while ws < INV_WINDOW_SLOTS {
            if mc_inv.inv_item(inv, ws) >= 0 { put_slot(cl, inv, ws, 0 - 1, 0, send) }
            ws = ws + 1
        }
        return
    }
    set_cursor(inv, 0 - 1, 0)
}

fn cra_key_swap(cl: *mut mc_client.Client, cr: *mut mc_creative.Creative, reg: *mut mc_registry.Registry, inv: *mut mc_inv.Inv, k: i32, hotbar: i32, send: bool) {
    let item: i32 = mc_creative.cr_item(cr, k)
    if item < 0 || hotbar < 0 || hotbar > 8 { return }
    put_slot(cl, inv, mc_inv.INV_HOTBAR0 + hotbar, item, max_stack(reg, item), send)
}

fn cra_drop_pick(cl: *mut mc_client.Client, cr: *mut mc_creative.Creative, reg: *mut mc_registry.Registry, k: i32, all: bool, send: bool) {
    let item: i32 = mc_creative.cr_item(cr, k)
    if item < 0 || !send { return }
    var n: i32 = 1
    if all { n = max_stack(reg, item) }
    mc_inv.inv_send_creative(cl, DROP_SLOT, item, n)
}
