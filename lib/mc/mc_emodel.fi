import std.rt
import std.str

export {
    EModels, emodels_new, emodels_free, emodels_build, emodel_find, emodel_find_name, emodel_count,
    mob_first, mob_parts, mob_kind, mob_layer_base, mob_width, mob_height, mob_hash,
    part_f, PW, MW,
    ROLE_NONE, ROLE_HEAD, ROLE_LEG_A, ROLE_LEG_B, ROLE_ARM_R, ROLE_ARM_L, ROLE_ZARM_R, ROLE_ZARM_L, ROLE_SPIDER_LEG, ROLE_WING_R, ROLE_WING_L,
    FLAG_DYE, FLAG_WOOL, SKIN_SIZE,
    P_PARENT, P_ROLE, P_U, P_V, P_OX, P_OY, P_OZ, P_W, P_H, P_D, P_INFLATE, P_PX, P_PY, P_PZ, P_RX, P_RY, P_RZ, P_MIRROR, P_LAYER, P_FLAGS,
}

const PW: usize = 20
const MW: usize = 8
const SKIN_SIZE: i32 = 64

const P_PARENT: usize = 0
const P_ROLE: usize = 1
const P_U: usize = 2
const P_V: usize = 3
const P_OX: usize = 4
const P_OY: usize = 5
const P_OZ: usize = 6
const P_W: usize = 7
const P_H: usize = 8
const P_D: usize = 9
const P_INFLATE: usize = 10
const P_PX: usize = 11
const P_PY: usize = 12
const P_PZ: usize = 13
const P_RX: usize = 14
const P_RY: usize = 15
const P_RZ: usize = 16
const P_MIRROR: usize = 17
const P_LAYER: usize = 18
const P_FLAGS: usize = 19

const ROLE_NONE: i32 = 0
const ROLE_HEAD: i32 = 1
const ROLE_LEG_A: i32 = 2
const ROLE_LEG_B: i32 = 3
const ROLE_ARM_R: i32 = 4
const ROLE_ARM_L: i32 = 5
const ROLE_ZARM_R: i32 = 6
const ROLE_ZARM_L: i32 = 7
const ROLE_WING_R: i32 = 8
const ROLE_WING_L: i32 = 9
const ROLE_SPIDER_LEG: i32 = 10

const FLAG_DYE: i32 = 1
const FLAG_WOOL: i32 = 2

const M_HASH: usize = 0
const M_FIRST: usize = 1
const M_COUNT: usize = 2
const M_KIND: usize = 3
const M_LAYER: usize = 4
const M_WIDTH: usize = 5
const M_HEIGHT: usize = 6

struct EModels {
    parts: rt.Buf,
    mobs: rt.Buf,
    cur: usize,
}

fn emodels_new() -> EModels {
    return EModels { parts: rt.buf_new(), mobs: rt.buf_new(), cur: 0 }
}

fn emodels_free(m: *mut EModels) {
    rt.buf_free(&(*m).parts)
    rt.buf_free(&(*m).mobs)
}

fn ldf(p: u64, i: usize) -> f64 {
    return *((p + (i as u64) * (8 as u64)) as *mut f64)
}

fn stf(p: u64, i: usize, v: f64) {
    *((p + (i as u64) * (8 as u64)) as *mut f64) = v
}

fn emodel_count(m: *mut EModels) -> i32 {
    return (rt.buf_len(&(*m).mobs) / (MW * 8)) as i32
}

fn part_f(m: *mut EModels, idx: usize, field: usize) -> f64 {
    return ldf(rt.buf_ptr(&(*m).parts), idx * PW + field)
}

fn mob_f(m: *mut EModels, mob: i32, field: usize) -> f64 {
    return ldf(rt.buf_ptr(&(*m).mobs), (mob as usize) * MW + field)
}

fn mob_first(m: *mut EModels, mob: i32) -> usize { return mob_f(m, mob, M_FIRST) as usize }
fn mob_parts(m: *mut EModels, mob: i32) -> usize { return mob_f(m, mob, M_COUNT) as usize }
fn mob_kind(m: *mut EModels, mob: i32) -> i32 { return mob_f(m, mob, M_KIND) as i32 }
fn mob_layer_base(m: *mut EModels, mob: i32) -> i32 { return mob_f(m, mob, M_LAYER) as i32 }
fn mob_width(m: *mut EModels, mob: i32) -> f64 { return mob_f(m, mob, M_WIDTH) }
fn mob_height(m: *mut EModels, mob: i32) -> f64 { return mob_f(m, mob, M_HEIGHT) }
fn mob_hash(m: *mut EModels, mob: i32) -> u64 { return mob_f(m, mob, M_HASH) as u64 }

fn name_hash(p: u64, n: usize) -> u64 {
    var h: u64 = 1469598103934665603
    var i: usize = 0
    while i < n {
        h = (h ^ (rt.ld8(p, i) as u64)) *% 1099511628211
        i = i + 1
    }
    return h & 0xFFFFFFFFFFFF as u64
}

fn emodel_find(m: *mut EModels, p: u64, n: usize) -> i32 {
    var q: u64 = p
    var len: usize = n
    if len > 10 && rt.mem_eq(p, "minecraft:".p as u64, 10) {
        q = p + 10 as u64
        len = len - 10
    }
    let h: u64 = name_hash(q, len)
    let cnt: i32 = emodel_count(m)
    var i: i32 = 0
    while i < cnt {
        if mob_hash(m, i) == h { return i }
        i = i + 1
    }
    return 0 - 1
}

fn emodel_find_name(m: *mut EModels, name: str) -> i32 {
    return emodel_find(m, name.p as u64, name.length())
}

fn mb_mob(m: *mut EModels, name: str, kind: i32, layer: i32, w: f64, h: f64) {
    var rec: [f64; 8] = [name_hash(name.p as u64, name.length()) as f64, (rt.buf_len(&(*m).parts) / (PW * 8)) as f64, 0.0, kind as f64, layer as f64, w, h, 0.0]
    rt.buf_push_bytes(&(*m).mobs, (&rec[0]) as u64, MW * 8)
}

fn mb_cur_mob(m: *mut EModels) -> usize {
    return rt.buf_len(&(*m).mobs) / (MW * 8) - 1
}

fn mb_part(m: *mut EModels, parent: i32, role: i32, layer: i32) -> i32 {
    var row: [f64; 20] = [0.0; 20]
    row[P_PARENT] = parent as f64
    row[P_ROLE] = role as f64
    row[P_LAYER] = layer as f64
    rt.buf_push_bytes(&(*m).parts, (&row[0]) as u64, PW * 8)
    let total: usize = rt.buf_len(&(*m).parts) / (PW * 8)
    let mi: usize = mb_cur_mob(m)
    let first: usize = ldf(rt.buf_ptr(&(*m).mobs), mi * MW + M_FIRST) as usize
    stf(rt.buf_ptr(&(*m).mobs), mi * MW + M_COUNT, (total - first) as f64)
    (*m).cur = total - 1
    return ((total - first) - 1) as i32
}

fn mb_set(m: *mut EModels, field: usize, v: f64) {
    stf(rt.buf_ptr(&(*m).parts), (*m).cur * PW + field, v)
}

fn mb_box(m: *mut EModels, u: i32, v: i32, ox: f64, oy: f64, oz: f64, w: f64, h: f64, d: f64) {
    mb_set(m, P_U, u as f64)
    mb_set(m, P_V, v as f64)
    mb_set(m, P_OX, ox)
    mb_set(m, P_OY, oy)
    mb_set(m, P_OZ, oz)
    mb_set(m, P_W, w)
    mb_set(m, P_H, h)
    mb_set(m, P_D, d)
}

fn mb_pivot(m: *mut EModels, x: f64, y: f64, z: f64) {
    mb_set(m, P_PX, x)
    mb_set(m, P_PY, y)
    mb_set(m, P_PZ, z)
}

fn mb_rot(m: *mut EModels, x: f64, y: f64, z: f64) {
    mb_set(m, P_RX, x)
    mb_set(m, P_RY, y)
    mb_set(m, P_RZ, z)
}

fn mb_inflate(m: *mut EModels, v: f64) { mb_set(m, P_INFLATE, v) }
fn mb_mirror(m: *mut EModels) { mb_set(m, P_MIRROR, 1.0) }
fn mb_flags(m: *mut EModels, f: i32) { mb_set(m, P_FLAGS, f as f64) }

const HALF_PI: f64 = 1.5707963267948966

fn def_humanoid(m: *mut EModels, name: str, layer: i32, slim: bool, zombie: bool, w: f64, h: f64) {
    mb_mob(m, name, 1, layer, w, h)
    let head: i32 = mb_part(m, 0 - 1, ROLE_HEAD, 0)
    mb_box(m, 0, 0, 0.0 - 4.0, 0.0 - 8.0, 0.0 - 4.0, 8.0, 8.0, 8.0)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 16, 16, 0.0 - 4.0, 0.0, 0.0 - 2.0, 8.0, 12.0, 4.0)
    var aw: f64 = 4.0
    var ax: f64 = 0.0 - 3.0
    var alx: f64 = 0.0 - 1.0
    if slim {
        aw = 2.0
        ax = 0.0 - 1.0
        alx = 0.0 - 1.0
    }
    var rr: i32 = ROLE_ARM_R
    var rl: i32 = ROLE_ARM_L
    if zombie {
        rr = ROLE_ZARM_R
        rl = ROLE_ZARM_L
    }
    mb_part(m, 0 - 1, rr, 0)
    mb_box(m, 40, 16, ax, 0.0 - 2.0, 0.0 - 2.0 + (4.0 - aw) * 0.5, aw, 12.0, aw)
    mb_pivot(m, 0.0 - 5.0, 2.0, 0.0)
    mb_part(m, 0 - 1, rl, 0)
    mb_box(m, 40, 16, alx, 0.0 - 2.0, 0.0 - 2.0 + (4.0 - aw) * 0.5, aw, 12.0, aw)
    mb_pivot(m, 5.0, 2.0, 0.0)
    mb_mirror(m)
    var lw: f64 = 4.0
    var lo: f64 = 0.0 - 2.0
    var lx: f64 = 1.9
    if slim {
        lw = 2.0
        lo = 0.0 - 1.0
        lx = 2.0
    }
    mb_part(m, 0 - 1, ROLE_LEG_A, 0)
    mb_box(m, 0, 16, lo, 0.0, lo, lw, 12.0, lw)
    mb_pivot(m, 0.0 - lx, 12.0, 0.0)
    mb_part(m, 0 - 1, ROLE_LEG_B, 0)
    mb_box(m, 0, 16, lo, 0.0, lo, lw, 12.0, lw)
    mb_pivot(m, lx, 12.0, 0.0)
    mb_mirror(m)
}

fn def_creeper(m: *mut EModels) {
    mb_mob(m, "creeper", 2, 2, 0.6, 1.7)
    mb_part(m, 0 - 1, ROLE_HEAD, 0)
    mb_box(m, 0, 0, 0.0 - 4.0, 0.0 - 8.0, 0.0 - 4.0, 8.0, 8.0, 8.0)
    mb_pivot(m, 0.0, 6.0, 0.0)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 16, 16, 0.0 - 4.0, 0.0, 0.0 - 2.0, 8.0, 12.0, 4.0)
    mb_pivot(m, 0.0, 6.0, 0.0)
    def_leg(m, ROLE_LEG_A, 0, 16, 0.0 - 2.0, 18.0, 4.0, 4.0, 6.0, false)
    def_leg(m, ROLE_LEG_B, 0, 16, 2.0, 18.0, 4.0, 4.0, 6.0, false)
    def_leg(m, ROLE_LEG_B, 0, 16, 0.0 - 2.0, 18.0, 0.0 - 4.0, 4.0, 6.0, false)
    def_leg(m, ROLE_LEG_A, 0, 16, 2.0, 18.0, 0.0 - 4.0, 4.0, 6.0, false)
}

fn def_leg(m: *mut EModels, role: i32, u: i32, v: i32, px: f64, py: f64, pz: f64, w: f64, h: f64, mirror: bool) {
    mb_part(m, 0 - 1, role, 0)
    mb_box(m, u, v, 0.0 - w * 0.5, 0.0, 0.0 - w * 0.5, w, h, w)
    mb_pivot(m, px, py, pz)
    if mirror { mb_mirror(m) }
}

fn def_quad_legs(m: *mut EModels, layer: i32, h: f64, hx: f64, py: f64, hz: f64, fz: f64, u: i32, v: i32, flags: i32, inflate: f64) {
    var i: i32 = 0
    while i < 4 {
        var role: i32 = ROLE_LEG_A
        if i == 1 || i == 2 { role = ROLE_LEG_B }
        var px: f64 = 0.0 - hx
        if i == 1 || i == 3 { px = hx }
        var pz: f64 = hz
        if i >= 2 { pz = fz }
        mb_part(m, 0 - 1, role, layer)
        mb_box(m, u, v, 0.0 - 2.0, 0.0, 0.0 - 2.0, 4.0, h, 4.0)
        mb_pivot(m, px, py, pz)
        if inflate > 0.0 { mb_inflate(m, inflate) }
        mb_flags(m, flags)
        i = i + 1
    }
}

fn def_pig(m: *mut EModels) {
    mb_mob(m, "pig", 3, 3, 0.9, 0.9)
    let head: i32 = mb_part(m, 0 - 1, ROLE_HEAD, 0)
    mb_box(m, 0, 0, 0.0 - 4.0, 0.0 - 4.0, 0.0 - 8.0, 8.0, 8.0, 8.0)
    mb_pivot(m, 0.0, 12.0, 0.0 - 6.0)
    mb_part(m, head, ROLE_NONE, 0)
    mb_box(m, 16, 16, 0.0 - 2.0, 0.0, 0.0 - 9.0, 4.0, 3.0, 1.0)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 28, 8, 0.0 - 5.0, 0.0 - 10.0, 0.0 - 7.0, 10.0, 16.0, 8.0)
    mb_pivot(m, 0.0, 11.0, 2.0)
    mb_rot(m, HALF_PI, 0.0, 0.0)
    def_quad_legs(m, 0, 6.0, 3.0, 18.0, 7.0, 0.0 - 5.0, 0, 16, 0, 0.0)
}

fn def_cow(m: *mut EModels) {
    mb_mob(m, "cow", 3, 4, 0.9, 1.4)
    let head: i32 = mb_part(m, 0 - 1, ROLE_HEAD, 0)
    mb_box(m, 0, 0, 0.0 - 4.0, 0.0 - 4.0, 0.0 - 6.0, 8.0, 8.0, 6.0)
    mb_pivot(m, 0.0, 4.0, 0.0 - 8.0)
    mb_part(m, head, ROLE_NONE, 0)
    mb_box(m, 22, 0, 0.0 - 5.0, 0.0 - 5.0, 0.0 - 5.0, 1.0, 3.0, 1.0)
    mb_part(m, head, ROLE_NONE, 0)
    mb_box(m, 22, 0, 4.0, 0.0 - 5.0, 0.0 - 5.0, 1.0, 3.0, 1.0)
    mb_mirror(m)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 18, 4, 0.0 - 6.0, 0.0 - 10.0, 0.0 - 7.0, 12.0, 18.0, 10.0)
    mb_pivot(m, 0.0, 5.0, 2.0)
    mb_rot(m, HALF_PI, 0.0, 0.0)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 52, 0, 0.0 - 2.0, 2.0, 0.0 - 8.0, 4.0, 6.0, 1.0)
    mb_pivot(m, 0.0, 5.0, 2.0)
    mb_rot(m, HALF_PI, 0.0, 0.0)
    def_quad_legs(m, 0, 12.0, 4.0, 12.0, 7.0, 0.0 - 6.0, 0, 16, 0, 0.0)
}

fn def_sheep(m: *mut EModels) {
    mb_mob(m, "sheep", 3, 5, 0.9, 1.3)
    let head: i32 = mb_part(m, 0 - 1, ROLE_HEAD, 0)
    mb_box(m, 0, 0, 0.0 - 3.0, 0.0 - 4.0, 0.0 - 6.0, 6.0, 6.0, 8.0)
    mb_pivot(m, 0.0, 6.0, 0.0 - 8.0)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 28, 8, 0.0 - 4.0, 0.0 - 10.0, 0.0 - 7.0, 8.0, 16.0, 6.0)
    mb_pivot(m, 0.0, 5.0, 2.0)
    mb_rot(m, HALF_PI, 0.0, 0.0)
    def_quad_legs(m, 0, 12.0, 3.0, 12.0, 7.0, 0.0 - 5.0, 0, 16, 0, 0.0)
    let wh: i32 = mb_part(m, 0 - 1, ROLE_HEAD, 1)
    mb_box(m, 0, 0, 0.0 - 3.0, 0.0 - 4.0, 0.0 - 4.0, 6.0, 6.0, 6.0)
    mb_pivot(m, 0.0, 6.0, 0.0 - 8.0)
    mb_inflate(m, 0.6)
    mb_flags(m, FLAG_DYE | FLAG_WOOL)
    mb_part(m, 0 - 1, ROLE_NONE, 1)
    mb_box(m, 28, 8, 0.0 - 4.0, 0.0 - 10.0, 0.0 - 7.0, 8.0, 16.0, 6.0)
    mb_pivot(m, 0.0, 5.0, 2.0)
    mb_rot(m, HALF_PI, 0.0, 0.0)
    mb_inflate(m, 1.75)
    mb_flags(m, FLAG_DYE | FLAG_WOOL)
    def_quad_legs(m, 1, 6.0, 3.0, 12.0, 7.0, 0.0 - 5.0, 0, 16, FLAG_DYE | FLAG_WOOL, 0.5)
}

fn def_chicken(m: *mut EModels) {
    mb_mob(m, "chicken", 4, 7, 0.4, 0.7)
    let head: i32 = mb_part(m, 0 - 1, ROLE_HEAD, 0)
    mb_box(m, 0, 0, 0.0 - 2.0, 0.0 - 6.0, 0.0 - 2.0, 4.0, 6.0, 3.0)
    mb_pivot(m, 0.0, 15.0, 0.0 - 4.0)
    mb_part(m, head, ROLE_NONE, 0)
    mb_box(m, 14, 0, 0.0 - 2.0, 0.0 - 4.0, 0.0 - 4.0, 4.0, 2.0, 2.0)
    mb_part(m, head, ROLE_NONE, 0)
    mb_box(m, 14, 4, 0.0 - 1.0, 0.0 - 2.0, 0.0 - 3.0, 2.0, 2.0, 2.0)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 0, 9, 0.0 - 3.0, 0.0 - 4.0, 0.0 - 3.0, 6.0, 8.0, 6.0)
    mb_pivot(m, 0.0, 16.0, 0.0)
    mb_rot(m, HALF_PI, 0.0, 0.0)
    mb_part(m, 0 - 1, ROLE_LEG_A, 0)
    mb_box(m, 26, 0, 0.0 - 1.0, 0.0, 0.0 - 3.0, 3.0, 5.0, 3.0)
    mb_pivot(m, 0.0 - 2.0, 19.0, 1.0)
    mb_part(m, 0 - 1, ROLE_LEG_B, 0)
    mb_box(m, 26, 0, 0.0 - 1.0, 0.0, 0.0 - 3.0, 3.0, 5.0, 3.0)
    mb_pivot(m, 1.0, 19.0, 1.0)
    mb_part(m, 0 - 1, ROLE_WING_R, 0)
    mb_box(m, 24, 13, 0.0, 0.0, 0.0 - 3.0, 1.0, 4.0, 6.0)
    mb_pivot(m, 0.0 - 4.0, 13.0, 0.0)
    mb_part(m, 0 - 1, ROLE_WING_L, 0)
    mb_box(m, 24, 13, 0.0 - 1.0, 0.0, 0.0 - 3.0, 1.0, 4.0, 6.0)
    mb_pivot(m, 4.0, 13.0, 0.0)
}

fn def_villager(m: *mut EModels) {
    mb_mob(m, "villager", 5, 8, 0.6, 1.95)
    let head: i32 = mb_part(m, 0 - 1, ROLE_HEAD, 0)
    mb_box(m, 0, 0, 0.0 - 4.0, 0.0 - 10.0, 0.0 - 4.0, 8.0, 10.0, 8.0)
    mb_part(m, head, ROLE_NONE, 0)
    mb_box(m, 24, 0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 6.0, 2.0, 4.0, 2.0)
    mb_pivot(m, 0.0, 0.0 - 2.0, 0.0)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 16, 20, 0.0 - 4.0, 0.0, 0.0 - 3.0, 8.0, 12.0, 6.0)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 0, 38, 0.0 - 4.0, 0.0, 0.0 - 3.0, 8.0, 18.0, 6.0)
    mb_inflate(m, 0.5)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 44, 22, 0.0 - 8.0, 0.0 - 2.0, 0.0 - 2.0, 4.0, 8.0, 4.0)
    mb_pivot(m, 0.0, 3.0, 0.0 - 1.0)
    mb_rot(m, 0.0 - 0.75, 0.0, 0.0)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 44, 22, 4.0, 0.0 - 2.0, 0.0 - 2.0, 4.0, 8.0, 4.0)
    mb_pivot(m, 0.0, 3.0, 0.0 - 1.0)
    mb_rot(m, 0.0 - 0.75, 0.0, 0.0)
    mb_mirror(m)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 40, 38, 0.0 - 4.0, 2.0, 0.0 - 2.0, 8.0, 4.0, 4.0)
    mb_pivot(m, 0.0, 3.0, 0.0 - 1.0)
    mb_rot(m, 0.0 - 0.75, 0.0, 0.0)
    mb_part(m, 0 - 1, ROLE_LEG_A, 0)
    mb_box(m, 0, 22, 0.0 - 2.0, 0.0, 0.0 - 2.0, 4.0, 12.0, 4.0)
    mb_pivot(m, 0.0 - 2.0, 12.0, 0.0)
    mb_part(m, 0 - 1, ROLE_LEG_B, 0)
    mb_box(m, 0, 22, 0.0 - 2.0, 0.0, 0.0 - 2.0, 4.0, 12.0, 4.0)
    mb_pivot(m, 2.0, 12.0, 0.0)
    mb_mirror(m)
}

fn spider_ry(i: i32) -> f64 {
    let q: f64 = 0.7853982
    let e: f64 = 0.3926991
    if i == 0 || i == 7 { return q }
    if i == 1 || i == 6 { return 0.0 - q }
    if i == 2 || i == 5 { return e }
    return 0.0 - e
}

fn spider_rz(i: i32) -> f64 {
    let q: f64 = 0.7853982
    let w: f64 = 0.58119464
    if i == 1 || i == 7 { return q }
    if i == 0 || i == 6 { return 0.0 - q }
    if i % 2 == 0 { return 0.0 - w }
    return w
}

fn def_spider(m: *mut EModels) {
    mb_mob(m, "spider", 6, 9, 1.4, 0.9)
    mb_part(m, 0 - 1, ROLE_HEAD, 0)
    mb_box(m, 32, 4, 0.0 - 4.0, 0.0 - 4.0, 0.0 - 8.0, 8.0, 8.0, 8.0)
    mb_pivot(m, 0.0, 15.0, 0.0 - 3.0)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 0, 0, 0.0 - 3.0, 0.0 - 3.0, 0.0 - 3.0, 6.0, 6.0, 6.0)
    mb_pivot(m, 0.0, 15.0, 0.0)
    mb_part(m, 0 - 1, ROLE_NONE, 0)
    mb_box(m, 0, 12, 0.0 - 5.0, 0.0 - 4.0, 0.0 - 6.0, 10.0, 8.0, 12.0)
    mb_pivot(m, 0.0, 15.0, 9.0)
    var i: i32 = 0
    while i < 8 {
        let right: bool = i % 2 == 0
        mb_part(m, 0 - 1, ROLE_SPIDER_LEG + i, 0)
        if right {
            mb_box(m, 18, 0, 0.0 - 15.0, 0.0 - 1.0, 0.0 - 1.0, 16.0, 2.0, 2.0)
            mb_pivot(m, 0.0 - 4.0, 15.0, 2.0 - ((i / 2) as f64))
        } else {
            mb_box(m, 18, 0, 0.0 - 1.0, 0.0 - 1.0, 0.0 - 1.0, 16.0, 2.0, 2.0)
            mb_pivot(m, 4.0, 15.0, 2.0 - ((i / 2) as f64))
        }
        mb_rot(m, 0.0, spider_ry(i), spider_rz(i))
        i = i + 1
    }
}

fn emodels_build() -> EModels {
    var m: EModels = emodels_new()
    def_humanoid(&m, "zombie", 0, false, true, 0.6, 1.95)
    def_humanoid(&m, "skeleton", 1, true, false, 0.6, 1.99)
    def_creeper(&m)
    def_pig(&m)
    def_cow(&m)
    def_sheep(&m)
    def_chicken(&m)
    def_villager(&m)
    def_spider(&m)
    return m
}
