import std.rt
import mc.mc_raster
import mc.mc_gui_tex
import mc.mc_item_src

export {
    ContProg, cprog_new, cprog_free, cprog_open, cprog_has, cprog_draw_lit, cprog_draw_burn,
    PROG_FURNACE, PROG_BLAST, PROG_SMOKER, PROG_COUNT,
}

const PROG_FURNACE: i32 = 0
const PROG_BLAST: i32 = 1
const PROG_SMOKER: i32 = 2
const PROG_COUNT: i32 = 3
const LIT_X: i32 = 56
const LIT_Y: i32 = 36
const BURN_X: i32 = 79
const BURN_Y: i32 = 34
const LIT_SIZE: i32 = 14
const BURN_W: i32 = 24
const BURN_H: i32 = 16
const WHITE: u32 = 0xFFFFFFFF

struct ContProg {
    lit: [mc_gui_tex.GuiTex; 3],
    burn: [mc_gui_tex.GuiTex; 3],
}

fn cprog_new() -> ContProg {
    return ContProg { lit: [mc_gui_tex.gtex_empty(); 3], burn: [mc_gui_tex.gtex_empty(); 3] }
}

fn cprog_free(p: *mut ContProg) {
    var k: i32 = 0
    while k < PROG_COUNT {
        mc_gui_tex.gtex_free(&(*p).lit[k as usize])
        mc_gui_tex.gtex_free(&(*p).burn[k as usize])
        k = k + 1
    }
}

fn dir_name(k: i32) -> str {
    if k == PROG_BLAST { return "blast_furnace" }
    if k == PROG_SMOKER { return "smoker" }
    return "furnace"
}

fn load_sprite(src: *mut mc_item_src.ItemSrc, dir: str, name: str, out: *mut mc_gui_tex.GuiTex) -> bool {
    var b: rt.Buf = rt.buf_new()
    let prefix: str = "assets/minecraft/textures/gui/sprites/container/"
    rt.buf_push_bytes(&b, prefix.p as u64, prefix.length())
    rt.buf_push_bytes(&b, dir.p as u64, dir.length())
    rt.buf_push_bytes(&b, "/".p as u64, 1)
    rt.buf_push_bytes(&b, name.p as u64, name.length())
    rt.buf_push_bytes(&b, ".png".p as u64, 4)
    let ok: bool = mc_item_src.isrc_tex_full(src, rt.buf_ptr(&b), rt.buf_len(&b), out)
    rt.buf_free(&b)
    return ok
}

fn cprog_open(p: *mut ContProg, src: *mut mc_item_src.ItemSrc) -> bool {
    var any: bool = false
    var k: i32 = 0
    while k < PROG_COUNT {
        let dir: str = dir_name(k)
        let a: bool = load_sprite(src, dir, "lit_progress", &(*p).lit[k as usize])
        let b: bool = load_sprite(src, dir, "burn_progress", &(*p).burn[k as usize])
        if a && b { any = true }
        k = k + 1
    }
    return any
}

fn cprog_has(p: *mut ContProg, k: i32) -> bool {
    if k < 0 || k >= PROG_COUNT { return false }
    return mc_gui_tex.gtex_ok(&(*p).lit[k as usize]) && mc_gui_tex.gtex_ok(&(*p).burn[k as usize])
}

fn cprog_draw_lit(r: *mut mc_raster.Raster, p: *mut ContProg, k: i32, px: i32, py: i32, s: i32, lit: i32, duration: i32) {
    if !cprog_has(p, k) || lit <= 0 { return }
    var dur: i32 = duration
    if dur == 0 { dur = 200 }
    var rows: i32 = (lit * 13 + dur - 1) / dur + 1
    if rows > LIT_SIZE { rows = LIT_SIZE }
    let t: *mut mc_gui_tex.GuiTex = &(*p).lit[k as usize]
    let top: i32 = LIT_SIZE - rows
    mc_gui_tex.gtex_draw(r, t, px + LIT_X * s, py + (LIT_Y + top) * s, LIT_SIZE * s, rows * s, 0, top, LIT_SIZE, rows, WHITE)
}

fn cprog_draw_burn(r: *mut mc_raster.Raster, p: *mut ContProg, k: i32, px: i32, py: i32, s: i32, cook: i32, total: i32) {
    if !cprog_has(p, k) || total <= 0 || cook <= 0 { return }
    var w: i32 = (cook * BURN_W + total - 1) / total
    if w > BURN_W { w = BURN_W }
    let t: *mut mc_gui_tex.GuiTex = &(*p).burn[k as usize]
    mc_gui_tex.gtex_draw(r, t, px + BURN_X * s, py + BURN_Y * s, w * s, BURN_H * s, 0, 0, w, BURN_H, WHITE)
}
