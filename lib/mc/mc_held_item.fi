import std.rt
import mc.mc_vox
import mc.mc_gui_tex
import mc.mc_item_icon
import mc.mc_item_name
import mc.mc_registry
import mc.mc_combat

export {
    Held, held_new, held_free, held_update, held_kind, held_item, held_scale, held_cubes,
    HELD_NONE, HELD_SPRITE, HELD_BLOCK, HELD_TOOL, HELD_SHIELD,
}

const HELD_NONE: i32 = 0
const HELD_SPRITE: i32 = 1
const HELD_BLOCK: i32 = 2
const HELD_TOOL: i32 = 3
const HELD_SHIELD: i32 = 4
const GRID: i32 = 8
const CUBE: u32 = 1040
const BLOCK_CUBE: u32 = 2080

struct Held {
    item: i32,
    kind: i32,
    cubes: mc_vox.CubeList,
}

fn held_new() -> Held {
    return Held { item: 0 - 2, kind: HELD_NONE, cubes: mc_vox.cl_new() }
}

fn held_free(h: *mut Held) {
    mc_vox.cl_free(&(*h).cubes)
}

fn held_kind(h: *mut Held) -> i32 { return (*h).kind }

fn held_item(h: *mut Held) -> i32 { return (*h).item }

fn held_cubes(h: *mut Held) -> *mut mc_vox.CubeList { return &(*h).cubes }

fn held_scale(kind: i32) -> f64 {
    if kind == HELD_BLOCK { return 0.4 }
    if kind == HELD_TOOL { return 0.9 }
    if kind == HELD_SHIELD { return 0.8 }
    return 0.7
}

fn is_tool(p: u64, n: usize) -> bool {
    return mc_item_name.name_has(p, n, "_sword") || mc_item_name.name_has(p, n, "_pickaxe") || mc_item_name.name_has(p, n, "_axe")
    || mc_item_name.name_has(p, n, "_shovel") || mc_item_name.name_has(p, n, "_hoe") || mc_item_name.name_is(p, n, "stick")
    || mc_item_name.name_is(p, n, "trident") || mc_item_name.name_is(p, n, "bow") || mc_item_name.name_has(p, n, "fishing_rod")
}

fn shade(c: u32, k: u32) -> u32 {
    let r: u32 = ((c & 255 as u32) * k) / 100 as u32
    let g: u32 = (((c >> 8 as u32) & 255 as u32) * k) / 100 as u32
    let b: u32 = (((c >> 16 as u32) & 255 as u32) * k) / 100 as u32
    return 0xFF000000 as u32 | (b << 16 as u32) | (g << 8 as u32) | r
}

fn build_sprite(cl: *mut mc_vox.CubeList, t: *mut mc_gui_tex.GuiTex) {
    var j: i32 = 0
    while j < (*t).h {
        var i: i32 = 0
        while i < (*t).w {
            let c: u32 = mc_gui_tex.gtex_get(t, i, j)
            if (c >> 24 as u32) >= 128 as u32 {
                mc_vox.cl_add(cl, (i as f64) + 0.5 - ((*t).w as f64) * 0.5, ((*t).h as f64) * 0.5 - 0.5 - (j as f64), 0.0, mc_vox.rgb_of(c), CUBE)
            }
            i = i + 1
        }
        j = j + 1
    }
}

fn icon_at(t: *mut mc_gui_tex.GuiTex, x: f64, y: f64) -> u32 {
    var c: u32 = mc_gui_tex.gtex_get(t, x as i32, y as i32)
    if (c >> 24 as u32) < 128 as u32 { c = mc_gui_tex.gtex_get(t, 8, 8) }
    return c
}

fn block_color(t: *mut mc_gui_tex.GuiTex, ix: i32, iy: i32, iz: i32) -> u32 {
    let n: f64 = GRID as f64
    let fx: f64 = ((ix as f64) + 0.5) / n
    let fz: f64 = ((iz as f64) + 0.5) / n
    let fy: f64 = (((GRID - 1 - iy) as f64) + 0.5) / n
    if iy == GRID - 1 { return icon_at(t, 8.0 + (fx - fz) * 7.0, 1.0 + (fx + fz) * 3.5) }
    if iz == GRID - 1 { return icon_at(t, 1.0 + fx * 7.0, 4.5 + fx * 3.5 + fy * 7.0) }
    if ix == GRID - 1 { return icon_at(t, 8.0 + (1.0 - fz) * 7.0, 8.0 - (1.0 - fz) * 3.5 + fy * 7.0) }
    if iy == 0 { return shade(icon_at(t, 8.0 + (fx - fz) * 7.0, 1.0 + (fx + fz) * 3.5), 60 as u32) }
    if iz == 0 { return shade(icon_at(t, 1.0 + fx * 7.0, 4.5 + fx * 3.5 + fy * 7.0), 80 as u32) }
    return shade(icon_at(t, 8.0 + (1.0 - fz) * 7.0, 8.0 - (1.0 - fz) * 3.5 + fy * 7.0), 80 as u32)
}

fn build_block(cl: *mut mc_vox.CubeList, t: *mut mc_gui_tex.GuiTex) {
    var ix: i32 = 0
    while ix < GRID {
        var iy: i32 = 0
        while iy < GRID {
            var iz: i32 = 0
            while iz < GRID {
                if ix == 0 || ix == GRID - 1 || iy == 0 || iy == GRID - 1 || iz == 0 || iz == GRID - 1 {
                    let c: u32 = block_color(t, ix, iy, iz)
                    mc_vox.cl_add(cl, ((ix as f64) + 0.5 - 4.0) * 2.0, ((iy as f64) + 0.5 - 4.0) * 2.0, ((iz as f64) + 0.5 - 4.0) * 2.0, mc_vox.rgb_of(c), BLOCK_CUBE)
                }
                iz = iz + 1
            }
            iy = iy + 1
        }
        ix = ix + 1
    }
}

fn pack(r: u32, g: u32, b: u32) -> u32 { return (b << 16 as u32) | (g << 8 as u32) | r }

fn build_shield(cl: *mut mc_vox.CubeList) {
    var j: i32 = 0
    while j < 18 {
        var i: i32 = 0
        while i < 12 {
            var c: u32 = pack(140 as u32, 100 as u32, 60 as u32)
            if i == 0 || i == 11 || j == 0 || j == 17 { c = pack(80 as u32, 80 as u32, 85 as u32) }
            if i == 5 || i == 6 { c = pack(170 as u32, 40 as u32, 40 as u32) }
            mc_vox.cl_add(cl, (i as f64) + 0.5 - 6.0, 9.0 - 0.5 - (j as f64), 0.0, c, CUBE)
            i = i + 1
        }
        j = j + 1
    }
}

fn build_fallback(cl: *mut mc_vox.CubeList, as_block: bool) {
    if !as_block {
        var j: i32 = 5
        while j < 11 {
            var i: i32 = 5
            while i < 11 {
                mc_vox.cl_add(cl, (i as f64) + 0.5 - 8.0, 8.0 - 0.5 - (j as f64), 0.0, pack(150 as u32, 150 as u32, 150 as u32), CUBE)
                i = i + 1
            }
            j = j + 1
        }
        return
    }
    var ix: i32 = 0
    while ix < GRID {
        var iy: i32 = 0
        while iy < GRID {
            var iz: i32 = 0
            while iz < GRID {
                if ix == 0 || ix == GRID - 1 || iy == 0 || iy == GRID - 1 || iz == 0 || iz == GRID - 1 {
                    mc_vox.cl_add(cl, ((ix as f64) + 0.5 - 4.0) * 2.0, ((iy as f64) + 0.5 - 4.0) * 2.0, ((iz as f64) + 0.5 - 4.0) * 2.0, pack(130 as u32, 130 as u32, 130 as u32), BLOCK_CUBE)
                }
                iz = iz + 1
            }
            iy = iy + 1
        }
        ix = ix + 1
    }
}

fn opaque_at(t: *mut mc_gui_tex.GuiTex, x: i32, y: i32) -> bool {
    return (mc_gui_tex.gtex_get(t, x, y) >> 24 as u32) >= 128 as u32
}

fn iso_icon(t: *mut mc_gui_tex.GuiTex) -> bool {
    return opaque_at(t, 8, 2) && opaque_at(t, 3, 6) && opaque_at(t, 12, 6) && opaque_at(t, 4, 11) && opaque_at(t, 11, 11) && opaque_at(t, 8, 13)
}

fn held_update(h: *mut Held, ic: *mut mc_item_icon.IconCache, reg: *mut mc_registry.Registry, item: i32) {
    if (*h).item == item { return }
    (*h).item = item
    (*h).kind = HELD_NONE
    mc_vox.cl_clear(&(*h).cubes)
    if item < 0 || (reg as u64) == 0 as u64 { return }
    var n: usize = 0
    let p: u64 = mc_registry.reg_item_name(reg, item, &n)
    if p == 0 as u64 { return }
    if mc_item_name.name_is(p, n, "shield") {
        build_shield(&(*h).cubes)
        (*h).kind = HELD_SHIELD
        return
    }
    let is_block: bool = mc_combat.held_is_block(reg, item)
    let t: *mut mc_gui_tex.GuiTex = mc_item_icon.icons_get(ic, reg, item, 1)
    if (t as u64) == 0 as u64 || (*t).w != 16 || (*t).h != 16 {
        build_fallback(&(*h).cubes, is_block)
        if is_block { (*h).kind = HELD_BLOCK } else { (*h).kind = HELD_SPRITE }
        return
    }
    if is_block && iso_icon(t) {
        build_block(&(*h).cubes, t)
        (*h).kind = HELD_BLOCK
        return
    }
    build_sprite(&(*h).cubes, t)
    if is_tool(p, n) { (*h).kind = HELD_TOOL } else { (*h).kind = HELD_SPRITE }
}
