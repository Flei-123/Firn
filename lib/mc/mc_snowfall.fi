import std.math
import mc.mc_registry
import mc.mc_world
import mc.mc_precip

export {
    Snowfall, snowfall_new, snowfall_reset, snowfall_update, snowfall_live, snowfall_age_ms,
    snowfall_x, snowfall_y, snowfall_z,
    SNOW_MAX, SNOW_RADIUS, SNOW_FALL_HEIGHT, SNOW_SPEED_MM,
}

const SNOW_MAX: usize = 256
const SNOW_RADIUS: i32 = 10
const SNOW_FALL_HEIGHT: i32 = 8
const SNOW_SPEED_MM: i64 = 1400 as i64
const RATE_PER_SEC: i64 = 80 as i64
const DT_CAP_MS: u64 = 250 as u64
const MAX_SPAWNS_PER_UPDATE: i32 = 24
const SCAN_UP: i32 = 24
const SCAN_DEPTH: i32 = 48
const MILLI: i64 = 1000 as i64
const SEED: u64 = 0xD1B54A32D192ED03 as u64
const SWAY_AMP: f64 = 0.35
const SWAY_RATE: f64 = 1.7
const LAND_LINGER_MS: u64 = 250 as u64

struct Snowfall {
    x: [f64; 256],
    y: [f64; 256],
    z: [f64; 256],
    ground: [f64; 256],
    phase: [f64; 256],
    born: [u64; 256],
    head: usize,
    rng: u64,
    acc: i64,
    last_ms: u64,
    n_spawned: u64,
}

fn snowfall_new() -> Snowfall {
    return Snowfall { x: [0.0; 256], y: [0.0; 256], z: [0.0; 256], ground: [0.0; 256], phase: [0.0; 256], born: [0 as u64; 256], head: 0, rng: SEED, acc: 0 as i64, last_ms: 0 as u64, n_spawned: 0 as u64 }
}

fn snowfall_reset(s: *mut Snowfall) {
    var i: usize = 0
    while i < SNOW_MAX {
        (*s).born[i] = 0 as u64
        i = i + 1
    }
    (*s).acc = 0 as i64
    (*s).last_ms = 0 as u64
}

fn next_rand(s: *mut Snowfall) -> u64 {
    var v: u64 = (*s).rng
    v = v ^ (v << 13 as u64)
    v = v ^ (v >> 7 as u64)
    v = v ^ (v << 17 as u64)
    (*s).rng = v
    return v
}

fn fall_ms(s: *mut Snowfall, i: usize) -> u64 {
    let drop: f64 = (*s).y[i] - (*s).ground[i]
    return ((drop * 1000000.0) / (SNOW_SPEED_MM as f64)) as u64
}

fn snowfall_age_ms(s: *mut Snowfall, i: usize, now_ms: u64) -> i32 {
    if (*s).born[i] == 0 as u64 { return 0 - 1 }
    if now_ms < (*s).born[i] { return 0 }
    let age: u64 = now_ms - (*s).born[i]
    if age >= fall_ms(s, i) + LAND_LINGER_MS { return 0 - 1 }
    return age as i32
}

fn snowfall_live(s: *mut Snowfall, now_ms: u64) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < SNOW_MAX {
        if snowfall_age_ms(s, i, now_ms) >= 0 { n = n + 1 }
        i = i + 1
    }
    return n
}

fn sway_arg(s: *mut Snowfall, i: usize, age_ms: i32) -> f64 {
    return (*s).phase[i] + SWAY_RATE * (age_ms as f64) / 1000.0
}

fn snowfall_x(s: *mut Snowfall, i: usize, age_ms: i32) -> f64 {
    return (*s).x[i] + SWAY_AMP * math.sin(sway_arg(s, i, age_ms))
}

fn snowfall_z(s: *mut Snowfall, i: usize, age_ms: i32) -> f64 {
    return (*s).z[i] + SWAY_AMP * math.cos(sway_arg(s, i, age_ms) * 0.8)
}

fn snowfall_y(s: *mut Snowfall, i: usize, age_ms: i32) -> f64 {
    let y: f64 = (*s).y[i] - ((SNOW_SPEED_MM as f64) * (age_ms as f64)) / 1000000.0
    if y < (*s).ground[i] { return (*s).ground[i] }
    return y
}

fn spawn_one(s: *mut Snowfall, p: *mut mc_precip.Precip, w: *mut mc_world.World, reg: *mut mc_registry.Registry, min_y: i32,
    bx: i32, by: i32, bz: i32, now_ms: u64) {
    let r: u64 = next_rand(s)
    let span: u64 = (SNOW_RADIUS * 2 + 1) as u64
    let dx: i32 = ((r % span) as i32) - SNOW_RADIUS
    let dz: i32 = (((r >> 16 as u64) % span) as i32) - SNOW_RADIUS
    if dx * dx + dz * dz > SNOW_RADIUS * SNOW_RADIUS { return }
    let sy: i32 = mc_precip.precip_surface(p, w, reg, min_y, bx + dx, bz + dz, by + SCAN_UP, SCAN_DEPTH)
    if sy == mc_precip.SURFACE_NONE { return }
    var top: i32 = sy + 1 + SNOW_FALL_HEIGHT
    if top > by + SCAN_UP { top = by + SCAN_UP }
    if top <= sy + 1 { return }
    let fx: f64 = ((r >> 32 as u64) & 1023 as u64) as f64 / 1024.0
    let fz: f64 = ((r >> 44 as u64) & 1023 as u64) as f64 / 1024.0
    let fy: f64 = ((r >> 54 as u64) & 1023 as u64) as f64 / 1024.0
    let i: usize = (*s).head % SNOW_MAX
    (*s).head = (*s).head + 1
    (*s).x[i] = ((bx + dx) as f64) + fx
    (*s).z[i] = ((bz + dz) as f64) + fz
    (*s).y[i] = (top as f64) - fy * 0.99
    (*s).ground[i] = ((sy + 1) as f64) + 0.04
    (*s).phase[i] = fy * 6.2831853
    (*s).born[i] = now_ms
    (*s).n_spawned = (*s).n_spawned + 1 as u64
}

fn snowfall_update(s: *mut Snowfall, p: *mut mc_precip.Precip, w: *mut mc_world.World, reg: *mut mc_registry.Registry, min_y: i32,
    ex: f64, ey: f64, ez: f64, level_milli: i32, kind: i32, now_ms: u64) {
    var dt: u64 = 0 as u64
    if (*s).last_ms != 0 as u64 && now_ms > (*s).last_ms { dt = now_ms - (*s).last_ms }
    (*s).last_ms = now_ms
    if dt > DT_CAP_MS { dt = DT_CAP_MS }
    if kind != mc_precip.PRECIP_SNOW || level_milli <= 0 {
        (*s).acc = 0 as i64
        return
    }
    (*s).acc = (*s).acc + ((dt as i64) * RATE_PER_SEC * (level_milli as i64)) / MILLI
    let bx: i32 = math.floor(ex) as i32
    let by: i32 = math.floor(ey) as i32
    let bz: i32 = math.floor(ez) as i32
    var tries: i32 = 0
    while (*s).acc >= MILLI && tries < MAX_SPAWNS_PER_UPDATE {
        (*s).acc = (*s).acc - MILLI
        tries = tries + 1
        spawn_one(s, p, w, reg, min_y, bx, by, bz, now_ms)
    }
    if (*s).acc >= MILLI { (*s).acc = 0 as i64 }
}
