    v.sem[mc_sem.SEM_CONFIG_C2S_SELECT_KNOWN_PACKS] = -1
    v.sem[mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY] = 0
    v.sem[mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY_LIVING] = 2
