    v.sem[mc_sem.SEM_PLAY_S2C_CHUNK_BATCH_FINISHED] = -1
    v.sem[mc_sem.SEM_PLAY_S2C_START_CONFIGURATION] = -1
    v.sem[mc_sem.SEM_PLAY_C2S_TELEPORT_CONFIRM] = 0
    v.sem[mc_sem.SEM_PLAY_C2S_KEEP_ALIVE] = 15
