    v.sem[mc_sem.SEM_PLAY_C2S_PLAYER_INPUT] = -1
    v.sem[mc_sem.SEM_PLAY_C2S_PLAYER_LOADED] = -1
    return v
}

const VERSION_NAME: str = "1.17"
