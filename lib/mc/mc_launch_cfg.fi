// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.env
import std.fs
import mc.mc_session
import mc.mc_serverlist

export { LaunchCfg, cfg_new, cfg_free, cfg_default_path, cfg_load, cfg_save, cfg_complete, cfg_text, CFG_NONE }

const CFG_NONE: i32 = 0 - 1

struct LaunchCfg {
    host: rt.Buf,
    name: rt.Buf,
    port: i32,
    protocol: i32,
    view: i32,
    servers: mc_serverlist.ServerList,
}

fn cfg_new() -> LaunchCfg {
    return LaunchCfg { host: rt.buf_new(), name: rt.buf_new(), port: CFG_NONE, protocol: CFG_NONE, view: CFG_NONE, servers: mc_serverlist.sl_new() }
}

fn cfg_free(c: *mut LaunchCfg) {
    rt.buf_free(&(*c).host)
    rt.buf_free(&(*c).name)
    mc_serverlist.sl_free(&(*c).servers)
}

fn push_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn cfg_default_path(out: *mut rt.Buf) -> bool {
    if env.has("MCPLAY_CONFIG") {
        let v: str = env.get("MCPLAY_CONFIG")
        if v.n == 0 { return false }
        push_str(out, v)
        return true
    }
    if env.has("LOCALAPPDATA") {
        push_str(out, env.get("LOCALAPPDATA"))
        push_str(out, "/mcplay/mcplay.cfg")
        return true
    }
    if env.has("XDG_CONFIG_HOME") {
        push_str(out, env.get("XDG_CONFIG_HOME"))
        push_str(out, "/mcplay/mcplay.cfg")
        return true
    }
    if env.has("HOME") {
        push_str(out, env.get("HOME"))
        push_str(out, "/.config/mcplay/mcplay.cfg")
        return true
    }
    return false
}

fn cfg_load(path: str, c: *mut LaunchCfg) -> bool {
    var blob: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &blob) catch 0 as usize
    if n == 0 || rt.buf_len(&blob) == 0 {
        rt.buf_free(&blob)
        return false
    }
    let p: u64 = rt.buf_ptr(&blob)
    let len: usize = rt.buf_len(&blob)
    rt.buf_clear(&(*c).host)
    rt.buf_clear(&(*c).name)
    mc_session.session_value(p, len, "host", &(*c).host)
    mc_session.session_value(p, len, "name", &(*c).name)
    (*c).port = mc_session.session_int(p, len, "port", CFG_NONE)
    (*c).protocol = mc_session.session_int(p, len, "protocol", CFG_NONE)
    (*c).view = mc_session.session_int(p, len, "view", CFG_NONE)
    mc_serverlist.sl_load(p, len, &(*c).servers)
    rt.buf_free(&blob)
    return true
}

fn cfg_complete(c: *mut LaunchCfg) -> bool {
    return rt.buf_len(&(*c).host) > 0 && rt.buf_len(&(*c).name) > 0 && (*c).port > 0 && (*c).port <= 65535
}

fn push_number(out: *mut rt.Buf, value: i32) {
    var digits: [u8; 12] = [0; 12]
    var n: usize = 0
    var v: i32 = value
    if v <= 0 {
        digits[0] = 48 as u8
        n = 1
    }
    while v > 0 {
        digits[n] = (48 + v % 10) as u8
        n = n + 1
        v = v / 10
    }
    while n > 0 {
        n = n - 1
        rt.buf_push(out, digits[n])
    }
}

fn push_optional(out: *mut rt.Buf, key: str, value: i32) {
    if value <= 0 { return }
    push_str(out, key)
    push_number(out, value)
    push_str(out, "\n")
}

fn cfg_text(c: *mut LaunchCfg, out: *mut rt.Buf) {
    push_str(out, "host=")
    rt.buf_push_bytes(out, rt.buf_ptr(&(*c).host), rt.buf_len(&(*c).host))
    push_str(out, "\nport=")
    push_number(out, (*c).port)
    push_str(out, "\nname=")
    rt.buf_push_bytes(out, rt.buf_ptr(&(*c).name), rt.buf_len(&(*c).name))
    push_str(out, "\n")
    push_optional(out, "protocol=", (*c).protocol)
    push_optional(out, "view=", (*c).view)
    mc_serverlist.sl_text(&(*c).servers, out)
}

fn parent_len(path: str) -> usize {
    var i: usize = path.length()
    while i > 0 {
        if path.chars(i - 1) == 47 as u8 { return i - 1 }
        i = i - 1
    }
    return 0
}

fn cfg_save(path: str, c: *mut LaunchCfg) -> bool {
    let pl: usize = parent_len(path)
    if pl > 0 { fs.mkdir_all(path.part(0, pl)) catch false }
    var text: rt.Buf = rt.buf_new()
    cfg_text(c, &text)
    let n: usize = fs.write_file(path, rt.buf_ptr(&text), rt.buf_len(&text)) catch 0 as usize
    let ok: bool = n == rt.buf_len(&text)
    rt.buf_free(&text)
    return ok
}
