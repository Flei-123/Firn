import std.rt
import mc.mc_name_match

export { dur_max }

fn tool_base(p: u64, n: usize) -> i32 {
    if mc_name_match.nm_prefix(p, n, "wooden_") { return 59 }
    if mc_name_match.nm_prefix(p, n, "stone_") { return 131 }
    if mc_name_match.nm_prefix(p, n, "iron_") { return 250 }
    if mc_name_match.nm_prefix(p, n, "golden_") { return 32 }
    if mc_name_match.nm_prefix(p, n, "diamond_") { return 1561 }
    if mc_name_match.nm_prefix(p, n, "netherite_") { return 2031 }
    return 0
}

fn armor_factor(p: u64, n: usize) -> i32 {
    if mc_name_match.nm_prefix(p, n, "leather_") { return 5 }
    if mc_name_match.nm_prefix(p, n, "chainmail_") { return 15 }
    if mc_name_match.nm_prefix(p, n, "iron_") { return 15 }
    if mc_name_match.nm_prefix(p, n, "golden_") { return 7 }
    if mc_name_match.nm_prefix(p, n, "diamond_") { return 33 }
    if mc_name_match.nm_prefix(p, n, "netherite_") { return 37 }
    return 0
}

fn armor_slot(p: u64, n: usize) -> i32 {
    if mc_name_match.nm_suffix(p, n, "_helmet") { return 11 }
    if mc_name_match.nm_suffix(p, n, "_chestplate") { return 16 }
    if mc_name_match.nm_suffix(p, n, "_leggings") { return 15 }
    if mc_name_match.nm_suffix(p, n, "_boots") { return 13 }
    return 0
}

fn dur_max(p: u64, n: usize) -> i32 {
    if mc_name_match.nm_is(p, n, "bow") { return 384 }
    if mc_name_match.nm_is(p, n, "crossbow") { return 465 }
    if mc_name_match.nm_is(p, n, "fishing_rod") { return 64 }
    if mc_name_match.nm_is(p, n, "flint_and_steel") { return 64 }
    if mc_name_match.nm_is(p, n, "shears") { return 238 }
    if mc_name_match.nm_is(p, n, "shield") { return 336 }
    if mc_name_match.nm_is(p, n, "elytra") { return 432 }
    if mc_name_match.nm_is(p, n, "trident") { return 250 }
    if mc_name_match.nm_is(p, n, "carrot_on_a_stick") { return 25 }
    if mc_name_match.nm_is(p, n, "warped_fungus_on_a_stick") { return 100 }
    if mc_name_match.nm_is(p, n, "brush") { return 64 }
    if mc_name_match.nm_is(p, n, "mace") { return 500 }
    if mc_name_match.nm_is(p, n, "turtle_helmet") { return 275 }
    if mc_name_match.nm_suffix(p, n, "_pickaxe") || mc_name_match.nm_suffix(p, n, "_axe") || mc_name_match.nm_suffix(p, n, "_shovel") || mc_name_match.nm_suffix(p, n, "_hoe") || mc_name_match.nm_suffix(p, n, "_sword") {
        return tool_base(p, n)
    }
    let slot: i32 = armor_slot(p, n)
    if slot > 0 { return slot * armor_factor(p, n) }
    return 0
}
