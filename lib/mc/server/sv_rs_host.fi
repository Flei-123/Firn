import mc.server.sv_state
import mc.server.sv_dig
import mc.server.rs.rs_core

export { rs_install, redstone_phase }

fn world_get(ctx: u64, x: i32, y: i32, z: i32) -> i32 {
    return sv_dig.world_peek(ctx as *mut sv_state.Server, x, y, z)
}

fn world_set(ctx: u64, x: i32, y: i32, z: i32, state: i32) {
    sv_dig.apply_raw(ctx as *mut sv_state.Server, x, y, z, state)
}

fn rs_install(srv: *mut sv_state.Server) {
    (*srv).rs.ctx = srv as u64
    (*srv).rs.world_get = world_get
    (*srv).rs.world_set = world_set
}

fn redstone_phase(ctx: u64) {
    let srv: *mut sv_state.Server = ctx as *mut sv_state.Server
    if (*srv).rs.enabled { rs_core.rs_run_ticks(&(*srv).rs) }
}
