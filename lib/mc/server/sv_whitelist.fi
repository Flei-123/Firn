// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_whitelist.fi -- login whitelist check against the comma separated list (case-insensitive) in the server config.

import std.rt
import mc.server.sv_state

export { whitelist_allows, whitelist_contains }

const CH_COMMA: u8 = 44 as u8

fn lower(c: u8) -> u8 {
    if c >= 65 as u8 && c <= 90 as u8 { return c + 32 as u8 }
    return c
}

fn entry_matches(list: str, from: usize, to: usize, name: u64, n: usize) -> bool {
    if to - from != n { return false }
    var i: usize = 0
    while i < n {
        if lower(rt.ld8(list.p as u64, from + i)) != lower(rt.ld8(name, i)) { return false }
        i = i + 1
    }
    return true
}

fn whitelist_contains(list: str, name: u64, n: usize) -> bool {
    var i: usize = 0
    while i <= list.n {
        var end: usize = i
        while end < list.n && rt.ld8(list.p as u64, end) != CH_COMMA { end = end + 1 }
        if end > i && entry_matches(list, i, end, name, n) { return true }
        i = end + 1
    }
    return false
}

fn whitelist_allows(srv: *mut sv_state.Server, name: u64, n: usize) -> bool {
    if !(*srv).cfg.whitelist_on { return true }
    return whitelist_contains((*srv).cfg.whitelist, name, n)
}
