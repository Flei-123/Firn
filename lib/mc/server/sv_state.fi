// lib/mc/server/sv_state.fi -- state of the integrated server: Server, Session, the shared control block.

import std.net
import std.rt
import std.bytes
import mc.mc_codec
import mc.mc_version
import mc.server.sv_clock
import mc.server.sv_phase
import mc.server.sv_world
import mc.server.sv_chunk_enc
import mc.server.sv_edits
import mc.server.ent.ent_table
import mc.server.rs.rs_core

export {
    Server, Session, Config,
    session_empty, session_size, session_at, session_reset,
    config_default,
    shared_new, shared_get, shared_set, shared_free,
    SH_PORT_WANT, SH_PORT_BOUND, SH_READY, SH_STOP, SH_ONLINE, SH_TICKS, SH_AVG_US, SH_TPS_X100, SH_FAILED, SH_WORDS,
    MAX_SESSIONS, SESSION_NAME_MAX, HANDSHAKE_TIMEOUT_MS,
}

const MAX_SESSIONS: usize = 32
const HANDSHAKE_TIMEOUT_MS: i64 = 15000
const SESSION_NAME_MAX: usize = 16

const SH_PORT_WANT: usize = 0
const SH_PORT_BOUND: usize = 1
const SH_READY: usize = 2
const SH_STOP: usize = 3
const SH_ONLINE: usize = 4
const SH_TICKS: usize = 5
const SH_AVG_US: usize = 6
const SH_TPS_X100: usize = 7
const SH_FAILED: usize = 8
const SH_WORDS: usize = 16

struct Config {
    view: i32,
    max_players: i32,
    game_mode: i32,
    compression: i32,
    keepalive_interval_ms: i64,
    keepalive_timeout_ms: i64,
    chunks_per_tick: i32,
    motd: str,
    bind_addr: u32,
    ops: str,
    whitelist_on: bool,
    whitelist: str,
    quiet_joins: bool,
}

struct Session {
    wire: mc_codec.Wire,
    state: i32,
    used: bool,
    closing: bool,
    joined: bool,
    name: [u8; 16],
    name_n: usize,
    uuid_hi: u64,
    uuid_lo: u64,
    eid: i32,
    proto: i32,
    x: f64,
    y: f64,
    z: f64,
    yaw: f32,
    pitch: f32,
    on_ground: bool,
    tp_pending: i32,
    tp_next: i32,
    cx: i32,
    cz: i32,
    view: i32,
    ka_id: i64,
    ka_pending: bool,
    ka_next: i64,
    ka_deadline: i64,
    born_ms: i64,
    chunks: u64,
    chunks_w: i32,
    sent_chunks: u64,
    hotbar: [i32; 9],
    hotbar_n: [i32; 9],
    held: i32,
    gamemode: i32,
    login_sent: bool,
}

struct Server {
    cfg: Config,
    ver: mc_version.Version,
    clock: sv_clock.TickClock,
    phases: sv_phase.Phases,
    world: sv_world.WorldSource,
    enc: sv_chunk_enc.ChunkEnc,
    listener: net.Listener,
    sess: u64,
    shared: u64,
    column: sv_world.Column,
    tail: rt.Buf,
    tail_ready: bool,
    game_time: i64,
    day_time: i64,
    next_eid: i32,
    online: i32,
    now_ms: i64,
    tick_us: u64,
    adapter: u64,
    ticks_run: u64,
    edits: sv_edits.Edits,
    world_dir: rt.Buf,
    next_save: u64,
    saves_done: u64,
    peek: sv_world.Column,
    peek_cx: i32,
    peek_cz: i32,
    peek_ok: bool,
    cmds: u64,
    ents: ent_table.Table,
    rs: rs_core.Rs,
    on_command: fn(*mut Server, *mut Session, u64, usize),
    on_join: fn(*mut Server, *mut Session),
    on_tab: fn(*mut Server, *mut Session, i32, u64, usize),
}

fn config_default() -> Config {
    return Config { view: 8, max_players: 20, game_mode: 1, compression: 256, keepalive_interval_ms: 15000,
        keepalive_timeout_ms: 30000, chunks_per_tick: 10, motd: "A Firn Minecraft Server",
        bind_addr: net.ipv4(127 as u8, 0 as u8, 0 as u8, 1 as u8), ops: "*", whitelist_on: false, whitelist: "", quiet_joins: false }
}

fn session_empty() -> Session {
    return Session { wire: mc_codec.wire_open(net.conn_from_fd(0 - 1)), state: 0, used: false, closing: false,
        joined: false, name: [0; 16], name_n: 0, uuid_hi: 0, uuid_lo: 0, eid: 0, proto: 0, x: 0.0, y: 0.0, z: 0.0,
        yaw: 0.0f, pitch: 0.0f, on_ground: false, tp_pending: 0, tp_next: 1, cx: 0, cz: 0, view: 0, ka_id: 0,
        ka_pending: false, ka_next: 0, ka_deadline: 0, born_ms: 0, chunks: 0, chunks_w: 0, sent_chunks: 0, hotbar: [0; 9], hotbar_n: [0; 9], held: 0, gamemode: 1, login_sent: false }
}

static mut g_session_size: usize = 0

fn session_size() -> usize {
    if g_session_size == 0 {
        var a: [Session; 2] = [session_empty(); 2]
        g_session_size = ((&a[1]) as u64 - (&a[0]) as u64) as usize
    }
    return g_session_size
}

fn session_at(srv: *mut Server, i: usize) -> *mut Session {
    return ((*srv).sess + (i * session_size()) as u64) as *mut Session
}

fn session_reset(s: *mut Session) {
    if (*s).chunks != 0 {
        rt.heap_free((*s).chunks, ((*s).chunks_w * (*s).chunks_w) as usize * 8)
    }
    *s = session_empty()
}

fn shared_new() -> u64 {
    let p: u64 = rt.heap_alloc(SH_WORDS * 8)
    rt.mem_set(p, 0 as u8, SH_WORDS * 8)
    return p
}

fn shared_free(p: u64) {
    rt.heap_free(p, SH_WORDS * 8)
}

fn shared_get(p: u64, i: usize) -> u64 {
    return rt.ld64(p, i)
}

fn shared_set(p: u64, i: usize, v: u64) {
    rt.st64(p, i, v)
}
