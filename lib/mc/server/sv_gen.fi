import std.rt
import mc.mc_version
import mc.mc_registry
import mc.gen.wgdf_graph
import mc.gen.wgdf_gen
import mc.gen.wgdf_fluid
import mc.server.sv_world

export { gen_source_new, gen_dim_known, gen_dim_of_level_type }

const PALETTE_ENTRIES: usize = 256
const GEN_MIN_Y: i32 = 0 - 64
const GEN_HEIGHT: i32 = 384

struct GenCtx {
    gen: *mut wgdf_gen.WgGen,
    palette: u64,
    scratch: u64,
    scratch_len: usize,
}

fn ctx_bytes() -> usize {
    return wgdf_graph.wg_size_of[GenCtx]()
}

fn state_of(r: *mut mc_registry.Registry, name: str) -> u16 {
    let b: i32 = mc_registry.reg_block_by_name(r, name.p as u64, name.n)
    if b < 0 { return 0 as u16 }
    return mc_registry.reg_block_default_state(r, b) as u16
}

fn palette_set(pal: u64, r: *mut mc_registry.Registry, code: u8, name: str) {
    rt.st16(pal, code as usize, state_of(r, name))
}

fn palette_build(pal: u64, r: *mut mc_registry.Registry, default_block: str) {
    rt.mem_set(pal, 0 as u8, PALETTE_ENTRIES * 2)
    palette_set(pal, r, wgdf_fluid.STATE_SOLID, default_block)
    palette_set(pal, r, wgdf_fluid.STATE_AIR, "air")
    palette_set(pal, r, wgdf_fluid.STATE_WATER, "water")
    palette_set(pal, r, wgdf_fluid.STATE_LAVA, "lava")
    palette_set(pal, r, wgdf_fluid.STATE_COPPER_ORE, "copper_ore")
    palette_set(pal, r, wgdf_fluid.STATE_RAW_COPPER, "raw_copper_block")
    palette_set(pal, r, wgdf_fluid.STATE_GRANITE, "granite")
    palette_set(pal, r, wgdf_fluid.STATE_IRON_ORE, "deepslate_iron_ore")
    palette_set(pal, r, wgdf_fluid.STATE_RAW_IRON, "raw_iron_block")
    palette_set(pal, r, wgdf_fluid.STATE_TUFF, "tuff")
}

fn gen_dim_known(dim: str) -> bool {
    return dim == "overworld" || dim == "amplified" || dim == "large_biomes"
}

fn gen_dim_of_level_type(level_type: str) -> str {
    if level_type == "normal" || level_type == "minecraft:normal" || level_type == "default" { return "overworld" }
    if level_type == "amplified" || level_type == "minecraft:amplified" { return "amplified" }
    if level_type == "large_biomes" || level_type == "minecraft:large_biomes" || level_type == "largebiomes" { return "large_biomes" }
    return ""
}

fn spawn_height(ctx: u64) -> i32 {
    let c: *mut GenCtx = ctx as *mut GenCtx
    wgdf_gen.gen_chunk((*c).gen, 0, 0, (*c).scratch as *mut u8)
    var yi: i32 = GEN_HEIGHT - 1
    while yi > 0 {
        let code: u8 = rt.ld8((*c).scratch, ((yi as usize) * 16 + 8) * 16 + 8)
        if code != wgdf_fluid.STATE_AIR && code != wgdf_fluid.STATE_WATER { return GEN_MIN_Y + yi + 1 }
        yi = yi - 1
    }
    return 100
}

fn gen_fill(ctx: u64, cx: i32, cz: i32, col: *mut sv_world.Column) -> bool {
    let c: *mut GenCtx = ctx as *mut GenCtx
    wgdf_gen.gen_chunk((*c).gen, cx, cz, (*c).scratch as *mut u8)
    let n: usize = (*c).scratch_len
    let blocks: u64 = (*col).blocks
    var i: usize = 0
    while i < n {
        rt.st16(blocks, i, rt.ld16((*c).palette, rt.ld8((*c).scratch, i) as usize))
        i = i + 1
    }
    return true
}

fn gen_release(ctx: u64) {
    let c: *mut GenCtx = ctx as *mut GenCtx
    wgdf_gen.gen_close((*c).gen)
    rt.heap_free((*c).palette, PALETTE_ENTRIES * 2)
    rt.heap_free((*c).scratch, (*c).scratch_len)
    rt.heap_free(ctx, ctx_bytes())
}

fn source_none() -> sv_world.WorldSource {
    return sv_world.WorldSource { ctx: 0 as u64, fill: gen_fill, release: gen_release, min_y: GEN_MIN_Y, height: GEN_HEIGHT,
        spawn_x: 8, spawn_y: 100, spawn_z: 8, biome: 0, uniform: false }
}

fn gen_source_new(ver: *mut mc_version.Version, biome: i32, data_root: str, dim: str, seed: i64) -> sv_world.WorldSource {
    if !gen_dim_known(dim) { return source_none() }
    let gen: *mut wgdf_gen.WgGen = wgdf_gen.gen_open(data_root, dim, seed)
    if gen == (0 as *mut wgdf_gen.WgGen) { return source_none() }
    if wgdf_gen.gen_min_y(gen) != GEN_MIN_Y || wgdf_gen.gen_height(gen) != GEN_HEIGHT {
        wgdf_gen.gen_close(gen)
        return source_none()
    }
    var reg: mc_registry.Registry = (*ver).registry_of()
    let c: *mut GenCtx = rt.heap_alloc(ctx_bytes()) as *mut GenCtx
    (*c).gen = gen
    (*c).palette = rt.heap_alloc(PALETTE_ENTRIES * 2)
    (*c).scratch_len = (GEN_HEIGHT as usize) * 256
    (*c).scratch = rt.heap_alloc((*c).scratch_len)
    palette_build((*c).palette, &reg, wgdf_gen.gen_default_block(gen))
    return sv_world.WorldSource { ctx: c as u64, fill: gen_fill, release: gen_release, min_y: GEN_MIN_Y, height: GEN_HEIGHT,
        spawn_x: 8, spawn_y: spawn_height(c as u64), spawn_z: 8, biome: biome, uniform: false }
}
