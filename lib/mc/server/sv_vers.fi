// lib/mc/server/sv_vers.fi -- registry of the protocols the server can serve. One import and one branch per adapter.

import mc.server.sv_ver
import mc.server.v763.sv_adapter_v763

export { server_version_by_protocol, server_version_supported }

fn server_version_by_protocol(protocol: i32, out: *mut sv_ver.ServerVersion) -> bool {
    if protocol == 763 {
        *out = sv_adapter_v763.adapter()
        return true
    }
    return false
}

fn server_version_supported(protocol: i32) -> bool {
    return protocol == 763
}
