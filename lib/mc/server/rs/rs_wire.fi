import mc.server.rs.rs_core
import mc.server.rs.rs_dir
import mc.server.rs.rs_state

export { comp_wire, wire_shapes }

fn horizontal(i: i32) -> i32 {
    if i == 0 { return rs_dir.NORTH }
    if i == 1 { return rs_dir.EAST }
    if i == 2 { return rs_dir.SOUTH }
    return rs_dir.WEST
}

fn connected(rs: *mut rs_core.Rs, state: i32, d: i32) -> bool {
    return !rs_state.stext_is(&(*rs).reg, state, rs_dir.dir_name(d), "none")
}

fn is_dot(rs: *mut rs_core.Rs, state: i32) -> bool {
    var i: i32 = 0
    while i < 4 {
        if connected(rs, state, horizontal(i)) { return false }
        i = i + 1
    }
    return true
}

fn should_connect(rs: *mut rs_core.Rs, state: i32, d: i32) -> bool {
    let tag: i32 = rs_core.rs_tag_of_state(rs, state)
    if tag == rs_core.TAG_WIRE { return true }
    if tag == rs_core.TAG_REPEATER {
        let f: i32 = rs_state.sdir(&(*rs).reg, state, "facing")
        return d >= 0 && (f == d || rs_dir.dir_opposite(f) == d)
    }
    if tag == rs_core.TAG_NONE || d < 0 { return false }
    return (*rs_core.rs_comp_at(rs, rs_core.rs_kind_of_state(rs, state))).source
}

fn connecting_side(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, d: i32, non_normal_above: bool) -> str {
    let bx: i32 = x + rs_dir.dir_dx(d)
    let bz: i32 = z + rs_dir.dir_dz(d)
    let bs: i32 = rs_core.rs_get(rs, bx, y, bz)
    if non_normal_above {
        if rs_core.rs_is_conductor(rs, bs) && should_connect(rs, rs_core.rs_get(rs, bx, y + 1, bz), 0 - 1) { return "up" }
    }
    if should_connect(rs, bs, d) { return "side" }
    if rs_core.rs_is_conductor(rs, bs) { return "none" }
    if should_connect(rs, rs_core.rs_get(rs, bx, y - 1, bz), 0 - 1) { return "side" }
    return "none"
}

fn missing_connections(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, base: i32) -> i32 {
    let above: bool = !rs_core.rs_is_conductor(rs, rs_core.rs_get(rs, x, y + 1, z))
    var s: i32 = base
    var i: i32 = 0
    while i < 4 {
        let d: i32 = horizontal(i)
        if !connected(rs, s, d) { s = rs_state.sset_text(&(*rs).reg, s, rs_dir.dir_name(d), connecting_side(rs, x, y, z, d, above)) }
        i = i + 1
    }
    return s
}

fn dot_state(rs: *mut rs_core.Rs, state: i32) -> i32 {
    var s: i32 = state
    var i: i32 = 0
    while i < 4 {
        s = rs_state.sset_text(&(*rs).reg, s, rs_dir.dir_name(horizontal(i)), "none")
        i = i + 1
    }
    return s
}

fn connection_state(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> i32 {
    let flag: bool = is_dot(rs, state)
    var s: i32 = missing_connections(rs, x, y, z, dot_state(rs, state))
    if flag && is_dot(rs, s) { return s }
    let n: bool = connected(rs, s, rs_dir.NORTH)
    let e: bool = connected(rs, s, rs_dir.EAST)
    let so: bool = connected(rs, s, rs_dir.SOUTH)
    let w: bool = connected(rs, s, rs_dir.WEST)
    let ns_none: bool = !n && !so
    let ew_none: bool = !e && !w
    if !w && ns_none { s = rs_state.sset_text(&(*rs).reg, s, "west", "side") }
    if !e && ns_none { s = rs_state.sset_text(&(*rs).reg, s, "east", "side") }
    if !n && ew_none { s = rs_state.sset_text(&(*rs).reg, s, "north", "side") }
    if !so && ew_none { s = rs_state.sset_text(&(*rs).reg, s, "south", "side") }
    return s
}

fn wire_power(rs: *mut rs_core.Rs, state: i32) -> i32 {
    if rs_core.rs_tag_of_state(rs, state) != rs_core.TAG_WIRE { return 0 }
    return rs_state.sint(&(*rs).reg, state, "power")
}

fn target_strength(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32) -> i32 {
    (*rs).wires_give_power = false
    let i: i32 = rs_core.rs_best_neighbor_signal(rs, x, y, z)
    (*rs).wires_give_power = true
    var j: i32 = 0
    if i < 15 {
        let above_conductor: bool = rs_core.rs_is_conductor(rs, rs_core.rs_get(rs, x, y + 1, z))
        var k: i32 = 0
        while k < 4 {
            let d: i32 = horizontal(k)
            let bx: i32 = x + rs_dir.dir_dx(d)
            let bz: i32 = z + rs_dir.dir_dz(d)
            let bs: i32 = rs_core.rs_get(rs, bx, y, bz)
            var v: i32 = wire_power(rs, bs)
            if v > j { j = v }
            if !above_conductor {
                if rs_core.rs_is_conductor(rs, bs) {
                    v = wire_power(rs, rs_core.rs_get(rs, bx, y + 1, bz))
                } else {
                    v = wire_power(rs, rs_core.rs_get(rs, bx, y - 1, bz))
                }
                if v > j { j = v }
            }
            k = k + 1
        }
    }
    if i > j - 1 { return i }
    return j - 1
}

fn bucket(x: i32, y: i32, z: i32) -> i64 {
    let h: i64 = (((y as i64) + (z as i64) * 31) * 31 + (x as i64)) & 4294967295
    return (h ^ (h >> 16)) & 15
}

fn update_power(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    let target: i32 = target_strength(rs, x, y, z)
    if rs_state.sint(&(*rs).reg, state, "power") == target { return }
    if rs_core.rs_get(rs, x, y, z) == state {
        rs_core.rs_set(rs, x, y, z, rs_state.sset_int(&(*rs).reg, state, "power", target), 2)
    }
    var px: [i32; 7] = [0; 7]
    var py: [i32; 7] = [0; 7]
    var pz: [i32; 7] = [0; 7]
    var pb: [i64; 7] = [0; 7]
    px[0] = x
    py[0] = y
    pz[0] = z
    var d: i32 = 0
    while d < 6 {
        px[(d + 1) as usize] = x + rs_dir.dir_dx(d)
        py[(d + 1) as usize] = y + rs_dir.dir_dy(d)
        pz[(d + 1) as usize] = z + rs_dir.dir_dz(d)
        d = d + 1
    }
    var i: usize = 0
    while i < 7 {
        pb[i] = bucket(px[i], py[i], pz[i])
        i = i + 1
    }
    var b: i64 = 0
    while b < 16 {
        i = 0
        while i < 7 {
            if pb[i] == b { rs_core.rs_update_at(rs, px[i], py[i], pz[i]) }
            i = i + 1
        }
        b = b + 1
    }
}

fn corner_change(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32) {
    if rs_core.rs_tag_of_state(rs, rs_core.rs_get(rs, x, y, z)) != rs_core.TAG_WIRE { return }
    rs_core.rs_update_at(rs, x, y, z)
    var d: i32 = 0
    while d < 6 {
        rs_core.rs_update_at(rs, x + rs_dir.dir_dx(d), y + rs_dir.dir_dy(d), z + rs_dir.dir_dz(d))
        d = d + 1
    }
}

fn update_neighboring_wires(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32) {
    var i: i32 = 0
    while i < 4 {
        let d: i32 = horizontal(i)
        corner_change(rs, x + rs_dir.dir_dx(d), y, z + rs_dir.dir_dz(d))
        i = i + 1
    }
    i = 0
    while i < 4 {
        let d: i32 = horizontal(i)
        let bx: i32 = x + rs_dir.dir_dx(d)
        let bz: i32 = z + rs_dir.dir_dz(d)
        if rs_core.rs_is_conductor(rs, rs_core.rs_get(rs, bx, y, bz)) {
            corner_change(rs, bx, y + 1, bz)
        } else {
            corner_change(rs, bx, y - 1, bz)
        }
        i = i + 1
    }
}

fn neighbor_changed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    update_power(rs, x, y, z, state)
}

fn placed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    if rs_core.rs_same_block(rs, (*rs).prev, state) { return }
    update_power(rs, x, y, z, state)
    rs_core.rs_update_at(rs, x, y + 1, z)
    rs_core.rs_update_at(rs, x, y - 1, z)
    update_neighboring_wires(rs, x, y, z)
}

fn removed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, old: i32) {
    if rs_core.rs_same_block(rs, old, rs_core.rs_get(rs, x, y, z)) { return }
    var d: i32 = 0
    while d < 6 {
        rs_core.rs_update_at(rs, x + rs_dir.dir_dx(d), y + rs_dir.dir_dy(d), z + rs_dir.dir_dz(d))
        d = d + 1
    }
    update_power(rs, x, y, z, old)
    update_neighboring_wires(rs, x, y, z)
}

fn signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32, dir: i32) -> i32 {
    if !(*rs).wires_give_power || dir == rs_dir.DOWN { return 0 }
    let p: i32 = rs_state.sint(&(*rs).reg, state, "power")
    if p == 0 { return 0 }
    if dir == rs_dir.UP { return p }
    let cs: i32 = connection_state(rs, x, y, z, state)
    if connected(rs, cs, rs_dir.dir_opposite(dir)) { return p }
    return 0
}

fn place_state(rs: *mut rs_core.Rs, state: i32, face: i32, hdir: i32, x: i32, y: i32, z: i32) -> i32 {
    var s: i32 = state
    var i: i32 = 0
    while i < 4 {
        s = rs_state.sset_text(&(*rs).reg, s, rs_dir.dir_name(horizontal(i)), "side")
        i = i + 1
    }
    return connection_state(rs, x, y, z, s)
}

fn refresh(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32) {
    let cur: i32 = rs_core.rs_get(rs, x, y, z)
    if rs_core.rs_tag_of_state(rs, cur) != rs_core.TAG_WIRE { return }
    let ns: i32 = connection_state(rs, x, y, z, cur)
    if ns != cur { (*rs).world_set((*rs).ctx, x, y, z, ns) }
}

fn wire_shapes(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32) {
    var d: i32 = 0
    while d < 6 {
        refresh(rs, x + rs_dir.dir_dx(d), y + rs_dir.dir_dy(d), z + rs_dir.dir_dz(d))
        if rs_dir.dir_horizontal(d) {
            refresh(rs, x + rs_dir.dir_dx(d), y + 1, z + rs_dir.dir_dz(d))
            refresh(rs, x + rs_dir.dir_dx(d), y - 1, z + rs_dir.dir_dz(d))
        }
        d = d + 1
    }
}

fn comp_wire() -> rs_core.Comp {
    var c: rs_core.Comp = rs_core.comp_default(rs_core.TAG_WIRE)
    c.neighbor_changed = neighbor_changed
    c.signal = signal
    c.direct = signal
    c.placed = placed
    c.removed = removed
    c.place_state = place_state
    return c
}
