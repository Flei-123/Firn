import std.rt

export { DOWN, UP, NORTH, SOUTH, WEST, EAST, dir_dx, dir_dy, dir_dz, dir_opposite, dir_horizontal, dir_name, dir_by_name, neighbor_order, dir_cw, dir_ccw }

const DOWN: i32 = 0
const UP: i32 = 1
const NORTH: i32 = 2
const SOUTH: i32 = 3
const WEST: i32 = 4
const EAST: i32 = 5

fn dir_dx(d: i32) -> i32 {
    if d == WEST { return 0 - 1 }
    if d == EAST { return 1 }
    return 0
}

fn dir_dy(d: i32) -> i32 {
    if d == DOWN { return 0 - 1 }
    if d == UP { return 1 }
    return 0
}

fn dir_dz(d: i32) -> i32 {
    if d == NORTH { return 0 - 1 }
    if d == SOUTH { return 1 }
    return 0
}

fn dir_opposite(d: i32) -> i32 {
    if d % 2 == 0 { return d + 1 }
    return d - 1
}

fn dir_horizontal(d: i32) -> bool { return d >= NORTH }

fn neighbor_order(i: i32) -> i32 { return (i + 4) % 6 }

fn dir_cw(d: i32) -> i32 {
    if d == NORTH { return EAST }
    if d == EAST { return SOUTH }
    if d == SOUTH { return WEST }
    return NORTH
}

fn dir_ccw(d: i32) -> i32 { return dir_cw(dir_opposite(d)) }

fn dir_name(d: i32) -> str {
    if d == DOWN { return "down" }
    if d == UP { return "up" }
    if d == NORTH { return "north" }
    if d == SOUTH { return "south" }
    if d == WEST { return "west" }
    return "east"
}

fn dir_by_name(p: u64, n: usize) -> i32 {
    var d: i32 = 0
    while d < 6 {
        let s: str = dir_name(d)
        if s.n == n && rt.mem_eq(s.p as u64, p, n) { return d }
        d = d + 1
    }
    return 0 - 1
}
