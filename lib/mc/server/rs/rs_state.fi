import std.rt
import mc.mc_registry
import mc.server.rs.rs_dir

export { prop_find, sget, sset, sbool, sset_bool, sint, sset_int, sdir, sset_dir, sset_text, stext_is, block_named }

fn prop_find(reg: *mut mc_registry.Registry, b: i32, name: str) -> i32 {
    let n: i32 = mc_registry.reg_prop_count(reg, b)
    var i: i32 = 0
    while i < n {
        var len: usize = 0
        let p: u64 = mc_registry.reg_prop_name(reg, b, i, &len)
        if len == name.n && rt.mem_eq(p, name.p as u64, len) { return i }
        i = i + 1
    }
    return 0 - 1
}

fn stride(reg: *mut mc_registry.Registry, b: i32, i: i32) -> i32 {
    var s: i32 = 1
    var k: i32 = mc_registry.reg_prop_count(reg, b) - 1
    while k > i {
        s = s * mc_registry.reg_prop_values(reg, b, k)
        k = k - 1
    }
    return s
}

fn sget(reg: *mut mc_registry.Registry, state: i32, name: str) -> i32 {
    let b: i32 = mc_registry.reg_block_of_state(reg, state)
    let p: i32 = prop_find(reg, b, name)
    if p < 0 { return 0 - 1 }
    return mc_registry.reg_state_prop_value(reg, state, p)
}

fn sset(reg: *mut mc_registry.Registry, state: i32, name: str, v: i32) -> i32 {
    let b: i32 = mc_registry.reg_block_of_state(reg, state)
    let p: i32 = prop_find(reg, b, name)
    if p < 0 || v < 0 { return state }
    let old: i32 = mc_registry.reg_state_prop_value(reg, state, p)
    return state + (v - old) * stride(reg, b, p)
}

fn value_text(reg: *mut mc_registry.Registry, b: i32, p: i32, v: i32, out: *mut rt.Buf) {
    rt.buf_clear(out)
    mc_registry.reg_prop_value_name(reg, b, p, v, out)
}

fn value_find(reg: *mut mc_registry.Registry, b: i32, p: i32, tp: u64, tn: usize) -> i32 {
    var buf: rt.Buf = rt.buf_new()
    let count: i32 = mc_registry.reg_prop_values(reg, b, p)
    var found: i32 = 0 - 1
    var v: i32 = 0
    while v < count && found < 0 {
        value_text(reg, b, p, v, &buf)
        if buf.len == tn && rt.mem_eq(buf.ptr, tp, tn) { found = v }
        v = v + 1
    }
    rt.buf_free(&buf)
    return found
}

fn sset_text(reg: *mut mc_registry.Registry, state: i32, name: str, text: str) -> i32 {
    let b: i32 = mc_registry.reg_block_of_state(reg, state)
    let p: i32 = prop_find(reg, b, name)
    if p < 0 { return state }
    let v: i32 = value_find(reg, b, p, text.p as u64, text.n)
    if v < 0 { return state }
    return sset(reg, state, name, v)
}

fn stext_is(reg: *mut mc_registry.Registry, state: i32, name: str, text: str) -> bool {
    let b: i32 = mc_registry.reg_block_of_state(reg, state)
    let p: i32 = prop_find(reg, b, name)
    if p < 0 { return false }
    return value_find(reg, b, p, text.p as u64, text.n) == mc_registry.reg_state_prop_value(reg, state, p)
}

fn sbool(reg: *mut mc_registry.Registry, state: i32, name: str) -> bool {
    return stext_is(reg, state, name, "true")
}

fn sset_bool(reg: *mut mc_registry.Registry, state: i32, name: str, on: bool) -> i32 {
    if on { return sset_text(reg, state, name, "true") }
    return sset_text(reg, state, name, "false")
}

fn sint(reg: *mut mc_registry.Registry, state: i32, name: str) -> i32 {
    let b: i32 = mc_registry.reg_block_of_state(reg, state)
    let p: i32 = prop_find(reg, b, name)
    if p < 0 { return 0 }
    var buf: rt.Buf = rt.buf_new()
    value_text(reg, b, p, mc_registry.reg_state_prop_value(reg, state, p), &buf)
    var r: i32 = 0
    var i: usize = 0
    while i < buf.len {
        r = r * 10 + ((rt.ld8(buf.ptr, i) as i32) - 48)
        i = i + 1
    }
    rt.buf_free(&buf)
    return r
}

fn sset_int(reg: *mut mc_registry.Registry, state: i32, name: str, n: i32) -> i32 {
    let b: i32 = mc_registry.reg_block_of_state(reg, state)
    let p: i32 = prop_find(reg, b, name)
    if p < 0 { return state }
    var buf: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&buf, n as i64)
    let v: i32 = value_find(reg, b, p, buf.ptr, buf.len)
    rt.buf_free(&buf)
    if v < 0 { return state }
    return sset(reg, state, name, v)
}

fn sdir(reg: *mut mc_registry.Registry, state: i32, name: str) -> i32 {
    let b: i32 = mc_registry.reg_block_of_state(reg, state)
    let p: i32 = prop_find(reg, b, name)
    if p < 0 { return 0 - 1 }
    var buf: rt.Buf = rt.buf_new()
    value_text(reg, b, p, mc_registry.reg_state_prop_value(reg, state, p), &buf)
    let d: i32 = rs_dir.dir_by_name(buf.ptr, buf.len)
    rt.buf_free(&buf)
    return d
}

fn sset_dir(reg: *mut mc_registry.Registry, state: i32, name: str, d: i32) -> i32 {
    return sset_text(reg, state, name, rs_dir.dir_name(d))
}

fn block_named(reg: *mut mc_registry.Registry, name: str) -> i32 {
    return mc_registry.reg_block_by_name(reg, name.p as u64, name.n)
}
