import mc.server.rs.rs_core
import mc.server.rs.rs_diode
import mc.server.rs.rs_state

export { comp_observer }

const PULSE_DELAY: i32 = 2

fn kind_of(rs: *mut rs_core.Rs, state: i32) -> i32 {
    return rs_core.rs_kind_of_state(rs, state)
}

fn shape(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32, dir: i32) {
    if rs_state.sdir(&(*rs).reg, state, "facing") != dir || rs_state.sbool(&(*rs).reg, state, "powered") { return }
    rs_core.rs_schedule(rs, x, y, z, kind_of(rs, state), PULSE_DELAY, rs_core.PRIO_NORMAL)
}

fn tick(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    if rs_state.sbool(&(*rs).reg, state, "powered") {
        rs_core.rs_set(rs, x, y, z, rs_state.sset_bool(&(*rs).reg, state, "powered", false), 2)
    } else {
        rs_core.rs_set(rs, x, y, z, rs_state.sset_bool(&(*rs).reg, state, "powered", true), 2)
        rs_core.rs_schedule(rs, x, y, z, kind_of(rs, state), PULSE_DELAY, rs_core.PRIO_NORMAL)
    }
    rs_diode.update_in_front(rs, x, y, z, state)
}

fn signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32, dir: i32) -> i32 {
    if rs_state.sbool(&(*rs).reg, state, "powered") && rs_state.sdir(&(*rs).reg, state, "facing") == dir { return 15 }
    return 0
}

fn placed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    if rs_core.rs_same_block(rs, (*rs).prev, state) { return }
    if rs_state.sbool(&(*rs).reg, state, "powered") && !rs_core.rs_pending(rs, x, y, z, kind_of(rs, state)) {
        let off: i32 = rs_state.sset_bool(&(*rs).reg, state, "powered", false)
        rs_core.rs_set(rs, x, y, z, off, 18)
        rs_diode.update_in_front(rs, x, y, z, off)
    }
}

fn removed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, old: i32) {
    if rs_core.rs_same_block(rs, old, rs_core.rs_get(rs, x, y, z)) { return }
    if rs_state.sbool(&(*rs).reg, old, "powered") && rs_core.rs_pending(rs, x, y, z, kind_of(rs, old)) {
        rs_diode.update_in_front(rs, x, y, z, rs_state.sset_bool(&(*rs).reg, old, "powered", false))
    }
}

fn place_state(rs: *mut rs_core.Rs, state: i32, face: i32, hdir: i32, x: i32, y: i32, z: i32) -> i32 {
    return rs_state.sset_dir(&(*rs).reg, state, "facing", (*rs).look)
}

fn comp_observer() -> rs_core.Comp {
    var c: rs_core.Comp = rs_core.comp_default(rs_core.TAG_OBSERVER)
    c.source = true
    c.tick = tick
    c.signal = signal
    c.direct = signal
    c.placed = placed
    c.removed = removed
    c.place_state = place_state
    c.shape = shape
    return c
}
