import mc.server.rs.rs_core
import mc.server.rs.rs_dir
import mc.server.rs.rs_state

export { comp_repeater }

fn delay_ticks(rs: *mut rs_core.Rs, state: i32) -> i32 {
    return rs_state.sint(&(*rs).reg, state, "delay") * 2
}

fn input_signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> i32 {
    let d: i32 = rs_state.sdir(&(*rs).reg, state, "facing")
    let px: i32 = x + rs_dir.dir_dx(d)
    let py: i32 = y + rs_dir.dir_dy(d)
    let pz: i32 = z + rs_dir.dir_dz(d)
    let i: i32 = rs_core.rs_signal(rs, px, py, pz, d)
    if i >= 15 { return i }
    let bs: i32 = rs_core.rs_get(rs, px, py, pz)
    if rs_core.rs_tag_of_state(rs, bs) == rs_core.TAG_WIRE {
        let w: i32 = rs_state.sint(&(*rs).reg, bs, "power")
        if w > i { return w }
    }
    return i
}

fn should_prioritize(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> bool {
    let d: i32 = rs_state.sdir(&(*rs).reg, state, "facing")
    let o: i32 = rs_dir.dir_opposite(d)
    let bs: i32 = rs_core.rs_get(rs, x + rs_dir.dir_dx(o), y + rs_dir.dir_dy(o), z + rs_dir.dir_dz(o))
    return rs_core.rs_tag_of_state(rs, bs) == rs_core.TAG_REPEATER && rs_state.sdir(&(*rs).reg, bs, "facing") != d
}

fn update_in_front(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    let d: i32 = rs_state.sdir(&(*rs).reg, state, "facing")
    let o: i32 = rs_dir.dir_opposite(d)
    let fx: i32 = x + rs_dir.dir_dx(o)
    let fy: i32 = y + rs_dir.dir_dy(o)
    let fz: i32 = z + rs_dir.dir_dz(o)
    rs_core.rs_notify(rs, fx, fy, fz)
    rs_core.rs_update_except(rs, fx, fy, fz, d)
}

fn neighbor_changed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    let k: i32 = rs_core.rs_kind_of_state(rs, state)
    let powered: bool = rs_state.sbool(&(*rs).reg, state, "powered")
    let want: bool = input_signal(rs, x, y, z, state) > 0
    if powered != want && !rs_core.rs_will_tick_this_tick(rs, x, y, z, k) {
        var prio: i32 = rs_core.PRIO_HIGH
        if should_prioritize(rs, x, y, z, state) {
            prio = rs_core.PRIO_EXTREMELY_HIGH
        } else if powered {
            prio = rs_core.PRIO_VERY_HIGH
        }
        rs_core.rs_schedule(rs, x, y, z, k, delay_ticks(rs, state), prio)
    }
}

fn tick(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    let powered: bool = rs_state.sbool(&(*rs).reg, state, "powered")
    let want: bool = input_signal(rs, x, y, z, state) > 0
    if powered && !want {
        rs_core.rs_set(rs, x, y, z, rs_state.sset_bool(&(*rs).reg, state, "powered", false), 2)
    } else if !powered {
        rs_core.rs_set(rs, x, y, z, rs_state.sset_bool(&(*rs).reg, state, "powered", true), 2)
        if !want { rs_core.rs_schedule(rs, x, y, z, rs_core.rs_kind_of_state(rs, state), delay_ticks(rs, state), rs_core.PRIO_VERY_HIGH) }
    }
}

fn signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32, dir: i32) -> i32 {
    if rs_state.sbool(&(*rs).reg, state, "powered") && rs_state.sdir(&(*rs).reg, state, "facing") == dir { return 15 }
    return 0
}

fn placed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    update_in_front(rs, x, y, z, state)
}

fn removed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, old: i32) {
    if rs_core.rs_same_block(rs, old, rs_core.rs_get(rs, x, y, z)) { return }
    update_in_front(rs, x, y, z, old)
}

fn place_state(rs: *mut rs_core.Rs, state: i32, face: i32, hdir: i32, x: i32, y: i32, z: i32) -> i32 {
    var s: i32 = rs_state.sset_dir(&(*rs).reg, state, "facing", rs_dir.dir_opposite(hdir))
    if input_signal(rs, x, y, z, s) > 0 { s = rs_state.sset_bool(&(*rs).reg, s, "powered", true) }
    return s
}

fn comp_repeater() -> rs_core.Comp {
    var c: rs_core.Comp = rs_core.comp_default(rs_core.TAG_REPEATER)
    c.source = true
    c.neighbor_changed = neighbor_changed
    c.tick = tick
    c.signal = signal
    c.direct = signal
    c.placed = placed
    c.removed = removed
    c.place_state = place_state
    return c
}
