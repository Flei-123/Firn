import mc.server.rs.rs_core

export { comp_block }

fn signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32, dir: i32) -> i32 {
    return 15
}

fn comp_block() -> rs_core.Comp {
    var c: rs_core.Comp = rs_core.comp_default(rs_core.TAG_BLOCK)
    c.source = true
    c.signal = signal
    return c
}
