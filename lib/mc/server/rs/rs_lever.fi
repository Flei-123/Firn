import mc.server.rs.rs_core
import mc.server.rs.rs_attached
import mc.server.rs.rs_state

export { comp_lever }

fn use_block(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> bool {
    rs_attached.set_powered(rs, x, y, z, state, !rs_state.sbool(&(*rs).reg, state, "powered"))
    return true
}

fn comp_lever() -> rs_core.Comp {
    var c: rs_core.Comp = rs_core.comp_default(rs_core.TAG_LEVER)
    c.source = true
    c.signal = rs_attached.attached_signal
    c.direct = rs_attached.attached_direct
    c.use_block = use_block
    c.removed = rs_attached.attached_removed
    c.place_state = rs_attached.attached_place_state
    return c
}
