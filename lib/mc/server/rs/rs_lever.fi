import mc.server.rs.rs_core
import mc.server.rs.rs_dir
import mc.server.rs.rs_state

export { comp_lever }

fn connected_dir(rs: *mut rs_core.Rs, state: i32) -> i32 {
    if rs_state.stext_is(&(*rs).reg, state, "face", "ceiling") { return rs_dir.DOWN }
    if rs_state.stext_is(&(*rs).reg, state, "face", "floor") { return rs_dir.UP }
    return rs_state.sdir(&(*rs).reg, state, "facing")
}

fn update_neighbours(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    rs_core.rs_update_at(rs, x, y, z)
    let o: i32 = rs_dir.dir_opposite(connected_dir(rs, state))
    rs_core.rs_update_at(rs, x + rs_dir.dir_dx(o), y + rs_dir.dir_dy(o), z + rs_dir.dir_dz(o))
}

fn signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32, dir: i32) -> i32 {
    if rs_state.sbool(&(*rs).reg, state, "powered") { return 15 }
    return 0
}

fn direct(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32, dir: i32) -> i32 {
    if rs_state.sbool(&(*rs).reg, state, "powered") && connected_dir(rs, state) == dir { return 15 }
    return 0
}

fn use_block(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> bool {
    let on: bool = rs_state.sbool(&(*rs).reg, state, "powered")
    let ns: i32 = rs_state.sset_bool(&(*rs).reg, state, "powered", !on)
    rs_core.rs_set(rs, x, y, z, ns, 3)
    update_neighbours(rs, x, y, z, ns)
    return true
}

fn removed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, old: i32) {
    if rs_core.rs_same_block(rs, old, rs_core.rs_get(rs, x, y, z)) { return }
    if rs_state.sbool(&(*rs).reg, old, "powered") { update_neighbours(rs, x, y, z, old) }
}

fn place_state(rs: *mut rs_core.Rs, state: i32, face: i32, hdir: i32, x: i32, y: i32, z: i32) -> i32 {
    var s: i32 = state
    if face == rs_dir.UP {
        s = rs_state.sset_text(&(*rs).reg, s, "face", "floor")
        s = rs_state.sset_dir(&(*rs).reg, s, "facing", hdir)
    } else if face == rs_dir.DOWN {
        s = rs_state.sset_text(&(*rs).reg, s, "face", "ceiling")
        s = rs_state.sset_dir(&(*rs).reg, s, "facing", hdir)
    } else {
        s = rs_state.sset_text(&(*rs).reg, s, "face", "wall")
        s = rs_state.sset_dir(&(*rs).reg, s, "facing", face)
    }
    return s
}

fn comp_lever() -> rs_core.Comp {
    var c: rs_core.Comp = rs_core.comp_default(rs_core.TAG_LEVER)
    c.source = true
    c.signal = signal
    c.direct = direct
    c.use_block = use_block
    c.removed = removed
    c.place_state = place_state
    return c
}
