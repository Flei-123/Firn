import mc.server.rs.rs_core
import mc.server.rs.rs_attached
import mc.server.rs.rs_state

export { comp_button_stone, comp_button_wood }

const STONE_TICKS: i32 = 20
const WOOD_TICKS: i32 = 30

fn press(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32, ticks: i32) -> bool {
    if rs_state.sbool(&(*rs).reg, state, "powered") { return true }
    rs_attached.set_powered(rs, x, y, z, state, true)
    rs_core.rs_schedule(rs, x, y, z, rs_core.rs_kind_of_state(rs, state), ticks, rs_core.PRIO_NORMAL)
    return true
}

fn use_stone(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> bool {
    return press(rs, x, y, z, state, STONE_TICKS)
}

fn use_wood(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> bool {
    return press(rs, x, y, z, state, WOOD_TICKS)
}

fn tick(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    if rs_state.sbool(&(*rs).reg, state, "powered") { rs_attached.set_powered(rs, x, y, z, state, false) }
}

fn base(use_block: fn(*mut rs_core.Rs, i32, i32, i32, i32) -> bool) -> rs_core.Comp {
    var c: rs_core.Comp = rs_core.comp_default(rs_core.TAG_BUTTON)
    c.source = true
    c.signal = rs_attached.attached_signal
    c.direct = rs_attached.attached_direct
    c.use_block = use_block
    c.tick = tick
    c.removed = rs_attached.attached_removed
    c.place_state = rs_attached.attached_place_state
    return c
}

fn comp_button_stone() -> rs_core.Comp { return base(use_stone) }

fn comp_button_wood() -> rs_core.Comp { return base(use_wood) }
