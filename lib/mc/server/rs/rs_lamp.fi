import mc.server.rs.rs_core
import mc.server.rs.rs_state

export { comp_lamp }

const OFF_DELAY: i32 = 4

fn neighbor_changed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    let lit: bool = rs_state.sbool(&(*rs).reg, state, "lit")
    let has: bool = rs_core.rs_has_neighbor_signal(rs, x, y, z)
    if lit && !has {
        rs_core.rs_schedule(rs, x, y, z, rs_core.rs_kind_of_state(rs, state), OFF_DELAY, rs_core.PRIO_NORMAL)
    } else if !lit && has {
        rs_core.rs_set(rs, x, y, z, rs_state.sset_bool(&(*rs).reg, state, "lit", true), 2)
    }
}

fn tick(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    if rs_state.sbool(&(*rs).reg, state, "lit") && !rs_core.rs_has_neighbor_signal(rs, x, y, z) {
        rs_core.rs_set(rs, x, y, z, rs_state.sset_bool(&(*rs).reg, state, "lit", false), 2)
    }
}

fn place_state(rs: *mut rs_core.Rs, state: i32, face: i32, hdir: i32, x: i32, y: i32, z: i32) -> i32 {
    return rs_state.sset_bool(&(*rs).reg, state, "lit", rs_core.rs_has_neighbor_signal(rs, x, y, z))
}

fn comp_lamp() -> rs_core.Comp {
    var c: rs_core.Comp = rs_core.comp_default(rs_core.TAG_LAMP)
    c.conductor = true
    c.neighbor_changed = neighbor_changed
    c.tick = tick
    c.place_state = place_state
    return c
}
