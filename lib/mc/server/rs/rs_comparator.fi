import mc.server.rs.rs_core
import mc.server.rs.rs_dir
import mc.server.rs.rs_diode
import mc.server.rs.rs_state

export { comp_comparator }

const OUTPUT_DELAY: i32 = 2

fn side_signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, dir: i32) -> i32 {
    let sx: i32 = x + rs_dir.dir_dx(dir)
    let sy: i32 = y + rs_dir.dir_dy(dir)
    let sz: i32 = z + rs_dir.dir_dz(dir)
    let s: i32 = rs_core.rs_get(rs, sx, sy, sz)
    let k: i32 = rs_core.rs_kind_of_state(rs, s)
    if k < 0 { return 0 }
    let tag: i32 = rs_core.rs_tag_of_state(rs, s)
    if tag == rs_core.TAG_WIRE { return rs_state.sint(&(*rs).reg, s, "power") }
    if tag == rs_core.TAG_BLOCK { return 15 }
    if (*rs_core.rs_comp_at(rs, k)).source { return rs_core.rs_direct_signal(rs, sx, sy, sz, dir) }
    return 0
}

fn alternate_signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> i32 {
    let f: i32 = rs_state.sdir(&(*rs).reg, state, "facing")
    let a: i32 = side_signal(rs, x, y, z, rs_dir.dir_cw(f))
    let b: i32 = side_signal(rs, x, y, z, rs_dir.dir_ccw(f))
    if a > b { return a }
    return b
}

fn subtract_mode(rs: *mut rs_core.Rs, state: i32) -> bool {
    return rs_state.stext_is(&(*rs).reg, state, "mode", "subtract")
}

fn output_signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> i32 {
    let i: i32 = rs_diode.input_signal(rs, x, y, z, state)
    if i == 0 { return 0 }
    let j: i32 = alternate_signal(rs, x, y, z, state)
    if j > i { return 0 }
    if subtract_mode(rs, state) { return i - j }
    return i
}

fn should_turn_on(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> bool {
    let i: i32 = rs_diode.input_signal(rs, x, y, z, state)
    if i == 0 { return false }
    let j: i32 = alternate_signal(rs, x, y, z, state)
    if i > j { return true }
    return i == j && !subtract_mode(rs, state)
}

fn neighbor_changed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    let k: i32 = rs_core.rs_kind_of_state(rs, state)
    if rs_core.rs_will_tick_this_tick(rs, x, y, z, k) { return }
    let powered: bool = rs_state.sbool(&(*rs).reg, state, "powered")
    if output_signal(rs, x, y, z, state) != rs_core.rs_aux_get(rs, x, y, z) || powered != should_turn_on(rs, x, y, z, state) {
        var prio: i32 = rs_core.PRIO_HIGH
        if rs_diode.should_prioritize(rs, x, y, z, state) { prio = rs_core.PRIO_EXTREMELY_HIGH }
        rs_core.rs_schedule(rs, x, y, z, k, OUTPUT_DELAY, prio)
    }
}

fn refresh_output(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    let i: i32 = output_signal(rs, x, y, z, state)
    let j: i32 = rs_core.rs_aux_get(rs, x, y, z)
    rs_core.rs_aux_set(rs, x, y, z, i)
    if j == i && subtract_mode(rs, state) { return }
    let on: bool = should_turn_on(rs, x, y, z, state)
    let powered: bool = rs_state.sbool(&(*rs).reg, state, "powered")
    if powered && !on {
        rs_core.rs_set(rs, x, y, z, rs_state.sset_bool(&(*rs).reg, state, "powered", false), 2)
    } else if !powered && on {
        rs_core.rs_set(rs, x, y, z, rs_state.sset_bool(&(*rs).reg, state, "powered", true), 2)
    }
    rs_diode.update_in_front(rs, x, y, z, state)
}

fn tick(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    refresh_output(rs, x, y, z, state)
}

fn use_block(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> bool {
    var mode: str = "subtract"
    if subtract_mode(rs, state) { mode = "compare" }
    let ns: i32 = rs_state.sset_text(&(*rs).reg, state, "mode", mode)
    rs_core.rs_set(rs, x, y, z, ns, 2)
    refresh_output(rs, x, y, z, ns)
    return true
}

fn signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32, dir: i32) -> i32 {
    if !rs_state.sbool(&(*rs).reg, state, "powered") || rs_state.sdir(&(*rs).reg, state, "facing") != dir { return 0 }
    return rs_core.rs_aux_get(rs, x, y, z)
}

fn placed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    rs_diode.update_in_front(rs, x, y, z, state)
    if rs_core.rs_same_block(rs, (*rs).prev, state) { return }
    if should_turn_on(rs, x, y, z, state) { rs_core.rs_schedule(rs, x, y, z, rs_core.rs_kind_of_state(rs, state), 1, rs_core.PRIO_NORMAL) }
}

fn removed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, old: i32) {
    if rs_core.rs_same_block(rs, old, rs_core.rs_get(rs, x, y, z)) { return }
    rs_core.rs_aux_set(rs, x, y, z, 0)
    rs_diode.update_in_front(rs, x, y, z, old)
}

fn place_state(rs: *mut rs_core.Rs, state: i32, face: i32, hdir: i32, x: i32, y: i32, z: i32) -> i32 {
    return rs_state.sset_dir(&(*rs).reg, state, "facing", rs_dir.dir_opposite(hdir))
}

fn comp_comparator() -> rs_core.Comp {
    var c: rs_core.Comp = rs_core.comp_default(rs_core.TAG_COMPARATOR)
    c.source = true
    c.neighbor_changed = neighbor_changed
    c.tick = tick
    c.signal = signal
    c.direct = signal
    c.use_block = use_block
    c.placed = placed
    c.removed = removed
    c.place_state = place_state
    return c
}
