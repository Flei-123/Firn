import mc.server.rs.rs_core
import mc.server.rs.rs_dir
import mc.server.rs.rs_state

export { comp_torch }

const TICK_DELAY: i32 = 2

fn wall_facing(rs: *mut rs_core.Rs, state: i32) -> i32 {
    return rs_state.sdir(&(*rs).reg, state, "facing")
}

fn lit_signal(rs: *mut rs_core.Rs, state: i32, dir: i32) -> i32 {
    if !rs_state.sbool(&(*rs).reg, state, "lit") { return 0 }
    var away: i32 = wall_facing(rs, state)
    if away < 0 { away = rs_dir.UP }
    if dir == away { return 0 }
    return 15
}

fn signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32, dir: i32) -> i32 {
    return lit_signal(rs, state, dir)
}

fn direct(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32, dir: i32) -> i32 {
    if dir == rs_dir.DOWN { return lit_signal(rs, state, dir) }
    return 0
}

fn has_neighbor_signal(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) -> bool {
    var d: i32 = rs_dir.DOWN
    let f: i32 = wall_facing(rs, state)
    if f >= 0 { d = rs_dir.dir_opposite(f) }
    return rs_core.rs_signal(rs, x + rs_dir.dir_dx(d), y + rs_dir.dir_dy(d), z + rs_dir.dir_dz(d), d) > 0
}

fn neighbor_changed(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    let k: i32 = rs_core.rs_kind_of_state(rs, state)
    if rs_state.sbool(&(*rs).reg, state, "lit") == has_neighbor_signal(rs, x, y, z, state) && !rs_core.rs_will_tick_this_tick(rs, x, y, z, k) {
        rs_core.rs_schedule(rs, x, y, z, k, TICK_DELAY, rs_core.PRIO_NORMAL)
    }
}

fn tick(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    let has: bool = has_neighbor_signal(rs, x, y, z, state)
    let lit: bool = rs_state.sbool(&(*rs).reg, state, "lit")
    if lit && has {
        rs_core.rs_set(rs, x, y, z, rs_state.sset_bool(&(*rs).reg, state, "lit", false), 3)
    } else if !lit && !has {
        rs_core.rs_set(rs, x, y, z, rs_state.sset_bool(&(*rs).reg, state, "lit", true), 3)
    }
}

fn update_all(rs: *mut rs_core.Rs, x: i32, y: i32, z: i32, state: i32) {
    var d: i32 = 0
    while d < 6 {
        rs_core.rs_update_at(rs, x + rs_dir.dir_dx(d), y + rs_dir.dir_dy(d), z + rs_dir.dir_dz(d))
        d = d + 1
    }
}

fn place_state(rs: *mut rs_core.Rs, state: i32, face: i32, hdir: i32, x: i32, y: i32, z: i32) -> i32 {
    if face == rs_dir.UP || face == rs_dir.DOWN { return state }
    let b: i32 = rs_state.block_named(&(*rs).reg, "redstone_wall_torch")
    if b < 0 { return state }
    return rs_state.sset_dir(&(*rs).reg, rs_core.block_default_state(rs, b), "facing", face)
}


fn comp_torch() -> rs_core.Comp {
    var c: rs_core.Comp = rs_core.comp_default(rs_core.TAG_TORCH)
    c.source = true
    c.neighbor_changed = neighbor_changed
    c.tick = tick
    c.signal = signal
    c.direct = direct
    c.placed = update_all
    c.removed = update_all
    c.place_state = place_state
    return c
}
