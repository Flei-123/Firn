// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_ops.fi -- operator permission level of a session from the config list ("Name:level,Name" or "*" for everyone).

import std.rt
import mc.server.sv_state

export { op_level, OP_DEFAULT_LEVEL }

const OP_DEFAULT_LEVEL: i32 = 4
const CH_COMMA: u8 = 44 as u8
const CH_COLON: u8 = 58 as u8
const CH_STAR: u8 = 42 as u8

fn entry_end(list: str, from: usize) -> usize {
    var j: usize = from
    while j < list.n && rt.ld8(list.p as u64, j) != CH_COMMA {
        j = j + 1
    }
    return j
}

fn name_end(list: str, from: usize, to: usize) -> usize {
    var k: usize = from
    while k < to && rt.ld8(list.p as u64, k) != CH_COLON {
        k = k + 1
    }
    return k
}

fn name_is(list: str, from: usize, to: usize, s: *mut sv_state.Session) -> bool {
    if to - from == 1 && rt.ld8(list.p as u64, from) == CH_STAR {
        return true
    }
    if to - from != (*s).name_n {
        return false
    }
    var i: usize = 0
    while i < to - from {
        if rt.ld8(list.p as u64, from + i) != (*s).name[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn level_of(list: str, from: usize, to: usize) -> i32 {
    if from >= to {
        return OP_DEFAULT_LEVEL
    }
    var v: i32 = 0
    var i: usize = from
    while i < to {
        v = v * 10 + (rt.ld8(list.p as u64, i) as i32 - 48)
        i = i + 1
    }
    return v
}

fn op_level(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> i32 {
    let list: str = (*srv).cfg.ops
    var i: usize = 0
    while i < list.n {
        let end: usize = entry_end(list, i)
        let colon: usize = name_end(list, i, end)
        if name_is(list, i, colon, s) {
            if colon >= end {
                return OP_DEFAULT_LEVEL
            }
            return level_of(list, colon + 1, end)
        }
        i = end + 1
    }
    return 0
}
