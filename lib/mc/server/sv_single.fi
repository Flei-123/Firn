// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_single.fi -- "--singleplayer [world]" for a game client: starts the integrated server on a free loopback port.

import std.rt
import std.env
import std.io
import mc.server.sv_host

export { single_requested, single_start, single_stop }

const FLAG: str = "--singleplayer"
const DEFAULT_VIEW: i32 = 8
const DEFAULT_NAME: str = "Player"
const LOOPBACK: str = "127.0.0.1"
const CREATIVE: i32 = 1

fn single_requested(start: u64, argc: usize) -> bool {
    if argc < 2 { return false }
    let a: u64 = rt.arg_ptr(start, 1)
    return rt.c_length(a) == FLAG.n && rt.mem_eq(a, FLAG.p as u64, FLAG.n)
}

fn env_int(name: str, fallback: i32) -> i32 {
    var raw: rt.Buf = rt.buf_new()
    var v: i32 = fallback
    if env.get_into(name, &raw) && raw.len > 0 {
        v = 0
        var i: usize = 0
        while i < raw.len {
            let d: u8 = rt.ld8(raw.ptr, i)
            if d < 48 as u8 || d > 57 as u8 { break }
            v = v * 10 + (d - 48 as u8) as i32
            i = i + 1
        }
    }
    rt.buf_free(&raw)
    return v
}

fn push_cstr(out: *mut rt.Buf, text: str) {
    rt.buf_clear(out)
    rt.buf_push_bytes(out, text.p as u64, text.n)
    rt.buf_push(out, 0 as u8)
}

fn single_start(h: *mut sv_host.Host, start: u64, argc: usize, host_out: *mut rt.Buf, name_out: *mut rt.Buf, port_out: *mut i32) -> bool {
    var world: str = ""
    if argc >= 3 {
        let w: u64 = rt.arg_ptr(start, 2)
        world = str { p: w as *mut u8, n: rt.c_length(w) }
    }
    var view: i32 = env_int("MCPLAY_SP_VIEW", DEFAULT_VIEW)
    if view < 2 { view = 2 }
    if view > 32 { view = 32 }
    if !sv_host.host_start(h, 0 as u16, view, CREATIVE, world, "*") {
        io.eprint_line("mcplay: cannot start the integrated server")
        return false
    }
    push_cstr(host_out, LOOPBACK)
    var name: rt.Buf = rt.buf_new()
    if env.get_into("MCPLAY_NAME", &name) && name.len > 0 {
        rt.buf_clear(name_out)
        rt.buf_push_bytes(name_out, name.ptr, name.len)
        rt.buf_push(name_out, 0 as u8)
    } else {
        push_cstr(name_out, DEFAULT_NAME)
    }
    rt.buf_free(&name)
    *port_out = sv_host.host_port(h) as i32
    return true
}

fn single_stop(h: *mut sv_host.Host) {
    sv_host.host_stop(h)
}
