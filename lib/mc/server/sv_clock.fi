// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_clock.fi -- tick scheduler of the integrated server (pure integer logic, no IO).
// Mirrors MinecraftServer.runServer: fixed 50 ms ticks, catch-up when behind, "Can't keep up" after 2000 ms.

import std.rt

export {
    TickClock, clock_new, clock_due, clock_wait_ms, clock_behind, clock_overload_check,
    clock_tick_done, clock_avg_us, clock_tps_x100, clock_overload_message,
    TICK_MS, OVERLOAD_BEHIND_MS, OVERLOAD_COOLDOWN_MS, WINDOW,
}

const TICK_MS: i64 = 50
const OVERLOAD_BEHIND_MS: i64 = 2000
const OVERLOAD_COOLDOWN_MS: i64 = 15000
const WINDOW: usize = 100

struct TickClock {
    next_tick: i64,
    last_overload: i64,
    ticks: u64,
    times: [u64; 100],
    filled: usize,
    head: usize,
    sum: u64,
    skipped_ticks: u64,
    overloads: u64,
}

fn clock_new(now: i64) -> TickClock {
    return TickClock { next_tick: now, last_overload: now - OVERLOAD_COOLDOWN_MS, ticks: 0, times: [0; 100],
        filled: 0, head: 0, sum: 0, skipped_ticks: 0, overloads: 0 }
}

fn clock_behind(c: *mut TickClock, now: i64) -> i64 {
    return now - (*c).next_tick
}

fn clock_due(c: *mut TickClock, now: i64) -> bool {
    return now >= (*c).next_tick
}

fn clock_wait_ms(c: *mut TickClock, now: i64) -> i64 {
    let w: i64 = (*c).next_tick - now
    if w < 0 { return 0 }
    return w
}

fn clock_overload_check(c: *mut TickClock, now: i64, behind_ms: *mut i64, behind_ticks: *mut i64) -> bool {
    let behind: i64 = now - (*c).next_tick
    if behind > OVERLOAD_BEHIND_MS && (*c).next_tick - (*c).last_overload >= OVERLOAD_COOLDOWN_MS {
        let n: i64 = behind / TICK_MS
        *behind_ms = behind
        *behind_ticks = n
        (*c).next_tick = (*c).next_tick + n * TICK_MS
        (*c).last_overload = (*c).next_tick
        (*c).skipped_ticks = (*c).skipped_ticks + n as u64
        (*c).overloads = (*c).overloads + 1
        return true
    }
    return false
}

fn clock_tick_done(c: *mut TickClock, duration_us: u64) {
    (*c).next_tick = (*c).next_tick + TICK_MS
    (*c).ticks = (*c).ticks + 1
    if (*c).filled == WINDOW {
        (*c).sum = (*c).sum - (*c).times[(*c).head]
    } else {
        (*c).filled = (*c).filled + 1
    }
    (*c).times[(*c).head] = duration_us
    (*c).sum = (*c).sum + duration_us
    (*c).head = ((*c).head + 1) % WINDOW
}

fn clock_avg_us(c: *mut TickClock) -> u64 {
    if (*c).filled == 0 { return 0 }
    return (*c).sum / (*c).filled as u64
}

fn clock_tps_x100(c: *mut TickClock) -> u64 {
    let avg: u64 = clock_avg_us(c)
    if avg <= 50000 as u64 { return 2000 as u64 }
    return 100000000 as u64 / avg
}

fn clock_overload_message(out: *mut rt.Buf, behind_ms: i64, behind_ticks: i64) {
    var a: str = "Can't keep up! Is the server overloaded? Running "
    var b: str = "ms or "
    var d: str = " ticks behind"
    rt.buf_push_bytes(out, a.p as u64, a.n)
    rt.buf_push_dec_i64(out, behind_ms)
    rt.buf_push_bytes(out, b.p as u64, b.n)
    rt.buf_push_dec_i64(out, behind_ticks)
    rt.buf_push_bytes(out, d.p as u64, d.n)
}
