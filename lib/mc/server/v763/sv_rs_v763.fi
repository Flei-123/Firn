import mc.server.rs.rs_core
import mc.server.rs.rs_lever
import mc.server.rs.rs_lamp
import mc.server.rs.rs_torch
import mc.server.rs.rs_repeater
import mc.server.rs.rs_wire
import mc.server.rs.rs_button
import mc.server.rs.rs_observer
import mc.server.rs.rs_comparator
import mc.server.rs.rs_block

export { rs_bind_v763 }

fn bind_buttons(rs: *mut rs_core.Rs) {
    let stone: i32 = rs_core.rs_register(rs, "stone_button", rs_button.comp_button_stone())
    rs_core.rs_alias(rs, "polished_blackstone_button", stone)
    let wood: i32 = rs_core.rs_register(rs, "oak_button", rs_button.comp_button_wood())
    rs_core.rs_alias(rs, "spruce_button", wood)
    rs_core.rs_alias(rs, "birch_button", wood)
    rs_core.rs_alias(rs, "jungle_button", wood)
    rs_core.rs_alias(rs, "acacia_button", wood)
    rs_core.rs_alias(rs, "dark_oak_button", wood)
    rs_core.rs_alias(rs, "mangrove_button", wood)
    rs_core.rs_alias(rs, "bamboo_button", wood)
    rs_core.rs_alias(rs, "cherry_button", wood)
    rs_core.rs_alias(rs, "crimson_button", wood)
    rs_core.rs_alias(rs, "warped_button", wood)
}

fn rs_bind_v763(rs: *mut rs_core.Rs) {
    rs_core.rs_register(rs, "lever", rs_lever.comp_lever())
    rs_core.rs_register(rs, "redstone_lamp", rs_lamp.comp_lamp())
    rs_core.rs_register(rs, "redstone_torch", rs_torch.comp_torch())
    rs_core.rs_register(rs, "redstone_wall_torch", rs_torch.comp_torch())
    rs_core.rs_register(rs, "repeater", rs_repeater.comp_repeater())
    rs_core.rs_register(rs, "redstone_wire", rs_wire.comp_wire())
    bind_buttons(rs)
    rs_core.rs_register(rs, "observer", rs_observer.comp_observer())
    rs_core.rs_register(rs, "comparator", rs_comparator.comp_comparator())
    rs_core.rs_register(rs, "redstone_block", rs_block.comp_block())
    (*rs).shapes = rs_wire.wire_shapes
}
