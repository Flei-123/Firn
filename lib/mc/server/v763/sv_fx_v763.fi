// lib/mc/server/v763/sv_fx_v763.fi -- player facing effects of protocol 763 (1.20.1): abilities, position, game mode change.

import std.rt
import mc.mc_encode
import mc.mc_sem
import mc.mc_version
import mc.server.sv_state
import mc.server.sv_send
import mc.server.sv_ver

export { send_abilities, send_position, send_position_relative, send_position_to, REL_X, REL_Y, REL_Z, REL_ROT, send_game_mode }

const REL_X: i64 = 1
const REL_Y: i64 = 2
const REL_Z: i64 = 4
const REL_ROT: i64 = 24

const ABILITY_INVULNERABLE: i64 = 1
const ABILITY_FLYING: i64 = 2
const ABILITY_ALLOW_FLYING: i64 = 4
const ABILITY_INSTABUILD: i64 = 8
const GAME_STATE_CHANGE_MODE: i64 = 3

fn ability_flags(mode: i32) -> i64 {
    if mode == sv_ver.GM_CREATIVE {
        return ABILITY_INVULNERABLE | ABILITY_ALLOW_FLYING | ABILITY_INSTABUILD
    }
    if mode == sv_ver.GM_SPECTATOR {
        return ABILITY_INVULNERABLE | ABILITY_FLYING | ABILITY_ALLOW_FLYING
    }
    return 0
}

fn send_abilities(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "flags", ability_flags((*s).gamemode))
    mc_encode.vals_f32(&v, "flyingSpeed", 0.05f)
    mc_encode.vals_f32(&v, "walkingSpeed", 0.1f)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_ABILITIES, &v)
    rt.buf_free(&v)
    return ok
}

fn send_position(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    let id: i32 = (*s).tp_next
    (*s).tp_next = id + 1
    (*s).tp_pending = id
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_f64(&v, "x", (*s).x)
    mc_encode.vals_f64(&v, "y", (*s).y)
    mc_encode.vals_f64(&v, "z", (*s).z)
    mc_encode.vals_f32(&v, "yaw", (*s).yaw)
    mc_encode.vals_f32(&v, "pitch", (*s).pitch)
    mc_encode.vals_i64(&v, "flags", 0)
    mc_encode.vals_i64(&v, "teleportId", id as i64)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_POSITION, &v)
    rt.buf_free(&v)
    return ok
}

fn send_position_to(srv: *mut sv_state.Server, s: *mut sv_state.Session, px: f64, py: f64, pz: f64, yaw: f32, pitch: f32, flags: i64) -> bool {
    let id: i32 = (*s).tp_next
    (*s).tp_next = id + 1
    (*s).tp_pending = id
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_f64(&v, "x", px)
    mc_encode.vals_f64(&v, "y", py)
    mc_encode.vals_f64(&v, "z", pz)
    mc_encode.vals_f32(&v, "yaw", yaw)
    mc_encode.vals_f32(&v, "pitch", pitch)
    mc_encode.vals_i64(&v, "flags", flags)
    mc_encode.vals_i64(&v, "teleportId", id as i64)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_POSITION, &v)
    rt.buf_free(&v)
    return ok
}

fn send_position_relative(srv: *mut sv_state.Server, s: *mut sv_state.Session, px: f64, py: f64, pz: f64, flags: i64) -> bool {
    return send_position_to(srv, s, px, py, pz, 0.0f, 0.0f, flags)
}

fn send_game_mode(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "reason", GAME_STATE_CHANGE_MODE)
    mc_encode.vals_f32(&v, "gameMode", (*s).gamemode as f32)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_GAME_STATE_CHANGE, &v)
    rt.buf_free(&v)
    return ok && send_abilities(srv, s)
}
