// lib/mc/server/v763/sv_join_v763.fi -- the join sequence of protocol 763 (1.20.1): login packet, abilities, spawn, position, time.

import std.rt
import mc.mc_encode
import mc.mc_sem
import mc.mc_version
import mc.server.sv_state
import mc.server.sv_send
import mc.server.sv_play
import mc.server.v763.sv_codec_v763

export { join_send }

const ABILITY_INVULNERABLE: i64 = 1
const ABILITY_ALLOW_FLYING: i64 = 4
const ABILITY_INSTABUILD: i64 = 8

fn send_login(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "entityId", (*s).eid as i64)
    mc_encode.vals_bool(&v, "isHardcore", false)
    mc_encode.vals_i64(&v, "gameMode", (*srv).cfg.game_mode as i64)
    mc_encode.vals_i64(&v, "previousGameMode", 0 - 1)
    mc_encode.vals_raw(&v, "worldNames", "#1")
    sv_send.vals_str(&v, "worldNames[0]", "minecraft:overworld")
    mc_encode.vals_raw(&v, "dimensionCodec", sv_codec_v763.CODEC_VALUE)
    sv_send.vals_str(&v, "worldType", "minecraft:overworld")
    sv_send.vals_str(&v, "worldName", "minecraft:overworld")
    mc_encode.vals_i64(&v, "hashedSeed", 0)
    mc_encode.vals_i64(&v, "maxPlayers", (*srv).cfg.max_players as i64)
    mc_encode.vals_i64(&v, "viewDistance", (*s).view as i64)
    mc_encode.vals_i64(&v, "simulationDistance", (*s).view as i64)
    mc_encode.vals_bool(&v, "reducedDebugInfo", false)
    mc_encode.vals_bool(&v, "enableRespawnScreen", true)
    mc_encode.vals_bool(&v, "isDebug", false)
    mc_encode.vals_bool(&v, "isFlat", true)
    mc_encode.vals_i64(&v, "portalCooldown", 0)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_JOIN_GAME, &v)
    rt.buf_free(&v)
    return ok
}

fn send_abilities(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var flags: i64 = 0
    if (*srv).cfg.game_mode == 1 {
        flags = ABILITY_INVULNERABLE | ABILITY_ALLOW_FLYING | ABILITY_INSTABUILD
    }
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "flags", flags)
    mc_encode.vals_f32(&v, "flyingSpeed", 0.05f)
    mc_encode.vals_f32(&v, "walkingSpeed", 0.1f)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_ABILITIES, &v)
    rt.buf_free(&v)
    return ok
}

fn send_spawn(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "location.x", (*srv).world.spawn_x as i64)
    mc_encode.vals_i64(&v, "location.y", (*srv).world.spawn_y as i64)
    mc_encode.vals_i64(&v, "location.z", (*srv).world.spawn_z as i64)
    mc_encode.vals_f32(&v, "angle", 0.0f)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_SPAWN_POSITION, &v)
    rt.buf_free(&v)
    return ok
}

fn send_position(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    let id: i32 = (*s).tp_next
    (*s).tp_next = id + 1
    (*s).tp_pending = id
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_f64(&v, "x", (*s).x)
    mc_encode.vals_f64(&v, "y", (*s).y)
    mc_encode.vals_f64(&v, "z", (*s).z)
    mc_encode.vals_f32(&v, "yaw", (*s).yaw)
    mc_encode.vals_f32(&v, "pitch", (*s).pitch)
    mc_encode.vals_i64(&v, "flags", 0)
    mc_encode.vals_i64(&v, "teleportId", id as i64)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_POSITION, &v)
    rt.buf_free(&v)
    return ok
}

fn join_send(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    return send_login(srv, s) && send_abilities(srv, s) && send_spawn(srv, s) && sv_play.send_time(srv, s) && send_position(srv, s)
}
