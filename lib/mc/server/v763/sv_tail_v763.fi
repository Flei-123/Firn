// lib/mc/server/v763/sv_tail_v763.fi -- the map_chunk fields of protocol 763 (1.20.1): NBT heightmap, section data, block entities, long light masks.

import std.rt
import std.bytes
import mc.mc_encode
import mc.server.sv_state
import mc.server.sv_world
import mc.server.sv_chunk_enc

export { tail_build }

fn tail_build(srv: *mut sv_state.Server, col: *mut sv_world.Column) {
    let nsec: usize = sv_world.world_sections(&(*srv).world)
    var hm: bytes.Bytes = bytes.bytes_new()
    sv_chunk_enc.chunk_enc_heightmap(&(*srv).enc, (*col).blocks, nsec, &hm)
    var data: bytes.Bytes = bytes.bytes_new()
    sv_chunk_enc.chunk_enc_data(&(*srv).enc, col, nsec, &data)
    rt.buf_clear(&(*srv).tail)
    mc_encode.vals_hex(&(*srv).tail, "heightmaps", bytes.bytes_ptr(&hm), bytes.bytes_len(&hm))
    mc_encode.vals_hex(&(*srv).tail, "chunkData", bytes.bytes_ptr(&data), bytes.bytes_len(&data))
    sv_chunk_enc.chunk_enc_block_entities(col, &(*srv).tail)
    sv_chunk_enc.chunk_enc_light(&(*srv).enc, col, nsec, &(*srv).tail, false)
    bytes.bytes_free(&hm)
    bytes.bytes_free(&data)
}
