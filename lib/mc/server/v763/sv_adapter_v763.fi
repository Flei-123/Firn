// lib/mc/server/v763/sv_adapter_v763.fi -- the protocol 763 (1.20.1) server adapter.

import mc.server.sv_ver
import mc.server.v763.sv_be_v763
import mc.server.v763.sv_codec_v763
import mc.server.v763.sv_ent_v763
import mc.server.v763.sv_fx_v763
import mc.server.v763.sv_join_v763
import mc.server.v763.sv_rs_v763

export { adapter }

fn adapter() -> sv_ver.ServerVersion {
    return sv_ver.ServerVersion {
        protocol: 763,
        biome_default: sv_codec_v763.BIOME_PLAINS,
        be_table: sv_be_v763.BE_TABLE,
        rel_x: sv_fx_v763.REL_X,
        rel_y: sv_fx_v763.REL_Y,
        rel_z: sv_fx_v763.REL_Z,
        rel_rot: sv_fx_v763.REL_ROT,
        join: sv_join_v763.join_send,
        send_position_to: sv_fx_v763.send_position_to,
        send_position_relative: sv_fx_v763.send_position_relative,
        send_game_mode: sv_fx_v763.send_game_mode,
        entity_ops: sv_ent_v763.ops_v763(),
        entity_loot: sv_ent_v763.loot_v763,
        rs_bind: sv_rs_v763.rs_bind_v763,
    }
}
