// lib/mc/server/v763/sv_slot_v763.fi -- client item slot of protocol 763 (present flag, item id, count byte).

import std.rt
import std.bytes

export { read_slot }

fn read_slot(b: *mut bytes.Bytes, item: *mut i32, count: *mut i32) {
    *item = 0
    *count = 0
    if (*b).len == 0 || rt.ld8((*b).data, 0) == 0 as u8 { return }
    (*b).pos = 1
    *item = bytes.get_varint(b) catch 0
    let cb: u8 = bytes.get_u8(b) catch 1 as u8
    *count = cb as i32
}
