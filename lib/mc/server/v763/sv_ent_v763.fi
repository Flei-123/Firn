import std.rt
import mc.mc_encode
import mc.mc_sem
import mc.mc_version
import mc.mc_registry
import mc.server.sv_state
import mc.server.sv_send
import mc.server.ent.ent_table
import mc.server.ent.ent_track

export { ops_v763, loot_v763 }

const VELOCITY_SCALE: f64 = 8000.0
const METADATA_ITEM_KEY: i64 = 8
const METADATA_TYPE_SLOT: i64 = 7
const ACTION_ADD_PLAYER: i32 = 0

fn srv_of(p: u64) -> *mut sv_state.Server { return p as *mut sv_state.Server }

fn sess_of(p: u64) -> *mut sv_state.Session { return p as *mut sv_state.Session }

fn signed_angle(v: f32) -> i64 {
    let a: i32 = ent_track.enc_angle(v)
    if a > 127 { return (a - 256) as i64 }
    return a as i64
}

fn clamp_vel(v: f64) -> i64 {
    var r: f64 = v * VELOCITY_SCALE
    if r > 32767.0 { r = 32767.0 }
    if r < 0.0 - 32767.0 { r = 0.0 - 32767.0 }
    return r as i64
}

fn put_slot(v: *mut rt.Buf, prefix: str, item: i32, count: i32) {
    var k: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&k, prefix.p as u64, prefix.n)
    let base: usize = rt.buf_len(&k)
    if item <= 0 || count <= 0 {
        sv_send.push_str(&k, ".present")
        mc_encode.vals_raw(v, rt.buf_str(&k), "false")
        rt.buf_free(&k)
        return
    }
    sv_send.push_str(&k, ".present")
    mc_encode.vals_raw(v, rt.buf_str(&k), "true")
    rt.buf_set_len(&k, base)
    sv_send.push_str(&k, ".itemId")
    mc_encode.vals_i64(v, rt.buf_str(&k), item as i64)
    rt.buf_set_len(&k, base)
    sv_send.push_str(&k, ".itemCount")
    mc_encode.vals_i64(v, rt.buf_str(&k), count as i64)
    rt.buf_set_len(&k, base)
    sv_send.push_str(&k, ".nbtData")
    mc_encode.vals_raw(v, rt.buf_str(&k), "hex:00")
    rt.buf_free(&k)
}

fn spawn(a: u64, b: u64, e: *mut ent_table.Entity) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "entityId", (*e).eid as i64)
    mc_encode.vals_uuid(&v, if_player_uuid_path((*e).kind), (*e).uuid_hi, (*e).uuid_lo)
    mc_encode.vals_f64(&v, "x", (*e).sent_x)
    mc_encode.vals_f64(&v, "y", (*e).sent_y)
    mc_encode.vals_f64(&v, "z", (*e).sent_z)
    if (*e).kind == ent_table.KIND_PLAYER {
        mc_encode.vals_i64(&v, "yaw", signed_angle((*e).sent_yaw))
        mc_encode.vals_i64(&v, "pitch", signed_angle((*e).sent_pitch))
        sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_NAMED_ENTITY_SPAWN, &v)
    } else {
        mc_encode.vals_i64(&v, "type", (*e).type_id as i64)
        mc_encode.vals_i64(&v, "pitch", signed_angle((*e).sent_pitch))
        mc_encode.vals_i64(&v, "yaw", signed_angle((*e).sent_yaw))
        mc_encode.vals_i64(&v, "headPitch", 0)
        mc_encode.vals_i64(&v, "objectData", 0)
        mc_encode.vals_i64(&v, "velocity.x", clamp_vel((*e).vx))
        mc_encode.vals_i64(&v, "velocity.y", clamp_vel((*e).vy))
        mc_encode.vals_i64(&v, "velocity.z", clamp_vel((*e).vz))
        sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY, &v)
    }
    rt.buf_free(&v)
}

fn if_player_uuid_path(kind: i32) -> str {
    if kind == ent_table.KIND_PLAYER { return "playerUUID" }
    return "objectUUID"
}

fn destroy(a: u64, b: u64, eid: i32) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_raw(&v, "entityIds", "#1")
    mc_encode.vals_i64(&v, "entityIds[0]", eid as i64)
    sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_ENTITY_DESTROY, &v)
    rt.buf_free(&v)
}

fn teleport(a: u64, b: u64, e: *mut ent_table.Entity) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "entityId", (*e).eid as i64)
    mc_encode.vals_f64(&v, "x", (*e).x)
    mc_encode.vals_f64(&v, "y", (*e).y)
    mc_encode.vals_f64(&v, "z", (*e).z)
    mc_encode.vals_i64(&v, "yaw", signed_angle((*e).yaw))
    mc_encode.vals_i64(&v, "pitch", signed_angle((*e).pitch))
    mc_encode.vals_bool(&v, "onGround", (*e).on_ground)
    sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_ENTITY_TELEPORT, &v)
    rt.buf_free(&v)
}

fn rel_move(a: u64, b: u64, e: *mut ent_table.Entity, dx: i32, dy: i32, dz: i32) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "entityId", (*e).eid as i64)
    mc_encode.vals_i64(&v, "dX", dx as i64)
    mc_encode.vals_i64(&v, "dY", dy as i64)
    mc_encode.vals_i64(&v, "dZ", dz as i64)
    mc_encode.vals_bool(&v, "onGround", (*e).on_ground)
    sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_REL_ENTITY_MOVE, &v)
    rt.buf_free(&v)
}

fn rel_move_look(a: u64, b: u64, e: *mut ent_table.Entity, dx: i32, dy: i32, dz: i32) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "entityId", (*e).eid as i64)
    mc_encode.vals_i64(&v, "dX", dx as i64)
    mc_encode.vals_i64(&v, "dY", dy as i64)
    mc_encode.vals_i64(&v, "dZ", dz as i64)
    mc_encode.vals_i64(&v, "yaw", signed_angle((*e).yaw))
    mc_encode.vals_i64(&v, "pitch", signed_angle((*e).pitch))
    mc_encode.vals_bool(&v, "onGround", (*e).on_ground)
    sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_ENTITY_MOVE_LOOK, &v)
    rt.buf_free(&v)
}

fn head(a: u64, b: u64, e: *mut ent_table.Entity) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "entityId", (*e).eid as i64)
    mc_encode.vals_i64(&v, "headYaw", signed_angle((*e).yaw))
    sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_ENTITY_HEAD_ROTATION, &v)
    rt.buf_free(&v)
}

fn velocity(a: u64, b: u64, e: *mut ent_table.Entity) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "entityId", (*e).eid as i64)
    mc_encode.vals_i64(&v, "velocity.x", clamp_vel((*e).vx))
    mc_encode.vals_i64(&v, "velocity.y", clamp_vel((*e).vy))
    mc_encode.vals_i64(&v, "velocity.z", clamp_vel((*e).vz))
    sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_ENTITY_VELOCITY, &v)
    rt.buf_free(&v)
}

fn metadata(a: u64, b: u64, e: *mut ent_table.Entity) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "entityId", (*e).eid as i64)
    mc_encode.vals_i64(&v, "metadata[0].key", METADATA_ITEM_KEY)
    mc_encode.vals_i64(&v, "metadata[0].type", METADATA_TYPE_SLOT)
    put_slot(&v, "metadata[0].value", (*e).item, (*e).count)
    sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_ENTITY_METADATA, &v)
    rt.buf_free(&v)
}

fn collect(a: u64, b: u64, collected: i32, collector: i32, n: i32) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "collectedEntityId", collected as i64)
    mc_encode.vals_i64(&v, "collectorEntityId", collector as i64)
    mc_encode.vals_i64(&v, "pickupItemCount", n as i64)
    sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_COLLECT, &v)
    rt.buf_free(&v)
}

fn inv_slot(a: u64, b: u64, slot: i32, item: i32, n: i32) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "windowId", 0)
    mc_encode.vals_i64(&v, "stateId", 0)
    mc_encode.vals_i64(&v, "slot", slot as i64)
    put_slot(&v, "item", item, n)
    sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_SET_SLOT, &v)
    rt.buf_free(&v)
}

fn player_add(a: u64, b: u64, owner: u64, e: *mut ent_table.Entity) {
    let o: *mut sv_state.Session = sess_of(owner)
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_raw(&v, "action.add_player", "true")
    mc_encode.vals_raw(&v, "action.update_game_mode", "true")
    mc_encode.vals_raw(&v, "action.update_listed", "true")
    mc_encode.vals_raw(&v, "action.update_latency", "true")
    mc_encode.vals_raw(&v, "data", "#1")
    mc_encode.vals_uuid(&v, "data[0].uuid", (*e).uuid_hi, (*e).uuid_lo)
    mc_encode.vals_text(&v, "data[0].player.name", (&(*o).name[0]) as u64, (*o).name_n)
    mc_encode.vals_raw(&v, "data[0].player.properties", "#0")
    mc_encode.vals_i64(&v, "data[0].gamemode", (*o).gamemode as i64)
    mc_encode.vals_i64(&v, "data[0].listed", 1)
    mc_encode.vals_i64(&v, "data[0].latency", 0)
    sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_PLAYER_INFO, &v)
    rt.buf_free(&v)
}

fn player_remove(a: u64, b: u64, e: *mut ent_table.Entity) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_raw(&v, "players", "#1")
    mc_encode.vals_uuid(&v, "players[0]", (*e).uuid_hi, (*e).uuid_lo)
    sv_send.send_vals(srv_of(a), sess_of(b), mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_PLAYER_REMOVE, &v)
    rt.buf_free(&v)
}

fn ops_v763() -> ent_table.WireOps {
    return ent_table.WireOps { spawn: spawn, destroy: destroy, teleport: teleport, rel_move: rel_move,
        rel_move_look: rel_move_look, head: head, inv_slot: inv_slot, velocity: velocity, metadata: metadata,
        collect: collect, player_add: player_add, player_remove: player_remove }
}

fn name_is(reg: *mut mc_registry.Registry, block: i32, want: str) -> bool {
    var l: usize = 0
    let p: u64 = mc_registry.reg_block_name(reg, block, &l)
    return l == want.n && rt.mem_eq(p, want.p as u64, l)
}

fn item_named(reg: *mut mc_registry.Registry, want: str) -> i32 {
    return mc_registry.reg_item_by_name(reg, want.p as u64, want.n)
}

fn loot_v763(reg: *mut mc_registry.Registry, block: i32) -> i32 {
    if name_is(reg, block, "stone") { return item_named(reg, "cobblestone") }
    if name_is(reg, block, "grass_block") { return item_named(reg, "dirt") }
    if name_is(reg, block, "bedrock") || name_is(reg, block, "glass") || name_is(reg, block, "grass") || name_is(reg, block, "tall_grass") { return 0 - 1 }
    var l: usize = 0
    let p: u64 = mc_registry.reg_block_name(reg, block, &l)
    return mc_registry.reg_item_by_name(reg, p, l)
}
