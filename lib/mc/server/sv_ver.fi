// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_ver.fi -- the per-protocol server adapter: join sequence, position and game mode packets, block entity table, default biome.

import std.rt
import mc.mc_registry
import mc.server.sv_state
import mc.server.ent.ent_table

export { ServerVersion, adapter_none, adapter_of, adapter_alloc, adapter_free, GM_SURVIVAL, GM_CREATIVE, GM_ADVENTURE, GM_SPECTATOR }

const GM_SURVIVAL: i32 = 0
const GM_CREATIVE: i32 = 1
const GM_ADVENTURE: i32 = 2
const GM_SPECTATOR: i32 = 3

struct ServerVersion {
    protocol: i32,
    biome_default: i32,
    be_table: str,
    rel_x: i64,
    rel_y: i64,
    rel_z: i64,
    rel_rot: i64,
    join: fn(*mut sv_state.Server, *mut sv_state.Session) -> bool,
    send_position_to: fn(*mut sv_state.Server, *mut sv_state.Session, f64, f64, f64, f32, f32, i64) -> bool,
    send_position_relative: fn(*mut sv_state.Server, *mut sv_state.Session, f64, f64, f64, i64) -> bool,
    send_game_mode: fn(*mut sv_state.Server, *mut sv_state.Session) -> bool,
    entity_ops: ent_table.WireOps,
    entity_loot: fn(*mut mc_registry.Registry, i32) -> i32,
}

fn none_join(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool { return false }

fn none_position_to(srv: *mut sv_state.Server, s: *mut sv_state.Session, x: f64, y: f64, z: f64, yaw: f32, pitch: f32, flags: i64) -> bool { return false }

fn none_position_relative(srv: *mut sv_state.Server, s: *mut sv_state.Session, x: f64, y: f64, z: f64, flags: i64) -> bool { return false }

fn none_game_mode(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool { return false }

fn none_loot(reg: *mut mc_registry.Registry, block: i32) -> i32 { return 0 - 1 }

fn adapter_none() -> ServerVersion {
    return ServerVersion { protocol: 0, biome_default: 0, be_table: "", rel_x: 0, rel_y: 0, rel_z: 0, rel_rot: 0,
        join: none_join, send_position_to: none_position_to, send_position_relative: none_position_relative, send_game_mode: none_game_mode,
        entity_ops: ent_table.wire_ops_none(), entity_loot: none_loot }
}

fn adapter_size() -> usize {
    return adapter_size_gen[ServerVersion]()
}

fn adapter_size_gen[T]() -> usize {
    return size_of[T]()
}

fn adapter_of(srv: *mut sv_state.Server) -> *mut ServerVersion {
    return (*srv).adapter as *mut ServerVersion
}

fn adapter_alloc(a: ServerVersion) -> u64 {
    let p: u64 = rt.heap_alloc(adapter_size())
    *(p as *mut ServerVersion) = a
    return p
}

fn adapter_free(p: u64) {
    if p != 0 as u64 { rt.heap_free(p, adapter_size()) }
}
