import mc.mc_registry
import mc.server.sv_state
import mc.server.sv_dim
import mc.server.sv_end
import mc.server.sv_dimsrv
import mc.server.sv_edits
import mc.server.sv_chunks
import mc.server.sv_ver
import mc.server.sv_send
import mc.server.sv_level_sync
import mc.server.v763.sv_fx_v763
import std.rt

export { travel_to, travel_portal, travel_respawn, travel_phase }

const MODE_COMMAND: i32 = 0
const MODE_PORTAL: i32 = 1
const MODE_RESPAWN: i32 = 2

fn state_named(reg: *mut mc_registry.Registry, name: str) -> i32 {
    let b: i32 = mc_registry.reg_block_by_name(reg, name.p as u64, name.n)
    if b < 0 { return 0 }
    return mc_registry.reg_block_default_state(reg, b)
}

fn build_end_platform(d: *mut sv_state.Server) {
    var reg: mc_registry.Registry = (*d).ver.registry_of()
    let obsidian: i32 = state_named(&reg, "obsidian")
    let air: i32 = state_named(&reg, "air")
    var dx: i32 = 0 - 2
    while dx <= 2 {
        var dz: i32 = 0 - 2
        while dz <= 2 {
            sv_edits.edits_set(&(*d).edits, sv_end.END_SPAWN_X + dx, sv_end.END_SPAWN_Y - 2, sv_end.END_SPAWN_Z + dz, obsidian)
            var dy: i32 = 1
            while dy <= 3 {
                sv_edits.edits_set(&(*d).edits, sv_end.END_SPAWN_X + dx, sv_end.END_SPAWN_Y - 2 + dy, sv_end.END_SPAWN_Z + dz, air)
                dy = dy + 1
            }
            dz = dz + 1
        }
        dx = dx + 1
    }
}

fn reset_window(s: *mut sv_state.Session) {
    if (*s).chunks != 0 {
        rt.mem_set((*s).chunks, 0 as u8, ((*s).chunks_w * (*s).chunks_w) as usize * 8)
    }
    (*s).sent_chunks = 0
}

fn travel_with(root: *mut sv_state.Server, s: *mut sv_state.Session, kind: i32, x: f64, y: f64, z: f64, yaw: f32, pitch: f32, mode: i32) -> bool {
    if (*s).dim == kind || !(*s).joined || (*s).closing { return false }
    let target: *mut sv_state.Server = sv_dimsrv.dimsrv_get(root, kind)
    if target as u64 == 0 as u64 { return false }
    let ad: *mut sv_ver.ServerVersion = sv_ver.adapter_of(root)
    if kind == sv_dim.DIM_END && x >= (sv_end.END_SPAWN_X - 2) as f64 && x <= (sv_end.END_SPAWN_X + 3) as f64 && z >= (sv_end.END_SPAWN_Z - 2) as f64 && z <= (sv_end.END_SPAWN_Z + 3) as f64 { build_end_platform(target) }
    reset_window(s)
    (*s).dim = kind
    (*s).x = x
    (*s).y = y
    (*s).z = z
    (*s).yaw = yaw
    (*s).pitch = pitch
    (*s).cx = sv_chunks.chunk_of(x)
    (*s).cz = sv_chunks.chunk_of(z)
    let respawn: fn(*mut sv_state.Server, *mut sv_state.Session) -> bool = (*ad).respawn
    let send_pos: fn(*mut sv_state.Server, *mut sv_state.Session, f64, f64, f64, f32, f32, i64) -> bool = (*ad).send_position_to
    respawn(target, s)
    sv_level_sync.send_difficulty(target, s)
    sv_level_sync.send_permission(target, s)
    if (*ad).declare_commands {
        let declare: fn(*mut sv_state.Server, *mut sv_state.Session) = (*root).on_join
        declare(root, s)
    }
    if (*ad).travel_position_first || mode == MODE_PORTAL {
        send_pos(target, s, x, y, z, yaw, pitch, 0)
        sv_chunks.chunks_send_center(target, s)
    } else {
        sv_chunks.chunks_send_center(target, s)
        send_pos(target, s, x, y, z, yaw, pitch, 0)
    }
    if (*ad).travel_abilities || mode == MODE_PORTAL { sv_fx_v763.send_abilities(target, s) }
    sv_level_sync.send_level_info(target, s)
    let chunks_start: fn(*mut sv_state.Server, *mut sv_state.Session) -> bool = (*ad).chunks_start
    chunks_start(target, s)
    sv_level_sync.send_player_info(target, s, mode == MODE_PORTAL)
    return true
}

fn travel_to(root: *mut sv_state.Server, s: *mut sv_state.Session, kind: i32, x: f64, y: f64, z: f64, yaw: f32, pitch: f32) -> bool {
    return travel_with(root, s, kind, x, y, z, yaw, pitch, MODE_COMMAND)
}

fn travel_respawn(root: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    let home: *mut sv_state.Server = sv_dimsrv.dimsrv_get(root, sv_dim.DIM_OVERWORLD)
    if home as u64 == 0 as u64 { return false }
    return travel_with(root, s, sv_dim.DIM_OVERWORLD, (*home).world.spawn_x as f64 + 0.5, (*home).world.spawn_y as f64, (*home).world.spawn_z as f64 + 0.5, 0.0f, 0.0f, MODE_RESPAWN)
}

fn travel_portal(root: *mut sv_state.Server, s: *mut sv_state.Session, kind: i32, x: f64, y: f64, z: f64, yaw: f32, pitch: f32) -> bool {
    return travel_with(root, s, kind, x, y, z, yaw, pitch, MODE_PORTAL)
}

fn travel_phase(ctx: u64) {
    let root: *mut sv_state.Server = ctx as *mut sv_state.Server
    var i: usize = 0
    while i < sv_state.MAX_SESSIONS {
        let s: *mut sv_state.Session = sv_state.session_at(root, i)
        if (*s).used && (*s).joined && !(*s).closing && (*s).pending_dim >= 0 {
            let kind: i32 = (*s).pending_dim
            (*s).pending_dim = 0 - 1
            travel_to(root, s, kind, (*s).x, (*s).y, (*s).z, (*s).yaw, (*s).pitch)
        }
        i = i + 1
    }
}
