// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_send.fi -- version neutral packet IO of the server: semantic id + value store -> wire, and named
// field reads out of a received body. No packet id and no layout is written here; both come from the version tables.

import std.rt
import std.bytes
import mc.mc_codec
import mc.mc_encode
import mc.mc_schema
import mc.mc_version
import mc.mc_sem
import mc.server.sv_state
import mc.server.sv_ver
import mc.server.sv_text_nbt

export {
    send_vals, send_kick, field_view, field_i64, field_f64, field_f32, field_bool, field_varint, field_text,
    sem_is, vals_component, field_u8, json_text, push_json_escaped, push_str, vals_str, send_system_chat, send_chat_json, send_raw,
}

fn send_vals(srv: *mut sv_state.Server, s: *mut sv_state.Session, state: i32, sem: usize, vals: *mut rt.Buf) -> bool {
    if (*s).closing { return false }
    let id: i32 = (*srv).ver.sem[sem]
    if id < 0 { return false }
    let sch: u64 = (*srv).ver.schema_of(state, mc_version.DIR_S2C, id)
    if sch == 0 { return false }
    var body: bytes.Bytes = bytes.bytes_new()
    var ok: bool = mc_encode.encode_buf(sch, vals, &body, 0 as *mut rt.Buf)
    if ok {
        let n: usize = mc_codec.wire_send_packet(&(*s).wire, id, &body) catch 0
        ok = n > 0
        if !ok { (*s).closing = true }
    }
    bytes.bytes_free(&body)
    return ok
}

fn push_json_escaped(b: *mut rt.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 34 as u8 || c == 92 as u8 {
            rt.buf_push(b, 92 as u8)
            rt.buf_push(b, c)
        } else if c >= 32 as u8 {
            rt.buf_push(b, c)
        }
        i = i + 1
    }
}

fn push_str(b: *mut rt.Buf, t: str) {
    rt.buf_push_bytes(b, t.p as u64, t.n)
}

fn json_text(out: *mut rt.Buf, p: u64, n: usize) {
    push_str(out, "{\"text\":\"")
    push_json_escaped(out, p, n)
    push_str(out, "\"}")
}

fn vals_component(srv: *mut sv_state.Server, vals: *mut rt.Buf, path: str, json_p: u64, json_n: usize) {
    if !(*sv_ver.adapter_of(srv)).text_nbt {
        mc_encode.vals_text(vals, path, json_p, json_n)
        return
    }
    var nbt: bytes.Bytes = bytes.bytes_new()
    sv_text_nbt.text_json_to_nbt(json_p, json_n, &nbt)
    mc_encode.vals_hex(vals, path, bytes.bytes_ptr(&nbt), bytes.bytes_len(&nbt))
    bytes.bytes_free(&nbt)
}

fn send_kick(srv: *mut sv_state.Server, s: *mut sv_state.Session, text: str) {
    var json: rt.Buf = rt.buf_new()
    json_text(&json, text.p as u64, text.n)
    var vals: rt.Buf = rt.buf_new()
    if (*s).state == mc_version.ST_PLAY {
        vals_component(srv, &vals, "reason", rt.buf_ptr(&json), rt.buf_len(&json))
        send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_KICK_DISCONNECT, &vals)
    } else if (*s).state == mc_version.ST_CONFIG {
        vals_component(srv, &vals, "reason", rt.buf_ptr(&json), rt.buf_len(&json))
        send_vals(srv, s, mc_version.ST_CONFIG, mc_sem.SEM_CONFIG_S2C_DISCONNECT, &vals)
    } else if (*s).state == mc_version.ST_LOGIN {
        mc_encode.vals_text(&vals, "reason", rt.buf_ptr(&json), rt.buf_len(&json))
        send_vals(srv, s, mc_version.ST_LOGIN, mc_sem.SEM_LOGIN_S2C_DISCONNECT, &vals)
    }
    rt.buf_free(&vals)
    rt.buf_free(&json)
    (*s).closing = true
}

fn sem_is(srv: *mut sv_state.Server, id: i32, sem: usize) -> bool {
    return id >= 0 && (*srv).ver.sem[sem] == id
}

fn field_view(srv: *mut sv_state.Server, state: i32, id: i32, name: str, body: *mut bytes.Bytes, v: *mut bytes.Bytes) -> bool {
    let sch: u64 = (*srv).ver.schema_of(state, mc_version.DIR_C2S, id)
    if sch == 0 { return false }
    var off: usize = 0
    var len: usize = 0
    if !mc_schema.field_range(sch, name.p as u64, name.n, body, &off, &len) { return false }
    *v = bytes.Bytes { data: bytes.bytes_ptr(body) + off as u64, cap: len, len: len, pos: 0, bad: false }
    return true
}

fn field_i64(srv: *mut sv_state.Server, state: i32, id: i32, name: str, body: *mut bytes.Bytes, out: *mut i64) -> bool {
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !field_view(srv, state, id, name, body, &v) || v.len != 8 { return false }
    *out = bytes.get_i64(&v) catch 0
    return true
}

fn field_f64(srv: *mut sv_state.Server, state: i32, id: i32, name: str, body: *mut bytes.Bytes, out: *mut f64) -> bool {
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !field_view(srv, state, id, name, body, &v) || v.len != 8 { return false }
    *out = bytes.get_f64(&v) catch 0.0
    return true
}

fn field_f32(srv: *mut sv_state.Server, state: i32, id: i32, name: str, body: *mut bytes.Bytes, out: *mut f32) -> bool {
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !field_view(srv, state, id, name, body, &v) || v.len != 4 { return false }
    *out = bytes.get_f32(&v) catch 0.0f
    return true
}

fn field_bool(srv: *mut sv_state.Server, state: i32, id: i32, name: str, body: *mut bytes.Bytes, out: *mut bool) -> bool {
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !field_view(srv, state, id, name, body, &v) || v.len != 1 { return false }
    *out = rt.ld8(v.data, 0) != 0 as u8
    return true
}

fn field_u8(srv: *mut sv_state.Server, state: i32, id: i32, name: str, body: *mut bytes.Bytes, out: *mut u8) -> bool {
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !field_view(srv, state, id, name, body, &v) || v.len != 1 { return false }
    *out = rt.ld8(v.data, 0)
    return true
}

fn field_varint(srv: *mut sv_state.Server, state: i32, id: i32, name: str, body: *mut bytes.Bytes, out: *mut i32) -> bool {
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !field_view(srv, state, id, name, body, &v) { return false }
    *out = bytes.get_varint(&v) catch (0 - 1)
    return true
}

fn field_text(srv: *mut sv_state.Server, state: i32, id: i32, name: str, body: *mut bytes.Bytes, p: *mut u64, n: *mut usize) -> bool {
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !field_view(srv, state, id, name, body, &v) { return false }
    *p = v.data
    *n = v.len
    return true
}

fn vals_str(b: *mut rt.Buf, path: str, t: str) {
    mc_encode.vals_text(b, path, t.p as u64, t.n)
}

fn send_raw(srv: *mut sv_state.Server, s: *mut sv_state.Session, state: i32, sem: usize, p: u64, n: usize) -> bool {
    if (*s).closing { return false }
    let id: i32 = (*srv).ver.sem[sem]
    if id < 0 { return false }
    var body: bytes.Bytes = bytes.Bytes { data: p, cap: n, len: n, pos: 0, bad: false }
    let sent: usize = mc_codec.wire_send_packet(&(*s).wire, id, &body) catch 0
    if sent == 0 { (*s).closing = true }
    return sent > 0
}

fn send_chat_json(srv: *mut sv_state.Server, s: *mut sv_state.Session, p: u64, n: usize) {
    var vals: rt.Buf = rt.buf_new()
    vals_component(srv, &vals, "content", p, n)
    mc_encode.vals_bool(&vals, "isActionBar", false)
    send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_SYSTEM_CHAT, &vals)
    rt.buf_free(&vals)
}

fn send_system_chat(srv: *mut sv_state.Server, s: *mut sv_state.Session, p: u64, n: usize) {
    var json: rt.Buf = rt.buf_new()
    json_text(&json, p, n)
    send_chat_json(srv, s, rt.buf_ptr(&json), rt.buf_len(&json))
    rt.buf_free(&json)
}
