// lib/mc/server/sv_presence.fi -- join and leave announcements (translate multiplayer.player.joined / left) to all joined sessions.

import mc.server.sv_state
import mc.server.sv_send

export { announce_joined, announce_left }

fn announce(srv: *mut sv_state.Server, who: *mut sv_state.Session, key: str) {
    var i: usize = 0
    while i < sv_state.MAX_SESSIONS {
        let o: *mut sv_state.Session = sv_state.session_at(srv, i)
        if o != who && (*o).used && (*o).joined && !(*o).closing {
            sv_send.send_translate(srv, o, key, "yellow", (&(*who).name[0]) as u64, (*who).name_n)
        }
        i = i + 1
    }
}

fn announce_joined(srv: *mut sv_state.Server, who: *mut sv_state.Session) {
    announce(srv, who, "multiplayer.player.joined")
}

fn announce_left(srv: *mut sv_state.Server, who: *mut sv_state.Session) {
    announce(srv, who, "multiplayer.player.left")
}
