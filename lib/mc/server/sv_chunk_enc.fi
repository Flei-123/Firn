// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_chunk_enc.fi -- a world column of global state ids -> the fields of a map_chunk packet
// (1.18+ paletted containers, MOTION_BLOCKING heightmap, sky light of the mixed sections).

import std.rt
import std.bytes
import mc.mc_encode
import mc.server.sv_world

export {
    ChunkEnc, chunk_enc_new, chunk_enc_free, chunk_enc_data, chunk_enc_heightmap, chunk_enc_light, chunk_enc_block_entities,
    chunk_enc_height_prepare, chunk_enc_height_longs, chunk_enc_height_long,
}

const BLOCK_INDIRECT_MAX: u32 = 8
const BLOCK_MIN_BITS: u32 = 4
const MAP_ENTRIES: usize = 65536
const BIOME_INDIRECT_MAX: u32 = 3
const LIGHT_BYTES: usize = 2048
const NONE16: u16 = 65535

struct ChunkEnc {
    map: u64,
    pal: u64,
    tops: u64,
    biome_bits: u32,
    global_bits: u32,
    nolen: bool,
    fluid: bool,
}

fn chunk_enc_new(biome_count: i32, global_bits: u32, nolen: bool, fluid: bool) -> ChunkEnc {
    var e: ChunkEnc = ChunkEnc { map: rt.heap_alloc(MAP_ENTRIES * 2), pal: rt.heap_alloc(8192), tops: rt.heap_alloc(512),
        biome_bits: ceil_log2(biome_count as u32), global_bits: global_bits, nolen: nolen, fluid: fluid }
    var i: usize = 0
    while i < MAP_ENTRIES {
        rt.st16(e.map, i, NONE16)
        i = i + 1
    }
    return e
}

fn chunk_enc_free(e: *mut ChunkEnc) {
    rt.heap_free((*e).map, MAP_ENTRIES * 2)
    rt.heap_free((*e).pal, 8192)
    rt.heap_free((*e).tops, 512)
}

fn ceil_log2(n: u32) -> u32 {
    var b: u32 = 0
    while (1 as u32) << b < n { b = b + 1 }
    return b
}

fn put_container(e: *mut ChunkEnc, out: *mut bytes.Bytes, ids: u64, cells: usize, min_bits: u32, indirect_max: u32, direct_bits: u32) {
    var n: usize = 0
    var i: usize = 0
    while i < cells {
        let id: u16 = rt.ld16(ids, i)
        if rt.ld16((*e).map, id as usize) == NONE16 {
            rt.st16((*e).map, id as usize, n as u16)
            rt.st16((*e).pal, n, id)
            n = n + 1
        }
        i = i + 1
    }
    if n == 1 {
        bytes.put_u8(out, 0 as u8)
        bytes.put_varint(out, rt.ld16((*e).pal, 0) as i32)
        if !(*e).nolen { bytes.put_varint(out, 0) }
    } else {
        var bits: u32 = ceil_log2(n as u32)
        if bits < min_bits { bits = min_bits }
        let direct: bool = bits > indirect_max
        if direct {
            bits = direct_bits
            bytes.put_u8(out, bits as u8)
        } else {
            bytes.put_u8(out, bits as u8)
            bytes.put_varint(out, n as i32)
            var k: usize = 0
            while k < n {
                bytes.put_varint(out, rt.ld16((*e).pal, k) as i32)
                k = k + 1
            }
        }
        let per: usize = (64 as u32 / bits) as usize
        let longs: usize = (cells + per - 1) / per
        if !(*e).nolen { bytes.put_varint(out, longs as i32) }
        var l: usize = 0
        while l < longs {
            var v: u64 = 0
            var j: usize = 0
            while j < per && l * per + j < cells {
                let id: u16 = rt.ld16(ids, l * per + j)
                var entry: u64 = id as u64
                if !direct { entry = rt.ld16((*e).map, id as usize) as u64 }
                v = v | (entry << ((j as u32 * bits) as u64))
                j = j + 1
            }
            bytes.put_u64(out, v)
            l = l + 1
        }
    }
    i = 0
    while i < n {
        rt.st16((*e).map, rt.ld16((*e).pal, i) as usize, NONE16)
        i = i + 1
    }
}

fn chunk_enc_data(e: *mut ChunkEnc, col: *mut sv_world.Column, nsec: usize, out: *mut bytes.Bytes) {
    var s: usize = 0
    while s < nsec {
        let base: u64 = (*col).blocks + (s * 8192) as u64
        var count: i32 = 0
        var i: usize = 0
        while i < 4096 {
            if rt.ld16(base, i) != 0 as u16 { count = count + 1 }
            i = i + 1
        }
        bytes.put_i16(out, count as i16)
        if (*e).fluid { bytes.put_i16(out, 0 as i16) }
        put_container(e, out, base, 4096, BLOCK_MIN_BITS, BLOCK_INDIRECT_MAX, (*e).global_bits)
        put_container(e, out, (*col).biomes + (s * 128) as u64, 64, 1, BIOME_INDIRECT_MAX, (*e).biome_bits)
        s = s + 1
    }
}

fn top_of(blocks: u64, nsec: usize, col: usize) -> i32 {
    var y: i32 = (nsec * 16) as i32 - 1
    while y >= 0 {
        if rt.ld16(blocks, (y as usize) * 256 + col) != 0 as u16 { return y }
        y = y - 1
    }
    return 0 - 1
}

fn chunk_enc_height_prepare(e: *mut ChunkEnc, blocks: u64, nsec: usize) {
    var col: usize = 0
    while col < 256 {
        rt.st16((*e).tops, col, (top_of(blocks, nsec, col) + 1) as u16)
        col = col + 1
    }
}

fn height_bits(nsec: usize) -> u32 {
    return ceil_log2((nsec * 16) as u32 + 1)
}

fn chunk_enc_height_longs(nsec: usize) -> usize {
    let per: usize = (64 as u32 / height_bits(nsec)) as usize
    return (256 + per - 1) / per
}

fn chunk_enc_height_long(e: *mut ChunkEnc, nsec: usize, l: usize) -> u64 {
    let bits: u32 = height_bits(nsec)
    let per: usize = (64 as u32 / bits) as usize
    var v: u64 = 0
    var j: usize = 0
    while j < per && l * per + j < 256 {
        v = v | ((rt.ld16((*e).tops, l * per + j) as u64) << ((j as u32 * bits) as u64))
        j = j + 1
    }
    return v
}

fn chunk_enc_heightmap(e: *mut ChunkEnc, blocks: u64, nsec: usize, out: *mut bytes.Bytes) {
    chunk_enc_height_prepare(e, blocks, nsec)
    let longs: usize = chunk_enc_height_longs(nsec)
    bytes.put_u8(out, 10 as u8)
    bytes.put_u16(out, 0 as u16)
    bytes.put_u8(out, 12 as u8)
    var name: str = "MOTION_BLOCKING"
    bytes.put_u16(out, name.n as u16)
    bytes.put_raw(out, name.p as u64, name.n)
    bytes.put_i32(out, longs as i32)
    var l: usize = 0
    while l < longs {
        bytes.put_u64(out, chunk_enc_height_long(e, nsec, l))
        l = l + 1
    }
    bytes.put_u8(out, 0 as u8)
}

fn push_line_i(b: *mut rt.Buf, key: str, i: usize, tail: str, v: i64) {
    rt.buf_push_bytes(b, key.p as u64, key.n)
    rt.buf_push(b, 91)
    rt.buf_push_dec_u64(b, i as u64)
    rt.buf_push_bytes(b, tail.p as u64, tail.n)
    rt.buf_push_dec_i64(b, v)
    rt.buf_push(b, 10)
}

fn light_from_heights(e: *mut ChunkEnc, col: *mut sv_world.Column, nsec: usize) {
    var c: usize = 0
    while c < 256 {
        rt.st16((*e).tops, c, (top_of((*col).blocks, nsec, c) + 1) as u16)
        c = c + 1
    }
    (*col).sky_empty = 1
    var s: usize = 0
    while s < nsec {
        var lit: usize = 0
        var i: usize = 0
        while i < 4096 {
            let y: usize = s * 16 + i / 256
            if y >= rt.ld16((*e).tops, i % 256) as usize { lit = lit + 1 }
            i = i + 1
        }
        let bit: u64 = (1 as u64) << ((s + 1) as u64)
        if lit == 0 {
            (*col).sky_empty = (*col).sky_empty | bit
        } else if lit < 4096 {
            (*col).sky_mask = (*col).sky_mask | bit
            let slot: u64 = sv_world.column_light_slot(col, true, s + 1)
            var j: usize = 0
            while j < LIGHT_BYTES {
                var lo: u8 = 0
                var hi: u8 = 0
                let i0: usize = j * 2
                if s * 16 + i0 / 256 >= rt.ld16((*e).tops, i0 % 256) as usize { lo = 15 as u8 }
                let i1: usize = j * 2 + 1
                if s * 16 + i1 / 256 >= rt.ld16((*e).tops, i1 % 256) as usize { hi = 15 as u8 }
                rt.st8(slot, j, lo | (hi << 4))
                j = j + 1
            }
        }
        s = s + 1
    }
}

fn emit_mask_bytes(vals: *mut rt.Buf, name: str, mask: u64) {
    var n: usize = 0
    while n < 8 && (mask >> ((n * 8) as u64)) != 0 as u64 { n = n + 1 }
    mc_encode.vals_key(vals, name)
    rt.buf_push(vals, 35)
    rt.buf_push_dec_u64(vals, n as u64)
    rt.buf_push(vals, 10)
    var i: usize = 0
    while i < n {
        push_line_i(vals, name, i, "]=", ((mask >> ((i * 8) as u64)) & (255 as u64)) as i64)
        i = i + 1
    }
}

fn emit_mask(vals: *mut rt.Buf, name: str, mask: u64, as_bytes: bool) {
    if as_bytes {
        emit_mask_bytes(vals, name, mask)
        return
    }
    if mask == 0 as u64 {
        mc_encode.vals_raw(vals, name, "#0")
        return
    }
    mc_encode.vals_raw(vals, name, "#1")
    push_line_i(vals, name, 0, "]=", mask as i64)
}

fn emit_arrays(vals: *mut rt.Buf, col: *mut sv_world.Column, name: str, sky: bool, mask: u64, layers: usize) {
    var arrays: usize = 0
    var i: usize = 0
    while i < layers {
        if (mask >> (i as u64)) & (1 as u64) != 0 as u64 { arrays = arrays + 1 }
        i = i + 1
    }
    mc_encode.vals_key(vals, name)
    rt.buf_push(vals, 35)
    rt.buf_push_dec_u64(vals, arrays as u64)
    rt.buf_push(vals, 10)
    var a: usize = 0
    i = 0
    while i < layers {
        if (mask >> (i as u64)) & (1 as u64) != 0 as u64 {
            let slot: u64 = sv_world.column_light_slot(col, sky, i)
            var pass: usize = 0
            while pass < 2 {
                rt.buf_push_bytes(vals, name.p as u64, name.n)
                rt.buf_push(vals, 91)
                rt.buf_push_dec_u64(vals, a as u64)
                if pass == 0 {
                    rt.buf_push_bytes(vals, "]=#2048\n".p as u64, 8)
                } else {
                    rt.buf_push_bytes(vals, "]=hex:".p as u64, 6)
                    var j: usize = 0
                    while j < LIGHT_BYTES {
                        rt.buf_push_hex_u64(vals, rt.ld8(slot, j) as u64, 2)
                        j = j + 1
                    }
                    rt.buf_push(vals, 10)
                }
                pass = pass + 1
            }
            a = a + 1
        }
        i = i + 1
    }
}

fn chunk_enc_light(e: *mut ChunkEnc, col: *mut sv_world.Column, nsec: usize, vals: *mut rt.Buf, mask_bytes: bool) {
    if !(*col).has_light { light_from_heights(e, col, nsec) }
    let layers: usize = nsec + 2
    emit_mask(vals, "skyLightMask", (*col).sky_mask, mask_bytes)
    emit_mask(vals, "blockLightMask", (*col).blk_mask, mask_bytes)
    emit_mask(vals, "emptySkyLightMask", (*col).sky_empty, mask_bytes)
    emit_mask(vals, "emptyBlockLightMask", (*col).blk_empty, mask_bytes)
    emit_arrays(vals, col, "skyLight", true, (*col).sky_mask, layers)
    emit_arrays(vals, col, "blockLight", false, (*col).blk_mask, layers)
}

fn push_be_key(vals: *mut rt.Buf, i: usize, field: str) {
    rt.buf_push_bytes(vals, "blockEntities[".p as u64, 14)
    rt.buf_push_dec_u64(vals, i as u64)
    rt.buf_push_bytes(vals, "].".p as u64, 2)
    rt.buf_push_bytes(vals, field.p as u64, field.n)
    rt.buf_push(vals, 61)
}

fn chunk_enc_block_entities(col: *mut sv_world.Column, vals: *mut rt.Buf) {
    mc_encode.vals_key(vals, "blockEntities")
    rt.buf_push(vals, 35)
    rt.buf_push_dec_u64(vals, (*col).be_count as u64)
    rt.buf_push(vals, 10)
    let base: u64 = bytes.bytes_ptr(&(*col).be)
    var at: usize = 0
    var i: usize = 0
    while i < (*col).be_count as usize {
        let x: i32 = sv_world.be_i32(base, at)
        let y: i32 = sv_world.be_i32(base, at + 4)
        let z: i32 = sv_world.be_i32(base, at + 8)
        let kind: u32 = sv_world.be_u32(base, at + 12)
        let len: usize = sv_world.be_u32(base, at + 16) as usize
        push_be_key(vals, i, "x")
        rt.buf_push_dec_i64(vals, (x & 15) as i64)
        rt.buf_push(vals, 10)
        push_be_key(vals, i, "z")
        rt.buf_push_dec_i64(vals, (z & 15) as i64)
        rt.buf_push(vals, 10)
        push_be_key(vals, i, "y")
        rt.buf_push_dec_i64(vals, y as i64)
        rt.buf_push(vals, 10)
        push_be_key(vals, i, "type")
        rt.buf_push_dec_u64(vals, kind as u64)
        rt.buf_push(vals, 10)
        if len > 0 {
            push_be_key(vals, i, "nbtData")
            rt.buf_push_bytes(vals, "hex:".p as u64, 4)
            var j: usize = 0
            while j < len {
                rt.buf_push_hex_u64(vals, rt.ld8(base + (at + sv_world.BE_HEADER) as u64, j) as u64, 2)
                j = j + 1
            }
            rt.buf_push(vals, 10)
        }
        at = at + sv_world.BE_HEADER + len
        i = i + 1
    }
}
