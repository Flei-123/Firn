// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_chunk_enc.fi -- a world column of global state ids -> the fields of a map_chunk packet
// (1.18+ paletted containers, MOTION_BLOCKING heightmap, sky light of the mixed sections).

import std.rt
import std.bytes
import mc.mc_encode

export { ChunkEnc, chunk_enc_new, chunk_enc_free, chunk_enc_data, chunk_enc_heightmap, chunk_enc_light }

const BLOCK_INDIRECT_MAX: u32 = 8
const GLOBAL_BITS: u32 = 15
const NONE16: u16 = 65535

struct ChunkEnc {
    map: u64,
    pal: u64,
    tops: u64,
}

fn chunk_enc_new() -> ChunkEnc {
    var e: ChunkEnc = ChunkEnc { map: rt.heap_alloc(65536), pal: rt.heap_alloc(8192), tops: rt.heap_alloc(512) }
    var i: usize = 0
    while i < 32768 {
        rt.st16(e.map, i, NONE16)
        i = i + 1
    }
    return e
}

fn chunk_enc_free(e: *mut ChunkEnc) {
    rt.heap_free((*e).map, 65536)
    rt.heap_free((*e).pal, 8192)
    rt.heap_free((*e).tops, 512)
}

fn ceil_log2(n: u32) -> u32 {
    var b: u32 = 0
    while (1 as u32) << b < n { b = b + 1 }
    return b
}

fn put_container(e: *mut ChunkEnc, out: *mut bytes.Bytes, ids: u64) {
    var n: usize = 0
    var i: usize = 0
    while i < 4096 {
        let id: u16 = rt.ld16(ids, i)
        if rt.ld16((*e).map, id as usize) == NONE16 {
            rt.st16((*e).map, id as usize, n as u16)
            rt.st16((*e).pal, n, id)
            n = n + 1
        }
        i = i + 1
    }
    if n == 1 {
        bytes.put_u8(out, 0 as u8)
        bytes.put_varint(out, rt.ld16((*e).pal, 0) as i32)
        bytes.put_varint(out, 0)
    } else {
        var bits: u32 = ceil_log2(n as u32)
        if bits < 4 { bits = 4 }
        let direct: bool = bits > BLOCK_INDIRECT_MAX
        if direct {
            bits = GLOBAL_BITS
            bytes.put_u8(out, bits as u8)
        } else {
            bytes.put_u8(out, bits as u8)
            bytes.put_varint(out, n as i32)
            var k: usize = 0
            while k < n {
                bytes.put_varint(out, rt.ld16((*e).pal, k) as i32)
                k = k + 1
            }
        }
        let per: usize = (64 as u32 / bits) as usize
        let longs: usize = (4096 + per - 1) / per
        bytes.put_varint(out, longs as i32)
        var l: usize = 0
        while l < longs {
            var v: u64 = 0
            var j: usize = 0
            while j < per && l * per + j < 4096 {
                let id: u16 = rt.ld16(ids, l * per + j)
                var entry: u64 = id as u64
                if !direct { entry = rt.ld16((*e).map, id as usize) as u64 }
                v = v | (entry << ((j as u32 * bits) as u64))
                j = j + 1
            }
            bytes.put_u64(out, v)
            l = l + 1
        }
    }
    i = 0
    while i < n {
        rt.st16((*e).map, rt.ld16((*e).pal, i) as usize, NONE16)
        i = i + 1
    }
}

fn chunk_enc_data(e: *mut ChunkEnc, blocks: u64, nsec: usize, biome: i32, out: *mut bytes.Bytes) {
    var s: usize = 0
    while s < nsec {
        let base: u64 = blocks + (s * 8192) as u64
        var count: i32 = 0
        var i: usize = 0
        while i < 4096 {
            if rt.ld16(base, i) != 0 as u16 { count = count + 1 }
            i = i + 1
        }
        bytes.put_i16(out, count as i16)
        put_container(e, out, base)
        bytes.put_u8(out, 0 as u8)
        bytes.put_varint(out, biome)
        bytes.put_varint(out, 0)
        s = s + 1
    }
}

fn top_of(blocks: u64, nsec: usize, col: usize) -> i32 {
    var y: i32 = (nsec * 16) as i32 - 1
    while y >= 0 {
        if rt.ld16(blocks, (y as usize) * 256 + col) != 0 as u16 { return y }
        y = y - 1
    }
    return 0 - 1
}

fn chunk_enc_heightmap(e: *mut ChunkEnc, blocks: u64, nsec: usize, out: *mut bytes.Bytes) {
    let height: u32 = (nsec * 16) as u32
    let bits: u32 = ceil_log2(height + 1)
    let per: usize = (64 as u32 / bits) as usize
    let longs: usize = (256 + per - 1) / per
    var col: usize = 0
    while col < 256 {
        rt.st16((*e).tops, col, (top_of(blocks, nsec, col) + 1) as u16)
        col = col + 1
    }
    bytes.put_u8(out, 10 as u8)
    bytes.put_u16(out, 0 as u16)
    bytes.put_u8(out, 12 as u8)
    var name: str = "MOTION_BLOCKING"
    bytes.put_u16(out, name.n as u16)
    bytes.put_raw(out, name.p as u64, name.n)
    bytes.put_i32(out, longs as i32)
    var l: usize = 0
    while l < longs {
        var v: u64 = 0
        var j: usize = 0
        while j < per && l * per + j < 256 {
            v = v | ((rt.ld16((*e).tops, l * per + j) as u64) << ((j as u32 * bits) as u64))
            j = j + 1
        }
        bytes.put_u64(out, v)
        l = l + 1
    }
    bytes.put_u8(out, 0 as u8)
}

fn push_line_i(b: *mut rt.Buf, key: str, i: usize, tail: str, v: i64) {
    rt.buf_push_bytes(b, key.p as u64, key.n)
    rt.buf_push(b, 91)
    rt.buf_push_dec_u64(b, i as u64)
    rt.buf_push_bytes(b, tail.p as u64, tail.n)
    rt.buf_push_dec_i64(b, v)
    rt.buf_push(b, 10)
}

fn push_elem(b: *mut rt.Buf, arr: usize, j: usize, v: u8) {
    var key: str = "skyLight"
    rt.buf_push_bytes(b, key.p as u64, key.n)
    rt.buf_push(b, 91)
    rt.buf_push_dec_u64(b, arr as u64)
    rt.buf_push(b, 93)
    rt.buf_push(b, 91)
    rt.buf_push_dec_u64(b, j as u64)
    rt.buf_push(b, 93)
    rt.buf_push(b, 61)
    rt.buf_push_dec_u64(b, v as u64)
    rt.buf_push(b, 10)
}

fn chunk_enc_light(e: *mut ChunkEnc, blocks: u64, nsec: usize, vals: *mut rt.Buf) {
    var col: usize = 0
    while col < 256 {
        rt.st16((*e).tops, col, (top_of(blocks, nsec, col) + 1) as u16)
        col = col + 1
    }
    var sky_mask: u64 = 0
    var empty_mask: u64 = 1
    var arrays: usize = 0
    var s: usize = 0
    while s < nsec {
        var lit: usize = 0
        var i: usize = 0
        while i < 4096 {
            let y: usize = s * 16 + i / 256
            if y >= rt.ld16((*e).tops, i % 256) as usize { lit = lit + 1 }
            i = i + 1
        }
        if lit == 0 {
            empty_mask = empty_mask | ((1 as u64) << ((s + 1) as u64))
        } else if lit < 4096 {
            sky_mask = sky_mask | ((1 as u64) << ((s + 1) as u64))
            arrays = arrays + 1
        }
        s = s + 1
    }
    mc_encode.vals_raw(vals, "skyLightMask", "#1")
    push_line_i(vals, "skyLightMask", 0, "]=", sky_mask as i64)
    mc_encode.vals_raw(vals, "blockLightMask", "#0")
    mc_encode.vals_raw(vals, "emptySkyLightMask", "#1")
    push_line_i(vals, "emptySkyLightMask", 0, "]=", empty_mask as i64)
    mc_encode.vals_raw(vals, "emptyBlockLightMask", "#0")
    mc_encode.vals_key(vals, "skyLight")
    rt.buf_push(vals, 35)
    rt.buf_push_dec_u64(vals, arrays as u64)
    rt.buf_push(vals, 10)
    mc_encode.vals_raw(vals, "blockLight", "#0")
    var a: usize = 0
    s = 0
    while s < nsec {
        if (sky_mask >> ((s + 1) as u64)) & (1 as u64) != 0 as u64 {
            var key: str = "skyLight"
            rt.buf_push_bytes(vals, key.p as u64, key.n)
            rt.buf_push(vals, 91)
            rt.buf_push_dec_u64(vals, a as u64)
            rt.buf_push_bytes(vals, "]=#2048\n".p as u64, 8)
            var j: usize = 0
            while j < 2048 {
                var lo: u8 = 0
                var hi: u8 = 0
                let i0: usize = j * 2
                if s * 16 + i0 / 256 >= rt.ld16((*e).tops, i0 % 256) as usize { lo = 15 as u8 }
                let i1: usize = j * 2 + 1
                if s * 16 + i1 / 256 >= rt.ld16((*e).tops, i1 % 256) as usize { hi = 15 as u8 }
                push_elem(vals, a, j, lo | (hi << 4))
                j = j + 1
            }
            a = a + 1
        }
        s = s + 1
    }
}
