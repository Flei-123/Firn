import mc.server.sv_state
import mc.server.sv_dim
import mc.server.sv_end
import mc.server.sv_ver
import mc.server.sv_chunks
import mc.server.portal.portal_ctx
import mc.server.portal.portal_touch

export { gateway_phase }

const COOLDOWN_TICKS: i32 = 40

fn teleport_to_exit(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    let x: f64 = (sv_end.GATEWAY_EXIT_X as f64) + 0.5
    let y: f64 = sv_end.GATEWAY_EXIT_Y as f64
    let z: f64 = (sv_end.GATEWAY_EXIT_Z as f64) + 0.5
    (*s).x = x
    (*s).y = y
    (*s).z = z
    (*s).cx = sv_chunks.chunk_of(x)
    (*s).cz = sv_chunks.chunk_of(z)
    let send: fn(*mut sv_state.Server, *mut sv_state.Session, f64, f64, f64, f32, f32, i64) -> bool = (*sv_ver.adapter_of(srv)).send_position_to
    send(srv, s, x, y, z, (*s).yaw, (*s).pitch, 0)
    sv_chunks.chunks_send_center(srv, s)
}

fn gateway_phase(ctx: u64) {
    let root: *mut sv_state.Server = ctx as *mut sv_state.Server
    var i: usize = 0
    while i < sv_state.MAX_SESSIONS {
        let s: *mut sv_state.Session = sv_state.session_at(root, i)
        i = i + 1
        if !(*s).used || !(*s).joined || (*s).closing || (*s).gamemode == 3 || (*s).dim != sv_dim.DIM_END { continue }
        if (*s).gateway_cd > 0 {
            (*s).gateway_cd = (*s).gateway_cd - 1
            continue
        }
        let srv: *mut sv_state.Server = sv_state.srv_dim(root, s)
        var c: portal_ctx.PortalCtx = portal_ctx.ctx_new(srv)
        var bx: i32 = 0
        var by: i32 = 0
        var bz: i32 = 0
        if portal_touch.touching_cell(&c, s, portal_ctx.is_gateway, 0.0, 1.0, &bx, &by, &bz) {
            (*s).gateway_cd = COOLDOWN_TICKS
            teleport_to_exit(srv, s)
        }
    }
}
