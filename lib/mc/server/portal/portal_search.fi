import std.rt
import mc.server.sv_state
import mc.server.sv_edits
import mc.server.sv_world
import mc.server.portal.portal_ctx

export { Best, best_new, scan_edits, scan_saved_chunks }

struct Best {
    d: i64,
    x: i32,
    y: i32,
    z: i32,
}

fn best_new() -> Best {
    return Best { d: 0 - 1, x: 0, y: 0, z: 0 }
}

fn consider(b: *mut Best, px: i32, py: i32, pz: i32, x: i32, y: i32, z: i32) {
    let dx: i64 = (px - x) as i64
    let dy: i64 = (py - y) as i64
    let dz: i64 = (pz - z) as i64
    let d: i64 = dx * dx + dy * dy + dz * dz
    if (*b).d < 0 as i64 || d < (*b).d || (d == (*b).d && py < (*b).y) {
        (*b).d = d
        (*b).x = px
        (*b).y = py
        (*b).z = pz
    }
}

fn in_box(px: i32, pz: i32, x: i32, z: i32, radius: i32) -> bool {
    let dx: i32 = px - x
    let dz: i32 = pz - z
    return dx >= 0 - radius && dx <= radius && dz >= 0 - radius && dz <= radius
}

fn scan_edits(c: *mut portal_ctx.PortalCtx, x: i32, y: i32, z: i32, radius: i32, b: *mut Best) {
    let e: *mut sv_edits.Edits = &(*(*c).srv).edits
    let cap: usize = sv_edits.edits_slot_count(e)
    var i: usize = 0
    while i < cap {
        let k: u64 = sv_edits.edits_slot_key(e, i)
        if k != 0 as u64 {
            let px: i32 = sv_edits.key_x(k)
            let pz: i32 = sv_edits.key_z(k)
            if in_box(px, pz, x, z, radius) && portal_ctx.is_portal(c, sv_edits.edits_slot_val(e, i) as i32) {
                consider(b, px, sv_edits.key_y(k), pz, x, y, z)
            }
        }
        i = i + 1
    }
}

fn scan_column(c: *mut portal_ctx.PortalCtx, col: *mut sv_world.Column, cx: i32, cz: i32, x: i32, y: i32, z: i32, radius: i32, b: *mut Best) {
    let srv: *mut sv_state.Server = (*c).srv
    let p0: i32 = portal_ctx.portal_state(c, portal_ctx.AXIS_X)
    let p1: i32 = portal_ctx.portal_state(c, portal_ctx.AXIS_Z)
    let min_y: i32 = (*srv).world.min_y
    let height: i32 = (*srv).world.height
    var yy: i32 = 0
    while yy < height {
        var zz: i32 = 0
        while zz < 16 {
            var xx: i32 = 0
            while xx < 16 {
                let wx: i32 = cx * 16 + xx
                let wz: i32 = cz * 16 + zz
                if in_box(wx, wz, x, z, radius) {
                    let idx: usize = ((yy as usize) * 16 + (zz as usize)) * 16 + (xx as usize)
                    let st: i32 = rt.ld16((*col).blocks, idx) as i32
                    if st == p0 || st == p1 {
                        var v: i32 = 0
                        if !sv_edits.edits_get(&(*srv).edits, wx, min_y + yy, wz, &v) {
                            consider(b, wx, min_y + yy, wz, x, y, z)
                        }
                    }
                }
                xx = xx + 1
            }
            zz = zz + 1
        }
        yy = yy + 1
    }
}

fn scan_saved_chunks(c: *mut portal_ctx.PortalCtx, x: i32, y: i32, z: i32, radius: i32, b: *mut Best) {
    let srv: *mut sv_state.Server = (*c).srv
    if (*srv).gen_world { return }
    var col: sv_world.Column = sv_world.column_new(sv_world.world_sections(&(*srv).world))
    let cx1: i32 = (x + radius) >> 4
    let cz1: i32 = (z + radius) >> 4
    var cz: i32 = (z - radius) >> 4
    while cz <= cz1 {
        var cx: i32 = (x - radius) >> 4
        while cx <= cx1 {
            if sv_world.world_fill(&(*srv).world, cx, cz, &col) {
                scan_column(c, &col, cx, cz, x, y, z, radius, b)
            }
            cx = cx + 1
        }
        cz = cz + 1
    }
    sv_world.column_free(&col)
}
