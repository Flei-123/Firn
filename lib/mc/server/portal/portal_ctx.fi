// SPDX-License-Identifier: MPL-2.0
import mc.mc_registry
import mc.server.sv_state
import mc.server.sv_dig

export {
    PortalCtx, ctx_new, state_at, set_block, is_empty, is_obsidian, is_portal, is_end_portal, is_gateway, is_solid, can_portal_replace,
    portal_state, portal_axis_of, obsidian_state, top_block_y, AXIS_X, AXIS_Z
}

const AXIS_X: i32 = 0
const AXIS_Z: i32 = 2

struct PortalCtx {
    srv: *mut sv_state.Server,
    reg: mc_registry.Registry,
    air: i32,
    cave_air: i32,
    void_air: i32,
    fire: i32,
    portal: i32,
    end_portal: i32,
    gateway: i32,
    obsidian: i32,
    water: i32,
    lava: i32,
}

fn block_named(reg: *mut mc_registry.Registry, name: str) -> i32 {
    return mc_registry.reg_block_by_name(reg, name.p as u64, name.n)
}

fn ctx_new(srv: *mut sv_state.Server) -> PortalCtx {
    var reg: mc_registry.Registry = (*srv).ver.registry_of()
    return PortalCtx {
        srv: srv, reg: reg,
        air: block_named(&reg, "air"), cave_air: block_named(&reg, "cave_air"), void_air: block_named(&reg, "void_air"),
        fire: block_named(&reg, "fire"), portal: block_named(&reg, "nether_portal"), end_portal: block_named(&reg, "end_portal"), gateway: block_named(&reg, "end_gateway"), obsidian: block_named(&reg, "obsidian"),
        water: block_named(&reg, "water"), lava: block_named(&reg, "lava"),
    }
}

fn state_at(c: *mut PortalCtx, x: i32, y: i32, z: i32) -> i32 {
    return sv_dig.world_peek((*c).srv, x, y, z)
}

fn set_block(c: *mut PortalCtx, x: i32, y: i32, z: i32, state: i32) {
    sv_dig.apply_change((*c).srv, x, y, z, state)
}

fn block_of(c: *mut PortalCtx, st: i32) -> i32 {
    if st < 0 { return 0 - 1 }
    return mc_registry.reg_block_of_state(&(*c).reg, st)
}

fn is_air(c: *mut PortalCtx, st: i32) -> bool {
    if st < 0 { return false }
    let b: i32 = block_of(c, st)
    return b == (*c).air || b == (*c).cave_air || b == (*c).void_air
}

fn is_empty(c: *mut PortalCtx, st: i32) -> bool {
    if st < 0 { return false }
    let b: i32 = block_of(c, st)
    return is_air(c, st) || b == (*c).fire || b == (*c).portal
}

fn is_obsidian(c: *mut PortalCtx, st: i32) -> bool {
    return st >= 0 && block_of(c, st) == (*c).obsidian
}

fn is_portal(c: *mut PortalCtx, st: i32) -> bool {
    return st >= 0 && block_of(c, st) == (*c).portal
}

fn is_end_portal(c: *mut PortalCtx, st: i32) -> bool {
    return st >= 0 && block_of(c, st) == (*c).end_portal
}

fn is_gateway(c: *mut PortalCtx, st: i32) -> bool {
    return st >= 0 && block_of(c, st) == (*c).gateway
}

fn is_solid(c: *mut PortalCtx, st: i32) -> bool {
    if st < 0 { return false }
    return (mc_registry.reg_block_flags(&(*c).reg, block_of(c, st)) & mc_registry.RF_SOLID) != 0 as u32
}

fn is_fluid(c: *mut PortalCtx, st: i32) -> bool {
    let b: i32 = block_of(c, st)
    return b >= 0 && (b == (*c).water || b == (*c).lava)
}

fn can_portal_replace(c: *mut PortalCtx, st: i32) -> bool {
    if st < 0 { return false }
    return sv_dig.replaceable(&(*c).reg, st) && !is_fluid(c, st)
}

fn portal_state(c: *mut PortalCtx, axis: i32) -> i32 {
    let base: i32 = mc_registry.reg_block_min_state(&(*c).reg, (*c).portal)
    if axis == AXIS_Z { return base + 1 }
    return base
}

fn portal_axis_of(c: *mut PortalCtx, st: i32) -> i32 {
    if st - mc_registry.reg_block_min_state(&(*c).reg, (*c).portal) == 1 { return AXIS_Z }
    return AXIS_X
}

fn top_block_y(c: *mut PortalCtx, x: i32, z: i32, top: i32) -> i32 {
    let min_y: i32 = (*(*c).srv).world.min_y
    var y: i32 = top
    while y >= min_y {
        let st: i32 = state_at(c, x, y, z)
        if st > 0 && (is_solid(c, st) || is_fluid(c, st)) { return y + 1 }
        y = y - 1
    }
    return min_y
}

fn obsidian_state(c: *mut PortalCtx) -> i32 {
    return mc_registry.reg_block_default_state(&(*c).reg, (*c).obsidian)
}
