import mc.server.sv_state
import mc.server.sv_dim
import mc.server.sv_end
import mc.server.sv_travel
import mc.server.sv_level_sync
import mc.server.portal.portal_ctx
import mc.server.portal.portal_touch

export { end_portal_phase }

const SHAPE_BOTTOM: f64 = 0.375
const SHAPE_TOP: f64 = 0.75
const GAME_STATE_WIN_GAME: i64 = 4

fn win_game(root: *mut sv_state.Server, s: *mut sv_state.Session) {
    if (*s).won_game { return }
    (*s).won_game = true
    var value: f32 = 1.0f
    if (*s).seen_credits { value = 0.0f }
    (*s).seen_credits = true
    sv_level_sync.send_game_state(sv_state.srv_dim(root, s), s, GAME_STATE_WIN_GAME, value)
}

fn end_portal_phase(ctx: u64) {
    let root: *mut sv_state.Server = ctx as *mut sv_state.Server
    var i: usize = 0
    while i < sv_state.MAX_SESSIONS {
        let s: *mut sv_state.Session = sv_state.session_at(root, i)
        i = i + 1
        if !(*s).used || !(*s).joined || (*s).closing || (*s).gamemode == 3 { continue }
        if (*s).dim != sv_dim.DIM_OVERWORLD && (*s).dim != sv_dim.DIM_END { continue }
        let srv: *mut sv_state.Server = sv_state.srv_dim(root, s)
        var c: portal_ctx.PortalCtx = portal_ctx.ctx_new(srv)
        var bx: i32 = 0
        var by: i32 = 0
        var bz: i32 = 0
        if !portal_touch.touching_cell(&c, s, portal_ctx.is_end_portal, SHAPE_BOTTOM, SHAPE_TOP, &bx, &by, &bz) { continue }
        if (*s).dim == sv_dim.DIM_END {
            win_game(root, s)
        } else {
            sv_travel.travel_portal(root, s, sv_dim.DIM_END, (sv_end.END_SPAWN_X as f64) + 0.5, sv_end.END_SPAWN_Y as f64, (sv_end.END_SPAWN_Z as f64) + 0.5, (*s).yaw, (*s).pitch)
        }
    }
}
