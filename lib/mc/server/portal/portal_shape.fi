import mc.server.portal.portal_ctx

export { Shape, shape_new, shape_valid, find_empty_shape, shape_create_blocks }

struct Shape {
    axis: i32,
    rx: i32,
    rz: i32,
    blx: i32,
    bly: i32,
    blz: i32,
    width: i32,
    height: i32,
    portals: i32,
}

fn edge_dist(c: *mut portal_ctx.PortalCtx, x: i32, y: i32, z: i32, dx: i32, dz: i32) -> i32 {
    var i: i32 = 0
    while i <= 21 {
        let px: i32 = x + dx * i
        let pz: i32 = z + dz * i
        let st: i32 = portal_ctx.state_at(c, px, y, pz)
        if !portal_ctx.is_empty(c, st) {
            if portal_ctx.is_obsidian(c, st) { return i }
            return 0
        }
        if !portal_ctx.is_obsidian(c, portal_ctx.state_at(c, px, y - 1, pz)) { return 0 }
        i = i + 1
    }
    return 0
}

fn until_top(c: *mut portal_ctx.PortalCtx, s: *mut Shape) -> i32 {
    var i: i32 = 0
    while i < 21 {
        let y: i32 = (*s).bly + i
        if !portal_ctx.is_obsidian(c, portal_ctx.state_at(c, (*s).blx - (*s).rx, y, (*s).blz - (*s).rz)) { return i }
        if !portal_ctx.is_obsidian(c, portal_ctx.state_at(c, (*s).blx + (*s).rx * (*s).width, y, (*s).blz + (*s).rz * (*s).width)) { return i }
        var j: i32 = 0
        while j < (*s).width {
            let st: i32 = portal_ctx.state_at(c, (*s).blx + (*s).rx * j, y, (*s).blz + (*s).rz * j)
            if !portal_ctx.is_empty(c, st) { return i }
            if portal_ctx.is_portal(c, st) { (*s).portals = (*s).portals + 1 }
            j = j + 1
        }
        i = i + 1
    }
    return 21
}

fn has_top_frame(c: *mut portal_ctx.PortalCtx, s: *mut Shape, h: i32) -> bool {
    var j: i32 = 0
    while j < (*s).width {
        if !portal_ctx.is_obsidian(c, portal_ctx.state_at(c, (*s).blx + (*s).rx * j, (*s).bly + h, (*s).blz + (*s).rz * j)) { return false }
        j = j + 1
    }
    return true
}

fn shape_new(c: *mut portal_ctx.PortalCtx, x: i32, y: i32, z: i32, axis: i32) -> Shape {
    var s: Shape = Shape { axis: axis, rx: 0, rz: 0, blx: x, bly: y, blz: z, width: 0, height: 0, portals: 0 }
    if axis == portal_ctx.AXIS_X { s.rx = 0 - 1 } else { s.rz = 1 }
    let min_y: i32 = (*(*c).srv).world.min_y
    var limit: i32 = y - 21
    if limit < min_y { limit = min_y }
    var by: i32 = y
    while by > limit && portal_ctx.is_empty(c, portal_ctx.state_at(c, x, by - 1, z)) { by = by - 1 }
    let d: i32 = edge_dist(c, x, by, z, 0 - s.rx, 0 - s.rz) - 1
    if d < 0 {
        s.width = 1
        s.height = 1
        return s
    }
    s.blx = x - s.rx * d
    s.bly = by
    s.blz = z - s.rz * d
    let w: i32 = edge_dist(c, s.blx, s.bly, s.blz, s.rx, s.rz)
    if w >= 2 && w <= 21 { s.width = w }
    if s.width > 0 {
        let h: i32 = until_top(c, &s)
        if h >= 3 && h <= 21 && has_top_frame(c, &s, h) { s.height = h }
    }
    return s
}

fn shape_valid(s: *mut Shape) -> bool {
    return (*s).width >= 2 && (*s).width <= 21 && (*s).height >= 3 && (*s).height <= 21
}

fn find_empty_shape(c: *mut portal_ctx.PortalCtx, x: i32, y: i32, z: i32, out: *mut Shape) -> bool {
    var a: Shape = shape_new(c, x, y, z, portal_ctx.AXIS_X)
    if shape_valid(&a) && a.portals == 0 {
        *out = a
        return true
    }
    var b: Shape = shape_new(c, x, y, z, portal_ctx.AXIS_Z)
    if shape_valid(&b) && b.portals == 0 {
        *out = b
        return true
    }
    return false
}

fn shape_create_blocks(c: *mut portal_ctx.PortalCtx, s: *mut Shape) {
    let st: i32 = portal_ctx.portal_state(c, (*s).axis)
    var j: i32 = 0
    while j < (*s).height {
        var k: i32 = 0
        while k < (*s).width {
            portal_ctx.set_block(c, (*s).blx + (*s).rx * k, (*s).bly + j, (*s).blz + (*s).rz * k, st)
            k = k + 1
        }
        j = j + 1
    }
}
