import std.math
import mc.server.sv_state
import mc.server.portal.portal_ctx

export { touching_cell }

const PLAYER_WIDTH: f64 = 0.6
const PLAYER_HEIGHT: f64 = 1.8
const EPS: f64 = 0.0000001

fn floor_i32(v: f64) -> i32 {
    return math.floor(v) as i32
}

fn touching_cell(c: *mut portal_ctx.PortalCtx, s: *mut sv_state.Session, pred: fn(*mut portal_ctx.PortalCtx, i32) -> bool, bottom: f64, top: f64, ox: *mut i32, oy: *mut i32, oz: *mut i32) -> bool {
    let half: f64 = PLAYER_WIDTH / 2.0
    let x0: i32 = floor_i32((*s).x - half + EPS)
    let x1: i32 = floor_i32((*s).x + half - EPS)
    let y0: i32 = floor_i32((*s).y + EPS)
    let y1: i32 = floor_i32((*s).y + PLAYER_HEIGHT - EPS)
    let z0: i32 = floor_i32((*s).z - half + EPS)
    let z1: i32 = floor_i32((*s).z + half - EPS)
    var x: i32 = x0
    while x <= x1 {
        var y: i32 = y0
        while y <= y1 {
            var z: i32 = z0
            while z <= z1 {
                if pred(c, portal_ctx.state_at(c, x, y, z)) && (*s).y + PLAYER_HEIGHT - EPS > (y as f64) + bottom && (*s).y + EPS < (y as f64) + top {
                    *ox = x
                    *oy = y
                    *oz = z
                    return true
                }
                z = z + 1
            }
            y = y + 1
        }
        x = x + 1
    }
    return false
}
