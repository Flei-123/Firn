// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_persist_player.fi -- playerdata/<uuid>.dat of a player: position, rotation, game mode, hotbar.

import std.rt
import std.bytes
import std.nbt
import std.deflate
import mc.mc_registry
import mc.save.save_world
import mc.server.sv_state

export { persist_player }

const DATA_VERSION: i32 = 3465
const TAG_DOUBLE: u8 = 6
const TAG_FLOAT: u8 = 5
const HEX: str = "0123456789abcdef"

fn push_hex(b: *mut rt.Buf, v: u64, digits: usize) {
    var i: usize = digits
    while i > 0 {
        i = i - 1
        rt.buf_push(b, rt.ld8(HEX.p as u64, ((v >> ((i * 4) as u64)) & 15 as u64) as usize))
    }
}

fn uuid_text(s: *mut sv_state.Session, out: *mut rt.Buf) {
    push_hex(out, (*s).uuid_hi >> 32 as u64, 8)
    rt.buf_push(out, 45 as u8)
    push_hex(out, (*s).uuid_hi >> 16 as u64, 4)
    rt.buf_push(out, 45 as u8)
    push_hex(out, (*s).uuid_hi, 4)
    rt.buf_push(out, 45 as u8)
    push_hex(out, (*s).uuid_lo >> 48 as u64, 4)
    rt.buf_push(out, 45 as u8)
    push_hex(out, (*s).uuid_lo, 12)
}

fn write_inventory(srv: *mut sv_state.Server, s: *mut sv_state.Session, b: *mut bytes.Bytes) {
    var reg: mc_registry.Registry = (*srv).ver.registry_of()
    var count: i32 = 0
    var i: usize = 0
    while i < 9 {
        if (*s).hotbar[i] > 0 { count = count + 1 }
        i = i + 1
    }
    nbt.nbt_list_open(b, "Inventory".p as u64, 9, 10 as u8, count)
    i = 0
    while i < 9 {
        let item: i32 = (*s).hotbar[i]
        if item > 0 {
            var l: usize = 0
            let p: u64 = mc_registry.reg_item_name(&reg, item, &l)
            var full: rt.Buf = rt.buf_new()
            rt.buf_push_bytes(&full, "minecraft:".p as u64, 10)
            rt.buf_push_bytes(&full, p, l)
            nbt.nbt_byte(b, "Slot".p as u64, 4, i as i8)
            nbt.nbt_string(b, "id".p as u64, 2, full.ptr, full.len)
            nbt.nbt_byte(b, "Count".p as u64, 5, 1 as i8)
            nbt.nbt_end(b)
            rt.buf_free(&full)
        }
        i = i + 1
    }
}

fn write_player(srv: *mut sv_state.Server, s: *mut sv_state.Session, b: *mut bytes.Bytes) {
    nbt.nbt_root_begin(b, "".p as u64, 0)
    nbt.nbt_int(b, "DataVersion".p as u64, 11, DATA_VERSION)
    nbt.nbt_list_open(b, "Pos".p as u64, 3, TAG_DOUBLE, 3)
    bytes.put_f64(b, (*s).x)
    bytes.put_f64(b, (*s).y)
    bytes.put_f64(b, (*s).z)
    nbt.nbt_list_open(b, "Motion".p as u64, 6, TAG_DOUBLE, 3)
    bytes.put_f64(b, 0.0)
    bytes.put_f64(b, 0.0)
    bytes.put_f64(b, 0.0)
    nbt.nbt_list_open(b, "Rotation".p as u64, 8, TAG_FLOAT, 2)
    bytes.put_f32(b, (*s).yaw)
    bytes.put_f32(b, (*s).pitch)
    nbt.nbt_byte(b, "OnGround".p as u64, 8, (*s).on_ground as i8)
    nbt.nbt_string(b, "Dimension".p as u64, 9, "minecraft:overworld".p as u64, 19)
    nbt.nbt_int(b, "playerGameType".p as u64, 14, (*srv).cfg.game_mode)
    nbt.nbt_int(b, "SelectedItemSlot".p as u64, 16, (*s).held)
    nbt.nbt_float(b, "Health".p as u64, 6, 20.0f)
    nbt.nbt_int(b, "foodLevel".p as u64, 9, 20)
    write_inventory(srv, s, b)
    nbt.nbt_end(b)
}

fn persist_player(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var dir: rt.Buf = rt.buf_new()
    save_world.path_c(&dir, str { p: (*srv).world_dir.ptr as *mut u8, n: (*srv).world_dir.len }, "playerdata")
    save_world.mkdir_parents(str { p: dir.ptr as *mut u8, n: dir.len - 1 })
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir.ptr, dir.len - 1)
    rt.buf_push(&path, 47 as u8)
    uuid_text(s, &path)
    rt.buf_push_bytes(&path, ".dat".p as u64, 4)
    rt.buf_push(&path, 0 as u8)
    var b: bytes.Bytes = bytes.bytes_new()
    write_player(srv, s, &b)
    var gz: rt.Buf = rt.buf_new()
    let m: usize = deflate.gzip_compress(bytes.bytes_ptr(&b), bytes.bytes_len(&b), 6, &gz) catch 99999999999
    let ok: bool = m != 99999999999 && rt.write_file(path.ptr, gz.ptr, gz.len)
    rt.buf_free(&gz)
    bytes.bytes_free(&b)
    rt.buf_free(&path)
    rt.buf_free(&dir)
    return ok
}
