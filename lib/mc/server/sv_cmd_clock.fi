// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_cmd_clock.fi -- time command handlers of the world clock tree (26.x): time markers and the plain time query.

import std.rt
import brigadier.bmem as m
import brigadier.text as tx
import brigadier.exc as ex
import brigadier.argtype as at
import mc.server.sv_state
import mc.server.sv_send
import mc.server.sv_play
import mc.server.sv_cmd_state
import mc.server.sv_cmd_util as cu

export { clock_register }

const DAY_TICKS: i64 = 24000
const PREFIX: str = "minecraft:"

fn marker_ticks(name: str) -> i64 {
    if name.n >= PREFIX.n && rt.mem_eq(name.p as u64, PREFIX.p as u64, PREFIX.n) {
        return marker_ticks(str { p: (name.p as u64 + PREFIX.n as u64) as *mut u8, n: name.n - PREFIX.n })
    }
    if name.n == 3 && rt.mem_eq(name.p as u64, "day".p as u64, 3) { return 1000 }
    if name.n == 4 && rt.mem_eq(name.p as u64, "noon".p as u64, 4) { return 6000 }
    if name.n == 5 && rt.mem_eq(name.p as u64, "night".p as u64, 5) { return 13000 }
    if name.n == 8 && rt.mem_eq(name.p as u64, "midnight".p as u64, 8) { return 18000 }
    return 0 - 1
}

fn reply_number(c: *mut sv_cmd_state.Cmds, head: str, v: i64) {
    var b: rt.Buf = rt.buf_new()
    sv_send.push_str(&b, head)
    rt.buf_push_dec_i64(&b, v)
    cu.reply_buf(c, &b)
    rt.buf_free(&b)
}

fn h_set_marker(user: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = user as *mut sv_cmd_state.Cmds
    let name: str = tx.u16_to_str(&(*c).work, (*cu.arg_of(c, ctx, "timemarker")).s)
    let ticks: i64 = marker_ticks(name)
    if ticks < 0 {
        var b: rt.Buf = rt.buf_new()
        sv_send.push_str(&b, "Can't find time marker ")
        sv_send.push_str(&b, name)
        let text: str = rt.buf_str(&b)
        let res: i32 = cu.fail(c, err, text)
        rt.buf_free(&b)
        return res
    }
    (*(*c).srv).day_time = ticks
    sv_play.play_time_all((*c).srv)
    reply_number(c, "Set the time to ", ticks)
    return ticks as i32
}

fn h_query_time(user: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = user as *mut sv_cmd_state.Cmds
    let v: i64 = ((*(*c).srv).day_time % DAY_TICKS + DAY_TICKS) % DAY_TICKS
    reply_number(c, "The time is ", v)
    return v as i32
}

fn clock_register(c: *mut sv_cmd_state.Cmds) {
    cu.add(c, "time set timemarker", h_set_marker)
    cu.add(c, "time query time", h_query_time)
}
