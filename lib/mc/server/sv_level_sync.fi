import std.rt
import mc.mc_encode
import mc.mc_sem
import mc.mc_version
import mc.server.sv_state
import mc.server.sv_send
import mc.server.sv_ops
import mc.server.sv_ver
import mc.server.ent.ent_inv
import mc.server.inv.sv_health

export { send_difficulty, send_permission, send_world_border, send_held_slot, send_experience, send_level_info, send_player_info, send_world_event }

const DIFFICULTY_EASY: i64 = 1
const PERMISSION_STATUS_BASE: i64 = 24
const BORDER_DIAMETER: f64 = 59999968.0
const BORDER_PORTAL_BOUNDARY: i64 = 29999984
const BORDER_WARNING_BLOCKS: i64 = 5
const BORDER_WARNING_TIME: i64 = 15

fn send_difficulty(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "difficulty", DIFFICULTY_EASY)
    mc_encode.vals_bool(&v, "difficultyLocked", false)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_DIFFICULTY, &v)
    rt.buf_free(&v)
    return ok
}

fn send_permission(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "entityId", (*s).eid as i64)
    mc_encode.vals_i64(&v, "entityStatus", PERMISSION_STATUS_BASE + sv_ops.op_level(sv_state.srv_root(srv), s) as i64)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_ENTITY_STATUS, &v)
    rt.buf_free(&v)
    return ok
}

fn send_world_border(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_f64(&v, "x", 0.0)
    mc_encode.vals_f64(&v, "z", 0.0)
    mc_encode.vals_f64(&v, "oldDiameter", BORDER_DIAMETER)
    mc_encode.vals_f64(&v, "newDiameter", BORDER_DIAMETER)
    mc_encode.vals_i64(&v, "speed", 0)
    mc_encode.vals_i64(&v, "portalTeleportBoundary", BORDER_PORTAL_BOUNDARY)
    mc_encode.vals_i64(&v, "warningBlocks", BORDER_WARNING_BLOCKS)
    mc_encode.vals_i64(&v, "warningTime", BORDER_WARNING_TIME)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_INIT_WORLD_BORDER, &v)
    rt.buf_free(&v)
    return ok
}

fn send_held_slot(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "slot", (*s).held as i64)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_HELD_ITEM_SLOT, &v)
    rt.buf_free(&v)
    return ok
}

fn send_experience(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_f32(&v, "experienceBar", 0.0f)
    mc_encode.vals_i64(&v, "level", 0)
    mc_encode.vals_i64(&v, "totalExperience", 0)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_EXPERIENCE, &v)
    rt.buf_free(&v)
    return ok
}

fn send_world_event(srv: *mut sv_state.Server, s: *mut sv_state.Session, effect: i64) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "effectId", effect)
    mc_encode.vals_i64(&v, "location.x", 0)
    mc_encode.vals_i64(&v, "location.y", 0)
    mc_encode.vals_i64(&v, "location.z", 0)
    mc_encode.vals_i64(&v, "data", 0)
    mc_encode.vals_bool(&v, "global", false)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_WORLD_EVENT, &v)
    rt.buf_free(&v)
    return ok
}

fn send_level_info(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    let ad: *mut sv_ver.ServerVersion = sv_ver.adapter_of(srv)
    let send_time: fn(*mut sv_state.Server, *mut sv_state.Session) -> bool = (*ad).send_time
    let send_spawn: fn(*mut sv_state.Server, *mut sv_state.Session) -> bool = (*ad).send_spawn
    send_world_border(srv, s)
    send_time(srv, s)
    send_spawn(sv_state.srv_root(srv), s)
}

fn send_player_info(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    ent_inv.inv_push_all(srv, s)
    send_held_slot(srv, s)
    sv_health.send_health(srv, s)
    send_experience(srv, s)
}
