// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_host.fi -- runs the integrated server on its own thread: start, wait until ready, stop, join.

import std.rt
import std.time
import mc.mc_version
import mc.mc_versions
import mc.server.sv_state
import mc.server.sv_core
import mc.server.sv_flat
import mc.server.sv_save
import mc.server.sv_world
import mc.server.v763.sv_codec_v763
import mc.server.v763.sv_join_v763

export { SERVER_KIND, host_start_cfg, server_main, Host, host_new, host_start, host_stop, host_port, host_ticks, host_avg_us, host_tps_x100, host_online, host_failed }

const SERVER_KIND: u64 = 1936291443
const PROTOCOL: i32 = 763
const READY_WAIT_MS: i64 = 5000

struct Host {
    srv: *mut sv_state.Server,
    handle: u64,
    running: bool,
}

fn server_main(arg: u64) -> u64 {
    return sv_core.server_thread_main(arg)
}

fn host_new() -> Host {
    return Host { srv: 0 as *mut sv_state.Server, handle: 0, running: false }
}

fn setup_none(srv: *mut sv_state.Server) {}

fn host_start(h: *mut Host, port: u16, view: i32, game_mode: i32, world_dir: str, ops: str) -> bool {
    var cfg: sv_state.Config = sv_state.config_default()
    cfg.view = view
    cfg.game_mode = game_mode
    cfg.ops = ops
    return host_start_cfg(h, port, cfg, world_dir, setup_none)
}

fn host_start_cfg(h: *mut Host, port: u16, cfg: sv_state.Config, world_dir: str, setup: fn(*mut sv_state.Server)) -> bool {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(PROTOCOL, &ver) { return false }
    var source: sv_world.WorldSource = sv_flat.flat_source_new(&ver, sv_codec_v763.BIOME_PLAINS)
    if world_dir.n > 0 {
        sv_world.world_free(&source)
        if !sv_save.save_source_open(&ver, world_dir, sv_codec_v763.BIOME_PLAINS, &source) { return false }
    }
    (*h).srv = sv_core.server_box(sv_core.server_new(cfg, ver, source, sv_join_v763.join_send))
    rt.buf_push_bytes(&(*(*h).srv).world_dir, world_dir.p as u64, world_dir.n)
    setup((*h).srv)
    sv_state.shared_set((*(*h).srv).shared, sv_state.SH_PORT_WANT, port as u64)
    (*h).handle = thread_start(SERVER_KIND, (*h).srv as u64)
    (*h).running = (*h).handle != 0
    if !(*h).running { return false }
    let t0: i64 = sv_core.now_ms()
    while sv_core.now_ms() - t0 < READY_WAIT_MS {
        if sv_state.shared_get((*(*h).srv).shared, sv_state.SH_READY) != 0 as u64 { return true }
        if sv_state.shared_get((*(*h).srv).shared, sv_state.SH_FAILED) != 0 as u64 { return false }
        time.sleep_ms(2 as u64)
    }
    return false
}

fn host_stop(h: *mut Host) {
    if !(*h).running { return }
    sv_state.shared_set((*(*h).srv).shared, sv_state.SH_STOP, 1 as u64)
    thread_wait((*h).handle)
    sv_core.server_destroy((*h).srv)
    (*h).running = false
}

fn host_port(h: *mut Host) -> u16 { return sv_state.shared_get((*(*h).srv).shared, sv_state.SH_PORT_BOUND) as u16 }

fn host_ticks(h: *mut Host) -> u64 { return sv_state.shared_get((*(*h).srv).shared, sv_state.SH_TICKS) }

fn host_avg_us(h: *mut Host) -> u64 { return sv_state.shared_get((*(*h).srv).shared, sv_state.SH_AVG_US) }

fn host_tps_x100(h: *mut Host) -> u64 { return sv_state.shared_get((*(*h).srv).shared, sv_state.SH_TPS_X100) }

fn host_online(h: *mut Host) -> u64 { return sv_state.shared_get((*(*h).srv).shared, sv_state.SH_ONLINE) }

fn host_failed(h: *mut Host) -> bool { return sv_state.shared_get((*(*h).srv).shared, sv_state.SH_FAILED) != 0 as u64 }
