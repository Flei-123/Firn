// lib/mc/server/sv_config.fi -- Login -> Configuration -> Play hand over of protocols with a configuration phase (1.20.2+).

import mc.mc_sem
import mc.mc_version
import mc.server.sv_state
import mc.server.sv_send
import mc.server.sv_ver

export { login_ack, config_handle }

fn login_ack(srv: *mut sv_state.Server, s: *mut sv_state.Session, id: i32) {
    if !sv_send.sem_is(srv, id, mc_sem.SEM_LOGIN_C2S_LOGIN_ACKNOWLEDGED) { return }
    (*s).state = mc_version.ST_CONFIG
    let enter: fn(*mut sv_state.Server, *mut sv_state.Session) -> bool = (*sv_ver.adapter_of(srv)).config_enter
    if !enter(srv, s) { (*s).closing = true }
}

fn config_handle(srv: *mut sv_state.Server, s: *mut sv_state.Session, id: i32) -> bool {
    if !sv_send.sem_is(srv, id, mc_sem.SEM_CONFIG_C2S_FINISH) { return false }
    (*s).state = mc_version.ST_PLAY
    return true
}
