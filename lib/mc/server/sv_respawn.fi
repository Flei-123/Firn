import std.bytes
import mc.mc_sem
import mc.mc_version
import mc.server.sv_state
import mc.server.sv_send
import mc.server.sv_travel

export { handle_client_command }

const ACTION_PERFORM_RESPAWN: i32 = 0

fn handle_client_command(srv: *mut sv_state.Server, s: *mut sv_state.Session, id: i32, body: *mut bytes.Bytes) {
    var action: i32 = 0 - 1
    if !sv_send.field_varint(srv, mc_version.ST_PLAY, id, "actionId", body, &action) { return }
    if action != ACTION_PERFORM_RESPAWN || !(*s).won_game { return }
    (*s).won_game = false
    sv_travel.travel_respawn(sv_state.srv_root(srv), s)
}
