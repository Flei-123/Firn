// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_flat.fi -- superflat world source: bedrock, two dirt, grass (min_y -64, height 384).

import std.rt
import mc.mc_version
import mc.mc_registry
import mc.server.sv_world

export { flat_source_new }

const LAYER_BEDROCK: usize = 0
const LAYER_DIRT: usize = 1
const LAYER_GRASS: usize = 2
const MIN_Y: i32 = 0 - 64
const HEIGHT: i32 = 384

fn state_of(r: *mut mc_registry.Registry, name: str) -> u16 {
    let b: i32 = mc_registry.reg_block_by_name(r, name.p as u64, name.n)
    if b < 0 { return 0 as u16 }
    return mc_registry.reg_block_default_state(r, b) as u16
}

fn flat_fill(ctx: u64, cx: i32, cz: i32, col: *mut sv_world.Column) -> bool {
    let blocks: u64 = (*col).blocks
    rt.mem_set(blocks, 0 as u8, (HEIGHT as usize) * 512)
    var layer: usize = 0
    while layer < 4 {
        var id: u16 = 0 as u16
        if layer == 0 { id = rt.ld16(ctx, LAYER_BEDROCK) }
        if layer == 1 || layer == 2 { id = rt.ld16(ctx, LAYER_DIRT) }
        if layer == 3 { id = rt.ld16(ctx, LAYER_GRASS) }
        var i: usize = 0
        while i < 256 {
            rt.st16(blocks, layer * 256 + i, id)
            i = i + 1
        }
        layer = layer + 1
    }
    return true
}

fn flat_source_new(ver: *mut mc_version.Version, biome: i32) -> sv_world.WorldSource {
    var reg: mc_registry.Registry = (*ver).registry_of()
    let ctx: u64 = rt.heap_alloc(8)
    rt.st16(ctx, LAYER_BEDROCK, state_of(&reg, "bedrock"))
    rt.st16(ctx, LAYER_DIRT, state_of(&reg, "dirt"))
    rt.st16(ctx, LAYER_GRASS, state_of(&reg, "grass_block"))
    return sv_world.WorldSource { ctx: ctx, fill: flat_fill, release: flat_release, min_y: MIN_Y, height: HEIGHT, spawn_x: 8, spawn_y: MIN_Y + 4,
        spawn_z: 8, biome: biome, uniform: true }
}

fn flat_release(ctx: u64) {
    rt.heap_free(ctx, 8)
}
