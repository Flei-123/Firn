// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_save.fi -- world source that serves the chunk columns of a vanilla world directory (level.dat spawn,
// region/*.mca + external .mcc, palettes resolved to global state ids). Columns that were never generated are air.

import std.rt
import std.bytes
import mc.mc_version
import mc.mc_registry
import mc.mc_anvil
import mc.mc_nbt
import mc.save.save_world
import mc.save.save_chunk
import mc.server.sv_world

export { save_source_open }

const MIN_Y: i32 = 0 - 64
const HEIGHT: i32 = 384
const REGION_SLOTS: usize = 4
const SECTION_CELLS: usize = 4096
const NAME_BUDGET: usize = 4096

struct RegionSlot {
    rx: i32,
    rz: i32,
    used: bool,
    region: mc_anvil.Region,
}

struct SaveCtx {
    dir: rt.Buf,
    reg: mc_registry.Registry,
    slots: [RegionSlot; 4],
    next: usize,
    raw: rt.Buf,
    text: rt.Buf,
    index: u64,
    table: u64,
}

fn slot_empty() -> RegionSlot {
    return RegionSlot { rx: 0, rz: 0, used: false, region: mc_anvil.region_new() }
}

fn ctx_ptr(ctx: u64) -> *mut SaveCtx { return ctx as *mut SaveCtx }

fn region_dir(c: *mut SaveCtx) -> str {
    return str { p: (*c).dir.ptr as *mut u8, n: (*c).dir.len }
}

fn load_region(c: *mut SaveCtx, rx: i32, rz: i32) -> *mut RegionSlot {
    var i: usize = 0
    while i < REGION_SLOTS {
        if (*c).slots[i].used && (*c).slots[i].rx == rx && (*c).slots[i].rz == rz { return &(*c).slots[i] }
        i = i + 1
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, (*c).dir.ptr, (*c).dir.len)
    rt.buf_push_bytes(&path, "/r.".p as u64, 3)
    rt.buf_push_dec_i64(&path, rx as i64)
    rt.buf_push(&path, 46 as u8)
    rt.buf_push_dec_i64(&path, rz as i64)
    rt.buf_push_bytes(&path, ".mca".p as u64, 4)
    rt.buf_push(&path, 0 as u8)
    let victim: usize = (*c).next
    (*c).next = (victim + 1) % REGION_SLOTS
    if (*c).slots[victim].used { mc_anvil.region_free(&(*c).slots[victim].region) }
    (*c).slots[victim] = slot_empty()
    let ok: bool = mc_anvil.region_load(path.ptr, &(*c).slots[victim].region) catch false
    rt.buf_free(&path)
    if !ok { return 0 as *mut RegionSlot }
    (*c).slots[victim].used = true
    (*c).slots[victim].rx = rx
    (*c).slots[victim].rz = rz
    return &(*c).slots[victim]
}

fn copy_section(c: *mut SaveCtx, ck: *mut save_chunk.Chunk, sec: u32, blocks: u64) {
    let sy: i32 = save_chunk.chunk_section_y(ck, sec)
    let y0: i32 = sy * 16
    if y0 < MIN_Y || y0 >= MIN_Y + HEIGHT { return }
    let ok: bool = save_chunk.section_blocks(ck, sec, (*c).index) catch false
    if !ok { return }
    let np: u32 = save_chunk.section_block_palette_size(ck, sec)
    var k: u32 = 0
    while k < np && (k as usize) < NAME_BUDGET {
        save_chunk.section_block_text(ck, sec, k, &(*c).text)
        let st: i32 = mc_registry.reg_state_by_text(&(*c).reg, (*c).text.ptr, (*c).text.len)
        var v: u16 = 0 as u16
        if st > 0 { v = st as u16 }
        rt.st16((*c).table, k as usize, v)
        k = k + 1
    }
    let base: usize = ((y0 - MIN_Y) as usize) * 256
    var j: usize = 0
    while j < SECTION_CELLS {
        rt.st16(blocks, base + j, rt.ld16((*c).table, rt.ld16((*c).index, j) as usize))
        j = j + 1
    }
}

fn fill_chunk(c: *mut SaveCtx, raw_len: usize, blocks: u64) {
    var ck: save_chunk.Chunk = save_chunk.Chunk { doc: mc_nbt.doc_new(), level: 0 as u32, legacy: false }
    let ok: bool = save_chunk.chunk_open(&ck, (*c).raw.ptr, raw_len) catch false
    if !ok { return }
    if !save_chunk.chunk_is_full(&ck) {
        save_chunk.chunk_close(&ck)
        return
    }
    let ns: u32 = save_chunk.chunk_section_count(&ck)
    var i: u32 = 0
    while i < ns {
        copy_section(c, &ck, save_chunk.chunk_section(&ck, i), blocks)
        i = i + 1
    }
    save_chunk.chunk_close(&ck)
}

fn save_fill(ctx: u64, cx: i32, cz: i32, blocks: u64) -> bool {
    let c: *mut SaveCtx = ctx_ptr(ctx)
    rt.mem_set(blocks, 0 as u8, (HEIGHT as usize) * 512)
    let rx: i32 = cx >> 5
    let rz: i32 = cz >> 5
    let slot: *mut RegionSlot = load_region(c, rx, rz)
    if slot == (0 as *mut RegionSlot) { return true }
    if !mc_anvil.region_has(&(*slot).region, cx & 31, cz & 31) { return true }
    rt.buf_clear(&(*c).raw)
    let got: usize = save_world.world_read_chunk(region_dir(c), rx, rz, &(*slot).region, cx & 31, cz & 31, &(*c).raw) catch 99999999999
    if got == 99999999999 { return true }
    fill_chunk(c, got, blocks)
    return true
}

fn save_release(ctx: u64) {
    let c: *mut SaveCtx = ctx_ptr(ctx)
    var i: usize = 0
    while i < REGION_SLOTS {
        if (*c).slots[i].used { mc_anvil.region_free(&(*c).slots[i].region) }
        i = i + 1
    }
    rt.buf_free(&(*c).dir)
    rt.buf_free(&(*c).raw)
    rt.buf_free(&(*c).text)
    rt.heap_free((*c).index, SECTION_CELLS * 2)
    rt.heap_free((*c).table, NAME_BUDGET * 2)
    var a: [SaveCtx; 2] = [*c; 2]
    rt.heap_free(ctx, ((&a[1]) as u64 - (&a[0]) as u64) as usize)
}

fn int_field(doc: *mut mc_nbt.Doc, node: u32, name: str, fallback: i32) -> i32 {
    let n: u32 = mc_nbt.nbt_get(doc, node, name.p as u64, name.n)
    if n == 0 as u32 { return fallback }
    return mc_nbt.nbt_i64(doc, n) as i32
}

fn read_spawn(root: str, out: *mut sv_world.WorldSource) -> bool {
    var path: rt.Buf = rt.buf_new()
    save_world.path_c(&path, root, "level.dat")
    var raw: rt.Buf = rt.buf_new()
    let got: usize = save_world.read_nbt_file(path.ptr, &raw) catch 99999999999
    rt.buf_free(&path)
    if got == 99999999999 {
        rt.buf_free(&raw)
        return false
    }
    var doc: mc_nbt.Doc = mc_nbt.doc_new()
    var v: bytes.Bytes = bytes.Bytes { data: raw.ptr, cap: got, len: got, pos: 0, bad: false }
    let ok: bool = mc_nbt.doc_parse(&doc, &v, false, false) catch false
    if ok {
        let data: u32 = mc_nbt.nbt_get(&doc, mc_nbt.doc_root(&doc), "Data".p as u64, 4)
        if data != 0 as u32 {
            (*out).spawn_x = int_field(&doc, data, "SpawnX", 0)
            (*out).spawn_y = int_field(&doc, data, "SpawnY", 64)
            (*out).spawn_z = int_field(&doc, data, "SpawnZ", 0)
        }
    }
    mc_nbt.doc_free(&doc)
    rt.buf_free(&raw)
    return ok
}

fn dir_readable(path: str) -> bool {
    var probe: rt.Buf = rt.buf_new()
    save_world.path_c(&probe, path, "level.dat")
    var raw: rt.Buf = rt.buf_new()
    let ok: bool = rt.read_file(probe.ptr, &raw)
    rt.buf_free(&probe)
    rt.buf_free(&raw)
    return ok
}

fn save_source_open(ver: *mut mc_version.Version, root: str, biome: i32, out: *mut sv_world.WorldSource) -> bool {
    if !dir_readable(root) { return false }
    var ctx: SaveCtx = SaveCtx { dir: rt.buf_new(), reg: (*ver).registry_of(), slots: [slot_empty(); 4], next: 0,
        raw: rt.buf_new(), text: rt.buf_new(), index: rt.heap_alloc(SECTION_CELLS * 2), table: rt.heap_alloc(NAME_BUDGET * 2) }
    rt.buf_push_bytes(&ctx.dir, root.p as u64, root.n)
    rt.buf_push_bytes(&ctx.dir, "/region".p as u64, 7)
    var a: [SaveCtx; 2] = [ctx; 2]
    let boxed: u64 = rt.heap_alloc(((&a[1]) as u64 - (&a[0]) as u64) as usize)
    *(boxed as *mut SaveCtx) = ctx
    *out = sv_world.WorldSource { ctx: boxed, fill: save_fill, release: save_release, min_y: MIN_Y, height: HEIGHT, spawn_x: 0,
        spawn_y: 64, spawn_z: 0, biome: biome, uniform: false }
    if !read_spawn(root, out) {
        sv_world.world_free(out)
        return false
    }
    return true
}
