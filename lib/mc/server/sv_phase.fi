// lib/mc/server/sv_phase.fi -- registry of tick phases. Systems register a function and run in order every tick.

import std.time

export { Phases, phases_new, phases_add, phases_run, phases_count, phases_last_us, phases_name, MAX_PHASES }

const MAX_PHASES: usize = 16

struct Phases {
    n: usize,
    run: [fn(u64); 16],
    names: [str; 16],
    last_us: [u64; 16],
}

fn nop(ctx: u64) {}

fn phases_new() -> Phases {
    return Phases { n: 0, run: [nop; 16], names: [""; 16], last_us: [0; 16] }
}

fn phases_add(p: *mut Phases, name: str, f: fn(u64)) -> bool {
    if (*p).n >= MAX_PHASES { return false }
    (*p).run[(*p).n] = f
    (*p).names[(*p).n] = name
    (*p).n = (*p).n + 1
    return true
}

fn phases_count(p: *mut Phases) -> usize { return (*p).n }

fn phases_last_us(p: *mut Phases, i: usize) -> u64 { return (*p).last_us[i] }

fn phases_name(p: *mut Phases, i: usize) -> str { return (*p).names[i] }

fn phases_run(p: *mut Phases, ctx: u64) {
    var i: usize = 0
    while i < (*p).n {
        let t0: u64 = time.monotonic_ns()
        (*p).run[i](ctx)
        (*p).last_us[i] = (time.monotonic_ns() - t0) / 1000 as u64
        i = i + 1
    }
}
