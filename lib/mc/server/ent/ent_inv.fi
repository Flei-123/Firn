import mc.server.sv_state
import mc.server.inv.sv_inv
import mc.server.inv.sv_inv_sync

export { inv_add, inv_push_all }

fn inv_push_all(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    sv_inv_sync.push_all(srv, s)
}

fn inv_add(srv: *mut sv_state.Server, s: *mut sv_state.Session, item: i32, count: i32) -> i32 {
    var changed: u64 = 0 as u64
    let added: i32 = sv_inv.add_item(srv, s, item, count, &changed)
    sv_inv_sync.push_mask(srv, s, changed)
    return added
}
