import mc.mc_registry
import mc.server.sv_state
import mc.server.ent.ent_table

export { inv_add, HOTBAR_MENU_FIRST }

const HOTBAR_MENU_FIRST: i32 = 36
const HOTBAR_SLOTS: i32 = 9

fn push_slot(srv: *mut sv_state.Server, s: *mut sv_state.Session, i: i32) {
    let f: fn(u64, u64, i32, i32, i32) = (*srv).ents.ops.inv_slot
    f(srv as u64, s as u64, HOTBAR_MENU_FIRST + i, (*s).hotbar[i as usize], (*s).hotbar_n[i as usize])
}

fn inv_add(srv: *mut sv_state.Server, s: *mut sv_state.Session, item: i32, count: i32) -> i32 {
    var stack: i32 = mc_registry.reg_item_stack(&(*srv).ents.reg, item)
    if stack <= 0 { stack = 64 }
    var left: i32 = count
    var i: i32 = 0
    while i < HOTBAR_SLOTS && left > 0 {
        let k: usize = i as usize
        if (*s).hotbar[k] == item && (*s).hotbar_n[k] > 0 && (*s).hotbar_n[k] < stack {
            var room: i32 = stack - (*s).hotbar_n[k]
            if room > left { room = left }
            (*s).hotbar_n[k] = (*s).hotbar_n[k] + room
            left = left - room
            push_slot(srv, s, i)
        }
        i = i + 1
    }
    i = 0
    while i < HOTBAR_SLOTS && left > 0 {
        let k: usize = i as usize
        if (*s).hotbar[k] <= 0 || (*s).hotbar_n[k] <= 0 {
            var put: i32 = stack
            if put > left { put = left }
            (*s).hotbar[k] = item
            (*s).hotbar_n[k] = put
            left = left - put
            push_slot(srv, s, i)
        }
        i = i + 1
    }
    return count - left
}
