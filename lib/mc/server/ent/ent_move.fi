// SPDX-License-Identifier: MPL-2.0

import std.math

export { Aabb, aabb_at, move_box, MoveWorld }

struct Aabb {
    lo: [f64; 3],
    hi: [f64; 3],
}

struct MoveWorld {
    ctx: u64,
    solid: fn(u64, i32, i32, i32) -> bool,
}

const EPS: f64 = 0.0000001

fn aabb_at(x: f64, y: f64, z: f64, w: f64, h: f64) -> Aabb {
    return Aabb { lo: [x - w / 2.0, y, z - w / 2.0], hi: [x + w / 2.0, y + h, z + w / 2.0] }
}

fn cell_lo(v: f64) -> i32 { return math.floor(v + EPS) as i32 }

fn cell_hi(v: f64) -> i32 { return math.floor(v - EPS) as i32 }

fn solid_at(w: *mut MoveWorld, axis: usize, a: i32, b: i32, c: i32) -> bool {
    let f: fn(u64, i32, i32, i32) -> bool = (*w).solid
    if axis == 0 { return f((*w).ctx, a, b, c) }
    if axis == 1 { return f((*w).ctx, c, a, b) }
    return f((*w).ctx, b, c, a)
}

fn clip_axis(w: *mut MoveWorld, bx: *mut Aabb, axis: usize, d: f64) -> f64 {
    if d == 0.0 { return 0.0 }
    let o1: usize = (axis + 1) % 3
    let o2: usize = (axis + 2) % 3
    let l1: i32 = cell_lo((*bx).lo[o1])
    let h1: i32 = cell_hi((*bx).hi[o1])
    let l2: i32 = cell_lo((*bx).lo[o2])
    let h2: i32 = cell_hi((*bx).hi[o2])
    if d > 0.0 {
        let start: i32 = cell_hi((*bx).hi[axis]) + 1
        let stop: i32 = cell_hi((*bx).hi[axis] + d)
        var k: i32 = start
        while k <= stop {
            var u: i32 = l1
            while u <= h1 {
                var v: i32 = l2
                while v <= h2 {
                    if solid_at(w, axis, k, u, v) {
                        let lim: f64 = (k as f64) - (*bx).hi[axis]
                        if lim < d { return lim }
                        return d
                    }
                    v = v + 1
                }
                u = u + 1
            }
            k = k + 1
        }
        return d
    }
    let start: i32 = cell_lo((*bx).lo[axis]) - 1
    let stop: i32 = cell_lo((*bx).lo[axis] + d)
    var k: i32 = start
    while k >= stop {
        var u: i32 = l1
        while u <= h1 {
            var v: i32 = l2
            while v <= h2 {
                if solid_at(w, axis, k, u, v) {
                    let lim: f64 = ((k + 1) as f64) - (*bx).lo[axis]
                    if lim > d { return lim }
                    return d
                }
                v = v + 1
            }
            u = u + 1
        }
        k = k - 1
    }
    return d
}

fn shift(bx: *mut Aabb, axis: usize, d: f64) {
    (*bx).lo[axis] = (*bx).lo[axis] + d
    (*bx).hi[axis] = (*bx).hi[axis] + d
}

fn move_box(w: *mut MoveWorld, bx: *mut Aabb, dx: f64, dy: f64, dz: f64, out: *mut [f64; 3]) -> bool {
    let mut_y: f64 = clip_axis(w, bx, 1, dy)
    shift(bx, 1, mut_y)
    var rx: f64 = dx
    var rz: f64 = dz
    if math.fabs(dx) >= math.fabs(dz) {
        rx = clip_axis(w, bx, 0, dx)
        shift(bx, 0, rx)
        rz = clip_axis(w, bx, 2, dz)
        shift(bx, 2, rz)
    } else {
        rz = clip_axis(w, bx, 2, dz)
        shift(bx, 2, rz)
        rx = clip_axis(w, bx, 0, dx)
        shift(bx, 0, rx)
    }
    (*out)[0] = rx
    (*out)[1] = mut_y
    (*out)[2] = rz
    return dy < 0.0 && mut_y != dy
}
