import std.rt
import mc.mc_encode
import mc.server.ent.ent_table

export { crystal_metadata }

const METADATA_CRYSTAL_BEAM_KEY: i64 = 8
const METADATA_CRYSTAL_BOTTOM_KEY: i64 = 9
const METADATA_TYPE_OPT_BLOCK_POS: i64 = 11
const METADATA_TYPE_BOOL: i64 = 8

fn crystal_metadata(v: *mut rt.Buf, e: *mut ent_table.Entity) {
    var n: i64 = 0
    if (*e).beam_set {
        mc_encode.vals_i64(v, "metadata[0].key", METADATA_CRYSTAL_BEAM_KEY)
        mc_encode.vals_i64(v, "metadata[0].type", METADATA_TYPE_OPT_BLOCK_POS)
        mc_encode.vals_i64(v, "metadata[0].value.x", (*e).beam_x as i64)
        mc_encode.vals_i64(v, "metadata[0].value.y", (*e).beam_y as i64)
        mc_encode.vals_i64(v, "metadata[0].value.z", (*e).beam_z as i64)
        n = 1
    }
    if !(*e).show_bottom {
        if n == 0 {
            mc_encode.vals_i64(v, "metadata[0].key", METADATA_CRYSTAL_BOTTOM_KEY)
            mc_encode.vals_i64(v, "metadata[0].type", METADATA_TYPE_BOOL)
            mc_encode.vals_bool(v, "metadata[0].value", false)
        } else {
            mc_encode.vals_i64(v, "metadata[1].key", METADATA_CRYSTAL_BOTTOM_KEY)
            mc_encode.vals_i64(v, "metadata[1].type", METADATA_TYPE_BOOL)
            mc_encode.vals_bool(v, "metadata[1].value", false)
        }
    }
}
