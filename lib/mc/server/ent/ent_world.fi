import mc.mc_registry
import mc.server.sv_state
import mc.server.sv_dig
import mc.server.ent.ent_move

export { world_for_entities }

fn solid_cb(ctx: u64, x: i32, y: i32, z: i32) -> bool {
    let srv: *mut sv_state.Server = ctx as *mut sv_state.Server
    let st: i32 = sv_dig.world_peek(srv, x, y, z)
    if st < 0 { return true }
    if st == 0 { return false }
    let b: i32 = mc_registry.reg_block_of_state(&(*srv).ents.reg, st)
    return (mc_registry.reg_block_flags(&(*srv).ents.reg, b) & mc_registry.RF_SOLID) != 0 as u32
}

fn world_for_entities(srv: *mut sv_state.Server) -> ent_move.MoveWorld {
    return ent_move.MoveWorld { ctx: srv as u64, solid: solid_cb }
}
