import std.rt
import mc.mc_registry

export {
    Entity, Table, WireOps, table_new, table_free, table_at, table_alloc, table_release, table_find_eid, table_count, rng_next, rng_unit,
    wire_ops_none, KIND_NONE, KIND_PLAYER, KIND_ITEM, TABLE_CAP, OWNER_NONE,
}

const TABLE_CAP: usize = 2048
const KIND_NONE: i32 = 0
const KIND_PLAYER: i32 = 1
const KIND_ITEM: i32 = 2
const OWNER_NONE: i32 = 0 - 1

struct Entity {
    used: bool,
    eid: i32,
    kind: i32,
    type_id: i32,
    owner: i32,
    uuid_hi: u64,
    uuid_lo: u64,
    x: f64,
    y: f64,
    z: f64,
    vx: f64,
    vy: f64,
    vz: f64,
    yaw: f32,
    pitch: f32,
    on_ground: bool,
    age: i32,
    pickup_delay: i32,
    item: i32,
    count: i32,
    track: u32,
    sent_x: f64,
    sent_y: f64,
    sent_z: f64,
    sent_yaw: f32,
    sent_pitch: f32,
    sent_ground: bool,
    dead: bool,
}

struct WireOps {
    spawn: fn(u64, u64, *mut Entity),
    destroy: fn(u64, u64, i32),
    teleport: fn(u64, u64, *mut Entity),
    rel_move: fn(u64, u64, *mut Entity, i32, i32, i32),
    rel_move_look: fn(u64, u64, *mut Entity, i32, i32, i32),
    head: fn(u64, u64, *mut Entity),
    inv_slot: fn(u64, u64, i32, i32, i32),
    velocity: fn(u64, u64, *mut Entity),
    metadata: fn(u64, u64, *mut Entity),
    collect: fn(u64, u64, i32, i32, i32),
    player_add: fn(u64, u64, u64, *mut Entity),
    player_remove: fn(u64, u64, *mut Entity),
}

struct Table {
    base: u64,
    stride: usize,
    n: usize,
    reg: mc_registry.Registry,
    ops: WireOps,
    item_type: i32,
    player_type: i32,
    rng: u64,
    loot: fn(*mut mc_registry.Registry, i32) -> i32,
}

fn nop_spawn(a: u64, b: u64, e: *mut Entity) {}
fn nop_move(a: u64, b: u64, e: *mut Entity, dx: i32, dy: i32, dz: i32) {}
fn nop_slot(a: u64, b: u64, slot: i32, item: i32, n: i32) {}
fn nop_destroy(a: u64, b: u64, eid: i32) {}
fn nop_collect(a: u64, b: u64, c: i32, d: i32, n: i32) {}
fn nop_player_add(a: u64, b: u64, c: u64, e: *mut Entity) {}

fn wire_ops_none() -> WireOps {
    return WireOps { spawn: nop_spawn, destroy: nop_destroy, teleport: nop_spawn, rel_move: nop_move, rel_move_look: nop_move, head: nop_spawn, inv_slot: nop_slot, velocity: nop_spawn,
        metadata: nop_spawn, collect: nop_collect, player_add: nop_player_add, player_remove: nop_spawn }
}

fn entity_empty() -> Entity {
    return Entity { used: false, eid: 0, kind: 0, type_id: 0, owner: OWNER_NONE, uuid_hi: 0, uuid_lo: 0, x: 0.0, y: 0.0,
        z: 0.0, vx: 0.0, vy: 0.0, vz: 0.0, yaw: 0.0f, pitch: 0.0f, on_ground: false, age: 0, pickup_delay: 0,
        item: 0, count: 0, track: 0 as u32, sent_x: 0.0, sent_y: 0.0, sent_z: 0.0, sent_yaw: 0.0f, sent_pitch: 0.0f,
        sent_ground: false, dead: false }
}

fn loot_same_name(reg: *mut mc_registry.Registry, block: i32) -> i32 {
    var l: usize = 0
    let p: u64 = mc_registry.reg_block_name(reg, block, &l)
    return mc_registry.reg_item_by_name(reg, p, l)
}

fn type_of_name(reg: *mut mc_registry.Registry, want: str) -> i32 {
    var i: i32 = 0
    while i < mc_registry.reg_entity_count(reg) {
        var l: usize = 0
        let p: u64 = mc_registry.reg_entity_name(reg, i, &l)
        if l == want.n && rt.mem_eq(p, want.p as u64, l) { return mc_registry.reg_entity_id(reg, i) }
        i = i + 1
    }
    return 0 - 1
}

fn table_new(reg: mc_registry.Registry) -> Table {
    var a: [Entity; 2] = [entity_empty(); 2]
    let stride: usize = ((&a[1]) as u64 - (&a[0]) as u64) as usize
    let base: u64 = rt.heap_alloc(stride * TABLE_CAP)
    var i: usize = 0
    while i < TABLE_CAP {
        *((base + (i * stride) as u64) as *mut Entity) = entity_empty()
        i = i + 1
    }
    var r: mc_registry.Registry = reg
    let it: i32 = type_of_name(&r, "item")
    let pt: i32 = type_of_name(&r, "player")
    return Table { base: base, stride: stride, n: 0, reg: reg, ops: wire_ops_none(), item_type: it, player_type: pt, rng: 88172645463325252 as u64, loot: loot_same_name }
}

fn table_free(t: *mut Table) {
    rt.heap_free((*t).base, (*t).stride * TABLE_CAP)
}

fn table_at(t: *mut Table, i: usize) -> *mut Entity {
    return ((*t).base + (i * (*t).stride) as u64) as *mut Entity
}

fn table_alloc(t: *mut Table) -> *mut Entity {
    var i: usize = 0
    while i < TABLE_CAP {
        let e: *mut Entity = table_at(t, i)
        if !(*e).used {
            *e = entity_empty()
            (*e).used = true
            (*t).n = (*t).n + 1
            return e
        }
        i = i + 1
    }
    return 0 as *mut Entity
}

fn table_release(t: *mut Table, e: *mut Entity) {
    if (*e).used { (*t).n = (*t).n - 1 }
    *e = entity_empty()
}

fn table_find_eid(t: *mut Table, eid: i32) -> *mut Entity {
    var i: usize = 0
    while i < TABLE_CAP {
        let e: *mut Entity = table_at(t, i)
        if (*e).used && (*e).eid == eid { return e }
        i = i + 1
    }
    return 0 as *mut Entity
}

fn table_count(t: *mut Table) -> usize { return (*t).n }

fn rng_next(t: *mut Table) -> u64 {
    var v: u64 = (*t).rng
    v = v ^ (v << 13 as u64)
    v = v ^ (v >> 7 as u64)
    v = v ^ (v << 17 as u64)
    (*t).rng = v
    return v
}

fn rng_unit(t: *mut Table) -> f64 {
    return ((rng_next(t) >> 11 as u64) as f64) / 9007199254740992.0
}
