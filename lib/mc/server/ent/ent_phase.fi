import std.math
import mc.server.sv_state
import mc.server.ent.ent_table
import mc.server.ent.ent_move
import mc.server.ent.ent_item
import mc.server.ent.ent_world
import mc.server.ent.ent_track
import mc.server.ent.ent_inv

export { entities_phase }

const PLAYER_HALF_W: f64 = 0.3
const PLAYER_HEIGHT: f64 = 1.8
const PICKUP_GROW_XZ: f64 = 1.0
const PICKUP_GROW_Y: f64 = 0.5
const GM_SPECTATOR: i32 = 3

fn live(s: *mut sv_state.Session) -> bool {
    return (*s).used && (*s).joined && !(*s).closing
}

fn player_entity(t: *mut ent_table.Table, slot: usize) -> *mut ent_table.Entity {
    var i: usize = 0
    while i < ent_table.TABLE_CAP {
        let e: *mut ent_table.Entity = ent_table.table_at(t, i)
        if (*e).used && (*e).kind == ent_table.KIND_PLAYER && (*e).owner == slot as i32 { return e }
        i = i + 1
    }
    return 0 as *mut ent_table.Entity
}

fn sync_players(srv: *mut sv_state.Server) {
    let t: *mut ent_table.Table = &(*srv).ents
    var j: usize = 0
    while j < sv_state.MAX_SESSIONS {
        let s: *mut sv_state.Session = sv_state.session_at(srv, j)
        let e: *mut ent_table.Entity = player_entity(t, j)
        if live(s) {
            var p: *mut ent_table.Entity = e
            if p as u64 == 0 as u64 {
                p = ent_table.table_alloc(t)
                if p as u64 != 0 as u64 {
                    (*p).eid = (*s).eid
                    (*p).kind = ent_table.KIND_PLAYER
                    (*p).type_id = (*t).player_type
                    (*p).owner = j as i32
                    (*p).uuid_hi = (*s).uuid_hi
                    (*p).uuid_lo = (*s).uuid_lo
                    (*p).sent_x = (*s).x
                    (*p).sent_y = (*s).y
                    (*p).sent_z = (*s).z
                    (*p).sent_yaw = (*s).yaw
                    (*p).sent_pitch = (*s).pitch
                }
            }
            if p as u64 != 0 as u64 {
                (*p).x = (*s).x
                (*p).y = (*s).y
                (*p).z = (*s).z
                (*p).yaw = (*s).yaw
                (*p).pitch = (*s).pitch
                (*p).on_ground = (*s).on_ground
                (*p).age = (*p).age + 1
            }
        } else if e as u64 != 0 as u64 {
            (*e).dead = true
        }
        j = j + 1
    }
}

fn overlaps(s: *mut sv_state.Session, e: *mut ent_table.Entity) -> bool {
    let pw: f64 = PLAYER_HALF_W + PICKUP_GROW_XZ
    let iw: f64 = ent_item.ITEM_WIDTH / 2.0
    if math.fabs((*s).x - (*e).x) >= pw + iw { return false }
    if math.fabs((*s).z - (*e).z) >= pw + iw { return false }
    if (*e).y >= (*s).y + PLAYER_HEIGHT + PICKUP_GROW_Y { return false }
    if (*e).y + ent_item.ITEM_HEIGHT <= (*s).y - PICKUP_GROW_Y { return false }
    return true
}

fn try_pickup(srv: *mut sv_state.Server, e: *mut ent_table.Entity) {
    if (*e).pickup_delay > 0 || (*e).dead { return }
    var j: usize = 0
    while j < sv_state.MAX_SESSIONS {
        let s: *mut sv_state.Session = sv_state.session_at(srv, j)
        if live(s) && (*s).gamemode != GM_SPECTATOR && overlaps(s, e) {
            let taken: i32 = ent_inv.inv_add(srv, s, (*e).item, (*e).count)
            if taken > 0 {
                ent_track.track_collect(srv, e, s, taken)
                (*e).count = (*e).count - taken
                if (*e).count <= 0 {
                    (*e).dead = true
                    return
                }
            }
        }
        j = j + 1
    }
}

fn tick_items(srv: *mut sv_state.Server) {
    let t: *mut ent_table.Table = &(*srv).ents
    var w: ent_move.MoveWorld = ent_world.world_for_entities(srv)
    var i: usize = 0
    while i < ent_table.TABLE_CAP {
        let e: *mut ent_table.Entity = ent_table.table_at(t, i)
        if (*e).used && (*e).kind == ent_table.KIND_ITEM && !(*e).dead {
            ent_item.item_tick(e, &w)
            try_pickup(srv, e)
        }
        i = i + 1
    }
}

fn reap(srv: *mut sv_state.Server) {
    let t: *mut ent_table.Table = &(*srv).ents
    var i: usize = 0
    while i < ent_table.TABLE_CAP {
        let e: *mut ent_table.Entity = ent_table.table_at(t, i)
        if (*e).used && (*e).dead { ent_track.track_release(srv, e) }
        i = i + 1
    }
}

fn entities_phase(ctx: u64) {
    let srv: *mut sv_state.Server = ctx as *mut sv_state.Server
    sync_players(srv)
    tick_items(srv)
    ent_track.track_update(srv)
    reap(srv)
}
