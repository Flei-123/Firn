import std.math
import mc.server.ent.ent_table
import mc.server.ent.ent_move

export { item_spawn, item_tick, ITEM_WIDTH, ITEM_HEIGHT, PICKUP_DELAY_DEFAULT, ITEM_MAX_AGE }

const ITEM_WIDTH: f64 = 0.25
const ITEM_HEIGHT: f64 = 0.25
const PICKUP_DELAY_DEFAULT: i32 = 10
const ITEM_MAX_AGE: i32 = 6000
const GRAVITY: f64 = 0.04
const DRAG: f64 = 0.98
const GROUND_FRICTION: f64 = 0.6
const SETTLE_SQ: f64 = 0.00001

fn item_spawn(t: *mut ent_table.Table, eid: i32, x: f64, y: f64, z: f64, item: i32, count: i32) -> *mut ent_table.Entity {
    let e: *mut ent_table.Entity = ent_table.table_alloc(t)
    if e as u64 == 0 as u64 { return e }
    (*e).eid = eid
    (*e).kind = ent_table.KIND_ITEM
    (*e).type_id = (*t).item_type
    (*e).uuid_hi = ent_table.rng_next(t)
    (*e).uuid_lo = ent_table.rng_next(t)
    (*e).x = x
    (*e).y = y
    (*e).z = z
    (*e).vx = ent_table.rng_unit(t) * 0.2 - 0.1
    (*e).vy = 0.2
    (*e).vz = ent_table.rng_unit(t) * 0.2 - 0.1
    (*e).item = item
    (*e).count = count
    (*e).pickup_delay = PICKUP_DELAY_DEFAULT
    (*e).sent_x = x
    (*e).sent_y = y
    (*e).sent_z = z
    return e
}

fn item_tick(e: *mut ent_table.Entity, w: *mut ent_move.MoveWorld) {
    if (*e).pickup_delay > 0 { (*e).pickup_delay = (*e).pickup_delay - 1 }
    (*e).vy = (*e).vy - GRAVITY
    let h2: f64 = (*e).vx * (*e).vx + (*e).vz * (*e).vz
    if !(*e).on_ground || h2 > SETTLE_SQ || ((*e).age + (*e).eid) % 4 == 0 {
        var bx: ent_move.Aabb = ent_move.aabb_at((*e).x, (*e).y, (*e).z, ITEM_WIDTH, ITEM_HEIGHT)
        var d: [f64; 3] = [0.0; 3]
        let landed: bool = ent_move.move_box(w, &bx, (*e).vx, (*e).vy, (*e).vz, &d)
        (*e).x = (*e).x + d[0]
        (*e).y = (*e).y + d[1]
        (*e).z = (*e).z + d[2]
        if d[0] != (*e).vx { (*e).vx = 0.0 }
        if d[2] != (*e).vz { (*e).vz = 0.0 }
        if d[1] != (*e).vy { (*e).vy = 0.0 }
        (*e).on_ground = landed
        var f: f64 = DRAG
        if (*e).on_ground { f = GROUND_FRICTION * DRAG }
        (*e).vx = (*e).vx * f
        (*e).vy = (*e).vy * DRAG
        (*e).vz = (*e).vz * f
    }
    (*e).age = (*e).age + 1
    if (*e).age >= ITEM_MAX_AGE { (*e).dead = true }
}
