import mc.mc_registry
import mc.server.sv_state
import mc.server.ent.ent_table
import mc.server.ent.ent_item

export { drop_block }

const SPREAD: f64 = 0.25
const HALF_ITEM: f64 = 0.125

fn jitter(t: *mut ent_table.Table) -> f64 {
    return (ent_table.rng_unit(t) * 2.0 - 1.0) * SPREAD
}

fn drop_block(srv: *mut sv_state.Server, x: i32, y: i32, z: i32, old_state: i32) {
    if (*srv).cfg.game_mode == 1 || old_state <= 0 { return }
    let t: *mut ent_table.Table = &(*srv).ents
    let block: i32 = mc_registry.reg_block_of_state(&(*t).reg, old_state)
    if block < 0 { return }
    let pick: fn(*mut mc_registry.Registry, i32) -> i32 = (*t).loot
    let item: i32 = pick(&(*t).reg, block)
    if item <= 0 { return }
    let eid: i32 = (*srv).next_eid
    (*srv).next_eid = eid + 1
    let px: f64 = (x as f64) + 0.5 + jitter(t)
    let py: f64 = (y as f64) + 0.5 + jitter(t) - HALF_ITEM
    let pz: f64 = (z as f64) + 0.5 + jitter(t)
    ent_item.item_spawn(t, eid, px, py, pz, item, 1)
}
