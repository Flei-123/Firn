import std.rt
import std.math
import std.bytes
import mc.server.sv_state
import mc.server.sv_edits
import mc.server.ent.ent_table
import mc.server.ent.ent_crystal

export { ents_load, ents_save }

const FILE_NAME: str = "firn_entities.bin"
const MAGIC: u64 = 4607182418800017408
const HEADER_WORDS: usize = 3
const ENTITY_WORDS: usize = 8
const POS_SCALE: f64 = 4096.0
const YAW_SCALE: f64 = 1024.0
const FLAG_SHOW_BOTTOM: u64 = 1
const FLAG_BEAM: u64 = 2
const FLAG_INVULNERABLE: u64 = 4
const COORD_BIAS: i64 = 2147483648

fn path_of(srv: *mut sv_state.Server) -> rt.Buf {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, (*srv).world_dir.ptr, (*srv).world_dir.len)
    rt.buf_push(&b, 47 as u8)
    rt.buf_push_bytes(&b, FILE_NAME.p as u64, FILE_NAME.n)
    rt.buf_push(&b, 0 as u8)
    return b
}

fn enc_fixed(v: f64, scale: f64) -> u64 {
    return bytes.bits_u64(math.floor(v * scale + 0.5) as i64)
}

fn dec_fixed(w: u64, scale: f64) -> f64 {
    return (bytes.bits_i64(w) as f64) / scale
}

fn count_persistent(srv: *mut sv_state.Server) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < ent_table.TABLE_CAP {
        let e: *mut ent_table.Entity = ent_table.table_at(&(*srv).ents, i)
        if (*e).used && (*e).kind == ent_table.KIND_CRYSTAL && !(*e).dead { n = n + 1 }
        i = i + 1
    }
    return n
}

fn flags_of(e: *mut ent_table.Entity) -> u64 {
    var f: u64 = 0 as u64
    if (*e).show_bottom { f = f | FLAG_SHOW_BOTTOM }
    if (*e).beam_set { f = f | FLAG_BEAM }
    if (*e).invulnerable { f = f | FLAG_INVULNERABLE }
    return f
}

fn put_entity(out: u64, at: usize, e: *mut ent_table.Entity) {
    rt.st64(out, at, (*e).kind as u64)
    rt.st64(out, at + 1, enc_fixed((*e).x, POS_SCALE))
    rt.st64(out, at + 2, enc_fixed((*e).y, POS_SCALE))
    rt.st64(out, at + 3, enc_fixed((*e).z, POS_SCALE))
    rt.st64(out, at + 4, enc_fixed((*e).yaw as f64, YAW_SCALE))
    rt.st64(out, at + 5, flags_of(e))
    rt.st64(out, at + 6, (((*e).beam_x as i64) + COORD_BIAS) as u64)
    rt.st64(out, at + 7, ((((*e).beam_y as i64) + COORD_BIAS) as u64) << 32 as u64 | ((((*e).beam_z as i64) + COORD_BIAS) as u64))
}

fn read_entity(srv: *mut sv_state.Server, p: u64, at: usize) {
    if rt.ld64(p, at) != (ent_table.KIND_CRYSTAL as u64) { return }
    let root: *mut sv_state.Server = sv_state.srv_root(srv)
    let eid: i32 = (*root).next_eid
    (*root).next_eid = eid + 1
    let e: *mut ent_table.Entity = ent_crystal.crystal_spawn(&(*srv).ents, eid, dec_fixed(rt.ld64(p, at + 1), POS_SCALE),
        dec_fixed(rt.ld64(p, at + 2), POS_SCALE), dec_fixed(rt.ld64(p, at + 3), POS_SCALE), dec_fixed(rt.ld64(p, at + 4), YAW_SCALE) as f32)
    if e as u64 == 0 as u64 { return }
    let flags: u64 = rt.ld64(p, at + 5)
    (*e).show_bottom = (flags & FLAG_SHOW_BOTTOM) != 0 as u64
    (*e).invulnerable = (flags & FLAG_INVULNERABLE) != 0 as u64
    if (flags & FLAG_BEAM) != 0 as u64 {
        let packed: u64 = rt.ld64(p, at + 7)
        ent_crystal.crystal_set_beam(e, (rt.ld64(p, at + 6) as i64 - COORD_BIAS) as i32, ((packed >> 32 as u64) as i64 - COORD_BIAS) as i32,
            ((packed & 4294967295 as u64) as i64 - COORD_BIAS) as i32)
    }
}

fn ents_load(srv: *mut sv_state.Server) {
    var path: rt.Buf = path_of(srv)
    var raw: rt.Buf = rt.buf_new()
    if rt.read_file(rt.buf_ptr(&path), &raw) && rt.buf_len(&raw) >= HEADER_WORDS * 8 {
        let p: u64 = rt.buf_ptr(&raw)
        let seen: usize = rt.ld64(p, 1) as usize
        let ents: usize = rt.ld64(p, 2) as usize
        if rt.ld64(p, 0) == MAGIC && rt.buf_len(&raw) >= (HEADER_WORDS + seen * 2 + ents * ENTITY_WORDS) * 8 {
            var i: usize = 0
            while i < seen {
                sv_edits.edits_restore(&(*srv).ent_seen, rt.ld64(p, HEADER_WORDS + i * 2), rt.ld64(p, HEADER_WORDS + i * 2 + 1))
                i = i + 1
            }
            i = 0
            while i < ents {
                read_entity(srv, p, HEADER_WORDS + seen * 2 + i * ENTITY_WORDS)
                i = i + 1
            }
        }
    }
    sv_edits.edits_clear_dirty(&(*srv).ent_seen)
    (*srv).ent_dirty = false
    rt.buf_free(&raw)
    rt.buf_free(&path)
}

fn ents_save(srv: *mut sv_state.Server) {
    if !(*srv).ent_dirty { return }
    let seen: usize = sv_edits.edits_total(&(*srv).ent_seen)
    let ents: usize = count_persistent(srv)
    let words: usize = HEADER_WORDS + seen * 2 + ents * ENTITY_WORDS
    let out: u64 = rt.heap_alloc(words * 8 + 8)
    rt.st64(out, 0, MAGIC)
    rt.st64(out, 1, seen as u64)
    rt.st64(out, 2, ents as u64)
    var n: usize = 0
    var i: usize = 0
    while i < sv_edits.edits_slot_count(&(*srv).ent_seen) {
        let k: u64 = sv_edits.edits_slot_key(&(*srv).ent_seen, i)
        if k != 0 as u64 && n < seen {
            rt.st64(out, HEADER_WORDS + n * 2, k)
            rt.st64(out, HEADER_WORDS + n * 2 + 1, sv_edits.edits_slot_val(&(*srv).ent_seen, i))
            n = n + 1
        }
        i = i + 1
    }
    var at: usize = HEADER_WORDS + seen * 2
    i = 0
    while i < ent_table.TABLE_CAP {
        let e: *mut ent_table.Entity = ent_table.table_at(&(*srv).ents, i)
        if (*e).used && (*e).kind == ent_table.KIND_CRYSTAL && !(*e).dead {
            put_entity(out, at, e)
            at = at + ENTITY_WORDS
        }
        i = i + 1
    }
    var path: rt.Buf = path_of(srv)
    rt.write_file(rt.buf_ptr(&path), out, words * 8)
    rt.buf_free(&path)
    rt.heap_free(out, words * 8 + 8)
    (*srv).ent_dirty = false
}
