import mc.server.ent.ent_table

export { crystal_spawn, crystal_set_beam, CRYSTAL_RANGE_CHUNKS }

const CRYSTAL_RANGE_CHUNKS: i32 = 16

fn crystal_spawn(t: *mut ent_table.Table, eid: i32, x: f64, y: f64, z: f64, yaw: f32) -> *mut ent_table.Entity {
    let e: *mut ent_table.Entity = ent_table.table_alloc(t)
    if e as u64 == 0 as u64 { return e }
    (*e).eid = eid
    (*e).kind = ent_table.KIND_CRYSTAL
    (*e).type_id = (*t).crystal_type
    (*e).uuid_hi = ent_table.rng_next(t)
    (*e).uuid_lo = ent_table.rng_next(t)
    (*e).x = x
    (*e).y = y
    (*e).z = z
    (*e).yaw = yaw
    (*e).sent_x = x
    (*e).sent_y = y
    (*e).sent_z = z
    (*e).sent_yaw = yaw
    return e
}

fn crystal_set_beam(e: *mut ent_table.Entity, x: i32, y: i32, z: i32) {
    (*e).beam_set = true
    (*e).beam_x = x
    (*e).beam_y = y
    (*e).beam_z = z
}
