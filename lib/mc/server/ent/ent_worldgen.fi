import mc.gen.wgft_crystal
import mc.server.sv_state
import mc.server.sv_dim
import mc.server.sv_edits
import mc.server.sv_gen
import mc.server.ent.ent_table
import mc.server.ent.ent_crystal

export { worldgen_entities }

fn worldgen_ready(srv: *mut sv_state.Server) -> bool {
    return (*srv).dim_kind == sv_dim.DIM_END && (*srv).gen_world && !(*srv).world.uniform && (*srv).world.ctx != 0 as u64
}

fn worldgen_entities(srv: *mut sv_state.Server, cx: i32, cz: i32) {
    if !worldgen_ready(srv) { return }
    var seen: i32 = 0
    if sv_edits.edits_get(&(*srv).ent_seen, cx, 0, cz, &seen) { return }
    sv_edits.edits_set(&(*srv).ent_seen, cx, 0, cz, 1)
    (*srv).ent_dirty = true
    var c: wgft_crystal.CrystalSpawn = wgft_crystal.CrystalSpawn { x: 0.0, y: 0.0, z: 0.0, yaw: 0.0f }
    if !sv_gen.gen_end_crystal((*srv).world.ctx, cx, cz, &c) { return }
    let root: *mut sv_state.Server = sv_state.srv_root(srv)
    let eid: i32 = (*root).next_eid
    (*root).next_eid = eid + 1
    ent_crystal.crystal_spawn(&(*srv).ents, eid, c.x, c.y, c.z, c.yaw)
}
