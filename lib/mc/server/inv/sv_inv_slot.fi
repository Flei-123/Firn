import mc.server.sv_state
import mc.server.inv.sv_inv
import mc.server.inv.sv_inv_equip

export { slot_limit, cap_of, may_place, may_pickup, is_armor, allow_modification }

fn is_armor(k: i32) -> bool {
    return k >= sv_inv.ARMOR_FIRST && k < sv_inv.ARMOR_END
}

fn slot_limit(k: i32) -> i32 {
    if is_armor(k) { return 1 }
    return sv_inv.SLOT_LIMIT
}

fn cap_of(srv: *mut sv_state.Server, k: i32, item: i32) -> i32 {
    let a: i32 = slot_limit(k)
    let b: i32 = sv_inv.stack_max(srv, item)
    if a < b { return a }
    return b
}

fn may_place(srv: *mut sv_state.Server, k: i32, item: i32) -> bool {
    if k == sv_inv.RESULT { return false }
    if is_armor(k) { return sv_inv_equip.equip_slot(srv, item) == k - sv_inv.ARMOR_FIRST + 1 }
    return true
}

fn may_pickup(k: i32) -> bool {
    return true
}

fn allow_modification(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32) -> bool {
    return may_pickup(k) && may_place(srv, k, sv_inv.slot_item(s, k))
}
