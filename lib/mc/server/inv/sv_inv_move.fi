import mc.server.sv_state
import mc.server.inv.sv_inv
import mc.server.inv.sv_inv_slot
import mc.server.inv.sv_inv_equip
import mc.server.inv.sv_inv_craft

export { move_to, quick_move_once }

fn in_range(i: i32, first: i32, end: i32, reverse: bool) -> bool {
    if reverse { return i >= first }
    return i < end
}

fn move_to(srv: *mut sv_state.Server, s: *mut sv_state.Session, src: i32, first: i32, end: i32, reverse: bool) -> bool {
    let item: i32 = sv_inv.slot_item(s, src)
    let imax: i32 = sv_inv.stack_max(srv, item)
    var moved: bool = false
    var i: i32 = first
    if reverse { i = end - 1 }
    if imax > 1 {
        while sv_inv.slot_count(s, src) > 0 && in_range(i, first, end, reverse) {
            let have: i32 = sv_inv.slot_count(s, i)
            if sv_inv.slot_item(s, i) == item && have > 0 {
                let left: i32 = sv_inv.slot_count(s, src)
                if have + left <= imax {
                    sv_inv_craft.put(srv, s, src, item, 0)
                    sv_inv_craft.put(srv, s, i, item, have + left)
                    moved = true
                } else if have < imax {
                    sv_inv_craft.put(srv, s, src, item, left - (imax - have))
                    sv_inv_craft.put(srv, s, i, item, imax)
                    moved = true
                }
            }
            if reverse { i = i - 1 } else { i = i + 1 }
        }
    }
    if sv_inv.slot_count(s, src) > 0 {
        i = first
        if reverse { i = end - 1 }
        while in_range(i, first, end, reverse) {
            if sv_inv.slot_count(s, i) <= 0 && sv_inv_slot.may_place(srv, i, item) {
                let left2: i32 = sv_inv.slot_count(s, src)
                var put: i32 = left2
                if put > sv_inv_slot.slot_limit(i) { put = sv_inv_slot.slot_limit(i) }
                sv_inv_craft.put(srv, s, src, item, left2 - put)
                sv_inv_craft.put(srv, s, i, item, put)
                moved = true
                break
            }
            if reverse { i = i - 1 } else { i = i + 1 }
        }
    }
    return moved
}

fn quick_move_once(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, spill: *mut i32, spill_n: *mut i32) -> bool {
    let item: i32 = sv_inv.slot_item(s, k)
    let before: i32 = sv_inv.slot_count(s, k)
    if item <= 0 || before <= 0 { return false }
    let eq: i32 = sv_inv_equip.equip_slot(srv, item)
    var ok: bool = false
    if k == sv_inv.RESULT {
        ok = move_to(srv, s, k, sv_inv.MAIN_FIRST, sv_inv.OFFHAND, true)
    } else if k >= sv_inv.CRAFT_FIRST && k < sv_inv.ARMOR_END {
        ok = move_to(srv, s, k, sv_inv.MAIN_FIRST, sv_inv.OFFHAND, false)
    } else if eq >= sv_inv_equip.EQ_HEAD && eq <= sv_inv_equip.EQ_FEET && sv_inv.slot_count(s, sv_inv.ARMOR_FIRST + eq - 1) <= 0 {
        let a: i32 = sv_inv.ARMOR_FIRST + eq - 1
        ok = move_to(srv, s, k, a, a + 1, false)
    } else if eq == sv_inv_equip.EQ_OFFHAND && sv_inv.slot_count(s, sv_inv.OFFHAND) <= 0 {
        ok = move_to(srv, s, k, sv_inv.OFFHAND, sv_inv.OFFHAND + 1, false)
    } else if k >= sv_inv.MAIN_FIRST && k < sv_inv.MAIN_END {
        ok = move_to(srv, s, k, sv_inv.HOTBAR_FIRST, sv_inv.OFFHAND, false)
    } else if k >= sv_inv.HOTBAR_FIRST && k < sv_inv.OFFHAND {
        ok = move_to(srv, s, k, sv_inv.MAIN_FIRST, sv_inv.MAIN_END, false)
    } else {
        ok = move_to(srv, s, k, sv_inv.MAIN_FIRST, sv_inv.OFFHAND, false)
    }
    if !ok { return false }
    let after: i32 = sv_inv.slot_count(s, k)
    if after == before { return false }
    if k == sv_inv.RESULT {
        let left_item: i32 = sv_inv.slot_item(s, k)
        sv_inv_craft.consume(srv, s, spill, spill_n)
        if left_item > 0 && after > 0 { *spill = left_item; *spill_n = *spill_n + after }
    }
    return true
}
