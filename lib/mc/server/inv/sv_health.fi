import std.rt
import mc.mc_encode
import mc.mc_sem
import mc.mc_version
import mc.server.sv_state
import mc.server.sv_send

export { send_health, MAX_HEALTH, MAX_FOOD }

const MAX_HEALTH: f32 = 20.0f
const MAX_FOOD: i32 = 20

fn send_health(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_f32(&v, "health", (*s).health)
    mc_encode.vals_i64(&v, "food", (*s).food as i64)
    mc_encode.vals_f32(&v, "foodSaturation", (*s).saturation)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_UPDATE_HEALTH, &v)
    rt.buf_free(&v)
    return ok
}
