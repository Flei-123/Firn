import mc.server.sv_state
import mc.server.ent.ent_table
import mc.server.inv.sv_inv

export { push_slot, push_cursor, push_mask, push_all }

fn push_slot(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32) {
    let f: fn(u64, u64, i32, i32, i32) = (*srv).ents.ops.inv_slot
    f(srv as u64, s as u64, k, sv_inv.slot_item(s, k), sv_inv.slot_count(s, k))
}

fn push_cursor(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    let f: fn(u64, u64, i32, i32) = (*srv).ents.ops.inv_cursor
    f(srv as u64, s as u64, (*s).cur, (*s).cur_n)
}

fn push_mask(srv: *mut sv_state.Server, s: *mut sv_state.Session, mask: u64) {
    var k: i32 = 0
    while k < sv_inv.SLOTS {
        if sv_inv.has(mask, k) { push_slot(srv, s, k) }
        k = k + 1
    }
}

fn push_all(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    var k: i32 = 0
    while k < sv_inv.SLOTS {
        push_slot(srv, s, k)
        k = k + 1
    }
    push_cursor(srv, s)
}
