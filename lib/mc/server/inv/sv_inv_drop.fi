import std.math
import mc.server.sv_state
import mc.server.ent.ent_table
import mc.server.ent.ent_item

export { throw_item }

const THROW_SPEED: f64 = 0.3
const THROW_DELAY: i32 = 40
const EYE_HEIGHT: f64 = 1.5
const DEG: f64 = 0.017453292519943295

fn throw_item(srv: *mut sv_state.Server, s: *mut sv_state.Session, item: i32, n: i32) {
    if item <= 0 || n <= 0 { return }
    let t: *mut ent_table.Table = &(*srv).ents
    let eid: i32 = (*srv).next_eid
    (*srv).next_eid = eid + 1
    let e: *mut ent_table.Entity = ent_item.item_spawn(t, eid, (*s).x, (*s).y + EYE_HEIGHT - 0.3, (*s).z, item, n)
    if e as u64 == 0 as u64 { return }
    let yr: f64 = ((*s).yaw as f64) * DEG
    let pr: f64 = ((*s).pitch as f64) * DEG
    (*e).vx = (0.0 - math.sin(yr)) * math.cos(pr) * THROW_SPEED
    (*e).vz = math.cos(yr) * math.cos(pr) * THROW_SPEED
    (*e).vy = (0.0 - math.sin(pr)) * THROW_SPEED + 0.1
    (*e).pickup_delay = THROW_DELAY
}
