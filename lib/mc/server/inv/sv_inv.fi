import mc.mc_registry
import mc.server.sv_state

export {
    SLOTS, HOTBAR_FIRST, HOTBAR_COUNT, MAIN_FIRST, MAIN_END, OFFHAND, ARMOR_FIRST, ARMOR_END, RESULT, CRAFT_FIRST, CRAFT_END, EMPTY, INT_MAX, SLOT_LIMIT,
    stack_max, slot_item, slot_count, slot_set, slot_clear, cursor_set, bit, has, add_item,
}

const SLOTS: i32 = 46
const MAIN_FIRST: i32 = 9
const MAIN_END: i32 = 36
const HOTBAR_FIRST: i32 = 36
const HOTBAR_COUNT: i32 = 9
const OFFHAND: i32 = 45
const ARMOR_FIRST: i32 = 5
const ARMOR_END: i32 = 9
const RESULT: i32 = 0
const CRAFT_FIRST: i32 = 1
const CRAFT_END: i32 = 5
const INT_MAX: i32 = 2147483647
const SLOT_LIMIT: i32 = 64
const EMPTY: i32 = 0
const DEFAULT_STACK: i32 = 64

fn bit(k: i32) -> u64 {
    return (1 as u64) << (k as u64)
}

fn has(mask: u64, k: i32) -> bool {
    return ((mask >> (k as u64)) & (1 as u64)) != (0 as u64)
}

fn stack_max(srv: *mut sv_state.Server, item: i32) -> i32 {
    let m: i32 = mc_registry.reg_item_stack(&(*srv).ents.reg, item)
    if m <= 0 { return DEFAULT_STACK }
    return m
}

fn slot_item(s: *mut sv_state.Session, k: i32) -> i32 {
    if (*s).inv_n[k as usize] <= 0 { return EMPTY }
    return (*s).inv[k as usize]
}

fn slot_count(s: *mut sv_state.Session, k: i32) -> i32 {
    if (*s).inv[k as usize] <= 0 { return 0 }
    return (*s).inv_n[k as usize]
}

fn slot_set(s: *mut sv_state.Session, k: i32, item: i32, n: i32) {
    if item <= 0 || n <= 0 {
        (*s).inv[k as usize] = EMPTY
        (*s).inv_n[k as usize] = 0
        return
    }
    (*s).inv[k as usize] = item
    (*s).inv_n[k as usize] = n
}

fn slot_clear(s: *mut sv_state.Session, k: i32) {
    slot_set(s, k, EMPTY, 0)
}

fn cursor_set(s: *mut sv_state.Session, item: i32, n: i32) {
    if item <= 0 || n <= 0 {
        (*s).cur = EMPTY
        (*s).cur_n = 0
        return
    }
    (*s).cur = item
    (*s).cur_n = n
}

fn has_space(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, item: i32) -> bool {
    let n: i32 = slot_count(s, k)
    return n > 0 && slot_item(s, k) == item && stack_max(srv, item) > 1 && n < stack_max(srv, item)
}

fn space_slot(srv: *mut sv_state.Server, s: *mut sv_state.Session, item: i32) -> i32 {
    if has_space(srv, s, HOTBAR_FIRST + (*s).held, item) { return HOTBAR_FIRST + (*s).held }
    if has_space(srv, s, OFFHAND, item) { return OFFHAND }
    var k: i32 = HOTBAR_FIRST
    while k < HOTBAR_FIRST + HOTBAR_COUNT {
        if has_space(srv, s, k, item) { return k }
        k = k + 1
    }
    k = MAIN_FIRST
    while k < MAIN_END {
        if has_space(srv, s, k, item) { return k }
        k = k + 1
    }
    return 0 - 1
}

fn free_slot(s: *mut sv_state.Session) -> i32 {
    var k: i32 = HOTBAR_FIRST
    while k < HOTBAR_FIRST + HOTBAR_COUNT {
        if slot_count(s, k) <= 0 { return k }
        k = k + 1
    }
    k = MAIN_FIRST
    while k < MAIN_END {
        if slot_count(s, k) <= 0 { return k }
        k = k + 1
    }
    return 0 - 1
}

fn add_item(srv: *mut sv_state.Server, s: *mut sv_state.Session, item: i32, n: i32, changed: *mut u64) -> i32 {
    var left: i32 = n
    let mx: i32 = stack_max(srv, item)
    while left > 0 {
        var k: i32 = space_slot(srv, s, item)
        if k < 0 { k = free_slot(s) }
        if k < 0 { break }
        let have: i32 = slot_count(s, k)
        var put: i32 = mx - have
        if put > left { put = left }
        if put <= 0 { break }
        slot_set(s, k, item, have + put)
        left = left - put
        *changed = *changed | bit(k)
    }
    return n - left
}
