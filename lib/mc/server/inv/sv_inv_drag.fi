import mc.server.sv_state
import mc.server.inv.sv_inv
import mc.server.inv.sv_inv_slot
import mc.server.inv.sv_inv_craft
import mc.server.inv.sv_inv_ops

export { drag_click, drag_reset, drag_active }

const TYPE_SPREAD: i32 = 0
const TYPE_ONE: i32 = 1
const TYPE_FILL: i32 = 2
const STAGE_START: i32 = 0
const STAGE_ADD: i32 = 1
const STAGE_END: i32 = 2
const CREATIVE: i32 = 1

fn drag_active(s: *mut sv_state.Session) -> bool {
    return (*s).drag_kind >= 0
}

fn drag_reset(s: *mut sv_state.Session) {
    (*s).drag_kind = 0 - 1
    (*s).drag_mask = 0 as u64
}

fn mask_size(s: *mut sv_state.Session) -> i32 {
    var n: i32 = 0
    var k: i32 = 0
    while k < sv_inv.SLOTS {
        if sv_inv.has((*s).drag_mask, k) { n = n + 1 }
        k = k + 1
    }
    return n
}

fn droppable(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, size_limit_ok: bool) -> bool {
    let item: i32 = (*s).cur
    return sv_inv_ops.can_quick_replace(srv, s, k, item) && sv_inv_slot.may_place(srv, k, item) && size_limit_ok
}

fn drag_add(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32) {
    if k < 0 || k >= sv_inv.SLOTS { return }
    let ok: bool = (*s).drag_kind == TYPE_FILL || (*s).cur_n > mask_size(s)
    if droppable(srv, s, k, ok) { (*s).drag_mask = (*s).drag_mask | sv_inv.bit(k) }
}

fn place_count(kind: i32, carried: i32, size: i32, imax: i32) -> i32 {
    if kind == TYPE_SPREAD { return carried / size }
    if kind == TYPE_ONE { return 1 }
    if kind == TYPE_FILL { return imax }
    return carried
}

fn drag_end(srv: *mut sv_state.Server, s: *mut sv_state.Session, pickup: fn(*mut sv_state.Server, *mut sv_state.Session, i32, bool)) {
    let size: i32 = mask_size(s)
    let kind: i32 = (*s).drag_kind
    if size == 0 { drag_reset(s); return }
    if size == 1 {
        var only: i32 = 0
        var k: i32 = 0
        while k < sv_inv.SLOTS {
            if sv_inv.has((*s).drag_mask, k) { only = k }
            k = k + 1
        }
        drag_reset(s)
        if kind == 0 { pickup(srv, s, only, true) }
        if kind == 1 { pickup(srv, s, only, false) }
        return
    }
    let item: i32 = (*s).cur
    let carried: i32 = (*s).cur_n
    if item <= 0 || carried <= 0 { drag_reset(s); return }
    let imax: i32 = sv_inv.stack_max(srv, item)
    var remaining: i32 = carried
    var k2: i32 = 0
    while k2 < sv_inv.SLOTS {
        if sv_inv.has((*s).drag_mask, k2) && droppable(srv, s, k2, kind == TYPE_FILL || carried >= size) {
            let have: i32 = sv_inv.slot_count(s, k2)
            var cap: i32 = sv_inv_slot.cap_of(srv, k2, item)
            if imax < cap { cap = imax }
            var put: i32 = place_count(kind, carried, size, imax) + have
            if put > cap { put = cap }
            remaining = remaining - (put - have)
            sv_inv_craft.put(srv, s, k2, item, put)
        }
        k2 = k2 + 1
    }
    sv_inv.cursor_set(s, item, remaining)
    drag_reset(s)
}

fn drag_click(srv: *mut sv_state.Server, s: *mut sv_state.Session, slot: i32, button: i32, pickup: fn(*mut sv_state.Server, *mut sv_state.Session, i32, bool)) {
    var prev: i32 = 0
    if drag_active(s) { prev = 1 }
    let stage: i32 = button & 3
    if (prev != 1 || stage != STAGE_END) && prev != stage {
        drag_reset(s)
    } else if (*s).cur_n <= 0 {
        drag_reset(s)
    } else if stage == STAGE_START {
        let kind: i32 = (button >> 2) & 3
        if kind == TYPE_SPREAD || kind == TYPE_ONE || (kind == TYPE_FILL && (*s).gamemode == CREATIVE) {
            (*s).drag_kind = kind
            (*s).drag_mask = 0 as u64
        } else {
            drag_reset(s)
        }
    } else if stage == STAGE_ADD {
        drag_add(srv, s, slot)
    } else if stage == STAGE_END {
        drag_end(srv, s, pickup)
    } else {
        drag_reset(s)
    }
}
