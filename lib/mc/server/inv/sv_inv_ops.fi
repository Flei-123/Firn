import mc.server.sv_state
import mc.server.inv.sv_inv
import mc.server.inv.sv_inv_slot
import mc.server.inv.sv_inv_craft
import mc.server.inv.sv_inv_drop

export { on_take, try_remove, safe_insert, safe_take, can_quick_replace }

fn on_take(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32) {
    if k != sv_inv.RESULT { return }
    var spill: i32 = 0
    var spill_n: i32 = 0
    sv_inv_craft.consume(srv, s, &spill, &spill_n)
    sv_inv_drop.throw_item(srv, s, spill, spill_n)
}

fn try_remove(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, amount: i32, max: i32, out_item: *mut i32) -> i32 {
    let si: i32 = sv_inv.slot_item(s, k)
    let sn: i32 = sv_inv.slot_count(s, k)
    if !sv_inv_slot.may_pickup(k) { return 0 }
    if !sv_inv_slot.allow_modification(srv, s, k) && max < sn { return 0 }
    var take: i32 = amount
    if max < take { take = max }
    if take > sn { take = sn }
    if k == sv_inv.RESULT { take = sn }
    if take <= 0 { return 0 }
    *out_item = si
    sv_inv_craft.put(srv, s, k, si, sn - take)
    return take
}

fn safe_take(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, amount: i32, max: i32, out_item: *mut i32) -> i32 {
    let n: i32 = try_remove(srv, s, k, amount, max, out_item)
    if n > 0 { on_take(srv, s, k) }
    return n
}

fn safe_insert(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, amount: i32) {
    let ci: i32 = (*s).cur
    let cn: i32 = (*s).cur_n
    if cn <= 0 || !sv_inv_slot.may_place(srv, k, ci) { return }
    let have: i32 = sv_inv.slot_count(s, k)
    var n: i32 = amount
    if cn < n { n = cn }
    let room: i32 = sv_inv_slot.cap_of(srv, k, ci) - have
    if room < n { n = room }
    if n < 0 { n = 0 }
    if have <= 0 {
        sv_inv_craft.put(srv, s, k, ci, n)
        sv_inv.cursor_set(s, ci, cn - n)
    } else if sv_inv.slot_item(s, k) == ci {
        sv_inv_craft.put(srv, s, k, ci, have + n)
        sv_inv.cursor_set(s, ci, cn - n)
    }
}

fn can_quick_replace(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, item: i32) -> bool {
    let have: i32 = sv_inv.slot_count(s, k)
    if have <= 0 { return true }
    if sv_inv.slot_item(s, k) == item { return have <= sv_inv.stack_max(srv, item) }
    return false
}
