import std.bytes
import mc.mc_sem
import mc.server.sv_state
import mc.server.sv_send
import mc.server.inv.sv_inv
import mc.server.inv.sv_inv_craft
import mc.server.inv.sv_inv_sync
import mc.server.inv.sv_inv_drop

export { close_handle, place_back }

fn place_back(srv: *mut sv_state.Server, s: *mut sv_state.Session, item: i32, n: i32) {
    if item <= 0 || n <= 0 { return }
    var changed: u64 = 0 as u64
    let added: i32 = sv_inv.add_item(srv, s, item, n, &changed)
    sv_inv_drop.throw_item(srv, s, item, n - added)
}

fn close_handle(srv: *mut sv_state.Server, s: *mut sv_state.Session, id: i32, body: *mut bytes.Bytes) -> bool {
    if !sv_send.sem_is(srv, id, mc_sem.SEM_PLAY_C2S_CLOSE_WINDOW) { return false }
    place_back(srv, s, (*s).cur, (*s).cur_n)
    sv_inv.cursor_set(s, 0, 0)
    var k: i32 = sv_inv.CRAFT_FIRST
    while k < sv_inv.CRAFT_END {
        let item: i32 = sv_inv.slot_item(s, k)
        let n: i32 = sv_inv.slot_count(s, k)
        sv_inv.slot_clear(s, k)
        place_back(srv, s, item, n)
        k = k + 1
    }
    sv_inv_craft.refresh(srv, s)
    sv_inv_sync.push_all(srv, s)
    return true
}
