import std.rt
import mc.mc_craft
import mc.mc_registry
import mc.server.sv_state
import mc.server.sv_ver
import mc.server.inv.sv_inv
import mc.server.inv.sv_inv_equip

export { refresh, consume, put, in_grid }

const GRID_WIDTH: i32 = 2
const GRID_CELLS: i32 = 4

fn in_grid(k: i32) -> bool {
    return k >= sv_inv.CRAFT_FIRST && k < sv_inv.CRAFT_END
}

fn refresh(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    let rf: fn() -> mc_craft.Recipes = (*sv_ver.adapter_of(srv)).recipes
    var rcp: mc_craft.Recipes = rf()
    if !mc_craft.craft_ok(&rcp) {
        sv_inv.slot_clear(s, sv_inv.RESULT)
        return
    }
    let g: u64 = rt.heap_alloc((GRID_CELLS * 4) as usize)
    var i: i32 = 0
    while i < GRID_CELLS {
        var cell: u32 = 0 as u32
        if sv_inv.slot_item(s, sv_inv.CRAFT_FIRST + i) > 0 { cell = (sv_inv.slot_item(s, sv_inv.CRAFT_FIRST + i) + 1) as u32 }
        rt.st32(g, i as usize, cell)
        i = i + 1
    }
    var cnt: i32 = 0
    let res: i32 = mc_craft.craft_match(&rcp, g, GRID_WIDTH, &cnt)
    rt.heap_free(g, (GRID_CELLS * 4) as usize)
    if res < 0 { sv_inv.slot_clear(s, sv_inv.RESULT) } else { sv_inv.slot_set(s, sv_inv.RESULT, res, cnt) }
}

fn put(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, item: i32, n: i32) {
    sv_inv.slot_set(s, k, item, n)
    if in_grid(k) { refresh(srv, s) }
}

fn remainder_of(srv: *mut sv_state.Server, item: i32) -> i32 {
    var reg: mc_registry.Registry = (*srv).ver.registry_of()
    var n: usize = 0
    let p: u64 = mc_registry.reg_item_name(&reg, item, &n)
    if p != 0 as u64 && sv_inv_equip.name_is(p, n, "honey_bottle") {
        return mc_registry.reg_item_by_name(&reg, "glass_bottle".p as u64, "glass_bottle".n)
    }
    return 0
}

fn consume(srv: *mut sv_state.Server, s: *mut sv_state.Session, spill: *mut i32, spill_n: *mut i32) {
    var rem: [i32; 4] = [0; 4]
    var i: i32 = 0
    while i < GRID_CELLS {
        let it: i32 = sv_inv.slot_item(s, sv_inv.CRAFT_FIRST + i)
        if it > 0 { rem[i as usize] = remainder_of(srv, it) }
        i = i + 1
    }
    i = 0
    while i < GRID_CELLS {
        let k: i32 = sv_inv.CRAFT_FIRST + i
        let it: i32 = sv_inv.slot_item(s, k)
        if it > 0 { sv_inv.slot_set(s, k, it, sv_inv.slot_count(s, k) - 1) }
        let r: i32 = rem[i as usize]
        if r > 0 {
            let cur: i32 = sv_inv.slot_item(s, k)
            if cur <= 0 {
                sv_inv.slot_set(s, k, r, 1)
            } else if cur == r {
                sv_inv.slot_set(s, k, r, sv_inv.slot_count(s, k) + 1)
            } else {
                var changed: u64 = 0 as u64
                let left: i32 = 1 - sv_inv.add_item(srv, s, r, 1, &changed)
                if left > 0 {
                    *spill = r
                    *spill_n = *spill_n + left
                }
            }
        }
        i = i + 1
    }
    refresh(srv, s)
}
