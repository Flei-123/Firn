import std.rt
import std.bytes
import mc.mc_sem
import mc.mc_version
import mc.server.sv_state
import mc.server.sv_send
import mc.server.inv.sv_inv
import mc.server.inv.sv_inv_sync
import mc.server.inv.sv_inv_slot
import mc.server.inv.sv_inv_craft
import mc.server.inv.sv_inv_ops
import mc.server.inv.sv_inv_move
import mc.server.inv.sv_inv_drag
import mc.server.inv.sv_inv_drop

export { click_handle, apply_click }

const MODE_PICKUP: i32 = 0
const MODE_QUICK_MOVE: i32 = 1
const MODE_SWAP: i32 = 2
const MODE_CLONE: i32 = 3
const MODE_THROW: i32 = 4
const MODE_DRAG: i32 = 5
const MODE_PICKUP_ALL: i32 = 6
const OUTSIDE: i32 = 0 - 999
const OFFHAND_KEY: i32 = 40
const CREATIVE: i32 = 1

fn pickup(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, primary: bool) {
    let si: i32 = sv_inv.slot_item(s, k)
    let sn: i32 = sv_inv.slot_count(s, k)
    let ci: i32 = (*s).cur
    let cn: i32 = (*s).cur_n
    if sn <= 0 {
        if cn > 0 {
            var amount: i32 = 1
            if primary { amount = cn }
            sv_inv_ops.safe_insert(srv, s, k, amount)
        }
        return
    }
    if !sv_inv_slot.may_pickup(k) { return }
    if cn <= 0 {
        var want: i32 = (sn + 1) / 2
        if primary { want = sn }
        var got: i32 = 0
        let taken: i32 = sv_inv_ops.try_remove(srv, s, k, want, sv_inv.INT_MAX, &got)
        if taken > 0 {
            sv_inv.cursor_set(s, got, taken)
            sv_inv_ops.on_take(srv, s, k)
        }
        return
    }
    if sv_inv_slot.may_place(srv, k, ci) {
        if si == ci {
            var amount2: i32 = 1
            if primary { amount2 = cn }
            sv_inv_ops.safe_insert(srv, s, k, amount2)
        } else if cn <= sv_inv_slot.cap_of(srv, k, ci) {
            sv_inv.cursor_set(s, si, sn)
            sv_inv_craft.put(srv, s, k, ci, cn)
        }
        return
    }
    if si == ci {
        var got2: i32 = 0
        let taken2: i32 = sv_inv_ops.try_remove(srv, s, k, sn, sv_inv.stack_max(srv, ci) - cn, &got2)
        if taken2 > 0 {
            sv_inv.cursor_set(s, ci, cn + taken2)
            sv_inv_ops.on_take(srv, s, k)
        }
    }
}

fn quick_move(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32) {
    if !sv_inv_slot.may_pickup(k) { return }
    var spill: i32 = 0
    var spill_n: i32 = 0
    var guard: i32 = 0
    while guard < 4096 {
        let before: i32 = sv_inv.slot_item(s, k)
        if !sv_inv_move.quick_move_once(srv, s, k, &spill, &spill_n) { break }
        if sv_inv.slot_item(s, k) != before || sv_inv.slot_count(s, k) <= 0 { break }
        guard = guard + 1
    }
    sv_inv_drop.throw_item(srv, s, spill, spill_n)
}

fn swap_target(button: i32) -> i32 {
    if button >= 0 && button < sv_inv.HOTBAR_COUNT { return sv_inv.HOTBAR_FIRST + button }
    if button == OFFHAND_KEY { return sv_inv.OFFHAND }
    return 0 - 1
}

fn swap_hotbar(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, button: i32) {
    let t: i32 = swap_target(button)
    if t < 0 { return }
    let ai: i32 = sv_inv.slot_item(s, t)
    let an: i32 = sv_inv.slot_count(s, t)
    let bi: i32 = sv_inv.slot_item(s, k)
    let bn: i32 = sv_inv.slot_count(s, k)
    if an <= 0 && bn <= 0 { return }
    if an <= 0 {
        if sv_inv_slot.may_pickup(k) {
            sv_inv.slot_set(s, t, bi, bn)
            sv_inv_craft.put(srv, s, k, 0, 0)
            sv_inv_ops.on_take(srv, s, k)
        }
    } else if bn <= 0 {
        if sv_inv_slot.may_place(srv, k, ai) {
            let lim: i32 = sv_inv_slot.cap_of(srv, k, ai)
            if an > lim {
                sv_inv_craft.put(srv, s, k, ai, lim)
                sv_inv.slot_set(s, t, ai, an - lim)
            } else {
                sv_inv.slot_set(s, t, 0, 0)
                sv_inv_craft.put(srv, s, k, ai, an)
            }
        }
    } else if sv_inv_slot.may_pickup(k) && sv_inv_slot.may_place(srv, k, ai) {
        let lim2: i32 = sv_inv_slot.cap_of(srv, k, ai)
        if an > lim2 {
            sv_inv_craft.put(srv, s, k, ai, lim2)
            sv_inv.slot_set(s, t, ai, an - lim2)
            sv_inv_ops.on_take(srv, s, k)
            var changed: u64 = 0 as u64
            let added: i32 = sv_inv.add_item(srv, s, bi, bn, &changed)
            sv_inv_drop.throw_item(srv, s, bi, bn - added)
        } else {
            sv_inv.slot_set(s, t, bi, bn)
            sv_inv_craft.put(srv, s, k, ai, an)
            sv_inv_ops.on_take(srv, s, k)
        }
    }
}

fn throw_slot(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, all: bool) {
    var amount: i32 = 1
    if all { amount = sv_inv.slot_count(s, k) }
    var got: i32 = 0
    let n: i32 = sv_inv_ops.safe_take(srv, s, k, amount, sv_inv.INT_MAX, &got)
    sv_inv_drop.throw_item(srv, s, got, n)
}

fn clone_slot(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32) {
    let item: i32 = sv_inv.slot_item(s, k)
    if item <= 0 { return }
    sv_inv.cursor_set(s, item, sv_inv.stack_max(srv, item))
}

fn pickup_all(srv: *mut sv_state.Server, s: *mut sv_state.Session, k: i32, backward: bool) {
    let item: i32 = (*s).cur
    if (*s).cur_n <= 0 { return }
    if sv_inv.slot_count(s, k) > 0 && sv_inv_slot.may_pickup(k) { return }
    let mx: i32 = sv_inv.stack_max(srv, item)
    var pass: i32 = 0
    while pass < 2 {
        var i: i32 = 0
        var step: i32 = 1
        if backward { i = sv_inv.SLOTS - 1; step = 0 - 1 }
        while i >= 0 && i < sv_inv.SLOTS && (*s).cur_n < mx {
            let n: i32 = sv_inv.slot_count(s, i)
            if n > 0 && sv_inv.slot_item(s, i) == item && n <= mx && sv_inv_slot.may_pickup(i) && i != sv_inv.RESULT {
                if pass != 0 || n != mx {
                    var got: i32 = 0
                    let taken: i32 = sv_inv_ops.safe_take(srv, s, i, n, mx - (*s).cur_n, &got)
                    sv_inv.cursor_set(s, item, (*s).cur_n + taken)
                }
            }
            i = i + step
        }
        pass = pass + 1
    }
}

fn click_outside(srv: *mut sv_state.Server, s: *mut sv_state.Session, primary: bool) {
    if (*s).cur_n <= 0 { return }
    let item: i32 = (*s).cur
    var out: i32 = (*s).cur_n
    if !primary { out = 1 }
    sv_inv.cursor_set(s, item, (*s).cur_n - out)
    sv_inv_drop.throw_item(srv, s, item, out)
}

fn apply_click(srv: *mut sv_state.Server, s: *mut sv_state.Session, slot: i32, button: i32, mode: i32) {
    let valid: bool = slot >= 0 && slot < sv_inv.SLOTS
    if !valid && slot != OUTSIDE && slot != 0 - 1 { return }
    if mode == MODE_DRAG {
        sv_inv_drag.drag_click(srv, s, slot, button, pickup)
    } else if sv_inv_drag.drag_active(s) {
        sv_inv_drag.drag_reset(s)
    } else if (mode == MODE_PICKUP || mode == MODE_QUICK_MOVE) && (button == 0 || button == 1) {
        if slot == OUTSIDE {
            click_outside(srv, s, button == 0)
        } else if valid && mode == MODE_QUICK_MOVE {
            quick_move(srv, s, slot)
        } else if valid {
            pickup(srv, s, slot, button == 0)
        }
    } else if mode == MODE_SWAP && valid {
        swap_hotbar(srv, s, slot, button)
    } else if mode == MODE_CLONE && valid && (*s).gamemode == CREATIVE && (*s).cur_n <= 0 {
        clone_slot(srv, s, slot)
    } else if mode == MODE_THROW && valid && (*s).cur_n <= 0 {
        throw_slot(srv, s, slot, button != 0)
    } else if mode == MODE_PICKUP_ALL && valid {
        pickup_all(srv, s, slot, button != 0)
    }
    sv_inv_sync.push_all(srv, s)
}

fn byte_at(v: *mut bytes.Bytes, i: usize) -> i32 {
    return rt.ld8((*v).data, i) as i32
}

fn click_handle(srv: *mut sv_state.Server, s: *mut sv_state.Session, id: i32, body: *mut bytes.Bytes) -> bool {
    if !sv_send.sem_is(srv, id, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK) { return false }
    var slot: i32 = 0
    var button: i32 = 0
    var mode: i32 = 0
    var v: bytes.Bytes = bytes.Bytes { data: 0 as u64, cap: 0, len: 0, pos: 0, bad: false }
    if !sv_send.field_view(srv, mc_version.ST_PLAY, id, "slot", body, &v) || v.len != 2 { return true }
    slot = (byte_at(&v, 0) << 8) | byte_at(&v, 1)
    if slot >= 32768 { slot = slot - 65536 }
    if !sv_send.field_view(srv, mc_version.ST_PLAY, id, "mouseButton", body, &v) || v.len != 1 { return true }
    button = byte_at(&v, 0)
    if button >= 128 { button = button - 256 }
    if !sv_send.field_varint(srv, mc_version.ST_PLAY, id, "mode", body, &mode) { return true }
    apply_click(srv, s, slot, button, mode)
    return true
}
