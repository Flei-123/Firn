import std.rt
import mc.mc_registry
import mc.server.sv_state

export { EQ_NONE, EQ_HEAD, EQ_CHEST, EQ_LEGS, EQ_FEET, EQ_OFFHAND, equip_slot, name_is }

const EQ_NONE: i32 = 0
const EQ_HEAD: i32 = 1
const EQ_CHEST: i32 = 2
const EQ_LEGS: i32 = 3
const EQ_FEET: i32 = 4
const EQ_OFFHAND: i32 = 5

fn tail_is(p: u64, n: usize, tail: str) -> bool {
    if n < tail.n { return false }
    let base: usize = n - tail.n
    var i: usize = 0
    while i < tail.n {
        if rt.ld8(p, base + i) != rt.ld8(tail.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

fn name_is(p: u64, n: usize, want: str) -> bool {
    return n == want.n && tail_is(p, n, want)
}

fn equip_slot(srv: *mut sv_state.Server, item: i32) -> i32 {
    if item <= 0 { return EQ_NONE }
    var reg: mc_registry.Registry = (*srv).ver.registry_of()
    var n: usize = 0
    let p: u64 = mc_registry.reg_item_name(&reg, item, &n)
    if p == 0 as u64 { return EQ_NONE }
    if tail_is(p, n, "_helmet") || tail_is(p, n, "_head") || tail_is(p, n, "_skull") || name_is(p, n, "carved_pumpkin") { return EQ_HEAD }
    if tail_is(p, n, "_chestplate") || name_is(p, n, "elytra") { return EQ_CHEST }
    if tail_is(p, n, "_leggings") { return EQ_LEGS }
    if tail_is(p, n, "_boots") { return EQ_FEET }
    if name_is(p, n, "shield") { return EQ_OFFHAND }
    return EQ_NONE
}
