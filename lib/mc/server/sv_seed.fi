import std.crypto.sha256
import mc.server.sv_state

export { hashed_seed, hashed_seed_of }

fn hashed_seed_of(seed: i64) -> i64 {
    var inp: [u8; 8] = [0 as u8; 8]
    var out: [u8; 32] = [0 as u8; 32]
    var i: usize = 0
    var v: u64 = seed as u64
    while i < 8 {
        inp[i] = (v & 255) as u8
        v = v >> 8
        i = i + 1
    }
    sha256.sha256((&inp[0]) as u64, 8, (&out[0]) as u64)
    var r: u64 = 0
    var k: usize = 0
    while k < 8 {
        r = r | ((out[k] as u64) << ((k * 8) as u64))
        k = k + 1
    }
    return r as i64
}

fn hashed_seed(srv: *mut sv_state.Server) -> i64 {
    return hashed_seed_of((*sv_state.srv_root(srv)).cfg.seed)
}
