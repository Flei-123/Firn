// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_text_nbt.fi -- a flat JSON text component ({"text":"..","color":".."}) -> nameless network NBT compound of strings (1.20.3+ chat and kick texts).

import std.rt
import std.bytes

export { text_json_to_nbt }

const TAG_END: u8 = 0 as u8
const TAG_STRING: u8 = 8 as u8
const TAG_COMPOUND: u8 = 10 as u8
const QUOTE: u8 = 34 as u8
const BACKSLASH: u8 = 92 as u8

fn put_string_tag(out: *mut bytes.Bytes, p: u64, n: usize) {
    bytes.put_u16(out, n as u16)
    bytes.put_raw(out, p, n)
}

fn unescape(src: u64, n: usize, dst: *mut rt.Buf) {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(src, i)
        if c == BACKSLASH && i + 1 < n {
            i = i + 1
            rt.buf_push(dst, rt.ld8(src, i))
        } else {
            rt.buf_push(dst, c)
        }
        i = i + 1
    }
}

fn string_end(p: u64, n: usize, from: usize) -> usize {
    var i: usize = from
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == BACKSLASH {
            i = i + 2
        } else if c == QUOTE {
            return i
        } else {
            i = i + 1
        }
    }
    return n
}

fn text_json_to_nbt(p: u64, n: usize, out: *mut bytes.Bytes) {
    bytes.put_u8(out, TAG_COMPOUND)
    var i: usize = 0
    var have_key: bool = false
    var key: rt.Buf = rt.buf_new()
    var val: rt.Buf = rt.buf_new()
    var expect_key: bool = true
    while i < n {
        if rt.ld8(p, i) == QUOTE {
            let end: usize = string_end(p, n, i + 1)
            if expect_key {
                rt.buf_clear(&key)
                unescape(p + (i + 1) as u64, end - i - 1, &key)
                have_key = true
                expect_key = false
            } else if have_key {
                rt.buf_clear(&val)
                unescape(p + (i + 1) as u64, end - i - 1, &val)
                bytes.put_u8(out, TAG_STRING)
                put_string_tag(out, rt.buf_ptr(&key), rt.buf_len(&key))
                put_string_tag(out, rt.buf_ptr(&val), rt.buf_len(&val))
                have_key = false
            }
            i = end + 1
        } else {
            if rt.ld8(p, i) == 44 as u8 { expect_key = true }
            i = i + 1
        }
    }
    bytes.put_u8(out, TAG_END)
    rt.buf_free(&key)
    rt.buf_free(&val)
}
