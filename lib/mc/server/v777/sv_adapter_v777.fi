// lib/mc/server/v777/sv_adapter_v777.fi -- the protocol 777 (26.3) server adapter.

import mc.server.sv_ver
import mc.server.v777.sv_cfg_v777
import mc.server.v777.sv_fx_v777
import mc.server.v777.sv_join_v777
import mc.server.v777.sv_tail_v777

export { adapter }

const GLOBAL_BITS: u32 = 16

fn adapter() -> sv_ver.ServerVersion {
    var a: sv_ver.ServerVersion = sv_ver.adapter_none()
    a.protocol = 777
    a.biome_default = sv_cfg_v777.BIOME_PLAINS
    a.rel_x = sv_fx_v777.REL_X
    a.rel_y = sv_fx_v777.REL_Y
    a.rel_z = sv_fx_v777.REL_Z
    a.rel_rot = sv_fx_v777.REL_ROT
    a.join = sv_join_v777.join_send
    a.send_position_to = sv_fx_v777.send_position_to
    a.send_position_relative = sv_fx_v777.send_position_relative
    a.send_game_mode = sv_fx_v777.send_game_mode
    a.global_bits = GLOBAL_BITS
    a.text_nbt = true
    a.declare_commands = false
    a.config_enter = sv_join_v777.config_send
    a.send_time = sv_fx_v777.send_time
    a.chunk_tail = sv_tail_v777.tail_build
    return a
}
