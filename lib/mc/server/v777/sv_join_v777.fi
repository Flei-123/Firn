// lib/mc/server/v777/sv_join_v777.fi -- the configuration phase and the join sequence of protocol 777 (26.3).

import std.rt
import std.bytes
import std.hashfile
import mc.mc_codec
import mc.mc_encode
import mc.mc_sem
import mc.mc_version
import mc.server.sv_state
import mc.server.sv_send
import mc.server.v763.sv_fx_v763
import mc.server.v777.sv_cfg_v777
import mc.server.v777.sv_fx_v777

export { join_send, config_send }

const SEA_LEVEL_FLAT: i64 = 0 - 63

fn send_cfg_packet(s: *mut sv_state.Session, i: usize) -> bool {
    let hex: str = sv_cfg_v777.cfg_hex(i)
    let n: usize = hex.n / 2
    let p: u64 = rt.heap_alloc(n)
    var ok: bool = hashfile.hex_decode(hex, p, n) == n as i64
    if ok {
        var body: bytes.Bytes = bytes.Bytes { data: p, cap: n, len: n, pos: 0, bad: false }
        let sent: usize = mc_codec.wire_send_packet(&(*s).wire, sv_cfg_v777.cfg_id(i), &body) catch 0
        ok = sent > 0
    }
    rt.heap_free(p, n)
    return ok
}

fn config_send(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var i: usize = 0
    while i < sv_cfg_v777.CFG_COUNT {
        if !send_cfg_packet(s, i) { return false }
        i = i + 1
    }
    return sv_send.send_raw(srv, s, mc_version.ST_CONFIG, mc_sem.SEM_CONFIG_S2C_FINISH, 0, 0)
}

fn send_login(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "entityId", (*s).eid as i64)
    mc_encode.vals_bool(&v, "isHardcore", false)
    mc_encode.vals_raw(&v, "worldNames", "#1")
    sv_send.vals_str(&v, "worldNames[0]", "minecraft:overworld")
    mc_encode.vals_i64(&v, "maxPlayers", (*srv).cfg.max_players as i64)
    mc_encode.vals_i64(&v, "viewDistance", (*s).view as i64)
    mc_encode.vals_i64(&v, "simulationDistance", (*s).view as i64)
    mc_encode.vals_bool(&v, "reducedDebugInfo", false)
    mc_encode.vals_bool(&v, "enableRespawnScreen", true)
    mc_encode.vals_bool(&v, "doLimitedCrafting", false)
    mc_encode.vals_i64(&v, "worldState.dimension", sv_cfg_v777.DIM_OVERWORLD as i64)
    sv_send.vals_str(&v, "worldState.name", "minecraft:overworld")
    mc_encode.vals_i64(&v, "worldState.hashedSeed", 0)
    mc_encode.vals_i64(&v, "worldState.gamemode", (*srv).cfg.game_mode as i64)
    mc_encode.vals_i64(&v, "worldState.previousGamemode", 0)
    mc_encode.vals_bool(&v, "worldState.isDebug", false)
    mc_encode.vals_bool(&v, "worldState.isFlat", true)
    mc_encode.vals_i64(&v, "worldState.portalCooldown", 0)
    mc_encode.vals_i64(&v, "worldState.seaLevel", SEA_LEVEL_FLAT)
    mc_encode.vals_bool(&v, "onlineMode", false)
    mc_encode.vals_bool(&v, "enforcesSecureChat", false)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_JOIN_GAME, &v)
    rt.buf_free(&v)
    return ok
}

fn join_send(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    return send_login(srv, s) && sv_fx_v763.send_abilities(srv, s) && sv_fx_v777.send_spawn(srv, s) && sv_fx_v777.send_time(srv, s)
    && sv_fx_v777.send_position(srv, s) && sv_fx_v777.send_level_chunks_load_start(srv, s)
}
