// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/v777/sv_tail_v777.fi -- the map_chunk fields of protocol 777 (26.3): heightmap map, sections without data length, byte array light masks.

import std.rt
import std.bytes
import mc.mc_encode
import mc.server.sv_state
import mc.server.sv_world
import mc.server.sv_chunk_enc

export { tail_build }

const HM_WORLD_SURFACE: i64 = 1
const HM_MOTION_BLOCKING: i64 = 4

fn push_line(b: *mut rt.Buf, head: str, a: i64, mid: str, c: i64, tail: str, v: i64) {
    rt.buf_push_bytes(b, head.p as u64, head.n)
    rt.buf_push_dec_i64(b, a)
    rt.buf_push_bytes(b, mid.p as u64, mid.n)
    if c >= 0 { rt.buf_push_dec_i64(b, c) }
    rt.buf_push_bytes(b, tail.p as u64, tail.n)
    rt.buf_push_dec_i64(b, v)
    rt.buf_push(b, 10 as u8)
}

fn emit_heightmap(e: *mut sv_chunk_enc.ChunkEnc, vals: *mut rt.Buf, k: i64, ty: i64, nsec: usize) {
    let longs: usize = sv_chunk_enc.chunk_enc_height_longs(nsec)
    push_line(vals, "heightmaps[", k, "].type", 0 - 1, "=", ty)
    push_line(vals, "heightmaps[", k, "].data", 0 - 1, "=#", longs as i64)
    var l: usize = 0
    while l < longs {
        push_line(vals, "heightmaps[", k, "].data[", l as i64, "]=", sv_chunk_enc.chunk_enc_height_long(e, nsec, l) as i64)
        l = l + 1
    }
}

fn tail_build(srv: *mut sv_state.Server, col: *mut sv_world.Column) {
    let nsec: usize = sv_world.world_sections(&(*srv).world)
    sv_chunk_enc.chunk_enc_height_prepare(&(*srv).enc, (*col).blocks, nsec)
    var data: bytes.Bytes = bytes.bytes_new()
    sv_chunk_enc.chunk_enc_data(&(*srv).enc, col, nsec, &data)
    rt.buf_clear(&(*srv).tail)
    mc_encode.vals_raw(&(*srv).tail, "heightmaps", "#2")
    emit_heightmap(&(*srv).enc, &(*srv).tail, 0, HM_WORLD_SURFACE, nsec)
    emit_heightmap(&(*srv).enc, &(*srv).tail, 1, HM_MOTION_BLOCKING, nsec)
    mc_encode.vals_hex(&(*srv).tail, "chunkData", bytes.bytes_ptr(&data), bytes.bytes_len(&data))
    sv_chunk_enc.chunk_enc_block_entities(col, &(*srv).tail)
    sv_chunk_enc.chunk_enc_light(&(*srv).enc, col, nsec, &(*srv).tail, true)
    bytes.bytes_free(&data)
}
