// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/v777/sv_fx_v777.fi -- player facing packets of protocol 777 (26.3): position with delta movement, game mode, world clock time.

import std.rt
import mc.mc_encode
import mc.mc_sem
import mc.mc_version
import mc.server.sv_state
import mc.server.sv_send
import mc.server.v763.sv_fx_v763

export { send_position, send_position_to, send_position_relative, send_game_mode, send_time, send_spawn, send_level_chunks_load_start, REL_X, REL_Y, REL_Z, REL_ROT }

const REL_X: i64 = 1
const REL_Y: i64 = 2
const REL_Z: i64 = 4
const REL_ROT: i64 = 24
const GAME_STATE_CHANGE_MODE: i64 = 3
const GAME_STATE_LEVEL_CHUNKS_LOAD_START: i64 = 13
const CLOCKS: i64 = 2

fn send_time(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "age", (*srv).game_time)
    mc_encode.vals_raw(&v, "clockUpdates", "#2")
    var i: i64 = 0
    while i < CLOCKS {
        var idx: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&idx, "clockUpdates[".p as u64, 13)
        rt.buf_push_dec_i64(&idx, i)
        rt.buf_push(&idx, 93 as u8)
        let base: str = rt.buf_str(&idx)
        var path: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&path, base.p as u64, base.n)
        rt.buf_push_bytes(&path, ".id".p as u64, 3)
        mc_encode.vals_i64(&v, rt.buf_str(&path), i)
        rt.buf_clear(&path)
        rt.buf_push_bytes(&path, base.p as u64, base.n)
        rt.buf_push_bytes(&path, ".totalTicks".p as u64, 11)
        mc_encode.vals_i64(&v, rt.buf_str(&path), (*srv).day_time)
        rt.buf_clear(&path)
        rt.buf_push_bytes(&path, base.p as u64, base.n)
        rt.buf_push_bytes(&path, ".partialTick".p as u64, 12)
        mc_encode.vals_f32(&v, rt.buf_str(&path), 0.0f)
        rt.buf_clear(&path)
        rt.buf_push_bytes(&path, base.p as u64, base.n)
        rt.buf_push_bytes(&path, ".rate".p as u64, 5)
        mc_encode.vals_f32(&v, rt.buf_str(&path), 1.0f)
        rt.buf_free(&path)
        rt.buf_free(&idx)
        i = i + 1
    }
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_UPDATE_TIME, &v)
    rt.buf_free(&v)
    return ok
}

fn send_position_to(srv: *mut sv_state.Server, s: *mut sv_state.Session, px: f64, py: f64, pz: f64, yaw: f32, pitch: f32, flags: i64) -> bool {
    let id: i32 = (*s).tp_next
    (*s).tp_next = id + 1
    (*s).tp_pending = id
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "teleportId", id as i64)
    mc_encode.vals_f64(&v, "x", px)
    mc_encode.vals_f64(&v, "y", py)
    mc_encode.vals_f64(&v, "z", pz)
    mc_encode.vals_f64(&v, "dx", 0.0)
    mc_encode.vals_f64(&v, "dy", 0.0)
    mc_encode.vals_f64(&v, "dz", 0.0)
    mc_encode.vals_f32(&v, "yaw", yaw)
    mc_encode.vals_f32(&v, "pitch", pitch)
    mc_encode.vals_bool(&v, "flags.x", (flags & REL_X) != 0)
    mc_encode.vals_bool(&v, "flags.y", (flags & REL_Y) != 0)
    mc_encode.vals_bool(&v, "flags.z", (flags & REL_Z) != 0)
    mc_encode.vals_bool(&v, "flags.yaw", (flags & 8) != 0)
    mc_encode.vals_bool(&v, "flags.pitch", (flags & 16) != 0)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_POSITION, &v)
    rt.buf_free(&v)
    return ok
}

fn send_position(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    return send_position_to(srv, s, (*s).x, (*s).y, (*s).z, (*s).yaw, (*s).pitch, 0)
}

fn send_position_relative(srv: *mut sv_state.Server, s: *mut sv_state.Session, px: f64, py: f64, pz: f64, flags: i64) -> bool {
    return send_position_to(srv, s, px, py, pz, 0.0f, 0.0f, flags)
}

fn send_spawn(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    sv_send.vals_str(&v, "globalPos.dimensionName", "minecraft:overworld")
    mc_encode.vals_i64(&v, "globalPos.location.x", (*srv).world.spawn_x as i64)
    mc_encode.vals_i64(&v, "globalPos.location.y", (*srv).world.spawn_y as i64)
    mc_encode.vals_i64(&v, "globalPos.location.z", (*srv).world.spawn_z as i64)
    mc_encode.vals_f32(&v, "yaw", 0.0f)
    mc_encode.vals_f32(&v, "pitch", 0.0f)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_SPAWN_POSITION, &v)
    rt.buf_free(&v)
    return ok
}

fn send_level_chunks_load_start(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "reason", GAME_STATE_LEVEL_CHUNKS_LOAD_START)
    mc_encode.vals_f32(&v, "gameMode", 0.0f)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_GAME_STATE_CHANGE, &v)
    rt.buf_free(&v)
    return ok
}

fn send_game_mode(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "reason", GAME_STATE_CHANGE_MODE)
    mc_encode.vals_f32(&v, "gameMode", (*s).gamemode as f32)
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_GAME_STATE_CHANGE, &v)
    rt.buf_free(&v)
    return ok && sv_fx_v763.send_abilities(srv, s)
}
