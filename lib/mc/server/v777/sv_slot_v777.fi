// lib/mc/server/v777/sv_slot_v777.fi -- item stacks of protocol 777 (count first, item id, data component counts) as value store entries and parsed from client slots.

import std.rt
import std.bytes
import mc.mc_encode

export { put_slot, read_slot }

fn put_int(v: *mut rt.Buf, prefix: str, name: str, val: i64) {
    var k: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&k, prefix.p as u64, prefix.n)
    rt.buf_push_bytes(&k, name.p as u64, name.n)
    mc_encode.vals_i64(v, rt.buf_str(&k), val)
    rt.buf_free(&k)
}

fn put_slot(v: *mut rt.Buf, prefix: str, item: i32, count: i32) {
    if item <= 0 || count <= 0 {
        put_int(v, prefix, ".itemCount", 0)
        return
    }
    put_int(v, prefix, ".itemCount", count as i64)
    put_int(v, prefix, ".itemId", item as i64)
    put_int(v, prefix, ".addedComponentCount", 0)
    put_int(v, prefix, ".removedComponentCount", 0)
}

fn read_slot(b: *mut bytes.Bytes, item: *mut i32, count: *mut i32) {
    *item = 0
    *count = 0
    let c: i32 = bytes.get_varint(b) catch 0
    if c <= 0 { return }
    let id: i32 = bytes.get_varint(b) catch 0
    if id <= 0 { return }
    *item = id
    *count = c
}
