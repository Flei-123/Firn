// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/v777/sv_lpvec3_v777.fi -- the low precision vector (lpVec3) of protocol 777 as a value store entry.

import std.rt
import std.math
import mc.mc_encode

export { vals_lpvec3 }

const MAX_COMPONENT: f64 = 17179869183.0
const MIN_MAGNITUDE: f64 = 0.00003051944088384301
const PACK_RANGE: f64 = 32766.0

fn sanitize(v: f64) -> f64 {
    if v != v { return 0.0 }
    if v > MAX_COMPONENT { return MAX_COMPONENT }
    if v < 0.0 - MAX_COMPONENT { return 0.0 - MAX_COMPONENT }
    return v
}

fn pack(v: f64) -> u64 {
    return math.floor((v * 0.5 + 0.5) * PACK_RANGE + 0.5) as u64
}

fn max_abs(x: f64, y: f64, z: f64) -> f64 {
    var m: f64 = math.fabs(x)
    if math.fabs(y) > m { m = math.fabs(y) }
    if math.fabs(z) > m { m = math.fabs(z) }
    return m
}

fn push_byte(b: *mut rt.Buf, v: u64) {
    rt.buf_push(b, (v & 255 as u64) as u8)
}

fn push_varint(b: *mut rt.Buf, v: u64) {
    var r: u64 = v
    while r >= 128 as u64 {
        push_byte(b, (r & 127 as u64) | 128 as u64)
        r = r >> 7 as u64
    }
    push_byte(b, r)
}

fn encode(raw: *mut rt.Buf, x: f64, y: f64, z: f64) {
    let sx: f64 = sanitize(x)
    let sy: f64 = sanitize(y)
    let sz: f64 = sanitize(z)
    let m: f64 = max_abs(sx, sy, sz)
    if m < MIN_MAGNITUDE {
        push_byte(raw, 0 as u64)
        return
    }
    var scale: u64 = math.ceil(m) as u64
    if scale < 1 as u64 { scale = 1 as u64 }
    let sf: f64 = scale as f64
    let cont: bool = (scale & 3 as u64) != scale
    var low: u64 = scale
    if cont { low = (scale & 3 as u64) | 4 as u64 }
    let xn: u64 = pack(sx / sf) << 3 as u64
    let yn: u64 = pack(sy / sf) << 18 as u64
    let zn: u64 = pack(sz / sf) << 33 as u64
    let q: u64 = low | xn | yn | zn
    push_byte(raw, q)
    push_byte(raw, q >> 8 as u64)
    push_byte(raw, q >> 40 as u64)
    push_byte(raw, q >> 32 as u64)
    push_byte(raw, q >> 24 as u64)
    push_byte(raw, q >> 16 as u64)
    if cont { push_varint(raw, scale >> 2 as u64) }
}

fn vals_lpvec3(v: *mut rt.Buf, path: str, x: f64, y: f64, z: f64) {
    var raw: rt.Buf = rt.buf_new()
    encode(&raw, x, y, z)
    let s: str = rt.buf_str(&raw)
    mc_encode.vals_hex(v, path, s.p as u64, s.n)
    rt.buf_free(&raw)
}
