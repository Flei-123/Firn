export { DIM_OVERWORLD, DIM_NETHER, DIM_END, dim_kind_of_level_type, dim_name, dim_type_index_v777, dim_min_y, dim_height, dim_gen_name }

const DIM_OVERWORLD: i32 = 0
const DIM_NETHER: i32 = 1
const DIM_END: i32 = 2

fn dim_kind_of_level_type(level_type: str) -> i32 {
    if level_type == "nether" || level_type == "minecraft:nether" || level_type == "the_nether" || level_type == "minecraft:the_nether" { return DIM_NETHER }
    if level_type == "end" || level_type == "minecraft:end" || level_type == "the_end" || level_type == "minecraft:the_end" { return DIM_END }
    return DIM_OVERWORLD
}

fn dim_name(kind: i32) -> str {
    if kind == DIM_NETHER { return "minecraft:the_nether" }
    if kind == DIM_END { return "minecraft:the_end" }
    return "minecraft:overworld"
}

fn dim_gen_name(kind: i32) -> str {
    if kind == DIM_NETHER { return "nether" }
    if kind == DIM_END { return "end" }
    return "overworld"
}

fn dim_type_index_v777(kind: i32) -> i32 {
    if kind == DIM_NETHER { return 3 }
    if kind == DIM_END { return 2 }
    return 0
}

fn dim_min_y(kind: i32) -> i32 {
    if kind == DIM_OVERWORLD { return 0 - 64 }
    return 0
}

fn dim_height(kind: i32) -> i32 {
    if kind == DIM_OVERWORLD { return 384 }
    return 256
}
