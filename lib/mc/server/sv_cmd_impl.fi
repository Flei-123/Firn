// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_cmd_impl.fi -- the time and say command handlers and their registry keyed by tree path.

import std.rt
import brigadier.bmem as m
import brigadier.text as tx
import brigadier.exc as ex
import brigadier.argtype as at
import mc.server.sv_state
import mc.server.sv_send
import mc.server.sv_play
import mc.server.sv_cmd_state
import mc.server.sv_cmd_util as cu
import mc.server.sv_cmd_player

export { handlers_register }

const DAY_TICKS: i64 = 24000
const TIME_DAY: i64 = 1000
const TIME_NOON: i64 = 6000
const TIME_NIGHT: i64 = 13000
const TIME_MIDNIGHT: i64 = 18000

fn day_time_of(srv: *mut sv_state.Server) -> i64 {
    return ((*srv).day_time % DAY_TICKS + DAY_TICKS) % DAY_TICKS
}

fn reply_time(c: *mut sv_cmd_state.Cmds, head: str, v: i64) {
    var b: rt.Buf = rt.buf_new()
    sv_send.push_str(&b, head)
    rt.buf_push_dec_i64(&b, v)
    cu.reply_buf(c, &b)
    rt.buf_free(&b)
}

fn time_changed(c: *mut sv_cmd_state.Cmds, shown: i64) -> i32 {
    sv_play.play_time_all((*c).srv)
    reply_time(c, "Set the time to ", shown)
    return day_time_of((*c).srv) as i32
}

fn h_time_set_value(cu: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = cu as *mut sv_cmd_state.Cmds
    let t: i64 = (*cu.arg_of(c, ctx, "time")).i
    (*(*c).srv).day_time = t
    return time_changed(c, t)
}

fn h_time_set_day(cu: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = cu as *mut sv_cmd_state.Cmds
    (*(*c).srv).day_time = TIME_DAY
    return time_changed(c, TIME_DAY)
}

fn h_time_set_noon(cu: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = cu as *mut sv_cmd_state.Cmds
    (*(*c).srv).day_time = TIME_NOON
    return time_changed(c, TIME_NOON)
}

fn h_time_set_night(cu: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = cu as *mut sv_cmd_state.Cmds
    (*(*c).srv).day_time = TIME_NIGHT
    return time_changed(c, TIME_NIGHT)
}

fn h_time_set_midnight(cu: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = cu as *mut sv_cmd_state.Cmds
    (*(*c).srv).day_time = TIME_MIDNIGHT
    return time_changed(c, TIME_MIDNIGHT)
}

fn h_time_add(cu: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = cu as *mut sv_cmd_state.Cmds
    (*(*c).srv).day_time = (*(*c).srv).day_time + (*cu.arg_of(c, ctx, "time")).i
    return time_changed(c, day_time_of((*c).srv))
}

fn query_time(c: *mut sv_cmd_state.Cmds, v: i64) -> i32 {
    reply_time(c, "The time is ", v)
    return v as i32
}

fn h_time_query_day(cu: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = cu as *mut sv_cmd_state.Cmds
    return query_time(c, ((*(*c).srv).day_time / DAY_TICKS) % 2147483647)
}

fn h_time_query_daytime(cu: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = cu as *mut sv_cmd_state.Cmds
    return query_time(c, day_time_of((*c).srv))
}

fn h_time_query_gametime(cu: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = cu as *mut sv_cmd_state.Cmds
    return query_time(c, (*(*c).srv).game_time % 2147483647)
}

fn h_say(cu: u64, ctx: u64, err: *mut ex.Exc) -> i32 {
    let c: *mut sv_cmd_state.Cmds = cu as *mut sv_cmd_state.Cmds
    let v: *mut at.Value = cu.arg_of(c, ctx, "message")
    let text: str = tx.u16_to_str(&(*c).work, (*v).s)
    var b: rt.Buf = rt.buf_new()
    rt.buf_push(&b, 91 as u8)
    cu.push_name(&b, (*c).cur)
    sv_send.push_str(&b, "] ")
    sv_send.push_str(&b, text)
    sv_play.play_broadcast_chat((*c).srv, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    return 1
}

fn handlers_register(c: *mut sv_cmd_state.Cmds) {
    sv_cmd_player.handlers_register(c)
    cu.add(c, "time set time", h_time_set_value)
    cu.add(c, "time set day", h_time_set_day)
    cu.add(c, "time set noon", h_time_set_noon)
    cu.add(c, "time set night", h_time_set_night)
    cu.add(c, "time set midnight", h_time_set_midnight)
    cu.add(c, "time add time", h_time_add)
    cu.add(c, "time query day", h_time_query_day)
    cu.add(c, "time query daytime", h_time_query_daytime)
    cu.add(c, "time query gametime", h_time_query_gametime)
    cu.add(c, "say message", h_say)
}
