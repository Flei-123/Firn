// lib/mc/server/sv_world.fi -- the world source interface of the integrated server.
// A source fills one chunk column of global block state ids: index ((y - min_y) * 16 + z) * 16 + x.

import std.rt

export { WorldSource, world_sections, world_column_bytes, world_fill }

struct WorldSource {
    ctx: u64,
    fill: fn(u64, i32, i32, u64) -> bool,
    min_y: i32,
    height: i32,
    spawn_x: i32,
    spawn_y: i32,
    spawn_z: i32,
    biome: i32,
    uniform: bool,
}

fn world_sections(w: *mut WorldSource) -> usize {
    return ((*w).height / 16) as usize
}

fn world_column_bytes(w: *mut WorldSource) -> usize {
    return ((*w).height as usize) * 256 * 2
}

fn world_fill(w: *mut WorldSource, cx: i32, cz: i32, blocks: u64) -> bool {
    return (*w).fill((*w).ctx, cx, cz, blocks)
}
