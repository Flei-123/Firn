import std.rt
import std.bytes
import mc.server.sv_state

export { gen_state_save_player, gen_state_load_player, gen_state_save_clock, gen_state_load_clock }

const CLOCK_FILE: str = "firn_clock.bin"
const PLAYER_SIZE: usize = 424
const CLOCK_SIZE: usize = 16
const SLOTS: usize = 46
const MAGIC: i32 = 1179796562
const HEX: str = "0123456789abcdef"

fn push_hex(b: *mut rt.Buf, v: u64) {
    var i: usize = 16
    while i > 0 {
        i = i - 1
        rt.buf_push(b, rt.ld8(HEX.p as u64, ((v >> ((i * 4) as u64)) & 15 as u64) as usize))
    }
}

fn base_path(srv: *mut sv_state.Server, out: *mut rt.Buf) {
    rt.buf_push_bytes(out, (*srv).world_dir.ptr, (*srv).world_dir.len)
    rt.buf_push(out, 47 as u8)
}

fn player_path(srv: *mut sv_state.Server, s: *mut sv_state.Session, out: *mut rt.Buf) {
    base_path(srv, out)
    rt.buf_push_bytes(out, "firn_player_".p as u64, 12)
    push_hex(out, (*s).uuid_hi)
    push_hex(out, (*s).uuid_lo)
    rt.buf_push_bytes(out, ".bin".p as u64, 4)
    rt.buf_push(out, 0 as u8)
}

fn clock_path(srv: *mut sv_state.Server, out: *mut rt.Buf) {
    base_path(srv, out)
    rt.buf_push_bytes(out, CLOCK_FILE.p as u64, CLOCK_FILE.n)
    rt.buf_push(out, 0 as u8)
}

fn gen_state_save_player(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_i32(&b, MAGIC)
    bytes.put_i32(&b, (*s).gamemode)
    bytes.put_f64(&b, (*s).x)
    bytes.put_f64(&b, (*s).y)
    bytes.put_f64(&b, (*s).z)
    bytes.put_f32(&b, (*s).yaw)
    bytes.put_f32(&b, (*s).pitch)
    bytes.put_i32(&b, (*s).held)
    bytes.put_f32(&b, (*s).health)
    bytes.put_i32(&b, (*s).food)
    bytes.put_f32(&b, (*s).saturation)
    var i: usize = 0
    while i < SLOTS {
        bytes.put_i32(&b, (*s).inv[i])
        i = i + 1
    }
    i = 0
    while i < SLOTS {
        bytes.put_i32(&b, (*s).inv_n[i])
        i = i + 1
    }
    var path: rt.Buf = rt.buf_new()
    player_path(srv, s, &path)
    let ok: bool = rt.write_file(rt.buf_ptr(&path), bytes.bytes_ptr(&b), bytes.bytes_len(&b))
    rt.buf_free(&path)
    bytes.bytes_free(&b)
    return ok
}

fn gen_state_load_player(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> bool {
    var path: rt.Buf = rt.buf_new()
    player_path(srv, s, &path)
    var raw: rt.Buf = rt.buf_new()
    var ok: bool = rt.read_file(rt.buf_ptr(&path), &raw)
    rt.buf_free(&path)
    if ok && rt.buf_len(&raw) != PLAYER_SIZE { ok = false }
    if ok {
        var b: bytes.Bytes = bytes.Bytes { data: rt.buf_ptr(&raw), cap: PLAYER_SIZE, len: PLAYER_SIZE, pos: 0, bad: false }
        let magic: i32 = bytes.get_i32(&b) catch 0
        if magic != MAGIC { ok = false }
        if ok {
            (*s).gamemode = bytes.get_i32(&b) catch 1
            (*s).x = bytes.get_f64(&b) catch 0.0
            (*s).y = bytes.get_f64(&b) catch 0.0
            (*s).z = bytes.get_f64(&b) catch 0.0
            (*s).yaw = bytes.get_f32(&b) catch 0.0f
            (*s).pitch = bytes.get_f32(&b) catch 0.0f
            (*s).held = bytes.get_i32(&b) catch 0
            (*s).health = bytes.get_f32(&b) catch 20.0f
            (*s).food = bytes.get_i32(&b) catch 20
            (*s).saturation = bytes.get_f32(&b) catch 5.0f
            var i: usize = 0
            while i < SLOTS {
                (*s).inv[i] = bytes.get_i32(&b) catch 0
                i = i + 1
            }
            i = 0
            while i < SLOTS {
                (*s).inv_n[i] = bytes.get_i32(&b) catch 0
                i = i + 1
            }
        }
    }
    rt.buf_free(&raw)
    return ok
}

fn gen_state_save_clock(srv: *mut sv_state.Server) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_i64(&b, (*srv).game_time)
    bytes.put_i64(&b, (*srv).day_time)
    var path: rt.Buf = rt.buf_new()
    clock_path(srv, &path)
    let ok: bool = rt.write_file(rt.buf_ptr(&path), bytes.bytes_ptr(&b), bytes.bytes_len(&b))
    rt.buf_free(&path)
    bytes.bytes_free(&b)
    return ok
}

fn gen_state_load_clock(srv: *mut sv_state.Server) -> bool {
    var path: rt.Buf = rt.buf_new()
    clock_path(srv, &path)
    var raw: rt.Buf = rt.buf_new()
    var ok: bool = rt.read_file(rt.buf_ptr(&path), &raw)
    rt.buf_free(&path)
    if ok && rt.buf_len(&raw) != CLOCK_SIZE { ok = false }
    if ok {
        var b: bytes.Bytes = bytes.Bytes { data: rt.buf_ptr(&raw), cap: CLOCK_SIZE, len: CLOCK_SIZE, pos: 0, bad: false }
        (*srv).game_time = bytes.get_i64(&b) catch 0
        (*srv).day_time = bytes.get_i64(&b) catch 0
    }
    rt.buf_free(&raw)
    return ok
}
