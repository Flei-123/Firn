// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_persist_level.fi -- writes the world clock into level.dat (Data.Time, Data.DayTime).

import std.rt
import std.bytes
import std.deflate
import mc.mc_nbt
import mc.save.save_world
import mc.server.sv_state

export { persist_level }

fn set_long(doc: *mut mc_nbt.Doc, data: u32, name: str, v: i64) {
    let n: u32 = mc_nbt.nbt_get(doc, data, name.p as u64, name.n)
    if n != 0 as u32 { mc_nbt.nbt_set_i64(doc, n, v) }
}

fn rewrite(path: u64, game_time: i64, day_time: i64) -> bool {
    var raw: rt.Buf = rt.buf_new()
    let got: usize = save_world.read_nbt_file(path, &raw) catch 99999999999
    if got == 99999999999 {
        rt.buf_free(&raw)
        return false
    }
    var doc: mc_nbt.Doc = mc_nbt.doc_new()
    var v: bytes.Bytes = bytes.Bytes { data: raw.ptr, cap: got, len: got, pos: 0, bad: false }
    var good: bool = mc_nbt.doc_parse(&doc, &v, false, false) catch false
    if good {
        let data: u32 = mc_nbt.nbt_get(&doc, mc_nbt.doc_root(&doc), "Data".p as u64, 4)
        good = data != 0 as u32
        if good {
            set_long(&doc, data, "Time", game_time)
            set_long(&doc, data, "DayTime", day_time)
            var out: bytes.Bytes = bytes.bytes_new()
            mc_nbt.doc_write(&doc, &out)
            var gz: rt.Buf = rt.buf_new()
            let m: usize = deflate.gzip_compress(bytes.bytes_ptr(&out), bytes.bytes_len(&out), 6, &gz) catch 99999999999
            good = m != 99999999999 && rt.write_file(path, gz.ptr, gz.len)
            rt.buf_free(&gz)
            bytes.bytes_free(&out)
        }
    }
    mc_nbt.doc_free(&doc)
    rt.buf_free(&raw)
    return good
}

fn persist_level(srv: *mut sv_state.Server) -> bool {
    var path: rt.Buf = rt.buf_new()
    save_world.path_c(&path, str { p: (*srv).world_dir.ptr as *mut u8, n: (*srv).world_dir.len }, "level.dat")
    let ok: bool = rewrite(path.ptr, (*srv).game_time, (*srv).day_time)
    rt.buf_free(&path)
    return ok
}
