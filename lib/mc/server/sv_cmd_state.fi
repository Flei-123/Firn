// lib/mc/server/sv_cmd_state.fi -- state of the server command system: tree, dispatcher hooks, handler table.

import std.rt
import brigadier.bmem as m
import brigadier.exc as ex
import brigadier.dispatcher as dp
import mc.cmd.cmd_tree as ct
import mc.server.sv_state

export { Cmds, Handler, cmds_size }

struct Handler {
    path: str,
    run: fn(u64, u64, *mut ex.Exc) -> i32,
}

struct Cmds {
    srv: *mut sv_state.Server,
    cur: *mut sv_state.Session,
    a: m.BumpArena,
    work: m.BumpArena,
    tree: ct.CmdTree,
    hooks: dp.Hooks,
    json: str,
    parsers: str,
    levels: str,
    handlers: m.Arr[Handler],
}

fn cmds_size() -> usize {
    return size_gen[Cmds]()
}

fn size_gen[T]() -> usize {
    return size_of[T]()
}
