// SPDX-License-Identifier: MPL-2.0
// lib/mc/server/sv_chunks.fi -- chunk streaming: per player window of sent columns, nearest first, rate limited.

import std.rt
import mc.mc_encode
import mc.mc_sem
import mc.mc_version
import mc.server.sv_state
import mc.server.sv_send
import mc.server.sv_edits
import mc.server.sv_world
import mc.server.sv_ver
import mc.server.sv_be

export { chunks_init, chunks_stream, chunks_send_center, chunks_sent_count, chunk_of }

const COORD_LIMIT: f64 = 30000000.0

fn chunk_of(v: f64) -> i32 {
    var c: f64 = v
    if c > COORD_LIMIT { c = COORD_LIMIT }
    if c < 0.0 - COORD_LIMIT { c = 0.0 - COORD_LIMIT }
    var f: i32 = c as i32
    if (f as f64) > c { f = f - 1 }
    return (f - (((f % 16) + 16) % 16)) / 16
}

fn key_of(cx: i32, cz: i32) -> u64 {
    return (((cx + 1073741824) as u64) << 32 as u64) | ((cz + 1073741824) as u64)
}

fn key_cx(k: u64) -> i32 { return ((k >> 32 as u64) as i32) - 1073741824 }

fn key_cz(k: u64) -> i32 { return ((k & 4294967295 as u64) as i32) - 1073741824 }

fn wrap(v: i32, w: i32) -> usize {
    var m: i32 = v % w
    if m < 0 { m = m + w }
    return m as usize
}

fn slot_of(s: *mut sv_state.Session, cx: i32, cz: i32) -> usize {
    return wrap(cx, (*s).chunks_w) * ((*s).chunks_w as usize) + wrap(cz, (*s).chunks_w)
}

fn chunks_init(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    let w: i32 = (*srv).cfg.view * 2 + 3
    (*s).chunks_w = w
    let n: usize = (w * w) as usize
    (*s).chunks = rt.heap_alloc(n * 8)
    rt.mem_set((*s).chunks, 0 as u8, n * 8)
    (*s).sent_chunks = 0
}

fn chunks_sent_count(s: *mut sv_state.Session) -> u64 { return (*s).sent_chunks }

fn chunks_send_center(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "chunkX", (*s).cx as i64)
    mc_encode.vals_i64(&v, "chunkZ", (*s).cz as i64)
    sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_UPDATE_VIEW_POSITION, &v)
    rt.buf_free(&v)
}

fn build_tail(srv: *mut sv_state.Server, col: *mut sv_world.Column) {
    let build: fn(*mut sv_state.Server, *mut sv_world.Column) = (*sv_ver.adapter_of(srv)).chunk_tail
    build(srv, col)
}

fn send_column(srv: *mut sv_state.Server, s: *mut sv_state.Session, cx: i32, cz: i32) -> bool {
    if !(*srv).world.uniform || !(*srv).tail_ready || sv_edits.edits_total(&(*srv).edits) > 0 {
        if !sv_world.world_fill(&(*srv).world, cx, cz, &(*srv).column) { return false }
        sv_edits.edits_apply_column(&(*srv).edits, cx, cz, (*srv).world.min_y, (*srv).world.height, (*srv).column.blocks)
        sv_be.be_drop_edited(&(*srv).column, &(*srv).edits)
        build_tail(srv, &(*srv).column)
        (*srv).tail_ready = true
    }
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "x", cx as i64)
    mc_encode.vals_i64(&v, "z", cz as i64)
    rt.buf_push_bytes(&v, rt.buf_ptr(&(*srv).tail), rt.buf_len(&(*srv).tail))
    let ok: bool = sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_MAP_CHUNK, &v)
    rt.buf_free(&v)
    return ok
}

fn send_unload(srv: *mut sv_state.Server, s: *mut sv_state.Session, cx: i32, cz: i32) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "chunkX", cx as i64)
    mc_encode.vals_i64(&v, "chunkZ", cz as i64)
    sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_UNLOAD_CHUNK, &v)
    rt.buf_free(&v)
}

fn in_window(s: *mut sv_state.Session, cx: i32, cz: i32) -> bool {
    var dx: i32 = cx - (*s).cx
    var dz: i32 = cz - (*s).cz
    if dx < 0 { dx = 0 - dx }
    if dz < 0 { dz = 0 - dz }
    return dx <= (*s).view && dz <= (*s).view
}

fn unload_outside(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    let n: usize = ((*s).chunks_w * (*s).chunks_w) as usize
    var i: usize = 0
    while i < n {
        let k: u64 = rt.ld64((*s).chunks, i)
        if k != 0 as u64 && !in_window(s, key_cx(k), key_cz(k)) {
            send_unload(srv, s, key_cx(k), key_cz(k))
            rt.st64((*s).chunks, i, 0 as u64)
        }
        i = i + 1
    }
}

fn send_batch_start(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    var v: rt.Buf = rt.buf_new()
    sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_CHUNK_BATCH_START, &v)
    rt.buf_free(&v)
}

fn send_batch_finished(srv: *mut sv_state.Server, s: *mut sv_state.Session, count: u64) {
    var v: rt.Buf = rt.buf_new()
    mc_encode.vals_i64(&v, "batchSize", count as i64)
    sv_send.send_vals(srv, s, mc_version.ST_PLAY, mc_sem.SEM_PLAY_S2C_CHUNK_BATCH_FINISHED, &v)
    rt.buf_free(&v)
}

fn chunks_stream(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    if !(*s).joined || (*s).chunks == 0 { return }
    unload_outside(srv, s)
    let batches: bool = mc_version.version_has(&(*srv).ver, mc_version.FLAG_CHUNK_BATCHES)
    let sent_before: u64 = (*s).sent_chunks
    var batch_open: bool = false
    var budget: i32 = (*srv).cfg.chunks_per_tick
    var d: i32 = 0
    while d <= (*s).view && budget > 0 {
        var dx: i32 = 0 - d
        while dx <= d && budget > 0 {
            var dz: i32 = 0 - d
            while dz <= d && budget > 0 {
                var ax: i32 = dx
                var az: i32 = dz
                if ax < 0 { ax = 0 - ax }
                if az < 0 { az = 0 - az }
                if ax == d || az == d {
                    let cx: i32 = (*s).cx + dx
                    let cz: i32 = (*s).cz + dz
                    let slot: usize = slot_of(s, cx, cz)
                    if rt.ld64((*s).chunks, slot) != key_of(cx, cz) {
                        if batches && !batch_open {
                            send_batch_start(srv, s)
                            batch_open = true
                        }
                        if send_column(srv, s, cx, cz) {
                            rt.st64((*s).chunks, slot, key_of(cx, cz))
                            (*s).sent_chunks = (*s).sent_chunks + 1
                        }
                        budget = budget - 1
                    }
                }
                dz = dz + 1
            }
            dx = dx + 1
        }
        d = d + 1
    }
    if batch_open { send_batch_finished(srv, s, (*s).sent_chunks - sent_before) }
}
