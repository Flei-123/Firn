import std.rt
import std.fs
import mc.mc_version
import mc.server.sv_state
import mc.server.sv_flat
import mc.server.rs.rs_core
import mc.server.sv_core
import mc.server.sv_dim
import mc.server.sv_gen
import mc.server.sv_save
import mc.server.sv_world
import mc.server.sv_ver
import mc.server.sv_rs_host
import mc.server.sv_gen_world

export { dimsrv_get, dimsrv_peek, dimsrv_for_session }

fn subdir(kind: i32) -> str {
    if kind == sv_dim.DIM_NETHER { return "DIM-1" }
    if kind == sv_dim.DIM_END { return "DIM1" }
    return "DIM0"
}

fn dimsrv_peek(root: *mut sv_state.Server, kind: i32) -> *mut sv_state.Server {
    return (*root).dims[kind as usize] as *mut sv_state.Server
}

fn dimsrv_for_session(srv: *mut sv_state.Server, s: *mut sv_state.Session) -> *mut sv_state.Server {
    return dimsrv_peek(sv_state.srv_root(srv), (*s).dim)
}

fn gen_name_of(root: *mut sv_state.Server, kind: i32) -> str {
    if kind == sv_dim.DIM_OVERWORLD {
        let configured: str = sv_gen.gen_dim_of_level_type((*root).cfg.level_type)
        if configured == "amplified" || configured == "large_biomes" { return configured }
    }
    return sv_dim.dim_gen_name(kind)
}

fn open_source(root: *mut sv_state.Server, kind: i32, dir: str, out: *mut sv_world.WorldSource) -> bool {
    var ver: mc_version.Version = (*root).ver
    let ad: *mut sv_ver.ServerVersion = sv_ver.adapter_of(root)
    if (*root).world_dir.len == 0 || (*root).gen_world {
        if (*root).cfg.gen_dir.n == 0 { return false }
        let src: sv_world.WorldSource = sv_gen.gen_source_new(&ver, (*ad).biome_default, (*root).cfg.gen_dir, gen_name_of(root, kind), (*root).cfg.seed,
            (*root).cfg.gen_surface, (*root).cfg.gen_carvers, (*root).cfg.gen_features)
        if src.ctx == 0 as u64 { return false }
        *out = src
        return true
    }
    return sv_save.save_source_open_dim(&ver, dir, (*ad).biome_default, (*ad).be_table, kind, out)
}

fn dimsrv_get(root: *mut sv_state.Server, kind: i32) -> *mut sv_state.Server {
    let have: *mut sv_state.Server = dimsrv_peek(root, kind)
    if have as u64 != 0 as u64 { return have }
    var dir: rt.Buf = rt.buf_new()
    if (*root).world_dir.len > 0 {
        rt.buf_push_bytes(&dir, (*root).world_dir.ptr, (*root).world_dir.len)
        rt.buf_push(&dir, 47 as u8)
        let sub: str = subdir(kind)
        rt.buf_push_bytes(&dir, sub.p as u64, sub.n)
        fs.mkdir_all(str { p: dir.ptr as *mut u8, n: dir.len }) catch false
    }
    var ver: mc_version.Version = (*root).ver
    var src: sv_world.WorldSource = sv_flat.flat_source_new(&ver, (*sv_ver.adapter_of(root)).biome_default)
    var opened: sv_world.WorldSource = src
    if !open_source(root, kind, str { p: dir.ptr as *mut u8, n: dir.len }, &opened) {
        sv_world.world_free(&src)
        rt.buf_free(&dir)
        return 0 as *mut sv_state.Server
    }
    sv_world.world_free(&src)
    src = opened
    let d: *mut sv_state.Server = sv_core.server_new_dim(root, kind, src)
    let ad: *mut sv_ver.ServerVersion = sv_ver.adapter_of(root)
    (*d).ents.ops = (*ad).entity_ops
    (*d).ents.loot = (*ad).entity_loot
    sv_rs_host.rs_install(d)
    let bind: fn(*mut rs_core.Rs) = (*ad).rs_bind
    bind(&(*d).rs)
    (*d).gen_world = (*root).gen_world
    if dir.len > 0 {
        rt.buf_push_bytes(&(*d).world_dir, dir.ptr, dir.len)
        if (*d).gen_world { sv_gen_world.gen_world_load(d) }
    }
    rt.buf_free(&dir)
    return d
}
