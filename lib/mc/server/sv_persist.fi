// lib/mc/server/sv_persist.fi -- persistence of the server: autosave and save on stop (edited chunks, players, world clock).

import mc.server.sv_state
import mc.server.sv_edits
import mc.server.sv_persist_chunks
import mc.server.sv_persist_level
import mc.server.sv_persist_player

export { persist_save_all, persist_save_player }

fn persist_save_player(srv: *mut sv_state.Server, s: *mut sv_state.Session) {
    if (*srv).world_dir.len == 0 { return }
    sv_persist_player.persist_player(srv, s)
}

fn persist_save_all(srv: *mut sv_state.Server) {
    if (*srv).world_dir.len == 0 { return }
    sv_persist_chunks.persist_chunks(srv)
    var i: usize = 0
    while i < sv_state.MAX_SESSIONS {
        let s: *mut sv_state.Session = sv_state.session_at(srv, i)
        if (*s).used && (*s).joined { sv_persist_player.persist_player(srv, s) }
        i = i + 1
    }
    sv_persist_level.persist_level(srv)
    (*srv).saves_done = (*srv).saves_done + 1
    sv_edits.edits_clear_dirty(&(*srv).edits)
}
