// lib/mc/server/sv_persist.fi -- persistence entry point of the server: autosave and save on stop.

import mc.server.sv_state
import mc.server.sv_edits

export { persist_save_all }

fn persist_save_all(srv: *mut sv_state.Server) {
    if (*srv).world_dir.len == 0 { return }
    (*srv).saves_done = (*srv).saves_done + 1
    sv_edits.edits_clear_dirty(&(*srv).edits)
}
