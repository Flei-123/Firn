import std.rt
import mc.server.sv_dim

export { exec_in_parse }

const PREFIX: str = "execute in "
const RUN: str = " run "
const NS: str = "minecraft:"

fn token_end(p: u64, n: usize, from: usize) -> usize {
    var i: usize = from
    while i < n && rt.ld8(p, i) != 32 { i = i + 1 }
    return i
}

fn kind_of_token(p: u64, n: usize) -> i32 {
    var at: usize = 0
    if n >= NS.n && rt.mem_eq(p, NS.p as u64, NS.n) { at = NS.n }
    let len: usize = n - at
    var k: i32 = 0
    while k < 3 {
        let full: str = sv_dim.dim_name(k)
        let bare: str = str { p: (full.p as u64 + NS.n as u64) as *mut u8, n: full.n - NS.n }
        if bare.n == len && rt.mem_eq(p + at as u64, bare.p as u64, len) { return k }
        k = k + 1
    }
    return 0 - 1
}

fn exec_in_parse(p: u64, n: usize, kind: *mut i32, off: *mut usize) -> bool {
    var start: usize = 0
    if n > 0 && rt.ld8(p, 0) == 47 { start = 1 }
    if n < start + PREFIX.n || !rt.mem_eq(p + start as u64, PREFIX.p as u64, PREFIX.n) { return false }
    let tok: usize = start + PREFIX.n
    let end: usize = token_end(p, n, tok)
    if end >= n || end - tok == 0 { return false }
    if n < end + RUN.n || !rt.mem_eq(p + end as u64, RUN.p as u64, RUN.n) { return false }
    let k: i32 = kind_of_token(p + tok as u64, end - tok)
    if k < 0 { return false }
    *kind = k
    *off = end + RUN.n
    return true
}
