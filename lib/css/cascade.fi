// lib/css/cascade.fi -- CASCADE, INHERITANCE and the COMPUTED STYLE per node.
//
// This is the step that turns a parsed stylesheet plus a DOM into what
// layout needs: one set of computed properties per element. Three things
// happen here, and all three are the ones engines get wrong first:
//
//  1. THE CASCADE ORDER (css-cascade-4 6.4.1). Sorted by, in this order:
//       origin and importance -- user agent < user < author
//                                < author !important < user !important
//                                < user agent !important
//       specificity of the selector that matched
//       order of appearance
//     The reversal of the origins for `!important` is the point that makes
//     a user stylesheet usable at all; it is implemented here and checked
//     in tests/916.
//  2. INHERITANCE. `color` and `font-size` are inherited, the box
//     properties are not. `inherit` and `initial` work on every property.
//  3. COMPUTED VALUES. `em` refers to the font size OF THE ELEMENT,
//     percentages of `font-size` to the one of the PARENT. So the font
//     size has to be computed first -- everything else builds on it.
//
// THE SET OF PROPERTIES is deliberately small and honest: display, color,
// font-size, the four margins, the four paddings and the border in width,
// style and colour. Rather few properties right than many half done. What
// is missing is named in docs/ROUND60.md.
import html.mem
import browser.node
import browser.names
import css.tok
import css.cv
import css.sel

export {
    Rule, Decl, Style,
    P_DISPLAY, P_COLOR, P_FONT_SIZE,
    P_MARGIN_TOP, P_MARGIN_RIGHT, P_MARGIN_BOTTOM, P_MARGIN_LEFT,
    P_PADDING_TOP, P_PADDING_RIGHT, P_PADDING_BOTTOM, P_PADDING_LEFT,
    P_BORDER_TOP_WIDTH, P_BORDER_RIGHT_WIDTH, P_BORDER_BOTTOM_WIDTH,
    P_BORDER_LEFT_WIDTH,
    P_WIDTH, P_HEIGHT, P_MIN_WIDTH, P_MAX_WIDTH, P_MIN_HEIGHT, P_MAX_HEIGHT,
    P_TOP, P_RIGHT, P_BOTTOM, P_LEFT, P_LINE_HEIGHT, P_FLEX_BASIS,
    P_BORDER_TOP_STYLE, P_BORDER_RIGHT_STYLE, P_BORDER_BOTTOM_STYLE,
    P_BORDER_LEFT_STYLE,
    P_BORDER_TOP_COLOR, P_BORDER_RIGHT_COLOR, P_BORDER_BOTTOM_COLOR,
    P_BORDER_LEFT_COLOR,
    P_POSITION, P_FLOAT, P_CLEAR, P_BOX_SIZING, P_OVERFLOW,
    P_TEXT_ALIGN, P_VERTICAL_ALIGN, P_WHITE_SPACE,
    P_FLEX_DIRECTION, P_FLEX_WRAP, P_FLEX_GROW, P_FLEX_SHRINK,
    P_Z_INDEX, P_ORDER, P_JUSTIFY_CONTENT, P_ALIGN_ITEMS, P_ALIGN_SELF,
    P_ALIGN_CONTENT,
    P_COUNT, LENGTH_SLOTS,
    S_MARGIN_TOP, S_MARGIN_RIGHT, S_MARGIN_BOTTOM, S_MARGIN_LEFT,
    S_PADDING_TOP, S_PADDING_RIGHT, S_PADDING_BOTTOM, S_PADDING_LEFT,
    S_BORDER_TOP, S_BORDER_RIGHT, S_BORDER_BOTTOM, S_BORDER_LEFT,
    S_WIDTH, S_HEIGHT, S_MIN_WIDTH, S_MAX_WIDTH, S_MIN_HEIGHT, S_MAX_HEIGHT,
    S_TOP, S_RIGHT, S_BOTTOM, S_LEFT, S_LINE_HEIGHT, S_FLEX_BASIS,
    U_PX, U_PERCENT, U_AUTO, U_NONE, U_NORMAL, U_NUMBER,
    U_MIN_CONTENT, U_MAX_CONTENT, U_FIT_CONTENT, U_STRETCH,
    D_INLINE, D_BLOCK, D_INLINE_BLOCK, D_NONE, D_LIST_ITEM, D_FLEX,
    D_INLINE_FLEX, D_GRID, D_TABLE, D_TABLE_ROW, D_TABLE_CELL, D_INLINE_TABLE,
    BS_NONE, BS_HIDDEN, BS_DOTTED, BS_DASHED, BS_SOLID, BS_DOUBLE,
    BS_GROOVE, BS_RIDGE, BS_INSET, BS_OUTSET,
    POS_STATIC, POS_RELATIVE, POS_ABSOLUTE, POS_FIXED, POS_STICKY,
    FLOAT_NONE, FLOAT_LEFT, FLOAT_RIGHT,
    CLEAR_NONE, CLEAR_LEFT, CLEAR_RIGHT, CLEAR_BOTH,
    BOX_CONTENT, BOX_BORDER,
    OV_VISIBLE, OV_HIDDEN, OV_SCROLL, OV_AUTO,
    TA_LEFT, TA_RIGHT, TA_CENTER, TA_JUSTIFY,
    VA_BASELINE, VA_TOP, VA_BOTTOM, VA_MIDDLE, VA_TEXT_TOP, VA_TEXT_BOTTOM,
    WS_NORMAL, WS_PRE, WS_NOWRAP, WS_PRE_WRAP, WS_PRE_LINE,
    FD_ROW, FD_ROW_REVERSE, FD_COLUMN, FD_COLUMN_REVERSE,
    FW_NOWRAP, FW_WRAP, FW_WRAP_REVERSE,
    AL_AUTO, AL_FLEX_START, AL_FLEX_END, AL_CENTER, AL_SPACE_BETWEEN,
    AL_START, AL_END,
    AL_SPACE_AROUND, AL_SPACE_EVENLY, AL_STRETCH, AL_BASELINE,
    Z_AUTO_YES, Z_AUTO_NO,
    ORIGIN_UA, ORIGIN_USER, ORIGIN_AUTHOR,
    DECL_IMPORTANT,
    collect_rules, rules_count, parse_inline_declarations,
    cascade_elem_inline,
    style_new, style_initial, style_root, style_anonymous,
    Winner, winner_new, cascade_elem,
    style_length, style_unit, style_color, style_border_style,
    style_display, style_font_size,
    style_position, style_float, style_clear, style_box_sizing,
    style_overflow, style_text_align, style_vertical_align,
    style_white_space, style_flex_direction, style_flex_wrap,
    style_flex_grow, style_flex_shrink,
    style_z_index, style_z_auto, style_order,
    style_justify_content, style_align_items, style_align_self,
    style_align_content,
}

// ------------------------------------------------------------- Properties

// THE PROPERTY IDS. The order is not free: the 24 ids from `P_MARGIN_TOP`
// to `P_FLEX_BASIS` are exactly the 24 LENGTH SLOTS of `Style.length`, and
// the whole computation of lengths is one loop over that range. Anything
// inserted in between moves the slots -- so new lengths go at the END of
// the block, new keywords behind `P_BORDER_LEFT_COLOR`.
const P_DISPLAY: u32 = 0
const P_COLOR: u32 = 1
const P_FONT_SIZE: u32 = 2
// ---- the lengths, slot = id - P_MARGIN_TOP
const P_MARGIN_TOP: u32 = 3
const P_MARGIN_RIGHT: u32 = 4
const P_MARGIN_BOTTOM: u32 = 5
const P_MARGIN_LEFT: u32 = 6
const P_PADDING_TOP: u32 = 7
const P_PADDING_RIGHT: u32 = 8
const P_PADDING_BOTTOM: u32 = 9
const P_PADDING_LEFT: u32 = 10
const P_BORDER_TOP_WIDTH: u32 = 11
const P_BORDER_RIGHT_WIDTH: u32 = 12
const P_BORDER_BOTTOM_WIDTH: u32 = 13
const P_BORDER_LEFT_WIDTH: u32 = 14
const P_WIDTH: u32 = 15
const P_HEIGHT: u32 = 16
const P_MIN_WIDTH: u32 = 17
const P_MAX_WIDTH: u32 = 18
const P_MIN_HEIGHT: u32 = 19
const P_MAX_HEIGHT: u32 = 20
const P_TOP: u32 = 21
const P_RIGHT: u32 = 22
const P_BOTTOM: u32 = 23
const P_LEFT: u32 = 24
const P_LINE_HEIGHT: u32 = 25
const P_FLEX_BASIS: u32 = 26
// ---- everything that is not a length
const P_BORDER_TOP_STYLE: u32 = 27
const P_BORDER_RIGHT_STYLE: u32 = 28
const P_BORDER_BOTTOM_STYLE: u32 = 29
const P_BORDER_LEFT_STYLE: u32 = 30
const P_BORDER_TOP_COLOR: u32 = 31
const P_BORDER_RIGHT_COLOR: u32 = 32
const P_BORDER_BOTTOM_COLOR: u32 = 33
const P_BORDER_LEFT_COLOR: u32 = 34
const P_POSITION: u32 = 35
const P_FLOAT: u32 = 36
const P_CLEAR: u32 = 37
const P_BOX_SIZING: u32 = 38
const P_OVERFLOW: u32 = 39
const P_TEXT_ALIGN: u32 = 40
const P_VERTICAL_ALIGN: u32 = 41
const P_WHITE_SPACE: u32 = 42
const P_FLEX_DIRECTION: u32 = 43
const P_FLEX_WRAP: u32 = 44
const P_FLEX_GROW: u32 = 45
const P_FLEX_SHRINK: u32 = 46
// ---- round 67: stacking, and the rest of css-flexbox-1
const P_Z_INDEX: u32 = 47
const P_ORDER: u32 = 48
const P_JUSTIFY_CONTENT: u32 = 49
const P_ALIGN_ITEMS: u32 = 50
const P_ALIGN_SELF: u32 = 51
const P_ALIGN_CONTENT: u32 = 52
const P_COUNT: u32 = 53
const P_NONE: u32 = 99

// The slots of `Style.length` / `Style.unit`, spelled out so that no
// caller has to compute `P_x - P_MARGIN_TOP`.
const LENGTH_SLOTS: usize = 24
const S_MARGIN_TOP: usize = 0
const S_MARGIN_RIGHT: usize = 1
const S_MARGIN_BOTTOM: usize = 2
const S_MARGIN_LEFT: usize = 3
const S_PADDING_TOP: usize = 4
const S_PADDING_RIGHT: usize = 5
const S_PADDING_BOTTOM: usize = 6
const S_PADDING_LEFT: usize = 7
const S_BORDER_TOP: usize = 8
const S_BORDER_RIGHT: usize = 9
const S_BORDER_BOTTOM: usize = 10
const S_BORDER_LEFT: usize = 11
const S_WIDTH: usize = 12
const S_HEIGHT: usize = 13
const S_MIN_WIDTH: usize = 14
const S_MAX_WIDTH: usize = 15
const S_MIN_HEIGHT: usize = 16
const S_MAX_HEIGHT: usize = 17
const S_TOP: usize = 18
const S_RIGHT: usize = 19
const S_BOTTOM: usize = 20
const S_LEFT: usize = 21
const S_LINE_HEIGHT: usize = 22
const S_FLEX_BASIS: usize = 23

// The units of a computed length.
const U_PX: u32 = 0
const U_PERCENT: u32 = 1
const U_AUTO: u32 = 2
const U_NONE: u32 = 3 // `max-width: none`
const U_NORMAL: u32 = 4 // `line-height: normal`
const U_NUMBER: u32 = 5 // `line-height: 1.5` -- a factor, not a length
// THE KEYWORD SIZES of css-sizing-3 and -4. They are units and not
// lengths because none of them is a number until the layout asks the
// content: `min-content` and `max-content` are the two intrinsic widths,
// `fit-content` is the shrink-to-fit of CSS 2.1 10.3.5, and `stretch`
// (the standardised name of `-webkit-fill-available`) fills what the
// containing block leaves over -- which is what `auto` does for a block
// box but NOT for a float, an inline-block or a flex item.
const U_MIN_CONTENT: u32 = 6
const U_MAX_CONTENT: u32 = 7
const U_FIT_CONTENT: u32 = 8
const U_STRETCH: u32 = 9

// display
const D_INLINE: u32 = 0
const D_BLOCK: u32 = 1
const D_INLINE_BLOCK: u32 = 2
const D_NONE: u32 = 3
const D_LIST_ITEM: u32 = 4
const D_FLEX: u32 = 5
const D_INLINE_FLEX: u32 = 6
const D_GRID: u32 = 7
const D_TABLE: u32 = 8
const D_TABLE_ROW: u32 = 9
const D_TABLE_CELL: u32 = 10
const D_INLINE_TABLE: u32 = 11

// border-style
const BS_NONE: u32 = 0
const BS_HIDDEN: u32 = 1
const BS_DOTTED: u32 = 2
const BS_DASHED: u32 = 3
const BS_SOLID: u32 = 4
const BS_DOUBLE: u32 = 5
const BS_GROOVE: u32 = 6
const BS_RIDGE: u32 = 7
const BS_INSET: u32 = 8
const BS_OUTSET: u32 = 9

// position
const POS_STATIC: u32 = 0
const POS_RELATIVE: u32 = 1
const POS_ABSOLUTE: u32 = 2
const POS_FIXED: u32 = 3
const POS_STICKY: u32 = 4

// float / clear
const FLOAT_NONE: u32 = 0
const FLOAT_LEFT: u32 = 1
const FLOAT_RIGHT: u32 = 2
const CLEAR_NONE: u32 = 0
const CLEAR_LEFT: u32 = 1
const CLEAR_RIGHT: u32 = 2
const CLEAR_BOTH: u32 = 3

// box-sizing
const BOX_CONTENT: u32 = 0
const BOX_BORDER: u32 = 1

// overflow
const OV_VISIBLE: u32 = 0
const OV_HIDDEN: u32 = 1
const OV_SCROLL: u32 = 2
const OV_AUTO: u32 = 3

// text-align
const TA_LEFT: u32 = 0
const TA_RIGHT: u32 = 1
const TA_CENTER: u32 = 2
const TA_JUSTIFY: u32 = 3

// vertical-align
const VA_BASELINE: u32 = 0
const VA_TOP: u32 = 1
const VA_BOTTOM: u32 = 2
const VA_MIDDLE: u32 = 3
const VA_TEXT_TOP: u32 = 4
const VA_TEXT_BOTTOM: u32 = 5

// white-space
const WS_NORMAL: u32 = 0
const WS_PRE: u32 = 1
const WS_NOWRAP: u32 = 2
const WS_PRE_WRAP: u32 = 3
const WS_PRE_LINE: u32 = 4

// flex-direction / flex-wrap
const FD_ROW: u32 = 0
const FD_ROW_REVERSE: u32 = 1
const FD_COLUMN: u32 = 2
const FD_COLUMN_REVERSE: u32 = 3
const FW_NOWRAP: u32 = 0
const FW_WRAP: u32 = 1
const FW_WRAP_REVERSE: u32 = 2

// THE ALIGNMENT KEYWORDS -- ONE set for all four properties.
// `justify-content`, `align-items`, `align-self` and `align-content` draw
// their values from the same box in css-align-3; giving each of them its
// own enumeration would mean four copies of the same nine names and four
// places to get a translation wrong. `auto` is valid only on
// `align-self`, `baseline` only on the two item properties, and the three
// `space-*` values only on the two content properties -- the parser of
// each property lets through what belongs to it.
const AL_AUTO: u32 = 0
const AL_FLEX_START: u32 = 1
const AL_FLEX_END: u32 = 2
const AL_CENTER: u32 = 3
const AL_SPACE_BETWEEN: u32 = 4
const AL_SPACE_AROUND: u32 = 5
const AL_SPACE_EVENLY: u32 = 6
const AL_STRETCH: u32 = 7
const AL_BASELINE: u32 = 8
// `start`/`end` (and `left`/`right`, `self-start`/`self-end`) are NOT the
// same as `flex-start`/`flex-end`, and round 67 folding them together was
// wrong: under `flex-direction: row-reverse` the flex-relative pair turns
// around with the direction while the physical pair does not. The WPT
// tests `flex-abspos-staticpos-justify-content-003` and their kin ask
// exactly that question, container by container.
const AL_START: u32 = 9
const AL_END: u32 = 10

// `z-index: auto` is not the number zero, and the difference is not
// cosmetic: `auto` does NOT make a stacking context, `0` does.
const Z_AUTO_YES: u32 = 1
const Z_AUTO_NO: u32 = 0

// The origins. The order matters -- see origin_level.
const ORIGIN_UA: u32 = 0
const ORIGIN_USER: u32 = 1
const ORIGIN_AUTHOR: u32 = 2

const DECL_IMPORTANT: u32 = 1

// The two keywords that work on every property.
const V_NORMAL: u32 = 0
const V_INHERIT: u32 = 1
const V_INITIAL: u32 = 2

// ------------------------------------------------------------ The classes

gc class Decl {
    value: Gc[Cv],
    prop: u32,
    flags: u32,
}

gc class Rule {
    sel: Gc[Sel],
    decls: GcVec[Gc[Decl]],
    next: Gc[Rule],
    origin: u32,
    order: u32,
}

// The computed style of one element. The lengths lie in ONE array of 24
// slots -- see `S_...` above. One array instead of two dozen fields is not
// a saving of typing but of code: the whole computation of lengths, the
// `inherit`/`initial` handling and the percentage resolution are each one
// loop instead of two dozen copies of the same five lines.
gc class Style {
    length: [f64; 24],
    unit: [u32; 24],
    color: [u32; 5],
    bstyle: [u32; 4],
    font_size: f64,
    flex_grow: f64,
    flex_shrink: f64,
    // `z-index` and `order` are INTEGERS in the standard. They are kept
    // as f64 because every whole number up to 2^53 is exact in a double
    // and the layout arithmetic is f64 throughout -- one number type in
    // the style instead of two, and no conversion at the point of use.
    z_index: f64,
    order: f64,
    z_auto: u32,
    justify_content: u32,
    align_items: u32,
    align_self: u32,
    align_content: u32,
    display: u32,
    position: u32,
    floated: u32,
    clear: u32,
    box_sizing: u32,
    overflow: u32,
    text_align: u32,
    vertical_align: u32,
    white_space: u32,
    flex_direction: u32,
    flex_wrap: u32,
}

fn style_new() -> AllocError!Gc[Style] {
    return try gc Style {
        length: [0.0; 24],
        unit: [0; 24],
        color: [0; 5],
        bstyle: [0; 4],
        font_size: 16.0,
        flex_grow: 0.0,
        flex_shrink: 1.0,
        z_index: 0.0,
        order: 0.0,
        z_auto: Z_AUTO_YES,
        justify_content: AL_FLEX_START,
        align_items: AL_STRETCH,
        align_self: AL_AUTO,
        align_content: AL_STRETCH,
        display: D_INLINE,
        position: POS_STATIC,
        floated: FLOAT_NONE,
        clear: CLEAR_NONE,
        box_sizing: BOX_CONTENT,
        overflow: OV_VISIBLE,
        text_align: TA_LEFT,
        vertical_align: VA_BASELINE,
        white_space: WS_NORMAL,
        flex_direction: FD_ROW,
        flex_wrap: FW_NOWRAP,
    }
}

// The initial values. Zero is right for margin, padding, border width and
// the two minima; the six that are NOT zero are named one by one -- an
// initial value silently wrong is a layout error nobody finds again.
fn style_initial() -> AllocError!Gc[Style] {
    let s = try style_new()
    var i: usize = 0
    while i < LENGTH_SLOTS {
        s.length[i] = 0.0
        s.unit[i] = U_PX
        i = i + 1
    }
    s.unit[S_WIDTH] = U_AUTO
    s.unit[S_HEIGHT] = U_AUTO
    s.unit[S_MAX_WIDTH] = U_NONE
    s.unit[S_MAX_HEIGHT] = U_NONE
    // The initial value of `min-width` and `min-height` is `auto`, not
    // zero (css-sizing-3, 5.1). Outside a flex container the two mean the
    // same thing, which is why the difference stayed invisible until
    // round 67: on a FLEX ITEM `auto` is the automatic minimum size and
    // zero is zero, and that is the difference between a long word
    // sticking out of its box and being squeezed to nothing.
    s.unit[S_MIN_WIDTH] = U_AUTO
    s.unit[S_MIN_HEIGHT] = U_AUTO
    s.unit[S_TOP] = U_AUTO
    s.unit[S_RIGHT] = U_AUTO
    s.unit[S_BOTTOM] = U_AUTO
    s.unit[S_LEFT] = U_AUTO
    s.unit[S_LINE_HEIGHT] = U_NORMAL
    s.unit[S_FLEX_BASIS] = U_AUTO
    var c: usize = 0
    while c < 5 {
        s.color[c] = 0xFF000000
        c = c + 1
    }
    var b: usize = 0
    while b < 4 {
        s.bstyle[b] = BS_NONE
        b = b + 1
    }
    s.font_size = 16.0
    s.flex_grow = 0.0
    s.flex_shrink = 1.0
    s.z_index = 0.0
    s.order = 0.0
    s.z_auto = Z_AUTO_YES
    s.justify_content = AL_FLEX_START
    s.align_items = AL_STRETCH
    s.align_self = AL_AUTO
    s.align_content = AL_STRETCH
    s.display = D_INLINE
    s.position = POS_STATIC
    s.floated = FLOAT_NONE
    s.clear = CLEAR_NONE
    s.box_sizing = BOX_CONTENT
    s.overflow = OV_VISIBLE
    s.text_align = TA_LEFT
    s.vertical_align = VA_BASELINE
    s.white_space = WS_NORMAL
    s.flex_direction = FD_ROW
    s.flex_wrap = FW_NOWRAP
    return s
}

fn style_root() -> AllocError!Gc[Style] {
    return try style_initial()
}

// THE STYLE OF AN ANONYMOUS BOX (CSS 2.1, 9.2.1.1 and css-display-3, 2.3):
// the box properties are at their INITIAL values, the inherited ones come
// from the parent. Handing the parent's own style to an anonymous block
// instead -- which is what round 61 did -- gives that block the parent's
// margin, padding and border a SECOND time, and everything below it
// stands too low by exactly those numbers. It is invisible as long as no
// case mixes text and a block inside a padded box; the WPT corpus of
// round B2 is full of them.
//
// Inherited here are the five properties this property set knows as
// inherited: `color`, `font-size`, `line-height`, `text-align` and
// `white-space`.
fn style_anonymous(parent: Gc[Style]) -> AllocError!Gc[Style] {
    let s = try style_initial()
    if parent == gc_null[Style]() {
        return s
    }
    s.color[0] = parent.color[0]
    s.font_size = parent.font_size
    s.length[S_LINE_HEIGHT] = parent.length[S_LINE_HEIGHT]
    s.unit[S_LINE_HEIGHT] = parent.unit[S_LINE_HEIGHT]
    s.text_align = parent.text_align
    s.white_space = parent.white_space
    return s
}

fn style_length(s: Gc[Style], slot: usize) -> f64 {
    return s.length[slot]
}

fn style_unit(s: Gc[Style], slot: usize) -> u32 {
    return s.unit[slot]
}

fn style_color(s: Gc[Style], slot: usize) -> u32 {
    return s.color[slot]
}

fn style_border_style(s: Gc[Style], slot: usize) -> u32 {
    return s.bstyle[slot]
}

fn style_display(s: Gc[Style]) -> u32 {
    return s.display
}

fn style_font_size(s: Gc[Style]) -> f64 {
    return s.font_size
}

fn style_position(s: Gc[Style]) -> u32 {
    return s.position
}

fn style_float(s: Gc[Style]) -> u32 {
    return s.floated
}

fn style_clear(s: Gc[Style]) -> u32 {
    return s.clear
}

fn style_box_sizing(s: Gc[Style]) -> u32 {
    return s.box_sizing
}

fn style_overflow(s: Gc[Style]) -> u32 {
    return s.overflow
}

fn style_text_align(s: Gc[Style]) -> u32 {
    return s.text_align
}

fn style_vertical_align(s: Gc[Style]) -> u32 {
    return s.vertical_align
}

fn style_white_space(s: Gc[Style]) -> u32 {
    return s.white_space
}

fn style_flex_direction(s: Gc[Style]) -> u32 {
    return s.flex_direction
}

fn style_flex_wrap(s: Gc[Style]) -> u32 {
    return s.flex_wrap
}

fn style_flex_grow(s: Gc[Style]) -> f64 {
    return s.flex_grow
}

fn style_flex_shrink(s: Gc[Style]) -> f64 {
    return s.flex_shrink
}

fn style_z_index(s: Gc[Style]) -> f64 {
    return s.z_index
}

fn style_z_auto(s: Gc[Style]) -> bool {
    return s.z_auto == Z_AUTO_YES
}

fn style_order(s: Gc[Style]) -> f64 {
    return s.order
}

fn style_justify_content(s: Gc[Style]) -> u32 {
    return s.justify_content
}

fn style_align_items(s: Gc[Style]) -> u32 {
    return s.align_items
}

// `align-self: auto` means: take the `align-items` of the PARENT. That
// resolution needs the parent style and therefore does not belong in the
// accessor -- the layout asks for both and decides (css-flexbox-1, 8.3).
fn style_align_self(s: Gc[Style]) -> u32 {
    return s.align_self
}

fn style_align_content(s: Gc[Style]) -> u32 {
    return s.align_content
}

// ------------------------------------------------- Property names -> ids

fn property_id(name: Gc[Chain]) -> u32 {
    var p1: [u8; 7] = "display"
    if node.chain_equal_ascii_small(name, &p1[0], 7) { return P_DISPLAY }
    var p2: [u8; 5] = "color"
    if node.chain_equal_ascii_small(name, &p2[0], 5) { return P_COLOR }
    var p3: [u8; 9] = "font-size"
    if node.chain_equal_ascii_small(name, &p3[0], 9) { return P_FONT_SIZE }
    var p4: [u8; 10] = "margin-top"
    if node.chain_equal_ascii_small(name, &p4[0], 10) { return P_MARGIN_TOP }
    var p5: [u8; 12] = "margin-right"
    if node.chain_equal_ascii_small(name, &p5[0], 12) { return P_MARGIN_RIGHT }
    var p6: [u8; 13] = "margin-bottom"
    if node.chain_equal_ascii_small(name, &p6[0], 13) { return P_MARGIN_BOTTOM }
    var p7: [u8; 11] = "margin-left"
    if node.chain_equal_ascii_small(name, &p7[0], 11) { return P_MARGIN_LEFT }
    var p8: [u8; 11] = "padding-top"
    if node.chain_equal_ascii_small(name, &p8[0], 11) { return P_PADDING_TOP }
    var p9: [u8; 13] = "padding-right"
    if node.chain_equal_ascii_small(name, &p9[0], 13) { return P_PADDING_RIGHT }
    var p10: [u8; 14] = "padding-bottom"
    if node.chain_equal_ascii_small(name, &p10[0], 14) { return P_PADDING_BOTTOM }
    var p11: [u8; 12] = "padding-left"
    if node.chain_equal_ascii_small(name, &p11[0], 12) { return P_PADDING_LEFT }
    var p12: [u8; 16] = "border-top-width"
    if node.chain_equal_ascii_small(name, &p12[0], 16) { return P_BORDER_TOP_WIDTH }
    var p13: [u8; 18] = "border-right-width"
    if node.chain_equal_ascii_small(name, &p13[0], 18) { return P_BORDER_RIGHT_WIDTH }
    var p14: [u8; 19] = "border-bottom-width"
    if node.chain_equal_ascii_small(name, &p14[0], 19) { return P_BORDER_BOTTOM_WIDTH }
    var p15: [u8; 17] = "border-left-width"
    if node.chain_equal_ascii_small(name, &p15[0], 17) { return P_BORDER_LEFT_WIDTH }
    var p16: [u8; 16] = "border-top-style"
    if node.chain_equal_ascii_small(name, &p16[0], 16) { return P_BORDER_TOP_STYLE }
    var p17: [u8; 18] = "border-right-style"
    if node.chain_equal_ascii_small(name, &p17[0], 18) { return P_BORDER_RIGHT_STYLE }
    var p18: [u8; 19] = "border-bottom-style"
    if node.chain_equal_ascii_small(name, &p18[0], 19) { return P_BORDER_BOTTOM_STYLE }
    var p19: [u8; 17] = "border-left-style"
    if node.chain_equal_ascii_small(name, &p19[0], 17) { return P_BORDER_LEFT_STYLE }
    var p20: [u8; 16] = "border-top-color"
    if node.chain_equal_ascii_small(name, &p20[0], 16) { return P_BORDER_TOP_COLOR }
    var p21: [u8; 18] = "border-right-color"
    if node.chain_equal_ascii_small(name, &p21[0], 18) { return P_BORDER_RIGHT_COLOR }
    var p22: [u8; 19] = "border-bottom-color"
    if node.chain_equal_ascii_small(name, &p22[0], 19) { return P_BORDER_BOTTOM_COLOR }
    var p23: [u8; 17] = "border-left-color"
    if node.chain_equal_ascii_small(name, &p23[0], 17) { return P_BORDER_LEFT_COLOR }
    var p24: [u8; 5] = "width"
    if node.chain_equal_ascii_small(name, &p24[0], 5) { return P_WIDTH }
    var p25: [u8; 6] = "height"
    if node.chain_equal_ascii_small(name, &p25[0], 6) { return P_HEIGHT }
    var p26: [u8; 9] = "min-width"
    if node.chain_equal_ascii_small(name, &p26[0], 9) { return P_MIN_WIDTH }
    var p27: [u8; 9] = "max-width"
    if node.chain_equal_ascii_small(name, &p27[0], 9) { return P_MAX_WIDTH }
    var p28: [u8; 10] = "min-height"
    if node.chain_equal_ascii_small(name, &p28[0], 10) { return P_MIN_HEIGHT }
    var p29: [u8; 10] = "max-height"
    if node.chain_equal_ascii_small(name, &p29[0], 10) { return P_MAX_HEIGHT }
    var p30: [u8; 3] = "top"
    if node.chain_equal_ascii_small(name, &p30[0], 3) { return P_TOP }
    var p31: [u8; 5] = "right"
    if node.chain_equal_ascii_small(name, &p31[0], 5) { return P_RIGHT }
    var p32: [u8; 6] = "bottom"
    if node.chain_equal_ascii_small(name, &p32[0], 6) { return P_BOTTOM }
    var p33: [u8; 4] = "left"
    if node.chain_equal_ascii_small(name, &p33[0], 4) { return P_LEFT }
    var p34: [u8; 11] = "line-height"
    if node.chain_equal_ascii_small(name, &p34[0], 11) { return P_LINE_HEIGHT }
    var p35: [u8; 10] = "flex-basis"
    if node.chain_equal_ascii_small(name, &p35[0], 10) { return P_FLEX_BASIS }
    var p36: [u8; 8] = "position"
    if node.chain_equal_ascii_small(name, &p36[0], 8) { return P_POSITION }
    var p37: [u8; 5] = "float"
    if node.chain_equal_ascii_small(name, &p37[0], 5) { return P_FLOAT }
    var p38: [u8; 5] = "clear"
    if node.chain_equal_ascii_small(name, &p38[0], 5) { return P_CLEAR }
    var p39: [u8; 10] = "box-sizing"
    if node.chain_equal_ascii_small(name, &p39[0], 10) { return P_BOX_SIZING }
    var p40: [u8; 8] = "overflow"
    if node.chain_equal_ascii_small(name, &p40[0], 8) { return P_OVERFLOW }
    var p41: [u8; 10] = "text-align"
    if node.chain_equal_ascii_small(name, &p41[0], 10) { return P_TEXT_ALIGN }
    var p42: [u8; 14] = "vertical-align"
    if node.chain_equal_ascii_small(name, &p42[0], 14) { return P_VERTICAL_ALIGN }
    var p43: [u8; 11] = "white-space"
    if node.chain_equal_ascii_small(name, &p43[0], 11) { return P_WHITE_SPACE }
    var p44: [u8; 14] = "flex-direction"
    if node.chain_equal_ascii_small(name, &p44[0], 14) { return P_FLEX_DIRECTION }
    var p45: [u8; 9] = "flex-wrap"
    if node.chain_equal_ascii_small(name, &p45[0], 9) { return P_FLEX_WRAP }
    var p46: [u8; 9] = "flex-grow"
    if node.chain_equal_ascii_small(name, &p46[0], 9) { return P_FLEX_GROW }
    var p47: [u8; 11] = "flex-shrink"
    if node.chain_equal_ascii_small(name, &p47[0], 11) { return P_FLEX_SHRINK }
    var p48: [u8; 7] = "z-index"
    if node.chain_equal_ascii_small(name, &p48[0], 7) { return P_Z_INDEX }
    var p49: [u8; 5] = "order"
    if node.chain_equal_ascii_small(name, &p49[0], 5) { return P_ORDER }
    var p50: [u8; 15] = "justify-content"
    if node.chain_equal_ascii_small(name, &p50[0], 15) { return P_JUSTIFY_CONTENT }
    var p51: [u8; 11] = "align-items"
    if node.chain_equal_ascii_small(name, &p51[0], 11) { return P_ALIGN_ITEMS }
    var p52: [u8; 10] = "align-self"
    if node.chain_equal_ascii_small(name, &p52[0], 10) { return P_ALIGN_SELF }
    var p53: [u8; 13] = "align-content"
    if node.chain_equal_ascii_small(name, &p53[0], 13) { return P_ALIGN_CONTENT }
    return P_NONE
}

// The shorthands. Returns the number of longhands (0 = not a shorthand)
// and the first property id of the group.
fn shorthand_group(name: Gc[Chain]) -> u32 {
    var s1: [u8; 6] = "margin"
    if node.chain_equal_ascii_small(name, &s1[0], 6) { return P_MARGIN_TOP }
    var s2: [u8; 7] = "padding"
    if node.chain_equal_ascii_small(name, &s2[0], 7) { return P_PADDING_TOP }
    var s3: [u8; 12] = "border-width"
    if node.chain_equal_ascii_small(name, &s3[0], 12) { return P_BORDER_TOP_WIDTH }
    var s4: [u8; 12] = "border-style"
    if node.chain_equal_ascii_small(name, &s4[0], 12) { return P_BORDER_TOP_STYLE }
    var s5: [u8; 12] = "border-color"
    if node.chain_equal_ascii_small(name, &s5[0], 12) { return P_BORDER_TOP_COLOR }
    return P_NONE
}

fn is_border_shorthand(name: Gc[Chain]) -> bool {
    var s: [u8; 6] = "border"
    return node.chain_equal_ascii_small(name, &s[0], 6)
}

// `border-top`, `border-right`, `border-bottom`, `border-left`: the same
// shorthand as `border`, only for ONE side. Returns the side (0..3) or 4.
fn border_side_shorthand(name: Gc[Chain]) -> u32 {
    var s1: [u8; 10] = "border-top"
    if node.chain_equal_ascii_small(name, &s1[0], 10) { return 0 }
    var s2: [u8; 12] = "border-right"
    if node.chain_equal_ascii_small(name, &s2[0], 12) { return 1 }
    var s3: [u8; 13] = "border-bottom"
    if node.chain_equal_ascii_small(name, &s3[0], 13) { return 2 }
    var s4: [u8; 11] = "border-left"
    if node.chain_equal_ascii_small(name, &s4[0], 11) { return 3 }
    return 4
}

fn is_flex_shorthand(name: Gc[Chain]) -> bool {
    var s: [u8; 4] = "flex"
    return node.chain_equal_ascii_small(name, &s[0], 4)
}

// `flex-flow: <direction> || <wrap>`, in either order.
fn is_flex_flow_shorthand(name: Gc[Chain]) -> bool {
    var s: [u8; 9] = "flex-flow"
    return node.chain_equal_ascii_small(name, &s[0], 9)
}

// `place-content: <align-content> <justify-content>?`,
// `place-items: <align-items> ...`, `place-self: <align-self> ...`.
// The second value is `justify-items` / `justify-self`, and neither has
// any meaning in a flex container -- it is dropped for the two `items`
// forms and kept for `place-content`.
fn place_shorthand(name: Gc[Chain]) -> u32 {
    var s1: [u8; 13] = "place-content"
    if node.chain_equal_ascii_small(name, &s1[0], 13) { return P_ALIGN_CONTENT }
    var s2: [u8; 11] = "place-items"
    if node.chain_equal_ascii_small(name, &s2[0], 11) { return P_ALIGN_ITEMS }
    var s3: [u8; 10] = "place-self"
    if node.chain_equal_ascii_small(name, &s3[0], 10) { return P_ALIGN_SELF }
    return P_NONE
}

// `overflow` takes one or two values (x and y). Only one axis is
// implemented, so the FIRST value counts -- and that is the one that
// decides whether a block formatting context is opened.
fn is_overflow_shorthand(name: Gc[Chain]) -> bool {
    var s: [u8; 8] = "overflow"
    return node.chain_equal_ascii_small(name, &s[0], 8)
}

// A component value made up on the spot. The `flex` shorthand needs
// values that do not stand in the source -- `flex: 1` means the basis 0%,
// and `flex: none` means grow 0 and shrink 0. Making a real component
// value out of them keeps the cascade in ONE shape: every winner is a
// declaration with a component value, without a second path.
fn made_up_value(kind: u32, digit: u32) -> AllocError!Gc[Cv] {
    let v = try cv.cv_new(kind)
    let k = try node.chain_new()
    let ok: bool = try node.chain_push(k, 48 as u32 + digit)
    v.text = k
    return try single_value(v)
}

// ----------------------------------------------------- Declarations of a block

fn decl_new(prop: u32, value: Gc[Cv], flags: u32) -> AllocError!Gc[Decl] {
    return try gc Decl {
        value: value,
        prop: prop,
        flags: flags,
    }
}

fn decls_append(v: Gc[GcVec], d: Gc[Decl]) -> AllocError!bool {
    return try gcvec_append[Decl](v, d)
}

// A value list with exactly one component value.
fn single_value(v: Gc[Cv]) -> AllocError!Gc[Cv] {
    let l = try cv.cv_new(cv.CV_LIST)
    let ok: bool = try cv.cv_append(l, v)
    return l
}

fn non_ws_count(list: Gc[Cv]) -> u64 {
    var n: u64 = 0
    var i: u64 = 0
    while i < cv.cv_kids_count(list) {
        if cv.cv_kid(list, i).kind != tok.T_WHITESPACE {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn non_ws_at(list: Gc[Cv], k: u64) -> Gc[Cv] {
    var n: u64 = 0
    var i: u64 = 0
    while i < cv.cv_kids_count(list) {
        let c: Gc[Cv] = cv.cv_kid(list, i)
        if c.kind != tok.T_WHITESPACE {
            if n == k {
                return c
            }
            n = n + 1
        }
        i = i + 1
    }
    return gc_null[Cv]()
}

// The 1-to-4 value rule of the box shorthands.
fn box_index(count: u64, side: u64) -> u64 {
    if count == 1 {
        return 0
    }
    if count == 2 {
        if side == 0 || side == 2 {
            return 0
        }
        return 1
    }
    if count == 3 {
        if side == 0 {
            return 0
        }
        if side == 2 {
            return 2
        }
        return 1
    }
    return side
}

// Appends the declarations of ONE parsed declaration to the vector.
// A shorthand becomes several longhands here -- out of `margin: 1px 2px`
// come four declarations, and only those take part in the cascade. That is
// the reason a later `margin-left` beats an earlier `margin`.
fn append_declaration(name: Gc[Chain], value: Gc[Cv], important: bool,
    out: Gc[GcVec]) -> AllocError!bool {
    var flags: u32 = 0
    if important {
        flags = DECL_IMPORTANT
    }
    let direct: u32 = property_id(name)
    if direct != P_NONE {
        let d = try decl_new(direct, value, flags)
        return try decls_append(out, d)
    }
    let group: u32 = shorthand_group(name)
    if group != P_NONE {
        let count: u64 = non_ws_count(value)
        if count < 1 || count > 4 {
            return false
        }
        var side: u64 = 0
        while side < 4 {
            let v: Gc[Cv] = non_ws_at(value, box_index(count, side))
            let one = try single_value(v)
            let d = try decl_new(group + side as u32, one, flags)
            let ok: bool = try decls_append(out, d)
            side = side + 1
        }
        return true
    }
    if is_flex_shorthand(name) {
        let count: u64 = non_ws_count(value)
        if count < 1 || count > 3 {
            return false
        }
        let v0: Gc[Cv] = non_ws_at(value, 0)
        var none_w: [u8; 4] = "none"
        if count == 1 && is_ident_word(v0, &none_w[0], 4) {
            // `flex: none` is `0 0 auto`.
            let g0 = try made_up_value(tok.T_NUMBER, 0)
            let ok1: bool = try decls_append(out, try decl_new(P_FLEX_GROW, g0, flags))
            let s0 = try made_up_value(tok.T_NUMBER, 0)
            let ok2: bool = try decls_append(out, try decl_new(P_FLEX_SHRINK, s0, flags))
            let b0 = try single_value(v0)
            let ok3: bool = try decls_append(out, try decl_new(P_FLEX_BASIS, b0, flags))
            return true
        }
        // The general form: leading numbers are grow and shrink,
        // everything else is the basis.
        var grow: Gc[Cv] = gc_null[Cv]()
        var shrink: Gc[Cv] = gc_null[Cv]()
        var basis: Gc[Cv] = gc_null[Cv]()
        var i: u64 = 0
        while i < count {
            let v: Gc[Cv] = non_ws_at(value, i)
            if v.kind == tok.T_NUMBER && basis == gc_null[Cv]() &&
            shrink == gc_null[Cv]() {
                if grow == gc_null[Cv]() {
                    grow = v
                } else {
                    shrink = v
                }
            } else {
                // A THIRD number is the basis -- `flex: 1 1 0` is the form
                // every framework writes, and `0` is a valid length.
                if basis != gc_null[Cv]() {
                    return false
                }
                basis = v
            }
            i = i + 1
        }
        if grow != gc_null[Cv]() {
            let gv = try single_value(grow)
            let okg: bool = try decls_append(out, try decl_new(P_FLEX_GROW, gv, flags))
        }
        if shrink != gc_null[Cv]() {
            let sv = try single_value(shrink)
            let oks: bool = try decls_append(out, try decl_new(P_FLEX_SHRINK, sv, flags))
        } else {
            let sv2 = try made_up_value(tok.T_NUMBER, 1)
            let oks2: bool = try decls_append(out, try decl_new(P_FLEX_SHRINK, sv2, flags))
        }
        if basis != gc_null[Cv]() {
            let bv = try single_value(basis)
            let okb: bool = try decls_append(out, try decl_new(P_FLEX_BASIS, bv, flags))
        } else if grow != gc_null[Cv]() {
            // `flex: 1` is `1 1 0%`, NOT `1 1 auto`. That is the one place
            // where the shorthand is not the sum of its parts.
            let bv2 = try made_up_value(tok.T_PERCENTAGE, 0)
            let okb2: bool = try decls_append(out, try decl_new(P_FLEX_BASIS, bv2, flags))
        }
        return true
    }
    if is_overflow_shorthand(name) {
        let count: u64 = non_ws_count(value)
        if count < 1 || count > 2 {
            return false
        }
        let one = try single_value(non_ws_at(value, 0))
        let d = try decl_new(P_OVERFLOW, one, flags)
        return try decls_append(out, d)
    }
    if is_flex_flow_shorthand(name) {
        let count: u64 = non_ws_count(value)
        if count < 1 || count > 2 {
            return false
        }
        var i3: u64 = 0
        while i3 < count {
            let v: Gc[Cv] = non_ws_at(value, i3)
            let one = try single_value(v)
            var x: u32 = 0
            if value_flex_direction(v, &x) {
                let d3 = try decl_new(P_FLEX_DIRECTION, one, flags)
                let ok5: bool = try decls_append(out, d3)
            } else if value_flex_wrap(v, &x) {
                let d4 = try decl_new(P_FLEX_WRAP, one, flags)
                let ok6: bool = try decls_append(out, d4)
            }
            i3 = i3 + 1
        }
        return true
    }
    let place: u32 = place_shorthand(name)
    if place != P_NONE {
        let count: u64 = non_ws_count(value)
        if count < 1 || count > 2 {
            return false
        }
        let one = try single_value(non_ws_at(value, 0))
        let d5 = try decl_new(place, one, flags)
        let ok7: bool = try decls_append(out, d5)
        if place == P_ALIGN_CONTENT && count == 2 {
            let two = try single_value(non_ws_at(value, 1))
            let d6 = try decl_new(P_JUSTIFY_CONTENT, two, flags)
            let ok8: bool = try decls_append(out, d6)
        }
        return true
    }
    let side_group: u32 = border_side_shorthand(name)
    if side_group < 4 as u32 {
        let count: u64 = non_ws_count(value)
        if count < 1 || count > 3 {
            return false
        }
        var i2: u64 = 0
        while i2 < count {
            let v: Gc[Cv] = non_ws_at(value, i2)
            let one = try single_value(v)
            var group3: u32 = P_NONE
            var w2: f64 = 0.0
            var u2: u32 = U_PX
            var col2: u32 = 0
            if value_border_style(v) != BS_NONE || is_ident_none(v) {
                group3 = P_BORDER_TOP_STYLE
            } else if parse_color_value(v, &col2) {
                group3 = P_BORDER_TOP_COLOR
            } else if parse_border_width(v, &w2, &u2) {
                group3 = P_BORDER_TOP_WIDTH
            }
            if group3 != P_NONE {
                let d2 = try decl_new(group3 + side_group, one, flags)
                let okd: bool = try decls_append(out, d2)
            }
            i2 = i2 + 1
        }
        return true
    }
    if is_border_shorthand(name) {
        // `border: 1px solid red`, in any order.
        let count: u64 = non_ws_count(value)
        if count < 1 || count > 3 {
            return false
        }
        var i: u64 = 0
        while i < count {
            let v: Gc[Cv] = non_ws_at(value, i)
            let one = try single_value(v)
            var group2: u32 = P_NONE
            var w: f64 = 0.0
            var u: u32 = U_PX
            var col: u32 = 0
            if value_border_style(v) != BS_NONE || is_ident_none(v) {
                group2 = P_BORDER_TOP_STYLE
            } else if parse_color_value(v, &col) {
                group2 = P_BORDER_TOP_COLOR
            } else if parse_border_width(v, &w, &u) {
                group2 = P_BORDER_TOP_WIDTH
            }
            if group2 != P_NONE {
                var side2: u64 = 0
                while side2 < 4 {
                    let d = try decl_new(group2 + side2 as u32, one, flags)
                    let ok2: bool = try decls_append(out, d)
                    side2 = side2 + 1
                }
            }
            i = i + 1
        }
        return true
    }
    return false
}

// Parses the content of a `{}` block (component values) as declarations.
// Deliberately not through lib/css/cv.fi once more: the block already IS a
// list of component values -- nested blocks are resolved, so the only work
// left is splitting at the semicolons.
fn parse_block_declarations(block: Gc[Cv]) -> AllocError!Gc[GcVec] {
    let out = try gcvec_new()
    let n: u64 = cv.cv_kids_count(block)
    var i: u64 = 0
    while i < n {
        let c: Gc[Cv] = cv.cv_kid(block, i)
        if c.kind == tok.T_WHITESPACE || c.kind == tok.T_SEMICOLON {
            i = i + 1
        } else if c.kind == tok.T_AT_KEYWORD {
            // An at-rule inside a style block is skipped up to the `;`.
            while i < n && cv.cv_kid(block, i).kind != tok.T_SEMICOLON {
                i = i + 1
            }
        } else {
            var name: Gc[Chain] = gc_null[Chain]()
            var good: bool = false
            if c.kind == tok.T_IDENT {
                name = c.text
                i = i + 1
                while i < n && cv.cv_kid(block, i).kind == tok.T_WHITESPACE {
                    i = i + 1
                }
                if i < n && cv.cv_kid(block, i).kind == tok.T_COLON {
                    i = i + 1
                    good = true
                }
            }
            let value = try cv.cv_new(cv.CV_LIST)
            var state: u32 = 0
            var bang: u64 = 0
            while i < n && cv.cv_kid(block, i).kind != tok.T_SEMICOLON {
                let v: Gc[Cv] = cv.cv_kid(block, i)
                if state == 0 as u32 && is_bang_delim(v) {
                    state = 1
                    bang = cv.cv_kids_count(value)
                } else if state == 1 as u32 && is_important_word(v) {
                    state = 2
                } else if v.kind != tok.T_WHITESPACE {
                    state = 0
                }
                let ok: bool = try cv.cv_append(value, v)
                i = i + 1
            }
            if i < n {
                i = i + 1 // the semicolon
            }
            if good {
                var important: bool = false
                if state == 2 as u32 {
                    important = true
                    cv.cv_truncate(value, bang)
                }
                let ok2: bool = try append_declaration(name, value, important, out)
            }
        }
    }
    return out
}

fn is_bang_delim(c: Gc[Cv]) -> bool {
    if c.kind != tok.T_DELIM {
        return false
    }
    var lit: [u8; 1] = "!"
    return node.chain_equal_ascii(c.text, &lit[0], 1)
}

fn is_important_word(c: Gc[Cv]) -> bool {
    if c.kind != tok.T_IDENT {
        return false
    }
    var lit: [u8; 9] = "important"
    return node.chain_equal_ascii_small(c.text, &lit[0], 9)
}

// ------------------------------------------------------------ Rule collection

// Turns a parsed stylesheet into a chain of rules. Rules with an invalid
// selector are dropped -- that is the standard, and it is the reason an
// unknown pseudo-class must not simply match nothing.
fn collect_rules(sheet: Gc[Cv], origin: u32, order_start: u32,
    nm: *mut names.Names, tmp: *mut mem.CpBuf,
    order_end: *mut u32) -> AllocError!Gc[Rule] {
    var first: Gc[Rule] = gc_null[Rule]()
    var last: Gc[Rule] = gc_null[Rule]()
    var order: u32 = order_start
    let n: u64 = cv.cv_kids_count(sheet)
    var i: u64 = 0
    while i < n {
        let r: Gc[Cv] = cv.cv_kid(sheet, i)
        if r.kind == cv.CV_QUALIFIED_RULE {
            let s = try sel.sel_parse(r, nm, tmp)
            if s != gc_null[Sel]() {
                let block: Gc[Cv] = try cv.cv_extra_as_list(r)
                let d = try parse_block_declarations(block)
                let rule = try gc Rule {
                    sel: s,
                    decls: d,
                    next: gc_null[Rule](),
                    origin: origin,
                    order: order,
                }
                order = order + 1 as u32
                if last == gc_null[Rule]() {
                    first = rule
                } else {
                    last.next = rule
                }
                last = rule
            }
        }
        i = i + 1
    }
    *order_end = order
    return first
}

fn rules_count(r: Gc[Rule]) -> u32 {
    var n: u32 = 0
    var x: Gc[Rule] = r
    while x != gc_null[Rule]() {
        n = n + 1 as u32
        x = x.next
    }
    return n
}

// ------------------------------------------------------------- The cascade

// The rank of an origin: `!important` turns the order around.
fn origin_level(origin: u32, important: bool) -> u32 {
    if !important {
        return origin
    }
    return 5 as u32 - origin
}

// The winners per property for ONE element.
struct Winner {
    best: [Gc[Decl]; 53],
    level: [u32; 53],
    spec: [u32; 53],
    order: [u32; 53],
    taken: [u32; 53],
}

fn winner_new() -> Winner {
    return Winner {
        best: [gc_null[Decl](); 53],
        level: [0; 53],
        spec: [0; 53],
        order: [0; 53],
        taken: [0; 53],
    }
}

fn winner_clear(w: *mut Winner) {
    var i: usize = 0
    while i < 53 {
        (*w).best[i] = gc_null[Decl]()
        (*w).level[i] = 0
        (*w).spec[i] = 0
        (*w).order[i] = 0
        (*w).taken[i] = 0
        i = i + 1
    }
}

fn winner_offer(w: *mut Winner, prop: u32, d: Gc[Decl], level: u32,
    spec: u32, order: u32) {
    let i: usize = prop as usize
    if (*w).taken[i] != 0 as u32 {
        if level < (*w).level[i] {
            return
        }
        if level == (*w).level[i] {
            if spec < (*w).spec[i] {
                return
            }
            if spec == (*w).spec[i] && order < (*w).order[i] {
                return
            }
        }
    }
    (*w).best[i] = d
    (*w).level[i] = level
    (*w).spec[i] = spec
    (*w).order[i] = order
    (*w).taken[i] = 1
}

// The declarations of a `style` attribute. They are ordinary
// declarations, only without a selector -- the shorthands are resolved
// the same way, so `style="margin:1px 2px"` becomes four longhands here
// too.
fn parse_inline_declarations(values: Gc[Cv]) -> AllocError!Gc[GcVec] {
    return try parse_block_declarations(values)
}

// Runs the cascade for one element and computes its style.
fn cascade_elem(rules: Gc[Rule], k: Gc[Node], parent: Gc[Style],
    cx: *mut sel.Ctx, w: *mut Winner) -> AllocError!Gc[Style] {
    return try cascade_elem_inline(rules, k, parent, cx, w, gc_null[GcVec]())
}

// The same, with the declarations of the `style` attribute on top. They
// take part in the cascade with the AUTHOR origin and a specificity above
// every selector -- that is the classic model of CSS 2.1, 6.4.3, and it
// gives the same result as css-cascade-4 wherever no animation is in play.
fn cascade_elem_inline(rules: Gc[Rule], k: Gc[Node], parent: Gc[Style],
    cx: *mut sel.Ctx, w: *mut Winner,
    inline: Gc[GcVec]) -> AllocError!Gc[Style] {
    winner_clear(w)
    var r: Gc[Rule] = rules
    while r != gc_null[Rule]() {
        // The specificity of the selector THAT MATCHES -- with a group,
        // the highest of the matching ones.
        var best: u32 = 0
        var hit: bool = false
        var s: Gc[Sel] = r.sel
        while s != gc_null[Sel]() {
            if sel.sel_matches_one(s, k, cx) {
                hit = true
                if sel.sel_specificity(s) > best {
                    best = sel.sel_specificity(s)
                }
            }
            s = s.next
        }
        if hit {
            var di: u64 = 0
            while di < gcvec_length(r.decls) {
                let d: Gc[Decl] = gcvec_read[Decl](r.decls, di)
                let important: bool = (d.flags & DECL_IMPORTANT) != 0 as u32
                winner_offer(w, d.prop, d, origin_level(r.origin, important),
                    best, r.order)
                di = di + 1
            }
        }
        r = r.next
    }
    if inline != gc_null[GcVec]() {
        var ii: u64 = 0
        while ii < gcvec_length(inline) {
            let d: Gc[Decl] = gcvec_read[Decl](inline, ii)
            let important: bool = (d.flags & DECL_IMPORTANT) != 0 as u32
            winner_offer(w, d.prop, d, origin_level(ORIGIN_AUTHOR, important),
                0xFFFFFFFF, 0xFFFFFFFF)
            ii = ii + 1
        }
    }
    return try compute_style(w, parent)
}

// --------------------------------------------------------- Computed values

fn is_ident_word(c: Gc[Cv], p: *mut u8, n: usize) -> bool {
    if c == gc_null[Cv]() || c.kind != tok.T_IDENT {
        return false
    }
    return node.chain_equal_ascii_small(c.text, p, n)
}

fn is_ident_none(c: Gc[Cv]) -> bool {
    var w: [u8; 4] = "none"
    return is_ident_word(c, &w[0], 4)
}

fn keyword_kind(c: Gc[Cv]) -> u32 {
    var w1: [u8; 7] = "inherit"
    if is_ident_word(c, &w1[0], 7) {
        return V_INHERIT
    }
    var w2: [u8; 7] = "initial"
    if is_ident_word(c, &w2[0], 7) {
        return V_INITIAL
    }
    return V_NORMAL
}

// The factor of a unit in px. 0 means: not a length.
fn unit_factor(c: Gc[Cv], font_size: f64, root_size: f64, ok: *mut bool) -> f64 {
    *ok = true
    var u1: [u8; 2] = "px"
    if node.chain_equal_ascii_small(c.unit, &u1[0], 2) { return 1.0 }
    var u2: [u8; 2] = "pt"
    if node.chain_equal_ascii_small(c.unit, &u2[0], 2) { return 96.0 / 72.0 }
    var u3: [u8; 2] = "pc"
    if node.chain_equal_ascii_small(c.unit, &u3[0], 2) { return 16.0 }
    var u4: [u8; 2] = "in"
    if node.chain_equal_ascii_small(c.unit, &u4[0], 2) { return 96.0 }
    var u5: [u8; 2] = "cm"
    if node.chain_equal_ascii_small(c.unit, &u5[0], 2) { return 96.0 / 2.54 }
    var u6: [u8; 2] = "mm"
    if node.chain_equal_ascii_small(c.unit, &u6[0], 2) { return 96.0 / 25.4 }
    var u7: [u8; 2] = "em"
    if node.chain_equal_ascii_small(c.unit, &u7[0], 2) { return font_size }
    var u8: [u8; 3] = "rem"
    if node.chain_equal_ascii_small(c.unit, &u8[0], 3) { return root_size }
    var u9: [u8; 2] = "ex"
    if node.chain_equal_ascii_small(c.unit, &u9[0], 2) { return font_size * 0.5 }
    var u10: [u8; 2] = "ch"
    if node.chain_equal_ascii_small(c.unit, &u10[0], 2) { return font_size * 0.5 }
    *ok = false
    return 0.0
}

// The number value of a numeric component value.
fn number_of(c: Gc[Cv]) -> f64 {
    return chain_number(c.text)
}

fn chain_number(k: Gc[Chain]) -> f64 {
    let n: u64 = node.chain_len(k)
    var i: u64 = 0
    var sign: f64 = 1.0
    if i < n {
        let c: u32 = node.chain_at(k, i)
        if c == 45 as u32 {
            sign = 0.0 - 1.0
            i = i + 1
        } else if c == 43 as u32 {
            i = i + 1
        }
    }
    var whole: f64 = 0.0
    while i < n && node.chain_at(k, i) >= 48 as u32 && node.chain_at(k, i) <= 57 as u32 {
        whole = whole * 10.0 + (node.chain_at(k, i) - 48 as u32) as f64
        i = i + 1
    }
    if i < n && node.chain_at(k, i) == 46 as u32 {
        i = i + 1
        var scale: f64 = 0.1
        while i < n && node.chain_at(k, i) >= 48 as u32 && node.chain_at(k, i) <= 57 as u32 {
            whole = whole + (node.chain_at(k, i) - 48 as u32) as f64 * scale
            scale = scale * 0.1
            i = i + 1
        }
    }
    var value: f64 = sign * whole
    if i < n {
        let e: u32 = node.chain_at(k, i)
        if e == 101 as u32 || e == 69 as u32 {
            i = i + 1
            var negative: bool = false
            if i < n && node.chain_at(k, i) == 45 as u32 {
                negative = true
                i = i + 1
            } else if i < n && node.chain_at(k, i) == 43 as u32 {
                i = i + 1
            }
            var ev: i64 = 0
            while i < n && node.chain_at(k, i) >= 48 as u32 && node.chain_at(k, i) <= 57 as u32 {
                if ev < 100 {
                    ev = ev * 10 + (node.chain_at(k, i) - 48 as u32) as i64
                }
                i = i + 1
            }
            var c2: i64 = 0
            while c2 < ev {
                if negative {
                    value = value / 10.0
                } else {
                    value = value * 10.0
                }
                c2 = c2 + 1
            }
        }
    }
    return value
}

// A length or a percentage. `auto` is handled by the caller.
fn parse_length(c: Gc[Cv], font_size: f64, root_size: f64,
    out: *mut f64, unit: *mut u32) -> bool {
    if c == gc_null[Cv]() {
        return false
    }
    if c.kind == tok.T_DIMENSION {
        var ok: bool = false
        let f: f64 = unit_factor(c, font_size, root_size, &ok)
        if !ok {
            return false
        }
        *out = number_of(c) * f
        *unit = U_PX
        return true
    }
    if c.kind == tok.T_PERCENTAGE {
        *out = number_of(c)
        *unit = U_PERCENT
        return true
    }
    if c.kind == tok.T_NUMBER {
        // Only the number zero is a length without a unit.
        let v: f64 = number_of(c)
        if v == 0.0 {
            *out = 0.0
            *unit = U_PX
            return true
        }
        return false
    }
    return false
}

fn parse_border_width(c: Gc[Cv], out: *mut f64, unit: *mut u32) -> bool {
    var w1: [u8; 4] = "thin"
    if is_ident_word(c, &w1[0], 4) {
        *out = 1.0
        *unit = U_PX
        return true
    }
    var w2: [u8; 6] = "medium"
    if is_ident_word(c, &w2[0], 6) {
        *out = 3.0
        *unit = U_PX
        return true
    }
    var w3: [u8; 5] = "thick"
    if is_ident_word(c, &w3[0], 5) {
        *out = 5.0
        *unit = U_PX
        return true
    }
    return parse_length(c, 16.0, 16.0, out, unit)
}

fn value_border_style(c: Gc[Cv]) -> u32 {
    var w1: [u8; 6] = "hidden"
    if is_ident_word(c, &w1[0], 6) { return BS_HIDDEN }
    var w2: [u8; 6] = "dotted"
    if is_ident_word(c, &w2[0], 6) { return BS_DOTTED }
    var w3: [u8; 6] = "dashed"
    if is_ident_word(c, &w3[0], 6) { return BS_DASHED }
    var w4: [u8; 5] = "solid"
    if is_ident_word(c, &w4[0], 5) { return BS_SOLID }
    var w5: [u8; 6] = "double"
    if is_ident_word(c, &w5[0], 6) { return BS_DOUBLE }
    var w6: [u8; 6] = "groove"
    if is_ident_word(c, &w6[0], 6) { return BS_GROOVE }
    var w7: [u8; 5] = "ridge"
    if is_ident_word(c, &w7[0], 5) { return BS_RIDGE }
    var w8: [u8; 5] = "inset"
    if is_ident_word(c, &w8[0], 5) { return BS_INSET }
    var w9: [u8; 6] = "outset"
    if is_ident_word(c, &w9[0], 6) { return BS_OUTSET }
    return BS_NONE
}

fn value_display(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 5] = "block"
    if is_ident_word(c, &w1[0], 5) {
        *out = D_BLOCK
        return true
    }
    var w2: [u8; 6] = "inline"
    if is_ident_word(c, &w2[0], 6) {
        *out = D_INLINE
        return true
    }
    var w3: [u8; 12] = "inline-block"
    if is_ident_word(c, &w3[0], 12) {
        *out = D_INLINE_BLOCK
        return true
    }
    var w4: [u8; 4] = "none"
    if is_ident_word(c, &w4[0], 4) {
        *out = D_NONE
        return true
    }
    var w5: [u8; 9] = "list-item"
    if is_ident_word(c, &w5[0], 9) {
        *out = D_LIST_ITEM
        return true
    }
    var w6: [u8; 4] = "flex"
    if is_ident_word(c, &w6[0], 4) {
        *out = D_FLEX
        return true
    }
    var w7: [u8; 11] = "inline-flex"
    if is_ident_word(c, &w7[0], 11) {
        *out = D_INLINE_FLEX
        return true
    }
    var w8: [u8; 4] = "grid"
    if is_ident_word(c, &w8[0], 4) {
        *out = D_GRID
        return true
    }
    var w9: [u8; 5] = "table"
    if is_ident_word(c, &w9[0], 5) {
        *out = D_TABLE
        return true
    }
    var w10: [u8; 9] = "table-row"
    if is_ident_word(c, &w10[0], 9) {
        *out = D_TABLE_ROW
        return true
    }
    var w11: [u8; 10] = "table-cell"
    if is_ident_word(c, &w11[0], 10) {
        *out = D_TABLE_CELL
        return true
    }
    var w12: [u8; 12] = "inline-table"
    if is_ident_word(c, &w12[0], 12) {
        *out = D_INLINE_TABLE
        return true
    }
    return false
}

// ------------------------------------------- The keyword properties

// One helper for all of them: the id of a keyword out of a list of words,
// or `miss` if none fits. Written out per property below -- a table of
// strings would need a string type that Firn does not have at the level of
// a constant, and ten small functions read better than one big one.

fn value_position(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 6] = "static"
    if is_ident_word(c, &w1[0], 6) { *out = POS_STATIC; return true }
    var w2: [u8; 8] = "relative"
    if is_ident_word(c, &w2[0], 8) { *out = POS_RELATIVE; return true }
    var w3: [u8; 8] = "absolute"
    if is_ident_word(c, &w3[0], 8) { *out = POS_ABSOLUTE; return true }
    var w4: [u8; 5] = "fixed"
    if is_ident_word(c, &w4[0], 5) { *out = POS_FIXED; return true }
    var w5: [u8; 6] = "sticky"
    if is_ident_word(c, &w5[0], 6) { *out = POS_STICKY; return true }
    return false
}

fn value_float(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 4] = "none"
    if is_ident_word(c, &w1[0], 4) { *out = FLOAT_NONE; return true }
    var w2: [u8; 4] = "left"
    if is_ident_word(c, &w2[0], 4) { *out = FLOAT_LEFT; return true }
    var w3: [u8; 5] = "right"
    if is_ident_word(c, &w3[0], 5) { *out = FLOAT_RIGHT; return true }
    return false
}

fn value_clear(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 4] = "none"
    if is_ident_word(c, &w1[0], 4) { *out = CLEAR_NONE; return true }
    var w2: [u8; 4] = "left"
    if is_ident_word(c, &w2[0], 4) { *out = CLEAR_LEFT; return true }
    var w3: [u8; 5] = "right"
    if is_ident_word(c, &w3[0], 5) { *out = CLEAR_RIGHT; return true }
    var w4: [u8; 4] = "both"
    if is_ident_word(c, &w4[0], 4) { *out = CLEAR_BOTH; return true }
    return false
}

fn value_box_sizing(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 11] = "content-box"
    if is_ident_word(c, &w1[0], 11) { *out = BOX_CONTENT; return true }
    var w2: [u8; 10] = "border-box"
    if is_ident_word(c, &w2[0], 10) { *out = BOX_BORDER; return true }
    return false
}

fn value_overflow(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 7] = "visible"
    if is_ident_word(c, &w1[0], 7) { *out = OV_VISIBLE; return true }
    var w2: [u8; 6] = "hidden"
    if is_ident_word(c, &w2[0], 6) { *out = OV_HIDDEN; return true }
    var w3: [u8; 6] = "scroll"
    if is_ident_word(c, &w3[0], 6) { *out = OV_SCROLL; return true }
    var w4: [u8; 4] = "auto"
    if is_ident_word(c, &w4[0], 4) { *out = OV_AUTO; return true }
    var w5: [u8; 4] = "clip"
    if is_ident_word(c, &w5[0], 4) { *out = OV_HIDDEN; return true }
    return false
}

fn value_text_align(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 4] = "left"
    if is_ident_word(c, &w1[0], 4) { *out = TA_LEFT; return true }
    var w2: [u8; 5] = "right"
    if is_ident_word(c, &w2[0], 5) { *out = TA_RIGHT; return true }
    var w3: [u8; 6] = "center"
    if is_ident_word(c, &w3[0], 6) { *out = TA_CENTER; return true }
    var w4: [u8; 7] = "justify"
    if is_ident_word(c, &w4[0], 7) { *out = TA_JUSTIFY; return true }
    // `start` and `end` are the writing-mode-aware names; only
    // left-to-right is implemented, so they fall together with left/right.
    var w5: [u8; 5] = "start"
    if is_ident_word(c, &w5[0], 5) { *out = TA_LEFT; return true }
    var w6: [u8; 3] = "end"
    if is_ident_word(c, &w6[0], 3) { *out = TA_RIGHT; return true }
    return false
}

fn value_vertical_align(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 8] = "baseline"
    if is_ident_word(c, &w1[0], 8) { *out = VA_BASELINE; return true }
    var w2: [u8; 3] = "top"
    if is_ident_word(c, &w2[0], 3) { *out = VA_TOP; return true }
    var w3: [u8; 6] = "bottom"
    if is_ident_word(c, &w3[0], 6) { *out = VA_BOTTOM; return true }
    var w4: [u8; 6] = "middle"
    if is_ident_word(c, &w4[0], 6) { *out = VA_MIDDLE; return true }
    var w5: [u8; 8] = "text-top"
    if is_ident_word(c, &w5[0], 8) { *out = VA_TEXT_TOP; return true }
    var w6: [u8; 11] = "text-bottom"
    if is_ident_word(c, &w6[0], 11) { *out = VA_TEXT_BOTTOM; return true }
    return false
}

fn value_white_space(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 6] = "normal"
    if is_ident_word(c, &w1[0], 6) { *out = WS_NORMAL; return true }
    var w2: [u8; 3] = "pre"
    if is_ident_word(c, &w2[0], 3) { *out = WS_PRE; return true }
    var w3: [u8; 6] = "nowrap"
    if is_ident_word(c, &w3[0], 6) { *out = WS_NOWRAP; return true }
    var w4: [u8; 8] = "pre-wrap"
    if is_ident_word(c, &w4[0], 8) { *out = WS_PRE_WRAP; return true }
    var w5: [u8; 8] = "pre-line"
    if is_ident_word(c, &w5[0], 8) { *out = WS_PRE_LINE; return true }
    return false
}

fn value_flex_direction(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 3] = "row"
    if is_ident_word(c, &w1[0], 3) { *out = FD_ROW; return true }
    var w2: [u8; 11] = "row-reverse"
    if is_ident_word(c, &w2[0], 11) { *out = FD_ROW_REVERSE; return true }
    var w3: [u8; 6] = "column"
    if is_ident_word(c, &w3[0], 6) { *out = FD_COLUMN; return true }
    var w4: [u8; 14] = "column-reverse"
    if is_ident_word(c, &w4[0], 14) { *out = FD_COLUMN_REVERSE; return true }
    return false
}

fn value_flex_wrap(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 6] = "nowrap"
    if is_ident_word(c, &w1[0], 6) { *out = FW_NOWRAP; return true }
    var w2: [u8; 4] = "wrap"
    if is_ident_word(c, &w2[0], 4) { *out = FW_WRAP; return true }
    var w3: [u8; 12] = "wrap-reverse"
    if is_ident_word(c, &w3[0], 12) { *out = FW_WRAP_REVERSE; return true }
    return false
}

// The alignment keywords, in one place. `start`/`end` and
// `flex-start`/`flex-end` fall together here: they differ only under a
// writing mode other than left-to-right top-to-bottom, and only that one
// is implemented (docs/ROUND67.md).
fn value_align_common(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 10] = "flex-start"
    if is_ident_word(c, &w1[0], 10) { *out = AL_FLEX_START; return true }
    var w2: [u8; 8] = "flex-end"
    if is_ident_word(c, &w2[0], 8) { *out = AL_FLEX_END; return true }
    var w3: [u8; 6] = "center"
    if is_ident_word(c, &w3[0], 6) { *out = AL_CENTER; return true }
    var w4: [u8; 5] = "start"
    if is_ident_word(c, &w4[0], 5) { *out = AL_START; return true }
    var w5: [u8; 3] = "end"
    if is_ident_word(c, &w5[0], 3) { *out = AL_END; return true }
    var w6: [u8; 4] = "left"
    if is_ident_word(c, &w6[0], 4) { *out = AL_START; return true }
    var w7: [u8; 5] = "right"
    if is_ident_word(c, &w7[0], 5) { *out = AL_END; return true }
    var w8: [u8; 10] = "self-start"
    if is_ident_word(c, &w8[0], 10) { *out = AL_START; return true }
    var w9: [u8; 8] = "self-end"
    if is_ident_word(c, &w9[0], 8) { *out = AL_END; return true }
    return false
}

fn value_justify_content(c: Gc[Cv], out: *mut u32) -> bool {
    if value_align_common(c, out) {
        return true
    }
    var w1: [u8; 13] = "space-between"
    if is_ident_word(c, &w1[0], 13) { *out = AL_SPACE_BETWEEN; return true }
    var w2: [u8; 12] = "space-around"
    if is_ident_word(c, &w2[0], 12) { *out = AL_SPACE_AROUND; return true }
    var w3: [u8; 12] = "space-evenly"
    if is_ident_word(c, &w3[0], 12) { *out = AL_SPACE_EVENLY; return true }
    var w4: [u8; 6] = "normal"
    if is_ident_word(c, &w4[0], 6) { *out = AL_FLEX_START; return true }
    var w5: [u8; 7] = "stretch"
    if is_ident_word(c, &w5[0], 7) { *out = AL_FLEX_START; return true }
    return false
}

fn value_align_items(c: Gc[Cv], out: *mut u32) -> bool {
    if value_align_common(c, out) {
        return true
    }
    var w1: [u8; 7] = "stretch"
    if is_ident_word(c, &w1[0], 7) { *out = AL_STRETCH; return true }
    var w2: [u8; 8] = "baseline"
    if is_ident_word(c, &w2[0], 8) { *out = AL_BASELINE; return true }
    var w3: [u8; 6] = "normal"
    if is_ident_word(c, &w3[0], 6) { *out = AL_STRETCH; return true }
    return false
}

fn value_align_self(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 4] = "auto"
    if is_ident_word(c, &w1[0], 4) { *out = AL_AUTO; return true }
    return value_align_items(c, out)
}

fn value_align_content(c: Gc[Cv], out: *mut u32) -> bool {
    if value_align_common(c, out) {
        return true
    }
    var w1: [u8; 13] = "space-between"
    if is_ident_word(c, &w1[0], 13) { *out = AL_SPACE_BETWEEN; return true }
    var w2: [u8; 12] = "space-around"
    if is_ident_word(c, &w2[0], 12) { *out = AL_SPACE_AROUND; return true }
    var w3: [u8; 12] = "space-evenly"
    if is_ident_word(c, &w3[0], 12) { *out = AL_SPACE_EVENLY; return true }
    var w4: [u8; 7] = "stretch"
    if is_ident_word(c, &w4[0], 7) { *out = AL_STRETCH; return true }
    var w5: [u8; 6] = "normal"
    if is_ident_word(c, &w5[0], 6) { *out = AL_STRETCH; return true }
    var w6: [u8; 8] = "baseline"
    if is_ident_word(c, &w6[0], 8) { *out = AL_FLEX_START; return true }
    return false
}

// The initial UNIT of a length slot. The value is always 0.0; only the
// unit tells `auto` from `none` from `normal` from a real zero.
fn initial_unit(slot: usize) -> u32 {
    if slot == S_WIDTH || slot == S_HEIGHT {
        return U_AUTO
    }
    if slot == S_MAX_WIDTH || slot == S_MAX_HEIGHT {
        return U_NONE
    }
    if slot == S_MIN_WIDTH || slot == S_MIN_HEIGHT {
        return U_AUTO
    }
    if slot == S_TOP || slot == S_RIGHT || slot == S_BOTTOM || slot == S_LEFT {
        return U_AUTO
    }
    if slot == S_LINE_HEIGHT {
        return U_NORMAL
    }
    if slot == S_FLEX_BASIS {
        return U_AUTO
    }
    return U_PX
}

// Which slots accept the keyword `auto`. `min-width: auto` is CSS3 and
// means the automatic minimum size of a flex item; outside a flex
// container it is zero (see docs/ROUND61.md).
// The six slots a keyword size may stand in: the two sizes, the two
// minima and the two maxima. `flex-basis` takes them too (css-flexbox-1,
// 7.2.3) and is handled with them.
fn slot_takes_keyword_size(slot: usize) -> bool {
    return slot == S_WIDTH || slot == S_HEIGHT ||
    slot == S_MIN_WIDTH || slot == S_MAX_WIDTH ||
    slot == S_MIN_HEIGHT || slot == S_MAX_HEIGHT ||
    slot == S_FLEX_BASIS
}

fn keyword_size_unit(c: Gc[Cv], out: *mut u32) -> bool {
    var w1: [u8; 11] = "min-content"
    if is_ident_word(c, &w1[0], 11) {
        *out = U_MIN_CONTENT
        return true
    }
    var w2: [u8; 11] = "max-content"
    if is_ident_word(c, &w2[0], 11) {
        *out = U_MAX_CONTENT
        return true
    }
    var w3: [u8; 11] = "fit-content"
    if is_ident_word(c, &w3[0], 11) {
        *out = U_FIT_CONTENT
        return true
    }
    var w4: [u8; 7] = "stretch"
    if is_ident_word(c, &w4[0], 7) {
        *out = U_STRETCH
        return true
    }
    var w5: [u8; 22] = "-webkit-fill-available"
    if is_ident_word(c, &w5[0], 22) {
        *out = U_STRETCH
        return true
    }
    return false
}

fn slot_takes_auto(slot: usize) -> bool {
    if slot <= S_MARGIN_LEFT {
        return true
    }
    if slot == S_WIDTH || slot == S_HEIGHT {
        return true
    }
    if slot == S_MIN_WIDTH || slot == S_MIN_HEIGHT {
        return true
    }
    if slot == S_TOP || slot == S_RIGHT || slot == S_BOTTOM || slot == S_LEFT {
        return true
    }
    if slot == S_FLEX_BASIS {
        return true
    }
    return false
}

fn slot_takes_none(slot: usize) -> bool {
    return slot == S_MAX_WIDTH || slot == S_MAX_HEIGHT
}

// A negative padding, border width, size or line height is INVALID -- the
// declaration is dropped and the initial value stays. Only margins and the
// four offsets may go negative.
fn slot_allows_negative(slot: usize) -> bool {
    if slot <= S_MARGIN_LEFT {
        return true
    }
    if slot == S_TOP || slot == S_RIGHT || slot == S_BOTTOM || slot == S_LEFT {
        return true
    }
    return false
}

// ---------------------------------------------------------------- Colours

fn hex_value(c: u32) -> u32 {
    if c >= 48 as u32 && c <= 57 as u32 {
        return c - 48 as u32
    }
    if c >= 65 as u32 && c <= 70 as u32 {
        return c - 55 as u32
    }
    if c >= 97 as u32 && c <= 102 as u32 {
        return c - 87 as u32
    }
    return 16 as u32
}

fn parse_hex_color(k: Gc[Chain], out: *mut u32) -> bool {
    let n: u64 = node.chain_len(k)
    if n != 3 && n != 4 && n != 6 && n != 8 {
        return false
    }
    var d: [u32; 8] = [0; 8]
    var i: u64 = 0
    while i < n {
        let v: u32 = hex_value(node.chain_at(k, i))
        if v > 15 as u32 {
            return false
        }
        d[i as usize] = v
        i = i + 1
    }
    var r: u32 = 0
    var g: u32 = 0
    var b: u32 = 0
    var a: u32 = 255
    if n == 3 || n == 4 {
        r = d[0] * 17 as u32
        g = d[1] * 17 as u32
        b = d[2] * 17 as u32
        if n == 4 {
            a = d[3] * 17 as u32
        }
    } else {
        r = d[0] * 16 as u32 + d[1]
        g = d[2] * 16 as u32 + d[3]
        b = d[4] * 16 as u32 + d[5]
        if n == 8 {
            a = d[6] * 16 as u32 + d[7]
        }
    }
    *out = (a << 24) | (r << 16) | (g << 8) | b
    return true
}

fn named_color(c: Gc[Cv], out: *mut u32) -> bool {
    var n1: [u8; 5] = "black"
    if is_ident_word(c, &n1[0], 5) {
        *out = 0xFF000000
        return true
    }
    var n2: [u8; 6] = "silver"
    if is_ident_word(c, &n2[0], 6) {
        *out = 0xFFC0C0C0
        return true
    }
    var n3: [u8; 4] = "gray"
    if is_ident_word(c, &n3[0], 4) {
        *out = 0xFF808080
        return true
    }
    var n4: [u8; 5] = "white"
    if is_ident_word(c, &n4[0], 5) {
        *out = 0xFFFFFFFF
        return true
    }
    var n5: [u8; 6] = "maroon"
    if is_ident_word(c, &n5[0], 6) {
        *out = 0xFF800000
        return true
    }
    var n6: [u8; 3] = "red"
    if is_ident_word(c, &n6[0], 3) {
        *out = 0xFFFF0000
        return true
    }
    var n7: [u8; 6] = "purple"
    if is_ident_word(c, &n7[0], 6) {
        *out = 0xFF800080
        return true
    }
    var n8: [u8; 7] = "fuchsia"
    if is_ident_word(c, &n8[0], 7) {
        *out = 0xFFFF00FF
        return true
    }
    var n9: [u8; 5] = "green"
    if is_ident_word(c, &n9[0], 5) {
        *out = 0xFF008000
        return true
    }
    var n10: [u8; 4] = "lime"
    if is_ident_word(c, &n10[0], 4) {
        *out = 0xFF00FF00
        return true
    }
    var n11: [u8; 5] = "olive"
    if is_ident_word(c, &n11[0], 5) {
        *out = 0xFF808000
        return true
    }
    var n12: [u8; 6] = "yellow"
    if is_ident_word(c, &n12[0], 6) {
        *out = 0xFFFFFF00
        return true
    }
    var n13: [u8; 4] = "navy"
    if is_ident_word(c, &n13[0], 4) {
        *out = 0xFF000080
        return true
    }
    var n14: [u8; 4] = "blue"
    if is_ident_word(c, &n14[0], 4) {
        *out = 0xFF0000FF
        return true
    }
    var n15: [u8; 4] = "teal"
    if is_ident_word(c, &n15[0], 4) {
        *out = 0xFF008080
        return true
    }
    var n16: [u8; 4] = "aqua"
    if is_ident_word(c, &n16[0], 4) {
        *out = 0xFF00FFFF
        return true
    }
    var n17: [u8; 6] = "orange"
    if is_ident_word(c, &n17[0], 6) {
        *out = 0xFFFFA500
        return true
    }
    var n18: [u8; 11] = "transparent"
    if is_ident_word(c, &n18[0], 11) {
        *out = 0
        return true
    }
    return false
}

fn clamp255(v: f64) -> u32 {
    if v <= 0.0 {
        return 0
    }
    if v >= 255.0 {
        return 255
    }
    return (v + 0.5) as u32
}

// `rgb()` / `rgba()` with numbers or percentages.
fn parse_rgb_function(c: Gc[Cv], out: *mut u32) -> bool {
    var f1: [u8; 3] = "rgb"
    var f2: [u8; 4] = "rgba"
    if c.kind != cv.CV_FUNCTION {
        return false
    }
    if !node.chain_equal_ascii_small(c.text, &f1[0], 3) {
        if !node.chain_equal_ascii_small(c.text, &f2[0], 4) {
            return false
        }
    }
    var part: [f64; 4] = [0.0; 4]
    var found: usize = 0
    var i: u64 = 0
    let n: u64 = cv.cv_kids_count(c)
    while i < n {
        let v: Gc[Cv] = cv.cv_kid(c, i)
        if v.kind == tok.T_NUMBER {
            if found >= 4 {
                return false
            }
            part[found] = number_of(v)
            found = found + 1
        } else if v.kind == tok.T_PERCENTAGE {
            if found >= 4 {
                return false
            }
            part[found] = number_of(v) * 255.0 / 100.0
            found = found + 1
        } else if v.kind != tok.T_WHITESPACE && v.kind != tok.T_COMMA {
            var slash: [u8; 1] = "/"
            if v.kind != tok.T_DELIM || !node.chain_equal_ascii(v.text, &slash[0], 1) {
                return false
            }
        }
        i = i + 1
    }
    if found < 3 {
        return false
    }
    var a: u32 = 255
    if found == 4 {
        a = clamp255(part[3] * 255.0)
        // The fourth part came in as a number 0..1, not as 0..255.
        if part[3] <= 1.0 {
            a = clamp255(part[3] * 255.0)
        }
    }
    *out = (a << 24) | (clamp255(part[0]) << 16) | (clamp255(part[1]) << 8) |
    clamp255(part[2])
    return true
}

fn parse_color_value(c: Gc[Cv], out: *mut u32) -> bool {
    if c == gc_null[Cv]() {
        return false
    }
    if c.kind == tok.T_HASH {
        return parse_hex_color(c.text, out)
    }
    if c.kind == cv.CV_FUNCTION {
        return parse_rgb_function(c, out)
    }
    return named_color(c, out)
}

// ------------------------------------------------------ Applying the winners

fn font_size_keyword(c: Gc[Cv], out: *mut f64) -> bool {
    var w1: [u8; 8] = "xx-small"
    if is_ident_word(c, &w1[0], 8) {
        *out = 9.0
        return true
    }
    var w2: [u8; 7] = "x-small"
    if is_ident_word(c, &w2[0], 7) {
        *out = 10.0
        return true
    }
    var w3: [u8; 5] = "small"
    if is_ident_word(c, &w3[0], 5) {
        *out = 13.0
        return true
    }
    var w4: [u8; 6] = "medium"
    if is_ident_word(c, &w4[0], 6) {
        *out = 16.0
        return true
    }
    var w5: [u8; 5] = "large"
    if is_ident_word(c, &w5[0], 5) {
        *out = 18.0
        return true
    }
    var w6: [u8; 7] = "x-large"
    if is_ident_word(c, &w6[0], 7) {
        *out = 24.0
        return true
    }
    var w7: [u8; 8] = "xx-large"
    if is_ident_word(c, &w7[0], 8) {
        *out = 32.0
        return true
    }
    return false
}

fn first_value(d: Gc[Decl]) -> Gc[Cv] {
    return non_ws_at(d.value, 0)
}

fn compute_style(w: *mut Winner, parent: Gc[Style]) -> AllocError!Gc[Style] {
    let s = try style_initial()
    // 1. Inheritance: colour and font size come from the parent.
    s.font_size = parent.font_size
    s.color[0] = parent.color[0]
    let root_size: f64 = 16.0

    // 2. The font size first -- `em` of every other property depends on it.
    let fd: Gc[Decl] = (*w).best[P_FONT_SIZE as usize]
    if fd != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(fd)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.font_size = parent.font_size
        } else if kw == V_INITIAL {
            s.font_size = 16.0
        } else {
            var size: f64 = 0.0
            if font_size_keyword(v, &size) {
                s.font_size = size
            } else if v != gc_null[Cv]() && v.kind == tok.T_PERCENTAGE {
                s.font_size = parent.font_size * number_of(v) / 100.0
            } else {
                var value: f64 = 0.0
                var unit: u32 = U_PX
                // `em` refers to the PARENT here.
                if parse_length(v, parent.font_size, root_size, &value, &unit) {
                    if unit == U_PX {
                        s.font_size = value
                    }
                }
            }
        }
    }

    // 3. display
    let dd: Gc[Decl] = (*w).best[P_DISPLAY as usize]
    if dd != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(dd)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.display = parent.display
        } else if kw == V_INITIAL {
            s.display = D_INLINE
        } else {
            var d: u32 = D_INLINE
            if value_display(v, &d) {
                s.display = d
            }
        }
    }

    // 4. colour
    let cd: Gc[Decl] = (*w).best[P_COLOR as usize]
    if cd != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(cd)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.color[0] = parent.color[0]
        } else if kw == V_INITIAL {
            s.color[0] = 0xFF000000
        } else {
            var col: u32 = 0
            if parse_color_value(v, &col) {
                s.color[0] = col
            }
        }
    }

    // 5. the twenty-four lengths. `line-height` is INHERITED, so it takes
    // the parent value before the cascade can overwrite it.
    s.length[S_LINE_HEIGHT] = parent.length[S_LINE_HEIGHT]
    s.unit[S_LINE_HEIGHT] = parent.unit[S_LINE_HEIGHT]
    var p: u32 = P_MARGIN_TOP
    while p <= P_FLEX_BASIS {
        let slot: usize = (p - P_MARGIN_TOP) as usize
        let d: Gc[Decl] = (*w).best[p as usize]
        if d != gc_null[Decl]() {
            let v: Gc[Cv] = first_value(d)
            let kw: u32 = keyword_kind(v)
            if kw == V_INHERIT {
                s.length[slot] = parent.length[slot]
                s.unit[slot] = parent.unit[slot]
            } else if kw == V_INITIAL {
                s.length[slot] = 0.0
                s.unit[slot] = initial_unit(slot)
            } else {
                var auto: [u8; 4] = "auto"
                var normal: [u8; 6] = "normal"
                var content: [u8; 7] = "content"
                var value: f64 = 0.0
                var unit: u32 = U_PX
                if slot_takes_auto(slot) && is_ident_word(v, &auto[0], 4) {
                    s.length[slot] = 0.0
                    s.unit[slot] = U_AUTO
                } else if slot_takes_none(slot) && is_ident_none(v) {
                    s.length[slot] = 0.0
                    s.unit[slot] = U_NONE
                } else if slot_takes_keyword_size(slot) &&
                keyword_size_unit(v, &unit) {
                    s.length[slot] = 0.0
                    s.unit[slot] = unit
                } else if slot == S_FLEX_BASIS && is_ident_word(v, &content[0], 7) {
                    // `content` sizes from the content -- that is what
                    // `auto` does here too, so they fall together.
                    s.length[slot] = 0.0
                    s.unit[slot] = U_AUTO
                } else if slot == S_LINE_HEIGHT {
                    if is_ident_word(v, &normal[0], 6) {
                        s.length[slot] = 0.0
                        s.unit[slot] = U_NORMAL
                    } else if v != gc_null[Cv]() && v.kind == tok.T_NUMBER {
                        // A NUMBER stays a number: it is inherited as a
                        // factor and multiplies the font size of the CHILD,
                        // not of the element that carries it.
                        let f: f64 = number_of(v)
                        if f >= 0.0 {
                            s.length[slot] = f
                            s.unit[slot] = U_NUMBER
                        }
                    } else if parse_length(v, s.font_size, root_size, &value, &unit) {
                        if value >= 0.0 {
                            if unit == U_PERCENT {
                                // A percentage is resolved HERE, against
                                // the element's own font size, and is
                                // inherited as the resulting length.
                                s.length[slot] = value * s.font_size / 100.0
                                s.unit[slot] = U_PX
                            } else {
                                s.length[slot] = value
                                s.unit[slot] = unit
                            }
                        }
                    }
                } else if p >= P_BORDER_TOP_WIDTH && p <= P_BORDER_LEFT_WIDTH {
                    if parse_border_width(v, &value, &unit) {
                        s.length[slot] = scale_em(v, value, s.font_size, root_size)
                        s.unit[slot] = unit
                    }
                } else if parse_length(v, s.font_size, root_size, &value, &unit) {
                    if value >= 0.0 || slot_allows_negative(slot) {
                        s.length[slot] = value
                        s.unit[slot] = unit
                    }
                }
            }
        }
        p = p + 1 as u32
    }

    // 6. border style and colour
    var q: u32 = P_BORDER_TOP_STYLE
    while q <= P_BORDER_LEFT_STYLE {
        let slot: usize = (q - P_BORDER_TOP_STYLE) as usize
        let d: Gc[Decl] = (*w).best[q as usize]
        if d != gc_null[Decl]() {
            let v: Gc[Cv] = first_value(d)
            let kw: u32 = keyword_kind(v)
            if kw == V_INHERIT {
                s.bstyle[slot] = parent.bstyle[slot]
            } else if kw == V_INITIAL {
                s.bstyle[slot] = BS_NONE
            } else if is_ident_none(v) {
                s.bstyle[slot] = BS_NONE
            } else {
                let bs: u32 = value_border_style(v)
                if bs != BS_NONE {
                    s.bstyle[slot] = bs
                }
            }
        }
        q = q + 1 as u32
    }
    var c2: u32 = P_BORDER_TOP_COLOR
    while c2 <= P_BORDER_LEFT_COLOR {
        let slot: usize = (c2 - P_BORDER_TOP_COLOR) as usize + 1
        s.color[slot] = s.color[0]
        let d: Gc[Decl] = (*w).best[c2 as usize]
        if d != gc_null[Decl]() {
            let v: Gc[Cv] = first_value(d)
            let kw: u32 = keyword_kind(v)
            if kw == V_INHERIT {
                s.color[slot] = parent.color[slot]
            } else if kw == V_INITIAL {
                s.color[slot] = s.color[0]
            } else {
                var col: u32 = 0
                if parse_color_value(v, &col) {
                    s.color[slot] = col
                }
            }
        }
        c2 = c2 + 1 as u32
    }

    // 7. the keyword properties. `text-align` and `white-space` are
    // inherited, the other eight are not.
    s.text_align = parent.text_align
    s.white_space = parent.white_space

    let pos_d: Gc[Decl] = (*w).best[P_POSITION as usize]
    if pos_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(pos_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.position = parent.position
        } else if kw == V_INITIAL {
            s.position = POS_STATIC
        } else {
            var x: u32 = 0
            if value_position(v, &x) {
                s.position = x
            }
        }
    }
    let flt_d: Gc[Decl] = (*w).best[P_FLOAT as usize]
    if flt_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(flt_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.floated = parent.floated
        } else if kw == V_INITIAL {
            s.floated = FLOAT_NONE
        } else {
            var x: u32 = 0
            if value_float(v, &x) {
                s.floated = x
            }
        }
    }
    let clr_d: Gc[Decl] = (*w).best[P_CLEAR as usize]
    if clr_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(clr_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.clear = parent.clear
        } else if kw == V_INITIAL {
            s.clear = CLEAR_NONE
        } else {
            var x: u32 = 0
            if value_clear(v, &x) {
                s.clear = x
            }
        }
    }
    let bx_d: Gc[Decl] = (*w).best[P_BOX_SIZING as usize]
    if bx_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(bx_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.box_sizing = parent.box_sizing
        } else if kw == V_INITIAL {
            s.box_sizing = BOX_CONTENT
        } else {
            var x: u32 = 0
            if value_box_sizing(v, &x) {
                s.box_sizing = x
            }
        }
    }
    let ov_d: Gc[Decl] = (*w).best[P_OVERFLOW as usize]
    if ov_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(ov_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.overflow = parent.overflow
        } else if kw == V_INITIAL {
            s.overflow = OV_VISIBLE
        } else {
            var x: u32 = 0
            if value_overflow(v, &x) {
                s.overflow = x
            }
        }
    }
    let ta_d: Gc[Decl] = (*w).best[P_TEXT_ALIGN as usize]
    if ta_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(ta_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.text_align = parent.text_align
        } else if kw == V_INITIAL {
            s.text_align = TA_LEFT
        } else {
            var x: u32 = 0
            if value_text_align(v, &x) {
                s.text_align = x
            }
        }
    }
    let va_d: Gc[Decl] = (*w).best[P_VERTICAL_ALIGN as usize]
    if va_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(va_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.vertical_align = parent.vertical_align
        } else if kw == V_INITIAL {
            s.vertical_align = VA_BASELINE
        } else {
            var x: u32 = 0
            if value_vertical_align(v, &x) {
                s.vertical_align = x
            }
        }
    }
    let ws_d: Gc[Decl] = (*w).best[P_WHITE_SPACE as usize]
    if ws_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(ws_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.white_space = parent.white_space
        } else if kw == V_INITIAL {
            s.white_space = WS_NORMAL
        } else {
            var x: u32 = 0
            if value_white_space(v, &x) {
                s.white_space = x
            }
        }
    }
    let fd_d: Gc[Decl] = (*w).best[P_FLEX_DIRECTION as usize]
    if fd_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(fd_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.flex_direction = parent.flex_direction
        } else if kw == V_INITIAL {
            s.flex_direction = FD_ROW
        } else {
            var x: u32 = 0
            if value_flex_direction(v, &x) {
                s.flex_direction = x
            }
        }
    }
    let fw_d: Gc[Decl] = (*w).best[P_FLEX_WRAP as usize]
    if fw_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(fw_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.flex_wrap = parent.flex_wrap
        } else if kw == V_INITIAL {
            s.flex_wrap = FW_NOWRAP
        } else {
            var x: u32 = 0
            if value_flex_wrap(v, &x) {
                s.flex_wrap = x
            }
        }
    }

    // 8. the two flex factors -- plain numbers, never negative.
    let fg_d: Gc[Decl] = (*w).best[P_FLEX_GROW as usize]
    if fg_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(fg_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.flex_grow = parent.flex_grow
        } else if kw == V_INITIAL {
            s.flex_grow = 0.0
        } else if v != gc_null[Cv]() && v.kind == tok.T_NUMBER {
            let f: f64 = number_of(v)
            if f >= 0.0 {
                s.flex_grow = f
            }
        }
    }
    let fs_d: Gc[Decl] = (*w).best[P_FLEX_SHRINK as usize]
    if fs_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(fs_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.flex_shrink = parent.flex_shrink
        } else if kw == V_INITIAL {
            s.flex_shrink = 1.0
        } else if v != gc_null[Cv]() && v.kind == tok.T_NUMBER {
            let f: f64 = number_of(v)
            if f >= 0.0 {
                s.flex_shrink = f
            }
        }
    }

    // 9. `z-index` and `order` -- two integers, and `z-index` also has
    // the keyword `auto`, which is NOT the number zero.
    let zi_d: Gc[Decl] = (*w).best[P_Z_INDEX as usize]
    if zi_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(zi_d)
        let kw: u32 = keyword_kind(v)
        var auto_w: [u8; 4] = "auto"
        if kw == V_INHERIT {
            s.z_index = parent.z_index
            s.z_auto = parent.z_auto
        } else if kw == V_INITIAL || is_ident_word(v, &auto_w[0], 4) {
            s.z_index = 0.0
            s.z_auto = Z_AUTO_YES
        } else if v != gc_null[Cv]() && v.kind == tok.T_NUMBER {
            s.z_index = trunc_to_integer(number_of(v))
            s.z_auto = Z_AUTO_NO
        }
    }
    let or_d: Gc[Decl] = (*w).best[P_ORDER as usize]
    if or_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(or_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.order = parent.order
        } else if kw == V_INITIAL {
            s.order = 0.0
        } else if v != gc_null[Cv]() && v.kind == tok.T_NUMBER {
            s.order = trunc_to_integer(number_of(v))
        }
    }

    // 10. the four alignment properties.
    let jc_d: Gc[Decl] = (*w).best[P_JUSTIFY_CONTENT as usize]
    if jc_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(jc_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.justify_content = parent.justify_content
        } else if kw == V_INITIAL {
            s.justify_content = AL_FLEX_START
        } else {
            var x: u32 = 0
            if value_justify_content(v, &x) {
                s.justify_content = x
            }
        }
    }
    let ai_d: Gc[Decl] = (*w).best[P_ALIGN_ITEMS as usize]
    if ai_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(ai_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.align_items = parent.align_items
        } else if kw == V_INITIAL {
            s.align_items = AL_STRETCH
        } else {
            var x: u32 = 0
            if value_align_items(v, &x) {
                s.align_items = x
            }
        }
    }
    let as_d: Gc[Decl] = (*w).best[P_ALIGN_SELF as usize]
    if as_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(as_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.align_self = parent.align_self
        } else if kw == V_INITIAL {
            s.align_self = AL_AUTO
        } else {
            var x: u32 = 0
            if value_align_self(v, &x) {
                s.align_self = x
            }
        }
    }
    let ac_d: Gc[Decl] = (*w).best[P_ALIGN_CONTENT as usize]
    if ac_d != gc_null[Decl]() {
        let v: Gc[Cv] = first_value(ac_d)
        let kw: u32 = keyword_kind(v)
        if kw == V_INHERIT {
            s.align_content = parent.align_content
        } else if kw == V_INITIAL {
            s.align_content = AL_STRETCH
        } else {
            var x: u32 = 0
            if value_align_content(v, &x) {
                s.align_content = x
            }
        }
    }
    return s
}

// `z-index: 2.7` is not valid CSS, but a number with a fraction reaches
// this point through the generic number parser. Cutting towards zero is
// what a browser does with it, and it keeps the value an INTEGER -- on
// which the whole ordering of stacking contexts rests.
fn trunc_to_integer(v: f64) -> f64 {
    if v > 1000000000.0 {
        return 1000000000.0
    }
    if v < 0.0 - 1000000000.0 {
        return 0.0 - 1000000000.0
    }
    return (v as i64) as f64
}

// A border width in `em` was computed against 16 px in parse_border_width
// (it does not know the font size). Here it is put right.
fn scale_em(v: Gc[Cv], value: f64, font_size: f64, root_size: f64) -> f64 {
    if v == gc_null[Cv]() || v.kind != tok.T_DIMENSION {
        return value
    }
    var ok: bool = false
    let f: f64 = unit_factor(v, font_size, root_size, &ok)
    if !ok {
        return value
    }
    return number_of(v) * f
}
