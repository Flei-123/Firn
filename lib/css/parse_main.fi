// SPDX-License-Identifier: GPL-2.0-only
// lib/css/parse_main.fi -- the driver of the CSS parser (root file).
//
// It reads a stream of JOBS from standard input and writes ONE line of
// JSON per job onto standard output -- in the representation of
// css-parsing-tests (testdata/css-parsing-tests/README.rst).
//
// The job format (little-endian, see tools/css/LOG.md):
//     u32  mode
//     u32  n1 ; u8[n1]   the input (WTF-8), or the raw bytes for mode 10
//     u32  n2 ; u8[n2]   the protocol encoding label (mode 10), else empty
//     u32  n3 ; u8[n3]   the environment encoding label (mode 10), else empty
// The end of the stream = the end of the input.
//
// The modes, one per file of the official suite:
//     1  parse a list of component values   component_value_list.json
//     2  parse a component value            one_component_value.json
//     3  parse a list of declarations       declaration_list.json
//     4  parse a block's contents           blocks_contents.json
//     5  parse a declaration                one_declaration.json
//     6  parse a rule                       one_rule.json
//     7  parse a list of rules              rule_list.json
//     8  parse a stylesheet                 stylesheet.json
//     9  parse An+B                         An+B.json
//    10  parse a stylesheet from bytes      stylesheet_bytes.json
//
// Compile with:  firnc -o build/cssparse lib/css/parse_main.fi
import html.mem
import browser.node
import css.tok
import css.cv
import css.write
import css.anb
import css.decode

#[no_gc]
fn read_u32(b: *mut mem.Buf, off: usize) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < 4 {
        v = v | ((mem.buf_at(b, off + i) as u32) << (8 * i as u32))
        i = i + 1
    }
    return v
}

#[no_gc]
fn byte_at(base: u64, total: usize, k: usize) -> u32 {
    if k >= total {
        return 0 as u32
    }
    return (*((base + k as u64) as *mut u8)) as u32
}

// WTF-8 -> code points. Unpaired surrogates are preserved, so that a
// stylesheet coming out of the HTML parser is not silently changed.
#[no_gc]
fn decode_wtf8(b: *mut mem.Buf, off: usize, len: usize, out: *mut mem.CpBuf) {
    mem.cp_clear(out)
    let base: u64 = mem.buf_ptr(b) as u64
    let total: usize = mem.buf_len(b)
    var i: usize = 0
    while i < len {
        let c0: u32 = byte_at(base, total, off + i)
        if c0 < 0x80 as u32 {
            mem.cp_push(out, c0)
            i = i + 1
        } else if c0 >= 0xF0 as u32 {
            mem.cp_push(out, ((c0 & 0x07 as u32) << 18) |
                ((byte_at(base, total, off + i + 1) & 0x3F as u32) << 12) |
                ((byte_at(base, total, off + i + 2) & 0x3F as u32) << 6) |
                (byte_at(base, total, off + i + 3) & 0x3F as u32))
            i = i + 4
        } else if c0 >= 0xE0 as u32 {
            mem.cp_push(out, ((c0 & 0x0F as u32) << 12) |
                ((byte_at(base, total, off + i + 1) & 0x3F as u32) << 6) |
                (byte_at(base, total, off + i + 2) & 0x3F as u32))
            i = i + 3
        } else {
            mem.cp_push(out, ((c0 & 0x1F as u32) << 6) |
                (byte_at(base, total, off + i + 1) & 0x3F as u32))
            i = i + 2
        }
    }
}

fn run_mode(mode: u32, t: *mut tok.Tokens, out: *mut mem.Buf) -> AllocError!bool {
    var p: cv.Parser = cv.parser_new(t)
    if mode == 1 as u32 {
        let r = try cv.parse_component_value_list(&p)
        write.write_result(out, r, true)
        return true
    }
    if mode == 2 as u32 {
        let r = try cv.parse_one_component_value(&p)
        write.write_result(out, r, false)
        return true
    }
    if mode == 3 as u32 {
        let r = try cv.parse_declaration_list(&p)
        write.write_result(out, r, true)
        return true
    }
    if mode == 4 as u32 {
        let r = try cv.parse_block_contents(&p)
        write.write_result(out, r, true)
        return true
    }
    if mode == 5 as u32 {
        let r = try cv.parse_one_declaration(&p)
        write.write_result(out, r, false)
        return true
    }
    if mode == 6 as u32 {
        let r = try cv.parse_one_rule(&p)
        write.write_result(out, r, false)
        return true
    }
    if mode == 7 as u32 {
        let r = try cv.parse_rule_list(&p)
        write.write_result(out, r, true)
        return true
    }
    let r = try cv.parse_stylesheet(&p)
    write.write_result(out, r, true)
    return true
}

#[no_gc]
fn out_i64(out: *mut mem.Buf, v: i64) {
    if v < 0 {
        mem.buf_push(out, 45 as u8)
        mem.buf_push_dec(out, (0 - v) as u64)
    } else {
        mem.buf_push_dec(out, v as u64)
    }
}

#[no_gc]
fn run_anb(t: *mut tok.Tokens, out: *mut mem.Buf) {
    var a: anb.Anb = anb.anb_new()
    if !anb.anb_parse(t, &a) {
        var w: [u8; 4] = "null"
        var i: usize = 0
        while i < 4 {
            mem.buf_push(out, w[i])
            i = i + 1
        }
        mem.buf_push(out, 10 as u8)
        return
    }
    mem.buf_push(out, 91 as u8)
    out_i64(out, a.a)
    mem.buf_push(out, 44 as u8)
    mem.buf_push(out, 32 as u8)
    out_i64(out, a.b)
    mem.buf_push(out, 93 as u8)
    mem.buf_push(out, 10 as u8)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    var ins: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&ins)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var text: mem.CpBuf = mem.cp_new()

    let total: usize = mem.buf_len(&ins)
    let base: u64 = mem.buf_ptr(&ins) as u64
    var off: usize = 0
    while off + 16 <= total {
        let mode: u32 = read_u32(&ins, off)
        let n1: usize = read_u32(&ins, off + 4) as usize
        let o1: usize = off + 8
        let n2: usize = read_u32(&ins, o1 + n1) as usize
        let o2: usize = o1 + n1 + 4
        let n3: usize = read_u32(&ins, o2 + n2) as usize
        let o3: usize = o2 + n2 + 4
        off = o3 + n3

        var enc: u32 = decode.ENC_UTF8
        if mode == 10 as u32 {
            var proto: u32 = decode.ENC_NONE
            var env: u32 = decode.ENC_NONE
            if n2 > 0 {
                proto = decode.encoding_from_label(base + o2 as u64, n2)
            }
            if n3 > 0 {
                env = decode.encoding_from_label(base + o3 as u64, n3)
            }
            enc = decode.decode_stylesheet(base + o1 as u64, n1, proto, env, &text)
        } else {
            decode_wtf8(&ins, o1, n1, &text)
        }
        tok.tokenize(&t, &text)

        if mode == 9 as u32 {
            run_anb(&t, &out)
        } else if mode == 10 as u32 {
            mem.buf_push(&out, 91 as u8)
            var p: cv.Parser = cv.parser_new(&t)
            let r = cv.parse_stylesheet(&p) catch gc_null[Cv]()
            write.write_value_list(&out, r)
            mem.buf_push(&out, 44 as u8)
            mem.buf_push(&out, 32 as u8)
            mem.buf_push(&out, 34 as u8)
            var k: usize = 0
            while k < decode.encoding_name_length(enc) {
                mem.buf_push(&out, decode.encoding_name_at(enc, k) as u8)
                k = k + 1
            }
            mem.buf_push(&out, 34 as u8)
            mem.buf_push(&out, 93 as u8)
            mem.buf_push(&out, 10 as u8)
        } else {
            let ok: bool = run_mode(mode, &t, &out) catch false
            if !ok {
                var w: [u8; 8] = "#BROKEN\n"
                var i: usize = 0
                while i < 8 {
                    mem.buf_push(&out, w[i])
                    i = i + 1
                }
            }
        }
        if mem.buf_len(&out) > 65536 {
            mem.buf_flush(&out, 1)
        }
    }
    mem.buf_flush(&out, 1)
    return 0
}
