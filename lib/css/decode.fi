// SPDX-License-Identifier: GPL-2.0-only
// lib/css/decode.fi -- the INPUT BYTE STREAM of a stylesheet (css-syntax-3 3.2).
//
// A stylesheet arrives as BYTES, not as code points, and which encoding
// they are in is decided by four sources in a fixed order:
//
//   1. the protocol encoding (an HTTP header, for example)
//   2. a byte order mark at the start of the file
//   3. an `@charset "..."` rule -- recognized on the BYTES, exactly the
//      sequence `@charset "` ... `";`, so two spaces or single quotes make
//      it not a charset rule at all
//   4. the environment encoding (the encoding of the linking document)
//   5. otherwise UTF-8
//
// and a BOM present in the stream beats every one of them, because the
// decoding step looks at it again.
//
// SUPPORTED ENCODINGS: UTF-8, UTF-16LE, UTF-16BE, ISO-8859-2 and
// ISO-8859-5. That is exactly what the official test file
// stylesheet_bytes.json needs. The complete label table of the WHATWG
// Encoding Standard has about forty encodings; whatever is not in the list
// here counts as an unknown label -- which is a defined case (the next
// source in the order decides) and not a silent guess.
import html.mem
import css.encoding_data

export {
    ENC_NONE, ENC_UTF8, ENC_UTF16LE, ENC_UTF16BE, ENC_ISO_8859_2, ENC_ISO_8859_5,
    encoding_from_label, decode_stylesheet, encoding_name_length, encoding_name_at,
}

const ENC_NONE: u32 = 0
const ENC_UTF8: u32 = 1
const ENC_UTF16LE: u32 = 2
const ENC_UTF16BE: u32 = 3
const ENC_ISO_8859_2: u32 = 4
const ENC_ISO_8859_5: u32 = 5

#[no_gc]
fn byte_at(p: u64, n: usize, i: usize) -> u32 {
    if i >= n {
        return 0xFFFFFFFF as u32
    }
    return (*((p + i as u64) as *mut u8)) as u32
}

#[no_gc]
fn lower(c: u32) -> u32 {
    if c >= 65 as u32 && c <= 90 as u32 {
        return c + 32 as u32
    }
    return c
}

#[no_gc]
fn is_space(c: u32) -> bool {
    return c == 9 as u32 || c == 10 as u32 || c == 12 as u32 || c == 13 as u32 || c == 32 as u32
}

// Compares the label range [from, to) at `p` with an ASCII literal,
// case insensitively.
#[no_gc]
fn label_is(p: u64, from: usize, to: usize, lit: u64, n: usize) -> bool {
    if to - from != n {
        return false
    }
    var i: usize = 0
    while i < n {
        if lower(byte_at(p, to, from + i)) != (*((lit + i as u64) as *mut u8)) as u32 {
            return false
        }
        i = i + 1
    }
    return true
}

// "get an encoding" of the Encoding Standard, restricted to the five
// encodings this file knows.
#[no_gc]
fn encoding_from_label(p: u64, n: usize) -> u32 {
    var from: usize = 0
    var to: usize = n
    while from < to && is_space(byte_at(p, n, from)) {
        from = from + 1
    }
    while to > from && is_space(byte_at(p, n, to - 1)) {
        to = to - 1
    }
    if to == from {
        return ENC_NONE
    }
    var l1: [u8; 5] = "utf-8"
    var l2: [u8; 4] = "utf8"
    var l3: [u8; 17] = "unicode-1-1-utf-8"
    var l4: [u8; 13] = "unicode11utf8"
    var l5: [u8; 13] = "unicode20utf8"
    var l6: [u8; 15] = "x-unicode20utf8"
    if label_is(p, from, to, (&l1[0]) as u64, 5) { return ENC_UTF8 }
    if label_is(p, from, to, (&l2[0]) as u64, 4) { return ENC_UTF8 }
    if label_is(p, from, to, (&l3[0]) as u64, 17) { return ENC_UTF8 }
    if label_is(p, from, to, (&l4[0]) as u64, 13) { return ENC_UTF8 }
    if label_is(p, from, to, (&l5[0]) as u64, 13) { return ENC_UTF8 }
    if label_is(p, from, to, (&l6[0]) as u64, 15) { return ENC_UTF8 }
    var b1: [u8; 8] = "utf-16be"
    var b2: [u8; 11] = "unicodefffe"
    if label_is(p, from, to, (&b1[0]) as u64, 8) { return ENC_UTF16BE }
    if label_is(p, from, to, (&b2[0]) as u64, 11) { return ENC_UTF16BE }
    var e1: [u8; 8] = "utf-16le"
    var e2: [u8; 6] = "utf-16"
    var e3: [u8; 9] = "csunicode"
    var e4: [u8; 15] = "iso-10646-ucs-2"
    var e5: [u8; 5] = "ucs-2"
    var e6: [u8; 7] = "unicode"
    var e7: [u8; 11] = "unicodefeff"
    if label_is(p, from, to, (&e1[0]) as u64, 8) { return ENC_UTF16LE }
    if label_is(p, from, to, (&e2[0]) as u64, 6) { return ENC_UTF16LE }
    if label_is(p, from, to, (&e3[0]) as u64, 9) { return ENC_UTF16LE }
    if label_is(p, from, to, (&e4[0]) as u64, 15) { return ENC_UTF16LE }
    if label_is(p, from, to, (&e5[0]) as u64, 5) { return ENC_UTF16LE }
    if label_is(p, from, to, (&e6[0]) as u64, 7) { return ENC_UTF16LE }
    if label_is(p, from, to, (&e7[0]) as u64, 11) { return ENC_UTF16LE }
    var t1: [u8; 10] = "iso-8859-2"
    var t2: [u8; 9] = "iso8859-2"
    var t3: [u8; 8] = "iso88592"
    var t4: [u8; 10] = "iso_8859-2"
    var t5: [u8; 15] = "iso_8859-2:1987"
    var t6: [u8; 10] = "iso-ir-101"
    var t7: [u8; 11] = "csisolatin2"
    var t8: [u8; 6] = "latin2"
    var t9: [u8; 2] = "l2"
    if label_is(p, from, to, (&t1[0]) as u64, 10) { return ENC_ISO_8859_2 }
    if label_is(p, from, to, (&t2[0]) as u64, 9) { return ENC_ISO_8859_2 }
    if label_is(p, from, to, (&t3[0]) as u64, 8) { return ENC_ISO_8859_2 }
    if label_is(p, from, to, (&t4[0]) as u64, 10) { return ENC_ISO_8859_2 }
    if label_is(p, from, to, (&t5[0]) as u64, 15) { return ENC_ISO_8859_2 }
    if label_is(p, from, to, (&t6[0]) as u64, 10) { return ENC_ISO_8859_2 }
    if label_is(p, from, to, (&t7[0]) as u64, 11) { return ENC_ISO_8859_2 }
    if label_is(p, from, to, (&t8[0]) as u64, 6) { return ENC_ISO_8859_2 }
    if label_is(p, from, to, (&t9[0]) as u64, 2) { return ENC_ISO_8859_2 }
    var c1: [u8; 10] = "iso-8859-5"
    var c2: [u8; 9] = "iso8859-5"
    var c3: [u8; 8] = "iso88595"
    var c4: [u8; 10] = "iso_8859-5"
    var c5: [u8; 15] = "iso_8859-5:1988"
    var c6: [u8; 10] = "iso-ir-144"
    var c7: [u8; 18] = "csisolatincyrillic"
    var c8: [u8; 8] = "cyrillic"
    if label_is(p, from, to, (&c1[0]) as u64, 10) { return ENC_ISO_8859_5 }
    if label_is(p, from, to, (&c2[0]) as u64, 9) { return ENC_ISO_8859_5 }
    if label_is(p, from, to, (&c3[0]) as u64, 8) { return ENC_ISO_8859_5 }
    if label_is(p, from, to, (&c4[0]) as u64, 10) { return ENC_ISO_8859_5 }
    if label_is(p, from, to, (&c5[0]) as u64, 15) { return ENC_ISO_8859_5 }
    if label_is(p, from, to, (&c6[0]) as u64, 10) { return ENC_ISO_8859_5 }
    if label_is(p, from, to, (&c7[0]) as u64, 18) { return ENC_ISO_8859_5 }
    if label_is(p, from, to, (&c8[0]) as u64, 8) { return ENC_ISO_8859_5 }
    return ENC_NONE
}

// The `@charset "..."` rule, read off the BYTES.
#[no_gc]
fn charset_encoding(p: u64, n: usize) -> u32 {
    var head: [u8; 10] = "@charset \""
    var i: usize = 0
    while i < 10 {
        if byte_at(p, n, i) != (head[i]) as u32 {
            return ENC_NONE
        }
        i = i + 1
    }
    var k: usize = 10
    while k < n && k < 1034 {
        if byte_at(p, n, k) == 34 as u32 {
            if byte_at(p, n, k + 1) != 59 as u32 {
                return ENC_NONE
            }
            let id: u32 = encoding_from_label(p + 10, k - 10)
            // UTF-16 named inside the file is impossible -- the rule
            // itself would not be readable then. The standard says: use
            // UTF-8 instead.
            if id == ENC_UTF16LE || id == ENC_UTF16BE {
                return ENC_UTF8
            }
            return id
        }
        k = k + 1
    }
    return ENC_NONE
}

// -------------------------------------------------------------- Decoding

#[no_gc]
fn decode_utf8(p: u64, n: usize, from: usize, out: *mut mem.CpBuf) {
    var i: usize = from
    while i < n {
        let c0: u32 = byte_at(p, n, i)
        if c0 < 0x80 as u32 {
            mem.cp_push(out, c0)
            i = i + 1
        } else if c0 >= 0xC2 as u32 && c0 <= 0xDF as u32 {
            let c1: u32 = byte_at(p, n, i + 1)
            if c1 >= 0x80 as u32 && c1 <= 0xBF as u32 {
                mem.cp_push(out, ((c0 & 0x1F as u32) << 6) | (c1 & 0x3F as u32))
                i = i + 2
            } else {
                mem.cp_push(out, 0xFFFD as u32)
                i = i + 1
            }
        } else if c0 >= 0xE0 as u32 && c0 <= 0xEF as u32 {
            let c1: u32 = byte_at(p, n, i + 1)
            let c2: u32 = byte_at(p, n, i + 2)
            var lo: u32 = 0x80 as u32
            var hi: u32 = 0xBF as u32
            if c0 == 0xE0 as u32 {
                lo = 0xA0 as u32
            }
            if c0 == 0xED as u32 {
                hi = 0x9F as u32
            }
            if c1 >= lo && c1 <= hi && c2 >= 0x80 as u32 && c2 <= 0xBF as u32 {
                mem.cp_push(out, ((c0 & 0x0F as u32) << 12) | ((c1 & 0x3F as u32) << 6) |
                    (c2 & 0x3F as u32))
                i = i + 3
            } else {
                mem.cp_push(out, 0xFFFD as u32)
                i = i + 1
            }
        } else if c0 >= 0xF0 as u32 && c0 <= 0xF4 as u32 {
            let c1: u32 = byte_at(p, n, i + 1)
            let c2: u32 = byte_at(p, n, i + 2)
            let c3: u32 = byte_at(p, n, i + 3)
            var lo2: u32 = 0x80 as u32
            var hi2: u32 = 0xBF as u32
            if c0 == 0xF0 as u32 {
                lo2 = 0x90 as u32
            }
            if c0 == 0xF4 as u32 {
                hi2 = 0x8F as u32
            }
            if c1 >= lo2 && c1 <= hi2 && c2 >= 0x80 as u32 && c2 <= 0xBF as u32 &&
            c3 >= 0x80 as u32 && c3 <= 0xBF as u32 {
                mem.cp_push(out, ((c0 & 0x07 as u32) << 18) | ((c1 & 0x3F as u32) << 12) |
                    ((c2 & 0x3F as u32) << 6) | (c3 & 0x3F as u32))
                i = i + 4
            } else {
                mem.cp_push(out, 0xFFFD as u32)
                i = i + 1
            }
        } else {
            mem.cp_push(out, 0xFFFD as u32)
            i = i + 1
        }
    }
}

#[no_gc]
fn decode_utf16(p: u64, n: usize, from: usize, big: bool, out: *mut mem.CpBuf) {
    var i: usize = from
    while i + 1 < n {
        var u: u32 = 0
        if big {
            u = byte_at(p, n, i) * 256 as u32 + byte_at(p, n, i + 1)
        } else {
            u = byte_at(p, n, i + 1) * 256 as u32 + byte_at(p, n, i)
        }
        i = i + 2
        if u >= 0xD800 as u32 && u <= 0xDBFF as u32 && i + 1 < n {
            var v: u32 = 0
            if big {
                v = byte_at(p, n, i) * 256 as u32 + byte_at(p, n, i + 1)
            } else {
                v = byte_at(p, n, i + 1) * 256 as u32 + byte_at(p, n, i)
            }
            if v >= 0xDC00 as u32 && v <= 0xDFFF as u32 {
                i = i + 2
                mem.cp_push(out, 0x10000 as u32 + ((u - 0xD800 as u32) << 10)
                    +(v - 0xDC00 as u32))
            } else {
                mem.cp_push(out, 0xFFFD as u32)
            }
        } else if u >= 0xD800 as u32 && u <= 0xDFFF as u32 {
            mem.cp_push(out, 0xFFFD as u32)
        } else {
            mem.cp_push(out, u)
        }
    }
    if i < n {
        mem.cp_push(out, 0xFFFD as u32)
    }
}

#[no_gc]
fn decode_single(p: u64, n: usize, from: usize, id: u32, out: *mut mem.CpBuf) {
    var i: usize = from
    while i < n {
        let b: u32 = byte_at(p, n, i)
        if id == ENC_ISO_8859_2 {
            mem.cp_push(out, encoding_data.iso_8859_2(b))
        } else {
            mem.cp_push(out, encoding_data.iso_8859_5(b))
        }
        i = i + 1
    }
}

// Decodes `n` bytes at `p` into `out` and returns the encoding really used.
// `proto` and `env` are already resolved encoding ids (ENC_NONE = absent).
#[no_gc]
fn decode_stylesheet(p: u64, n: usize, proto: u32, env: u32, out: *mut mem.CpBuf) -> u32 {
    mem.cp_clear(out)
    var fallback: u32 = ENC_NONE
    if proto != ENC_NONE {
        fallback = proto
    }
    if fallback == ENC_NONE {
        let cs: u32 = charset_encoding(p, n)
        if cs != ENC_NONE {
            fallback = cs
        }
    }
    if fallback == ENC_NONE && env != ENC_NONE {
        fallback = env
    }
    if fallback == ENC_NONE {
        fallback = ENC_UTF8
    }
    // The byte order mark decides on its own -- it beats every source above.
    var id: u32 = fallback
    var from: usize = 0
    if n >= 3 && byte_at(p, n, 0) == 0xEF as u32 && byte_at(p, n, 1) == 0xBB as u32 &&
    byte_at(p, n, 2) == 0xBF as u32 {
        id = ENC_UTF8
        from = 3
    } else if n >= 2 && byte_at(p, n, 0) == 0xFE as u32 && byte_at(p, n, 1) == 0xFF as u32 {
        id = ENC_UTF16BE
        from = 2
    } else if n >= 2 && byte_at(p, n, 0) == 0xFF as u32 && byte_at(p, n, 1) == 0xFE as u32 {
        id = ENC_UTF16LE
        from = 2
    }
    if id == ENC_UTF16LE {
        decode_utf16(p, n, from, false, out)
    } else if id == ENC_UTF16BE {
        decode_utf16(p, n, from, true, out)
    } else if id == ENC_ISO_8859_2 || id == ENC_ISO_8859_5 {
        decode_single(p, n, from, id, out)
    } else {
        decode_utf8(p, n, from, out)
    }
    return id
}

// The name of an encoding, for the output. Byte by byte, so that no
// string type is needed here.
#[no_gc]
fn encoding_name_length(id: u32) -> usize {
    if id == ENC_UTF16LE {
        return 8
    }
    if id == ENC_UTF16BE {
        return 8
    }
    if id == ENC_ISO_8859_2 {
        return 10
    }
    if id == ENC_ISO_8859_5 {
        return 10
    }
    return 5
}

#[no_gc]
fn encoding_name_at(id: u32, i: usize) -> u32 {
    var n1: [u8; 5] = "utf-8"
    var n2: [u8; 8] = "utf-16le"
    var n3: [u8; 8] = "utf-16be"
    var n4: [u8; 10] = "iso-8859-2"
    var n5: [u8; 10] = "iso-8859-5"
    if id == ENC_UTF16LE {
        return n2[i] as u32
    }
    if id == ENC_UTF16BE {
        return n3[i] as u32
    }
    if id == ENC_ISO_8859_2 {
        return n4[i] as u32
    }
    if id == ENC_ISO_8859_5 {
        return n5[i] as u32
    }
    return n1[i] as u32
}
