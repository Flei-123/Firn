// SPDX-License-Identifier: GPL-2.0-only
// lib/css/soak_style.fi -- THE ENDURANCE RUN of the CSS path.
//
// Every round builds the WHOLE chain out of one document and one
// stylesheet: DOM, token stream, component values, rules, selectors, the
// style table as a `GcMap` from node to `Style`. Then everything is
// dropped. The memory consumption has to stay FLAT.
//
// Why this is the honest test: the parse tree of a stylesheet is full of
// references in both directions in the same way the DOM is (a rule holds
// its selectors and its declarations, the declaration holds its component
// values, the style table holds the NODES as keys and the styles as
// values). A reference count would keep the table alive as long as any
// node of it is alive. Whatever is not collected here leaks in an engine.
//
// The input (stdin, 12 bytes): u32 rounds, u32 budget_ms, u32 leak.
//
// `leak != 0` turns the COUNTER CHECK on: every style table built is held
// onto in a GC chain. Then the consumption MUST rise -- a measurement that
// cannot show a leak is worthless, which is why tools/css/gc_style.sh
// aborts when the counter check stays green.
//
// The output: TSV on stdout, one line per SAMPLE rounds:
//     t_ms  rounds  styles  rss_kib  live  runs  heap_bytes  pause_max_ns
import html.mem
import browser.node
import browser.names
import browser.driver
import css.tok
import css.cv
import css.sel
import css.cascade
import dom.meas

const DEFAULT_ROUNDS: u64 = 20000
const DEFAULT_BUDGET_MS: i64 = 10000
const SAMPLE: u64 = 200
const SOURCE_LEN: usize = 387
const SHEET_LEN: usize = 301

// The document of each round. Deliberately with everything the matcher has
// to walk over: nesting, siblings, lists, a table, classes and ids.
#[no_gc]
fn source(out: *mut mem.Buf) {
    var t: [u8; 387] = "<!DOCTYPE html><html><head><title>soak</title></head><body id=\"top\" class=\"page main\"><div class=\"box\"><h1 id=\"head\">Title</h1><p class=\"lead\">first</p><p>second <a href=\"https://example.com/x.html\" title=\"t\">link</a></p></div><ul class=\"nav\"><li>a</li><li class=\"sel\">b</li><li>c</li><li>d</li></ul><table><tr><td>1</td><td>2</td></tr><tr><td>3</td><td>4</td></tr></table></body></html>"
    mem.buf_clear(out)
    var i: usize = 0
    while i < SOURCE_LEN {
        mem.buf_push(out, t[i])
        i = i + 1
    }
}

// The stylesheet of each round: every kind of selector, three origins in
// one file, shorthands, `!important` and a deliberately broken rule.
#[no_gc]
fn sheet(out: *mut mem.CpBuf) {
    var t: [u8; 301] = "html{font-size:16px}body{display:block;margin:8px;color:#333}.box p{color:red;font-size:120%}#head{font-size:2em;margin:0.5em 0}ul.nav li:nth-child(2n){color:blue}li:not(.sel){padding:2px 4px}a[href^=\"https\"]{color:green;border:1px solid #00f}td:last-child{margin-right:1px}p:hover{color:teal}%%%{x:1}"
    mem.cp_clear(out)
    var i: usize = 0
    while i < SHEET_LEN {
        mem.cp_push(out, t[i] as u32)
        i = i + 1
    }
}

// Holds a style table fast -- for the counter check only.
gc class Holder {
    table: Gc[GcMap],
    next: Gc[Holder],
}

fn scrub_deep(n: u64) {
    var buffer: [u64; 512] = [0; 512]
    var i: usize = 0
    while i < 512 {
        buffer[i] = 0
        i = i + 1
    }
    barrier(&buffer)
    if n > 0 {
        scrub_deep(n - 1)
    }
}

fn line(t_ms: u64, rounds: u64, styles: u64, rss: u64, live: u64,
    runs: u64, heap: u64, pause: u64) {
    meas.meas_u64(t_ms)
    meas.meas_tab()
    meas.meas_u64(rounds)
    meas.meas_tab()
    meas.meas_u64(styles)
    meas.meas_tab()
    meas.meas_u64(rss)
    meas.meas_tab()
    meas.meas_u64(live)
    meas.meas_tab()
    meas.meas_u64(runs)
    meas.meas_tab()
    meas.meas_u64(heap)
    meas.meas_tab()
    meas.meas_u64(pause)
    meas.meas_nl()
}

fn text_out(p: u64, n: i64) {
    meas.meas_write(p, n)
}

fn next_in_order(k: Gc[Node], root: Gc[Node]) -> Gc[Node] {
    if k.first_child != gc_null[Node]() {
        return k.first_child
    }
    var c: Gc[Node] = k
    while c != gc_null[Node]() && c != root {
        if c.next != gc_null[Node]() {
            return c.next
        }
        c = c.parent
    }
    return gc_null[Node]()
}

// One complete round. Returns the number of styles computed, 0 = error.
fn one_round(l: *mut driver.Run, src: *mut mem.Buf, css: *mut mem.CpBuf,
    t: *mut tok.Tokens, tmp: *mut mem.CpBuf, cx: *mut sel.Ctx,
    w: *mut cascade.Winner, keep: *mut Gc[GcMap]) -> AllocError!u64 {
    driver.run_text_out_bytes(l, mem.buf_ptr(src), mem.buf_len(src))
    let rc: u32 = driver.run_document_build(l)
    if rc != 0 as u32 {
        return 0
    }
    let doc: Gc[Document] = driver.run_document(l)
    let nm: *mut names.Names = driver.run_names(l)
    tok.tokenize(t, css)
    var p: cv.Parser = cv.parser_new(t)
    let sheet_tree = try cv.parse_stylesheet(&p)
    var order: u32 = 0
    let rules = try cascade.collect_rules(sheet_tree, cascade.ORIGIN_AUTHOR, 0,
        nm, tmp, &order)
    let styles = try gcmap_new(true, true)
    let root_style = try cascade.style_root()
    var k: Gc[Node] = doc
    var n: u64 = 0
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            var parent_style: Gc[Style] = root_style
            let parent: Gc[Node] = k.parent
            if parent != gc_null[Node]() && parent.kind == node.K_ELEM {
                let found: Gc[Style] = gcmap_get_value[Style](styles, parent as u64)
                if found != gc_null[Style]() {
                    parent_style = found
                }
            }
            let s = try cascade.cascade_elem(rules, k, parent_style, cx, w)
            let ok: bool = try gcmap_set_value[Style](styles, k as u64, s)
            n = n + 1
        }
        k = next_in_order(k, doc)
    }
    *keep = styles
    return n
}

fn main() -> i32 {
    if !gc_init() {
        return 2
    }
    var rounds_max: u64 = DEFAULT_ROUNDS
    var budget: i64 = DEFAULT_BUDGET_MS
    var leak: bool = false
    var ins: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&ins)
    if mem.buf_len(&ins) >= 8 {
        var v: u64 = 0
        var i: usize = 0
        while i < 4 {
            v = v | ((mem.buf_at(&ins, i) as u64) << (8 * i as u64))
            i = i + 1
        }
        if v > 0 {
            rounds_max = v
        }
        var x: u64 = 0
        i = 0
        while i < 4 {
            x = x | ((mem.buf_at(&ins, 4 + i) as u64) << (8 * i as u64))
            i = i + 1
        }
        if x > 0 {
            budget = x as i64
        }
        if mem.buf_len(&ins) >= 12 {
            var lw: u64 = 0
            i = 0
            while i < 4 {
                lw = lw | ((mem.buf_at(&ins, 8 + i) as u64) << (8 * i as u64))
                i = i + 1
            }
            leak = lw != 0
        }
    }
    mem.buf_free(&ins)

    var header: [u8; 91] = "# firn-css-soak v1\n# columns: t_ms\trounds\tstyles\trss_kib\tlive\truns\theap_bytes\tpause_max_ns\n"
    text_out((&header) as u64, 91)

    var src: mem.Buf = mem.buf_new()
    mem.buf_init(&src)
    source(&src)
    var css: mem.CpBuf = mem.cp_new()
    mem.cp_init(&css)
    sheet(&css)
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var tmp: mem.CpBuf = mem.cp_new()

    // Everything with `Gc` fields lies in the frame of `main`.
    var l: driver.Run = driver.run_new()
    if !driver.run_init(&l) {
        return 3
    }
    var cx: sel.Ctx = sel.ctx_new(driver.run_names(&l))
    sel.ctx_init(&cx)
    var w: cascade.Winner = cascade.winner_new()

    let t0: u64 = meas.meas_now_ms()
    var rounds: u64 = 0
    var per_round: u64 = 0
    var chain: Gc[Holder] = gc_null[Holder]()
    var keep: Gc[GcMap] = gc_null[GcMap]()
    while rounds < rounds_max {
        keep = gc_null[GcMap]()
        let n: u64 = one_round(&l, &src, &css, &t, &tmp, &cx, &w, &keep)
        catch 0
        if n == 0 {
            var f: [u8; 19] = "# error in a round\n"
            text_out((&f) as u64, 19)
            return 4
        }
        if per_round == 0 {
            per_round = n
        } else if per_round != n {
            var f2: [u8; 26] = "# the style count wobbles\n"
            text_out((&f2) as u64, 26)
            return 5
        }
        if leak {
            let h = gc Holder { table: keep, next: chain } catch gc_null[Holder]()
            if h == gc_null[Holder]() {
                var fo: [u8; 21] = "# out of memory (gc)\n"
                text_out((&fo) as u64, 21)
                return 6
            }
            chain = h
        }
        keep = gc_null[GcMap]()
        rounds = rounds + 1
        if rounds % SAMPLE == 0 {
            driver.run_tree_release(&l)
            scrub_deep(3)
            let ms: u64 = meas.meas_now_ms() - t0
            line(ms, rounds, per_round, meas.meas_rss_kib(),
                gc_live_objects(), gc_collections(), gc_heap_bytes(),
                gc_pause_ns_max())
            if ms as i64 >= budget {
                break
            }
        }
    }
    var ez: [u8; 10] = "# created="
    text_out((&ez) as u64, 10)
    meas.meas_u64(gc_diag(6))
    var ez2: [u8; 6] = " live="
    text_out((&ez2) as u64, 6)
    meas.meas_u64(gc_live_objects())
    var ez3: [u8; 6] = " leak="
    text_out((&ez3) as u64, 6)
    if leak {
        meas.meas_u64(1)
    } else {
        meas.meas_u64(0)
    }
    meas.meas_nl()
    if leak && chain == gc_null[Holder]() {
        return 7
    }
    var e: [u8; 7] = "# done\n"
    text_out((&e) as u64, 7)
    driver.run_free(&l)
    return 0
}
