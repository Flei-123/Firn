// lib/window/shellos.windows.fi -- OS seam of the shell thread on Windows: auto-reset wake event, MsgWaitForMultipleObjectsEx, paint hook and timer of the Win32 backend (docs/SHELL_THREAD.md). The twin of shellos.fi.
import std.rt
import window.window
import window.backend

export {
    os_available, os_event_new, os_wake, os_wait, os_hook, os_timer, os_set_size,
}

extern fn CreateEventW(sa: u64, manual: i64, initial: i64, name: u64) -> i64;
extern fn SetEvent(h: i64) -> i32;
extern fn MsgWaitForMultipleObjectsEx(n: i64, hp: u64, ms: i64, mask: i64, fl: i64) -> i32;

const QS_ALLINPUT: i64 = 1279
const MWMO_INPUTAVAILABLE: i64 = 4
const WAIT_FOREVER: i64 = 4294967295

fn os_available() -> bool {
    return true
}

fn os_event_new() -> u64 {
    return CreateEventW(0, 0, 0, 0) as u64
}

fn os_wake(e: u64) {
    if e != 0 {
        SetEvent(e as i64)
    }
}

fn os_wait(e: u64, ms: i64) {
    var n: i64 = ms
    if n < 0 {
        n = WAIT_FOREVER
    }
    var h: [u64; 1] = [e; 1]
    MsgWaitForMultipleObjectsEx(1, (&h[0]) as u64, n, QS_ALLINPUT, MWMO_INPUTAVAILABLE)
}

fn os_hook(f: *mut window.Window, h: fn(u64), ud: u64) {
    backend.r_paint_hook(&(*f).p, h, ud)
}

fn os_timer(f: *mut window.Window, ms: i64) -> bool {
    return backend.r_timer(&(*f).p, ms)
}

fn os_set_size(f: *mut window.Window, w: usize, h: usize) -> bool {
    return backend.r_set_size(&(*f).p, w, h)
}
