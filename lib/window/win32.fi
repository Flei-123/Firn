// ===================================================================
// THE CLIPBOARD (LIB-006) AND FILES DROPPED ON THE WINDOW -- Windows (desktop round)
// ===================================================================
//
// The clipboard as lib/window/window.fi describes it: `clipboard_set(mime, ...)` offers one more type,
// `clipboard_get(mime)` fetches one, `clipboard_types` lists them. The MIME types map to Windows'
// formats like this:
//
//   text/plain, text/plain;charset=utf-8   CF_UNICODETEXT (UTF-16; "\n" <-> "\r\n" translated)
//   text/uri-list                          CF_HDROP (a list of file paths, as Explorer's copy makes it)
//   image/png                              the registered format "PNG"
//   any other type                         a format registered under that very name (RegisterClipboardFormatW)
//
// The first `clipboard_set` after another program has copied (or at the start) empties the clipboard
// and takes it for the window; the next ones add formats. WM_DESTROYCLIPBOARD tells the window that
// somebody else has taken it (`clip_own` false). The data is rendered at once (no delayed rendering).
//
// HONEST
// C1  Windows has no "owner that serves requests" like X11: the data is copied into the system
//     at `clipboard_set`; a program that copies 200 MB pays for it right there.
// C2  `clipboard_get` of a format the program does not know (an image of another type, a rich
//     text) is possible by its registered name; `GlobalSize` can be larger than the real
//     size for foreign data (the system rounds): the caller sees the padding.
// C3  Opening the clipboard fails while another program holds it; it is retried for about
//     200 ms, then the call answers false.
// C4  Tested under Wine, whose clipboard is bridged to the X selections: GTK reads what the program
//     copied and the program reads what GTK copied; not on a real Windows machine.
fn mime_is_text(m: str) -> bool {
    return m.length() >= 10 && m.part(0, 10) == "text/plain"
}

fn open_clip(h: i64) -> bool {
    var i: u32 = 0
    while i < 20 as u32 {
        if OpenClipboard(h) != 0 {
            return true
        }
        Sleep(10)
        i = i + 1 as u32
    }
    return false
}

// The format id of a MIME type that is not text or a file list: a registered format.
fn clip_format_of(mime: str) -> i64 {
    var name: rt.Buf = rt.buf_new()
    var m: str = mime
    if mime == "image/png" {
        m = "PNG"
    }
    cmdline.utf8_to_utf16(m.p as u64, m.length(), &name)
    rt.buf_push(&name, 0 as u8)
    rt.buf_push(&name, 0 as u8)
    let f: i32 = RegisterClipboardFormatW(rt.buf_ptr(&name))
    rt.buf_free(&name)
    return f as i64
}

// Puts `n` octets at `p` on the open clipboard as format `fmt`. Takes a moveable block.
fn clip_put(fmt: i64, p: u64, n: usize) -> bool {
    let hm: i64 = GlobalAlloc(2, (n + 2) as i64) // GMEM_MOVEABLE
    if hm == 0 {
        return false
    }
    let q: u64 = GlobalLock(hm)
    if q == 0 as u64 {
        GlobalFree(hm)
        return false
    }
    rt.mem_copy(q, p, n)
    rt.st8(q, n, 0 as u8)
    rt.st8(q, n + 1, 0 as u8)
    GlobalUnlock(hm)
    if SetClipboardData(fmt, hm) == 0 {
        GlobalFree(hm)
        return false
    }
    return true
}

fn hexv(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 87 as u8) as i32
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c - 55 as u8) as i32
    }
    return -1
}

// A text/uri-list into the bytes of a CF_HDROP: DROPFILES (20 octets: offset of the names, a POINT, fNC, fWide = 1),
// then the wide paths, each ended by a zero, the list by a second one.
fn uris_to_hdrop(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var names: rt.Buf = rt.buf_new()
    var count: usize = 0
    var i: usize = 0
    while i < n {
        var j: usize = i
        while j < n && rt.ld8(p, j) != 10 as u8 {
            j = j + 1
        }
        var e: usize = j
        if e > i && rt.ld8(p, e - 1) == 13 as u8 {
            e = e - 1
        }
        let ln: str = str { p: (p + i as u64) as *mut u8, n: e - i }
        i = j + 1
        if ln.length() < 8 || ln.part(0, 7) != "file://" {
            continue
        }
        // file:///C:/dir/f -> C:\dir\f ; file://server/share/f -> \\server\share\f
        var path: rt.Buf = rt.buf_new()
        var k: usize = 7
        if ln.chars(7) != 47 as u8 {
            rt.buf_push(&path, 92 as u8)
            rt.buf_push(&path, 92 as u8)
        } else {
            k = 8 // skip the slash before the drive letter
        }
        while k < ln.length() {
            let c: u8 = ln.chars(k)
            if c == 37 as u8 && k + 2 < ln.length() + 0 && hexv(ln.chars(k + 1)) >= 0 && hexv(ln.chars(k + 2)) >= 0 {
                rt.buf_push(&path, (hexv(ln.chars(k + 1)) * 16 + hexv(ln.chars(k + 2))) as u8)
                k = k + 3
            } else if c == 47 as u8 {
                rt.buf_push(&path, 92 as u8)
                k = k + 1
            } else {
                rt.buf_push(&path, c)
                k = k + 1
            }
        }
        cmdline.utf8_to_utf16(rt.buf_ptr(&path), rt.buf_len(&path), &names)
        rt.buf_push(&names, 0 as u8)
        rt.buf_push(&names, 0 as u8)
        rt.buf_free(&path)
        count = count + 1
    }
    if count == 0 {
        rt.buf_free(&names)
        return false
    }
    rt.buf_push(&names, 0 as u8)
    rt.buf_push(&names, 0 as u8)
    var head: [u8; 20] = [0; 20]
    head[0] = 20 as u8 // pFiles
    head[16] = 1 as u8 // fWide
    rt.buf_push_bytes(out, (&head[0]) as u64, 20)
    rt.buf_push_bytes(out, rt.buf_ptr(&names), rt.buf_len(&names))
    rt.buf_free(&names)
    return true
}

fn r_clip_set(x: *mut Platte, mime: str, p: u64, n: usize) -> bool {
    if (*x).hwnd == 0 {
        return false
    }
    if !open_clip((*x).hwnd) {
        return false
    }
    if !(*x).clip_own {
        EmptyClipboard()
        (*x).clip_own = true
    }
    var ok: bool = false
    if mime_is_text(mime) {
        // UTF-8 -> UTF-16, line breaks "\n" -> "\r\n", a zero unit at the end
        var u: rt.Buf = rt.buf_new()
        var t: rt.Buf = rt.buf_new()
        var i: usize = 0
        while i < n {
            let c: u8 = rt.ld8(p, i)
            if c == 10 as u8 && !(i > 0 && rt.ld8(p, i - 1) == 13 as u8) {
                rt.buf_push(&t, 13 as u8)
            }
            rt.buf_push(&t, c)
            i = i + 1
        }
        cmdline.utf8_to_utf16(rt.buf_ptr(&t), rt.buf_len(&t), &u)
        ok = clip_put(13, rt.buf_ptr(&u), rt.buf_len(&u))
        rt.buf_free(&u)
        rt.buf_free(&t)
    } else if mime == "text/uri-list" {
        var d: rt.Buf = rt.buf_new()
        if uris_to_hdrop(p, n, &d) {
            ok = clip_put(15, rt.buf_ptr(&d), rt.buf_len(&d))
        }
        rt.buf_free(&d)
    } else {
        let f: i64 = clip_format_of(mime)
        if f != 0 {
            ok = clip_put(f, p, n)
        }
    }
    CloseClipboard()
    return ok
}

fn push_hex(out: *mut rt.Buf, v: u32) {
    var d: u32 = v >> 4
    if d < 10 as u32 {
        rt.buf_push(out, (48 as u32 + d) as u8)
    } else {
        rt.buf_push(out, (55 as u32 + d) as u8)
    }
    d = v & 15 as u32
    if d < 10 as u32 {
        rt.buf_push(out, (48 as u32 + d) as u8)
    } else {
        rt.buf_push(out, (55 as u32 + d) as u8)
    }
}

// Appends a UTF-8 path as a file URI line ("file:///C:/a%20b\r\n").
fn path_to_uri(path: u64, n: usize, out: *mut rt.Buf) {
    let pre: str = "file://"
    rt.buf_push_bytes(out, pre.p as u64, pre.length())
    var i: usize = 0
    if n >= 2 && rt.ld8(path, 0) == 92 as u8 && rt.ld8(path, 1) == 92 as u8 {
        i = 2 // \\server\share -> file://server/share
    } else {
        rt.buf_push(out, 47 as u8)
    }
    while i < n {
        let c: u8 = rt.ld8(path, i)
        let plain: bool = (c >= 48 as u8 && c <= 57 as u8) || (c >= 65 as u8 && c <= 90 as u8)
            || (c >= 97 as u8 && c <= 122 as u8) || c == 45 as u8 || c == 46 as u8 || c == 95 as u8
            || c == 126 as u8 || c == 58 as u8
        if c == 92 as u8 || c == 47 as u8 {
            rt.buf_push(out, 47 as u8)
        } else if plain {
            rt.buf_push(out, c)
        } else {
            rt.buf_push(out, 37 as u8)
            push_hex(out, c as u32)
        }
        i = i + 1
    }
    rt.buf_push(out, 13 as u8)
    rt.buf_push(out, 10 as u8)
}

fn r_clip_get(x: *mut Platte, mime: str, out: *mut rt.Buf) -> bool {
    if (*x).hwnd == 0 {
        return false
    }
    if !open_clip((*x).hwnd) {
        return false
    }
    var ok: bool = false
    if mime_is_text(mime) {
        let h: i64 = GetClipboardData(13)
        if h != 0 {
            let q: u64 = GlobalLock(h)
            if q != 0 as u64 {
                let units: usize = (GlobalSize(h) as usize) / 2
                var u: rt.Buf = rt.buf_new()
                cmdline.utf16_to_utf8(q, units, &u)
                // up to the first NUL, "\r\n" -> "\n"
                var i: usize = 0
                while i < rt.buf_len(&u) && rt.buf_at(&u, i) != 0 as u8 {
                    let c: u8 = rt.buf_at(&u, i)
                    if !(c == 13 as u8 && i + 1 < rt.buf_len(&u) && rt.buf_at(&u, i + 1) == 10 as u8) {
                        rt.buf_push(out, c)
                    }
                    i = i + 1
                }
                rt.buf_free(&u)
                GlobalUnlock(h)
                ok = true
            }
        }
    } else if mime == "text/uri-list" {
        let h: i64 = GetClipboardData(15)
        if h != 0 {
            let q: u64 = GlobalLock(h)
            if q != 0 as u64 {
                let off: usize = rt.ld32(q, 0) as usize
                let wide: bool = rt.ld32(q, 4) != 0 as u32 // fWide at octet 16
                let total: usize = GlobalSize(h) as usize
                var at: usize = off
                var any: bool = false
                while wide && at + 2 <= total && (rt.ld8(q, at) != 0 as u8 || rt.ld8(q, at + 1) != 0 as u8) {
                    var e: usize = at
                    while e + 2 <= total && (rt.ld8(q, e) != 0 as u8 || rt.ld8(q, e + 1) != 0 as u8) {
                        e = e + 2
                    }
                    var pb: rt.Buf = rt.buf_new()
                    cmdline.utf16_to_utf8(q + at as u64, (e - at) / 2, &pb)
                    path_to_uri(rt.buf_ptr(&pb), rt.buf_len(&pb), out)
                    rt.buf_free(&pb)
                    any = true
                    at = e + 2
                }
                GlobalUnlock(h)
                ok = any
            }
        }
    } else {
        let f: i64 = clip_format_of(mime)
        if f != 0 {
            let h: i64 = GetClipboardData(f)
            if h != 0 {
                let q: u64 = GlobalLock(h)
                if q != 0 as u64 {
                    rt.buf_push_bytes(out, q, GlobalSize(h) as usize)
                    GlobalUnlock(h)
                    ok = true
                }
            }
        }
    }
    CloseClipboard()
    return ok
}

fn r_clip_types(x: *mut Platte, out: *mut rt.Buf) -> usize {
    if (*x).hwnd == 0 {
        return 0
    }
    if !open_clip((*x).hwnd) {
        return 0
    }
    var count: usize = 0
    var f: i32 = EnumClipboardFormats(0)
    while f != 0 {
        if f == 13 {
            let t: str = "text/plain;charset=utf-8\n"
            rt.buf_push_bytes(out, t.p as u64, t.length())
            count = count + 1
        } else if f == 15 {
            let t: str = "text/uri-list\n"
            rt.buf_push_bytes(out, t.p as u64, t.length())
            count = count + 1
        } else if f >= 49152 {
            var nb: [u16; 256] = [0; 256]
            let k: i32 = GetClipboardFormatNameW(f as i64, (&nb[0]) as u64, 255)
            if k > 0 {
                var u: rt.Buf = rt.buf_new()
                cmdline.utf16_to_utf8((&nb[0]) as u64, k as usize, &u)
                if rt.buf_len(&u) == 3 && rt.buf_at(&u, 0) == 80 as u8 && rt.buf_at(&u, 1) == 78 as u8 && rt.buf_at(&u, 2) == 71 as u8 {
                    let t: str = "image/png\n"
                    rt.buf_push_bytes(out, t.p as u64, t.length())
                } else {
                    rt.buf_push_bytes(out, rt.buf_ptr(&u), rt.buf_len(&u))
                    rt.buf_push(out, 10 as u8)
                }
                rt.buf_free(&u)
                count = count + 1
            }
        }
        f = EnumClipboardFormats(f as i64)
    }
    CloseClipboard()
    return count
}

fn r_clip_clear(x: *mut Platte) {
    if (*x).hwnd == 0 || !(*x).clip_own {
        return
    }
    if open_clip((*x).hwnd) {
        EmptyClipboard()
        CloseClipboard()
    }
    (*x).clip_own = false
}

// ---- files dropped on the window

fn on_dropfiles(w: *mut Platte, h: i64) {
    let count: i32 = DragQueryFileW(h, 4294967295 as i64, 0 as u64, 0)
    var i: i32 = 0
    var taken: u32 = 0
    while i < count {
        let n: i32 = DragQueryFileW(h, i as i64, 0 as u64, 0)
        if n > 0 {
            var wb: rt.Buf = rt.buf_new()
            rt.buf_reserve(&wb, ((n + 2) * 2) as usize)
            let got: i32 = DragQueryFileW(h, i as i64, rt.buf_ptr(&wb), (n + 1) as i64)
            if got > 0 {
                cmdline.utf16_to_utf8(rt.buf_ptr(&wb), got as usize, &(*w).drop)
                rt.buf_push(&(*w).drop, 0 as u8)
                taken = taken + 1 as u32
            }
            rt.buf_free(&wb)
        }
        i = i + 1
    }
    DragFinish(h)
    if taken > 0 as u32 {
        (*w).drop_n = (*w).drop_n + taken as usize
        push_ev(w, window.EV_DROP, taken, 0 as u32, 0 as u32, 0 as u32)
    }
}

fn r_drop_accept(x: *mut Platte, on: bool) -> bool {
    if (*x).hwnd == 0 {
        return false
    }
    var f: i64 = 0
    if on {
        f = 1
    }
    DragAcceptFiles((*x).hwnd, f)
    return true
}

fn r_drop_take(x: *mut Platte, out: *mut rt.Buf) -> usize {
    let n: usize = (*x).drop_n
    if n > 0 {
        rt.buf_push_bytes(out, rt.buf_ptr(&(*x).drop), rt.buf_len(&(*x).drop))
    }
    rt.buf_clear(&(*x).drop)
    (*x).drop_n = 0
    return n
}

// OpenPlan LIB-005: no descriptor to wait on here -- window.wait_any asks
// the windows in turn.
fn r_event_fd(x: *mut Platte) -> i32 {
    return -1 as i32
}
