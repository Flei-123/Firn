// ---- RUNDE C-049: was der eigene Rahmen zusaetzlich braucht
//
// DREI davon sind schon gebunden (`GetClientRect`, `GetSystemMetrics`,
// `ReleaseCapture` stehen in compiler/src/win.rs). Die SECHS anderen
// NICHT -- und die Importtabelle liegt im UEBERSETZER, den sich diese
// Runde mit C-047 und C-048 teilt. Ein Eingriff dort haette deren
// laufende Baeue mitgeaendert; das ist kein Preis, den eine Runde ueber
// den Fensterrahmen zahlen darf.
//
// Also derselbe Weg, den diese Datei fuer kernel32 schon geht
// (`kernel32_holen`): zur Laufzeit aus user32.dll holen. Das ist kein
// Notbehelf, sondern bei `GetSystemMetricsForDpi` sogar der RICHTIGE
// Weg -- die Funktion gibt es erst ab Windows 10 1607, und ein
// statischer Import wuerde das Programm auf aelteren Staenden gar nicht
// erst starten lassen ("Einstiegspunkt nicht gefunden").
extern fn GetClientRect(h: i64, r: u64) -> i32;
extern fn GetSystemMetrics(i: i64) -> i32;
extern fn ReleaseCapture() -> i32;

