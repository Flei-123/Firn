// SPI_GETWORKAREA (0x0030) delivers the WORK AREA -- the screen
// without the taskbar. That is exactly the area of which 80 % is a
// sensible window.
extern fn SystemParametersInfoW(a: i64, b: i64, p: u64, w: i64) -> i32;
