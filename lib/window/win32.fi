// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/window/win32.fi, as of Certus commit 1f1ec17bdb68 (last
// changed in cbbc9d8c0475); released by the sole author Justin on 23.09.2026
// for Firn under MPL-2.0.
// lib/window/win32.fi -- THE WINDOWS BACK END (round WINDOW).
//
// NOT rewritten: this is lib/windows/gdi.fi from CERTUS-WINDOWS and
// CERTUS-WIN2, rehung onto the contract of
// lib/window/window.fi. The three numbers on which the whole
// representation hangs stand there unchanged:
//
//  1. THE ROW DIRECTION. A DIB is laid out bottom to top when
//     `biHeight` is positive. The canvas runs top to bottom --
//     `biHeight` is therefore NEGATIVE.
//  2. THE ROW LENGTH. At 32 bits per pixel there is no padding, but
//     only for that reason. Writing always uses `(*w).stride` and
//     never a guessed stride.
//  3. THE CHANNEL ORDER. A 32 bit DIB with BI_RGB holds B, G, R, X --
//     the same as the X11 backend expects. A swap happens only for
//     GDI TEXT, because a COLORREF is 0x00BBGGRR.
//
// NO FOREIGN LIBRARY: everything is `extern fn` on user32, gdi32,
// kernel32 and advapi32, bound through the import table that
// compiler/src/win.rs writes itself. No Direct2D, no GDI+, no
// DirectWrite, not a line of C.
//
// THE CALLBACK. `#[win_callback]` puts the Win64 -> System-V thunk in
// front of `wndproc`; without it `hwnd` would arrive in `rcx` where
// Firn reads `rdi` -- and there would be neither WM_DESTROY nor
// WM_SIZE, because both are SENT and never stand in the message queue.
//
// ================================ WHAT THIS ROUND ADDED
//
// W1 THE KEY STATE. `ev_state` was always 0; now Shift (bit 0) and
//    Ctrl (bit 2) stand in it -- the X11 layout.
// W2 RIGHT AND MIDDLE MOUSE BUTTON. W3 K_TAB/K_HOME/K_END/K_DELETE.
// W4 WM_DPICHANGED: another screen, another density.
// W5 LIGHT/DARK now stands HERE and not in the browser
//    (lib/windows/wintheme.fi is gone with it): a window library where
//    every program has to read the registry itself has not done its
//    job.
import std.rt
import window.window
import window.pointers
import std.cmdline
// ROUND C-040 -- THE INPUT PRIORITY, SHARED INSTEAD OF TWICE.
//
// Until this round `G_EIN_VORRANG` occurred ONLY in lib/android/a_main.fi
// (9 places), in this file ZERO times -- re-counted with
//     grep -c G_EIN_VORRANG lib/android/a_main.fi lib/window/win32.fi
// The window procedure is the ONLY place at which Windows delivers a
// key or a click; reported here, the core (lib/browser/vorrang.fi) knows
// of it even before the event is fetched from the
// queue -- so also when the line break is running.
//
// THE MESSAGE "AN INPUT HAS ARRIVED" -- to whom, the host says.
//
// In Certus this back end called `browser.vorrang` directly here; the
// input priority is, however, a matter of the BROWSER (it shifts
// slices of the page build), not of the window. In Firn there is no
// browser.vorrang, and a window layer that knows a particular host
// cannot be used by any other. So the back end reports to a
// hook that the host sets (`window.input_hook`); Certus hangs
// `vorrang.vorrang_eingabe_melden` there and gets the same behaviour
// as before. Without a hook nothing happens -- as with a host without
// priority.

export {
    r_notify, r_stay_alive, r_in_front,
    r_notify_at, r_notify_shown, r_notify_cancel,
    r_pick_image, r_pick_poll, r_pick_take, r_image_decode,
    r_clip_set, r_clip_get, r_clip_types, r_clip_clear, r_event_fd, r_drop_accept, r_drop_take,
    // fUi tempo, stage 2b: THE GPU (only Android has it so far)
    r_gpu_open, r_gpu_swap, r_gpu_close, r_gpu_place, r_gpu_lost,
    Platte, surface_new, r_input_hook, r_full_input, r_pointers,
    r_next_pointer, r_pointer_mouse, r_text_input, r_text_sync,
    r_open, r_make, r_show, r_title, r_close, r_is_open,
    r_width, r_height, r_dpi, r_maximise,
    r_image, r_fill, r_font, r_text, r_present, r_ppm,
    r_wait, r_pending, r_next, r_dark, r_dark_known, r_poison,
    r_input_pending,
    r_screen, r_centre, r_dragging,
    r_update_start,
    r_titlebar_colour, r_titlebar_dark,
    // ROUND C-049 -- THE WINDOW FRAME OF ITS OWN.
    r_frame_can, r_frame_own, r_frame_height, r_button_zone,
    r_content_size,
    r_minimise, r_max_toggle, r_maximised, r_drag,
    r_sysmenu,
}

