// -------------------------------------------------------------- kernel32
#[no_gc]
extern fn GetModuleHandleW(n: i64) -> i64;
// ROUND C-038 -- START THE UPDATER.
//
// GetModuleFileNameW and CreateProcessW do NOT stand in the
// import list of the translator (compiler/src/win.rs) -- an
// `extern fn` on them ends in the linker with "undefined reference".
// Measured, not presumed: exactly on that the first attempt of this
// round failed.
//
// Changing the translator for it would be the wrong lever: on
// /root/firnc-gc C-037 and C-039 are currently hanging too. Instead
// the way that Windows itself provides for it and that the translator
// has already bound: GetModuleHandleW + GetProcAddress fetch the
// address at run time, and it is called as a function pointer --
// the same construction as `ruf1`/`ruf2` in lib/core/fiber.fi.
#[no_gc]
extern fn GetProcAddress(mod: i64, name: u64) -> i64;
#[no_gc]
extern fn CloseHandle(h: i64) -> i32;

// Call an address from a DLL as a function pointer. `code` is
// what GetProcAddress gave.
struct H4 { f: fn(i64, u64, i32) -> i32 }
// ---- ROUND C-049: the shapes of the user32 functions loaded later
struct HI2 { f: fn(i64, i64) -> i64 }
struct HI4 { f: fn(i64, i64, i64, i64) -> i64 }
struct HI2U { f: fn(i64, u64) -> i32 }
struct HI7 { f: fn(i64, i64, i64, i64, i64, i64, u64) -> i32 }
struct H10 { f: fn(u64, u64, i64, i64, i32, i64, i64, u64, u64, u64) -> i32 }

#[no_gc]
fn call_module_name(code: u64, mo: i64, buf: u64, n: i32) -> i32 {
    var set: [u64; 1] = [0; 1]
    set[0] = code
    var value: [u64; 1] = [0; 1]
    value[0] = (&set[0]) as u64
    let h: *mut H4 = (&value[0]) as *mut H4
    let f: fn(i64, u64, i32) -> i32 = (*h).f
    return f(mo, buf, n)
}

#[no_gc]
fn call_process(code: u64, app: u64, line: u64, pa: i64, ta: i64,
    erben: i32, flags: i64, umg: i64, ordner: u64, si: u64,
    pi: u64) -> i32 {
    var set: [u64; 1] = [0; 1]
    set[0] = code
    var value: [u64; 1] = [0; 1]
    value[0] = (&set[0]) as u64
    let h: *mut H10 = (&value[0]) as *mut H10
    let f: fn(u64, u64, i64, i64, i32, i64, i64, u64, u64, u64) -> i32
    = (*h).f
    return f(app, line, pa, ta, erben, flags, umg, ordner, si, pi)
}

// Fetch an address from kernel32. `name` is ASCII with a null at the end
// (GetProcAddress ALWAYS takes ASCII, also for W functions).
#[no_gc]
// user32.dll is already loaded (the window stands, after all), so
// `GetModuleHandleW` suffices -- no `LoadLibrary`.
fn user32_get(name: u64) -> u64 {
    var u32n: [u16; 11] = u"user32.dll\0"
    let mo: i64 = GetModuleHandleW((&u32n[0]) as i64)
    if mo == 0 {
        return 0
    }
    return GetProcAddress(mo, name) as u64
}

// Fetch the address once and remember it. Six numbers that are looked up
// exactly once -- `GetProcAddress` at every WM_NCHITTEST would be
// work at every mouse movement.
static mut G_U32_GESUCHT: u32 = 0
static mut G_SMFD: u64 = 0 // GetSystemMetricsForDpi
static mut G_GWPL: u64 = 0 // GetWindowPlacement
static mut G_POSTM: u64 = 0 // PostMessageW
static mut G_SENDM: u64 = 0 // SendMessageW
static mut G_GSYSM: u64 = 0 // GetSystemMenu
static mut G_TPM: u64 = 0 // TrackPopupMenu
static mut G_GPT: u64 = 0 // GetPointerType (Windows 8)
static mut G_S2C: u64 = 0 // ScreenToClient
static mut G_GMT: u64 = 0 // GetMessageTime

fn u32_once() {
    if G_U32_GESUCHT != 0 as u32 {
        return
    }
    G_U32_GESUCHT = 1 as u32
    var n1: [u8; 23] = "GetSystemMetricsForDpi\0"
    G_SMFD = user32_get((&n1[0]) as u64)
    var n2: [u8; 19] = "GetWindowPlacement\0"
    G_GWPL = user32_get((&n2[0]) as u64)
    var n3: [u8; 13] = "PostMessageW\0"
    G_POSTM = user32_get((&n3[0]) as u64)
    var n4: [u8; 13] = "SendMessageW\0"
    G_SENDM = user32_get((&n4[0]) as u64)
    var n5: [u8; 14] = "GetSystemMenu\0"
    G_GSYSM = user32_get((&n5[0]) as u64)
    var n6: [u8; 15] = "TrackPopupMenu\0"
    G_TPM = user32_get((&n6[0]) as u64)
    var n7: [u8; 15] = "GetPointerType\0"
    G_GPT = user32_get((&n7[0]) as u64)
    var n8: [u8; 15] = "ScreenToClient\0"
    G_S2C = user32_get((&n8[0]) as u64)
    var n9: [u8; 15] = "GetMessageTime\0"
    G_GMT = user32_get((&n9[0]) as u64)
}

// The callers. The pattern (record -> value -> holder -> function value)
// is the same as in `ruf_modulname`; why this detour is needed
// stands in lib/android/ndk.fi.
fn ruf_i2(code: u64, a: i64, b: i64) -> i64 {
    if code == 0 as u64 {
        return 0
    }
    var set: [u64; 1] = [0; 1]
    set[0] = code
    var value: [u64; 1] = [0; 1]
    value[0] = (&set[0]) as u64
    let h: *mut HI2 = (&value[0]) as *mut HI2
    let f: fn(i64, i64) -> i64 = (*h).f
    return f(a, b)
}

fn ruf_i4(code: u64, a: i64, b: i64, c: i64, d: i64) -> i64 {
    if code == 0 as u64 {
        return 0
    }
    var set: [u64; 1] = [0; 1]
    set[0] = code
    var value: [u64; 1] = [0; 1]
    value[0] = (&set[0]) as u64
    let h: *mut HI4 = (&value[0]) as *mut HI4
    let f: fn(i64, i64, i64, i64) -> i64 = (*h).f
    return f(a, b, c, d)
}

fn ruf_i2u(code: u64, a: i64, b: u64) -> i32 {
    if code == 0 as u64 {
        return 0
    }
    var set: [u64; 1] = [0; 1]
    set[0] = code
    var value: [u64; 1] = [0; 1]
    value[0] = (&set[0]) as u64
    let h: *mut HI2U = (&value[0]) as *mut HI2U
    let f: fn(i64, u64) -> i32 = (*h).f
    return f(a, b)
}

fn ruf_i7(code: u64, a: i64, b: i64, c: i64, d: i64, e: i64, g: i64,
    r: u64) -> i32 {
    if code == 0 as u64 {
        return 0
    }
    var set: [u64; 1] = [0; 1]
    set[0] = code
    var value: [u64; 1] = [0; 1]
    value[0] = (&set[0]) as u64
    let h: *mut HI7 = (&value[0]) as *mut HI7
    let f: fn(i64, i64, i64, i64, i64, i64, u64) -> i32 = (*h).f
    return f(a, b, c, d, e, g, r)
}

// The six with their proper name -- from here on the rest
// of the file reads as if they were bound.
fn GetSystemMetricsForDpi(i: i64, dpi: i64) -> i32 {
    u32_once()
    return ruf_i2(G_SMFD, i, dpi) as i32
}

fn GetWindowPlacement(h: i64, p: u64) -> i32 {
    u32_once()
    return ruf_i2u(G_GWPL, h, p)
}

fn PostMessageW(h: i64, m: i64, wp: i64, lp: i64) -> i32 {
    u32_once()
    return ruf_i4(G_POSTM, h, m, wp, lp) as i32
}

fn SendMessageW(h: i64, m: i64, wp: i64, lp: i64) -> i64 {
    u32_once()
    return ruf_i4(G_SENDM, h, m, wp, lp)
}

fn GetSystemMenu(h: i64, rev: i64) -> i64 {
    u32_once()
    return ruf_i2(G_GSYSM, h, rev)
}

fn GetPointerType(id: i64, out: u64) -> i32 {
    u32_once()
    return ruf_i2u(G_GPT, id, out)
}

fn ScreenToClient(h: i64, pt: u64) -> i32 {
    u32_once()
    return ruf_i2u(G_S2C, h, pt)
}

// GetMessageTime takes nothing; the two zero arguments are harmless in the
// Win64 calling convention. It returns a LONG: the upper half of rax is
// not defined.
fn GetMessageTime() -> i64 {
    u32_once()
    return ruf_i2(G_GMT, 0, 0) & 4294967295
}

fn TrackPopupMenu(m: i64, f: i64, x: i64, y: i64, res: i64, h: i64,
    r: u64) -> i32 {
    u32_once()
    return ruf_i7(G_TPM, m, f, x, y, res, h, r)
}

fn kernel32_get(name: u64) -> u64 {
    var k32: [u16; 13] = u"kernel32.dll\0"
    let mo: i64 = GetModuleHandleW((&k32[0]) as i64)
    if mo == 0 {
        return 0
    }
    return GetProcAddress(mo, name) as u64
}

// -------------------------------------------------------------- advapi32
extern fn RegGetValueW(key: i64, sub: u64, name: u64, flags: i64,
    typ: u64, data: u64, cb: u64) -> i32;

// ---------------------------------------------------------------- dwmapi
//
// ROUND C-039. Justin, 18.09.2026: "the window bar at the top does not
// fit the style either". Certus painted its shell dark and let Windows
// draw the LIGHT title bar above it -- the break sat exactly at
// the top edge.
//
// `DwmSetWindowAttribute` colours the bar that the SYSTEM draws.
// That is the right way and no emergency measure: the three system buttons,
// dragging, the double click to maximise and Aero Snap remain
// Windows' business and keep behaving exactly as the user
// knows it from every other window.
extern fn DwmSetWindowAttribute(h: i64, attr: i64, p: u64,
    cb: i64) -> i32;

// ----------------------------------------------------- die Nachrichten
const WM_DESTROY: i64 = 2
const WM_SIZE: i64 = 5
const WM_PAINT: i64 = 15
const WM_CLOSE: i64 = 16
const WM_DROPFILES: i64 = 563
const WM_DESTROYCLIPBOARD: i64 = 775
const WM_ERASEBKGND: i64 = 20
const WM_SETTINGCHANGE: i64 = 26
const WM_KEYDOWN: i64 = 256
const WM_CHAR: i64 = 258
const WM_SYSKEYDOWN: i64 = 260
const WM_MOUSEMOVE: i64 = 512
// WM_POINTER (Windows 8): touch and pen, one message per pointer
const WM_POINTERUPDATE: i64 = 581
const WM_POINTERDOWN: i64 = 582
const WM_POINTERUP: i64 = 583
const WM_POINTERCAPTURECHANGED: i64 = 588
const WM_LBUTTONDOWN: i64 = 513
const WM_RBUTTONDOWN: i64 = 516
const WM_MBUTTONDOWN: i64 = 519
const WM_MOUSEWHEEL: i64 = 522
// WM_DPICHANGED = 0x02E0 (W4)
const WM_DPICHANGED: i64 = 736
// ROUND CERTUS-WIN5. As long as the user DRAGS the edge, Windows runs
// in its OWN message loop and sends a WM_SIZE on every mouse move.
// Answering each of them with a full re-layout and a repaint means:
// the window stalls while being dragged. Exactly Justin's "moving or
// resizing the window takes forever". These two messages say when the
// dragging starts and stops -- in between only the canvas is
// stretched.
const WM_ENTERSIZEMOVE: i64 = 561
const WM_EXITSIZEMOVE: i64 = 562

// ======================================================================
// ROUND C-049 -- THE MESSAGES OF THE NON-CLIENT AREA
// ======================================================================
//
// WM_NCCALCSIZE (0x0083) asks how large the CONTENT of a window
// is. Whoever returns the proposed box UNCHANGED here
// gets a content as large as the whole window -- and thereby
// the title bar disappears WITHOUT shadow, Aero Snap or
// drag-resizing being lost. Exactly that is the difference from a
// frameless window (WS_POPUP), where all three are gone.
const WM_NCCALCSIZE: i64 = 131
// WM_NCHITTEST (0x0084) asks WHAT lies at a screen position.
// The answer decides about dragging (HTCAPTION), resizing
// (HTLEFT ...) and the content (HTCLIENT). Without an answer of its own
// a window without a title bar would also be one without a handle.
const WM_NCHITTEST: i64 = 132
const WM_NCMOUSEMOVE: i64 = 160
const WM_NCLBUTTONDOWN: i64 = 161
const WM_NCLBUTTONUP: i64 = 162
const WM_NCMOUSELEAVE: i64 = 674
const WM_LBUTTONUP: i64 = 514
const WM_MOUSELEAVE: i64 = 675
const WM_GETMINMAXINFO: i64 = 36
const WM_ACTIVATE: i64 = 6
const WM_SYSCOMMAND: i64 = 274
const WM_WINDOWPOSCHANGED: i64 = 71

// The answers of WM_NCHITTEST.
const HTCLIENT: i64 = 1
const HTCAPTION: i64 = 2
const HTSYSMENU: i64 = 3
const HTMINBUTTON: i64 = 8
const HTMAXBUTTON: i64 = 9
const HTLEFT: i64 = 10
const HTRIGHT: i64 = 11
const HTTOP: i64 = 12
const HTTOPLEFT: i64 = 13
const HTTOPRIGHT: i64 = 14
const HTBOTTOM: i64 = 15
const HTBOTTOMLEFT: i64 = 16
const HTBOTTOMRIGHT: i64 = 17
const HTCLOSE: i64 = 20

// SC_* for WM_SYSCOMMAND.
const SC_MINIMIZE: i64 = 61472
const SC_MAXIMIZE: i64 = 61488
const SC_RESTORE: i64 = 61728
const SC_MOUSEMOVE: i64 = 61458
const SC_KEYMENU: i64 = 61696

// SM_CXFRAME = 32, SM_CYFRAME = 33, SM_CXPADDEDBORDER = 92.
// The border at which you drag the size is the SUM of
// SM_CXFRAME and SM_CXPADDEDBORDER -- not SM_CXFRAME alone. Whoever
// takes only the first builds a handle 4 points narrow that
// nobody hits.
const SM_CXFRAME: i64 = 32
const SM_CYFRAME: i64 = 33
const SM_CXPADDEDBORDER: i64 = 92
const SM_CYCAPTION: i64 = 4

// THE DWM ATTRIBUTES.
//
// 20 = DWMWA_USE_IMMERSIVE_DARK_MODE, valid from Windows 10 1809
// (build 17763) and on Windows 11. On the BUILDS IN BETWEEN
// (1809 to before 20H1) the same attribute had the number 19. There is
// no reliable way to conclude from the version number
// which of the two applies -- the usual solution is to set BOTH
// and to heed the return value. An unknown attribute returns
// E_INVALIDARG and otherwise does nothing; that is harmless.
const DWMWA_USE_IMMERSIVE_DARK_MODE: i64 = 20
const DWMWA_USE_IMMERSIVE_DARK_MODE_ALT: i64 = 19
// 35 = DWMWA_CAPTION_COLOR, only from Windows 11 (build 22000). With that
// the bar gets EXACTLY the colour of the shell instead of Windows'
// default grey -- the seam disappears completely. The value is a
// COLORREF, so 0x00BBGGRR and NOT 0xRRGGBB.
const DWMWA_CAPTION_COLOR: i64 = 35
const DWMWA_TEXT_COLOR: i64 = 36

const RING: usize = 64

struct Platte {
    dragging: u32,
    hwnd: i64,
    hdc_mem: i64,
    hbm: i64,
    hbm_old: i64,
    bits: u64,
    w: usize,
    h: usize,
    stride: usize,
    dpi: usize,
    open: bool,
    // the event queue -- it MUST lie here and not above: the window
    // procedure is a callback and reaches only this structure.
    q_kind: [u32; 64],
    q_a: [u32; 64],
    q_x: [u32; 64],
    q_y: [u32; 64],
    q_s: [u32; 64],
    q_head: usize,
    q_tail: usize,
    // hell/dark (W5)
    dark: bool,
    dark_known: bool,
    // the poison, see window.set_poison
    gift: u32,
    // ROUND C-039: the colour that the TITLE BAR is to carry
    // (0xRRGGBB). 0 means "none set" -- then it stays at
    // light/dark without a colour of its own. It is remembered, because the
    // window need not stand yet when it is set.
    bar_rgb: u32,
    bar_at: u32,
    // ================================================== ROUND C-049
    // Does this window draw its frame itself? 0 = no (then
    // everything behaves as before this round).
    frame: u32,
    // How high the row is that the PROGRAM paints as a title bar
    // (the tab row). WM_NCHITTEST needs the number: above it
    // dragging happens, below it the content begins.
    header_h: usize,
    // The areas that the program occupies in this row for its
    // window buttons -- dragging must NOT happen there, otherwise a press on
    // "Close" moves the window. x0 <= x < x1,
    // it is not calculated from the RIGHT edge: the program knows
    // its width itself.
    knopf_x0: usize,
    knopf_x1: usize,
    // The LAST SEEN maximise state. From it
    // WM_WINDOWPOSCHANGED recognises that something has changed and the
    // frame has to be recalculated. (A field of its own and not
    // `knopf_x0` used along: two meanings in one number are the
    // start of the next error.)
    war_max: u32,
    // The hook for the input message, see above.
    ein_hook: fn(u64),
    ein_ud: u64,
    // REAL POINTERS (r112): touch and pen from WM_POINTER*
    pq: pointers.Pointers,
    // desktop round: files dropped on the window (WM_DROPFILES): UTF-8 paths, each ended by a NUL
    drop: rt.Buf,
    drop_n: usize,
    // the clipboard is ours (we filled it and nobody has taken it since)
    clip_own: bool,
}

// The holder with which a Firn function value becomes an address.
// Why this detour is needed stands in lib/android/ndk.fi: a value of
// type `fn(..)` is a pointer to a RECORD whose first word holds the
// code address. With `#[win_callback]` that word does NOT hold the
// Firn body but the Win64 -> System-V thunk.
struct Holder4 {
    f: fn(u64, u64, u64, u64) -> u64,
}

fn code_of4(f: fn(u64, u64, u64, u64) -> u64) -> u64 {
    var roh: [u64; 1] = [0; 1]
    let h: *mut Holder4 = (&roh[0]) as *mut Holder4
    (*h).f = f
    return *((roh[0]) as *mut u64)
}

fn surface_new() -> Platte {
    return Platte { dragging: 0, hwnd: 0, hdc_mem: 0, hbm: 0, hbm_old: 0, bits: 0,
        w: 0, h: 0, stride: 0, dpi: 96, open: false,
        q_kind: [0; 64], q_a: [0; 64], q_x: [0; 64], q_y: [0; 64],
        q_s: [0; 64], q_head: 0, q_tail: 0,
        dark: false, dark_known: false, gift: 0,
        bar_rgb: 0, bar_at: 0, frame: 0, header_h: 0,
        knopf_x0: 0, knopf_x1: 0, war_max: 0,
        ein_hook: in_nothing, ein_ud: 0, pq: pointers.pointers_new(),
        drop: rt.buf_new(), drop_n: 0, clip_own: false }
}

fn in_nothing(ud: u64) {}

// Set the hook. `ud` the host passes through to itself.
// Release/enter/leave (window.full_input) this back end does
// NOT YET deliver -- honestly `false`, so that the host knows it, instead of waiting for
// events that never come.
fn r_full_input(w: *mut Platte, an: bool) -> bool {
    return false
}

// REAL POINTERS (r112, window.real_pointers / window.next_pointer): TOUCH
// and PEN through WM_POINTERDOWN / UPDATE / UP (Windows 8 and later), one
// record per finger with the pointer id Windows gave it. The MOUSE keeps
// the legacy messages (WM_MOUSEMOVE, WM_LBUTTONDOWN ...): a mouse pointer
// message goes on to DefWindowProc, which makes them, and so does a pen
// that hovers. A touch or pen that is IN CONTACT is taken here and NOT
// passed on, so Windows does not make a mouse click of it as well.
// `false` = no GetPointerType (older Windows): the one pointer stays.
//
// The messages themselves are not run here (no Windows machine, wine does
// not inject touch); the decoding is pure (`pointer_decode`) and is
// checked in tools/fui/pointers_main.fi section 9; the program builds for the
// Windows target.
fn r_pointers(w: *mut Platte, an: bool) -> bool {
    u32_once()
    if G_GPT == 0 as u64 || G_S2C == 0 as u64 {
        return false
    }
    pointers.pointers_enable(&(*w).pq, an)
    return true
}

fn r_pointer_mouse(w: *mut Platte) -> bool {
    return false
}

fn r_next_pointer(w: *mut Platte, out: u64) -> bool {
    return pointers.pointers_next(&(*w).pq, out as *mut pointers.Pointer)
}

// Hand one WM_POINTER* to the feed. true = taken (touch or pen), the
// window procedure then returns 0; false = pass it to DefWindowProc.
fn pointer_message(w: *mut Platte, m: i64, wp: i64, lp: i64) -> bool {
    let id: i64 = wp & 65535
    let flags: i64 = (wp >> 16) & 65535
    var ty: [u32; 2] = [0 as u32; 2]
    if GetPointerType(id, (&ty[0]) as u64) == 0 {
        return false
    }
    // mouse (4), touch pad (5): the legacy messages
    let ptype: u32 = pointers.winptr_type(ty[0])
    if ptype == 0 as u32 {
        return false
    }
    let kind: u32 = pointers.winptr_kind(m, flags)
    if kind == 0 as u32 {
        return false // a pen that hovers
    }
    var pt: [i32; 2] = [0; 2]
    pt[0] = pointers.winptr_coord(lp, 0)
    pt[1] = pointers.winptr_coord(lp, 1)
    let ok: i32 = ScreenToClient((*w).hwnd, (&pt[0]) as u64)
    var fx: f64 = pt[0] as f64
    var fy: f64 = pt[1] as f64
    if fx < 0.0 {
        fx = 0.0
    }
    if fy < 0.0 {
        fy = 0.0
    }
    // the mouse is pointer 1 for the router; ids of touch and pen never meet it
    pointers.pointers_single(&(*w).pq, kind, (id + 1000) as u32, ptype,
        fx, fy, GetMessageTime())
    return true
}

fn r_input_hook(w: *mut Platte, h: fn(u64), ud: u64) {
    (*w).ein_hook = h
    (*w).ein_ud = ud
}

fn r_is_open(w: *mut Platte) -> bool {
    return (*w).open
}

fn r_width(w: *mut Platte) -> usize {
    return (*w).w
}

fn r_height(w: *mut Platte) -> usize {
    return (*w).h
}

fn r_dpi(w: *mut Platte) -> usize {
    if (*w).hwnd != 0 {
        let d: i32 = GetDpiForWindow((*w).hwnd)
        if d > 0 {
            (*w).dpi = d as usize
        }
    }
    return (*w).dpi
}

// ------------------------------------------------------ die Schlange

fn push_ev(w: *mut Platte, kind: u32, a: u32, x: u32, y: u32, st: u32) {
    let n: usize = ((*w).q_head + 1) % RING
    if n == (*w).q_tail {
        // full: the oldest falls out, a window must not stall
        // because nobody collects
        (*w).q_tail = ((*w).q_tail + 1) % RING
    }
    let i: usize = (*w).q_head
    (*w).q_kind[i] = kind
    (*w).q_a[i] = a
    (*w).q_x[i] = x
    (*w).q_y[i] = y
    (*w).q_s[i] = st
    (*w).q_head = n
    // ROUND C-040: REPORT THE INPUT AS SOON AS IT ARRIVES.
    //
    // Here and not in the individual branches of the window procedure: there
    // are six places at which an input is queued
    // (WM_KEYDOWN, WM_SYSKEYDOWN, WM_CHAR, three mouse buttons, the wheel) --
    // at one of them the report was missing sooner or later. `push_ev`
    // is the ONE way that all of them go.
    //
    // The point in time is the point: `push_ev` runs in the
    // window procedure, so in `DispatchMessageW` -- and that is called by
    // `pumpe`, and that is called by the breathing hook IN THE MIDDLE OF THE LINE BREAK. The
    // message thereby arrives while the page build is still running, and
    // exactly for that the priority exists.
    if kind == window.EV_KEY || kind == window.EV_CHAR
    || kind == window.EV_BUTTON {
        (*w).ein_hook((*w).ein_ud)
    }
}

fn r_pending(w: *mut Platte) -> bool {
    return (*w).q_head != (*w).q_tail
}

// ROUND C-040 -- IS AN INPUT IN THE QUEUE?
//
// That is the host function that `vorrang.vorrang_wirt_setzen` gets as
// `hat_eingabe`. It ONLY LOOKS and takes nothing out --
// it must not: an event that was processed in the middle of the line break
// would call `load_url` from within `load_url` (the reasoning stands
// at length at `pumpe_kurz` in lib/browser/certus_app.fi).
//
// Counted are only the three kinds behind which a HUMAN stands:
// key, character, mouse button. An EV_MOTION or an EV_EXPOSE is no
// input in this sense -- otherwise a mouse moving across the window would shift every slice
// and the page build would never progress.
fn r_input_pending(w: *mut Platte) -> bool {
    // ===============================================================
    // ROUND C-040, FOLLOW-UP fix-r4-1 -- FIRST PUMP, THEN LOOK
    // ===============================================================
    //
    // Here the loop began right away to run over the ring. That
    // is the same trap that was measured in lib/window/x11.fi and stands
    // there at length: the ring is filled by `pumpe`,
    // `pumpe` is called by `r_wait`, and `window.wait_event`
    // begins with
    //
    //     if backend.r_pending(&(*f).p) { return true }
    //
    // So if anything lies in the ring -- an Expose, a mouse movement
    // --, `wait_event` returns at once, `pumpe` does not run, and
    // the keys stay standing in the message queue of the system. During
    // the page build nobody fetches events, so the ring never
    // empties by itself.
    //
    // Measured under wine (.bau/fixr41/certus.exe, github.com, 12
    // keys) WITHOUT this line: of twelve keys sent NINE got
    // no picture up to the end of the run.
    //
    // `pumpe(w, 0)` is a PeekMessage pass without waiting -- exactly
    // what `r_next` also does a few lines further down when the ring
    // is empty. It takes nothing out of the ring; the ban on
    // PROCESSING an event in the middle of the line break stays
    // untouched.
    pumpe(w, 0)
    var i: usize = (*w).q_tail
    while i != (*w).q_head {
        let k: u32 = (*w).q_kind[i]
        if k == window.EV_KEY || k == window.EV_CHAR
        || k == window.EV_BUTTON {
            return true
        }
        i = (i + 1) % RING
    }
    return false
}

fn r_next(w: *mut Platte, k: *mut u32, a: *mut u32, ox: *mut u32,
    oy: *mut u32, os: *mut u32) -> bool {
    if (*w).q_head == (*w).q_tail {
        // Nothing in the queue: look ONCE without waiting, so that
        // `next_event` auf beiden Systemen dasselbe bedeutet.
        pumpe(w, 0)
    }
    if (*w).q_head == (*w).q_tail {
        return false
    }
    let i: usize = (*w).q_tail
    *k = (*w).q_kind[i]
    *a = (*w).q_a[i]
    *ox = (*w).q_x[i]
    *oy = (*w).q_y[i]
    *os = (*w).q_s[i]
    (*w).q_tail = (i + 1) % RING
    return true
}

// ------------------------------------------------- die Fensterprozedur

// W1: the key state in the X11 layout -- bit 0 Shift, bit 2 Ctrl.
// `GetKeyState` returns the high bit set while the key is
// gedrueckt ist.
fn state() -> u32 {
    var s: u32 = 0
    // VK_SHIFT = 0x10, VK_CONTROL = 0x11
    if (GetKeyState(16) as i64) & 32768 != 0 {
        s = s | 1 as u32
    }
    if (GetKeyState(17) as i64) & 32768 != 0 {
        s = s | 4 as u32
    }
    return s
}

// The Windows key number onto that of lib/window (= that of X11).
// As a TABLE and not as thirteen `if`s: whoever adds a key writes two
// numbers and not three lines.
fn vkey(vk: i64) -> u32 {
    var win: [i64; 13] = [27, 13, 8, 9, 40, 38, 34, 33, 37, 39, 36, 35,
        46]
    var uns: [u32; 13] = [9, 36, 22, 23, 116, 111, 117, 112, 113, 114,
        110, 115, 119]
    var i: usize = 0
    while i < 13 {
        if win[i] == vk {
            return uns[i]
        }
        i = i + 1
    }
    return 0 as u32
}

// Ist `p` die Zeichenkette "ImmersiveColorSet"? UTF-16, null-beendet.
// The comparison stands here because the window procedure must not
// allocate: no buffer, no conversion, only seventeen comparisons.
fn is_colour_set(p: u64) -> bool {
    if p == 0 as u64 {
        return false
    }
    var lit: [u8; 17] = "ImmersiveColorSet"
    var i: usize = 0
    while i < 17 {
        if rt.ld16(p, i) != (lit[i] as u16) {
            return false
        }
        i = i + 1
    }
    return rt.ld16(p, 17) == 0 as u16
}

// ======================================================================
// ROUND C-049 -- THE FRAME OF ITS OWN, THE CALCULATING MACHINERY
// ======================================================================

// The grip border: how wide the invisible strip at the edges is
// at which the size is dragged. With the density of the WINDOW, not
// of the system -- on a second screen with other scaling the system
// number would be wrong. `GetSystemMetricsForDpi` exists only from
// Windows 10 1607; if it is missing, the old one without density does.
fn border_width(w: *mut Platte) -> i64 {
    var f: i32 = 0
    var p: i32 = 0
    let d: i64 = (*w).dpi as i64
    if d > 0 {
        f = GetSystemMetricsForDpi(SM_CXFRAME, d)
        p = GetSystemMetricsForDpi(SM_CXPADDEDBORDER, d)
    }
    if f == 0 {
        f = GetSystemMetrics(SM_CXFRAME)
        p = GetSystemMetrics(SM_CXPADDEDBORDER)
    }
    var r: i64 = (f as i64) + (p as i64)
    if r < 4 {
        r = 4
    }
    return r
}

// IS THE WINDOW MAXIMISED? Not via `IsZoomed` (that knows only
// maximised/not), but via WINDOWPLACEMENT -- the same source
// from which `r_maximised` also answers, so that frame and program
// are never of different opinion. showCmd stands in the third u32.
// SW_SHOWMAXIMIZED = 3.
fn ist_max(w: *mut Platte) -> bool {
    if (*w).hwnd == 0 {
        return false
    }
    // WINDOWPLACEMENT: length(4) flags(4) showCmd(4) + 2 POINT + RECT
    var wpl: [u8; 44] = [0; 44]
    let pp: u64 = (&wpl[0]) as u64
    rt.st32(pp, 0, 44 as u32)
    if GetWindowPlacement((*w).hwnd, pp) == 0 {
        return false
    }
    return rt.ld32(pp, 2) == 3 as u32
}

// ======================================================================
// THE ERROR THAT EVERY SELF-DRAWN FRAME MAKES
// ======================================================================
//
// A MAXIMISED window is under Windows deliberately larger than
// the screen: on every side by the frame that you otherwise need
// for dragging (at 96 dpi 8 points). As long as Windows draws the
// title bar, nobody notices -- the overhang
// lies under the border that it paints itself.
//
// Whoever answers WM_NCCALCSIZE and leaves the box unchanged
// gets THIS overhang as content. The consequence on the screen:
// the top row of the tabs is cut off, and on the right eight points of the window lie
// next to the screen -- the close button
// is only half there.
//
// So: when maximised the box is made SMALLER at top/left/right/bottom by exactly
// this border. When not maximised it stays as it is --
// there the overhang is exactly the grip border that WM_NCHITTEST
// needs.
fn nccalc(w: *mut Platte, lp: u64) -> u64 {
    if !ist_max(w) {
        // The full box becomes content: no title bar, but
        // shadow, snap and size border remain Windows' business.
        return 0 as u64
    }
    let rb: i64 = border_width(w)
    // NCCALCSIZE_PARAMS: the first RECT is four i32 (l, t, r, b).
    let l: i32 = rt.ld32(lp, 0) as i32
    let t: i32 = rt.ld32(lp, 1) as i32
    let r: i32 = rt.ld32(lp, 2) as i32
    let b: i32 = rt.ld32(lp, 3) as i32
    rt.st32(lp, 0, ((l as i64) + rb) as u32)
    rt.st32(lp, 1, ((t as i64) + rb) as u32)
    rt.st32(lp, 2, ((r as i64) - rb) as u32)
    rt.st32(lp, 3, ((b as i64) - rb) as u32)
    return 0 as u64
}

// WM_NCHITTEST -- WHAT LIES HERE?
//
// The order is not arbitrary, it is the whole logic:
//   1. the EDGES first (otherwise you never drag the size, because the
//      title bar reaches into the corner),
//   2. then the WINDOW BUTTONS of the program (no dragging
//      there),
//   3. then the rest of the header row: drag,
//   4. otherwise: content.
//
// WHEN MAXIMISED there are no edges -- a maximised window is not dragged
// larger, and a grip border there would only swallow the topmost
// pixel of the tabs.
fn nchit(w: *mut Platte, lp: u64) -> u64 {
    let sx: i64 = ((lp as i64) & 65535) - (((lp as i64) & 32768) << 1)
    let sy: i64 = (((lp as i64) >> 16) & 65535)
    -((((lp as i64) >> 16) & 32768) << 1)
    var wr: [i32; 4] = [0; 4]
    if GetWindowRect((*w).hwnd, (&wr[0]) as u64) == 0 {
        return HTCLIENT as u64
    }
    let l: i64 = wr[0] as i64
    let t: i64 = wr[1] as i64
    let r: i64 = wr[2] as i64
    let b: i64 = wr[3] as i64
    let rb: i64 = border_width(w)
    let maxi: bool = ist_max(w)
    if !maxi {
        let left: bool = sx < l + rb
        let right: bool = sx >= r - rb
        let top: bool = sy < t + rb
        let below: bool = sy >= b - rb
        if top && left {
            return HTTOPLEFT as u64
        }
        if top && right {
            return HTTOPRIGHT as u64
        }
        if below && left {
            return HTBOTTOMLEFT as u64
        }
        if below && right {
            return HTBOTTOMRIGHT as u64
        }
        if top {
            return HTTOP as u64
        }
        if below {
            return HTBOTTOM as u64
        }
        if left {
            return HTLEFT as u64
        }
        if right {
            return HTRIGHT as u64
        }
    }
    // In Inhaltskoordinaten weiterrechnen.
    let cx: i64 = sx - l
    let cy: i64 = sy - t
    if (*w).header_h == 0 || cy >= (*w).header_h as i64 {
        return HTCLIENT as u64
    }
    // The button row of the program: HTCLIENT, so that the click arrives as an
    // ordinary mouse click and the bar can draw its hover.
    // Windows' own HTMINBUTTON/HTMAXBUTTON/HTCLOSE
    // would want to take over the drawing -- and in the style of the
    // SYSTEM bar that we have just abolished.
    if (*w).knopf_x1 > (*w).knopf_x0 {
        if cx >= (*w).knopf_x0 as i64 && cx < (*w).knopf_x1 as i64 {
            return HTCLIENT as u64
        }
    }
    // The rest of the header row is the title bar. With that
    // dragging, double click (maximise) and right click (system menu)
    // can stay with WINDOWS -- and therefore behave exactly as
    // the user knows it from every other window. Aero Snap
    // likewise: it hangs on HTCAPTION.
    return HTCAPTION as u64
}

#[win_callback]
fn wndproc(hwnd: u64, msg: u64, wp: u64, lp: u64) -> u64 {
    let m: i64 = msg as i64
    let sp: i64 = GetWindowLongPtrW(hwnd as i64, 0 - 21)
    if sp == 0 {
        return DefWindowProcW(hwnd as i64, m, wp as i64, lp as i64) as u64
    }
    let w: *mut Platte = sp as *mut Platte
    // ---- ROUND C-049: the frame of its own. Only if it is on; otherwise
    // each of these messages falls to DefWindowProcW as before.
    if (*w).frame != 0 {
        if m == WM_NCCALCSIZE {
            // wParam = TRUE means "the box stands in lParam".
            if (wp as i64) != 0 {
                return nccalc(w, lp)
            }
            return DefWindowProcW(hwnd as i64, m, wp as i64,
                lp as i64) as u64
        }
        if m == WM_NCHITTEST {
            return nchit(w, lp)
        }
    }
    if m == WM_POINTERDOWN || m == WM_POINTERUPDATE || m == WM_POINTERUP
    || m == WM_POINTERCAPTURECHANGED {
        if pointers.pointers_enabled(&(*w).pq) {
            if pointer_message(w, m, wp as i64, lp as i64) {
                if m == WM_POINTERDOWN {
                    (*w).ein_hook((*w).ein_ud)
                }
                return 0 as u64
            }
        }
        return DefWindowProcW(hwnd as i64, m, wp as i64, lp as i64) as u64
    }
    if m == WM_ERASEBKGND {
        // Nothing is erased here: the blit covers every pixel, and
        // what Windows tints white beforehand is exactly the flicker
        // one would then see.
        return 1 as u64
    }
    if m == WM_PAINT {
        push_ev(w, window.EV_EXPOSE, 0 as u32, 0 as u32, 0 as u32,
            0 as u32)
        return DefWindowProcW(hwnd as i64, m, wp as i64, lp as i64) as u64
    }
    if m == WM_ENTERSIZEMOVE {
        (*w).dragging = 1
        return DefWindowProcW(hwnd as i64, m, wp as i64, lp as i64) as u64
    }
    if m == WM_EXITSIZEMOVE {
        (*w).dragging = 0
        // Now -- and only now -- the final size.
        push_ev(w, window.EV_CONFIGURE, 0 as u32, (*w).w as u32,
            (*w).h as u32, 0 as u32)
        return DefWindowProcW(hwnd as i64, m, wp as i64, lp as i64) as u64
    }
    if m == WM_SIZE {
        let l: i64 = lp as i64
        let nw: i64 = l & 65535
        let nh: i64 = (l >> 16) & 65535
        if nw > 0 && nh > 0 {
            push_ev(w, window.EV_CONFIGURE, 0 as u32, nw as u32,
                nh as u32, 0 as u32)
        }
        return 0 as u64
    }
    // ROUND C-049 -- AFTER MAXIMISING CALCULATE THE FRAME ANEW.
    //
    // WM_NCCALCSIZE does NOT come again by itself when only
    // the state (maximised/restored) changes. Without this
    // line a window that has just been maximised keeps the box of the
    // restored one -- and protrudes over the screen by the frame.
    // SWP_FRAMECHANGED = 32, plus NOMOVE(2) NOSIZE(1) NOZORDER(4)
    // NOACTIVATE(16) = 55.
    if m == WM_WINDOWPOSCHANGED {
        if (*w).frame != 0 {
            let now: bool = ist_max(w)
            let alt: bool = (*w).war_max != 0
            if now != alt {
                if now {
                    (*w).war_max = 1
                } else {
                    (*w).war_max = 0
                }
                SetWindowPos((*w).hwnd, 0, 0, 0, 0, 0, 55)
            }
        }
        return DefWindowProcW(hwnd as i64, m, wp as i64,
            lp as i64) as u64
    }
    if m == WM_DPICHANGED {
        // W4: the size stays, the density does not. EV_CONFIGURE with
        // the known size makes lib/window read `dpi` anew and the
        // program re-lay out.
        push_ev(w, window.EV_CONFIGURE, 0 as u32, (*w).w as u32,
            (*w).h as u32, 0 as u32)
        return DefWindowProcW(hwnd as i64, m, wp as i64, lp as i64) as u64
    }
    if m == WM_DROPFILES {
        on_dropfiles(w, wp as i64)
        return 0 as u64
    }
    if m == WM_DESTROYCLIPBOARD {
        (*w).clip_own = false // somebody else copied: what we offered is gone
        return 0 as u64
    }
    if m == WM_CLOSE {
        push_ev(w, window.EV_CLOSED, 0 as u32, 0 as u32, 0 as u32,
            0 as u32)
        return 0 as u64
    }
    if m == WM_DESTROY {
        push_ev(w, window.EV_CLOSED, 0 as u32, 0 as u32, 0 as u32,
            0 as u32)
        PostQuitMessage(0)
        return 0 as u64
    }
    if m == WM_KEYDOWN || m == WM_SYSKEYDOWN {
        let k: u32 = vkey(wp as i64)
        if k != 0 as u32 {
            push_ev(w, window.EV_KEY, k, 0 as u32, 0 as u32, state())
        }
        return DefWindowProcW(hwnd as i64, m, wp as i64, lp as i64) as u64
    }
    if m == WM_CHAR {
        let c: i64 = wp as i64
        // ==============================================================
        // ROUND fUi -- THE CTRL SHORTCUTS NEVER ARRIVED
        // ==============================================================
        //
        // Here stood `if c >= 32 && c != 127`, and that swallowed EVERY
        // Steuerzeichen verworfen. Die Begruendung daneben lautete
        // "control characters have already come through as a key" -- and it
        // holds for backspace, tab and enter. For CTRL+LETTER it does NOT
        // hold: Windows sends Ctrl+A as WM_CHAR with the value 1, Ctrl+C as
        // 3, Ctrl+V as 22. A WM_KEYDOWN with the letter does arrive too, but
        // `vkey` does not map letters (the table knows only the thirteen keys
        // with a meaning).
        // Bedeutung) -- also fiel Strg+A auf BEIDEN Wegen heraus.
        //
        // MEASURED: under X11 Ctrl+A worked at once after the address bar was
        // rebuilt (there `key_ascii` delivers the letter and the modifier
        // separately), under Wine the selection stayed at 0 pixels and the
        // text at 189 pixels width -- the same number before and after typing,
        // so no selection at all.
        // Wirkung.
        //
        // NOW: 1..26 pass through as control characters when Ctrl is really
        // pressed. The three that also arise WITHOUT Ctrl stay out -- they are
        // already on their way as a key and would otherwise come twice:
        //
        //     8  Rueckschritt (K_BACK)
        //     9  Tabulator    (K_TAB)
        //     13 Eingabe      (K_RETURN)
        let st: u32 = state()
        let with_ctrl: bool = (st & 4 as u32) != 0 as u32
        let is_shortcut: bool = c >= 1 && c <= 26 && c != 8 && c != 9
        && c != 13
        if (c >= 32 && c != 127) || (with_ctrl && is_shortcut) {
            push_ev(w, window.EV_CHAR, c as u32, 0 as u32, 0 as u32,
                st)
        }
        return 0 as u64
    }
    if m == WM_LBUTTONDOWN || m == WM_RBUTTONDOWN || m == WM_MBUTTONDOWN {
        let l: i64 = lp as i64
        var px: i64 = l & 65535
        var py: i64 = (l >> 16) & 65535
        if px > 32767 {
            px = 0
        }
        if py > 32767 {
            py = 0
        }
        var knopf: u32 = window.BTN_LEFT
        if m == WM_RBUTTONDOWN {
            knopf = window.BTN_RIGHT
        }
        if m == WM_MBUTTONDOWN {
            knopf = window.BTN_MIDDLE
        }
        push_ev(w, window.EV_BUTTON, knopf, px as u32, py as u32,
            state())
        return 0 as u64
    }
    if m == WM_MOUSEMOVE {
        let l: i64 = lp as i64
        var px: i64 = l & 65535
        var py: i64 = (l >> 16) & 65535
        // A negative value arrives as a 65535 complement -- the pointer is
        // then left of or above the window, so on no button.
        if px > 32767 {
            px = 0
        }
        if py > 32767 {
            py = 0
        }
        push_ev(w, window.EV_MOTION, 0 as u32, px as u32, py as u32,
            state())
        return 0 as u64
    }
    if m == WM_SETTINGCHANGE {
        // `lParam` is a pointer to a UTF-16 string or 0.
        if is_colour_set(lp) {
            read_theme(w)
            // The system now stands differently -- the bar with it.
            bar_apply(w)
            push_ev(w, window.EV_THEME, 0 as u32, 0 as u32, 0 as u32,
                0 as u32)
        }
        return DefWindowProcW(hwnd as i64, m, wp as i64, lp as i64) as u64
    }
    if m == WM_MOUSEWHEEL {
        let d: i64 = ((wp as i64) >> 16) & 65535
        var up: bool = true
        if d >= 32768 {
            up = false
        }
        if up {
            push_ev(w, window.EV_BUTTON, window.BTN_WHEEL_UP, 0 as u32,
                0 as u32, state())
        } else {
            push_ev(w, window.EV_BUTTON, window.BTN_WHEEL_DOWN,
                0 as u32, 0 as u32, state())
        }
        return 0 as u64
    }
    return DefWindowProcW(hwnd as i64, m, wp as i64, lp as i64) as u64
}

// ========================================================= HELL/DUNKEL
//
// W5. Windows keeps the setting as a DWORD in the registry:
//
//     HKEY_CURRENT_USER
//       \Software\Microsoft\Windows\CurrentVersion\Themes\Personalize
//         AppsUseLightTheme   0 = dark, 1 = hell
//
// Besides it there is `SystemUsesLightTheme` -- that is the taskbar
// and the start menu, NOT the applications.
//
// `RegGetValueW` does opening, reading, type checking and closing in
// ONE call. IF THE VALUE IS MISSING (Windows before 1809, server
// images, a fresh profile) or the read fails: LIGHT.
const HKCU: i64 = 2147483649
const RRF_DWORD: i64 = 16

// ASCII to UTF-16, with `/` as a stand-in for the backslash: a literal
// with doubled backslashes makes the registry paths unreadable, and a
// wrongly counted length would then not show up here but only as
// "value not found".
fn wide(src: u64, n: usize, dst: u64) {
    var i: usize = 0
    while i < n {
        var c: u16 = rt.ld8(src, i) as u16
        if c == 47 as u16 {
            c = 92 as u16
        }
        rt.st16(dst, i, c)
        i = i + 1
    }
    rt.st16(dst, n, 0 as u16)
}

fn read_theme(w: *mut Platte) {
    var sub: [u8; 60] = "Software/Microsoft/Windows/CurrentVersion/Themes/Personalize"
    var nam: [u8; 17] = "AppsUseLightTheme"
    var wsub: [u16; 64] = [0; 64]
    var wnam: [u16; 24] = [0; 24]
    wide((&sub[0]) as u64, 60, (&wsub[0]) as u64)
    wide((&nam[0]) as u64, 17, (&wnam[0]) as u64)
    var value: [u32; 1] = [0; 1]
    var cb: [u32; 1] = [0; 1]
    cb[0] = 4 as u32
    let rc: i32 = RegGetValueW(HKCU, (&wsub[0]) as u64,
        (&wnam[0]) as u64, RRF_DWORD, 0 as u64, (&value[0]) as u64,
        (&cb[0]) as u64)
    if rc != 0 {
        // ERROR_SUCCESS is 0. Anything else: the value is not there.
        (*w).dark = false
        (*w).dark_known = false
        return
    }
    (*w).dark_known = true
    // 0 = dark, 1 = hell.
    (*w).dark = value[0] == 0 as u32
}

fn r_dark(w: *mut Platte) -> bool {
    return (*w).dark
}

fn r_dark_known(w: *mut Platte) -> bool {
    return (*w).dark_known
}

// ================================================= THE TITLE BAR (C-039)
//
// It is set anew on EVERY occasion at which something can
// change: when creating the window, when switching the
// scheme and when the program gives a colour of its own. That is
// cheap (one call, no redraw) and saves the question whether the
// window already stood at time X.
//
// WHY BOTH ATTRIBUTE NUMBERS. See above at the constants: 20 applies
// from 20H1, 19 on the builds before. 20 is set first; only if
// that fails is 19 tried. An unknown attribute returns
// E_INVALIDARG and does no harm.
fn bar_apply(w: *mut Platte) {
    if (*w).hwnd == 0 {
        return
    }
    // BOOL ist 4 Oktett. 1 = die Leiste dunkel zeichnen.
    var an: [u32; 1] = [0; 1]
    if (*w).dark {
        an[0] = 1 as u32
    }
    let rc: i32 = DwmSetWindowAttribute((*w).hwnd,
        DWMWA_USE_IMMERSIVE_DARK_MODE, (&an[0]) as u64, 4)
    if rc != 0 {
        DwmSetWindowAttribute((*w).hwnd,
            DWMWA_USE_IMMERSIVE_DARK_MODE_ALT, (&an[0]) as u64, 4)
    }
    // And the exact colour, if the program has named one.
    // Windows 10 does not know the attribute and returns E_INVALIDARG --
    // then it stays with the pure light/dark switch above,
    // and that is exactly the desired behaviour.
    if (*w).bar_at != 0 as u32 {
        var c: [u32; 1] = [0; 1]
        c[0] = cref_u32((*w).bar_rgb)
        DwmSetWindowAttribute((*w).hwnd, DWMWA_CAPTION_COLOR,
            (&c[0]) as u64, 4)
    }
}

// 0xRRGGBB -> COLORREF 0x00BBGGRR. The same as `cref`, but on u32
// and without the detour via i64 -- DwmSetWindowAttribute wants a
// pointer to exactly four octets.
fn cref_u32(c: u32) -> u32 {
    let r: u32 = (c >> 16) & 255 as u32
    let g: u32 = (c >> 8) & 255 as u32
    let b: u32 = c & 255 as u32
    return (b << 16) | (g << 8) | r
}

// THE MANUAL SWITCH. `theme_aufloesen` in lib/window/window.fi calls
// this also if the scheme does NOT come from the system (--theme=dark)
// -- otherwise a light bar would stand above a dark shell.
fn r_titlebar_dark(w: *mut Platte, dunkel: bool) {
    (*w).dark = dunkel
    (*w).dark_known = true
    bar_apply(w)
}

// The program passes on the colour of the shell. `r_titlebar_colour(w, 0)`
// takes it back.
fn r_titlebar_colour(w: *mut Platte, rgb: u32, an: bool) {
    (*w).bar_rgb = rgb
    if an {
        (*w).bar_at = 1 as u32
    } else {
        (*w).bar_at = 0 as u32
    }
    bar_apply(w)
}

// --------------------------------------------------------- the window

// Registers the class and sets the pixel density right. MUST come
// before the window: whoever sets the DPI awareness only afterwards no
// longer has it, and Windows then stretches the image with the result
// that on Android was the blurriness -- only this time produced by the system.
fn r_open(w: *mut Platte, disp: usize) -> bool {
    // DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2 = (HANDLE)-4.
    SetProcessDpiAwarenessContext(0 - 4)
    let inst: i64 = GetModuleHandleW(0)
    var cls: [u16; 10] = u"FirnFenst\0"
    // WNDCLASSW, Win64: style(4)+Fuellung(4), lpfnWndProc(8),
    // cbClsExtra(4), cbWndExtra(4), hInstance(8), hIcon(8), hCursor(8),
    // hbrBackground(8), lpszMenuName(8), lpszClassName(8) = 72 Oktett.
    var wc: [u8; 72] = [0; 72]
    let p: u64 = (&wc[0]) as u64
    // CS_HREDRAW | CS_VREDRAW | CS_OWNDC = 2 | 1 | 32
    rt.st32(p, 0, 35 as u32)
    rt.st64(p, 1, code_of4(wndproc))
    rt.st64(p, 3, inst as u64)
    // IDC_ARROW = 32512
    rt.st64(p, 5, LoadCursorW(0, 32512) as u64)
    // hbrBackground = 0: Windows erases nothing, we cover everything.
    rt.st64(p, 8, (&cls[0]) as u64)
    if RegisterClassW(p) == 0 {
        return false
    }
    (*w).open = true
    read_theme(w)
    return true
}

// THE POISON -- HOW TO REALLY MEASURE "UNPAINTED". Counting pure black
// is no good: a page with black text has thousands of black pixels.
// The fresh DIB is therefore filled with pure magenta; whatever is
// still magenta afterwards has seen no `r_image` and no
// `r_fill` je angefasst.
fn r_poison(w: *mut Platte, an: bool) {
    if an {
        (*w).gift = 1
    } else {
        (*w).gift = 0
    }
}

fn poison_fill(w: *mut Platte) {
    if (*w).gift == 0 || (*w).bits == 0 {
        return
    }
    var y: usize = 0
    while y < (*w).h {
        var x: usize = 0
        while x < (*w).w {
            let o: u64 = (*w).bits + (y * (*w).stride + x * 4) as u64
            rt.st8(o, 0, 255 as u8)
            rt.st8(o, 1, 0 as u8)
            rt.st8(o, 2, 255 as u8)
            rt.st8(o, 3, 0 as u8)
            x = x + 1
        }
        y = y + 1
    }
}

fn dib_make(w: *mut Platte, cw: usize, ch: usize) -> bool {
    let dc: i64 = GetDC((*w).hwnd)
    if dc == 0 {
        return false
    }
    // BITMAPINFOHEADER, 40 octets. biHeight NEGATIVE = top to bottom, see
    // the header of this file.
    var bi: [u8; 48] = [0; 48]
    let b: u64 = (&bi[0]) as u64
    rt.st32(b, 0, 40 as u32)
    rt.st32(b, 1, cw as u32)
    // biHeight negative, in two's complement -- Firn does not silently
    // convert a negative i64 into a u32, and exactly this
    // Zahl ist die Zeilenrichtung.
    let negh: u64 = 4294967296 - (ch as u64)
    rt.st32(b, 2, negh as u32)
    rt.st16(b, 6, 1 as u16)
    rt.st16(b, 7, 32 as u16)
    rt.st32(b, 4, 0 as u32)
    var out: [u64; 1] = [0; 1]
    let hbm: i64 = CreateDIBSection(dc, b, 0, (&out[0]) as u64, 0, 0)
    let mdc: i64 = CreateCompatibleDC(dc)
    ReleaseDC((*w).hwnd, dc)
    if hbm == 0 || mdc == 0 {
        return false
    }
    (*w).hbm = hbm
    (*w).hdc_mem = mdc
    (*w).hbm_old = SelectObject(mdc, hbm)
    (*w).bits = out[0]
    (*w).w = cw
    (*w).h = ch
    // 32 bits per pixel: the row is always aligned to 4 octets anyway.
    // Still it stands here as a field and is nowhere
    // geraten.
    (*w).stride = cw * 4
    SetBkMode(mdc, 2)
    poison_fill(w)
    return true
}

fn dib_free(w: *mut Platte) {
    if (*w).hdc_mem != 0 {
        SelectObject((*w).hdc_mem, (*w).hbm_old)
        DeleteDC((*w).hdc_mem)
        (*w).hdc_mem = 0
    }
    if (*w).hbm != 0 {
        DeleteObject((*w).hbm)
        (*w).hbm = 0
    }
    (*w).bits = 0
}

// The WORK AREA of the screen (without the taskbar), in pixels.
// `false` when Windows does not hand it over -- then the caller's
// fixed default stands.
fn r_screen(w: *mut Platte, sw: *mut usize, sh: *mut usize) -> bool {
    var r: [i32; 4] = [0; 4]
    // SPI_GETWORKAREA = 0x0030
    if SystemParametersInfoW(48, 0, (&r[0]) as u64, 0) == 0 {
        return false
    }
    let bw: i64 = (r[2] as i64) - (r[0] as i64)
    let bh: i64 = (r[3] as i64) - (r[1] as i64)
    if bw <= 0 || bh <= 0 {
        return false
    }
    *sw = bw as usize
    *sh = bh as usize
    return true
}

// Put the window into the middle of the work area. SWP_NOSIZE = 1,
// SWP_NOZORDER = 4, SWP_NOACTIVATE = 16.
fn r_centre(w: *mut Platte) -> bool {
    if (*w).hwnd == 0 {
        return false
    }
    var r: [i32; 4] = [0; 4]
    if SystemParametersInfoW(48, 0, (&r[0]) as u64, 0) == 0 {
        return false
    }
    var wr: [i32; 4] = [0; 4]
    if GetWindowRect((*w).hwnd, (&wr[0]) as u64) == 0 {
        return false
    }
    let fw: i64 = (wr[2] as i64) - (wr[0] as i64)
    let fh: i64 = (wr[3] as i64) - (wr[1] as i64)
    let x: i64 = (r[0] as i64) + (((r[2] as i64) - (r[0] as i64) - fw) / 2)
    let y: i64 = (r[1] as i64) + (((r[3] as i64) - (r[1] as i64) - fh) / 2)
    return SetWindowPos((*w).hwnd, 0, x, y, 0, 0, 21) != 0
}

fn r_make(w: *mut Platte, cw: usize, ch: usize) -> bool {
    if !(*w).open {
        return false
    }
    var cls: [u16; 10] = u"FirnFenst\0"
    var title: [u16; 7] = u"Window\0"
    // WS_OVERLAPPEDWINDOW = 0x00CF0000
    let style: i64 = 13565952
    // The inner area shall be exactly cw x ch -- otherwise Windows
    // measures including frame and title bar, and the content would be
    // gemessen.
    var r: [i32; 4] = [0; 4]
    r[0] = 0
    r[1] = 0
    r[2] = cw as i32
    r[3] = ch as i32
    AdjustWindowRectEx((&r[0]) as u64, style, 0, 0)
    let ow: i64 = (r[2] as i64) - (r[0] as i64)
    let oh: i64 = (r[3] as i64) - (r[1] as i64)
    let inst: i64 = GetModuleHandleW(0)
    let h: i64 = CreateWindowExW(0, (&cls[0]) as u64, (&title[0]) as u64,
        style, 100, 100, ow, oh, 0, 0, inst, 0)
    if h == 0 {
        return false
    }
    (*w).hwnd = h
    // GWLP_USERDATA = -21. Ab hier findet die Fensterprozedur ihren
    // state again without needing a global variable.
    SetWindowLongPtrW(h, 0 - 21, (w as usize) as i64)
    // ROUND C-039: bring the title bar INTO THE STYLE AT ONCE -- even
    // before the window is shown. Whoever colours it only after `ShowWindow`
    // sees it flash up light for the blink of an eye.
    bar_apply(w)
    let d: i32 = GetDpiForWindow(h)
    if d > 0 {
        (*w).dpi = d as usize
    }
    if !dib_make(w, cw, ch) {
        return false
    }
    return true
}

// THE RESIZE. Without it the DIB stays as large as it was at creation,
// and `r_blit` keeps pushing a 1024x768 rectangle into a larger
// window: right and below stays whatever Windows had there -- the
// black hole on Justin's screenshot.
//
// The DIB is CREATED ANEW and not stretched. A stretched canvas would
// be exactly the bug round MOBIL5 measured on Android (the
// blurriness): rasterising happens in device pixels.
fn r_maximise(w: *mut Platte, cw: usize, ch: usize) -> bool {
    if !(*w).open || (*w).hwnd == 0 {
        return false
    }
    if cw == 0 || ch == 0 {
        return false
    }
    if cw == (*w).w && ch == (*w).h {
        return true
    }
    dib_free(w)
    if !dib_make(w, cw, ch) {
        return false
    }
    return true
}

// Is the user dragging the window edge right now? (Windows: between
// WM_ENTERSIZEMOVE and WM_EXITSIZEMOVE.)
#[no_gc]
fn r_dragging(w: *mut Platte) -> bool { return (*w).dragging != 0 }

fn r_show(w: *mut Platte) -> bool {
    // SW_SHOW = 5
    ShowWindow((*w).hwnd, 5)
    UpdateWindow((*w).hwnd)
    return true
}

// The title comes in as UTF-8, SetWindowTextW wants UTF-16.
// Until 0.52 EVERY BYTE was widened individually to u16 here -- that is
// Latin-1, not UTF-8. From `"fuer"` (66 C3 BC 72) therefore in the
// title bar "fA1/4r" resulted, and from the dash three characters.
// Justin reported it on 18.09.2026 at "XOFFI - ... fA1/4r KMU".
// Now it is decoded correctly, with a surrogate pair for everything above U+FFFF.
fn r_title(w: *mut Platte, p: u64, n: usize) -> bool {
    var u: [u16; 512] = [0; 512]
    var i: usize = 0
    var o: usize = 0
    while i < n && o < 510 {
        let c0: u32 = rt.ld8(p, i) as u32
        var cp: u32 = 0 as u32
        if c0 < 0x80 as u32 {
            cp = c0
            i = i + 1
        } else if c0 >= 0xF0 as u32 && i + 3 < n {
            cp = ((c0 & 0x07 as u32) << 18) |
            ((rt.ld8(p, i + 1) as u32 & 0x3F as u32) << 12) |
            ((rt.ld8(p, i + 2) as u32 & 0x3F as u32) << 6) |
            (rt.ld8(p, i + 3) as u32 & 0x3F as u32)
            i = i + 4
        } else if c0 >= 0xE0 as u32 && i + 2 < n {
            cp = ((c0 & 0x0F as u32) << 12) |
            ((rt.ld8(p, i + 1) as u32 & 0x3F as u32) << 6) |
            (rt.ld8(p, i + 2) as u32 & 0x3F as u32)
            i = i + 3
        } else if c0 >= 0xC0 as u32 && i + 1 < n {
            cp = ((c0 & 0x1F as u32) << 6) |
            (rt.ld8(p, i + 1) as u32 & 0x3F as u32)
            i = i + 2
        } else {
            // Broken byte: replacement character, so that the title does not break off.
            cp = 0xFFFD as u32
            i = i + 1
        }
        if cp >= 0x10000 as u32 {
            let v: u32 = cp - 0x10000 as u32
            u[o] = (0xD800 as u32 + (v >> 10)) as u16
            u[o + 1] = (0xDC00 as u32 + (v & 0x3FF as u32)) as u16
            o = o + 2
        } else {
            u[o] = cp as u16
            o = o + 1
        }
    }
    u[o] = 0 as u16
    return SetWindowTextW((*w).hwnd, (&u[0]) as u64) != 0
}

// ---------------------------------------------------------- painting

// A finished BGRX buffer, row by row into the DIB.
fn r_image(w: *mut Platte, px: u64, iw: usize, ih: usize, dx: usize,
    dy: usize) -> bool {
    if (*w).bits == 0 {
        return false
    }
    GdiFlush()
    var y: usize = 0
    while y < ih {
        let ty: usize = dy + y
        if ty >= (*w).h {
            break
        }
        var n: usize = iw
        if dx + n > (*w).w {
            if dx >= (*w).w {
                n = 0
            } else {
                n = (*w).w - dx
            }
        }
        if n > 0 {
            rt.mem_copy((*w).bits + (ty * (*w).stride + dx * 4) as u64,
                px + (y * iw * 4) as u64, n * 4)
        }
        y = y + 1
    }
    return true
}

// A rectangle in one colour. `px` is 0xRRGGBB; in the DIB lie B, G, R, X.
fn r_fill(w: *mut Platte, px: u32, x0: usize, y0: usize, fw: usize,
    fh: usize) -> bool {
    if (*w).bits == 0 {
        return false
    }
    GdiFlush()
    let b: u8 = (px & 255 as u32) as u8
    let g: u8 = ((px >> 8) & 255 as u32) as u8
    let r: u8 = ((px >> 16) & 255 as u32) as u8
    var y: usize = 0
    while y < fh {
        let ty: usize = y0 + y
        if ty >= (*w).h {
            break
        }
        var x: usize = 0
        while x < fw {
            let tx: usize = x0 + x
            if tx >= (*w).w {
                break
            }
            let o: u64 = (*w).bits + (ty * (*w).stride + tx * 4) as u64
            rt.st8(o, 0, b)
            rt.st8(o, 1, g)
            rt.st8(o, 2, r)
            rt.st8(o, 3, 0 as u8)
            x = x + 1
        }
        y = y + 1
    }
    return true
}

// There is no font to open: the device context already has one.
// SYSTEM_FIXED_FONT = 16 -- the same that the X11 backend has with
// Serverschrift "fixed" tut.
fn r_font(w: *mut Platte) -> bool {
    if (*w).hdc_mem == 0 {
        return false
    }
    let f: i64 = GetStockObject(16)
    if f != 0 {
        SelectObject((*w).hdc_mem, f)
    }
    return true
}

// 0xRRGGBB -> COLORREF 0x00BBGGRR.
fn cref(c: u32) -> i64 {
    let r: i64 = ((c >> 16) & 255 as u32) as i64
    let g: i64 = ((c >> 8) & 255 as u32) as i64
    let b: i64 = (c & 255 as u32) as i64
    return b * 65536 + g * 256 + r
}

// Text into the drawing surface. `ty` is the BASELINE, as with X11 --
// TextOut wants the top edge, and twelve pixels is the height of the
// system fixed font above the baseline.
fn r_text(w: *mut Platte, fg: u32, bg: u32, tx: usize, ty: usize, p: u64,
    n: usize) -> bool {
    if (*w).hdc_mem == 0 {
        return false
    }
    SetTextColor((*w).hdc_mem, cref(fg))
    SetBkColor((*w).hdc_mem, cref(bg))
    var top: i64 = (ty as i64) - 12
    if top < 0 {
        top = 0
    }
    return TextOutA((*w).hdc_mem, tx as i64, top, p, n as i64) != 0
}

// The one blit: the whole drawing surface onto the screen.
// SRCCOPY = 0x00CC0020.
fn r_present(w: *mut Platte) -> bool {
    if (*w).hwnd == 0 || (*w).hdc_mem == 0 {
        return false
    }
    let dc: i64 = GetDC((*w).hwnd)
    if dc == 0 {
        return false
    }
    let ok: i32 = BitBlt(dc, 0, 0, (*w).w as i64, (*w).h as i64,
        (*w).hdc_mem, 0, 0, 13369376)
    ReleaseDC((*w).hwnd, dc)
    return ok != 0
}

// THE CAPTURE OF WHAT REALLY STANDS ON THE SCREEN: THE DIB, so exactly
// the octets that `r_blit` pushes into the window. P6.
fn r_ppm(w: *mut Platte, path: u64) -> bool {
    if (*w).bits == 0 {
        return false
    }
    GdiFlush()
    var b: rt.Buf = rt.buf_new()
    var p6: [u8; 3] = "P6\n"
    rt.buf_push_bytes(&b, (&p6[0]) as u64, 3)
    rt.buf_push_dec_u64(&b, (*w).w as u64)
    rt.buf_push(&b, 32 as u8)
    rt.buf_push_dec_u64(&b, (*w).h as u64)
    rt.buf_push(&b, 10 as u8)
    var m255: [u8; 4] = "255\n"
    rt.buf_push_bytes(&b, (&m255[0]) as u64, 4)
    var y: usize = 0
    while y < (*w).h {
        var x: usize = 0
        while x < (*w).w {
            let o: u64 = (*w).bits + (y * (*w).stride + x * 4) as u64
            // Im DIB liegen B, G, R, X; PPM will R, G, B.
            rt.buf_push(&b, rt.ld8(o, 2))
            rt.buf_push(&b, rt.ld8(o, 1))
            rt.buf_push(&b, rt.ld8(o, 0))
            x = x + 1
        }
        y = y + 1
    }
    let ok: bool = rt.write_file(path, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    return ok
}

// ------------------------------------------------- die Nachrichtenrunde
//
// `wait_ms` < 0 means "wait_event until something comes", 0 means
// "only look". Waiting uses MsgWaitForMultipleObjectsEx and not
// GetMessage, because a frame loop needs a DEADLINE: while scrolling,
// the next frame tick must come even when
// niemand die Maus bewegt.
fn pumpe(w: *mut Platte, wait_ms: i64) {
    if !r_pending(w) && wait_ms != 0 {
        var ms: i64 = wait_ms
        if ms < 0 {
            ms = 4294967295
        }
        // QS_ALLINPUT = 0x04FF
        MsgWaitForMultipleObjectsEx(0, 0, ms, 1279, 0)
    }
    var m: [u8; 64] = [0; 64]
    let mp: u64 = (&m[0]) as u64
    // PM_REMOVE = 1
    while PeekMessageW(mp, 0, 0, 0, 1) != 0 {
        TranslateMessage(mp)
        DispatchMessageW(mp)
    }
    if (*w).hwnd != 0 {
        if IsWindow((*w).hwnd) == 0 {
            (*w).hwnd = 0
            push_ev(w, window.EV_CLOSED, 0 as u32, 0 as u32, 0 as u32,
                0 as u32)
        }
    }
}

fn r_wait(w: *mut Platte, ms: i64) -> bool {
    if r_pending(w) {
        return true
    }
    pumpe(w, ms)
    return r_pending(w)
}

fn r_close(w: *mut Platte) {
    dib_free(w)
    if (*w).hwnd != 0 {
        if IsWindow((*w).hwnd) != 0 {
            DestroyWindow((*w).hwnd)
        }
        (*w).hwnd = 0
    }
    (*w).open = false
}

// ======================================================================
// ROUND C-038 -- "CHECK FOR UPDATE" REALLY STARTS SOMETHING
// ======================================================================
//
// Until 0.57 the menu item was a dummy: `certus_app.fi` treated
// M_AKTUALISIEREN like M_UEBER and only opened `certus://ueber`. The
// comment next to it justified that by saying that a network fetch of its own from
// the picture loop would be a second, blocking `fetch`. That
// is true -- and not necessary at all:
//
// NEXT TO certus.exe LIES certus-update.exe (source tools/windows/
// update.c). It can already do everything, and in a PROCESS OF ITS OWN:
//   certus-update.exe            check silently
//   certus-update.exe --pruefen  return 10 = there is something new
//   certus-update.exe `--jetzt`    download and install with
//                                checksum verification, with a confirmation prompt
// Since commit 5715d3a0 it gets the installed version from
// `fassung.txt` next to the exe -- that is built on here, nothing
// of it is touched.
//
// NO WAITING. `CreateProcessW` returns at once, the
// two handles are closed right away. Certus keeps painting in the same
// millisecond; the updater brings its own window along. Exactly that is why here there stands NO `WaitForSingleObject`.
//
// THE PATH IS NOT GUESSED. `GetModuleFileNameW` gives the full
// path of the RUNNING exe; it is cut off behind the last "\"
// and "certus-update.exe" appended. A fixed path would be wrong
// as soon as somebody installs Certus somewhere else -- and the installer
// leaves the choice.
//
// Return: false if the process did not start (exe missing, because
// somebody copied only certus.exe). The caller tells the user so,
// instead of pretending that something is running.
fn r_update_start(with_window: bool) -> bool {
    // Fetch the two addresses at run time (see the head of this
    // file: they do not stand in the import list).
    var s_gmf: [u8; 19] = "GetModuleFileNameW\0"
    var s_cp: [u8; 15] = "CreateProcessW\0"
    let a_gmf: u64 = kernel32_get((&s_gmf[0]) as u64)
    let a_cp: u64 = kernel32_get((&s_cp[0]) as u64)
    if a_gmf == 0 || a_cp == 0 {
        return false
    }

    // The path of the running exe, UTF-16.
    var path: [u16; 320] = [0; 320]
    let n: i32 = call_module_name(a_gmf, 0, (&path[0]) as u64, 320)
    if n <= 0 || n >= 320 {
        return false
    }
    // Cut off behind the last "\". 92 is "\".
    var i: usize = n as usize
    var cut: usize = 0
    while i > 0 {
        i = i - 1
        if rt.ld16((&path[0]) as u64, i) == 92 as u16 {
            cut = i + 1
            break
        }
    }
    if cut == 0 {
        return false
    }
    // "certus-update.exe" behind it, character by character.
    var name: [u16; 18] = u"certus-update.exe\0"
    var j: usize = 0
    while j < 18 && cut + j < 319 {
        let c: u16 = rt.ld16((&name[0]) as u64, j)
        rt.st16((&path[0]) as u64, cut + j, c)
        if c == 0 as u16 {
            break
        }
        j = j + 1
    }
    rt.st16((&path[0]) as u64, 319, 0 as u16)

    // The command line. CreateProcessW MAY change it, so it stands
    // in a writable field of its own -- a literal would be
    // write-protected. The first word is the program name, that is what the
    // rule wants.
    var line: [u16; 64] = [0; 64]
    var z0: [u16; 26] = u"certus-update.exe --jetzt\0"
    var k: usize = 0
    while k < 26 {
        rt.st16((&line[0]) as u64, k, rt.ld16((&z0[0]) as u64, k))
        k = k + 1
    }
    if !with_window {
        // Without `"--jetzt"`: check silently, report only if there is something.
        rt.st16((&line[0]) as u64, 17, 0 as u16)
    }

    // STARTUPINFOW is 104 octets on Win64, PROCESS_INFORMATION 24.
    // `cb` right at the front must carry the size, otherwise Windows refuses.
    var si: [u8; 104] = [0; 104]
    var pi: [u8; 24] = [0; 24]
    rt.st32((&si[0]) as u64, 0, 104 as u32)
    // CREATE_NO_WINDOW = 0x08000000 -- the updater is a
    // window program, but this way surely no console stands next to it.
    let ok: i32 = call_process(a_cp, (&path[0]) as u64,
        (&line[0]) as u64, 0, 0, 0, 134217728, 0, 0,
        (&si[0]) as u64, (&pi[0]) as u64)
    if ok == 0 {
        return false
    }
    // Do NOT wait. Only give the handles back, otherwise the
    // process stays standing as a zombie until Certus ends.
    CloseHandle(rt.ld64((&pi[0]) as u64, 0) as i64)
    CloseHandle(rt.ld64((&pi[0]) as u64, 1) as i64)
    return true
}

// ======================================================================
// ROUND C-049 -- WHAT THE PROGRAM CAN DEMAND OF THE FRAME
// ======================================================================

fn r_frame_can(w: *mut Platte) -> bool { return true }

// Switch the frame of its own on or off. SetWindowPos with
// SWP_FRAMECHANGED is the command that forces Windows to ask WM_NCCALCSIZE
// ONCE MORE -- without it the title bar stays standing
// until you change the size of the window for the first time.
fn r_frame_own(w: *mut Platte, an: bool) -> bool {
    if an {
        (*w).frame = 1
    } else {
        (*w).frame = 0
    }
    if (*w).hwnd != 0 {
        if ist_max(w) {
            (*w).war_max = 1
        } else {
            (*w).war_max = 0
        }
        // 32 = SWP_FRAMECHANGED, + NOMOVE|NOSIZE|NOZORDER|NOACTIVATE
        SetWindowPos((*w).hwnd, 0, 0, 0, 0, 0, 55)
        // ---- HERE LAY THE LAST ERROR OF THIS ROUND (measured in the
        // capture: the red close button ended 8 points before the
        // window edge, on the right stood 8 points of white).
        //
        // SWP_FRAMECHANGED makes Windows ask WM_NCCALCSIZE anew --
        // and from then on the CONTENT is the whole window, so 8 points
        // wider than before. Windows does NOT send a WM_SIZE in doing so
        // (the OUTER dimensions have not changed, after all). The program
        // thus learns nothing of the 8 points, keeps painting onto the
        // old canvas, and on the right a white strip stays standing.
        //
        // So the new content size is fetched here itself and reported as
        // EV_CONFIGURE -- the same way that WM_SIZE goes.
        var cr: [i32; 4] = [0; 4]
        if GetClientRect((*w).hwnd, (&cr[0]) as u64) != 0 {
            let nw: i64 = (cr[2] as i64) - (cr[0] as i64)
            let nh: i64 = (cr[3] as i64) - (cr[1] as i64)
            if nw > 0 && nh > 0 {
                push_ev(w, window.EV_CONFIGURE, 0 as u32, nw as u32,
                    nh as u32, 0 as u32)
            }
        }
    }
    return (*w).frame != 0
}

// THE REAL CONTENT SIZE, asked directly of the operating system.
//
// `r_width`/`r_height` return what the canvas HAS. After
// SWP_FRAMECHANGED the content is already larger, however, while the
// canvas still carries the old dimensions -- exactly this gap was the
// 8 white points on the right. Whoever needs the new number has to
// ASK for it, not read it off the canvas.
//
// Returns false if there is none (then everything stays as it was).
fn r_content_size(w: *mut Platte, bw: *mut usize, bh: *mut usize) -> bool {
    if (*w).hwnd == 0 {
        return false
    }
    var cr: [i32; 4] = [0; 4]
    if GetClientRect((*w).hwnd, (&cr[0]) as u64) == 0 {
        return false
    }
    let nw: i64 = (cr[2] as i64) - (cr[0] as i64)
    let nh: i64 = (cr[3] as i64) - (cr[1] as i64)
    if nw <= 0 || nh <= 0 {
        return false
    }
    *bw = nw as usize
    *bh = nh as usize
    return true
}

// How high the row is that the program paints as a title bar, and
// which strip in it belongs to its window buttons. Both in
// ONE call, because both belong together: a header height without the
// button zone would be a window that moves when "Close" is pressed.
fn r_frame_height(w: *mut Platte, h: usize) {
    (*w).header_h = h
}

fn r_button_zone(w: *mut Platte, x0: usize, x1: usize) {
    (*w).knopf_x0 = x0
    (*w).knopf_x1 = x1
}

fn r_minimise(w: *mut Platte) {
    if (*w).hwnd != 0 {
        PostMessageW((*w).hwnd, WM_SYSCOMMAND, SC_MINIMIZE, 0)
    }
}

fn r_max_toggle(w: *mut Platte) {
    if (*w).hwnd == 0 {
        return
    }
    if ist_max(w) {
        PostMessageW((*w).hwnd, WM_SYSCOMMAND, SC_RESTORE, 0)
    } else {
        PostMessageW((*w).hwnd, WM_SYSCOMMAND, SC_MAXIMIZE, 0)
    }
}

fn r_maximised(w: *mut Platte) -> bool {
    return ist_max(w)
}

// DRAGGING. The usual way is not to follow the mouse movement itself
// (that would give a window that lags behind the pointer and knows
// no Aero Snap), but to start Windows' OWN drag loop:
// release the mouse, then SC_MOUSEMOVE with HTCAPTION. With that
// the user is given snap, the screen edges and tearing off
// from the maximised state as a gift -- everything that he knows from every
// other window.
fn r_drag(w: *mut Platte) {
    if (*w).hwnd == 0 {
        return
    }
    ReleaseCapture()
    SendMessageW((*w).hwnd, WM_SYSCOMMAND, SC_MOUSEMOVE + HTCAPTION, 0)
}

// The system menu at the position of the pointer (right click on the
// bar). `TrackPopupMenu` returns the chosen command,
// because TPM_RETURNCMD (256) is set; it is then sent as a
// WM_SYSCOMMAND -- the way Windows does it itself.
fn r_sysmenu(w: *mut Platte, sx: usize, sy: usize) {
    if (*w).hwnd == 0 {
        return
    }
    let mnu: i64 = GetSystemMenu((*w).hwnd, 0)
    if mnu == 0 {
        return
    }
    // TPM_RETURNCMD(256) | TPM_RIGHTBUTTON(2) | TPM_LEFTALIGN(0)
    let cmd: i32 = TrackPopupMenu(mnu, 258, sx as i64, sy as i64, 0,
        (*w).hwnd, 0)
    if cmd != 0 {
        PostMessageW((*w).hwnd, WM_SYSCOMMAND, cmd as i64, 0)
    }
}

