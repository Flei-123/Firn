// ---- ROUND C-049: what the frame of its own additionally needs
//
// THREE of them are already bound (`GetClientRect`, `GetSystemMetrics`,
// `ReleaseCapture` stand in compiler/src/win.rs). The SIX others
// NOT -- and the import table lies in the TRANSLATOR, which this
// round shares with C-047 and C-048. An intervention there would have changed their
// running builds along with it; that is no price that a round about
// the window frame may pay.
//
// So the same way that this file already goes for kernel32
// (`kernel32_holen`): fetch at run time from user32.dll. That is no
// emergency measure, but with `GetSystemMetricsForDpi` even the RIGHT
// way -- the function exists only from Windows 10 1607, and a
// static import would not let the program start at all on older builds
// ("entry point not found").
extern fn GetClientRect(h: i64, r: u64) -> i32;
extern fn GetSystemMetrics(i: i64) -> i32;
extern fn ReleaseCapture() -> i32;

