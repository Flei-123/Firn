// SPDX-License-Identifier: MPL-2.0
import window.window

export {
    ShellEvent, ShellFrame, ShellCtl,
    shell_event_new, shell_frame_new, shell_ctl_new,
    shell_poll_event, shell_submit_frame, shell_ctl, shell_ctl2, shell_blit, shell_fill, shell_present,
    shell_wait, shell_pending, shell_backend, shell_backend_want_set, shell_backend_want,
    ev_a, ev_x, ev_y, ev_state, ev_kind, ev_seq,
    FK_BLIT, FK_FILL, FK_PRESENT,
    CT_TITLE, CT_CURSOR, CT_FULLSCREEN, CT_MINIMISE, CT_MAX_TOGGLE,
    CT_DRAG, CT_TITLEBAR_COLOUR, CT_FRAME_HEIGHT, CT_BUTTON_ZONE,
    CT_CLICK_ZONE, CT_FRAME_OWN, CT_FRAME_RESIZE, CT_CLIP_CLEAR,
    CT_CLIP_SET_MIME, MIME_TEXT, MIME_HTML, MIME_PNG, CT_THEME, CT_RESIZE,
    BACKEND_INLINE, BACKEND_THREAD,
}

const FK_BLIT: u32 = 1
const FK_FILL: u32 = 2
const FK_PRESENT: u32 = 3

const CT_TITLE: u32 = 1
const CT_CURSOR: u32 = 2
const CT_FULLSCREEN: u32 = 3
const CT_MINIMISE: u32 = 4
const CT_MAX_TOGGLE: u32 = 5
const CT_DRAG: u32 = 6
const CT_TITLEBAR_COLOUR: u32 = 7
const CT_FRAME_HEIGHT: u32 = 8
const CT_BUTTON_ZONE: u32 = 9
const CT_CLICK_ZONE: u32 = 10
const CT_FRAME_OWN: u32 = 11
const CT_FRAME_RESIZE: u32 = 12
const CT_CLIP_CLEAR: u32 = 13
const CT_CLIP_SET_MIME: u32 = 14
const CT_THEME: u32 = 15
const CT_RESIZE: u32 = 16

const MIME_TEXT: u64 = 1
const MIME_HTML: u64 = 2
const MIME_PNG: u64 = 3

const BACKEND_INLINE: u32 = 0
const BACKEND_THREAD: u32 = 1

struct ShellEvent {
    kind: u32,
    a: u32,
    x: u32,
    y: u32,
    state: u32,
    seq: u64,
}

struct ShellFrame {
    kind: u32,
    px: u64,
    w: usize,
    h: usize,
    stride: usize,
    dx: usize,
    dy: usize,
    colour: u32,
    seq: u64,
}

struct ShellCtl {
    kind: u32,
    a: u64,
    b: u64,
    c: u64,
    d: u64,
}

static mut G_EV_KIND: u32 = 0
static mut G_EV_A: u32 = 0
static mut G_EV_X: u32 = 0
static mut G_EV_Y: u32 = 0
static mut G_EV_S: u32 = 0
static mut G_EV_SEQ: u64 = 0
static mut G_FRAME_SEQ: u64 = 0
static mut G_BACKEND_WANT: u32 = 0
const THREAD_READY: bool = false

fn shell_event_new() -> ShellEvent {
    return ShellEvent { kind: 0, a: 0, x: 0, y: 0, state: 0, seq: 0 }
}

fn shell_frame_new() -> ShellFrame {
    return ShellFrame { kind: 0, px: 0, w: 0, h: 0, stride: 0, dx: 0, dy: 0,
        colour: 0, seq: 0 }
}

fn shell_ctl_new() -> ShellCtl {
    return ShellCtl { kind: 0, a: 0, b: 0, c: 0, d: 0 }
}

#[no_gc]
fn shell_backend() -> u32 {
    if THREAD_READY && G_BACKEND_WANT == BACKEND_THREAD {
        return BACKEND_THREAD
    }
    return BACKEND_INLINE
}

#[no_gc]
fn shell_backend_want() -> u32 { return G_BACKEND_WANT }

fn shell_backend_want_set(v: u32) { G_BACKEND_WANT = v }

#[no_gc]
fn ev_kind() -> u32 { return G_EV_KIND }

#[no_gc]
fn ev_a() -> u32 { return G_EV_A }

#[no_gc]
fn ev_x() -> u32 { return G_EV_X }

#[no_gc]
fn ev_y() -> u32 { return G_EV_Y }

#[no_gc]
fn ev_state() -> u32 { return G_EV_S }

#[no_gc]
fn ev_seq() -> u64 { return G_EV_SEQ }

fn shell_pending(f: *mut window.Window) -> bool {
    return window.pending(f)
}

fn shell_wait(f: *mut window.Window, ms: i64) -> bool {
    return window.wait_event(f, ms)
}

fn shell_poll_event(f: *mut window.Window, out: *mut ShellEvent) -> u32 {
    let k: u32 = window.next_event(f)
    G_EV_KIND = k
    if k == window.EV_NONE {
        (*out).kind = k
        return k
    }
    G_EV_A = window.ev_a(f)
    G_EV_X = window.ev_x(f)
    G_EV_Y = window.ev_y(f)
    G_EV_S = window.ev_state(f)
    G_EV_SEQ = G_EV_SEQ + 1
    (*out).kind = k
    (*out).a = G_EV_A
    (*out).x = G_EV_X
    (*out).y = G_EV_Y
    (*out).state = G_EV_S
    (*out).seq = G_EV_SEQ
    return k
}

fn shell_submit_frame(f: *mut window.Window, fr: *mut ShellFrame) -> bool {
    G_FRAME_SEQ = G_FRAME_SEQ + 1
    (*fr).seq = G_FRAME_SEQ
    if (*fr).kind == FK_BLIT {
        return window.image(f, (*fr).px, (*fr).w, (*fr).h, (*fr).dx, (*fr).dy)
    }
    if (*fr).kind == FK_FILL {
        return window.fill(f, (*fr).colour, (*fr).dx, (*fr).dy, (*fr).w, (*fr).h)
    }
    if (*fr).kind == FK_PRESENT {
        return window.present(f)
    }
    return false
}

fn shell_ctl(f: *mut window.Window, c: *mut ShellCtl) -> bool {
    let k: u32 = (*c).kind
    if k == CT_TITLE {
        return window.title(f, (*c).a, (*c).b as usize)
    }
    if k == CT_CURSOR {
        window.cursor_set(f, (*c).a as u32)
        return true
    }
    if k == CT_FULLSCREEN {
        return window.fullscreen(f, (*c).a != 0 as u64)
    }
    if k == CT_MINIMISE {
        window.window_minimise(f)
        return true
    }
    if k == CT_MAX_TOGGLE {
        window.window_max_toggle(f)
        return true
    }
    if k == CT_DRAG {
        window.window_drag(f)
        return true
    }
    if k == CT_TITLEBAR_COLOUR {
        window.titlebar_colour(f, (*c).a as u32, (*c).b != 0 as u64)
        return true
    }
    if k == CT_FRAME_HEIGHT {
        window.frame_height_set(f, (*c).a as usize)
        return true
    }
    if k == CT_BUTTON_ZONE {
        window.button_zone_set(f, (*c).a as usize, (*c).b as usize)
        return true
    }
    if k == CT_CLICK_ZONE {
        window.click_zone_set(f, (*c).a as usize)
        return true
    }
    if k == CT_FRAME_OWN {
        return window.frame_own(f, (*c).a != 0 as u64)
    }
    if k == CT_FRAME_RESIZE {
        return window.frame_resize(f, (*c).a as usize, (*c).b as usize)
    }
    if k == CT_CLIP_CLEAR {
        window.clip_clear(f)
        return true
    }
    if k == CT_CLIP_SET_MIME {
        if (*c).c == 1 as u64 {
            return window.clip_set_mime(f, "text/plain;charset=utf-8", (*c).a, (*c).b as usize)
        }
        if (*c).c == 2 as u64 {
            return window.clip_set_mime(f, "text/html", (*c).a, (*c).b as usize)
        }
        if (*c).c == 3 as u64 {
            return window.clip_set_mime(f, "image/png", (*c).a, (*c).b as usize)
        }
        return false
    }
    if k == CT_THEME {
        window.set_theme(f, (*c).a as u32)
        return true
    }
    if k == CT_RESIZE {
        return window.resize(f, (*c).a as usize, (*c).b as usize)
    }
    return false
}

fn shell_ctl2(f: *mut window.Window, kind: u32, a: u64, b: u64) -> bool {
    var c: ShellCtl = shell_ctl_new()
    c.kind = kind
    c.a = a
    c.b = b
    return shell_ctl(f, &c)
}

fn shell_blit(f: *mut window.Window, px: u64, w: usize, h: usize, dx: usize,
    dy: usize) -> bool {
    var fr: ShellFrame = shell_frame_new()
    fr.kind = FK_BLIT
    fr.px = px
    fr.w = w
    fr.h = h
    fr.stride = w * 4
    fr.dx = dx
    fr.dy = dy
    return shell_submit_frame(f, &fr)
}

fn shell_fill(f: *mut window.Window, colour: u32, x0: usize, y0: usize,
    w: usize, h: usize) -> bool {
    var fr: ShellFrame = shell_frame_new()
    fr.kind = FK_FILL
    fr.colour = colour
    fr.dx = x0
    fr.dy = y0
    fr.w = w
    fr.h = h
    return shell_submit_frame(f, &fr)
}

fn shell_present(f: *mut window.Window) -> bool {
    var fr: ShellFrame = shell_frame_new()
    fr.kind = FK_PRESENT
    return shell_submit_frame(f, &fr)
}
