// SPDX-License-Identifier: MPL-2.0
// lib/window/pixcopy.fi -- word-wise pixel rectangle copies into a 32-bit window buffer (two pixels per 64-bit access).

const MASK_GA: u64 = 0x0000FF000000FF00
const MASK_LOW: u64 = 0x000000FF000000FF
const MASK_ALPHA: u64 = 0xFF000000FF000000

fn bgrx_to_rgba_row(src: u64, dst: u64, n: usize) {
    var s: u64 = src
    var d: u64 = dst
    var left: usize = n
    while left >= 2 {
        let q: u64 = *(s as *mut u64)
        *(d as *mut u64) = (q & MASK_GA) | ((q >> 16) & MASK_LOW) | ((q & MASK_LOW) << 16) | MASK_ALPHA
        s = s + 8
        d = d + 8
        left = left - 2
    }
    if left == 1 {
        let p: u32 = *(s as *mut u32)
        *(d as *mut u32) = (p & 0xFF00) | ((p >> 16) & 0xFF) | ((p & 0xFF) << 16) | 0xFF000000
    }
}

fn rgba_to_rgba_row(src: u64, dst: u64, n: usize) {
    var s: u64 = src
    var d: u64 = dst
    var left: usize = n
    while left >= 4 {
        let a: u64 = *(s as *mut u64)
        let b: u64 = *((s +% 8) as *mut u64)
        *(d as *mut u64) = a | MASK_ALPHA
        *((d +% 8) as *mut u64) = b | MASK_ALPHA
        s = s + 16
        d = d + 16
        left = left - 4
    }
    while left > 0 {
        *(d as *mut u32) = *(s as *mut u32) | 0xFF000000
        s = s + 4
        d = d + 4
        left = left - 1
    }
}

fn bgrx_rect_to_rgba(src: u64, src_stride: usize, dst: u64, dst_stride: usize, w: usize, h: usize) {
    var y: usize = 0
    while y < h {
        bgrx_to_rgba_row(src + (y * src_stride * 4) as u64, dst + (y * dst_stride * 4) as u64, w)
        y = y + 1
    }
}

fn rgba_rect_to_rgba(src: u64, src_stride: usize, dst: u64, dst_stride: usize, w: usize, h: usize) {
    var y: usize = 0
    while y < h {
        rgba_to_rgba_row(src + (y * src_stride * 4) as u64, dst + (y * dst_stride * 4) as u64, w)
        y = y + 1
    }
}
