// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/window/x11.fi, as of Certus commit 1f1ec17bdb68 (last
// changed in cbbc9d8c0475); released by the sole author Justin on 23.09.2026
// for Firn under MPL-2.0.
// lib/window/x11.fi -- THE X11 BACK END (round WINDOW).
//
// NOT rewritten: this is lib/browser/x11.fi from round B5, rehung onto
// the contract of lib/window/window.fi and extended by exactly the
// gaps that the comparison with lib/windows/gdi.fi uncovered. The
// whole X11 client without Xlib, without xcb, without a C library
// stands there line for line as before.
//
// Used are CreateWindow(1), CreateGC(55), MapWindow(8),
// PutImage(72), PolyFillRectangle(70), ChangeProperty(18),
// GetProperty(20), InternAtom(16), OpenFont(45), ChangeGC(56),
// ImageText8(76) and the events Expose(12), KeyPress(2),
// ButtonPress(4), MotionNotify(6), ConfigureNotify(22),
// ClientMessage(33).
//
// ============================ WHAT THIS ROUND ADDED (the gaps)
//
// L1 EV_MOTION. The event mask did not have PointerMotion. Without
//    pointer movement no hovered button -- under Windows that existed
//    since CERTUS-WIN2, under X11 not.
// L2 EV_CHAR. Before, the client only handed out key numbers, and
//    EVERY program had to call `x11_key_ascii` itself. Now the backend
//    splits like Windows: keys with meaning as EV_KEY, printable
//    characters as EV_CHAR.
// L3 WM_DELETE_WINDOW. Before, closing the window killed the process
//    with an I/O error (U2 of the old file). Now the window manager
//    asks, and the program gets EV_CLOSED.
// L4 THE PIXEL DENSITY. `Xft.dpi` from RESOURCE_MANAGER (what every
//    desktop really sets), otherwise pixels and millimetres of the
//    screen from the connection block -- two numbers the old version
//    read past --, otherwise 96.
// L5 LIGHT/DARK. There is no registry. Read are CERTUS_THEME and
//    GTK_THEME from the environment, then
//    ~/.config/gtk-4.0/settings.ini and gtk-3.0 -- the file GNOME and
//    XFCE really write.
// L6 THE ENVIRONMENT. "Not reachable from `rt`" had stood in the
//    header of this file since B5, and that is why a fixed path stood here
//    `/root/.Xauthority`. /proc/self/environ needs open, read, close.
//
// ================================================================ HONEST
//
// U1 ONE VISUAL: 24 bit in a 32 bit pixel. Another depth is a refusal
//    with a reason and not a black window.
// U2 THE WHOLE CANVAS GOES OVER ON EVERY FRAME (3.8 MB at 1200x800).
//    A damage rectangle would be the next step.
// U3 NO SHARED MEMORY (MIT-SHM), NO BACK BUFFER: `fill` and `text` go
//    to the server one by one. Whoever wants to be flicker free paints
//    into an own buffer and sends ONE `image`.
// U4 `r_ppm` DOES NOT EXIST HERE (false). The client holds no canvas.
//    The capture comes during acceptance with `xwd` FROM THE SERVER --
//    the stronger measurement: a program that claims to have painted
//    is caught there and not here.
// U5 EV_THEME arrives when a change is noticed as a wait expires
//    (looked at most once per second). Whoever
//    waits forever never gets it; for that there is `window.theme_reload`.
//    Immediately would only work through the XDG portal on D-Bus.
// ======================================= WHAT FIRN ADDED (23.09.2026)
//
// F1 THE KEYBOARD FROM THE SERVER. GetKeyboardMapping and
//    GetModifierMapping at connect time; a key becomes a KEYSYM by the
//    rules of the protocol (Shift, Lock, NumLock, AltGr), and the keysym
//    decides K_* and the character. `key_ascii` (the fixed US table)
//    stays only as the fallback when the server does not answer.
// F2 RELEASE, ENTER, LEAVE -- on request (`window.full_input`), so that a
//    program that does not want them sees exactly what it saw before.
//    lib/fui/control.fi needs the release: a click there is press AND
//    release on the same widget.
// F3 ~/.Xauthority BY DISPLAY NUMBER instead of "the first cookie".
// F4 THE PROTOCOL AS PURE FUNCTIONS (`req_*`, `setup_parse`,
//    `keymap_*`, `decode_event`, `auth_pick`, `resman_dpi`): every
//    request and every reply this client knows is built/read by a
//    function without a connection, and tools/fui/x11_main.fi checks
//    them octet by octet against hand-derived values and against real
//    captures of an Xvfb (testdata/x11/).
//
// WHAT DOES NOT WORK (still): dead keys and compose (a dead key gives no
// character), the old Latin-2..9/Cyrillic keysym tables (only Latin-1
// and the Unicode keysyms become characters), TCP displays
// (`host:0`), MIT-SHM, and more than the first screen.
import std.rt
import std.net
import window.window
// THE MESSAGE "AN INPUT HAS ARRIVED" -- to whom, the host says.
//
// In Certus this back end called `browser.vorrang` directly here; the
// input priority is, however, a matter of the BROWSER (it shifts
// slices of the page build), not of the window. In Firn there is no
// browser.vorrang, and a window layer that knows a particular host
// cannot be used by any other. So the back end reports to a
// hook that the host sets (`window.input_hook`); Certus hangs
// `vorrang.vorrang_eingabe_melden` there and gets the same behaviour
// as before. Without a hook nothing happens -- as with a host without
// priority.

export {
    r_notify, r_stay_alive, r_in_front,
    r_notify_at, r_notify_shown, r_notify_cancel,
    r_pick_image, r_pick_poll, r_pick_take, r_image_decode,
    r_clip_set, r_clip_get, r_clip_types, r_clip_clear, r_event_fd,
    // fUi tempo, stage 2b: THE GPU (only Android has it so far)
    r_gpu_open, r_gpu_swap, r_gpu_close, r_gpu_place, r_gpu_lost,
    r_dragging,
    Platte, surface_new,
    r_open, r_make, r_show, r_title, r_close, r_is_open,
    r_width, r_height, r_dpi, r_maximise,
    r_image, r_fill, r_font, r_text, r_present, r_ppm,
    r_wait, r_pending, r_next, r_dark, r_dark_known, r_poison,
    r_input_pending,
    r_titlebar_dark, r_titlebar_colour,
    // ROUND C-049 -- the window frame of its own. Under X11 it does
    // NOT exist (see the reasoning at `r_frame_can`); the names
    // have to be there nevertheless, because lib/window/window.fi calls them.
    r_frame_can, r_frame_own, r_frame_height, r_button_zone,
    r_content_size,
    r_minimise, r_max_toggle, r_maximised, r_drag,
    r_sysmenu,
    r_screen, r_centre,
    // ROUND C-033: so that the acceptance can check the key layout.
    // It was what uncovered the missing colon.
    key_ascii,
    r_update_start,
    r_input_hook, r_full_input,
    // F4: the protocol as pure functions -- for tools/fui/x11_main.fi.
    Setup, setup_new, setup_parse, dpi_from_mm, resman_dpi, xft_dpi_in,
    req_setup, req_intern_atom, req_create_window, req_create_gc,
    req_change_property, req_map_window, req_get_property,
    req_get_keyboard_mapping, req_get_modifier_mapping,
    req_put_image_head,
    Keymap, keymap_new, keymap_ok, keymap_from_reply,
    keymap_mods_from_reply, keymap_col, keymap_sym, ks_key, ks_char,
    decode_event, auth_pick,
}

const RD_ERR: usize = 18446744073709551615

struct Platte {
    c: net.Conn,
    open: bool,
    schirm_w: usize,
    schirm_h: usize,
    root: u32,
    id_base: u32,
    id_mask: u32,
    next_id: u32,
    visual: u32,
    depth: u32,
    win: u32,
    gc: u32,
    font: u32,
    w: usize,
    h: usize,
    seq: u32,
    // the reply/event buffer
    rb: rt.Buf,
    rpos: usize,
    // the atoms for WM_DELETE_WINDOW (L3)
    a_protocols: u32,
    a_delete: u32,
    // die Bildpunktdichte (L4)
    dpi: usize,
    // hell/dark (L5)
    dark: bool,
    dark_known: bool,
    dark_us: u64,
    // an injected event (EV_THEME); 0 = none
    inj: u32,
    // the poison, see window.set_poison
    gift: u32,
    fail: u32,
    // ROUND C-040 -- THE INPUT TRACK ON THE X11 CONNECTION.
    //
    // `spos` is the position in the receive buffer up to which it has already been LOOKED
    // FOR INPUTS (not: processed). It runs ahead of `rpos`:
    // whoever looks in the middle of a line break wants to know whether a
    // key IS THERE, without taking it out of the queue -- a
    // processed click in the middle of a line break would call `load_url` from
    // within `load_url` (see `pumpe_kurz` in certus_app.fi).
    // `ein_n` is the number of inputs seen but not yet fetched.
    spos: usize,
    ein_n: u64,
    // The hook for the input message, see above.
    ein_hook: fn(u64),
    ein_ud: u64,
    // F1: the layout of the server. F2: report release/enter/leave?
    km: Keymap,
    full: bool,
    // OpenPlan LIB-006 -- THE CLIPBOARD (the CLIPBOARD selection, ICCCM 2).
    // `req_left` counts the octets of the request `send` is in the middle
    // of, so that `seq` is the sequence number of the last request the
    // server got: a reply is found by it among the events.
    req_left: usize,
    a_clipboard: u32,
    a_targets: u32,
    a_utf8: u32,
    a_text: u32,
    a_plain: u32,
    a_firn: u32,
    a_incr: u32,
    clip_own: bool,
    // INCR transfers (ICCCM 2.7.2) in both directions
    mask: u32, // the event mask of our window (CreateWindow)
    prop_events: bool, // PropertyChangeMask selected on our window
    incr_win: [u32; 4],
    incr_prop: [u32; 4],
    incr_type: [u32; 4],
    incr_slot: [u32; 4],
    incr_off: [usize; 4],
    incr_on: [bool; 4],
    clip_n: u32,
    clip_atom: [u32; 8],
    clip_mime: [str; 8],
    clip_data: [rt.Buf; 8],
}

fn surface_new() -> Platte {
    return Platte { c: net.Conn { fd: -1, err: 0, peer: 0 as u32,
            peer_port: 0 as u16 }, open: false, schirm_w: 0, schirm_h: 0,
        root: 0, id_base: 0,
        id_mask: 0, next_id: 0, visual: 0, depth: 0, win: 0, gc: 0,
        font: 0, w: 0, h: 0, seq: 0, rb: rt.buf_new(), rpos: 0,
        req_left: 0, a_clipboard: 0, a_targets: 0, a_utf8: 0, a_text: 0, a_plain: 0, a_firn: 0, a_incr: 0,
        clip_own: false, mask: 0, prop_events: false, incr_win: [0 as u32; 4], incr_prop: [0 as u32; 4],
        incr_type: [0 as u32; 4], incr_slot: [0 as u32; 4], incr_off: [0; 4], incr_on: [false; 4], clip_n: 0, clip_atom: [0 as u32; 8], clip_mime: ["", "", "", "", "", "", "", ""],
        clip_data: [rt.buf_new(), rt.buf_new(), rt.buf_new(), rt.buf_new(), rt.buf_new(), rt.buf_new(), rt.buf_new(), rt.buf_new()],
        a_protocols: 0, a_delete: 0, dpi: 96, dark: false,
        dark_known: false, dark_us: 0, inj: 0, gift: 0, fail: 0,
        spos: 0, ein_n: 0, ein_hook: in_nothing, ein_ud: 0,
        km: keymap_new(), full: false }
}

fn in_nothing(ud: u64) {}

// F2 -- report release, enter and leave. Must stand BEFORE `r_make`:
// the event mask is part of CreateWindow.
fn r_full_input(x: *mut Platte, an: bool) -> bool {
    (*x).full = an
    return true
}

// Set the hook. `ud` the host passes through to itself.
fn r_input_hook(x: *mut Platte, h: fn(u64), ud: u64) {
    (*x).ein_hook = h
    (*x).ein_ud = ud
}

fn r_is_open(x: *mut Platte) -> bool {
    return (*x).open
}

fn r_width(x: *mut Platte) -> usize {
    return (*x).w
}

fn r_height(x: *mut Platte) -> usize {
    return (*x).h
}

fn r_dpi(x: *mut Platte) -> usize {
    return (*x).dpi
}

// ------------------------------------------------------- kleine Helfer

fn put32(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 8) & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 16) & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 24) & 255 as u32) as u8)
}

fn put16(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 8) & 255 as u32) as u8)
}

fn ld32le(p: u64, off: usize) -> u32 {
    return (rt.ld8(p, off) as u32) | ((rt.ld8(p, off + 1) as u32) << 8)
    | ((rt.ld8(p, off + 2) as u32) << 16)
    | ((rt.ld8(p, off + 3) as u32) << 24)
}

fn ld16le(p: u64, off: usize) -> u32 {
    return (rt.ld8(p, off) as u32) | ((rt.ld8(p, off + 1) as u32) << 8)
}

fn pad4(n: usize) -> usize {
    return (4 - (n % 4)) % 4
}

fn send(x: *mut Platte, p: u64, n: usize) -> bool {
    if (*x).open {
        // count the requests in this buffer (a request may be split over
        // two sends -- a PutImage head and its pixels -- but its first
        // four octets never are)
        var at: usize = 0
        while at < n {
            if (*x).req_left == 0 {
                if at + 4 > n {
                    break
                }
                var len: usize = ld16le(p, at + 2) as usize * 4
                if len == 0 {
                    len = 4
                }
                (*x).req_left = len
                (*x).seq = ((*x).seq + 1) & 65535
            }
            var take: usize = n - at
            if take > (*x).req_left {
                take = (*x).req_left
            }
            (*x).req_left = (*x).req_left - take
            at = at + take
        }
    }
    let k: usize = net.write_all(&(*x).c, p, n) catch RD_ERR
    return k == n
}

// Liest, bis mindestens `need` Oktett an `rpos` stehen. BLOCKIEREND --
// only for opening the connection and for the rest of a reply whose
// beginning is already there.
fn want(x: *mut Platte, need: usize) -> bool {
    while (*x).rb.len - (*x).rpos < need {
        if !read_after(x) {
            return false
        }
    }
    return true
}

// A single `read`. Blocks when nothing is there -- it is called either
// from `want` (the server has already sent) or after `poll` has said
// that something is there.
fn read_after(x: *mut Platte) -> bool {
    if (*x).rpos > 0 && (*x).rpos == (*x).rb.len {
        rt.buf_clear(&(*x).rb)
        (*x).rpos = 0
        // ROUND C-040: the buffer starts from the beginning -- the
        // input pointer must come along, otherwise it would point past the end and
        // it would never be looked at again.
        (*x).spos = 0
    }
    let have: usize = (*x).rb.len
    rt.buf_reserve(&(*x).rb, have + 65536)
    if (*x).rb.cap < have + 65536 {
        return false
    }
    let k: usize = net.read(&(*x).c, (*x).rb.ptr + have as u64, 65536)
    catch RD_ERR
    if k == RD_ERR || k == 0 {
        (*x).open = false
        return false
    }
    rt.buf_set_len(&(*x).rb, have + k)
    return true
}

// ======================================================================
// THE PROTOCOL AS PURE FUNCTIONS (Firn, 23.09.2026)
// ======================================================================
//
// WHY THIS SECTION. In Certus every function assembled its request
// on the spot and sent it off immediately. That worked --
// but it could be checked only with a running X server, and that
// is missing on almost every machine on which an acceptance run runs. So
// here every request stands as a function that writes ONLY into a buffer,
// and every reply as a function that reads ONLY from a buffer. The callers
// further down use exactly these functions;
// tools/fui/x11_main.fi puts the same functions octet by octet
// next to hand-derived expected values and next to real captures of an
// Xvfb (testdata/x11/). So there is no second, "check" path.
//
// The numbers are those of the protocol (X Window System Protocol, X11R7,
// chapter 9 for the requests and appendix B for the octet format).

// Zeros up to the next multiple of four.
fn pad_to4(b: *mut rt.Buf, n: usize) {
    var q: usize = 0
    let p: usize = pad4(n)
    while q < p {
        rt.buf_push(b, 0 as u8)
        q = q + 1
    }
}

// THE CONNECTION SETUP. 'l' = little-endian, protocol 11.0, then name
// and data of the authorisation, each padded to four octets. Without
// authorisation both lengths are 0 and nothing follows.
fn req_setup(b: *mut rt.Buf, np: u64, nn: usize, dp: u64, dn: usize) {
    rt.buf_push(b, 108 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 11 as u32)
    put16(b, 0 as u32)
    put16(b, nn as u32)
    put16(b, dn as u32)
    put16(b, 0 as u32)
    rt.buf_push_bytes(b, np, nn)
    pad_to4(b, nn)
    rt.buf_push_bytes(b, dp, dn)
    pad_to4(b, dn)
}

// InternAtom(16), only-if-exists = nein.
fn req_intern_atom(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push(b, 16 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, (2 + (n + pad4(n)) / 4) as u32)
    put16(b, n as u32)
    put16(b, 0 as u32)
    rt.buf_push_bytes(b, p, n)
    pad_to4(b, n)
}

// CreateWindow(1) at (0,0), border 0, InputOutput, with exactly two
// values: background-pixel (2) and event-mask (2048).
fn req_create_window(b: *mut rt.Buf, wid: u32, parent: u32, depth: u32,
    visual: u32, w: usize, h: usize, bg: u32, mask: u32) {
    rt.buf_push(b, 1 as u8)
    rt.buf_push(b, depth as u8)
    put16(b, 10 as u32)
    put32(b, wid)
    put32(b, parent)
    put16(b, 0 as u32)
    put16(b, 0 as u32)
    put16(b, w as u32)
    put16(b, h as u32)
    put16(b, 0 as u32)
    put16(b, 1 as u32)
    put32(b, visual)
    put32(b, 2050 as u32)
    put32(b, bg)
    put32(b, mask)
}

// CreateGC(55) without values.
fn req_create_gc(b: *mut rt.Buf, gc: u32, drawable: u32) {
    rt.buf_push(b, 55 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 4 as u32)
    put32(b, gc)
    put32(b, drawable)
    put32(b, 0 as u32)
}

// ChangeProperty(18), mode Replace. `fmt` is 8, 16 or 32; `nbytes`
// the length of the data in octets, the number of UNITS is calculated by this
// function itself -- exactly the place at which you would otherwise miscount by
// a factor of four.
fn req_change_property(b: *mut rt.Buf, win: u32, prop: u32, typ: u32,
    fmt: u32, p: u64, nbytes: usize) {
    rt.buf_push(b, 18 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, (6 + (nbytes + pad4(nbytes)) / 4) as u32)
    put32(b, win)
    put32(b, prop)
    put32(b, typ)
    rt.buf_push(b, fmt as u8)
    rt.buf_push(b, 0 as u8)
    rt.buf_push(b, 0 as u8)
    rt.buf_push(b, 0 as u8)
    put32(b, (nbytes / ((fmt / 8) as usize)) as u32)
    rt.buf_push_bytes(b, p, nbytes)
    pad_to4(b, nbytes)
}

// MapWindow(8).
fn req_map_window(b: *mut rt.Buf, win: u32) {
    rt.buf_push(b, 8 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 2 as u32)
    put32(b, win)
}

// GetProperty(20), delete = nein.
fn req_get_property(b: *mut rt.Buf, win: u32, prop: u32, typ: u32,
    off: u32, len: u32) {
    rt.buf_push(b, 20 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 6 as u32)
    put32(b, win)
    put32(b, prop)
    put32(b, typ)
    put32(b, off)
    put32(b, len)
}

// GetKeyboardMapping(101): `count` Tastencodes ab `first`.
fn req_get_keyboard_mapping(b: *mut rt.Buf, first: u32, count: u32) {
    rt.buf_push(b, 101 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 2 as u32)
    rt.buf_push(b, first as u8)
    rt.buf_push(b, count as u8)
    rt.buf_push(b, 0 as u8)
    rt.buf_push(b, 0 as u8)
}

// GetModifierMapping(119): which keys are Shift, Lock, Control and
// Mod1..Mod5.
fn req_get_modifier_mapping(b: *mut rt.Buf) {
    rt.buf_push(b, 119 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 1 as u32)
}

// The HEAD of PutImage(72), ZPixmap, left-pad 0. The `bytes` image octets
// follow behind it (the caller appends them, so that a 3.8 MB image
// is not copied twice). `bytes` is at 32 bits per pixel always
// a multiple of four.
fn req_put_image_head(b: *mut rt.Buf, win: u32, gc: u32, w: usize,
    h: usize, dx: usize, dy: usize, depth: u32, bytes: usize) {
    rt.buf_push(b, 72 as u8)
    rt.buf_push(b, 2 as u8)
    put16(b, (6 + bytes / 4) as u32)
    put32(b, win)
    put32(b, gc)
    put16(b, w as u32)
    put16(b, h as u32)
    put16(b, dx as u32)
    put16(b, dy as u32)
    rt.buf_push(b, 0 as u8)
    rt.buf_push(b, depth as u8)
    rt.buf_push(b, 0 as u8)
    rt.buf_push(b, 0 as u8)
}

// ------------------------------------------------- the reply to the setup

struct Setup {
    id_base: u32,
    id_mask: u32,
    root: u32,
    s_px_w: usize,
    s_px_h: usize,
    s_mm_w: usize,
    s_mm_h: usize,
    visual: u32,
    depth: u32,
    kmin: u32,
    kmax: u32,
}

fn setup_new() -> Setup {
    return Setup { id_base: 0, id_mask: 0, root: 0, s_px_w: 0, s_px_h: 0,
        s_mm_w: 0, s_mm_h: 0, visual: 0, depth: 0, kmin: 0, kmax: 0 }
}

// Take apart the reply to the connection setup: `p` points to its
// first octet, `n` octets are there. Returned is 0 or the reason
// that also lands in `Platte.fail`: 5 = refused (almost always the
// authorisation), 6 = no 24-bit visual (U1), 7 = too short.
//
// Only the FIRST screen is read -- `:0.1` exists on no
// machine for which this program is built.
fn setup_parse(p: u64, n: usize, s: *mut Setup) -> u32 {
    if n < 8 {
        return 7 as u32
    }
    if rt.ld8(p, 0) != 1 as u8 {
        return 5 as u32
    }
    if n < 40 {
        return 7 as u32
    }
    (*s).id_base = ld32le(p, 12)
    (*s).id_mask = ld32le(p, 16)
    (*s).kmin = rt.ld8(p, 34) as u32
    (*s).kmax = rt.ld8(p, 35) as u32
    let vendor_len: usize = ld16le(p, 24) as usize
    let nformats: usize = rt.ld8(p, 29) as usize
    let at: usize = 40 + vendor_len + pad4(vendor_len) + nformats * 8
    if at + 40 > n {
        return 7 as u32
    }
    (*s).root = ld32le(p, at)
    (*s).s_px_w = ld16le(p, at + 20) as usize
    (*s).s_px_h = ld16le(p, at + 22) as usize
    (*s).s_mm_w = ld16le(p, at + 24) as usize
    (*s).s_mm_h = ld16le(p, at + 26) as usize
    let ndepths: usize = rt.ld8(p, at + 39) as usize
    var dat: usize = at + 40
    var di: usize = 0
    (*s).visual = 0
    while di < ndepths && dat + 8 <= n {
        let dep: u32 = rt.ld8(p, dat) as u32
        let nvis: usize = ld16le(p, dat + 2) as usize
        if dep == 24 as u32 && nvis > 0 && dat + 12 <= n {
            (*s).visual = ld32le(p, dat + 8)
            (*s).depth = 24
            break
        }
        dat = dat + 8 + nvis * 24
        di = di + 1
    }
    if (*s).visual == 0 as u32 {
        return 6 as u32
    }
    return 0 as u32
}

// The pixel density from points and millimetres: 1 inch = 25.4 mm,
// integer and rounded commercially. 0 = not determinable.
fn dpi_from_mm(px: usize, mm: usize) -> usize {
    if px == 0 || mm == 0 {
        return 0
    }
    return (px * 254 + mm * 5) / (mm * 10)
}

// `Xft.dpi:` from the text of the resource database. 0 = not there.
fn xft_dpi_in(txt: u64, bytes: usize) -> usize {
    var lit: [u8; 8] = "Xft.dpi:"
    var d: usize = 0
    var i: usize = 0
    while i + 8 <= bytes {
        var equal: bool = true
        var j: usize = 0
        while j < 8 {
            if rt.ld8(txt, i + j) != lit[j] {
                equal = false
            }
            j = j + 1
        }
        if equal {
            d = number_from(txt, i + 8, bytes)
            i = bytes
        }
        i = i + 1
    }
    return d
}

// The reply to GetProperty(RESOURCE_MANAGER) -> Xft.dpi. Only format
// 8 is text; everything else is "not there".
fn resman_dpi(p: u64, n: usize) -> usize {
    if n < 32 || rt.ld8(p, 0) != 1 as u8 {
        return 0
    }
    let extra: usize = (ld32le(p, 4) as usize) * 4
    if 32 + extra > n {
        return 0
    }
    if rt.ld8(p, 1) != 8 as u8 {
        return 0
    }
    var bytes: usize = ld32le(p, 16) as usize
    if bytes > extra {
        bytes = extra
    }
    return xft_dpi_in(p + 32 as u64, bytes)
}

// ======================================================================
// THE KEYBOARD, AS THE SERVER LAYS IT OUT
// ======================================================================
//
// In Certus there stood here only `key_ascii`: a US table for the
// key codes 10..61, built in fixed. On a German keyboard
// the key to the right of the 0 therefore delivered '-' instead of 'ss', 'z' and
// 'y' were swapped, and '@' (AltGr+Q) did not exist at all. The
// layout the SERVER KNOWS, however, and it tells everyone who asks:
//
//   GetKeyboardMapping(kmin, kmax-kmin+1) -> per key code `per`
//       keysyms: [group1 level1, G1 L2, G2 L1, G2 L2, L3, L4, ...]
//   GetModifierMapping -> which keys are Mod1..Mod5; from that follows
//       which state bit is AltGr (ISO_Level3_Shift/Mode_switch) and
//       which is NumLock -- that is NOT a fixed number, the server
//       sets it (with Xvfb with xkb: Mod5 = 128, Mod2 = 16).
//
// The key numbers K_* in window.fi stay what they are (the
// evdev numbers on which Certus built its loops) -- but they
// are now determined from the KEYSYM: Escape is Escape, no matter on
// which key code it lies.

struct Keymap {
    syms: rt.Buf, // je Tastencode `per` Keysyms, kleinendisch u32
    per: usize,
    kmin: u32,
    n: usize, // wie viele Tastencodes
    lvl3: u32, // das Zustandsbit fuer AltGr, 0 = keins
    numlock: u32, // das Zustandsbit fuer NumLock, 0 = keins
}

fn keymap_new() -> Keymap {
    return Keymap { syms: rt.buf_new(), per: 0, kmin: 0, n: 0, lvl3: 0,
        numlock: 0 }
}

fn keymap_ok(km: *mut Keymap) -> bool {
    return (*km).n > 0 && (*km).per > 0
}

// Take over the reply to GetKeyboardMapping. `kmin` is the first
// requested key code (the reply does not name it again).
fn keymap_from_reply(km: *mut Keymap, p: u64, n: usize, kmin: u32) -> bool {
    if n < 32 || rt.ld8(p, 0) != 1 as u8 {
        return false
    }
    let per: usize = rt.ld8(p, 1) as usize
    let words: usize = ld32le(p, 4) as usize
    if per == 0 || 32 + words * 4 > n {
        return false
    }
    rt.buf_clear(&(*km).syms)
    rt.buf_push_bytes(&(*km).syms, p + 32 as u64, words * 4)
    (*km).per = per
    (*km).kmin = kmin
    (*km).n = words / per
    return true
}

// Keysym in column `col` for key code `kc`; 0 = NoSymbol.
fn keymap_col(km: *mut Keymap, kc: u32, col: usize) -> u32 {
    if !keymap_ok(km) || kc < (*km).kmin || col >= (*km).per {
        return 0 as u32
    }
    let i: usize = (kc - (*km).kmin) as usize
    if i >= (*km).n {
        return 0 as u32
    }
    return ld32le(rt.buf_ptr(&(*km).syms), (i * (*km).per + col) * 4)
}

// The reply to GetModifierMapping: for each of the eight bits the
// key codes; a bit on which a key with ISO_Level3_Shift
// (0xFE03) or Mode_switch (0xFF7E) lies is AltGr, one with
// Num_Lock (0xFF7F) is NumLock.
fn keymap_mods_from_reply(km: *mut Keymap, p: u64, n: usize) -> bool {
    if n < 32 || rt.ld8(p, 0) != 1 as u8 {
        return false
    }
    let je: usize = rt.ld8(p, 1) as usize
    if 32 + 8 * je > n {
        return false
    }
    (*km).lvl3 = 0
    (*km).numlock = 0
    var m: usize = 0
    while m < 8 {
        var k: usize = 0
        while k < je {
            let kc: u32 = rt.ld8(p, 32 + m * je + k) as u32
            if kc != 0 as u32 {
                var col: usize = 0
                while col < (*km).per {
                    let ks: u32 = keymap_col(km, kc, col)
                    if ks == 65027 as u32 || ks == 65406 as u32 {
                        (*km).lvl3 = (1 as u32) << (m as u32)
                    }
                    if ks == 65407 as u32 {
                        (*km).numlock = (1 as u32) << (m as u32)
                    }
                    col = col + 1
                }
            }
            k = k + 1
        }
        m = m + 1
    }
    return true
}

// Lower case -> upper case for the keysyms that ARE a character
// from Latin-1 (keysym == code point). Needed only for the rule
// of the protocol: if column 2 holds NoSymbol, then for column 2 the
// capital letter of column 1 applies (or column 1 itself).
fn ks_upper(ks: u32) -> u32 {
    if ks >= 97 as u32 && ks <= 122 as u32 {
        return ks - 32 as u32
    }
    if ks >= 224 as u32 && ks <= 254 as u32 && ks != 247 as u32 {
        return ks - 32 as u32
    }
    return ks
}

fn ks_is_lower(ks: u32) -> bool {
    return ks_upper(ks) != ks
}

fn ks_is_keypad(ks: u32) -> bool {
    return ks >= 65408 as u32 && ks <= 65469 as u32
}

// THE KEYSYM FOR KEY CODE AND STATE. The rules from chapter 5 of the
// protocol ("Keyboards"), restricted to what a
// surface needs:
//   * AltGr (the bit from GetModifierMapping) takes columns 4/5
//     (level 3/4) -- but only if something stands there.
//   * NumLock on a digit key takes column 1, Shift reverses it
//     again.
//   * Shift takes column 1; CapsLock (Lock) does so only for a
//     letter. If column 1 is NoSymbol, the capital letter of
//     column 0 applies, or column 0 itself.
fn keymap_sym(km: *mut Keymap, kc: u32, state: u32) -> u32 {
    let shift: bool = (state & 1 as u32) != 0 as u32
    let lock: bool = (state & 2 as u32) != 0 as u32
    var c0: usize = 0
    if (*km).lvl3 != 0 as u32 && (state & (*km).lvl3) != 0 as u32 {
        if keymap_col(km, kc, 4) != 0 as u32 {
            c0 = 4
        }
    }
    let s0: u32 = keymap_col(km, kc, c0)
    var s1: u32 = keymap_col(km, kc, c0 + 1)
    if s1 == 0 as u32 {
        s1 = ks_upper(s0)
    }
    if (*km).numlock != 0 as u32 && (state & (*km).numlock) != 0 as u32
    && ks_is_keypad(s1) {
        if shift {
            return s0
        }
        return s1
    }
    var high: bool = shift
    if lock && ks_is_lower(s0) {
        high = !high
    }
    if high {
        return s1
    }
    return s0
}

// Keysym -> key number with meaning (window.K_*), 0 = none.
fn ks_key(ks: u32) -> u32 {
    if ks == 65307 as u32 { return window.K_ESCAPE } // Escape
    if ks == 65288 as u32 { return window.K_BACK } // BackSpace
    if ks == 65289 as u32 || ks == 65056 as u32 { // Tab, ISO_Left_Tab
        return window.K_TAB
    }
    if ks == 65293 as u32 || ks == 65421 as u32 { // Return, KP_Enter
        return window.K_RETURN
    }
    if ks == 65360 as u32 || ks == 65429 as u32 { return window.K_HOME }
    if ks == 65361 as u32 || ks == 65430 as u32 { return window.K_LEFT }
    if ks == 65362 as u32 || ks == 65431 as u32 { return window.K_UP }
    if ks == 65363 as u32 || ks == 65432 as u32 { return window.K_RIGHT }
    if ks == 65364 as u32 || ks == 65433 as u32 { return window.K_DOWN }
    if ks == 65365 as u32 || ks == 65434 as u32 { return window.K_PAGEUP }
    if ks == 65366 as u32 || ks == 65435 as u32 { return window.K_PAGEDOWN }
    if ks == 65367 as u32 || ks == 65436 as u32 { return window.K_END }
    if ks == 65535 as u32 || ks == 65439 as u32 { return window.K_DELETE }
    return 0 as u32
}

// Keysym -> Unicode code point, 0 = no character.
//   * 0x20..0x7E and 0xA0..0xFF: keysym == Latin-1 == Unicode.
//   * 0x01000000 + cp: the Unicode range of the keysyms (xkb stores e.g.
//     the capital sharp s like this: U1E9E).
//   * the numeric keypad: KP_Space, KP_Equal, KP_Multiply .. KP_9.
//   * EuroSign 0x20AC is at the same time U+20AC.
// NOT here: dead keys (0xFE50..) and the old Latin-2..-9 and
// Cyrillic keysym tables -- see "WHAT DOES NOT WORK" in the header.
fn ks_char(ks: u32) -> u32 {
    if ks >= 32 as u32 && ks <= 126 as u32 {
        return ks
    }
    if ks >= 160 as u32 && ks <= 255 as u32 {
        return ks
    }
    if ks >= 16777216 as u32 && ks <= 17891327 as u32 {
        return ks - 16777216 as u32
    }
    if ks == 8364 as u32 {
        return ks
    }
    if ks == 65408 as u32 { return 32 as u32 } // KP_Space
    if ks == 65469 as u32 { return 61 as u32 } // KP_Equal
    if ks >= 65450 as u32 && ks <= 65465 as u32 { // KP_Multiply .. KP_9
        var t: [u8; 16] = "*+,-./0123456789"
        return t[(ks - 65450 as u32) as usize] as u32
    }
    return 0 as u32
}

// ======================================================================
// ONE EVENT, 32 OCTETS -> (kind, a, x, y, state)
// ======================================================================
//
// The translation that `r_next` formerly did itself, as a function of its own
// without a connection. `a_delete` is the atom WM_DELETE_WINDOW,
// `voll` the switch from `window.full_input` (release, enter,
// leave). Returned: true = this is an event for the program.
//
// The top bit of the code only says "came through SendEvent" -- a
// window manager sends WM_DELETE_WINDOW exactly like that (code 161 = 33|128
// in the capture testdata/x11/events.bin). It is therefore cut off.
fn decode_event(p: u64, a_delete: u32, km: *mut Keymap, full: bool,
    k: *mut u32, a: *mut u32, ox: *mut u32, oy: *mut u32,
    os: *mut u32) -> bool {
    let code: u8 = rt.ld8(p, 0) & 127 as u8
    *a = 0 as u32
    *ox = 0 as u32
    *oy = 0 as u32
    *os = 0 as u32
    if code == 12 as u8 { // Expose
        *k = window.EV_EXPOSE
        return true
    }
    if code == 2 as u8 || (code == 3 as u8 && full) { // KeyPress/Release
        let kc: u32 = rt.ld8(p, 1) as u32
        let st: u32 = ld16le(p, 28)
        *os = st
        var ks: u32 = 0 as u32
        if keymap_ok(km) {
            ks = keymap_sym(km, kc, st)
        }
        *ox = ks
        if code == 3 as u8 {
            var t: u32 = ks_key(ks)
            if t == 0 as u32 {
                t = kc
            }
            *a = t
            *k = window.EV_KEY_UP
            return true
        }
        // L2: as under Windows -- keys with meaning as EV_KEY,
        // printable characters as EV_CHAR.
        if keymap_ok(km) {
            let t: u32 = ks_key(ks)
            if t != 0 as u32 {
                *a = t
                *k = window.EV_KEY
                return true
            }
            let ch: u32 = ks_char(ks)
            if ch != 0 as u32 {
                *a = ch
                *k = window.EV_CHAR
                return true
            }
        } else {
            // No layout from the server (the request failed): the
            // old way through the fixed US table, as in Certus.
            if is_key(kc) {
                *a = kc
                *k = window.EV_KEY
                return true
            }
            let ch: u32 = key_ascii(kc, (st & 1 as u32) != 0 as u32)
            if ch != 0 as u32 {
                *a = ch
                *k = window.EV_CHAR
                return true
            }
        }
        // A key that has neither meaning nor character: as EV_KEY
        // with its number, so that nothing disappears.
        *a = kc
        *k = window.EV_KEY
        return true
    }
    if code == 4 as u8 || (code == 5 as u8 && full) { // Button Press/Release
        *a = rt.ld8(p, 1) as u32
        *ox = ld16le(p, 24)
        *oy = ld16le(p, 26)
        *os = ld16le(p, 28)
        if code == 4 as u8 {
            *k = window.EV_BUTTON
        } else {
            *k = window.EV_RELEASE
        }
        return true
    }
    if code == 6 as u8 { // MotionNotify (L1)
        *ox = ld16le(p, 24)
        *oy = ld16le(p, 26)
        *os = ld16le(p, 28)
        *k = window.EV_MOTION
        return true
    }
    if (code == 7 as u8 || code == 8 as u8) && full { // Enter/Leave
        *ox = ld16le(p, 24)
        *oy = ld16le(p, 26)
        *os = ld16le(p, 28)
        if code == 7 as u8 {
            *k = window.EV_ENTER
        } else {
            *k = window.EV_LEAVE
        }
        return true
    }
    if code == 22 as u8 { // ConfigureNotify
        *ox = ld16le(p, 20)
        *oy = ld16le(p, 22)
        *k = window.EV_CONFIGURE
        return true
    }
    if code == 33 as u8 { // ClientMessage (L3)
        let atom: u32 = ld32le(p, 12)
        if atom == a_delete && a_delete != 0 as u32 {
            *k = window.EV_CLOSED
            return true
        }
    }
    return false
}

// ======================================================================
// ~/.Xauthority: WHICH ENTRY
// ======================================================================
//
// The file is a sequence of entries: family (2 octets, big-endian),
// then four counted strings (length 2 octets big-endian):
// address, display number as TEXT, name of the authorisation, data.
//
// In Certus the FIRST entry with a name 18 octets long was
// taken, no matter for which display. Whoever has more than one display
// (ssh -X, a second Xvfb, an acceptance run) thereby got the cookie
// of a foreign display and a refusal (fail 5). Now: the
// entry WITH THIS DISPLAY NUMBER first; only if there is none, the
// first MIT-MAGIC-COOKIE-1 -- the old behaviour as a fallback.
fn auth_pick(p: u64, n: usize, disp: usize, name: *mut rt.Buf,
    data: *mut rt.Buf) -> bool {
    var cookie: [u8; 18] = "MIT-MAGIC-COOKIE-1"
    var at: usize = 0
    var first_n: usize = 0
    var first_d: usize = 0
    var first_dl: usize = 0
    var has_first: bool = false
    while at + 2 <= n {
        at = at + 2
        var i: usize = 0
        var lens: [usize; 4] = [0; 4]
        var offs: [usize; 4] = [0; 4]
        var bad: bool = false
        while i < 4 {
            if at + 2 > n {
                bad = true
                break
            }
            let l: usize = ((rt.ld8(p, at) as usize) << 8)
            | (rt.ld8(p, at + 1) as usize)
            at = at + 2
            offs[i] = at
            lens[i] = l
            at = at + l
            if at > n {
                bad = true
                break
            }
            i = i + 1
        }
        if bad {
            break
        }
        var is_cookie: bool = lens[2] == 18
        var j: usize = 0
        while is_cookie && j < 18 {
            if rt.ld8(p, offs[2] + j) != cookie[j] {
                is_cookie = false
            }
            j = j + 1
        }
        if is_cookie {
            let nr: usize = number_from(p, offs[1], offs[1] + lens[1])
            let hat_nr: bool = lens[1] > 0
            if hat_nr && nr == disp {
                rt.buf_clear(name)
                rt.buf_push_bytes(name, p + offs[2] as u64, lens[2])
                rt.buf_clear(data)
                rt.buf_push_bytes(data, p + offs[3] as u64, lens[3])
                return true
            }
            if !has_first {
                has_first = true
                first_n = offs[2]
                first_d = offs[3]
                first_dl = lens[3]
            }
        }
    }
    if has_first {
        rt.buf_clear(name)
        rt.buf_push_bytes(name, p + first_n as u64, 18)
        rt.buf_clear(data)
        rt.buf_push_bytes(data, p + first_d as u64, first_dl)
        return true
    }
    return false
}

// ======================================================== DIE UMGEBUNG
//
// The environment is not reachable from `rt` -- that stood literally in
// the header of the old file since round B5, and that is why a fixed
// path `/root/.Xauthority` stood there. /proc/self/environ needs only
// open, read and close, and that is exactly what lib/i18n/lang.fi does since round LOKAL.
const ENVCAP: usize = 32768
static mut G_ENV: [u8; 32768] = [0 as u8; 32768]
static mut G_ENV_N: usize = 0
static mut G_ENV_DA: u32 = 0

fn env_load() {
    if G_ENV_DA != 0 as u32 {
        return
    }
    G_ENV_DA = 1
    G_ENV_N = 0
    var path: [u8; 19] = "/proc/self/environ\0"
    var b: rt.Buf = rt.buf_new()
    if rt.read_file((&path[0]) as u64, &b) {
        var n: usize = rt.buf_len(&b)
        if n > ENVCAP {
            n = ENVCAP
        }
        rt.mem_copy((&G_ENV[0]) as u64, rt.buf_ptr(&b), n)
        G_ENV_N = n
    }
    rt.buf_free(&b)
}

// A value from the environment into `out`. false = it is not there.
fn env_get(name: u64, nn: usize, out: *mut rt.Buf) -> bool {
    env_load()
    rt.buf_clear(out)
    let p: u64 = (&G_ENV[0]) as u64
    let n: usize = G_ENV_N
    var at: usize = 0
    while at < n {
        // find the end of this entry
        var e: usize = at
        while e < n && rt.ld8(p, e) != 0 as u8 {
            e = e + 1
        }
        var fits: bool = at + nn + 1 <= e
        if fits {
            var i: usize = 0
            while i < nn {
                if rt.ld8(p, at + i) != rt.ld8(name, i) {
                    fits = false
                }
                i = i + 1
            }
            if fits && rt.ld8(p, at + nn) != 61 as u8 {
                fits = false
            }
        }
        if fits {
            var q: usize = at + nn + 1
            while q < e {
                rt.buf_push(out, rt.ld8(p, q))
                q = q + 1
            }
            return true
        }
        at = e + 1
    }
    return false
}

// ~/.Xauthority, the MIT-MAGIC-COOKIE-1 record. The file is a list of
// big endian counted strings; the first cookie with the right name is
// taken.
fn read_auth(name: *mut rt.Buf, data: *mut rt.Buf, disp: usize) -> bool {
    var b: rt.Buf = rt.buf_new()
    var got: bool = false
    // First XAUTHORITY, then $HOME/.Xauthority, then /root -- the old
    // version could only do the last one.
    var e_xa: [u8; 10] = "XAUTHORITY"
    var path: rt.Buf = rt.buf_new()
    if env_get((&e_xa[0]) as u64, 10, &path) {
        rt.buf_push(&path, 0 as u8)
        if rt.read_file(rt.buf_ptr(&path), &b) {
            got = true
        }
    }
    if !got {
        var e_home: [u8; 4] = "HOME"
        rt.buf_clear(&path)
        if env_get((&e_home[0]) as u64, 4, &path) {
            var suffix: [u8; 12] = "/.Xauthority"
            rt.buf_push_bytes(&path, (&suffix[0]) as u64, 12)
            rt.buf_push(&path, 0 as u8)
            if rt.read_file(rt.buf_ptr(&path), &b) {
                got = true
            }
        }
    }
    rt.buf_free(&path)
    if !got {
        var p1: [u8; 18] = "/root/.Xauthority\0"
        if rt.read_file((&p1[0]) as u64, &b) {
            got = true
        }
    }
    if !got {
        rt.buf_free(&b)
        return false
    }
    // F3: the entry of this display, otherwise the first (auth_pick).
    let found: bool = auth_pick(b.ptr, b.len, disp, name, data)
    rt.buf_free(&b)
    return found
}

fn conn_fail(bad: *mut bool) -> net.Conn {
    *bad = true
    return net.Conn { fd: -1, err: 0, peer: 0 as u32, peer_port: 0 as u16 }
}

fn new_id(x: *mut Platte) -> u32 {
    let id: u32 = (*x).id_base | ((*x).next_id & (*x).id_mask)
    (*x).next_id = (*x).next_id + 1 as u32
    return id
}

// ======================================================== AUFMACHEN

fn r_open(x: *mut Platte, disp: usize) -> bool {
    var path: [u8; 20] = "/tmp/.X11-unix/X0   "
    var plen: usize = 17
    var display: usize = disp
    // Without an argument: DISPLAY from the environment, otherwise 0.
    if display == 0 {
        var e_d: [u8; 7] = "DISPLAY"
        var dv: rt.Buf = rt.buf_new()
        if env_get((&e_d[0]) as u64, 7, &dv) {
            display = number_from(rt.buf_ptr(&dv), 0, rt.buf_len(&dv))
        }
        rt.buf_free(&dv)
    }
    // ROUND REFTEST2 (C-012). BEFORE, there stood here a version that knew ONLY
    // one- and two-digit displays:
    //
    //     path[16] = (48 + (display / 10) % 10) as u8
    //     path[17] = (48 + (display % 10)) as u8
    //
    // For `:100` this calculates (100/10)%10 = 0 and 100%10 = 0 and builds
    // the path `/tmp/.X11-unix/X00` -- a display that does not
    // exist. The renderer ended with rc=95, WITHOUT a message. The
    // reftest runner hands out the displays :98, :99, :100, ... to
    // its threads; from the third thread on, EVERY
    // run therefore ran into nothing: 1600 of 1650 css-grid files came back as
    // RENDER_ERROR, which looked like a Glass error but was
    // none. Measured: :98 and :99 good, :100..:103 rc=95.
    //
    // Now the digits are laid out generally, for any number of
    // places. The buffer holds 20 bytes, "/tmp/.X11-unix/X" is 16 --
    // 4 digits remain (up to :9999), more than X11 ever needs.
    if display < 10 {
        path[16] = (48 + display) as u8
    } else {
        var digits: [u8; 4] = "0000"
        var n: usize = display
        var anz: usize = 0
        while n > 0 && anz < 4 {
            digits[anz] = (48 + (n % 10)) as u8
            n = n / 10
            anz = anz + 1
        }
        var i: usize = 0
        while i < anz {
            path[16 + i] = digits[anz - 1 - i]
            i = i + 1
        }
        plen = 16 + anz
    }
    var bad: bool = false
    let c: net.Conn = net.connect_unix((&path[0]) as u64, plen)
    catch | e | conn_fail(&bad)
    if bad {
        (*x).fail = 1
        return false
    }
    (*x).c = c
    var name: rt.Buf = rt.buf_new()
    var data: rt.Buf = rt.buf_new()
    let have_auth: bool = read_auth(&name, &data, display)
    var req: rt.Buf = rt.buf_new()
    if have_auth {
        req_setup(&req, name.ptr, name.len, data.ptr, data.len)
    } else {
        req_setup(&req, 0 as u64, 0, 0 as u64, 0)
    }
    let sent: bool = send(x, req.ptr, req.len)
    rt.buf_free(&req)
    rt.buf_free(&name)
    rt.buf_free(&data)
    if !sent {
        (*x).fail = 2
        return false
    }
    (*x).open = true
    if !want(x, 8) {
        (*x).fail = 3
        return false
    }
    let base: u64 = (*x).rb.ptr + (*x).rpos as u64
    let extra: usize = (ld16le(base, 6) as usize) * 4
    if !want(x, 8 + extra) {
        (*x).fail = 4
        return false
    }
    var su: Setup = setup_new()
    let basic: u32 = setup_parse((*x).rb.ptr + (*x).rpos as u64, 8 + extra,
        &su)
    if basic != 0 as u32 {
        (*x).fail = basic // 5 abgelehnt, 6 kein 24-Bit-Visual (U1), 7 kurz
        (*x).open = false
        return false
    }
    (*x).id_base = su.id_base
    (*x).id_mask = su.id_mask
    (*x).root = su.root
    // L4: the size of the screen, in pixels and in millimetres.
    let s_px: usize = su.s_px_w
    let s_mm: usize = su.s_mm_w
    // RUNDE CERTUS-WIN4: die Startgroesse haengt am Schirm.
    (*x).schirm_w = su.s_px_w
    (*x).schirm_h = su.s_px_h
    (*x).visual = su.visual
    (*x).depth = su.depth
    (*x).next_id = 0
    (*x).rpos = (*x).rpos + 8 + extra
    // L3: the two atoms. Only here, because no resource base was fixed
    // before -- and still BEFORE the window, because afterwards events
    // could get between the replies.
    fetch_atoms(x)
    // F1: the keyboard layout, likewise BEFORE the window.
    fetch_keymap(x, su.kmin, su.kmax)
    // L4: die Bildpunktdichte.
    (*x).dpi = dpi_bestimmen(x, s_px, s_mm)
    // L5: light or dark.
    read_theme(x)
    return true
}

// L3 -- InternAtom(16) twice, then the two replies.
fn fetch_atoms(x: *mut Platte) {
    var n1: [u8; 12] = "WM_PROTOCOLS"
    var n2: [u8; 16] = "WM_DELETE_WINDOW"
    (*x).a_protocols = atom_von(x, (&n1[0]) as u64, 12)
    (*x).a_delete = atom_von(x, (&n2[0]) as u64, 16)
    // the clipboard's atoms, also before the window
    (*x).a_clipboard = atom_str(x, "CLIPBOARD")
    (*x).a_targets = atom_str(x, "TARGETS")
    (*x).a_utf8 = atom_str(x, "UTF8_STRING")
    (*x).a_text = atom_str(x, "TEXT")
    (*x).a_plain = atom_str(x, "text/plain;charset=utf-8")
    (*x).a_firn = atom_str(x, "FIRN_CLIPBOARD")
    (*x).a_incr = atom_str(x, "INCR")
}

fn atom_str(x: *mut Platte, s: str) -> u32 {
    return atom_von(x, s.p as u64, s.n)
}

fn atom_von(x: *mut Platte, p: u64, n: usize) -> u32 {
    var r: rt.Buf = rt.buf_new()
    req_intern_atom(&r, p, n)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    if !ok {
        return 0 as u32
    }
    if !want(x, 32) {
        return 0 as u32
    }
    let b: u64 = (*x).rb.ptr + (*x).rpos as u64
    let code: u8 = rt.ld8(b, 0)
    var extra: usize = 0
    if code == 1 as u8 {
        extra = (ld32le(b, 4) as usize) * 4
        if !want(x, 32 + extra) {
            return 0 as u32
        }
    }
    var atom: u32 = 0
    if code == 1 as u8 {
        atom = ld32le((*x).rb.ptr + (*x).rpos as u64, 8)
    }
    (*x).rpos = (*x).rpos + 32 + extra
    return atom
}

// Send a request and wait for its WHOLE reply. Only for the
// time before the window: then no events come in between yet.
// Returns: the place of the reply in the receive buffer and its length
// (0 = error or no reply); `rpos` stands BEHIND it afterwards.
fn question(x: *mut Platte, r: *mut rt.Buf, at: *mut usize) -> usize {
    if !send(x, (*r).ptr, (*r).len) {
        return 0
    }
    if !want(x, 32) {
        return 0
    }
    let b: u64 = (*x).rb.ptr + (*x).rpos as u64
    var extra: usize = 0
    if rt.ld8(b, 0) == 1 as u8 {
        extra = (ld32le(b, 4) as usize) * 4
        if !want(x, 32 + extra) {
            return 0
        }
    }
    *at = (*x).rpos
    (*x).rpos = (*x).rpos + 32 + extra
    if rt.ld8((*x).rb.ptr + (*at) as u64, 0) != 1 as u8 {
        return 0
    }
    return 32 + extra
}

// F1 -- GetKeyboardMapping and GetModifierMapping. If one of the
// two fails, the layout stays empty, and `decode_event` takes the old
// way (key_ascii) -- a window without a keyboard would be worse than one
// with a US keyboard.
fn fetch_keymap(x: *mut Platte, kmin: u32, kmax: u32) {
    if kmax < kmin || kmin == 0 as u32 {
        return
    }
    var r: rt.Buf = rt.buf_new()
    req_get_keyboard_mapping(&r, kmin, kmax - kmin + 1 as u32)
    var at: usize = 0
    let n: usize = question(x, &r, &at)
    if n > 0 {
        let ok: bool = keymap_from_reply(&(*x).km, (*x).rb.ptr + at as u64,
            n, kmin)
    }
    rt.buf_clear(&r)
    req_get_modifier_mapping(&r)
    let m: usize = question(x, &r, &at)
    if m > 0 && keymap_ok(&(*x).km) {
        let ok2: bool = keymap_mods_from_reply(&(*x).km,
            (*x).rb.ptr + at as u64, m)
    }
    rt.buf_free(&r)
}

// L4 -- die Bildpunktdichte.
//
// Order: CERTUS_DPI (manual switch, also for the acceptance run), then
// `Xft.dpi` from RESOURCE_MANAGER -- that is what GNOME, KDE and XFCE
// really set and what every toolkit reads --, then the millimetres of
// the screen, otherwise 96.
fn dpi_bestimmen(x: *mut Platte, s_px: usize, s_mm: usize) -> usize {
    var e: [u8; 10] = "CERTUS_DPI"
    var b: rt.Buf = rt.buf_new()
    var d: usize = 0
    if env_get((&e[0]) as u64, 10, &b) {
        d = number_from(rt.buf_ptr(&b), 0, rt.buf_len(&b))
    }
    rt.buf_free(&b)
    if d >= 48 && d <= 480 {
        return d
    }
    d = xft_dpi(x)
    if d >= 48 && d <= 480 {
        return d
    }
    // 1 inch = 25.4 mm; computed as integers and rounded.
    d = dpi_from_mm(s_px, s_mm)
    if d >= 48 && d <= 480 {
        return d
    }
    return 96
}

fn number_from(p: u64, von: usize, bis: usize) -> usize {
    var v: usize = 0
    var i: usize = von
    var sah: bool = false
    while i < bis {
        let ch: u8 = rt.ld8(p, i)
        if ch >= 48 as u8 && ch <= 57 as u8 {
            v = v * 10 + ((ch - 48 as u8) as usize)
            sah = true
        } else if sah {
            return v
        }
        i = i + 1
    }
    if !sah {
        return 0
    }
    return v
}

// RESOURCE_MANAGER is the predefined atom 23 -- it needs no InternAtom.
// Its content is the X resource database as text.
fn xft_dpi(x: *mut Platte) -> usize {
    var r: rt.Buf = rt.buf_new()
    // RESOURCE_MANAGER (23), AnyPropertyType, bis 64 KB Text.
    req_get_property(&r, (*x).root, 23 as u32, 0 as u32, 0 as u32,
        16384 as u32)
    var at: usize = 0
    let n: usize = question(x, &r, &at)
    rt.buf_free(&r)
    if n == 0 {
        return 0
    }
    return resman_dpi((*x).rb.ptr + at as u64, n)
}

// L5 -- light or dark, without a registry and without D-Bus.
fn read_theme(x: *mut Platte) {
    (*x).dark_known = false
    (*x).dark = false
    var b: rt.Buf = rt.buf_new()
    // 1. CERTUS_THEME=dark|light (the manual switch the acceptance run
    //    uses too), then GTK_THEME=Adwaita:dark.
    var e1: [u8; 12] = "CERTUS_THEME"
    var e2: [u8; 9] = "GTK_THEME"
    if env_get((&e1[0]) as u64, 12, &b) && rt.buf_len(&b) > 0 {
        (*x).dark = hat_dark(rt.buf_ptr(&b), rt.buf_len(&b))
        (*x).dark_known = true
        rt.buf_free(&b)
        return
    }
    rt.buf_clear(&b)
    if env_get((&e2[0]) as u64, 9, &b) {
        if hat_dark(rt.buf_ptr(&b), rt.buf_len(&b)) {
            (*x).dark = true
            (*x).dark_known = true
            rt.buf_free(&b)
            return
        }
    }
    // 2. ~/.config/gtk-4.0/settings.ini, then gtk-3.0.
    var e3: [u8; 4] = "HOME"
    rt.buf_clear(&b)
    var home: rt.Buf = rt.buf_new()
    if !env_get((&e3[0]) as u64, 4, &home) {
        var hr: [u8; 5] = "/root"
        rt.buf_push_bytes(&home, (&hr[0]) as u64, 5)
    }
    var found: bool = false
    var s4: [u8; 30] = "/.config/gtk-4.0/settings.ini\0"
    var s3: [u8; 30] = "/.config/gtk-3.0/settings.ini\0"
    found = read_ini(&home, (&s4[0]) as u64, 30, x)
    if !found {
        found = read_ini(&home, (&s3[0]) as u64, 30, x)
    }
    rt.buf_free(&home)
    rt.buf_free(&b)
}

fn read_ini(home: *mut rt.Buf, suffix: u64, sn: usize,
    x: *mut Platte) -> bool {
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, rt.buf_ptr(home), rt.buf_len(home))
    rt.buf_push_bytes(&path, suffix, sn)
    var content: rt.Buf = rt.buf_new()
    let da: bool = rt.read_file(rt.buf_ptr(&path), &content)
    rt.buf_free(&path)
    if !da {
        rt.buf_free(&content)
        return false
    }
    let p: u64 = rt.buf_ptr(&content)
    let n: usize = rt.buf_len(&content)
    var lit: [u8; 34] = "gtk-application-prefer-dark-theme="
    var i: usize = 0
    var antwort: bool = false
    var sah: bool = false
    while i + 34 <= n {
        var equal: bool = true
        var j: usize = 0
        while j < 34 {
            if rt.ld8(p, i + j) != lit[j] {
                equal = false
            }
            j = j + 1
        }
        if equal {
            let v: u8 = rt.ld8(p, i + 34)
            if v == 49 as u8 || v == 116 as u8 || v == 84 as u8 {
                antwort = true
            }
            sah = true
            i = n
        }
        i = i + 1
    }
    if !sah {
        // No explicit key: then the theme name decides, because
        // "Adwaita-dark" is just as common.
        if hat_dark(p, n) {
            antwort = true
            sah = true
        }
    }
    rt.buf_free(&content)
    if sah {
        (*x).dark = antwort
        (*x).dark_known = true
    }
    return sah
}

// Does "dark" or "Dark" stand anywhere?
fn hat_dark(p: u64, n: usize) -> bool {
    var lit: [u8; 4] = "dark"
    var i: usize = 0
    while i + 4 <= n {
        var equal: bool = true
        var j: usize = 0
        while j < 4 {
            var c: u8 = rt.ld8(p, i + j)
            if c >= 65 as u8 && c <= 90 as u8 {
                c = c + 32 as u8
            }
            if c != lit[j] {
                equal = false
            }
            j = j + 1
        }
        if equal {
            return true
        }
        i = i + 1
    }
    return false
}

fn r_dark(x: *mut Platte) -> bool {
    return (*x).dark
}

fn r_dark_known(x: *mut Platte) -> bool {
    return (*x).dark_known
}

// ======================================================= THE WINDOW

fn r_make(x: *mut Platte, w: usize, h: usize) -> bool {
    (*x).win = new_id(x)
    (*x).gc = new_id(x)
    (*x).w = w
    (*x).h = h
    var r: rt.Buf = rt.buf_new()
    // Exposure(32768) | KeyPress(1) | ButtonPress(4) |
    // PointerMotion(64, L1) | StructureNotify(131072); F2 adds
    // KeyRelease(2) | ButtonRelease(8) | EnterWindow(16) |
    // LeaveWindow(32).
    var mask: u32 = 32768 as u32 | 1 as u32 | 4 as u32 | 64 as u32
    | 131072 as u32
    if (*x).full {
        mask = mask | 2 as u32 | 8 as u32 | 16 as u32 | 32 as u32
    }
    (*x).mask = mask
    req_create_window(&r, (*x).win, (*x).root, (*x).depth, (*x).visual,
        w, h, 16777215 as u32, mask)
    req_create_gc(&r, (*x).gc, (*x).win)
    var ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    if !ok {
        return false
    }
    // L3: WM_PROTOCOLS = { WM_DELETE_WINDOW }. Without this line the
    // window manager kills the process instead of asking it.
    if (*x).a_protocols != 0 as u32 && (*x).a_delete != 0 as u32 {
        var q: rt.Buf = rt.buf_new()
        var del: [u32; 1] = [(*x).a_delete; 1]
        // ChangeProperty WM_PROTOCOLS, type ATOM (4), format 32, one atom.
        req_change_property(&q, (*x).win, (*x).a_protocols, 4 as u32,
            32 as u32, (&del[0]) as u64, 4)
        ok = send(x, q.ptr, q.len)
        rt.buf_free(&q)
    }
    if (*x).gift != 0 {
        let okg: bool = r_fill(x, 16711935 as u32, 0, 0, w, h)
    }
    return ok
}

fn r_title(x: *mut Platte, p: u64, n: usize) -> bool {
    var r: rt.Buf = rt.buf_new()
    // WM_NAME (39), Typ STRING (31), Format 8.
    req_change_property(&r, (*x).win, 39 as u32, 31 as u32, 8 as u32, p, n)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    return ok
}

fn r_show(x: *mut Platte) -> bool {
    var r: rt.Buf = rt.buf_new()
    req_map_window(&r, (*x).win)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    if !ok {
        return false
    }
    return r_present(x)
}

// Under X11 there is no client canvas that would have to be created
// anew. The new size is adopted so that `r_width`/`r_height` and the
// clipping in `r_image` are right.
// The screen, in pixels.
fn r_screen(x: *mut Platte, sw: *mut usize, sh: *mut usize) -> bool {
    if (*x).schirm_w == 0 || (*x).schirm_h == 0 {
        return false
    }
    *sw = (*x).schirm_w
    *sh = (*x).schirm_h
    return true
}

// Centring is done under X11 by the WINDOW MANAGER, and the acceptance
// run works without one. So only the honest answer stands here.
fn r_centre(x: *mut Platte) -> bool {
    return false
}

fn r_maximise(x: *mut Platte, w: usize, h: usize) -> bool {
    if w == 0 || h == 0 {
        return false
    }
    (*x).w = w
    (*x).h = h
    if (*x).gift != 0 {
        let okg: bool = r_fill(x, 16711935 as u32, 0, 0, w, h)
    }
    return true
}

fn r_poison(x: *mut Platte, an: bool) {
    if an {
        (*x).gift = 1
    } else {
        (*x).gift = 0
    }
}

// ----------------------------------------------------------- painting

fn r_fill(x: *mut Platte, px: u32, x0: usize, y0: usize, w: usize,
    h: usize) -> bool {
    var r: rt.Buf = rt.buf_new()
    rt.buf_push(&r, 56 as u8) // ChangeGC
    rt.buf_push(&r, 0 as u8)
    put16(&r, 4 as u32)
    put32(&r, (*x).gc)
    put32(&r, 4 as u32) // GCForeground
    put32(&r, px)
    rt.buf_push(&r, 70 as u8) // PolyFillRectangle
    rt.buf_push(&r, 0 as u8)
    put16(&r, 5 as u32)
    put32(&r, (*x).win)
    put32(&r, (*x).gc)
    put16(&r, x0 as u32)
    put16(&r, y0 as u32)
    put16(&r, w as u32)
    put16(&r, h as u32)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    return ok
}

// The canvas as BGRX. A PutImage must not be longer than the largest
// request of the server -- the image goes over in bands.
fn r_image(x: *mut Platte, px: u64, w: usize, h: usize, dx: usize,
    dy: usize) -> bool {
    let per_row: usize = w * 4
    if per_row == 0 {
        return true
    }
    var rows: usize = 65536 / per_row
    if rows == 0 {
        rows = 1
    }
    var y: usize = 0
    var r: rt.Buf = rt.buf_new()
    while y < h {
        var band: usize = h - y
        if band > rows {
            band = rows
        }
        rt.buf_clear(&r)
        let bytes: usize = band * per_row
        req_put_image_head(&r, (*x).win, (*x).gc, w, band, dx, dy + y,
            (*x).depth, bytes)
        rt.buf_push_bytes(&r, px + (y * per_row) as u64, bytes)
        if !send(x, r.ptr, r.len) {
            rt.buf_free(&r)
            return false
        }
        y = y + band
    }
    rt.buf_free(&r)
    return true
}

// The font of the server for labels. Every X server has had "fixed"
// since 1987.
fn r_font(x: *mut Platte) -> bool {
    if (*x).font == 0 as u32 {
        (*x).font = new_id(x)
    }
    var nm: [u8; 5] = "fixed"
    var r: rt.Buf = rt.buf_new()
    rt.buf_push(&r, 45 as u8) // OpenFont
    rt.buf_push(&r, 0 as u8)
    put16(&r, (3 + (5 + pad4(5)) / 4) as u32)
    put32(&r, (*x).font)
    put16(&r, 5 as u32)
    put16(&r, 0 as u32)
    rt.buf_push_bytes(&r, (&nm[0]) as u64, 5)
    var q: usize = 0
    while q < pad4(5) {
        rt.buf_push(&r, 0 as u8)
        q = q + 1
    }
    rt.buf_push(&r, 56 as u8) // ChangeGC: font
    rt.buf_push(&r, 0 as u8)
    put16(&r, 4 as u32)
    put32(&r, (*x).gc)
    put32(&r, 16384 as u32) // GCFont
    put32(&r, (*x).font)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    return ok
}

// ImageText8: the octets are drawn with a filled background.
// `ty` ist die Grundlinie.
fn r_text(x: *mut Platte, px: u32, bg: u32, tx: usize, ty: usize, p: u64,
    n: usize) -> bool {
    var m: usize = n
    if m > 254 {
        m = 254
    }
    var r: rt.Buf = rt.buf_new()
    rt.buf_push(&r, 56 as u8) // ChangeGC
    rt.buf_push(&r, 0 as u8)
    put16(&r, 5 as u32)
    put32(&r, (*x).gc)
    put32(&r, 12 as u32) // GCForeground | GCBackground
    put32(&r, px)
    put32(&r, bg)
    rt.buf_push(&r, 76 as u8) // ImageText8
    rt.buf_push(&r, m as u8)
    put16(&r, (4 + (m + pad4(m)) / 4) as u32)
    put32(&r, (*x).win)
    put32(&r, (*x).gc)
    put16(&r, tx as u32)
    put16(&r, ty as u32)
    rt.buf_push_bytes(&r, p, m)
    var q: usize = 0
    while q < pad4(m) {
        rt.buf_push(&r, 0 as u8)
        q = q + 1
    }
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    return ok
}

// Nothing is buffered on this side -- a request goes out as soon as it
// is built. GetInputFocus is the classic round trip that makes the
// server work everything off before it answers.
// X11 knows no "the user is dragging right now": the window manager
// does not say so. On Linux it therefore still re-lays out on every
// ConfigureNotify -- coalesced as before. A named limit.
#[no_gc]
fn r_dragging(w: *mut Platte) -> bool { return false }

fn r_present(x: *mut Platte) -> bool {
    var r: rt.Buf = rt.buf_new()
    rt.buf_push(&r, 43 as u8)
    rt.buf_push(&r, 0 as u8)
    put16(&r, 1 as u32)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    return ok
}

// U4 -- no client canvas; the capture comes with `xwd`.
fn r_ppm(x: *mut Platte, path: u64) -> bool {
    return false
}

// ==================================================== DIE EREIGNISSE

// REPLIES ARE NOT EVENTS. The round trip in `r_blit` (GetInputFocus)
// brings a 32 octet REPLY back. Whoever counts it as an event builds
// himself a wait loop that never sleeps -- the first run of this round
// did exactly that, and you could see it because `xwd` caught a half
// painted image (background yes, boxes no). So away with everything
// that is NOT an event: replies (code 1) and errors (code 0).
//
fn drain_replies(x: *mut Platte) {
    var runs: bool = true
    while runs {
        if (*x).rb.len - (*x).rpos < 32 {
            return
        }
        let p: u64 = (*x).rb.ptr + (*x).rpos as u64
        let code: u8 = rt.ld8(p, 0) & 127 as u8
        if code == 1 as u8 {
            let extra: usize = (ld32le(p, 4) as usize) * 4
            if !want(x, 32 + extra) {
                return
            }
            (*x).rpos = (*x).rpos + 32 + extra
        } else if code == 0 as u8 {
            (*x).rpos = (*x).rpos + 32
        } else {
            return
        }
    }
}

fn r_pending(x: *mut Platte) -> bool {
    if (*x).inj != 0 as u32 {
        return true
    }
    drain_replies(x)
    return (*x).rb.len - (*x).rpos >= 32
}

// ===================================================================
// ROUND C-040 -- LOOKING WHETHER AN INPUT IS THERE (without fetching it)
// ===================================================================
//
// X11 does not deliver events in a queue inside the program, but
// as octets on a connection. Whoever wants to know whether a key
// is waiting has to look into the RECEIVE BUFFER -- and without
// moving `rpos`, because otherwise the event would be gone for the
// picture loop.
//
// Hence a SECOND pointer, `spos`: it runs over the same
// records, but takes nothing out. Every record is 32
// octets long; only a reply (code 1) carries an attachment. A
// record that has arrived only half stays lying -- the next time
// it stands there whole.
//
// EVERY input is reported exactly ONCE, because `spos` runs only
// forward. Counted is what a human triggered: KeyPress (2)
// and ButtonPress (4). NOT KeyRelease (3) -- `r_next` makes
// no event of it, so `ein_n` would rise by one for every release
// and NEVER fall again; the priority would then stand forever
// at "a key is waiting". Also not MotionNotify (6): a
// mouse moving across the window would otherwise shift every slice of the
// page build, and the page would never be finished.
//
// `ein_weg` makes the number fall again as soon as `r_next` really
// hands the input out -- otherwise the priority would have no end.
fn eingaben_spaehen(x: *mut Platte) {
    if (*x).spos < (*x).rpos {
        (*x).spos = (*x).rpos
    }
    var runs: bool = true
    while runs {
        if (*x).rb.len - (*x).spos < 32 {
            return
        }
        let p: u64 = (*x).rb.ptr + (*x).spos as u64
        let code: u8 = rt.ld8(p, 0) & 127 as u8
        var consume: usize = 32
        if code == 1 as u8 {
            let extra: usize = (ld32le(p, 4) as usize) * 4
            if (*x).rb.len - (*x).spos < 32 + extra {
                return
            }
            consume = 32 + extra
        }
        (*x).spos = (*x).spos + consume
        if code == 2 as u8 || code == 4 as u8 {
            (*x).ein_n = (*x).ein_n + 1
            (*x).ein_hook((*x).ein_ud)
        }
    }
}

// The host function that `vorrang.vorrang_wirt_setzen` gets as
// `hat_eingabe`: first look through freshly read octets, then
// answer whether a seen input is still unfetched.
fn r_input_pending(x: *mut Platte) -> bool {
    if !(*x).open {
        return false
    }
    // ===============================================================
    // ROUND C-040, FOLLOW-UP fix-r4-1 -- FIRST READ, THEN SPY
    // ===============================================================
    //
    // Here there stood only `eingaben_spaehen(x)`, and the comment above it
    // promised "first look through freshly read octets". That is exactly what it
    // did NOT do: `eingaben_spaehen` runs over the
    // RECEIVE BUFFER, and whoever fills the buffer is `lese_nach` --
    // that is called from `r_wait`/`nachsehen`.
    //
    // THE MEASURABLE DAMAGE, from the trace /tmp/f41a.spur (xoffi.ai,
    // .bau/fixr41/browser, click at 4.0 s, then five keys at an
    // interval of 0.7 s):
    //
    //     E 10464453 1     <- all SIX inputs
    //     E 10464454 2        at once, at 10.46 s
    //     ... up to E ... 6
    //
    // The six events stood in the kernel all the time and were
    // seen only when the picture loop called `next_event` again.
    // The cause is one line in `window.wait_event`:
    //
    //     if backend.r_pending(&(*f).p) { return true }
    //
    // During the page build nobody fetches events. In the
    // receive buffer there is therefore always still something (an Expose, a
    // reply), `r_pending` says "yes, there is something", and `r_wait` -- and with
    // it the only `lese_nach` on this path -- is NEVER called.
    // The breathing hook thereby pumped a buffer that no longer
    // filled: the blockade clock ran right (bar 1 was real),
    // but the input priority could see nothing, and the
    // key latency stayed at seven seconds.
    //
    // `nachsehen` is a `poll` with deadline 0 and a `read` if
    // something is there -- so exactly as expensive as the look that this
    // function pretends to take. Its return value says only whether the
    // connection is still alive; the end of the window is reported by the
    // picture loop via `next_event`, here it would be the wrong place.
    let lives: bool = nachsehen(x)
    eingaben_spaehen(x)
    return (*x).ein_n != 0
}

fn now_us() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000 + (ts[1] as u64) / 1000
}

// WAITING. `ms` < 0 = forever, 0 = only look.
fn r_wait(x: *mut Platte, ms: i64) -> bool {
    if r_pending(x) {
        return true
    }
    if !(*x).open {
        return false
    }
    let fd: i32 = net.conn_fd(&(*x).c)
    // struct pollfd { int fd; short events; short revents; }
    var pfd: [i32; 2] = [0; 2]
    pfd[0] = fd
    pfd[1] = 1 // POLLIN
    let start: u64 = now_us()
    var rest: i64 = ms
    var runs: bool = true
    while runs {
        pfd[1] = 1
        let r: i64 = syscall(7, (&pfd[0]) as i64, 1, rest, 0, 0, 0)
        if r > 0 {
            let ok: bool = read_after(x)
            if r_pending(x) {
                return true
            }
            if !(*x).open {
                return true
            }
            // ONLY a reply came. Keep waiting -- but only the remaining
            // time, otherwise `wait_event(50)` would be a deadline without end.
            if ms >= 0 {
                let hin: i64 = ((now_us() - start) / 1000 as u64) as i64
                if hin >= ms {
                    return false
                }
                rest = ms - hin
            }
        } else {
            // U5: die Frist ist abgelaufen. Hoechstens einmal je
            // second, look at the system whether light/dark was switched
            // over.
            let n: u64 = now_us()
            if n > (*x).dark_us + 1000000 as u64 {
                (*x).dark_us = n
                let before: bool = (*x).dark
                read_theme(x)
                if (*x).dark != before {
                    (*x).inj = window.EV_THEME
                    return true
                }
            }
            return false
        }
    }
    return false
}

// A glance at the socket, without waiting. false = the connection is
// gone (the server closed or the window was killed).
fn nachsehen(x: *mut Platte) -> bool {
    if !(*x).open {
        return false
    }
    let fd: i32 = net.conn_fd(&(*x).c)
    var pfd: [i32; 2] = [0; 2]
    pfd[0] = fd
    pfd[1] = 1 // POLLIN
    let r: i64 = syscall(7, (&pfd[0]) as i64, 1, 0, 0, 0, 0)
    if r > 0 {
        let ok: bool = read_after(x)
        return (*x).open
    }
    return true
}

// The next event, NON blocking. Replies and errors are thrown away --
// apart from the atoms and RESOURCE_MANAGER this client asks no
// question whose answer it needs, and those two are done before the
// first event.
fn ein_weg(x: *mut Platte) {
    if (*x).ein_n != 0 {
        (*x).ein_n = (*x).ein_n - 1
    }
}

fn r_next(x: *mut Platte, k: *mut u32, a: *mut u32, ox: *mut u32,
    oy: *mut u32, os: *mut u32) -> bool {
    // ROUND C-040: first look at what has come in since the last
    // time. With that a key is reported ONCE even when no page
    // build is running and therefore nobody has called
    // `r_input_pending`.
    eingaben_spaehen(x)
    if (*x).inj != 0 as u32 {
        *k = (*x).inj
        *a = 0 as u32
        *ox = 0 as u32
        *oy = 0 as u32
        *os = 0 as u32
        (*x).inj = 0
        return true
    }
    var runs: bool = true
    while runs {
        if (*x).rb.len - (*x).rpos < 32 {
            // Look once WITHOUT waiting. That makes `next_event` mean the
            // same on both systems: "give me an event if there is one
            // right now" -- under Windows `pump(w, 0)` does exactly
            // that.
            let lives: bool = nachsehen(x)
            if !lives {
                *k = window.EV_CLOSED
                *a = 0 as u32
                *ox = 0 as u32
                *oy = 0 as u32
                *os = 0 as u32
                return true
            }
            if (*x).rb.len - (*x).rpos < 32 {
                return false
            }
            // Fresh octets: those too can carry an input.
            eingaben_spaehen(x)
        }
        let p: u64 = (*x).rb.ptr + (*x).rpos as u64
        let code: u8 = rt.ld8(p, 0) & 127 as u8
        var consume: usize = 32
        if code == 1 as u8 {
            let extra: usize = (ld32le(p, 4) as usize) * 4
            if !want(x, 32 + extra) {
                *k = window.EV_CLOSED
                return true
            }
            consume = 32 + extra
        }
        (*x).rpos = (*x).rpos + consume
        if code == 2 as u8 || code == 4 as u8 {
            // ROUND C-040: this input is now out -- the
            // priority for it is settled.
            ein_weg(x)
        }
        // `want` may just have moved the buffer -- the place is
        // therefore determined AFRESH and not taken from `p` above.
        // Replies (1) and errors (0) are not events.
        if code == 30 as u8 { // SelectionRequest: somebody wants our clipboard
            let q: u64 = (*x).rb.ptr + ((*x).rpos - consume) as u64
            var ev: [u8; 32] = [0 as u8; 32]
            rt.mem_copy((&ev[0]) as u64, q, 32)
            answer_selection(x, (&ev[0]) as u64)
            continue
        }
        if code == 28 as u8 { // PropertyNotify: the next piece of an INCR transfer
            let q: u64 = (*x).rb.ptr + ((*x).rpos - consume) as u64
            var ev: [u8; 32] = [0 as u8; 32]
            rt.mem_copy((&ev[0]) as u64, q, 32)
            incr_next(x, (&ev[0]) as u64)
            continue
        }
        if code == 29 as u8 { // SelectionClear: another program owns it now
            let q: u64 = (*x).rb.ptr + ((*x).rpos - consume) as u64
            if ld32le(q, 12) == (*x).a_clipboard {
                clip_drop(x)
            }
            continue
        }
        if code != 1 as u8 && code != 0 as u8 {
            let q: u64 = (*x).rb.ptr + ((*x).rpos - consume) as u64
            if decode_event(q, (*x).a_delete, &(*x).km, (*x).full, k, a,
                ox, oy, os) {
                return true
            }
        }
    }
    return false
}

// Does this key number have a meaning (K_*)? The numbers ARE the X11
// numbers; lib/window/win32.fi maps Windows onto them.
fn is_key(kc: u32) -> bool {
    return kc == window.K_ESCAPE || kc == window.K_BACK
    || kc == window.K_TAB || kc == window.K_RETURN
    || kc == window.K_HOME || kc == window.K_UP
    || kc == window.K_PAGEUP || kc == window.K_LEFT
    || kc == window.K_RIGHT || kc == window.K_END
    || kc == window.K_DOWN || kc == window.K_PAGEDOWN
    || kc == window.K_DELETE
}

// The US keyboard, as every X server hands it out, for the ASCII
// range. Four rows that have not moved since the IBM PC -- as a TABLE
// and not as four almost identical blocks.
// ======================================================================
// ROUND C-033 -- THE COLON WAS MISSING. SO ALSO "https://".
// ======================================================================
//
// FOUND IN THE PICTURE RUN OF THIS ROUND: the acceptance run typed
// "127.0.0.1:8137/zwei.html" into the address bar, and in the window there stood
// "127.0.0.1;8137/zwei.html" -- a SEMICOLON. The first suspicion was
// the keyboard layout of the Xvfb; it was not that (`xmodmap -pke` shows
// "keycode 47 = semicolon colon semicolon colon", and `xdotool key
// colon` dutifully sends Shift+47).
//
// It was THIS FUNCTION. The shift level applied here to exactly two
// groups: the digit row (through `ziffern_um`) and the letters
// (through the `- 32`). For all other keys of the three
// letter rows `shift` FELL UNDER THE TABLE, and that is seven
// characters:
//
//     ;  ->  :        '  ->  "        [  ->  {        ]  ->  }
//     ,  ->  <        .  ->  >        /  ->  ?
//
// The colon is among them. In other words: NO HUMAN COULD EVER TYPE
// "https://" IN CERTUS -- only addresses without a scheme, which
// `bar_normalisieren` then completes itself. Just as little a "?"
// and thereby not a single search query by hand.
//
// It was never noticed, because every acceptance passes the address as an ARGUMENT
// and does not type it. Only the picture run of this round
// really typed.
//
// The table `reihen_um` is the shift level of the US layout,
// character by character at the same place as `reihen`. A dot
// stands for "no shift level of its own" -- there the
// letter rule applies afterwards.
fn key_ascii(code: u32, shift: bool) -> u32 {
    var von: [u32; 4] = [10, 24, 38, 52]
    var bis: [u32; 4] = [21, 35, 48, 61]
    var ab: [usize; 4] = [0, 12, 24, 35]
    var rows: [u8; 45] = "1234567890-=qwertyuiop[]asdfghjkl;'zxcvbnm,./"
    // THE SAME LENGTH, THE SAME ORDER. Where a letter stands,
    // there stands a space here -- the capitalisation is done by the
    // rule below.
    var rows_around: [u8; 45] = "!@#$%^&*()_+          {}         :\"       <>?"
    var digits_impl: [u8; 12] = "!@#$%^&*()_+"
    var i: usize = 0
    while i < 4 {
        if code >= von[i] && code <= bis[i] {
            let k: usize = (code - von[i]) as usize
            if i == 0 && shift {
                return digits_impl[k] as u32
            }
            var ch: u32 = rows[ab[i] + k] as u32
            if shift {
                // FIRST the key's own shift level ...
                let um: u32 = rows_around[ab[i] + k] as u32
                if um != 32 as u32 {
                    return um
                }
                // ... and otherwise the letter rule as before.
                if ch >= 97 as u32 && ch <= 122 as u32 {
                    ch = ch - 32 as u32
                }
            }
            return ch
        }
        i = i + 1
    }
    if code == 65 as u32 {
        return 32 as u32 // Leerzeichen
    }
    return 0 as u32
}

fn r_close(x: *mut Platte) {
    if (*x).open {
        net.close(&(*x).c)
        (*x).open = false
    }
    rt.buf_free(&(*x).rb)
}

// ======================================================================
// ROUND C-038 -- THE SELF-UPDATE DOES NOT EXIST HERE
// ======================================================================
//
// `certus-update.exe` is a Windows program (tools/windows/update.c,
// built to certus-update.exe next to certus.exe). Under Linux
// Certus is not installed from a ZIP from store.fleitec.com, but
// built from the source -- a self-update would there be
// not only unnecessary, but wrong.
//
// So an honest `false` instead of a silent do-nothing: the
// caller then tells the user "self-update exists only under
// Windows", and that is true too. A stub that returns `true` and
// does nothing would be exactly the dead switch that C-036 already
// forbade.
fn r_update_start(with_window: bool) -> bool {
    return false
}
// ROUND C-040: the closing brace was missing. Without it
