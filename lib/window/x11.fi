// SPDX-License-Identifier: MPL-2.0
// Herkunft: Certus, lib/window/x11.fi, Stand Certus-Commit 1f1ec17bdb68 (zuletzt
// geaendert in cbbc9d8c0475); vom alleinigen Urheber Justin am 23.09.2026
// fuer Firn unter MPL-2.0 freigegeben.
// lib/window/x11.fi -- DIE RUECKWAND X11 (Runde FENSTER).
//
// NOT rewritten: this is lib/browser/x11.fi from round B5, rehung onto
// the contract of lib/window/window.fi and extended by exactly the
// gaps that the comparison with lib/windows/gdi.fi uncovered. The
// whole X11 client without Xlib, without xcb, without a C library
// stands there line for line as before.
//
// Used are CreateWindow(1), CreateGC(55), MapWindow(8),
// PutImage(72), PolyFillRectangle(70), ChangeProperty(18),
// GetProperty(20), InternAtom(16), OpenFont(45), ChangeGC(56),
// ImageText8(76) and the events Expose(12), KeyPress(2),
// ButtonPress(4), MotionNotify(6), ConfigureNotify(22),
// ClientMessage(33).
//
// ============================ WHAT THIS ROUND ADDED (the gaps)
//
// L1 EV_MOTION. The event mask did not have PointerMotion. Without
//    pointer movement no hovered button -- under Windows that existed
//    since CERTUS-WIN2, under X11 not.
// L2 EV_CHAR. Before, the client only handed out key numbers, and
//    EVERY program had to call `x11_key_ascii` itself. Now the backend
//    splits like Windows: keys with meaning as EV_KEY, printable
//    characters as EV_CHAR.
// L3 WM_DELETE_WINDOW. Before, closing the window killed the process
//    with an I/O error (U2 of the old file). Now the window manager
//    asks, and the program gets EV_CLOSED.
// L4 THE PIXEL DENSITY. `Xft.dpi` from RESOURCE_MANAGER (what every
//    desktop really sets), otherwise pixels and millimetres of the
//    screen from the connection block -- two numbers the old version
//    read past --, otherwise 96.
// L5 LIGHT/DARK. There is no registry. Read are CERTUS_THEME and
//    GTK_THEME from the environment, then
//    ~/.config/gtk-4.0/settings.ini and gtk-3.0 -- the file GNOME and
//    XFCE really write.
// L6 THE ENVIRONMENT. "Not reachable from `rt`" had stood in the
//    header of this file since B5, and that is why a fixed path stood here
//    `/root/.Xauthority`. /proc/self/environ braucht open, read, close.
//
// ================================================================ EHRLICH
//
// U1 ONE VISUAL: 24 bit in a 32 bit pixel. Another depth is a refusal
//    with a reason and not a black window.
// U2 THE WHOLE CANVAS GOES OVER ON EVERY FRAME (3.8 MB at 1200x800).
//    A damage rectangle would be the next step.
// U3 NO SHARED MEMORY (MIT-SHM), NO BACK BUFFER: `fill` and `text` go
//    to the server one by one. Whoever wants to be flicker free paints
//    into an own buffer and sends ONE `image`.
// U4 `r_ppm` DOES NOT EXIST HERE (false). The client holds no canvas.
//    The capture comes during acceptance with `xwd` FROM THE SERVER --
//    the stronger measurement: a program that claims to have painted
//    is caught there and not here.
// U5 EV_THEME arrives when a change is noticed as a wait expires.
//    auffaellt (hoechstens einmal je Sekunde nachgesehen). Wer ewig
//    waits forever never gets it; for that there is `window.theme_reload`.
//    Immediately would only work through the XDG portal on D-Bus.
// ======================================= WHAT FIRN ADDED (23.09.2026)
//
// F1 THE KEYBOARD FROM THE SERVER. GetKeyboardMapping and
//    GetModifierMapping at connect time; a key becomes a KEYSYM by the
//    rules of the protocol (Shift, Lock, NumLock, AltGr), and the keysym
//    decides K_* and the character. `key_ascii` (the fixed US table)
//    stays only as the fallback when the server does not answer.
// F2 RELEASE, ENTER, LEAVE -- on request (`window.full_input`), so that a
//    program that does not want them sees exactly what it saw before.
//    lib/fui/control.fi needs the release: a click there is press AND
//    release on the same widget.
// F3 ~/.Xauthority BY DISPLAY NUMBER instead of "the first cookie".
// F4 THE PROTOCOL AS PURE FUNCTIONS (`req_*`, `setup_parse`,
//    `keymap_*`, `decode_event`, `auth_pick`, `resman_dpi`): every
//    request and every reply this client knows is built/read by a
//    function without a connection, and tools/fui/x11_main.fi checks
//    them octet by octet against hand-derived values and against real
//    captures of an Xvfb (testdata/x11/).
//
// WHAT DOES NOT WORK (still): dead keys and compose (a dead key gives no
// character), the old Latin-2..9/Cyrillic keysym tables (only Latin-1
// and the Unicode keysyms become characters), TCP displays
// (`host:0`), MIT-SHM, and more than the first screen.
import std.rt
import std.net
import window.window
// DIE MELDUNG "EINE EINGABE IST DA" -- an wen, sagt der Wirt.
//
// In Certus rief diese Rueckwand hier `browser.vorrang` direkt; der
// Eingabe-Vorrang ist aber eine Sache des BROWSERS (er verschiebt
// Scheiben des Seitenbaus), nicht des Fensters. In Firn gibt es keinen
// browser.vorrang, und eine Fensterschicht, die einen bestimmten Wirt
// kennt, kann kein anderer benutzen. Also meldet die Rueckwand an einen
// Haken, den der Wirt setzt (`window.input_hook`); Certus haengt dort
// `vorrang.vorrang_eingabe_melden` ein und bekommt dasselbe Verhalten
// wie vorher. Ohne Haken passiert nichts -- wie bei einem Wirt ohne
// Vorrang.

export {
    r_notify, r_stay_alive, r_in_front,
    r_dragging,
    Platte, surface_new,
    r_open, r_make, r_show, r_title, r_close, r_is_open,
    r_width, r_height, r_dpi, r_maximise,
    r_image, r_fill, r_font, r_text, r_present, r_ppm,
    r_wait, r_pending, r_next, r_dark, r_dark_known, r_poison,
    r_input_pending,
    r_titlebar_dark, r_titlebar_colour,
    // RUNDE C-049 -- der eigene Fensterrahmen. Unter X11 gibt es ihn
    // NICHT (siehe die Begruendung bei `r_frame_can`); die Namen
    // muessen trotzdem da sein, weil lib/window/window.fi sie ruft.
    r_frame_can, r_frame_own, r_frame_height, r_button_zone,
    r_content_size,
    r_minimise, r_max_toggle, r_maximised, r_drag,
    r_sysmenu,
    r_screen, r_centre,
    // RUNDE C-033: damit die Abnahme die Tastenbelegung pruefen kann.
    // Sie war es, die den fehlenden Doppelpunkt aufgedeckt hat.
    key_ascii,
    r_update_start,
    r_input_hook, r_full_input,
    // F4: das Protokoll als reine Funktionen -- fuer tools/fui/x11_main.fi.
    Setup, setup_new, setup_parse, dpi_from_mm, resman_dpi, xft_dpi_in,
    req_setup, req_intern_atom, req_create_window, req_create_gc,
    req_change_property, req_map_window, req_get_property,
    req_get_keyboard_mapping, req_get_modifier_mapping,
    req_put_image_head,
    Keymap, keymap_new, keymap_ok, keymap_from_reply,
    keymap_mods_from_reply, keymap_col, keymap_sym, ks_key, ks_char,
    decode_event, auth_pick,
}

const RD_ERR: usize = 18446744073709551615

struct Platte {
    c: net.Conn,
    open: bool,
    schirm_w: usize,
    schirm_h: usize,
    root: u32,
    id_base: u32,
    id_mask: u32,
    next_id: u32,
    visual: u32,
    depth: u32,
    win: u32,
    gc: u32,
    font: u32,
    w: usize,
    h: usize,
    seq: u32,
    // the reply/event buffer
    rb: rt.Buf,
    rpos: usize,
    // the atoms for WM_DELETE_WINDOW (L3)
    a_protocols: u32,
    a_delete: u32,
    // die Bildpunktdichte (L4)
    dpi: usize,
    // hell/dark (L5)
    dark: bool,
    dark_bekannt: bool,
    dark_us: u64,
    // an injected event (EV_THEME); 0 = none
    inj: u32,
    // the poison, see window.set_poison
    gift: u32,
    fail: u32,
    // RUNDE C-040 -- DIE EINGABESPUR AUF DER X11-VERBINDUNG.
    //
    // `spos` ist die Stelle im Empfangspuffer, bis zu der schon NACH
    // EINGABEN GESEHEN wurde (nicht: verarbeitet). Sie laeuft `rpos`
    // voraus: wer mitten im Umbruch nachsieht, will wissen, ob eine
    // Taste DA IST, ohne sie aus der Schlange zu nehmen -- ein
    // verarbeiteter Klick mitten im Umbruch riefe `load_url` aus
    // `load_url` heraus (siehe `pumpe_kurz` in certus_app.fi).
    // `ein_n` ist die Zahl der gesehenen, aber noch nicht geholten
    // Eingaben.
    spos: usize,
    ein_n: u64,
    // Der Haken fuer die Eingabemeldung, siehe oben.
    ein_hook: fn(u64),
    ein_ud: u64,
    // F1: die Belegung des Servers. F2: Loslassen/Hinein/Hinaus melden?
    km: Keymap,
    voll: bool,
}

fn surface_new() -> Platte {
    return Platte { c: net.Conn { fd: -1, err: 0, peer: 0 as u32,
            peer_port: 0 as u16 }, open: false, schirm_w: 0, schirm_h: 0,
        root: 0, id_base: 0,
        id_mask: 0, next_id: 0, visual: 0, depth: 0, win: 0, gc: 0,
        font: 0, w: 0, h: 0, seq: 0, rb: rt.buf_new(), rpos: 0,
        a_protocols: 0, a_delete: 0, dpi: 96, dark: false,
        dark_bekannt: false, dark_us: 0, inj: 0, gift: 0, fail: 0,
        spos: 0, ein_n: 0, ein_hook: ein_nichts, ein_ud: 0,
        km: keymap_new(), voll: false }
}

fn ein_nichts(ud: u64) { }

// F2 -- Loslassen, Hinein und Hinaus melden. Muss VOR `r_make` stehen:
// die Ereignismaske ist Teil von CreateWindow.
fn r_full_input(x: *mut Platte, an: bool) -> bool {
    (*x).voll = an
    return true
}

// Den Haken setzen. `ud` reicht der Wirt sich selbst durch.
fn r_input_hook(x: *mut Platte, h: fn(u64), ud: u64) {
    (*x).ein_hook = h
    (*x).ein_ud = ud
}


fn r_is_open(x: *mut Platte) -> bool {
    return (*x).open
}

fn r_width(x: *mut Platte) -> usize {
    return (*x).w
}

fn r_height(x: *mut Platte) -> usize {
    return (*x).h
}

fn r_dpi(x: *mut Platte) -> usize {
    return (*x).dpi
}

// ------------------------------------------------------- kleine Helfer

fn put32(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 8) & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 16) & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 24) & 255 as u32) as u8)
}

fn put16(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 8) & 255 as u32) as u8)
}

fn ld32le(p: u64, off: usize) -> u32 {
    return (rt.ld8(p, off) as u32) | ((rt.ld8(p, off + 1) as u32) << 8)
    | ((rt.ld8(p, off + 2) as u32) << 16)
    | ((rt.ld8(p, off + 3) as u32) << 24)
}

fn ld16le(p: u64, off: usize) -> u32 {
    return (rt.ld8(p, off) as u32) | ((rt.ld8(p, off + 1) as u32) << 8)
}

fn pad4(n: usize) -> usize {
    return (4 - (n % 4)) % 4
}

fn send(x: *mut Platte, p: u64, n: usize) -> bool {
    let k: usize = net.write_all(&(*x).c, p, n) catch RD_ERR
    return k == n
}

// Liest, bis mindestens `need` Oktett an `rpos` stehen. BLOCKIEREND --
// only for opening the connection and for the rest of a reply whose
// beginning is already there.
fn want(x: *mut Platte, need: usize) -> bool {
    while (*x).rb.len - (*x).rpos < need {
        if !lese_nach(x) {
            return false
        }
    }
    return true
}

// A single `read`. Blocks when nothing is there -- it is called either
// from `want` (the server has already sent) or after `poll` has said
// that something is there.
fn lese_nach(x: *mut Platte) -> bool {
    if (*x).rpos > 0 && (*x).rpos == (*x).rb.len {
        rt.buf_clear(&(*x).rb)
        (*x).rpos = 0
        // RUNDE C-040: der Puffer faengt von vorn an -- der
        // Eingabezeiger muss mit, sonst zeigte er hinter das Ende und
        // es wuerde nie wieder nachgesehen.
        (*x).spos = 0
    }
    let have: usize = (*x).rb.len
    rt.buf_reserve(&(*x).rb, have + 65536)
    if (*x).rb.cap < have + 65536 {
        return false
    }
    let k: usize = net.read(&(*x).c, (*x).rb.ptr + have as u64, 65536)
    catch RD_ERR
    if k == RD_ERR || k == 0 {
        (*x).open = false
        return false
    }
    rt.buf_set_len(&(*x).rb, have + k)
    return true
}

// ======================================================================
// DAS PROTOKOLL ALS REINE FUNKTIONEN (Firn, 23.09.2026)
// ======================================================================
//
// WARUM DIESER ABSCHNITT. In Certus baute jede Funktion ihre Anfrage
// an Ort und Stelle zusammen und schickte sie sofort ab. Das lief --
// aber pruefen liess es sich nur mit einem laufenden X-Server, und der
// fehlt auf fast jedem Rechner, auf dem ein Abnahmelauf laeuft. Also
// steht hier jede Anfrage als Funktion, die NUR in einen Puffer
// schreibt, und jede Antwort als Funktion, die NUR aus einem Puffer
// liest. Die Aufrufer weiter unten benutzen genau diese Funktionen;
// tools/fui/x11_main.fi legt dieselben Funktionen Oktett fuer Oktett
// neben von Hand bestimmte Sollwerte und neben echte Mitschnitte eines
// Xvfb (testdata/x11/). Es gibt also keinen zweiten, "Pruef"-Weg.
//
// Die Zahlen sind die des Protokolls (X Window System Protocol, X11R7,
// Kapitel 9 fuer die Anfragen und Anhang B fuer das Oktettformat).

// Nullen bis zur naechsten Vierergrenze.
fn pad_to4(b: *mut rt.Buf, n: usize) {
    var q: usize = 0
    let p: usize = pad4(n)
    while q < p {
        rt.buf_push(b, 0 as u8)
        q = q + 1
    }
}

// DER VERBINDUNGSAUFBAU. 'l' = kleinendisch, Protokoll 11.0, dann Name
// und Daten der Berechtigung, jedes auf vier Oktett aufgefuellt. Ohne
// Berechtigung sind beide Laengen 0 und es folgt nichts.
fn req_setup(b: *mut rt.Buf, np: u64, nn: usize, dp: u64, dn: usize) {
    rt.buf_push(b, 108 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 11 as u32)
    put16(b, 0 as u32)
    put16(b, nn as u32)
    put16(b, dn as u32)
    put16(b, 0 as u32)
    rt.buf_push_bytes(b, np, nn)
    pad_to4(b, nn)
    rt.buf_push_bytes(b, dp, dn)
    pad_to4(b, dn)
}

// InternAtom(16), only-if-exists = nein.
fn req_intern_atom(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push(b, 16 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, (2 + (n + pad4(n)) / 4) as u32)
    put16(b, n as u32)
    put16(b, 0 as u32)
    rt.buf_push_bytes(b, p, n)
    pad_to4(b, n)
}

// CreateWindow(1) bei (0,0), Rand 0, InputOutput, mit genau zwei
// Werten: background-pixel (2) und event-mask (2048).
fn req_create_window(b: *mut rt.Buf, wid: u32, parent: u32, depth: u32,
    visual: u32, w: usize, h: usize, bg: u32, maske: u32) {
    rt.buf_push(b, 1 as u8)
    rt.buf_push(b, depth as u8)
    put16(b, 10 as u32)
    put32(b, wid)
    put32(b, parent)
    put16(b, 0 as u32)
    put16(b, 0 as u32)
    put16(b, w as u32)
    put16(b, h as u32)
    put16(b, 0 as u32)
    put16(b, 1 as u32)
    put32(b, visual)
    put32(b, 2050 as u32)
    put32(b, bg)
    put32(b, maske)
}

// CreateGC(55) ohne Werte.
fn req_create_gc(b: *mut rt.Buf, gc: u32, drawable: u32) {
    rt.buf_push(b, 55 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 4 as u32)
    put32(b, gc)
    put32(b, drawable)
    put32(b, 0 as u32)
}

// ChangeProperty(18), Modus Replace. `fmt` ist 8, 16 oder 32; `nbytes`
// die Laenge der Daten in Oktett, die Zahl der EINHEITEN rechnet diese
// Funktion selbst -- genau die Stelle, an der man sich sonst um den
// Faktor vier verzaehlt.
fn req_change_property(b: *mut rt.Buf, win: u32, prop: u32, typ: u32,
    fmt: u32, p: u64, nbytes: usize) {
    rt.buf_push(b, 18 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, (6 + (nbytes + pad4(nbytes)) / 4) as u32)
    put32(b, win)
    put32(b, prop)
    put32(b, typ)
    rt.buf_push(b, fmt as u8)
    rt.buf_push(b, 0 as u8)
    rt.buf_push(b, 0 as u8)
    rt.buf_push(b, 0 as u8)
    put32(b, (nbytes / ((fmt / 8) as usize)) as u32)
    rt.buf_push_bytes(b, p, nbytes)
    pad_to4(b, nbytes)
}

// MapWindow(8).
fn req_map_window(b: *mut rt.Buf, win: u32) {
    rt.buf_push(b, 8 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 2 as u32)
    put32(b, win)
}

// GetProperty(20), delete = nein.
fn req_get_property(b: *mut rt.Buf, win: u32, prop: u32, typ: u32,
    off: u32, len: u32) {
    rt.buf_push(b, 20 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 6 as u32)
    put32(b, win)
    put32(b, prop)
    put32(b, typ)
    put32(b, off)
    put32(b, len)
}

// GetKeyboardMapping(101): `count` Tastencodes ab `first`.
fn req_get_keyboard_mapping(b: *mut rt.Buf, first: u32, count: u32) {
    rt.buf_push(b, 101 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 2 as u32)
    rt.buf_push(b, first as u8)
    rt.buf_push(b, count as u8)
    rt.buf_push(b, 0 as u8)
    rt.buf_push(b, 0 as u8)
}

// GetModifierMapping(119): welche Tasten Shift, Lock, Control und
// Mod1..Mod5 sind.
fn req_get_modifier_mapping(b: *mut rt.Buf) {
    rt.buf_push(b, 119 as u8)
    rt.buf_push(b, 0 as u8)
    put16(b, 1 as u32)
}

// Der KOPF von PutImage(72), ZPixmap, links-pad 0. Die `bytes` Bildoktett
// folgen dahinter (der Aufrufer haengt sie an, damit ein 3,8-MB-Bild
// nicht zweimal kopiert wird). `bytes` ist bei 32 Bit je Punkt immer
// ein Vielfaches von vier.
fn req_put_image_head(b: *mut rt.Buf, win: u32, gc: u32, w: usize,
    h: usize, dx: usize, dy: usize, depth: u32, bytes: usize) {
    rt.buf_push(b, 72 as u8)
    rt.buf_push(b, 2 as u8)
    put16(b, (6 + bytes / 4) as u32)
    put32(b, win)
    put32(b, gc)
    put16(b, w as u32)
    put16(b, h as u32)
    put16(b, dx as u32)
    put16(b, dy as u32)
    rt.buf_push(b, 0 as u8)
    rt.buf_push(b, depth as u8)
    rt.buf_push(b, 0 as u8)
    rt.buf_push(b, 0 as u8)
}

// ------------------------------------------------- die Antwort des Aufbaus

struct Setup {
    id_base: u32,
    id_mask: u32,
    root: u32,
    s_px_w: usize,
    s_px_h: usize,
    s_mm_w: usize,
    s_mm_h: usize,
    visual: u32,
    depth: u32,
    kmin: u32,
    kmax: u32,
}

fn setup_new() -> Setup {
    return Setup { id_base: 0, id_mask: 0, root: 0, s_px_w: 0, s_px_h: 0,
        s_mm_w: 0, s_mm_h: 0, visual: 0, depth: 0, kmin: 0, kmax: 0 }
}

// Die Antwort auf den Verbindungsaufbau zerlegen: `p` zeigt auf ihr
// erstes Oktett, `n` Oktett stehen da. Zurueck kommt 0 oder der Grund,
// der auch in `Platte.fail` landet: 5 = abgelehnt (fast immer die
// Berechtigung), 6 = kein 24-Bit-Visual (U1), 7 = zu kurz.
//
// Gelesen wird nur der ERSTE Schirm -- `:0.1` gibt es auf keinem
// Rechner, fuer den dieses Programm gebaut wird.
fn setup_parse(p: u64, n: usize, s: *mut Setup) -> u32 {
    if n < 8 {
        return 7 as u32
    }
    if rt.ld8(p, 0) != 1 as u8 {
        return 5 as u32
    }
    if n < 40 {
        return 7 as u32
    }
    (*s).id_base = ld32le(p, 12)
    (*s).id_mask = ld32le(p, 16)
    (*s).kmin = rt.ld8(p, 34) as u32
    (*s).kmax = rt.ld8(p, 35) as u32
    let vendor_len: usize = ld16le(p, 24) as usize
    let nformats: usize = rt.ld8(p, 29) as usize
    let at: usize = 40 + vendor_len + pad4(vendor_len) + nformats * 8
    if at + 40 > n {
        return 7 as u32
    }
    (*s).root = ld32le(p, at)
    (*s).s_px_w = ld16le(p, at + 20) as usize
    (*s).s_px_h = ld16le(p, at + 22) as usize
    (*s).s_mm_w = ld16le(p, at + 24) as usize
    (*s).s_mm_h = ld16le(p, at + 26) as usize
    let ndepths: usize = rt.ld8(p, at + 39) as usize
    var dat: usize = at + 40
    var di: usize = 0
    (*s).visual = 0
    while di < ndepths && dat + 8 <= n {
        let dep: u32 = rt.ld8(p, dat) as u32
        let nvis: usize = ld16le(p, dat + 2) as usize
        if dep == 24 as u32 && nvis > 0 && dat + 12 <= n {
            (*s).visual = ld32le(p, dat + 8)
            (*s).depth = 24
            break
        }
        dat = dat + 8 + nvis * 24
        di = di + 1
    }
    if (*s).visual == 0 as u32 {
        return 6 as u32
    }
    return 0 as u32
}

// Die Bildpunktdichte aus Punkten und Millimetern: 1 Zoll = 25,4 mm,
// ganzzahlig und kaufmaennisch gerundet. 0 = nicht bestimmbar.
fn dpi_from_mm(px: usize, mm: usize) -> usize {
    if px == 0 || mm == 0 {
        return 0
    }
    return (px * 254 + mm * 5) / (mm * 10)
}

// `Xft.dpi:` aus dem Text der Ressourcendatenbank. 0 = nicht da.
fn xft_dpi_in(txt: u64, bytes: usize) -> usize {
    var lit: [u8; 8] = "Xft.dpi:"
    var d: usize = 0
    var i: usize = 0
    while i + 8 <= bytes {
        var gleich: bool = true
        var j: usize = 0
        while j < 8 {
            if rt.ld8(txt, i + j) != lit[j] {
                gleich = false
            }
            j = j + 1
        }
        if gleich {
            d = number_from(txt, i + 8, bytes)
            i = bytes
        }
        i = i + 1
    }
    return d
}

// Die Antwort auf GetProperty(RESOURCE_MANAGER) -> Xft.dpi. Nur Format
// 8 ist Text; alles andere ist "nicht da".
fn resman_dpi(p: u64, n: usize) -> usize {
    if n < 32 || rt.ld8(p, 0) != 1 as u8 {
        return 0
    }
    let extra: usize = (ld32le(p, 4) as usize) * 4
    if 32 + extra > n {
        return 0
    }
    if rt.ld8(p, 1) != 8 as u8 {
        return 0
    }
    var bytes: usize = ld32le(p, 16) as usize
    if bytes > extra {
        bytes = extra
    }
    return xft_dpi_in(p + 32 as u64, bytes)
}

// ======================================================================
// DIE TASTATUR, WIE DER SERVER SIE BELEGT
// ======================================================================
//
// In Certus stand hier nur `key_ascii`: eine US-Tabelle fuer die
// Tastencodes 10..61, fest eingebaut. Auf einer deutschen Tastatur
// lieferte die Taste rechts neben der 0 darum '-' statt 'ss', 'z' und
// 'y' waren vertauscht, und '@' (AltGr+Q) gab es gar nicht. Die
// Belegung WEISS aber der Server, und er sagt sie jedem, der fragt:
//
//   GetKeyboardMapping(kmin, kmax-kmin+1) -> je Tastencode `per`
//       Keysyms: [Gruppe1 Ebene1, G1 E2, G2 E1, G2 E2, E3, E4, ...]
//   GetModifierMapping -> welche Tasten Mod1..Mod5 sind; daraus folgt,
//       welches Zustandsbit AltGr (ISO_Level3_Shift/Mode_switch) und
//       welches NumLock ist -- das ist KEINE feste Zahl, der Server
//       legt es fest (bei Xvfb mit xkb: Mod5 = 128, Mod2 = 16).
//
// Die Tastennummern K_* in window.fi bleiben, was sie sind (die
// evdev-Nummern, auf die Certus seine Schleifen gebaut hat) -- aber sie
// werden jetzt aus dem KEYSYM bestimmt: Escape ist Escape, egal auf
// welchem Tastencode es liegt.

struct Keymap {
    syms: rt.Buf,   // je Tastencode `per` Keysyms, kleinendisch u32
    per: usize,
    kmin: u32,
    n: usize,       // wie viele Tastencodes
    lvl3: u32,      // das Zustandsbit fuer AltGr, 0 = keins
    numlock: u32,   // das Zustandsbit fuer NumLock, 0 = keins
}

fn keymap_new() -> Keymap {
    return Keymap { syms: rt.buf_new(), per: 0, kmin: 0, n: 0, lvl3: 0,
        numlock: 0 }
}

fn keymap_ok(km: *mut Keymap) -> bool {
    return (*km).n > 0 && (*km).per > 0
}

// Die Antwort auf GetKeyboardMapping uebernehmen. `kmin` ist der erste
// erfragte Tastencode (die Antwort nennt ihn nicht noch einmal).
fn keymap_from_reply(km: *mut Keymap, p: u64, n: usize, kmin: u32) -> bool {
    if n < 32 || rt.ld8(p, 0) != 1 as u8 {
        return false
    }
    let per: usize = rt.ld8(p, 1) as usize
    let worte: usize = ld32le(p, 4) as usize
    if per == 0 || 32 + worte * 4 > n {
        return false
    }
    rt.buf_clear(&(*km).syms)
    rt.buf_push_bytes(&(*km).syms, p + 32 as u64, worte * 4)
    (*km).per = per
    (*km).kmin = kmin
    (*km).n = worte / per
    return true
}

// Keysym in Spalte `col` fuer Tastencode `kc`; 0 = NoSymbol.
fn keymap_col(km: *mut Keymap, kc: u32, col: usize) -> u32 {
    if !keymap_ok(km) || kc < (*km).kmin || col >= (*km).per {
        return 0 as u32
    }
    let i: usize = (kc - (*km).kmin) as usize
    if i >= (*km).n {
        return 0 as u32
    }
    return ld32le(rt.buf_ptr(&(*km).syms), (i * (*km).per + col) * 4)
}

// Die Antwort auf GetModifierMapping: fuer jedes der acht Bits die
// Tastencodes; ein Bit, auf dem eine Taste mit ISO_Level3_Shift
// (0xFE03) oder Mode_switch (0xFF7E) liegt, ist AltGr, eines mit
// Num_Lock (0xFF7F) ist NumLock.
fn keymap_mods_from_reply(km: *mut Keymap, p: u64, n: usize) -> bool {
    if n < 32 || rt.ld8(p, 0) != 1 as u8 {
        return false
    }
    let je: usize = rt.ld8(p, 1) as usize
    if 32 + 8 * je > n {
        return false
    }
    (*km).lvl3 = 0
    (*km).numlock = 0
    var m: usize = 0
    while m < 8 {
        var k: usize = 0
        while k < je {
            let kc: u32 = rt.ld8(p, 32 + m * je + k) as u32
            if kc != 0 as u32 {
                var col: usize = 0
                while col < (*km).per {
                    let ks: u32 = keymap_col(km, kc, col)
                    if ks == 65027 as u32 || ks == 65406 as u32 {
                        (*km).lvl3 = (1 as u32) << (m as u32)
                    }
                    if ks == 65407 as u32 {
                        (*km).numlock = (1 as u32) << (m as u32)
                    }
                    col = col + 1
                }
            }
            k = k + 1
        }
        m = m + 1
    }
    return true
}

// Kleinbuchstabe -> Grossbuchstabe fuer die Keysyms, die ein Zeichen
// aus Latin-1 SIND (Keysym == Codepunkt). Gebraucht nur fuer die Regel
// des Protokolls: steht in Spalte 2 NoSymbol, gilt fuer Spalte 2 der
// grosse Buchstabe von Spalte 1 (bzw. Spalte 1 selbst).
fn ks_upper(ks: u32) -> u32 {
    if ks >= 97 as u32 && ks <= 122 as u32 {
        return ks - 32 as u32
    }
    if ks >= 224 as u32 && ks <= 254 as u32 && ks != 247 as u32 {
        return ks - 32 as u32
    }
    return ks
}

fn ks_is_lower(ks: u32) -> bool {
    return ks_upper(ks) != ks
}

fn ks_is_keypad(ks: u32) -> bool {
    return ks >= 65408 as u32 && ks <= 65469 as u32
}

// DAS KEYSYM ZU TASTENCODE UND ZUSTAND. Die Regeln aus Kapitel 5 des
// Protokolls ("Keyboards"), eingeschraenkt auf das, was eine
// Oberflaeche braucht:
//   * AltGr (das Bit aus GetModifierMapping) nimmt die Spalten 4/5
//     (Ebene 3/4) -- aber nur, wenn dort etwas steht.
//   * NumLock auf einer Zifferntaste nimmt Spalte 1, Umschalt kehrt es
//     wieder um.
//   * Umschalt nimmt Spalte 1; CapsLock (Lock) tut es nur bei einem
//     Buchstaben. Ist Spalte 1 NoSymbol, gilt der grosse Buchstabe von
//     Spalte 0 bzw. Spalte 0 selbst.
fn keymap_sym(km: *mut Keymap, kc: u32, state: u32) -> u32 {
    let shift: bool = (state & 1 as u32) != 0 as u32
    let lock: bool = (state & 2 as u32) != 0 as u32
    var c0: usize = 0
    if (*km).lvl3 != 0 as u32 && (state & (*km).lvl3) != 0 as u32 {
        if keymap_col(km, kc, 4) != 0 as u32 {
            c0 = 4
        }
    }
    let s0: u32 = keymap_col(km, kc, c0)
    var s1: u32 = keymap_col(km, kc, c0 + 1)
    if s1 == 0 as u32 {
        s1 = ks_upper(s0)
    }
    if (*km).numlock != 0 as u32 && (state & (*km).numlock) != 0 as u32
        && ks_is_keypad(s1) {
        if shift {
            return s0
        }
        return s1
    }
    var hoch: bool = shift
    if lock && ks_is_lower(s0) {
        hoch = !hoch
    }
    if hoch {
        return s1
    }
    return s0
}

// Keysym -> Tastennummer mit Bedeutung (window.K_*), 0 = keine.
fn ks_key(ks: u32) -> u32 {
    if ks == 65307 as u32 { return window.K_ESCAPE }        // Escape
    if ks == 65288 as u32 { return window.K_BACK }          // BackSpace
    if ks == 65289 as u32 || ks == 65056 as u32 {           // Tab, ISO_Left_Tab
        return window.K_TAB
    }
    if ks == 65293 as u32 || ks == 65421 as u32 {           // Return, KP_Enter
        return window.K_RETURN
    }
    if ks == 65360 as u32 || ks == 65429 as u32 { return window.K_HOME }
    if ks == 65361 as u32 || ks == 65430 as u32 { return window.K_LEFT }
    if ks == 65362 as u32 || ks == 65431 as u32 { return window.K_UP }
    if ks == 65363 as u32 || ks == 65432 as u32 { return window.K_RIGHT }
    if ks == 65364 as u32 || ks == 65433 as u32 { return window.K_DOWN }
    if ks == 65365 as u32 || ks == 65434 as u32 { return window.K_PAGEUP }
    if ks == 65366 as u32 || ks == 65435 as u32 { return window.K_PAGEDOWN }
    if ks == 65367 as u32 || ks == 65436 as u32 { return window.K_END }
    if ks == 65535 as u32 || ks == 65439 as u32 { return window.K_DELETE }
    return 0 as u32
}

// Keysym -> Unicode-Codepunkt, 0 = kein Zeichen.
//   * 0x20..0x7E und 0xA0..0xFF: Keysym == Latin-1 == Unicode.
//   * 0x01000000 + cp: der Unicode-Bereich der Keysyms (xkb legt z. B.
//     das grosse Eszett so ab: U1E9E).
//   * die Zifferntastatur: KP_Space, KP_Equal, KP_Multiply .. KP_9.
//   * EuroSign 0x20AC ist zugleich U+20AC.
// NICHT hier: tote Tasten (0xFE50..) und die alten Latin-2..-9- und
// kyrillischen Keysym-Tafeln -- siehe "WAS NICHT GEHT" im Kopf.
fn ks_char(ks: u32) -> u32 {
    if ks >= 32 as u32 && ks <= 126 as u32 {
        return ks
    }
    if ks >= 160 as u32 && ks <= 255 as u32 {
        return ks
    }
    if ks >= 16777216 as u32 && ks <= 17891327 as u32 {
        return ks - 16777216 as u32
    }
    if ks == 8364 as u32 {
        return ks
    }
    if ks == 65408 as u32 { return 32 as u32 }       // KP_Space
    if ks == 65469 as u32 { return 61 as u32 }       // KP_Equal
    if ks >= 65450 as u32 && ks <= 65465 as u32 {    // KP_Multiply .. KP_9
        var t: [u8; 16] = "*+,-./0123456789"
        return t[(ks - 65450 as u32) as usize] as u32
    }
    return 0 as u32
}

// ======================================================================
// EIN EREIGNIS, 32 OKTETT -> (Art, a, x, y, Zustand)
// ======================================================================
//
// Die Uebersetzung, die `r_next` frueher selbst tat, als eigene
// Funktion ohne Verbindung. `a_delete` ist das Atom WM_DELETE_WINDOW,
// `voll` der Schalter aus `window.full_input` (Loslassen, Hinein,
// Hinaus). Zurueck: true = das ist ein Ereignis fuer das Programm.
//
// Das oberste Bit des Codes sagt nur "kam ueber SendEvent" -- ein
// Fenstermanager schickt WM_DELETE_WINDOW genau so (Code 161 = 33|128
// im Mitschnitt testdata/x11/events.bin). Es wird darum abgeschnitten.
fn decode_event(p: u64, a_delete: u32, km: *mut Keymap, voll: bool,
    k: *mut u32, a: *mut u32, ox: *mut u32, oy: *mut u32,
    os: *mut u32) -> bool {
    let code: u8 = rt.ld8(p, 0) & 127 as u8
    *a = 0 as u32
    *ox = 0 as u32
    *oy = 0 as u32
    *os = 0 as u32
    if code == 12 as u8 { // Expose
        *k = window.EV_EXPOSE
        return true
    }
    if code == 2 as u8 || (code == 3 as u8 && voll) { // KeyPress/Release
        let kc: u32 = rt.ld8(p, 1) as u32
        let st: u32 = ld16le(p, 28)
        *os = st
        var ks: u32 = 0 as u32
        if keymap_ok(km) {
            ks = keymap_sym(km, kc, st)
        }
        *ox = ks
        if code == 3 as u8 {
            var t: u32 = ks_key(ks)
            if t == 0 as u32 {
                t = kc
            }
            *a = t
            *k = window.EV_KEY_UP
            return true
        }
        // L2: as under Windows -- keys with meaning as EV_KEY,
        // printable characters as EV_CHAR.
        if keymap_ok(km) {
            let t: u32 = ks_key(ks)
            if t != 0 as u32 {
                *a = t
                *k = window.EV_KEY
                return true
            }
            let ch: u32 = ks_char(ks)
            if ch != 0 as u32 {
                *a = ch
                *k = window.EV_CHAR
                return true
            }
        } else {
            // Keine Belegung vom Server (die Anfrage scheiterte): der
            // alte Weg ueber die feste US-Tabelle, wie in Certus.
            if is_key(kc) {
                *a = kc
                *k = window.EV_KEY
                return true
            }
            let ch: u32 = key_ascii(kc, (st & 1 as u32) != 0 as u32)
            if ch != 0 as u32 {
                *a = ch
                *k = window.EV_CHAR
                return true
            }
        }
        // A key that has neither meaning nor character: as EV_KEY
        // with its number, so that nothing disappears.
        *a = kc
        *k = window.EV_KEY
        return true
    }
    if code == 4 as u8 || (code == 5 as u8 && voll) { // Button Press/Release
        *a = rt.ld8(p, 1) as u32
        *ox = ld16le(p, 24)
        *oy = ld16le(p, 26)
        *os = ld16le(p, 28)
        if code == 4 as u8 {
            *k = window.EV_BUTTON
        } else {
            *k = window.EV_RELEASE
        }
        return true
    }
    if code == 6 as u8 { // MotionNotify (L1)
        *ox = ld16le(p, 24)
        *oy = ld16le(p, 26)
        *os = ld16le(p, 28)
        *k = window.EV_MOTION
        return true
    }
    if (code == 7 as u8 || code == 8 as u8) && voll { // Enter/Leave
        *ox = ld16le(p, 24)
        *oy = ld16le(p, 26)
        *os = ld16le(p, 28)
        if code == 7 as u8 {
            *k = window.EV_ENTER
        } else {
            *k = window.EV_LEAVE
        }
        return true
    }
    if code == 22 as u8 { // ConfigureNotify
        *ox = ld16le(p, 20)
        *oy = ld16le(p, 22)
        *k = window.EV_CONFIGURE
        return true
    }
    if code == 33 as u8 { // ClientMessage (L3)
        let atom: u32 = ld32le(p, 12)
        if atom == a_delete && a_delete != 0 as u32 {
            *k = window.EV_CLOSED
            return true
        }
    }
    return false
}

// ======================================================================
// ~/.Xauthority: WELCHER EINTRAG
// ======================================================================
//
// Die Datei ist eine Folge von Eintraegen: Familie (2 Oktett, grossendisch),
// dann vier gezaehlte Zeichenketten (Laenge 2 Oktett grossendisch):
// Adresse, Anzeigenummer als TEXT, Name der Berechtigung, Daten.
//
// In Certus wurde der ERSTE Eintrag mit einem 18 Oktett langen Namen
// genommen, egal fuer welche Anzeige. Wer mehr als eine Anzeige hat
// (ssh -X, ein zweites Xvfb, ein Abnahmelauf), bekam damit das Keks
// einer fremden Anzeige und eine Ablehnung (fail 5). Jetzt gilt: der
// Eintrag MIT DIESER ANZEIGENUMMER zuerst; nur wenn es keinen gibt, der
// erste MIT-MAGIC-COOKIE-1 -- das alte Verhalten als Rueckfall.
fn auth_pick(p: u64, n: usize, anzeige: usize, name: *mut rt.Buf,
    data: *mut rt.Buf) -> bool {
    var cookie: [u8; 18] = "MIT-MAGIC-COOKIE-1"
    var at: usize = 0
    var erster_n: usize = 0
    var erster_d: usize = 0
    var erster_dl: usize = 0
    var hat_erster: bool = false
    while at + 2 <= n {
        at = at + 2
        var i: usize = 0
        var lens: [usize; 4] = [0; 4]
        var offs: [usize; 4] = [0; 4]
        var bad: bool = false
        while i < 4 {
            if at + 2 > n {
                bad = true
                break
            }
            let l: usize = ((rt.ld8(p, at) as usize) << 8)
            | (rt.ld8(p, at + 1) as usize)
            at = at + 2
            offs[i] = at
            lens[i] = l
            at = at + l
            if at > n {
                bad = true
                break
            }
            i = i + 1
        }
        if bad {
            break
        }
        var ist_keks: bool = lens[2] == 18
        var j: usize = 0
        while ist_keks && j < 18 {
            if rt.ld8(p, offs[2] + j) != cookie[j] {
                ist_keks = false
            }
            j = j + 1
        }
        if ist_keks {
            let nr: usize = number_from(p, offs[1], offs[1] + lens[1])
            let hat_nr: bool = lens[1] > 0
            if hat_nr && nr == anzeige {
                rt.buf_clear(name)
                rt.buf_push_bytes(name, p + offs[2] as u64, lens[2])
                rt.buf_clear(data)
                rt.buf_push_bytes(data, p + offs[3] as u64, lens[3])
                return true
            }
            if !hat_erster {
                hat_erster = true
                erster_n = offs[2]
                erster_d = offs[3]
                erster_dl = lens[3]
            }
        }
    }
    if hat_erster {
        rt.buf_clear(name)
        rt.buf_push_bytes(name, p + erster_n as u64, 18)
        rt.buf_clear(data)
        rt.buf_push_bytes(data, p + erster_d as u64, erster_dl)
        return true
    }
    return false
}

// ======================================================== DIE UMGEBUNG
//
// The environment is not reachable from `rt` -- that stood literally in
// the header of the old file since round B5, and that is why a fixed
// path `/root/.Xauthority` stood there. /proc/self/environ needs only
// open, read and close, and that is exactly what lib/i18n/lang.fi does since round LOKAL.
const ENVCAP: usize = 32768
static mut G_ENV: [u8; 32768] = [0 as u8; 32768]
static mut G_ENV_N: usize = 0
static mut G_ENV_DA: u32 = 0

fn env_laden() {
    if G_ENV_DA != 0 as u32 {
        return
    }
    G_ENV_DA = 1
    G_ENV_N = 0
    var pfad: [u8; 19] = "/proc/self/environ\0"
    var b: rt.Buf = rt.buf_new()
    if rt.read_file((&pfad[0]) as u64, &b) {
        var n: usize = rt.buf_len(&b)
        if n > ENVCAP {
            n = ENVCAP
        }
        rt.mem_copy((&G_ENV[0]) as u64, rt.buf_ptr(&b), n)
        G_ENV_N = n
    }
    rt.buf_free(&b)
}

// A value from the environment into `out`. false = it is not there.
fn env_hole(name: u64, nn: usize, out: *mut rt.Buf) -> bool {
    env_laden()
    rt.buf_clear(out)
    let p: u64 = (&G_ENV[0]) as u64
    let n: usize = G_ENV_N
    var at: usize = 0
    while at < n {
        // find the end of this entry
        var e: usize = at
        while e < n && rt.ld8(p, e) != 0 as u8 {
            e = e + 1
        }
        var passt: bool = at + nn + 1 <= e
        if passt {
            var i: usize = 0
            while i < nn {
                if rt.ld8(p, at + i) != rt.ld8(name, i) {
                    passt = false
                }
                i = i + 1
            }
            if passt && rt.ld8(p, at + nn) != 61 as u8 {
                passt = false
            }
        }
        if passt {
            var q: usize = at + nn + 1
            while q < e {
                rt.buf_push(out, rt.ld8(p, q))
                q = q + 1
            }
            return true
        }
        at = e + 1
    }
    return false
}

// ~/.Xauthority, the MIT-MAGIC-COOKIE-1 record. The file is a list of
// big endian counted strings; the first cookie with the right name is
// taken.
fn read_auth(name: *mut rt.Buf, data: *mut rt.Buf, anzeige: usize) -> bool {
    var b: rt.Buf = rt.buf_new()
    var got: bool = false
    // First XAUTHORITY, then $HOME/.Xauthority, then /root -- the old
    // version could only do the last one.
    var e_xa: [u8; 10] = "XAUTHORITY"
    var pfad: rt.Buf = rt.buf_new()
    if env_hole((&e_xa[0]) as u64, 10, &pfad) {
        rt.buf_push(&pfad, 0 as u8)
        if rt.read_file(rt.buf_ptr(&pfad), &b) {
            got = true
        }
    }
    if !got {
        var e_home: [u8; 4] = "HOME"
        rt.buf_clear(&pfad)
        if env_hole((&e_home[0]) as u64, 4, &pfad) {
            var suffix: [u8; 12] = "/.Xauthority"
            rt.buf_push_bytes(&pfad, (&suffix[0]) as u64, 12)
            rt.buf_push(&pfad, 0 as u8)
            if rt.read_file(rt.buf_ptr(&pfad), &b) {
                got = true
            }
        }
    }
    rt.buf_free(&pfad)
    if !got {
        var p1: [u8; 18] = "/root/.Xauthority\0"
        if rt.read_file((&p1[0]) as u64, &b) {
            got = true
        }
    }
    if !got {
        rt.buf_free(&b)
        return false
    }
    // F3: der Eintrag dieser Anzeige, sonst der erste (auth_pick).
    let found: bool = auth_pick(b.ptr, b.len, anzeige, name, data)
    rt.buf_free(&b)
    return found
}

fn conn_fail(bad: *mut bool) -> net.Conn {
    *bad = true
    return net.Conn { fd: -1, err: 0, peer: 0 as u32, peer_port: 0 as u16 }
}

fn new_id(x: *mut Platte) -> u32 {
    let id: u32 = (*x).id_base | ((*x).next_id & (*x).id_mask)
    (*x).next_id = (*x).next_id + 1 as u32
    return id
}

// ======================================================== AUFMACHEN

fn r_open(x: *mut Platte, anzeige: usize) -> bool {
    var path: [u8; 20] = "/tmp/.X11-unix/X0   "
    var plen: usize = 17
    var display: usize = anzeige
    // Without an argument: DISPLAY from the environment, otherwise 0.
    if display == 0 {
        var e_d: [u8; 7] = "DISPLAY"
        var dv: rt.Buf = rt.buf_new()
        if env_hole((&e_d[0]) as u64, 7, &dv) {
            display = number_from(rt.buf_ptr(&dv), 0, rt.buf_len(&dv))
        }
        rt.buf_free(&dv)
    }
    // RUNDE REFTEST2 (C-012). VORHER stand hier eine Fassung, die NUR
    // ein- und zweistellige Anzeigen kannte:
    //
    //     path[16] = (48 + (display / 10) % 10) as u8
    //     path[17] = (48 + (display % 10)) as u8
    //
    // Bei `:100` rechnet das (100/10)%10 = 0 und 100%10 = 0 und baut
    // damit den Pfad `/tmp/.X11-unix/X00` -- eine Anzeige, die es
    // nicht gibt. Der Renderer endete mit rc=95, OHNE Meldung. Der
    // Reftest-Laeufer vergibt die Anzeigen :98, :99, :100, ... an
    // seine Straenge; ab dem dritten Strang rannte deshalb JEDER
    // Lauf ins Leere: 1600 von 1650 css-grid-Dateien kamen als
    // RENDER_FEHLER zurueck, was wie ein Glass-Fehler aussah, aber
    // keiner war. Gemessen: :98 und :99 gut, :100..:103 rc=95.
    //
    // Jetzt werden die Ziffern allgemein gelegt, fuer beliebig viele
    // Stellen. Der Puffer fasst 20 Byte, "/tmp/.X11-unix/X" sind 16 --
    // es bleiben 4 Ziffern (bis :9999), mehr als X11 je braucht.
    if display < 10 {
        path[16] = (48 + display) as u8
    } else {
        var ziffern: [u8; 4] = "0000"
        var n: usize = display
        var anz: usize = 0
        while n > 0 && anz < 4 {
            ziffern[anz] = (48 + (n % 10)) as u8
            n = n / 10
            anz = anz + 1
        }
        var i: usize = 0
        while i < anz {
            path[16 + i] = ziffern[anz - 1 - i]
            i = i + 1
        }
        plen = 16 + anz
    }
    var bad: bool = false
    let c: net.Conn = net.connect_unix((&path[0]) as u64, plen)
    catch | e | conn_fail(&bad)
    if bad {
        (*x).fail = 1
        return false
    }
    (*x).c = c
    var name: rt.Buf = rt.buf_new()
    var data: rt.Buf = rt.buf_new()
    let have_auth: bool = read_auth(&name, &data, display)
    var req: rt.Buf = rt.buf_new()
    if have_auth {
        req_setup(&req, name.ptr, name.len, data.ptr, data.len)
    } else {
        req_setup(&req, 0 as u64, 0, 0 as u64, 0)
    }
    let sent: bool = send(x, req.ptr, req.len)
    rt.buf_free(&req)
    rt.buf_free(&name)
    rt.buf_free(&data)
    if !sent {
        (*x).fail = 2
        return false
    }
    (*x).open = true
    if !want(x, 8) {
        (*x).fail = 3
        return false
    }
    let base: u64 = (*x).rb.ptr + (*x).rpos as u64
    let extra: usize = (ld16le(base, 6) as usize) * 4
    if !want(x, 8 + extra) {
        (*x).fail = 4
        return false
    }
    var su: Setup = setup_new()
    let grund: u32 = setup_parse((*x).rb.ptr + (*x).rpos as u64, 8 + extra,
        &su)
    if grund != 0 as u32 {
        (*x).fail = grund // 5 abgelehnt, 6 kein 24-Bit-Visual (U1), 7 kurz
        (*x).open = false
        return false
    }
    (*x).id_base = su.id_base
    (*x).id_mask = su.id_mask
    (*x).root = su.root
    // L4: the size of the screen, in pixels and in millimetres.
    let s_px: usize = su.s_px_w
    let s_mm: usize = su.s_mm_w
    // RUNDE CERTUS-WIN4: die Startgroesse haengt am Schirm.
    (*x).schirm_w = su.s_px_w
    (*x).schirm_h = su.s_px_h
    (*x).visual = su.visual
    (*x).depth = su.depth
    (*x).next_id = 0
    (*x).rpos = (*x).rpos + 8 + extra
    // L3: the two atoms. Only here, because no resource base was fixed
    // before -- and still BEFORE the window, because afterwards events
    // could get between the replies.
    fetch_atoms(x)
    // F1: die Belegung der Tastatur, ebenfalls VOR dem Fenster.
    fetch_keymap(x, su.kmin, su.kmax)
    // L4: die Bildpunktdichte.
    (*x).dpi = dpi_bestimmen(x, s_px, s_mm)
    // L5: light or dark.
    read_theme(x)
    return true
}

// L3 -- InternAtom(16) twice, then the two replies.
fn fetch_atoms(x: *mut Platte) {
    var n1: [u8; 12] = "WM_PROTOCOLS"
    var n2: [u8; 16] = "WM_DELETE_WINDOW"
    (*x).a_protocols = atom_von(x, (&n1[0]) as u64, 12)
    (*x).a_delete = atom_von(x, (&n2[0]) as u64, 16)
}

fn atom_von(x: *mut Platte, p: u64, n: usize) -> u32 {
    var r: rt.Buf = rt.buf_new()
    req_intern_atom(&r, p, n)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    if !ok {
        return 0 as u32
    }
    if !want(x, 32) {
        return 0 as u32
    }
    let b: u64 = (*x).rb.ptr + (*x).rpos as u64
    let code: u8 = rt.ld8(b, 0)
    var extra: usize = 0
    if code == 1 as u8 {
        extra = (ld32le(b, 4) as usize) * 4
        if !want(x, 32 + extra) {
            return 0 as u32
        }
    }
    var atom: u32 = 0
    if code == 1 as u8 {
        atom = ld32le((*x).rb.ptr + (*x).rpos as u64, 8)
    }
    (*x).rpos = (*x).rpos + 32 + extra
    return atom
}

// Eine Anfrage schicken und ihre GANZE Antwort abwarten. Nur fuer die
// Zeit vor dem Fenster: dann kommen noch keine Ereignisse dazwischen.
// Zurueck: die Stelle der Antwort im Empfangspuffer und ihre Laenge
// (0 = Fehler oder keine Antwort); `rpos` steht danach HINTER ihr.
fn frage(x: *mut Platte, r: *mut rt.Buf, at: *mut usize) -> usize {
    if !send(x, (*r).ptr, (*r).len) {
        return 0
    }
    if !want(x, 32) {
        return 0
    }
    let b: u64 = (*x).rb.ptr + (*x).rpos as u64
    var extra: usize = 0
    if rt.ld8(b, 0) == 1 as u8 {
        extra = (ld32le(b, 4) as usize) * 4
        if !want(x, 32 + extra) {
            return 0
        }
    }
    *at = (*x).rpos
    (*x).rpos = (*x).rpos + 32 + extra
    if rt.ld8((*x).rb.ptr + (*at) as u64, 0) != 1 as u8 {
        return 0
    }
    return 32 + extra
}

// F1 -- GetKeyboardMapping und GetModifierMapping. Scheitert eine der
// beiden, bleibt die Belegung leer, und `decode_event` nimmt den alten
// Weg (key_ascii) -- ein Fenster ohne Tastatur waere schlimmer als eines
// mit US-Tastatur.
fn fetch_keymap(x: *mut Platte, kmin: u32, kmax: u32) {
    if kmax < kmin || kmin == 0 as u32 {
        return
    }
    var r: rt.Buf = rt.buf_new()
    req_get_keyboard_mapping(&r, kmin, kmax - kmin + 1 as u32)
    var at: usize = 0
    let n: usize = frage(x, &r, &at)
    if n > 0 {
        let ok: bool = keymap_from_reply(&(*x).km, (*x).rb.ptr + at as u64,
            n, kmin)
    }
    rt.buf_clear(&r)
    req_get_modifier_mapping(&r)
    let m: usize = frage(x, &r, &at)
    if m > 0 && keymap_ok(&(*x).km) {
        let ok2: bool = keymap_mods_from_reply(&(*x).km,
            (*x).rb.ptr + at as u64, m)
    }
    rt.buf_free(&r)
}

// L4 -- die Bildpunktdichte.
//
// Order: CERTUS_DPI (manual switch, also for the acceptance run), then
// `Xft.dpi` from RESOURCE_MANAGER -- that is what GNOME, KDE and XFCE
// really set and what every toolkit reads --, then the millimetres of
// the screen, otherwise 96.
fn dpi_bestimmen(x: *mut Platte, s_px: usize, s_mm: usize) -> usize {
    var e: [u8; 10] = "CERTUS_DPI"
    var b: rt.Buf = rt.buf_new()
    var d: usize = 0
    if env_hole((&e[0]) as u64, 10, &b) {
        d = number_from(rt.buf_ptr(&b), 0, rt.buf_len(&b))
    }
    rt.buf_free(&b)
    if d >= 48 && d <= 480 {
        return d
    }
    d = xft_dpi(x)
    if d >= 48 && d <= 480 {
        return d
    }
    // 1 inch = 25.4 mm; computed as integers and rounded.
    d = dpi_from_mm(s_px, s_mm)
    if d >= 48 && d <= 480 {
        return d
    }
    return 96
}

fn number_from(p: u64, von: usize, bis: usize) -> usize {
    var v: usize = 0
    var i: usize = von
    var sah: bool = false
    while i < bis {
        let ch: u8 = rt.ld8(p, i)
        if ch >= 48 as u8 && ch <= 57 as u8 {
            v = v * 10 + ((ch - 48 as u8) as usize)
            sah = true
        } else if sah {
            return v
        }
        i = i + 1
    }
    if !sah {
        return 0
    }
    return v
}

// RESOURCE_MANAGER is the predefined atom 23 -- it needs no InternAtom.
// Its content is the X resource database as text.
fn xft_dpi(x: *mut Platte) -> usize {
    var r: rt.Buf = rt.buf_new()
    // RESOURCE_MANAGER (23), AnyPropertyType, bis 64 KB Text.
    req_get_property(&r, (*x).root, 23 as u32, 0 as u32, 0 as u32,
        16384 as u32)
    var at: usize = 0
    let n: usize = frage(x, &r, &at)
    rt.buf_free(&r)
    if n == 0 {
        return 0
    }
    return resman_dpi((*x).rb.ptr + at as u64, n)
}

// L5 -- light or dark, without a registry and without D-Bus.
fn read_theme(x: *mut Platte) {
    (*x).dark_bekannt = false
    (*x).dark = false
    var b: rt.Buf = rt.buf_new()
    // 1. CERTUS_THEME=dark|light (the manual switch the acceptance run
    //    uses too), then GTK_THEME=Adwaita:dark.
    var e1: [u8; 12] = "CERTUS_THEME"
    var e2: [u8; 9] = "GTK_THEME"
    if env_hole((&e1[0]) as u64, 12, &b) && rt.buf_len(&b) > 0 {
        (*x).dark = hat_dark(rt.buf_ptr(&b), rt.buf_len(&b))
        (*x).dark_bekannt = true
        rt.buf_free(&b)
        return
    }
    rt.buf_clear(&b)
    if env_hole((&e2[0]) as u64, 9, &b) {
        if hat_dark(rt.buf_ptr(&b), rt.buf_len(&b)) {
            (*x).dark = true
            (*x).dark_bekannt = true
            rt.buf_free(&b)
            return
        }
    }
    // 2. ~/.config/gtk-4.0/settings.ini, then gtk-3.0.
    var e3: [u8; 4] = "HOME"
    rt.buf_clear(&b)
    var home: rt.Buf = rt.buf_new()
    if !env_hole((&e3[0]) as u64, 4, &home) {
        var hr: [u8; 5] = "/root"
        rt.buf_push_bytes(&home, (&hr[0]) as u64, 5)
    }
    var gefunden: bool = false
    var s4: [u8; 30] = "/.config/gtk-4.0/settings.ini\0"
    var s3: [u8; 30] = "/.config/gtk-3.0/settings.ini\0"
    gefunden = read_ini(&home, (&s4[0]) as u64, 30, x)
    if !gefunden {
        gefunden = read_ini(&home, (&s3[0]) as u64, 30, x)
    }
    rt.buf_free(&home)
    rt.buf_free(&b)
}

fn read_ini(home: *mut rt.Buf, suffix: u64, sn: usize,
    x: *mut Platte) -> bool {
    var pfad: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&pfad, rt.buf_ptr(home), rt.buf_len(home))
    rt.buf_push_bytes(&pfad, suffix, sn)
    var inhalt: rt.Buf = rt.buf_new()
    let da: bool = rt.read_file(rt.buf_ptr(&pfad), &inhalt)
    rt.buf_free(&pfad)
    if !da {
        rt.buf_free(&inhalt)
        return false
    }
    let p: u64 = rt.buf_ptr(&inhalt)
    let n: usize = rt.buf_len(&inhalt)
    var lit: [u8; 34] = "gtk-application-prefer-dark-theme="
    var i: usize = 0
    var antwort: bool = false
    var sah: bool = false
    while i + 34 <= n {
        var gleich: bool = true
        var j: usize = 0
        while j < 34 {
            if rt.ld8(p, i + j) != lit[j] {
                gleich = false
            }
            j = j + 1
        }
        if gleich {
            let v: u8 = rt.ld8(p, i + 34)
            if v == 49 as u8 || v == 116 as u8 || v == 84 as u8 {
                antwort = true
            }
            sah = true
            i = n
        }
        i = i + 1
    }
    if !sah {
        // No explicit key: then the theme name decides, because
        // "Adwaita-dark" is just as common.
        if hat_dark(p, n) {
            antwort = true
            sah = true
        }
    }
    rt.buf_free(&inhalt)
    if sah {
        (*x).dark = antwort
        (*x).dark_bekannt = true
    }
    return sah
}

// Does "dark" or "Dark" stand anywhere?
fn hat_dark(p: u64, n: usize) -> bool {
    var lit: [u8; 4] = "dark"
    var i: usize = 0
    while i + 4 <= n {
        var gleich: bool = true
        var j: usize = 0
        while j < 4 {
            var c: u8 = rt.ld8(p, i + j)
            if c >= 65 as u8 && c <= 90 as u8 {
                c = c + 32 as u8
            }
            if c != lit[j] {
                gleich = false
            }
            j = j + 1
        }
        if gleich {
            return true
        }
        i = i + 1
    }
    return false
}

fn r_dark(x: *mut Platte) -> bool {
    return (*x).dark
}

fn r_dark_known(x: *mut Platte) -> bool {
    return (*x).dark_bekannt
}

// ======================================================= THE WINDOW

fn r_make(x: *mut Platte, w: usize, h: usize) -> bool {
    (*x).win = new_id(x)
    (*x).gc = new_id(x)
    (*x).w = w
    (*x).h = h
    var r: rt.Buf = rt.buf_new()
    // Exposure(32768) | KeyPress(1) | ButtonPress(4) |
    // PointerMotion(64, L1) | StructureNotify(131072); F2 dazu
    // KeyRelease(2) | ButtonRelease(8) | EnterWindow(16) |
    // LeaveWindow(32).
    var maske: u32 = 32768 as u32 | 1 as u32 | 4 as u32 | 64 as u32
    | 131072 as u32
    if (*x).voll {
        maske = maske | 2 as u32 | 8 as u32 | 16 as u32 | 32 as u32
    }
    req_create_window(&r, (*x).win, (*x).root, (*x).depth, (*x).visual,
        w, h, 16777215 as u32, maske)
    req_create_gc(&r, (*x).gc, (*x).win)
    var ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    if !ok {
        return false
    }
    // L3: WM_PROTOCOLS = { WM_DELETE_WINDOW }. Without this line the
    // window manager kills the process instead of asking it.
    if (*x).a_protocols != 0 as u32 && (*x).a_delete != 0 as u32 {
        var q: rt.Buf = rt.buf_new()
        var del: [u32; 1] = [(*x).a_delete; 1]
        // ChangeProperty WM_PROTOCOLS, Typ ATOM (4), Format 32, ein Atom.
        req_change_property(&q, (*x).win, (*x).a_protocols, 4 as u32,
            32 as u32, (&del[0]) as u64, 4)
        ok = send(x, q.ptr, q.len)
        rt.buf_free(&q)
    }
    if (*x).gift != 0 {
        let okg: bool = r_fill(x, 16711935 as u32, 0, 0, w, h)
    }
    return ok
}

fn r_title(x: *mut Platte, p: u64, n: usize) -> bool {
    var r: rt.Buf = rt.buf_new()
    // WM_NAME (39), Typ STRING (31), Format 8.
    req_change_property(&r, (*x).win, 39 as u32, 31 as u32, 8 as u32, p, n)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    return ok
}

fn r_show(x: *mut Platte) -> bool {
    var r: rt.Buf = rt.buf_new()
    req_map_window(&r, (*x).win)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    if !ok {
        return false
    }
    return r_present(x)
}

// Under X11 there is no client canvas that would have to be created
// anew. The new size is adopted so that `r_width`/`r_height` and the
// clipping in `r_image` are right.
// The screen, in pixels.
fn r_screen(x: *mut Platte, sw: *mut usize, sh: *mut usize) -> bool {
    if (*x).schirm_w == 0 || (*x).schirm_h == 0 {
        return false
    }
    *sw = (*x).schirm_w
    *sh = (*x).schirm_h
    return true
}

// Centring is done under X11 by the WINDOW MANAGER, and the acceptance
// run works without one. So only the honest answer stands here.
fn r_centre(x: *mut Platte) -> bool {
    return false
}

fn r_maximise(x: *mut Platte, w: usize, h: usize) -> bool {
    if w == 0 || h == 0 {
        return false
    }
    (*x).w = w
    (*x).h = h
    if (*x).gift != 0 {
        let okg: bool = r_fill(x, 16711935 as u32, 0, 0, w, h)
    }
    return true
}

fn r_poison(x: *mut Platte, an: bool) {
    if an {
        (*x).gift = 1
    } else {
        (*x).gift = 0
    }
}

// ----------------------------------------------------------- painting

fn r_fill(x: *mut Platte, px: u32, x0: usize, y0: usize, w: usize,
    h: usize) -> bool {
    var r: rt.Buf = rt.buf_new()
    rt.buf_push(&r, 56 as u8) // ChangeGC
    rt.buf_push(&r, 0 as u8)
    put16(&r, 4 as u32)
    put32(&r, (*x).gc)
    put32(&r, 4 as u32) // GCForeground
    put32(&r, px)
    rt.buf_push(&r, 70 as u8) // PolyFillRectangle
    rt.buf_push(&r, 0 as u8)
    put16(&r, 5 as u32)
    put32(&r, (*x).win)
    put32(&r, (*x).gc)
    put16(&r, x0 as u32)
    put16(&r, y0 as u32)
    put16(&r, w as u32)
    put16(&r, h as u32)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    return ok
}

// The canvas as BGRX. A PutImage must not be longer than the largest
// request of the server -- the image goes over in bands.
fn r_image(x: *mut Platte, px: u64, w: usize, h: usize, dx: usize,
    dy: usize) -> bool {
    let per_row: usize = w * 4
    if per_row == 0 {
        return true
    }
    var rows: usize = 65536 / per_row
    if rows == 0 {
        rows = 1
    }
    var y: usize = 0
    var r: rt.Buf = rt.buf_new()
    while y < h {
        var band: usize = h - y
        if band > rows {
            band = rows
        }
        rt.buf_clear(&r)
        let bytes: usize = band * per_row
        req_put_image_head(&r, (*x).win, (*x).gc, w, band, dx, dy + y,
            (*x).depth, bytes)
        rt.buf_push_bytes(&r, px + (y * per_row) as u64, bytes)
        if !send(x, r.ptr, r.len) {
            rt.buf_free(&r)
            return false
        }
        y = y + band
    }
    rt.buf_free(&r)
    return true
}

// The font of the server for labels. Every X server has had "fixed"
// since 1987.
fn r_font(x: *mut Platte) -> bool {
    if (*x).font == 0 as u32 {
        (*x).font = new_id(x)
    }
    var nm: [u8; 5] = "fixed"
    var r: rt.Buf = rt.buf_new()
    rt.buf_push(&r, 45 as u8) // OpenFont
    rt.buf_push(&r, 0 as u8)
    put16(&r, (3 + (5 + pad4(5)) / 4) as u32)
    put32(&r, (*x).font)
    put16(&r, 5 as u32)
    put16(&r, 0 as u32)
    rt.buf_push_bytes(&r, (&nm[0]) as u64, 5)
    var q: usize = 0
    while q < pad4(5) {
        rt.buf_push(&r, 0 as u8)
        q = q + 1
    }
    rt.buf_push(&r, 56 as u8) // ChangeGC: font
    rt.buf_push(&r, 0 as u8)
    put16(&r, 4 as u32)
    put32(&r, (*x).gc)
    put32(&r, 16384 as u32) // GCFont
    put32(&r, (*x).font)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    return ok
}

// ImageText8: the octets are drawn with a filled background.
// `ty` ist die Grundlinie.
fn r_text(x: *mut Platte, px: u32, bg: u32, tx: usize, ty: usize, p: u64,
    n: usize) -> bool {
    var m: usize = n
    if m > 254 {
        m = 254
    }
    var r: rt.Buf = rt.buf_new()
    rt.buf_push(&r, 56 as u8) // ChangeGC
    rt.buf_push(&r, 0 as u8)
    put16(&r, 5 as u32)
    put32(&r, (*x).gc)
    put32(&r, 12 as u32) // GCForeground | GCBackground
    put32(&r, px)
    put32(&r, bg)
    rt.buf_push(&r, 76 as u8) // ImageText8
    rt.buf_push(&r, m as u8)
    put16(&r, (4 + (m + pad4(m)) / 4) as u32)
    put32(&r, (*x).win)
    put32(&r, (*x).gc)
    put16(&r, tx as u32)
    put16(&r, ty as u32)
    rt.buf_push_bytes(&r, p, m)
    var q: usize = 0
    while q < pad4(m) {
        rt.buf_push(&r, 0 as u8)
        q = q + 1
    }
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    return ok
}

// Nothing is buffered on this side -- a request goes out as soon as it
// is built. GetInputFocus is the classic round trip that makes the
// server work everything off before it answers.
// X11 knows no "the user is dragging right now": the window manager
// does not say so. On Linux it therefore still re-lays out on every
// ConfigureNotify -- coalesced as before. A named limit.
#[no_gc]
fn r_dragging(w: *mut Platte) -> bool { return false }

fn r_present(x: *mut Platte) -> bool {
    var r: rt.Buf = rt.buf_new()
    rt.buf_push(&r, 43 as u8)
    rt.buf_push(&r, 0 as u8)
    put16(&r, 1 as u32)
    let ok: bool = send(x, r.ptr, r.len)
    rt.buf_free(&r)
    return ok
}

// U4 -- no client canvas; the capture comes with `xwd`.
fn r_ppm(x: *mut Platte, pfad: u64) -> bool {
    return false
}

// ==================================================== DIE EREIGNISSE

// REPLIES ARE NOT EVENTS. The round trip in `r_blit` (GetInputFocus)
// brings a 32 octet REPLY back. Whoever counts it as an event builds
// himself a wait loop that never sleeps -- the first run of this round
// did exactly that, and you could see it because `xwd` caught a half
// painted image (background yes, boxes no). So away with everything
// that is NOT an event: replies (code 1) and errors (code 0).
//
fn drain_replies(x: *mut Platte) {
    var laeuft: bool = true
    while laeuft {
        if (*x).rb.len - (*x).rpos < 32 {
            return
        }
        let p: u64 = (*x).rb.ptr + (*x).rpos as u64
        let code: u8 = rt.ld8(p, 0) & 127 as u8
        if code == 1 as u8 {
            let extra: usize = (ld32le(p, 4) as usize) * 4
            if !want(x, 32 + extra) {
                return
            }
            (*x).rpos = (*x).rpos + 32 + extra
        } else if code == 0 as u8 {
            (*x).rpos = (*x).rpos + 32
        } else {
            return
        }
    }
}

fn r_pending(x: *mut Platte) -> bool {
    if (*x).inj != 0 as u32 {
        return true
    }
    drain_replies(x)
    return (*x).rb.len - (*x).rpos >= 32
}

// ===================================================================
// RUNDE C-040 -- NACHSEHEN, OB EINE EINGABE DA IST (ohne sie zu holen)
// ===================================================================
//
// X11 liefert Ereignisse nicht in einer Schlange im Programm, sondern
// als Oktett auf einer Verbindung. Wer wissen will, ob eine Taste
// wartet, muss also in den EMPFANGSPUFFER sehen -- und zwar ohne
// `rpos` zu bewegen, denn sonst waere das Ereignis fuer die
// Bildschleife weg.
//
// Deshalb ein ZWEITER Zeiger, `spos`: er laeuft ueber dieselben
// Aufzeichnungen, nimmt aber nichts heraus. Jede Aufzeichnung ist 32
// Oktett lang; nur eine Antwort (code 1) traegt einen Anhang. Eine
// halb angekommene Aufzeichnung bleibt liegen -- beim naechsten Mal
// steht sie ganz da.
//
// Gemeldet wird JEDE Eingabe genau EINMAL, weil `spos` nur vorwaerts
// laeuft. Gezaehlt wird, was ein Mensch ausgeloest hat: KeyPress (2)
// und ButtonPress (4). KeyRelease (3) NICHT -- `r_next` macht daraus
// kein Ereignis, also wuerde `ein_n` fuer jedes Loslassen um eins
// steigen und NIE wieder fallen; der Vorrang staende dann fuer immer
// auf "es wartet eine Taste". MotionNotify (6) ebenfalls nicht: eine
// ueber das Fenster fahrende Maus wuerde sonst jede Scheibe des
// Seitenbaus verschieben, und die Seite waere nie fertig.
//
// `ein_weg` faellt die Zahl wieder, sobald `r_next` die Eingabe
// wirklich herausgibt -- sonst haette der Vorrang kein Ende.
fn eingaben_spaehen(x: *mut Platte) {
    if (*x).spos < (*x).rpos {
        (*x).spos = (*x).rpos
    }
    var laeuft: bool = true
    while laeuft {
        if (*x).rb.len - (*x).spos < 32 {
            return
        }
        let p: u64 = (*x).rb.ptr + (*x).spos as u64
        let code: u8 = rt.ld8(p, 0) & 127 as u8
        var consume: usize = 32
        if code == 1 as u8 {
            let extra: usize = (ld32le(p, 4) as usize) * 4
            if (*x).rb.len - (*x).spos < 32 + extra {
                return
            }
            consume = 32 + extra
        }
        (*x).spos = (*x).spos + consume
        if code == 2 as u8 || code == 4 as u8 {
            (*x).ein_n = (*x).ein_n + 1
            (*x).ein_hook((*x).ein_ud)
        }
    }
}

// Die Wirtsfunktion, die `vorrang.vorrang_wirt_setzen` als
// `hat_eingabe` bekommt: erst frisch gelesene Oktett durchsehen, dann
// antworten, ob eine gesehene Eingabe noch ungeholt ist.
fn r_input_pending(x: *mut Platte) -> bool {
    if !(*x).open {
        return false
    }
    // ===============================================================
    // RUNDE C-040, NACHBESSERUNG fix-r4-1 -- ERST LESEN, DANN SPAEHEN
    // ===============================================================
    //
    // Hier stand nur `eingaben_spaehen(x)`, und der Kommentar darueber
    // versprach "erst frisch gelesene Oktett durchsehen". Genau das
    // tat es NICHT: `eingaben_spaehen` laeuft ueber den
    // EMPFANGSPUFFER, und wer den Puffer fuellt, ist `lese_nach` --
    // gerufen wird das aus `r_wait`/`nachsehen`.
    //
    // DER MESSBARE SCHADEN, aus der Spur /tmp/f41a.spur (xoffi.ai,
    // .bau/fixr41/browser, Klick bei 4,0 s, danach fuenf Tasten im
    // Abstand 0,7 s):
    //
    //     E 10464453 1     <- alle SECHS Eingaben
    //     E 10464454 2        auf einmal, bei 10,46 s
    //     ... bis E ... 6
    //
    // Die sechs Ereignisse standen die ganze Zeit im Kern und wurden
    // erst gesehen, als die Bildschleife wieder `next_event` rief.
    // Die Ursache ist eine Zeile in `window.wait_event`:
    //
    //     if backend.r_pending(&(*f).p) { return true }
    //
    // Waehrend des Seitenbaus holt niemand Ereignisse ab. Im
    // Empfangspuffer liegt also immer noch etwas (ein Expose, eine
    // Antwort), `r_pending` sagt "ja, da ist was", und `r_wait` -- und mit
    // ihm der einzige `lese_nach` auf diesem Weg -- wird NIE gerufen.
    // Der Atemhaken pumpte damit einen Puffer, der sich nicht mehr
    // fuellte: die Blockadeuhr lief richtig (Messlatte 1 war echt),
    // aber der Eingabe-Vorrang konnte nichts sehen, und die
    // Tastenlatenz blieb bei sieben Sekunden.
    //
    // `nachsehen` ist ein `poll` mit Frist 0 und ein `read`, wenn
    // etwas da ist -- also genau so teuer wie der Blick, den diese
    // Funktion vorgibt zu tun. Sein Rueckgabewert sagt nur, ob die
    // Verbindung noch lebt; das Ende des Fensters meldet die
    // Bildschleife ueber `next_event`, hier waere es der falsche Ort.
    let lebt: bool = nachsehen(x)
    eingaben_spaehen(x)
    return (*x).ein_n != 0
}

fn jetzt_us() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000 + (ts[1] as u64) / 1000
}

// WAITING. `ms` < 0 = forever, 0 = only look.
fn r_wait(x: *mut Platte, ms: i64) -> bool {
    if r_pending(x) {
        return true
    }
    if !(*x).open {
        return false
    }
    let fd: i32 = net.conn_fd(&(*x).c)
    // struct pollfd { int fd; short events; short revents; }
    var pfd: [i32; 2] = [0; 2]
    pfd[0] = fd
    pfd[1] = 1 // POLLIN
    let start: u64 = jetzt_us()
    var rest: i64 = ms
    var laeuft: bool = true
    while laeuft {
        pfd[1] = 1
        let r: i64 = syscall(7, (&pfd[0]) as i64, 1, rest, 0, 0, 0)
        if r > 0 {
            let ok: bool = lese_nach(x)
            if r_pending(x) {
                return true
            }
            if !(*x).open {
                return true
            }
            // ONLY a reply came. Keep waiting -- but only the remaining
            // time, otherwise `wait_event(50)` would be a deadline without end.
            if ms >= 0 {
                let hin: i64 = ((jetzt_us() - start) / 1000 as u64) as i64
                if hin >= ms {
                    return false
                }
                rest = ms - hin
            }
        } else {
            // U5: die Frist ist abgelaufen. Hoechstens einmal je
            // second, look at the system whether light/dark was switched
            // over.
            let n: u64 = jetzt_us()
            if n > (*x).dark_us + 1000000 as u64 {
                (*x).dark_us = n
                let vorher: bool = (*x).dark
                read_theme(x)
                if (*x).dark != vorher {
                    (*x).inj = window.EV_THEME
                    return true
                }
            }
            return false
        }
    }
    return false
}

// A glance at the socket, without waiting. false = the connection is
// gone (the server closed or the window was killed).
fn nachsehen(x: *mut Platte) -> bool {
    if !(*x).open {
        return false
    }
    let fd: i32 = net.conn_fd(&(*x).c)
    var pfd: [i32; 2] = [0; 2]
    pfd[0] = fd
    pfd[1] = 1 // POLLIN
    let r: i64 = syscall(7, (&pfd[0]) as i64, 1, 0, 0, 0, 0)
    if r > 0 {
        let ok: bool = lese_nach(x)
        return (*x).open
    }
    return true
}

// The next event, NON blocking. Replies and errors are thrown away --
// apart from the atoms and RESOURCE_MANAGER this client asks no
// question whose answer it needs, and those two are done before the
// first event.
fn ein_weg(x: *mut Platte) {
    if (*x).ein_n != 0 {
        (*x).ein_n = (*x).ein_n - 1
    }
}

fn r_next(x: *mut Platte, k: *mut u32, a: *mut u32, ox: *mut u32,
    oy: *mut u32, os: *mut u32) -> bool {
    // RUNDE C-040: erst nachsehen, was seit dem letzten Mal
    // hereingekommen ist. Damit wird eine Taste auch dann EINMAL
    // gemeldet, wenn gerade kein Seitenbau laeuft und darum niemand
    // `r_input_pending` gerufen hat.
    eingaben_spaehen(x)
    if (*x).inj != 0 as u32 {
        *k = (*x).inj
        *a = 0 as u32
        *ox = 0 as u32
        *oy = 0 as u32
        *os = 0 as u32
        (*x).inj = 0
        return true
    }
    var laeuft: bool = true
    while laeuft {
        if (*x).rb.len - (*x).rpos < 32 {
            // Look once WITHOUT waiting. That makes `next_event` mean the
            // same on both systems: "give me an event if there is one
            // right now" -- under Windows `pump(w, 0)` does exactly
            // that.
            let lebt: bool = nachsehen(x)
            if !lebt {
                *k = window.EV_CLOSED
                *a = 0 as u32
                *ox = 0 as u32
                *oy = 0 as u32
                *os = 0 as u32
                return true
            }
            if (*x).rb.len - (*x).rpos < 32 {
                return false
            }
            // Frische Oktett: auch die koennen eine Eingabe tragen.
            eingaben_spaehen(x)
        }
        let p: u64 = (*x).rb.ptr + (*x).rpos as u64
        let code: u8 = rt.ld8(p, 0) & 127 as u8
        var consume: usize = 32
        if code == 1 as u8 {
            let extra: usize = (ld32le(p, 4) as usize) * 4
            if !want(x, 32 + extra) {
                *k = window.EV_CLOSED
                return true
            }
            consume = 32 + extra
        }
        (*x).rpos = (*x).rpos + consume
        if code == 2 as u8 || code == 4 as u8 {
            // RUNDE C-040: diese Eingabe ist jetzt heraus -- der
            // Vorrang fuer sie ist erledigt.
            ein_weg(x)
        }
        // `want` kann den Puffer eben verlegt haben -- die Stelle wird
        // darum NEU bestimmt und nicht aus `p` von oben genommen.
        // Antworten (1) und Fehler (0) sind keine Ereignisse.
        if code != 1 as u8 && code != 0 as u8 {
            let q: u64 = (*x).rb.ptr + ((*x).rpos - consume) as u64
            if decode_event(q, (*x).a_delete, &(*x).km, (*x).voll, k, a,
                ox, oy, os) {
                return true
            }
        }
    }
    return false
}

// Does this key number have a meaning (K_*)? The numbers ARE the X11
// numbers; lib/window/win32.fi maps Windows onto them.
fn is_key(kc: u32) -> bool {
    return kc == window.K_ESCAPE || kc == window.K_BACK
    || kc == window.K_TAB || kc == window.K_RETURN
    || kc == window.K_HOME || kc == window.K_UP
    || kc == window.K_PAGEUP || kc == window.K_LEFT
    || kc == window.K_RIGHT || kc == window.K_END
    || kc == window.K_DOWN || kc == window.K_PAGEDOWN
    || kc == window.K_DELETE
}

// The US keyboard, as every X server hands it out, for the ASCII
// range. Four rows that have not moved since the IBM PC -- as a TABLE
// and not as four almost identical blocks.
// ======================================================================
// RUNDE C-033 -- DER DOPPELPUNKT FEHLTE. ALSO AUCH "https://".
// ======================================================================
//
// GEFUNDEN BEIM BILDERLAUF DIESER RUNDE: der Abnahmelauf tippte
// "127.0.0.1:8137/zwei.html" in die Adresszeile, und im Fenster stand
// "127.0.0.1;8137/zwei.html" -- ein STRICHPUNKT. Der erste Verdacht war
// die Tastaturbelegung des Xvfb; sie war es nicht (`xmodmap -pke` zeigt
// "keycode 47 = semicolon colon semicolon colon", und `xdotool key
// colon` schickt brav Umschalt+47).
//
// Es war DIESE FUNKTION. Die Umschalt-Ebene galt hier fuer genau zwei
// Gruppen: die Ziffernreihe (ueber `ziffern_um`) und die Buchstaben
// (ueber das `- 32`). Fuer alle uebrigen Tasten der drei
// Buchstabenreihen fiel `shift` UNTER DEN TISCH, und das sind sieben
// Zeichen:
//
//     ;  ->  :        '  ->  "        [  ->  {        ]  ->  }
//     ,  ->  <        .  ->  >        /  ->  ?
//
// Der Doppelpunkt ist darunter. Mit anderen Worten: KEIN MENSCH KONNTE
// IN CERTUS JE "https://" TIPPEN -- nur Adressen ohne Schema, die
// `bar_normalisieren` dann selbst ergaenzt. Genauso wenig ein "?" und
// damit keine einzige Suchanfrage von Hand.
//
// Aufgefallen ist es nie, weil jede Abnahme die Adresse als ARGUMENT
// uebergibt und nicht tippt. Erst der Bilderlauf dieser Runde hat
// wirklich getippt.
//
// Die Tabelle `reihen_um` ist die Umschalt-Ebene der US-Belegung,
// Zeichen fuer Zeichen an derselben Stelle wie `reihen`. Ein Punkt
// steht fuer "keine eigene Umschalt-Ebene" -- da greift danach die
// Buchstabenregel.
fn key_ascii(code: u32, shift: bool) -> u32 {
    var von: [u32; 4] = [10, 24, 38, 52]
    var bis: [u32; 4] = [21, 35, 48, 61]
    var ab: [usize; 4] = [0, 12, 24, 35]
    var reihen: [u8; 45] = "1234567890-=qwertyuiop[]asdfghjkl;'zxcvbnm,./"
    // DIESELBE LAENGE, DIESELBE REIHENFOLGE. Wo ein Buchstabe steht,
    // steht hier ein Leerzeichen -- die Grossschreibung macht die
    // Regel darunter.
    var reihen_um: [u8; 45] = "!@#$%^&*()_+          {}         :\"       <>?"
    var ziffern_um: [u8; 12] = "!@#$%^&*()_+"
    var i: usize = 0
    while i < 4 {
        if code >= von[i] && code <= bis[i] {
            let k: usize = (code - von[i]) as usize
            if i == 0 && shift {
                return ziffern_um[k] as u32
            }
            var ch: u32 = reihen[ab[i] + k] as u32
            if shift {
                // ZUERST die eigene Umschalt-Ebene der Taste ...
                let um: u32 = reihen_um[ab[i] + k] as u32
                if um != 32 as u32 {
                    return um
                }
                // ... und sonst die Buchstabenregel wie bisher.
                if ch >= 97 as u32 && ch <= 122 as u32 {
                    ch = ch - 32 as u32
                }
            }
            return ch
        }
        i = i + 1
    }
    if code == 65 as u32 {
        return 32 as u32 // Leerzeichen
    }
    return 0 as u32
}

fn r_close(x: *mut Platte) {
    if (*x).open {
        net.close(&(*x).c)
        (*x).open = false
    }
    rt.buf_free(&(*x).rb)
}

// ======================================================================
// RUNDE C-038 -- DIE SELBSTAKTUALISIERUNG GIBT ES HIER NICHT
// ======================================================================
//
// `certus-update.exe` ist ein Windows-Programm (tools/windows/update.c,
// gebaut nach certus-update.exe neben certus.exe). Unter Linux wird
// Certus nicht aus einem ZIP von store.fleitec.com installiert, sondern
// aus dem Quelltext gebaut -- eine Selbstaktualisierung waere dort
// nicht nur unnoetig, sondern falsch.
//
// Also ein ehrliches `false` statt eines stillen Nichtstuns: der
// Aufrufer sagt dem Nutzer dann "Selbstaktualisierung gibt es nur unter
// Windows", und das stimmt auch. Ein Stummel, der `true` gibt und
// nichts tut, waere genau der tote Schalter, den schon C-036 verboten
// hat.
fn r_update_start(mit_fenster: bool) -> bool {
    return false
}
// RUNDE C-040: die schliessende Klammer fehlte. Ohne sie verschluckte
