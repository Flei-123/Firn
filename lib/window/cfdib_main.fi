// lib/window/cfdib_main.fi -- test helper for tools/window/cfdib.sh.
//   stdin = one mode octet ("P" = PNG -> CF_DIBV5 block, "D" = CF_DIB/CF_DIBV5 block -> PNG), then the data; stdout = the result.
import std.rt
import std.io
import html.mem
import window.cfdib

fn main() -> i32 {
    var inb: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&inb)
    var out: rt.Buf = rt.buf_new()
    if mem.buf_len(&inb) < 2 {
        return 2
    }
    let ip: u64 = mem.buf_ptr(&inb) as u64
    var ok: bool = false
    if rt.ld8(ip, 0) == 80 as u8 {
        ok = cfdib.cf_dibv5_from_png(ip + 1 as u64, mem.buf_len(&inb) - 1, &out)
    } else {
        ok = cfdib.cf_png_from_dib(ip + 1 as u64, mem.buf_len(&inb) - 1, &out)
    }
    if !ok {
        return 3
    }
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}
