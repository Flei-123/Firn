// lib/window/cfhtml_main.fi -- stdin: HTML fragment; stdout: its CF_HTML block, a 0x01 octet, the fragment extracted again.
import std.rt
import std.io
import html.mem
import window.cfhtml

fn main() -> i32 {
    var inb: mem.Buf = mem.buf_new()
    mem.read_all_stdin(&inb)
    var blk: rt.Buf = rt.buf_new()
    cfhtml.cf_html_build(mem.buf_ptr(&inb) as u64, mem.buf_len(&inb), &blk)
    let blen: usize = rt.buf_len(&blk)
    rt.buf_push(&blk, 0 as u8) // a trailing NUL (GlobalSize padding) must not matter
    var back: rt.Buf = rt.buf_new()
    let ok: bool = cfhtml.cf_html_extract(rt.buf_ptr(&blk), rt.buf_len(&blk), &back)
    io.print_bytes(rt.buf_ptr(&blk), blen)
    var sep: [u8; 1] = [1 as u8; 1]
    io.print_bytes((&sep[0]) as u64, 1)
    io.print_bytes(rt.buf_ptr(&back), rt.buf_len(&back))
    if !ok {
        return 3
    }
    return 0
}
