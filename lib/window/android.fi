// ===================================================================
// FIRN (r61) -- THE HOST MODE: WHAT THE APP THREAD TAKES OVER
// ===================================================================

// Density and light/dark from the activity. Android's "dpi" is a density
// class (160 = 1 dp per pixel); the window layer counts design points at
// 96 per inch. One Android dp is one design point, so 160 -> 96.
fn konfig_uebernehmen(x: *mut Platte) {
    let d: usize = activity.activity_density()
    if d > 0 {
        an_set_dpi(x, (d * 96 + 80) / 160)
    }
    let n: u32 = activity.activity_night()
    if n == 1 as u32 {
        an_set_dark(x, false)
    } else if n == 2 as u32 {
        an_set_dark(x, true)
    }
}

// Take over one command of the main thread. The acknowledgement comes
// AFTER the change, never before: the main thread lets Android destroy a
// window only once this thread has let go of it.
fn host_befehl(x: *mut Platte, c: i32) {
    if c == activity.CMD_WINDOW {
        (*x).akt = activity.activity_pointer()
        let w: u64 = activity.activity_pending_window()
        if w != (*x).win {
            an_set_window(x, w)
            if w != 0 {
                // NativeActivity asks for RGB_565 (getWindow().setFormat);
                // the contract is 32 bit, so every new window is told.
                let r: i32 = ndk.ANativeWindow_setBuffersGeometry(w, 0, 0,
                    ndk.WINDOW_FORMAT_RGBA_8888)
                (*x).w = ndk.ANativeWindow_getWidth(w) as usize
                (*x).h = ndk.ANativeWindow_getHeight(w) as usize
                rechteck_uebernehmen(x)
                an_event(x, window.EV_CONFIGURE, 0, r_width(x) as u32,
                    r_height(x) as u32, 0)
                an_event(x, window.EV_EXPOSE, 0, 0, 0, 0)
            }
        }
    } else if c == activity.CMD_RESIZED {
        if (*x).win != 0 {
            (*x).w = ndk.ANativeWindow_getWidth((*x).win) as usize
            (*x).h = ndk.ANativeWindow_getHeight((*x).win) as usize
            rechteck_uebernehmen(x)
            an_event(x, window.EV_CONFIGURE, 0, r_width(x) as u32,
                r_height(x) as u32, 0)
            an_event(x, window.EV_EXPOSE, 0, 0, 0, 0)
        }
    } else if c == activity.CMD_REDRAW || c == activity.CMD_RESUME {
        an_event(x, window.EV_EXPOSE, 0, 0, 0, 0)
    } else if c == activity.CMD_QUEUE {
        let q: u64 = activity.activity_pending_queue()
        if q != (*x).q {
            if (*x).q != 0 {
                ndk.AInputQueue_detachLooper((*x).q)
            }
            (*x).q = q
            if q != 0 {
                ndk.AInputQueue_attachLooper(q, activity.activity_looper(),
                    activity.IDENT_INPUT, 0, 0)
            }
        }
    } else if c == activity.CMD_CONFIG {
        let alt_dpi: usize = (*x).dpi
        let alt_dark: bool = (*x).dark
        activity.activity_config_read()
        konfig_uebernehmen(x)
        if (*x).dpi != alt_dpi {
            an_event(x, window.EV_CONFIGURE, 0, r_width(x) as u32,
                r_height(x) as u32, 0)
        }
        if (*x).dark != alt_dark {
            an_event(x, window.EV_THEME, 0, 0, 0, 0)
        }
    } else if c == activity.CMD_DESTROY {
        an_event(x, window.EV_CLOSED, 0, 0, 0, 0)
    }
}

// Android key code -> window.K_*; 0 = none (then maybe a character).
fn host_taste(code: i32) -> u32 {
    if code == ndk.KEYCODE_BACK || code == ndk.KEYCODE_ESCAPE {
        return window.K_ESCAPE
    }
    if code == ndk.KEYCODE_ENTER || code == ndk.KEYCODE_NUMPAD_ENTER {
        return window.K_RETURN
    }
    if code == ndk.KEYCODE_DEL { return window.K_BACK }
    if code == ndk.KEYCODE_FORWARD_DEL { return window.K_DELETE }
    if code == ndk.KEYCODE_TAB { return window.K_TAB }
    if code == ndk.KEYCODE_DPAD_UP { return window.K_UP }
    if code == ndk.KEYCODE_DPAD_DOWN { return window.K_DOWN }
    if code == ndk.KEYCODE_DPAD_LEFT { return window.K_LEFT }
    if code == ndk.KEYCODE_DPAD_RIGHT { return window.K_RIGHT }
    if code == ndk.KEYCODE_PAGE_UP { return window.K_PAGEUP }
    if code == ndk.KEYCODE_PAGE_DOWN { return window.K_PAGEDOWN }
    if code == ndk.KEYCODE_MOVE_HOME { return window.K_HOME }
    if code == ndk.KEYCODE_MOVE_END { return window.K_END }
    return 0 as u32
}

// One AInputEvent -> window events. Returns 1 = handled.
fn host_eingabe(x: *mut Platte, ev: u64) -> i32 {
    let typ: i32 = ndk.AInputEvent_getType(ev)
    if typ == ndk.EVENT_TYPE_MOTION {
        let act: i32 = ndk.AMotionEvent_getAction(ev) & ndk.ACTION_MASK
        var fx: f32 = ndk.AMotionEvent_getX(ev, 0)
        var fy: f32 = ndk.AMotionEvent_getY(ev, 0)
        fx = fx - (*x).ox as f32
        fy = fy - (*x).oy as f32
        if fx < 0.0 { fx = 0.0 }
        if fy < 0.0 { fy = 0.0 }
        let px: u32 = fx as u32
        let py: u32 = fy as u32
        if act == ndk.ACTION_DOWN {
            an_event(x, window.EV_MOTION, 0, px, py, 0)
            an_event(x, window.EV_BUTTON, window.BTN_LEFT, px, py, 0)
        } else if act == ndk.ACTION_MOVE
            || act == ndk.AMOTION_EVENT_ACTION_HOVER_MOVE {
            an_event(x, window.EV_MOTION, 0, px, py, 0)
        } else if act == ndk.ACTION_UP {
            // Android batches moves; the last position may only come with
            // the UP. Without this motion a drag would end short.
            an_event(x, window.EV_MOTION, 0, px, py, 0)
            an_event(x, window.EV_RELEASE, window.BTN_LEFT, px, py, 0)
            an_event(x, window.EV_LEAVE, 0, px, py, 0)
        } else if act == ndk.ACTION_CANCEL {
            an_event(x, window.EV_LEAVE, 0, px, py, 0)
        } else if act == ndk.AMOTION_EVENT_ACTION_SCROLL {
            let v: f32 = ndk.AMotionEvent_getAxisValue(ev, ndk.AXIS_VSCROLL, 0)
            if v > 0.0 {
                an_event(x, window.EV_BUTTON, window.BTN_WHEEL_UP, px, py, 0)
            } else if v < 0.0 {
                an_event(x, window.EV_BUTTON, window.BTN_WHEEL_DOWN, px, py, 0)
            }
        }
        return 1
    }
    if typ == ndk.EVENT_TYPE_KEY {
        let aktion: i32 = ndk.AKeyEvent_getAction(ev)
        let code: i32 = ndk.AKeyEvent_getKeyCode(ev)
        let meta: i32 = ndk.AKeyEvent_getMetaState(ev)
        var zustand: u32 = 0
        if (meta & ndk.META_SHIFT) != 0 { zustand = zustand | 1 as u32 }
        if (meta & ndk.META_CTRL) != 0 { zustand = zustand | 4 as u32 }
        let k: u32 = host_taste(code)
        if code == ndk.KEYCODE_BACK && activity.activity_kept_alive() {
            // The program outlives its activity: Back closes the activity
            // the Android way, the program keeps running without window.
            return 0
        }
        if aktion == ndk.KEY_ACTION_DOWN {
            if k != 0 as u32 {
                an_event(x, window.EV_KEY, k, code as u32, 0, zustand)
                return 1
            }
            let ch: u32 = ndk.key_char(code, meta)
            if ch != 0 as u32 {
                an_event(x, window.EV_CHAR, ch, code as u32, 0, zustand)
                return 1
            }
            return 0
        }
        if aktion == ndk.KEY_ACTION_UP {
            if k != 0 as u32 {
                an_event(x, window.EV_KEY_UP, k, code as u32, 0, zustand)
                return 1
            }
            if ndk.key_char(code, meta) != 0 as u32 {
                return 1
            }
        }
        return 0
    }
    return 0
}

fn host_eingaben(x: *mut Platte) {
    let q: u64 = (*x).q
    if q == 0 {
        return
    }
    var ev: u64 = 0
    while ndk.AInputQueue_getEvent(q, (&ev) as u64) >= 0 {
        // The soft keyboard may claim the event first.
        if ndk.AInputQueue_preDispatchEvent(q, ev) == 0 {
            let h: i32 = host_eingabe(x, ev)
            ndk.AInputQueue_finishEvent(q, ev, h)
        }
    }
}

// THE PUMP of the host mode: wait up to `ms` (-1 = until something comes,
// 0 = only look) on the app thread's looper, then take over everything
// that is ready. Returns whether an event is waiting in the queue.
fn host_pump(x: *mut Platte, ms: i64) -> bool {
    let lp: u64 = activity.activity_looper()
    if lp == 0 {
        return r_pending(x)
    }
    var t: i32 = ms as i32
    if ms > 2147483647 {
        t = 2147483647
    }
    var runden: usize = 0
    while runden < 64 {
        var fd: i32 = 0
        var evs: i32 = 0
        var daten: u64 = 0
        let id: i32 = ndk.ALooper_pollOnce(t, (&fd) as u64, (&evs) as u64,
            (&daten) as u64)
        if id == activity.IDENT_CMD {
            var c: i32 = activity.activity_read_cmd()
            while c != activity.CMD_NONE {
                host_befehl(x, c)
                activity.activity_ack()
                c = activity.activity_read_cmd()
            }
        } else if id == activity.IDENT_INPUT {
            host_eingaben(x)
        } else {
            // ALOOPER_POLL_TIMEOUT / _WAKE / _ERROR: nothing (more) ready.
            break
        }
        // Once something came, only take what is ready as well.
        t = 0
        runden = runden + 1
    }
    return r_pending(x)
}

// The content rectangle from the activity, clipped to the buffer. Without
// a report (or a nonsensical one) the whole window is content.
fn rechteck_uebernehmen(x: *mut Platte) {
    var l: i32 = 0
    var t: i32 = 0
    var r: i32 = 0
    var b: i32 = 0
    (*x).ox = 0
    (*x).oy = 0
    (*x).cw = 0
    (*x).ch = 0
    if !activity.activity_content_rect(&l, &t, &r, &b) {
        return
    }
    if l < 0 || t < 0 || r as usize > (*x).w || b as usize > (*x).h {
        return
    }
    (*x).ox = l as usize
    (*x).oy = t as usize
    (*x).cw = (r - l) as usize
    (*x).ch = (b - t) as usize
}

// The strips around the content rectangle: black, every frame (the window
// has two or three buffers, each with its own old content).
fn raender_fuellen(x: *mut Platte) {
    let ox: usize = (*x).ox
    let oy: usize = (*x).oy
    let cw: usize = (*x).cw
    let ch: usize = (*x).ch
    (*x).ox = 0
    (*x).oy = 0
    let w: usize = (*x).w
    let h: usize = (*x).h
    if oy > 0 {
        let a: bool = r_fill(x, 0 as u32, 0, 0, w, oy)
    }
    if oy + ch < h {
        let b: bool = r_fill(x, 0 as u32, 0, oy + ch, w, h - oy - ch)
    }
    if ox > 0 {
        let c: bool = r_fill(x, 0 as u32, 0, oy, ox, ch)
    }
    if ox + cw < w {
        let d: bool = r_fill(x, 0 as u32, ox + cw, oy, w - ox - cw, ch)
    }
    (*x).ox = ox
    (*x).oy = oy
}

// ===================================================================
// FIRN r64 -- notify / stay_alive / in_front (see lib/window/window.fi)
// ===================================================================

// In front = the activity is resumed and its window is ours.
fn r_in_front(x: *mut Platte) -> bool {
    if !(*x).host {
        return (*x).win != 0
    }
    return (*x).win != 0 && activity.activity_resumed()
}

// Title and text as zero terminated copies, then lib/plat/android/push.fi.
fn r_notify(x: *mut Platte, tp: u64, tn: usize, xp: u64, xn: usize) -> bool {
    if !(*x).host {
        return false
    }
    var t: [u8; 128] = [0 as u8; 128]
    var m: [u8; 1024] = [0 as u8; 1024]
    var n1: usize = tn
    if n1 > 127 { n1 = 127 }
    var n2: usize = xn
    if n2 > 1023 { n2 = 1023 }
    rt.mem_copy((&t[0]) as u64, tp, n1)
    rt.mem_copy((&m[0]) as u64, xp, n2)
    return push.push_notify((&t[0]) as u64, (&m[0]) as u64)
}

// One notification per key (lib/window/window.fi notify_at).
fn r_notify_at(x: *mut Platte, key: u64, tp: u64, tn: usize, xp: u64,
    xn: usize) -> bool {
    if !(*x).host {
        return false
    }
    var t: [u8; 128] = [0 as u8; 128]
    var m: [u8; 1024] = [0 as u8; 1024]
    var n1: usize = tn
    if n1 > 127 { n1 = 127 }
    var n2: usize = xn
    if n2 > 1023 { n2 = 1023 }
    rt.mem_copy((&t[0]) as u64, tp, n1)
    rt.mem_copy((&m[0]) as u64, xp, n2)
    return push.push_notify_at(key, (&t[0]) as u64, (&m[0]) as u64)
}

fn r_notify_shown(x: *mut Platte, key: u64) -> i32 {
    if !(*x).host {
        return -1
    }
    return push.push_shown(key)
}

fn r_notify_cancel(x: *mut Platte, key: u64) -> bool {
    if !(*x).host {
        return false
    }
    return push.push_cancel(key)
}

// The system's picker through org.firn.FirnPick (lib/plat/android/pick.fi;
// the APK needs `tools/android/build.sh --pick`).
fn r_pick_image(x: *mut Platte) -> bool {
    if !(*x).host {
        return false
    }
    return pick.pick_start()
}

fn r_pick_poll(x: *mut Platte) -> i32 {
    if !(*x).host {
        return -1
    }
    return pick.pick_poll()
}

fn r_pick_take(x: *mut Platte, out: u64, cap: usize, n: *mut usize, w: *mut usize,
    h: *mut usize) -> bool {
    if !(*x).host {
        return false
    }
    return pick.pick_take(out, cap, n, w, h)
}

fn r_image_decode(x: *mut Platte, p: u64, n: usize, w: usize, h: usize,
    out: u64) -> bool {
    if !(*x).host {
        return false
    }
    return pick.image_decode(p, n, w, h, out)
}

// The foreground service WITHOUT a relay of its own: the program keeps its
// connection itself and only needs the process to stay.
fn r_stay_alive(x: *mut Platte, an: bool) -> bool {
    if !(*x).host {
        return false
    }
    if an {
        return push.push_keep()
    }
    return push.push_stop()
}

// ===================================================================
// ON THE GPU -- fUi tempo, stage 2b (24.09.2026)
// ===================================================================
//
// WHY: fUi painted every picture on the CPU and this backend copied it
// into the locked window buffer, octet by octet (`r_image`). Measured on
// the emulator: 885 ms for one picture of 2072 x 1014. A phone has a GPU;
// fUi's renderer (lib/fui/gpu.fi) draws with OpenGL ES 3 when it gets a
// table of GL calls (lib/paint/gl.fi) -- this is where the table comes
// from on Android:
//
//   r_gpu_open   an EGL display, a config (RGBA 8888, ES 3, window), a
//                context, a surface on the window, made current ON THE APP
//                THREAD (the only thread that draws), and the table filled
//                by lib/plat/gles.fi. False: no GLES 3 here -- the program
//                paints in memory as before, nothing else changes.
//   r_gpu_swap   the finished picture onto the screen (eglSwapBuffers);
//                a window that came back gets its surface first.
//   r_gpu_place  where the program's content lies on the surface (status
//                bar, navigation bar, cutout) and how large the surface is.
//   r_gpu_lost   the context was lost (EGL_CONTEXT_LOST): every GL object
//                is gone, the renderer has to be opened again.
//
// From `r_gpu_open` on, the window buffer is never locked again: a window
// with an EGL surface cannot be locked (ANativeWindow_lock fails), and the
// program draws only through GL.

extern fn eglGetDisplay(d: u64) -> u64;
extern fn eglInitialize(d: u64, maj: u64, min: u64) -> u32;
extern fn eglChooseConfig(d: u64, attrs: u64, cfgs: u64, n: i32, num: u64) -> u32;
extern fn eglCreateContext(d: u64, cfg: u64, share: u64, attrs: u64) -> u64;
extern fn eglCreateWindowSurface(d: u64, cfg: u64, win: u64, attrs: u64) -> u64;
extern fn eglMakeCurrent(d: u64, draw: u64, read: u64, ctx: u64) -> u32;
extern fn eglSwapBuffers(d: u64, srf: u64) -> u32;
extern fn eglDestroySurface(d: u64, srf: u64) -> u32;
extern fn eglDestroyContext(d: u64, c: u64) -> u32;
extern fn eglGetError() -> i32;
extern fn eglQuerySurface(d: u64, srf: u64, attr: i32, val: u64) -> u32;
extern fn eglGetConfigAttrib(d: u64, cfg: u64, attr: i32, val: u64) -> u32;

const EGL_NONE: i32 = 12344
const EGL_RED_SIZE: i32 = 12324
const EGL_GREEN_SIZE: i32 = 12323
const EGL_BLUE_SIZE: i32 = 12322
const EGL_ALPHA_SIZE: i32 = 12321
const EGL_DEPTH_SIZE: i32 = 12325
const EGL_STENCIL_SIZE: i32 = 12326
const EGL_SURFACE_TYPE: i32 = 12339
const EGL_WINDOW_BIT: i32 = 4
const EGL_RENDERABLE_TYPE: i32 = 12352
const EGL_OPENGL_ES3_BIT: i32 = 64
const EGL_CONTEXT_CLIENT_VERSION: i32 = 12440
const EGL_NATIVE_VISUAL_ID: i32 = 12334
const EGL_WIDTH: i32 = 12375
const EGL_HEIGHT: i32 = 12374
const EGL_CONTEXT_LOST: i32 = 12302

fn egl_say(s: str) {
    rt.write_everything(2, s.p as u64, s.n)
}

// The surface on the current window, made current. False: no window, or
// EGL refused it (the caller tries again at the next swap).
fn egl_surface(x: *mut Platte) -> bool {
    if (*x).egl_s != 0 {
        return true
    }
    if (*x).win == 0 || (*x).egl_c == 0 {
        return false
    }
    // the buffers of the window in the config's format (RGBA 8888)
    var vis: [i32; 1] = [0]
    if eglGetConfigAttrib((*x).egl_d, (*x).egl_cfg, EGL_NATIVE_VISUAL_ID, (&vis[0]) as u64) != 0 as u32 {
        let r: i32 = ndk.ANativeWindow_setBuffersGeometry((*x).win, 0, 0, vis[0])
    }
    let srf: u64 = eglCreateWindowSurface((*x).egl_d, (*x).egl_cfg, (*x).win, 0)
    if srf == 0 {
        egl_say("android: eglCreateWindowSurface failed\n")
        return false
    }
    if eglMakeCurrent((*x).egl_d, srf, srf, (*x).egl_c) == 0 as u32 {
        egl_say("android: eglMakeCurrent failed\n")
        let d: u32 = eglDestroySurface((*x).egl_d, srf)
        return false
    }
    (*x).egl_s = srf
    (*x).egl_win = (*x).win
    return true
}

fn egl_drop_surface(x: *mut Platte) {
    if (*x).egl_s == 0 {
        return
    }
    let a: u32 = eglMakeCurrent((*x).egl_d, 0, 0, 0)
    let b: u32 = eglDestroySurface((*x).egl_d, (*x).egl_s)
    (*x).egl_s = 0
    (*x).egl_win = 0
}

// Open the GPU for this window; `api` is a *mut gl.GlApi (lib/paint/gl.fi)
// the table is written into. Host mode only: the window comes from the
// activity, and the calls run on the app thread.
fn r_gpu_open(x: *mut Platte, api: u64) -> bool {
    if !(*x).host || (*x).win == 0 {
        return false
    }
    if (*x).gpu && (*x).egl_c != 0 {
        gles.gles_api(api as *mut gl.GlApi)
        return egl_surface(x)
    }
    let d: u64 = eglGetDisplay(0)
    if d == 0 {
        return false
    }
    if eglInitialize(d, 0, 0) == 0 as u32 {
        egl_say("android: eglInitialize failed\n")
        return false
    }
    var at: [i32; 17] = [EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT,
        EGL_SURFACE_TYPE, EGL_WINDOW_BIT, EGL_RED_SIZE, 8, EGL_GREEN_SIZE, 8,
        EGL_BLUE_SIZE, 8, EGL_ALPHA_SIZE, 8, EGL_DEPTH_SIZE, 0,
        EGL_STENCIL_SIZE, 0, EGL_NONE]
    var cfg: [u64; 1] = [0]
    var num: [i32; 1] = [0]
    if eglChooseConfig(d, (&at[0]) as u64, (&cfg[0]) as u64, 1, (&num[0]) as u64) == 0 as u32 ||
        num[0] < 1 || cfg[0] == 0 {
        egl_say("android: no EGL config for OpenGL ES 3 (RGBA 8888)\n")
        return false
    }
    var ca: [i32; 3] = [EGL_CONTEXT_CLIENT_VERSION, 3, EGL_NONE]
    let c: u64 = eglCreateContext(d, cfg[0], 0, (&ca[0]) as u64)
    if c == 0 {
        egl_say("android: eglCreateContext (ES 3) failed\n")
        return false
    }
    (*x).egl_d = d
    (*x).egl_cfg = cfg[0]
    (*x).egl_c = c
    if !egl_surface(x) {
        let k: u32 = eglDestroyContext(d, c)
        (*x).egl_c = 0
        return false
    }
    gles.gles_api(api as *mut gl.GlApi)
    (*x).gpu = true
    (*x).gpu_lost = false
    return true
}

// The picture onto the screen. False: nothing was shown (no window right
// now -- the program keeps its picture and shows it when one comes).
fn r_gpu_swap(x: *mut Platte) -> bool {
    if !(*x).gpu {
        return false
    }
    if !egl_surface(x) {
        return false
    }
    if eglSwapBuffers((*x).egl_d, (*x).egl_s) == 0 as u32 {
        let e: i32 = eglGetError()
        if e == EGL_CONTEXT_LOST {
            // every GL object went with the context: a new one, and the
            // program opens its renderer again (r_gpu_lost)
            egl_drop_surface(x)
            let k: u32 = eglDestroyContext((*x).egl_d, (*x).egl_c)
            (*x).egl_c = 0
            (*x).gpu = false
            (*x).gpu_lost = true
        } else {
            // a surface that went bad (the window changed under it)
            egl_drop_surface(x)
        }
        return false
    }
    return true
}

// Where the content lies on the surface, and the surface's size:
// out[0..4] = ox, oy, surface width, surface height (u64 each).
fn r_gpu_place(x: *mut Platte, out: u64) {
    var w: usize = (*x).w
    var h: usize = (*x).h
    if (*x).egl_s != 0 {
        var v: [i32; 1] = [0]
        if eglQuerySurface((*x).egl_d, (*x).egl_s, EGL_WIDTH, (&v[0]) as u64) != 0 as u32 && v[0] > 0 {
            w = v[0] as usize
        }
        if eglQuerySurface((*x).egl_d, (*x).egl_s, EGL_HEIGHT, (&v[0]) as u64) != 0 as u32 && v[0] > 0 {
            h = v[0] as usize
        }
    }
    *(out as *mut u64) = (*x).ox as u64
    *((out + 8) as *mut u64) = (*x).oy as u64
    *((out + 16) as *mut u64) = w as u64
    *((out + 24) as *mut u64) = h as u64
}

// Was the context lost since the last `r_gpu_open`? (Then open again.)
fn r_gpu_lost(x: *mut Platte) -> bool {
    return (*x).gpu_lost
}

fn r_gpu_close(x: *mut Platte) {
    if (*x).egl_d == 0 {
        return
    }
    egl_drop_surface(x)
    if (*x).egl_c != 0 {
        let k: u32 = eglDestroyContext((*x).egl_d, (*x).egl_c)
        (*x).egl_c = 0
    }
    (*x).gpu = false
}

// OpenPlan LIB-006: the system clipboard is not connected on this backend
// yet (X11 has it; Windows follows with the Windows target, LIB-016).
// fUi falls back to its internal clipboard.
fn r_clip_set(x: *mut Platte, mime: str, p: u64, n: usize) -> bool {
    return false
}

fn r_clip_get(x: *mut Platte, mime: str, out: *mut rt.Buf) -> bool {
    return false
}

fn r_clip_types(x: *mut Platte, out: *mut rt.Buf) -> usize {
    return 0
}

fn r_clip_clear(x: *mut Platte) {
}

// OpenPlan LIB-005: no descriptor to wait on here -- window.wait_any asks
// the windows in turn.
fn r_event_fd(x: *mut Platte) -> i32 {
    return -1 as i32
}
