// lib/window/shellos.fi -- OS seam of the shell thread, stub twin: no wake object, no paint hook (docs/SHELL_THREAD.md). The Windows twin is shellos.windows.fi.
import window.window

export {
    os_available, os_event_new, os_wake, os_wait, os_hook, os_timer, os_set_size, os_hwnd,
}

fn os_available() -> bool {
    return false
}

fn os_event_new() -> u64 {
    return 0
}

fn os_wake(e: u64) {}

fn os_wait(e: u64, ms: i64) {
    var ts: [i64; 2] = [0; 2]
    var n: i64 = ms
    if n > 4 {
        n = 4
    }
    ts[0] = 0
    ts[1] = n * 1000000
    syscall(35, (&ts[0]) as i64, 0, 0, 0, 0, 0)
}

fn os_hook(f: *mut window.Window, h: fn(u64), ud: u64) {}

fn os_timer(f: *mut window.Window, ms: i64) -> bool {
    return false
}

fn os_set_size(f: *mut window.Window, w: usize, h: usize) -> bool {
    return window.resize(f, w, h)
}

fn os_hwnd(f: *mut window.Window) -> u64 {
    return 0
}
