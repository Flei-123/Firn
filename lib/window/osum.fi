// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/window/osum.fi, as of Certus commit 1f1ec17bdb68 (last
// changed in cbbc9d8c0475); released by the sole author Justin on 23.09.2026
// for Firn under MPL-2.0.
// lib/window/osum.fi -- THE FOURTH BACK END: OSUM/OrientOS.
// Round CERTUS-AUF-OSUM (05.09.2026).
//
// ====================================================== WHAT IT IS
//
// lib/window/window.fi has three back ends: X11 (Linux),
// win32 (Windows) and android. This is the fourth, and it lies
// under no foreign system: Osum is Justin's own
// operating system, and Certus runs on it as an ordinary
// ring-3 program.
//
// ============================== WHY IT PAINTS NOTHING ITSELF
//
// The first attempt (round CERTUS, 28.08.2026, `lib/certus/oswin.fi`
// in the Osum tree) spoke directly with the window server: WIG_BLIT,
// WM_TEXT, WM_FILL. That gave a window with a text line as
// control bar -- no address field, no buttons, nothing that you can
// grasp. Osum has had a widget library since round K15
// (`kernel/user/wlib.fi`), and the right answer is to use it
// instead of painting next to it:
//
//   * THE CONTROL BAR is made of REAL widgets -- `wlib.button` for
//     Back / Forward / Reload, `wlib.entry` for the address,
//     `wlib.tabs` for the tabs. They are drawn by wlib,
//     get from wlib their colour scheme (light/dark from /etc/theme)
//     and their focus, and this file paints not a single pixel
//     in this strip.
//   * THE PAGE stands in a CANVAS (`wlib.leinwand`, added to wlib in this
//     round): a widget whose pixels belong to the
//     caller. Certus paints, as everywhere, into its own
//     buffer; wlib pushes from it the section of every dirty
//     strip onto the screen.
//
// ================================= THE BAR AND CERTUS' OWN BAR
//
// Certus paints its control bar itself (browser.chrome, height
// `chrome.CHROME_H`) and lays the page underneath. This back end
// changes NOTHING about that -- it simply does not show the upper strip:
// the canvas begins in the buffer at row CHROME_H. What Certus
// paints in there is then dead colour in memory, and what the
// user sees are the wlib widgets at exactly the same place.
//
// AND THE BUTTONS WORK WITHOUT CERTUS KNOWING THEM. A press on
// the wlib button "Back" is translated here into exactly the event
// that Certus' own bar would have produced: a
// mouse click at the place at which `chrome.chrome_treffer`
// reports HIT_ZURUECK. The place is not typed, but LOOKED UP
// (`hit_x`) -- the same function with which Certus itself checks. Thereby
// the browser core needs not a single new line for this back end.
//
// The address field likewise: `Enter` in the wlib field yields a click on
// HIT_ADRESSE, then as many backspaces as an address can be
// long, then the characters, then Enter. That is the way that a
// keyboard also takes.
//
// ==================================================== THREE LIMITS
//
// G1 NO SYSTEM TEXT. `r_text` gives false. wlib sets text into its
//    own drawing surface (a strip of the screen) and not into
//    a foreign buffer; an `r_text` that paints into the canvas
//    would have to rebuild the rasteriser of wlibc. Certus does not call the
//    function (measured: `grep window.text` in
//    lib/browser/certus_app.fi is empty) -- it stands here as
//    an honest no and not as an empty success.
//
// G2 THE WINDOW SIZE IS FIXED. Osum's window server creates the
//    buffer when creating (`kernel/wm.fi`); an `r_maximise` to a
//    size other than the created one gives false. That is why
//    this back end also never sends EV_CONFIGURE.
//
// G3 LIGHT/DARK IS NOT REPORTED. wlib knows the colour scheme
//    (/etc/theme) and colours its widgets accordingly; a way to
//    query it belongs in wlib and not here. `r_dark_known`
//    therefore gives false -- Certus then takes LIGHT and knows that it is
//    guessed.
import std.rt
import brand.brand
import wlib
import wlibc
import ulib
import libc.kcall
import browser.chrome

export {
    r_notify, r_stay_alive, r_in_front,
    r_notify_at, r_notify_shown, r_notify_cancel,
    r_pick_image, r_pick_poll, r_pick_take, r_image_decode,
    r_clip_set, r_clip_get, r_clip_types, r_clip_clear, r_event_fd,
    // fUi tempo, stage 2b: THE GPU (only Android has it so far)
    r_gpu_open, r_gpu_swap, r_gpu_close, r_gpu_place, r_gpu_lost,
    r_dragging,
    r_input_hook, r_full_input,
    Platte, surface_new,
    r_open, r_make, r_show, r_title, r_close, r_is_open,
    r_width, r_height, r_dpi, r_maximise,
    r_image, r_fill, r_font, r_text, r_present, r_ppm,
    r_wait, r_pending, r_next, r_dark, r_dark_known, r_poison,
    r_input_pending,
    r_titlebar_dark, r_titlebar_colour,
    // ROUND C-049 -- the window frame of its own. Under OrientOS it does
    // NOT exist (see the reasoning at `r_frame_can`); the names
    // have to be there nevertheless, because lib/window/window.fi calls them.
    r_frame_can, r_frame_own, r_frame_height, r_button_zone,
    r_content_size,
    r_minimise, r_max_toggle, r_maximised, r_drag,
    r_sysmenu,
    r_screen, r_centre,
    // What the acceptance wants to measure: how often things were really moved.
    os_blits, os_widgets,
    r_update_start,
}

// The event numbers of lib/window/window.fi. They stand here once
// more, because a back end must NOT import the upper layer
// (it would import itself).
const EV_NONE: u32 = 0
const EV_EXPOSE: u32 = 1
const EV_KEY: u32 = 2
const EV_BUTTON: u32 = 3
const EV_CONFIGURE: u32 = 4
const EV_CLOSED: u32 = 5
const EV_CHAR: u32 = 6
const EV_MOTION: u32 = 7
const EV_THEME: u32 = 8

// The keys, X11 numbers (see window.fi).
const K_ESCAPE: u32 = 9
const K_BACK: u32 = 22
const K_TAB: u32 = 23
const K_RETURN: u32 = 36
const K_HOME: u32 = 110
const K_UP: u32 = 111
const K_PAGEUP: u32 = 112
const K_LEFT: u32 = 113
const K_RIGHT: u32 = 114
const K_END: u32 = 115
const K_DOWN: u32 = 116
const K_PAGEDOWN: u32 = 117
const K_DELETE: u32 = 119

const KN_LEFT: u32 = 1

// mmap: read and write, private and without a file.
const PROT_RW: u64 = 3
const MAP_ANON_PRIV: u64 = 34

// The queue of the translated events. It is large, because setting
// an address from the text field produces a whole sequence:
// a click, up to 512 backspaces, the characters, Enter.
const QN: usize = 1024
const ADR_MAX: usize = 512

struct Platte {
    // The wlib window, 0xFFFFFFFFFFFFFFFF = none.
    win: u64,
    open: bool,
    w: usize,
    h: usize,
    // The pixels of the page: ONE buffer over the whole window
    // height, w * h * 4 octets, BGRX. The canvas shows from it everything
    // from row CHROME_H.
    px: u64,
    px_n: usize,
    // die Widgets
    lw: u64,
    b_back: u64,
    b_vor: u64,
    b_neu: u64,
    e_adr: u64,
    // die gesuchten Trefferstellen in Certus' eigener Leiste
    x_back: usize,
    x_vor: usize,
    x_neu: usize,
    x_address: usize,
    // die Schlange
    q_kind: [u32; 1024],
    q_a: [u32; 1024],
    q_x: [u32; 1024],
    q_y: [u32; 1024],
    q_s: [u32; 1024],
    q_head: usize,
    q_tail: usize,
    // Messwerte
    blits: u64,
    gift: bool,
}

// The buffer behind the address field. It is `static mut` and not part
// of the plate, because wlib.entry takes a pointer to a buffer that
// outlives the window.
static mut adr_buf: [u8; 512] = [0 as u8; 512]
// ROUND MARKE: title and application name came until here from two
// literals; now from lib/brand/brand.fi (PRODUKT or KURZ).
static mut t_zur: [u8; 4] = "<\0\0\0"
static mut t_vor: [u8; 4] = ">\0\0\0"
static mut t_neu: [u8; 8] = "Neu\0\0\0\0\0"
static mut t_tabs: [u8; 12] = "Seite 1\0\0\0\0\0"
static mut ev_puf: [u64; 4] = [0 as u64; 4]

fn surface_new() -> Platte {
    return Platte { win: 0xFFFFFFFFFFFFFFFF, open: false, w: 0, h: 0,
        px: 0, px_n: 0, lw: 0xFFFFFFFFFFFFFFFF,
        b_back: 0xFFFFFFFFFFFFFFFF, b_vor: 0xFFFFFFFFFFFFFFFF,
        b_neu: 0xFFFFFFFFFFFFFFFF, e_adr: 0xFFFFFFFFFFFFFFFF,
        x_back: 0, x_vor: 0, x_neu: 0, x_address: 0,
        q_kind: [0 as u32; 1024], q_a: [0 as u32; 1024],
        q_x: [0 as u32; 1024], q_y: [0 as u32; 1024],
        q_s: [0 as u32; 1024], q_head: 0, q_tail: 0, blits: 0,
        gift: false }
}

// ------------------------------------------------------- die Schlange

fn q_push(x: *mut Platte, k: u32, a: u32, ex: u32, ey: u32, s: u32) {
    let n: usize = ((*x).q_head + 1) % QN
    if n == (*x).q_tail {
        // Full: the oldest drops out. A browser that loses the last
        // click would be worse than one that loses the first
        // mouse movement.
        (*x).q_tail = ((*x).q_tail + 1) % QN
    }
    (*x).q_kind[(*x).q_head] = k
    (*x).q_a[(*x).q_head] = a
    (*x).q_x[(*x).q_head] = ex
    (*x).q_y[(*x).q_head] = ey
    (*x).q_s[(*x).q_head] = s
    (*x).q_head = n
}

fn q_empty(x: *mut Platte) -> bool {
    return (*x).q_head == (*x).q_tail
}

// -------------------------------------------------------- aufmachen

fn r_open(x: *mut Platte, disp: usize) -> bool {
    // `anzeige` is the X11 display number and has no
    // counterpart here; it is not looked at (see window.fi).
    let _a: usize = disp
    if !wlib.begin(false, false) {
        return false
    }
    (*x).open = true
    return true
}

fn r_is_open(x: *mut Platte) -> bool {
    return (*x).open && (*x).win != 0xFFFFFFFFFFFFFFFF
}

fn r_width(x: *mut Platte) -> usize {
    return (*x).w
}

fn r_height(x: *mut Platte) -> usize {
    return (*x).h
}

// Osum's window server calculates in logical points at 96 dpi; the
// scaling lies with it (`wlibc.px_ui`) and not with the program.
fn r_dpi(x: *mut Platte) -> usize {
    let _p: *mut Platte = x
    return 96
}

// WHERE CERTUS HAS ITS OWN BUTTONS. Not typed, but looked up:
// `chrome.chrome_treffer` is the same function with which Certus evaluates a
// click on its bar. If the bar changes, these numbers change
// with it.
fn hit_x(vw: usize, was: u32) -> usize {
    let y: usize = chrome.CHROME_H / 2
    var i: usize = 0
    while i < vw {
        if chrome.chrome_hit(vw, i, y) == was {
            return i
        }
        i = i + 2
    }
    return 0
}

fn r_make(x: *mut Platte, w: usize, h: usize) -> bool {
    if w == 0 || h <= chrome.CHROME_H {
        return false
    }
    let n: usize = w * h * 4
    let p: u64 = kcall.map_anon(n as u64, PROT_RW, MAP_ANON_PRIV)
    if p == 0 || p > 0xFFFFFFFFFFFF0000 {
        return false
    }
    (*x).px = p
    (*x).px_n = n
    (*x).w = w
    (*x).h = h
    if (*x).gift {
        poison_fill(x)
    }

    let win: u64 = wlib.window(0, 0, w as u64, h as u64,
        brand.produkt())
    if win >= wlib.MAXWN {
        return false
    }
    (*x).win = win
    let _ap: u64 = wlib.window_app(win, brand.short())

    // 1. THE CONTROL BAR: three buttons and the address field, in a
    //    horizontal box of exactly the height that Certus' own
    //    bar would have. With that it covers the strip that the
    //    canvas does not show -- without a single calculated
    //    number of pixels.
    let ch: u64 = chrome.CHROME_H as u64
    wlib.box_h(win, 4, 2, (w as u64) - 8, ch - 4, 0, 4)
    wlib.size(28, ch - 8)
    (*x).b_back = wlib.button((&t_zur[0]) as u64)
    wlib.size(28, ch - 8)
    (*x).b_vor = wlib.button((&t_vor[0]) as u64)
    wlib.size(44, ch - 8)
    (*x).b_neu = wlib.button((&t_neu[0]) as u64)
    wlib.size(0, ch - 8)
    (*x).e_adr = wlib.entry((&adr_buf[0]) as u64, (ADR_MAX - 2) as u64)
    wlib.box_end()

    // 2. THE CANVAS: everything below the bar. It shows the
    //    buffer from row CHROME_H -- the row length stays `w`,
    //    so the coordinates of the painter are right without conversion.
    let below: u64 = (h - chrome.CHROME_H) as u64
    wlib.box_v(win, 0, ch, w as u64, below, 0, 0)
    wlib.size(w as u64, below)
    (*x).lw = wlib.canvas(p + ((chrome.CHROME_H * w * 4) as u64),
        w as u64, below)
    wlib.box_end()

    (*x).x_back = hit_x(w, chrome.HIT_BACK)
    (*x).x_vor = hit_x(w, chrome.HIT_VOR)
    (*x).x_neu = hit_x(w, chrome.HIT_NEU)
    (*x).x_address = hit_x(w, chrome.HIT_ADDRESS)
    return true
}

fn r_show(x: *mut Platte) -> bool {
    if !r_is_open(x) {
        return false
    }
    wlib.draw_all()
    return true
}

fn r_title(x: *mut Platte, p: u64, n: usize) -> bool {
    // The title stands in the window bar of the server and is set when
    // creating; wlib has no way to change it afterwards.
    let _p: u64 = p
    let _n: usize = n
    return r_is_open(x)
}

fn r_close(x: *mut Platte) {
    if (*x).win != 0xFFFFFFFFFFFFFFFF {
        wlib.close((*x).win)
        (*x).win = 0xFFFFFFFFFFFFFFFF
    }
    (*x).open = false
}

fn r_screen(x: *mut Platte, sw: *mut usize, sh: *mut usize) -> bool {
    let _p: *mut Platte = x
    *sw = wlibc.screen_w() as usize
    *sh = wlibc.screen_h() as usize
    return *sw > 0 && *sh > 0
}

// The window server places a new window itself; it is thereby already
// centred (`kernel/wm.fi`).
fn r_centre(x: *mut Platte) -> bool {
    return r_is_open(x)
}

// G2: the buffer of the server is fixed since creation.
fn r_maximise(x: *mut Platte, w: usize, h: usize) -> bool {
    return w == (*x).w && h == (*x).h
}

fn r_dragging(x: *mut Platte) -> bool {
    let _p: *mut Platte = x
    return false
}

// ----------------------------------------------------------- the painting

fn poison_fill(x: *mut Platte) {
    var i: usize = 0
    let n: usize = (*x).w * (*x).h
    while i < n {
        *(((*x).px + (i * 4) as u64) as *mut u32) = 16711935 as u32
        i = i + 1
    }
}

// OSUM reports inputs to nobody (it never had an input
// priority). The name has to be there nevertheless, because window.fi calls it;
// the hook is not called, and that stands here, instead of being silent.
// Release/enter/leave (window.full_input) this back end does
// NOT YET deliver -- honestly `false`, so that the host knows it, instead of waiting for
// events that never come.
fn r_full_input(x: *mut Platte, an: bool) -> bool {
    return false
}

fn r_input_hook(x: *mut Platte, h: fn(u64), ud: u64) {
}

fn r_poison(x: *mut Platte, an: bool) {
    (*x).gift = an
    if an && (*x).px != 0 {
        poison_fill(x)
    }
}

fn r_image(x: *mut Platte, px: u64, w: usize, h: usize, dx: usize,
    dy: usize) -> bool {
    if (*x).px == 0 {
        return false
    }
    var y: usize = 0
    while y < h {
        let zy: usize = dy + y
        if zy >= (*x).h {
            return true
        }
        var i: usize = 0
        let q: u64 = px + ((y * w) * 4) as u64
        let z: u64 = (*x).px + (((zy * (*x).w) + dx) * 4) as u64
        while i < w && dx + i < (*x).w {
            *((z + (i * 4) as u64) as *mut u32) =
            *((q + (i * 4) as u64) as *mut u32)
            i = i + 1
        }
        y = y + 1
    }
    return true
}

fn r_fill(x: *mut Platte, color: u32, x0: usize, y0: usize, w: usize,
    h: usize) -> bool {
    if (*x).px == 0 {
        return false
    }
    let f: u32 = color & 16777215 as u32
    var y: usize = 0
    while y < h && y0 + y < (*x).h {
        let z: u64 = (*x).px + ((((y0 + y) * (*x).w) + x0) * 4) as u64
        var i: usize = 0
        while i < w && x0 + i < (*x).w {
            *((z + (i * 4) as u64) as *mut u32) = f
            i = i + 1
        }
        y = y + 1
    }
    return true
}

// G1: see the head of this file.
fn r_font(x: *mut Platte) -> bool {
    return r_is_open(x)
}

fn r_text(x: *mut Platte, fg: u32, bg: u32, tx: usize, ty: usize, p: u64,
    n: usize) -> bool {
    let _a: *mut Platte = x
    let _b: u32 = fg
    let _c: u32 = bg
    let _d: usize = tx
    let _e: usize = ty
    let _f: u64 = p
    let _g: usize = n
    return false
}

fn r_present(x: *mut Platte) -> bool {
    if !r_is_open(x) {
        return false
    }
    wlib.canvas_new((*x).lw)
    let _id: u64 = wlib.step()
    (*x).blits = (*x).blits + 1
    return true
}

fn os_blits(x: *mut Platte) -> u64 {
    return (*x).blits
}

fn os_widgets() -> u64 {
    return wlib.counts()
}

// THE CAPTURE. What comes out here is the buffer of the canvas --
// so what the user sees below the bar, pixel for
// pixel. The bar itself does not stand in it: it belongs to wlib,
// and a capture OF THAT comes from QEMU's `screendump` (tools/certus/run.sh).
fn r_ppm(x: *mut Platte, path: u64) -> bool {
    if (*x).px == 0 {
        return false
    }
    let w: usize = (*x).w
    let h: usize = (*x).h
    var header: rt.Buf = rt.buf_new()
    var p6: [u8; 4] = "P6\n\0"
    rt.buf_push_bytes(&header, (&p6[0]) as u64, 3)
    number_an(&header, w)
    rt.buf_push(&header, 32 as u8)
    number_an(&header, h)
    var s255: [u8; 6] = "\n255\n\0"
    rt.buf_push_bytes(&header, (&s255[0]) as u64, 5)
    var out: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.buf_len(&header) {
        rt.buf_push(&out, rt.buf_at(&header, k))
        k = k + 1
    }
    var i: usize = 0
    while i < w * h {
        let v: u32 = *(((*x).px + (i * 4) as u64) as *mut u32)
        rt.buf_push(&out, ((v >> 16) & 255 as u32) as u8)
        rt.buf_push(&out, ((v >> 8) & 255 as u32) as u8)
        rt.buf_push(&out, (v & 255 as u32) as u8)
        i = i + 1
    }
    let ok: bool = rt.write_file(path, rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
    rt.buf_free(&header)
    return ok
}

fn number_an(b: *mut rt.Buf, n: usize) {
    if n >= 10 {
        number_an(b, n / 10)
    }
    rt.buf_push(b, (48 + (n % 10)) as u8)
}

// ------------------------------------------------------- die Ereignisse

// The keys that wlib reports (`wlib.KEY_*` or an octet), into the
// numbers of window.fi.
fn taste_um(k: u64) -> u32 {
    if k == wlib.KEY_ENTER {
        return K_RETURN
    }
    if k == wlib.KEY_BS {
        return K_BACK
    }
    if k == wlib.KEY_ESC {
        return K_ESCAPE
    }
    if k == wlib.KEY_TAB {
        return K_TAB
    }
    if k == wlib.KEY_UP {
        return K_UP
    }
    if k == wlib.KEY_DOWN {
        return K_DOWN
    }
    if k == wlib.KEY_LEFT {
        return K_LEFT
    }
    if k == wlib.KEY_RIGHT {
        return K_RIGHT
    }
    if k == wlib.KEY_HOME {
        return K_HOME
    }
    if k == wlib.KEY_END {
        return K_END
    }
    if k == wlib.KEY_PGUP {
        return K_PAGEUP
    }
    if k == wlib.KEY_PGDN {
        return K_PAGEDOWN
    }
    if k == wlib.KEY_DEL {
        return K_DELETE
    }
    return 0
}

// A CLICK, AS CERTUS' OWN BAR WOULD HAVE PRODUCED IT.
fn click_bar(x: *mut Platte, kx: usize) {
    q_push(x, EV_BUTTON, KN_LEFT, kx as u32,
        (chrome.CHROME_H / 2) as u32, 0)
}

// THE ADDRESS FIELD. Certus appends characters to its address and
// deletes with the backspace key -- there is no "replace everything". So
// exactly what a human would type is typed here.
fn address_take(x: *mut Platte) {
    click_bar(x, (*x).x_address)
    var i: usize = 0
    while i < ADR_MAX {
        q_push(x, EV_KEY, K_BACK, 0, 0, 0)
        i = i + 1
    }
    let p: u64 = wlib.text_of((*x).e_adr)
    var k: usize = 0
    while k < ADR_MAX {
        let c: u8 = *((p + k as u64) as *mut u8)
        if c == 0 as u8 {
            k = ADR_MAX
        } else {
            // Octet by octet: what Certus gets as EV_CHAR,
            // it puts back together itself into UTF-8, and for
            // characters below 128 that is the same octet.
            q_push(x, EV_CHAR, c as u32, 0, 0, 0)
            k = k + 1
        }
    }
    q_push(x, EV_KEY, K_RETURN, 0, 0, 0)
}

// RUN WLIB ONCE and translate everything that arises in doing so into the
// queue.
fn pumpe(x: *mut Platte) {
    if !r_is_open(x) {
        return
    }
    let id: u64 = wlib.step()
    if id < wlib.MAXWD {
        let art: u64 = wlib.fired_kind()
        if art == wlib.K_BUTTON {
            if id == (*x).b_back {
                click_bar(x, (*x).x_back)
            } else if id == (*x).b_vor {
                click_bar(x, (*x).x_vor)
            } else if id == (*x).b_neu {
                click_bar(x, (*x).x_neu)
            }
        } else if art == wlib.K_ENTRY {
            if id == (*x).e_adr {
                address_take(x)
            }
        }
    }
    let b: u64 = (&ev_puf[0]) as u64
    while wlib.canvas_event(b) {
        let wid: u64 = *((b) as *mut u64)
        let sorte: u64 = *((b + 8) as *mut u64)
        let a: u64 = *((b + 16) as *mut u64)
        let btn: u64 = *((b + 24) as *mut u64)
        if wid == (*x).lw {
            // The position stands IN THE WIDGET; Certus calculates in the whole
            // window, so the bar height is added back.
            let ex: u32 = ((a >> 16) & 0xFFFF) as u32
            let ey: u32 = ((a & 0xFFFF) + (chrome.CHROME_H as u64)) as u32
            if sorte == wlib.LE_DOWN {
                var knopf: u32 = KN_LEFT
                if btn == 2 {
                    knopf = 3 as u32
                }
                q_push(x, EV_BUTTON, knopf, ex, ey, 0)
            } else if sorte == wlib.LE_MOVE {
                q_push(x, EV_MOTION, 0, ex, ey, 0)
            } else if sorte == wlib.LE_KEY {
                let t: u32 = taste_um(a)
                if t != 0 as u32 {
                    q_push(x, EV_KEY, t, 0, 0, 0)
                } else if a >= 32 && a < 127 {
                    q_push(x, EV_CHAR, a as u32, 0, 0, 0)
                }
            }
        }
    }
    if !wlib.alive() || wlib.closed((*x).win) {
        q_push(x, EV_CLOSED, 0, 0, 0, 0)
        (*x).open = false
    }
}

fn r_pending(x: *mut Platte) -> bool {
    if q_empty(x) {
        pumpe(x)
    }
    return !q_empty(x)
}

// ROUND C-040 -- IS AN INPUT IN THE QUEUE?
//
// The same contract as in lib/window/x11.fi and lib/window/win32.fi:
// only look, take nothing out, and count only that behind which
// a human stands (key, character, button) -- a pointer movement
// not.
fn r_input_pending(x: *mut Platte) -> bool {
    var i: usize = (*x).q_tail
    while i != (*x).q_head {
        let k: u32 = (*x).q_kind[i]
        if k == EV_KEY || k == EV_CHAR || k == EV_BUTTON {
            return true
        }
        i = (i + 1) % QN
    }
    return false
}

// WAITING. Osum's window server has no descriptor that one could
// wait on (`WM_EVENT` fetches and returns at once) --
// the same limit as in round CERTUS. So: ask, give up the
// processor, ask again. `wlib.step` gives up by itself if
// nothing arose; the time is measured on the clock of the system and
// not guessed in rounds.
fn r_wait(x: *mut Platte, ms: i64) -> bool {
    if r_pending(x) {
        return true
    }
    if ms == 0 {
        return false
    }
    let start: u64 = now_ms()
    var rounds: u64 = 0
    while true {
        pumpe(x)
        if !q_empty(x) {
            return true
        }
        rounds = rounds + 1
        if ms > 0 {
            if now_ms() - start >= (ms as u64) {
                return false
            }
        }
        if !(*x).open {
            return !q_empty(x)
        }
    }
    return false
}

static mut ts: [i64; 2] = [0 as i64; 2]

fn now_ms() -> u64 {
    // clock_gettime(CLOCK_MONOTONIC=1). Osum's numbers are those of
    // Linux (round K4).
    let _r: u64 = kcall.sys2(kcall.SYS_CLOCK_GETTIME, 1,
        (&ts[0]) as u64)
    return (ts[0] as u64) * 1000 + (ts[1] as u64) / 1000000
}

fn r_next(x: *mut Platte, k: *mut u32, a: *mut u32, ox: *mut u32,
    oy: *mut u32, s: *mut u32) -> bool {
    if q_empty(x) {
        pumpe(x)
    }
    if q_empty(x) {
        return false
    }
    let t: usize = (*x).q_tail
    *k = (*x).q_kind[t]
    *a = (*x).q_a[t]
    *ox = (*x).q_x[t]
    *oy = (*x).q_y[t]
    *s = (*x).q_s[t]
    (*x).q_tail = (t + 1) % QN
    return true
}

