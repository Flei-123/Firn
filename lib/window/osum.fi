// SPDX-License-Identifier: MPL-2.0
// Herkunft: Certus, lib/window/osum.fi, Stand Certus-Commit 1f1ec17bdb68 (zuletzt
// geaendert in cbbc9d8c0475); vom alleinigen Urheber Justin am 23.09.2026
// fuer Firn unter MPL-2.0 freigegeben.
// lib/window/osum.fi -- DIE VIERTE RUECKWAND: OSUM/OrientOS.
// Runde CERTUS-AUF-OSUM (05.09.2026).
//
// ====================================================== WAS SIE IST
//
// lib/window/window.fi hat drei Rueckwaende: X11 (Linux),
// win32 (Windows) und android. Diese ist die vierte, und sie liegt
// unter keinem fremden System: Osum ist Justins eigenes
// Betriebssystem, und Certus laeuft darauf als gewoehnliches
// Ring-3-Programm.
//
// ============================== WARUM SIE NICHTS SELBST MALT
//
// Der erste Versuch (Runde CERTUS, 28.08.2026, `lib/certus/oswin.fi`
// im Osum-Baum) sprach direkt mit dem Fensterserver: WIG_BLIT,
// WM_TEXT, WM_FILL. Das ergab ein Fenster mit einer Textzeile als
// Bedienleiste -- kein Adressfeld, keine Knoepfe, nichts, was man
// anfassen kann. Osum hat seit Runde K15 eine Widget-Bibliothek
// (`kernel/user/wlib.fi`), und die richtige Antwort ist, sie zu
// benutzen statt neben ihr zu malen:
//
//   * DIE BEDIENLEISTE sind ECHTE Widgets -- `wlib.button` fuer
//     Zurueck / Vor / Neu laden, `wlib.entry` fuer die Adresse,
//     `wlib.tabs` fuer die Reiter. Sie werden von wlib gezeichnet,
//     bekommen von wlib ihr Farbschema (hell/dunkel aus /etc/theme)
//     und ihren Fokus, und diese Datei malt in diesem Streifen keinen
//     einzigen Bildpunkt.
//   * DIE SEITE steht in einer LEINWAND (`wlib.leinwand`, in dieser
//     Runde zu wlib dazugekommen): einem Widget, dessen Bildpunkte dem
//     Aufrufer gehoeren. Certus malt wie ueberall in seinen eigenen
//     Puffer; wlib schiebt daraus den Ausschnitt jedes schmutzigen
//     Streifens auf den Schirm.
//
// ================================= DIE LEISTE UND CERTUS' EIGENE LEISTE
//
// Certus malt seine Bedienleiste selbst (browser.chrome, Hoehe
// `chrome.CHROME_H`) und legt die Seite darunter. Diese Rueckwand
// aendert daran NICHTS -- sie zeigt den oberen Streifen einfach nicht
// an: die Leinwand beginnt im Puffer bei Zeile CHROME_H. Was Certus
// dort hinein malt, ist dann tote Farbe im Speicher, und was der
// Nutzer sieht, sind die wlib-Widgets an genau derselben Stelle.
//
// UND DIE KNOEPFE WIRKEN, OHNE DASS CERTUS SIE KENNT. Ein Druck auf
// den wlib-Knopf "Zurueck" wird hier in genau das Ereignis
// uebersetzt, das Certus' eigene Leiste erzeugt haette: einen
// Mausklick an die Stelle, an der `chrome.chrome_treffer`
// HIT_ZURUECK meldet. Die Stelle wird nicht getippt, sondern GESUCHT
// (`hit_x`) -- dieselbe Funktion, mit der Certus selbst prueft. Damit
// braucht der Browserkern fuer diese Rueckwand keine einzige neue
// Zeile.
//
// Das Adressfeld ebenso: `Enter` im wlib-Feld ergibt einen Klick auf
// HIT_ADRESSE, dann so viele Ruecktasten, wie eine Adresse lang sein
// kann, dann die Zeichen, dann Enter. Das ist der Weg, den eine
// Tastatur auch nimmt.
//
// ==================================================== DREI GRENZEN
//
// G1 KEIN SYSTEMTEXT. `r_text` gibt false. wlib setzt Text in seine
//    eigene Zeichenflaeche (einen Streifen des Schirms) und nicht in
//    einen fremden Puffer; ein `r_text`, das in die Leinwand malt,
//    muesste den Rasterer von wlibc nachbauen. Certus ruft die
//    Funktion nicht (gemessen: `grep window.text` in
//    lib/browser/certus_app.fi ist leer) -- es steht hier als
//    ehrliches Nein und nicht als leerer Erfolg.
//
// G2 DIE FENSTERGROESSE STEHT FEST. Osums Fensterserver legt den
//    Puffer beim Anlegen an (`kernel/wm.fi`); ein `r_maximise` auf eine
//    andere Groesse als die angelegte gibt false. Deshalb schickt
//    diese Rueckwand auch nie EV_CONFIGURE.
//
// G3 HELL/DUNKEL WIRD NICHT GEMELDET. wlib kennt das Farbschema
//    (/etc/theme) und faerbt seine Widgets danach; ein Weg, es
//    abzufragen, gehoert in wlib und nicht hierher. `r_dark_known`
//    gibt darum false -- Certus nimmt dann HELL und weiss, dass es
//    geraten ist.
import std.rt
import brand.brand
import wlib
import wlibc
import ulib
import libc.kcall
import browser.chrome

export {
    r_dragging,
    r_input_hook, r_full_input,
    Platte, surface_new,
    r_open, r_make, r_show, r_title, r_close, r_is_open,
    r_width, r_height, r_dpi, r_maximise,
    r_image, r_fill, r_font, r_text, r_present, r_ppm,
    r_wait, r_pending, r_next, r_dark, r_dark_known, r_poison,
    r_input_pending,
    r_titlebar_dark, r_titlebar_colour,
    // RUNDE C-049 -- der eigene Fensterrahmen. Unter OrientOS gibt es
    // ihn NICHT (siehe die Begruendung bei `r_frame_can`); die Namen
    // muessen trotzdem da sein, weil lib/window/window.fi sie ruft.
    r_frame_can, r_frame_own, r_frame_height, r_button_zone,
    r_content_size,
    r_minimise, r_max_toggle, r_maximised, r_drag,
    r_sysmenu,
    r_screen, r_centre,
    // Was die Abnahme messen will: wie oft wirklich geschoben wurde.
    os_blits, os_widgets,
    r_update_start,
}

// Die Ereignisnummern von lib/window/window.fi. Sie stehen hier noch
// einmal, weil eine Rueckwand die obere Schicht NICHT importieren darf
// (sie wuerde sich selbst importieren).
const EV_NONE: u32 = 0
const EV_EXPOSE: u32 = 1
const EV_KEY: u32 = 2
const EV_BUTTON: u32 = 3
const EV_CONFIGURE: u32 = 4
const EV_CLOSED: u32 = 5
const EV_CHAR: u32 = 6
const EV_MOTION: u32 = 7
const EV_THEME: u32 = 8

// Die Tasten, X11-Nummern (siehe window.fi).
const K_ESCAPE: u32 = 9
const K_BACK: u32 = 22
const K_TAB: u32 = 23
const K_RETURN: u32 = 36
const K_HOME: u32 = 110
const K_UP: u32 = 111
const K_PAGEUP: u32 = 112
const K_LEFT: u32 = 113
const K_RIGHT: u32 = 114
const K_END: u32 = 115
const K_DOWN: u32 = 116
const K_PAGEDOWN: u32 = 117
const K_DELETE: u32 = 119

const KN_LINKS: u32 = 1

// mmap: lesen und schreiben, privat und ohne Datei.
const PROT_RW: u64 = 3
const MAP_ANON_PRIV: u64 = 34

// Die Schlange der uebersetzten Ereignisse. Sie ist gross, weil das
// Setzen einer Adresse aus dem Textfeld eine ganze Folge erzeugt:
// ein Klick, bis zu 512 Ruecktasten, die Zeichen, Enter.
const QN: usize = 1024
const ADR_MAX: usize = 512

struct Platte {
    // Das wlib-Fenster, 0xFFFFFFFFFFFFFFFF = keins.
    win: u64,
    offen: bool,
    w: usize,
    h: usize,
    // Die Bildpunkte der Seite: EIN Puffer ueber die ganze Fenster-
    // hoehe, w * h * 4 Oktette, BGRX. Die Leinwand zeigt daraus alles
    // ab Zeile CHROME_H.
    px: u64,
    px_n: usize,
    // die Widgets
    lw: u64,
    b_zurueck: u64,
    b_vor: u64,
    b_neu: u64,
    e_adr: u64,
    // die gesuchten Trefferstellen in Certus' eigener Leiste
    x_zurueck: usize,
    x_vor: usize,
    x_neu: usize,
    x_adresse: usize,
    // die Schlange
    q_kind: [u32; 1024],
    q_a: [u32; 1024],
    q_x: [u32; 1024],
    q_y: [u32; 1024],
    q_s: [u32; 1024],
    q_head: usize,
    q_tail: usize,
    // Messwerte
    blits: u64,
    gift: bool,
}

// Der Puffer hinter dem Adressfeld. Er ist `static mut` und nicht Teil
// der Platte, weil wlib.entry einen Zeiger auf einen Puffer nimmt, der
// das Fenster ueberlebt.
static mut adr_buf: [u8; 512] = [0 as u8; 512]
// RUNDE MARKE: Titel und Anwendungsname kamen bis hierher aus zwei
// Literalen; jetzt aus lib/brand/brand.fi (PRODUKT bzw. KURZ).
static mut t_zur: [u8; 4] = "<\0\0\0"
static mut t_vor: [u8; 4] = ">\0\0\0"
static mut t_neu: [u8; 8] = "Neu\0\0\0\0\0"
static mut t_tabs: [u8; 12] = "Seite 1\0\0\0\0\0"
static mut ev_puf: [u64; 4] = [0 as u64; 4]

fn surface_new() -> Platte {
    return Platte { win: 0xFFFFFFFFFFFFFFFF, offen: false, w: 0, h: 0,
        px: 0, px_n: 0, lw: 0xFFFFFFFFFFFFFFFF,
        b_zurueck: 0xFFFFFFFFFFFFFFFF, b_vor: 0xFFFFFFFFFFFFFFFF,
        b_neu: 0xFFFFFFFFFFFFFFFF, e_adr: 0xFFFFFFFFFFFFFFFF,
        x_zurueck: 0, x_vor: 0, x_neu: 0, x_adresse: 0,
        q_kind: [0 as u32; 1024], q_a: [0 as u32; 1024],
        q_x: [0 as u32; 1024], q_y: [0 as u32; 1024],
        q_s: [0 as u32; 1024], q_head: 0, q_tail: 0, blits: 0,
        gift: false }
}

// ------------------------------------------------------- die Schlange

fn q_push(x: *mut Platte, k: u32, a: u32, ex: u32, ey: u32, s: u32) {
    let n: usize = ((*x).q_head + 1) % QN
    if n == (*x).q_tail {
        // Voll: das aelteste faellt weg. Ein Browser, der den letzten
        // Klick verliert, waere schlimmer als einer, der die erste
        // Mausbewegung verliert.
        (*x).q_tail = ((*x).q_tail + 1) % QN
    }
    (*x).q_kind[(*x).q_head] = k
    (*x).q_a[(*x).q_head] = a
    (*x).q_x[(*x).q_head] = ex
    (*x).q_y[(*x).q_head] = ey
    (*x).q_s[(*x).q_head] = s
    (*x).q_head = n
}

fn q_leer(x: *mut Platte) -> bool {
    return (*x).q_head == (*x).q_tail
}

// -------------------------------------------------------- aufmachen

fn r_open(x: *mut Platte, anzeige: usize) -> bool {
    // `anzeige` ist die X11-Anzeigenummer und hat hier keine
    // Entsprechung; sie wird nicht angesehen (siehe window.fi).
    let _a: usize = anzeige
    if !wlib.begin(false, false) {
        return false
    }
    (*x).offen = true
    return true
}

fn r_is_open(x: *mut Platte) -> bool {
    return (*x).offen && (*x).win != 0xFFFFFFFFFFFFFFFF
}

fn r_width(x: *mut Platte) -> usize {
    return (*x).w
}

fn r_height(x: *mut Platte) -> usize {
    return (*x).h
}

// Osums Fensterserver rechnet in logischen Punkten zu 96 dpi; die
// Skalierung liegt bei ihm (`wlibc.px_ui`) und nicht beim Programm.
fn r_dpi(x: *mut Platte) -> usize {
    let _p: *mut Platte = x
    return 96
}

// WO CERTUS SEINE EIGENEN KNOEPFE HAT. Nicht getippt, sondern gesucht:
// `chrome.chrome_treffer` ist dieselbe Funktion, mit der Certus einen
// Klick auf seine Leiste auswertet. Aendert sich die Leiste, aendern
// sich diese Zahlen mit.
fn hit_x(vw: usize, was: u32) -> usize {
    let y: usize = chrome.CHROME_H / 2
    var i: usize = 0
    while i < vw {
        if chrome.chrome_treffer(vw, i, y) == was {
            return i
        }
        i = i + 2
    }
    return 0
}

fn r_make(x: *mut Platte, w: usize, h: usize) -> bool {
    if w == 0 || h <= chrome.CHROME_H {
        return false
    }
    let n: usize = w * h * 4
    let p: u64 = kcall.map_anon(n as u64, PROT_RW, MAP_ANON_PRIV)
    if p == 0 || p > 0xFFFFFFFFFFFF0000 {
        return false
    }
    (*x).px = p
    (*x).px_n = n
    (*x).w = w
    (*x).h = h
    if (*x).gift {
        gift_fuellen(x)
    }

    let win: u64 = wlib.window(0, 0, w as u64, h as u64,
        brand.produkt())
    if win >= wlib.MAXWN {
        return false
    }
    (*x).win = win
    let _ap: u64 = wlib.window_app(win, brand.kurz())

    // 1. DIE BEDIENLEISTE: drei Knoepfe und das Adressfeld, in einem
    //    waagerechten Kasten von genau der Hoehe, die Certus' eigene
    //    Leiste haette. Damit deckt sie den Streifen ab, den die
    //    Leinwand nicht zeigt -- ohne eine einzige gerechnete
    //    Bildpunktzahl.
    let ch: u64 = chrome.CHROME_H as u64
    wlib.box_h(win, 4, 2, (w as u64) - 8, ch - 4, 0, 4)
    wlib.size(28, ch - 8)
    (*x).b_zurueck = wlib.button((&t_zur[0]) as u64)
    wlib.size(28, ch - 8)
    (*x).b_vor = wlib.button((&t_vor[0]) as u64)
    wlib.size(44, ch - 8)
    (*x).b_neu = wlib.button((&t_neu[0]) as u64)
    wlib.size(0, ch - 8)
    (*x).e_adr = wlib.entry((&adr_buf[0]) as u64, (ADR_MAX - 2) as u64)
    wlib.box_end()

    // 2. DIE LEINWAND: alles unterhalb der Leiste. Sie zeigt den
    //    Puffer ab Zeile CHROME_H -- die Zeilenlaenge bleibt `w`,
    //    also stimmen die Koordinaten des Malers ohne Umrechnung.
    let unten: u64 = (h - chrome.CHROME_H) as u64
    wlib.box_v(win, 0, ch, w as u64, unten, 0, 0)
    wlib.size(w as u64, unten)
    (*x).lw = wlib.leinwand(p + ((chrome.CHROME_H * w * 4) as u64),
        w as u64, unten)
    wlib.box_end()

    (*x).x_zurueck = hit_x(w, chrome.HIT_ZURUECK)
    (*x).x_vor = hit_x(w, chrome.HIT_VOR)
    (*x).x_neu = hit_x(w, chrome.HIT_NEU)
    (*x).x_adresse = hit_x(w, chrome.HIT_ADRESSE)
    return true
}

fn r_show(x: *mut Platte) -> bool {
    if !r_is_open(x) {
        return false
    }
    wlib.draw_all()
    return true
}

fn r_title(x: *mut Platte, p: u64, n: usize) -> bool {
    // Der Titel steht in der Fensterleiste des Servers und wird beim
    // Anlegen gesetzt; wlib hat keinen Weg, ihn danach zu aendern.
    let _p: u64 = p
    let _n: usize = n
    return r_is_open(x)
}

fn r_close(x: *mut Platte) {
    if (*x).win != 0xFFFFFFFFFFFFFFFF {
        wlib.close((*x).win)
        (*x).win = 0xFFFFFFFFFFFFFFFF
    }
    (*x).offen = false
}

fn r_screen(x: *mut Platte, sw: *mut usize, sh: *mut usize) -> bool {
    let _p: *mut Platte = x
    *sw = wlibc.screen_w() as usize
    *sh = wlibc.screen_h() as usize
    return *sw > 0 && *sh > 0
}

// Der Fensterserver setzt ein neues Fenster selbst; mittig ist es
// damit schon (`kernel/wm.fi`).
fn r_centre(x: *mut Platte) -> bool {
    return r_is_open(x)
}

// G2: der Puffer des Servers steht seit dem Anlegen fest.
fn r_maximise(x: *mut Platte, w: usize, h: usize) -> bool {
    return w == (*x).w && h == (*x).h
}

fn r_dragging(x: *mut Platte) -> bool {
    let _p: *mut Platte = x
    return false
}

// ----------------------------------------------------------- das Malen

fn gift_fuellen(x: *mut Platte) {
    var i: usize = 0
    let n: usize = (*x).w * (*x).h
    while i < n {
        *(((*x).px + (i * 4) as u64) as *mut u32) = 16711935 as u32
        i = i + 1
    }
}

// OSUM meldet Eingaben an niemanden (es hatte nie einen Eingabe-
// Vorrang). Der Name muss trotzdem da sein, weil window.fi ihn ruft;
// der Haken wird nicht gerufen, und das steht hier, statt still.
// Loslassen/Hinein/Hinaus (window.full_input) liefert diese Rueckwand
// NOCH NICHT -- ehrlich `false`, damit der Wirt es weiss, statt auf
// Ereignisse zu warten, die nie kommen.
fn r_full_input(x: *mut Platte, an: bool) -> bool {
    return false
}

fn r_input_hook(x: *mut Platte, h: fn(u64), ud: u64) {
}

fn r_poison(x: *mut Platte, an: bool) {
    (*x).gift = an
    if an && (*x).px != 0 {
        gift_fuellen(x)
    }
}

fn r_image(x: *mut Platte, px: u64, w: usize, h: usize, dx: usize,
    dy: usize) -> bool {
    if (*x).px == 0 {
        return false
    }
    var y: usize = 0
    while y < h {
        let zy: usize = dy + y
        if zy >= (*x).h {
            return true
        }
        var i: usize = 0
        let q: u64 = px + ((y * w) * 4) as u64
        let z: u64 = (*x).px + (((zy * (*x).w) + dx) * 4) as u64
        while i < w && dx + i < (*x).w {
            *((z + (i * 4) as u64) as *mut u32) =
                *((q + (i * 4) as u64) as *mut u32)
            i = i + 1
        }
        y = y + 1
    }
    return true
}

fn r_fill(x: *mut Platte, farbe: u32, x0: usize, y0: usize, w: usize,
    h: usize) -> bool {
    if (*x).px == 0 {
        return false
    }
    let f: u32 = farbe & 16777215 as u32
    var y: usize = 0
    while y < h && y0 + y < (*x).h {
        let z: u64 = (*x).px + ((((y0 + y) * (*x).w) + x0) * 4) as u64
        var i: usize = 0
        while i < w && x0 + i < (*x).w {
            *((z + (i * 4) as u64) as *mut u32) = f
            i = i + 1
        }
        y = y + 1
    }
    return true
}

// G1: siehe der Kopf dieser Datei.
fn r_font(x: *mut Platte) -> bool {
    return r_is_open(x)
}

fn r_text(x: *mut Platte, fg: u32, bg: u32, tx: usize, ty: usize, p: u64,
    n: usize) -> bool {
    let _a: *mut Platte = x
    let _b: u32 = fg
    let _c: u32 = bg
    let _d: usize = tx
    let _e: usize = ty
    let _f: u64 = p
    let _g: usize = n
    return false
}

fn r_present(x: *mut Platte) -> bool {
    if !r_is_open(x) {
        return false
    }
    wlib.leinwand_neu((*x).lw)
    let _id: u64 = wlib.step()
    (*x).blits = (*x).blits + 1
    return true
}

fn os_blits(x: *mut Platte) -> u64 {
    return (*x).blits
}

fn os_widgets() -> u64 {
    return wlib.counts()
}

// DER ABZUG. Was hier heraus kommt, ist der Puffer der Leinwand --
// also das, was der Nutzer unterhalb der Leiste sieht, Bildpunkt fuer
// Bildpunkt. Die Leiste selbst steht nicht darin: sie gehoert wlib,
// und ein Abzug DAVON kommt aus QEMUs `screendump` (tools/certus/run.sh).
fn r_ppm(x: *mut Platte, pfad: u64) -> bool {
    if (*x).px == 0 {
        return false
    }
    let w: usize = (*x).w
    let h: usize = (*x).h
    var kopf: rt.Buf = rt.buf_new()
    var p6: [u8; 4] = "P6\n\0"
    rt.buf_push_bytes(&kopf, (&p6[0]) as u64, 3)
    zahl_an(&kopf, w)
    rt.buf_push(&kopf, 32 as u8)
    zahl_an(&kopf, h)
    var s255: [u8; 6] = "\n255\n\0"
    rt.buf_push_bytes(&kopf, (&s255[0]) as u64, 5)
    var out: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < rt.buf_len(&kopf) {
        rt.buf_push(&out, rt.buf_at(&kopf, k))
        k = k + 1
    }
    var i: usize = 0
    while i < w * h {
        let v: u32 = *(((*x).px + (i * 4) as u64) as *mut u32)
        rt.buf_push(&out, ((v >> 16) & 255 as u32) as u8)
        rt.buf_push(&out, ((v >> 8) & 255 as u32) as u8)
        rt.buf_push(&out, (v & 255 as u32) as u8)
        i = i + 1
    }
    let ok: bool = rt.write_file(pfad, rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
    rt.buf_free(&kopf)
    return ok
}

fn zahl_an(b: *mut rt.Buf, n: usize) {
    if n >= 10 {
        zahl_an(b, n / 10)
    }
    rt.buf_push(b, (48 + (n % 10)) as u8)
}

// ------------------------------------------------------- die Ereignisse

// Die Tasten, die wlib meldet (`wlib.KEY_*` bzw. ein Oktett), in die
// Nummern von window.fi.
fn taste_um(k: u64) -> u32 {
    if k == wlib.KEY_ENTER {
        return K_RETURN
    }
    if k == wlib.KEY_BS {
        return K_BACK
    }
    if k == wlib.KEY_ESC {
        return K_ESCAPE
    }
    if k == wlib.KEY_TAB {
        return K_TAB
    }
    if k == wlib.KEY_UP {
        return K_UP
    }
    if k == wlib.KEY_DOWN {
        return K_DOWN
    }
    if k == wlib.KEY_LEFT {
        return K_LEFT
    }
    if k == wlib.KEY_RIGHT {
        return K_RIGHT
    }
    if k == wlib.KEY_HOME {
        return K_HOME
    }
    if k == wlib.KEY_END {
        return K_END
    }
    if k == wlib.KEY_PGUP {
        return K_PAGEUP
    }
    if k == wlib.KEY_PGDN {
        return K_PAGEDOWN
    }
    if k == wlib.KEY_DEL {
        return K_DELETE
    }
    return 0
}

// EIN KLICK, WIE IHN CERTUS' EIGENE LEISTE ERZEUGT HAETTE.
fn klick_leiste(x: *mut Platte, kx: usize) {
    q_push(x, EV_BUTTON, KN_LINKS, kx as u32,
        (chrome.CHROME_H / 2) as u32, 0)
}

// DAS ADRESSFELD. Certus haengt Zeichen an seine Adresse an und
// loescht mit der Ruecktaste -- es gibt kein "alles ersetzen". Also
// wird hier genau das getippt, was ein Mensch tippen wuerde.
fn adresse_uebernehmen(x: *mut Platte) {
    klick_leiste(x, (*x).x_adresse)
    var i: usize = 0
    while i < ADR_MAX {
        q_push(x, EV_KEY, K_BACK, 0, 0, 0)
        i = i + 1
    }
    let p: u64 = wlib.text_of((*x).e_adr)
    var k: usize = 0
    while k < ADR_MAX {
        let c: u8 = *((p + k as u64) as *mut u8)
        if c == 0 as u8 {
            k = ADR_MAX
        } else {
            // Oktett fuer Oktett: was Certus als EV_CHAR bekommt,
            // setzt es selbst wieder zu UTF-8 zusammen, und fuer
            // Zeichen unter 128 ist das dasselbe Oktett.
            q_push(x, EV_CHAR, c as u32, 0, 0, 0)
            k = k + 1
        }
    }
    q_push(x, EV_KEY, K_RETURN, 0, 0, 0)
}

// EINMAL WLIB LAUFEN LASSEN und alles, was dabei anfaellt, in die
// Schlange uebersetzen.
fn pumpe(x: *mut Platte) {
    if !r_is_open(x) {
        return
    }
    let id: u64 = wlib.step()
    if id < wlib.MAXWD {
        let art: u64 = wlib.fired_kind()
        if art == wlib.K_BUTTON {
            if id == (*x).b_zurueck {
                klick_leiste(x, (*x).x_zurueck)
            } else if id == (*x).b_vor {
                klick_leiste(x, (*x).x_vor)
            } else if id == (*x).b_neu {
                klick_leiste(x, (*x).x_neu)
            }
        } else if art == wlib.K_ENTRY {
            if id == (*x).e_adr {
                adresse_uebernehmen(x)
            }
        }
    }
    let b: u64 = (&ev_puf[0]) as u64
    while wlib.leinwand_ereignis(b) {
        let wid: u64 = *((b) as *mut u64)
        let sorte: u64 = *((b + 8) as *mut u64)
        let a: u64 = *((b + 16) as *mut u64)
        let btn: u64 = *((b + 24) as *mut u64)
        if wid == (*x).lw {
            // Die Stelle steht IM WIDGET; Certus rechnet im ganzen
            // Fenster, also kommt die Leistenhoehe wieder dazu.
            let ex: u32 = ((a >> 16) & 0xFFFF) as u32
            let ey: u32 = ((a & 0xFFFF) + (chrome.CHROME_H as u64)) as u32
            if sorte == wlib.LE_DOWN {
                var knopf: u32 = KN_LINKS
                if btn == 2 {
                    knopf = 3 as u32
                }
                q_push(x, EV_BUTTON, knopf, ex, ey, 0)
            } else if sorte == wlib.LE_MOVE {
                q_push(x, EV_MOTION, 0, ex, ey, 0)
            } else if sorte == wlib.LE_KEY {
                let t: u32 = taste_um(a)
                if t != 0 as u32 {
                    q_push(x, EV_KEY, t, 0, 0, 0)
                } else if a >= 32 && a < 127 {
                    q_push(x, EV_CHAR, a as u32, 0, 0, 0)
                }
            }
        }
    }
    if !wlib.alive() || wlib.closed((*x).win) {
        q_push(x, EV_CLOSED, 0, 0, 0, 0)
        (*x).offen = false
    }
}

fn r_pending(x: *mut Platte) -> bool {
    if q_leer(x) {
        pumpe(x)
    }
    return !q_leer(x)
}

// RUNDE C-040 -- LIEGT EINE EINGABE IN DER SCHLANGE?
//
// Derselbe Vertrag wie in lib/window/x11.fi und lib/window/win32.fi:
// nur nachsehen, nichts herausnehmen, und nur das zaehlen, hinter dem
// ein Mensch steht (Taste, Zeichen, Knopf) -- eine Zeigerbewegung
// nicht.
fn r_input_pending(x: *mut Platte) -> bool {
    var i: usize = (*x).q_tail
    while i != (*x).q_head {
        let k: u32 = (*x).q_kind[i]
        if k == EV_KEY || k == EV_CHAR || k == EV_BUTTON {
            return true
        }
        i = (i + 1) % QN
    }
    return false
}

// WARTEN. Osums Fensterserver hat keinen Deskriptor, auf den man
// warten koennte (`WM_EVENT` holt ab und kehrt sofort zurueck) --
// dieselbe Grenze wie in Runde CERTUS. Also: fragen, den Prozessor
// abgeben, wieder fragen. `wlib.step` gibt von sich aus ab, wenn
// nichts anfiel; die Zeit wird an der Uhr des Systems gemessen und
// nicht in Runden geraten.
fn r_wait(x: *mut Platte, ms: i64) -> bool {
    if r_pending(x) {
        return true
    }
    if ms == 0 {
        return false
    }
    let start: u64 = jetzt_ms()
    var runden: u64 = 0
    while true {
        pumpe(x)
        if !q_leer(x) {
            return true
        }
        runden = runden + 1
        if ms > 0 {
            if jetzt_ms() - start >= (ms as u64) {
                return false
            }
        }
        if !(*x).offen {
            return !q_leer(x)
        }
    }
    return false
}

static mut ts: [i64; 2] = [0 as i64; 2]

fn jetzt_ms() -> u64 {
    // clock_gettime(CLOCK_MONOTONIC=1). Osums Nummern sind die von
    // Linux (Runde K4).
    let _r: u64 = kcall.sys2(kcall.SYS_CLOCK_GETTIME, 1,
        (&ts[0]) as u64)
    return (ts[0] as u64) * 1000 + (ts[1] as u64) / 1000000
}

fn r_next(x: *mut Platte, k: *mut u32, a: *mut u32, ox: *mut u32,
    oy: *mut u32, s: *mut u32) -> bool {
    if q_leer(x) {
        pumpe(x)
    }
    if q_leer(x) {
        return false
    }
    let t: usize = (*x).q_tail
    *k = (*x).q_kind[t]
    *a = (*x).q_a[t]
    *ox = (*x).q_x[t]
    *oy = (*x).q_y[t]
    *s = (*x).q_s[t]
    (*x).q_tail = (t + 1) % QN
    return true
}

