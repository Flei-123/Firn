// lib/window/shellproto.fi -- shell thread protocol: record sizes, command kinds and block offsets shared by window.shellthread and window.shellos (docs/SHELL_THREAD.md).
import std.rt
import chan.chan

export {
    SHELL_KIND, EV_WORDS, CMD_WORDS, FRAME_WORDS, FREE_WORDS, TITLE_MAX, FRAME_HEAD, MAX_BUFS,
    CMD_TITLE, CMD_CURSOR, CMD_SIZE, CMD_CLOSE, CMD_REDRAW,
    SE_DRAG,
    ST_STARTING, ST_OPEN, ST_FAILED, ST_ENDED,
    B_EV, B_CMD, B_FRM, B_FREE, B_EVT, B_STATE, B_W, B_H, B_DPI, B_THREAD, B_STOP, B_W0, B_H0,
    B_SHOWN, B_DROPPED, B_PAINTS, B_EVDROP, B_ALLOC, B_NEXT_ID, B_TITLE_N, B_TITLE, B_WORDS,
    STAT_SHOWN, STAT_DROPPED, STAT_PAINTS, STAT_EVDROP,
    sh_chan, sh_get, sh_put, give_back,
}

const SHELL_KIND: u64 = 1936222316
const EV_WORDS: usize = 8
const CMD_WORDS: usize = 16
const FRAME_WORDS: usize = 8
const FREE_WORDS: usize = 2
const TITLE_MAX: usize = 112
const FRAME_HEAD: usize = 64
const MAX_BUFS: u64 = 4

const CMD_TITLE: u64 = 1
const CMD_CURSOR: u64 = 2
const CMD_SIZE: u64 = 3
const CMD_CLOSE: u64 = 4
const CMD_REDRAW: u64 = 5

const SE_DRAG: u32 = 100

const ST_STARTING: u64 = 0
const ST_OPEN: u64 = 1
const ST_FAILED: u64 = 2
const ST_ENDED: u64 = 3

const B_EV: usize = 0
const B_CMD: usize = 1
const B_FRM: usize = 2
const B_FREE: usize = 3
const B_EVT: usize = 4
const B_STATE: usize = 5
const B_W: usize = 6
const B_H: usize = 7
const B_DPI: usize = 8
const B_THREAD: usize = 9
const B_STOP: usize = 10
const B_W0: usize = 11
const B_H0: usize = 12
const B_SHOWN: usize = 13
const B_DROPPED: usize = 14
const B_PAINTS: usize = 15
const B_EVDROP: usize = 16
const B_ALLOC: usize = 17
const B_NEXT_ID: usize = 18
const B_TITLE_N: usize = 19
const B_TITLE: usize = 20
const B_WORDS: usize = 40

const STAT_SHOWN: u64 = 0
const STAT_DROPPED: u64 = 1
const STAT_PAINTS: u64 = 2
const STAT_EVDROP: u64 = 3

fn sh_chan(sh: u64, which: usize) -> chan.Chan {
    return chan.Chan { blk: rt.ld64(sh, which) }
}

fn sh_get(sh: u64, which: usize) -> u64 {
    return __atomic_add((sh + (which * 8) as u64) as *mut u64, 0)
}

fn sh_put(sh: u64, which: usize, v: u64) {
    rt.st64(sh, which, v)
}

fn give_back(sh: u64, ptr: u64) {
    var rec: [u64; 2] = [0; 2]
    rec[0] = ptr
    var fr: chan.Chan = sh_chan(sh, B_FREE)
    chan.chan_try_send(&fr, (&rec[0]) as *mut u64)
}
