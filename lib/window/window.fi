// SPDX-License-Identifier: MPL-2.0
// Provenance: Certus, lib/window/window.fi, as of Certus commit 1f1ec17bdb68 (last
// changed in cbbc9d8c0475); released by the sole author Justin on 23.09.2026
// for Firn under MPL-2.0.
// lib/window/window.fi -- ONE WINDOW, ONCE. (round FENSTER)
//
// ======================================================= WHY IT EXISTS
//
// There were TWO window layers with almost the same interface and a
// different prefix: lib/browser/x11.fi (x11_open, x11_put_image, ...)
// and lib/windows/gdi.fi (win_open, win_put_image, ...). So the
// abstraction was already there -- it just was not written down
// anywhere. The consequence was measurable: lib/windows/certus_main.fi
// was a COPY of lib/browser/window_main.fi, 888 lines word for word the
// same, and the two had already drifted apart. Windows got resize, dpi,
// EV_MOTION, EV_CHAR, EV_THEME; X11 got NONE of it.
//
// This file is the abstraction written down. The upper edge knows
// nothing platform specific: no HWND, no X message, no Win32 constant.
//
// ============================== HOW THE BACKEND IS CHOSEN
//
// Firn has no conditional compilation, and it needs none. The module
// search resolves `import` first NEXT TO THE IMPORTING file, then NEXT
// TO THE ROOT file, then in $FIRNLIB (compiler/src/modules.rs,
// `resolve`). This file imports `window.backend`; rule 1 does not
// apply, so rule 2 -- and there lies a link:
//
//   lib/browser/window/backend.fi  ->  ../../window/x11.fi
//   lib/windows/window/backend.fi  ->  ../../window/win32.fi
//
// So the DIRECTORY of the root file chooses the backend: without a line
// in the compiler, without function pointers, and without the Linux
// build ever seeing an `extern fn` on user32.dll. Foreign programs are
// built by `tools/window/bau.sh <source> <target> linux|windows`.
//
// ================================================= WHAT LIES UP HERE
//
// Everything that is NOT platform specific -- exactly that was the bug:
//   * the RESIZE (EV_CONFIGURE -> new canvas). Previously existed only
//     under Windows, under X11 not at all.
//   * DPI and `scaled(f, n)`. Justin's caret was 8x15 on a 34 inch
//     screen, because it was the only piece that was not scaled.
//   * LIGHT/DARK/SYSTEM -- the DECISION, not the colours; a colour
//     table belongs to the program (browser.chrome).
//   * THE WAITING. X11 has a socket (`poll`), Windows has none
//     (MsgWaitForMultipleObjectsEx). Up here both are `wait_event(ms)`.
//
// ================================================ WHAT IS NOT HERE
//
// F1 NO drawing beyond pixels, rectangles and system text. Whoever
//    wants curves rasterises them itself and pushes the finished buffer
//    over with `image` -- the Certus contract since round B3.
// F2 NO tabs, menus, buttons. The program's business.
// F3 ONE pixel format: BGRX (32 bit, B,G,R,X in memory). It is what an
//    X server with 24 bit TrueColor and what a 32 bit DIB with BI_RGB
//    want -- the same octets on both systems.
import std.rt
import window.backend

export {
    Window, window_new,
    open_window, make, show_window, title, close_window, is_open,
    screen, centre,
    width, height, dpi, set_dpi, uiscale, scaled, resize,
    image, fill, font, text, present, save_ppm,
    wait_event, pending, next_event, dragging, input_pending,
    input_hook,
    real_pointers, next_pointer,
    update_start,
    ev_a, ev_x, ev_y, ev_state,
    set_theme, theme_mode, dark, theme_known, theme_reload,
    titlebar_colour,
    // ================================================== ROUND C-049
    // THE WINDOW FRAME OF ITS OWN. From here on the upper edge is the business of the
    // program: the tab row IS the title bar.
    frame_own, frame_can, frame_height_set, button_zone_set,
    content_size,
    window_minimise, window_max_toggle, window_maximised,
    window_drag, window_sysmenu,
    rgb_to_bgrx, to_bgrx, set_poison, poison_colour,
    // FIRN r64 -- the program behind its window: a message for the user
    // while the window is not in front, and running on without it.
    notify, stay_alive, in_front,
    notify_at, notify_shown, notify_cancel,
    // a photo from the system (gallery / camera) and pictures into pixels
    pick_image, pick_poll, pick_take, image_decode,
    // OpenPlan LIB-006: the system clipboard
    clipboard_set, clipboard_get, clipboard_types, clipboard_clear,
    // OpenPlan LIB-005: waiting for several windows at once
    wait_any,
    // fUi tempo, stage 2b: THE GPU (see the end of this file)
    gpu_open, gpu_swap, gpu_close, gpu_place, gpu_lost,
    EV_NONE, EV_EXPOSE, EV_KEY, EV_CHAR, EV_BUTTON, EV_MOTION,
    EV_CONFIGURE, EV_THEME, EV_CLOSED,
    EV_RELEASE, EV_ENTER, EV_LEAVE, EV_KEY_UP, full_input,
    K_ESCAPE, K_RETURN, K_BACK, K_TAB, K_DOWN, K_UP, K_PAGEDOWN,
    K_PAGEUP, K_LEFT, K_RIGHT, K_HOME, K_END, K_DELETE,
    TH_SYSTEM, TH_LIGHT, TH_DARK,
    BTN_LEFT, BTN_MIDDLE, BTN_RIGHT, BTN_WHEEL_UP, BTN_WHEEL_DOWN,
    FMT_BGRX,
}

// ===================================================== DIE EREIGNISSE
//
// The UNION of the two previous sets. The numbers are those of
// lib/browser/x11.fi and lib/windows/gdi.fi -- both already had the
// same ones, and a program written against the old numbers still
// computes correctly.
const EV_NONE: u32 = 0
// The content is lost, it has to be repainted.
const EV_EXPOSE: u32 = 1
// A KEY with meaning: `ev_a` is a K_*. Characters do NOT arrive here
// but as EV_CHAR -- that is the split Windows dictates with
// WM_KEYDOWN/WM_CHAR and that X11 now reproduces.
const EV_KEY: u32 = 2
// A mouse button or the wheel: `ev_a` is a BTN_*, `ev_x`/`ev_y` the
// Stelle im Window.
const EV_BUTTON: u32 = 3
// The window size has changed: `ev_x` is the new width, `ev_y` the
// new height. `next_event` has already resized the canvas by then
// nachgezogen.
const EV_CONFIGURE: u32 = 4
// With EV_KEY, EV_KEY_UP and EV_CHAR `ev_x` carries under X11 the
// KEYSYM from which the back end determined key or character (0 =
// the layout of the server could not be obtained).
// The window was closed (button, window manager, WM_CLOSE).
const EV_CLOSED: u32 = 5
// A CHARACTER, fully composed: `ev_a` is a Unicode code point.
const EV_CHAR: u32 = 6
// The pointer has moved: `ev_x`/`ev_y`.
const EV_MOTION: u32 = 7
// The system setting light/dark has changed. `dark(f)` already
// reads correctly afterwards.
const EV_THEME: u32 = 8
// ----------------------------------------------------------------------
// THE FOUR THAT COME ONLY ON REQUEST (Firn, 23.09.2026) -- see
// `full_input`. A program that does not order them sees exactly what
// it saw before.
//
// A mouse button was released: `ev_a` is the BTN_*, `ev_x`/`ev_y`
// the position. Only with that is a click a click (press AND
// release on the same widget, lib/fui/control.fi).
const EV_RELEASE: u32 = 9
// The pointer entered / left the window: `ev_x`/`ev_y` the position.
const EV_ENTER: u32 = 10
const EV_LEAVE: u32 = 11
// A key was released: `ev_a` as with EV_KEY.
const EV_KEY_UP: u32 = 12

// ======================================================== DIE TASTEN
//
// Deliberately the X11 key numbers: they have been in the event
// loops since round B5, and lib/windows/gdi.fi rebuilt them for
// Windows instead of inventing its own. Whoever builds a new backend
// maps ITS numbers onto these -- not the other way round.
const K_ESCAPE: u32 = 9
const K_BACK: u32 = 22
const K_TAB: u32 = 23
const K_RETURN: u32 = 36
const K_HOME: u32 = 110
const K_UP: u32 = 111
const K_PAGEUP: u32 = 112
const K_LEFT: u32 = 113
const K_RIGHT: u32 = 114
const K_END: u32 = 115
const K_DOWN: u32 = 116
const K_PAGEDOWN: u32 = 117
const K_DELETE: u32 = 119

// ================================================== MAUSKNOEPFE / RAD
// The X11 numbers; the wheel is a button there and stays one here.
const BTN_LEFT: u32 = 1
const BTN_MIDDLE: u32 = 2
const BTN_RIGHT: u32 = 3
const BTN_WHEEL_UP: u32 = 4
const BTN_WHEEL_DOWN: u32 = 5

// ==================================================== LIGHT AND DARK
const TH_SYSTEM: u32 = 0
const TH_LIGHT: u32 = 1
const TH_DARK: u32 = 2

// ================================================= THE PIXEL FORMAT
// ONE format, and it has a name. See F3 in the header.
const FMT_BGRX: u32 = 0

struct Window {
    // The state of the backend. What is in it this file does not know
    // and must not know.
    p: backend.Platte,
    w: usize,
    h: usize,
    dpi_ist: usize,
    dpi_zwang: usize,
    // the event taken out last
    ev_kind: u32,
    e_a: u32,
    e_x: u32,
    e_y: u32,
    e_s: u32,
    // hell/dark
    th_mode: u32,
    th_dunkel: bool,
    th_known: bool,
}

fn window_new() -> Window {
    return Window { p: backend.surface_new(), w: 0, h: 0, dpi_ist: 96,
        dpi_zwang: 0, ev_kind: 0, e_a: 0, e_x: 0, e_y: 0, e_s: 0,
        th_mode: 0, th_dunkel: false, th_known: false }
}

// --------------------------------------------------------- aufmachen
//
// `display` is the X11 display number (`:0` = 0). Under Windows there
// is none to choose; the value is not looked at there. It is the ONLY
// parameter of the interface that concerns just one side, and it is
// here so that the acceptance run under Xvfb can keep its own
// Anzeige bekommt.
fn open_window(f: *mut Window, disp: usize) -> bool {
    if !backend.r_open(&(*f).p, disp) {
        return false
    }
    // The density is known after opening, not only after the
    // window: whoever means the START SIZE in design points (and that
    // should be everybody) must be able to convert it before `make`.
    (*f).dpi_ist = backend.r_dpi(&(*f).p)
    theme_resolve(f)
    return true
}

// ORDER RELEASE, ENTER, LEAVE (EV_RELEASE, EV_ENTER, EV_LEAVE,
// EV_KEY_UP). Must stand between `open_window` and `make` -- under
// X11 the list of the wanted events is part of the window.
// Returns: whether this back end really delivers them. Whoever gets `false`
// has to get by without them (a click is then the press alone).
fn full_input(f: *mut Window, an: bool) -> bool {
    return backend.r_full_input(&(*f).p, an)
}

// REAL POINTERS (roadmap r111). EV_MOTION / EV_BUTTON know one pointer and
// nothing else. A back end that has real ones (Android today: every finger
// with its id, the tool type, the time) delivers them as records of
// lib/window/pointers.fi when asked:
//
//     if window.real_pointers(f, true) {
//         var p: pointers.Pointer = pointers.ptr_blank()
//         while window.next_pointer(f, (&p) as u64) { ... }
//     }
//
// The records come IN ADDITION to the old events (the first finger still
// makes EV_MOTION / EV_BUTTON / EV_RELEASE as before), so a program that
// does not ask sees exactly what it saw. Returns whether this back end has
// them at all; `false` = use the old events.
fn real_pointers(f: *mut Window, an: bool) -> bool {
    return backend.r_pointers(&(*f).p, an)
}

// The next pointer record into `out` (a *mut pointers.Pointer as u64);
// false = none.
fn next_pointer(f: *mut Window, out: u64) -> bool {
    return backend.r_next_pointer(&(*f).p, out)
}

// Create window and drawing surface, `bw` x `bh` INNER AREA.
fn make(f: *mut Window, bw: usize, bh: usize) -> bool {
    if !backend.r_make(&(*f).p, bw, bh) {
        return false
    }
    (*f).w = backend.r_width(&(*f).p)
    (*f).h = backend.r_height(&(*f).p)
    (*f).dpi_ist = backend.r_dpi(&(*f).p)
    return true
}

fn screen(f: *mut Window, sw: *mut usize, sh: *mut usize) -> bool {
    return backend.r_screen(&(*f).p, sw, sh)
}

fn centre(f: *mut Window) -> bool {
    return backend.r_centre(&(*f).p)
}

fn show_window(f: *mut Window) -> bool {
    return backend.r_show(&(*f).p)
}

fn title(f: *mut Window, p: u64, n: usize) -> bool {
    return backend.r_title(&(*f).p, p, n)
}

fn close_window(f: *mut Window) {
    backend.r_close(&(*f).p)
}

fn is_open(f: *mut Window) -> bool {
    return backend.r_is_open(&(*f).p)
}

fn width(f: *mut Window) -> usize {
    return (*f).w
}

fn height(f: *mut Window) -> usize {
    return (*f).h
}

// DPI AND UISCALE. The bug this prevents: Justin's caret was 8x15
// pixels on a 34 inch ultrawide, because it was the only piece
// painted with fixed numbers. A number from the design is meant in
// points at 96 dpi; `scaled` turns it into device pixels. Whoever
// writes down a size runs it through here.
fn dpi(f: *mut Window) -> usize {
    if (*f).dpi_zwang > 0 {
        return (*f).dpi_zwang
    }
    return (*f).dpi_ist
}

// By hand, for acceptance runs and for a switch `--dpi=`.
// 0 = whatever the system says again.
fn set_dpi(f: *mut Window, d: usize) {
    (*f).dpi_zwang = d
}

// The scale in per mille: 1000 = 100 %, 1500 = 150 %.
fn uiscale(f: *mut Window) -> usize {
    return dpi(f) * 1000 / 96
}

// `n` Entwurfspunkte in Geraetepunkte, kaufmaennisch gerundet.
fn scaled(f: *mut Window, n: usize) -> usize {
    return (n * dpi(f) + 48) / 96
}

// Bring the drawing surface to another size by hand. The normal case
// is EV_CONFIGURE, which `next_event` handles itself.
fn resize(f: *mut Window, bw: usize, bh: usize) -> bool {
    if bw == 0 || bh == 0 {
        return false
    }
    if !backend.r_maximise(&(*f).p, bw, bh) {
        return false
    }
    (*f).w = backend.r_width(&(*f).p)
    (*f).h = backend.r_height(&(*f).p)
    return true
}

// ---------------------------------------------------------- painting

// A finished BGRX buffer to (dx, dy). `bw`/`bh` are its dimensions.
fn image(f: *mut Window, px: u64, bw: usize, bh: usize, dx: usize,
    dy: usize) -> bool {
    return backend.r_image(&(*f).p, px, bw, bh, dx, dy)
}

// A rectangle in 0xRRGGBB.
fn fill(f: *mut Window, color: u32, x0: usize, y0: usize, bw: usize,
    bh: usize) -> bool {
    return backend.r_fill(&(*f).p, color, x0, y0, bw, bh)
}

// Die Systemfestschrift bereitstellen (X11: "fixed", Windows:
// SYSTEM_FIXED_FONT). For labels that no own rasteriser should paint
// -- a page is painted by Certus with lib/font.
fn font(f: *mut Window) -> bool {
    return backend.r_font(&(*f).p)
}

// `ty` ist die GRUNDLINIE, auf beiden Systemen.
fn text(f: *mut Window, fg: u32, bg: u32, tx: usize, ty: usize, p: u64,
    n: usize) -> bool {
    return backend.r_text(&(*f).p, fg, bg, tx, ty, p, n)
}

// Everything painted onto the screen.
fn present(f: *mut Window) -> bool {
    return backend.r_present(&(*f).p)
}

// THE CAPTURE OF WHAT REALLY STANDS IN THE WINDOW (not of the
// program's canvas), as binary PPM. X11 cannot do it -- there the
// acceptance run takes the image from the server with `xwd`, which is stronger.
fn save_ppm(f: *mut Window, path: u64) -> bool {
    return backend.r_ppm(&(*f).p, path)
}

// THE POISON: the fresh drawing surface is filled with pure magenta.
// Whatever is still magenta afterwards has never seen an `image` and
// never a `fill` -- "share of unpainted pixels" is thereby COUNTED
// and not estimated. Off in shipping builds.
fn set_poison(f: *mut Window, an: bool) {
    backend.r_poison(&(*f).p, an)
}

fn poison_colour() -> u32 {
    return 16711935 as u32
}

// ------------------------------------------------------- die Ereignisse

// Is one ready already, without waiting?
// Is the user dragging the edge right now? Windows knows, X11 does not.
fn dragging(f: *mut Window) -> bool {
    return backend.r_dragging(&(*f).p)
}

fn pending(f: *mut Window) -> bool {
    return backend.r_pending(&(*f).p)
}

// ROUND C-040 -- IS AN INPUT PENDING?
//
// `pending` says "some event", and that is too coarse for the
// input priority: an Expose when moving the window
// or a mouse moving across the window would otherwise shift every slice
// of the page build -- the page would never be finished.
//
// `input_pending` says "a KEY or a CLICK lies in the queue",
// and WITHOUT taking it out. That is the difference on which
// the whole priority stands: it must not be processed in the middle of the
// line break (a click would call `load_url` from within `load_url`,
// see `pumpe_kurz` in lib/browser/certus_app.fi) -- but it
// must be known nevertheless.
//
// This function is what the host gives as `hat_eingabe` to
// `vorrang.vorrang_wirt_setzen`.
fn input_pending(f: *mut Window) -> bool {
    return backend.r_input_pending(&(*f).p)
}

// WHO LEARNS THAT AN INPUT HAS ARRIVED -- even before it is fetched.
// The back end calls `h(ud)` for every key and every click at
// the moment at which it SEES it (see `input_pending`). Certus
// hangs its input priority in here; a host without priority sets
// nothing, and then nothing happens.
fn input_hook(f: *mut Window, h: fn(u64), ud: u64) {
    backend.r_input_hook(&(*f).p, h, ud)
}

// WAITING, PLATFORM NEUTRAL. The last hard difference: X11 has a
// socket (`poll`), Windows has none
// (MsgWaitForMultipleObjectsEx). Beides ist "wait_event hoechstens `ms`
// milliseconds"; `ms` < 0 = forever, 0 = only look. THE IDLE CURRENT
// BLEIBT NULL -- gemessen: 0 CPU-Ticks in 10 s Leerlauf.
fn wait_event(f: *mut Window, ms: i64) -> bool {
    if backend.r_pending(&(*f).p) {
        return true
    }
    return backend.r_wait(&(*f).p, ms)
}

// WAITING FOR SEVERAL WINDOWS (OpenPlan LIB-005). `ws` holds the
// addresses of `n` windows (at most 8). The answer is the index of one
// that has an event now, or -1 when `ms` passed (-1 = wait without end).
// Where the backend has a descriptor (X11: the connection) all are
// watched with one `poll`; otherwise the windows are asked in turn in
// slices of 10 ms.
fn wait_any(ws: *mut [u64; 8], n: usize, ms: i64) -> i64 {
    var i: usize = 0
    while i < n {
        if backend.r_pending(&(*((*ws)[i] as *mut Window)).p) {
            return i as i64
        }
        i = i + 1
    }
    var pfd: [i32; 16] = [0; 16]
    var all_fds: bool = n > 0
    i = 0
    while i < n {
        let fd: i32 = backend.r_event_fd(&(*((*ws)[i] as *mut Window)).p)
        if fd < 0 {
            all_fds = false
        }
        pfd[i * 2] = fd
        pfd[i * 2 + 1] = 1 // POLLIN
        i = i + 1
    }
    let start: i64 = now_ms()
    while true {
        var left: i64 = -1
        if ms >= 0 {
            left = ms - (now_ms() - start)
            if left < 0 {
                left = 0
            }
        }
        if all_fds {
            i = 0
            while i < n {
                pfd[i * 2 + 1] = 1
                i = i + 1
            }
            let r: i64 = syscall(7, (&pfd[0]) as i64, n as i64, left, 0, 0, 0)
            if r > 0 {
                i = 0
                while i < n {
                    // what arrived is read now; a reply alone is no event
                    if (pfd[i * 2 + 1] >> 16) != 0 {
                        if backend.r_wait(&(*((*ws)[i] as *mut Window)).p, 0) {
                            return i as i64
                        }
                    }
                    i = i + 1
                }
            }
        } else {
            i = 0
            while i < n {
                var slice: i64 = 10
                if left >= 0 && left < slice {
                    slice = left
                }
                if backend.r_wait(&(*((*ws)[i] as *mut Window)).p, slice) {
                    return i as i64
                }
                i = i + 1
            }
        }
        if ms >= 0 && now_ms() - start >= ms {
            return -1
        }
    }
    return -1
}

fn now_ms() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

// The next event, NON blocking: EV_NONE means "none there".
//
// Here stands the common post-processing, and it is the reason this
// library exists: the resize is done ONCE properly and not twice by
// halves.
fn next_event(f: *mut Window) -> u32 {
    var k: u32 = EV_NONE
    var a: u32 = 0
    var x: u32 = 0
    var y: u32 = 0
    var s: u32 = 0
    if !backend.r_next(&(*f).p, &k, &a, &x, &y, &s) {
        (*f).ev_kind = EV_NONE
        return EV_NONE
    }
    (*f).ev_kind = k
    (*f).e_a = a
    (*f).e_x = x
    (*f).e_y = y
    (*f).e_s = s
    if k == EV_CONFIGURE {
        let nw: usize = x as usize
        let nh: usize = y as usize
        if nw > 0 && nh > 0 {
            if nw != (*f).w || nh != (*f).h {
                (*f).w = nw
                (*f).h = nh
                // The drawing surface is CREATED ANEW and not stretched.
                // A stretched canvas would be exactly the
                // Unschaerfe, die Runde MOBIL5 auf Android gemessen hat.
                let ok: bool = backend.r_maximise(&(*f).p, nw, nh)
                // The device context is new afterwards, so is the font:
                // otherwise `text` would paint nothing from here on.
                let okf: bool = backend.r_font(&(*f).p)
            }
        }
        // A window may have been moved to another screen. Then the
        // pixel density is a different one.
        (*f).dpi_ist = backend.r_dpi(&(*f).p)
    }
    if k == EV_THEME {
        theme_resolve(f)
    }
    return k
}

fn ev_a(f: *mut Window) -> u32 {
    return (*f).e_a
}

fn ev_x(f: *mut Window) -> u32 {
    return (*f).e_x
}

fn ev_y(f: *mut Window) -> u32 {
    return (*f).e_y
}

// The modifier keys for the event. Bit 0 = Shift, bit 2 = Ctrl --
// die X11-Belegung, die die Windows-Rueckwand nachbildet.
fn ev_state(f: *mut Window) -> u32 {
    return (*f).e_s
}

// HELL/DUNKEL. Die ENTSCHEIDUNG liegt hier: `TH_SYSTEM` fragt die
// backend, `TH_LIGHT`/`TH_DARK` are the manual switch. The COLOURS
// are not -- a colour table belongs to the program (browser.chrome).
fn set_theme(f: *mut Window, mode: u32) {
    (*f).th_mode = mode
    theme_resolve(f)
}

fn theme_mode(f: *mut Window) -> u32 {
    return (*f).th_mode
}

fn dark(f: *mut Window) -> bool {
    return (*f).th_dunkel
}

// Could the system really be asked? Otherwise `dark` is the fallback
// (LIGHT) and not an answer.
fn theme_known(f: *mut Window) -> bool {
    return (*f).th_known
}

// Look at the system once more; true = it has changed. The backends
// that send EV_THEME by themselves do not need this; whoever has no
// notification calls it occasionally.
fn theme_reload(f: *mut Window) -> bool {
    let before: bool = (*f).th_dunkel
    theme_resolve(f)
    return (*f).th_dunkel != before
}

fn theme_resolve(f: *mut Window) {
    if (*f).th_mode == TH_LIGHT {
        (*f).th_dunkel = false
        (*f).th_known = true
        backend.r_titlebar_dark(&(*f).p, false)
        return
    }
    if (*f).th_mode == TH_DARK {
        (*f).th_dunkel = true
        (*f).th_known = true
        backend.r_titlebar_dark(&(*f).p, true)
        return
    }
    (*f).th_dunkel = backend.r_dark(&(*f).p)
    (*f).th_known = backend.r_dark_known(&(*f).p)
    // ROUND C-039: the MANUAL SWITCH must reach through to the
    // title bar. `r_dark` reads the registry; if the program stands at
    // `--theme=dark`, the bar would otherwise be light and the shell
    // dark -- exactly the break that this is about.
    backend.r_titlebar_dark(&(*f).p, (*f).th_dunkel)
}

// ROUND C-039 -- THE TITLE BAR CARRIES THE COLOUR OF THE SHELL.
//
// The program knows its bar colour (browser.chrome `th_bar`),
// the window layer does not. So the program passes it through, and
// the back end makes of it what the platform can: under Windows
// DWMWA_CAPTION_COLOR, under X11 nothing (there the window
// manager draws, not the program).
fn titlebar_colour(f: *mut Window, rgb: u32, an: bool) {
    backend.r_titlebar_colour(&(*f).p, rgb, an)
}

// THE FORMAT. Round UHR had the BGRX/RGBA conversion in several
// places; it stands here now, once, with a name. 0xRRGGBB -> a 32 bit
// word that lies little endian as B,G,R,0. It is a MASK and not a
// swap -- an early version of `to_bgrx` swapped R and B, and the
// window showed the page in false colours.
fn rgb_to_bgrx(rgb: u32) -> u32 {
    return rgb & 16777215 as u32
}

// A whole strip of 0xAARRGGBB -> BGRX. Source and target may be the
// same address.
fn to_bgrx(source: u64, target: u64, n: usize) {
    var i: usize = 0
    while i < n {
        let v: u32 = *((source + (i * 4) as u64) as *mut u32)
        *((target + (i * 4) as u64) as *mut u32) = v & 16777215 as u32
        i = i + 1
    }
}

// ======================================================================
// ROUND C-038 -- TRIGGER THE UPDATER
// ======================================================================
//
// The menu item "Check for update" needs no network IN
// Certus: next to certus.exe lies certus-update.exe, which can already do
// that (checksum, confirmation prompt, installation). This function starts it
// and DOES NOT WAIT -- the picture loop keeps running undisturbed.
//
// `mit_fenster` = true means `"--jetzt"`: the user has clicked himself
// and wants an answer in any case, also the "is up to date".
//
// Return false = could not be started. Under Linux/Android
// that is ALWAYS so (there the exe does not exist), under Windows only
// if certus-update.exe is missing. The caller must tell the user.
fn update_start(with_window: bool) -> bool {
    return backend.r_update_start(with_window)
}

// ======================================================================
// ROUND C-049 -- THE WINDOW FRAME OF ITS OWN
// ======================================================================
//
// Justin, 19.09.2026: "the upper taskbar is in a normal
// browser directly at tab height instead of a separate window bar".
//
// WHAT STANDS UP HERE is deliberately small: six questions that EVERY
// window system can answer, and not a single Windows number. All the
// work (WM_NCCALCSIZE, WM_NCHITTEST, the eight points when
// maximising) sits in lib/window/win32.fi -- exactly as F1 to F3 in the
// head of this file demand.
//
// UNDER X11 `frame_can` says NO. There the window
// manager draws the bar, and a program that takes it for itself
// loses the counterpart of Aero Snap and the key shortcuts of the
// manager. So the program asks, instead of assuming -- and the
// tab row carries its buttons only if the answer is YES.

// Can this window system do a self-drawn frame?
fn frame_can(f: *mut Window) -> bool {
    return backend.r_frame_can(&(*f).p)
}

// Switch the frame of its own on or off. Returns whether it is now
// really on.
fn frame_own(f: *mut Window, an: bool) -> bool {
    return backend.r_frame_own(&(*f).p, an)
}

// Ask the operating system for the REAL content size. Needed only
// after the frame has changed: then the content is already
// large, the canvas still small. false = there is nothing new.
fn content_size(f: *mut Window, bw: *mut usize, bh: *mut usize) -> bool {
    return backend.r_content_size(&(*f).p, bw, bh)
}

// How high the row is that the program uses as a title bar.
// The frame needs the number for WM_NCHITTEST: everything above it is
// title bar (drag), everything below belongs to the content.
fn frame_height_set(f: *mut Window, h: usize) {
    backend.r_frame_height(&(*f).p, h)
}

// Which horizontal strip of the header row belongs to the window buttons of the
// program. There it is NOT dragged -- otherwise a press on
// "Close" moves the window instead of closing it.
fn button_zone_set(f: *mut Window, x0: usize, x1: usize) {
    backend.r_button_zone(&(*f).p, x0, x1)
}

fn window_minimise(f: *mut Window) {
    backend.r_minimise(&(*f).p)
}

// Maximise or restore -- depending on what currently applies.
fn window_max_toggle(f: *mut Window) {
    backend.r_max_toggle(&(*f).p)
}

fn window_maximised(f: *mut Window) -> bool {
    return backend.r_maximised(&(*f).p)
}

// Take the window by the handle. Called when the user presses the
// empty area of the tab row.
fn window_drag(f: *mut Window) {
    backend.r_drag(&(*f).p)
}

// The system menu (move, resize, close) at the
// position of the pointer. Right click on the title bar, as everywhere.
fn window_sysmenu(f: *mut Window, sx: usize, sy: usize) {
    backend.r_sysmenu(&(*f).p, sx, sy)
}

// ===================================================================
// FIRN r64 -- WHEN THE WINDOW IS NOT IN FRONT
// ===================================================================
//
// A chat has to say "a message came" while nobody looks at its window, and
// it has to keep its connection while the window is gone. On a desktop the
// window stays and the program runs anyway; on a phone the system takes
// both away unless the program asks. These three are the asking, in the
// same words on every system:
//
//   in_front(f)             is the window on screen right now?
//   notify(f, t, tn, x, xn) a notification (title, text: UTF-8). false =
//                           this system has none here (X11, Windows, Osum:
//                           not yet -- honestly false, never pretended).
//   stay_alive(f, on)       keep the program running while its window is
//                           gone. Android: a foreground service with a
//                           permanent notification (lib/plat/android/push.fi);
//                           elsewhere a program runs anyway, so false.
fn in_front(f: *mut Window) -> bool {
    return backend.r_in_front(&(*f).p)
}

fn notify(f: *mut Window, tp: u64, tn: usize, xp: u64, xn: usize) -> bool {
    return backend.r_notify(&(*f).p, tp, tn, xp, xn)
}

fn stay_alive(f: *mut Window, an: bool) -> bool {
    return backend.r_stay_alive(&(*f).p, an)
}

// ONE NOTIFICATION PER CONVERSATION (a messenger's way):
//   notify_at(f, key, t, tn, x, xn)  post or REPLACE the notification of
//                                    `key` (a small number the program
//                                    chooses, e.g. its row). Tapping it
//                                    opens the program and removes it.
//   notify_shown(f, key)             1 = still in the status bar, 0 = not
//                                    (tapped, swiped away, cancelled),
//                                    -1 = this system cannot tell. A key
//                                    that was posted and is 0 when the
//                                    window comes back in front is the
//                                    one the user tapped (or dismissed).
//   notify_cancel(f, key)            take it away (the conversation is read)
// Elsewhere than Android: false / -1 / false, honestly.
fn notify_at(f: *mut Window, key: u64, tp: u64, tn: usize, xp: u64,
    xn: usize) -> bool {
    return backend.r_notify_at(&(*f).p, key, tp, tn, xp, xn)
}

fn notify_shown(f: *mut Window, key: u64) -> i32 {
    return backend.r_notify_shown(&(*f).p, key)
}

fn notify_cancel(f: *mut Window, key: u64) -> bool {
    return backend.r_notify_cancel(&(*f).p, key)
}

// A PHOTO FROM THE SYSTEM (FirnChat's picture button, 25.09.2026):
//   pick_image(f)       open the system's picker (gallery, camera). False:
//                       this system has none for a Firn program here
//                       (X11, Windows, Osum: not yet -- honestly false).
//   pick_poll(f)        0 nothing asked, 1 the picker is open, 2 a photo
//                       is here, 3 none was chosen, 4 it could not be read;
//                       -1: this system has no picker (ask it once to know
//                       whether a picture button makes sense)
//   pick_take(f, out, cap, n, w, h)  the photo as a JPEG (at most 1600 px
//                       on the long side, upright, at most 190 kB) into
//                       out; its size and pixel size
//   image_decode(f, p, n, w, h, out) JPEG / PNG / WebP octets as w x h
//                       RGBA pixels into out (w * h * 4). False: this
//                       system cannot decode for us (no codec here).
// ====================================================== THE CLIPBOARD
//
// OpenPlan LIB-006. `mime` is a MIME type: "text/plain;charset=utf-8"
// for text (also "text/plain"), anything else for a program's own
// formats ("application/x-openplan+json", "image/png"). A copy offers one
// or more types: every `clipboard_set` adds one (or replaces it), and
// the next copy starts over once another program has taken the
// clipboard. `clipboard_get` asks the owner -- which may be this program.
// `clipboard_types` lists what is offered, one type per line.
// A backend without a system clipboard answers false/0 (fUi then keeps an
// internal one).
fn clipboard_set(f: *mut Window, mime: str, p: u64, n: usize) -> bool {
    return backend.r_clip_set(&(*f).p, mime, p, n)
}

fn clipboard_get(f: *mut Window, mime: str, out: *mut rt.Buf) -> bool {
    return backend.r_clip_get(&(*f).p, mime, out)
}

fn clipboard_types(f: *mut Window, out: *mut rt.Buf) -> usize {
    return backend.r_clip_types(&(*f).p, out)
}

fn clipboard_clear(f: *mut Window) {
    backend.r_clip_clear(&(*f).p)
}

fn pick_image(f: *mut Window) -> bool {
    return backend.r_pick_image(&(*f).p)
}

fn pick_poll(f: *mut Window) -> i32 {
    return backend.r_pick_poll(&(*f).p)
}

fn pick_take(f: *mut Window, out: u64, cap: usize, n: *mut usize, w: *mut usize,
    h: *mut usize) -> bool {
    return backend.r_pick_take(&(*f).p, out, cap, n, w, h)
}

fn image_decode(f: *mut Window, p: u64, n: usize, w: usize, h: usize,
    out: u64) -> bool {
    return backend.r_image_decode(&(*f).p, p, n, w, h, out)
}

// ===================================================================
// fUi tempo, stage 2b -- THE GPU OF THE WINDOW
// ===================================================================
//
// A window can offer its GPU to the program: `gpu_open` makes a GL context
// for it (OpenGL ES 3 -- on Android through EGL, lib/window/android.fi)
// and fills `api`, a *mut gl.GlApi of lib/paint/gl.fi, with the calls;
// fUi's renderer (lib/fui/gpu.fi) then draws the program's canvas on the
// GPU and `gpu_swap` shows it. False: this system has no GPU way for a
// Firn program yet (X11, Windows, Osum: honestly false) -- the program
// keeps painting in memory and pushing the picture with `image`.
//
//   gpu_place(f, out)  out[0..4]: where the content lies on the surface
//                      (x, y) and the surface's size (w, h)
//   gpu_lost(f)        the context was lost: open the renderer again
fn gpu_open(f: *mut Window, api: u64) -> bool {
    return backend.r_gpu_open(&(*f).p, api)
}

fn gpu_swap(f: *mut Window) -> bool {
    return backend.r_gpu_swap(&(*f).p)
}

fn gpu_close(f: *mut Window) {
    backend.r_gpu_close(&(*f).p)
}

fn gpu_place(f: *mut Window, out: u64) {
    backend.r_gpu_place(&(*f).p, out)
}

fn gpu_lost(f: *mut Window) -> bool {
    return backend.r_gpu_lost(&(*f).p)
}
