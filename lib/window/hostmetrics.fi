// SPDX-License-Identifier: MPL-2.0
// lib/window/hostmetrics.fi -- W44-c: THE HOST'S SAFE AREA (insets) AND TEXT SCALE, as pure functions.
//
// No window, no syscall: everything a backend (x11.fi, win32.fi, android.fi) has to compute from what the system tells it lives
// here, so tools/fui/hostmetrics_main.fi can pin it without a display.
//
//   INSETS      how far the system bars (panel, taskbar, status bar, notch) cover the window on each side, in device pixels:
//               `insets_overlap` = the window rectangle against the work area (X11 _NET_WORKAREA, Win32 SPI_GETWORKAREA).
//   TEXT SCALE  the user's "make text bigger" setting as per mille (1000 = 100 %): Windows TextScaleFactor (percent, 100..225),
//               GNOME text-scaling-factor (a decimal like 1.25), Android fontScale (a float).
//
// Both are OPT-IN in the toolkit (app.follow_host): nothing in here changes a layout by itself.
import std.rt

export {
    SCALE_MIN, SCALE_MAX,
    insets_overlap, insets_screen, parse_number, parse_scale_permille, parse_insets,
    scale_from_percent, scale_from_factor, inset_points, scale_text_px,
    // r382 (Android): what the JNI answers become
    insets_clamp, insets_minus_content, insets_same, insets_from_ints, DISPLAY_CUTOUT_MASK, INSET_TYPES_ALL,
}

// A text scale outside this range is a broken setting, not a wish (Windows allows 100..225 %, GNOME 0.5..3.0).
const SCALE_MIN: usize = 500
const SCALE_MAX: usize = 3000

// The window rectangle (wx, wy, ww, wh) against the work area (ax, ay, aw, ah), both in screen pixels. out = left, top, right,
// bottom: how much of the window lies OUTSIDE the work area on that side (under a panel). Each side is clamped to 0 .. half the
// window. false = the window is not on this work area (its centre lies outside): the answer would be wrong, so none is given.
fn insets_overlap(wx: i64, wy: i64, ww: i64, wh: i64, ax: i64, ay: i64, aw: i64, ah: i64, out: *mut [f64; 4]) -> bool {
    (*out)[0] = 0.0
    (*out)[1] = 0.0
    (*out)[2] = 0.0
    (*out)[3] = 0.0
    if ww <= 0 || wh <= 0 || aw <= 0 || ah <= 0 {
        return false
    }
    let cx: i64 = wx + ww / 2
    let cy: i64 = wy + wh / 2
    if cx < ax || cx >= ax + aw || cy < ay || cy >= ay + ah {
        return false
    }
    var l: i64 = ax - wx
    var t: i64 = ay - wy
    var r: i64 = (wx + ww) - (ax + aw)
    var b: i64 = (wy + wh) - (ay + ah)
    if l < 0 { l = 0 }
    if t < 0 { t = 0 }
    if r < 0 { r = 0 }
    if b < 0 { b = 0 }
    if l > ww / 2 { l = ww / 2 }
    if r > ww / 2 { r = ww / 2 }
    if t > wh / 2 { t = wh / 2 }
    if b > wh / 2 { b = wh / 2 }
    (*out)[0] = l as f64
    (*out)[1] = t as f64
    (*out)[2] = r as f64
    (*out)[3] = b as f64
    return true
}

// The same for a window that covers the whole screen (sw x sh at 0,0): the bars of the screen = the work area's margins.
fn insets_screen(sw: i64, sh: i64, ax: i64, ay: i64, aw: i64, ah: i64, out: *mut [f64; 4]) -> bool {
    return insets_overlap(0, 0, sw, sh, ax, ay, aw, ah, out)
}

// One decimal number (optional sign, digits, optional '.' digits) starting at byte `start` of p[0..n]; leading blanks and quotes
// are skipped. Returns the index after the number, 0 = no number there. The value goes to *out.
fn parse_number(p: u64, n: usize, start: usize, out: *mut f64) -> usize {
    var i: usize = start
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 32 as u8 || c == 9 as u8 || c == 39 as u8 || c == 34 as u8 {
            i = i + 1
        } else {
            break
        }
    }
    var neg: bool = false
    if i < n && rt.ld8(p, i) == 45 as u8 {
        neg = true
        i = i + 1
    } else if i < n && rt.ld8(p, i) == 43 as u8 {
        i = i + 1
    }
    var v: f64 = 0.0
    var digits: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c >= 48 as u8 && c <= 57 as u8 {
            v = v * 10.0 + ((c as u32 - 48 as u32) as f64)
            digits = digits + 1
            i = i + 1
        } else {
            break
        }
    }
    if i < n && rt.ld8(p, i) == 46 as u8 {
        i = i + 1
        var f: f64 = 0.1
        while i < n {
            let c: u8 = rt.ld8(p, i)
            if c >= 48 as u8 && c <= 57 as u8 {
                v = v + ((c as u32 - 48 as u32) as f64) * f
                f = f / 10.0
                digits = digits + 1
                i = i + 1
            } else {
                break
            }
        }
    }
    if digits == 0 {
        return 0
    }
    if neg {
        v = 0.0 - v
    }
    *out = v
    return i
}

// A scale FACTOR (1.0 = 100 %) to per mille, clamped to SCALE_MIN..SCALE_MAX. 0 = not a usable number.
fn scale_from_factor(f: f64) -> usize {
    if f <= 0.0 {
        return 0
    }
    var p: f64 = f * 1000.0 + 0.5
    if p < SCALE_MIN as f64 { p = SCALE_MIN as f64 }
    if p > SCALE_MAX as f64 { p = SCALE_MAX as f64 }
    return p as usize
}

// A percentage (Windows TextScaleFactor: 100..225) to per mille. 0 = not usable.
fn scale_from_percent(pc: usize) -> usize {
    if pc == 0 {
        return 0
    }
    var p: usize = pc * 10
    if p < SCALE_MIN { p = SCALE_MIN }
    if p > SCALE_MAX { p = SCALE_MAX }
    return p
}

// The text of a setting ("1.25", "'1.25'", "1.0\n", "uint32 125") to per mille: the FIRST number in it is taken (a leading word is
// skipped). 0 = no number. Values below 10 are factors, values from 10 on are percentages (125 = 1.25).
fn parse_scale_permille(p: u64, n: usize) -> usize {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if (c >= 48 as u8 && c <= 57 as u8) || c == 46 as u8 {
            break
        }
        if (c >= 65 as u8 && c <= 90 as u8) || (c >= 97 as u8 && c <= 122 as u8) {
            // a word such as "uint32": skip all of it, its digits are no value
            while i < n {
                let d: u8 = rt.ld8(p, i)
                if (d >= 65 as u8 && d <= 90 as u8) || (d >= 97 as u8 && d <= 122 as u8) || (d >= 48 as u8 && d <= 57 as u8) {
                    i = i + 1
                } else {
                    break
                }
            }
        } else {
            i = i + 1
        }
    }
    if i >= n {
        return 0
    }
    var v: f64 = 0.0
    if parse_number(p, n, i, &v) == 0 {
        return 0
    }
    if v >= 10.0 {
        return scale_from_factor(v / 100.0)
    }
    return scale_from_factor(v)
}

// "left,top,right,bottom" (FUI_INSETS=0,40,0,30; any separator that is not part of a number): four non-negative numbers into out.
// false (and out untouched) when fewer than four numbers are there or one is negative.
fn parse_insets(p: u64, n: usize, out: *mut [f64; 4]) -> bool {
    var v: [f64; 4] = [0.0; 4]
    var i: usize = 0
    var k: usize = 0
    while k < 4 {
        while i < n {
            let c: u8 = rt.ld8(p, i)
            if (c >= 48 as u8 && c <= 57 as u8) || c == 45 as u8 || c == 46 as u8 {
                break
            }
            i = i + 1
        }
        if i >= n {
            return false
        }
        var x: f64 = 0.0
        let e: usize = parse_number(p, n, i, &x)
        if e == 0 || x < 0.0 {
            return false
        }
        v[k] = x
        i = e
        k = k + 1
    }
    (*out)[0] = v[0]
    (*out)[1] = v[1]
    (*out)[2] = v[2]
    (*out)[3] = v[3]
    return true
}

// Device pixels to design points at the UI scale `ui_permille` (the theme's scale), rounded to the nearest point.
fn inset_points(px: f64, ui_permille: usize) -> i64 {
    if px <= 0.0 || ui_permille == 0 {
        return 0
    }
    return (px * 1000.0 / (ui_permille as f64) + 0.5) as i64
}

// A font size in device points scaled by the text scale (per mille), rounded half up, never 0 for a size > 0. 1000 = unchanged.
fn scale_text_px(px: usize, text_permille: usize) -> usize {
    if text_permille == 1000 || px == 0 || text_permille == 0 {
        return px
    }
    let v: usize = (px * text_permille + 500) / 1000
    if v == 0 {
        return 1
    }
    return v
}

// ---------------------------------------------------------------------------------------------------------------------------
// r382 -- ANDROID: what lib/android/hostinfo.fi reads over JNI (WindowInsets, Configuration.fontScale) is turned into the setters'
// values HERE, as pure functions, so tools/fui/hostmetrics_main.fi pins them without a phone.
// ---------------------------------------------------------------------------------------------------------------------------

// WindowInsets.Type bits (Android 11+, android.view.WindowInsets.Type): statusBars 1, navigationBars 2, captionBar 4, ime 8,
// displayCutout 128. getInsets(mask) answers the per-side maximum over all types in the mask.
const INSET_TYPES_ALL: i32 = 143 // 1 | 2 | 4 | 8 | 128: bars + caption + keyboard + cutout
const DISPLAY_CUTOUT_MASK: i32 = 128

// Four platform ints (Insets.left/top/right/bottom or getSystemWindowInsetLeft..) to out: negative = 0 (the platform never means it,
// a broken answer must not shrink the layout), each side at most half the window (w x h, 0 = unknown: no limit).
fn insets_from_ints(l: i32, t: i32, r: i32, b: i32, w: usize, h: usize, out: *mut [f64; 4]) {
    var v: [i64; 4] = [l as i64, t as i64, r as i64, b as i64]
    var i: usize = 0
    while i < 4 {
        if v[i] < 0 { v[i] = 0 }
        i = i + 1
    }
    if w > 0 {
        let hw: i64 = (w / 2) as i64
        if v[0] > hw { v[0] = hw }
        if v[2] > hw { v[2] = hw }
    }
    if h > 0 {
        let hh: i64 = (h / 2) as i64
        if v[1] > hh { v[1] = hh }
        if v[3] > hh { v[3] = hh }
    }
    (*out)[0] = v[0] as f64
    (*out)[1] = v[1] as f64
    (*out)[2] = v[2] as f64
    (*out)[3] = v[3] as f64
}

// The same limits for values that are already numbers.
fn insets_clamp(ins: *mut [f64; 4], w: usize, h: usize) {
    insets_from_ints((*ins)[0] as i32, (*ins)[1] as i32, (*ins)[2] as i32, (*ins)[3] as i32, w, h, ins)
}

// The part of the system insets the WINDOW HAS NOT ALREADY LEFT OUT. NativeActivity reports a content rectangle
// (onContentRectChanged); lib/window/android.fi paints only inside it (ox, oy, cw, ch inside the w x h window). Insets that lie
// inside that margin are handled -- giving them to the toolkit again would pad twice. cw = 0 = no content rectangle: the whole
// window is content and the insets pass unchanged. out may be the same array as `ins`.
fn insets_minus_content(ins: *mut [f64; 4], ox: usize, oy: usize, cw: usize, ch: usize, w: usize, h: usize, out: *mut [f64; 4]) {
    var l: f64 = (*ins)[0]
    var t: f64 = (*ins)[1]
    var r: f64 = (*ins)[2]
    var b: f64 = (*ins)[3]
    if cw > 0 && ch > 0 {
        var mr: usize = 0
        var mb: usize = 0
        if w > ox + cw { mr = w - (ox + cw) }
        if h > oy + ch { mb = h - (oy + ch) }
        l = l - (ox as f64)
        t = t - (oy as f64)
        r = r - (mr as f64)
        b = b - (mb as f64)
        if l < 0.0 { l = 0.0 }
        if t < 0.0 { t = 0.0 }
        if r < 0.0 { r = 0.0 }
        if b < 0.0 { b = 0.0 }
    }
    (*out)[0] = l
    (*out)[1] = t
    (*out)[2] = r
    (*out)[3] = b
}

// Are two inset sets the same (to a quarter pixel)? The change test for "send EV_THEME".
fn insets_same(a: *mut [f64; 4], b: *mut [f64; 4]) -> bool {
    var i: usize = 0
    while i < 4 {
        var d: f64 = (*a)[i] - (*b)[i]
        if d < 0.0 { d = 0.0 - d }
        if d > 0.25 {
            return false
        }
        i = i + 1
    }
    return true
}
