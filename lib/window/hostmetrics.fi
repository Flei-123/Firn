// SPDX-License-Identifier: MPL-2.0
// lib/window/hostmetrics.fi -- W44-c: THE HOST'S SAFE AREA (insets) AND TEXT SCALE, as pure functions.
//
// No window, no syscall: everything a backend (x11.fi, win32.fi, android.fi) has to compute from what the system tells it lives
// here, so tools/fui/hostmetrics_main.fi can pin it without a display.
//
//   INSETS      how far the system bars (panel, taskbar, status bar, notch) cover the window on each side, in device pixels:
//               `insets_overlap` = the window rectangle against the work area (X11 _NET_WORKAREA, Win32 SPI_GETWORKAREA).
//   TEXT SCALE  the user's "make text bigger" setting as per mille (1000 = 100 %): Windows TextScaleFactor (percent, 100..225),
//               GNOME text-scaling-factor (a decimal like 1.25), Android fontScale (a float).
//
// Both are OPT-IN in the toolkit (app.follow_host): nothing in here changes a layout by itself.
import std.rt

export {
    SCALE_MIN, SCALE_MAX,
    insets_overlap, insets_screen, parse_number, parse_scale_permille, parse_insets,
    scale_from_percent, scale_from_factor, inset_points, scale_text_px,
    // r382 (Android): what the JNI answers become
    insets_clamp, insets_minus_content, insets_same, insets_from_ints, DISPLAY_CUTOUT_MASK, INSET_TYPES_ALL,
    // W45-d: THE MONITOR OF THE WINDOW
    MONITORS_MAX, le32, le16s, monitorinfo_parse, randr_monitors_parse, monitor_pick, area_clip, insets_on_monitor,
    // W47-b (r386): THE BARS OF ONE MONITOR from the clients' struts (_NET_WM_STRUT_PARTIAL / _NET_WM_STRUT)
    STRUTS_MAX, STRUT_FAR, strut_parse, strut_insets, insets_on_monitor_struts,
}

// A text scale outside this range is a broken setting, not a wish (Windows allows 100..225 %, GNOME 0.5..3.0).
const SCALE_MIN: usize = 500
const SCALE_MAX: usize = 3000

// The window rectangle (wx, wy, ww, wh) against the work area (ax, ay, aw, ah), both in screen pixels. out = left, top, right,
// bottom: how much of the window lies OUTSIDE the work area on that side (under a panel). Each side is clamped to 0 .. half the
// window. false = the window is not on this work area (its centre lies outside): the answer would be wrong, so none is given.
fn insets_overlap(wx: i64, wy: i64, ww: i64, wh: i64, ax: i64, ay: i64, aw: i64, ah: i64, out: *mut [f64; 4]) -> bool {
    (*out)[0] = 0.0
    (*out)[1] = 0.0
    (*out)[2] = 0.0
    (*out)[3] = 0.0
    if ww <= 0 || wh <= 0 || aw <= 0 || ah <= 0 {
        return false
    }
    let cx: i64 = wx + ww / 2
    let cy: i64 = wy + wh / 2
    if cx < ax || cx >= ax + aw || cy < ay || cy >= ay + ah {
        return false
    }
    var l: i64 = ax - wx
    var t: i64 = ay - wy
    var r: i64 = (wx + ww) - (ax + aw)
    var b: i64 = (wy + wh) - (ay + ah)
    if l < 0 { l = 0 }
    if t < 0 { t = 0 }
    if r < 0 { r = 0 }
    if b < 0 { b = 0 }
    if l > ww / 2 { l = ww / 2 }
    if r > ww / 2 { r = ww / 2 }
    if t > wh / 2 { t = wh / 2 }
    if b > wh / 2 { b = wh / 2 }
    (*out)[0] = l as f64
    (*out)[1] = t as f64
    (*out)[2] = r as f64
    (*out)[3] = b as f64
    return true
}

// The same for a window that covers the whole screen (sw x sh at 0,0): the bars of the screen = the work area's margins.
fn insets_screen(sw: i64, sh: i64, ax: i64, ay: i64, aw: i64, ah: i64, out: *mut [f64; 4]) -> bool {
    return insets_overlap(0, 0, sw, sh, ax, ay, aw, ah, out)
}

// One decimal number (optional sign, digits, optional '.' digits) starting at byte `start` of p[0..n]; leading blanks and quotes
// are skipped. Returns the index after the number, 0 = no number there. The value goes to *out.
fn parse_number(p: u64, n: usize, start: usize, out: *mut f64) -> usize {
    var i: usize = start
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 32 as u8 || c == 9 as u8 || c == 39 as u8 || c == 34 as u8 {
            i = i + 1
        } else {
            break
        }
    }
    var neg: bool = false
    if i < n && rt.ld8(p, i) == 45 as u8 {
        neg = true
        i = i + 1
    } else if i < n && rt.ld8(p, i) == 43 as u8 {
        i = i + 1
    }
    var v: f64 = 0.0
    var digits: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c >= 48 as u8 && c <= 57 as u8 {
            v = v * 10.0 + ((c as u32 - 48 as u32) as f64)
            digits = digits + 1
            i = i + 1
        } else {
            break
        }
    }
    if i < n && rt.ld8(p, i) == 46 as u8 {
        i = i + 1
        var f: f64 = 0.1
        while i < n {
            let c: u8 = rt.ld8(p, i)
            if c >= 48 as u8 && c <= 57 as u8 {
                v = v + ((c as u32 - 48 as u32) as f64) * f
                f = f / 10.0
                digits = digits + 1
                i = i + 1
            } else {
                break
            }
        }
    }
    if digits == 0 {
        return 0
    }
    if neg {
        v = 0.0 - v
    }
    *out = v
    return i
}

// A scale FACTOR (1.0 = 100 %) to per mille, clamped to SCALE_MIN..SCALE_MAX. 0 = not a usable number.
fn scale_from_factor(f: f64) -> usize {
    if f <= 0.0 {
        return 0
    }
    var p: f64 = f * 1000.0 + 0.5
    if p < SCALE_MIN as f64 { p = SCALE_MIN as f64 }
    if p > SCALE_MAX as f64 { p = SCALE_MAX as f64 }
    return p as usize
}

// A percentage (Windows TextScaleFactor: 100..225) to per mille. 0 = not usable.
fn scale_from_percent(pc: usize) -> usize {
    if pc == 0 {
        return 0
    }
    var p: usize = pc * 10
    if p < SCALE_MIN { p = SCALE_MIN }
    if p > SCALE_MAX { p = SCALE_MAX }
    return p
}

// The text of a setting ("1.25", "'1.25'", "1.0\n", "uint32 125") to per mille: the FIRST number in it is taken (a leading word is
// skipped). 0 = no number. Values below 10 are factors, values from 10 on are percentages (125 = 1.25).
fn parse_scale_permille(p: u64, n: usize) -> usize {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if (c >= 48 as u8 && c <= 57 as u8) || c == 46 as u8 {
            break
        }
        if (c >= 65 as u8 && c <= 90 as u8) || (c >= 97 as u8 && c <= 122 as u8) {
            // a word such as "uint32": skip all of it, its digits are no value
            while i < n {
                let d: u8 = rt.ld8(p, i)
                if (d >= 65 as u8 && d <= 90 as u8) || (d >= 97 as u8 && d <= 122 as u8) || (d >= 48 as u8 && d <= 57 as u8) {
                    i = i + 1
                } else {
                    break
                }
            }
        } else {
            i = i + 1
        }
    }
    if i >= n {
        return 0
    }
    var v: f64 = 0.0
    if parse_number(p, n, i, &v) == 0 {
        return 0
    }
    if v >= 10.0 {
        return scale_from_factor(v / 100.0)
    }
    return scale_from_factor(v)
}

// "left,top,right,bottom" (FUI_INSETS=0,40,0,30; any separator that is not part of a number): four non-negative numbers into out.
// false (and out untouched) when fewer than four numbers are there or one is negative.
fn parse_insets(p: u64, n: usize, out: *mut [f64; 4]) -> bool {
    var v: [f64; 4] = [0.0; 4]
    var i: usize = 0
    var k: usize = 0
    while k < 4 {
        while i < n {
            let c: u8 = rt.ld8(p, i)
            if (c >= 48 as u8 && c <= 57 as u8) || c == 45 as u8 || c == 46 as u8 {
                break
            }
            i = i + 1
        }
        if i >= n {
            return false
        }
        var x: f64 = 0.0
        let e: usize = parse_number(p, n, i, &x)
        if e == 0 || x < 0.0 {
            return false
        }
        v[k] = x
        i = e
        k = k + 1
    }
    (*out)[0] = v[0]
    (*out)[1] = v[1]
    (*out)[2] = v[2]
    (*out)[3] = v[3]
    return true
}

// Device pixels to design points at the UI scale `ui_permille` (the theme's scale), rounded to the nearest point.
fn inset_points(px: f64, ui_permille: usize) -> i64 {
    if px <= 0.0 || ui_permille == 0 {
        return 0
    }
    return (px * 1000.0 / (ui_permille as f64) + 0.5) as i64
}

// A font size in device points scaled by the text scale (per mille), rounded half up, never 0 for a size > 0. 1000 = unchanged.
fn scale_text_px(px: usize, text_permille: usize) -> usize {
    if text_permille == 1000 || px == 0 || text_permille == 0 {
        return px
    }
    let v: usize = (px * text_permille + 500) / 1000
    if v == 0 {
        return 1
    }
    return v
}

// ---------------------------------------------------------------------------------------------------------------------------
// r382 -- ANDROID: what lib/android/hostinfo.fi reads over JNI (WindowInsets, Configuration.fontScale) is turned into the setters'
// values HERE, as pure functions, so tools/fui/hostmetrics_main.fi pins them without a phone.
// ---------------------------------------------------------------------------------------------------------------------------

// WindowInsets.Type bits (Android 11+, android.view.WindowInsets.Type): statusBars 1, navigationBars 2, captionBar 4, ime 8,
// displayCutout 128. getInsets(mask) answers the per-side maximum over all types in the mask.
const INSET_TYPES_ALL: i32 = 143 // 1 | 2 | 4 | 8 | 128: bars + caption + keyboard + cutout
const DISPLAY_CUTOUT_MASK: i32 = 128

// Four platform ints (Insets.left/top/right/bottom or getSystemWindowInsetLeft..) to out: negative = 0 (the platform never means it,
// a broken answer must not shrink the layout), each side at most half the window (w x h, 0 = unknown: no limit).
fn insets_from_ints(l: i32, t: i32, r: i32, b: i32, w: usize, h: usize, out: *mut [f64; 4]) {
    var v: [i64; 4] = [l as i64, t as i64, r as i64, b as i64]
    var i: usize = 0
    while i < 4 {
        if v[i] < 0 { v[i] = 0 }
        i = i + 1
    }
    if w > 0 {
        let hw: i64 = (w / 2) as i64
        if v[0] > hw { v[0] = hw }
        if v[2] > hw { v[2] = hw }
    }
    if h > 0 {
        let hh: i64 = (h / 2) as i64
        if v[1] > hh { v[1] = hh }
        if v[3] > hh { v[3] = hh }
    }
    (*out)[0] = v[0] as f64
    (*out)[1] = v[1] as f64
    (*out)[2] = v[2] as f64
    (*out)[3] = v[3] as f64
}

// The same limits for values that are already numbers.
fn insets_clamp(ins: *mut [f64; 4], w: usize, h: usize) {
    insets_from_ints((*ins)[0] as i32, (*ins)[1] as i32, (*ins)[2] as i32, (*ins)[3] as i32, w, h, ins)
}

// The part of the system insets the WINDOW HAS NOT ALREADY LEFT OUT. NativeActivity reports a content rectangle
// (onContentRectChanged); lib/window/android.fi paints only inside it (ox, oy, cw, ch inside the w x h window). Insets that lie
// inside that margin are handled -- giving them to the toolkit again would pad twice. cw = 0 = no content rectangle: the whole
// window is content and the insets pass unchanged. out may be the same array as `ins`.
fn insets_minus_content(ins: *mut [f64; 4], ox: usize, oy: usize, cw: usize, ch: usize, w: usize, h: usize, out: *mut [f64; 4]) {
    var l: f64 = (*ins)[0]
    var t: f64 = (*ins)[1]
    var r: f64 = (*ins)[2]
    var b: f64 = (*ins)[3]
    if cw > 0 && ch > 0 {
        var mr: usize = 0
        var mb: usize = 0
        if w > ox + cw { mr = w - (ox + cw) }
        if h > oy + ch { mb = h - (oy + ch) }
        l = l - (ox as f64)
        t = t - (oy as f64)
        r = r - (mr as f64)
        b = b - (mb as f64)
        if l < 0.0 { l = 0.0 }
        if t < 0.0 { t = 0.0 }
        if r < 0.0 { r = 0.0 }
        if b < 0.0 { b = 0.0 }
    }
    (*out)[0] = l
    (*out)[1] = t
    (*out)[2] = r
    (*out)[3] = b
}

// Are two inset sets the same (to a quarter pixel)? The change test for "send EV_THEME".
fn insets_same(a: *mut [f64; 4], b: *mut [f64; 4]) -> bool {
    var i: usize = 0
    while i < 4 {
        var d: f64 = (*a)[i] - (*b)[i]
        if d < 0.0 { d = 0.0 - d }
        if d > 0.25 {
            return false
        }
        i = i + 1
    }
    return true
}
// ======================================================================
// W45-d: THE MONITOR OF THE WINDOW (multi-monitor)
// ======================================================================
//
// `insets_overlap` compares the window with ONE work area. With several monitors that has to be the work area of the monitor the
// window is on, not the primary one's (Win32 SPI_GETWORKAREA) and not the union of all (X11 _NET_WORKAREA): else a window on the
// second monitor either gets no answer or is measured against the wrong bars. Everything the backends need to do that, as pure
// byte/number functions (no display, no syscall): tools/fui/hostmetrics_main.fi pins them with synthetic replies.

const MONITORS_MAX: usize = 8

fn le32(p: u64, off: usize) -> i64 {
    var v: i64 = (rt.ld8(p, off) as i64) | ((rt.ld8(p, off + 1) as i64) << 8) | ((rt.ld8(p, off + 2) as i64) << 16)
    | ((rt.ld8(p, off + 3) as i64) << 24)
    if v >= 2147483648 {
        v = v - 4294967296
    }
    return v
}

// A signed 16-bit little-endian value.
fn le16s(p: u64, off: usize) -> i64 {
    var v: i64 = (rt.ld8(p, off) as i64) | ((rt.ld8(p, off + 1) as i64) << 8)
    if v >= 32768 {
        v = v - 65536
    }
    return v
}

// A Win32 MONITORINFO (40 bytes: cbSize, rcMonitor l t r b, rcWork l t r b, dwFlags, all 32 bit) into mon / work = x, y, w, h.
// false = not a MONITORINFO (cbSize != 40), an empty monitor or a work area that is not inside its monitor.
fn monitorinfo_parse(p: u64, n: usize, mon: *mut [i64; 4], work: *mut [i64; 4]) -> bool {
    if n < 40 || le32(p, 0) != 40 {
        return false
    }
    let ml: i64 = le32(p, 4)
    let mt: i64 = le32(p, 8)
    let mr: i64 = le32(p, 12)
    let mb: i64 = le32(p, 16)
    let wl: i64 = le32(p, 20)
    let wt: i64 = le32(p, 24)
    let wr: i64 = le32(p, 28)
    let wb: i64 = le32(p, 32)
    if mr <= ml || mb <= mt || wr <= wl || wb <= wt {
        return false
    }
    if wl < ml || wt < mt || wr > mr || wb > mb {
        return false
    }
    (*mon)[0] = ml
    (*mon)[1] = mt
    (*mon)[2] = mr - ml
    (*mon)[3] = mb - mt
    (*work)[0] = wl
    (*work)[1] = wt
    (*work)[2] = wr - wl
    (*work)[3] = wb - wt
    return true
}

// The reply of RandR 1.5 GetMonitors (minor opcode 42): 32 byte header (timestamp at 8, nMonitors at 12 -- W47-b fixed: it was read at 8, the timestamp, so a live server's reply gave none), then per monitor 24 bytes (name atom 4,
// primary 1, automatic 1, nOutput 2 at 6, x 2 at 8, y 2 at 10, width 2 at 12, height 2 at 14, mm 4+4) + 4 bytes per output. out = x, y, w, h per monitor, at
// most MONITORS_MAX. Returns how many were read; 0 = not a usable reply.
fn randr_monitors_parse(p: u64, n: usize, out: *mut [i64; 32]) -> usize {
    if n < 32 || rt.ld8(p, 0) != 1 as u8 {
        return 0
    }
    let cnt: i64 = le32(p, 12)
    if cnt <= 0 || cnt > 64 {
        return 0
    }
    var at: usize = 32
    var k: usize = 0
    var i: i64 = 0
    while i < cnt {
        if at + 24 > n {
            break
        }
        let nout: usize = (rt.ld8(p, at + 6) as usize) | ((rt.ld8(p, at + 7) as usize) << 8)
        let x: i64 = le16s(p, at + 8)
        let y: i64 = le16s(p, at + 10)
        let w: i64 = (rt.ld8(p, at + 12) as i64) | ((rt.ld8(p, at + 13) as i64) << 8)
        let h: i64 = (rt.ld8(p, at + 14) as i64) | ((rt.ld8(p, at + 15) as i64) << 8)
        if w > 0 && h > 0 && k < MONITORS_MAX {
            (*out)[k * 4] = x
            (*out)[k * 4 + 1] = y
            (*out)[k * 4 + 2] = w
            (*out)[k * 4 + 3] = h
            k = k + 1
        }
        at = at + 24 + nout * 4
        i = i + 1
    }
    return k
}

// Which of `cnt` monitors (x, y, w, h each) the window (wx, wy, ww, wh) is on: the one holding its centre, else the one with the
// biggest overlap. -1 = none (no monitors, empty window, or no overlap at all).
fn monitor_pick(list: *mut [i64; 32], cnt: usize, wx: i64, wy: i64, ww: i64, wh: i64) -> i64 {
    if cnt == 0 || ww <= 0 || wh <= 0 {
        return 0 - 1
    }
    let cx: i64 = wx + ww / 2
    let cy: i64 = wy + wh / 2
    var best: i64 = 0 - 1
    var best_a: i64 = 0
    var k: usize = 0
    while k < cnt && k < MONITORS_MAX {
        let mx: i64 = (*list)[k * 4]
        let my: i64 = (*list)[k * 4 + 1]
        let mw: i64 = (*list)[k * 4 + 2]
        let mh: i64 = (*list)[k * 4 + 3]
        if cx >= mx && cx < mx + mw && cy >= my && cy < my + mh {
            return k as i64
        }
        var ox: i64 = wx + ww
        if mx + mw < ox { ox = mx + mw }
        var ox0: i64 = wx
        if mx > ox0 { ox0 = mx }
        var oy: i64 = wy + wh
        if my + mh < oy { oy = my + mh }
        var oy0: i64 = wy
        if my > oy0 { oy0 = my }
        if ox > ox0 && oy > oy0 {
            let ar: i64 = (ox - ox0) * (oy - oy0)
            if ar > best_a {
                best_a = ar
                best = k as i64
            }
        }
        k = k + 1
    }
    return best
}

// The part of a work area (ax, ay, aw, ah) that lies on a monitor (mx, my, mw, mh): the work area of THAT monitor when the system
// only knows one rectangle for all (X11 _NET_WORKAREA). false = they do not touch.
fn area_clip(mx: i64, my: i64, mw: i64, mh: i64, ax: i64, ay: i64, aw: i64, ah: i64, out: *mut [i64; 4]) -> bool {
    var x0: i64 = mx
    if ax > x0 { x0 = ax }
    var y0: i64 = my
    if ay > y0 { y0 = ay }
    var x1: i64 = mx + mw
    if ax + aw < x1 { x1 = ax + aw }
    var y1: i64 = my + mh
    if ay + ah < y1 { y1 = ay + ah }
    if x1 <= x0 || y1 <= y0 {
        return false
    }
    (*out)[0] = x0
    (*out)[1] = y0
    (*out)[2] = x1 - x0
    (*out)[3] = y1 - y0
    return true
}

// The insets of a window against ITS monitor's work area (`area_clip` of the monitor and the system work area, or the monitor's own
// when the system gives one). Same output as `insets_overlap`; false = the window is on no monitor.
fn insets_on_monitor(list: *mut [i64; 32], cnt: usize, wx: i64, wy: i64, ww: i64, wh: i64, ax: i64, ay: i64, aw: i64, ah: i64,
    out: *mut [f64; 4]) -> bool {
    (*out)[0] = 0.0
    (*out)[1] = 0.0
    (*out)[2] = 0.0
    (*out)[3] = 0.0
    let k: i64 = monitor_pick(list, cnt, wx, wy, ww, wh)
    if k < 0 {
        return false
    }
    var wa: [i64; 4] = [0; 4]
    if !area_clip((*list)[(k as usize) * 4], (*list)[(k as usize) * 4 + 1], (*list)[(k as usize) * 4 + 2], (*list)[(k as usize) * 4 + 3],
        ax, ay, aw, ah, &wa) {
        // the system work area does not touch this monitor: the monitor has no bars
        wa[0] = (*list)[(k as usize) * 4]
        wa[1] = (*list)[(k as usize) * 4 + 1]
        wa[2] = (*list)[(k as usize) * 4 + 2]
        wa[3] = (*list)[(k as usize) * 4 + 3]
    }
    return insets_overlap(wx, wy, ww, wh, wa[0], wa[1], wa[2], wa[3], out)
}

// ---- W47-b (r386): the bars of ONE monitor, from the struts of the top-level clients ------------------------------------------
// X11 _NET_WORKAREA is ONE rectangle for all monitors: a panel on monitor B only shrinks the rectangle for A as well. The honest
// source is what each dock/panel reserves: _NET_WM_STRUT_PARTIAL = 12 CARDINALs (left, right, top, bottom, then the span along the
// edge for each: left_start_y, left_end_y, right_start_y, right_end_y, top_start_x, top_end_x, bottom_start_x, bottom_end_x) or the
// old _NET_WM_STRUT = 4 CARDINALs (left, right, top, bottom, the whole edge). All values are measured from the edge of the SCREEN
// (the root window, all monitors together), NOT from the monitor: a left strut of 40 does not touch a monitor that starts at x=1920.

const STRUTS_MAX: usize = 32
const STRUT_FAR: i64 = 2147483647

// One strut property value (p[0..n], 32 bit little-endian CARDINALs) as 12 numbers into list[k*12 ..]. 12 values = PARTIAL, 4 or
// more = the old form (spans = the whole edge). A strut SIZE that is negative or absurd (> 65535) refuses the whole property; spans are unsigned.
// false = not a strut (too short, bad number, all four sizes zero, k out of range); nothing is written then.
fn strut_parse(p: u64, n: usize, list: *mut [i64; 384], k: usize) -> bool {
    if k >= STRUTS_MAX || n < 16 {
        return false
    }
    var v: [i64; 12] = [0; 12]
    var i: usize = 0
    let partial: bool = n >= 48
    var cnt: usize = 4
    if partial { cnt = 12 }
    while i < cnt {
        v[i] = le32(p, i * 4)
        if i >= 4 && v[i] < 0 {
            // a span end of 0xFFFFFFFF ("to the end") is unsigned
            v[i] = v[i] + 4294967296
        }
        if i < 4 && (v[i] < 0 || v[i] > 65535) {
            return false
        }
        i = i + 1
    }
    if v[0] == 0 && v[1] == 0 && v[2] == 0 && v[3] == 0 {
        // all zero = "no strut" (many ordinary windows set it): not kept, so it never hides the work area
        return false
    }
    if !partial {
        v[4] = 0
        v[5] = STRUT_FAR
        v[6] = 0
        v[7] = STRUT_FAR
        v[8] = 0
        v[9] = STRUT_FAR
        v[10] = 0
        v[11] = STRUT_FAR
    }
    i = 0
    while i < 12 {
        (*list)[k * 12 + i] = v[i]
        i = i + 1
    }
    return true
}

// Do the spans [a0, a1] and [b0, b1] (both inclusive) share a pixel?
fn span_hits(a0: i64, a1: i64, b0: i64, b1: i64) -> bool {
    return a0 <= b1 && a1 >= b0
}

// How far the struts of `cnt` clients (12 numbers each) cover the monitor (mx, my, mw, mh) of a screen sw x sh: out = left, top,
// right, bottom, in pixels, the biggest of all clients per side. A strut counts only where its span meets the monitor's side and
// it reaches into the monitor from the SCREEN edge. true = at least one side is covered.
fn strut_insets(list: *mut [i64; 384], cnt: usize, sw: i64, sh: i64, mx: i64, my: i64, mw: i64, mh: i64, out: *mut [i64; 4]) -> bool {
    (*out)[0] = 0
    (*out)[1] = 0
    (*out)[2] = 0
    (*out)[3] = 0
    var any: bool = false
    var k: usize = 0
    while k < cnt && k < STRUTS_MAX {
        let b: usize = k * 12
        let l: i64 = (*list)[b]
        let r: i64 = (*list)[b + 1]
        let t: i64 = (*list)[b + 2]
        let bo: i64 = (*list)[b + 3]
        if l > 0 && span_hits((*list)[b + 4], (*list)[b + 5], my, my + mh - 1) {
            var v: i64 = l - mx
            if v > mw { v = mw }
            if v > (*out)[0] { (*out)[0] = v }
        }
        if r > 0 && span_hits((*list)[b + 6], (*list)[b + 7], my, my + mh - 1) {
            var v: i64 = (mx + mw) - (sw - r)
            if v > mw { v = mw }
            if v > (*out)[2] { (*out)[2] = v }
        }
        if t > 0 && span_hits((*list)[b + 8], (*list)[b + 9], mx, mx + mw - 1) {
            var v: i64 = t - my
            if v > mh { v = mh }
            if v > (*out)[1] { (*out)[1] = v }
        }
        if bo > 0 && span_hits((*list)[b + 10], (*list)[b + 11], mx, mx + mw - 1) {
            var v: i64 = (my + mh) - (sh - bo)
            if v > mh { v = mh }
            if v > (*out)[3] { (*out)[3] = v }
        }
        k = k + 1
    }
    if (*out)[0] > 0 || (*out)[1] > 0 || (*out)[2] > 0 || (*out)[3] > 0 {
        any = true
    }
    return any
}

// The insets of a window (wx, wy, ww, wh) against the work area of ITS monitor, made of the struts that cover that monitor (the
// monitor's rectangle minus `strut_insets`). Same output as `insets_overlap`. false = the window is on no monitor, or no monitors.
fn insets_on_monitor_struts(list: *mut [i64; 32], cnt: usize, sw: i64, sh: i64, struts: *mut [i64; 384], ns: usize,
    wx: i64, wy: i64, ww: i64, wh: i64, out: *mut [f64; 4]) -> bool {
    (*out)[0] = 0.0
    (*out)[1] = 0.0
    (*out)[2] = 0.0
    (*out)[3] = 0.0
    let k: i64 = monitor_pick(list, cnt, wx, wy, ww, wh)
    if k < 0 {
        return false
    }
    let mx: i64 = (*list)[(k as usize) * 4]
    let my: i64 = (*list)[(k as usize) * 4 + 1]
    let mw: i64 = (*list)[(k as usize) * 4 + 2]
    let mh: i64 = (*list)[(k as usize) * 4 + 3]
    var si: [i64; 4] = [0; 4]
    strut_insets(struts, ns, sw, sh, mx, my, mw, mh, &si)
    var aw: i64 = mw - si[0] - si[2]
    var ah: i64 = mh - si[1] - si[3]
    if aw < 1 { aw = 1 }
    if ah < 1 { ah = 1 }
    return insets_overlap(wx, wy, ww, wh, mx + si[0], my + si[1], aw, ah, out)
}
