// SPDX-License-Identifier: MPL-2.0
import std.rt
import font.fontprov

export {
    pm_advance, pm_pair, pm_vmetrics, pm_reset, pm_stats, pm_unit_ok,
    ST_ADV_HIT, ST_ADV_MISS, ST_PAIR_HIT, ST_PAIR_MISS, ST_VM_HIT, ST_VM_MISS,
}

const ADV_BITS: u64 = 13
const PAIR_BITS: u64 = 13
const VM_BITS: u64 = 9
const OCCUPIED: u64 = 9223372036854775808
const MULT: u64 = 11400714819323198485

const ST_ADV_HIT: usize = 0
const ST_ADV_MISS: usize = 1
const ST_PAIR_HIT: usize = 2
const ST_PAIR_MISS: usize = 3
const ST_VM_HIT: usize = 4
const ST_VM_MISS: usize = 5

static mut G_ADV: u64 = 0
static mut G_PAIR: u64 = 0
static mut G_VM: u64 = 0
static mut G_ST: [u64; 6] = [0; 6]

#[no_gc]
fn pm_stats(i: usize) -> u64 { return G_ST[i] }

#[no_gc]
fn size_q(size: f64) -> u64 {
    var v: f64 = size * 64.0 + 0.5
    if v < 0.0 { v = 0.0 }
    if v > 4000000.0 { v = 4000000.0 }
    return v as u64
}

#[no_gc]
fn slot(k: u64, bits: u64) -> u64 {
    return ((k *% MULT) >> (64 - bits)) * 32
}

#[no_gc]
fn table(cur: u64, bits: u64) -> u64 {
    if cur != 0 { return cur }
    return rt.heap_alloc(((1 as u64) << bits) as usize * 32)
}

#[no_gc]
fn pm_reset() {
    if G_ADV != 0 { rt.heap_free(G_ADV, ((1 as u64) << ADV_BITS) as usize * 32) }
    if G_PAIR != 0 { rt.heap_free(G_PAIR, ((1 as u64) << PAIR_BITS) as usize * 32) }
    if G_VM != 0 { rt.heap_free(G_VM, ((1 as u64) << VM_BITS) as usize * 32) }
    G_ADV = 0
    G_PAIR = 0
    G_VM = 0
    var i: usize = 0
    while i < 6 {
        G_ST[i] = 0
        i = i + 1
    }
}

#[no_gc]
fn pm_unit_ok(cp: u32) -> bool {
    if cp < 32 { return false }
    if cp >= 127 && cp < 160 { return false }
    if cp >= 0x2600 && cp <= 0x27BF { return false }
    if cp >= 0x1F000 && cp <= 0x1FAFF { return false }
    if cp >= 0xE000 && cp <= 0xF8FF { return false }
    if cp >= 0xFE00 && cp <= 0xFE0F { return false }
    if cp == 0x200D { return false }
    return true
}

#[no_gc]
fn pm_advance(cp: u32, size: f64, weight: u32) -> f64 {
    if !pm_unit_ok(cp) { return 0.0 - 1.0 }
    G_ADV = table(G_ADV, ADV_BITS)
    if G_ADV == 0 { return 0.0 - 1.0 }
    let k: u64 = (cp as u64) | ((weight as u64) << 24) | (size_q(size) << 36) | OCCUPIED
    let e: u64 = G_ADV + slot(k, ADV_BITS)
    if *(e as *mut u64) == k {
        G_ST[ST_ADV_HIT] = G_ST[ST_ADV_HIT] + 1
        return *((e + 8) as *mut f64)
    }
    G_ST[ST_ADV_MISS] = G_ST[ST_ADV_MISS] + 1
    var v: f64 = fontprov.prov_advance(cp, size, weight)
    if v != v || v < 0.0 { v = 0.0 }
    *(e as *mut u64) = k
    *((e + 8) as *mut f64) = v
    return v
}

#[no_gc]
fn pm_pair(a: u32, b: u32, size: f64, weight: u32) -> f64 {
    if a == 32 || b == 32 { return 0.0 }
    G_PAIR = table(G_PAIR, PAIR_BITS)
    if G_PAIR == 0 { return 0.0 }
    let k: u64 = ((a as u64) * 2097152 + (b as u64)) | ((weight as u64) << 42) | OCCUPIED
    let k2: u64 = size_q(size)
    let e: u64 = G_PAIR + slot(k ^ (k2 *% 2654435761), PAIR_BITS)
    if *(e as *mut u64) == k && *((e + 16) as *mut u64) == k2 {
        G_ST[ST_PAIR_HIT] = G_ST[ST_PAIR_HIT] + 1
        return *((e + 8) as *mut f64)
    }
    G_ST[ST_PAIR_MISS] = G_ST[ST_PAIR_MISS] + 1
    var v: f64 = fontprov.prov_pair(a, b, size, weight)
    if v != v { v = 0.0 }
    *(e as *mut u64) = k
    *((e + 8) as *mut f64) = v
    *((e + 16) as *mut u64) = k2
    return v
}

#[no_gc]
fn pm_vmetrics(size: f64, weight: u32, asc: *mut f64, dsc: *mut f64) -> bool {
    G_VM = table(G_VM, VM_BITS)
    if G_VM == 0 { return false }
    let k2: u64 = size_q(size)
    let k: u64 = (weight as u64) | OCCUPIED
    let e: u64 = G_VM + slot(k ^ (k2 *% 2654435761), VM_BITS)
    if *(e as *mut u64) == k && *((e + 16) as *mut u64) == k2 {
        G_ST[ST_VM_HIT] = G_ST[ST_VM_HIT] + 1
        let a: f64 = *((e + 8) as *mut f64)
        *asc = a
        *dsc = *((e + 24) as *mut f64)
        return a >= 0.0
    }
    G_ST[ST_VM_MISS] = G_ST[ST_VM_MISS] + 1
    var buf: [f64; 2] = [0.0; 2]
    let ok: bool = fontprov.prov_vmetrics(size, weight, &buf[0])
    var a2: f64 = buf[0]
    if !ok { a2 = 0.0 - 1.0 }
    *(e as *mut u64) = k
    *((e + 8) as *mut f64) = a2
    *((e + 16) as *mut u64) = k2
    *((e + 24) as *mut f64) = buf[1]
    *asc = a2
    *dsc = buf[1]
    return ok
}
