// SPDX-License-Identifier: MPL-2.0
// lib/font/metrics.fi -- THE ROAD BACK FROM THE FONT TO THE LAYOUT.
//
// Round B2 laid text out with a made-up font: every character exactly one
// em wide, ascent 0.8 em, descent 0.2 em. Round B3 draws with a real one.
// If those two disagree, the picture is wrong in the one way that is
// hardest to see and hardest to explain: the line BREAKS where the layout
// thought the line was full, and the letters run past that point or stop
// short of it, and every box below stands right while the text inside it
// stands wrong.
//
// So there is exactly ONE place that answers "how wide is this
// character", and both halves ask it: this file. The layout asks it
// through `layout.box`, the painter asks it directly, and neither has a
// second opinion.
//
// THE HANDLE IS A `u64`, not a `Gc[...]` and not a `*mut FontSet`. The box
// tree is garbage collected and the font is not -- it is a block of octets
// that was read once and lives as long as the process. Carrying a raw
// address through the box tree keeps the collector out of it entirely; the
// value 0 means "no font", and that is not an error but the round B2
// behaviour, which the WPT corpus of round B2 is measured against.
import font.ttf
import font.fontprov
import font.platmetrics

export {
    FontSet,
    fontset_new, fontset_load, fontset_font, fontset_ok,
    fm_ascent, fm_descent, fm_xheight, fm_advance, fm_kern,
    fm_present, fm_upem,
    fontset_platform, fm_weight, fm_has, fm_gid, fm_cp, GID_PLATFORM,
}

// `std.math` is not `#[no_gc]` and this file has to be, so the one
// rounding it needs stands here. Guarded against the range where the
// checked `as i64` of round 72 would panic.
#[no_gc]
fn round_px(v: f64) -> f64 {
    if v != v || v > 9.0e15 || v < 0.0 - 9.0e15 {
        return 0.0
    }
    let x: f64 = v + 0.5
    let t: f64 = (x as i64) as f64
    if t > x {
        return t - 1.0
    }
    return t
}

const GID_PLATFORM: u32 = 2147483648

struct FontSet {
    f: ttf.Font,
    ok: usize,
    pw: usize,
}

#[no_gc]
fn fontset_new() -> FontSet {
    return FontSet { f: ttf.font_new(), ok: 0, pw: 0 }
}

#[no_gc]
fn fontset_load(fs: *mut FontSet, data: *mut u8, len: usize) -> bool {
    if !ttf.font_init(&(*fs).f, data, len) {
        (*fs).ok = 0
        return false
    }
    (*fs).ok = 1
    return true
}

#[no_gc]
fn fontset_ok(fs: *mut FontSet) -> bool {
    return (*fs).ok != 0
}

#[no_gc]
fn fontset_font(fm: u64) -> *mut ttf.Font {
    return fm as *mut ttf.Font
}

#[no_gc]
fn fm_present(fm: u64) -> bool {
    if fm == 0 {
        return false
    }
    let fs: *mut FontSet = fm as *mut FontSet
    return (*fs).ok != 0
}

#[no_gc]
fn fm_upem(fm: u64) -> f64 {
    if !fm_present(fm) {
        return 1000.0
    }
    let fs: *mut FontSet = fm as *mut FontSet
    return ttf.font_upem(&(*fs).f) as f64
}

// The ascent, in pixels and rounded to a whole one -- rounded because
// round 61 rounds it and because a baseline between two pixels makes
// every line of a page half a pixel blurry.
#[no_gc]
fn fm_ascent(fm: u64, size: f64) -> f64 {
    if !fm_present(fm) {
        return round_px(size * 0.8)
    }
    let fs: *mut FontSet = fm as *mut FontSet
    let pw: u32 = fm_weight(fm)
    if pw != 0 {
        var pa: f64 = 0.0
        var pd: f64 = 0.0
        if platmetrics.pm_vmetrics(size, pw, &pa, &pd) {
            return round_px(pa)
        }
    }
    let up: f64 = ttf.font_upem(&(*fs).f) as f64
    return round_px((ttf.font_ascent(&(*fs).f) as f64) * size / up)
}

#[no_gc]
fn fm_descent(fm: u64, size: f64) -> f64 {
    if !fm_present(fm) {
        return round_px(size * 0.2)
    }
    let fs: *mut FontSet = fm as *mut FontSet
    let pw: u32 = fm_weight(fm)
    if pw != 0 {
        var pa: f64 = 0.0
        var pd: f64 = 0.0
        if platmetrics.pm_vmetrics(size, pw, &pa, &pd) {
            return round_px(pd)
        }
    }
    let up: f64 = ttf.font_upem(&(*fs).f) as f64
    return round_px((ttf.font_descent(&(*fs).f) as f64) * size / up)
}

// `vertical-align: middle` needs half an x-height. Round 61 used the
// ascent for it and this does the same, so that the one place where the
// two could differ is not silently a third value.
#[no_gc]
fn fm_xheight(fm: u64, size: f64) -> f64 {
    return fm_ascent(fm, size)
}

// THE ADVANCE OF ONE CHARACTER -- the number the whole line breaking rests
// on. NOT rounded: a browser does not round per glyph, and rounding 0.61
// px away per character moves the end of a 60 character line by seven
// pixels.
#[no_gc]
fn fm_advance(fm: u64, size: f64, cp: u32) -> f64 {
    if !fm_present(fm) {
        return size
    }
    let fs: *mut FontSet = fm as *mut FontSet
    let pw: u32 = fm_weight(fm)
    if pw != 0 {
        let pa: f64 = platmetrics.pm_advance(cp, size, pw)
        if pa >= 0.0 {
            return pa
        }
    }
    let up: f64 = ttf.font_upem(&(*fs).f) as f64
    let gid: u32 = ttf.font_glyph_for(&(*fs).f, cp)
    return (ttf.font_advance(&(*fs).f, gid) as f64) * size / up
}

// The kerning between two characters, in pixels. Zero without a `kern`
// table -- and zero is the right answer then, not a guess.
#[no_gc]
fn fm_kern(fm: u64, size: f64, a: u32, b: u32) -> f64 {
    if !fm_present(fm) {
        return 0.0
    }
    let fs: *mut FontSet = fm as *mut FontSet
    let pw: u32 = fm_weight(fm)
    if pw != 0 && platmetrics.pm_unit_ok(a) && platmetrics.pm_unit_ok(b) {
        return platmetrics.pm_pair(a, b, size, pw)
    }
    if !ttf.font_has_kern(&(*fs).f) {
        return 0.0
    }
    let up: f64 = ttf.font_upem(&(*fs).f) as f64
    let ga: u32 = ttf.font_glyph_for(&(*fs).f, a)
    let gb: u32 = ttf.font_glyph_for(&(*fs).f, b)
    return (ttf.font_kern(&(*fs).f, ga, gb) as f64) * size / up
}

#[no_gc]
fn fontset_platform(dst: *mut FontSet, src: *mut FontSet, weight: usize) {
    *dst = *src
    (*dst).pw = weight
}

#[no_gc]
fn fm_weight(fm: u64) -> u32 {
    if fm == 0 || !fontprov.platform_on() {
        return 0 as u32
    }
    let fs: *mut FontSet = fm as *mut FontSet
    return (*fs).pw as u32
}

#[no_gc]
fn fm_has(fm: u64, cp: u32) -> bool {
    if !fm_present(fm) {
        return false
    }
    let fs: *mut FontSet = fm as *mut FontSet
    let pw: u32 = fm_weight(fm)
    if pw != 0 && platmetrics.pm_unit_ok(cp) {
        return true
    }
    return ttf.font_glyph_for(&(*fs).f, cp) != 0 as u32
}

#[no_gc]
fn fm_gid(fm: u64, cp: u32) -> u32 {
    let fs: *mut FontSet = fm as *mut FontSet
    let pw: u32 = fm_weight(fm)
    if pw != 0 && platmetrics.pm_unit_ok(cp) {
        return cp | GID_PLATFORM
    }
    return ttf.font_glyph_for(&(*fs).f, cp)
}

#[no_gc]
fn fm_cp(gid: u32) -> u32 {
    return gid & 2147483647 as u32
}
