// SPDX-License-Identifier: MPL-2.0
// lib/font/fallback.fi -- font fallback chain and painter (round MC-E, S6 + E2).
//
// A CHAIN is an ordered list of fonts (Latin, CJK, symbols, emoji ...). For each
// code point the FIRST font whose cmap maps it to a real glyph (gid != 0) wins.
// Text is cut into RUNS of one font, and a run never splits an extended grapheme
// cluster (UAX #29, lib/str/grapheme.fi): ZWJ sequences, variation selectors, skin
// tone modifiers, flags, combining marks, Hangul syllables stay together. The font of
// a cluster is the first one that has its first code point; a cluster that asks for
// emoji presentation (U+FE0F, ZWJ, skin tone, flag, keycap) takes the K_EMOJI font
// first. A code point that NO font has is drawn with font 0's .notdef.
//
//   chain_new / chain_add(c, font, kind)     up to 6 fonts; kind K_LATIN/K_CJK/K_SYMBOL/K_EMOJI
//   chain_pick(c, cp, prefer_emoji)          index of the font that draws `cp`, or NO_FONT
//   chain_segment(c, p, n, runs, max)        UTF-8 text -> runs (offset, length, font index)
//   chain_width(c, ctx, p, n, px)            advance in pixels (whole text)
//   chain_paint(ctx, c, p, n, px, x, base, fg, shadow, dst, dw, dh)
//                                            paint into a 0xAABBGGRR pixel buffer (u32 per pixel),
//                                            source-over; COLR v0 glyphs in their palette colours,
//                                            CBDT/CBLC bitmap glyphs (lib/font/cbdt.fi) scaled
//   chain_free(c)                            releases the grapheme table (chain_new maps it)
//
// HONEST LIMITS: no shaping (no GSUB ligatures: a ZWJ emoji family or a flag is drawn as
// its parts side by side), no bidi, no kerning across runs; sbix and COLR v1 are NOT drawn.
// See docs/FONT-FALLBACK.md.
import std.rt
import font.ttf
import font.raster
import font.colr
import font.cbdt
import str.grapheme

export {
    Chain, Run, PaintCtx, chain_new, chain_add, chain_pick, chain_segment,
    chain_width, chain_paint, chain_free, ctx_new, ctx_free, utf8_next,
    K_LATIN, K_CJK, K_SYMBOL, K_EMOJI, NO_FONT, CHAIN_MAX,
}

const K_LATIN: u32 = 0
const K_CJK: u32 = 1
const K_SYMBOL: u32 = 2
const K_EMOJI: u32 = 3
const CHAIN_MAX: usize = 6
const NO_FONT: usize = 255
const SCRATCH: usize = 1 << 20
const WIN_MAX: usize = 256

struct Chain {
    n: usize,
    fonts: [*mut ttf.Font; 6],
    kind: [u32; 6],
    gb: u64,
}

struct Run {
    off: usize,
    len: usize,
    font: usize,
}

struct PaintCtx {
    ra: raster.Raster,
    rbuf: u64,
    rcap: usize,
    scratch: u64,
}

fn chain_new() -> Chain {
    return Chain { n: 0, fonts: [0 as *mut ttf.Font; 6], kind: [0; 6], gb: grapheme.gb_map() }
}

fn chain_free(c: *mut Chain) {
    grapheme.gb_free((*c).gb)
    (*c).gb = 0
}

fn chain_add(c: *mut Chain, f: *mut ttf.Font, kind: u32) -> bool {
    if (*c).n >= CHAIN_MAX {
        return false
    }
    (*c).fonts[(*c).n] = f
    (*c).kind[(*c).n] = kind
    (*c).n = (*c).n + 1
    return true
}

// Decodes one UTF-8 sequence at `i` (strict: no overlongs, no surrogates). Malformed input gives
// U+FFFD and advances 1. The same decoder the cluster finder uses, so runs and clusters agree.
fn utf8_next(p: u64, n: usize, i: usize, len: *mut usize) -> u32 {
    return grapheme.gb_decode(p, n, i, len)
}

// Code points inside a cluster that draw nothing of their own (the base glyph carries them).
fn is_extender(cp: u32) -> bool {
    return cp == 8205 as u32 // ZWJ
    || (cp >= 65024 as u32 && cp <= 65039 as u32) // variation selectors
    || (cp >= 127995 as u32 && cp <= 127999 as u32) // skin tones
    || (cp >= 917760 as u32 && cp <= 917999 as u32)
    || (cp >= 917536 as u32 && cp <= 917631 as u32) // tag characters (subdivision flags)
    || cp == 8419 as u32 // combining enclosing keycap
}

fn chain_pick(c: *mut Chain, cp: u32, prefer_emoji: bool) -> usize {
    var i: usize = 0
    if prefer_emoji {
        while i < (*c).n {
            if (*c).kind[i] == K_EMOJI && ttf.font_glyph_for((*c).fonts[i], cp) != 0 as u32 {
                return i
            }
            i = i + 1
        }
        i = 0
    }
    while i < (*c).n {
        if ttf.font_glyph_for((*c).fonts[i], cp) != 0 as u32 {
            return i
        }
        i = i + 1
    }
    return NO_FONT
}

// Does the cluster [off, off+len) ask for emoji presentation? (VS16, ZWJ, skin tone, flag, keycap)
fn wants_emoji(p: u64, n: usize, off: usize, len: usize) -> bool {
    var j: usize = 0
    while j < len {
        var l: usize = 1
        let cp: u32 = utf8_next(p, n, off + j, &l)
        if cp == 65039 as u32 || cp == 8205 as u32 || cp == 8419 as u32
        || (cp >= 127995 as u32 && cp <= 127999 as u32)
        || (cp >= 127462 as u32 && cp <= 127487 as u32) {
            return true
        }
        j = j + l
    }
    return false
}

fn chain_segment(c: *mut Chain, p: u64, n: usize, runs: *mut [Run; 64], max: usize) -> usize {
    var nr: usize = 0
    var i: usize = 0
    while i < n {
        var k: usize = grapheme.gb_next((*c).gb, p, n, i)
        if k == 0 {
            k = 1
        }
        var l: usize = 1
        let cp: u32 = utf8_next(p, n, i, &l)
        let pref: bool = wants_emoji(p, n, i, k)
        var fi: usize = chain_pick(c, cp, pref)
        if fi == NO_FONT {
            fi = 0
        }
        if nr > 0 && (*runs)[nr - 1].font == fi && !pref {
            (*runs)[nr - 1].len = (*runs)[nr - 1].len + k
        } else if nr < max {
            (*runs)[nr].off = i
            (*runs)[nr].len = k
            (*runs)[nr].font = fi
            nr = nr + 1
        }
        i = i + k
    }
    return nr
}

fn ctx_new() -> PaintCtx {
    let cap: usize = raster.raster_bytes_needed(WIN_MAX, WIN_MAX)
    var ctx: PaintCtx = PaintCtx { ra: raster.raster_new(), rbuf: rt.heap_alloc(cap), rcap: cap,
        scratch: rt.heap_alloc(SCRATCH) }
    raster.raster_attach(&ctx.ra, ctx.rbuf as *mut u8, cap)
    return ctx
}

fn ctx_free(x: *mut PaintCtx) {
    rt.heap_free((*x).rbuf, (*x).rcap)
    rt.heap_free((*x).scratch, SCRATCH)
}

fn scale_of(f: *mut ttf.Font, px: f64) -> f64 {
    return px / (ttf.font_upem(f) as f64)
}

// Advance of the glyph for `cp` in pixels, 0 for extenders after the first.
fn glyph_adv(c: *mut Chain, fi: usize, cp: u32, px: f64) -> f64 {
    let f: *mut ttf.Font = (*c).fonts[fi]
    let gid: u32 = ttf.font_glyph_for(f, cp)
    return (ttf.font_advance(f, gid) as f64) * scale_of(f, px)
}

fn chain_width(c: *mut Chain, p: u64, n: usize, px: f64) -> f64 {
    var runs: [Run; 64] = [Run { off: 0, len: 0, font: 0 }; 64]
    let nr: usize = chain_segment(c, p, n, &runs, 64)
    var w: f64 = 0.0
    var r: usize = 0
    while r < nr {
        var j: usize = 0
        while j < runs[r].len {
            var l: usize = 1
            let cp: u32 = utf8_next(p, n, runs[r].off + j, &l)
            if !is_extender(cp) {
                w = w + glyph_adv(c, runs[r].font, cp, px)
            }
            j = j + l
        }
        r = r + 1
    }
    return w
}

// Source-over of colour `col` (0xAABBGGRR) scaled by coverage `cov` onto the pixel.
fn blend(dst: u64, dw: i32, dh: i32, x: i32, y: i32, col: u32, cov: f64) {
    if x < 0 || y < 0 || x >= dw || y >= dh {
        return
    }
    let a: f64 = ((col >> 24 as u32) as f64) / 255.0 * cov
    if a <= 0.0 {
        return
    }
    let at: usize = (y as usize) * (dw as usize) + (x as usize)
    let d: u32 = rt.ld32(dst, at)
    let sr: f64 = (col & 255 as u32) as f64
    let sg: f64 = ((col >> 8 as u32) & 255 as u32) as f64
    let sb: f64 = ((col >> 16 as u32) & 255 as u32) as f64
    let dr: f64 = (d & 255 as u32) as f64
    let dg: f64 = ((d >> 8 as u32) & 255 as u32) as f64
    let db: f64 = ((d >> 16 as u32) & 255 as u32) as f64
    let r: u32 = ((sr * a + dr * (1.0 - a)) + 0.5) as u32
    let g: u32 = ((sg * a + dg * (1.0 - a)) + 0.5) as u32
    let b: u32 = ((sb * a + db * (1.0 - a)) + 0.5) as u32
    rt.st32(dst, at, 0xFF000000 as u32 | (b << 16 as u32) | (g << 8 as u32) | r)
}

// Rasterise one outline glyph into the context's window and blend it.
fn paint_outline(x: *mut PaintCtx, f: *mut ttf.Font, gid: u32, px: f64, penx: f64, base: f64,
    col: u32, dst: u64, dw: i32, dh: i32) {
    let sc: f64 = scale_of(f, px)
    let asc: i32 = ttf.font_ascent(f)
    let des: i32 = ttf.font_descent(f)
    var top: f64 = base - (asc as f64) * sc - 2.0
    // font_descent is kept POSITIVE: the window is ascent + descent tall (it was ascent - descent,
    // which cut every glyph off a few pixels above the baseline)
    var wy: f64 = (asc as f64 + des as f64) * sc + 5.0
    var wx: f64 = (ttf.font_advance(f, gid) as f64) * sc + 6.0
    var left: f64 = penx - 2.0
    if wx > (WIN_MAX as f64) {
        wx = WIN_MAX as f64
    }
    if wy > (WIN_MAX as f64) {
        wy = WIN_MAX as f64
    }
    let ix: f64 = (left as i32) as f64
    let iy: f64 = (top as i32) as f64
    let w: usize = (wx as usize) + 1
    let h: usize = (wy as usize) + 1
    if !raster.raster_begin(&(*x).ra, ix, iy, w, h) {
        return
    }
    ttf.font_outline(f, gid, &(*x).ra, penx, base, sc, (*x).scratch as *mut u8, SCRATCH, 0)
    raster.raster_finish(&(*x).ra)
    var yy: usize = 0
    while yy < h {
        var xx: usize = 0
        while xx < w {
            let cv: f64 = raster.raster_cov(&(*x).ra, xx, yy)
            if cv > 0.0 {
                var c2: f64 = cv
                if c2 > 1.0 {
                    c2 = 1.0
                }
                blend(dst, dw, dh, (ix as i32) + (xx as i32), (iy as i32) + (yy as i32), col, c2)
            }
            xx = xx + 1
        }
        yy = yy + 1
    }
}

// Paints `n` octets of UTF-8 text with the chain; `base` = baseline y. Returns the advance in pixels.
fn chain_paint(x: *mut PaintCtx, c: *mut Chain, p: u64, n: usize, px: f64, x0: f64, base: f64,
    fg: u32, shadow: u32, dst: u64, dw: i32, dh: i32) -> f64 {
    var runs: [Run; 64] = [Run { off: 0, len: 0, font: 0 }; 64]
    let nr: usize = chain_segment(c, p, n, &runs, 64)
    var pen: f64 = x0
    var r: usize = 0
    while r < nr {
        let f: *mut ttf.Font = (*c).fonts[runs[r].font]
        let colour_font: bool = colr.colr_ok(f)
        var cbk: usize = cbdt.CB_NONE
        if cbdt.cbdt_ok(f) {
            cbk = cbdt.cbdt_pick(f, px)
        }
        var j: usize = 0
        while j < runs[r].len {
            var l: usize = 1
            let cp: u32 = utf8_next(p, n, runs[r].off + j, &l)
            j = j + l
            if is_extender(cp) {
                continue
            }
            let gid: u32 = ttf.font_glyph_for(f, cp)
            var gids: [u32; 32] = [0; 32]
            var idx: [u32; 32] = [0; 32]
            var nl: usize = 0
            var bitmap: bool = false
            if cbk != cbdt.CB_NONE {
                bitmap = cbdt.cbdt_paint(f, cbk, gid, px, pen, base, dst, dw, dh)
            }
            if colour_font && !bitmap {
                nl = colr.colr_layers(f, gid, &gids, &idx)
            }
            if bitmap {
                // pixels already in place
            } else if nl > 0 {
                var k: usize = 0
                while k < nl {
                    var col: u32 = fg
                    if idx[k] != colr.FOREGROUND {
                        if !colr.cpal_color(f, 0, idx[k], &col) {
                            col = fg
                        }
                    }
                    paint_outline(x, f, gids[k], px, pen, base, col, dst, dw, dh)
                    k = k + 1
                }
            } else {
                if (shadow >> 24 as u32) != 0 as u32 {
                    paint_outline(x, f, gid, px, pen + 1.0, base + 1.0, shadow, dst, dw, dh)
                }
                paint_outline(x, f, gid, px, pen, base, fg, dst, dw, dh)
            }
            pen = pen + (ttf.font_advance(f, gid) as f64) * scale_of(f, px)
        }
        r = r + 1
    }
    return pen - x0
}
