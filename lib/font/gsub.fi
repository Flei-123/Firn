// SPDX-License-Identifier: MPL-2.0
// lib/font/gsub.fi -- GLYPH SUBSTITUTION (OpenType GSUB), AS FAR AS A
// SURFACE NEEDS IT FOR ARABIC.
//
// ========================================================= WHY IT EXISTS
//
// An Arabic letter has up to four shapes -- isolated, at the start of a word,
// in the middle, at the end --, and which of them is painted
// is NOT in the text: in the text there always stands the same code point (U+0628
// BEH), the shape results from the neighbours. Which glyph of the
// font belongs to which shape is said by the font itself, in its
// GSUB table: the feature `init` replaces the base glyph by the
// initial glyph, `medi`, `fina` and `isol` correspondingly, and `rlig`
// fuses lam and alif into the ligature without which Arabic looks
// wrong. WHICH position gets which feature is calculated by
// lib/fui/shape.fi from the joining types of the UCD; this file
// only executes what the font says about it.
//
// ============================================================ WHAT IS READ
//
//   ScriptList    the script `arab`, its DefaultLangSys (languages are
//                 not distinguished -- a surface does not know whether
//                 a word is Urdu or Arabic)
//   FeatureList   isol, fina, init, medi, rlig, liga and the required
//                 feature of the LangSys
//   LookupList    type 1 (single substitution, format 1 and 2), type 4
//                 (ligature) and type 7 (the extension that points to one of
//                 the two)
//   Coverage      format 1 and 2
//   GDEF          the glyph class (format 1 and 2) -- for the
//                 lookup flag IgnoreMarks: a vowel sign between lam and
//                 alif must not prevent the ligature
//
//   Context       type 5 and 6 (context / chaining context), formats 1, 2
//                 and 3, with ClassDef: `gsub_context` finds the first rule
//                 that matches at a position and hands back its
//                 SubstLookupRecords (position + lookup number); the
//                 caller applies them (nested type 1, 2, 4 and again 5/6).
//   Multiple      type 2: one output replaces the glyph; SEVERAL outputs make
//                 the first the glyph of the position and the rest EXTRA
//                 glyphs of the same character (`gsub_x_insert`), painted
//                 behind it in reading direction. A sequence is the glyph of
//                 each position followed by its extras: context (5/6) and
//                 ligature (4) matching walk it by UNITS (`pos * UNIT + k`),
//                 so extras count as input, backtrack and lookahead and can be
//                 ligature components. An absorbed position that has extras
//                 keeps them (the first becomes its glyph). A type 2 sequence
//                 of 0 glyphs deletes the unit.
//   ccmp          is taken along (bit F_CCMP, every Arabic position); DejaVu
//                 carries two chaining lookups under it (Hebrew ayin with
//                 vowel, the tone letters U+02E5..).
//
//   Alternate     type 3: the glyph is replaced by its N-th alternative; N is
//                 the feature value (`gsub_alt_set`, default 1 = the first
//                 alternative, as HarfBuzz does for a feature that is on). A
//                 value above the number of alternatives changes nothing.
//   Reverse       type 8 (reverse chaining contextual single): backtrack and
//                 lookahead are coverages; the lookup runs over the sequence
//                 BACKWARD (last unit first), so the lookahead already sees
//                 what was substituted behind. Only at the top level -- as
//                 in HarfBuzz it cannot be the target of a context record.
//   Match end     after a context rule (5/6) matched, the walk goes on BEHIND
//                 THE END OF THE MATCHED INPUT (`gsub_match_end`), not at the
//                 next unit, shifted by the units that the records inserted or
//                 removed on the way (HarfBuzz apply_lookup). The edits are
//                 logged (`gsub_elog_*`) so that a record that is itself a
//                 context lookup shifts the outer records and the end too.
//
// WHAT IS NOT READ, and it is said here instead of silently missing: GPOS
// (the position of the vowel signs). How vowel signs nevertheless end up in
// the right place is stated in lib/fui/painter.fi at the bidi path.
//
// No allocation, no copy of the table: everything is read with every question
// from the octets of the font, exactly as in ttf.fi. `gsub_init`
// remembers only WHICH lookups apply for which feature.
import font.ttf

export {
    Gsub, gsub_new, gsub_init, gsub_ok, gsub_count,
    gsub_lookup_index, gsub_lookup_mask, gsub_lookup_type,
    gsub_lookup_ignores_marks, gsub_single, gsub_ligature,
    gsub_is_mark, gsub_context, gsub_act_count, gsub_act_pos,
    gsub_act_lookup, gsub_li_type, gsub_li_single, gsub_li_ligature,
    gsub_li_ignores_marks, gsub_context_li, gsub_open, gsub_multiple_len, gsub_multiple_glyph,
    gsub_x_reset, gsub_x_count, gsub_x_pos, gsub_x_gid, gsub_x_set,
    gsub_x_room, gsub_x_insert, MAX_EXTRA,
    UNIT, gsub_ligature_u, gsub_li_ligature_u, gsub_context_u,
    gsub_context_li_u, gsub_act_unit, gsub_x_cnt, gsub_x_index,
    gsub_x_remove, gsub_multiple_has, gsub_unit_gid, gsub_unit_next,
    gsub_alternate, gsub_li_alternate, gsub_alt_set, gsub_alt,
    gsub_reverse_u, gsub_li_reverse_u, gsub_match_hit, gsub_match_end,
    gsub_elog_reset, gsub_elog_len, gsub_elog_add, gsub_elog_unit,
    gsub_elog_count, MAX_ELOG,
    F_ISOL, F_FINA, F_INIT, F_MEDI, F_RLIG, F_LIGA, F_RQD, F_CCMP,
    MAX_LOOKUPS,
}

// The features as bits. isol/fina/init/medi apply only at positions with
// this shape, the other three at every Arabic position.
const F_ISOL: u32 = 1
const F_FINA: u32 = 2
const F_INIT: u32 = 4
const F_MEDI: u32 = 8
const F_RLIG: u32 = 16
const F_LIGA: u32 = 32
const F_RQD: u32 = 64
const F_CCMP: u32 = 128

// This many lookups `gsub_init` remembers at most. DejaVu Sans needs
// nine for `arab`.
const MAX_LOOKUPS: usize = 48

// The table of EXTRA glyphs (see `gsub_x_insert`) holds this many entries.
const MAX_EXTRA: usize = 64

// UNITS name one glyph of the sequence a shaping run holds: `pos * UNIT + k`,
// k = 0 is the glyph of the position, k >= 1 its k-th extra glyph. The
// sequence runs position by position, each position as glyph + extras.
// (MAX_EXTRA < UNIT.)
const UNIT: usize = 128

// The lookup flag IgnoreMarks from the lookup head.
const LF_IGNORE_MARKS: u32 = 8

struct Gsub {
    ok: usize,
    base: usize, // start of the GSUB table in the file
    lookups: usize, // start of the LookupList
    classdef: usize, // start of the glyph classes in GDEF, 0 = none
    n: usize,
    idx: [u16; 48], // Lookup-Nummern, aufsteigend (= Anwendungsfolge)
    mask: [u32; 48], // which features they apply to
    // Scratch of gsub_context (the question parameters and the answer).
    c_gids: u64,
    c_skip: u64,
    c_n: usize,
    c_ign: usize,
    c_mode: u32, // 1 glyphs, 2 classes, 3 coverages
    c_st: usize,
    c_cdb: usize,
    c_cdi: usize,
    c_cda: usize,
    ipos: [u32; 16], // the positions of the matched input glyphs
    act_pos: [u32; 8],
    act_li: [u32; 8],
    nact: usize,
    // The EXTRA glyphs: a multiple substitution (type 2) that makes several
    // glyphs of one makes the first the glyph of the position and puts the
    // rest here, as (position, glyph) in glyph order. Entries of one position
    // stand in the order of the glyphs; entries of different positions are
    // not sorted. Reset by `gsub_x_reset` at the start of every shaping run.
    xn: usize,
    xpos: [u32; 64],
    xgid: [u32; 64],
    // The last context question: did a rule match (also one without
    // records), and the unit behind its input.
    hit: usize,
    mend: usize,
    // Alternate substitution (type 3): which alternative (1 = first).
    alt: u32,
    // Log of the edits (insert / remove units) since `gsub_elog_reset`:
    // unit and count (0 = the unit was removed, c > 0 = c units were put
    // behind it).
    elen: usize,
    elog_u: [u32; 128],
    elog_c: [u32; 128],
}

const MAX_ELOG: usize = 128

#[no_gc]
fn gsub_new() -> Gsub {
    return Gsub {
        ok: 0, base: 0, lookups: 0, classdef: 0, n: 0,
        idx: [0; 48], mask: [0; 48],
        c_gids: 0, c_skip: 0, c_n: 0, c_ign: 0, c_mode: 0, c_st: 0,
        c_cdb: 0, c_cdi: 0, c_cda: 0, ipos: [0; 16],
        act_pos: [0; 8], act_li: [0; 8], nact: 0,
        xn: 0, xpos: [0; 64], xgid: [0; 64],
        hit: 0, mend: 0, alt: 1, elen: 0,
        elog_u: [0; 128], elog_c: [0; 128],
    }
}

#[no_gc]
fn gsub_ok(g: *mut Gsub) -> bool { return (*g).ok != 0 }

#[no_gc]
fn gsub_count(g: *mut Gsub) -> usize { return (*g).n }

#[no_gc]
fn gsub_lookup_index(g: *mut Gsub, k: usize) -> u32 {
    return (*g).idx[k] as u32
}

#[no_gc]
fn gsub_lookup_mask(g: *mut Gsub, k: usize) -> u32 {
    return (*g).mask[k]
}

#[no_gc]
fn u16at(f: *mut ttf.Font, off: usize) -> u32 {
    return ttf.font_u16(f, off)
}

#[no_gc]
fn tag_is(f: *mut ttf.Font, off: usize, a: u32, b: u32, c: u32,
    d: u32) -> bool {
    return u16at(f, off) == (a << 8 | b) && u16at(f, off + 2) == (c << 8 | d)
}

// Which feature bit does the entry at `rec` have (tag in four octets)?
#[no_gc]
fn feature_bit(f: *mut ttf.Font, rec: usize) -> u32 {
    if tag_is(f, rec, 105, 115, 111, 108) { return F_ISOL } // isol
    if tag_is(f, rec, 102, 105, 110, 97) { return F_FINA } // fina
    if tag_is(f, rec, 105, 110, 105, 116) { return F_INIT } // init
    if tag_is(f, rec, 109, 101, 100, 105) { return F_MEDI } // medi
    if tag_is(f, rec, 114, 108, 105, 103) { return F_RLIG } // rlig
    if tag_is(f, rec, 108, 105, 103, 97) { return F_LIGA } // liga
    if tag_is(f, rec, 99, 99, 109, 112) { return F_CCMP } // ccmp
    return 0
}

// Take up a lookup with feature `bit`; the list stays sorted
// ascending, a second feature for the same lookup is OR-ed in.
#[no_gc]
fn add_lookup(g: *mut Gsub, li: u32, bit: u32) {
    var k: usize = 0
    while k < (*g).n {
        if (*g).idx[k] as u32 == li {
            (*g).mask[k] = (*g).mask[k] | bit
            return
        }
        k = k + 1
    }
    if (*g).n >= MAX_LOOKUPS {
        return
    }
    var q: usize = (*g).n
    while q > 0 && (*g).idx[q - 1] as u32 > li {
        (*g).idx[q] = (*g).idx[q - 1]
        (*g).mask[q] = (*g).mask[q - 1]
        q = q - 1
    }
    (*g).idx[q] = li as u16
    (*g).mask[q] = bit
    (*g).n = (*g).n + 1
}

#[no_gc]
fn add_feature(f: *mut ttf.Font, g: *mut Gsub, flist: usize, fi: u32,
    bit: u32) {
    let nfeat: u32 = u16at(f, flist)
    if fi >= nfeat {
        return
    }
    let rec: usize = flist + 2 + (fi as usize) * 6
    let feat: usize = flist + u16at(f, rec + 4) as usize
    let nl: u32 = u16at(f, feat + 2)
    var k: u32 = 0
    while k < nl {
        add_lookup(g, u16at(f, feat + 4 + (k as usize) * 2), bit)
        k = k + 1
    }
}

// THE LIST OF LOOKUPS FOR THE SCRIPT `arab`. false if the font
// has no GSUB table or no `arab` in it -- then
// lib/fui/shape.fi takes the approximation via the presentation forms.
#[no_gc]
fn gsub_init(f: *mut ttf.Font, g: *mut Gsub) -> bool {
    (*g).ok = 0
    (*g).n = 0
    var o: usize = 0
    var l: usize = 0
    if !ttf.font_table(f, 71, 83, 85, 66, &o, &l) { // GSUB
        return false
    }
    (*g).base = o
    let slist: usize = o + u16at(f, o + 4) as usize
    let flist: usize = o + u16at(f, o + 6) as usize
    (*g).lookups = o + u16at(f, o + 8) as usize
    let ns: u32 = u16at(f, slist)
    var script: usize = 0
    var k: u32 = 0
    while k < ns {
        let rec: usize = slist + 2 + (k as usize) * 6
        if tag_is(f, rec, 97, 114, 97, 98) { // arab
            script = slist + u16at(f, rec + 4) as usize
        }
        k = k + 1
    }
    if script == 0 {
        return false
    }
    let dls: u32 = u16at(f, script)
    if dls == 0 as u32 {
        return false
    }
    let ls: usize = script + dls as usize
    let req: u32 = u16at(f, ls + 2)
    if req != 0xFFFF as u32 {
        add_feature(f, g, flist, req, F_RQD)
    }
    let nfi: u32 = u16at(f, ls + 4)
    var j: u32 = 0
    while j < nfi {
        let fi: u32 = u16at(f, ls + 6 + (j as usize) * 2)
        if fi < u16at(f, flist) {
            let rec2: usize = flist + 2 + (fi as usize) * 6
            let bit: u32 = feature_bit(f, rec2)
            if bit != 0 as u32 {
                add_feature(f, g, flist, fi, bit)
            }
        }
        j = j + 1
    }
    // GDEF, for IgnoreMarks. If it is missing, no glyph counts as a mark --
    // then a ligature matches only without a vowel in between.
    (*g).classdef = 0
    var go: usize = 0
    var gl: usize = 0
    if ttf.font_table(f, 71, 68, 69, 70, &go, &gl) { // GDEF
        let cd: u32 = u16at(f, go + 4)
        if cd != 0 as u32 {
            (*g).classdef = go + cd as usize
        }
    }
    (*g).ok = 1
    return (*g).n > 0
}

// Open the GSUB and GDEF tables WITHOUT choosing a script: the lookups can
// then be asked by number (gsub_li_*, gsub_context_li). false if there is
// no GSUB.
#[no_gc]
fn gsub_open(f: *mut ttf.Font, g: *mut Gsub) -> bool {
    var o: usize = 0
    var l: usize = 0
    if !ttf.font_table(f, 71, 83, 85, 66, &o, &l) { // GSUB
        return false
    }
    (*g).base = o
    (*g).lookups = o + u16at(f, o + 8) as usize
    (*g).classdef = 0
    var go: usize = 0
    var gl: usize = 0
    if ttf.font_table(f, 71, 68, 69, 70, &go, &gl) { // GDEF
        let cd: u32 = u16at(f, go + 4)
        if cd != 0 as u32 {
            (*g).classdef = go + cd as usize
        }
    }
    (*g).ok = 1
    return true
}

// ------------------------------------------------------------ Coverage

// The position of a glyph in a coverage table, -1 if not in it.
#[no_gc]
fn coverage(f: *mut ttf.Font, cov: usize, gid: u32) -> i32 {
    let fmt: u32 = u16at(f, cov)
    let cnt: usize = u16at(f, cov + 2) as usize
    var lo: usize = 0
    var hi: usize = cnt
    if fmt == 1 as u32 {
        while lo < hi {
            let mid: usize = (lo + hi) / 2
            let v: u32 = u16at(f, cov + 4 + mid * 2)
            if v == gid {
                return mid as i32
            }
            if v < gid {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        return 0 - 1
    }
    if fmt == 2 as u32 {
        while lo < hi {
            let mid: usize = (lo + hi) / 2
            let r: usize = cov + 4 + mid * 6
            let s: u32 = u16at(f, r)
            let e: u32 = u16at(f, r + 2)
            if gid < s {
                hi = mid
            } else if gid > e {
                lo = mid + 1
            } else {
                return (u16at(f, r + 4) + (gid - s)) as i32
            }
        }
    }
    return 0 - 1
}

// ------------------------------------------------------------ GDEF

// Is the glyph a combining mark (glyph class 3)?
#[no_gc]
fn gsub_is_mark(f: *mut ttf.Font, g: *mut Gsub, gid: u32) -> bool {
    let cd: usize = (*g).classdef
    if cd == 0 {
        return false
    }
    let fmt: u32 = u16at(f, cd)
    if fmt == 1 as u32 {
        let start: u32 = u16at(f, cd + 2)
        let cnt: u32 = u16at(f, cd + 4)
        if gid < start || gid >= start + cnt {
            return false
        }
        return u16at(f, cd + 6 + ((gid - start) as usize) * 2) == 3 as u32
    }
    if fmt == 2 as u32 {
        var lo: usize = 0
        var hi: usize = u16at(f, cd + 2) as usize
        while lo < hi {
            let mid: usize = (lo + hi) / 2
            let r: usize = cd + 4 + mid * 6
            let s: u32 = u16at(f, r)
            let e: u32 = u16at(f, r + 2)
            if gid < s {
                hi = mid
            } else if gid > e {
                lo = mid + 1
            } else {
                return u16at(f, r + 4) == 3 as u32
            }
        }
    }
    return false
}

// ------------------------------------------------------------ Lookups

#[no_gc]
fn lookup_at(f: *mut ttf.Font, g: *mut Gsub, k: usize) -> usize {
    let li: usize = (*g).idx[k] as usize
    return (*g).lookups + u16at(f, (*g).lookups + 2 + li * 2) as usize
}

// The type of a lookup -- for type 7 the type that it refers to.
#[no_gc]
fn gsub_lookup_type(f: *mut ttf.Font, g: *mut Gsub, k: usize) -> u32 {
    let lk: usize = lookup_at(f, g, k)
    let ty: u32 = u16at(f, lk)
    if ty == 7 as u32 && u16at(f, lk + 4) > 0 as u32 {
        let st: usize = lk + u16at(f, lk + 6) as usize
        return u16at(f, st + 2)
    }
    return ty
}

#[no_gc]
fn gsub_lookup_ignores_marks(f: *mut ttf.Font, g: *mut Gsub,
    k: usize) -> bool {
    let lk: usize = lookup_at(f, g, k)
    return (u16at(f, lk + 2) & LF_IGNORE_MARKS) != 0 as u32
}

// The subtable `s` of the lookup, for type 7 through the extension
// to the target.
#[no_gc]
fn subtable(f: *mut ttf.Font, lk: usize, s: usize) -> usize {
    let st: usize = lk + u16at(f, lk + 6 + s * 2) as usize
    if u16at(f, lk) == 7 as u32 {
        return st + ttf.font_u32(f, st + 4) as usize
    }
    return st
}

// SINGLE SUBSTITUTION (type 1). The new glyph, or `gid` itself.
#[no_gc]
fn gsub_single(f: *mut ttf.Font, g: *mut Gsub, k: usize, gid: u32) -> u32 {
    return single_lk(f, lookup_at(f, g, k), gid)
}

#[no_gc]
fn single_lk(f: *mut ttf.Font, lk: usize, gid: u32) -> u32 {
    let ns: usize = u16at(f, lk + 4) as usize
    var s: usize = 0
    while s < ns {
        let st: usize = subtable(f, lk, s)
        let fmt: u32 = u16at(f, st)
        let ci: i32 = coverage(f, st + u16at(f, st + 2) as usize, gid)
        if ci >= 0 {
            if fmt == 1 as u32 {
                // deltaGlyphID is signed; calculated modulo 65536
                // that is the same as the addition.
                return (gid + u16at(f, st + 4)) & 0xFFFF as u32
            }
            if fmt == 2 as u32 {
                if (ci as u32) < u16at(f, st + 4) {
                    return u16at(f, st + 6 + (ci as usize) * 2)
                }
            }
        }
        s = s + 1
    }
    return gid
}

// ------------------------------------------------------------- UNITS
//
// The extra glyphs of one position stand next to each other in the table
// (`gsub_x_insert` keeps it so). These helpers walk the sequence
// "glyph, its extras, next position's glyph, ..." by units (see UNIT).

// Index in the table of the first extra of `pos`; MAX_EXTRA + 1 .. no: the
// count `xn` if the position has none.
#[no_gc]
fn x_first(g: *mut Gsub, pos: usize) -> usize {
    var i: usize = 0
    while i < (*g).xn && (*g).xpos[i] != pos as u32 {
        i = i + 1
    }
    return i
}

// How many extra glyphs `pos` has.
#[no_gc]
fn gsub_x_cnt(g: *mut Gsub, pos: usize) -> usize {
    if (*g).xn == 0 {
        return 0
    }
    var i: usize = x_first(g, pos)
    var c: usize = 0
    while i < (*g).xn && (*g).xpos[i] == pos as u32 {
        c = c + 1
        i = i + 1
    }
    return c
}

// Index in the table of the k-th extra (k from 1) of `pos`, or MAX_EXTRA if
// there is none.
#[no_gc]
fn gsub_x_index(g: *mut Gsub, pos: usize, k: usize) -> usize {
    if k == 0 || k > gsub_x_cnt(g, pos) {
        return MAX_EXTRA
    }
    return x_first(g, pos) + k - 1
}

// Take the k-th extra (k from 1) of `pos` out of the table; the later
// entries move up. false if there is none.
#[no_gc]
fn gsub_x_remove(g: *mut Gsub, pos: usize, k: usize) -> bool {
    let at: usize = gsub_x_index(g, pos, k)
    if at >= MAX_EXTRA {
        return false
    }
    var j: usize = at
    while j + 1 < (*g).xn {
        (*g).xpos[j] = (*g).xpos[j + 1]
        (*g).xgid[j] = (*g).xgid[j + 1]
        j = j + 1
    }
    (*g).xn = (*g).xn - 1
    return true
}

// The glyph of a unit: `gids` is the glyph per position.
#[no_gc]
fn unit_gid(g: *mut Gsub, gids: u64, u: usize) -> u32 {
    let pos: usize = u / UNIT
    let k: usize = u % UNIT
    if k == 0 {
        return *((gids + (pos * 4) as u64) as *mut u32)
    }
    let at: usize = gsub_x_index(g, pos, k)
    if at >= MAX_EXTRA {
        return 0
    }
    return (*g).xgid[at]
}

#[no_gc]
fn gsub_unit_gid(g: *mut Gsub, gids: u64, u: usize) -> u32 {
    return unit_gid(g, gids, u)
}

// The next unit of the sequence (the first of the next position behind the
// last extra).
#[no_gc]
fn unit_next(g: *mut Gsub, u: usize) -> usize {
    let pos: usize = u / UNIT
    if (*g).xn > 0 && (u % UNIT) < gsub_x_cnt(g, pos) {
        return u + 1
    }
    return (pos + 1) * UNIT
}

#[no_gc]
fn gsub_unit_next(g: *mut Gsub, u: usize) -> usize { return unit_next(g, u) }

// The unit before `u` (u > 0): the last extra of the position before, if it
// has any.
#[no_gc]
fn unit_prev(g: *mut Gsub, u: usize) -> usize {
    if u % UNIT > 0 {
        return u - 1
    }
    let pos: usize = u / UNIT - 1
    if (*g).xn > 0 {
        return pos * UNIT + gsub_x_cnt(g, pos)
    }
    return pos * UNIT
}

// LIGATURE (type 4). `gids` are the glyphs of the sequence from the first
// component on, `skip[i] != 0` means "this position no longer exists"
// (already absorbed into a ligature). If a ligature fits, its
// glyph comes back and `used` gets the positions of the further components
// (at most `cap`), `nused` their number; otherwise 0.
//
// The sequence the components are searched in contains the EXTRA glyphs
// (see `gsub_x_insert`) too: a position stands for its glyph followed by
// its extras. The `_u` variants speak in UNITS (`pos * UNIT + k`, k = 0 the
// glyph of the position, k >= 1 its k-th extra): `at` and the answer in
// `used` are units. The plain variants take and give positions -- the
// same as long as there are no extras.
#[no_gc]
fn gsub_ligature(f: *mut ttf.Font, g: *mut Gsub, k: usize, gids: u64,
    skip: u64, n: usize, at: usize, used: u64, cap: usize,
    nused: *mut usize) -> u32 {
    return ligature_pos(f, g, lookup_at(f, g, k), gids, skip, n, at, used,
        cap, nused)
}

#[no_gc]
fn gsub_ligature_u(f: *mut ttf.Font, g: *mut Gsub, k: usize, gids: u64,
    skip: u64, n: usize, at: usize, used: u64, cap: usize,
    nused: *mut usize) -> u32 {
    return ligature_lk(f, g, lookup_at(f, g, k), gids, skip, n, at, used,
        cap, nused)
}

// Positions in, positions out (the units of `used` shrink back to positions).
#[no_gc]
fn ligature_pos(f: *mut ttf.Font, g: *mut Gsub, lk: usize, gids: u64,
    skip: u64, n: usize, at: usize, used: u64, cap: usize,
    nused: *mut usize) -> u32 {
    let r: u32 = ligature_lk(f, g, lk, gids, skip, n, at * UNIT, used, cap,
        nused)
    var i: usize = 0
    while i < *nused {
        let pu: u64 = used + (i * 4) as u64
        *(pu as *mut u32) = *(pu as *mut u32) / (UNIT as u32)
        i = i + 1
    }
    return r
}

#[no_gc]
fn ligature_lk(f: *mut ttf.Font, g: *mut Gsub, lk: usize, gids: u64,
    skip: u64, n: usize, at: usize, used: u64, cap: usize,
    nused: *mut usize) -> u32 {
    *nused = 0
    let ign: bool = (u16at(f, lk + 2) & LF_IGNORE_MARKS) != 0 as u32
    let first: u32 = unit_gid(g, gids, at)
    let un: usize = n * UNIT
    let ns: usize = u16at(f, lk + 4) as usize
    var s: usize = 0
    while s < ns {
        let st: usize = subtable(f, lk, s)
        let ci: i32 = coverage(f, st + u16at(f, st + 2) as usize, first)
        if ci >= 0 && (ci as u32) < u16at(f, st + 4) {
            let set: usize = st + u16at(f, st + 6 + (ci as usize) * 2) as usize
            let nlig: usize = u16at(f, set) as usize
            var li: usize = 0
            while li < nlig {
                let lig: usize = set + u16at(f, set + 2 + li * 2) as usize
                let comp: usize = u16at(f, lig + 2) as usize
                var ok: bool = comp >= 1 && comp - 1 <= cap
                var c: usize = 1
                var pos: usize = unit_next(g, at)
                while ok && c < comp {
                    // the next unit that still exists and that is not a
                    // skipped character
                    while pos < un {
                        if *((skip + (pos / UNIT) as u64) as *mut u8) != 0 as u8 {
                            pos = unit_next(g, pos)
                        } else if ign && gsub_is_mark(f, g,
                            unit_gid(g, gids, pos)) {
                            pos = unit_next(g, pos)
                        } else {
                            break
                        }
                    }
                    if pos >= un {
                        ok = false
                    } else if unit_gid(g, gids, pos)
                    != u16at(f, lig + 4 + (c - 1) * 2) {
                        ok = false
                    } else {
                        *((used + ((c - 1) * 4) as u64) as *mut u32) = pos as u32
                        pos = unit_next(g, pos)
                        c = c + 1
                    }
                }
                if ok {
                    *nused = comp - 1
                    return u16at(f, lig)
                }
                li = li + 1
            }
        }
        s = s + 1
    }
    return 0
}

// ------------------------------------------- Lookups by LOOKUP NUMBER

// The lookups that the SubstLookupRecords of a context rule name are
// numbered in the LookupList of the font, not in our short list, and they
// need not belong to any feature of ours.
#[no_gc]
fn lookup_li(f: *mut ttf.Font, g: *mut Gsub, li: u32) -> usize {
    return (*g).lookups + u16at(f, (*g).lookups + 2 + (li as usize) * 2) as usize
}

#[no_gc]
fn lk_type(f: *mut ttf.Font, lk: usize) -> u32 {
    let ty: u32 = u16at(f, lk)
    if ty == 7 as u32 && u16at(f, lk + 4) > 0 as u32 {
        let st: usize = lk + u16at(f, lk + 6) as usize
        return u16at(f, st + 2)
    }
    return ty
}

#[no_gc]
fn gsub_li_type(f: *mut ttf.Font, g: *mut Gsub, li: u32) -> u32 {
    return lk_type(f, lookup_li(f, g, li))
}

#[no_gc]
fn gsub_li_ignores_marks(f: *mut ttf.Font, g: *mut Gsub, li: u32) -> bool {
    return (u16at(f, lookup_li(f, g, li) + 2) & LF_IGNORE_MARKS) != 0 as u32
}

#[no_gc]
fn gsub_li_single(f: *mut ttf.Font, g: *mut Gsub, li: u32, gid: u32) -> u32 {
    return single_lk(f, lookup_li(f, g, li), gid)
}

#[no_gc]
fn gsub_li_ligature(f: *mut ttf.Font, g: *mut Gsub, li: u32, gids: u64,
    skip: u64, n: usize, at: usize, used: u64, cap: usize,
    nused: *mut usize) -> u32 {
    return ligature_pos(f, g, lookup_li(f, g, li), gids, skip, n, at, used,
        cap, nused)
}

#[no_gc]
fn gsub_li_ligature_u(f: *mut ttf.Font, g: *mut Gsub, li: u32, gids: u64,
    skip: u64, n: usize, at: usize, used: u64, cap: usize,
    nused: *mut usize) -> u32 {
    return ligature_lk(f, g, lookup_li(f, g, li), gids, skip, n, at, used,
        cap, nused)
}

// MULTIPLE SUBSTITUTION (type 2): the number of glyphs the lookup `li`
// makes of `gid`, 0 if it does not apply. `gsub_multiple_glyph` is the j-th.
// More than one glyph does not fit the per-character glyph array of
// lib/fui/shape.fi: the first is the glyph of the position, the rest go
// into the table of EXTRA glyphs (`gsub_x_insert`) of the same cluster.
#[no_gc]
fn multiple_seq(f: *mut ttf.Font, g: *mut Gsub, li: u32, gid: u32) -> usize {
    let lk: usize = lookup_li(f, g, li)
    let ns: usize = u16at(f, lk + 4) as usize
    var s: usize = 0
    while s < ns {
        let st: usize = subtable(f, lk, s)
        let ci: i32 = coverage(f, st + u16at(f, st + 2) as usize, gid)
        if ci >= 0 && (ci as u32) < u16at(f, st + 4) {
            return st + u16at(f, st + 6 + (ci as usize) * 2) as usize
        }
        s = s + 1
    }
    return 0
}

#[no_gc]
fn gsub_multiple_len(f: *mut ttf.Font, g: *mut Gsub, li: u32,
    gid: u32) -> usize {
    let sq: usize = multiple_seq(f, g, li, gid)
    if sq == 0 {
        return 0
    }
    return u16at(f, sq) as usize
}

// Does the lookup `li` have a sequence for `gid` (also an EMPTY one: the
// glyph is deleted)?
#[no_gc]
fn gsub_multiple_has(f: *mut ttf.Font, g: *mut Gsub, li: u32, gid: u32) -> bool {
    return multiple_seq(f, g, li, gid) != 0
}

#[no_gc]
fn gsub_multiple_glyph(f: *mut ttf.Font, g: *mut Gsub, li: u32, gid: u32,
    j: usize) -> u32 {
    let sq: usize = multiple_seq(f, g, li, gid)
    if sq == 0 || j >= u16at(f, sq) as usize {
        return gid
    }
    return u16at(f, sq + 2 + j * 2)
}

// ------------------------------------------------------ EXTRA GLYPHS
//
// The arrays of lib/fui/shape.fi hold ONE glyph per character. A multiple
// substitution with n > 1 output glyphs keeps that: the first output is the
// glyph of the position, outputs 2..n are EXTRA glyphs, they belong to the
// same character (= the same cluster: caret, selection and hit test see one
// unit) and are painted behind (left to right) the glyph of the position.

#[no_gc]
fn gsub_x_reset(g: *mut Gsub) { (*g).xn = 0 }

#[no_gc]
fn gsub_x_count(g: *mut Gsub) -> usize { return (*g).xn }

#[no_gc]
fn gsub_x_pos(g: *mut Gsub, i: usize) -> usize { return (*g).xpos[i] as usize }

#[no_gc]
fn gsub_x_gid(g: *mut Gsub, i: usize) -> u32 { return (*g).xgid[i] }

#[no_gc]
fn gsub_x_set(g: *mut Gsub, i: usize, gid: u32) { (*g).xgid[i] = gid }

// How many more extra glyphs fit.
#[no_gc]
fn gsub_x_room(g: *mut Gsub) -> usize { return MAX_EXTRA - (*g).xn }

// Put `gid` as the k-th extra glyph (k from 0) of position `pos`: in front of
// the extras that the position had, so inserting k = 0, 1, 2 .. in a row
// gives their order. false if the table is full (nothing changed).
#[no_gc]
fn gsub_x_insert(g: *mut Gsub, pos: usize, k: usize, gid: u32) -> bool {
    if (*g).xn >= MAX_EXTRA {
        return false
    }
    var i0: usize = 0
    while i0 < (*g).xn && (*g).xpos[i0] != pos as u32 {
        i0 = i0 + 1
    }
    let at: usize = i0 + k
    var j: usize = (*g).xn
    while j > at {
        (*g).xpos[j] = (*g).xpos[j - 1]
        (*g).xgid[j] = (*g).xgid[j - 1]
        j = j - 1
    }
    (*g).xpos[at] = pos as u32
    (*g).xgid[at] = gid
    (*g).xn = (*g).xn + 1
    return true
}

// ------------------------------------------------------ CONTEXT (5, 6)

// The class of a glyph in the ClassDef at `cd` (0 = none: everything is
// class 0).
#[no_gc]
fn classdef_of(f: *mut ttf.Font, cd: usize, gid: u32) -> u32 {
    if cd == 0 {
        return 0
    }
    let fmt: u32 = u16at(f, cd)
    if fmt == 1 as u32 {
        let start: u32 = u16at(f, cd + 2)
        let cnt: u32 = u16at(f, cd + 4)
        if gid < start || gid >= start + cnt {
            return 0
        }
        return u16at(f, cd + 6 + ((gid - start) as usize) * 2)
    }
    if fmt == 2 as u32 {
        var lo: usize = 0
        var hi: usize = u16at(f, cd + 2) as usize
        while lo < hi {
            let mid: usize = (lo + hi) / 2
            let r: usize = cd + 4 + mid * 6
            let s: u32 = u16at(f, r)
            let e: u32 = u16at(f, r + 2)
            if gid < s {
                hi = mid
            } else if gid > e {
                lo = mid + 1
            } else {
                return u16at(f, r + 4)
            }
        }
    }
    return 0
}

#[no_gc]
fn ctx_gid(g: *mut Gsub, pos: usize) -> u32 {
    return unit_gid(g, (*g).c_gids, pos)
}

// Does the position not count (absorbed into a ligature, or a mark under
// IgnoreMarks)?
#[no_gc]
fn ctx_skipped(f: *mut ttf.Font, g: *mut Gsub, pos: usize) -> bool {
    if *(((*g).c_skip + (pos / UNIT) as u64) as *mut u8) != 0 as u8 {
        return true
    }
    return (*g).c_ign != 0 && gsub_is_mark(f, g, ctx_gid(g, pos))
}

// Does the entry `at` of the array `arr` (octets 2 each) fit the glyph?
// Mode 1: the entry is a glyph, 2: a class, 3: an offset to a coverage.
// `cd` is the ClassDef that goes with the array (mode 2).
#[no_gc]
fn ctx_fits(f: *mut ttf.Font, g: *mut Gsub, arr: usize, c: usize,
    gid: u32, cd: usize) -> bool {
    let v: u32 = u16at(f, arr + c * 2)
    let mode: u32 = (*g).c_mode
    if mode == 1 as u32 {
        return gid == v
    }
    if mode == 2 as u32 {
        return classdef_of(f, cd, gid) == v
    }
    return coverage(f, (*g).c_st + v as usize, gid) >= 0
}

// `cnt` entries forward from position `from`; with `rec` the positions are
// remembered as input positions from index `ibase` on. `end` gets the
// position behind the last match.
#[no_gc]
fn ctx_fwd(f: *mut ttf.Font, g: *mut Gsub, from: usize, arr: usize,
    cnt: usize, cd: usize, rec: bool, ibase: usize, end: *mut usize) -> bool {
    var pos: usize = from
    var c: usize = 0
    while c < cnt {
        while pos < (*g).c_n * UNIT && ctx_skipped(f, g, pos) {
            pos = unit_next(g, pos)
        }
        if pos >= (*g).c_n * UNIT {
            return false
        }
        if !ctx_fits(f, g, arr, c, ctx_gid(g, pos), cd) {
            return false
        }
        if rec {
            (*g).ipos[ibase + c] = pos as u32
        }
        pos = unit_next(g, pos)
        c = c + 1
    }
    *end = pos
    return true
}

// `cnt` entries BACKWARD from before position `at` (entry 0 is the nearest).
#[no_gc]
fn ctx_back(f: *mut ttf.Font, g: *mut Gsub, at: usize, arr: usize,
    cnt: usize, cd: usize) -> bool {
    var pos: usize = at
    var c: usize = 0
    while c < cnt {
        if pos == 0 {
            return false
        }
        pos = unit_prev(g, pos)
        while ctx_skipped(f, g, pos) {
            if pos == 0 {
                return false
            }
            pos = unit_prev(g, pos)
        }
        if !ctx_fits(f, g, arr, c, ctx_gid(g, pos), cd) {
            return false
        }
        c = c + 1
    }
    return true
}

// One rule. `inp1` is the array of the input entries from the SECOND glyph
// on (for coverage format 3 from the second coverage on), `ni` the count of
// the whole input including the first glyph. If everything fits, the
// records are put into the answer.
#[no_gc]
fn ctx_rule(f: *mut ttf.Font, g: *mut Gsub, at: usize, nb: usize, bt: usize,
    ni: usize, inp1: usize, nl: usize, la: usize, ns: usize,
    rec: usize) -> bool {
    if ni < 1 || ni > 16 {
        return false
    }
    (*g).ipos[0] = at as u32
    var end: usize = unit_next(g, at)
    if ni > 1 {
        if !ctx_fwd(f, g, end, inp1, ni - 1, (*g).c_cdi, true, 1, &end) {
            return false
        }
    }
    if nb > 0 && !ctx_back(f, g, at, bt, nb, (*g).c_cdb) {
        return false
    }
    if nl > 0 {
        var end2: usize = 0
        if !ctx_fwd(f, g, end, la, nl, (*g).c_cda, false, 0, &end2) {
            return false
        }
    }
    var j: usize = 0
    var na: usize = 0
    while j < ns && na < 8 {
        let sq: usize = u16at(f, rec + j * 4) as usize
        if sq < ni {
            (*g).act_pos[na] = (*g).ipos[sq]
            (*g).act_li[na] = u16at(f, rec + j * 4 + 2)
            na = na + 1
        }
        j = j + 1
    }
    (*g).nact = na
    (*g).hit = 1
    (*g).mend = end
    return true
}

// A rule of format 1 or 2 at `rule`; `chain` tells the layout.
#[no_gc]
fn ctx_rule_at(f: *mut ttf.Font, g: *mut Gsub, at: usize, rule: usize,
    chain: bool) -> bool {
    if chain {
        let nb: usize = u16at(f, rule) as usize
        let bt: usize = rule + 2
        var p: usize = rule + 2 + nb * 2
        let ni: usize = u16at(f, p) as usize
        let inp: usize = p + 2
        if ni < 1 {
            return false
        }
        p = p + 2 + (ni - 1) * 2
        let nl: usize = u16at(f, p) as usize
        let la: usize = p + 2
        p = p + 2 + nl * 2
        let ns: usize = u16at(f, p) as usize
        return ctx_rule(f, g, at, nb, bt, ni, inp, nl, la, ns, p + 2)
    }
    let ni2: usize = u16at(f, rule) as usize
    let ns2: usize = u16at(f, rule + 2) as usize
    if ni2 < 1 {
        return false
    }
    return ctx_rule(f, g, at, 0, 0, ni2, rule + 4, 0, 0, ns2,
        rule + 4 + (ni2 - 1) * 2)
}

// The rules of one set (format 1: per glyph, format 2: per class).
#[no_gc]
fn ctx_set(f: *mut ttf.Font, g: *mut Gsub, at: usize, set: usize,
    chain: bool) -> bool {
    let nr: usize = u16at(f, set) as usize
    var r: usize = 0
    while r < nr {
        if ctx_rule_at(f, g, at, set + u16at(f, set + 2 + r * 2) as usize,
            chain) {
            return true
        }
        r = r + 1
    }
    return false
}

// The ClassDef at the offset `o` of the subtable `st`; 0 if the offset is 0.
#[no_gc]
fn ctx_cd(st: usize, o: u32) -> usize {
    if o == 0 as u32 {
        return 0
    }
    return st + o as usize
}

// CONTEXT / CHAINING CONTEXT (type 5 and 6) of lookup `k` at position
// `at`. `gids` and `skip` are the arrays of the shape (see gsub_ligature),
// `n` their length. Number of the records of the first matching rule is
// returned (0 = no rule fits, or it names nothing); they are read with
// gsub_act_pos / gsub_act_lookup. Positions that are skipped (absorbed,
// or marks under IgnoreMarks) do not count -- neither in the input nor in
// the backtrack and lookahead.
#[no_gc]
fn gsub_context(f: *mut ttf.Font, g: *mut Gsub, k: usize, gids: u64,
    skip: u64, n: usize, at: usize) -> usize {
    return context_pos(f, g, lookup_at(f, g, k), gids, skip, n, at)
}

// The same for a lookup named by its number in the LookupList of the font
// (any script: used by the proof against other fonts, see `gsub_open`).
#[no_gc]
fn gsub_context_li(f: *mut ttf.Font, g: *mut Gsub, li: u32, gids: u64,
    skip: u64, n: usize, at: usize) -> usize {
    return context_pos(f, g, lookup_li(f, g, li), gids, skip, n, at)
}

// The `_u` variants: `at` is a UNIT (see UNIT) and the sequence includes the
// extra glyphs; the positions of the records come back as units
// (`gsub_act_unit`).
#[no_gc]
fn gsub_context_u(f: *mut ttf.Font, g: *mut Gsub, k: usize, gids: u64,
    skip: u64, n: usize, at: usize) -> usize {
    return context_lk(f, g, lookup_at(f, g, k), gids, skip, n, at)
}

#[no_gc]
fn gsub_context_li_u(f: *mut ttf.Font, g: *mut Gsub, li: u32, gids: u64,
    skip: u64, n: usize, at: usize) -> usize {
    return context_lk(f, g, lookup_li(f, g, li), gids, skip, n, at)
}

// Position in; the answer of `gsub_act_pos` is a position too.
#[no_gc]
fn context_pos(f: *mut ttf.Font, g: *mut Gsub, lk: usize, gids: u64,
    skip: u64, n: usize, at: usize) -> usize {
    return context_lk(f, g, lk, gids, skip, n, at * UNIT)
}

#[no_gc]
fn context_lk(f: *mut ttf.Font, g: *mut Gsub, lk: usize, gids: u64,
    skip: u64, n: usize, at: usize) -> usize {
    (*g).nact = 0
    (*g).hit = 0
    (*g).mend = at
    (*g).c_gids = gids
    (*g).c_skip = skip
    (*g).c_n = n
    (*g).c_ign = 0
    if (u16at(f, lk + 2) & LF_IGNORE_MARKS) != 0 as u32 {
        (*g).c_ign = 1
    }
    let chain: bool = lk_type(f, lk) == 6 as u32
    let first: u32 = ctx_gid(g, at)
    let nsub: usize = u16at(f, lk + 4) as usize
    var s: usize = 0
    while s < nsub {
        let st: usize = subtable(f, lk, s)
        let fmt: u32 = u16at(f, st)
        (*g).c_st = st
        (*g).c_cdb = 0
        (*g).c_cdi = 0
        (*g).c_cda = 0
        if fmt == 1 as u32 {
            (*g).c_mode = 1
            let ci: i32 = coverage(f, st + u16at(f, st + 2) as usize, first)
            if ci >= 0 && (ci as u32) < u16at(f, st + 4) {
                let set: usize = st + u16at(f, st + 6 + (ci as usize) * 2) as usize
                if ctx_set(f, g, at, set, chain) {
                    return (*g).nact
                }
            }
        } else if fmt == 2 as u32 {
            (*g).c_mode = 2
            let ci: i32 = coverage(f, st + u16at(f, st + 2) as usize, first)
            if ci >= 0 {
                var cnt: usize = 0
                var sets: usize = 0
                if chain {
                    (*g).c_cdb = ctx_cd(st, u16at(f, st + 4))
                    (*g).c_cdi = ctx_cd(st, u16at(f, st + 6))
                    (*g).c_cda = ctx_cd(st, u16at(f, st + 8))
                    cnt = u16at(f, st + 10) as usize
                    sets = st + 12
                } else {
                    (*g).c_cdi = ctx_cd(st, u16at(f, st + 4))
                    cnt = u16at(f, st + 6) as usize
                    sets = st + 8
                }
                let cls: usize = classdef_of(f, (*g).c_cdi, first) as usize
                if cls < cnt {
                    let so: usize = u16at(f, sets + cls * 2) as usize
                    if so != 0 && ctx_set(f, g, at, st + so, chain) {
                        return (*g).nact
                    }
                }
            }
        } else if fmt == 3 as u32 {
            (*g).c_mode = 3
            if chain {
                let nb: usize = u16at(f, st + 2) as usize
                let bt: usize = st + 4
                var p: usize = st + 4 + nb * 2
                let ni: usize = u16at(f, p) as usize
                let inp: usize = p + 2
                p = p + 2 + ni * 2
                let nl: usize = u16at(f, p) as usize
                let la: usize = p + 2
                p = p + 2 + nl * 2
                let ns: usize = u16at(f, p) as usize
                if ni >= 1 && coverage(f, st + u16at(f, inp) as usize,
                    first) >= 0 {
                    if ctx_rule(f, g, at, nb, bt, ni, inp + 2, nl, la, ns,
                        p + 2) {
                        return (*g).nact
                    }
                }
            } else {
                let ni2: usize = u16at(f, st + 2) as usize
                let ns2: usize = u16at(f, st + 4) as usize
                let inp2: usize = st + 6
                if ni2 >= 1 && coverage(f, st + u16at(f, inp2) as usize,
                    first) >= 0 {
                    if ctx_rule(f, g, at, 0, 0, ni2, inp2 + 2, 0, 0, ns2,
                        inp2 + ni2 * 2) {
                        return (*g).nact
                    }
                }
            }
        }
        s = s + 1
    }
    return 0
}

#[no_gc]
fn gsub_act_count(g: *mut Gsub) -> usize { return (*g).nact }

// The position of the j-th record (the position that holds its unit).
#[no_gc]
fn gsub_act_pos(g: *mut Gsub, j: usize) -> usize {
    return ((*g).act_pos[j] as usize) / UNIT
}

// The unit of the j-th record.
#[no_gc]
fn gsub_act_unit(g: *mut Gsub, j: usize) -> usize {
    return (*g).act_pos[j] as usize
}

#[no_gc]
fn gsub_act_lookup(g: *mut Gsub, j: usize) -> u32 { return (*g).act_li[j] }

// The last context question matched a rule (also one with no records).
#[no_gc]
fn gsub_match_hit(g: *mut Gsub) -> bool { return (*g).hit != 0 }

// The unit behind the input of the matching rule: where the walk goes on.
#[no_gc]
fn gsub_match_end(g: *mut Gsub) -> usize { return (*g).mend }

// ------------------------------------------------------ EDIT LOG

#[no_gc]
fn gsub_elog_reset(g: *mut Gsub) { (*g).elen = 0 }

#[no_gc]
fn gsub_elog_len(g: *mut Gsub) -> usize { return (*g).elen }

// Note an edit: c == 0 the unit `u` was removed, c > 0 c units were put
// behind `u`. A full log drops the edit (the walk then just does not shift).
#[no_gc]
fn gsub_elog_add(g: *mut Gsub, u: usize, c: usize) {
    if (*g).elen >= MAX_ELOG {
        return
    }
    (*g).elog_u[(*g).elen] = u as u32
    (*g).elog_c[(*g).elen] = c as u32
    (*g).elen = (*g).elen + 1
}

#[no_gc]
fn gsub_elog_unit(g: *mut Gsub, i: usize) -> usize {
    return (*g).elog_u[i] as usize
}

#[no_gc]
fn gsub_elog_count(g: *mut Gsub, i: usize) -> usize {
    return (*g).elog_c[i] as usize
}

// ------------------------------------------------ ALTERNATE (type 3)

// Which alternative `gsub_alternate` takes when asked for the feature value
// (1 = the first; 0 is treated as 1).
#[no_gc]
fn gsub_alt_set(g: *mut Gsub, v: u32) {
    if v == 0 as u32 {
        (*g).alt = 1
    } else {
        (*g).alt = v
    }
}

#[no_gc]
fn gsub_alt(g: *mut Gsub) -> u32 { return (*g).alt }

// The `alt`-th alternative (from 1) of `gid` in lookup `lk`, or `gid`
// itself if the lookup has none (or fewer than `alt`).
#[no_gc]
fn alternate_lk(f: *mut ttf.Font, lk: usize, gid: u32, alt: u32) -> u32 {
    let ns: usize = u16at(f, lk + 4) as usize
    var s: usize = 0
    while s < ns {
        let st: usize = subtable(f, lk, s)
        if u16at(f, st) == 1 as u32 {
            let ci: i32 = coverage(f, st + u16at(f, st + 2) as usize, gid)
            if ci >= 0 && (ci as u32) < u16at(f, st + 4) {
                let set: usize = st + u16at(f, st + 6 + (ci as usize) * 2) as usize
                if alt >= 1 as u32 && alt <= u16at(f, set) {
                    return u16at(f, set + 2 + ((alt - 1) as usize) * 2)
                }
                return gid
            }
        }
        s = s + 1
    }
    return gid
}

#[no_gc]
fn gsub_alternate(f: *mut ttf.Font, g: *mut Gsub, k: usize, gid: u32,
    alt: u32) -> u32 {
    return alternate_lk(f, lookup_at(f, g, k), gid, alt)
}

#[no_gc]
fn gsub_li_alternate(f: *mut ttf.Font, g: *mut Gsub, li: u32, gid: u32,
    alt: u32) -> u32 {
    return alternate_lk(f, lookup_li(f, g, li), gid, alt)
}

// ------------------------------------------ REVERSE CHAINING (type 8)

// The substitute for the glyph of unit `u` if a rule of lookup `lk` fits
// (the glyph covered, backtrack and lookahead coverages fit), else 0.
// `gids`, `skip`, `n` as in gsub_ligature. The sequence is seen as it is NOW:
// the caller walks backward, so units behind `u` already carry their
// substitutes.
#[no_gc]
fn reverse_lk(f: *mut ttf.Font, g: *mut Gsub, lk: usize, gids: u64,
    skip: u64, n: usize, u: usize) -> u32 {
    (*g).c_gids = gids
    (*g).c_skip = skip
    (*g).c_n = n
    (*g).c_ign = 0
    if (u16at(f, lk + 2) & LF_IGNORE_MARKS) != 0 as u32 {
        (*g).c_ign = 1
    }
    (*g).c_mode = 3
    (*g).c_cdb = 0
    (*g).c_cdi = 0
    (*g).c_cda = 0
    let first: u32 = ctx_gid(g, u)
    let ns: usize = u16at(f, lk + 4) as usize
    var s: usize = 0
    while s < ns {
        let st: usize = subtable(f, lk, s)
        if u16at(f, st) == 1 as u32 {
            let ci: i32 = coverage(f, st + u16at(f, st + 2) as usize, first)
            if ci >= 0 {
                let nb: usize = u16at(f, st + 4) as usize
                let bt: usize = st + 6
                let p: usize = st + 6 + nb * 2
                let nl: usize = u16at(f, p) as usize
                let la: usize = p + 2
                let q: usize = p + 2 + nl * 2
                let ng: usize = u16at(f, q) as usize
                if (ci as usize) < ng {
                    (*g).c_st = st
                    var ok: bool = true
                    if nb > 0 && !ctx_back(f, g, u, bt, nb, 0) {
                        ok = false
                    }
                    var e: usize = 0
                    if ok && nl > 0
                    && !ctx_fwd(f, g, unit_next(g, u), la, nl, 0, false, 0, &e) {
                        ok = false
                    }
                    if ok {
                        return u16at(f, q + 2 + (ci as usize) * 2)
                    }
                }
            }
        }
        s = s + 1
    }
    return 0
}

#[no_gc]
fn gsub_reverse_u(f: *mut ttf.Font, g: *mut Gsub, k: usize, gids: u64,
    skip: u64, n: usize, u: usize) -> u32 {
    return reverse_lk(f, g, lookup_at(f, g, k), gids, skip, n, u)
}

#[no_gc]
fn gsub_li_reverse_u(f: *mut ttf.Font, g: *mut Gsub, li: u32, gids: u64,
    skip: u64, n: usize, u: usize) -> u32 {
    return reverse_lk(f, g, lookup_li(f, g, li), gids, skip, n, u)
}
