// SPDX-License-Identifier: GPL-2.0-only
// lib/font/raster.fi -- THE SCANLINE RASTERISER. A closed path in, a
// coverage value per pixel out.
//
// This is the one piece of arithmetic that both halves of round B3 rest
// on. A glyph of a TrueType font and the rounded corner of a `div` are
// the same problem: a closed outline made of straight lines and quadratic
// curves, and the question "how much of pixel (x, y) lies inside it".
// Answering that with a yes or a no gives a staircase; answering it with a
// FRACTION gives anti-aliasing. So the rasteriser does not return a
// bitmap, it returns an AREA per pixel.
//
// WHY THIS FILE LIES UNDER lib/font/ AND NOT UNDER lib/paint/. It is used
// by both, and the more demanding customer is the font: a `div` is a
// rectangle and could be filled with four comparisons, a letter at 11 px
// cannot. The Osum window server (round K10, the other repository) needs
// exactly this pair -- outline reader plus rasteriser -- and needs it in
// a KERNEL, without a heap and without a garbage collector. That is why
// nothing in this file allocates by itself, why every function is
// `#[no_gc]`, and why the only import is `std.math`.
//
// ------------------------------------------------------------ THE METHOD
//
// SIGNED AREA ACCUMULATION, the algorithm Raph Levien's `font-rs` made
// popular. It is worth writing down why it was chosen over the classic
// active edge table, because the classic one is what everybody starts
// with:
//
//   * an active edge list sorts edges per scanline, keeps a list, and
//     needs a second, finer subdivision inside the pixel row to get
//     anti-aliasing at all -- typically 4 or 16 sub-scanlines, which is
//     4 or 16 times the work and STILL only 4 or 16 grey levels.
//   * this method walks each edge ONCE, top to bottom, and writes into
//     each pixel it touches the exact, analytically computed area of the
//     trapezoid the edge cuts out of that pixel, with a sign that says
//     which way the edge runs. Nothing is sorted, no list is kept, and
//     the result is EXACT, not sampled: a 45 degree edge through the
//     middle of a pixel gives 0.5 and not "2 of 4 samples".
//
// The trick that makes it work is that the numbers written down are
// DIFFERENCES. A cell does not hold "how much of me is covered" but "how
// much does the coverage change here compared to the pixel on my left".
// A running sum along the row turns the differences back into coverage,
// and because a closed contour crosses every row an even number of times
// the running sum returns to zero at the end of the row on its own.
//
// THE SIGN, and what it means for overlapping contours: the sum is taken
// as an ABSOLUTE VALUE and clipped at one. For a letter -- an outer
// contour clockwise, the counter of an `o` anticlockwise -- that is
// exactly the non-zero winding rule. For a path that overlaps ITSELF in
// the same direction it saturates at one instead of counting to two,
// which is what non-zero means as well. What it is NOT is the even-odd
// rule; nothing in CSS or in a TrueType glyph asks for even-odd, and the
// day something does, it is a second `raster_finish`, not a second
// rasteriser.
//
// ------------------------------------------------------ THE ARITHMETIC TRAP
//
// Since round 72 `+`, `-` and `*` are CHECKED and panic on overflow. A
// rasteriser is full of coordinates that legitimately go negative (a box
// that starts left of the window, a glyph whose outline reaches below the
// baseline) and of index arithmetic that would underflow if it were done
// in `usize`. The rule in this file is therefore: EVERY index computation
// runs in `i64`, is clamped, and only then becomes a `usize`. There is no
// `x0i - 1` on an unsigned type anywhere here, and no place where a
// difference of two coordinates is cast before it has been checked
// against zero.
//
// NO IMPORTS AT ALL. `std.math` is not `#[no_gc]`, and a kernel has no
// `std` anyway -- the four pieces of arithmetic this file needs (floor,
// ceil, absolute value, square root) are eleven lines and stand at the
// top. That is the price of being usable from the other side.

export {
    Raster,
    raster_new, raster_attach, raster_free, raster_begin, raster_finish,
    raster_line, raster_quad, raster_cubic,
    raster_cov, raster_cov_row, raster_bytes_needed,
    raster_width, raster_height, raster_ok,
    raster_used_x0, raster_used_y0, raster_used_x1, raster_used_y1,
    raster_mark,
}

// The window a path is rasterised into. `ox`/`oy` is its top left corner
// in the coordinate system the caller draws in, so a glyph at pen
// position 371.5 does not have to be moved into the window by hand.
//
// `stride` is `w + 2` and not `w`: a cell at column `w` may still write
// one to its right (the closing difference of an edge that leaves the
// window), and a cell at `w + 1` is where that difference is thrown away.
struct Raster {
    acc: *mut u8, // (w + 2) * h cells of f64
    cap: usize, // bytes really available behind `acc`
    w: usize,
    h: usize,
    stride: usize,
    ox: f64,
    oy: f64,
    ok: usize, // 0 as soon as a window did not fit into the buffer
    // ROUND FIRN-LUECKEN -- CLEARING COSTS MORE THAN DRAWING.
    //
    // A window of 1540 x 1665 is 2.5 million cells, twenty megaoctets.
    // Clearing that per path is 237 times twenty megaoctets for a map with
    // 237 rings -- and each of those rings touches a few thousand cells.
    // The caller used to answer that by opening a WINDOW OF ITS OWN per
    // path, computed from the bounding box; that is the rasteriser's work,
    // not the application's.
    //
    // So the rasteriser remembers what it really wrote:
    //
    //   `ux0/uy0/ux1/uy1`  the rectangle of cells that was written, half
    //                      open, in the cell grid of `dstride`
    //   `dstride`          the stride that rectangle belongs to (the next
    //                      window may have a different one)
    //   `zeroed`           how many cells from the start of the buffer are
    //                      known to be zero. Memory handed over by
    //                      `raster_attach` is NOT zero, so the first window
    //                      of a given size pays for its own clearing once,
    //                      and a later, larger window pays for the piece
    //                      that grew.
    //
    // The invariant that carries all of it: after every `raster_begin`
    // every cell in [0, zeroed) is 0.0. `raster_begin` restores it by
    // clearing the used rectangle -- and nothing else.
    zeroed: usize,
    dstride: usize,
    // WRITTEN: every cell a `cell_add` could have touched, including the
    // two overflow columns at `w` and `w + 1`. This is what has to be put
    // back to zero, and it may never be narrowed -- a leftover in column
    // `w + 1` is invisible in THIS window (nothing reads past `w`) and
    // becomes an interior cell of the NEXT one, which has a different
    // stride.
    ux0: usize,
    uy0: usize,
    ux1: usize,
    uy1: usize,
    // COVERAGE: the cells that really carry ink after `raster_finish`.
    // That is what a caller wants to walk, and it is usually much smaller
    // -- a contour left of the window writes cells in column zero and they
    // all cancel out.
    vx0: usize,
    vy0: usize,
    vx1: usize,
    vy1: usize,
    vok: usize, // 1 as soon as `raster_finish` has computed the coverage
}

// ------------------------------------------------- The arithmetic, in house

#[no_gc]
fn fis_nan(x: f64) -> bool {
    return x != x
}

#[no_gc]
fn ffabs(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x
    }
    return x
}

// Truncation towards zero, guarded. The guard is not decoration: `as i64`
// is a NARROWING conversion and is checked in every build level but
// `release-fast` (SPEC 13, L9), so a coordinate that ran away would not
// give a wrong picture but a panic.
#[no_gc]
fn ftrunc(x: f64) -> f64 {
    if fis_nan(x) {
        return 0.0
    }
    if x > 9.0e15 {
        return 9.0e15
    }
    if x < 0.0 - 9.0e15 {
        return 0.0 - 9.0e15
    }
    return (x as i64) as f64
}

#[no_gc]
fn ffloor(x: f64) -> f64 {
    let t: f64 = ftrunc(x)
    if t > x {
        return t - 1.0
    }
    return t
}

#[no_gc]
fn fceil(x: f64) -> f64 {
    let t: f64 = ftrunc(x)
    if t < x {
        return t + 1.0
    }
    return t
}

// Newton, from a guess that is never worse than a factor of the value
// itself. Called once per curve, not once per pixel.
#[no_gc]
fn fsqrt(x: f64) -> f64 {
    if fis_nan(x) || x <= 0.0 {
        return 0.0
    }
    // The guess is doubled into range first -- Newton then converges in
    // a handful of steps instead of thirty, and this is called once per
    // curve of every glyph on the page.
    var g: f64 = 1.0
    while g * g < x {
        g = g * 2.0
    }
    var i: i32 = 0
    while i < 8 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}

#[no_gc]
fn raster_new() -> Raster {
    return Raster {
        acc: 0 as *mut u8,
        cap: 0,
        w: 0,
        h: 0,
        stride: 0,
        ox: 0.0,
        oy: 0.0,
        ok: 1,
        zeroed: 0,
        dstride: 0,
        ux0: 0,
        uy0: 0,
        ux1: 0,
        uy1: 0,
        vx0: 0,
        vy0: 0,
        vx1: 0,
        vy1: 0,
        vok: 0,
    }
}

// How many octets a window of `w` by `h` pixels needs. A caller with its
// own memory -- a kernel, for instance -- asks this first and then calls
// `raster_attach`.
#[no_gc]
fn raster_bytes_needed(w: usize, h: usize) -> usize {
    return (w + 2) * h * 8
}

// Hand the rasteriser memory. It never frees it and never grows it; a
// window that does not fit switches `ok` off instead of writing past the
// end.
#[no_gc]
fn raster_attach(r: *mut Raster, p: *mut u8, cap: usize) {
    (*r).acc = p
    (*r).cap = cap
    // Fresh memory says nothing about its content: not one cell is known
    // to be zero yet.
    (*r).zeroed = 0
    (*r).dstride = 0
    (*r).ux0 = 0
    (*r).uy0 = 0
    (*r).ux1 = 0
    (*r).uy1 = 0
    (*r).vok = 0
}

#[no_gc]
fn raster_free(r: *mut Raster) {
    (*r).acc = 0 as *mut u8
    (*r).cap = 0
    (*r).zeroed = 0
    (*r).dstride = 0
    (*r).ux0 = 0
    (*r).uy0 = 0
    (*r).ux1 = 0
    (*r).uy1 = 0
    (*r).vok = 0
}

// The rectangle of cells that was really written, clipped to the window.
// `canvas_fill_raster` walks exactly this and nothing more.
// Before `raster_finish` the honest answer is "everything that was
// written"; afterwards it is the ink.
#[no_gc]
fn used_x0(r: *mut Raster) -> usize {
    if (*r).vok != 0 {
        return (*r).vx0
    }
    return (*r).ux0
}

#[no_gc]
fn used_y0(r: *mut Raster) -> usize {
    if (*r).vok != 0 {
        return (*r).vy0
    }
    return (*r).uy0
}

#[no_gc]
fn used_x1(r: *mut Raster) -> usize {
    if (*r).vok != 0 {
        return (*r).vx1
    }
    return (*r).ux1
}

#[no_gc]
fn used_y1(r: *mut Raster) -> usize {
    if (*r).vok != 0 {
        return (*r).vy1
    }
    return (*r).uy1
}

#[no_gc]
fn raster_used_x0(r: *mut Raster) -> usize {
    if used_y1(r) <= used_y0(r) {
        return 0
    }
    if used_x0(r) > (*r).w {
        return (*r).w
    }
    return used_x0(r)
}

#[no_gc]
fn raster_used_y0(r: *mut Raster) -> usize {
    if used_y1(r) <= used_y0(r) {
        return 0
    }
    return used_y0(r)
}

#[no_gc]
fn raster_used_x1(r: *mut Raster) -> usize {
    if used_y1(r) <= used_y0(r) {
        return 0
    }
    if used_x1(r) > (*r).w {
        return (*r).w
    }
    return used_x1(r)
}

#[no_gc]
fn raster_used_y1(r: *mut Raster) -> usize {
    if used_y1(r) <= used_y0(r) {
        return 0
    }
    if used_y1(r) > (*r).h {
        return (*r).h
    }
    return used_y1(r)
}

// ROUND FIRN-LUECKEN -- FOR THE SECOND WRITER.
//
// `lib/paint/painter.fi::blur_pass` writes into the coverage cells
// DIRECTLY: a box blur is a running sum over the finished coverage, in
// place, and it spreads ink far beyond the rectangle the path itself
// touched. As long as `raster_begin` cleared everything, nobody had to
// tell the rasteriser about that. Now somebody does, or the ink stays
// behind and turns up in the NEXT path -- measured: 6069 of 480000 pixels
// in `tools/paintb3/cases/04_shadows.html`, and one of them was a blue box
// that had become white.
//
// So a writer that goes past `raster_line` says where it wrote. That is
// two lines at the end of `blur_pass` and it keeps the promise of the
// whole round: what is written is what is cleared.
#[no_gc]
fn raster_mark(r: *mut Raster, x0: usize, y0: usize, x1: usize, y1: usize) {
    if x1 <= x0 || y1 <= y0 {
        return
    }
    var ex: usize = x1
    if ex > (*r).stride {
        ex = (*r).stride
    }
    var ey: usize = y1
    if ey > (*r).h {
        ey = (*r).h
    }
    mark_used(r, y0, ey, x0, ex)
    // and it is ink, not just paper -- whoever asks after `raster_finish`
    // has to see it.
    if (*r).vok == 0 {
        (*r).vok = 1
        (*r).vy0 = y0
        (*r).vy1 = ey
        (*r).vx0 = x0
        (*r).vx1 = ex
        return
    }
    if (*r).vy1 <= (*r).vy0 {
        (*r).vy0 = y0
        (*r).vy1 = ey
        (*r).vx0 = x0
        (*r).vx1 = ex
        return
    }
    if y0 < (*r).vy0 {
        (*r).vy0 = y0
    }
    if ey > (*r).vy1 {
        (*r).vy1 = ey
    }
    if x0 < (*r).vx0 {
        (*r).vx0 = x0
    }
    if ex > (*r).vx1 {
        (*r).vx1 = ex
    }
}

// Widen the used rectangle. Called once per EDGE, not once per cell -- the
// bookkeeping must not cost what it saves.
#[no_gc]
fn mark_used(r: *mut Raster, y0: usize, y1: usize, x0: usize, x1: usize) {
    if y1 <= y0 || x1 <= x0 {
        return
    }
    if (*r).uy1 <= (*r).uy0 {
        (*r).uy0 = y0
        (*r).uy1 = y1
        (*r).ux0 = x0
        (*r).ux1 = x1
        return
    }
    if y0 < (*r).uy0 {
        (*r).uy0 = y0
    }
    if y1 > (*r).uy1 {
        (*r).uy1 = y1
    }
    if x0 < (*r).ux0 {
        (*r).ux0 = x0
    }
    if x1 > (*r).ux1 {
        (*r).ux1 = x1
    }
}

// Put back to zero what was written -- and only that. This is the whole
// point of the round: the cost of a path becomes the cost of the path.
#[no_gc]
fn reset_used(r: *mut Raster) {
    (*r).vok = 0
    if (*r).uy1 <= (*r).uy0 || (*r).acc as usize == 0 {
        (*r).ux0 = 0
        (*r).ux1 = 0
        (*r).uy0 = 0
        (*r).uy1 = 0
        return
    }
    let base: u64 = (*r).acc as u64
    let st: usize = (*r).dstride
    var y: usize = (*r).uy0
    while y < (*r).uy1 {
        let row: u64 = base + ((y * st) * 8) as u64
        var x: usize = (*r).ux0
        while x < (*r).ux1 {
            *((row + (x * 8) as u64) as *mut f64) = 0.0
            x = x + 1
        }
        y = y + 1
    }
    (*r).ux0 = 0
    (*r).ux1 = 0
    (*r).uy0 = 0
    (*r).uy1 = 0
}

#[no_gc]
fn raster_ok(r: *mut Raster) -> bool {
    return (*r).ok != 0
}

#[no_gc]
fn raster_width(r: *mut Raster) -> usize {
    return (*r).w
}

#[no_gc]
fn raster_height(r: *mut Raster) -> usize {
    return (*r).h
}

// Open a window and clear it. Everything drawn afterwards is measured
// against `ox`/`oy`; everything outside the window is clipped away, and
// clipping it is not an approximation -- an edge that leaves to the left
// is moved onto column zero, which is exactly where its coverage
// contribution belongs.
#[no_gc]
fn raster_begin(r: *mut Raster, ox: f64, oy: f64, w: usize, h: usize) -> bool {
    // FIRST the cleanup, in the geometry the used rectangle belongs to --
    // afterwards `stride` may be a different one, and the rectangle would
    // point somewhere else. After this line every cell in [0, zeroed) is
    // zero again, whatever happens further down.
    reset_used(r)
    (*r).ox = ox
    (*r).oy = oy
    (*r).w = w
    (*r).h = h
    (*r).stride = w + 2
    if w == 0 || h == 0 {
        (*r).ok = 1
        return true
    }
    let need: usize = raster_bytes_needed(w, h)
    if need > (*r).cap {
        (*r).ok = 0
        return false
    }
    (*r).ok = 1
    (*r).dstride = (*r).stride
    // The piece of the buffer that has never been written is whatever the
    // allocator left there. It is cleared ONCE, and after that the used
    // rectangle keeps the promise.
    let cells: usize = (*r).stride * h
    if cells > (*r).zeroed {
        let base: u64 = (*r).acc as u64
        var i: usize = (*r).zeroed
        while i < cells {
            *((base + (i * 8) as u64) as *mut f64) = 0.0
            i = i + 1
        }
        (*r).zeroed = cells
    }
    return true
}

#[no_gc]
fn cell_add(r: *mut Raster, row: usize, col: i64, v: f64) {
    if col < 0 {
        return
    }
    let c: usize = col as usize
    if c >= (*r).stride {
        return
    }
    let idx: usize = row * (*r).stride + c
    let a: u64 = (*r).acc as u64 + (idx * 8) as u64
    *(a as *mut f64) = *(a as *mut f64) + v
}

// The trapezoid of one edge inside ONE pixel row, spread over the columns
// it touches. `lx` <= `rx`, both already inside [0, w]; `d` is the signed
// height of the piece.
#[no_gc]
fn span(r: *mut Raster, row: usize, lx: f64, rx: f64, d: f64) {
    let x0floor: f64 = ffloor(lx)
    let x0i: i64 = x0floor as i64
    let x1ceil: f64 = fceil(rx)
    let x1i: i64 = x1ceil as i64
    if x1i <= x0i + 1 {
        // The whole piece lies inside one pixel: split it between that
        // pixel and its right neighbour by where its MIDDLE sits.
        let xmf: f64 = 0.5 * (lx + rx) - x0floor
        cell_add(r, row, x0i, d - d * xmf)
        cell_add(r, row, x0i + 1, d * xmf)
        return
    }
    let s: f64 = 1.0 / (rx - lx)
    let x0f: f64 = lx - x0floor
    let a0: f64 = 0.5 * s * (1.0 - x0f) * (1.0 - x0f)
    let x1f: f64 = rx - x1ceil + 1.0
    let am: f64 = 0.5 * s * x1f * x1f
    cell_add(r, row, x0i, d * a0)
    if x1i == x0i + 2 {
        cell_add(r, row, x0i + 1, d * (1.0 - a0 - am))
    } else {
        let a1: f64 = s * (1.5 - x0f)
        cell_add(r, row, x0i + 1, d * (a1 - a0))
        var xi: i64 = x0i + 2
        while xi < x1i - 1 {
            cell_add(r, row, xi, d * s)
            xi = xi + 1
        }
        let a2: f64 = a1 + ((x1i - x0i - 3) as f64) * s
        cell_add(r, row, x1i - 1, d * (1.0 - a2 - am))
    }
    cell_add(r, row, x1i, d * am)
}

// ------------------------------------------------------------- One edge
//
// The heart of the file. `p0` to `p1` in WINDOW coordinates. Everything
// else in this file eventually ends up here.
#[no_gc]
fn accumulate(r: *mut Raster, p0x: f64, p0y: f64, p1x: f64, p1y: f64) {
    if p0y == p1y {
        return // a horizontal edge changes no coverage anywhere
    }
    if fis_nan(p0x) || fis_nan(p0y) || fis_nan(p1x) ||
    fis_nan(p1y) {
        return
    }
    // Run downwards, remember which way round it really was.
    var dir: f64 = 1.0
    var ax: f64 = p0x
    var ay: f64 = p0y
    var bx: f64 = p1x
    var by: f64 = p1y
    if p0y > p1y {
        dir = 0.0 - 1.0
        ax = p1x
        ay = p1y
        bx = p0x
        by = p0y
    }
    let hf: f64 = (*r).h as f64
    if by <= 0.0 || ay >= hf {
        return
    }
    let dxdy: f64 = (bx - ax) / (by - ay)
    // Clip in y. `x` follows along, so the edge is not shortened but cut.
    var ys: f64 = ay
    var xs: f64 = ax
    if ys < 0.0 {
        xs = ax + dxdy * (0.0 - ay)
        ys = 0.0
    }
    var ye: f64 = by
    if ye > hf {
        ye = hf
    }
    if ye <= ys {
        return
    }
    let wf: f64 = (*r).w as f64
    // ROUND FIRN-LUECKEN -- write down WHERE this edge lands, once per
    // edge. The x range of the clipped edge lies between its two ends; the
    // two extra columns are the ones `span` may still write to the right of
    // `ceil(rx)` (`x0i + 1`), and `stride` is where that is thrown away.
    let xend: f64 = xs + dxdy * (ye - ys)
    var mlo: f64 = xs
    var mhi: f64 = xend
    if mlo > mhi {
        mlo = xend
        mhi = xs
    }
    if mlo < 0.0 {
        mlo = 0.0
    }
    if mhi > wf {
        mhi = wf
    }
    if mhi < 0.0 {
        mhi = 0.0
    }
    if mlo > wf {
        mlo = wf
    }
    var my0: i64 = ffloor(ys) as i64
    if my0 < 0 {
        my0 = 0
    }
    var my1: i64 = fceil(ye) as i64
    if my1 > (*r).h as i64 {
        my1 = (*r).h as i64
    }
    if my1 > my0 {
        var mx0: i64 = ffloor(mlo) as i64
        if mx0 < 0 {
            mx0 = 0
        }
        var mx1: i64 = (fceil(mhi) as i64) + 2
        if mx1 > (*r).stride as i64 {
            mx1 = (*r).stride as i64
        }
        mark_used(r, my0 as usize, my1 as usize, mx0 as usize, mx1 as usize)
    }
    var x: f64 = xs
    var yrow: i64 = ffloor(ys) as i64
    let ylast: i64 = fceil(ye) as i64
    while yrow < ylast {
        let rowtop: f64 = yrow as f64
        var ytop: f64 = rowtop
        if ys > ytop {
            ytop = ys
        }
        var ybot: f64 = rowtop + 1.0
        if ye < ybot {
            ybot = ye
        }
        let dy: f64 = ybot - ytop
        if dy > 0.0 {
            let xnext: f64 = x + dxdy * dy
            if yrow >= 0 && (yrow as usize) < (*r).h {
                let d: f64 = dy * dir
                var lx: f64 = x
                var rx: f64 = xnext
                if lx > rx {
                    lx = xnext
                    rx = x
                }
                if lx < 0.0 {
                    lx = 0.0
                }
                if rx < 0.0 {
                    rx = 0.0
                }
                if lx > wf {
                    lx = wf
                }
                if rx > wf {
                    rx = wf
                }
                span(r, yrow as usize, lx, rx, d)
            }
            x = xnext
        }
        yrow = yrow + 1
    }
}

// ---------------------------------------------------- What the caller draws

#[no_gc]
fn raster_line(r: *mut Raster, ax: f64, ay: f64, bx: f64, by: f64) {
    if (*r).ok == 0 {
        return
    }
    accumulate(r, ax - (*r).ox, ay - (*r).oy, bx - (*r).ox, by - (*r).oy)
}

// How many straight pieces a curve is cut into. Not a constant: a curve
// that spans two pixels does not deserve sixteen segments, and one that
// spans two hundred is a visible polygon with sixteen. The measure is the
// length of the control polygon, which overestimates the arc by at most a
// factor of two -- and overestimating is the safe direction here.
//
// THE CONSTANT 3.5 IS MEASURED, NOT GUESSED. The deviation of an
// `n`-piece polygon from the curve falls with `1 / n^2`; for a quarter
// circle of radius 20 (control polygon 37.7 long) it is 6.17 / n^2
// pixels. `n = sqrt(3.5 * L) + 1` gives 12 pieces there, so 0.043 px --
// under a twentieth of a pixel, which is below what the anti-aliasing of
// the next step can show. Round B3 measured the same curve as an AREA:
// 313.3 against the exact 314.16, and the missing 0.9 square pixels are
// the inscribed polygon, not an error.
#[no_gc]
fn steps_for(d: f64) -> i64 {
    if fis_nan(d) || d <= 0.0 {
        return 1
    }
    var n: i64 = (fsqrt(d * 3.5) + 1.0) as i64
    if n < 1 {
        n = 1
    }
    if n > 400 {
        n = 400
    }
    return n
}

// A quadratic Bezier -- the curve of a TrueType outline.
#[no_gc]
fn raster_quad(r: *mut Raster, x0: f64, y0: f64, cx: f64, cy: f64,
    x1: f64, y1: f64) {
    if (*r).ok == 0 {
        return
    }
    let d: f64 = ffabs(cx - x0) + ffabs(cy - y0) +
    ffabs(x1 - cx) + ffabs(y1 - cy)
    let n: i64 = steps_for(d)
    var i: i64 = 1
    var px: f64 = x0
    var py: f64 = y0
    while i <= n {
        let t: f64 = (i as f64) / (n as f64)
        let mt: f64 = 1.0 - t
        let qx: f64 = mt * mt * x0 + 2.0 * mt * t * cx + t * t * x1
        let qy: f64 = mt * mt * y0 + 2.0 * mt * t * cy + t * t * y1
        raster_line(r, px, py, qx, qy)
        px = qx
        py = qy
        i = i + 1
    }
}

// A cubic Bezier -- what a CSS path is made of, and what a quarter circle
// is approximated with when a `border-radius` is drawn.
#[no_gc]
fn raster_cubic(r: *mut Raster, x0: f64, y0: f64, c1x: f64, c1y: f64,
    c2x: f64, c2y: f64, x1: f64, y1: f64) {
    if (*r).ok == 0 {
        return
    }
    let d: f64 = ffabs(c1x - x0) + ffabs(c1y - y0) +
    ffabs(c2x - c1x) + ffabs(c2y - c1y) +
    ffabs(x1 - c2x) + ffabs(y1 - c2y)
    let n: i64 = steps_for(d)
    var i: i64 = 1
    var px: f64 = x0
    var py: f64 = y0
    while i <= n {
        let t: f64 = (i as f64) / (n as f64)
        let mt: f64 = 1.0 - t
        let a: f64 = mt * mt * mt
        let b: f64 = 3.0 * mt * mt * t
        let c: f64 = 3.0 * mt * t * t
        let e: f64 = t * t * t
        let qx: f64 = a * x0 + b * c1x + c * c2x + e * x1
        let qy: f64 = a * y0 + b * c1y + c * c2y + e * y1
        raster_line(r, px, py, qx, qy)
        px = qx
        py = qy
        i = i + 1
    }
}

// Turn the differences into coverage. Row by row: the running sum starts
// at zero at the left edge of every row, which is the one place where a
// closed contour is guaranteed to have balanced out.
#[no_gc]
fn raster_finish(r: *mut Raster) {
    if (*r).ok == 0 {
        return
    }
    // ROUND FIRN-LUECKEN: only the rows that were written. To the left of
    // `ux0` every cell is zero, so the running sum starts at zero there --
    // that is not an approximation, it is the same number the walk from
    // column zero would have arrived at.
    let base: u64 = (*r).acc as u64
    var y: usize = (*r).uy0
    var far: usize = (*r).ux1
    // The rectangle that really carries COVERAGE. It is at most the one
    // that was written to, and usually smaller: a contour whose edges all
    // lie left of the window writes cells in column zero, and they all
    // cancel out. Whoever asks afterwards ("did anything land in the
    // picture?") gets the honest answer, and `canvas_fill_raster` walks
    // the ink instead of the paper.
    var cy0: usize = 0
    var cy1: usize = 0
    var cx0: usize = 0
    var cx1: usize = 0
    var any: bool = false
    while y < (*r).uy1 {
        var acc: f64 = 0.0
        var x: usize = (*r).ux0
        let row: usize = y * (*r).stride
        while x < (*r).w {
            if x >= (*r).ux1 {
                // Past the written rectangle there is nothing left to add.
                // The loop runs on only while the sum has NOT come back to
                // zero -- a contour that was cut off at the right border is
                // the one case where coverage continues, and it kept
                // continuing before this round as well.
                if acc < 0.001953125 && acc > 0.0 - 0.001953125 {
                    break
                }
            }
            let a: u64 = base + ((row + x) * 8) as u64
            acc = acc + *(a as *mut f64)
            var v: f64 = acc
            if v < 0.0 {
                v = 0.0 - v
            }
            if v > 1.0 {
                v = 1.0
            }
            *(a as *mut f64) = v
            if v > 0.0 {
                if !any {
                    any = true
                    cy0 = y
                    cy1 = y + 1
                    cx0 = x
                    cx1 = x + 1
                } else {
                    cy1 = y + 1
                    if x < cx0 {
                        cx0 = x
                    }
                    if x + 1 > cx1 {
                        cx1 = x + 1
                    }
                }
            }
            x = x + 1
        }
        if x > far {
            far = x
        }
        y = y + 1
    }
    if far > (*r).ux1 {
        (*r).ux1 = far
    }
    // The ink, kept BESIDE the written rectangle and not instead of it:
    // the cells at `w` and `w + 1` are never read here and never cleared
    // here, and only the written rectangle knows about them.
    (*r).vok = 1
    if any {
        (*r).vy0 = cy0
        (*r).vy1 = cy1
        (*r).vx0 = cx0
        (*r).vx1 = cx1
    } else {
        (*r).vy0 = 0
        (*r).vy1 = 0
        (*r).vx0 = 0
        (*r).vx1 = 0
    }
}

// The coverage of one pixel, after `raster_finish`. 0.0 to 1.0.
#[no_gc]
fn raster_cov(r: *mut Raster, x: usize, y: usize) -> f64 {
    if x >= (*r).w || y >= (*r).h || (*r).ok == 0 {
        return 0.0
    }
    let idx: usize = y * (*r).stride + x
    return *(((*r).acc as u64 + (idx * 8) as u64) as *mut f64)
}

// The address of the first cell of a row -- for a loop that does not want
// to pay for the bounds check per pixel.
#[no_gc]
fn raster_cov_row(r: *mut Raster, y: usize) -> u64 {
    return (*r).acc as u64 + ((y * (*r).stride) * 8) as u64
}
