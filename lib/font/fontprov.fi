// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    Provider, MODE_EMBEDDED, MODE_PLATFORM, MODE_NATIVE,
    prov_set, prov_clear, prov_ready, mode_set, mode_get, platform_on,
    prov_advance, prov_pair, prov_vmetrics, prov_glyph,
}

const MODE_EMBEDDED: u32 = 0
const MODE_PLATFORM: u32 = 1
const MODE_NATIVE: u32 = 2

struct Provider {
    advance: fn(u32, f64, u32) -> f64,
    pair: fn(u32, u32, f64, u32) -> f64,
    vmetrics: fn(f64, u32, *mut f64) -> bool,
    glyph: fn(u32, f64, u32, u32, u32, u64, usize, *mut i32) -> i64,
}

static mut G_READY: bool = false
static mut G_MODE: u32 = 0
static mut G_ADVANCE: fn(u32, f64, u32) -> f64 = 0 as fn(u32, f64, u32) -> f64
static mut G_PAIR: fn(u32, u32, f64, u32) -> f64 = 0 as fn(u32, u32, f64, u32) -> f64
static mut G_VMETRICS: fn(f64, u32, *mut f64) -> bool = 0 as fn(f64, u32, *mut f64) -> bool
static mut G_GLYPH: fn(u32, f64, u32, u32, u32, u64, usize, *mut i32) -> i64 = 0 as fn(u32, f64, u32, u32, u32, u64, usize, *mut i32) -> i64

#[no_gc]
fn prov_set(p: Provider) {
    G_ADVANCE = p.advance
    G_PAIR = p.pair
    G_VMETRICS = p.vmetrics
    G_GLYPH = p.glyph
    G_READY = true
}

#[no_gc]
fn prov_clear() {
    G_READY = false
    G_MODE = MODE_EMBEDDED
}

#[no_gc]
fn prov_ready() -> bool { return G_READY }

#[no_gc]
fn mode_set(m: u32) {
    if (m == MODE_PLATFORM || m == MODE_NATIVE) && G_READY {
        G_MODE = m
        return
    }
    G_MODE = MODE_EMBEDDED
}

#[no_gc]
fn mode_get() -> u32 { return G_MODE }

#[no_gc]
fn platform_on() -> bool { return G_READY && G_MODE != MODE_EMBEDDED }

#[no_gc]
fn prov_advance(cp: u32, size: f64, weight: u32) -> f64 {
    let f: fn(u32, f64, u32) -> f64 = G_ADVANCE
    return f(cp, size, weight)
}

#[no_gc]
fn prov_pair(a: u32, b: u32, size: f64, weight: u32) -> f64 {
    let f: fn(u32, u32, f64, u32) -> f64 = G_PAIR
    return f(a, b, size, weight)
}

#[no_gc]
fn prov_vmetrics(size: f64, weight: u32, out: *mut f64) -> bool {
    let f: fn(f64, u32, *mut f64) -> bool = G_VMETRICS
    return f(size, weight, out)
}

#[no_gc]
fn prov_glyph(cp: u32, size: f64, weight: u32, slant: u32, qx: u32, buf: u64, cap: usize, meta: *mut i32) -> i64 {
    let f: fn(u32, f64, u32, u32, u32, u64, usize, *mut i32) -> i64 = G_GLYPH
    return f(cp, size, weight, slant, qx, buf, cap, meta)
}
