    var idx: usize = 0
    var s: usize = 0
    var i: usize = 0
    while i < 3443 {
        if t[i] == 124 as u8 {
            if idx == sid {
                var k: usize = 0
                while k < i - s && k < cap {
                    *((out as u64 + k as u64) as *mut u8) = t[s + k]
                    k = k + 1
