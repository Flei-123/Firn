// SPDX-License-Identifier: MPL-2.0
// lib/font/colr.fi -- COLR v0 / CPAL colour glyphs (round MC-E, E2).
//
// A COLR v0 glyph is a STACK OF LAYERS: each layer is an ordinary outline glyph
// plus a palette index. Painting = fill the layers bottom to top, each with
// its colour. CPAL holds the palettes (BGRA records). Palette index 0xFFFF
// means "the text colour". COLR v1 (gradients, transforms, composite modes), SVG
// and bitmap emoji (sbix/CBDT) are NOT handled here; a v1 font is still read
// through its v0 base-glyph records when it has any (Noto Color Emoji
// subsets carry both).
//
//   colr_ok(f)                         the font has COLR and CPAL
//   colr_layers(f, gid, gids, idx)     layers of `gid` (bottom first), 0 = not a colour glyph
//   cpal_color(f, palette, idx, &rgba) 0xAABBGGRR (the raster's byte order); false if out of range
import font.ttf

export {
    colr_ok, colr_layers, cpal_color, cpal_palettes, COLR_MAX_LAYERS, FOREGROUND,
}

const COLR_MAX_LAYERS: usize = 32
const FOREGROUND: u32 = 65535

fn tbl(f: *mut ttf.Font, a: u32, b: u32, c: u32, d: u32, off: *mut usize) -> bool {
    var len: usize = 0
    return ttf.font_table(f, a, b, c, d, off, &len)
}

fn colr_ok(f: *mut ttf.Font) -> bool {
    var o1: usize = 0
    var o2: usize = 0
    return tbl(f, 67 as u32, 79 as u32, 76 as u32, 82 as u32, &o1)
    && tbl(f, 67 as u32, 80 as u32, 65 as u32, 76 as u32, &o2)
}

// Fills `gids[0..n)` and `idx[0..n)`. Binary search over the base glyph records.
fn colr_layers(f: *mut ttf.Font, gid: u32, gids: *mut [u32; 32], idx: *mut [u32; 32]) -> usize {
    var t: usize = 0
    if !tbl(f, 67 as u32, 79 as u32, 76 as u32, 82 as u32, &t) {
        return 0
    }
    let nbase: usize = ttf.font_u16(f, t + 2) as usize
    let base_off: usize = ttf.font_u32(f, t + 4) as usize
    let lay_off: usize = ttf.font_u32(f, t + 8) as usize
    let nlay: usize = ttf.font_u16(f, t + 12) as usize
    var lo: usize = 0
    var hi: usize = nbase
    while lo < hi {
        let mid: usize = (lo + hi) / 2
        let rec: usize = t + base_off + mid * 6
        let g: u32 = ttf.font_u16(f, rec)
        if g == gid {
            let first: usize = ttf.font_u16(f, rec + 2) as usize
            var n: usize = ttf.font_u16(f, rec + 4) as usize
            if n > COLR_MAX_LAYERS {
                n = COLR_MAX_LAYERS
            }
            if first + n > nlay {
                return 0
            }
            var i: usize = 0
            while i < n {
                let lr: usize = t + lay_off + (first + i) * 4
                (*gids)[i] = ttf.font_u16(f, lr)
                (*idx)[i] = ttf.font_u16(f, lr + 2)
                i = i + 1
            }
            return n
        }
        if g < gid {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    return 0
}

fn cpal_palettes(f: *mut ttf.Font) -> usize {
    var c: usize = 0
    if !tbl(f, 67 as u32, 80 as u32, 65 as u32, 76 as u32, &c) {
        return 0
    }
    return ttf.font_u16(f, c + 4) as usize
}

fn cpal_color(f: *mut ttf.Font, palette: usize, idx: u32, out: *mut u32) -> bool {
    var c: usize = 0
    if !tbl(f, 67 as u32, 80 as u32, 65 as u32, 76 as u32, &c) {
        return false
    }
    let nent: usize = ttf.font_u16(f, c + 2) as usize
    let npal: usize = ttf.font_u16(f, c + 4) as usize
    let ncol: usize = ttf.font_u16(f, c + 6) as usize
    let arr: usize = ttf.font_u32(f, c + 8) as usize
    if palette >= npal || (idx as usize) >= nent {
        return false
    }
    let first: usize = ttf.font_u16(f, c + 12 + palette * 2) as usize
    if first + (idx as usize) >= ncol {
        return false
    }
    let rec: usize = c + arr + (first + idx as usize) * 4
    let w: u32 = ttf.font_u32(f, rec) // B G R A
    let b: u32 = (w >> 24 as u32) & 255 as u32
    let g: u32 = (w >> 16 as u32) & 255 as u32
    let r: u32 = (w >> 8 as u32) & 255 as u32
    let a: u32 = w & 255 as u32
    *out = (a << 24 as u32) | (b << 16 as u32) | (g << 8 as u32) | r
    return true
}
