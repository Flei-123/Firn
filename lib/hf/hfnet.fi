import std.rt
import std.env
import std.time
import net.http
import net.url
import net.download

export {
    HfNet, HfRes,
    hfnet_new, hfnet_free, hfnet_set_timeout, hfnet_set_retries,
    hfnet_set_cancel_flag, hfnet_cancel, hfnet_cancelled, hfnet_nap,
    hfnet_resp, hfnet_api, hfnet_data, hfnet_token_len,
    hfnet_auth, hfnet_headers, hfnet_get_body, hfnet_resolve, hfnet_backoff,
    hfnet_transient, hfnet_retry_limit, hfnet_token_into, hfnet_requests, hfnet_retries_used, hfnet_resolves,
    hf_token_load, hf_res_new, hf_res_free, hf_res_url, hf_res_sha,
    hf_parse_u64, hf_str_eq, hf_hex_ok,
    HF_OK, HF_ERR_URL, HF_ERR_NET, HF_ERR_HTTP, HF_ERR_PARSE, HF_ERR_CANCEL,
    HF_ERR_NOMEM, HF_ERR_SIZE, HF_ERR_SHORT,
}

const HF_OK: u64 = 0
const HF_ERR_URL: u64 = 1
const HF_ERR_NET: u64 = 2
const HF_ERR_HTTP: u64 = 3
const HF_ERR_PARSE: u64 = 4
const HF_ERR_CANCEL: u64 = 5
const HF_ERR_NOMEM: u64 = 6
const HF_ERR_SIZE: u64 = 7
const HF_ERR_SHORT: u64 = 8

const NET_REDIRECT: u32 = 13
const NET_ABORTED: u32 = 17
const MAX_HOPS: u64 = 5
const NAP_SLICE_MS: u64 = 25

struct HfNet {
    api: u64,
    data: u64,
    resp: http.Response,
    token: rt.Buf,
    own_cancel: u64,
    cancel_ptr: u64,
    retries: u64,
    backoff_base: u64,
    backoff_cap: u64,
    timeout_ms: u64,
    requests: u64,
    retries_used: u64,
    resolves: u64,
}

struct HfRes {
    url: rt.Buf,
    size: u64,
    have_size: bool,
    sha: [u8; 64],
    have_sha: bool,
    auth: bool,
    status: u64,
    err: u64,
    net: u64,
}

fn hfnet_size_of[T: Any]() -> usize {
    return size_of[T]()
}

fn hf_hex_ok(p: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        let ok: bool = (c >= 48 as u8 && c <= 57 as u8) || (c >= 97 as u8 && c <= 102 as u8) || (c >= 65 as u8 && c <= 70 as u8)
        if !ok {
            return false
        }
        i = i + 1
    }
    return true
}

fn hf_parse_u64(p: u64, n: usize, ok: *mut bool) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    *ok = n > 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c < 48 as u8 || c > 57 as u8 {
            *ok = false
            return 0
        }
        v = v * 10 + (c - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn hf_str_eq(a: str, b: str) -> bool {
    return a.n == b.n && rt.mem_eq(a.p as u64, b.p as u64, a.n)
}

fn token_ok(p: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c <= 32 as u8 || c >= 127 as u8 {
            return false
        }
        i = i + 1
    }
    return true
}

fn hf_token_load(arg: str, out: *mut rt.Buf) -> bool {
    rt.buf_clear(out)
    if arg.n > 0 {
        rt.buf_push_bytes(out, arg.p as u64, arg.n)
        return token_ok((*out).ptr, (*out).len)
    }
    if env.get_into("HF_TOKEN", out) && (*out).len > 0 {
        return token_ok((*out).ptr, (*out).len)
    }
    rt.buf_clear(out)
    if env.get_into("HUGGING_FACE_HUB_TOKEN", out) && (*out).len > 0 {
        return token_ok((*out).ptr, (*out).len)
    }
    rt.buf_clear(out)
    return true
}

fn make_client(max_redirects: u32, gzip: bool, timeout_ms: u64) -> u64 {
    let blk: u64 = rt.heap_alloc(hfnet_size_of[http.Client]())
    if blk == 0 {
        return 0
    }
    *(blk as *mut http.Client) = http.client_new()
    let c: *mut http.Client = blk as *mut http.Client
    if !http.client_init(c) {
        http.client_free(c)
        rt.heap_free(blk, hfnet_size_of[http.Client]())
        return 0
    }
    http.client_set_gzip(c, gzip)
    http.client_set_cache(c, false)
    http.client_set_keepalive(c, true)
    http.client_set_max_redirects(c, max_redirects)
    http.client_set_timeout(c, timeout_ms)
    var ua: str = "firn-hf/1.0"
    http.client_set_user_agent(c, ua.p as u64, ua.n)
    return blk
}

fn drop_client(blk: u64) {
    if blk != 0 {
        http.client_free(blk as *mut http.Client)
        rt.heap_free(blk, hfnet_size_of[http.Client]())
    }
}

fn hfnet_new(token_arg: str) -> *mut HfNet {
    let blk: u64 = rt.heap_alloc(hfnet_size_of[HfNet]())
    if blk == 0 {
        return 0 as *mut HfNet
    }
    rt.mem_set(blk, 0 as u8, hfnet_size_of[HfNet]())
    let n: *mut HfNet = blk as *mut HfNet
    (*n).token = rt.buf_new()
    (*n).resp = http.resp_new()
    if !hf_token_load(token_arg, &(*n).token) {
        rt.buf_free(&(*n).token)
        rt.heap_free(blk, hfnet_size_of[HfNet]())
        return 0 as *mut HfNet
    }
    (*n).timeout_ms = 20000
    (*n).api = make_client(0 as u32, true, (*n).timeout_ms)
    (*n).data = make_client(0 as u32, false, (*n).timeout_ms)
    if (*n).api == 0 || (*n).data == 0 {
        hfnet_free(n)
        return 0 as *mut HfNet
    }
    (*n).cancel_ptr = (&(*n).own_cancel) as u64
    (*n).retries = 5
    (*n).backoff_base = 400
    (*n).backoff_cap = 8000
    return n
}

fn hfnet_free(n: *mut HfNet) {
    if n == 0 as *mut HfNet {
        return
    }
    drop_client((*n).api)
    drop_client((*n).data)
    http.resp_free(&(*n).resp)
    rt.buf_free(&(*n).token)
    rt.heap_free(n as u64, hfnet_size_of[HfNet]())
}

fn hfnet_set_timeout(n: *mut HfNet, ms: u64) {
    (*n).timeout_ms = ms
    http.client_set_timeout((*n).api as *mut http.Client, ms)
    http.client_set_timeout((*n).data as *mut http.Client, ms)
}

fn hfnet_set_retries(n: *mut HfNet, attempts: u64, base_ms: u64, cap_ms: u64) {
    (*n).retries = attempts
    (*n).backoff_base = base_ms
    (*n).backoff_cap = cap_ms
}

fn hfnet_set_cancel_flag(n: *mut HfNet, flag: u64) {
    if flag == 0 {
        (*n).cancel_ptr = (&(*n).own_cancel) as u64
    } else {
        (*n).cancel_ptr = flag
    }
}

fn hfnet_cancel(n: *mut HfNet) {
    *((*n).cancel_ptr as *mut u64) = 1
}

fn hfnet_cancelled(n: *mut HfNet) -> bool {
    return *((*n).cancel_ptr as *mut u64) != 0
}

fn hfnet_nap(n: *mut HfNet, ms: u64) -> bool {
    var left: u64 = ms
    while left > 0 {
        if hfnet_cancelled(n) {
            return false
        }
        var step: u64 = left
        if step > NAP_SLICE_MS {
            step = NAP_SLICE_MS
        }
        time.sleep_ms(step)
        left = left - step
    }
    return !hfnet_cancelled(n)
}

fn hfnet_resp(n: *mut HfNet) -> *mut http.Response { return &(*n).resp }
fn hfnet_api(n: *mut HfNet) -> *mut http.Client { return (*n).api as *mut http.Client }
fn hfnet_data(n: *mut HfNet) -> *mut http.Client { return (*n).data as *mut http.Client }
fn hfnet_token_len(n: *mut HfNet) -> usize { return (*n).token.len }
fn hfnet_retry_limit(n: *mut HfNet) -> u64 { return (*n).retries }
fn hfnet_token_into(n: *mut HfNet, out: *mut rt.Buf) {
    rt.buf_push_bytes(out, (*n).token.ptr, (*n).token.len)
}
fn hfnet_requests(n: *mut HfNet) -> u64 { return (*n).requests }
fn hfnet_retries_used(n: *mut HfNet) -> u64 { return (*n).retries_used }
fn hfnet_resolves(n: *mut HfNet) -> u64 { return (*n).resolves }

fn hfnet_auth(n: *mut HfNet, c: *mut http.Client, auth: bool) {
    hfnet_headers(n, c, auth, false, 0, 0)
}

fn hfnet_headers(n: *mut HfNet, c: *mut http.Client, auth: bool,
    ranged: bool, from: u64, to: u64) {
    var hb: rt.Buf = rt.buf_new()
    if auth && (*n).token.len > 0 {
        var a: str = "Authorization: Bearer "
        rt.buf_push_bytes(&hb, a.p as u64, a.n)
        rt.buf_push_bytes(&hb, (*n).token.ptr, (*n).token.len)
        rt.buf_push_bytes(&hb, "\r\n".p as u64, 2)
    }
    if ranged {
        var r: str = "Range: bytes="
        rt.buf_push_bytes(&hb, r.p as u64, r.n)
        rt.buf_push_dec_u64(&hb, from)
        rt.buf_push(&hb, 45 as u8)
        rt.buf_push_dec_u64(&hb, to)
        rt.buf_push_bytes(&hb, "\r\n".p as u64, 2)
    }
    http.client_set_headers(c, hb.ptr, hb.len)
    rt.buf_free(&hb)
}

fn hfnet_transient(net_err: u64, status: u64) -> bool {
    if net_err != 0 {
        return net_err != 1 && net_err != 2 && net_err != 13 && net_err != 16 && net_err != 17
    }
    return status == 408 || status == 429 || (status >= 500 && status <= 599)
}

fn retry_after_ms(n: *mut HfNet) -> u64 {
    var at: u64 = 0
    var nm: str = "Retry-After"
    let len: usize = http.resp_header(&(*n).resp, nm.p as u64, nm.n, &at)
    if len == 0 {
        return 0
    }
    var ok: bool = false
    let secs: u64 = hf_parse_u64(at, len, &ok)
    if !ok {
        return 0
    }
    var ms: u64 = secs * 1000
    if ms > (*n).backoff_cap {
        ms = (*n).backoff_cap
    }
    return ms
}

fn hfnet_backoff(n: *mut HfNet, round: u64, honor_retry_after: bool) -> bool {
    var ms: u64 = download.dl_backoff_ms((*n).backoff_base, (*n).backoff_cap,
        round as u32, time.monotonic_ns())
    if honor_retry_after {
        let ra: u64 = retry_after_ms(n)
        if ra > ms {
            ms = ra
        }
    }
    (*n).retries_used = (*n).retries_used + 1
    return hfnet_nap(n, ms)
}

fn head_sink(ud: u64, p: u64, count: usize) -> bool {
    return false
}

fn do_get(n: *mut HfNet, c: *mut http.Client, link: u64, nlink: usize, head_only: bool) -> u64 {
    (*n).requests = (*n).requests + 1
    if head_only {
        http.client_set_sink(c, head_sink, 0)
    }
    let e: u32 = http.http_get_num(c, link, nlink, &(*n).resp)
    if head_only {
        http.client_clear_sink(c)
    }
    return e as u64
}

fn hfnet_get_body(n: *mut HfNet, link: str, out: *mut rt.Buf, status: *mut u64) -> u64 {
    var round: u64 = 0
    *status = 0
    let c: *mut http.Client = (*n).api as *mut http.Client
    hfnet_auth(n, c, true)
    http.client_set_max_redirects(c, 3 as u32)
    while true {
        if hfnet_cancelled(n) {
            http.client_set_max_redirects(c, 0 as u32)
            return HF_ERR_CANCEL
        }
        let e: u64 = do_get(n, c, link.p as u64, link.n, false)
        let st: u64 = http.resp_status(&(*n).resp) as u64
        *status = st
        if e == 0 && st >= 200 && st < 300 {
            rt.buf_clear(out)
            rt.buf_push_bytes(out, http.resp_body_ptr(&(*n).resp), http.resp_body_len(&(*n).resp))
            http.client_set_max_redirects(c, 0 as u32)
            return HF_OK
        }
        if hfnet_transient(e, st) && round + 1 < (*n).retries {
            round = round + 1
            if !hfnet_backoff(n, round, e == 0) {
                http.client_set_max_redirects(c, 0 as u32)
                return HF_ERR_CANCEL
            }
            continue
        }
        http.client_set_max_redirects(c, 0 as u32)
        if e != 0 {
            return HF_ERR_NET
        }
        return HF_ERR_HTTP
    }
    return HF_ERR_NET
}

fn hf_res_new() -> HfRes {
    return HfRes { url: rt.buf_new(), size: 0, have_size: false, sha: [0; 64],
        have_sha: false, auth: false, status: 0, err: 0, net: 0 }
}

fn hf_res_free(r: *mut HfRes) {
    rt.buf_free(&(*r).url)
}

fn hf_res_url(r: *mut HfRes) -> str {
    return str { p: rt.buf_data(&(*r).url), n: (*r).url.len }
}

fn hf_res_sha(r: *mut HfRes) -> str {
    if !(*r).have_sha {
        return ""
    }
    return str { p: rt.ptr_of((&(*r).sha[0]) as u64), n: 64 }
}

fn take_linked(n: *mut HfNet, res: *mut HfRes) {
    var at: u64 = 0
    var h_size: str = "X-Linked-Size"
    let ls: usize = http.resp_header(&(*n).resp, h_size.p as u64, h_size.n, &at)
    if ls > 0 && !(*res).have_size {
        var ok: bool = false
        let v: u64 = hf_parse_u64(at, ls, &ok)
        if ok {
            (*res).size = v
            (*res).have_size = true
        }
    }
    var h_etag: str = "X-Linked-ETag"
    let le: usize = http.resp_header(&(*n).resp, h_etag.p as u64, h_etag.n, &at)
    if le > 0 && !(*res).have_sha {
        var p: u64 = at
        var m: usize = le
        if m >= 2 && rt.ld8(p, 0) == 87 as u8 && rt.ld8(p, 1) == 47 as u8 {
            p = p + 2
            m = m - 2
        }
        if m >= 2 && rt.ld8(p, 0) == 34 as u8 && rt.ld8(p, m - 1) == 34 as u8 {
            p = p + 1
            m = m - 2
        }
        if m == 64 && hf_hex_ok(p, 64) {
            rt.mem_copy((&(*res).sha[0]) as u64, p, 64)
            (*res).have_sha = true
        }
    }
}

fn size_of_answer(n: *mut HfNet, res: *mut HfRes, status: u64) {
    if (*res).have_size {
        return
    }
    var at: u64 = 0
    var h_cr: str = "Content-Range"
    let lr: usize = http.resp_header(&(*n).resp, h_cr.p as u64, h_cr.n, &at)
    if lr > 0 {
        var i: usize = 0
        var slash: usize = lr
        while i < lr {
            if rt.ld8(at, i) == 47 as u8 {
                slash = i
            }
            i = i + 1
        }
        if slash + 1 < lr {
            var ok: bool = false
            let v: u64 = hf_parse_u64(at + (slash + 1) as u64, lr - slash - 1, &ok)
            if ok {
                (*res).size = v
                (*res).have_size = true
                return
            }
        }
    }
    if status == 200 {
        let clen: u64 = http.client_body_clen((*n).api as *mut http.Client)
        if clen != http.NO_LEN {
            (*res).size = clen
            (*res).have_size = true
        }
    }
}

fn same_host(a: *mut url.Url, b: *mut url.Url) -> bool {
    return url.url_host_len(a) == url.url_host_len(b) &&
        rt.mem_eq(url.url_host_ptr(a), url.url_host_ptr(b), url.url_host_len(a)) &&
        url.url_port(a) == url.url_port(b)
}

fn hfnet_resolve(n: *mut HfNet, link: str, res: *mut HfRes) -> bool {
    (*n).resolves = (*n).resolves + 1
    rt.buf_clear(&(*res).url)
    (*res).size = 0
    (*res).have_size = false
    (*res).have_sha = false
    (*res).auth = false
    (*res).status = 0
    (*res).err = 0
    (*res).net = 0
    var origin: url.Url = url.url_new()
    if !url.url_parse(link.p as u64, link.n, &origin) {
        (*res).err = HF_ERR_URL
        return false
    }
    var cur: url.Url = url.url_new()
    url.url_parse(link.p as u64, link.n, &cur)
    let c: *mut http.Client = (*n).api as *mut http.Client
    var kb: rt.Buf = rt.buf_new()
    var hop: u64 = 0
    var done: bool = false
    var good: bool = false
    while !done {
        if hfnet_cancelled(n) {
            (*res).err = HF_ERR_CANCEL
            break
        }
        if hop > MAX_HOPS {
            (*res).err = HF_ERR_NET
            (*res).net = 13
            break
        }
        rt.buf_clear(&kb)
        url.url_write(&cur, &kb)
        let same: bool = same_host(&cur, &origin)
        hfnet_headers(n, c, same, true, 0, 0)
        var round: u64 = 0
        var e: u64 = 0
        var st: u64 = 0
        var again: bool = true
        while again {
            again = false
            e = do_get(n, c, kb.ptr, kb.len, true)
            st = http.resp_status(&(*n).resp) as u64
            if e == NET_ABORTED as u64 {
                st = http.client_body_status(c) as u64
                e = 0
            }
            if e == NET_REDIRECT as u64 {
                e = 0
            }
            if hfnet_transient(e, st) && round + 1 < (*n).retries {
                round = round + 1
                if !hfnet_backoff(n, round, e == 0) {
                    (*res).err = HF_ERR_CANCEL
                    done = true
                    break
                }
                again = true
            }
        }
        if done {
            break
        }
        (*res).status = st
        if e != 0 {
            (*res).err = HF_ERR_NET
            (*res).net = e
            break
        }
        if st >= 300 && st < 400 {
            take_linked(n, res)
            var at: u64 = 0
            var h_loc: str = "Location"
            let ln: usize = http.resp_header(&(*n).resp, h_loc.p as u64, h_loc.n, &at)
            if ln == 0 {
                (*res).err = HF_ERR_PARSE
                break
            }
            var next: url.Url = url.url_new()
            if !url.url_parse_rel(&cur, at, ln, &next) {
                (*res).err = HF_ERR_PARSE
                break
            }
            if !same_host(&next, &origin) && (*res).have_size {
                rt.buf_clear(&(*res).url)
                url.url_write(&next, &(*res).url)
                (*res).auth = false
                good = true
                break
            }
            cur = next
            hop = hop + 1
            continue
        }
        if st == 200 || st == 206 {
            take_linked(n, res)
            size_of_answer(n, res, st)
            rt.buf_clear(&(*res).url)
            rt.buf_push_bytes(&(*res).url, kb.ptr, kb.len)
            (*res).auth = same
            good = true
            break
        }
        (*res).err = HF_ERR_HTTP
        break
    }
    rt.buf_free(&kb)
    return good
}
