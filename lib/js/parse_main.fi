// SPDX-License-Identifier: GPL-2.0-only
// lib/js/parse_main.fi -- the driver of the PARSER (root file).
//
// It reads a stream of jobs from standard input and writes one line per job
// onto standard output. The job format is little-endian:
//
//     u32  mode        0 = script, 1 = module
//     u32  n ; u8[n]   the source text (UTF-8)
//
// The end of the stream is the end of the input. The answer per job:
//
//     OK <nodes>              the program parses
//     ERR <code> <line>       it does not, with the error class and the line
//
// The error classes are the numbers of `parse.ERR_*`: 1 syntax, 2 strict
// mode, 3 assignment target, 4 duplicate declaration, 5 label,
// 6 deliberately not supported (generators, async, BigInt, ...). All of
// them are SyntaxError in the language; the split exists so that the
// harness can say WHY something was rejected.
//
// Compile with:  firnc -o build/jsparse lib/js/parse_main.fi
import html.mem
import js.lex
import js.ast
import js.parse

fn read_u32(b: *mut mem.Buf, off: usize) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < 4 {
        v = v | ((mem.buf_at(b, off + i) as u32) << (8 * i as u32))
        i = i + 1
    }
    return v
}

fn put_ascii(out: *mut mem.Buf, p: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        mem.buf_push(out, *((p as usize + i) as *mut u8))
        i = i + 1
    }
}

fn main() -> i32 {
    var input: mem.Buf = mem.buf_new()
    mem.buf_init(&input)
    mem.read_all_stdin(&input)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)

    var nm: lex.Names = lex.Names { pool: mem.cp_new(), off: mem.cp_new(),
        len: mem.cp_new(), hash: mem.cp_new(), buckets: mem.cp_new(),
        mask: 0, n: 0 }
    lex.names_init(&nm)

    let total: usize = mem.buf_len(&input)
    var off: usize = 0
    while off + 8 <= total {
        let mode: u32 = read_u32(&input, off)
        let n: usize = read_u32(&input, off + 4) as usize
        off = off + 8
        if off + n > total {
            break
        }
        // A fresh lexer and a fresh tree per job -- nothing carries over.
        var l: lex.Lexer = lex.lex_new()
        lex.lex_init(&l, &nm)
        var t: ast.Ast = ast.ast_new()
        ast.ast_init(&t)
        var p: parse.Parser = parse.parser_new()
        parse.parser_init(&p, &l, &t, &nm)
        lex.lex_set_utf8(&l, (mem.buf_ptr(&input) as usize + off) as *mut u8, n)
        let prog: u32 = parse.parse_program(&p, mode == 1 as u32)
        let err: u32 = parse.parse_error(&p)
        if err == parse.ERR_NONE {
            var okw: [u8; 3] = "OK "
            put_ascii(&out, &okw[0], 3)
            mem.buf_push_dec(&out, ast.ast_count(&t) as u64)
        } else {
            var ew: [u8; 4] = "ERR "
            put_ascii(&out, &ew[0], 4)
            mem.buf_push_dec(&out, err as u64)
            mem.buf_push(&out, 32 as u8)
            mem.buf_push_dec(&out, parse.parse_error_line(&p) as u64)
        }
        mem.buf_push(&out, 10 as u8)
        parse.parser_free(&p)
        ast.ast_free(&t)
        lex.lex_free(&l)
        off = off + n
        if mem.buf_len(&out) > 1 << 16 {
            mem.buf_flush(&out, 1)
        }
    }
    mem.buf_flush(&out, 1)
    mem.buf_free(&out)
    mem.buf_free(&input)
    lex.names_free(&nm)
    return 0
}
