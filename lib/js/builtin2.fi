// SPDX-License-Identifier: GPL-2.0-only
// lib/js/builtin2.fi -- the BUILT IN OBJECTS OF ROUND 74.
//
// Round 63 built the object model and the first built ins, round 66 added
// the generators, the promises and BigInt. What was left over was the long
// tail: the well known symbols and their protocols, the iterators of the
// ordinary collections, the missing halves of Object, Math, Number, String
// and Array, the set operations, the weak collections, `Reflect`, the URI
// functions and the host object `$262` that the suite of TC39 expects.
//
// It is a SECOND file and not a bigger `lib/js/builtin.fi` for two
// reasons. The first is the merge: round 71 works in the compiler at the
// same time, and a file that only grows at the end conflicts with nothing.
// The second is the dispatcher -- `native_dispatch` decides in RANGES, so
// a second table costs exactly one comparison, and the numbers of this
// round (1000 to 8999) lie in one block that nothing else uses.
//
// Everything here is written in Firn, without a foreign library. `RegExp`
// (lib/js/regexp.fi), `Date` (lib/js/date.fi) and `Proxy`
// (lib/js/proxy.fi) are their own files and are reached from here, so the
// import graph stays a tree: val -> interp -> {regexp, date, proxy} ->
// builtin2 -> builtin.
import html.mem
import str.ucd
import std.math
import std.num
import js.lex
import js.ast
import js.val
import js.interp
import js.regexp
import js.date

export {
    install2, dispatch2, B2_BASE, B2_END, iter_new, iter_result,
    iterate_iterator, apply_descriptor, descriptor_of, own_keys_all,
    ITK_ARRAY_VALUES, case_convert, install_cause,
}

// The numbers of this round. `builtin.native_dispatch` hands everything in
// [B2_BASE, B2_END) over to `dispatch2`.
const B2_BASE: u64 = 1000
const B2_END: u64 = 9000

