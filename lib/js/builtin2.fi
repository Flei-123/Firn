// The kinds of a built in iterator. The kind decides what `next` hands
// back, the target decides where it reads.
const ITK_ARRAY_KEYS: u64 = 0
const ITK_ARRAY_VALUES: u64 = 1
const ITK_ARRAY_ENTRIES: u64 = 2
const ITK_STRING: u64 = 3
const ITK_MAP_KEYS: u64 = 4
const ITK_MAP_VALUES: u64 = 5
const ITK_MAP_ENTRIES: u64 = 6
const ITK_SET_KEYS: u64 = 7
const ITK_SET_VALUES: u64 = 8
const ITK_SET_ENTRIES: u64 = 9

// --------------------------------------------------------------- Helpers

fn arg(r: Gc[Realm], args: Gc[GcVec], i: u64) -> Gc[JsVal] {
    return interp.args_at(r, args, i)
}

fn nargs(args: Gc[GcVec]) -> u64 {
    return gcvec_length(args)
}

fn thrown(r: Gc[Realm]) -> bool {
    let c: *mut interp.Ctx = interp.ctx_of(r)
    return (*c).comp != interp.C_NORMAL
}

fn type_err(r: Gc[Realm], m: *mut u8, n: usize) -> AllocError!Gc[JsVal] {
    return interp.throw_type_here(r, m, n)
}

fn range_err(r: Gc[Realm], m: *mut u8, n: usize) -> AllocError!Gc[JsVal] {
    return interp.throw_error(r, interp.ERR_RANGE, m, n)
}

fn key_ascii(r: Gc[Realm], name: *mut u8, n: usize) -> AllocError!u64 {
    let s: Gc[JsVal] = try val.str_from_ascii(r, name, n)
    return val.key_for_str(r, s)
}

fn nat(r: Gc[Realm], target: Gc[JsObj], name: *mut u8, n: usize, id: u64,
    arity: u64) -> AllocError!bool {
    let f: Gc[JsObj] = try interp.make_native(r, id, arity, name, n)
    let k: u64 = try key_ascii(r, name, n)
    let fv: Gc[JsVal] = f
    return interp.define_value(r, target, k, fv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
}

fn put(r: Gc[Realm], target: Gc[JsObj], name: *mut u8, n: usize,
    v: Gc[JsVal], attrs: u64) -> AllocError!bool {
    let k: u64 = try key_ascii(r, name, n)
    return interp.define_value(r, target, k, v, attrs)
}

fn put_num(r: Gc[Realm], target: Gc[JsObj], name: *mut u8, n: usize,
    x: f64, attrs: u64) -> AllocError!bool {
    let v: Gc[JsVal] = try val.realm_num(r, x)
    return put(r, target, name, n, v, attrs)
}

// A getter without a setter, the shape `description`, `size` and
// `__proto__` need.
fn getter(r: Gc[Realm], target: Gc[JsObj], name: *mut u8, n: usize,
    id: u64) -> AllocError!bool {
    let f: Gc[JsObj] = try interp.make_native(r, id, 0, name, n)
    let fv: Gc[JsVal] = f
    let k: u64 = try key_ascii(r, name, n)
    return interp.define_accessor(r, target, k, fv, val.realm_undefined(r),
        val.A_CONFIGURABLE)
}

// The sign of a floating point value is flipped over the BIT PATTERN --
// stage 0 has no unary minus for `f64` (docs/ROUND63.md, gap 1), and
// `0.0 - x` would turn `-0` into `+0`.
fn negf(x: f64) -> f64 {
    return math.math_f64(math.math_bits(x) ^ 0x8000000000000000)
}

fn nan() -> f64 {
    return math.math_f64(0x7FF8000000000000)
}

fn inf() -> f64 {
    return math.math_f64(0x7FF0000000000000)
}

// The BIT PATTERN, not the value: an error union over `f64` hands back a
// wrong number in stage 0 (docs/ROUND63.md, gap 2), so every conversion
// that can fail travels as a `u64` here, exactly as the rest of the engine
// does it.
fn num_arg(r: Gc[Realm], args: Gc[GcVec], i: u64) -> AllocError!u64 {
    return interp.to_number(r, arg(r, args, i))
}

// A new array out of a vector of values.
fn new_array_from(r: Gc[Realm], items: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    let a: Gc[JsObj] = try val.array_new(r)
    var i: u64 = 0
    while i < gcvec_length(items) {
        let ok: bool = try val.elems_push(r, a, gcvec_read[JsVal](items, i))
        a.len = a.len + 1
        i = i + 1
    }
    let av: Gc[JsVal] = a
    return av
}

fn pair_array(r: Gc[Realm], a: Gc[JsVal], b: Gc[JsVal]) -> AllocError!Gc[JsVal] {
    let items: Gc[GcVec] = try interp.args_new(r)
    let o1: bool = try gcvec_append[JsVal](items, a)
    let o2: bool = try gcvec_append[JsVal](items, b)
    return new_array_from(r, items)
}

// The array like reading path, the same one lib/js/builtin.fi uses.
fn alen(r: Gc[Realm], o: Gc[JsVal]) -> AllocError!u64 {
    let ob: Gc[JsObj] = val.as_obj(o)
    if (ob as u64) != 0 && ob.cls == val.CLS_ARRAY {
        return ob.len
    }
    let k: u64 = try val.key_for_name(r, lex.N_LENGTH)
    let lv: Gc[JsVal] = try interp.get_prop(r, o, k)
    return interp.to_length(r, lv)
}

fn aget(r: Gc[Realm], o: Gc[JsVal], i: u64) -> AllocError!Gc[JsVal] {
    let k: u64 = try val.key_for_index(r, i)
    return interp.get_prop(r, o, k)
}

fn ahas(r: Gc[Realm], o: Gc[JsVal], i: u64) -> AllocError!bool {
    let k: u64 = try val.key_for_index(r, i)
    return interp.has_prop(r, o, k)
}

fn aset(r: Gc[Realm], o: Gc[JsVal], i: u64, v: Gc[JsVal]) -> AllocError!bool {
    let ob: Gc[JsObj] = val.as_obj(o)
    if (ob as u64) != 0 && ob.cls == val.CLS_ARRAY && val.elems_dense_ok(i) {
        let ok: bool = try val.elems_set(r, ob, i, v)
        if i >= ob.len {
            ob.len = i + 1
        }
        return true
    }
    let k: u64 = try val.key_for_index(r, i)
    return interp.set_prop(r, o, k, v, true)
}

// A relative index of the specification: negative counts from the end.
fn rel_index(r: Gc[Realm], v: Gc[JsVal], n: u64, dflt: u64) -> AllocError!u64 {
    if val.is_undefined(v) {
        return dflt
    }
    var x: f64 = math.math_f64(try interp.to_integer(r, v))
    if x < 0.0 {
        x = (n as f64) + x
        if x < 0.0 {
            x = 0.0
        }
    }
    if x > (n as f64) {
        return n
    }
    return x as u64
}

// ====================================================== The iterator objects
//
// One shape for all of them: the TARGET lies in `prim`, the INDEX in `len`,
// the kind in `node`. An exhausted iterator drops its target so that the
// collector can take it -- that is what the endurance run of this round
// measures on the `for ... of` path.

fn iter_new(r: Gc[Realm], target: Gc[JsVal], kind: u64,
    proto: u64) -> AllocError!Gc[JsVal] {
    let o: Gc[JsObj] = try val.obj_new_proto(r, val.realm_proto(r, proto))
    o.prim = target
    o.node = kind
    o.len = 0
    o.flags = val.F_EXTENSIBLE
    o.cls = val.CLS_ITERATOR
    let ov: Gc[JsVal] = o
    return ov
}

fn iter_result(r: Gc[Realm], v: Gc[JsVal], done: bool) -> AllocError!Gc[JsVal] {
    let o: Gc[JsObj] = try val.obj_new(r)
    let vk: u64 = try val.key_for_name(r, lex.N_VALUE)
    let dk: u64 = try val.key_for_name(r, lex.N_DONE)
    let o1: bool = try interp.define_value(r, o, vk, v, val.A_DEFAULT)
    let o2: bool = try interp.define_value(r, o, dk, val.realm_bool(r, done),
        val.A_DEFAULT)
    let ov: Gc[JsVal] = o
    return ov
}

fn iter_done(r: Gc[Realm], o: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    o.prim = gc_null[JsVal]()
    return iter_result(r, val.realm_undefined(r), true)
}

fn iter_next(r: Gc[Realm], this: Gc[JsVal]) -> AllocError!Gc[JsVal] {
    let o: Gc[JsObj] = val.as_obj(this)
    if (o as u64) == 0 || o.cls != val.CLS_ITERATOR {
        var m: [u8; 33] = "next called on a foreign receiver"
        return type_err(r, &m[0], 33)
    }
    let t: Gc[JsVal] = o.prim
    if (t as u64) == 0 {
        return iter_result(r, val.realm_undefined(r), true)
    }
    let kind: u64 = o.node
    let i: u64 = o.len
    if kind == ITK_STRING {
        let n: u64 = val.str_len(t)
        if i >= n {
            return iter_done(r, o)
        }
        var w: u64 = 1
        let u: u32 = val.str_at(t, i)
        if u >= 0xD800 as u32 && u <= 0xDBFF as u32 && i + 1 < n {
            let u2: u32 = val.str_at(t, i + 1)
            if u2 >= 0xDC00 as u32 && u2 <= 0xDFFF as u32 {
                w = 2
            }
        }
        o.len = i + w
        let piece: Gc[JsVal] = try val.str_slice(r, t, i, i + w)
        return iter_result(r, piece, false)
    }
    if kind <= ITK_ARRAY_ENTRIES {
        let n: u64 = try alen(r, t)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        if i >= n {
            return iter_done(r, o)
        }
        o.len = i + 1
        let iv: Gc[JsVal] = try val.realm_num(r, i as f64)
        if kind == ITK_ARRAY_KEYS {
            return iter_result(r, iv, false)
        }
        let e: Gc[JsVal] = try aget(r, t, i)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        if kind == ITK_ARRAY_VALUES {
            return iter_result(r, e, false)
        }
        let p: Gc[JsVal] = try pair_array(r, iv, e)
        return iter_result(r, p, false)
    }
    // Map and Set: the entries lie in the dense storage of the collection,
    // key and value alternating for a Map, one slot per element for a Set.
    let coll: Gc[JsObj] = val.as_obj(t)
    if (coll as u64) == 0 {
        return iter_result(r, val.realm_undefined(r), true)
    }
    let step: u64 = 2
    var idx: u64 = i
    if kind >= ITK_SET_KEYS {
        while idx < val.elems_len(coll) {
            let e: Gc[JsVal] = val.elems_get(r, coll, idx)
            if !val.is_gap(e) {
                o.len = idx + 1
                if kind == ITK_SET_ENTRIES {
                    let p: Gc[JsVal] = try pair_array(r, e, e)
                    return iter_result(r, p, false)
                }
                return iter_result(r, e, false)
            }
            idx = idx + 1
        }
        return iter_done(r, o)
    }
    while idx + 1 < val.elems_len(coll) {
        let k: Gc[JsVal] = val.elems_get(r, coll, idx)
        if !val.is_gap(k) {
            let v: Gc[JsVal] = val.elems_get(r, coll, idx + 1)
            o.len = idx + step
            if kind == ITK_MAP_KEYS {
                return iter_result(r, k, false)
            }
            if kind == ITK_MAP_VALUES {
                return iter_result(r, v, false)
            }
            let p: Gc[JsVal] = try pair_array(r, k, v)
            return iter_result(r, p, false)
        }
        idx = idx + step
    }
    return iter_done(r, o)
}

// ================================================================ Symbol
//
// The well known symbols are ONE object each in the realm; the registry of
// `Symbol.for` is a second table beside them, keyed by the description.

fn symbol2_fn(r: Gc[Realm], id: u64, this: Gc[JsVal],
    args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    if id == N_SYM_FOR {
        let s: Gc[JsVal] = try interp.to_string(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let reg: Gc[JsObj] = val.realm_registry(r)
        let k: u64 = try val.key_for_str(r, s)
        let p: Gc[Prop] = val.obj_get_own(reg, k)
        if (p as u64) != 0 {
            return val.prop_value(p)
        }
        let sym: Gc[JsVal] = try val.sym_new(r, s)
        let ok: bool = try interp.define_value(r, reg, k, sym, val.A_DEFAULT)
        return sym
    }
    if id == N_SYM_KEYFOR {
        if val.val_tag(arg(r, args, 0)) != val.TAG_SYM {
            var m: [u8; 28] = "Symbol.keyFor needs a symbol"
            return type_err(r, &m[0], 28)
        }
        let want: Gc[JsVal] = arg(r, args, 0)
        let reg: Gc[JsObj] = val.realm_registry(r)
        var i: u64 = 0
        while i < val.obj_key_count(reg) {
            let k: u64 = val.obj_key_at(reg, i)
            let p: Gc[Prop] = val.obj_get_own(reg, k)
            if (p as u64) != 0 && (val.prop_value(p) as u64) == (want as u64) {
                return val.key_name_str(r, k)
            }
            i = i + 1
        }
        return val.realm_undefined(r)
    }
    // Symbol.prototype.description and Symbol.prototype[Symbol.toPrimitive]
    var s0: Gc[JsVal] = this
    if val.val_tag(s0) != val.TAG_SYM {
        let o: Gc[JsObj] = val.as_obj(s0)
        if (o as u64) != 0 && val.val_tag(o.prim) == val.TAG_SYM {
            s0 = o.prim
        } else {
            var m: [u8; 12] = "not a Symbol"
            return type_err(r, &m[0], 12)
        }
    }
    if id == N_SYM_TOPRIMITIVE {
        return s0
    }
    let d: Gc[JsVal] = val.sym_desc(s0)
    if (d as u64) == 0 {
        return val.realm_undefined(r)
    }
    return d
}

// ================================================================ Object

fn object2_fn(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if id == N_OBJ_HASOWN {
        let o: Gc[JsObj] = try interp.to_object(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let k: u64 = try interp.to_property_key(r, arg(r, args, 1))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let ov: Gc[JsVal] = o
        if o.cls == val.CLS_ARRAY || o.cls == val.CLS_ARGUMENTS || o.cls == val.CLS_STRING {
            let i: i64 = val.index_of_key(r, k)
            if i >= 0 {
                let has: bool = try index_present(r, o, i as u64)
                if has {
                    return val.realm_bool(r, true)
                }
            }
        }
        return val.realm_bool(r, (val.obj_get_own(o, k) as u64) != 0)
    }
    if id == N_OBJ_FROMENTRIES {
        let src: Gc[JsVal] = arg(r, args, 0)
        if val.is_nullish(src) {
            var m: [u8; 42] = "Object.fromEntries needs an iterable value"
            return type_err(r, &m[0], 42)
        }
        let items: Gc[GcVec] = try interp.iterate_values(r, src)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let o: Gc[JsObj] = try val.obj_new(r)
        var i: u64 = 0
        while i < gcvec_length(items) {
            let e: Gc[JsVal] = gcvec_read[JsVal](items, i)
            if val.val_tag(e) != val.TAG_OBJ && val.val_tag(e) != val.TAG_STR {
                var m: [u8; 26] = "an entry must be an object"
                return type_err(r, &m[0], 26)
            }
            let kv: Gc[JsVal] = try aget(r, e, 0)
            let vv: Gc[JsVal] = try aget(r, e, 1)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let k: u64 = try interp.to_property_key(r, kv)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let ok: bool = try interp.define_value(r, o, k, vv, val.A_DEFAULT)
            i = i + 1
        }
        let ov: Gc[JsVal] = o
        return ov
    }
    if id == N_OBJ_GROUPBY {
        let src: Gc[JsVal] = arg(r, args, 0)
        let f: Gc[JsVal] = arg(r, args, 1)
        if !val.is_callable(f) {
            var m: [u8; 28] = "the callback is not callable"
            return type_err(r, &m[0], 28)
        }
        let items: Gc[GcVec] = try interp.iterate_values(r, src)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let o: Gc[JsObj] = try val.obj_new_proto(r, gc_null[JsObj]())
        var i: u64 = 0
        while i < gcvec_length(items) {
            let e: Gc[JsVal] = gcvec_read[JsVal](items, i)
            let ca: Gc[GcVec] = try interp.args_new(r)
            let o1: bool = try gcvec_append[JsVal](ca, e)
            let iv: Gc[JsVal] = try val.realm_num(r, i as f64)
            let o2: bool = try gcvec_append[JsVal](ca, iv)
            let kv: Gc[JsVal] = try interp.call_function(r, f,
                val.realm_undefined(r), ca)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let k: u64 = try interp.to_property_key(r, kv)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let p: Gc[Prop] = val.obj_get_own(o, k)
            var bucket: Gc[JsVal] = val.realm_undefined(r)
            if (p as u64) != 0 {
                bucket = val.prop_value(p)
            } else {
                let ba: Gc[JsObj] = try val.array_new(r)
                bucket = ba
                let ok: bool = try interp.define_value(r, o, k, bucket,
                    val.A_DEFAULT)
            }
            let bo: Gc[JsObj] = val.as_obj(bucket)
            let ok2: bool = try val.elems_push(r, bo, e)
            bo.len = bo.len + 1
            i = i + 1
        }
        let ov: Gc[JsVal] = o
        return ov
    }
    if id == N_OBJ_GOPS {
        let o: Gc[JsObj] = try interp.to_object(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let items: Gc[GcVec] = try interp.args_new(r)
        var i: u64 = 0
        while i < val.obj_key_count(o) {
            let k: u64 = val.obj_key_at(o, i)
            if val.key_is_symbol(k) {
                let p: Gc[Prop] = val.obj_get_own(o, k)
                if (p as u64) != 0 {
                    let ok: bool = try gcvec_append[JsVal](items,
                        val.key_name_str(r, k))
                }
            }
            i = i + 1
        }
        return new_array_from(r, items)
    }
    if id == N_OBJ_GOPDS {
        let o: Gc[JsObj] = try interp.to_object(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let out: Gc[JsObj] = try val.obj_new(r)
        let ov: Gc[JsVal] = o
        let keys: Gc[GcVec] = try own_keys_all(r, o)
        var i: u64 = 0
        while i < gcvec_length(keys) {
            let k: u64 = gcvec_read_raw(keys, i)
            let d: Gc[JsVal] = try descriptor_of(r, o, k)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            if !val.is_undefined(d) {
                let ok: bool = try interp.define_value(r, out, k, d,
                    val.A_DEFAULT)
            }
            i = i + 1
        }
        let outv: Gc[JsVal] = out
        return outv
    }
    // Object.prototype.__defineGetter__ and friends (Annex B.2.2).
    if id == N_OP_PROTO_GET {
        let o: Gc[JsObj] = try interp.to_object(r, this)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let p: Gc[JsObj] = val.obj_proto(o)
        if (p as u64) == 0 {
            return val.realm_null(r)
        }
        let pv: Gc[JsVal] = p
        return pv
    }
    if id == N_OP_PROTO_SET {
        if val.is_nullish(this) {
            var m: [u8; 40] = "__proto__ called on undefined or on null"
            return type_err(r, &m[0], 40)
        }
        let v: Gc[JsVal] = arg(r, args, 0)
        if val.val_tag(v) != val.TAG_OBJ && val.val_tag(v) != val.TAG_NULL {
            return val.realm_undefined(r)
        }
        if val.val_tag(this) != val.TAG_OBJ {
            return val.realm_undefined(r)
        }
        let o: Gc[JsObj] = val.as_obj(this)
        if o.flags & val.F_EXTENSIBLE == 0 {
            var m: [u8; 37] = "the object is not extensible any more"
            return type_err(r, &m[0], 37)
        }
        // A cycle in the prototype chain is a TypeError (10.1.2.1).
        var w: Gc[JsObj] = val.as_obj(v)
        while (w as u64) != 0 {
            if (w as u64) == (o as u64) {
                var m: [u8; 36] = "a prototype chain must not be cyclic"
                return type_err(r, &m[0], 36)
            }
            w = val.obj_proto(w)
        }
        val.obj_set_proto(o, val.as_obj(v))
        return val.realm_undefined(r)
    }
    let o: Gc[JsObj] = try interp.to_object(r, this)
    if thrown(r) {
        return val.realm_undefined(r)
    }
    if id == N_OP_DEFGET || id == N_OP_DEFSET {
        let f: Gc[JsVal] = arg(r, args, 1)
        if !val.is_callable(f) {
            var m: [u8; 31] = "the accessor must be a function"
            return type_err(r, &m[0], 31)
        }
        let k: u64 = try interp.to_property_key(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        var g: Gc[JsVal] = f
        var s: Gc[JsVal] = val.realm_undefined(r)
        if id == N_OP_DEFSET {
            g = val.realm_undefined(r)
            s = f
        }
        let old: Gc[Prop] = val.obj_get_own(o, k)
        if (old as u64) != 0 && val.prop_is_accessor(old) {
            if id == N_OP_DEFSET {
                g = val.prop_value(old)
            } else {
                s = val.prop_setter(old)
            }
        }
        let ok: bool = try interp.define_accessor(r, o, k, g, s,
            val.A_ENUMERABLE | val.A_CONFIGURABLE)
        return val.realm_undefined(r)
    }
    // __lookupGetter__ / __lookupSetter__ walk the prototype chain.
    let k: u64 = try interp.to_property_key(r, arg(r, args, 0))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    var w: Gc[JsObj] = o
    while (w as u64) != 0 {
        let p: Gc[Prop] = val.obj_get_own(w, k)
        if (p as u64) != 0 {
            if !val.prop_is_accessor(p) {
                return val.realm_undefined(r)
            }
            if id == N_OP_LOOKGET {
                return val.prop_value(p)
            }
            return val.prop_setter(p)
        }
        w = val.obj_proto(w)
    }
    return val.realm_undefined(r)
}

// Is the index really an own element -- for the classes that keep their
// elements outside the property table?
fn index_present(r: Gc[Realm], o: Gc[JsObj], i: u64) -> AllocError!bool {
    if o.cls == val.CLS_STRING {
        return i < val.str_len(o.prim)
    }
    if i >= val.elems_len(o) {
        return false
    }
    return !val.is_gap(val.elems_get(r, o, i))
}

// Every own key of an object -- the indices that lie in the dense storage
// included, in the order of 10.1.11 (indices ascending, then the strings in
// insertion order, then the symbols).
fn own_keys_all(r: Gc[Realm], o: Gc[JsObj]) -> AllocError!Gc[GcVec] {
    let out: Gc[GcVec] = try gcvec_new_raw()
    var i: u64 = 0
    if o.cls == val.CLS_STRING {
        while i < val.str_len(o.prim) {
            let k: u64 = try val.key_for_index(r, i)
            let ok: bool = try gcvec_append_raw(out, k)
            i = i + 1
        }
    } else if o.cls == val.CLS_ARRAY || o.cls == val.CLS_ARGUMENTS {
        while i < val.elems_len(o) {
            if !val.is_gap(val.elems_get(r, o, i)) {
                let k: u64 = try val.key_for_index(r, i)
                let ok: bool = try gcvec_append_raw(out, k)
            }
            i = i + 1
        }
    }
    // The numeric keys of the property table come first as well.
    i = 0
    while i < val.obj_key_count(o) {
        let k: u64 = val.obj_key_at(o, i)
        if !val.key_is_symbol(k) && val.index_of_key(r, k) >= 0 {
            let ok: bool = try gcvec_append_raw(out, k)
        }
        i = i + 1
    }
    i = 0
    while i < val.obj_key_count(o) {
        let k: u64 = val.obj_key_at(o, i)
        if !val.key_is_symbol(k) && val.index_of_key(r, k) < 0 {
            let ok: bool = try gcvec_append_raw(out, k)
        }
        i = i + 1
    }
    i = 0
    while i < val.obj_key_count(o) {
        let k: u64 = val.obj_key_at(o, i)
        if val.key_is_symbol(k) {
            let ok: bool = try gcvec_append_raw(out, k)
        }
        i = i + 1
    }
    return out
}

// The property descriptor of one own key, as an object (6.2.6.4).
fn descriptor_of(r: Gc[Realm], o: Gc[JsObj], k: u64) -> AllocError!Gc[JsVal] {
    var p: Gc[Prop] = val.obj_get_own(o, k)
    if (p as u64) == 0 {
        let i: i64 = val.index_of_key(r, k)
        if i >= 0 {
            let has: bool = try index_present(r, o, i as u64)
            if has {
                let e: Gc[JsVal] = try aget(r, o, i as u64)
                var attrs: u64 = val.A_DEFAULT
                if o.cls == val.CLS_STRING {
                    attrs = val.A_ENUMERABLE
                }
                p = try gc Prop { value: e, setter: gc_null[JsVal](),
                    attrs: attrs }
            }
        }
    }
    if (p as u64) == 0 {
        return val.realm_undefined(r)
    }
    let d: Gc[JsObj] = try val.obj_new(r)
    let attrs: u64 = val.prop_attrs(p)
    if val.prop_is_accessor(p) {
        var g: [u8; 3] = "get"
        var s: [u8; 3] = "set"
        let o1: bool = try put(r, d, &g[0], 3, val.prop_value(p), val.A_DEFAULT)
        let o2: bool = try put(r, d, &s[0], 3, val.prop_setter(p), val.A_DEFAULT)
    } else {
        var v: [u8; 5] = "value"
        var w: [u8; 8] = "writable"
        let o1: bool = try put(r, d, &v[0], 5, val.prop_value(p), val.A_DEFAULT)
        let o2: bool = try put(r, d, &w[0], 8,
            val.realm_bool(r, attrs & val.A_WRITABLE != 0), val.A_DEFAULT)
    }
    var e: [u8; 10] = "enumerable"
    var c: [u8; 12] = "configurable"
    let o3: bool = try put(r, d, &e[0], 10,
        val.realm_bool(r, attrs & val.A_ENUMERABLE != 0), val.A_DEFAULT)
    let o4: bool = try put(r, d, &c[0], 12,
        val.realm_bool(r, attrs & val.A_CONFIGURABLE != 0), val.A_DEFAULT)
    let dv: Gc[JsVal] = d
    return dv
}

// ================================================================== Math
//
// The functions that round 63 left out. They are computed from the
// primitives of `lib/std/math.fi` (exp, ln, sqrt, atan2) -- this file must
// not touch anything outside `lib/js/`, so the identities stand here.

fn m_asin(x: f64) -> f64 {
    if math.is_nan(x) {
        return x
    }
    if x > 1.0 || x < negf(1.0) {
        return nan()
    }
    if x == 1.0 {
        return math.PI() / 2.0
    }
    if x == negf(1.0) {
        return negf(math.PI() / 2.0)
    }
    return math.atan2(x, math.sqrt(1.0 - x * x))
}

fn m_acos(x: f64) -> f64 {
    if math.is_nan(x) {
        return x
    }
    if x > 1.0 || x < negf(1.0) {
        return nan()
    }
    return math.PI() / 2.0 - m_asin(x)
}

fn m_expm1(x: f64) -> f64 {
    if x == 0.0 {
        return x
    }
    if math.fabs(x) > 1e-5 {
        return math.exp(x) - 1.0
    }
    // The series, so that the cancellation of exp(x)-1 does not eat the
    // significant digits near zero.
    return x + x * x / 2.0 + x * x * x / 6.0 + x * x * x * x / 24.0
}

fn m_log1p(x: f64) -> f64 {
    if x == 0.0 {
        return x
    }
    if x < negf(1.0) {
        return nan()
    }
    if x == negf(1.0) {
        return negf(inf())
    }
    if math.fabs(x) > 1e-5 {
        return math.ln(1.0 + x)
    }
    return x - x * x / 2.0 + x * x * x / 3.0 - x * x * x * x / 4.0
}

fn m_sinh(x: f64) -> f64 {
    if x == 0.0 || math.is_nan(x) || math.is_infinite(x) {
        return x
    }
    if math.fabs(x) < 1e-5 {
        return x + x * x * x / 6.0
    }
    let e: f64 = math.exp(x)
    return (e - 1.0 / e) / 2.0
}

fn m_cosh(x: f64) -> f64 {
    if math.is_nan(x) {
        return x
    }
    if math.is_infinite(x) {
        return inf()
    }
    let e: f64 = math.exp(x)
    return (e + 1.0 / e) / 2.0
}

fn m_tanh(x: f64) -> f64 {
    if x == 0.0 || math.is_nan(x) {
        return x
    }
    if math.is_infinite(x) {
        if x > 0.0 {
            return 1.0
        }
        return negf(1.0)
    }
    if x > 20.0 {
        return 1.0
    }
    if x < negf(20.0) {
        return negf(1.0)
    }
    let e: f64 = math.exp(2.0 * x)
    return (e - 1.0) / (e + 1.0)
}

fn m_asinh(x: f64) -> f64 {
    if x == 0.0 || math.is_nan(x) || math.is_infinite(x) {
        return x
    }
    if x < 0.0 {
        return negf(m_asinh(negf(x)))
    }
    return math.ln(x + math.sqrt(x * x + 1.0))
}

fn m_acosh(x: f64) -> f64 {
    if math.is_nan(x) {
        return x
    }
    if x < 1.0 {
        return nan()
    }
    if math.is_infinite(x) {
        return x
    }
    return math.ln(x + math.sqrt(x * x - 1.0))
}

fn m_atanh(x: f64) -> f64 {
    if x == 0.0 || math.is_nan(x) {
        return x
    }
    if x > 1.0 || x < negf(1.0) {
        return nan()
    }
    if x == 1.0 {
        return inf()
    }
    if x == negf(1.0) {
        return negf(inf())
    }
    return 0.5 * math.ln((1.0 + x) / (1.0 - x))
}

// The value rounded to a narrower binary format: `mant` significand bits
// (23 for binary32, 10 for binary16) and the largest exponent `emax`.
// Round to nearest, ties to even -- the same rule the hardware uses, done
// by hand because stage 0 has no narrower floating point type.
fn narrow(x: f64, mant: u64, emax: i64) -> f64 {
    if math.is_nan(x) || math.is_infinite(x) || x == 0.0 {
        return x
    }
    let bits: u64 = math.math_bits(x)
    let sign: u64 = bits & 0x8000000000000000
    let e: i64 = (((bits >> 52) & 0x7FF) as i64) - 1023
    let man: u64 = bits & 0xFFFFFFFFFFFFF
    let emin: i64 = 1 - emax
    let drop: u64 = 52 - mant
    if e > emax {
        return math.math_f64(sign | 0x7FF0000000000000)
    }
    if e >= emin {
        var keep: u64 = man >> drop
        let rest: u64 = man & ((1 << drop) - 1)
        let half: u64 = 1 << (drop - 1)
        if rest > half || (rest == half && keep & 1 == 1) {
            keep = keep + 1
        }
        var ee: i64 = e
        if keep == 1 << mant {
            keep = 0
            ee = ee + 1
            if ee > emax {
                return math.math_f64(sign | 0x7FF0000000000000)
            }
        }
        return math.math_f64(sign | (((ee + 1023) as u64) << 52) | (keep << drop))
    }
    // Subnormal in the narrow format.
    let extra: i64 = emin - e
    if extra > (mant as i64) + 1 {
        return math.math_f64(sign)
    }
    let sh: u64 = drop + (extra as u64)
    if sh >= 64 {
        return math.math_f64(sign)
    }
    let full: u64 = (1 << 52) | man
    var keep: u64 = full >> sh
    let rest: u64 = full & ((1 << sh) - 1)
    let half: u64 = 1 << (sh - 1)
    if rest > half || (rest == half && keep & 1 == 1) {
        keep = keep + 1
    }
    if keep == 0 {
        return math.math_f64(sign)
    }
    let out: f64 = math.ldexp(keep as f64, emin - (mant as i64))
    if sign != 0 {
        return negf(out)
    }
    return out
}

fn math2_fn(r: Gc[Realm], which: u64, args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    if which == MM_RANDOM {
        // xorshift64*, seeded once per realm. A random number generator is
        // not a source of entropy here and does not pretend to be one.
        var s: u64 = r.rand
        s = s ^ (s << 13)
        s = s ^ (s >> 7)
        s = s ^ (s << 17)
        r.rand = s
        // 53 significant bits, scaled into [0,1).
        let m: u64 = s >> 11
        return val.realm_num(r, (m as f64) / 9007199254740992.0)
    }
    if which == MM_SUMPRECISE {
        return sum_precise(r, arg(r, args, 0))
    }
    if which == MM_IMUL {
        let a: i32 = try interp.to_int32(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let b: i32 = try interp.to_int32(r, arg(r, args, 1))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        // ROUND 72: `Math.imul` is DEFINED (ECMA-262) as 32-bit two's
        // complement multiplication that wraps -- reading `a`/`b`'s bit
        // pattern as unsigned and multiplying that with an explicit wrap
        // (`*%`) says exactly that, the same way `lib/std/core.fi::f64_bits`
        // reads a float's bit pattern through a pointer instead of `as`:
        // Firn has no bit-reinterpretation operator, and `as` on a
        // negative `i32` into `u32` is correctly a checked, narrowing
        // conversion now (SPEC section 13, `L9`) -- reinterpreting through
        // memory is the honest way to ask for the bits, not the value.
        let au: u32 = *(((&a) as usize) as *mut u32)
        let bu: u32 = *(((&b) as usize) as *mut u32)
        var p: u32 = au *% bu
        // Same reasoning for the way back: ECMA-262 hands the 32-bit
        // PRODUCT's bit pattern back as a signed value, not its numeric
        // value truncated -- `p as i32` would panic here too (`p` can
        // legitimately carry its own sign bit set), so this reads it
        // through memory exactly like the two operands above.
        let ps: i32 = *(((&p) as usize) as *mut i32)
        return val.realm_num(r, ps as f64)
    }
    if which == MM_CLZ32 {
        let a: u32 = try interp.to_uint32(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        var n: u64 = 0
        var v: u32 = a
        while n < 32 {
            if v & 0x80000000 as u32 != 0 as u32 {
                break
            }
            v = v << 1
            n = n + 1
        }
        return val.realm_num(r, n as f64)
    }
    let x: f64 = math.math_f64(try num_arg(r, args, 0))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    if which == MM_ASIN {
        return val.realm_num(r, m_asin(x))
    }
    if which == MM_ACOS {
        return val.realm_num(r, m_acos(x))
    }
    if which == MM_SINH {
        return val.realm_num(r, m_sinh(x))
    }
    if which == MM_COSH {
        return val.realm_num(r, m_cosh(x))
    }
    if which == MM_TANH {
        return val.realm_num(r, m_tanh(x))
    }
    if which == MM_ASINH {
        return val.realm_num(r, m_asinh(x))
    }
    if which == MM_ACOSH {
        return val.realm_num(r, m_acosh(x))
    }
    if which == MM_ATANH {
        return val.realm_num(r, m_atanh(x))
    }
    if which == MM_LOG1P {
        return val.realm_num(r, m_log1p(x))
    }
    if which == MM_EXPM1 {
        return val.realm_num(r, m_expm1(x))
    }
    if which == MM_FROUND {
        return val.realm_num(r, narrow(x, 23, 127))
    }
    if which == MM_F16ROUND {
        return val.realm_num(r, narrow(x, 10, 15))
    }
    return val.realm_num(r, nan())
}

// Math.sumPrecise -- the exactly rounded sum. The partial sums are kept
// NON OVERLAPPING (the distillation of Shewchuk): every addition splits
// into a high and an exact low part, so nothing is lost until the very end.
fn sum_precise(r: Gc[Realm], it: Gc[JsVal]) -> AllocError!Gc[JsVal] {
    if val.is_nullish(it) {
        var m: [u8; 33] = "Math.sumPrecise needs an iterable"
        return type_err(r, &m[0], 33)
    }
    let items: Gc[GcVec] = try interp.iterate_values(r, it)
    if thrown(r) {
        return val.realm_undefined(r)
    }
    let parts: Gc[GcVec] = try gcvec_new_raw()
    var seen_nan: bool = false
    var pos_inf: bool = false
    var neg_inf: bool = false
    var i: u64 = 0
    while i < gcvec_length(items) {
        let e: Gc[JsVal] = gcvec_read[JsVal](items, i)
        if val.val_tag(e) != val.TAG_NUM {
            var m: [u8; 34] = "Math.sumPrecise takes numbers only"
            return type_err(r, &m[0], 34)
        }
        let x: f64 = val.num_value(e)
        i = i + 1
        if math.is_nan(x) {
            seen_nan = true
            continue
        }
        if math.is_infinite(x) {
            if x > 0.0 {
                pos_inf = true
            } else {
                neg_inf = true
            }
            continue
        }
        if x == 0.0 {
            continue
        }
        var v: f64 = x
        var w: u64 = 0
        var out: u64 = 0
        while w < gcvec_length(parts) {
            let p: f64 = math.math_f64(gcvec_read_raw(parts, w))
            let s: f64 = p + v
            let bv: f64 = s - p
            let err: f64 = (p - (s - bv)) + (v - bv)
            v = s
            if err != 0.0 {
                let ok: bool = gcvec_set_raw(parts, out, math.math_bits(err))
                out = out + 1
            }
            w = w + 1
        }
        while gcvec_length(parts) > out {
            let ok: bool = gcvec_remove(parts, gcvec_length(parts) - 1)
        }
        let ok2: bool = try gcvec_append_raw(parts, math.math_bits(v))
    }
    if seen_nan {
        return val.realm_num(r, nan())
    }
    if pos_inf && neg_inf {
        return val.realm_num(r, nan())
    }
    if pos_inf {
        return val.realm_num(r, inf())
    }
    if neg_inf {
        return val.realm_num(r, negf(inf()))
    }
    var total: f64 = 0.0
    var k: u64 = gcvec_length(parts)
    while k > 0 {
        k = k - 1
        total = total + math.math_f64(gcvec_read_raw(parts, k))
    }
    if total == 0.0 && gcvec_length(parts) == 0 {
        return val.realm_num(r, negf(0.0))
    }
    return val.realm_num(r, total)
}

// ================================================================ Number
//
// `toExponential` and `toPrecision`. The digits do NOT come out of a
// second floating point scaling -- they come out of the SHORTEST
// representation that `interp.number_to_string` already produces
// correctly rounded, and are then rounded to the requested count as
// DECIMAL text. That way no power of ten multiplication can shift the last
// digit.

struct Dec {
    digits: [u8; 40],
    n: usize,
    exp: i64,
    neg: bool,
    special: bool,
}

fn dec_new() -> Dec {
    return Dec { digits: [0 as u8; 40], n: 0, exp: 0, neg: false,
        special: false }
}

// The shortest decimal representation of `x`, split into digits and the
// exponent of the FIRST of them.
fn dec_of(r: Gc[Realm], x: f64, d: *mut Dec) -> AllocError!bool {
    *d = dec_new()
    if math.is_nan(x) || math.is_infinite(x) {
        (*d).special = true
        return true
    }
    let s: Gc[JsVal] = try interp.number_to_string(r, math.fabs(x))
    (*d).neg = math.math_bits(x) & 0x8000000000000000 != 0
    let n: u64 = val.str_len(s)
    var i: u64 = 0
    var point: i64 = -1
    var esign: i64 = 1
    var eval10: i64 = 0
    var in_exp: bool = false
    var seen: usize = 0
    while i < n {
        let c: u32 = val.str_at(s, i)
        i = i + 1
        if c == 46 as u32 {
            point = seen as i64
            continue
        }
        if c == 101 as u32 {
            in_exp = true
            continue
        }
        if in_exp {
            if c == 45 as u32 {
                esign = -1
                continue
            }
            if c == 43 as u32 {
                continue
            }
            eval10 = eval10 * 10 + ((c - 48 as u32) as i64)
            continue
        }
        if seen < 40 {
            (*d).digits[seen] = (c - 48 as u32) as u8
            seen = seen + 1
        }
    }
    (*d).n = seen
    if point < 0 {
        point = seen as i64
    }
    // Strip the leading zeros of a value like 0.001 and move the exponent.
    var lead: usize = 0
    while lead + 1 < seen && (*d).digits[lead] == 0 as u8 {
        lead = lead + 1
    }
    if lead > 0 {
        var k: usize = 0
        while k + lead < seen {
            (*d).digits[k] = (*d).digits[k + lead]
            k = k + 1
        }
        (*d).n = seen - lead
    }
    (*d).exp = point - 1 - (lead as i64) + esign * eval10
    // Strip the trailing zeros.
    while (*d).n > 1 && (*d).digits[(*d).n - 1] == 0 as u8 {
        (*d).n = (*d).n - 1
    }
    if (*d).n == 1 && (*d).digits[0] == 0 as u8 {
        (*d).exp = 0
    }
    return true
}

// Round the decimal to `want` significant digits, in place.
fn dec_round(d: *mut Dec, want: usize) {
    if want >= (*d).n {
        var k: usize = (*d).n
        while k < want && k < 40 {
            (*d).digits[k] = 0 as u8
            k = k + 1
        }
        (*d).n = want
        return
    }
    var up: bool = false
    if (*d).digits[want] > 5 as u8 {
        up = true
    } else if (*d).digits[want] == 5 as u8 {
        up = true
    }
    (*d).n = want
    if up {
        var i: usize = want
        while i > 0 {
            i = i - 1
            if (*d).digits[i] == 9 as u8 {
                (*d).digits[i] = 0 as u8
            } else {
                (*d).digits[i] = (*d).digits[i] + 1 as u8
                return
            }
        }
        // Every digit rolled over: 999 -> 1000, one place further left.
        var k: usize = (*d).n
        while k > 0 {
            (*d).digits[k] = (*d).digits[k - 1]
            k = k - 1
        }
        (*d).digits[0] = 1 as u8
        (*d).exp = (*d).exp + 1
    }
}

fn push_dec_digit(out: Gc[JsStr], v: u8) -> AllocError!bool {
    return val.str_push(out, (48 + (v as u32)) as u32)
}

fn push_signed_int(out: Gc[JsStr], v: i64) -> AllocError!bool {
    var x: i64 = v
    if x < 0 {
        let ok: bool = try val.str_push(out, 45 as u32)
        x = 0 - x
    } else {
        let ok: bool = try val.str_push(out, 43 as u32)
    }
    var buf: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    if x == 0 {
        buf[0] = 0 as u8
        n = 1
    }
    while x > 0 {
        buf[n] = (x % 10) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        let ok: bool = try push_dec_digit(out, buf[n])
    }
    return true
}

fn number2_fn(r: Gc[Realm], id: u64, this: Gc[JsVal],
    args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    var x: f64 = 0.0
    if val.val_tag(this) == val.TAG_NUM {
        x = val.num_value(this)
    } else {
        let o: Gc[JsObj] = val.as_obj(this)
        if (o as u64) == 0 || val.val_tag(o.prim) != val.TAG_NUM {
            var m: [u8; 29] = "not a Number on this receiver"
            return type_err(r, &m[0], 29)
        }
        x = val.num_value(o.prim)
    }
    if id == N_NP_TOLOCALE {
        return interp.number_to_string(r, x)
    }
    let fv: Gc[JsVal] = arg(r, args, 0)
    // The argument is coerced BEFORE the value is looked at (21.1.3.2).
    var want: i64 = 0
    var have: bool = !val.is_undefined(fv)
    if have || id == N_NP_TOEXP {
        let t: f64 = math.math_f64(try interp.to_integer(r, fv))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        want = t as i64
        if val.is_undefined(fv) {
            want = 0
        }
    }
    if math.is_nan(x) || math.is_infinite(x) {
        return interp.number_to_string(r, x)
    }
    if id == N_NP_TOEXP {
        if have && (want < 0 || want > 100) {
            var m: [u8; 44] = "toExponential takes between 0 and 100 digits"
            return range_err(r, &m[0], 44)
        }
    } else {
        if !have {
            return interp.number_to_string(r, x)
        }
        if want < 1 || want > 100 {
            var m: [u8; 42] = "toPrecision takes between 1 and 100 digits"
            return range_err(r, &m[0], 42)
        }
    }
    var d: Dec = dec_new()
    let okd: bool = try dec_of(r, x, &d)
    let out: Gc[JsStr] = try val.str_new(r)
    if d.neg {
        let ok: bool = try val.str_push(out, 45 as u32)
    }
    if id == N_NP_TOEXP {
        var sig: usize = (want + 1) as usize
        if !have {
            sig = d.n
        }
        if x == 0.0 {
            d.exp = 0
        }
        dec_round(&d, sig)
        let ok1: bool = try push_dec_digit(out, d.digits[0])
        if sig > 1 {
            let ok2: bool = try val.str_push(out, 46 as u32)
            var i: usize = 1
            while i < sig {
                let ok3: bool = try push_dec_digit(out, d.digits[i])
                i = i + 1
            }
        }
        let ok4: bool = try val.str_push(out, 101 as u32)
        let ok5: bool = try push_signed_int(out, d.exp)
        let ov: Gc[JsVal] = out
        return ov
    }
    // toPrecision
    let sig: usize = want as usize
    if x == 0.0 {
        d.exp = 0
    }
    dec_round(&d, sig)
    if d.exp < -6 || d.exp >= (sig as i64) {
        let ok1: bool = try push_dec_digit(out, d.digits[0])
        if sig > 1 {
            let ok2: bool = try val.str_push(out, 46 as u32)
            var i: usize = 1
            while i < sig {
                let ok3: bool = try push_dec_digit(out, d.digits[i])
                i = i + 1
            }
        }
        let ok4: bool = try val.str_push(out, 101 as u32)
        let ok5: bool = try push_signed_int(out, d.exp)
        let ov: Gc[JsVal] = out
        return ov
    }
    if d.exp < 0 {
        let ok1: bool = try val.str_push(out, 48 as u32)
        let ok2: bool = try val.str_push(out, 46 as u32)
        var z: i64 = -1 - d.exp
        while z > 0 {
            let ok3: bool = try val.str_push(out, 48 as u32)
            z = z - 1
        }
        var i: usize = 0
        while i < sig {
            let ok4: bool = try push_dec_digit(out, d.digits[i])
            i = i + 1
        }
        let ov: Gc[JsVal] = out
        return ov
    }
    var i: usize = 0
    while i < sig {
        if (i as i64) == d.exp + 1 {
            let ok: bool = try val.str_push(out, 46 as u32)
        }
        let ok2: bool = try push_dec_digit(out, d.digits[i])
        i = i + 1
    }
    let ov: Gc[JsVal] = out
    return ov
}

// ================================================================ String

// The simple case mappings of the UCD, out of the generated table
// (generated/unicode_tables.fi, round 95). Until round 94 this reached as
// far as Latin-1 and nowhere further.
//
// WHAT IS STILL NOT THERE, and is not pretended to be: the FULL mappings of
// SpecialCasing.txt, where one code point becomes several
// ("stra\u00dfe".toUpperCase() is "STRASSE" in a complete engine and stays
// "STRA\u00dfE" here). UnicodeData leaves field 12 empty for exactly those
// characters, so the simple mapping does not invent a wrong single
// character -- it leaves them alone. `toLocaleUpperCase` is
// `toUpperCase`, which 19.1.3.22 allows without an `Intl`.
fn case_unit(t: u64, c: u32, upper: bool) -> u32 {
    if upper {
        return ucd.ucd_to_upper(t, c)
    }
    return ucd.ucd_to_lower(t, c)
}

fn case_convert(r: Gc[Realm], s: Gc[JsVal], upper: bool) -> AllocError!Gc[JsVal] {
    let out: Gc[JsStr] = try val.str_new(r)
    let n: u64 = val.str_len(s)
    var i: u64 = 0
    while i < n {
        // Round 95: a code POINT, not a code unit -- a surrogate pair
        // is put together, mapped and written out again. Without that
        // the Deseret block (U+10400) came out unchanged.
        var c: u32 = val.str_at(s, i)
        var step: u64 = 1
        if c >= 0xD800 as u32 && c <= 0xDBFF as u32 && i + 1 < n {
            let lo: u32 = val.str_at(s, i + 1)
            if lo >= 0xDC00 as u32 && lo <= 0xDFFF as u32 {
                let top: u32 = (c - 0xD800 as u32) * 1024 as u32
                c = 0x10000 as u32 + top + (lo - 0xDC00 as u32)
                step = 2
            }
        }
        var m: u32 = c
        if upper {
            m = ucd.ucd_to_upper(r.ucdtab, c)
        } else {
            m = ucd.ucd_to_lower(r.ucdtab, c)
        }
        if m >= 0x10000 as u32 {
            let hi: u32 = 0xD800 as u32 + (m - 0x10000 as u32) / 1024 as u32
            let lo2: u32 = 0xDC00 as u32 + (m - 0x10000 as u32) % 1024 as u32
            let o1: bool = try val.str_push(out, hi)
            let o2: bool = try val.str_push(out, lo2)
        } else {
            let ok: bool = try val.str_push(out, m)
        }
        i = i + step
    }
    let ov: Gc[JsVal] = out
    return ov
}

// ECMA-262 TrimString: WhiteSpace (TAB, VT, FF, ZWNBSP and the general
// category Zs) plus LineTerminator (LF, CR, Zl = U+2028, Zp = U+2029).
// Since round 95 the Unicode part comes out of the generated table instead
// of a hand written list -- the list was right, but it was a copy.
fn is_space_unit2(t: u64, c: u32) -> bool {
    if c == 32 as u32 || c == 9 as u32 || c == 10 as u32 || c == 13 as u32 {
        return true
    }
    if c == 11 as u32 || c == 12 as u32 || c == 0xFEFF as u32 {
        return true
    }
    if c < 0x80 as u32 {
        return false
    }
    let k: u8 = ucd.ucd_category(t, c)
    return k == ucd.CAT_ZS || k == ucd.CAT_ZL || k == ucd.CAT_ZP
}

fn string2_fn(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if id == N_STR_FROMCODEPOINT {
        let out: Gc[JsStr] = try val.str_new(r)
        var i: u64 = 0
        while i < nargs(args) {
            let x: f64 = math.math_f64(try num_arg(r, args, i))
            if thrown(r) {
                return val.realm_undefined(r)
            }
            if x != math.floor(x) || x < 0.0 || x > 1114111.0 || math.is_nan(x) {
                var m: [u8; 36] = "not a valid Unicode code point value"
                return range_err(r, &m[0], 36)
            }
            let cp: u32 = x as u32
            if cp <= 0xFFFF as u32 {
                let ok: bool = try val.str_push(out, cp)
            } else {
                let v: u32 = cp - 0x10000 as u32
                let o1: bool = try val.str_push(out, 0xD800 as u32 + (v >> 10))
                let o2: bool = try val.str_push(out,
                    0xDC00 as u32 + (v & 0x3FF as u32))
            }
            i = i + 1
        }
        let ov: Gc[JsVal] = out
        return ov
    }
    if id == N_STR_RAW {
        let site: Gc[JsVal] = arg(r, args, 0)
        var rk: [u8; 3] = "raw"
        let rkk: u64 = try key_ascii(r, &rk[0], 3)
        let raws: Gc[JsVal] = try interp.get_prop(r, site, rkk)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let n: u64 = try alen(r, raws)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let out: Gc[JsStr] = try val.str_new(r)
        var i: u64 = 0
        while i < n {
            let piece: Gc[JsVal] = try aget(r, raws, i)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let ps: Gc[JsVal] = try interp.to_string(r, piece)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            var k: u64 = 0
            while k < val.str_len(ps) {
                let ok: bool = try val.str_push(out, val.str_at(ps, k))
                k = k + 1
            }
            i = i + 1
            if i < n && i < nargs(args) {
                let sub: Gc[JsVal] = try interp.to_string(r, arg(r, args, i))
                if thrown(r) {
                    return val.realm_undefined(r)
                }
                var j: u64 = 0
                while j < val.str_len(sub) {
                    let ok2: bool = try val.str_push(out, val.str_at(sub, j))
                    j = j + 1
                }
            }
        }
        let ov: Gc[JsVal] = out
        return ov
    }
    if val.is_nullish(this) {
        var m: [u8; 44] = "String.prototype method on undefined or null"
        return type_err(r, &m[0], 44)
    }
    let s: Gc[JsVal] = try interp.to_string(r, this)
    if thrown(r) {
        return val.realm_undefined(r)
    }
    let n: u64 = val.str_len(s)
    if id == N_SP_ITERATOR {
        return iter_new(r, s, ITK_STRING, val.PROTO_STRING_ITERATOR)
    }
    if id == N_SP_TRIMSTART || id == N_SP_TRIMEND {
        var a: u64 = 0
        var b: u64 = n
        if id == N_SP_TRIMSTART {
            while a < b && is_space_unit2(r.ucdtab, val.str_at(s, a)) {
                a = a + 1
            }
        } else {
            while b > a && is_space_unit2(r.ucdtab, val.str_at(s, b - 1)) {
                b = b - 1
            }
        }
        return val.str_slice(r, s, a, b)
    }
    if id == N_SP_TOLOCALEUPPER {
        return case_convert(r, s, true)
    }
    if id == N_SP_TOLOCALELOWER {
        return case_convert(r, s, false)
    }
    if id == N_SP_LOCALECOMPARE {
        let o: Gc[JsVal] = try interp.to_string(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        return val.realm_num(r, val.str_compare(s, o) as f64)
    }
    if id == N_SP_NORMALIZE {
        // The FORM is checked; the mapping itself is not carried. See
        // docs/ROUND74.md -- the full tables of UnicodeData are a round of
        // their own, and a text that is already normalized (everything the
        // suite hands in outside the normalize directory) comes back
        // unchanged, which is correct.
        let fv: Gc[JsVal] = arg(r, args, 0)
        if !val.is_undefined(fv) {
            let f: Gc[JsVal] = try interp.to_string(r, fv)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            var ok: bool = false
            var f1: [u8; 3] = "NFC"
            var f2: [u8; 3] = "NFD"
            var f3: [u8; 4] = "NFKC"
            var f4: [u8; 4] = "NFKD"
            let s1: Gc[JsVal] = try val.str_from_ascii(r, &f1[0], 3)
            let s2: Gc[JsVal] = try val.str_from_ascii(r, &f2[0], 3)
            let s3: Gc[JsVal] = try val.str_from_ascii(r, &f3[0], 4)
            let s4: Gc[JsVal] = try val.str_from_ascii(r, &f4[0], 4)
            if val.str_equal(f, s1) || val.str_equal(f, s2) {
                ok = true
            }
            if val.str_equal(f, s3) || val.str_equal(f, s4) {
                ok = true
            }
            if !ok {
                var m: [u8; 39] = "the form must be NFC, NFD, NFKC or NFKD"
                return range_err(r, &m[0], 39)
            }
        }
        return s
    }
    if id == N_SP_ISWELLFORMED || id == N_SP_TOWELLFORMED {
        var good: bool = true
        let out: Gc[JsStr] = try val.str_new(r)
        var i: u64 = 0
        while i < n {
            let c: u32 = val.str_at(s, i)
            var w: u32 = c
            if c >= 0xD800 as u32 && c <= 0xDBFF as u32 {
                if i + 1 < n {
                    let c2: u32 = val.str_at(s, i + 1)
                    if c2 >= 0xDC00 as u32 && c2 <= 0xDFFF as u32 {
                        let o1: bool = try val.str_push(out, c)
                        let o2: bool = try val.str_push(out, c2)
                        i = i + 2
                        continue
                    }
                }
                good = false
                w = 0xFFFD as u32
            } else if c >= 0xDC00 as u32 && c <= 0xDFFF as u32 {
                good = false
                w = 0xFFFD as u32
            }
            let ok: bool = try val.str_push(out, w)
            i = i + 1
        }
        if id == N_SP_ISWELLFORMED {
            return val.realm_bool(r, good)
        }
        if good {
            return s
        }
        let ov: Gc[JsVal] = out
        return ov
    }
    // Annex B.2.2: the thirteen text methods.
    if id >= N_SP_HTML && id < N_SP_HTML + 13 {
        return html_wrap(r, id - N_SP_HTML, s, args)
    }
    return val.realm_undefined(r)
}

// `"x".anchor("y")` is `<a name="y">x</a>`. The quotation mark inside the
// attribute becomes `&quot;` (B.2.2.2.1), nothing else is escaped.
fn html_wrap(r: Gc[Realm], k: u64, s: Gc[JsVal],
    args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    var tags: [u8; 169] = "a      name  big          blink        b            tt           font   color font   size  i            a      href  small        strike       sub          sup          "
    let toff: usize = (k as usize) * 13
    var tn: usize = 0
    while tn < 7 && tags[toff + tn] != 32 as u8 {
        tn = tn + 1
    }
    var an: usize = 0
    while an < 6 && tags[toff + 7 + an] != 32 as u8 {
        an = an + 1
    }
    let out: Gc[JsStr] = try val.str_new(r)
    let o1: bool = try val.str_push(out, 60 as u32)
    var i: usize = 0
    while i < tn {
        let ok: bool = try val.str_push(out, tags[toff + i] as u32)
        i = i + 1
    }
    if an > 0 {
        let ok: bool = try val.str_push(out, 32 as u32)
        i = 0
        while i < an {
            let o2: bool = try val.str_push(out, tags[toff + 7 + i] as u32)
            i = i + 1
        }
        let o3: bool = try val.str_push(out, 61 as u32)
        let o4: bool = try val.str_push(out, 34 as u32)
        let v: Gc[JsVal] = try interp.to_string(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        var j: u64 = 0
        while j < val.str_len(v) {
            let c: u32 = val.str_at(v, j)
            if c == 34 as u32 {
                var q: [u8; 6] = "&quot;"
                var w: usize = 0
                while w < 6 {
                    let o5: bool = try val.str_push(out, q[w] as u32)
                    w = w + 1
                }
            } else {
                let o6: bool = try val.str_push(out, c)
            }
            j = j + 1
        }
        let o7: bool = try val.str_push(out, 34 as u32)
    }
    let o8: bool = try val.str_push(out, 62 as u32)
    var j: u64 = 0
    while j < val.str_len(s) {
        let ok: bool = try val.str_push(out, val.str_at(s, j))
        j = j + 1
    }
    let o9: bool = try val.str_push(out, 60 as u32)
    let o10: bool = try val.str_push(out, 47 as u32)
    i = 0
    while i < tn {
        let ok: bool = try val.str_push(out, tags[toff + i] as u32)
        i = i + 1
    }
    let o11: bool = try val.str_push(out, 62 as u32)
    let ov: Gc[JsVal] = out
    return ov
}

// ================================================================= Array

fn sort_cmp(r: Gc[Realm], a: Gc[JsVal], b: Gc[JsVal],
    f: Gc[JsVal]) -> AllocError!i64 {
    if val.is_undefined(a) && val.is_undefined(b) {
        return 0
    }
    if val.is_undefined(a) {
        return 1
    }
    if val.is_undefined(b) {
        return -1
    }
    if val.is_callable(f) {
        let ca: Gc[GcVec] = try interp.args_new(r)
        let o1: bool = try gcvec_append[JsVal](ca, a)
        let o2: bool = try gcvec_append[JsVal](ca, b)
        let res: Gc[JsVal] = try interp.call_function(r, f,
            val.realm_undefined(r), ca)
        if thrown(r) {
            return 0
        }
        let x: f64 = math.math_f64(try interp.to_number(r, res))
        if math.is_nan(x) || x == 0.0 {
            return 0
        }
        if x < 0.0 {
            return -1
        }
        return 1
    }
    let sa: Gc[JsVal] = try interp.to_string(r, a)
    let sb: Gc[JsVal] = try interp.to_string(r, b)
    if thrown(r) {
        return 0
    }
    return val.str_compare(sa, sb) as i64
}

// An insertion sort: stable, and it calls the comparison function exactly
// where the specification allows it to.
fn sort_vec(r: Gc[Realm], v: Gc[GcVec], f: Gc[JsVal]) -> AllocError!bool {
    var i: u64 = 1
    while i < gcvec_length(v) {
        let cur: Gc[JsVal] = gcvec_read[JsVal](v, i)
        var j: u64 = i
        while j > 0 {
            let prev: Gc[JsVal] = gcvec_read[JsVal](v, j - 1)
            let c: i64 = try sort_cmp(r, prev, cur, f)
            if thrown(r) {
                return false
            }
            if c <= 0 {
                break
            }
            let ok: bool = gcvec_set[JsVal](v, j, prev)
            j = j - 1
        }
        let ok2: bool = gcvec_set[JsVal](v, j, cur)
        i = i + 1
    }
    return true
}

fn flatten(r: Gc[Realm], out: Gc[GcVec], src: Gc[JsVal], depth: f64,
    f: Gc[JsVal], this_arg: Gc[JsVal]) -> AllocError!bool {
    let n: u64 = try alen(r, src)
    if thrown(r) {
        return false
    }
    var i: u64 = 0
    while i < n {
        let has: bool = try ahas(r, src, i)
        if thrown(r) {
            return false
        }
        if has {
            var e: Gc[JsVal] = try aget(r, src, i)
            if thrown(r) {
                return false
            }
            if val.is_callable(f) {
                let ca: Gc[GcVec] = try interp.args_new(r)
                let o1: bool = try gcvec_append[JsVal](ca, e)
                let iv: Gc[JsVal] = try val.realm_num(r, i as f64)
                let o2: bool = try gcvec_append[JsVal](ca, iv)
                let o3: bool = try gcvec_append[JsVal](ca, src)
                e = try interp.call_function(r, f, this_arg, ca)
                if thrown(r) {
                    return false
                }
            }
            if depth > 0.0 && interp.is_array(e) {
                let ok: bool = try flatten(r, out, e, depth - 1.0,
                    val.realm_undefined(r), val.realm_undefined(r))
                if thrown(r) {
                    return false
                }
            } else {
                let ok2: bool = try gcvec_append[JsVal](out, e)
            }
        }
        i = i + 1
    }
    return true
}

fn array2_fn(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if val.is_nullish(this) {
        var m: [u8; 43] = "Array.prototype method on undefined or null"
        return type_err(r, &m[0], 43)
    }
    let o: Gc[JsObj] = try interp.to_object(r, this)
    if thrown(r) {
        return val.realm_undefined(r)
    }
    let ov: Gc[JsVal] = o
    if id == N_AP_KEYS {
        return iter_new(r, ov, ITK_ARRAY_KEYS, val.PROTO_ARRAY_ITERATOR)
    }
    if id == N_AP_VALUES {
        return iter_new(r, ov, ITK_ARRAY_VALUES, val.PROTO_ARRAY_ITERATOR)
    }
    if id == N_AP_ENTRIES {
        return iter_new(r, ov, ITK_ARRAY_ENTRIES, val.PROTO_ARRAY_ITERATOR)
    }
    let n: u64 = try alen(r, ov)
    if thrown(r) {
        return val.realm_undefined(r)
    }
    if id == N_AP_AT {
        var x: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 0)))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        if x < 0.0 {
            x = (n as f64) + x
        }
        if x < 0.0 || x >= (n as f64) {
            return val.realm_undefined(r)
        }
        return aget(r, ov, x as u64)
    }
    if id == N_AP_TOLOCALE {
        let out: Gc[JsStr] = try val.str_new(r)
        var i: u64 = 0
        while i < n {
            if i > 0 {
                let ok: bool = try val.str_push(out, 44 as u32)
            }
            let e: Gc[JsVal] = try aget(r, ov, i)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            if !val.is_nullish(e) {
                let ca: Gc[GcVec] = try interp.args_new(r)
                var tl: [u8; 14] = "toLocaleString"
                let tlk: u64 = try key_ascii(r, &tl[0], 14)
                let tf: Gc[JsVal] = try interp.get_prop(r, e, tlk)
                if thrown(r) {
                    return val.realm_undefined(r)
                }
                if !val.is_callable(tf) {
                    var m: [u8; 32] = "toLocaleString is not a function"
                    return type_err(r, &m[0], 32)
                }
                let piece: Gc[JsVal] = try interp.call_function(r, tf, e, ca)
                if thrown(r) {
                    return val.realm_undefined(r)
                }
                let ps: Gc[JsVal] = try interp.to_string(r, piece)
                if thrown(r) {
                    return val.realm_undefined(r)
                }
                var k: u64 = 0
                while k < val.str_len(ps) {
                    let ok2: bool = try val.str_push(out, val.str_at(ps, k))
                    k = k + 1
                }
            }
            i = i + 1
        }
        let sv: Gc[JsVal] = out
        return sv
    }
    if id == N_AP_FLAT || id == N_AP_FLATMAP {
        var depth: f64 = 1.0
        var f: Gc[JsVal] = val.realm_undefined(r)
        var this_arg: Gc[JsVal] = val.realm_undefined(r)
        if id == N_AP_FLATMAP {
            f = arg(r, args, 0)
            this_arg = arg(r, args, 1)
            if !val.is_callable(f) {
                var m: [u8; 30] = "the callback is not a function"
                return type_err(r, &m[0], 30)
            }
        } else if !val.is_undefined(arg(r, args, 0)) {
            let x: f64 = math.math_f64(try interp.to_integer(r,
                    arg(r, args, 0)))
            if thrown(r) {
                return val.realm_undefined(r)
            }
            depth = x
        }
        let out: Gc[GcVec] = try interp.args_new(r)
        let ok: bool = try flatten(r, out, ov, depth, f, this_arg)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        return new_array_from(r, out)
    }
    if id == N_AP_FINDLAST || id == N_AP_FINDLASTINDEX {
        let f: Gc[JsVal] = arg(r, args, 0)
        if !val.is_callable(f) {
            var m: [u8; 30] = "the callback is not a function"
            return type_err(r, &m[0], 30)
        }
        var i: u64 = n
        while i > 0 {
            i = i - 1
            let e: Gc[JsVal] = try aget(r, ov, i)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let ca: Gc[GcVec] = try interp.args_new(r)
            let o1: bool = try gcvec_append[JsVal](ca, e)
            let iv: Gc[JsVal] = try val.realm_num(r, i as f64)
            let o2: bool = try gcvec_append[JsVal](ca, iv)
            let o3: bool = try gcvec_append[JsVal](ca, ov)
            let res: Gc[JsVal] = try interp.call_function(r, f,
                arg(r, args, 1), ca)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            if interp.to_boolean(r, res) {
                if id == N_AP_FINDLAST {
                    return e
                }
                return val.realm_num(r, i as f64)
            }
        }
        if id == N_AP_FINDLAST {
            return val.realm_undefined(r)
        }
        return val.realm_num(r, negf(1.0))
    }
    if id == N_AP_COPYWITHIN {
        let target: u64 = try rel_index(r, arg(r, args, 0), n, 0)
        let start: u64 = try rel_index(r, arg(r, args, 1), n, 0)
        let end: u64 = try rel_index(r, arg(r, args, 2), n, n)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        var count: u64 = 0
        if end > start && n > target {
            count = end - start
            if count > n - target {
                count = n - target
            }
        }
        // The copy has to see the ORIGINAL values, so it is buffered.
        let buf: Gc[GcVec] = try interp.args_new(r)
        var i: u64 = 0
        while i < count {
            let e: Gc[JsVal] = try aget(r, ov, start + i)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let ok: bool = try gcvec_append[JsVal](buf, e)
            i = i + 1
        }
        i = 0
        while i < count {
            let has: bool = try ahas(r, ov, start + i)
            if has {
                let ok: bool = try aset(r, ov, target + i,
                    gcvec_read[JsVal](buf, i))
            } else {
                let k: u64 = try val.key_for_index(r, target + i)
                let ok2: bool = try interp.delete_prop(r, ov, k, false)
            }
            if thrown(r) {
                return val.realm_undefined(r)
            }
            i = i + 1
        }
        return ov
    }
    // The four methods that do not change the receiver (ES2023).
    let out: Gc[GcVec] = try interp.args_new(r)
    if id == N_AP_TOREVERSED {
        var i: u64 = n
        while i > 0 {
            i = i - 1
            let e: Gc[JsVal] = try aget(r, ov, i)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let ok: bool = try gcvec_append[JsVal](out, e)
        }
        return new_array_from(r, out)
    }
    if id == N_AP_TOSORTED {
        let f: Gc[JsVal] = arg(r, args, 0)
        if !val.is_undefined(f) && !val.is_callable(f) {
            var m: [u8; 32] = "the comparison is not a function"
            return type_err(r, &m[0], 32)
        }
        var i: u64 = 0
        while i < n {
            let e: Gc[JsVal] = try aget(r, ov, i)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let ok: bool = try gcvec_append[JsVal](out, e)
            i = i + 1
        }
        let oks: bool = try sort_vec(r, out, f)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        return new_array_from(r, out)
    }
    if id == N_AP_WITH {
        var x: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 0)))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        if x < 0.0 {
            x = (n as f64) + x
        }
        if x < 0.0 || x >= (n as f64) {
            var m: [u8; 29] = "the index is out of the range"
            return range_err(r, &m[0], 29)
        }
        let at: u64 = x as u64
        var i: u64 = 0
        while i < n {
            if i == at {
                let ok: bool = try gcvec_append[JsVal](out, arg(r, args, 1))
            } else {
                let e: Gc[JsVal] = try aget(r, ov, i)
                if thrown(r) {
                    return val.realm_undefined(r)
                }
                let ok2: bool = try gcvec_append[JsVal](out, e)
            }
            i = i + 1
        }
        return new_array_from(r, out)
    }
    if id == N_AP_TOSPLICED {
        let start: u64 = try rel_index(r, arg(r, args, 0), n, 0)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        var del: u64 = 0
        if nargs(args) >= 2 {
            let x: f64 = math.math_f64(try interp.to_integer(r,
                    arg(r, args, 1)))
            if thrown(r) {
                return val.realm_undefined(r)
            }
            if x > 0.0 {
                del = x as u64
            }
            if del > n - start {
                del = n - start
            }
        } else if nargs(args) == 1 {
            del = n - start
        }
        var i: u64 = 0
        while i < start {
            let e: Gc[JsVal] = try aget(r, ov, i)
            let ok: bool = try gcvec_append[JsVal](out, e)
            i = i + 1
        }
        var k: u64 = 2
        while k < nargs(args) {
            let ok2: bool = try gcvec_append[JsVal](out, arg(r, args, k))
            k = k + 1
        }
        i = start + del
        while i < n {
            let e: Gc[JsVal] = try aget(r, ov, i)
            let ok3: bool = try gcvec_append[JsVal](out, e)
            i = i + 1
        }
        if thrown(r) {
            return val.realm_undefined(r)
        }
        return new_array_from(r, out)
    }
    return val.realm_undefined(r)
}

// ==================================================== Map, Set, the weak pair
//
// The storage is the one round 63 chose: the entries lie densely in
// `elems`, key and value alternating for a Map, one slot per element for a
// Set. A WeakMap and a WeakSet use exactly the same storage and hold their
// keys STRONGLY. That is not a shortcut around the collector but a
// permitted implementation: the specification only forbids the liveness of
// a key from becoming OBSERVABLE, and one that is never released cannot be
// observed. It is written down in docs/ROUND74.md so that nobody takes it
// for a real weak reference.

fn coll2_find(r: Gc[Realm], o: Gc[JsObj], key: Gc[JsVal], step: u64) -> i64 {
    var i: u64 = 0
    while i < val.elems_len(o) {
        if interp.same_value_zero(r, val.elems_get(r, o, i), key) {
            return i as i64
        }
        i = i + step
    }
    return -1
}

fn coll2_add(r: Gc[Realm], o: Gc[JsObj], key: Gc[JsVal], v: Gc[JsVal],
    paired: bool) -> AllocError!bool {
    var step: u64 = 1
    if paired {
        step = 2
    }
    let at: i64 = coll2_find(r, o, key, step)
    if at >= 0 {
        if paired {
            let ok: bool = try val.elems_set(r, o, (at as u64) + 1, v)
        }
        return true
    }
    var k: Gc[JsVal] = key
    if val.val_tag(k) == val.TAG_NUM && math.math_bits(val.num_value(k)) == 0x8000000000000000 {
        k = try val.realm_num(r, 0.0)
    }
    let ok1: bool = try val.elems_push(r, o, k)
    if paired {
        let ok2: bool = try val.elems_push(r, o, v)
    }
    return true
}

fn coll2_remove(r: Gc[Realm], o: Gc[JsObj], at: u64, step: u64) -> bool {
    var i: u64 = at
    while i + step < val.elems_len(o) {
        let ok: bool = gcvec_set[JsVal](o.elems, i,
            val.elems_get(r, o, i + step))
        i = i + 1
    }
    var k: u64 = 0
    while k < step {
        let ok: bool = gcvec_remove(o.elems, val.elems_len(o) - 1)
        k = k + 1
    }
    return true
}

// A Set the way the set operations of ES2025 want to see the ARGUMENT: an
// object with `size`, `has` and `keys`, not necessarily a real Set.
fn set_like(r: Gc[Realm], v: Gc[JsVal], out: Gc[GcVec]) -> AllocError!bool {
    if val.val_tag(v) != val.TAG_OBJ {
        var m: [u8; 34] = "the argument is not a set like one"
        let x: Gc[JsVal] = try type_err(r, &m[0], 34)
        return false
    }
    let o: Gc[JsObj] = val.as_obj(v)
    let szk: u64 = try val.key_for_name(r, lex.N_SIZE)
    let sz: Gc[JsVal] = try interp.get_prop(r, v, szk)
    if thrown(r) {
        return false
    }
    if val.is_undefined(sz) || val.is_null(sz) {
        var m: [u8; 34] = "the argument is not a set like one"
        let x: Gc[JsVal] = try type_err(r, &m[0], 34)
        return false
    }
    let szn: f64 = math.math_f64(try interp.to_number(r, sz))
    if thrown(r) {
        return false
    }
    if math.is_nan(szn) {
        var m: [u8; 34] = "the argument is not a set like one"
        let x: Gc[JsVal] = try type_err(r, &m[0], 34)
        return false
    }
    if szn < 0.0 {
        var m: [u8; 30] = "a negative size is not allowed"
        let x: Gc[JsVal] = try range_err(r, &m[0], 30)
        return false
    }
    var hk: [u8; 3] = "has"
    var kk: [u8; 4] = "keys"
    let hkk: u64 = try key_ascii(r, &hk[0], 3)
    let kkk: u64 = try key_ascii(r, &kk[0], 4)
    let hf: Gc[JsVal] = try interp.get_prop(r, v, hkk)
    let kf: Gc[JsVal] = try interp.get_prop(r, v, kkk)
    if thrown(r) {
        return false
    }
    if !val.is_callable(hf) || !val.is_callable(kf) {
        var m: [u8; 34] = "the argument is not a set like one"
        let x: Gc[JsVal] = try type_err(r, &m[0], 34)
        return false
    }
    let a0: Gc[GcVec] = try interp.args_new(r)
    let it: Gc[JsVal] = try interp.call_function(r, kf, v, a0)
    if thrown(r) {
        return false
    }
    let items: Gc[GcVec] = try iterate_iterator(r, it)
    if thrown(r) {
        return false
    }
    var i: u64 = 0
    while i < gcvec_length(items) {
        let ok: bool = try gcvec_append[JsVal](out, gcvec_read[JsVal](items, i))
        i = i + 1
    }
    return true
}

// Drain an ITERATOR (not an iterable): the value already is the object with
// `next`.
fn iterate_iterator(r: Gc[Realm], it: Gc[JsVal]) -> AllocError!Gc[GcVec] {
    let out: Gc[GcVec] = try interp.args_new(r)
    let nk: u64 = try val.key_for_name(r, lex.N_NEXT)
    let dk: u64 = try val.key_for_name(r, lex.N_DONE)
    let vk: u64 = try val.key_for_name(r, lex.N_VALUE)
    var guard: u64 = 0
    while guard < 10000000 {
        let nf: Gc[JsVal] = try interp.get_prop(r, it, nk)
        if thrown(r) {
            return out
        }
        if !val.is_callable(nf) {
            var m: [u8; 30] = "iterator.next is not a functio"
            let x: Gc[JsVal] = try type_err(r, &m[0], 30)
            return out
        }
        let a1: Gc[GcVec] = try interp.args_new(r)
        let res: Gc[JsVal] = try interp.call_function(r, nf, it, a1)
        if thrown(r) {
            return out
        }
        if val.val_tag(res) != val.TAG_OBJ {
            var m: [u8; 32] = "the iterator result is no object"
            let x: Gc[JsVal] = try type_err(r, &m[0], 32)
            return out
        }
        let d: Gc[JsVal] = try interp.get_prop(r, res, dk)
        if thrown(r) {
            return out
        }
        if interp.to_boolean(r, d) {
            return out
        }
        let e: Gc[JsVal] = try interp.get_prop(r, res, vk)
        if thrown(r) {
            return out
        }
        let ok: bool = try gcvec_append[JsVal](out, e)
        guard = guard + 1
    }
    return out
}

fn set_has(r: Gc[Realm], v: Gc[JsVal], want: Gc[JsVal]) -> AllocError!bool {
    var hk: [u8; 3] = "has"
    let hkk: u64 = try key_ascii(r, &hk[0], 3)
    let hf: Gc[JsVal] = try interp.get_prop(r, v, hkk)
    if thrown(r) {
        return false
    }
    let ca: Gc[GcVec] = try interp.args_new(r)
    let ok: bool = try gcvec_append[JsVal](ca, want)
    let res: Gc[JsVal] = try interp.call_function(r, hf, v, ca)
    if thrown(r) {
        return false
    }
    return interp.to_boolean(r, res)
}

fn collection2_fn(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if id == N_WEAK_CTOR || id == N_WEAKSET_CTOR || id == N_WEAKREF_CTOR || id == N_FINREG_CTOR {
        if (nt as u64) == 0 {
            var m: [u8; 27] = "the constructor needs 'new'"
            return type_err(r, &m[0], 27)
        }
        var which: u64 = val.PROTO_WEAKMAP
        var cls: u64 = val.CLS_WEAKMAP
        if id == N_WEAKSET_CTOR {
            which = val.PROTO_WEAKSET
            cls = val.CLS_WEAKSET
        }
        if id == N_WEAKREF_CTOR {
            which = val.PROTO_WEAKREF
            cls = val.CLS_WEAKREF
        }
        if id == N_FINREG_CTOR {
            which = val.PROTO_FINREG
            cls = val.CLS_FINREG
        }
        let o: Gc[JsObj] = try val.obj_new_proto(r, val.realm_proto(r, which))
        o.cls = cls
        o.elems = try gcvec_new()
        o.len = 0
        let ov: Gc[JsVal] = o
        if id == N_WEAKREF_CTOR {
            let t: Gc[JsVal] = arg(r, args, 0)
            if !can_be_weak(t) {
                var m: [u8; 34] = "a WeakRef target must be an object"
                return type_err(r, &m[0], 34)
            }
            o.prim = t
            return ov
        }
        if id == N_FINREG_CTOR {
            if !val.is_callable(arg(r, args, 0)) {
                var m: [u8; 37] = "the cleanup callback must be callable"
                return type_err(r, &m[0], 37)
            }
            o.prim = arg(r, args, 0)
            return ov
        }
        let init: Gc[JsVal] = arg(r, args, 0)
        if !val.is_nullish(init) {
            let items: Gc[GcVec] = try interp.iterate_values(r, init)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            var i: u64 = 0
            while i < gcvec_length(items) {
                let e: Gc[JsVal] = gcvec_read[JsVal](items, i)
                if id == N_WEAKSET_CTOR {
                    if !can_be_weak(e) {
                        var m: [u8; 40] = "a WeakSet takes objects and symbols only"
                        return type_err(r, &m[0], 40)
                    }
                    let ok: bool = try coll2_add(r, o, e, e, false)
                } else {
                    let k: Gc[JsVal] = try aget(r, e, 0)
                    let v: Gc[JsVal] = try aget(r, e, 1)
                    if thrown(r) {
                        return val.realm_undefined(r)
                    }
                    if !can_be_weak(k) {
                        var m: [u8; 40] = "a WeakMap takes objects and symbols only"
                        return type_err(r, &m[0], 40)
                    }
                    let ok: bool = try coll2_add(r, o, k, v, true)
                }
                i = i + 1
            }
        }
        return ov
    }
    if id == N_AGGREGATE_CTOR {
        return aggregate_error(r, this, args, nt)
    }
    let o: Gc[JsObj] = val.as_obj(this)
    if (o as u64) == 0 {
        var m: [u8; 32] = "the receiver is not a collection"
        return type_err(r, &m[0], 32)
    }
    if id == N_WEAKREF_DEREF {
        if o.cls != val.CLS_WEAKREF {
            var m: [u8; 26] = "the receiver is no WeakRef"
            return type_err(r, &m[0], 26)
        }
        if (o.prim as u64) == 0 {
            return val.realm_undefined(r)
        }
        return o.prim
    }
    if id == N_FINREG_REGISTER || id == N_FINREG_UNREGISTER || id == N_FINREG_CLEANUP {
        if o.cls != val.CLS_FINREG {
            var m: [u8; 36] = "the receiver is no FinalizationRegis"
            return type_err(r, &m[0], 36)
        }
        if id == N_FINREG_REGISTER {
            if !can_be_weak(arg(r, args, 0)) {
                var m: [u8; 28] = "the target must be an object"
                return type_err(r, &m[0], 28)
            }
            if interp.same_value(r, arg(r, args, 0), arg(r, args, 1)) {
                var m: [u8; 33] = "target and held value must differ"
                return type_err(r, &m[0], 33)
            }
            let tok: Gc[JsVal] = arg(r, args, 2)
            if !val.is_undefined(tok) && !can_be_weak(tok) {
                var m: [u8; 37] = "the token must be an object or absent"
                return type_err(r, &m[0], 37)
            }
        }
        if id == N_FINREG_UNREGISTER {
            if !can_be_weak(arg(r, args, 0)) {
                var m: [u8; 27] = "the token must be an object"
                return type_err(r, &m[0], 27)
            }
            return val.realm_bool(r, false)
        }
        return val.realm_undefined(r)
    }
    let weakmap: bool = o.cls == val.CLS_WEAKMAP
    let weakset: bool = o.cls == val.CLS_WEAKSET
    if id >= N_WEAK_GET && id <= N_WEAK_ADD {
        if !weakmap && !weakset {
            var m: [u8; 40] = "the receiver is no WeakMap and no WeakSe"
            return type_err(r, &m[0], 40)
        }
        var step: u64 = 1
        if weakmap {
            step = 2
        }
        let key: Gc[JsVal] = arg(r, args, 0)
        if id == N_WEAK_SET || id == N_WEAK_ADD {
            if !can_be_weak(key) {
                var m: [u8; 37] = "the key must be an object or a symbol"
                return type_err(r, &m[0], 37)
            }
            let ok: bool = try coll2_add(r, o, key, arg(r, args, 1), weakmap)
            return this
        }
        if !can_be_weak(key) {
            if id == N_WEAK_HAS || id == N_WEAK_DELETE {
                return val.realm_bool(r, false)
            }
            return val.realm_undefined(r)
        }
        let at: i64 = coll2_find(r, o, key, step)
        if id == N_WEAK_HAS {
            return val.realm_bool(r, at >= 0)
        }
        if id == N_WEAK_DELETE {
            if at < 0 {
                return val.realm_bool(r, false)
            }
            let ok: bool = coll2_remove(r, o, at as u64, step)
            return val.realm_bool(r, true)
        }
        if at < 0 {
            return val.realm_undefined(r)
        }
        return val.elems_get(r, o, (at as u64) + 1)
    }
    // The iterators of Map and Set.
    if id >= N_MP_KEYS && id <= N_SET_ENTRIES {
        if id <= N_MP_ENTRIES {
            if o.cls != val.CLS_MAP {
                var m: [u8; 25] = "the receiver is not a Map"
                return type_err(r, &m[0], 25)
            }
            return iter_new(r, this, ITK_MAP_KEYS + (id - N_MP_KEYS),
                val.PROTO_MAP_ITERATOR)
        }
        if o.cls != val.CLS_SET {
            var m: [u8; 25] = "the receiver is not a Set"
            return type_err(r, &m[0], 25)
        }
        return iter_new(r, this, ITK_SET_KEYS + (id - N_SET_KEYS),
            val.PROTO_SET_ITERATOR)
    }
    // The seven set operations of ES2025.
    if o.cls != val.CLS_SET {
        var m: [u8; 25] = "the receiver is not a Set"
        return type_err(r, &m[0], 25)
    }
    let other: Gc[GcVec] = try interp.args_new(r)
    let okl: bool = try set_like(r, arg(r, args, 0), other)
    if thrown(r) {
        return val.realm_undefined(r)
    }
    if id == N_SET_ISSUBSET || id == N_SET_ISSUPERSET || id == N_SET_ISDISJOINT {
        return set_predicate(r, id, o, arg(r, args, 0), other)
    }
    let res: Gc[JsObj] = try val.obj_new_proto(r,
        val.realm_proto(r, val.PROTO_SET))
    res.cls = val.CLS_SET
    res.elems = try gcvec_new()
    let rv: Gc[JsVal] = res
    var i: u64 = 0
    if id == N_SET_UNION || id == N_SET_DIFFERENCE || id == N_SET_SYMDIFF {
        while i < val.elems_len(o) {
            let e: Gc[JsVal] = val.elems_get(r, o, i)
            var keep: bool = true
            if id != N_SET_UNION {
                keep = !vec_has(r, other, e)
            }
            if keep {
                let ok: bool = try coll2_add(r, res, e, e, false)
            }
            i = i + 1
        }
    }
    if id == N_SET_INTERSECTION {
        while i < val.elems_len(o) {
            let e: Gc[JsVal] = val.elems_get(r, o, i)
            if vec_has(r, other, e) {
                let ok: bool = try coll2_add(r, res, e, e, false)
            }
            i = i + 1
        }
        return rv
    }
    if id == N_SET_UNION || id == N_SET_SYMDIFF {
        i = 0
        while i < gcvec_length(other) {
            let e: Gc[JsVal] = gcvec_read[JsVal](other, i)
            var keep: bool = true
            if id == N_SET_SYMDIFF {
                keep = coll2_find(r, o, e, 1) < 0
            }
            if keep {
                let ok: bool = try coll2_add(r, res, e, e, false)
            }
            i = i + 1
        }
    }
    return rv
}

fn set_predicate(r: Gc[Realm], id: u64, o: Gc[JsObj], otherv: Gc[JsVal],
    other: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    if id == N_SET_ISSUBSET {
        var i: u64 = 0
        while i < val.elems_len(o) {
            let has: bool = try set_has(r, otherv, val.elems_get(r, o, i))
            if thrown(r) {
                return val.realm_undefined(r)
            }
            if !has {
                return val.realm_bool(r, false)
            }
            i = i + 1
        }
        return val.realm_bool(r, true)
    }
    var i: u64 = 0
    while i < gcvec_length(other) {
        let e: Gc[JsVal] = gcvec_read[JsVal](other, i)
        let inside: bool = coll2_find(r, o, e, 1) >= 0
        if id == N_SET_ISSUPERSET && !inside {
            return val.realm_bool(r, false)
        }
        if id == N_SET_ISDISJOINT && inside {
            return val.realm_bool(r, false)
        }
        i = i + 1
    }
    return val.realm_bool(r, true)
}

fn vec_has(r: Gc[Realm], v: Gc[GcVec], want: Gc[JsVal]) -> bool {
    var i: u64 = 0
    while i < gcvec_length(v) {
        if interp.same_value_zero(r, gcvec_read[JsVal](v, i), want) {
            return true
        }
        i = i + 1
    }
    return false
}

fn can_be_weak(v: Gc[JsVal]) -> bool {
    return val.val_tag(v) == val.TAG_OBJ || val.val_tag(v) == val.TAG_SYM
}

// =============================================== Error.isError, AggregateError

fn aggregate_error(r: Gc[Realm], this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    var proto: Gc[JsObj] = val.realm_proto(r, val.PROTO_AGGREGATE_ERROR)
    if (nt as u64) != 0 {
        let pk: u64 = try val.key_for_name(r, lex.N_PROTOTYPE)
        let pv: Gc[JsVal] = try interp.get_prop(r, nt, pk)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        if val.val_tag(pv) == val.TAG_OBJ {
            proto = val.as_obj(pv)
        }
    }
    let o: Gc[JsObj] = try val.obj_new_proto(r, proto)
    o.cls = val.CLS_ERROR
    let ov: Gc[JsVal] = o
    if !val.is_undefined(arg(r, args, 1)) {
        let msg: Gc[JsVal] = try interp.to_string(r, arg(r, args, 1))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let mk: u64 = try val.key_for_name(r, lex.N_MESSAGE)
        let ok: bool = try interp.define_value(r, o, mk, msg,
            val.A_WRITABLE | val.A_CONFIGURABLE)
    }
    let okc: bool = try install_cause(r, o, arg(r, args, 2))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    let items: Gc[GcVec] = try interp.iterate_values(r, arg(r, args, 0))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    let list: Gc[JsVal] = try new_array_from(r, items)
    var en: [u8; 6] = "errors"
    let ok2: bool = try put(r, o, &en[0], 6, list,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    return ov
}

// The `cause` option of ES2022, for every Error constructor.
fn install_cause(r: Gc[Realm], o: Gc[JsObj], opts: Gc[JsVal]) -> AllocError!bool {
    if val.val_tag(opts) != val.TAG_OBJ {
        return true
    }
    var cn: [u8; 5] = "cause"
    let ck: u64 = try key_ascii(r, &cn[0], 5)
    let has: bool = try interp.has_prop(r, opts, ck)
    if thrown(r) || !has {
        return true
    }
    let cv: Gc[JsVal] = try interp.get_prop(r, opts, ck)
    if thrown(r) {
        return true
    }
    return interp.define_value(r, o, ck, cv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
}

// ============================================================== Reflect

fn reflect_fn(r: Gc[Realm], which: u64, args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    let t: Gc[JsVal] = arg(r, args, 0)
    if which == RF_APPLY || which == RF_CONSTRUCT {
        if !val.is_callable(t) {
            var m: [u8; 28] = "the target is not a function"
            return type_err(r, &m[0], 28)
        }
        var listv: Gc[JsVal] = arg(r, args, 1)
        if which == RF_APPLY {
            listv = arg(r, args, 2)
        }
        if val.val_tag(listv) != val.TAG_OBJ {
            var m: [u8; 35] = "the argument list must be an object"
            return type_err(r, &m[0], 35)
        }
        let n: u64 = try alen(r, listv)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let ca: Gc[GcVec] = try interp.args_new(r)
        var i: u64 = 0
        while i < n {
            let e: Gc[JsVal] = try aget(r, listv, i)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let ok: bool = try gcvec_append[JsVal](ca, e)
            i = i + 1
        }
        if which == RF_APPLY {
            return interp.call_function(r, t, arg(r, args, 1), ca)
        }
        var nt: Gc[JsObj] = val.as_obj(t)
        if nargs(args) >= 3 {
            if !val.is_callable(arg(r, args, 2)) {
                var m: [u8; 31] = "newTarget must be a constructor"
                return type_err(r, &m[0], 31)
            }
            nt = val.as_obj(arg(r, args, 2))
        }
        return interp.construct_nt(r, t, ca, nt)
    }
    if val.val_tag(t) != val.TAG_OBJ {
        var m: [u8; 33] = "Reflect needs an object as target"
        return type_err(r, &m[0], 33)
    }
    let o: Gc[JsObj] = val.as_obj(t)
    if which == RF_GETPROTO {
        let p: Gc[JsObj] = val.obj_proto(o)
        if (p as u64) == 0 {
            return val.realm_null(r)
        }
        let pv: Gc[JsVal] = p
        return pv
    }
    if which == RF_SETPROTO {
        let v: Gc[JsVal] = arg(r, args, 1)
        if val.val_tag(v) != val.TAG_OBJ && val.val_tag(v) != val.TAG_NULL {
            var m: [u8; 39] = "the prototype must be an object or null"
            return type_err(r, &m[0], 39)
        }
        if o.flags & val.F_EXTENSIBLE == 0 {
            return val.realm_bool(r, false)
        }
        var w: Gc[JsObj] = val.as_obj(v)
        while (w as u64) != 0 {
            if (w as u64) == (o as u64) {
                return val.realm_bool(r, false)
            }
            w = val.obj_proto(w)
        }
        val.obj_set_proto(o, val.as_obj(v))
        return val.realm_bool(r, true)
    }
    if which == RF_ISEXTENSIBLE {
        return val.realm_bool(r, o.flags & val.F_EXTENSIBLE != 0)
    }
    if which == RF_PREVENTEXT {
        o.flags = o.flags & (0xFFFFFFFFFFFFFFFF - val.F_EXTENSIBLE)
        return val.realm_bool(r, true)
    }
    if which == RF_OWNKEYS {
        let keys: Gc[GcVec] = try own_keys_all(r, o)
        let items: Gc[GcVec] = try interp.args_new(r)
        var i: u64 = 0
        while i < gcvec_length(keys) {
            let ok: bool = try gcvec_append[JsVal](items,
                val.key_name_str(r, gcvec_read_raw(keys, i)))
            i = i + 1
        }
        if o.cls == val.CLS_ARRAY {
            var ln: [u8; 6] = "length"
            let lv: Gc[JsVal] = try val.str_from_ascii(r, &ln[0], 6)
            let ok2: bool = try gcvec_append[JsVal](items, lv)
        }
        return new_array_from(r, items)
    }
    let k: u64 = try interp.to_property_key(r, arg(r, args, 1))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    if which == RF_HAS {
        let has: bool = try interp.has_prop(r, t, k)
        return val.realm_bool(r, has)
    }
    if which == RF_GET {
        var recv: Gc[JsVal] = t
        if nargs(args) >= 3 {
            recv = arg(r, args, 2)
        }
        return interp.get_prop_v(r, t, k, recv)
    }
    if which == RF_SET {
        let ok: bool = try interp.set_prop(r, t, k, arg(r, args, 2), false)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        return val.realm_bool(r, ok)
    }
    if which == RF_DELETEPROPERTY {
        let ok: bool = try interp.delete_prop(r, t, k, false)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        return val.realm_bool(r, ok)
    }
    if which == RF_GETOWNPD {
        return descriptor_of(r, o, k)
    }
    // Reflect.defineProperty: like Object.defineProperty, but it answers
    // with a boolean instead of throwing.
    let ok: bool = try apply_descriptor(r, o, k, arg(r, args, 2), false)
    if thrown(r) {
        return val.realm_undefined(r)
    }
    return val.realm_bool(r, ok)
}

// ==================================================== The URI functions
//
// 19.2.6. The reserved set decides which octets stay as they are; the rest
// is written out as `%XX` over UTF-8. A lone surrogate is a URIError, which
// is the one thing that makes this more than a table lookup.

fn hex_digit(v: u32) -> u32 {
    if v < 10 as u32 {
        return 48 as u32 + v
    }
    return 55 as u32 + v
}

fn hex_value(c: u32) -> i32 {
    if c >= 48 as u32 && c <= 57 as u32 {
        return (c - 48 as u32) as i32
    }
    if c >= 65 as u32 && c <= 70 as u32 {
        return (c - 55 as u32) as i32
    }
    if c >= 97 as u32 && c <= 102 as u32 {
        return (c - 87 as u32) as i32
    }
    return -1
}

fn uri_unescaped(c: u32, component: bool) -> bool {
    if c >= 65 as u32 && c <= 90 as u32 {
        return true
    }
    if c >= 97 as u32 && c <= 122 as u32 {
        return true
    }
    if c >= 48 as u32 && c <= 57 as u32 {
        return true
    }
    // - _ . ! ~ * ' ( )
    if c == 45 as u32 || c == 95 as u32 || c == 46 as u32 || c == 33 as u32 {
        return true
    }
    if c == 126 as u32 || c == 42 as u32 || c == 39 as u32 || c == 40 as u32 {
        return true
    }
    if c == 41 as u32 {
        return true
    }
    if component {
        return false
    }
    // ; / ? : @ & = + $ , #
    if c == 59 as u32 || c == 47 as u32 || c == 63 as u32 || c == 58 as u32 {
        return true
    }
    if c == 64 as u32 || c == 38 as u32 || c == 61 as u32 || c == 43 as u32 {
        return true
    }
    if c == 36 as u32 || c == 44 as u32 || c == 35 as u32 {
        return true
    }
    return false
}

fn uri_error(r: Gc[Realm]) -> AllocError!Gc[JsVal] {
    var m: [u8; 25] = "the URI is malformed here"
    return interp.throw_error(r, interp.ERR_URI, &m[0], 25)
}

fn uri_fn(r: Gc[Realm], id: u64, args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    let s: Gc[JsVal] = try interp.to_string(r, arg(r, args, 0))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    let n: u64 = val.str_len(s)
    let out: Gc[JsStr] = try val.str_new(r)
    let component: bool = id == N_ENCODE_COMP || id == N_DECODE_COMP
    if id == N_ENCODE_URI || id == N_ENCODE_COMP {
        var i: u64 = 0
        while i < n {
            var c: u32 = val.str_at(s, i)
            i = i + 1
            if uri_unescaped(c, component) {
                let ok: bool = try val.str_push(out, c)
                continue
            }
            if c >= 0xDC00 as u32 && c <= 0xDFFF as u32 {
                return uri_error(r)
            }
            if c >= 0xD800 as u32 && c <= 0xDBFF as u32 {
                if i >= n {
                    return uri_error(r)
                }
                let c2: u32 = val.str_at(s, i)
                if c2 < 0xDC00 as u32 || c2 > 0xDFFF as u32 {
                    return uri_error(r)
                }
                i = i + 1
                c = 0x10000 as u32 + ((c - 0xD800 as u32) << 10) + (c2 - 0xDC00 as u32)
            }
            var buf: [u8; 4] = [0 as u8; 4]
            var w: usize = 0
            if c < 0x80 as u32 {
                buf[0] = c as u8
                w = 1
            } else if c < 0x800 as u32 {
                buf[0] = (0xC0 as u32 | (c >> 6)) as u8
                buf[1] = (0x80 as u32 | (c & 0x3F as u32)) as u8
                w = 2
            } else if c < 0x10000 as u32 {
                buf[0] = (0xE0 as u32 | (c >> 12)) as u8
                buf[1] = (0x80 as u32 | ((c >> 6) & 0x3F as u32)) as u8
                buf[2] = (0x80 as u32 | (c & 0x3F as u32)) as u8
                w = 3
            } else {
                buf[0] = (0xF0 as u32 | (c >> 18)) as u8
                buf[1] = (0x80 as u32 | ((c >> 12) & 0x3F as u32)) as u8
                buf[2] = (0x80 as u32 | ((c >> 6) & 0x3F as u32)) as u8
                buf[3] = (0x80 as u32 | (c & 0x3F as u32)) as u8
                w = 4
            }
            var k: usize = 0
            while k < w {
                let b: u32 = buf[k] as u32
                let o1: bool = try val.str_push(out, 37 as u32)
                let o2: bool = try val.str_push(out, hex_digit(b >> 4))
                let o3: bool = try val.str_push(out, hex_digit(b & 15 as u32))
                k = k + 1
            }
        }
        let ov: Gc[JsVal] = out
        return ov
    }
    if id == N_ESCAPE || id == N_UNESCAPE {
        return escape_fn(r, id, s)
    }
    // decodeURI / decodeURIComponent
    var i: u64 = 0
    while i < n {
        let c: u32 = val.str_at(s, i)
        if c != 37 as u32 {
            let ok: bool = try val.str_push(out, c)
            i = i + 1
            continue
        }
        if i + 2 >= n {
            return uri_error(r)
        }
        let h1: i32 = hex_value(val.str_at(s, i + 1))
        let h2: i32 = hex_value(val.str_at(s, i + 2))
        if h1 < 0 || h2 < 0 {
            return uri_error(r)
        }
        let b0: u32 = ((h1 * 16 + h2) as u32)
        i = i + 3
        if b0 < 0x80 as u32 {
            // A reserved octet stays as the three characters it was.
            if !component && !uri_unescaped(b0, true) && uri_unescaped(b0, false) {
                let o1: bool = try val.str_push(out, 37 as u32)
                let o2: bool = try val.str_push(out, val.str_at(s, i - 2))
                let o3: bool = try val.str_push(out, val.str_at(s, i - 1))
                continue
            }
            let ok: bool = try val.str_push(out, b0)
            continue
        }
        var need: u64 = 0
        var cp: u32 = 0
        if b0 >= 0xC0 as u32 && b0 < 0xE0 as u32 {
            need = 1
            cp = b0 & 0x1F as u32
        } else if b0 >= 0xE0 as u32 && b0 < 0xF0 as u32 {
            need = 2
            cp = b0 & 0x0F as u32
        } else if b0 >= 0xF0 as u32 && b0 < 0xF8 as u32 {
            need = 3
            cp = b0 & 0x07 as u32
        } else {
            return uri_error(r)
        }
        var k: u64 = 0
        while k < need {
            if i + 2 >= n || val.str_at(s, i) != 37 as u32 {
                return uri_error(r)
            }
            let g1: i32 = hex_value(val.str_at(s, i + 1))
            let g2: i32 = hex_value(val.str_at(s, i + 2))
            if g1 < 0 || g2 < 0 {
                return uri_error(r)
            }
            let b: u32 = ((g1 * 16 + g2) as u32)
            if b < 0x80 as u32 || b >= 0xC0 as u32 {
                return uri_error(r)
            }
            cp = (cp << 6) | (b & 0x3F as u32)
            i = i + 3
            k = k + 1
        }
        if cp > 1114111 as u32 {
            return uri_error(r)
        }
        if cp >= 0xD800 as u32 && cp <= 0xDFFF as u32 {
            return uri_error(r)
        }
        // An overlong form is malformed too.
        if need == 1 && cp < 0x80 as u32 {
            return uri_error(r)
        }
        if need == 2 && cp < 0x800 as u32 {
            return uri_error(r)
        }
        if need == 3 && cp < 0x10000 as u32 {
            return uri_error(r)
        }
        if cp <= 0xFFFF as u32 {
            let ok: bool = try val.str_push(out, cp)
        } else {
            let v: u32 = cp - 0x10000 as u32
            let o1: bool = try val.str_push(out, 0xD800 as u32 + (v >> 10))
            let o2: bool = try val.str_push(out, 0xDC00 as u32 + (v & 0x3FF as u32))
        }
    }
    let ov: Gc[JsVal] = out
    return ov
}

// escape / unescape of Annex B.2.1: a code unit, not a code point.
fn escape_fn(r: Gc[Realm], id: u64, s: Gc[JsVal]) -> AllocError!Gc[JsVal] {
    let out: Gc[JsStr] = try val.str_new(r)
    let n: u64 = val.str_len(s)
    var i: u64 = 0
    if id == N_ESCAPE {
        while i < n {
            let c: u32 = val.str_at(s, i)
            i = i + 1
            var keep: bool = false
            if c >= 65 as u32 && c <= 90 as u32 {
                keep = true
            }
            if c >= 97 as u32 && c <= 122 as u32 {
                keep = true
            }
            if c >= 48 as u32 && c <= 57 as u32 {
                keep = true
            }
            if c == 64 as u32 || c == 42 as u32 || c == 95 as u32 {
                keep = true
            }
            if c == 43 as u32 || c == 45 as u32 || c == 46 as u32 {
                keep = true
            }
            if c == 47 as u32 {
                keep = true
            }
            if keep {
                let ok: bool = try val.str_push(out, c)
                continue
            }
            if c < 256 as u32 {
                let o1: bool = try val.str_push(out, 37 as u32)
                let o2: bool = try val.str_push(out, hex_digit(c >> 4))
                let o3: bool = try val.str_push(out, hex_digit(c & 15 as u32))
                continue
            }
            let o1: bool = try val.str_push(out, 37 as u32)
            let o2: bool = try val.str_push(out, 117 as u32)
            let o3: bool = try val.str_push(out, hex_digit((c >> 12) & 15 as u32))
            let o4: bool = try val.str_push(out, hex_digit((c >> 8) & 15 as u32))
            let o5: bool = try val.str_push(out, hex_digit((c >> 4) & 15 as u32))
            let o6: bool = try val.str_push(out, hex_digit(c & 15 as u32))
        }
        let ov: Gc[JsVal] = out
        return ov
    }
    while i < n {
        let c: u32 = val.str_at(s, i)
        if c == 37 as u32 && i + 5 < n && val.str_at(s, i + 1) == 117 as u32 {
            let d1: i32 = hex_value(val.str_at(s, i + 2))
            let d2: i32 = hex_value(val.str_at(s, i + 3))
            let d3: i32 = hex_value(val.str_at(s, i + 4))
            let d4: i32 = hex_value(val.str_at(s, i + 5))
            if d1 >= 0 && d2 >= 0 && d3 >= 0 && d4 >= 0 {
                let v: u32 = ((d1 * 4096 + d2 * 256 + d3 * 16 + d4) as u32)
                let ok: bool = try val.str_push(out, v)
                i = i + 6
                continue
            }
        }
        if c == 37 as u32 && i + 2 < n {
            let d1: i32 = hex_value(val.str_at(s, i + 1))
            let d2: i32 = hex_value(val.str_at(s, i + 2))
            if d1 >= 0 && d2 >= 0 {
                let ok: bool = try val.str_push(out, ((d1 * 16 + d2) as u32))
                i = i + 3
                continue
            }
        }
        let ok: bool = try val.str_push(out, c)
        i = i + 1
    }
    let ov: Gc[JsVal] = out
    return ov
}

// ==================================== The property descriptors, in one place
//
// Round 63 had this inside `lib/js/builtin.fi`, for `Object.defineProperty`
// alone. `Reflect.defineProperty` needs exactly the same validation but
// ANSWERS with `false` instead of throwing, so it lives here now with a
// flag, and `builtin.apply_descriptor` forwards to it.

fn has_key(r: Gc[Realm], o: Gc[JsVal], p: *mut u8, n: usize) -> AllocError!bool {
    let k: u64 = try key_ascii(r, p, n)
    return interp.has_prop(r, o, k)
}

fn get_key(r: Gc[Realm], o: Gc[JsVal], p: *mut u8,
    n: usize) -> AllocError!Gc[JsVal] {
    let k: u64 = try key_ascii(r, p, n)
    return interp.get_prop(r, o, k)
}

// 10.1.6.3 ValidateAndApplyPropertyDescriptor, in the form this engine
// needs: an existing non configurable property may not be redefined.
fn apply_descriptor(r: Gc[Realm], o: Gc[JsObj], k: u64,
    desc: Gc[JsVal], strict: bool) -> AllocError!bool {
    if val.val_tag(desc) != val.TAG_OBJ {
        var m: [u8; 42] = "the property description must be an object"
        let x: Gc[JsVal] = try type_err(r, &m[0], 42)
        return false
    }
    var vk: [u8; 5] = "value"
    var wk: [u8; 8] = "writable"
    var ek: [u8; 10] = "enumerable"
    var ck: [u8; 12] = "configurable"
    var gk: [u8; 3] = "get"
    var sk: [u8; 3] = "set"
    let has_value: bool = try has_key(r, desc, &vk[0], 5)
    let has_get: bool = try has_key(r, desc, &gk[0], 3)
    let has_set: bool = try has_key(r, desc, &sk[0], 3)
    let old: Gc[Prop] = val.obj_get_own(o, k)
    if (old as u64) != 0 && val.prop_attrs(old) & val.A_CONFIGURABLE == 0 {
        // Only a value change on a writable data property stays allowed.
        var bad: bool = val.prop_attrs(old) & val.A_ACCESSOR != 0
        if has_get || has_set {
            bad = true
        }
        if val.prop_attrs(old) & val.A_WRITABLE == 0 && has_value {
            if !interp.same_value(r, try get_key(r, desc, &vk[0], 5),
                val.prop_value(old)) {
                bad = true
            }
        }
        if bad {
            if strict {
                var m: [u8; 47] = "a non configurable property cannot be redefined"
                let x: Gc[JsVal] = try type_err(r, &m[0], 47)
            }
            return false
        }
    }
    var attrs: u64 = 0
    if (old as u64) != 0 {
        attrs = val.prop_attrs(old)
    }
    if try has_key(r, desc, &ek[0], 10) {
        let v: Gc[JsVal] = try get_key(r, desc, &ek[0], 10)
        if interp.to_boolean(r, v) {
            attrs = attrs | val.A_ENUMERABLE
        } else {
            attrs = attrs & (0xFFFFFFFFFFFFFFFF - val.A_ENUMERABLE)
        }
    }
    if try has_key(r, desc, &ck[0], 12) {
        let v: Gc[JsVal] = try get_key(r, desc, &ck[0], 12)
        if interp.to_boolean(r, v) {
            attrs = attrs | val.A_CONFIGURABLE
        } else {
            attrs = attrs & (0xFFFFFFFFFFFFFFFF - val.A_CONFIGURABLE)
        }
    }
    if has_get || has_set {
        var getter: Gc[JsVal] = val.realm_undefined(r)
        var setter: Gc[JsVal] = val.realm_undefined(r)
        if (old as u64) != 0 && val.prop_attrs(old) & val.A_ACCESSOR != 0 {
            getter = val.prop_value(old)
            setter = val.prop_setter(old)
        }
        if has_get {
            getter = try get_key(r, desc, &gk[0], 3)
        }
        if has_set {
            setter = try get_key(r, desc, &sk[0], 3)
        }
        attrs = attrs & (0xFFFFFFFFFFFFFFFF - val.A_WRITABLE)
        return interp.define_accessor(r, o, k, getter, setter, attrs)
    }
    if try has_key(r, desc, &wk[0], 8) {
        let v: Gc[JsVal] = try get_key(r, desc, &wk[0], 8)
        if interp.to_boolean(r, v) {
            attrs = attrs | val.A_WRITABLE
        } else {
            attrs = attrs & (0xFFFFFFFFFFFFFFFF - val.A_WRITABLE)
        }
    }
    var v: Gc[JsVal] = val.realm_undefined(r)
    if has_value {
        v = try get_key(r, desc, &vk[0], 5)
    } else if (old as u64) != 0 && val.prop_attrs(old) & val.A_ACCESSOR == 0 {
        v = val.prop_value(old)
    }
    attrs = attrs & (0xFFFFFFFFFFFFFFFF - val.A_ACCESSOR)
    // On an array an index goes into the dense storage.
    if o.cls == val.CLS_ARRAY || o.cls == val.CLS_ARGUMENTS {
        let i: i64 = val.index_of_key(r, k)
        if i >= 0 && attrs == val.A_DEFAULT {
            let ok: bool = try val.elems_set(r, o, i as u64, v)
            if (i as u64) >= o.len {
                o.len = i as u64 + 1
            }
            return true
        }
    }
    return interp.define_value(r, o, k, v, attrs)
}

// ========================================================= The dispatcher

fn dispatch2(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if id >= regexp.RE_BASE && id < regexp.RE_END {
        return regexp.regexp_dispatch(r, id, this, args, nt)
    }
    if id >= date.DATE_BASE && id < date.DATE_END {
        return date.date_dispatch(r, id, this, args, nt)
    }
    if id >= B2_MATH && id < B2_MATH + MM_COUNT {
        return math2_fn(r, id - B2_MATH, args)
    }
    if id >= B2_REFLECT && id < B2_REFLECT + RF_COUNT {
        return reflect_fn(r, id - B2_REFLECT, args)
    }
    if id == N_ITER_NEXT {
        return iter_next(r, this)
    }
    if id == N_ITER_RETURN {
        return iter_result(r, arg(r, args, 0), true)
    }
    if id >= N_SYM_FOR && id <= N_SYM_TOPRIMITIVE {
        return symbol2_fn(r, id, this, args)
    }
    if id >= N_ENCODE_URI && id <= N_UNESCAPE {
        return uri_fn(r, id, args)
    }
    if id == N_FN_HASINSTANCE {
        return interp.instance_of_ordinary(r, arg(r, args, 0), this)
    }
    if id >= N_262_EVAL && id <= N_262_GC {
        return host_fn(r, id, args)
    }
    if id < 1200 {
        return object2_fn(r, id, this, args, nt)
    }
    if id >= N_NP_TOEXP && id <= N_NP_TOLOCALE {
        return number2_fn(r, id, this, args)
    }
    if id >= N_STR_FROMCODEPOINT && id < N_AP_AT {
        return string2_fn(r, id, this, args, nt)
    }
    if id >= N_AP_AT && id <= N_AP_TOLOCALE {
        return array2_fn(r, id, this, args, nt)
    }
    if id == N_ERR_ISERROR {
        let o: Gc[JsObj] = val.as_obj(arg(r, args, 0))
        return val.realm_bool(r, (o as u64) != 0 && o.cls == val.CLS_ERROR)
    }
    if id >= N_MP_GETORINSERT && id <= N_MAP_GROUPBY {
        return map2_fn(r, id, this, args)
    }
    if id >= N_MP_KEYS && id <= N_AGGREGATE_CTOR {
        return collection2_fn(r, id, this, args, nt)
    }
    var m: [u8; 37] = "this built in is not implemented here"
    return type_err(r, &m[0], 37)
}

// The host object `$262` that test262 asks for (INTERPRETING.md). What is
// really there is `global` and `gc`; `createRealm` and `evalScript` need a
// second realm resp. `eval`, and both are honestly absent instead of
// pretending.
fn host_fn(r: Gc[Realm], id: u64, args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    if id == N_262_GC {
        let n: u64 = gc_collect()
        return val.realm_undefined(r)
    }
    if id == N_262_CREATEREALM {
        var m: [u8; 37] = "$262.createRealm needs a second realm"
        return type_err(r, &m[0], 37)
    }
    if id == N_262_DETACH {
        var m: [u8; 41] = "$262.detachArrayBuffer needs typed arrays"
        return type_err(r, &m[0], 41)
    }
    var m: [u8; 26] = "$262.evalScript needs eval"
    return type_err(r, &m[0], 26)
}

// ============================================================ The install

fn install2(r: Gc[Realm]) -> AllocError!bool {
    let g: Gc[JsObj] = val.realm_global(r)
    let ok1: bool = try install2_symbols(r, g)
    let ok2: bool = try install2_iterators(r)
    let ok3: bool = try install2_object(r, g)
    let ok4: bool = try install2_math(r, g)
    let ok5: bool = try install2_number(r, g)
    let ok6: bool = try install2_string(r, g)
    let ok7: bool = try install2_array(r, g)
    let ok8: bool = try install2_collections(r, g)
    let ok9: bool = try install2_error(r, g)
    let ok10: bool = try install2_reflect(r, g)
    let ok11: bool = try install2_global(r, g)
    let ok12: bool = try regexp.install_regexp(r, g)
    let ok13: bool = try date.install_date(r, g)
    return true
}

fn well_known(r: Gc[Realm], which: u64, sc: Gc[JsObj], name: *mut u8,
    n: usize, desc: *mut u8, dn: usize) -> AllocError!bool {
    let d: Gc[JsVal] = try val.str_from_ascii(r, desc, dn)
    let sym: Gc[JsVal] = try val.sym_new(r, d)
    val.realm_set_well_known(r, which, sym)
    return put(r, sc, name, n, sym, 0)
}

fn tostringtag(r: Gc[Realm], o: Gc[JsObj], name: *mut u8,
    n: usize) -> AllocError!bool {
    let tag: Gc[JsVal] = val.realm_well_known(r, val.WELL_KNOWN_TOSTRINGTAG)
    if (tag as u64) == 0 {
        return true
    }
    let s: Gc[JsVal] = try val.str_from_ascii(r, name, n)
    return interp.define_value(r, o, val.key_for_symbol(tag), s,
        val.A_CONFIGURABLE)
}

fn install2_symbols(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    var syn: [u8; 6] = "Symbol"
    let sk: u64 = try key_ascii(r, &syn[0], 6)
    let symv: Gc[JsVal] = try interp.get_prop(r, g, sk)
    if val.val_tag(symv) != val.TAG_OBJ {
        return true
    }
    let sc: Gc[JsObj] = val.as_obj(symv)
    var n1: [u8; 11] = "toStringTag"
    var d1: [u8; 18] = "Symbol.toStringTag"
    var n2: [u8; 11] = "hasInstance"
    var d2: [u8; 18] = "Symbol.hasInstance"
    var n3: [u8; 7] = "species"
    var d3: [u8; 14] = "Symbol.species"
    var n4: [u8; 5] = "match"
    var d4: [u8; 12] = "Symbol.match"
    var n5: [u8; 8] = "matchAll"
    var d5: [u8; 15] = "Symbol.matchAll"
    var n6: [u8; 7] = "replace"
    var d6: [u8; 14] = "Symbol.replace"
    var n7: [u8; 6] = "search"
    var d7: [u8; 13] = "Symbol.search"
    var n8: [u8; 5] = "split"
    var d8: [u8; 12] = "Symbol.split"
    var n9: [u8; 18] = "isConcatSpreadable"
    var d9: [u8; 25] = "Symbol.isConcatSpreadable"
    var n10: [u8; 11] = "unscopables"
    var d10: [u8; 18] = "Symbol.unscopables"
    let k1: bool = try well_known(r, val.WELL_KNOWN_TOSTRINGTAG, sc,
        &n1[0], 11, &d1[0], 18)
    let k2: bool = try well_known(r, val.WELL_KNOWN_HASINSTANCE, sc,
        &n2[0], 11, &d2[0], 18)
    let k3: bool = try well_known(r, val.WELL_KNOWN_SPECIES, sc,
        &n3[0], 7, &d3[0], 14)
    let k4: bool = try well_known(r, val.WELL_KNOWN_MATCH, sc,
        &n4[0], 5, &d4[0], 12)
    let k5: bool = try well_known(r, val.WELL_KNOWN_MATCHALL, sc,
        &n5[0], 8, &d5[0], 15)
    let k6: bool = try well_known(r, val.WELL_KNOWN_REPLACE, sc,
        &n6[0], 7, &d6[0], 14)
    let k7: bool = try well_known(r, val.WELL_KNOWN_SEARCH, sc,
        &n7[0], 6, &d7[0], 13)
    let k8: bool = try well_known(r, val.WELL_KNOWN_SPLIT, sc,
        &n8[0], 5, &d8[0], 12)
    let k9: bool = try well_known(r, val.WELL_KNOWN_ISCONCATSPREADABLE, sc,
        &n9[0], 18, &d9[0], 25)
    let k10: bool = try well_known(r, val.WELL_KNOWN_UNSCOPABLES, sc,
        &n10[0], 11, &d10[0], 18)
    var f1: [u8; 3] = "for"
    var f2: [u8; 6] = "keyFor"
    let m1: bool = try nat(r, sc, &f1[0], 3, N_SYM_FOR, 1)
    let m2: bool = try nat(r, sc, &f2[0], 6, N_SYM_KEYFOR, 1)
    let reg: Gc[JsObj] = try val.obj_new_proto(r, gc_null[JsObj]())
    val.realm_set_registry(r, reg)
    let syp: Gc[JsObj] = val.realm_proto(r, val.PROTO_SYMBOL)
    var dn: [u8; 11] = "description"
    let m3: bool = try getter(r, syp, &dn[0], 11, N_SYM_DESCRIPTION)
    var tp: [u8; 20] = "[Symbol.toPrimitive]"
    let tf: Gc[JsObj] = try interp.make_native(r, N_SYM_TOPRIMITIVE, 1,
        &tp[0], 20)
    let tfv: Gc[JsVal] = tf
    let tk: u64 = val.key_for_symbol(val.realm_well_known(r,
            val.WELL_KNOWN_TOPRIMITIVE))
    let m4: bool = try interp.define_value(r, syp, tk, tfv, val.A_CONFIGURABLE)
    var st: [u8; 6] = "Symbol"
    let m5: bool = try tostringtag(r, syp, &st[0], 6)
    // Math and JSON carry the tag as well (21.3.1.9, 25.5.3).
    var mn: [u8; 4] = "Math"
    var jn: [u8; 4] = "JSON"
    let mk: u64 = try key_ascii(r, &mn[0], 4)
    let jk: u64 = try key_ascii(r, &jn[0], 4)
    let mv: Gc[JsVal] = try interp.get_prop(r, g, mk)
    let jv: Gc[JsVal] = try interp.get_prop(r, g, jk)
    if val.val_tag(mv) == val.TAG_OBJ {
        let a: bool = try tostringtag(r, val.as_obj(mv), &mn[0], 4)
    }
    if val.val_tag(jv) == val.TAG_OBJ {
        let b: bool = try tostringtag(r, val.as_obj(jv), &jn[0], 4)
    }
    // Function.prototype[Symbol.hasInstance] (20.2.3.6).
    let fp: Gc[JsObj] = val.realm_proto(r, val.PROTO_FUNCTION)
    var hn: [u8; 20] = "[Symbol.hasInstance]"
    let hf: Gc[JsObj] = try interp.make_native(r, N_FN_HASINSTANCE, 1,
        &hn[0], 20)
    let hfv: Gc[JsVal] = hf
    let hk: u64 = val.key_for_symbol(val.realm_well_known(r,
            val.WELL_KNOWN_HASINSTANCE))
    let m6: bool = try interp.define_value(r, fp, hk, hfv, 0)
    return true
}

fn install2_iterators(r: Gc[Realm]) -> AllocError!bool {
    let itp: Gc[JsObj] = val.realm_proto(r, val.PROTO_ITERATOR)
    var nn: [u8; 4] = "next"
    var t1: [u8; 14] = "Array Iterator"
    var t2: [u8; 15] = "String Iterator"
    var t3: [u8; 12] = "Map Iterator"
    var t4: [u8; 12] = "Set Iterator"
    var i: u64 = 0
    while i < 4 {
        var which: u64 = val.PROTO_ARRAY_ITERATOR
        if i == 1 {
            which = val.PROTO_STRING_ITERATOR
        }
        if i == 2 {
            which = val.PROTO_MAP_ITERATOR
        }
        if i == 3 {
            which = val.PROTO_SET_ITERATOR
        }
        let p: Gc[JsObj] = val.realm_proto(r, which)
        val.obj_set_proto(p, itp)
        let ok: bool = try nat(r, p, &nn[0], 4, N_ITER_NEXT, 0)
        if i == 0 {
            let t: bool = try tostringtag(r, p, &t1[0], 14)
        } else if i == 1 {
            let t: bool = try tostringtag(r, p, &t2[0], 15)
        } else if i == 2 {
            let t: bool = try tostringtag(r, p, &t3[0], 12)
        } else {
            let t: bool = try tostringtag(r, p, &t4[0], 12)
        }
        i = i + 1
    }
    return true
}

fn install2_object(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    var on: [u8; 6] = "Object"
    let ok: u64 = try key_ascii(r, &on[0], 6)
    let ov: Gc[JsVal] = try interp.get_prop(r, g, ok)
    let op: Gc[JsObj] = val.realm_proto(r, val.PROTO_OBJECT)
    if val.val_tag(ov) == val.TAG_OBJ {
        let c: Gc[JsObj] = val.as_obj(ov)
        var a1: [u8; 6] = "hasOwn"
        var a2: [u8; 11] = "fromEntries"
        var a3: [u8; 21] = "getOwnPropertySymbols"
        var a4: [u8; 25] = "getOwnPropertyDescriptors"
        var a5: [u8; 7] = "groupBy"
        let k1: bool = try nat(r, c, &a1[0], 6, N_OBJ_HASOWN, 2)
        let k2: bool = try nat(r, c, &a2[0], 11, N_OBJ_FROMENTRIES, 1)
        let k3: bool = try nat(r, c, &a3[0], 21, N_OBJ_GOPS, 1)
        let k4: bool = try nat(r, c, &a4[0], 25, N_OBJ_GOPDS, 1)
        let k5: bool = try nat(r, c, &a5[0], 7, N_OBJ_GROUPBY, 2)
    }
    var p1: [u8; 16] = "__defineGetter__"
    var p2: [u8; 16] = "__defineSetter__"
    var p3: [u8; 16] = "__lookupGetter__"
    var p4: [u8; 16] = "__lookupSetter__"
    let m1: bool = try nat(r, op, &p1[0], 16, N_OP_DEFGET, 2)
    let m2: bool = try nat(r, op, &p2[0], 16, N_OP_DEFSET, 2)
    let m3: bool = try nat(r, op, &p3[0], 16, N_OP_LOOKGET, 1)
    let m4: bool = try nat(r, op, &p4[0], 16, N_OP_LOOKSET, 1)
    // Object.prototype.__proto__ is an ACCESSOR (Annex B.2.2.1).
    var pp: [u8; 9] = "__proto__"
    let gf: Gc[JsObj] = try interp.make_native(r, N_OP_PROTO_GET, 0, &pp[0], 9)
    let sf: Gc[JsObj] = try interp.make_native(r, N_OP_PROTO_SET, 1, &pp[0], 9)
    let gfv: Gc[JsVal] = gf
    let sfv: Gc[JsVal] = sf
    let pk: u64 = try key_ascii(r, &pp[0], 9)
    let m5: bool = try interp.define_accessor(r, op, pk, gfv, sfv,
        val.A_CONFIGURABLE)
    return true
}

fn install2_math(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    var mn: [u8; 4] = "Math"
    let mk: u64 = try key_ascii(r, &mn[0], 4)
    let mv: Gc[JsVal] = try interp.get_prop(r, g, mk)
    if val.val_tag(mv) != val.TAG_OBJ {
        return true
    }
    let m: Gc[JsObj] = val.as_obj(mv)
    var f01: [u8; 4] = "asin"
    var f02: [u8; 4] = "acos"
    var f03: [u8; 4] = "sinh"
    var f04: [u8; 4] = "cosh"
    var f05: [u8; 4] = "tanh"
    var f06: [u8; 5] = "asinh"
    var f07: [u8; 5] = "acosh"
    var f08: [u8; 5] = "atanh"
    var f09: [u8; 5] = "log1p"
    var f10: [u8; 5] = "expm1"
    var f11: [u8; 5] = "clz32"
    var f12: [u8; 4] = "imul"
    var f13: [u8; 6] = "fround"
    var f14: [u8; 6] = "random"
    var f15: [u8; 8] = "f16round"
    var f16: [u8; 10] = "sumPrecise"
    let k01: bool = try nat(r, m, &f01[0], 4, B2_MATH + MM_ASIN, 1)
    let k02: bool = try nat(r, m, &f02[0], 4, B2_MATH + MM_ACOS, 1)
    let k03: bool = try nat(r, m, &f03[0], 4, B2_MATH + MM_SINH, 1)
    let k04: bool = try nat(r, m, &f04[0], 4, B2_MATH + MM_COSH, 1)
    let k05: bool = try nat(r, m, &f05[0], 4, B2_MATH + MM_TANH, 1)
    let k06: bool = try nat(r, m, &f06[0], 5, B2_MATH + MM_ASINH, 1)
    let k07: bool = try nat(r, m, &f07[0], 5, B2_MATH + MM_ACOSH, 1)
    let k08: bool = try nat(r, m, &f08[0], 5, B2_MATH + MM_ATANH, 1)
    let k09: bool = try nat(r, m, &f09[0], 5, B2_MATH + MM_LOG1P, 1)
    let k10: bool = try nat(r, m, &f10[0], 5, B2_MATH + MM_EXPM1, 1)
    let k11: bool = try nat(r, m, &f11[0], 5, B2_MATH + MM_CLZ32, 1)
    let k12: bool = try nat(r, m, &f12[0], 4, B2_MATH + MM_IMUL, 2)
    let k13: bool = try nat(r, m, &f13[0], 6, B2_MATH + MM_FROUND, 1)
    let k14: bool = try nat(r, m, &f14[0], 6, B2_MATH + MM_RANDOM, 0)
    let k15: bool = try nat(r, m, &f15[0], 8, B2_MATH + MM_F16ROUND, 1)
    let k16: bool = try nat(r, m, &f16[0], 10, B2_MATH + MM_SUMPRECISE, 1)
    var c1: [u8; 6] = "LOG10E"
    var c2: [u8; 5] = "LOG2E"
    var c3: [u8; 7] = "SQRT1_2"
    let d1: bool = try put_num(r, m, &c1[0], 6, 1.0 / math.LN10(), 0)
    let d2: bool = try put_num(r, m, &c2[0], 5, 1.0 / math.LN2(), 0)
    let d3: bool = try put_num(r, m, &c3[0], 7, math.sqrt(0.5), 0)
    return true
}

fn install2_number(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    let np: Gc[JsObj] = val.realm_proto(r, val.PROTO_NUMBER)
    var a1: [u8; 13] = "toExponential"
    var a2: [u8; 11] = "toPrecision"
    var a3: [u8; 14] = "toLocaleString"
    let k1: bool = try nat(r, np, &a1[0], 13, N_NP_TOEXP, 1)
    let k2: bool = try nat(r, np, &a2[0], 11, N_NP_TOPREC, 1)
    let k3: bool = try nat(r, np, &a3[0], 14, N_NP_TOLOCALE, 0)
    return true
}

fn install2_string(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    var sn: [u8; 6] = "String"
    let sk: u64 = try key_ascii(r, &sn[0], 6)
    let sv: Gc[JsVal] = try interp.get_prop(r, g, sk)
    if val.val_tag(sv) == val.TAG_OBJ {
        let c: Gc[JsObj] = val.as_obj(sv)
        var a1: [u8; 13] = "fromCodePoint"
        var a2: [u8; 3] = "raw"
        let k1: bool = try nat(r, c, &a1[0], 13, N_STR_FROMCODEPOINT, 1)
        let k2: bool = try nat(r, c, &a2[0], 3, N_STR_RAW, 1)
    }
    let sp: Gc[JsObj] = val.realm_proto(r, val.PROTO_STRING)
    var p01: [u8; 9] = "trimStart"
    var p02: [u8; 7] = "trimEnd"
    var p03: [u8; 13] = "localeCompare"
    var p04: [u8; 17] = "toLocaleUpperCase"
    var p05: [u8; 17] = "toLocaleLowerCase"
    var p06: [u8; 9] = "normalize"
    var p07: [u8; 12] = "isWellFormed"
    var p08: [u8; 12] = "toWellFormed"
    let m01: bool = try nat(r, sp, &p01[0], 9, N_SP_TRIMSTART, 0)
    let m02: bool = try nat(r, sp, &p02[0], 7, N_SP_TRIMEND, 0)
    let m03: bool = try nat(r, sp, &p03[0], 13, N_SP_LOCALECOMPARE, 1)
    let m04: bool = try nat(r, sp, &p04[0], 17, N_SP_TOLOCALEUPPER, 0)
    let m05: bool = try nat(r, sp, &p05[0], 17, N_SP_TOLOCALELOWER, 0)
    let m06: bool = try nat(r, sp, &p06[0], 9, N_SP_NORMALIZE, 0)
    let m07: bool = try nat(r, sp, &p07[0], 12, N_SP_ISWELLFORMED, 0)
    let m08: bool = try nat(r, sp, &p08[0], 12, N_SP_TOWELLFORMED, 0)
    // The two aliases of Annex B.2.2.
    var t1: [u8; 8] = "trimLeft"
    var t2: [u8; 9] = "trimRight"
    let m09: bool = try nat(r, sp, &t1[0], 8, N_SP_TRIMSTART, 0)
    let m10: bool = try nat(r, sp, &t2[0], 9, N_SP_TRIMEND, 0)
    // The thirteen text methods, in the order of the table in `html_wrap`.
    var h: [u8; 130] = "anchor    big       blink     bold      fixed     fontcolor fontsize  italics   link      small     strike    sub       sup       "
    var k: u64 = 0
    while k < 13 {
        let off: usize = (k as usize) * 10
        var n: usize = 0
        while n < 10 && h[off + n] != 32 as u8 {
            n = n + 1
        }
        var arity: u64 = 0
        if k == 0 || k == 5 || k == 6 || k == 8 {
            arity = 1
        }
        let ok: bool = try nat(r, sp, &h[off], n, N_SP_HTML + k, arity)
        k = k + 1
    }
    // String.prototype[Symbol.iterator]
    var sit: [u8; 17] = "[Symbol.iterator]"
    let f: Gc[JsObj] = try interp.make_native(r, N_SP_ITERATOR, 0, &sit[0], 17)
    let fv: Gc[JsVal] = f
    let ik: u64 = val.key_for_symbol(val.realm_well_known(r,
            val.WELL_KNOWN_ITERATOR))
    let m11: bool = try interp.define_value(r, sp, ik, fv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    return true
}

fn install2_array(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    let ap: Gc[JsObj] = val.realm_proto(r, val.PROTO_ARRAY)
    var p01: [u8; 2] = "at"
    var p02: [u8; 4] = "flat"
    var p03: [u8; 7] = "flatMap"
    var p04: [u8; 8] = "findLast"
    var p05: [u8; 13] = "findLastIndex"
    var p06: [u8; 10] = "copyWithin"
    var p07: [u8; 4] = "keys"
    var p08: [u8; 6] = "values"
    var p09: [u8; 7] = "entries"
    var p10: [u8; 10] = "toReversed"
    var p11: [u8; 8] = "toSorted"
    var p12: [u8; 9] = "toSpliced"
    var p13: [u8; 4] = "with"
    var p14: [u8; 14] = "toLocaleString"
    let m01: bool = try nat(r, ap, &p01[0], 2, N_AP_AT, 1)
    let m02: bool = try nat(r, ap, &p02[0], 4, N_AP_FLAT, 0)
    let m03: bool = try nat(r, ap, &p03[0], 7, N_AP_FLATMAP, 1)
    let m04: bool = try nat(r, ap, &p04[0], 8, N_AP_FINDLAST, 1)
    let m05: bool = try nat(r, ap, &p05[0], 13, N_AP_FINDLASTINDEX, 1)
    let m06: bool = try nat(r, ap, &p06[0], 10, N_AP_COPYWITHIN, 2)
    let m07: bool = try nat(r, ap, &p07[0], 4, N_AP_KEYS, 0)
    let m09: bool = try nat(r, ap, &p09[0], 7, N_AP_ENTRIES, 0)
    let m10: bool = try nat(r, ap, &p10[0], 10, N_AP_TOREVERSED, 0)
    let m11: bool = try nat(r, ap, &p11[0], 8, N_AP_TOSORTED, 1)
    let m12: bool = try nat(r, ap, &p12[0], 9, N_AP_TOSPLICED, 2)
    let m13: bool = try nat(r, ap, &p13[0], 4, N_AP_WITH, 2)
    let m14: bool = try nat(r, ap, &p14[0], 14, N_AP_TOLOCALE, 0)
    // `values` and `[Symbol.iterator]` are the SAME function object
    // (23.1.3.36).
    let vf: Gc[JsObj] = try interp.make_native(r, N_AP_VALUES, 0, &p08[0], 6)
    let vfv: Gc[JsVal] = vf
    let vk: u64 = try key_ascii(r, &p08[0], 6)
    let m08: bool = try interp.define_value(r, ap, vk, vfv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let ik: u64 = val.key_for_symbol(val.realm_well_known(r,
            val.WELL_KNOWN_ITERATOR))
    let m15: bool = try interp.define_value(r, ap, ik, vfv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    // Array.prototype[Symbol.unscopables] (23.1.3.38).
    let un: Gc[JsObj] = try val.obj_new_proto(r, gc_null[JsObj]())
    var u: [u8; 182] = "at            copyWithin    entries       fill          find          findIndex     findLast      findLastIndex flat          flatMap       includes      keys          values        "
    var k: u64 = 0
    while k < 13 {
        let off: usize = (k as usize) * 14
        var n: usize = 0
        while n < 14 && u[off + n] != 32 as u8 {
            n = n + 1
        }
        let ok: bool = try put(r, un, &u[off], n, val.realm_bool(r, true),
            val.A_DEFAULT)
        k = k + 1
    }
    let unv: Gc[JsVal] = un
    let uk: u64 = val.key_for_symbol(val.realm_well_known(r,
            val.WELL_KNOWN_UNSCOPABLES))
    let m16: bool = try interp.define_value(r, ap, uk, unv, val.A_CONFIGURABLE)
    return true
}

fn install2_collections(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    let mp: Gc[JsObj] = val.realm_proto(r, val.PROTO_MAP)
    let sp: Gc[JsObj] = val.realm_proto(r, val.PROTO_SET)
    var a1: [u8; 4] = "keys"
    var a2: [u8; 6] = "values"
    var a3: [u8; 7] = "entries"
    let k1: bool = try nat(r, mp, &a1[0], 4, N_MP_KEYS, 0)
    let k2: bool = try nat(r, mp, &a2[0], 6, N_MP_VALUES, 0)
    let k3: bool = try nat(r, sp, &a1[0], 4, N_SET_KEYS, 0)
    let k4: bool = try nat(r, sp, &a3[0], 7, N_SET_ENTRIES, 0)
    let ik: u64 = val.key_for_symbol(val.realm_well_known(r,
            val.WELL_KNOWN_ITERATOR))
    // On a Map `entries` and `[Symbol.iterator]` are the same object, on a
    // Set `values`, `keys` and `[Symbol.iterator]` are (24.1.3.12).
    let mef: Gc[JsObj] = try interp.make_native(r, N_MP_ENTRIES, 0, &a3[0], 7)
    let mefv: Gc[JsVal] = mef
    let ek: u64 = try key_ascii(r, &a3[0], 7)
    let k5: bool = try interp.define_value(r, mp, ek, mefv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let k6: bool = try interp.define_value(r, mp, ik, mefv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let svf: Gc[JsObj] = try interp.make_native(r, N_SET_VALUES, 0, &a2[0], 6)
    let svfv: Gc[JsVal] = svf
    let vk: u64 = try key_ascii(r, &a2[0], 6)
    let k7: bool = try interp.define_value(r, sp, vk, svfv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let k8: bool = try interp.define_value(r, sp, ik, svfv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    var mt: [u8; 3] = "Map"
    var st: [u8; 3] = "Set"
    let k9: bool = try tostringtag(r, mp, &mt[0], 3)
    let k10: bool = try tostringtag(r, sp, &st[0], 3)
    // The seven set operations of ES2025.
    var s1: [u8; 5] = "union"
    var s2: [u8; 12] = "intersection"
    var s3: [u8; 10] = "difference"
    var s4: [u8; 19] = "symmetricDifference"
    var s5: [u8; 10] = "isSubsetOf"
    var s6: [u8; 12] = "isSupersetOf"
    var s7: [u8; 14] = "isDisjointFrom"
    let o1: bool = try nat(r, sp, &s1[0], 5, N_SET_UNION, 1)
    let o2: bool = try nat(r, sp, &s2[0], 12, N_SET_INTERSECTION, 1)
    let o3: bool = try nat(r, sp, &s3[0], 10, N_SET_DIFFERENCE, 1)
    let o4: bool = try nat(r, sp, &s4[0], 19, N_SET_SYMDIFF, 1)
    let o5: bool = try nat(r, sp, &s5[0], 10, N_SET_ISSUBSET, 1)
    let o6: bool = try nat(r, sp, &s6[0], 12, N_SET_ISSUPERSET, 1)
    let o7: bool = try nat(r, sp, &s7[0], 14, N_SET_ISDISJOINT, 1)
    // WeakMap, WeakSet, WeakRef, FinalizationRegistry.
    var w1: [u8; 7] = "WeakMap"
    var w2: [u8; 7] = "WeakSet"
    var w3: [u8; 7] = "WeakRef"
    var w4: [u8; 20] = "FinalizationRegistry"
    let c1: Gc[JsObj] = try ctor2(r, g, &w1[0], 7, N_WEAK_CTOR, 0,
        val.PROTO_WEAKMAP)
    let c2: Gc[JsObj] = try ctor2(r, g, &w2[0], 7, N_WEAKSET_CTOR, 0,
        val.PROTO_WEAKSET)
    let c3: Gc[JsObj] = try ctor2(r, g, &w3[0], 7, N_WEAKREF_CTOR, 1,
        val.PROTO_WEAKREF)
    let c4: Gc[JsObj] = try ctor2(r, g, &w4[0], 20, N_FINREG_CTOR, 1,
        val.PROTO_FINREG)
    let wmp: Gc[JsObj] = val.realm_proto(r, val.PROTO_WEAKMAP)
    let wsp: Gc[JsObj] = val.realm_proto(r, val.PROTO_WEAKSET)
    let wrp: Gc[JsObj] = val.realm_proto(r, val.PROTO_WEAKREF)
    let frp: Gc[JsObj] = val.realm_proto(r, val.PROTO_FINREG)
    var g1: [u8; 3] = "get"
    var g2: [u8; 3] = "set"
    var g3: [u8; 3] = "has"
    var g4: [u8; 6] = "delete"
    var g5: [u8; 3] = "add"
    var g6: [u8; 5] = "deref"
    var g7: [u8; 8] = "register"
    var g8: [u8; 10] = "unregister"
    var g9: [u8; 11] = "cleanupSome"
    let p1: bool = try nat(r, wmp, &g1[0], 3, N_WEAK_GET, 1)
    let p2: bool = try nat(r, wmp, &g2[0], 3, N_WEAK_SET, 2)
    let p3: bool = try nat(r, wmp, &g3[0], 3, N_WEAK_HAS, 1)
    let p4: bool = try nat(r, wmp, &g4[0], 6, N_WEAK_DELETE, 1)
    let p5: bool = try nat(r, wsp, &g5[0], 3, N_WEAK_ADD, 1)
    let p6: bool = try nat(r, wsp, &g3[0], 3, N_WEAK_HAS, 1)
    let p7: bool = try nat(r, wsp, &g4[0], 6, N_WEAK_DELETE, 1)
    let p8: bool = try nat(r, wrp, &g6[0], 5, N_WEAKREF_DEREF, 0)
    let p9: bool = try nat(r, frp, &g7[0], 8, N_FINREG_REGISTER, 2)
    let p10: bool = try nat(r, frp, &g8[0], 10, N_FINREG_UNREGISTER, 1)
    var gi1: [u8; 11] = "getOrInsert"
    var gi2: [u8; 19] = "getOrInsertComputed"
    var gb: [u8; 7] = "groupBy"
    let q1: bool = try nat(r, mp, &gi1[0], 11, N_MP_GETORINSERT, 2)
    let q2: bool = try nat(r, mp, &gi2[0], 19, N_MP_GETORINSERTC, 2)
    var mcn: [u8; 3] = "Map"
    let mck: u64 = try key_ascii(r, &mcn[0], 3)
    let mcv: Gc[JsVal] = try interp.get_prop(r, g, mck)
    if val.val_tag(mcv) == val.TAG_OBJ {
        let q3: bool = try nat(r, val.as_obj(mcv), &gb[0], 7, N_MAP_GROUPBY, 2)
    }
    let t1: bool = try tostringtag(r, wmp, &w1[0], 7)
    let t2: bool = try tostringtag(r, wsp, &w2[0], 7)
    let t3: bool = try tostringtag(r, wrp, &w3[0], 7)
    let t4: bool = try tostringtag(r, frp, &w4[0], 20)
    return true
}

// A constructor with its prototype, wired both ways -- the same shape
// `lib/js/builtin.fi` uses.
fn ctor2(r: Gc[Realm], g: Gc[JsObj], name: *mut u8, n: usize, id: u64,
    arity: u64, which: u64) -> AllocError!Gc[JsObj] {
    let f: Gc[JsObj] = try interp.make_native(r, id, arity, name, n)
    f.flags = f.flags | val.F_CTOR
    let proto: Gc[JsObj] = val.realm_proto(r, which)
    let pk: u64 = try val.key_for_name(r, lex.N_PROTOTYPE)
    let pv: Gc[JsVal] = proto
    let ok1: bool = try interp.define_value(r, f, pk, pv, 0)
    let ck: u64 = try val.key_for_name(r, lex.N_CONSTRUCTOR)
    let cv: Gc[JsVal] = f
    let ok2: bool = try interp.define_value(r, proto, ck, cv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let ok3: bool = try put(r, g, name, n, cv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    return f
}

fn install2_error(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    var en: [u8; 5] = "Error"
    let ek: u64 = try key_ascii(r, &en[0], 5)
    let ev: Gc[JsVal] = try interp.get_prop(r, g, ek)
    if val.val_tag(ev) == val.TAG_OBJ {
        var a1: [u8; 7] = "isError"
        let k1: bool = try nat(r, val.as_obj(ev), &a1[0], 7, N_ERR_ISERROR, 1)
    }
    var an: [u8; 14] = "AggregateError"
    let c: Gc[JsObj] = try ctor2(r, g, &an[0], 14, N_AGGREGATE_CTOR, 2,
        val.PROTO_AGGREGATE_ERROR)
    if val.val_tag(ev) == val.TAG_OBJ {
        val.obj_set_proto(c, val.as_obj(ev))
    }
    let ap: Gc[JsObj] = val.realm_proto(r, val.PROTO_AGGREGATE_ERROR)
    val.obj_set_proto(ap, val.realm_proto(r, val.PROTO_ERROR))
    let nk: u64 = try val.key_for_name(r, lex.N_NAME)
    let nv: Gc[JsVal] = try val.str_from_ascii(r, &an[0], 14)
    let k2: bool = try interp.define_value(r, ap, nk, nv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    var mn: [u8; 7] = "message"
    let k3: bool = try put(r, ap, &mn[0], 7, val.str_empty(r),
        val.A_WRITABLE | val.A_CONFIGURABLE)
    return true
}

fn install2_reflect(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    let o: Gc[JsObj] = try val.obj_new(r)
    var rn: [u8; 7] = "Reflect"
    let ov: Gc[JsVal] = o
    let k0: bool = try put(r, g, &rn[0], 7, ov,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    var n01: [u8; 5] = "apply"
    var n02: [u8; 9] = "construct"
    var n03: [u8; 14] = "defineProperty"
    var n04: [u8; 14] = "deleteProperty"
    var n05: [u8; 3] = "get"
    var n06: [u8; 24] = "getOwnPropertyDescriptor"
    var n07: [u8; 14] = "getPrototypeOf"
    var n08: [u8; 3] = "has"
    var n09: [u8; 12] = "isExtensible"
    var n10: [u8; 7] = "ownKeys"
    var n11: [u8; 17] = "preventExtensions"
    var n12: [u8; 3] = "set"
    var n13: [u8; 14] = "setPrototypeOf"
    let k01: bool = try nat(r, o, &n01[0], 5, B2_REFLECT + RF_APPLY, 3)
    let k02: bool = try nat(r, o, &n02[0], 9, B2_REFLECT + RF_CONSTRUCT, 2)
    let k03: bool = try nat(r, o, &n03[0], 14,
        B2_REFLECT + RF_DEFINEPROPERTY, 3)
    let k04: bool = try nat(r, o, &n04[0], 14,
        B2_REFLECT + RF_DELETEPROPERTY, 2)
    let k05: bool = try nat(r, o, &n05[0], 3, B2_REFLECT + RF_GET, 2)
    let k06: bool = try nat(r, o, &n06[0], 24, B2_REFLECT + RF_GETOWNPD, 2)
    let k07: bool = try nat(r, o, &n07[0], 14, B2_REFLECT + RF_GETPROTO, 1)
    let k08: bool = try nat(r, o, &n08[0], 3, B2_REFLECT + RF_HAS, 2)
    let k09: bool = try nat(r, o, &n09[0], 12, B2_REFLECT + RF_ISEXTENSIBLE, 1)
    let k10: bool = try nat(r, o, &n10[0], 7, B2_REFLECT + RF_OWNKEYS, 1)
    let k11: bool = try nat(r, o, &n11[0], 17, B2_REFLECT + RF_PREVENTEXT, 1)
    let k12: bool = try nat(r, o, &n12[0], 3, B2_REFLECT + RF_SET, 3)
    let k13: bool = try nat(r, o, &n13[0], 14, B2_REFLECT + RF_SETPROTO, 2)
    let t: bool = try tostringtag(r, o, &rn[0], 7)
    return true
}

fn install2_global(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    var u1: [u8; 9] = "encodeURI"
    var u2: [u8; 18] = "encodeURIComponent"
    var u3: [u8; 9] = "decodeURI"
    var u4: [u8; 18] = "decodeURIComponent"
    var u5: [u8; 6] = "escape"
    var u6: [u8; 8] = "unescape"
    let k1: bool = try nat(r, g, &u1[0], 9, N_ENCODE_URI, 1)
    let k2: bool = try nat(r, g, &u2[0], 18, N_ENCODE_COMP, 1)
    let k3: bool = try nat(r, g, &u3[0], 9, N_DECODE_URI, 1)
    let k4: bool = try nat(r, g, &u4[0], 18, N_DECODE_COMP, 1)
    let k5: bool = try nat(r, g, &u5[0], 6, N_ESCAPE, 1)
    let k6: bool = try nat(r, g, &u6[0], 8, N_UNESCAPE, 1)
    // The host object of test262 (INTERPRETING.md).
    let h: Gc[JsObj] = try val.obj_new(r)
    var hn: [u8; 4] = "$262"
    let hv: Gc[JsVal] = h
    let k7: bool = try put(r, g, &hn[0], 4, hv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    var p1: [u8; 6] = "global"
    var p2: [u8; 2] = "gc"
    var p3: [u8; 11] = "createRealm"
    var p4: [u8; 10] = "evalScript"
    var p5: [u8; 17] = "detachArrayBuffer"
    let gv: Gc[JsVal] = g
    let k8: bool = try put(r, h, &p1[0], 6, gv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let k9: bool = try nat(r, h, &p2[0], 2, N_262_GC, 0)
    let k10: bool = try nat(r, h, &p3[0], 11, N_262_CREATEREALM, 0)
    let k11: bool = try nat(r, h, &p4[0], 10, N_262_EVAL, 1)
    let k12: bool = try nat(r, h, &p5[0], 17, N_262_DETACH, 1)
    return true
}

// ------------------------------------------ Map.getOrInsert, Map.groupBy

fn map2_fn(r: Gc[Realm], id: u64, this: Gc[JsVal],
    args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    if id == N_MAP_GROUPBY {
        let f: Gc[JsVal] = arg(r, args, 1)
        if !val.is_callable(f) {
            var m: [u8; 28] = "the callback is not callable"
            return type_err(r, &m[0], 28)
        }
        let items: Gc[GcVec] = try interp.iterate_values(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let o: Gc[JsObj] = try val.obj_new_proto(r,
            val.realm_proto(r, val.PROTO_MAP))
        o.cls = val.CLS_MAP
        o.elems = try gcvec_new()
        let ov: Gc[JsVal] = o
        var i: u64 = 0
        while i < gcvec_length(items) {
            let e: Gc[JsVal] = gcvec_read[JsVal](items, i)
            let ca: Gc[GcVec] = try interp.args_new(r)
            let o1: bool = try gcvec_append[JsVal](ca, e)
            let iv: Gc[JsVal] = try val.realm_num(r, i as f64)
            let o2: bool = try gcvec_append[JsVal](ca, iv)
            let kv: Gc[JsVal] = try interp.call_function(r, f,
                val.realm_undefined(r), ca)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let at: i64 = coll2_find(r, o, kv, 2)
            var bucket: Gc[JsObj] = gc_null[JsObj]()
            if at >= 0 {
                bucket = val.as_obj(val.elems_get(r, o, (at as u64) + 1))
            } else {
                bucket = try val.array_new(r)
                let bv: Gc[JsVal] = bucket
                let ok: bool = try coll2_add(r, o, kv, bv, true)
            }
            let ok2: bool = try val.elems_push(r, bucket, e)
            bucket.len = bucket.len + 1
            i = i + 1
        }
        return ov
    }
    let o: Gc[JsObj] = val.as_obj(this)
    if (o as u64) == 0 || o.cls != val.CLS_MAP {
        var m: [u8; 25] = "the receiver is not a Map"
        return type_err(r, &m[0], 25)
    }
    let key: Gc[JsVal] = arg(r, args, 0)
    let at: i64 = coll2_find(r, o, key, 2)
    if at >= 0 {
        return val.elems_get(r, o, (at as u64) + 1)
    }
    var v: Gc[JsVal] = arg(r, args, 1)
    if id == N_MP_GETORINSERTC {
        if !val.is_callable(v) {
            var m: [u8; 28] = "the callback is not callable"
            return type_err(r, &m[0], 28)
        }
        let ca: Gc[GcVec] = try interp.args_new(r)
        let ok: bool = try gcvec_append[JsVal](ca, key)
        v = try interp.call_function(r, v, val.realm_undefined(r), ca)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        // The callback may have inserted the key itself.
        let again: i64 = coll2_find(r, o, key, 2)
        if again >= 0 {
            let ok2: bool = try val.elems_set(r, o, (again as u64) + 1, v)
            return v
        }
    }
    let ok3: bool = try coll2_add(r, o, key, v, true)
    return v
}
