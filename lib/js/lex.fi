// ------------------------------------------------------------ Error codes

const E_NONE: u32 = 0
const E_UNTERMINATED_STRING: u32 = 1
const E_UNTERMINATED_COMMENT: u32 = 2
const E_UNTERMINATED_TEMPLATE: u32 = 3
const E_UNTERMINATED_REGEXP: u32 = 4
const E_BAD_ESCAPE: u32 = 5
const E_BAD_NUMBER: u32 = 6
const E_BAD_CHARACTER: u32 = 7
const E_BIGINT: u32 = 8
