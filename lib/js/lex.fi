// The names above as ONE text, separated by a single space. `names_init`
// splits it and interns the parts in exactly this order.
const NAMES_TEXT_LEN: usize = 598

// ------------------------------------------------------------- Token flags

const F_ESCAPED: u32 = 1 // the identifier contained \u
const F_LEGACY_OCT: u32 = 2 // 0123 -- forbidden in strict mode
const F_LEGACY_DEC: u32 = 4 // 08, 09 -- forbidden in strict mode
const F_TPL_HEAD: u32 = 8 // the template piece starts with `
const F_TPL_TAIL: u32 = 16 // the template piece ends with `
