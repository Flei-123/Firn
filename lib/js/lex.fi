// SPDX-License-Identifier: GPL-2.0-only
// lib/js/lex.fi -- the ECMAScript LEXER (ECMA-262, clause 12) in Firn.
//
// It scans ON DEMAND, one token per call, because that is the only honest
// way to do it: ECMAScript has no context free lexical grammar. The same
// slash is a division operator or the start of a regular expression
// depending on which goal symbol the SYNTACTIC grammar is currently asking
// for (12.1: InputElementDiv vs InputElementRegExp), and the closing brace
// of a template substitution is only a brace if the parser is not inside a
// template. Everything that pretends otherwise -- a token array produced in
// advance plus a heuristic over the previous token -- gets `a = b
// /hi/g.exec(c)` wrong. So `lex_next` takes the goal as a parameter, and
// the parser is the one that knows it.
//
// WHAT IS IN HERE
//   * white space and line terminators including the Unicode Zs class,
//     both comment forms, and the record whether a LINE TERMINATOR stood
//     before a token -- that single bit is what automatic semicolon
//     insertion (11.9) is decided on later, in the parser.
//   * identifiers over the real Unicode properties ID_Start/ID_Continue
//     (lib/js/unicode_id.fi, generated), with `\uXXXX` and `\u{...}`
//     escapes and the record that an escape was used (an escaped reserved
//     word is a syntax error, 12.7.2).
//   * all numeric forms of 12.9.3: decimal, hexadecimal, octal, binary,
//     numeric separators, the legacy octal form and the legacy decimal form
//     `08` -- the latter two marked, because they are errors in strict mode
//     only. The value of a decimal literal comes from `strtod`
//     (lib/num/strtod.fi, correctly rounded); the values of the
//     power-of-two radices are computed here BIT EXACTLY with round to
//     nearest even, not by repeated multiplication.
//   * string literals with every escape of 12.9.4 including line
//     continuations, `\xHH`, `\u{...}` and the legacy octal escapes.
//   * template literals: head, middle and tail as separate tokens, with the
//     cooked AND the raw text, and the ES2018 rule that an invalid escape
//     only kills the COOKED value (in a tagged template it becomes
//     `undefined`) instead of being a syntax error.
//   * regular expression literals as a token including the character class
//     rule (a `/` inside `[...]` does not end the literal) and the flag
//     check.
//
// STORAGE. The scanner keeps ONE token in the `Lexer` structure; text
// (identifier names, string values, raw text) goes into pools of UTF-16
// code units. Identifiers are INTERNED right away -- from then on a name is
// a `u32` and every comparison is an integer comparison. The keywords are
// interned first and in a fixed order, so `id < KW_COUNT` decides in one
// comparison whether a name is a reserved word.
import html.mem
import std.num
import std.math
import str.ucd

export {
    Names, names_init, names_free, names_intern, names_intern_ascii,
    names_len, names_off, names_at, names_count, names_equal_ascii,
    Lexer, lex_new, lex_init, lex_free, lex_source, lex_reset,
    lex_set_ascii, lex_set_utf8,
    lex_next, lex_template_continue, lex_regexp_from,
    lex_save, lex_restore,
    lex_pool_at, lex_pool_ptr,
    T_EOF, T_IDENT, T_PRIVATE, T_NUM, T_BIGINT, T_STRING, T_TEMPLATE,
    T_REGEXP, T_PUNCT, T_KEYWORD, T_ERROR,
    GOAL_DIV, GOAL_REGEXP,
    P_LBRACE, P_RBRACE, P_LPAREN, P_RPAREN, P_LBRACK, P_RBRACK, P_DOT,
    P_ELLIPSIS, P_SEMI, P_COMMA, P_LT, P_GT, P_LE, P_GE, P_EQ, P_NE,
    P_SEQ, P_SNE, P_ADD, P_SUB, P_MUL, P_MOD, P_POW, P_INC, P_DEC,
    P_SHL, P_SHR, P_USHR, P_AND, P_OR, P_XOR, P_NOT, P_TILDE, P_ANDAND,
    P_OROR, P_COALESCE, P_QUESTION, P_COLON, P_ASSIGN, P_ADDA, P_SUBA,
    P_MULA, P_MODA, P_POWA, P_SHLA, P_SHRA, P_USHRA, P_ANDA, P_ORA,
    P_XORA, P_ANDANDA, P_ORORA, P_COALESCEA, P_ARROW, P_DIV, P_DIVA,
    P_OPTCHAIN,
    K_AWAIT, K_BREAK, K_CASE, K_CATCH, K_CLASS, K_CONST, K_CONTINUE,
    K_DEBUGGER, K_DEFAULT, K_DELETE, K_DO, K_ELSE, K_ENUM, K_EXPORT,
    K_EXTENDS, K_FALSE, K_FINALLY, K_FOR, K_FUNCTION, K_IF, K_IMPORT,
    K_IN, K_INSTANCEOF, K_NEW, K_NULL, K_RETURN, K_SUPER, K_SWITCH,
    K_THIS, K_THROW, K_TRUE, K_TRY, K_TYPEOF, K_VAR, K_VOID, K_WHILE,
    K_WITH, K_YIELD, KW_COUNT,
    N_LET, N_STATIC, N_IMPLEMENTS, N_INTERFACE, N_PACKAGE, N_PRIVATE,
    N_PROTECTED, N_PUBLIC, N_AS, N_ASYNC, N_FROM, N_GET, N_SET, N_OF,
    N_TARGET, N_ARGUMENTS, N_EVAL, N_UNDEFINED, N_NAN, N_INFINITY,
    N_CONSTRUCTOR, N_PROTOTYPE, N_DUNDER_PROTO, N_LENGTH, N_NAME,
    N_VALUE, N_WRITABLE, N_ENUMERABLE, N_CONFIGURABLE, N_MESSAGE,
    N_TOSTRING, N_VALUEOF, N_CALLEE, N_RAW, N_SIZE, N_INDEX, N_INPUT,
    N_EMPTY, N_ANONYMOUS, N_STACK, N_TOPRIMITIVE, N_ITERATOR, N_NEXT,
    N_DONE, N_DESCRIPTION, N_GLOBALTHIS, N_ARGS_COUNT,
    F_ESCAPED, F_LEGACY_OCT, F_LEGACY_DEC, F_TPL_HEAD, F_TPL_TAIL,
    F_BAD_ESCAPE, F_OCT_ESCAPE, F_HAS_DOT_OR_EXP,
    E_NONE, E_UNTERMINATED_STRING, E_UNTERMINATED_COMMENT,
    E_UNTERMINATED_TEMPLATE, E_UNTERMINATED_REGEXP, E_BAD_ESCAPE,
    E_BAD_NUMBER, E_BAD_CHARACTER, E_BIGINT, E_BAD_FLAGS,
    E_BAD_SEPARATOR, E_IDENT_AFTER_NUMBER,
}

// ------------------------------------------------------------ Token kinds

const T_EOF: u32 = 0
const T_IDENT: u32 = 1
const T_PRIVATE: u32 = 2 // `#name` inside a class
const T_NUM: u32 = 3
const T_STRING: u32 = 4
const T_TEMPLATE: u32 = 5
const T_REGEXP: u32 = 6
const T_PUNCT: u32 = 7
const T_KEYWORD: u32 = 8
const T_ERROR: u32 = 9
const T_BIGINT: u32 = 10 // `123n` -- the digits lie in the pool

// The goal symbol the parser asks for (ECMA-262 12.1).
const GOAL_DIV: u32 = 0
const GOAL_REGEXP: u32 = 1

// -------------------------------------------------------- Punctuator codes

const P_LBRACE: u32 = 1
