// SPDX-License-Identifier: GPL-2.0-only
// lib/js/builtin.fi -- the BUILT IN OBJECTS (ECMA-262 clauses 19-24).
//
// Every built in function is a `CLS_NATIVE` object with a NUMBER, and
// `native_dispatch` is the one place that number is decoded in. That
// construction exists because stage 0 of Firn has no methods on `gc class`
// and because `lib/js/interp.fi` must not import this file -- the
// interpreter calls the dispatcher through a function VALUE that the driver
// installs (round 58 made that possible; before it, this would have had to
// be one giant file).
//
// The objects live in the GC heap like every other JavaScript object. There
// is no special allocation, no pinning and no external root: the collector
// reaches them over the global object, which the realm holds.
//
// WHAT IS DELIBERATELY MISSING is in docs/ROUND63.md -- among it `RegExp`
// (a pattern engine is a round of its own), `Date`, `Promise`, `Proxy`,
// `Reflect`, typed arrays and everything that needs generators.
import html.mem
import str.ucd
import std.math
import std.num
import js.lex
import js.ast
import js.val
import js.interp
import js.bigint
import js.builtin2

export { install, native_dispatch, native_arity_of }

// The numbering of the natives. Grouped by object, so that the dispatcher
// can decide in ranges.
const B_PRINT: u64 = 1
const B_PARSE_INT: u64 = 2
const B_PARSE_FLOAT: u64 = 3
const B_IS_NAN: u64 = 4
const B_IS_FINITE: u64 = 5

const B_OBJECT_CTOR: u64 = 20
const B_OBJ_KEYS: u64 = 21
const B_OBJ_VALUES: u64 = 22
const B_OBJ_ENTRIES: u64 = 23
const B_OBJ_GET_PROTO: u64 = 24
const B_OBJ_SET_PROTO: u64 = 25
const B_OBJ_DEFINE: u64 = 26
const B_OBJ_GOPD: u64 = 27
const B_OBJ_GOPN: u64 = 28
const B_OBJ_CREATE: u64 = 29
const B_OBJ_ASSIGN: u64 = 30
const B_OBJ_FREEZE: u64 = 31
const B_OBJ_IS_FROZEN: u64 = 32
const B_OBJ_PREVENT: u64 = 33
const B_OBJ_IS_EXT: u64 = 34
const B_OBJ_IS: u64 = 35
const B_OBJ_SEAL: u64 = 36
const B_OBJ_IS_SEALED: u64 = 37
const B_OBJ_DEFINE_MANY: u64 = 38

