    var n01: [u8; 6] = "charAt"
    var n02: [u8; 10] = "charCodeAt"
    var n03: [u8; 7] = "indexOf"
    var n04: [u8; 11] = "lastIndexOf"
    var n05: [u8; 8] = "includes"
    var n06: [u8; 10] = "startsWith"
    var n07: [u8; 8] = "endsWith"
    var n08: [u8; 5] = "slice"
    var n09: [u8; 9] = "substring"
    var n10: [u8; 11] = "toUpperCase"
    var n11: [u8; 11] = "toLowerCase"
    var n12: [u8; 4] = "trim"
    var n13: [u8; 5] = "split"
    var n14: [u8; 6] = "concat"
    var n15: [u8; 6] = "repeat"
    var n16: [u8; 8] = "toString"
    var n17: [u8; 7] = "valueOf"
    var n18: [u8; 11] = "codePointAt"
    var n19: [u8; 2] = "at"
    var n20: [u8; 8] = "padStart"
    var n21: [u8; 6] = "padEnd"
    var n22: [u8; 6] = "substr"
    var n23: [u8; 7] = "replace"
    let m01: bool = try nat(r, sp, &n01[0], 6, B_SP_CHARAT, 1)
    let m02: bool = try nat(r, sp, &n02[0], 10, B_SP_CHARCODEAT, 1)
    let m03: bool = try nat(r, sp, &n03[0], 7, B_SP_INDEXOF, 1)
    let m04: bool = try nat(r, sp, &n04[0], 11, B_SP_LASTINDEXOF, 1)
    let m05: bool = try nat(r, sp, &n05[0], 8, B_SP_INCLUDES, 1)
    let m06: bool = try nat(r, sp, &n06[0], 10, B_SP_STARTSWITH, 1)
    let m07: bool = try nat(r, sp, &n07[0], 8, B_SP_ENDSWITH, 1)
    let m08: bool = try nat(r, sp, &n08[0], 5, B_SP_SLICE, 2)
    let m09: bool = try nat(r, sp, &n09[0], 9, B_SP_SUBSTRING, 2)
    let m10: bool = try nat(r, sp, &n10[0], 11, B_SP_TOUPPER, 0)
    let m11: bool = try nat(r, sp, &n11[0], 11, B_SP_TOLOWER, 0)
    let m12: bool = try nat(r, sp, &n12[0], 4, B_SP_TRIM, 0)
    let m13: bool = try nat(r, sp, &n13[0], 5, B_SP_SPLIT, 2)
    let m14: bool = try nat(r, sp, &n14[0], 6, B_SP_CONCAT, 1)
    let m15: bool = try nat(r, sp, &n15[0], 6, B_SP_REPEAT, 1)
    let m16: bool = try nat(r, sp, &n16[0], 8, B_SP_TOSTRING, 0)
    let m17: bool = try nat(r, sp, &n17[0], 7, B_SP_VALUEOF, 0)
    let m18: bool = try nat(r, sp, &n18[0], 11, B_SP_CODEPOINTAT, 1)
    let m19: bool = try nat(r, sp, &n19[0], 2, B_SP_AT, 1)
    let m20: bool = try nat(r, sp, &n20[0], 8, B_SP_PADSTART, 1)
    let m21: bool = try nat(r, sp, &n21[0], 6, B_SP_PADEND, 1)
