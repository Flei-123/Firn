const B_CLASS_CTOR: u64 = 9000

// The Math functions get consecutive numbers after B_MATH_BASE.
const M_ABS: u64 = 0
const M_FLOOR: u64 = 1
const M_CEIL: u64 = 2
const M_ROUND: u64 = 3
const M_TRUNC: u64 = 4
const M_SQRT: u64 = 5
const M_POW: u64 = 6
const M_MIN: u64 = 7
const M_MAX: u64 = 8
const M_SIGN: u64 = 9
const M_EXP: u64 = 10
const M_LOG: u64 = 11
const M_LOG2: u64 = 12
const M_LOG10: u64 = 13
const M_SIN: u64 = 14
const M_COS: u64 = 15
const M_TAN: u64 = 16
const M_ATAN: u64 = 17
const M_ATAN2: u64 = 18
const M_HYPOT: u64 = 19
const M_CBRT: u64 = 20
const M_COUNT: u64 = 21

// 2^53-1, the largest exactly representable integer. It is written as an
// INTEGER and converted, not as the decimal literal `9007199254740991.0`:
// the two lexers of this project disagree on that literal by one unit in
// the last place (docs/ROUND63.md, gap 8), and this way the value is exact
// in both.
fn max_safe_integer() -> f64 {
    let n: u64 = 9007199254740991
    return n as f64
}

fn native_arity_of(id: u64) -> u32 {
    return 1
}

// --------------------------------------------------------------- Helpers

fn nat(r: Gc[Realm], target: Gc[JsObj], name: *mut u8, n: usize, id: u64,
    arity: u64) -> AllocError!bool {
    let f: Gc[JsObj] = try interp.make_native(r, id, arity, name, n)
    let k: u64 = try key_ascii(r, name, n)
    let fv: Gc[JsVal] = f
    return interp.define_value(r, target, k, fv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
}

fn key_ascii(r: Gc[Realm], name: *mut u8, n: usize) -> AllocError!u64 {
    let s: Gc[JsVal] = try val.str_from_ascii(r, name, n)
    return val.key_for_str(r, s)
}

fn put(r: Gc[Realm], target: Gc[JsObj], name: *mut u8, n: usize,
    v: Gc[JsVal], attrs: u64) -> AllocError!bool {
    let k: u64 = try key_ascii(r, name, n)
    return interp.define_value(r, target, k, v, attrs)
}

fn put_num(r: Gc[Realm], target: Gc[JsObj], name: *mut u8, n: usize,
    x: f64, attrs: u64) -> AllocError!bool {
    let v: Gc[JsVal] = try val.realm_num(r, x)
    return put(r, target, name, n, v, attrs)
}

fn arg(r: Gc[Realm], args: Gc[GcVec], i: u64) -> Gc[JsVal] {
    return interp.args_at(r, args, i)
}

fn nargs(args: Gc[GcVec]) -> u64 {
    return gcvec_length(args)
}

fn thrown(r: Gc[Realm]) -> bool {
    let c: *mut interp.Ctx = interp.ctx_of(r)
    return (*c).comp != interp.C_NORMAL
}

fn type_err(r: Gc[Realm], m: *mut u8, n: usize) -> AllocError!Gc[JsVal] {
    return interp.throw_type_here(r, m, n)
}

// The "array like" reading path that Array.prototype uses: a real array
// takes the dense storage, everything else goes through `length` and the
// index properties.
fn alen(r: Gc[Realm], o: Gc[JsVal]) -> AllocError!u64 {
    let ob: Gc[JsObj] = val.as_obj(o)
    if (ob as u64) != 0 && ob.cls == val.CLS_ARRAY {
        return ob.len
    }
    let k: u64 = try val.key_for_name(r, lex.N_LENGTH)
    let lv: Gc[JsVal] = try interp.get_prop(r, o, k)
    return interp.to_length(r, lv)
}

fn aget(r: Gc[Realm], o: Gc[JsVal], i: u64) -> AllocError!Gc[JsVal] {
    let ob: Gc[JsObj] = val.as_obj(o)
    // Above the dense storage the element lies in the property table.
    if (ob as u64) != 0 && ob.cls == val.CLS_ARRAY && i < ob.len && i < val.elems_len(ob) {
        let e: Gc[JsVal] = val.elems_get(r, ob, i)
        if val.is_gap(e) {
            return val.realm_undefined(r)
        }
        return e
    }
    let k: u64 = try val.key_for_index(r, i)
    return interp.get_prop(r, o, k)
}

fn ahas(r: Gc[Realm], o: Gc[JsVal], i: u64) -> AllocError!bool {
    let ob: Gc[JsObj] = val.as_obj(o)
    if (ob as u64) != 0 && ob.cls == val.CLS_ARRAY && i < ob.len && i < val.elems_len(ob) {
        return !val.is_gap(val.elems_get(r, ob, i))
    }
    let k: u64 = try val.key_for_index(r, i)
    return interp.has_prop(r, o, k)
}

fn aset(r: Gc[Realm], o: Gc[JsVal], i: u64, v: Gc[JsVal]) -> AllocError!bool {
    let ob: Gc[JsObj] = val.as_obj(o)
    // Above the dense limit the element does NOT vanish: it goes into the
    // property table like every other key (round 66).
    if (ob as u64) != 0 && ob.cls == val.CLS_ARRAY && val.elems_dense_ok(i) {
        let ok: bool = try val.elems_set(r, ob, i, v)
        if i >= ob.len {
            ob.len = i + 1
        }
        return true
    }
    let k: u64 = try val.key_for_index(r, i)
    return interp.set_prop(r, o, k, v, true)
}

fn new_array_from(r: Gc[Realm], items: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    let a: Gc[JsObj] = try val.array_new(r)
    var i: u64 = 0
    while i < gcvec_length(items) {
        let ok: bool = try val.elems_push(r, a, gcvec_read[JsVal](items, i))
        a.len = a.len + 1
        i = i + 1
    }
    let av: Gc[JsVal] = a
    return av
}

// The `this` of a String/Number/Boolean method: the primitive itself or the
// boxed one.
fn this_prim(r: Gc[Realm], this: Gc[JsVal], want: u64) -> Gc[JsVal] {
    if val.val_tag(this) == want {
        return this
    }
    let o: Gc[JsObj] = val.as_obj(this)
    if (o as u64) != 0 {
        let p: Gc[JsVal] = o.prim
        if val.val_tag(p) == want {
            return p
        }
    }
    return gc_null[JsVal]()
}

// ========================================================== The dispatcher

fn native_dispatch(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    // Round 66 lives in lib/js/gen.fi and is reached through the same
    // function value construction as this table itself.
    // Round 74: the second table.
    if id >= builtin2.B2_BASE && id < builtin2.B2_END {
        return builtin2.dispatch2(r, id, this, args, nt)
    }
    if id >= 30000 {
        let c: *mut interp.Ctx = interp.ctx_of(r)
        let h: fn(Gc[Realm], u64, Gc[JsVal], Gc[GcVec], Gc[JsObj]) -> AllocError!Gc[JsVal] = (*c).gen_native
        return h(r, id, this, args, nt)
    }
    if id >= B_MATH_BASE && id < B_MATH_BASE + M_COUNT {
        return math_fn(r, id - B_MATH_BASE, args)
    }
    if id >= B_ERROR_BASE && id < B_ERROR_BASE + 7 {
        return error_ctor(r, id - B_ERROR_BASE, this, args, nt)
    }
    if id < 20 {
        return global_fn(r, id, args)
    }
    if id < 50 {
        return object_fn(r, id, this, args, nt)
    }
    if id < 60 {
        return function_fn(r, id, this, args)
    }
    if id < 100 {
        return array_fn(r, id, this, args, nt)
    }
    if id < 140 {
        return string_fn(r, id, this, args, nt)
    }
    if id < 160 {
        return number_fn(r, id, this, args, nt)
    }
    if id < 180 {
        return boolean_fn(r, id, this, args, nt)
    }
    if id == B_JSON_STRINGIFY || id == B_JSON_PARSE {
        return json_fn(r, id, args)
    }
    if id == B_EP_TOSTRING {
        return error_to_string(r, this)
    }
    if id >= B_SYMBOL_CTOR && id < B_MAP_CTOR {
        return symbol_fn(r, id, this, args, nt)
    }
    if id >= B_MAP_CTOR && id < B_CLASS_CTOR {
        return collection_fn(r, id, this, args, nt)
    }
    if id == B_CLASS_CTOR {
        // The implicit constructor of a class without one (15.7.14).
        return val.realm_undefined(r)
    }
    var m: [u8; 24] = "native not implemented  "
    return type_err(r, &m[0], 22)
}

fn global_fn(r: Gc[Realm], id: u64, args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    if id == B_PRINT {
        var out: mem.Buf = mem.buf_new()
        mem.buf_init(&out)
        var i: u64 = 0
        while i < nargs(args) {
            if i > 0 {
                mem.buf_push(&out, 32 as u8)
            }
            let s: Gc[JsVal] = try interp.to_string(r, arg(r, args, i))
            if thrown(r) {
                mem.buf_free(&out)
                return val.realm_undefined(r)
            }
            let ok: bool = try utf8_out(&out, s)
            i = i + 1
        }
        mem.buf_push(&out, 10 as u8)
        mem.buf_flush(&out, 1)
        mem.buf_free(&out)
        return val.realm_undefined(r)
    }
    if id == B_IS_NAN {
        let x: f64 = math.math_f64(try interp.to_number(r, arg(r, args, 0)))
        return val.realm_bool(r, math.is_nan(x))
    }
    if id == B_IS_FINITE {
        let x: f64 = math.math_f64(try interp.to_number(r, arg(r, args, 0)))
        return val.realm_bool(r, math.is_finite(x))
    }
    if id == B_PARSE_INT {
        return parse_int(r, args)
    }
    if id == B_PARSE_FLOAT {
        return parse_float(r, args)
    }
    return val.realm_undefined(r)
}

// UTF-16 -> UTF-8 for the output, with surrogate pairs put back together.
fn utf8_out(out: *mut mem.Buf, s: Gc[JsVal]) -> AllocError!bool {
    var i: u64 = 0
    let n: u64 = val.str_len(s)
    while i < n {
        var c: u32 = val.str_at(s, i)
        i = i + 1
        if c >= 0xD800 as u32 && c <= 0xDBFF as u32 && i < n {
            let c2: u32 = val.str_at(s, i)
            if c2 >= 0xDC00 as u32 && c2 <= 0xDFFF as u32 {
                c = 0x10000 as u32 + ((c - 0xD800 as u32) << 10) + (c2 - 0xDC00 as u32)
                i = i + 1
            }
        }
        if c < 0x80 as u32 {
            mem.buf_push(out, c as u8)
        } else if c < 0x800 as u32 {
            mem.buf_push(out, (0xC0 as u32 | (c >> 6)) as u8)
            mem.buf_push(out, (0x80 as u32 | (c & 0x3F as u32)) as u8)
        } else if c < 0x10000 as u32 {
            mem.buf_push(out, (0xE0 as u32 | (c >> 12)) as u8)
            mem.buf_push(out, (0x80 as u32 | ((c >> 6) & 0x3F as u32)) as u8)
            mem.buf_push(out, (0x80 as u32 | (c & 0x3F as u32)) as u8)
        } else {
            mem.buf_push(out, (0xF0 as u32 | (c >> 18)) as u8)
            mem.buf_push(out, (0x80 as u32 | ((c >> 12) & 0x3F as u32)) as u8)
            mem.buf_push(out, (0x80 as u32 | ((c >> 6) & 0x3F as u32)) as u8)
            mem.buf_push(out, (0x80 as u32 | (c & 0x3F as u32)) as u8)
        }
    }
    return true
}

fn parse_int(r: Gc[Realm], args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    let nan: f64 = math.math_f64(0x7FF8000000000000)
    let s: Gc[JsVal] = try interp.to_string(r, arg(r, args, 0))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    var radix: i32 = 0
    if !val.is_undefined(arg(r, args, 1)) {
        radix = try interp.to_int32(r, arg(r, args, 1))
    }
    let n: u64 = val.str_len(s)
    var i: u64 = 0
    while i < n && is_ws(r.ucdtab, val.str_at(s, i)) {
        i = i + 1
    }
    var neg: bool = false
    if i < n {
        let c: u32 = val.str_at(s, i)
        if c == 43 as u32 || c == 45 as u32 {
            neg = c == 45 as u32
            i = i + 1
        }
    }
    var rad: u32 = radix as u32
    if radix == 0 {
        rad = 10
        if i + 1 < n && val.str_at(s, i) == 48 as u32 {
            let c1: u32 = val.str_at(s, i + 1)
            if c1 == 120 as u32 || c1 == 88 as u32 {
                rad = 16
                i = i + 2
            }
        }
    } else {
        if radix < 2 || radix > 36 {
            return val.realm_num(r, nan)
        }
        if rad == 16 as u32 && i + 1 < n && val.str_at(s, i) == 48 as u32 {
            let c1: u32 = val.str_at(s, i + 1)
            if c1 == 120 as u32 || c1 == 88 as u32 {
                i = i + 2
            }
        }
    }
    var acc: f64 = 0.0
    var any: bool = false
    while i < n {
        let d: u32 = dig(val.str_at(s, i))
        if d >= rad {
            break
        }
        acc = acc * (rad as f64) + (d as f64)
        any = true
        i = i + 1
    }
    if !any {
        return val.realm_num(r, nan)
    }
    if neg {
        return val.realm_num(r, math.math_f64(math.math_bits(acc) ^ 0x8000000000000000))
    }
    return val.realm_num(r, acc)
}

fn dig(c: u32) -> u32 {
    if c >= 48 as u32 && c <= 57 as u32 { return c - 48 as u32 }
    if c >= 97 as u32 && c <= 122 as u32 { return c - 87 as u32 }
    if c >= 65 as u32 && c <= 90 as u32 { return c - 55 as u32 }
    return 99
}

// ECMA-262 white space and line terminators: TAB, LF, VT, FF, CR, ZWNBSP,
// the general category Zs, and Zl/Zp (U+2028, U+2029). Since round 95 the
// Unicode part comes out of the generated table
// (generated/unicode_tables.fi) instead of a hand written list.
fn is_ws(t: u64, c: u32) -> bool {
    if c == 9 as u32 || c == 10 as u32 || c == 11 as u32 || c == 12 as u32 {
        return true
    }
    if c == 13 as u32 || c == 32 as u32 || c == 0xFEFF as u32 {
        return true
    }
    if c < 0x80 as u32 {
        return false
    }
    let k: u8 = ucd.ucd_category(t, c)
    return k == ucd.CAT_ZS || k == ucd.CAT_ZL || k == ucd.CAT_ZP
}

fn parse_float(r: Gc[Realm], args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    let nan: f64 = math.math_f64(0x7FF8000000000000)
    let s: Gc[JsVal] = try interp.to_string(r, arg(r, args, 0))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    let n: u64 = val.str_len(s)
    var i: u64 = 0
    while i < n && is_ws(r.ucdtab, val.str_at(s, i)) {
        i = i + 1
    }
    // `Infinity` with a sign.
    var j: u64 = i
    var neg: bool = false
    if j < n {
        let c: u32 = val.str_at(s, j)
        if c == 43 as u32 || c == 45 as u32 {
            neg = c == 45 as u32
            j = j + 1
        }
    }
    if j + 8 <= n {
        var inf: [u8; 8] = "Infinity"
        var same: bool = true
        var k: u64 = 0
        while k < 8 {
            if val.str_at(s, j + k) != inf[k as usize] as u32 {
                same = false
                break
            }
            k = k + 1
        }
        if same {
            if neg {
                return val.realm_num(r, math.math_f64(0xFFF0000000000000))
            }
            return val.realm_num(r, math.math_f64(0x7FF0000000000000))
        }
    }
    var buf: mem.Buf = mem.buf_new()
    mem.buf_init(&buf)
    var k: u64 = i
    while k < n {
        let u: u32 = val.str_at(s, k)
        if u > 127 as u32 {
            break
        }
        mem.buf_push(&buf, u as u8)
        k = k + 1
    }
    var bits: u64 = 0
    let used: usize = num.read_f64_bits(mem.buf_ptr(&buf), mem.buf_len(&buf), &bits)
    mem.buf_free(&buf)
    if used == 0 {
        return val.realm_num(r, nan)
    }
    return val.realm_num(r, math.math_f64(bits))
}

fn math_fn(r: Gc[Realm], which: u64, args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    let nan: f64 = math.math_f64(0x7FF8000000000000)
    if which == M_MIN || which == M_MAX {
        var best: f64 = math.math_f64(0x7FF0000000000000)
        if which == M_MAX {
            best = math.math_f64(0xFFF0000000000000)
        }
        var i: u64 = 0
        var got_nan: bool = false
        while i < nargs(args) {
            let x: f64 = math.math_f64(try interp.to_number(r, arg(r, args, i)))
            if thrown(r) {
                return val.realm_undefined(r)
            }
            if math.is_nan(x) {
                got_nan = true
            }
            if which == M_MIN {
                if x < best {
                    best = x
                }
            } else {
                if x > best {
                    best = x
                }
            }
            i = i + 1
        }
        if got_nan {
            return val.realm_num(r, nan)
        }
        return val.realm_num(r, best)
    }
    if which == M_HYPOT {
        // `Math.hypot()` takes any number of arguments (21.3.2.19).
        var sum: f64 = 0.0
        var i: u64 = 0
        var inf: bool = false
        var isnan: bool = false
        while i < nargs(args) {
            let v: f64 = math.math_f64(try interp.to_number(r, arg(r, args, i)))
            if thrown(r) {
                return val.realm_undefined(r)
            }
            if math.is_infinite(v) {
                inf = true
            } else if math.is_nan(v) {
                isnan = true
            } else {
                sum = sum + v * v
            }
            i = i + 1
        }
        if inf {
            return val.realm_num(r, math.math_f64(0x7FF0000000000000))
        }
        if isnan {
            return val.realm_num(r, nan)
        }
        if sum == 0.0 {
            return val.realm_num(r, 0.0)
        }
        return val.realm_num(r, math.sqrt(sum))
    }
    let x: f64 = math.math_f64(try interp.to_number(r, arg(r, args, 0)))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    // The approximations of `std.math` (exp/ln/sin/sqrt/...) iterate; with
    // NaN or an infinity the iteration never converges and the process
    // hangs. The special values are therefore answered HERE, following
    // 21.3.2, before any of them is called.
    let nn: bool = math.is_nan(x)
    if nn && which != M_SIGN {
        return val.realm_num(r, nan)
    }
    if which == M_SQRT {
        if x < 0.0 { return val.realm_num(r, nan) }
        if x == 0.0 || math.is_infinite(x) { return val.realm_num(r, x) }
    }
    if which == M_EXP && math.is_infinite(x) {
        if x > 0.0 { return val.realm_num(r, x) }
        return val.realm_num(r, 0.0)
    }
    if which == M_LOG || which == M_LOG2 || which == M_LOG10 {
        if x < 0.0 { return val.realm_num(r, nan) }
        if x == 0.0 { return val.realm_num(r, math.math_f64(0xFFF0000000000000)) }
        if math.is_infinite(x) { return val.realm_num(r, x) }
    }
    if which == M_SIN || which == M_COS || which == M_TAN {
        if math.is_infinite(x) { return val.realm_num(r, nan) }
    }
    if which == M_ATAN && math.is_infinite(x) {
        var half: f64 = math.PI() / 2.0
        if x < 0.0 {
            half = math.math_f64(math.math_bits(half) ^ 0x8000000000000000)
        }
        return val.realm_num(r, half)
    }
    if which == M_ABS { return val.realm_num(r, math.fabs(x)) }
    if which == M_FLOOR { return val.realm_num(r, math.floor(x)) }
    if which == M_CEIL { return val.realm_num(r, math.ceil(x)) }
    if which == M_TRUNC { return val.realm_num(r, math.trunc(x)) }
    if which == M_SQRT { return val.realm_num(r, math.sqrt(x)) }
    if which == M_EXP { return val.realm_num(r, math.exp(x)) }
    if which == M_LOG { return val.realm_num(r, math.ln(x)) }
    if which == M_LOG2 { return val.realm_num(r, math.log2(x)) }
    if which == M_LOG10 { return val.realm_num(r, math.log10(x)) }
    if which == M_SIN { return val.realm_num(r, math.sin(x)) }
    if which == M_COS { return val.realm_num(r, math.cos(x)) }
    if which == M_TAN { return val.realm_num(r, math.tan(x)) }
    if which == M_ATAN { return val.realm_num(r, math.atan(x)) }
    if which == M_ROUND {
        // ECMAScript rounds half UP, not to even (21.3.2.28).
        if math.is_nan(x) || math.is_infinite(x) {
            return val.realm_num(r, x)
        }
        let f: f64 = math.floor(x + 0.5)
        if f == 0.0 && x < 0.0 {
            return val.realm_num(r, math.math_f64(0x8000000000000000))
        }
        return val.realm_num(r, f)
    }
    if which == M_SIGN {
        if math.is_nan(x) {
            return val.realm_num(r, nan)
        }
        if x > 0.0 {
            return val.realm_num(r, 1.0)
        }
        if x < 0.0 {
            return val.realm_num(r, 0.0 - 1.0)
        }
        return val.realm_num(r, x)
    }
    if which == M_CBRT {
        if x == 0.0 || math.is_nan(x) || math.is_infinite(x) {
            return val.realm_num(r, x)
        }
        if x < 0.0 {
            let p: f64 = math.powf(0.0 - x, 1.0 / 3.0)
            return val.realm_num(r, math.math_f64(math.math_bits(p) ^ 0x8000000000000000))
        }
        return val.realm_num(r, math.powf(x, 1.0 / 3.0))
    }
    let y: f64 = math.math_f64(try interp.to_number(r, arg(r, args, 1)))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    if math.is_nan(y) && which != M_POW {
        return val.realm_num(r, nan)
    }
    if which == M_POW { return val.realm_num(r, interp.js_pow_pub(x, y)) }
    if which == M_ATAN2 {
        if math.is_infinite(x) || math.is_infinite(y) {
            return val.realm_num(r, nan)
        }
        return val.realm_num(r, math.atan2(x, y))
    }
    return val.realm_num(r, nan)
}

// -------------------------------------------------------------- Object

fn object_fn(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if id == B_OBJECT_CTOR {
        let v: Gc[JsVal] = arg(r, args, 0)
        if val.is_nullish(v) {
            let o: Gc[JsObj] = try val.obj_new(r)
            let ov: Gc[JsVal] = o
            return ov
        }
        let o: Gc[JsObj] = try interp.to_object(r, v)
        let ov: Gc[JsVal] = o
        return ov
    }
    if id == B_OP_TOSTRING {
        return object_to_string(r, this)
    }
    if id == B_OP_TOLOCALE {
        return interp.call_method(r, this, lex.N_TOSTRING, try interp.args_new(r))
    }
    if id == B_OP_VALUEOF {
        let o: Gc[JsObj] = try interp.to_object(r, this)
        let ov: Gc[JsVal] = o
        return ov
    }
    if id == B_OP_HASOWN {
        let k: u64 = try interp.to_property_key(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let o: Gc[JsObj] = try interp.to_object(r, this)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        if val.obj_has_own(o, k) {
            return val.realm_bool(r, true)
        }
        if o.cls == val.CLS_ARRAY || o.cls == val.CLS_ARGUMENTS || o.cls == val.CLS_STRING {
            let i: i64 = val.index_of_key(r, k)
            if i >= 0 {
                if o.cls == val.CLS_STRING {
                    return val.realm_bool(r, (i as u64) < val.str_len(o.prim))
                }
                if (i as u64) < val.elems_len(o) {
                    return val.realm_bool(r,
                        !val.is_gap(val.elems_get(r, o, i as u64)))
                }
            }
            if o.cls == val.CLS_ARRAY {
                let lk: u64 = try val.key_for_name(r, lex.N_LENGTH)
                if k == lk {
                    return val.realm_bool(r, true)
                }
            }
        }
        return val.realm_bool(r, false)
    }
    if id == B_OP_ISPROTOOF {
        let v: Gc[JsVal] = arg(r, args, 0)
        if val.val_tag(v) != val.TAG_OBJ {
            return val.realm_bool(r, false)
        }
        let me: Gc[JsObj] = try interp.to_object(r, this)
        var o: Gc[JsObj] = val.obj_proto(val.as_obj(v))
        while (o as u64) != 0 {
            if (o as u64) == (me as u64) {
                return val.realm_bool(r, true)
            }
            o = val.obj_proto(o)
        }
        return val.realm_bool(r, false)
    }
    if id == B_OP_PROPENUM {
        let k: u64 = try interp.to_property_key(r, arg(r, args, 0))
        let o: Gc[JsObj] = try interp.to_object(r, this)
        let p: Gc[Prop] = val.obj_get_own(o, k)
        if (p as u64) == 0 {
            if o.cls == val.CLS_ARRAY {
                let i: i64 = val.index_of_key(r, k)
                if i >= 0 && (i as u64) < val.elems_len(o) {
                    return val.realm_bool(r,
                        !val.is_gap(val.elems_get(r, o, i as u64)))
                }
            }
            return val.realm_bool(r, false)
        }
        return val.realm_bool(r, val.prop_attrs(p) & val.A_ENUMERABLE != 0)
    }
    if id == B_OBJ_KEYS || id == B_OBJ_VALUES || id == B_OBJ_ENTRIES {
        let o: Gc[JsObj] = try interp.to_object(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let ov: Gc[JsVal] = o
        let keys: Gc[GcVec] = try val.obj_own_string_keys(r, o)
        let out: Gc[GcVec] = try interp.args_new(r)
        var i: u64 = 0
        while i < gcvec_length(keys) {
            let k: u64 = gcvec_read_raw(keys, i)
            var enumerable: bool = true
            let p: Gc[Prop] = val.obj_get_own(o, k)
            if (p as u64) != 0 {
                enumerable = val.prop_attrs(p) & val.A_ENUMERABLE != 0
            }
            if enumerable {
                if id == B_OBJ_KEYS {
                    let ok: bool = try gcvec_append[JsVal](out,
                        val.key_name_str(r, k))
                } else {
                    let pv: Gc[JsVal] = try interp.get_prop(r, ov, k)
                    if thrown(r) {
                        return val.realm_undefined(r)
                    }
                    if id == B_OBJ_VALUES {
                        let ok: bool = try gcvec_append[JsVal](out, pv)
                    } else {
                        let pair: Gc[JsObj] = try val.array_new(r)
                        let ok1: bool = try val.elems_push(r, pair,
                            val.key_name_str(r, k))
                        let ok2: bool = try val.elems_push(r, pair, pv)
                        pair.len = 2
                        let pvv: Gc[JsVal] = pair
                        let ok3: bool = try gcvec_append[JsVal](out, pvv)
                    }
                }
            }
            i = i + 1
        }
        return new_array_from(r, out)
    }
    if id == B_OBJ_GOPN {
        let o: Gc[JsObj] = try interp.to_object(r, arg(r, args, 0))
        let keys: Gc[GcVec] = try val.obj_own_string_keys(r, o)
        let out: Gc[GcVec] = try interp.args_new(r)
        var i: u64 = 0
        while i < gcvec_length(keys) {
            let ok: bool = try gcvec_append[JsVal](out,
                val.key_name_str(r, gcvec_read_raw(keys, i)))
            i = i + 1
        }
        if o.cls == val.CLS_ARRAY {
            var ln: [u8; 6] = "length"
            let lv: Gc[JsVal] = try val.str_from_ascii(r, &ln[0], 6)
            let ok: bool = try gcvec_append[JsVal](out, lv)
        }
        return new_array_from(r, out)
    }
    if id == B_OBJ_GET_PROTO {
        let o: Gc[JsObj] = try interp.to_object(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let p: Gc[JsObj] = val.obj_proto(o)
        if (p as u64) == 0 {
            return val.realm_null(r)
        }
        let pv: Gc[JsVal] = p
        return pv
    }
    if id == B_OBJ_SET_PROTO {
        let v: Gc[JsVal] = arg(r, args, 0)
        let pv: Gc[JsVal] = arg(r, args, 1)
        let o: Gc[JsObj] = val.as_obj(v)
        if (o as u64) != 0 {
            if val.is_null(pv) {
                val.obj_set_proto(o, gc_null[JsObj]())
            } else if val.val_tag(pv) == val.TAG_OBJ {
                val.obj_set_proto(o, val.as_obj(pv))
            }
        }
        return v
    }
    if id == B_OBJ_CREATE {
        let pv: Gc[JsVal] = arg(r, args, 0)
        if !val.is_null(pv) && val.val_tag(pv) != val.TAG_OBJ {
            var m: [u8; 33] = "Object prototype may only be an o"
            return type_err(r, &m[0], 33)
        }
        var proto: Gc[JsObj] = gc_null[JsObj]()
        if val.val_tag(pv) == val.TAG_OBJ {
            proto = val.as_obj(pv)
        }
        let o: Gc[JsObj] = try val.obj_new_proto(r, proto)
        let ov: Gc[JsVal] = o
        if val.val_tag(arg(r, args, 1)) == val.TAG_OBJ {
            let ok: bool = try define_many(r, o, arg(r, args, 1))
        }
        return ov
    }
    if id == B_OBJ_DEFINE {
        let ov: Gc[JsVal] = arg(r, args, 0)
        if val.val_tag(ov) != val.TAG_OBJ {
            var m: [u8; 32] = "Object.defineProperty on a non o"
            return type_err(r, &m[0], 32)
        }
        let k: u64 = try interp.to_property_key(r, arg(r, args, 1))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let ok: bool = try apply_descriptor(r, val.as_obj(ov), k, arg(r, args, 2))
        return ov
    }
    if id == B_OBJ_DEFINE_MANY {
        let ov: Gc[JsVal] = arg(r, args, 0)
        if val.val_tag(ov) != val.TAG_OBJ {
            var m: [u8; 34] = "Object.defineProperties on a non o"
            return type_err(r, &m[0], 34)
        }
        let ok: bool = try define_many(r, val.as_obj(ov), arg(r, args, 1))
        return ov
    }
    if id == B_OBJ_GOPD {
        let ov: Gc[JsVal] = arg(r, args, 0)
        let o: Gc[JsObj] = try interp.to_object(r, ov)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let k: u64 = try interp.to_property_key(r, arg(r, args, 1))
        let p: Gc[Prop] = val.obj_get_own(o, k)
        if (p as u64) == 0 {
            return val.realm_undefined(r)
        }
        return describe(r, p)
    }
    if id == B_OBJ_ASSIGN {
        let target: Gc[JsObj] = try interp.to_object(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let tv: Gc[JsVal] = target
        var i: u64 = 1
        while i < nargs(args) {
            let sv: Gc[JsVal] = arg(r, args, i)
            if !val.is_nullish(sv) {
                let src: Gc[JsObj] = try interp.to_object(r, sv)
                let keys: Gc[GcVec] = try val.obj_own_string_keys(r, src)
                var j: u64 = 0
                while j < gcvec_length(keys) {
                    let k: u64 = gcvec_read_raw(keys, j)
                    var enumerable: bool = true
                    let p: Gc[Prop] = val.obj_get_own(src, k)
                    if (p as u64) != 0 {
                        enumerable = val.prop_attrs(p) & val.A_ENUMERABLE != 0
                    }
                    if enumerable {
                        let pv: Gc[JsVal] = try interp.get_prop(r, sv, k)
                        if thrown(r) {
                            return val.realm_undefined(r)
                        }
                        let ok: bool = try interp.set_prop(r, tv, k, pv, true)
                        if thrown(r) {
                            return val.realm_undefined(r)
                        }
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
        return tv
    }
    if id == B_OBJ_FREEZE || id == B_OBJ_SEAL || id == B_OBJ_PREVENT {
        let ov: Gc[JsVal] = arg(r, args, 0)
        let o: Gc[JsObj] = val.as_obj(ov)
        if (o as u64) == 0 {
            return ov
        }
        o.flags = o.flags & (0xFFFFFFFFFFFFFFFF - val.F_EXTENSIBLE)
        if id != B_OBJ_PREVENT {
            var i: u64 = 0
            while i < val.obj_key_count(o) {
                let p: Gc[Prop] = val.obj_get_own(o, val.obj_key_at(o, i))
                if (p as u64) != 0 {
                    var a: u64 = val.prop_attrs(p)
                    a = a & (0xFFFFFFFFFFFFFFFF - val.A_CONFIGURABLE)
                    if id == B_OBJ_FREEZE && a & val.A_ACCESSOR == 0 {
                        a = a & (0xFFFFFFFFFFFFFFFF - val.A_WRITABLE)
                    }
                    val.prop_set_attrs(p, a)
                }
                i = i + 1
            }
        }
        return ov
    }
    if id == B_OBJ_IS_FROZEN || id == B_OBJ_IS_SEALED {
        let o: Gc[JsObj] = val.as_obj(arg(r, args, 0))
        if (o as u64) == 0 {
            return val.realm_bool(r, true)
        }
        if o.flags & val.F_EXTENSIBLE != 0 {
            return val.realm_bool(r, false)
        }
        var i: u64 = 0
        while i < val.obj_key_count(o) {
            let p: Gc[Prop] = val.obj_get_own(o, val.obj_key_at(o, i))
            if (p as u64) != 0 {
                let a: u64 = val.prop_attrs(p)
                if a & val.A_CONFIGURABLE != 0 {
                    return val.realm_bool(r, false)
                }
                if id == B_OBJ_IS_FROZEN && a & val.A_ACCESSOR == 0 && a & val.A_WRITABLE != 0 {
                    return val.realm_bool(r, false)
                }
            }
            i = i + 1
        }
        return val.realm_bool(r, true)
    }
    if id == B_OBJ_IS_EXT {
        let o: Gc[JsObj] = val.as_obj(arg(r, args, 0))
        if (o as u64) == 0 {
            return val.realm_bool(r, false)
        }
        return val.realm_bool(r, o.flags & val.F_EXTENSIBLE != 0)
    }
    if id == B_OBJ_IS {
        return val.realm_bool(r,
            interp.same_value(r, arg(r, args, 0), arg(r, args, 1)))
    }
    return val.realm_undefined(r)
}

fn object_to_string(r: Gc[Realm], this: Gc[JsVal]) -> AllocError!Gc[JsVal] {
    let t: u64 = val.val_tag(this)
    if t == val.TAG_UNDEF {
        var m: [u8; 18] = "[object Undefined]"
        return val.str_from_ascii(r, &m[0], 18)
    }
    if t == val.TAG_NULL {
        var m: [u8; 13] = "[object Null]"
        return val.str_from_ascii(r, &m[0], 13)
    }
    let o: Gc[JsObj] = try interp.to_object(r, this)
    var tag: [u8; 6] = "Object"
    var n: usize = 6
    // Round 74: `Symbol.toStringTag` wins over the built in name (20.1.3.6
    // step 15), and it is only taken when it really is a text.
    let wk: Gc[JsVal] = val.realm_well_known(r, val.WELL_KNOWN_TOSTRINGTAG)
    if (wk as u64) != 0 {
        let ov: Gc[JsVal] = o
        let tv: Gc[JsVal] = try interp.get_prop(r, ov, val.key_for_symbol(wk))
        if thrown(r) {
            return val.str_empty(r)
        }
        if val.val_tag(tv) == val.TAG_STR {
            let head: Gc[JsVal] = try val.str_from_ascii(r, &tag[0], 0)
            var pre: [u8; 8] = "[object "
            var post: [u8; 1] = "]"
            let a: Gc[JsVal] = try val.str_from_ascii(r, &pre[0], 8)
            let b: Gc[JsVal] = try val.str_concat(r, a, tv)
            let c: Gc[JsVal] = try val.str_from_ascii(r, &post[0], 1)
            return val.str_concat(r, b, c)
        }
    }
    if o.cls == val.CLS_ARRAY {
        var t2: [u8; 5] = "Array"
        return wrap_tag(r, &t2[0], 5)
    }
    if o.cls == val.CLS_FUNCTION || o.cls == val.CLS_NATIVE || o.cls == val.CLS_BOUND {
        var t3: [u8; 8] = "Function"
        return wrap_tag(r, &t3[0], 8)
    }
    if o.cls == val.CLS_ERROR {
        var t4: [u8; 5] = "Error"
        return wrap_tag(r, &t4[0], 5)
    }
    if o.cls == val.CLS_STRING {
        var t5: [u8; 6] = "String"
        return wrap_tag(r, &t5[0], 6)
    }
    if o.cls == val.CLS_NUMBER {
        var t6: [u8; 6] = "Number"
        return wrap_tag(r, &t6[0], 6)
    }
    if o.cls == val.CLS_BOOLEAN {
        var t7: [u8; 7] = "Boolean"
        return wrap_tag(r, &t7[0], 7)
    }
    if o.cls == val.CLS_ARGUMENTS {
        var t8: [u8; 9] = "Arguments"
        return wrap_tag(r, &t8[0], 9)
    }
    if o.cls == val.CLS_DATE {
        var t9: [u8; 4] = "Date"
        return wrap_tag(r, &t9[0], 4)
    }
    if o.cls == val.CLS_REGEXP {
        var t10: [u8; 6] = "RegExp"
        return wrap_tag(r, &t10[0], 6)
    }
    return wrap_tag(r, &tag[0], n)
}

fn wrap_tag(r: Gc[Realm], p: *mut u8, n: usize) -> AllocError!Gc[JsVal] {
    var head: [u8; 8] = "[object "
    let h: Gc[JsVal] = try val.str_from_ascii(r, &head[0], 8)
    let b: Gc[JsVal] = try val.str_from_ascii(r, p, n)
    var tail: [u8; 1] = "]"
    let t: Gc[JsVal] = try val.str_from_ascii(r, &tail[0], 1)
    let x: Gc[JsVal] = try val.str_concat(r, h, b)
    return val.str_concat(r, x, t)
}

fn describe(r: Gc[Realm], p: Gc[Prop]) -> AllocError!Gc[JsVal] {
    let d: Gc[JsObj] = try val.obj_new(r)
    let a: u64 = val.prop_attrs(p)
    if a & val.A_ACCESSOR != 0 {
        var g: [u8; 3] = "get"
        var s: [u8; 3] = "set"
        let ok1: bool = try put(r, d, &g[0], 3, val.prop_value(p), val.A_DEFAULT)
        let ok2: bool = try put(r, d, &s[0], 3, val.prop_setter(p), val.A_DEFAULT)
    } else {
        var v: [u8; 5] = "value"
        var w: [u8; 8] = "writable"
        let ok1: bool = try put(r, d, &v[0], 5, val.prop_value(p), val.A_DEFAULT)
        let ok2: bool = try put(r, d, &w[0], 8,
            val.realm_bool(r, a & val.A_WRITABLE != 0), val.A_DEFAULT)
    }
    var e: [u8; 10] = "enumerable"
    var c: [u8; 12] = "configurable"
    let ok3: bool = try put(r, d, &e[0], 10,
        val.realm_bool(r, a & val.A_ENUMERABLE != 0), val.A_DEFAULT)
    let ok4: bool = try put(r, d, &c[0], 12,
        val.realm_bool(r, a & val.A_CONFIGURABLE != 0), val.A_DEFAULT)
    let dv: Gc[JsVal] = d
    return dv
}

// 10.1.6.3 ValidateAndApplyPropertyDescriptor. The work itself moved to
// `lib/js/builtin2.fi` in round 74, because `Reflect.defineProperty` needs
// exactly the same thing but ANSWERS instead of throwing.
fn apply_descriptor(r: Gc[Realm], o: Gc[JsObj], k: u64,
    desc: Gc[JsVal]) -> AllocError!bool {
    return builtin2.apply_descriptor(r, o, k, desc, true)
}

fn has_key(r: Gc[Realm], o: Gc[JsVal], p: *mut u8, n: usize) -> AllocError!bool {
    let k: u64 = try key_ascii(r, p, n)
    return interp.has_prop(r, o, k)
}

fn get_key(r: Gc[Realm], o: Gc[JsVal], p: *mut u8,
    n: usize) -> AllocError!Gc[JsVal] {
    let k: u64 = try key_ascii(r, p, n)
    return interp.get_prop(r, o, k)
}

fn define_many(r: Gc[Realm], o: Gc[JsObj], src: Gc[JsVal]) -> AllocError!bool {
    let s: Gc[JsObj] = try interp.to_object(r, src)
    let keys: Gc[GcVec] = try val.obj_own_string_keys(r, s)
    var i: u64 = 0
    while i < gcvec_length(keys) {
        let k: u64 = gcvec_read_raw(keys, i)
        let d: Gc[JsVal] = try interp.get_prop(r, src, k)
        if thrown(r) {
            return false
        }
        let ok: bool = try apply_descriptor(r, o, k, d)
        if thrown(r) {
            return false
        }
        i = i + 1
    }
    return true
}

// ------------------------------------------------------------- Function

fn function_fn(r: Gc[Realm], id: u64, this: Gc[JsVal],
    args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    if id == B_FUNC_CALL {
        if !val.is_callable(this) {
            var m: [u8; 32] = "Function.prototype.call on a non"
            return type_err(r, &m[0], 32)
        }
        let rest: Gc[GcVec] = try interp.args_new(r)
        var i: u64 = 1
        while i < nargs(args) {
            let ok: bool = try gcvec_append[JsVal](rest, arg(r, args, i))
            i = i + 1
        }
        return interp.call_function(r, this, arg(r, args, 0), rest)
    }
    if id == B_FUNC_APPLY {
        if !val.is_callable(this) {
            var m: [u8; 33] = "Function.prototype.apply on a non"
            return type_err(r, &m[0], 33)
        }
        let list: Gc[JsVal] = arg(r, args, 1)
        let rest: Gc[GcVec] = try interp.args_new(r)
        if !val.is_nullish(list) {
            let n: u64 = try alen(r, list)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            var i: u64 = 0
            while i < n {
                let e: Gc[JsVal] = try aget(r, list, i)
                if thrown(r) {
                    return val.realm_undefined(r)
                }
                let ok: bool = try gcvec_append[JsVal](rest, e)
                i = i + 1
            }
        }
        return interp.call_function(r, this, arg(r, args, 0), rest)
    }
    if id == B_FUNC_BIND {
        if !val.is_callable(this) {
            var m: [u8; 32] = "Function.prototype.bind on a non"
            return type_err(r, &m[0], 32)
        }
        let b: Gc[JsObj] = try val.obj_new_proto(r,
            val.realm_proto(r, val.PROTO_FUNCTION))
        b.cls = val.CLS_BOUND
        b.flags = val.F_EXTENSIBLE | val.F_STRICT | val.F_CTOR
        b.prim = this
        b.extra = val.as_obj(arg(r, args, 0))
        b.elems = try gcvec_new()
        var i: u64 = 1
        while i < nargs(args) {
            let ok: bool = try gcvec_append[JsVal](b.elems, arg(r, args, i))
            i = i + 1
        }
        // `length` = max(0, target.length - bound arguments)
        let lk: u64 = try val.key_for_name(r, lex.N_LENGTH)
        let tl: Gc[JsVal] = try interp.get_prop(r, this, lk)
        var n: f64 = math.math_f64(try interp.to_number(r, tl))
        if math.is_nan(n) {
            n = 0.0
        }
        n = n - ((nargs(args) - 1) as f64)
        if n < 0.0 {
            n = 0.0
        }
        let lv: Gc[JsVal] = try val.realm_num(r, n)
        let ok1: bool = try interp.define_value(r, b, lk, lv, val.A_CONFIGURABLE)
        let nk: u64 = try val.key_for_name(r, lex.N_NAME)
        let tn: Gc[JsVal] = try interp.get_prop(r, this, nk)
        var head: [u8; 6] = "bound "
        let h: Gc[JsVal] = try val.str_from_ascii(r, &head[0], 6)
        var nv: Gc[JsVal] = h
        if val.val_tag(tn) == val.TAG_STR {
            nv = try val.str_concat(r, h, tn)
        }
        let ok2: bool = try interp.define_value(r, b, nk, nv, val.A_CONFIGURABLE)
        let bv: Gc[JsVal] = b
        return bv
    }
    if id == B_FUNC_TOSTRING {
        if !val.is_callable(this) {
            var m: [u8; 36] = "Function.prototype.toString on a non"
            return type_err(r, &m[0], 36)
        }
        let nk: u64 = try val.key_for_name(r, lex.N_NAME)
        let n: Gc[JsVal] = try interp.get_prop(r, this, nk)
        var head: [u8; 9] = "function "
        var tail: [u8; 13] = "() { [code] }"
        let h: Gc[JsVal] = try val.str_from_ascii(r, &head[0], 9)
        let t: Gc[JsVal] = try val.str_from_ascii(r, &tail[0], 13)
        let s: Gc[JsVal] = try interp.to_string(r, n)
        let a: Gc[JsVal] = try val.str_concat(r, h, s)
        return val.str_concat(r, a, t)
    }
    if id == B_FUNC_CTOR {
        var m: [u8; 39] = "the Function constructor needs eval    "
        return type_err(r, &m[0], 35)
    }
    return val.realm_undefined(r)
}

// --------------------------------------------------------------- Errors

fn error_ctor(r: Gc[Realm], which: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    var proto: u64 = val.PROTO_ERROR
    if which == 1 { proto = val.PROTO_TYPE_ERROR }
    if which == 2 { proto = val.PROTO_RANGE_ERROR }
    if which == 3 { proto = val.PROTO_SYNTAX_ERROR }
    if which == 4 { proto = val.PROTO_REFERENCE_ERROR }
    if which == 5 { proto = val.PROTO_EVAL_ERROR }
    if which == 6 { proto = val.PROTO_URI_ERROR }
    var use: Gc[JsObj] = val.realm_proto(r, proto)
    if (nt as u64) != 0 {
        let pk: u64 = try val.key_for_name(r, lex.N_PROTOTYPE)
        let pv: Gc[JsVal] = try interp.get_prop(r, nt, pk)
        if val.val_tag(pv) == val.TAG_OBJ {
            use = val.as_obj(pv)
        }
    }
    let o: Gc[JsObj] = try val.obj_new_proto(r, use)
    o.cls = val.CLS_ERROR
    let mv: Gc[JsVal] = arg(r, args, 0)
    if !val.is_undefined(mv) {
        let s: Gc[JsVal] = try interp.to_string(r, mv)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let k: u64 = try val.key_for_name(r, lex.N_MESSAGE)
        let ok: bool = try interp.define_value(r, o, k, s,
            val.A_WRITABLE | val.A_CONFIGURABLE)
    }
    // Round 74: the `cause` option of ES2022 (20.5.8.1).
    let okc: bool = try builtin2.install_cause(r, o, arg(r, args, 1))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    let ov: Gc[JsVal] = o
    return ov
}

fn error_to_string(r: Gc[Realm], this: Gc[JsVal]) -> AllocError!Gc[JsVal] {
    if val.val_tag(this) != val.TAG_OBJ {
        var m: [u8; 33] = "Error.prototype.toString on a non"
        return type_err(r, &m[0], 33)
    }
    let nk: u64 = try val.key_for_name(r, lex.N_NAME)
    let mk: u64 = try val.key_for_name(r, lex.N_MESSAGE)
    let nv: Gc[JsVal] = try interp.get_prop(r, this, nk)
    let mv: Gc[JsVal] = try interp.get_prop(r, this, mk)
    var name: Gc[JsVal] = val.str_empty(r)
    if val.is_undefined(nv) {
        var e: [u8; 5] = "Error"
        name = try val.str_from_ascii(r, &e[0], 5)
    } else {
        name = try interp.to_string(r, nv)
    }
    var msg: Gc[JsVal] = val.str_empty(r)
    if !val.is_undefined(mv) {
        msg = try interp.to_string(r, mv)
    }
    if val.str_len(msg) == 0 {
        return name
    }
    if val.str_len(name) == 0 {
        return msg
    }
    var sep: [u8; 2] = ": "
    let s: Gc[JsVal] = try val.str_from_ascii(r, &sep[0], 2)
    let a: Gc[JsVal] = try val.str_concat(r, name, s)
    return val.str_concat(r, a, msg)
}

// -------------------------------------------------------------- Symbols

fn symbol_fn(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if id == B_SYMBOL_CTOR {
        if (nt as u64) != 0 {
            var m: [u8; 30] = "Symbol is not a constructor   "
            return type_err(r, &m[0], 27)
        }
        var d: Gc[JsVal] = val.realm_undefined(r)
        if !val.is_undefined(arg(r, args, 0)) {
            d = try interp.to_string(r, arg(r, args, 0))
        }
        return val.sym_new(r, d)
    }
    let s: Gc[JsVal] = this_prim(r, this, val.TAG_SYM)
    if (s as u64) == 0 {
        var m: [u8; 27] = "not a Symbol               "
        return type_err(r, &m[0], 12)
    }
    if id == B_SYP_VALUEOF {
        return s
    }
    var head: [u8; 7] = "Symbol("
    var tail: [u8; 1] = ")"
    let h: Gc[JsVal] = try val.str_from_ascii(r, &head[0], 7)
    let t: Gc[JsVal] = try val.str_from_ascii(r, &tail[0], 1)
    var d: Gc[JsVal] = val.sym_desc(s)
    if val.val_tag(d) != val.TAG_STR {
        d = val.str_empty(r)
    }
    let a: Gc[JsVal] = try val.str_concat(r, h, d)
    return val.str_concat(r, a, t)
}

// ---------------------------------------------------------------- Array

fn array_fn(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if id == B_ARRAY_CTOR {
        let a: Gc[JsObj] = try val.array_new(r)
        if nargs(args) == 1 && val.val_tag(arg(r, args, 0)) == val.TAG_NUM {
            let x: f64 = val.num_value(arg(r, args, 0))
            let n: u64 = x as u64
            if (n as f64) != x || x < 0.0 || x > 4294967295.0 {
                var m: [u8; 20] = "Invalid array length"
                return interp.throw_error(r, interp.ERR_RANGE, &m[0], 20)
            }
            let ok: bool = try val.array_set_length(r, a, n)
        } else {
            var i: u64 = 0
            while i < nargs(args) {
                let ok: bool = try val.elems_push(r, a, arg(r, args, i))
                a.len = a.len + 1
                i = i + 1
            }
        }
        let av: Gc[JsVal] = a
        return av
    }
    if id == B_ARR_ISARRAY {
        return val.realm_bool(r, interp.is_array(arg(r, args, 0)))
    }
    if id == B_ARR_OF {
        return new_array_from(r, args)
    }
    if id == B_ARR_FROM {
        let src: Gc[JsVal] = arg(r, args, 0)
        let f: Gc[JsVal] = arg(r, args, 1)
        var items: Gc[GcVec] = gc_null[GcVec]()
        let o: Gc[JsObj] = val.as_obj(src)
        if val.val_tag(src) == val.TAG_STR || ((o as u64) != 0 && o.cls == val.CLS_ARRAY) {
            items = try interp.iterate_values(r, src)
        } else {
            items = try interp.args_new(r)
            let n: u64 = try alen(r, src)
            var i: u64 = 0
            while i < n {
                let e: Gc[JsVal] = try aget(r, src, i)
                let ok: bool = try gcvec_append[JsVal](items, e)
                i = i + 1
            }
        }
        if thrown(r) {
            return val.realm_undefined(r)
        }
        if val.is_callable(f) {
            let out: Gc[GcVec] = try interp.args_new(r)
            var i: u64 = 0
            while i < gcvec_length(items) {
                let ca: Gc[GcVec] = try interp.args_new(r)
                let ok1: bool = try gcvec_append[JsVal](ca,
                    gcvec_read[JsVal](items, i))
                let iv: Gc[JsVal] = try val.realm_num(r, i as f64)
                let ok2: bool = try gcvec_append[JsVal](ca, iv)
                let v: Gc[JsVal] = try interp.call_function(r, f,
                    arg(r, args, 2), ca)
                if thrown(r) {
                    return val.realm_undefined(r)
                }
                let ok3: bool = try gcvec_append[JsVal](out, v)
                i = i + 1
            }
            return new_array_from(r, out)
        }
        return new_array_from(r, items)
    }
    // From here on `this` is the array like receiver.
    if val.is_nullish(this) {
        var m: [u8; 35] = "Array.prototype method on undefined"
        return type_err(r, &m[0], 34)
    }
    let n: u64 = try alen(r, this)
    if thrown(r) {
        return val.realm_undefined(r)
    }
    let self: Gc[JsObj] = val.as_obj(this)
    if id == B_AP_PUSH {
        var i: u64 = 0
        while i < nargs(args) {
            let ok: bool = try aset(r, this, n + i, arg(r, args, i))
            i = i + 1
        }
        let nn: u64 = n + nargs(args)
        if (self as u64) != 0 && self.cls != val.CLS_ARRAY {
            let lk: u64 = try val.key_for_name(r, lex.N_LENGTH)
            let lv: Gc[JsVal] = try val.realm_num(r, nn as f64)
            let ok: bool = try interp.set_prop(r, this, lk, lv, true)
        }
        return val.realm_num(r, nn as f64)
    }
    if id == B_AP_POP {
        if n == 0 {
            return val.realm_undefined(r)
        }
        let v: Gc[JsVal] = try aget(r, this, n - 1)
        if (self as u64) != 0 && self.cls == val.CLS_ARRAY {
            let ok: bool = try val.array_set_length(r, self, n - 1)
        }
        return v
    }
    if id == B_AP_SHIFT {
        if n == 0 {
            return val.realm_undefined(r)
        }
        let v: Gc[JsVal] = try aget(r, this, 0)
        var i: u64 = 1
        while i < n {
            let e: Gc[JsVal] = try aget(r, this, i)
            let ok: bool = try aset(r, this, i - 1, e)
            i = i + 1
        }
        if (self as u64) != 0 && self.cls == val.CLS_ARRAY {
            let ok: bool = try val.array_set_length(r, self, n - 1)
        }
        return v
    }
    if id == B_AP_UNSHIFT {
        let add: u64 = nargs(args)
        var i: u64 = n
        while i > 0 {
            let e: Gc[JsVal] = try aget(r, this, i - 1)
            let ok: bool = try aset(r, this, i - 1 + add, e)
            i = i - 1
        }
        i = 0
        while i < add {
            let ok: bool = try aset(r, this, i, arg(r, args, i))
            i = i + 1
        }
        return val.realm_num(r, (n + add) as f64)
    }
    if id == B_AP_SLICE {
        var from: u64 = try rel_index(r, arg(r, args, 0), n, 0)
        var to: u64 = n
        if !val.is_undefined(arg(r, args, 1)) {
            to = try rel_index(r, arg(r, args, 1), n, n)
        }
        let out: Gc[GcVec] = try interp.args_new(r)
        var i: u64 = from
        while i < to {
            let e: Gc[JsVal] = try aget(r, this, i)
            let ok: bool = try gcvec_append[JsVal](out, e)
            i = i + 1
        }
        return new_array_from(r, out)
    }
    if id == B_AP_SPLICE {
        let start: u64 = try rel_index(r, arg(r, args, 0), n, 0)
        var del: u64 = n - start
        if nargs(args) >= 2 {
            let d: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 1)))
            if d < 0.0 {
                del = 0
            } else if (d as u64) < n - start {
                del = d as u64
            }
        }
        if nargs(args) == 0 {
            del = 0
        }
        let removed: Gc[GcVec] = try interp.args_new(r)
        var i: u64 = 0
        while i < del {
            let e: Gc[JsVal] = try aget(r, this, start + i)
            let ok: bool = try gcvec_append[JsVal](removed, e)
            i = i + 1
        }
        let rest: Gc[GcVec] = try interp.args_new(r)
        i = start + del
        while i < n {
            let e: Gc[JsVal] = try aget(r, this, i)
            let ok: bool = try gcvec_append[JsVal](rest, e)
            i = i + 1
        }
        var w: u64 = start
        i = 2
        while i < nargs(args) {
            let ok: bool = try aset(r, this, w, arg(r, args, i))
            w = w + 1
            i = i + 1
        }
        i = 0
        while i < gcvec_length(rest) {
            let ok: bool = try aset(r, this, w, gcvec_read[JsVal](rest, i))
            w = w + 1
            i = i + 1
        }
        if (self as u64) != 0 && self.cls == val.CLS_ARRAY {
            let ok: bool = try val.array_set_length(r, self, w)
        }
        return new_array_from(r, removed)
    }
    if id == B_AP_CONCAT {
        let out: Gc[GcVec] = try interp.args_new(r)
        var i: u64 = 0
        while i < n {
            let e: Gc[JsVal] = try aget(r, this, i)
            let ok: bool = try gcvec_append[JsVal](out, e)
            i = i + 1
        }
        i = 0
        while i < nargs(args) {
            let v: Gc[JsVal] = arg(r, args, i)
            if interp.is_array(v) {
                let m: u64 = try alen(r, v)
                var j: u64 = 0
                while j < m {
                    let e: Gc[JsVal] = try aget(r, v, j)
                    let ok: bool = try gcvec_append[JsVal](out, e)
                    j = j + 1
                }
            } else {
                let ok: bool = try gcvec_append[JsVal](out, v)
            }
            i = i + 1
        }
        return new_array_from(r, out)
    }
    if id == B_AP_JOIN || id == B_AP_TOSTRING {
        var sep: Gc[JsVal] = val.str_empty(r)
        var cm: [u8; 1] = ","
        sep = try val.str_from_ascii(r, &cm[0], 1)
        if id == B_AP_JOIN && !val.is_undefined(arg(r, args, 0)) {
            sep = try interp.to_string(r, arg(r, args, 0))
        }
        var out: Gc[JsVal] = val.str_empty(r)
        var i: u64 = 0
        while i < n {
            if i > 0 {
                out = try val.str_concat(r, out, sep)
            }
            let e: Gc[JsVal] = try aget(r, this, i)
            if !val.is_nullish(e) {
                let s: Gc[JsVal] = try interp.to_string(r, e)
                if thrown(r) {
                    return val.realm_undefined(r)
                }
                out = try val.str_concat(r, out, s)
            }
            i = i + 1
        }
        return out
    }
    if id == B_AP_INDEXOF || id == B_AP_LASTINDEXOF || id == B_AP_INCLUDES {
        let want: Gc[JsVal] = arg(r, args, 0)
        if id == B_AP_LASTINDEXOF {
            var i: u64 = n
            while i > 0 {
                let e: Gc[JsVal] = try aget(r, this, i - 1)
                if interp.strict_equals(r, e, want) {
                    return val.realm_num(r, (i - 1) as f64)
                }
                i = i - 1
            }
            return val.realm_num(r, 0.0 - 1.0)
        }
        var start: u64 = 0
        if nargs(args) >= 2 {
            start = try rel_index(r, arg(r, args, 1), n, 0)
        }
        var i: u64 = start
        while i < n {
            let e: Gc[JsVal] = try aget(r, this, i)
            var hit: bool = false
            if id == B_AP_INCLUDES {
                hit = interp.same_value_zero(r, e, want)
            } else {
                hit = interp.strict_equals(r, e, want)
            }
            if hit {
                if id == B_AP_INCLUDES {
                    return val.realm_bool(r, true)
                }
                return val.realm_num(r, i as f64)
            }
            i = i + 1
        }
        if id == B_AP_INCLUDES {
            return val.realm_bool(r, false)
        }
        return val.realm_num(r, 0.0 - 1.0)
    }
    if id == B_AP_REVERSE {
        var i: u64 = 0
        while i * 2 + 1 < n {
            let a: Gc[JsVal] = try aget(r, this, i)
            let b: Gc[JsVal] = try aget(r, this, n - 1 - i)
            let ok1: bool = try aset(r, this, i, b)
            let ok2: bool = try aset(r, this, n - 1 - i, a)
            i = i + 1
        }
        return this
    }
    if id == B_AP_FILL {
        let v: Gc[JsVal] = arg(r, args, 0)
        var from: u64 = 0
        var to: u64 = n
        if nargs(args) >= 2 {
            from = try rel_index(r, arg(r, args, 1), n, 0)
        }
        if nargs(args) >= 3 && !val.is_undefined(arg(r, args, 2)) {
            to = try rel_index(r, arg(r, args, 2), n, n)
        }
        var i: u64 = from
        while i < to {
            let ok: bool = try aset(r, this, i, v)
            i = i + 1
        }
        return this
    }
    if id == B_AP_SORT {
        return array_sort(r, this, n, arg(r, args, 0))
    }
    if id == B_AP_REDUCE || id == B_AP_REDUCERIGHT {
        let f: Gc[JsVal] = arg(r, args, 0)
        if !val.is_callable(f) {
            var m: [u8; 24] = "reducer is not a functio"
            return type_err(r, &m[0], 24)
        }
        var acc: Gc[JsVal] = val.realm_undefined(r)
        var started: bool = false
        if nargs(args) >= 2 {
            acc = arg(r, args, 1)
            started = true
        }
        var step: u64 = 0
        while step < n {
            var i: u64 = step
            if id == B_AP_REDUCERIGHT {
                i = n - 1 - step
            }
            let has: bool = try ahas(r, this, i)
            if has {
                let e: Gc[JsVal] = try aget(r, this, i)
                if !started {
                    acc = e
                    started = true
                } else {
                    let ca: Gc[GcVec] = try interp.args_new(r)
                    let ok1: bool = try gcvec_append[JsVal](ca, acc)
                    let ok2: bool = try gcvec_append[JsVal](ca, e)
                    let iv: Gc[JsVal] = try val.realm_num(r, i as f64)
                    let ok3: bool = try gcvec_append[JsVal](ca, iv)
                    let ok4: bool = try gcvec_append[JsVal](ca, this)
                    acc = try interp.call_function(r, f,
                        val.realm_undefined(r), ca)
                    if thrown(r) {
                        return val.realm_undefined(r)
                    }
                }
            }
            step = step + 1
        }
        if !started {
            var m: [u8; 33] = "Reduce of an empty array with no "
            return type_err(r, &m[0], 32)
        }
        return acc
    }
    // The callback family.
    let f: Gc[JsVal] = arg(r, args, 0)
    if !val.is_callable(f) {
        var m: [u8; 25] = "callback is not a functio"
        return type_err(r, &m[0], 25)
    }
    let thisarg: Gc[JsVal] = arg(r, args, 1)
    let out: Gc[GcVec] = try interp.args_new(r)
    var i: u64 = 0
    while i < n {
        let has: bool = try ahas(r, this, i)
        if !has && (id == B_AP_FOREACH || id == B_AP_FILTER || id == B_AP_SOME || id == B_AP_EVERY) {
            i = i + 1
            continue
        }
        let e: Gc[JsVal] = try aget(r, this, i)
        let ca: Gc[GcVec] = try interp.args_new(r)
        let ok1: bool = try gcvec_append[JsVal](ca, e)
        let iv: Gc[JsVal] = try val.realm_num(r, i as f64)
        let ok2: bool = try gcvec_append[JsVal](ca, iv)
        let ok3: bool = try gcvec_append[JsVal](ca, this)
        let res: Gc[JsVal] = try interp.call_function(r, f, thisarg, ca)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        if id == B_AP_MAP {
            let ok: bool = try gcvec_append[JsVal](out, res)
        } else if id == B_AP_FILTER {
            if interp.to_boolean(r, res) {
                let ok: bool = try gcvec_append[JsVal](out, e)
            }
        } else if id == B_AP_SOME {
            if interp.to_boolean(r, res) {
                return val.realm_bool(r, true)
            }
        } else if id == B_AP_EVERY {
            if !interp.to_boolean(r, res) {
                return val.realm_bool(r, false)
            }
        } else if id == B_AP_FIND {
            if interp.to_boolean(r, res) {
                return e
            }
        } else if id == B_AP_FINDINDEX {
            if interp.to_boolean(r, res) {
                return val.realm_num(r, i as f64)
            }
        }
        i = i + 1
    }
    if id == B_AP_MAP || id == B_AP_FILTER {
        return new_array_from(r, out)
    }
    if id == B_AP_SOME {
        return val.realm_bool(r, false)
    }
    if id == B_AP_EVERY {
        return val.realm_bool(r, true)
    }
    if id == B_AP_FINDINDEX {
        return val.realm_num(r, 0.0 - 1.0)
    }
    return val.realm_undefined(r)
}

// A relative index (a negative one counts from the end).
fn rel_index(r: Gc[Realm], v: Gc[JsVal], n: u64, dflt: u64) -> AllocError!u64 {
    if val.is_undefined(v) {
        return dflt
    }
    let x: f64 = math.math_f64(try interp.to_integer(r, v))
    if x < 0.0 {
        let y: f64 = (n as f64) + x
        if y < 0.0 {
            return 0
        }
        return y as u64
    }
    if x > (n as f64) {
        return n
    }
    return x as u64
}

// An insertion sort with the comparison of 23.1.3.30 -- stable, and it
// does exactly as many comparisons as the specification allows.
fn array_sort(r: Gc[Realm], this: Gc[JsVal], n: u64,
    cmp: Gc[JsVal]) -> AllocError!Gc[JsVal] {
    if !val.is_undefined(cmp) && !val.is_callable(cmp) {
        var m: [u8; 34] = "The comparison function must be a "
        return type_err(r, &m[0], 33)
    }
    let items: Gc[GcVec] = try interp.args_new(r)
    var i: u64 = 0
    var gaps: u64 = 0
    while i < n {
        let has: bool = try ahas(r, this, i)
        if has {
            let e: Gc[JsVal] = try aget(r, this, i)
            if val.is_undefined(e) {
                gaps = gaps + 1
            } else {
                let ok: bool = try gcvec_append[JsVal](items, e)
            }
        } else {
            gaps = gaps + 1
        }
        i = i + 1
    }
    let m: u64 = gcvec_length(items)
    i = 1
    while i < m {
        let key: Gc[JsVal] = gcvec_read[JsVal](items, i)
        var j: u64 = i
        while j > 0 {
            let prev: Gc[JsVal] = gcvec_read[JsVal](items, j - 1)
            let c: i32 = try sort_compare(r, prev, key, cmp)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            if c <= 0 {
                break
            }
            let ok: bool = gcvec_set[JsVal](items, j, prev)
            j = j - 1
        }
        let ok2: bool = gcvec_set[JsVal](items, j, key)
        i = i + 1
    }
    i = 0
    while i < m {
        let ok: bool = try aset(r, this, i, gcvec_read[JsVal](items, i))
        i = i + 1
    }
    while i < n {
        let ok: bool = try aset(r, this, i, val.realm_undefined(r))
        i = i + 1
    }
    return this
}

fn sort_compare(r: Gc[Realm], a: Gc[JsVal], b: Gc[JsVal],
    cmp: Gc[JsVal]) -> AllocError!i32 {
    if val.is_callable(cmp) {
        let ca: Gc[GcVec] = try interp.args_new(r)
        let ok1: bool = try gcvec_append[JsVal](ca, a)
        let ok2: bool = try gcvec_append[JsVal](ca, b)
        let res: Gc[JsVal] = try interp.call_function(r, cmp,
            val.realm_undefined(r), ca)
        if thrown(r) {
            return 0
        }
        let x: f64 = math.math_f64(try interp.to_number(r, res))
        if math.is_nan(x) {
            return 0
        }
        if x < 0.0 {
            return -1
        }
        if x > 0.0 {
            return 1
        }
        return 0
    }
    let sa: Gc[JsVal] = try interp.to_string(r, a)
    if thrown(r) {
        return 0
    }
    let sb: Gc[JsVal] = try interp.to_string(r, b)
    if thrown(r) {
        return 0
    }
    return val.str_compare(sa, sb) as i32
}

// --------------------------------------------------------------- String

fn string_fn(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if id == B_STRING_CTOR {
        var s: Gc[JsVal] = val.str_empty(r)
        if nargs(args) > 0 {
            if val.val_tag(arg(r, args, 0)) == val.TAG_SYM && (nt as u64) == 0 {
                return symbol_fn(r, B_SYP_TOSTRING, arg(r, args, 0), args,
                    gc_null[JsObj]())
            }
            s = try interp.to_string(r, arg(r, args, 0))
            if thrown(r) {
                return val.realm_undefined(r)
            }
        }
        if (nt as u64) == 0 {
            return s
        }
        let o: Gc[JsObj] = try interp.to_object(r, s)
        let ov: Gc[JsVal] = o
        return ov
    }
    if id == B_STR_FROMCHARCODE {
        let out: Gc[JsStr] = try val.str_new(r)
        var i: u64 = 0
        while i < nargs(args) {
            let x: f64 = math.math_f64(try interp.to_number(r, arg(r, args, i)))
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let u: u32 = (interp.f64_to_uint16(x)) as u32
            let ok: bool = try val.str_push(out, u)
            i = i + 1
        }
        let ov: Gc[JsVal] = out
        return ov
    }
    if val.is_nullish(this) {
        var m: [u8; 36] = "String.prototype method on undefined"
        return type_err(r, &m[0], 35)
    }
    // `toString` and `valueOf` must NOT go through ToString first -- that
    // calls them again over ToPrimitive and recurses until the stack ends.
    if id == B_SP_TOSTRING || id == B_SP_VALUEOF {
        let p0: Gc[JsVal] = this_prim(r, this, val.TAG_STR)
        if (p0 as u64) == 0 {
            var m0: [u8; 12] = "not a String"
            return type_err(r, &m0[0], 12)
        }
        return p0
    }
    let s: Gc[JsVal] = try interp.to_string(r, this)
    if thrown(r) {
        return val.realm_undefined(r)
    }
    let n: u64 = val.str_len(s)
    if id == B_SP_TOSTRING || id == B_SP_VALUEOF {
        let p: Gc[JsVal] = this_prim(r, this, val.TAG_STR)
        if (p as u64) == 0 {
            var m: [u8; 26] = "not a String              "
            return type_err(r, &m[0], 12)
        }
        return p
    }
    if id == B_SP_CHARAT || id == B_SP_AT {
        var x: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 0)))
        if id == B_SP_AT && x < 0.0 {
            x = (n as f64) + x
        }
        if x < 0.0 || x >= (n as f64) {
            if id == B_SP_AT {
                return val.realm_undefined(r)
            }
            return val.str_empty(r)
        }
        return val.str_slice(r, s, x as u64, (x as u64) + 1)
    }
    if id == B_SP_CHARCODEAT || id == B_SP_CODEPOINTAT {
        let x: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 0)))
        if x < 0.0 || x >= (n as f64) {
            return val.realm_num(r, math.math_f64(0x7FF8000000000000))
        }
        let i: u64 = x as u64
        var c: u32 = val.str_at(s, i)
        if id == B_SP_CODEPOINTAT {
            if c >= 0xD800 as u32 && c <= 0xDBFF as u32 && i + 1 < n {
                let c2: u32 = val.str_at(s, i + 1)
                if c2 >= 0xDC00 as u32 && c2 <= 0xDFFF as u32 {
                    c = 0x10000 as u32 + ((c - 0xD800 as u32) << 10) + (c2 - 0xDC00 as u32)
                }
            }
        }
        return val.realm_num(r, c as f64)
    }
    if id == B_SP_INDEXOF || id == B_SP_LASTINDEXOF || id == B_SP_INCLUDES {
        let needle: Gc[JsVal] = try interp.to_string(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        if id == B_SP_LASTINDEXOF {
            var best: i64 = -1
            var i: u64 = 0
            while i <= n {
                let at: i64 = val.str_index_of(s, needle, i)
                if at < 0 {
                    break
                }
                best = at
                i = (at as u64) + 1
            }
            return val.realm_num(r, best as f64)
        }
        var from: u64 = 0
        if nargs(args) >= 2 && !val.is_undefined(arg(r, args, 1)) {
            let x: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 1)))
            if x > 0.0 {
                from = x as u64
            }
        }
        let at: i64 = val.str_index_of(s, needle, from)
        if id == B_SP_INCLUDES {
            return val.realm_bool(r, at >= 0)
        }
        return val.realm_num(r, at as f64)
    }
    if id == B_SP_STARTSWITH || id == B_SP_ENDSWITH {
        let needle: Gc[JsVal] = try interp.to_string(r, arg(r, args, 0))
        let m: u64 = val.str_len(needle)
        var start: u64 = 0
        if id == B_SP_ENDSWITH {
            var end: u64 = n
            if nargs(args) >= 2 && !val.is_undefined(arg(r, args, 1)) {
                let x: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 1)))
                if x < 0.0 {
                    end = 0
                } else if (x as u64) < n {
                    end = x as u64
                }
            }
            if m > end {
                return val.realm_bool(r, false)
            }
            start = end - m
        } else {
            if nargs(args) >= 2 && !val.is_undefined(arg(r, args, 1)) {
                let x: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 1)))
                if x > 0.0 {
                    start = x as u64
                }
            }
            if start + m > n {
                return val.realm_bool(r, false)
            }
        }
        var i: u64 = 0
        while i < m {
            if val.str_at(s, start + i) != val.str_at(needle, i) {
                return val.realm_bool(r, false)
            }
            i = i + 1
        }
        return val.realm_bool(r, true)
    }
    if id == B_SP_SLICE {
        var from: u64 = try rel_index(r, arg(r, args, 0), n, 0)
        var to: u64 = n
        if !val.is_undefined(arg(r, args, 1)) {
            to = try rel_index(r, arg(r, args, 1), n, n)
        }
        if to < from {
            to = from
        }
        return val.str_slice(r, s, from, to)
    }
    if id == B_SP_SUBSTRING {
        var a: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 0)))
        var b: f64 = n as f64
        if !val.is_undefined(arg(r, args, 1)) {
            b = math.math_f64(try interp.to_integer(r, arg(r, args, 1)))
        }
        if a < 0.0 { a = 0.0 }
        if b < 0.0 { b = 0.0 }
        if a > (n as f64) { a = n as f64 }
        if b > (n as f64) { b = n as f64 }
        var from: u64 = a as u64
        var to: u64 = b as u64
        if from > to {
            let t: u64 = from
            from = to
            to = t
        }
        return val.str_slice(r, s, from, to)
    }
    if id == B_SP_SUBSTR {
        let from: u64 = try rel_index(r, arg(r, args, 0), n, 0)
        var len: u64 = n - from
        if !val.is_undefined(arg(r, args, 1)) {
            let x: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 1)))
            if x < 0.0 {
                len = 0
            } else if (x as u64) < len {
                len = x as u64
            }
        }
        return val.str_slice(r, s, from, from + len)
    }
    if id == B_SP_TOUPPER || id == B_SP_TOLOWER {
        let out: Gc[JsStr] = try val.str_new(r)
        var i: u64 = 0
        while i < n {
            // Round 95: the simple case mappings of the UCD out of the
            // generated table. Until round 94 this was ASCII plus Latin-1.
            // What is still missing is SpecialCasing.txt, where one code
            // point becomes several ("STRASSE"); UnicodeData leaves the
            // field empty for those, so they stay as they are instead of
            // becoming something wrong.
            // Round 95: a code POINT, not a code unit -- a surrogate pair
            // is put together, mapped and written out again. Without that
            // the Deseret block (U+10400) came out unchanged.
            var c: u32 = val.str_at(s, i)
            var step: u64 = 1
            if c >= 0xD800 as u32 && c <= 0xDBFF as u32 && i + 1 < n {
                let lo: u32 = val.str_at(s, i + 1)
                if lo >= 0xDC00 as u32 && lo <= 0xDFFF as u32 {
                    let top: u32 = (c - 0xD800 as u32) * 1024 as u32
                    c = 0x10000 as u32 + top + (lo - 0xDC00 as u32)
                    step = 2
                }
            }
            var m: u32 = c
            if id == B_SP_TOUPPER {
                m = ucd.ucd_to_upper(r.ucdtab, c)
            } else {
                m = ucd.ucd_to_lower(r.ucdtab, c)
            }
            if m >= 0x10000 as u32 {
                let hi: u32 = 0xD800 as u32 + (m - 0x10000 as u32) / 1024 as u32
                let lo2: u32 = 0xDC00 as u32 + (m - 0x10000 as u32) % 1024 as u32
                let o1: bool = try val.str_push(out, hi)
                let o2: bool = try val.str_push(out, lo2)
            } else {
                let ok: bool = try val.str_push(out, m)
            }
            i = i + step
        }
        let ov: Gc[JsVal] = out
        return ov
    }
    if id == B_SP_TRIM {
        var a: u64 = 0
        var b: u64 = n
        while a < b && is_ws(r.ucdtab, val.str_at(s, a)) {
            a = a + 1
        }
        while b > a && is_ws(r.ucdtab, val.str_at(s, b - 1)) {
            b = b - 1
        }
        return val.str_slice(r, s, a, b)
    }
    if id == B_SP_CONCAT {
        var out: Gc[JsVal] = s
        var i: u64 = 0
        while i < nargs(args) {
            let e: Gc[JsVal] = try interp.to_string(r, arg(r, args, i))
            if thrown(r) {
                return val.realm_undefined(r)
            }
            out = try val.str_concat(r, out, e)
            i = i + 1
        }
        return out
    }
    if id == B_SP_REPEAT {
        let x: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 0)))
        if x < 0.0 || math.is_infinite(x) {
            var m: [u8; 22] = "Invalid count value   "
            return interp.throw_error(r, interp.ERR_RANGE, &m[0], 19)
        }
        let out: Gc[JsStr] = try val.str_new(r)
        var k: u64 = 0
        while k < (x as u64) {
            var i: u64 = 0
            while i < n {
                let ok: bool = try val.str_push(out, val.str_at(s, i))
                i = i + 1
            }
            k = k + 1
        }
        let ov: Gc[JsVal] = out
        return ov
    }
    if id == B_SP_PADSTART || id == B_SP_PADEND {
        let tlen: u64 = try interp.to_length(r, arg(r, args, 0))
        let target: f64 = tlen as f64
        if (target as u64) <= n {
            return s
        }
        var filler: Gc[JsVal] = val.str_empty(r)
        var sp: [u8; 1] = " "
        filler = try val.str_from_ascii(r, &sp[0], 1)
        if !val.is_undefined(arg(r, args, 1)) {
            filler = try interp.to_string(r, arg(r, args, 1))
        }
        if val.str_len(filler) == 0 {
            return s
        }
        let need: u64 = (target as u64) - n
        let pad: Gc[JsStr] = try val.str_new(r)
        var i: u64 = 0
        while i < need {
            let ok: bool = try val.str_push(pad,
                val.str_at(filler, i % val.str_len(filler)))
            i = i + 1
        }
        let pv: Gc[JsVal] = pad
        if id == B_SP_PADSTART {
            return val.str_concat(r, pv, s)
        }
        return val.str_concat(r, s, pv)
    }
    if id == B_SP_SPLIT {
        let out: Gc[GcVec] = try interp.args_new(r)
        let sepv: Gc[JsVal] = arg(r, args, 0)
        if val.is_undefined(sepv) {
            let ok: bool = try gcvec_append[JsVal](out, s)
            return new_array_from(r, out)
        }
        let sep: Gc[JsVal] = try interp.to_string(r, sepv)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let m: u64 = val.str_len(sep)
        if m == 0 {
            var i: u64 = 0
            while i < n {
                let piece: Gc[JsVal] = try val.str_slice(r, s, i, i + 1)
                let ok: bool = try gcvec_append[JsVal](out, piece)
                i = i + 1
            }
            return new_array_from(r, out)
        }
        var from: u64 = 0
        while true {
            let at: i64 = val.str_index_of(s, sep, from)
            if at < 0 {
                let piece: Gc[JsVal] = try val.str_slice(r, s, from, n)
                let ok: bool = try gcvec_append[JsVal](out, piece)
                break
            }
            let piece: Gc[JsVal] = try val.str_slice(r, s, from, at as u64)
            let ok: bool = try gcvec_append[JsVal](out, piece)
            from = (at as u64) + m
        }
        return new_array_from(r, out)
    }
    if id == B_SP_REPLACE {
        let pat: Gc[JsVal] = try interp.to_string(r, arg(r, args, 0))
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let at: i64 = val.str_index_of(s, pat, 0)
        if at < 0 {
            return s
        }
        var rep: Gc[JsVal] = val.str_empty(r)
        if val.is_callable(arg(r, args, 1)) {
            let ca: Gc[GcVec] = try interp.args_new(r)
            let ok1: bool = try gcvec_append[JsVal](ca, pat)
            let iv: Gc[JsVal] = try val.realm_num(r, at as f64)
            let ok2: bool = try gcvec_append[JsVal](ca, iv)
            let ok3: bool = try gcvec_append[JsVal](ca, s)
            let res: Gc[JsVal] = try interp.call_function(r, arg(r, args, 1),
                val.realm_undefined(r), ca)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            rep = try interp.to_string(r, res)
        } else {
            rep = try interp.to_string(r, arg(r, args, 1))
        }
        if thrown(r) {
            return val.realm_undefined(r)
        }
        let head: Gc[JsVal] = try val.str_slice(r, s, 0, at as u64)
        let tail: Gc[JsVal] = try val.str_slice(r, s,
            (at as u64) + val.str_len(pat), n)
        let a: Gc[JsVal] = try val.str_concat(r, head, rep)
        return val.str_concat(r, a, tail)
    }
    return val.realm_undefined(r)
}

// -------------------------------------------------------------- Number

fn number_fn(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if id == B_NUMBER_CTOR {
        var x: f64 = 0.0
        if nargs(args) > 0 {
            // 21.1.1.1: `Number(aBigInt)` is allowed and gives the nearest
            // double -- only the IMPLICIT conversion is a TypeError.
            let a0: Gc[JsVal] = arg(r, args, 0)
            let prim: Gc[JsVal] = try interp.to_primitive_pub(r, a0, 1)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            if val.is_bigint(prim) {
                let bv: Gc[JsVal] = try val.realm_num(r, bigint.bi_to_f64(prim))
                if (nt as u64) == 0 {
                    return bv
                }
                let bo: Gc[JsObj] = try interp.to_object(r, bv)
                let bov: Gc[JsVal] = bo
                return bov
            }
            x = math.math_f64(try interp.to_number(r, prim))
            if thrown(r) {
                return val.realm_undefined(r)
            }
        }
        let v: Gc[JsVal] = try val.realm_num(r, x)
        if (nt as u64) == 0 {
            return v
        }
        let o: Gc[JsObj] = try interp.to_object(r, v)
        let ov: Gc[JsVal] = o
        return ov
    }
    if id == B_NUM_ISNAN || id == B_NUM_ISFINITE || id == B_NUM_ISINTEGER || id == B_NUM_ISSAFE {
        let v: Gc[JsVal] = arg(r, args, 0)
        if val.val_tag(v) != val.TAG_NUM {
            return val.realm_bool(r, false)
        }
        let x: f64 = val.num_value(v)
        if id == B_NUM_ISNAN {
            return val.realm_bool(r, math.is_nan(x))
        }
        if id == B_NUM_ISFINITE {
            return val.realm_bool(r, math.is_finite(x))
        }
        if !math.is_finite(x) || math.trunc(x) != x {
            return val.realm_bool(r, false)
        }
        if id == B_NUM_ISSAFE {
            return val.realm_bool(r, math.fabs(x) <= max_safe_integer())
        }
        return val.realm_bool(r, true)
    }
    let p: Gc[JsVal] = this_prim(r, this, val.TAG_NUM)
    if (p as u64) == 0 {
        var m: [u8; 25] = "not a Number             "
        return type_err(r, &m[0], 12)
    }
    let x: f64 = val.num_value(p)
    if id == B_NP_VALUEOF {
        return p
    }
    if id == B_NP_TOFIXED {
        let d: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 0)))
        if d < 0.0 || d > 100.0 {
            var m: [u8; 30] = "toFixed digits out of range   "
            return interp.throw_error(r, interp.ERR_RANGE, &m[0], 27)
        }
        return to_fixed(r, x, d as u64)
    }
    // toString with a radix.
    if nargs(args) > 0 && !val.is_undefined(arg(r, args, 0)) {
        let rx: f64 = math.math_f64(try interp.to_integer(r, arg(r, args, 0)))
        if rx < 2.0 || rx > 36.0 {
            var m: [u8; 27] = "toString radix out of range"
            return interp.throw_error(r, interp.ERR_RANGE, &m[0], 27)
        }
        if rx != 10.0 {
            return radix_string(r, x, rx as u32)
        }
    }
    return interp.number_to_string(r, x)
}

// A number in a radix other than ten -- the integer part exactly, the
// fraction to twenty places (the specification leaves the precision to the
// implementation here).
fn radix_string(r: Gc[Realm], x: f64, radix: u32) -> AllocError!Gc[JsVal] {
    if math.is_nan(x) || math.is_infinite(x) {
        return interp.number_to_string(r, x)
    }
    let out: Gc[JsStr] = try val.str_new(r)
    var v: f64 = x
    if v < 0.0 {
        let ok: bool = try val.str_push(out, 45 as u32)
        v = 0.0 - v
    }
    var ip: f64 = math.floor(v)
    var fp: f64 = v - ip
    var digits: [u8; 80] = [0 as u8; 80]
    var n: usize = 0
    if ip == 0.0 {
        digits[0] = 48 as u8
        n = 1
    } else {
        while ip >= 1.0 && n < 80 {
            let d: u64 = (math.fmod(ip, radix as f64)) as u64
            digits[n] = dig_char(d as u32)
            ip = math.floor(ip / (radix as f64))
            n = n + 1
        }
    }
    while n > 0 {
        n = n - 1
        let ok: bool = try val.str_push(out, digits[n] as u32)
    }
    if fp > 0.0 {
        let ok: bool = try val.str_push(out, 46 as u32)
        var k: u32 = 0
        while k < 20 && fp > 0.0 {
            fp = fp * (radix as f64)
            let d: u64 = math.floor(fp) as u64
            let ok2: bool = try val.str_push(out, dig_char(d as u32) as u32)
            fp = fp - math.floor(fp)
            k = k + 1 as u32
        }
    }
    let ov: Gc[JsVal] = out
    return ov
}

fn dig_char(d: u32) -> u8 {
    if d < 10 as u32 {
        return (48 + d) as u8
    }
    return (87 + d) as u8
}

fn to_fixed(r: Gc[Realm], x: f64, d: u64) -> AllocError!Gc[JsVal] {
    if math.is_nan(x) || math.fabs(x) >= 1e21 {
        return interp.number_to_string(r, x)
    }
    let out: Gc[JsStr] = try val.str_new(r)
    var v: f64 = x
    if v < 0.0 {
        let ok: bool = try val.str_push(out, 45 as u32)
        v = 0.0 - v
    }
    var scale: f64 = 1.0
    var i: u64 = 0
    while i < d {
        scale = scale * 10.0
        i = i + 1
    }
    let scaled: f64 = math.floor(v * scale + 0.5)
    var digits: [u8; 40] = [0 as u8; 40]
    var n: usize = 0
    var t: f64 = scaled
    if t == 0.0 {
        digits[0] = 48 as u8
        n = 1
    }
    while t >= 1.0 && n < 40 {
        let dd: u64 = (math.fmod(t, 10.0)) as u64
        digits[n] = (48 + dd) as u8
        t = math.floor(t / 10.0)
        n = n + 1
    }
    while n <= d as usize {
        digits[n] = 48 as u8
        n = n + 1
    }
    var k: usize = n
    while k > 0 {
        k = k - 1
        let ok: bool = try val.str_push(out, digits[k] as u32)
        if d > 0 && k == d as usize {
            let ok2: bool = try val.str_push(out, 46 as u32)
        }
    }
    let ov: Gc[JsVal] = out
    return ov
}

// ------------------------------------------------------------- Boolean

fn boolean_fn(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if id == B_BOOLEAN_CTOR {
        let b: bool = interp.to_boolean(r, arg(r, args, 0))
        let v: Gc[JsVal] = val.realm_bool(r, b)
        if (nt as u64) == 0 {
            return v
        }
        let o: Gc[JsObj] = try interp.to_object(r, v)
        let ov: Gc[JsVal] = o
        return ov
    }
    let p: Gc[JsVal] = this_prim(r, this, val.TAG_BOOL)
    if (p as u64) == 0 {
        var m: [u8; 26] = "not a Boolean             "
        return type_err(r, &m[0], 13)
    }
    if id == B_BP_VALUEOF {
        return p
    }
    return interp.to_string(r, p)
}

// ------------------------------------------------------------ Map / Set
//
// Both keep their entries in the dense element storage (key, value, key,
// value, ... for a Map; one slot per element for a Set) and search
// linearly. That is honest and slow: a hash table over `SameValueZero`
// would need the hash of an OBJECT, and this engine has no object identity
// number yet. Named in docs/ROUND63.md.

fn collection_fn(r: Gc[Realm], id: u64, this: Gc[JsVal], args: Gc[GcVec],
    nt: Gc[JsObj]) -> AllocError!Gc[JsVal] {
    if id == B_MAP_CTOR || id == B_SET_CTOR {
        if (nt as u64) == 0 {
            var m: [u8; 34] = "Constructor requires 'new'        "
            return type_err(r, &m[0], 28)
        }
        var which: u64 = val.PROTO_MAP
        var cls: u64 = val.CLS_MAP
        if id == B_SET_CTOR {
            which = val.PROTO_SET
            cls = val.CLS_SET
        }
        let o: Gc[JsObj] = try val.obj_new_proto(r, val.realm_proto(r, which))
        o.cls = cls
        o.elems = try gcvec_new()
        o.len = 0
        let ov: Gc[JsVal] = o
        let init: Gc[JsVal] = arg(r, args, 0)
        if !val.is_nullish(init) {
            let items: Gc[GcVec] = try interp.iterate_values(r, init)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            var i: u64 = 0
            while i < gcvec_length(items) {
                let e: Gc[JsVal] = gcvec_read[JsVal](items, i)
                if id == B_SET_CTOR {
                    let ok: bool = try coll_add(r, o, e, e, false)
                } else {
                    let k: Gc[JsVal] = try aget(r, e, 0)
                    let v: Gc[JsVal] = try aget(r, e, 1)
                    let ok: bool = try coll_add(r, o, k, v, true)
                }
                i = i + 1
            }
        }
        return ov
    }
    let o: Gc[JsObj] = val.as_obj(this)
    if (o as u64) == 0 || (o.cls != val.CLS_MAP && o.cls != val.CLS_SET) {
        var m: [u8; 30] = "not a Map or Set              "
        return type_err(r, &m[0], 17)
    }
    let paired: bool = o.cls == val.CLS_MAP
    var step: u64 = 1
    if paired {
        step = 2
    }
    if id == B_COLL_SIZE {
        return val.realm_num(r, (val.elems_len(o) / step) as f64)
    }
    if id == B_MP_CLEAR || id == B_SP_CLEAR {
        o.elems = try gcvec_new()
        return val.realm_undefined(r)
    }
    if id == B_MP_FOREACH || id == B_SP_FOREACH {
        let f: Gc[JsVal] = arg(r, args, 0)
        if !val.is_callable(f) {
            var m: [u8; 25] = "callback is not a functio"
            return type_err(r, &m[0], 25)
        }
        var i: u64 = 0
        while i < val.elems_len(o) {
            let k: Gc[JsVal] = val.elems_get(r, o, i)
            var v: Gc[JsVal] = k
            if paired {
                v = val.elems_get(r, o, i + 1)
            }
            let ca: Gc[GcVec] = try interp.args_new(r)
            let ok1: bool = try gcvec_append[JsVal](ca, v)
            let ok2: bool = try gcvec_append[JsVal](ca, k)
            let ok3: bool = try gcvec_append[JsVal](ca, this)
            let res: Gc[JsVal] = try interp.call_function(r, f,
                arg(r, args, 1), ca)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            i = i + step
        }
        return val.realm_undefined(r)
    }
    let key: Gc[JsVal] = arg(r, args, 0)
    let at: i64 = coll_find(r, o, key, step)
    if id == B_MP_HAS || id == B_SP_HAS {
        return val.realm_bool(r, at >= 0)
    }
    if id == B_MP_GET {
        if at < 0 {
            return val.realm_undefined(r)
        }
        return val.elems_get(r, o, (at as u64) + 1)
    }
    if id == B_MP_DELETE || id == B_SP_DELETE {
        if at < 0 {
            return val.realm_bool(r, false)
        }
        var i: u64 = at as u64
        while i + step < val.elems_len(o) {
            let ok: bool = try val.elems_set(r, o, i,
                val.elems_get(r, o, i + step))
            i = i + 1
        }
        var k: u64 = 0
        while k < step {
            let ok: bool = gcvec_remove(o.elems, val.elems_len(o) - 1)
            k = k + 1
        }
        return val.realm_bool(r, true)
    }
    if id == B_MP_SET {
        let ok: bool = try coll_add(r, o, key, arg(r, args, 1), true)
        return this
    }
    if id == B_SP_ADD {
        let ok: bool = try coll_add(r, o, key, key, false)
        return this
    }
    return val.realm_undefined(r)
}

fn coll_find(r: Gc[Realm], o: Gc[JsObj], key: Gc[JsVal], step: u64) -> i64 {
    var i: u64 = 0
    while i < val.elems_len(o) {
        if interp.same_value_zero(r, val.elems_get(r, o, i), key) {
            return i as i64
        }
        i = i + step
    }
    return -1
}

fn coll_add(r: Gc[Realm], o: Gc[JsObj], key: Gc[JsVal], v: Gc[JsVal],
    paired: bool) -> AllocError!bool {
    var step: u64 = 1
    if paired {
        step = 2
    }
    let at: i64 = coll_find(r, o, key, step)
    if at >= 0 {
        if paired {
            let ok: bool = try val.elems_set(r, o, (at as u64) + 1, v)
        }
        return true
    }
    // SameValueZero puts -0 and +0 together; the key stored is +0.
    var k: Gc[JsVal] = key
    if val.val_tag(k) == val.TAG_NUM && math.math_bits(val.num_value(k)) == 0x8000000000000000 {
        k = try val.realm_num(r, 0.0)
    }
    let ok1: bool = try val.elems_push(r, o, k)
    if paired {
        let ok2: bool = try val.elems_push(r, o, v)
    }
    return true
}

// ----------------------------------------------------------------- JSON

fn json_fn(r: Gc[Realm], id: u64, args: Gc[GcVec]) -> AllocError!Gc[JsVal] {
    if id == B_JSON_STRINGIFY {
        var indent: u64 = 0
        let sp: Gc[JsVal] = arg(r, args, 2)
        if val.val_tag(sp) == val.TAG_NUM {
            let x: f64 = val.num_value(sp)
            if x > 0.0 {
                indent = x as u64
                if indent > 10 {
                    indent = 10
                }
            }
        }
        let out: Gc[JsStr] = try val.str_new(r)
        var wrote: bool = false
        let ok: bool = try json_write(r, out, arg(r, args, 0), indent, 0, &wrote)
        if thrown(r) {
            return val.realm_undefined(r)
        }
        if !wrote {
            return val.realm_undefined(r)
        }
        let ov: Gc[JsVal] = out
        return ov
    }
    let s: Gc[JsVal] = try interp.to_string(r, arg(r, args, 0))
    if thrown(r) {
        return val.realm_undefined(r)
    }
    var pos: u64 = 0
    let v: Gc[JsVal] = try json_read(r, s, &pos)
    if thrown(r) {
        return val.realm_undefined(r)
    }
    json_skip_ws(s, &pos)
    if pos != val.str_len(s) {
        var m: [u8; 26] = "Unexpected token in JSON  "
        return interp.throw_error(r, interp.ERR_SYNTAX, &m[0], 24)
    }
    return v
}

fn json_push_ascii(out: Gc[JsStr], p: *mut u8, n: usize) -> AllocError!bool {
    var i: usize = 0
    while i < n {
        let ok: bool = try val.str_push(out, (*((p as usize + i) as *mut u8)) as u32)
        i = i + 1
    }
    return true
}

fn json_nl(r: Gc[Realm], out: Gc[JsStr], indent: u64,
    depth: u64) -> AllocError!bool {
    if indent == 0 {
        return true
    }
    let ok: bool = try val.str_push(out, 10 as u32)
    var i: u64 = 0
    while i < indent * depth {
        let ok2: bool = try val.str_push(out, 32 as u32)
        i = i + 1
    }
    return true
}

fn json_quote(r: Gc[Realm], out: Gc[JsStr], s: Gc[JsVal]) -> AllocError!bool {
    let ok0: bool = try val.str_push(out, 34 as u32)
    var i: u64 = 0
    while i < val.str_len(s) {
        let c: u32 = val.str_at(s, i)
        if c == 34 as u32 || c == 92 as u32 {
            let ok: bool = try val.str_push(out, 92 as u32)
            let ok2: bool = try val.str_push(out, c)
        } else if c == 10 as u32 {
            var e: [u8; 2] = "\\n"
            let ok: bool = try json_push_ascii(out, &e[0], 2)
        } else if c == 13 as u32 {
            var e: [u8; 2] = "\\r"
            let ok: bool = try json_push_ascii(out, &e[0], 2)
        } else if c == 9 as u32 {
            var e: [u8; 2] = "\\t"
            let ok: bool = try json_push_ascii(out, &e[0], 2)
        } else if c == 8 as u32 {
            var e: [u8; 2] = "\\b"
            let ok: bool = try json_push_ascii(out, &e[0], 2)
        } else if c == 12 as u32 {
            var e: [u8; 2] = "\\f"
            let ok: bool = try json_push_ascii(out, &e[0], 2)
        } else if c < 32 as u32 || (c >= 0xD800 as u32 && c <= 0xDFFF as u32) {
            var e: [u8; 2] = "\\u"
            let ok: bool = try json_push_ascii(out, &e[0], 2)
            var k: i64 = 3
            while k >= 0 {
                let d: u32 = (c >> (4 * k as u32)) & 15 as u32
                let ok2: bool = try val.str_push(out, dig_char(d) as u32)
                k = k - 1
            }
        } else {
            let ok: bool = try val.str_push(out, c)
        }
        i = i + 1
    }
    let ok3: bool = try val.str_push(out, 34 as u32)
    return true
}

// 25.5.2 SerializeJSONProperty. `wrote` says whether anything came out at
// all -- `undefined` and a function produce NOTHING, not "undefined".
fn json_write(r: Gc[Realm], out: Gc[JsStr], v0: Gc[JsVal], indent: u64,
    depth: u64, wrote: *mut bool) -> AllocError!bool {
    *wrote = false
    var v: Gc[JsVal] = v0
    // toJSON is honoured (25.5.2 step 2).
    if val.val_tag(v) == val.TAG_OBJ {
        var tj: [u8; 6] = "toJSON"
        let k: u64 = try key_ascii(r, &tj[0], 6)
        let f: Gc[JsVal] = try interp.get_prop(r, v, k)
        if val.is_callable(f) {
            let ca: Gc[GcVec] = try interp.args_new(r)
            v = try interp.call_function(r, f, v, ca)
            if thrown(r) {
                return false
            }
        }
    }
    let t: u64 = val.val_tag(v)
    if t == val.TAG_NULL {
        var m: [u8; 4] = "null"
        let ok: bool = try json_push_ascii(out, &m[0], 4)
        *wrote = true
        return true
    }
    if t == val.TAG_BOOL {
        if val.bool_value(v) {
            var m: [u8; 4] = "true"
            let ok: bool = try json_push_ascii(out, &m[0], 4)
        } else {
            var m2: [u8; 5] = "false"
            let ok: bool = try json_push_ascii(out, &m2[0], 5)
        }
        *wrote = true
        return true
    }
    if t == val.TAG_NUM {
        let x: f64 = val.num_value(v)
        if !math.is_finite(x) {
            var m: [u8; 4] = "null"
            let ok: bool = try json_push_ascii(out, &m[0], 4)
        } else {
            let s: Gc[JsVal] = try interp.number_to_string(r, x)
            var i: u64 = 0
            while i < val.str_len(s) {
                let ok: bool = try val.str_push(out, val.str_at(s, i))
                i = i + 1
            }
        }
        *wrote = true
        return true
    }
    if t == val.TAG_STR {
        let ok: bool = try json_quote(r, out, v)
        *wrote = true
        return true
    }
    if t != val.TAG_OBJ {
        return true
    }
    if val.is_callable(v) {
        return true
    }
    let o: Gc[JsObj] = val.as_obj(v)
    // A boxed primitive is serialized as the primitive.
    if o.cls == val.CLS_NUMBER || o.cls == val.CLS_STRING || o.cls == val.CLS_BOOLEAN {
        return json_write(r, out, o.prim, indent, depth, wrote)
    }
    if o.cls == val.CLS_ARRAY {
        let ok0: bool = try val.str_push(out, 91 as u32)
        var i: u64 = 0
        while i < o.len {
            if i > 0 {
                let ok: bool = try val.str_push(out, 44 as u32)
            }
            let ok1: bool = try json_nl(r, out, indent, depth + 1)
            let e: Gc[JsVal] = try aget(r, v, i)
            if thrown(r) {
                return false
            }
            var w: bool = false
            let ok2: bool = try json_write(r, out, e, indent, depth + 1, &w)
            if thrown(r) {
                return false
            }
            if !w {
                var m: [u8; 4] = "null"
                let ok3: bool = try json_push_ascii(out, &m[0], 4)
            }
            i = i + 1
        }
        if o.len > 0 {
            let ok: bool = try json_nl(r, out, indent, depth)
        }
        let ok4: bool = try val.str_push(out, 93 as u32)
        *wrote = true
        return true
    }
    let ok0: bool = try val.str_push(out, 123 as u32)
    let keys: Gc[GcVec] = try val.obj_own_string_keys(r, o)
    var first: bool = true
    var i: u64 = 0
    while i < gcvec_length(keys) {
        let k: u64 = gcvec_read_raw(keys, i)
        var enumerable: bool = true
        let p: Gc[Prop] = val.obj_get_own(o, k)
        if (p as u64) != 0 {
            enumerable = val.prop_attrs(p) & val.A_ENUMERABLE != 0
        }
        if enumerable {
            let pv: Gc[JsVal] = try interp.get_prop(r, v, k)
            if thrown(r) {
                return false
            }
            // Look ahead: a value that writes nothing drops the key too.
            let probe: Gc[JsStr] = try val.str_new(r)
            var w: bool = false
            let okp: bool = try json_write(r, probe, pv, indent, depth + 1, &w)
            if thrown(r) {
                return false
            }
            if w {
                if !first {
                    let ok: bool = try val.str_push(out, 44 as u32)
                }
                first = false
                let ok1: bool = try json_nl(r, out, indent, depth + 1)
                let ok2: bool = try json_quote(r, out, val.key_name_str(r, k))
                let ok3: bool = try val.str_push(out, 58 as u32)
                if indent > 0 {
                    let ok4: bool = try val.str_push(out, 32 as u32)
                }
                var j: u64 = 0
                while j < val.str_len(probe) {
                    let ok5: bool = try val.str_push(out, val.str_at(probe, j))
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    if !first {
        let ok: bool = try json_nl(r, out, indent, depth)
    }
    let ok5: bool = try val.str_push(out, 125 as u32)
    *wrote = true
    return true
}

fn json_skip_ws(s: Gc[JsVal], pos: *mut u64) {
    while *pos < val.str_len(s) {
        let c: u32 = val.str_at(s, *pos)
        if c != 32 as u32 && c != 9 as u32 && c != 10 as u32 && c != 13 as u32 {
            return
        }
        *pos = *pos + 1
    }
}

fn json_syntax(r: Gc[Realm]) -> AllocError!Gc[JsVal] {
    var m: [u8; 24] = "Unexpected token in JSON"
    return interp.throw_error(r, interp.ERR_SYNTAX, &m[0], 24)
}

fn json_read(r: Gc[Realm], s: Gc[JsVal], pos: *mut u64) -> AllocError!Gc[JsVal] {
    json_skip_ws(s, pos)
    if *pos >= val.str_len(s) {
        return json_syntax(r)
    }
    let c: u32 = val.str_at(s, *pos)
    if c == 123 as u32 {
        *pos = *pos + 1
        let o: Gc[JsObj] = try val.obj_new(r)
        let ov: Gc[JsVal] = o
        json_skip_ws(s, pos)
        if *pos < val.str_len(s) && val.str_at(s, *pos) == 125 as u32 {
            *pos = *pos + 1
            return ov
        }
        while true {
            json_skip_ws(s, pos)
            if *pos >= val.str_len(s) || val.str_at(s, *pos) != 34 as u32 {
                return json_syntax(r)
            }
            let key: Gc[JsVal] = try json_string(r, s, pos)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            json_skip_ws(s, pos)
            if *pos >= val.str_len(s) || val.str_at(s, *pos) != 58 as u32 {
                return json_syntax(r)
            }
            *pos = *pos + 1
            let v: Gc[JsVal] = try json_read(r, s, pos)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let k: u64 = try val.key_for_str(r, key)
            let ok: bool = try interp.define_value(r, o, k, v, val.A_DEFAULT)
            json_skip_ws(s, pos)
            if *pos < val.str_len(s) && val.str_at(s, *pos) == 44 as u32 {
                *pos = *pos + 1
                continue
            }
            if *pos < val.str_len(s) && val.str_at(s, *pos) == 125 as u32 {
                *pos = *pos + 1
                return ov
            }
            return json_syntax(r)
        }
    }
    if c == 91 as u32 {
        *pos = *pos + 1
        let a: Gc[JsObj] = try val.array_new(r)
        let av: Gc[JsVal] = a
        json_skip_ws(s, pos)
        if *pos < val.str_len(s) && val.str_at(s, *pos) == 93 as u32 {
            *pos = *pos + 1
            return av
        }
        while true {
            let v: Gc[JsVal] = try json_read(r, s, pos)
            if thrown(r) {
                return val.realm_undefined(r)
            }
            let ok: bool = try val.elems_push(r, a, v)
            a.len = a.len + 1
            json_skip_ws(s, pos)
            if *pos < val.str_len(s) && val.str_at(s, *pos) == 44 as u32 {
                *pos = *pos + 1
                continue
            }
            if *pos < val.str_len(s) && val.str_at(s, *pos) == 93 as u32 {
                *pos = *pos + 1
                return av
            }
            return json_syntax(r)
        }
    }
    if c == 34 as u32 {
        return json_string(r, s, pos)
    }
    if c == 116 as u32 {
        let ok: bool = try json_word(r, s, pos, 4)
        if !ok {
            return json_syntax(r)
        }
        return val.realm_bool(r, true)
    }
    if c == 102 as u32 {
        let ok: bool = try json_word(r, s, pos, 5)
        if !ok {
            return json_syntax(r)
        }
        return val.realm_bool(r, false)
    }
    if c == 110 as u32 {
        let ok: bool = try json_word(r, s, pos, 4)
        if !ok {
            return json_syntax(r)
        }
        return val.realm_null(r)
    }
    // A number.
    var buf: mem.Buf = mem.buf_new()
    mem.buf_init(&buf)
    var start: u64 = *pos
    if val.str_at(s, *pos) == 45 as u32 {
        mem.buf_push(&buf, 45 as u8)
        *pos = *pos + 1
    }
    while *pos < val.str_len(s) {
        let d: u32 = val.str_at(s, *pos)
        if (d >= 48 as u32 && d <= 57 as u32) || d == 46 as u32 || d == 101 as u32 || d == 69 as u32 || d == 43 as u32 || d == 45 as u32 {
            mem.buf_push(&buf, d as u8)
            *pos = *pos + 1
        } else {
            break
        }
    }
    if mem.buf_len(&buf) == 0 {
        mem.buf_free(&buf)
        return json_syntax(r)
    }
    var bits: u64 = 0
    let ok2: bool = num.text_to_f64_bits(mem.buf_ptr(&buf), mem.buf_len(&buf), &bits)
    mem.buf_free(&buf)
    if !ok2 {
        return json_syntax(r)
    }
    return val.realm_num(r, math.math_f64(bits))
}

fn json_word(r: Gc[Realm], s: Gc[JsVal], pos: *mut u64,
    n: u64) -> AllocError!bool {
    if *pos + n > val.str_len(s) {
        return false
    }
    *pos = *pos + n
    return true
}

fn json_string(r: Gc[Realm], s: Gc[JsVal], pos: *mut u64) -> AllocError!Gc[JsVal] {
    *pos = *pos + 1
    let out: Gc[JsStr] = try val.str_new(r)
    while true {
        if *pos >= val.str_len(s) {
            return json_syntax(r)
        }
        let c: u32 = val.str_at(s, *pos)
        if c == 34 as u32 {
            *pos = *pos + 1
            let ov: Gc[JsVal] = out
            return ov
        }
        if c < 32 as u32 {
            return json_syntax(r)
        }
        if c == 92 as u32 {
            *pos = *pos + 1
            if *pos >= val.str_len(s) {
                return json_syntax(r)
            }
            let e: u32 = val.str_at(s, *pos)
            *pos = *pos + 1
            if e == 110 as u32 {
                let ok: bool = try val.str_push(out, 10 as u32)
            } else if e == 116 as u32 {
                let ok: bool = try val.str_push(out, 9 as u32)
            } else if e == 114 as u32 {
                let ok: bool = try val.str_push(out, 13 as u32)
            } else if e == 98 as u32 {
                let ok: bool = try val.str_push(out, 8 as u32)
            } else if e == 102 as u32 {
                let ok: bool = try val.str_push(out, 12 as u32)
            } else if e == 117 as u32 {
                var v: u32 = 0
                var k: u64 = 0
                while k < 4 {
                    if *pos >= val.str_len(s) {
                        return json_syntax(r)
                    }
                    let d: u32 = dig(val.str_at(s, *pos))
                    if d > 15 as u32 {
                        return json_syntax(r)
                    }
                    v = v * 16 as u32 + d
                    *pos = *pos + 1
                    k = k + 1
                }
                let ok: bool = try val.str_push(out, v)
            } else if e == 34 as u32 || e == 92 as u32 || e == 47 as u32 {
                let ok: bool = try val.str_push(out, e)
            } else {
                return json_syntax(r)
            }
            continue
        }
        let ok: bool = try val.str_push(out, c)
        *pos = *pos + 1
    }
    let ov: Gc[JsVal] = out
    return ov
}

// ========================================================= The installation
//
// The order matters: Object.prototype first (everything hangs on it), then
// Function.prototype (every function object needs it), only then the rest.

fn install(r: Gc[Realm]) -> AllocError!Gc[JsObj] {
    let op: Gc[JsObj] = try val.obj_new_proto(r, gc_null[JsObj]())
    val.realm_set_proto(r, val.PROTO_OBJECT, op)
    let fp: Gc[JsObj] = try val.obj_new_proto(r, op)
    fp.cls = val.CLS_NATIVE
    fp.native = 9001
    val.realm_set_proto(r, val.PROTO_FUNCTION, fp)
    var i: u64 = 0
    while i < val.PROTO_COUNT {
        if i != val.PROTO_OBJECT && i != val.PROTO_FUNCTION {
            var base: Gc[JsObj] = op
            if i == val.PROTO_TYPE_ERROR || i == val.PROTO_RANGE_ERROR || i == val.PROTO_SYNTAX_ERROR || i == val.PROTO_REFERENCE_ERROR || i == val.PROTO_EVAL_ERROR || i == val.PROTO_URI_ERROR {
                base = val.realm_proto(r, val.PROTO_ERROR)
                if (base as u64) == 0 {
                    base = op
                }
            }
            let p: Gc[JsObj] = try val.obj_new_proto(r, base)
            val.realm_set_proto(r, i, p)
        }
        i = i + 1
    }
    // The error prototypes have to come after PROTO_ERROR exists.
    i = val.PROTO_TYPE_ERROR
    while i <= val.PROTO_URI_ERROR {
        val.obj_set_proto(val.realm_proto(r, i), val.realm_proto(r, val.PROTO_ERROR))
        i = i + 1
    }
    let g: Gc[JsObj] = try val.obj_new_proto(r, op)
    let gv: Gc[JsVal] = g
    let genv: Gc[Env] = try val.env_new(r, gc_null[Env](), val.ENV_GLOBAL)
    genv.obj = g
    val.env_set_this(genv, gv, gc_null[JsObj]())
    val.realm_set_global(r, g, genv)

    // The well known symbols.
    var si: [u8; 15] = "Symbol.iterator"
    let sid: Gc[JsVal] = try val.str_from_ascii(r, &si[0], 15)
    let symi: Gc[JsVal] = try val.sym_new(r, sid)
    val.realm_set_well_known(r, val.WELL_KNOWN_ITERATOR, symi)
    var sp2: [u8; 18] = "Symbol.toPrimitive"
    let spd: Gc[JsVal] = try val.str_from_ascii(r, &sp2[0], 18)
    let symp: Gc[JsVal] = try val.sym_new(r, spd)
    val.realm_set_well_known(r, val.WELL_KNOWN_TOPRIMITIVE, symp)

    let ok1: bool = try install_object(r, g, op)
    let ok2: bool = try install_function(r, g, fp)
    let ok3: bool = try install_array(r, g)
    let ok4: bool = try install_string(r, g)
    let ok5: bool = try install_number(r, g)
    let ok6: bool = try install_misc(r, g)
    let ok7: bool = try install_errors(r, g)
    let ok8: bool = try install_collections(r, g)
    // Round 74: the second table -- the well known symbols and their
    // protocols, the iterators, Reflect, the weak collections, the URI
    // functions and the long tail of Object/Math/Number/String/Array.
    let ok9: bool = try builtin2.install2(r)
    return g
}

// A constructor with its prototype, wired both ways.
fn ctor(r: Gc[Realm], g: Gc[JsObj], name: *mut u8, n: usize, id: u64,
    arity: u64, which: u64) -> AllocError!Gc[JsObj] {
    let f: Gc[JsObj] = try interp.make_native(r, id, arity, name, n)
    f.flags = f.flags | val.F_CTOR
    let proto: Gc[JsObj] = val.realm_proto(r, which)
    let pk: u64 = try val.key_for_name(r, lex.N_PROTOTYPE)
    let pv: Gc[JsVal] = proto
    let ok1: bool = try interp.define_value(r, f, pk, pv, 0)
    let ck: u64 = try val.key_for_name(r, lex.N_CONSTRUCTOR)
    let cv: Gc[JsVal] = f
    let ok2: bool = try interp.define_value(r, proto, ck, cv,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let ok3: bool = try put(r, g, name, n, cv, val.A_WRITABLE | val.A_CONFIGURABLE)
    return f
}

fn install_object(r: Gc[Realm], g: Gc[JsObj], op: Gc[JsObj]) -> AllocError!bool {
    var nm: [u8; 6] = "Object"
    let c: Gc[JsObj] = try ctor(r, g, &nm[0], 6, B_OBJECT_CTOR, 1, val.PROTO_OBJECT)
    var a1: [u8; 4] = "keys"
    var a2: [u8; 6] = "values"
    var a3: [u8; 7] = "entries"
    var a4: [u8; 14] = "getPrototypeOf"
    var a5: [u8; 14] = "setPrototypeOf"
    var a6: [u8; 14] = "defineProperty"
    var a7: [u8; 24] = "getOwnPropertyDescriptor"
    var a8: [u8; 19] = "getOwnPropertyNames"
    var a9: [u8; 6] = "create"
    var a10: [u8; 6] = "assign"
    var a11: [u8; 6] = "freeze"
    var a12: [u8; 8] = "isFrozen"
    var a13: [u8; 17] = "preventExtensions"
    var a14: [u8; 12] = "isExtensible"
    var a15: [u8; 2] = "is"
    var a16: [u8; 4] = "seal"
    var a17: [u8; 8] = "isSealed"
    var a18: [u8; 16] = "defineProperties"
    let k1: bool = try nat(r, c, &a1[0], 4, B_OBJ_KEYS, 1)
    let k2: bool = try nat(r, c, &a2[0], 6, B_OBJ_VALUES, 1)
    let k3: bool = try nat(r, c, &a3[0], 7, B_OBJ_ENTRIES, 1)
    let k4: bool = try nat(r, c, &a4[0], 14, B_OBJ_GET_PROTO, 1)
    let k5: bool = try nat(r, c, &a5[0], 14, B_OBJ_SET_PROTO, 2)
    let k6: bool = try nat(r, c, &a6[0], 14, B_OBJ_DEFINE, 3)
    let k7: bool = try nat(r, c, &a7[0], 24, B_OBJ_GOPD, 2)
    let k8: bool = try nat(r, c, &a8[0], 19, B_OBJ_GOPN, 1)
    let k9: bool = try nat(r, c, &a9[0], 6, B_OBJ_CREATE, 2)
    let k10: bool = try nat(r, c, &a10[0], 6, B_OBJ_ASSIGN, 2)
    let k11: bool = try nat(r, c, &a11[0], 6, B_OBJ_FREEZE, 1)
    let k12: bool = try nat(r, c, &a12[0], 8, B_OBJ_IS_FROZEN, 1)
    let k13: bool = try nat(r, c, &a13[0], 17, B_OBJ_PREVENT, 1)
    let k14: bool = try nat(r, c, &a14[0], 12, B_OBJ_IS_EXT, 1)
    let k15: bool = try nat(r, c, &a15[0], 2, B_OBJ_IS, 2)
    let k16: bool = try nat(r, c, &a16[0], 4, B_OBJ_SEAL, 1)
    let k17: bool = try nat(r, c, &a17[0], 8, B_OBJ_IS_SEALED, 1)
    let k18: bool = try nat(r, c, &a18[0], 16, B_OBJ_DEFINE_MANY, 2)
    var p1: [u8; 8] = "toString"
    var p2: [u8; 7] = "valueOf"
    var p3: [u8; 14] = "hasOwnProperty"
    var p4: [u8; 13] = "isPrototypeOf"
    var p5: [u8; 20] = "propertyIsEnumerable"
    var p6: [u8; 14] = "toLocaleString"
    let m1: bool = try nat(r, op, &p1[0], 8, B_OP_TOSTRING, 0)
    let m2: bool = try nat(r, op, &p2[0], 7, B_OP_VALUEOF, 0)
    let m3: bool = try nat(r, op, &p3[0], 14, B_OP_HASOWN, 1)
    let m4: bool = try nat(r, op, &p4[0], 13, B_OP_ISPROTOOF, 1)
    let m5: bool = try nat(r, op, &p5[0], 20, B_OP_PROPENUM, 1)
    let m6: bool = try nat(r, op, &p6[0], 14, B_OP_TOLOCALE, 0)
    return true
}

fn install_function(r: Gc[Realm], g: Gc[JsObj], fp: Gc[JsObj]) -> AllocError!bool {
    var p1: [u8; 4] = "call"
    var p2: [u8; 5] = "apply"
    var p3: [u8; 4] = "bind"
    var p4: [u8; 8] = "toString"
    let m1: bool = try nat(r, fp, &p1[0], 4, B_FUNC_CALL, 1)
    let m2: bool = try nat(r, fp, &p2[0], 5, B_FUNC_APPLY, 2)
    let m3: bool = try nat(r, fp, &p3[0], 4, B_FUNC_BIND, 1)
    let m4: bool = try nat(r, fp, &p4[0], 8, B_FUNC_TOSTRING, 0)
    var nm: [u8; 8] = "Function"
    let c: Gc[JsObj] = try ctor(r, g, &nm[0], 8, B_FUNC_CTOR, 1, val.PROTO_FUNCTION)
    let lk: u64 = try val.key_for_name(r, lex.N_LENGTH)
    let lv: Gc[JsVal] = try val.realm_num(r, 0.0)
    let ok: bool = try interp.define_value(r, fp, lk, lv, val.A_CONFIGURABLE)
    let nk: u64 = try val.key_for_name(r, lex.N_NAME)
    let ok2: bool = try interp.define_value(r, fp, nk, val.str_empty(r),
        val.A_CONFIGURABLE)
    return true
}

fn install_array(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    var nm: [u8; 5] = "Array"
    let c: Gc[JsObj] = try ctor(r, g, &nm[0], 5, B_ARRAY_CTOR, 1, val.PROTO_ARRAY)
    let ap: Gc[JsObj] = val.realm_proto(r, val.PROTO_ARRAY)
    var s1: [u8; 7] = "isArray"
    var s2: [u8; 2] = "of"
    var s3: [u8; 4] = "from"
    let k1: bool = try nat(r, c, &s1[0], 7, B_ARR_ISARRAY, 1)
    let k2: bool = try nat(r, c, &s2[0], 2, B_ARR_OF, 0)
    let k3: bool = try nat(r, c, &s3[0], 4, B_ARR_FROM, 1)
    var n01: [u8; 4] = "push"
    var n02: [u8; 3] = "pop"
    var n03: [u8; 5] = "shift"
    var n04: [u8; 7] = "unshift"
    var n05: [u8; 5] = "slice"
    var n06: [u8; 6] = "splice"
    var n07: [u8; 6] = "concat"
    var n08: [u8; 4] = "join"
    var n09: [u8; 7] = "indexOf"
    var n10: [u8; 11] = "lastIndexOf"
    var n11: [u8; 8] = "includes"
    var n12: [u8; 7] = "forEach"
    var n13: [u8; 3] = "map"
    var n14: [u8; 6] = "filter"
    var n15: [u8; 6] = "reduce"
    var n16: [u8; 11] = "reduceRight"
    var n17: [u8; 4] = "some"
    var n18: [u8; 5] = "every"
    var n19: [u8; 4] = "sort"
    var n20: [u8; 7] = "reverse"
    var n21: [u8; 4] = "fill"
    var n22: [u8; 4] = "find"
    var n23: [u8; 9] = "findIndex"
    var n24: [u8; 8] = "toString"
    let m01: bool = try nat(r, ap, &n01[0], 4, B_AP_PUSH, 1)
    let m02: bool = try nat(r, ap, &n02[0], 3, B_AP_POP, 0)
    let m03: bool = try nat(r, ap, &n03[0], 5, B_AP_SHIFT, 0)
    let m04: bool = try nat(r, ap, &n04[0], 7, B_AP_UNSHIFT, 1)
    let m05: bool = try nat(r, ap, &n05[0], 5, B_AP_SLICE, 2)
    let m06: bool = try nat(r, ap, &n06[0], 6, B_AP_SPLICE, 2)
    let m07: bool = try nat(r, ap, &n07[0], 6, B_AP_CONCAT, 1)
    let m08: bool = try nat(r, ap, &n08[0], 4, B_AP_JOIN, 1)
    let m09: bool = try nat(r, ap, &n09[0], 7, B_AP_INDEXOF, 1)
    let m10: bool = try nat(r, ap, &n10[0], 11, B_AP_LASTINDEXOF, 1)
    let m11: bool = try nat(r, ap, &n11[0], 8, B_AP_INCLUDES, 1)
    let m12: bool = try nat(r, ap, &n12[0], 7, B_AP_FOREACH, 1)
    let m13: bool = try nat(r, ap, &n13[0], 3, B_AP_MAP, 1)
    let m14: bool = try nat(r, ap, &n14[0], 6, B_AP_FILTER, 1)
    let m15: bool = try nat(r, ap, &n15[0], 6, B_AP_REDUCE, 1)
    let m16: bool = try nat(r, ap, &n16[0], 11, B_AP_REDUCERIGHT, 1)
    let m17: bool = try nat(r, ap, &n17[0], 4, B_AP_SOME, 1)
    let m18: bool = try nat(r, ap, &n18[0], 5, B_AP_EVERY, 1)
    let m19: bool = try nat(r, ap, &n19[0], 4, B_AP_SORT, 1)
    let m20: bool = try nat(r, ap, &n20[0], 7, B_AP_REVERSE, 0)
    let m21: bool = try nat(r, ap, &n21[0], 4, B_AP_FILL, 1)
    let m22: bool = try nat(r, ap, &n22[0], 4, B_AP_FIND, 1)
    let m23: bool = try nat(r, ap, &n23[0], 9, B_AP_FINDINDEX, 1)
    let m24: bool = try nat(r, ap, &n24[0], 8, B_AP_TOSTRING, 0)
    return true
}

fn install_string(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
