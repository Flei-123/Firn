    let m23: bool = try nat(r, sp, &n23[0], 7, B_SP_REPLACE, 2)
    return true
}

fn install_number(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    var nm: [u8; 6] = "Number"
    let c: Gc[JsObj] = try ctor(r, g, &nm[0], 6, B_NUMBER_CTOR, 1, val.PROTO_NUMBER)
    let np: Gc[JsObj] = val.realm_proto(r, val.PROTO_NUMBER)
    np.cls = val.CLS_NUMBER
    np.prim = try val.realm_num(r, 0.0)
    var s1: [u8; 5] = "isNaN"
    var s2: [u8; 8] = "isFinite"
    var s3: [u8; 9] = "isInteger"
    var s4: [u8; 13] = "isSafeInteger"
    var s5: [u8; 8] = "parseInt"
    var s6: [u8; 10] = "parseFloat"
    let k1: bool = try nat(r, c, &s1[0], 5, B_NUM_ISNAN, 1)
    let k2: bool = try nat(r, c, &s2[0], 8, B_NUM_ISFINITE, 1)
    let k3: bool = try nat(r, c, &s3[0], 9, B_NUM_ISINTEGER, 1)
    let k4: bool = try nat(r, c, &s4[0], 13, B_NUM_ISSAFE, 1)
    let k5: bool = try nat(r, c, &s5[0], 8, B_PARSE_INT, 2)
    let k6: bool = try nat(r, c, &s6[0], 10, B_PARSE_FLOAT, 1)
    var c1: [u8; 16] = "MAX_SAFE_INTEGER"
    var c2: [u8; 16] = "MIN_SAFE_INTEGER"
    var c3: [u8; 9] = "MAX_VALUE"
    var c4: [u8; 9] = "MIN_VALUE"
    var c5: [u8; 7] = "EPSILON"
    var c6: [u8; 17] = "POSITIVE_INFINITY"
    var c7: [u8; 17] = "NEGATIVE_INFINITY"
    var c8: [u8; 3] = "NaN"
    let d1: bool = try put_num(r, c, &c1[0], 16, max_safe_integer(), 0)
    let d2: bool = try put_num(r, c, &c2[0], 16,
        math.math_f64(math.math_bits(max_safe_integer()) ^ 0x8000000000000000), 0)
    let d3: bool = try put_num(r, c, &c3[0], 9,
        math.math_f64(0x7FEFFFFFFFFFFFFF), 0)
    let d4: bool = try put_num(r, c, &c4[0], 9, math.math_f64(1), 0)
    let d5: bool = try put_num(r, c, &c5[0], 7, math.math_f64(0x3CB0000000000000), 0)
    let d6: bool = try put_num(r, c, &c6[0], 17, math.math_f64(0x7FF0000000000000), 0)
    let d7: bool = try put_num(r, c, &c7[0], 17, math.math_f64(0xFFF0000000000000), 0)
    let d8: bool = try put_num(r, c, &c8[0], 3, math.math_f64(0x7FF8000000000000), 0)
    var p1: [u8; 8] = "toString"
    var p2: [u8; 7] = "valueOf"
    var p3: [u8; 7] = "toFixed"
    var p4: [u8; 14] = "toLocaleString"
    let m1: bool = try nat(r, np, &p1[0], 8, B_NP_TOSTRING, 1)
    let m2: bool = try nat(r, np, &p2[0], 7, B_NP_VALUEOF, 0)
    let m3: bool = try nat(r, np, &p3[0], 7, B_NP_TOFIXED, 1)
    let m4: bool = try nat(r, np, &p4[0], 14, B_NP_TOSTRING, 0)
    var bn: [u8; 7] = "Boolean"
    let bc: Gc[JsObj] = try ctor(r, g, &bn[0], 7, B_BOOLEAN_CTOR, 1,
        val.PROTO_BOOLEAN)
    let bp: Gc[JsObj] = val.realm_proto(r, val.PROTO_BOOLEAN)
    bp.cls = val.CLS_BOOLEAN
    bp.prim = val.realm_bool(r, false)
    var q1: [u8; 8] = "toString"
    var q2: [u8; 7] = "valueOf"
    let n1: bool = try nat(r, bp, &q1[0], 8, B_BP_TOSTRING, 0)
    let n2: bool = try nat(r, bp, &q2[0], 7, B_BP_VALUEOF, 0)
    return true
}

fn install_misc(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    // Math -- an ordinary object, not a constructor (21.3).
    let m: Gc[JsObj] = try val.obj_new(r)
    var mn: [u8; 4] = "Math"
    let mv: Gc[JsVal] = m
    let om: bool = try put(r, g, &mn[0], 4, mv, val.A_WRITABLE | val.A_CONFIGURABLE)
    var f01: [u8; 3] = "abs"
    var f02: [u8; 5] = "floor"
    var f03: [u8; 4] = "ceil"
    var f04: [u8; 5] = "round"
    var f05: [u8; 5] = "trunc"
    var f06: [u8; 4] = "sqrt"
    var f07: [u8; 3] = "pow"
    var f08: [u8; 3] = "min"
    var f09: [u8; 3] = "max"
    var f10: [u8; 4] = "sign"
    var f11: [u8; 3] = "exp"
    var f12: [u8; 3] = "log"
    var f13: [u8; 4] = "log2"
    var f14: [u8; 5] = "log10"
    var f15: [u8; 3] = "sin"
    var f16: [u8; 3] = "cos"
    var f17: [u8; 3] = "tan"
    var f18: [u8; 4] = "atan"
    var f19: [u8; 5] = "atan2"
    var f20: [u8; 5] = "hypot"
    var f21: [u8; 4] = "cbrt"
    let k01: bool = try nat(r, m, &f01[0], 3, B_MATH_BASE + M_ABS, 1)
    let k02: bool = try nat(r, m, &f02[0], 5, B_MATH_BASE + M_FLOOR, 1)
    let k03: bool = try nat(r, m, &f03[0], 4, B_MATH_BASE + M_CEIL, 1)
    let k04: bool = try nat(r, m, &f04[0], 5, B_MATH_BASE + M_ROUND, 1)
    let k05: bool = try nat(r, m, &f05[0], 5, B_MATH_BASE + M_TRUNC, 1)
    let k06: bool = try nat(r, m, &f06[0], 4, B_MATH_BASE + M_SQRT, 1)
    let k07: bool = try nat(r, m, &f07[0], 3, B_MATH_BASE + M_POW, 2)
    let k08: bool = try nat(r, m, &f08[0], 3, B_MATH_BASE + M_MIN, 2)
    let k09: bool = try nat(r, m, &f09[0], 3, B_MATH_BASE + M_MAX, 2)
    let k10: bool = try nat(r, m, &f10[0], 4, B_MATH_BASE + M_SIGN, 1)
    let k11: bool = try nat(r, m, &f11[0], 3, B_MATH_BASE + M_EXP, 1)
    let k12: bool = try nat(r, m, &f12[0], 3, B_MATH_BASE + M_LOG, 1)
    let k13: bool = try nat(r, m, &f13[0], 4, B_MATH_BASE + M_LOG2, 1)
    let k14: bool = try nat(r, m, &f14[0], 5, B_MATH_BASE + M_LOG10, 1)
    let k15: bool = try nat(r, m, &f15[0], 3, B_MATH_BASE + M_SIN, 1)
    let k16: bool = try nat(r, m, &f16[0], 3, B_MATH_BASE + M_COS, 1)
    let k17: bool = try nat(r, m, &f17[0], 3, B_MATH_BASE + M_TAN, 1)
    let k18: bool = try nat(r, m, &f18[0], 4, B_MATH_BASE + M_ATAN, 1)
    let k19: bool = try nat(r, m, &f19[0], 5, B_MATH_BASE + M_ATAN2, 2)
    let k20: bool = try nat(r, m, &f20[0], 5, B_MATH_BASE + M_HYPOT, 2)
    let k21: bool = try nat(r, m, &f21[0], 4, B_MATH_BASE + M_CBRT, 1)
    var c1: [u8; 2] = "PI"
    var c2: [u8; 1] = "E"
    var c3: [u8; 3] = "LN2"
    var c4: [u8; 4] = "LN10"
    var c5: [u8; 5] = "SQRT2"
    let d1: bool = try put_num(r, m, &c1[0], 2, math.PI(), 0)
    let d2: bool = try put_num(r, m, &c2[0], 1, math.E(), 0)
    let d3: bool = try put_num(r, m, &c3[0], 3, math.LN2(), 0)
    let d4: bool = try put_num(r, m, &c4[0], 4, math.LN10(), 0)
    let d5: bool = try put_num(r, m, &c5[0], 5, math.SQRT2(), 0)

    // JSON
    let j: Gc[JsObj] = try val.obj_new(r)
    var jn: [u8; 4] = "JSON"
    let jv: Gc[JsVal] = j
    let oj: bool = try put(r, g, &jn[0], 4, jv, val.A_WRITABLE | val.A_CONFIGURABLE)
    var j1: [u8; 9] = "stringify"
    var j2: [u8; 5] = "parse"
    let e1: bool = try nat(r, j, &j1[0], 9, B_JSON_STRINGIFY, 3)
    let e2: bool = try nat(r, j, &j2[0], 5, B_JSON_PARSE, 2)

    // The global functions and values.
    var g1: [u8; 5] = "print"
    var g2: [u8; 8] = "parseInt"
    var g3: [u8; 10] = "parseFloat"
    var g4: [u8; 5] = "isNaN"
    var g5: [u8; 8] = "isFinite"
    let h1: bool = try nat(r, g, &g1[0], 5, B_PRINT, 1)
    let h2: bool = try nat(r, g, &g2[0], 8, B_PARSE_INT, 2)
    let h3: bool = try nat(r, g, &g3[0], 10, B_PARSE_FLOAT, 1)
    let h4: bool = try nat(r, g, &g4[0], 5, B_IS_NAN, 1)
    let h5: bool = try nat(r, g, &g5[0], 8, B_IS_FINITE, 1)
    var v1: [u8; 9] = "undefined"
    var v2: [u8; 3] = "NaN"
    var v3: [u8; 8] = "Infinity"
    var v4: [u8; 10] = "globalThis"
    let i1: bool = try put(r, g, &v1[0], 9, val.realm_undefined(r), 0)
    let i2: bool = try put_num(r, g, &v2[0], 3, math.math_f64(0x7FF8000000000000), 0)
    let i3: bool = try put_num(r, g, &v3[0], 8, math.math_f64(0x7FF0000000000000), 0)
    let gv: Gc[JsVal] = g
    let i4: bool = try put(r, g, &v4[0], 10, gv, val.A_WRITABLE | val.A_CONFIGURABLE)

    // Symbol
    var sn: [u8; 6] = "Symbol"
    let sc: Gc[JsObj] = try ctor(r, g, &sn[0], 6, B_SYMBOL_CTOR, 0, val.PROTO_SYMBOL)
    sc.flags = sc.flags & (0xFFFFFFFFFFFFFFFF - val.F_CTOR)
    let syp: Gc[JsObj] = val.realm_proto(r, val.PROTO_SYMBOL)
    var y1: [u8; 8] = "iterator"
    var y2: [u8; 11] = "toPrimitive"
    let w1: bool = try put(r, sc, &y1[0], 8,
        val.realm_well_known(r, val.WELL_KNOWN_ITERATOR), 0)
    let w2: bool = try put(r, sc, &y2[0], 11,
        val.realm_well_known(r, val.WELL_KNOWN_TOPRIMITIVE), 0)
    var y3: [u8; 8] = "toString"
    var y4: [u8; 7] = "valueOf"
    let w3: bool = try nat(r, syp, &y3[0], 8, B_SYP_TOSTRING, 0)
    let w4: bool = try nat(r, syp, &y4[0], 7, B_SYP_VALUEOF, 0)
    return true
}

fn install_errors(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    var n0: [u8; 5] = "Error"
    var n1: [u8; 9] = "TypeError"
    var n2: [u8; 10] = "RangeError"
    var n3: [u8; 11] = "SyntaxError"
    var n4: [u8; 14] = "ReferenceError"
    var n5: [u8; 9] = "EvalError"
    var n6: [u8; 8] = "URIError"
    let c0: Gc[JsObj] = try ctor(r, g, &n0[0], 5, B_ERROR_BASE, 1, val.PROTO_ERROR)
    let c1: Gc[JsObj] = try ctor(r, g, &n1[0], 9, B_ERROR_BASE + 1, 1,
        val.PROTO_TYPE_ERROR)
    let c2: Gc[JsObj] = try ctor(r, g, &n2[0], 10, B_ERROR_BASE + 2, 1,
        val.PROTO_RANGE_ERROR)
    let c3: Gc[JsObj] = try ctor(r, g, &n3[0], 11, B_ERROR_BASE + 3, 1,
        val.PROTO_SYNTAX_ERROR)
    let c4: Gc[JsObj] = try ctor(r, g, &n4[0], 14, B_ERROR_BASE + 4, 1,
        val.PROTO_REFERENCE_ERROR)
    let c5: Gc[JsObj] = try ctor(r, g, &n5[0], 9, B_ERROR_BASE + 5, 1,
        val.PROTO_EVAL_ERROR)
    let c6: Gc[JsObj] = try ctor(r, g, &n6[0], 8, B_ERROR_BASE + 6, 1,
        val.PROTO_URI_ERROR)
    val.obj_set_proto(c1, c0)
    val.obj_set_proto(c2, c0)
    val.obj_set_proto(c3, c0)
    val.obj_set_proto(c4, c0)
    val.obj_set_proto(c5, c0)
    val.obj_set_proto(c6, c0)
    let ep: Gc[JsObj] = val.realm_proto(r, val.PROTO_ERROR)
    var t1: [u8; 8] = "toString"
    let m1: bool = try nat(r, ep, &t1[0], 8, B_EP_TOSTRING, 0)
    var mk: [u8; 7] = "message"
    let m2: bool = try put(r, ep, &mk[0], 7, val.str_empty(r),
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let nk: u64 = try val.key_for_name(r, lex.N_NAME)
    let e0: Gc[JsVal] = try val.str_from_ascii(r, &n0[0], 5)
    let p0: bool = try interp.define_value(r, ep, nk, e0,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let names: Gc[GcVec] = try interp.args_new(r)
    let v1: Gc[JsVal] = try val.str_from_ascii(r, &n1[0], 9)
    let v2: Gc[JsVal] = try val.str_from_ascii(r, &n2[0], 10)
    let v3: Gc[JsVal] = try val.str_from_ascii(r, &n3[0], 11)
    let v4: Gc[JsVal] = try val.str_from_ascii(r, &n4[0], 14)
    let v5: Gc[JsVal] = try val.str_from_ascii(r, &n5[0], 9)
    let v6: Gc[JsVal] = try val.str_from_ascii(r, &n6[0], 8)
    let q1: bool = try interp.define_value(r,
        val.realm_proto(r, val.PROTO_TYPE_ERROR), nk, v1,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let q2: bool = try interp.define_value(r,
        val.realm_proto(r, val.PROTO_RANGE_ERROR), nk, v2,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let q3: bool = try interp.define_value(r,
        val.realm_proto(r, val.PROTO_SYNTAX_ERROR), nk, v3,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let q4: bool = try interp.define_value(r,
        val.realm_proto(r, val.PROTO_REFERENCE_ERROR), nk, v4,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let q5: bool = try interp.define_value(r,
        val.realm_proto(r, val.PROTO_EVAL_ERROR), nk, v5,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    let q6: bool = try interp.define_value(r,
        val.realm_proto(r, val.PROTO_URI_ERROR), nk, v6,
        val.A_WRITABLE | val.A_CONFIGURABLE)
    return true
}

fn install_collections(r: Gc[Realm], g: Gc[JsObj]) -> AllocError!bool {
    var mn: [u8; 3] = "Map"
    var sn: [u8; 3] = "Set"
    let mc: Gc[JsObj] = try ctor(r, g, &mn[0], 3, B_MAP_CTOR, 0, val.PROTO_MAP)
    let sc: Gc[JsObj] = try ctor(r, g, &sn[0], 3, B_SET_CTOR, 0, val.PROTO_SET)
    let mp: Gc[JsObj] = val.realm_proto(r, val.PROTO_MAP)
    let sp: Gc[JsObj] = val.realm_proto(r, val.PROTO_SET)
    var a1: [u8; 3] = "get"
    var a2: [u8; 3] = "set"
    var a3: [u8; 3] = "has"
    var a4: [u8; 6] = "delete"
    var a5: [u8; 5] = "clear"
    var a6: [u8; 7] = "forEach"
    var a7: [u8; 3] = "add"
    var a8: [u8; 4] = "size"
    let k1: bool = try nat(r, mp, &a1[0], 3, B_MP_GET, 1)
    let k2: bool = try nat(r, mp, &a2[0], 3, B_MP_SET, 2)
    let k3: bool = try nat(r, mp, &a3[0], 3, B_MP_HAS, 1)
    let k4: bool = try nat(r, mp, &a4[0], 6, B_MP_DELETE, 1)
    let k5: bool = try nat(r, mp, &a5[0], 5, B_MP_CLEAR, 0)
    let k6: bool = try nat(r, mp, &a6[0], 7, B_MP_FOREACH, 1)
    let k7: bool = try nat(r, sp, &a7[0], 3, B_SP_ADD, 1)
    let k8: bool = try nat(r, sp, &a3[0], 3, B_SP_HAS, 1)
    let k9: bool = try nat(r, sp, &a4[0], 6, B_SP_DELETE, 1)
    let k10: bool = try nat(r, sp, &a5[0], 5, B_SP_CLEAR, 0)
    let k11: bool = try nat(r, sp, &a6[0], 7, B_SP_FOREACH, 1)
    // `size` is an accessor on both prototypes.
    var szn: [u8; 4] = "size"
    let szf: Gc[JsObj] = try interp.make_native(r, B_COLL_SIZE, 0, &szn[0], 4)
    let szv: Gc[JsVal] = szf
    let szk: u64 = try key_ascii(r, &szn[0], 4)
    let d1: bool = try interp.define_accessor(r, mp, szk, szv,
        val.realm_undefined(r), val.A_CONFIGURABLE)
    let d2: bool = try interp.define_accessor(r, sp, szk, szv,
        val.realm_undefined(r), val.A_CONFIGURABLE)
    return true
}
