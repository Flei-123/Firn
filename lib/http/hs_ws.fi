import std.rt
import std.vec
import std.net
import std.io
import std.crypto.random
import std.crypto.hmac
import std.base64
import ws.ws
import tls.tls_server
import http.hs_types
import http.hs_h2state
import http.hs_h2out
import http.hs_conn
import http.hs_reply
import http.hs_http

export {
    ws_upgrade, ws_frame, ws_fail, ws_input, ws_start, ws_live,
    ws_send, ws_send_binary, ws_close, ws_broadcast, ws_count, count_kind,
    sse_send, sse_count,
}

// ------------------------------------------------------------ WebSocket

fn ws_upgrade(a: *mut hs_types.App, r: *mut hs_types.Req, ri: usize) {
    if (*r).method != "GET" || !(*r).v11 {
        hs_reply.reply_ex(r, 405, "text/plain", "Allow: GET\r\n", "WebSocket needs GET over HTTP/1.1\n")
        return
    }
    if !hs_types.has_token(hs_reply.header(r, "Upgrade"), "websocket") || !hs_types.has_token(hs_reply.header(r, "Connection"), "upgrade") {
        hs_reply.reply_ex(r, 426, "text/plain", "Upgrade: websocket\r\n", "this path speaks WebSocket\n")
        return
    }
    if hs_reply.header(r, "Sec-WebSocket-Version") != "13" {
        hs_reply.reply_ex(r, 426, "text/plain", "Sec-WebSocket-Version: 13\r\n", "WebSocket version 13 only\n")
        return
    }
    let key: str = hs_reply.header(r, "Sec-WebSocket-Key")
    var raw: rt.Buf = rt.buf_new()
    let good: bool = base64.decode(key.p as u64, key.n, &raw) && raw.len == 16
    rt.buf_free(&raw)
    if !good {
        hs_reply.reply(r, 400, "text/plain", "bad Sec-WebSocket-Key\n")
        return
    }
    if (*a).paired {
        // Origin (when sent) has to name this very host
        let origin: str = hs_reply.header(r, "Origin")
        if origin.n > 0 {
            let host: str = hs_reply.header(r, "Host")
            let at: usize = origin.find_char(58 as u8)
            var ok: bool = at + 3 <= origin.n
            if ok { ok = origin.ab(at + 3) == host }
            if !ok {
                hs_reply.reply(r, 403, "text/plain", "cross-origin WebSocket refused\n")
                return
            }
        }
    }
    (*r).replied = true
    let c: *mut hs_types.Conn = hs_conn.conn(a, (*r).ci)
    var b: rt.Buf = rt.buf_new()
    hs_types.push_str(&b, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ")
    ws.accept_key(key, &b)
    hs_types.push_str(&b, "\r\n\r\n")
    hs_conn.conn_send(c, b.ptr, b.len)
    rt.buf_free(&b)
    (*c).kind = hs_types.K_WS
    (*c).route = ri
    (*c).in_msg = false
    (*c).close_sent = false
    (*c).fr_done = 0
    (*c).fr_started = false
    (*c).ping_ms = hs_types.now_ms()
    rt.buf_clear(&(*c).msg)
    (*r).keep = true
    (*a).requests = (*a).requests + 1
    var w: hs_types.Ws = hs_types.Ws { app: a, ci: (*r).ci, binary: false }
    let f: fn(*mut hs_types.Ws) = (*vec_elem_ptr[hs_types.Route](&(*a).routes, ri)).on_open
    f(&w)
}

fn ws_frame(c: *mut hs_types.Conn, op: u32, p: u64, n: usize) {
    var b: rt.Buf = rt.buf_new()
    ws.write_frame(&b, op, true, p, n, 0)
    hs_conn.conn_send(c, b.ptr, b.len)
    rt.buf_free(&b)
}

// Sends a close frame with `code` and ends the connection once it is out.
fn ws_fail(c: *mut hs_types.Conn, code: u32) {
    if !(*c).close_sent {
        var b: [u8; 2] = [0, 0]
        b[0] = ((code >> 8) & 255) as u8
        b[1] = (code & 255) as u8
        ws_frame(c, ws.OP_CLOSE, (&b[0]) as u64, 2)
        (*c).close_sent = true
    }
    (*c).close_after = true
}

fn ws_input(a: *mut hs_types.App, ci: usize) {
    let c: *mut hs_types.Conn = hs_conn.conn(a, ci)
    while (*c).kind == hs_types.K_WS && !(*c).dead && !(*c).close_after {
        let p: u64 = (*c).inb.ptr + (*c).inpos as u64
        let n: usize = (*c).inb.len - (*c).inpos
        var f: ws.Frame = ws.frame_new()
        let r: i32 = ws.parse_frame(p, n, &f)
        if r == ws.PARSE_MORE { return }
        if r == ws.PARSE_ERROR {
            ws_fail(c, f.err)
            return
        }
        if !f.masked {
            ws_fail(c, 1002)
            return
        }
        if f.plen > (*a).max_msg as u64 || ((*c).in_msg && (*c).msg.len as u64 + f.plen > (*a).max_msg as u64) {
            ws_fail(c, 1009)
            return
        }
        let pp: u64 = p + f.hlen as u64
        let text_frame: bool = f.op == ws.OP_TEXT
        || (f.op == ws.OP_CONT && (*c).in_msg && (*c).msg_op == ws.OP_TEXT)
        if (n as u64) < f.hlen as u64 + f.plen {
            // FAIL FAST: the text that is already here is checked now,
            // not when the last octet of the frame arrives
            if text_frame && n > f.hlen && n - f.hlen > (*c).fr_done && !(*c).close_sent {
                if !(*c).fr_started {
                    if !ws_start(c, &f) { return }
                    (*c).fr_started = true
                }
                let avail: usize = n - f.hlen
                let d0: usize = (*c).fr_done
                ws.unmask(pp + d0 as u64, avail - d0, (&f.mask[0]) as u64, d0)
                if !ws.utf8_feed(&(*c).utf, pp + d0 as u64, avail - d0) {
                    ws_fail(c, 1007)
                    return
                }
                (*c).fr_done = avail
            }
            return
        }
        let pl: usize = f.plen as usize
        let done: usize = (*c).fr_done
        let started: bool = (*c).fr_started
        (*c).fr_done = 0
        (*c).fr_started = false
        ws.unmask(pp + done as u64, pl - done, (&f.mask[0]) as u64, done)
        (*c).inpos = (*c).inpos + f.hlen + pl
        if (*c).close_sent && f.op != ws.OP_CLOSE { continue }
        if f.op == ws.OP_PING {
            ws_frame(c, ws.OP_PONG, pp, pl)
            continue
        }
        if f.op == ws.OP_PONG { continue }
        if f.op == ws.OP_CLOSE {
            if pl == 1 {
                ws_fail(c, 1002)
                return
            }
            if pl >= 2 {
                let code: u32 = ((rt.ld8(pp, 0) as u32) << 8) | (rt.ld8(pp, 1) as u32)
                if !ws.close_code_ok(code) {
                    ws_fail(c, 1002)
                    return
                }
                var u: ws.Utf8 = ws.utf8_new()
                if !ws.utf8_feed(&u, pp + 2, pl - 2) || !ws.utf8_complete(&u) {
                    ws_fail(c, 1007)
                    return
                }
                if !(*c).close_sent {
                    ws_frame(c, ws.OP_CLOSE, pp, 2)
                    (*c).close_sent = true
                }
            } else if !(*c).close_sent {
                ws_frame(c, ws.OP_CLOSE, 0, 0)
                (*c).close_sent = true
            }
            (*c).close_after = true
            return
        }
        if !started {
            if !ws_start(c, &f) { return }
        }
        rt.buf_push_bytes(&(*c).msg, pp, pl)
        if (*c).msg_op == ws.OP_TEXT && !ws.utf8_feed(&(*c).utf, pp + done as u64, pl - done) {
            ws_fail(c, 1007)
            return
        }
        if f.fin {
            if (*c).msg_op == ws.OP_TEXT && !ws.utf8_complete(&(*c).utf) {
                ws_fail(c, 1007)
                return
            }
            (*c).in_msg = false
            var w: hs_types.Ws = hs_types.Ws { app: a, ci: ci, binary: (*c).msg_op == ws.OP_BINARY }
            let rte: *mut hs_types.Route = vec_elem_ptr[hs_types.Route](&(*a).routes, (*c).route)
            let fm: fn(*mut hs_types.Ws, str) = (*rte).on_msg
            fm(&w, hs_types.as_str((*c).msg.ptr, (*c).msg.len))
            rt.buf_clear(&(*c).msg)
        }
    }
}

// The bookkeeping at the first sight of a data frame: a continuation
// needs a message, a new message must not start inside one.
fn ws_start(c: *mut hs_types.Conn, f: *mut ws.Frame) -> bool {
    if (*f).op == ws.OP_CONT {
        if !(*c).in_msg {
            ws_fail(c, 1002)
            return false
        }
        return true
    }
    if (*c).in_msg {
        ws_fail(c, 1002)
        return false
    }
    (*c).in_msg = true
    (*c).msg_op = (*f).op
    (*c).utf = ws.utf8_new()
    rt.buf_clear(&(*c).msg)
    return true
}

fn ws_live(w: *mut hs_types.Ws) -> *mut hs_types.Conn {
    let c: *mut hs_types.Conn = hs_conn.conn((*w).app, (*w).ci)
    if (*c).kind != hs_types.K_WS || (*c).close_sent || (*c).dead { return 0 as *mut hs_types.Conn }
    return c
}

// Sends a text message on this WebSocket.
fn ws_send(w: *mut hs_types.Ws, text: str) -> bool {
    let c: *mut hs_types.Conn = ws_live(w)
    if (c as u64) == 0 { return false }
    ws_frame(c, ws.OP_TEXT, text.p as u64, text.n)
    return true
}

fn ws_send_binary(w: *mut hs_types.Ws, p: u64, n: usize) -> bool {
    let c: *mut hs_types.Conn = ws_live(w)
    if (c as u64) == 0 { return false }
    ws_frame(c, ws.OP_BINARY, p, n)
    return true
}

fn ws_close(w: *mut hs_types.Ws, code: u32) {
    let c: *mut hs_types.Conn = ws_live(w)
    if (c as u64) == 0 { return }
    ws_fail(c, code)
}

// The same text to every WebSocket on `path`. Returns how many.
fn ws_broadcast(a: *mut hs_types.App, path: str, text: str) -> usize {
    let ri: usize = hs_http.find_route(a, path)
    var sent: usize = 0
    var i: usize = 0
    while i < vec_len[hs_types.Conn](&(*a).conns) {
        let c: *mut hs_types.Conn = hs_conn.conn(a, i)
        if (*c).kind == hs_types.K_WS && (*c).route == ri && !(*c).close_sent && !(*c).dead {
            ws_frame(c, ws.OP_TEXT, text.p as u64, text.n)
            sent = sent + 1
        }
        i = i + 1
    }
    return sent
}

fn ws_count(a: *mut hs_types.App, path: str) -> usize {
    return count_kind(a, path, hs_types.K_WS)
}

fn count_kind(a: *mut hs_types.App, path: str, kind: u32) -> usize {
    let ri: usize = hs_http.find_route(a, path)
    var n: usize = 0
    var i: usize = 0
    while i < vec_len[hs_types.Conn](&(*a).conns) {
        let c: *mut hs_types.Conn = hs_conn.conn(a, i)
        if (*c).kind == kind && (*c).route == ri && !(*c).dead { n = n + 1 }
        i = i + 1
    }
    return n
}

// ------------------------------------------------------------ SSE

// One event to every stream on `path`: "event: <event>" (when not empty)
// and one "data:" line per line of `data`. Returns how many got it.
fn sse_send(a: *mut hs_types.App, path: str, event: str, data: str) -> usize {
    var b: rt.Buf = rt.buf_new()
    if event.n > 0 {
        hs_types.push_str(&b, "event: ")
        hs_types.push_str(&b, event)
        rt.buf_push(&b, 10 as u8)
    }
    var i: usize = 0
    while true {
        var e: usize = i
        while e < data.n && *(data.p + e) != 10 as u8 { e = e + 1 }
        hs_types.push_str(&b, "data: ")
        rt.buf_push_bytes(&b, (data.p + i) as u64, e - i)
        rt.buf_push(&b, 10 as u8)
        if e >= data.n { break }
        i = e + 1
    }
    rt.buf_push(&b, 10 as u8)
    let ri: usize = hs_http.find_route(a, path)
    var sent: usize = 0
    var k: usize = 0
    while k < vec_len[hs_types.Conn](&(*a).conns) {
        let c: *mut hs_types.Conn = hs_conn.conn(a, k)
        if (*c).kind == hs_types.K_SSE && (*c).route == ri && !(*c).dead {
            hs_conn.conn_send(c, b.ptr, b.len)
            sent = sent + 1
        }
        if (*c).kind == hs_types.K_H2 && !(*c).dead { sent = sent + sse_h2(c, ri, b.ptr, b.len) }
        k = k + 1
    }
    rt.buf_free(&b)
    return sent
}

fn sse_h2(c: *mut hs_types.Conn, ri: usize, p: u64, n: usize) -> usize {
    var sent: usize = 0
    var i: usize = 0
    while i < hs_h2state.MAX_STREAMS {
        let s: *mut hs_h2state.H2Stream = &(*c).h2.streams[i]
        if (*s).live && (*s).sse == ri + 1 && hs_h2out.sse_push(c, s, p, n) { sent = sent + 1 }
        i = i + 1
    }
    hs_h2out.pump(c)
    return sent
}

fn sse_count(a: *mut hs_types.App, path: str) -> usize {
    let ri: usize = hs_http.find_route(a, path)
    var h2n: usize = 0
    var k: usize = 0
    while k < vec_len[hs_types.Conn](&(*a).conns) {
        let c: *mut hs_types.Conn = hs_conn.conn(a, k)
        if (*c).kind == hs_types.K_H2 && !(*c).dead {
            var i: usize = 0
            while i < hs_h2state.MAX_STREAMS {
                if (*c).h2.streams[i].live && (*c).h2.streams[i].sse == ri + 1 { h2n = h2n + 1 }
                i = i + 1
            }
        }
        k = k + 1
    }
    return h2n + count_kind(a, path, hs_types.K_SSE)
}
