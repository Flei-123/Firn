// SPDX-License-Identifier: MPL-2.0
// lib/http/server.fi -- an HTTP/1.1 SERVER with WebSocket, Server-Sent
// Events and optional TLS 1.3, in one poll loop.
//
// ============================================================ IN SHORT
//
//     import http.server as http
//
//     fn hello(r: *mut http.Req) { http.reply(r, 200, "text/plain", "hi\n") }
//     fn echo(w: *mut http.Ws, msg: str) { http.ws_send(w, msg) }
//
//     fn main() -> i32 {
//         var app: http.App = http.app(8080)
//         http.pair(&app)                       // every request needs the token
//         http.route_text(&app, "/", "text/html", PAGE)
//         http.route(&app, "/hello", hello)
//         http.route_ws(&app, "/ws", echo)
//         http.route_sse(&app, "/events")       // http.sse_send(&app, "/events", "", "data")
//         io.fmt_print_line(f"{http.url(&app)}")
//         return http.serve(&app)
//     }
//
// ============================================================ THE SHAPE
//
// ONE THREAD, NON-BLOCKING SOCKETS, poll(2). A phone that steers a laptop,
// a dashboard with a live feed: a few dozen connections that are mostly
// silent. One thread per connection (demos/mcserver) would be as many
// stacks; a poll loop holds all of them in one. Every socket is created
// with SOCK_NONBLOCK, so no call here can block except poll itself.
//
// A handler is called with the request and answers SYNCHRONOUSLY
// (`reply`). A handler that returns without answering gets a 500 -- the
// protocol does not leave a request hanging.
//
// The strings a handler sees (path, query, headers, body, a WebSocket
// message) point into the connection's buffer and are valid DURING the
// call. Whoever wants to keep one copies it.
//
// ============================================================ HTTP/1.1
//
//   * request line + header block up to 16 KiB (431 above), a body by
//     Content-Length or chunked (RFC 9112 7.1) up to `max_body` (413)
//   * Content-Length together with Transfer-Encoding, two different
//     Content-Lengths, a header name with white space before the colon,
//     an obsolete line folding: 400 -- the request smuggling vectors
//   * HTTP/1.1 without Host: 400
//   * keep-alive (1.1 by default, 1.0 with "Connection: keep-alive"),
//     pipelined requests answered in order, "Expect: 100-continue"
//   * HEAD answered without a body
//
// ============================================================ WEBSOCKET
//
// The Upgrade of RFC 6455 4.2 (426 with the version it speaks when the
// version is not 13), then frames through lib/ws/ws.fi's codec. The
// checks and close codes are listed in that file. Pings are answered,
// idle connections are pinged every 25 s, fragmented messages are
// reassembled up to `max_msg` (1009 above).
//
// ============================================================ PAIRING
//
// `pair(&app)` makes a 128-bit random token (lib/std/crypto/random.fi,
// getrandom). From then on every request has to carry it: once in the URL
// (`?t=...`, the URL the program prints) -- answered with a redirect that
// sets the cookie `firn_pair` (HttpOnly, SameSite=Strict) and drops the
// token from the address bar -- and afterwards in that cookie, which the
// browser also sends with the page's WebSocket. Without it: 403. The
// comparison is constant time. A WebSocket upgrade whose Origin names
// another host than the Host header is refused too (cross-site WebSocket
// hijacking). There is no password and no default token.
//
// ============================================================ HONEST
//
// H1 IPv4 only (lib/std/net.fi N2).
// H2 HTTP/2 (TLS+ALPN and h2c prior knowledge, docs/HTTP2.md) for plain requests; WebSocket and SSE stay HTTP/1.1.
// H3 A handler runs on the poll thread: a slow handler stalls every
//    connection for that long.
// H4 No percent-decoding of the path; `query_param` returns the raw value.
import std.rt
import http.hs_types
import http.hs_app
import http.hs_conn
import http.hs_reply
import http.hs_ws
import http.hs_http
import http.hs_loop
import http.hs_h2

export {
    App, Req, Ws, app, route, route_text, route_ws, route_ws_full,
    route_sse, every, pair, token, url, serve, run_for, step,
    stop, listen, port, tls_pem, tls_files, tls_enabled, set_h2, reply, reply_ex,
    header, query_param, cookie, method, path, query, body, ws_send,
    ws_send_binary, ws_close, ws_broadcast, ws_count, sse_send, sse_count, set_quiet, set_limits,
    route_fallback, peer_ip, peer_text, requests_served, close_server, SERVE_KIND, serve_background, serve_main,
    stop_wait, userdata, set_userdata, app_userdata,
}

type App = hs_types.App
type Req = hs_types.Req
type Ws = hs_types.Ws
const SERVE_KIND: u64 = hs_types.SERVE_KIND

fn app(port: u16) -> App { return hs_app.app(port) }
fn route(a: *mut App, path: str, handler: fn(*mut Req)) { hs_app.route(a, path, handler) }
fn route_text(a: *mut App, path: str, ctype: str, body: str) { hs_app.route_text(a, path, ctype, body) }
fn route_ws(a: *mut App, path: str, on_msg: fn(*mut Ws, str)) { hs_app.route_ws(a, path, on_msg) }
fn route_ws_full(a: *mut App, path: str, on_open: fn(*mut Ws), on_msg: fn(*mut Ws, str), on_close: fn(*mut Ws)) { hs_app.route_ws_full(a, path, on_open, on_msg, on_close) }
fn route_sse(a: *mut App, path: str) { hs_app.route_sse(a, path) }
fn every(a: *mut App, ms: i64, f: fn(*mut App)) { hs_app.every(a, ms, f) }
fn pair(a: *mut App) -> str { return hs_app.pair(a) }
fn token(a: *mut App) -> str { return hs_app.token(a) }
fn url(a: *mut App) -> str { return hs_app.url(a) }
fn serve(a: *mut App) -> i32 { return hs_loop.serve(a) }
fn run_for(a: *mut App, ms: i64) -> i32 { return hs_loop.run_for(a, ms) }
fn step(a: *mut App, timeout_ms: i64) -> bool { return hs_loop.step(a, timeout_ms) }
fn stop(a: *mut App) { hs_app.stop(a) }
fn set_h2(a: *mut App, on: bool) { hs_app.set_h2(a, on) }
fn listen(a: *mut App) -> bool { return hs_loop.listen(a) }
fn port(a: *mut App) -> u16 { return hs_loop.port(a) }
fn tls_pem(a: *mut App, cert: u64, cn: usize, key: u64, kn: usize) -> bool { return hs_app.tls_pem(a, cert, cn, key, kn) }
fn tls_files(a: *mut App, cert_path: str, key_path: str) -> bool { return hs_app.tls_files(a, cert_path, key_path) }
fn tls_enabled(a: *mut App) -> bool { return hs_app.tls_enabled(a) }
fn reply(r: *mut Req, status: u32, ctype: str, body: str) { hs_reply.reply(r, status, ctype, body) }
fn reply_ex(r: *mut Req, status: u32, ctype: str, extra: str, body: str) { hs_reply.reply_ex(r, status, ctype, extra, body) }
fn header(r: *mut Req, name: str) -> str { return hs_reply.header(r, name) }
fn query_param(r: *mut Req, name: str) -> str { return hs_reply.query_param(r, name) }
fn cookie(r: *mut Req, name: str) -> str { return hs_reply.cookie(r, name) }
fn method(r: *mut Req) -> str { return hs_reply.method(r) }
fn path(r: *mut Req) -> str { return hs_reply.path(r) }
fn query(r: *mut Req) -> str { return hs_reply.query(r) }
fn body(r: *mut Req) -> str { return hs_reply.body(r) }
fn ws_send(w: *mut Ws, text: str) -> bool { return hs_ws.ws_send(w, text) }
fn ws_send_binary(w: *mut Ws, p: u64, n: usize) -> bool { return hs_ws.ws_send_binary(w, p, n) }
fn ws_close(w: *mut Ws, code: u32) { hs_ws.ws_close(w, code) }
fn ws_broadcast(a: *mut App, path: str, text: str) -> usize { return hs_ws.ws_broadcast(a, path, text) }
fn ws_count(a: *mut App, path: str) -> usize { return hs_ws.ws_count(a, path) }
fn sse_send(a: *mut App, path: str, event: str, data: str) -> usize { return hs_ws.sse_send(a, path, event, data) }
fn sse_count(a: *mut App, path: str) -> usize { return hs_ws.sse_count(a, path) }
fn set_quiet(a: *mut App, q: bool) { hs_app.set_quiet(a, q) }
fn set_limits(a: *mut App, max_body: usize, max_msg: usize, max_conn: usize) { hs_app.set_limits(a, max_body, max_msg, max_conn) }
fn route_fallback(a: *mut App, handler: fn(*mut Req)) { hs_app.route_fallback(a, handler) }
fn peer_ip(r: *mut Req) -> u32 { return hs_reply.peer_ip(r) }
fn peer_text(r: *mut Req) -> str { return hs_reply.peer_text(r) }
fn requests_served(a: *mut App) -> u64 { return hs_app.requests_served(a) }
fn close_server(a: *mut App) { hs_loop.close_server(a) }
fn serve_background(a: *mut App) -> u64 { return hs_loop.serve_background(a) }
fn serve_main(arg: u64) -> u64 { return hs_loop.serve_main(arg) }
fn stop_wait(a: *mut App, th: u64) { hs_loop.stop_wait(a, th) }
fn userdata(r: *mut Req) -> u64 { return hs_app.userdata(r) }
fn set_userdata(a: *mut App, ud: u64) { hs_app.set_userdata(a, ud) }
fn app_userdata(a: *mut App) -> u64 { return hs_app.app_userdata(a) }
