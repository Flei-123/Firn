// SPDX-License-Identifier: MPL-2.0
import std.rt
import net.hpack
import net.h2frame as fr

export {
    H2Stream, H2Conn, h2c_new, h2c_free, stream_find, stream_open, stream_release, live_count, has_sse,
    MAX_STREAMS, RECV_WINDOW, MAX_HEADER_BLOCK, MAX_LIST, CTRL_LIMIT, OUR_FRAME,
}

const MAX_STREAMS: usize = 100
const RECV_WINDOW: i64 = 1048576
const MAX_HEADER_BLOCK: usize = 262144
const MAX_LIST: usize = 65536
const CTRL_LIMIT: u32 = 1000
const OUR_FRAME: usize = 16384

struct H2Stream {
    id: u32,
    live: bool,
    req_done: bool,
    replied: bool,
    too_big: bool,
    sse: usize,
    hdrs: rt.Buf,
    body: rt.Buf,
    out: rt.Buf,
    outpos: usize,
    send_win: i64,
    recv_win: i64,
    clen: i64,
    got: u64,
}

struct H2Conn {
    preface: bool,
    enc: hpack.Hpack,
    dec: hpack.Hpack,
    hblock: rt.Buf,
    hblock_stream: u32,
    hblock_end: bool,
    last_id: u32,
    peer_frame: usize,
    peer_init_win: i64,
    send_win: i64,
    recv_win: i64,
    ctrl: u32,
    streams: [H2Stream; 100],
}

fn stream_new() -> H2Stream {
    return H2Stream { id: 0, live: false, req_done: false, replied: false, too_big: false, sse: 0,
        hdrs: rt.buf_new(), body: rt.buf_new(), out: rt.buf_new(), outpos: 0,
        send_win: 0, recv_win: 0, clen: 0 - 1, got: 0 }
}

fn h2c_new() -> H2Conn {
    var c: H2Conn = H2Conn { preface: false, enc: hpack.hp_new(), dec: hpack.hp_new(),
        hblock: rt.buf_new(), hblock_stream: 0, hblock_end: false, last_id: 0,
        peer_frame: fr.DEFAULT_FRAME_SIZE, peer_init_win: fr.DEFAULT_WINDOW,
        send_win: fr.DEFAULT_WINDOW, recv_win: RECV_WINDOW + fr.DEFAULT_WINDOW, ctrl: 0,
        streams: [stream_new(); 100] }
    hpack.hp_set_max_list(&c.dec, MAX_LIST)
    return c
}

fn h2c_free(c: *mut H2Conn) {
    var i: usize = 0
    while i < MAX_STREAMS {
        rt.buf_free(&(*c).streams[i].hdrs)
        rt.buf_free(&(*c).streams[i].body)
        rt.buf_free(&(*c).streams[i].out)
        (*c).streams[i].live = false
        i = i + 1
    }
    rt.buf_free(&(*c).hblock)
    hpack.hp_free(&(*c).enc)
    hpack.hp_free(&(*c).dec)
}

fn stream_find(c: *mut H2Conn, id: u32) -> *mut H2Stream {
    var i: usize = 0
    while i < MAX_STREAMS {
        if (*c).streams[i].live && (*c).streams[i].id == id { return &(*c).streams[i] }
        i = i + 1
    }
    return 0 as *mut H2Stream
}

fn live_count(c: *mut H2Conn) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < MAX_STREAMS {
        if (*c).streams[i].live { n = n + 1 }
        i = i + 1
    }
    return n
}

fn has_sse(c: *mut H2Conn) -> bool {
    var i: usize = 0
    while i < MAX_STREAMS {
        if (*c).streams[i].live && (*c).streams[i].sse > 0 { return true }
        i = i + 1
    }
    return false
}

fn stream_open(c: *mut H2Conn, id: u32) -> *mut H2Stream {
    var i: usize = 0
    while i < MAX_STREAMS {
        if !(*c).streams[i].live {
            let s: *mut H2Stream = &(*c).streams[i]
            (*s).id = id
            (*s).live = true
            (*s).req_done = false
            (*s).replied = false
            (*s).too_big = false
            (*s).sse = 0
            if (*s).hdrs.cap > 262144 { rt.buf_free(&(*s).hdrs) }
            if (*s).body.cap > 262144 { rt.buf_free(&(*s).body) }
            if (*s).out.cap > 262144 { rt.buf_free(&(*s).out) }
            rt.buf_clear(&(*s).hdrs)
            rt.buf_clear(&(*s).body)
            rt.buf_clear(&(*s).out)
            (*s).outpos = 0
            (*s).send_win = (*c).peer_init_win
            (*s).recv_win = RECV_WINDOW
            (*s).clen = 0 - 1
            (*s).got = 0
            return s
        }
        i = i + 1
    }
    return 0 as *mut H2Stream
}

fn stream_release(s: *mut H2Stream) {
    (*s).live = false
}
