// lib/ton/vorbis_stream_fd.fi -- file descriptor source (file, pipe, socket) for ton.vorbis_stream. Linux.
//
//     let src: vorbis_stream.VsSource = vorbis_stream_fd.vs_source_fd(0)    // stdin; a pipe is not seekable
import ton.vorbis_stream

export {
    vs_source_fd,
}

fn fd_read(ud: u64, dst: u64, n: usize) -> i64 {
    return syscall(0, ud as i64, dst as i64, n as i64, 0, 0, 0)
}

fn fd_seek(ud: u64, off: i64, whence: i64) -> i64 {
    return syscall(8, ud as i64, off, whence, 0, 0, 0)
}

// Seekable when lseek works on the descriptor (regular file), else a plain forward stream.
fn vs_source_fd(fd: i64) -> vorbis_stream.VsSource {
    let can: bool = syscall(8, fd, 0, 1, 0, 0, 0) >= 0
    return vorbis_stream.VsSource { read: fd_read, seek: fd_seek, ud: fd as u64, seekable: can }
}
