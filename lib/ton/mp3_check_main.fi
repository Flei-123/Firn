// SPDX-License-Identifier: MPL-2.0
// lib/ton/mp3_check_main.fi -- the self-test of the MP3 decoder.
//
// Usage:  mp3_check <stereo44.mp3> <mono24.mp3> <mono8.mp3> <shortblocks.mp3>
//         (the four files are in `testdata/ton`)
//
// Decodes four streams and compares sample rate, channel count, frame count,
// number of samples and an FNV-1a checksum over the whole PCM
// with fixed expected values. The expected values come from a run
// against the original minimp3 (C, scalar), which was BIT-EXACT
// on all four files -- whoever changes something here and breaks the checksum
// has changed the sound, not just the source text.
//
// Return 0 = all equal. Any other number is the number of the first
// probe that deviated.
import std.rt
import std.io
import ton.mp3
import ton.mp3_tab

fn fnv1a(p: u64, n: usize) -> u64 {
    var h: u64 = 14695981039346656037
    var i: usize = 0
    while i < n {
        h = h ^ (rt.ld8(p, i) as u64)
        h = h *% 1099511628211
        i = i + 1
    }
    return h
}

struct Want {
    hz: i32,
    kanaele: i32,
    frame: i32,
    values: i64,
    fnv: u64,
}

fn probe_run(tabs: *mut mp3_tab.Tabs, path: u64, pcm_buffer: u64,
    dec: *mut mp3.Mp3Dec, kratz: *mut mp3.Mp3Scratch,
    result: *mut Want) -> bool {
    var source: rt.Buf = rt.buf_new()
    if !rt.read_file(path, &source) {
        rt.buf_free(&source)
        return false
    }
    let data: u64 = rt.buf_ptr(&source)
    let length: usize = rt.buf_len(&source)

    var info: mp3.Mp3Info = mp3.Mp3Info {
        frame_bytes: 0, frame_offset: 0, channels: 0, hz: 0, layer: 0, bitrate_kbps: 0,
    }
    var everything: rt.Buf = rt.buf_new()
    var pos: usize = 0
    (*result).frame = 0
    (*result).values = 0
    while pos < length {
        let n: i32 = mp3.mp3_decode_frame(tabs, dec, kratz, data + (pos as u64),
            (length - pos) as i32, pcm_buffer, &info)
        if info.frame_bytes == 0 {
            pos = length
        } else {
            pos = pos + (info.frame_bytes as usize)
            if n > 0 {
                (*result).frame = (*result).frame + 1
                (*result).hz = info.hz
                (*result).kanaele = info.channels
                (*result).values = (*result).values + (n as i64)
                rt.buf_push_bytes(&everything, pcm_buffer, (n as usize) * (info.channels as usize) * 2)
            }
        }
    }
    (*result).fnv = fnv1a(rt.buf_ptr(&everything), rt.buf_len(&everything))
    rt.buf_free(&everything)
    rt.buf_free(&source)
    return true
}

fn same(a: *mut Want, b: *mut Want) -> bool {
    if (*a).hz != (*b).hz { return false }
    if (*a).kanaele != (*b).kanaele { return false }
    if (*a).frame != (*b).frame { return false }
    if (*a).values != (*b).values { return false }
    if (*a).fnv != (*b).fnv { return false }
    return true
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 5 {
        io.print_line("Usage: mp3_check <stereo44> <mono24> <mono8> <shortblocks>")
        return 9
    }

    var want: [Want; 4] = [
        Want { hz: 44100, kanaele: 2, frame: 117, values: 134784, fnv: 17215119225542028024 },
        Want { hz: 24000, kanaele: 1, frame: 87, values: 50112, fnv: 11724990210506242878 },
        Want { hz: 8000, kanaele: 1, frame: 45, values: 25920, fnv: 1015802880633938305 },
        Want { hz: 44100, kanaele: 1, frame: 156, values: 179712, fnv: 6150599424020114021 },
    ]

    var tabs: mp3_tab.Tabs = mp3_tab.tabs_new()
    var pcm: [i16; 2304] = [0; 2304]

    var i: usize = 0
    while i < 4 {
        var dec: mp3.Mp3Dec = mp3.mp3_new()
        var kratz: mp3.Mp3Scratch = mp3.mp3_scratch_new()
        var ist: Want = Want { hz: 0, kanaele: 0, frame: 0, values: 0, fnv: 0 }
        if !probe_run(&tabs, rt.arg_ptr(start, i + 1), (&pcm[0]) as u64, &dec, &kratz, &ist) {
            io.print_line("test file not readable")
            return (i as i32) + 1
        }
        if !same(&ist, &want[i]) {
            io.print_line("MISMATCH")
            var z: rt.Buf = rt.buf_new()
            rt.buf_push_dec_u64(&z, ist.hz as u64)
            rt.buf_push(&z, 32 as u8)
            rt.buf_push_dec_u64(&z, ist.kanaele as u64)
            rt.buf_push(&z, 32 as u8)
            rt.buf_push_dec_u64(&z, ist.frame as u64)
            rt.buf_push(&z, 32 as u8)
            rt.buf_push_dec_u64(&z, ist.values as u64)
            rt.buf_push(&z, 32 as u8)
            rt.buf_push_dec_u64(&z, ist.fnv)
            rt.buf_push(&z, 10 as u8)
            io.print_bytes(rt.buf_ptr(&z), rt.buf_len(&z))
            return (i as i32) + 1
        }
        i = i + 1
    }
    io.print_line("PASS 4/4 -- MP3 bit-identical to the recorded state")
    return 0
}
