// SPDX-License-Identifier: MPL-2.0
// lib/ton/vorbis_stream.fi -- STREAMING Ogg Vorbis decoder: reader/pipe in, PCM out, chained links, seek.
//
//     import ton.vorbis_stream
//
//     let src: vorbis_stream.VsSource = vorbis_stream.vs_source_mem(ptr, len)   // or vorbis_stream_fd.vs_source_fd(fd)
//     let s: *mut vorbis_stream.VStream = vorbis_stream.vs_open(src)           // 0 = not Ogg Vorbis / headers bad
//     var buf: [f32; 4096] = ...
//     while true {
//         let n: i64 = vorbis_stream.vs_read_f32(s, buf_ptr, 1024)   // frames (interleaved f32), 0 = end, < 0 see below
//         if n == vorbis_stream.VS_LINK { /* a new chained link started: vs_rate / vs_channels may have changed */ }
//     }
//     vorbis_stream.vs_seek(s, frame)       // seekable sources only, inside the current link
//     vorbis_stream.vs_close(s)
//
// MEMORY. Only ONE Ogg page (<= 65 KiB) plus one decoded packet are held, never the whole file; the source is read
// page by page through `VsSource.read(ud, dst, n) -> bytes (0 = end, < 0 = error)`. A pipe works (seekable false).
// CHAINED STREAMS. When a link ends (end-of-stream page) the next begin-of-stream page starts a new Vorbis decoder
// (any rate / channel count). The call that would first deliver audio of the new link returns VS_LINK once; after it
// vs_rate / vs_channels / vs_link describe the new link. Frames of one call never cross a link boundary.
// SEEK. vs_seek(s, frame): `frame` counts from the start of the CURRENT link (granule domain). Bisection over the
// byte range finds the last page whose granule <= frame, the decoder is reset and primed with that page (the first
// packet after a reset only primes the overlap), then the rest is skipped. Exact to the sample (verified against a
// full decode). Seeking across links is not supported. Needs the source to seek (`seek(ud, off, whence) -> pos`,
// like lseek: whence 0 = set, 1 = cur, 2 = end).
// LIMITS: the first granule of a link is assumed to start at 0 (streams cut mid-way, with a negative start offset,
// are not special-cased); the end of a link is trimmed to the last page's granule like vorbis_file does.
// ERRORS (negative returns): -1 damaged headers / source error, -2 VS_LINK (not an error), -3 internal (seek retry).
import std.rt
import ton.ogg
import ton.vorbis

export {
    VsSource, VStream, VS_LINK,
    vs_source_mem, vs_open, vs_close, vs_read_f32, vs_seek, vs_tell, vs_rate, vs_channels, vs_link, vs_bad_packets,
    vs_seekable,
}

const VS_LINK: i64 = -2
const CHUNK: usize = 65536

struct VsSource {
    read: fn(u64, u64, usize) -> i64,
    seek: fn(u64, i64, i64) -> i64,
    ud: u64,
    seekable: bool,
}

struct MemSrc {
    data: u64,
    len: i64,
    pos: i64,
}

struct PageInfo {
    off: i64,
    len: i64,
    granule: i64,
}

struct VStream {
    src: VsSource,
    rd: ogg.OggReader,
    win: rt.Buf,
    v: *mut vorbis.Vorbis,
    header: i32,
    rate: i32,
    channels: i32,
    link: i32,
    pos: i64, // frames of the current link already delivered or skipped
    src_off: i64, // byte offset of the next octet the source delivers
    cur_off: i64, // byte offset of the page in the window
    link_off: i64, // first page of the current link
    audio_off: i64, // first audio page of the current link
    serial: u32,
    scratch: u64,
    scratch_n: usize,
    pend_off: i32,
    pend_n: i32,
    skip: i64,
    seeking: bool,
    seek_decoded: i32,
    announce: bool, // the headers of a new link are being read
    want_link: bool, // the last link ended: the next begin-of-stream page starts a new one
    signal: i64, // return code held back for the next vs_read
    bad: i32,
    failed: bool,
}

// ---------------------------------------------------------------- sources

fn mem_read(ud: u64, dst: u64, n: usize) -> i64 {
    let m: *mut MemSrc = ud as *mut MemSrc
    var k: i64 = (*m).len - (*m).pos
    if k > (n as i64) {
        k = n as i64
    }
    if k <= 0 {
        return 0
    }
    rt.mem_copy(dst, (*m).data + ((*m).pos as u64), k as usize)
    (*m).pos = (*m).pos + k
    return k
}

fn mem_seek(ud: u64, off: i64, whence: i64) -> i64 {
    let m: *mut MemSrc = ud as *mut MemSrc
    var p: i64 = off
    if whence == 1 {
        p = (*m).pos + off
    }
    if whence == 2 {
        p = (*m).len + off
    }
    if p < 0 || p > (*m).len {
        return -1
    }
    (*m).pos = p
    return p
}

// Source over a memory block (the block must outlive the stream). Seekable.
fn vs_source_mem(data: u64, len: usize) -> VsSource {
    let m: *mut MemSrc = rt.heap_alloc(24) as *mut MemSrc
    (*m).data = data
    (*m).len = len as i64
    (*m).pos = 0
    return VsSource { read: mem_read, seek: mem_seek, ud: m as u64, seekable: true }
}

fn src_read_exact(s: *mut VStream, dst: u64, n: usize) -> bool {
    var got: usize = 0
    let rf: fn(u64, u64, usize) -> i64 = (*s).src.read
    while got < n {
        let r: i64 = rf((*s).src.ud, dst + (got as u64), n - got)
        if r <= 0 {
            return false
        }
        got = got + (r as usize)
        (*s).src_off = (*s).src_off + r
    }
    return true
}

fn src_seek(s: *mut VStream, off: i64, whence: i64) -> i64 {
    let sf: fn(u64, i64, i64) -> i64 = (*s).src.seek
    let r: i64 = sf((*s).src.ud, off, whence)
    if r >= 0 {
        (*s).src_off = r
    }
    return r
}

// ---------------------------------------------------------------- page loading

fn is_oggs(p: u64, i: usize) -> bool {
    return rt.ld8(p, i) == 79 as u8 && rt.ld8(p, i + 1) == 103 as u8 && rt.ld8(p, i + 2) == 103 as u8
    && rt.ld8(p, i + 3) == 83 as u8
}

// Replaces the window by the next whole page of the source. false = end of the source.
fn load_page(s: *mut VStream) -> bool {
    rt.buf_clear(&(*s).win)
    rt.buf_reserve(&(*s).win, 27 + 255 + 65536)
    let w: u64 = rt.buf_ptr(&(*s).win)
    if !src_read_exact(s, w, 27) {
        return false
    }
    // resync: slide until "OggS" and version 0
    while !(is_oggs(w, 0) && rt.ld8(w, 4) == 0 as u8) {
        var i: usize = 0
        while i < 26 {
            rt.st8(w, i, rt.ld8(w, i + 1))
            i = i + 1
        }
        if !src_read_exact(s, w + 26, 1) {
            return false
        }
    }
    let nseg: usize = rt.ld8(w, 26) as usize
    if !src_read_exact(s, w + 27, nseg) {
        return false
    }
    var body: usize = 0
    var k: usize = 0
    while k < nseg {
        body = body + (rt.ld8(w, 27 + k) as usize)
        k = k + 1
    }
    if !src_read_exact(s, w + ((27 + nseg) as u64), body) {
        return false
    }
    let total: usize = 27 + nseg + body
    rt.buf_set_len(&(*s).win, total)
    (*s).cur_off = (*s).src_off - (total as i64)
    (*s).rd.data = w
    (*s).rd.len = total
    (*s).rd.pos = 0
    return true
}

// 1 packet in rd, 0 end of the source, 3 a new link begins with the page in the window
fn next_packet(s: *mut VStream) -> i32 {
    while true {
        if ogg.ogg_next(&(*s).rd) == 1 {
            return 1
        }
        if (*s).rd.ended {
            (*s).want_link = true
        }
        if !load_page(s) {
            return 0
        }
        if (*s).want_link {
            if ogg.ogg_next_link(&(*s).rd) {
                (*s).want_link = false
                return 3
            }
        }
    }
    return 0
}

// ---------------------------------------------------------------- one packet

fn start_link(s: *mut VStream) -> bool {
    if (*s).v as u64 != 0 {
        vorbis.vorbis_free((*s).v)
    }
    (*s).v = vorbis.vorbis_new()
    (*s).header = 0
    (*s).pend_n = 0
    (*s).pend_off = 0
    (*s).pos = 0
    (*s).skip = 0
    (*s).seeking = false
    return (*s).v as u64 != 0
}

// Processes one packet. 1 = progress (pend_n may be > 0), 0 = end, -1 = error, -2 = VS_LINK, -3 = seek retry
fn step(s: *mut VStream) -> i64 {
    let r: i32 = next_packet(s)
    if r == 0 {
        return 0
    }
    if r == 3 {
        (*s).announce = true
        (*s).link = (*s).link + 1
        if !start_link(s) {
            return -1
        }
        // ogg_next_link rewound to the begin page: fetch its first packet
        if next_packet(s) != 1 {
            return -1
        }
    }
    if (*s).v as u64 == 0 && !start_link(s) {
        return -1
    }
    if (*s).header == 0 {
        (*s).serial = (*s).rd.serial
        (*s).link_off = (*s).cur_off
    }
    let pp: u64 = ogg.ogg_pkt_ptr(&(*s).rd)
    let pl: usize = ogg.ogg_pkt_len(&(*s).rd)
    if (*s).header < 3 {
        if vorbis.vorbis_header((*s).v, pp, pl) != 0 {
            return -1
        }
        (*s).header = (*s).header + 1
        if (*s).header == 3 {
            (*s).rate = vorbis.vorbis_rate((*s).v)
            (*s).channels = vorbis.vorbis_channels((*s).v)
            if (*s).scratch != 0 {
                rt.heap_free((*s).scratch, (*s).scratch_n)
            }
            (*s).scratch_n = 8192 * ((*s).channels as usize) * 4
            (*s).scratch = rt.heap_alloc((*s).scratch_n)
            if (*s).scratch == 0 {
                return -1
            }
            (*s).audio_off = (*s).cur_off + (rt.buf_len(&(*s).win) as i64)
            if (*s).announce {
                (*s).announce = false
                return -2
            }
        }
        return 1
    }
    let n: i32 = vorbis.vorbis_decode((*s).v, pp, pl)
    var frames: i32 = 0
    if n < 0 {
        (*s).bad = (*s).bad + 1
    } else {
        frames = n
        if (*s).seeking {
            (*s).seek_decoded = (*s).seek_decoded + 1
            frames = 0
        }
    }
    let g: i64 = (*s).rd.granule
    if g >= 0 {
        if (*s).seeking {
            if (*s).seek_decoded == 0 {
                return -3
            }
            (*s).pos = g
            (*s).seeking = false
        } else if (*s).rd.eos && (*s).pos + (frames as i64) > g {
            // the encoder's true length: trim the end of the link
            frames = (g - (*s).pos) as i32
            if frames < 0 {
                frames = 0
            }
        }
    }
    if frames > 0 {
        vorbis.vorbis_to_f32((*s).v, frames, (*s).scratch)
        (*s).pend_off = 0
        (*s).pend_n = frames
    }
    return 1
}

// ---------------------------------------------------------------- public

fn vs_open(src: VsSource) -> *mut VStream {
    let sz: usize = ts_size[VStream]()
    let p: u64 = rt.heap_alloc(sz)
    if p == 0 {
        return 0 as *mut VStream
    }
    let s: *mut VStream = p as *mut VStream
    (*s).src = src
    (*s).rd = ogg.ogg_new(0, 0)
    (*s).win = rt.buf_new()
    (*s).v = 0 as *mut vorbis.Vorbis
    (*s).header = 0
    (*s).rate = 0
    (*s).channels = 0
    (*s).link = 0
    (*s).pos = 0
    (*s).src_off = 0
    (*s).cur_off = 0
    (*s).link_off = 0
    (*s).audio_off = 0
    (*s).serial = 0 as u32
    (*s).scratch = 0
    (*s).scratch_n = 0
    (*s).pend_off = 0
    (*s).pend_n = 0
    (*s).skip = 0
    (*s).seeking = false
    (*s).seek_decoded = 0
    (*s).announce = false
    (*s).want_link = false
    (*s).signal = 0
    (*s).bad = 0
    (*s).failed = false
    while (*s).header < 3 {
        let r: i64 = step(s)
        if r != 1 && r != -2 {
            vs_close(s)
            return 0 as *mut VStream
        }
    }
    return s
}

fn ts_size[T: Any]() -> usize {
    return size_of[T]()
}

fn vs_close(s: *mut VStream) {
    if s as u64 == 0 {
        return
    }
    if (*s).v as u64 != 0 {
        vorbis.vorbis_free((*s).v)
    }
    if (*s).scratch != 0 {
        rt.heap_free((*s).scratch, (*s).scratch_n)
    }
    ogg.ogg_free(&(*s).rd)
    rt.buf_free(&(*s).win)
    // the memory source (if any) is leaked on purpose: ud may belong to the caller
    rt.heap_free(s as u64, ts_size[VStream]())
}

fn vs_rate(s: *mut VStream) -> i32 {
    return (*s).rate
}

fn vs_channels(s: *mut VStream) -> i32 {
    return (*s).channels
}

fn vs_link(s: *mut VStream) -> i32 {
    return (*s).link
}

fn vs_tell(s: *mut VStream) -> i64 {
    return (*s).pos
}

fn vs_bad_packets(s: *mut VStream) -> i32 {
    return (*s).bad
}

fn vs_seekable(s: *mut VStream) -> bool {
    return (*s).src.seekable
}

// Drops up to `n` pending frames. Returns how many were dropped.
fn take_pending(s: *mut VStream, n: i64) -> i64 {
    var k: i64 = n
    if k > ((*s).pend_n as i64) {
        k = (*s).pend_n as i64
    }
    return k
}

// Up to `max` frames of interleaved f32 into dst. 0 = end of the stream, VS_LINK = new link started, -1 = error.
fn vs_read_f32(s: *mut VStream, dst: u64, max: usize) -> i64 {
    if (*s).signal != 0 {
        let sg: i64 = (*s).signal
        (*s).signal = 0
        return sg
    }
    let fsz: usize = ((*s).channels as usize) * 4
    var total: i64 = 0
    while (total as usize) < max {
        if (*s).pend_n == 0 {
            // one packet per call at most: a link change must never be hidden behind frames of the old link
            if (*s).failed || total > 0 {
                break
            }
            let r: i64 = step(s)
            if r == 0 {
                break
            }
            if r != 1 {
                if r == -2 || r == -1 {
                    if r == -1 {
                        (*s).failed = true
                    }
                    if total > 0 {
                        (*s).signal = r
                        break
                    }
                    return r
                }
                // -3 cannot happen outside a seek; treat as damage
                (*s).failed = true
                break
            }
        }
        if (*s).pend_n > 0 {
            var k: i64 = take_pending(s, (max as i64) - total)
            if (*s).skip > 0 {
                var d: i64 = (*s).skip
                if d > k {
                    d = k
                }
                (*s).skip = (*s).skip - d
                (*s).pos = (*s).pos + d
                (*s).pend_off = (*s).pend_off + (d as i32)
                (*s).pend_n = (*s).pend_n - (d as i32)
            } else {
                rt.mem_copy(dst + ((total as usize) * fsz) as u64,
                    (*s).scratch + (((*s).pend_off as usize) * fsz) as u64, (k as usize) * fsz)
                (*s).pend_off = (*s).pend_off + (k as i32)
                (*s).pend_n = (*s).pend_n - (k as i32)
                (*s).pos = (*s).pos + k
                total = total + k
            }
        }
    }
    return total
}

// ---------------------------------------------------------------- seeking

// First valid page of the current link at byte offset >= from and < limit. false = none (or the link ended).
fn scan_page(s: *mut VStream, from: i64, limit: i64, out: *mut PageInfo) -> bool {
    var at: i64 = from
    let tmp: u64 = rt.heap_alloc(CHUNK + 512)
    if tmp == 0 {
        return false
    }
    var found: bool = false
    var done: bool = false
    while !done {
        if at + 27 > limit {
            break
        }
        if src_seek(s, at, 0) < 0 {
            break
        }
        let sf: fn(u64, u64, usize) -> i64 = (*s).src.read
        var have: usize = 0
        // read one chunk (the source may deliver less per call)
        var again: bool = true
        while again && have < CHUNK {
            let r: i64 = sf((*s).src.ud, tmp + (have as u64), CHUNK - have)
            if r <= 0 {
                again = false
            } else {
                have = have + (r as usize)
            }
        }
        if have < 27 {
            break
        }
        var i: usize = 0
        while i + 27 <= have && !found && !done {
            if is_oggs(tmp, i) && rt.ld8(tmp, i + 4) == 0 as u8 && (rt.ld8(tmp, i + 5) as u32) < 8 as u32 {
                var ser: u32 = 0 as u32
                var b: usize = 0
                while b < 4 {
                    ser = ser | ((rt.ld8(tmp, i + 14 + b) as u32) << ((8 * b) as u32))
                    b = b + 1
                }
                let flags: u32 = rt.ld8(tmp, i + 5) as u32
                if ser == (*s).serial {
                    let nseg: usize = rt.ld8(tmp, i + 26) as usize
                    if i + 27 + nseg <= have {
                        var body: usize = 0
                        var k: usize = 0
                        while k < nseg {
                            body = body + (rt.ld8(tmp, i + 27 + k) as usize)
                            k = k + 1
                        }
                        var g: i64 = 0
                        var q: i32 = 7
                        while q >= 0 {
                            g = (g << 8) | (rt.ld8(tmp, i + 6 + (q as usize)) as i64)
                            q = q - 1
                        }
                        if at + (i as i64) < limit {
                            (*out).off = at + (i as i64)
                            (*out).len = ((27 + nseg + body) as i64)
                            (*out).granule = g
                            found = true
                        } else {
                            done = true
                        }
                    }
                } else if (flags & 2 as u32) != 0 as u32 {
                    done = true // the begin of another link: ours ended
                }
            }
            i = i + 1
        }
        if !found && !done {
            if have < CHUNK {
                break
            }
            at = at + (have as i64) - 30
        }
        if found {
            done = true
        }
    }
    rt.heap_free(tmp, CHUNK + 512)
    return found
}

// Resets decoder and reader to start at byte offset `off`.
fn reposition(s: *mut VStream, off: i64) -> bool {
    if src_seek(s, off, 0) < 0 {
        return false
    }
    rt.buf_clear(&(*s).win)
    (*s).rd.partial = false
    rt.buf_clear(&(*s).rd.pkt)
    (*s).rd.in_page = false
    (*s).rd.ended = false
    (*s).rd.pos = 0
    (*s).rd.len = 0
    (*s).pend_n = 0
    (*s).pend_off = 0
    (*s).skip = 0
    (*s).failed = false
    (*s).signal = 0
    vorbis.vorbis_reset((*s).v)
    return true
}

// Seek inside the current link to `frame` (>= 0). 0 = ok, -1 = failed (not seekable, bad target, read error).
// A target beyond the end leaves the stream at its end: the next vs_read returns 0.
fn vs_seek(s: *mut VStream, frame: i64) -> i32 {
    if !(*s).src.seekable || frame < 0 || (*s).header < 3 {
        return -1
    }
    let size: i64 = src_seek(s, 0, 2)
    if size < 0 {
        return -1
    }
    var target: i64 = frame
    var attempt: i32 = 0
    while attempt < 16 {
        attempt = attempt + 1
        var retry: bool = false
        var best: PageInfo = PageInfo { off: -1, len: 0, granule: 0 }
        var lo: i64 = (*s).audio_off
        var hi: i64 = size
        var p: PageInfo = PageInfo { off: 0, len: 0, granule: 0 }
        while hi - lo > 131072 {
            let mid: i64 = lo + (hi - lo) / 2
            if !scan_page(s, mid, hi, &p) {
                hi = mid
            } else if p.granule < 0 {
                lo = p.off + p.len
            } else if p.granule <= target {
                best = p
                lo = p.off + p.len
            } else {
                hi = mid
            }
        }
        var go: bool = true
        while go {
            if !scan_page(s, lo, size, &p) {
                go = false
            } else if p.granule > target {
                go = false
            } else {
                if p.granule >= 0 {
                    best = p
                }
                lo = p.off + p.len
            }
        }
        if best.off < 0 {
            // before the first audio page: decode from the start
            if !reposition(s, (*s).audio_off) {
                return -1
            }
            (*s).pos = 0
            (*s).seeking = false
        } else {
            if !reposition(s, best.off) {
                return -1
            }
            (*s).seeking = true
            (*s).seek_decoded = 0
            (*s).pos = best.granule
            var r: i64 = 1
            while (*s).seeking && r == 1 {
                r = step(s)
            }
            if r == -3 {
                // the page only completed a packet that began before it: step back one page
                if best.granule <= 0 {
                    return -1
                }
                target = best.granule - 1
                retry = true
            }
            if retry {
            } else if r == 0 {
                // ran off the end while priming: the page was the last one
                (*s).seeking = false
            } else if r != 1 {
                return -1
            }
        }
        if retry {
            attempt = attempt + 0
        } else {
            (*s).skip = frame - (*s).pos
            if (*s).skip < 0 {
                (*s).skip = 0
            }
            // eager skip, so vs_tell() == frame afterwards
            while (*s).skip > 0 && !(*s).failed {
                if (*s).pend_n == 0 {
                    let r2: i64 = step(s)
                    if r2 == 0 {
                        break
                    }
                    if r2 != 1 {
                        return -1
                    }
                }
                if (*s).pend_n > 0 {
                    var d: i64 = (*s).skip
                    if d > ((*s).pend_n as i64) {
                        d = (*s).pend_n as i64
                    }
                    (*s).skip = (*s).skip - d
                    (*s).pos = (*s).pos + d
                    (*s).pend_off = (*s).pend_off + (d as i32)
                    (*s).pend_n = (*s).pend_n - (d as i32)
                }
            }
            return 0
        }
    }
    return -1
}
