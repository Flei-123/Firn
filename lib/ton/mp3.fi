// SPDX-License-Identifier: MPL-2.0
// lib/ton/mp3.fi -- MPEG-1/2/2.5 Layer III (MP3) DECODER, in Firn.
//
// WHAT FOR. Without a decoder an audio layer is deaf: every internet station,
// every .mp3 on a disk and every stream a radio delivers is Layer III.
// This file takes octets and gives PCM -- 16 bit, interleaved, at the
// sample rate of the stream. What comes after (mixer, device) is none of its
// business; it makes no system call and touches no heap.
//
// ORIGIN, STATED PLAINLY. The structure follows minimp3 by lieff
// (https://github.com/lieff/minimp3), published under CC0-1.0 -- so it is
// public domain, without conditions. This is no accident and no convenience:
// an MP3 decoder is nine tenths TABLE and one tenth rule,
// and whoever types the tables in by hand types them wrong. The tables come
// therefore from the original via `tools/mp3_tables.py` and sit generated
// in `mp3_tab.fi`; the flow here is newly written, because Firn has neither
// C-style pointer arithmetic nor global variables.
//
// PATENTS: the MP3 patents expired in 2017 (Fraunhofer ended the
// licensing programme on 23.04.2017). That is why this is
// a sensible choice at all and not Opus.
//
// ======================================================== HOW MP3 IS BUILT
//
// A stream is a sequence of FRAMES. Every frame begins with four
// octets of header (eleven one bits of sync word, then version, layer,
// bitrate, sample rate, channel mode) and carries 1152 samples per channel
// (MPEG-1) or 576 (MPEG-2/2.5). The length is NOT in the header -- it
// is computed from bitrate and sample rate, plus one padding octet if
// the padding bit is set.
//
// THE MAIN DATA POINTER is the place where most home-built
// decoders fail: the payload of a frame does NOT start behind
// its header. `main_data_begin` says how many octets BEFORE the
// own header the own data begins -- the encoder borrows space
// from its predecessors (bit reservoir, up to 511 octets). A decoder that
// does not keep the last remainder sounds briefly wrong at every frame.
//
// THE PATH OF A GRANULE (576 frequency lines):
//   1. read side info (lengths, block type, Huffman table choice)
//   2. read scale factors and compute them into gains
//   3. Huffman decode and requantise at once (x^(4/3))
//   4. resolve stereo (mid/side or intensity)
//   5. reorder for short blocks, otherwise antialias
//   6. IMDCT per band (36 or 3x12 points) with overlap to the previous frame
//   7. sign change, then the synthesis filter bank (32 subbands ->
//      32 samples, 512-point window over 16 frames of history)
//
// ================================================================== HONESTLY
//
// E1 LAYER III ONLY. Layers I and II exist in the original and are LEFT OUT
//    here -- for radio and files neither matters. A
//    frame with layer I/II is recognised and skipped, not guessed.
// E2 NO SIMD. The original has SSE and NEON paths; here the
//    scalar one stands. That is about two to three times slower and exactly the same
//    computation -- it is measured in `docs/TON1.md`, not claimed.
// E3 NO FREE FORMAT without proof: frames without a bitrate entry are
//    measured by the distance between two headers, as in the original.
// E4 THE OUTPUT IS i16. Whoever needs floating point takes `mp3_pcm_f32`.
// E5 NO ID3. A tag block at the start of the file is simply run over by
//    the frame search; that costs time, but no correctness.
import std.rt
import ton.mp3_tab
import ton.mp3_vec

export {
    Mp3Dec, Mp3Info, Mp3Scratch,
    mp3_new, mp3_scratch_new, mp3_decode_frame,
    MAX_SAMPLES_PER_FRAME,
    adr2, adr4, lf, sf, synth_pair,
    scale_pcm,
    hdr_valid, hdr_frame_octets, hdr_abtastrate, hdr_kanaele,
    hdr_bitrate_kbps, hdr_frame_samples,
}

const MAX_SAMPLES_PER_FRAME: usize = 2304 // 1152 * 2 channels
const MAX_FREE_FORMAT_FRAME_SIZE: i32 = 2304
const MAX_FRAME_SYNC_MATCHES: i32 = 10
const MAX_BITRESERVOIR_BYTES: usize = 511
const MAINDATA_BYTES: usize = 2815 // 511 + 2304
const SHORT_BLOCK_TYPE: i32 = 2
const STOP_BLOCK_TYPE: i32 = 3
const MODE_MONO: i32 = 3
const HDR_SIZE: i32 = 4
const MAX_SCFI: i32 = 44 // MAX_SCF = 255 + (-1)*4 - 210 = 41, then (41+3) & ~3

// ====================================================================
// MEMORY: WHERE FIRN DIFFERS FROM C
// ====================================================================
//
// The original advances pointers everywhere (`*dst++`, `scf++`, `left +=
// sfb[i]`). Firn has no syntax for that and is not meant to have one.
// Instead the ADDRESS of an array is taken and computed with a
// SIGNED index -- negative indices really occur in the
// synthesis filter bank (`zlin[4*(i-16)+2]`), and a `usize`
// would simply be wrong there.

// ROUND TEMPO: WITHOUT A BRANCH. The address computation used to go through an
// `if i < 0`, because a negative index really occurs in the synthesis filter
// bank. The branch is not needed: addresses compute modulo 2^64, and
// `i as u64` at equal width is a reinterpretation of the bit pattern (in
// every build level, measured). `p +% (i as u64) *% 4` therefore gives for
// negative i exactly the same as subtracting -- without a jump, without phi, and
// only with that can the compiler fold the access into the address part of the
// instruction.
fn adr4(p: u64, i: i64) -> u64 {
    return p +% ((i as u64) *% 4)
}

fn lf(p: u64, i: i64) -> f32 {
    return *(adr4(p, i) as *mut f32)
}

fn sf(p: u64, i: i64, v: f32) {
    *(adr4(p, i) as *mut f32) = v
}

fn adr2(p: u64, i: i64) -> u64 {
    return p +% ((i as u64) *% 2)
}

fn s16(p: u64, i: i64, v: i16) {
    *(adr2(p, i) as *mut i16) = v
}

fn lb(p: u64, i: i64) -> u8 {
    return *((p +% (i as u64)) as *mut u8)
}

fn sb(p: u64, i: i64, v: u8) {
    *((p +% (i as u64)) as *mut u8) = v
}

fn mini(a: i32, b: i32) -> i32 {
    if a < b { return a }
    return b
}

fn maxi(a: i32, b: i32) -> i32 {
    if a > b { return a }
    return b
}

// ====================================================================
// THE BIT STREAM
// ====================================================================

struct Bs {
    buf: u64,
    pos: i32,
    limit: i32,
}

fn bs_init(bs: *mut Bs, data: u64, octets: i32) {
    (*bs).buf = data
    (*bs).pos = 0
    (*bs).limit = octets * 8
}

// `n` bits, most significant first. Past the end the
// function returns zero and lets `pos` run on anyway -- the caller
// checks `pos > limit` once at the end instead of in every line.
fn get_bits(bs: *mut Bs, n: i32) -> u32 {
    var cache: u32 = 0 as u32
    let s: i32 = (*bs).pos & 7
    var shl: i32 = n + s
    var p: u64 = (*bs).buf + (((*bs).pos >> 3) as u64)
    (*bs).pos = (*bs).pos + n
    if (*bs).pos > (*bs).limit {
        return 0 as u32
    }
    var next: u32 = (lb(p, 0) as u32) & ((255 >> s) as u32)
    p = p + 1
    shl = shl - 8
    while shl > 0 {
        cache = cache | (next << (shl as u32))
        next = lb(p, 0) as u32
        p = p + 1
        shl = shl - 8
    }
    return cache | (next >> ((0 - shl) as u32))
}

// ====================================================================
// THE FRAME HEADER
// ====================================================================

fn hdr_layer(h: u64) -> i32 {
    return ((lb(h, 1) as i32) >> 1) & 3
}

fn hdr_bitrate_idx(h: u64) -> i32 {
    return (lb(h, 2) as i32) >> 4
}

fn hdr_sample_rate_idx(h: u64) -> i32 {
    return ((lb(h, 2) as i32) >> 2) & 3
}

fn hdr_test_mpeg1(h: u64) -> bool {
    return ((lb(h, 1) as i32) & 8) != 0
}

fn hdr_test_not_mpeg25(h: u64) -> bool {
    return ((lb(h, 1) as i32) & 16) != 0
}

fn hdr_is_mono(h: u64) -> bool {
    return ((lb(h, 3) as i32) & 192) == 192
}

fn hdr_is_ms_stereo(h: u64) -> bool {
    return ((lb(h, 3) as i32) & 224) == 96
}

fn hdr_test_i_stereo(h: u64) -> bool {
    return ((lb(h, 3) as i32) & 16) != 0
}

fn hdr_is_free_format(h: u64) -> bool {
    return ((lb(h, 2) as i32) & 240) == 0
}

fn hdr_is_crc(h: u64) -> bool {
    return ((lb(h, 1) as i32) & 1) == 0
}

fn hdr_test_padding(h: u64) -> bool {
    return ((lb(h, 2) as i32) & 2) != 0
}

fn hdr_is_frame_576(h: u64) -> bool {
    return ((lb(h, 1) as i32) & 14) == 2
}

fn hdr_is_layer_1(h: u64) -> bool {
    return ((lb(h, 1) as i32) & 6) == 6
}

// The sample rate code as the decoder needs it: 0..2 for MPEG-1,
// 3..5 for MPEG-2, 6..8 for MPEG-2.5.
fn hdr_my_sample_rate(h: u64) -> i32 {
    let b1: i32 = lb(h, 1) as i32
    return hdr_sample_rate_idx(h) + (((b1 >> 3) & 1) + ((b1 >> 4) & 1)) * 3
}

fn hdr_valid(h: u64) -> bool {
    let b0: i32 = lb(h, 0) as i32
    let b1: i32 = lb(h, 1) as i32
    if b0 != 255 {
        return false
    }
    if (b1 & 240) != 240 && (b1 & 254) != 226 {
        return false
    }
    if hdr_layer(h) == 0 {
        return false
    }
    if hdr_bitrate_idx(h) == 15 {
        return false
    }
    if hdr_sample_rate_idx(h) == 3 {
        return false
    }
    return true
}

// Two headers belong to the same stream if version, layer and
// sample rate are equal. Everything else (bitrate, padding, channel mode) may
// change from frame to frame -- that is exactly what VBR is.
fn hdr_compare(h1: u64, h2: u64) -> bool {
    if !hdr_valid(h2) {
        return false
    }
    if (((lb(h1, 1) as i32) ^ (lb(h2, 1) as i32)) & 254) != 0 {
        return false
    }
    if (((lb(h1, 2) as i32) ^ (lb(h2, 2) as i32)) & 12) != 0 {
        return false
    }
    if hdr_is_free_format(h1) != hdr_is_free_format(h2) {
        return false
    }
    return true
}

fn hdr_bitrate_kbps(t: *mut mp3_tab.Tabs, h: u64) -> i32 {
    var i: i32 = 0
    if hdr_test_mpeg1(h) {
        i = 1
    }
    let idx: usize = ((i * 45) + (hdr_layer(h) - 1) * 15 + hdr_bitrate_idx(h)) as usize
    return 2 * ((*t).halfrate[idx] as i32)
}

fn hdr_abtastrate(h: u64) -> i32 {
    var hz: i32 = 44100
    let idx: i32 = hdr_sample_rate_idx(h)
    if idx == 1 {
        hz = 48000
    }
    if idx == 2 {
        hz = 32000
    }
    if !hdr_test_mpeg1(h) {
        hz = hz >> 1
    }
    if !hdr_test_not_mpeg25(h) {
        hz = hz >> 1
    }
    return hz
}

fn hdr_kanaele(h: u64) -> i32 {
    if hdr_is_mono(h) {
        return 1
    }
    return 2
}

fn hdr_frame_samples(h: u64) -> i32 {
    if hdr_is_layer_1(h) {
        return 384
    }
    if hdr_is_frame_576(h) {
        return 576
    }
    return 1152
}

fn hdr_frame_octets(t: *mut mp3_tab.Tabs, h: u64, free_slots: i32) -> i32 {
    var n: i32 = hdr_frame_samples(h) * hdr_bitrate_kbps(t, h) * 125 / hdr_abtastrate(h)
    if hdr_is_layer_1(h) {
        n = n & -4
    }
    if n == 0 {
        return free_slots
    }
    return n
}

fn hdr_padding(h: u64) -> i32 {
    if !hdr_test_padding(h) {
        return 0
    }
    if hdr_is_layer_1(h) {
        return 4
    }
    return 1
}

// ====================================================================
// THE STATES
// ====================================================================

struct GrInfo {
    sfbtab: u64, // address into the tables: width of every scale factor band
    part_23_length: i32,
    big_values: i32,
    scalefac_compress: i32,
    global_gain: i32,
    block_type: i32,
    mixed_block_flag: i32,
    n_long_sfb: i32,
    n_short_sfb: i32,
    table_select: [i32; 3],
    region_count: [i32; 3],
    subblock_gain: [i32; 3],
    preflag: i32,
    scalefac_scale: i32,
    count1_table: i32,
    scfsi: i32,
}

fn gr_empty() -> GrInfo {
    return GrInfo {
        sfbtab: 0, part_23_length: 0, big_values: 0, scalefac_compress: 0,
        global_gain: 0, block_type: 0, mixed_block_flag: 0, n_long_sfb: 0,
        n_short_sfb: 0, table_select: [0; 3], region_count: [0; 3],
        subblock_gain: [0; 3], preflag: 0, scalefac_scale: 0,
        count1_table: 0, scfsi: 0,
    }
}

struct Mp3Dec {
    mdct_overlap: [[f32; 288]; 2], // 9*32 per channel
    qmf_state: [f32; 960], // 15*2*32
    reserv: i32,
    free_format_bytes: i32,
    header: [u8; 4],
    reserv_buf: [u8; 511],
}

fn mp3_new() -> Mp3Dec {
    return Mp3Dec {
        mdct_overlap: [[0.0f; 288]; 2],
        qmf_state: [0.0f; 960],
        reserv: 0,
        free_format_bytes: 0,
        header: [0; 4],
        reserv_buf: [0; 511],
    }
}

// The scratch space is around 16 KiB. It is deliberately NOT in `Mp3Dec`:
// nothing of it has to survive between two frames, and whoever decodes many
// streams at the same time wants one scratch space, not twenty.
struct Mp3Scratch {
    maindata: [u8; 2815],
    gr_info: [GrInfo; 4],
    grbuf: [[f32; 576]; 2],
    scf: [f32; 40],
    syn: [[f32; 64]; 33], // (18+15) x 2*32
    ist_pos: [[u8; 39]; 2],
    bs: Bs,
}

fn mp3_scratch_new() -> Mp3Scratch {
    return Mp3Scratch {
        maindata: [0; 2815],
        gr_info: [gr_empty(); 4],
        grbuf: [[0.0f; 576]; 2],
        scf: [0.0f; 40],
        syn: [[0.0f; 64]; 33],
        ist_pos: [[0; 39]; 2],
        bs: Bs { buf: 0, pos: 0, limit: 0 },
    }
}

struct Mp3Info {
    frame_bytes: i32,
    frame_offset: i32,
    channels: i32,
    hz: i32,
    layer: i32,
    bitrate_kbps: i32,
}

// ====================================================================
// SIDE INFO
// ====================================================================

fn l3_read_side_info(t: *mut mp3_tab.Tabs, bs: *mut Bs, sc: *mut Mp3Scratch, h: u64) -> i32 {
    var scfsi: u32 = 0 as u32
    var main_data_begin: i32 = 0
    var part_23_sum: i32 = 0
    var sr_idx: i32 = hdr_my_sample_rate(h)
    if sr_idx != 0 {
        sr_idx = sr_idx - 1
    }
    var gr_count: i32 = 2
    if hdr_is_mono(h) {
        gr_count = 1
    }

    if hdr_test_mpeg1(h) {
        gr_count = gr_count * 2
        main_data_begin = get_bits(bs, 9) as i32
        scfsi = get_bits(bs, 7 + gr_count)
    } else {
        main_data_begin = (get_bits(bs, 8 + gr_count) >> (gr_count as u32)) as i32
    }

    let lang: u64 = (&(*t).scf_long[0]) as u64
    let short_len: u64 = (&(*t).scf_short[0]) as u64
    let mixed: u64 = (&(*t).scf_mixed[0]) as u64

    var k: i32 = 0
    while k < gr_count {
        let g: *mut GrInfo = &(*sc).gr_info[k as usize]
        if hdr_is_mono(h) {
            scfsi = scfsi << 4
        }
        (*g).part_23_length = get_bits(bs, 12) as i32
        part_23_sum = part_23_sum + (*g).part_23_length
        (*g).big_values = get_bits(bs, 9) as i32
        if (*g).big_values > 288 {
            return -1
        }
        (*g).global_gain = get_bits(bs, 8) as i32
        var nbits: i32 = 9
        if hdr_test_mpeg1(h) {
            nbits = 4
        }
        (*g).scalefac_compress = get_bits(bs, nbits) as i32
        (*g).sfbtab = lang + (sr_idx as u64) * 23
        (*g).n_long_sfb = 22
        (*g).n_short_sfb = 0
        var tables: u32 = 0 as u32
        if get_bits(bs, 1) != 0 as u32 {
            (*g).block_type = get_bits(bs, 2) as i32
            if (*g).block_type == 0 {
                return -1
            }
            (*g).mixed_block_flag = get_bits(bs, 1) as i32
            (*g).region_count[0] = 7
            (*g).region_count[1] = 255
            if (*g).block_type == SHORT_BLOCK_TYPE {
                scfsi = scfsi & 3855 as u32 // 0x0F0F
                if (*g).mixed_block_flag == 0 {
                    (*g).region_count[0] = 8
                    (*g).sfbtab = short_len + (sr_idx as u64) * 40
                    (*g).n_long_sfb = 0
                    (*g).n_short_sfb = 39
                } else {
                    (*g).sfbtab = mixed + (sr_idx as u64) * 40
                    (*g).n_long_sfb = 6
                    if hdr_test_mpeg1(h) {
                        (*g).n_long_sfb = 8
                    }
                    (*g).n_short_sfb = 30
                }
            }
            tables = get_bits(bs, 10) << 5
            (*g).subblock_gain[0] = get_bits(bs, 3) as i32
            (*g).subblock_gain[1] = get_bits(bs, 3) as i32
            (*g).subblock_gain[2] = get_bits(bs, 3) as i32
        } else {
            (*g).block_type = 0
            (*g).mixed_block_flag = 0
            tables = get_bits(bs, 15)
            (*g).region_count[0] = get_bits(bs, 4) as i32
            (*g).region_count[1] = get_bits(bs, 3) as i32
            (*g).region_count[2] = 255
        }
        (*g).table_select[0] = (tables >> 10) as i32
        (*g).table_select[1] = ((tables >> 5) & 31 as u32) as i32
        (*g).table_select[2] = (tables & 31 as u32) as i32
        if hdr_test_mpeg1(h) {
            (*g).preflag = get_bits(bs, 1) as i32
        } else {
            (*g).preflag = 0
            if (*g).scalefac_compress >= 500 {
                (*g).preflag = 1
            }
        }
        (*g).scalefac_scale = get_bits(bs, 1) as i32
        (*g).count1_table = get_bits(bs, 1) as i32
        (*g).scfsi = ((scfsi >> 12) & 15 as u32) as i32
        scfsi = scfsi << 4
        k = k + 1
    }

    if part_23_sum + (*bs).pos > (*bs).limit + main_data_begin * 8 {
        return -1
    }
    return main_data_begin
}

// ====================================================================
// SCALE FACTORS
// ====================================================================

fn l3_read_scalefactors(scf: u64, ist_pos: u64, scf_size: u64, scf_count: u64,
    bs: *mut Bs, scfsi_in: i32) {
    var scfsi: i32 = scfsi_in
    var so: i64 = 0 // write position in scf / ist_pos
    var i: i32 = 0
    while i < 4 {
        let cnt: i32 = lb(scf_count, i as i64) as i32
        if cnt == 0 {
            i = 4
        } else {
            if (scfsi & 8) != 0 {
                rt.mem_copy(adr1(scf, so), adr1(ist_pos, so), cnt as usize)
            } else {
                let bits: i32 = lb(scf_size, i as i64) as i32
                if bits == 0 {
                    rt.mem_set(adr1(scf, so), 0 as u8, cnt as usize)
                    rt.mem_set(adr1(ist_pos, so), 0 as u8, cnt as usize)
                } else {
                    var max_scf: i32 = -1
                    if scfsi < 0 {
                        max_scf = (1 << (bits as u32)) - 1
                    }
                    var j: i32 = 0
                    while j < cnt {
                        let s: i32 = get_bits(bs, bits) as i32
                        var ip: u8 = s as u8
                        if s == max_scf {
                            ip = 255 as u8
                        }
                        sb(ist_pos, so + j as i64, ip)
                        sb(scf, so + j as i64, s as u8)
                        j = j + 1
                    }
                }
            }
            so = so + cnt as i64
            scfsi = scfsi * 2
            i = i + 1
        }
    }
    sb(scf, so, 0 as u8)
    sb(scf, so + 1, 0 as u8)
    sb(scf, so + 2, 0 as u8)
}

fn adr1(p: u64, i: i64) -> u64 {
    return p +% (i as u64)
}

// y * 2^(-exp_q2/4), in steps, so that the exponent never overflows.
fn l3_ldexp_q2(y_in: f32, exp_q2_in: i32) -> f32 {
    var ef: [f32; 4] = [9.31322575e-10f, 7.83145814e-10f, 6.58544508e-10f, 5.53767716e-10f]
    var y: f32 = y_in
    var exp_q2: i32 = exp_q2_in
    var next_step: bool = true
    while next_step {
        let e: i32 = mini(30 * 4, exp_q2)
        y = y * (ef[(e & 3) as usize] * (((1 << 30) >> ((e >> 2) as u32)) as f32))
        exp_q2 = exp_q2 - e
        next_step = exp_q2 > 0
    }
    return y
}

fn l3_decode_scalefactors(t: *mut mp3_tab.Tabs, h: u64, ist_pos: u64, bs: *mut Bs,
    gr: *mut GrInfo, scf_out: u64, ch: i32) {
    var scf_size: [u8; 4] = [0; 4]
    var iscf: [u8; 40] = [0; 40]
    let scf_size_p: u64 = (&scf_size[0]) as u64
    let iscf_p: u64 = (&iscf[0]) as u64

    var choice: i32 = 0
    if (*gr).n_short_sfb != 0 {
        choice = 1
    }
    if (*gr).n_long_sfb == 0 {
        choice = choice + 1
    }
    var teilung: u64 = (&(*t).partitions[0]) as u64 + (choice as u64) * 28

    let scf_shift: i32 = (*gr).scalefac_scale + 1
    var scfsi: i32 = (*gr).scfsi

    if hdr_test_mpeg1(h) {
        let part: i32 = (*t).scfc_decode[(*gr).scalefac_compress as usize] as i32
        scf_size[0] = (part >> 2) as u8
        scf_size[1] = scf_size[0]
        scf_size[2] = (part & 3) as u8
        scf_size[3] = scf_size[2]
    } else {
        var ist: i32 = 0
        if hdr_test_i_stereo(h) && ch != 0 {
            ist = 1
        }
        var sfc: i32 = (*gr).scalefac_compress >> (ist as u32)
        var k: i32 = ist * 3 * 4
        var modprod: i32 = 1
        while sfc >= 0 {
            modprod = 1
            var i: i32 = 3
            while i >= 0 {
                scf_size[i as usize] = (sfc / modprod % ((*t).modulo[(k + i) as usize] as i32)) as u8
                modprod = modprod * ((*t).modulo[(k + i) as usize] as i32)
                i = i - 1
            }
            sfc = sfc - modprod
            k = k + 4
        }
        teilung = teilung + (k as u64)
        scfsi = -16
    }

    l3_read_scalefactors(iscf_p, ist_pos, scf_size_p, teilung, bs, scfsi)

    if (*gr).n_short_sfb != 0 {
        let sh: i32 = 3 - scf_shift
        var i: i32 = 0
        while i < (*gr).n_short_sfb {
            let b: usize = ((*gr).n_long_sfb + i) as usize
            iscf[b + 0] = (iscf[b + 0] as i32 + ((*gr).subblock_gain[0] << (sh as u32))) as u8
            iscf[b + 1] = (iscf[b + 1] as i32 + ((*gr).subblock_gain[1] << (sh as u32))) as u8
            iscf[b + 2] = (iscf[b + 2] as i32 + ((*gr).subblock_gain[2] << (sh as u32))) as u8
            i = i + 3
        }
    } else {
        if (*gr).preflag != 0 {
            var i: usize = 0
            while i < 10 {
                iscf[11 + i] = (iscf[11 + i] as i32 + ((*t).preamp[i] as i32)) as u8
                i = i + 1
            }
        }
    }

    var gain_exp: i32 = (*gr).global_gain + (-1) * 4 - 210
    if hdr_is_ms_stereo(h) {
        gain_exp = gain_exp - 2
    }
    let gain: f32 = l3_ldexp_q2(((1 << ((MAX_SCFI / 4) as u32)) as f32), MAX_SCFI - gain_exp)
    var i: i32 = 0
    let n: i32 = (*gr).n_long_sfb + (*gr).n_short_sfb
    while i < n {
        sf(scf_out, i as i64, l3_ldexp_q2(gain, (iscf[i as usize] as i32) << (scf_shift as u32)))
        i = i + 1
    }
}

// x^(4/3) for the requantisation. Up to 128 from the table, above that
// via a series expansion -- the error stays below half an
// LSB of the 16-bit output, and that is the reason why the table does not
// have 8192 entries.
fn l3_pow_43(t: *mut mp3_tab.Tabs, x_in: i32) -> f32 {
    var x: i32 = x_in
    var mult: i32 = 256
    if x < 129 {
        return (*t).pow43[(16 + x) as usize]
    }
    if x < 1024 {
        mult = 16
        x = x << 3
    }
    let sign: i32 = (2 * x) & 64
    let frac: f32 = (((x & 63) - sign) as f32) / (((x & -64) + sign) as f32)
    let basis: f32 = (*t).pow43[(16 + ((x + sign) >> 6)) as usize]
    return basis * (1.0f + frac * ((4.0f / 3.0f) + frac * (2.0f / 9.0f))) * (mult as f32)
}

// ====================================================================
// HUFFMAN + REQUANTISATION
// ====================================================================
//
// The packed tree: an entry < 0 means "not finished yet, take
// `leaf & 7` more bits and jump `leaf >> 3` entries ahead".
// An entry >= 0 carries the number of consumed bits at the top (>> 8) and
// two values of four bits each at the bottom. All in ONE i16 array -- that is why
// this decoder runs without a tree and without pointers.

struct HuffLage {
    cache: u32,
    sh: i32,
    next: u64,
}

fn check_bits(l: *mut HuffLage) {
    while (*l).sh >= 0 {
        (*l).cache = (*l).cache | ((lb((*l).next, 0) as u32) << ((*l).sh as u32))
        (*l).next = (*l).next + 1
        (*l).sh = (*l).sh - 8
    }
}

fn peek_bits(l: *mut HuffLage, n: i32) -> i32 {
    return ((*l).cache >> ((32 - n) as u32)) as i32
}

fn flush_bits(l: *mut HuffLage, n: i32) {
    (*l).cache = (*l).cache << (n as u32)
    (*l).sh = (*l).sh + n
}

fn cache_negative(l: *mut HuffLage) -> bool {
    return ((*l).cache & 2147483648 as u32) != 0 as u32
}

#[inline]
fn count1_value(l: *mut HuffLage, dst_in: u64, at: i64, one: f32) {
    var v: f32 = one
    if cache_negative(l) {
        v = -one
    }
    sf(dst_in, at, v)
    flush_bits(l, 1)
}

struct HuffState {
    cache: u32,
    sh: i32,
    next: u64,
    dst: i64,
    scf: i64,
    sfb: u64,
    np: i32,
    one: f32,
}

// The count1 region: only values -1, 0, +1 left, in groups of four.
// `np` counts the pairs left in the current scalefactor band; it ticks at
// steps 0 and 2; reaching the end of the band table ends the region.
fn l3_count1(t: *mut mp3_tab.Tabs, dst_in: u64, bs: *mut Bs, gr: *mut GrInfo,
    scf_in: u64, layer3gr_limit: i32, st: *mut HuffState) {
    var cache: u32 = (*st).cache
    var sh: i32 = (*st).sh
    var nxt: u64 = (*st).next
    var dst: i64 = (*st).dst
    var scf: i64 = (*st).scf
    var sfb: u64 = (*st).sfb
    var np: i32 = (*st).np
    var one: f32 = (*st).one
    var tab: u64 = (&(*t).tab32[0]) as u64
    if (*gr).count1_table != 0 {
        tab = (&(*t).tab33[0]) as u64
    }
    let buf: u64 = (*bs).buf
    // bspos > limit  <=>  (nxt - buf) * 8 + sh > limit + 24
    let nlim: i32 = layer3gr_limit + 24
    while true {
        var leaf: i32 = lb(tab, (cache >> 28 as u32) as i64) as i32
        if (leaf & 8) == 0 {
            let offset: i32 = (leaf >> 3) + (((cache << 4 as u32) >> ((32 - (leaf & 3)) as u32)) as i32)
            leaf = lb(tab, offset as i64) as i32
        }
        let used: i32 = leaf & 7
        cache = cache << (used as u32)
        sh = sh + used
        if (((nxt - buf) as i32) * 8) + sh > nlim {
            break
        }
        np = np - 1
        if np == 0 {
            np = (lb(sfb, 0) as i32) / 2
            sfb = sfb + 1
            if np == 0 {
                break
            }
            one = lf(scf_in, scf)
            scf = scf + 1
        }
        if (leaf & 128) != 0 {
            var v: f32 = one
            if (cache & 2147483648 as u32) != 0 as u32 {
                v = -one
            }
            sf(dst_in, dst, v)
            cache = cache << 1 as u32
            sh = sh + 1
        }
        if (leaf & 64) != 0 {
            var v: f32 = one
            if (cache & 2147483648 as u32) != 0 as u32 {
                v = -one
            }
            sf(dst_in, dst + 1, v)
            cache = cache << 1 as u32
            sh = sh + 1
        }
        np = np - 1
        if np == 0 {
            np = (lb(sfb, 0) as i32) / 2
            sfb = sfb + 1
            if np == 0 {
                break
            }
            one = lf(scf_in, scf)
            scf = scf + 1
        }
        if (leaf & 32) != 0 {
            var v: f32 = one
            if (cache & 2147483648 as u32) != 0 as u32 {
                v = -one
            }
            sf(dst_in, dst + 2, v)
            cache = cache << 1 as u32
            sh = sh + 1
        }
        if (leaf & 16) != 0 {
            var v: f32 = one
            if (cache & 2147483648 as u32) != 0 as u32 {
                v = -one
            }
            sf(dst_in, dst + 3, v)
            cache = cache << 1 as u32
            sh = sh + 1
        }
        while sh >= 0 {
            cache = cache | ((lb(nxt, 0) as u32) << (sh as u32))
            nxt = nxt + 1
            sh = sh - 8
        }
        dst = dst + 4
    }
}

// One big-values coefficient: `lsb` is the 4 bit magnitude from the leaf;
// 15 with linbits != 0 means an escape value read from the stream.
#[inline]
fn big_value(t: *mut mp3_tab.Tabs, l: *mut HuffLage, dst_in: u64, at: i64, lsb_in: i32,
    linbits: i32, one: f32) {
    var lsb: i32 = lsb_in
    if linbits != 0 && lsb == 15 {
        lsb = lsb + peek_bits(l, linbits)
        flush_bits(l, linbits)
        check_bits(l)
        var v: f32 = one * l3_pow_43(t, lsb)
        if cache_negative(l) {
            v = -v
        }
        sf(dst_in, at, v)
    } else {
        var idx: i32 = 16 + lsb
        if cache_negative(l) {
            idx = idx - 16
        }
        sf(dst_in, at, (*t).pow43[idx as usize] * one)
    }
    if lsb != 0 {
        flush_bits(l, 1)
    }
}

fn l3_huffman(t: *mut mp3_tab.Tabs, dst_in: u64, bs: *mut Bs, gr: *mut GrInfo,
    scf_in: u64, layer3gr_limit: i32) {
    var dst: i64 = 0
    var scf: i64 = 0
    var one: f32 = 0.0f
    var ireg: i32 = 0
    var big_val_cnt: i32 = (*gr).big_values
    var sfb: u64 = (*gr).sfbtab
    var lage: HuffLage = HuffLage {
        cache: 0 as u32,
        sh: ((*bs).pos & 7) - 8,
        next: (*bs).buf + (((*bs).pos / 8) as u64),
    }
    let start: u64 = lage.next
    lage.cache = ((((lb(start, 0) as u32) * 256 as u32 +% (lb(start, 1) as u32)) * 256 as u32
            +% (lb(start, 2) as u32)) * 256 as u32 +% (lb(start, 3) as u32)) << (((*bs).pos & 7) as u32)
    lage.next = start + 4
    let l: *mut HuffLage = &lage

    while big_val_cnt > 0 {
        let tab_num: i32 = (*gr).table_select[ireg as usize]
        var sfb_cnt: i32 = (*gr).region_count[ireg as usize]
        ireg = ireg + 1
        let cb: i32 = (*t).tabindex[tab_num as usize] as i32
        let linbits: i32 = (*t).linbits[tab_num as usize] as i32

        var region_done: bool = false
        while !region_done {
            let np: i32 = (lb(sfb, 0) as i32) / 2
            sfb = sfb + 1
            var pairs: i32 = mini(big_val_cnt, np)
            one = lf(scf_in, scf)
            scf = scf + 1
            while pairs > 0 {
                var w: i32 = 5
                var leaf: i32 = (*t).tabs[(cb + peek_bits(l, w)) as usize] as i32
                while leaf < 0 {
                    flush_bits(l, w)
                    w = leaf & 7
                    leaf = (*t).tabs[(cb + peek_bits(l, w) - (leaf >> 3)) as usize] as i32
                }
                flush_bits(l, leaf >> 8)
                big_value(t, l, dst_in, dst, leaf & 15, linbits, one)
                big_value(t, l, dst_in, dst + 1, (leaf >> 4) & 15, linbits, one)
                dst = dst + 2
                check_bits(l)
                pairs = pairs - 1
            }
            big_val_cnt = big_val_cnt - np
            sfb_cnt = sfb_cnt - 1
            if big_val_cnt <= 0 || sfb_cnt < 0 {
                region_done = true
            }
        }
    }

    // The count1 region (own function: fewer live values, fewer spills).
    var st: HuffState = HuffState {
        cache: lage.cache, sh: lage.sh, next: lage.next, dst: dst, scf: scf,
        sfb: sfb, np: 1 - big_val_cnt, one: one,
    }
    l3_count1(t, dst_in, bs, gr, scf_in, layer3gr_limit, &st)
    (*bs).pos = layer3gr_limit
}

fn l3_intensity_stereo_band(left: u64, n: i32, kl: f32, kr: f32) {
    var i: i64 = 0
    while i < n as i64 {
        let v: f32 = lf(left, i)
        sf(left, i + 576, v * kr)
        sf(left, i, v * kl)
        i = i + 1
    }
}

fn l3_stereo_top_band(right_in: u64, sfb: u64, nbands: i32, max_band: *mut [i32; 3]) {
    (*max_band)[0] = -1
    (*max_band)[1] = -1
    (*max_band)[2] = -1
    var right: i64 = 0
    var i: i32 = 0
    while i < nbands {
        let width: i32 = lb(sfb, i as i64) as i32
        var k: i32 = 0
        while k < width {
            if lf(right_in, right + k as i64) != 0.0f || lf(right_in, right + (k + 1) as i64) != 0.0f {
                (*max_band)[(i % 3) as usize] = i
                k = width
            } else {
                k = k + 2
            }
        }
        right = right + width as i64
        i = i + 1
    }
}

fn l3_stereo_process(t: *mut mp3_tab.Tabs, left_in: u64, ist_pos: u64, sfb: u64,
    h: u64, max_band: *mut [i32; 3], mpeg2_sh: i32) {
    var max_pos: i32 = 64
    if hdr_test_mpeg1(h) {
        max_pos = 7
    }
    var left: i64 = 0
    var i: i32 = 0
    var width: i32 = lb(sfb, 0) as i32
    while width != 0 {
        let ipos: i32 = lb(ist_pos, i as i64) as i32
        if i > (*max_band)[(i % 3) as usize] && ipos < max_pos {
            var s: f32 = 1.0f
            if hdr_is_ms_stereo(h) {
                s = 1.41421356f
            }
            var kl: f32 = 0.0f
            var kr: f32 = 0.0f
            if hdr_test_mpeg1(h) {
                kl = (*t).pan[(2 * ipos) as usize]
                kr = (*t).pan[(2 * ipos + 1) as usize]
            } else {
                kl = 1.0f
                kr = l3_ldexp_q2(1.0f, ((ipos + 1) >> 1) << (mpeg2_sh as u32))
                if (ipos & 1) != 0 {
                    kl = kr
                    kr = 1.0f
                }
            }
            l3_intensity_stereo_band(adr4(left_in, left), width, kl * s, kr * s)
        } else {
            if hdr_is_ms_stereo(h) {
                mp3_vec.l3_midside_stereo(adr4(left_in, left), width)
            }
        }
        left = left + width as i64
        i = i + 1
        width = lb(sfb, i as i64) as i32
    }
}

fn l3_intensity_stereo(t: *mut mp3_tab.Tabs, left: u64, ist_pos: u64, gr: *mut GrInfo,
    gr1: *mut GrInfo, h: u64) {
    var max_band: [i32; 3] = [0; 3]
    let n_sfb: i32 = (*gr).n_long_sfb + (*gr).n_short_sfb
    var max_blocks: i32 = 1
    if (*gr).n_short_sfb != 0 {
        max_blocks = 3
    }
    l3_stereo_top_band(adr4(left, 576), (*gr).sfbtab, n_sfb, &max_band)
    if (*gr).n_long_sfb != 0 {
        let m: i32 = maxi(maxi(max_band[0], max_band[1]), max_band[2])
        max_band[0] = m
        max_band[1] = m
        max_band[2] = m
    }
    var default_pos: i32 = 0
    if hdr_test_mpeg1(h) {
        default_pos = 3
    }
    var i: i32 = 0
    while i < max_blocks {
        let itop: i32 = n_sfb - max_blocks + i
        let prev: i32 = itop - max_blocks
        var v: u8 = default_pos as u8
        if max_band[i as usize] < prev {
            v = lb(ist_pos, prev as i64)
        }
        sb(ist_pos, itop as i64, v)
        i = i + 1
    }
    l3_stereo_process(t, left, ist_pos, (*gr).sfbtab, h, &max_band, (*gr1).scalefac_compress & 1)
}

// ====================================================================
// REORDER, ANTIALIAS, IMDCT
// ====================================================================

fn l3_reorder(grbuf: u64, scratch: u64, sfb_in: u64) {
    var sfb: u64 = sfb_in
    var src: i64 = 0
    var dst: i64 = 0
    var len: i32 = lb(sfb, 0) as i32
    while len != 0 {
        var i: i32 = 0
        while i < len {
            sf(scratch, dst, lf(grbuf, src))
            sf(scratch, dst + 1, lf(grbuf, src + len as i64))
            sf(scratch, dst + 2, lf(grbuf, src + (2 * len) as i64))
            dst = dst + 3
            src = src + 1
            i = i + 1
        }
        src = src + (2 * len) as i64
        sfb = sfb + 3
        len = lb(sfb, 0) as i32
    }
    rt.mem_copy(grbuf, scratch, (dst as usize) * 4)
}

fn l3_idct3(x0: f32, x1: f32, x2: f32, dst: u64) {
    let m1: f32 = x1 * 0.86602540f
    let a1: f32 = x0 - x2 * 0.5f
    sf(dst, 1, x0 + x2)
    sf(dst, 0, a1 + m1)
    sf(dst, 2, a1 - m1)
}

fn l3_imdct12(t: *mut mp3_tab.Tabs, x: u64, dst: u64, overlap: u64) {
    let twid3: u64 = (&(*t).twid3[0]) as u64
    var co: [f32; 3] = [0.0f; 3]
    var si: [f32; 3] = [0.0f; 3]
    let cop: u64 = (&co[0]) as u64
    let sip: u64 = (&si[0]) as u64
    l3_idct3(-lf(x, 0), lf(x, 6) + lf(x, 3), lf(x, 12) + lf(x, 9), cop)
    l3_idct3(lf(x, 15), lf(x, 12) - lf(x, 9), lf(x, 6) - lf(x, 3), sip)
    si[1] = -si[1]
    var i: i32 = 0
    while i < 3 {
        let ovl: f32 = lf(overlap, i as i64)
        let sum: f32 = co[i as usize] * lf(twid3, (3 + i) as i64) + si[i as usize] * lf(twid3, i as i64)
        sf(overlap, i as i64, co[i as usize] * lf(twid3, i as i64) - si[i as usize] * lf(twid3, (3 + i) as i64))
        sf(dst, i as i64, ovl * lf(twid3, (2 - i) as i64) - sum * lf(twid3, (5 - i) as i64))
        sf(dst, (5 - i) as i64, ovl * lf(twid3, (5 - i) as i64) + sum * lf(twid3, (2 - i) as i64))
        i = i + 1
    }
}

fn l3_imdct_short(t: *mut mp3_tab.Tabs, grbuf_in: u64, overlap_in: u64, nbands_in: i32) {
    var nbands: i32 = nbands_in
    var grbuf: u64 = grbuf_in
    var overlap: u64 = overlap_in
    while nbands > 0 {
        var tmp: [f32; 18] = [0.0f; 18]
        let tmpp: u64 = (&tmp[0]) as u64
        rt.mem_copy(tmpp, grbuf, 18 * 4)
        rt.mem_copy(grbuf, overlap, 6 * 4)
        l3_imdct12(t, tmpp, adr4(grbuf, 6), adr4(overlap, 6))
        l3_imdct12(t, adr4(tmpp, 1), adr4(grbuf, 12), adr4(overlap, 6))
        l3_imdct12(t, adr4(tmpp, 2), overlap, adr4(overlap, 6))
        overlap = adr4(overlap, 9)
        grbuf = adr4(grbuf, 18)
        nbands = nbands - 1
    }
}

fn l3_change_sign(grbuf: u64) {
    var b: i32 = 0
    var basis: i64 = 18
    while b < 32 {
        var i: i32 = 1
        while i < 18 {
            sf(grbuf, basis + i as i64, -lf(grbuf, basis + i as i64))
            i = i + 2
        }
        basis = basis + 36
        b = b + 2
    }
}

fn l3_imdct_gr(t: *mut mp3_tab.Tabs, grbuf_in: u64, overlap_in: u64, block_type: i32, n_long_bands: i32) {
    let window0: u64 = (&(*t).window[0]) as u64
    var grbuf: u64 = grbuf_in
    var overlap: u64 = overlap_in
    if n_long_bands != 0 {
        mp3_vec.l3_imdct36(t, grbuf, overlap, window0, n_long_bands)
        grbuf = adr4(grbuf, (18 * n_long_bands) as i64)
        overlap = adr4(overlap, (9 * n_long_bands) as i64)
    }
    if block_type == SHORT_BLOCK_TYPE {
        l3_imdct_short(t, grbuf, overlap, 32 - n_long_bands)
    } else {
        var window: u64 = window0
        if block_type == STOP_BLOCK_TYPE {
            window = adr4(window0, 18)
        }
        mp3_vec.l3_imdct36(t, grbuf, overlap, window, 32 - n_long_bands)
    }
}

// ====================================================================
// BIT RESERVOIR
// ====================================================================

fn l3_save_reservoir(dec: *mut Mp3Dec, s: *mut Mp3Scratch) {
    var pos: i32 = ((*s).bs.pos + 7) / 8
    var remains: i32 = (*s).bs.limit / 8 - pos
    if remains > (MAX_BITRESERVOIR_BYTES as i32) {
        pos = pos + remains - (MAX_BITRESERVOIR_BYTES as i32)
        remains = MAX_BITRESERVOIR_BYTES as i32
    }
    if remains > 0 {
        rt.mem_copy((&(*dec).reserv_buf[0]) as u64,
            (&(*s).maindata[0]) as u64 + (pos as u64),
            remains as usize)
    }
    (*dec).reserv = remains
}

fn l3_restore_reservoir(dec: *mut Mp3Dec, bs: *mut Bs, s: *mut Mp3Scratch, main_data_begin: i32) -> bool {
    let frame_bytes: i32 = ((*bs).limit - (*bs).pos) / 8
    let bytes_have: i32 = mini((*dec).reserv, main_data_begin)
    let source: u64 = (&(*dec).reserv_buf[0]) as u64 + (maxi(0, (*dec).reserv - main_data_begin) as u64)
    let target: u64 = (&(*s).maindata[0]) as u64
    rt.mem_copy(target, source, mini((*dec).reserv, main_data_begin) as usize)
    rt.mem_copy(target + (bytes_have as u64),
        (*bs).buf + (((*bs).pos / 8) as u64),
        frame_bytes as usize)
    bs_init(&(*s).bs, target, bytes_have + frame_bytes)
    return (*dec).reserv >= main_data_begin
}

// ====================================================================
// ONE GRANULE COMPLETELY
// ====================================================================

fn l3_decode(t: *mut mp3_tab.Tabs, dec: *mut Mp3Dec, s: *mut Mp3Scratch, gr_base: i32, nch: i32) {
    let h: u64 = (&(*dec).header[0]) as u64
    let scf: u64 = (&(*s).scf[0]) as u64

    var ch: i32 = 0
    while ch < nch {
        let g: *mut GrInfo = &(*s).gr_info[(gr_base + ch) as usize]
        let limit: i32 = (*s).bs.pos + (*g).part_23_length
        l3_decode_scalefactors(t, h, (&(*s).ist_pos[ch as usize][0]) as u64, &(*s).bs, g, scf, ch)
        l3_huffman(t, (&(*s).grbuf[ch as usize][0]) as u64, &(*s).bs, g, scf, limit)
        ch = ch + 1
    }

    let left: u64 = (&(*s).grbuf[0][0]) as u64
    if hdr_test_i_stereo(h) {
        l3_intensity_stereo(t, left, (&(*s).ist_pos[1][0]) as u64,
            &(*s).gr_info[gr_base as usize],
            &(*s).gr_info[(gr_base + 1) as usize], h)
    } else {
        if hdr_is_ms_stereo(h) {
            mp3_vec.l3_midside_stereo(left, 576)
        }
    }

    ch = 0
    while ch < nch {
        let g: *mut GrInfo = &(*s).gr_info[(gr_base + ch) as usize]
        var aa_bands: i32 = 31
        var n_long_bands: i32 = 0
        if (*g).mixed_block_flag != 0 {
            n_long_bands = 2
        }
        if hdr_my_sample_rate(h) == 2 {
            n_long_bands = n_long_bands * 2
        }
        let channel: u64 = (&(*s).grbuf[ch as usize][0]) as u64
        if (*g).n_short_sfb != 0 {
            aa_bands = n_long_bands - 1
            l3_reorder(adr4(channel, (n_long_bands * 18) as i64),
                (&(*s).syn[0][0]) as u64,
                adr1((*g).sfbtab, (*g).n_long_sfb as i64))
        }
        mp3_vec.l3_antialias(t, channel, aa_bands)
        l3_imdct_gr(t, channel, (&(*dec).mdct_overlap[ch as usize][0]) as u64, (*g).block_type, n_long_bands)
        l3_change_sign(channel)
        ch = ch + 1
    }
}

fn scale_pcm(abtast: f32) -> i16 {
    let bottom: i32 = -32768
    if abtast >= 32766.5f {
        return 32767 as i16
    }
    if abtast <= -32767.5f {
        return bottom as i16
    }
    var s: i32 = (abtast + 0.5f) as i32
    if s < 0 {
        s = s - 1
    }
    if s > 32767 {
        s = 32767
    }
    if s < bottom {
        s = bottom
    }
    return s as i16
}

fn synth_pair(pcm: u64, nch: i32, z_in: u64) {
    var z: u64 = z_in
    var a: f32 = (lf(z, 14 * 64) - lf(z, 0)) * 29.0f
    a = a + (lf(z, 1 * 64) + lf(z, 13 * 64)) * 213.0f
    a = a + (lf(z, 12 * 64) - lf(z, 2 * 64)) * 459.0f
    a = a + (lf(z, 3 * 64) + lf(z, 11 * 64)) * 2037.0f
    a = a + (lf(z, 10 * 64) - lf(z, 4 * 64)) * 5153.0f
    a = a + (lf(z, 5 * 64) + lf(z, 9 * 64)) * 6574.0f
    a = a + (lf(z, 8 * 64) - lf(z, 6 * 64)) * 37489.0f
    a = a + lf(z, 7 * 64) * 75038.0f
    s16(pcm, 0, scale_pcm(a))

    z = adr4(z, 2)
    a = lf(z, 14 * 64) * 104.0f
    a = a + lf(z, 12 * 64) * 1567.0f
    a = a + lf(z, 10 * 64) * 9727.0f
    a = a + lf(z, 8 * 64) * 64019.0f
    a = a + lf(z, 6 * 64) * -9975.0f
    a = a + lf(z, 4 * 64) * -45.0f
    a = a + lf(z, 2 * 64) * 146.0f
    a = a + lf(z, 0) * -5.0f
    s16(pcm, (16 * nch) as i64, scale_pcm(a))
}

fn synth_granule(t: *mut mp3_tab.Tabs, qmf_state: u64, grbuf: u64, nbands: i32, nch: i32, pcm: u64, lins: u64) {
    var i: i32 = 0
    while i < nch {
        mp3_vec.dct_ii(t, adr4(grbuf, (576 * i) as i64), nbands)
        i = i + 1
    }
    mp3_vec.copy_qmf(lins, qmf_state)
    i = 0
    while i < nbands {
        mp3_vec.synth(t, adr4(grbuf, i as i64), adr2(pcm, (32 * nch * i) as i64), nch, adr4(lins, (i * 64) as i64))
        i = i + 2
    }
    if nch == 1 {
        i = 0
        while i < 15 * 64 {
            sf(qmf_state, i as i64, lf(lins, (nbands * 64 + i) as i64))
            i = i + 2
        }
    } else {
        mp3_vec.copy_qmf(qmf_state, adr4(lins, (nbands * 64) as i64))
    }
}

// ====================================================================
// FINDING FRAMES
// ====================================================================

fn match_frame(t: *mut mp3_tab.Tabs, hdr: u64, mp3_bytes: i32, frame_bytes: i32) -> bool {
    var i: i32 = 0
    var nmatch: i32 = 0
    while nmatch < MAX_FRAME_SYNC_MATCHES {
        i = i + hdr_frame_octets(t, adr1(hdr, i as i64), frame_bytes) + hdr_padding(adr1(hdr, i as i64))
        if i + HDR_SIZE > mp3_bytes {
            return nmatch > 0
        }
        if !hdr_compare(hdr, adr1(hdr, i as i64)) {
            return false
        }
        nmatch = nmatch + 1
    }
    return true
}

struct Found {
    offset: i32,
    frame_bytes: i32,
    free_format_bytes: i32,
}

fn find_frame(t: *mut mp3_tab.Tabs, mp3: u64, mp3_bytes: i32, free_format_bytes: i32) -> Found {
    var free_slots: i32 = free_format_bytes
    var i: i32 = 0
    while i < mp3_bytes - HDR_SIZE {
        let h: u64 = adr1(mp3, i as i64)
        if hdr_valid(h) {
            var frame_bytes: i32 = hdr_frame_octets(t, h, free_slots)
            var frame_and_padding: i32 = frame_bytes + hdr_padding(h)

            var k: i32 = HDR_SIZE
            while frame_bytes == 0 && k < MAX_FREE_FORMAT_FRAME_SIZE && i + 2 * k < mp3_bytes - HDR_SIZE {
                if hdr_compare(h, adr1(h, k as i64)) {
                    let fb: i32 = k - hdr_padding(h)
                    let nextfb: i32 = fb + hdr_padding(adr1(h, k as i64))
                    if i + k + nextfb + HDR_SIZE <= mp3_bytes && hdr_compare(h, adr1(h, (k + nextfb) as i64)) {
                        frame_and_padding = k
                        frame_bytes = fb
                        free_slots = fb
                    }
                }
                k = k + 1
            }

            var gut: bool = false
            if frame_bytes != 0 && i + frame_and_padding <= mp3_bytes {
                gut = match_frame(t, h, mp3_bytes - i, frame_bytes)
            }
            if i == 0 && frame_and_padding == mp3_bytes {
                gut = true
            }
            if gut {
                return Found { offset: i, frame_bytes: frame_and_padding, free_format_bytes: free_slots }
            }
            free_slots = 0
        }
        i = i + 1
    }
    return Found { offset: mp3_bytes, frame_bytes: 0, free_format_bytes: free_slots }
}

// ====================================================================
// THE ONE CALL THE WORLD SEES
// ====================================================================
//
// Returns the number of samples PER CHANNEL (0 = no frame
// decoded). `info.frame_bytes` ALWAYS says how many octets the
// caller has to advance -- also at 0, so that a stream with junk
// at the front does not stand still.

fn mp3_decode_frame(t: *mut mp3_tab.Tabs, dec: *mut Mp3Dec, s: *mut Mp3Scratch,
    mp3: u64, mp3_bytes: i32, pcm: u64, info: *mut Mp3Info) -> i32 {
    var i: i32 = 0
    var frame_size: i32 = 0
    var success: bool = true
    let own_header: u64 = (&(*dec).header[0]) as u64

    if mp3_bytes > 4 && (*dec).header[0] == 255 as u8 && hdr_compare(own_header, mp3) {
        frame_size = hdr_frame_octets(t, mp3, (*dec).free_format_bytes) + hdr_padding(mp3)
        if frame_size != mp3_bytes {
            if frame_size + HDR_SIZE > mp3_bytes || !hdr_compare(mp3, adr1(mp3, frame_size as i64)) {
                frame_size = 0
            }
        }
    }
    if frame_size == 0 {
        var k: usize = 0
        while k < 4 {
            (*dec).header[k] = 0 as u8
            k = k + 1
        }
        (*dec).reserv = 0
        (*dec).free_format_bytes = 0
        rt.mem_set((&(*dec).mdct_overlap[0][0]) as u64, 0 as u8, 288 * 2 * 4)
        rt.mem_set((&(*dec).qmf_state[0]) as u64, 0 as u8, 960 * 4)
        let f: Found = find_frame(t, mp3, mp3_bytes, (*dec).free_format_bytes)
        i = f.offset
        frame_size = f.frame_bytes
        (*dec).free_format_bytes = f.free_format_bytes
        if frame_size == 0 || i + frame_size > mp3_bytes {
            (*info).frame_bytes = i
            return 0
        }
    }

    let hdr: u64 = adr1(mp3, i as i64)
    rt.mem_copy(own_header, hdr, 4)
    (*info).frame_bytes = i + frame_size
    (*info).frame_offset = i
    (*info).channels = hdr_kanaele(hdr)
    (*info).hz = hdr_abtastrate(hdr)
    (*info).layer = 4 - hdr_layer(hdr)
    (*info).bitrate_kbps = hdr_bitrate_kbps(t, hdr)

    if pcm == 0 {
        return hdr_frame_samples(hdr)
    }

    var bs_frame: Bs = Bs { buf: 0, pos: 0, limit: 0 }
    bs_init(&bs_frame, adr1(hdr, HDR_SIZE as i64), frame_size - HDR_SIZE)
    if hdr_is_crc(hdr) {
        get_bits(&bs_frame, 16)
    }

    if (*info).layer != 3 {
        // E1: we cannot do layer I/II -- skip the frame, do not guess.
        return 0
    }

    let main_data_begin: i32 = l3_read_side_info(t, &bs_frame, s, hdr)
    if main_data_begin < 0 || bs_frame.pos > bs_frame.limit {
        (*dec).header[0] = 0 as u8
        return 0
    }
    success = l3_restore_reservoir(dec, &bs_frame, s, main_data_begin)
    if success {
        var granulen: i32 = 1
        if hdr_test_mpeg1(hdr) {
            granulen = 2
        }
        var igr: i32 = 0
        while igr < granulen {
            rt.mem_set((&(*s).grbuf[0][0]) as u64, 0 as u8, 576 * 2 * 4)
            l3_decode(t, dec, s, igr * (*info).channels, (*info).channels)
            synth_granule(t, (&(*dec).qmf_state[0]) as u64, (&(*s).grbuf[0][0]) as u64, 18,
                (*info).channels, adr2(pcm, ((igr * 576) * (*info).channels) as i64),
                (&(*s).syn[0][0]) as u64)
            igr = igr + 1
        }
    }
    l3_save_reservoir(dec, s)
    if !success {
        return 0
    }
    return hdr_frame_samples(own_header)
}
