// Counter-test to bench_main.fi: the same loop structure, but in INTEGERS.
// So it runs through the register allocator of the compiler (which so far
// can only do integers) -- the gap to C shows what the allocation is worth.
import std.rt
import std.io

fn kern(z: u64, w: u64, n: i32) -> i64 {
    var sum: i64 = 0
    var r: i32 = 0
    while r < n {
        var a0: i64 = 0
        var a1: i64 = 0
        var a2: i64 = 0
        var a3: i64 = 0
        var k: i32 = 0
        while k < 8 {
            let w0: i64 = *((w + (k as u64) * 16) as *mut i64)
            let w1: i64 = *((w + (k as u64) * 16 + 8) as *mut i64)
            let p: u64 = z + ((k as u64) * 512) + ((r as u64 % 64) * 8)
            let z0: i64 = *(p as *mut i64)
            let z1: i64 = *((p + 8) as *mut i64)
            let z2: i64 = *((p + 16) as *mut i64)
            let z3: i64 = *((p + 24) as *mut i64)
            a0 = a0 +% (z0 *% w0 -% z1 *% w1)
            a1 = a1 +% (z1 *% w1 +% z0 *% w0)
            a2 = a2 +% (z2 *% w0 -% z3 *% w1)
            a3 = a3 +% (z3 *% w1 +% z2 *% w0)
            k = k + 1
        }
        sum = sum +% (a0 +% a1 +% a2 +% a3)
        r = r + 1
    }
    return sum
}

fn main() -> i32 {
    var z: [i64; 4096] = [0; 4096]
    var w: [i64; 16] = [0; 16]
    var i: usize = 0
    while i < 4096 {
        z[i] = (i % 97) as i64
        i = i + 1
    }
    i = 0
    while i < 16 {
        w[i] = (i % 7) as i64
        i = i + 1
    }
    let s: i64 = kern((&z[0]) as u64, (&w[0]) as u64, 2000000)
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, s)
    rt.buf_push(&b, 10 as u8)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    return 0
}
