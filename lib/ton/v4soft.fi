// SPDX-License-Identifier: MPL-2.0
import std.core

export {
    V128, from_u64, zero, load, store, store64, addf32, subf32, mulf32, minf32, maxf32, xor, add32, cmpgt_i32,
    trunc_f32_i32, shuffle32, shuf_f32, unpacklo32, unpackhi32,
}

struct V128 {
    a: u32,
    b: u32,
    c: u32,
    d: u32,
}

fn mk(a: u32, b: u32, c: u32, d: u32) -> V128 {
    return V128 { a: a, b: b, c: c, d: d }
}

fn fl(x: u32) -> f32 {
    return core.bits_f32(x)
}

fn bf(x: f32) -> u32 {
    return core.f32_bits(x)
}

fn lane(v: V128, i: u32) -> u32 {
    if i == 0 as u32 {
        return v.a
    }
    if i == 1 as u32 {
        return v.b
    }
    if i == 2 as u32 {
        return v.c
    }
    return v.d
}

fn from_u64(lo: u64, hi: u64) -> V128 {
    return mk((lo & 0xFFFFFFFF as u64) as u32, (lo >> 32) as u32, (hi & 0xFFFFFFFF as u64) as u32, (hi >> 32) as u32)
}

fn zero() -> V128 {
    return mk(0 as u32, 0 as u32, 0 as u32, 0 as u32)
}

fn ld32(p: u64, i: u64) -> u32 {
    return *((p +% i *% 4 as u64) as *mut u32)
}

fn st32(p: u64, i: u64, v: u32) {
    *((p +% i *% 4 as u64) as *mut u32) = v
}

fn load(p: *u8) -> V128 {
    let q: u64 = p as u64
    return mk(ld32(q, 0 as u64), ld32(q, 1 as u64), ld32(q, 2 as u64), ld32(q, 3 as u64))
}

fn store(p: *mut u8, v: V128) {
    let q: u64 = p as u64
    st32(q, 0 as u64, v.a)
    st32(q, 1 as u64, v.b)
    st32(q, 2 as u64, v.c)
    st32(q, 3 as u64, v.d)
}

fn store64(p: *mut u8, v: V128) {
    let q: u64 = p as u64
    st32(q, 0 as u64, v.a)
    st32(q, 1 as u64, v.b)
}

fn addf32(x: V128, y: V128) -> V128 {
    return mk(bf(fl(x.a) + fl(y.a)), bf(fl(x.b) + fl(y.b)), bf(fl(x.c) + fl(y.c)), bf(fl(x.d) + fl(y.d)))
}

fn subf32(x: V128, y: V128) -> V128 {
    return mk(bf(fl(x.a) - fl(y.a)), bf(fl(x.b) - fl(y.b)), bf(fl(x.c) - fl(y.c)), bf(fl(x.d) - fl(y.d)))
}

fn mulf32(x: V128, y: V128) -> V128 {
    return mk(bf(fl(x.a) * fl(y.a)), bf(fl(x.b) * fl(y.b)), bf(fl(x.c) * fl(y.c)), bf(fl(x.d) * fl(y.d)))
}

fn min1(x: u32, y: u32) -> u32 {
    if fl(x) < fl(y) {
        return x
    }
    return y
}

fn max1(x: u32, y: u32) -> u32 {
    if fl(x) > fl(y) {
        return x
    }
    return y
}

fn minf32(x: V128, y: V128) -> V128 {
    return mk(min1(x.a, y.a), min1(x.b, y.b), min1(x.c, y.c), min1(x.d, y.d))
}

fn maxf32(x: V128, y: V128) -> V128 {
    return mk(max1(x.a, y.a), max1(x.b, y.b), max1(x.c, y.c), max1(x.d, y.d))
}

fn xor(x: V128, y: V128) -> V128 {
    return mk(x.a ^ y.a, x.b ^ y.b, x.c ^ y.c, x.d ^ y.d)
}

fn add32(x: V128, y: V128) -> V128 {
    return mk(x.a +% y.a, x.b +% y.b, x.c +% y.c, x.d +% y.d)
}

fn gt1(x: u32, y: u32) -> u32 {
    if (x as% i32) > (y as% i32) {
        return 0xFFFFFFFF as u32
    }
    return 0 as u32
}

fn cmpgt_i32(x: V128, y: V128) -> V128 {
    return mk(gt1(x.a, y.a), gt1(x.b, y.b), gt1(x.c, y.c), gt1(x.d, y.d))
}

fn tr1(x: u32) -> u32 {
    return (fl(x) as i32) as% u32
}

fn trunc_f32_i32(x: V128) -> V128 {
    return mk(tr1(x.a), tr1(x.b), tr1(x.c), tr1(x.d))
}

fn shuffle32(x: V128, imm: u32) -> V128 {
    return mk(lane(x, imm & 3 as u32), lane(x, (imm >> 2) & 3 as u32), lane(x, (imm >> 4) & 3 as u32), lane(x, (imm >> 6) & 3 as u32))
}

fn shuf_f32(x: V128, y: V128, imm: u32) -> V128 {
    return mk(lane(x, imm & 3 as u32), lane(x, (imm >> 2) & 3 as u32), lane(y, (imm >> 4) & 3 as u32), lane(y, (imm >> 6) & 3 as u32))
}

fn unpacklo32(x: V128, y: V128) -> V128 {
    return mk(x.a, y.a, x.b, y.b)
}

fn unpackhi32(x: V128, y: V128) -> V128 {
    return mk(x.c, y.c, x.d, y.d)
}
