// SPDX-License-Identifier: MPL-2.0
// lib/ton/bench_main.fi -- micro-measurement: how close does Firn get to C?
// Rebuilt is the core of the synthesis filter bank: 8 weighted sums
// over four voices, exactly the loop in which the decoder spends most of
// its time.
import std.rt
import std.io

fn kern(z: u64, w: u64, n: i32) -> f32 {
    var sum: f32 = 0.0f
    var r: i32 = 0
    while r < n {
        var a0: f32 = 0.0f
        var a1: f32 = 0.0f
        var a2: f32 = 0.0f
        var a3: f32 = 0.0f
        var k: i32 = 0
        while k < 8 {
            let w0: f32 = *((w + (k as u64) * 8) as *mut f32)
            let w1: f32 = *((w + (k as u64) * 8 + 4) as *mut f32)
            let p: u64 = z + ((k as u64) * 256) + ((r as u64 % 64) * 4)
            let z0: f32 = *(p as *mut f32)
            let z1: f32 = *((p + 4) as *mut f32)
            let z2: f32 = *((p + 8) as *mut f32)
            let z3: f32 = *((p + 12) as *mut f32)
            a0 = a0 + (z0 * w0 - z1 * w1)
            a1 = a1 + (z1 * w1 + z0 * w0)
            a2 = a2 + (z2 * w0 - z3 * w1)
            a3 = a3 + (z3 * w1 + z2 * w0)
            k = k + 1
        }
        sum = sum + (a0 + a1 + a2 + a3)
        r = r + 1
    }
    return sum
}

fn main() -> i32 {
    var z: [f32; 4096] = [0.0f; 4096]
    var w: [f32; 16] = [0.0f; 16]
    var i: usize = 0
    while i < 4096 {
        z[i] = ((i % 97) as f32) * 0.01f
        i = i + 1
    }
    i = 0
    while i < 16 {
        w[i] = ((i % 7) as f32) * 0.125f
        i = i + 1
    }
    let s: f32 = kern((&z[0]) as u64, (&w[0]) as u64, 2000000)
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, (s as i64))
    rt.buf_push(&b, 10 as u8)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    return 0
}
