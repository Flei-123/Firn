// SPDX-License-Identifier: MPL-2.0
// lib/ton/mp3_main.fi -- the measuring driver of the MP3 decoder.
//
// Usage:  mp3 <input.mp3> <output.pcm>
//
// Reads the whole file, decodes every frame and writes raw PCM
// (16 bit, little-endian, interleaved) into the output file. One line goes to
// standard output
//     <samplerate> <channels> <frames> <samples>
// -- exactly the four numbers the comparison against ffmpeg needs.
import std.rt
import std.io
import ton.mp3
import ton.mp3_tab

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        io.print_line("Usage: mp3 <input.mp3> <output.pcm>")
        return 2
    }
    let ein: u64 = rt.arg_ptr(start, 1)
    let aus: u64 = rt.arg_ptr(start, 2)

    var source: rt.Buf = rt.buf_new()
    if !rt.read_file(ein, &source) {
        io.print_line("input not readable")
        return 3
    }
    let data: u64 = rt.buf_ptr(&source)
    let length: usize = rt.buf_len(&source)

    var tabs: mp3_tab.Tabs = mp3_tab.tabs_new()
    var dec: mp3.Mp3Dec = mp3.mp3_new()
    var kratz: mp3.Mp3Scratch = mp3.mp3_scratch_new()
    var info: mp3.Mp3Info = mp3.Mp3Info {
        frame_bytes: 0, frame_offset: 0, channels: 0, hz: 0, layer: 0, bitrate_kbps: 0,
    }
    var pcm: [i16; 2304] = [0; 2304]

    var target: rt.Buf = rt.buf_new()
    var pos: usize = 0
    var frame: i32 = 0
    var values: i64 = 0
    var hz: i32 = 0
    var kanaele: i32 = 0

    while pos < length {
        let rest: usize = length - pos
        let n: i32 = mp3.mp3_decode_frame(&tabs, &dec, &kratz, data + (pos as u64),
            rest as i32, (&pcm[0]) as u64, &info)
        if info.frame_bytes == 0 {
            pos = length
        } else {
            pos = pos + (info.frame_bytes as usize)
            if n > 0 {
                frame = frame + 1
                hz = info.hz
                kanaele = info.channels
                values = values + (n as i64)
                rt.buf_push_bytes(&target, (&pcm[0]) as u64, (n as usize) * (info.channels as usize) * 2)
            }
        }
    }

    if !rt.write_file(aus, rt.buf_ptr(&target), rt.buf_len(&target)) {
        io.print_line("output not writable")
        return 4
    }

    var z: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&z, hz as u64)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_u64(&z, kanaele as u64)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_u64(&z, frame as u64)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_u64(&z, values as u64)
    rt.buf_push(&z, 10 as u8)
    io.print_bytes(rt.buf_ptr(&z), rt.buf_len(&z))
    return 0
}
