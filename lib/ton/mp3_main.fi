// SPDX-License-Identifier: MPL-2.0
// lib/ton/mp3_main.fi -- der Messtreiber des MP3-Dekoders.
//
// Aufruf:  mp3 <eingabe.mp3> <ausgabe.pcm>
//
// Liest die ganze Datei, dekodiert jeden Rahmen und schreibt rohes PCM
// (16 Bit, little-endian, verschachtelt) in die Ausgabedatei. Auf die
// Standardausgabe kommt eine Zeile
//     <abtastrate> <kanaele> <rahmen> <abtastwerte>
// -- genau die vier Zahlen, die der Vergleich gegen ffmpeg braucht.
import std.rt
import std.io
import ton.mp3
import ton.mp3_tab

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        io.print_line("Aufruf: mp3 <eingabe.mp3> <ausgabe.pcm>")
        return 2
    }
    let ein: u64 = rt.arg_ptr(start, 1)
    let aus: u64 = rt.arg_ptr(start, 2)

    var quelle: rt.Buf = rt.buf_new()
    if !rt.read_file(ein, &quelle) {
        io.print_line("Eingabe nicht lesbar")
        return 3
    }
    let daten: u64 = rt.buf_ptr(&quelle)
    let laenge: usize = rt.buf_len(&quelle)

    var tabs: mp3_tab.Tabs = mp3_tab.tabs_new()
    var dec: mp3.Mp3Dec = mp3.mp3_new()
    var kratz: mp3.Mp3Scratch = mp3.mp3_scratch_new()
    var info: mp3.Mp3Info = mp3.Mp3Info {
        frame_bytes: 0, frame_offset: 0, channels: 0, hz: 0, layer: 0, bitrate_kbps: 0,
    }
    var pcm: [i16; 2304] = [0; 2304]

    var ziel: rt.Buf = rt.buf_new()
    var pos: usize = 0
    var rahmen: i32 = 0
    var werte: i64 = 0
    var hz: i32 = 0
    var kanaele: i32 = 0

    while pos < laenge {
        let rest: usize = laenge - pos
        let n: i32 = mp3.mp3_decode_frame(&tabs, &dec, &kratz, daten + (pos as u64),
                                          rest as i32, (&pcm[0]) as u64, &info)
        if info.frame_bytes == 0 {
            pos = laenge
        } else {
            pos = pos + (info.frame_bytes as usize)
            if n > 0 {
                rahmen = rahmen + 1
                hz = info.hz
                kanaele = info.channels
                werte = werte + (n as i64)
                rt.buf_push_bytes(&ziel, (&pcm[0]) as u64, (n as usize) * (info.channels as usize) * 2)
            }
        }
    }

    if !rt.write_file(aus, rt.buf_ptr(&ziel), rt.buf_len(&ziel)) {
        io.print_line("Ausgabe nicht schreibbar")
        return 4
    }

    var z: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&z, hz as u64)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_u64(&z, kanaele as u64)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_u64(&z, rahmen as u64)
    rt.buf_push(&z, 32 as u8)
    rt.buf_push_dec_u64(&z, werte as u64)
    rt.buf_push(&z, 10 as u8)
    io.print_bytes(rt.buf_ptr(&z), rt.buf_len(&z))
    return 0
}
