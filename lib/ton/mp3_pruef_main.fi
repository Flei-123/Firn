// SPDX-License-Identifier: MPL-2.0
// lib/ton/mp3_pruef_main.fi -- der Selbsttest des MP3-Dekoders.
//
// Aufruf:  mp3_pruef <stereo44.mp3> <mono24.mp3> <mono8.mp3> <kurzbloecke.mp3>
//          (die vier Dateien liegen in `testdata/ton`)
//
// Dekodiert vier Stroeme und vergleicht Abtastrate, Kanalzahl, Rahmenzahl,
// Zahl der Abtastwerte und eine FNV-1a-Pruefsumme ueber das gesamte PCM
// mit fest eingetragenen Sollwerten. Die Sollwerte stammen aus einem Lauf
// gegen die Vorlage minimp3 (C, skalar), der auf allen vier Dateien
// BITGENAU war -- wer hier etwas veraendert und die Pruefsumme bricht,
// hat den Klang veraendert, nicht nur den Quelltext.
//
// Rueckgabe 0 = alles gleich. Jede andere Zahl ist die Nummer der ersten
// Probe, die abgewichen ist.
import std.rt
import std.io
import ton.mp3
import ton.mp3_tab

fn fnv1a(p: u64, n: usize) -> u64 {
    var h: u64 = 14695981039346656037
    var i: usize = 0
    while i < n {
        h = h ^ (rt.ld8(p, i) as u64)
        h = h *% 1099511628211
        i = i + 1
    }
    return h
}

struct Soll {
    hz: i32,
    kanaele: i32,
    rahmen: i32,
    werte: i64,
    fnv: u64,
}

fn probe_laufen(tabs: *mut mp3_tab.Tabs, pfad: u64, pcm_puffer: u64,
                dec: *mut mp3.Mp3Dec, kratz: *mut mp3.Mp3Scratch,
                ergebnis: *mut Soll) -> bool {
    var quelle: rt.Buf = rt.buf_new()
    if !rt.read_file(pfad, &quelle) {
        rt.buf_free(&quelle)
        return false
    }
    let daten: u64 = rt.buf_ptr(&quelle)
    let laenge: usize = rt.buf_len(&quelle)

    var info: mp3.Mp3Info = mp3.Mp3Info {
        frame_bytes: 0, frame_offset: 0, channels: 0, hz: 0, layer: 0, bitrate_kbps: 0,
    }
    var alles: rt.Buf = rt.buf_new()
    var pos: usize = 0
    (*ergebnis).rahmen = 0
    (*ergebnis).werte = 0
    while pos < laenge {
        let n: i32 = mp3.mp3_decode_frame(tabs, dec, kratz, daten + (pos as u64),
                                          (laenge - pos) as i32, pcm_puffer, &info)
        if info.frame_bytes == 0 {
            pos = laenge
        } else {
            pos = pos + (info.frame_bytes as usize)
            if n > 0 {
                (*ergebnis).rahmen = (*ergebnis).rahmen + 1
                (*ergebnis).hz = info.hz
                (*ergebnis).kanaele = info.channels
                (*ergebnis).werte = (*ergebnis).werte + (n as i64)
                rt.buf_push_bytes(&alles, pcm_puffer, (n as usize) * (info.channels as usize) * 2)
            }
        }
    }
    (*ergebnis).fnv = fnv1a(rt.buf_ptr(&alles), rt.buf_len(&alles))
    rt.buf_free(&alles)
    rt.buf_free(&quelle)
    return true
}

fn gleich(a: *mut Soll, b: *mut Soll) -> bool {
    if (*a).hz != (*b).hz { return false }
    if (*a).kanaele != (*b).kanaele { return false }
    if (*a).rahmen != (*b).rahmen { return false }
    if (*a).werte != (*b).werte { return false }
    if (*a).fnv != (*b).fnv { return false }
    return true
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 5 {
        io.print_line("Aufruf: mp3_pruef <stereo44> <mono24> <mono8> <kurzbloecke>")
        return 9
    }

    var soll: [Soll; 4] = [
        Soll { hz: 44100, kanaele: 2, rahmen: 117, werte: 134784, fnv: 17215119225542028024 },
        Soll { hz: 24000, kanaele: 1, rahmen: 87, werte: 50112, fnv: 11724990210506242878 },
        Soll { hz: 8000, kanaele: 1, rahmen: 45, werte: 25920, fnv: 1015802880633938305 },
        Soll { hz: 44100, kanaele: 1, rahmen: 156, werte: 179712, fnv: 6150599424020114021 },
    ]

    var tabs: mp3_tab.Tabs = mp3_tab.tabs_new()
    var pcm: [i16; 2304] = [0; 2304]

    var i: usize = 0
    while i < 4 {
        var dec: mp3.Mp3Dec = mp3.mp3_new()
        var kratz: mp3.Mp3Scratch = mp3.mp3_scratch_new()
        var ist: Soll = Soll { hz: 0, kanaele: 0, rahmen: 0, werte: 0, fnv: 0 }
        if !probe_laufen(&tabs, rt.arg_ptr(start, i + 1), (&pcm[0]) as u64, &dec, &kratz, &ist) {
            io.print_line("Testdatei nicht lesbar")
            return (i as i32) + 1
        }
        if !gleich(&ist, &soll[i]) {
            io.print_line("ABWEICHUNG")
            var z: rt.Buf = rt.buf_new()
            rt.buf_push_dec_u64(&z, ist.hz as u64)
            rt.buf_push(&z, 32 as u8)
            rt.buf_push_dec_u64(&z, ist.kanaele as u64)
            rt.buf_push(&z, 32 as u8)
            rt.buf_push_dec_u64(&z, ist.rahmen as u64)
            rt.buf_push(&z, 32 as u8)
            rt.buf_push_dec_u64(&z, ist.werte as u64)
            rt.buf_push(&z, 32 as u8)
            rt.buf_push_dec_u64(&z, ist.fnv)
            rt.buf_push(&z, 10 as u8)
            io.print_bytes(rt.buf_ptr(&z), rt.buf_len(&z))
            return (i as i32) + 1
        }
        i = i + 1
    }
    io.print_line("PASS 4/4 -- MP3 bitgleich zum festgehaltenen Stand")
    return 0
}
