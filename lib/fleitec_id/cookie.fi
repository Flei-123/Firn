// SPDX-License-Identifier: MPL-2.0
// lib/fleitec_id/cookie.fi -- the session cookie of the Fleitec-ID protocol
// (docs/FLEITEC-ID.md, section "Cookie").
//
//   Name   fleitec_session
//   Domain .fleitec.com (every sub domain is signed in at once)
//   Value  the JWT, percent-encoded like JavaScript's encodeURIComponent
//   Flags  Path=/; HttpOnly; Secure; SameSite=Lax
//
// cookie_find reads a Cookie header the way the TypeScript SDK does, and NOT
// the way JARVIS lib/auth.js does: a bad %-escape skips that one pair instead
// of throwing. Documented limit: the decoded octets are not checked for valid
// UTF-8 (JavaScript's decodeURIComponent rejects a lone %FF; this does not) --
// a session token is ASCII, so it makes no difference for the one cookie this
// module exists for.
import std.rt

export { cookie_find, session_cookie, clear_cookie, COOKIE_NAME,
    COOKIE_DOMAIN, COOKIE_MAX_AGE }

const COOKIE_NAME: str = "fleitec_session"
const COOKIE_DOMAIN: str = ".fleitec.com"
const COOKIE_MAX_AGE: i64 = 2592000 // 30 days

fn hex_value(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return ((c - 97 as u8) as i32) + 10
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return ((c - 65 as u8) as i32) + 10
    }
    return -1
}

fn is_ws(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8
}

// Length of the percent-decoded value, -1 for a broken %-escape.
fn pct_len(p: u64, n: usize) -> i64 {
    var i: usize = 0
    var w: i64 = 0
    while i < n {
        if rt.ld8(p, i) == 37 as u8 {
            if i + 2 >= n {
                return -1
            }
            if hex_value(rt.ld8(p, i + 1)) < 0 || hex_value(rt.ld8(p, i + 2)) < 0 {
                return -1
            }
            i = i + 3
        } else {
            i = i + 1
        }
        w = w + 1
    }
    return w
}

fn pct_write(p: u64, n: usize, out: u64) {
    var i: usize = 0
    var w: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c == 37 as u8 {
            let v: i32 = hex_value(rt.ld8(p, i + 1)) * 16 + hex_value(rt.ld8(p, i + 2))
            rt.st8(out, w, v as u8)
            i = i + 3
        } else {
            rt.st8(out, w, c)
            i = i + 1
        }
        w = w + 1
    }
}

// The decoded value of cookie `name` into `out` (at most `cap` octets);
// the LAST pair with that name wins, like the SDK. 0: absent, empty, broken
// or too long for `cap`.
fn cookie_find(h: u64, hn: usize, name: str, out: u64, cap: usize) -> usize {
    var found: usize = 0
    var start: usize = 0
    while start <= hn {
        var end: usize = start
        while end < hn && rt.ld8(h, end) != 59 as u8 {
            end = end + 1
        }
        // one pair is [start, end)
        var eq: usize = start
        while eq < end && rt.ld8(h, eq) != 61 as u8 {
            eq = eq + 1
        }
        if eq < end {
            var ks: usize = start
            var ke: usize = eq
            while ks < ke && is_ws(rt.ld8(h, ks)) {
                ks = ks + 1
            }
            while ke > ks && is_ws(rt.ld8(h, ke - 1)) {
                ke = ke - 1
            }
            var vs: usize = eq + 1
            var ve: usize = end
            while vs < ve && is_ws(rt.ld8(h, vs)) {
                vs = vs + 1
            }
            while ve > vs && is_ws(rt.ld8(h, ve - 1)) {
                ve = ve - 1
            }
            if ke - ks == name.n
            && rt.mem_eq(h + ks as u64, name.p as u64, name.n) {
                let dl: i64 = pct_len(h + vs as u64, ve - vs)
                if dl >= 0 && (dl as usize) <= cap {
                    pct_write(h + vs as u64, ve - vs, out)
                    found = dl as usize
                }
            }
        }
        start = end + 1
    }
    return found
}

fn put(out: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(out, s.p as u64, s.n)
}

fn put_i64(out: *mut rt.Buf, v: i64) {
    if v < 0 {
        rt.buf_push(out, 45 as u8)
        put_i64(out, 0 - v)
        return
    }
    if v >= 10 {
        put_i64(out, v / 10)
    }
    rt.buf_push(out, (48 + (v % 10)) as u8)
}

fn hexd(v: u8) -> u8 {
    if v < 10 as u8 {
        return 48 as u8 + v
    }
    return 65 as u8 + (v - 10 as u8)
}

// encodeURIComponent: letters, digits and - _ . ! ~ * ' ( ) stay.
fn component_safe(c: u8) -> bool {
    if (c >= 48 as u8 && c <= 57 as u8) || (c >= 65 as u8 && c <= 90 as u8)
    || (c >= 97 as u8 && c <= 122 as u8) {
        return true
    }
    return c == 45 as u8 || c == 95 as u8 || c == 46 as u8 || c == 33 as u8
    || c == 126 as u8 || c == 42 as u8 || c == 39 as u8 || c == 40 as u8
    || c == 41 as u8
}

// "fleitec_session=<token>; Path=/; Domain=<domain>; Max-Age=<n>; HttpOnly;
// Secure; SameSite=Lax" appended to `out`. An empty `domain` leaves the
// Domain attribute out (a host cookie).
fn session_cookie(tok: u64, tn: usize, domain: str, max_age: i64,
    out: *mut rt.Buf) {
    put(out, COOKIE_NAME)
    rt.buf_push(out, 61 as u8)
    var i: usize = 0
    while i < tn {
        let c: u8 = rt.ld8(tok, i)
        if component_safe(c) {
            rt.buf_push(out, c)
        } else {
            rt.buf_push(out, 37 as u8)
            rt.buf_push(out, hexd(c / 16 as u8))
            rt.buf_push(out, hexd(c % 16 as u8))
        }
        i = i + 1
    }
    put(out, "; Path=/")
    if domain.n > 0 {
        put(out, "; Domain=")
        put(out, domain)
    }
    put(out, "; Max-Age=")
    put_i64(out, max_age)
    put(out, "; HttpOnly; Secure; SameSite=Lax")
}

// The cookie that ends the session: empty value, Max-Age=0.
fn clear_cookie(domain: str, out: *mut rt.Buf) {
    put(out, COOKIE_NAME)
    put(out, "=; Path=/")
    if domain.n > 0 {
        put(out, "; Domain=")
        put(out, domain)
    }
    put(out, "; Max-Age=0; HttpOnly; Secure; SameSite=Lax")
}
