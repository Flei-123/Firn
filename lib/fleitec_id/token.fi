// SPDX-License-Identifier: MPL-2.0
// lib/fleitec_id/token.fi -- the token forms of the Fleitec-ID protocol
// (docs/FLEITEC-ID.md in the JARVIS tree, section "Tokens").
//
//   device token   "fkz1.<uid>.<64 lower hex>" (social layer) and
//                  "fkm1.<uid>.<64 lower hex>" (activity reporter); a server
//                  keeps sha256(<the 64 hex characters as text>) only.
//   API token      "ckt_<10 x [a-z0-9]>_<43 x [A-Za-z0-9_-]>" (Cockpit);
//                  a server keeps sha256(<the 43 characters>) only.
//   pair code      8 characters of PAIR_ALPHABET, shown as "ABCD-EFGH",
//                  typed in any case with any separators.
//
// Everything here is pure: octets in, a verdict out. Nothing is allocated;
// the verdicts are offsets into the token that was given, so a caller never
// copies a secret it does not need.
import std.rt
import std.crypto.sha256

export { DeviceToken, ApiToken, device_token_parse, api_token_parse,
    sha256_hex, pair_normalize, pair_format,
    DEVICE_UID_MAX, PAIR_LEN, API_TOKEN_LEN }

const DEVICE_UID_MAX: usize = 64
const PAIR_LEN: usize = 8
const API_TOKEN_LEN: usize = 58 // "ckt_" + 10 + "_" + 43

struct DeviceToken {
    ok: bool,
    uid_at: usize,
    uid_len: usize,
    // the 64 hex characters of the secret start here (they end the token)
    secret_at: usize,
}

struct ApiToken {
    ok: bool,
    id_at: usize, // 10 characters
    secret_at: usize, // 43 characters
}

fn device_token_none() -> DeviceToken {
    return DeviceToken { ok: false, uid_at: 0, uid_len: 0, secret_at: 0 }
}

fn api_token_none() -> ApiToken {
    return ApiToken { ok: false, id_at: 0, secret_at: 0 }
}

fn is_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn is_lower(c: u8) -> bool {
    return c >= 97 as u8 && c <= 122 as u8
}

fn is_upper(c: u8) -> bool {
    return c >= 65 as u8 && c <= 90 as u8
}

fn is_uid_char(c: u8) -> bool {
    return is_digit(c) || is_upper(c) || is_lower(c) || c == 95 as u8
        || c == 45 as u8
}

fn is_lower_hex(c: u8) -> bool {
    return is_digit(c) || (c >= 97 as u8 && c <= 102 as u8)
}

// `prefix` is the four characters before the first dot ("fkz1" / "fkm1").
// The token must be EXACTLY prefix . uid . 64 hex -- nothing before or after.
fn device_token_parse(p: u64, n: usize, prefix: str) -> DeviceToken {
    if prefix.n != 4 || n < 71 {
        return device_token_none()
    }
    var i: usize = 0
    while i < 4 {
        if rt.ld8(p, i) != rt.ld8(prefix.p as u64, i) {
            return device_token_none()
        }
        i = i + 1
    }
    if rt.ld8(p, 4) != 46 as u8 {
        return device_token_none()
    }
    let uid_len: usize = n - 70
    if uid_len < 1 || uid_len > DEVICE_UID_MAX {
        return device_token_none()
    }
    var k: usize = 0
    while k < uid_len {
        if !is_uid_char(rt.ld8(p, 5 + k)) {
            return device_token_none()
        }
        k = k + 1
    }
    if rt.ld8(p, 5 + uid_len) != 46 as u8 {
        return device_token_none()
    }
    var h: usize = 0
    while h < 64 {
        if !is_lower_hex(rt.ld8(p, 6 + uid_len + h)) {
            return device_token_none()
        }
        h = h + 1
    }
    return DeviceToken { ok: true, uid_at: 5, uid_len: uid_len,
        secret_at: 6 + uid_len }
}

fn is_space(c: u8) -> bool {
    return c == 32 as u8 || c == 9 as u8 || c == 10 as u8 || c == 13 as u8
}

// Surrounding white space is ignored (a token pasted with its newline),
// the offsets in the answer are relative to `p`, not to the trimmed start.
fn api_token_parse(p: u64, n: usize) -> ApiToken {
    var s: usize = 0
    var e: usize = n
    while s < e && is_space(rt.ld8(p, s)) {
        s = s + 1
    }
    while e > s && is_space(rt.ld8(p, e - 1)) {
        e = e - 1
    }
    if e - s != API_TOKEN_LEN {
        return api_token_none()
    }
    if rt.ld8(p, s) != 99 as u8 || rt.ld8(p, s + 1) != 107 as u8
        || rt.ld8(p, s + 2) != 116 as u8 || rt.ld8(p, s + 3) != 95 as u8 {
        return api_token_none()
    }
    var i: usize = 0
    while i < 10 {
        let c: u8 = rt.ld8(p, s + 4 + i)
        if !(is_lower(c) || is_digit(c)) {
            return api_token_none()
        }
        i = i + 1
    }
    if rt.ld8(p, s + 14) != 95 as u8 {
        return api_token_none()
    }
    var j: usize = 0
    while j < 43 {
        if !is_uid_char(rt.ld8(p, s + 15 + j)) {
            return api_token_none()
        }
        j = j + 1
    }
    return ApiToken { ok: true, id_at: s + 4, secret_at: s + 15 }
}

fn hex_digit(v: u8) -> u8 {
    if v < 10 as u8 {
        return 48 as u8 + v
    }
    return 97 as u8 + (v - 10 as u8)
}

// sha256 of n octets as 64 lower-case hex characters into `out` (64 octets).
fn sha256_hex(p: u64, n: usize, out: u64) {
    var dg: [u8; 32] = [0; 32]
    sha256.sha256(p, n, (&dg[0]) as u64)
    var i: usize = 0
    while i < 32 {
        rt.st8(out, i * 2, hex_digit(dg[i] / 16 as u8))
        rt.st8(out, i * 2 + 1, hex_digit(dg[i] % 16 as u8))
        i = i + 1
    }
}

// Upper-cases letters and drops everything that is not A-Z / 0-9.
// Returns the number of octets written (at most `cap`).
fn pair_normalize(p: u64, n: usize, out: u64, cap: usize) -> usize {
    var w: usize = 0
    var i: usize = 0
    while i < n {
        var c: u8 = rt.ld8(p, i)
        if is_lower(c) {
            c = c - 32 as u8
        }
        if is_upper(c) || is_digit(c) {
            if w >= cap {
                return w
            }
            rt.st8(out, w, c)
            w = w + 1
        }
        i = i + 1
    }
    return w
}

// "ABCDEFGH" -> "ABCD-EFGH": four characters, a dash, the rest. `out` needs
// n + 1 octets; returns that length.
fn pair_format(p: u64, n: usize, out: u64) -> usize {
    var w: usize = 0
    var i: usize = 0
    while i < n {
        if i == 4 {
            rt.st8(out, w, 45 as u8)
            w = w + 1
        }
        rt.st8(out, w, rt.ld8(p, i))
        w = w + 1
        i = i + 1
    }
    if n <= 4 {
        rt.st8(out, w, 45 as u8)
        w = w + 1
    }
    return w
}
