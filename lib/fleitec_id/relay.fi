// SPDX-License-Identifier: MPL-2.0
// lib/fleitec_id/relay.fi -- where the account endpoints of a FreeViewer relay
// live (docs/FLEITEC-ID.md, section "Relay binding").
//
//   relay URL   wss://host/fv/ws   (the WebSocket the apps connect to)
//   base        https://host/fv    (ws -> http, wss -> https, "/ws" dropped)
//   account     <base>/account/<what>   login, me, data
//   plain       <base>/<what>           setup/create, setup/inbox, ...
//   token       goes into the query as ?token=<url_encode_token(...)>
import std.rt

export { relay_base, account_url, plain_url, url_encode_token }

fn put_bytes(out: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(out, p, n)
}

fn starts(p: u64, n: usize, lit: str) -> bool {
    if n < lit.n {
        return false
    }
    return rt.mem_eq(p, lit.p as u64, lit.n)
}

// Appends the base URL of `relay` to `out`.
fn relay_base(p: u64, n: usize, out: *mut rt.Buf) {
    var rest: u64 = p
    var rn: usize = n
    if starts(p, n, "wss://") {
        put_bytes(out, "https://".p as u64, 8)
        rest = p + 6 as u64
        rn = n - 6
    } else if starts(p, n, "ws://") {
        put_bytes(out, "http://".p as u64, 7)
        rest = p + 5 as u64
        rn = n - 5
    }
    // a trailing "/ws" is the socket path, not part of the base
    if rn >= 3 && rt.ld8(rest, rn - 3) == 47 as u8
        && rt.ld8(rest, rn - 2) == 119 as u8
        && rt.ld8(rest, rn - 1) == 115 as u8 {
        put_bytes(out, rest, rn - 3)
        return
    }
    // otherwise only trailing slashes go
    while rn > 0 && rt.ld8(rest, rn - 1) == 47 as u8 {
        rn = rn - 1
    }
    put_bytes(out, rest, rn)
}

fn account_url(p: u64, n: usize, what: u64, wn: usize, out: *mut rt.Buf) {
    relay_base(p, n, out)
    put_bytes(out, "/account/".p as u64, 9)
    put_bytes(out, what, wn)
}

fn plain_url(p: u64, n: usize, what: u64, wn: usize, out: *mut rt.Buf) {
    relay_base(p, n, out)
    rt.buf_push(out, 47 as u8)
    put_bytes(out, what, wn)
}

fn hexd(v: u8) -> u8 {
    if v < 10 as u8 {
        return 48 as u8 + v
    }
    return 65 as u8 + (v - 10 as u8)
}

// Unreserved characters (A-Z a-z 0-9 - _ . ~) stay, every other octet
// becomes %XX in upper-case hex.
fn url_encode_token(p: u64, n: usize, out: *mut rt.Buf) {
    var i: usize = 0
    while i < n {
        let c: u8 = rt.ld8(p, i)
        let keep: bool = (c >= 48 as u8 && c <= 57 as u8)
            || (c >= 65 as u8 && c <= 90 as u8)
            || (c >= 97 as u8 && c <= 122 as u8)
            || c == 45 as u8 || c == 95 as u8 || c == 46 as u8 || c == 126 as u8
        if keep {
            rt.buf_push(out, c)
        } else {
            rt.buf_push(out, 37 as u8)
            rt.buf_push(out, hexd(c / 16 as u8))
            rt.buf_push(out, hexd(c % 16 as u8))
        }
        i = i + 1
    }
}
