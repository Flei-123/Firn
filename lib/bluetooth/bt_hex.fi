import std.rt
import std.str

export { hex_put, hex_put_buf, hex_parse, hex_digit }

fn hex_digit(c: u8) -> i32 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return (c - 48 as u8) as i32
    }
    if c >= 97 as u8 && c <= 102 as u8 {
        return (c - 97 as u8) as i32 + 10
    }
    if c >= 65 as u8 && c <= 70 as u8 {
        return (c - 65 as u8) as i32 + 10
    }
    return 0 - 1
}

fn hex_put(b: *mut rt.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push_hex_u64(b, rt.ld8(p, i) as u64, 2)
        i = i + 1
    }
}

fn hex_put_buf(out: *mut rt.Buf, src: *mut rt.Buf) {
    hex_put(out, rt.buf_ptr(src), rt.buf_len(src))
}

fn hex_parse(s: str, out: *mut rt.Buf) -> bool {
    let n: usize = s.length()
    if n % 2 != 0 {
        return false
    }
    var i: usize = 0
    while i < n {
        let hi: i32 = hex_digit(rt.ld8(s.p as u64, i))
        let lo: i32 = hex_digit(rt.ld8(s.p as u64, i + 1))
        if hi < 0 || lo < 0 {
            return false
        }
        rt.buf_push(out, (hi * 16 + lo) as u8)
        i = i + 2
    }
    return true
}
