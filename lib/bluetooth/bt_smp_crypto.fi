// lib/bluetooth/bt_smp_crypto.fi -- bt_smp_crypto: SMP security functions ah, c1, s1, f4, f5, f6, g2, h6, h7 (little endian over the air)
import std.rt
import bluetooth.bt_aes
import bluetooth.bt_cmac

export { ah, c1, s1, f4, f5, f6, g2, h6, h7 }

fn ah(k: u64, r: u64, out: u64) {
    var data: [u8; 16] = [0; 16]
    var enc: [u8; 16] = [0; 16]
    rt.mem_copy((&data[0]) as u64, r, 3)
    bt_aes.sec_e(k, (&data[0]) as u64, (&enc[0]) as u64)
    rt.mem_copy(out, (&enc[0]) as u64, 3)
}

fn c1(k: u64, r: u64, preq: u64, pres: u64, iat: u32, rat: u32, ia: u64, ra: u64, out: u64) {
    var p1: [u8; 16] = [0; 16]
    var p2: [u8; 16] = [0; 16]
    var t: [u8; 16] = [0; 16]
    var e1: [u8; 16] = [0; 16]
    let p1p: u64 = (&p1[0]) as u64
    let p2p: u64 = (&p2[0]) as u64
    let tp: u64 = (&t[0]) as u64
    let e1p: u64 = (&e1[0]) as u64
    rt.st8(p1p, 0, iat as u8)
    rt.st8(p1p, 1, rat as u8)
    rt.mem_copy(p1p + 2, preq, 7)
    rt.mem_copy(p1p + 9, pres, 7)
    rt.mem_copy(p2p, ra, 6)
    rt.mem_copy(p2p + 6, ia, 6)
    bt_aes.xor_into(tp, r, p1p, 16)
    bt_aes.sec_e(k, tp, e1p)
    bt_aes.xor_into(tp, e1p, p2p, 16)
    bt_aes.sec_e(k, tp, out)
}

fn s1(k: u64, r1: u64, r2: u64, out: u64) {
    var d: [u8; 16] = [0; 16]
    let dp: u64 = (&d[0]) as u64
    rt.mem_copy(dp, r2, 8)
    rt.mem_copy(dp + 8, r1, 8)
    bt_aes.sec_e(k, dp, out)
}

fn cmac_rev_out(key_be: u64, b: *mut rt.Buf, out: u64, reverse_out: bool) {
    var mac: [u8; 16] = [0; 16]
    bt_cmac.aes_cmac(key_be, rt.buf_ptr(b), rt.buf_len(b), (&mac[0]) as u64)
    if reverse_out {
        bt_aes.reverse_into(out, (&mac[0]) as u64, 16)
    } else {
        rt.mem_copy(out, (&mac[0]) as u64, 16)
    }
}

fn f4(u: u64, v: u64, x: u64, z: u32, out: u64) {
    var m: rt.Buf = rt.buf_new()
    var key: [u8; 16] = [0; 16]
    bt_aes.put_reversed(&m, u, 32)
    bt_aes.put_reversed(&m, v, 32)
    rt.buf_push(&m, z as u8)
    bt_aes.reverse_into((&key[0]) as u64, x, 16)
    cmac_rev_out((&key[0]) as u64, &m, out, true)
    rt.buf_free(&m)
}

fn f5_part(t: u64, counter: u32, n1: u64, n2: u64, a1: u64, a2: u64, out: u64) {
    var m: rt.Buf = rt.buf_new()
    rt.buf_push(&m, counter as u8)
    rt.buf_push(&m, 0x62 as u8)
    rt.buf_push(&m, 0x74 as u8)
    rt.buf_push(&m, 0x6C as u8)
    rt.buf_push(&m, 0x65 as u8)
    bt_aes.put_reversed(&m, n1, 16)
    bt_aes.put_reversed(&m, n2, 16)
    bt_aes.put_reversed(&m, a1, 7)
    bt_aes.put_reversed(&m, a2, 7)
    rt.buf_push(&m, 1 as u8)
    rt.buf_push(&m, 0 as u8)
    cmac_rev_out(t, &m, out, true)
    rt.buf_free(&m)
}

fn f5(w: u64, n1: u64, n2: u64, a1: u64, a2: u64, mac_key: u64, ltk: u64) {
    var salt: [u8; 16] = [0x6C, 0x88, 0x83, 0x91, 0xAA, 0xF5, 0xA5, 0x38, 0x60, 0x37, 0x0B, 0xDB, 0x5A, 0x60, 0x83, 0xBE]
    var wr: [u8; 32] = [0; 32]
    var t: [u8; 16] = [0; 16]
    bt_aes.reverse_into((&wr[0]) as u64, w, 32)
    bt_cmac.aes_cmac((&salt[0]) as u64, (&wr[0]) as u64, 32, (&t[0]) as u64)
    f5_part((&t[0]) as u64, 0, n1, n2, a1, a2, mac_key)
    f5_part((&t[0]) as u64, 1, n1, n2, a1, a2, ltk)
}

fn f6(w: u64, n1: u64, n2: u64, r: u64, io_cap: u64, a1: u64, a2: u64, out: u64) {
    var m: rt.Buf = rt.buf_new()
    var key: [u8; 16] = [0; 16]
    bt_aes.put_reversed(&m, n1, 16)
    bt_aes.put_reversed(&m, n2, 16)
    bt_aes.put_reversed(&m, r, 16)
    bt_aes.put_reversed(&m, io_cap, 3)
    bt_aes.put_reversed(&m, a1, 7)
    bt_aes.put_reversed(&m, a2, 7)
    bt_aes.reverse_into((&key[0]) as u64, w, 16)
    cmac_rev_out((&key[0]) as u64, &m, out, true)
    rt.buf_free(&m)
}

fn g2(u: u64, v: u64, x: u64, y: u64) -> u32 {
    var m: rt.Buf = rt.buf_new()
    var key: [u8; 16] = [0; 16]
    var mac: [u8; 16] = [0; 16]
    bt_aes.put_reversed(&m, u, 32)
    bt_aes.put_reversed(&m, v, 32)
    bt_aes.put_reversed(&m, y, 16)
    bt_aes.reverse_into((&key[0]) as u64, x, 16)
    cmac_rev_out((&key[0]) as u64, &m, (&mac[0]) as u64, false)
    rt.buf_free(&m)
    let p: u64 = (&mac[0]) as u64
    return ((rt.ld8(p, 12) as u32) << 24) | ((rt.ld8(p, 13) as u32) << 16) | ((rt.ld8(p, 14) as u32) << 8) | (rt.ld8(p, 15) as u32)
}

fn h6(w: u64, key_id: u64, out: u64) {
    var key: [u8; 16] = [0; 16]
    var mac: [u8; 16] = [0; 16]
    bt_aes.reverse_into((&key[0]) as u64, w, 16)
    bt_cmac.aes_cmac((&key[0]) as u64, key_id, 4, (&mac[0]) as u64)
    bt_aes.reverse_into(out, (&mac[0]) as u64, 16)
}

fn h7(salt: u64, w: u64, out: u64) {
    var wr: [u8; 16] = [0; 16]
    var mac: [u8; 16] = [0; 16]
    bt_aes.reverse_into((&wr[0]) as u64, w, 16)
    bt_cmac.aes_cmac(salt, (&wr[0]) as u64, 16, (&mac[0]) as u64)
    bt_aes.reverse_into(out, (&mac[0]) as u64, 16)
}
