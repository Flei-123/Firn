// lib/bluetooth/bt_smp_ecdh.fi -- bt_smp_ecdh: P-256 key pairs and DHKey for LE Secure Connections (little endian coordinates)
import std.rt
import std.crypto.p256
import std.crypto.ecdsa
import bluetooth.bt_aes

export { ecdh_keypair, ecdh_dhkey, ecdh_public_valid }

fn ecdh_keypair(rand_fn: fn(u64, usize) -> bool, priv_be: u64, pub_x_le: u64, pub_y_le: u64) -> bool {
    var tries: u32 = 0
    while tries < 16 {
        if !rand_fn(priv_be, 32) {
            return false
        }
        if p256.p256_scalar_valid(priv_be) {
            var pubkey: [u8; 65] = [0; 65]
            let pp: u64 = (&pubkey[0]) as u64
            if !p256.p256_public(priv_be, pp) {
                return false
            }
            bt_aes.reverse_into(pub_x_le, pp + 1, 32)
            bt_aes.reverse_into(pub_y_le, pp + 33, 32)
            return true
        }
        tries = tries + 1
    }
    return false
}

fn ecdh_public_valid(x_le: u64, y_le: u64) -> bool {
    var x: [u8; 32] = [0; 32]
    var y: [u8; 32] = [0; 32]
    bt_aes.reverse_into((&x[0]) as u64, x_le, 32)
    bt_aes.reverse_into((&y[0]) as u64, y_le, 32)
    var c: ecdsa.Curve = ecdsa.curve_new_p256()
    return ecdsa.point_valid(&c, (&x[0]) as u64, (&y[0]) as u64)
}

fn ecdh_dhkey(priv_be: u64, peer_x_le: u64, peer_y_le: u64, out_le: u64) -> bool {
    if !ecdh_public_valid(peer_x_le, peer_y_le) {
        return false
    }
    var x: [u8; 32] = [0; 32]
    var y: [u8; 32] = [0; 32]
    var ox: [u8; 32] = [0; 32]
    var oy: [u8; 32] = [0; 32]
    bt_aes.reverse_into((&x[0]) as u64, peer_x_le, 32)
    bt_aes.reverse_into((&y[0]) as u64, peer_y_le, 32)
    if !p256.p256_mult(priv_be, (&x[0]) as u64, (&y[0]) as u64, (&ox[0]) as u64, (&oy[0]) as u64) {
        return false
    }
    bt_aes.reverse_into(out_le, (&ox[0]) as u64, 32)
    return true
}
