// lib/bluetooth/bt_smp.fi -- bt_smp: Security Manager Protocol PDU builders and parsers (LE, CID 0x0006)
import std.rt
import bluetooth.bt_le

export {
    SMP_PAIRING_REQUEST, SMP_PAIRING_RESPONSE, SMP_PAIRING_CONFIRM, SMP_PAIRING_RANDOM,
    SMP_PAIRING_FAILED, SMP_ENCRYPTION_INFO, SMP_CENTRAL_IDENT, SMP_IDENTITY_INFO,
    SMP_IDENTITY_ADDR, SMP_SIGNING_INFO, SMP_SECURITY_REQUEST, SMP_PUBLIC_KEY,
    SMP_DHKEY_CHECK, SMP_KEYPRESS,
    IO_DISPLAY_ONLY, IO_DISPLAY_YES_NO, IO_KEYBOARD_ONLY, IO_NO_INPUT_NO_OUTPUT,
    IO_KEYBOARD_DISPLAY,
    AUTH_BONDING, AUTH_MITM, AUTH_SC, AUTH_KEYPRESS, AUTH_CT2,
    DIST_ENC_KEY, DIST_ID_KEY, DIST_SIGN_KEY, DIST_LINK_KEY,
    FAIL_PASSKEY_ENTRY, FAIL_OOB_NOT_AVAILABLE, FAIL_AUTH_REQUIREMENTS,
    FAIL_CONFIRM_VALUE, FAIL_PAIRING_NOT_SUPPORTED, FAIL_ENCRYPTION_KEY_SIZE,
    FAIL_COMMAND_NOT_SUPPORTED, FAIL_UNSPECIFIED, FAIL_REPEATED_ATTEMPTS,
    FAIL_INVALID_PARAMETERS, FAIL_DHKEY_CHECK, FAIL_NUMERIC_COMPARISON,
    FAIL_BR_EDR_IN_PROGRESS, FAIL_CROSS_TRANSPORT,
    SMP_CID, SMP_MTU,
    Features, features_new,
    smp_pairing_request, smp_pairing_response, smp_parse_features,
    smp_pairing_confirm, smp_pairing_random, smp_pairing_failed,
    smp_encryption_info, smp_central_ident, smp_identity_info, smp_identity_addr,
    smp_signing_info, smp_security_request, smp_public_key, smp_dhkey_check,
    smp_keypress, smp_expected_len, smp_pdu_valid,
}

const SMP_CID: u32 = 6
const SMP_MTU: u32 = 65

const SMP_PAIRING_REQUEST: u32 = 0x01
const SMP_PAIRING_RESPONSE: u32 = 0x02
const SMP_PAIRING_CONFIRM: u32 = 0x03
const SMP_PAIRING_RANDOM: u32 = 0x04
const SMP_PAIRING_FAILED: u32 = 0x05
const SMP_ENCRYPTION_INFO: u32 = 0x06
const SMP_CENTRAL_IDENT: u32 = 0x07
const SMP_IDENTITY_INFO: u32 = 0x08
const SMP_IDENTITY_ADDR: u32 = 0x09
const SMP_SIGNING_INFO: u32 = 0x0A
const SMP_SECURITY_REQUEST: u32 = 0x0B
const SMP_PUBLIC_KEY: u32 = 0x0C
const SMP_DHKEY_CHECK: u32 = 0x0D
const SMP_KEYPRESS: u32 = 0x0E

const IO_DISPLAY_ONLY: u32 = 0
const IO_DISPLAY_YES_NO: u32 = 1
const IO_KEYBOARD_ONLY: u32 = 2
const IO_NO_INPUT_NO_OUTPUT: u32 = 3
const IO_KEYBOARD_DISPLAY: u32 = 4

const AUTH_BONDING: u32 = 0x01
const AUTH_MITM: u32 = 0x04
const AUTH_SC: u32 = 0x08
const AUTH_KEYPRESS: u32 = 0x10
const AUTH_CT2: u32 = 0x20

const DIST_ENC_KEY: u32 = 0x01
const DIST_ID_KEY: u32 = 0x02
const DIST_SIGN_KEY: u32 = 0x04
const DIST_LINK_KEY: u32 = 0x08

const FAIL_PASSKEY_ENTRY: u32 = 0x01
const FAIL_OOB_NOT_AVAILABLE: u32 = 0x02
const FAIL_AUTH_REQUIREMENTS: u32 = 0x03
const FAIL_CONFIRM_VALUE: u32 = 0x04
const FAIL_PAIRING_NOT_SUPPORTED: u32 = 0x05
const FAIL_ENCRYPTION_KEY_SIZE: u32 = 0x06
const FAIL_COMMAND_NOT_SUPPORTED: u32 = 0x07
const FAIL_UNSPECIFIED: u32 = 0x08
const FAIL_REPEATED_ATTEMPTS: u32 = 0x09
const FAIL_INVALID_PARAMETERS: u32 = 0x0A
const FAIL_DHKEY_CHECK: u32 = 0x0B
const FAIL_NUMERIC_COMPARISON: u32 = 0x0C
const FAIL_BR_EDR_IN_PROGRESS: u32 = 0x0D
const FAIL_CROSS_TRANSPORT: u32 = 0x0E

struct Features {
    io_cap: u32,
    oob: u32,
    auth_req: u32,
    max_key_size: u32,
    init_dist: u32,
    resp_dist: u32,
}

fn features_new(io_cap: u32, auth_req: u32, init_dist: u32, resp_dist: u32) -> Features {
    return Features { io_cap: io_cap, oob: 0, auth_req: auth_req, max_key_size: 16,
        init_dist: init_dist, resp_dist: resp_dist }
}

fn put_features(b: *mut rt.Buf, code: u32, f: Features) {
    bt_le.le_put8(b, code)
    bt_le.le_put8(b, f.io_cap)
    bt_le.le_put8(b, f.oob)
    bt_le.le_put8(b, f.auth_req)
    bt_le.le_put8(b, f.max_key_size)
    bt_le.le_put8(b, f.init_dist)
    bt_le.le_put8(b, f.resp_dist)
}

fn smp_pairing_request(b: *mut rt.Buf, f: Features) {
    put_features(b, SMP_PAIRING_REQUEST, f)
}

fn smp_pairing_response(b: *mut rt.Buf, f: Features) {
    put_features(b, SMP_PAIRING_RESPONSE, f)
}

fn smp_parse_features(p: u64, n: usize, out: *mut Features) -> bool {
    if n != 7 {
        return false
    }
    let code: u32 = rt.ld8(p, 0) as u32
    if code != SMP_PAIRING_REQUEST && code != SMP_PAIRING_RESPONSE {
        return false
    }
    (*out).io_cap = rt.ld8(p, 1) as u32
    (*out).oob = rt.ld8(p, 2) as u32
    (*out).auth_req = rt.ld8(p, 3) as u32
    (*out).max_key_size = rt.ld8(p, 4) as u32
    (*out).init_dist = rt.ld8(p, 5) as u32
    (*out).resp_dist = rt.ld8(p, 6) as u32
    return true
}

fn put16(b: *mut rt.Buf, code: u32, p: u64) {
    bt_le.le_put8(b, code)
    bt_le.le_put_raw(b, p, 16)
}

fn smp_pairing_confirm(b: *mut rt.Buf, value: u64) { put16(b, SMP_PAIRING_CONFIRM, value) }
fn smp_pairing_random(b: *mut rt.Buf, value: u64) { put16(b, SMP_PAIRING_RANDOM, value) }
fn smp_encryption_info(b: *mut rt.Buf, ltk: u64) { put16(b, SMP_ENCRYPTION_INFO, ltk) }
fn smp_identity_info(b: *mut rt.Buf, irk: u64) { put16(b, SMP_IDENTITY_INFO, irk) }
fn smp_signing_info(b: *mut rt.Buf, csrk: u64) { put16(b, SMP_SIGNING_INFO, csrk) }
fn smp_dhkey_check(b: *mut rt.Buf, value: u64) { put16(b, SMP_DHKEY_CHECK, value) }

fn smp_pairing_failed(b: *mut rt.Buf, reason: u32) {
    bt_le.le_put8(b, SMP_PAIRING_FAILED)
    bt_le.le_put8(b, reason)
}

fn smp_central_ident(b: *mut rt.Buf, ediv: u32, rand: u64) {
    bt_le.le_put8(b, SMP_CENTRAL_IDENT)
    bt_le.le_put16(b, ediv)
    bt_le.le_put_raw(b, rand, 8)
}

fn smp_identity_addr(b: *mut rt.Buf, addr_type: u32, addr: u64) {
    bt_le.le_put8(b, SMP_IDENTITY_ADDR)
    bt_le.le_put8(b, addr_type)
    bt_le.le_put_raw(b, addr, 6)
}

fn smp_security_request(b: *mut rt.Buf, auth_req: u32) {
    bt_le.le_put8(b, SMP_SECURITY_REQUEST)
    bt_le.le_put8(b, auth_req)
}

fn smp_public_key(b: *mut rt.Buf, x: u64, y: u64) {
    bt_le.le_put8(b, SMP_PUBLIC_KEY)
    bt_le.le_put_raw(b, x, 32)
    bt_le.le_put_raw(b, y, 32)
}

fn smp_keypress(b: *mut rt.Buf, kind: u32) {
    bt_le.le_put8(b, SMP_KEYPRESS)
    bt_le.le_put8(b, kind)
}

fn smp_expected_len(code: u32) -> usize {
    if code == SMP_PAIRING_REQUEST || code == SMP_PAIRING_RESPONSE { return 7 }
    if code == SMP_PAIRING_CONFIRM || code == SMP_PAIRING_RANDOM { return 17 }
    if code == SMP_PAIRING_FAILED { return 2 }
    if code == SMP_ENCRYPTION_INFO || code == SMP_IDENTITY_INFO || code == SMP_SIGNING_INFO { return 17 }
    if code == SMP_CENTRAL_IDENT { return 11 }
    if code == SMP_IDENTITY_ADDR { return 8 }
    if code == SMP_SECURITY_REQUEST || code == SMP_KEYPRESS { return 2 }
    if code == SMP_PUBLIC_KEY { return 65 }
    if code == SMP_DHKEY_CHECK { return 17 }
    return 0
}

fn smp_pdu_valid(p: u64, n: usize) -> bool {
    if n == 0 {
        return false
    }
    let want: usize = smp_expected_len(rt.ld8(p, 0) as u32)
    return want != 0 && want == n
}
