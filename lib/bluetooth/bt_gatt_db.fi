// SPDX-License-Identifier: MPL-2.0
import std.rt
import bluetooth.bt_le
import bluetooth.bt_uuid

export {
    P_READ, P_WRITE, P_READ_ENC, P_WRITE_ENC, P_READ_AUTHEN, P_WRITE_AUTHEN,
    PROP_BROADCAST, PROP_READ, PROP_WRITE_NO_RSP, PROP_WRITE, PROP_NOTIFY,
    PROP_INDICATE, PROP_SIGNED_WRITE, PROP_EXTENDED,
    GattDb, db_new, db_free, db_count, db_add_service, db_add_characteristic,
    db_add_descriptor, db_add_cccd, db_find, db_handle_at, db_perms,
    db_uuid, db_value_ptr, db_value_len, db_value_cap, db_set_value,
    db_write_value, db_group_end, db_is_group_start, db_last_handle,
    db_pop_write, db_log_write, db_truncate, db_cccd_of, db_is_service_decl,
}

const P_READ: u32 = 1
const P_WRITE: u32 = 2
const P_READ_ENC: u32 = 4
const P_WRITE_ENC: u32 = 8
const P_READ_AUTHEN: u32 = 16
const P_WRITE_AUTHEN: u32 = 32

const PROP_BROADCAST: u32 = 1
const PROP_READ: u32 = 2
const PROP_WRITE_NO_RSP: u32 = 4
const PROP_WRITE: u32 = 8
const PROP_NOTIFY: u32 = 16
const PROP_INDICATE: u32 = 32
const PROP_SIGNED_WRITE: u32 = 64
const PROP_EXTENDED: u32 = 128

const REC: usize = 48

struct GattDb {
    recs: rt.Buf,
    count: usize,
    writes: rt.Buf,
    wpos: usize,
}

fn db_new() -> GattDb {
    return GattDb { recs: rt.buf_new(), count: 0, writes: rt.buf_new(), wpos: 0 }
}

fn db_free(db: *mut GattDb) {
    var i: usize = 0
    while i < (*db).count {
        let r: u64 = rt.buf_ptr(&(*db).recs) + (i * REC) as u64
        let vp: u64 = rt.ld64(r, 3)
        if vp != 0 {
            rt.heap_free(vp, rt.ld64(r, 5) as usize)
        }
        i = i + 1
    }
    rt.buf_free(&(*db).recs)
    rt.buf_free(&(*db).writes)
    (*db).count = 0
}

fn db_count(db: *mut GattDb) -> usize {
    return (*db).count
}

fn rec(db: *mut GattDb, i: usize) -> u64 {
    return rt.buf_ptr(&(*db).recs) + (i * REC) as u64
}

fn db_last_handle(db: *mut GattDb) -> u32 {
    return (*db).count as u32
}

fn add_attr(db: *mut GattDb, t: bt_uuid.Uuid, perms: u32, value: u64, n: usize, cap: usize) -> u32 {
    var c: usize = cap
    if c < n {
        c = n
    }
    var vp: u64 = 0
    if c > 0 {
        vp = rt.heap_alloc(c)
        var k: usize = 0
        while k < n {
            rt.st8(vp, k, rt.ld8(value, k))
            k = k + 1
        }
    }
    let handle: u32 = ((*db).count + 1) as u32
    var z: usize = 0
    while z < REC {
        rt.buf_push(&(*db).recs, 0 as u8)
        z = z + 1
    }
    let r: u64 = rec(db, (*db).count)
    rt.st64(r, 0, handle as u64 | ((perms as u64) << 32))
    rt.st64(r, 1, t.lo)
    rt.st64(r, 2, t.hi)
    rt.st64(r, 3, vp)
    rt.st64(r, 4, n as u64)
    rt.st64(r, 5, c as u64)
    (*db).count = (*db).count + 1
    return handle
}

fn db_handle_at(db: *mut GattDb, i: usize) -> u32 {
    return (rt.ld64(rec(db, i), 0) & 4294967295) as u32
}

fn db_find(db: *mut GattDb, handle: u32) -> usize {
    if handle == 0 || handle as usize > (*db).count {
        return bt_le.NONE
    }
    return handle as usize - 1
}

fn db_perms(db: *mut GattDb, i: usize) -> u32 {
    return (rt.ld64(rec(db, i), 0) >> 32) as u32
}

fn db_uuid(db: *mut GattDb, i: usize) -> bt_uuid.Uuid {
    let r: u64 = rec(db, i)
    return bt_uuid.Uuid { lo: rt.ld64(r, 1), hi: rt.ld64(r, 2) }
}

fn db_value_ptr(db: *mut GattDb, i: usize) -> u64 {
    return rt.ld64(rec(db, i), 3)
}

fn db_value_len(db: *mut GattDb, i: usize) -> usize {
    return rt.ld64(rec(db, i), 4) as usize
}

fn db_value_cap(db: *mut GattDb, i: usize) -> usize {
    return rt.ld64(rec(db, i), 5) as usize
}

fn db_set_value(db: *mut GattDb, handle: u32, value: u64, n: usize) -> bool {
    let i: usize = db_find(db, handle)
    if i == bt_le.NONE || n > db_value_cap(db, i) {
        return false
    }
    let vp: u64 = db_value_ptr(db, i)
    var k: usize = 0
    while k < n {
        rt.st8(vp, k, rt.ld8(value, k))
        k = k + 1
    }
    rt.st64(rec(db, i), 4, n as u64)
    return true
}

fn db_write_value(db: *mut GattDb, i: usize, offset: usize, value: u64, n: usize) -> bool {
    if offset + n > db_value_cap(db, i) {
        return false
    }
    let vp: u64 = db_value_ptr(db, i)
    var k: usize = 0
    while k < n {
        rt.st8(vp, offset + k, rt.ld8(value, k))
        k = k + 1
    }
    if offset + n > db_value_len(db, i) {
        rt.st64(rec(db, i), 4, (offset + n) as u64)
    }
    return true
}

fn db_is_service_decl(db: *mut GattDb, i: usize) -> bool {
    let t: bt_uuid.Uuid = db_uuid(db, i)
    return bt_uuid.uuid_eq(t, bt_uuid.uuid16(bt_uuid.UUID_PRIMARY_SERVICE)) || bt_uuid.uuid_eq(t, bt_uuid.uuid16(bt_uuid.UUID_SECONDARY_SERVICE))
}

fn db_is_group_start(db: *mut GattDb, i: usize) -> bool {
    return db_is_service_decl(db, i)
}

fn db_group_end(db: *mut GattDb, i: usize) -> u32 {
    var k: usize = i + 1
    while k < (*db).count {
        if db_is_service_decl(db, k) {
            return k as u32
        }
        k = k + 1
    }
    return (*db).count as u32
}

fn db_add_service(db: *mut GattDb, u: bt_uuid.Uuid, primary: bool) -> u32 {
    var v: rt.Buf = rt.buf_new()
    bt_uuid.uuid_put(&v, u)
    let kind: u32 = if primary { bt_uuid.UUID_PRIMARY_SERVICE } else { bt_uuid.UUID_SECONDARY_SERVICE }
    let h: u32 = add_attr(db, bt_uuid.uuid16(kind), P_READ, rt.buf_ptr(&v), rt.buf_len(&v), 0)
    rt.buf_free(&v)
    return h
}

fn db_add_characteristic(db: *mut GattDb, u: bt_uuid.Uuid, props: u32, perms: u32,
    value: u64, n: usize, cap: usize) -> u32 {
    var v: rt.Buf = rt.buf_new()
    bt_le.le_put8(&v, props)
    bt_le.le_put16(&v, ((*db).count + 2) as u32)
    bt_uuid.uuid_put(&v, u)
    add_attr(db, bt_uuid.uuid16(bt_uuid.UUID_CHARACTERISTIC), P_READ, rt.buf_ptr(&v), rt.buf_len(&v), 0)
    rt.buf_free(&v)
    return add_attr(db, u, perms, value, n, cap)
}

fn db_add_descriptor(db: *mut GattDb, u: bt_uuid.Uuid, perms: u32, value: u64, n: usize, cap: usize) -> u32 {
    return add_attr(db, u, perms, value, n, cap)
}

fn db_add_cccd(db: *mut GattDb) -> u32 {
    var z: [u8; 2] = [0; 2]
    return add_attr(db, bt_uuid.uuid16(bt_uuid.UUID_CCCD), P_READ | P_WRITE, (&z[0]) as u64, 2, 2)
}

fn db_cccd_of(db: *mut GattDb, value_handle: u32) -> u32 {
    var k: usize = value_handle as usize
    while k < (*db).count {
        let t: bt_uuid.Uuid = db_uuid(db, k)
        if bt_uuid.uuid_eq(t, bt_uuid.uuid16(bt_uuid.UUID_CHARACTERISTIC)) || db_is_service_decl(db, k) {
            return 0
        }
        if bt_uuid.uuid_eq(t, bt_uuid.uuid16(bt_uuid.UUID_CCCD)) {
            return (k + 1) as u32
        }
        k = k + 1
    }
    return 0
}

fn db_log_write(db: *mut GattDb, handle: u32) {
    bt_le.le_put16(&(*db).writes, handle)
}

fn db_pop_write(db: *mut GattDb) -> u32 {
    if (*db).wpos + 2 > rt.buf_len(&(*db).writes) {
        rt.buf_clear(&(*db).writes)
        (*db).wpos = 0
        return 0
    }
    let h: u32 = bt_le.le_get16(rt.buf_ptr(&(*db).writes), (*db).wpos)
    (*db).wpos = (*db).wpos + 2
    return h
}

fn db_truncate(db: *mut GattDb, i: usize, n: usize) {
    rt.st64(rec(db, i), 4, n as u64)
}
