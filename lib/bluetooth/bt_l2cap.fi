// SPDX-License-Identifier: MPL-2.0
import std.rt
import bluetooth.bt_le

export {
    SIG_COMMAND_REJECT, SIG_DISCONNECTION_REQUEST, SIG_DISCONNECTION_RESPONSE,
    SIG_CONN_PARAM_UPDATE_REQUEST, SIG_CONN_PARAM_UPDATE_RESPONSE,
    SIG_LE_CREDIT_CONNECTION_REQUEST, SIG_LE_CREDIT_CONNECTION_RESPONSE,
    SIG_LE_FLOW_CONTROL_CREDIT,
    SigCommand, ConnParams, LeCreditRequest,
    sig_parse, sig_command_reject, sig_disconnection_request,
    sig_disconnection_response, sig_conn_param_update_request,
    sig_conn_param_update_response, sig_le_credit_request,
    sig_le_credit_response, sig_flow_control_credit,
    sig_parse_conn_params, sig_parse_le_credit_request,
    conn_params_valid,
}

const SIG_COMMAND_REJECT: u32 = 0x01
const SIG_DISCONNECTION_REQUEST: u32 = 0x06
const SIG_DISCONNECTION_RESPONSE: u32 = 0x07
const SIG_CONN_PARAM_UPDATE_REQUEST: u32 = 0x12
const SIG_CONN_PARAM_UPDATE_RESPONSE: u32 = 0x13
const SIG_LE_CREDIT_CONNECTION_REQUEST: u32 = 0x14
const SIG_LE_CREDIT_CONNECTION_RESPONSE: u32 = 0x15
const SIG_LE_FLOW_CONTROL_CREDIT: u32 = 0x16

struct SigCommand {
    code: u32,
    id: u32,
    data: u64,
    n: usize,
}

struct ConnParams {
    min_interval: u32,
    max_interval: u32,
    latency: u32,
    timeout: u32,
}

struct LeCreditRequest {
    psm: u32,
    scid: u32,
    mtu: u32,
    mps: u32,
    credits: u32,
}

fn sig_parse(p: u64, n: usize, out: *mut SigCommand) -> bool {
    if n < 4 {
        return false
    }
    let dlen: usize = bt_le.le_get16(p, 2) as usize
    if n != 4 + dlen {
        return false
    }
    (*out).code = rt.ld8(p, 0) as u32
    (*out).id = rt.ld8(p, 1) as u32
    (*out).data = p + 4 as u64
    (*out).n = dlen
    return true
}

fn sig_begin(b: *mut rt.Buf, code: u32, id: u32, dlen: u32) {
    bt_le.le_put8(b, code)
    bt_le.le_put8(b, id)
    bt_le.le_put16(b, dlen)
}

fn sig_command_reject(b: *mut rt.Buf, id: u32, reason: u32) {
    sig_begin(b, SIG_COMMAND_REJECT, id, 2)
    bt_le.le_put16(b, reason)
}

fn sig_disconnection_request(b: *mut rt.Buf, id: u32, dcid: u32, scid: u32) {
    sig_begin(b, SIG_DISCONNECTION_REQUEST, id, 4)
    bt_le.le_put16(b, dcid)
    bt_le.le_put16(b, scid)
}

fn sig_disconnection_response(b: *mut rt.Buf, id: u32, dcid: u32, scid: u32) {
    sig_begin(b, SIG_DISCONNECTION_RESPONSE, id, 4)
    bt_le.le_put16(b, dcid)
    bt_le.le_put16(b, scid)
}

fn sig_conn_param_update_request(b: *mut rt.Buf, id: u32, c: ConnParams) {
    sig_begin(b, SIG_CONN_PARAM_UPDATE_REQUEST, id, 8)
    bt_le.le_put16(b, c.min_interval)
    bt_le.le_put16(b, c.max_interval)
    bt_le.le_put16(b, c.latency)
    bt_le.le_put16(b, c.timeout)
}

fn sig_conn_param_update_response(b: *mut rt.Buf, id: u32, accepted: bool) {
    sig_begin(b, SIG_CONN_PARAM_UPDATE_RESPONSE, id, 2)
    bt_le.le_put16(b, if accepted { 0 } else { 1 })
}

fn sig_le_credit_request(b: *mut rt.Buf, id: u32, r: LeCreditRequest) {
    sig_begin(b, SIG_LE_CREDIT_CONNECTION_REQUEST, id, 10)
    bt_le.le_put16(b, r.psm)
    bt_le.le_put16(b, r.scid)
    bt_le.le_put16(b, r.mtu)
    bt_le.le_put16(b, r.mps)
    bt_le.le_put16(b, r.credits)
}

fn sig_le_credit_response(b: *mut rt.Buf, id: u32, dcid: u32, mtu: u32, mps: u32, credits: u32, result: u32) {
    sig_begin(b, SIG_LE_CREDIT_CONNECTION_RESPONSE, id, 10)
    bt_le.le_put16(b, dcid)
    bt_le.le_put16(b, mtu)
    bt_le.le_put16(b, mps)
    bt_le.le_put16(b, credits)
    bt_le.le_put16(b, result)
}

fn sig_flow_control_credit(b: *mut rt.Buf, id: u32, cid: u32, credits: u32) {
    sig_begin(b, SIG_LE_FLOW_CONTROL_CREDIT, id, 4)
    bt_le.le_put16(b, cid)
    bt_le.le_put16(b, credits)
}

fn sig_parse_conn_params(c: *mut SigCommand, out: *mut ConnParams) -> bool {
    if (*c).code != SIG_CONN_PARAM_UPDATE_REQUEST || (*c).n != 8 {
        return false
    }
    (*out).min_interval = bt_le.le_get16((*c).data, 0)
    (*out).max_interval = bt_le.le_get16((*c).data, 2)
    (*out).latency = bt_le.le_get16((*c).data, 4)
    (*out).timeout = bt_le.le_get16((*c).data, 6)
    return true
}

fn sig_parse_le_credit_request(c: *mut SigCommand, out: *mut LeCreditRequest) -> bool {
    if (*c).code != SIG_LE_CREDIT_CONNECTION_REQUEST || (*c).n != 10 {
        return false
    }
    (*out).psm = bt_le.le_get16((*c).data, 0)
    (*out).scid = bt_le.le_get16((*c).data, 2)
    (*out).mtu = bt_le.le_get16((*c).data, 4)
    (*out).mps = bt_le.le_get16((*c).data, 6)
    (*out).credits = bt_le.le_get16((*c).data, 8)
    return true
}

fn conn_params_valid(c: ConnParams) -> bool {
    if c.min_interval < 6 || c.max_interval > 3200 || c.min_interval > c.max_interval {
        return false
    }
    if c.latency > 499 || c.timeout < 10 || c.timeout > 3200 {
        return false
    }
    return (c.timeout as u64) * 4 > ((1 + c.latency) as u64) * (c.max_interval as u64)
}
