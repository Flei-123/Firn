// SPDX-License-Identifier: MPL-2.0
// lib/bluetooth/bt_trace.fi -- bt_trace: text HCI traces ("> hex" host to controller, "< hex" controller to host)
import std.rt
import bluetooth.bt_hex

export { trace_add, trace_next_line, trace_decode_line, TRACE_HOST, TRACE_CONTROLLER }

const TRACE_HOST: u8 = 62
const TRACE_CONTROLLER: u8 = 60

fn trace_add(t: *mut rt.Buf, host_to_controller: bool, p: u64, n: usize) {
    if host_to_controller {
        rt.buf_push(t, TRACE_HOST)
    } else {
        rt.buf_push(t, TRACE_CONTROLLER)
    }
    rt.buf_push(t, 32 as u8)
    bt_hex.hex_put(t, p, n)
    rt.buf_push(t, 10 as u8)
}

fn trace_next_line(text: u64, len: usize, pos: *mut usize, start: *mut usize, end: *mut usize) -> bool {
    while *pos < len {
        var e: usize = *pos
        while e < len && rt.ld8(text, e) != 10 as u8 {
            e = e + 1
        }
        let s: usize = *pos
        *pos = e + 1
        var t: usize = e
        while t > s && (rt.ld8(text, t - 1) == 13 as u8 || rt.ld8(text, t - 1) == 32 as u8) {
            t = t - 1
        }
        if t > s && rt.ld8(text, s) != 35 as u8 {
            *start = s
            *end = t
            return true
        }
    }
    return false
}

fn trace_decode_line(text: u64, start: usize, end: usize, out: *mut rt.Buf) -> u8 {
    if end - start < 2 {
        return 0 as u8
    }
    let dir: u8 = rt.ld8(text, start)
    if dir != TRACE_HOST && dir != TRACE_CONTROLLER {
        return 0 as u8
    }
    let s: str = str { p: (text + (start + 2) as u64) as *mut u8, n: end - start - 2 }
    if !bt_hex.hex_parse(s, out) {
        return 0 as u8
    }
    return dir
}
