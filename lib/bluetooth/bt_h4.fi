// SPDX-License-Identifier: MPL-2.0
// lib/bluetooth/bt_h4.fi -- bt_h4: HCI UART transport layer (H4) stream deframer
import std.rt
import bluetooth.bt_le
import bluetooth.bt_hci

export { H4Deframer, h4_new, h4_free, h4_feed, h4_next, h4_failed, h4_reset, h4_header_len, h4_payload_len, H4_MAX_PACKET }

const H4_MAX_PACKET: usize = 65551

struct H4Deframer {
    buf: rt.Buf,
    pos: usize,
    failed: bool,
}

fn h4_new() -> H4Deframer {
    return H4Deframer { buf: rt.buf_new(), pos: 0, failed: false }
}

fn h4_free(d: *mut H4Deframer) {
    rt.buf_free(&(*d).buf)
}

fn h4_reset(d: *mut H4Deframer) {
    rt.buf_clear(&(*d).buf)
    (*d).pos = 0
    (*d).failed = false
}

fn h4_failed(d: *mut H4Deframer) -> bool {
    return (*d).failed
}

fn h4_feed(d: *mut H4Deframer, p: u64, n: usize) {
    rt.buf_push_bytes(&(*d).buf, p, n)
}

fn h4_header_len(ptype: u32) -> usize {
    if ptype == bt_hci.H4_COMMAND { return 4 }
    if ptype == bt_hci.H4_ACL { return 5 }
    if ptype == bt_hci.H4_SCO { return 4 }
    if ptype == bt_hci.H4_EVENT { return 3 }
    if ptype == bt_hci.H4_ISO { return 5 }
    return 0
}

fn h4_payload_len(ptype: u32, p: u64) -> usize {
    if ptype == bt_hci.H4_COMMAND { return rt.ld8(p, 3) as usize }
    if ptype == bt_hci.H4_ACL { return bt_le.le_get16(p, 3) as usize }
    if ptype == bt_hci.H4_SCO { return rt.ld8(p, 3) as usize }
    if ptype == bt_hci.H4_EVENT { return rt.ld8(p, 2) as usize }
    return (bt_le.le_get16(p, 3) & 16383) as usize
}

fn compact(d: *mut H4Deframer) {
    let len: usize = rt.buf_len(&(*d).buf)
    if (*d).pos == 0 {
        return
    }
    if (*d).pos >= len {
        rt.buf_clear(&(*d).buf)
        (*d).pos = 0
        return
    }
    if (*d).pos > 4096 {
        let base: u64 = rt.buf_ptr(&(*d).buf)
        rt.mem_copy(base, base + (*d).pos as u64, len - (*d).pos)
        rt.buf_set_len(&(*d).buf, len - (*d).pos)
        (*d).pos = 0
    }
}

fn h4_next(d: *mut H4Deframer, out: *mut rt.Buf) -> bool {
    if (*d).failed {
        return false
    }
    let len: usize = rt.buf_len(&(*d).buf)
    let avail: usize = len - (*d).pos
    if avail == 0 {
        compact(d)
        return false
    }
    let base: u64 = rt.buf_ptr(&(*d).buf) + (*d).pos as u64
    let ptype: u32 = rt.ld8(base, 0) as u32
    let hl: usize = h4_header_len(ptype)
    if hl == 0 {
        (*d).failed = true
        return false
    }
    if avail < hl {
        return false
    }
    let total: usize = hl + h4_payload_len(ptype, base)
    if total > H4_MAX_PACKET {
        (*d).failed = true
        return false
    }
    if avail < total {
        return false
    }
    rt.buf_push_bytes(out, base, total)
    (*d).pos = (*d).pos + total
    compact(d)
    return true
}
