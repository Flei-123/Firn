// SPDX-License-Identifier: MPL-2.0
import std.rt
import bluetooth.bt_le
import bluetooth.bt_uuid

export {
    ATT_ERROR_RSP, ATT_MTU_REQ, ATT_MTU_RSP, ATT_FIND_INFO_REQ, ATT_FIND_INFO_RSP,
    ATT_FIND_BY_TYPE_VALUE_REQ, ATT_FIND_BY_TYPE_VALUE_RSP, ATT_READ_BY_TYPE_REQ,
    ATT_READ_BY_TYPE_RSP, ATT_READ_REQ, ATT_READ_RSP, ATT_READ_BLOB_REQ,
    ATT_READ_BLOB_RSP, ATT_READ_MULTIPLE_REQ, ATT_READ_BY_GROUP_TYPE_REQ,
    ATT_READ_BY_GROUP_TYPE_RSP, ATT_WRITE_REQ, ATT_WRITE_RSP, ATT_WRITE_CMD,
    ATT_PREPARE_WRITE_REQ, ATT_PREPARE_WRITE_RSP, ATT_EXECUTE_WRITE_REQ,
    ATT_EXECUTE_WRITE_RSP, ATT_HANDLE_VALUE_NTF, ATT_HANDLE_VALUE_IND,
    ATT_HANDLE_VALUE_CFM, ATT_SIGNED_WRITE_CMD,
    E_INVALID_HANDLE, E_READ_NOT_PERMITTED, E_WRITE_NOT_PERMITTED, E_INVALID_PDU,
    E_INSUFFICIENT_AUTHENTICATION, E_REQUEST_NOT_SUPPORTED, E_INVALID_OFFSET,
    E_INSUFFICIENT_AUTHORIZATION, E_PREPARE_QUEUE_FULL, E_ATTRIBUTE_NOT_FOUND,
    E_ATTRIBUTE_NOT_LONG, E_INVALID_ATTRIBUTE_VALUE_LENGTH, E_UNLIKELY_ERROR,
    E_INSUFFICIENT_ENCRYPTION, E_UNSUPPORTED_GROUP_TYPE, E_INSUFFICIENT_RESOURCES,
    ATT_DEFAULT_MTU, ATT_MAX_MTU,
    att_error, att_mtu_req, att_mtu_rsp, att_find_info_req,
    att_find_by_type_value_req, att_read_by_type_req, att_read_req,
    att_read_blob_req, att_read_by_group_type_req, att_write_req, att_write_cmd,
    att_prepare_write_req, att_execute_write_req, att_notification,
    att_indication, att_confirmation,
}

const ATT_ERROR_RSP: u32 = 0x01
const ATT_MTU_REQ: u32 = 0x02
const ATT_MTU_RSP: u32 = 0x03
const ATT_FIND_INFO_REQ: u32 = 0x04
const ATT_FIND_INFO_RSP: u32 = 0x05
const ATT_FIND_BY_TYPE_VALUE_REQ: u32 = 0x06
const ATT_FIND_BY_TYPE_VALUE_RSP: u32 = 0x07
const ATT_READ_BY_TYPE_REQ: u32 = 0x08
const ATT_READ_BY_TYPE_RSP: u32 = 0x09
const ATT_READ_REQ: u32 = 0x0A
const ATT_READ_RSP: u32 = 0x0B
const ATT_READ_BLOB_REQ: u32 = 0x0C
const ATT_READ_BLOB_RSP: u32 = 0x0D
const ATT_READ_MULTIPLE_REQ: u32 = 0x0E
const ATT_READ_BY_GROUP_TYPE_REQ: u32 = 0x10
const ATT_READ_BY_GROUP_TYPE_RSP: u32 = 0x11
const ATT_WRITE_REQ: u32 = 0x12
const ATT_WRITE_RSP: u32 = 0x13
const ATT_PREPARE_WRITE_REQ: u32 = 0x16
const ATT_PREPARE_WRITE_RSP: u32 = 0x17
const ATT_EXECUTE_WRITE_REQ: u32 = 0x18
const ATT_EXECUTE_WRITE_RSP: u32 = 0x19
const ATT_HANDLE_VALUE_NTF: u32 = 0x1B
const ATT_HANDLE_VALUE_IND: u32 = 0x1D
const ATT_HANDLE_VALUE_CFM: u32 = 0x1E
const ATT_WRITE_CMD: u32 = 0x52
const ATT_SIGNED_WRITE_CMD: u32 = 0xD2

const E_INVALID_HANDLE: u32 = 0x01
const E_READ_NOT_PERMITTED: u32 = 0x02
const E_WRITE_NOT_PERMITTED: u32 = 0x03
const E_INVALID_PDU: u32 = 0x04
const E_INSUFFICIENT_AUTHENTICATION: u32 = 0x05
const E_REQUEST_NOT_SUPPORTED: u32 = 0x06
const E_INVALID_OFFSET: u32 = 0x07
const E_INSUFFICIENT_AUTHORIZATION: u32 = 0x08
const E_PREPARE_QUEUE_FULL: u32 = 0x09
const E_ATTRIBUTE_NOT_FOUND: u32 = 0x0A
const E_ATTRIBUTE_NOT_LONG: u32 = 0x0B
const E_INVALID_ATTRIBUTE_VALUE_LENGTH: u32 = 0x0D
const E_UNLIKELY_ERROR: u32 = 0x0E
const E_INSUFFICIENT_ENCRYPTION: u32 = 0x0F
const E_UNSUPPORTED_GROUP_TYPE: u32 = 0x10
const E_INSUFFICIENT_RESOURCES: u32 = 0x11

const ATT_DEFAULT_MTU: u32 = 23
const ATT_MAX_MTU: u32 = 517

fn att_error(b: *mut rt.Buf, req_op: u32, handle: u32, code: u32) {
    bt_le.le_put8(b, ATT_ERROR_RSP)
    bt_le.le_put8(b, req_op)
    bt_le.le_put16(b, handle)
    bt_le.le_put8(b, code)
}

fn att_mtu_req(b: *mut rt.Buf, mtu: u32) {
    bt_le.le_put8(b, ATT_MTU_REQ)
    bt_le.le_put16(b, mtu)
}

fn att_mtu_rsp(b: *mut rt.Buf, mtu: u32) {
    bt_le.le_put8(b, ATT_MTU_RSP)
    bt_le.le_put16(b, mtu)
}

fn att_find_info_req(b: *mut rt.Buf, start: u32, end: u32) {
    bt_le.le_put8(b, ATT_FIND_INFO_REQ)
    bt_le.le_put16(b, start)
    bt_le.le_put16(b, end)
}

fn att_find_by_type_value_req(b: *mut rt.Buf, start: u32, end: u32, type16: u32, value: u64, n: usize) {
    bt_le.le_put8(b, ATT_FIND_BY_TYPE_VALUE_REQ)
    bt_le.le_put16(b, start)
    bt_le.le_put16(b, end)
    bt_le.le_put16(b, type16)
    bt_le.le_put_raw(b, value, n)
}

fn range_req(b: *mut rt.Buf, op: u32, start: u32, end: u32, t: bt_uuid.Uuid) {
    bt_le.le_put8(b, op)
    bt_le.le_put16(b, start)
    bt_le.le_put16(b, end)
    bt_uuid.uuid_put(b, t)
}

fn att_read_by_type_req(b: *mut rt.Buf, start: u32, end: u32, t: bt_uuid.Uuid) {
    range_req(b, ATT_READ_BY_TYPE_REQ, start, end, t)
}

fn att_read_by_group_type_req(b: *mut rt.Buf, start: u32, end: u32, t: bt_uuid.Uuid) {
    range_req(b, ATT_READ_BY_GROUP_TYPE_REQ, start, end, t)
}

fn att_read_req(b: *mut rt.Buf, handle: u32) {
    bt_le.le_put8(b, ATT_READ_REQ)
    bt_le.le_put16(b, handle)
}

fn att_read_blob_req(b: *mut rt.Buf, handle: u32, offset: u32) {
    bt_le.le_put8(b, ATT_READ_BLOB_REQ)
    bt_le.le_put16(b, handle)
    bt_le.le_put16(b, offset)
}

fn att_write_req(b: *mut rt.Buf, handle: u32, value: u64, n: usize) {
    bt_le.le_put8(b, ATT_WRITE_REQ)
    bt_le.le_put16(b, handle)
    bt_le.le_put_raw(b, value, n)
}

fn att_write_cmd(b: *mut rt.Buf, handle: u32, value: u64, n: usize) {
    bt_le.le_put8(b, ATT_WRITE_CMD)
    bt_le.le_put16(b, handle)
    bt_le.le_put_raw(b, value, n)
}

fn att_prepare_write_req(b: *mut rt.Buf, handle: u32, offset: u32, value: u64, n: usize) {
    bt_le.le_put8(b, ATT_PREPARE_WRITE_REQ)
    bt_le.le_put16(b, handle)
    bt_le.le_put16(b, offset)
    bt_le.le_put_raw(b, value, n)
}

fn att_execute_write_req(b: *mut rt.Buf, commit: bool) {
    bt_le.le_put8(b, ATT_EXECUTE_WRITE_REQ)
    bt_le.le_put8(b, if commit { 1 } else { 0 })
}

fn att_notification(b: *mut rt.Buf, handle: u32, value: u64, n: usize) {
    bt_le.le_put8(b, ATT_HANDLE_VALUE_NTF)
    bt_le.le_put16(b, handle)
    bt_le.le_put_raw(b, value, n)
}

fn att_indication(b: *mut rt.Buf, handle: u32, value: u64, n: usize) {
    bt_le.le_put8(b, ATT_HANDLE_VALUE_IND)
    bt_le.le_put16(b, handle)
    bt_le.le_put_raw(b, value, n)
}

fn att_confirmation(b: *mut rt.Buf) {
    bt_le.le_put8(b, ATT_HANDLE_VALUE_CFM)
}
