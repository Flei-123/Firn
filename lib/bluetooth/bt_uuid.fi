// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.str
import bluetooth.bt_le
import bluetooth.bt_hex

export {
    Uuid, uuid16, uuid_eq, uuid_is_short, uuid_short, uuid_put, uuid_put_full,
    uuid_get, uuid_parse, uuid_format,
    UUID_PRIMARY_SERVICE, UUID_SECONDARY_SERVICE, UUID_INCLUDE,
    UUID_CHARACTERISTIC, UUID_CCCD, UUID_DEVICE_NAME, UUID_APPEARANCE,
    UUID_GAP_SERVICE, UUID_GATT_SERVICE, UUID_SERVICE_CHANGED,
}

const BASE_LO: u64 = 0x800000805F9B34FB
const BASE_HI: u64 = 0x0000000000001000

const UUID_PRIMARY_SERVICE: u32 = 0x2800
const UUID_SECONDARY_SERVICE: u32 = 0x2801
const UUID_INCLUDE: u32 = 0x2802
const UUID_CHARACTERISTIC: u32 = 0x2803
const UUID_CCCD: u32 = 0x2902
const UUID_DEVICE_NAME: u32 = 0x2A00
const UUID_APPEARANCE: u32 = 0x2A01
const UUID_GAP_SERVICE: u32 = 0x1800
const UUID_GATT_SERVICE: u32 = 0x1801
const UUID_SERVICE_CHANGED: u32 = 0x2A05

struct Uuid {
    lo: u64,
    hi: u64,
}

fn uuid16(v: u32) -> Uuid {
    return Uuid { lo: BASE_LO, hi: BASE_HI | ((v as u64) << 32) }
}

fn uuid_eq(a: Uuid, b: Uuid) -> bool {
    return a.lo == b.lo && a.hi == b.hi
}

fn uuid_is_short(u: Uuid) -> bool {
    return u.lo == BASE_LO && (u.hi & 0xFFFF0000FFFFFFFF) == BASE_HI && ((u.hi >> 32) & 65535) <= 65535
}

fn uuid_short(u: Uuid) -> u32 {
    return ((u.hi >> 32) & 65535) as u32
}

fn uuid_put_full(b: *mut rt.Buf, u: Uuid) {
    bt_le.le_put64(b, u.lo)
    bt_le.le_put64(b, u.hi)
}

fn uuid_put(b: *mut rt.Buf, u: Uuid) {
    if uuid_is_short(u) {
        bt_le.le_put16(b, uuid_short(u))
    } else {
        uuid_put_full(b, u)
    }
}

fn uuid_get(p: u64, i: usize, n: usize, out: *mut Uuid) -> bool {
    if n == 2 {
        *out = uuid16(bt_le.le_get16(p, i))
        return true
    }
    if n == 4 {
        (*out).lo = BASE_LO
        (*out).hi = BASE_HI | ((bt_le.le_get32(p, i) as u64) << 32)
        return true
    }
    if n == 16 {
        (*out).lo = bt_le.le_get64(p, i)
        (*out).hi = bt_le.le_get64(p, i + 8)
        return true
    }
    return false
}

fn uuid_parse(s: str, out: *mut Uuid) -> bool {
    var raw: rt.Buf = rt.buf_new()
    var i: usize = 0
    let n: usize = s.length()
    var h: rt.Buf = rt.buf_new()
    while i < n {
        let c: u8 = rt.ld8(s.p as u64, i)
        if c != 45 as u8 {
            rt.buf_push(&h, c)
        }
        i = i + 1
    }
    var ok: bool = false
    if bt_hex.hex_parse(rt.buf_str(&h), &raw) && rt.buf_len(&raw) == 16 {
        var rev: [u8; 16] = [0; 16]
        var k: usize = 0
        while k < 16 {
            rev[k] = rt.ld8(rt.buf_ptr(&raw), 15 - k)
            k = k + 1
        }
        ok = uuid_get((&rev[0]) as u64, 0, 16, out)
    }
    rt.buf_free(&raw)
    rt.buf_free(&h)
    return ok
}

fn uuid_format(b: *mut rt.Buf, u: Uuid) {
    var tmp: rt.Buf = rt.buf_new()
    uuid_put_full(&tmp, u)
    let p: u64 = rt.buf_ptr(&tmp)
    var k: usize = 0
    while k < 16 {
        let idx: usize = 15 - k
        rt.buf_push_hex_u64(b, rt.ld8(p, idx) as u64, 2)
        if k == 3 || k == 5 || k == 7 || k == 9 {
            rt.buf_push(b, 45 as u8)
        }
        k = k + 1
    }
    rt.buf_free(&tmp)
}
