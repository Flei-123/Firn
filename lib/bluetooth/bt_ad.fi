// lib/bluetooth/bt_ad.fi -- bt_ad: advertising and scan response data structures (build, walk, find)
import std.rt
import std.str
import bluetooth.bt_le

export {
    AD_FLAGS, AD_INCOMPLETE_UUID16, AD_COMPLETE_UUID16, AD_INCOMPLETE_UUID32,
    AD_COMPLETE_UUID32, AD_INCOMPLETE_UUID128, AD_COMPLETE_UUID128, AD_SHORT_NAME,
    AD_COMPLETE_NAME, AD_TX_POWER, AD_CONN_INTERVAL_RANGE, AD_SERVICE_DATA16,
    AD_APPEARANCE, AD_SERVICE_DATA32, AD_SERVICE_DATA128, AD_MANUFACTURER,
    FLAG_LE_LIMITED, FLAG_LE_GENERAL, FLAG_NO_BREDR, FLAG_LE_BREDR_CONTROLLER,
    FLAG_LE_BREDR_HOST, AD_MAX_LEN,
    ad_put, ad_flags, ad_name, ad_uuids16, ad_uuid128, ad_tx_power, ad_appearance,
    ad_manufacturer, ad_service_data16, ad_conn_interval_range,
    ad_valid, ad_next, ad_find, ad_get_flags, ad_get_name, ad_has_uuid16,
    ad_get_manufacturer, ad_get_tx_power, ad_get_appearance,
}

const AD_FLAGS: u32 = 0x01
const AD_INCOMPLETE_UUID16: u32 = 0x02
const AD_COMPLETE_UUID16: u32 = 0x03
const AD_INCOMPLETE_UUID32: u32 = 0x04
const AD_COMPLETE_UUID32: u32 = 0x05
const AD_INCOMPLETE_UUID128: u32 = 0x06
const AD_COMPLETE_UUID128: u32 = 0x07
const AD_SHORT_NAME: u32 = 0x08
const AD_COMPLETE_NAME: u32 = 0x09
const AD_TX_POWER: u32 = 0x0A
const AD_CONN_INTERVAL_RANGE: u32 = 0x12
const AD_SERVICE_DATA16: u32 = 0x16
const AD_APPEARANCE: u32 = 0x19
const AD_SERVICE_DATA32: u32 = 0x20
const AD_SERVICE_DATA128: u32 = 0x21
const AD_MANUFACTURER: u32 = 0xFF

const FLAG_LE_LIMITED: u32 = 0x01
const FLAG_LE_GENERAL: u32 = 0x02
const FLAG_NO_BREDR: u32 = 0x04
const FLAG_LE_BREDR_CONTROLLER: u32 = 0x08
const FLAG_LE_BREDR_HOST: u32 = 0x10

const AD_MAX_LEN: usize = 31

fn ad_put(b: *mut rt.Buf, kind: u32, data: u64, n: usize) -> bool {
    if n > 254 {
        return false
    }
    bt_le.le_put8(b, (n + 1) as u32)
    bt_le.le_put8(b, kind)
    if n > 0 {
        bt_le.le_put_raw(b, data, n)
    }
    return true
}

fn ad_flags(b: *mut rt.Buf, flags: u32) {
    bt_le.le_put8(b, 2)
    bt_le.le_put8(b, AD_FLAGS)
    bt_le.le_put8(b, flags)
}

fn ad_name(b: *mut rt.Buf, complete: bool, name: str) -> bool {
    var kind: u32 = AD_SHORT_NAME
    if complete {
        kind = AD_COMPLETE_NAME
    }
    return ad_put(b, kind, name.p as u64, name.length())
}

fn ad_uuids16(b: *mut rt.Buf, complete: bool, uuids: u64, count: usize) -> bool {
    var kind: u32 = AD_INCOMPLETE_UUID16
    if complete {
        kind = AD_COMPLETE_UUID16
    }
    if count * 2 > 254 {
        return false
    }
    bt_le.le_put8(b, (count * 2 + 1) as u32)
    bt_le.le_put8(b, kind)
    var i: usize = 0
    while i < count {
        bt_le.le_put16(b, bt_le.le_get16(uuids, i * 2))
        i = i + 1
    }
    return true
}

fn ad_uuid128(b: *mut rt.Buf, complete: bool, uuid_le: u64) {
    var kind: u32 = AD_INCOMPLETE_UUID128
    if complete {
        kind = AD_COMPLETE_UUID128
    }
    ad_put(b, kind, uuid_le, 16)
}

fn ad_tx_power(b: *mut rt.Buf, dbm: i32) {
    bt_le.le_put8(b, 2)
    bt_le.le_put8(b, AD_TX_POWER)
    bt_le.le_put8(b, (dbm & 255) as u32)
}

fn ad_appearance(b: *mut rt.Buf, value: u32) {
    bt_le.le_put8(b, 3)
    bt_le.le_put8(b, AD_APPEARANCE)
    bt_le.le_put16(b, value)
}

fn ad_conn_interval_range(b: *mut rt.Buf, min_interval: u32, max_interval: u32) {
    bt_le.le_put8(b, 5)
    bt_le.le_put8(b, AD_CONN_INTERVAL_RANGE)
    bt_le.le_put16(b, min_interval)
    bt_le.le_put16(b, max_interval)
}

fn ad_manufacturer(b: *mut rt.Buf, company: u32, data: u64, n: usize) -> bool {
    if n + 2 > 254 {
        return false
    }
    bt_le.le_put8(b, (n + 3) as u32)
    bt_le.le_put8(b, AD_MANUFACTURER)
    bt_le.le_put16(b, company)
    if n > 0 {
        bt_le.le_put_raw(b, data, n)
    }
    return true
}

fn ad_service_data16(b: *mut rt.Buf, uuid: u32, data: u64, n: usize) -> bool {
    if n + 2 > 254 {
        return false
    }
    bt_le.le_put8(b, (n + 3) as u32)
    bt_le.le_put8(b, AD_SERVICE_DATA16)
    bt_le.le_put16(b, uuid)
    if n > 0 {
        bt_le.le_put_raw(b, data, n)
    }
    return true
}

fn ad_valid(p: u64, n: usize) -> bool {
    var pos: usize = 0
    while pos < n {
        let len: usize = rt.ld8(p, pos) as usize
        if len == 0 {
            return true
        }
        if pos + 1 + len > n {
            return false
        }
        pos = pos + 1 + len
    }
    return true
}

fn ad_next(p: u64, n: usize, pos: *mut usize, kind: *mut u32, data: *mut u64, len: *mut usize) -> bool {
    if *pos >= n {
        return false
    }
    let l: usize = rt.ld8(p, *pos) as usize
    if l == 0 || *pos + 1 + l > n {
        return false
    }
    *kind = rt.ld8(p, *pos + 1) as u32
    *data = p + (*pos + 2) as u64
    *len = l - 1
    *pos = *pos + 1 + l
    return true
}

fn ad_find(p: u64, n: usize, want: u32, data: *mut u64, len: *mut usize) -> bool {
    var pos: usize = 0
    var kind: u32 = 0
    while ad_next(p, n, &pos, &kind, data, len) {
        if kind == want {
            return true
        }
    }
    return false
}

fn ad_get_flags(p: u64, n: usize, out: *mut u32) -> bool {
    var d: u64 = 0
    var l: usize = 0
    if !ad_find(p, n, AD_FLAGS, &d, &l) || l < 1 {
        return false
    }
    *out = rt.ld8(d, 0) as u32
    return true
}

fn ad_get_name(p: u64, n: usize, out: *mut rt.Buf) -> bool {
    var d: u64 = 0
    var l: usize = 0
    if ad_find(p, n, AD_COMPLETE_NAME, &d, &l) || ad_find(p, n, AD_SHORT_NAME, &d, &l) {
        rt.buf_push_bytes(out, d, l)
        return true
    }
    return false
}

fn ad_has_uuid16(p: u64, n: usize, uuid: u32) -> bool {
    var pos: usize = 0
    var kind: u32 = 0
    var d: u64 = 0
    var l: usize = 0
    while ad_next(p, n, &pos, &kind, &d, &l) {
        if kind == AD_INCOMPLETE_UUID16 || kind == AD_COMPLETE_UUID16 {
            var i: usize = 0
            while i + 2 <= l {
                if bt_le.le_get16(d, i) == uuid {
                    return true
                }
                i = i + 2
            }
        }
    }
    return false
}

fn ad_get_manufacturer(p: u64, n: usize, company: *mut u32, data: *mut u64, len: *mut usize) -> bool {
    var d: u64 = 0
    var l: usize = 0
    if !ad_find(p, n, AD_MANUFACTURER, &d, &l) || l < 2 {
        return false
    }
    *company = bt_le.le_get16(d, 0)
    *data = d + 2
    *len = l - 2
    return true
}

fn ad_get_tx_power(p: u64, n: usize, out: *mut i32) -> bool {
    var d: u64 = 0
    var l: usize = 0
    if !ad_find(p, n, AD_TX_POWER, &d, &l) || l < 1 {
        return false
    }
    var v: i32 = rt.ld8(d, 0) as i32
    if v > 127 {
        v = v - 256
    }
    *out = v
    return true
}

fn ad_get_appearance(p: u64, n: usize, out: *mut u32) -> bool {
    var d: u64 = 0
    var l: usize = 0
    if !ad_find(p, n, AD_APPEARANCE, &d, &l) || l < 2 {
        return false
    }
    *out = bt_le.le_get16(d, 0)
    return true
}
