// lib/bluetooth/bt_cmac.fi -- bt_cmac: AES-CMAC (RFC 4493), big endian block order
import std.rt
import bluetooth.bt_aes

export { aes_cmac }

fn shift_left_one(dst: u64, src: u64) {
    var carry: u32 = 0
    var i: usize = 16
    while i > 0 {
        i = i - 1
        let v: u32 = rt.ld8(src, i) as u32
        rt.st8(dst, i, (((v << 1) | carry) & 255) as u8)
        carry = v >> 7
    }
}

fn subkey(dst: u64, src: u64) {
    let msb: u32 = (rt.ld8(src, 0) as u32) >> 7
    shift_left_one(dst, src)
    if msb == 1 {
        rt.st8(dst, 15, rt.ld8(dst, 15) ^ (0x87 as u8))
    }
}

fn aes_cmac(key: u64, msg: u64, n: usize, out: u64) {
    var zero: [u8; 16] = [0; 16]
    var l: [u8; 16] = [0; 16]
    var k1: [u8; 16] = [0; 16]
    var k2: [u8; 16] = [0; 16]
    var x: [u8; 16] = [0; 16]
    var y: [u8; 16] = [0; 16]
    var blk: [u8; 16] = [0; 16]
    let kp: u64 = key
    bt_aes.aes_ecb(kp, (&zero[0]) as u64, (&l[0]) as u64)
    subkey((&k1[0]) as u64, (&l[0]) as u64)
    subkey((&k2[0]) as u64, (&k1[0]) as u64)
    var blocks: usize = (n + 15) / 16
    var complete: bool = n > 0 && n % 16 == 0
    if blocks == 0 {
        blocks = 1
    }
    var i: usize = 0
    while i + 1 < blocks {
        bt_aes.xor_into((&y[0]) as u64, (&x[0]) as u64, msg + (i * 16) as u64, 16)
        bt_aes.aes_ecb(kp, (&y[0]) as u64, (&x[0]) as u64)
        i = i + 1
    }
    let rest: usize = n - (blocks - 1) * 16
    rt.mem_set((&blk[0]) as u64, 0 as u8, 16)
    if complete {
        rt.mem_copy((&blk[0]) as u64, msg + ((blocks - 1) * 16) as u64, 16)
        bt_aes.xor_into((&blk[0]) as u64, (&blk[0]) as u64, (&k1[0]) as u64, 16)
    } else {
        if rest > 0 {
            rt.mem_copy((&blk[0]) as u64, msg + ((blocks - 1) * 16) as u64, rest)
        }
        rt.st8((&blk[0]) as u64, rest, 0x80 as u8)
        bt_aes.xor_into((&blk[0]) as u64, (&blk[0]) as u64, (&k2[0]) as u64, 16)
    }
    bt_aes.xor_into((&y[0]) as u64, (&x[0]) as u64, (&blk[0]) as u64, 16)
    bt_aes.aes_ecb(kp, (&y[0]) as u64, out)
}
