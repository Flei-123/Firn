// SPDX-License-Identifier: MPL-2.0
// lib/bluetooth/bt_aes.fi -- bt_aes: AES-128 security function e and byte order helpers
import std.rt
import std.crypto.aes

export { sec_e, reverse_into, xor_into, put_reversed, aes_ecb }

fn reverse_into(dst: u64, src: u64, n: usize) {
    var tmp: [u8; 64] = [0; 64]
    let t: u64 = (&tmp[0]) as u64
    var i: usize = 0
    while i < n {
        rt.st8(t, i, rt.ld8(src, n - 1 - i))
        i = i + 1
    }
    rt.mem_copy(dst, t, n)
}

fn xor_into(dst: u64, a: u64, b: u64, n: usize) {
    var i: usize = 0
    while i < n {
        rt.st8(dst, i, rt.ld8(a, i) ^ rt.ld8(b, i))
        i = i + 1
    }
}

fn put_reversed(b: *mut rt.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push(b, rt.ld8(p, n - 1 - i))
        i = i + 1
    }
}

fn aes_ecb(key: u64, inp: u64, out: u64) {
    var a: aes.Aes = aes.aes128_new(key)
    aes.aes_encrypt_block(&a, inp, out)
}

fn sec_e(key: u64, data: u64, out: u64) {
    var k: [u8; 16] = [0; 16]
    var d: [u8; 16] = [0; 16]
    var o: [u8; 16] = [0; 16]
    reverse_into((&k[0]) as u64, key, 16)
    reverse_into((&d[0]) as u64, data, 16)
    aes_ecb((&k[0]) as u64, (&d[0]) as u64, (&o[0]) as u64)
    reverse_into(out, (&o[0]) as u64, 16)
}
