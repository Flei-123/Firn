// lib/bluetooth/bt_transport_stub.fi -- bt_transport_stub: Windows and Android backends, interface only (always unsupported)
import std.rt
import bluetooth.bt_transport

export { open_windows, open_android, platform_note }

fn open_windows(out: *mut bt_transport.Transport) -> i32 {
    *out = bt_transport.transport_closed()
    return bt_transport.TR_ERR_UNSUPPORTED
}

fn open_android(out: *mut bt_transport.Transport) -> i32 {
    *out = bt_transport.transport_closed()
    return bt_transport.TR_ERR_UNSUPPORTED
}

fn platform_note(kind: u32) -> str {
    if kind == bt_transport.TR_WINDOWS {
        return "windows: no raw HCI access from user space; needs a WinUSB or bthusb filter driver, not implemented"
    }
    if kind == bt_transport.TR_ANDROID {
        return "android: apps have no raw HCI access; needs the Java Bluetooth API through a JNI bridge, not implemented"
    }
    return "supported or unknown backend"
}
