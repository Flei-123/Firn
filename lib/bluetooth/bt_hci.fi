// SPDX-License-Identifier: MPL-2.0
import std.rt
import bluetooth.bt_le

export {
    H4_COMMAND, H4_ACL, H4_SCO, H4_EVENT, H4_ISO,
    OP_DISCONNECT, OP_SET_EVENT_MASK, OP_RESET, OP_WRITE_LE_HOST_SUPPORT,
    OP_READ_LOCAL_VERSION, OP_READ_LOCAL_COMMANDS, OP_READ_LOCAL_FEATURES,
    OP_READ_BUFFER_SIZE, OP_READ_BD_ADDR, OP_LE_SET_EVENT_MASK,
    OP_LE_READ_BUFFER_SIZE, OP_LE_READ_LOCAL_FEATURES, OP_LE_SET_RANDOM_ADDRESS,
    OP_LE_SET_ADV_PARAMS, OP_LE_SET_ADV_DATA, OP_LE_SET_SCAN_RSP_DATA,
    OP_LE_SET_ADV_ENABLE, OP_LE_SET_SCAN_PARAMS, OP_LE_SET_SCAN_ENABLE,
    OP_LE_CREATE_CONNECTION, OP_LE_CREATE_CONNECTION_CANCEL,
    OP_LE_CLEAR_FILTER_ACCEPT_LIST, OP_LE_ADD_FILTER_ACCEPT_LIST,
    OP_LE_CONNECTION_UPDATE, OP_LE_ENCRYPT, OP_LE_RAND,
    OP_LE_START_ENCRYPTION, OP_LE_LTK_REPLY, OP_LE_LTK_NEGATIVE_REPLY,
    OP_LE_SET_DATA_LENGTH,
    ADV_IND, ADV_DIRECT_IND, ADV_SCAN_IND, ADV_NONCONN_IND,
    ADDR_PUBLIC, ADDR_RANDOM,
    ogf_of, ocf_of, opcode_make,
    cmd_begin, cmd_end,
    hci_reset, hci_set_event_mask, hci_write_le_host_support,
    hci_read_local_version, hci_read_local_commands, hci_read_local_features,
    hci_read_buffer_size, hci_read_bd_addr, hci_disconnect,
    hci_le_set_event_mask, hci_le_read_buffer_size,
    hci_le_read_local_features, hci_le_set_random_address,
    hci_le_set_adv_params, hci_le_set_adv_data, hci_le_set_scan_rsp_data,
    hci_le_set_adv_enable, hci_le_set_scan_params, hci_le_set_scan_enable,
    hci_le_create_connection, hci_le_create_connection_cancel,
    hci_le_clear_filter_accept_list, hci_le_add_filter_accept_list,
    hci_le_connection_update, hci_le_encrypt, hci_le_rand,
    hci_le_start_encryption, hci_le_ltk_reply, hci_le_ltk_negative_reply,
    hci_le_set_data_length,
}

const H4_COMMAND: u32 = 1
const H4_ACL: u32 = 2
const H4_SCO: u32 = 3
const H4_EVENT: u32 = 4
const H4_ISO: u32 = 5

const OP_DISCONNECT: u32 = 0x0406
const OP_SET_EVENT_MASK: u32 = 0x0C01
const OP_RESET: u32 = 0x0C03
const OP_WRITE_LE_HOST_SUPPORT: u32 = 0x0C6D
const OP_READ_LOCAL_VERSION: u32 = 0x1001
const OP_READ_LOCAL_COMMANDS: u32 = 0x1002
const OP_READ_LOCAL_FEATURES: u32 = 0x1003
const OP_READ_BUFFER_SIZE: u32 = 0x1005
const OP_READ_BD_ADDR: u32 = 0x1009
const OP_LE_SET_EVENT_MASK: u32 = 0x2001
const OP_LE_READ_BUFFER_SIZE: u32 = 0x2002
const OP_LE_READ_LOCAL_FEATURES: u32 = 0x2003
const OP_LE_SET_RANDOM_ADDRESS: u32 = 0x2005
const OP_LE_SET_ADV_PARAMS: u32 = 0x2006
const OP_LE_SET_ADV_DATA: u32 = 0x2008
const OP_LE_SET_SCAN_RSP_DATA: u32 = 0x2009
const OP_LE_SET_ADV_ENABLE: u32 = 0x200A
const OP_LE_SET_SCAN_PARAMS: u32 = 0x200B
const OP_LE_SET_SCAN_ENABLE: u32 = 0x200C
const OP_LE_CREATE_CONNECTION: u32 = 0x200D
const OP_LE_CREATE_CONNECTION_CANCEL: u32 = 0x200E
const OP_LE_CLEAR_FILTER_ACCEPT_LIST: u32 = 0x2010
const OP_LE_ADD_FILTER_ACCEPT_LIST: u32 = 0x2011
const OP_LE_CONNECTION_UPDATE: u32 = 0x2013
const OP_LE_ENCRYPT: u32 = 0x2017
const OP_LE_RAND: u32 = 0x2018
const OP_LE_START_ENCRYPTION: u32 = 0x2019
const OP_LE_LTK_REPLY: u32 = 0x201A
const OP_LE_LTK_NEGATIVE_REPLY: u32 = 0x201B
const OP_LE_SET_DATA_LENGTH: u32 = 0x2022

const ADV_IND: u32 = 0
const ADV_DIRECT_IND: u32 = 1
const ADV_SCAN_IND: u32 = 2
const ADV_NONCONN_IND: u32 = 3

const ADDR_PUBLIC: u32 = 0
const ADDR_RANDOM: u32 = 1

fn ogf_of(op: u32) -> u32 {
    return op >> 10
}

fn ocf_of(op: u32) -> u32 {
    return op & 1023
}

fn opcode_make(ogf: u32, ocf: u32) -> u32 {
    return (ogf << 10) | (ocf & 1023)
}

fn cmd_begin(b: *mut rt.Buf, op: u32) -> usize {
    let start: usize = rt.buf_len(b)
    bt_le.le_put8(b, H4_COMMAND)
    bt_le.le_put16(b, op)
    bt_le.le_put8(b, 0)
    return start
}

fn cmd_end(b: *mut rt.Buf, start: usize) {
    let n: usize = rt.buf_len(b) - start - 4
    rt.st8(rt.buf_ptr(b), start + 3, (n & 255) as u8)
}

fn simple(b: *mut rt.Buf, op: u32) {
    let s: usize = cmd_begin(b, op)
    cmd_end(b, s)
}

fn put_addr(b: *mut rt.Buf, a: u64) {
    bt_le.le_put32(b, (a & 4294967295) as u32)
    bt_le.le_put16(b, ((a >> 32) & 65535) as u32)
}

fn hci_reset(b: *mut rt.Buf) { simple(b, OP_RESET) }
fn hci_read_local_version(b: *mut rt.Buf) { simple(b, OP_READ_LOCAL_VERSION) }
fn hci_read_local_commands(b: *mut rt.Buf) { simple(b, OP_READ_LOCAL_COMMANDS) }
fn hci_read_local_features(b: *mut rt.Buf) { simple(b, OP_READ_LOCAL_FEATURES) }
fn hci_read_buffer_size(b: *mut rt.Buf) { simple(b, OP_READ_BUFFER_SIZE) }
fn hci_read_bd_addr(b: *mut rt.Buf) { simple(b, OP_READ_BD_ADDR) }
fn hci_le_read_buffer_size(b: *mut rt.Buf) { simple(b, OP_LE_READ_BUFFER_SIZE) }
fn hci_le_read_local_features(b: *mut rt.Buf) { simple(b, OP_LE_READ_LOCAL_FEATURES) }
fn hci_le_create_connection_cancel(b: *mut rt.Buf) { simple(b, OP_LE_CREATE_CONNECTION_CANCEL) }
fn hci_le_clear_filter_accept_list(b: *mut rt.Buf) { simple(b, OP_LE_CLEAR_FILTER_ACCEPT_LIST) }
fn hci_le_rand(b: *mut rt.Buf) { simple(b, OP_LE_RAND) }

fn hci_set_event_mask(b: *mut rt.Buf, mask: u64) {
    let s: usize = cmd_begin(b, OP_SET_EVENT_MASK)
    bt_le.le_put64(b, mask)
    cmd_end(b, s)
}

fn hci_le_set_event_mask(b: *mut rt.Buf, mask: u64) {
    let s: usize = cmd_begin(b, OP_LE_SET_EVENT_MASK)
    bt_le.le_put64(b, mask)
    cmd_end(b, s)
}

fn hci_write_le_host_support(b: *mut rt.Buf, le: bool, simultaneous: bool) {
    let s: usize = cmd_begin(b, OP_WRITE_LE_HOST_SUPPORT)
    bt_le.le_put8(b, if le { 1 } else { 0 })
    bt_le.le_put8(b, if simultaneous { 1 } else { 0 })
    cmd_end(b, s)
}

fn hci_disconnect(b: *mut rt.Buf, handle: u32, reason: u32) {
    let s: usize = cmd_begin(b, OP_DISCONNECT)
    bt_le.le_put16(b, handle)
    bt_le.le_put8(b, reason)
    cmd_end(b, s)
}

fn hci_le_set_random_address(b: *mut rt.Buf, addr: u64) {
    let s: usize = cmd_begin(b, OP_LE_SET_RANDOM_ADDRESS)
    put_addr(b, addr)
    cmd_end(b, s)
}

fn hci_le_set_adv_params(b: *mut rt.Buf, min_interval: u32, max_interval: u32,
    adv_type: u32, own_addr_type: u32, peer_addr_type: u32, peer_addr: u64,
    channel_map: u32, filter_policy: u32) {
    let s: usize = cmd_begin(b, OP_LE_SET_ADV_PARAMS)
    bt_le.le_put16(b, min_interval)
    bt_le.le_put16(b, max_interval)
    bt_le.le_put8(b, adv_type)
    bt_le.le_put8(b, own_addr_type)
    bt_le.le_put8(b, peer_addr_type)
    put_addr(b, peer_addr)
    bt_le.le_put8(b, channel_map)
    bt_le.le_put8(b, filter_policy)
    cmd_end(b, s)
}

fn put_adv_block(b: *mut rt.Buf, op: u32, data: u64, n: usize) -> bool {
    if n > 31 {
        return false
    }
    let s: usize = cmd_begin(b, op)
    bt_le.le_put8(b, n as u32)
    bt_le.le_put_raw(b, data, n)
    bt_le.le_put_zero(b, 31 - n)
    cmd_end(b, s)
    return true
}

fn hci_le_set_adv_data(b: *mut rt.Buf, data: u64, n: usize) -> bool {
    return put_adv_block(b, OP_LE_SET_ADV_DATA, data, n)
}

fn hci_le_set_scan_rsp_data(b: *mut rt.Buf, data: u64, n: usize) -> bool {
    return put_adv_block(b, OP_LE_SET_SCAN_RSP_DATA, data, n)
}

fn hci_le_set_adv_enable(b: *mut rt.Buf, enable: bool) {
    let s: usize = cmd_begin(b, OP_LE_SET_ADV_ENABLE)
    bt_le.le_put8(b, if enable { 1 } else { 0 })
    cmd_end(b, s)
}

fn hci_le_set_scan_params(b: *mut rt.Buf, active: bool, interval: u32,
    window: u32, own_addr_type: u32, filter_policy: u32) {
    let s: usize = cmd_begin(b, OP_LE_SET_SCAN_PARAMS)
    bt_le.le_put8(b, if active { 1 } else { 0 })
    bt_le.le_put16(b, interval)
    bt_le.le_put16(b, window)
    bt_le.le_put8(b, own_addr_type)
    bt_le.le_put8(b, filter_policy)
    cmd_end(b, s)
}

fn hci_le_set_scan_enable(b: *mut rt.Buf, enable: bool, filter_duplicates: bool) {
    let s: usize = cmd_begin(b, OP_LE_SET_SCAN_ENABLE)
    bt_le.le_put8(b, if enable { 1 } else { 0 })
    bt_le.le_put8(b, if filter_duplicates { 1 } else { 0 })
    cmd_end(b, s)
}

fn hci_le_create_connection(b: *mut rt.Buf, scan_interval: u32, scan_window: u32,
    use_filter_list: bool, peer_addr_type: u32, peer_addr: u64,
    own_addr_type: u32, min_interval: u32, max_interval: u32, latency: u32,
    timeout: u32, min_ce: u32, max_ce: u32) {
    let s: usize = cmd_begin(b, OP_LE_CREATE_CONNECTION)
    bt_le.le_put16(b, scan_interval)
    bt_le.le_put16(b, scan_window)
    bt_le.le_put8(b, if use_filter_list { 1 } else { 0 })
    bt_le.le_put8(b, peer_addr_type)
    put_addr(b, peer_addr)
    bt_le.le_put8(b, own_addr_type)
    bt_le.le_put16(b, min_interval)
    bt_le.le_put16(b, max_interval)
    bt_le.le_put16(b, latency)
    bt_le.le_put16(b, timeout)
    bt_le.le_put16(b, min_ce)
    bt_le.le_put16(b, max_ce)
    cmd_end(b, s)
}

fn hci_le_add_filter_accept_list(b: *mut rt.Buf, addr_type: u32, addr: u64) {
    let s: usize = cmd_begin(b, OP_LE_ADD_FILTER_ACCEPT_LIST)
    bt_le.le_put8(b, addr_type)
    put_addr(b, addr)
    cmd_end(b, s)
}

fn hci_le_connection_update(b: *mut rt.Buf, handle: u32, min_interval: u32,
    max_interval: u32, latency: u32, timeout: u32, min_ce: u32, max_ce: u32) {
    let s: usize = cmd_begin(b, OP_LE_CONNECTION_UPDATE)
    bt_le.le_put16(b, handle)
    bt_le.le_put16(b, min_interval)
    bt_le.le_put16(b, max_interval)
    bt_le.le_put16(b, latency)
    bt_le.le_put16(b, timeout)
    bt_le.le_put16(b, min_ce)
    bt_le.le_put16(b, max_ce)
    cmd_end(b, s)
}

fn hci_le_encrypt(b: *mut rt.Buf, key: u64, plain: u64) {
    let s: usize = cmd_begin(b, OP_LE_ENCRYPT)
    bt_le.le_put_raw(b, key, 16)
    bt_le.le_put_raw(b, plain, 16)
    cmd_end(b, s)
}

fn hci_le_start_encryption(b: *mut rt.Buf, handle: u32, rand: u64, ediv: u32, ltk: u64) {
    let s: usize = cmd_begin(b, OP_LE_START_ENCRYPTION)
    bt_le.le_put16(b, handle)
    bt_le.le_put64(b, rand)
    bt_le.le_put16(b, ediv)
    bt_le.le_put_raw(b, ltk, 16)
    cmd_end(b, s)
}

fn hci_le_ltk_reply(b: *mut rt.Buf, handle: u32, ltk: u64) {
    let s: usize = cmd_begin(b, OP_LE_LTK_REPLY)
    bt_le.le_put16(b, handle)
    bt_le.le_put_raw(b, ltk, 16)
    cmd_end(b, s)
}

fn hci_le_ltk_negative_reply(b: *mut rt.Buf, handle: u32) {
    let s: usize = cmd_begin(b, OP_LE_LTK_NEGATIVE_REPLY)
    bt_le.le_put16(b, handle)
    cmd_end(b, s)
}

fn hci_le_set_data_length(b: *mut rt.Buf, handle: u32, tx_octets: u32, tx_time: u32) {
    let s: usize = cmd_begin(b, OP_LE_SET_DATA_LENGTH)
    bt_le.le_put16(b, handle)
    bt_le.le_put16(b, tx_octets)
    bt_le.le_put16(b, tx_time)
    cmd_end(b, s)
}
