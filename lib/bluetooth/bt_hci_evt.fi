// SPDX-License-Identifier: MPL-2.0
import std.rt
import bluetooth.bt_le
import bluetooth.bt_hci

export {
    EV_DISCONNECTION_COMPLETE, EV_ENCRYPTION_CHANGE, EV_COMMAND_COMPLETE,
    EV_COMMAND_STATUS, EV_NUMBER_OF_COMPLETED_PACKETS, EV_LE_META,
    LE_CONNECTION_COMPLETE, LE_ADVERTISING_REPORT, LE_CONNECTION_UPDATE_COMPLETE,
    LE_LTK_REQUEST, LE_DATA_LENGTH_CHANGE,
    HciEvent, CmdComplete, CmdStatus, DisconnectionComplete, LeConnComplete,
    AdvReport, ConnUpdate,
    addr_get, event_parse, event_cmd_complete, event_cmd_status,
    event_disconnection, event_le_connection, event_adv_report_count,
    event_adv_report_next, event_conn_update, event_ltk_request,
    event_completed_packets_count, event_completed_packet_at,
}

const EV_DISCONNECTION_COMPLETE: u32 = 0x05
const EV_ENCRYPTION_CHANGE: u32 = 0x08
const EV_COMMAND_COMPLETE: u32 = 0x0E
const EV_COMMAND_STATUS: u32 = 0x0F
const EV_NUMBER_OF_COMPLETED_PACKETS: u32 = 0x13
const EV_LE_META: u32 = 0x3E

const LE_CONNECTION_COMPLETE: u32 = 0x01
const LE_ADVERTISING_REPORT: u32 = 0x02
const LE_CONNECTION_UPDATE_COMPLETE: u32 = 0x03
const LE_LTK_REQUEST: u32 = 0x05
const LE_DATA_LENGTH_CHANGE: u32 = 0x07

struct HciEvent {
    code: u32,
    sub: u32,
    params: u64,
    n: usize,
}

struct CmdComplete {
    ncmd: u32,
    opcode: u32,
    status: u32,
    ret: u64,
    retn: usize,
}

struct CmdStatus {
    status: u32,
    ncmd: u32,
    opcode: u32,
}

struct DisconnectionComplete {
    status: u32,
    handle: u32,
    reason: u32,
}

struct LeConnComplete {
    status: u32,
    handle: u32,
    role: u32,
    peer_type: u32,
    peer: u64,
    interval: u32,
    latency: u32,
    timeout: u32,
    clock_accuracy: u32,
}

struct ConnUpdate {
    status: u32,
    handle: u32,
    interval: u32,
    latency: u32,
    timeout: u32,
}

struct AdvReport {
    kind: u32,
    addr_type: u32,
    addr: u64,
    data: u64,
    dlen: usize,
    rssi: i32,
}

fn addr_get(p: u64, i: usize) -> u64 {
    return bt_le.le_get32(p, i) as u64 | ((bt_le.le_get16(p, i + 4) as u64) << 32)
}

fn event_parse(p: u64, n: usize, out: *mut HciEvent) -> bool {
    if n < 3 || rt.ld8(p, 0) != bt_hci.H4_EVENT as u8 {
        return false
    }
    let plen: usize = rt.ld8(p, 2) as usize
    if n != plen + 3 {
        return false
    }
    (*out).code = rt.ld8(p, 1) as u32
    (*out).sub = 0
    (*out).params = p + 3 as u64
    (*out).n = plen
    if (*out).code == EV_LE_META {
        if plen < 1 {
            return false
        }
        (*out).sub = rt.ld8(p, 3) as u32
        (*out).params = p + 4 as u64
        (*out).n = plen - 1
    }
    return true
}

fn event_cmd_complete(ev: *mut HciEvent, out: *mut CmdComplete) -> bool {
    if (*ev).code != EV_COMMAND_COMPLETE || (*ev).n < 3 {
        return false
    }
    let q: u64 = (*ev).params
    (*out).ncmd = rt.ld8(q, 0) as u32
    (*out).opcode = bt_le.le_get16(q, 1)
    (*out).status = 0
    (*out).ret = q + 3 as u64
    (*out).retn = (*ev).n - 3
    if (*ev).n >= 4 {
        (*out).status = rt.ld8(q, 3) as u32
        (*out).ret = q + 4 as u64
        (*out).retn = (*ev).n - 4
    }
    return true
}

fn event_cmd_status(ev: *mut HciEvent, out: *mut CmdStatus) -> bool {
    if (*ev).code != EV_COMMAND_STATUS || (*ev).n != 4 {
        return false
    }
    let q: u64 = (*ev).params
    (*out).status = rt.ld8(q, 0) as u32
    (*out).ncmd = rt.ld8(q, 1) as u32
    (*out).opcode = bt_le.le_get16(q, 2)
    return true
}

fn event_disconnection(ev: *mut HciEvent, out: *mut DisconnectionComplete) -> bool {
    if (*ev).code != EV_DISCONNECTION_COMPLETE || (*ev).n != 4 {
        return false
    }
    let q: u64 = (*ev).params
    (*out).status = rt.ld8(q, 0) as u32
    (*out).handle = bt_le.le_get16(q, 1)
    (*out).reason = rt.ld8(q, 3) as u32
    return true
}

fn event_le_connection(ev: *mut HciEvent, out: *mut LeConnComplete) -> bool {
    if (*ev).code != EV_LE_META || (*ev).sub != LE_CONNECTION_COMPLETE || (*ev).n != 18 {
        return false
    }
    let q: u64 = (*ev).params
    (*out).status = rt.ld8(q, 0) as u32
    (*out).handle = bt_le.le_get16(q, 1)
    (*out).role = rt.ld8(q, 3) as u32
    (*out).peer_type = rt.ld8(q, 4) as u32
    (*out).peer = addr_get(q, 5)
    (*out).interval = bt_le.le_get16(q, 11)
    (*out).latency = bt_le.le_get16(q, 13)
    (*out).timeout = bt_le.le_get16(q, 15)
    (*out).clock_accuracy = rt.ld8(q, 17) as u32
    return true
}

fn event_conn_update(ev: *mut HciEvent, out: *mut ConnUpdate) -> bool {
    if (*ev).code != EV_LE_META || (*ev).sub != LE_CONNECTION_UPDATE_COMPLETE || (*ev).n != 9 {
        return false
    }
    let q: u64 = (*ev).params
    (*out).status = rt.ld8(q, 0) as u32
    (*out).handle = bt_le.le_get16(q, 1)
    (*out).interval = bt_le.le_get16(q, 3)
    (*out).latency = bt_le.le_get16(q, 5)
    (*out).timeout = bt_le.le_get16(q, 7)
    return true
}

fn event_ltk_request(ev: *mut HciEvent, handle: *mut u32, rand: *mut u64, ediv: *mut u32) -> bool {
    if (*ev).code != EV_LE_META || (*ev).sub != LE_LTK_REQUEST || (*ev).n != 12 {
        return false
    }
    let q: u64 = (*ev).params
    *handle = bt_le.le_get16(q, 0)
    *rand = bt_le.le_get64(q, 2)
    *ediv = bt_le.le_get16(q, 10)
    return true
}

fn event_adv_report_count(ev: *mut HciEvent) -> u32 {
    if (*ev).code != EV_LE_META || (*ev).sub != LE_ADVERTISING_REPORT || (*ev).n < 1 {
        return 0
    }
    return rt.ld8((*ev).params, 0) as u32
}

fn event_adv_report_next(ev: *mut HciEvent, pos: usize, out: *mut AdvReport) -> usize {
    var at: usize = pos
    if at == 0 {
        at = 1
    }
    if at + 9 > (*ev).n {
        return 0
    }
    let q: u64 = (*ev).params
    let dlen: usize = rt.ld8(q, at + 8) as usize
    if at + 9 + dlen + 1 > (*ev).n {
        return 0
    }
    (*out).kind = rt.ld8(q, at) as u32
    (*out).addr_type = rt.ld8(q, at + 1) as u32
    (*out).addr = addr_get(q, at + 2)
    (*out).dlen = dlen
    (*out).data = q + (at + 9) as u64
    let r: i32 = rt.ld8(q, at + 9 + dlen) as i32
    (*out).rssi = if r >= 128 { r - 256 } else { r }
    return at + 9 + dlen + 1
}

fn event_completed_packets_count(ev: *mut HciEvent) -> u32 {
    if (*ev).code != EV_NUMBER_OF_COMPLETED_PACKETS || (*ev).n < 1 {
        return 0
    }
    let k: u32 = rt.ld8((*ev).params, 0) as u32
    if (*ev).n != 1 + (k as usize) * 4 {
        return 0
    }
    return k
}

fn event_completed_packet_at(ev: *mut HciEvent, i: u32, handle: *mut u32, count: *mut u32) {
    let q: u64 = (*ev).params
    let at: usize = 1 + (i as usize) * 4
    *handle = bt_le.le_get16(q, at)
    *count = bt_le.le_get16(q, at + 2)
}
