// lib/bluetooth/bt_transport.fi -- bt_transport: HCI transport interface (function table) shared by all backends
import std.rt

export {
    Transport, TR_NONE, TR_LINUX_HCI, TR_UART, TR_FAKE, TR_REPLAY, TR_WINDOWS, TR_ANDROID,
    TR_OK, TR_ERR_UNSUPPORTED, TR_ERR_OPEN, TR_ERR_IO, TR_ERR_TIMEOUT,
    transport_closed, transport_send, transport_recv, transport_close, transport_is_open,
}

const TR_NONE: u32 = 0
const TR_LINUX_HCI: u32 = 1
const TR_UART: u32 = 2
const TR_FAKE: u32 = 3
const TR_REPLAY: u32 = 4
const TR_WINDOWS: u32 = 5
const TR_ANDROID: u32 = 6

const TR_OK: i32 = 0
const TR_ERR_UNSUPPORTED: i32 = -1
const TR_ERR_OPEN: i32 = -2
const TR_ERR_IO: i32 = -3
const TR_ERR_TIMEOUT: i32 = -4

struct Transport {
    kind: u32,
    ctx: u64,
    send: fn(u64, u64, usize) -> bool,
    recv: fn(u64, u64, usize, i32) -> i64,
    close: fn(u64),
}

fn closed_send(ctx: u64, p: u64, n: usize) -> bool {
    return false
}

fn closed_recv(ctx: u64, p: u64, cap: usize, timeout_ms: i32) -> i64 {
    return -1
}

fn closed_close(ctx: u64) {
}

fn transport_closed() -> Transport {
    return Transport { kind: TR_NONE, ctx: 0, send: closed_send, recv: closed_recv, close: closed_close }
}

fn transport_is_open(t: *mut Transport) -> bool {
    return (*t).kind != TR_NONE
}

fn transport_send(t: *mut Transport, p: u64, n: usize) -> bool {
    let f: fn(u64, u64, usize) -> bool = (*t).send
    return f((*t).ctx, p, n)
}

fn transport_recv(t: *mut Transport, p: u64, cap: usize, timeout_ms: i32) -> i64 {
    let f: fn(u64, u64, usize, i32) -> i64 = (*t).recv
    return f((*t).ctx, p, cap, timeout_ms)
}

fn transport_close(t: *mut Transport) {
    let f: fn(u64) = (*t).close
    f((*t).ctx)
    *t = transport_closed()
}
