// SPDX-License-Identifier: MPL-2.0
import std.rt

export {
    le_get16, le_get24, le_get32, le_get64, le_put8, le_put16, le_put24,
    le_put32, le_put64, le_put_raw, le_put_zero, le_patch16, le_bytes_eq,
    le_copy, NONE,
}

const NONE: usize = 18446744073709551615

fn le_get16(p: u64, i: usize) -> u32 {
    return rt.ld8(p, i) as u32 | ((rt.ld8(p, i + 1) as u32) << 8)
}

fn le_get24(p: u64, i: usize) -> u32 {
    return le_get16(p, i) | ((rt.ld8(p, i + 2) as u32) << 16)
}

fn le_get32(p: u64, i: usize) -> u32 {
    return le_get24(p, i) | ((rt.ld8(p, i + 3) as u32) << 24)
}

fn le_get64(p: u64, i: usize) -> u64 {
    return le_get32(p, i) as u64 | ((le_get32(p, i + 4) as u64) << 32)
}

fn le_put8(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255) as u8)
}

fn le_put16(b: *mut rt.Buf, v: u32) {
    le_put8(b, v)
    le_put8(b, v >> 8)
}

fn le_put24(b: *mut rt.Buf, v: u32) {
    le_put16(b, v)
    le_put8(b, v >> 16)
}

fn le_put32(b: *mut rt.Buf, v: u32) {
    le_put16(b, v & 65535)
    le_put16(b, v >> 16)
}

fn le_put64(b: *mut rt.Buf, v: u64) {
    le_put32(b, (v & 4294967295) as u32)
    le_put32(b, (v >> 32) as u32)
}

fn le_put_raw(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(b, p, n)
}

fn le_put_zero(b: *mut rt.Buf, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push(b, 0 as u8)
        i = i + 1
    }
}

fn le_patch16(b: *mut rt.Buf, at: usize, v: u32) {
    let p: u64 = rt.buf_ptr(b)
    rt.st8(p, at, (v & 255) as u8)
    rt.st8(p, at + 1, ((v >> 8) & 255) as u8)
}

fn le_bytes_eq(p: u64, q: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if rt.ld8(p, i) != rt.ld8(q, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn le_copy(dst: u64, src: u64, n: usize) {
    var i: usize = 0
    while i < n {
        rt.st8(dst, i, rt.ld8(src, i))
        i = i + 1
    }
}
