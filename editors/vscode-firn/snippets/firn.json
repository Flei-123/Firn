{
  "fn main": {
    "prefix": [
      "main",
      "fnmain"
    ],
    "body": [
      "fn main() {",
      "\tprintln(\"${1:hi}\")",
      "}"
    ],
    "description": "Program entry point"
  },
  "fn": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2}) -> ${3:i32} {",
      "\t$0",
      "}"
    ],
    "description": "Function"
  },
  "for range": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "\t$0",
      "}"
    ],
    "description": "Counting loop"
  },
  "for in": {
    "prefix": "for",
    "body": [
      "for ${1:x} in ${2:xs} {",
      "\t$0",
      "}"
    ],
    "description": "Loop over a collection"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:cond} {",
      "\t$0",
      "}"
    ],
    "description": "While loop"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:cond} {",
      "\t$0",
      "}"
    ],
    "description": "If"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if ${1:cond} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "If / else"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "\t${2:field}: ${3:i32},",
      "}"
    ],
    "description": "Struct"
  },
  "impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:Name} {",
      "\tfn ${2:method}(*self) -> ${3:i32} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Impl block"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t${2:A},",
      "\t${3:B},",
      "}"
    ],
    "description": "Enum"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t$0",
      "}"
    ],
    "description": "Match"
  },
  "Vec": {
    "prefix": "vec",
    "body": [
      "let ${1:v} = Vec[${2:int}].new()",
      "${1:v}.push(${3:1})"
    ],
    "description": "Vec with a push"
  },
  "Map": {
    "prefix": "map",
    "body": [
      "let ${1:m} = Map[${2:str}, ${3:int}].new()",
      "${1:m}.set(${4:\"key\"}, ${5:1})"
    ],
    "description": "Map with a set"
  },
  "f-string": {
    "prefix": [
      "fstr",
      "fs"
    ],
    "body": [
      "f\"${1:text} {${2:value}}\""
    ],
    "description": "Interpolated string"
  },
  "println": {
    "prefix": [
      "pl",
      "println"
    ],
    "body": [
      "println(${1:\"$2\"})"
    ],
    "description": "Print a line"
  },
  "println f-string": {
    "prefix": "plf",
    "body": [
      "println(f\"${1:text} {${2:value}}\")"
    ],
    "description": "Print an interpolated line"
  },
  "test": {
    "prefix": "test",
    "body": [
      "#[test]",
      "fn ${1:it_works}() {",
      "\ttestkit.assert_eq_i64(${2:1 + 1}, ${3:2})",
      "}"
    ],
    "description": "Test function (import std.testkit)"
  },
  "import": {
    "prefix": "import",
    "body": [
      "import std.${1:io}"
    ],
    "description": "Import a std module"
  },
  "let": {
    "prefix": "let",
    "body": [
      "let ${1:name}: ${2:i32} = ${3:0}"
    ],
    "description": "Immutable binding"
  },
  "var": {
    "prefix": "var",
    "body": [
      "var ${1:name}: ${2:i32} = ${3:0}"
    ],
    "description": "Mutable binding"
  }
}
