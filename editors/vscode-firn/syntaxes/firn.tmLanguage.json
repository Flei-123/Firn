{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Firn",
  "scopeName": "source.firn",
  "fileTypes": ["fi"],
  "comment": "TextMate grammar for the Firn language. License: MPL-2.0 (same as the whole Firn repository, see LICENSING.md; MPL-2.0 is on the Linguist allow-list). Derived from compiler/src/lexer.rs and compiler/src/strings.rs.",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#attributes"},
    {"include": "#declarations"},
    {"include": "#keywords"},
    {"include": "#numbers"},
    {"include": "#types"},
    {"include": "#functions"},
    {"include": "#operators"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {"name": "comment.line.shebang.firn", "match": "\\A#!.*$"},
        {"name": "comment.line.double-slash.firn", "match": "//.*$"},
        {"name": "comment.block.firn", "begin": "/\\*", "end": "\\*/", "patterns": [{"include": "#nested-block"}]}
      ]
    },
    "nested-block": {
      "name": "comment.block.firn",
      "begin": "/\\*", "end": "\\*/",
      "patterns": [{"include": "#nested-block"}]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.firn",
          "begin": "\\bf\"", "end": "\"",
          "patterns": [
            {"include": "#escapes"},
            {"name": "constant.character.escape.brace.firn", "match": "\\{\\{|\\}\\}"},
            {"name": "meta.interpolation.firn", "begin": "\\{", "end": "\\}",
             "beginCaptures": {"0": {"name": "punctuation.section.embedded.begin.firn"}},
             "endCaptures": {"0": {"name": "punctuation.section.embedded.end.firn"}},
             "patterns": [{"include": "$self"}]}
          ]
        },
        {
          "name": "string.quoted.double.firn",
          "begin": "(?:\\b[bu])?\"", "end": "\"",
          "patterns": [{"include": "#escapes"}]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.firn",
      "match": "\\\\(?:[nrt0\\\\\"'{}]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\})"
    },
    "attributes": {
      "name": "meta.attribute.firn",
      "begin": "#\\[", "end": "\\]",
      "beginCaptures": {"0": {"name": "punctuation.definition.attribute.begin.firn"}},
      "endCaptures": {"0": {"name": "punctuation.definition.attribute.end.firn"}},
      "patterns": [
        {"name": "entity.other.attribute-name.firn", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"},
        {"include": "#strings"},
        {"include": "#numbers"}
      ]
    },
    "declarations": {
      "patterns": [
        {"match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
         "captures": {"1": {"name": "keyword.declaration.function.firn"}, "2": {"name": "entity.name.function.firn"}}},
        {"match": "\\b(struct|enum|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
         "captures": {"1": {"name": "keyword.declaration.type.firn"}, "2": {"name": "entity.name.type.firn"}}},
        {"match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(for)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
         "captures": {"1": {"name": "keyword.declaration.impl.firn"}, "2": {"name": "entity.name.type.firn"}, "3": {"name": "keyword.other.for.firn"}, "4": {"name": "entity.name.type.firn"}}},
        {"match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_.]*)",
         "captures": {"1": {"name": "keyword.control.import.firn"}, "2": {"name": "entity.name.namespace.firn"}}},
        {"match": "\\b(const|static)\\s+([A-Za-z_][A-Za-z0-9_]*)",
         "captures": {"1": {"name": "storage.modifier.firn"}, "2": {"name": "variable.other.constant.firn"}}}
      ]
    },
    "keywords": {
      "patterns": [
        {"name": "keyword.control.firn", "match": "\\b(if|else|while|for|in|match|return|break|continue|defer|errdefer|try|catch)\\b"},
        {"name": "keyword.other.firn", "match": "\\b(fn|let|var|struct|enum|const|static|profile|as|extern|comptime|import|export|error|syscall)\\b"},
        {"name": "storage.modifier.mut.firn", "match": "\\bmut\\b"},
        {"name": "constant.language.boolean.firn", "match": "\\b(true|false)\\b"}
      ]
    },
    "numbers": {
      "patterns": [
        {"name": "constant.numeric.hex.firn", "match": "\\b0[xX][0-9A-Fa-f_]+(?:[iu](?:8|16|32|64)|usize|isize)?\\b"},
        {"name": "constant.numeric.binary.firn", "match": "\\b0[bB][01_]+(?:[iu](?:8|16|32|64)|usize|isize)?\\b"},
        {"name": "constant.numeric.float.firn", "match": "\\b[0-9][0-9_]*(?:\\.[0-9][0-9_]*(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)(?:f32|f64|f)?\\b"},
        {"name": "constant.numeric.integer.firn", "match": "\\b[0-9][0-9_]*(?:[iu](?:8|16|32|64)|usize|isize|f)?\\b"}
      ]
    },
    "types": {
      "patterns": [
        {"name": "support.type.primitive.firn", "match": "\\b(int|uint|i8|i16|i32|i64|u8|u16|u32|u64|usize|isize|f32|f64|float|double|bool|str|octet|void)\\b"},
        {"name": "entity.name.type.firn", "match": "\\b[A-Z][A-Za-z0-9_]*\\b"}
      ]
    },
    "functions": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "name": "entity.name.function.call.firn"
    },
    "operators": {
      "patterns": [
        {"name": "keyword.operator.range.firn", "match": "\\.\\.=?"},
        {"name": "keyword.operator.arrow.firn", "match": "->|=>"},
        {"name": "keyword.operator.wrapping.firn", "match": "[+\\-*]\\|"},
        {"name": "keyword.operator.comparison.firn", "match": "==|!=|<=|>=|<|>"},
        {"name": "keyword.operator.logical.firn", "match": "&&|\\|\\||!"},
        {"name": "keyword.operator.assignment.firn", "match": "(?:<<|>>|[+\\-*/%&|^])?="},
        {"name": "keyword.operator.arithmetic.firn", "match": "<<|>>|[+\\-*/%&|^~]"}
      ]
    }
  }
}
