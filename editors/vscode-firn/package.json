{
  "name": "vscode-firn",
  "displayName": "Firn",
  "description": "Syntax highlighting and debugging (gdb via DAP) for the Firn language (.fi)",
  "version": "0.1.0",
  "publisher": "firn",
  "license": "MPL-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "firn",
        "aliases": [
          "Firn",
          "firn"
        ],
        "extensions": [
          ".fi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "firn",
        "scopeName": "source.firn",
        "path": "./syntaxes/firn.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "firn"
      }
    ],
    "debuggers": [
      {
        "type": "firn",
        "label": "Firn (gdb)",
        "languages": [
          "firn"
        ],
        "program": "../../tools/dap/dap_server.py",
        "runtime": "python3",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Executable built with firnc --no-opt"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "firn",
            "request": "launch",
            "name": "Debug Firn program",
            "program": "${workspaceFolder}/out/app",
            "stopOnEntry": false
          }
        ]
      }
    ]
  }
}
