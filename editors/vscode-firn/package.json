{
  "name": "vscode-firn",
  "displayName": "Firn",
  "description": "Firn (.fi) language support: diagnostics, completion, hover, go to definition, format on save, run with F5, tasks, snippets",
  "version": "0.2.0",
  "publisher": "firn",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/firn-lang/firn"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "firn",
    "fi"
  ],
  "activationEvents": [
    "onLanguage:firn",
    "workspaceContains:**/firn.package"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "test": "node --test test/",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "3.2.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "firn",
        "aliases": [
          "Firn",
          "firn"
        ],
        "extensions": [
          ".fi"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "firn",
        "scopeName": "source.firn",
        "path": "./syntaxes/firn.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "firn",
        "path": "./snippets/firn.json"
      }
    ],
    "configurationDefaults": {
      "[firn]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "firn.vscode-firn",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "configuration": {
      "title": "Firn",
      "properties": {
        "firn.path": {
          "type": "string",
          "default": "",
          "description": "Path to the `firn` command. Empty: `firn` from PATH."
        },
        "firn.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to `firnc` (also starts the language server). Empty: `firnc` from PATH."
        },
        "firn.formatterPath": {
          "type": "string",
          "default": "",
          "description": "Path to the `firnfmt` binary. Empty: asked from `firn doctor`."
        },
        "firn.libPath": {
          "type": "string",
          "default": "",
          "description": "Standard library directory (FIRNLIB). Empty: the library next to the compiler."
        },
        "firn.optLevel": {
          "type": "string",
          "default": "dev-fast",
          "enum": [
            "dev-fast",
            "release-safe",
            "release-fast"
          ],
          "description": "Optimisation level for Run (FIRN_OPT)."
        },
        "firn.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Save all files before Run, Build and Test."
        },
        "firn.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the language server (`firnc --lsp`)."
        }
      }
    },
    "commands": [
      {
        "command": "firn.run",
        "title": "Firn: Run",
        "icon": "$(play)"
      },
      {
        "command": "firn.build",
        "title": "Firn: Build"
      },
      {
        "command": "firn.test",
        "title": "Firn: Test"
      },
      {
        "command": "firn.check",
        "title": "Firn: Check"
      },
      {
        "command": "firn.formatCheck",
        "title": "Firn: Check Formatting"
      },
      {
        "command": "firn.newProject",
        "title": "Firn: New Project"
      },
      {
        "command": "firn.restartServer",
        "title": "Firn: Restart Language Server"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "firn.run",
          "when": "resourceLangId == firn",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "firn.run",
          "when": "editorLangId == firn"
        }
      ]
    },
    "keybindings": [
      {
        "command": "firn.run",
        "key": "f5",
        "when": "editorTextFocus && editorLangId == firn"
      },
      {
        "command": "firn.build",
        "key": "ctrl+shift+b",
        "when": "editorLangId == firn"
      }
    ],
    "taskDefinitions": [
      {
        "type": "firn",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "build",
              "test",
              "check",
              "fmt"
            ],
            "description": "The firn sub-command."
          },
          "target": {
            "type": "string",
            "description": "File or project directory. Default: the project of the workspace."
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "firnc",
        "owner": "firnc",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|warning): (.*)$",
            "severity": 1,
            "message": 2
          },
          {
            "regexp": "^\\s*--> (.+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ]
  }
}
