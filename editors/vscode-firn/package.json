{
  "name": "vscode-firn",
  "displayName": "Firn",
  "description": "Syntax highlighting for the Firn language (.fi)",
  "version": "0.1.0",
  "publisher": "firn",
  "license": "MPL-2.0",
  "private": true,
  "engines": {"vscode": "^1.60.0"},
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [{
      "id": "firn",
      "aliases": ["Firn", "firn"],
      "extensions": [".fi"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "firn",
      "scopeName": "source.firn",
      "path": "./syntaxes/firn.tmLanguage.json"
    }]
  }
}
