// expect_out: 12 14 3
// beispiele/pakete/anwendung — baut mit
//     firnc --paket beispiele/pakete/anwendung
//
// 'geo' und 'text' sind Abhaengigkeiten aus firn.paket; 'geo.punkt' ist ein
// oeffentliches Modul des Pakets 'geo'. 'geo.innen' waere ein Fehler.
import geo
import geo.punkt
import text
import hilfe

fn main() -> i32 {
    let r: geo.Rechteck = geo.rechteck_neu(1, 2, 3, 4)
    text.schreib_zahl(geo.flaeche(r))          // 12
    hilfe.trenner()
    text.schreib_zahl(geo.umfang(r))           // 14
    hilfe.trenner()
    text.schreib_zahl(punkt.summe(punkt.punkt_neu(1, 2)))   // 3
    text.schreib_zeile()
    return 0
}
