// geo.innen — PRIVAT. Steht nicht in der 'oeffentlich'-Liste von
// beispiele/pakete/geo/firn.paket und ist deshalb nur INNERHALB des Pakets
// 'geo' einbindbar. Wer es von aussen versucht, bekommt eine Meldung mit
// dem Hinweis, wo er es freischalten muesste.
export { verdopple }

fn verdopple(a: i32) -> i32 {
    return a + a
}
