// geo — das Hauptmodul des Pakets. Bindet ein oeffentliches ('punkt') und
// ein privates ('innen') Modul desselben Pakets ein; INNERHALB eines Pakets
// gibt es keine Schranke.
import punkt
import innen

export { Rechteck, rechteck_neu, flaeche, umfang, ecksumme }

struct Rechteck { ecke: punkt.Punkt, breite: i32, hoehe: i32 }

fn rechteck_neu(x: i32, y: i32, b: i32, h: i32) -> Rechteck {
    return Rechteck{ ecke: punkt.punkt_neu(x, y), breite: b, hoehe: h }
}

fn flaeche(r: Rechteck) -> i32 {
    return r.breite * r.hoehe
}

fn umfang(r: Rechteck) -> i32 {
    // ueber das private Modul: 2*(b+h)
    return innen.verdopple(r.breite + r.hoehe)
}

fn ecksumme(r: Rechteck) -> i32 {
    return punkt.summe(r.ecke)
}
