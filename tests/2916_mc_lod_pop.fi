// expect_exit: 0
// tests/2916_mc_lod_pop.fi -- LOD ring transitions: error against the full-detail image along a flight (r78).
// A  stream with the mid ring (lod_bin_mid = 2) is not worse than the one without (bin 1 -> 4 directly) against the converged
//    full-detail image (mean differing pixels), and the frame-to-frame change of that error ("pop") does not grow
// B  the mid ring really exists (a column at the right distance has bin 2)
// Numbers go to stderr (they do not depend on timing: every frame is flushed, but they depend on the mesher).
import std.rt
import std.io
import mc.mc_chunk
import mc.mc_world
import mc.mc_mesh
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_backend
import mc.mc_terrain
import mc.mc_render_world
import mc.mc_stream

const NSEC: i32 = 6
const R: i32 = 9 // loaded columns: -R..R
const DIST: i32 = 2 // full detail radius
const CLEAR: u32 = 0xFF3C2814 as u32

fn check(c: bool, code: i32) {
    if !c {
        io.fmt_print_line(f"FAIL code {code}")
        rt.finish(code as i64)
    }
}

fn fl(v: f64) -> i32 {
    var x: i32 = v as i32
    if (x as f64) > v { x = x - 1 }
    return x
}

#[allow_escape]
fn load_all(w: *mut mc_world.World, s: *mut mc_stream.Stream, ids: u64) {
    var cz: i32 = 0 - R
    while cz <= R {
        var cx: i32 = 0 - R
        while cx <= R {
            mc_terrain.terrain_column(cx, cz, NSEC, ids)
            check(mc_world.world_put(w, mc_render_world.wr_make_chunk(cx, cz, NSEC as usize, ids)), 50)
            check(mc_stream.stream_chunk_loaded(s, w, cx, cz), 51)
            cx = cx + 1
        }
        cz = cz + 1
    }
}

fn fresh_raster(a: *mut mc_texture.Atlas) -> mc_raster.Raster {
    var r: mc_raster.Raster = mc_raster.raster_new(96, 54)
    mc_raster.backend_upload_atlas(&r, a)
    return r
}

#[allow_escape]
fn frame(s: *mut mc_stream.Stream, w: *mut mc_world.World, b: *mut mc_backend.Backend, cam: *mut mc_camera.Camera) -> u64 {
    (*b).begin((*b).obj, cam as u64, CLEAR)
    let tris: u64 = mc_stream.stream_frame(s, w, b, cam)
    (*b).end((*b).obj)
    return tris
}

fn pose(cam: *mut mc_camera.Camera, x: f64, z: f64) {
    let y: f64 = (mc_terrain.terrain_height(fl(x), fl(z), NSEC) + 8) as f64
    mc_camera.camera_set_pos(cam, x, y, z)
    mc_camera.camera_look_at(cam, x + 60.0, y - 6.0, z + 6.0)
    mc_camera.camera_update(cam)
}

fn ch_diff(a: u32, b: u32) -> i32 {
    var d: i32 = 0
    var sh: u32 = 0 as u32
    while sh < 24 as u32 {
        let x: i32 = ((a >> sh) & 255 as u32) as i32
        let y: i32 = ((b >> sh) & 255 as u32) as i32
        if x > y { d = d + x - y } else { d = d + y - x }
        sh = sh + 8 as u32
    }
    return d
}

// pixels that differ clearly (channel sum > 60)
fn diff_px(a: *mut mc_raster.Raster, b: *mut mc_raster.Raster) -> i32 {
    var n: i32 = 0
    var y: i32 = 0
    while y < 54 {
        var x: i32 = 0
        while x < 96 {
            if ch_diff(mc_raster.raster_pixel(a, x, y), mc_raster.raster_pixel(b, x, y)) > 60 { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

#[allow_escape]
fn main() -> i32 {
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_terrain.terrain_tables(&tb)
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    let ids: u64 = rt.heap_alloc(NSEC as usize * 4096 * 2)
    var cam: mc_camera.Camera = mc_camera.camera_new(96, 54)
    mc_camera.camera_set_lens(&cam, 70.0, 0.05, 900.0)
    // truth: everything full detail
    var rt0: mc_raster.Raster = fresh_raster(&a)
    var bt: mc_backend.Backend = mc_backend.backend_cpu(&rt0)
    var wt: mc_world.World = mc_world.world_new()
    var st: mc_stream.Stream = mc_stream.stream_new(0, NSEC, R, &tb, 0)
    st.nbr_wait = 3 as u32
    // no mid ring
    var r0: mc_raster.Raster = fresh_raster(&a)
    var b0: mc_backend.Backend = mc_backend.backend_cpu(&r0)
    var w0: mc_world.World = mc_world.world_new()
    var s0: mc_stream.Stream = mc_stream.stream_new(0, NSEC, DIST, &tb, 0)
    s0.lod_dist = R
    s0.lod_bin_mid = 0
    s0.nbr_wait = 3 as u32
    // mid ring (defaults)
    var r1: mc_raster.Raster = fresh_raster(&a)
    var b1: mc_backend.Backend = mc_backend.backend_cpu(&r1)
    var w1: mc_world.World = mc_world.world_new()
    var s1: mc_stream.Stream = mc_stream.stream_new(0, NSEC, DIST, &tb, 0)
    s1.lod_dist = R
    s1.nbr_wait = 3 as u32
    load_all(&wt, &st, ids)
    load_all(&w0, &s0, ids)
    load_all(&w1, &s1, ids)
    var f: i32 = 0
    var sum0: i32 = 0
    var sum1: i32 = 0
    var pop0: i32 = 0
    var pop1: i32 = 0
    var last0: i32 = 0
    var last1: i32 = 0
    var saw_mid: bool = false
    while f < 40 {
        let x: f64 = 0.0 - 100.0 + (f as f64) * 2.0
        pose(&cam, x, 4.0)
        mc_stream.stream_flush(&st, &wt, &bt, &cam, 400)
        mc_stream.stream_flush(&s0, &w0, &b0, &cam, 400)
        mc_stream.stream_flush(&s1, &w1, &b1, &cam, 400)
        frame(&st, &wt, &bt, &cam)
        frame(&s0, &w0, &b0, &cam)
        frame(&s1, &w1, &b1, &cam)
        let e0: i32 = diff_px(&r0, &rt0)
        let e1: i32 = diff_px(&r1, &rt0)
        sum0 = sum0 + e0
        sum1 = sum1 + e1
        if f > 0 {
            if e0 > last0 { pop0 = pop0 + e0 - last0 } else { pop0 = pop0 + last0 - e0 }
            if e1 > last1 { pop1 = pop1 + e1 - last1 } else { pop1 = pop1 + last1 - e1 }
        }
        last0 = e0
        last1 = e1
        // column of the camera + DIST + hyst + 3 should be bin 2 in s1 (inside the mid ring)
        let ccx: i32 = fl(x / 16.0)
        if mc_stream.stream_lod_bin(&s1, ccx + DIST + 3, 0) == 2 { saw_mid = true }
        f = f + 1
    }
    io.fmt_eprint_line(f"LODPOP no-mid: err sum {sum0} pop {pop0} | mid: err sum {sum1} pop {pop1} (40 frames, 5184 px)")
    check(saw_mid, 1)
    check(sum1 <= sum0 + 40, 2)
    check(pop1 <= pop0 + 40, 3)
    mc_stream.stream_free(&st, &bt)
    mc_stream.stream_free(&s0, &b0)
    mc_stream.stream_free(&s1, &b1)
    mc_world.world_free(&wt)
    mc_world.world_free(&w0)
    mc_world.world_free(&w1)
    io.fmt_print_line(f"ok")
    return 0
}
