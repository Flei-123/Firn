// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_lightning
import mc.mc_entity
import mc.mc_registry
import mc.mc_sem
import mc.mc_sky
import mc.mc_version
import mc.v763.mc_proto_v763
import mc.v763.mc_reg_v763

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn entity_type(reg: *mut mc_registry.Registry, name: str) -> i32 {
    var i: i32 = 0
    while i < mc_registry.reg_entity_count(reg) {
        var nl: usize = 0
        let np: u64 = mc_registry.reg_entity_name(reg, i, &nl)
        if nl == name.n && rt.mem_eq(np, name.p as u64, nl) { return mc_registry.reg_entity_id(reg, i) }
        i = i + 1
    }
    return 0 - 1
}

fn spawn(s: *mut mc_entity.Store, ver: *mut mc_version.Version, id: i32, ty: i32, x: f64, y: f64, z: f64) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, id)
    bytes.put_uuid(&b, 1 as u64, id as u64)
    bytes.put_varint(&b, ty)
    bytes.put_f64(&b, x)
    bytes.put_f64(&b, y)
    bytes.put_f64(&b, z)
    bytes.put_i8(&b, 0 as i8)
    bytes.put_u8(&b, 0 as u8)
    bytes.put_i8(&b, 0 as i8)
    bytes.put_varint(&b, 0)
    bytes.put_i16(&b, 0 as i16)
    bytes.put_i16(&b, 0 as i16)
    bytes.put_i16(&b, 0 as i16)
    bytes.bytes_set_pos(&b, 0)
    let r: bool = mc_entity.entity_on_packet(s, ver, (*ver).sem[mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY], &b)
    bytes.bytes_clear(&b)
    return r
}

fn main() -> i32 {
    var reg: mc_registry.Registry = mc_reg_v763.registry_make()
    var ver: mc_version.Version = mc_proto_v763.version_make()
    var s: mc_entity.Store = mc_entity.store_new()
    let bolt: i32 = entity_type(&reg, "lightning_bolt")
    let cow: i32 = entity_type(&reg, "cow")
    check(bolt >= 0 && cow >= 0 && bolt != cow, 1)

    var l: mc_lightning.Lightning = mc_lightning.lightning_new()
    check(mc_lightning.lightning_poll(&l, &s, &reg, 100 as u64) == 0, 2)
    check(mc_lightning.lightning_flash_milli(&l, 100 as u64) == 0, 3)
    check(spawn(&s, &ver, 40, cow, 1.0, 2.0, 3.0), 4)
    check(mc_lightning.lightning_poll(&l, &s, &reg, 200 as u64) == 0, 5)
    check(spawn(&s, &ver, 41, bolt, 10.5, 64.0, 0.0 - 7.5), 6)
    check(mc_lightning.lightning_poll(&l, &s, &reg, 300 as u64) == 1, 7)
    check(l.nx[0] == 10.5 && l.ny[0] == 64.0 && l.nz[0] == 0.0 - 7.5 && l.n_bolts == 1 as u64, 8)
    check(mc_lightning.lightning_flash_milli(&l, 300 as u64) == 1000, 9)
    check(mc_lightning.lightning_poll(&l, &s, &reg, 350 as u64) == 0, 10)
    check(mc_lightning.lightning_flash_milli(&l, 350 as u64) == 1000 && l.n_bolts == 1 as u64, 11)
    check(spawn(&s, &ver, 42, bolt, 0.0, 70.0, 0.0), 12)
    check(mc_lightning.lightning_poll(&l, &s, &reg, 400 as u64) == 1 && l.n_bolts == 2 as u64, 13)

    mc_entity.store_clear(&s)
    check(mc_lightning.lightning_poll(&l, &s, &reg, 500 as u64) == 0, 14)
    check(mc_lightning.lightning_flash_milli(&l, 400 as u64) == 1000, 15)
    check(mc_lightning.lightning_flash_milli(&l, 475 as u64) == 500, 16)
    check(mc_lightning.lightning_flash_milli(&l, 550 as u64) == 0, 17)
    mc_lightning.lightning_reset(&l)
    check(mc_lightning.lightning_flash_milli(&l, 401 as u64) == 0, 18)

    var sk: mc_sky.Sky = mc_sky.sky_new()
    mc_sky.sky_set_time(&sk, 6000 as i64, 128)
    let zr0: i32 = sk.zr
    let zb0: i32 = sk.zb
    let tr0: i32 = sk.tr
    mc_sky.sky_set_flash(&sk, 0)
    check(sk.zr == zr0 && sk.tr == tr0, 19)
    mc_sky.sky_set_flash(&sk, 1000)
    check(sk.zr > zr0 && sk.zb > zb0 && sk.tr == 256 && sk.fr == sk.hr, 20)
    mc_sky.sky_set_time(&sk, 6000 as i64, 256)
    let lum_dry: i32 = sk.zr + sk.zg + sk.zb
    let tg0: i32 = sk.tg
    mc_sky.sky_set_thunder(&sk, 0)
    check(sk.zr + sk.zg + sk.zb == lum_dry && sk.tg == tg0, 21)
    mc_sky.sky_set_thunder(&sk, 1000)
    check(sk.zr + sk.zg + sk.zb < lum_dry && sk.tg < tg0 && sk.fg == sk.hg, 22)
    check(sk.zr >= 0 && sk.zg >= 0 && sk.zb >= 0 && sk.hr >= 0 && sk.tr >= 0, 23)
    return 0
}
