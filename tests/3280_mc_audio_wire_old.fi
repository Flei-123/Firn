// expect_exit: 0
// mca_on_packet on pre-1.14 packets (1.12.2): World Event position is x26 y12 z26 (1.14+: x26 z26 y12). Bodies are real vanilla
// 1.12.2 / 1.16.5 captures (tools/mc/audio/fixtures/sounds_1_12_2.jsonl / sounds_1_16_5.jsonl).
import std.rt
import std.io
import std.bytes
import audio.engine
import mc.mc_audio
import mc.mc_version
import mc.mc_sem
import mc.mc_entity
import mc.v340.mc_proto_v340
import mc.v754.mc_proto_v754

struct T { fails: i32 }

fn check(t: *mut T, ok: bool, what: str) {
    if ok {
        io.fmt_print(f"ok   {what}\n")
    } else {
        io.fmt_print(f"FAIL {what}\n")
        (*t).fails = (*t).fails + 1
    }
}

// World Event body: effect, packed position, data, global flag
fn world_event(pos: u64, eff: i32) -> bytes.Bytes {
    var pk: bytes.Bytes = bytes.bytes_new()
    bytes.put_i32(&pk, eff)
    bytes.put_i64(&pk, pos as i64)
    bytes.put_i32(&pk, 1)
    bytes.put_u8(&pk, 0 as u8)
    return pk
}

#[allow_escape]
fn main(start: u64) -> i32 {
    var t: T = T { fails: 0 }
    var e: engine.Engine = engine.engine_new(48000 as u32, 64 as u32)
    var m: mc_audio.McAudio = mc_audio.mca_new(&e)
    var v12: mc_version.Version = mc_proto_v340.version_make()
    var v16: mc_version.Version = mc_proto_v754.version_make()
    let wid12: i32 = v12.sem[mc_sem.SEM_PLAY_S2C_WORLD_EVENT]
    let wid16: i32 = v16.sem[mc_sem.SEM_PLAY_S2C_WORLD_EVENT]
    check(&t, wid12 == 33 && wid16 == 33, "world event wire id 33 on 1.12.2 and 1.16.5 (real servers)")
    // door open (1006) at (206, 67, 255): real 1.12.2 layout 000033810c0000ff = x 206 << 38 | y 67 << 26 | z 255
    let p12: u64 = ((206 as u64) << 38 as u64) | ((67 as u64) << 26 as u64) | (255 as u64)
    var pk: bytes.Bytes = world_event(p12, 1006)
    check(&t, mc_audio.mca_on_packet(&m, &v12, wid12, &pk, 0 as *mut mc_entity.Store) && m.n_bad == 0 as u64 && m.n_pkt == 1 as u64, "1.12.2 world event decodes (x26 y12 z26)")
    // 1.16.5 layout x26 z26 y12 (real capture 00000f0000088044 = x 60 z 136 y 68)
    let p16: u64 = ((60 as u64) << 38 as u64) | ((136 as u64) << 12 as u64) | (68 as u64)
    var pk2: bytes.Bytes = world_event(p16, 1006)
    check(&t, mc_audio.mca_on_packet(&m, &v16, wid16, &pk2, 0 as *mut mc_entity.Store) && m.n_bad == 0 as u64 && m.n_pkt == 2 as u64, "1.16.5 world event decodes (x26 z26 y12)")
    // truncated body counts as bad
    var pk3: bytes.Bytes = bytes.bytes_new()
    bytes.put_i32(&pk3, 1006)
    check(&t, mc_audio.mca_on_packet(&m, &v12, wid12, &pk3, 0 as *mut mc_entity.Store) && m.n_bad == 1 as u64, "truncated world event counted bad")
    io.fmt_print(f"{t.fails} failed\n")
    return t.fails
}
