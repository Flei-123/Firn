// expect_out: 65536 2048 2049 0 1114112 0
// GENERATED by tools/strlib/expand.py from tools/strlib/src/303_wtf8_roundtrip.fi -- do not edit by hand.
// WTF-8 is the lossless bridge (SPEC 8.2): Str16 -> WTF-8 -> Str16 has to come
// back bit-identical for EVERY code unit 0..0xFFFF, the 2048 surrogates
// included. At the same time it is counted for how many of them `to_utf8()`
// MUST fail (exactly the surrogates) and how often `to_utf8_lossy()` yields U+FFFD.
// After that the same for all code points 0..0x10FFFF through Str16 pairs.
// lib/str/alloc.fi -- memory without libc (module str).
//
// Stage 0 has neither global variables nor aggregates across function
// boundaries; that is why the whole library works with pointers to
// structures held by the caller. The memory comes straight from mmap(2).
//
// Include:  //#include lib/str/alloc.fi

// ROUND 73: the pure memory work (copy/compare/zero, ld*/st*, page_round)
// moved to `lib/str/core_mem.fi` -- it is the part that a freestanding
// kernel may use. Everything that is LEFT here needs the operating
// system: mmap, munmap, write. Whoever includes this file gets both, so
// no existing caller notices the cut.
// lib/str/core_mem.fi -- memory work WITHOUT the operating system (round 73).
//
// The pure half of `lib/str/alloc.fi`: copying, comparing, zeroing and the
// raw load/store helpers for the 8/16/32/64 bit elements of a block.
// Not one of these functions asks anybody for memory and not one of them
// makes a system call -- they work on memory that the CALLER already
// holds. That is exactly the line along which round 73 cuts the library
// (docs/ROUND73.md): whatever stands here may be used under
// `profile kernel`.
//
// `page_round` stands here as well although it smells of mmap: it is
// arithmetic on a number and nothing else. Whoever rounds a length to
// pages has not yet asked for a single page.
//
// Include:  //#include lib/str/core_mem.fi

fn page_round(n: usize) -> usize {
    return (n + 4095) / 4096 * 4096
}

fn mem_copy(dst: *mut u8, src: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = *((src as usize + i) as *mut u8)
        i = i + 1
    }
}

fn mem_zero(dst: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = 0 as u8
        i = i + 1
    }
}

fn mem_eq(a: *mut u8, b: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if *((a as usize + i) as *mut u8) != *((b as usize + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

// Raw read/write helpers for the 16/32/64 bit elements of a block.
fn ld16(p: *mut u8, i: usize) -> u16 {
    return *((p as usize + i * 2) as *mut u16)
}
fn st16(p: *mut u8, i: usize, v: u16) {
    *((p as usize + i * 2) as *mut u16) = v
}
fn ld32(p: *mut u8, i: usize) -> u32 {
    return *((p as usize + i * 4) as *mut u32)
}
fn st32(p: *mut u8, i: usize, v: u32) {
    *((p as usize + i * 4) as *mut u32) = v
}
fn ld64(p: *mut u8, i: usize) -> u64 {
    return *((p as usize + i * 8) as *mut u64)
}
fn st64(p: *mut u8, i: usize, v: u64) {
    *((p as usize + i * 8) as *mut u64) = v
}
fn ld8(p: *mut u8, i: usize) -> u8 {
    return *((p as usize + i) as *mut u8)
}
fn st8(p: *mut u8, i: usize, v: u8) {
    *((p as usize + i) as *mut u8) = v
}

const SYS_WRITE: i64 = 1
const SYS_READ: i64 = 0
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const SYS_EXIT: i64 = 60
const PROT_READ_WRITE: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34

// Returns n contiguous bytes (zero initialized) or 0 on failure.
fn heap_alloc(n: usize) -> *mut u8 {
    if n == 0 {
        return 0 as *mut u8
    }
    let len: usize = page_round(n)
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
    // mmap reports failure as -1..-4095
    if r < 0 && r > -4096 {
        return 0 as *mut u8
    }
    return r as *mut u8
}

fn heap_free(p: *mut u8, n: usize) {
    if p as usize != 0 {
        syscall(SYS_MUNMAP, p as i64, page_round(n) as i64)
    }
}

fn write_all(fd: i64, p: *mut u8, n: usize) {
    var off: usize = 0
    while off < n {
        let r: i64 = syscall(SYS_WRITE, fd, (p as usize + off) as i64, (n - off) as i64)
        if r <= 0 {
            return
        }
        off = off + r as usize
    }
}

// lib/str/bytes.fi -- `Bytes` (raw octets) and `Str` (validated UTF-8).
//
// The layout is a contract (SPEC 8.1, PLAN 3.3):
//     Bytes { ptr: *mut u8, len: usize, cap: usize }
//     Str   has the same layout, its content is additionally validated UTF-8.
//
// `Bytes` NEVER turns into text silently: the conversion goes exclusively
// through `bytes_to_str` (which validates) or `str_from_bytes_lossy`.
//
// Include:  //#include lib/str/bytes.fi   (needs lib/str/alloc.fi)

struct Bytes {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

fn bytes_init(b: *mut Bytes) {
    (*b).ptr = 0 as *mut u8
    (*b).len = 0
    (*b).cap = 0
}

fn bytes_free(b: *mut Bytes) {
    heap_free((*b).ptr, (*b).cap)
    bytes_init(b)
}

fn bytes_reserve(b: *mut Bytes, need: usize) {
    if (*b).cap >= need {
        return
    }
    var cap: usize = (*b).cap
    if cap == 0 {
        cap = 32
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    if (*b).len > 0 {
        mem_copy(p, (*b).ptr, (*b).len)
    }
    heap_free((*b).ptr, (*b).cap)
    (*b).ptr = p
    (*b).cap = cap
}

fn bytes_push(b: *mut Bytes, v: u8) {
    bytes_reserve(b, (*b).len + 1)
    st8((*b).ptr, (*b).len, v)
    (*b).len = (*b).len + 1
}

fn bytes_len(b: *mut Bytes) -> usize {
    return (*b).len
}

fn bytes_at(b: *mut Bytes, i: usize) -> u8 {
    if i >= (*b).len {
        return 0 as u8
    }
    return ld8((*b).ptr, i)
}

fn bytes_clear(b: *mut Bytes) {
    (*b).len = 0
}

fn bytes_append(b: *mut Bytes, p: *mut u8, n: usize) {
    bytes_reserve(b, (*b).len + n)
    mem_copy(((*b).ptr as usize + (*b).len) as *mut u8, p, n)
    (*b).len = (*b).len + n
}

fn bytes_eq(a: *mut Bytes, b: *mut Bytes) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr, (*b).ptr, (*a).len)
}

fn bytes_write(fd: i64, b: *mut Bytes) {
    write_all(fd, (*b).ptr, (*b).len)
}

// --- UTF-8 validation (the Bytes -> Str boundary, SPEC 8.1) --------------

// Well formed UTF-8 per Unicode table 3-7: no overlong encoding,
// no surrogates (U+D800..U+DFFF), nothing above U+10FFFF.
fn utf8_is_valid(p: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let b0: u32 = ld8(p, i) as u32
        var need: usize = 0
        var lo: u32 = 0
        var hi: u32 = 0
        if b0 < 0x80 {
            need = 0
        } else if b0 >= 0xC2 && b0 <= 0xDF {
            need = 1
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xE0 {
            need = 2
            lo = 0xA0
            hi = 0xBF
        } else if b0 >= 0xE1 && b0 <= 0xEC {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xED {
            need = 2
            lo = 0x80
            hi = 0x9F
        } else if b0 >= 0xEE && b0 <= 0xEF {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF0 {
            need = 3
            lo = 0x90
            hi = 0xBF
        } else if b0 >= 0xF1 && b0 <= 0xF3 {
            need = 3
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF4 {
            need = 3
            lo = 0x80
            hi = 0x8F
        } else {
            return false
        }
        if need > 0 && i + need >= n {
            return false
        }
        var k: usize = 1
        while k <= need {
            let c: u32 = ld8(p, i + k) as u32
            if k == 1 {
                if c < lo || c > hi {
                    return false
                }
            } else {
                if c < 0x80 || c > 0xBF {
                    return false
                }
            }
            k = k + 1
        }
        i = i + need + 1
    }
    return true
}

// Bytes -> Str: succeeds only for well formed UTF-8 (validates, copies nothing).
fn bytes_is_str(b: *mut Bytes) -> bool {
    return utf8_is_valid((*b).ptr, (*b).len)
}

// lib/str/str16.fi -- `Str16`: a sequence of u16 code units (WTF-16, SPEC 8.2).
//
// Str16 validates NOTHING and normalizes NOTHING. Unpaired surrogates are
// allowed and are kept element by element -- that is deliberate: a
// JavaScript string is allowed to contain them.
//
// The layout is a contract:  Str16 { ptr: *mut u16, len: usize, cap: usize }
// (len/cap count CODE UNITS, not bytes.)
//
// API contract with the module tok (PLAN 3.3). Since stage 0 knows neither
// `inout`/`&` nor aggregates across function boundaries, the parameters are
// pointers and the constructor is called `str16_init(*mut Str16)` instead of
// `str16_new() -> Str16`. The names str16_push/str16_len/str16_at are unchanged.
//
// Include:  //#include lib/str/str16.fi   (needs alloc.fi, bytes.fi)

struct Str16 {
    ptr: *mut u16,
    len: usize,
    cap: usize,
}

fn str16_init(s: *mut Str16) {
    (*s).ptr = 0 as *mut u16
    (*s).len = 0
    (*s).cap = 0
}

fn str16_free(s: *mut Str16) {
    heap_free((*s).ptr as *mut u8, (*s).cap * 2)
    str16_init(s)
}

fn str16_reserve(s: *mut Str16, need: usize) {
    if (*s).cap >= need {
        return
    }
    var cap: usize = (*s).cap
    if cap == 0 {
        cap = 16
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap * 2)
    if (*s).len > 0 {
        mem_copy(p, (*s).ptr as *mut u8, (*s).len * 2)
    }
    heap_free((*s).ptr as *mut u8, (*s).cap * 2)
    (*s).ptr = p as *mut u16
    (*s).cap = cap
}

// Appends ONE code unit -- without any check (0xD800 on its own as well).
fn str16_push(s: *mut Str16, u: u16) {
    str16_reserve(s, (*s).len + 1)
    st16((*s).ptr as *mut u8, (*s).len, u)
    (*s).len = (*s).len + 1
}

fn str16_len(s: *mut Str16) -> usize {
    return (*s).len
}

fn str16_at(s: *mut Str16, i: usize) -> u16 {
    if i >= (*s).len {
        return 0 as u16
    }
    return ld16((*s).ptr as *mut u8, i)
}

fn str16_set(s: *mut Str16, i: usize, u: u16) {
    if i < (*s).len {
        st16((*s).ptr as *mut u8, i, u)
    }
}

fn str16_clear(s: *mut Str16) {
    (*s).len = 0
}

fn str16_eq(a: *mut Str16, b: *mut Str16) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr as *mut u8, (*b).ptr as *mut u8, (*a).len * 2)
}

// Append a code point: anything > 0xFFFF becomes a surrogate pair, everything
// else (including a lone surrogate!) becomes one code unit.
fn str16_push_cp(s: *mut Str16, cp: u32) {
    if cp > 0xFFFF {
        let v: u32 = cp - 0x10000
        str16_push(s, (0xD800 + (v >> 10)) as u16)
        str16_push(s, (0xDC00 + (v & 0x3FF)) as u16)
    } else {
        str16_push(s, cp as u16)
    }
}

fn is_high_surrogate(u: u32) -> bool {
    return u >= 0xD800 && u < 0xDC00
}
fn is_low_surrogate(u: u32) -> bool {
    return u >= 0xDC00 && u < 0xE000
}
fn is_surrogate(u: u32) -> bool {
    return u >= 0xD800 && u < 0xE000
}

// lib/str/utf8.fi -- conversions between Str16 (WTF-16), Str (UTF-8) and
// WTF-8 (SPEC 8.2). Every conversion is EXPLICIT, and how it can fail
// stands in its result:
//
//   str16_to_utf8       -> bool   false = unpaired surrogate, target stays empty
//   str16_to_utf8_lossy -> replaces unpaired surrogates with U+FFFD
//   str16_to_wtf8       -> lossless (keeps unpaired surrogates)
//   wtf8_to_str16       -> the lossless way back
//   utf8_to_str16       -> always succeeds if the source is valid UTF-8
//
// Include:  //#include lib/str/utf8.fi   (needs alloc.fi, bytes.fi, str16.fi)

// ROUND 73: the constant moved to lib/str/core_cp.fi -- the reading half
// of the facade needs it too and must not drag this file (which writes
// into a Bytes) into lib/std/core.fi.
// lib/str/core_cp.fi -- the replacement character (round 73).
//
// U+FFFD, the code point that every UTF-8 reader delivers for an invalid
// octet. It stands in a file of its own for ONE reason: the reading side
// of the facade (lib/str/core_facade.fi) needs it and works without an
// allocator, while the writing side (lib/str/utf8.fi) appends to a
// `*mut Bytes` and thereby owns memory. `lib/std/core.fi` takes only the
// reading side and would otherwise be missing the constant;
// `lib/std/str.fi` takes both and must not get it twice.
//
// Include:  //#include lib/str/core_cp.fi

const REPLACEMENT_CP: u32 = 0xFFFD

fn utf8_push_cp(out: *mut Bytes, cp: u32) {
    if cp < 0x80 {
        bytes_push(out, cp as u8)
    } else if cp < 0x800 {
        bytes_push(out, (0xC0 + (cp >> 6)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    } else if cp < 0x10000 {
        bytes_push(out, (0xE0 + (cp >> 12)) as u8)
        bytes_push(out, (0x80 + ((cp >> 6) & 0x3F)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    } else {
        bytes_push(out, (0xF0 + (cp >> 18)) as u8)
        bytes_push(out, (0x80 + ((cp >> 12) & 0x3F)) as u8)
        bytes_push(out, (0x80 + ((cp >> 6) & 0x3F)) as u8)
        bytes_push(out, (0x80 + (cp & 0x3F)) as u8)
    }
}

fn combine_surrogates(hi: u32, lo: u32) -> u32 {
    return 0x10000 + ((hi - 0xD800) << 10) + (lo - 0xDC00)
}

// Str16 -> Str. Result false on an unpaired surrogate; `out` is empty then.
fn str16_to_utf8(s: *mut Str16, out: *mut Bytes) -> bool {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        if is_high_surrogate(u) {
            if i + 1 >= n {
                bytes_clear(out)
                return false
            }
            let lo: u32 = str16_at(s, i + 1) as u32
            if !is_low_surrogate(lo) {
                bytes_clear(out)
                return false
            }
            utf8_push_cp(out, combine_surrogates(u, lo))
            i = i + 2
        } else if is_low_surrogate(u) {
            bytes_clear(out)
            return false
        } else {
            utf8_push_cp(out, u)
            i = i + 1
        }
    }
    return true
}

// Str16 -> Str, replacing: every unpaired surrogate becomes U+FFFD.
fn str16_to_utf8_lossy(s: *mut Str16, out: *mut Bytes) {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        if is_high_surrogate(u) {
            var paired: bool = false
            if i + 1 < n {
                if is_low_surrogate(str16_at(s, i + 1) as u32) {
                    paired = true
                }
            }
            if paired {
                utf8_push_cp(out, combine_surrogates(u, str16_at(s, i + 1) as u32))
                i = i + 2
            } else {
                utf8_push_cp(out, REPLACEMENT_CP)
                i = i + 1
            }
        } else if is_low_surrogate(u) {
            utf8_push_cp(out, REPLACEMENT_CP)
            i = i + 1
        } else {
            utf8_push_cp(out, u)
            i = i + 1
        }
    }
}

// Str16 -> WTF-8: the lossless bridge, unpaired surrogates survive as a
// three byte sequence.
fn str16_to_wtf8(s: *mut Str16, out: *mut Bytes) {
    bytes_clear(out)
    var i: usize = 0
    let n: usize = str16_len(s)
    while i < n {
        let u: u32 = str16_at(s, i) as u32
        var step: usize = 1
        var cp: u32 = u
        if is_high_surrogate(u) && i + 1 < n {
            let lo: u32 = str16_at(s, i + 1) as u32
            if is_low_surrogate(lo) {
                cp = combine_surrogates(u, lo)
                step = 2
            }
        }
        utf8_push_cp(out, cp)
        i = i + step
    }
}

// WTF-8 -> Str16, lossless (surrogate sequences become single units again).
fn wtf8_to_str16(b: *mut Bytes, out: *mut Str16) {
    str16_clear(out)
    var i: usize = 0
    let n: usize = bytes_len(b)
    while i < n {
        let b0: u32 = bytes_at(b, i) as u32
        var cp: u32 = 0
        var len: usize = 1
        if b0 < 0x80 {
            cp = b0
            len = 1
        } else if b0 >= 0xF0 {
            cp = b0 & 0x07
            len = 4
        } else if b0 >= 0xE0 {
            cp = b0 & 0x0F
            len = 3
        } else if b0 >= 0xC0 {
            cp = b0 & 0x1F
            len = 2
        } else {
            cp = REPLACEMENT_CP
            len = 1
        }
        if len > 1 {
            if i + len > n {
                str16_push_cp(out, REPLACEMENT_CP)
                return
            }
            var k: usize = 1
            while k < len {
                cp = (cp << 6) + (bytes_at(b, i + k) as u32 & 0x3F)
                k = k + 1
            }
        }
        if is_surrogate(cp) {
            str16_push(out, cp as u16)
        } else {
            str16_push_cp(out, cp)
        }
        i = i + len
    }
}

// Str -> Str16: always succeeds (the source is validated UTF-8).
fn utf8_to_str16(b: *mut Bytes, out: *mut Str16) {
    wtf8_to_str16(b, out)
}

// lib/str/print.fi -- minimal output without libc (numbers and octets).
// Used by the test programs only.
//
// Include:  //#include lib/str/print.fi   (needs lib/str/alloc.fi)

struct PrintBuf {
    b: [u8; 32],
    n: usize,
}

// A decimal number followed by a space.
fn print_num(v: u64) {
    print_num_sep(v, 32 as u8)
}

// A decimal number followed by a line break (the last value of a line).
fn print_num_nl(v: u64) {
    print_num_sep(v, 10 as u8)
}

// A decimal number followed by a separator of your choice.
fn print_num_sep(v: u64, sep: u8) {
    var p: PrintBuf = PrintBuf { b: [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8], n: 0, }
    var x: u64 = v
    var n: usize = 0
    if x == 0 {
        p.b[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        p.b[n] = (x % 10) as u8 + 48 as u8
        x = x / 10
        n = n + 1
    }
    var i: usize = 0
    while i < n / 2 {
        let t: u8 = p.b[i]
        p.b[i] = p.b[n - 1 - i]
        p.b[n - 1 - i] = t
        i = i + 1
    }
    p.b[n] = sep
    write_all(1, &p.b[0], n + 1)
}

// Line break.
fn print_nl() {
    var p: PrintBuf = PrintBuf { b: [10 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8], n: 0, }
    write_all(1, &p.b[0], 1)
}

// A single octet as a character (for text output from a Bytes buffer).
fn print_bytes_raw(b: *mut Bytes) {
    write_all(1, (*b).ptr, (*b).len)
}

fn main() -> i32 {
    var s: Str16 = Str16 { ptr: 0 as *mut u16, len: 0, cap: 0, }
    var back: Str16 = Str16 { ptr: 0 as *mut u16, len: 0, cap: 0, }
    var w: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0, }
    str16_init(&s)
    str16_init(&back)
    bytes_init(&w)

    var u: u32 = 0
    var equal: usize = 0
    var utf8_fail: usize = 0
    var lossy_fffd: usize = 0
    while u <= 0xFFFF {
        str16_clear(&s)
        str16_push(&s, u as u16)
        str16_to_wtf8(&s, &w)
        wtf8_to_str16(&w, &back)
        if str16_eq(&s, &back) {
            equal = equal + 1
        }
        if !str16_to_utf8(&s, &w) {
            utf8_fail = utf8_fail + 1
        }
        str16_to_utf8_lossy(&s, &w)
        if bytes_len(&w) == 3 {
            let f0: bool = bytes_at(&w, 0) as u32 == 0xEF
            let f1: bool = bytes_at(&w, 1) as u32 == 0xBF
            let f2: bool = bytes_at(&w, 2) as u32 == 0xBD
            if f0 && f1 && f2 {
                lossy_fffd = lossy_fffd + 1
            }
        }
        u = u + 1
    }
    print_num(equal as u64) // 65536: alles kommt zurueck
    print_num(utf8_fail as u64) // 2048: genau die Surrogate scheitern
    print_num(lossy_fffd as u64) // 2049: die 2048 Surrogate + U+FFFD selbst

    // U+FFFD itself must not have been counted (it is no surrogate):
    str16_clear(&s)
    str16_push(&s, 0xFFFD as u16)
    let fffd_ok: bool = str16_to_utf8(&s, &w)
    print_num((!fffd_ok) as u64) // 0 = gelingt

    // all code points, encoded through pairs
    var cp: u32 = 0
    var ok: usize = 0
    var fail: usize = 0
    while cp < 0x110000 {
        if cp < 0xD800 || cp >= 0xE000 {
            str16_clear(&s)
            str16_push_cp(&s, cp)
            if str16_to_utf8(&s, &w) {
                utf8_to_str16(&w, &back)
                if str16_eq(&s, &back) {
                    ok = ok + 1
                } else {
                    fail = fail + 1
                }
            } else {
                fail = fail + 1
            }
        } else {
            ok = ok + 1
        }
        cp = cp + 1
    }
    print_num(ok as u64)
    print_num_nl(fail as u64)

    str16_free(&s)
    str16_free(&back)
    bytes_free(&w)
    return 0
}
