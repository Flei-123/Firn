// expect_exit: 0
// 'try' in einer Schleife: der erste Fehler verlaesst die Funktion sofort.
error E { Zuviel }

fn schritt(n: i32) -> E!i32 {
    if n > 3 {
        return E::Zuviel
    }
    return n
}

fn bis(n: i32) -> E!i32 {
    var acc: i32 = 0
    var i: i32 = 0
    while i <= n {
        acc = acc + try schritt(i)
        i = i + 1
    }
    return acc
}

fn main() -> i32 {
    if (bis(3) catch 0 - 1) != 6 {
        return 1
    }
    if (bis(9) catch 0 - 1) != 0 - 1 {
        return 2
    }
    return 0
}
