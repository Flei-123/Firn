// expect_exit: 0
// Sound id tables (tools/mcgen/gen_sounds.py) and the sound packet dispatch of lib/mc/mc_audio.fi (mca_on_packet).
import std.rt
import std.io
import std.bytes
import audio.engine
import mc.mc_audio
import mc.mc_version
import mc.mc_sem
import mc.mc_entity
import mc.v763.mc_proto_v763
import mc.v763.mc_snd_v763
import mc.v754.mc_snd_v754
import mc.v340.mc_snd_v340
import mc.v769.mc_snd_v769
import mc.v47.mc_snd_v47

struct T { fails: i32 }

fn check(t: *mut T, ok: bool, what: str) {
    if ok {
        io.fmt_print(f"ok   {what}\n")
    } else {
        io.fmt_print(f"FAIL {what}\n")
        (*t).fails = (*t).fails + 1
    }
}

fn is_name(m: *mut mc_audio.McAudio, id: i32, want: str) -> bool {
    let n: str = mc_audio.mca_sound_name(m, id)
    return n.length() == want.length() && rt.mem_eq(n.p as u64, want.p as u64, n.length())
}

#[allow_escape]
fn main(start: u64) -> i32 {
    var t: T = T { fails: 0 }
    var e: engine.Engine = engine.engine_new(48000 as u32, 64 as u32)
    var m: mc_audio.McAudio = mc_audio.mca_new(&e)
    // 1.20.1: 1474 names, registry id = wire holder - 1 (verified against a real server: pig death = wire 984)
    check(&t, mc_audio.mca_sound_table_load(&m, mc_snd_v763.SND_BLOB.p as u64, mc_snd_v763.SND_COUNT, mc_snd_v763.SND_FIRST) == 1474, "1.20.1 table: 1474 names")
    check(&t, is_name(&m, 0, "entity.allay.ambient_with_item") && is_name(&m, 573, "block.grass.step") && is_name(&m, 983, "entity.pig.death")
        && is_name(&m, 273, "entity.chicken.hurt") && is_name(&m, 1473, "entity.zombie_villager.step"), "1.20.1 spot checks")
    check(&t, mc_audio.mca_sound_name(&m, 1474).length() == 0, "1.20.1 id 1474 unknown")
    var m2: mc_audio.McAudio = mc_audio.mca_new(&e)
    check(&t, mc_audio.mca_sound_table_load(&m2, mc_snd_v769.SND_BLOB.p as u64, mc_snd_v769.SND_COUNT, mc_snd_v769.SND_FIRST) == 1651, "1.21.4 table: 1651 names")
    check(&t, is_name(&m2, 656, "block.grass.step") && is_name(&m2, 1099, "entity.pig.death"), "1.21.4 spot checks (real server: wire 657 / 1100)")
    var m3: mc_audio.McAudio = mc_audio.mca_new(&e)
    check(&t, mc_audio.mca_sound_table_load(&m3, mc_snd_v754.SND_BLOB.p as u64, mc_snd_v754.SND_COUNT, mc_snd_v754.SND_FIRST) == 985, "1.16.5 table: 985 names (ids from 0)")
    check(&t, mc_audio.mca_sound_table_load(&m3, mc_snd_v340.SND_BLOB.p as u64, mc_snd_v340.SND_COUNT, mc_snd_v340.SND_FIRST) == 549, "1.12.2 table: 549 names")
    check(&t, mc_snd_v47.SND_COUNT == 0, "1.8.9: no table (named sounds only)")
    // dispatch: 1.20.1 Sound Effect with registry id 573 (wire 574) -> block.grass.step, no bank event = counted missing
    var v: mc_version.Version = mc_proto_v763.version_make()
    var pk: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&pk, 574)
    bytes.put_varint(&pk, 4)
    bytes.put_i32(&pk, 16)
    bytes.put_i32(&pk, 0)
    bytes.put_i32(&pk, 16)
    bytes.put_f32(&pk, 0.5)
    bytes.put_f32(&pk, 1.25)
    bytes.put_i64(&pk, 0 as i64)
    var sp: mc_audio.SoundPkt = mc_audio.SoundPkt { id: 0, name_p: 0, name_n: 0, has_range: false, range: 0.0, category: 0, entity: 0,
        x: 0.0, y: 0.0, z: 0.0, volume: 0.0, pitch: 0.0, seed: 0 as i64 }
    check(&t, mc_audio.mca_decode_sound_v(mc_audio.mca_sound_format(763), 763, mc_audio.SK_SOUND, bytes.bytes_data(&pk), bytes.bytes_len(&pk), &sp)
        && sp.id == 573 && sp.category == 4 && sp.x == 2.0 && sp.z == 2.0 && sp.volume == 0.5 && sp.pitch == 1.25, "versioned decode: id, category, position, volume, pitch")
    let miss: u64 = m.n_missing
    bytes.bytes_set_pos(&pk, 0)
    let sid: i32 = v.sem[mc_sem.SEM_PLAY_S2C_SOUND_EFFECT]
    check(&t, sid >= 0, "1.20.1 has a Sound Effect wire id")
    check(&t, mc_audio.mca_on_packet(&m, &v, sid, &pk, 0 as *mut mc_entity.Store) && m.n_pkt == 1 as u64 && m.n_bad == 0 as u64 && m.n_missing == miss + 1 as u64,
        "mca_on_packet consumes the sound packet (no bank event: counted missing)")
    check(&t, !mc_audio.mca_on_packet(&m, &v, 0 - 1, &pk, 0 as *mut mc_entity.Store), "id -1 is not a sound packet")
    check(&t, mc_audio.mca_sound_format(47) == mc_audio.SF_LEGACY && mc_audio.mca_sound_format(340) == mc_audio.SF_CLASSIC
        && mc_audio.mca_sound_format(763) == mc_audio.SF_HOLDER && mc_audio.mca_sound_format(100) == mc_audio.SF_NONE, "format by protocol")
    io.fmt_print(f"{t.fails} failed\n")
    return t.fails
}
