// expect_exit: 0
interface Counter {
    type Item
    fn next(*mut self) -> Self::Item
}

struct Up { n: i32 }
struct Down { n: i64 }

impl Counter for Up {
    type Item = i32
    fn next(*mut self) -> Self::Item {
        (*self).n = (*self).n + 1
        return (*self).n
    }
}

impl Counter for Down {
    type Item = i64
    fn next(*mut self) -> i64 {
        (*self).n = (*self).n - 1
        return (*self).n
    }
}

fn two[T: Counter](c: *mut T) -> T::Item {
    let a: T::Item = c.next()
    let b: T::Item = c.next()
    return b
}

fn main() -> i32 {
    var u = Up { n: 0 }
    var d = Down { n: 10 }
    let x = two[Up](&u)
    let y = two[Down](&d)
    if x != 2 { return 1 }
    if y != 8 { return 2 }
    return 0
}
