// expect_exit: 0
import plat.hostev

fn main() -> i32 {
    let e: hostev.HostEvent = hostev.blank(hostev.WE_TAP)
    if e.kind != hostev.WE_TAP { return 1 }
    if e.pid != 1 as u32 || e.ptype != 1 as u32 || e.primary != 1 as u32 { return 2 }
    if e.n != 0 || e.qn != 0 || e.mods != 0 as u32 { return 3 }
    if hostev.MOD_TOUCH != 256 as u32 || hostev.MOD_MIDDLE != 512 as u32 { return 4 }
    if hostev.WE_CLIP != 14 as u32 || hostev.WE_DIALOG != 16 as u32 { return 5 }
    if hostev.CURSOR_TEXT != 2 as u32 { return 6 }
    return 0
}
