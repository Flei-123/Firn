// expect_exit: 0
// MODULKETTE IN DER KERNSPRACHE — der Nachweis, dass `firnc1` mehrere Dateien
// uebersetzt und die Namen dabei auseinanderhaelt.
//
// Drei Ebenen, und der Name `wert` steht in ALLEN dreien. Ohne Umbenennung
// wuerde eine Fassung die andere verdecken; mit Umbenennung heissen sie
// intern `tief__wert`, `mittel__wert` und `wert`.
//
// Ausserdem: eine Konstante und ein Struct aus einem anderen Modul, und eine
// Modulkette ueber zwei Ebenen (`mittel` bindet `tief` ein).
import modules.kern.mittel
import modules.kern.tief

fn wert() -> i32 {
    return 1
}

fn main() -> i32 {
    // die eigene Fassung
    if wert() != 1 {
        return 1
    }
    // die der mittleren Ebene: 7 * 10
    if mittel.wert() != 70 {
        return 2
    }
    // die der untersten Ebene
    if tief.wert() != 7 {
        return 3
    }
    // Konstante aus einem anderen Modul
    if tief.GRUND != 7 {
        return 4
    }
    // Struct aus einem anderen Modul, als Wert uebergeben
    let p: tief.Paar = tief.Paar{ a: 20, b: 22 }
    if tief.summe(p) != 42 {
        return 5
    }
    // Funktion der mittleren Ebene auf einem Wert der untersten
    if mittel.doppelt(tief.GRUND) != 14 {
        return 6
    }
    return 0
}
