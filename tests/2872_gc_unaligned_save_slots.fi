// expect_exit: 0
// r476: the save slots of the callee-saved registers must be 8-aligned.
// A callee with an odd-sized byte local (alignment 1) used to put them at
// rbp-0x49 and so on; the conservative stack scan reads aligned words only,
// so a `Gc` pointer that lived only in the CALLER's callee-saved register
// (saved by the callee at such a slot) was invisible and got collected
// (layoutb2 SIGSEGV in sel.match_simple).
gc class Cell {
    next: Gc[Cell],
    value: u64,
}

fn touch(p: u64) {
    *(p as *mut u8) = 7 as u8
}

// Odd byte local + several values that stay live across the call so the
// allocator uses callee-saved registers. The collection runs in here.
fn callee(a: u64, b: u64, c: u64, d: u64, e: u64) -> u64 {
    var odd: [u8; 5] = [0; 5]
    touch((&odd) as u64)
    let x1: u64 = a * 3 + 1
    let x2: u64 = b * 5 + 2
    let x3: u64 = c * 7 + 3
    let x4: u64 = d * 11 + 4
    let x5: u64 = e * 13 + 5
    gc_stack_clean()
    gc_collect()
    return x1 + x2 + x3 + x4 + x5 + odd[0] as u64
}

fn caller(w: *mut GcWeak[Cell], n: u64) -> u64 {
    let t = gc Cell { next: gc_null[Cell](), value: 1234 } catch gc_null[Cell]()
    if t == gc_null[Cell]() {
        return 0
    }
    *w = weak(t)
    var i: u64 = 0
    var acc: u64 = 0
    while i < n {
        acc = acc + callee(i, i + 1, i + 2, i + 3, i + 4)
        i = i + 1
    }
    // `t` is used only here, after the collections.
    return t.value + (acc & 1)
}

fn main() -> i32 {
    if !gc_init() {
        return 9
    }
    var w: GcWeak[Cell] = weak_null[Cell]()
    let r: u64 = caller(&w, 3)
    if r < 1234 || r > 1235 {
        return 1
    }
    return 0
}
