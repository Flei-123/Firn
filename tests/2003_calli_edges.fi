// expect_exit: 0
// ROUND REGALLOC EDGES (r123) -- calls through function values (`calli`) and direct
// calls with awkward argument mixes, in EVERY build level. r113/r124 fixed the float
// results and the xmm argument registers of `Op::CallIndirect`; this is the rest of
// the matrix:
//   A. the TARGET value is computed late and many integer values stay live, so the
//      allocator keeps the target in a register while six argument registers are set
//      (the target must be read before an argument write can destroy it);
//   B. seven or more integer arguments plus nine floating point ones: the stack
//      arguments are a mix of integer and `f64` slots, in the order of the call;
//   C. `f32` as seventh and later argument (stack slot) and as result;
//   D. the same shapes as direct calls, so both arms are held to one answer.
// The callees check their arguments by value; the exit code is a bit mask of the
// cases that went wrong.

fn six(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64) -> u64 {
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6
}

fn six_b(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64) -> u64 {
    return a * 6 + b * 5 + c * 4 + d * 3 + e * 2 + f
}

fn pick(which: u64) -> fn(u64, u64, u64, u64, u64, u64) -> u64 {
    if which == 0 {
        return six
    }
    return six_b
}

fn many(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64, x0: f64, x1: f64,
    x2: f64, x3: f64, x4: f64, x5: f64, x6: f64, x7: f64, x8: f64, x9: f64) -> f64 {
    let ints: u64 = a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8
    let fl: f64 = x0 + x1 * 2.0 + x2 * 3.0 + x3 * 4.0 + x4 * 5.0 + x5 * 6.0 + x6 * 7.0
        + x7 * 8.0 + x8 * 9.0 + x9 * 10.0
    return (ints as f64) * 1000.0 + fl
}

fn halves(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: f32, h: f32, i: f32,
    j: f32, k: f32, l: f32, m: f32, n: f32, o: f32, p: f32) -> f32 {
    return g + h * 2.0 + i * 3.0 + j * 4.0 + k * 5.0 + l * 6.0 + m * 7.0 + n * 8.0
        + o * 9.0 + p * 10.0 + ((a + f) as f32)
}

// A: target computed late, plenty of live values around the call
fn case_a(n: u64) -> i32 {
    let p0: u64 = n + 1
    let p1: u64 = n + 2
    let p2: u64 = n + 3
    let p3: u64 = n + 4
    let p4: u64 = n + 5
    let p5: u64 = n + 6
    let q0: u64 = p0 * p1
    let q1: u64 = p2 * p3
    let q2: u64 = p4 * p5
    let t: fn(u64, u64, u64, u64, u64, u64) -> u64 = pick(n)
    let r: u64 = t(p5, p4, p3, p2, p1, p0)
    var want: u64 = 0
    if n == 0 {
        want = six(p5, p4, p3, p2, p1, p0)
    } else {
        want = six_b(p5, p4, p3, p2, p1, p0)
    }
    // the live values must have survived
    if q0 + q1 + q2 != (p0 * p1) + (p2 * p3) + (p4 * p5) {
        return 2
    }
    if r != want {
        return 1
    }
    return 0
}

// B: nine floats + eight integers through a function value
fn case_b(m: fn(u64, u64, u64, u64, u64, u64, u64, u64, f64, f64, f64, f64, f64, f64,
    f64, f64, f64, f64) -> f64, k: u64) -> i32 {
    let a: u64 = k + 1
    let b: u64 = k + 2
    let c: u64 = k + 3
    let d: u64 = k + 4
    let e: u64 = k + 5
    let f: u64 = k + 6
    let g: u64 = k + 7
    let h: u64 = k + 8
    let kf: f64 = k as f64
    let r: f64 = m(a, b, c, d, e, f, g, h, kf + 1.0, kf + 2.0, kf + 3.0, kf + 4.0,
        kf + 5.0, kf + 6.0, kf + 7.0, kf + 8.0, kf + 9.0, kf + 10.0)
    let w: f64 = many(a, b, c, d, e, f, g, h, kf + 1.0, kf + 2.0, kf + 3.0, kf + 4.0,
        kf + 5.0, kf + 6.0, kf + 7.0, kf + 8.0, kf + 9.0, kf + 10.0)
    if !(r > w - 0.01 && r < w + 0.01) {
        return 1
    }
    return 0
}

// C: f32 in stack slots, f32 result, through a value and direct
fn case_c(h: fn(u64, u64, u64, u64, u64, u64, f32, f32, f32, f32, f32, f32, f32, f32,
    f32, f32) -> f32, k: u64) -> i32 {
    let kf: f32 = k as f32
    let r: f32 = h(k, 2, 3, 4, 5, k + 1, kf + 1.0, kf + 2.0, kf + 3.0, kf + 4.0, kf + 5.0,
        kf + 6.0, kf + 7.0, kf + 8.0, kf + 9.0, kf + 10.0)
    let w: f32 = halves(k, 2, 3, 4, 5, k + 1, kf + 1.0, kf + 2.0, kf + 3.0, kf + 4.0,
        kf + 5.0, kf + 6.0, kf + 7.0, kf + 8.0, kf + 9.0, kf + 10.0)
    if !(r > w - 0.01 && r < w + 0.01) {
        return 1
    }
    // and against the closed form: sum_{j=1..10} j*(k+j) + k + (k + 1)
    let want: f32 = (385.0 + 55.0 * kf) + kf + (kf + 1.0)
    if !(r > want - 0.01 && r < want + 0.01) {
        return 2
    }
    return 0
}

fn main() -> i32 {
    var rc: i32 = 0
    if case_a(0) != 0 {
        rc = rc | 1
    }
    if case_a(1) != 0 {
        rc = rc | 2
    }
    if case_b(many, 0) != 0 {
        rc = rc | 4
    }
    if case_b(many, 7) != 0 {
        rc = rc | 8
    }
    if case_c(halves, 0) != 0 {
        rc = rc | 16
    }
    if case_c(halves, 3) != 0 {
        rc = rc | 32
    }
    return rc
}
