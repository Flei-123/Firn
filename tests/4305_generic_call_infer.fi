// expect_exit: 0
// tests/4305_generic_call_infer.fi -- r742b: a generic callee called WITHOUT type arguments
// when an argument is a generic fn used as a value: `T` comes from the other arguments.
import std.vec

fn id[T](x: T) -> T { return x }
fn dbl[T](x: T) -> T { return x + x }
fn apply_g[T](f: fn(T) -> T, v: T) -> T { return f(v) }
fn apply_p[T](v: T, f: fn(T) -> T) -> T { return f(v) }
fn count[T](v: *mut Vec[T]) -> i32 { return vec_len[T](v) as i32 }
fn apply_n[T](f: fn(*mut Vec[T]) -> i32, v: *mut Vec[T]) -> i32 { return f(v) }
fn twice[T](f: fn(T) -> T, v: T) -> T { return apply_g[T](f, f(v)) }

fn via[T](v: T) -> T { return apply_g(id, v) }

fn main() -> i32 {
    if apply_g(id, 4) != 4 { return 1 }
    let a: i64 = 20
    if apply_g(dbl, a) != 40 { return 2 }
    if apply_p(7 as u8, dbl) != 14 { return 3 }
    if apply_g(dbl, 2.5) != 5.0 { return 4 }
    var v: Vec[i32] = vec_new[i32]()
    defer vec_free[i32](&v)
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    if apply_n(count, &v) != 2 { return 5 }
    if via[i64](9) != 9 { return 6 }
    if twice[i32](dbl, 3) != 12 { return 7 }
    return 0
}
