// expect_exit: 0
// r900 (differential test): the literal range rule in both compilers. A literal narrower than
// 64 bits may use the whole bit pattern (255 for a u8, 128 for an i8) and the negative edge
// (-128); firnc1 did not check the range at all (300 for a u8 was accepted).
fn main() -> i32 {
    let a: u8 = 255
    let b: i8 = -128
    let c: u16 = 65535
    let d: i16 = -32768
    let e: u32 = 4294967295
    let f: i32 = 0 - 2147483647
    let g: u64 = 18446744073709551615
    if a as i32 != 255 {
        return 1
    }
    if b as i32 != 0 - 128 {
        return 2
    }
    if c as i32 != 65535 {
        return 3
    }
    if d as i32 != 0 - 32768 {
        return 4
    }
    if e as u64 != 4294967295 {
        return 5
    }
    if f != 0 - 2147483647 {
        return 6
    }
    if g == 0 {
        return 7
    }
    return 0
}
