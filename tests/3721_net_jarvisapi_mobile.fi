// expect_exit: 0
// tests/3721_net_jarvisapi_mobile.fi -- net.jarvisapi, answers of the mobile routes /api/m/* (docs/ANDROID-APP-API.md of
// the JARVIS server): chat list ("chats"), one chat ({"chat","messages"}), devices as objects, push registration, upload with
// the server path; every proper prefix is refused, 1500 seeded byte mutations never crash, the mode switch changes the paths.
import std.rt
import std.vec
import async.loop
import net.jarvisapi

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

const F_CHATS: str = "{\"total\":2,\"chats\":[{\"id\":\"c_ab12\",\"title\":\"Build\",\"kind\":\"worker\",\"updatedAt\":1760726000000,\"running\":true,\"fav\":false,\"parent\":null},{\"id\":\"c_2\",\"title\":\"x\",\"kind\":\"chat\",\"updatedAt\":5,\"running\":false,\"fav\":true,\"parent\":\"c_x\"}]}"
const F_CHAT: str = "{\"chat\":{\"id\":\"c_ab12\",\"title\":\"Build\",\"kind\":\"worker\",\"running\":true,\"partial\":\"so far\",\"beat\":null},\"first\":40,\"hasMore\":true,\"messages\":[{\"i\":40,\"role\":\"user\",\"text\":\"hi\",\"at\":1760726000000,\"truncated\":false,\"images\":[],\"files\":[]},{\"i\":41,\"role\":\"assistant\",\"text\":\"yo\",\"at\":1760726000001}]}"
const F_DEV: str = "{\"devices\":[{\"name\":\"Dell\",\"type\":\"Windows\",\"online\":true},{\"name\":\"Phone\",\"type\":\"Android\",\"online\":false}]}"
const F_REG: str = "{\"pushToken\":\"0123456789abcdef0123456789abcdef\",\"relay\":{\"host\":\"jarvis.fleitec.com\",\"port\":7781,\"tls\":false,\"pin\":null,\"hello\":true,\"sni\":null},\"poll\":\"/api/m/push/poll\"}"
const F_UP: str = "{\"file\":{\"name\":\"a.jpg\",\"mime\":\"image/jpeg\",\"size\":12,\"url\":\"/file/u1/mobile/ab_a.jpg\",\"path\":\"/srv/uploads/u1/mobile/ab_a.jpg\"}}"

fn run(k: i32, p: u64, n: usize) -> bool {
    var ok: bool = false
    if k == 0 { var m: jarvisapi.Convs = jarvisapi.convs_new(); ok = jarvisapi.parse_convs(p, n, &m); jarvisapi.convs_free(&m) }
    else if k == 1 { var m: jarvisapi.Conv = jarvisapi.conv_new(); ok = jarvisapi.parse_conv(p, n, &m); jarvisapi.conv_free(&m) }
    else if k == 2 { var m: jarvisapi.Devices = jarvisapi.devices_new(); ok = jarvisapi.parse_devices(p, n, &m); jarvisapi.devices_free(&m) }
    else if k == 3 { var m: jarvisapi.PushReg = jarvisapi.pushreg_new(); ok = jarvisapi.parse_push_register(p, n, &m); jarvisapi.pushreg_free(&m) }
    else { var m: jarvisapi.Uploaded = jarvisapi.uploaded_new(); ok = jarvisapi.parse_upload(p, n, &m); jarvisapi.uploaded_free(&m) }
    return ok
}

fn fixture(k: i32) -> str {
    if k == 0 { return F_CHATS }
    if k == 1 { return F_CHAT }
    if k == 2 { return F_DEV }
    if k == 3 { return F_REG }
    return F_UP
}

fn nop(a: *mut jarvisapi.Api, ud: u64, kind: u32, status: i64) {
}

#[allow_escape]
fn main() -> i32 {
    var cv: jarvisapi.Convs = jarvisapi.convs_new()
    check("chats", jarvisapi.parse_convs(F_CHATS.p as u64, F_CHATS.n, &cv))
    let c1: *mut jarvisapi.ConvRow = vec_elem_ptr[jarvisapi.ConvRow](&cv.rows, 1)
    check("chats rows", vec_len[jarvisapi.ConvRow](&cv.rows) == 2 && cv.total == 2 && (*c1).fav && (*c1).id == "c_2")
    jarvisapi.convs_free(&cv)

    var ch: jarvisapi.Conv = jarvisapi.conv_new()
    check("chat", jarvisapi.parse_conv(F_CHAT.p as u64, F_CHAT.n, &ch))
    let m1: *mut jarvisapi.Msg = vec_elem_ptr[jarvisapi.Msg](&ch.msgs, 1)
    check("chat fields", ch.id == "c_ab12" && ch.running && ch.partial == "so far" && vec_len[jarvisapi.Msg](&ch.msgs) == 2 && (*m1).text == "yo")
    jarvisapi.conv_free(&ch)

    var dv: jarvisapi.Devices = jarvisapi.devices_new()
    check("devices", jarvisapi.parse_devices(F_DEV.p as u64, F_DEV.n, &dv))
    let d1: *mut jarvisapi.DeviceRow = vec_elem_ptr[jarvisapi.DeviceRow](&dv.rows, 1)
    check("devices rows", vec_len[jarvisapi.DeviceRow](&dv.rows) == 2 && (*d1).name == "Phone" && !(*d1).online && vec_len[str](&dv.names) == 2)
    jarvisapi.devices_free(&dv)

    var pr: jarvisapi.PushReg = jarvisapi.pushreg_new()
    check("push register", jarvisapi.parse_push_register(F_REG.p as u64, F_REG.n, &pr))
    check("push fields", pr.token.n == 32 && pr.host == "jarvis.fleitec.com" && pr.port == 7781 && !pr.tls && pr.hello)
    jarvisapi.pushreg_free(&pr)
    check("push without token refused", !run(3, "{\"relay\":{}}".p as u64, 12))

    var up: jarvisapi.Uploaded = jarvisapi.uploaded_new()
    check("upload", jarvisapi.parse_upload(F_UP.p as u64, F_UP.n, &up))
    check("upload path", up.path == "/srv/uploads/u1/mobile/ab_a.jpg" && up.url == "/file/u1/mobile/ab_a.jpg" && up.size == 12)
    jarvisapi.uploaded_free(&up)

    var k: i32 = 0
    var cut_ok: i32 = 0
    while k < 5 {
        let f: str = fixture(k)
        var n: usize = 0
        while n < f.n {
            if run(k, f.p as u64, n) { cut_ok += 1 }
            n += 1
        }
        k += 1
    }
    check("no cut document accepted", cut_ok == 0)

    var seed: u64 = 88172645463325252
    var it: i32 = 0
    while it < 1500 {
        let kk: i32 = it % 5
        let f: str = fixture(kk)
        var b: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&b, f.p as u64, f.n)
        var m: i32 = 0
        while m < 3 {
            seed ^= seed << 13
            seed ^= seed >> 7
            seed ^= seed << 17
            let at: usize = (seed % (f.n as u64)) as usize
            *((b.ptr + at as u64) as *mut u8) = ((seed >> 20) & 255) as u8
            m += 1
        }
        let r: bool = run(kk, b.ptr, b.len)
        rt.buf_free(&b)
        it += 1
    }

    var l: loop.Loop = loop.loop_new()
    check("loop", loop.loop_init(&l))
    let a: *mut jarvisapi.Api = jarvisapi.ja_new(&l, nop, 0)
    check("old paths by default", !jarvisapi.ja_is_mobile(a) && jarvisapi.ja_get_path(a, jarvisapi.JP_TASKS) == "/api/tasks" && jarvisapi.ja_get_path(a, jarvisapi.JP_CONVS) == "/api/conversations")
    jarvisapi.ja_set_mobile(a, true)
    check("mobile paths", jarvisapi.ja_is_mobile(a) && jarvisapi.ja_get_path(a, jarvisapi.JP_TASKS) == "/api/m/tasks"
        && jarvisapi.ja_get_path(a, jarvisapi.JP_PROJECTS) == "/api/m/projects" && jarvisapi.ja_get_path(a, jarvisapi.JP_CONVS) == "/api/m/chats"
        && jarvisapi.ja_get_path(a, jarvisapi.JP_DEVICES) == "/api/m/devices" && jarvisapi.ja_get_path(a, jarvisapi.JP_CENTER) == "/api/command-center")
    jarvisapi.ja_set_mobile(a, false)
    check("back to old", !jarvisapi.ja_is_mobile(a) && jarvisapi.ja_get_path(a, jarvisapi.JP_TASKS) == "/api/tasks")
    jarvisapi.ja_free(a)

    if failures == 0 {
        rt.write_everything(1, "OK\n".p as u64, 3)
        return 0
    }
    return 1
}
