// expect_out: 42 46 294 42 0 4 8 4|6
// firnc1_skip: for-in over Vec/str is stage 0 only (r664)
// r664: `for x in vec` and `for c in str` -- the same desugar as the array
// loop. A Vec[T] gives copies of the elements, a str its BYTES (u8, not code
// points). Works for a local, a field, `*p` and a reference parameter;
// `break` / `continue` as usual. The length is read once at the start.
import std.io
import std.vec

struct P { x: i32, y: i32 }
struct Holder { items: Vec[i32] }

fn total(v: *mut Vec[i32]) -> i64 {
    var s: i64 = 0
    for x in *v {
        s += x as i64
    }
    return s
}

fn total_ref(v: &Vec[i32]) -> i64 {
    var s: i64 = 0
    for x in v {
        s += x as i64
    }
    return s
}

fn count_bytes(s: str) -> usize {
    var n: usize = 0
    for c in s {
        n += 1
    }
    return n
}

fn main() -> i32 {
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 5)
    vec_push[i32](&v, 7)
    vec_push[i32](&v, 30)
    var sum: i32 = 0
    for x in v {
        sum += x
    }
    var ps: Vec[P] = vec_new[P]()
    vec_push[P](&ps, P { x: 1, y: 2 })
    vec_push[P](&ps, P { x: 3, y: 4 })
    var py: i32 = 0
    for p in ps {
        py += p.x * 10 + p.y
    }
    let s: str = "abc"
    var bytes: i32 = 0
    for c in s {
        bytes += c as i32
    }
    // empty vec: the body never runs
    var e: Vec[i64] = vec_new[i64]()
    var none: i32 = 0
    for x in e {
        none += 1
    }
    // break / continue and a nested loop over the same Vec
    var pairs: i32 = 0
    for a in v {
        if a == 7 { continue }
        for b in v {
            if b == 30 { break }
            pairs += 1
        }
    }
    // a field, and bytes of a multi byte text ("ä" is two bytes in UTF-8)
    var h: Holder = Holder { items: vec_new[i32]() }
    vec_push[i32](&h.items, 1)
    vec_push[i32](&h.items, 2)
    var hsum: i32 = 0
    for x in h.items {
        hsum += x
    }
    let nb: usize = count_bytes("aä")
    io.print_line(io.fmt_string(f"{sum} {py} {bytes} {total(&v)} {none} {pairs + hsum - 3} {nb + 5} {total_ref(&v) - 38}|{hsum + 3}"))
    vec_free[i32](&v)
    vec_free[P](&ps)
    vec_free[i64](&e)
    vec_free[i32](&h.items)
    return 0
}
