// expect_exit: 0
import fui.armed
import std.rt

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn main() -> i32 {
    var a: armed.Armed = armed.armed_new()
    check("fresh not armed", !armed.armed_is(&a, 5))
    check("first tap arms", !armed.armed_tap(&a, 5))
    check("armed after tap", armed.armed_is(&a, 5))
    check("second tap confirms", armed.armed_tap(&a, 5))
    check("disarmed after confirm", !armed.armed_is(&a, 5))
    armed.armed_tap(&a, 5)
    check("other action re-arms", !armed.armed_tap(&a, 6))
    check("old not armed", !armed.armed_is(&a, 5))
    check("new armed", armed.armed_is(&a, 6))
    armed.armed_clear(&a)
    check("clear", armed.armed_id(&a) == -1 && !armed.armed_is(&a, 6))
    check("tap after clear arms", !armed.armed_tap(&a, 6))
    if failures > 0 {
        return 1
    }
    return 0
}
