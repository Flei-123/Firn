// expect_exit: 0
import std.rt
import mc.mc_version
import mc.mc_versions
import mc.mc_registry
import mc.server.sv_state
import mc.server.sv_core
import mc.server.sv_edits
import mc.server.sv_world
import mc.server.sv_ver
import mc.server.sv_vers
import mc.server.portal.portal_ctx
import mc.server.portal.portal_forcer

static mut g_fail: i32 = 0
static mut g_state: u16 = 0

fn check(ok: bool, msg: str) {
    if !ok {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_bytes(&o, msg.p as u64, msg.n)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn put(col: *mut sv_world.Column, lx: usize, y: i32, lz: usize) {
    let idx: usize = (((y + 64) as usize) * 16 + lz) * 16 + lx
    rt.st16((*col).blocks, idx, g_state)
}

fn saved_fill(ctx: u64, cx: i32, cz: i32, col: *mut sv_world.Column) -> bool {
    rt.mem_set((*col).blocks, 0 as u8, 384 * 512)
    if cx == 0 && cz == 0 { put(col, 3, 64, 2) }
    if cx == 2 && cz == 0 - 1 { put(col, 3, 70, 5) }
    return true
}

fn saved_release(ctx: u64) {}

fn main() -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &ver), "version")
    var ad: sv_ver.ServerVersion = sv_ver.adapter_none()
    check(sv_vers.server_version_by_protocol(763, &ad), "adapter")
    var world: sv_world.WorldSource = sv_world.WorldSource { ctx: 0, fill: saved_fill, release: saved_release, min_y: 0 - 64, height: 384, spawn_x: 0,
        spawn_y: 64, spawn_z: 0, biome: ad.biome_default, uniform: false }
    let srv: *mut sv_state.Server = sv_core.server_box(sv_core.server_new(sv_state.config_default(), ver, world, sv_ver.adapter_alloc(ad)))
    var c: portal_ctx.PortalCtx = portal_ctx.ctx_new(srv)
    g_state = portal_ctx.portal_state(&c, portal_ctx.AXIS_X) as u16
    var out: portal_forcer.Rect = portal_forcer.Rect { x: 0, y: 0, z: 0, axis: 0, size1: 0, size2: 0 }
    check(portal_forcer.find_portal_around(&c, 0, 70, 0, false, &out), "nearest portal found in saved chunks")
    check(out.x == 3 && out.y == 64 && out.z == 2, "nearest portal position")
    check(portal_forcer.find_portal_around(&c, 40, 70, 0 - 10, false, &out), "second portal found")
    check(out.x == 35 && out.y == 70 && out.z == 0 - 11, "second portal position")
    check(portal_forcer.find_portal_around(&c, 40, 70, 0 - 10, true, &out), "narrow radius hit")
    check(!portal_forcer.find_portal_around(&c, 100, 70, 100, true, &out), "narrow radius miss")
    check(!portal_forcer.find_portal_around(&c, 400, 70, 400, false, &out), "wide radius miss")
    sv_edits.edits_set(&(*srv).edits, 3, 64, 2, 0)
    check(portal_forcer.find_portal_around(&c, 0, 70, 0, false, &out), "edited-away portal skipped")
    check(out.x == 35 && out.y == 70, "falls back to the farther portal")
    (*srv).gen_world = true
    check(!portal_forcer.find_portal_around(&c, 400, 70, 400, false, &out), "generated worlds are not scanned")
    if g_fail == 0 {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "ok\n".p as u64, 3)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
    }
    return g_fail
}
