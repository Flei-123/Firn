// expect_out: ok
// tests/2991_gpu_campreview_zoom.fi -- gpu.campreview digital zoom: the crop window shrinks around its centre,
// keeps its aspect, stays inside the picture, also when mirrored (negative width); zoom <= 1 changes nothing.
import std.io
import gpu.campreview

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000001
}

fn main() -> i32 {
    var ok: bool = true
    var mi: i32 = 0
    while mi < 2 {
        var base: campreview.Plan = campreview.Plan { crop: [0.0; 4], m: [0.0; 4], t: [0.0; 2], quad: [1.0; 2], rot: 0 }
        var z: campreview.Plan = campreview.Plan { crop: [0.0; 4], m: [0.0; 4], t: [0.0; 2], quad: [1.0; 2], rot: 0 }
        campreview.cp_plan(4000, 3000, 90, mi == 1, 1080, 1920, true, &base)
        campreview.cp_plan(4000, 3000, 90, mi == 1, 1080, 1920, true, &z)
        campreview.cp_zoom_crop(&z, 1.0)
        if !near(z.crop[0], base.crop[0]) || !near(z.crop[2], base.crop[2]) { ok = false; io.print("zoom 1 changed the crop") }
        campreview.cp_zoom_crop(&z, 2.0)
        if !near(z.crop[2], base.crop[2] / 2.0) || !near(z.crop[3], base.crop[3] / 2.0) { ok = false; io.print("size") }
        // the centre stays
        if !near(z.crop[0] + z.crop[2] / 2.0, base.crop[0] + base.crop[2] / 2.0) { ok = false; io.print("centre x") }
        if !near(z.crop[1] + z.crop[3] / 2.0, base.crop[1] + base.crop[3] / 2.0) { ok = false; io.print("centre y") }
        // the same aspect
        if !near(z.crop[2] / z.crop[3], base.crop[2] / base.crop[3]) { ok = false; io.print("aspect") }
        // inside the picture: both ends of the window in 0..1
        let x0: f64 = z.crop[0]
        let x1: f64 = z.crop[0] + z.crop[2]
        if x0 < 0.0 - 0.000001 || x0 > 1.000001 || x1 < 0.0 - 0.000001 || x1 > 1.000001 { ok = false; io.print("outside x") }
        mi = mi + 1
    }
    var c: campreview.CamPreview = campreview.cp_new()
    campreview.cp_set_zoom(&c, 0.5)
    if !near(c.zoom, 1.0) { ok = false; io.print("clamp low") }
    campreview.cp_set_zoom(&c, 99.0)
    if !near(c.zoom, 16.0) { ok = false; io.print("clamp high") }
    if ok { io.print("ok") }
    return 0
}
