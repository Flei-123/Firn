// expect_exit: 0
// tests/1334_type_aliases.fi -- the second spelling of the primitive types
// (round 70, SPEC 13).
//
// `int` IS `i32` -- not a new type, only another name. That is why
// everything here works WITHOUT a single cast: an `int` goes into an `i32`
// parameter, an `i64` comes back out of a `long` result, and
// `impl Ord for int` produces the very same method as `impl Ord for i32`.
//
// The two promises of this round, both checked below:
//   * `int` is ALWAYS 32 bits, `long` ALWAYS 64 -- no platform dependence.
//   * `byte` is UNSIGNED (0..255), `sbyte` is i8.
interface Ord2 { fn less(*self, b: *Self) -> bool }
impl Ord2 for int { fn less(*self, b: *int) -> bool { return *self < *b } }

fn takes_i32(a: i32) -> i32 { return a }
fn takes_int(a: int) -> int { return a }
fn takes_u8(a: u8) -> u8 { return a }
fn takes_byte(a: byte) -> byte { return a }

fn main() -> i32 {
    // the same type in both directions, without a cast
    let a: int = 3
    let b: i32 = takes_int(a) + takes_i32(a)
    if b != 6 { return 1 }
    let c: long = 5
    let d: i64 = c
    if d != 5 { return 2 }

    // the widths are fixed
    if size_of[int]() != 4 { return 3 }
    if size_of[long]() != 8 { return 4 }
    if size_of[short]() != 2 { return 5 }
    if size_of[sbyte]() != 1 { return 6 }
    if size_of[byte]() != 1 { return 7 }
    if size_of[ushort]() != 2 { return 8 }
    if size_of[uint]() != 4 { return 9 }
    if size_of[ulong]() != 8 { return 10 }
    if size_of[double]() != 8 { return 11 }
    if size_of[int]() != size_of[i32]() { return 12 }
    if size_of[long]() != size_of[i64]() { return 13 }

    // `byte` is UNSIGNED: 200 fits, and it stays 200
    let e: byte = 200 as byte
    if takes_u8(e) != 200 as u8 { return 14 }
    if takes_byte(200 as u8) != 200 as byte { return 15 }
    if (e as int) != 200 { return 16 }
    // `sbyte` is signed: -3 stays -3
    let f: sbyte = -3 as sbyte
    if (f as int) != -3 { return 17 }
    // unsigned goes all the way up
    let g: ulong = 18446744073709551615 as ulong
    if g != 18446744073709551615 { return 18 }
    let h: uint = 4294967295 as uint
    if (h as ulong) != 4294967295 { return 19 }

    // f64 under its second name
    let x: double = 1.5
    let y: f64 = x + 0.5
    if y != 2.0 { return 20 }

    // the method of the alias IS the method of the canonical type
    var p: int = 3
    var q: i32 = 9
    if !p.less(&q) { return 21 }
    if q.less(&p) { return 22 }

    // arrays and pointers with the second spelling
    var arr: [int; 3] = [1, 2, 3]
    let ptr: *mut int = &arr[0]
    *ptr = 7
    if arr[0] != 7 { return 23 }
    return 0
}
