// expect_exit: 7
// Error unions (SPEC 5.1): implicit conversion at 'return' -- a value
// becomes the success case, an error variant becomes the error. No 'ok(...)'.
error IoError { NotFound, Permission, Closed }

fn read(x: i32) -> IoError!i32 {
    if x < 0 {
        return IoError::NotFound
    }
    return x + 7
}

fn main() -> i32 {
    let good = read(0) catch 99
    if good != 7 {
        return 1
    }
    let bad = read(0 - 1) catch 99
    if bad != 99 {
        return 2
    }
    return good
}
