// expect_exit: 139
// wasm_skip: a null dereference is harmless in the wasm linear memory (exit 0), natively a SIGSEGV
// r904: the stack overflow handler only claims faults next to the stack pointer; a null dereference is still a plain SIGSEGV (139).
fn main() -> i32 {
    let p: *mut i64 = 0 as *mut i64
    let v: i64 = *p
    return v as i32
}
