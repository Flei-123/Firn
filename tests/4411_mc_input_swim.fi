// expect_exit: 0
// tests/4411_mc_input_swim.fi -- water / lava movement (acceleration 0.02, drag 0.8 / 0.9 / 0.5, sinking, buoyancy 0.04, sneak sink, swimming,
// ledge exit boost) and ladders (clamp 0.15, climb 0.1176 per tick, sneak hold) with the u8 movement kinds of mc_move_fluid.
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_input
import mc.mc_math
import mc.mc_move_fluid

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000000001
}


fn near2(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0005
}

fn put(ids: u64, x: i32, ly: i32, z: i32, id: u16) {
    rt.st16(ids, ((ly * 16 + z) * 16 + x) as usize, id)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

fn publish(w: *mut mc_world.World, ids: u64) {
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

fn fill(ids: u64, x0: i32, x1: i32, ly0: i32, ly1: i32, z0: i32, z1: i32, id: u16) {
    var ly: i32 = ly0
    while ly <= ly1 {
        var z: i32 = z0
        while z <= z1 {
            var x: i32 = x0
            while x <= x1 {
                put(ids, x, ly, z, id)
                x = x + 1
            }
            z = z + 1
        }
        ly = ly + 1
    }
}

fn tick(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32) {
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = keys
    mc_input.player_tick(p, &ev, w, tb, 0 - 64)
}

fn walk(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) {
    var t: i32 = 0
    while t < ticks {
        tick(p, w, tb, keys)
        t = t + 1
    }
}

const STONE: u16 = 1 as u16
const WATER: u16 = 2 as u16
const LAVA: u16 = 3 as u16
const LADDER: u16 = 4 as u16

fn base_ids() -> u64 {
    let ids: u64 = new_ids()
    fill(ids, 0, 15, 0, 2, 0, 15, STONE)
    return ids
}

fn new_player(x: f64, y: f64, z: f64) -> mc_input.Player {
    var p: mc_input.Player = mc_input.player_new(x, y, z)
    rt.st8(p.mv, WATER as usize, mc_move_fluid.fluid_kind(false, 8) as u8)
    rt.st8(p.mv, LAVA as usize, mc_move_fluid.fluid_kind(true, 8) as u8)
    rt.st8(p.mv, LADDER as usize, mc_move_fluid.MV_LADDER as u8)
    return p
}

fn main() -> i32 {
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(8), solid: rt.heap_alloc(16), n: 8 }
    var i: usize = 0
    while i < 8 {
        rt.st8(tb.pick, i, 1 as u8)
        rt.st16(tb.solid, i, 0 as u16)
        i = i + 1
    }
    rt.st16(tb.solid, STONE as usize, 1 as u16)

    var ids: u64 = base_ids()
    fill(ids, 0, 15, 3, 12, 0, 15, WATER)
    var w: mc_world.World = mc_world.world_new()
    publish(&w, ids)

    var s: mc_input.Player = new_player(8.5, 0.0 - 52.0, 4.5)
    walk(&s, &w, &tb, 0 as u32, 60)
    check(s.vy < 0.0 - 0.0245 && s.vy > 0.0 - 0.0255, 1)
    check(s.y < 0.0 - 52.0 && s.y > 0.0 - 61.0, 2)

    var f: mc_input.Player = new_player(8.5, 0.0 - 58.0, 4.5)
    walk(&f, &w, &tb, mc_input.K_FORWARD, 40)
    var z0: f64 = f.z
    walk(&f, &w, &tb, mc_input.K_FORWARD, 1)
    check(f.z - z0 > 0.0995 && f.z - z0 < 0.1005, 3)
    check(f.vx < 0.0001 && f.vx > 0.0 - 0.0001, 4)

    var j: mc_input.Player = new_player(8.5, 0.0 - 58.0, 4.5)
    walk(&j, &w, &tb, mc_input.K_JUMP, 25)
    check(j.vy > 0.12 && j.vy < 0.14, 5)
    check(j.y > 0.0 - 58.0 + 1.5, 6)

    var n: mc_input.Player = new_player(8.5, 0.0 - 52.0, 4.5)
    walk(&n, &w, &tb, mc_input.K_SNEAK, 25)
    check(n.vy < 0.0 - 0.15 && n.vy > 0.0 - 0.19, 7)

    var sw: mc_input.Player = new_player(8.5, 0.0 - 58.0, 1.0)
    walk(&sw, &w, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 60)
    z0 = sw.z
    walk(&sw, &w, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 1)
    check(sw.sprinting, 8)
    check(sw.z - z0 > 0.195 && sw.z - z0 < 0.205, 9)
    check(sw.y < 0.0 - 57.9 && sw.y > 0.0 - 58.1, 10)
    mc_world.world_free(&w)

    var ids2: u64 = base_ids()
    fill(ids2, 0, 15, 3, 3, 0, 15, WATER)
    var w2: mc_world.World = mc_world.world_new()
    publish(&w2, ids2)
    var sf: mc_input.Player = new_player(8.5, 0.0 - 61.0, 4.5)
    walk(&sf, &w2, &tb, 0 as u32, 5)
    walk(&sf, &w2, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 60)
    z0 = sf.z
    walk(&sf, &w2, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 1)
    check(!sf.sprinting, 11)
    check(sf.z - z0 > 0.0995 && sf.z - z0 < 0.1005, 12)
    mc_world.world_free(&w2)

    var ids3: u64 = base_ids()
    fill(ids3, 0, 15, 3, 12, 0, 15, LAVA)
    var w3: mc_world.World = mc_world.world_new()
    publish(&w3, ids3)
    var lv: mc_input.Player = new_player(8.5, 0.0 - 55.0, 4.5)
    walk(&lv, &w3, &tb, mc_input.K_FORWARD, 50)
    z0 = lv.z
    walk(&lv, &w3, &tb, mc_input.K_FORWARD, 1)
    check(lv.z - z0 > 0.0395 && lv.z - z0 < 0.0405, 13)
    check(lv.vy < 0.0 - 0.0395 && lv.vy > 0.0 - 0.0405, 14)
    mc_world.world_free(&w3)

    var ids4: u64 = base_ids()
    fill(ids4, 0, 15, 3, 12, 0, 15, WATER)
    fill(ids4, 12, 15, 3, 4, 0, 15, STONE)
    fill(ids4, 0, 15, 5, 12, 0, 15, 0 as u16)
    fill(ids4, 0, 11, 3, 4, 0, 15, WATER)
    var w4: mc_world.World = mc_world.world_new()
    publish(&w4, ids4)
    var ex: mc_input.Player = new_player(10.5, 0.0 - 59.5, 4.5)
    var yaw_east: f64 = 0.0 - 90.0
    ex.yaw = yaw_east
    walk(&ex, &w4, &tb, mc_input.K_FORWARD | mc_input.K_JUMP, 80)
    check(ex.x > 12.3, 15)
    check(ex.y > 0.0 - 59.01, 16)
    mc_world.world_free(&w4)

    var ids5: u64 = base_ids()
    fill(ids5, 8, 8, 3, 10, 4, 4, LADDER)
    var w5: mc_world.World = mc_world.world_new()
    publish(&w5, ids5)
    var cl: mc_input.Player = new_player(8.5, 0.0 - 61.0, 4.5)
    walk(&cl, &w5, &tb, 0 as u32, 3)
    walk(&cl, &w5, &tb, mc_input.K_JUMP, 6)
    var y0: f64 = cl.y
    walk(&cl, &w5, &tb, mc_input.K_JUMP, 1)
    check(near2(cl.y - y0, 0.1176), 17)
    y0 = cl.y
    walk(&cl, &w5, &tb, mc_input.K_JUMP, 1)
    check(near2(cl.y - y0, 0.1176), 18)
    walk(&cl, &w5, &tb, mc_input.K_SNEAK, 8)
    y0 = cl.y
    walk(&cl, &w5, &tb, mc_input.K_SNEAK, 3)
    check(near2(cl.y - y0, 0.0), 19)
    walk(&cl, &w5, &tb, 0 as u32, 6)
    y0 = cl.y
    walk(&cl, &w5, &tb, 0 as u32, 1)
    check(near2(cl.y - y0, 0.0 - 0.15), 20)
    check(cl.fall < 0.2, 21)
    mc_world.world_free(&w5)

    if g_fail != 0 { return 1 }
    return 0
}
