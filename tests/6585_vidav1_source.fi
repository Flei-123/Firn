// expect_exit: 0
import std.rt
import std.fs
import fui.kpcodecvid
import media.video.vidops

fn frame_sum(p: u64, nb: usize) -> u64 {
    var s: u64 = 0
    var i: usize = 0
    while i < nb {
        s = s + (rt.ld8(p, i) as u64)
        i = i + 1
    }
    return s
}

fn check(path: str, w: u32, h: u32, count: i64, total: u64, last: u64, seek_us: i64, tail: u64) -> i32 {
    var b: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(path, &b) catch | e | (0 -% 1)
    if got == (0 -% 1) {
        return 1
    }
    let ops: vidops.VideoOps = kpcodecvid.video_ops()
    let hd: u64 = ops.create()
    if ops.open(hd, b.ptr, rt.buf_len(&b)) != vidops.VO_OK {
        ops.destroy(hd)
        return 2
    }
    if ops.width(hd) != w || ops.height(hd) != h {
        return 3
    }
    let nb: usize = ops.rgba_bytes(hd)
    let out: u64 = rt.heap_alloc(nb) as u64
    var pts: i64 = 0
    var prev: i64 = -1
    var n: i64 = 0
    var sum: u64 = 0
    var lastsum: u64 = 0
    var sorted: bool = true
    while ops.next_frame(hd, out, &pts) == 1 {
        if pts <= prev {
            sorted = false
        }
        prev = pts
        lastsum = frame_sum(out, nb)
        sum = sum + lastsum
        n = n + 1
    }
    var ok: bool = sorted && n == count && sum == total && lastsum == last
    let k: i64 = ops.seek(hd, seek_us)
    var first: bool = true
    var after: u64 = 0
    var m: i64 = 0
    while ops.next_frame(hd, out, &pts) == 1 {
        if first && pts != k {
            ok = false
        }
        first = false
        after = after + frame_sum(out, nb)
        m = m + 1
    }
    ok = ok && m >= 1 && after == tail
    let z: i64 = ops.seek(hd, 0)
    ok = ok && z == 0 && ops.next_frame(hd, out, &pts) == 1 && pts == 0
    rt.heap_free(out, nb)
    ops.close(hd)
    ops.destroy(hd)
    if !ok {
        return 4
    }
    return 0
}

fn main() -> i32 {
    if check("testdata/media_video/av1_inter.webm", 64 as u32, 48 as u32, 25, 34508549 as u64, 1383193 as u64, 500000, 17942736 as u64) != 0 {
        return 1
    }
    if check("testdata/media_video/av1_inter.mp4", 64 as u32, 48 as u32, 25, 34508549 as u64, 1383193 as u64, 500000, 17942736 as u64) != 0 {
        return 2
    }
    if check("testdata/media_video/av1_arf.webm", 100 as u32, 62 as u32, 50, 152466412 as u64, 3041123 as u64, 500000, 152466412 as u64) != 0 {
        return 3
    }
    if check("testdata/media_video/av1_10bit.webm", 64 as u32, 48 as u32, 25, 34506296 as u64, 1383082 as u64, 500000, 17940874 as u64) != 0 {
        return 4
    }
    if check("testdata/media_video/av1_grain.mp4", 64 as u32, 48 as u32, 25, 34602954 as u64, 1386047 as u64, 500000, 34602954 as u64) != 0 {
        return 5
    }
    return 0
}
