// expect_exit: 0
import std.lanes.vf8

struct Pair { a: i64, b: i64 }
struct Quad { x: i32, y: i32, z: i64, w: f32 }
struct Outer { first: Pair, second: Pair }

fn mix(p: Pair, q: Pair) -> Pair {
    return Pair { a: p.a + q.b, b: p.b * 2 + q.a }
}

fn step(t: Quad, i: i32) -> Quad {
    return Quad { x: t.x + i, y: t.y + 2, z: t.z + (i * i) as i64, w: t.w + (0.5 as f32) }
}

fn lanes_sum() -> f32 {
    var acc: vf8.f32x8 = vf8.zero()
    let one: vf8.f32x8 = vf8.splat(1.0 as f32)
    var i: i32 = 0
    while i < 10 {
        let before: vf8.f32x8 = acc
        acc = before.add(one)
        i = i + 1
    }
    return acc.hsum()
}

fn main() -> i32 {
    var acc: Quad = Quad { x: 0, y: 0, z: 0, w: 0.0 as f32 }
    var i: i32 = 0
    while i < 100 {
        let t: Quad = acc
        acc = step(t, i)
        i = i + 1
    }
    if acc.x != 4950 { return 1 }
    if acc.y != 200 { return 2 }
    if acc.z != 328350 { return 3 }
    if acc.w != (50.0 as f32) { return 4 }

    var p: Pair = Pair { a: 1, b: 2 }
    let q: Pair = Pair { a: 10, b: 20 }
    var n: i32 = 0
    while n < 3 {
        let old: Pair = p
        p = mix(old, q)
        n = n + 1
    }
    if p.a != 61 { return 5 }
    if p.b != 86 { return 6 }

    var o: Outer = Outer { first: Pair { a: 3, b: 4 }, second: Pair { a: 5, b: 6 } }
    let keep: Pair = o.first
    o.first = o.second
    o.second = keep
    if o.first.a != 5 { return 7 }
    if o.first.b != 6 { return 8 }
    if o.second.a != 3 { return 9 }
    if o.second.b != 4 { return 10 }

    if lanes_sum() != (80.0 as f32) { return 11 }
    return 0
}
