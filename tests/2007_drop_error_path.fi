// expect_exit: 0
// ROUND OWN-2: the error path (`try`) leaves through the same cleanup as the
// ordinary one: the locals that own a value are dropped in reverse order.
static mut LOG: i64 = 0
error E { Broken }
struct G { id: i64 }
impl G { fn drop(inout self) { LOG = LOG * 10 + self.id } }
fn mk(i: i64) -> G { return G { id: i } }
fn can(x: i32) -> E!i32 {
    if x < 0 { return E::Broken }
    return x * 2
}
fn work(x: i32) -> E!i32 {
    let a: G = mk(1)
    let w: i32 = try can(x)
    let b: G = mk(2)
    return w + 1
}
fn main() -> i32 {
    let r: E!i32 = work(5)
    if LOG != 21 { return 1 }
    LOG = 0
    let q: E!i32 = work(-1)
    if LOG != 1 { return 2 }
    return 0
}
