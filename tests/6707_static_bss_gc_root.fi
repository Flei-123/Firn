// expect_exit: 0
import std.vec

static mut ODD_DATA: [u8; 5] = [1 as u8, 2 as u8, 3 as u8, 4 as u8, 5 as u8]
static mut ROOT_A: Vec[str] = Vec[str] { ptr: 0, len: 0, cap: 0 }
static mut ROOT_B: Vec[str] = Vec[str] { ptr: 0, len: 0, cap: 0 }
static mut ROOT_C: Vec[str] = Vec[str] { ptr: 0, len: 0, cap: 0 }

fn churn(rounds: u32) -> u64 {
    var k: u32 = 0
    var sum: u64 = 0
    while k < rounds {
        let s: str = "garbage-" + "0123456789abcdef0123456789abcdef"
        sum = sum + s.n as u64
        k = k + 1
    }
    return sum
}

fn vec_addr(v: *mut Vec[str]) -> u64 {
    return v as u64
}

fn first_is(v: *mut Vec[str], want: str) -> bool {
    if vec_len[str](v) != 1 { return false }
    let p: u64 = vec_elem_ptr[str](v, 0) as u64
    let s: str = *(p as *mut str)
    return s == want
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    if vec_addr(&ROOT_A) % 8 != 0 { return 9 }
    if vec_addr(&ROOT_B) % 8 != 0 { return 10 }
    if vec_addr(&ROOT_C) % 8 != 0 { return 11 }
    ROOT_A = vec_new[str]()
    ROOT_B = vec_new[str]()
    ROOT_C = vec_new[str]()
    if !vec_push[str](&ROOT_A, "alpha-" + "0123456789abcdef") { return 2 }
    if !vec_push[str](&ROOT_B, "beta-" + "0123456789abcdef") { return 3 }
    if !vec_push[str](&ROOT_C, "gamma-" + "0123456789abcdef") { return 4 }
    var round: u32 = 0
    while round < 6 {
        gc_collect()
        if churn(100000) == 0 { return 5 }
        if !first_is(&ROOT_A, "alpha-0123456789abcdef") { return 6 }
        if !first_is(&ROOT_B, "beta-0123456789abcdef") { return 7 }
        if !first_is(&ROOT_C, "gamma-0123456789abcdef") { return 8 }
        round = round + 1
    }
    return 0
}
