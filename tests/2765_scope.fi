// expect_exit: 0
// tests/2765_scope.fi -- std.scope: Arena, Scope (release stack), Tracker.
//
// A  Arena: aligned blocks, no overlap, reset reuses the memory, big requests
// B  (reserved)
// C  Scope: releases in REVERSE order, at the end of the block, on `return`,
//    on `break`; scope_cancel keeps one handle; close twice is harmless
// D  Scope moved into a function that drops it
// E  Tracker: acquire/release balance, live count per kind
import std.rt
import std.scope

static mut LOG: u64 = 0

fn rel(h: u64) {
    LOG = LOG * 10 + h
    scope.track_release(3)
}

fn rel2(h: u64) {
    scope.track_release(3)
}

fn arena_test() -> i32 {
    var a: scope.Arena = scope.arena_new(1024)
    var ptrs: [u64; 200] = [0; 200]
    var i: u64 = 0
    while i < 200 {
        let al: u64 = 1 << (i % 6) // 1 .. 32
        let n: u64 = 7 + (i * 13) % 90
        let p: u64 = scope.arena_alloc_zero(&a, n, al)
        if p == 0 { return 1 }
        if p % al != 0 { return 2 }
        // fill with a pattern that names the block
        var k: u64 = 0
        while k < n {
            if rt.ld8(p, k as usize) != 0 as u8 { return 3 }
            rt.st8(p, k as usize, (i & 255) as u8)
            k = k + 1
        }
        ptrs[i as usize] = p
        i = i + 1
    }
    // nothing was overwritten by a later block
    i = 0
    while i < 200 {
        let n: u64 = 7 + (i * 13) % 90
        var k: u64 = 0
        while k < n {
            if rt.ld8(ptrs[i as usize], k as usize) != (i & 255) as u8 { return 4 }
            k = k + 1
        }
        i = i + 1
    }
    if scope.arena_blocks(&a) < 2 { return 5 }
    let b1: u64 = scope.arena_blocks(&a)
    // a request bigger than a block
    let big: u64 = scope.arena_alloc(&a, 5000, 64)
    if big == 0 || big % 64 != 0 { return 6 }
    rt.mem_set(big, 7 as u8, 5000)
    // reset: same memory is handed out again, no new blocks for the same load
    scope.arena_reset(&a)
    if scope.arena_used(&a) != 0 { return 7 }
    let q: u64 = scope.arena_alloc(&a, 16, 16)
    if q != ptrs[0] && q == 0 { return 8 }
    i = 0
    while i < 150 {
        if scope.arena_alloc(&a, 64, 8) == 0 { return 9 }
        i = i + 1
    }
    if scope.arena_blocks(&a) > b1 + 1 { return 10 }
    return 0
}

fn scope_basic() -> i32 {
    LOG = 0
    {
        var s: scope.Scope = scope.scope_new()
        scope.track_acquire(3)
        scope.scope_add(&s, rel, 1)
        scope.track_acquire(3)
        scope.scope_add(&s, rel, 2)
        scope.track_acquire(3)
        scope.scope_add(&s, rel, 3)
        if scope.scope_len(&s) != 3 { return 20 }
    }
    if LOG != 321 { return 21 }
    if scope.track_live(3) != 0 { return 22 }
    return 0
}

fn scope_early(c: bool) -> u64 {
    var s: scope.Scope = scope.scope_new()
    scope.track_acquire(3)
    scope.scope_add(&s, rel, 4)
    if c {
        return 99
    }
    scope.track_acquire(3)
    scope.scope_add(&s, rel, 5)
    return 98
}

fn scope_loop() {
    var i: u64 = 0
    while i < 10 {
        var s: scope.Scope = scope.scope_new()
        scope.track_acquire(3)
        scope.scope_add(&s, rel, 6)
        i = i + 1
        if i == 3 { break }
    }
}

fn scope_cancel_close() -> i32 {
    LOG = 0
    var s: scope.Scope = scope.scope_new()
    scope.track_acquire(3)
    scope.scope_add(&s, rel, 7)
    scope.track_acquire(3)
    scope.scope_add(&s, rel, 8)
    scope.track_acquire(3)
    scope.scope_add(&s, rel, 9)
    if !scope.scope_cancel(&s, 8) { return 1 }
    if scope.scope_cancel(&s, 12345) { return 2 }
    scope.track_release(3) // handle 8 now belongs to somebody else; he releases it
    scope.scope_close(&s)
    if LOG != 97 { return 3 }
    scope.scope_close(&s) // twice: nothing happens
    if LOG != 97 { return 4 }
    // reusable after close
    scope.track_acquire(3)
    scope.scope_add(&s, rel, 5)
    scope.scope_close(&s)
    if LOG != 975 { return 5 }
    return 0
}

fn scope_many() -> i32 {
    LOG = 0
    var s: scope.Scope = scope.scope_new()
    var i: u64 = 0
    while i < 1000 {
        scope.track_acquire(3)
        if !scope.scope_add(&s, rel2, i % 7 + 1) { return 1 }
        i = i + 1
    }
    if scope.scope_len(&s) != 1000 { return 2 }
    scope.scope_close(&s)
    if scope.track_live(3) != 0 { return 3 }
    return 0
}

fn consume(s: scope.Scope) {
    // `s` dies at the end of this function
}

fn main() -> i32 {
    let r: i32 = arena_test()
    if r != 0 { return r }

    let r2: i32 = scope_basic()
    if r2 != 0 { return r2 }

    LOG = 0
    if scope_early(true) != 99 { return 30 }
    if LOG != 4 { return 31 }
    LOG = 0
    if scope_early(false) != 98 { return 32 }
    if LOG != 54 { return 33 }
    LOG = 0
    scope_loop()
    if LOG != 666 { return 34 }
    if scope.track_live(3) != 0 { return 35 }

    let r3: i32 = scope_cancel_close()
    if r3 != 0 { return 40 + r3 }
    let r4: i32 = scope_many()
    if r4 != 0 { return 50 + r4 }

    LOG = 0
    {
        var s: scope.Scope = scope.scope_new()
        scope.track_acquire(3)
        scope.scope_add(&s, rel, 3)
        scope.track_acquire(3)
        scope.scope_add(&s, rel, 4)
        consume(s)
        if LOG != 43 { return 60 }
    }
    if LOG != 43 { return 61 } // not released a second time
    if scope.track_live(3) != 0 { return 62 }

    // out of range kinds are ignored
    scope.track_acquire(99)
    if scope.track_live(99) != 0 { return 63 }
    return 0
}
