// expect_exit: 0
// Round TUPLES (docs/GAPS.md B5): `(A, B)` is a type, `(a, b)` builds one,
// `t.0` reads an element, `let (a, b) = f()` takes one apart, and a function
// returns several values with `-> (A, B)`. A tuple is a struct whose fields
// are called 0, 1, ..: same layout, same passing and returning.
struct Inner { a: i64, b: i64 }
struct Outer { pair: (Inner, i32), tag: u8 }

// a tuple in a struct field whose element struct is declared further down
struct Early { t: (Late, i32), u: u8 }
struct Late { a: i64, b: i64 }
struct Twice { x: (Early, Early) }

type Pair = (i32, i32)
type Quad = (Pair, Pair)

fn divmod(a: i32, b: i32) -> (i32, i32) {
    return (a / b, a % b)
}

fn first_of(t: (i32, i64, u8)) -> i32 {
    return t.0
}

fn mixed(x: (u8, i64, u8)) -> (u8, i64, u8) {
    return (x.2, x.1 + 1, x.0)
}

fn pick(p: *(i32, i32)) -> i32 {
    return (*p).1
}

fn bump(p: *mut (i32, i32)) {
    (*p).0 = (*p).0 + 1
    (*p).1 = (*p).1 + 10
}

fn sum_arr(a: [(i32, i32); 3]) -> i32 {
    var s: i32 = 0
    var i: usize = 0
    while i < 3 {
        s = s + a[i].0 * a[i].1
        i = i + 1
    }
    return s
}

fn read_ref(p: &(i32, i32)) -> i32 {
    return p.0 + p.1
}

fn write_ref(p: inout (i32, i32)) {
    p.0 = 5
}

fn mk(a: i32, b: i32) -> Pair {
    return (a, b)
}

fn sum_quad(q: Quad) -> i32 {
    return q.0.0 + q.0.1 + q.1.0 + q.1.1
}

fn main() -> i32 {
    // several return values, taken apart
    let (q, r) = divmod(17, 5)
    if q != 3 || r != 2 {
        return 1
    }
    // the elements by number
    let t = (1, 2)
    if t.0 != 1 || t.1 != 2 {
        return 2
    }
    // the type from the context, the element types from the type
    let u: (i64, u8) = (10, 3)
    if u.0 != 10 || u.1 != 3 {
        return 3
    }
    // a tuple in a struct, with a struct in the tuple
    var o = Outer { pair: (Inner { a: 1, b: 2 }, 7), tag: 9 }
    if o.pair.0.b != 2 || o.pair.1 != 7 || o.tag != 9 {
        return 5
    }
    o.pair.1 = 8
    if o.pair.1 != 8 {
        return 6
    }
    // parameters and results of several sizes
    if first_of((5, 6, 7)) != 5 {
        return 7
    }
    let m = mixed((5, 100, 6))
    if m.0 != 6 || m.1 != 101 || m.2 != 5 {
        return 8
    }
    // through a pointer
    var pr = (11, 22)
    if pick(&pr) != 22 {
        return 9
    }
    bump(&pr)
    if pr.0 != 12 || pr.1 != 32 {
        return 10
    }
    // an array of tuples
    let arr: [(i32, i32); 3] = [(1, 2), (3, 4), (5, 6)]
    if sum_arr(arr) != 2 + 12 + 30 {
        return 11
    }
    // assignment, and the swap that reads the place it writes
    var s = (1, 2)
    s = (s.1, s.0)
    if s.0 != 2 || s.1 != 1 {
        return 13
    }
    s.0 = 40
    if s.0 != 40 {
        return 14
    }
    // an alias for a tuple type, and tuples of tuples
    let qd: Quad = (mk(1, 2), mk(3, 4))
    if sum_quad(qd) != 10 {
        return 15
    }
    let ((a, b), (c, d)) = qd
    if a + b + c + d != 10 {
        return 16
    }
    // `_` skips an element, `var` makes the names writable
    let (_, second) = divmod(9, 4)
    if second != 1 {
        return 17
    }
    var (lo, hi) = (1, 2)
    lo = lo + 5
    hi += 7
    if lo != 6 || hi != 9 {
        return 18
    }
    // the same type spelled twice is one type
    let p1: (i32, i32) = mk(5, 6)
    let p2: Pair = p1
    if p2.1 != 6 {
        return 19
    }
    // reference parameters of a tuple type
    var rf = (1, 2)
    write_ref(inout rf)
    if read_ref(&rf) != 7 {
        return 23
    }
    // the order of the struct declarations does not matter to a tuple field
    var tw = Twice { x: (Early { t: (Late { a: 1, b: 2 }, 3), u: 4 }, Early { t: (Late { a: 5, b: 6 }, 7), u: 8 }) }
    tw.x.1.t.0.b = 9
    if tw.x.0.t.0.b != 2 || tw.x.1.t.0.b != 9 || tw.x.1.t.1 != 7 || tw.x.1.u != 8 {
        return 24
    }
    // other element kinds
    let f = (1.5, 2)
    if f.1 != 2 || f.0 < 1.4 {
        return 20
    }
    let w = (true, 3 as u8, 4 as i64)
    if !w.0 || w.1 != 3 || w.2 != 4 {
        return 21
    }
    // a trailing comma is fine in the literal and in the type
    let tc: (i32, i32,) = (1, 2,)
    if tc.1 != 2 {
        return 22
    }
    return 0
}
