// expect_exit: 0
// tests/4831_chan_close_timeout.fi -- lib/chan: close wakes blocked receivers and senders, send after close fails,
// receive drains the rest, recv_timeout (timeout, result, closed, zero wait).
import std.rt
import std.time
import chan.chan

static mut g_blk: u64 = 0

fn __thread_work(kind: u64, arg: u64) -> u64 {
    var c: chan.Chan = chan.Chan { blk: g_blk }
    var v: u64 = 0
    if kind == 1 {
        if chan.chan_recv(&c, &v) { return 0 }
        return 1
    }
    if kind == 2 {
        var x: u64 = 5
        while chan.chan_send(&c, &x) {
        }
        return 1
    }
    if kind == 3 {
        time.sleep_ms(arg)
        var y: u64 = 4242
        if chan.chan_send(&c, &y) { return 1 }
        return 0
    }
    return 9
}

fn main() -> i32 {
    var c: chan.Chan = chan.chan_new(4, 1)
    g_blk = c.blk
    var v: u64 = 0

    let h1: u64 = thread_start(1, 0)
    let h2: u64 = thread_start(1, 0)
    time.sleep_ms(60)
    chan.chan_close(&c)
    if thread_wait(h1) != 1 { return 1 }
    if thread_wait(h2) != 1 { return 2 }
    if !chan.chan_is_closed(&c) { return 3 }
    chan.chan_close(&c)
    chan.chan_free(&c)

    var d: chan.Chan = chan.chan_new(4, 1)
    g_blk = d.blk
    let h3: u64 = thread_start(2, 0)
    let h4: u64 = thread_start(2, 0)
    time.sleep_ms(60)
    let len_before: u64 = chan.chan_len(&d)
    chan.chan_close(&d)
    if thread_wait(h3) != 1 { return 4 }
    if thread_wait(h4) != 1 { return 5 }
    if len_before != 4 { return 6 }
    var drained: u64 = 0
    while chan.chan_recv(&d, &v) {
        if v != 5 { return 7 }
        drained = drained + 1
    }
    if drained < 4 { return 8 }
    if chan.chan_try_recv(&d, &v) { return 9 }
    chan.chan_free(&d)

    var e: chan.Chan = chan.chan_new(8, 1)
    var one: u64 = 1
    var two: u64 = 2
    chan.chan_send(&e, &one)
    chan.chan_send(&e, &two)
    chan.chan_close(&e)
    if chan.chan_send(&e, &one) { return 10 }
    if chan.chan_try_send(&e, &one) { return 11 }
    if chan.chan_send1(&e, 3) { return 12 }
    if chan.chan_len(&e) != 2 { return 13 }
    if !chan.chan_recv(&e, &v) { return 14 }
    if v != 1 { return 15 }
    if chan.chan_recv_timeout(&e, &v, 1000) != 0 { return 16 }
    if v != 2 { return 17 }
    if chan.chan_recv(&e, &v) { return 18 }
    if chan.chan_recv_timeout(&e, &v, 1000) != 2 { return 19 }
    chan.chan_free(&e)

    var f: chan.Chan = chan.chan_new(8, 1)
    g_blk = f.blk
    let t0: u64 = time.monotonic_ns()
    if chan.chan_recv_timeout(&f, &v, 80) != 1 { return 20 }
    let dt: u64 = (time.monotonic_ns() - t0) / 1000000
    if dt < 75 { return 21 }
    if dt > 3000 { return 22 }
    let t1: u64 = time.monotonic_ns()
    if chan.chan_recv_timeout(&f, &v, 0) != 1 { return 23 }
    if (time.monotonic_ns() - t1) / 1000000 > 500 { return 24 }
    chan.chan_send1(&f, 77)
    if chan.chan_recv_timeout(&f, &v, 5000) != 0 { return 25 }
    if v != 77 { return 26 }
    let h5: u64 = thread_start(3, 60)
    let t2: u64 = time.monotonic_ns()
    if chan.chan_recv_timeout(&f, &v, 5000) != 0 { return 27 }
    if v != 4242 { return 28 }
    let dt2: u64 = (time.monotonic_ns() - t2) / 1000000
    if dt2 < 40 { return 29 }
    if dt2 > 2000 { return 30 }
    if thread_wait(h5) != 1 { return 31 }
    let h6: u64 = thread_start(3, 10)
    thread_wait(h6)
    chan.chan_recv(&f, &v)
    let h7: u64 = thread_start(1, 0)
    time.sleep_ms(30)
    chan.chan_send1(&f, 1)
    if thread_wait(h7) != 0 { return 32 }
    chan.chan_free(&f)
    return 0
}
