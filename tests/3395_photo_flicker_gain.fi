// expect_out: ok
// tests/3395_photo_flicker_gain.fi -- FirnCam merge: local flicker / banding compensation (MergeOpts.flicker).
// (1) the REFERENCE carries row banding (+-25 % sine over the rows), four alternates are clean: with the
//     compensation the burst consensus wins and the band in the output nearly vanishes; without it the band stays.
// (2) a global flicker (one alternate 1.3x brighter, the others clean) leaves the output at the clean level.
// (3) a calm burst: compensation on equals compensation off (all multipliers 1).
// (4) two frames only: no consensus is possible, the option is a no-op.
// (6) refine_reference prefers a frame with calm local brightness.
// (5) a real local change (a patch present in 2 of 5 frames) is NOT averaged in: the output keeps the majority.
import std.io
import std.rt
import photo.image
import photo.meta
import photo.noise
import photo.merge

const W: i32 = 96
const H: i32 = 64

fn model() -> noise.NoiseModel {
    var m: meta.SensorMeta = meta.meta_default()
    var k: usize = 0
    while k < 4 {
        meta.meta_set_noise(&m, k, 2.0e-3f, 2.0e-5f)
        k = k + 1
    }
    return noise.from_meta(&m)
}

// soft gradient scene, value in 0.2..0.55 (flat enough for the gain estimate)
fn base_at(x: i32, y: i32) -> f32 {
    return 0.25f + 0.20f * (x as f32) / (W as f32) + 0.10f * (y as f32) / (H as f32)
}

fn sine(v: f32) -> f32 {
    // sine by Taylor around the wrapped phase (no libm needed): v in radians
    var t: f32 = v
    let tp: f32 = 6.2831853f
    while t > tp { t = t - tp }
    while t < 0.0f { t = t + tp }
    if t > 3.1415927f {
        let u: f32 = t - 3.1415927f
        return 0.0f - sin_half(u)
    }
    return sin_half(t)
}

// sin on [0, pi] via the parabola approximation (max error 0.001)
fn sin_half(x: f32) -> f32 {
    let p: f32 = 3.1415927f
    let a: f32 = 4.0f * x * (p - x) / (p * p)
    return a * (0.775f + 0.225f * a)
}

// tiny deterministic noise
fn jitter(seed: u32, x: i32, y: i32) -> f32 {
    var h: u32 = seed *% (2654435761 as u32) +% ((x * 7919 + y * 104729) as u32)
    h = h ^ (h >> 13)
    h = h *% (1274126177 as u32)
    h = h ^ (h >> 16)
    return (((h & (1023 as u32)) as f32) / 1023.0f - 0.5f) * 0.004f
}

// kind 0: clean, 1: row banding amp, 2: global gain `amp`, 3: bright patch (+0.25) at x 40..63, y 24..39
fn frame(seed: u32, kind: i32, amp: f32) -> image.Image {
    var im: image.Image = image.img_new(W, H, 3)
    var y: i32 = 0
    while y < H {
        var x: i32 = 0
        while x < W {
            var v: f32 = base_at(x, y) + jitter(seed, x, y)
            if kind == 1 { v = v * (1.0f + amp * sine((y as f32) * 6.2831853f / 20.0f)) }
            if kind == 2 { v = v * amp }
            var c: i32 = 0
            while c < 3 {
                var pv: f32 = v * (1.0f - 0.1f * (c as f32))
                // kind 3: a coloured patch (red +0.25): a real scene change, not a gain
                if kind == 3 && c == 0 && x >= 40 && x < 64 && y >= 24 && y < 40 { pv = pv + 0.25f }
                image.img_set(&im, c, x, y, pv)
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return im
}

fn run(b: *mut merge.Burst, flicker: f32, out: *mut image.Image) {
    var nm: noise.NoiseModel = model()
    var mo: merge.MergeOpts = merge.merge_default()
    mo.flicker = flicker
    var vp: image.Image = image.img_new(1, 1, 1)
    var ws: image.Image = image.img_new(1, 1, 1)
    image.img_free(&vp)
    image.img_free(&ws)
    merge.merge_burst_opts(b, 0, &nm, &mo, out, &vp, &ws)
    image.img_free(&vp)
    image.img_free(&ws)
}

// RMS over the interior (margins 10) of out / ideal - 1 for channel 1 (ideal = 0.9 * base)
fn rel_rms(im: *mut image.Image) -> f32 {
    var s: f32 = 0.0f
    var n: f32 = 0.0f
    var y: i32 = 10
    while y < H - 10 {
        var x: i32 = 10
        while x < W - 10 {
            let r: f32 = image.img_get(im, 1, x, y) / (0.9f * base_at(x, y)) - 1.0f
            s = s + r * r
            n = n + 1.0f
            x = x + 1
        }
        y = y + 1
    }
    return image.sqrtf(s / n)
}

fn mean_diff(a: *mut image.Image, b: *mut image.Image) -> f32 {
    var m: f32 = 0.0f
    var y: i32 = 0
    while y < H {
        var x: i32 = 0
        while x < W {
            var d: f32 = image.img_get(a, 1, x, y) - image.img_get(b, 1, x, y)
            if d < 0.0f { d = 0.0f - d }
            if d > m { m = d }
            x = x + 1
        }
        y = y + 1
    }
    return m
}

fn check(name: str, cond: bool, ok: *mut bool) {
    if !cond {
        io.print("FAIL ")
        io.print_line(name)
        *ok = false
    }
}

fn main() -> i32 {
    var ok: bool = true

    // (1) banded reference, clean alternates
    var b1: merge.Burst = merge.burst_new()
    merge.burst_add(&b1, frame(1 as u32, 1, 0.25f), 1.0f)
    var s: i32 = 2
    while s < 6 {
        merge.burst_add(&b1, frame(s as u32, 0, 0.0f), 1.0f)
        s = s + 1
    }
    var o_off: image.Image = image.img_new(1, 1, 3)
    var o_on: image.Image = image.img_new(1, 1, 3)
    run(&b1, 0.0f, &o_off)
    run(&b1, 1.0f, &o_on)
    let r_off: f32 = rel_rms(&o_off)
    let r_on: f32 = rel_rms(&o_on)
    check("band stays without compensation", r_off > 0.05f, &ok)
    check("band removed with compensation", r_on < 0.5f * r_off && r_on < 0.04f, &ok)
    image.img_free(&o_off)
    image.img_free(&o_on)
    merge.burst_free(&b1)

    // (2) global flicker of one alternate
    var b2: merge.Burst = merge.burst_new()
    merge.burst_add(&b2, frame(1 as u32, 0, 0.0f), 1.0f)
    merge.burst_add(&b2, frame(2 as u32, 2, 1.3f), 1.0f)
    s = 3
    while s < 6 {
        merge.burst_add(&b2, frame(s as u32, 0, 0.0f), 1.0f)
        s = s + 1
    }
    var o2: image.Image = image.img_new(1, 1, 3)
    run(&b2, 1.0f, &o2)
    check("global flicker: output at the clean level", rel_rms(&o2) < 0.02f, &ok)
    image.img_free(&o2)
    merge.burst_free(&b2)

    // (3) calm burst: on == off
    var b3: merge.Burst = merge.burst_new()
    s = 1
    while s < 6 {
        merge.burst_add(&b3, frame(s as u32, 0, 0.0f), 1.0f)
        s = s + 1
    }
    var o3a: image.Image = image.img_new(1, 1, 3)
    var o3b: image.Image = image.img_new(1, 1, 3)
    run(&b3, 0.0f, &o3a)
    run(&b3, 1.0f, &o3b)
    check("calm burst unchanged", mean_diff(&o3a, &o3b) < 0.01f, &ok)
    image.img_free(&o3a)
    image.img_free(&o3b)
    merge.burst_free(&b3)

    // (4) two frames: no-op
    var b4: merge.Burst = merge.burst_new()
    merge.burst_add(&b4, frame(1 as u32, 1, 0.25f), 1.0f)
    merge.burst_add(&b4, frame(2 as u32, 0, 0.0f), 1.0f)
    var o4a: image.Image = image.img_new(1, 1, 3)
    var o4b: image.Image = image.img_new(1, 1, 3)
    run(&b4, 0.0f, &o4a)
    run(&b4, 1.0f, &o4b)
    check("two frames: no-op", mean_diff(&o4a, &o4b) < 1.0e-6f, &ok)
    image.img_free(&o4a)
    image.img_free(&o4b)
    merge.burst_free(&b4)

    // (5) real local change in 2 of 5 frames (including the reference): the patch must stay at the majority level
    var b5: merge.Burst = merge.burst_new()
    merge.burst_add(&b5, frame(1 as u32, 3, 0.0f), 1.0f)
    merge.burst_add(&b5, frame(2 as u32, 3, 0.0f), 1.0f)
    s = 3
    while s < 6 {
        merge.burst_add(&b5, frame(s as u32, 0, 0.0f), 1.0f)
        s = s + 1
    }
    var o5a: image.Image = image.img_new(1, 1, 3)
    var o5b: image.Image = image.img_new(1, 1, 3)
    run(&b5, 0.0f, &o5a)
    run(&b5, 1.0f, &o5b)
    // the reference itself has the patch, so the patch is the reference level in both runs; the compensation must
    // not make the patch value drift (|on - off| small) -- a patch is not a gain error
    check("local change is not a gain", mean_diff(&o5a, &o5b) < 0.03f, &ok)
    image.img_free(&o5a)
    image.img_free(&o5b)
    merge.burst_free(&b5)

    // (6) refine_reference: a banded provisional reference (frame 0) among clean frames is replaced; a clean one stays
    var b6: merge.Burst = merge.burst_new()
    merge.burst_add(&b6, frame(1 as u32, 1, 0.25f), 1.0f)
    s = 2
    while s < 6 {
        merge.burst_add(&b6, frame(s as u32, 0, 0.0f), 1.0f)
        s = s + 1
    }
    var nm6: noise.NoiseModel = model()
    let r6: i32 = merge.refine_reference(&b6, 0, &nm6, 0.04f)
    check("banded reference is replaced", r6 != 0, &ok)
    let r6b: i32 = merge.refine_reference(&b6, 2, &nm6, 0.04f)
    check("clean reference stays", r6b == 2, &ok)
    merge.burst_free(&b6)

    if ok { io.print_line("ok") }
    if ok { return 0 }
    return 1
}
