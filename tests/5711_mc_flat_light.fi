// expect_exit: 0
import std.rt
import mc.mc_mesh

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn pset(p: u64, x: usize, y: usize, z: usize, v: u16) {
    rt.st16(p, (y * 18 + z) * 18 + x, v)
}

fn lset(p: u64, x: usize, y: usize, z: usize, sky: u8, blk: u8) {
    rt.st8(p, (y * 18 + z) * 18 + x, (sky << 4 as u8) | blk)
}

fn top_corners(m: *mut mc_mesh.Mesher, out: u64) -> bool {
    var q: usize = 0
    while q < (*m).nquads as usize {
        let w0: u32 = rt.ld32((*m).verts, q * 8)
        if mc_mesh.vtx_face(w0) == 3 as u32 {
            var k: usize = 0
            while k < 4 {
                rt.st32(out, k * 2, rt.ld32((*m).verts, (q * 4 + k) * 2))
                rt.st32(out, k * 2 + 1, rt.ld32((*m).verts, (q * 4 + k) * 2 + 1))
                k = k + 1
            }
            return true
        }
        q = q + 1
    }
    return false
}

fn main() -> i32 {
    let opaque: u64 = rt.heap_alloc(32768)
    let tiles: u64 = rt.heap_alloc(32768 * 6 * 2)
    rt.mem_set(opaque, 0 as u8, 32768)
    rt.mem_set(tiles, 0 as u8, 32768 * 6 * 2)
    var f: usize = 0
    while f < 6 {
        rt.st16(tiles, 6 + f, 5 as u16)
        f = f + 1
    }
    rt.st8(opaque, 1, 1 as u8)
    var t: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: opaque, tiles: tiles }
    var m: mc_mesh.Mesher = mc_mesh.mesher_new()
    let pad: u64 = rt.heap_alloc(5832 * 2)
    let lp: u64 = rt.heap_alloc(5832)
    let out: u64 = rt.heap_alloc(64)
    rt.mem_set(pad, 0 as u8, 5832 * 2)
    rt.mem_set(lp, 0 as u8, 5832)
    pset(pad, 5, 5, 5, 1 as u16)
    pset(pad, 6, 6, 5, 1 as u16)
    lset(lp, 5, 6, 5, 12 as u8, 3 as u8)
    lset(lp, 6, 6, 5, 4 as u8, 9 as u8)
    lset(lp, 4, 6, 5, 8 as u8, 0 as u8)
    mc_mesh.mesh_padded_lit(&m, pad, lp, &t, mc_mesh.F_LIGHT | mc_mesh.F_AO)
    check(top_corners(&m, out), 1)
    var differs: bool = false
    var k: usize = 1
    while k < 4 {
        if rt.ld32(out, k * 2 + 1) != rt.ld32(out, 1) { differs = true }
        k = k + 1
    }
    check(differs, 2)
    mc_mesh.mesh_padded_lit(&m, pad, lp, &t, mc_mesh.F_LIGHT | mc_mesh.F_FLAT_LIGHT)
    check(top_corners(&m, out), 3)
    k = 0
    while k < 4 {
        let w0: u32 = rt.ld32(out, k * 2)
        let w1: u32 = rt.ld32(out, k * 2 + 1)
        check(mc_mesh.vtx_sky(w1) == 12 as u32, 4)
        check(mc_mesh.vtx_block(w1) == 3 as u32, 5)
        check(mc_mesh.vtx_ao(w0) == 3 as u32, 6)
        k = k + 1
    }
    rt.finish(0 as i64)
    return 0
}
