// expect_exit: 0
import std.rt
import mc.mc_serverlist
import mc.mc_launch_cfg

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn add(l: *mut mc_serverlist.ServerList, host: str, port: i32) -> bool {
    return mc_serverlist.sl_add(l, host.p as u64, host.n, port)
}

fn entry_is(l: *mut mc_serverlist.ServerList, i: i32, t: str) -> bool {
    if mc_serverlist.sl_len(l, i) != t.n { return false }
    var k: usize = 0
    while k < t.n {
        if rt.ld8(mc_serverlist.sl_ptr(l, i), k) != t.chars(k) { return false }
        k = k + 1
    }
    return true
}

fn main() -> i32 {
    var l: mc_serverlist.ServerList = mc_serverlist.sl_new()
    check(mc_serverlist.sl_count(&l) == 0, 1)
    check(add(&l, "10.0.0.1", 25565), 2)
    check(add(&l, "192.168.1.20", 25599), 3)
    check(!add(&l, "", 25565) && !add(&l, "1.2.3.4", 0) && !add(&l, "1.2.3.4", 70000), 4)
    check(mc_serverlist.sl_count(&l) == 2 && entry_is(&l, 0, "192.168.1.20:25599") && entry_is(&l, 1, "10.0.0.1:25565"), 5)
    check(add(&l, "10.0.0.1", 25565), 6)
    check(mc_serverlist.sl_count(&l) == 2 && entry_is(&l, 0, "10.0.0.1:25565") && entry_is(&l, 1, "192.168.1.20:25599"), 7)
    check(mc_serverlist.sl_find(&l, "192.168.1.20".p as u64, 12, 25599) == 1, 8)
    check(mc_serverlist.sl_find(&l, "192.168.1.20".p as u64, 12, 25565) == 0 - 1, 9)
    check(mc_serverlist.sl_port(&l, 1) == 25599, 10)
    var h: rt.Buf = rt.buf_new()
    mc_serverlist.sl_host(&l, 1, &h)
    check(rt.buf_len(&h) == 12 && rt.ld8(rt.buf_ptr(&h), 11) == 48 as u8, 11)
    rt.buf_free(&h)

    var text: rt.Buf = rt.buf_new()
    mc_serverlist.sl_text(&l, &text)
    let want: str = "server=10.0.0.1:25565\nserver=192.168.1.20:25599\n"
    check(rt.buf_len(&text) == want.n, 12)
    var back: mc_serverlist.ServerList = mc_serverlist.sl_new()
    mc_serverlist.sl_load(rt.buf_ptr(&text), rt.buf_len(&text), &back)
    check(mc_serverlist.sl_count(&back) == 2 && entry_is(&back, 1, "192.168.1.20:25599"), 13)

    check(mc_serverlist.sl_remove(&l, 0) && mc_serverlist.sl_count(&l) == 1 && entry_is(&l, 0, "192.168.1.20:25599"), 14)
    check(!mc_serverlist.sl_remove(&l, 5) && !mc_serverlist.sl_remove(&l, 0 - 1), 15)
    check(mc_serverlist.sl_remove(&l, 0) && mc_serverlist.sl_count(&l) == 0 && mc_serverlist.sl_len(&l, 0) == 0, 16)

    var i: i32 = 0
    while i < 12 {
        add(&l, "10.1.1.1", 1000 + i)
        i = i + 1
    }
    check(mc_serverlist.sl_count(&l) == mc_serverlist.SERVERS_MAX && entry_is(&l, 0, "10.1.1.1:1011") && entry_is(&l, 7, "10.1.1.1:1004"), 17)

    let junk: str = "host=1.2.3.4\nserver=abc\nserver=1.2.3.4\nserver=1.2.3.4:\nserver=:25\nserver=1.2.3.4:123456\nserver=5.6.7.8:80\r\nserver=5.6.7.8:80\n# server=9.9.9.9:1\nserver=1.1.1.1:1:2\n"
    mc_serverlist.sl_load(junk.p as u64, junk.n, &back)
    check(mc_serverlist.sl_count(&back) == 1 && entry_is(&back, 0, "5.6.7.8:80"), 18)

    var cfg: mc_launch_cfg.LaunchCfg = mc_launch_cfg.cfg_new()
    mc_serverlist.sl_copy(&cfg.servers, &l)
    let hs: str = "1.2.3.4"
    let nm: str = "Steve"
    rt.buf_push_bytes(&cfg.host, hs.p as u64, hs.n)
    rt.buf_push_bytes(&cfg.name, nm.p as u64, nm.n)
    cfg.port = 25565
    let path: str = "/tmp/mc_serverlist_test_4996/mcplay.cfg"
    check(mc_launch_cfg.cfg_save(path, &cfg), 19)
    var again: mc_launch_cfg.LaunchCfg = mc_launch_cfg.cfg_new()
    check(mc_launch_cfg.cfg_load(path, &again) && mc_launch_cfg.cfg_complete(&again), 20)
    check(mc_serverlist.sl_count(&again.servers) == 8 && entry_is(&again.servers, 0, "10.1.1.1:1011") && again.port == 25565, 21)
    return 0
}
