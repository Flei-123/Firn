// expect_exit: 24
// Ein vollstaendiges 'match', dessen Faelle alle zurueckkehren, gilt als
// Rueckkehr — 'fn' braucht danach kein weiteres 'return'.
enum Op { Plus(i32, i32), Minus(i32, i32), Null }

fn rechne(o: *Op) -> i32 {
    match *o {
        Op::Plus(a, b) => { return a + b }
        Op::Minus(a, b) => { return a - b }
        Op::Null => { return 0 as i32 }
    }
}

fn main() -> i32 {
    var p = Op::Plus(20 as i32, 9 as i32)
    var m = Op::Minus(9 as i32, 4 as i32)
    var n = Op::Null
    return rechne(&p) - rechne(&m) + rechne(&n)
}
