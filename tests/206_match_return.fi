// expect_exit: 24
// A complete 'match' whose cases all return counts as a return itself --
// 'fn' needs no further 'return' after it.
enum Op { Plus(i32, i32), Minus(i32, i32), Null }

fn compute(o: *Op) -> i32 {
    match *o {
        Op::Plus(a, b) => { return a + b }
        Op::Minus(a, b) => { return a - b }
        Op::Null => { return 0 as i32 }
    }
}

fn main() -> i32 {
    var p = Op::Plus(20 as i32, 9 as i32)
    var m = Op::Minus(9 as i32, 4 as i32)
    var n = Op::Null
    return compute(&p) - compute(&m) + compute(&n)
}
