// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_registry
import mc.mc_inv

fn prop(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32, k: i32, val: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&b, id as u8)
    bytes.put_i16(&b, k as i16)
    bytes.put_i16(&b, val as i16)
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_property(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn main() -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &ver) { return 1 }
    var r: mc_registry.Registry = ver.registry_of()
    var v: mc_inv.Inv = mc_inv.inv_new()
    mc_inv.inv_use_registry(&v, &r)
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&b, 4 as u8)
    bytes.put_varint(&b, 12)
    bytes.put_u8(&b, 0 as u8)
    bytes.bytes_set_pos(&b, 0)
    if !mc_inv.inv_on_open_window_v(&v, &ver, &b) { return 2 }
    bytes.bytes_free(&b)
    if !prop(&v, &ver, 4, 0, 30) { return 3 }
    if !prop(&v, &ver, 4, 4, 0 - 1) { return 4 }
    if !prop(&v, &ver, 4, 7, 0 - 1) { return 5 }
    if !prop(&v, &ver, 4, 5, 13) { return 6 }
    if mc_inv.inv_prop(&v, 0) != 30 || mc_inv.inv_prop(&v, 4) != 0 - 1 || mc_inv.inv_prop(&v, 7) != 0 - 1 || mc_inv.inv_prop(&v, 5) != 13 { return 7 }
    if prop(&v, &ver, 9, 0, 1) { return 8 }
    return 0
}
