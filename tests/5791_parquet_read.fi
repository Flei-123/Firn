// expect_exit: 0
import parquet.pq
import parquet.pqsrc
import parquet.pqstr
import parquet.pqmeta
import std.rt
import std.testkit

const SMALL: str = __include_str("data/parquet/small.parquet")

fn open_small(s: *mut pqsrc.PqSrc) -> *mut pqmeta.Pq {
    pqsrc.pq_src_mem(SMALL.p as u64, SMALL.length(), s)
    return pq.pq_open(s)
}

#[test]
fn opens_and_describes() {
    var s: pqsrc.PqSrc = pqsrc.pq_src_new()
    let q: *mut pqmeta.Pq = open_small(&s)
    testkit.assert_true(q as u64 != 0, "open")
    testkit.assert_eq_i64(pq.pq_num_rows(q) as i64, 40)
    testkit.assert_eq_i64(pq.pq_num_row_groups(q) as i64, 3)
    testkit.assert_eq_i64(pq.pq_rg_rows(q, 0) as i64, 16)
    testkit.assert_eq_i64(pq.pq_num_cols(q) as i64, 2)
    testkit.assert_eq_i64(pq.pq_col_find(q, "text"), 0)
    testkit.assert_eq_i64(pq.pq_col_find(q, "conversations"), 1)
    testkit.assert_eq_i64(pq.pq_col_find(q, "nope"), 0 - 1)
    testkit.assert_eq_i64(pq.pq_col_shape(q, 0) as i64, 0)
    testkit.assert_eq_i64(pq.pq_col_shape(q, 1) as i64, 2)
    pq.pq_free(q)
}

#[test]
fn reads_strings_and_nulls() {
    var s: pqsrc.PqSrc = pqsrc.pq_src_new()
    let q: *mut pqmeta.Pq = open_small(&s)
    var c: pqstr.StrCol = pqstr.strcol_new()
    testkit.assert_true(pq.pq_read_strings(q, 0, 0, &c), "read")
    testkit.assert_eq_i64(pqstr.strcol_count(&c) as i64, 16)
    testkit.assert_eq_i64(pqstr.strcol_len(&c, 0) as i64, 5)
    testkit.assert_true(pqstr.strcol_is_null(&c, 2), "null")
    testkit.assert_eq_i64(pqstr.strcol_len(&c, 3) as i64, 11)
    testkit.assert_eq_i64(pqstr.strcol_len(&c, 5) as i64, 6)
    pqstr.strcol_free(&c)
    pq.pq_free(q)
}

#[test]
fn reads_conversations() {
    var s: pqsrc.PqSrc = pqsrc.pq_src_new()
    let q: *mut pqmeta.Pq = open_small(&s)
    var cc: pq.ConvCol = pq.convcol_new()
    testkit.assert_true(pq.pq_read_conv(q, 0, 1, &cc), "read")
    testkit.assert_eq_i64(cc.nrows as i64, 16)
    testkit.assert_eq_i64(cc.nitems as i64, 20)
    testkit.assert_eq_i64(pqstr.strcol_len(&cc.a, 0) as i64, 5)
    testkit.assert_eq_i64(pqstr.strcol_len(&cc.a, 1) as i64, 3)
    pq.convcol_free(&cc)
    pq.pq_free(q)
}

#[test]
fn survives_mutations() {
    var seed: u64 = 12345
    var i: usize = 0
    var copy: rt.Buf = rt.buf_new()
    while i < 400 {
        rt.buf_clear(&copy)
        rt.buf_push_bytes(&copy, SMALL.p as u64, SMALL.length())
        seed = seed *% 6364136223846793005 +% 1442695040888963407
        let at: usize = ((seed >> 33) as usize) % copy.len
        rt.st8(copy.ptr, at, ((seed >> 20) & 255) as u8)
        var cut: usize = copy.len
        if i % 5 == 0 {
            cut = ((seed >> 40) as usize) % copy.len
        }
        var s: pqsrc.PqSrc = pqsrc.pq_src_new()
        pqsrc.pq_src_mem(copy.ptr, cut, &s)
        let q: *mut pqmeta.Pq = pq.pq_open(&s)
        if q as u64 != 0 {
            var c: pqstr.StrCol = pqstr.strcol_new()
            var rg: usize = 0
            while rg < pq.pq_num_row_groups(q) {
                pq.pq_read_strings(q, rg, 0, &c)
                rg = rg + 1
            }
            pqstr.strcol_free(&c)
            var cc: pq.ConvCol = pq.convcol_new()
            pq.pq_read_conv(q, 0, 1, &cc)
            pq.convcol_free(&cc)
            pq.pq_free(q)
        }
        i = i + 1
    }
    rt.buf_free(&copy)
}
