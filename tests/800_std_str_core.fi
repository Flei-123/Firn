// expect_out: Hallo | teile 3 woerter 3 pos 7 ersetzt 3 | Hallo-Welt-Firn | zeichen 7 oktette 11 ue 252 euro 8364 mitte 5 | ....FirnFirn.. | npos 1 kaputt 0
// tests/800_std_str_core.fi — die Textarbeit von `std.str` (Runde 42).
//
// Geprueft wird die ganze Kette an EINEM Beispieltext: trimmen, teilen,
// verbinden, suchen, ersetzen, Gross/Klein, auffuellen, vergleichen — und
// danach UTF-8: dekodieren, vorwaerts und rueckwaerts laufen, nach ZEICHEN
// statt nach Oktetten schneiden.
//
// Jede Erwartung steht als `return <code>` im Programm: schlaegt eine fehl,
// endet der Test mit genau diesem Code, und test.sh nennt ihn. Die
// gedruckte Zeile ist zusaetzlich der Vergleichspunkt fuer
// tools/self_compare.sh — firnc0 und firnc1 muessen sie zeichengleich
// erzeugen.
import std.io
import std.str

fn show(b: *mut str.Bytes) {
    io.print((*b).ptr as u64, (*b).len)
}

fn main() -> i32 {
    var raw: [u8; 22] = "  Hallo, Welt, Firn  \0"
    var tr: [u8; 3] = ", \0"
    var dash: [u8; 2] = "-\0"
    var hello: [u8; 6] = "Hallo\0"
    var firn: [u8; 5] = "Firn\0"
    var world: [u8; 5] = "Welt\0"
    var kl_l: [u8; 2] = "l\0"
    var gr_l: [u8; 2] = "L\0"
    var blank: [u8; 2] = " \0"

    let source: str.Span = str.span_of_c((&raw[0]) as *mut u8)
    let sep: str.Span = str.span_of_c((&tr[0]) as *mut u8)
    let hyphen: str.Span = str.span_of_c((&dash[0]) as *mut u8)

    if source.n != 21 {
        return 10
    }

    // --- trimmen
    let core: str.Span = str.trim(source)
    if core.n != 17 {
        return 11
    }
    if str.trim_left(source).n != 19 {
        return 12
    }
    if str.trim_right(source).n != 19 {
        return 13
    }

    // --- teilen und wieder verbinden
    var divisor: str.Divisor = str.divisor_new(core, sep)
    var piece: str.Span = str.span_empty()
    var joined: str.Bytes = str.bytes_new()
    var parts: usize = 0
    while str.divisor_next(&divisor, &piece) {
        parts = parts + 1
        str.join_part(&joined, piece, hyphen)
    }
    if parts != 3 {
        return 14
    }
    if str.parts_count(core, sep) != 3 {
        return 15
    }
    if str.bytes_len(&joined) != 15 {
        return 16
    }

    // Leerraum-Teiler: dieselbe Quelle, aber Kommas bleiben am Wort haengen.
    var wt: str.Divisor = str.divisor_whitespace(source)
    var word: str.Span = str.span_empty()
    var words: usize = 0
    while str.divisor_next(&wt, &word) {
        words = words + 1
    }
    if words != 3 {
        return 17
    }

    // --- suchen
    if !str.starts_with(core, str.span_of_c((&hello[0]) as *mut u8)) {
        return 20
    }
    if !str.ends_with(core, str.span_of_c((&firn[0]) as *mut u8)) {
        return 21
    }
    let pos_world: usize = str.find(core, str.span_of_c((&world[0]) as *mut u8))
    if pos_world != 7 {
        return 22
    }
    if str.find(core, str.span_of_c((&dash[0]) as *mut u8)) != str.npos() {
        return 23
    }
    if str.find_char(core, 44 as u8) != 5 {
        return 24
    }
    if str.find_char_back(core, 44 as u8) != 11 {
        return 25
    }
    if str.count_char(core, 44 as u8) != 2 {
        return 26
    }
    if str.count_part(source, str.span_of_c((&blank[0]) as *mut u8)) != 6 {
        return 27
    }
    if !str.contains(core, str.span_of_c((&world[0]) as *mut u8)) {
        return 28
    }
    if str.find_back(core, str.span_of_c((&firn[0]) as *mut u8)) != 13 {
        return 29
    }

    // --- ersetzen
    var replaced: str.Bytes = str.bytes_new()
    let how_often: usize = str.replace(&replaced, core,
        str.span_of_c((&kl_l[0]) as *mut u8),
        str.span_of_c((&gr_l[0]) as *mut u8))
    if how_often != 3 {
        return 30
    }
    if str.bytes_len(&replaced) != 17 {
        return 31
    }
    if str.bytes_at(&replaced, 2) != 76 as u8 {
        return 32
    }
    if str.replace_char_here(&replaced, 76 as u8, 108 as u8) != 3 {
        return 33
    }

    // --- Gross und Klein
    var big: str.Bytes = str.bytes_new()
    str.after_big(&big, str.span_of_c((&hello[0]) as *mut u8))
    if str.bytes_at(&big, 1) != 65 as u8 {
        return 40
    }
    var small: str.Bytes = str.bytes_new()
    str.after_small(&small, str.span_of_bytes(&big))
    if str.bytes_at(&small, 0) != 104 as u8 {
        return 41
    }
    if !str.equal_without_case(str.span_of_bytes(&big),
                             str.span_of_c((&hello[0]) as *mut u8)) {
        return 42
    }
    if str.equal(str.span_of_bytes(&big),
                  str.span_of_c((&hello[0]) as *mut u8)) {
        return 43
    }
    if str.compare(str.span_of_c((&firn[0]) as *mut u8),
                      str.span_of_c((&world[0]) as *mut u8)) != 0 - 1 {
        return 44
    }
    if str.compare(core, core) != 0 {
        return 45
    }

    // --- auffuellen
    var wide: str.Bytes = str.bytes_new()
    str.fill_left(&wide, str.span_of_c((&firn[0]) as *mut u8), 8, 46 as u8)
    if str.bytes_len(&wide) != 8 {
        return 50
    }
    if str.bytes_at(&wide, 0) != 46 as u8 {
        return 51
    }
    str.fill_right(&wide, str.span_of_c((&firn[0]) as *mut u8), 6, 46 as u8)
    if str.bytes_len(&wide) != 14 {
        return 52
    }

    // --- Zeichenklassen
    if !str.is_digit(55 as u8) || str.is_digit(65 as u8) {
        return 55
    }
    if !str.is_hex_digit(102 as u8) || str.hex_value(102 as u8) != 15 {
        return 56
    }
    if str.hex_value(122 as u8) != 0 - 1 {
        return 57
    }
    if str.big_char(122 as u8) != 90 as u8 {
        return 58
    }
    if !str.is_whitespace(9 as u8) || str.is_whitespace(48 as u8) {
        return 59
    }

    // --- UTF-8
    var uni: [u8; 12] = "Grüße €\0"
    let u: str.Span = str.span_of_c((&uni[0]) as *mut u8)
    if u.n != 11 {
        return 60
    }
    if str.utf8_count(u) != 7 {
        return 61
    }
    if !str.utf8_is_valid(u.p, u.n) {
        return 62
    }
    let z_ue: str.CharHit = str.utf8_read(u, 2)
    if !z_ue.valid || z_ue.cp != 252 || z_ue.length != 2 {
        return 63
    }
    let z_eur: str.CharHit = str.utf8_read(u, 8)
    if !z_eur.valid || z_eur.cp != 8364 || z_eur.length != 3 {
        return 64
    }
    if str.utf8_next(u, 2) != 4 {
        return 65
    }
    if str.utf8_before(u, 8) != 7 {
        return 66
    }
    if str.utf8_is_limit(u, 3) {
        return 67
    }
    if !str.utf8_is_limit(u, 4) {
        return 68
    }
    // Zeichen 1..3 sind "rüß" — nach Oktetten waeren das 1..4.
    let mid: str.Span = str.utf8_part(u, 1, 3)
    if mid.n != 5 {
        return 69
    }
    // Ungueltiges Oktett wird als EIN Zeichen gemeldet, damit jede Schleife
    // vorankommt.
    var broken: [u8; 3] = [97 as u8, 255 as u8, 98 as u8]
    let k: str.Span = str.span((&broken[0]) as *mut u8, 3)
    let zk: str.CharHit = str.utf8_read(k, 1)
    if zk.valid || zk.length != 1 || zk.cp != 65533 {
        return 70
    }
    if str.utf8_count(k) != 3 {
        return 71
    }
    // Rueckweg: Codepunkt anhaengen und wieder lesen.
    var round: str.Bytes = str.bytes_new()
    str.utf8_append(&round, 8364)
    if str.bytes_len(&round) != 3 {
        return 72
    }

    // BEFUND Runde 42 (benannt, nicht umgebaut): ein MODULQUALIFIZIERTER
    // Aufruf im Ausdruck eines f"..." kommt in den kanonischen Baeumen der
    // beiden Compiler verschieden heraus — firnc0 schreibt `str.npos`,
    // firnc1 den internen Namen `str__npos`. Das Verhalten ist gleich (der
    // Selbstvergleich ist GLEICH), aber tools/parser_compare.sh vergleicht
    // den Baum Oktett fuer Oktett. Deshalb stehen die Werte hier VOR der
    // Interpolation in einer Bindung. Siehe docs/RUNDE42.md, Abschnitt 5C.
    let char_count: usize = str.utf8_count(u)
    let npos_whole_set: bool = str.npos() == 0 - 1
    io.print((&raw[0]) as u64 + 2, 5)
    io.fmt_print(f" | teile {parts} woerter {words} pos {pos_world} ersetzt {how_often} | ")
    show(&joined)
    io.fmt_print(f" | zeichen {char_count} oktette {u.n} ue {z_ue.cp} euro {z_eur.cp} mitte {mid.n} | ")
    show(&wide)
    io.fmt_print(f" | npos {npos_whole_set} kaputt {zk.valid}\n")

    str.bytes_free(&joined)
    str.bytes_free(&replaced)
    str.bytes_free(&big)
    str.bytes_free(&small)
    str.bytes_free(&wide)
    str.bytes_free(&round)
    return 0
}
