// expect_exit: 0
import std.rt
import std.testkit
import mc.mc_frame_split

fn line_text(k: i32) -> i32 {
    var b: rt.Buf = rt.buf_new()
    mc_frame_split.fs_line(k, &b)
    let n: i32 = rt.buf_len(&b) as i32
    rt.buf_free(&b)
    return n
}

fn work() -> bool {
    mc_frame_split.fs_init()
    mc_frame_split.fs_backend(mc_frame_split.BK_GL, 3, 8)
    testkit.check(mc_frame_split.fs_get(mc_frame_split.FS_BACKEND) == mc_frame_split.BK_GL, "backend kind")
    testkit.check(mc_frame_split.fs_get(mc_frame_split.FS_WORKERS) == (3 as u64), "workers")
    testkit.check(mc_frame_split.fs_get(mc_frame_split.FS_VIEW) == (8 as u64), "view")
    mc_frame_split.fs_ema(mc_frame_split.FS_NET, 8000000 as u64)
    testkit.check(mc_frame_split.fs_get(mc_frame_split.FS_NET) == (8000000 as u64), "ema first sample")
    mc_frame_split.fs_ema(mc_frame_split.FS_NET, 16000000 as u64)
    testkit.check(mc_frame_split.fs_get(mc_frame_split.FS_NET) == (9000000 as u64), "ema blends 1/8")
    mc_frame_split.fs_frame(1 as u64, 2 as u64, 3 as u64, 4 as u64, 5 as u64, 6 as u64, 7 as u64, 20000000 as u64)
    mc_frame_split.fs_frame(1 as u64, 2 as u64, 3 as u64, 4 as u64, 5 as u64, 6 as u64, 7 as u64, 10000000 as u64)
    testkit.check(mc_frame_split.fs_get(mc_frame_split.FS_MAX) == (20000000 as u64), "worst frame kept")
    mc_frame_split.fs_gl(1150 as u64, 234000 as u64, 170 as u64)
    testkit.check(mc_frame_split.fs_get(mc_frame_split.FS_TRIS) == (234000 as u64), "tris")
    var k: i32 = 0
    while k < mc_frame_split.FS_LINES {
        testkit.check(line_text(k) > 0, "every f3 line has text")
        k = k + 1
    }
    return true
}

fn main() -> i32 {
    work()
    return testkit.finish()
}
