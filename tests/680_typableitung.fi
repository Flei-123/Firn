// expect_exit: 0
// BIDIREKTIONALE TYPABLEITUNG — die Ecken, die das Korpus nicht abdeckt.
//
// Ein Ganzzahlliteral hat in Firn KEINEN eigenen Typ. Er kommt entweder aus
// dem Kontext oder aus dem anderen Operanden, und die REIHENFOLGE ist Vertrag:
// erst der bereits typisierte Operand, dann der Kontexthinweis. Genau diese
// Reihenfolge prueft `tools/sema_vergleich.sh` mit — hier steht sie als
// laufendes Programm daneben, damit sie nicht nur gleich, sondern auch
// richtig ist.

const BREITE: usize = 4
const HOEHE: usize = 3
const FLAECHE: usize = BREITE * HOEHE

struct Punkt {
    x: i32,
    y: i32,
}

struct Rahmen {
    a: Punkt,
    b: Punkt,
    tiefe: u16,
}

fn nimm_u8(v: u8) -> u8 {
    return v
}

fn nimm_punkt(p: Punkt) -> i32 {
    return p.x + p.y
}

fn main() -> i32 {
    // --- der Typ kommt vom ANDEREN Operanden, nicht aus dem Kontext
    let a: i32 = 100
    let summe: i32 = a + 1          // die 1 wird i32, weil a i32 ist
    if summe != 101 {
        return 1
    }
    let b: u8 = 200 as u8
    let c: u8 = b - 100             // die 100 wird u8
    if c != 100 as u8 {
        return 2
    }

    // --- der linke Operand einer Verschiebung bestimmt den Ergebnistyp
    let s: u16 = 1 as u16
    let v: u16 = s << 3             // die 3 wird u16, das Ergebnis u16
    if v != 8 as u16 {
        return 3
    }

    // --- Vergleich: der Typ kommt von der Seite, die schon einen hat
    if !(a > 50) {
        return 4
    }
    if !(50 < a) {
        return 5
    }

    // --- Argumenttyp als Kontexthinweis
    if nimm_u8(42) != 42 as u8 {
        return 6
    }

    // --- Index ist immer usize, auch als Literal
    var feld: [i32; 3] = [10, 20, 30]
    if feld[1] != 20 {
        return 7
    }
    if feld[BREITE - 3] != 20 {     // konstanter Ausdruck als Index
        return 8
    }

    // --- Wiederholungsliteral: die Laenge geht in den TYP ein.
    // Die Laenge im TYP muss ein Literal sein (Stufe 0), im WIEDERHOLUNGS-
    // literal darf ein konstanter Ausdruck stehen — beide muessen
    // uebereinstimmen, und genau das prueft der Typpruefer.
    var null_feld: [u8; 12] = [0 as u8; FLAECHE]
    if null_feld[11] != 0 as u8 {
        return 9
    }
    var i: usize = 0
    var gefuellt: usize = 0
    while i < FLAECHE {
        null_feld[i] = (i + 1) as u8
        gefuellt = gefuellt + 1
        i = i + 1
    }
    if gefuellt != 12 || null_feld[11] != 12 as u8 {
        return 10
    }

    // --- verschachtelte Struct-Literale: der Feldtyp ist der Hinweis
    let r: Rahmen = Rahmen{
        a: Punkt{ x: 1, y: 2 },
        b: Punkt{ x: 3, y: 4 },
        tiefe: 5,
    }
    if nimm_punkt(r.a) != 3 || nimm_punkt(r.b) != 7 {
        return 11
    }
    if r.tiefe != 5 as u16 {
        return 12
    }

    // --- Adresse und Dereferenzierung durch mehrere Ebenen
    var p: Punkt = Punkt{ x: 7, y: 8 }
    let zp: *mut Punkt = &p
    (*zp).x = 9
    if p.x != 9 {
        return 13
    }
    let zzp: *mut *mut Punkt = &zp
    if (*(*zzp)).y != 8 {
        return 14
    }

    // --- `as` gibt dem Literal darunter seinen Typ
    let g: i64 = (1 << 40) as i64
    if g != 1099511627776 {
        return 15
    }

    // --- for-Bereich: beide Grenzen bekommen denselben Typ
    var zaehler: usize = 0
    for k in 0..FLAECHE {
        zaehler = zaehler + k
    }
    if zaehler != 66 {
        return 16
    }

    // --- Schatten in einem inneren Block
    let x: i32 = 1
    {
        let x: u8 = 2 as u8
        if x != 2 as u8 {
            return 17
        }
    }
    if x != 1 {
        return 18
    }

    return 0
}
