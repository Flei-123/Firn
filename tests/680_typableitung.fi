// expect_exit: 0
// BIDIREKTIONALE TYPABLEITUNG — die Ecken, die das Korpus nicht abdeckt.
//
// Ein Ganzzahlliteral hat in Firn KEINEN eigenen Typ. Er kommt entweder aus
// dem Kontext oder aus dem anderen Operanden, und die REIHENFOLGE ist Vertrag:
// erst der bereits typisierte Operand, dann der Kontexthinweis. Genau diese
// Reihenfolge prueft `tools/sema_compare.sh` mit — hier steht sie als
// laufendes Programm daneben, damit sie nicht nur gleich, sondern auch
// richtig ist.

const WIDTH: usize = 4
const HEIGHT: usize = 3
const AREA: usize = WIDTH * HEIGHT

struct Dot {
    x: i32,
    y: i32,
}

struct Frame {
    a: Dot,
    b: Dot,
    depth: u16,
}

fn take_u8(v: u8) -> u8 {
    return v
}

fn take_dot(p: Dot) -> i32 {
    return p.x + p.y
}

fn main() -> i32 {
    // --- der Typ kommt vom ANDEREN Operanden, nicht aus dem Kontext
    let a: i32 = 100
    let sum: i32 = a + 1          // die 1 wird i32, weil a i32 ist
    if sum != 101 {
        return 1
    }
    let b: u8 = 200 as u8
    let c: u8 = b - 100             // die 100 wird u8
    if c != 100 as u8 {
        return 2
    }

    // --- der linke Operand einer Verschiebung bestimmt den Ergebnistyp
    let s: u16 = 1 as u16
    let v: u16 = s << 3             // die 3 wird u16, das Ergebnis u16
    if v != 8 as u16 {
        return 3
    }

    // --- Vergleich: der Typ kommt von der Seite, die schon einen hat
    if !(a > 50) {
        return 4
    }
    if !(50 < a) {
        return 5
    }

    // --- Argumenttyp als Kontexthinweis
    if take_u8(42) != 42 as u8 {
        return 6
    }

    // --- Index ist immer usize, auch als Literal
    var field: [i32; 3] = [10, 20, 30]
    if field[1] != 20 {
        return 7
    }
    if field[WIDTH - 3] != 20 {     // konstanter Ausdruck als Index
        return 8
    }

    // --- Wiederholungsliteral: die Laenge geht in den TYP ein.
    // Die Laenge im TYP muss ein Literal sein (Stufe 0), im WIEDERHOLUNGS-
    // literal darf ein konstanter Ausdruck stehen — beide muessen
    // uebereinstimmen, und genau das prueft der Typpruefer.
    var null_field: [u8; 12] = [0 as u8; AREA]
    if null_field[11] != 0 as u8 {
        return 9
    }
    var i: usize = 0
    var filled: usize = 0
    while i < AREA {
        null_field[i] = (i + 1) as u8
        filled = filled + 1
        i = i + 1
    }
    if filled != 12 || null_field[11] != 12 as u8 {
        return 10
    }

    // --- verschachtelte Struct-Literale: der Feldtyp ist der Hinweis
    let r: Frame = Frame{
        a: Dot{ x: 1, y: 2 },
        b: Dot{ x: 3, y: 4 },
        depth: 5,
    }
    if take_dot(r.a) != 3 || take_dot(r.b) != 7 {
        return 11
    }
    if r.depth != 5 as u16 {
        return 12
    }

    // --- Adresse und Dereferenzierung durch mehrere Ebenen
    var p: Dot = Dot{ x: 7, y: 8 }
    let zp: *mut Dot = &p
    (*zp).x = 9
    if p.x != 9 {
        return 13
    }
    let zzp: *mut *mut Dot = &zp
    if (*(*zzp)).y != 8 {
        return 14
    }

    // --- `as` gibt dem Literal darunter seinen Typ
    let g: i64 = (1 << 40) as i64
    if g != 1099511627776 {
        return 15
    }

    // --- for-Bereich: beide Grenzen bekommen denselben Typ
    var counter: usize = 0
    for k in 0..AREA {
        counter = counter + k
    }
    if counter != 66 {
        return 16
    }

    // --- Schatten in einem inneren Block
    let x: i32 = 1
    {
        let x: u8 = 2 as u8
        if x != 2 as u8 {
            return 17
        }
    }
    if x != 1 {
        return 18
    }

    return 0
}
