// expect_exit: 0
// tests/4044_closure_generic_nested.fi -- nested closure literals and a lambda inside generic functions (r727).
fn apply[T](x: T, f: fn(T) -> T) -> T { return f(x) }

fn outer[T](x: T) -> T {
    return apply[T](x, fn(a: T) -> T { return apply[T](a, fn(c: T) -> T { return c }) })
}

fn up[T](x: T) -> T {
    return apply[T](x, |v| v)
}

fn main() -> i32 {
    if outer[i32](5) != 5 { return 1 }
    if outer[u8](7) != 7 { return 2 }
    if outer[i64](9) != 9 { return 3 }
    if up[i32](9) != 9 { return 4 }
    if up[u16](11) != 11 { return 5 }
    return 0
}
