// expect_exit: 0
import std.rt
import mc.mc_registry
import mc.mc_version
import mc.mc_versions

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn lookup(r: *mut mc_registry.Registry, text: str) -> i32 {
    return mc_registry.reg_state_by_text(r, text.p as u64, text.n)
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 1)
    var r: mc_registry.Registry = v.registry_of()
    var text: rt.Buf = rt.buf_new()
    var s: i32 = 0
    while s < mc_registry.reg_state_count(&r) {
        rt.buf_clear(&text)
        check(mc_registry.reg_state_text(&r, s, &text), 2)
        check(mc_registry.reg_state_by_text(&r, rt.buf_ptr(&text), rt.buf_len(&text)) == s, 3)
        s = s + 1
    }
    rt.buf_free(&text)
    check(lookup(&r, "minecraft:stone") == 1, 4)
    check(lookup(&r, "air") == 0, 5)
    check(lookup(&r, "minecraft:grass_block[snowy=false]") == 9, 6)
    check(lookup(&r, "minecraft:grass_block[snowy=true]") == 8, 7)
    check(lookup(&r, "minecraft:grass_block") == lookup(&r, "grass_block[snowy=false]"), 8)
    check(lookup(&r, "minecraft:no_such_block") == 0 - 1, 9)
    check(lookup(&r, "minecraft:grass_block[snowy") == 9, 10)
    check(lookup(&r, "minecraft:grass_block[nothing=1,snowy=true]") == 8, 11)
    check(lookup(&r, "") == 0 - 1, 12)
    return 0
}
