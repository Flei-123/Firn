// expect_exit: 0
import std.rt
import std.textfmt

fn same(out: *mut rt.Buf, want: str) -> bool {
    let ok: bool = out_equals(out, want)
    rt.buf_clear(out)
    return ok
}

fn out_equals(out: *mut rt.Buf, want: str) -> bool {
    if rt.buf_len(out) != want.n {
        return false
    }
    var i: usize = 0
    while i < want.n {
        if rt.buf_at(out, i) != *(want.p + i) {
            return false
        }
        i = i + 1
    }
    return true
}

#[allow_fp]
fn main() -> i32 {
    var o: rt.Buf = rt.buf_new()
    textfmt.pad_right(&o, "ab", 4)
    if !same(&o, "ab  ") { return 1 }
    textfmt.pad_left(&o, "ab", 4)
    if !same(&o, "  ab") { return 2 }
    textfmt.pad_left(&o, "\u{e4}b", 3)
    if !same(&o, " \u{e4}b") { return 3 }
    textfmt.fixed(&o, 2.675, 2)
    if !same(&o, "2.67") { return 4 }
    textfmt.fixed(&o, 0.125, 2)
    if !same(&o, "0.12") { return 5 }
    textfmt.fixed(&o, 2.5, 0)
    if !same(&o, "2") { return 6 }
    textfmt.fixed(&o, -0.001, 2)
    if !same(&o, "-0.00") { return 7 }
    textfmt.fixed(&o, 1234.5, 3)
    if !same(&o, "1234.500") { return 8 }
    textfmt.pad_left_fixed(&o, 3.14159, 2, 7)
    if !same(&o, "   3.14") { return 9 }
    textfmt.pad_left_i64(&o, -5, 4)
    if !same(&o, "  -5") { return 10 }
    if textfmt.round_to(2.675, 2) != 2.67 { return 11 }
    rt.buf_free(&o)
    return 0
}
