// expect_exit: 0
// tests/1135_js_gen_gc.fi -- ROUND 66: A SUSPENDED GENERATOR IS AN
// ORDINARY GC OBJECT.
//
// This is the test the round asks for by name. The frames of a suspended
// body (`val.GenFrame`), the state (`val.GenState`), the promises and the
// BigInts all lie in the collector's heap, and nothing else holds them:
// no second stack, no external root, no pinning. So an abandoned generator
// -- one that was started but never finished -- has to disappear like any
// other object.
//
// The program below builds in every round:
//
//     * 200 generators, each ADVANCED ONE STEP and then dropped, so each
//       one leaves a real frame stack behind, in the middle of a `try`,
//       inside a loop, with a closure that captures the environment,
//     * 200 promises with reaction lists,
//     * 200 BigInts of 600 bits.
//
// What is checked:
//   1. after three rounds and a collection the number of LIVE objects is
//      back where it started (within the tolerance the last realm needs),
//   2. the COUNTER CHECK: the same program that KEEPS every generator in a
//      global array must push the number up. Without it the measurement
//      would prove nothing -- a test that cannot see a leak is not a test.
//
// The long version with the RSS of the process is in tools/js/soak.sh.
import html.mem
import js.lex
import js.ast
import js.parse
import js.val
import js.interp
import js.builtin
import js.gen

const CLEAN_LEN: usize = 266
const LEAK_LEN: usize = 275

fn __gc_finalize(kind: u64, p: *mut u8) {
}

// Lay a deep, nulled frame over the abandoned frames: the stack scan is
// conservative, and an old pointer in a dead frame would keep alive exactly
// what is supposed to die here (docs/reports/dom.md).
fn scrub(n: u64) {
    var buffer: [u64; 256] = [0; 256]
    var i: usize = 0
    while i < 256 {
        buffer[i] = 0
        i = i + 1
    }
    barrier(&buffer)
    if n > 0 {
        scrub(n - 1)
    }
}

// ROUND 79 -- the realm is a GC object and is handed the addresses of `ctx`,
// `t` and `nm`, which lie in THIS frame. It is sound here and only here: the
// realm comes into being in this call, nothing outside gets hold of it, and
// it is garbage the moment this function returns. The escape analysis
// (compiler/src/escape.rs) cannot see that, so the exception is said out
// loud instead of the check being weakened (docs/ROUND79.md 3).
#[allow_escape]
fn run(src: *mut u8, len: usize, nm: *mut lex.Names) -> AllocError!u64 {
    var l: lex.Lexer = lex.lex_new()
    lex.lex_init(&l, nm)
    var t: ast.Ast = ast.ast_new()
    ast.ast_init(&t)
    var p: parse.Parser = parse.parser_new()
    parse.parser_init(&p, &l, &t, nm)
    lex.lex_set_ascii(&l, src, len)
    let prog: u32 = parse.parse_program(&p, false)
    if parse.parse_error(&p) != parse.ERR_NONE {
        return 1
    }
    var ctx: interp.Ctx = interp.ctx_new()
    ctx.native = builtin.native_dispatch
    ctx.arity = builtin.native_arity_of
    ctx.gen_start = gen.gen_start
    ctx.gen_native = gen.gen_native
    var sp: gen.Susp = gen.susp_new()
    gen.susp_init(&sp)
    ctx.gen_data = (&sp) as *mut u8
    let r: Gc[Realm] = try val.realm_new()
    val.realm_set_ctx(r, (&ctx) as *mut u8)
    val.realm_set_ast(r, &t, nm)
    let g: Gc[JsObj] = try builtin.install(r)
    let okg: bool = try gen.install_gen(r)
    let v: Gc[JsVal] = try interp.run_program(r, prog, r.global_env)
    var bad: u64 = 0
    if ctx.comp == interp.C_THROW {
        bad = 2
    }
    let okj: bool = try gen.run_jobs(r)
    parse.parser_free(&p)
    ast.ast_free(&t)
    lex.lex_free(&l)
    gen.susp_free(&sp)
    return bad
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    gc_set_max_bytes(1 << 30)
    var nm: lex.Names = lex.Names { pool: mem.cp_new(), off: mem.cp_new(),
        len: mem.cp_new(), hash: mem.cp_new(), buckets: mem.cp_new(),
        mask: 0, n: 0 }
    lex.names_init(&nm)

    // Every round: a generator suspended INSIDE a try block and inside a
    // loop, a promise with a reaction, and a BigInt of 600 bits.
    var clean: [u8; 266] = "function*g(i){var a=[i];try{for(var k=0;k<9;k++){a.push(k);yield k}}finally{a.length=0}}var s=0;for(var i=0;i<200;i++){var it=g(i);s+=it.next().value;var p=new Promise(function(res){res(i)});p.then(function(v){return v+1});var b=(1n<<600n)+BigInt(i);s+=Number(b&1n)}"
    var leak: [u8; 275] = "function*g(i){var a=[i];try{for(var k=0;k<9;k++){a.push(k);yield k}}finally{a.length=0}}var keep=[];for(var i=0;i<200;i++){var it=g(i);it.next();keep.push(it);var p=new Promise(function(res){res(i)});keep.push(p.then(function(v){return v+1}));keep.push((1n<<600n)+BigInt(i))}"

    // Warm up once, so that the interned names and the built ins are not
    // counted as growth.
    let w: u64 = run(&clean[0], CLEAN_LEN, &nm) catch 9
    if w != 0 {
        return 10 + w as i32
    }
    scrub(6)
    gc_collect()
    let base: u64 = gc_live_objects()

    var round: u64 = 0
    while round < 3 {
        let e: u64 = run(&clean[0], CLEAN_LEN, &nm) catch 9
        if e != 0 {
            return 20 + e as i32
        }
        scrub(6)
        gc_collect()
        round = round + 1
    }
    let after: u64 = gc_live_objects()
    if after > base + 4000 {
        return 3
    }

    // The counter check: holding on MUST show up.
    let e2: u64 = run(&leak[0], LEAK_LEN, &nm) catch 9
    if e2 != 0 {
        return 30 + e2 as i32
    }
    let peak: u64 = gc_live_objects()
    if peak <= after + 4000 {
        // A leak that the measurement cannot see means the measurement is
        // broken -- that is a failure, not a success.
        return 4
    }
    scrub(6)
    gc_collect()
    let end: u64 = gc_live_objects()
    if end > base + 4000 {
        return 5
    }
    lex.names_free(&nm)
    return 0
}
