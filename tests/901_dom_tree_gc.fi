// expect_exit: 0
// tests/901_dom_tree_gc.fi — DER BAUM HAELT IM SAMMLER (Runde 54).
//
// Ein DOM-Baum ist genau die Zyklenart, an der ein Zaehlverweis scheitert:
// jeder Knoten haelt seine Eltern STARK und seine Kinder STARK, dazu beide
// Geschwister. Ein Baum aus n Knoten hat rund 2n Zyklen; wird er
// unerreichbar, gibt ein Zaehlverweis NICHTS frei.
//
// Geprueft wird hier die STRUKTUR der Aussage; die Messung ueber viele
// Runden mit RSS und Gegenprobe steht in tools/html/gc_tree.sh.
//
//   A  Ein gebauter Baum ist wirklich zyklisch (Rueckverweise stimmen).
//   B  Solange er erreichbar ist, ueberlebt er jeden Sammellauf.
//   C  Wird er unerreichbar, sinkt die Zahl der lebenden Objekte wieder auf
//      den Stand von vorher — er wird also eingesammelt.
//   D  Ueber viele Runden waechst weder die Objektzahl noch der Heap.
//
// Jeder Rueckgabewert != 0 nennt die Stelle.

import browser.node

const WIDTH: u32 = 8
const DEPTH: u32 = 4

// Baut einen Baum mit BREITE^TIEFE-artiger Verzweigung und liefert die Zahl
// der angelegten Knoten. Alle Verweise sind stark, in beide Richtungen.
fn tree_build(parent: Gc[Node], depth: u32) -> AllocError!u64 {
    if depth == 0 as u32 {
        return 0
    }
    var n: u64 = 0
    var i: u32 = 0
    while i < WIDTH {
        let e = try node.elem_new(100 + i, node.NS_HTML)
        node.append_child(parent, e)
        // Der Rueckverweis MUSS stehen, sonst waere der Zyklus keiner.
        if e.parent != parent {
            return 0
        }
        n = n + 1
        n = n + try tree_build(e, depth - 1)
        i = i + 1
    }
    return n
}

fn node_count(k: Gc[Node]) -> u64 {
    if k == gc_null[Node]() {
        return 0
    }
    var n: u64 = 1
    var c: Gc[Node] = k.first_child
    while c != gc_null[Node]() {
        n = n + node_count(c)
        c = c.next
    }
    return n
}

// Baut einen Baum, prueft ihn und laesst ihn mit der Rueckkehr fallen.
// EIGENE FUNKTION: der starke Zeiger darf nach der Rueckkehr in keinem
// LEBENDEN Rahmen mehr liegen (der Stapelscan ist konservativ, SPEC §3.5.3).
fn a_round(depth: u32) -> u64 {
    let d = node.document_new() catch gc_null[Document]()
    if d == gc_null[Document]() {
        return 0
    }
    let n: u64 = tree_build(d, depth) catch 0
    if n == 0 {
        return 0
    }
    // Der Baum ist ueber die Kinderkette vollstaendig erreichbar …
    if node_count(d) != n + 1 {
        return 0
    }
    // … und ueber die Elternkette wieder zurueck (das ist der Zyklus).
    var deep: Gc[Node] = d
    while deep.first_child != gc_null[Node]() {
        deep = deep.first_child
    }
    var high: Gc[Node] = deep
    while high.parent != gc_null[Node]() {
        high = high.parent
    }
    if high != d {
        return 0
    }
    // B: ein Sammellauf mitten im Betrieb nimmt nichts Erreichbares weg.
    gc_collect()
    if node_count(d) != n + 1 {
        return 0
    }
    return n
}

// Legt einen tiefen, genullten Rahmen ueber die aufgegebenen Rahmen: der
// konservative Stapelscan wuerde einen Altzeiger sonst als Wurzel lesen.
// Der Selbstaufruf haelt die Funktion aus dem Einbetter heraus.
fn scrub_deep(n: u64) {
    var buffer: [u64; 512] = [0; 512]
    var i: usize = 0
    while i < 512 {
        buffer[i] = 0
        i = i + 1
    }
    barrier(&buffer)
    if n > 0 {
        scrub_deep(n - 1)
    }
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    // Grundstand
    scrub_deep(3)
    gc_collect()
    let base: u64 = gc_live_objects()

    // A und B
    let n: u64 = a_round(DEPTH)
    if n == 0 {
        return 1
    }
    // 8 + 64 + 512 + 4096 = 4680 Elemente
    if n != 4680 {
        return 2
    }

    // C: unerreichbar -> eingesammelt
    scrub_deep(3)
    gc_collect()
    let after: u64 = gc_live_objects()
    if after > base + 64 {
        return 3
    }

    // D: viele Runden, kein Wachstum
    let heap0: u64 = gc_heap_bytes()
    var r: u32 = 0
    while r < 20 as u32 {
        if a_round(DEPTH) != 4680 {
            return 4
        }
        r = r + 1
    }
    scrub_deep(3)
    gc_collect()
    if gc_live_objects() > base + 64 {
        return 5
    }
    // Der Heap darf sich einmal einpendeln, aber nicht mit den Runden wachsen.
    let heap1: u64 = gc_heap_bytes()
    if heap1 > heap0 * 4 + 1048576 {
        return 6
    }
    // Es wurde wirklich gesammelt.
    if gc_collections() == 0 {
        return 7
    }
    return 0
}
