// expect_exit: 0
import std.rt
import std.vec

fn twice(dst: *mut Vec[i64], src: *mut Vec[i64]) {
    var i: usize = 0
    while i < vec_len[i64](dst) && i < vec_len[i64](src) {
        (*dst)[i] = (*dst)[i] + (*src)[i]
        (*dst)[i] = (*dst)[i] ^ (*src)[i]
        i = i + 1
    }
}

fn expect(x: i64, y: i64) -> i64 {
    return (x + y) ^ y
}

fn check(len: i64) -> i32 {
    var a: Vec[i64] = vec_new[i64]()
    var b: Vec[i64] = vec_new[i64]()
    var k: i64 = 0
    while k < len {
        vec_push[i64](&a, k * 13 + 1)
        vec_push[i64](&b, k * 7 + 3)
        k = k + 1
    }
    twice(&a, &b)
    var j: usize = 0
    while j < vec_len[i64](&a) {
        let x = (j as i64) * 13 + 1
        let y = (j as i64) * 7 + 3
        if (*(&a))[j] != expect(x, y) { return 1 }
        j = j + 1
    }
    twice(&b, &b)
    j = 0
    while j < vec_len[i64](&b) {
        let y = (j as i64) * 7 + 3
        if (*(&b))[j] != ((y + y) ^ (y + y)) { return 2 }
        j = j + 1
    }
    return 0
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var len: i64 = 0
    while len < 40 {
        let rc = check(len)
        if rc != 0 { return rc * 10 }
        len = len + 1
    }
    return 0
}
