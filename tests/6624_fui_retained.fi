// expect_exit: 0
import fui.retained
import paint.canvas
import std.rt

const W: usize = 64
const H: usize = 64

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn px(cv: *mut canvas.Canvas, x: usize, y: usize) -> u32 {
    return canvas.canvas_get(cv, x, y) | 4278190080 as u32
}

fn paint_band(cv: *mut canvas.Canvas, y: f64) {
    canvas.canvas_fill_rect(cv, 0.0, y, 40.0, y + 10.0, 4278190335 as u32)
    canvas.canvas_fill_rect(cv, 5.0, y + 2.0, 15.0, y + 6.0, 4294901760 as u32)
}

fn main() -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) { return 1 as i32 }
    canvas.canvas_clear(&cv, 4278190080 as u32)
    retained.clear(&cv)

    check("first call misses", !retained.begin(&cv, 7, 0.0, 10.0, 40.0, 10.0))
    paint_band(&cv, 10.0)
    retained.end(&cv)
    check("one miss counted", retained.misses() == 1)

    canvas.canvas_clear(&cv, 4278190080 as u32)
    check("same key hits at a new place", retained.begin(&cv, 7, 0.0, 30.0, 40.0, 10.0))
    check("hit counted", retained.hits() == 1)
    check("band base colour moved", px(&cv, 1, 31) == 4278190335 as u32 && px(&cv, 1, 39) == 4278190335 as u32)
    check("band detail moved", px(&cv, 8, 33) == 4294901760 as u32 && px(&cv, 20, 33) == 4278190335 as u32)
    check("nothing above the band", px(&cv, 1, 29) == 4278190080 as u32)
    check("nothing below the band", px(&cv, 1, 40) == 4278190080 as u32)
    check("nothing right of the band", px(&cv, 41, 33) == 4278190080 as u32)

    canvas.canvas_clear(&cv, 4278190080 as u32)
    check("other key misses", !retained.begin(&cv, 8, 0.0, 30.0, 40.0, 10.0))
    retained.abort()
    check("other size misses", !retained.begin(&cv, 7, 0.0, 30.0, 40.0, 12.0))
    retained.abort()

    canvas.canvas_clear(&cv, 4278190080 as u32)
    let pushed: bool = canvas.clip_push_rect(&cv, 0.0, 0.0, 64.0, 34.0)
    check("clip pushed", pushed)
    check("hit under a clip", retained.begin(&cv, 7, 0.0, 30.0, 40.0, 10.0))
    check("clipped part drawn", px(&cv, 1, 33) == 4278190335 as u32)
    check("part outside the clip untouched", px(&cv, 1, 34) == 4278190080 as u32 && px(&cv, 1, 38) == 4278190080 as u32)
    canvas.clip_pop(&cv)

    canvas.canvas_clear(&cv, 4278190080 as u32)
    let pushed2: bool = canvas.clip_push_rect(&cv, 0.0, 0.0, 64.0, 34.0)
    check("clip pushed again", pushed2)
    let misses0: u64 = retained.misses()
    check("partly clipped region is not captured", !retained.begin(&cv, 9, 0.0, 30.0, 40.0, 10.0))
    paint_band(&cv, 30.0)
    retained.end(&cv)
    canvas.clip_pop(&cv)
    check("miss counted for the clipped one", retained.misses() == misses0 + 1)
    check("clipped region left no picture", !retained.begin(&cv, 9, 0.0, 10.0, 40.0, 10.0))
    retained.abort()

    var n: i64 = 0
    var k: u64 = 100
    while k < 140 {
        let _m: bool = retained.begin(&cv, k, 0.0, 10.0, 40.0, 10.0)
        paint_band(&cv, 10.0)
        retained.end(&cv)
        k = k + 1
        n = n + 1
    }
    check("many keys evict the oldest", !retained.begin(&cv, 7, 0.0, 10.0, 40.0, 10.0))
    retained.abort()
    check("newest key still there", retained.begin(&cv, 139, 0.0, 10.0, 40.0, 10.0))

    retained.clear(&cv)
    check("clear drops everything", !retained.begin(&cv, 139, 0.0, 10.0, 40.0, 10.0))
    retained.abort()
    check("nothing held after clear", retained.held_bytes() == 0)
    canvas.canvas_free(&cv)
    return failures
}
