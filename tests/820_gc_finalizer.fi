// expect_exit: 0
// ROUND 47 -- FINALIZERS (SPEC 3.5.3 `S4`).
//
// What is promised is checked:
//   A  A registered finalizer RUNS when the object becomes unreachable --
//      with the right kind of cleanup, and the object is still readable
//      while it runs (its non-pointer fields).
//   B  Before the call ALL Gc fields of the object are cleared (the promise
//      that makes resurrection impossible: a finalizer never sees a pointer
//      to a neighbouring object that may already have been collected).
//   C  AT MOST ONCE per object.
//   D  A REACHABLE object is not finalized.
//   E  Bulk run: the dispatcher of the program ran exactly as often as the
//      collector counts, and the queue is empty afterwards.
//
// The finalizer cannot put its result anywhere -- stage 0 has no global
// mutables. That is why every object carries a RAW pointer to an mmap page;
// raw pointers are deliberately NOT cleared, only Gc[T] and
// GcWeak[T].

const T_SYS_MMAP: i64 = 9
const T_PROT_RW: i64 = 3
const T_MAP_ANON: i64 = 34

const Z_COUNT: u64 = 0
const Z_SUM: u64 = 8
const Z_ARTEN: u64 = 16
const Z_UNGENULLT: u64 = 24

gc class Handle {
    next: Gc[Handle],
    counter: *mut u8,
    tok_nr: u64,
}

// THE DISPATCHER. Because this root file declares it itself, the compiler
// leaves out its empty default (gc.rs::runtime_source).
fn __gc_finalize(kind: u64, p: *mut u8) {
    let g: Gc[Handle] = p as Gc[Handle]
    let z: u64 = g.counter as u64
    if z == 0 {
        return
    }
    *((z + Z_COUNT) as *mut u64) = *((z + Z_COUNT) as *mut u64) + 1
    *((z + Z_SUM) as *mut u64) = *((z + Z_SUM) as *mut u64) + g.tok_nr
    *((z + Z_ARTEN) as *mut u64) = *((z + Z_ARTEN) as *mut u64) + kind
    // B: the Gc field MUST be cleared.
    if g.next != gc_null[Handle]() {
        *((z + Z_UNGENULLT) as *mut u64) = 1
    }
}

fn page() -> u64 {
    let r: i64 = syscall(T_SYS_MMAP, 0, 4096, T_PROT_RW, T_MAP_ANON, -1, 0)
    if r < 0 && r > -4096 {
        return 0
    }
    return r as u64
}

fn ld(z: u64, off: u64) -> u64 {
    return *((z + off) as *mut u64)
}

// Exactly ONE object whose only strong reference lies in this frame.
// Recursive, so that the inliner does not pull the function into the caller
// -- otherwise the pointer would stay in the frame of `run` (conservative scan).
fn a(z: u64, depth: u64) -> AllocError!bool {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    if depth > 0 {
        return try a(z, depth - 1)
    }
    let g: Gc[Handle] = try gc Handle { next: gc_null[Handle](), counter: z as *mut u8, tok_nr: 42 }
    if !gc_finalizer_set(g as *mut u8, 5) {
        return false
    }
    if gc_finalizer_kind(g as *mut u8) != 5 {
        return false
    }
    return true
}

fn many(z: u64, n: u64, depth: u64) -> AllocError!bool {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    if depth > 0 {
        return try many(z, n, depth - 1)
    }
    var i: u64 = 0
    while i < n {
        let g: Gc[Handle] = try gc Handle { next: gc_null[Handle](), counter: z as *mut u8, tok_nr: 1 }
        if !gc_finalizer_set(g as *mut u8, 1 + i % 3) {
            return false
        }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    let z: u64 = page()
    if z == 0 {
        return 91
    }
    return run(z) catch 92
}

fn run(z: u64) -> AllocError!i32 {
    // --- D: a reachable object is not finalized ----------------------------
    let stays: Gc[Handle] = try gc Handle { next: gc_null[Handle](), counter: z as *mut u8, tok_nr: 7 }
    if !gc_finalizer_set(stays as *mut u8, 9) {
        return 1
    }

    // --- A/B: exactly one dying object -------------------------------------
    if !(try a(z, 2)) {
        return 2
    }
    gc_collect()
    if gc_fin_runs() != 1 {
        return 3
    }
    if ld(z, Z_COUNT) != 1 {
        return 4
    }
    if ld(z, Z_SUM) != 42 {
        return 5
    }
    if ld(z, Z_ARTEN) != 5 {
        return 6
    }
    if ld(z, Z_UNGENULLT) != 0 {
        return 7
    }
    if gc_fin_waiting() != 0 {
        return 8
    }

    // --- C: not a second time ----------------------------------------------
    gc_collect()
    gc_collect()
    if gc_fin_runs() != 1 {
        return 9
    }
    if ld(z, Z_COUNT) != 1 {
        return 10
    }

    // --- D: the reachable object lives and carries its kind on -------------
    if stays.tok_nr != 7 {
        return 11
    }
    if gc_finalizer_kind(stays as *mut u8) != 9 {
        return 12
    }

    // --- E: bulk run --------------------------------------------------------
    let n: u64 = 300
    if !(try many(z, n, 2)) {
        return 13
    }
    gc_collect()
    gc_collect()
    let runs: u64 = gc_fin_runs()
    // 1 from part A; the reachable `remains` must never be among them.
    if runs < 1 + n - 20 {
        return 14
    }
    if runs > 1 + n {
        return 15
    }
    // The dispatcher of the PROGRAM ran exactly as often as the collector counts.
    if ld(z, Z_COUNT) != runs {
        return 16
    }
    if ld(z, Z_UNGENULLT) != 0 {
        return 17
    }
    if gc_fin_waiting() != 0 {
        return 18
    }
    if gc_fin_registered() != 1 + 1 + n {
        return 19
    }
    // Kinds 1..3 in the bulk run, 5 from part A.
    if ld(z, Z_ARTEN) < 5 + (runs - 1) {
        return 20
    }
    if ld(z, Z_ARTEN) > 5 + 3 * (runs - 1) {
        return 21
    }
    // `remains` survived it all.
    if stays.tok_nr != 7 {
        return 22
    }
    return 0
}
