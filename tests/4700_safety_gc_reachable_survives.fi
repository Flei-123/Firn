// expect_exit: 0
// r899: objects still reachable from a root survive gc_collect (no dangling Gc[T]).
// 20000 nodes are allocated, every second one is linked into the list.
gc class N { next: Gc[N], v: u64 }

fn main() -> i32 {
    if !gc_init() { return 9 }
    var head: Gc[N] = gc_null[N]()
    var i: u64 = 0
    while i < 20000 {
        let n = gc N { next: head, v: i } catch gc_null[N]()
        if n == gc_null[N]() { return 1 }
        if i % 2 == 0 {
            head = n
        }
        i = i + 1
    }
    gc_collect()
    var s: u64 = 0
    var sum: u64 = 0
    var p: Gc[N] = head
    while p != gc_null[N]() {
        s = s + 1
        sum = sum + p.v
        p = p.next
    }
    if s != 10000 { return 2 }
    if sum != 99990000 { return 3 }
    return 0
}
