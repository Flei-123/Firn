// expect_exit: 0
// Runde 53, das Kernstueck: eine Sammlung, die WAEHREND einer laufenden
// Markierung veraendert wird, darf kein Element verlieren.
//
// ----------------------------------------------------------------- Wovon
//
// Seit Runde 44 markiert der Sammler in Scheiben. Ein Behaelter, der als
// Wurzel erreichbar ist, wird frueh im Zyklus verfolgt und ist danach
// SCHWARZ, waehrend das Programm weiterarbeitet.
//
// Die erste Vermutung — „ein frisch angehaengtes Objekt verschwindet hinter
// dem schwarzen Puffer" — ist NACHGEMESSEN FALSCH: `__gc_alloc_raw` faerbt
// waehrend eines Zyklus jedes frisch allozierte Objekt grau. Der Fall
// existiert dafuer gar nicht.
//
// Der Fall, den es WIRKLICH gibt, ist das UMHAENGEN eines schon
// vorhandenen Objekts — also genau `appendChild`:
//
//     Ziel   schon verfolgt (schwarz),
//     Quelle noch nicht verfolgt (weiss),
//     dann `z` aus der Quelle heraus und in das Ziel hinein.
//
// Der Sammler sieht `z` danach nirgends mehr: im Ziel nicht, weil das schon
// durch ist, in der Quelle nicht, weil es dort nicht mehr steht. `z` bleibt
// weiss und wird gefegt. Die Einfuegebarriere in `gcvec_anhaengen_roh`
// verhindert das, indem sie `z` grau faerbt.
//
// -------------------------------------------------------------- Wie oft
//
// Von selbst tritt der Fall fast nie ein: gemessen fielen 526 von 200.000
// Anhaengungen in eine laufende Markierung (0,26 %) und KEIN einziges
// Pufferwachstum. Ein Test, der darauf wartet, prueft nichts. Deshalb
// stellt er die Markierscheibe mit `gc_set_scheibe(2)` auf zwei Objekte —
// dann erstreckt sich die Markierphase ueber so viele Allokationen, wie es
// lebende Objekte gibt, und der Fall wird zum Normalfall (gemessen: 78.762
// Umhaengungen in Phase 1).
//
// GEGENPROBE (docs/RUNDE53.md §4, wirklich ausgefuehrt): ohne den
// `__gc_barrier`-Aufruf in `gcvec_anhaengen_roh` meldet dieser Test 96 —
// die Markensumme war 81.672.010 statt 81.926.400, es fehlten 254.390.

import std.io

gc class Cell {
    next: Gc[Cell],
    mark: u64,
}

const M: u64 = 64
const K: u64 = 200
const RUNDEN: u64 = 4

// Muell, den niemand haelt. Der Selbstaufruf ist Absicht: eine rekursive
// Funktion wird nicht eingebettet, damit die toten Zeiger nicht im lebenden
// Rahmen des Aufrufers landen (derselbe Grund wie bei `dom_observer_lebt`).
fn garbage(k: u64) -> AllocError!u64 {
    if k == 0 {
        return 0
    }
    let dead: Gc[Cell] = try gc Cell{ next: gc_null[Cell](), mark: 0 }
    return try garbage(k - 1)
}

fn build(all: Gc[GcVec]) -> AllocError!bool {
    var j: u64 = 0
    while j < M {
        let v: Gc[GcVec] = try gcvec_new()
        let ok: bool = try gcvec_append[GcVec](all, v)
        var k: u64 = 0
        while k < K {
            let z: Gc[Cell] = try gc Cell{
                next: gc_null[Cell](),
                mark: j * K + k + 1,
            }
            let o2: bool = try gcvec_append[Cell](v, z)
            k = k + 1
        }
        j = j + 1
    }
    return true
}

// Je Runde: einen Zyklus starten, WAEHREND des Markierens umhaengen (und
// das Markieren mit je einer Allokation voranbringen), dann den Zyklus
// zuende bringen — nur so faellt ein Fegen wirklich in dieselbe Runde.
fn relink(all: Gc[GcVec], p1a: *mut u64) -> AllocError!bool {
    var p1: u64 = 0
    var r: u64 = 0
    while r < RUNDEN {
        var s: u64 = 0
        while gc_phase() != 1 && s < 400000 {
            let m: u64 = try garbage(1)
            s = s + 1
        }
        let l0: u64 = gc_collections()
        var t: u64 = 0
        while gc_phase() == 1 && t < 60000 {
            let j: u64 = (r * 7 + t) % M
            let of: Gc[GcVec] = gcvec_read[GcVec](all, j)
            let after: Gc[GcVec] = gcvec_read[GcVec](all, (j * 13 + 5) % M)
            if gcvec_length(of) > 0 {
                p1 = p1 + 1
                let z: Gc[Cell] = gcvec_detach[Cell](of)
                let ok: bool = try gcvec_append[Cell](after, z)
            }
            let m: u64 = try garbage(1)
            t = t + 1
        }
        var g: u64 = 0
        while gc_collections() == l0 && g < 400000 {
            let m: u64 = try garbage(16)
            g = g + 1
        }
        r = r + 1
    }
    *p1a = p1
    return true
}

fn count(all: Gc[GcVec]) -> u64 {
    var s: u64 = 0
    var j: u64 = 0
    while j < M {
        s = s + gcvec_length(gcvec_read[GcVec](all, j))
        j = j + 1
    }
    return s
}

fn mark_sum(all: Gc[GcVec]) -> u64 {
    var s: u64 = 0
    var j: u64 = 0
    while j < M {
        let v: Gc[GcVec] = gcvec_read[GcVec](all, j)
        var k: u64 = 0
        while k < gcvec_length(v) {
            let z: Gc[Cell] = gcvec_read[Cell](v, k)
            if (z as u64) == 0 {
                return 0
            }
            s = s + z.mark
            k = k + 1
        }
        j = j + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    let all: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
    if (all as u64) == 0 {
        return 91
    }
    if !(build(all) catch false) {
        return 92
    }
    gc_collect()
    let should: u64 = M * K * (M * K + 1) / 2

    var p1: u64 = 0
    gc_set_slice(2)
    let ok: bool = relink(all, &p1) catch false
    gc_set_slice(0)
    if !ok {
        return 93
    }
    // Der Test muss den kritischen Fall wirklich getroffen haben.
    if p1 < 10000 {
        return 94
    }
    // Muellwelle: ein faelschlich freigegebener Block wird dadurch
    // WIEDERVERWENDET. Ohne das faellt ein Verlust nicht auf — der Inhalt
    // eines freien Blocks bleibt lesbar.
    var w: u64 = 0
    while w < 80 {
        let m: u64 = garbage(2000) catch 0
        w = w + 1
    }
    gc_collect()

    if count(all) != M * K {
        return 95
    }
    if mark_sum(all) != should {
        return 96
    }
    // Und am Ende muss alles auch wirklich WEG koennen: die Vektoren leeren,
    // dann darf von den 12.800 Zellen nichts uebrig bleiben.
    let before: u64 = gc_live_objects()
    var j: u64 = 0
    while j < M {
        gcvec_clear(gcvec_read[GcVec](all, j))
        j = j + 1
    }
    gc_collect()
    gc_collect()
    if gc_live_objects() > before - M * K + 16 {
        return 97
    }
    return 0
}
