// expect_exit: 0
// tests/1403_core_page_allocator.fi -- ROUND 73: THE SECOND IMPLEMENTATION.
//
// The `Allocator` interface stands in `lib/std/core.fi`, because a kernel
// has to be able to name it. `PageAllocator` (mmap) stands in
// `lib/std/mem.fi`, because it makes a system call and would render
// `std.core` unusable in a kernel. That the two find each other ACROSS THE
// MODULE BOUNDARY is the point of this test: `interface` holds program
// wide in Firn (docs/ROUND46.md 9), so `impl Allocator for PageAllocator`
// works in a different file than the one the contract stands in.
//
// And the layer above notices nothing. `hand_out` is written ONCE and runs
// with the arena as well as with mmap -- the same call site, two entirely
// different sources of memory.
import std.core
import std.mem

fn main() -> i32 {
    var pages: mem.PageAllocator = mem.pages_new()
    let big: dyn Allocator = (&pages) as dyn Allocator

    // 1. from the operating system, and the bookkeeping is honest
    let b: core.Block = core.alloc(big, 4096, 16)
    if !b.ok || b.n != 4096 { return 1 }
    if pages.live() != 4096 { return 2 }
    if pages.given() != 1 || pages.released() != 0 { return 3 }
    core.mem_zero(b.p, b.n)
    core.st8(b.p, 4095, 42 as u8)
    if core.ld8(b.p, 4095) != 42 as u8 { return 4 }

    // 2. mmap hands out page boundaries -- every alignment up to 4096 is
    //    satisfied by construction, and above that the answer is an honest
    //    refusal instead of a shifted address that cannot be given back.
    if (b.p as usize) % 4096 != 0 { return 5 }
    if core.alloc(big, 16, 8192).ok { return 6 }
    if mem.pages_refused(&pages) != 1 { return 7 }

    // 3. growing: mmap cannot do it in place, so `grow` copies -- and says
    //    so by handing out a DIFFERENT address while keeping the contents.
    let g: core.Block = core.grow(big, b, 8192, 16)
    if !g.ok || g.n != 8192 { return 8 }
    if core.ld8(g.p, 4095) != 42 as u8 { return 9 }
    if pages.live() != 8192 { return 10 }
    if pages.given() != 2 || pages.released() != 1 { return 11 }

    // 4. giving back really gives back
    core.free(big, g, 16)
    if pages.live() != 0 { return 12 }
    if pages.released() != 2 { return 13 }
    core.free(big, core.block_none(), 16) // nothing at all: no crash
    if pages.released() != 2 { return 14 }

    // 5. ONE CALL SITE, TWO ALLOCATORS. `hand_out` was written once.
    var pool: [u8; 4096] = [0; 4096]
    var a: core.Arena = core.arena_new(&pool[0], 4096)
    if hand_out((&a) as dyn Allocator, 512) != 512 { return 15 }
    if hand_out(big, 512) != 512 { return 16 }
    // the arena has its 512 octets from the frame, mmap has given
    // everything back -- two sources, one shape.
    if core.arena_given(&a) != 1 { return 17 }
    if pages.live() != 0 { return 18 }

    // 6. THE ARENA OVER MMAP MEMORY -- the pattern a real program uses:
    //    ONE system call at the start, and everything after that free of
    //    charge. `tools/core/soak.fi` measures exactly this over 40 000
    //    rounds and finds RSS standing still.
    let region: core.Block = core.alloc(big, 65536, 4096)
    if !region.ok { return 19 }
    var over: core.Arena = core.arena_new(region.p, region.n)
    let calls_before: u64 = pages.given()
    var i: usize = 0
    while i < 1000 {
        let piece: core.Block = core.alloc((&over) as dyn Allocator, 48, 16)
        if !piece.ok { return 20 }
        core.st8(piece.p, 0, (i % 251) as u8)
        if core.ld8(piece.p, 0) != (i % 251) as u8 { return 21 }
        if i % 100 == 99 {
            core.arena_reset(&over)
        }
        i = i + 1
    }
    if pages.given() != calls_before { return 22 }
    if core.arena_given(&over) != 1000 { return 23 }
    core.free(big, region, 4096)
    if pages.live() != 0 { return 24 }

    return 0
}

// Written once, runs with any allocator: that is what the interface buys.
// The block is filled and given back, so a leak here would show up in the
// bookkeeping of whichever allocator was handed in.
fn hand_out(a: dyn Allocator, n: usize) -> usize {
    let b: core.Block = core.alloc(a, n, 16)
    if !b.ok {
        return 0
    }
    core.mem_zero(b.p, b.n)
    let got: usize = b.n
    core.free(a, b, 16)
    return got
}
