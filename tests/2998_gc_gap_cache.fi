// expect_exit: 0
// r566: a root word that points into non-GC memory between the chunks is
// answered from a remembered gap (no binary search). The gap must be forgotten
// when a chunk is mapped into it: strings pushed after such a scan must
// survive, whatever the address space looked like when the gap was recorded.
// r569: the raw block is big (not cached by rt.heap_alloc, so it is really
// unmapped), the heap then grows by several chunks that fill the hole, and
// freed blocks are overwritten by fresh allocations before the check.
import std.vec
import std.rt

fn make(i: u32) -> str {
    return "item-" + "0123456789abcdef" + "-x"
}

fn churn(rounds: u32) -> u64 {
    var k: u32 = 0
    var sum: u64 = 0
    while k < rounds {
        let s: str = "garbage-" + "0123456789abcdef0123456789abcdef"
        sum = sum + s.n as u64
        k = k + 1
    }
    return sum
}

fn check_all(v: *mut Vec[str]) -> bool {
    var j: usize = 0
    while j < vec_len[str](v) {
        let p: u64 = vec_elem_ptr[str](v, j) as u64
        let s: str = *(p as *mut str)
        if s.n != 23 { return false }
        if s != "item-0123456789abcdef-x" { return false }
        j = j + 1
    }
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[str] = vec_new[str]()
    var other: Vec[str] = vec_new[str]()
    // many words of the buffer point into non-GC memory (raw blocks)
    var rv: Vec[str] = vec_new[str]()
    var round: u32 = 0
    while round < 12 {
        let raw: u64 = rt.heap_alloc(8388608)
        if raw == 0 { return 2 }
        rt.st64(raw, 0, round as u64)
        // strings whose data pointer names the raw block (non-GC memory): the
        // root scan of rv sees many words that point between the chunks
        var k: u32 = 0
        while k < 50 {
            var rs: str = make(k)
            rt.st64((&rs) as u64, 0, raw + (k as u64) * 8)
            if !vec_push[str](&rv, rs) { return 3 }
            if !vec_push[str](&v, make(k)) { return 4 }
            k = k + 1
        }
        gc_collect()
        if !check_all(&v) { return 5 }
        // unmap the raw block: chunks may now be mapped where the gap was
        rt.heap_free(raw, 8388608)
        vec_clear[str](&rv)
        // the heap grows by about 1.5 MiB of live strings
        var m: u32 = 0
        while m < 30000 {
            if !vec_push[str](&v, make(m)) { return 7 }
            m = m + 1
        }
        gc_collect()
        // fresh allocations reuse what a wrong sweep would have freed
        var n: u32 = 0
        while n < 30000 {
            let t: str = "other-" + "fedcba9876543210" + "-y"
            if !vec_push[str](&other, t) { return 9 }
            n = n + 1
        }
        if !check_all(&v) { return 8 }
        vec_clear[str](&other)
        round = round + 1
    }
    return 0
}
