// expect_exit: 0
// tests/3603_cal_rrule_rfc.fi -- cal.rrule: the examples of RFC 5545 section 3.8.5.3 (the lists are
// the ones printed in the RFC), parse / format round trips and refused rules. The random
// comparison with dateutil is tools/cal_cross/run.sh.
import std.rt
import std.vec
import cal.ical
import cal.rrule

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn same(b: *mut rt.Buf, want: str) -> bool {
    return rt.buf_len(b) == want.n && rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.n)
}

// expands `rule` from `start` (DATE-TIME text) and compares with the comma list `want` of DATE-TIMEs
fn occ(name: str, rule: str, start: str, max_n: usize, want: str) {
    var r: rrule.Rule = rrule.rule_new()
    var dv: ical.DateVal = ical.DateVal { y: 0, m: 0, d: 0, hh: 0, mm: 0, ss: 0, date_only: false, utc: false }
    check(name, rrule.parse(rule, &r) == rrule.E_OK && ical.parse_datetime(start, &dv))
    var out: Vec[i64] = vec_new[i64]()
    rrule.expand(&r, ical.secs_of(dv), ical.secs_of(dv), rrule.FAR, max_n, &out)
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < vec_len[i64](&out) {
        if i > 0 {
            rt.buf_push(&b, 44 as u8)
        }
        ical.format_datetime(ical.from_secs(vec_at[i64](&out, i), false, false), &b)
        i = i + 1
    }
    if !same(&b, want) {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, " got ".p as u64, 5)
        rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
        rt.write_everything(1, "\n".p as u64, 1)
    }
    rt.buf_free(&b)
    vec_free[i64](&out)
    rrule.rule_free(&r)
}

fn count_of(rule: str, start: str, max_n: usize) -> usize {
    var r: rrule.Rule = rrule.rule_new()
    var dv: ical.DateVal = ical.DateVal { y: 0, m: 0, d: 0, hh: 0, mm: 0, ss: 0, date_only: false, utc: false }
    rrule.parse(rule, &r)
    ical.parse_datetime(start, &dv)
    var out: Vec[i64] = vec_new[i64]()
    rrule.expand(&r, ical.secs_of(dv), ical.secs_of(dv), rrule.FAR, max_n, &out)
    let n: usize = vec_len[i64](&out)
    vec_free[i64](&out)
    rrule.rule_free(&r)
    return n
}

fn roundtrip(rule: str, want: str) {
    var r: rrule.Rule = rrule.rule_new()
    check(rule, rrule.parse(rule, &r) == rrule.E_OK)
    var b: rt.Buf = rt.buf_new()
    rrule.format(&r, &b)
    if !same(&b, want) {
        failures += 1
        rt.write_everything(1, "  FAIL  format ".p as u64, 15)
        rt.write_everything(1, rule.p as u64, rule.n)
        rt.write_everything(1, " -> ".p as u64, 4)
        rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
        rt.write_everything(1, "\n".p as u64, 1)
    }
    // and the formatted rule parses to the same text again
    var r2: rrule.Rule = rrule.rule_new()
    var b2: rt.Buf = rt.buf_new()
    check("reparse", rrule.parse(str { p: rt.buf_data(&b), n: rt.buf_len(&b) }, &r2) == rrule.E_OK)
    rrule.format(&r2, &b2)
    check("format stable", rt.buf_len(&b) == rt.buf_len(&b2) && rt.mem_eq(rt.buf_ptr(&b), rt.buf_ptr(&b2), rt.buf_len(&b)))
    rt.buf_free(&b)
    rt.buf_free(&b2)
    rrule.rule_free(&r)
    rrule.rule_free(&r2)
}

fn refused(rule: str, code: u32) {
    var r: rrule.Rule = rrule.rule_new()
    check(rule, rrule.parse(rule, &r) == code)
    rrule.rule_free(&r)
}

fn main() -> i32 {
    occ("daily 10", "FREQ=DAILY;COUNT=10", "19970902T090000", 100,
        "19970902T090000,19970903T090000,19970904T090000,19970905T090000,19970906T090000,19970907T090000,19970908T090000,19970909T090000,19970910T090000,19970911T090000")
    check("daily until 24 Dec", count_of("FREQ=DAILY;UNTIL=19971224T000000Z", "19970902T090000", 1000) == 113)
    occ("every other day", "FREQ=DAILY;INTERVAL=2;COUNT=5", "19970902T090000", 100,
        "19970902T090000,19970904T090000,19970906T090000,19970908T090000,19970910T090000")
    occ("every 10 days", "FREQ=DAILY;INTERVAL=10;COUNT=5", "19970902T090000", 100,
        "19970902T090000,19970912T090000,19970922T090000,19971002T090000,19971012T090000")
    occ("weekly 10", "FREQ=WEEKLY;COUNT=10", "19970902T090000", 100,
        "19970902T090000,19970909T090000,19970916T090000,19970923T090000,19970930T090000,19971007T090000,19971014T090000,19971021T090000,19971028T090000,19971104T090000")
    occ("weekly TU,TH", "FREQ=WEEKLY;COUNT=10;WKST=SU;BYDAY=TU,TH", "19970902T090000", 100,
        "19970902T090000,19970904T090000,19970909T090000,19970911T090000,19970916T090000,19970918T090000,19970923T090000,19970925T090000,19970930T090000,19971002T090000")
    occ("every other week MO,WE,FR", "FREQ=WEEKLY;INTERVAL=2;COUNT=8;WKST=SU;BYDAY=MO,WE,FR", "19970901T090000", 100,
        "19970901T090000,19970903T090000,19970905T090000,19970915T090000,19970917T090000,19970919T090000,19970929T090000,19971001T090000")
    occ("WKST=MO", "FREQ=WEEKLY;INTERVAL=2;COUNT=4;BYDAY=TU,SU;WKST=MO", "19970805T090000", 100,
        "19970805T090000,19970810T090000,19970819T090000,19970824T090000")
    occ("WKST=SU", "FREQ=WEEKLY;INTERVAL=2;COUNT=4;BYDAY=TU,SU;WKST=SU", "19970805T090000", 100,
        "19970805T090000,19970817T090000,19970819T090000,19970831T090000")
    occ("monthly first friday", "FREQ=MONTHLY;COUNT=10;BYDAY=1FR", "19970905T090000", 100,
        "19970905T090000,19971003T090000,19971107T090000,19971205T090000,19980102T090000,19980206T090000,19980306T090000,19980403T090000,19980501T090000,19980605T090000")
    occ("monthly last day -3", "FREQ=MONTHLY;BYMONTHDAY=-3", "19970928T090000", 3,
        "19970928T090000,19971029T090000,19971128T090000")
    occ("monthly 2nd and 15th", "FREQ=MONTHLY;COUNT=10;BYMONTHDAY=2,15", "19970902T090000", 100,
        "19970902T090000,19970915T090000,19971002T090000,19971015T090000,19971102T090000,19971115T090000,19971202T090000,19971215T090000,19980102T090000,19980115T090000")
    occ("monthly first and last day", "FREQ=MONTHLY;COUNT=10;BYMONTHDAY=1,-1", "19970930T090000", 100,
        "19970930T090000,19971001T090000,19971031T090000,19971101T090000,19971130T090000,19971201T090000,19971231T090000,19980101T090000,19980131T090000,19980201T090000")
    occ("every 18 months", "FREQ=MONTHLY;INTERVAL=18;COUNT=10;BYMONTHDAY=10,11,12,13,14,15", "19970910T090000", 100,
        "19970910T090000,19970911T090000,19970912T090000,19970913T090000,19970914T090000,19970915T090000,19990310T090000,19990311T090000,19990312T090000,19990313T090000")
    occ("every tuesday every other month", "FREQ=MONTHLY;INTERVAL=2;BYDAY=TU", "19970902T090000", 9,
        "19970902T090000,19970909T090000,19970916T090000,19970923T090000,19970930T090000,19971104T090000,19971111T090000,19971118T090000,19971125T090000")
    occ("yearly june, july", "FREQ=YEARLY;COUNT=10;BYMONTH=6,7", "19970610T090000", 100,
        "19970610T090000,19970710T090000,19980610T090000,19980710T090000,19990610T090000,19990710T090000,20000610T090000,20000710T090000,20010610T090000,20010710T090000")
    occ("every other year", "FREQ=YEARLY;INTERVAL=2;COUNT=10;BYMONTH=1,2,3", "19970310T090000", 100,
        "19970310T090000,19990110T090000,19990210T090000,19990310T090000,20010110T090000,20010210T090000,20010310T090000,20030110T090000,20030210T090000,20030310T090000")
    occ("every 3rd year days 1,100,200", "FREQ=YEARLY;INTERVAL=3;COUNT=10;BYYEARDAY=1,100,200", "19970101T090000", 100,
        "19970101T090000,19970410T090000,19970719T090000,20000101T090000,20000409T090000,20000718T090000,20030101T090000,20030410T090000,20030719T090000,20060101T090000")
    occ("monday of week 20", "FREQ=YEARLY;BYWEEKNO=20;BYDAY=MO", "19970512T090000", 3,
        "19970512T090000,19980511T090000,19990517T090000")
    occ("thursday in march", "FREQ=YEARLY;BYMONTH=3;BYDAY=TH", "19970313T090000", 6,
        "19970313T090000,19970320T090000,19970327T090000,19980305T090000,19980312T090000,19980319T090000")
    occ("friday the 13th", "FREQ=MONTHLY;BYDAY=FR;BYMONTHDAY=13", "19970902T090000", 5,
        "19980213T090000,19980313T090000,19981113T090000,19990813T090000,20001013T090000")
    occ("first saturday after first sunday", "FREQ=MONTHLY;BYDAY=SA;BYMONTHDAY=7,8,9,10,11,12,13", "19970913T090000", 4,
        "19970913T090000,19971011T090000,19971108T090000,19971213T090000")
    occ("us presidential election day", "FREQ=YEARLY;INTERVAL=4;BYMONTH=11;BYDAY=TU;BYMONTHDAY=2,3,4,5,6,7,8", "19961105T090000", 3,
        "19961105T090000,20001107T090000,20041102T090000")
    occ("3rd instance of tu,we,th", "FREQ=MONTHLY;COUNT=3;BYDAY=TU,WE,TH;BYSETPOS=3", "19970904T090000", 100,
        "19970904T090000,19971007T090000,19971106T090000")
    occ("second to last weekday", "FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-2", "19970929T090000", 7,
        "19970929T090000,19971030T090000,19971127T090000,19971230T090000,19980129T090000,19980226T090000,19980330T090000")
    occ("last working day", "FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-1", "19970930T090000", 7,
        "19970930T090000,19971031T090000,19971128T090000,19971231T090000,19980130T090000,19980227T090000,19980331T090000")
    occ("every 3 hours", "FREQ=HOURLY;INTERVAL=3;UNTIL=19970902T170000Z", "19970902T090000", 100,
        "19970902T090000,19970902T120000,19970902T150000")
    occ("every 15 minutes", "FREQ=MINUTELY;INTERVAL=15;COUNT=6", "19970902T090000", 100,
        "19970902T090000,19970902T091500,19970902T093000,19970902T094500,19970902T100000,19970902T101500")
    occ("every 90 minutes", "FREQ=MINUTELY;INTERVAL=90;COUNT=4", "19970902T090000", 100,
        "19970902T090000,19970902T103000,19970902T120000,19970902T133000")
    occ("every 20 minutes 9-16", "FREQ=DAILY;BYHOUR=9,10,11,12,13,14,15,16;BYMINUTE=0,20,40", "19970902T090000", 5,
        "19970902T090000,19970902T092000,19970902T094000,19970902T100000,19970902T102000")
    occ("leap day", "FREQ=YEARLY;COUNT=3", "19960229T090000", 100,
        "19960229T090000,20000229T090000,20040229T090000")
    occ("31st of the month", "FREQ=MONTHLY;COUNT=5;BYMONTHDAY=31", "19970131T090000", 100,
        "19970131T090000,19970331T090000,19970531T090000,19970731T090000,19970831T090000")
    check("impossible date ends", count_of("FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=30", "19970101T090000", 10) == 0)
    check("COUNT=1", count_of("FREQ=DAILY;COUNT=1", "19970101T090000", 10) == 1)
    check("max_n stops", count_of("FREQ=SECONDLY", "19970101T090000", 7) == 7)

    roundtrip("FREQ=WEEKLY;INTERVAL=2;COUNT=4;BYDAY=TU,SU;WKST=MO", "FREQ=WEEKLY;INTERVAL=2;COUNT=4;BYDAY=TU,SU;WKST=MO")
    roundtrip("freq=monthly;byday=-1fr;until=19980101", "FREQ=MONTHLY;UNTIL=19980101;BYDAY=-1FR")
    roundtrip("FREQ=YEARLY;BYMONTH=11;BYDAY=TU;BYMONTHDAY=2,3,4,5,6,7,8;INTERVAL=4", "FREQ=YEARLY;INTERVAL=4;BYMONTH=11;BYMONTHDAY=2,3,4,5,6,7,8;BYDAY=TU")
    roundtrip("FREQ=HOURLY;UNTIL=19970902T170000Z", "FREQ=HOURLY;UNTIL=19970902T170000Z")
    refused("COUNT=3", rrule.E_NO_FREQ)
    refused("FREQ=DAILY;INTERVAL=0", rrule.E_RANGE)
    refused("FREQ=DAILY;BYMONTH=13", rrule.E_RANGE)
    refused("FREQ=DAILY;BYMONTHDAY=0", rrule.E_RANGE)
    refused("FREQ=DAILY;BYHOUR=24", rrule.E_RANGE)
    refused("FREQ=DAILY;BYSECOND=60", rrule.E_RANGE)
    refused("FREQ=DAILY;BYWEEKNO=54", rrule.E_RANGE)
    refused("FREQ=FORTNIGHTLY", rrule.E_SYNTAX)
    refused("FREQ=DAILY;COUNT=x", rrule.E_SYNTAX)
    refused("FREQ=DAILY;UNTIL=1997", rrule.E_SYNTAX)
    refused("FREQ=DAILY;BYDAY=XX", rrule.E_SYNTAX)
    refused("FREQ", rrule.E_SYNTAX)

    // UNTIL in UTC moved onto a local clock (UTC+2): 19970902T170000Z is 19:00 local
    var r: rrule.Rule = rrule.rule_new()
    rrule.parse("FREQ=HOURLY;INTERVAL=3;UNTIL=19970902T170000Z", &r)
    rrule.until_to_local(&r, 7200)
    var dv: ical.DateVal = ical.DateVal { y: 0, m: 0, d: 0, hh: 0, mm: 0, ss: 0, date_only: false, utc: false }
    ical.parse_datetime("19970902T090000", &dv)
    var out: Vec[i64] = vec_new[i64]()
    rrule.expand(&r, ical.secs_of(dv), ical.secs_of(dv), rrule.FAR, 100, &out)
    check("until moved to local", vec_len[i64](&out) == 4)
    vec_free[i64](&out)
    rrule.rule_free(&r)

    if failures == 0 {
        rt.write_everything(1, "ok\n".p as u64, 3)
        return 0
    }
    return 1
}
