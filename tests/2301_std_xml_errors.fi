// expect_exit: 0
// tests/2301_std_xml_errors.fi -- r319: `lib/std/xml.fi` REFUSES what is not
// well-formed, and says WHERE (line:column, 1-based, columns count characters).
//
// Each row of `main` is one document, the line and column of the error and
// (where it matters) the message. A parser that accepts a broken document is
// a worse bug than one that refuses a good one: the sender's parser would
// have refused it.
import std.xml
import std.rt
import std.str

// 0 = right; otherwise 1 (accepted!), 2 (wrong line), 3 (wrong column), 4 (wrong text)
fn bad(d: *mut xml.Doc, doc: str, line: usize, col: usize, why: str) -> i32 {
    let ok: bool = xml.parse_str(d, doc) catch false
    if ok {
        return 1
    }
    if xml.valid(d) || xml.root(d) != xml.NONE {
        return 1
    }
    if xml.err_line(d) != line {
        return 2
    }
    if xml.err_col(d) != col {
        return 3
    }
    if !(xml.err_text(d) == why) {
        return 4
    }
    return 0
}

fn main() -> i32 {
    var d: xml.Doc = xml.doc_new()
    defer xml.doc_free(&d)
    var r: i32 = 0

    // --- structure
    r = bad(&d, "", 1, 1, "no root element")
    if r != 0 { return 10 + r }
    r = bad(&d, "  \n ", 2, 2, "no root element")
    if r != 0 { return 15 + r }
    r = bad(&d, "<a>", 1, 4, "the input ends too early")
    if r != 0 { return 20 + r }
    r = bad(&d, "<a></b>", 1, 6, "the end tag does not match the start tag")
    if r != 0 { return 25 + r }
    r = bad(&d, "<a>\n <b>\n</a>", 3, 3, "the end tag does not match the start tag")
    if r != 0 { return 30 + r }
    r = bad(&d, "<a/><b/>", 1, 5, "content outside of the root element")
    if r != 0 { return 35 + r }
    r = bad(&d, "x<a/>", 1, 1, "content outside of the root element")
    if r != 0 { return 40 + r }
    r = bad(&d, "<a/>x", 1, 5, "content outside of the root element")
    if r != 0 { return 45 + r }
    r = bad(&d, "</a>", 1, 1, "content outside of the root element")
    if r != 0 { return 50 + r }
    r = bad(&d, "<a></a x>", 1, 8, "'>' expected")
    if r != 0 { return 55 + r }
    r = bad(&d, "<a/ >", 1, 3, "'>' expected")
    if r != 0 { return 60 + r }
    r = bad(&d, "<1/>", 1, 2, "a name was expected")
    if r != 0 { return 65 + r }
    r = bad(&d, "< a/>", 1, 2, "a name was expected")
    if r != 0 { return 70 + r }

    // --- attributes
    r = bad(&d, "<a x=1/>", 1, 6, "an attribute value must be quoted")
    if r != 0 { return 75 + r }
    r = bad(&d, "<a x=\"1\" x=\"2\"/>", 1, 10, "duplicate attribute")
    if r != 0 { return 80 + r }
    r = bad(&d, "<a x=\"1\"y=\"2\"/>", 1, 9, "white space expected between attributes")
    if r != 0 { return 85 + r }
    r = bad(&d, "<a x>", 1, 5, "'=' expected after an attribute name")
    if r != 0 { return 90 + r }
    r = bad(&d, "<a\n  b=\"1\"\n  c></a>", 3, 4, "'=' expected after an attribute name")
    if r != 0 { return 95 + r }
    r = bad(&d, "<a x=\"<\"/>", 1, 7, "'<' in an attribute value")
    if r != 0 { return 100 + r }
    r = bad(&d, "<a x=\"1", 1, 8, "the input ends too early")
    if r != 0 { return 105 + r }

    // --- references and special sections
    r = bad(&d, "<a>&foo;</a>", 1, 4, "undefined entity or malformed reference")
    if r != 0 { return 110 + r }
    r = bad(&d, "<a>&amp</a>", 1, 4, "undefined entity or malformed reference")
    if r != 0 { return 115 + r }
    r = bad(&d, "<a b=\"&foo;\"/>", 1, 7, "undefined entity or malformed reference")
    if r != 0 { return 120 + r }
    r = bad(&d, "<a>&#xD800;</a>", 1, 4, "invalid character reference")
    if r != 0 { return 125 + r }
    r = bad(&d, "<a>&#0;</a>", 1, 4, "invalid character reference")
    if r != 0 { return 130 + r }
    r = bad(&d, "<a>&#x110000;</a>", 1, 4, "invalid character reference")
    if r != 0 { return 135 + r }
    r = bad(&d, "<a>&#;</a>", 1, 4, "invalid character reference")
    if r != 0 { return 140 + r }
    r = bad(&d, "<a>&#xFFFF;</a>", 1, 4, "invalid character reference")
    if r != 0 { return 145 + r }
    r = bad(&d, "<a>]]></a>", 1, 4, "']]>' in text")
    if r != 0 { return 150 + r }
    r = bad(&d, "<a><!-- -- --></a>", 1, 9, "'--' inside a comment")
    if r != 0 { return 155 + r }
    r = bad(&d, "<a><!-- x --- --></a>", 1, 11, "'--' inside a comment")
    if r != 0 { return 160 + r }
    r = bad(&d, "<a><!-- x", 1, 10, "the input ends too early")
    if r != 0 { return 165 + r }
    r = bad(&d, "<a><![CDATA[ x", 1, 15, "the input ends too early")
    if r != 0 { return 170 + r }
    r = bad(&d, "<![CDATA[x]]><a/>", 1, 1, "content outside of the root element")
    if r != 0 { return 175 + r }
    r = bad(&d, "<a><?1 ?></a>", 1, 6, "bad processing instruction")
    if r != 0 { return 180 + r }
    r = bad(&d, "<a><?pi x</a>", 1, 14, "the input ends too early")
    if r != 0 { return 185 + r }

    // --- no DTD (X1), UTF-8 only (X2), the declaration only first
    r = bad(&d, "<!DOCTYPE a><a/>", 1, 1, "DOCTYPE is not supported")
    if r != 0 { return 190 + r }
    r = bad(&d, "<?xml version=\"1.0\"?><!DOCTYPE a [<!ENTITY e \"x\">]><a>&e;</a>", 1, 22, "DOCTYPE is not supported")
    if r != 0 { return 195 + r }
    r = bad(&d, "<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?><a/>", 1, 42, "only UTF-8 is supported")
    if r != 0 { return 200 + r }
    r = bad(&d, "<a>\u{fffe}</a>", 1, 4, "invalid character")
    if r != 0 { return 205 + r }
    r = bad(&d, " <?xml version=\"1.0\"?><a/>", 1, 7, "bad or misplaced XML declaration")
    if r != 0 { return 210 + r }
    r = bad(&d, "<a><?xml version=\"1.0\"?></a>", 1, 9, "bad or misplaced XML declaration")
    if r != 0 { return 215 + r }
    r = bad(&d, "<?xml version=\"2.0\"?><a/>", 1, 20, "bad or misplaced XML declaration")
    if r != 0 { return 220 + r }
    r = bad(&d, "<?xml?><a/>", 1, 6, "bad or misplaced XML declaration")
    if r != 0 { return 225 + r }

    // --- characters: controls, stray / overlong / surrogate / too large UTF-8
    r = bad(&d, "<a>\u{1}</a>", 1, 4, "invalid character")
    if r != 0 { return 230 + r }
    r = bad(&d, "<a b=\"\u{b}\"/>", 1, 7, "invalid character")
    if r != 0 { return 235 + r }
    r = bad(&d, "<!-- \u{1} --><a/>", 1, 6, "invalid character")
    if r != 0 { return 240 + r }
    r = bad(&d, "<a>\n\n  </a  b>", 3, 8, "'>' expected")
    if r != 0 { return 245 + r }
    // a UTF-16 byte order mark
    var u16: [u8; 6] = [255 as u8, 254 as u8, 60 as u8, 97 as u8, 47 as u8, 62 as u8]
    let ok: bool = xml.parse(&d, (&u16[0]) as u64, 6) catch false
    if ok || xml.err_code(&d) != xml.E_ENCODING {
        return 250
    }
    // raw octets that are not UTF-8: lone continuation, truncated, surrogate, overlong, > U+10FFFF
    var raw: [[u8; 8]; 5] = [
        [60 as u8, 97 as u8, 62 as u8, 255 as u8, 60 as u8, 47 as u8, 97 as u8, 62 as u8],
        [60 as u8, 97 as u8, 62 as u8, 195 as u8, 60 as u8, 47 as u8, 97 as u8, 62 as u8],
        [60 as u8, 97 as u8, 62 as u8, 192 as u8, 128 as u8, 60 as u8, 47 as u8, 97 as u8],
        [60 as u8, 97 as u8, 62 as u8, 237 as u8, 160 as u8, 128 as u8, 60 as u8, 47 as u8],
        [60 as u8, 97 as u8, 62 as u8, 244 as u8, 144 as u8, 128 as u8, 128 as u8, 60 as u8],
    ]
    var k: usize = 0
    while k < 5 {
        let p: bool = xml.parse(&d, (&raw[k][0]) as u64, 8) catch false
        if p || xml.err_line(&d) != 1 || xml.err_col(&d) != 4 {
            return 251 + k as i32
        }
        k = k + 1
    }

    // --- an error must not leave a half document behind, and the Doc stays usable
    let good: bool = xml.parse_str(&d, "<ok/>") catch false
    if !good || !xml.valid(&d) || !(xml.name(&d, xml.root(&d)) == "ok") {
        return 260
    }
    return 0
}
