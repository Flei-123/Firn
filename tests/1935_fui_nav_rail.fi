// expect_exit: 0
import fui.nav_rail
import std.rt

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn is(p: u64, n: usize, want: str) -> bool {
    if n != want.n { return false }
    var i: usize = 0
    while i < n {
        if *((p + i as u64) as *mut u8) != *((want.p as u64 + i as u64) as *mut u8) { return false }
        i = i + 1
    }
    return *((p + n as u64) as *mut u8) == 0 as u8
}

fn main() -> i32 {
    var r: nav_rail.Rail = nav_rail.nrail_new()
    check("empty", nav_rail.nrail_active(&r) == nav_rail.NR_NONE && nav_rail.nrail_active_id(&r).n == 0 && nav_rail.nrail_visible_count(&r) == 0)
    check("add", nav_rail.nrail_add(&r, "inbox", "Activity", 1 as i64) == 0 && nav_rail.nrail_add(&r, "chat", "Chat", 2 as i64) == 1)
    nav_rail.nrail_add(&r, "mail", "Mail", 3 as i64)
    nav_rail.nrail_add(&r, "cal", "Calendar", 4 as i64)
    nav_rail.nrail_add(&r, "calls", "Calls", 5 as i64)
    nav_rail.nrail_add(&r, "files", "Files", 6 as i64)
    check("dup id", nav_rail.nrail_add(&r, "chat", "x", 0 as i64) == nav_rail.NR_NONE)
    check("first is active", nav_rail.nrail_active(&r) == 0 && nav_rail.nrail_active_id(&r).n == 5)
    check("activate", nav_rail.nrail_activate(&r, "chat") && nav_rail.nrail_active(&r) == 1)
    check("activate unknown", !nav_rail.nrail_activate(&r, "zzz") && nav_rail.nrail_active(&r) == 1)

    check("badge", nav_rail.nrail_set_badge(&r, "chat", 3 as u32) && nav_rail.nrail_set_badge(&r, "mail", 120 as u32) && !nav_rail.nrail_set_badge(&r, "zzz", 1 as u32))
    check("total", nav_rail.nrail_total_badge(&r) == 123 as u32)
    var b: [u8; 8] = [0 as u8; 8]
    let bp: u64 = (&b[0]) as u64
    check("badge text 0", nav_rail.nrail_badge_text(0 as u32, bp, 8) == 0 && is(bp, 0, ""))
    check("badge text 7", is(bp, nav_rail.nrail_badge_text(7 as u32, bp, 8), "7"))
    check("badge text 42", is(bp, nav_rail.nrail_badge_text(42 as u32, bp, 8), "42"))
    check("badge text 99", is(bp, nav_rail.nrail_badge_text(99 as u32, bp, 8), "99"))
    check("badge text 100", is(bp, nav_rail.nrail_badge_text(100 as u32, bp, 8), "99+"))
    check("badge text small buffer", nav_rail.nrail_badge_text(5 as u32, bp, 3) == 0)

    check("grey", nav_rail.nrail_set_state(&r, "mail", nav_rail.NR_GREY) && !nav_rail.nrail_activate(&r, "mail"))
    check("grey badge not counted", nav_rail.nrail_total_badge(&r) == 3 as u32)
    check("grey still visible", nav_rail.nrail_visible_count(&r) == 6)
    check("hidden", nav_rail.nrail_set_state(&r, "cal", nav_rail.NR_HIDDEN) && nav_rail.nrail_visible_count(&r) == 5)
    check("visible at skips hidden", nav_rail.nrail_visible_at(&r, 3) == 4 && nav_rail.nrail_visible_at(&r, 9) == nav_rail.NR_NONE)
    check("bad state", !nav_rail.nrail_set_state(&r, "chat", 9 as u32))

    check("next skips grey and hidden", nav_rail.nrail_next(&r, 1, 1) == 4 && nav_rail.nrail_next(&r, 4, -1) == 1)
    check("next wraps", nav_rail.nrail_next(&r, 5, 1) == 0 && nav_rail.nrail_next(&r, 0, -1) == 5)

    check("active turned grey moves on", nav_rail.nrail_set_state(&r, "chat", nav_rail.NR_GREY) && nav_rail.nrail_active(&r) == 4)
    nav_rail.nrail_set_state(&r, "chat", nav_rail.NR_ON)
    nav_rail.nrail_activate(&r, "chat")

    check("fit all", nav_rail.nrail_fit(&r, 400, 48, 4) == 5)
    check("fit short", nav_rail.nrail_fit(&r, 210, 48, 4) == 3 && nav_rail.nrail_fit(&r, 200, 48, 4) == 2)
    check("fit none", nav_rail.nrail_fit(&r, 20, 48, 4) == 0)
    check("item y", nav_rail.nrail_item_y(2, 10, 48, 4) == 114)
    check("hit first", nav_rail.nrail_hit(&r, 12, 10, 48, 4, 400) == 0)
    check("hit third is index 2", nav_rail.nrail_hit(&r, 120, 10, 48, 4, 400) == 2)
    check("hit skips hidden", nav_rail.nrail_hit(&r, 10 + 3 * 52 + 5, 10, 48, 4, 400) == 4)
    check("hit gap", nav_rail.nrail_hit(&r, 10 + 48 + 2, 10, 48, 4, 400) == nav_rail.NR_NONE)
    check("hit above", nav_rail.nrail_hit(&r, 5, 10, 48, 4, 400) == nav_rail.NR_NONE)
    check("hit in overflow", nav_rail.nrail_hit(&r, 10 + 3 * 52 + 5, 10, 48, 4, 200) == nav_rail.NR_NONE)

    var out: [usize; 5] = [0; 5]
    let n5: usize = nav_rail.nrail_tabs(&r, 6, (&out[0]) as *mut usize)
    check("tabs all fit", n5 == 5 && out[0] == 0 && out[4] == 5)
    let n4: usize = nav_rail.nrail_tabs(&r, 4, (&out[0]) as *mut usize)
    check("tabs keep a slot for more", n4 == 3 && out[2] == 2)

    var cnt: nav_rail.Rail = nav_rail.nrail_new()
    var i: usize = 0
    while i < 14 {
        nav_rail.nrail_add(&cnt, "x", "x", 0 as i64)
        i = i + 1
    }
    check("one id once", nav_rail.nrail_visible_count(&cnt) == 1)

    if failures == 0 {
        rt.write_everything(1, "ok\n".p as u64, 3)
    }
    return failures
}
