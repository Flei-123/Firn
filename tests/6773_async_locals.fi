// expect_exit: 0
import async.loop
import async.fut

async fn step(l: *mut loop.Loop, n: i32) -> i32 {
    let w: bool = fut.sleep_ms(l, 1).await
    return n + 1
}

async fn chain(l: *mut loop.Loop, start: i32, name: str) -> i32 {
    var acc: i32 = start
    let label: str = name + "!"
    acc = step(l, acc).await
    acc = acc + 10
    var second: i32 = 0
    second = step(l, acc).await
    step(l, 0).await
    if label != "ab!" { return 0 - 1 }
    return acc * 1000 + second
}

async fn early(l: *mut loop.Loop, flag: bool) -> i32 {
    if flag { return 7 }
    return step(l, 100).await
}

async fn nothing_to_wait(x: i32) -> i32 {
    return x * 2
}

async fn wrap(l: *mut loop.Loop) -> i32 {
    let a: i32 = early(l, true).await
    let b: i32 = early(l, false).await
    let c: i32 = nothing_to_wait(21).await
    return a + b + c
}

#[allow_escape]
fn main() -> i32 {
    var l: loop.Loop = loop.loop_new()
    if !loop.loop_init(&l) { return 1 }
    let r: i32 = fut.block_on[i32](&l, chain(&l, 5, "ab"))
    if r != 16 * 1000 + 17 { return 2 }
    let w: i32 = fut.block_on[i32](&l, wrap(&l))
    if w != 7 + 101 + 42 { return 3 }
    loop.loop_free(&l)
    return 0
}
