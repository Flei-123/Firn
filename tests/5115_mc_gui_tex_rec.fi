// expect_exit: 0
import std.rt
import mc.mc_raster
import mc.mc_gui_tex
import mc.mc_hud

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn replay(r: *mut mc_raster.Raster, b: *mut rt.Buf) -> usize {
    let n: usize = rt.buf_len(b) / 24
    var k: usize = 0
    while k < n {
        let base: u64 = rt.buf_ptr(b) + (k * 24) as u64
        let x0: i32 = rt.ld32(base, 0) as i32
        let y0: i32 = rt.ld32(base, 1) as i32
        let x1: i32 = rt.ld32(base, 2) as i32
        let y1: i32 = rt.ld32(base, 3) as i32
        let c: u32 = rt.ld32(base, 4)
        var y: i32 = y0
        while y < y1 {
            var x: i32 = x0
            while x < x1 {
                mc_gui_tex.gtex_blend(r, x, y, c)
                x = x + 1
            }
            y = y + 1
        }
        k = k + 1
    }
    return n
}

#[allow_escape]
fn main() -> i32 {
    var t: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    check(mc_gui_tex.gtex_blank(&t, 3, 2), 1)
    mc_gui_tex.gtex_set(&t, 0, 0, 0xFF0000FF as u32)
    mc_gui_tex.gtex_set(&t, 1, 0, 0xFF0000FF as u32)
    mc_gui_tex.gtex_set(&t, 2, 0, 0xFF00FF00 as u32)
    mc_gui_tex.gtex_set(&t, 0, 1, 0x00000000 as u32)
    mc_gui_tex.gtex_set(&t, 1, 1, 0xFFFF0000 as u32)
    mc_gui_tex.gtex_set(&t, 2, 1, 0xFFFFFFFF as u32)
    var a: mc_raster.Raster = mc_raster.raster_new(40, 24)
    var b: mc_raster.Raster = mc_raster.raster_new(40, 24)
    mc_gui_tex.gtex_draw(&a, &t, 3, 2, 18, 8, 0, 0, 3, 2, 0xFFFFFFFF as u32)
    var rec: rt.Buf = rt.buf_new()
    mc_hud.hud_record(&rec)
    mc_gui_tex.gtex_draw(&b, &t, 3, 2, 18, 8, 0, 0, 3, 2, 0xFFFFFFFF as u32)
    mc_hud.hud_record(0 as *mut rt.Buf)
    check(!mc_hud.hud_recording(), 2)
    let n: usize = replay(&b, &rec)
    check(n > 0 && n <= 6, 3)
    var i: usize = 0
    while i < 40 * 24 {
        check(rt.ld32(a.color, i) == rt.ld32(b.color, i), 10)
        i = i + 1
    }
    check(rt.ld32(a.color, 4 * 40 + 4) == 0xFF0000FF as u32, 4)
    rt.buf_free(&rec)
    return 0
}
