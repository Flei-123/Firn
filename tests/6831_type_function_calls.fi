// expect_exit: 0
import std.vec
import std.map
import modules.typecall_geo

struct Counter { n: i32 }

impl Counter {
    fn start() -> Counter { return Counter { n: 3 } }
}

fn main() -> i32 {
    var v: Vec[i32] = Vec[i32].new()
    vec_push[i32](&v, 4)
    vec_push[i32](&v, 5)
    if v.len() != 2 { return 1 }
    var w = Vec[i64].new()
    if w.len() != 0 { return 2 }
    let m: Map[u32, i32] = Map[u32, i32].new()
    if m.len != 0 { return 3 }
    var s = Set[u32].new()
    if set_len[u32](&s) != 0 { return 4 }
    let p = typecall_geo.Point.origin()
    if p.total() != 7 { return 5 }
    if Counter.start().n != 3 { return 6 }
    return 0
}
