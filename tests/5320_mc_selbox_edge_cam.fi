// expect_exit: 0
import std.rt
import std.core
import std.io
import std.math
import mc.mc_camera
import mc.mc_model_pick

fn proj_px(b: *mut mc_model_pick.MpBox, cam: *mut mc_camera.Camera, i: i32, e: f64) -> f64 {
    let fpy: f64 = (((*cam).height as f64) * 0.5) / (*cam).tan_y
    return e * fpy / mc_model_pick.mp_sel_dist(b, cam, i)
}

fn main() -> i32 {
    var b: mc_model_pick.MpBox = mc_model_pick.MpBox { x0: 0.0, y0: 0.0, z0: 0.0, x1: 1.0, y1: 1.0, z1: 1.0 }
    var cam: mc_camera.Camera = mc_camera.camera_new(640, 360)
    mc_camera.camera_set_lens(&cam, 70.0, 0.05, 200.0)
    var cxs: [f64; 4] = [0.5, 0.3, 4.0, 0.5]
    var cys: [f64; 4] = [0.0 - 0.6, 0.5, 3.0, 0.5]
    var czs: [f64; 4] = [0.5, 0.0 - 0.4, 4.0, 0.5]
    var vw: usize = 0
    while vw < 4 {
        mc_camera.camera_set_pos(&cam, cxs[vw], cys[vw], czs[vw])
        mc_camera.camera_look_at(&cam, 0.5, 1.0, 0.5)
        mc_camera.camera_update(&cam)
        let e_ctr: f64 = mc_model_pick.mp_sel_thickness(&b, &cam, 1.0, 0.05)
        var worst: f64 = 0.0
        var i: i32 = 0
        while i < 12 {
            var se: mc_model_pick.MpEdge = mc_model_pick.MpEdge { cx: 0.0, cy: 0.0, cz: 0.0, sx: 0.0, sy: 0.0, sz: 0.0 }
            mc_model_pick.mp_sel_edge_cam(&b, &cam, 1.0, 0.05, i, &se)
            var e: f64 = se.sx
            if se.sy < e { e = se.sy }
            if se.sz < e { e = se.sz }
            if e > 0.05 + 0.0001 || e < 0.004 - 0.0001 { return 10 + (vw as i32) }
            let px: f64 = proj_px(&b, &cam, i, e)
            if e > 0.00401 && px > worst { worst = px }
            i = i + 1
        }
        io.fmt_print(f"view {vw}: centre e {e_ctr} worst cap px {worst}\n")
        if worst > 1.001 { return 20 + (vw as i32) }
        vw = vw + 1
    }
    return 0
}
