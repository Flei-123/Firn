// expect_exit: 41
// tests/4073_if_let_plain.fi -- `if let Some(x) = e` / `while let Some(x) = e` work on ANY struct with the
// fields `has` (bool) and `val` (r719); no generics here, so parser_compare covers this file.
struct Maybe {
    has: bool,
    val: i32,
}

struct Pair {
    a: i32,
    b: i32,
}

struct MaybePair {
    has: bool,
    val: Pair,
}

fn half(n: i32) -> Maybe {
    if n % 2 == 0 {
        return Maybe { has: true, val: n / 2 }
    }
    return Maybe { has: false, val: 0 }
}

fn pair(a: i32, b: i32) -> MaybePair {
    return MaybePair { has: true, val: Pair { a: a, b: b } }
}

fn main() -> i32 {
    var total: i32 = 0
    if let Some(x) = half(20) {
        total = total + x
    } else {
        total = -1000
    }
    if let Some(x) = half(7) {
        total = -1000 + x
    } else if let Some(_) = half(8) {
        total = total + 1
    } else {
        total = -2000
    }
    if let Some(p) = pair(3, 4) {
        total = total + p.a + p.b
    }
    var k: i32 = 64
    var steps: i32 = 0
    while let Some(h) = half(k) {
        k = h
        steps = steps + 1
        if steps == 100 {
            break
        }
    }
    total = total + steps
    var n: i32 = 0
    while let Some(_) = half(n * 2 + 2) {
        n = n + 1
        if n > 3 {
            break
        }
    }
    return total + n + 13
}
