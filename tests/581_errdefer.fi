// expect_exit: 0
// `errdefer` (SPEC 5.1): runs ONLY when the function is left through an
// error. `defer` always runs. Both share one list per block level and run
// in a common REVERSE order -- so if the `errdefer` stands after the
// `defer`, it runs first.
//
// The order is measured as a sequence of digits: every deferred statement
// appends its digit at the end (`*p = *p * 10 + digit`).

error E { Broken }

fn remember(p: *mut i32, digit: i32) {
    *p = *p * 10 + digit
}

fn can_go_wrong(x: i32) -> E!i32 {
    if x < 0 {
        return E::Broken
    }
    return x * 2
}

// `defer` notes 1, `errdefer` notes 2. Expectation:
//   success -> only 1
//   error   -> 21 (errdefer first, because it was declared later)
fn work(x: i32, p: *mut i32) -> E!i32 {
    defer remember(p, 1)
    errdefer remember(p, 2)
    let w: i32 = try can_go_wrong(x)
    return w + 1
}

// The immediate `return E::Variant` is the error path as well.
fn immediately_error(p: *mut i32) -> E!i32 {
    errdefer remember(p, 7)
    return E::Broken
}

// ... an ordinary return value is not.
fn immediately_success(p: *mut i32) -> E!i32 {
    errdefer remember(p, 7)
    return 3
}

// Three levels: the `errdefer` of the inner level runs first.
fn deep(p: *mut i32) -> E!i32 {
    defer remember(p, 1)
    errdefer remember(p, 2)
    if true {
        errdefer remember(p, 3)
        defer remember(p, 4)
        return E::Broken
    }
    return 0
}

fn main() -> i32 {
    // --- success path: only the `defer`
    var a: i32 = 0
    if (work(5, &a) catch 0) != 11 {
        return 1
    }
    if a != 1 {
        return 2
    }

    // --- error path: errdefer (2) before defer (1)
    var b: i32 = 0
    if (work(0 - 1, &b) catch 99) != 99 {
        return 3
    }
    if b != 21 {
        return 4
    }

    // --- `return E::Variant` triggers errdefer
    var c: i32 = 0
    if (immediately_error(&c) catch 0) != 0 {
        return 5
    }
    if c != 7 {
        return 6
    }

    // --- a success value does not
    var d: i32 = 0
    if (immediately_success(&d) catch 0) != 3 {
        return 7
    }
    if d != 0 {
        return 8
    }

    // --- inner level first, backwards within a level:
    // 4 (defer inner), 3 (errdefer inner), 2 (errdefer outer), 1 (defer outer)
    var e: i32 = 0
    if (deep(&e) catch 0) != 0 {
        return 9
    }
    if e != 4321 {
        return 10
    }
    return 0
}
