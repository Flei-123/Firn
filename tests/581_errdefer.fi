// expect_exit: 0
// `errdefer` (SPEC §5.1): laeuft NUR, wenn die Funktion ueber einen Fehler
// verlassen wird. `defer` laeuft immer. Beide teilen sich eine Liste je
// Blockebene und laufen in gemeinsamer UMGEKEHRTER Reihenfolge — steht das
// `errdefer` hinter dem `defer`, laeuft es also zuerst.
//
// Die Reihenfolge wird als Ziffernfolge gemessen: jede aufgeschobene Anweisung
// haengt ihre Ziffer hinten an (`*p = *p * 10 + ziffer`).

error E { Broken }

fn remember(p: *mut i32, digit: i32) {
    *p = *p * 10 + digit
}

fn can_gowrong(x: i32) -> E!i32 {
    if x < 0 {
        return E::Broken
    }
    return x * 2
}

// `defer` merkt 1, `errdefer` merkt 2. Erwartung:
//   Erfolg -> nur 1
//   Fehler -> 21 (errdefer zuerst, weil spaeter vereinbart)
fn work(x: i32, p: *mut i32) -> E!i32 {
    defer remember(p, 1)
    errdefer remember(p, 2)
    let w: i32 = try can_gowrong(x)
    return w + 1
}

// Auch der unmittelbare `return E::Variante` ist der Fehlerpfad.
fn immediately_error(p: *mut i32) -> E!i32 {
    errdefer remember(p, 7)
    return E::Broken
}

// ... ein gewoehnlicher Rueckgabewert ist es nicht.
fn immediately_success(p: *mut i32) -> E!i32 {
    errdefer remember(p, 7)
    return 3
}

// Drei Ebenen: das `errdefer` der inneren Ebene laeuft zuerst.
fn deep(p: *mut i32) -> E!i32 {
    defer remember(p, 1)
    errdefer remember(p, 2)
    if true {
        errdefer remember(p, 3)
        defer remember(p, 4)
        return E::Broken
    }
    return 0
}

fn main() -> i32 {
    // --- Erfolgspfad: nur der `defer`
    var a: i32 = 0
    if (work(5, &a) catch 0) != 11 {
        return 1
    }
    if a != 1 {
        return 2
    }

    // --- Fehlerpfad: errdefer (2) vor defer (1)
    var b: i32 = 0
    if (work(0 - 1, &b) catch 99) != 99 {
        return 3
    }
    if b != 21 {
        return 4
    }

    // --- `return E::Variante` loest errdefer aus
    var c: i32 = 0
    if (immediately_error(&c) catch 0) != 0 {
        return 5
    }
    if c != 7 {
        return 6
    }

    // --- ein Erfolgswert nicht
    var d: i32 = 0
    if (immediately_success(&d) catch 0) != 3 {
        return 7
    }
    if d != 0 {
        return 8
    }

    // --- innere Ebene zuerst, innerhalb einer Ebene rueckwaerts:
    // 4 (defer innen), 3 (errdefer innen), 2 (errdefer aussen), 1 (defer aussen)
    var e: i32 = 0
    if (deep(&e) catch 0) != 0 {
        return 9
    }
    if e != 4321 {
        return 10
    }
    return 0
}
