// expect_exit: 0
// r169: the buffer of a `Vec[T]` is a collector root when `T` holds GC
// pointers (`str` from `+`, a struct with such a field). Before, a collection
// freed the octets of the strings and the Vec read garbage.
import std.vec

struct Named {
    id: u32,
    name: str,
}

fn make_name(i: u32) -> str {
    var s: str = "item-"
    s = s + "abcdefghij"
    if i % 2 == 0 {
        s = s + "-even"
    } else {
        s = s + "-odd!"
    }
    return s
}

fn churn() {
    var k: i32 = 0
    var last: str = ""
    while k < 3000 {
        last = "garbage" + "-garbage-garbage"
        k = k + 1
    }
    if last.n == 0 { return }
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    // 1. has_gc is a compile-time fact
    if has_gc[u32]() { return 2 }
    if !has_gc[str]() { return 3 }
    if !has_gc[Named]() { return 4 }
    // 2. Vec[str]: grows several times, strings live ONLY in the buffer
    var v: Vec[str] = vec_new[str]()
    var i: u32 = 0
    while i < 300 {
        if !vec_push[str](&v, make_name(i)) { return 5 }
        i = i + 1
    }
    churn()
    gc_collect()
    churn()
    gc_collect()
    i = 0
    while i < 300 {
        let p: *mut str = vec_elem_ptr[str](&v, i as usize)
        if (*p) != make_name(i) { return 6 }
        i = i + 1
    }
    vec_free[str](&v)
    // 3. struct with a str field inside a Vec
    var w: Vec[Named] = vec_new[Named]()
    i = 0
    while i < 100 {
        vec_push[Named](&w, Named { id: i, name: make_name(i) })
        i = i + 1
    }
    churn()
    gc_collect()
    i = 0
    while i < 100 {
        let p: *mut Named = vec_elem_ptr[Named](&w, i as usize)
        if (*p).id != i { return 7 }
        if (*p).name != make_name(i) { return 8 }
        i = i + 1
    }
    vec_free[Named](&w)
    // 4. after free the roots are gone again (no root leak)
    gc_collect()
    let roots_after: u64 = gc_roots()
    var u: Vec[u32] = vec_new[u32]()
    vec_push[u32](&u, 7)
    if gc_roots() != roots_after { return 9 }
    vec_free[u32](&u)
    return 0
}
