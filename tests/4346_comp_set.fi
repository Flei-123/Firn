// expect_exit: 0
// tests/4346_comp_set.fi -- r748: set comprehension / set literal for `Set[K]` (parser desugar,
// the target needs a declared type: `let s: Set[T] = {..}` or `return {..}`).
import std.map
import std.vec

fn residues(xs: *mut Vec[i64]) -> Set[i64] {
    return { x % 4 for x in *xs }
}

fn main() -> i32 {
    var v: Vec[i64] = vec_new[i64]()
    var i: i64 = 0
    while i < 10 {
        vec_push[i64](&v, i)
        i = i + 1
    }
    // duplicates collapse
    let s: Set[i64] = { x % 3 for x in v if x > 0 }
    if set_len[i64](&s) != 3 || !set_has[i64](&s, 0) || !set_has[i64](&s, 1) || !set_has[i64](&s, 2) {
        return 1
    }
    let r: Set[i64] = residues(&v)
    if set_len[i64](&r) != 4 || set_has[i64](&r, 4) {
        return 2
    }
    // literal and empty set
    let lit: Set[i64] = { 5, 7, 5, 9 }
    if set_len[i64](&lit) != 3 || !set_has[i64](&lit, 7) || set_has[i64](&lit, 6) {
        return 3
    }
    let none: Set[i64] = {}
    if set_len[i64](&none) != 0 {
        return 4
    }
    // nested clauses
    let n: i64 = 3
    let pairs: Set[i64] = { a * 10 + b for a in 0..n for b in 0..n if a != b }
    if set_len[i64](&pairs) != 6 || !set_has[i64](&pairs, 21) || set_has[i64](&pairs, 11) {
        return 5
    }
    return 0
}
