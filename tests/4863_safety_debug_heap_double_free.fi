// expect_exit: 101
// wasm_skip: page protection does not exist in the wasm linear memory
// not_mode: opt
// only_target: x86_64
// N5 in debug heap mode: a second free of a block that was handed back to the kernel (more than 16 pages) ends with "firn: double free (heap_free)", exit 101.
import std.rt

fn main() -> i32 {
    rt.heap_debug_enable()
    let p: u64 = rt.heap_alloc(262144)
    rt.heap_free(p, 262144)
    rt.heap_free(p, 262144)
    return 0
}
