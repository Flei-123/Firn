// expect_exit: 0
// tests/4324_vec_slice_grow_gc.fi -- r744: slice assignment that grows a Vec of GC pointers moves the GC root.
import std.io
import std.rt
import std.vec
import std.text

#[no_inline]
fn churn() {
    var i: i32 = 0
    while i < 3000 {
        let t: str = text.dup("garbage-garbage-garbage")
        if t.n == 0 { return }
        i = i + 1
    }
    gc_collect()
}

#[no_inline]
fn mk(n: i32) -> Vec[str] {
    var v: Vec[str] = vec_new[str]()
    var i: i32 = 0
    while i < n {
        vec_push[str](&v, text.dup("item-item-item"))
        i = i + 1
    }
    return v
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[str] = mk(3)
    var w: Vec[str] = mk(40)
    // grows far beyond the capacity: new buffer, old root removed, new root added
    v[1:2] = w
    churn()
    if vec_len[str](&v) != 42 { return 2 }
    var i: usize = 0
    while i < 42 {
        if v[i] != "item-item-item" { return 3 }
        i = i + 1
    }
    // a view that grows becomes an owning Vec (nothing old to unregister)
    var base: Vec[str] = mk(4)
    var view: Vec[str] = base[1:3]
    view[0:1] = w
    churn()
    if vec_len[str](&view) != 41 || view[40] != "item-item-item" || view[0] != "item-item-item" { return 4 }
    // the source aliases the target: v[0:1] = v
    var a: Vec[str] = mk(5)
    a[0:1] = a
    churn()
    if vec_len[str](&a) != 9 || a[8] != "item-item-item" { return 5 }
    // an extended assignment keeps the buffer
    var b: Vec[str] = mk(6)
    var c: Vec[str] = mk(3)
    b[::2] = c
    churn()
    if b[0] != "item-item-item" || b[4] != "item-item-item" { return 6 }
    vec_free[str](&v)
    vec_free[str](&w)
    vec_free[str](&base)
    vec_free[str](&a)
    vec_free[str](&b)
    vec_free[str](&c)
    return 0
}
