    expect_hex(&b, "03000102030405060708090a0b0c0d0e0f", "bt_smp.smp_pairing_confirm(&b, vp)")
    bt_smp.smp_pairing_random(&b, vp)
    expect_hex(&b, "04000102030405060708090a0b0c0d0e0f", "bt_smp.smp_pairing_random(&b, vp)")
    bt_smp.smp_pairing_failed(&b, 4)
    expect_hex(&b, "0504", "bt_smp.smp_pairing_failed(&b, 4)")
    bt_smp.smp_encryption_info(&b, vp)
    expect_hex(&b, "06000102030405060708090a0b0c0d0e0f", "bt_smp.smp_encryption_info(&b, vp)")
    bt_smp.smp_central_ident(&b, 0x1234, vp)
    expect_hex(&b, "0734120001020304050607", "bt_smp.smp_central_ident(&b, 0x1234, vp)")
    bt_smp.smp_identity_info(&b, vp)
