    bt_smp.smp_public_key(&b, xp, yp)
    expect_hex(&b, "0c000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f", "bt_smp.smp_public_key(&b, xp, yp)")
    bt_smp.smp_dhkey_check(&b, vp)
    expect_hex(&b, "0d000102030405060708090a0b0c0d0e0f", "bt_smp.smp_dhkey_check(&b, vp)")
