// expect_exit: 0
import std.rt
import mc.mc_raster
import mc.mc_offhand_ui

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    check(mc_offhand_ui.OFFHAND_SLOT == 45, 1)
    var r: mc_raster.Raster = mc_raster.raster_new(400, 200)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    let x: i32 = mc_offhand_ui.offhand_cell_x(&r, 1)
    let y: i32 = mc_offhand_ui.offhand_cell_y(&r, 1)
    check(x == (400 - 181) / 2 - 24 && y == 200 - 23, 2)
    check(x + 22 + 2 <= (400 - 181) / 2, 3)
    mc_offhand_ui.offhand_ui_draw(&r, 1)
    check(mc_raster.raster_pixel(&r, x, y) == mc_raster.raster_pixel(&r, x + 10, y) && mc_raster.raster_pixel(&r, x + 10, y) != 0xFF000000 as u32, 4)
    check(mc_raster.raster_pixel(&r, x - 2, y + 10) == 0xFF000000 as u32 && mc_raster.raster_pixel(&r, x + 22, y + 10) == 0xFF000000 as u32, 6)
    mc_raster.raster_clear(&r, 0xFFFFFFFF as u32)
    mc_offhand_ui.offhand_ui_draw(&r, 2)
    check(mc_raster.raster_pixel(&r, mc_offhand_ui.offhand_cell_x(&r, 2) + 20, mc_offhand_ui.offhand_cell_y(&r, 2) + 20) != 0xFFFFFFFF as u32, 7)
    return 0
}
