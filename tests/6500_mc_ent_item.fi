// expect_exit: 0
import std.rt
import mc.server.ent.ent_table
import mc.server.ent.ent_move
import mc.server.ent.ent_item

static mut g_fail: i32 = 0

fn check(ok: bool, msg: str) {
    if !ok {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_bytes(&o, msg.p as u64, msg.n)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn floor_solid(ctx: u64, x: i32, y: i32, z: i32) -> bool {
    if y < 0 { return true }
    if x == 5 && y == 1 { return true }
    return false
}

fn main() -> i32 {
    var w: ent_move.MoveWorld = ent_move.MoveWorld { ctx: 0, solid: floor_solid }
    var e: ent_table.Entity = ent_table.Entity { used: true, eid: 3, kind: 2, type_id: 54, owner: 0 - 1, uuid_hi: 0, uuid_lo: 0, x: 0.5, y: 0.4, z: 0.5, vx: 0.0, vy: 0.2, vz: 0.0, yaw: 0.0f, pitch: 0.0f, on_ground: false, age: 0, pickup_delay: 10, item: 15, count: 1, track: 0 as u32, sent_x: 0.0, sent_y: 0.0, sent_z: 0.0, sent_yaw: 0.0f, sent_pitch: 0.0f, sent_ground: false, dead: false }
    var i: i32 = 0
    var apex: f64 = 0.0
    var landed_at: i32 = 0 - 1
    while i < 60 {
        ent_item.item_tick(&e, &w)
        if e.y > apex { apex = e.y }
        if e.on_ground && landed_at < 0 { landed_at = i }
        i = i + 1
    }
    check(apex > 0.7 && apex < 0.9, "apex of the throw")
    check(e.on_ground, "rests on the ground")
    check(e.y == 0.0, "rests exactly on the floor top")
    check(landed_at > 8 && landed_at < 30, "landing tick plausible")
    check(e.pickup_delay == 0, "pickup delay elapsed")
    check(e.age == 60, "age counts ticks")
    var wall: ent_table.Entity = e
    wall.x = 4.8
    wall.y = 1.0
    wall.vx = 0.3
    wall.on_ground = false
    wall.vy = 0.0
    var k: i32 = 0
    while k < 5 {
        ent_item.item_tick(&wall, &w)
        k = k + 1
    }
    check(wall.x < 5.0 - 0.125 + 0.0001, "block wall stops the item")
    var old: ent_table.Entity = e
    old.age = 5999
    ent_item.item_tick(&old, &w)
    check(old.dead, "despawn at 6000 ticks")
    if g_fail == 0 { rt.write_everything(1, "ok\n".p as u64, 3) }
    return g_fail
}
