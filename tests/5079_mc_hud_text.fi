// expect_exit: 0
import std.rt
import mc.mc_raster
import mc.mc_gui_font
import mc.mc_gui_tex
import mc.mc_hud_vfont
import mc.mc_hud_text

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn fill(f: *mut mc_gui_font.GuiFont, code: i32, w: i32) {
    let ox: i32 = (code % 16) * 8
    let oy: i32 = (code / 16) * 8
    var y: i32 = 0
    while y < 7 {
        var x: i32 = 0
        while x < w {
            mc_gui_tex.gtex_set(&(*f).atlas, ox + x, oy + y, 0xFFFFFFFF as u32)
            x = x + 1
        }
        y = y + 1
    }
}

fn main() -> i32 {
    var r: mc_raster.Raster = mc_raster.raster_new(64, 32)
    check(mc_hud_text.htext_width("A".p as u64, 1, 1) == 5, 1)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_hud_text.htext(&r, 2, 2, 1, 0xFFFFFFFF as u32, 0 as u32, "I")
    check(mc_raster.raster_pixel(&r, 4, 2) == 0xFFFFFFFF as u32, 2)

    var f: mc_gui_font.GuiFont = mc_gui_font.gfont_empty()
    check(mc_gui_tex.gtex_blank(&f.atlas, 128, 128), 3)
    f.adv = rt.heap_alloc(256 * 4)
    var c: usize = 0
    while c < 256 {
        rt.st32(f.adv, c, 0 as u32)
        c = c + 1
    }
    rt.st32(f.adv, 65, 4 as u32)
    rt.st32(f.adv, 132, 5 as u32)
    rt.st32(f.adv, 32, 4 as u32)
    fill(&f, 65, 3)
    fill(&f, 132, 4)
    check(mc_hud_vfont.vfont_load(&f), 4)

    let s: str = "Aä"
    check(s.n == 3, 5)
    check(mc_hud_text.htext_width(s.p as u64, s.n, 1) == 9, 6)
    check(mc_hud_text.htext_width(s.p as u64, s.n, 2) == 18, 7)

    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_hud_text.htext(&r, 10, 10, 1, 0xFFFFFFFF as u32, 0xFF404040 as u32, s)
    check(mc_raster.raster_pixel(&r, 10, 10) == 0xFFFFFFFF as u32, 8)
    check(mc_raster.raster_pixel(&r, 12, 16) == 0xFFFFFFFF as u32, 9)
    check(mc_raster.raster_pixel(&r, 13, 12) == 0xFF404040 as u32, 10)
    check(mc_raster.raster_pixel(&r, 14, 10) == 0xFFFFFFFF as u32, 11)
    check(mc_raster.raster_pixel(&r, 17, 12) == 0xFFFFFFFF as u32, 12)
    check(mc_raster.raster_pixel(&r, 19, 10) == 0xFF000000 as u32, 13)

    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_hud_text.htext(&r, 4, 4, 2, 0xFFFFFFFF as u32, 0 as u32, "A")
    check(mc_raster.raster_pixel(&r, 9, 17) == 0xFFFFFFFF as u32 && mc_raster.raster_pixel(&r, 10, 17) == 0xFF000000 as u32, 14)

    mc_hud_vfont.vfont_unload()
    mc_gui_font.gfont_free(&f)
    mc_raster.raster_free(&r)
    return 0
}
