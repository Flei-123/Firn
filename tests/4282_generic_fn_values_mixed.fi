// expect_exit: 0
// tests/4282_generic_fn_values_mixed.fi -- fn types as template arguments, generic struct with fn field, gc closure in a generic fn (r716/r718).
struct Holder[T] { f: fn(T) -> T, v: T }

fn id[T](x: T) -> T { return x }
fn inc(x: i32) -> i32 { return x + 1 }
fn pass[T](x: T) -> T { return x }
fn call_h[T](h: Holder[T]) -> T { return h.f(h.v) }
fn mk[T](v: T) -> Holder[T] { return Holder[T] { f: id[T], v: v } }
fn adder[T](n: T) -> AllocError!fn(T) -> T {
    return gc fn(x: T) -> T { return x + n }
}

fn main() -> i32 {
    let fp = pass[fn(i32) -> i32](inc)
    if fp(1) != 2 { return 1 }
    let h = Holder[i32] { f: inc, v: 4 }
    if call_h[i32](h) != 5 { return 2 }
    let h2 = mk[i32](7)
    if call_h[i32](h2) != 7 { return 3 }
    let a = adder[i32](10) catch inc
    if a(5) != 15 { return 4 }
    let h3 = Holder[fn(i32) -> i32] { f: id[fn(i32) -> i32], v: inc }
    if h3.f(h3.v)(1) != 2 { return 5 }
    return 0
}
