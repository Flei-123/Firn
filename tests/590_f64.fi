// expect_exit: 0
// Gleitkomma `f64` (SPEC §8.6, §14.1.f64). Ohne diesen Typ gibt es keine
// JS-Engine (JS-Zahlen SIND binary64), kein Layout und keinen Rasterizer.
//
// Stufe 0 kennt nur `f64`, kein `f32`. Gleitkommaliterale sind deshalb NICHT
// typlos: `1.5` ist immer ein `f64`.

fn quadrat(x: f64) -> f64 {
    return x * x
}

fn summe3(a: f64, b: f64, c: f64) -> f64 {
    return a + b + c
}

fn main() -> i32 {
    // --- Grundrechenarten
    let a: f64 = 1.5
    let b: f64 = 2.25
    if a + b != 3.75 {
        return 1
    }
    if b - a != 0.75 {
        return 2
    }
    if a * b != 3.375 {
        return 3
    }
    if b / a != 1.5 {
        return 4
    }

    // --- Vergleiche (alle sechs)
    if !(a < b) {
        return 5
    }
    if !(a <= b) {
        return 6
    }
    if !(b > a) {
        return 7
    }
    if !(b >= a) {
        return 8
    }
    if !(a != b) {
        return 9
    }
    if !(a == 1.5) {
        return 10
    }

    // --- Vorzeichenwechsel: nur Bit 63 kippt
    let n: f64 = 0.0 - a
    if n != 0.0 - 1.5 {
        return 11
    }
    if 0.0 - n != a {
        return 12
    }

    // --- Funktionsgrenzen
    if quadrat(3.0) != 9.0 {
        return 13
    }
    if summe3(1.0, 2.5, 0.25) != 3.75 {
        return 14
    }

    // --- Umwandlungen
    let i: i64 = 7
    if i as f64 != 7.0 {
        return 15
    }
    if (3.99 as i64) != 3 {
        return 16
    }
    // abschneidend Richtung null, nicht abrundend
    if (0.0 - 3.99) as i64 != 0 - 3 {
        return 17
    }
    if (2.5 as i32) != 2 {
        return 18
    }

    // --- Schreibweisen
    if 1e3 != 1000.0 {
        return 19
    }
    if 1.5e-1 != 0.15 {
        return 20
    }
    if 1_000.5 != 1000.5 {
        return 21
    }

    // --- IEEE-754: NaN ist mit NICHTS gleich, auch nicht mit sich selbst
    let null: f64 = 0.0
    let nan: f64 = null / null
    if nan == nan {
        return 22
    }
    if !(nan != nan) {
        return 23
    }
    if nan < 1.0 {
        return 24
    }
    if nan > 1.0 {
        return 25
    }
    if nan >= nan {
        return 26
    }

    // --- Unendlich
    let inf: f64 = 1.0 / null
    if !(inf > 1e308) {
        return 27
    }
    if inf == 0.0 - inf {
        return 28
    }

    // --- negative Null: `-0.0 == 0.0` ist wahr (IEEE-754)
    let minus_null: f64 = 0.0 - 0.0
    if !(minus_null == 0.0) {
        return 29
    }
    return 0
}
