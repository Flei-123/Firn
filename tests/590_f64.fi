// expect_exit: 0
// Floating point `f64` (SPEC 8.6, 14.1.f64). Without this type there is no
// JS engine (JS numbers ARE binary64), no layout and no rasteriser.
//
// Stage 0 only has `f64`, no `f32`. Floating point literals are therefore
// NOT typeless: `1.5` is always an `f64`.

fn square(x: f64) -> f64 {
    return x * x
}

fn sum3(a: f64, b: f64, c: f64) -> f64 {
    return a + b + c
}

fn main() -> i32 {
    // --- basic arithmetic
    let a: f64 = 1.5
    let b: f64 = 2.25
    if a + b != 3.75 {
        return 1
    }
    if b - a != 0.75 {
        return 2
    }
    if a * b != 3.375 {
        return 3
    }
    if b / a != 1.5 {
        return 4
    }

    // --- comparisons (all six)
    if !(a < b) {
        return 5
    }
    if !(a <= b) {
        return 6
    }
    if !(b > a) {
        return 7
    }
    if !(b >= a) {
        return 8
    }
    if !(a != b) {
        return 9
    }
    if !(a == 1.5) {
        return 10
    }

    // --- change of sign: only bit 63 flips
    let n: f64 = 0.0 - a
    if n != 0.0 - 1.5 {
        return 11
    }
    if 0.0 - n != a {
        return 12
    }

    // --- function boundaries
    if square(3.0) != 9.0 {
        return 13
    }
    if sum3(1.0, 2.5, 0.25) != 3.75 {
        return 14
    }

    // --- conversions
    let i: i64 = 7
    if i as f64 != 7.0 {
        return 15
    }
    if (3.99 as i64) != 3 {
        return 16
    }
    // cutting towards zero, not rounding down
    if (0.0 - 3.99) as i64 != 0 - 3 {
        return 17
    }
    if (2.5 as i32) != 2 {
        return 18
    }

    // --- notations
    if 1e3 != 1000.0 {
        return 19
    }
    if 1.5e-1 != 0.15 {
        return 20
    }
    if 1_000.5 != 1000.5 {
        return 21
    }

    // --- IEEE-754: NaN equals NOTHING, not even itself
    let null: f64 = 0.0
    let nan: f64 = null / null
    if nan == nan {
        return 22
    }
    if !(nan != nan) {
        return 23
    }
    if nan < 1.0 {
        return 24
    }
    if nan > 1.0 {
        return 25
    }
    if nan >= nan {
        return 26
    }

    // --- infinity
    let inf: f64 = 1.0 / null
    if !(inf > 1e308) {
        return 27
    }
    if inf == 0.0 - inf {
        return 28
    }

    // --- negative zero: `-0.0 == 0.0` is true (IEEE-754)
    let minus_null: f64 = 0.0 - 0.0
    if !(minus_null == 0.0) {
        return 29
    }
    return 0
}
