// expect_exit: 0
import std.rt
import std.env
import mc.mc_item_src
import mc.mc_raster
import mc.mc_cont_ui
import mc.mc_cont_spr
import mc.mc_spr_set

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn painted(r: *mut mc_raster.Raster, x0: i32, y0: i32, w: i32, h: i32) -> i32 {
    var n: i32 = 0
    var y: i32 = y0
    while y < y0 + h {
        var x: i32 = x0
        while x < x0 + w {
            if rt.ld32((*r).color, (y as usize) * ((*r).w as usize) + (x as usize)) != 0xFF000000 as u32 { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn dump(r: *mut mc_raster.Raster, name: str) {
    let dir: str = env.get("SPR_DUMP_DIR")
    if dir.length() == 0 { return }
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, "P6\n".p as u64, 3)
    rt.buf_push_dec_u64(&b, (*r).w as u64)
    rt.buf_push(&b, 32)
    rt.buf_push_dec_u64(&b, (*r).h as u64)
    rt.buf_push_bytes(&b, "\n255\n".p as u64, 5)
    var i: usize = 0
    let n: usize = ((*r).w as usize) * ((*r).h as usize)
    while i < n {
        let c: u32 = rt.ld32((*r).color, i)
        rt.buf_push(&b, (c & 255) as u8)
        rt.buf_push(&b, ((c >> 8) & 255) as u8)
        rt.buf_push(&b, ((c >> 16) & 255) as u8)
        i = i + 1
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir.p as u64, dir.length())
    rt.buf_push(&path, 47)
    rt.buf_push_bytes(&path, name.p as u64, name.length())
    rt.buf_push(&path, 0)
    rt.write_file(rt.buf_ptr(&path) as u64, rt.buf_ptr(&b) as u64, rt.buf_len(&b))
    rt.buf_free(&path)
    rt.buf_free(&b)
}

fn main() -> i32 {
    if !env.has("MC_VANILLA_JAR") { return 0 }
    var p: i32 = 763
    if env.has("SPR_NEW") { p = 769 }
    let sprites: bool = env.has("SPR_NEW")
    var src: mc_item_src.ItemSrc = mc_item_src.isrc_new()
    check(mc_item_src.isrc_open(&src, p), 1)
    var u: mc_cont_ui.ContUi = mc_cont_ui.cui_new()
    check(mc_cont_ui.cui_open(&u, &src), 2)
    check(mc_spr_set.sset_has(&u.spr, mc_cont_spr.CS_ENCH_SLOT) == sprites, 3)
    check(mc_spr_set.sset_has(&u.spr, mc_cont_spr.CS_ANVIL_FIELD) == sprites, 4)
    check(mc_spr_set.sset_has(&u.spr, mc_cont_spr.CS_HORSE_CHEST) == sprites, 5)
    check(mc_spr_set.sset_has(&u.spr, mc_cont_spr.CS_BUBBLES) == sprites, 6)
    var v: mc_cont_ui.ContView = mc_cont_ui.cview_new()
    var r: mc_raster.Raster = mc_raster.raster_new(176 * 2, 166 * 2)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    v.props[0] = 30
    v.props[1] = 20
    v.props[2] = 10
    v.lapis = 3
    v.xp = 50
    mc_cont_ui.cui_draw_extras(&r, &u, mc_cont_ui.KIND_ENCHANT, 2, 0, 0, 2, &v)
    check(painted(&r, 60 * 2, 14 * 2, 108 * 2, 57 * 2) > 9000, 7)
    check(painted(&r, 61 * 2, 15 * 2, 16 * 2, 16 * 2) > 100, 8)
    dump(&r, "enchant.ppm")
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    v.props[0] = 0
    v.props[1] = 0
    v.props[2] = 0
    mc_cont_ui.cui_draw_extras(&r, &u, mc_cont_ui.KIND_ENCHANT, 2, 0, 0, 2, &v)
    check(painted(&r, 60 * 2, 14 * 2, 108 * 2, 57 * 2) > 9000, 9)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    v.props[0] = 200
    v.props[1] = 20
    mc_cont_ui.cui_draw_extras(&r, &u, mc_cont_ui.KIND_BREWING, 5, 0, 0, 2, &v)
    check(painted(&r, 60 * 2, 44 * 2, 18 * 2, 4 * 2) > 50, 10)
    check(painted(&r, 97 * 2, 16 * 2, 9 * 2, 28 * 2) > 100, 11)
    check(painted(&r, 63 * 2, 14 * 2, 12 * 2, 29 * 2) > 20, 12)
    dump(&r, "brewing.ppm")
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    v.present[0] = true
    mc_cont_ui.cui_draw_extras(&r, &u, mc_cont_ui.KIND_ANVIL, 3, 0, 0, 2, &v)
    check(painted(&r, 59 * 2, 20 * 2, 110 * 2, 16 * 2) > 3000, 13)
    dump(&r, "anvil.ppm")
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_cont_ui.cui_draw(&r, &u, mc_cont_ui.KIND_HORSE, 17, 0, 0, 2, 0 as u64, 0)
    check(painted(&r, 79 * 2, 17 * 2, 90 * 2, 54 * 2) > 9000, 14)
    dump(&r, "horse.ppm")
    return 0
}
