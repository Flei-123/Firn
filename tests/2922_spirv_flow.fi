// expect_exit: 0
// tests/2922_spirv_flow.fi -- gpu.spirv: control flow of flow.frag (loops, break/continue, switch, ?:, function calls with
// arguments and return values, local array with a dynamic index, local struct through OpAccessChain) against Firn references;
// plus the step limit, a damaged module and a wrong entry id.
import std.rt
import std.math
import gpu.spirv

const SH: str = __include_str("../lib/gpu/spv/test/flow.frag.spv")

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn tri(k: i32) -> i32 {
    var s: i32 = 0
    var i: i32 = 1
    while i <= k {
        if i % 7 != 0 {
            s = s + i
            if s > 100000 {
                break
            }
        }
        i = i + 1
    }
    return s
}

fn steps(v0: i32) -> i32 {
    var v: i32 = v0
    var c: i32 = 0
    while v != 1 && c < 1000 {
        if v % 2 == 1 {
            v = 3 * v + 1
        } else {
            v = v / 2
        }
        c = c + 1
    }
    return c
}

fn poly(t: f32, u: f32) -> f32 {
    var s: f32 = -1.0
    if t > u {
        s = 1.0
    }
    return t * t - 2.0 * u + s
}

fn sw(n: i32) -> i32 {
    let r: i32 = n % 4
    if r == 0 {
        return 10
    }
    if r == 1 {
        return 20
    }
    if r == 3 {
        return 40
    }
    return 99
}

fn arr(n: i32) -> i32 {
    let i: i32 = n % 5
    return i * i + n + 16 + n
}

fn st(n: i32, x: f32) -> f32 {
    let cy: f32 = 2.0 + x
    return x + ((n * 2) as f32) + x * cy
}

fn main() -> i32 {
    var m: spirv.Spv = spirv.spv_zero()
    check(spirv.spv_new(SH.p as u64, SH.n, &m), 1)
    let ent: u32 = spirv.spv_find_entry(&m, 4)
    let n: usize = spirv.spv_find_location(&m, 1, 0)
    let x: usize = spirv.spv_find_location(&m, 1, 1)
    let o_sum: usize = spirv.spv_find_location(&m, 3, 0)
    let o_col: usize = spirv.spv_find_location(&m, 3, 1)
    let o_fl: usize = spirv.spv_find_location(&m, 3, 2)
    let o_arr: usize = spirv.spv_find_location(&m, 3, 3)
    let o_sw: usize = spirv.spv_find_location(&m, 3, 4)
    let o_st: usize = spirv.spv_find_location(&m, 3, 5)
    check(ent != 0 && n != spirv.SPV_NONE && o_st != spirv.SPV_NONE, 2)

    var round: i32 = 0
    while round < 6 {
        var nv: i32 = 27
        var xv: f32 = 2.0
        if round == 1 {
            nv = 7
            xv = 0.25
        }
        if round == 2 {
            nv = 1
            xv = -3.5
        }
        if round == 3 {
            nv = 96
            xv = 0.0
        }
        if round == 4 {
            nv = 50
            xv = 10.0
        }
        if round == 5 {
            nv = 6
            xv = 1.5
        }
        spirv.spv_mem_set(&m, n, 0, nv as% u32)
        spirv.spv_mem_set_f32(&m, x, 0, xv)
        check(spirv.spv_run(&m, ent, 100000), 3 + round)
        check(spirv.spv_mem_get(&m, o_sum, 0) as% i32 == tri(nv), 10 + round)
        check(spirv.spv_mem_get(&m, o_col, 0) as% i32 == steps(nv), 20 + round)
        check(spirv.spv_mem_get_f32(&m, o_fl, 0) == poly(xv, 1.5) + poly(2.0 * xv, xv), 30 + round)
        check(spirv.spv_mem_get(&m, o_arr, 0) as% i32 == arr(nv), 40 + round)
        check(spirv.spv_mem_get(&m, o_sw, 0) as% i32 == sw(nv), 50 + round)
        check(spirv.spv_mem_get_f32(&m, o_st, 0) == st(nv, xv), 60 + round)
        round = round + 1
    }
    // the literal numbers from the shader review: n = 27 -> tri 336, collatz 111, switch 40
    spirv.spv_mem_set(&m, n, 0, 27)
    spirv.spv_mem_set_f32(&m, x, 0, 2.0)
    check(spirv.spv_run(&m, ent, 100000), 70)
    check(spirv.spv_mem_get(&m, o_sum, 0) == 336 && spirv.spv_mem_get(&m, o_col, 0) == 111 && spirv.spv_mem_get(&m, o_sw, 0) == 40, 71)
    check(spirv.spv_mem_get_f32(&m, o_fl, 0) == 15.0 && spirv.spv_mem_get_f32(&m, o_st, 0) == 64.0, 72)

    // step limit: the loop needs more than 50 instructions -> E_STEPS, not a hang
    check(!spirv.spv_run(&m, ent, 50), 80)
    check(m.err == spirv.E_STEPS, 81)
    // not a function id
    check(!spirv.spv_run(&m, 1, 100), 82)
    check(m.err == spirv.E_ENTRY, 83)
    spirv.spv_free(&m)

    // damaged modules are rejected, not executed
    var bad: spirv.Spv = spirv.spv_zero()
    check(!spirv.spv_new(SH.p as u64, 16, &bad), 90)
    check(bad.err == spirv.E_SHORT, 91)
    let cp: u64 = rt.heap_alloc(SH.n)
    rt.mem_copy(cp, SH.p as u64, SH.n)
    rt.st32(cp, 5, 0xffff0011)
    check(!spirv.spv_new(cp, SH.n, &bad), 92)
    check(bad.err == spirv.E_BROKEN, 93)
    // an id beyond the bound in a type instruction
    rt.mem_copy(cp, SH.p as u64, SH.n)
    rt.st32(cp, 3, 4)
    check(!spirv.spv_new(cp, SH.n, &bad), 96)
    check(bad.err == spirv.E_ID, 97)
    rt.heap_free(cp, SH.n)
    check(!spirv.spv_new(SH.p as u64 + 4, SH.n - 4, &bad), 94)
    check(bad.err == spirv.E_MAGIC, 95)
    return 0
}
