// expect_out: 16000 17600 17249 64000 57600 57600 70400 1
// ROUND FIRN-LUECKEN -- the stroke, measured as an AREA.
//
// A stroke is not looked at here, it is counted: the sum of the coverage
// of every pixel is the area of the shape, and for these shapes the area
// is known exactly. `lib/font/raster.fi` computes coverage analytically,
// so the sum is not "about right" -- for a polygon it is the exact number.
//
//   line, butt caps      40 long, 4 wide                  ->  160
//   line, square caps    + 2 * 2 * 4                      ->  176
//   line, round caps     + pi * 2^2                       ->  172.57
//   ring, centred        44^2 - 36^2                      ->  640
//   ring, inside         40^2 - 32^2                      ->  576
//   ring, inside, the other way round                     ->  576
//   ring, outside        48^2 - 40^2                      ->  704
//
// The two "inside" numbers are the point of the alignment: the same ring,
// once clockwise and once anticlockwise, has to give the SAME band -- the
// caller does not know which way round a GeoJSON ring runs, so the stroker
// reads it off the signed area itself.
//
// The round caps are 9 hundredths short of pi: the arc is a polygon
// INSCRIBED in the circle, and that is the same kind of deviation
// `lib/font/raster.fi` writes down for its curves (313.3 against 314.16 on
// a circle of radius 10).
import std.io
import paint.stroke
import font.raster
import html.mem

const W: usize = 80
const H: usize = 80

fn cover(r: *mut raster.Raster) -> i64 {
    var sum: f64 = 0.0
    var y: usize = 0
    while y < H {
        var x: usize = 0
        while x < W {
            sum = sum + raster.raster_cov(r, x, y)
            x = x + 1
        }
        y = y + 1
    }
    return (sum * 100.0 + 0.5) as i64
}

fn line_area(s: *mut stroke.Stroke, r: *mut raster.Raster, cap: u32) -> i64 {
    raster.raster_begin(r, 0.0, 0.0, W, H)
    stroke.stroke_set_cap(s, cap)
    stroke.stroke_begin(s, false)
    stroke.stroke_point(s, 20.0, 40.0)
    stroke.stroke_point(s, 60.0, 40.0)
    stroke.stroke_end(s, r)
    raster.raster_finish(r)
    return cover(r)
}

fn ring_area(s: *mut stroke.Stroke, r: *mut raster.Raster, align: u32,
    turn: bool) -> i64 {
    raster.raster_begin(r, 0.0, 0.0, W, H)
    stroke.stroke_set_align(s, align)
    stroke.stroke_begin(s, true)
    if turn {
        stroke.stroke_point(s, 20.0, 20.0)
        stroke.stroke_point(s, 20.0, 60.0)
        stroke.stroke_point(s, 60.0, 60.0)
        stroke.stroke_point(s, 60.0, 20.0)
    } else {
        stroke.stroke_point(s, 20.0, 20.0)
        stroke.stroke_point(s, 60.0, 20.0)
        stroke.stroke_point(s, 60.0, 60.0)
        stroke.stroke_point(s, 20.0, 60.0)
    }
    stroke.stroke_end(s, r)
    raster.raster_finish(r)
    return cover(r)
}

fn main() -> i32 {
    if !gc_init() {
        return 1
    }
    var r: raster.Raster = raster.raster_new()
    let need: usize = raster.raster_bytes_needed(W, H)
    let rm: *mut u8 = mem.heap_alloc(need)
    if rm as usize == 0 {
        return 2
    }
    raster.raster_attach(&r, rm, need)
    var s: stroke.Stroke = stroke.stroke_new()
    let sn: usize = stroke.stroke_bytes_needed(64)
    let sm: *mut u8 = mem.heap_alloc(sn)
    if sm as usize == 0 {
        return 3
    }
    stroke.stroke_attach(&s, sm, sn)
    stroke.stroke_set_width(&s, 4.0)
    stroke.stroke_set_join(&s, stroke.JOIN_MITER)

    let a: i64 = line_area(&s, &r, stroke.CAP_BUTT)
    let b: i64 = line_area(&s, &r, stroke.CAP_SQUARE)
    let c: i64 = line_area(&s, &r, stroke.CAP_ROUND)
    let d: i64 = ring_area(&s, &r, stroke.ALIGN_CENTER, false)
    let e: i64 = ring_area(&s, &r, stroke.ALIGN_INNER, false)
    let f: i64 = ring_area(&s, &r, stroke.ALIGN_INNER, true)
    let g: i64 = ring_area(&s, &r, stroke.ALIGN_OUTER, false)

    // The area limit for small shapes: a ring of 8 by 8 has an area of 64
    // and a circumference of 32, so at `fit = 0.5` the border may be at
    // most 1.0 wide -- a quarter of the 4.0 that was asked for. Band area
    // 8^2 - 6^2 = 28 instead of 12^2 - 4^2 = 128.
    stroke.stroke_set_fit(&s, 0.5)
    raster.raster_begin(&r, 0.0, 0.0, W, H)
    stroke.stroke_set_align(&s, stroke.ALIGN_INNER)
    stroke.stroke_begin(&s, true)
    stroke.stroke_point(&s, 20.0, 20.0)
    stroke.stroke_point(&s, 28.0, 20.0)
    stroke.stroke_point(&s, 28.0, 28.0)
    stroke.stroke_point(&s, 20.0, 28.0)
    stroke.stroke_end(&s, &r)
    raster.raster_finish(&r)
    let h: i64 = cover(&r)
    var fit_ok: i64 = 0
    if h == 2800 {
        fit_ok = 1
    }
    io.fmt_print_line(f"{a} {b} {c} {d} {e} {f} {g} {fit_ok}")
    return 0
}
