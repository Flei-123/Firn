// expect_exit: 0
// `GcWeak[T]` (requirement S3): does NOT keep the target alive, and after the
// collection `strong(w)` yields the null value.
gc class Target {
    data: Gc[Target],
    value: u32,
}

// The strong pointer only exists within the frame of this function.
fn create(out: *mut GcWeak[Target]) -> i32 {
    let t = gc Target { data: gc_null[Target](), value: 5 } catch gc_null[Target]()
    if t == gc_null[Target]() {
        return 1
    }
    *out = weak(t)
    if strong(*out) == gc_null[Target]() {
        return 2
    }
    if strong(*out).value != 5 {
        return 3
    }
    return 0
}

// DEPTH PADDING (round 47): the conservative stack scan (SPEC 3.5.3) reads
// dead frames as roots as far as `__gc_scrub` no longer reaches them -- it
// only clears BELOW its own frame, and the topmost words under the stack
// pointer of the program are occupied later by `gc_collect` and `__gc_scrub`
// themselves. A helper called SHALLOW puts its pointers exactly there.
// That is why the actual helper is called kilobytes deeper: recursively (so
// it is never inlined) and with padding.
fn deep(out: *mut GcWeak[Target], t: u64) -> i32 {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var i: u64 = 0
    while i < 128 {
        *((fp + i * 8) as *mut u64) = i
        i = i + 1
    }
    if t > 0 {
        return deep(out, t - 1)
    }
    return create(out)
}

fn main() -> i32 {
    if !gc_init() {
        return 9
    }
    var w: GcWeak[Target] = weak_null[Target]()
    if strong(w) != gc_null[Target]() {
        return 4
    }
    if deep(&w, 2) != 0 {
        return 5
    }
    gc_collect()
    // Only held weakly -> collected, the reference is empty.
    if strong(w) != gc_null[Target]() {
        return 6
    }
    if gc_collections() == 0 {
        return 7
    }
    return 0
}
