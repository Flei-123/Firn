// expect_exit: 0
// `GcWeak[T]` (Anforderung S3): haelt das Ziel NICHT am Leben, und nach dem
// Sammellauf liefert `stark(w)` den Nullwert.
gc class Ziel {
    daten: Gc[Ziel],
    wert: u32,
}

// Der starke Zeiger existiert nur im Rahmen dieser Funktion.
fn anlegen(aus: *mut GcWeak[Ziel]) -> i32 {
    let t = gc Ziel{ daten: gc_null[Ziel](), wert: 5 } catch gc_null[Ziel]()
    if t == gc_null[Ziel]() {
        return 1
    }
    *aus = weak(t)
    if stark(*aus) == gc_null[Ziel]() {
        return 2
    }
    if stark(*aus).wert != 5 {
        return 3
    }
    return 0
}

fn main() -> i32 {
    if !gc_init() {
        return 9
    }
    var w: GcWeak[Ziel] = weak_null[Ziel]()
    if stark(w) != gc_null[Ziel]() {
        return 4
    }
    if anlegen(&w) != 0 {
        return 5
    }
    gc_collect()
    // Nur schwach gehalten -> eingesammelt, der Verweis ist leer.
    if stark(w) != gc_null[Ziel]() {
        return 6
    }
    if gc_collections() == 0 {
        return 7
    }
    return 0
}
