// expect_exit: 0
// `GcWeak[T]` (Anforderung S3): haelt das Ziel NICHT am Leben, und nach dem
// Sammellauf liefert `stark(w)` den Nullwert.
gc class Ziel {
    daten: Gc[Ziel],
    wert: u32,
}

// Der starke Zeiger existiert nur im Rahmen dieser Funktion.
fn anlegen(aus: *mut GcWeak[Ziel]) -> i32 {
    let t = gc Ziel{ daten: gc_null[Ziel](), wert: 5 } catch gc_null[Ziel]()
    if t == gc_null[Ziel]() {
        return 1
    }
    *aus = weak(t)
    if stark(*aus) == gc_null[Ziel]() {
        return 2
    }
    if stark(*aus).wert != 5 {
        return 3
    }
    return 0
}

// TIEFENPOLSTER (Runde 47): der konservative Stapelscan (SPEC 3.5.3) liest
// tote Rahmen als Wurzeln, soweit `__gc_scrub` sie nicht mehr erreicht — es
// nullt nur UNTERHALB seines eigenen Rahmens, und die obersten Worte unter dem
// Stapelzeiger des Programms belegen spaeter `gc_collect` und `__gc_scrub`
// selbst. Ein FLACH aufgerufener Helfer legt seine Zeiger genau dort ab.
// Deshalb wird der eigentliche Helfer kilobyteweise tiefer aufgerufen:
// rekursiv (wird also nie eingebettet) und mit Polster.
fn tief(aus: *mut GcWeak[Ziel], t: u64) -> i32 {
    var fuell: [u64; 128] = [0; 128]
    let fp: u64 = (&fuell) as u64
    var i: u64 = 0
    while i < 128 {
        *((fp + i * 8) as *mut u64) = i
        i = i + 1
    }
    if t > 0 {
        return tief(aus, t - 1)
    }
    return anlegen(aus)
}

fn main() -> i32 {
    if !gc_init() {
        return 9
    }
    var w: GcWeak[Ziel] = weak_null[Ziel]()
    if stark(w) != gc_null[Ziel]() {
        return 4
    }
    if tief(&w, 2) != 0 {
        return 5
    }
    gc_collect()
    // Nur schwach gehalten -> eingesammelt, der Verweis ist leer.
    if stark(w) != gc_null[Ziel]() {
        return 6
    }
    if gc_collections() == 0 {
        return 7
    }
    return 0
}
