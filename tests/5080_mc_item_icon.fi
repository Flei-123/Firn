// expect_exit: 0
import std.rt
import std.env
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_item_icon
import mc.mc_raster
import mc.mc_gui_tex
import html.mem
import paint.canvas
import paint.png

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn item_id(reg: *mut mc_registry.Registry, name: str) -> i32 {
    return mc_registry.reg_item_by_name(reg, name.p as u64, name.length())
}

fn opaque_count(t: *mut mc_gui_tex.GuiTex) -> i32 {
    var n: i32 = 0
    var j: i32 = 0
    while j < (*t).h {
        var i: i32 = 0
        while i < (*t).w {
            if (mc_gui_tex.gtex_get(t, i, j) >> 24 as u32) != 0 as u32 { n = n + 1 }
            i = i + 1
        }
        j = j + 1
    }
    return n
}

fn dump(r: *mut mc_raster.Raster, path: str) {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, (*r).w as usize, (*r).h as usize) { return }
    rt.mem_copy(canvas.canvas_pixels(&cv) as u64, (*r).color, ((*r).w as usize) * ((*r).h as usize) * 4)
    var enc: mem.Buf = mem.buf_new()
    if png.write_png(&cv, &enc) { rt.write_file(path.p as u64, mem.buf_ptr(&enc) as u64, mem.buf_len(&enc)) }
    mem.buf_free(&enc)
    canvas.canvas_free(&cv)
}

fn main() -> i32 {
    if !env.has("MC_VANILLA_JAR") { return 0 }
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 1)
    var reg: mc_registry.Registry = v.registry_of()
    var ic: mc_item_icon.IconCache = mc_item_icon.icons_new()
    check(mc_item_icon.icons_open(&ic, 763, mc_registry.reg_item_count(&reg)), 2)
    let s: i32 = 3
    let names: [str; 24] = ["stone", "grass_block", "oak_log", "iron_pickaxe", "oak_stairs", "stone_slab", "diamond", "bread", "oak_leaves", "torch", "oak_planks", "furnace", "crafting_table", "chest", "leather_helmet", "apple", "cobblestone", "dirt", "white_wool", "glass", "oak_door", "bucket", "water_bucket", "compass"]
    var r: mc_raster.Raster = mc_raster.raster_new(8 * 18 * s, 3 * 18 * s)
    mc_raster.raster_clear(&r, 0xFF8B8B8B as u32)
    var k: i32 = 0
    while k < 24 {
        let id: i32 = item_id(&reg, names[k as usize])
        check(id >= 0, 10 + k)
        let ok: bool = mc_item_icon.icons_draw(&ic, &r, &reg, id, (k % 8) * 18 * s + s, (k / 8) * 18 * s + s, s)
        if k < 5 || k == 12 { check(ok, 40 + k) }
        k = k + 1
    }
    let t: *mut mc_gui_tex.GuiTex = mc_item_icon.icons_get(&ic, &reg, item_id(&reg, "stone"), s)
    check((t as u64) != 0 as u64, 70)
    check(opaque_count(t) > 16 * s * 8, 71)
    let d: str = env.get("ICON_DUMP")
    if d.length() > 0 { dump(&r, d) }
    mc_item_icon.icons_free(&ic)
    return 0
}
