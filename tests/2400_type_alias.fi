// expect_exit: 0
// Round TUPLES (docs/GAPS.md B14): `type Name = Type` is another name for the
// SAME type. Declaration order does not matter, an alias may name another
// alias, and every spelling of a type is interchangeable with every other.
import std.io

// used before it is declared (further down)
fn widen(x: Idx) -> Wide {
    return x as Wide
}

struct Point { x: i32, y: i32 }
struct Box[T] { v: T }

type Idx = u32
type Wide = u64
type Bytes = *mut Octet
type Octet = u8
type Row = [Idx; 4]
type Grid = [Row; 2]
type Cb = fn(Idx) -> Idx
type P = Point
type BoxIdx = Box[Idx]
type Chain3 = Chain2
type Chain2 = Chain1
type Chain1 = i16

impl P {
    fn sum(self) -> i32 {
        return self.x + self.y
    }
}

fn twice(x: Idx) -> Idx {
    return x * 2
}

fn apply(f: Cb, x: u32) -> u32 {
    return f(x)
}

fn unbox(b: Box[u32]) -> u32 {
    return b.v
}

fn first_of(r: Row) -> u32 {
    return r[0]
}

fn main() -> i32 {
    // the alias and its target pass into each other without a cast
    let a: Idx = 7
    let b: u32 = a
    let c: Idx = b
    if c != 7 {
        return 1
    }
    if widen(a) != 7 {
        return 2
    }
    // a pointer to an aliased element type
    var oct: [Octet; 3] = [1, 2, 3]
    let q: Bytes = &oct[0]
    let r2: *mut u8 = q
    if *(r2 + 2) != 3 {
        return 3
    }
    // arrays of arrays, through two aliases
    var g: Grid = [[1, 2, 3, 4], [5, 6, 7, 8]]
    if g[1][2] != 7 {
        return 4
    }
    if first_of(g[0]) != 1 {
        return 5
    }
    // a function type through an alias
    if apply(twice, 21) != 42 {
        return 6
    }
    // the struct alias builds the struct, the method of the target works
    let p: P = P { x: 3, y: 4 }
    let pt: Point = p
    if p.sum() != 7 || pt.sum() != 7 {
        return 7
    }
    // an alias for a generic instantiation is the SAME instantiation
    let bi: BoxIdx = Box[u32] { v: 9 }
    if unbox(bi) != 9 {
        return 8
    }
    let bj: Box[Idx] = bi
    if unbox(bj) != 9 {
        return 9
    }
    // a chain of aliases, declared in reverse
    let k: Chain3 = -5
    let k1: i16 = k
    if k1 != -5 {
        return 10
    }
    // size_of sees the target
    if size_of[Idx]() != 4 || size_of[Wide]() != 8 || size_of[P]() != 8 {
        return 11
    }
    return 0
}
