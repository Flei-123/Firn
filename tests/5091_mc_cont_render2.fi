// expect_exit: 0
import std.rt
import std.env
import mc.mc_cont_ui
import mc.mc_item_src
import mc.mc_raster
import html.mem
import paint.canvas
import paint.png

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn dump(r: *mut mc_raster.Raster, path: str) {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, (*r).w as usize, (*r).h as usize) { return }
    rt.mem_copy(canvas.canvas_pixels(&cv) as u64, (*r).color, ((*r).w as usize) * ((*r).h as usize) * 4)
    var enc: mem.Buf = mem.buf_new()
    if png.write_png(&cv, &enc) { rt.write_file(path.p as u64, mem.buf_ptr(&enc) as u64, mem.buf_len(&enc)) }
    mem.buf_free(&enc)
    canvas.canvas_free(&cv)
}

fn panel(r: *mut mc_raster.Raster, u: *mut mc_cont_ui.ContUi, v: *mut mc_cont_ui.ContView, kind: i32, n: i32, k: i32, s: i32) {
    let w: i32 = mc_cont_ui.cui_panel_w(kind) * s
    let h: i32 = mc_cont_ui.cui_panel_h(kind, n) * s
    let px: i32 = (k % 3) * 280 * s
    let py: i32 = (k / 3) * 170 * s
    check(mc_cont_ui.cui_kind_ready(u, kind), 10 + kind)
    mc_cont_ui.cui_draw(r, u, kind, n, px, py, s, 0 as u64, 0)
    mc_cont_ui.cui_draw_extras(r, u, kind, n, px, py, s, v)
    check(w > 0 && h > 0, 40)
}

fn main() -> i32 {
    if !env.has("MC_VANILLA_JAR") { return 0 }
    var src: mc_item_src.ItemSrc = mc_item_src.isrc_new()
    check(mc_item_src.isrc_open(&src, 763), 1)
    var u: mc_cont_ui.ContUi = mc_cont_ui.cui_new()
    check(mc_cont_ui.cui_open(&u, &src), 2)
    var v: mc_cont_ui.ContView = mc_cont_ui.cview_new()
    v.props[0] = 150
    v.props[1] = 20
    v.props[2] = 100
    v.props[3] = 200
    v.props[4] = 5
    v.props[5] = 30
    v.present[0] = true
    v.present[2] = true
    v.lapis = 2
    v.mx = 0 - 1
    let name: str = "My Sword"
    v.name_p = name.p as u64
    v.name_n = name.n
    let s: i32 = 2
    var r: mc_raster.Raster = mc_raster.raster_new(280 * s * 3, 170 * s * 3)
    mc_raster.raster_clear(&r, 0xFF202020 as u32)
    panel(&r, &u, &v, mc_cont_ui.KIND_ANVIL, 3, 0, s)
    panel(&r, &u, &v, mc_cont_ui.KIND_ENCHANT, 2, 1, s)
    panel(&r, &u, &v, mc_cont_ui.KIND_BREWING, 5, 2, s)
    panel(&r, &u, &v, mc_cont_ui.KIND_MERCHANT, 3, 3, s)
    panel(&r, &u, &v, mc_cont_ui.KIND_BLAST, 3, 4, s)
    panel(&r, &u, &v, mc_cont_ui.KIND_HORSE, 17, 5, s)
    panel(&r, &u, &v, mc_cont_ui.KIND_GRIND, 3, 6, s)
    panel(&r, &u, &v, mc_cont_ui.KIND_SMITHING, 4, 7, s)
    panel(&r, &u, &v, mc_cont_ui.KIND_LOOM, 4, 8, s)
    let d: str = env.get("CONT_DUMP")
    if d.length() > 0 { dump(&r, d) }
    mc_cont_ui.cview_free(&v)
    mc_cont_ui.cui_free(&u)
    mc_item_src.isrc_free(&src)
    return 0
}
