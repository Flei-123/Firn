// expect_exit: 0
import std.rt
import mc.mc_raster
import mc.mc_hud
import mc.mc_client
import mc.mc_health
import mc.mc_health_ui

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn px(r: *mut mc_raster.Raster, x: i32, y: i32) -> u32 {
    return mc_raster.raster_pixel(r, x, y)
}

fn fresh(r: *mut mc_raster.Raster) {
    mc_raster.raster_clear(r, 0xFF000000 as u32)
}

fn main() -> i32 {
    var h: mc_health.Health = mc_health.health_new()
    check(!mc_health.health_visible(&h), 1)
    mc_health.health_set(&h, 20.0 as f32, 20, 5.0 as f32, 100 as u64)
    check(h.hp == 20 && h.food == 20 && h.sat_x10 == 50 && h.known && !h.dead, 2)
    check(mc_health.health_visible(&h) && mc_health.health_hearts_x2(&h) == 20, 3)
    mc_health.health_set(&h, 7.5 as f32, 13, 0.0 as f32, 200 as u64)
    check(h.hp == 8 && h.food == 13, 4)
    mc_health.health_set(&h, 0.0 as f32, 13, 0.0 as f32, 300 as u64)
    check(h.dead && h.n_deaths == 1 as u64 && h.died_ms == 300 as u64, 5)
    let m: str = "Steve fell from a high place"
    mc_health.health_set_dead(&h, m.p as u64, m.n, 350 as u64)
    check(h.n_deaths == 1 as u64 && mc_health.health_message_len(&h) == m.n, 6)
    mc_health.health_set(&h, 20.0 as f32, 20, 5.0 as f32, 400 as u64)
    check(!h.dead && h.n_alive == 1 as u64 && mc_health.health_message_len(&h) == 0, 8)
    check(!mc_health.health_respawn(&h, 0 as u64 as *mut mc_client.Client, 500 as u64), 9)
    mc_health.health_on_game_state(&h, 3, 1.0 as f32)
    check(!mc_health.health_visible(&h), 10)
    mc_health.health_on_game_state(&h, 3, 0.0 as f32)
    check(mc_health.health_visible(&h), 11)
    mc_health.health_on_game_state(&h, 1, 1.0 as f32)
    check(mc_health.health_visible(&h), 12)
    mc_health.health_set(&h, 40.0 as f32, 20, 0.0 as f32, 500 as u64)
    check(mc_health.health_hearts_x2(&h) == 20, 13)

    var r: mc_raster.Raster = mc_raster.raster_new(200, 120)
    fresh(&r)
    mc_health.health_set(&h, 20.0 as f32, 20, 5.0 as f32, 600 as u64)
    mc_health_ui.health_ui_draw(&h, &r, 1)
    check(px(&r, 13, 90) == mc_health_ui.HEART_COLOR, 14)
    check(px(&r, 185, 90) == mc_health_ui.FOOD_COLOR, 15)
    check(px(&r, 8, 90) == 0xFF000000 as u32 && px(&r, 100, 60) == 0xFF000000 as u32, 16)

    fresh(&r)
    mc_health.health_set(&h, 1.0 as f32, 1, 0.0 as f32, 700 as u64)
    mc_health_ui.health_ui_draw(&h, &r, 1)
    check(px(&r, 13, 90) == mc_health_ui.HEART_COLOR, 17)
    check(px(&r, 14, 90) == mc_health_ui.EMPTY_COLOR, 18)
    check(px(&r, 21, 90) == mc_health_ui.EMPTY_COLOR, 19)
    check(px(&r, 185, 90) == mc_health_ui.EMPTY_COLOR || px(&r, 185, 90) == mc_health_ui.FOOD_COLOR, 20)
    check(px(&r, 177, 90) == mc_health_ui.EMPTY_COLOR, 21)

    fresh(&r)
    mc_health.health_set(&h, 0.0 as f32, 20, 0.0 as f32, 800 as u64)
    mc_health_ui.health_ui_draw(&h, &r, 1)
    check((px(&r, 0, 0) & 0xFF as u32) == 75 as u32, 22)
    check(px(&r, 13, 90) != mc_health_ui.HEART_COLOR, 23)
    var lit: i32 = 0
    var y: i32 = 0
    while y < 120 {
        var x: i32 = 0
        while x < 200 {
            if px(&r, x, y) == 0xFFFFFFFF as u32 { lit = lit + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check(lit > 100, 24)

    var big: mc_raster.Raster = mc_raster.raster_new(400, 240)
    fresh(&big)
    mc_health.health_set(&h, 20.0 as f32, 20, 5.0 as f32, 900 as u64)
    mc_health_ui.health_ui_draw(&h, &big, 2)
    check(px(&big, 28, 181) == mc_health_ui.HEART_COLOR, 25)

    mc_raster.raster_free(&r)
    mc_raster.raster_free(&big)
    mc_health.health_free(&h)
    return 0
}
