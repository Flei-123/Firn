// expect_exit: 0
import std.rt
import std.env
import mc.mc_item_src
import mc.mc_raster
import mc.mc_cont_ui
import mc.mc_cont_prog

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn painted(r: *mut mc_raster.Raster, x0: i32, y0: i32, w: i32, h: i32) -> i32 {
    var n: i32 = 0
    var y: i32 = y0
    while y < y0 + h {
        var x: i32 = x0
        while x < x0 + w {
            if rt.ld32((*r).color, (y as usize) * ((*r).w as usize) + (x as usize)) != 0xFF000000 as u32 { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main() -> i32 {
    if !env.has("MC_VANILLA_JAR") { return 0 }
    var p: i32 = 763
    if env.has("PROG_SPRITES") { p = 769 }
    var src: mc_item_src.ItemSrc = mc_item_src.isrc_new()
    check(mc_item_src.isrc_open(&src, p), 1)
    var u: mc_cont_ui.ContUi = mc_cont_ui.cui_new()
    check(mc_cont_ui.cui_open(&u, &src), 2)
    let sprites: bool = env.has("PROG_SPRITES")
    check(mc_cont_prog.cprog_has(&u.prog, mc_cont_prog.PROG_FURNACE) == sprites, 3)
    var v: mc_cont_ui.ContView = mc_cont_ui.cview_new()
    var r: mc_raster.Raster = mc_raster.raster_new(176 * 2, 166 * 2)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_cont_ui.cui_draw_extras(&r, &u, mc_cont_ui.KIND_FURNACE, 3, 0, 0, 2, &v)
    check(painted(&r, 56 * 2, 36 * 2, 28, 28) == 0, 4)
    check(painted(&r, 79 * 2, 34 * 2, 48, 32) < 70, 5)
    v.props[0] = 100
    v.props[1] = 200
    v.props[2] = 100
    v.props[3] = 200
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_cont_ui.cui_draw_extras(&r, &u, mc_cont_ui.KIND_FURNACE, 3, 0, 0, 2, &v)
    let half_flame: i32 = painted(&r, 56 * 2, 36 * 2, 28, 28)
    let half_arrow: i32 = painted(&r, 79 * 2, 34 * 2, 48, 32)
    check(half_flame > 40, 6)
    check(half_arrow > 150, 7)
    v.props[0] = 200
    v.props[2] = 200
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_cont_ui.cui_draw_extras(&r, &u, mc_cont_ui.KIND_FURNACE, 3, 0, 0, 2, &v)
    check(painted(&r, 56 * 2, 36 * 2, 28, 28) > half_flame, 8)
    check(painted(&r, 79 * 2, 34 * 2, 48, 32) > half_arrow, 9)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_cont_ui.cui_draw_extras(&r, &u, mc_cont_ui.KIND_SMOKER, 3, 0, 0, 2, &v)
    check(painted(&r, 79 * 2, 34 * 2, 48, 32) > half_arrow, 10)
    mc_cont_ui.cview_free(&v)
    mc_cont_ui.cui_free(&u)
    mc_item_src.isrc_free(&src)
    return 0
}
