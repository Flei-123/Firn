// expect_exit: 0
// tests/2930_input_webpad.fi -- lib/input/webpad.fi: the browser Gamepad API (W3C standard mapping) as the logical pad of padcore.
// The host exports are plain Firn functions, so a native program drives them exactly like glweb.js does: button mapping, trigger and
// stick scaling, y flip, edges, connect / disconnect events, slots, and 3000 random frames against a naive model.
import std.rt
import std.io
import input.padcore
import input.webpad

static mut SEED: u64 = 424242

fn rnd() -> u64 {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return SEED / 65536
}

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn near(a: f64, b: f64, eps: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < eps
}

// the W3C standard button index -> padcore button (6 / 7 are triggers, no button)
fn model_btn(i: u32) -> i64 {
    if i == 0 as u32 { return padcore.PB_A as i64 }
    if i == 1 as u32 { return padcore.PB_B as i64 }
    if i == 2 as u32 { return padcore.PB_X as i64 }
    if i == 3 as u32 { return padcore.PB_Y as i64 }
    if i == 4 as u32 { return padcore.PB_LSHOULDER as i64 }
    if i == 5 as u32 { return padcore.PB_RSHOULDER as i64 }
    if i == 8 as u32 { return padcore.PB_BACK as i64 }
    if i == 9 as u32 { return padcore.PB_START as i64 }
    if i == 10 as u32 { return padcore.PB_LSTICK as i64 }
    if i == 11 as u32 { return padcore.PB_RSTICK as i64 }
    if i == 12 as u32 { return padcore.PB_DUP as i64 }
    if i == 13 as u32 { return padcore.PB_DDOWN as i64 }
    if i == 14 as u32 { return padcore.PB_DLEFT as i64 }
    if i == 15 as u32 { return padcore.PB_DRIGHT as i64 }
    if i == 16 as u32 { return padcore.PB_GUIDE as i64 }
    return 0 - 1
}

fn drain(p: *mut padcore.Pad, want_kind: u32) -> u32 {
    var n: u32 = 0 as u32
    var idx: u32 = 0 as u32
    var v: f64 = 0.0
    while true {
        let k: u32 = padcore.pad_event_next(p, &idx, &v)
        if k == 0 as u32 { break }
        if k == want_kind { n = n + 1 as u32 }
    }
    return n
}

fn main() -> i32 {
    var p: padcore.Pad = padcore.pad_new()
    check(!webpad.webpad_poll(0, &p), 1) // nothing connected
    check(webpad.webpad_slots() == 4, 2)

    // connect: event + state; button 0 (A) + button 16 (guide) held, left trigger half, left stick right
    webpad.firn_pad_state(0 as u32, (1 | 65536) as u32, 500 as i32, 0 as i32, 1000 as i32, 0 as i32, 0 as i32, 0 as i32)
    check(webpad.webpad_poll(0, &p), 3)
    check(webpad.webpad_present(0) && !webpad.webpad_present(1), 4)
    check(padcore.pad_down(&p, padcore.PB_A) && padcore.pad_pressed(&p, padcore.PB_A), 5)
    check(padcore.pad_down(&p, padcore.PB_GUIDE) && !padcore.pad_down(&p, padcore.PB_B), 6)
    check(near(padcore.pad_axis(&p, padcore.PA_LT), 0.5, 0.05), 7)
    check(padcore.pad_axis(&p, padcore.PA_LX) > 0.9, 8)
    check(near(padcore.pad_axis(&p, padcore.PA_LY), 0.0, 0.05), 9)
    check(drain(&p, padcore.PE_CONNECTED) == 1 as u32, 10)

    // same state again: no new edges, no new connect
    webpad.firn_pad_state(0 as u32, (1 | 65536) as u32, 500 as i32, 0 as i32, 1000 as i32, 0 as i32, 0 as i32, 0 as i32)
    check(webpad.webpad_poll(0, &p), 11)
    check(!padcore.pad_pressed(&p, padcore.PB_A) && padcore.pad_down(&p, padcore.PB_A), 12)
    check(drain(&p, padcore.PE_CONNECTED) == 0 as u32, 13)

    // release A, press X; right trigger full; up the dpad
    webpad.firn_pad_state(0 as u32, (4 | 4096) as u32, 0 as i32, 1000 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32 - 1000)
    check(webpad.webpad_poll(0, &p), 14)
    check(padcore.pad_released(&p, padcore.PB_A) && padcore.pad_pressed(&p, padcore.PB_X), 15)
    check(padcore.pad_down(&p, padcore.PB_DUP) && !padcore.pad_down(&p, padcore.PB_GUIDE), 16)
    check(near(padcore.pad_axis(&p, padcore.PA_RT), 1.0, 0.01), 17)
    check(padcore.pad_axis(&p, padcore.PA_RY) < 0.0 - 0.9, 18) // stick up = negative logical y

    // out-of-range values are clamped, a slot beyond 3 is ignored
    webpad.firn_pad_state(0 as u32, 0 as u32, 5000 as i32, 0 as i32 - 7, 99999 as i32, 0 as i32, 0 as i32, 99999 as i32)
    webpad.firn_pad_state(9 as u32, 1 as u32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32)
    check(webpad.webpad_poll(0, &p), 19)
    check(near(padcore.pad_axis(&p, padcore.PA_LT), 1.0, 0.01) && near(padcore.pad_axis(&p, padcore.PA_RT), 0.0, 0.01), 20)
    check(near(padcore.pad_axis(&p, padcore.PA_LX), 1.0, 0.01) && near(padcore.pad_axis(&p, padcore.PA_RY), 1.0, 0.01), 21) // y down = positive, as the browser reports it
    check(!webpad.webpad_poll(9, &p), 22)

    // a second pad in slot 2 does not touch slot 0
    var q: padcore.Pad = padcore.pad_new()
    webpad.firn_pad_state(2 as u32, 2 as u32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32)
    check(webpad.webpad_poll(2, &q) && padcore.pad_down(&q, padcore.PB_B), 23)
    check(webpad.webpad_poll(0, &p) && !padcore.pad_down(&p, padcore.PB_B), 24)

    // unplug: release edges + PE_DISCONNECTED once, then false
    webpad.firn_pad_state(0 as u32, 1 as u32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32)
    check(webpad.webpad_poll(0, &p) && padcore.pad_down(&p, padcore.PB_A), 25)
    drain(&p, 0 as u32)
    webpad.firn_pad_gone(0 as u32)
    webpad.firn_pad_gone(0 as u32) // twice: still one event
    check(!webpad.webpad_poll(0, &p), 26)
    check(padcore.pad_released(&p, padcore.PB_A) && !padcore.pad_down(&p, padcore.PB_A), 27)
    check(drain(&p, padcore.PE_DISCONNECTED) == 1 as u32, 28)
    check(!webpad.webpad_poll(0, &p) && drain(&p, padcore.PE_DISCONNECTED) == 0 as u32, 29)
    // plugged in again
    webpad.firn_pad_state(0 as u32, 0 as u32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32)
    check(webpad.webpad_poll(0, &p) && drain(&p, padcore.PE_CONNECTED) == 1 as u32, 30)

    // 3000 random frames against a naive model (buttons only; the axes have their own checks above)
    var f: u64 = 0
    var held: u32 = 0 as u32
    while f < 3000 as u64 {
        let m: u32 = (rnd() * 4 + rnd()) as u32 & 0x1FFFF as u32
        webpad.firn_pad_state(0 as u32, m, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32)
        check(webpad.webpad_poll(0, &p), 40)
        var i: u32 = 0 as u32
        while i < 17 as u32 {
            let b: i64 = model_btn(i)
            if b >= 0 {
                let now: bool = ((m >> i) & 1 as u32) != 0 as u32
                let was: bool = ((held >> i) & 1 as u32) != 0 as u32
                check(padcore.pad_down(&p, b as usize) == now, 41)
                check(padcore.pad_pressed(&p, b as usize) == (now && !was), 42)
                check(padcore.pad_released(&p, b as usize) == (!now && was), 43)
            }
            i = i + 1 as u32
        }
        held = m
        f = f + 1 as u64
    }
    io.print("webpad ok\n")
    return 0
}
