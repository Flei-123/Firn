// expect_exit: 0
// tests/910_css_tokenizer.fi -- the CSS tokenizer (css-syntax-3 section 4).
//
// The quota against the official suite is measured by tools/css/run.sh
// (305 cases out of testdata/css-parsing-tests). What is checked HERE is
// the handful of decisions the rest builds on, so that a mistake in them
// shows up in test.sh and not only in the tool:
//
//   1. the token kinds of an ordinary rule
//   2. `url(...)` versus `url("...")` -- one is a url token, the other a
//      function token
//   3. a string that runs into the end of the input delivers the string
//      AND an error token
//   4. escapes: `\30 red` becomes the ident `0red`
//   5. the match tokens `~=` and `||` exist only without a gap
//   6. numbers: representation and the integer/number type
//
// The return value names the first case that deviates (1..6).
import html.mem
import css.tok

#[no_gc]
fn feed(src: *mut mem.CpBuf, p: u64, n: usize) {
    mem.cp_clear(src)
    var i: usize = 0
    while i < n {
        mem.cp_push(src, (*((p + i as u64) as *mut u8)) as u32)
        i = i + 1
    }
}

#[no_gc]
fn kind_at(t: *mut tok.Tokens, i: usize) -> u32 {
    return tok.tok_kind(t, i)
}

#[no_gc]
fn value_is(t: *mut tok.Tokens, i: usize, p: u64, n: usize) -> bool {
    return tok.tok_value_equals_ascii(t, i, p, n)
}

#[no_gc]
fn main() -> i32 {
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var src: mem.CpBuf = mem.cp_new()

    // 1. an ordinary rule
    var s1: [u8; 20] = "div.a#b { c: 1px; } "
    feed(&src, (&s1[0]) as u64, 20)
    tok.tokenize(&t, &src)
    if tok.tok_count(&t) != 15 {
        return 1
    }
    if kind_at(&t, 0) != tok.T_IDENT {
        return 1
    }
    if kind_at(&t, 1) != tok.T_DELIM {
        return 1
    }
    if kind_at(&t, 3) != tok.T_HASH {
        return 1
    }
    if (tok.tok_flags(&t, 3) & tok.F_HASH_ID) == 0 as u32 {
        return 1
    }
    if kind_at(&t, 5) != tok.T_OPEN_CURLY {
        return 1
    }
    if kind_at(&t, 11) != tok.T_SEMICOLON {
        return 1
    }
    if kind_at(&t, 10) != tok.T_DIMENSION {
        return 1
    }
    if kind_at(&t, 13) != tok.T_CLOSE_CURLY {
        return 1
    }

    // 2. url without quotes is a url token, with quotes a function
    var s2: [u8; 25] = "url(a/b.png) url(\"c.png\")"
    feed(&src, (&s2[0]) as u64, 25)
    tok.tokenize(&t, &src)
    if kind_at(&t, 0) != tok.T_URL {
        return 2
    }
    var v2: [u8; 7] = "a/b.png"
    if !value_is(&t, 0, (&v2[0]) as u64, 7) {
        return 2
    }
    if kind_at(&t, 2) != tok.T_FUNCTION {
        return 2
    }
    if kind_at(&t, 3) != tok.T_STRING {
        return 2
    }

    // 3. a string running into the end of the input
    var s3: [u8; 4] = "'abc"
    feed(&src, (&s3[0]) as u64, 4)
    tok.tokenize(&t, &src)
    if tok.tok_count(&t) != 2 {
        return 3
    }
    if kind_at(&t, 0) != tok.T_STRING {
        return 3
    }
    if kind_at(&t, 1) != tok.T_EOF_IN_STRING {
        return 3
    }
    var v3: [u8; 3] = "abc"
    if !value_is(&t, 0, (&v3[0]) as u64, 3) {
        return 3
    }

    // 4. escapes
    var s4: [u8; 7] = "\\30 red"
    feed(&src, (&s4[0]) as u64, 7)
    tok.tokenize(&t, &src)
    if tok.tok_count(&t) != 1 {
        return 4
    }
    if kind_at(&t, 0) != tok.T_IDENT {
        return 4
    }
    var v4: [u8; 4] = "0red"
    if !value_is(&t, 0, (&v4[0]) as u64, 4) {
        return 4
    }

    // 5. the match tokens only without a gap
    var s5: [u8; 10] = "~=||~ =| |"
    feed(&src, (&s5[0]) as u64, 10)
    tok.tokenize(&t, &src)
    if kind_at(&t, 0) != tok.T_INCLUDE_MATCH {
        return 5
    }
    if kind_at(&t, 1) != tok.T_COLUMN {
        return 5
    }
    if kind_at(&t, 2) != tok.T_DELIM {
        return 5
    }
    if kind_at(&t, 4) != tok.T_DELIM {
        return 5
    }

    // 6. numbers
    var s6: [u8; 16] = "12 1.5 -0.67e0 2"
    feed(&src, (&s6[0]) as u64, 16)
    tok.tokenize(&t, &src)
    if kind_at(&t, 0) != tok.T_NUMBER {
        return 6
    }
    if (tok.tok_flags(&t, 0) & tok.F_INTEGER) == 0 as u32 {
        return 6
    }
    if (tok.tok_flags(&t, 2) & tok.F_INTEGER) != 0 as u32 {
        return 6
    }
    if tok.tok_number_integer(&t, 0) != 12 {
        return 6
    }
    if (tok.tok_flags(&t, 4) & tok.F_INTEGER) != 0 as u32 {
        return 6
    }
    var v6: [u8; 7] = "-0.67e0"
    if !value_is(&t, 4, (&v6[0]) as u64, 7) {
        return 6
    }
    tok.tokens_free(&t)
    mem.cp_free(&src)
    return 0
}
