// expect_out: ok
// RUNDE TEMPO 11 -- `lea` mit 32-Bit-Ziel.
//
// `compiler/src/regalloc.rs` schreibt `i + 1` auf einem `i32` jetzt als
// `lea edx, [r10+1]` statt `mov rdx,r10` + `add edx,1`. Das ist erlaubt,
// weil `lea r32` die Adresse in vollen 64 Bit bildet und die unteren 32
// ablegt -- und Addition mit der Restklassenbildung vertraeglich ist.
//
// "Erlaubt, weil eine Rechnung es sagt" ist genau die Sorte Aussage, die man
// nachprueft. Geprueft werden hier die Raender, an denen die Behauptung
// kaputtginge:
//
//   * der UEBERLAUF: `i32::MAX + 1` muss `i32::MIN` sein, nicht
//     2147483648. Wenn `lea` versehentlich 64 Bit ablegte, kaeme die
//     grosse Zahl heraus.
//   * die GROSSE VORZEICHENLOSE KONSTANTE: bei `u32` darf ein
//     unmittelbarer Wert den ganzen Bereich ausschoepfen; die Verschiebung
//     im `lea` ist aber ein vorzeichenbehaftetes 32-Bit-Feld. `x +
//     0xFFFFFFFF` muss `x - 1` sein.
//   * die SCHMALEN TYPEN: `u8` und `i16` rechnen auf diesem Weg ebenfalls in
//     32 Bit; ihr Ergebnis muss trotzdem in acht bzw. sechzehn Bit passen.
//   * `-` mit Konstante, und zwar bis unter null.
//
// Die Werte kommen aus `start`, damit der Uebersetzer nichts davon
// vorausrechnen kann.
import std.io

// Ueberall die UMLAUFENDEN Formen `+%` / `-%`: die Raender dieser Pruefung
// sind genau die Ueberlaeufe, und `+` haelt dort in den geprueften
// Baustufen das Programm an (zu Recht -- das ist eine andere Frage).
fn i32_plus(x: i32, k: i32) -> i32 {
    return x +% k
}
fn i32_minus(x: i32, k: i32) -> i32 {
    return x -% k
}
fn u32_plus(x: u32, k: u32) -> u32 {
    return x +% k
}
fn u8_plus(x: u8) -> u8 {
    return x +% 200 as u8
}
fn i16_minus(x: i16) -> i16 {
    return x -% 30000 as i16
}
fn i64_plus(x: i64) -> i64 {
    return x +% 1
}

fn check(got: i64, want: i64, what: str) -> bool {
    if got != want {
        io.print("FEHLER ")
        io.print(what)
        io.new_line()
        return false
    }
    return true
}

fn main(start: u64) -> i32 {
    var ok: bool = true
    // `null` ist 0, aber der Uebersetzer weiss das nicht.
    var null32: i32 = 0
    if start == 7777777 {
        null32 = 1
    }

    // 1. Ueberlauf bei i32: MAX + 1 == MIN
    let big: i32 = 2147483647 +% null32
    ok = check(i32_plus(big, 1) as i64, -2147483648, "i32 MAX+1") && ok
    ok = check(i32_plus(big, 2) as i64, -2147483647, "i32 MAX+2") && ok

    // 2. Unterlauf bei i32: MIN - 1 == MAX
    let klein: i32 = -2147483648 +% null32
    ok = check(i32_minus(klein, 1) as i64, 2147483647, "i32 MIN-1") && ok

    // 3. u32 mit der ganz grossen Konstante: x + 0xFFFFFFFF == x - 1
    var ten: u32 = 10
    if start == 7777777 {
        ten = 11
    }
    ok = check(u32_plus(ten, 4294967295 as u32) as i64, 9, "u32 + 0xFFFFFFFF") && ok
    ok = check(u32_plus(ten, 4294967286 as u32) as i64, 0, "u32 bis genau null") && ok

    // 4. schmale Typen
    var hundert: u8 = 100
    if start == 7777777 {
        hundert = 101
    }
    // 100 + 200 = 300, in acht Bit: 44
    ok = check(u8_plus(hundert) as i64, 44, "u8 100+200") && ok
    var zwanzigtausend: i16 = 20000
    if start == 7777777 {
        zwanzigtausend = 1
    }
    // 20000 - 30000 = -10000, passt in sechzehn Bit
    ok = check(i16_minus(zwanzigtausend) as i64, -10000, "i16 20000-30000") && ok

    // 5. und der Fall, der immer schon ging
    var big64: i64 = 4611686018427387904
    if start == 7777777 {
        big64 = 1
    }
    ok = check(i64_plus(big64), 4611686018427387905, "i64 + 1") && ok

    if ok {
        io.print_line("ok")
        return 0
    }
    return 1
}
