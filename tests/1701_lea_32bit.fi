// expect_out: ok
// ROUND TEMPO 11 -- `lea` with a 32-bit destination.
//
// `compiler/src/regalloc.rs` now writes `i + 1` on an `i32` as
// `lea edx, [r10+1]` instead of `mov rdx,r10` + `add edx,1`. That is allowed,
// because `lea r32` forms the address in full 64 bits and stores the lower 32
// -- and addition is compatible with taking the residue class.
//
// "Allowed because a calculation says so" is exactly the kind of statement that you
// check. Checked here are the edges at which the claim would
// break:
//
//   * the OVERFLOW: `i32::MAX + 1` must be `i32::MIN`, not
//     2147483648. If `lea` accidentally stored 64 bits, the
//     large number would come out.
//   * the LARGE UNSIGNED CONSTANT: with `u32` an immediate value
//     may exhaust the whole range; the displacement
//     in the `lea` is, however, a signed 32-bit field. `x +
//     0xFFFFFFFF` must be `x - 1`.
//   * the NARROW TYPES: `u8` and `i16` also calculate on this path in
//     32 bits; their result must nevertheless fit into eight or sixteen bits.
//   * `-` with a constant, down to below zero.
//
// The values come from `start`, so that the translator cannot calculate any of it
// in advance.
import std.io

// Everywhere the WRAPPING forms `+%` / `-%`: the edges of this check
// are exactly the overflows, and `+` stops the program there in the checked
// build stages (rightly so -- that is a different question).
fn i32_plus(x: i32, k: i32) -> i32 {
    return x +% k
}
fn i32_minus(x: i32, k: i32) -> i32 {
    return x -% k
}
fn u32_plus(x: u32, k: u32) -> u32 {
    return x +% k
}
fn u8_plus(x: u8) -> u8 {
    return x +% 200 as u8
}
fn i16_minus(x: i16) -> i16 {
    return x -% 30000 as i16
}
fn i64_plus(x: i64) -> i64 {
    return x +% 1
}

fn check(got: i64, want: i64, what: str) -> bool {
    if got != want {
        io.print("FEHLER ")
        io.print(what)
        io.new_line()
        return false
    }
    return true
}

fn main(start: u64) -> i32 {
    var ok: bool = true
    // `null` is 0, but the translator does not know that.
    var null32: i32 = 0
    if start == 7777777 {
        null32 = 1
    }

    // 1. overflow at i32: MAX + 1 == MIN
    let big: i32 = 2147483647 +% null32
    ok = check(i32_plus(big, 1) as i64, -2147483648, "i32 MAX+1") && ok
    ok = check(i32_plus(big, 2) as i64, -2147483647, "i32 MAX+2") && ok

    // 2. underflow at i32: MIN - 1 == MAX
    let small: i32 = -2147483648 +% null32
    ok = check(i32_minus(small, 1) as i64, 2147483647, "i32 MIN-1") && ok

    // 3. u32 with the very large constant: x + 0xFFFFFFFF == x - 1
    var ten: u32 = 10
    if start == 7777777 {
        ten = 11
    }
    ok = check(u32_plus(ten, 4294967295 as u32) as i64, 9, "u32 + 0xFFFFFFFF") && ok
    ok = check(u32_plus(ten, 4294967286 as u32) as i64, 0, "u32 bis genau null") && ok

    // 4. schmale Typen
    var hundert: u8 = 100
    if start == 7777777 {
        hundert = 101
    }
    // 100 + 200 = 300, in acht Bit: 44
    ok = check(u8_plus(hundert) as i64, 44, "u8 100+200") && ok
    var zwanzigtausend: i16 = 20000
    if start == 7777777 {
        zwanzigtausend = 1
    }
    // 20000 - 30000 = -10000, passt in sechzehn Bit
    ok = check(i16_minus(zwanzigtausend) as i64, -10000, "i16 20000-30000") && ok

    // 5. and the case that always worked
    var big64: i64 = 4611686018427387904
    if start == 7777777 {
        big64 = 1
    }
    ok = check(i64_plus(big64), 4611686018427387905, "i64 + 1") && ok

    if ok {
        io.print_line("ok")
        return 0
    }
    return 1
}
