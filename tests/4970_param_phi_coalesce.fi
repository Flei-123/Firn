// expect_exit: 0
fn fib(n: u32) -> u64 {
    if n < 2 {
        return n as u64
    }
    return fib(n - 1) + fib(n - 2)
}

fn gcd(a: u64, b: u64) -> u64 {
    var x: u64 = a
    var y: u64 = b
    while y != 0 {
        let t: u64 = x % y
        x = y
        y = t
    }
    return x
}

fn gcd_rec(a: u64, b: u64) -> u64 {
    if b == 0 {
        return a
    }
    return gcd_rec(b, a % b)
}

fn collatz(n: u64) -> u32 {
    var x: u64 = n
    var s: u32 = 0
    while x != 1 {
        if x % 2 == 0 {
            x = x / 2
        } else {
            x = 3 * x + 1
        }
        s = s + 1
    }
    return s
}

fn powmod(base: u64, exp: u64, m: u64) -> u64 {
    var r: u64 = 1
    var b: u64 = base % m
    var e: u64 = exp
    while e > 0 {
        if e % 2 == 1 {
            r = r * b % m
        }
        b = b * b % m
        e = e / 2
    }
    return r
}

fn sumto(n: u64, acc: u64) -> u64 {
    if n == 0 {
        return acc
    }
    return sumto(n - 1, acc + n)
}

fn ack(m: u32, n: u32) -> u32 {
    if m == 0 {
        return n + 1
    }
    if n == 0 {
        return ack(m - 1, 1)
    }
    return ack(m - 1, ack(m, n - 1))
}

fn swaploop(a0: u64, b0: u64, n0: u32) -> u64 {
    var a: u64 = a0
    var b: u64 = b0
    var n: u32 = n0
    while n > 0 {
        let t: u64 = a +% b
        a = b
        b = t
        n = n - 1
    }
    return a *% 1000003 +% b
}

fn keep_param(a: u64, b: u64, n: u32) -> u64 {
    var x: u64 = a
    var i: u32 = n
    while i > 0 {
        x = x +% b
        i = i - 1
    }
    return x *% 31 +% a +% b
}

fn main() -> i32 {
    if fib(30) != 832040 {
        return 1
    }
    if gcd(1071, 462) != 21 {
        return 2
    }
    if gcd(1000000000000, 77000000) != 1000000 {
        return 3
    }
    if gcd_rec(1071, 462) != 21 {
        return 4
    }
    if collatz(27) != 111 {
        return 5
    }
    if collatz(97) != 118 {
        return 6
    }
    if powmod(7, 1000003, 1000000007) != 842703477 {
        return 7
    }
    if sumto(1000, 5) != 500505 {
        return 8
    }
    if ack(2, 3) != 9 {
        return 9
    }
    if swaploop(3, 4, 40) != 599077344546763 {
        return 10
    }
    if keep_param(5, 7, 10) != (5 + 70) * 31 + 12 {
        return 11
    }
    return 0
}
