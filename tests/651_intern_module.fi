// expect_exit: 0
// `Interner` — Zeichenketten auf Nummern (lib/rt/intern.fi).
//
// `Map[K,V]` hat skalare Schluessel; eine Namenstabelle des Compilers hat
// Bezeichner. Der Interner schliesst die Luecke. Geprueft wird:
//   * derselbe Text liefert immer dieselbe Nummer, ein anderer nie
//   * Praefixe werden NICHT verwechselt ("ab" vs. "abc") — der haeufigste
//     Fehler, wenn beim Sondieren nur die Laenge oder nur der Hash zaehlt
//   * 2.000 erzeugte Bezeichner ueber mehrere Verdopplungen der Tabelle;
//     dabei zieht der Textpuffer um, waehrend Zeiger darauf im Umlauf sind
//   * Zusammenspiel mit `Map[u32, i64]`: Nummer als Schluessel, genau so wie
//     der Compiler es taete
import modules.intern
import modules.map
import modules.rt

fn nr(t: *mut intern.Interner, p: u64, n: usize) -> u32 {
    return intern.intern_number(t, p, n) as u32
}

fn main() -> i32 {
    var t: intern.Interner = intern.intern_new()
    defer intern.intern_free(&t)

    var a: [u8; 3] = "abc"
    var b: [u8; 2] = "ab"
    var c: [u8; 3] = "abd"
    var d: [u8; 3] = "abc"

    let pa: u64 = (&a[0]) as u64
    let pb: u64 = (&b[0]) as u64
    let pc: u64 = (&c[0]) as u64
    let pd: u64 = (&d[0]) as u64

    let na: u32 = nr(&t, pa, 3)
    let nb: u32 = nr(&t, pb, 2)
    let nc: u32 = nr(&t, pc, 3)
    let nd: u32 = nr(&t, pd, 3)

    // gleicher Text -> gleiche Nummer, obwohl anderer Speicherort
    if na != nd {
        return 1
    }
    // "ab" ist ein Praefix von "abc" und muss trotzdem eigen sein
    if na == nb || na == nc || nb == nc {
        return 2
    }
    if intern.intern_count(&t) != 3 {
        return 3
    }
    if intern.intern_length(&t, na) != 3 {
        return 4
    }
    if intern.intern_length(&t, nb) != 2 {
        return 5
    }
    if !intern.intern_equal(&t, na, pa, 3) {
        return 6
    }
    if intern.intern_equal(&t, na, pb, 2) {
        return 7
    }
    // die leere Zeichenkette ist ein gueltiger Bezeichner
    let empty: u32 = nr(&t, pa, 0)
    if intern.intern_length(&t, empty) != 0 {
        return 8
    }
    if intern.intern_count(&t) != 4 {
        return 9
    }
    if nr(&t, pb, 0) != empty {
        return 10
    }

    // --- 2.000 erzeugte Bezeichner: "v0000".."v1999"
    // Der Textpuffer zieht dabei mehrfach um. Wenn `intern_nummer` den Hash
    // aus dem UEBERGEBENEN statt aus dem eigenen Zeiger nimmt, faellt das hier
    // nicht auf — wohl aber, wenn `intern_wachse` den alten Zeiger behaelt.
    var name: [u8; 5] = "v0000"
    let pn: u64 = (&name[0]) as u64
    var first: Map[u32, i64] = map_new[u32, i64]()
    defer map_free[u32, i64](&first)

    var i: i64 = 0
    while i < 2000 {
        name[1] = (48 + (i / 1000) % 10) as u8
        name[2] = (48 + (i / 100) % 10) as u8
        name[3] = (48 + (i / 10) % 10) as u8
        name[4] = (48 + i % 10) as u8
        let n: i64 = intern.intern_number(&t, pn, 5)
        if n < 0 {
            return 11
        }
        // Nummer als Schluessel — genau die Verwendung im Compiler
        if !map_set[u32, i64](&first, n as u32, i) {
            return 12
        }
        i = i + 1
    }
    if intern.intern_count(&t) != 2004 {
        return 13
    }
    if map_len[u32, i64](&first) != 2000 {
        return 14
    }

    // Zweiter Durchlauf: KEINE neuen Nummern, und jede zeigt auf denselben Text
    i = 0
    while i < 2000 {
        name[1] = (48 + (i / 1000) % 10) as u8
        name[2] = (48 + (i / 100) % 10) as u8
        name[3] = (48 + (i / 10) % 10) as u8
        name[4] = (48 + i % 10) as u8
        let n: i64 = intern.intern_find(&t, pn, 5)
        if n < 0 {
            return 15
        }
        if map_get[u32, i64](&first, n as u32) != i {
            return 16
        }
        // Der gespeicherte Text muss Byte fuer Byte stimmen — auch nach allen
        // Umzuegen des Puffers.
        if !intern.intern_equal(&t, n as u32, pn, 5) {
            return 17
        }
        i = i + 1
    }
    if intern.intern_count(&t) != 2004 {
        return 18
    }

    // Ein Text, den es nicht gibt
    var missing: [u8; 5] = "v9999"
    if intern.intern_find(&t, (&missing[0]) as u64, 5) >= 0 {
        return 19
    }
    // und die alten Nummern von ganz am Anfang gelten weiter
    if intern.intern_find(&t, pa, 3) != na as i64 {
        return 20
    }
    if !intern.intern_equal(&t, na, pa, 3) {
        return 21
    }

    return 0
}
