// expect_exit: 0
// tests/4522_std_mathx_int.fi -- std.mathx integer functions against CPython 3.11
// (math.comb/perm/factorial/gcd/lcm, //, %, pow(b, e, m), pow(a, -1, m)).
// Mirrors tools/libs_py_cross/mathx_int_ref.py step by step (same LCG, same order).
import std.rt
import std.mathx
import std.testkit

struct Rng { x: u64 }
struct Hash { h: u64 }

fn nxt(g: *mut Rng) -> u64 {
    (*g).x = ((*g).x * 1103515245 + 12345) & 0x7fffffff
    return (*g).x
}

fn r62(g: *mut Rng) -> u64 {
    let hi: u64 = nxt(g)
    let lo: u64 = nxt(g)
    return (hi << 31) | lo
}

fn feed(h: *mut Hash, x: u64) {
    (*h).h = ((*h).h * 31 + (x & 0xffffffff)) & 0xffffffff
    (*h).h = ((*h).h * 31 + ((x >> 32) & 0xffffffff)) & 0xffffffff
}

fn feed_ov(h: *mut Hash, ok: bool, v: u64) {
    if ok { feed(h, v) } else { feed(h, 0xdead) }
}

fn report(h: *mut Hash, name: str, want: u64) {
    testkit.check((*h).h == want, name)
    (*h).h = 7
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var g: Rng = Rng { x: 99 }
    var hh: Hash = Hash { h: 7 }
    let h: *mut Hash = &hh
    var v: u64 = 0
    for n in 0..(71 as u64) {
        for k in 0..(n + 3) {
            let ok: bool = mathx.comb(n, k, &v)
            feed_ov(h, ok, v)
        }
    }
    report(h, "comb", 2548149300)
    for n in 0..(71 as u64) {
        for k in 0..(n + 3) {
            let ok: bool = mathx.perm(n, k, &v)
            feed_ov(h, ok, v)
        }
    }
    report(h, "perm", 3003832547)
    for n in 0..(26 as u64) {
        let ok: bool = mathx.factorial(n, &v)
        feed_ov(h, ok, v)
    }
    report(h, "factorial", 4259543345)
    for i in 0..(500 as u64) {
        var a: i64 = (nxt(&g) % 2000001) as i64 - 1000000
        var b: i64 = (nxt(&g) % 2000001) as i64 - 1000000
        if i % 50 == 0 { a = 0 }
        if i % 70 == 0 { b = 0 }
        feed(h, mathx.gcd_i64(a, b) as u64)
        feed(h, mathx.lcm_i64(a, b) as u64)
    }
    report(h, "gcd_lcm", 3942105515)
    for i in 0..(500 as u64) {
        let a: i64 = (nxt(&g) % 2000001) as i64 - 1000000
        var b: i64 = (nxt(&g) % 2000) as i64 - 1000
        if b == 0 { b = 7 }
        feed(h, mathx.floordiv(a, b) as u64)
        feed(h, mathx.floormod(a, b) as u64)
    }
    report(h, "floordiv_mod", 2031136411)
    for i in 0..(300 as u64) {
        let a: u64 = r62(&g)
        let b: u64 = r62(&g)
        let m0: u64 = r62(&g)
        let bit: u64 = nxt(&g) & 1
        var m: u64 = ((m0 << 1) | bit) | 1
        if i % 40 == 0 { m = 1 }
        if i % 41 == 0 { m = 2 + nxt(&g) % 100 }
        feed(h, mathx.mul_mod(a, b, m))
        feed(h, mathx.pow_mod(a, b, m))
    }
    report(h, "mul_pow_mod", 4137413665)
    var inv_ok: u64 = 0
    for i in 0..(400 as u64) {
        var m: u64 = 2 + r62(&g) % 1000000000000000000
        var a: u64 = r62(&g) % (3 * m)
        if i % 3 == 0 {
            m = 2 + nxt(&g) % 1000
            a = nxt(&g) % 3000
        }
        var inv: u64 = 0
        if mathx.mod_inv(a, m, &inv) {
            feed(h, inv)
            inv_ok = inv_ok + 1
        } else {
            feed(h, 0xbeef)
        }
    }
    report(h, "mod_inv", 1386045295)
    testkit.check(inv_ok == 316, "mod_inv invertible count")
    return testkit.finish()
}
