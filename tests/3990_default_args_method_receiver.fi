// expect_exit: 0
// tests/3990_default_args_method_receiver.fi -- r705: default and named
// arguments on methods are resolved by the RECEIVER type: two types may have
// a method of the same name with different parameters and defaults.
struct A { v: i32 }
struct B { v: i32 }

impl A {
    fn put(*self, x: i32 = 1) -> i32 {
        return (*self).v + x
    }
    fn mk(self, k: i32 = 10) -> A {
        return A { v: self.v + k }
    }
}

impl B {
    fn put(*self, x: i32 = 2, y: i32 = 3) -> i32 {
        return (*self).v + x * 100 + y * 10
    }
    fn mk(self, m: i32 = 20) -> B {
        return B { v: self.v + m }
    }
}

struct Pair { a: A, b: B }

fn first(p: *Pair) -> i32 {
    return (*p).a.put() + (*p).b.put()
}

fn fail(code: i32) -> i32 {
    return code
}

fn main() -> i32 {
    var a: A = A { v: 0 }
    var b: B = B { v: 0 }
    if a.put() != 1 { return fail(1) }
    if b.put() != 230 { return fail(2) }
    if a.put(x: 5) != 5 { return fail(3) }
    if b.put(y: 9) != 290 { return fail(4) }
    if b.put(7, y: 1) != 710 { return fail(5) }
    // chained: the receiver type comes from the previous method
    let a2: A = a.mk().mk(k: 1)
    if a2.v != 11 { return fail(6) }
    let b2: B = b.mk().mk(m: 5)
    if b2.v != 25 { return fail(7) }
    var p: Pair = Pair { a: a2, b: b2 }
    if first(&p) != 11 + 1 + 25 + 230 { return fail(8) }
    // nested in arguments
    if b.put(x: a.put(x: 3)) != 330 { return fail(9) }
    return 0
}
