// expect_exit: 0
// tests/3980_for_tuple_vec.fi -- `for (a, b) in vec_of_tuples`, 3-tuples, `_`, nested
// patterns and `for (i, (a, b)) in enumerate(v)` / zip with tuple elements (r708).
import std.io
import std.rt
import std.vec
import std.testkit

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[(i32, i64)] = vec_new[(i32, i64)]()
    vec_push[(i32, i64)](&v, (1, 10))
    vec_push[(i32, i64)](&v, (2, 20))
    vec_push[(i32, i64)](&v, (3, 30))
    var sa: i32 = 0
    var sb: i64 = 0
    for (a, b) in v {
        sa += a
        sb += b
    }
    testkit.check(sa == 6 && sb == 60, "pairs sum")
    // `_` skips a part, continue/break work as in every for
    var only_b: i64 = 0
    for (_, b) in v {
        if b == 20 { continue }
        only_b += b
    }
    testkit.check(only_b == 40, "skip first, continue")
    var stop: i32 = 0
    for (a, _) in v {
        stop = a
        if a == 2 { break }
    }
    testkit.check(stop == 2, "break")
    // 3-tuples
    var w: Vec[(i32, i32, i32)] = vec_new[(i32, i32, i32)]()
    vec_push[(i32, i32, i32)](&w, (1, 2, 3))
    vec_push[(i32, i32, i32)](&w, (4, 5, 6))
    var tri: i32 = 0
    for (x, y, z) in w {
        tri += x * 100 + y * 10 + z
    }
    testkit.check(tri == 123 + 456, "triples")
    // enumerate with a nested pattern for the element
    var chk: i64 = 0
    for (i, (a, b)) in enumerate(v) {
        chk += (i as i64 + 1) * (a as i64 + b)
    }
    testkit.check(chk == 1 * 11 + 2 * 22 + 3 * 33, "enumerate nested")
    // nested tuple elements
    var nv: Vec[(i32, (i32, i32))] = vec_new[(i32, (i32, i32))]()
    vec_push[(i32, (i32, i32))](&nv, (1, (2, 3)))
    vec_push[(i32, (i32, i32))](&nv, (4, (5, 6)))
    var nsum: i32 = 0
    for (a, (b, c)) in nv {
        nsum += a * b + c
    }
    testkit.check(nsum == 5 + 26, "nested element")
    // zip: a tuple element on either side
    let arr: [i32; 3] = [7, 8, 9]
    var zs: i64 = 0
    for (n, (a, b)) in zip(arr, v) {
        zs += n as i64 * (a as i64 + b)
    }
    testkit.check(zs == 7 * 11 + 8 * 22 + 9 * 33, "zip with tuple")
    // strings in a tuple
    var sv: Vec[(str, i32)] = vec_new[(str, i32)]()
    vec_push[(str, i32)](&sv, ("ab", 1))
    vec_push[(str, i32)](&sv, ("cde", 2))
    var total: i32 = 0
    for (s, k) in sv {
        total += s.n as i32 * k
    }
    testkit.check(total == 2 + 6, "str in tuple")
    // empty vec: body never runs
    var ev: Vec[(i32, i32)] = vec_new[(i32, i32)]()
    var hits: i32 = 0
    for (a, b) in ev {
        hits += a + b
    }
    testkit.check(hits == 0, "empty")
    vec_free[(i32, i64)](&v)
    vec_free[(i32, i32, i32)](&w)
    vec_free[(i32, (i32, i32))](&nv)
    vec_free[(str, i32)](&sv)
    vec_free[(i32, i32)](&ev)
    return testkit.finish()
}
