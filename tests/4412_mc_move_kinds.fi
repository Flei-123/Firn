// expect_exit: 0
import std.rt
import mc.mc_version
import mc.mc_versions
import mc.mc_registry
import mc.mc_shapes
import mc.mc_move_fluid

fn name_is(np: u64, nl: usize, s: str) -> bool {
    if nl != s.n { return false }
    var i: usize = 0
    while i < nl {
        if rt.ld8(np, i) != rt.ld8(s.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

fn bump(t: u64, i: i32) {
    rt.st32(t, i as usize, rt.ld32(t, i as usize) + 1 as u32)
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 1 }
    var r: mc_registry.Registry = v.registry_of()
    let ns: i32 = mc_registry.reg_state_count(&r)
    let water: u64 = rt.heap_alloc(36)
    let lava: u64 = rt.heap_alloc(36)
    var z: usize = 0
    while z < 9 {
        rt.st32(water, z, 0 as u32)
        rt.st32(lava, z, 0 as u32)
        z = z + 1
    }
    var ladders: i32 = 0
    var wlogged: i32 = 0
    var vines: i32 = 0
    var s: i32 = 0
    while s < ns {
        let k: i32 = mc_shapes.move_kind_for_state(&r, s)
        let b: i32 = mc_registry.reg_block_of_state(&r, s)
        var nl: usize = 0
        let np: u64 = mc_registry.reg_block_name(&r, b, &nl)
        if name_is(np, nl, "water") {
            if !mc_move_fluid.kind_is_water(k) { return 2 }
            bump(water, mc_move_fluid.kind_amount(k))
        } else if name_is(np, nl, "lava") {
            if !mc_move_fluid.kind_is_lava(k) { return 3 }
            bump(lava, mc_move_fluid.kind_amount(k))
        } else if name_is(np, nl, "ladder") {
            if k != mc_move_fluid.MV_LADDER && !mc_move_fluid.kind_is_water(k) { return 4 }
            if k == mc_move_fluid.MV_LADDER { ladders = ladders + 1 }
        } else if name_is(np, nl, "vine") {
            if k == mc_move_fluid.MV_LADDER { vines = vines + 1 }
        } else if mc_move_fluid.kind_is_water(k) {
            wlogged = wlogged + 1
        }
        s = s + 1
    }
    var a: i32 = 1
    while a <= 7 {
        if rt.ld32(water, a as usize) != 1 as u32 || rt.ld32(lava, a as usize) != 1 as u32 { return 5 }
        a = a + 1
    }
    if rt.ld32(water, 8) != 9 as u32 || rt.ld32(lava, 8) != 9 as u32 { return 6 }
    if ladders != 4 { return 7 }
    if vines != 32 { return 8 }
    if wlogged < 100 { return 9 }
    return 0
}
