// expect_exit: 0
// tests/1335_literal_default.fi -- the default type of an integer literal
// (round 70).
//
// Up to round 69 `var x = 5` was an error: "the type of the integer literal
// cannot be inferred". From now on the rule is the one of C#, Java and Go:
// where the context says something, THAT holds; where it says nothing, `i32`
// holds.
//
// What deliberately does NOT change: the literal still adapts itself to a
// demanded type (`let y: i64 = 5`), and the overflow check stays exactly as
// sharp (`tests/neg/literal_default_overflow.fi`).

fn takes_i32(a: i32) -> i32 { return a }
fn takes_i64(a: i64) -> i64 { return a }

fn main() -> i32 {
    // no context at all -> i32
    let x = 5
    if takes_i32(x) != 5 { return 1 }
    var y = 7
    y = y + 1
    if takes_i32(y) != 8 { return 2 }

    // the context keeps precedence
    let a: i64 = 5
    if takes_i64(a) != 5 { return 3 }
    let b: u8 = 200
    if b != 200 as u8 { return 4 }
    let c: usize = 9
    if c != 9 as usize { return 5 }
    let d: long = 5000000000
    if d != 5000000000 { return 6 }

    // the type of the neighbour wins over the default
    let e: i64 = 3
    let f = e + 1
    if takes_i64(f) != 4 { return 7 }
    let g: u8 = 3 as u8
    let h = g + 1 as u8
    if h != 4 as u8 { return 8 }

    // the default at the edges of i32
    let lo = -2147483648
    let hi = 2147483647
    if takes_i32(lo) != -2147483648 { return 9 }
    if takes_i32(hi) != 2147483647 { return 10 }

    // and the alias of round 70 says the same thing
    let i: int = 5
    if i != x { return 11 }
    return 0
}
