// expect_exit: 0
// tests/3440_dev_leaf_inline.fi -- r591: dev-fast embeds tiny call-free, loop-free
// helpers (`str.chars`, `vec_elem_ptr`, wrappers, parameter-spill allocas shared
// between the sites of one caller). Every result is compared with the same
// computation written out by hand; a wrong slot share, a lost operand or a
// mixed-up result travelling back would change one of them.
import std.str
import std.vec

struct Pair {
    a: u32,
    b: u32,
}

fn lo(p: *mut Pair) -> u32 {
    return (*p).a
}

fn hi(p: *mut Pair) -> u32 {
    return (*p).b
}

fn pick(c: bool, x: u64, y: u64) -> u64 {
    if c {
        return x
    }
    return y
}

fn clamp8(x: u64) -> u64 {
    if x > 255 {
        return 255
    }
    return x
}

// a wrapper: a leaf only after `clamp8` is embedded into it
fn clamp_twice(x: u64) -> u64 {
    return clamp8(clamp8(x))
}

fn spill_len(s: str) -> usize {
    return s.length()
}

fn spill_first(s: str, dflt: u8) -> u8 {
    if s.length() == 0 {
        return dflt
    }
    return s.chars(0)
}

fn add_checked(a: u32, b: u32) -> u32 {
    return a + b
}

fn check(ok: bool, code: i32) -> i32 {
    if ok {
        return 0
    }
    return code
}

fn main() -> i32 {
    var bad: i32 = 0
    let text: str = "Firn leaf inliner"
    // octet loop: str.chars at several sites of ONE caller
    var sum_h: u64 = 0
    var i: usize = 0
    while i < text.length() + 3 {
        sum_h = sum_h + text.chars(i) as u64
        i = i + 1
    }
    bad = bad + check(sum_h == 1624, 1)
    bad = bad + check(text.chars(0) == 70 as u8 && text.chars(4) == 32 as u8 && text.chars(99) == 0 as u8, 2)
    // two different spilled structs alive in one expression
    let a: str = "abc"
    let b: str = "wxyz"
    bad = bad + check(a.chars(1) as u32 * 1000 + b.chars(3) as u32 == 98 * 1000 + 122, 3)
    bad = bad + check(spill_len(a) * 10 + spill_len(b) == 34, 4)
    bad = bad + check(spill_first(a, 9 as u8) == 97 as u8, 5)
    bad = bad + check(spill_first(text.part(0, 0), 9 as u8) == 9 as u8, 6)
    // pointer leaves, results used as operands of the next call
    var p: Pair = Pair { a: 7, b: 35 }
    var q: Pair = Pair { a: 11, b: 13 }
    bad = bad + check(lo(&p) + hi(&q) * 100 + hi(&p) * 10000 + lo(&q) * 1000000 == 11351307, 7)
    // select-like leaves, nested
    var k: u64 = 0
    var n: u64 = 0
    while n < 600 {
        k = k + pick(n % 3 == 0, clamp_twice(n), clamp8(n + 1))
        n = n + 1
    }
    var ref_k: u64 = 0
    n = 0
    while n < 600 {
        var x: u64 = n + 1
        if n % 3 == 0 { x = n }
        if x > 255 { x = 255 }
        ref_k = ref_k + x
        n = n + 1
    }
    bad = bad + check(k == ref_k, 8)
    // Vec element pointers (vec_elem_ptr[T]) through std.vec sorting/swapping
    var v: Vec[u32] = vec_new[u32]()
    var j: u32 = 0
    while j < 50 {
        vec_push[u32](&v, (j * 37 + 11) % 101)
        j = j + 1
    }
    vec_sort[u32](&v)
    var ok: bool = true
    j = 1
    while j < 50 {
        if vec_at[u32](&v, j as usize - 1) > vec_at[u32](&v, j as usize) { ok = false }
        j = j + 1
    }
    bad = bad + check(ok, 9)
    // checked arithmetic inside a leaf keeps working
    bad = bad + check(add_checked(40, 2) == 42, 10)
    return bad
}
