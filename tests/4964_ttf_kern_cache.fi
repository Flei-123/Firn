// expect_exit: 0
import std.rt
import std.fs
import std.testkit
import font.ttf

fn load(path: str, f: *mut ttf.Font, b: *mut rt.Buf) -> bool {
    fs.read_file(path, b) catch 0
    if rt.buf_len(b) == 0 {
        return false
    }
    *f = ttf.font_new()
    return ttf.font_init(f, rt.buf_ptr(b) as *mut u8, rt.buf_len(b))
}

fn compare_all(f: *mut ttf.Font) -> i64 {
    var mismatches: i64 = 0
    var nonzero: i64 = 0
    var a: u32 = 33
    while a < 127 {
        var b: u32 = 33
        while b < 127 {
            let ga: u32 = ttf.font_glyph_for(f, a)
            let gb: u32 = ttf.font_glyph_for(f, b)
            let raw: i32 = ttf.font_kern_raw(f, ga, gb)
            let cold: i32 = ttf.font_kern(f, ga, gb)
            let warm: i32 = ttf.font_kern(f, ga, gb)
            if raw != cold || raw != warm {
                mismatches = mismatches + 1
            }
            if raw != 0 {
                nonzero = nonzero + 1
            }
            b = b + 1
        }
        a = a + 1
    }
    if mismatches != 0 {
        return 0 - mismatches
    }
    return nonzero
}

#[test]
fn cache_matches_raw_kerning_firn_sans() {
    var f: ttf.Font = ttf.font_new()
    var b: rt.Buf = rt.buf_new()
    testkit.assert_true(load("tests/data/fonts/FirnSans.ttf", &f, &b), "font loads")
    if ttf.font_has_kern(&f) {
        testkit.assert_true(compare_all(&f) > 0, "cached kerning equals raw, pairs kern")
    }
    ttf.font_kern_release(&f)
    ttf.font_kern_release(&f)
    if ttf.font_has_kern(&f) {
        testkit.assert_true(compare_all(&f) > 0, "cache refills after release")
    }
}

#[test]
fn cache_matches_raw_kerning_dejavu() {
    var f: ttf.Font = ttf.font_new()
    var b: rt.Buf = rt.buf_new()
    if load("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", &f, &b) {
        testkit.assert_true(ttf.font_has_kern(&f), "dejavu has kerning")
        testkit.assert_true(compare_all(&f) > 0, "cached kerning equals raw, pairs kern")
        let av: i32 = ttf.font_kern(&f, ttf.font_glyph_for(&f, 65), ttf.font_glyph_for(&f, 86))
        testkit.assert_true(av < 0, "A V pulls together")
        testkit.assert_eq_i64(av as i64, ttf.font_kern_raw(&f, ttf.font_glyph_for(&f, 65), ttf.font_glyph_for(&f, 86)) as i64)
    }
}

#[test]
fn font_without_kerning_stays_zero() {
    var f: ttf.Font = ttf.font_new()
    testkit.assert_eq_i64(ttf.font_kern(&f, 1, 2) as i64, 0)
    testkit.assert_eq_i64(ttf.font_kern_raw(&f, 1, 2) as i64, 0)
}
