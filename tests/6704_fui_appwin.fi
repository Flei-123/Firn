// expect_exit: 0
import std.rt
import fui.app
import fui.appwin

static mut failures: i32 = 0
static mut closed: usize = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn on_closed(a: *mut app.App) {
    closed = closed + 1
}

fn main() -> i32 {
    let main_app: *mut app.App = app.window("Main", 400, 300)
    check("main window exists", main_app as u64 != 0)
    let child: *mut app.App = appwin.open("Child", 200, 150)
    check("open succeeds exactly where supported", (child as u64 != 0) == appwin.supported())
    check("count matches", appwin.count() == (if appwin.supported() { 1 } else { 0 }))
    check("alive matches", appwin.alive(child) == appwin.supported())
    if appwin.supported() {
        appwin.on_close(child, on_closed)
        check("listed", appwin.at(0) == child)
        appwin.close(child)
        check("closed child is not alive", !appwin.alive(child))
        check("main keeps running", !app.app_done(main_app as u64))
    }
    check("no close callback without a host loop", closed == 0)
    if failures == 0 {
        rt.write_everything(1, "ok\n".p as u64, 3)
    }
    return failures
}
