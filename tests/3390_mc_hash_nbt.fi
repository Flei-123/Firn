// expect_exit: 0
// mc_inv 1.21.5+ hashed stacks: custom_data (NBT compound, tags keep their types), lore (list of text components, boolean style flags) and a styled
// custom_name (compound) are hashed. Expected values come from an independent Python implementation of the hashing ops (CRC32C over tagged bytes).
// Return codes: 1xx = setup, 2xx = packet shape, 3xx = hashes.
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_hash
import mc.mc_inv

fn put_name(b: *mut bytes.Bytes, s: str) {
    bytes.put_u16(b, s.n as u16)
    var i: usize = 0
    while i < s.n { bytes.put_u8(b, rt.ld8(s.p as u64, i)); i = i + 1 }
}

// component type ids: custom_data, lore, custom_name
fn t_data() -> i32 { return 0 }
fn t_lore(p: i32) -> i32 { if p >= 774 { return 11 } else { return 8 } }
fn t_name(p: i32) -> i32 { if p >= 774 { return 6 } else { return 5 } }

fn put_stack(b: *mut bytes.Bytes, p: i32) {
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 20)
    bytes.put_varint(b, 3) // added
    bytes.put_varint(b, 0) // removed
    // custom_data {"a":1b,"s":"x"}
    bytes.put_varint(b, t_data()); bytes.put_u8(b, 10 as u8)
    bytes.put_u8(b, 1 as u8); put_name(b, "a"); bytes.put_u8(b, 1 as u8)
    bytes.put_u8(b, 8 as u8); put_name(b, "s"); put_name(b, "x")
    bytes.put_u8(b, 0 as u8)
    // lore ["L1", {text:"L2", bold:1b}]
    bytes.put_varint(b, t_lore(p)); bytes.put_varint(b, 2)
    bytes.put_u8(b, 8 as u8); put_name(b, "L1")
    bytes.put_u8(b, 10 as u8)
    bytes.put_u8(b, 8 as u8); put_name(b, "text"); put_name(b, "L2")
    bytes.put_u8(b, 1 as u8); put_name(b, "bold"); bytes.put_u8(b, 1 as u8)
    bytes.put_u8(b, 0 as u8)
    // custom_name {text:"N", color:"red"}
    bytes.put_varint(b, t_name(p)); bytes.put_u8(b, 10 as u8)
    bytes.put_u8(b, 8 as u8); put_name(b, "text"); put_name(b, "N")
    bytes.put_u8(b, 8 as u8); put_name(b, "color"); put_name(b, "red")
    bytes.put_u8(b, 0 as u8)
}

fn hash_of(h: *mut mc_hash.HStack, t: i32) -> i64 {
    var i: i32 = 0
    while i < (*h).n_add {
        if (*h).add_t[i as usize] == t { return (bytes.bits_u32((*h).add_h[i as usize]) as i64) }
        i = i + 1
    }
    return 0 - 1
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, 0)
    bytes.put_varint(&b, 5)
    bytes.put_varint(&b, 46)
    var i: i32 = 0
    while i < 46 {
        if i == 36 { put_stack(&b, p) } else { bytes.put_varint(&b, 0) }
        i = i + 1
    }
    bytes.put_varint(&b, 0)
    bytes.bytes_set_pos(&b, 0)
    if !mc_inv.inv_on_window_items_v(&v, &ver, &b) { return 101 }
    if v.bad != 0 as u32 { return 102 }
    var cb: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(&v, p, 36, 0, 0, &cb) { return 200 }
    bytes.bytes_set_pos(&cb, 0)
    let w: i32 = bytes.get_varint(&cb) catch (0 - 1)
    let st: i32 = bytes.get_varint(&cb) catch (0 - 1)
    let sl: i16 = bytes.get_i16(&cb) catch (0 - 1 as i16)
    let bt: i8 = bytes.get_i8(&cb) catch (0 as i8)
    let md: i32 = bytes.get_varint(&cb) catch (0 - 1)
    if w != 0 || st != 5 || sl != 36 || bt != 0 as i8 || md != 0 { return 203 }
    let nc: i32 = bytes.get_varint(&cb) catch (0 - 1)
    if nc != 1 { return 204 }
    let cs: i16 = bytes.get_i16(&cb) catch (0 - 1 as i16)
    var h1: mc_hash.HStack = mc_hash.hstack_empty()
    if cs != 36 || !mc_hash.hstack_get(&cb, &h1) || h1.present { return 205 }
    var h2: mc_hash.HStack = mc_hash.hstack_empty()
    if !mc_hash.hstack_get(&cb, &h2) || !h2.present || h2.item != 20 || h2.count != 1 { return 206 }
    if h2.n_add != 3 { return 300 }
    if hash_of(&h2, t_data()) != 3837691935 { return 301 }
    if hash_of(&h2, t_lore(p)) != 3352668374 { return 302 }
    if hash_of(&h2, t_name(p)) != 2577718887 { return 303 }
    return 0
}

fn main() -> i32 {
    let r1: i32 = check(770)
    if r1 != 0 { return r1 }
    let r2: i32 = check(772)
    if r2 != 0 { return 1 + r2 - 1 }
    return check(774)
}
