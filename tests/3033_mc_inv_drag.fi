// expect_exit: 0
// mc_inv drag (Click Container mode 5, QUICKCRAFT): start / add slots / end; the stack is shared at the END packet like the server does it
// (left button = split evenly, right button = one each, clone only in creative), slots with another item / the result slot / armour slots
// are not accepted, a single slot is a plain click, any other click ends the drag. Start / add packets carry no changed slot.
// Exit codes are 8 bit: the failing check (the first failing protocol).
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_schema
import mc.mc_registry
import mc.mc_inv

fn it(r: *mut mc_registry.Registry, name: str) -> i32 { return mc_registry.reg_item_by_name(r, name.p as u64, name.n) }

fn layout(ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let id: i32 = mc_version.version_pid(ver, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK)
    if id < 0 { return false }
    let sch: u64 = (*ver).schema_of(mc_version.ST_PLAY, mc_version.DIR_C2S, id)
    if sch == 0 as u64 { return false }
    bytes.bytes_set_pos(b, 0)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk(sch, b, &out)
    rt.buf_free(&out)
    return ok
}

// one click, the packet must parse with the schema of the version; returns the number of changed slots (>= 0, only >= 1.17) or -1 / -2.
// `tail` gets the length of the packet and the last two bytes (legacy packets end with the clicked stack).
fn click_t(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32, len: *mut usize, last: *mut i32, last2: *mut i32) -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(v, (*ver).protocol, slot, button, mode, &b) { return 0 - 1 }
    let ok: bool = layout(ver, &b)
    var n: i32 = 0
    if (*ver).protocol >= 756 { n = bytes.bytes_at(&b, 6) as i32 }
    *len = bytes.bytes_len(&b)
    *last = bytes.bytes_at(&b, *len - 1) as i32
    *last2 = bytes.bytes_at(&b, *len - 2) as i32
    bytes.bytes_free(&b)
    if !ok { return 0 - 2 }
    return n
}

fn click(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32) -> i32 {
    var len: usize = 0
    var l1: i32 = 0
    var l2: i32 = 0
    return click_t(v, ver, slot, button, mode, &len, &l1, &l2)
}

fn fresh(r: *mut mc_registry.Registry) -> mc_inv.Inv {
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_use_registry(&v, r)
    return v
}

// puts `count` x `item` in the hand (slot 40 is used as the pick-up place)
fn hold(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, item: i32, count: i32) -> bool {
    mc_inv.inv_set(v, 44, item, count)
    if click(v, ver, 44, 0, 0) < 0 { return false }
    return mc_inv.inv_cursor_item(v) == item && mc_inv.inv_cursor_count(v) == count
}

fn drag(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, typ: i32, a: i32, b: i32, c: i32) -> i32 {
    // returns the number of changed slots of the end packet (>= 1.17), -1 on any packet problem
    let n: i32 = click(v, ver, 0 - 999, typ * 4, 5)
    if n < 0 { return 0 - 1 }
    if (*ver).protocol >= 756 && n != 0 { return 0 - 1 }
    if a >= 0 { if click(v, ver, a, 1 + typ * 4, 5) < 0 { return 0 - 1 } }
    if b >= 0 { if click(v, ver, b, 1 + typ * 4, 5) < 0 { return 0 - 1 } }
    if c >= 0 { if click(v, ver, c, 1 + typ * 4, 5) < 0 { return 0 - 1 } }
    return click(v, ver, 0 - 999, 2 + typ * 4, 5)
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var r: mc_registry.Registry = ver.registry_of()
    if !mc_registry.registry_ok(&r) { return 101 }
    let stone: i32 = it(&r, "stone")
    let dirt: i32 = it(&r, "dirt")
    let helmet: i32 = it(&r, "iron_helmet")
    if stone < 0 || dirt < 0 || helmet < 0 { return 102 }
    var v: mc_inv.Inv = fresh(&r)

    // left drag over three slots (one holds 5 stone already): 10 / 3 = 3 each, 1 stays in hand
    mc_inv.inv_set(&v, 11, stone, 5)
    if !hold(&v, &ver, stone, 10) { return 1 }
    let n: i32 = drag(&v, &ver, 0, 10, 11, 12)
    if n < 0 { return 2 }
    if mc_inv.inv_count(&v, 10) != 3 || mc_inv.inv_count(&v, 11) != 8 || mc_inv.inv_count(&v, 12) != 3 || mc_inv.inv_cursor_count(&v) != 1 { return 3 }
    if p >= 756 && n != 3 { return 4 }
    mc_inv.inv_free(&v)

    // right drag: one each
    v = fresh(&r)
    if !hold(&v, &ver, stone, 10) { return 10 }
    if drag(&v, &ver, 1, 10, 11, 12) < 0 { return 11 }
    if mc_inv.inv_count(&v, 10) != 1 || mc_inv.inv_count(&v, 11) != 1 || mc_inv.inv_count(&v, 12) != 1 || mc_inv.inv_cursor_count(&v) != 7 { return 12 }
    mc_inv.inv_free(&v)

    // the 64 limit: 63 + 5 -> 64 (takes 1), the other slot gets 5, 4 stay
    v = fresh(&r)
    mc_inv.inv_set(&v, 10, stone, 63)
    if !hold(&v, &ver, stone, 10) { return 20 }
    if drag(&v, &ver, 0, 10, 11, 0 - 1) < 0 { return 21 }
    if mc_inv.inv_count(&v, 10) != 64 || mc_inv.inv_count(&v, 11) != 5 || mc_inv.inv_cursor_count(&v) != 4 { return 22 }
    mc_inv.inv_free(&v)

    // not accepted: another item, the result slot, an armour slot (stone is no armour), a slot twice; only the accepted ones share
    v = fresh(&r)
    mc_inv.inv_set(&v, 12, dirt, 3)
    if !hold(&v, &ver, stone, 9) { return 30 }
    let m: i32 = click(&v, &ver, 0 - 999, 0, 5)
    if m < 0 { return 31 }
    if click(&v, &ver, 12, 1, 5) < 0 || click(&v, &ver, 0, 1, 5) < 0 || click(&v, &ver, 5, 1, 5) < 0 || click(&v, &ver, 13, 1, 5) < 0 || click(&v, &ver, 13, 1, 5) < 0 || click(&v, &ver, 14, 1, 5) < 0 { return 32 }
    if click(&v, &ver, 0 - 999, 2, 5) < 0 { return 33 }
    if mc_inv.inv_count(&v, 13) != 4 || mc_inv.inv_count(&v, 14) != 4 || mc_inv.inv_cursor_count(&v) != 1 { return 34 } // 9 / 2 = 4 each
    if mc_inv.inv_item(&v, 0) != 0 - 1 || mc_inv.inv_item(&v, 5) != 0 - 1 || mc_inv.inv_count(&v, 12) != 3 || mc_inv.inv_item(&v, 12) != dirt { return 35 }
    mc_inv.inv_free(&v)

    // an armour piece may go to the armour slot by drag (single slot -> plain click: the whole stack)
    v = fresh(&r)
    if !hold(&v, &ver, helmet, 1) { return 40 }
    if drag(&v, &ver, 0, 5, 0 - 1, 0 - 1) < 0 { return 41 }
    if mc_inv.inv_item(&v, 5) != helmet || mc_inv.inv_cursor_item(&v) != 0 - 1 { return 42 }
    mc_inv.inv_free(&v)

    // single slot: left = whole stack, right = one
    v = fresh(&r)
    if !hold(&v, &ver, stone, 7) { return 50 }
    if drag(&v, &ver, 1, 10, 0 - 1, 0 - 1) < 0 { return 51 }
    if mc_inv.inv_count(&v, 10) != 1 || mc_inv.inv_cursor_count(&v) != 6 { return 52 }
    if drag(&v, &ver, 0, 11, 0 - 1, 0 - 1) < 0 { return 53 }
    if mc_inv.inv_count(&v, 11) != 6 || mc_inv.inv_cursor_item(&v) != 0 - 1 { return 54 }
    mc_inv.inv_free(&v)

    // fewer items than slots: only as many slots as items are collected (2 stone, 3 slots -> 2 slots with 1)
    v = fresh(&r)
    if !hold(&v, &ver, stone, 2) { return 60 }
    if drag(&v, &ver, 0, 10, 11, 12) < 0 { return 61 }
    if mc_inv.inv_count(&v, 10) != 1 || mc_inv.inv_count(&v, 11) != 1 || mc_inv.inv_item(&v, 12) != 0 - 1 || mc_inv.inv_cursor_item(&v) != 0 - 1 { return 62 }
    mc_inv.inv_free(&v)

    // another click in the middle of a drag ends it; the end packet then does nothing; clone (type 2) needs creative
    v = fresh(&r)
    mc_inv.inv_set(&v, 15, dirt, 1)
    if !hold(&v, &ver, stone, 9) { return 70 }
    if click(&v, &ver, 0 - 999, 0, 5) < 0 || click(&v, &ver, 10, 1, 5) < 0 || click(&v, &ver, 11, 1, 5) < 0 { return 71 }
    if click(&v, &ver, 15, 0, 4) < 0 { return 72 } // drop (cursor not empty: ignored) -- it ends the drag
    if click(&v, &ver, 0 - 999, 2, 5) < 0 { return 73 }
    if mc_inv.inv_item(&v, 10) != 0 - 1 || mc_inv.inv_cursor_count(&v) != 9 { return 74 }
    if drag(&v, &ver, 2, 10, 11, 0 - 1) < 0 { return 75 }
    if mc_inv.inv_item(&v, 10) != 0 - 1 || mc_inv.inv_cursor_count(&v) != 9 { return 76 } // not creative: invalid type
    mc_inv.inv_set_creative(&v, true)
    if drag(&v, &ver, 2, 10, 11, 0 - 1) < 0 { return 77 }
    if mc_inv.inv_count(&v, 10) != 64 || mc_inv.inv_count(&v, 11) != 64 { return 78 }
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    var r: i32 = check(754)
    if r != 0 { return r }
    r = check(763)
    if r != 0 { return r }
    r = check(769)
    if r != 0 { return r }
    r = check(772)
    if r != 0 { return r }
    r = check(775)
    if r != 0 { return r }
    return 0
}
