// expect_exit: 0
// tests/3530_mc_input_slowdown.fi -- slowdown blocks (vanilla 1.20.1): soul sand / honey speed factor (steady-state ratio), honey jump factor 0.5,
// cobweb / sweet berry bush stuck multipliers, honey wall slide, XZ block offsets (bamboo / pointed dripstone: mc_math.block_offset + OFF_A / OFF_B codes).
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_input
import mc.mc_math

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000001
}

// block ids of this test
const STONE: u16 = 1 as u16
const SAND: u16 = 2 as u16
const HONEY: u16 = 3 as u16
const WEB: u16 = 4 as u16
const BERRY: u16 = 5 as u16
const POST: u16 = 6 as u16 // pane post + OFF_A (stands in for bamboo)
const POST_B: u16 = 7 as u16 // pane post + OFF_B (stands in for pointed dripstone)

fn put(ids: u64, x: i32, ly: i32, z: i32, id: u16) {
    rt.st16(ids, ((ly * 16 + z) * 16 + x) as usize, id)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

// layers 0..2 stone, layer 3 = `top` everywhere (y = -61)
fn make_floor(w: *mut mc_world.World, top: u16) -> u64 {
    let ids: u64 = new_ids()
    var z: i32 = 0
    while z < 16 {
        var x: i32 = 0
        while x < 16 {
            put(ids, x, 0, z, STONE)
            put(ids, x, 1, z, STONE)
            put(ids, x, 2, z, STONE)
            put(ids, x, 3, z, top)
            x = x + 1
        }
        z = z + 1
    }
    return ids
}

fn publish(w: *mut mc_world.World, ids: u64) {
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

fn fill(ids: u64, x0: i32, x1: i32, ly0: i32, ly1: i32, z0: i32, z1: i32, id: u16) {
    var ly: i32 = ly0
    while ly <= ly1 {
        var z: i32 = z0
        while z <= z1 {
            var x: i32 = x0
            while x <= x1 {
                put(ids, x, ly, z, id)
                x = x + 1
            }
            z = z + 1
        }
        ly = ly + 1
    }
}

fn tick(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32) {
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = keys
    mc_input.player_tick(p, &ev, w, tb, 0 - 64)
}

fn walk(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) {
    var t: i32 = 0
    while t < ticks {
        tick(p, w, tb, keys)
        t = t + 1
    }
}

fn ramp(n: i32, factor: f64, accel: f64) -> f64 {
    var v: f64 = 0.0
    var sum: f64 = 0.0
    var k: i32 = 0
    while k < n {
        v = v + accel
        sum = sum + v
        v = v * factor * 0.546
        k = k + 1
    }
    return sum
}

fn new_player(x: f64, y: f64, z: f64, with_mv: bool) -> mc_input.Player {
    var p: mc_input.Player = mc_input.player_new(x, y, z)
    if with_mv {
        rt.st8(p.mv, SAND as usize, mc_math.MV_SOUL_SAND as u8)
        rt.st8(p.mv, HONEY as usize, mc_math.MV_HONEY as u8)
        rt.st8(p.mv, WEB as usize, mc_math.MV_COBWEB as u8)
        rt.st8(p.mv, BERRY as usize, mc_math.MV_BERRY as u8)
    }
    return p
}

fn main() -> i32 {
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(8), solid: rt.heap_alloc(16), n: 8 }
    var i: usize = 0
    while i < 8 {
        rt.st8(tb.pick, i, 1 as u8)
        rt.st16(tb.solid, i, 1 as u16)
        i = i + 1
    }
    rt.st16(tb.solid, 0, 0 as u16)
    rt.st16(tb.solid, SAND as usize, (mc_math.SHAPE_BASE + mc_math.K_LOW + 14) as u16) // 14/16 high
    rt.st16(tb.solid, HONEY as usize, (mc_math.SHAPE_BASE + mc_math.K_HONEY) as u16) // 1/16 .. 15/16
    rt.st16(tb.solid, WEB as usize, 0 as u16)
    rt.st16(tb.solid, BERRY as usize, 0 as u16)
    rt.st16(tb.solid, POST as usize, (mc_math.SHAPE_BASE + mc_math.K_PANE + mc_math.OFF_A) as u16)
    rt.st16(tb.solid, POST_B as usize, (mc_math.SHAPE_BASE + mc_math.K_PANE + mc_math.OFF_B) as u16)
    let ACC: f64 = 0.098
    let ACC_SPRINT: f64 = 0.1274
    check(ramp(1, 0.4, ACC) > 0.0979 && ramp(1, 0.4, ACC) < 0.0981, 1)

    // ---- soul sand: steady-state ratio 0.581 (NOT 0.4), standing on 14/16
    var w: mc_world.World = mc_world.world_new()
    publish(&w, make_floor(&w, SAND))
    var s: mc_input.Player = new_player(8.5, 0.0 - 60.125, 4.5, true)
    walk(&s, &w, &tb, 0 as u32, 3)
    check(near(s.y, 0.0 - 60.125) && s.on_ground, 2)
    var z0: f64 = s.z
    walk(&s, &w, &tb, mc_input.K_FORWARD, 1)
    check(near(s.z - z0, ramp(1, 0.4, ACC)), 3)
    z0 = s.z
    walk(&s, &w, &tb, mc_input.K_FORWARD, 5)
    check(near(s.z - z0, ramp(6, 0.4, ACC) - ramp(1, 0.4, ACC)), 4)
    // without the movement table the same floor is plain walking (control)
    var c0: mc_input.Player = new_player(8.5, 0.0 - 60.125, 4.5, false)
    walk(&c0, &w, &tb, 0 as u32, 3)
    z0 = c0.z
    walk(&c0, &w, &tb, mc_input.K_FORWARD, 5)
    check(near(c0.z - z0, ramp(5, 1.0, ACC)), 5)
    // sprinting scales the same way
    var sp: mc_input.Player = new_player(8.5, 0.0 - 60.125, 4.5, true)
    walk(&sp, &w, &tb, 0 as u32, 3)
    z0 = sp.z
    walk(&sp, &w, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 4)
    check(near(sp.z - z0, ramp(4, 0.4, ACC_SPRINT)), 6)
    // soul sand jump factor stays 1 (first jump tick rises 0.42)
    var sj: mc_input.Player = new_player(8.5, 0.0 - 60.125, 4.5, true)
    walk(&sj, &w, &tb, 0 as u32, 3)
    walk(&sj, &w, &tb, mc_input.K_JUMP, 1)
    check(near(sj.y, 0.0 - 60.125 + 0.42), 7)
    mc_world.world_free(&w)

    // ---- honey block: same speed ratio, jump factor 0.5, standing on 15/16
    var wh: mc_world.World = mc_world.world_new()
    publish(&wh, make_floor(&wh, HONEY))
    var h: mc_input.Player = new_player(8.5, 0.0 - 60.0625, 4.5, true)
    walk(&h, &wh, &tb, 0 as u32, 3)
    check(near(h.y, 0.0 - 60.0625) && h.on_ground, 8)
    z0 = h.z
    walk(&h, &wh, &tb, mc_input.K_FORWARD, 5)
    check(near(h.z - z0, ramp(5, 0.4, ACC)), 9)
    var hj: mc_input.Player = new_player(8.5, 0.0 - 60.0625, 4.5, true)
    walk(&hj, &wh, &tb, 0 as u32, 3)
    walk(&hj, &wh, &tb, mc_input.K_JUMP, 1)
    check(near(hj.y, 0.0 - 60.0625 + 0.21), 10)
    // a second jump tick: vy = (0.21 - 0.08) * 0.98
    walk(&hj, &wh, &tb, mc_input.K_JUMP, 1)
    check(near(hj.y, 0.0 - 60.0625 + 0.21 + 0.1274), 11)
    mc_world.world_free(&wh)

    // ---- stone: first jump tick rises 0.42 (control for the honey jump factor)
    var wst: mc_world.World = mc_world.world_new()
    publish(&wst, make_floor(&wst, STONE))
    var sj2: mc_input.Player = new_player(8.5, 0.0 - 60.0, 4.5, true)
    walk(&sj2, &wst, &tb, 0 as u32, 3)
    walk(&sj2, &wst, &tb, mc_input.K_JUMP, 1)
    check(near(sj2.y, 0.0 - 60.0 + 0.42), 12)
    mc_world.world_free(&wst)

    // ---- cobweb room (layers 4..10): fall = 0.0784 * 0.05 per tick, horizontal = acceleration * 0.25
    var ww: mc_world.World = mc_world.world_new()
    let ids: u64 = make_floor(&ww, STONE)
    fill(ids, 0, 15, 4, 12, 0, 15, WEB)
    publish(&ww, ids)
    var a: mc_input.Player = new_player(8.5, 0.0 - 55.0, 4.5, true) // layer 9, in the air inside the web
    a.fall = 3.0
    walk(&a, &ww, &tb, 0 as u32, 1) // first tick: normal fall step (dy = 0), then the web is entered
    check(near(a.y, 0.0 - 55.0) && a.stuck == 1 && near(a.fall, 0.0), 13)
    var y0: f64 = a.y
    walk(&a, &ww, &tb, 0 as u32, 10)
    check(near(a.y - y0, 0.0 - 10.0 * 0.0784 * 0.05000000074505806), 14)
    // horizontal in the air: 0.0196 * 0.25
    z0 = a.z
    walk(&a, &ww, &tb, mc_input.K_FORWARD, 1)
    check(near(a.z - z0, 0.0196 * 0.25), 15)
    z0 = a.z
    walk(&a, &ww, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 1)
    check(near(a.z - z0, 0.02548 * 0.25), 16)
    // standing on the floor inside the web: 0.454 * 0.21585 * 0.25 per tick after the first tick
    var g: mc_input.Player = new_player(8.5, 0.0 - 60.0, 4.5, true)
    walk(&g, &ww, &tb, 0 as u32, 3)
    check(g.on_ground && g.stuck == 1, 17)
    z0 = g.z
    walk(&g, &ww, &tb, mc_input.K_FORWARD, 4)
    check(near(g.z - z0, 4.0 * ACC * 0.25), 18)
    // without the movement table the web is air
    var gn: mc_input.Player = new_player(8.5, 0.0 - 60.0, 4.5, false)
    walk(&gn, &ww, &tb, 0 as u32, 3)
    z0 = gn.z
    walk(&gn, &ww, &tb, mc_input.K_FORWARD, 4)
    check(near(gn.z - z0, ramp(4, 1.0, ACC)) && gn.stuck == 0, 19)
    mc_world.world_free(&ww)

    // ---- sweet berry bush: (0.8, 0.75, 0.8)
    var wb: mc_world.World = mc_world.world_new()
    let ib: u64 = make_floor(&wb, STONE)
    fill(ib, 0, 15, 4, 12, 0, 15, BERRY)
    publish(&wb, ib)
    var b: mc_input.Player = new_player(8.5, 0.0 - 55.0, 4.5, true)
    walk(&b, &wb, &tb, 0 as u32, 1)
    check(b.stuck == 2, 20)
    y0 = b.y
    walk(&b, &wb, &tb, 0 as u32, 5)
    check(near(b.y - y0, 0.0 - 5.0 * 0.0784 * 0.75), 21)
    var bg: mc_input.Player = new_player(8.5, 0.0 - 60.0, 4.5, true)
    walk(&bg, &wb, &tb, 0 as u32, 3)
    z0 = bg.z
    walk(&bg, &wb, &tb, mc_input.K_FORWARD, 3)
    check(near(bg.z - z0, 3.0 * ACC * 0.8), 22)
    mc_world.world_free(&wb)

    // ---- honey wall slide: a wall at x = 8 (layers 4..30), player in the air at x = 9.5 pushes into it (right = -x at yaw 0)
    var wl: mc_world.World = mc_world.world_new()
    let iw: u64 = make_floor(&wl, STONE)
    fill(iw, 8, 8, 4, 31, 0, 15, HONEY)
    publish(&wl, iw)
    var sl: mc_input.Player = new_player(9.5, 0.0 - 36.0, 4.5, true)
    walk(&sl, &wl, &tb, mc_input.K_RIGHT, 30)
    check(near(sl.x, 8.9375 + 0.3) && !sl.on_ground, 23) // stopped by the 15/16 wide wall block
    y0 = sl.y
    walk(&sl, &wl, &tb, mc_input.K_RIGHT, 5)
    check(near(sl.y - y0, 0.0 - 5.0 * 0.1274), 24) // (-0.05 - 0.08) * 0.98 per tick
    check(near(sl.vy, 0.0 - 0.1274) && near(sl.fall, 0.0), 25)
    // control: the same fall without the table accelerates
    var sn: mc_input.Player = new_player(9.5, 0.0 - 36.0, 4.5, false)
    walk(&sn, &wl, &tb, mc_input.K_RIGHT, 10)
    y0 = sn.y
    walk(&sn, &wl, &tb, mc_input.K_RIGHT, 5)
    check(sn.y - y0 < 0.0 - 5.0 * 0.5, 26)
    // not near the wall: no slide (x = 11)
    var fr: mc_input.Player = new_player(11.5, 0.0 - 36.0, 4.5, true)
    walk(&fr, &wl, &tb, 0 as u32, 20)
    check(fr.vy < 0.0 - 1.0, 27)
    mc_world.world_free(&wl)

    // ---- XZ block offsets (cross-checked with an independent python port of Mth.getSeed + float32 math)
    var ox: f64 = 0.0
    var oz: f64 = 0.0
    mc_math.block_offset(0, 0, 0.25, &ox, &oz)
    check(near(ox, 0.0 - 0.25) && near(oz, 0.0 - 0.25), 28)
    mc_math.block_offset(8, 8, 0.25, &ox, &oz)
    check(near(ox, 0.15000000596046448) && near(oz, 0.0 - 0.0833333283662796), 29)
    mc_math.block_offset(8, 8, 0.125, &ox, &oz)
    check(near(ox, 0.125) && near(oz, 0.0 - 0.0833333283662796), 30)
    mc_math.block_offset(0 - 5, 13, 0.25, &ox, &oz)
    check(near(ox, 0.0 - 0.25) && near(oz, 0.0 - 0.01666666567325592), 31)
    mc_math.block_offset(123456, 0 - 98765, 0.25, &ox, &oz)
    check(near(ox, 0.0 - 0.0833333283662796) && near(oz, 0.0 - 0.25), 32)
    mc_math.block_offset(3, 7, 0.125, &ox, &oz)
    check(near(ox, 0.11666667461395264) && near(oz, 0.050000011920928955), 33)
    // the shape moves: pane post at cell (8, 8) is 0.4375..0.5625 + offset; a player walking in +z stops at post z0 - 0.3
    var wp: mc_world.World = mc_world.world_new()
    let ip: u64 = make_floor(&wp, STONE)
    put(ip, 8, 4, 8, POST)
    put(ip, 3, 4, 7, POST_B)
    publish(&wp, ip)
    var pp: mc_input.Player = new_player(8.5 + 0.15000000596046448, 0.0 - 60.0, 4.5, false)
    walk(&pp, &wp, &tb, 0 as u32, 2)
    walk(&pp, &wp, &tb, mc_input.K_FORWARD, 40)
    check(near(pp.z, 8.4375 - 0.0833333283662796 - 0.3), 34) // offset z = -0.0833
    // a player at x = 8.2 (box up to 8.5) overlaps an un-offset post (8.4375 .. 8.5625) but not the offset one (8.5875 .. 8.7125): passes
    var pq: mc_input.Player = new_player(8.2, 0.0 - 60.0, 4.5, false)
    walk(&pq, &wp, &tb, 0 as u32, 2)
    walk(&pq, &wp, &tb, mc_input.K_FORWARD, 40)
    check(pq.z > 9.5, 35)
    // dripstone-like clamp 0.125: cell (3, 7): offset (0.11666667, 0.05)
    var pd: mc_input.Player = new_player(3.5 + 0.11666667461395264, 0.0 - 60.0, 4.5, false)
    walk(&pd, &wp, &tb, 0 as u32, 2)
    walk(&pd, &wp, &tb, mc_input.K_FORWARD, 40)
    check(near(pd.z, 7.4375 + 0.050000011920928955 - 0.3), 36)
    mc_world.world_free(&wp)

    if g_fail == 0 { return 0 }
    return 1
}
