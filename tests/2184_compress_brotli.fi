// expect_exit: 0
// tests/2184_compress_brotli.fi -- lib/compress/brotli.fi (decoder): streams
// made by Python's brotli (qualities 5, 9 (text mode) and 11, a 1 KiB window,
// English text that leans on the static dictionary), a stream built by hand
// from stored and metadata meta-blocks, an empty stream; refusals (cut,
// flipped, the large-window extension, limits); the streaming reader.
// tools/compress/check.py decodes a much larger corpus (all qualities, window
// sizes and modes) and a damaged-input sweep.
import compress.common
import compress.brotli
import std.rt
import std.io
import std.fs

const PLAIN: str = __include_str("data/compress/plain.bin")
const WORDS: str = __include_str("data/compress/words.bin")
const STORED: str = __include_str("data/compress/stored.bin")
const F_Q5: str = __include_str("data/compress/plain_q5.br")
const F_Q11: str = __include_str("data/compress/plain_q11.br")
const F_LGWIN10: str = __include_str("data/compress/plain_q1_lgwin10.br")
const F_TEXT9: str = __include_str("data/compress/plain_text9.br")
const F_WORDS: str = __include_str("data/compress/words.br")
const F_EMPTY: str = __include_str("data/compress/empty.br")
const F_TINY: str = __include_str("data/compress/tiny_empty.br")
const F_STORED: str = __include_str("data/compress/stored.br")

struct Tally {
    total: i64,
    fails: i64,
}

fn check(t: *mut Tally, what: str, ok: bool) {
    (*t).total = (*t).total + 1
    if !ok {
        (*t).fails = (*t).fails + 1
        io.print("FAIL ")
        io.print_line(what)
    }
}

static mut code: u32 = 0

fn why(e: CompressError) -> usize {
    if e == CompressError::Data { code = 1 }
    if e == CompressError::Format { code = 2 }
    if e == CompressError::Checksum { code = 3 }
    if e == CompressError::Truncated { code = 4 }
    if e == CompressError::TooLarge { code = 5 }
    if e == CompressError::OutOfMemory { code = 6 }
    if e == CompressError::Unsupported { code = 7 }
    if e == CompressError::Dictionary { code = 8 }
    if e == CompressError::Io { code = 9 }
    return 0
}

fn is_plain(b: *mut rt.Buf, want: str) -> bool {
    return rt.buf_len(b) == want.length() && rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.length())
}

fn view(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: rt.buf_len(b) }
}

fn scratch(tag: str) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, "/tmp/firn_".p as u64, 10)
    rt.buf_push_bytes(&b, tag.p as u64, tag.length())
    rt.buf_push(&b, 95 as u8)
    rt.buf_push_dec_i64(&b, syscall(39, 0, 0, 0, 0, 0, 0))
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

// deterministic pseudo random octets
fn pseudo(n: usize, seed: u64) -> rt.Buf {
    var b: rt.Buf = rt.buf_new()
    var x: u64 = seed
    var i: usize = 0
    while i < n {
        x = x *% 6364136223846793005 +% 1442695040888963407
        rt.buf_push(&b, ((x >> 33) & 255) as u8)
        i = i + 1
    }
    return b
}

fn zeros(n: usize) -> rt.Buf {
    var z: rt.Buf = rt.buf_new()
    rt.buf_reserve(&z, n)
    rt.mem_set(rt.buf_ptr(&z), 0 as u8, n)
    rt.buf_set_len(&z, n)
    return z
}

fn finish(t: *mut Tally) -> i32 {
    io.print("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&nb, (*t).total)
    io.print_bytes(rt.buf_ptr(&nb), rt.buf_len(&nb))
    io.print_line("")
    if (*t).fails != 0 {
        return 1 as i32
    }
    return 0
}

fn dec(z: str, max: usize, out: *mut rt.Buf) -> u32 {
    code = 0
    brotli.brotli_decompress_limited(z.p as u64, z.length(), max, out) catch | e | (why(e))
    return code
}

fn decodes_to(t: *mut Tally, what: str, z: str, want: str) {
    var out: rt.Buf = rt.buf_new()
    let c: u32 = dec(z, 0, &out)
    check(t, what, c == 0 as u32 && is_plain(&out, want))
    rt.buf_free(&out)
}

fn stream_dec(path: str, z: str, piece: usize, out: *mut rt.Buf) -> u32 {
    code = 0
    fs.write_file(path, z.p as u64, z.length()) catch 0
    let fd: i64 = fs.open_read(path) catch -1
    if fd < 0 {
        return 99 as u32
    }
    var d: brotli.BrDec = brotli.brotli_dec_open_fd(fd)
    let tmp: u64 = rt.heap_alloc(piece)
    while true {
        let k: usize = brotli.brotli_dec_read(&d, tmp, piece) catch | e | (why(e))
        if code != 0 as u32 || k == 0 {
            break
        }
        rt.buf_push_bytes(out, tmp, k)
    }
    rt.heap_free(tmp, piece)
    brotli.brotli_dec_close(&d)
    fs.close_fd(fd)
    return code
}

fn main() -> i32 {
    var t: Tally = Tally { total: 0, fails: 0 }
    let path: str = scratch("br2184")

    decodes_to(&t, "quality 5", F_Q5, PLAIN)
    decodes_to(&t, "quality 11", F_Q11, PLAIN)
    decodes_to(&t, "quality 9, text mode", F_TEXT9, PLAIN)
    decodes_to(&t, "quality 1 with a 1 KiB window (distances beyond it are dictionary words)", F_LGWIN10, PLAIN)
    decodes_to(&t, "English words from the static dictionary (transforms)", F_WORDS, WORDS)
    decodes_to(&t, "an empty stream (one octet)", F_EMPTY, "")
    decodes_to(&t, "an empty stream built by hand", F_TINY, "")
    decodes_to(&t, "stored and metadata meta-blocks, WBITS 24", F_STORED, STORED)
    var o: rt.Buf = rt.buf_new()
    // the compressed forms really are smaller (the dictionary is doing work)
    check(&t, "the dictionary stream is much smaller than its text", F_WORDS.length() * 4 < WORDS.length())
    // refusals
    check(&t, "the large window extension is Unsupported", dec("\x11\x00\x00\x00", 0, &o) == 7 as u32)
    rt.buf_clear(&o)
    check(&t, "empty input is Truncated", dec("", 0, &o) == 4 as u32)
    var cuts: usize = 0
    var bad: usize = 0
    var c: usize = 0
    while c < F_Q11.length() {
        rt.buf_clear(&o)
        cuts = cuts + 1
        if dec(str { p: F_Q11.p, n: c }, 0, &o) == 0 as u32 {
            bad = bad + 1
        }
        c = c + 37
    }
    check(&t, "every cut of a stream is refused", bad == 0 && cuts > 100)
    var dmg: rt.Buf = rt.buf_new()
    var k: usize = 0
    var crash_free: usize = 0
    while k < 120 {
        rt.buf_clear(&dmg)
        rt.buf_push_bytes(&dmg, F_Q11.p as u64, F_Q11.length())
        let at: usize = (k * 97) % F_Q11.length()
        rt.st8(rt.buf_ptr(&dmg), at, rt.ld8(rt.buf_ptr(&dmg), at) ^ ((1 + k % 7) as u8))
        rt.buf_clear(&o)
        dec(view(&dmg), 0, &o)
        crash_free = crash_free + 1
        k = k + 1
    }
    check(&t, "damaged streams: an answer or an error, no crash (Brotli has no checksum)", crash_free == 120)
    rt.buf_free(&dmg)
    rt.buf_clear(&o)
    check(&t, "limit == size passes", dec(F_Q11, PLAIN.length(), &o) == 0 as u32 && is_plain(&o, PLAIN))
    rt.buf_clear(&o)
    check(&t, "limit == size - 1 is TooLarge, nothing past it written",
        dec(F_Q11, PLAIN.length() - 1, &o) == 5 as u32 && rt.buf_len(&o) <= PLAIN.length() - 1)
    rt.buf_clear(&o)
    check(&t, "stored data under a limit of 100", dec(F_STORED, 100, &o) == 5 as u32 && rt.buf_len(&o) <= 100)
    // streaming
    var pieces: [usize; 4] = [1, 19, 4096, 100000]
    var pi: usize = 0
    while pi < 4 {
        var s2: rt.Buf = rt.buf_new()
        check(&t, "stream-decode quality 11", stream_dec(path, F_Q11, pieces[pi], &s2) == 0 as u32 && is_plain(&s2, PLAIN))
        rt.buf_clear(&s2)
        check(&t, "stream-decode dictionary words", stream_dec(path, F_WORDS, pieces[pi], &s2) == 0 as u32 && is_plain(&s2, WORDS))
        rt.buf_clear(&s2)
        check(&t, "stream-decode stored + metadata", stream_dec(path, F_STORED, pieces[pi], &s2) == 0 as u32 && is_plain(&s2, STORED))
        rt.buf_free(&s2)
        pi = pi + 1
    }
    rt.buf_free(&o)
    fs.remove(path) catch false
    return finish(&t)
}
