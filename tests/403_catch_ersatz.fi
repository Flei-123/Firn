// expect_exit: 0
// 'catch' liefert den Ersatzwert; der Ersatz darf ein beliebiger Ausdruck sein.
error E { A, B }

fn quelle(n: i32) -> E!i32 {
    if n == 0 {
        return E::A
    }
    return n
}

fn ersatz() -> i32 {
    return 77
}

fn main() -> i32 {
    if (quelle(5) catch ersatz()) != 5 {
        return 1
    }
    if (quelle(0) catch ersatz()) != 77 {
        return 2
    }
    if (quelle(0) catch (quelle(4) catch 0)) != 4 {
        return 3
    }
    if (quelle(0) catch 1 + 2 * 3) != 7 {
        return 4
    }
    return 0
}
