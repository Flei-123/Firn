// expect_exit: 0
// tests/2066_std_pool_portable.fi -- std.pool on Linux AND Windows: the same
// results (on Windows the jobs run inside `submit`, one at a time).
//
// A  the results of 5000 jobs arrive, each exactly once
// C  a queue of 4 with 2000 jobs: nothing is lost
// D  jobs that allocate in the garbage collected heap (strings)
// F  shutdown and a second pool afterwards
import std.rt
import std.str
import std.pool

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == pool.WORKER_KIND {
        return pool.worker_main(arg)
    }
    return 0
}

fn now_ms() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] * 1000 + ts[1] / 1000000) as u64
}

fn square(i: u64) -> u64 {
    return i * i
}

fn slow(i: u64) -> u64 {
    var ts: [i64; 2] = [0, 100000000]
    syscall(35, (&ts[0]) as i64, 0, 0, 0, 0, 0)
    return i + 1
}

// jobs record their index in a shared table (address in a static)
static mut seen_table: u64 = 0
static mut order_table: u64 = 0
static mut order_next: u64 = 0

fn mark(i: u64) -> u64 {
    __atomic_add((seen_table + i * 8) as *mut u64, 1)
    return i
}

fn alloc_job(i: u64) -> u64 {
    // garbage collected strings, many and short lived
    var s: str = "job"
    var k: u64 = 0
    while k < 20 {
        s = s + "x"
        k = k + 1
    }
    return s.length() as u64 + i
}

fn ordered(i: u64) -> u64 {
    let at: u64 = order_next
    rt.st64(order_table, at as usize, i)
    order_next = at + 1
    return 0
}

fn main() -> i32 {
    // --- A. 5000 jobs
    var p: pool.Pool = pool.pool_new(4, 64)
    if p.blk == 0 { return 1 as i32 }
    // 4 worker threads on Linux, 0 where there are no threads (the jobs then run inside `submit`)
    if pool.worker_count(&p) != 4 && pool.worker_count(&p) != 0 { return 2 as i32 }
    let n: usize = 5000
    seen_table = rt.heap_alloc(n * 8)
    rt.mem_set(seen_table, 0 as u8, n * 8)
    var handles: u64 = rt.heap_alloc(n * 8)
    var i: usize = 0
    while i < n {
        let j: u64 = pool.submit(&p, square, i as u64)
        if j == 0 { return 3 as i32 }
        rt.st64(handles, i, j)
        i = i + 1
    }
    pool.wait_idle(&p)
    if pool.pending(&p) != 0 { return 4 as i32 }
    if pool.completed(&p) != n as u64 { return 5 as i32 }
    i = 0
    while i < n {
        let j: u64 = rt.ld64(handles, i)
        if !pool.job_done(j) { return 6 as i32 }
        if pool.job_result(j) != (i * i) as u64 { return 7 as i32 }
        pool.job_free(&p, j)
        i = i + 1
    }
    // every job ran exactly once
    i = 0
    while i < n {
        let jj: u64 = pool.submit(&p, mark, i as u64)
        rt.st64(handles, i, jj)
        i = i + 1
    }
    pool.wait_idle(&p)
    i = 0
    while i < n {
        if rt.ld64(seen_table, i) != 1 { return 8 as i32 }
        pool.job_free(&p, rt.ld64(handles, i))
        i = i + 1
    }
    pool.shutdown(&p)
    if p.blk != 0 { return 9 as i32 }

    // --- C. tiny queue, many jobs: submit blocks, nothing is lost
    p = pool.pool_new(2, 4)
    if p.blk == 0 { return 13 as i32 }
    var args: u64 = rt.heap_alloc(2000 * 8)
    var results: u64 = rt.heap_alloc(2000 * 8)
    i = 0
    while i < 2000 {
        rt.st64(args, i, i as u64)
        i = i + 1
    }
    if !pool.run_all(&p, square, args, 2000, results) { return 14 as i32 }
    i = 0
    while i < 2000 {
        if rt.ld64(results, i) != (i * i) as u64 { return 15 as i32 }
        i = i + 1
    }
    pool.shutdown(&p)

    // --- D. GC allocation on the workers
    p = pool.pool_new(4, 32)
    if p.blk == 0 { return 16 as i32 }
    i = 0
    while i < 2000 {
        rt.st64(args, i, i as u64)
        i = i + 1
    }
    if !pool.run_all(&p, alloc_job, args, 2000, results) { return 17 as i32 }
    i = 0
    while i < 2000 {
        if rt.ld64(results, i) != 23 + i as u64 { return 18 as i32 }
        i = i + 1
    }
    pool.shutdown(&p)

    // --- F. again after shutdown
    p = pool.pool_new(3, 8)
    if p.blk == 0 { return 21 as i32 }
    i = 0
    while i < 100 {
        rt.st64(args, i, i as u64)
        i = i + 1
    }
    if !pool.run_all(&p, square, args, 100, results) { return 22 as i32 }
    if rt.ld64(results, 99) != 9801 { return 23 as i32 }
    pool.shutdown(&p)
    return 0
}
