// expect_exit: 0
// tests/5480_barcode.fi -- lib/barcode: encoders, scanline decoder on pictures, Data Matrix round trip with damaged modules.
// Cross-checks against python-barcode, zxing-cpp and libdmtx live in tools/barcode/run.sh.
import barcode.bcutil
import barcode.ean
import barcode.code128
import barcode.code39
import barcode.itf
import barcode.scan
import barcode.gray
import barcode.dmtx
import std.rt
import std.io

static mut bad: i32 = 0

fn fail(what: str) {
    io.print_line(what)
    bad = bad + 1
}

fn scan_modules(m: *mut rt.Buf, scale: usize, rot: bool, want_kind: u32, want: str, name: str) {
    let quiet: usize = 12
    let w: usize = (rt.buf_len(m) + quiet * 2) * scale
    let h: usize = 60
    let g: u64 = rt.heap_alloc(w * h + 1)
    let row: u64 = rt.heap_alloc(w + 1)
    let n: usize = gray.gray_render_row(m, scale, quiet, row)
    var y: usize = 0
    while y < h {
        rt.mem_copy(g + (y * w) as u64, row, n)
        y++
    }
    var res: bcutil.BcResult = bcutil.bc_result_new()
    let ok: bool = scan.bcscan_gray(g, w, h, &res)
    if !ok {
        fail(name)
    } else {
        if res.kind != want_kind || rt.buf_len(&res.text) != want.n || !rt.mem_eq(rt.buf_ptr(&res.text), want.p as u64, want.n) {
            fail(name)
        }
    }
    bcutil.bc_result_free(&res)
    rt.heap_free(row, w + 1)
    gray.gray_free(g, w, h)
}

fn check_ean() {
    var m: rt.Buf = rt.buf_new()
    let ok: bool = ean.ean_encode("400638133393", bcutil.BC_EAN13, &m) catch false
    if !ok || rt.buf_len(&m) != 95 {
        fail("ean13 encode")
    }
    scan_modules(&m, 3, false, bcutil.BC_EAN13, "4006381333931", "ean13 scan")
    let ok2: bool = ean.ean_encode("9638507", bcutil.BC_EAN8, &m) catch false
    if !ok2 || rt.buf_len(&m) != 67 {
        fail("ean8 encode")
    }
    scan_modules(&m, 2, false, bcutil.BC_EAN8, "96385074", "ean8 scan")
    let ok3: bool = ean.ean_encode("03600029145", bcutil.BC_UPCA, &m) catch false
    if !ok3 {
        fail("upca encode")
    }
    scan_modules(&m, 3, false, bcutil.BC_UPCA, "036000291452", "upca scan")
    let bad_check: bool = ean.ean_encode("4006381333932", bcutil.BC_EAN13, &m) catch false
    if bad_check {
        fail("ean13 wrong check digit accepted")
    }
    rt.buf_free(&m)
}

fn check_code128() {
    var m: rt.Buf = rt.buf_new()
    let t: str = "Hello World 123"
    let ok: bool = code128.code128_encode(t.p as u64, t.n, 0 as u32, &m) catch false
    if !ok {
        fail("code128 encode")
    }
    scan_modules(&m, 2, false, bcutil.BC_CODE128, "Hello World 123", "code128 scan")
    let d: str = "12345678"
    let ok2: bool = code128.code128_encode(d.p as u64, d.n, 0 as u32, &m) catch false
    if !ok2 || rt.buf_len(&m) != 11 * 6 + 13 {
        fail("code128 set C length")
    }
    scan_modules(&m, 3, false, bcutil.BC_CODE128, "12345678", "code128 digits scan")
    rt.buf_free(&m)
}

fn check_code39_itf() {
    var m: rt.Buf = rt.buf_new()
    let t: str = "FIRN-39 $/+%"
    let ok: bool = code39.code39_encode(t.p as u64, t.n, false, &m) catch false
    if !ok {
        fail("code39 encode")
    }
    scan_modules(&m, 3, false, bcutil.BC_CODE39, "FIRN-39 $/+%", "code39 scan")
    let ok2: bool = itf.itf_encode("0123456789", &m) catch false
    if !ok2 {
        fail("itf encode")
    }
    scan_modules(&m, 3, false, bcutil.BC_ITF, "0123456789", "itf scan")
    let odd: bool = itf.itf_encode("123", &m) catch false
    if odd {
        fail("itf odd length accepted")
    }
    rt.buf_free(&m)
}

fn check_dm(text: str, mode: u32, shape: u32, name: str, flips: i64) {
    var m: rt.Buf = rt.buf_new()
    var rows: i64 = 0
    var cols: i64 = 0
    let ok: bool = dmtx.dmtx_encode(text.p as u64, text.n, mode, shape, &m, &rows, &cols) catch false
    if !ok {
        fail(name)
        rt.buf_free(&m)
        return
    }
    var k: i64 = 0
    while k < flips {
        let idx: usize = ((k * 37 + 11) % (rows * cols)) as usize
        let r: i64 = (idx as i64) / cols
        let c: i64 = (idx as i64) % cols
        if r > 0 && c > 0 && r < rows - 1 && c < cols - 1 {
            rt.st8(rt.buf_ptr(&m), idx, 1 as u8 - rt.buf_at(&m, idx))
        }
        k = k + 1
    }
    var res: rt.Buf = rt.buf_new()
    var fixed: i64 = 0
    let got: bool = dmtx.dmtx_decode_any(rt.buf_ptr(&m), rows, cols, &res, &fixed)
    if !got || rt.buf_len(&res) != text.n || !rt.mem_eq(rt.buf_ptr(&res), text.p as u64, text.n) {
        fail(name)
    }
    rt.buf_free(&res)
    rt.buf_free(&m)
}

fn main() -> i32 {
    check_ean()
    check_code128()
    check_code39_itf()
    check_dm("A", DM_ASCII(), 0 as u32, "dm 1 char", 0)
    check_dm("Hello, Data Matrix!", DM_ASCII(), 0 as u32, "dm text", 0)
    check_dm("0123456789012345678901234567890123456789", DM_ASCII(), 0 as u32, "dm digits", 4)
    check_dm("The quick brown fox jumps over the lazy dog 0123456789 The quick brown fox jumps over the lazy dog", DM_ASCII(), 0 as u32, "dm long damaged", 5)
    check_dm("rect symbol", DM_ASCII(), 2 as u32, "dm rect", 0)
    check_dm("binary \u{e9}\u{e8} data", 1 as u32, 0 as u32, "dm base256", 0)
    if bad != 0 {
        return 1
    }
    io.print_line("barcode ok")
    return 0
}

fn DM_ASCII() -> u32 {
    return 0 as u32
}
