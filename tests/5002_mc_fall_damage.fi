// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_audio
import mc.mc_effect

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn effect_body(eid: i32, id: i32, amp: i32) -> bytes.Bytes {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, eid)
    bytes.put_varint(&b, id)
    bytes.put_i8(&b, amp as i8)
    bytes.put_varint(&b, 100)
    bytes.put_u8(&b, 0 as u8)
    bytes.bytes_set_pos(&b, 0)
    return b
}

fn main() -> i32 {
    check(mc_audio.mca_fall_damage(3.0, 0, 1.0) == 0, 1)
    check(mc_audio.mca_fall_damage(3.5, 0, 1.0) == 1, 2)
    check(mc_audio.mca_fall_damage(7.0, 0, 1.0) == 4, 3)
    check(mc_audio.mca_fall_damage(7.5, 0, 1.0) == 5, 4)
    check(mc_audio.mca_fall_damage(5.0, 2, 1.0) == 0, 5)
    check(mc_audio.mca_fall_damage(5.5, 2, 1.0) == 1, 6)
    check(mc_audio.mca_fall_damage(20.0, 0, 0.2) == 4, 7)
    check(mc_audio.mca_fall_damage(7.0, 0, 0.2) == 1, 8)
    check(mc_audio.mca_fall_damage(20.0, 0, 0.0) == 0, 9)
    check(mc_audio.mca_fall_damage(8.0, 0, 0.5) == 3, 10)
    check(mc_effect.fx_jump_id(763) == 8 && mc_effect.fx_jump_id(764) == 7, 11)
    check(mc_effect.fx_slow_fall_id(763) == 28 && mc_effect.fx_slow_fall_id(764) == 27, 12)
    var f: mc_effect.Fx = mc_effect.fx_new()
    mc_effect.fx_set_own(&f, 5)
    var b: bytes.Bytes = effect_body(5, 8, 1)
    check(mc_effect.fx_on_effect(&f, 763, &b), 13)
    check(mc_effect.fx_jump(&f) == 2 && mc_effect.fx_slow_fall(&f) == 0, 14)
    var b2: bytes.Bytes = effect_body(5, 28, 0)
    check(mc_effect.fx_on_effect(&f, 763, &b2), 15)
    check(mc_effect.fx_slow_fall(&f) == 1, 16)
    var b3: bytes.Bytes = effect_body(6, 8, 3)
    check(!mc_effect.fx_on_effect(&f, 763, &b3), 17)
    check(mc_effect.fx_jump(&f) == 2, 18)
    var b4: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b4, 5)
    bytes.put_varint(&b4, 8)
    bytes.bytes_set_pos(&b4, 0)
    check(mc_effect.fx_on_remove(&f, 763, &b4), 19)
    check(mc_effect.fx_jump(&f) == 0, 20)
    return 0
}
