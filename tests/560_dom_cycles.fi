// expect_exit: 0
// Acceptance item 2 (FIRN-ANFORDERUNGEN.md 13): the DOM prototype with REAL
// cycles -- parent/child strong in both directions, listener <-> node,
// JS wrapper <-> node, a live collection on its root -- and the
// counter-check that a weak observer does NOT keep its target alive.
//
// The soak run with memory measurement is in tools/dom_soak/run.sh; here the
// structure is checked, there the behaviour over many cycles.
import modules.dom

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    // cycle kinds 1, 2, 3, 4 and 6
    let a: i32 = dom.dom_self_test()
    if a != 0 {
        return a
    }
    // cycle kind 5: GcWeak does not hold
    let b: i32 = dom.dom_observer_test()
    if b != 0 {
        return 50 + b
    }
    // One set from the soak run really creates seven objects ...
    let n: u64 = dom.dom_cycle_build() catch 0
    if n != dom.DOM_OBJECTS_PER_SET {
        return 80
    }
    // ... and survives no collection once it is unreachable.
    dom.dom_cycle_discard()
    gc_collect()
    let live: u64 = gc_live_objects()

    // 200 further sets = 1400 objects; the consumption must not grow.
    var i: u64 = 0
    while i < 200 {
        let m: u64 = dom.dom_cycle_build() catch 0
        if m != dom.DOM_OBJECTS_PER_SET {
            return 81
        }
        i = i + 1
    }
    dom.dom_cycle_discard()
    gc_collect()
    // After 201 sets no more objects may be alive than after the first one
    // (plus the few accidental hits of the conservative stack scan).
    if gc_live_objects() > live + 8 {
        return 82
    }
    if gc_heap_bytes() > 4194304 {
        return 83
    }
    return 0
}
