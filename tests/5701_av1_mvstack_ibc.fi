// expect_exit: 42
import av1.av1ibc
import av1.av1mvp
import av1.av1mem

struct Rng {
    s: i64,
}

struct World {
    ibc: u64,
    mvp: u64,
    rng: Rng,
    mc: i64,
    mr: i64,
    blocks: i64,
    compared: i64,
    bad: i64,
}

fn rng_next(r: *mut Rng) -> i64 {
    (*r).s = ((*r).s * 1103515245 + 12345) & 2147483647
    return (*r).s >> 8
}

fn size_of(bw4: i64, bh4: i64) -> i64 {
    var s: i64 = 0
    while s < 22 {
        if av1ibc.ibc_mis_w4(s) == bw4 && av1ibc.ibc_mis_h4(s) == bh4 {
            return s
        }
        s = s + 1
    }
    return 0 - 1
}

fn compare_stacks(w: *mut World, r: i64, c: i64, size: i64) -> bool {
    av1ibc.ibc_find((*w).ibc, r, c, size)
    let rc: i64 = av1mvp.mvp_find((*w).mvp, r, c, size, 0, 0 - 1)
    if rc != 0 {
        return false
    }
    let found: i64 = av1ibc.ibc_num((*w).ibc)
    if av1mvp.mvp_num((*w).mvp) != found {
        return false
    }
    var i: i64 = 0
    while i < found {
        if av1mvp.mvp_weight((*w).mvp, i) != av1ibc.ibc_stack_weight((*w).ibc, i) {
            return false
        }
        i = i + 1
    }
    i = 0
    while i < 2 {
        if av1mvp.mvp_stack_mv((*w).mvp, i, 0, 0) != av1ibc.ibc_stack_mv((*w).ibc, i, 0) || av1mvp.mvp_stack_mv((*w).mvp, i, 0, 1) != av1ibc.ibc_stack_mv((*w).ibc, i, 1) {
            return false
        }
        i = i + 1
    }
    return true
}

fn place(w: *mut World, r: i64, c: i64, size: i64) {
    if r >= (*w).mr || c >= (*w).mc {
        return
    }
    if !compare_stacks(w, r, c, size) {
        (*w).bad = (*w).bad + 1
    }
    (*w).compared = (*w).compared + 1
    let bw4: i64 = av1ibc.ibc_mis_w4(size)
    let bh4: i64 = av1ibc.ibc_mis_h4(size)
    let pick: i64 = rng_next(&(*w).rng) % 8
    var kind: i64 = 1
    var mvr: i64 = 0
    var mvc: i64 = 0
    var isint: i64 = 0
    if pick >= 3 {
        kind = 2
        isint = 1
        mvr = ((rng_next(&(*w).rng) % 11) - 5) * 8
        mvc = ((rng_next(&(*w).rng) % 11) - 5) * 8
        if pick == 7 {
            mvr = 0
            mvc = 0
        }
    }
    av1ibc.ibc_store((*w).ibc, r, c, bw4, bh4, kind, mvr, mvc)
    av1mvp.mvp_store((*w).mvp, r, c, size, isint, 0, 0 - 1, 0, mvr, mvc, 0, 0)
    (*w).blocks = (*w).blocks + 1
}

fn partition(w: *mut World, r: i64, c: i64, n4: i64) {
    if r >= (*w).mr || c >= (*w).mc {
        return
    }
    let pick: i64 = rng_next(&(*w).rng) % 10
    if n4 == 1 || pick < 2 {
        place(w, r, c, size_of(n4, n4))
        return
    }
    let h: i64 = n4 / 2
    if pick < 4 && n4 >= 2 {
        place(w, r, c, size_of(n4, h))
        place(w, r + h, c, size_of(n4, h))
        return
    }
    if pick < 6 && n4 >= 2 {
        place(w, r, c, size_of(h, n4))
        place(w, r, c + h, size_of(h, n4))
        return
    }
    partition(w, r, c, h)
    partition(w, r, c + h, h)
    partition(w, r + h, c, h)
    partition(w, r + h, c + h, h)
}

fn run_world(seed: i64, mr: i64, mc: i64, r0: i64, r1: i64, c0: i64, c1: i64) -> i32 {
    let mn: i64 = mr * mc
    let kind: u64 = av1mem.heap_alloc(mn as usize) as u64
    let mvs: u64 = av1mem.heap_alloc((mn * 4) as usize) as u64
    let mis: u64 = av1mem.heap_alloc(mn as usize) as u64
    let icdf: u64 = av1mem.heap_alloc(256) as u64
    let ibc: u64 = av1mem.heap_alloc((av1ibc.IBC_CELLS * 8) as usize) as u64
    av1ibc.ibc_bind(ibc, kind, mvs, mis, icdf, mc, mr)
    av1ibc.ibc_set_tile(ibc, r0, r1, c0, c1)
    av1ibc.ibc_set_sb(ibc, 0)
    let mvp: u64 = av1mem.heap_alloc((av1mvp.MVP_CELLS * 8) as usize) as u64
    let rf0: u64 = av1mem.heap_alloc(mn as usize) as u64
    let rf1: u64 = av1mem.heap_alloc(mn as usize) as u64
    let isint: u64 = av1mem.heap_alloc(mn as usize) as u64
    let ymode: u64 = av1mem.heap_alloc(mn as usize) as u64
    let mv0: u64 = av1mem.heap_alloc((mn * 4) as usize) as u64
    let mv1: u64 = av1mem.heap_alloc((mn * 4) as usize) as u64
    av1mvp.mvp_bind(mvp, rf0, rf1, isint, mis, ymode, mv0, mv1, mc, mr)
    av1mvp.mvp_set_tile(mvp, r0, r1, c0, c1)
    av1mvp.mvp_set_frame(mvp, 0, 1, 0)
    var w: World = World { ibc: ibc, mvp: mvp, rng: Rng { s: seed }, mc: mc, mr: mr, blocks: 0, compared: 0, bad: 0 }
    var sr: i64 = r0
    while sr < r1 {
        var sc: i64 = c0
        while sc < c1 {
            partition(&w, sr, sc, 16)
            sc = sc + 16
        }
        sr = sr + 16
    }
    if w.bad != 0 {
        return 1
    }
    if w.compared < 4 {
        return 2
    }
    return 0
}

fn main() -> i32 {
    var seed: i64 = 1
    while seed <= 40 {
        let a: i32 = run_world(seed * 104729, 48, 64, 0, 48, 0, 64)
        if a != 0 {
            return 10 + a
        }
        let b: i32 = run_world(seed * 1299709, 48, 64, 16, 48, 16, 48)
        if b != 0 {
            return 20 + b
        }
        seed = seed + 1
    }
    return 42
}
