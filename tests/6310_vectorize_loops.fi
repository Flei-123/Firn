// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.vec

fn sum64(v: *mut Vec[i64]) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < vec_len[i64](v) {
        s = s + v[i]
        i = i + 1
    }
    return s
}

fn sum64_ref(v: *mut Vec[i64], stop: i64) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < vec_len[i64](v) {
        if stop != 0 { break }
        s = s + v[i]
        i = i + 1
    }
    return s
}

fn pairs64(v: *mut Vec[i64]) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i + 1 < vec_len[i64](v) {
        s = s + (v[i] ^ v[i + 1])
        i = i + 1
    }
    return s
}

fn pairs64_ref(v: *mut Vec[i64], stop: i64) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i + 1 < vec_len[i64](v) {
        if stop != 0 { break }
        s = s + (v[i] ^ v[i + 1])
        i = i + 1
    }
    return s
}

fn xor32(v: *mut Vec[i32]) -> i32 {
    var s: i32 = 77
    var i: usize = 0
    while i < vec_len[i32](v) {
        s = s ^ v[i]
        i = i + 1
    }
    return s
}

fn xor32_ref(v: *mut Vec[i32], stop: i64) -> i32 {
    var s: i32 = 77
    var i: usize = 0
    while i < vec_len[i32](v) {
        if stop != 0 { break }
        s = s ^ v[i]
        i = i + 1
    }
    return s
}

fn andor32(v: *mut Vec[u32]) -> u32 {
    var a: u32 = 0xFFFFFFFF
    var o: u32 = 0
    var i: usize = 0
    while i < vec_len[u32](v) {
        a = a & v[i]
        o = o | v[i]
        i = i + 1
    }
    return a ^ (o << 1)
}

fn andor32_ref(v: *mut Vec[u32], stop: i64) -> u32 {
    var a: u32 = 0xFFFFFFFF
    var o: u32 = 0
    var i: usize = 0
    while i < vec_len[u32](v) {
        if stop != 0 { break }
        a = a & v[i]
        o = o | v[i]
        i = i + 1
    }
    return a ^ (o << 1)
}

fn scale64(v: *mut Vec[i64]) {
    for i in 0..vec_len[i64](v) {
        (*v)[i] = ((*v)[i] ^ 5) + 1
    }
}

fn scale64_ref(v: *mut Vec[i64], stop: i64) {
    var i: usize = 0
    while i < vec_len[i64](v) {
        if stop != 0 { break }
        (*v)[i] = ((*v)[i] ^ 5) + 1
        i = i + 1
    }
}

fn add_into(dst: *mut Vec[i64], src: *mut Vec[i64]) {
    var i: usize = 0
    while i < vec_len[i64](dst) && i < vec_len[i64](src) {
        (*dst)[i] = (*dst)[i] + (*src)[i]
        (*dst)[i] = (*dst)[i] ^ (*src)[i]
        i = i + 1
    }
}

fn add_into_ref(dst: *mut Vec[i64], src: *mut Vec[i64], stop: i64) {
    var i: usize = 0
    while i < vec_len[i64](dst) && i < vec_len[i64](src) {
        if stop != 0 { break }
        (*dst)[i] = (*dst)[i] + (*src)[i]
        (*dst)[i] = (*dst)[i] ^ (*src)[i]
        i = i + 1
    }
}

fn fill_vec64(v: *mut Vec[i64], n: usize, seed: i64) {
    var k: usize = 0
    var x: i64 = seed
    while k < n {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        vec_push[i64](v, (x & 1048575) - 500000)
        k = k + 1
    }
}

fn fill_vec32(v: *mut Vec[i32], n: usize, seed: i32) {
    var k: usize = 0
    var x: i32 = seed
    while k < n {
        x = x ^ (x << 13)
        x = x ^ (x >> 17)
        x = x ^ (x << 5)
        vec_push[i32](v, (x & 1048575) - 500000)
        k = k + 1
    }
}

fn fill_vecu32(v: *mut Vec[u32], n: usize, seed: u32) {
    var k: usize = 0
    var x: u32 = seed
    while k < n {
        x = x ^ (x << 13)
        x = x ^ (x >> 17)
        x = x ^ (x << 5)
        vec_push[u32](v, x | 0x80000001)
        k = k + 1
    }
}

fn same64(a: *mut Vec[i64], b: *mut Vec[i64]) -> bool {
    if vec_len[i64](a) != vec_len[i64](b) { return false }
    var i: usize = 0
    while i < vec_len[i64](a) {
        if (*a)[i] != (*b)[i] { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var n: usize = 0
    while n < 41 {
        var a: Vec[i64] = vec_new[i64]()
        fill_vec64(&a, n, 12345 + (n as i64))
        if sum64(&a) != sum64_ref(&a, 0) { return 10 }
        if pairs64(&a) != pairs64_ref(&a, 0) { return 11 }

        var b: Vec[i32] = vec_new[i32]()
        fill_vec32(&b, n, 99 + (n as i32))
        if xor32(&b) != xor32_ref(&b, 0) { return 12 }

        var c: Vec[u32] = vec_new[u32]()
        fill_vecu32(&c, n, 7 + (n as u32))
        if andor32(&c) != andor32_ref(&c, 0) { return 13 }

        var d1: Vec[i64] = vec_new[i64]()
        var d2: Vec[i64] = vec_new[i64]()
        fill_vec64(&d1, n, 555)
        fill_vec64(&d2, n, 555)
        scale64(&d1)
        scale64_ref(&d2, 0)
        if !same64(&d1, &d2) { return 14 }

        var e1: Vec[i64] = vec_new[i64]()
        var e2: Vec[i64] = vec_new[i64]()
        var s1: Vec[i64] = vec_new[i64]()
        fill_vec64(&e1, n, 31)
        fill_vec64(&e2, n, 31)
        fill_vec64(&s1, n + 3, 77)
        add_into(&e1, &s1)
        add_into_ref(&e2, &s1, 0)
        if !same64(&e1, &e2) { return 15 }

        var f1: Vec[i64] = vec_new[i64]()
        var f2: Vec[i64] = vec_new[i64]()
        fill_vec64(&f1, n, 41)
        fill_vec64(&f2, n, 41)
        add_into(&f1, &f1)
        add_into_ref(&f2, &f2, 0)
        if !same64(&f1, &f2) { return 16 }

        n = n + 1
    }
    return 0
}
