// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
// tests/2150_oauth_jose.fi -- lib/auth/jose.fi against 54 tokens signed by
// Python's `cryptography` package (tools/oauth/gen_vectors.py): RS256/384/512,
// ES256/384, HS256, and the hostile variants -- alg none, the RS256-to-HS256
// confusion, a key of the wrong kind or kid, tampered payload and signature,
// expired / not yet valid / wrong issuer, audience, nonce, broken shapes.
// The JWKS has eight entries of which three are usable (an `enc` key, a
// 512-bit RSA key, an `oct` key, an EC key with a short coordinate and an
// Ed25519 key must be skipped).
import std.rt
import std.io
import std.json
import std.str
import auth.jose

const VECTORS: str = __include_str("data/oauth-vectors.json")

fn sp(s: str.Span) -> str {
    return str { p: s.p, n: s.n }
}

fn get(d: *mut json.Json, obj: u32, name: str) -> u32 {
    return json.json_get(d, obj, name.p as u64, name.length())
}

fn gstr(d: *mut json.Json, obj: u32, name: str) -> str {
    let n: u32 = get(d, obj, name)
    if n == json.JSON_NONE || json.json_kind(d, n) != json.JSON_STRING {
        return ""
    }
    return sp(json.json_string(d, n))
}

fn gint(d: *mut json.Json, obj: u32, name: str, dflt: i64) -> i64 {
    let n: u32 = get(d, obj, name)
    if n == json.JSON_NONE || json.json_kind(d, n) != json.JSON_NUMBER {
        return dflt
    }
    return json.json_int(d, n)
}

// the whole JSON value at `node` written out again (a JWKS goes into jwks_parse as text)
fn node_text(d: *mut json.Json, node: u32, out: *mut rt.Buf) {
    rt.buf_clear(out)
    json.json_write(d, node, out, false)
}

fn alg_mask(d: *mut json.Json, pol: u32) -> u32 {
    let n: u32 = get(d, pol, "algs")
    if n == json.JSON_NONE {
        return jose.ALGS_DEFAULT
    }
    var mask: u32 = 0 as u32
    var c: u32 = json.json_child(d, n)
    while c != json.JSON_NONE {
        let a: str = sp(json.json_string(d, c))
        if a == "HS256" { mask = mask | (1 as u32 << jose.ALG_HS256) }
        if a == "RS256" { mask = mask | (1 as u32 << jose.ALG_RS256) }
        if a == "RS384" { mask = mask | (1 as u32 << jose.ALG_RS384) }
        if a == "RS512" { mask = mask | (1 as u32 << jose.ALG_RS512) }
        if a == "ES256" { mask = mask | (1 as u32 << jose.ALG_ES256) }
        if a == "ES384" { mask = mask | (1 as u32 << jose.ALG_ES384) }
        c = json.json_next(d, c)
    }
    return mask
}

fn main() -> i32 {
    var d: json.Json = json.json_new()
    let ok: bool = json.json_parse(&d, VECTORS.p as u64, VECTORS.length()) catch false
    if !ok { io.print_line("FAIL vectors are not JSON"); return 1 as i32 }
    let root: u32 = json.json_root(&d)
    let now: i64 = gint(&d, root, "now", 0)
    let secret: str = gstr(&d, root, "secret")
    var fails: i32 = 0

    var jtext: rt.Buf = rt.buf_new()
    node_text(&d, get(&d, root, "jwks"), &jtext)
    var base: jose.Jwks = jose.jwks_new()
    let nk: i64 = jose.jwks_parse(&base, str { p: rt.buf_data(&jtext), n: jtext.len })
    if nk != gint(&d, root, "expected_keys", 3) {
        io.print_line("FAIL the usable keys of the JWKS: not the expected number")
        fails = fails + 1
    }
    if !jose.jwks_has_kid(&base, "rsa1") || !jose.jwks_has_kid(&base, "ec256") || !jose.jwks_has_kid(&base, "ec384") {
        io.print_line("FAIL a usable key is missing")
        fails = fails + 1
    }
    if jose.jwks_has_kid(&base, "enc1") || jose.jwks_has_kid(&base, "tiny") || jose.jwks_has_kid(&base, "oct1") ||
    jose.jwks_has_kid(&base, "badlen") || jose.jwks_has_kid(&base, "ed") {
        io.print_line("FAIL a key that must be skipped was kept")
        fails = fails + 1
    }
    jose.jwks_free(&base)

    // texts that are no JWKS
    let bad: u32 = get(&d, root, "jwks_bad")
    var b: u32 = json.json_child(&d, bad)
    while b != json.JSON_NONE {
        var kz: jose.Jwks = jose.jwks_new()
        if jose.jwks_parse(&kz, sp(json.json_string(&d, b))) != -1 {
            io.print_line("FAIL a non-JWKS was accepted")
            fails = fails + 1
        }
        jose.jwks_free(&kz)
        b = json.json_next(&d, b)
    }

    let cases: u32 = get(&d, root, "cases")
    var c: u32 = json.json_child(&d, cases)
    var count: i32 = 0
    while c != json.JSON_NONE {
        let name: str = gstr(&d, c, "name")
        let tok: str = gstr(&d, c, "token")
        let expect: str = gstr(&d, c, "expect")
        let pol: u32 = get(&d, c, "policy")
        var keys: jose.Jwks = jose.jwks_new()
        if gstr(&d, c, "jwks") == "alg" {
            node_text(&d, get(&d, root, "jwks_alg"), &jtext)
        } else {
            node_text(&d, get(&d, root, "jwks"), &jtext)
        }
        jose.jwks_parse(&keys, str { p: rt.buf_data(&jtext), n: jtext.len })
        if get(&d, c, "with_secret") != json.JSON_NONE {
            jose.jwks_add_secret(&keys, "", secret.p as u64, secret.length())
        }
        var p: jose.Policy = jose.policy(gstr(&d, pol, "iss"), gstr(&d, pol, "aud"))
        jose.policy_algs(&p, alg_mask(&d, pol))
        jose.policy_nonce(&p, gstr(&d, pol, "nonce"))
        jose.policy_now(&p, now)
        jose.policy_leeway(&p, gint(&d, pol, "leeway", 60))
        var t: jose.Jwt = jose.jwt_new()
        var why: i64 = jose.jwt_decode(&t, tok)
        if why == jose.JWT_OK {
            why = jose.jwt_check(&t, &keys, &p)
        }
        let got: str = jose.jwt_reason_name(why)
        if got != expect {
            io.fmt_print_line(f"FAIL {name}: expected {expect}, got {got}")
            fails = fails + 1
        } else if why == jose.JWT_OK {
            // the claims can be read back
            let wantsub: str = gstr(&d, c, "claim_sub")
            if wantsub.length() > 0 && jose.jwt_claim_str(&t, "sub") != wantsub {
                io.fmt_print_line(f"FAIL {name}: sub")
                fails = fails + 1
            }
            let wantname: str = gstr(&d, c, "claim_name")
            if wantname.length() > 0 && jose.jwt_claim_str(&t, "name") != wantname {
                io.fmt_print_line(f"FAIL {name}: name (UTF-8)")
                fails = fails + 1
            }
        }
        jose.jwt_free(&t)
        jose.jwks_free(&keys)
        count = count + 1
        c = json.json_next(&d, c)
    }
    if count != 54 {
        io.print_line("FAIL not all 54 cases ran")
        fails = fails + 1
    }
    // reading claims
    {
        var keys2: jose.Jwks = jose.jwks_new()
        var t2: jose.Jwt = jose.jwt_new()
        var found: bool = false
        // pick the first RS256 token for the claim reader
        let c0: u32 = json.json_child(&d, cases)
        let tok0: str = gstr(&d, c0, "token")
        if jose.jwt_decode(&t2, tok0) != jose.JWT_OK { fails = fails + 1 }
        if jose.jwt_claim_int(&t2, "exp", &found) != now + 3600 || !found { fails = fails + 1 }
        if jose.jwt_claim_int(&t2, "nope", &found) != 0 || found { fails = fails + 1 }
        if jose.jwt_claim_str(&t2, "exp").length() != 0 { fails = fails + 1 }
        if !jose.jwt_has_claim(&t2, "sub") || jose.jwt_has_claim(&t2, "sup") { fails = fails + 1 }
        if jose.jwt_header_str(&t2, "alg") != "RS256" || jose.jwt_kid(&t2) != "rsa1" { fails = fails + 1 }
        if jose.jwt_alg(&t2) != jose.ALG_RS256 { fails = fails + 1 }
        jose.jwt_free(&t2)
        jose.jwks_free(&keys2)
    }
    rt.buf_free(&jtext)
    json.json_free(&d)
    if fails > 0 {
        io.fmt_print_line(f"{fails} failures")
        return 2 as i32
    }
    return 0 as i32
}
