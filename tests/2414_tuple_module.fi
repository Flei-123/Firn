// expect_exit: 0
// Round TUPLES: tuples across modules. A tuple type is named from the final
// names of its elements, so `(Dot, i32)` of the root file and `(tuple_geo.Dot,
// i32)` are two types, and a module may return a tuple of its own structs
// under its own alias.
import modules.tuple_geo

struct Dot { only_here: i32 }

type Mine = (tuple_geo.Dot, i32)

fn centre(r: tuple_geo.Rect) -> Mine {
    return tuple_geo.middle(r)
}

fn main() -> i32 {
    let r = tuple_geo.Rect {
        lo: tuple_geo.Dot { x: 0, y: 0 },
        hi: tuple_geo.Dot { x: 10, y: 6 },
    }
    let (lo, hi) = tuple_geo.corners(r)
    if lo.x != 0 || hi.x != 10 || hi.y != 6 {
        return 1
    }
    let c: tuple_geo.Corners = tuple_geo.corners(r)
    if c.1.y != 6 {
        return 2
    }
    let m = centre(r)
    if m.0.x != 5 || m.0.y != 3 || m.1 != 1 {
        return 3
    }
    let (area, (w, h)) = tuple_geo.area_and_edge(r)
    if area != 60 || w != 10 || h != 6 {
        return 4
    }
    // the root's own `Dot` is another struct than the module's
    let own: (Dot, i32) = (Dot { only_here: 4 }, 2)
    if own.0.only_here != 4 || own.1 != 2 {
        return 5
    }
    return 0
}
