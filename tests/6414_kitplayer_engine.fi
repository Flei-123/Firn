// expect_exit: 0
import std.rt
import std.fs
import fui.kpplayer
import fui.kpmodel
import fui.kpvideo
import fui.kpcodecall
import fui.kpcodecvid

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn load(path: str, b: *mut rt.Buf) -> bool {
    let got: usize = fs.read_file(path, b) catch | e | (0 -% 1)
    return got != (0 -% 1)
}

fn check_video_only() {
    var b: rt.Buf = rt.buf_new()
    check(load("testdata/media_video/av_main.mp4", &b), 1)
    var v: kpvideo.KpVideo = kpvideo.kv_new()
    kpvideo.kv_set_ops(&v, kpcodecvid.video_ops())
    check(kpvideo.kv_open(&v, rt.buf_ptr(&b), rt.buf_len(&b)) == 0, 2)
    check(kpvideo.kv_width(&v) > 0 as u32, 3)
    kpvideo.kv_seek(&v, 0)
    check(kpvideo.kv_update(&v, 0) == kpvideo.UP_FRAME, 4)
    check(kpvideo.kv_has_frame(&v) && kpvideo.kv_frame_no(&v) == 1 as u64, 5)
    check(kpvideo.kv_update(&v, 0) == kpvideo.UP_NONE, 6)
    var clk: i64 = 0
    var frames: u64 = 1 as u64
    while clk < 3000000 && !kpvideo.kv_done(&v) {
        clk = clk + 20000
        if kpvideo.kv_update(&v, clk) == kpvideo.UP_FRAME {
            frames = frames + 1 as u64
        }
    }
    check(frames > 5 as u64, 7)
    kpvideo.kv_seek(&v, 1000000)
    check(kpvideo.kv_update(&v, 1000000) == kpvideo.UP_FRAME, 8)
    check(kpvideo.kv_cur_pts(&v) >= 900000, 9)
    kpvideo.kv_seek(&v, 0)
    let drop0: u64 = kpvideo.kv_dropped(&v)
    kpvideo.kv_update(&v, 0)
    kpvideo.kv_update(&v, 900000)
    check(kpvideo.kv_dropped(&v) > drop0, 10)
    kpvideo.kv_close(&v)
    rt.buf_free(&b)
}

fn check_player_av() {
    var b: rt.Buf = rt.buf_new()
    check(load("testdata/media_video/av_main.mp4", &b), 20)
    var p: kpplayer.Player = kpplayer.pl_new()
    kpplayer.pl_set_discard(&p, true)
    kpplayer.pl_set_installer(&p, kpcodecall.install_for)
    kpplayer.pl_set_video_ops(&p, kpcodecvid.video_ops())
    check(kpplayer.pl_open(&p, rt.buf_ptr(&b), rt.buf_len(&b), "av_main.mp4"), 21)
    check(kpplayer.pl_has_video(&p) && kpplayer.pl_has_audio(&p), 22)
    check(kpplayer.pl_has_frame(&p), 23)
    check(kpplayer.pl_state(&p) == kpmodel.TS_READY, 24)
    check(kpplayer.pl_duration_ms(&p) > 500 as u64, 25)
    kpplayer.pl_play(&p)
    check(kpplayer.pl_state(&p) == kpmodel.TS_PLAYING, 26)
    var guard: i32 = 0
    while kpplayer.pl_state(&p) == kpmodel.TS_PLAYING && guard < 100000 {
        kpplayer.pl_update(&p)
        guard = guard + 1
    }
    check(kpplayer.pl_state(&p) == kpmodel.TS_ENDED, 27)
    kpplayer.pl_seek_ms(&p, 300 as u64)
    check(kpplayer.pl_state(&p) == kpmodel.TS_PLAYING, 28)
    check(kpplayer.pl_position_ms(&p) >= 300 as u64 && kpplayer.pl_position_ms(&p) < 900 as u64, 29)
    kpplayer.pl_pause(&p)
    check(kpplayer.pl_state(&p) == kpmodel.TS_PAUSED, 30)
    kpplayer.pl_set_volume(&p, 40 as u32)
    check(kpplayer.pl_volume(&p) == 40 as u32, 31)
    kpplayer.pl_free(&p)
    rt.buf_free(&b)
}

fn main(start: u64) -> i32 {
    check_video_only()
    check_player_av()
    return 0
}
