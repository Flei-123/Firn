// expect_exit: 0
// mc_atlas_shadow: change detection per tile, gather, list, mismatch on a different atlas layout.
import std.rt
import std.io
import mc.mc_texture
import mc.mc_atlas_shadow

fn paint_tile(a: *mut mc_texture.Atlas, t: u32, color: u32) {
    let n: usize = ((*a).tile as usize) * ((*a).tile as usize)
    let buf: u64 = rt.heap_alloc(n * 4)
    var i: usize = 0
    while i < n {
        rt.st32(buf, i, color)
        i = i + 1
    }
    mc_texture.atlas_set_tile(a, t, buf)
    rt.heap_free(buf, n * 4)
}

fn main(start: u64) -> i32 {
    var fails: i32 = 0
    var atlas: mc_texture.Atlas = mc_texture.atlas_default()
    var sh: mc_atlas_shadow.AtlasShadow = mc_atlas_shadow.shadow_new()
    if mc_atlas_shadow.shadow_matches(&sh, &atlas) { fails = fails + 1 }
    mc_atlas_shadow.shadow_store(&sh, &atlas)
    if !mc_atlas_shadow.shadow_matches(&sh, &atlas) { fails = fails + 1 }
    let total: usize = (atlas.cols as usize) * (atlas.rows as usize)
    let list: u64 = rt.heap_alloc(total * 4)
    if mc_atlas_shadow.shadow_changed_list(&sh, &atlas, total, list) != 0 { fails = fails + 1 }
    paint_tile(&atlas, 3 as u32, 0xFF112233 as u32)
    paint_tile(&atlas, 40 as u32, 0xFF445566 as u32)
    let n: usize = mc_atlas_shadow.shadow_changed_list(&sh, &atlas, total, list)
    io.fmt_print(f"changed {n}: {rt.ld32(list, 0)} {rt.ld32(list, 1)}\n")
    if n != 2 || rt.ld32(list, 0) != 2 as u32 || rt.ld32(list, 1) != 39 as u32 { fails = fails + 1 }
    let buf: u64 = rt.heap_alloc((atlas.tile as usize) * (atlas.tile as usize) * 4)
    mc_atlas_shadow.shadow_tile_gather(&sh, &atlas, 2, buf)
    if rt.ld32(buf, 0) != 0xFF112233 as u32 || rt.ld32(buf, 255) != 0xFF112233 as u32 { fails = fails + 1 }
    if mc_atlas_shadow.shadow_tile_changed(&sh, &atlas, 2) { fails = fails + 1 }
    if !mc_atlas_shadow.shadow_tile_changed(&sh, &atlas, 39) { fails = fails + 1 }
    var other: mc_texture.Atlas = mc_texture.atlas_new(32, 4, 4)
    if mc_atlas_shadow.shadow_matches(&sh, &other) { fails = fails + 1 }
    mc_atlas_shadow.shadow_free(&sh)
    if mc_atlas_shadow.shadow_matches(&sh, &atlas) { fails = fails + 1 }
    io.fmt_print(f"atlas shadow: {fails} failed\n")
    return fails
}
