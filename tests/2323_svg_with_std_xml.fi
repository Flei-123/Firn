// expect_out: 12 1 svg
// tests/2323_svg_with_std_xml.fi -- flat module names again: the lenient SVG reader
// `lib/svg/xml.fi` is now `lib/svg/svgxml.fi`, so one program can import it (through
// svg.svgimage) together with the strict `std.xml`. Firn addresses a module by the LAST
// segment of its path; before the rename both files were the module `xml` and the
// program did not build (as with svg.stroke / paint.stroke, tests/2243_module_names.fi).
//
// The program reads a document with std.xml (strict) and renders an SVG with the
// dashed 20x4 line `4 4` (three dashes of four columns: 12 of 20 columns are dark).
import std.io
import std.rt
import std.str
import std.xml
import paint.png
import html.mem
import svg.svgimage

fn dashed_columns() -> i64 {
    var svg: [u8; 159] = "<svg xmlns='http://www.w3.org/2000/svg' width='20' height='4'><line x1='0' y1='2' x2='20' y2='2' stroke='black' stroke-width='4' stroke-dasharray='4 4'/></svg>"
    var im: png.Image = png.image_new()
    if !svgimage.svg_to_image((&svg[0]) as u64, 159, &im, 0 as u64) {
        return -1
    }
    var dark: i64 = 0
    var x: usize = 0
    while x < png.image_width(&im) {
        let v: u32 = png.image_pixel(&im, x, 2)
        if (v >> 24) > 127 as u32 {
            dark = dark + 1
        }
        x = x + 1
    }
    png.image_free(&im)
    return dark
}

fn main() -> i32 {
    if !gc_init() {
        return 1
    }
    var d: xml.Doc = xml.doc_new()
    let ok: bool = xml.parse_str(&d, "<svg w='1'/>") catch false
    var nm: i64 = 0
    if ok && xml.attr(&d, xml.root(&d), "w") == "1" {
        nm = 1
    }
    let name: str = xml.name(&d, xml.root(&d))
    let a: i64 = dashed_columns()
    io.fmt_print_line(f"{a} {nm} {name}")
    xml.doc_free(&d)
    return 0
}
