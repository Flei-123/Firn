// expect_out: ok 42
// Visible output: the success and the error path of an error union.
error E { Empty }

fn value(n: i32) -> E!i32 {
    if n == 0 {
        return E::Empty
    }
    return n
}

fn write(p: *u8, n: i64) {
    syscall(1, 1, p, n)
}

fn main() -> i32 {
    var buf: [u8; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
    let a = value(42) catch 0
    let b = value(0) catch 0
    buf[0] = 111
    buf[1] = 107
    buf[2] = 32
    buf[3] = (a / 10) as u8 + 48
    buf[4] = (a % 10) as u8 + 48
    buf[5] = 10
    if b != 0 {
        return 1
    }
    write(&buf[0], 6)
    return 0
}
