// expect_exit: 0
// FEHLERUNIONEN IN DER KERNSPRACHE — der Test zur Runde 33
// (docs/SELBSTHOSTING.md §23).
//
// Geprüft wird der ganze Weg in EINEM Programm:
//
//   * eine Fehlermenge und eine Fehlerunion aus einem MODUL
//     (`modules/kern/mittel.fi`) — Mengennamen gelten programmweit
//   * `try` über zwei Ebenen durch die Modulgrenze hindurch
//   * `catch ersatz` und `catch |e| ersatz` mit Vergleich der Fehlerwerte
//   * die implizite Umwandlung bei `return`, `let`, Zuweisung und Argument
//   * eine Union als Structfeld und als Parametertyp
//   * must_consume: der Wert wird ueberall gebunden oder weitergereicht
import modules.kern.mittel

// Eine eigene Menge neben der aus dem Modul — die Codes beginnen je Menge
// bei 1.
error Lokal { Faul }

fn lokal(n: i32) -> Lokal!i32 {
    if n == 0 {
        return Lokal::Faul
    }
    return n
}

// `try` durch ZWEI Ebenen, die innerste liegt im Modul.
fn ebene1(n: i32) -> RechenFehler!i32 {
    let v = try mittel.halbiere(n)
    return v + 1
}

fn ebene2(n: i32) -> RechenFehler!i32 {
    let v = try ebene1(n)
    return v * 2
}

// Union als Structfeld.
struct Konto {
    stand: RechenFehler!i32,
    pin: i32,
}

// Union als Parameter: beim Aufruf wird implizit umgewandelt.
fn auswerten(r: RechenFehler!i32) -> i32 {
    return r catch 0 - 100
}

fn main() -> i32 {
    // --- try-Kette ueber die Modulgrenze
    if (ebene2(10) catch 0) != 12 {
        return 1
    }
    if (ebene2(7) catch 0 - 1) != 0 - 1 {
        return 2
    }
    if (ebene2(0 - 4) catch 0 - 1) != 0 - 1 {
        return 3
    }
    // --- catch |e| mit Vergleich der Fehlerwerte
    let c1 = ebene2(7) catch |e| (mittel.code_von(e))
    if c1 != 0 - 1 {
        return 4
    }
    let c2 = ebene2(0 - 4) catch |e| (mittel.code_von(e))
    if c2 != 0 - 2 {
        return 5
    }
    // --- Zuweisung: Wert und Fehlervariante
    var d: RechenFehler!i32 = mittel.halbiere(8)
    if (d catch 0) != 4 {
        return 6
    }
    d = 9
    if (d catch 0) != 9 {
        return 7
    }
    d = RechenFehler::Negativ
    if (d catch 0 - 3) != 0 - 3 {
        return 8
    }
    // --- Union als Structfeld und als Argument
    var k: Konto = Konto{ stand: RechenFehler::Ungerade, pin: 7 }
    if (k.stand catch 0 - 5) != 0 - 5 {
        return 9
    }
    k.stand = 33
    if (k.stand catch 0) != 33 {
        return 10
    }
    if auswerten(12) != 12 {
        return 11
    }
    if auswerten(RechenFehler::Negativ) != 0 - 100 {
        return 12
    }
    // --- zwei Mengen nebeneinander
    if (lokal(3) catch 0) != 3 {
        return 13
    }
    if (lokal(0) catch 0 - 7) != 0 - 7 {
        return 14
    }
    return 0
}
