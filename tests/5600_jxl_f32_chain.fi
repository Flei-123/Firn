// expect_exit: 0
import jxl.jxl
import jxl.jxl_dither
import jxl.jxl_f32
import jxl.jxl_fastmath
import jxl.jxl_idct32
import std.fs
import std.rt

static mut failures: i32 = 0
static mut mismatches: usize = 0
static mut total_samples: usize = 0
static mut max_diff: i32 = 0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn body_offset(d: *mut rt.Buf, n: usize, lines: u32) -> usize {
    var nl: u32 = 0
    var i: usize = 0
    while i < n && nl < lines {
        if rt.ld8(rt.buf_ptr(d), i) == 10 {
            nl = nl + 1
        }
        i = i + 1
    }
    return i
}

fn sample_at(p: u64, i: usize, wide: bool, big_endian: bool) -> i32 {
    if !wide {
        return rt.ld8(p, i) as i32
    }
    let a: i32 = rt.ld8(p, i * 2) as i32
    let b: i32 = rt.ld8(p, i * 2 + 1) as i32
    if big_endian {
        return a * 256 + b
    }
    return b * 256 + a
}

fn measure(path: str, ref_path: str, channels: u32, wide: bool) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    var ref: rt.Buf = rt.buf_new()
    let rn: usize = fs.read_file(ref_path, &ref) catch 0
    check(n != 0 && rn != 0)
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let ok: bool = jxl.jxl_decode(rt.buf_ptr(&data), n, &pic) catch false
    check(ok)
    mismatches = 0
    total_samples = 1
    max_diff = 99
    if ok {
        var bps: usize = 1
        if wide {
            bps = 2
        }
        let count: usize = (pic.width as usize) * (pic.height as usize) * (channels as usize)
        let off: usize = body_offset(&ref, rn, 3)
        check(pic.channels == channels && (pic.bytes_per_sample as usize) == bps && pic.size == count * bps && rn >= off + count * bps)
        if pic.size == count * bps && rn >= off + count * bps {
            let base: u64 = rt.buf_ptr(&ref) + (off as u64)
            var bad: usize = 0
            var worst: i32 = 0
            var i: usize = 0
            while i < count {
                var e: i32 = sample_at(pic.data, i, wide, false) - sample_at(base, i, wide, true)
                if e < 0 {
                    e = 0 - e
                }
                if e != 0 {
                    bad = bad + 1
                }
                if e > worst {
                    worst = e
                }
                i = i + 1
            }
            mismatches = bad
            total_samples = count
            max_diff = worst
        }
    }
    jxl.jxl_picture_free(&pic)
    rt.buf_free(&data)
    rt.buf_free(&ref)
}

fn expect(jxl_path: str, ref_path: str, wide: bool, max_allowed: i32, limit_per_10k: usize) {
    measure(jxl_path, ref_path, 3, wide)
    check(max_diff <= max_allowed)
    check(mismatches * 10000 <= limit_per_10k * total_samples)
}

fn check_fast_math() {
    check(jxl_f32.round32(jxl_fastmath.fast_log2f(1.5)) == jxl_f32.round32(0.584961414))
    check(jxl_f32.round32(jxl_fastmath.fast_log2f(jxl_f32.round32(0.37))) == jxl_f32.round32(0.0 - 1.43440449))
    check(jxl_f32.round32(jxl_fastmath.fast_powf(jxl_f32.round32(0.37), jxl_f32.round32(0.77))) == jxl_f32.round32(0.465066373))
    check(jxl_f32.round32(jxl_fastmath.fast_powf(jxl_f32.round32(2.9), 0.5)) == jxl_f32.round32(1.70293725))
    check(jxl_f32.round32(jxl_fastmath.rcp_approx(1.0)) == jxl_f32.round32(0.999755859))
    check(jxl_f32.round32(jxl_fastmath.rcp_approx(1.5)) == jxl_f32.round32(0.666625977))
    check(jxl_f32.round32(jxl_fastmath.rcp_approx(0.0 - 1.25)) == jxl_f32.round32(0.0 - 0.799804688))
}

fn check_idct() {
    var inp: [f64; 64] = [0.0; 64]
    var out: [f64; 64] = [0.0; 64]
    inp[0] = 8.0
    check(jxl_idct32.idct32_square(8, (&inp) as u64, (&out) as u64))
    var i: usize = 0
    while i < 64 {
        check(out[i] == 8.0)
        i = i + 1
    }
}

fn main() -> i32 {
    expect("tests/data/jxl/vd/d16_300.jxl", "tests/data/jxl/vd/d16_300.ppm", true, 2, 110)
    expect("tests/data/jxl/vd/d16_64.jxl", "tests/data/jxl/vd/d16_64.ppm", true, 2, 150)
    check_fast_math()
    check_idct()
    return failures
}
