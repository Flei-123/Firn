// expect_exit: 0
// tests/2965_photo_stabilize.fi -- FirnCam video stabilisation: a synthetic hand shake sequence (40 frames of the
// test scene, a slow pan of (0.25, 0.08) px per frame + correlated jitter of ~2.5 px + sensor noise). Checks:
// (1) the frame-to-frame motion estimate matches the truth (RMS error < 0.2 px), (2) the inter-frame jitter
// (RMS of step minus pan, TRUE positions after the correction) drops by >= 4x, (3) the same measured on the
// stabilised IMAGES with the estimator agrees (< 0.35 px), (4) the pan survives (end-to-end displacement of the
// output within 1.5 px per 10 frames of the truth), (5) the LIVE (causal) variant also cuts the jitter by >= 2x.
import std.io
import std.rt
import photo.image
import photo.synth
import photo.stabilize

fn sqrtv(x: f32) -> f32 { return image.sqrtf(x) }

fn pr(label: str, v: f32) {
    io.print(label)
    io.fmt_print_line(io.fmt_f32(io.fmt_new(), v))
}

fn main() -> i32 {
    let w: i32 = 160
    let h: i32 = 120
    let n: i32 = 40
    var ok: bool = true
    var scene: image.Image = image.scene_make(w, h)
    image.img_clamp01(&scene)
    var rng: image.Rng = image.rng_new(77 as u64)
    var tx: [f32; 40] = [0.0f; 40]
    var ty: [f32; 40] = [0.0f; 40]
    var jx: f32 = 0.0f
    var jy: f32 = 0.0f
    var i: i32 = 0
    while i < n {
        jx = 0.6f * jx + 1.9f * image.rng_gauss(&rng)
        jy = 0.6f * jy + 1.9f * image.rng_gauss(&rng)
        tx[i as usize] = 0.25f * (i as f32) + jx
        ty[i as usize] = 0.08f * (i as f32) + jy
        i = i + 1
    }
    var luma: [image.Image; 40] = [image.img_new(1, 1, 1); 40]
    var frames: [image.Image; 40] = [image.img_new(1, 1, 1); 40]
    i = 0
    while i < n {
        var f: image.Image = synth.synth_frame(&scene, tx[i as usize], ty[i as usize], 1.0f, 2.0e-3f, 2.0e-5f, &rng)
        frames[i as usize] = f
        luma[i as usize] = image.img_luma(&f)
        i = i + 1
    }
    var o: stabilize.StabOpts = stabilize.stab_default()
    var path: stabilize.Path = stabilize.path_new(n)
    var est2: f32 = 0.0f
    i = 1
    while i < n {
        let m: stabilize.Motion = stabilize.stab_motion(&luma[(i - 1) as usize], &luma[i as usize], &o)
        let ex: f32 = m.dx - (tx[i as usize] - tx[(i - 1) as usize])
        let ey: f32 = m.dy - (ty[i as usize] - ty[(i - 1) as usize])
        est2 = est2 + ex * ex + ey * ey
        stabilize.path_add(&path, m.dx, m.dy)
        i = i + 1
    }
    let est_rms: f32 = sqrtv(est2 / (((n - 1) * 2) as f32))
    var sm: stabilize.Path = stabilize.path_new(n)
    stabilize.path_smooth(&path, o.smooth, &sm)
    let mx: i32 = stabilize.stab_margin(w, o.crop)
    let my: i32 = stabilize.stab_margin(h, o.crop)
    var cor: stabilize.Path = stabilize.path_new(n)
    stabilize.path_correction(&path, &sm, mx as f32, my as f32, &cor)
    // jitter before / after with the TRUE positions (pan 0.25 / 0.08 removed)
    var jb: f32 = 0.0f
    var ja: f32 = 0.0f
    i = 1
    while i < n {
        let bx: f32 = (tx[i as usize] - tx[(i - 1) as usize]) - 0.25f
        let by: f32 = (ty[i as usize] - ty[(i - 1) as usize]) - 0.08f
        let ax: f32 = bx + (stabilize.path_get_x(&cor, i) - stabilize.path_get_x(&cor, i - 1))
        let ay: f32 = by + (stabilize.path_get_y(&cor, i) - stabilize.path_get_y(&cor, i - 1))
        jb = jb + bx * bx + by * by
        ja = ja + ax * ax + ay * ay
        i = i + 1
    }
    let jit_before: f32 = sqrtv(jb / (((n - 1) * 2) as f32))
    let jit_after: f32 = sqrtv(ja / (((n - 1) * 2) as f32))
    // the images: apply, then measure again with the estimator
    var outl: [image.Image; 40] = [image.img_new(1, 1, 1); 40]
    i = 0
    while i < n {
        var st: image.Image = image.img_new(1, 1, 3)
        stabilize.stab_crop(&frames[i as usize], stabilize.path_get_x(&cor, i), stabilize.path_get_y(&cor, i), mx, my, &st)
        if st.w != w - 2 * mx || st.h != h - 2 * my { ok = false }
        outl[i as usize] = image.img_luma(&st)
        image.img_free(&st)
        i = i + 1
    }
    var meas2: f32 = 0.0f
    var ox: f32 = 0.0f
    var oy: f32 = 0.0f
    i = 1
    while i < n {
        let m2: stabilize.Motion = stabilize.stab_motion(&outl[(i - 1) as usize], &outl[i as usize], &o)
        let sx: f32 = m2.dx - 0.25f
        let sy: f32 = m2.dy - 0.08f
        meas2 = meas2 + sx * sx + sy * sy
        ox = ox + m2.dx
        oy = oy + m2.dy
        i = i + 1
    }
    let jit_meas: f32 = sqrtv(meas2 / (((n - 1) * 2) as f32))
    // pan survival: total displacement of the output content vs the true pan
    let pan_err: f32 = sqrtv((ox - 0.25f * ((n - 1) as f32)) * (ox - 0.25f * ((n - 1) as f32)) + (oy - 0.08f * ((n - 1) as f32)) * (oy - 0.08f * ((n - 1) as f32)))
    // LIVE
    var live: stabilize.Live = stabilize.live_new(&o)
    var jl: f32 = 0.0f
    var pcx: f32 = 0.0f
    var pcy: f32 = 0.0f
    i = 0
    while i < n {
        var cx: f32 = 0.0f
        var cy: f32 = 0.0f
        stabilize.live_push(&live, &luma[i as usize], &cx, &cy)
        if i > 0 {
            let bx2: f32 = (tx[i as usize] - tx[(i - 1) as usize]) - 0.25f + (cx - pcx)
            let by2: f32 = (ty[i as usize] - ty[(i - 1) as usize]) - 0.08f + (cy - pcy)
            jl = jl + bx2 * bx2 + by2 * by2
        }
        pcx = cx
        pcy = cy
        i = i + 1
    }
    let jit_live: f32 = sqrtv(jl / (((n - 1) * 2) as f32))
    stabilize.live_free(&live)
    pr("motion est rms px: ", est_rms)
    pr("jitter before px: ", jit_before)
    pr("jitter after (truth) px: ", jit_after)
    pr("jitter after (measured on images) px: ", jit_meas)
    pr("pan error total px: ", pan_err)
    pr("jitter live px: ", jit_live)
    pr("reduction x: ", jit_before / jit_after)
    ok = est_rms < 0.2f && ok
    ok = jit_after * 4.0f < jit_before && ok
    ok = absf32(jit_meas - jit_after) < 0.35f && ok
    ok = pan_err < 6.0f && ok
    ok = jit_live * 2.0f < jit_before && ok
    if ok {
        io.print("ok")
        io.new_line()
        return 0
    }
    return 1
}

fn absf32(x: f32) -> f32 {
    if x < 0.0f { return 0.0f - x }
    return x
}
