// expect_exit: 0
// tests/2969_photo_stack_tv.fi -- FirnCam focus stack regression on the synthetic TV scene (photo.stackrig /
// photo.synthtv): dark room, BRIGHT clipping TV with a moving "video" area and display flicker, two depth layers,
// 5 frames each focused at another distance, hand shake, exposure changes, noise. The phone showed halos around the
// TV, colour fringes, a flat look and a magenta cast; the first stack (focus_legacy) reproduces that here.
// Checks (display space, against the sharp render of the reference geometry):
//   * no halo around the bright parts (legacy > 1, robust stack < 0.15) and no colour cast of the TV
//   * the stack is never worse than its REFERENCE frame alone (whole image, dark wall, near layer within 0.3 dB, TV within 0.8 dB)
//   * the stack beats the legacy stack clearly (whole image > 4 dB)
//   * the black point (1 % luma percentile) does not rise above the reference frame's, the wall keeps its level
//   * the colour fringe stays near the reference frame's
// Deterministic.
import std.io
import photo.par
import photo.focus
import photo.stackrig

fn pf(s: str, v: f32) {
    stackrig.pf("t", s, v)
}

fn main() -> i32 {
    par.init(4)
    var rg: stackrig.Rig = stackrig.rig_new(320, 240, 5, 5 as u64)
    var oleg: focus.FocusOpts = focus.focus_legacy()
    var orb: focus.FocusOpts = focus.focus_default()
    orb.noise_s = rg.cfg.ns
    orb.noise_o = rg.cfg.no
    var rl: i32 = 0
    var rr: i32 = 0
    let leg: stackrig.Res = stackrig.stack_res(&rg, &oleg, "legacy", false, &rl)
    let st: stackrig.Res = stackrig.stack_res(&rg, &orb, "robust", false, &rr)
    let one: stackrig.Res = stackrig.single_res(&rg, rr)
    pf("ref", rr as f32)
    pf("leg_all", leg.psnr_all)
    pf("leg_halo", leg.halo)
    pf("st_all", st.psnr_all)
    pf("one_all", one.psnr_all)
    pf("st_tv", st.psnr_tv)
    pf("one_tv", one.psnr_tv)
    pf("st_wall", st.psnr_wall)
    pf("one_wall", one.psnr_wall)
    pf("st_near", st.psnr_near)
    pf("one_near", one.psnr_near)
    pf("st_halo", st.halo)
    pf("one_halo", one.halo)
    pf("st_fringe", st.fringe)
    pf("one_fringe", one.fringe)
    pf("st_p1", st.p1)
    pf("one_p1", one.p1)
    pf("st_wallL", st.wall)
    pf("one_wallL", one.wall)
    pf("st_tvsat", st.tvsat)
    var ok: bool = true
    if !(st.halo < 0.1f) { io.print_line("FAIL halo"); ok = false }
    if !(leg.halo > 5.0f * st.halo) { io.print_line("FAIL legacy halo not reproduced"); ok = false }
    if !(st.psnr_all >= one.psnr_all - 0.3f) { io.print_line("FAIL all worse than reference"); ok = false }
    if !(st.psnr_tv >= one.psnr_tv - 0.8f) { io.print_line("FAIL tv worse than reference"); ok = false }
    if !(st.psnr_wall >= one.psnr_wall - 0.3f) { io.print_line("FAIL wall worse than reference"); ok = false }
    if !(st.psnr_near >= one.psnr_near - 0.3f) { io.print_line("FAIL near worse than reference"); ok = false }
    if !(st.psnr_all > leg.psnr_all + 4.0f) { io.print_line("FAIL stack does not beat legacy"); ok = false }
    if !(st.p1 <= one.p1 + 0.02f) { io.print_line("FAIL black point raised"); ok = false }
    var dw: f32 = st.wall - one.wall
    if dw < 0.0f { dw = 0.0f - dw }
    if !(dw < 0.01f) { io.print_line("FAIL wall level moved"); ok = false }
    if !(st.fringe <= one.fringe + 0.6f) { io.print_line("FAIL colour fringe"); ok = false }
    if !(st.tvsat >= 0.85f) { io.print_line("FAIL tv colour washed out"); ok = false }
    par.shutdown()
    stackrig.rig_free(&rg)
    if !ok { return 1 }
    io.print_line("ok")
    return 0
}
