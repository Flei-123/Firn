// expect_exit: 2
// r899 (documents a NON-guarantee): an explicit g.drop() does not count as a move,
// the scope end runs drop a second time (LOG counts both).
static mut LOG: i64 = 0

struct G { id: i64 }

impl G { fn drop(inout self) { LOG = LOG + 1 } }

fn main() -> i32 {
    {
        var g: G = G { id: 1 }
        g.drop()
    }
    return LOG as i32
}
