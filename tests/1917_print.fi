// expect_exit: 42
// tests/1917_print.fi -- lib/print (OpenPlan LIB-009) without a printer:
// the printer addresses, the octets of an IPP request (RFC 8010 3.1), and
// the refusals. Printing itself -- against CUPS' ippeveprinter, which
// checks every request like a printer and spools what it receives -- is
// tools/libmvp/check_print.py.
import print.print
import std.rt
import std.str

fn code(e: PrintError) -> u32 {
    if e == PrintError::NoServer { return 1 as u32 }
    if e == PrintError::Http { return 2 as u32 }
    if e == PrintError::Ipp { return 3 as u32 }
    if e == PrintError::BadPrinter { return 4 as u32 }
    return 5 as u32
}

fn main() -> i32 {
    // --- A. addresses
    if print.printer_uri("Office") != "ipp://localhost:631/printers/Office" { return 1 as i32 }
    if print.printer_uri("ipp://10.0.0.5/ipp/print") != "ipp://10.0.0.5/ipp/print" { return 2 as i32 }
    if print.printer_uri("http://10.0.0.5:631/printers/x") != "http://10.0.0.5:631/printers/x" { return 3 as i32 }
    if print.printer_uri("ipps://10.0.0.5/ipp/print") != "" || print.printer_uri("") != "" || print.printer_uri("a/b") != "" { return 4 as i32 }

    // --- B. the request head: version 2.0, operation, request id, the
    // operation group with charset, language and printer-uri
    var b: rt.Buf = rt.buf_new()
    print.ipp_encode_request(&b, 2 as u32, "ipp://x/p")
    let p: u64 = rt.buf_ptr(&b)
    if rt.ld8(p, 0) != 2 as u8 || rt.ld8(p, 1) != 0 as u8 { return 10 as i32 } // 2.0
    if rt.ld8(p, 2) != 0 as u8 || rt.ld8(p, 3) != 2 as u8 { return 11 as i32 } // Print-Job
    if rt.ld8(p, 7) != 1 as u8 { return 12 as i32 } // request id 1
    if rt.ld8(p, 8) != 1 as u8 { return 13 as i32 } // operation-attributes-tag
    // charset: tag 0x47, name length 18, "attributes-charset", value length 5, "utf-8"
    if rt.ld8(p, 9) != 71 as u8 || rt.ld8(p, 11) != 18 as u8 { return 14 as i32 }
    let cs: str = str { p: rt.ptr_of(p + 12), n: 18 }
    if cs != "attributes-charset" || rt.ld8(p, 31) != 5 as u8 { return 15 as i32 }
    let language_at: usize = 9 + 1 + 2 + 18 + 2 + 5
    if rt.ld8(p, language_at) != 72 as u8 { return 16 as i32 } // naturalLanguage
    let uri_at: usize = language_at + 1 + 2 + 27 + 2 + 2
    if rt.ld8(p, uri_at) != 69 as u8 { return 17 as i32 } // uri
    if rt.buf_len(&b) != uri_at + 1 + 2 + 11 + 2 + 9 { return 18 as i32 }
    // the next request has the next id
    var b2: rt.Buf = rt.buf_new()
    print.ipp_encode_request(&b2, 11 as u32, "")
    if rt.ld8(rt.buf_ptr(&b2), 7) != 2 as u8 { return 19 as i32 }

    // --- C. refusals
    var o: print.PrintOptions = print.print_options_default()
    if o.copies != 1 || o.sides != print.SIDES_ONE || o.color != print.COLOR_AUTO { return 30 as i32 }
    let pdf: str = "%PDF-1.7\n"
    // port 1 on the loopback: nothing listens there
    let a: u32 = print.print_pdf("ipp://127.0.0.1:1/ipp/print", pdf.p as u64, pdf.n, o) catch | e | (code(e) + 100)
    if a != 101 { return 31 as i32 }
    let c: u32 = print.print_pdf("ipps://127.0.0.1/ipp/print", pdf.p as u64, pdf.n, o) catch | e | (code(e) + 100)
    if c != 104 { return 32 as i32 }
    let d: u32 = print.job_state("", 1 as u32) catch | e | (code(e) + 100)
    if d != 104 { return 33 as i32 }
    return 42
}
