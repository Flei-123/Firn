// expect_exit: 0
// tests/4830_chan_basic.fi -- lib/chan on one thread: order, full / empty, try_*, wrap-around, records of 3 words,
// the 1-word helpers, capacity rounding, bad arguments.
import std.rt
import chan.chan

fn main() -> i32 {
    var c: chan.Chan = chan.chan_new(5, 1)
    if chan.chan_cap(&c) != 8 { return 1 }
    if chan.chan_rec_words(&c) != 1 { return 2 }
    var out: u64 = 0
    if chan.chan_try_recv(&c, &out) { return 3 }
    if chan.chan_len(&c) != 0 { return 4 }
    var i: u64 = 0
    while i < 8 {
        var v: u64 = 100 + i
        if !chan.chan_try_send(&c, &v) { return 10 }
        i = i + 1
    }
    var extra: u64 = 999
    if chan.chan_try_send(&c, &extra) { return 11 }
    if chan.chan_len(&c) != 8 { return 12 }
    i = 0
    while i < 8 {
        if !chan.chan_try_recv(&c, &out) { return 13 }
        if out != 100 + i { return 14 }
        i = i + 1
    }
    if chan.chan_try_recv(&c, &out) { return 15 }
    if chan.chan_len(&c) != 0 { return 16 }

    var lap: u64 = 0
    var next_in: u64 = 0
    var next_out: u64 = 0
    while lap < 5000 {
        var k: u64 = 0
        let burst: u64 = (lap % 7) + 1
        while k < burst {
            if !chan.chan_send1(&c, next_in) { return 20 }
            next_in = next_in + 1
            k = k + 1
        }
        k = 0
        while k < burst {
            if !chan.chan_recv1(&c, &out) { return 21 }
            if out != next_out { return 22 }
            next_out = next_out + 1
            k = k + 1
        }
        lap = lap + 1
    }
    if next_in != next_out { return 23 }
    chan.chan_free(&c)
    if c.blk != 0 { return 24 }

    var r: chan.Chan = chan.chan_new(4, 3)
    if chan.chan_rec_words(&r) != 3 { return 30 }
    var rec: [u64; 3] = [0; 3]
    var got: [u64; 3] = [0; 3]
    i = 0
    while i < 4 {
        rec[0] = i
        rec[1] = i * 1000
        rec[2] = i + 7
        if !chan.chan_try_send(&r, &rec[0]) { return 31 }
        i = i + 1
    }
    rec[0] = 7
    if chan.chan_try_send(&r, &rec[0]) { return 32 }
    i = 0
    while i < 4 {
        if !chan.chan_try_recv(&r, &got[0]) { return 33 }
        if got[0] != i { return 34 }
        if got[1] != i * 1000 { return 35 }
        if got[2] != i + 7 { return 36 }
        i = i + 1
    }
    var round: u64 = 0
    while round < 1000 {
        rec[0] = round
        rec[1] = round + 1
        rec[2] = round + 2
        if !chan.chan_send(&r, &rec[0]) { return 37 }
        if !chan.chan_recv(&r, &got[0]) { return 38 }
        if got[0] != round || got[1] != round + 1 || got[2] != round + 2 { return 39 }
        round = round + 1
    }
    chan.chan_free(&r)

    var big: chan.Chan = chan.chan_new(1000, 1)
    if chan.chan_cap(&big) != 1024 { return 40 }
    chan.chan_free(&big)
    var one: chan.Chan = chan.chan_new(0, 0)
    if chan.chan_cap(&one) != 2 { return 41 }
    if chan.chan_rec_words(&one) != 1 { return 42 }
    chan.chan_free(&one)
    var bad: chan.Chan = chan.chan_new(8, 100000)
    if bad.blk != 0 { return 43 }
    if chan.chan_try_send(&bad, &extra) { return 44 }
    if chan.chan_send(&bad, &extra) { return 45 }
    if chan.chan_recv(&bad, &out) { return 46 }
    if !chan.chan_is_closed(&bad) { return 47 }
    chan.chan_free(&bad)
    return 0
}
