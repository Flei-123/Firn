// expect_exit: 0
import std.io
import photo.camjob
import photo.campreset

fn check(c: bool, msg: str) -> bool {
    if !c { io.print(msg); io.new_line() }
    return c
}

fn main() -> i32 {
    var ok: bool = true
    ok = check(campreset.frames(campreset.FAST) == 1, "fast frames") && ok
    ok = check(campreset.frames(campreset.BALANCED) == 3, "balanced frames") && ok
    ok = check(campreset.frames(campreset.ULTRA) == 4, "ultra frames") && ok
    ok = check(campreset.next(campreset.ULTRA) == campreset.FAST, "cycle wraps") && ok
    ok = check(campreset.clamp(9) == campreset.ULTRA && campreset.clamp(0 - 1) == campreset.ULTRA, "clamp") && ok
    var j: camjob.Job = camjob.job_new()
    campreset.apply(&j, campreset.ULTRA)
    ok = check(j.max_px == 9500000 && j.dn_rad == 3, "ultra keeps the full pipeline") && ok
    campreset.apply(&j, campreset.BALANCED)
    ok = check(j.max_px == 3700000 && j.dn_rad == 2, "balanced") && ok
    campreset.apply_preview(&j)
    ok = check(j.max_px == campreset.preview_max_px() && j.dn_rad == 1, "preview") && ok
    camjob.job_free(&j)
    if ok { return 0 }
    return 1
}
