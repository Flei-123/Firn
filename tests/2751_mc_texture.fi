// expect_exit: 0
// tests/2751_mc_texture.fi -- mc_texture: default atlas, UV rects, wrap sampling, determinism and the
// block-state -> tile tables for 1.20.1 (names from the generated registry).
import std.rt
import mc.mc_version
import mc.mc_versions
import mc.mc_registry
import mc.mc_mesh
import mc.mc_texture

fn main() -> i32 {
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    if a.w != 256 || a.h != 256 { return 1 }
    // tile 1 starts at pixel (0,0), tile 17 (second row) at (0,16), tile 16 at (240,0)
    if mc_texture.atlas_tile_x(&a, 16 as u32) != 240 || mc_texture.atlas_tile_y(&a, 17 as u32) != 16 { return 2 }
    var uv: [f64; 4] = [0.0; 4]
    if !mc_texture.atlas_tile_uv(&a, 17 as u32, &uv) { return 3 }
    if uv[0] != 0.0 || uv[1] != 0.0625 || uv[2] != 0.0625 || uv[3] != 0.125 { return 4 }
    if mc_texture.atlas_tile_uv(&a, 0 as u32, &uv) || mc_texture.atlas_tile_uv(&a, 257 as u32, &uv) { return 5 }
    // test tile: top left red, top right green, bottom left blue, bottom right white, black border
    let t: u32 = mc_texture.T_TEST
    if mc_texture.atlas_texel(&a, t, 5, 5) != mc_texture.pack_pixel(220 as u32, 40 as u32, 40 as u32, 255 as u32) { return 6 }
    if mc_texture.atlas_texel(&a, t, 12, 5) != mc_texture.pack_pixel(40 as u32, 200 as u32, 40 as u32, 255 as u32) { return 7 }
    if mc_texture.atlas_texel(&a, t, 5, 12) != mc_texture.pack_pixel(40 as u32, 40 as u32, 220 as u32, 255 as u32) { return 8 }
    if mc_texture.atlas_texel(&a, t, 12, 12) != mc_texture.pack_pixel(235 as u32, 235 as u32, 235 as u32, 255 as u32) { return 9 }
    if mc_texture.atlas_texel(&a, t, 0, 7) != mc_texture.pack_pixel(0 as u32, 0 as u32, 0 as u32, 255 as u32) { return 10 }
    // wrap inside the tile (repeat) and negative coordinates
    if mc_texture.atlas_texel(&a, t, 16 + 5, 16 + 5) != mc_texture.atlas_texel(&a, t, 5, 5) { return 11 }
    if mc_texture.atlas_texel(&a, t, -11, 5) != mc_texture.atlas_texel(&a, t, 5, 5) { return 12 }
    // sample in tile units: 2.3 wraps to 0.3 -> texel 4
    if mc_texture.atlas_sample(&a, t, 2.3, 0.3) != mc_texture.atlas_texel(&a, t, 4, 4) { return 13 }
    if mc_texture.atlas_sample(&a, t, -0.7, 0.3) != mc_texture.atlas_texel(&a, t, 4, 4) { return 14 }
    // invalid tile
    if mc_texture.atlas_texel(&a, 0 as u32, 1, 1) != 0 as u32 { return 15 }
    // alpha: glass interior and leaf holes are cut out, water is translucent
    if (mc_texture.atlas_texel(&a, mc_texture.T_GLASS, 8, 4) >> 24 as u32) != 0 as u32 { return 16 }
    if (mc_texture.atlas_texel(&a, mc_texture.T_WATER, 3, 3) >> 24 as u32) != 190 as u32 { return 17 }
    if (mc_texture.atlas_avg(&a, mc_texture.T_STONE) & 255 as u32) < 100 as u32 { return 18 }
    // deterministic: a second atlas is identical
    var b: mc_texture.Atlas = mc_texture.atlas_default()
    var i: usize = 0
    while i < 256 * 256 {
        if rt.ld32(a.px, i) != rt.ld32(b.px, i) { return 19 }
        i = i + 1
    }
    // set_tile replaces a tile
    let tile: u64 = rt.heap_alloc(16 * 16 * 4)
    i = 0
    while i < 256 {
        rt.st32(tile, i, 0xFF00FF00 as u32)
        i = i + 1
    }
    if !mc_texture.atlas_set_tile(&b, 1 as u32, tile) { return 20 }
    if mc_texture.atlas_texel(&b, 1 as u32, 7, 7) != 0xFF00FF00 as u32 { return 21 }
    if mc_texture.atlas_texel(&b, 2 as u32, 7, 7) != mc_texture.atlas_texel(&a, 2 as u32, 7, 7) { return 22 }

    // tables for 1.20.1
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 30 }
    var r: mc_registry.Registry = v.registry_of()
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    mc_texture.tex_build_tables(&r, &tb)
    // air: nothing
    if rt.ld16(tb.tiles, 0) != 0 as u16 || rt.ld8(tb.opaque, 0) != 0 as u8 { return 31 }
    // stone (state 1): tile 1 on all faces, opaque
    var f: usize = 0
    while f < 6 {
        if rt.ld16(tb.tiles, 6 + f) != 1 as u16 { return 32 }
        f = f + 1
    }
    if rt.ld8(tb.opaque, 1) != 1 as u8 { return 33 }
    // grass block: dirt below, grass on top, grass side around (both snowy states)
    let gb: i32 = mc_registry.reg_block_by_name(&r, "grass_block".p as u64, 11)
    let gs: usize = mc_registry.reg_block_min_state(&r, gb) as usize
    if rt.ld16(tb.tiles, gs * 6 + 2) != 2 as u16 || rt.ld16(tb.tiles, gs * 6 + 3) != 3 as u16 { return 34 }
    if rt.ld16(tb.tiles, gs * 6 + 0) != 4 as u16 || rt.ld16(tb.tiles, gs * 6 + 5) != 4 as u16 { return 35 }
    // oak log: bark on the sides, rings above and below; leaves transparent but drawn; water not opaque
    let lg: usize = mc_registry.reg_block_min_state(&r, mc_registry.reg_block_by_name(&r, "oak_log".p as u64, 7)) as usize
    if rt.ld16(tb.tiles, lg * 6 + 0) != 7 as u16 || rt.ld16(tb.tiles, lg * 6 + 3) != 8 as u16 { return 36 }
    let lv: usize = mc_registry.reg_block_min_state(&r, mc_registry.reg_block_by_name(&r, "oak_leaves".p as u64, 10)) as usize
    if rt.ld16(tb.tiles, lv * 6) != 10 as u16 || rt.ld8(tb.opaque, lv) != 0 as u8 { return 37 }
    let wt: usize = mc_registry.reg_block_min_state(&r, mc_registry.reg_block_by_name(&r, "water".p as u64, 5)) as usize
    if rt.ld16(tb.tiles, wt * 6) != 11 as u16 || rt.ld8(tb.opaque, wt) != 0 as u8 { return 38 }
    // dye prefix and plants (no solid box -> no face)
    let wl: usize = mc_registry.reg_block_min_state(&r, mc_registry.reg_block_by_name(&r, "red_wool".p as u64, 8)) as usize
    if rt.ld16(tb.tiles, wl * 6) != 39 as u16 { return 39 }
    let dd: usize = mc_registry.reg_block_min_state(&r, mc_registry.reg_block_by_name(&r, "dandelion".p as u64, 9)) as usize
    if rt.ld16(tb.tiles, dd * 6) != 0 as u16 { return 40 }
    // every solid, visible state has a tile in 1..58; count tiles in range
    var bad: i32 = 0
    var s: usize = 0
    while s < 24135 {
        var k: usize = 0
        while k < 6 {
            if rt.ld16(tb.tiles, s * 6 + k) > 58 as u16 { bad = bad + 1 }
            k = k + 1
        }
        s = s + 1
    }
    if bad != 0 { return 41 }
    mc_texture.tex_free_tables(&tb)
    mc_texture.atlas_free(&a)
    mc_texture.atlas_free(&b)
    return 0
}
