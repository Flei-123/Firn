// expect_exit: 0
// tests/4020_str_slice.fi -- Python-style slices on str / Span: `s[a:b]`, `s[a:]`, `s[:b]`, `s[:]`,
// negative bounds count from the end, bounds are clamped, no copy (r712).
import std.rt
import std.str
import std.testkit

fn tail(s: str) -> str {
    return s[-3:]
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let s: str = "hello world"
    testkit.check(s[1:3] == "el", "middle")
    testkit.check(s[:5] == "hello", "head")
    testkit.check(s[6:] == "world", "tail")
    testkit.check(s[-5:] == "world", "negative start")
    testkit.check(s[:-6] == "hello", "negative end")
    testkit.check(s[-5:-2] == "wor", "both negative")
    testkit.check(s[3:1] == "", "reversed bounds are empty")
    testkit.check(s[5:5] == "", "empty range")
    testkit.check(s[-100:100] == s, "clamped")
    testkit.check(s[100:] == "", "start past the end")
    testkit.check(s[:] == s, "full slice")
    testkit.check(tail("abcdef") == "def", "slice in a function")
    // bounds are any integer expression
    let i: usize = 2
    let j: i32 = 4
    testkit.check(s[i:j as usize] == "ll", "variable bounds")
    testkit.check(s[i + 1:i + 3] == "lo", "expression bounds")
    // no copy: the view points into the same octets
    let t: str = s[6:]
    testkit.check(t.length() == 5, "length of the view")
    testkit.check(s[0:1].length() == 1, "chained call on a slice")
    testkit.check(s[1:][1:3] == "ll", "slice of a slice")
    // a Span works the same way
    let sp: str.Span = s.part(0, 5)
    testkit.check(sp[1:-1].equal("ell"), "slice of a Span")
    return testkit.finish()
}
