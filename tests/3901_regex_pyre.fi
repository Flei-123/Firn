// expect_exit: 0
// tests/3901_regex_pyre.fi -- regex.pyre: findall, finditer, sub/subn with Python
// templates, split, search/match_start, escape, compile. The random comparison with
// Python re is tools/pystr_cross/run.sh.
import regex.regex
import regex.pyre
import std.io
import std.rt
import std.pystr
import std.vec
import std.testkit

fn joined(v: *mut Vec[str]) -> str {
    return pystr.join(v, "|")
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[str] = vec_new[str]()
    defer vec_free[str](&v)
    var day: regex.Regex = pyre.compile("\\d{4}-\\d{2}-\\d{2}", 0)
    pyre.findall(&day, "a 2026-03-01 b 2026-04-02.", &v)
    testkit.check(joined(&v) == "2026-03-01|2026-04-02", "findall no group")
    var ymd: regex.Regex = pyre.compile("(\\d{4})-(\\d{2})-(\\d{2})", 0)
    pyre.findall(&ymd, "2026-03-01 2026-04-02", &v)
    testkit.check(joined(&v) == "2026|2026", "findall with groups answers group 1")
    var star: regex.Regex = pyre.compile("a*", 0)
    pyre.findall(&star, "baac", &v)
    testkit.check(vec_len[str](&v) == 4 && joined(&v) == "|aa||", "findall a* like Python 3.7+")
    pyre.findall(&day, "", &v)
    testkit.check(vec_len[str](&v) == 0, "findall nothing")
    // finditer
    var word: regex.Regex = pyre.compile("([a-z]+)@(\\w+)", 0)
    let text: str = "x ab@cd, ef@gh!"
    var it: pyre.Finditer = pyre.finditer_new(&word, text)
    var m: regex.Match = regex.match_new()
    var n: usize = 0
    var last: str = ""
    while pyre.finditer_next(&it, &m) {
        n = n + 1
        last = regex.match_group_text(&m, text, 2)
    }
    pyre.finditer_free(&it)
    testkit.check(n == 2 && last == "gh", "finditer")
    // sub / subn
    testkit.check(pyre.sub(&ymd, "\\3.\\2.\\1", "on 2026-03-01.") == "on 01.03.2026.", "sub group refs")
    testkit.check(pyre.sub(&ymd, "<\\g<2>>", "2026-03-01") == "<03>", "sub \\g<n>")
    testkit.check(pyre.sub(&day, "$1 \\\\ \\n", "x 2026-03-01") == "x $1 \\ \n", "sub keeps $, handles \\\\ and \\n")
    var named: regex.Regex = pyre.compile("(?P<k>[a-z]+)=(?P<v>\\d+)", 0)
    testkit.check(pyre.sub(&named, "\\g<v>:\\g<k>", "a=1,b=22") == "1:a,22:b", "sub named groups")
    var cnt: usize = 0
    testkit.check(pyre.subn(&day, "D", "2026-03-01 2026-04-02 no", &cnt) == "D D no" && cnt == 2, "subn")
    testkit.check(pyre.sub(&star, "-", "baac") == "-b--c-", "sub a* like Python 3.7+")
    // split
    var sep: regex.Regex = pyre.compile("[,;]\\s*", 0)
    pyre.split(&sep, "a, b;c,d", &v)
    testkit.check(joined(&v) == "a|b|c|d", "split")
    var gsep: regex.Regex = pyre.compile("(-)", 0)
    pyre.split(&gsep, "a-b", &v)
    testkit.check(joined(&v) == "a|-|b", "split keeps groups")
    pyre.split(&sep, "", &v)
    testkit.check(vec_len[str](&v) == 1, "split empty text")
    // search / match
    var hit: regex.Regex = pyre.compile("b+", 0)
    testkit.check(pyre.search(&hit, "aabbc", &m) && m.start == 2 && m.end == 4, "search")
    testkit.check(!pyre.match_start(&hit, "aabbc", &m) && pyre.match_start(&hit, "bbc", &m), "match_start")
    var ci: regex.Regex = pyre.compile("hello", regex.REGEX_ICASE)
    testkit.check(regex.regex_is_match(&ci, "HeLLo"), "compile flags")
    // escape
    testkit.check(pyre.escape("a.b*c d") == "a\\.b\\*c\\ d" && pyre.escape("äx_1") == "äx_1", "escape")
    // a bad pattern does not trap
    var bad: regex.Regex = pyre.compile("(", 0)
    testkit.check(!regex.regex_is_match(&bad, "("), "bad pattern never matches")
    // bad octets in the text
    pyre.findall(&word, "äÃ ab@cd ÿ", &v)
    testkit.check(vec_len[str](&v) == 1, "findall over stray octets")
    pyre.split(&sep, "a,Ã,b", &v)
    testkit.check(vec_len[str](&v) == 3, "split over stray octets")
    return testkit.finish()
}
