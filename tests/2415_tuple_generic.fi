// expect_exit: 0
// Round TUPLES: tuples and generics. A generic function returns a tuple of its
// type parameter, a generic struct holds a tuple, and `Vec` of pairs works
// like `Vec` of anything else: the type argument `(i32, i32)` is one type.
import std.vec

struct Box[T] { v: T }

type Pair = (i32, i32)

fn swap[T](a: T, b: T) -> (T, T) {
    return (b, a)
}

fn both[A, B](a: A, b: B) -> (A, B) {
    return (a, b)
}

fn main() -> i32 {
    let (x, y) = swap[i32](3, 4)
    if x != 4 || y != 3 {
        return 1
    }
    let (n, flag) = both[i64, bool](7, true)
    if n != 7 || !flag {
        return 2
    }
    let bx = Box[(i32, i32)] { v: (8, 9) }
    if bx.v.1 != 9 {
        return 3
    }
    // the same instantiation under another spelling
    let by: Box[Pair] = bx
    if by.v.0 != 8 {
        return 4
    }
    // a list of pairs
    var v: Vec[(i32, i32)] = vec_new[(i32, i32)]()
    defer vec_free[(i32, i32)](&v)
    vec_push[(i32, i32)](&v, (1, 10))
    vec_push[(i32, i32)](&v, (2, 20))
    vec_push[(i32, i32)](&v, (3, 30))
    var sum: i32 = 0
    var i: usize = 0
    while i < vec_len[(i32, i32)](&v) {
        let (a, b) = *vec_elem_ptr[(i32, i32)](&v, i)
        sum = sum + a * b
        i = i + 1
    }
    if sum != 10 + 40 + 90 {
        return 5
    }
    // a tuple of tuples through a generic
    let (p, q) = swap[(i32, i32)]((1, 2), (3, 4))
    if p.0 != 3 || q.1 != 2 {
        return 6
    }
    return 0
}
