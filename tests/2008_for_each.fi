// expect_exit: 0
// ROUND REF4: `for x in array { ... }` walks the elements of an array (a copy
// per round). The array may be a local, a field, an array behind `&` /
// `inout`, or behind a pointer; `break` and `continue` work as usual.
struct Bag { items: [i64; 4], n: i64 }

fn total(a: &[i64; 4]) -> i64 {
    var s: i64 = 0
    for x in a {
        s += x
    }
    return s
}

fn double_all(a: inout [i64; 4]) {
    var i: usize = 0
    for x in a {
        a[i] = x * 2
        i += 1
    }
}

fn first_big(b: *Bag) -> i64 {
    for x in (*b).items {
        if x > 10 { return x }
    }
    return -1
}

fn main() -> i32 {
    var v: [i64; 4] = [1, 2, 3, 4]
    var sum: i64 = 0
    for x in v {
        sum += x
    }
    if sum != 10 { return 1 }
    if total(&v) != 10 { return 2 }
    double_all(inout v)
    if v[3] != 8 { return 3 }
    var b: Bag = Bag { items: [5, 15, 25, 35], n: 4 }
    if first_big(&b) != 15 { return 4 }
    var count: i64 = 0
    for x in b.items {
        if x == 15 { continue }
        if x == 35 { break }
        count += 1
    }
    // 5 counted, 15 skipped, 25 counted, 35 stops
    if count != 2 { return 5 }
    // nested: the hidden counters do not clash
    var pairs: i64 = 0
    let small: [u8; 3] = [1, 2, 3]
    for p in small {
        for q in small {
            if p < q { pairs += 1 }
        }
    }
    if pairs != 3 { return 6 }
    // an array of arrays
    let grid: [[i64; 2]; 2] = [[1, 2], [3, 4]]
    var g: i64 = 0
    for row in grid {
        for c in row {
            g = g * 10 + c
        }
    }
    if g != 1234 { return 7 }
    return 0
}
