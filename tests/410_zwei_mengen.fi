// expect_exit: 0
// Zwei Fehlermengen nebeneinander; die Codes beginnen je Menge bei 1.
error Lesen { Ende, Kaputt }
error Schreiben { Voll }

fn lies(n: i32) -> Lesen!i32 {
    if n == 0 {
        return Lesen::Ende
    }
    if n < 0 {
        return Lesen::Kaputt
    }
    return n
}

fn schreib(n: i32) -> Schreiben!i32 {
    if n > 100 {
        return Schreiben::Voll
    }
    return n
}

fn main() -> i32 {
    if (lies(4) catch 0) != 4 {
        return 1
    }
    if (lies(0) catch 0 - 1) != 0 - 1 {
        return 2
    }
    if (schreib(101) catch 0 - 2) != 0 - 2 {
        return 3
    }
    if (schreib(9) catch 0) != 9 {
        return 4
    }
    return 0
}
