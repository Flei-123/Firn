// expect_exit: 0
import std.rt
import mc.mc_precip
import mc.mc_registry
import mc.mc_world
import mc.mc_chunk
import mc.mc_render_world
import mc.v763.mc_reg_v763

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn kind_of(name: str) -> i32 {
    return mc_precip.precip_kind_by_name(name.p as u64, name.n)
}

fn biome_id(reg: *mut mc_registry.Registry, name: str) -> i32 {
    var i: i32 = 0
    while i < mc_registry.reg_biome_count(reg) {
        var nl: usize = 0
        let np: u64 = mc_registry.reg_biome_name(reg, i, &nl)
        if nl == name.n && rt.mem_eq(np, name.p as u64, nl) { return mc_registry.reg_biome_id(reg, i) }
        i = i + 1
    }
    return 0 - 1
}

fn main() -> i32 {
    check(kind_of("desert") == 0 && kind_of("badlands") == 0 && kind_of("savanna") == 0, 1)
    check(kind_of("plains") == 1 && kind_of("taiga") == 1 && kind_of("jungle") == 1, 2)
    check(kind_of("snowy_plains") == 2 && kind_of("frozen_peaks") == 2 && kind_of("snowy_taiga") == 2, 3)
    check(kind_of("minecraft:snowy_beach") == 2 && kind_of("minecraft:plains") == 1, 4)
    check(kind_of("no_such_biome") == 0 - 1, 5)

    var reg: mc_registry.Registry = mc_reg_v763.registry_make()
    let snowy: i32 = biome_id(&reg, "snowy_plains")
    let plains: i32 = biome_id(&reg, "plains")
    let desert: i32 = biome_id(&reg, "desert")
    check(snowy >= 0 && plains >= 0 && desert >= 0, 6)
    check(mc_precip.precip_biome_kind(&reg, snowy) == mc_precip.PRECIP_SNOW, 7)
    check(mc_precip.precip_biome_kind(&reg, plains) == mc_precip.PRECIP_RAIN, 8)
    check(mc_precip.precip_biome_kind(&reg, desert) == mc_precip.PRECIP_NONE, 9)
    check(mc_precip.precip_biome_kind(&reg, 0 - 1) == mc_precip.PRECIP_RAIN, 10)

    let b_air: i32 = mc_registry.reg_block_by_name(&reg, "air".p as u64, 3)
    let b_stone: i32 = mc_registry.reg_block_by_name(&reg, "stone".p as u64, 5)
    let b_water: i32 = mc_registry.reg_block_by_name(&reg, "water".p as u64, 5)
    let b_grass: i32 = mc_registry.reg_block_by_name(&reg, "short_grass".p as u64, 11)
    let st_air: i32 = mc_registry.reg_block_default_state(&reg, b_air)
    let st_stone: i32 = mc_registry.reg_block_default_state(&reg, b_stone)
    let st_water: i32 = mc_registry.reg_block_default_state(&reg, b_water)
    check(b_air >= 0 && b_stone >= 0 && b_water >= 0, 11)
    var st_plant: i32 = st_air
    if b_grass >= 0 { st_plant = mc_registry.reg_block_default_state(&reg, b_grass) }

    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, st_air as u16)
        i = i + 1
    }
    var z: usize = 0
    while z < 16 {
        var x: usize = 0
        while x < 8 {
            rt.st16(ids, 10 * 256 + z * 16 + x, st_stone as u16)
            x = x + 1
        }
        z = z + 1
    }
    rt.st16(ids, 20 * 256 + 2 * 16 + 12, st_water as u16)
    rt.st16(ids, 6 * 256 + 5 * 16 + 14, st_plant as u16)
    var w: mc_world.World = mc_world.world_new()
    check(mc_world.world_put(&w, mc_render_world.wr_make_chunk(0, 0, 2, ids)), 12)

    var p: mc_precip.Precip = mc_precip.precip_new()
    check(mc_precip.precip_covered(&p, &w, &reg, 0, 2, 5, 2), 13)
    check(!mc_precip.precip_covered(&p, &w, &reg, 0, 12, 5, 5), 14)
    check(mc_precip.precip_covered(&p, &w, &reg, 0, 12, 5, 2), 15)
    check(!mc_precip.precip_covered(&p, &w, &reg, 0, 12, 21, 2), 16)
    check(!mc_precip.precip_covered(&p, &w, &reg, 0, 14, 5, 5), 17)
    check(!mc_precip.precip_covered(&p, &w, &reg, 0, 500, 5, 2), 18)
    check(mc_precip.precip_biome_at(&w, 0, 2, 5, 2) == 0 - 1, 19)

    mc_precip.precip_update(&p, &w, &reg, 0, 12.5, 5.5, 5.5, 1000 as u64)
    check(!p.covered && p.exposure == 1000 && p.kind == mc_precip.PRECIP_RAIN, 20)
    mc_precip.precip_update(&p, &w, &reg, 0, 2.5, 5.5, 2.5, 1100 as u64)
    check(!p.covered && p.exposure == 1000, 21)
    mc_precip.precip_update(&p, &w, &reg, 0, 2.5, 5.5, 2.5, 1300 as u64)
    check(p.covered && p.exposure == 750, 22)
    mc_precip.precip_update(&p, &w, &reg, 0, 2.5, 5.5, 2.5, 1600 as u64)
    mc_precip.precip_update(&p, &w, &reg, 0, 2.5, 5.5, 2.5, 1900 as u64)
    mc_precip.precip_update(&p, &w, &reg, 0, 2.5, 5.5, 2.5, 2200 as u64)
    check(p.exposure == 180 && mc_precip.precip_exposure(&p) == 180, 23)
    mc_precip.precip_update(&p, &w, &reg, 0, 12.5, 5.5, 5.5, 2500 as u64)
    check(!p.covered && p.exposure == 430, 24)

    var sec: *mut mc_chunk.Section = mc_chunk.chunk_section(mc_world.world_find(&w, 0, 0) as *mut mc_chunk.Chunk, 0)
    let pal: u64 = rt.heap_alloc(2)
    rt.st16(pal, 0, snowy as u16)
    (*sec).biomes = mc_chunk.Container { bits: 0 as u32, pal_n: 1 as u32, pal: pal, data: 0, words: 0 }
    check(mc_precip.precip_biome_at(&w, 0, 2, 5, 2) == snowy, 25)
    mc_precip.precip_update(&p, &w, &reg, 0, 12.5, 5.5, 5.5, 3000 as u64)
    check(p.kind == mc_precip.PRECIP_SNOW && p.biome == snowy, 26)
    rt.st16(pal, 0, desert as u16)
    mc_precip.precip_update(&p, &w, &reg, 0, 12.5, 5.5, 5.5, 3500 as u64)
    check(p.kind == mc_precip.PRECIP_NONE, 27)
    return 0
}
