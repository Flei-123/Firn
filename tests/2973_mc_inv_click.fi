// expect_exit: 0
// mc_inv Click Container (window 0): the packet body follows the generated schema of every version (walk = consumed exactly), and the
// local prediction matches vanilla for pick up / put down / split / merge / swap / drop / hotbar swap / drop outside.
// Return codes: 1xx = setup, 2xx = packet layout, 3xx = prediction.
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_schema
import mc.mc_inv

fn layout(ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let id: i32 = mc_version.version_pid(ver, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK)
    if id < 0 { return false }
    let sch: u64 = (*ver).schema_of(mc_version.ST_PLAY, mc_version.DIR_C2S, id)
    if sch == 0 as u64 { return false }
    bytes.bytes_set_pos(b, 0)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk(sch, b, &out)
    rt.buf_free(&out)
    return ok
}

// one click; the packet must parse with the version's schema
fn click(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32) -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(v, (*ver).protocol, slot, button, mode, &b) { return 1 }
    let ok: bool = layout(ver, &b)
    bytes.bytes_free(&b)
    if !ok { return 2 }
    return 0
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_set(&v, 37, 1, 32) // stone x32 in hotbar 1
    mc_inv.inv_set(&v, 36, 7, 1) // a pickaxe in hotbar 0
    if click(&v, &ver, 37, 0, 0) != 0 { return 200 } // pick up
    if mc_inv.inv_cursor_item(&v) != 1 || mc_inv.inv_cursor_count(&v) != 32 || mc_inv.inv_item(&v, 37) != 0 - 1 { return 300 }
    if click(&v, &ver, 10, 0, 0) != 0 { return 201 } // put down
    if mc_inv.inv_cursor_item(&v) != 0 - 1 || mc_inv.inv_item(&v, 10) != 1 || mc_inv.inv_count(&v, 10) != 32 { return 301 }
    if click(&v, &ver, 10, 1, 0) != 0 { return 202 } // right click: take half
    if mc_inv.inv_cursor_count(&v) != 16 || mc_inv.inv_count(&v, 10) != 16 { return 302 }
    if click(&v, &ver, 11, 0, 0) != 0 { return 203 }
    if mc_inv.inv_count(&v, 11) != 16 || mc_inv.inv_cursor_item(&v) != 0 - 1 { return 303 }
    if click(&v, &ver, 10, 0, 4) != 0 { return 204 } // drop one from slot 10
    if mc_inv.inv_count(&v, 10) != 15 || mc_inv.inv_count(&v, 11) != 16 { return 304 }
    if click(&v, &ver, 10, 1, 0) != 0 { return 205 } // 15 -> take 8, 7 stay
    if mc_inv.inv_cursor_count(&v) != 8 || mc_inv.inv_count(&v, 10) != 7 { return 305 }
    if click(&v, &ver, 11, 1, 0) != 0 { return 206 } // right click with a stack on the same item: put one
    if mc_inv.inv_count(&v, 11) != 17 || mc_inv.inv_cursor_count(&v) != 7 { return 306 }
    if click(&v, &ver, 10, 0, 0) != 0 { return 207 } // left click on the same item: merge
    if mc_inv.inv_count(&v, 10) != 14 || mc_inv.inv_cursor_item(&v) != 0 - 1 { return 307 }
    if click(&v, &ver, 36, 0, 0) != 0 { return 208 } // pick up the pickaxe
    if click(&v, &ver, 10, 0, 0) != 0 { return 209 } // swap with the stone stack
    if mc_inv.inv_item(&v, 10) != 7 || mc_inv.inv_cursor_item(&v) != 1 || mc_inv.inv_cursor_count(&v) != 14 { return 308 }
    if click(&v, &ver, 0 - 999, 1, 0) != 0 { return 210 } // outside, right: drop one of the carried stack
    if mc_inv.inv_cursor_count(&v) != 13 { return 309 }
    if click(&v, &ver, 0 - 999, 0, 0) != 0 { return 211 } // outside, left: drop all
    if mc_inv.inv_cursor_item(&v) != 0 - 1 { return 310 }
    if click(&v, &ver, 11, 0, 2) != 0 { return 212 } // hotbar swap: slot 11 <-> hotbar 0
    if mc_inv.inv_item(&v, 36) != 1 || mc_inv.inv_count(&v, 36) != 17 || mc_inv.inv_item(&v, 11) != 0 - 1 { return 311 }
    if click(&v, &ver, 10, 0, 1) != 0 { return 213 } // shift click: the pickaxe goes to the first free hotbar slot (36 holds stone, 37 is free)
    if mc_inv.inv_item(&v, 10) != 0 - 1 || mc_inv.inv_item(&v, 37) != 7 { return 312 }
    if click(&v, &ver, 0, 0, 0) != 0 { return 214 } // crafting result: not predicted
    if v.state_id != 5 { return 313 }
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    // packet bytes of one click for 1.20.1: window 0, stateId 5, slot 37, left, mode 0, 1 change (37 empty), carried stone x32
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &ver) { return 1 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_set(&v, 37, 1, 32)
    var b: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(&v, 763, 37, 0, 0, &b) { return 2 }
    let want: [u8; 14] = [0 as u8, 5 as u8, 0 as u8, 37 as u8, 0 as u8, 0 as u8, 1 as u8, 0 as u8, 37 as u8, 0 as u8, 1 as u8, 1 as u8, 32 as u8, 0 as u8]
    if bytes.bytes_len(&b) != 14 { return 3 }
    var i: usize = 0
    while i < 14 {
        if bytes.bytes_at(&b, i) != want[i] { return 10 + (i as i32) }
        i = i + 1
    }
    if mc_inv.inv_click_kind(754) != 1 || mc_inv.inv_click_kind(769) != 2 || mc_inv.inv_click_kind(770) != 3 || mc_inv.inv_click_kind(340) != 0 { return 4 }
    var nb: bytes.Bytes = bytes.bytes_new()
    if mc_inv.inv_click_build(&v, 340, 37, 0, 0, &nb) { return 5 }
    var r: i32 = check(754)
    if r != 0 { return 1000 + r }
    r = check(758)
    if r != 0 { return 2000 + r }
    r = check(763)
    if r != 0 { return 3000 + r }
    r = check(764)
    if r != 0 { return 4000 + r }
    r = check(767)
    if r != 0 { return 5000 + r }
    r = check(769)
    if r != 0 { return 6000 + r }
    r = check(772)
    if r != 0 { return 7000 + r }
    r = check(774)
    if r != 0 { return 8000 + r }
    r = check(775)
    if r != 0 { return 9000 + r }
    return 0
}
