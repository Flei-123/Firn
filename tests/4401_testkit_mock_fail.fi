// expect_exit: 101
// tests/4401_testkit_mock_fail.fi -- a wrong call count fails the test (exit 101).
import std.rt
import std.mock
import std.testkit

fn main() -> i32 {
    if !gc_init() { return 1 }
    var spy: mock.Spy = mock.spy_new()
    mock.spy_call1(&spy, 5)
    mock.assert_calls(&spy, 2)
    testkit.fail("assert_calls did not stop the program")
    return 0
}
