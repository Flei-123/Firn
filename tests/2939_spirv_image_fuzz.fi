// expect_exit: 0
// tests/2939_spirv_image_fuzz.fi -- gpu.spirv images/samplers/quad/pack robustness: tex.frag + pack.frag, 3000 mutations each (random words replaced, bits
// flipped, small values). spv_new / spv_find_* / spv_run must end with true or an error code -- never crash, hang or trip
// an arithmetic check (dev-fast checks overflow). Also counts how many mutants still load, to show the mutator bites.
import std.rt
import std.math
import gpu.spirv

const S0: str = __include_str("../lib/gpu/spv/test/tex.frag.spv")
const S1: str = __include_str("../lib/gpu/spv/test/pack.frag.spv")

static mut seed: u64 = 88172645463325252

fn rnd() -> u64 {
    seed = seed ^ (seed << 13 as u64)
    seed = seed ^ (seed >> 7 as u64)
    seed = seed ^ (seed << 17 as u64)
    return seed
}

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn fuzz(src: u64, n: usize, rounds: usize, loaded: *mut i32, ran: *mut i32, px: u64) {
    let cp: u64 = rt.heap_alloc(n)
    let nw: usize = n / 4
    var r: usize = 0
    while r < rounds {
        rt.mem_copy(cp, src, n)
        let edits: usize = 1 + (rnd() % 3) as usize
        var e: usize = 0
        while e < edits {
            let at: usize = 5 + (rnd() % ((nw - 5) as u64)) as usize
            let kind: u64 = rnd() % 4
            var v: u32 = rt.ld32(cp, at)
            if kind == 0 {
                v = (rnd() & 0xffffffff) as u32
            }
            if kind == 1 {
                v = v ^ (1 << ((rnd() % 32) as u32))
            }
            if kind == 2 {
                v = (rnd() % 256) as u32
            }
            if kind == 3 {
                v = v +% (rnd() % 5) as u32
            }
            rt.st32(cp, at, v)
            e = e + 1
        }
        var m: spirv.Spv = spirv.spv_zero()
        if spirv.spv_new(cp, n, &m) {
            *loaded = *loaded + 1
            // wild but legal host data: random inputs, textures of odd sizes, every sampler setting
            spirv.spv_tex_set(&m, 0, 0, px, 1 + (rnd() % 16) as usize, 1 + (rnd() % 16) as usize)
            spirv.spv_tex_set_level(&m, 0, 1, px, 1 + (rnd() % 8) as usize, 1 + (rnd() % 8) as usize)
            spirv.spv_tex_set(&m, 1, 1, px, 4, 4)
            spirv.spv_sampler_set(&m, 0, (rnd() % 2) as u32, (rnd() % 2) as u32, (rnd() % 3) as u32, (rnd() % 4) as u32, (rnd() % 4) as u32)
            spirv.spv_sampler_set(&m, 2, (rnd() % 2) as u32, (rnd() % 2) as u32, (rnd() % 3) as u32, (rnd() % 4) as u32, (rnd() % 4) as u32)
            let quad: bool = rnd() % 2 == 0 && spirv.spv_quad_enable(&m)
            var l: usize = 0
            while l < 4 {
                spirv.spv_lane(&m, l)
                var loc: u32 = 0
                while loc < 3 {
                    let p: usize = spirv.spv_find_location(&m, 1, loc)
                    if p != spirv.SPV_NONE {
                        var k: usize = 0
                        while k < 4 {
                            var w: u32 = (rnd() & 0xffffffff) as u32
                            if rnd() % 2 == 0 {
                                w = math.math_bits32(((rnd() % 4000) as f32 - 1000.0) / 64.0)
                            }
                            spirv.spv_mem_set(&m, p, k, w)
                            k = k + 1
                        }
                    }
                    loc = loc + 1
                }
                l = l + 1
            }
            let ent: u32 = spirv.spv_find_entry(&m, 4)
            if ent != 0 {
                if quad {
                    spirv.spv_run_quad(&m, ent, 20000)
                } else {
                    spirv.spv_lane(&m, 0)
                    spirv.spv_run(&m, ent, 20000)
                }
                *ran = *ran + 1
                spirv.spv_reset(&m)
            }
            spirv.spv_find_builtin(&m, 3, 0)
            spirv.spv_free(&m)
        }
        r = r + 1
    }
    rt.heap_free(cp, n)
}

fn main() -> i32 {
    let px: u64 = rt.heap_alloc(16 * 16 * 4 * 4)
    rt.mem_set(px, 77, 16 * 16 * 4 * 4)
    var loaded: i32 = 0
    var ran: i32 = 0
    fuzz(S0.p as u64, S0.n, 3000, &loaded, &ran, px)
    fuzz(S1.p as u64, S1.n, 3000, &loaded, &ran, px)
    check(loaded > 1500 && loaded < 6000, 1)
    check(ran > 1000, 2)
    return 0
}
