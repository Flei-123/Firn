// expect_exit: 0
// tests/1610_hash_map.fi -- ROUND 81: `lib/std/hash.fi` and the octet keys
// of `lib/std/map.fi`.
//
// WHAT IS CHECKED, and why exactly that:
//
//   A  THE PUBLISHED HASH VECTORS. FNV-1a of "", "a" and "foobar" and
//      xxHash64 of "" are written down in their specifications; if this
//      file computes something else, everything built on top of it is
//      wrong in a way no round trip test would ever notice.
//   B  A key that was INSERTED comes back with ITS value, a key that was
//      never inserted is NOT found. The second half is the one that
//      matters -- a map that answers `true` to everything passes the first.
//   C  DELETION really removes, and a lookup does NOT stop at the
//      tombstone: the keys behind it in the same probe chain must still be
//      findable. That is the classic bug of open addressing, and it is
//      provoked here on purpose by deleting every second key.
//   D  THE EMPTY KEY is a key. Length 0 is not "missing".
//   E  KEYS THAT SHARE A PREFIX. "a", "aa", "aaa"... must not be confused;
//      a comparison that only checks the length or only the first octets
//      would.
//   F  ITERATION sees every entry exactly once, and inserting the same key
//      twice does not make the map grow.
//   G  `Set[K]` reports whether the element was NEW, and `BSet` the same
//      for octet sequences.
import std.hash
import std.map
import std.rt
import std.io

fn spanlen(p: u64) -> usize {
    return rt.c_length(p)
}

fn main() -> i32 {
    // --- A: the vectors out of the specifications
    var s_empty: [u8; 1] = "\0"
    var s_a: [u8; 2] = "a\0"
    var s_foo: [u8; 7] = "foobar\0"
    if hash.fnv1a64((&s_empty[0]) as u64, 0) != 14695981039346656037 as u64 {
        return 10
    }
    if hash.fnv1a64((&s_a[0]) as u64, 1) != 12638187200555641996 as u64 {
        return 11
    }
    if hash.fnv1a64((&s_foo[0]) as u64, 6) != 9625390261332436968 as u64 {
        return 12
    }
    if hash.xx64((&s_empty[0]) as u64, 0) != 17241709254077376921 as u64 {
        return 13
    }
    // the same input with two different seeds must not give the same value
    if hash.xx64_seed((&s_foo[0]) as u64, 6, 0)
    == hash.xx64_seed((&s_foo[0]) as u64, 6, 1) {
        return 14
    }
    // the scalar mixer spreads: 0 and 1 must not land next to each other
    let m0: u64 = hash.hash_mix64(0)
    let m1: u64 = hash.hash_mix64(1)
    if m0 == m1 {
        return 15
    }

    // --- B/C/D/E/F: the map
    var m: BMap[u64] = bmap_new[u64]()
    var key: [u8; 24] = [0; 24]
    let kp: u64 = (&key[0]) as u64

    var i: usize = 0
    while i < 4000 {
        var n: usize = 0
        var x: usize = i
        rt.st8(kp, 0, 107 as u8) // 'k'
        n = 1
        while true {
            rt.st8(kp, n, (48 + (x % 10)) as u8)
            n = n + 1
            x = x / 10
            if x == 0 {
                break
            }
        }
        if !bmap_set[u64](&m, kp, n, (i * 7 + 3) as u64) {
            return 20
        }
        i = i + 1
    }
    if bmap_len[u64](&m) != 4000 {
        return 21
    }

    // B: everything comes back, nothing else is there
    i = 0
    while i < 4000 {
        var n: usize = 1
        var x: usize = i
        rt.st8(kp, 0, 107 as u8)
        while true {
            rt.st8(kp, n, (48 + (x % 10)) as u8)
            n = n + 1
            x = x / 10
            if x == 0 {
                break
            }
        }
        var v: u64 = 0
        if !bmap_get_if[u64](&m, kp, n, &v) {
            return 22
        }
        if v != (i * 7 + 3) as u64 {
            return 23
        }
        // the same digits with a DIFFERENT first octet must not hit
        rt.st8(kp, 0, 108 as u8) // 'l'
        if bmap_has[u64](&m, kp, n) {
            return 24
        }
        i = i + 1
    }

    // F: inserting again overwrites, it does not add
    rt.st8(kp, 0, 107 as u8)
    rt.st8(kp, 1, 49 as u8)
    if !bmap_set[u64](&m, kp, 2, 999) {
        return 25
    }
    if bmap_len[u64](&m) != 4000 {
        return 26
    }
    if bmap_get[u64](&m, kp, 2) != 999 {
        return 27
    }

    // D: the empty key
    if bmap_has[u64](&m, kp, 0) {
        return 28
    }
    if !bmap_set[u64](&m, kp, 0, 4242) {
        return 29
    }
    if bmap_get[u64](&m, kp, 0) != 4242 {
        return 30
    }
    if bmap_len[u64](&m) != 4001 {
        return 31
    }

    // E: keys that share a prefix
    var pre: [u8; 9] = "aaaaaaaa\0"
    i = 1
    while i <= 8 {
        if !bmap_set[u64](&m, (&pre[0]) as u64, i, (1000 + i) as u64) {
            return 32
        }
        i = i + 1
    }
    i = 1
    while i <= 8 {
        if bmap_get[u64](&m, (&pre[0]) as u64, i) != (1000 + i) as u64 {
            return 33
        }
        i = i + 1
    }

    // F: iteration sees everything exactly once
    var seen: usize = 0
    var sum: u64 = 0
    var it: usize = bmap_first[u64](&m)
    while it < bmap_cap[u64](&m) {
        seen = seen + 1
        sum = sum + bmap_slot_value[u64](&m, it)
        if bmap_key_len[u64](&m, it) > 23 {
            return 34
        }
        it = bmap_next[u64](&m, it + 1)
    }
    if seen != bmap_len[u64](&m) {
        return 35
    }

    // C: delete every second key -- and the rest stays FINDABLE
    i = 0
    while i < 4000 {
        var n: usize = 1
        var x: usize = i
        rt.st8(kp, 0, 107 as u8)
        while true {
            rt.st8(kp, n, (48 + (x % 10)) as u8)
            n = n + 1
            x = x / 10
            if x == 0 {
                break
            }
        }
        if !bmap_delete[u64](&m, kp, n) {
            return 36
        }
        if bmap_delete[u64](&m, kp, n) {
            return 37 // deleting twice must not work
        }
        i = i + 2
    }
    i = 1
    while i < 4000 {
        var n: usize = 1
        var x: usize = i
        rt.st8(kp, 0, 107 as u8)
        while true {
            rt.st8(kp, n, (48 + (x % 10)) as u8)
            n = n + 1
            x = x / 10
            if x == 0 {
                break
            }
        }
        if !bmap_has[u64](&m, kp, n) {
            return 38 // a lookup stopped at a tombstone
        }
        i = i + 2
    }
    // the probe chains stay bounded
    if bmap_probe_max[u64](&m) >= bmap_cap[u64](&m) {
        return 39
    }
    if !bmap_cleanup[u64](&m) {
        return 40
    }
    if bmap_dead[u64](&m) != 0 {
        return 41
    }
    i = 1
    while i < 100 {
        var n: usize = 1
        var x: usize = i
        rt.st8(kp, 0, 107 as u8)
        while true {
            rt.st8(kp, n, (48 + (x % 10)) as u8)
            n = n + 1
            x = x / 10
            if x == 0 {
                break
            }
        }
        if !bmap_has[u64](&m, kp, n) {
            return 42 // cleanup lost an entry
        }
        i = i + 2
    }
    bmap_free[u64](&m)

    // --- G: Set[K] and BSet
    var s: Set[u32] = set_new[u32]()
    var added: bool = false
    if !set_add[u32](&s, 42 as u32, &added) || !added {
        return 50
    }
    if !set_add[u32](&s, 42 as u32, &added) || added {
        return 51
    }
    if set_len[u32](&s) != 1 {
        return 52
    }
    if !set_has[u32](&s, 42 as u32) || set_has[u32](&s, 43 as u32) {
        return 53
    }
    if !set_remove[u32](&s, 42 as u32) || set_has[u32](&s, 42 as u32) {
        return 54
    }
    set_free[u32](&s)

    var bs: map.BSet = map.bset_new()
    var w1: [u8; 6] = "hallo\0"
    if !map.bset_add(&bs, (&w1[0]) as u64, 5, &added) || !added {
        return 55
    }
    if !map.bset_add(&bs, (&w1[0]) as u64, 5, &added) || added {
        return 56
    }
    if map.bset_has(&bs, (&w1[0]) as u64, 4) {
        return 57 // a prefix is not the element
    }
    if map.bset_len(&bs) != 1 {
        return 58
    }
    map.bset_free(&bs)

    var out: [u8; 8] = "hash ok\0"
    io.print_line_bytes((&out[0]) as u64, 7)
    return 0
}
