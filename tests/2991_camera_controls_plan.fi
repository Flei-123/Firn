// expect_out: ok
// tests/2991_camera_controls_plan.fi -- plat.android.focusplan: tap_region (rotation / mirror / zoom / clamping),
// zoom_crop, zoom_pick (lens choice by zoom). The camera itself needs a device (tools/android/camera_controls_check.sh).
import std.io
import plat.android.focusplan

fn near(a: i32, b: i32) -> bool {
    var d: i32 = a - b
    if d < 0 { d = 0 - d }
    return d <= 2
}

fn main() -> i32 {
    var r: [i32; 4] = [0; 4]
    let p: u64 = (&r[0]) as u64
    // centre tap, no rotation: centred box in a 4000x3000 array
    if !focusplan.tap_region(0.5f, 0.5f, 0, false, 1.0f, 4000, 3000, 0.2f, p) { io.print("centre"); return 1 }
    if !near(r[0], 1700) || !near(r[2], 2300) || !near(r[1], 1200) || !near(r[3], 1800) { io.print("centre box"); return 2 }
    // top-left tap of the upright picture, rot 0 -> top-left of the sensor, clamped at 0
    focusplan.tap_region(0.0f, 0.0f, 0, false, 1.0f, 4000, 3000, 0.2f, p)
    if r[0] != 0 || r[1] != 0 { io.print("clamp"); return 3 }
    // rot 90: upright top-left corner = sensor bottom-left (sx=0, sy=1)
    focusplan.tap_region(0.0f, 0.0f, 90, false, 1.0f, 4000, 3000, 0.2f, p)
    if r[0] != 0 || r[3] != 2999 { io.print("rot90"); return 4 }
    // rot 270: upright top-left = sensor top-right
    focusplan.tap_region(0.0f, 0.0f, 270, false, 1.0f, 4000, 3000, 0.2f, p)
    if r[2] != 3999 || r[1] != 0 { io.print("rot270"); return 5 }
    // rot 180: upright top-left = sensor bottom-right
    focusplan.tap_region(0.0f, 0.0f, 180, false, 1.0f, 4000, 3000, 0.2f, p)
    if r[2] != 3999 || r[3] != 2999 { io.print("rot180"); return 6 }
    // mirror flips x before the rotation: upright top-right mirrored = top-left (rot 0)
    focusplan.tap_region(1.0f, 0.0f, 0, true, 1.0f, 4000, 3000, 0.2f, p)
    if r[0] != 0 || r[1] != 0 { io.print("mirror"); return 7 }
    // 2x zoom: the visible window is the centre half; the picture's right edge maps to 3/4 of the array
    focusplan.tap_region(1.0f, 0.5f, 0, false, 2.0f, 4000, 3000, 0.2f, p)
    if !near((r[0] + r[2]) / 2, 3000) { io.print("zoom x"); return 8 }
    // outside / bad array
    if focusplan.tap_region(1.5f, 0.5f, 0, false, 1.0f, 4000, 3000, 0.2f, p) { io.print("range"); return 9 }
    if focusplan.tap_region(0.5f, 0.5f, 0, false, 1.0f, 0, 0, 0.2f, p) { io.print("array"); return 10 }
    // crop
    focusplan.zoom_crop(2.0f, 4000, 3000, p)
    if r[0] != 1000 || r[1] != 750 || r[2] != 2000 || r[3] != 1500 { io.print("crop"); return 11 }
    focusplan.zoom_crop(0.5f, 4000, 3000, p)
    if r[0] != 0 || r[2] != 4000 { io.print("crop <1"); return 12 }
    // lens pick: ultra wide 13 mm, main 24, tele 72 (35 mm equivalent), one front lens excluded (0)
    var eq: [f32; 4] = [24.0f, 13.0f, 72.0f, 0.0f]
    let q: u64 = (&eq[0]) as u64
    var ratio: f32 = 0.0f
    let rp: u64 = (&ratio) as u64
    if focusplan.zoom_pick(q, 4, 0, 1.0f, rp) != 0 || ratio != 1.0f { io.print("pick 1x"); return 13 }
    if focusplan.zoom_pick(q, 4, 0, 2.0f, rp) != 0 || ratio != 2.0f { io.print("pick 2x"); return 14 }
    if focusplan.zoom_pick(q, 4, 0, 3.0f, rp) != 2 || ratio != 1.0f { io.print("pick 3x"); return 15 }
    if focusplan.zoom_pick(q, 4, 0, 5.0f, rp) != 2 || !(ratio > 1.66f && ratio < 1.67f) { io.print("pick 5x"); return 16 }
    if focusplan.zoom_pick(q, 4, 0, 0.5f, rp) != 1 || !(ratio > 0.92f && ratio < 0.93f) { io.print("pick 0.5x"); return 17 }
    if focusplan.zoom_pick(q, 4, 0, 0.3f, rp) != 1 { io.print("pick tiny"); return 18 }
    if focusplan.zoom_pick(q, 4, 3, 1.0f, rp) != 0 - 1 { io.print("pick ref 0"); return 19 }
    io.print("ok")
    return 0
}
