// expect_exit: 0
// tests/2181_compress_zstd.fi -- lib/compress/zstd.fi and zstd_enc.fi: frames
// made by the zstd command line (levels 1, 3, 19; with and without the
// checksum; a skippable frame between two frames; an empty frame; zeros;
// incompressible data; records with a trained dictionary) decoded octet for
// octet; refusals (cut, flipped, no/wrong dictionary, window, limit, bomb);
// the encoder at every level and with each entropy coder switched on and off,
// with dictionaries, in pieces, round-tripped through the decoder (and, over
// a much larger corpus and in the other direction, through libzstd by
// tools/compress/check.py); the streaming reader from a descriptor.
import compress.common
import compress.zstd
import compress.zstd_enc
import std.rt
import std.io
import std.fs

const PLAIN: str = __include_str("data/compress/plain.bin")
const MIX: str = __include_str("data/compress/mix.bin")
const RANDOM: str = __include_str("data/compress/random.bin")
const REC: str = __include_str("data/compress/record.bin")
const REC2: str = __include_str("data/compress/record2.bin")
const DICT: str = __include_str("data/compress/dict.zdict")
const F_L3: str = __include_str("data/compress/plain.zst")
const F_L1: str = __include_str("data/compress/plain_l1.zst")
const F_L19: str = __include_str("data/compress/plain_l19.zst")
const F_NOCHK: str = __include_str("data/compress/plain_nochk.zst")
const F_MULTI: str = __include_str("data/compress/plain_multi.zst")
const F_EMPTY: str = __include_str("data/compress/empty.zst")
const F_ZEROS: str = __include_str("data/compress/zeros.zst")
const F_RANDOM: str = __include_str("data/compress/random.zst")
const F_REC: str = __include_str("data/compress/record.zst")
const F_REC_DICT: str = __include_str("data/compress/record_dict.zst")
const F_REC2_DICT: str = __include_str("data/compress/record2_dict.zst")

struct Tally {
    total: i64,
    fails: i64,
}

fn check(t: *mut Tally, what: str, ok: bool) {
    (*t).total = (*t).total + 1
    if !ok {
        (*t).fails = (*t).fails + 1
        io.print("FAIL ")
        io.print_line(what)
    }
}

static mut code: u32 = 0

fn why(e: CompressError) -> usize {
    if e == CompressError::Data { code = 1 }
    if e == CompressError::Format { code = 2 }
    if e == CompressError::Checksum { code = 3 }
    if e == CompressError::Truncated { code = 4 }
    if e == CompressError::TooLarge { code = 5 }
    if e == CompressError::OutOfMemory { code = 6 }
    if e == CompressError::Unsupported { code = 7 }
    if e == CompressError::Dictionary { code = 8 }
    if e == CompressError::Io { code = 9 }
    return 0
}

fn is_plain(b: *mut rt.Buf, want: str) -> bool {
    return rt.buf_len(b) == want.length() && rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.length())
}

fn view(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: rt.buf_len(b) }
}

fn scratch(tag: str) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, "/tmp/firn_".p as u64, 10)
    rt.buf_push_bytes(&b, tag.p as u64, tag.length())
    rt.buf_push(&b, 95 as u8)
    rt.buf_push_dec_i64(&b, syscall(39, 0, 0, 0, 0, 0, 0))
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

// deterministic pseudo random octets
fn pseudo(n: usize, seed: u64) -> rt.Buf {
    var b: rt.Buf = rt.buf_new()
    var x: u64 = seed
    var i: usize = 0
    while i < n {
        x = x *% 6364136223846793005 +% 1442695040888963407
        rt.buf_push(&b, ((x >> 33) & 255) as u8)
        i = i + 1
    }
    return b
}

fn zeros(n: usize) -> rt.Buf {
    var z: rt.Buf = rt.buf_new()
    rt.buf_reserve(&z, n)
    rt.mem_set(rt.buf_ptr(&z), 0 as u8, n)
    rt.buf_set_len(&z, n)
    return z
}

fn finish(t: *mut Tally) -> i32 {
    io.print("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&nb, (*t).total)
    io.print_bytes(rt.buf_ptr(&nb), rt.buf_len(&nb))
    io.print_line("")
    if (*t).fails != 0 {
        return 1 as i32
    }
    return 0
}

// 0 = decoded, else the error code of `why`
fn dec(z: str, max: usize, dict: str, out: *mut rt.Buf) -> u32 {
    code = 0
    zstd.zstd_decompress_dict(z.p as u64, z.length(), max, dict.p as u64, dict.length(), out) catch | e | (why(e))
    return code
}

fn decodes_to(t: *mut Tally, what: str, z: str, want: str) {
    var out: rt.Buf = rt.buf_new()
    let c: u32 = dec(z, 0, "", &out)
    check(t, what, c == 0 as u32 && is_plain(&out, want))
    rt.buf_free(&out)
}

fn stream_dec(path: str, z: str, piece: usize, dict: str, wmax: u64, out: *mut rt.Buf) -> u32 {
    code = 0
    fs.write_file(path, z.p as u64, z.length()) catch 0
    let fd: i64 = fs.open_read(path) catch -1
    if fd < 0 {
        return 99 as u32
    }
    var d: zstd.ZstdDec = zstd.zstd_dec_open_fd(fd)
    if dict.length() > 0 {
        zstd.zstd_dec_set_dict(&d, dict.p as u64, dict.length())
    }
    if wmax > 0 {
        zstd.zstd_dec_set_window_max(&d, wmax)
    }
    let tmp: u64 = rt.heap_alloc(piece)
    while true {
        let k: usize = zstd.zstd_dec_read(&d, tmp, piece) catch | e | (why(e))
        if code != 0 as u32 || k == 0 {
            break
        }
        rt.buf_push_bytes(out, tmp, k)
    }
    rt.heap_free(tmp, piece)
    zstd.zstd_dec_close(&d)
    fs.close_fd(fd)
    return code
}

// compress -> decompress, true when the data comes back
fn roundtrip(src: u64, n: usize, level: u32, feat: u32, dict: str, zlen: *mut usize) -> bool {
    var z: rt.Buf = rt.buf_new()
    var ok: bool = true
    if feat == 99 as u32 {
        zstd_enc.zstd_compress_dict(src, n, level, dict.p as u64, dict.length(), &z) catch | e | (why(e))
    } else {
        var e: zstd_enc.ZstdEnc = zstd_enc.zstd_enc_new(level, true)
        zstd_enc.zstd_enc_set_features(&e, feat)
        zstd_enc.zstd_enc_write(&e, src, n, &z)
        zstd_enc.zstd_enc_finish(&e, &z)
        zstd_enc.zstd_enc_free(&e)
    }
    *zlen = rt.buf_len(&z)
    var back: rt.Buf = rt.buf_new()
    let c: u32 = dec(view(&z), 0, dict, &back)
    if c != 0 as u32 || rt.buf_len(&back) != n || !rt.mem_eq(rt.buf_ptr(&back), src, n) {
        ok = false
    }
    rt.buf_free(&back)
    rt.buf_free(&z)
    return ok
}

fn main() -> i32 {
    var t: Tally = Tally { total: 0, fails: 0 }
    let path: str = scratch("zstd2181")

    // A. the command line's frames
    decodes_to(&t, "level 3", F_L3, PLAIN)
    decodes_to(&t, "level 1", F_L1, PLAIN)
    decodes_to(&t, "level 19", F_L19, PLAIN)
    decodes_to(&t, "no checksum", F_NOCHK, PLAIN)
    decodes_to(&t, "two frames and a skippable frame", F_MULTI, PLAIN)
    decodes_to(&t, "an empty frame", F_EMPTY, "")
    decodes_to(&t, "3000 random octets (raw block)", F_RANDOM, RANDOM)
    var zb: rt.Buf = zeros(70000)
    decodes_to(&t, "70000 zeros (RLE blocks)", F_ZEROS, view(&zb))
    rt.buf_free(&zb)
    // B. dictionaries
    var o: rt.Buf = rt.buf_new()
    check(&t, "record with a trained dictionary", dec(F_REC_DICT, 0, DICT, &o) == 0 as u32 && is_plain(&o, REC))
    rt.buf_clear(&o)
    check(&t, "level 19 record with the dictionary", dec(F_REC2_DICT, 0, DICT, &o) == 0 as u32 && is_plain(&o, REC2))
    rt.buf_clear(&o)
    check(&t, "a frame that needs a dictionary: none given is Dictionary", dec(F_REC_DICT, 0, "", &o) == 8 as u32)
    rt.buf_clear(&o)
    check(&t, "the dictionary is no use to a frame without one", dec(F_REC, 0, DICT, &o) == 0 as u32 && is_plain(&o, REC))
    var wrong: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&wrong, DICT.p as u64, DICT.length())
    rt.st8(rt.buf_ptr(&wrong), 4, rt.ld8(rt.buf_ptr(&wrong), 4) ^ 0x55 as u8)
    rt.buf_clear(&o)
    check(&t, "another dictionary id is Dictionary", dec(F_REC_DICT, 0, view(&wrong), &o) == 8 as u32)
    rt.buf_free(&wrong)
    check(&t, "dictionary id of a frame", zstd.zstd_dict_id(F_REC_DICT.p as u64, F_REC_DICT.length()) == common.ld32le(DICT.p as u64, 4)
        && zstd.zstd_dict_id(F_L3.p as u64, F_L3.length()) == 0)
    check(&t, "content size: unknown from a pipe, -2 for no frame", zstd.zstd_frame_content_size(F_L3.p as u64, F_L3.length()) == -1
        && zstd.zstd_frame_content_size("nope".p as u64, 4) == -2)
    var ownz: rt.Buf = rt.buf_new()
    zstd_enc.zstd_compress(PLAIN.p as u64, PLAIN.length(), 3, &ownz) catch 0
    check(&t, "our frame announces its content size", zstd.zstd_frame_content_size(rt.buf_ptr(&ownz), rt.buf_len(&ownz)) == (PLAIN.length() as i64))
    rt.buf_free(&ownz)
    check(&t, "is_frame", zstd.zstd_is_frame(F_L3.p as u64, F_L3.length()) && !zstd.zstd_is_frame("nope".p as u64, 4))
    check(&t, "dictionary content offset", zstd.zstd_dict_content_offset_of(DICT.p as u64, DICT.length()) > 100)
    // C. refusals
    rt.buf_clear(&o)
    check(&t, "bad magic is Format", dec("this is not zstd data", 0, "", &o) == 2 as u32)
    rt.buf_clear(&o)
    check(&t, "empty input is Truncated", dec("", 0, "", &o) == 4 as u32)
    var cuts: usize = 0
    var bad: usize = 0
    var c: usize = 0
    while c < F_L3.length() {
        rt.buf_clear(&o)
        cuts = cuts + 1
        if dec(str { p: F_L3.p, n: c }, 0, "", &o) == 0 as u32 {
            bad = bad + 1
        }
        c = c + 53
    }
    check(&t, "every cut of a frame is refused", bad == 0 && cuts > 100)
    var dmg: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&dmg, F_L3.p as u64, F_L3.length())
    rt.st8(rt.buf_ptr(&dmg), F_L3.length() - 1, rt.ld8(rt.buf_ptr(&dmg), F_L3.length() - 1) ^ 1 as u8)
    rt.buf_clear(&o)
    check(&t, "a flipped checksum is Checksum", dec(view(&dmg), 0, "", &o) == 3 as u32)
    // damage inside the blocks: never a crash, never a silently wrong answer
    var wrong_ok: usize = 0
    var k: usize = 0
    while k < 60 {
        rt.buf_clear(&dmg)
        rt.buf_push_bytes(&dmg, F_L3.p as u64, F_L3.length())
        let at: usize = 8 + (k * 173) % (F_L3.length() - 12)
        rt.st8(rt.buf_ptr(&dmg), at, rt.ld8(rt.buf_ptr(&dmg), at) ^ ((1 + k % 7) as u8))
        rt.buf_clear(&o)
        if dec(view(&dmg), 0, "", &o) == 0 as u32 {
            // the checksum can only let a changed frame through when the output is the same
            if !is_plain(&o, PLAIN) {
                wrong_ok = wrong_ok + 1
            }
        }
        k = k + 1
    }
    check(&t, "damaged frames: an error, or the right answer (checksum), never a wrong one", wrong_ok == 0)
    rt.buf_free(&dmg)
    rt.buf_clear(&o)
    check(&t, "limit == size passes", dec(F_L3, PLAIN.length(), "", &o) == 0 as u32 && is_plain(&o, PLAIN))
    rt.buf_clear(&o)
    check(&t, "limit == size - 1 is TooLarge, nothing past it written",
        dec(F_L3, PLAIN.length() - 1, "", &o) == 5 as u32 && rt.buf_len(&o) <= PLAIN.length() - 1)
    rt.buf_clear(&o)
    check(&t, "the zeros frame under a limit of 1000", dec(F_ZEROS, 1000, "", &o) == 5 as u32 && rt.buf_len(&o) <= 1000)
    // a window above the cap
    code = 0
    var so: rt.Buf = rt.buf_new()
    let rw: u32 = stream_dec(path, F_L19, 4096, "", 1024, &so)
    check(&t, "a window above the cap is Unsupported", rw == 7 as u32)
    rt.buf_free(&so)
    // D. streaming from a descriptor
    var pieces: [usize; 4] = [1, 13, 4096, 100000]
    var pi: usize = 0
    while pi < 4 {
        var s2: rt.Buf = rt.buf_new()
        check(&t, "stream-decode level 19", stream_dec(path, F_L19, pieces[pi], "", 0, &s2) == 0 as u32 && is_plain(&s2, PLAIN))
        rt.buf_clear(&s2)
        check(&t, "stream-decode two frames + skippable", stream_dec(path, F_MULTI, pieces[pi], "", 0, &s2) == 0 as u32 && is_plain(&s2, PLAIN))
        rt.buf_clear(&s2)
        check(&t, "stream-decode with a dictionary", stream_dec(path, F_REC_DICT, pieces[pi], DICT, 0, &s2) == 0 as u32 && is_plain(&s2, REC))
        rt.buf_free(&s2)
        pi = pi + 1
    }
    var zb2: rt.Buf = zeros(70000)
    var s3: rt.Buf = rt.buf_new()
    check(&t, "stream-decode of 70000 zeros", stream_dec(path, F_ZEROS, 999, "", 0, &s3) == 0 as u32 && is_plain(&s3, view(&zb2)))
    rt.buf_free(&s3)
    rt.buf_free(&zb2)

    // E. the encoder
    var zlen: usize = 0
    var sizes: [usize; 6] = [0, 0, 0, 0, 0, 0]
    var levels: [u32; 6] = [1, 2, 3, 5, 9, 19]
    var li: usize = 0
    while li < 6 {
        check(&t, "own frame, level, text+binary", roundtrip(PLAIN.p as u64, PLAIN.length(), levels[li], 3, "", &zlen))
        sizes[li] = zlen
        check(&t, "own frame, level, machine code like data", roundtrip(MIX.p as u64, MIX.length(), levels[li], 3, "", &zlen))
        li = li + 1
    }
    check(&t, "higher levels compress at least as well (level 19 <= level 1)", sizes[5] <= sizes[0])
    check(&t, "the ratio is sane: level 3 below 70 % of the text", sizes[2] * 10 < PLAIN.length() * 7)
    // every entropy coder switched on and off
    var fm: u32 = 0
    while fm < 4 {
        check(&t, "features: raw literals / predefined tables only / huffman / fse", roundtrip(PLAIN.p as u64, PLAIN.length(), 6, fm, "", &zlen))
        fm = fm + 1
    }
    var n: usize = 0
    var bad2: usize = 0
    while n < 80 {
        var src: rt.Buf = pseudo(n, 11 + n as u64)
        var j: usize = 0
        while j < n {
            rt.st8(rt.buf_ptr(&src), j, rt.ld8(rt.buf_ptr(&src), j) % 5 as u8)
            j = j + 1
        }
        if !roundtrip(rt.buf_ptr(&src), n, 3, 3, "", &zlen) {
            bad2 = bad2 + 1
        }
        rt.buf_free(&src)
        n = n + 1
    }
    check(&t, "own frames for every size 0..79", bad2 == 0)
    var rnd: rt.Buf = pseudo(200000, 5)
    check(&t, "incompressible 200000 octets (raw blocks, two blocks)", roundtrip(rt.buf_ptr(&rnd), 200000, 3, 3, "", &zlen) && zlen < 200000 + 100)
    rt.buf_free(&rnd)
    var big: rt.Buf = zeros(1000000)
    check(&t, "1,000,000 zeros (RLE) shrink below 200 octets", roundtrip(rt.buf_ptr(&big), 1000000, 3, 3, "", &zlen) && zlen < 200)
    rt.buf_free(&big)
    // dictionaries
    check(&t, "own frame with a dictionary (record)", roundtrip(REC2.p as u64, REC2.length(), 3, 99, DICT, &zlen))
    var zd: usize = 0
    var zn: usize = 0
    roundtrip(REC2.p as u64, REC2.length(), 3, 99, DICT, &zd)
    roundtrip(REC2.p as u64, REC2.length(), 3, 99, "", &zn)
    check(&t, "the dictionary helps", zd < zn)
    check(&t, "raw content as a dictionary", roundtrip(REC2.p as u64, REC2.length(), 5, 99, REC, &zlen))
    check(&t, "a dictionary at level 19 and level 1", roundtrip(PLAIN.p as u64, PLAIN.length(), 19, 99, DICT, &zlen)
        && roundtrip(PLAIN.p as u64, PLAIN.length(), 1, 99, DICT, &zlen))
    // streaming encoder in pieces, with and without the content size
    var cs: [usize; 4] = [1, 777, 30000, 131072]
    var ci: usize = 0
    while ci < 4 {
        var e: zstd_enc.ZstdEnc = zstd_enc.zstd_enc_new(4, true)
        var z: rt.Buf = rt.buf_new()
        var p: usize = 0
        while p < PLAIN.length() {
            var kk: usize = PLAIN.length() - p
            if kk > cs[ci] {
                kk = cs[ci]
            }
            zstd_enc.zstd_enc_write(&e, (PLAIN.p as u64) + p as u64, kk, &z)
            p = p + kk
        }
        zstd_enc.zstd_enc_finish(&e, &z)
        zstd_enc.zstd_enc_free(&e)
        var back: rt.Buf = rt.buf_new()
        check(&t, "stream-encode in pieces", dec(view(&z), 0, "", &back) == 0 as u32 && is_plain(&back, PLAIN))
        rt.buf_free(&back)
        rt.buf_free(&z)
        ci = ci + 1
    }
    var big2: rt.Buf = pseudo(700000, 77)
    // text-like big data: pseudo random with a small alphabet, several blocks and a window longer than a block
    var j2: usize = 0
    while j2 < 700000 {
        rt.st8(rt.buf_ptr(&big2), j2, 97 as u8 + (rt.ld8(rt.buf_ptr(&big2), j2) % 7 as u8))
        j2 = j2 + 1
    }
    var e2: zstd_enc.ZstdEnc = zstd_enc.zstd_enc_new(3, true)
    var z2: rt.Buf = rt.buf_new()
    zstd_enc.zstd_enc_write(&e2, rt.buf_ptr(&big2), 700000, &z2)
    zstd_enc.zstd_enc_finish(&e2, &z2)
    zstd_enc.zstd_enc_free(&e2)
    var b2: rt.Buf = rt.buf_new()
    check(&t, "stream-encode 700000 octets in one call (blocks, window)", dec(view(&z2), 0, "", &b2) == 0 as u32
        && rt.buf_len(&b2) == 700000 && rt.mem_eq(rt.buf_ptr(&b2), rt.buf_ptr(&big2), 700000))
    // ... and decoded through the streaming reader with a window smaller than the data
    var b3: rt.Buf = rt.buf_new()
    check(&t, "...through the streaming reader", stream_dec(path, view(&z2), 5000, "", 0, &b3) == 0 as u32
        && rt.buf_len(&b3) == 700000 && rt.mem_eq(rt.buf_ptr(&b3), rt.buf_ptr(&big2), 700000))
    rt.buf_free(&b3)
    rt.buf_free(&b2)
    rt.buf_free(&z2)
    rt.buf_free(&big2)
    rt.buf_free(&o)
    fs.remove(path) catch false
    return finish(&t)
}
