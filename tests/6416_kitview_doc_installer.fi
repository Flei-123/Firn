import std.rt
import fui.kitview
import fui.kpdocs
import docview.pagehash

fn sample() -> str {
    return "%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj\n3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 200 100]/Contents 4 0 R/Resources<</Font<</F1 5 0 R>>>>>>endobj\n4 0 obj<</Length 41>>stream\nBT /F1 18 Tf 10 50 Td (Hello Firn) Tj ET\nendstream\nendobj\n5 0 obj<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>endobj\ntrailer<</Root 1 0 R>>\n"
}

fn main() -> i32 {
    let s: str = sample()
    var plain: kitview.View = kitview.view_new()
    let m0: u32 = kitview.view_open(&plain, s.p as u64, s.n, "a.pdf")
    if m0 != kitview.MODE_UNSUPPORTED {
        return 1
    }
    kitview.view_free(&plain)

    var v: kitview.View = kitview.view_new()
    kitview.view_set_doc_installer(&v, kpdocs.install_pdf)
    let m1: u32 = kitview.view_open(&v, s.p as u64, s.n, "a.pdf")
    if m1 != kitview.MODE_PAGES {
        return 2
    }
    kitview.view_free(&v)

    var r: pagehash.PageHash = pagehash.page_hash(s.p as u64, s.n, 0)
    if !r.ok || r.w != 200 || r.h != 100 || r.ink == (0 as u64) {
        return 3
    }
    return 0
}
