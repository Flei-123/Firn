// expect_exit: 0
// mc_dig for the 1.21+ tables (767 1.21.1, 769 1.21.4, 772 1.21.8, 774 1.21.11, 775 26.1), built from the tool components + block tags:
// vanilla break times, harvest rules (iron ore needs a stone tool), copper tools only from 1.21.11.
// Return codes: 1xx = table/registry missing, 2xx = wrong time, 3xx = wrong harvest.
import std.rt
import mc.mc_registry
import mc.mc_dig
import mc.mc_dig_sel
import mc.v767.mc_reg_v767
import mc.v769.mc_reg_v769
import mc.v772.mc_reg_v772
import mc.v774.mc_reg_v774
import mc.v775.mc_reg_v775

fn ticks(r: *mut mc_registry.Registry, d: *mut mc_dig.DigData, blk: str, tool: str, ground: bool) -> i32 {
    let b: i32 = mc_registry.reg_block_by_name(r, blk.p as u64, blk.n)
    if b < 0 { return 0 - 99 }
    var it: i32 = 0 - 1
    if tool.n > 0 {
        it = mc_registry.reg_item_by_name(r, tool.p as u64, tool.n)
        if it < 0 { return 0 - 98 }
    }
    return mc_dig.dig_ticks(d, b, mc_registry.reg_block_hardness_milli(r, b), it, 0, ground, false)
}

fn harvest(r: *mut mc_registry.Registry, d: *mut mc_dig.DigData, blk: str, tool: str) -> bool {
    let b: i32 = mc_registry.reg_block_by_name(r, blk.p as u64, blk.n)
    var it: i32 = 0 - 1
    if tool.n > 0 { it = mc_registry.reg_item_by_name(r, tool.p as u64, tool.n) }
    return mc_dig.dig_can_harvest(d, b, it)
}

// 0 = ok
fn check(r: *mut mc_registry.Registry, d: *mut mc_dig.DigData) -> i32 {
    if !mc_registry.registry_ok(r) { return 100 }
    if !mc_dig.dig_ok(d) { return 101 }
    if ticks(r, d, "stone", "", true) != 150 { return 200 }
    if ticks(r, d, "stone", "iron_pickaxe", true) != 8 { return 201 }
    if ticks(r, d, "stone", "iron_pickaxe", false) != 38 { return 202 }
    if ticks(r, d, "dirt", "", true) != 15 { return 203 }
    if ticks(r, d, "dirt", "iron_shovel", true) != 3 { return 204 }
    if ticks(r, d, "oak_log", "iron_axe", true) != 10 { return 205 }
    if ticks(r, d, "obsidian", "diamond_pickaxe", true) != 188 { return 206 }
    if ticks(r, d, "bedrock", "diamond_pickaxe", true) != 0 - 1 { return 207 }
    if harvest(r, d, "iron_ore", "wooden_pickaxe") { return 300 }
    if !harvest(r, d, "iron_ore", "stone_pickaxe") { return 301 }
    if !harvest(r, d, "dirt", "") { return 302 }
    if harvest(r, d, "iron_ore", "") { return 303 }
    if !harvest(r, d, "iron_ore", "iron_pickaxe") { return 304 }
    if harvest(r, d, "diamond_ore", "stone_pickaxe") { return 305 }
    if !harvest(r, d, "diamond_ore", "diamond_pickaxe") { return 306 }
    if harvest(r, d, "obsidian", "iron_pickaxe") { return 307 }
    if ticks(r, d, "iron_ore", "iron_pickaxe", true) != 15 { return 210 }
    if ticks(r, d, "iron_ore", "wooden_pickaxe", true) != 150 { return 211 }
    if ticks(r, d, "white_wool", "shears", true) != 5 { return 212 }
    return 0
}

fn main() -> i32 {
    var r767: mc_registry.Registry = mc_reg_v767.registry_make()
    var d767: mc_dig.DigData = mc_dig_sel.dig_for_protocol(767)
    let a: i32 = check(&r767, &d767)
    if a != 0 { return a + 1000 }
    var r769: mc_registry.Registry = mc_reg_v769.registry_make()
    var d769: mc_dig.DigData = mc_dig_sel.dig_for_protocol(769)
    let b: i32 = check(&r769, &d769)
    if b != 0 { return b + 2000 }
    var r772: mc_registry.Registry = mc_reg_v772.registry_make()
    var d772: mc_dig.DigData = mc_dig_sel.dig_for_protocol(772)
    let c: i32 = check(&r772, &d772)
    if c != 0 { return c + 3000 }
    var r774: mc_registry.Registry = mc_reg_v774.registry_make()
    var d774: mc_dig.DigData = mc_dig_sel.dig_for_protocol(774)
    let e: i32 = check(&r774, &d774)
    if e != 0 { return e + 4000 }
    var r775: mc_registry.Registry = mc_reg_v775.registry_make()
    var d775: mc_dig.DigData = mc_dig_sel.dig_for_protocol(775)
    let f: i32 = check(&r775, &d775)
    if f != 0 { return f + 5000 }
    // copper tools: speed 5 (placeholder 1.0 in minecraft-data) from 1.21.11 on; the item does not exist before
    if ticks(&r774, &d774, "stone", "copper_pickaxe", true) != 9 { return 6000 }
    if ticks(&r775, &d775, "stone", "copper_pickaxe", true) != 9 { return 6001 }
    if harvest(&r774, &d774, "diamond_ore", "copper_pickaxe") { return 6002 }
    if !harvest(&r774, &d774, "iron_ore", "copper_pickaxe") { return 6003 }
    if mc_registry.reg_item_by_name(&r769, "copper_pickaxe".p as u64, "copper_pickaxe".n) >= 0 { return 6004 }
    return 0
}
