// expect_out: map: paare 51 summe 3675 plaetze 128 uebrig 2666 tot 0 typ2 2
// tests/803_std_map_core.fi -- iteration and entry helpers of `std.map`
// (round 42).
//
// The core of `Map[K, V]` (open addressing, load limit 3/4, tombstones)
// stays unchanged. What is new is what one DOES with the table:
//   * WALK over all pairs without building a field (`map_next`)
//   * "get or default", "get and tell whether it was there", "take out"
//   * the counting pattern in ONE call (`map_increase`)
//   * clean tombstones away (`map_cleanup`) -- without it a table that is
//     constantly inserted into and deleted from degenerates
//
// The iteration part checks the sum, not the order: that depends on the
// spreading and is explicitly not promised.
import std.io
import std.map

fn main() -> i32 {
    var m: Map[u64, u64] = map_new[u64, u64]()
    if !map_is_empty[u64, u64](&m) {
        return 10
    }
    var k: u64 = 0
    while k < 50 {
        map_set[u64, u64](&m, k, k * 3)
        k = k + 1
    }
    if map_len[u64, u64](&m) != 50 || map_is_empty[u64, u64](&m) {
        return 11
    }

    // --- cursor over all occupied slots
    var idx: usize = map_first[u64, u64](&m)
    var number: usize = 0
    var sum_s: u64 = 0
    var sum_w: u64 = 0
    while idx < map_cap[u64, u64](&m) {
        if !map_slot_used[u64, u64](&m, idx) {
            return 12
        }
        number = number + 1
        sum_s = sum_s + map_slot_key[u64, u64](&m, idx)
        sum_w = sum_w + map_slot_value[u64, u64](&m, idx)
        idx = map_next[u64, u64](&m, idx + 1)
    }
    if number != 50 {
        return 13
    }
    if sum_s != 1225 || sum_w != 3675 {
        return 14
    }

    // --- get with a default / with information
    if map_get_or[u64, u64](&m, 999, 7) != 7 {
        return 20
    }
    if map_get_or[u64, u64](&m, 5, 7) != 15 {
        return 21
    }
    var out: u64 = 0
    if !map_get_if[u64, u64](&m, 5, &out) || out != 15 {
        return 22
    }
    if map_get_if[u64, u64](&m, 999, &out) {
        return 23
    }
    // The difference to map_get: there a 0 is ambiguous.
    if map_get[u64, u64](&m, 0) != 0 {
        return 24
    }
    if !map_has[u64, u64](&m, 0) {
        return 25
    }

    // --- only insert when new
    var new: bool = false
    if !map_set_if_new[u64, u64](&m, 5, 999, &new) {
        return 30
    }
    if new || map_get[u64, u64](&m, 5) != 15 {
        return 31
    }
    if !map_set_if_new[u64, u64](&m, 500, 1, &new) {
        return 32
    }
    if !new || map_len[u64, u64](&m) != 51 {
        return 33
    }

    // --- counting pattern
    if map_increase[u64, u64](&m, 500, 4) != 5 {
        return 40
    }
    if map_increase[u64, u64](&m, 501, 9) != 9 {
        return 41
    }
    if map_get[u64, u64](&m, 501) != 9 {
        return 42
    }

    // --- change a value in place
    let addr: u64 = map_value_address[u64, u64](&m, 5)
    if addr == 0 {
        return 45
    }
    *(addr as *mut u64) = 77
    if map_get[u64, u64](&m, 5) != 77 {
        return 46
    }
    if map_value_address[u64, u64](&m, 12345) != 0 {
        return 47
    }

    // --- take out and clean up
    if !map_take[u64, u64](&m, 501, &out) || out != 9 {
        return 50
    }
    if map_take[u64, u64](&m, 501, &out) {
        return 51
    }
    if map_dead[u64, u64](&m) != 1 {
        return 52
    }
    let before_cap: usize = map_cap[u64, u64](&m)
    if !map_cleanup[u64, u64](&m) {
        return 53
    }
    if map_dead[u64, u64](&m) != 0 || map_cap[u64, u64](&m) != before_cap {
        return 54
    }
    if map_len[u64, u64](&m) != 51 {
        return 55
    }
    if map_get[u64, u64](&m, 5) != 77 {
        return 56
    }

    // --- many insertions and deletions: the table must not degenerate,
    //     and after the cleanup every remaining entry has to be there still.
    var z: Map[u64, u64] = map_new[u64, u64]()
    var r: u64 = 0
    while r < 4000 {
        map_set[u64, u64](&z, r, r)
        if (r % 3) == 0 {
            map_delete[u64, u64](&z, r)
        }
        r = r + 1
    }
    let left: usize = map_len[u64, u64](&z)
    if left != 2666 {
        return 60
    }
    map_cleanup[u64, u64](&z)
    if map_dead[u64, u64](&z) != 0 || map_len[u64, u64](&z) != left {
        return 61
    }
    var i2: usize = map_first[u64, u64](&z)
    var check: u64 = 0
    while i2 < map_cap[u64, u64](&z) {
        if map_slot_key[u64, u64](&z, i2) != map_slot_value[u64, u64](&z, i2) {
            return 62
        }
        check = check + 1
        i2 = map_next[u64, u64](&z, i2 + 1)
    }
    if check as usize != left {
        return 63
    }

    // --- other types: key u32, value i32
    var t: Map[u32, i32] = map_new[u32, i32]()
    map_set[u32, i32](&t, 7, 0 - 3)
    if map_get_or[u32, i32](&t, 7, 0) != 0 - 3 {
        return 70
    }
    if map_increase[u32, i32](&t, 7, 5) != 2 {
        return 71
    }
    if map_increase[u32, i32](&t, 8, 0 - 1) != 0 - 1 {
        return 72
    }
    if map_len[u32, i32](&t) != 2 {
        return 73
    }

    io.fmt_print(f"map: paare {map_len[u64, u64](&m)} summe {sum_w} plaetze {before_cap} ")
    io.fmt_print(f"uebrig {left} tot {map_dead[u64, u64](&z)} typ2 {map_get[u32, i32](&t, 7)}\n")

    map_free[u64, u64](&m)
    map_free[u64, u64](&z)
    map_free[u32, i32](&t)
    return 0
}
