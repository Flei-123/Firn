// expect_exit: 0
// tests/3091_mc_vk_shader_modules.fi -- every Vulkan SPIR-V module of the MC renderer (lib/gpu/vk_shaders.fi) must be accepted by a
// real Vulkan implementation: vkCreateShaderModule on Mesa lavapipe (or any device; CPU devices allowed). SKIP (exit 0, printed)
// without a Vulkan loader / ICD. Module creation only: pipelines need VK1's descriptor set layout (docs/VK-SHADERS.md).
import std.rt
import std.io
import gpu.vk
import gpu.vk_shaders

fn main() -> i32 {
    var v: vk.Vk = vk.vk_new()
    if !vk.open(&v, false, true) {
        io.fmt_print_line(f"SKIP: no Vulkan device (step {v.step})")
        return 0
    }
    var bad: i32 = 0
    var i: i32 = 0
    while i < vk_shaders.SHADER_COUNT {
        let m: u64 = vk.shader_make(&v, vk_shaders.shader_code(i), vk_shaders.shader_size(i))
        if m == 0 {
            io.fmt_print_line(f"FAIL: vkCreateShaderModule rejected {vk_shaders.shader_name(i)}")
            bad = bad + 1
        } else {
            vk.shader_free(&v, m)
        }
        i = i + 1
    }
    vk.close(&v)
    if bad != 0 { return 1 }
    io.fmt_print_line(f"ok: {vk_shaders.SHADER_COUNT} modules created on a Vulkan device (cpu={vk.is_cpu(&v)})")
    return 0
}
