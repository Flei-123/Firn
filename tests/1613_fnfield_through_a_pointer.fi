// expect_exit: 0
// tests/1613_fnfield_through_a_pointer.fi -- ROUND 79, the check on gap 12
// of docs/ROUND66.md.
//
// Round 66 wrote: "`(*c).gen_start(r, f, env)` does not compile; it has to be
// loaded into a local first." Round 68 built function values in a struct
// field (tools/fnfield/run.sh, section 27 of test.sh) and thereby closed the
// gap without knowing it -- the report of round 66 names it as still open
// because the round did not touch the compiler.
//
// This file is the shape round 66 named, character for character, so that
// the claim in docs/ROUND79.md 6 is a MEASUREMENT and not an assertion: a
// call THROUGH A POINTER to a function value in a struct field, and a method
// of the same name that still wins and stays a direct call.
struct Ctx {
    gen_start: fn(i64, i64, i64) -> i64,
    n: i64,
}

fn start(r: i64, f: i64, env: i64) -> i64 {
    return r * 100 + f * 10 + env
}

fn other(r: i64, f: i64, env: i64) -> i64 {
    return 0 - (r + f + env)
}

fn drive(c: *mut Ctx) -> i64 {
    // THE shape of gap 12.
    return (*c).gen_start(1, 2, 3)
}

fn main() -> i32 {
    var c: Ctx = Ctx { gen_start: start, n: 7 }
    if drive(&c) != 123 { return 1 }
    // The field can be exchanged, and the call follows it.
    c.gen_start = other
    if drive(&c) != 0 - 6 { return 2 }
    // Without the pointer, too.
    if c.gen_start(1, 1, 1) != 0 - 3 { return 3 }
    if c.n != 7 { return 4 }
    return 0
}
