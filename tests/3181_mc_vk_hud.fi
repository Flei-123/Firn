// expect_exit: 0
// mc.vk_mc HUD pass (lavapipe, NO real GPU): vkbe_hud draws recorded rectangles as instanced runs: an opaque rectangle (mode 0) gives its
// colour, an invert rectangle (mode 1) gives 255 - clear per channel, alpha stays untouched; the tint pass leaves pixels without
// geometry alone. SKIP (exit 0) without a Vulkan device.
import std.rt
import std.io
import mc.mc_backend
import mc.mc_camera
import mc.mc_texture
import mc.mc_sky
import mc.vk_mc

const W: i32 = 96
const H: i32 = 64

fn check(fails: *mut i32, what: str, ok: bool) {
    if ok {
        io.fmt_print(f"   ok   {what}\n")
    } else {
        io.fmt_print(f"   FAIL {what}\n")
        *fails = *fails + 1
    }
}

fn rect(rec: *mut rt.Buf, x0: i32, y0: i32, x1: i32, y1: i32, c: u32, mode: u32) {
    var w: [u32; 6] = [x0 as u32, y0 as u32, x1 as u32, y1 as u32, c, mode]
    rt.buf_push_bytes(rec, (&w[0]) as u64, 24)
}

fn px(p: u64, x: i32, y: i32) -> u32 {
    return rt.ld32(p, (y * W + x) as usize)
}

fn main() -> i32 {
    var vb: vk_mc.VkBackend = vk_mc.vkbe_open(W, H)
    if !vb.ok {
        io.fmt_print(f"SKIP vkbe_open step={vb.step}\n")
        return 0
    }
    var bg: mc_backend.Backend = vk_mc.vkbe_backend(&vb)
    var ta: mc_texture.Atlas = mc_texture.atlas_default()
    bg.upload_atlas(bg.obj, (&ta) as u64)
    var cam: mc_camera.Camera = mc_camera.camera_new(W, H)
    mc_camera.camera_update(&cam)
    var sky: mc_sky.Sky = mc_sky.sky_new()
    sky.tr = 100
    sky.tg = 100
    sky.tb = 100
    let clear: u32 = 0xFF302010 as u32
    var fails: i32 = 0

    var rec: rt.Buf = rt.buf_new()
    rect(&rec, 10, 10, 30, 30, 0xFF0000FF as u32, 0 as u32)
    rect(&rec, 50, 10, 70, 30, 0xFFFFFFFF as u32, 1 as u32)
    rect(&rec, 10, 40, 30, 60, 0xFF00FF00 as u32, 0 as u32)
    bg.begin(bg.obj, (&cam) as u64, clear)
    vk_mc.vkbe_tint(&vb, &sky)
    vk_mc.vkbe_hud(&vb, &rec)
    bg.end(bg.obj)
    let p: u64 = bg.present(bg.obj)
    check(&fails, "frame returned", p != 0 as u64)
    if p != 0 as u64 {
        check(&fails, "tint leaves pixels without geometry alone", px(p, 80, 50) == clear)
        check(&fails, "opaque rectangle = its colour (red)", px(p, 20, 20) == 0xFF0000FF as u32)
        check(&fails, "second opaque rectangle after the invert run (green)", px(p, 20, 50) == 0xFF00FF00 as u32)
        check(&fails, "invert rectangle = 255 - clear, alpha untouched", px(p, 60, 20) == 0xFFCFDFEF as u32)
        check(&fails, "outside the rectangles = clear", px(p, 40, 20) == clear && px(p, 5, 5) == clear)
        check(&fails, "rectangle edge: first pixel in, last pixel out", px(p, 10, 10) == 0xFF0000FF as u32 && px(p, 29, 29) == 0xFF0000FF as u32 && px(p, 30, 30) == clear)
    }
    rt.buf_free(&rec)
    vk_mc.vkbe_close(&vb)
    if fails != 0 {
        io.fmt_print(f"FAIL {fails}\n")
        return 1
    }
    io.print("vk_mc hud ok\n")
    return 0
}
