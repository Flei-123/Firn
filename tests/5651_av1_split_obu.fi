// expect_exit: 42
import av1.still
import av1.seqdec
import std.fs
import std.rt
import std.deflate

fn load(name: str, data: *mut rt.Buf) -> usize {
    let n: usize = fs.read_file(name, data) catch 0
    return n
}

fn crc_of(name: str, want_crc: u32, want_size: usize) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    let h: u64 = seqdec.seq_open(rt.buf_ptr(&data), n)
    if h == 0 {
        return false
    }
    var all: rt.Buf = rt.buf_new()
    while true {
        var f: still.Frame = still.frame_new()
        let rc: i32 = seqdec.seq_next(h, &f)
        if rc == seqdec.SEQ_END {
            break
        }
        if rc == seqdec.SEQ_FRAME {
            rt.buf_push_bytes(&all, f.y, f.y_bytes)
            rt.buf_push_bytes(&all, f.u, f.u_bytes)
            rt.buf_push_bytes(&all, f.v, f.v_bytes)
            still.frame_free(&f)
        } else if rc != seqdec.SEQ_HIDDEN {
            seqdec.seq_free(h)
            rt.buf_free(&all)
            rt.buf_free(&data)
            return false
        }
    }
    seqdec.seq_free(h)
    let c: u32 = deflate.crc32(rt.buf_ptr(&all), rt.buf_len(&all))
    let sz: usize = rt.buf_len(&all)
    rt.buf_free(&all)
    rt.buf_free(&data)
    return c == want_crc && sz == want_size
}

fn main() -> i32 {
    if !crc_of("tests/data/av1/split/split_seq_b10_200_hk_se.obu", 0x51890939 as u32, 120000) { return 1 }
    if !crc_of("tests/data/av1/split/split_seq_c129_420_dq_io.obu", 0x077d6b7c as u32, 50958) { return 2 }
    if !crc_of("tests/data/av1/split/split_seq_c256_420_mandel_io.obu", 0x3c3fc451 as u32, 196608) { return 3 }
    if !crc_of("tests/data/av1/split/split_seq_cdef_c_io.obu", 0x915888c0 as u32, 294912) { return 4 }
    if !crc_of("tests/data/av1/split/split_seq_cdef_p12_skip_io.obu", 0x0e260bee as u32, 180000) { return 5 }
    if !crc_of("tests/data/av1/split/split_seq_fg_t2_444_io.obu", 0x0401db33 as u32, 240000) { return 6 }
    return 42
}
