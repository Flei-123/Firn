// expect_exit: 0
// tests/3060_mc_mesh_golden.fi -- the mesher output (vertices, indices, counters) is bit-identical to the reference values.
// The expected hashes were recorded with the straightforward per-cell mesher (before the row-bitmask rewrite, 14.10.).
// 7 section kinds x 4 seeds x 10 flag combinations (lib/mc/mc_mesh_fixture.fi). Exit code 1 + mode index = hash of that mode differs.
import std.rt
import mc.mc_mesh
import mc.mc_mesh_fixture
import mc.mc_perf

const NMODE: usize = 10

fn main() -> i32 {
    var t: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_mesh_fixture.fixture_tables(&t)
    var m: mc_mesh.Mesher = mc_mesh.mesher_new()
    let pad: u64 = rt.heap_alloc(5832 * 2)
    let lpad: u64 = rt.heap_alloc(5832)
    let F_A: u32 = mc_mesh.F_AO
    let F_G: u32 = mc_mesh.F_GREEDY
    let F_L: u32 = mc_mesh.F_LIGHT
    let F_C: u32 = mc_mesh.F_CULL_SAME
    let F_T: u32 = mc_mesh.F_TRANS
    var modes: [u32; 10] = [0 as u32, F_A, F_G, F_A | F_G, F_A | F_L, F_A | F_G | F_L | F_C, F_C, F_A | F_T,
        F_A | F_G | F_L | F_T | F_C, F_T | F_L]
    var expect: [u64; 10] = [7354825325701 as u64, 37473442856398 as u64, 68799917303138 as u64, 6244262817612 as u64, 19682616938669 as u64, 32579373733171 as u64, 15733116420091 as u64, 9897072005903 as u64, 41135850338034 as u64, 6387441427540 as u64]
    var bad: i32 = 0
    var mi: usize = 0
    while mi < NMODE {
        var hash: u64 = 1469598103 as u64
        var kind: usize = 0
        while kind < 7 {
            var seed: u64 = 1 as u64
            while seed <= 4 as u64 {
                mc_mesh_fixture.fixture_pad(kind, seed, pad, lpad)
                mc_mesh.mesh_padded_lit(&m, pad, lpad, &t, modes[mi])
                hash = mc_mesh_fixture.mesh_hash(hash, &m)
                seed = seed + 1 as u64
            }
            kind = kind + 1
        }
        if hash != expect[mi] {
            mc_perf.perf_emit_u("mode", mi as u64, "hash differs")
            mc_perf.perf_emit_u("hash", hash, "actual")
            if bad == 0 { bad = 1 + mi as i32 }
        }
        mi = mi + 1
    }
    mc_mesh.mesher_free(&m)
    return bad
}
