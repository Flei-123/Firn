// expect_exit: 88
// Aggregate UND Stapelargumente in einem Aufruf: das 16-Byte-Struct belegt
// zwei INTEGER-Woerter, danach laufen die restlichen Argumente ueber den
// Stapel (abi.rs, System-V-Klassifikation).
struct Q { a: i64, b: i64 }
struct Big { a: i64, b: i64, c: i64, d: i64 }

fn mix(x: i32, q: Q, y: i32, g: Big, z: i32, w: i32) -> i64 {
    return q.a + q.b + g.a + g.b + g.c + g.d + (x + y + z + w) as i64
}

fn main() -> i32 {
    let q: Q = Q{ a: 1, b: 2 }
    let g: Big = Big{ a: 10, b: 20, c: 30, d: 15 }
    // 1+2 + 10+20+30+15 + (1+2+3+4) = 78 + 10 = 88
    return mix(1, q, 2, g, 3, 4) as i32
}
