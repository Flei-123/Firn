// expect_exit: 0
import std.io

type Name = str

fn make(n: i32) -> string {
    return f"n={n}"
}

fn make_named(n: i32) -> Name {
    return f"n={n}"
}

fn take(s: string) -> bool {
    return s == "n=7"
}

struct Holder {
    label: string,
}

fn main() -> i32 {
    var bad: i32 = 0
    let n: i32 = 7
    let s: string = f"n={n}"
    if s != "n=7" {
        bad = bad + 1
    }
    if !take(f"n={n}") {
        bad = bad + 2
    }
    if make(n) != s {
        bad = bad + 4
    }
    if make_named(n) != s {
        bad = bad + 8
    }
    let nm: Name = f"n={n}"
    if nm != s {
        bad = bad + 16
    }
    let h: Holder = Holder { label: f"n={n}" }
    if h.label != s {
        bad = bad + 32
    }
    return bad
}
