// expect_exit: 42
// ROUND 96 -- the marking travels, and it travels through everything that is
// not a call to `declassify`: through a struct field, through a pointer,
// through a function boundary and through `barrier`.
//
// The number 42 is chosen so that a marking lost anywhere on the way changes
// it -- every step contributes.
struct Key {
    high: secret[u8],
    low: secret[u8],
}

fn mix(k: Key) -> secret[u8] {
    return k.high ^ k.low
}

fn through_pointer(p: *mut secret[u8]) -> secret[u8] {
    return barrier(*p)
}

fn main() -> i32 {
    var k: Key = Key { high: 0xAA, low: 0x80 }
    let m: secret[u8] = mix(k)
    var cell: secret[u8] = m
    let back: secret[u8] = through_pointer(&cell)
    // 0xAA ^ 0x80 = 0x2A = 42
    return declassify(back) as i32
}
