// expect_exit: 42
// tests/5483_fui_colr_text.fi -- lib/fui/painter.fi: a COLR v0 / CPAL face (the W3C palette test font) is painted
// layer by layer in the palette colours; the quote glyph has a red layer (CPAL entry 1), the base glyph is not painted.
import fui.painter
import paint.canvas
import font.metrics
import std.rt

const W: usize = 200
const H: usize = 120
const FONTSET_BYTES: usize = 4096
const RED_MIN: u32 = 200

fn main() -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) { return 1 as i32 }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 400, 200) { return 2 as i32 }
    var fbuf: rt.Buf = rt.buf_new()
    var fpath: [u8; 46] = "tools/fontfb/data/COLR-palettes-test-font.ttf\0"
    if !rt.read_file((&fpath[0]) as u64, &fbuf) { return 3 as i32 }
    let fsp: *mut metrics.FontSet = rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) { return 4 as i32 }
    painter.painter_set_font(&z, fsp as u64)
    canvas.canvas_clear(&cv, 4294967295 as u32)
    var q: [u8; 1] = "\""
    let adv: f64 = painter.text(&z, 20.0, 90.0, 160.0, 80.0, 4278190080 as u32, (&q[0]) as u64, 1, painter.TEXT_L)
    var red: i64 = 0
    var dark: i64 = 0
    var y: usize = 0
    while y < H {
        var x: usize = 0
        while x < W {
            let v: u32 = canvas.canvas_get(&cv, x, y)
            let r: u32 = (v >> 16 as u32) & 255 as u32
            let g: u32 = (v >> 8 as u32) & 255 as u32
            let b: u32 = v & 255 as u32
            if r > RED_MIN && g < 60 as u32 && b < 60 as u32 { red = red + 1 }
            if r < 60 as u32 && g < 60 as u32 && b < 60 as u32 { dark = dark + 1 }
            x = x + 1
        }
        y = y + 1
    }
    if red < 50 { return 5 as i32 }
    if dark < 50 { return 6 as i32 }
    painter.painter_free(&z)
    return 42
}
