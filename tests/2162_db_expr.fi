// expect_exit: 0
// tests/2162_db_expr.fi -- constant expressions through lib/db, each against the answer SQLite gave
// (tools/db/gen_test_expr.py wrote this file; tools/db/check_expr.py compares 22,000 more, bit
// for bit): arithmetic and its overflow, text to number, comparison across types and affinities,
// three-valued logic, LIKE/GLOB, CASE, IN, BETWEEN, CAST, the scalar functions.
import std.rt
import std.io
import std.fs
import db.dberr
import db.dbcore as dc
import db.sqlite as sq

struct Tally {
    total: i64,
    fails: i64,
}

fn check(t: *mut Tally, what: str, got: str, want: str) {
    (*t).total = (*t).total + 1
    if !got.equal(want) {
        (*t).fails = (*t).fails + 1
        io.print("FAIL ")
        io.print(what)
        io.print(": got [")
        io.print(got)
        io.print("] want [")
        io.print(want)
        io.print_line("]")
    }
}

fn q(d: *mut dc.Db, sql: str) -> str {
    let s: str = sq.db_query_all(d, sql) catch | e | ("E:" + sq.last_error_message())
    return s
}

fn scratch_path() -> str {
    var b: rt.Buf = rt.buf_new()
    let head: str = "/tmp/firn_db_2162_"
    rt.buf_push_bytes(&b, head.p as u64, head.length())
    rt.buf_push_dec_i64(&b, syscall(39, 0, 0, 0, 0, 0, 0))
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

fn main() -> i32 {
    var t: Tally = Tally { total: 0, fails: 0 }
    let path: str = scratch_path()
    let d: *mut dc.Db = sq.db_open(path, sq.OPEN_CREATE) catch | e | (0 as *mut dc.Db)
    if (d as u64) == 0 {
        io.print_line("FAIL cannot create the database")
        return 2
    }
    check(&t, "1 + 2 * 3", q(d, "SELECT 1 + 2 * 3"), "7")
    check(&t, "(1 + 2) * 3", q(d, "SELECT (1 + 2) * 3"), "9")
    check(&t, "10 - 2 - 3", q(d, "SELECT 10 - 2 - 3"), "5")
    check(&t, "7 / 2", q(d, "SELECT 7 / 2"), "3")
    check(&t, "-7 / 2", q(d, "SELECT -7 / 2"), "-3")
    check(&t, "7 % 3", q(d, "SELECT 7 % 3"), "1")
    check(&t, "-7 % 3", q(d, "SELECT -7 % 3"), "-1")
    check(&t, "7.5 / 2", q(d, "SELECT 7.5 / 2"), "3.75")
    check(&t, "2 * 3.5", q(d, "SELECT 2 * 3.5"), "7.0")
    check(&t, "1 / 0", q(d, "SELECT 1 / 0"), "NULL")
    check(&t, "1 % 0", q(d, "SELECT 1 % 0"), "NULL")
    check(&t, "9223372036854775807 + 1", q(d, "SELECT 9223372036854775807 + 1"), "9.22337203685478e+18")
    check(&t, "-9223372036854775807 - 2", q(d, "SELECT -9223372036854775807 - 2"), "-9.22337203685478e+18")
    check(&t, "4611686018427387904 * 2", q(d, "SELECT 4611686018427387904 * 2"), "9.22337203685478e+18")
    check(&t, "9223372036854775807 * -1", q(d, "SELECT 9223372036854775807 * -1"), "-9223372036854775807")
    check(&t, "-9223372036854775808", q(d, "SELECT -9223372036854775808"), "-9223372036854775808")
    check(&t, "1e3", q(d, "SELECT 1e3"), "1000.0")
    check(&t, "0x1F + 1", q(d, "SELECT 0x1F + 1"), "32")
    check(&t, ".5 + .5", q(d, "SELECT .5 + .5"), "1.0")
    check(&t, "1 << 62", q(d, "SELECT 1 << 62"), "4611686018427387904")
    check(&t, "1 << 64", q(d, "SELECT 1 << 64"), "0")
    check(&t, "-1 >> 70", q(d, "SELECT -1 >> 70"), "-1")
    check(&t, "5 & 3", q(d, "SELECT 5 & 3"), "1")
    check(&t, "5 | 3", q(d, "SELECT 5 | 3"), "7")
    check(&t, "~5", q(d, "SELECT ~5"), "-6")
    check(&t, "- - 5", q(d, "SELECT - - 5"), "5")
    check(&t, "'1' + '2'", q(d, "SELECT '1' + '2'"), "3")
    check(&t, "'3' * '4'", q(d, "SELECT '3' * '4'"), "12")
    check(&t, "'abc' + 1", q(d, "SELECT 'abc' + 1"), "1")
    check(&t, "'1.5' + 1", q(d, "SELECT '1.5' + 1"), "2.5")
    check(&t, "' 7 ' + 1", q(d, "SELECT ' 7 ' + 1"), "8")
    check(&t, "'0x10' + 1", q(d, "SELECT '0x10' + 1"), "1")
    check(&t, "'1e2' + 0", q(d, "SELECT '1e2' + 0"), "100.0")
    check(&t, "'a' || 'b'", q(d, "SELECT 'a' || 'b'"), "ab")
    check(&t, "1 || 2", q(d, "SELECT 1 || 2"), "12")
    check(&t, "1.5 || 'x'", q(d, "SELECT 1.5 || 'x'"), "1.5x")
    check(&t, "NULL || 'a'", q(d, "SELECT NULL || 'a'"), "NULL")
    check(&t, "x'4142' || 'c'", q(d, "SELECT x'4142' || 'c'"), "ABc")
    check(&t, "1 = 1.0", q(d, "SELECT 1 = 1.0"), "1")
    check(&t, "1 = '1'", q(d, "SELECT 1 = '1'"), "0")
    check(&t, "'1' = 1", q(d, "SELECT '1' = 1"), "0")
    check(&t, "'abc' < 'abd'", q(d, "SELECT 'abc' < 'abd'"), "1")
    check(&t, "'a' < 'B'", q(d, "SELECT 'a' < 'B'"), "0")
    check(&t, "x'41' = 'A'", q(d, "SELECT x'41' = 'A'"), "0")
    check(&t, "1 < 'a'", q(d, "SELECT 1 < 'a'"), "1")
    check(&t, "'a' < x'00'", q(d, "SELECT 'a' < x'00'"), "1")
    check(&t, "NULL = NULL", q(d, "SELECT NULL = NULL"), "NULL")
    check(&t, "NULL IS NULL", q(d, "SELECT NULL IS NULL"), "1")
    check(&t, "1 IS 1", q(d, "SELECT 1 IS 1"), "1")
    check(&t, "NULL IS 1", q(d, "SELECT NULL IS 1"), "0")
    check(&t, "1 IS NOT NULL", q(d, "SELECT 1 IS NOT NULL"), "1")
    check(&t, "1 IS TRUE", q(d, "SELECT 1 IS TRUE"), "1")
    check(&t, "0 IS FALSE", q(d, "SELECT 0 IS FALSE"), "1")
    check(&t, "NULL IS TRUE", q(d, "SELECT NULL IS TRUE"), "0")
    check(&t, "2 IS NOT FALSE", q(d, "SELECT 2 IS NOT FALSE"), "1")
    check(&t, "NULL AND 0", q(d, "SELECT NULL AND 0"), "0")
    check(&t, "NULL AND 1", q(d, "SELECT NULL AND 1"), "NULL")
    check(&t, "NULL OR 1", q(d, "SELECT NULL OR 1"), "1")
    check(&t, "NULL OR 0", q(d, "SELECT NULL OR 0"), "NULL")
    check(&t, "NOT NULL", q(d, "SELECT NOT NULL"), "NULL")
    check(&t, "NOT 0", q(d, "SELECT NOT 0"), "1")
    check(&t, "1 AND 2", q(d, "SELECT 1 AND 2"), "1")
    check(&t, "0 OR 0", q(d, "SELECT 0 OR 0"), "0")
    check(&t, "'abc' COLLATE NOCASE = 'ABC'", q(d, "SELECT 'abc' COLLATE NOCASE = 'ABC'"), "1")
    check(&t, "'a ' COLLATE RTRIM = 'a'", q(d, "SELECT 'a ' COLLATE RTRIM = 'a'"), "1")
    check(&t, "'abc' = 'ABC'", q(d, "SELECT 'abc' = 'ABC'"), "0")
    check(&t, "3 BETWEEN 1 AND 5", q(d, "SELECT 3 BETWEEN 1 AND 5"), "1")
    check(&t, "3 NOT BETWEEN 1 AND 5", q(d, "SELECT 3 NOT BETWEEN 1 AND 5"), "0")
    check(&t, "NULL BETWEEN 1 AND 2", q(d, "SELECT NULL BETWEEN 1 AND 2"), "NULL")
    check(&t, "'b' BETWEEN 'a' AND 'c'", q(d, "SELECT 'b' BETWEEN 'a' AND 'c'"), "1")
    check(&t, "3 IN (1, 2, 3)", q(d, "SELECT 3 IN (1, 2, 3)"), "1")
    check(&t, "3 IN (1, 2, NULL)", q(d, "SELECT 3 IN (1, 2, NULL)"), "NULL")
    check(&t, "3 NOT IN (1, 2)", q(d, "SELECT 3 NOT IN (1, 2)"), "1")
    check(&t, "NULL IN (1)", q(d, "SELECT NULL IN (1)"), "NULL")
    check(&t, "3 IN ()", q(d, "SELECT 3 IN ()"), "0")
    check(&t, "'1' IN (1)", q(d, "SELECT '1' IN (1)"), "0")
    check(&t, "CASE WHEN 1 > 2 THEN 'a' WHEN 2 > 1 THEN 'b' ELSE 'c' END", q(d, "SELECT CASE WHEN 1 > 2 THEN 'a' WHEN 2 > 1 THEN 'b' ELSE 'c' END"), "b")
    check(&t, "CASE 3 WHEN 1 THEN 'x' WHEN 3 THEN 'y' END", q(d, "SELECT CASE 3 WHEN 1 THEN 'x' WHEN 3 THEN 'y' END"), "y")
    check(&t, "CASE WHEN 0 THEN 1 END", q(d, "SELECT CASE WHEN 0 THEN 1 END"), "NULL")
    check(&t, "'abc' LIKE 'A%'", q(d, "SELECT 'abc' LIKE 'A%'"), "1")
    check(&t, "'abc' GLOB 'A*'", q(d, "SELECT 'abc' GLOB 'A*'"), "0")
    check(&t, "'abc' LIKE 'a_c'", q(d, "SELECT 'abc' LIKE 'a_c'"), "1")
    check(&t, "'abc' LIKE '%'", q(d, "SELECT 'abc' LIKE '%'"), "1")
    check(&t, "'日本語' LIKE '日%'", q(d, "SELECT '日本語' LIKE '日%'"), "1")
    check(&t, "'a%' LIKE 'a\\%' ESCAPE '\\'", q(d, "SELECT 'a%' LIKE 'a\\%' ESCAPE '\\'"), "1")
    check(&t, "'abd' GLOB 'a[bc]d'", q(d, "SELECT 'abd' GLOB 'a[bc]d'"), "1")
    check(&t, "'abd' GLOB 'a[^b]d'", q(d, "SELECT 'abd' GLOB 'a[^b]d'"), "0")
    check(&t, "abs(-3)", q(d, "SELECT abs(-3)"), "3")
    check(&t, "abs(-3.5)", q(d, "SELECT abs(-3.5)"), "3.5")
    check(&t, "abs('-2')", q(d, "SELECT abs('-2')"), "2.0")
    check(&t, "abs(NULL)", q(d, "SELECT abs(NULL)"), "NULL")
    check(&t, "length('日本語')", q(d, "SELECT length('日本語')"), "3")
    check(&t, "length(x'0102')", q(d, "SELECT length(x'0102')"), "2")
    check(&t, "length(12345)", q(d, "SELECT length(12345)"), "5")
    check(&t, "lower('ABCÉ')", q(d, "SELECT lower('ABCÉ')"), "abcÉ")
    check(&t, "upper('abcé')", q(d, "SELECT upper('abcé')"), "ABCé")
    check(&t, "substr('hello', 2, 3)", q(d, "SELECT substr('hello', 2, 3)"), "ell")
    check(&t, "substr('hello', -3)", q(d, "SELECT substr('hello', -3)"), "llo")
    check(&t, "substr('hello', 0)", q(d, "SELECT substr('hello', 0)"), "hello")
    check(&t, "substr('hello', 2, -1)", q(d, "SELECT substr('hello', 2, -1)"), "h")
    check(&t, "substr('日本語', 2, 1)", q(d, "SELECT substr('日本語', 2, 1)"), "本")
    check(&t, "instr('hello world', 'o')", q(d, "SELECT instr('hello world', 'o')"), "5")
    check(&t, "instr('abc', 'x')", q(d, "SELECT instr('abc', 'x')"), "0")
    check(&t, "replace('banana', 'an', 'AN')", q(d, "SELECT replace('banana', 'an', 'AN')"), "bANANa")
    check(&t, "trim('  x  ')", q(d, "SELECT trim('  x  ')"), "x")
    check(&t, "ltrim('xxabc', 'x')", q(d, "SELECT ltrim('xxabc', 'x')"), "abc")
    check(&t, "rtrim('abcxx', 'x')", q(d, "SELECT rtrim('abcxx', 'x')"), "abc")
    check(&t, "typeof(1)", q(d, "SELECT typeof(1)"), "integer")
    check(&t, "typeof(1.0)", q(d, "SELECT typeof(1.0)"), "real")
    check(&t, "typeof('a')", q(d, "SELECT typeof('a')"), "text")
    check(&t, "typeof(x'')", q(d, "SELECT typeof(x'')"), "blob")
    check(&t, "typeof(NULL)", q(d, "SELECT typeof(NULL)"), "null")
    check(&t, "typeof(1 + 1.0)", q(d, "SELECT typeof(1 + 1.0)"), "real")
    check(&t, "typeof(1 / 2)", q(d, "SELECT typeof(1 / 2)"), "integer")
    check(&t, "hex('abc')", q(d, "SELECT hex('abc')"), "616263")
    check(&t, "hex(255)", q(d, "SELECT hex(255)"), "323535")
    check(&t, "quote('it''s')", q(d, "SELECT quote('it''s')"), "'it''s'")
    check(&t, "quote(NULL)", q(d, "SELECT quote(NULL)"), "NULL")
    check(&t, "quote(1.5)", q(d, "SELECT quote(1.5)"), "1.5")
    check(&t, "quote(x'4142')", q(d, "SELECT quote(x'4142')"), "X'4142'")
    check(&t, "coalesce(NULL, NULL, 3)", q(d, "SELECT coalesce(NULL, NULL, 3)"), "3")
    check(&t, "ifnull(NULL, 'x')", q(d, "SELECT ifnull(NULL, 'x')"), "x")
    check(&t, "nullif(1, 1)", q(d, "SELECT nullif(1, 1)"), "NULL")
    check(&t, "nullif(1, 2)", q(d, "SELECT nullif(1, 2)"), "1")
    check(&t, "iif(1 > 2, 'a', 'b')", q(d, "SELECT iif(1 > 2, 'a', 'b')"), "b")
    check(&t, "min(3, 1, 2)", q(d, "SELECT min(3, 1, 2)"), "1")
    check(&t, "max(3, 1, 2)", q(d, "SELECT max(3, 1, 2)"), "3")
    check(&t, "min(1, NULL)", q(d, "SELECT min(1, NULL)"), "NULL")
    check(&t, "round(2.5)", q(d, "SELECT round(2.5)"), "3.0")
    check(&t, "round(-2.5)", q(d, "SELECT round(-2.5)"), "-3.0")
    check(&t, "round(2.675, 2)", q(d, "SELECT round(2.675, 2)"), "2.68")
    check(&t, "round(1234.5678, 1)", q(d, "SELECT round(1234.5678, 1)"), "1234.6")
    check(&t, "round(NULL)", q(d, "SELECT round(NULL)"), "NULL")
    check(&t, "CAST('12abc' AS INTEGER)", q(d, "SELECT CAST('12abc' AS INTEGER)"), "12")
    check(&t, "CAST(3.9 AS INTEGER)", q(d, "SELECT CAST(3.9 AS INTEGER)"), "3")
    check(&t, "CAST(-3.9 AS INTEGER)", q(d, "SELECT CAST(-3.9 AS INTEGER)"), "-3")
    check(&t, "CAST('1e2' AS INTEGER)", q(d, "SELECT CAST('1e2' AS INTEGER)"), "1")
    check(&t, "CAST(7 AS TEXT)", q(d, "SELECT CAST(7 AS TEXT)"), "7")
    check(&t, "CAST(1.5 AS TEXT)", q(d, "SELECT CAST(1.5 AS TEXT)"), "1.5")
    check(&t, "CAST('abc' AS BLOB)", q(d, "SELECT CAST('abc' AS BLOB)"), "x'616263'")
    check(&t, "CAST(x'4142' AS TEXT)", q(d, "SELECT CAST(x'4142' AS TEXT)"), "AB")
    check(&t, "CAST('1.5' AS NUMERIC)", q(d, "SELECT CAST('1.5' AS NUMERIC)"), "1.5")
    check(&t, "CAST('3' AS REAL)", q(d, "SELECT CAST('3' AS REAL)"), "3.0")
    check(&t, "CAST(NULL AS INTEGER)", q(d, "SELECT CAST(NULL AS INTEGER)"), "NULL")
    check(&t, "CAST(1e30 AS INTEGER)", q(d, "SELECT CAST(1e30 AS INTEGER)"), "9223372036854775807")
    check(&t, "0.1 + 0.2", q(d, "SELECT 0.1 + 0.2"), "0.3")
    check(&t, "1.0e15", q(d, "SELECT 1.0e15"), "1.0e+15")
    check(&t, "1.0e16", q(d, "SELECT 1.0e16"), "1.0e+16")
    check(&t, "100.0", q(d, "SELECT 100.0"), "100.0")
    check(&t, "1e-4", q(d, "SELECT 1e-4"), "0.0001")
    check(&t, "1e-5", q(d, "SELECT 1e-5"), "1.0e-05")
    check(&t, "1.7976931348623157e308", q(d, "SELECT 1.7976931348623157e308"), "1.79769313486232e+308")
    check(&t, "123456789.123456789", q(d, "SELECT 123456789.123456789"), "123456789.123457")
    check(&t, "1/3.0", q(d, "SELECT 1/3.0"), "0.333333333333333")
    check(&t, "-0.0", q(d, "SELECT -0.0"), "0.0")
    check(&t, "char(72, 105)", q(d, "SELECT char(72, 105)"), "Hi")
    check(&t, "unicode('日')", q(d, "SELECT unicode('日')"), "26085")
    check(&t, "printf('%d-%s-%5.2f|%-4d|%04d|%x|%%', 42, 'x', 3.14159, 7, 42, 255)", q(d, "SELECT printf('%d-%s-%5.2f|%-4d|%04d|%x|%%', 42, 'x', 3.14159, 7, 42, 255)"), "42-x- 3.14|7   |0042|ff|%")
    check(&t, "zeroblob(3)", q(d, "SELECT zeroblob(3)"), "x'000000'")
    check(&t, "length(randomblob(8))", q(d, "SELECT length(randomblob(8))"), "8")
    sq.db_close(d)
    fs.remove(path) catch false
    io.fmt_print_line(io.fmt_number(io.fmt_text(io.fmt_number(io.fmt_text(io.fmt_new(), "checks ".p as u64, 7), t.total), " failed ".p as u64, 8), t.fails))
    if t.fails != 0 {
        return 1
    }
    return 0
}
