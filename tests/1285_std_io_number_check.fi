// expect_out: r69 check: 6 cases 175 octets ok
// tests/1285_std_io_number_check.fi -- the whole chain of the comfort layer
// in one line (round 69).
//
// demos/number_check.fi is the visible proof of this round, but it reads
// from the REAL standard input and can therefore not be part of the test
// corpus (test.sh runs its programs without a pipe of their own; the demo
// is run with an input in section 27 instead). What runs here is the same
// chain the demo walks -- `f"..."` as a value, `either` as a decision
// between two builders, `fmt_append` for joining, `fmt_f64` for the root --
// only over SIX numbers instead of one, and compared against the expected
// text character by character.
//
// Perfect squares on purpose: `math.sqrt` is a Newton iteration and its
// last bit is its own business (lib/std/math.fi). What is tested here is
// the way the number gets to the outside, not how it was computed.
import std.io
import std.math
import std.num
import std.str

// A WORD instead of `true`/`false`: `f"..."` is a value, so the decision is
// an expression. The branch not taken is released -- a builder owns its
// buffer.
fn either(yes: bool, a: io.Fmt, b: io.Fmt) -> io.Fmt {
    if yes {
        io.fmt_free(b)
        return a
    }
    io.fmt_free(a)
    return b
}

fn describe(f: io.Fmt, x: i64) -> io.Fmt {
    var g: io.Fmt = f
    let size: u64 = math.abs(x) as u64
    g = io.fmt_number(g, x)
    g = io.fmt_char(g, 124 as u8)
    g = io.fmt_append(g, either(x % 2 == 0, f"even", f"odd"))
    g = io.fmt_char(g, 124 as u8)
    g = io.fmt_append(g, either(x > 0, f"positive",
            either(x < 0, f"negative", f"zero")))
    g = io.fmt_char(g, 124 as u8)
    g = io.fmt_append(g, either(x > 100, f"yes", f"no"))
    g = io.fmt_char(g, 124 as u8)
    g = io.fmt_number(g, num.digit_count(size, 10) as i64)
    g = io.fmt_char(g, 124 as u8)
    g = io.fmt_number(g, x * x)
    g = io.fmt_char(g, 124 as u8)
    if x < 0 {
        g = io.fmt_char(g, 45 as u8)
    } else {
        g = io.fmt_f64(g, math.sqrt(x as f64))
    }
    return g
}

fn main() -> i32 {
    var f: io.Fmt = io.fmt_new()
    f = describe(f, 144)
    f = io.fmt_char(f, 32 as u8)
    f = describe(f, 0 - 7)
    f = io.fmt_char(f, 32 as u8)
    f = describe(f, 0)
    f = io.fmt_char(f, 32 as u8)
    f = describe(f, 1)
    f = io.fmt_char(f, 32 as u8)
    f = describe(f, 100)
    f = io.fmt_char(f, 32 as u8)
    f = describe(f, 10000)
    let length: usize = io.fmt_len(f)

    var got: io.Text = io.text_of(f)
    var wanted: io.Text = io.text_of(f"144|even|positive|yes|3|20736|12 -7|odd|negative|no|1|49|- 0|even|zero|no|1|0|0 1|odd|positive|no|1|1|1 100|even|positive|no|3|10000|10 10000|even|positive|yes|5|100000000|100")
    let same: bool = str.equal(got.span(), wanted.span())
    let wanted_length: usize = wanted.length()
    got.free()
    wanted.free()
    if !same {
        return 10
    }
    if length != wanted_length {
        return 11
    }

    io.fmt_print_line(f"r69 check: 6 cases {length} octets ok")
    return 0
}
