// expect_out: 1 1 2 128 200 12800 198 1 0
// ERZEUGT von lib/rc/erzeuge_tests.sh: Zeile 1 und der Rumpf aus
// lib/rc/teile/552_rc_zyklus_leck.fi, dazwischen tests/modules/rc.fi WOERTLICH.
// Modul 'rc' — Stufe 2 des Speichermodells (SPEC.md §3.4, Anforderung S7):
// geteilte, IMMER UNVERAENDERLICHE Werte mit Zaehlung, plus schwache
// Verweise, die Zyklen von Hand brechen.
//
// Reines Firn, keine Compileraenderung. Der Speicher kommt direkt von mmap(2)
// (kein MAP_FIXED, keine feste Adresse; ein fehlgeschlagenes mmap wird
// sichtbar gemeldet und nie stillschweigend als Erfolg ausgegeben).
//
// Benutzung aus tests/:      import modules.rc
// Bibliothekspfad:           lib/rc/rc.fi  (Symlink auf genau diese Datei)
//
// ABWEICHUNGEN von SPEC §3.4 (Begruendung im Bericht docs/berichte/rclib.md
// und in docs/RC.md):
//   A1  Die Typnamen heissen 'Zaehlverweis[T]' und 'Schwachverweis[T]'.
//       'Rc'/'Weak'/'Arc' sind im Parser als noch nicht umgesetzte
//       Typkonstruktoren reserviert (compiler/src/parser.rs,
//       nicht_umgesetzter_typ) und koennen von einem reinen Firn-Modul nicht
//       belegt werden. Die Funktionsnamen folgen dem vereinbarten Vertrag
//       (rc_neu, rc_lesen, rc_klonen, rc_freigeben, rc_stark_zahl,
//       weak_von, aufwerten, weak_freigeben).
//   A2  Stufe 0 kennt keine Methoden: 'Rc[T].neu' ist die Funktion 'rc_neu'.
//   A3  Stufe 0 kennt kein 'inout': der Halde-Parameter ist ein '*mut RcHeap'.
//   A4  Der Erfolgswert der Allokation kommt ueber einen Ausgabezeiger, die
//       Rueckgabe ist 'AllocError!bool'. Grund: die Monomorphisierung setzt
//       Typargumente in der Nutzlast einer Fehlerunion nicht ein —
//       'fn f[T](..) -> AllocError!Zaehlverweis[T]' meldet
//       "unbekannter typ 'Zaehlverweis__T'". Die Allokation bleibt damit
//       vollstaendig fehlbar (DESIGNZIELE §2) und das Ergebnis ist
//       '#[must_consume]'; Verwerfen ist ein Compilerfehler
//       (tests/neg/rc_verworfen.fi).
//   A5  'Arc[T]' (atomarer Zaehler) ist NICHT gebaut — offen.
//
// ZYKLEN LECKEN. Das ist gewollt und wird in tests/552_rc_zyklus_leck.fi
// sichtbar gemacht, nicht versteckt. Fuer den DOM ist 'Rc' deshalb
// ausdruecklich NICHT vorgesehen — dafuer gibt es 'gc class'/'Gc[T]'
// (SPEC §3.5). Siehe docs/RC.md.

export {
    AllocError, RcHeap, Zaehlverweis, Schwachverweis,
    rc_heap_init, rc_heap_frei, rc_heap_kapazitaet, rc_heap_lebende,
    rc_heap_belegte_bytes, rc_heap_allokationen, rc_heap_freigaben,
    rc_groesse_von, rc_ld64, rc_st64,
    rc_neu, rc_leer, rc_ist_leer, rc_lesen, rc_klonen, rc_freigeben,
    rc_stark_zahl, rc_schwach_zahl, rc_gleich,
    rc_roh_adresse, rc_wert_adresse, rc_roh_verweis,
    weak_von, weak_leer, weak_ist_leer, aufwerten, weak_freigeben,
    weak_stark_zahl, weak_roh_adresse
}

// Die Fehlermenge der fehlbaren Allokation (DESIGNZIELE §2). Fehlermengennamen
// sind programmweit (SPEC §14.1); im Endstand deklariert sie die GC-Laufzeit
// (Modul 'gckern'). Solange die noch nicht im Baum ist, steht sie hier —
// Modul 'mess' loest die Doppelung auf, sobald beide Fassungen existieren.
error AllocError { OutOfMemory }

const RC_SYS_MMAP: i64 = 9
const RC_SYS_MUNMAP: i64 = 11
const RC_PROT_READ_WRITE: i64 = 3
const RC_MAP_PRIVATE_ANON: i64 = 34

// Blockkopf: 32 Byte, danach der Wert.
//   +0   stark      u64   Zahl der starken Verweise
//   +8   schwach    u64   Zahl der schwachen Verweise
//   +16  klasse     u64   Groessenklasse (fuer die Freiliste)
//   +24  naechster  u64   Verkettung in der Freiliste (nur wenn frei)
//   +32  wert       T
const RC_KOPF: usize = 32
const RC_KLASSEN: usize = 8
const RC_KLASSE0: usize = 64

// Zaehlender, geteilter, unveraenderlicher Verweis (SPEC §3.4 'Rc[T]').
// 'block' ist 0, wenn der Verweis leer ist.
struct Zaehlverweis[T] { block: usize }

// Schwacher Verweis (SPEC §3.4 'Weak[T]'), haelt den Wert NICHT am Leben.
struct Schwachverweis[T] { block: usize }

// Die Halde. Feste Kapazitaet — genau das macht die Allokation fehlbar und
// ist die Grundlage fuer Speichergrenzen pro Auftrag.
struct RcHeap {
    basis: usize,
    kapazitaet: usize,
    naechster: usize,
    frei: [usize; 8],
    lebende: usize,
    belegt: usize,
    allokationen: usize,
    freigaben: usize,
}

// Hilfstyp, um die Schrittweite eines Typs ohne 'sizeof' zu bestimmen.
struct RcPaar[T] { a: T, b: T }

fn rc_seiten(n: usize) -> usize {
    return (n + 4095 as usize) / 4096 as usize * 4096 as usize
}

fn rc_ld64(adr: usize) -> u64 {
    return *(adr as *mut u64)
}

fn rc_st64(adr: usize, v: u64) {
    *(adr as *mut u64) = v
}

// Schrittweite (Groesse einschliesslich Ausrichtung) des Typs T.
fn rc_groesse_von[T: Any](muster: T) -> usize {
    var p: RcPaar[T] = RcPaar[T]{ a: muster, b: muster }
    return (&p.b) as usize - (&p.a) as usize
}

fn rc_klasse_bytes(k: usize) -> usize {
    var b: usize = RC_KLASSE0
    var i: usize = 0 as usize
    while i < k {
        b = b * 2 as usize
        i = i + 1 as usize
    }
    return b
}

// Kleinste Klasse, in die 'gesamt' Bytes passen; RC_KLASSEN = zu gross.
fn rc_klasse_fuer(gesamt: usize) -> usize {
    var k: usize = 0 as usize
    while k < RC_KLASSEN {
        if gesamt <= rc_klasse_bytes(k) {
            return k
        }
        k = k + 1 as usize
    }
    return RC_KLASSEN
}

// Legt die Halde an. false = mmap fehlgeschlagen (sichtbarer Fehlschlag,
// der Aufrufer MUSS abbrechen). Ohne feste Adresse, ohne MAP_FIXED.
fn rc_heap_init(h: *mut RcHeap, bytes: usize) -> bool {
    (*h).basis = 0 as usize
    (*h).kapazitaet = 0 as usize
    (*h).naechster = 0 as usize
    (*h).lebende = 0 as usize
    (*h).belegt = 0 as usize
    (*h).allokationen = 0 as usize
    (*h).freigaben = 0 as usize
    var i: usize = 0 as usize
    while i < RC_KLASSEN {
        (*h).frei[i] = 0 as usize
        i = i + 1 as usize
    }
    if bytes == 0 as usize {
        return false
    }
    let len: usize = rc_seiten(bytes)
    let r: i64 = syscall(RC_SYS_MMAP, 0, len as i64, RC_PROT_READ_WRITE,
                         RC_MAP_PRIVATE_ANON, 0 - 1, 0)
    if r < 0 && r > 0 - 4096 {
        return false
    }
    if r == 0 {
        return false
    }
    (*h).basis = r as usize
    (*h).kapazitaet = len
    return true
}

fn rc_heap_frei(h: *mut RcHeap) {
    if (*h).basis != 0 as usize {
        syscall(RC_SYS_MUNMAP, (*h).basis as i64, (*h).kapazitaet as i64)
    }
    (*h).basis = 0 as usize
    (*h).kapazitaet = 0 as usize
    (*h).naechster = 0 as usize
}

fn rc_heap_kapazitaet(h: *mut RcHeap) -> usize { return (*h).kapazitaet }
fn rc_heap_lebende(h: *mut RcHeap) -> usize { return (*h).lebende }
fn rc_heap_belegte_bytes(h: *mut RcHeap) -> usize { return (*h).belegt }
fn rc_heap_allokationen(h: *mut RcHeap) -> usize { return (*h).allokationen }
fn rc_heap_freigaben(h: *mut RcHeap) -> usize { return (*h).freigaben }

// Rohblock holen. 0 = kein Speicher mehr.
fn rc_block_holen(h: *mut RcHeap, nutzlast: usize) -> usize {
    let k: usize = rc_klasse_fuer(RC_KOPF + nutzlast)
    if k >= RC_KLASSEN {
        return 0 as usize
    }
    let gr: usize = rc_klasse_bytes(k)
    var adr: usize = (*h).frei[k]
    if adr != 0 as usize {
        (*h).frei[k] = rc_ld64(adr + 24 as usize) as usize
    } else {
        if (*h).basis == 0 as usize {
            return 0 as usize
        }
        if (*h).naechster + gr > (*h).kapazitaet {
            return 0 as usize
        }
        adr = (*h).basis + (*h).naechster
        (*h).naechster = (*h).naechster + gr
    }
    rc_st64(adr + 0 as usize, 0 as u64)
    rc_st64(adr + 8 as usize, 0 as u64)
    rc_st64(adr + 16 as usize, k as u64)
    rc_st64(adr + 24 as usize, 0 as u64)
    (*h).lebende = (*h).lebende + 1 as usize
    (*h).belegt = (*h).belegt + gr
    (*h).allokationen = (*h).allokationen + 1 as usize
    return adr
}

fn rc_block_zurueck(h: *mut RcHeap, adr: usize) {
    let k: usize = rc_ld64(adr + 16 as usize) as usize
    if k >= RC_KLASSEN {
        return
    }
    rc_st64(adr + 24 as usize, (*h).frei[k] as u64)
    (*h).frei[k] = adr
    (*h).lebende = (*h).lebende - 1 as usize
    (*h).belegt = (*h).belegt - rc_klasse_bytes(k)
    (*h).freigaben = (*h).freigaben + 1 as usize
}

// Legt 'wert' auf der Halde ab und liefert einen starken Verweis in '*aus'.
// FEHLBAR (DESIGNZIELE §2): bei erschoepfter Halde AllocError::OutOfMemory.
// Das Ergebnis ist '#[must_consume]' — Verwerfen ist ein Compilerfehler.
fn rc_neu[T: Any](h: *mut RcHeap, wert: T, aus: *mut Zaehlverweis[T]) -> AllocError!bool {
    (*aus).block = 0 as usize
    let gr: usize = rc_groesse_von[T](wert)
    let adr: usize = rc_block_holen(h, gr)
    if adr == 0 as usize {
        return AllocError::OutOfMemory
    }
    rc_st64(adr + 0 as usize, 1 as u64)
    rc_st64(adr + 8 as usize, 0 as u64)
    *((adr + RC_KOPF) as *mut T) = wert
    (*aus).block = adr
    return true
}

fn rc_leer[T: Any]() -> Zaehlverweis[T] {
    return Zaehlverweis[T]{ block: 0 as usize }
}

fn rc_ist_leer[T: Any](r: Zaehlverweis[T]) -> bool {
    return r.block == 0 as usize
}

// NUR LESEN. 'Rc' ist immer unveraenderlich (SPEC §3.4): es gibt kein
// RefCell-Aequivalent und in diesem Modul keine schreibende Funktion.
// Geliefert wird eine Kopie des Wertes — Aenderungen daran wirken nicht
// zurueck auf den geteilten Wert.
fn rc_lesen[T: Any](r: Zaehlverweis[T]) -> T {
    return *((r.block + RC_KOPF) as *mut T)
}

fn rc_klonen[T: Any](r: Zaehlverweis[T]) -> Zaehlverweis[T] {
    if r.block == 0 as usize {
        return Zaehlverweis[T]{ block: 0 as usize }
    }
    rc_st64(r.block + 0 as usize, rc_ld64(r.block + 0 as usize) + 1 as u64)
    return Zaehlverweis[T]{ block: r.block }
}

// Gibt einen starken Verweis zurueck und leert ihn. Faellt der starke Zaehler
// auf 0 und haelt kein schwacher Verweis mehr den Block, wird er wiederverwendbar.
fn rc_freigeben[T: Any](h: *mut RcHeap, r: *mut Zaehlverweis[T]) {
    let adr: usize = (*r).block
    if adr == 0 as usize {
        return
    }
    (*r).block = 0 as usize
    let s: u64 = rc_ld64(adr + 0 as usize)
    if s == 0 as u64 {
        return
    }
    rc_st64(adr + 0 as usize, s - 1 as u64)
    if s - 1 as u64 == 0 as u64 && rc_ld64(adr + 8 as usize) == 0 as u64 {
        rc_block_zurueck(h, adr)
    }
}

fn rc_stark_zahl[T: Any](r: Zaehlverweis[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return rc_ld64(r.block + 0 as usize)
}

fn rc_schwach_zahl[T: Any](r: Zaehlverweis[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return rc_ld64(r.block + 8 as usize)
}

fn rc_gleich[T: Any](a: Zaehlverweis[T], b: Zaehlverweis[T]) -> bool {
    return a.block == b.block
}

// Rohzugriff (SPEC §3.6): die Blockadresse bzw. die Adresse des Wertes.
// Nur fuer Werkzeuge und den Leck-Nachweis — kein Weg, 'Rc' schreibbar zu
// machen; wer hierueber schreibt, verlaesst die geprueften Typen.
fn rc_roh_adresse[T: Any](r: Zaehlverweis[T]) -> usize { return r.block }

// Aus einer Blockadresse wieder einen Verweis bilden, OHNE den Zaehler zu
// aendern. Nur fuer Werkzeuge: Stufe 0 kennt keine Destruktoren, deshalb
// muessen in einem Objekt gespeicherte Verweise von Hand aufgeloest werden
// (SPEC §3.6 Rohzeiger; im Endstand macht das 'drop', SPEC §3.3).
fn rc_roh_verweis[T: Any](adr: usize) -> Zaehlverweis[T] {
    return Zaehlverweis[T]{ block: adr }
}
fn rc_wert_adresse[T: Any](r: Zaehlverweis[T]) -> usize {
    if r.block == 0 as usize {
        return 0 as usize
    }
    return r.block + RC_KOPF
}

fn weak_von[T: Any](r: Zaehlverweis[T]) -> Schwachverweis[T] {
    if r.block == 0 as usize {
        return Schwachverweis[T]{ block: 0 as usize }
    }
    rc_st64(r.block + 8 as usize, rc_ld64(r.block + 8 as usize) + 1 as u64)
    return Schwachverweis[T]{ block: r.block }
}

fn weak_leer[T: Any]() -> Schwachverweis[T] {
    return Schwachverweis[T]{ block: 0 as usize }
}

fn weak_ist_leer[T: Any](w: Schwachverweis[T]) -> bool {
    return w.block == 0 as usize
}

fn weak_roh_adresse[T: Any](w: Schwachverweis[T]) -> usize { return w.block }

fn weak_stark_zahl[T: Any](w: Schwachverweis[T]) -> u64 {
    if w.block == 0 as usize {
        return 0 as u64
    }
    return rc_ld64(w.block + 0 as usize)
}

// Aufwertung: liefert sichtbar den LEEREN Verweis, wenn der starke Zaehler
// bereits 0 ist (das Ziel also eingesammelt wurde).
fn aufwerten[T: Any](w: Schwachverweis[T]) -> Zaehlverweis[T] {
    if w.block == 0 as usize {
        return Zaehlverweis[T]{ block: 0 as usize }
    }
    let s: u64 = rc_ld64(w.block + 0 as usize)
    if s == 0 as u64 {
        return Zaehlverweis[T]{ block: 0 as usize }
    }
    rc_st64(w.block + 0 as usize, s + 1 as u64)
    return Zaehlverweis[T]{ block: w.block }
}

fn weak_freigeben[T: Any](h: *mut RcHeap, w: *mut Schwachverweis[T]) {
    let adr: usize = (*w).block
    if adr == 0 as usize {
        return
    }
    (*w).block = 0 as usize
    let s: u64 = rc_ld64(adr + 8 as usize)
    if s == 0 as u64 {
        return
    }
    rc_st64(adr + 8 as usize, s - 1 as u64)
    if s - 1 as u64 == 0 as u64 && rc_ld64(adr + 0 as usize) == 0 as u64 {
        rc_block_zurueck(h, adr)
    }
}

// PFLICHTNACHWEIS zu SPEC §3.4: ein Rc-ZYKLUS LECKT. Das ist kein Fehler
// dieser Umsetzung, sondern die dokumentierte Eigenschaft der Zaehlung — und
// genau der Grund, warum 'Rc' fuer den DOM ausdruecklich NICHT vorgesehen ist
// (siehe docs/RC.md). Der Test macht das Leck SICHTBAR statt es zu verstecken.
//
// Aufbau: zwei Zellen a und b, die einander stark halten.
// 'Rc' ist immer unveraenderlich (kein RefCell-Aequivalent), deshalb kann der
// Rueckverweis nicht ueber die Rc-Schnittstelle nachgetragen werden — der Test
// benutzt dafuer den Rohzeiger aus SPEC §3.6 (rc_wert_adresse). Genau das
// wuerde eine Innenveraenderlichkeit tun; mit ihr waere derselbe Zyklus mit
// gewoehnlichem Anwendungscode erreichbar.
//
// Ausgabe (eine Zeile):
//   stark_a stark_b lebende belegt   nach dem Verwerfen EINES Zyklus
//   lebende100 belegt100                nach 100 angelegten+verworfenen Zyklen
//   lebende_nach_handaufloesung
//   aufwerten_leer  lebende_weak_variante

struct Zelle { partner: usize, kennung: i64 }

fn heap_leer() -> RcHeap {
    return RcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize,
    }
}

fn neue_zelle(h: *mut RcHeap, k: i64, aus: *mut Zaehlverweis[Zelle]) -> bool {
    return rc_neu[Zelle](h, Zelle{ partner: 0 as usize, kennung: k }, aus) catch false
}

// Traegt den Partner in eine bereits angelegte Zelle nach. Rohzugriff
// (SPEC §3.6) — ueber 'Rc' selbst ist Schreiben nicht moeglich, siehe
// tests/neg/rc_unveraenderlich.fi.
fn partner_setzen(r: Zaehlverweis[Zelle], partner_block: usize) {
    let adr: usize = rc_wert_adresse[Zelle](r)
    *(adr as *mut usize) = partner_block
}

// Legt einen echten Zyklus a -> b -> a an und verwirft beide aeusseren
// Griffe. Was bleibt, sind die beiden Verweise IN den Zellen: die Zaehler
// fallen nie auf 0.
fn zyklus_anlegen_und_verwerfen(h: *mut RcHeap) -> bool {
    var a: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    var b: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    if neue_zelle(h, 1, &a) == false { return false }
    if neue_zelle(h, 2, &b) == false { return false }
    // a haelt b stark, b haelt a stark.
    var a_in_b: Zaehlverweis[Zelle] = rc_klonen[Zelle](a)
    var b_in_a: Zaehlverweis[Zelle] = rc_klonen[Zelle](b)
    partner_setzen(a, rc_roh_adresse[Zelle](b_in_a))
    partner_setzen(b, rc_roh_adresse[Zelle](a_in_b))
    // Die aeusseren Griffe verschwinden (im echten Programm: Blockende).
    rc_freigeben[Zelle](h, &a)
    rc_freigeben[Zelle](h, &b)
    return true
}

fn print_zahl(buf: *mut u8, pos: usize, v: u64) -> usize {
    var ziffern: [u8; 24] = [0 as u8; 24]
    var n: usize = 0 as usize
    var x: u64 = v
    if x == 0 as u64 {
        ziffern[0] = 48 as u8
        n = 1 as usize
    }
    while x > 0 as u64 {
        ziffern[n] = (x % 10 as u64) as u8 + 48 as u8
        x = x / 10 as u64
        n = n + 1 as usize
    }
    var i: usize = 0 as usize
    var p: usize = pos
    while i < n {
        *((buf as usize + p) as *mut u8) = ziffern[n - 1 as usize - i]
        p = p + 1 as usize
        i = i + 1 as usize
    }
    *((buf as usize + p) as *mut u8) = 32 as u8
    return p + 1 as usize
}

fn main() -> i32 {
    var h: RcHeap = heap_leer()
    if rc_heap_init(&h, 1048576 as usize) == false { return 90 }

    // --- Teil 1: EIN Zyklus, beide Zaehler bleiben bei 1 -------------------
    var a: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    var b: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    if neue_zelle(&h, 1, &a) == false { return 91 }
    if neue_zelle(&h, 2, &b) == false { return 92 }
    var a_in_b: Zaehlverweis[Zelle] = rc_klonen[Zelle](a)
    var b_in_a: Zaehlverweis[Zelle] = rc_klonen[Zelle](b)
    let adr_a: usize = rc_roh_adresse[Zelle](a)
    let adr_b: usize = rc_roh_adresse[Zelle](b)
    partner_setzen(a, adr_b)
    partner_setzen(b, adr_a)
    rc_freigeben[Zelle](&h, &a)
    rc_freigeben[Zelle](&h, &b)
    // Beide Zaehler stehen weiter auf 1 — der Zyklus haelt sich selbst.
    let stark_a: u64 = rc_ld64(adr_a + 0 as usize)
    let stark_b: u64 = rc_ld64(adr_b + 0 as usize)
    let lebende1: usize = rc_heap_lebende(&h)
    let belegt1: usize = rc_heap_belegte_bytes(&h)

    // --- Teil 2: 100 Zyklen anlegen und verwerfen -> der Verbrauch waechst
    var i: i64 = 0
    while i < 99 {
        if zyklus_anlegen_und_verwerfen(&h) == false { return 93 }
        i = i + 1
    }
    let lebende100: usize = rc_heap_lebende(&h)
    let belegt100: usize = rc_heap_belegte_bytes(&h)

    // --- Teil 3: von Hand aufloesen (nur so kommt der Speicher zurueck) ---
    // Stufe 0 kennt keine Destruktoren; die in den Zellen gespeicherten
    // Verweise muessen einzeln geloest werden. Fuer die 99 Zyklen aus Teil 2
    // ist die Adresse nicht mehr bekannt — genau das ist das Leck. Aufgeloest
    // wird deshalb nur der erste Zyklus, dessen Adressen wir noch haben.
    var innen_a: Zaehlverweis[Zelle] = rc_roh_verweis[Zelle](adr_a)
    var innen_b: Zaehlverweis[Zelle] = rc_roh_verweis[Zelle](adr_b)
    rc_freigeben[Zelle](&h, &innen_a)
    rc_freigeben[Zelle](&h, &innen_b)
    let lebende_hand: usize = rc_heap_lebende(&h)

    // --- Teil 4: derselbe Aufbau mit Weak leckt NICHT ---------------------
    var h2: RcHeap = heap_leer()
    if rc_heap_init(&h2, 65536 as usize) == false { return 94 }
    var x: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    var y: Zaehlverweis[Zelle] = rc_leer[Zelle]()
    if neue_zelle(&h2, 3, &x) == false { return 95 }
    if neue_zelle(&h2, 4, &y) == false { return 96 }
    // y haelt x nur SCHWACH, x haelt y stark -> kein Zyklus aus starken Verweisen.
    var w: Schwachverweis[Zelle] = weak_von[Zelle](x)
    var y_in_x: Zaehlverweis[Zelle] = rc_klonen[Zelle](y)
    partner_setzen(x, rc_roh_adresse[Zelle](y_in_x))
    partner_setzen(y, weak_roh_adresse[Zelle](w))
    let adr_y: usize = rc_roh_adresse[Zelle](y)
    rc_freigeben[Zelle](&h2, &y)
    rc_freigeben[Zelle](&h2, &x)
    // x ist tot: die Aufwertung des schwachen Verweises liefert sichtbar leer.
    var auf: Zaehlverweis[Zelle] = aufwerten[Zelle](w)
    var leer: u64 = 0 as u64
    if rc_ist_leer[Zelle](auf) {
        leer = 1 as u64
    }
    // Den inneren starken Verweis von x auf y von Hand loesen (kein 'drop').
    var innen_y: Zaehlverweis[Zelle] = rc_roh_verweis[Zelle](adr_y)
    rc_freigeben[Zelle](&h2, &innen_y)
    weak_freigeben[Zelle](&h2, &w)
    let lebende_weak: usize = rc_heap_lebende(&h2)

    var aus: [u8; 128] = [0 as u8; 128]
    var p: usize = 0 as usize
    p = print_zahl(&aus[0], p, stark_a)
    p = print_zahl(&aus[0], p, stark_b)
    p = print_zahl(&aus[0], p, lebende1 as u64)
    p = print_zahl(&aus[0], p, belegt1 as u64)
    p = print_zahl(&aus[0], p, lebende100 as u64)
    p = print_zahl(&aus[0], p, belegt100 as u64)
    p = print_zahl(&aus[0], p, lebende_hand as u64)
    p = print_zahl(&aus[0], p, leer)
    p = print_zahl(&aus[0], p, lebende_weak as u64)
    aus[p - 1 as usize] = 10 as u8
    syscall(1, 1, &aus[0], p as i64)

    rc_heap_frei(&h)
    rc_heap_frei(&h2)
    return 0
}
