// expect_exit: 0
// tests/2770_mc_cull.fi -- mc_cull: face connectivity of sections, frustum + cave culling.
//
// A  cull_conn on hand made sections: open, solid, a wall, an x tunnel, a closed room, two separate tunnels
// B  graph (set / get / remove column) with tombstones
// C  terrain world (mc_terrain): for 36 camera poses (surface, tunnels, caverns, inside rock) the image of
//    "every section in the frustum" == the image of "only the sections cull_run keeps" (byte identical), with and
//    without the set-back rule; the kept list is a subset of the frustum list; some sections are really culled
// D  counter-check: a graph in which every section is closed (conn 0) culls too much -> some image differs
import std.rt
import mc.mc_mesh
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_cull
import mc.mc_terrain

const NSEC: i32 = 6
const RAD: i32 = 3 // generated columns -RAD..RAD

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

static mut g_tb_opaque: u64 = 0

// padded array filled with one id; cells of the inner 16^3 can be changed with set_cell
fn pad_new(id: u16) -> u64 {
    let p: u64 = rt.heap_alloc(5832 * 2)
    var i: usize = 0
    while i < 5832 {
        rt.st16(p, i, id)
        i = i + 1
    }
    return p
}

fn set_cell(p: u64, x: usize, y: usize, z: usize, id: u16) {
    rt.st16(p, ((y + 1) * 18 + (z + 1)) * 18 + x + 1, id)
}

fn part_a(opaque: u64, scr: u64) {
    // open
    let a: u64 = pad_new(0 as u16)
    check(mc_cull.cull_conn(a, opaque, scr) == mc_cull.CONN_ALL, 10)
    // solid
    let s: u64 = pad_new(1 as u16)
    check(mc_cull.cull_conn(s, opaque, scr) == 0 as u32, 11)
    // wall at x = 8 (all y, z): -x and +x are NOT connected, the other four faces are
    let w: u64 = pad_new(0 as u16)
    var y: usize = 0
    while y < 16 {
        var z: usize = 0
        while z < 16 {
            set_cell(w, 8, y, z, 1 as u16)
            z = z + 1
        }
        y = y + 1
    }
    let cw: u32 = mc_cull.cull_conn(w, opaque, scr)
    check(!mc_cull.cull_connected(cw, 0, 1), 12)
    check(mc_cull.cull_connected(cw, 2, 3) && mc_cull.cull_connected(cw, 4, 5) && mc_cull.cull_connected(cw, 2, 4), 13)
    // x tunnel through solid rock: only (-x, +x)
    let t: u64 = pad_new(1 as u16)
    var x: usize = 0
    while x < 16 {
        set_cell(t, x, 5, 7, 0 as u16)
        x = x + 1
    }
    let ct: u32 = mc_cull.cull_conn(t, opaque, scr)
    check(ct == mc_cull.cull_pair_bit(0, 1), 14)
    // closed room inside rock: no pair
    let r: u64 = pad_new(1 as u16)
    set_cell(r, 7, 7, 7, 0 as u16)
    set_cell(r, 8, 7, 7, 0 as u16)
    check(mc_cull.cull_conn(r, opaque, scr) == 0 as u32, 15)
    // two separate tunnels: x tunnel and y tunnel -> exactly the two pairs
    let u: u64 = pad_new(1 as u16)
    x = 0
    while x < 16 {
        set_cell(u, x, 3, 3, 0 as u16)
        x = x + 1
    }
    y = 0
    while y < 16 {
        set_cell(u, 12, y, 12, 0 as u16)
        y = y + 1
    }
    let cu: u32 = mc_cull.cull_conn(u, opaque, scr)
    check(cu == (mc_cull.cull_pair_bit(0, 1) | mc_cull.cull_pair_bit(2, 3)), 16)
    // all 15 pair bits are distinct
    var seen: u32 = 0 as u32
    var i: usize = 0
    while i < 6 {
        var j: usize = i + 1
        while j < 6 {
            let bit: u32 = mc_cull.cull_pair_bit(i, j)
            check((seen & bit) == 0 as u32 && bit == mc_cull.cull_pair_bit(j, i), 17)
            seen = seen | bit
            j = j + 1
        }
        i = i + 1
    }
    check(seen == mc_cull.CONN_ALL, 18)
    rt.heap_free(a, 5832 * 2)
    rt.heap_free(s, 5832 * 2)
    rt.heap_free(w, 5832 * 2)
    rt.heap_free(t, 5832 * 2)
    rt.heap_free(r, 5832 * 2)
    rt.heap_free(u, 5832 * 2)
}

fn part_b() {
    var c: mc_cull.Cull = mc_cull.cull_new(0, 6)
    check(mc_cull.cull_get(&c, 1, 2, 3) == 4294967295 as u32, 20)
    var i: i32 = 0
    while i < 3000 {
        mc_cull.cull_set(&c, i % 50, i % 6, i / 50, (i as u32) & 32767 as u32)
        i = i + 1
    }
    check(mc_cull.cull_known(&c) == 3000, 21)
    check(mc_cull.cull_get(&c, 7, 107 % 6, 2) == 107 as u32, 22)
    mc_cull.cull_set(&c, 7, 107 % 6, 2, 99 as u32)
    check(mc_cull.cull_get(&c, 7, 107 % 6, 2) == 99 as u32 && mc_cull.cull_known(&c) == 3000, 23)
    mc_cull.cull_remove_column(&c, 7, 2)
    check(mc_cull.cull_get(&c, 7, 107 % 6, 2) == 4294967295 as u32, 24)
    check(mc_cull.cull_known(&c) < 3000, 25)
    // re-adding after deletions and a lot of churn still finds everything
    i = 0
    while i < 3000 {
        mc_cull.cull_set(&c, i % 50, i % 6, i / 50, 5 as u32)
        i = i + 1
    }
    check(mc_cull.cull_get(&c, 49, 2999 % 6, 59) == 5 as u32, 26)
    mc_cull.cull_free(&c)
}

// world padded array of the section (cx, sy, cz) from the terrain; outside the generated columns / world: unknown
fn world_pad(cx: i32, sy: i32, cz: i32, pad: u64) {
    var py: i32 = 0
    while py < 18 {
        var pz: i32 = 0
        while pz < 18 {
            var px: i32 = 0
            while px < 18 {
                let x: i32 = cx * 16 + px - 1
                let y: i32 = sy * 16 + py - 1
                let z: i32 = cz * 16 + pz - 1
                let colx: i32 = mc_terrain_floor_div16(x)
                let colz: i32 = mc_terrain_floor_div16(z)
                var id: u16 = 65535 as u16
                if colx >= 0 - RAD && colx <= RAD && colz >= 0 - RAD && colz <= RAD && y >= 0 && y < NSEC * 16 {
                    id = mc_terrain.terrain_block(x, y, z, NSEC)
                }
                rt.st16(pad, ((py * 18 + pz) * 18 + px) as usize, id)
                px = px + 1
            }
            pz = pz + 1
        }
        py = py + 1
    }
}

fn mc_terrain_floor_div16(v: i32) -> i32 {
    var q: i32 = v / 16
    if v % 16 != 0 && v < 0 { q = q - 1 }
    return q
}

static mut g_seed: u64 = 12345

fn rnd() -> u64 {
    g_seed = g_seed *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
    return g_seed >> 33 as u64
}

fn rnd_f(lo: f64, hi: f64) -> f64 {
    return lo + (hi - lo) * ((rnd() % 100000 as u64) as f64 / 100000.0)
}

// handles of the meshes of every section (index ((cz + RAD) * 7 + cx + RAD) * NSEC + sy), built once
fn build_meshes(r: *mut mc_raster.Raster, tb: *mut mc_mesh.MeshTables, m: *mut mc_mesh.Mesher, pad: u64, hs: u64) {
    var cz: i32 = 0 - RAD
    while cz <= RAD {
        var cx: i32 = 0 - RAD
        while cx <= RAD {
            var sy: i32 = 0
            while sy < NSEC {
                world_pad(cx, sy, cz, pad)
                mc_mesh.mesh_padded(m, pad, tb, mc_mesh.F_AO | mc_mesh.F_GREEDY)
                var hd: usize = 0
                if (*m).nverts > 0 as u32 {
                    hd = mc_raster.backend_mesh_upload(r, cull_key(cx, sy, cz), (*m).verts, (*m).nverts as usize, (*m).idx, (*m).nidx as usize)
                }
                rt.st64(hs, ((((cz + RAD) * (RAD * 2 + 1) + cx + RAD) * NSEC) + sy) as usize, hd as u64)
                sy = sy + 1
            }
            cx = cx + 1
        }
        cz = cz + 1
    }
}

fn cull_key(cx: i32, sy: i32, cz: i32) -> u64 {
    return mc_cull.cull_pack(cx, sy, cz)
}

// draws the first `n` sections of the list `c.out` and returns the image hash in h
fn render_list(r: *mut mc_raster.Raster, cam: *mut mc_camera.Camera, c: *mut mc_cull.Cull, n: usize, hs: u64, h: u64) {
    mc_raster.backend_begin(r, cam, 0xFF3C2814 as u32)
    var k: usize = 0
    while k < n {
        let key: u64 = mc_cull.cull_out_key(c, k)
        let cx: i32 = mc_cull.cull_out_cx(key)
        let cz: i32 = mc_cull.cull_out_cz(key)
        let sy: i32 = mc_cull.cull_out_sy(key)
        k = k + 1
        if cx < 0 - RAD || cx > RAD || cz < 0 - RAD || cz > RAD { continue }
        let hd: usize = rt.ld64(hs, ((((cz + RAD) * (RAD * 2 + 1) + cx + RAD) * NSEC) + sy) as usize) as usize
        if hd != 0 {
            mc_raster.backend_draw(r, hd, (cx * 16) as f64, (sy * 16) as f64, (cz * 16) as f64)
        }
    }
    mc_raster.backend_end(r)
    mc_raster.raster_hash_hex(r, h)
}

fn same_hash(a: u64, b: u64) -> bool {
    var i: usize = 0
    while i < 64 {
        if rt.ld8(a, i) != rt.ld8(b, i) { return false }
        i = i + 1
    }
    return true
}

fn in_list(c: *mut mc_cull.Cull, n: usize, key: u64) -> bool {
    var i: usize = 0
    while i < n {
        if mc_cull.cull_out_key(c, i) == key { return true }
        i = i + 1
    }
    return false
}

// y of an air block in the x tunnel of the band z = 0 at x = 5 (search), or -1
fn tunnel_y() -> i32 {
    var y: i32 = 4
    while y < 60 {
        if mc_terrain.terrain_block(5, y, 0, NSEC) == 0 as u16 && mc_terrain.terrain_block(5, y + 1, 0, NSEC) == 0 as u16 &&
        mc_terrain.terrain_block(5, y - 1, 0, NSEC) != 0 as u16 && mc_terrain.terrain_height(5, 0, NSEC) > y + 6 {
            return y
        }
        y = y + 1
    }
    return 0 - 1
}

fn fl(v: f64) -> i32 {
    var x: i32 = v as i32
    if (x as f64) > v { x = x - 1 }
    return x
}

fn main() -> i32 {
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_terrain.terrain_tables(&tb)
    let scr: u64 = rt.heap_alloc(12288)
    part_a(tb.opaque, scr)
    part_b()

    // C: terrain world, 7 x 7 columns
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    var r: mc_raster.Raster = mc_raster.raster_new(96, 54)
    mc_raster.backend_upload_atlas(&r, &a)
    var cam: mc_camera.Camera = mc_camera.camera_new(96, 54)
    mc_camera.camera_set_lens(&cam, 70.0, 0.05, 160.0)
    var c: mc_cull.Cull = mc_cull.cull_new(0, NSEC)
    var cbad: mc_cull.Cull = mc_cull.cull_new(0, NSEC)
    let pad: u64 = rt.heap_alloc(5832 * 2)
    var cz: i32 = 0 - RAD
    while cz <= RAD {
        var cx: i32 = 0 - RAD
        while cx <= RAD {
            var sy: i32 = 0
            while sy < NSEC {
                world_pad(cx, sy, cz, pad)
                mc_cull.cull_set(&c, cx, sy, cz, mc_cull.cull_conn(pad, tb.opaque, scr))
                mc_cull.cull_set(&cbad, cx, sy, cz, 0 as u32)
                sy = sy + 1
            }
            cx = cx + 1
        }
        cz = cz + 1
    }
    var m: mc_mesh.Mesher = mc_mesh.mesher_new()
    let hs: u64 = rt.heap_alloc(7 * 7 * 6 * 8)
    build_meshes(&r, &tb, &m, pad, hs)
    let h1: u64 = rt.heap_alloc(64)
    let h2: u64 = rt.heap_alloc(64)
    let h3: u64 = rt.heap_alloc(64)
    let ty: i32 = tunnel_y()
    check(ty > 0, 30)
    var total_frustum: usize = 0
    var total_bfs: usize = 0
    var total_bfs_nosb: usize = 0
    var bad_diff: i32 = 0
    var tunnel_culled: usize = 0
    var pose: i32 = 0
    while pose < 36 {
        var px: f64 = rnd_f(0.0 - 40.0, 40.0)
        var pz: f64 = rnd_f(0.0 - 40.0, 40.0)
        var py: f64 = 0.0
        let mode: i32 = pose % 3
        if mode == 0 {
            py = (mc_terrain.terrain_height(fl(px), fl(pz), NSEC) + 3) as f64
        } else if mode == 1 {
            px = rnd_f(2.0, 40.0)
            pz = 0.5
            py = (ty as f64) + 0.5
        } else {
            py = rnd_f(5.0, 30.0)
        }
        // camera must be in air: move up until free
        var guard: i32 = 0
        while mc_terrain.terrain_block(fl(px), fl(py), fl(pz), NSEC) != 0 as u16 && guard < 80 {
            py = py + 1.0
            guard = guard + 1
        }
        mc_camera.camera_set_pos(&cam, px, py, pz)
        var yaw: f64 = rnd_f(0.0 - 180.0, 180.0)
        if mode == 1 {
            yaw = 90.0 // along -x ... the tunnel runs along x: look along it
            if pose % 2 == 0 { yaw = 0.0 - 90.0 }
        }
        mc_camera.camera_set_angles(&cam, yaw, rnd_f(0.0 - 30.0, 30.0))
        mc_camera.camera_update(&cam)
        // all sections in the frustum
        let nf: usize = mc_cull.cull_run_frustum(&c, &cam, RAD + 1)
        // a copy of the frustum list (c.out is reused by cull_run)
        let flist: u64 = rt.heap_alloc(nf * 16 + 16)
        rt.mem_copy(flist, c.out, nf * 16)
        render_list(&r, &cam, &c, nf, hs, h1)
        // cave culling with the set-back rule
        let nb: usize = mc_cull.cull_run(&c, &cam, RAD + 1, true)
        check(nb <= nf, 31)
        var k: usize = 0
        while k < nb {
            var found: bool = false
            let key: u64 = mc_cull.cull_out_key(&c, k)
            var q: usize = 0
            while q < nf {
                if rt.ld64(flist, q * 2) == key { found = true }
                q = q + 1
            }
            check(found, 32)
            k = k + 1
        }
        render_list(&r, &cam, &c, nb, hs, h2)
        check(same_hash(h1, h2), 33)
        // without the set-back rule: a superset of the first result, still the same image
        let nb2: usize = mc_cull.cull_run(&c, &cam, RAD + 1, false)
        check(nb2 >= nb && nb2 <= nf, 34)
        render_list(&r, &cam, &c, nb2, hs, h3)
        check(same_hash(h1, h3), 35)
        total_frustum = total_frustum + nf
        total_bfs = total_bfs + nb
        total_bfs_nosb = total_bfs_nosb + nb2
        if mode == 1 { tunnel_culled = tunnel_culled + (nf - nb) }
        // D: the all-closed graph keeps (almost) only the camera section
        let nz: usize = mc_cull.cull_run(&cbad, &cam, RAD + 1, true)
        render_list(&r, &cam, &cbad, nz, hs, h3)
        if !same_hash(h1, h3) { bad_diff = bad_diff + 1 }
        rt.heap_free(flist, nf * 16 + 16)
        pose = pose + 1
    }
    check(total_bfs < total_frustum, 36)
    check(tunnel_culled > 0, 37)
    check(bad_diff > 0, 38)
    mc_cull.cull_free(&c)
    mc_cull.cull_free(&cbad)
    return 0
}
