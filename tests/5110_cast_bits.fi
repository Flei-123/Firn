// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import std.rt
import cast.bits
import cast.nal

fn main() -> i32 {
    var w: bits.BitW = bits.bw_new()
    bits.bw_ue(&w, 0 as u32)
    bits.bw_ue(&w, 1 as u32)
    bits.bw_ue(&w, 2 as u32)
    bits.bw_ue(&w, 7 as u32)
    bits.bw_ue(&w, 1000 as u32)
    bits.bw_se(&w, 0)
    bits.bw_se(&w, 1)
    bits.bw_se(&w, -1)
    bits.bw_se(&w, 300)
    bits.bw_se(&w, -300)
    bits.bw_bits(&w, 5 as u32, 3)
    bits.bw_trailing(&w)
    var r: bits.BitR = bits.br_new(bits.bw_data(&w), bits.bw_len(&w))
    if bits.br_ue(&r) != 0 as u32 { return 1 }
    if bits.br_ue(&r) != 1 as u32 { return 2 }
    if bits.br_ue(&r) != 2 as u32 { return 3 }
    if bits.br_ue(&r) != 7 as u32 { return 4 }
    if bits.br_ue(&r) != 1000 as u32 { return 5 }
    if bits.br_se(&r) != 0 { return 6 }
    if bits.br_se(&r) != 1 { return 7 }
    if bits.br_se(&r) != -1 { return 8 }
    if bits.br_se(&r) != 300 { return 9 }
    if bits.br_se(&r) != -300 { return 10 }
    if bits.br_more_data(&r) == false { return 11 }
    if bits.br_bits(&r, 3) != 5 as u32 { return 12 }
    if bits.br_more_data(&r) { return 13 }
    if r.err { return 14 }
    bits.bw_free(&w)

    var raw: rt.Buf = rt.buf_new()
    rt.buf_push(&raw, 0 as u8)
    rt.buf_push(&raw, 0 as u8)
    rt.buf_push(&raw, 1 as u8)
    rt.buf_push(&raw, 0 as u8)
    rt.buf_push(&raw, 0 as u8)
    rt.buf_push(&raw, 3 as u8)
    rt.buf_push(&raw, 0 as u8)
    rt.buf_push(&raw, 0 as u8)
    rt.buf_push(&raw, 0 as u8)
    rt.buf_push(&raw, 128 as u8)
    var annexb: rt.Buf = rt.buf_new()
    nal.nal_write(&annexb, 3 as u32, 5 as u32, raw.ptr, raw.len)
    nal.nal_write(&annexb, 0 as u32, 1 as u32, raw.ptr, 3)
    var it: nal.NalIter = nal.nal_iter_new(annexb.ptr, annexb.len)
    var off: usize = 0
    var len: usize = 0
    if !nal.nal_iter_next(&it, &off, &len) { return 20 }
    if nal.nal_type(rt.ld8(annexb.ptr, off)) != 5 as u32 { return 21 }
    if nal.nal_ref_idc(rt.ld8(annexb.ptr, off)) != 3 as u32 { return 22 }
    var un: rt.Buf = rt.buf_new()
    nal.nal_unescape(annexb.ptr + off as u64 + 1, len - 1, &un)
    if un.len != raw.len { return 23 }
    if !rt.mem_eq(un.ptr, raw.ptr, raw.len) { return 24 }
    if !nal.nal_iter_next(&it, &off, &len) { return 25 }
    if nal.nal_type(rt.ld8(annexb.ptr, off)) != 1 as u32 { return 26 }
    if nal.nal_iter_next(&it, &off, &len) { return 27 }
    rt.buf_free(&raw)
    rt.buf_free(&annexb)
    rt.buf_free(&un)
    return 0
}
