// expect_exit: 0
fn main() -> i32 {
    var list: Vec[i32] = Vec[i32].new()
    list.Add(1)
    list.Add(2)
    list.Push(3)
    let x: i32 = 42
    let text = x.ToString()
    var bad: i32 = 0
    if text.length() != 2 { bad = bad + 1 }
    if list.Count != 3 { bad = bad + 1 }
    let words = "  a b c  ".Trim().Split(" ")
    if words.Count != 3 { bad = bad + 1 }
    if "abc".ToUpper().length() != 3 { bad = bad + 1 }
    if !"hello".StartsWith("he") { bad = bad + 1 }
    if "hello".Length != 5 { bad = bad + 1 }
    let popped = list.Pop()
    if popped != 3 { bad = bad + 1 }
    Println(f"{x.ToString()} {list.Count}")
    Print("done\n")
    let line = ReadLine()
    if line.Length != 0 { bad = bad + 1 }
    Sleep(1)
    if Millis() < 0 { bad = bad + 1 }
    if 9.0.Sqrt() != 3.0 { bad = bad + 1 }
    list.Clear()
    if list.Count != 0 { bad = bad + 1 }
    if bad != 0 { Println(f"failures: {bad}") }
    return bad
}
