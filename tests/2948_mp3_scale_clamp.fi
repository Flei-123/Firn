// expect_out: ok
// MP3 synthesis output scaling: the vector version `scale_pcm4c` (clamp
// BEFORE the conversion) must give exactly what the scalar `scale_pcm`
// gives: rounding, negative correction, both limits, huge values (NaN differs in the scalar version: undefined).
// The values come from `start`-dependent arithmetic so nothing folds away.
import std.io
import ton.mp3

fn lane_ok(x: f32, what: str) -> bool {
    var out: [i32; 4] = [0; 4]
    var inp: [f32; 4] = [x, x, x, x]
    let v: v128 = __v128_load((&inp[0]) as *u8)
    __v128_store((&out[0]) as *mut u8, mp3.scale_pcm4c(v))
    let want: i32 = mp3.scale_pcm(x) as i32
    if out[0] != want || out[3] != want {
        io.print("WRONG ")
        io.print(what)
        io.new_line()
        return false
    }
    return true
}

fn main(start: u64) -> i32 {
    var ok: bool = true
    var k: f32 = 1.0f
    if start == 7777777 {
        k = 3.0f
    }
    let zero: f32 = k - k
    ok = lane_ok(32766.5f * k, "upper limit") && ok
    ok = lane_ok(32766.4f * k, "just below upper") && ok
    ok = lane_ok(-32767.5f * k, "lower limit") && ok
    ok = lane_ok(-32767.4f * k, "just above lower") && ok
    ok = lane_ok(1.0e30f * k, "huge") && ok
    ok = lane_ok(-1.0e30f * k, "huge negative") && ok
    ok = lane_ok(zero, "zero") && ok
    ok = lane_ok(0.5f * k, "half") && ok
    ok = lane_ok(-0.5f * k, "minus half") && ok
    ok = lane_ok(-0.7f * k, "minus 0.7") && ok
    ok = lane_ok(-1.2f * k, "minus 1.2") && ok
    ok = lane_ok(-1.5f * k, "minus 1.5") && ok
    var i: i32 = -20000
    while i < 20000 {
        ok = lane_ok((i as f32) * 2.37f * k, "sweep") && ok
        i = i + 7
    }
    if ok {
        io.print("ok")
        io.new_line()
        return 0
    }
    return 1
}
