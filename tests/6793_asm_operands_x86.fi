// expect_exit: 0
// only_target: x86_64
import std.rt

fn main() -> i32 {
    let buf: u64 = rt.heap_alloc(64)
    var sum: u64 = 0
    var hi: u64 = 0
    var lo: u64 = 0
    var swapped: u64 = 0
    unsafe {
        sum = asm("add rax, rcx", out("rax"), in("rax") 40 as u64, in("rcx") 2 as u64)
        asm("mul rcx", out("rax") & lo, out("rdx") & hi, in("rax") (1 as u64) << (63 as u64), in("rcx") 4 as u64)
        swapped = asm("bswap rax", out("rax"), in("rax") 0x0102030405060708 as u64)
        asm("mov qword ptr [rcx], rax", in("rax") 77 as u64, in("rcx") buf, clobber("memory"))
    }
    if sum != 42 { return 1 }
    if lo != 0 { return 2 }
    if hi != 2 { return 3 }
    if swapped != 0x0807060504030201 as u64 { return 4 }
    var stored: u64 = 0
    unsafe {
        stored = *(buf as *mut u64)
    }
    if stored != 77 { return 5 }
    return 0
}
