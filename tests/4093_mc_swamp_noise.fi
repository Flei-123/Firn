// expect_exit: 0
// tests/4093_mc_swamp_noise.fi -- r252 swamp grass colour: Biome.BIOME_INFO_NOISE (PerlinSimplexNoise over LegacyRandomSource(2345), one octave)
// against the real 1.20.1 class (dwj, tools/mc/biomezoom/Ref.java): single values, a 40 x 40 grid sum + count and the two colours.
import std.rt
import std.core
import mc.mc_biome_zoom

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d < 0.000000000001
}

fn main() -> i32 {
    var sn: mc_biome_zoom.SwampNoise = mc_biome_zoom.swamp_new()
    {
        var tot: f64 = 0.0
        var cnt: i32 = 0
        var gx: i32 = 0 - 200
        while gx < 200 {
            var gz: i32 = 0 - 200
            while gz < 200 {
                let v: f64 = mc_biome_zoom.swamp_value(&sn, gx as f64 * 0.0225, gz as f64 * 0.0225)
                tot = tot + v
                if v < 0.0 - 0.1 {
                    cnt = cnt + 1
                }
                gz = gz + 10
            }
            gx = gx + 10
        }
        check(near(tot, (0.0 - 10.517417706341053)), 1)
        check(cnt == 711, 2)
    }
    check(near(mc_biome_zoom.swamp_value(&sn, 0 as f64 * 0.0225, 0 as f64 * 0.0225), 0.0), 3)
    check(mc_biome_zoom.swamp_grass(&sn, 0, 0) == 6975545 as u32, 4)
    check(near(mc_biome_zoom.swamp_value(&sn, 1 as f64 * 0.0225, 0 as f64 * 0.0225), 0.09803943319931264), 5)
    check(mc_biome_zoom.swamp_grass(&sn, 1, 0) == 6975545 as u32, 6)
    check(near(mc_biome_zoom.swamp_value(&sn, 10 as f64 * 0.0225, 10 as f64 * 0.0225), 0.29919258323823444), 7)
    check(mc_biome_zoom.swamp_grass(&sn, 10, 10) == 6975545 as u32, 8)
    check(near(mc_biome_zoom.swamp_value(&sn, (0 - 37) as f64 * 0.0225, 52 as f64 * 0.0225), 0.45862691580953674), 9)
    check(mc_biome_zoom.swamp_grass(&sn, (0 - 37), 52) == 6975545 as u32, 10)
    check(near(mc_biome_zoom.swamp_value(&sn, 100 as f64 * 0.0225, (0 - 200) as f64 * 0.0225), 0.3227495974985246), 11)
    check(mc_biome_zoom.swamp_grass(&sn, 100, (0 - 200)) == 6975545 as u32, 12)
    check(near(mc_biome_zoom.swamp_value(&sn, 1234 as f64 * 0.0225, (0 - 5678) as f64 * 0.0225), 0.1718863877991026), 13)
    check(mc_biome_zoom.swamp_grass(&sn, 1234, (0 - 5678)) == 6975545 as u32, 14)
    check(near(mc_biome_zoom.swamp_value(&sn, (0 - 300) as f64 * 0.0225, (0 - 300) as f64 * 0.0225), (0.0 - 0.4225637055381161)), 15)
    check(mc_biome_zoom.swamp_grass(&sn, (0 - 300), (0 - 300)) == 5011004 as u32, 16)
    check(near(mc_biome_zoom.swamp_value(&sn, 7 as f64 * 0.0225, 3 as f64 * 0.0225), 0.540304750585961), 17)
    check(mc_biome_zoom.swamp_grass(&sn, 7, 3) == 6975545 as u32, 18)
    check(near(mc_biome_zoom.swamp_value(&sn, 64 as f64 * 0.0225, 64 as f64 * 0.0225), (0.0 - 0.4989446630832695)), 19)
    check(mc_biome_zoom.swamp_grass(&sn, 64, 64) == 5011004 as u32, 20)
    check(near(mc_biome_zoom.swamp_value(&sn, (0 - 1) as f64 * 0.0225, (0 - 1) as f64 * 0.0225), (0.0 - 0.09764257491368801)), 21)
    check(mc_biome_zoom.swamp_grass(&sn, (0 - 1), (0 - 1)) == 6975545 as u32, 22)
    check(near(mc_biome_zoom.swamp_value(&sn, 500 as f64 * 0.0225, 500 as f64 * 0.0225), 0.18478908938828434), 23)
    check(mc_biome_zoom.swamp_grass(&sn, 500, 500) == 6975545 as u32, 24)
    check(near(mc_biome_zoom.swamp_value(&sn, (0 - 1000) as f64 * 0.0225, 777 as f64 * 0.0225), 0.5660119310994022), 25)
    check(mc_biome_zoom.swamp_grass(&sn, (0 - 1000), 777) == 6975545 as u32, 26)
    return 0
}
