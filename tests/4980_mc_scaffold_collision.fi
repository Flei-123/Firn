// expect_exit: 0
// tests/4980_mc_scaffold_collision.fi -- scaffolding collision like vanilla ScaffoldingBlock.getCollisionShape: solid only when the feet are above the block
// and the player is not sneaking, else empty (walk through, climb with Space, sink with Sneak); sagging scaffolding keeps a 2/16 bottom slab.
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_input
import mc.mc_move_fluid
import mc.mc_scaffold

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000000001
}

fn near2(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0005
}

fn put(ids: u64, x: i32, ly: i32, z: i32, id: u16) {
    rt.st16(ids, ((ly * 16 + z) * 16 + x) as usize, id)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

fn publish(w: *mut mc_world.World, ids: u64) {
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

fn fill(ids: u64, x0: i32, x1: i32, ly0: i32, ly1: i32, z0: i32, z1: i32, id: u16) {
    var ly: i32 = ly0
    while ly <= ly1 {
        var z: i32 = z0
        while z <= z1 {
            var x: i32 = x0
            while x <= x1 {
                put(ids, x, ly, z, id)
                x = x + 1
            }
            z = z + 1
        }
        ly = ly + 1
    }
}

fn tick(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32) {
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = keys
    mc_input.player_tick(p, &ev, w, tb, 0 - 64)
}

fn walk(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) {
    var t: i32 = 0
    while t < ticks {
        tick(p, w, tb, keys)
        t = t + 1
    }
}

const STONE: u16 = 1 as u16
const SCAF: u16 = 5 as u16
const SAG: u16 = 6 as u16

fn base_ids() -> u64 {
    let ids: u64 = new_ids()
    fill(ids, 0, 15, 0, 2, 0, 15, STONE)
    return ids
}

fn new_player(x: f64, y: f64, z: f64) -> mc_input.Player {
    var p: mc_input.Player = mc_input.player_new(x, y, z)
    rt.st8(p.mv, SCAF as usize, mc_move_fluid.MV_SCAFFOLD as u8)
    rt.st8(p.mv, SAG as usize, mc_move_fluid.MV_SCAFFOLD as u8)
    return p
}

fn main() -> i32 {
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(8), solid: rt.heap_alloc(16), n: 8 }
    var i: usize = 0
    while i < 8 {
        rt.st8(tb.pick, i, 1 as u8)
        rt.st16(tb.solid, i, 0 as u16)
        i = i + 1
    }
    rt.st16(tb.solid, STONE as usize, 1 as u16)
    rt.st16(tb.solid, SCAF as usize, mc_scaffold.CODE_STABLE as u16)
    rt.st16(tb.solid, SAG as usize, mc_scaffold.CODE_SAGGING as u16)

    let ids: u64 = base_ids()
    fill(ids, 8, 8, 3, 6, 8, 8, SCAF)
    fill(ids, 3, 3, 5, 5, 3, 3, SAG)
    var w: mc_world.World = mc_world.world_new()
    publish(&w, ids)

    var a: mc_input.Player = new_player(8.5, 0.0 - 55.0, 8.5)
    walk(&a, &w, &tb, 0 as u32, 40)
    check(a.on_ground, 1)
    check(near2(a.y, 0.0 - 57.0), 2)

    walk(&a, &w, &tb, mc_input.K_SNEAK, 3)
    check(a.y < 0.0 - 57.1, 3)
    walk(&a, &w, &tb, mc_input.K_SNEAK, 60)
    check(a.on_ground, 4)
    check(near2(a.y, 0.0 - 61.0), 5)

    var c: mc_input.Player = new_player(8.5, 0.0 - 61.0, 8.5)
    walk(&c, &w, &tb, 0 as u32, 3)
    walk(&c, &w, &tb, mc_input.K_JUMP, 60)
    check(c.y > 0.0 - 57.5, 15)
    walk(&c, &w, &tb, 0 as u32, 40)
    check(c.on_ground, 6)
    check(near2(c.y, 0.0 - 57.0), 7)

    var d: mc_input.Player = new_player(8.5, 0.0 - 60.0, 6.0)
    walk(&d, &w, &tb, mc_input.K_FORWARD, 30)
    check(d.z > 9.8, 8)
    check(near2(d.y, 0.0 - 61.0), 9)

    var e: mc_input.Player = new_player(8.5, 0.0 - 60.0, 6.0)
    var e_hit: i32 = 0
    var t: i32 = 0
    while t < 30 {
        walk(&e, &w, &tb, mc_input.K_FORWARD, 1)
        if e.z > 8.1 && e.z < 8.9 { e_hit = e_hit + 1 }
        t = t + 1
    }
    check(e_hit > 3, 10)

    var s: mc_input.Player = new_player(3.5, 0.0 - 57.0, 3.5)
    walk(&s, &w, &tb, 0 as u32, 30)
    check(s.on_ground, 11)
    check(near2(s.y, 0.0 - 58.0), 12)
    walk(&s, &w, &tb, mc_input.K_SNEAK, 40)
    check(s.on_ground, 13)
    check(near2(s.y, 0.0 - 59.0 + 0.125), 14)

    mc_world.world_free(&w)
    if g_fail != 0 { return 1 }
    return 0
}
