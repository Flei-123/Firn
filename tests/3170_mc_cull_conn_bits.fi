// expect_exit: 0
// tests/3170_mc_cull_conn_bits.fi -- r186: the bit parallel mc_cull.cull_conn equals the cell by cell reference
// (cull_conn_ref) on random and structured sections: random density, holey walls, winding tunnels, slabs, noise rooms,
// translucent / unknown ids. The result must also cover many different connectivity words (the test is not vacuous).
import std.rt
import mc.mc_cull

static mut g_seed: u64 = 0x9E3779B97F4A7C15

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn rnd() -> u64 {
    var x: u64 = g_seed
    x = x ^ (x << 13 as u64)
    x = x ^ (x >> 7 as u64)
    x = x ^ (x << 17 as u64)
    g_seed = x
    return x
}

fn rnd_n(n: u64) -> u64 {
    return (rnd() >> 11 as u64) % n
}

fn pad_fill(p: u64, id: u16) {
    var i: usize = 0
    while i < 5832 {
        rt.st16(p, i, id)
        i = i + 1
    }
}

fn set_cell(p: u64, x: usize, y: usize, z: usize, id: u16) {
    rt.st16(p, ((y + 1) * 18 + (z + 1)) * 18 + x + 1, id)
}

fn pick_id(solid: bool) -> u16 {
    if solid {
        let k: u64 = rnd_n(8)
        if k == 0 as u64 { return 3 as u16 }
        return 1 as u16
    }
    let k: u64 = rnd_n(10)
    if k == 0 as u64 { return 2 as u16 }
    if k == 1 as u64 { return 40000 as u16 }
    return 0 as u16
}

// kind 0: random density; 1: holey walls (planes with random holes); 2: random walk tunnels in solid;
// 3: slabs; 4: noise rooms (solid with random cubes cleared)
fn build(p: u64, kind: usize) {
    if kind == 0 {
        let dens: u64 = 3 + rnd_n(95)
        var i: usize = 0
        while i < 4096 {
            let x: usize = i & 15
            let z: usize = (i >> 4) & 15
            let y: usize = i >> 8
            set_cell(p, x, y, z, pick_id(rnd_n(100) < dens))
            i = i + 1
        }
    } else if kind == 1 {
        pad_fill(p, 0 as u16)
        let nw: u64 = 1 + rnd_n(5)
        var w: u64 = 0 as u64
        while w < nw {
            let axis: u64 = rnd_n(3)
            let pos: usize = rnd_n(16) as usize
            let hole: u64 = 1 + rnd_n(30)
            var a: usize = 0
            while a < 16 {
                var b: usize = 0
                while b < 16 {
                    if rnd_n(100) >= hole {
                        if axis == 0 as u64 { set_cell(p, pos, a, b, 1 as u16) }
                        else if axis == 1 as u64 { set_cell(p, a, pos, b, 1 as u16) }
                        else { set_cell(p, a, b, pos, 1 as u16) }
                    }
                    b = b + 1
                }
                a = a + 1
            }
            w = w + 1
        }
    } else if kind == 2 {
        pad_fill(p, 1 as u16)
        let nt: u64 = 1 + rnd_n(6)
        var t: u64 = 0 as u64
        while t < nt {
            var x: usize = rnd_n(16) as usize
            var y: usize = rnd_n(16) as usize
            var z: usize = rnd_n(16) as usize
            var steps: u64 = 20 + rnd_n(200)
            while steps > 0 as u64 {
                set_cell(p, x, y, z, 0 as u16)
                let d: u64 = rnd_n(6)
                if d == 0 as u64 && x > 0 { x = x - 1 }
                if d == 1 as u64 && x < 15 { x = x + 1 }
                if d == 2 as u64 && y > 0 { y = y - 1 }
                if d == 3 as u64 && y < 15 { y = y + 1 }
                if d == 4 as u64 && z > 0 { z = z - 1 }
                if d == 5 as u64 && z < 15 { z = z + 1 }
                steps = steps - 1 as u64
            }
            t = t + 1 as u64
        }
    } else if kind == 3 {
        pad_fill(p, 0 as u16)
        var y: usize = 1
        while y < 16 {
            if rnd_n(3) == 0 as u64 {
                var z: usize = 0
                while z < 16 {
                    var x: usize = 0
                    while x < 16 {
                        if rnd_n(100) >= 4 { set_cell(p, x, y, z, 1 as u16) }
                        x = x + 1
                    }
                    z = z + 1
                }
            }
            y = y + 2
        }
    } else {
        pad_fill(p, 1 as u16)
        let nr: u64 = 1 + rnd_n(12)
        var r: u64 = 0 as u64
        while r < nr {
            let x0: usize = rnd_n(14) as usize
            let y0: usize = rnd_n(14) as usize
            let z0: usize = rnd_n(14) as usize
            let sx: usize = 1 + rnd_n(6) as usize
            let sy: usize = 1 + rnd_n(6) as usize
            let sz: usize = 1 + rnd_n(6) as usize
            var y: usize = y0
            while y < y0 + sy && y < 16 {
                var z: usize = z0
                while z < z0 + sz && z < 16 {
                    var x: usize = x0
                    while x < x0 + sx && x < 16 {
                        set_cell(p, x, y, z, 0 as u16)
                        x = x + 1
                    }
                    z = z + 1
                }
                y = y + 1
            }
            r = r + 1 as u64
        }
    }
}

fn main() -> i32 {
    let opaque: u64 = rt.heap_alloc(64)
    var i: usize = 0
    while i < 64 {
        rt.st8(opaque, i, 0 as u8)
        i = i + 1
    }
    rt.st8(opaque, 1, 1 as u8) // solid
    rt.st8(opaque, 2, 2 as u8) // translucent: does not block
    rt.st8(opaque, 3, 3 as u8) // solid + translucent flag: bit 0 set = blocks
    let scr: u64 = rt.heap_alloc(12288)
    let scr2: u64 = rt.heap_alloc(12288)
    let p: u64 = rt.heap_alloc(5832 * 2)
    // stale scratch content must not matter
    i = 0
    while i < 12288 {
        rt.st8(scr, i, 0xA5 as u8)
        i = i + 1
    }
    let seen: u64 = rt.heap_alloc(4096)
    i = 0
    while i < 4096 {
        rt.st8(seen, i, 0 as u8)
        i = i + 1
    }
    var distinct: i32 = 0
    var n: i32 = 0
    while n < 3000 {
        let kind: usize = (n % 5) as usize
        build(p, kind)
        let a: u32 = mc_cull.cull_conn(p, opaque, scr)
        let b: u32 = mc_cull.cull_conn_ref(p, opaque, scr2)
        if a != b { check(false, 10 + (kind as i32)) }
        let key: usize = (a as usize) & 4095
        if rt.ld8(seen, key) == 0 as u8 {
            rt.st8(seen, key, 1 as u8)
            distinct = distinct + 1
        }
        n = n + 1
    }
    // hand made extremes
    pad_fill(p, 0 as u16)
    check(mc_cull.cull_conn(p, opaque, scr) == mc_cull.CONN_ALL, 20)
    pad_fill(p, 1 as u16)
    check(mc_cull.cull_conn(p, opaque, scr) == 0 as u32, 21)
    pad_fill(p, 40000 as u16)
    check(mc_cull.cull_conn(p, opaque, scr) == mc_cull.CONN_ALL, 22)
    check(distinct >= 12, 30)
    return 0
}
