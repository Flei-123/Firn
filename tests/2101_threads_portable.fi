// expect_exit: 0
// tests/2101_threads_portable.fi -- threads, the SAME program on Linux and on
// Windows (under Wine / on a real machine).
//
// A  FILES FROM SEVERAL THREADS AT ONCE. Eight threads create, read back,
//    stat, rename and remove files of their own in a directory of their own, 60
//    rounds each. On Windows every one of those calls goes through the shared
//    scratch pages of the system seam (compiler/src/win_seam.rs); a thread
//    that overwrote another's path buffer shows up as a wrong content, a
//    wrong size or a missing file.
// B  A THREAD'S STACK is the one the system gave it: a recursion of 1200
//    frames (up to 700 KiB unoptimised) on a 1 MiB stack, while two other threads allocate
//    and force collections -- the collector has to scan this deep stack from
//    the right bottom (Windows: the TEB's StackBase, not the block the
//    creator mapped).
// C  `thread_stack_set` is honoured: 256 KiB threads run a recursion of 300
//    frames.
// D  THE LOCK AND THE ATOMICS: four threads count to 30000 each under
//    `thread_lock` and, in a second counter, with the atomic add. The sums are
//    exact.
// E  THE FUTEX: a channel of capacity 3 carries 5000 values from two
//    producers to two consumers, nothing lost, nothing twice (every send and
//    every receive blocks on the futex now and then).
// F  JOIN: 40 threads are started and joined in waves of 8; each returns its
//    own number; the thread table is reused.
import std.rt
import std.str
import std.fs

gc class Cell {
    next: Gc[Cell],
    value: u64,
}

const F_SYS_MMAP: i64 = 9
const F_PROT_RW: i64 = 3
const F_MAP_ANON: i64 = 34

fn page() -> u64 {
    let r: i64 = syscall(F_SYS_MMAP, 0, 65536, F_PROT_RW, F_MAP_ANON, -1, 0)
    if r < 0 {
        return 0
    }
    return r as u64
}

fn ld(a: u64, o: u64) -> u64 {
    return *((a + o) as *mut u64)
}

fn st(a: u64, o: u64, v: u64) {
    *((a + o) as *mut u64) = v
}

// shared block (word offsets in octets)
const Z_BASE: u64 = 0 // the base directory pointer (a str kept as p/n)
const Z_BASE_N: u64 = 8
const Z_FILEBAD: u64 = 16 // total count of file mismatches
const Z_MUTEX: u64 = 24
const Z_LOCKED: u64 = 32 // counter under the lock
const Z_ATOMIC: u64 = 40 // counter by atomic add
const Z_CHAN: u64 = 48
const Z_SUM_IN: u64 = 56 // sum of what was sent (atomic)
const Z_SUM_OUT: u64 = 64 // sum of what was received (atomic)
const Z_GOT: u64 = 72 // values received (atomic)
const Z_DEEP_BAD: u64 = 80
const Z_STOP: u64 = 88

const MINUS1: u64 = 18446744073709551615

fn num_str(n: u64, out: *mut rt.Buf) {
    if n == 0 {
        rt.buf_push(out, 48 as u8)
        return
    }
    var digits: [u8; 24] = [0 as u8; 24]
    var k: usize = 0
    var v: u64 = n
    while v > 0 {
        digits[k] = (48 + v % 10) as u8
        v = v / 10
        k = k + 1
    }
    while k > 0 {
        k = k - 1
        rt.buf_push(out, digits[k])
    }
}

// <base>/t<id>_<name>
fn file_path(z: u64, id: u64, name: u64, out: *mut rt.Buf) {
    let base: str = str { p: ld(z, Z_BASE) as *mut u8, n: ld(z, Z_BASE_N) as usize }
    rt.buf_push_bytes(out, base.p as u64, base.length())
    rt.buf_push(out, 47 as u8)
    rt.buf_push(out, 116 as u8)
    num_str(id, out)
    rt.buf_push(out, 95 as u8)
    num_str(name, out)
    rt.buf_push(out, 0 as u8)
}

fn as_str(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: rt.buf_len(b) - 1 }
}

// --- A: one thread's file work ---------------------------------------
fn files_work(z: u64, id: u64) -> u64 {
    var bad: u64 = 0
    var round: u64 = 0
    var body: rt.Buf = rt.buf_new()
    var back: rt.Buf = rt.buf_new()
    var p1: rt.Buf = rt.buf_new()
    var p2: rt.Buf = rt.buf_new()
    while round < 60 {
        rt.buf_clear(&p1)
        file_path(z, id, round, &p1)
        rt.buf_clear(&p2)
        file_path(z, id, round + 1000, &p2)
        // content: 300 + round octets derived from (id, round)
        rt.buf_clear(&body)
        let len: u64 = 300 + round
        var i: u64 = 0
        while i < len {
            rt.buf_push(&body, ((id * 31 + round * 7 + i) % 251) as u8)
            i = i + 1
        }
        let w: usize = fs.write_file(as_str(&p1), rt.buf_ptr(&body), rt.buf_len(&body)) catch 0
        if w != rt.buf_len(&body) {
            bad = bad + 1
        } else {
            if !fs.exists(as_str(&p1)) {
                bad = bad + 1
            }
            rt.buf_clear(&back)
            let r: usize = fs.read_file(as_str(&p1), &back) catch 0
            if r != rt.buf_len(&body) {
                bad = bad + 1
            } else if rt.buf_len(&back) != rt.buf_len(&body) {
                bad = bad + 1
            } else if !rt.mem_eq(rt.buf_ptr(&back), rt.buf_ptr(&body), rt.buf_len(&body)) {
                bad = bad + 1
            }
            let rn: bool = fs.rename(as_str(&p1), as_str(&p2)) catch false
            if !rn {
                bad = bad + 1
            } else {
                if fs.exists(as_str(&p1)) || !fs.exists(as_str(&p2)) {
                    bad = bad + 1
                }
                let rm: bool = fs.remove(as_str(&p2)) catch false
                if !rm {
                    bad = bad + 1
                }
            }
        }
        round = round + 1
    }
    rt.buf_free(&body)
    rt.buf_free(&back)
    rt.buf_free(&p1)
    rt.buf_free(&p2)
    return bad
}

// --- B/C: recursion on a thread stack --------------------------------
fn deep(n: u64, acc: u64) -> u64 {
    var pad: [u64; 8] = [acc; 8]
    pad[3] = n
    if n == 0 {
        return acc + pad[3] + pad[0]
    }
    let r: u64 = deep(n - 1, acc + 1)
    return r + pad[3] - n
}

fn mk(i: u64, next: Gc[Cell]) -> AllocError!Gc[Cell] {
    let c: Gc[Cell] = try gc Cell { next: next, value: i }
    return c
}

// Allocates `rounds` cells, keeps every 50th in a chain (so some survive
// the collections the others cause) and returns sum + length of the chain.
// (The chain link is given to the constructor: a store of a Gc pointer into
// an existing cell, from two allocating threads, crashes on AArch64 under
// qemu -- tools/thread/a64_store_repro.fi, roadmap.)
fn alloc_work(rounds: u64) -> u64 {
    var head: Gc[Cell] = gc_null[Cell]()
    var sum: u64 = 0
    var i: u64 = 0
    while i < rounds {
        var nx: Gc[Cell] = gc_null[Cell]()
        if i % 50 == 0 {
            nx = head
        }
        let c: Gc[Cell] = mk(i, nx) catch gc_null[Cell]()
        if c == gc_null[Cell]() {
            return 0 - 1
        }
        if i % 50 == 0 {
            head = c
        }
        sum = sum + c.value
        i = i + 1
    }
    var p: Gc[Cell] = head
    var cnt: u64 = 0
    while p != gc_null[Cell]() {
        cnt = cnt + 1
        p = p.next
    }
    return sum + cnt
}

// --- the dispatcher ---------------------------------------------------
fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == 1 {
        // A: arg = shared block in the low 48 bits, the thread id above them
        return files_work(arg & 281474976710655, arg >> 48)
    }
    if kind == 2 {
        // B: deep recursion while others allocate; arg = depth
        var ok: u64 = 0
        var r: u64 = 0
        while r < 6 {
            if deep(arg, 0) == 2 * arg {
                ok = ok + 1
            }
            r = r + 1
        }
        return ok
    }
    if kind == 3 {
        // allocating partner of B
        return alloc_work(arg)
    }
    if kind == 4 {
        // D: arg = shared block
        var i: u64 = 0
        while i < 30000 {
            thread_lock((arg + Z_MUTEX) as *mut u64)
            st(arg, Z_LOCKED, ld(arg, Z_LOCKED) + 1)
            thread_unlock((arg + Z_MUTEX) as *mut u64)
            __atomic_add((arg + Z_ATOMIC) as *mut u64, 1)
            i = i + 1
        }
        return 1
    }
    if kind == 5 {
        // E: producer; arg = shared block; sends 1..2500
        var i: u64 = 1
        while i <= 2500 {
            thread_channel_send(ld(arg, Z_CHAN), i)
            __atomic_add((arg + Z_SUM_IN) as *mut u64, i)
            i = i + 1
        }
        return 1
    }
    if kind == 6 {
        // E: consumer; takes until it sees 0
        var n: u64 = 0
        while true {
            let v: u64 = thread_channel_receive(ld(arg, Z_CHAN))
            if v == 0 {
                break
            }
            __atomic_add((arg + Z_SUM_OUT) as *mut u64, v)
            __atomic_add((arg + Z_GOT) as *mut u64, 1)
            n = n + 1
        }
        return n
    }
    if kind == 7 {
        // F: returns its own number
        return arg * 3 + 1
    }
    return 0
}

fn main() -> i32 {
    let z: u64 = page()
    if z == 0 { return 1 as i32 }

    // ---------------------------------------------------------------- A
    var base: rt.Buf = rt.buf_new()
    let td: str = fs.temp_dir()
    rt.buf_push_bytes(&base, td.p as u64, td.length())
    let dirname: str = "firn_2101_threads"
    rt.buf_push(&base, 47 as u8)
    rt.buf_push_bytes(&base, dirname.p as u64, dirname.length())
    rt.buf_push(&base, 0 as u8)
    let bstr: str = str { p: rt.buf_data(&base), n: rt.buf_len(&base) - 1 }
    fs.remove_tree(bstr) catch false
    fs.mkdir(bstr) catch false
    if !fs.is_dir(bstr) { return 2 as i32 }
    st(z, Z_BASE, bstr.p as u64)
    st(z, Z_BASE_N, bstr.length() as u64)
    var hs: [u64; 8] = [0; 8]
    var k: u64 = 0
    while k < 8 {
        hs[k as usize] = thread_start(1, z | ((k + 1) << 48))
        if hs[k as usize] == 0 { return 3 as i32 }
        k = k + 1
    }
    var bad: u64 = 0
    k = 0
    while k < 8 {
        bad = bad + thread_wait(hs[k as usize])
        k = k + 1
    }
    if bad != 0 { return 4 as i32 }
    fs.remove_tree(bstr) catch false
    if fs.exists(bstr) { return 5 as i32 }

    // ---------------------------------------------------------------- B
    let hd: u64 = thread_start(2, 1200)
    let ha: u64 = thread_start(3, 60000)
    let hb: u64 = thread_start(3, 60000)
    let hd2: u64 = thread_start(2, 1200)
    if hd == 0 || ha == 0 || hb == 0 || hd2 == 0 { return 6 as i32 }
    var main_sum: u64 = alloc_work(30000)
    let ok1: u64 = thread_wait(hd)
    let ra: u64 = thread_wait(ha)
    let rb: u64 = thread_wait(hb)
    let ok2: u64 = thread_wait(hd2)
    if ok1 != 6 || ok2 != 6 { return 7 as i32 }
    // sum of 0..59999 + 1200 kept cells (every 50th); same for the main thread's 30000
    if ra != 1799970000 + 1200 || rb != 1799970000 + 1200 { return 8 as i32 }
    if main_sum != 449985000 + 600 { return 9 as i32 }
    if gc_collections() == 0 { return 10 as i32 }

    // ---------------------------------------------------------------- C
    thread_stack_set(262144)
    let hc: u64 = thread_start(2, 300)
    if hc == 0 { return 11 as i32 }
    if thread_wait(hc) != 6 { return 12 as i32 }
    thread_stack_set(1048576)

    // ---------------------------------------------------------------- D
    var hh: [u64; 4] = [0; 4]
    k = 0
    while k < 4 {
        hh[k as usize] = thread_start(4, z)
        if hh[k as usize] == 0 { return 13 as i32 }
        k = k + 1
    }
    k = 0
    while k < 4 {
        thread_wait(hh[k as usize])
        k = k + 1
    }
    if ld(z, Z_LOCKED) != 120000 { return 14 as i32 }
    if ld(z, Z_ATOMIC) != 120000 { return 15 as i32 }

    // ---------------------------------------------------------------- E
    st(z, Z_CHAN, thread_channel_new(3))
    if ld(z, Z_CHAN) == 0 { return 16 as i32 }
    let p1: u64 = thread_start(5, z)
    let p2: u64 = thread_start(5, z)
    let c1: u64 = thread_start(6, z)
    let c2: u64 = thread_start(6, z)
    if p1 == 0 || p2 == 0 || c1 == 0 || c2 == 0 { return 17 as i32 }
    thread_wait(p1)
    thread_wait(p2)
    thread_channel_send(ld(z, Z_CHAN), 0)
    thread_channel_send(ld(z, Z_CHAN), 0)
    let n1: u64 = thread_wait(c1)
    let n2: u64 = thread_wait(c2)
    if n1 + n2 != 5000 { return 18 as i32 }
    if ld(z, Z_GOT) != 5000 { return 19 as i32 }
    if ld(z, Z_SUM_IN) != 6252500 { return 20 as i32 }
    if ld(z, Z_SUM_OUT) != 6252500 { return 21 as i32 }
    thread_channel_free(ld(z, Z_CHAN))

    // ---------------------------------------------------------------- F
    var wave: u64 = 0
    var total: u64 = 0
    while wave < 5 {
        var hf: [u64; 8] = [0; 8]
        k = 0
        while k < 8 {
            hf[k as usize] = thread_start(7, wave * 8 + k)
            if hf[k as usize] == 0 { return 22 as i32 }
            k = k + 1
        }
        k = 0
        while k < 8 {
            let r: u64 = thread_wait(hf[k as usize])
            if r != (wave * 8 + k) * 3 + 1 { return 23 as i32 }
            total = total + r
            k = k + 1
        }
        wave = wave + 1
    }
    if total != 2380 { return 24 as i32 }
    if thread_count() != 1 { return 25 as i32 }
    return 0
}
