// expect_out: mc_vanilla ok
import std.rt
import std.io
import std.fs
import std.env
import zip.zip
import mc.mc_vanilla
import mc.mc_assets

fn add(w: *mut zip.ZipWriter, name: str, body: str) -> bool {
    let ok: bool = zip.zip_add(w, name, body.p as u64, body.length(), true) catch | e | (false)
    return ok
}

fn main() -> i32 {
    if !mc_vanilla.vanilla_keep_entry("assets/minecraft/textures/block/stone.png") { return 1 }
    if !mc_vanilla.vanilla_keep_entry("assets/minecraft/blockstates/oak_stairs.json") { return 2 }
    if !mc_vanilla.vanilla_keep_entry("assets/minecraft/models/block/cube.json") { return 3 }
    if !mc_vanilla.vanilla_keep_entry("assets/minecraft/textures/colormap/grass.png") { return 4 }
    if mc_vanilla.vanilla_keep_entry("assets/minecraft/textures/entity/creeper/creeper.png") { return 5 }
    if mc_vanilla.vanilla_keep_entry("net/minecraft/Foo.class") { return 6 }
    if mc_vanilla.vanilla_keep_entry("assets/minecraft/textures/block/") { return 7 }
    if mc_vanilla.vanilla_keep_entry("assets/minecraft/sounds.json") { return 8 }
    if mc_vanilla.vanilla_version_name(763) != "1.20.1" { return 9 }
    if mc_vanilla.vanilla_version_name(1) != "" { return 10 }

    var jar: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&jar)
    add(&w, "net/minecraft/Foo.class", "junk")
    add(&w, "assets/minecraft/textures/block/stone.png", "png-bytes")
    add(&w, "assets/minecraft/blockstates/stone.json", "{\"variants\":{\"\":{\"model\":\"block/stone\"}}}")
    add(&w, "assets/minecraft/models/block/stone.json", "{\"parent\":\"block/cube_all\"}")
    add(&w, "assets/minecraft/textures/entity/x.png", "no")
    zip.zip_finish(&w) catch 0
    zip.zip_writer_free(&w)

    let tmp: str = env.get("TMPDIR")
    var base: rt.Buf = rt.buf_new()
    if tmp.length() > 0 { rt.buf_push_bytes(&base, tmp.p as u64, tmp.length()) } else { rt.buf_push_bytes(&base, "/tmp".p as u64, 4) }
    let suffix: str = "/mc_vanilla_test_4400"
    rt.buf_push_bytes(&base, suffix.p as u64, suffix.length())
    fs.mkdir_all(rt.buf_str(&base)) catch false

    var jar_path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&jar_path, rt.buf_ptr(&base), rt.buf_len(&base))
    rt.buf_push_bytes(&jar_path, "/client.jar".p as u64, 11)
    fs.write_file(rt.buf_str(&jar_path), rt.buf_ptr(&jar), rt.buf_len(&jar)) catch 0

    var dest: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&dest, rt.buf_ptr(&base), rt.buf_len(&base))
    rt.buf_push_bytes(&dest, "/cache/out.zip".p as u64, 14)
    var kept: i32 = 0
    let rc: i32 = mc_vanilla.vanilla_build_cache(rt.buf_str(&jar_path), rt.buf_str(&dest), 15, &kept)
    var code: i32 = 0
    if rc != mc_vanilla.VANILLA_OK { code = 11 }
    if kept != 3 { code = 12 }
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    if code == 0 {
        if mc_assets.pack_open_file(&pk, rt.buf_str(&dest)) != mc_assets.ASSET_OK { code = 13 }
    }
    if code == 0 {
        if pk.format != 15 { code = 14 }
        mc_assets.pack_close(&pk)
    }
    var bad_kept: i32 = 0
    if code == 0 {
        let rc2: i32 = mc_vanilla.vanilla_build_cache(rt.buf_str(&base), rt.buf_str(&dest), 15, &bad_kept)
        if rc2 != mc_vanilla.VANILLA_BAD_JAR { code = 15 }
    }
    fs.remove_tree(rt.buf_str(&base)) catch false
    rt.buf_free(&jar)
    rt.buf_free(&jar_path)
    rt.buf_free(&dest)
    rt.buf_free(&base)
    if code != 0 {
        io.fmt_print(f"mc_vanilla FAIL code={code}\n")
        return code
    }
    io.fmt_print(f"mc_vanilla ok\n")
    return 0
}
