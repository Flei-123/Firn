// expect_exit: 0
// r563c: the root scan trims the all-zero tail of a root area (Vec buffer)
// before it scans. A pointer in ANY of the last words of a buffer, far behind
// `len`, must still keep its block alive. The only reference to each block is
// an interior pointer (base + 5) in a spare slot of a Vec[str] buffer; the
// base itself is stored xor-masked in a Vec[u64] (not a root).
import std.vec
import std.rt

const HIDE: u64 = 0x5a5a5a5a5a5a5a5a
const LANES: u64 = 12

fn make() -> str {
    return "item-" + "0123456789abcdef" + "-x"
}

// Same size class as `make`, so a freed block is reused by the churn.
fn churn(rounds: u32) -> u64 {
    var k: u32 = 0
    var sum: u64 = 0
    while k < rounds {
        let s: str = "junk!" + "0123456789abcdef" + "-y"
        sum = sum + s.n as u64
        k = k + 1
    }
    return sum
}

fn check(bases: *mut Vec[u64]) -> bool {
    var j: usize = 0
    while j < vec_len[u64](bases) {
        let base: u64 = vec_at[u64](bases, j) ^ HIDE
        if rt.ld8(base, 0) != 105 { return false }
        if rt.ld8(base, 1) != 116 { return false }
        if rt.ld8(base, 2) != 101 { return false }
        if rt.ld8(base, 3) != 109 { return false }
        if rt.ld8(base, 4) != 45 { return false }
        if rt.ld8(base, 22) != 120 { return false }
        j = j + 1
    }
    return true
}

// One pointer, `lane` words before the end of the buffer (word index from 1).
fn hide(v: *mut Vec[str], bases: *mut Vec[u64], lane: u64) -> bool {
    if !vec_reserve[str](v, 64) { return false }
    let s: str = make()
    let base: u64 = rt.ld64((&s) as u64, 0)
    let words: u64 = (vec_cap[str](v) as u64) * 2
    let at: usize = (words - lane) as usize
    rt.st64(vec_ptr[str](v), at, base + 5)
    return vec_push[u64](bases, base ^ HIDE)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var bases: Vec[u64] = vec_new[u64]()
    var vs: Vec[Vec[str]] = vec_new[Vec[str]]()
    var lane: u64 = 1
    while lane <= LANES {
        if !vec_push[Vec[str]](&vs, vec_new[str]()) { return 2 }
        lane = lane + 1
    }
    lane = 1
    while lane <= LANES {
        if !hide(vec_elem_ptr[Vec[str]](&vs, (lane - 1) as usize), &bases, lane) { return 2 }
        lane = lane + 1
    }
    var round: u32 = 0
    while round < 5 {
        if churn(60000) == 0 { return 3 }
        gc_collect()
        if !check(&bases) { return 4 }
        round = round + 1
    }
    return 0
}
