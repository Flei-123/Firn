// expect_exit: 0
// Gegenprobe zu tests/neg/err_verworfen.fi: ein '!T'-Wert, der gebunden oder
// weitergegeben wird, ist in Ordnung (SPEC §5.1, #[must_consume]).
error E { A }

fn quelle(n: i32) -> E!i32 {
    if n == 0 {
        return E::A
    }
    return n
}

fn durchreichen(n: i32) -> E!i32 {
    return quelle(n)
}

fn main() -> i32 {
    let gebunden = quelle(2)
    if (gebunden catch 0) != 2 {
        return 1
    }
    let weiter = durchreichen(3) catch 0
    if weiter != 3 {
        return 2
    }
    if (durchreichen(0) catch 0 - 1) != 0 - 1 {
        return 3
    }
    return 0
}
