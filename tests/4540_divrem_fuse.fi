// expect_exit: 0
// `a / c` next to `a % c` is fused (pass divrem): same results as separate
// operations for unsigned and signed types, negative values, small widths.
fn udm(x: u64) -> u64 {
    let q: u64 = x / 10
    let r: u64 = x % 10
    return q * 31 +% r
}

fn rem_first(x: u64) -> u64 {
    let r: u64 = x % 1000
    let q: u64 = x / 1000
    return q +% r * 7
}

fn sdm(x: i64) -> i64 {
    let q: i64 = x / 7
    let r: i64 = x % 7
    return q *% 13 +% r
}

fn sdm_neg(x: i64) -> i64 {
    let q: i64 = x / -3
    let r: i64 = x % -3
    return q *% 5 +% r
}

fn u32dm(x: u32) -> u32 {
    let q: u32 = x / 100
    let r: u32 = x % 100
    return q *% 3 +% r
}

fn u8dm(x: u8) -> u8 {
    let q: u8 = x / 10
    let r: u8 = x % 10
    return q *% 11 +% r
}

fn i32dm(x: i32) -> i32 {
    let q: i32 = x / 9
    let r: i32 = x % 9
    return q *% 17 +% r
}

// remainder alone (no matching division): must stay correct
fn lone(x: u64) -> u64 {
    return x % 12
}

fn main() -> i32 {
    var bad: i32 = 0
    var x: u64 = 0
    while x < 5000 {
        let a: u64 = x *% 7919
        if udm(a) != (a / 10) * 31 +% (a - (a / 10) * 10) {
            bad = bad + 1
        }
        if rem_first(a) != (a / 1000) +% (a - (a / 1000) * 1000) * 7 {
            bad = bad + 1
        }
        if lone(a) != a - (a / 12) * 12 {
            bad = bad + 1
        }
        x = x + 1
    }
    var s: i64 = -20000
    while s < 20000 {
        let q7: i64 = s / 7
        if sdm(s) != q7 *% 13 +% (s - q7 * 7) {
            bad = bad + 1
        }
        let q3: i64 = s / -3
        if sdm_neg(s) != q3 *% 5 +% (s - q3 * -3) {
            bad = bad + 1
        }
        s = s + 1
    }
    var m: i64 = 9223372036854775807
    if sdm(m) != (m / 7) *% 13 +% (m - (m / 7) * 7) {
        bad = bad + 1
    }
    m = -9223372036854775807 - 1
    if sdm(m) != (m / 7) *% 13 +% (m - (m / 7) * 7) {
        bad = bad + 1
    }
    var u: u32 = 0
    while u < 300000 {
        let a: u32 = u *% 14321
        let q: u32 = a / 100
        if u32dm(a) != q *% 3 +% (a - q * 100) {
            bad = bad + 1
        }
        u = u + 1
    }
    var b: u32 = 0
    while b < 256 {
        let v: u8 = b as u8
        let q: u8 = v / 10
        if u8dm(v) != q *% 11 +% (v - q * 10) {
            bad = bad + 1
        }
        b = b + 1
    }
    var k: i32 = -50000
    while k < 50000 {
        let q: i32 = k / 9
        if i32dm(k) != q *% 17 +% (k - q * 9) {
            bad = bad + 1
        }
        k = k + 1
    }
    return bad
}
