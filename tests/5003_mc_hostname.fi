// expect_exit: 0
import std.rt
import std.net
import mc.mc_hostname
import mc.mc_serverlist
import mc.mc_startscreen
import mc.mc_connect

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn valid(t: str) -> bool {
    return mc_hostname.host_valid(t.p as u64, t.n)
}

fn entry_is(l: *mut mc_serverlist.ServerList, i: i32, t: str) -> bool {
    if mc_serverlist.sl_len(l, i) != t.n { return false }
    var k: usize = 0
    while k < t.n {
        if rt.ld8(mc_serverlist.sl_ptr(l, i), k) != t.chars(k) { return false }
        k = k + 1
    }
    return true
}

fn type_text(f: *mut mc_startscreen.StartForm, t: str) {
    var i: usize = 0
    while i < t.n {
        mc_startscreen.form_char(f, t.chars(i) as u32)
        i = i + 1
    }
}

fn host_is(f: *mut mc_startscreen.StartForm, t: str) -> bool {
    if mc_startscreen.form_text_len(f, mc_startscreen.FIELD_HOST) != t.n { return false }
    var i: usize = 0
    while i < t.n {
        if rt.ld8(mc_startscreen.form_text_ptr(f, mc_startscreen.FIELD_HOST), i) != t.chars(i) { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    check(valid("play.example.com") && valid("localhost") && valid("a") && valid("my-server.example.org") && valid("MC.Example.COM"), 1)
    check(valid("10.0.0.1") && valid("192.168.1.20") && valid("255.255.255.255"), 2)
    check(!valid("") && !valid(".") && !valid("a..b") && !valid(".example.com") && !valid("-a.com") && !valid("a-.com") && !valid("a.-b.com"), 3)
    check(!valid("1.2.3") && !valid("300.1.1.1") && !valid("1.2.3.4.5") && !valid("1.2.3.4.") && !valid("01.2.3.4"), 4)
    check(!valid("exa mple.com") && !valid("a_b.com") && !valid("a:b") && !valid("[::1]") && !valid("café.com"), 5)
    check(valid("example.com.") == false, 6)
    check(valid("1.2.3.4.example.com") && valid("4chan.org"), 7)

    var l: mc_serverlist.ServerList = mc_serverlist.sl_new()
    check(mc_serverlist.sl_add(&l, "play.example.com".p as u64, 16, 25565), 8)
    check(mc_serverlist.sl_add(&l, "10.0.0.1".p as u64, 8, 25599), 9)
    check(mc_serverlist.sl_count(&l) == 2 && entry_is(&l, 0, "10.0.0.1:25599") && entry_is(&l, 1, "play.example.com:25565"), 10)
    check(mc_serverlist.sl_find(&l, "play.example.com".p as u64, 16, 25565) == 1, 11)
    var text: rt.Buf = rt.buf_new()
    mc_serverlist.sl_text(&l, &text)
    var back: mc_serverlist.ServerList = mc_serverlist.sl_new()
    mc_serverlist.sl_load(rt.buf_ptr(&text), rt.buf_len(&text), &back)
    check(mc_serverlist.sl_count(&back) == 2 && entry_is(&back, 1, "play.example.com:25565"), 12)
    let junk: str = "server=bad_name.com:25565\nserver=-x.com:25565\nserver=ok.example.net:25566\nserver=a..b:1\nserver=host:0\nserver=host:65536\nserver=[::1]:25565\nserver=host:12a\n"
    mc_serverlist.sl_load(junk.p as u64, junk.n, &back)
    check(mc_serverlist.sl_count(&back) == 1 && entry_is(&back, 0, "ok.example.net:25566"), 13)
    mc_serverlist.sl_free(&l)
    mc_serverlist.sl_free(&back)
    rt.buf_free(&text)

    var f: mc_startscreen.StartForm = mc_startscreen.form_new()
    type_text(&f, "Play.Example-1.com!_ :")
    check(host_is(&f, "Play.Example-1.com"), 14)
    f.active = mc_startscreen.FIELD_NAME
    type_text(&f, "Steve")
    check(mc_startscreen.form_validate(&f) == mc_startscreen.ERR_NONE, 15)
    var g: mc_startscreen.StartForm = mc_startscreen.form_new()
    type_text(&g, "abcdefghij.abcdefghij.abcdefghij.xyz")
    check(mc_startscreen.form_text_len(&g, mc_startscreen.FIELD_HOST) == mc_startscreen.HOST_MAX, 16)
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_HOST, "bad..name".p as u64, 9)
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_NAME, "A".p as u64, 1)
    check(mc_startscreen.form_validate(&g) == mc_startscreen.ERR_HOST, 17)
    mc_startscreen.form_free(&f)
    mc_startscreen.form_free(&g)

    var lst: net.Listener = net.listen_tcp(net.ipv4(127 as u8, 0 as u8, 0 as u8, 1 as u8), 0 as u16) catch net.listener_from_fd(0 - 1)
    check(net.listener_is_open(&lst) && net.listener_port(&lst) != 0 as u16, 18)
    let port: u16 = net.listener_port(&lst)
    var which: usize = 0
    var c1: net.Conn = mc_connect.connect_host("127.0.0.1".p as u64, 9, port, &which)
    check(net.conn_is_open(&c1), 19)
    net.close(&c1)
    var c2: net.Conn = mc_connect.connect_host("localhost".p as u64, 9, port, &which)
    check(net.conn_is_open(&c2), 20)
    net.close(&c2)
    var c3: net.Conn = mc_connect.connect_host("bad..name".p as u64, 9, port, &which)
    check(!net.conn_is_open(&c3), 21)
    var c4: net.Conn = mc_connect.connect_host("127.0.0.1".p as u64, 9, 0 as u16, &which)
    check(!net.conn_is_open(&c4), 22)
    net.close_listener(&lst)
    var c5: net.Conn = mc_connect.connect_host("127.0.0.1".p as u64, 9, port, &which)
    check(!net.conn_is_open(&c5), 23)
    return 0
}
