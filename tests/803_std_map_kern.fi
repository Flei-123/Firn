// expect_out: map: paare 51 summe 3675 plaetze 128 uebrig 2666 tot 0 typ2 2
// tests/803_std_map_kern.fi — Iteration und Entry-Helfer von `std.map`
// (Runde 42).
//
// Der Kern von `Map[K, V]` (offene Adressierung, Lastgrenze 3/4,
// Grabsteine) bleibt unveraendert. Neu ist, was man MIT der Tabelle macht:
//   * ueber alle Paare LAUFEN, ohne ein Feld zu bauen (`map_naechster`)
//   * "hol oder Vorgabe", "hol und sag ob da war", "nimm heraus"
//   * das Zaehl-Muster in EINEM Aufruf (`map_erhoehen`)
//   * Grabsteine wegraeumen (`map_aufraeumen`) — ohne das entartet eine
//     Tabelle, in die dauernd eingefuegt und geloescht wird
//
// Der Iterationsteil prueft die Summe, nicht die Reihenfolge: die haengt an
// der Streuung und ist ausdruecklich nicht zugesagt.
import std.io
import std.map

fn main() -> i32 {
    var m: Map[u64, u64] = map_neu[u64, u64]()
    if !map_ist_leer[u64, u64](&m) {
        return 10
    }
    var k: u64 = 0
    while k < 50 {
        map_setzen[u64, u64](&m, k, k * 3)
        k = k + 1
    }
    if map_len[u64, u64](&m) != 50 || map_ist_leer[u64, u64](&m) {
        return 11
    }

    // --- Kursor ueber alle belegten Plaetze
    var idx: usize = map_erstes[u64, u64](&m)
    var zahl: usize = 0
    var summe_s: u64 = 0
    var summe_w: u64 = 0
    while idx < map_kap[u64, u64](&m) {
        if !map_platz_belegt[u64, u64](&m, idx) {
            return 12
        }
        zahl = zahl + 1
        summe_s = summe_s + map_platz_schluessel[u64, u64](&m, idx)
        summe_w = summe_w + map_platz_wert[u64, u64](&m, idx)
        idx = map_naechster[u64, u64](&m, idx + 1)
    }
    if zahl != 50 {
        return 13
    }
    if summe_s != 1225 || summe_w != 3675 {
        return 14
    }

    // --- holen mit Vorgabe / mit Auskunft
    if map_hol_oder[u64, u64](&m, 999, 7) != 7 {
        return 20
    }
    if map_hol_oder[u64, u64](&m, 5, 7) != 15 {
        return 21
    }
    var out: u64 = 0
    if !map_hol_wenn[u64, u64](&m, 5, &out) || out != 15 {
        return 22
    }
    if map_hol_wenn[u64, u64](&m, 999, &out) {
        return 23
    }
    // Der Unterschied zu map_hol: dort ist 0 zweideutig.
    if map_hol[u64, u64](&m, 0) != 0 {
        return 24
    }
    if !map_hat[u64, u64](&m, 0) {
        return 25
    }

    // --- nur einfuegen, wenn neu
    var neu: bool = false
    if !map_setzen_wenn_neu[u64, u64](&m, 5, 999, &neu) {
        return 30
    }
    if neu || map_hol[u64, u64](&m, 5) != 15 {
        return 31
    }
    if !map_setzen_wenn_neu[u64, u64](&m, 500, 1, &neu) {
        return 32
    }
    if !neu || map_len[u64, u64](&m) != 51 {
        return 33
    }

    // --- Zaehl-Muster
    if map_erhoehen[u64, u64](&m, 500, 4) != 5 {
        return 40
    }
    if map_erhoehen[u64, u64](&m, 501, 9) != 9 {
        return 41
    }
    if map_hol[u64, u64](&m, 501) != 9 {
        return 42
    }

    // --- Wert an Ort und Stelle aendern
    let adr: u64 = map_wert_adresse[u64, u64](&m, 5)
    if adr == 0 {
        return 45
    }
    *(adr as *mut u64) = 77
    if map_hol[u64, u64](&m, 5) != 77 {
        return 46
    }
    if map_wert_adresse[u64, u64](&m, 12345) != 0 {
        return 47
    }

    // --- herausnehmen und aufraeumen
    if !map_nehmen[u64, u64](&m, 501, &out) || out != 9 {
        return 50
    }
    if map_nehmen[u64, u64](&m, 501, &out) {
        return 51
    }
    if map_tot[u64, u64](&m) != 1 {
        return 52
    }
    let vor_kap: usize = map_kap[u64, u64](&m)
    if !map_aufraeumen[u64, u64](&m) {
        return 53
    }
    if map_tot[u64, u64](&m) != 0 || map_kap[u64, u64](&m) != vor_kap {
        return 54
    }
    if map_len[u64, u64](&m) != 51 {
        return 55
    }
    if map_hol[u64, u64](&m, 5) != 77 {
        return 56
    }

    // --- viele Einfuegungen und Loeschungen: die Tabelle darf nicht
    //     entarten, und nach dem Aufraeumen muss jeder Rest noch da sein.
    var z: Map[u64, u64] = map_neu[u64, u64]()
    var r: u64 = 0
    while r < 4000 {
        map_setzen[u64, u64](&z, r, r)
        if (r % 3) == 0 {
            map_loeschen[u64, u64](&z, r)
        }
        r = r + 1
    }
    let uebrig: usize = map_len[u64, u64](&z)
    if uebrig != 2666 {
        return 60
    }
    map_aufraeumen[u64, u64](&z)
    if map_tot[u64, u64](&z) != 0 || map_len[u64, u64](&z) != uebrig {
        return 61
    }
    var i2: usize = map_erstes[u64, u64](&z)
    var pruef: u64 = 0
    while i2 < map_kap[u64, u64](&z) {
        if map_platz_schluessel[u64, u64](&z, i2) != map_platz_wert[u64, u64](&z, i2) {
            return 62
        }
        pruef = pruef + 1
        i2 = map_naechster[u64, u64](&z, i2 + 1)
    }
    if pruef as usize != uebrig {
        return 63
    }

    // --- andere Typen: Schluessel u32, Wert i32
    var t: Map[u32, i32] = map_neu[u32, i32]()
    map_setzen[u32, i32](&t, 7, 0 - 3)
    if map_hol_oder[u32, i32](&t, 7, 0) != 0 - 3 {
        return 70
    }
    if map_erhoehen[u32, i32](&t, 7, 5) != 2 {
        return 71
    }
    if map_erhoehen[u32, i32](&t, 8, 0 - 1) != 0 - 1 {
        return 72
    }
    if map_len[u32, i32](&t) != 2 {
        return 73
    }

    io.fmt_druck(f"map: paare {map_len[u64, u64](&m)} summe {summe_w} plaetze {vor_kap} ")
    io.fmt_druck(f"uebrig {uebrig} tot {map_tot[u64, u64](&z)} typ2 {map_hol[u32, i32](&t, 7)}\n")

    map_frei[u64, u64](&m)
    map_frei[u64, u64](&z)
    map_frei[u32, i32](&t)
    return 0
}
