// expect_exit: 0
import std.rt
import mc.mc_registry
import mc.mc_dig
import mc.mc_dig_progress
import mc.v763.mc_reg_v763
import mc.v763.mc_dig_v763

fn sim(r: *mut mc_registry.Registry, d: *mut mc_dig.DigData, air_ticks: i32, water_ticks: i32, stage_at_air_end: *mut i32) -> i32 {
    let b: i32 = mc_registry.reg_block_by_name(r, "stone".p as u64, "stone".n)
    let it: i32 = mc_registry.reg_item_by_name(r, "iron_pickaxe".p as u64, "iron_pickaxe".n)
    let hm: i32 = mc_registry.reg_block_hardness_milli(r, b)
    var p: mc_dig_progress.DigProgress = mc_dig_progress.dp_new()
    mc_dig_progress.dp_start(&p, 1000 as u64)
    var tick: i32 = 0
    while !mc_dig_progress.dp_done(&p) && tick < 400 {
        let now: u64 = 1000 as u64 + ((tick + 1) as u64) * mc_dig_progress.TICK_MS
        if mc_dig_progress.dp_owed(&p, now) != 1 { return 0 - 2 }
        let on_ground: bool = tick >= air_ticks
        let in_water: bool = tick < water_ticks
        mc_dig_progress.dp_tick(&p, mc_dig.dig_damage_fx(d, b, hm, it, 0, 0, 0, on_ground, in_water))
        tick = tick + 1
        if tick == air_ticks { *stage_at_air_end = mc_dig_progress.dp_stage(&p) }
    }
    return tick
}

fn main() -> i32 {
    var r: mc_registry.Registry = mc_reg_v763.registry_make()
    var d: mc_dig.DigData = mc_dig_v763.dig_make()
    if !mc_registry.registry_ok(&r) { return 10 }
    if !mc_dig.dig_ok(&d) { return 11 }
    var st: i32 = 0 - 1
    if sim(&r, &d, 0, 0, &st) != 8 { return 20 }
    if sim(&r, &d, 1000, 0, &st) != 38 { return 21 }
    if sim(&r, &d, 0, 1000, &st) != 38 { return 22 }
    if sim(&r, &d, 10, 0, &st) != 16 { return 23 }
    if st != 2 { return 24 }
    if sim(&r, &d, 4, 0, &st) != 11 { return 25 }
    if sim(&r, &d, 0, 0 - 1, &st) != 8 { return 26 }
    if sim(&r, &d, 30, 0, &st) != 32 { return 27 }
    if sim(&r, &d, 5, 3, &st) != 12 { return 28 }

    var p: mc_dig_progress.DigProgress = mc_dig_progress.dp_new()
    if mc_dig_progress.dp_stage(&p) != 0 - 1 { return 30 }
    if mc_dig_progress.dp_owed(&p, 5000 as u64) != 0 { return 31 }
    mc_dig_progress.dp_start(&p, 1000 as u64)
    if mc_dig_progress.dp_owed(&p, 1049 as u64) != 0 { return 32 }
    if mc_dig_progress.dp_owed(&p, 1050 as u64) != 1 { return 33 }
    if mc_dig_progress.dp_owed(&p, 1260 as u64) != 5 { return 34 }
    mc_dig_progress.dp_tick(&p, 0.35)
    if mc_dig_progress.dp_stage(&p) != 3 { return 35 }
    if mc_dig_progress.dp_owed(&p, 1260 as u64) != 4 { return 36 }
    mc_dig_progress.dp_tick(&p, 0.7)
    if !mc_dig_progress.dp_done(&p) { return 37 }
    if mc_dig_progress.dp_stage(&p) != 9 { return 38 }
    if mc_dig_progress.dp_fraction(&p) != 1.0 { return 39 }
    mc_dig_progress.dp_stop(&p)
    if mc_dig_progress.dp_done(&p) { return 40 }
    if mc_dig_progress.dp_stage(&p) != 0 - 1 { return 41 }
    return 0
}
