// expect_exit: 0
// tests/1137_thread_bool_phi_use.fi -- ROUND PHI: the SECOND shape of the
// thread-bool/inline miscompilation, found mechanically by fuzzing.
//
// WHAT THIS PINS DOWN. `threading::fork_at` takes a block that consists of
// exactly one `%d = load.bool %cell` and ends in `brcond %d, T, E`, and makes
// every predecessor jump PAST it into T and E. When that succeeds for all
// predecessors the block goes unreachable and the `load` that defines `%d`
// goes with it -- which is only safe while NOTHING ELSE names `%d`.
//
// `inline.rs` returns the value of a callee with several `ret`s through a
// slot, so the continuation block of an embedded call is exactly such a
// `load`, and the caller goes on to use that value again.
//
// WHY THIS IS NOT tests/1136. 1136 is the shape the JS engine hit: the
// second call is guarded by the result of the first being FALSE
// (`if !have { ... small(...) }`), and the two paths meet in a phi that
// merges `have` afterwards. Here the guard is the other way round --
//
//     var have = small0(a, b)
//     if have { if d != 0 { have = small0(d, b) } }
//
// -- the second call runs only when the first said TRUE, and the merge is
// the loop-free equivalent of an if/else chain rather than 1136's `||`.
// The same `load` is threaded past and the same register is read stale,
// but the block layout `fork_at` sees is a different one, so 1136 passing
// does not imply this passing.
//
// PROVENANCE. This is `.work/fuzz/g00010.fi` of round PHI's generator
// (tools/inline_bench/genbool.py, seed 10, shape 1), reduced by hand: two
// call sites of one three-`ret` callee, six assertions. With round INLINE's
// guard in `fork_at` removed it answers **exit 1** -- the very first
// assertion, `outer(8, 7, 0)`, comes back false when it must be true. (The
// unreduced generated program failed at its fourth assertion instead; which
// assertion goes first depends on the block layout, and that is the point:
// the register allocator hands out whatever the register happened to hold,
// so the symptom moves when the shape moves. What does not move is that it
// is WRONG.) With the guard it answers 0 at all four build levels and with
// a saturated inline budget.
//
// The generator found 236 of 600 programs miscompiling with the guard
// removed, in exactly two shapes: 19 of shape 0 (which is 1136) and 11 of
// shape 1 (which is this one), out of the first 30 examined.

fn small0(k: u64, cap: u64) -> bool {
    if cap < 1 {
        return false
    }
    if cap < 4 {
        return true
    }
    return k != cap
}

fn outer(a: u64, b: u64, d: u64) -> bool {
    var have: bool = small0(a, b)
    if have {
        if d != 0 {
            have = small0(d, b)
        }
    }
    return have
}

fn main() -> i32 {
    // small0(8,7): cap 7 >= 4 -> 8 != 7 -> true. d = 0, so `have` stays.
    // THIS is the assertion that fails (exit 1) when `fork_at` threads past
    // the embedded return.
    if !outer(8, 7, 0) {
        return 1
    }
    // small0(3,11) -> 3 != 11 -> true. d = 0.
    if !outer(3, 11, 0) {
        return 2
    }
    // small0(6,2): cap 2 < 4 -> true. d = 2 -> small0(2,2): cap < 4 -> true.
    if !outer(6, 2, 2) {
        return 3
    }
    // small0(6,6): cap 6 >= 4 -> 6 != 6 -> FALSE, so the guarded call is
    // never made and the answer must stay false.
    if outer(6, 6, 2) {
        return 4
    }
    // small0(7,2): cap < 4 -> true. d = 2 -> small0(2,2) -> true.
    if !outer(7, 2, 2) {
        return 5
    }
    // small0(10,5): 10 != 5 -> true. d = 3 -> small0(3,5): 3 != 5 -> true.
    if !outer(10, 5, 3) {
        return 6
    }
    return 0
}
