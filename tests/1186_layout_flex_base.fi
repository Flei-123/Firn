// expect_exit: 0
// tests/1186_layout_flex_base.fi -- the flex base size, and the flex
// container that has no definite main size.
//
// TWO TRAPS, both found by the WPT corpus of this round:
//
//  1. THE BASE SIZE OF A NESTED CONTAINER. #g is a column flex container
//     without a width; its flex base size in the row #f is its
//     MAX-CONTENT width -- and that is 70 plus the two margins of 10 of
//     its child, 90. The intrinsic width of a box is asked BEFORE the
//     subtree is laid out, so the margins of the child are still zero at
//     that moment unless they are resolved on the spot. Without that #g
//     came out 70 wide and #i, which takes the rest, 20 too wide.
//  2. A CONTAINER WITHOUT A DEFINITE MAIN SIZE HAS NO FREE SPACE. #j is a
//     column without a height. Its used main size IS the sum of the
//     hypothetical sizes of its items (css-flexbox-1, 9.3.1), so the free
//     space in 9.7 is exactly zero. Treating the missing height as zero
//     instead gives a free space of -20, every item shrinks to nothing,
//     and the most ordinary flex container on the web -- a column without
//     a height -- measures zero.
//
//   #f 400 x 100   #g 90 x 100 (stretched)   #h 70 x 20 at x = 10
//   #i 310 x 30 at x = 90
//   #j 100 x 20    #k 50 x 20
//
// Computed by hand from css-flexbox-1, 7.2.3, 9.2.3 and 9.3.1, held
// against Chromium 141 afterwards: identical.
//
// The return value names the first check that fails.
import html.mem
import browser.node
import browser.names
import browser.driver
import css.tok
import css.cv
import css.sel
import css.cascade
import layout.box
import layout.build
import layout.flow

const SOURCE_LEN: usize = 162
const SHEET_LEN: usize = 293

#[no_gc]
fn source(out: *mut mem.Buf) {
    var t: [u8; 162] = "<!DOCTYPE html><html><head></head><body><div id=\"f\"><div id=\"g\"><div id=\"h\"></div></div><div id=\"i\"></div></div><div id=\"j\"><div id=\"k\"></div></div></body></html>"
    mem.buf_clear(out)
    var i: usize = 0
    while i < SOURCE_LEN {
        mem.buf_push(out, t[i])
        i = i + 1
    }
}

#[no_gc]
fn sheet(out: *mut mem.CpBuf) {
    var t: [u8; 293] = "html,body,div{display:block;margin:0;padding:0;border:0}html{font-size:20px}#f{display:flex;width:400px;height:100px}#g{display:flex;flex-direction:column}#h{width:70px;height:20px;margin:0 10px}#i{flex:1;height:30px}#j{display:flex;flex-direction:column;width:100px}#k{width:50px;height:20px}"
    mem.cp_clear(out)
    var i: usize = 0
    while i < SHEET_LEN {
        mem.cp_push(out, t[i] as u32)
        i = i + 1
    }
}

fn next_in_order(k: Gc[Node], root: Gc[Node]) -> Gc[Node] {
    if k.first_child != gc_null[Node]() {
        return k.first_child
    }
    var c: Gc[Node] = k
    while c != gc_null[Node]() && c != root {
        if c.next != gc_null[Node]() {
            return c.next
        }
        c = c.parent
    }
    return gc_null[Node]()
}

// The n-th elem in document order -- the same order the driver and a
// browser walk in, so an index here means the same thing everywhere.
fn elem_at(doc: Gc[Node], want: u64) -> Gc[Node] {
    var k: Gc[Node] = doc
    var i: u64 = 0
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            if i == want {
                return k
            }
            i = i + 1
        }
        k = next_in_order(k, doc)
    }
    return gc_null[Node]()
}

fn find_box(b: Gc[Box], k: Gc[Node]) -> Gc[Box] {
    if b.elem == k {
        return b
    }
    var i: u64 = 0
    while i < box.box_kids(b) {
        let r: Gc[Box] = find_box(box.box_kid(b, i), k)
        if r != gc_null[Box]() {
            return r
        }
        i = i + 1
    }
    return gc_null[Box]()
}

// Equal to a thousandth of a pixel. The engine computes in a grid of
// 1/64 px, so anything below that cannot be a difference of the algorithm.
fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d < 0.001
}

fn check(root: Gc[Box], doc: Gc[Node], index: u64, x: f64, y: f64,
    w: f64, h: f64) -> bool {
    let k: Gc[Node] = elem_at(doc, index)
    if k == gc_null[Node]() {
        return false
    }
    let b: Gc[Box] = find_box(root, k)
    if b == gc_null[Box]() {
        return false
    }
    return near(b.x, x) && near(b.y, y) && near(b.w, w) && near(b.h, h)
}

// The whole path in one call: HTML to DOM, CSS to rules, cascade, box
// tree, layout. Exactly what lib/layout/layout_main.fi does.
fn lay_out(l: *mut driver.Run, src: *mut mem.Buf, css: *mut mem.CpBuf,
    t: *mut tok.Tokens, tmp: *mut mem.CpBuf, cx: *mut sel.Ctx,
    w: *mut cascade.Winner, doc_out: *mut Gc[Node])
-> AllocError!Gc[Box] {
    driver.run_text_out_bytes(l, mem.buf_ptr(src), mem.buf_len(src))
    let rc: u32 = driver.run_document_build(l)
    if rc != 0 as u32 {
        return gc_null[Box]()
    }
    let doc: Gc[Document] = driver.run_document(l)
    let nm: *mut names.Names = driver.run_names(l)
    tok.tokenize(t, css)
    var p: cv.Parser = cv.parser_new(t)
    let sheet_tree = try cv.parse_stylesheet(&p)
    var order: u32 = 0
    let rules = try cascade.collect_rules(sheet_tree, cascade.ORIGIN_AUTHOR, 0,
        nm, tmp, &order)
    let styles = try gcmap_new(true, true)
    let root_style = try cascade.style_root()
    var k: Gc[Node] = doc
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            var parent_style: Gc[Style] = root_style
            let parent: Gc[Node] = k.parent
            if parent != gc_null[Node]() && parent.kind == node.K_ELEM {
                let found: Gc[Style] = gcmap_get_value[Style](styles,
                    parent as u64)
                if found != gc_null[Style]() {
                    parent_style = found
                }
            }
            let s = try cascade.cascade_elem(rules, k, parent_style, cx, w)
            let ok: bool = try gcmap_set_value[Style](styles, k as u64, s)
        }
        k = next_in_order(k, doc)
    }
    let root = try build.build_document(doc, styles, root_style, nm)
    if root == gc_null[Box]() {
        return gc_null[Box]()
    }
    let okl: bool = try flow.layout_document(root, 800.0, 600.0)
    *doc_out = doc
    return root
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    var src: mem.Buf = mem.buf_new()
    mem.buf_init(&src)
    source(&src)
    var css: mem.CpBuf = mem.cp_new()
    mem.cp_init(&css)
    sheet(&css)
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var tmp: mem.CpBuf = mem.cp_new()
    var l: driver.Run = driver.run_new()
    if !driver.run_init(&l) {
        return 91
    }
    var cx: sel.Ctx = sel.ctx_new(driver.run_names(&l))
    sel.ctx_init(&cx)
    var w: cascade.Winner = cascade.winner_new()
    var doc: Gc[Node] = gc_null[Node]()
    let root: Gc[Box] = lay_out(&l, &src, &css, &t, &tmp, &cx, &w, &doc)
    catch gc_null[Box]()
    if root == gc_null[Box]() || doc == gc_null[Node]() {
        return 92
    }
    // #f -- the row
    if !check(root, doc, 3, 0.0000, 0.0000, 400.0000, 100.0000) {
        return 1
    }
    // #g -- flex base size 90: 70 plus the margins of its child
    if !check(root, doc, 4, 0.0000, 0.0000, 90.0000, 100.0000) {
        return 2
    }
    // #h
    if !check(root, doc, 5, 10.0000, 0.0000, 70.0000, 20.0000) {
        return 3
    }
    // #i -- what is left
    if !check(root, doc, 6, 90.0000, 0.0000, 310.0000, 30.0000) {
        return 4
    }
    // #j -- a column without a height is as tall as its content
    if !check(root, doc, 7, 0.0000, 100.0000, 100.0000, 20.0000) {
        return 5
    }
    // #k -- and its item keeps its height
    if !check(root, doc, 8, 0.0000, 100.0000, 50.0000, 20.0000) {
        return 6
    }
    return 0
}
