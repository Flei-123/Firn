import jxl.jxl_vardct
import jxl.jxl_vdrecon
import std.fs
import std.math
import std.rt

static mut failures: i32 = 0
static mut last_psnr: f64 = 0.0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn ppm_body(d: *mut rt.Buf, n: usize) -> usize {
    var nl: u32 = 0
    var i: usize = 0
    while i < n && nl < 3 {
        if rt.ld8(rt.buf_ptr(d), i) == 10 {
            nl = nl + 1
        }
        i = i + 1
    }
    return i
}

fn decode_all(v: *mut jxl_vardct.JxlVardct) -> bool {
    var g: usize = 0
    while g < ((*v).doc.frame.num_lf_groups as usize) {
        var end: usize = 0
        if jxl_vardct.vd_decode_lf_group(v, g, &end) != 0 {
            return false
        }
        g = g + 1
    }
    var hend: usize = 0
    if jxl_vardct.vd_decode_hf_global(v, &hend) != 0 {
        return false
    }
    g = 0
    while g < ((*v).doc.frame.num_groups as usize) {
        var end: usize = 0
        if jxl_vardct.vd_decode_ac_group(v, 0, g, &end) != 0 {
            return false
        }
        g = g + 1
    }
    return true
}

fn psnr_of(a: u64, b: u64, n: usize) -> f64 {
    var sum: f64 = 0.0
    var i: usize = 0
    while i < n {
        let e: f64 = (rt.ld8(a, i) as f64) - (rt.ld8(b, i) as f64)
        sum = sum + e * e
        i = i + 1
    }
    if sum == 0.0 {
        return 99.0
    }
    return 10.0 * math.log10(255.0 * 255.0 * (n as f64) / sum)
}

fn expect(path: str, ppm: str, min_psnr: f64) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    check(n != 0)
    var ref: rt.Buf = rt.buf_new()
    let rn: usize = fs.read_file(ppm, &ref) catch 0
    check(rn != 0)
    var v: jxl_vardct.JxlVardct = jxl_vardct.vd_new()
    let r: i32 = jxl_vardct.vd_open(rt.buf_ptr(&data), n, &v)
    check(r == 0)
    if r == 0 && decode_all(&v) {
        let w: usize = v.doc.frame.width as usize
        let h: usize = v.doc.frame.height as usize
        let out: u64 = rt.heap_alloc(w * h * 3)
        check(jxl_vdrecon.vr_reconstruct(&v, out) == 0)
        let p: f64 = psnr_of(out, rt.buf_ptr(&ref) + (ppm_body(&ref, rn) as u64), w * h * 3)
        last_psnr = p
        check(p >= min_psnr)
        rt.heap_free(out, w * h * 3)
    } else {
        check(false)
    }
    jxl_vardct.vd_free(&v)
    rt.buf_free(&data)
    rt.buf_free(&ref)
}

fn main() -> i32 {
    expect("tests/data/jxl/vd/t64_g0.jxl", "tests/data/jxl/vd/t64_g0.ppm", 50.0)
    expect("tests/data/jxl/vd/t37x29_g0.jxl", "tests/data/jxl/vd/t37x29_g0.ppm", 50.0)
    expect("tests/data/jxl/vd/s300x200_g0.jxl", "tests/data/jxl/vd/s300x200_g0.ppm", 50.0)
    expect("tests/data/jxl/vd/t64_gab.jxl", "tests/data/jxl/vd/t64_gab.ppm", 50.0)
    expect("tests/data/jxl/vd/t37x29_gab.jxl", "tests/data/jxl/vd/t37x29_gab.ppm", 50.0)
    expect("tests/data/jxl/vd/s300x200_gab.jxl", "tests/data/jxl/vd/s300x200_gab.ppm", 50.0)
    expect("tests/data/jxl/vd/t64_epf1.jxl", "tests/data/jxl/vd/t64_epf1.ppm", 50.0)
    expect("tests/data/jxl/vd/t64_epf2.jxl", "tests/data/jxl/vd/t64_epf2.ppm", 50.0)
    expect("tests/data/jxl/vd/t64_epf3.jxl", "tests/data/jxl/vd/t64_epf3.ppm", 50.0)
    expect("tests/data/jxl/vd/t37x29_epf1.jxl", "tests/data/jxl/vd/t37x29_epf1.ppm", 50.0)
    expect("tests/data/jxl/vd/t37x29_epf2.jxl", "tests/data/jxl/vd/t37x29_epf2.ppm", 50.0)
    expect("tests/data/jxl/vd/t37x29_epf3.jxl", "tests/data/jxl/vd/t37x29_epf3.ppm", 50.0)
    expect("tests/data/jxl/vd/s300x200_epf1.jxl", "tests/data/jxl/vd/s300x200_epf1.ppm", 50.0)
    expect("tests/data/jxl/vd/s300x200_epf2.jxl", "tests/data/jxl/vd/s300x200_epf2.ppm", 50.0)
    expect("tests/data/jxl/vd/s300x200_epf3.jxl", "tests/data/jxl/vd/s300x200_epf3.ppm", 50.0)
    expect("tests/data/jxl/vd/s64.jxl", "tests/data/jxl/vd/s64.ppm", 45.0)
    expect("tests/data/jxl/vd/t64.jxl", "tests/data/jxl/vd/t64.ppm", 45.0)
    expect("tests/data/jxl/vd/t37x29.jxl", "tests/data/jxl/vd/t37x29.ppm", 45.0)
    expect("tests/data/jxl/vd/t64_e7.jxl", "tests/data/jxl/vd/t64_e7.ppm", 45.0)
    expect("tests/data/jxl/vd/t37x29_e7.jxl", "tests/data/jxl/vd/t37x29_e7.ppm", 45.0)
    expect("tests/data/jxl/vd/s300x200_e7.jxl", "tests/data/jxl/vd/s300x200_e7.ppm", 45.0)
    expect("tests/data/jxl/vd/s600x300_e7.jxl", "tests/data/jxl/vd/s600x300_e7.ppm", 45.0)
    expect("tests/data/jxl/vd/acsmix_e8.jxl", "tests/data/jxl/vd/acsmix_e8.ppm", 45.0)
    expect("tests/data/jxl/vd/acsedges_e8.jxl", "tests/data/jxl/vd/acsedges_e8.ppm", 45.0)
    expect("tests/data/jxl/vd/acsnoise_e8.jxl", "tests/data/jxl/vd/acsnoise_e8.ppm", 45.0)
    return failures
}
