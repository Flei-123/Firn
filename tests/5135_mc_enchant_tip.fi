// expect_exit: 0
import std.rt
import mc.mc_tip_lines
import mc.mc_item_names
import mc.mc_item_tip
import mc.mc_enchant_tip

const LANG: str = "{\"enchantment.minecraft.sharpness\":\"Sharpness\",\"item.minecraft.iron_pickaxe\":\"Iron Pickaxe\",\"container.enchant.clue\":\"%s . . . ?\",\"container.enchant.lapis.one\":\"1 Lapis Lazuli\",\"container.enchant.lapis.many\":\"%s Lapis Lazuli\",\"container.enchant.level.one\":\"1 Enchantment Level\",\"container.enchant.level.many\":\"%s Enchantment Levels\",\"container.enchant.level.requirement\":\"Level Requirement: %s\"}"

fn line_is(t: *mut mc_tip_lines.TipLines, i: usize, want: str) -> bool {
    if mc_tip_lines.tl_len(t, i) != want.n { return false }
    return rt.mem_eq(mc_tip_lines.tl_text(t) + (mc_tip_lines.tl_off(t, i) as u64), want.p as u64, want.n)
}

fn line_rgb(t: *mut mc_tip_lines.TipLines, i: usize) -> i32 {
    return (rt.ld32(mc_tip_lines.tl_cols(t), mc_tip_lines.tl_off(t, i)) & 0xFFFFFF as u32) as i32
}

fn buf_is(b: *mut rt.Buf, want: str) -> bool {
    if rt.buf_len(b) != want.n { return false }
    return rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.n)
}

fn main() -> i32 {
    if !mc_item_names.names_load(LANG.p as u64, LANG.n) { return 1 }
    var props: [i32; 12] = [0; 12]
    props[0] = 5
    props[1] = 12
    props[2] = 30
    props[4] = 13
    props[5] = 13
    props[6] = 13
    props[7] = 1
    props[8] = 2
    props[9] = 3
    var t: mc_tip_lines.TipLines = mc_tip_lines.tl_new()
    let pp: u64 = (&props[0]) as u64
    mc_enchant_tip.et_build(&t, 0, pp, 1, 10, false, 763, 0 as u64, 0)
    if mc_tip_lines.tl_count(&t) != 4 { return 2 }
    if !line_is(&t, 0, "Sharpness I . . . ?") || line_rgb(&t, 0) != 0xFFFFFF { return 3 }
    if mc_tip_lines.tl_len(&t, 1) != 0 { return 4 }
    if !line_is(&t, 2, "1 Lapis Lazuli") || line_rgb(&t, 2) != 0xAAAAAA { return 5 }
    if !line_is(&t, 3, "1 Enchantment Level") { return 6 }
    mc_tip_lines.tl_clear(&t)
    mc_enchant_tip.et_build(&t, 1, pp, 1, 20, false, 763, 0 as u64, 0)
    if !line_is(&t, 0, "Sharpness II . . . ?") { return 7 }
    if !line_is(&t, 2, "2 Lapis Lazuli") || line_rgb(&t, 2) != 0xFF5555 { return 8 }
    if !line_is(&t, 3, "2 Enchantment Levels") { return 9 }
    mc_tip_lines.tl_clear(&t)
    mc_enchant_tip.et_build(&t, 2, pp, 3, 29, false, 763, 0 as u64, 0)
    if mc_tip_lines.tl_count(&t) != 3 || !line_is(&t, 2, "Level Requirement: 30") || line_rgb(&t, 2) != 0xFF5555 { return 10 }
    mc_tip_lines.tl_clear(&t)
    mc_enchant_tip.et_build(&t, 2, pp, 0, 0, true, 763, 0 as u64, 0)
    if mc_tip_lines.tl_count(&t) != 1 || !line_is(&t, 0, "Sharpness III . . . ?") { return 11 }
    mc_tip_lines.tl_clear(&t)
    props[1] = 0
    mc_enchant_tip.et_build(&t, 1, pp, 3, 40, false, 763, 0 as u64, 0)
    if mc_tip_lines.tl_count(&t) != 0 { return 12 }
    mc_enchant_tip.et_build(&t, 3, pp, 3, 40, false, 763, 0 as u64, 0)
    if mc_tip_lines.tl_count(&t) != 0 { return 13 }
    props[0] = 0 - 1
    mc_enchant_tip.et_build(&t, 0, pp, 3, 40, false, 763, 0 as u64, 0)
    if mc_tip_lines.tl_count(&t) != 0 { return 14 }
    props[0] = 5
    props[4] = 0 - 1
    mc_enchant_tip.et_build(&t, 0, pp, 3, 40, false, 763, 0 as u64, 0)
    if mc_tip_lines.tl_count(&t) != 3 || mc_tip_lines.tl_len(&t, 0) != 0 { return 15 }
    mc_tip_lines.tl_free(&t)
    var name: rt.Buf = rt.buf_new()
    mc_item_tip.tip_name_text(0 as u64, 0, "iron_pickaxe".p as u64, 12, &name)
    if !buf_is(&name, "Iron Pickaxe") { return 16 }
    rt.buf_clear(&name)
    let rec: str = "n{\"text\":\"Blade\"}\n"
    mc_item_tip.tip_name_text(rec.p as u64, rec.n, "iron_pickaxe".p as u64, 12, &name)
    if !buf_is(&name, "Blade") { return 17 }
    rt.buf_free(&name)
    return 0
}
