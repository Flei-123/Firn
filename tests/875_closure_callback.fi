// expect_exit: 0
// ROUND 58 -- what the lack of function values cost until now: CALLBACKS.
//
// Event handlers, iterators with a step of their own, a comparison passed in
// from outside -- all of these need a function that is a VALUE. Up to
// round 57 the honest substitute was a DISPATCHER with a tag: the collector
// calls `__gc_finalize(kind, p)` and the thread runtime `__thread_work(kind)`
// exactly for that reason (compiler/src/gc.rs).
//
// Here the same thing is built the way it can be built now -- and the
// closure that keeps a counter shows why a plain pointer is not enough.

import std.vec

struct Handler { on: fn(*mut i32, i32), tag: i32 }

fn on_add(sum: *mut i32, v: i32) { *sum = *sum + v }
fn on_max(best: *mut i32, v: i32) {
    if v > *best {
        *best = v
    }
}

// The event loop knows NOTHING about what the handlers do.
fn emit(hs: *mut Vec[Handler], state: *mut i32, v: i32) {
    var i: usize = 0
    while i < vec_len[Handler](hs) {
        let h: *mut Handler = vec_elem_ptr[Handler](hs, i)
        let f: fn(*mut i32, i32) = (*h).on
        f(state, v)
        i = i + 1
    }
}

// An iterator with a step of its own: `each` runs over the field, the step
// comes from outside.
fn each(v: *mut Vec[i32], step: fn(*mut i32, i32), state: *mut i32) {
    var i: usize = 0
    while i < vec_len[i32](v) {
        step(state, vec_at[i32](v, i))
        i = i + 1
    }
}

// A closure that COUNTS: the counter lies in the record, not on the stack of
// the caller. That is exactly what a bare function pointer cannot do.
fn counter(start: i32) -> AllocError!fn(*mut i32, i32) {
    return try gc fn(out: *mut i32, v: i32) { *out = *out + v + start }
}

fn run() -> AllocError!i32 {
    var hs: Vec[Handler] = vec_new[Handler]()
    defer vec_free[Handler](&hs)
    vec_push[Handler](&hs, Handler { on: on_add, tag: 1 })

    var sum: i32 = 0
    emit(&hs, &sum, 3)
    emit(&hs, &sum, 4)
    if sum != 7 { return 1 }

    // exchange the handler -- the loop stays as it is
    let h0: *mut Handler = vec_elem_ptr[Handler](&hs, 0)
    (*h0).on = on_max
    var best: i32 = 0
    emit(&hs, &best, 3)
    emit(&hs, &best, 9)
    emit(&hs, &best, 5)
    if best != 9 { return 2 }

    // a closure as a handler
    (*h0).on = try counter(10)
    var acc: i32 = 0
    emit(&hs, &acc, 1)
    emit(&hs, &acc, 2)
    if acc != 23 { return 3 }

    // an iterator with a step from outside
    var v: Vec[i32] = vec_new[i32]()
    defer vec_free[i32](&v)
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    vec_push[i32](&v, 3)
    var total: i32 = 0
    each(&v, on_add, &total)
    if total != 6 { return 4 }
    var m: i32 = 0
    each(&v, on_max, &m)
    if m != 3 { return 5 }
    var doubled: i32 = 0
    each(&v, fn(p: *mut i32, x: i32) { *p = *p + x + x }, &doubled)
    if doubled != 12 { return 6 }
    return 0
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}
