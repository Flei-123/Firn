// expect_out: z | basis36 1295 gelesen 2 neg -42 |     420000-7 | 0.30000000000000004 | ziffern 4 runde true ueberlauf true
// tests/801_std_num_core.fi -- number <-> text in `std.num` (round 42).
//
// The three directions of the facade at their edges:
//   write_*      number -> text, appended (base 2..36, padding, i64::MIN)
//   read_*       text -> number, with the count of octets consumed
//   text_to_*    strict: the WHOLE text or `false`
//
// The edges are what matters: u64::MAX works, u64::MAX+1 is reported as an
// OVERFLOW instead of wrapping; i64::MIN works in both directions although
// its magnitude does not fit into i64. Floating point runs over the exact
// cores (dtoa/strtod) -- what is checked here is the shell, not the rounding.
import std.io
import std.num

fn show(b: *mut num.Bytes) {
    io.print_bytes((*b).ptr as u64, (*b).len)
}

fn main() -> i32 {
    var b: num.Bytes = num.Bytes { ptr: 0 as *mut u8, len: 0, cap: 0 }

    // --- number -> text
    num.write_u64(&b, 0)
    num.write_u64(&b, 1234567890)
    if num.bytes_len(&b) != 11 {
        return 10
    }
    num.bytes_clear(&b)
    num.write_u64(&b, num.u64_max())
    if num.bytes_len(&b) != 20 {
        return 11
    }
    num.bytes_clear(&b)
    num.write_i64(&b, num.i64_min())
    if num.bytes_len(&b) != 20 || num.bytes_at(&b, 0) != 45 as u8 {
        return 12
    }
    num.bytes_clear(&b)
    num.write_hex(&b, 48879, 6)
    if num.bytes_len(&b) != 6 || num.bytes_at(&b, 0) != 48 as u8 {
        return 13
    }
    num.bytes_clear(&b)
    num.write_hex_big(&b, 48879, 0)
    if num.bytes_len(&b) != 4 || num.bytes_at(&b, 0) != 66 as u8 {
        return 14
    }
    num.bytes_clear(&b)
    num.write_binary(&b, 5, 8)
    if num.bytes_len(&b) != 8 || num.bytes_at(&b, 7) != 49 as u8 {
        return 15
    }
    num.bytes_clear(&b)
    num.write_octal(&b, 8, 0)
    if num.bytes_len(&b) != 2 {
        return 16
    }
    num.bytes_clear(&b)
    num.write_base(&b, 35, 36, false)
    if num.bytes_len(&b) != 1 || num.bytes_at(&b, 0) != 122 as u8 {
        return 17
    }
    if num.digit_count(0, 10) != 1 || num.digit_count(999, 10) != 3 {
        return 18
    }
    if num.digit_count(255, 16) != 2 {
        return 19
    }

    var tab: num.Bytes = num.Bytes { ptr: 0 as *mut u8, len: 0, cap: 0 }
    num.write_wide_u64(&tab, 42, 6, 32 as u8)
    num.write_wide_i64(&tab, 0 - 7, 6, 48 as u8)
    if num.bytes_len(&tab) != 12 {
        return 20
    }
    if num.bytes_at(&tab, 6) != 48 as u8 || num.bytes_at(&tab, 10) != 45 as u8 {
        return 21
    }

    // --- text -> number, strict
    var t_max: [u8; 21] = "18446744073709551615\0"
    var t_over: [u8; 21] = "18446744073709551616\0"
    var t_min: [u8; 21] = "-9223372036854775808\0"
    var t_under: [u8; 21] = "-9223372036854775809\0"
    var w: u64 = 0
    var v: i64 = 0
    if !num.text_to_u64((&t_max[0]) as *mut u8, 20, &w) || w != num.u64_max() {
        return 30
    }
    if num.text_to_u64((&t_over[0]) as *mut u8, 20, &w) {
        return 31
    }
    if !num.text_to_i64((&t_min[0]) as *mut u8, 20, &v) || v != num.i64_min() {
        return 32
    }
    if num.text_to_i64((&t_under[0]) as *mut u8, 20, &v) {
        return 33
    }
    var t_empty: [u8; 1] = "\0"
    if num.text_to_u64((&t_empty[0]) as *mut u8, 0, &w) {
        return 34
    }
    var t_rest: [u8; 8] = "12 rest\0"
    if num.text_to_u64((&t_rest[0]) as *mut u8, 7, &w) {
        return 35
    }

    // --- text -> number, reading (the rest stays)
    var ue: bool = false
    let read: usize = num.read_u64((&t_rest[0]) as *mut u8, 7, 0, &w, &ue)
    if read != 2 || w != 12 || ue {
        return 40
    }
    var t_neg: [u8; 9] = "-000042x\0"
    let read2: usize = num.read_i64((&t_neg[0]) as *mut u8, 8, 0, &v, &ue)
    if read2 != 7 || v != 0 - 42 || ue {
        return 41
    }
    if num.read_u64_base((&t_neg[0]) as *mut u8, 8, 0, 10, &w, &ue) != 0 {
        return 42
    }
    var t_hex: [u8; 7] = "0xff00\0"
    var t_bin: [u8; 7] = "0b1011\0"
    var t_oct: [u8; 5] = "0o17\0"
    if !num.text_to_u64_auto((&t_hex[0]) as *mut u8, 6, &w) || w != 65280 {
        return 43
    }
    if !num.text_to_u64_auto((&t_bin[0]) as *mut u8, 6, &w) || w != 11 {
        return 44
    }
    if !num.text_to_u64_auto((&t_oct[0]) as *mut u8, 4, &w) || w != 15 {
        return 45
    }
    var t_36: [u8; 3] = "zz\0"
    var w36: u64 = 0
    if !num.text_to_u64_base((&t_36[0]) as *mut u8, 2, 36, &w36) || w36 != 1295 {
        return 46
    }
    // Overflow is reported, not hushed up.
    if num.read_u64((&t_over[0]) as *mut u8, 20, 0, &w, &ue) != 20 {
        return 47
    }
    if !ue {
        return 48
    }

    // --- floating point
    var f: num.Bytes = num.Bytes { ptr: 0 as *mut u8, len: 0, cap: 0 }
    if !num.write_f64(&f, 0.1) {
        return 50
    }
    if num.bytes_len(&f) != 3 {
        return 51
    }
    num.bytes_clear(&f)
    if !num.write_f64(&f, 0.0 - 1.5) {
        return 52
    }
    if num.bytes_len(&f) != 4 || num.bytes_at(&f, 0) != 45 as u8 {
        return 53
    }
    num.bytes_clear(&f)
    num.write_f64(&f, 1.0e21)
    if num.bytes_len(&f) != 5 || num.bytes_at(&f, 1) != 101 as u8 {
        return 54
    }
    var t_f: [u8; 6] = "2.5e3\0"
    var x: f64 = 0.0
    if !num.text_to_f64((&t_f[0]) as *mut u8, 5, &x) || x != 2500.0 {
        return 55
    }
    var t_whole: [u8; 4] = "123\0"
    if num.read_f64((&t_whole[0]) as *mut u8, 3, &x) != 3 || x != 123.0 {
        return 56
    }
    if num.f64_bits(1.0) != 4607182418800017408 {
        return 57
    }
    if num.bits_f64(4607182418800017408) != 1.0 {
        return 58
    }
    let infinite: f64 = 1.0 / 0.0
    if !num.f64_is_infinite(infinite) || num.f64_is_nan(infinite) {
        return 59
    }
    let no: f64 = 0.0 / 0.0
    if !num.f64_is_nan(no) {
        return 60
    }
    if !num.f64_is_null(0.0) || !num.f64_sign(0.0 - 1.0) {
        return 61
    }
    if num.dtoa_work_bytes() != 14336 || num.strtod_work_bytes() != 12288 {
        return 62
    }
    // There and back: the shortest text reads as the same number.
    // The value is COMPUTED (0.1 + 0.2), not written as a literal -- firnc0 and
    // firnc1 do not round 17-digit floating point literals alike (measured, see
    // docs/ROUND42.md), and this test is meant to check the number library, not
    // the lexer.
    let crooked: f64 = 0.1 + 0.2
    num.bytes_clear(&f)
    num.write_f64(&f, crooked)
    if num.bytes_len(&f) != 19 {
        return 63
    }
    var y: f64 = 0.0
    if !num.text_to_f64((*(&f)).ptr, num.bytes_len(&f), &y) {
        return 64
    }
    if y != crooked {
        return 65
    }

    // FINDING of round 42 (named, not rebuilt): a MODULE-QUALIFIED call in the
    // expression of an f"..." comes out differently in the canonical trees of
    // the two compilers -- firnc0 writes `str.npos`, firnc1 the internal name
    // `str__npos`. The behaviour is the same (the self comparison is EQUAL),
    // but tools/parser_compare.sh compares the tree octet for octet. That is
    // why the values stand in a binding here BEFORE the interpolation.
    // See docs/ROUND42.md, section 5C.
    let digits_1000: usize = num.digit_count(1000, 10)
    show(&b)
    io.fmt_print(f" | basis36 {w36} gelesen {read} neg {v} | ")
    show(&tab)
    io.fmt_print(f" | ")
    show(&f)
    io.fmt_print(f" | ziffern {digits_1000} runde {y == crooked} ueberlauf {ue}\n")

    num.bytes_free(&b)
    num.bytes_free(&tab)
    num.bytes_free(&f)
    return 0
}
