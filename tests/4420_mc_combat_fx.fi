// expect_exit: 0
import std.rt
import mc.mc_raster
import mc.mc_combat_fx
import mc.mc_combat_ui

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn speed(name: str) -> i32 {
    return mc_combat_fx.cfx_speed_x10(name.p as u64, name.n)
}

fn repeats(name: str) -> bool {
    return mc_combat_fx.cfx_use_repeats(name.p as u64, name.n)
}

fn px(r: *mut mc_raster.Raster, x: i32, y: i32) -> u32 {
    return mc_raster.raster_pixel(r, x, y)
}

fn main() -> i32 {
    check(speed("diamond_sword") == 16 && speed("wooden_axe") == 8 && speed("iron_axe") == 9 && speed("diamond_axe") == 10, 1)
    check(speed("stone_hoe") == 20 && speed("netherite_hoe") == 40 && speed("golden_pickaxe") == 12 && speed("stick") == 40, 2)
    check(speed("trident") == 11 && speed("iron_shovel") == 10, 3)
    check(repeats("snowball") && repeats("ender_pearl") && !repeats("bow") && !repeats("apple") && !repeats("stone"), 4)

    var fx: mc_combat_fx.CombatFx = mc_combat_fx.cfx_new()
    check(mc_combat_fx.cfx_strength_permille(&fx, 100 as u64) == 1000 && mc_combat_fx.cfx_attack_ready(&fx, 100 as u64), 5)
    let sw: str = "diamond_sword"
    mc_combat_fx.cfx_set_held(&fx, 7, sw.p as u64, sw.n, 1000 as u64)
    check(fx.speed_x10 == 16 && mc_combat_fx.cfx_cooldown_ms(&fx) == 625 as u64 && !fx.has_attacked, 6)
    mc_combat_fx.cfx_attacked(&fx, 42, 2000 as u64)
    check(mc_combat_fx.cfx_strength_permille(&fx, 2000 as u64) == 0, 7)
    check(mc_combat_fx.cfx_strength_permille(&fx, 2250 as u64) == 400, 8)
    check(!mc_combat_fx.cfx_attack_ready(&fx, 2624 as u64) && mc_combat_fx.cfx_attack_ready(&fx, 2625 as u64), 9)
    mc_combat_fx.cfx_set_held(&fx, 7, sw.p as u64, sw.n, 2300 as u64)
    check(mc_combat_fx.cfx_strength_permille(&fx, 2250 as u64) == 400, 10)
    let st: str = "stick"
    mc_combat_fx.cfx_set_held(&fx, 9, st.p as u64, st.n, 2400 as u64)
    check(fx.speed_x10 == 40 && mc_combat_fx.cfx_strength_permille(&fx, 2400 as u64) == 0 && mc_combat_fx.cfx_attack_ready(&fx, 2650 as u64), 11)

    check(mc_combat_fx.cfx_hold_due(0 as u64, 50 as u64, 200 as u64), 12)
    check(!mc_combat_fx.cfx_hold_due(1000 as u64, 1199 as u64, 200 as u64) && mc_combat_fx.cfx_hold_due(1000 as u64, 1200 as u64, 200 as u64), 13)

    var g: mc_combat_fx.CombatFx = mc_combat_fx.cfx_new()
    mc_combat_fx.cfx_on_hurt(&g, 42, 5, 500 as u64)
    check(g.n_hurts == 1 as u64 && g.n_hits == 0 as u64 && mc_combat_fx.cfx_hit_age(&g, 600 as u64) < 0, 14)
    mc_combat_fx.cfx_attacked(&g, 42, 1000 as u64)
    mc_combat_fx.cfx_on_hurt(&g, 42, 5, 1100 as u64)
    check(g.n_hurts == 2 as u64 && g.n_hits == 1 as u64 && mc_combat_fx.cfx_hit_age(&g, 1150 as u64) == 50, 15)
    mc_combat_fx.cfx_on_hurt(&g, 42, 5, 1150 as u64)
    check(g.n_hurts == 2 as u64 && g.n_hits == 1 as u64, 16)
    mc_combat_fx.cfx_on_hurt(&g, 77, 5, 1300 as u64)
    check(g.n_hurts == 3 as u64 && g.n_hits == 1 as u64, 17)
    mc_combat_fx.cfx_on_hurt(&g, 42, 5, 3000 as u64)
    check(g.n_hits == 1 as u64, 18)
    mc_combat_fx.cfx_on_hurt(&g, 5, 5, 3500 as u64)
    check(g.n_self_hurts == 1 as u64 && mc_combat_fx.cfx_hurt_age(&g, 3600 as u64) == 100, 19)

    var r: mc_raster.Raster = mc_raster.raster_new(200, 120)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    var h: mc_combat_fx.CombatFx = mc_combat_fx.cfx_new()
    mc_combat_ui.combat_ui_draw(&h, &r, 1, 100 as u64)
    check(px(&r, 100, 69) == 0xFF000000 as u32 && px(&r, 10, 10) == 0xFF000000 as u32, 20)
    mc_combat_fx.cfx_attacked(&h, 3, 1000 as u64)
    mc_combat_ui.combat_ui_draw(&h, &r, 1, 1125 as u64)
    check(px(&r, 95, 69) == 0xFFFFFFFF as u32 && px(&r, 105, 69) != 0xFFFFFFFF as u32 && px(&r, 105, 69) != 0xFF000000 as u32, 21)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_combat_ui.combat_ui_draw(&h, &r, 1, 1300 as u64)
    check(px(&r, 95, 69) == 0xFF000000 as u32, 22)
    mc_combat_fx.cfx_on_hurt(&h, 3, 5, 1300 as u64)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_combat_ui.combat_ui_draw(&h, &r, 1, 1350 as u64)
    check(px(&r, 100 - 3 - 1, 60 - 3 - 1) == mc_combat_ui.HIT_COLOR, 23)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_combat_ui.combat_ui_draw(&h, &r, 1, 1700 as u64)
    check(px(&r, 100 - 3 - 1, 60 - 3 - 1) == 0xFF000000 as u32, 24)

    var k: mc_combat_fx.CombatFx = mc_combat_fx.cfx_new()
    mc_combat_fx.cfx_on_hurt(&k, 5, 5, 2000 as u64)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_combat_ui.combat_ui_draw(&k, &r, 1, 2000 as u64)
    check((px(&r, 5, 5) & 255 as u32) > 40 as u32 && px(&r, 100, 60) == 0xFF000000 as u32, 25)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_combat_ui.combat_ui_draw(&k, &r, 1, 2500 as u64)
    check(px(&r, 5, 5) == 0xFF000000 as u32, 26)
    return 0
}
