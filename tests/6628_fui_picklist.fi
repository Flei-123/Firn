// expect_exit: 0
import fui.picklist
import std.rt

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn main() -> i32 {
    var p: picklist.PickList = picklist.picklist_new()
    check("empty", picklist.picklist_count(&p) == 0 && picklist.picklist_current(&p) == -1)
    let a: str = "id-a"
    let b: str = "id-b"
    let la: str = "Alpha"
    let lb: str = "Beta"
    check("add 0", picklist.picklist_add(&p, a.p as u64, a.n, la.p as u64, la.n) == 0)
    check("add 1", picklist.picklist_add(&p, b.p as u64, b.n, lb.p as u64, lb.n) == 1)
    check("count 2", picklist.picklist_count(&p) == 2)
    check("label len", picklist.picklist_label_len(&p, 1) == 4)
    check("label bytes", rt.mem_eq(picklist.picklist_label_ptr(&p, 0), la.p as u64, 5))
    check("id bytes", rt.mem_eq(picklist.picklist_id_ptr(&p, 1), b.p as u64, 4))
    check("find", picklist.picklist_find_id(&p, b.p as u64, b.n) == 1)
    check("find missing", picklist.picklist_find_id(&p, la.p as u64, la.n) == -1)
    picklist.picklist_set_current(&p, 1)
    check("current", picklist.picklist_current(&p) == 1)
    var i: usize = 0
    while i < 40 {
        picklist.picklist_add(&p, a.p as u64, a.n, la.p as u64, la.n)
        i = i + 1
    }
    check("capped at 32", picklist.picklist_count(&p) == 32)
    let long: str = "0123456789abcdef-too-long-id"
    var q: picklist.PickList = picklist.picklist_new()
    picklist.picklist_add(&q, long.p as u64, long.n, la.p as u64, la.n)
    check("id truncated", picklist.picklist_id_len(&q, 0) == 16)
    picklist.picklist_clear(&q)
    check("clear", picklist.picklist_count(&q) == 0)
    if failures > 0 {
        return 1
    }
    return 0
}
