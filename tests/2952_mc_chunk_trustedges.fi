// expect_exit: 0
// 1.18.2 (758) and 1.19.4 (762) map_chunk carry a trustEdges bool before the four light masks (found with the real
// servers: chunk_bad on every column). 1.20.1 (763) dropped it. chunk_decode_for must read it with FLAG_TRUST_EDGES and
// still decode 763 without it; the wrong layout must be refused (packet not consumed exactly).
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_chunk

// map_chunk of the 1.18 - 1.20.1 shape (named NBT root) with 2 single-value sections; `trust` adds the trustEdges bool
fn build(b: *mut bytes.Bytes, trust: bool) {
    bytes.put_i32(b, 3)
    bytes.put_i32(b, 0 - 4)
    bytes.put_u8(b, 10 as u8) // heightmaps: empty compound with an empty root name
    bytes.put_u16(b, 0 as u16)
    bytes.put_u8(b, 0 as u8)
    var d: bytes.Bytes = bytes.bytes_new()
    var s: i32 = 0
    while s < 2 {
        bytes.put_i16(&d, 100 + s as i16) // block count
        bytes.put_u8(&d, 0 as u8) // blocks: single value
        bytes.put_varint(&d, 9 + s)
        bytes.put_varint(&d, 0) // data array length
        bytes.put_u8(&d, 0 as u8) // biomes: single value
        bytes.put_varint(&d, 1)
        bytes.put_varint(&d, 0)
        s = s + 1
    }
    bytes.put_varint(b, d.len as i32)
    bytes.put_raw(b, d.data, d.len)
    bytes.bytes_free(&d)
    bytes.put_varint(b, 0) // block entities
    if trust { bytes.put_u8(b, 1 as u8) } // trustEdges
    var m: i32 = 0
    while m < 4 { bytes.put_varint(b, 0); m = m + 1 } // four masks
    bytes.put_varint(b, 0) // sky arrays
    bytes.put_varint(b, 0) // block arrays
}

fn decode(protocol: i32, trust: bool, counts: *mut [i32; 2]) -> bool {
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(protocol, &v) { return false }
    var b: bytes.Bytes = bytes.bytes_new()
    build(&b, trust)
    bytes.bytes_set_pos(&b, 0)
    var sc: mc_chunk.Scratch = mc_chunk.scratch_new()
    let p: u64 = mc_chunk.chunk_alloc()
    let c: *mut mc_chunk.Chunk = p as *mut mc_chunk.Chunk
    let ok: bool = mc_chunk.chunk_decode_for(&v, &b, &sc, c, 2) catch false
    if ok {
        let s0: *mut mc_chunk.Section = (*c).secs as *mut mc_chunk.Section
        let s1: *mut mc_chunk.Section = ((*c).secs + mc_chunk.section_size() as u64) as *mut mc_chunk.Section
        (*counts)[0] = (*s0).count
        (*counts)[1] = (*s1).count
    }
    mc_chunk.chunk_release(p)
    mc_chunk.scratch_free(&sc)
    bytes.bytes_free(&b)
    return ok
}

fn main() -> i32 {
    var cnt: [i32; 2] = [0, 0]
    if !decode(758, true, &cnt) { return 1 }
    if cnt[0] != 100 || cnt[1] != 101 { return 2 }
    var c2: [i32; 2] = [0, 0]
    if !decode(762, true, &c2) { return 3 }
    if c2[0] != 100 || c2[1] != 101 { return 4 }
    var c3: [i32; 2] = [0, 0]
    if !decode(763, false, &c3) { return 5 }
    if c3[0] != 100 || c3[1] != 101 { return 6 }
    // wrong layouts: 1.18.2 without the bool, 1.20.1 with it
    var c4: [i32; 2] = [0, 0]
    if decode(758, false, &c4) { return 7 }
    var c5: [i32; 2] = [0, 0]
    if decode(763, true, &c5) { return 8 }
    return 0
}
