// expect_exit: 0
// tests/4442_std_deque.fi -- std.deque against Python's collections.deque.
// The expected numbers come from CPython 3.11 running the same LCG-driven
// operation script (tools/libs_py_cross/deque_ref.py): append / appendleft /
// popleft / pop / rotate / extend / extendleft, unbounded and with maxlen
// (1, 5, 64), then reverse and rotate edge cases, struct elements, growth.
import std.rt
import std.vec
import std.deque
import std.testkit

struct Pair { a: i64, b: i64 }

struct Lcg { x: u64 }

fn lcg_next(g: *mut Lcg) -> u64 {
    (*g).x = ((*g).x * 1103515245 + 12345) & 0x7fffffff
    return (*g).x
}

fn ck(d: *mut Deque[i64]) -> u64 {
    var h: u64 = 7
    var i: usize = 0
    while i < deque_len[i64](d) {
        h = (h * 31 + (*deque_at[i64](d, i)) as u64) & 0xffffffff
        i = i + 1
    }
    return h
}

// One run of the script; returns the pop checksum, leaves the deque in *d.
fn run(g: *mut Lcg, d: *mut Deque[i64], n: usize) -> u64 {
    var acc: u64 = 0
    var x: i64 = 0
    var i: usize = 0
    while i < n {
        let r: u64 = lcg_next(g)
        let op: u64 = (r >> 4) % 9
        let v: i64 = ((r >> 12) % 1000) as i64
        if op == 0 || op == 1 {
            deque_push_back[i64](d, v)
        } else if op == 2 || op == 3 {
            deque_push_front[i64](d, v)
        } else if op == 4 {
            if deque_pop_front[i64](d, &x) { acc = (acc * 31 + x as u64) & 0xffffffff }
        } else if op == 5 {
            if deque_pop_back[i64](d, &x) { acc = (acc * 31 + x as u64) & 0xffffffff }
        } else if op == 6 {
            deque_rotate[i64](d, (((r >> 20) % 21) as i64) - 10)
        } else if op == 7 {
            var t: Vec[i64] = vec_new[i64]()
            vec_push[i64](&t, v)
            vec_push[i64](&t, v + 1)
            vec_push[i64](&t, v + 2)
            deque_extend[i64](d, &t)
            vec_free[i64](&t)
        } else {
            var t: Vec[i64] = vec_new[i64]()
            vec_push[i64](&t, v)
            vec_push[i64](&t, v + 1)
            deque_extend_left[i64](d, &t)
            vec_free[i64](&t)
        }
        i = i + 1
    }
    return acc
}

fn expect_list(d: *mut Deque[i64], want: *i64, n: usize) -> bool {
    if deque_len[i64](d) != n { return false }
    var i: usize = 0
    while i < n {
        if *deque_at[i64](d, i) != *((want as u64 + (i as u64) * 8) as *i64) { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var g: Lcg = Lcg { x: 777 }

    var d0: Deque[i64] = deque_new[i64]()
    let a0: u64 = run(&g, &d0, 5000)
    testkit.check(deque_len[i64](&d0) == 3934 && ck(&d0) == 2085879210 && a0 == 743008733, "unbounded run")
    testkit.check(*deque_front[i64](&d0) == 959 && *deque_at[i64](&d0, 1) == 958 && *deque_at[i64](&d0, 2) == 822, "unbounded front")

    var d5: Deque[i64] = deque_new_max[i64](5)
    let a5: u64 = run(&g, &d5, 5000)
    testkit.check(deque_len[i64](&d5) == 5 && ck(&d5) == 410620941 && a5 == 2253618264, "maxlen 5 run")

    var d1: Deque[i64] = deque_new_max[i64](1)
    let a1: u64 = run(&g, &d1, 300)
    testkit.check(deque_len[i64](&d1) == 1 && ck(&d1) == 742 && a1 == 688956483, "maxlen 1 run")

    var d64: Deque[i64] = deque_new_max[i64](64)
    let a64: u64 = run(&g, &d64, 8000)
    testkit.check(deque_len[i64](&d64) == 64 && ck(&d64) == 130011490 && a64 == 881167706, "maxlen 64 run")
    testkit.check(*deque_front[i64](&d64) == 248 && *deque_back[i64](&d64) == *deque_at[i64](&d64, 63), "maxlen 64 ends")

    // reverse, rotate edge cases
    var r: Deque[i64] = deque_new[i64]()
    for i in 0..(10 as usize) { deque_push_back[i64](&r, i as i64) }
    deque_reverse[i64](&r)
    testkit.check(ck(&r) == 1749610722, "reverse")
    deque_clear[i64](&r)
    for i in 0..(7 as usize) { deque_push_back[i64](&r, i as i64) }
    deque_rotate[i64](&r, -3)
    let w1: [i64; 7] = [3, 4, 5, 6, 0, 1, 2]
    testkit.check(expect_list(&r, &w1[0], 7), "rotate -3")
    deque_rotate[i64](&r, 100)
    let w2: [i64; 7] = [1, 2, 3, 4, 5, 6, 0]
    testkit.check(expect_list(&r, &w2[0], 7), "rotate 100")
    deque_rotate[i64](&r, -700)
    testkit.check(expect_list(&r, &w2[0], 7), "rotate -700 (multiple of len)")

    // empty and single, to_vec, struct elements, growth with wrap-around
    var e: Deque[i64] = deque_new[i64]()
    var x: i64 = 5
    testkit.check(!deque_pop_front[i64](&e, &x) && !deque_pop_back[i64](&e, &x) && x == 5, "pop on empty")
    testkit.check(deque_at[i64](&e, 0) == 0 as *mut i64 && deque_front[i64](&e) == 0 as *mut i64 && deque_back[i64](&e) == 0 as *mut i64, "null when empty")
    deque_rotate[i64](&e, 3)
    deque_reverse[i64](&e)
    testkit.check(deque_is_empty[i64](&e), "rotate/reverse on empty")
    var out: Vec[i64] = vec_new[i64]()
    deque_to_vec[i64](&r, &out)
    testkit.check(vec_len[i64](&out) == 7 && vec_at[i64](&out, 0) == 1 && vec_at[i64](&out, 6) == 0, "to_vec")

    var q: Deque[Pair] = deque_new[Pair]()
    var total: i64 = 0
    var pop: Pair = Pair { a: 0, b: 0 }
    for i in 0..(1000 as usize) {
        deque_push_back[Pair](&q, Pair { a: i as i64, b: 2 * i as i64 })
        if i % 3 == 0 {
            deque_pop_front[Pair](&q, &pop)
            total = total + pop.a + pop.b
        }
    }
    testkit.check(deque_len[Pair](&q) == 1000 - 334 && total == 3 * 333 * 334 / 2 * 1 && (*deque_front[Pair](&q)).a == 334, "struct queue, wrap and growth")
    // BFS-like: queue never shrinks below one while it cycles
    var c: Deque[i64] = deque_new[i64]()
    deque_push_back[i64](&c, 0)
    var k: i64 = 0
    var okc: bool = true
    for i in 0..(100000 as usize) {
        deque_pop_front[i64](&c, &k)
        if k != i as i64 { okc = false }
        deque_push_back[i64](&c, k + 1)
    }
    testkit.check(okc && deque_len[i64](&c) == 1, "100k cycles on one slot")
    deque_free[i64](&d0)
    deque_free[i64](&d5)
    deque_free[Pair](&q)
    return testkit.finish()
}
