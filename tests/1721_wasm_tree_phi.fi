// expect_exit: 0
// Round OPT-GENERAL: the WebAssembly backend computes a value right at its
// one use (an expression tree, codegen_wasm.rs::plan_trees). After phi
// elimination an ORDINARY instruction may write the local of a phi --
// `phi.rs` coalesces the new `zi` into the phi of `zi` -- and a tree that
// still reads the old `zi` must not move past it. Mandelbrot is exactly that
// loop; natively the result is 95513 for n = 40, and tools/wasm/run.sh holds
// the WebAssembly build to the same exit code.

fn mandel(n: i32) -> i32 {
    var summe: i32 = 0
    var y: i32 = 0
    while y < n {
        let ci: f64 = (y as f64) * 2.4 / (n as f64) - 1.2
        var x: i32 = 0
        while x < n {
            let cr: f64 = (x as f64) * 3.0 / (n as f64) - 2.0
            var zr: f64 = 0.0
            var zi: f64 = 0.0
            var k: i32 = 0
            while k < 256 && zr * zr + zi * zi <= 4.0 {
                let t: f64 = zr * zr - zi * zi + cr
                zi = 2.0 * zr * zi + ci
                zr = t
                k = k + 1
            }
            summe = summe + k
            x = x + 1
        }
        y = y + 1
    }
    return summe
}

fn main() -> i32 {
    let s: i32 = mandel(40)
    if s != 95513 {
        return 1
    }
    return 0
}
