// expect_exit: 0
// Erfolgstyp ist ein Zeiger.
error E { Null }

fn pruefe(p: *mut i32) -> E!*mut i32 {
    if p == 0 as *mut i32 {
        return E::Null
    }
    return p
}

fn main() -> i32 {
    var z: i32 = 41
    let q = pruefe(&z) catch 0 as *mut i32
    if *q != 41 {
        return 1
    }
    let leer = pruefe(0 as *mut i32) catch &z
    if *leer != 41 {
        return 2
    }
    return 0
}
