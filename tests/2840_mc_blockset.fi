// expect_exit: 0
// mc_blockset: container rebuild keeps every other entry, grows / shrinks the palette, uniform <-> packed.
import std.rt
import mc.mc_chunk
import mc.mc_blockset

fn uniform(id: u16) -> mc_chunk.Container {
    let p: u64 = rt.heap_alloc(2)
    rt.st16(p, 0, id)
    return mc_chunk.Container { bits: 0 as u32, pal_n: 1 as u32, pal: p, data: 0, words: 0 }
}

fn main() -> i32 {
    var c: mc_chunk.Container = uniform(1 as u16)
    if !mc_blockset.container_set(&c, 5, 9 as u16) { return 1 }
    if mc_chunk.container_get(&c, 5) != 9 as u16 { return 2 }
    if mc_chunk.container_get(&c, 4) != 1 as u16 || mc_chunk.container_get(&c, 6) != 1 as u16 { return 3 }
    if mc_chunk.container_bits(&c) != 1 as u32 { return 4 }
    // many distinct ids -> wider palette, values spanning u64 words must survive
    var k: usize = 0
    while k < 40 {
        if !mc_blockset.container_set(&c, 100 + k * 7, (200 + k) as u16) { return 5 }
        k = k + 1
    }
    k = 0
    while k < 40 {
        if mc_chunk.container_get(&c, 100 + k * 7) != (200 + k) as u16 { return 6 }
        k = k + 1
    }
    if mc_chunk.container_get(&c, 5) != 9 as u16 { return 7 }
    if mc_chunk.container_bits(&c) != 6 as u32 { return 8 }
    // back to one value
    var i: usize = 0
    while i < 4096 {
        mc_blockset.container_set(&c, i, 3 as u16)
        i = i + 1
    }
    if mc_chunk.container_bits(&c) != 0 as u32 || mc_chunk.container_palette_size(&c) != 1 as u32 { return 9 }
    if mc_chunk.container_get(&c, 4095) != 3 as u16 { return 10 }
    if mc_blockset.container_set(&c, 4096, 1 as u16) { return 11 }
    return 0
}
