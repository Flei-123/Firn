import std.testkit
import scene3d.vec3
import scene3d.camera
import scene3d.anim
import scene3d.scene

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000001
}

#[test]
fn camkeys_hold_and_midpoint() {
    var k: anim.CamKeys = anim.camkeys_new()
    anim.camkeys_add(&k, 4.0, vec3.v3(10.0, 0.0, 0.0), vec3.v3(0.0, 2.0, 0.0), 60.0)
    anim.camkeys_add(&k, 0.0, vec3.v3(0.0, 0.0, 0.0), vec3.v3(0.0, 0.0, 0.0), 40.0)
    anim.camkeys_add(&k, 2.0, vec3.v3(4.0, 0.0, 0.0), vec3.v3(0.0, 1.0, 0.0), 50.0)
    var c: camera.Camera = camera.cam_new(64, 36)
    anim.camkeys_at(&k, -1.0, &c)
    testkit.assert_true(near(c.pos.x, 0.0) && near(c.fov, 40.0), "hold before first")
    anim.camkeys_at(&k, 9.0, &c)
    testkit.assert_true(near(c.pos.x, 10.0) && near(c.fov, 60.0), "hold after last")
    anim.camkeys_at(&k, 2.0, &c)
    testkit.assert_true(near(c.pos.x, 4.0) && near(c.target.y, 1.0), "exact key")
    anim.camkeys_at(&k, 1.0, &c)
    testkit.assert_true(near(c.pos.x, 2.0) && near(c.fov, 45.0), "smoothstep midpoint")
    anim.camkeys_at(&k, 0.5, &c)
    testkit.assert_true(c.pos.x < 1.0, "ease in slower than linear")
    anim.camkeys_free(&k)
}

#[test]
fn ease_ends() {
    testkit.assert_true(near(anim.ease_apply(anim.EASE_IN_OUT, 0.0), 0.0), "in_out 0")
    testkit.assert_true(near(anim.ease_apply(anim.EASE_IN_OUT, 1.0), 1.0), "in_out 1")
    testkit.assert_true(near(anim.ease_apply(anim.EASE_OUT_CUBIC, 1.0), 1.0), "out cubic 1")
    testkit.assert_true(near(anim.ease_apply(anim.EASE_OUT_BACK, 1.0), 1.0), "back 1")
    testkit.assert_true(anim.ease_apply(anim.EASE_OUT_BACK, 0.8) > 1.0, "back overshoots")
    testkit.assert_true(near(anim.ease_apply(anim.EASE_LINEAR, 0.25), 0.25), "linear")
}

#[test]
fn timeline_pure() {
    var tl: anim.Timeline = anim.timeline_new()
    anim.timeline_fly_in(&tl, 3, vec3.v3(1.0, 2.0, 3.0), 2.0, 1.0, vec3.v3(0.0, 10.0, 0.0), true, anim.EASE_LINEAR)
    anim.timeline_fade(&tl, 4, 5.0, 2.0, 1.0, 0.0, anim.EASE_LINEAR)
    anim.timeline_show(&tl, 5, 6.0)
    anim.timeline_hide(&tl, 5, 8.0)
    var s: anim.NodeState = anim.NodeState {
        has_pos: false, pos: vec3.v3_zero(), has_opacity: false, opacity: 1.0, has_visible: false, visible: true,
    }
    anim.timeline_eval(&tl, 3, 1.0, &s)
    testkit.assert_true(s.has_visible && !s.visible, "not yet visible")
    anim.timeline_eval(&tl, 3, 2.5, &s)
    testkit.assert_true(s.visible && near(s.pos.y, 7.0) && near(s.pos.x, 1.0), "half way")
    testkit.assert_true(s.has_opacity && s.opacity > 0.0 && s.opacity < 1.0, "fading in")
    anim.timeline_eval(&tl, 3, 2.5, &s)
    testkit.assert_true(near(s.pos.y, 7.0), "same t same result")
    anim.timeline_eval(&tl, 3, 50.0, &s)
    testkit.assert_true(near(s.pos.y, 2.0) && near(s.opacity, 1.0), "landed")
    anim.timeline_eval(&tl, 4, 6.0, &s)
    testkit.assert_true(near(s.opacity, 0.5), "fade half")
    anim.timeline_eval(&tl, 5, 7.0, &s)
    testkit.assert_true(s.visible, "shown")
    anim.timeline_eval(&tl, 5, 9.0, &s)
    testkit.assert_true(!s.visible, "hidden")
    anim.timeline_eval(&tl, 99, 1.0, &s)
    testkit.assert_true(!s.has_pos && !s.has_opacity && !s.has_visible, "untouched node")
    testkit.assert_true(near(anim.timeline_end(&tl), 8.0), "end")
    anim.timeline_free(&tl)
}

#[test]
fn timeline_apply_scene() {
    var sc: scene.Scene = scene.scene_new()
    let a: i32 = scene.scene_add_node(&sc, -1)
    let b: i32 = scene.scene_add_node(&sc, -1)
    var tl: anim.Timeline = anim.timeline_new()
    anim.timeline_fly_in(&tl, a, vec3.v3(1.0, 0.0, 0.0), 1.0, 2.0, vec3.v3(0.0, 4.0, 0.0), true, anim.EASE_LINEAR)
    anim.timeline_show(&tl, b, 3.0)
    anim.timeline_apply(&tl, &sc, 0.0)
    testkit.assert_true(!(*scene.scene_node(&sc, a)).visible && !(*scene.scene_node(&sc, b)).visible, "hidden at 0")
    anim.timeline_apply(&tl, &sc, 2.0)
    testkit.assert_true((*scene.scene_node(&sc, a)).visible && near((*scene.scene_node(&sc, a)).pos.y, 2.0), "half way")
    anim.timeline_apply(&tl, &sc, 0.0)
    testkit.assert_true(!(*scene.scene_node(&sc, a)).visible, "pure: back to hidden")
    anim.timeline_apply(&tl, &sc, 4.0)
    testkit.assert_true(near((*scene.scene_node(&sc, a)).pos.y, 0.0) && (*scene.scene_node(&sc, b)).visible, "landed")
    anim.timeline_free(&tl)
    scene.scene_free(&sc)
}
