// expect_exit: 0
// tests/4123_lambda_method_arg.fi -- lambda sugar in METHOD-call arguments (r732): both compilers.
struct Acc {
    total: i32,
}

impl Acc {
    fn add_mapped(*mut self, f: fn(i32) -> i32, x: i32) {
        (*self).total = (*self).total + f(x)
    }
    fn combine(*mut self, f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 {
        let r: i32 = f(a, b)
        (*self).total = (*self).total + r
        return r
    }
    fn count(*mut self, f: fn() -> i32) -> i32 {
        return f()
    }
}

fn main() -> i32 {
    var acc: Acc = Acc { total: 0 }
    acc.add_mapped(|x| x * 3, 4)
    if acc.total != 12 { return 1 }
    let r: i32 = acc.combine(|a, b| a - b, 10, 4)
    if r != 6 || acc.total != 18 { return 2 }
    acc.add_mapped(|x| {
            let y: i32 = x + 1
            return y * 2
        }, 5)
    if acc.total != 30 { return 3 }
    if acc.count(|| 42) != 42 { return 4 }
    return 0
}
