// expect_exit: 0
enum Opt[T] { Some(T), None }

impl Opt[T] {
    fn unwrap_or(*self, d: T) -> T {
        match *self {
            Opt::Some(v) => { return v }
            Opt::None => { return d }
        }
        return d
    }
    fn is_some(*self) -> bool {
        match *self {
            Opt::Some(_) => { return true }
            Opt::None => { return false }
        }
        return false
    }
}

fn main() -> i32 {
    let a: Opt[i32] = Opt::Some(5)
    let b: Opt[u8] = Opt::None
    if a.unwrap_or(1) != 5 { return 1 }
    if b.unwrap_or(7 as u8) != 7 as u8 { return 2 }
    if !a.is_some() { return 3 }
    if b.is_some() { return 4 }
    return 0
}
