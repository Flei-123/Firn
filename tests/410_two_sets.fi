// expect_exit: 0
// Two error sets side by side; the codes start at 1 in each set.
error Read { End, Broken }
error Write { Full }

fn read(n: i32) -> Read!i32 {
    if n == 0 {
        return Read::End
    }
    if n < 0 {
        return Read::Broken
    }
    return n
}

fn write(n: i32) -> Write!i32 {
    if n > 100 {
        return Write::Full
    }
    return n
}

fn main() -> i32 {
    if (read(4) catch 0) != 4 {
        return 1
    }
    if (read(0) catch 0 - 1) != 0 - 1 {
        return 2
    }
    if (write(101) catch 0 - 2) != 0 - 2 {
        return 3
    }
    if (write(9) catch 0) != 9 {
        return 4
    }
    return 0
}
