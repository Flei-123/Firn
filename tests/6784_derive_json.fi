// expect_exit: 0
// firnc1_skip: derive(Json) is implemented in firnc0 only
#[derive(Json)]
struct P { x: i32, name: str, ok: bool, f: f64 }

#[derive(Json)]
struct Outer { p: P, n: u8 }

#[derive(Json)]
struct Pair[A, B] { first: A, second: B }

#[derive(Json)]
enum Shape { Dot, Line(i32, i32), Tag(str) }

#[derive(Json)]
enum Opt[T] { Some(T), None }

fn main() -> i32 {
    if !gc_init() { return 99 }
    let a = P { x: 1, name: "a\"b", ok: true, f: 1.5 }
    if a.to_json() != "{\"x\":1,\"name\":\"a\\\"b\",\"ok\":true,\"f\":1.5}" { return 1 }
    let o = Outer { p: a, n: 7 as u8 }
    if o.to_json() != "{\"p\":{\"x\":1,\"name\":\"a\\\"b\",\"ok\":true,\"f\":1.5},\"n\":7}" { return 2 }
    let pr = Pair[i32, bool] { first: 3, second: false }
    if pr.to_json() != "{\"first\":3,\"second\":false}" { return 3 }
    let d = Shape::Dot
    if d.to_json() != "\"Dot\"" { return 4 }
    let l = Shape::Line(1, 2)
    if l.to_json() != "{\"Line\":[1,2]}" { return 5 }
    let t = Shape::Tag("z")
    if t.to_json() != "{\"Tag\":[\"z\"]}" { return 6 }
    let s: Opt[i32] = Opt::Some(9)
    let n: Opt[i32] = Opt::None
    if s.to_json() != "{\"Some\":[9]}" { return 7 }
    if n.to_json() != "\"None\"" { return 8 }
    return 0
}
