// expect_exit: 42
// tests/1931_fui_cmdbar.fi -- lib/fui/cmdbar.fi: how many commands stay in the bar, where the groups part,
// what the tooltip says -- the model of the command bar, integers only.
import fui.cmdbar
import std.rt

fn same(p: *mut u8, want: str) -> bool {
    var i: usize = 0
    while i < want.n {
        if *((p as u64 + i as u64) as *mut u8) != *((want.p as u64 + i as u64) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return *((p as u64 + want.n as u64) as *mut u8) == 0 as u8
}

fn main() -> i32 {
    // eight items of 32, gaps of 4, a group start at items 3 and 6 (12 each)
    var seps: [u8; 8] = [0 as u8; 8]
    seps[3 as usize] = 1 as u8
    seps[6 as usize] = 1 as u8
    let sp: u64 = (&seps[0]) as u64
    // 8 * 32 + 7 * 4 + 2 * 12 = 308
    if cmdbar.bar_width(8, sp, 32, 4, 12) != 308 { return 1 as i32 }
    if cmdbar.bar_width(0, sp, 32, 4, 12) != 0 { return 2 as i32 }
    if cmdbar.bar_width(1, sp, 32, 4, 12) != 32 { return 3 as i32 }
    // 3 items: 96 + 8 = 104 (no separator among the first three)
    if cmdbar.bar_width(3, sp, 32, 4, 12) != 104 { return 4 as i32 }
    // 4 items: 128 + 12 + 12 = 152
    if cmdbar.bar_width(4, sp, 32, 4, 12) != 152 { return 5 as i32 }
    // everything fits
    if cmdbar.fit_count(8, sp, 308, 32, 4, 12) != 8 { return 6 as i32 }
    if cmdbar.fit_count(8, sp, 400, 32, 4, 12) != 8 { return 7 as i32 }
    // one point too narrow: the overflow button costs 36 (a gap and an item); 6 items are 224, 7 are 272
    if cmdbar.fit_count(8, sp, 307, 32, 4, 12) != 6 { return 8 as i32 }
    if cmdbar.fit_count(8, sp, 260, 32, 4, 12) != 6 { return 9 as i32 }
    if cmdbar.fit_count(8, sp, 259, 32, 4, 12) != 5 { return 10 as i32 }
    if cmdbar.fit_count(8, sp, 223, 32, 4, 12) != 4 { return 17 as i32 }
    if cmdbar.fit_count(8, sp, 187, 32, 4, 12) != 3 { return 18 as i32 }
    // very narrow: only the overflow button (36), or not even that
    if cmdbar.fit_count(8, sp, 40, 32, 4, 12) != 0 { return 11 as i32 }
    if cmdbar.fit_count(8, sp, 0, 32, 4, 12) != 0 { return 12 as i32 }
    // the tooltip
    var b: [u8; 40] = [0 as u8; 40]
    let o: *mut u8 = (&b[0]) as *mut u8
    var lab: [u8; 5] = "Copy\0"
    var sc: [u8; 7] = "Ctrl+C\0"
    var none: [u8; 1] = "\0"
    let n1: u64 = cmdbar.tip_text((&lab[0]) as u64, (&sc[0]) as u64, o as u64, 40)
    if n1 != 13 || !same(o, "Copy (Ctrl+C)") { return 13 as i32 }
    let n2: u64 = cmdbar.tip_text((&lab[0]) as u64, 0, o as u64, 40)
    if n2 != 4 || !same(o, "Copy") { return 14 as i32 }
    let n3: u64 = cmdbar.tip_text((&lab[0]) as u64, (&none[0]) as u64, o as u64, 40)
    if n3 != 4 || !same(o, "Copy") { return 15 as i32 }
    // a small buffer never overflows and stays terminated
    var s: [u8; 8] = [0 as u8; 8]
    let n4: u64 = cmdbar.tip_text((&lab[0]) as u64, (&sc[0]) as u64, (&s[0]) as u64, 8)
    if n4 > 7 || s[7 as usize] != 0 as u8 && s[n4 as usize] != 0 as u8 { return 16 as i32 }
    return 42 as i32
}
