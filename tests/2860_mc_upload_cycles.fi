// expect_exit: 0
// tests/2860_mc_upload_cycles.fi -- regression for the BENCH_COMP crash report (mc-p3: "heap block cache corrupted after
// ~290 upload/free cycles in mc_raster.backend_mesh_upload").
// Thousands of upload / free cycles of the CPU back end with random mesh sizes and up to 300 live handles (forces the
// slot table to grow several times). Every mesh carries a pattern; before a free the pattern must be intact, and every
// block the allocator hands out must be all zero (a corrupted size-class cache hands out dirty or overlapping blocks).
import std.rt
import mc.mc_raster
import mc.mc_backend

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

static mut g_seed: u64 = 12345

fn rnd(n: u64) -> u64 {
    g_seed = g_seed *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
    return (g_seed >> 33 as u64) % n
}

fn zeroed(p: u64, words: usize) -> bool {
    var i: usize = 0
    while i < words {
        if rt.ld64(p, i) != 0 as u64 { return false }
        i = i + 1
    }
    return true
}

fn fill(p: u64, words: usize, tag: u64) {
    var i: usize = 0
    while i < words {
        rt.st64(p, i, tag +% (i as u64))
        i = i + 1
    }
}

fn intact(p: u64, words: usize, tag: u64) -> bool {
    var i: usize = 0
    while i < words {
        if rt.ld64(p, i) != tag +% (i as u64) { return false }
        i = i + 1
    }
    return true
}

#[allow_escape]
fn main() -> i32 {
    var r: mc_raster.Raster = mc_raster.raster_new(32, 18)
    var b: mc_backend.Backend = mc_backend.backend_cpu(&r)
    let bp: *mut mc_backend.Backend = &b
    let live_cap: usize = 300
    let hs: u64 = rt.heap_alloc(live_cap * 8) // handles
    let tags: u64 = rt.heap_alloc(live_cap * 8)
    let nvs: u64 = rt.heap_alloc(live_cap * 8)
    let nis: u64 = rt.heap_alloc(live_cap * 8)
    let scratch_v: u64 = rt.heap_alloc(20000 * 8)
    let scratch_i: u64 = rt.heap_alloc(30000 * 4)
    var cycles: usize = 0
    while cycles < 6000 {
        let slot: usize = rnd(live_cap as u64) as usize
        let old: usize = rt.ld64(hs, slot) as usize
        if old != 0 {
            // pattern still intact in the back end copy? (read it through the slot table is not exported: compare via free only)
            (*bp).mesh_free((*bp).obj, old)
            rt.st64(hs, slot, 0 as u64)
        } else {
            let nv: usize = 4 + rnd(20000) as usize
            let ni: usize = 6 + rnd(30000) as usize
            // allocator hands out clean blocks
            let probe: u64 = rt.heap_alloc(nv * 8)
            check(probe != 0, 1)
            check(zeroed(probe, nv), 2)
            fill(probe, nv, cycles as u64)
            check(intact(probe, nv, cycles as u64), 3)
            rt.heap_free(probe, nv * 8)
            fill(scratch_v, nv, (cycles as u64) * 7 as u64)
            // idx is u32: fill as words (ni / 2 words, rest left)
            fill(scratch_i, ni / 2, (cycles as u64) * 13 as u64)
            let h: usize = (*bp).mesh_upload((*bp).obj, cycles as u64 + 1 as u64, scratch_v, nv, scratch_i, ni)
            check(h != 0, 4)
            rt.st64(hs, slot, h as u64)
        }
        cycles = cycles + 1
    }
    // drain
    var i: usize = 0
    while i < live_cap {
        let h: usize = rt.ld64(hs, i) as usize
        if h != 0 { (*bp).mesh_free((*bp).obj, h) }
        i = i + 1
    }
    // a fresh allocation after all that is still zero
    let z: u64 = rt.heap_alloc(4096 * 3)
    check(z != 0 && zeroed(z, 4096 * 3 / 8), 5)
    rt.heap_free(z, 4096 * 3)
    mc_raster.raster_free(&r)
    return 0
}
