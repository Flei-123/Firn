fn check(b: *mut Bytes, ws: *mut u8) {
    var used: usize = 0
    let bits: u64 = strtod((*b).ptr, (*b).len, ws, &used)
    print_num(bits)
}

fn check_last(b: *mut Bytes, ws: *mut u8) {
    var used: usize = 0
    let bits: u64 = strtod((*b).ptr, (*b).len, ws, &used)
    print_num_nl(bits)
}

fn main() -> i32 {
    let ws: *mut u8 = heap_alloc(STRTOD_WS_BYTES)
    var b: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&b)
    text_a(&b)
    check(&b, ws)
    text_b(&b)
    check(&b, ws)
    text_c(&b)
    check(&b, ws)
    text_d(&b)
    check(&b, ws)
    text_e(&b)
    check(&b, ws)
    text_f(&b)
    check(&b, ws)
    text_g(&b)
    check(&b, ws)
