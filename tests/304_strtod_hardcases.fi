    pruef(&b, ws)
    text_k(&b)
    pruef(&b, ws)
    text_l(&b)
    pruef(&b, ws)
    text_m(&b)
    pruef(&b, ws)
    text_n(&b)
    pruef(&b, ws)
    text_o(&b)
    pruef(&b, ws)
    text_p(&b)
    pruef(&b, ws)
    text_q(&b)
    pruef(&b, ws)
    text_r(&b)
    pruef(&b, ws)
    text_s(&b)
    pruef(&b, ws)
    text_t(&b)
    pruef(&b, ws)
    text_u(&b)
    pruef(&b, ws)
    text_v(&b)
    pruef(&b, ws)
    text_w(&b)
    pruef(&b, ws)
    text_x(&b)
    pruef(&b, ws)
    text_y(&b)
    pruef(&b, ws)
    text_z(&b)
    pruef_last(&b, ws)
    bytes_free(&b)
    return 0
}
