fn pruef(b: *mut Bytes, ws: *mut u8) {
    var used: usize = 0
    let bits: u64 = strtod((*b).ptr, (*b).len, ws, &used)
    print_num(bits)
}

fn pruef_last(b: *mut Bytes, ws: *mut u8) {
    var used: usize = 0
    let bits: u64 = strtod((*b).ptr, (*b).len, ws, &used)
    print_num_nl(bits)
}

fn main() -> i32 {
    let ws: *mut u8 = heap_alloc(STRTOD_WS_BYTES)
    var b: Bytes = Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&b)
    text_a(&b)
    pruef(&b, ws)
    text_b(&b)
    pruef(&b, ws)
    text_c(&b)
    pruef(&b, ws)
    text_d(&b)
    pruef(&b, ws)
    text_e(&b)
    pruef(&b, ws)
    text_f(&b)
    pruef(&b, ws)
    text_g(&b)
    pruef(&b, ws)
    text_h(&b)
    pruef(&b, ws)
    text_i(&b)
    pruef(&b, ws)
