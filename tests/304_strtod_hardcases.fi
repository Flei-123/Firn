    check(&b, ws)
    text_l(&b)
    check(&b, ws)
    text_m(&b)
    check(&b, ws)
    text_n(&b)
    check(&b, ws)
    text_o(&b)
    check(&b, ws)
    text_p(&b)
    check(&b, ws)
    text_q(&b)
    check(&b, ws)
    text_r(&b)
    check(&b, ws)
    text_s(&b)
    check(&b, ws)
    text_t(&b)
