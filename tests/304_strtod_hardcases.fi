    text_u(&b)
    check(&b, ws)
    text_v(&b)
    check(&b, ws)
    text_w(&b)
    check(&b, ws)
    text_x(&b)
    check(&b, ws)
    text_y(&b)
    check(&b, ws)
    text_z(&b)
    check_last(&b, ws)
    bytes_free(&b)
    return 0
}
