// expect_exit: 0
import std.rt
import mc.cmd.cmd_wire as cw

static mut g_fail: i32 = 0

fn check(ok: bool, msg: str) {
    if !ok {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_bytes(&o, msg.p as u64, msg.n)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn main() -> i32 {
    let table: str = "brigadier:integer=3\nminecraft:gamemode=39\nminecraft:time=40\n"
    check(cw.parser_id(table, "brigadier:integer") == 3, "first parser id")
    check(cw.parser_id(table, "minecraft:gamemode") == 39, "middle parser id")
    check(cw.parser_id(table, "minecraft:time") == 40, "last parser id")
    check(cw.parser_id(table, "minecraft:missing") == 0 - 1, "unknown parser")
    check(cw.parser_id(table, "minecraft:gamemod") == 0 - 1, "prefix is not a match")
    let json: str = "{\"type\":\"root\",\"children\":{\"a\":{\"type\":\"literal\",\"children\":{\"n\":{\"type\":\"argument\",\"executable\":true,\"parser\":\"brigadier:integer\",\"properties\":{\"min\":1,\"max\":5}},\"g\":{\"type\":\"argument\",\"executable\":true,\"parser\":\"minecraft:gamemode\"}}}}}"
    var out: rt.Buf = rt.buf_new()
    check(cw.wire_declare(json.p as u64, json.n, table, &out), "wire_declare succeeds")
    let want: [u8; 36] = [4, 0, 1, 1, 1, 2, 2, 3, 1, 97, 6, 0, 1, 110, 3, 3, 0, 0, 0, 1, 0, 0, 0, 5, 6, 0, 1, 103, 39, 0, 0, 0, 0, 0, 0, 0]
    check(rt.buf_len(&out) == 30, "body length")
    var i: usize = 0
    var same: bool = true
    while i < 30 && i < rt.buf_len(&out) {
        if rt.ld8(rt.buf_ptr(&out), i) != want[i] {
            same = false
        }
        i = i + 1
    }
    check(same, "body bytes")
    rt.buf_free(&out)
    return g_fail
}
