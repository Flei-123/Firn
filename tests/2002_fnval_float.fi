// expect_exit: 0
// ROUND HOSTS2 (r113) -- FLOATING POINT THROUGH A FUNCTION VALUE.
//
// A call through a `fn(..)` value (Op::CallIndirect) must place its
// arguments like a direct call: integers in rdi.., floating point in
// xmm0.., the rest on the stack, and a floating point result comes back in
// xmm0. The register allocated path counted every argument as an integer
// and returned every result in rax; at `dev` the base path was right, and a
// callee that read xmm0..xmm3 saw the values the CALLER happened to leave
// there. Found on Android (x86_64 emulator): the clear colour of
// lib/plat/gles.fi, `fn(f64, f64, f64, f64)` behind the GL table, arrived
// as (b, 0, 0, 0) and the background kept the old texture.
//
// The arguments are COMPUTED in the caller (so they live in allocated
// registers and spill slots, which is what broke), and the callee is called
// through a struct field after the inliner folded the wrapper.

static mut G: [f64; 4] = [0.0; 4]
static mut H: [f64; 9] = [0.0; 9]

struct Api {
    cc: fn(f64, f64, f64, f64),
    mix: fn(i32, f64, i32, f64) -> f64,
    nine: fn(f64, f64, f64, f64, f64, f64, f64, f64, f64),
    half: fn(f64) -> f64,
}

fn set(r: f64, g: f64, b: f64, a: f64) {
    G[0] = r
    G[1] = g
    G[2] = b
    G[3] = a
}

fn mix(i: i32, x: f64, j: i32, y: f64) -> f64 {
    return (i as f64) * 1000.0 + x * 100.0 + (j as f64) * 10.0 + y
}

fn nine(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64, i: f64) {
    H[0] = a
    H[1] = b
    H[2] = c
    H[3] = d
    H[4] = e
    H[5] = f
    H[6] = g
    H[7] = h
    H[8] = i
}

fn half(x: f64) -> f64 { return x / 2.0 }

fn fwd(t: *mut Api, r: f64, g0: f64, b0: f64, a0: f64) { (*t).cc(r, g0, b0, a0) }

fn clear(t: *mut Api, col: u32) {
    let al: f64 = ((col >> 24) & 255 as u32) as f64 / 255.0
    fwd(t, ((col >> 16) & 255 as u32) as f64 / 255.0 * al,
        ((col >> 8) & 255 as u32) as f64 / 255.0 * al,
        (col & 255 as u32) as f64 / 255.0 * al, al)
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d < 0.0001
}

fn main(start: u64) -> i32 {
    var api: Api = Api { cc: set, mix: mix, nine: nine, half: half }
    let p: *mut Api = &api
    // 0xFFECF6F7: r = 236, g = 246, b = 247, alpha 255
    clear(p, 4293719799 as u32)
    if !near(G[0], 236.0 / 255.0) { return 1 }
    if !near(G[1], 246.0 / 255.0) { return 2 }
    if !near(G[2], 247.0 / 255.0) { return 3 }
    if !near(G[3], 1.0) { return 4 }
    // integers and floats mixed: each class counts on its own
    let m: f64 = (*p).mix(3, 1.5, 4, 0.25)
    if !near(m, 3000.0 + 150.0 + 40.0 + 0.25) { return 5 }
    // more floats than xmm registers: the ninth goes over the stack
    var k: f64 = 1.0
    (*p).nine(k, k + 1.0, k + 2.0, k + 3.0, k + 4.0, k + 5.0, k + 6.0, k + 7.0, k + 8.0)
    var n: usize = 0
    while n < 9 {
        if !near(H[n], 1.0 + n as f64) { return 6 }
        n = n + 1
    }
    // a floating point result
    if !near((*p).half(k + 6.0), 3.5) { return 7 }
    return 0
}
