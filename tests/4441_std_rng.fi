// expect_exit: 0
// tests/4441_std_rng.fi -- std.rng is bit-exact with CPython 3.11
// `random.Random(seed)`: random(), getrandbits, randint, randrange, shuffle,
// choice, sample (pool and set branch), randbytes, uniform; gauss and
// expovariate to 1e-9. Expected numbers were printed by CPython 3.11
// (tools/libs_py_cross/random_gen.py regenerates this file's cases). Also
// distribution sanity, empty-input behaviour and a crypto.random coexist test.
import std.io
import std.rt
import std.vec
import std.rng
import std.crypto.random
import std.testkit

fn same(v: *mut Vec[i64], p: u64, n: usize) -> bool {
    if vec_len[i64](v) != n { return false }
    var i: usize = 0
    while i < n {
        if vec_at[i64](v, i) != *((p + (i as u64) * 8) as *i64) { return false }
        i = i + 1
    }
    return true
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = -d }
    var m: f64 = b
    if m < 0.0 { m = -m }
    if m < 1.0 { m = 1.0 }
    return d <= 1e-9 * m
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    {
        var r: rng.Rng = rng.new(0)
        var i: usize = 0
        let f: [f64; 3] = [0.8444218515250481, 0.7579544029403025, 0.420571580830845]
        var ok: bool = true
        while i < 3 { if rng.random(&r) != f[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 0: random()")
        let ks: [u32; 7] = [1, 7, 31, 32, 33, 53, 64]
        let bits: [u64; 7] = [0, 123, 1097954097, 2087043557, 6034146168, 7474650915735097, 17852758786694309641]
        ok = true
        i = 0
        while i < 7 { if rng.getrandbits(&r, ks[i]) != bits[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 0: getrandbits")
        let ints: [i64; 6] = [2, 0, 4, 957413342, 975078788, 619073466650]
        ok = rng.randint(&r, -5, 5) == ints[0] && rng.randint(&r, -5, 5) == ints[1] && rng.randint(&r, -5, 5) == ints[2]
        ok = ok && rng.randrange(&r, 0, 1000000007) == ints[3] && rng.randrange(&r, 0, 1000000007) == ints[4]
        ok = ok && rng.randint(&r, 0, 1099511627776) == ints[5]
        testkit.check(ok, "seed 0: randint / randrange")
        var v: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 20 { vec_push[i64](&v, i as i64); i = i + 1 }
        rng_shuffle[i64](&r, &v)
        let shw: [i64; 20] = [0, 13, 16, 15, 6, 18, 2, 12, 17, 7, 5, 10, 14, 11, 1, 9, 19, 8, 3, 4]
        testkit.check(same(&v, (&shw[0]) as u64, 20), "seed 0: shuffle")
        var src: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 100 { vec_push[i64](&src, i as i64); i = i + 1 }
        let c0: i64 = *rng_choice[i64](&r, &src)
        let c1: i64 = *rng_choice[i64](&r, &src)
        testkit.check(c0 == 56 && c1 == 66, "seed 0: choice")
        var big: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 1000 { vec_push[i64](&big, i as i64); i = i + 1 }
        var o: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &big, 30, &o)
        let saw: [i64; 30] = [266, 63, 824, 940, 561, 937, 14, 95, 736, 860, 408, 727, 844, 803, 684, 640, 1, 626, 505, 847, 888, 341, 249, 747, 333, 720, 891, 64, 195, 939]
        testkit.check(same(&o, (&saw[0]) as u64, 30), "seed 0: sample (set branch)")
        var mid: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 30 { vec_push[i64](&mid, i as i64); i = i + 1 }
        var o2: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &mid, 7, &o2)
        let sbw: [i64; 7] = [18, 7, 28, 25, 4, 17, 14]
        testkit.check(same(&o2, (&sbw[0]) as u64, 7), "seed 0: sample (pool branch)")
        var sm: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 10 { vec_push[i64](&sm, i as i64); i = i + 1 }
        var o3: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &sm, 3, &o3)
        let scw: [i64; 3] = [1, 9, 5]
        testkit.check(same(&o3, (&scw[0]) as u64, 3), "seed 0: sample small")
        var bb: [u8; 7] = [0; 7]
        rng.randbytes(&r, (&bb[0]) as u64, 7)
        let wb: [u8; 7] = [96, 184, 5, 224, 101, 8, 130]
        ok = true
        i = 0
        while i < 7 { if bb[i] != wb[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 0: randbytes(7)")
        let g: [f64; 3] = [1.1591703297045104, -0.014773982665667582, -0.26348752277697873]
        ok = near(rng.gauss(&r, 0.0, 1.0), g[0]) && near(rng.gauss(&r, 0.0, 1.0), g[1]) && near(rng.gauss(&r, 0.0, 1.0), g[2])
        testkit.check(ok, "seed 0: gauss x3")
        testkit.check(near(rng.expovariate(&r, 2.5), 0.05332603595213673), "seed 0: expovariate")
        testkit.check(rng.uniform(&r, 2.0, 5.0) == 2.9982515383020085, "seed 0: uniform")
        testkit.check(rng.next_u32(&r) as u64 == 3961032443, "seed 0: stream still in sync")
        vec_free[i64](&v); vec_free[i64](&src); vec_free[i64](&big); vec_free[i64](&o); vec_free[i64](&mid); vec_free[i64](&o2); vec_free[i64](&sm); vec_free[i64](&o3)
    }
    {
        var r: rng.Rng = rng.new(1)
        var i: usize = 0
        let f: [f64; 3] = [0.13436424411240122, 0.8474337369372327, 0.763774618976614]
        var ok: bool = true
        while i < 3 { if rng.random(&r) != f[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 1: random()")
        let ks: [u32; 7] = [1, 7, 31, 32, 33, 53, 64]
        let bits: [u64; 7] = [0, 15, 1063938749, 3268308804, 1930549411, 3419269212589083, 3872982626502034966]
        ok = true
        i = 0
        while i < 7 { if rng.getrandbits(&r, ks[i]) != bits[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 1: getrandbits")
        let ints: [i64; 6] = [-4, 2, -5, 959191865, 897395948, 950861988493]
        ok = rng.randint(&r, -5, 5) == ints[0] && rng.randint(&r, -5, 5) == ints[1] && rng.randint(&r, -5, 5) == ints[2]
