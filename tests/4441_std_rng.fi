        var o: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &big, 30, &o)
        let saw: [i64; 30] = [867, 352, 618, 270, 826, 44, 747, 470, 549, 127, 996, 944, 387, 80, 565, 300, 849, 643, 633, 906, 882, 370, 591, 196, 721, 71, 46, 677, 233, 791]
        testkit.check(same(&o, (&saw[0]) as u64, 30), "seed 42: sample (set branch)")
        var mid: Vec[i64] = vec_new[i64]()
