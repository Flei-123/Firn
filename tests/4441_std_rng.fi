        testkit.check(rng.uniform(&r, 2.0, 5.0) == 2.728219920629203, "seed 1: uniform")
        testkit.check(rng.next_u32(&r) as u64 == 3424825176, "seed 1: stream still in sync")
        vec_free[i64](&v); vec_free[i64](&src); vec_free[i64](&big); vec_free[i64](&o); vec_free[i64](&mid); vec_free[i64](&o2); vec_free[i64](&sm); vec_free[i64](&o3)
