        let shw: [i64; 20] = [14, 8, 3, 11, 10, 16, 1, 12, 5, 18, 2, 0, 4, 9, 15, 7, 13, 19, 6, 17]
        testkit.check(same(&v, (&shw[0]) as u64, 20), "seed 42: shuffle")
