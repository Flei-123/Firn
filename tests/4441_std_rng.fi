        let shw: [i64; 20] = [3, 19, 0, 16, 2, 18, 6, 14, 7, 11, 12, 9, 13, 4, 5, 1, 17, 8, 15, 10]
        testkit.check(same(&v, (&shw[0]) as u64, 20), "seed 18446744073709551615: shuffle")
        var src: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 100 { vec_push[i64](&src, i as i64); i = i + 1 }
        let c0: i64 = *rng_choice[i64](&r, &src)
        let c1: i64 = *rng_choice[i64](&r, &src)
        testkit.check(c0 == 41 && c1 == 10, "seed 18446744073709551615: choice")
        var big: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 1000 { vec_push[i64](&big, i as i64); i = i + 1 }
        var o: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &big, 30, &o)
        let saw: [i64; 30] = [511, 482, 186, 111, 16, 144, 816, 603, 779, 944, 450, 257, 702, 634, 42, 278, 832, 860, 630, 275, 12, 129, 453, 540, 534, 962, 452, 297, 17, 494]
        testkit.check(same(&o, (&saw[0]) as u64, 30), "seed 18446744073709551615: sample (set branch)")
        var mid: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 30 { vec_push[i64](&mid, i as i64); i = i + 1 }
        var o2: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &mid, 7, &o2)
        let sbw: [i64; 7] = [10, 24, 21, 9, 0, 25, 29]
        testkit.check(same(&o2, (&sbw[0]) as u64, 7), "seed 18446744073709551615: sample (pool branch)")
        var sm: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 10 { vec_push[i64](&sm, i as i64); i = i + 1 }
        var o3: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &sm, 3, &o3)
        let scw: [i64; 3] = [0, 9, 6]
        testkit.check(same(&o3, (&scw[0]) as u64, 3), "seed 18446744073709551615: sample small")
        var bb: [u8; 7] = [0; 7]
        rng.randbytes(&r, (&bb[0]) as u64, 7)
        let wb: [u8; 7] = [151, 115, 206, 89, 25, 77, 58]
        ok = true
        i = 0
        while i < 7 { if bb[i] != wb[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 18446744073709551615: randbytes(7)")
        let g: [f64; 3] = [-0.4060218342275647, -0.5328501065323853, -1.911837233694007]
        ok = near(rng.gauss(&r, 0.0, 1.0), g[0]) && near(rng.gauss(&r, 0.0, 1.0), g[1]) && near(rng.gauss(&r, 0.0, 1.0), g[2])
        testkit.check(ok, "seed 18446744073709551615: gauss x3")
        testkit.check(near(rng.expovariate(&r, 2.5), 0.06022045773813649), "seed 18446744073709551615: expovariate")
        testkit.check(rng.uniform(&r, 2.0, 5.0) == 2.6702492807471634, "seed 18446744073709551615: uniform")
        testkit.check(rng.next_u32(&r) as u64 == 3526975876, "seed 18446744073709551615: stream still in sync")
        vec_free[i64](&v); vec_free[i64](&src); vec_free[i64](&big); vec_free[i64](&o); vec_free[i64](&mid); vec_free[i64](&o2); vec_free[i64](&sm); vec_free[i64](&o3)
    }
    {
        var r: rng.Rng = rng.new(123456789012)
        var i: usize = 0
        let f: [f64; 3] = [0.37701448538609916, 0.02069602357922562, 0.14040538980009454]
        var ok: bool = true
        while i < 3 { if rng.random(&r) != f[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 123456789012: random()")
        let ks: [u32; 7] = [1, 7, 31, 32, 33, 53, 64]
        let bits: [u64; 7] = [0, 18, 1775984420, 3313889473, 1927485172, 7868405621264615, 7230832704125269395]
        ok = true
        i = 0
        while i < 7 { if rng.getrandbits(&r, ks[i]) != bits[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 123456789012: getrandbits")
        let ints: [i64; 6] = [1, 3, -2, 199311403, 391879277, 597215752718]
        ok = rng.randint(&r, -5, 5) == ints[0] && rng.randint(&r, -5, 5) == ints[1] && rng.randint(&r, -5, 5) == ints[2]
        ok = ok && rng.randrange(&r, 0, 1000000007) == ints[3] && rng.randrange(&r, 0, 1000000007) == ints[4]
        ok = ok && rng.randint(&r, 0, 1099511627776) == ints[5]
        testkit.check(ok, "seed 123456789012: randint / randrange")
        var v: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 20 { vec_push[i64](&v, i as i64); i = i + 1 }
        rng_shuffle[i64](&r, &v)
        let shw: [i64; 20] = [17, 14, 1, 12, 9, 5, 7, 6, 13, 8, 19, 18, 0, 11, 15, 2, 3, 16, 10, 4]
        testkit.check(same(&v, (&shw[0]) as u64, 20), "seed 123456789012: shuffle")
        var src: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 100 { vec_push[i64](&src, i as i64); i = i + 1 }
        let c0: i64 = *rng_choice[i64](&r, &src)
        let c1: i64 = *rng_choice[i64](&r, &src)
        testkit.check(c0 == 13 && c1 == 58, "seed 123456789012: choice")
        var big: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 1000 { vec_push[i64](&big, i as i64); i = i + 1 }
        var o: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &big, 30, &o)
        let saw: [i64; 30] = [624, 104, 780, 497, 52, 816, 154, 664, 751, 150, 688, 98, 676, 452, 26, 858, 597, 758, 285, 770, 136, 201, 800, 851, 666, 805, 686, 374, 429, 27]
        testkit.check(same(&o, (&saw[0]) as u64, 30), "seed 123456789012: sample (set branch)")
        var mid: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 30 { vec_push[i64](&mid, i as i64); i = i + 1 }
        var o2: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &mid, 7, &o2)
        let sbw: [i64; 7] = [16, 23, 13, 10, 21, 5, 14]
        testkit.check(same(&o2, (&sbw[0]) as u64, 7), "seed 123456789012: sample (pool branch)")
        var sm: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 10 { vec_push[i64](&sm, i as i64); i = i + 1 }
        var o3: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &sm, 3, &o3)
        let scw: [i64; 3] = [8, 0, 5]
        testkit.check(same(&o3, (&scw[0]) as u64, 3), "seed 123456789012: sample small")
        var bb: [u8; 7] = [0; 7]
        rng.randbytes(&r, (&bb[0]) as u64, 7)
        let wb: [u8; 7] = [221, 186, 153, 47, 30, 153, 203]
        ok = true
        i = 0
        while i < 7 { if bb[i] != wb[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 123456789012: randbytes(7)")
        let g: [f64; 3] = [0.6985519411599015, 0.3727095048210776, 0.9648838236726439]
        ok = near(rng.gauss(&r, 0.0, 1.0), g[0]) && near(rng.gauss(&r, 0.0, 1.0), g[1]) && near(rng.gauss(&r, 0.0, 1.0), g[2])
        testkit.check(ok, "seed 123456789012: gauss x3")
        testkit.check(near(rng.expovariate(&r, 2.5), 0.3436849528044138), "seed 123456789012: expovariate")
        testkit.check(rng.uniform(&r, 2.0, 5.0) == 2.2780587650570356, "seed 123456789012: uniform")
        testkit.check(rng.next_u32(&r) as u64 == 2423707269, "seed 123456789012: stream still in sync")
        vec_free[i64](&v); vec_free[i64](&src); vec_free[i64](&big); vec_free[i64](&o); vec_free[i64](&mid); vec_free[i64](&o2); vec_free[i64](&sm); vec_free[i64](&o3)
    }
    {
        var r: rng.Rng = rng.new(31337)
        var i: usize = 0
        let f: [f64; 3] = [0.6799777634765871, 0.170737440152662, 0.949129757244903]
        var ok: bool = true
        while i < 3 { if rng.random(&r) != f[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 31337: random()")
        let ks: [u32; 7] = [1, 7, 31, 32, 33, 53, 64]
        let bits: [u64; 7] = [0, 26, 1775542331, 772076153, 1351411756, 3832788248123512, 10841046188321773691]
        ok = true
        i = 0
        while i < 7 { if rng.getrandbits(&r, ks[i]) != bits[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 31337: getrandbits")
        let ints: [i64; 6] = [0, 0, -3, 7295935, 86702525, 410729249105]
        ok = rng.randint(&r, -5, 5) == ints[0] && rng.randint(&r, -5, 5) == ints[1] && rng.randint(&r, -5, 5) == ints[2]
        ok = ok && rng.randrange(&r, 0, 1000000007) == ints[3] && rng.randrange(&r, 0, 1000000007) == ints[4]
        ok = ok && rng.randint(&r, 0, 1099511627776) == ints[5]
        testkit.check(ok, "seed 31337: randint / randrange")
        var v: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 20 { vec_push[i64](&v, i as i64); i = i + 1 }
        rng_shuffle[i64](&r, &v)
        let shw: [i64; 20] = [11, 1, 19, 18, 7, 10, 6, 9, 17, 8, 12, 3, 13, 16, 2, 15, 5, 14, 4, 0]
        testkit.check(same(&v, (&shw[0]) as u64, 20), "seed 31337: shuffle")
        var src: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 100 { vec_push[i64](&src, i as i64); i = i + 1 }
        let c0: i64 = *rng_choice[i64](&r, &src)
        let c1: i64 = *rng_choice[i64](&r, &src)
        testkit.check(c0 == 23 && c1 == 56, "seed 31337: choice")
        var big: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 1000 { vec_push[i64](&big, i as i64); i = i + 1 }
        var o: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &big, 30, &o)
        let saw: [i64; 30] = [369, 723, 747, 406, 79, 522, 517, 95, 402, 488, 686, 986, 922, 242, 478, 907, 788, 1, 805, 130, 660, 248, 59, 3, 52, 542, 748, 259, 943, 989]
        testkit.check(same(&o, (&saw[0]) as u64, 30), "seed 31337: sample (set branch)")
        var mid: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 30 { vec_push[i64](&mid, i as i64); i = i + 1 }
        var o2: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &mid, 7, &o2)
        let sbw: [i64; 7] = [6, 5, 18, 1, 7, 10, 21]
        testkit.check(same(&o2, (&sbw[0]) as u64, 7), "seed 31337: sample (pool branch)")
        var sm: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 10 { vec_push[i64](&sm, i as i64); i = i + 1 }
        var o3: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &sm, 3, &o3)
        let scw: [i64; 3] = [4, 2, 6]
        testkit.check(same(&o3, (&scw[0]) as u64, 3), "seed 31337: sample small")
        var bb: [u8; 7] = [0; 7]
        rng.randbytes(&r, (&bb[0]) as u64, 7)
        let wb: [u8; 7] = [109, 184, 200, 11, 132, 196, 90]
        ok = true
        i = 0
        while i < 7 { if bb[i] != wb[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 31337: randbytes(7)")
        let g: [f64; 3] = [1.4490358901384117, -0.4276639412065733, 0.622272970978179]
        ok = near(rng.gauss(&r, 0.0, 1.0), g[0]) && near(rng.gauss(&r, 0.0, 1.0), g[1]) && near(rng.gauss(&r, 0.0, 1.0), g[2])
        testkit.check(ok, "seed 31337: gauss x3")
        testkit.check(near(rng.expovariate(&r, 2.5), 0.11853219116968813), "seed 31337: expovariate")
        testkit.check(rng.uniform(&r, 2.0, 5.0) == 2.648716254219492, "seed 31337: uniform")
        testkit.check(rng.next_u32(&r) as u64 == 1863491181, "seed 31337: stream still in sync")
        vec_free[i64](&v); vec_free[i64](&src); vec_free[i64](&big); vec_free[i64](&o); vec_free[i64](&mid); vec_free[i64](&o2); vec_free[i64](&sm); vec_free[i64](&o3)
    }
    // edge cases and sanity
    {
        var r: rng.Rng = rng.new(7)
        var e: Vec[i64] = vec_new[i64]()
        var o: Vec[i64] = vec_new[i64]()
        testkit.check(rng_choice[i64](&r, &e) == 0 as *mut i64, "choice on empty is null")
        testkit.check(!rng_sample[i64](&r, &e, 1, &o) && vec_len[i64](&o) == 0, "sample k > len")
        testkit.check(rng_sample[i64](&r, &e, 0, &o), "sample k = 0")
        rng_shuffle[i64](&r, &e)
        testkit.check(rng.randrange(&r, 5, 5) == 5 && rng.randint(&r, 9, 3) == 9, "empty ranges return start")
        var cnt: [u32; 6] = [0; 6]
        var i: usize = 0
        var okr: bool = true
        while i < 6000 {
            let d: i64 = rng.randint(&r, 1, 6)
            if d < 1 || d > 6 { okr = false } else { cnt[(d - 1) as usize] = cnt[(d - 1) as usize] + 1 }
            let u: f64 = rng.random(&r)
            if u < 0.0 || u >= 1.0 { okr = false }
            i = i + 1
        }
        i = 0
        while i < 6 { if cnt[i] < 850 || cnt[i] > 1150 { okr = false }; i = i + 1 }
        testkit.check(okr, "dice: range and rough uniformity")
        var a: rng.Rng = rng.new(99)
        var b: rng.Rng = rng.new(99)
        var c: rng.Rng = rng.new(100)
        testkit.check(rng.next_u32(&a) == rng.next_u32(&b) && rng.random(&a) == rng.random(&b), "same seed, same stream")
        testkit.check(rng.next_u32(&a) != rng.next_u32(&c), "other seed, other stream")
        var os1: rng.Rng = rng.new_os()
        var os2: rng.Rng = rng.new_os()
        testkit.check(rng.next_u32(&os1) != rng.next_u32(&os2), "os seeding differs")
        var f1: rng.Rng = rng.new(99)
        rng.seed(&a, 99)
        testkit.check(rng.next_u32(&a) == rng.next_u32(&f1), "reseed restarts the stream")
        testkit.check(random.random_u64() != random.random_u64(), "std.crypto.random coexists")
        vec_free[i64](&e)
        vec_free[i64](&o)
    }
    return testkit.finish()
}
