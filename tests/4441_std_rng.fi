        var o2: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &mid, 7, &o2)
        let sbw: [i64; 7] = [10, 28, 23, 22, 16, 13, 25]
        testkit.check(same(&o2, (&sbw[0]) as u64, 7), "seed 1: sample (pool branch)")
        var sm: Vec[i64] = vec_new[i64]()
        i = 0
        while i < 10 { vec_push[i64](&sm, i as i64); i = i + 1 }
        var o3: Vec[i64] = vec_new[i64]()
        rng_sample[i64](&r, &sm, 3, &o3)
        let scw: [i64; 3] = [3, 4, 8]
        testkit.check(same(&o3, (&scw[0]) as u64, 3), "seed 1: sample small")
        var bb: [u8; 7] = [0; 7]
        rng.randbytes(&r, (&bb[0]) as u64, 7)
        let wb: [u8; 7] = [161, 174, 107, 150, 28, 52, 249]
        ok = true
        i = 0
        while i < 7 { if bb[i] != wb[i] { ok = false }; i = i + 1 }
        testkit.check(ok, "seed 1: randbytes(7)")
        let g: [f64; 3] = [1.4310039880525183, -1.3024586211383573, -1.3328074790889433]
        ok = near(rng.gauss(&r, 0.0, 1.0), g[0]) && near(rng.gauss(&r, 0.0, 1.0), g[1]) && near(rng.gauss(&r, 0.0, 1.0), g[2])
