// expect_exit: 0
// tests/821_iface_module_core.fi — SCHNITTSTELLEN UEBER DIE MODULGRENZE.
//
// `tests/modules/draw.fi` deklariert die Schnittstelle `Groesse` und
// setzt sie fuer zwei Typen um. Hier wird beides von aussen benutzt:
//
//   * der Typ heisst `zeichnen.Kreis` — mit Modulnamen
//   * die Schnittstelle heisst `dyn Groesse` — OHNE Modulnamen, denn
//     `interface` gilt programmweit (docs/RUNDE46.md §9)
//   * die Methodentafel muss auf `zeichnen__Kreis__groesse` zeigen, also auf
//     den Namen NACH der Umbenennung
//
// Zusaetzlich: eine Umsetzung in der WURZELDATEI fuer einen Typ, der hier
// steht — dieselbe Schnittstelle, zwei Dateien.
import modules.draw

struct Stripes { length: i64 }

impl Size for Stripes {
    fn size(*self) -> i64 { return (*self).length }
    fn grow(*mut self, k: i64) { (*self).length = (*self).length + k }
}

fn sum(a: dyn Size, b: dyn Size) -> i64 {
    return a.size() + b.size()
}

fn main() -> i32 {
    var k: draw.Circle = draw.new_circle(2)
    var q: draw.Square = draw.new_square(5)
    var s: Stripes = Stripes{ length: 9 }

    let gk: dyn Size = (&k) as dyn Size
    let gq: dyn Size = (&q) as dyn Size
    let gs: dyn Size = (&s) as dyn Size

    if gk.size() != 12 {
        return 1
    }
    if gq.size() != 25 {
        return 2
    }
    if gs.size() != 9 {
        return 3
    }
    // schreibend ueber die Modulgrenze
    gk.grow(1)
    if k.r != 3 {
        return 4
    }
    if gk.size() != 27 {
        return 5
    }
    gs.grow(1)
    if s.length != 10 {
        return 6
    }
    if sum(gq, gs) != 35 {
        return 7
    }
    // statischer Aufruf derselben Methode, ohne Modulpraefix
    if k.size() != 27 {
        return 8
    }
    // die freie Funktion des Moduls ist nicht verdeckt
    if draw.size(4) != 4 {
        return 9
    }
    return 0
}
