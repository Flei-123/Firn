// expect_exit: 0
// tests/821_iface_module_core.fi -- INTERFACES ACROSS THE MODULE BOUNDARY.
//
// `tests/modules/draw.fi` declares the interface `Size` and implements it
// for two types. Here both are used from outside:
//
//   * the type is called `draw.Circle` -- with the module name
//   * the interface is called `dyn Size` -- WITHOUT the module name, because
//     `interface` holds program-wide (docs/ROUND46.md 9)
//   * the method table has to point at `draw__Circle__size`, that is at the
//     name AFTER the renaming
//
// In addition: an implementation in the ROOT FILE for a type that lives
// here -- the same interface, two files.
import modules.draw

struct Stripes { length: i64 }

impl Size for Stripes {
    fn size(*self) -> i64 { return (*self).length }
    fn grow(*mut self, k: i64) { (*self).length = (*self).length + k }
}

fn sum(a: dyn Size, b: dyn Size) -> i64 {
    return a.size() + b.size()
}

fn main() -> i32 {
    var k: draw.Circle = draw.new_circle(2)
    var q: draw.Square = draw.new_square(5)
    var s: Stripes = Stripes { length: 9 }

    let gk: dyn Size = (&k) as dyn Size
    let gq: dyn Size = (&q) as dyn Size
    let gs: dyn Size = (&s) as dyn Size

    if gk.size() != 12 {
        return 1
    }
    if gq.size() != 25 {
        return 2
    }
    if gs.size() != 9 {
        return 3
    }
    // writing across the module boundary
    gk.grow(1)
    if k.r != 3 {
        return 4
    }
    if gk.size() != 27 {
        return 5
    }
    gs.grow(1)
    if s.length != 10 {
        return 6
    }
    if sum(gq, gs) != 35 {
        return 7
    }
    // static call of the same method, without the module prefix
    if k.size() != 27 {
        return 8
    }
    // the free function of the module is not hidden
    if draw.size(4) != 4 {
        return 9
    }
    return 0
}
