// expect_exit: 0
// tests/3661_text_diff.fi -- text.diff: unified writer, parser, patch apply with offset and fuzz, broken patches.
// The comparison with reference tools over thousands of random cases is tools/textlibs_cross/run.sh.
import text.diff
import std.rt
import std.vec

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn sp(s: str) -> u64 {
    return s.p as u64
}

fn buf_is(b: *mut rt.Buf, s: str) -> bool {
    return rt.buf_len(b) == s.n && rt.mem_eq(rt.buf_ptr(b), s.p as u64, s.n)
}

fn main() -> i32 {
    let a: str = "one\ntwo\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\n"
    let b: str = "one\ntwo\nthree\nFOUR\nfive\nsix\nseven\neight\nnine\nten\neleven\n"
    var d: diff.Diff = diff.diff_new(sp(a), a.n, sp(b), b.n, diff.ALGO_MYERS)
    check("changed lines", diff.changed_lines(&d) == 3)
    check("hunks", diff.hunk_count(&d, 3) == 2 || diff.hunk_count(&d, 3) == 1)
    var out: rt.Buf = rt.buf_new()
    diff.write_unified(&d, "a/f", "b/f", 1, &out)
    check("unified", buf_is(&out, "--- a/f\n+++ b/f\n@@ -3,3 +3,3 @@\n three\n-four\n+FOUR\n five\n@@ -10 +10,2 @@\n ten\n+eleven\n"))
    // parse + apply gives b
    var p: diff.Patch = diff.parse(rt.buf_ptr(&out), rt.buf_len(&out), 0)
    check("parse", diff.patch_error(&p) == diff.E_NONE && diff.patch_hunks(&p) == 2)
    var res: rt.Buf = rt.buf_new()
    var rep: diff.ApplyReport = diff.apply(&p, sp(a), a.n, 0, &res)
    check("apply", rep.rejected == 0 && buf_is(&res, b))
    diff.report_free(&rep)
    // the target moved down by two lines: the hunks are found with an offset
    let a2: str = "x\ny\none\ntwo\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\n"
    rt.buf_clear(&res)
    var rep2: diff.ApplyReport = diff.apply(&p, sp(a2), a2.n, 0, &res)
    check("apply with offset", rep2.rejected == 0 && rep2.max_offset == 2)
    diff.report_free(&rep2)
    // a target that does not fit: the hunk is rejected, the text stays
    let a3: str = "completely\ndifferent\n"
    rt.buf_clear(&res)
    var rep3: diff.ApplyReport = diff.apply(&p, sp(a3), a3.n, 0, &res)
    check("reject", rep3.rejected == 2 && buf_is(&res, a3))
    diff.report_free(&rep3)
    diff.patch_free(&p)
    diff.diff_free(&d)
    // identical texts: no hunk
    var d2: diff.Diff = diff.diff_new(sp(a), a.n, sp(a), a.n, diff.ALGO_PATIENCE)
    check("same", diff.changed_lines(&d2) == 0 && diff.hunk_count(&d2, 3) == 0)
    diff.diff_free(&d2)
    // no newline at end of file
    let c: str = "p\nq"
    let e: str = "p\nr"
    var d3: diff.Diff = diff.diff_new(sp(c), c.n, sp(e), e.n, diff.ALGO_MYERS)
    rt.buf_clear(&out)
    diff.write_unified(&d3, "a", "b", 3, &out)
    check("no newline marker", buf_is(&out, "--- a\n+++ b\n@@ -1,2 +1,2 @@\n p\n-q\n\\ No newline at end of file\n+r\n\\ No newline at end of file\n"))
    diff.diff_free(&d3)
    // broken patches do not parse
    let bad1: str = "--- a\n+++ b\nnothing here\n"
    var q1: diff.Patch = diff.parse(sp(bad1), bad1.n, 0)
    check("no hunks", diff.patch_error(&q1) != diff.E_NONE)
    diff.patch_free(&q1)
    let bad2: str = "--- a\n+++ b\n@@ -1,2 +1,2 @@\n x\n"
    var q2: diff.Patch = diff.parse(sp(bad2), bad2.n, 0)
    check("truncated", diff.patch_error(&q2) != diff.E_NONE)
    diff.patch_free(&q2)
    let bad3: str = "--- a\n+++ b\n@@ -1,1 +1,1 @@\n?x\n"
    var q3: diff.Patch = diff.parse(sp(bad3), bad3.n, 0)
    check("bad line", diff.patch_error(&q3) != diff.E_NONE)
    diff.patch_free(&q3)
    // word diff marks the changed word only
    var ra: Vec[usize] = vec_new[usize]()
    var rb: Vec[usize] = vec_new[usize]()
    diff.inline_diff(sp("the quick fox"), 13, sp("the slow fox"), 12, diff.INLINE_WORDS, &ra, &rb)
    check("inline", vec_len[usize](&ra) == 2 && vec_at[usize](&ra, 0) == 4 && vec_at[usize](&ra, 1) == 5 && vec_at[usize](&rb, 0) == 4 && vec_at[usize](&rb, 1) == 4)
    return failures
}
