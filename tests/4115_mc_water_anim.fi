// expect_exit: 0
// tests/4115_mc_water_anim.fi -- r268 animated water_still strip (16 x 16*N, .mcmeta frametime 2, grey texels with alpha 180 like vanilla 1.20.1+): the water model
// maps the tile, ALL 6 quads land in the translucent stream, the first frame is grey (the biome tint multiplies it) and the animation advances / loops.
// MC_REAL_WATER_PNG=<path of a real water_still.png> (+ <path>.mcmeta) tests the real vanilla texture; without it a synthetic strip of the same shape is used.
import std.rt
import std.core
import std.math
import std.io
import std.env
import zip.zip
import pack.icons
import mc.mc_assets
import mc.mc_texture
import mc.mc_texext
import mc.mc_mesh
import mc.mc_model
import mc.mc_model_mesh
import mc.mc_registry
import mc.mc_version
import mc.mc_versions

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"
const NF: i32 = 32

fn add_text(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    var ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

fn add_bytes(w: *mut zip.ZipWriter, name: str, p: u64, n: usize) -> bool {
    var ok: bool = zip.zip_add(w, name, p, n, true) catch | e | (false)
    return ok
}

// 16 x 16*NF grey strip, frame f has grey 100 + 4 f, alpha 180
fn strip_png(out: *mut rt.Buf) -> bool {
    let h: i32 = 16 * NF
    let px: u64 = rt.heap_alloc((16 * h * 4) as usize)
    var f: i32 = 0
    while f < NF {
        var i: i32 = 0
        while i < 256 {
            let o: usize = (((f * 256) + i) * 4) as usize
            let g: u8 = (100 + 4 * f) as u8
            rt.st8(px, o, g)
            rt.st8(px, o + 1, g)
            rt.st8(px, o + 2, g)
            rt.st8(px, o + 3, 180 as u8)
            i = i + 1
        }
        f = f + 1
    }
    let ok: bool = icons.png_encode(px, 16, h as usize, out)
    rt.heap_free(px, (16 * h * 4) as usize)
    return ok
}

fn open_pack(b: *mut rt.Buf, w: *mut zip.ZipWriter, st: *mut mc_assets.PackStack) -> bool {
    var n: usize = zip.zip_finish(w) catch | e | (0)
    zip.zip_writer_free(w)
    if n == 0 { return false }
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&pk, rt.buf_ptr(b), rt.buf_len(b)) != mc_assets.ASSET_OK { return false }
    rt.buf_free(b)
    return mc_assets.stack_push(st, &pk) == mc_assets.ASSET_OK
}

fn sid(reg: *mut mc_registry.Registry, name: str) -> i32 {
    let blk: i32 = mc_registry.reg_block_by_name(reg, name.p as u64, name.length())
    if blk < 0 { return 0 - 1 }
    return mc_registry.reg_block_min_state(reg, blk)
}

// sum of all 256 texels of the tile (RGBA words)
fn tile_sum(a: *mut mc_texture.Atlas, t: u32) -> u64 {
    var s: u64 = 0 as u64
    var y: i32 = 0
    while y < 16 {
        var x: i32 = 0
        while x < 16 {
            s = s + (mc_texture.atlas_texel(a, t, x, y) as u64)
            x = x + 1
        }
        y = y + 1
    }
    return s
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 1 }
    var reg: mc_registry.Registry = v.registry_of()
    if !mc_registry.registry_ok(&reg) { return 2 }
    var stk: mc_assets.PackStack = mc_assets.stack_new()
    var real: bool = false
    {
        var b: rt.Buf = rt.buf_new()
        var w: zip.ZipWriter = zip.zip_writer_new(&b)
        if !add_text(&w, "pack.mcmeta", META) { return 3 }
        var png: rt.Buf = rt.buf_new()
        var meta: rt.Buf = rt.buf_new()
        if env.has("MC_REAL_WATER_PNG") {
            let pth: str = env.get("MC_REAL_WATER_PNG")
            var pz: rt.Buf = rt.buf_new()
            rt.buf_push_bytes(&pz, pth.p as u64, pth.length())
            var z: [u8; 1] = [0 as u8; 1]
            rt.buf_push_bytes(&pz, (&z[0]) as u64, 1)
            if !io.read_file(rt.buf_ptr(&pz), &png) { return 30 }
            real = true
            rt.buf_free(&pz)
        } else {
            if !strip_png(&png) { return 31 }
        }
        if !add_bytes(&w, "assets/minecraft/textures/block/water_still.png", rt.buf_ptr(&png), rt.buf_len(&png)) { return 3 }
        if !add_text(&w, "assets/minecraft/textures/block/water_still.png.mcmeta", "{\"animation\":{\"frametime\":2}}") { return 3 }
        rt.buf_free(&png)
        rt.buf_free(&meta)
        if !open_pack(&b, &w, &stk) { return 3 }
    }
    var ex0: mc_texext.TexExt = mc_texext.texext_new()
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    var ex: mc_texext.TexExt = mc_texext.texext_new()
    mc_texext.tex_build_tables_ext(&reg, &tb, &ex)
    var atlas: mc_texture.Atlas = mc_texext.texext_atlas_new(16, &ex)
    var an: mc_assets.AnimSet = mc_assets.animset_new()
    if mc_assets.assets_apply_ext(&stk, &atlas, &ex, &an) < 1 { return 4 }
    if mc_assets.animset_count(&an) < 1 { return 5 }
    var ms: mc_model_mesh.ModelSet = mc_model_mesh.ms_new(&reg, &stk, &ex)
    mc_model_mesh.ms_set_atlas(&ms, &atlas)
    mc_model_mesh.ms_set_water_tint(&ms, true)
    let s0: i32 = sid(&reg, "water")
    if s0 < 0 { return 6 }
    let pad: u64 = rt.heap_alloc(5832 * 2)
    var i: usize = 0
    while i < 5832 {
        rt.st16(pad, i, 0 as u16)
        i = i + 1
    }
    rt.st16(pad, (((8 + 1) * 18 + (8 + 1)) * 18 + (8 + 1)) as usize, s0 as u16)
    mc_model_mesh.ms_prepare(&ms, pad, &tb)
    var out: rt.Buf = rt.buf_new()
    var outt: rt.Buf = rt.buf_new()
    let nq: usize = mc_model_mesh.ms_mesh_split_bio(&ms, pad, 0, &tb, 0, 0, 0, &out, &outt, 0)
    if nq != 0 { return 10 }
    if rt.buf_len(&outt) / 240 != 6 { return 11 }
    let tile: u32 = math.math_f64(rt.ld64(rt.buf_ptr(&outt), 20)) as u32
    if tile == 0 as u32 { return 12 }
    // first frame: grey, alpha 180
    mc_assets.anim_update(&an, &atlas, 0 as i64)
    let t0: u32 = mc_texture.atlas_texel(&atlas, tile, 3, 5)
    let r0: u32 = t0 & (255 as u32)
    let g0: u32 = (t0 >> (8 as u32)) & (255 as u32)
    let b0: u32 = (t0 >> (16 as u32)) & (255 as u32)
    let a0: u32 = t0 >> (24 as u32)
    if r0 != g0 || g0 != b0 { return 13 }
    if a0 != (180 as u32) { return 14 }
    if !real && r0 != (100 as u32) { return 15 }
    // animation: tick 2 shows the next frame, tick 2 * NF loops back
    let s_a: u64 = tile_sum(&atlas, tile)
    mc_assets.anim_update(&an, &atlas, 2 as i64)
    let s_b: u64 = tile_sum(&atlas, tile)
    if s_a == s_b { return 16 }
    mc_assets.anim_update(&an, &atlas, (2 * NF) as i64)
    let s_c: u64 = tile_sum(&atlas, tile)
    if s_c != s_a { return 17 }
    if !real {
        mc_assets.anim_update(&an, &atlas, 2 as i64)
        if (mc_texture.atlas_texel(&atlas, tile, 3, 5) & (255 as u32)) != (104 as u32) { return 18 }
    }
    mc_model_mesh.ms_free(&ms)
    rt.heap_free(pad, 5832 * 2)
    return 0
}
