// expect_exit: 0
// tests/2755_mc_input.fi -- mc_input: mouse look, walking against a wall, jump, fly, pick, hotbar slot, selection box.
// The independent comparison is tools/mc/input/run.sh.
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_camera
import mc.mc_raster
import mc.mc_input

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    var w: mc_world.World = mc_world.world_new()
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    i = 0
    while i < 4 * 256 {
        rt.st16(ids, i, 1 as u16) // floor: y = -64..-61
        i = i + 1
    }
    check(mc_world.world_put(&w, mc_render_world.wr_make_chunk(0, 0, 2, ids)), 1)
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(2), solid: rt.heap_alloc(4), n: 2 }
    rt.st8(tb.pick, 0, 0 as u8)
    rt.st8(tb.pick, 1, 1 as u8)
    rt.st16(tb.solid, 0, 0 as u16)
    rt.st16(tb.solid, 1, 1 as u16)
    check(mc_input.world_block_id(&w, 0 - 64, 3, 0 - 64, 3) == 1 && mc_input.world_block_id(&w, 0 - 64, 3, 0 - 60, 3) == 0, 2)
    check(mc_input.world_block_id(&w, 0 - 64, 40, 0 - 64, 3) == 0 - 1, 3)
    // mouse look: 0.15 degrees per pixel at sensitivity 0.5, pitch clamped, yaw wraps
    var p: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 8.5)
    mc_input.player_look(&p, 100.0, 0.0 - 20.0)
    check(p.yaw > 14.99 && p.yaw < 15.01 && p.pitch < 0.0 - 2.99 && p.pitch > 0.0 - 3.01, 4)
    mc_input.player_look(&p, 0.0, 100000.0)
    check(p.pitch == 90.0, 5)
    mc_input.player_look(&p, 2000.0, 0.0)
    check(p.yaw >= 0.0 - 180.0 && p.yaw < 180.0, 6)
    p.yaw = 0.0
    p.pitch = 0.0
    // walk: yaw 0 = south = +z; 20 ticks of vanilla momentum walking from rest = 4.0576 blocks (tools/mc/phys/ref.py)
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    mc_input.player_tick(&p, &ev, &w, &tb, 0 - 64)
    mc_input.player_tick(&p, &ev, &w, &tb, 0 - 64)
    check(p.on_ground, 7)
    ev.keys = mc_input.K_FORWARD
    var t: i32 = 0
    while t < 20 {
        mc_input.player_tick(&p, &ev, &w, &tb, 0 - 64)
        t = t + 1
    }
    check(p.z > 8.5 + 4.057 && p.z < 8.5 + 4.058 && p.x == 8.5, 8)
    // the chunk ends at z = 16: unloaded chunks are solid
    t = 0
    while t < 100 {
        mc_input.player_tick(&p, &ev, &w, &tb, 0 - 64)
        t = t + 1
    }
    check(p.z > 15.69 && p.z < 15.71, 9)
    // jump: leaves the ground, lands again
    ev.keys = mc_input.K_JUMP
    mc_input.player_tick(&p, &ev, &w, &tb, 0 - 64)
    check(!p.on_ground && p.y > 0.0 - 59.6, 10)
    ev.keys = 0 as u32
    t = 0
    while t < 40 {
        mc_input.player_tick(&p, &ev, &w, &tb, 0 - 64)
        t = t + 1
    }
    check(p.on_ground && p.y == 0.0 - 60.0, 11)
    // fly toggle + hotbar wheel
    ev.toggle_fly = true
    ev.slot_delta = 0 - 1
    ev.keys = mc_input.K_JUMP
    mc_input.player_tick(&p, &ev, &w, &tb, 0 - 64)
    check(p.flying && p.slot == 8 && p.y > 0.0 - 59.851 && p.y < 0.0 - 59.849, 12)
    // pick: straight down from above the floor hits the top face of y = -61
    var pk: mc_input.Pick = mc_input.Pick { x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, dist: 0.0, id: 0 }
    check(mc_input.input_pick(&w, 0 - 64, &tb, 8.5, 0.0 - 58.5, 8.5, 0.0, 0.0 - 1.0, 0.0, 5.0, &pk), 13)
    check(pk.x == 8 && pk.y == 0 - 61 && pk.z == 8 && pk.ny == 1 && pk.nx == 0 && pk.dist > 1.49 && pk.dist < 1.51 && pk.id == 1, 14)
    check(!mc_input.input_pick(&w, 0 - 64, &tb, 8.5, 0.0 - 50.0, 8.5, 0.0, 0.0 - 1.0, 0.0, 5.0, &pk), 15)
    check(mc_input.input_pick(&w, 0 - 64, &tb, 8.5, 0.0 - 62.5, 8.5, 1.0, 0.0, 0.0, 5.0, &pk) && pk.dist == 0.0 && pk.nx == 0 && pk.ny == 0, 16)
    // selection box: camera looks at the block, some pixels get the line colour, depth untouched
    var cam: mc_camera.Camera = mc_camera.camera_new(64, 48)
    p.yaw = 0.0
    p.pitch = 40.0
    mc_input.player_set_camera(&p, &cam)
    var r: mc_raster.Raster = mc_raster.raster_new(64, 48)
    mc_raster.raster_set_camera(&r, &cam)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_input.input_draw_box(&r, 8, 0 - 61, 16, 0xFFFFFFFF as u32)
    var lit: i32 = 0
    var y: i32 = 0
    while y < 48 {
        var x: i32 = 0
        while x < 64 {
            if mc_raster.raster_pixel(&r, x, y) == 0xFFFFFFFF as u32 { lit = lit + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check(lit > 20, 17)
    mc_input.player_free(&p)
    mc_raster.raster_free(&r)
    return 0
}
