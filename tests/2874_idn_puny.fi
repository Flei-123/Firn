// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
// tests/2874_idn_puny.fi -- lib/net/idn.fi: Punycode (RFC 3492 samples,
// values from Python's `punycode` codec), host names to ASCII and back,
// refusals. The wide cross-check against Python is tools/dns/idn_check.py.
import std.rt
import net.idn

static mut fails: u32 = 0

fn check(ok: bool, code: u32) {
    if !ok {
        fails = fails + 1
        var d: [u8; 8] = "FAIL 000"
        d[5] = (48 + (code / 100) % 10) as u8
        d[6] = (48 + (code / 10) % 10) as u8
        d[7] = (48 + code % 10) as u8
        syscall(1, 2, (&d[0]) as i64, 8, 0, 0, 0)
    }
}

fn same(b: *mut rt.Buf, want: str) -> bool {
    if (*b).len != want.n {
        return false
    }
    var i: usize = 0
    while i < want.n {
        if rt.ld8(rt.buf_ptr(b), i) != rt.ld8(want.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn to_ascii(s: str, want: str, code: u32) {
    var b: rt.Buf = rt.buf_new()
    let ok: bool = idn.idn_to_ascii(s.p as u64, s.n, &b)
    check(ok && same(&b, want), code)
    rt.buf_free(&b)
}

fn to_uni(s: str, want: str, code: u32) {
    var b: rt.Buf = rt.buf_new()
    let ok: bool = idn.idn_to_unicode(s.p as u64, s.n, &b)
    check(ok && same(&b, want), code)
    rt.buf_free(&b)
}

fn refused(s: str, code: u32) {
    var b: rt.Buf = rt.buf_new()
    check(!idn.idn_to_ascii(s.p as u64, s.n, &b), code)
    rt.buf_free(&b)
}

fn main() -> i32 {
    to_ascii("bücher.example", "xn--bcher-kva.example", 1)
    to_ascii("Bücher.Example.", "xn--bcher-kva.example.", 2)
    to_ascii("WWW.Example.COM", "www.example.com", 3)
    to_ascii("münchen.de", "xn--mnchen-3ya.de", 4)
    to_ascii("пример.испытание", "xn--e1afmkfd.xn--80akhbyknj4f", 5)
    to_ascii("例え.テスト", "xn--r8jz45g.xn--zckzah", 6)
    to_ascii("ÜBER.de", "xn--ber-goa.de", 7)
    to_ascii("ελληνικά.gr", "xn--hxargifdar.gr", 8)
    to_uni("xn--bcher-kva.example", "bücher.example", 20)
    to_uni("XN--E1AFMKFD.xn--80akhbyknj4f", "пример.испытание", 21)
    to_uni("plain.Example", "plain.example", 22)
    refused("a..b", 40)
    refused(".a", 41)
    var bad: [u8; 3] = [98, 195, 46]
    var bb: rt.Buf = rt.buf_new()
    check(!idn.idn_to_ascii((&bad[0]) as u64, 3, &bb), 42)
    rt.buf_free(&bb)
    var b: rt.Buf = rt.buf_new()
    check(!idn.idn_to_unicode("xn--!!".p as u64, 6, &b), 43)
    rt.buf_free(&b)
    if fails == 0 {
        return 0
    }
    return 1
}
