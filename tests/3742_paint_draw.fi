// expect_exit: 0
// paint.draw: shapes land where they should, clipping, moving the value, save as PNG (read back) and PPM.
import std.rt
import std.fs
import std.testkit
import paint.draw
import image.picture

fn red(p: u32) -> u32 {
    return (p >> 16) & 255
}

#[test]
fn rect_and_circle_cover_their_pixels() {
    var d: draw.Draw = draw.new(40, 30, draw.rgb(0, 0, 0))
    testkit.assert_true(draw.ok(&d), "ok")
    draw.rect(&d, 5.0, 5.0, 10.0, 10.0, draw.rgb(255, 0, 0))
    draw.circle(&d, 30.0, 15.0, 6.0, draw.rgb(0, 255, 0))
    testkit.assert_eq_i64(draw.pixel(&d, 10, 10) as i64, 0xFFFF0000)
    testkit.assert_eq_i64(draw.pixel(&d, 4, 10) as i64, 0xFF000000)
    testkit.assert_eq_i64(draw.pixel(&d, 30, 15) as i64, 0xFF00FF00)
    testkit.assert_eq_i64(draw.pixel(&d, 24, 9) as i64, 0xFF000000) // corner of the circle's box stays empty
    draw.free(&d)
}

#[test]
fn line_is_drawn_and_clipped() {
    var d: draw.Draw = draw.new(32, 32, draw.rgb(0, 0, 0))
    draw.line(&d, -20.0, 16.0, 60.0, 16.0, 3.0, draw.rgb(255, 255, 255))
    testkit.assert_eq_i64(draw.pixel(&d, 0, 16) as i64, 0xFFFFFFFF)
    testkit.assert_eq_i64(draw.pixel(&d, 31, 15) as i64, 0xFFFFFFFF)
    testkit.assert_eq_i64(draw.pixel(&d, 16, 20) as i64, 0xFF000000)
    draw.line(&d, 0.0, 0.0, 31.0, 31.0, 1.5, draw.rgb(255, 0, 0))
    testkit.assert_true(red(draw.pixel(&d, 8, 8)) > 200, "diagonal")
    draw.free(&d)
}

#[test]
fn outline_leaves_the_inside() {
    var d: draw.Draw = draw.new(30, 30, draw.rgb(0, 0, 0))
    draw.rect_outline(&d, 2.0, 2.0, 26.0, 26.0, 2.0, draw.rgb(255, 255, 255))
    draw.circle_outline(&d, 15.0, 15.0, 8.0, 1.0, draw.rgb(255, 255, 0))
    testkit.assert_eq_i64(draw.pixel(&d, 3, 15) as i64, 0xFFFFFFFF)
    testkit.assert_eq_i64(draw.pixel(&d, 12, 12) as i64, 0xFF000000)
    draw.free(&d)
}

#[test]
fn moved_value_still_draws_into_its_own_canvas() {
    var a: draw.Draw = draw.new(8, 8, draw.rgb(0, 0, 0))
    var b: draw.Draw = a
    draw.rect(&b, 0.0, 0.0, 8.0, 8.0, draw.rgb(9, 9, 9))
    testkit.assert_eq_i64(draw.pixel(&b, 4, 4) as i64, 0xFF090909)
    draw.free(&b)
}

#[test]
fn refusals_are_harmless() {
    var z: draw.Draw = draw.new(0, 10, draw.rgb(0, 0, 0))
    testkit.assert_false(draw.ok(&z), "zero width")
    draw.rect(&z, 0.0, 0.0, 5.0, 5.0, draw.rgb(1, 2, 3))
    draw.line(&z, 0.0, 0.0, 5.0, 5.0, 1.0, draw.rgb(1, 2, 3))
    testkit.assert_false(draw.save(&z, "x.png"), "save")
    var d: draw.Draw = draw.new(4, 4, draw.rgb(0, 0, 0))
    testkit.assert_false(draw.save(&d, "x.xyz"), "unknown extension")
    testkit.assert_eq_i64(draw.pixel(&d, 99, 99) as i64, 0)
    draw.free(&d)
}

#[test]
fn saved_png_reads_back_through_picture() {
    var d: draw.Draw = draw.new(20, 10, draw.rgb(10, 20, 30))
    draw.rect(&d, 2.0, 2.0, 4.0, 4.0, draw.rgb(200, 100, 50))
    let path: str = "/tmp/3742_paint_draw_probe.png"
    testkit.assert_true(draw.save(&d, path), "save png")
    var p: picture.Picture = picture.open(path)
    testkit.assert_true(picture.ok(&p), "reads back")
    testkit.assert_eq_i64(picture.width(&p) as i64, 20)
    testkit.assert_eq_i64(picture.pixel(&p, 3, 3) as i64, 0xFFC86432)
    testkit.assert_eq_i64(picture.pixel(&p, 15, 8) as i64, 0xFF0A141E)
    picture.free(&p)
    var raw: rt.Buf = rt.buf_new()
    testkit.assert_true(draw.save(&d, "/tmp/3742_paint_draw_probe.ppm"), "save ppm")
    let n: usize = fs.read_file("/tmp/3742_paint_draw_probe.ppm", &raw) catch 0
    testkit.assert_eq_i64(n as i64, 13 + 20 * 10 * 3)
    rt.buf_free(&raw)
    fs.remove(path) catch false
    fs.remove("/tmp/3742_paint_draw_probe.ppm") catch false
    draw.free(&d)
}
