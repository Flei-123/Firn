// expect_out: hello|HELLO|5|2|1|firn-70
// tests/1332_str_library.fi -- `str` AND the string library (round 70).
//
// `str` is two words, `str.Span` is the same two words. That is why the 135
// functions of `lib/std/str.fi` work on a `str` without a conversion
// function and without a copy of the octets -- `s.trim()` is `str.trim(s)`,
// resolved through `impl Span` (impls.rs, round 45).
//
// What is proved here: the METHODS, the direction str -> Span, the direction
// Span -> str, and that a literal is accepted as an argument where the
// library wants a `Span`.
import std.str
import std.io

fn main() -> i32 {
    let padded: str = "  hello  "
    let core: str = padded.trim()
    if core.length() != 5 { return 1 }
    if core != "hello" { return 2 }
    if !core.starts_with("hel") { return 3 }
    if !core.ends_with("llo") { return 4 }
    if core.find("llo") != 2 { return 5 }
    if !core.contains("ell") { return 6 }
    if core.count_char(108 as u8) != 2 { return 7 }
    io.print_str(core)

    // Span -> str: the free functions hand out `Span`, the language calls it
    // `str`. Nothing is copied here either.
    var big: str.Bytes = str.bytes_new()
    str.after_big(&big, core)
    let shouted: str = str.span_of_bytes(&big)
    if shouted != "HELLO" { return 8 }
    var bar: [u8; 1] = "|"
    io.print_bytes((&bar[0]) as u64, 1)
    io.print_str(shouted)

    // str -> Span: a Span built by hand out of the two words
    let view: str.Span = str.span(core.p, core.n)
    if str.length(view) != 5 { return 9 }
    io.print_bytes((&bar[0]) as u64, 1)
    io.fmt_print(f"{core.length()}|{core.count_char(108 as u8)}|1|")
    str.bytes_free(&big)

    // and a concatenation whose result goes straight into the library
    if !gc_init() { return 10 }
    let name: str = "firn" + "-" + "70"
    if !name.starts_with("firn") { return 11 }
    io.println_str(name)
    return 0
}
