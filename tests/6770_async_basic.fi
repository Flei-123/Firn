// expect_exit: 0
import async.loop
import async.fut

async fn add_later(l: *mut loop.Loop, a: i32, b: i32, ms: i64) -> i32 {
    let w: bool = fut.sleep_ms(l, ms).await
    return a + b
}

async fn total(l: *mut loop.Loop) -> i32 {
    let fa: *mut Fut[i32] = add_later(l, 1, 2, 30)
    let fb: *mut Fut[i32] = add_later(l, 3, 4, 10)
    let x: i32 = fa.await
    let y = fb.await
    let z = add_later(l, 10, 20, 5).await
    return x * 100 + y * 10 + z
}

#[allow_escape]
fn main() -> i32 {
    var l: loop.Loop = loop.loop_new()
    if !loop.loop_init(&l) { return 1 }
    let f: *mut Fut[i32] = total(&l)
    let r: i32 = fut.block_on[i32](&l, f)
    loop.loop_free(&l)
    if r != 300 + 70 + 30 { return 2 }
    return 0
}
