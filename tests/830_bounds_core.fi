// expect_exit: 0
// SCHRANKEN AN TYPPARAMETERN — der Kerntest zu Runde 50.
//
// Bis Runde 49 konnte eine generische Vorlage von `T` nichts verlangen: die
// drei eingebauten Schranken (`Any`, `Int`, `Scalar`) sagen nur, welche FORM
// der Typ hat, nicht was er KANN. Seit dieser Runde ist der Name einer
// Schnittstelle eine Schranke, `T: Ordnung`, und der Rumpf darf die Methoden
// dieser Schnittstelle rufen. Geprueft wird bei der Auspraegung.
//
// Was hier durchprobiert wird:
//   * Schranke an einer FUNKTION und an einem STRUCT
//   * `Self` in der Schnittstelle — die Bedingung dafuer, dass sich eine
//     Ordnung ueberhaupt aufschreiben laesst
//   * MEHRERE Schranken an einem Parameter (`Scalar + Ordnung`)
//   * ein GRUNDTYP als Umsetzer (`impl Ordnung for i64`)
//   * VERSCHACHTELTE Auspraegung: eine Vorlage mit Schranke ruft eine andere
//   * dieselbe Schnittstelle aus einem MODUL, mit umbenanntem Typ
//   * DYNAMISCHER Versand daneben — `dyn Zeigbar` gibt es weiter, und beide
//     Wege fuehren zu demselben Ergebnis. Der Unterschied steckt im
//     Assembler, nicht im Verhalten (tools/bounds/run.sh).
import modules.bounds

interface Order {
    fn less(*self, b: *Self) -> bool
}

interface Showable {
    fn value(*self) -> i64
}

struct Dot { x: i64 }

impl Order for Dot {
    fn less(*self, b: *Dot) -> bool {
        return (*self).x < (*b).x
    }
}

impl Showable for Dot {
    fn value(*self) -> i64 {
        return (*self).x
    }
}

// Die Schnittstelle kommt aus dem MODUL, die Umsetzung steht hier. Beides
// zusammen ist der Beleg, dass `interface`-Namen programmweit gelten.
impl Row for Dot {
    fn rank(*self) -> i64 {
        return (*self).x
    }
}

impl Order for i64 {
    fn less(*self, b: *i64) -> bool {
        return *self < *b
    }
}

impl Order for u8 {
    fn less(*self, b: *u8) -> bool {
        return *self < *b
    }
}

// --- Schranke an einer Funktion -------------------------------------------
fn smaller[T: Order](a: *T, b: *T) -> *T {
    if a.less(b) {
        return a
    }
    return b
}

// --- verschachtelt: Vorlage mit Schranke ruft Vorlage mit Schranke ---------
fn kleinstes3[T: Order](a: *T, b: *T, c: *T) -> *T {
    return smaller[T](smaller[T](a, b), c)
}

// --- mehrere Schranken gleichzeitig ---------------------------------------
// `Scalar` fuer `0 as T`, `Ordnung` fuer den Vergleich. Beide gelten.
fn less_as_null[T: Scalar + Order](a: T) -> bool {
    var x: T = a
    var null: T = 0 as T
    return x.less(&null)
}

// --- Schranke an einem generischen STRUCT ---------------------------------
// Der Struct selbst ruft keine Methode; die Schranke steht trotzdem, damit
// niemand ein `Paar` aus etwas baut, das keine Ordnung hat.
struct Pair[T: Order] {
    a: T,
    b: T,
}

fn pair_less[T: Order](p: *Pair[T]) -> bool {
    return (&(*p).a).less(&(*p).b)
}

fn main() -> i32 {
    // --- Struct mit Schranke
    var p: Dot = Dot{ x: 3 }
    var q: Dot = Dot{ x: 7 }
    var r: Dot = Dot{ x: 1 }
    let k: *Dot = smaller[Dot](&p, &q)
    if (*k).x != 3 {
        return 1
    }
    let k3: *Dot = kleinstes3[Dot](&p, &q, &r)
    if (*k3).x != 1 {
        return 2
    }

    // --- Grundtyp mit Schranke: derselbe Code, anderer Typ
    var a: i64 = 40
    var b: i64 = 2
    let ki: *i64 = smaller[i64](&a, &b)
    if *ki != 2 {
        return 3
    }
    var m: u8 = 200
    var n: u8 = 12
    let ku: *u8 = smaller[u8](&m, &n)
    if *ku != 12 {
        return 4
    }

    // --- zwei Schranken an einem Parameter
    if !less_as_null[i64](0 - 5) {
        return 5
    }
    if less_as_null[i64](5) {
        return 6
    }
    if less_as_null[u8](5) {
        return 7
    }

    // --- Schranke an einem generischen Struct
    var pp: Pair[Dot] = Pair[Dot]{ a: Dot{ x: 2 }, b: Dot{ x: 9 } }
    if !pair_less[Dot](&pp) {
        return 8
    }
    var pi: Pair[i64] = Pair[i64]{ a: 9, b: 2 }
    if pair_less[i64](&pi) {
        return 9
    }

    // --- Schnittstelle und Vorlage aus einem MODUL, Typ aus DIESER Datei.
    // `Reihe` steht in `modules/bounds.fi` und gilt trotzdem hier ohne
    // Modulnamen; `Punkt` setzt sie unten um.
    if largest[Dot](&p, &q) != 7 {
        return 10
    }
    // ... und derselbe Aufruf mit einem Grundtyp, dessen Umsetzung im Modul
    // steht: `u16__rang` traegt KEINEN Modulpraefix.
    var g1: u16 = 300
    var g2: u16 = 65000
    if largest[u16](&g1, &g2) != 65000 {
        return 11
    }
    // ... und der modulinterne Aufruf auf dem umbenannten Typ
    var mk: bounds.Mark = bounds.mark_new(11)
    if bounds.mark_rank(&mk) != 11 {
        return 14
    }

    // --- der dynamische Weg steht unveraendert daneben
    let z: dyn Showable = (&q) as dyn Showable
    if z.value() != 7 {
        return 12
    }

    // --- statisch und dynamisch liefern dasselbe
    if z.value() != (&q).value() {
        return 13
    }
    return 0
}
