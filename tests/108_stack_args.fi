// expect_exit: 45
// More than six parameters: the rest are passed on the stack (abi.rs).
// Replaces tests/neg/too_many_params.fi from round 1: that negative test
// checked the limit of 6 parameters which this round lifts (SPEC 14.1 item 9
// dropped). The guarantee is checked positively here, not weakened.
fn nine(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32, i: i32) -> i32 {
    return a + b + c + d + e + f + g + h + i
}

fn ten_u8(a: u8, b: u8, c: u8, d: u8, e: u8, f: u8, g: u8, h: u8) -> u8 {
    return a + b + c + d + e + f + g + h
}

fn main() -> i32 {
    let s: i32 = nine(1, 2, 3, 4, 5, 6, 7, 8, 9)
    let t: u8 = ten_u8(1, 1, 1, 1, 1, 1, 1, 1)
    if t != 8 as u8 { return 1 }
    return s
}
