// expect_exit: 0
// tests/3662_auth_otp.fi -- auth.otp: RFC 4226 / RFC 6238 vectors, Base32, otpauth URIs.
// The comparison with reference tools over thousands of random cases is tools/textlibs_cross/run.sh.
import auth.otp
import std.rt

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn sp(s: str) -> u64 {
    return s.p as u64
}

fn buf_is(b: *mut rt.Buf, s: str) -> bool {
    return rt.buf_len(b) == s.n && rt.mem_eq(rt.buf_ptr(b), s.p as u64, s.n)
}

fn code_is(alg: u32, key: str, time: u64, digits: usize, want: u64) -> bool {
    return otp.totp(alg, sp(key), key.n, time, 30, 0, digits) == want
}

fn main() -> i32 {
    let k1: str = "12345678901234567890"
    // RFC 4226 appendix D
    let want: [u64; 10] = [755224, 287082, 359152, 969429, 338314, 254676, 287922, 162583, 399871, 520489]
    var i: usize = 0
    while i < 10 {
        check("hotp vector", otp.hotp(otp.ALG_SHA1, sp(k1), k1.n, i as u64, 6) == want[i])
        i = i + 1
    }
    // RFC 6238 appendix B (8 digits)
    let k256: str = "12345678901234567890123456789012"
    let k512: str = "1234567890123456789012345678901234567890123456789012345678901234"
    check("totp sha1 59", code_is(otp.ALG_SHA1, k1, 59, 8, 94287082))
    check("totp sha256 59", code_is(otp.ALG_SHA256, k256, 59, 8, 46119246))
    check("totp sha512 59", code_is(otp.ALG_SHA512, k512, 59, 8, 90693936))
    check("totp sha1 1111111109", code_is(otp.ALG_SHA1, k1, 1111111109, 8, 7081804))
    check("totp sha1 2000000000", code_is(otp.ALG_SHA1, k1, 2000000000, 8, 69279037))
    // zero padded text
    var t: rt.Buf = rt.buf_new()
    otp.format_code(7081804, 8, &t)
    check("format", buf_is(&t, "07081804"))
    // verification window
    let c0: u64 = otp.totp(otp.ALG_SHA1, sp(k1), k1.n, 59, 30, 0, 6)
    var cs: rt.Buf = rt.buf_new()
    otp.format_code(c0, 6, &cs)
    let cstr: str = str { p: rt.buf_ptr(&cs) as *mut u8, n: rt.buf_len(&cs) }
    check("verify now", otp.totp_verify(otp.ALG_SHA1, sp(k1), k1.n, 59, 30, 6, cstr, 1) == 0)
    check("verify skew", otp.totp_verify(otp.ALG_SHA1, sp(k1), k1.n, 89, 30, 6, cstr, 1) == 0 - 1)
    check("verify out", otp.totp_verify(otp.ALG_SHA1, sp(k1), k1.n, 400, 30, 6, cstr, 1) == 0 - 100)
    // Base32
    var key: rt.Buf = rt.buf_new()
    check("b32 decode", otp.base32_decode("JBSWY3DPEHPK3PXP", &key) && rt.buf_len(&key) == 10 && rt.ld8(rt.buf_ptr(&key), 0) == 72 as u8)
    var enc: rt.Buf = rt.buf_new()
    otp.base32_encode(rt.buf_ptr(&key), rt.buf_len(&key), true, &enc)
    check("b32 roundtrip", buf_is(&enc, "JBSWY3DPEHPK3PXP"))
    var enc2: rt.Buf = rt.buf_new()
    otp.base32_encode(sp("f"), 1, true, &enc2)
    check("b32 pad", buf_is(&enc2, "MY======"))
    var bad: rt.Buf = rt.buf_new()
    check("b32 bad", !otp.base32_decode("not base32!", &bad))
    // otpauth URI
    var u: otp.Uri = otp.uri_parse("otpauth://totp/Example:alice?secret=JBSWY3DPEHPK3PXP&issuer=Example&digits=8&period=60&algorithm=SHA256")
    check("uri ok", u.ok && u.kind == otp.KIND_TOTP && u.digits == 8 && u.period == 60 && u.alg == otp.ALG_SHA256)
    otp.uri_free(&u)
    var u2: otp.Uri = otp.uri_parse("http://not-otp")
    check("uri bad", !u2.ok)
    otp.uri_free(&u2)
    var ub: rt.Buf = rt.buf_new()
    otp.uri_build(otp.KIND_TOTP, "Example", "alice", sp(k1), k1.n, otp.ALG_SHA1, 6, 30, 0, &ub)
    var u3: otp.Uri = otp.uri_parse(str { p: rt.buf_ptr(&ub) as *mut u8, n: rt.buf_len(&ub) })
    check("uri roundtrip", u3.ok && u3.digits == 6 && u3.period == 30)
    otp.uri_free(&u3)
    return failures
}
