// expect_exit: 0
// tests/1601_bytes_protocol.fi -- ROUND 76: `lib/std/bytes.fi` against the
// table from the protocol, not against itself.
//
// A roundtrip test alone ("write it, read it back, they match") proves that
// a module agrees with itself. It would pass with LITTLE endian integers,
// with zigzag VarInts and with a length prefix in code points instead of
// octets -- and every one of those produces a stream no Minecraft client
// understands. So the octets are written out here, taken from the protocol
// documentation (minecraft.wiki, Java Edition protocol/Data types, the
// VarInt and VarLong table), and compared one by one.
//
// The roundtrip comes on top, over 20,000 pseudo random values per width --
// that is what catches the cases the table does not name (the carry from
// the fourth into the fifth group, the top bit of a VarLong).
import std.bytes

// Compares the buffer against `n` octets at `want` and empties it again.
fn is(b: *mut bytes.Bytes, want: u64, n: usize) -> bool {
    if bytes.bytes_len(b) != n {
        return false
    }
    var i: usize = 0
    while i < n {
        if bytes.bytes_at(b, i) != *((want + i as u64) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

fn next_state(x: u64) -> u64 {
    // ROUND 83: a linear congruential generator is arithmetic modulo
    // 2^64 -- `*%`/`+%` say so (SPEC 13, item L9).
    return x *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
}

fn main() -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    defer bytes.bytes_free(&b)

    // ------------------------------------------------ 1. the VarInt table
    var t0: [u8; 1] = [0x00]
    var t1: [u8; 1] = [0x01]
    var t2: [u8; 1] = [0x02]
    var t127: [u8; 1] = [0x7f]
    var t128: [u8; 2] = [0x80, 0x01]
    var t255: [u8; 2] = [0xff, 0x01]
    var t25565: [u8; 3] = [0xdd, 0xc7, 0x01]
    var t2097151: [u8; 3] = [0xff, 0xff, 0x7f]
    var tmax: [u8; 5] = [0xff, 0xff, 0xff, 0xff, 0x07]
    var tm1: [u8; 5] = [0xff, 0xff, 0xff, 0xff, 0x0f]
    var tmin: [u8; 5] = [0x80, 0x80, 0x80, 0x80, 0x08]

    bytes.put_varint(&b, 0)
    if !is(&b, (&t0[0]) as u64, 1) { return 1 }
    bytes.bytes_clear(&b)
    bytes.put_varint(&b, 1)
    if !is(&b, (&t1[0]) as u64, 1) { return 2 }
    bytes.bytes_clear(&b)
    bytes.put_varint(&b, 2)
    if !is(&b, (&t2[0]) as u64, 1) { return 3 }
    bytes.bytes_clear(&b)
    bytes.put_varint(&b, 127)
    if !is(&b, (&t127[0]) as u64, 1) { return 4 }
    bytes.bytes_clear(&b)
    bytes.put_varint(&b, 128)
    if !is(&b, (&t128[0]) as u64, 2) { return 5 }
    bytes.bytes_clear(&b)
    bytes.put_varint(&b, 255)
    if !is(&b, (&t255[0]) as u64, 2) { return 6 }
    bytes.bytes_clear(&b)
    bytes.put_varint(&b, 25565)
    if !is(&b, (&t25565[0]) as u64, 3) { return 7 }
    bytes.bytes_clear(&b)
    bytes.put_varint(&b, 2097151)
    if !is(&b, (&t2097151[0]) as u64, 3) { return 8 }
    bytes.bytes_clear(&b)
    bytes.put_varint(&b, 2147483647)
    if !is(&b, (&tmax[0]) as u64, 5) { return 9 }
    bytes.bytes_clear(&b)
    // -1 is FIVE octets, not one. That is the whole point of "no zigzag".
    bytes.put_varint(&b, 0 - 1)
    if !is(&b, (&tm1[0]) as u64, 5) { return 10 }
    bytes.bytes_clear(&b)
    // ROUND 83: i32::MIN as a BIT PATTERN. `(2147483648 as u32) as i32`
    // is a checked narrowing cast (same width, other sign) and aborts
    // under dev/dev-fast/release-safe -- correctly, the value does not
    // fit. The subtraction says the same number without leaving the range.
    let i32_min: i32 = 0 -% 2147483647 - 1
    bytes.put_varint(&b, i32_min)
    if !is(&b, (&tmin[0]) as u64, 5) { return 11 }
    bytes.bytes_clear(&b)

    // the sizes have to agree with what was really written
    if bytes.varint_size(0) != 1 { return 12 }
    if bytes.varint_size(127) != 1 { return 13 }
    if bytes.varint_size(128) != 2 { return 14 }
    if bytes.varint_size(2097151) != 3 { return 15 }
    if bytes.varint_size(0 - 1) != 5 { return 16 }
    if bytes.varint_size(i32_min) != 5 { return 17 }

    // ----------------------------------------------- 2. the VarLong table
    var l255: [u8; 2] = [0xff, 0x01]
    var l2147483647: [u8; 5] = [0xff, 0xff, 0xff, 0xff, 0x07]
    var lmax: [u8; 9] = [0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x7f]
    var lm1: [u8; 10] = [0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x01]
    var lm2147483648: [u8; 10] = [0x80, 0x80, 0x80, 0x80, 0xf8, 0xff, 0xff, 0xff, 0xff, 0x01]
    var lmin: [u8; 10] = [0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0x01]

    bytes.put_varlong(&b, 255)
    if !is(&b, (&l255[0]) as u64, 2) { return 20 }
    bytes.bytes_clear(&b)
    bytes.put_varlong(&b, 2147483647)
    if !is(&b, (&l2147483647[0]) as u64, 5) { return 21 }
    bytes.bytes_clear(&b)
    let i64_max: i64 = (9223372036854775807 as u64) as i64
    bytes.put_varlong(&b, i64_max)
    if !is(&b, (&lmax[0]) as u64, 9) { return 22 }
    bytes.bytes_clear(&b)
    bytes.put_varlong(&b, 0 - 1)
    if !is(&b, (&lm1[0]) as u64, 10) { return 23 }
    bytes.bytes_clear(&b)
    bytes.put_varlong(&b, 0 - 2147483648)
    if !is(&b, (&lm2147483648[0]) as u64, 10) { return 24 }
    bytes.bytes_clear(&b)
    let i64_min: i64 = (9223372036854775808 as u64) as i64
    bytes.put_varlong(&b, i64_min)
    if !is(&b, (&lmin[0]) as u64, 10) { return 25 }
    bytes.bytes_clear(&b)

    // --------------------------------------------- 3. big endian integers
    var e16: [u8; 2] = [0x12, 0x34]
    var e32: [u8; 4] = [0xde, 0xad, 0xbe, 0xef]
    var e64: [u8; 8] = [0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef]
    bytes.put_u16(&b, 0x1234 as u16)
    if !is(&b, (&e16[0]) as u64, 2) { return 30 }
    bytes.bytes_clear(&b)
    bytes.put_u32(&b, 0xdeadbeef as u32)
    if !is(&b, (&e32[0]) as u64, 4) { return 31 }
    bytes.bytes_clear(&b)
    bytes.put_u64(&b, 0x0123456789abcdef as u64)
    if !is(&b, (&e64[0]) as u64, 8) { return 32 }
    bytes.bytes_clear(&b)

    // f32/f64: the IEEE bit pattern, big endian. 1.0f = 0x3f800000,
    // 1.0d = 0x3ff0000000000000 -- constants, not something computed here.
    var f1: [u8; 4] = [0x3f, 0x80, 0x00, 0x00]
    var d1: [u8; 8] = [0x3f, 0xf0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
    bytes.put_f32(&b, 1.0f)
    if !is(&b, (&f1[0]) as u64, 4) { return 33 }
    bytes.bytes_clear(&b)
    bytes.put_f64(&b, 1.0)
    if !is(&b, (&d1[0]) as u64, 8) { return 34 }
    bytes.bytes_clear(&b)

    // --------------------------------------------------- 4. string, position
    // "Notch" -- 5 octets, prefix 0x05.
    var name: [u8; 6] = "Notch\0"
    var want_name: [u8; 6] = [0x05, 0x4e, 0x6f, 0x74, 0x63, 0x68]
    bytes.put_string_c(&b, (&name[0]) as u64)
    if !is(&b, (&want_name[0]) as u64, 6) { return 40 }
    bytes.bytes_reset(&b)
    var got_n: usize = 0
    let got_p: u64 = bytes.get_string(&b, &got_n) catch 0
    if got_n != 5 { return 41 }
    if !bytes.bytes_span_eq(got_p, got_n, (&name[0]) as u64, 5) { return 42 }
    bytes.bytes_clear(&b)

    // The `Position` bit field. x = 18357644, y = 831, z = -20882616 is the
    // worked example of the documentation; its 64 bit word reads
    // 0x4607632c15b4833f.
    var wp: [u8; 8] = [0x46, 0x07, 0x63, 0x2c, 0x15, 0xb4, 0x83, 0x3f]
    bytes.put_position(&b, 18357644, 831, 0 - 20882616)
    if !is(&b, (&wp[0]) as u64, 8) { return 43 }
    bytes.bytes_reset(&b)
    var px: i32 = 0
    var py: i32 = 0
    var pz: i32 = 0
    let okp: bool = bytes.get_position(&b, &px, &py, &pz) catch false
    if !okp { return 44 }
    if px != 18357644 { return 45 }
    if py != 831 { return 46 }
    if pz != 0 - 20882616 { return 47 }
    bytes.bytes_clear(&b)

    // ------------------------------------------------- 5. the reader refuses
    // Underflow: three octets announced, one present.
    bytes.put_u8(&b, 3 as u8)
    bytes.put_u8(&b, 65 as u8)
    bytes.bytes_reset(&b)
    var un: usize = 99
    let bad: u64 = bytes.get_string(&b, &un) catch 0
    if bad != 0 { return 50 }
    bytes.bytes_clear(&b)
    // TooLong: five continuation octets in a row are a VarInt that never ends.
    var i: usize = 0
    while i < 6 {
        bytes.put_u8(&b, 0x80 as u8)
        i = i + 1
    }
    bytes.bytes_reset(&b)
    let toolong: i32 = bytes.get_varint(&b) catch 0 - 12345
    if toolong != 0 - 12345 { return 51 }
    bytes.bytes_clear(&b)
    // Underflow on a plain read as well
    bytes.put_u8(&b, 1 as u8)
    bytes.bytes_reset(&b)
    let short32: u32 = bytes.get_u32(&b) catch 4242 as u32
    if short32 != 4242 as u32 { return 52 }
    bytes.bytes_clear(&b)

    // ------------------------------------- 6. roundtrip over 20,000 values
    var x: u64 = 76767676
    var k: usize = 0
    while k < 20000 {
        x = next_state(x)
        let v: i32 = bytes.bits_i32((x >> 32) as u32)
        bytes.bytes_clear(&b)
        bytes.put_varint(&b, v)
        if bytes.bytes_len(&b) != bytes.varint_size(v) { return 60 }
        bytes.bytes_reset(&b)
        let back: i32 = bytes.get_varint(&b) catch 0 - 1
        if back != v { return 61 }
        if bytes.bytes_remaining(&b) != 0 { return 62 }

        let w: i64 = x as i64
        bytes.bytes_clear(&b)
        bytes.put_varlong(&b, w)
        if bytes.bytes_len(&b) != bytes.varlong_size(w) { return 63 }
        bytes.bytes_reset(&b)
        let back64: i64 = bytes.get_varlong(&b) catch 0 - 1
        if back64 != w { return 64 }
        if bytes.bytes_remaining(&b) != 0 { return 65 }

        // big endian widths, there and back. ROUND 83: cutting a `u64`
        // down to 16 or 32 bits is a narrowing `as` and is CHECKED (SPEC
        // 13, item L9) -- what is meant here is the low half, so the mask
        // says it.
        let x16: u16 = (x & 65535) as u16
        let x32: u32 = ((x >> 16) & 4294967295) as u32
        bytes.bytes_clear(&b)
        bytes.put_u16(&b, x16)
        bytes.put_u32(&b, x32)
        bytes.put_u64(&b, x)
        bytes.put_f64(&b, (x >> 11) as f64)
        bytes.put_f32(&b, (x >> 40) as f32)
        bytes.bytes_reset(&b)
        if (bytes.get_u16(&b) catch 0 as u16) != x16 { return 66 }
        if (bytes.get_u32(&b) catch 0 as u32) != x32 { return 67 }
        if (bytes.get_u64(&b) catch 0 as u64) != x { return 68 }
        if (bytes.get_f64(&b) catch 0.0) != (x >> 11) as f64 { return 69 }
        if (bytes.get_f32(&b) catch 0.0f) != (x >> 40) as f32 { return 70 }

        // the position bit field over the whole range it covers
        let qx: i32 = bytes.bits_i32(((x >> 3) & 4294967295) as u32) % 33554432
        let qz: i32 = bytes.bits_i32(((x >> 21) & 4294967295) as u32) % 33554432
        let qy: i32 = bytes.bits_i32(((x >> 47) & 4294967295) as u32) % 2048
        bytes.bytes_clear(&b)
        bytes.put_position(&b, qx, qy, qz)
        bytes.bytes_reset(&b)
        let okq: bool = bytes.get_position(&b, &px, &py, &pz) catch false
        if !okq { return 71 }
        if px != qx { return 72 }
        if py != qy { return 73 }
        if pz != qz { return 74 }
        k = k + 1
    }

    // ------------------------------------------------------- 7. zigzag, named
    // Not used by the Java protocol -- but if it is offered it has to be
    // right, and the difference to the VarInt above has to be visible.
    if bytes.zigzag_encode(0) != 0 as u32 { return 80 }
    if bytes.zigzag_encode(0 - 1) != 1 as u32 { return 81 }
    if bytes.zigzag_encode(1) != 2 as u32 { return 82 }
    if bytes.zigzag_encode(0 - 2) != 3 as u32 { return 83 }
    if bytes.zigzag_decode(bytes.zigzag_encode(0 - 12345)) != 0 - 12345 { return 84 }
    if bytes.zigzag_decode64(bytes.zigzag_encode64(i64_min)) != i64_min { return 85 }
    // and the counter-check: a zigzag -1 would be ONE octet, the protocol
    // wants five. If those two were ever the same, the table above would be
    // meaningless.
    if bytes.varint_size(0 - 1) == 1 { return 86 }
    return 0
}
