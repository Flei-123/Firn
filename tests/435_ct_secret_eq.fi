// expect_exit: 21
// ROUND 96 -- the example out of SPEC 9.1, word for word: comparing two
// secrets WITHOUT a branch that depends on them.
//
// The loop runs over the whole array every time -- its counter is public,
// its bound is public, and nothing inside it looks at a secret to decide
// where to go. That is the entire point of the exercise: two arrays that
// differ in the first octet cost exactly as much time as two that are equal.
#[constant_time]
fn ct_eq(a: [secret[u8]; 8], b: [secret[u8]; 8]) -> secret[bool] {
    var acc: secret[u8] = 0
    var i: usize = 0
    while i < 8 {
        acc = acc | (a[i] ^ b[i])
        i = i + 1
    }
    return acc == 0
}

fn main() -> i32 {
    var key: [secret[u8]; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var same: [secret[u8]; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    var first: [secret[u8]; 8] = [9, 2, 3, 4, 5, 6, 7, 8]
    var last: [secret[u8]; 8] = [1, 2, 3, 4, 5, 6, 7, 9]
    var out: i32 = 0
    if declassify(ct_eq(key, same)) {
        out = out + 1
    }
    if declassify(ct_eq(key, first)) {
        out = out + 100
    }
    if declassify(ct_eq(key, last)) {
        out = out + 100
    }
    // The wiped copy has to compare unequal afterwards -- that is what makes
    // `secure_zero` more than a comment (SPEC 9.3, C3).
    var copy: [secret[u8]; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    secure_zero(&copy[0], 8 as usize)
    if declassify(ct_eq(key, copy)) {
        out = out + 100
    }
    var zero: [secret[u8]; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
    if declassify(ct_eq(zero, copy)) {
        out = out + 20
    }
    return out
}
