// expect_exit: 0
// SPEC §3.5: `gc class`, `Gc[T]`, Allokation, Feldzugriff, Statistik.
gc class Zelle {
    naechste: Gc[Zelle],
    wert: u32,
}

fn kette(n: u32) -> AllocError!Gc[Zelle] {
    var kopf: Gc[Zelle] = gc_null[Zelle]()
    var i: u32 = 0
    while i < n {
        kopf = try gc Zelle{ naechste: kopf, wert: i }
        i = i + 1
    }
    return kopf
}

fn summe(k: Gc[Zelle]) -> u32 {
    var s: u32 = 0
    var c: Gc[Zelle] = k
    while c != gc_null[Zelle]() {
        s = s + c.wert
        c = c.naechste
    }
    return s
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    let k = kette(10) catch gc_null[Zelle]()
    if k == gc_null[Zelle]() {
        return 1
    }
    // 0+1+…+9 = 45
    if summe(k) != 45 {
        return 2
    }
    if gc_heap_bytes() == 0 {
        return 4
    }
    // Der Sammler laeuft nur an Allokationsstellen und bei gc_collect().
    if gc_collections() != 0 {
        return 5
    }
    gc_collect()
    if gc_collections() != 1 {
        return 6
    }
    // Die Kette haengt noch an `k` — sie muss den Lauf ueberleben.
    if summe(k) != 45 {
        return 7
    }
    if gc_live_objects() < 10 {
        return 8
    }
    if gc_pause_ns_last() == 0 {
        return 9
    }
    return 0
}
