// expect_exit: 0
// SPEC 3.5: `gc class`, `Gc[T]`, allocation, field access, statistics.
gc class Cell {
    next: Gc[Cell],
    value: u32,
}

fn chain(n: u32) -> AllocError!Gc[Cell] {
    var header: Gc[Cell] = gc_null[Cell]()
    var i: u32 = 0
    while i < n {
        header = try gc Cell { next: header, value: i }
        i = i + 1
    }
    return header
}

fn sum(k: Gc[Cell]) -> u32 {
    var s: u32 = 0
    var c: Gc[Cell] = k
    while c != gc_null[Cell]() {
        s = s + c.value
        c = c.next
    }
    return s
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    let k = chain(10) catch gc_null[Cell]()
    if k == gc_null[Cell]() {
        return 1
    }
    // 0+1+...+9 = 45
    if sum(k) != 45 {
        return 2
    }
    if gc_heap_bytes() == 0 {
        return 4
    }
    // The collector only runs at allocation sites and at gc_collect().
    if gc_collections() != 0 {
        return 5
    }
    gc_collect()
    if gc_collections() != 1 {
        return 6
    }
    // The chain still hangs on `k` -- it has to survive the run.
    if sum(k) != 45 {
        return 7
    }
    if gc_live_objects() < 10 {
        return 8
    }
    if gc_pause_ns_last() == 0 {
        return 9
    }
    return 0
}
