// expect_out: [Hello][ world][,][ it]['s][ ][2][0][2][6][!][ Größe][ ][ äöü][  ][ x][	][	yo][ ...?!][ '][RE][ ][ '][x]
import std.rt
import std.io
import bpe.pretok as pt

fn main() -> i32 {
    let s: str = "Hello world, it's 2026! Größe  äöü   x\t\tyo ...?! 'RE  'x"
    var out: str = ""
    var i: usize = 0
    while i < s.n {
        let e: usize = pt.next_piece(s.p as u64, s.n, i)
        out = out + "[" + s[i:e] + "]"
        i = e
    }
    io.print_line(out)
    return 0
}
