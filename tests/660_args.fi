// expect_exit: 0
// CALL ARGUMENTS -- `fn main(start: u64) -> i32`.
//
// At process start `rsp` points at [argc][argv0]..[argvN][0][envp..].
// `_start` puts this pointer into `rdi`, that is into the first parameter of
// `main`. Programs with `fn main() -> i32` never notice it.
//
// Without it a program written in Firn cannot take a file name -- and
// `firnc1` has to be able to do exactly that.
import modules.rt

fn main(start: u64) -> i32 {
    // In the test the program runs without further arguments: argc == 1,
    // argv[0] is the program name and ends in "660_args" or similar.
    if rt.arg_count(start) < 1 {
        return 1
    }
    let p: u64 = rt.arg_ptr(start, 0)
    if p == 0 {
        return 2
    }
    let n: usize = rt.c_length(p)
    if n == 0 {
        return 3
    }
    // The program name contains no null octet before its end.
    var i: usize = 0
    while i < n {
        if rt.ld8(p, i) == 0 as u8 {
            return 4
        }
        i = i + 1
    }
    // Beyond argc there is nothing.
    if rt.arg_ptr(start, rt.arg_count(start)) != 0 {
        return 5
    }
    // The argv list is terminated by a null pointer.
    if rt.ld64(start, 1 + rt.arg_count(start)) != 0 {
        return 6
    }
    // `c_length` on a null pointer is 0, not a crash.
    if rt.c_length(0) != 0 {
        return 7
    }
    return 0
}
