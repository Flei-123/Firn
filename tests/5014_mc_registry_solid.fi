// expect_exit: 0
import std.rt
import mc.mc_registry
import mc.mc_version
import mc.mc_versions

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn first_state(r: *mut mc_registry.Registry, name: str) -> i32 {
    let b: i32 = mc_registry.reg_block_by_name(r, name.p as u64, name.n)
    if b < 0 { return 0 - 1 }
    return mc_registry.reg_block_default_state(r, b)
}

fn solid_of(tab: u64, r: *mut mc_registry.Registry, name: str) -> i32 {
    let s: i32 = first_state(r, name)
    if s < 0 { return 0 - 1 }
    return rt.ld16(tab, s as usize) as i32
}

fn opaque_of(tab: u64, r: *mut mc_registry.Registry, name: str) -> i32 {
    let s: i32 = first_state(r, name)
    if s < 0 { return 0 - 1 }
    return rt.ld8(tab, s as usize) as i32
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 1)
    var r: mc_registry.Registry = v.registry_of()
    check(mc_registry.registry_ok(&r), 2)
    let n: usize = 32768
    let sol: u64 = rt.heap_alloc(n * 2)
    let opq: u64 = rt.heap_alloc(n)
    mc_registry.reg_fill_solid(&r, sol, n)
    mc_registry.reg_fill_opaque(&r, opq)
    check(solid_of(sol, &r, "stone") == 1, 10)
    check(solid_of(sol, &r, "slime_block") == 1, 11)
    check(solid_of(sol, &r, "glass") == 1, 12)
    check(solid_of(sol, &r, "red_stained_glass") == 1, 13)
    check(solid_of(sol, &r, "ice") == 1, 14)
    check(solid_of(sol, &r, "oak_leaves") == 1, 15)
    check(solid_of(sol, &r, "barrier") == 1, 16)
    check(solid_of(sol, &r, "air") == 0, 20)
    check(solid_of(sol, &r, "water") == 0, 21)
    check(solid_of(sol, &r, "dandelion") == 0, 22)
    check(solid_of(sol, &r, "torch") == 0, 23)
    check(opaque_of(opq, &r, "stone") == 1, 30)
    check(opaque_of(opq, &r, "slime_block") == 0, 31)
    check(opaque_of(opq, &r, "glass") == 0, 32)
    check(opaque_of(opq, &r, "ice") == 0, 33)
    check(rt.ld16(sol, 0) == 0 as u16, 34)
    let small: u64 = rt.heap_alloc(16)
    rt.st16(small, 4, 7 as u16)
    mc_registry.reg_fill_solid(&r, small, 4)
    check(rt.ld16(small, 0) == 0 as u16, 35)
    check(rt.ld16(small, 1) == 1 as u16, 36)
    check(rt.ld16(small, 4) == 7 as u16, 37)
    return 0
}
