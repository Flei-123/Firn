// expect_exit: 0
// mc_dig for the other generated versions (1.16.5, 1.18.2, 1.19.4, 1.20.2): vanilla break times through mc_dig_sel.
// Return codes: 1xx = table/registry missing, 2xx = wrong time, 3xx = wrong harvest.
import std.rt
import mc.mc_registry
import mc.mc_dig
import mc.mc_dig_sel
import mc.v754.mc_reg_v754
import mc.v758.mc_reg_v758
import mc.v762.mc_reg_v762
import mc.v764.mc_reg_v764

fn ticks(r: *mut mc_registry.Registry, d: *mut mc_dig.DigData, blk: str, tool: str, ground: bool) -> i32 {
    let b: i32 = mc_registry.reg_block_by_name(r, blk.p as u64, blk.n)
    if b < 0 { return 0 - 99 }
    var it: i32 = 0 - 1
    if tool.n > 0 {
        it = mc_registry.reg_item_by_name(r, tool.p as u64, tool.n)
        if it < 0 { return 0 - 98 }
    }
    return mc_dig.dig_ticks(d, b, mc_registry.reg_block_hardness_milli(r, b), it, 0, ground, false)
}

fn harvest(r: *mut mc_registry.Registry, d: *mut mc_dig.DigData, blk: str, tool: str) -> bool {
    let b: i32 = mc_registry.reg_block_by_name(r, blk.p as u64, blk.n)
    var it: i32 = 0 - 1
    if tool.n > 0 { it = mc_registry.reg_item_by_name(r, tool.p as u64, tool.n) }
    return mc_dig.dig_can_harvest(d, b, it)
}

// 0 = ok
fn check(r: *mut mc_registry.Registry, d: *mut mc_dig.DigData) -> i32 {
    if !mc_registry.registry_ok(r) { return 100 }
    if !mc_dig.dig_ok(d) { return 101 }
    if ticks(r, d, "stone", "", true) != 150 { return 200 }
    if ticks(r, d, "stone", "iron_pickaxe", true) != 8 { return 201 }
    if ticks(r, d, "stone", "iron_pickaxe", false) != 38 { return 202 }
    if ticks(r, d, "dirt", "", true) != 15 { return 203 }
    if ticks(r, d, "dirt", "iron_shovel", true) != 3 { return 204 }
    if ticks(r, d, "oak_log", "iron_axe", true) != 10 { return 205 }
    if ticks(r, d, "obsidian", "diamond_pickaxe", true) != 188 { return 206 }
    if ticks(r, d, "bedrock", "diamond_pickaxe", true) != 0 - 1 { return 207 }
    if harvest(r, d, "iron_ore", "wooden_pickaxe") { return 300 }
    if !harvest(r, d, "iron_ore", "stone_pickaxe") { return 301 }
    if !harvest(r, d, "dirt", "") { return 302 }
    return 0
}

fn main() -> i32 {
    var r754: mc_registry.Registry = mc_reg_v754.registry_make()
    var d754: mc_dig.DigData = mc_dig_sel.dig_for_protocol(754)
    let a: i32 = check(&r754, &d754)
    if a != 0 { return a + 1000 }
    var r758: mc_registry.Registry = mc_reg_v758.registry_make()
    var d758: mc_dig.DigData = mc_dig_sel.dig_for_protocol(758)
    let b: i32 = check(&r758, &d758)
    if b != 0 { return b + 2000 }
    var r762: mc_registry.Registry = mc_reg_v762.registry_make()
    var d762: mc_dig.DigData = mc_dig_sel.dig_for_protocol(762)
    let c: i32 = check(&r762, &d762)
    if c != 0 { return c + 3000 }
    var r764: mc_registry.Registry = mc_reg_v764.registry_make()
    var d764: mc_dig.DigData = mc_dig_sel.dig_for_protocol(764)
    let e: i32 = check(&r764, &d764)
    if e != 0 { return e + 4000 }
    var none: mc_dig.DigData = mc_dig_sel.dig_for_protocol(999)
    if mc_dig.dig_ok(&none) { return 5000 }
    return 0
}
