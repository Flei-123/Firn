import jxl.jxl_frame
import jxl.jxl_lfdata
import jxl.jxl_vardct
import std.fs
import std.math
import std.rt

static mut failures: i32 = 0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

const BIAS: f64 = 0.0037930732552754493

fn lin(v: u8) -> f64 {
    let c: f64 = (v as f64) / 255.0
    if c <= 0.04045 {
        return c / 12.92
    }
    return math.powf((c + 0.055) / 1.055, 2.4)
}

fn xyb_of(p: u64, i: usize, c: usize) -> f64 {
    let r: f64 = lin(rt.ld8(p, i * 3))
    let g: f64 = lin(rt.ld8(p, i * 3 + 1))
    let b: f64 = lin(rt.ld8(p, i * 3 + 2))
    let third: f64 = 1.0 / 3.0
    let cb: f64 = math.powf(BIAS, third)
    let l: f64 = math.powf(0.30 * r + 0.622 * g + 0.078 * b + BIAS, third) - cb
    let m: f64 = math.powf(0.23 * r + 0.692 * g + 0.078 * b + BIAS, third) - cb
    if c == 0 {
        return (l - m) / 2.0
    }
    if c == 1 {
        return (l + m) / 2.0
    }
    let s: f64 = math.powf(0.24342268924547819 * r + 0.20476744424496821 * g + (1.0 - 0.24342268924547819 - 0.20476744424496821) * b + BIAS, third) - cb
    return s
}

fn ppm_body(d: *mut rt.Buf, n: usize) -> usize {
    var nl: u32 = 0
    var i: usize = 0
    while i < n && nl < 3 {
        if rt.ld8(rt.buf_ptr(d), i) == 10 {
            nl = nl + 1
        }
        i = i + 1
    }
    return i
}

fn check_dc(v: *mut jxl_vardct.JxlVardct, ppm: str, w: usize, h: usize, tol: f64) {
    var d: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(ppm, &d) catch 0
    check(n != 0)
    let body: u64 = rt.buf_ptr(&d) + (ppm_body(&d, n) as u64)
    var by: usize = 0
    while by < (*v).data.bh {
        var bx: usize = 0
        while bx < (*v).data.bw {
            var c: usize = 0
            while c < 3 {
                var sum: f64 = 0.0
                var k: usize = 0
                while k < 64 {
                    var x: usize = bx * 8 + k % 8
                    var y: usize = by * 8 + k / 8
                    if x >= w {
                        x = w - 1
                    }
                    if y >= h {
                        y = h - 1
                    }
                    sum = sum + xyb_of(body, y * w + x, c)
                    k = k + 1
                }
                check(math.fabs(sum / 64.0 - jxl_lfdata.lfd_dc_get(&(*v).data, c, bx, by)) < tol)
                c = c + 1
            }
            bx = bx + 1
        }
        by = by + 1
    }
    rt.buf_free(&d)
}

fn expect(path: str, ppm: str, w: u32, h: u32, varied: bool) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    check(n != 0)
    var v: jxl_vardct.JxlVardct = jxl_vardct.vd_new()
    let r: i32 = jxl_vardct.vd_open(rt.buf_ptr(&data), n, &v)
    check(r == 0)
    if r == 0 {
        check(v.data.bw == ((w as usize) + 7) / 8)
        check(v.data.bh == ((h as usize) + 7) / 8)
        var g: usize = 0
        while g < (v.doc.frame.num_lf_groups as usize) {
            var end: usize = 0
            let rg: i32 = jxl_vardct.vd_decode_lf_group(&v, g, &end)
            check(rg == 0)
            if v.doc.frame.toc_count == 1 {
                check(end > v.lfg_end && end <= jxl_frame.jf_section_size(&v.doc.frame, 0))
            } else {
                check(end == jxl_frame.jf_section_size(&v.doc.frame, 1 + g))
            }
            g = g + 1
        }
        var other: u32 = 0
        var y: usize = 0
        while y < v.data.bh {
            var x: usize = 0
            while x < v.data.bw {
                check(jxl_lfdata.lfd_acs_valid(&v.data, x, y))
                if jxl_lfdata.lfd_acs_is_first(&v.data, x, y) && jxl_lfdata.lfd_acs_type(&v.data, x, y) != 0 {
                    other = other + 1
                }
                x = x + 1
            }
            y = y + 1
        }
        check(!varied || other > 0)
        if ppm.n != 0 {
            check_dc(&v, ppm, w as usize, h as usize, 0.02)
        }
    }
    jxl_vardct.vd_free(&v)
    rt.buf_free(&data)
}

fn main() -> i32 {
    expect("tests/data/jxl/vd/s64.jxl", "tests/data/jxl/vd/s64.ppm", 64, 64, false)
    expect("tests/data/jxl/vd/t64.jxl", "tests/data/jxl/vd/t64.ppm", 64, 64, false)
    expect("tests/data/jxl/vd/t37x29.jxl", "tests/data/jxl/vd/t37x29.ppm", 37, 29, false)
    expect("tests/data/jxl/vd/s300x200.jxl", "", 300, 200, false)
    expect("tests/data/jxl/vd/s600x300.jxl", "", 600, 300, false)
    expect("tests/data/jxl/vd/t64_e7.jxl", "tests/data/jxl/vd/t64.ppm", 64, 64, true)
    expect("tests/data/jxl/vd/t37x29_e7.jxl", "tests/data/jxl/vd/t37x29.ppm", 37, 29, true)
    expect("tests/data/jxl/vd/s300x200_e7.jxl", "", 300, 200, true)
    expect("tests/data/jxl/vd/s600x300_e7.jxl", "", 600, 300, true)
    return failures
}
