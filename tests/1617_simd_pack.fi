// expect_exit: 0
// tests/1617_simd_pack.fi -- RUNDE TEMPO 7: verzahnen und halb schreiben.
//
// `punpckldq`/`punpckhdq` legen zwei Vektoren spurweise ineinander -- damit
// werden aus zwei Paaren nebeneinanderliegender Werte genau die vier, die
// die Synthesefilterbank braucht. `__v128_store64` schreibt nur die untere
// Haelfte; ein volles Schreiben wuerde die beiden Werte daneben zerstoeren.
// Der Test prueft beides Spur fuer Spur, in allen Baustufen und auf beiden
// Maschinen.
fn main() -> i32 {
    var a: [f32; 4] = [1.0f, 2.0f, 3.0f, 4.0f]
    var b: [f32; 4] = [10.0f, 20.0f, 30.0f, 40.0f]
    var r: [f32; 4] = [0.0f; 4]
    let va: v128 = __v128_load(((&a[0]) as u64) as *u8)
    let vb: v128 = __v128_load(((&b[0]) as u64) as *u8)
    __v128_store(((&r[0]) as u64) as *mut u8, __v128_unpacklo32(va, vb))
    if r[0] != 1.0f { return 1 }
    if r[1] != 10.0f { return 2 }
    if r[2] != 2.0f { return 3 }
    if r[3] != 20.0f { return 4 }
    __v128_store(((&r[0]) as u64) as *mut u8, __v128_unpackhi32(va, vb))
    if r[0] != 3.0f { return 5 }
    if r[1] != 30.0f { return 6 }
    // store64: nur die unteren zwei Spuren
    var c: [f32; 4] = [99.0f, 99.0f, 99.0f, 99.0f]
    __v128_store64(((&c[0]) as u64) as *mut u8, va)
    if c[0] != 1.0f { return 7 }
    if c[1] != 2.0f { return 8 }
    if c[2] != 99.0f { return 9 }
    if c[3] != 99.0f { return 10 }
    return 0
}
