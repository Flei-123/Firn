// expect_exit: 0
import std.rt
import std.env
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_creative
import mc.mc_creative_ui
import mc.mc_creative_rules
import mc.mc_item_src
import mc.mc_raster
import html.mem
import paint.canvas
import paint.png

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn dump(r: *mut mc_raster.Raster, path: str) {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, (*r).w as usize, (*r).h as usize) { return }
    rt.mem_copy(canvas.canvas_pixels(&cv) as u64, (*r).color, ((*r).w as usize) * ((*r).h as usize) * 4)
    var enc: mem.Buf = mem.buf_new()
    if png.write_png(&cv, &enc) { rt.write_file(path.p as u64, mem.buf_ptr(&enc) as u64, mem.buf_len(&enc)) }
    mem.buf_free(&enc)
    canvas.canvas_free(&cv)
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 1)
    var reg: mc_registry.Registry = v.registry_of()
    var cr: mc_creative.Creative = mc_creative.cr_new()
    check(mc_creative.cr_build(&cr, &reg), 2)
    mc_creative.cr_select(&cr, &reg, mc_creative_rules.TAB_BUILDING)
    let s: i32 = 2
    let px: i32 = 100
    let py: i32 = 100
    var x: i32 = 0
    var y: i32 = 0
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + (9 + 8) * s, py + (18 + 8) * s) == mc_creative_ui.HIT_PICK0, 3)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + (9 + 18 * 8 + 8) * s, py + (18 + 18 * 4 + 8) * s) == mc_creative_ui.HIT_PICK0 + 44, 4)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + (9 + 18 * 3 + 8) * s, py + (112 + 8) * s) == 39, 5)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + 176 * s, py + 30 * s) == mc_creative_ui.HIT_SCROLL, 6)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px - 10 * s, py + 30 * s) == mc_creative_ui.HIT_OUTSIDE, 7)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + 13 * s, py - 10 * s) == mc_creative_ui.HIT_TAB0, 8)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + 27 * 2 * s + 13 * s, py - 10 * s) == mc_creative_ui.HIT_TAB0 + 2, 9)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + 13 * s, py + 140 * s) == mc_creative_ui.HIT_TAB0 + 6, 10)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + 190 * s, py + 140 * s) == mc_creative_ui.HIT_TAB0 + 11, 11)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + 190 * s, py - 10 * s) == mc_creative_ui.HIT_TAB0 + 5, 12)
    mc_creative.cr_select(&cr, &reg, mc_creative_rules.TAB_INVENTORY)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + (173 + 8) * s, py + (112 + 8) * s) == mc_creative_ui.HIT_DELETE, 13)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + (54 + 8) * s, py + (6 + 8) * s) == 5, 14)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + (108 + 8) * s, py + (33 + 8) * s) == 8, 19)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + (35 + 8) * s, py + (20 + 8) * s) == 45, 15)
    check(mc_creative_ui.crui_hit(&cr, px, py, s, px + (9 + 8) * s, py + (54 + 8) * s) == 9, 16)
    check(mc_creative_ui.crui_slot_xy(mc_creative_rules.TAB_INVENTORY, 40, &x, &y) && x == 9 + 72 && y == 112, 17)
    check(!mc_creative_ui.crui_slot_xy(mc_creative_rules.TAB_BUILDING, 20, &x, &y), 18)
    let d: str = env.get("CREATIVE_DUMP")
    if env.has("MC_VANILLA_JAR") && d.n > 0 {
        var src: mc_item_src.ItemSrc = mc_item_src.isrc_new()
        check(mc_item_src.isrc_open(&src, 763), 20)
        var u: mc_creative_ui.CrUi = mc_creative_ui.crui_new()
        check(mc_creative_ui.crui_open(&u, &src), 21)
        var r: mc_raster.Raster = mc_raster.raster_new(220 * s * 3, 190 * s)
        mc_raster.raster_clear(&r, 0xFF303030 as u32)
        mc_creative.cr_select(&cr, &reg, mc_creative_rules.TAB_BUILDING)
        mc_creative_ui.crui_draw(&r, &u, &cr, 12 * s, 32 * s, s)
        mc_creative.cr_select(&cr, &reg, mc_creative_rules.TAB_SEARCH)
        mc_creative.cr_query_push(&cr, &reg, 105 as u32)
        mc_creative.cr_query_push(&cr, &reg, 114 as u32)
        mc_creative_ui.crui_draw(&r, &u, &cr, (220 + 12) * s, 32 * s, s)
        mc_creative.cr_select(&cr, &reg, mc_creative_rules.TAB_INVENTORY)
        mc_creative_ui.crui_draw(&r, &u, &cr, (440 + 12) * s, 32 * s, s)
        dump(&r, d)
        mc_creative_ui.crui_free(&u)
        mc_item_src.isrc_free(&src)
    }
    mc_creative.cr_free(&cr)
    return 0
}
