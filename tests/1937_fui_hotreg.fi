// expect_exit: 0
import fui.hotreg
import fui.kit
import std.rt

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn frame() {
    hotreg.begin_frame()
    let _a: u32 = hotreg.state(1 as u32, 10.0, 10.0, 100.0, 30.0, true)
    let _b: u32 = hotreg.state(2 as u32, 10.0, 50.0, 100.0, 30.0, true)
    let _c: u32 = hotreg.state(3 as u32, 10.0, 90.0, 100.0, 30.0, false)
    let _d: u32 = hotreg.state(4 as u32, 40.0, 10.0, 30.0, 30.0, true)
}

fn main() -> i32 {
    hotreg.reset()
    frame()
    check("nothing hot before the first finished frame", !hotreg.move(20.0, 20.0) && !hotreg.over())
    frame()
    check("move onto a control changes", hotreg.move(20.0, 20.0))
    check("hot id", hotreg.hot() == 1 as u32 && hotreg.over())
    check("same control again does not change", !hotreg.move(25.0, 22.0))
    check("later control wins when drawn on top", hotreg.move(50.0, 20.0) && hotreg.hot() == 4 as u32)
    check("move to another control", hotreg.move(20.0, 60.0) && hotreg.hot() == 2 as u32)
    check("empty space clears", hotreg.move(300.0, 300.0) && !hotreg.over())
    check("empty to empty is no change", !hotreg.move(301.0, 300.0))
    check("disabled control is never hot", !hotreg.move(20.0, 100.0) && hotreg.hot() == 0 as u32)
    let _m: bool = hotreg.move(20.0, 20.0)
    hotreg.begin_frame()
    let st: u32 = hotreg.state(1 as u32, 10.0, 10.0, 100.0, 30.0, true)
    check("state carries hover", (st & kit.ST_HOVER) != 0 as u32 && (st & kit.ST_ACTIVE) == 0 as u32)
    check("other control has no bits", hotreg.state(2 as u32, 10.0, 50.0, 100.0, 30.0, true) == 0 as u32)
    check("disabled state", hotreg.state(3 as u32, 10.0, 90.0, 100.0, 30.0, false) == kit.ST_DISABLED)
    check("down presses", hotreg.down(20.0, 20.0) || hotreg.pressed() == 1 as u32)
    hotreg.begin_frame()
    let sp: u32 = hotreg.state(1 as u32, 10.0, 10.0, 100.0, 30.0, true)
    check("state carries active", (sp & kit.ST_ACTIVE) != 0 as u32)
    check("up releases", hotreg.up() && hotreg.pressed() == 0 as u32)
    check("up again is no change", !hotreg.up())
    hotreg.set_focus(2 as u32)
    hotreg.begin_frame()
    check("focus bit", (hotreg.state(2 as u32, 10.0, 50.0, 100.0, 30.0, true) & kit.ST_FOCUS) != 0 as u32)
    check("leave clears hover", hotreg.leave() && !hotreg.over())
    check("leave again is no change", !hotreg.leave())
    hotreg.touch(true)
    frame()
    frame()
    check("touch: move never hovers", !hotreg.move(20.0, 20.0) && !hotreg.over())
    let _td: bool = hotreg.down(20.0, 20.0)
    check("touch: down waits for the settle", hotreg.pressed() == 0 as u32 && hotreg.press_pending() && !hotreg.over())
    check("touch: settle presses", hotreg.press_settle() && hotreg.pressed() == 1 as u32)
    check("touch: up leaves nothing behind", hotreg.up() && !hotreg.over() && hotreg.pressed() == 0 as u32)
    hotreg.touch(false)
    hotreg.reset()
    hotreg.begin_frame()
    hotreg.clip_push(0.0, 0.0, 100.0, 50.0)
    let _c1: u32 = hotreg.state(7 as u32, 10.0, 30.0, 80.0, 60.0, true)
    let _c2: u32 = hotreg.state(8 as u32, 10.0, 70.0, 80.0, 20.0, true)
    hotreg.clip_push(0.0, 0.0, 50.0, 100.0)
    let _c3: u32 = hotreg.state(9 as u32, 60.0, 10.0, 30.0, 20.0, true)
    hotreg.clip_pop()
    hotreg.clip_pop()
    let _c4: u32 = hotreg.state(10 as u32, 200.0, 200.0, 10.0, 10.0, true)
    hotreg.begin_frame()
    check("clip: visible part hits", hotreg.move(20.0, 40.0) && hotreg.hot() == 7 as u32)
    check("clip: clipped part does not hit", hotreg.move(20.0, 60.0) && hotreg.hot() == 0 as u32)
    check("clip: fully clipped control is not registered", !hotreg.move(70.0, 15.0))
    check("clip: outside the clip registers normally", hotreg.move(205.0, 205.0) && hotreg.hot() == 10 as u32)
    hotreg.reset()
    var i: usize = 0
    while i < 1100 {
        let _x: u32 = hotreg.state((i + 1) as u32, 0.0, 0.0, 1.0, 1.0, true)
        i = i + 1
    }
    check("registry is bounded", hotreg.registered() == hotreg.HOT_MAX)
    if failures == 0 {
        return 0
    }
    return 1
}
