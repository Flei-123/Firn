// expect_out: found|MISSED|<found>|found-found|abc|abc|same
// Round GAPS: a `str` literal returned from a function stays valid. The
// octets used to live in the callee's frame, so the caller read whatever the
// next call had written there (f"{say(true)}" printed zeros under
// --no-opt, docs/LUECKEN.md B18). They live in `.rodata` now.
import std.io

fn say(b: bool) -> str {
    if b { return "found" }
    return "MISSED"
}

fn pick(i: i32) -> str {
    if i == 0 { return "abc" }
    return "abc"
}

// scribbles over the stack the literal used to live in
fn noise(d: i32) -> i32 {
    var buf: [u8; 64] = [0 as u8; 64]
    var i: usize = 0
    while i < 64 {
        buf[i] = 35 as u8
        i = i + 1
    }
    if d > 0 { return noise(d - 1) + buf[3] as i32 }
    return buf[5] as i32
}

fn main() -> i32 {
    let a: str = say(true)
    let b: str = say(false)
    let _n: i32 = noise(4)
    let x: str = pick(0)
    let y: str = pick(1)
    var same: str = "differ"
    if x == y { same = "same" }
    io.fmt_print_line(f"{a}|{b}|<{say(true)}>|{say(true)}-{a}|{x}|{y}|{same}")
    return 0
}
