// expect_exit: 0
// Floating point literals exactly in the middle between two doubles.
//
// Round to nearest, ties to EVEN (IEEE-754 4.3.1). Written out to the last
// digit, once exactly in the middle and once one step to either side. A
// reader that rounds up on a tie, or one that stops looking after a few
// digits, gets a third of these wrong.
//
// The check runs over the BIT PATTERN, not over the printed value: two
// doubles that are one ULP apart print the same in almost every format --
// which is why the divergence of round 63 stayed unnoticed for so long.
// The detour through the address is the one from `lib/firnc1/lexer.fi`:
// a direct cast of `&t` to `*mut u64` is read by stage 0 as a value
// conversion, through the address it is a true reinterpretation.

fn bits_of(x: f64) -> u64 {
    var t: f64 = 0.0
    let p: u64 = (&t) as u64
    *(p as *mut f64) = x
    return *(p as *mut u64)
}

fn main() -> i32 {
    // exactly in the middle -> the EVEN mantissa wins
    if bits_of(1.00000000000000011102230246251565404236316680908203125) != 4607182418800017408 {
        return 1
    }
    // one step below the middle -> down
    if bits_of(1.000000000000000111022302462515654042363166809082031249) != 4607182418800017408 {
        return 2
    }
    // one step above the middle -> up
    if bits_of(1.000000000000000111022302462515654042363166809082031251) != 4607182418800017409 {
        return 3
    }
    // exactly in the middle -> the EVEN mantissa wins
    if bits_of(2.0000000000000002220446049250313080847263336181640625) != 4611686018427387904 {
        return 4
    }
    // one step below the middle -> down
    if bits_of(2.00000000000000022204460492503130808472633361816406249) != 4611686018427387904 {
        return 5
    }
    // one step above the middle -> up
    if bits_of(2.00000000000000022204460492503130808472633361816406251) != 4611686018427387905 {
        return 6
    }
    // exactly in the middle -> the EVEN mantissa wins
    if bits_of(0.500000000000000055511151231257827021181583404541015625) != 4602678819172646912 {
        return 7
    }
    // one step below the middle -> down
    if bits_of(0.5000000000000000555111512312578270211815834045410156249) != 4602678819172646912 {
        return 8
    }
    // one step above the middle -> up
    if bits_of(0.5000000000000000555111512312578270211815834045410156251) != 4602678819172646913 {
        return 9
    }
    // exactly in the middle -> the EVEN mantissa wins
    if bits_of(1024.0000000000001136868377216160297393798828125) != 4652218415073722368 {
        return 10
    }
    // one step below the middle -> down
    if bits_of(1024.00000000000011368683772161602973937988281249) != 4652218415073722368 {
        return 11
    }
    // one step above the middle -> up
    if bits_of(1024.00000000000011368683772161602973937988281251) != 4652218415073722369 {
        return 12
    }
    // exactly in the middle -> the EVEN mantissa wins
    if bits_of(3.0000000000000002220446049250313080847263336181640625) != 4613937818241073152 {
        return 13
    }
    // one step below the middle -> down
    if bits_of(3.00000000000000022204460492503130808472633361816406249) != 4613937818241073152 {
        return 14
    }
    // one step above the middle -> up
    if bits_of(3.00000000000000022204460492503130808472633361816406251) != 4613937818241073153 {
        return 15
    }
    // exactly in the middle -> the EVEN mantissa wins
    if bits_of(0.) != 118622047889322842 {
        return 16
    }
    // one step below the middle -> down
    if bits_of(0.) != 118622047889322841 {
        return 17
    }
    // one step above the middle -> up
    if bits_of(0.) != 118622047889322842 {
        return 18
    }
    // exactly in the middle -> the EVEN mantissa wins
    if bits_of(.0) != 9094988921128908188 {
        return 19
    }
    // one step below the middle -> down
    if bits_of(.9) != 9094988921128908188 {
        return 20
    }
    // one step above the middle -> up
    if bits_of(.1) != 9094988921128908189 {
        return 21
    }
    // exactly in the middle -> the EVEN mantissa wins
    if bits_of(9007199254740993.0) != 4845873199050653696 {
        return 22
    }
    // one step below the middle -> down
    if bits_of(9007199254740992.9) != 4845873199050653696 {
        return 23
    }
    // one step above the middle -> up
    if bits_of(9007199254740993.1) != 4845873199050653697 {
        return 24
    }
    // exactly in the middle -> the EVEN mantissa wins
    if bits_of(0.) != 4503599627370496 {
        return 25
    }
    // one step below the middle -> down
    if bits_of(0.) != 4503599627370496 {
        return 26
    }
    // one step above the middle -> up
    if bits_of(0.) != 4503599627370497 {
        return 27
    }
    return 0
}
