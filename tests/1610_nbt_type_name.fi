// expect_exit: 0
// tests/1610_nbt_type_name.fi -- ROUND 79: `nbt.nbt_type_name` after the fix.
//
// The function used to return `(&end[0]) as u64`, the address of a `var`
// array of its OWN frame. It compiled, it was exported, and it dangled --
// gap 9 of docs/ROUND66.md in a shipped library. Nothing called it, which is
// why nothing ever crashed; the escape analysis of round 79 found it anyway.
//
// It now COPIES into a buffer the caller owns. This test is the proof that
// the new form really works: every one of the fourteen names, the length,
// the terminating null octet, and the cutting off of a name that does not
// fit.
import std.nbt

// Are the first `n` octets of `buf` the text `want`?
fn same(buf: *mut u8, want: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if *((buf as usize + i) as *mut u8) != *((want as usize + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

fn check(t: u8, want: *mut u8, n: usize) -> bool {
    var buf: [u8; 32] = [0 as u8; 32]
    let got: usize = nbt.nbt_type_name(t, &buf[0], 32)
    if got != n {
        return false
    }
    if !same(&buf[0], want, n) {
        return false
    }
    // The terminator has to stand behind it.
    if buf[n] != 0 as u8 {
        return false
    }
    return true
}

fn main() -> i32 {
    var s_end: [u8; 7] = "TAG_End"
    var s_byte: [u8; 8] = "TAG_Byte"
    var s_short: [u8; 9] = "TAG_Short"
    var s_int: [u8; 7] = "TAG_Int"
    var s_long: [u8; 8] = "TAG_Long"
    var s_float: [u8; 9] = "TAG_Float"
    var s_double: [u8; 10] = "TAG_Double"
    var s_ba: [u8; 14] = "TAG_Byte_Array"
    var s_st: [u8; 10] = "TAG_String"
    var s_li: [u8; 8] = "TAG_List"
    var s_co: [u8; 12] = "TAG_Compound"
    var s_ia: [u8; 13] = "TAG_Int_Array"
    var s_la: [u8; 14] = "TAG_Long_Array"
    var s_un: [u8; 7] = "TAG_???"

    if !check(nbt.TAG_END, &s_end[0], 7) { return 1 }
    if !check(nbt.TAG_BYTE, &s_byte[0], 8) { return 2 }
    if !check(nbt.TAG_SHORT, &s_short[0], 9) { return 3 }
    if !check(nbt.TAG_INT, &s_int[0], 7) { return 4 }
    if !check(nbt.TAG_LONG, &s_long[0], 8) { return 5 }
    if !check(nbt.TAG_FLOAT, &s_float[0], 9) { return 6 }
    if !check(nbt.TAG_DOUBLE, &s_double[0], 10) { return 7 }
    if !check(nbt.TAG_BYTE_ARRAY, &s_ba[0], 14) { return 8 }
    if !check(nbt.TAG_STRING, &s_st[0], 10) { return 9 }
    if !check(nbt.TAG_LIST, &s_li[0], 8) { return 10 }
    if !check(nbt.TAG_COMPOUND, &s_co[0], 12) { return 11 }
    if !check(nbt.TAG_INT_ARRAY, &s_ia[0], 13) { return 12 }
    if !check(nbt.TAG_LONG_ARRAY, &s_la[0], 14) { return 13 }
    // An unknown octet gets the placeholder.
    if !check(200 as u8, &s_un[0], 7) { return 14 }

    // Too small a buffer: cut off, terminator still written, the length of
    // the WHOLE name reported back.
    var small: [u8; 5] = [255 as u8; 5]
    let n: usize = nbt.nbt_type_name(nbt.TAG_COMPOUND, &small[0], 5)
    if n != 12 { return 15 }
    if !same(&small[0], &s_co[0], 4) { return 16 }
    if small[4] != 0 as u8 { return 17 }

    return 0
}
