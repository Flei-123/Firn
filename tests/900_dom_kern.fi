// expect_exit: 0
// tests/900_dom_kern.fi — DER DOM-KERN (Runde 54, lib/browser/knoten.fi).
//
// Geprueft wird in EINEM Programm, was die Datenstruktur ausmacht, auf der
// Baumaufbau, CSS und Layout aufsetzen:
//
//   * die fuenf Knotenarten (Dokument, Element, Text, Kommentar, Doctype)
//     und die Vererbung (`Gc[Element]` ist kostenlos `Gc[Knoten]`)
//   * Eltern-, Kind- UND BEIDE Geschwisterverweise, alle stark — das ist der
//     Zyklus, fuer den es den Sammler gibt
//   * Einfuegen am Ende, Einfuegen VOR einem Geschwister, Entfernen,
//     Umhaengen aller Kinder (das braucht das Adoption-Agency-Verfahren)
//   * Attribute mit Namensraum und die Regel fuer doppelte Namen
//   * Namensraeume als Marker (HTML, SVG, MathML)
//   * Ketten: Anhaengen, Laenge, Indizieren ueber Stueckgrenzen hinweg,
//     Vergleich, Umwandlung in einen Codepunktpuffer und zurueck
//
// Jeder Rueckgabewert != 0 nennt die Stelle.

import html.mem
import browser.knoten

// Die Knotenart hinter einem Gc-Zeiger. Die Funktion tut wenig und steht
// trotzdem hier: ein `Gc[…]` in einer SIGNATUR ist das Kennzeichen, an dem
// der Parser aus lib/firnc1 erkennt, dass diese Datei nicht mehr Kernsprache
// ist. Ohne sie meldet er einen Syntaxfehler statt "nicht Kern"
// (docs/RUNDE54.md §6.8) — die Datei benutzt GC-Typen, deklariert aber selbst
// keine `gc class`, und genau diesen Fall gab es vor Runde 54 noch nicht.
fn art_von(k: Gc[Knoten]) -> u32 {
    if k == gc_null[Knoten]() {
        return 0
    }
    return k.art
}

fn ketten_probe() -> i32 {
    let k = knoten.kette_neu() catch gc_null[Kette]()
    if k == gc_null[Kette]() {
        return 1
    }
    if !knoten.kette_leer(k) {
        return 2
    }
    // Ueber mehrere Stuecke hinweg (ein Stueck fasst 28 Zeichen).
    var i: u32 = 0
    while i < 100 as u32 {
        let ok: bool = knoten.kette_push(k, 65 as u32 + (i % 26 as u32)) catch false
        if !ok {
            return 3
        }
        i = i + 1
    }
    if knoten.kette_len(k) != 100 {
        return 4
    }
    // Stueckgrenze bei 28: Zeichen 27, 28 und 29 muessen stimmen.
    if knoten.kette_bei(k, 27) != 65 as u32 + 1 as u32 {
        return 5
    }
    if knoten.kette_bei(k, 28) != 65 as u32 + 2 as u32 {
        return 6
    }
    if knoten.kette_bei(k, 99) != 65 as u32 + 21 as u32 {
        return 7
    }
    if knoten.kette_bei(k, 100) != 0 as u32 {
        return 8
    }
    // Gleichheit ueber Stueckgrenzen
    let k2 = knoten.kette_neu() catch gc_null[Kette]()
    i = 0
    while i < 100 as u32 {
        let ok: bool = knoten.kette_push(k2, 65 as u32 + (i % 26 as u32)) catch false
        i = i + 1
    }
    if !knoten.kette_gleich(k, k2) {
        return 9
    }
    let ok3: bool = knoten.kette_push(k2, 33 as u32) catch false
    if knoten.kette_gleich(k, k2) {
        return 10
    }
    // ASCII-Vergleich, auch fallunempfindlich
    let k3 = knoten.kette_neu() catch gc_null[Kette]()
    var lit: [u8; 4] = "html"
    var i2: usize = 0
    while i2 < 4 {
        let ok: bool = knoten.kette_push(k3, lit[i2] as u32) catch false
        i2 = i2 + 1
    }
    if !knoten.kette_gleich_ascii(k3, &lit[0], 4) {
        return 11
    }
    var lit2: [u8; 2] = "ht"
    if !knoten.kette_beginnt_ascii_klein(k3, &lit2[0], 2) {
        return 12
    }
    var lit3: [u8; 4] = "HTML"
    if !knoten.kette_gleich_ascii_klein(k3, &lit3[0], 4) {
        return 13
    }
    if knoten.kette_gleich_ascii(k3, &lit3[0], 4) {
        return 14
    }
    // Hin und zurueck ueber einen Codepunktpuffer
    var puf: mem.CpBuf = mem.cp_neu()
    mem.cp_init(&puf)
    knoten.kette_nach_cpbuf(k, &puf)
    if mem.cp_len(&puf) != 100 {
        return 15
    }
    let k4 = knoten.kette_aus_cpbuf(&puf) catch gc_null[Kette]()
    if !knoten.kette_gleich(k, k4) {
        return 16
    }
    mem.cp_free(&puf)
    return 0
}

fn baum_probe() -> i32 {
    let d = knoten.dokument_neu() catch gc_null[Dokument]()
    if d == gc_null[Dokument]() {
        return 1
    }
    if knoten.dok_modus(d) != knoten.MODUS_KEIN_QUIRKS {
        return 2
    }
    knoten.dok_modus_setzen(d, knoten.MODUS_QUIRKS)
    if knoten.dok_modus(d) != knoten.MODUS_QUIRKS {
        return 3
    }
    let html = knoten.element_neu(1, knoten.NS_HTML) catch gc_null[Element]()
    let a = knoten.element_neu(2, knoten.NS_HTML) catch gc_null[Element]()
    let b = knoten.element_neu(3, knoten.NS_SVG) catch gc_null[Element]()
    let c = knoten.element_neu(4, knoten.NS_MATHML) catch gc_null[Element]()
    if html == gc_null[Element]() || a == gc_null[Element]() {
        return 4
    }
    knoten.kind_anhaengen(d, html)
    knoten.kind_anhaengen(html, a)
    knoten.kind_anhaengen(html, b)
    // Eltern <-> Kind, beide stark: der Zyklus
    if a.eltern != html || html.erstes_kind != a || html.letztes_kind != b {
        return 5
    }
    if a.eltern.erstes_kind != a {
        return 6
    }
    // Geschwister in BEIDE Richtungen
    if a.naechstes != b || b.vorheriges != a {
        return 7
    }
    if a.vorheriges != gc_null[Knoten]() || b.naechstes != gc_null[Knoten]() {
        return 8
    }
    if html.kinder != 2 as u32 {
        return 9
    }
    // Einfuegen VOR einem Geschwister
    knoten.kind_einfuegen_vor(html, c, b)
    if a.naechstes != c || c.naechstes != b || b.vorheriges != c || c.vorheriges != a {
        return 10
    }
    if html.kinder != 3 as u32 {
        return 11
    }
    if knoten.knoten_index(c) != 1 {
        return 12
    }
    if knoten.kind_bei(html, 2) != b {
        return 13
    }
    // Entfernen
    knoten.kind_entfernen(c)
    if a.naechstes != b || b.vorheriges != a || html.kinder != 2 as u32 {
        return 14
    }
    if c.eltern != gc_null[Knoten]() {
        return 15
    }
    // Namensraeume als Marker
    if knoten.element_ns(a) != knoten.NS_HTML || knoten.element_ns(b) != knoten.NS_SVG {
        return 16
    }
    if knoten.element_ns(c) != knoten.NS_MATHML {
        return 17
    }
    if !knoten.element_ist(a, 2) {
        return 18
    }
    // `element_ist` fragt IMMER nach dem HTML-Namensraum
    if knoten.element_ist(b, 3) {
        return 19
    }
    // Vererbung: Aufwaerts kostenlos, abwaerts geprueft
    let n: Gc[Knoten] = a
    if knoten.knoten_als_element(n) != a {
        return 20
    }
    let t = knoten.text_neu(gc_null[Kette]()) catch gc_null[Text]()
    knoten.kind_anhaengen(a, t)
    if knoten.knoten_als_element(t) != gc_null[Element]() {
        return 21
    }
    if !knoten.knoten_ist_element(a) || knoten.knoten_ist_element(t) {
        return 22
    }
    if knoten.knoten_tiefe(t) != 3 as u32 {
        return 23
    }
    if !knoten.knoten_vorfahr_ist(t, html) || knoten.knoten_vorfahr_ist(t, b) {
        return 24
    }
    // Alle Kinder umhaengen (Adoption-Agency-Schritt 16)
    let ziel = knoten.element_neu(9, knoten.NS_HTML) catch gc_null[Element]()
    knoten.kinder_umhaengen(html, ziel)
    if html.kinder != 0 as u32 || ziel.kinder != 2 as u32 {
        return 25
    }
    if ziel.erstes_kind != a || ziel.letztes_kind != b {
        return 26
    }
    if a.eltern != ziel {
        return 27
    }
    // Ein Sammellauf mitten im Betrieb darf nichts Erreichbares wegnehmen.
    let vorher: u64 = gc_collections()
    gc_collect()
    if gc_collections() != vorher + 1 {
        return 28
    }
    if ziel.erstes_kind != a || a.eltern != ziel || a.erstes_kind != t {
        return 29
    }
    return 0
}

fn attribut_probe() -> i32 {
    let e = knoten.element_neu(1, knoten.NS_HTML) catch gc_null[Element]()
    let w1 = knoten.kette_neu() catch gc_null[Kette]()
    let w2 = knoten.kette_neu() catch gc_null[Kette]()
    let w3 = knoten.kette_neu() catch gc_null[Kette]()
    let ok1: bool = knoten.kette_push(w1, 65 as u32) catch false
    let ok2: bool = knoten.kette_push(w2, 66 as u32) catch false
    let ok3: bool = knoten.kette_push(w3, 67 as u32) catch false
    if knoten.attr_zahl(e) != 0 as u32 {
        return 1
    }
    let g1: bool = knoten.attr_setzen(e, 10, 0, w1) catch false
    if !g1 || knoten.attr_zahl(e) != 1 as u32 {
        return 2
    }
    // Doppelter Name im selben Namensraum: wird NICHT gesetzt.
    let g2: bool = knoten.attr_setzen(e, 10, 0, w2) catch false
    if g2 || knoten.attr_zahl(e) != 1 as u32 {
        return 3
    }
    // Derselbe Name in einem ANDEREN Namensraum ist ein anderes Attribut.
    let g3: bool = knoten.attr_setzen(e, 10, knoten.NS_XLINK, w3) catch false
    if !g3 || knoten.attr_zahl(e) != 2 as u32 {
        return 4
    }
    if knoten.attr_wert(e, 10, 0) != w1 {
        return 5
    }
    if knoten.attr_wert(e, 10, knoten.NS_XLINK) != w3 {
        return 6
    }
    if knoten.attr_wert(e, 11, 0) != gc_null[Kette]() {
        return 7
    }
    // Reihenfolge bleibt die des Quelltexts
    let a1: Gc[Attribut] = knoten.attr_erstes(e)
    if a1.name != 10 as u32 || a1.ns != 0 as u32 {
        return 8
    }
    if a1.naechstes.ns != knoten.NS_XLINK {
        return 9
    }
    if a1.naechstes.naechstes != gc_null[Attribut]() {
        return 10
    }
    return 0
}

fn sonderknoten_probe() -> i32 {
    let name = knoten.kette_neu() catch gc_null[Kette]()
    let pub = knoten.kette_neu() catch gc_null[Kette]()
    let sys = knoten.kette_neu() catch gc_null[Kette]()
    let dt = knoten.doctype_neu(name, pub, sys, true, false) catch gc_null[Doctype]()
    if dt == gc_null[Doctype]() {
        return 1
    }
    if art_von(dt) != knoten.K_DOCTYPE || !dt.hat_pubid || dt.hat_sysid {
        return 2
    }
    let km = knoten.kommentar_neu(name) catch gc_null[Kommentar]()
    if art_von(km) != knoten.K_KOMMENTAR {
        return 3
    }
    let tx = knoten.text_neu(name) catch gc_null[Text]()
    if art_von(tx) != knoten.K_TEXT {
        return 4
    }
    let fr = knoten.fragment_neu(7) catch gc_null[Fragment]()
    if art_von(fr) != knoten.K_FRAGMENT || fr.wirt != 7 as u32 {
        return 5
    }
    if art_von(gc_null[Knoten]()) != 0 as u32 {
        return 6
    }
    return 0
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    let a: i32 = ketten_probe()
    if a != 0 {
        return a
    }
    let b: i32 = baum_probe()
    if b != 0 {
        return 30 + b
    }
    let c: i32 = attribut_probe()
    if c != 0 {
        return 70 + c
    }
    let d: i32 = sonderknoten_probe()
    if d != 0 {
        return 90 + d
    }
    return 0
}
