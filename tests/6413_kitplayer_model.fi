// expect_exit: 0
import std.rt
import fui.kpmodel
import fui.kpfmt
import fui.kplayout

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn time_is(ms: u64, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    kpfmt.fmt_time(ms, &b)
    let ok: bool = rt.buf_len(&b) == want.n && rt.mem_eq(rt.buf_ptr(&b), want.p as u64, want.n)
    rt.buf_free(&b)
    return ok
}

fn check_fmt() {
    check(time_is(0 as u64, "0:00"), 1)
    check(time_is(999 as u64, "0:00"), 2)
    check(time_is(1000 as u64, "0:01"), 3)
    check(time_is(61000 as u64, "1:01"), 4)
    check(time_is(599000 as u64, "9:59"), 5)
    check(time_is(3600000 as u64, "1:00:00"), 6)
    check(time_is(3723000 as u64, "1:02:03"), 7)
}

fn check_states() {
    var t: kpmodel.Transport = kpmodel.tr_new()
    check(t.state == kpmodel.TS_EMPTY, 10)
    check(!kpmodel.tr_play(&t), 11)
    check(!kpmodel.tr_seek(&t, 5 as u64), 12)
    kpmodel.tr_load(&t, 10000 as u64)
    check(t.state == kpmodel.TS_READY, 13)
    check(!kpmodel.tr_pause(&t), 14)
    check(kpmodel.tr_play(&t), 15)
    check(t.state == kpmodel.TS_PLAYING, 16)
    check(kpmodel.tr_tick(&t, 2500 as u64, false), 17)
    check(t.pos_ms == 2500 as u64, 18)
    check(kpmodel.tr_pause(&t), 19)
    check(t.state == kpmodel.TS_PAUSED, 20)
    check(!kpmodel.tr_tick(&t, 3000 as u64, false), 21)
    check(t.pos_ms == 2500 as u64, 22)
    check(kpmodel.tr_toggle(&t), 23)
    check(t.state == kpmodel.TS_PLAYING, 24)
    check(kpmodel.tr_tick(&t, 99999 as u64, false), 25)
    check(t.pos_ms == 10000 as u64, 26)
    check(kpmodel.tr_tick(&t, 10000 as u64, true), 27)
    check(t.state == kpmodel.TS_ENDED, 28)
    check(kpmodel.tr_permille(&t, t.pos_ms) == 1000, 29)
    check(kpmodel.tr_play(&t), 30)
    check(t.state == kpmodel.TS_PLAYING, 31)
    var ms: u64 = 77 as u64
    check(kpmodel.tr_take_seek(&t, &ms), 32)
    check(ms == 0 as u64 && t.pos_ms == 0 as u64, 33)
    check(!kpmodel.tr_take_seek(&t, &ms), 34)
    kpmodel.tr_fail(&t)
    check(t.state == kpmodel.TS_FAILED && !kpmodel.tr_play(&t), 35)
}

fn check_seek() {
    var t: kpmodel.Transport = kpmodel.tr_new()
    kpmodel.tr_load(&t, 20000 as u64)
    check(kpmodel.tr_seek(&t, 5000 as u64), 40)
    check(t.state == kpmodel.TS_READY && t.pos_ms == 5000 as u64, 41)
    var ms: u64 = 0 as u64
    check(kpmodel.tr_take_seek(&t, &ms) && ms == 5000 as u64, 42)
    kpmodel.tr_play(&t)
    check(kpmodel.tr_seek(&t, 999999 as u64), 43)
    check(t.pos_ms == 20000 as u64 && t.state == kpmodel.TS_ENDED, 44)
    check(kpmodel.tr_seek(&t, 1000 as u64), 45)
    check(t.state == kpmodel.TS_PLAYING && t.pos_ms == 1000 as u64, 46)
    check(kpmodel.tr_skip(&t, 5000), 47)
    check(t.pos_ms == 6000 as u64, 48)
    check(kpmodel.tr_skip(&t, -100000), 49)
    check(t.pos_ms == 0 as u64, 50)
    check(kpmodel.tr_ms_at(&t, 250) == 5000 as u64, 51)
    check(kpmodel.tr_ms_at(&t, -5) == 0 as u64 && kpmodel.tr_ms_at(&t, 5000) == 20000 as u64, 52)
    check(kpmodel.tr_permille(&t, 10000 as u64) == 500, 53)
}

fn check_scrub() {
    var t: kpmodel.Transport = kpmodel.tr_new()
    kpmodel.tr_load(&t, 10000 as u64)
    kpmodel.tr_play(&t)
    kpmodel.tr_tick(&t, 1000 as u64, false)
    check(kpmodel.tr_scrub_begin(&t, 500), 60)
    check(t.state == kpmodel.TS_PAUSED && t.scrubbing, 61)
    check(kpmodel.tr_display_ms(&t) == 5000 as u64, 62)
    kpmodel.tr_scrub_to(&t, 800)
    check(kpmodel.tr_display_ms(&t) == 8000 as u64 && t.pos_ms == 1000 as u64, 63)
    check(kpmodel.tr_scrub_end(&t), 64)
    check(t.state == kpmodel.TS_PLAYING && !t.scrubbing, 65)
    var ms: u64 = 0 as u64
    check(kpmodel.tr_take_seek(&t, &ms) && ms == 8000 as u64, 66)
    check(!kpmodel.tr_scrub_end(&t), 67)
    kpmodel.tr_pause(&t)
    kpmodel.tr_scrub_begin(&t, 100)
    kpmodel.tr_scrub_end(&t)
    check(t.state == kpmodel.TS_PAUSED && t.pos_ms == 1000 as u64, 68)
    kpmodel.tr_play(&t)
    kpmodel.tr_scrub_begin(&t, 1000)
    kpmodel.tr_scrub_end(&t)
    check(t.state == kpmodel.TS_ENDED, 69)
    var z: kpmodel.Transport = kpmodel.tr_new()
    kpmodel.tr_load(&z, 0 as u64)
    check(!kpmodel.tr_scrub_begin(&z, 500), 70)
}

fn check_volume() {
    var t: kpmodel.Transport = kpmodel.tr_new()
    check(kpmodel.tr_eff_volume(&t) == 100 as u32, 80)
    kpmodel.tr_set_volume(&t, 250 as u32)
    check(t.volume == 100 as u32, 81)
    kpmodel.tr_volume_step(&t, -30)
    check(t.volume == 70 as u32, 82)
    kpmodel.tr_toggle_mute(&t)
    check(t.muted && kpmodel.tr_eff_volume(&t) == 0 as u32, 83)
    kpmodel.tr_toggle_mute(&t)
    check(!t.muted && kpmodel.tr_eff_volume(&t) == 70 as u32, 84)
    kpmodel.tr_toggle_mute(&t)
    kpmodel.tr_volume_step(&t, 10)
    check(!t.muted && t.volume == 10 as u32, 85)
    kpmodel.tr_set_volume(&t, 0 as u32)
    kpmodel.tr_toggle_mute(&t)
    check(t.muted, 88)
    kpmodel.tr_toggle_mute(&t)
    check(!t.muted && t.volume == 50 as u32, 86)
    kpmodel.tr_volume_step(&t, -500)
    check(t.volume == 0 as u32, 87)
}

fn check_layout() {
    var l: kplayout.Layout = kplayout.lay_new()
    kplayout.lay_compute(&l, 10.0, 20.0, 640.0, 400.0, 1.0)
    check(l.has_vol, 90)
    check(l.surface.h == 348.0 && l.bar.y == 368.0 && l.bar.h == 52.0, 91)
    check(kplayout.lay_hit(&l, 20.0, 30.0) == kplayout.HIT_SURFACE, 92)
    check(kplayout.lay_hit(&l, l.play.x + 5.0, l.play.y + 5.0) == kplayout.HIT_PLAY, 93)
    check(kplayout.lay_hit(&l, l.seek.x + l.seek.w / 2.0, l.seek.y + 5.0) == kplayout.HIT_SEEK, 94)
    check(kplayout.lay_hit(&l, l.mute.x + 2.0, l.mute.y + 2.0) == kplayout.HIT_MUTE, 95)
    check(kplayout.lay_hit(&l, l.vol.x + 2.0, l.vol.y + 2.0) == kplayout.HIT_VOL, 96)
    check(kplayout.lay_hit(&l, l.cur.x + 1.0, l.bar.y + 1.0) == kplayout.HIT_BAR, 97)
    check(kplayout.lay_hit(&l, 5.0, 5.0) == kplayout.HIT_NONE, 98)
    check(l.seek.x >= l.cur.x + l.cur.w && l.seek.x + l.seek.w <= l.dur.x, 99)
    check(l.dur.x + l.dur.w <= l.mute.x && l.mute.x + l.mute.w <= l.vol.x, 100)
    check(kplayout.bar_permille(&l, &l.seek, l.seek.x - 50.0) == 0, 101)
    check(kplayout.bar_permille(&l, &l.seek, l.seek.x + l.seek.w + 50.0) == 1000, 102)
    check(kplayout.bar_permille(&l, &l.seek, l.seek.x + l.seek.w / 2.0) == 500, 103)
    var n: kplayout.Layout = kplayout.lay_new()
    kplayout.lay_compute(&n, 0.0, 0.0, 300.0, 200.0, 1.0)
    check(!n.has_vol && n.seek.w > 20.0, 104)
    check(kplayout.lay_hit(&n, 290.0, 190.0) != kplayout.HIT_VOL, 105)
    var s: kplayout.Layout = kplayout.lay_new()
    kplayout.lay_compute(&s, 0.0, 0.0, 640.0, 400.0, 2.0)
    check(s.bar.h == 104.0 && s.play.w == 72.0, 106)
    var tiny: kplayout.Layout = kplayout.lay_new()
    kplayout.lay_compute(&tiny, 0.0, 0.0, 100.0, 30.0, 1.0)
    check(tiny.bar.h == 30.0 && tiny.surface.h == 0.0 && tiny.seek.w >= 0.0, 107)
}

fn check_fit() {
    var area: kplayout.Rect = kplayout.Rect { x: 0.0, y: 0.0, w: 400.0, h: 200.0 }
    var r: kplayout.Rect = kplayout.Rect { x: 0.0, y: 0.0, w: 0.0, h: 0.0 }
    kplayout.fit_rect(160.0, 90.0, &area, &r)
    check(r.h == 200.0 && r.w > 355.0 && r.w < 356.0, 110)
    check(r.x > 21.0 && r.x < 23.0 && r.y == 0.0, 111)
    kplayout.fit_rect(100.0, 400.0, &area, &r)
    check(r.h == 200.0 && r.w == 50.0 && r.x == 175.0, 112)
    kplayout.fit_rect(400.0, 100.0, &area, &r)
    check(r.w == 400.0 && r.h == 100.0 && r.y == 50.0, 113)
    kplayout.fit_rect(0.0, 0.0, &area, &r)
    check(r.w == 0.0 && r.h == 0.0, 114)
}

fn main(start: u64) -> i32 {
    check_fmt()
    check_states()
    check_seek()
    check_scrub()
    check_volume()
    check_layout()
    check_fit()
    return 0
}
