// expect_exit: 0
// tests/1181_layout_stacking.fi -- the PAINT ORDER: who lies on top.
//
// Four boxes that all overlap, and the order they are painted in is not
// the order they stand in:
//
//   #n     z-index -1  -- painted in step 2, BEFORE the body
//   #p     z-index  1  -- a stacking context
//   #deep  z-index 999 -- INSIDE #p, and therefore trapped in it
//   #q     z-index  2  -- a sibling of #p
//
// THE RULE THAT SURPRISES EVERYBODY is the third one: a stacking context
// is an atom. #deep has a z-index of 999 and still lies UNDER #q, because
// #p as a whole lies under #q and nothing inside #p can leave it. Where
// the two overlap, at (200, 100), the topmost box is #q. Where only
// #deep lies, at (120, 100), it is #deep.
//
// The expected order is derived from CSS 2.1, Appendix E by hand and was
// held once against Chromium -- through `document.elementFromPoint`,
// which answers exactly the question the paint order decides
// (tools/layout/stack.py, case 13_zindex_trapped).
//
// The return value names the first check that fails.
import html.mem
import browser.node
import browser.names
import browser.driver
import css.tok
import css.cv
import css.sel
import css.cascade
import layout.box
import layout.build
import layout.flow
import layout.stack

const SOURCE_LEN: usize = 129
const SHEET_LEN: usize = 387

#[no_gc]
fn source(out: *mut mem.Buf) {
    var t: [u8; 129] = "<!DOCTYPE html><html><head></head><body><div id=\"n\"></div><div id=\"p\"><div id=\"deep\"></div></div><div id=\"q\"></div></body></html>"
    mem.buf_clear(out)
    var i: usize = 0
    while i < SOURCE_LEN {
        mem.buf_push(out, t[i])
        i = i + 1
    }
}

#[no_gc]
fn sheet(out: *mut mem.CpBuf) {
    var t: [u8; 387] = "html,body,div{display:block;margin:0;padding:0;border:0}head{display:none}html{font-size:20px}#n{position:absolute;left:0;top:0;width:800px;height:600px;z-index:-1}#p{position:absolute;left:0;top:0;width:300px;height:300px;z-index:1}#deep{position:absolute;left:100px;top:50px;width:300px;height:200px;z-index:999}#q{position:absolute;left:150px;top:0;width:300px;height:300px;z-index:2}"
    mem.cp_clear(out)
    var i: usize = 0
    while i < SHEET_LEN {
        mem.cp_push(out, t[i] as u32)
        i = i + 1
    }
}

fn next_in_order(k: Gc[Node], root: Gc[Node]) -> Gc[Node] {
    if k.first_child != gc_null[Node]() {
        return k.first_child
    }
    var c: Gc[Node] = k
    while c != gc_null[Node]() && c != root {
        if c.next != gc_null[Node]() {
            return c.next
        }
        c = c.parent
    }
    return gc_null[Node]()
}

fn elem_at(doc: Gc[Node], want: u64) -> Gc[Node] {
    var k: Gc[Node] = doc
    var i: u64 = 0
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            if i == want {
                return k
            }
            i = i + 1
        }
        k = next_in_order(k, doc)
    }
    return gc_null[Node]()
}

// The document-order number of the elem a box belongs to -- the same
// numbering `elem_at` uses, so the two can be compared.
fn index_of(doc: Gc[Node], b: Gc[Box]) -> i64 {
    if b == gc_null[Box]() {
        return 0 - 1
    }
    var k: Gc[Node] = doc
    var i: i64 = 0
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            if k == b.elem {
                return i
            }
            i = i + 1
        }
        k = next_in_order(k, doc)
    }
    return 0 - 1
}

fn lay_out(l: *mut driver.Run, src: *mut mem.Buf, css: *mut mem.CpBuf,
    t: *mut tok.Tokens, tmp: *mut mem.CpBuf, cx: *mut sel.Ctx,
    w: *mut cascade.Winner, doc_out: *mut Gc[Node])
-> AllocError!Gc[Box] {
    driver.run_text_out_bytes(l, mem.buf_ptr(src), mem.buf_len(src))
    let rc: u32 = driver.run_document_build(l)
    if rc != 0 as u32 {
        return gc_null[Box]()
    }
    let doc: Gc[Document] = driver.run_document(l)
    let nm: *mut names.Names = driver.run_names(l)
    tok.tokenize(t, css)
    var p: cv.Parser = cv.parser_new(t)
    let sheet_tree = try cv.parse_stylesheet(&p)
    var order: u32 = 0
    let rules = try cascade.collect_rules(sheet_tree, cascade.ORIGIN_AUTHOR, 0,
        nm, tmp, &order)
    let styles = try gcmap_new(true, true)
    let root_style = try cascade.style_root()
    var k: Gc[Node] = doc
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            var parent_style: Gc[Style] = root_style
            let parent: Gc[Node] = k.parent
            if parent != gc_null[Node]() && parent.kind == node.K_ELEM {
                let found: Gc[Style] = gcmap_get_value[Style](styles,
                    parent as u64)
                if found != gc_null[Style]() {
                    parent_style = found
                }
            }
            let s = try cascade.cascade_elem(rules, k, parent_style, cx, w)
            let ok: bool = try gcmap_set_value[Style](styles, k as u64, s)
        }
        k = next_in_order(k, doc)
    }
    let root = try build.build_document(doc, styles, root_style, nm)
    if root == gc_null[Box]() {
        return gc_null[Box]()
    }
    let okl: bool = try flow.layout_document(root, 800.0, 600.0)
    *doc_out = doc
    return root
}

// The topmost elem at a point, as a document-order number.
fn top_at(order: Gc[GcVec], doc: Gc[Node], x: f64, y: f64) -> i64 {
    return index_of(doc, stack.hit_test(order, x, y))
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    var src: mem.Buf = mem.buf_new()
    mem.buf_init(&src)
    source(&src)
    var css: mem.CpBuf = mem.cp_new()
    mem.cp_init(&css)
    sheet(&css)
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var tmp: mem.CpBuf = mem.cp_new()
    var l: driver.Run = driver.run_new()
    if !driver.run_init(&l) {
        return 91
    }
    var cx: sel.Ctx = sel.ctx_new(driver.run_names(&l))
    sel.ctx_init(&cx)
    var w: cascade.Winner = cascade.winner_new()
    var doc: Gc[Node] = gc_null[Node]()
    let root: Gc[Box] = lay_out(&l, &src, &css, &t, &tmp, &cx, &w, &doc)
    catch gc_null[Box]()
    if root == gc_null[Box]() || doc == gc_null[Node]() {
        return 92
    }
    let order: Gc[GcVec] = stack.paint_order(root) catch gc_null[GcVec]()
    if order == gc_null[GcVec]() {
        return 93
    }

    // ---- 1. the order itself: html, #n, body, #p, #deep, #q
    // #n has a NEGATIVE z-index and is therefore painted in step 2, before
    // the body -- which is an ordinary block and belongs to step 3.
    var want: [i64; 6] = [0, 3, 2, 4, 5, 6]
    if gcvec_length(order) != 6 {
        return 1
    }
    var i: u64 = 0
    while i < 6 {
        let b: Gc[Box] = gcvec_read[Box](order, i)
        if index_of(doc, b) != want[i as usize] {
            return 2
        }
        i = i + 1
    }

    // ---- 2. who is on top, point by point
    // Where #deep and #q overlap, #q wins: #deep cannot leave #p.
    if top_at(order, doc, 200.0, 100.0) != 6 {
        return 3
    }
    // Where only #deep lies, #deep wins.
    if top_at(order, doc, 120.0, 100.0) != 5 {
        return 4
    }
    // Where only #p lies, #p wins.
    if top_at(order, doc, 50.0, 10.0) != 4 {
        return 5
    }
    // Where only the negative z-index lies, it is still there -- it is
    // under the blocks, not gone.
    if top_at(order, doc, 700.0, 500.0) != 3 {
        return 6
    }
    // ---- 3. the counter check: outside every box there is nothing. A
    // test that only ever finds something proves nothing about what it
    // finds.
    if stack.hit_test(order, 900.0, 100.0) != gc_null[Box]() {
        return 7
    }
    return 0
}
