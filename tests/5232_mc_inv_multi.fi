// expect_exit: 0
import std.net
import std.rt
import mc.mc_client
import mc.mc_inv
import mc.mc_inv_multi
import mc.mc_registry
import mc.mc_version
import mc.mc_versions

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn total(v: *mut mc_inv.Inv, item: i32) -> i32 {
    var n: i32 = 0
    var k: i32 = 0
    while k < 46 {
        if mc_inv.inv_item(v, k) == item { n = n + mc_inv.inv_count(v, k) }
        k = k + 1
    }
    return n
}

fn main() -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &ver), 1)
    var reg: mc_registry.Registry = ver.registry_of()
    check(mc_registry.registry_ok(&reg), 2)
    let stone: i32 = mc_registry.reg_item_by_name(&reg, "stone".p as u64, 5)
    let dirt: i32 = mc_registry.reg_item_by_name(&reg, "dirt".p as u64, 4)
    var lst: net.Listener = net.listen_tcp(net.ipv4(127 as u8, 0 as u8, 0 as u8, 1 as u8), 0 as u16) catch net.listener_from_fd(0 - 1)
    let port: u16 = net.listener_port(&lst)
    var cc: net.Conn = net.connect_tcp(net.ipv4(127 as u8, 0 as u8, 0 as u8, 1 as u8), port) catch net.conn_from_fd(0 - 1)
    var sc: net.Conn = net.accept(&lst) catch net.conn_from_fd(0 - 1)
    var cl: mc_client.Client = mc_client.client_new(cc, ver)
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_use_registry(&v, &reg)

    var lo: i32 = 0
    var hi: i32 = 0
    check(mc_inv_multi.imulti_group(&v, 20, false, &lo, &hi) && lo == 5 && hi == 45, 3)
    check(mc_inv_multi.imulti_group(&v, 2, false, &lo, &hi) && lo == 1 && hi == 4, 4)
    check(!mc_inv_multi.imulti_group(&v, 0, false, &lo, &hi), 5)

    mc_inv.inv_set(&v, 9, stone, 10)
    mc_inv.inv_set(&v, 10, stone, 10)
    mc_inv.inv_set(&v, 20, stone, 10)
    mc_inv.inv_set(&v, 11, dirt, 7)
    let sent: i32 = mc_inv_multi.imulti_quick_all(&cl, &v, 5, 45, stone, mc_inv.inv_sig(&v, 9))
    check(sent == 3, 6)
    check(mc_inv.inv_item(&v, 9) < 0 && mc_inv.inv_item(&v, 10) < 0 && mc_inv.inv_item(&v, 20) < 0, 7)
    check(total(&v, stone) == 30 && mc_inv.inv_count(&v, 11) == 7, 8)
    check(mc_inv_multi.imulti_quick_all(&cl, &v, 5, 45, 0 - 1, 0) == 0, 9)
    mc_inv.inv_free(&v)
    return 0
}
