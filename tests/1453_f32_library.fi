// expect_out: 0.1 | 3.4028235e+38 | 1e-45 | 0.33333334 | -2.5 | 123456790 | text 0.1 -> 1036831949 | sqrt 1.4142135 | round 3 | interpolation 0.1 2.5
// tests/1453_f32_library.fi -- the library learns the second width
// (round 71).
//
// `num.write_f32` has a round-trip guarantee of its OWN, and it is not the
// one of `write_f64`: the shortest text for an f32 is not the shortest text
// of the double next to it. 0.1f widened is 0.100000001490116119384765625,
// and `dtoa` rightly makes seventeen digits out of that -- but "0.1" reads
// back as the same four octets, so "0.1" is the answer.
//
// `lib/num/f32_text.fi` therefore shortens and CHECKS: every candidate is
// read back with `strtod_odd`, narrowed, and compared octet for octet.
// Whatever comes out of here has led back to the same value once.

import std.io
import std.num
import std.math
import std.str

fn show(x: f32) {
    var b: num.Bytes = num.bytes_new()
    if num.write_f32(&b, x) {
        io.print_bytes(b.ptr as u64, b.len)
    }
    num.bytes_free(&b)
}

fn bar() {
    io.print_str(" | ")
}

fn main() -> i32 {
    show(0.1)
    bar()
    show(3.4028235e38)
    bar()
    show(1.0e-45)
    bar()
    show(1.0 / 3.0)
    bar()
    show(0.0 - 2.5)
    bar()
    show(123456792.0)
    bar()

    // --- text -> f32, correctly rounded (round-to-odd in between)
    io.print_str("text ")
    let s: str = "0.1"
    var v: f32 = 0.0
    let used: usize = num.read_f32(s.p, s.n, &v)
    if used != 3 {
        return 1
    }
    show(v)
    io.print_str(" -> ")
    let bits: i64 = math.math_bits32(v) as i64
    io.fmt_print(f"{bits}")
    bar()

    // --- mathematics, exact: computing in f64 and rounding back once is
    //     correctly rounded (53 >= 2*24+2)
    io.print_str("sqrt ")
    show(math.sqrt32(2.0))
    bar()
    io.print_str("round ")
    show(math.round32(2.5))
    if math.floor32(1.7) != 1.0 { return 2 }
    if math.ceil32(1.2) != 2.0 { return 3 }
    if math.trunc32(0.0 - 1.7) != 0.0 - 1.0 { return 4 }
    if math.fabs32(0.0 - 2.5) != 2.5 { return 5 }
    if math.fmin32(1.0, 2.0) != 1.0 { return 6 }
    if math.fmax32(1.0, 2.0) != 2.0 { return 7 }
    if math.fclamp32(5.0, 0.0, 1.0) != 1.0 { return 8 }
    if !math.is_nan32(math.NAN32()) { return 9 }
    if !math.is_infinite32(math.INF32()) { return 10 }
    if math.is_finite32(math.INF32()) { return 11 }
    if math.math_f32(1069547520) != 1.5 { return 12 }
    if math.math_bits32(1.5) != 1069547520 { return 13 }
    if math.EPSILON32() as f64 >= 1.2e-7 { return 14 }
    bar()

    // --- f"{x}" picks fmt_f32 by the TYPE (sema.rs::fmt_target)
    let a: f32 = 0.1
    let b: f32 = 2.5
    io.fmt_print(f"interpolation {a} {b}")
    io.new_line()

    // --- read back what was written: the round trip really holds
    var i: u32 = 0
    var bad: u32 = 0
    while i < 2000 {
        let x: f32 = math.math_f32(1000000000 + i * 7919)
        var t: num.Bytes = num.bytes_new()
        if num.write_f32(&t, x) {
            var back: f32 = 0.0
            let z: usize = num.read_f32(t.ptr, t.len, &back)
            if z != t.len || math.math_bits32(back) != math.math_bits32(x) {
                bad = bad + 1
            }
        }
        num.bytes_free(&t)
        i = i + 1
    }
    if bad != 0 {
        return 15
    }
    return 0
}
