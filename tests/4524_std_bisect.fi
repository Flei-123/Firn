// expect_exit: 0
// tests/4524_std_bisect.fi -- std.bisect against CPython `bisect`.
// Mirrors tools/libs_py_cross/bisect_ref.py step by step.
import std.io
import std.rt
import std.vec
import std.bisect
import std.testkit

struct Rng { x: u64 }
struct Hash { h: u64 }
struct Pair { k: i64, tag: i64 }

fn rnd(g: *mut Rng, m: u64) -> u64 {
    (*g).x = ((*g).x * 1103515245 + 12345) & 0x7fffffff
    return ((*g).x >> 8) % m
}

fn feed(h: *mut Hash, x: u64) {
    (*h).h = ((*h).h * 31 + (x & 0xffffffff)) & 0xffffffff
}

fn pair_less(a: *Pair, b: *Pair) -> bool { return (*a).k < (*b).k }

fn feed_pairs(h: *mut Hash, p: *mut Vec[Pair]) {
    var i: usize = 0
    while i < vec_len[Pair](p) {
        feed(h, (*vec_elem_ptr[Pair](p, i)).k as u64)
        feed(h, (*vec_elem_ptr[Pair](p, i)).tag as u64)
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var g: Rng = Rng { x: 555 }
    var hh: Hash = Hash { h: 7 }
    let h: *mut Hash = &hh
    for r in 0..(300 as u64) {
        let n: u64 = rnd(&g, 40)
        let m: u64 = 1 + rnd(&g, 30)
        var v: Vec[i64] = vec_new[i64]()
        for i in 0..n { vec_push[i64](&v, rnd(&g, m) as i64) }
        vec_sort[i64](&v)
        for q in 0..(20 as u64) {
            let x: i64 = rnd(&g, m + 2) as i64
            feed(h, bisect_left[i64](&v, x) as u64)
            feed(h, bisect_right[i64](&v, x) as u64)
            let lo: u64 = rnd(&g, n + 1)
            let hi: u64 = lo + rnd(&g, n - lo + 1)
            feed(h, bisect_left_range[i64](&v, x, lo as usize, hi as usize) as u64)
            feed(h, bisect_right_range[i64](&v, x, lo as usize, hi as usize) as u64)
        }
        for q in 0..(15 as u64) {
            let x: i64 = rnd(&g, m + 2) as i64
            if rnd(&g, 2) != 0 { insort_left[i64](&v, x) } else { insort_right[i64](&v, x) }
        }
        for i in 0..vec_len[i64](&v) { feed(h, (*vec_elem_ptr[i64](&v, i)) as u64) }
        vec_free[i64](&v)
        var p: Vec[Pair] = vec_new[Pair]()
        for t in 0..(15 as u64) {
            let k: i64 = rnd(&g, m) as i64
            insort_right_by[Pair](&p, Pair { k: k, tag: t as i64 }, pair_less)
        }
        feed_pairs(h, &p)
        vec_free[Pair](&p)
        var q2: Vec[Pair] = vec_new[Pair]()
        for t in 0..(15 as u64) {
            let k: i64 = rnd(&g, m) as i64
            insort_left_by[Pair](&q2, Pair { k: k, tag: t as i64 }, pair_less)
        }
        feed_pairs(h, &q2)
        vec_free[Pair](&q2)
    }
    testkit.check((*h).h == 2484601005, "bisect_left/right, ranges, insort, _by variants equal CPython")
    return testkit.finish()
}
