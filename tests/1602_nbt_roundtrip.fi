// expect_exit: 0
// tests/1602_nbt_roundtrip.fi -- ROUND 76: `lib/std/nbt.fi` in one process.
//
// THE REAL PROOF FOR NBT IS `tools/nbt/run.sh`: it rebuilds Notch's
// reference file `bigtest.nbt` and compares it OCTET FOR OCTET, and it
// holds the Firn reader against a Python parser in both directions. What
// stands here is the part that belongs into the three build stages of
// `test.sh` section 3 -- writer and reader against each other, all thirteen
// tag types, plus the refusals.
//
// Section 5 is the one that matters most: a reader that accepts everything
// passes every roundtrip test ever written.
import std.nbt
import std.bytes

fn main() -> i32 {
    var b: bytes.Bytes = bytes.bytes_with_capacity(1024)
    defer bytes.bytes_free(&b)

    var n_root: [u8; 5] = "root\0"
    var n_b: [u8; 2] = "b\0"
    var n_s: [u8; 2] = "s\0"
    var n_i: [u8; 2] = "i\0"
    var n_l: [u8; 2] = "l\0"
    var n_f: [u8; 2] = "f\0"
    var n_d: [u8; 2] = "d\0"
    var n_ba: [u8; 3] = "ba\0"
    var n_st: [u8; 3] = "st\0"
    var n_li: [u8; 3] = "li\0"
    var n_co: [u8; 3] = "co\0"
    var n_ia: [u8; 3] = "ia\0"
    var n_la: [u8; 3] = "la\0"
    var v_st: [u8; 12] = "hello nbt!\u{21}\0"

    var ba: [u8; 4] = [1, 2, 254, 255]
    var ia: [i32; 3] = [0 - 1, 0, 2147483647]
    var la: [i64; 2] = [0 - 9223372036854775807 - 1,
        9223372036854775807]

    // ------------------------------------------------------- 1. write it all
    nbt.nbt_c_root_begin(&b, (&n_root[0]) as u64)
    nbt.nbt_c_byte(&b, (&n_b[0]) as u64, 0 -% 128 as i8)
    nbt.nbt_c_short(&b, (&n_s[0]) as u64, 0 -% 32768 as i16)
    // ROUND 83: i32::MIN and i64::MIN written as the numbers they are --
    // `(2147483648 as u32) as i32` is a checked narrowing cast and aborts
    // under a checking build level (SPEC 13, item L9).
    nbt.nbt_c_int(&b, (&n_i[0]) as u64, 0 - 2147483647 - 1)
    nbt.nbt_c_long(&b, (&n_l[0]) as u64, 0 - 9223372036854775807 - 1)
    nbt.nbt_c_float(&b, (&n_f[0]) as u64, 0.5f)
    nbt.nbt_c_double(&b, (&n_d[0]) as u64, 0.49312871321823148)
    nbt.nbt_c_byte_array(&b, (&n_ba[0]) as u64, (&ba[0]) as u64, 4)
    nbt.nbt_c_string(&b, (&n_st[0]) as u64, (&v_st[0]) as u64)
    nbt.nbt_c_list_open(&b, (&n_li[0]) as u64, nbt.TAG_INT, 3)
    bytes.put_i32(&b, 7)
    bytes.put_i32(&b, 8)
    bytes.put_i32(&b, 9)
    nbt.nbt_c_compound_begin(&b, (&n_co[0]) as u64)
    nbt.nbt_c_int(&b, (&n_i[0]) as u64, 5)
    nbt.nbt_end(&b)
    nbt.nbt_c_int_array(&b, (&n_ia[0]) as u64, (&ia[0]) as u64, 3)
    nbt.nbt_c_long_array(&b, (&n_la[0]) as u64, (&la[0]) as u64, 2)
    nbt.nbt_end(&b)
    if !bytes.bytes_ok(&b) { return 1 }

    // -------------------------------------------------- 2. read it back
    bytes.bytes_reset(&b)
    var rn: usize = 0
    let rp: u64 = nbt.nbt_read_root(&b, &rn) catch 0
    if rn != 4 { return 2 }
    if !bytes.bytes_span_eq(rp, rn, (&n_root[0]) as u64, 4) { return 3 }

    var nn: usize = 0
    // byte
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_BYTE { return 10 }
    nbt.nbt_read_name(&b, &nn) catch 0
    if (nbt.nbt_read_i8(&b) catch 0 as i8) != 0 -% 128 as i8 { return 11 }
    // short
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_SHORT { return 12 }
    nbt.nbt_read_name(&b, &nn) catch 0
    if (nbt.nbt_read_i16(&b) catch 0 as i16) != 0 -% 32768 as i16 { return 13 }
    // int
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_INT { return 14 }
    nbt.nbt_read_name(&b, &nn) catch 0
    if (nbt.nbt_read_i32(&b) catch 0) != 0 - 2147483647 - 1 { return 15 }
    // long
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_LONG { return 16 }
    nbt.nbt_read_name(&b, &nn) catch 0
    if (nbt.nbt_read_i64(&b) catch 0) != 0 - 9223372036854775807 - 1 { return 17 }
    // float / double -- compared as bit patterns, so no rounding can hide
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_FLOAT { return 18 }
    nbt.nbt_read_name(&b, &nn) catch 0
    if (nbt.nbt_read_f32(&b) catch 0.0f) != 0.5f { return 19 }
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_DOUBLE { return 20 }
    nbt.nbt_read_name(&b, &nn) catch 0
    if (nbt.nbt_read_f64(&b) catch 0.0) != 0.49312871321823148 { return 21 }
    // byte array
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_BYTE_ARRAY { return 22 }
    nbt.nbt_read_name(&b, &nn) catch 0
    if (nbt.nbt_read_array_len(&b, 1) catch 0) != 4 { return 23 }
    let bap: u64 = bytes.get_span(&b, 4) catch 0
    if !bytes.bytes_span_eq(bap, 4, (&ba[0]) as u64, 4) { return 24 }
    // string
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_STRING { return 25 }
    nbt.nbt_read_name(&b, &nn) catch 0
    var sn: usize = 0
    let sp: u64 = nbt.nbt_read_string(&b, &sn) catch 0
    if sn != 11 { return 26 }
    if !bytes.bytes_span_eq(sp, sn, (&v_st[0]) as u64, 11) { return 27 }
    // list of ints -- no names, no types per element
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_LIST { return 28 }
    nbt.nbt_read_name(&b, &nn) catch 0
    var elem: u8 = 0 as u8
    var cnt: i32 = 0
    if !(nbt.nbt_read_list_header(&b, &elem, &cnt) catch false) { return 29 }
    if elem != nbt.TAG_INT { return 30 }
    if cnt != 3 { return 31 }
    if (nbt.nbt_read_i32(&b) catch 0) != 7 { return 32 }
    if (nbt.nbt_read_i32(&b) catch 0) != 8 { return 33 }
    if (nbt.nbt_read_i32(&b) catch 0) != 9 { return 34 }
    // compound -- and here the skip is used instead of a walk
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_COMPOUND { return 35 }
    nbt.nbt_read_name(&b, &nn) catch 0
    if !(nbt.nbt_skip_payload(&b, nbt.TAG_COMPOUND) catch false) { return 36 }
    // int array
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_INT_ARRAY { return 37 }
    nbt.nbt_read_name(&b, &nn) catch 0
    if (nbt.nbt_read_array_len(&b, 4) catch 0) != 3 { return 38 }
    if (nbt.nbt_read_i32(&b) catch 0) != 0 - 1 { return 39 }
    if (nbt.nbt_read_i32(&b) catch 1) != 0 { return 40 }
    if (nbt.nbt_read_i32(&b) catch 0) != 2147483647 { return 41 }
    // long array
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_LONG_ARRAY { return 42 }
    nbt.nbt_read_name(&b, &nn) catch 0
    if (nbt.nbt_read_array_len(&b, 8) catch 0) != 2 { return 43 }
    if (nbt.nbt_read_i64(&b) catch 0) != 0 - 9223372036854775807 - 1 { return 44 }
    if (nbt.nbt_read_i64(&b) catch 0) != (9223372036854775807 as u64) as i64 { return 45 }
    // and the end
    if (nbt.nbt_read_type(&b) catch 255 as u8) != nbt.TAG_END { return 46 }
    if bytes.bytes_remaining(&b) != 0 { return 47 }

    // ------------------------------------------ 3. skip the whole document
    bytes.bytes_reset(&b)
    if (nbt.nbt_read_root(&b, &rn) catch 0) == 0 { return 50 }
    if !(nbt.nbt_skip_payload(&b, nbt.TAG_COMPOUND) catch false) { return 51 }
    if bytes.bytes_remaining(&b) != 0 { return 52 }

    // ------------------------------------------- 4. the anonymous root form
    var c: bytes.Bytes = bytes.bytes_new()
    defer bytes.bytes_free(&c)
    nbt.nbt_root_begin_anon(&c)
    nbt.nbt_c_int(&c, (&n_i[0]) as u64, 42)
    nbt.nbt_end(&c)
    // exactly ONE octet shorter than the named form with an empty name
    if bytes.bytes_len(&c) != 1 + 1 + 2 + 1 + 4 + 1 { return 55 }
    bytes.bytes_reset(&c)
    if !(nbt.nbt_read_root_anon(&c) catch false) { return 56 }
    if (nbt.nbt_read_type(&c) catch 255 as u8) != nbt.TAG_INT { return 57 }
    nbt.nbt_read_name(&c, &nn) catch 0
    if (nbt.nbt_read_i32(&c) catch 0) != 42 { return 58 }

    // ------------------------------- 5. THE COUNTER-CHECKS: refuse bad input
    // a) a tag number that does not exist
    var e: bytes.Bytes = bytes.bytes_new()
    defer bytes.bytes_free(&e)
    bytes.put_u8(&e, 13 as u8)
    bytes.bytes_reset(&e)
    if (nbt.nbt_read_type(&e) catch 200 as u8) != 200 as u8 { return 60 }
    // b) a truncated value: the type is there, the octets are not
    bytes.bytes_clear(&e)
    bytes.put_u8(&e, nbt.TAG_LONG)
    bytes.put_u8(&e, 0 as u8)
    bytes.bytes_reset(&e)
    if (nbt.nbt_read_i64(&e) catch 7777) != 7777 { return 61 }
    // c) a negative array length
    bytes.bytes_clear(&e)
    bytes.put_i32(&e, 0 - 5)
    bytes.bytes_reset(&e)
    if (nbt.nbt_read_array_len(&e, 1) catch 0 - 99) != 0 - 99 { return 62 }
    // d) an array length larger than what is there -- NBT5, before anything
    //    is reserved
    bytes.bytes_clear(&e)
    bytes.put_i32(&e, 2000000000)
    bytes.put_u8(&e, 1 as u8)
    bytes.bytes_reset(&e)
    if (nbt.nbt_read_array_len(&e, 1) catch 0 - 99) != 0 - 99 { return 63 }
    // e) a compound that never ends
    bytes.bytes_clear(&e)
    bytes.put_u8(&e, nbt.TAG_INT)
    bytes.put_u16(&e, 0 as u16)
    bytes.put_i32(&e, 1)
    bytes.bytes_reset(&e)
    if (nbt.nbt_skip_payload(&e, nbt.TAG_COMPOUND) catch false) { return 64 }
    // f) NBT4: nesting deeper than the limit is refused, not survived
    bytes.bytes_clear(&e)
    var k: i32 = 0
    while k < 400 {
        bytes.put_u8(&e, nbt.TAG_COMPOUND)
        bytes.put_u16(&e, 0 as u16)
        k = k + 1
    }
    k = 0
    while k < 401 {
        bytes.put_u8(&e, nbt.TAG_END)
        k = k + 1
    }
    bytes.bytes_reset(&e)
    if (nbt.nbt_skip_payload(&e, nbt.TAG_COMPOUND) catch false) { return 65 }
    // and 255 levels DO go through -- otherwise the limit would be useless
    bytes.bytes_clear(&e)
    k = 0
    while k < 250 {
        bytes.put_u8(&e, nbt.TAG_COMPOUND)
        bytes.put_u16(&e, 0 as u16)
        k = k + 1
    }
    k = 0
    while k < 251 {
        bytes.put_u8(&e, nbt.TAG_END)
        k = k + 1
    }
    bytes.bytes_reset(&e)
    if !(nbt.nbt_skip_payload(&e, nbt.TAG_COMPOUND) catch false) { return 66 }
    return 0
}
