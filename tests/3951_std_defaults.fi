// expect_exit: 0
// tests/3951_std_defaults.fi -- r704: std.args / std.log setup helpers with
// default and named arguments give the same result as the explicit calls.
import std.rt
import std.fs
import std.fsx
import std.log
import std.io
import std.args
import std.testkit

fn slurp(path: str) -> str {
    var b: rt.Buf = rt.buf_new()
    fs.read_file(path, &b) catch 0
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

#[allow_escape]
fn work() -> FsError!bool {
    var d: fsx.TempDir = try fsx.temp_dir("log_d_")
    defer fsx.temp_dir_drop(&d)
    let pa: str = fsx.temp_dir_path(&d) + "/a.log"
    let pb: str = fsx.temp_dir_path(&d) + "/b.log"
    var la: log.Logging = log.logging()
    log.add_file(&la, pa)
    var lb: log.Logging = log.logging(log.INFO, "%(levelname)s:%(name)s:%(message)s")
    log.add_file(&lb, pb, log.NOTSET, 0, 0)
    log.add_stream(&la, level: log.CRITICAL)
    log.debug(&la, "x", "hidden")
    log.info(&la, "x", "one")
    log.warning(&la, "y", "two")
    log.debug(&lb, "x", "hidden")
    log.info(&lb, "x", "one")
    log.warning(&lb, "y", "two")
    testkit.check(slurp(pa) == slurp(pb), "default logging == explicit logging")
    testkit.check(slurp(pa) == "INFO:x:one\nWARNING:y:two\n", "basicConfig format")
    var lc: log.Logging = log.logging(fmt: "%(message)s")
    log.add_file(&lc, fsx.temp_dir_path(&d) + "/c.log", max_bytes: 0)
    log.debug(&lc, "x", "hidden")
    log.info(&lc, "x", "three")
    testkit.check(slurp(fsx.temp_dir_path(&d) + "/c.log") == "three\n", "named fmt, default level")
    log.close(&la)
    log.close(&lb)
    log.close(&lc)
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var p: args.Cmd = args.cmd("tool", "t")
    args.opt(&p, "--name")
    args.opt(&p, "--count", args.INT, "7")
    args.opt(&p, "-v,--verbose", args.FLAG)
    args.pos(&p, "file")
    args.pos(&p, "n", args.INT, "a number")
    let r: args.Result = args.parse_words(&p, "--name X f.txt 5")
    testkit.check(r.status == args.OK, "parse ok")
    testkit.check(args.get(&r, "name") == "X" && args.get(&r, "file") == "f.txt", "str values")
    testkit.check(args.get_int(&r, "count") == 7 && args.get_int(&r, "n") == 5, "int default and positional")
    testkit.check(work() catch | e | false, "work ran")
    return testkit.finish()
}
