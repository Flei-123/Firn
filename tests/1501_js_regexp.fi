    }
    gc_set_max_bytes(1 << 30)
    var s: [u8; 3792] = "globalThis.fail=0;\nfunction ck(n,c){ if(!c && globalThis.fail===0) globalThis.fail=n; }\nck(1, /a+/.test(\"baaa\") && !/x/.test(\"baaa\"));\nck(2, /a+/.exec(\"baaa\")[0]===\"aaa\" && /a+/.exec(\"baaa\").index===1);\nck(3, \"2019-01-02\".replace(/(\\d+)-(\\d+)-(\\d+)/,\"$3.$2.$1\")===\"02.01.2019\");\nck(4, \"a1b22c333\".match(/\\d+/g).join(\"|\")===\"1|22|333\");\nck(5, \"a,b;c\".split(/[,;]/).join(\"-\")===\"a-b-c\");\nck(6, \"hello\".search(/l+/)===2 && \"hello\".search(/z/)===-1);\nck(7, \"HeLLo\".match(/l+/i)[0]===\"LL\");\nck(8, /(?<y>\\d{4})-(?<m>\\d{2})/.exec(\"2020-05\").groups.y===\"2020\");\nck(9, \"2020-05\".replace(/(?<y>\\d{4})-(?<m>\\d{2})/,\"$<m>/$<y>\")===\"05/2020\");\nck(10, /^ab$/m.test(\"x\\nab\") && !/^ab$/.test(\"x\\nab\"));\nck(11, /a.c/s.test(\"a\\nc\") && !/a.c/.test(\"a\\nc\"));\nck(12, [...\"a1b2\".matchAll(/(\\w)(\\d)/g)].map(function(m){return m[1]+m[2];}).join()===\"a1,b2\");\nck(13, \"aaa\".replace(/a/g,function(m,i){return i;})===\"012\");\nck(14, /\\bfoo\\b/.test(\"a foo b\") && !/\\bfoo\\b/.test(\"afoob\"));\nck(15, /(?=x)./.exec(\"xy\")[0]===\"x\" && !/(?!x)./.test(\"x\"));\nck(16, /(?<=a)b/.test(\"ab\") && !/(?<=c)b/.test(\"ab\"));\nck(17, /(?<!c)b/.test(\"ab\"));\nck(18, /[^a-c]/.test(\"d\") && !/[^a-c]/.test(\"b\"));\nck(19, /[\\d\\s]/.test(\" \") && /\\S/.test(\"x\") && !/\\S/.test(\" \"));\nck(20, /a{2,3}/.exec(\"aaaa\")[0]===\"aaa\" && /a+?/.exec(\"aaa\")[0]===\"a\");\nck(21, /a{2}/.test(\"aa\") && !/a{3}/.test(\"aa\"));\nvar g=/a/g;\nck(22, g.lastIndex===0 && g.test(\"aa\") && g.lastIndex===1 && g.test(\"aa\") && g.lastIndex===2 && !g.test(\"aa\") && g.lastIndex===0);\nck(23, String(/ab+c/gi)===\"/ab+c/gi\" && /ab/.source===\"ab\" && /ab/gi.flags===\"gi\");\nck(24, /(a)|(b)/.exec(\"b\")[2]===\"b\" && /(a)|(b)/.exec(\"b\")[1]===undefined);\nck(25, \"abc\".split(\"\").join(\"|\")===\"a|b|c\" && \"\".split(\"\").length===0);\nck(26, /(a*)*b/.test(\"aaab\") && /^(a+)+$/.test(\"aaaa\"));\nck(27, \"A\".match(/a/i).index===0 && RegExp(\"a\\\\d\",\"g\").exec(\"xa5\")[0]===\"a5\");\nck(28, (function(){try{new RegExp(\"(\",\"\")}catch(e){return e instanceof SyntaxError}return false})());\nck(29, (function(){try{new RegExp(\"a\",\"q\")}catch(e){return e instanceof SyntaxError}return false})());\nck(30, /A/.test(\"A\") && /\\x41/.test(\"A\"));\nck(31, /\\u{1F600}/u.test(\"\\uD83D\\uDE00\"));\nck(32, /^.$/u.test(\"\\uD83D\\uDE00\") && !/^.$/.test(\"\\uD83D\\uDE00\"));\nck(33, /(a)\\1/.test(\"aa\") && !/(a)\\1/.test(\"ab\"));\nck(34, /(?<w>a)\\k<w>/.test(\"aa\"));\nck(35, \"abc\".replace(\"b\",\"X\")===\"aXc\" && \"a-b-c\".replaceAll(\"-\",\"+\")===\"a+b+c\");\nck(36, \"aaa\".replaceAll(\"a\",\"$&$&\")===\"aaaaaa\");\nck(37, \"x\".replace(/x/,\"$$\")===\"$\" && \"abc\".replace(/b/,\"[$`|$']\")===\"a[a|c]c\");\nck(38, /y/y.test(\"y\") && !(function(){var re=/y/y; re.lastIndex=1; return re.test(\"ya\");})());\nck(39, \"a1b2\".split(/(\\d)/).join(\"|\")===\"a|1|b|2|\");\nck(40, \"aaa\".split(/a/).length===4);\nck(41, /[a-c]+/.exec(\"xxabcxx\")[0]===\"abc\");\nck(42, /a|ab/.exec(\"ab\")[0]===\"a\");\nck(43, /(ab)+/.exec(\"ababab\")[1]===\"ab\");\nck(44, /^\\s*$/.test(\"  \\t \") && !/^\\s*$/.test(\" x \"));\nck(45, /\\W/.test(\"!\") && !/\\W/.test(\"a\"));\nck(46, RegExp.prototype.exec.call(/a/,\"ba\")[0]===\"a\");\nck(47, /a/d.exec(\"ba\").indices[0].join()===\"1,2\");\nck(48, typeof /a/[Symbol.match]===\"function\" && typeof /a/[Symbol.replace]===\"function\");\nck(49, /a/.hasIndices===false && /a/d.hasIndices===true);\nck(50, /\\p{L}/u.test(\"A\") && !/\\p{L}/u.test(\"1\"));\nck(51, \"abc\".match(/(b)(c)/).slice(1).join()===\"b,c\");\nck(52, \"test\".replace(/t/g,\"T\")===\"TesT\");\nck(53, new RegExp(/a/g).flags===\"g\" && new RegExp(/a/g,\"i\").flags===\"i\");\nck(54, \"aXbXc\".split(\"X\",2).join()===\"a,b\");\nck(55, /[]/.test(\"a\")===false && /[^]/.test(\"a\")===true);\nck(56, \"abc\".match(/z/g)===null && \"abc\".match(/z/)===null);\nck(57, /a/g[Symbol.match](\"aa\").