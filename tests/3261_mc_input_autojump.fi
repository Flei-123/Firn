// expect_exit: 0
// tests/3261_mc_input_autojump.fi -- mc_input Auto-Jump (vanilla option, default OFF): a 1 block step stops the player without the option and is
// climbed with it; a 2 block wall, a low ceiling, sneaking and fly mode never jump.
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_input

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

// floor y = -64..-61 (layers 0..3 of 32), stone at (any x, z >= z0, layer ly)
fn put_row(ids: u64, ly: i32, z0: i32) {
    var z: i32 = z0
    while z < 16 {
        var x: i32 = 0
        while x < 16 {
            rt.st16(ids, ((ly * 16 + z) * 16 + x) as usize, 1 as u16)
            x = x + 1
        }
        z = z + 1
    }
}

fn make_world(w: *mut mc_world.World, step_z: i32, wall_z: i32, ceil_z: i32) {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    i = 0
    while i < 4 * 256 {
        rt.st16(ids, i, 1 as u16)
        i = i + 1
    }
    if step_z < 16 { put_row(ids, 4, step_z) } // y = -60: the 1 block step
    if wall_z < 16 {
        put_row(ids, 4, wall_z)
        put_row(ids, 5, wall_z) // y = -59: 2 blocks high from the floor
        put_row(ids, 6, wall_z) // y = -58: 2 blocks high from the top of a 1 block step
    }
    if ceil_z < 16 { put_row(ids, 7, ceil_z) } // y = -57
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

fn walk(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) {
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = keys
    var t: i32 = 0
    while t < ticks {
        mc_input.player_tick(p, &ev, w, tb, 0 - 64)
        t = t + 1
    }
}

fn main() -> i32 {
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(2), solid: rt.heap_alloc(4), n: 2 }
    rt.st8(tb.pick, 0, 0 as u8)
    rt.st8(tb.pick, 1, 1 as u8)
    rt.st16(tb.solid, 0, 0 as u16)
    rt.st16(tb.solid, 1, 1 as u16)

    // 1 block step at z >= 10 (the player starts at z = 6.5, yaw 0 = walks +z)
    var w1: mc_world.World = mc_world.world_new()
    make_world(&w1, 10, 99, 99)
    var p: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 6.5)
    walk(&p, &w1, &tb, 0 as u32, 2)
    check(p.on_ground, 1)
    walk(&p, &w1, &tb, mc_input.K_FORWARD, 40)
    check(p.z > 9.69 && p.z < 9.71 && p.y == 0.0 - 60.0, 2) // option OFF: stuck at the step (10 - 0.3)

    var q: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 6.5)
    q.autojump = true
    walk(&q, &w1, &tb, 0 as u32, 2)
    walk(&q, &w1, &tb, mc_input.K_FORWARD, 40)
    check(q.y == 0.0 - 59.0 && q.on_ground, 3) // option ON: on top of the step
    check(q.z > 10.3, 4)

    // sneaking: no auto jump
    var s: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 6.5)
    s.autojump = true
    walk(&s, &w1, &tb, 0 as u32, 2)
    walk(&s, &w1, &tb, mc_input.K_FORWARD | mc_input.K_SNEAK, 120)
    check(s.y == 0.0 - 60.0 && s.z < 9.71, 5)

    // flying: no auto jump (no vy kick, stays at its height)
    var f: mc_input.Player = mc_input.player_new(8.5, 0.0 - 58.5, 6.5)
    f.autojump = true
    f.flying = true
    walk(&f, &w1, &tb, mc_input.K_FORWARD, 60)
    check(f.y == 0.0 - 58.5, 6)

    // a 2 block wall at z >= 10: no jump (the player stays on the floor)
    var w2: mc_world.World = mc_world.world_new()
    make_world(&w2, 99, 10, 99)
    var a: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 6.5)
    a.autojump = true
    walk(&a, &w2, &tb, 0 as u32, 2)
    walk(&a, &w2, &tb, mc_input.K_FORWARD, 60)
    check(a.y == 0.0 - 60.0 && a.z < 9.71, 7)

    // low ceiling right above the step (y = -57 from z >= 10): the jump would bonk, so no jump
    var w3: mc_world.World = mc_world.world_new()
    make_world(&w3, 10, 99, 10)
    var b: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 6.5)
    b.autojump = true
    walk(&b, &w3, &tb, 0 as u32, 2)
    walk(&b, &w3, &tb, mc_input.K_FORWARD, 60)
    check(b.y == 0.0 - 60.0 && b.z < 9.71, 8)

    // step, then a 2 block wall further on: climbs the step, stops at the wall
    var w4: mc_world.World = mc_world.world_new()
    make_world(&w4, 10, 13, 99)
    var d: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 6.5)
    d.autojump = true
    walk(&d, &w4, &tb, 0 as u32, 2)
    walk(&d, &w4, &tb, mc_input.K_FORWARD, 80)
    check(d.y == 0.0 - 59.0 && d.z > 12.69 && d.z < 12.71, 9)
    return g_fail
}
