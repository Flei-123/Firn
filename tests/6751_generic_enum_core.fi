// expect_exit: 25
enum Opt[T] { Some(T), None }
enum Res[T, E] { Ok(T), Err(E) }

fn find(v: i32) -> Opt[i32] {
    if v > 0 { return Opt::Some(v) }
    return Opt::None
}

fn div(a: i32, b: i32) -> Res[i32, bool] {
    if b == 0 { return Res::Err(true) }
    return Res::Ok(a / b)
}

fn main() -> i32 {
    var total: i32 = 0
    let a = find(5)
    match a {
        Opt::Some(x) => { total = total + x }
        Opt::None => { total = total + 100 }
    }
    let b = find(0 - 1)
    match b {
        Opt::Some(x) => { total = total + x }
        Opt::None => { total = total + 1000 }
    }
    let c: Opt[f64] = Opt[f64]::Some(2.5)
    match c {
        Opt::Some(f) => { if f > 2.0 { total = total + 7 } }
        Opt::None => { total = total + 1 }
    }
    match div(10, 2) {
        Res::Ok(q) => { total = total + q }
        Res::Err(e) => { total = total + 5000 }
    }
    match div(1, 0) {
        Res::Ok(q) => { total = total + q }
        Res::Err(e) => { if e { total = total + 20000 } }
    }
    return total
}
