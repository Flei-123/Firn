// expect_exit: 139
// wasm_skip: page protection does not exist in the wasm linear memory
// not_mode: opt
// only_target: x86_64
// N6 in debug heap mode: a read after rt.heap_free faults (SIGSEGV 139) instead of returning stale or zero memory.
import std.rt

fn main() -> i32 {
    rt.heap_debug_enable()
    let p: u64 = rt.heap_alloc(64)
    *(p as *mut u64) = 77
    rt.heap_free(p, 64)
    let v: u64 = *(p as *mut u64)
    return v as i32
}
