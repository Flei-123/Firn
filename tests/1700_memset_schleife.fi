// expect_out: ok
// RUNDE TEMPO 9 -- die Schleife, die nur Nullen schreibt, wird EIN Befehl.
//
// `compiler/src/memset.rs` erkennt das Muster
//
//     var i: usize = 0
//     while i < n { st8(p, i, 0); i = i + 1 }
//
// und ersetzt es durch `secure_zero(p, n)` (`rep stosb`). Der Pass ist eine
// Ersetzung mit Wirkung auf den Speicher -- wenn er sich um ein Oktett
// vertut, merkt das niemand, bis ein Programm falsch rechnet. Also wird hier
// nachgezaehlt, und zwar an den Raendern:
//
//   * genau `n` Oktette werden null, das Oktett DAVOR und DAHINTER nicht,
//   * `n = 0` schreibt gar nichts,
//   * ein Wert ungleich null bleibt eine gewoehnliche Schleife und schreibt
//     genau diesen Wert,
//   * eine Laenge, die erst zur Laufzeit feststeht, funktioniert genauso.
//
// Der letzte Punkt ist der wichtigste: mit fester Laenge koennte der
// Uebersetzer die Schleife auch ganz ausrechnen, mit veraenderlicher nicht.
import std.rt
import std.io

fn pruefe(bedingung: bool, was: str) -> bool {
    if !bedingung {
        io.print("FEHLER: ")
        io.print_line(was)
        return false
    }
    return true
}

fn main(start: u64) -> i32 {
    var ok: bool = true

    // ---- 1. feste Laenge, Raender beachten -------------------------------
    var feld: [u8; 300] = [7; 300]
    let p: u64 = (&feld[0]) as u64
    // 256 Oktette ab dem Platz 20 nullsetzen, alles andere bleibt 7.
    rt.mem_set(p + 20, 0 as u8, 256)
    var i: usize = 0
    var falsch: i64 = 0
    while i < 300 {
        let soll: u8 = if i >= 20 && i < 276 { 0 as u8 } else { 7 as u8 }
        if feld[i] != soll {
            falsch = falsch + 1
        }
        i = i + 1
    }
    ok = pruefe(falsch == 0, "feste Laenge: falsche Oktette") && ok

    // ---- 2. Laenge null schreibt nichts ----------------------------------
    var feld2: [u8; 8] = [3; 8]
    let p2: u64 = (&feld2[0]) as u64
    var null_laenge: usize = 0
    if start != 0 {
        null_laenge = 0
    }
    rt.mem_set(p2, 0 as u8, null_laenge)
    var j: usize = 0
    var falsch2: i64 = 0
    while j < 8 {
        if feld2[j] != 3 as u8 {
            falsch2 = falsch2 + 1
        }
        j = j + 1
    }
    ok = pruefe(falsch2 == 0, "Laenge null hat geschrieben") && ok

    // ---- 3. ein Wert ungleich null bleibt eine Schleife -------------------
    var feld3: [u8; 64] = [0; 64]
    let p3: u64 = (&feld3[0]) as u64
    rt.mem_set(p3, 171 as u8, 64)
    var k: usize = 0
    var falsch3: i64 = 0
    while k < 64 {
        if feld3[k] != 171 as u8 {
            falsch3 = falsch3 + 1
        }
        k = k + 1
    }
    ok = pruefe(falsch3 == 0, "Wert 171 nicht ueberall angekommen") && ok

    // ---- 4. Laenge erst zur Laufzeit bekannt -----------------------------
    var feld4: [u8; 128] = [9; 128]
    let p4: u64 = (&feld4[0]) as u64
    var n: usize = 100
    // Der Uebersetzer kann `start` nicht kennen -- damit ist `n` offen.
    if start == 12345 {
        n = 1
    }
    rt.mem_set(p4, 0 as u8, n)
    var m: usize = 0
    var falsch4: i64 = 0
    while m < 128 {
        let soll4: u8 = if m < 100 { 0 as u8 } else { 9 as u8 }
        if feld4[m] != soll4 {
            falsch4 = falsch4 + 1
        }
        m = m + 1
    }
    ok = pruefe(falsch4 == 0, "veraenderliche Laenge: falsche Oktette") && ok

    if ok {
        io.print_line("ok")
        return 0
    }
    return 1
}
