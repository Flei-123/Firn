// expect_exit: 0
// Fehlerunionen neben Aufzaehlungen und 'match' im selben Programm.
error E { Unbekannt }

enum Marke { Rot, Gruen, Blau }

fn wert(m: Marke) -> E!i32 {
    match m {
        Marke::Rot => { return 1 }
        Marke::Gruen => { return 2 }
        Marke::Blau => { return E::Unbekannt }
    }
    return 0
}

fn main() -> i32 {
    if (wert(Marke::Rot) catch 0) != 1 {
        return 1
    }
    if (wert(Marke::Gruen) catch 0) != 2 {
        return 2
    }
    if (wert(Marke::Blau) catch 0 - 7) != 0 - 7 {
        return 3
    }
    return 0
}
