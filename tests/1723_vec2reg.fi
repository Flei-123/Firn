// expect_out: ok
// ROUND TEMPO 15 -- a sixteen octet cell used as ONE vector becomes a v128
// value (vec2reg.rs).
//
// Every function below checks one edge of the pass:
//
//   * the shape of `synth` in the MP3 decoder: an [i32; 4] zeroed, written
//     as a vector, read lane by lane -- in a loop, every pass anew,
//   * a zeroed [f32; 4] read back as a vector before it is written,
//   * a lane read BEFORE the vector write of the same pass (the value of the
//     last pass -- must stay in memory, and stay right),
//   * a float lane read out of a vector (the pass has no reinterpretation
//     and must leave the cell alone),
//   * a non-zero lane written and the whole vector read back,
//   * the address of the cell handed to a function (escapes),
//   * two cells, one copied into the other through a vector.
import std.io

fn check(got: i64, want: i64, what: str) -> bool {
    if got != want {
        io.print("WRONG ")
        io.print(what)
        io.new_line()
        return false
    }
    return true
}

fn start(x: i64) -> i64 {
    return x
}

fn lanes_in_loop(n: i32) -> i64 {
    var sum: i64 = 0
    var i: i32 = 0
    while i < n {
        var ai: [i32; 4] = [0; 4]
        let v: v128 = __v128_from_u64(((i as u64) << 32) | (7 as u64), ((3 * i) as u64) << 32 | (i as u64))
        __v128_store((&ai[0]) as *mut u8, v)
        sum = sum + (ai[0] as i64) + 10 * (ai[1] as i64) + 100 * (ai[2] as i64) + 1000 * (ai[3] as i64)
        i = i + 1
    }
    return sum
}

fn zero_as_vector() -> i64 {
    var af: [f32; 4] = [0.0f; 4]
    let v: v128 = __v128_load((&af[0]) as *u8)
    return (__v128_get_u64(v, 0) | __v128_get_u64(v, 1)) as i64
}

fn read_before_write(n: i32) -> i64 {
    var ai: [i32; 4] = [0; 4]
    var sum: i64 = 0
    var i: i32 = 0
    while i < n {
        sum = sum + (ai[2] as i64)
        __v128_store((&ai[0]) as *mut u8, __v128_from_u64(0, (i + 5) as u64))
        i = i + 1
    }
    return sum
}

fn float_lane(x: i64) -> i64 {
    var af: [f32; 4] = [0.0f; 4]
    let bits: u64 = 0x40400000 as u64
    __v128_store((&af[0]) as *mut u8, __v128_from_u64(bits << 32, x as u64))
    return (af[1] * 2.0f) as i64
}

fn nonzero_lane(x: i32) -> i64 {
    var ai: [i32; 4] = [0; 4]
    ai[1] = x
    ai[3] = 2 * x
    let v: v128 = __v128_load((&ai[0]) as *u8)
    return (__v128_get_u64(v, 0) >> 32) as i64 + (__v128_get_u64(v, 1) >> 32) as i64
}

fn peek(p: *mut i32) -> i64 {
    return (*p) as i64
}

fn escapes(x: i64) -> i64 {
    var ai: [i32; 4] = [0; 4]
    __v128_store((&ai[0]) as *mut u8, __v128_from_u64(x as u64, 0))
    return peek(&ai[0]) + (ai[1] as i64)
}

fn two_cells(x: i64) -> i64 {
    var a: [i32; 4] = [0; 4]
    var b: [i32; 4] = [0; 4]
    __v128_store((&a[0]) as *mut u8, __v128_from_u64((x as u64) << 32, 9))
    __v128_store((&b[0]) as *mut u8, __v128_load((&a[0]) as *u8))
    return (b[1] as i64) * 100 + (b[2] as i64)
}

fn main() -> i32 {
    var ok = true
    // sum over i of 7 + 10 i + 100 i + 1000 * 3 i = 7 n + 3110 * n(n-1)/2
    ok = check(lanes_in_loop(start(9) as i32), 7 * 9 + 3110 * 36, "lanes in a loop") && ok
    ok = check(zero_as_vector(), 0, "zero read as a vector") && ok
    // passes 1..n-1 see the value of the pass before: 5, 6, ..., n+3
    ok = check(read_before_write(start(6) as i32), 5 + 6 + 7 + 8 + 9, "read before write") && ok
    ok = check(float_lane(start(1)), 6, "float lane of a vector") && ok
    ok = check(nonzero_lane(start(21) as i32), 63, "non-zero lane, vector read") && ok
    ok = check(escapes(start(42)), 42, "address escapes") && ok
    ok = check(two_cells(start(4)), 409, "vector copied cell to cell") && ok
    if ok {
        io.print("ok")
        io.new_line()
    }
    return 0
}
