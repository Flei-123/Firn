// expect_exit: 0
import std.rt
import plat.host

fn main() -> i32 {
    if host.backend_name() != "none" { return 1 }
    var buf: [u8; 16] = [0; 16]
    let out: u64 = (&buf[0]) as u64
    host.fetch(1 as u32, "GET".p as u64, 3, "/x".p as u64, 2, 0 as u64, 0)
    host.stream_open("/s".p as u64, 2)
    host.stream_close()
    host.navigate("/n".p as u64, 2)
    if host.location(out, 16) != 0 { return 2 }
    host.store_set("k".p as u64, 1, "v".p as u64, 1)
    if host.store_get("k".p as u64, 1, out, 16) != 0 { return 3 }
    host.keyboard(true, 0.0, 0.0, 1.0, 1.0)
    host.edit_mode(true, 1.0, 1.0, 0.0, 0.0, 0.0)
    host.edit_wrap(true)
    host.edit_set(out, 0, 0, 0, 0.0)
    host.tz_reset()
    if host.tz_offset(86400 as u64) != 0 as i64 { return 4 }
    host.wake_in(10.0)
    if host.dark() { return 5 }
    if host.font_extra(0) != 0 as u64 { return 6 }
    if host.clip_write("text/plain", out, 0) { return 7 }
    host.clip_read("text/plain")
    return 0
}
