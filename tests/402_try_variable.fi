// expect_exit: 0
// 'try' on a local variable of type E!T (the type syntax as a variable type).
error E { A }

fn source(n: i32) -> E!i32 {
    if n < 0 {
        return E::A
    }
    return n * 3
}

fn use_it(n: i32) -> E!i32 {
    let r: E!i32 = source(n)
    let v = try r
    return v + 1
}

fn main() -> i32 {
    if (use_it(2) catch 0) != 7 {
        return 1
    }
    if (use_it(0 - 2) catch 0 - 1) != 0 - 1 {
        return 2
    }
    return 0
}
