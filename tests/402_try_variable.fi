// expect_exit: 0
// 'try' auf einer lokalen Variablen vom Typ E!T (Typsyntax als Variablentyp).
error E { A }

fn quelle(n: i32) -> E!i32 {
    if n < 0 {
        return E::A
    }
    return n * 3
}

fn benutze(n: i32) -> E!i32 {
    let r: E!i32 = quelle(n)
    let v = try r
    return v + 1
}

fn main() -> i32 {
    if (benutze(2) catch 0) != 7 {
        return 1
    }
    if (benutze(0 - 2) catch 0 - 1) != 0 - 1 {
        return 2
    }
    return 0
}
