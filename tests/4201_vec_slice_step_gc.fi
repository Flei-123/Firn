// expect_exit: 0
// tests/4201_vec_slice_step_gc.fi -- r738: copies of a Vec[str] (GC roots), step slices, slice assignment.
import std.rt
import std.vec
import std.text

#[no_inline]
fn build() -> Vec[str] {
    var v: Vec[str] = vec_new[str]()
    vec_push[str](&v, text.dup("a"))
    vec_push[str](&v, text.dup("bb"))
    vec_push[str](&v, text.dup("ccc"))
    vec_push[str](&v, text.dup("dddd"))
    vec_push[str](&v, text.dup("eeeee"))
    return v
}

#[no_inline]
fn churn() {
    // allocate garbage so that a collection may run
    var i: i32 = 0
    while i < 2000 {
        let t: str = text.dup("garbage-garbage-garbage")
        if t.n == 0 { return }
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[str] = build()
    var e: Vec[str] = v[::2]
    var r: Vec[str] = v[::-1]
    var c: Vec[str] = v[1:4].copy()
    var none: Vec[str] = v[3:3].copy()
    churn()
    if vec_len[str](&e) != 3 || e[0] != "a" || e[1] != "ccc" || e[2] != "eeeee" { return 2 }
    if vec_len[str](&r) != 5 || r[0] != "eeeee" || r[4] != "a" { return 3 }
    if vec_len[str](&c) != 3 || c[0] != "bb" || c[2] != "dddd" { return 4 }
    if vec_len[str](&none) != 0 { return 5 }
    // equal length assignment (no reallocation)
    v[0:2] = c[0:2]
    if v[0] != "bb" || v[1] != "ccc" { return 6 }
    // shrinking in place
    v[1:4] = e[0:1]
    if vec_len[str](&v) != 3 || v[1] != "a" || v[2] != "eeeee" { return 7 }
    churn()
    if v[0] != "bb" || v[1] != "a" || e[1] != "ccc" { return 8 }
    vec_free[str](&v)
    vec_free[str](&e)
    vec_free[str](&r)
    vec_free[str](&c)
    return 0
}
