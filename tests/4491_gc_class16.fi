// expect_exit: 0
// The 16 byte size class (id 13): payloads of 8 and 16 octets take a 32 byte
// block, 17..32 octets take 48 (class 0), and the objects stay intact and
// reachable across collection runs (the reciprocal in __gc_block_of must
// map interior and exact addresses to the right block).

gc class One {
    value: u64,
}

gc class Two {
    next: Gc[Two],
    value: u64,
}

gc class Three {
    a: u64,
    b: u64,
    c: u64,
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    let b0: u64 = gc_total_bytes()
    let one: Gc[One] = gc One { value: 7 } catch gc_null[One]()
    if gc_total_bytes() - b0 != 32 {
        return 1
    }
    let b1: u64 = gc_total_bytes()
    let two: Gc[Two] = gc Two { next: gc_null[Two](), value: 8 } catch gc_null[Two]()
    if gc_total_bytes() - b1 != 32 {
        return 2
    }
    let b2: u64 = gc_total_bytes()
    let three: Gc[Three] = gc Three { a: 1, b: 2, c: 3 } catch gc_null[Three]()
    if gc_total_bytes() - b2 != 48 {
        return 3
    }
    // a long live chain of 16 byte payload objects across several runs
    var head: Gc[Two] = two
    var i: u64 = 0
    while i < 200000 {
        head = gc Two { next: head, value: i } catch gc_null[Two]()
        if head == gc_null[Two]() {
            return 4
        }
        i = i + 1
    }
    gc_collect()
    var n: u64 = 0
    var p: Gc[Two] = head
    while p != gc_null[Two]() {
        n = n + 1
        p = p.next
    }
    if n != 200001 {
        return 5
    }
    if one.value != 7 || two.value != 8 || three.c != 3 {
        return 6
    }
    return 0
}
