// expect_exit: 0
// tests/2241_human.fi -- lib/i18n/human.fi in eight languages against ICU 72.1 (CLDR 42).
//
// GENERATED by tools/uiextras/gen_human_test.py: every expected text below is what
// ICU (PyICU) answers for the same input -- relative times, byte sizes, date and
// time styles, percent, lists, and the wall clock of two zones read from TZif
// files. tools/uiextras/check_human.py holds the library against ICU for thousands
// of random inputs; this file keeps a fixed sample in the test suite (and runs on
// every build level and on AArch64, where Python is not at hand).
import i18n.human
import std.time
import std.io

static mut bad: i32 = 0
static mut done: i32 = 0

fn same(what: str, got: str, want: str) {
    done = done + 1
    if got != want {
        bad = bad + 1
        io.print_line(what)
        io.print_line(got)
        io.print_line(want)
    }
}

fn wall(ms: i64) -> time.DateTime {
    return time.civil_from_unix(ms)
}

