    same("rel cs -1260000", human.format_relative("cs", -1260000), "před 21 minutami")
    same("rel cs 18000000", human.format_relative("cs", 18000000), "za 5 hodin")
    same("bytes cs 0", human.format_bytes("cs", 0, false), "0 B")
    same("bytes cs 1", human.format_bytes("cs", 1, false), "1 B")
    same("bytes cs 999", human.format_bytes("cs", 999, false), "999 B")
    same("bytes cs 1000", human.format_bytes("cs", 1000, false), "1 kB")
    same("bytes cs 2250", human.format_bytes("cs", 2250, false), "2,2 kB")
    same("bytes cs 12345678", human.format_bytes("cs", 12345678, false), "12,3 MB")
    same("bytes cs 999999", human.format_bytes("cs", 999999, false), "1 MB")
    same("bytes cs 5000000000", human.format_bytes("cs", 5000000000, false), "5 GB")
    same("bytes cs 3603294110435203000", human.format_bytes("cs", 3603294110435203000, false), "3\u{A0}603,3 PB")
    same("dt cs 4 2", human.format_datetime("cs", t, 4 as u32, 2 as u32), "pondělí 21. září 2026 v 14:13:20")
    same("dt cs 4 1", human.format_datetime("cs", t, 4 as u32, 1 as u32), "pondělí 21. září 2026 v 14:13")
    same("dt cs 3 1", human.format_datetime("cs", t, 3 as u32, 1 as u32), "21. září 2026 v 14:13")
    same("dt cs 2 2", human.format_datetime("cs", t, 2 as u32, 2 as u32), "21. 9. 2026 14:13:20")
    same("dt cs 2 1", human.format_datetime("cs", t, 2 as u32, 1 as u32), "21. 9. 2026 14:13")
    same("dt cs 1 9", human.format_datetime("cs", t, 1 as u32, 9 as u32), "21.09.26")
    same("dt cs 9 2", human.format_datetime("cs", t, 9 as u32, 2 as u32), "14:13:20")
    same("dt cs 9 1", human.format_datetime("cs", t, 9 as u32, 1 as u32), "14:13")
    same("dt cs 4 9", human.format_datetime("cs", t, 4 as u32, 9 as u32), "pondělí 21. září 2026")
    same("dt cs 3 9", human.format_datetime("cs", t, 3 as u32, 9 as u32), "21. září 2026")
    same("dt cs 2 9", human.format_datetime("cs", t, 2 as u32, 9 as u32), "21. 9. 2026")
    same("pct cs 0", human.format_percent("cs", 0.5712, 0 as u32), "57\u{A0}%")
    same("pct cs 1", human.format_percent("cs", 0.5712, 1 as u32), "57,1\u{A0}%")
    same("list cs 1", human.format_list("cs", "Alpha", 124 as u8, false), "Alpha")
    same("list cs 2", human.format_list("cs", "Alpha|Bravo", 124 as u8, false), "Alpha a\u{A0}Bravo")
    same("list cs 3", human.format_list("cs", "Alpha|Bravo|Charlie", 124 as u8, false), "Alpha, Bravo a\u{A0}Charlie")
    same("list cs 4", human.format_list("cs", "Alpha|Bravo|Charlie|Delta", 124 as u8, false), "Alpha, Bravo, Charlie a\u{A0}Delta")
    // ---------------------------------------------------------------- ru
    same("rel ru -300000", human.format_relative("ru", -300000), "5 минут назад")
    same("rel ru 7200000", human.format_relative("ru", 7200000), "через 2 часа")
    same("rel ru -259200000", human.format_relative("ru", -259200000), "3 дня назад")
    same("rel ru 1209600000", human.format_relative("ru", 1209600000), "через 2 недели")
    same("rel ru -8208000000", human.format_relative("ru", -8208000000), "3 месяца назад")
    same("rel ru 69120000000", human.format_relative("ru", 69120000000), "через 2 года")
    same("rel ru -45000", human.format_relative("ru", -45000), "45 секунд назад")
    same("rel ru -1814400000", human.format_relative("ru", -1814400000), "3 недели назад")
    same("rel ru -1260000", human.format_relative("ru", -1260000), "21 минуту назад")
    same("rel ru 18000000", human.format_relative("ru", 18000000), "через 5 часов")
    same("bytes ru 0", human.format_bytes("ru", 0, false), "0 Б")
    same("bytes ru 1", human.format_bytes("ru", 1, false), "1 Б")
    same("bytes ru 999", human.format_bytes("ru", 999, false), "999 Б")
    same("bytes ru 1000", human.format_bytes("ru", 1000, false), "1 кБ")
    same("bytes ru 2250", human.format_bytes("ru", 2250, false), "2,2 кБ")
    same("bytes ru 12345678", human.format_bytes("ru", 12345678, false), "12,3 МБ")
    same("bytes ru 999999", human.format_bytes("ru", 999999, false), "1 МБ")
    same("bytes ru 5000000000", human.format_bytes("ru", 5000000000, false), "5 ГБ")
    same("bytes ru 3603294110435203000", human.format_bytes("ru", 3603294110435203000, false), "3\u{A0}603,3 ПБ")
    same("dt ru 4 2", human.format_datetime("ru", t, 4 as u32, 2 as u32), "понедельник, 21 сентября 2026\u{202F}г. в 14:13:20")
    same("dt ru 4 1", human.format_datetime("ru", t, 4 as u32, 1 as u32), "понедельник, 21 сентября 2026\u{202F}г. в 14:13")
    same("dt ru 3 1", human.format_datetime("ru", t, 3 as u32, 1 as u32), "21 сентября 2026\u{202F}г. в 14:13")
    same("dt ru 2 2", human.format_datetime("ru", t, 2 as u32, 2 as u32), "21 сент. 2026\u{202F}г., 14:13:20")
    same("dt ru 2 1", human.format_datetime("ru", t, 2 as u32, 1 as u32), "21 сент. 2026\u{202F}г., 14:13")
    same("dt ru 1 9", human.format_datetime("ru", t, 1 as u32, 9 as u32), "21.09.2026")
    same("dt ru 9 2", human.format_datetime("ru", t, 9 as u32, 2 as u32), "14:13:20")
    same("dt ru 9 1", human.format_datetime("ru", t, 9 as u32, 1 as u32), "14:13")
    same("dt ru 4 9", human.format_datetime("ru", t, 4 as u32, 9 as u32), "понедельник, 21 сентября 2026\u{202F}г.")
    same("dt ru 3 9", human.format_datetime("ru", t, 3 as u32, 9 as u32), "21 сентября 2026\u{202F}г.")
    same("dt ru 2 9", human.format_datetime("ru", t, 2 as u32, 9 as u32), "21 сент. 2026\u{202F}г.")
    same("pct ru 0", human.format_percent("ru", 0.5712, 0 as u32), "57\u{A0}%")
    same("pct ru 1", human.format_percent("ru", 0.5712, 1 as u32), "57,1\u{A0}%")
    same("list ru 1", human.format_list("ru", "Alpha", 124 as u8, false), "Alpha")
    same("list ru 2", human.format_list("ru", "Alpha|Bravo", 124 as u8, false), "Alpha и Bravo")
    same("list ru 3", human.format_list("ru", "Alpha|Bravo|Charlie", 124 as u8, false), "Alpha, Bravo и Charlie")
    same("list ru 4", human.format_list("ru", "Alpha|Bravo|Charlie|Delta", 124 as u8, false), "Alpha, Bravo, Charlie и Delta")
    var vz: time.Tz = time.tz_new()
    var nz: time.Tz = time.tz_new()
    let vok: bool = time.tz_load("/usr/share/zoneinfo/Europe/Vienna", &vz) catch false
    let nok: bool = time.tz_load("/usr/share/zoneinfo/America/New_York", &nz) catch false
    if vok && nok {
        same("zone en Europe/Vienna 1790000000000", human.format_in_zone("en", &vz, 1790000000000, 3 as u32, 2 as u32), "September 21, 2026 at 4:13:20\u{202F}PM")
        same("zone en Europe/Vienna 1767243600000", human.format_in_zone("en", &vz, 1767243600000, 3 as u32, 2 as u32), "January 1, 2026 at 6:00:00\u{202F}AM")
        same("zone en America/New_York 1790000000000", human.format_in_zone("en", &nz, 1790000000000, 3 as u32, 2 as u32), "September 21, 2026 at 10:13:20\u{202F}AM")
        same("zone en America/New_York 1767243600000", human.format_in_zone("en", &nz, 1767243600000, 3 as u32, 2 as u32), "January 1, 2026 at 12:00:00\u{202F}AM")
        same("zone de Europe/Vienna 1790000000000", human.format_in_zone("de", &vz, 1790000000000, 3 as u32, 2 as u32), "21. September 2026 um 16:13:20")
        same("zone de Europe/Vienna 1767243600000", human.format_in_zone("de", &vz, 1767243600000, 3 as u32, 2 as u32), "1. Januar 2026 um 06:00:00")
        same("zone de America/New_York 1790000000000", human.format_in_zone("de", &nz, 1790000000000, 3 as u32, 2 as u32), "21. September 2026 um 10:13:20")
        same("zone de America/New_York 1767243600000", human.format_in_zone("de", &nz, 1767243600000, 3 as u32, 2 as u32), "1. Januar 2026 um 00:00:00")
        same("zone ru Europe/Vienna 1790000000000", human.format_in_zone("ru", &vz, 1790000000000, 3 as u32, 2 as u32), "21 сентября 2026\u{202F}г. в 16:13:20")
        same("zone ru Europe/Vienna 1767243600000", human.format_in_zone("ru", &vz, 1767243600000, 3 as u32, 2 as u32), "1 января 2026\u{202F}г. в 06:00:00")
        same("zone ru America/New_York 1790000000000", human.format_in_zone("ru", &nz, 1790000000000, 3 as u32, 2 as u32), "21 сентября 2026\u{202F}г. в 10:13:20")
        same("zone ru America/New_York 1767243600000", human.format_in_zone("ru", &nz, 1767243600000, 3 as u32, 2 as u32), "1 января 2026\u{202F}г. в 00:00:00")
        same("offset", human.format_offset(120 as i32), "UTC+02:00")
        same("offset", human.format_offset(-570 as i32), "UTC-09:30")
        same("offset", human.format_offset(0 as i32), "UTC")
    }
    time.tz_free(&vz)
    time.tz_free(&nz)
    if bad > 0 {
        io.fmt_print_line(f"FAIL {bad} of {done}")
        return 1
    }
    io.fmt_print_line(f"human: ok ({done} texts)")
    return 0
}
