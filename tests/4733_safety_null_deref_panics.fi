// expect_exit: 101
// wasm_skip: a null dereference is harmless in the wasm linear memory (exit 0)
// not_mode: opt
// only_target: x86_64
// N1 closed: a read through a null raw pointer ends with "firn: null pointer dereference" and exit code 101, not a silent SIGSEGV.
fn main() -> i32 {
    let p: *mut i64 = 0 as *mut i64
    let v: i64 = *p
    return v as i32
}
