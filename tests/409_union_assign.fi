// expect_exit: 0
// Assignment to a variable of type E!T: value and error variant.
error E { A, B }

fn source(n: i32) -> E!i32 {
    if n == 0 {
        return E::A
    }
    return n
}

fn main() -> i32 {
    var d: E!i32 = source(1)
    if (d catch 0) != 1 {
        return 1
    }
    d = 8
    if (d catch 0) != 8 {
        return 2
    }
    d = E::B
    if (d catch 0 - 3) != 0 - 3 {
        return 3
    }
    d = source(9)
    if (d catch 0) != 9 {
        return 4
    }
    return 0
}
