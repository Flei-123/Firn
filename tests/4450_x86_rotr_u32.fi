// expect_exit: 0
// only_mode: opt
// tests/4450_x86_rotr_u32.fi -- the plain `u32` rotate `(x >> n) | (x << (32 - n))` becomes ONE
// `ror r32, n` on x86-64 (compiler/src/rotate.rs `run_u32`, BinOp::Rotr32). Every form must
// compute exactly what n single-bit rotations compute, for edge values and random values.
//
//   A  nine counts through wrappers (constant counts after inlining), both operand orders
//   B  a rotate of a rotate and a rotate whose result feeds a 64-bit value
//   C  NOT rotates: different sources, counts that do not add up to 32, u16 operands
import std.io

// reference: n single-bit rotations
fn ref_rotr(x: u32, n: u32) -> u32 {
    var v: u32 = x
    var k: u32 = 0
    while k < n {
        v = (v >> 1) | ((v & 1) << 31)
        k = k + 1
    }
    return v
}

fn r1(x: u32) -> u32 { return (x >> 1) | (x << 31) }
fn r2(x: u32) -> u32 { return (x << 30) | (x >> 2) }
fn r6(x: u32) -> u32 { return (x >> 6) | (x << 26) }
fn r7(x: u32) -> u32 { return (x >> 7) | (x << 25) }
fn r11(x: u32) -> u32 { return (x << 21) | (x >> 11) }
fn r13(x: u32) -> u32 { return (x >> 13) | (x << 19) }
fn r17(x: u32) -> u32 { return (x >> 17) | (x << 15) }
fn r25(x: u32) -> u32 { return (x >> 25) | (x << 7) }
fn r31(x: u32) -> u32 { return (x >> 31) | (x << 1) }

// B: sigma-style mix as in SHA-256
fn big_sigma1(e: u32) -> u32 { return ((e >> 6) | (e << 26)) ^ ((e >> 11) | (e << 21)) ^ ((e >> 25) | (e << 7)) }
fn big_sigma1_ref(e: u32) -> u32 { return ref_rotr(e, 6) ^ ref_rotr(e, 11) ^ ref_rotr(e, 25) }
fn twice(x: u32) -> u32 {
    let a: u32 = (x >> 3) | (x << 29)
    return (a >> 5) | (a << 27)
}
fn wide(x: u32) -> u64 {
    let r: u32 = (x >> 9) | (x << 23)
    return (r as u64) << 32 | (x as u64)
}

// C: look alike, are not
fn other_source(x: u32, y: u32) -> u32 { return (x >> 4) | (y << 28) }
fn wrong_sum(x: u32) -> u32 { return (x >> 4) | (x << 27) }
fn u16_rot(x: u16) -> u16 { return (x >> 3) | (x << 13) }

fn check(x: u32) -> i32 {
    var bad: i32 = 0
    if r1(x) != ref_rotr(x, 1) { bad = bad + 1 }
    if r2(x) != ref_rotr(x, 2) { bad = bad + 1 }
    if r6(x) != ref_rotr(x, 6) { bad = bad + 1 }
    if r7(x) != ref_rotr(x, 7) { bad = bad + 1 }
    if r11(x) != ref_rotr(x, 11) { bad = bad + 1 }
    if r13(x) != ref_rotr(x, 13) { bad = bad + 1 }
    if r17(x) != ref_rotr(x, 17) { bad = bad + 1 }
    if r25(x) != ref_rotr(x, 25) { bad = bad + 1 }
    if r31(x) != ref_rotr(x, 31) { bad = bad + 1 }
    if big_sigma1(x) != big_sigma1_ref(x) { bad = bad + 1 }
    if twice(x) != ref_rotr(x, 8) { bad = bad + 1 }
    if wide(x) != ((ref_rotr(x, 9) as u64) << 32 | (x as u64)) { bad = bad + 1 }
    if other_source(x, x) != ((x >> 4) | (x << 28)) { bad = bad + 1 }
    if other_source(x, 0) != (x >> 4) { bad = bad + 1 }
    if wrong_sum(x) != ((x >> 4) | (x << 27)) { bad = bad + 1 }
    return bad
}

fn main() -> i32 {
    var bad: i32 = 0
    // edge values
    bad = bad + check(0)
    bad = bad + check(1)
    bad = bad + check(4294967295)
    bad = bad + check(2147483649)
    bad = bad + check(2147483648)
    bad = bad + check(305419896)
    // random values
    var s: u64 = 88172645463325252
    var i: u64 = 0
    while i < 4000 {
        s = s ^ (s << 13)
        s = s ^ (s >> 7)
        s = s ^ (s << 17)
        bad = bad + check((s >> 16) as u32 & 4294967295)
        i = i + 1
    }
    // u16 operands keep their own semantics
    var k: u32 = 0
    while k < 65536 {
        let x: u16 = k as u16
        let want: u16 = (((k >> 3) | (k << 13)) & 65535) as u16
        if u16_rot(x) != want { bad = bad + 1 }
        k = k + 257
    }
    if bad != 0 {
        io.println_str("u32 rotate mismatches")
        return 1
    }
    return 0
}
