// expect_out: 1 1 2 128 200 12800 198 1 0
// GENERATED by lib/rc/gen_tests.sh: line 1 and the body from
// lib/rc/parts/552_rc_cycle_leak.fi, with tests/modules/rc.fi VERBATIM in between.
// Module 'rc' -- stage 2 of the memory model (SPEC.md 3.4, requirement S7):
// shared, ALWAYS IMMUTABLE values with counting, plus weak references that
// break cycles by hand.
//
// Pure Firn, no compiler change. The memory comes straight from mmap(2)
// (no MAP_FIXED, no fixed address; a failed mmap is reported visibly and
// never silently passed off as success).
//
// Use from tests/:           import modules.rc
// Library path:              lib/rc/rc.fi  (a symlink to exactly this file)
//
// DEVIATIONS from SPEC 3.4 (reasons in the report docs/reports/rclib.md
// and in docs/RC.md):
//   A1  The type names are 'RefCount[T]' and 'WeakRef[T]'.
//       'Rc'/'Weak'/'Arc' are reserved in the parser as type constructors
//       that are not implemented yet (compiler/src/parser.rs,
//       not_implemented_ty) and cannot be taken by a pure Firn module.
//       The function names follow the agreed contract
//       (rc_new, rc_read, rc_clone, rc_free, rc_strong_number,
//       weak_of, promote, weak_free).
//   A2  Stage 0 has no methods: 'Rc[T].new' is the function 'rc_new'.
//   A3  Stage 0 has no 'inout': the heap parameter is a '*mut RcHeap'.
//   A4  The success value of the allocation comes through an out pointer, the
//       return type is 'AllocError!bool'. Reason: monomorphisation does not
//       substitute type arguments in the payload of an error union --
//       'fn f[T](..) -> AllocError!RefCount[T]' reports
//       "unknown type 'RefCount__T'". The allocation thereby stays
//       fully fallible (DESIGN_GOALS 2) and the result is
//       '#[must_consume]'; discarding it is a compile error
//       (tests/neg/rc_discarded.fi).
//   A5  'Arc[T]' (atomic counter) is NOT built -- open.
//
// CYCLES LEAK. That is intended and is made visible in
// tests/552_rc_cycle_leak.fi instead of being hidden. For the DOM 'Rc' is
// therefore explicitly NOT intended -- 'gc class'/'Gc[T]' exists for that
// (SPEC 3.5). See docs/RC.md.

export {
    AllocError, RcHeap, RefCount, WeakRef,
    rc_heap_init, rc_heap_free, rc_heap_capacity, rc_heap_live,
    rc_heap_used_bytes, rc_heap_allocations, rc_heap_releases,
    rc_size_of, rc_ld64, rc_st64,
    rc_new, rc_empty, rc_is_empty, rc_read, rc_clone, rc_free,
    rc_strong_number, rc_weak_number, rc_equal,
    rc_raw_address, rc_value_address, rc_raw_ref,
    weak_of, weak_empty, weak_is_empty, promote, weak_free,
    weak_strong_number, weak_raw_address
}

// The error set of the fallible allocation (DESIGN_GOALS 2). Error set names
// are program-wide (SPEC 14.1); in the final state the GC runtime declares it
// (module 'gckern'). As long as that is not in the tree yet, it lives here --
// module 'mess' resolves the duplication once both versions exist.
error AllocError { OutOfMemory }

const RC_SYS_MMAP: i64 = 9
const RC_SYS_MUNMAP: i64 = 11
const RC_PROT_READ_WRITE: i64 = 3
const RC_MAP_PRIVATE_ANON: i64 = 34

// Block header: 32 bytes, the value after it.
//   +0   strong     u64   number of strong references
//   +8   weak       u64   number of weak references
//   +16  class      u64   size class (for the free list)
//   +24  next       u64   link in the free list (only while free)
//   +32  value      T
const RC_HEADER: usize = 32
const RC_CLASSES: usize = 8
const RC_CLASS0: usize = 64

// Counting, shared, immutable reference (SPEC 3.4 'Rc[T]').
// 'block' is 0 when the reference is empty.
struct RefCount[T] { block: usize }

// Weak reference (SPEC 3.4 'Weak[T]'), does NOT keep the value alive.
struct WeakRef[T] { block: usize }

// The heap. Fixed capacity -- exactly that is what makes the allocation
// fallible and is the basis for memory limits per job.
struct RcHeap {
    base: usize,
    capacity: usize,
    next: usize,
    free: [usize; 8],
    live: usize,
    used: usize,
    allocations: usize,
    releases: usize,
}

// Helper type to determine the stride of a type without 'sizeof'.
struct RcPair[T] { a: T, b: T }

fn rc_pages(n: usize) -> usize {
    return (n + 4095 as usize) / 4096 as usize * 4096 as usize
}

fn rc_ld64(addr: usize) -> u64 {
    return *(addr as *mut u64)
}

fn rc_st64(addr: usize, v: u64) {
    *(addr as *mut u64) = v
}

// Stride (size including alignment) of the type T.
fn rc_size_of[T: Any](pattern: T) -> usize {
    var p: RcPair[T] = RcPair[T] { a: pattern, b: pattern }
    return (&p.b) as usize - (&p.a) as usize
}

fn rc_class_bytes(k: usize) -> usize {
    var b: usize = RC_CLASS0
    var i: usize = 0 as usize
    while i < k {
        b = b * 2 as usize
        i = i + 1 as usize
    }
    return b
}

// Smallest class that 'total' bytes fit into; RC_CLASSES = too large.
fn rc_class_for(total: usize) -> usize {
    var k: usize = 0 as usize
    while k < RC_CLASSES {
        if total <= rc_class_bytes(k) {
            return k
        }
        k = k + 1 as usize
    }
    return RC_CLASSES
}

// Creates the heap. false = mmap failed (a visible failure, the caller MUST
// abort). Without a fixed address, without MAP_FIXED.
fn rc_heap_init(h: *mut RcHeap, bytes: usize) -> bool {
    (*h).base = 0 as usize
    (*h).capacity = 0 as usize
    (*h).next = 0 as usize
    (*h).live = 0 as usize
    (*h).used = 0 as usize
    (*h).allocations = 0 as usize
    (*h).releases = 0 as usize
    var i: usize = 0 as usize
    while i < RC_CLASSES {
        (*h).free[i] = 0 as usize
        i = i + 1 as usize
    }
    if bytes == 0 as usize {
        return false
    }
    let len: usize = rc_pages(bytes)
    let r: i64 = syscall(RC_SYS_MMAP, 0, len as i64, RC_PROT_READ_WRITE,
        RC_MAP_PRIVATE_ANON, 0 - 1, 0)
    if r < 0 && r > 0 - 4096 {
        return false
    }
    if r == 0 {
        return false
    }
    (*h).base = r as usize
    (*h).capacity = len
    return true
}

fn rc_heap_free(h: *mut RcHeap) {
    if (*h).base != 0 as usize {
        syscall(RC_SYS_MUNMAP, (*h).base as i64, (*h).capacity as i64)
    }
    (*h).base = 0 as usize
    (*h).capacity = 0 as usize
    (*h).next = 0 as usize
}

fn rc_heap_capacity(h: *mut RcHeap) -> usize { return (*h).capacity }
fn rc_heap_live(h: *mut RcHeap) -> usize { return (*h).live }
fn rc_heap_used_bytes(h: *mut RcHeap) -> usize { return (*h).used }
fn rc_heap_allocations(h: *mut RcHeap) -> usize { return (*h).allocations }
fn rc_heap_releases(h: *mut RcHeap) -> usize { return (*h).releases }

// Fetch a raw block. 0 = out of memory.
fn rc_block_get(h: *mut RcHeap, payload: usize) -> usize {
    let k: usize = rc_class_for(RC_HEADER + payload)
    if k >= RC_CLASSES {
        return 0 as usize
    }
    let gr: usize = rc_class_bytes(k)
    var addr: usize = (*h).free[k]
    if addr != 0 as usize {
        (*h).free[k] = rc_ld64(addr + 24 as usize) as usize
    } else {
        if (*h).base == 0 as usize {
            return 0 as usize
        }
        if (*h).next + gr > (*h).capacity {
            return 0 as usize
        }
        addr = (*h).base + (*h).next
        (*h).next = (*h).next + gr
    }
    rc_st64(addr + 0 as usize, 0 as u64)
    rc_st64(addr + 8 as usize, 0 as u64)
    rc_st64(addr + 16 as usize, k as u64)
    rc_st64(addr + 24 as usize, 0 as u64)
    (*h).live = (*h).live + 1 as usize
    (*h).used = (*h).used + gr
    (*h).allocations = (*h).allocations + 1 as usize
    return addr
}

fn rc_block_back(h: *mut RcHeap, addr: usize) {
    let k: usize = rc_ld64(addr + 16 as usize) as usize
    if k >= RC_CLASSES {
        return
    }
    rc_st64(addr + 24 as usize, (*h).free[k] as u64)
    (*h).free[k] = addr
    (*h).live = (*h).live - 1 as usize
    (*h).used = (*h).used - rc_class_bytes(k)
    (*h).releases = (*h).releases + 1 as usize
}

// Puts 'value' on the heap and yields a strong reference in '*out'.
// FALLIBLE (DESIGN_GOALS 2): AllocError::OutOfMemory on an exhausted heap.
// The result is '#[must_consume]' -- discarding it is a compile error.
fn rc_new[T: Any](h: *mut RcHeap, value: T, out: *mut RefCount[T]) -> AllocError!bool {
    (*out).block = 0 as usize
    let gr: usize = rc_size_of[T](value)
    let addr: usize = rc_block_get(h, gr)
    if addr == 0 as usize {
        return AllocError::OutOfMemory
    }
    rc_st64(addr + 0 as usize, 1 as u64)
    rc_st64(addr + 8 as usize, 0 as u64)
    *((addr + RC_HEADER) as *mut T) = value
    (*out).block = addr
    return true
}

fn rc_empty[T: Any]() -> RefCount[T] {
    return RefCount[T] { block: 0 as usize }
}

fn rc_is_empty[T: Any](r: RefCount[T]) -> bool {
    return r.block == 0 as usize
}

// READ ONLY. 'Rc' is always immutable (SPEC 3.4): there is no RefCell
// equivalent and no writing function in this module.
// What is returned is a copy of the value -- changes to it do not propagate
// back to the shared value.
fn rc_read[T: Any](r: RefCount[T]) -> T {
    return *((r.block + RC_HEADER) as *mut T)
}

fn rc_clone[T: Any](r: RefCount[T]) -> RefCount[T] {
    if r.block == 0 as usize {
        return RefCount[T] { block: 0 as usize }
    }
    rc_st64(r.block + 0 as usize, rc_ld64(r.block + 0 as usize) + 1 as u64)
    return RefCount[T] { block: r.block }
}

// Returns a strong reference and clears it. If the strong count falls to 0
// and no weak reference holds the block either, it becomes reusable.
fn rc_free[T: Any](h: *mut RcHeap, r: *mut RefCount[T]) {
    let addr: usize = (*r).block
    if addr == 0 as usize {
        return
    }
    (*r).block = 0 as usize
    let s: u64 = rc_ld64(addr + 0 as usize)
    if s == 0 as u64 {
        return
    }
    rc_st64(addr + 0 as usize, s - 1 as u64)
    if s - 1 as u64 == 0 as u64 && rc_ld64(addr + 8 as usize) == 0 as u64 {
        rc_block_back(h, addr)
    }
}

fn rc_strong_number[T: Any](r: RefCount[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return rc_ld64(r.block + 0 as usize)
}

fn rc_weak_number[T: Any](r: RefCount[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return rc_ld64(r.block + 8 as usize)
}

fn rc_equal[T: Any](a: RefCount[T], b: RefCount[T]) -> bool {
    return a.block == b.block
}

// Raw access (SPEC 3.6): the block address resp. the address of the value.
// For tools and the leak proof only -- no way to make 'Rc' writable; whoever
// writes through this leaves the checked types behind.
fn rc_raw_address[T: Any](r: RefCount[T]) -> usize { return r.block }

// Build a reference from a block address again, WITHOUT changing the count.
// For tools only: stage 0 has no destructors, so references stored inside an
// object have to be released by hand
// (SPEC 3.6 raw pointers; in the final state 'drop' does that, SPEC 3.3).
fn rc_raw_ref[T: Any](addr: usize) -> RefCount[T] {
    return RefCount[T] { block: addr }
}
fn rc_value_address[T: Any](r: RefCount[T]) -> usize {
    if r.block == 0 as usize {
        return 0 as usize
    }
    return r.block + RC_HEADER
}

fn weak_of[T: Any](r: RefCount[T]) -> WeakRef[T] {
    if r.block == 0 as usize {
        return WeakRef[T] { block: 0 as usize }
    }
    rc_st64(r.block + 8 as usize, rc_ld64(r.block + 8 as usize) + 1 as u64)
    return WeakRef[T] { block: r.block }
}

fn weak_empty[T: Any]() -> WeakRef[T] {
    return WeakRef[T] { block: 0 as usize }
}

fn weak_is_empty[T: Any](w: WeakRef[T]) -> bool {
    return w.block == 0 as usize
}

fn weak_raw_address[T: Any](w: WeakRef[T]) -> usize { return w.block }

fn weak_strong_number[T: Any](w: WeakRef[T]) -> u64 {
    if w.block == 0 as usize {
        return 0 as u64
    }
    return rc_ld64(w.block + 0 as usize)
}

// Promotion: visibly yields the EMPTY reference when the strong count is
// already 0 (that is, the target has been collected).
fn promote[T: Any](w: WeakRef[T]) -> RefCount[T] {
    if w.block == 0 as usize {
        return RefCount[T] { block: 0 as usize }
    }
    let s: u64 = rc_ld64(w.block + 0 as usize)
    if s == 0 as u64 {
        return RefCount[T] { block: 0 as usize }
    }
    rc_st64(w.block + 0 as usize, s + 1 as u64)
    return RefCount[T] { block: w.block }
}

fn weak_free[T: Any](h: *mut RcHeap, w: *mut WeakRef[T]) {
    let addr: usize = (*w).block
    if addr == 0 as usize {
        return
    }
    (*w).block = 0 as usize
    let s: u64 = rc_ld64(addr + 8 as usize)
    if s == 0 as u64 {
        return
    }
    rc_st64(addr + 8 as usize, s - 1 as u64)
    if s - 1 as u64 == 0 as u64 && rc_ld64(addr + 0 as usize) == 0 as u64 {
        rc_block_back(h, addr)
    }
}

// MANDATORY PROOF for SPEC 3.4: an Rc CYCLE LEAKS. That is not a fault of
// this implementation but the documented property of counting -- and exactly
// the reason why 'Rc' is explicitly NOT intended for the DOM
// (see docs/RC.md). The test makes the leak VISIBLE instead of hiding it.
//
// Setup: two cells a and b that hold each other strongly.
// 'Rc' is always immutable (no RefCell equivalent), so the back reference
// cannot be filled in through the Rc interface -- the test uses the raw
// pointer from SPEC 3.6 for that (rc_value_address). That is exactly what
// interior mutability would do; with it the same cycle would be reachable
// from ordinary application code.
//
// Output (one line):
//   strong_a strong_b live used     after discarding ONE cycle
//   live100 used100                 after 100 created+discarded cycles
//   live_after_manual_release
//   promote_empty  live_weak_variant

struct Cell { partner: usize, id: i64 }

fn heap_empty() -> RcHeap {
    return RcHeap {
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
            0 as usize, 0 as usize, 0 as usize, 0 as usize],
        live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize,
    }
}

fn new_cell(h: *mut RcHeap, k: i64, out: *mut RefCount[Cell]) -> bool {
    return rc_new[Cell](h, Cell { partner: 0 as usize, id: k }, out) catch false
}

// Fills in the partner in a cell that has already been created. Raw access
// (SPEC 3.6) -- writing through 'Rc' itself is impossible, see
// tests/neg/rc_immutable.fi.
fn partner_set(r: RefCount[Cell], partner_block: usize) {
    let addr: usize = rc_value_address[Cell](r)
    *(addr as *mut usize) = partner_block
}

// Creates a real cycle a -> b -> a and discards both outer handles.
// What is left are the two references INSIDE the cells: the counts never
// fall to 0.
fn cycle_create_and_discard(h: *mut RcHeap) -> bool {
    var a: RefCount[Cell] = rc_empty[Cell]()
    var b: RefCount[Cell] = rc_empty[Cell]()
    if new_cell(h, 1, &a) == false { return false }
    if new_cell(h, 2, &b) == false { return false }
    // a holds b strongly, b holds a strongly.
    var a_in_b: RefCount[Cell] = rc_clone[Cell](a)
    var b_in_a: RefCount[Cell] = rc_clone[Cell](b)
    partner_set(a, rc_raw_address[Cell](b_in_a))
    partner_set(b, rc_raw_address[Cell](a_in_b))
    // The outer handles disappear (in a real program: the end of the block).
    rc_free[Cell](h, &a)
    rc_free[Cell](h, &b)
    return true
}

fn print_number(buf: *mut u8, pos: usize, v: u64) -> usize {
    var digits: [u8; 24] = [0 as u8; 24]
    var n: usize = 0 as usize
    var x: u64 = v
    if x == 0 as u64 {
        digits[0] = 48 as u8
        n = 1 as usize
    }
    while x > 0 as u64 {
        digits[n] = (x % 10 as u64) as u8 + 48 as u8
        x = x / 10 as u64
        n = n + 1 as usize
    }
    var i: usize = 0 as usize
    var p: usize = pos
    while i < n {
        *((buf as usize + p) as *mut u8) = digits[n - 1 as usize - i]
        p = p + 1 as usize
        i = i + 1 as usize
    }
    *((buf as usize + p) as *mut u8) = 32 as u8
    return p + 1 as usize
}

fn main() -> i32 {
    var h: RcHeap = heap_empty()
    if rc_heap_init(&h, 1048576 as usize) == false { return 90 }

    // --- part 1: ONE cycle, both counts stay at 1 -------------------------
    var a: RefCount[Cell] = rc_empty[Cell]()
    var b: RefCount[Cell] = rc_empty[Cell]()
    if new_cell(&h, 1, &a) == false { return 91 }
    if new_cell(&h, 2, &b) == false { return 92 }
    var a_in_b: RefCount[Cell] = rc_clone[Cell](a)
    var b_in_a: RefCount[Cell] = rc_clone[Cell](b)
    let addr_a: usize = rc_raw_address[Cell](a)
    let addr_b: usize = rc_raw_address[Cell](b)
    partner_set(a, addr_b)
    partner_set(b, addr_a)
    rc_free[Cell](&h, &a)
    rc_free[Cell](&h, &b)
    // Both counts still read 1 -- the cycle holds itself.
    let strong_a: u64 = rc_ld64(addr_a + 0 as usize)
    let strong_b: u64 = rc_ld64(addr_b + 0 as usize)
    let live1: usize = rc_heap_live(&h)
    let used1: usize = rc_heap_used_bytes(&h)

    // --- part 2: create and discard 100 cycles -> the consumption grows
    var i: i64 = 0
    while i < 99 {
        if cycle_create_and_discard(&h) == false { return 93 }
        i = i + 1
    }
    let live100: usize = rc_heap_live(&h)
    let used100: usize = rc_heap_used_bytes(&h)

    // --- part 3: release by hand (only that way does the memory come back) ---
    // Stage 0 has no destructors; the references stored in the cells have to be
    // released one by one. For the 99 cycles from part 2 the address is no
    // longer known -- that is exactly the leak. Only the first cycle, whose
    // addresses we still have, is released.
    var inner_a: RefCount[Cell] = rc_raw_ref[Cell](addr_a)
    var inner_b: RefCount[Cell] = rc_raw_ref[Cell](addr_b)
    rc_free[Cell](&h, &inner_a)
    rc_free[Cell](&h, &inner_b)
    let live_hand: usize = rc_heap_live(&h)

    // --- part 4: the same setup with Weak does NOT leak -------------------
    var h2: RcHeap = heap_empty()
    if rc_heap_init(&h2, 65536 as usize) == false { return 94 }
    var x: RefCount[Cell] = rc_empty[Cell]()
    var y: RefCount[Cell] = rc_empty[Cell]()
    if new_cell(&h2, 3, &x) == false { return 95 }
    if new_cell(&h2, 4, &y) == false { return 96 }
    // y holds x only WEAKLY, x holds y strongly -> no cycle of strong references.
    var w: WeakRef[Cell] = weak_of[Cell](x)
    var y_in_x: RefCount[Cell] = rc_clone[Cell](y)
    partner_set(x, rc_raw_address[Cell](y_in_x))
    partner_set(y, weak_raw_address[Cell](w))
    let addr_y: usize = rc_raw_address[Cell](y)
    rc_free[Cell](&h2, &y)
    rc_free[Cell](&h2, &x)
    // x is dead: promoting the weak reference visibly yields empty.
    var on: RefCount[Cell] = promote[Cell](w)
    var empty: u64 = 0 as u64
    if rc_is_empty[Cell](on) {
        empty = 1 as u64
    }
    // Release the inner strong reference from x to y by hand (no 'drop').
    var inner_y: RefCount[Cell] = rc_raw_ref[Cell](addr_y)
    rc_free[Cell](&h2, &inner_y)
    weak_free[Cell](&h2, &w)
    let live_weak: usize = rc_heap_live(&h2)

    var out: [u8; 128] = [0 as u8; 128]
    var p: usize = 0 as usize
    p = print_number(&out[0], p, strong_a)
    p = print_number(&out[0], p, strong_b)
    p = print_number(&out[0], p, live1 as u64)
    p = print_number(&out[0], p, used1 as u64)
    p = print_number(&out[0], p, live100 as u64)
    p = print_number(&out[0], p, used100 as u64)
    p = print_number(&out[0], p, live_hand as u64)
    p = print_number(&out[0], p, empty)
    p = print_number(&out[0], p, live_weak as u64)
    out[p - 1 as usize] = 10 as u8
    syscall(1, 1, &out[0], p as i64)

    rc_heap_free(&h)
    rc_heap_free(&h2)
    return 0
}
