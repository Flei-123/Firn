// expect_exit: 0
import std.format
import std.tostr

fn check(got: str, want: str, code: i32) -> i32 {
    if got == want {
        return 0
    }
    return code
}

fn main() -> i32 {
    let x: i64 = 3
    let y: i32 = 4
    let z: f64 = 7.5
    var bad: i32 = 0
    bad = bad + check(format.format3("z = {0} + {1} = {2}", x.to_str(), y.to_str(), z.to_str()), "z = 3 + 4 = 7.5", 1)
    bad = bad + check(format.format2("{1}{0}{1}", "a", "b"), "bab", 2)
    bad = bad + check(format.format1("{{{0}}}", "v"), "{v}", 4)
    bad = bad + check(format.format1("{0} {0}", "r"), "r r", 8)
    bad = bad + check(format.format2("{2}|{9}", "a", "b"), "{2}|{9}", 16)
    bad = bad + check(format.format0("plain {"), "plain {", 32)
    bad = bad + check(format.format1("{x} {", "a"), "{x} {", 64)
    bad = bad + check(format.format4("{3}{2}{1}{0}", "a", "b", "c", "d"), "dcba", 128)
    bad = bad + check(format.format5("{4}", "a", "b", "c", "d", "e"), "e", 256)
    bad = bad + check(format.format1("}}{0}{{", "q"), "}q{", 512)
    bad = bad + check(format.format1("héllo {0}", "w"), "héllo w", 1024)
    return bad
}
