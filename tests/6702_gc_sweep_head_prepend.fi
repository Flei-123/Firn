// expect_exit: 0
gc class Junk {
    next: Gc[Junk],
    a: u64,
}

gc class Mid {
    val: u64,
    f1: u64,
    f2: u64,
    f3: u64,
    f4: u64,
    f5: u64,
}

gc class Sink {
    m: Gc[Mid],
    j: Gc[Junk],
}

gc class Big {
    child: Gc[Mid],
    tag: u64,
    f1: u64,
    f2: u64,
    f3: u64,
    f4: u64,
    f5: u64,
    f6: u64,
    f7: u64,
    f8: u64,
    f9: u64,
}

gc class Parent {
    child: Gc[Mid],
    tag: u64,
    pad: [u64; 20],
}

const CHILD_VAL: u64 = 777777
const JUNK_CHUNKS_OBJS: u64 = 120000

#[no_inline]
fn junk(sink: Gc[Sink], n: u64) -> u64 {
    var i: u64 = 0
    var s: u64 = 0
    while i < n {
        let j: Gc[Junk] = gc Junk { next: sink.j, a: i } catch gc_null[Junk]()
        sink.j = j
        s = s + j.a
        i = i + 1
    }
    return s
}

#[no_inline]
fn mid(v: u64) -> Gc[Mid] {
    return gc Mid { val: v, f1: v, f2: v, f3: v, f4: v, f5: v } catch gc_null[Mid]()
}

#[no_inline]
fn big() -> Gc[Big] {
    return gc Big {
        child: gc_null[Mid](), tag: 5, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0, f8: 0, f9: 0,
    } catch gc_null[Big]()
}

#[no_inline]
fn parent() -> Gc[Parent] {
    return gc Parent { child: gc_null[Mid](), tag: 5, pad: [0; 20] } catch gc_null[Parent]()
}

#[no_inline]
fn mid_churn(sink: Gc[Sink], n: u64, v: u64) -> u64 {
    var i: u64 = 0
    var s: u64 = 0
    while i < n {
        let m: Gc[Mid] = mid(v)
        sink.m = m
        s = s + m.val
        i = i + 1
    }
    return s
}

#[no_inline]
fn move_child(holder: Gc[Big], to: Gc[Parent]) {
    to.child = holder.child
    holder.child = gc_null[Mid]()
}

#[no_inline]
fn wait_phase(sink: Gc[Sink], want: u64, limit: u64) -> u64 {
    var i: u64 = 0
    while i < limit {
        if gc_phase() == want {
            return 1
        }
        sink.m = mid(1)
        i = i + 1
    }
    return 0
}

fn main() -> i32 {
    gc_init()
    let holder: Gc[Big] = big()
    let sink: Gc[Sink] = gc Sink { m: gc_null[Mid](), j: gc_null[Junk]() } catch gc_null[Sink]()
    let warm: u64 = mid_churn(sink, 20000, 3)
    holder.child = mid(CHILD_VAL)
    let j: u64 = junk(sink, JUNK_CHUNKS_OBJS)
    sink.j = gc_null[Junk]()
    sink.m = gc_null[Mid]()
    gc_collect()
    gc_set_time_budget(1)
    gc_set_slice(16)
    gc_set_limit(4096)
    if wait_phase(sink, 2, 2000000) == 0 { return 11 }
    let parent: Gc[Parent] = parent()
    move_child(holder, parent)
    if wait_phase(sink, 0, 2000000) == 0 { return 12 }
    gc_set_time_budget(0)
    gc_set_slice(0)
    var r: u64 = 0
    while r < 4 {
        gc_collect()
        let c: u64 = mid_churn(sink, 40000, r + 1)
        r = r + 1
    }
    if parent.tag != 5 { return 2 }
    if parent.child.val != CHILD_VAL { return 1 }
    if parent.child.f5 != CHILD_VAL { return 3 }
    return 0
}
