// expect_exit: 0
// tests/4041_lambda_core.fi -- lambda sugar in the core language (r715): both compilers.
fn apply(f: fn(i32) -> i32, x: i32) -> i32 { return f(x) }
fn apply2(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 { return f(a, b) }
fn each(n: i32, acc: *mut i32, f: fn(*mut i32, i32)) {
    var i: i32 = 0
    while i < n {
        f(acc, i)
        i = i + 1
    }
}
fn call0(f: fn() -> i32) -> i32 { return f() }

fn main() -> i32 {
    if apply(| x | x + 1, 4) != 5 { return 1 }
    if apply2(| a, b | a * b, 3, 4) != 12 { return 2 }
    let r3: i32 = apply(| x | {
            let y: i32 = x * 2
            return y + 1
        }, 5)
    if r3 != 11 { return 3 }
    let f: fn(i32) -> i32 = | x | x - 1
    if f(10) != 9 { return 4 }
    let g = | x: i32, y: i32 | -> i32 x + y
    if g(2, 3) != 5 { return 5 }
    var total: i32 = 0
    each(5, &total, | acc, i | { *acc = *acc + i })
    if total != 10 { return 6 }
    if call0(|| 42) != 42 { return 7 }
    if apply(| x | apply(| y | y * 2, x) + 1, 3) != 7 { return 8 }
    let m: i32 = 6 | 1
    if m != 7 { return 9 }
    return 0
}
