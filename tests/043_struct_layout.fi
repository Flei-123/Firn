// expect_exit: 1
// Struct layout is checkable: declaration order, natural alignment.
// struct S { a: u8, b: i32, c: u8, d: i64 }
//   a @0, b @4 (4-aligned), c @8, d @16 (8-aligned), size 24
struct S {
    a: u8,
    b: i32,
    c: u8,
    d: i64,
}
fn main() -> i32 {
    var s: S = S { a: 1, b: 2, c: 3, d: 4, }
    let base: u64 = (&s.a) as u64
    let ob: u64 = (&s.b) as u64 - base
    let oc: u64 = (&s.c) as u64 - base
    let od: u64 = (&s.d) as u64 - base
    var arr: [S; 2] = [S { a: 0, b: 0, c: 0, d: 0, }, S { a: 0, b: 0, c: 0, d: 0, },]
    let stride: u64 = (&arr[1].a) as u64 - (&arr[0].a) as u64
    if ob == 4 && oc == 8 {
        if od == 16 && stride == 24 {
            return 1
        }
    }
    return 0
}
