// expect_exit: 0
// 'catch' yields the replacement value; the replacement may be any expression.
error E { A, B }

fn source(n: i32) -> E!i32 {
    if n == 0 {
        return E::A
    }
    return n
}

fn replacement() -> i32 {
    return 77
}

fn main() -> i32 {
    if (source(5) catch replacement()) != 5 {
        return 1
    }
    if (source(0) catch replacement()) != 77 {
        return 2
    }
    if (source(0) catch (source(4) catch 0)) != 4 {
        return 3
    }
    if (source(0) catch 1 + 2 * 3) != 7 {
        return 4
    }
    return 0
}
