// expect_exit: 0
// tests/3282_hash_xx64_lengths.fi -- `hash.xx64_seed` against python-xxhash 4.0.1
// (xxh64_intdigest). The 32 octet stripes, the 8/4/1 octet tails and the
// rotations were spelled out by hand (dev-fast has no inliner); every length
// 0..=200 at three start offsets and two seeds has to give the reference value,
// folded into one checksum.
import std.hash
import std.rt

const BUF: usize = 300
const EXPECT: u64 = 17921408896753010684 as u64

fn next_state(x: u64) -> u64 {
    return x *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
}

fn main() -> i32 {
    let buf: u64 = rt.heap_alloc(BUF)
    if buf == 0 {
        return 2
    }
    var x: u64 = 12345
    var i: usize = 0
    while i < BUF {
        x = next_state(x)
        *((buf + i as u64) as *mut u8) = ((x >> 33) & 255) as u8
        i = i + 1
    }
    let seed2: u64 = 11400714819323198485 as u64
    var acc: u64 = 0
    var off: usize = 0
    while off < 4 {
        if off != 2 {
            var n: usize = 0
            while n <= 200 {
                acc = acc *% 31 +% hash.xx64_seed(buf + off as u64, n, 0)
                acc = acc *% 31 +% hash.xx64_seed(buf + off as u64, n, seed2)
                n = n + 1
            }
        }
        off = off + 1
    }
    rt.heap_free(buf, BUF)
    if acc != EXPECT {
        return 1
    }
    return 0
}
