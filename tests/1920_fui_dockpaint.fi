// expect_exit: 42
// tests/1920_fui_dockpaint.fi -- lib/fuishell/dockpaint.fi (OpenPlan LIB-005):
// the dock drawn with fUi's painter, read back pixel by pixel -- area
// ground, tab strip, the active tab with its accent line, splitters, the
// drop hint while a tab is dragged (also onto a still empty side), and the
// tab title when a font is on the machine.
import fuishell.dock
import fuishell.dockpaint
import fui.layout
import fui.painter
import fui.theme
import paint.canvas
import font.metrics
import std.rt

const W: usize = 1000
const H: usize = 600
const FONTSET_BYTES: usize = 4096

fn px(cv: *mut canvas.Canvas, x: i64, y: i64) -> u32 {
    return canvas.canvas_get(cv, x as usize, y as usize) | 4278190080 as u32
}

fn col(c: u32) -> u32 {
    return c | 4278190080 as u32
}

fn main() -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) { return 1 as i32 }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 400, 200) { return 2 as i32 }
    var m: theme.Theme = theme.theme_new(false)
    let c: *mut theme.Colors = theme.theme_colors(&m)
    // the four colours this test tells apart must be four
    if col((*c).base) == col((*c).surface) || col((*c).base) == col((*c).separator)
    || col((*c).base) == col((*c).accent) || col((*c).surface) == col((*c).accent) {
        return 3 as i32
    }

    var d: dock.Dock = dock.dock_new()
    dock.dock_set_metrics(&d, 20, 4, 60, 100)
    let pages: u32 = dock.dock_add(&d, 11, dock.AREA_LEFT, "Pages")
    let devices: u32 = dock.dock_add(&d, 12, dock.AREA_LEFT, "Devices")
    let props: u32 = dock.dock_add(&d, 13, dock.AREA_RIGHT, "Properties")
    dock.dock_layout(&d, 0, 0, 1000, 600)
    canvas.canvas_clear(&cv, 4278190080 as u32) // black: anything not drawn stays black
    dockpaint.dock_paint(&d, &z, c, 13.0)

    // --- A. grounds: centre, left content, right content
    let ctr: layout.Rect = dock.dock_center(&d)
    if px(&cv, ctr.x + ctr.w / 2, ctr.y + ctr.h / 2) != col((*c).base) { return 4 as i32 }
    let lc: layout.Rect = dock.dock_content(&d, pages)
    if px(&cv, lc.x + 10, lc.y + 10) != col((*c).base) { return 5 as i32 }
    // no bottom panel: the bottom of the middle column is centre ground
    if px(&cv, 500, 595) != col((*c).base) { return 6 as i32 }

    // --- B. tabs: the active one is ground with an accent line on top,
    // the inactive one sits on the strip
    let ta: layout.Rect = dock.dock_tab(&d, pages)
    let tb: layout.Rect = dock.dock_tab(&d, devices)
    if ta.w <= 0 || tb.w <= 0 { return 7 as i32 }
    if px(&cv, ta.x + 3, ta.y) != col((*c).accent) { return 8 as i32 }
    if px(&cv, ta.x + 3, ta.y + 1) != col((*c).accent) { return 9 as i32 }
    if px(&cv, ta.x + 3, ta.y + 5) != col((*c).base) { return 10 as i32 }
    if px(&cv, tb.x + 3, tb.y + 5) != col((*c).surface) { return 11 as i32 }
    if px(&cv, tb.x + 3, tb.y) != col((*c).surface) { return 12 as i32 }
    // the separator under the strip
    let la: layout.Rect = dock.dock_area_rect(&d, dock.AREA_LEFT)
    if px(&cv, la.x + la.w - 2, la.y + 19) != col((*c).separator) { return 13 as i32 }

    // --- C. splitters
    let sl: layout.Rect = dock.dock_splitter(&d, dock.AREA_LEFT)
    let sr: layout.Rect = dock.dock_splitter(&d, dock.AREA_RIGHT)
    if sl.w != 4 || sr.w != 4 { return 14 as i32 }
    if px(&cv, sl.x + 1, 300) != col((*c).separator) { return 15 as i32 }
    if px(&cv, sr.x + 2, 300) != col((*c).separator) { return 16 as i32 }
    // nothing left undrawn: the four corners and the middle
    if px(&cv, 0, 0) == 4278190080 as u32 { return 17 as i32 }
    if px(&cv, 999, 599) == 4278190080 as u32 { return 18 as i32 }
    if dock.dock_drop_hint(&d) != dock.AREA_NONE { return 19 as i32 }

    // --- D. dragging the Properties tab over the centre: the centre is
    // veiled -- neither ground nor accent, but between the two -- and framed
    let tp: layout.Rect = dock.dock_tab(&d, props)
    dock.dock_mouse_down(&d, tp.x + 5, tp.y + 5)
    dock.dock_mouse_drag(&d, 500, 300)
    if dock.dock_drop_hint(&d) != dock.AREA_CENTER { return 20 as i32 }
    canvas.canvas_clear(&cv, 4278190080 as u32)
    dockpaint.dock_paint(&d, &z, c, 13.0)
    let v: u32 = px(&cv, ctr.x + ctr.w / 2, ctr.y + ctr.h / 2)
    if v == col((*c).base) || v == col((*c).accent) { return 21 as i32 }
    let hr: layout.Rect = dockpaint.hint_rect(&d, dock.AREA_CENTER)
    if px(&cv, hr.x + hr.w / 2, hr.y) != col((*c).accent) { return 22 as i32 }
    if px(&cv, hr.x, hr.y + hr.h / 2) != col((*c).accent) { return 23 as i32 }
    // the left area is not veiled
    if px(&cv, lc.x + 10, lc.y + 10) != col((*c).base) { return 24 as i32 }

    // --- E. to the empty bottom edge: the strip is the lower fifth of
    // the whole space
    dock.dock_mouse_drag(&d, 500, 590)
    if dock.dock_drop_hint(&d) != dock.AREA_BOTTOM { return 25 as i32 }
    let hb: layout.Rect = dockpaint.hint_rect(&d, dock.AREA_BOTTOM)
    if hb.x != 0 || hb.y != 480 || hb.w != 1000 || hb.h != 120 { return 26 as i32 }
    canvas.canvas_clear(&cv, 4278190080 as u32)
    dockpaint.dock_paint(&d, &z, c, 13.0)
    if px(&cv, 500, 480) != col((*c).accent) { return 27 as i32 }
    let vb: u32 = px(&cv, 500, 540)
    if vb == col((*c).base) || vb == col((*c).accent) { return 28 as i32 }
    // above the strip: plain ground
    if px(&cv, 500, 400) != col((*c).base) { return 29 as i32 }
    dock.dock_mouse_up(&d, 500, 590)
    if dock.dock_area_of(&d, props) != dock.AREA_BOTTOM { return 30 as i32 }
    canvas.canvas_clear(&cv, 4278190080 as u32)
    dockpaint.dock_paint(&d, &z, c, 13.0)
    if dock.dock_drop_hint(&d) != dock.AREA_NONE { return 31 as i32 }
    let bs: layout.Rect = dock.dock_splitter(&d, dock.AREA_BOTTOM)
    if bs.h <= 0 { return 32 as i32 }
    if px(&cv, bs.x + bs.w / 2, bs.y + 1) != col((*c).separator) { return 33 as i32 }

    // --- F. the title, when the machine has the font: some pixel of the
    // active tab's text box is darker than the ground
    var fbuf: rt.Buf = rt.buf_new()
    var fpath: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    if rt.read_file((&fpath[0]) as u64, &fbuf) {
        let fsp: *mut metrics.FontSet = rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
        *fsp = metrics.fontset_new()
        if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) { return 34 as i32 }
        painter.painter_set_font(&z, fsp as u64)
        canvas.canvas_clear(&cv, 4278190080 as u32)
        dockpaint.dock_paint(&d, &z, c, 13.0)
        let t2: layout.Rect = dock.dock_tab(&d, pages)
        var inked: i64 = 0
        var y: i64 = t2.y + 3
        while y < t2.y + t2.h - 1 {
            var x: i64 = t2.x + 8
            while x < t2.x + t2.w - 8 {
                if px(&cv, x, y) != col((*c).base) { inked = inked + 1 }
                x = x + 1
            }
            y = y + 1
        }
        if inked < 20 { return 35 as i32 }
        // and the text stays inside its tab: the strip right of the tab
        // edge is untouched by it
        if px(&cv, t2.x + t2.w + 2, t2.y + 10) == col((*c).text) { return 36 as i32 }
    }

    dock.dock_free(&d)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 42 as i32
}
