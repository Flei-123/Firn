// expect_exit: 0
import std.rt

fn digits_of(v: u64, out: *mut u8) -> usize {
    var tmp: [u8; 24] = [0 as u8; 24]
    var n: usize = 0
    var x: u64 = v
    if x == 0 {
        *out = 48 as u8
        return 1
    }
    while x > 0 {
        tmp[n] = (x % 10 + 48) as u8
        x = x / 10
        n = n + 1
    }
    var i: usize = 0
    while i < n {
        *((out as u64 +% i as u64) as *mut u8) = tmp[n - 1 - i]
        i = i + 1
    }
    return n
}

fn main() -> i32 {
    var vals: [u64; 48] = [0 as u64; 48]
    var nv: usize = 0
    var q: u64 = 1
    var j: usize = 0
    while j < 20 {
        vals[nv] = q
        nv = nv + 1
        vals[nv] = q - 1
        nv = nv + 1
        if j < 19 { q = q * 10 }
        j = j + 1
    }
    vals[nv] = 0 as u64 -% 1
    nv = nv + 1
    vals[nv] = 0
    nv = nv + 1
    vals[nv] = 1234
    nv = nv + 1
    vals[nv] = 4056
    nv = nv + 1
    vals[nv] = 507
    nv = nv + 1
    vals[nv] = 80
    nv = nv + 1
    var bad: u32 = 0
    var vi: usize = 0
    while vi < nv {
        var want: [u8; 24] = [0 as u8; 24]
        let wn: usize = digits_of(vals[vi], &want[0])
        var pre: usize = 0
        while pre < 130 {
            var b: rt.Buf = rt.buf_new()
            var i: usize = 0
            while i < pre {
                rt.buf_push(&b, 120 as u8)
                i = i + 1
            }
            rt.buf_push_dec_u64(&b, vals[vi])
            rt.buf_push(&b, 33 as u8)
            if rt.buf_len(&b) != pre + wn + 1 { bad = bad + 1 }
            var d: usize = 0
            while d < wn {
                if rt.ld8(rt.buf_ptr(&b), pre + d) != want[d] { bad = bad + 1 }
                d = d + 1
            }
            if rt.ld8(rt.buf_ptr(&b), pre + wn) != 33 as u8 { bad = bad + 1 }
            rt.buf_free(&b)
            pre = pre + 1
        }
        vi = vi + 1
    }
    if bad != 0 { return 1 }
    return 0
}
