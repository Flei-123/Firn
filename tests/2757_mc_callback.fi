// expect_exit: 0
// tests/2757_mc_callback.fi -- D2: callbacks with state for the Minecraft client need no extra library, the
// compiler has closures since round 58 (fnval.rs, docs/ROUND58.md). Captured values are COPIES; shared mutable
// state is captured as a Gc pointer. Shows the three shapes a client needs: a capture-free handler, a handler
// with a captured copy (packet id filter), a handler that updates shared state (packet counter).
gc class Counter { n: i64, last_id: i64 }

fn dispatch(h: fn(i64) -> bool, id: i64) -> bool { return h(id) }

fn plain_handler(id: i64) -> bool { return id == 0x26 }

fn filter_for(want: i64) -> AllocError!fn(i64) -> bool {
    return try gc fn(id: i64) -> bool { return id == want }
}

fn counting(c: Gc[Counter]) -> AllocError!fn(i64) -> bool {
    return try gc fn(id: i64) -> bool {
        c.n = c.n + 1
        c.last_id = id
        return true
    }
}

fn run() -> AllocError!i32 {
    if !dispatch(plain_handler, 0x26) { return 1 }
    if dispatch(plain_handler, 0x27) { return 2 }
    let keep_alive: fn(i64) -> bool = try filter_for(0x24)
    if !dispatch(keep_alive, 0x24) { return 3 }
    if dispatch(keep_alive, 0x25) { return 4 }
    let c: Gc[Counter] = try gc Counter { n: 0, last_id: 0 }
    let count: fn(i64) -> bool = try counting(c)
    dispatch(count, 7)
    dispatch(count, 9)
    if c.n != 2 { return 5 }
    if c.last_id != 9 { return 6 }
    return 0
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}
