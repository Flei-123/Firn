// expect_exit: 0
import std.rt
import mc.mc_fontmap
import mc.mc_chat_hist
import mc.mc_tablist
import mc.mc_tablist_ui
import mc.mc_chat_ui

fn main() -> i32 {
    if mc_fontmap.fontmap_glyph(0xE4 as u32) != 132 as u32 { return 1 }
    if mc_fontmap.fontmap_glyph(0xDF as u32) != 225 as u32 { return 2 }
    if mc_fontmap.fontmap_glyph(0x4E2D as u32) != 63 as u32 { return 3 }
    var cp: u32 = 0 as u32
    if mc_fontmap.fontmap_decode("\u{e4}".p as u64, 2, 0, &cp) != 2 || cp != 0xE4 as u32 { return 4 }
    var h: mc_chat_hist.ChatHist = mc_chat_hist.hist_new()
    mc_chat_hist.hist_push(&h, "one".p as u64, 3)
    mc_chat_hist.hist_push(&h, "two".p as u64, 3)
    var out: rt.Buf = rt.buf_new()
    if !mc_chat_hist.hist_step(&h, "draft".p as u64, 5, 0 - 1, &out) || rt.buf_len(&out) != 3 || rt.ld8(rt.buf_ptr(&out), 1) != 119 as u8 { return 5 }
    if !mc_chat_hist.hist_step(&h, "x".p as u64, 1, 0 - 1, &out) || rt.ld8(rt.buf_ptr(&out), 0) != 111 as u8 { return 6 }
    if mc_chat_hist.hist_step(&h, "x".p as u64, 1, 0 - 1, &out) { return 7 }
    if !mc_chat_hist.hist_step(&h, "x".p as u64, 1, 1, &out) || rt.ld8(rt.buf_ptr(&out), 1) != 119 as u8 { return 8 }
    if !mc_chat_hist.hist_step(&h, "x".p as u64, 1, 1, &out) || rt.buf_len(&out) != 5 { return 9 }
    if mc_chat_hist.hist_step(&h, "x".p as u64, 1, 1, &out) { return 10 }
    let lay: mc_tablist_ui.TabLayout = mc_tablist_ui.tablist_layout(45, 60, false, 400)
    if lay.cols != 3 || lay.rows != 15 { return 11 }
    let one: mc_tablist_ui.TabLayout = mc_tablist_ui.tablist_layout(5, 60, false, 400)
    if one.cols != 1 || one.rows != 5 { return 12 }
    if mc_tablist.tab_ping_level(0 - 1) < 0 || mc_tablist.tab_ping_level(20) != 0 || mc_tablist.tab_ping_level(200) <= mc_tablist.tab_ping_level(20) { return 13 }
    if mc_chat_ui.chat_ui_fade(0 as u32, false) != 255 || mc_chat_ui.chat_ui_fade(200 as u32, false) != 0 || mc_chat_ui.chat_ui_fade(500 as u32, true) != 255 { return 14 }
    return 0
}
