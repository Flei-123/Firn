// expect_exit: 0
// tests/6710_webfw_units.fi -- webfw router matching, percent coding, HTML escaping, templates, static path rules.
import std.rt
import std.vec
import std.testkit
import webfw.wf_text
import webfw.wf_router
import webfw.wf_static
import webfw.wf_tpl
import webfw.wf_mime

fn matches(pattern: str, path: str, want: bool, k0: str, v0: str) {
    var keys: Vec[str] = vec_new[str]()
    var vals: Vec[str] = vec_new[str]()
    let got: bool = wf_router.match_path(pattern, path, &keys, &vals)
    testkit.check(got == want, "match " + pattern + " " + path)
    if want && k0.n > 0 {
        testkit.check(*vec_elem_ptr[str](&keys, 0) == k0, "key of " + pattern)
        testkit.check(*vec_elem_ptr[str](&vals, 0) == v0, "value of " + pattern + " " + path)
    }
}

fn main() -> i32 {
    matches("/", "/", true, "", "")
    matches("/a", "/a", true, "", "")
    matches("/a", "/a/", true, "", "")
    matches("/a", "/b", false, "", "")
    matches("/a/b", "/a", false, "", "")
    matches("/a", "/a/b", false, "", "")
    matches("/u/:id", "/u/7", true, "id", "7")
    matches("/u/:id", "/u/", false, "", "")
    matches("/u/:id", "/u/a%20b", true, "id", "a b")
    matches("/u/:id/x", "/u/7/x", true, "id", "7")
    matches("/f/*rest", "/f/a/b.txt", true, "rest", "a/b.txt")
    matches("/f/*rest", "/f", true, "rest", "")
    matches("/u/:id", "/u//", false, "", "")
    testkit.check(wf_router.join_path("/api", "/x") == "/api/x", "join")
    testkit.check(wf_router.join_path("/api", "/") == "/api", "join root")
    testkit.check(wf_router.join_path("", "/") == "/", "join empty")

    testkit.check(wf_text.url_decode("a%20b+c%2", true) == "a b c%2", "decode plus and short escape")
    testkit.check(wf_text.url_decode("a+b", false) == "a+b", "decode no plus")
    testkit.check(wf_text.url_decode("%zz%41", false) == "%zzA", "decode bad hex")
    testkit.check(wf_text.url_encode("a b/é~") == "a%20b%2f%c3%a9~", "encode")
    testkit.check(wf_text.url_decode(wf_text.url_encode("x y&z=é\n"), false) == "x y&z=é\n", "roundtrip")

    var found: str = ""
    testkit.check(wf_text.pair_find("a=1&b=x%26y&c", "b", 38 as u8, true, &found) && found == "x&y", "pair value")
    testkit.check(wf_text.pair_find("a=1&b=2&c", "c", 38 as u8, true, &found) && found == "", "pair without value")
    testkit.check(!wf_text.pair_find("a=1", "z", 38 as u8, true, &found), "pair missing")
    testkit.check(wf_text.pair_find("x=1; y=two", "y", 59 as u8, false, &found) && found == "two", "cookie style")

    var b: rt.Buf = rt.buf_new()
    wf_text.html_escape("<a href=\"x\">'&'</a>", &b)
    testkit.check(rt.buf_str(&b) == "&lt;a href=&quot;x&quot;&gt;&#39;&amp;&#39;&lt;/a&gt;", "escape")
    rt.buf_free(&b)

    testkit.check(wf_static.safe_rel("a/b/c.txt"), "safe plain")
    testkit.check(!wf_static.safe_rel("../x"), "unsafe dotdot start")
    testkit.check(!wf_static.safe_rel("a/../x"), "unsafe dotdot middle")
    testkit.check(wf_static.safe_rel("a..b/c"), "dots inside a name are fine")
    testkit.check(!wf_static.safe_rel("a\\b"), "unsafe backslash")
    testkit.check(wf_mime.mime_for("a/b.HTML") == "text/html; charset=utf-8", "mime html")
    testkit.check(wf_mime.mime_for("noext") == "application/octet-stream", "mime default")
    testkit.check(wf_mime.compressible("text/css") && !wf_mime.compressible("image/png"), "compressible")

    var d: Dict[str] = wf_tpl.tpl_new()
    wf_tpl.tpl_set(&d, "n", "<&>")
    wf_tpl.tpl_set(&d, "yes", "1")
    wf_tpl.tpl_set(&d, "no", "false")
    wf_tpl.tpl_list_push(&d, "l", "a")
    wf_tpl.tpl_list_push(&d, "l", "b<")
    testkit.check(wf_tpl.render_str("[{{n}}|{{{n}}}|{{ n }}|{{missing}}]", &d) == "[&lt;&amp;&gt;|<&>|&lt;&amp;&gt;|]", "vars")
    testkit.check(wf_tpl.render_str("{{#if yes}}A{{else}}B{{/if}}{{#if no}}A{{else}}B{{/if}}{{#if none}}A{{/if}}.", &d) == "AB.", "if else")
    testkit.check(wf_tpl.render_str("{{#unless no}}U{{/unless}}{{#unless yes}}V{{/unless}}", &d) == "U", "unless")
    testkit.check(wf_tpl.render_str("{{#each l}}<{{.}}>{{/each}}{{#each nothing}}x{{/each}}", &d) == "<a><b&lt;>", "each")
    testkit.check(wf_tpl.render_str("{{#each l}}{{#if yes}}{{.}}{{/if}},{{/each}}", &d) == "a,b&lt;,", "nested")
    testkit.check(wf_tpl.render_str("a{{#if yes}}oops", &d) == "a", "unclosed block ends output")
    testkit.check(wf_tpl.render_str("plain {{", &d) == "plain ", "dangling open")
    return testkit.finish()
}
