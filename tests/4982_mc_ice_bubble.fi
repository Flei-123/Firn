// expect_exit: 0
// tests/4982_mc_ice_bubble.fi -- ice momentum (friction 0.98: acceleration scaled by (0.6 / 0.98)^3, drag 0.98 * 0.91) and bubble columns
// (vanilla Entity.onInsideBubbleColumn / onAboveBubbleCol: up +0.06 max 0.7 / above +0.1 max 1.8, drag -0.03 min -0.3 / -0.9).
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_input
import mc.mc_math
import mc.mc_move_fluid
import mc.mc_slide

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000000001
}

fn near2(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0005
}

fn put(ids: u64, x: i32, ly: i32, z: i32, id: u16) {
    rt.st16(ids, ((ly * 16 + z) * 16 + x) as usize, id)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

fn publish(w: *mut mc_world.World, ids: u64) {
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

fn fill(ids: u64, x0: i32, x1: i32, ly0: i32, ly1: i32, z0: i32, z1: i32, id: u16) {
    var ly: i32 = ly0
    while ly <= ly1 {
        var z: i32 = z0
        while z <= z1 {
            var x: i32 = x0
            while x <= x1 {
                put(ids, x, ly, z, id)
                x = x + 1
            }
            z = z + 1
        }
        ly = ly + 1
    }
}

fn tick(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32) {
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = keys
    mc_input.player_tick(p, &ev, w, tb, 0 - 64)
}

fn walk(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) {
    var t: i32 = 0
    while t < ticks {
        tick(p, w, tb, keys)
        t = t + 1
    }
}

const STONE: u16 = 1 as u16
const ICE: u16 = 5 as u16
const BUB_UP: u16 = 6 as u16
const BUB_DOWN: u16 = 7 as u16
const WATER: u16 = 2 as u16

fn base_ids() -> u64 {
    let ids: u64 = new_ids()
    fill(ids, 0, 15, 0, 2, 0, 15, STONE)
    return ids
}

fn new_player(x: f64, y: f64, z: f64) -> mc_input.Player {
    var p: mc_input.Player = mc_input.player_new(x, y, z)
    rt.st8(p.mv, ICE as usize, mc_slide.MV_ICE as u8)
    rt.st8(p.mv, WATER as usize, mc_move_fluid.fluid_kind(false, 8) as u8)
    rt.st8(p.mv, BUB_UP as usize, (mc_move_fluid.fluid_kind(false, 8) + mc_move_fluid.MV_BUBBLE) as u8)
    rt.st8(p.mv, BUB_DOWN as usize, (mc_move_fluid.fluid_kind(false, 8) + mc_move_fluid.MV_BUBBLE + mc_move_fluid.MV_FALLING) as u8)
    return p
}

fn main() -> i32 {
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(8), solid: rt.heap_alloc(16), n: 8 }
    var i: usize = 0
    while i < 8 {
        rt.st8(tb.pick, i, 1 as u8)
        rt.st16(tb.solid, i, 0 as u16)
        i = i + 1
    }
    rt.st16(tb.solid, STONE as usize, 1 as u16)
    rt.st16(tb.solid, ICE as usize, 1 as u16)

    var ids: u64 = base_ids()
    fill(ids, 0, 15, 2, 2, 8, 15, ICE)
    var w: mc_world.World = mc_world.world_new()
    publish(&w, ids)

    var a: mc_input.Player = new_player(8.5, 0.0 - 60.9, 8.5)
    walk(&a, &w, &tb, 0 as u32, 5)
    check(a.on_ground, 1)
    var z0: f64 = a.z
    walk(&a, &w, &tb, mc_input.K_FORWARD, 1)
    check(a.z - z0 > 0.0215 && a.z - z0 < 0.0235, 2)
    walk(&a, &w, &tb, mc_input.K_FORWARD, 3)
    check(a.slide, 3)
    z0 = a.z
    walk(&a, &w, &tb, 0 as u32, 60)
    check(a.z - z0 > 0.4, 4)
    check(a.z < 14.9, 5)

    var b: mc_input.Player = new_player(8.5, 0.0 - 60.9, 2.0)
    walk(&b, &w, &tb, 0 as u32, 5)
    walk(&b, &w, &tb, mc_input.K_FORWARD, 15)
    z0 = b.z
    walk(&b, &w, &tb, 0 as u32, 40)
    check(b.z - z0 < 0.3, 6)
    check(!b.slide, 7)

    var c: mc_input.Player = new_player(8.5, 0.0 - 60.9, 8.5)
    walk(&c, &w, &tb, 0 as u32, 5)
    walk(&c, &w, &tb, mc_input.K_FORWARD, 2)
    walk(&c, &w, &tb, mc_input.K_FORWARD | mc_input.K_JUMP, 1)
    var air_v: f64 = c.vx * c.vx + c.vz * c.vz
    check(c.vz > 0.01 || air_v > 0.0001, 8)
    mc_world.world_free(&w)

    var ids2: u64 = base_ids()
    fill(ids2, 8, 8, 3, 12, 8, 8, BUB_UP)
    fill(ids2, 4, 4, 3, 12, 4, 4, BUB_DOWN)
    fill(ids2, 12, 12, 3, 12, 12, 12, WATER)
    var w2: mc_world.World = mc_world.world_new()
    publish(&w2, ids2)
    var up: mc_input.Player = new_player(8.5, 0.0 - 60.0, 8.5)
    var maxy: f64 = up.y
    var t: i32 = 0
    while t < 80 {
        walk(&up, &w2, &tb, 0 as u32, 1)
        if up.y > maxy { maxy = up.y }
        t = t + 1
    }
    check(maxy > 0.0 - 50.0, 9)

    var dn: mc_input.Player = new_player(4.5, 0.0 - 53.0, 4.5)
    var miny_vy: f64 = 0.0
    t = 0
    while t < 60 {
        walk(&dn, &w2, &tb, 0 as u32, 1)
        if dn.vy < miny_vy { miny_vy = dn.vy }
        t = t + 1
    }
    check(dn.y < 0.0 - 60.5, 10)
    check(miny_vy > 0.0 - 0.6, 11)

    var pl: mc_input.Player = new_player(12.5, 0.0 - 60.0, 12.5)
    maxy = pl.y
    t = 0
    while t < 60 {
        walk(&pl, &w2, &tb, 0 as u32, 1)
        if pl.y > maxy { maxy = pl.y }
        t = t + 1
    }
    check(maxy < 0.0 - 58.0, 12)
    mc_world.world_free(&w2)
    if g_fail != 0 { return 1 }
    return 0
}
