// expect_exit: 42
// tests/5481_fui_cursorreq.fi -- lib/fui/cursorreq.fi: the cursor shape wanted for a frame.
import fui.cursorreq

fn main() -> i32 {
    cursorreq.begin()
    if cursorreq.wanted() != cursorreq.SHAPE_ARROW {
        return 1
    }
    cursorreq.request(2 as u32)
    if cursorreq.wanted() != 2 as u32 {
        return 2
    }
    cursorreq.begin()
    if cursorreq.wanted() != cursorreq.SHAPE_ARROW {
        return 3
    }
    return 42
}
