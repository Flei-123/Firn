// expect_exit: 0
import std.rt
import std.env
import mc.mc_slot_hint
import mc.mc_item_src
import mc.mc_raster
import mc.mc_cont_ui

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn painted(r: *mut mc_raster.Raster, x0: i32, y0: i32, w: i32, h: i32) -> i32 {
    var n: i32 = 0
    var y: i32 = y0
    while y < y0 + h {
        var x: i32 = x0
        while x < x0 + w {
            if rt.ld32((*r).color, (y as usize) * ((*r).w as usize) + (x as usize)) != 0xFF000000 as u32 { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn round(protocol: i32, sprites: bool) {
    var src: mc_item_src.ItemSrc = mc_item_src.isrc_new()
    check(mc_item_src.isrc_open(&src, protocol), 1)
    var h: mc_slot_hint.SlotHint = mc_slot_hint.shint_new()
    check(mc_slot_hint.shint_open(&h, &src), 2)
    check(mc_slot_hint.shint_has(&h, mc_slot_hint.SH_HELMET), 3)
    check(mc_slot_hint.shint_has(&h, mc_slot_hint.SH_SHIELD), 4)
    check(mc_slot_hint.shint_has(&h, mc_slot_hint.SH_LAPIS), 5)
    check(mc_slot_hint.shint_has(&h, mc_slot_hint.shint_cycle(mc_slot_hint.CYCLE_BASE, 0 as u64)), 6)
    check(mc_slot_hint.shint_has(&h, mc_slot_hint.shint_cycle(mc_slot_hint.CYCLE_ADDITION, 4500 as u64)), 7)
    check(mc_slot_hint.shint_has(&h, mc_slot_hint.shint_cycle(mc_slot_hint.CYCLE_TEMPLATE, 1500 as u64)), 8)
    check(mc_slot_hint.shint_has(&h, mc_slot_hint.SH_FUEL) == sprites, 9)
    check(mc_slot_hint.shint_has(&h, mc_slot_hint.SH_BANNER) == sprites, 10)
    check(mc_slot_hint.shint_cycle(mc_slot_hint.CYCLE_BASE, 0 as u64) != mc_slot_hint.shint_cycle(mc_slot_hint.CYCLE_BASE, 1500 as u64), 11)
    check(mc_slot_hint.shint_armor(5) == mc_slot_hint.SH_HELMET && mc_slot_hint.shint_armor(8) == mc_slot_hint.SH_BOOTS && mc_slot_hint.shint_armor(45) == mc_slot_hint.SH_SHIELD, 12)
    check(mc_slot_hint.shint_armor(9) < 0 && mc_slot_hint.shint_armor(0) < 0 && mc_slot_hint.shint_armor(4) < 0, 13)
    var r: mc_raster.Raster = mc_raster.raster_new(64, 32)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_slot_hint.shint_draw(&r, &h, mc_slot_hint.SH_CHESTPLATE, 0, 0, 1)
    check(painted(&r, 0, 0, 16, 16) > 20, 14)
    check(painted(&r, 16, 0, 48, 32) == 0, 15)
    mc_slot_hint.shint_draw(&r, &h, mc_slot_hint.SH_CHESTPLATE, 32, 0, 2)
    check(painted(&r, 32, 0, 32, 32) > 80, 16)

    var u: mc_cont_ui.ContUi = mc_cont_ui.cui_new()
    check(mc_cont_ui.cui_open(&u, &src), 17)
    var view: mc_cont_ui.ContView = mc_cont_ui.cview_new()
    var rr: mc_raster.Raster = mc_raster.raster_new(176 * 2, 166 * 2)
    mc_raster.raster_clear(&rr, 0xFF000000 as u32)
    mc_cont_ui.cui_draw_extras(&rr, &u, mc_cont_ui.KIND_ENCHANT, 2, 0, 0, 2, &view)
    let empty: i32 = painted(&rr, 35 * 2, 47 * 2, 32, 32)
    view.lapis = 3
    mc_raster.raster_clear(&rr, 0xFF000000 as u32)
    mc_cont_ui.cui_draw_extras(&rr, &u, mc_cont_ui.KIND_ENCHANT, 2, 0, 0, 2, &view)
    check(empty > painted(&rr, 35 * 2, 47 * 2, 32, 32), 18)
    mc_raster.raster_clear(&rr, 0xFF000000 as u32)
    mc_cont_ui.cui_draw_extras(&rr, &u, mc_cont_ui.KIND_SMITHING, 4, 0, 0, 2, &view)
    check(painted(&rr, 8 * 2, 48 * 2, 32, 32) > 0 && painted(&rr, 26 * 2, 48 * 2, 32, 32) > 0 && painted(&rr, 44 * 2, 48 * 2, 32, 32) > 0, 19)
    view.present[1] = true
    mc_raster.raster_clear(&rr, 0xFF000000 as u32)
    mc_cont_ui.cui_draw_extras(&rr, &u, mc_cont_ui.KIND_SMITHING, 4, 0, 0, 2, &view)
    check(painted(&rr, 26 * 2, 48 * 2, 32, 32) == 0, 20)
    mc_cont_ui.cview_free(&view)
    mc_cont_ui.cui_free(&u)
    mc_slot_hint.shint_free(&h)
    mc_item_src.isrc_free(&src)
}

fn main() -> i32 {
    if !env.has("MC_VANILLA_JAR") { return 0 }
    let sprites: bool = env.has("HINT_SPRITES")
    var p: i32 = 763
    if sprites { p = 769 }
    round(p, sprites)
    return 0
}
