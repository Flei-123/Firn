// expect_exit: 0
import std.rt
import std.str
import std.fs
import std.process
import std.env
import std.shell
import std.time
import appkit.util
import services.svc
import services.svcfile
import services.svcclip
import services.svcstore

const APP: str = "firn-svc-6705"

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn scratch_home() -> str {
    var b: rt.Buf = rt.buf_new()
    util.buf_push_str(&b, shell.temp_dir())
    rt.buf_push(&b, env.DIR_SEP)
    util.buf_push_str(&b, "firn_svc_6705_")
    rt.buf_push_dec_u64(&b, time.monotonic_ns() / 1000 as u64)
    let s: str = util.buf_to_str_copy(&b)
    rt.buf_free(&b)
    return s
}

fn run_isolated(me: str) -> i32 {
    let home: str = scratch_home()
    fs.remove_tree(home) catch false
    fs.mkdir_all(home) catch false
    var cmd: process.Command = process.command(me)
    process.add_arg(&cmd, "--isolated")
    process.set_env(&cmd, "APPKIT_HOME", home)
    process.unset_env(&cmd, "DISPLAY")
    process.unset_env(&cmd, "WAYLAND_DISPLAY")
    let rc: i32 = process.run(&cmd) catch 99
    process.command_free(&cmd)
    fs.remove_tree(home) catch false
    return rc
}

fn stored(key: str, want: str) -> bool {
    var out: rt.Buf = rt.buf_new()
    let ok: bool = svcstore.get(key, &out) == svc.OK && rt.buf_str(&out) == want
    rt.buf_free(&out)
    return ok
}

fn check_storage() -> i32 {
    if svcstore.set("greeting", "h\u{e9}llo") != svc.OK { return 10 }
    if !stored("greeting", "h\u{e9}llo") { return 11 }
    var path: rt.Buf = rt.buf_new()
    util.buf_push_str(&path, env.get("APPKIT_HOME"))
    util.buf_push_str(&path, "/data/" + APP + "/services/greeting")
    let inside: bool = fs.is_file(rt.buf_str(&path))
    rt.buf_free(&path)
    if !inside { return 12 }
    if svcstore.remove("greeting") != svc.OK || svcstore.has("greeting") { return 13 }
    if svcstore.set("../x", "v") != svc.INVALID { return 14 }
    return 0
}

fn check_headless() -> i32 {
    if svc.backend_name() != "native" { return 20 }
    if svc.caps() != (svc.CAP_STORAGE | svc.CAP_DIR_LIST | svc.CAP_DIR_MUTATE) { return 21 }
    var id: u32 = 7 as u32
    if svcfile.open("", false, &id) != svc.NO_BACKEND || id != 0 as u32 { return 22 }
    if svcclip.copy_text("x") != svc.NO_BACKEND { return 23 }
    if svcclip.paste_text(&id) != svc.NO_BACKEND { return 24 }
    return 0
}

fn same_reply(r: *mut svc.Reply, id: u32, name: str, data: str) -> bool {
    return (*r).id == id && (*r).index == id + 1 as u32 && rt.buf_str(&(*r).name) == name
    && rt.buf_str(&(*r).data) == data
}

fn check_queue() -> i32 {
    svc.push_reply(1 as u32, svc.OP_FILE_ITEM, svc.OK, 2 as u32, "a", "xyz".p as u64, 3)
    svc.push_reply(2 as u32, svc.OP_FILE_ITEM, svc.FAILED, 3 as u32, "abcde", 0, 0)
    svc.push_reply(3 as u32, svc.OP_CLIP_TEXT, svc.OK, 4 as u32, "text/plain", "hello".p as u64, 5)
    if svc.pending() != 3 { return 30 }
    var r: svc.Reply = svc.reply_new()
    if !svc.poll(&r) || !same_reply(&r, 1 as u32, "a", "xyz") || r.status != svc.OK { return 31 }
    if !svc.poll(&r) || !same_reply(&r, 2 as u32, "abcde", "") || r.status != svc.FAILED { return 32 }
    if !svc.poll(&r) || !same_reply(&r, 3 as u32, "text/plain", "hello") { return 33 }
    if svc.poll(&r) || svc.pending() != 0 { return 34 }
    svc.reply_free(&r)
    return 0
}

fn isolated_main() -> i32 {
    if svc.set_app(".hidden") != svc.INVALID || svc.set_app(APP) != svc.OK { return 2 }
    let s: i32 = check_storage()
    if s != 0 { return s }
    let h: i32 = check_headless()
    if h != 0 { return h }
    return check_queue()
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) >= 2 && arg(start, 1) == "--isolated" {
        return isolated_main()
    }
    return run_isolated(arg(start, 0))
}
