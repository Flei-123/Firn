// expect_exit: 0
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_input
import mc.mc_math
import mc.mc_move_fluid
import mc.mc_fluid_flow

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000000001
}

fn near2(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0005
}

fn put(ids: u64, x: i32, ly: i32, z: i32, id: u16) {
    rt.st16(ids, ((ly * 16 + z) * 16 + x) as usize, id)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

fn publish(w: *mut mc_world.World, ids: u64) {
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

fn fill(ids: u64, x0: i32, x1: i32, ly0: i32, ly1: i32, z0: i32, z1: i32, id: u16) {
    var ly: i32 = ly0
    while ly <= ly1 {
        var z: i32 = z0
        while z <= z1 {
            var x: i32 = x0
            while x <= x1 {
                put(ids, x, ly, z, id)
                x = x + 1
            }
            z = z + 1
        }
        ly = ly + 1
    }
}

fn tick(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32) {
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = keys
    mc_input.player_tick(p, &ev, w, tb, 0 - 64)
}

fn walk(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) {
    var t: i32 = 0
    while t < ticks {
        tick(p, w, tb, keys)
        t = t + 1
    }
}

const STONE: u16 = 1 as u16
const WATER_SRC: u16 = 2 as u16
const LAVA_SRC: u16 = 3 as u16
const FALLING: u16 = 4 as u16
const WATER_BASE: u16 = 10 as u16
const LAVA_BASE: u16 = 30 as u16

fn near_eps(a: f64, b: f64, eps: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < eps
}

fn new_player(x: f64, y: f64, z: f64) -> mc_input.Player {
    var p: mc_input.Player = mc_input.player_new(x, y, z)
    rt.st8(p.mv, WATER_SRC as usize, mc_move_fluid.fluid_kind(false, 8) as u8)
    rt.st8(p.mv, LAVA_SRC as usize, mc_move_fluid.fluid_kind(true, 8) as u8)
    rt.st8(p.mv, FALLING as usize, mc_move_fluid.fluid_kind_falling(false, 8) as u8)
    var a: i32 = 1
    while a <= 7 {
        rt.st8(p.mv, (WATER_BASE as usize) + (a as usize), mc_move_fluid.fluid_kind(false, a) as u8)
        rt.st8(p.mv, (LAVA_BASE as usize) + (a as usize), mc_move_fluid.fluid_kind(true, a) as u8)
        a = a + 1
    }
    return p
}

fn main() -> i32 {
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(64), solid: rt.heap_alloc(128), n: 64 }
    var i: usize = 0
    while i < 64 {
        rt.st8(tb.pick, i, 1 as u8)
        rt.st16(tb.solid, i, 0 as u16)
        i = i + 1
    }
    rt.st16(tb.solid, STONE as usize, 1 as u16)

    var ids: u64 = new_ids()
    fill(ids, 0, 15, 0, 2, 0, 15, STONE)
    put(ids, 4, 3, 8, WATER_SRC)
    var a: i32 = 7
    var x: i32 = 5
    while x <= 9 {
        put(ids, x, 3, 8, WATER_BASE + (a as u16))
        a = a - 1
        x = x + 1
    }
    put(ids, 10, 3, 8, WATER_BASE + (1 as u16))
    put(ids, 4, 3, 12, LAVA_SRC)
    put(ids, 5, 3, 12, LAVA_BASE + (6 as u16))
    put(ids, 6, 3, 12, LAVA_BASE + (4 as u16))
    put(ids, 7, 3, 12, LAVA_BASE + (2 as u16))
    fill(ids, 2, 2, 3, 8, 2, 2, FALLING)
    fill(ids, 3, 3, 3, 8, 2, 2, STONE)
    fill(ids, 6, 6, 3, 8, 2, 2, FALLING)
    var w: mc_world.World = mc_world.world_new()
    publish(&w, ids)

    var c: mc_input.Player = new_player(7.5, 0.0 - 61.0, 8.5)
    tick(&c, &w, &tb, 0 as u32)
    check(near_eps(c.x - 7.5, 0.014, 0.000001), 1)
    check(near_eps(c.z - 8.5, 0.0, 0.000001), 2)
    check(near_eps(c.vx, 0.0112, 0.000001), 3)

    var sh: mc_input.Player = new_player(10.5, 0.0 - 61.0, 8.5)
    sh.vx = 0.01
    tick(&sh, &w, &tb, 0 as u32)
    check(near_eps(sh.x - 10.5, 0.011541, 0.00002), 4)
    check(near_eps(sh.z - 8.5, 0.0, 0.000001), 5)

    var lv: mc_input.Player = new_player(5.5, 0.0 - 61.0, 12.5)
    tick(&lv, &w, &tb, 0 as u32)
    check(near_eps(lv.x - 5.5, 0.0045, 0.000001), 6)
    check(near_eps(lv.z - 12.5, 0.0, 0.000001), 7)

    var fw: mc_input.Player = new_player(2.5, 0.0 - 58.0, 2.5)
    tick(&fw, &w, &tb, 0 as u32)
    check(near_eps(fw.vy, 0.0 - 0.0162, 0.0003), 8)
    check(near_eps(fw.x - 2.5, 0.0, 0.000001), 9)

    var fo: mc_input.Player = new_player(6.5, 0.0 - 58.0, 2.5)
    tick(&fo, &w, &tb, 0 as u32)
    check(near_eps(fo.vy, 0.0 - 0.005, 0.0003), 10)

    var q: mc_input.Player = new_player(4.5, 0.0 - 61.0, 8.5)
    tick(&q, &w, &tb, 0 as u32)
    check(near_eps(q.x - 4.5, 0.014, 0.000001), 11)

    if g_fail != 0 { return 1 }
    return 0
}
