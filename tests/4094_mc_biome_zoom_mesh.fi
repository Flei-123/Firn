// expect_exit: 0
// tests/4094_mc_biome_zoom_mesh.fi -- r252 the mesher colour of a column follows vanilla BiomeManager.getBiome (Voronoi zoom, seed from ms_set_seed) and the swamp
// grass noise; the cell range the zoom reads stays inside the one cell ring of the biome grid (all 16^3 blocks of a section, negative origin).
import std.rt
import std.core
import std.math
import std.io
import zip.zip
import pack.icons
import mc.mc_assets
import mc.mc_texture
import mc.mc_texext
import mc.mc_mesh
import mc.mc_model
import mc.mc_model_mesh
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_chunk
import mc.mc_biome_zoom

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"

// 16 x 16 solid colour PNG
fn png_solid(r: u8, g: u8, b: u8, a: u8, out: *mut rt.Buf) -> bool {
    let px: u64 = rt.heap_alloc(16 * 16 * 4)
    var i: usize = 0
    while i < 256 {
        rt.st8(px, i * 4, r)
        rt.st8(px, i * 4 + 1, g)
        rt.st8(px, i * 4 + 2, b)
        rt.st8(px, i * 4 + 3, a)
        i = i + 1
    }
    let ok: bool = icons.png_encode(px, 16, 16, out)
    rt.heap_free(px, 16 * 16 * 4)
    return ok
}

fn add_text(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    var ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

fn add_png(w: *mut zip.ZipWriter, name: str, r: u8, g: u8, b: u8, a: u8) -> bool {
    var p: rt.Buf = rt.buf_new()
    if !png_solid(r, g, b, a, &p) { return false }
    var ok: bool = zip.zip_add(w, name, rt.buf_ptr(&p), rt.buf_len(&p), true) catch | e | (false)
    rt.buf_free(&p)
    return ok
}

// blockstate of a block without properties: one model for every state
fn add_state(w: *mut zip.ZipWriter, block: str, model: str) -> bool {
    return add_text(w, "assets/minecraft/blockstates/" + block + ".json", "{\"variants\":{\"\":{\"model\":\"" + model + "\"}}}")
}

// a model with ONE up face covering the whole top of the cell (flat on the cell face: AO applies), texture `tex`, optional tintindex 0
fn add_up_model(w: *mut zip.ZipWriter, name: str, tex: str, tinted: bool) -> bool {
    var tn: str = ""
    if tinted { tn = ",\"tintindex\":0" }
    return add_text(w, "assets/minecraft/models/block/" + name + ".json",
        "{\"textures\":{\"t\":\"block/" + tex + "\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"up\":{\"uv\":[0,0,16,16],\"texture\":\"#t\"" + tn + "}}}]}")
}

fn open_pack(b: *mut rt.Buf, w: *mut zip.ZipWriter, st: *mut mc_assets.PackStack) -> bool {
    var n: usize = zip.zip_finish(w) catch | e | (0)
    zip.zip_writer_free(w)
    if n == 0 { return false }
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&pk, rt.buf_ptr(b), rt.buf_len(b)) != mc_assets.ASSET_OK { return false }
    rt.buf_free(b)
    return mc_assets.stack_push(st, &pk) == mc_assets.ASSET_OK
}

fn sid(reg: *mut mc_registry.Registry, name: str) -> i32 {
    let blk: i32 = mc_registry.reg_block_by_name(reg, name.p as u64, name.length())
    if blk < 0 { return 0 - 1 }
    return mc_registry.reg_block_min_state(reg, blk)
}

// cell (x, y, z) of section 0 (a 16 x 16 x 16 u16 array per section, 2 sections)
fn put(ids: u64, x: i32, y: i32, z: i32, state: i32) {
    rt.st16(ids, ((y * 16 + z) * 16 + x) as usize, state as u16)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

fn chan(c: u32, k: i32) -> i32 {
    return ((c >> ((k * 8) as u32)) & (255 as u32)) as i32
}

fn iabs(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

// everything a scene needs, rebuilt per scene
struct Scene {
    tb: mc_mesh.MeshTables,
    ex: mc_texext.TexExt,
    atlas: mc_texture.Atlas,
    an: mc_assets.AnimSet,
}

fn scene_init(sc: *mut Scene, reg: *mut mc_registry.Registry, st: *mut mc_assets.PackStack) -> bool {
    (*sc).tb = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&(*sc).tb)
    (*sc).ex = mc_texext.texext_new()
    mc_texext.tex_build_tables_ext(reg, &(*sc).tb, &(*sc).ex)
    (*sc).atlas = mc_texext.texext_atlas_new(16, &(*sc).ex)
    (*sc).an = mc_assets.animset_new()
    return mc_assets.assets_apply_ext(st, &(*sc).atlas, &(*sc).ex, &(*sc).an) >= 1
}

fn biome_id(reg: *mut mc_registry.Registry, name: str) -> i32 {
    var i: i32 = 0
    while i < mc_registry.reg_biome_count(reg) {
        var nl: usize = 0
        let np: u64 = mc_registry.reg_biome_name(reg, i, &nl)
        var off: usize = 0
        if nl > 10 && rt.mem_eq(np, "minecraft:".p as u64, 10) { off = 10 }
        if nl - off == name.length() && rt.mem_eq(np + (off as u64), name.p as u64, nl - off) { return mc_registry.reg_biome_id(reg, i) }
        i = i + 1
    }
    return 0 - 1
}

// tint word of quad k of the buffer, unpacked to 0xRRGGBB (the mesher stores R | G << 8 | B << 16)
fn tint_of(buf: *mut rt.Buf, k: usize) -> u32 {
    let v: u32 = math.math_f64(rt.ld64(rt.buf_ptr(buf), k * 30 + 24)) as u32
    return ((v & (255 as u32)) << (16 as u32)) | (v & (65280 as u32)) | ((v >> (16 as u32)) & (255 as u32))
}

// the quad of cell (x, y, z): find it by its x0 (x + 0.0)
fn quad_at(buf: *mut rt.Buf, nq: usize, x: i32) -> usize {
    var k: usize = 0
    while k < nq {
        let qx: f64 = math.math_f64(rt.ld64(rt.buf_ptr(buf), k * 30))
        if qx > (x as f64) - 0.5 && qx < (x as f64) + 0.5 { return k }
        k = k + 1
    }
    return 999
}

fn avg3(a: u32, b: u32, c: u32, na: u32, nb: u32, nc: u32) -> u32 {
    let n: u32 = na + nb + nc
    var out: u32 = 0 as u32
    var k: i32 = 2
    while k >= 0 {
        let s: u32 = na * ((a >> ((k * 8) as u32)) & (255 as u32)) + nb * ((b >> ((k * 8) as u32)) & (255 as u32)) + nc * ((c >> ((k * 8) as u32)) & (255 as u32))
        out = (out << (8 as u32)) | ((s / n) & (255 as u32))
        k = k - 1
    }
    return out
}

fn new_sec(biome: u16) -> u64 {
    let sec: u64 = rt.heap_alloc(mc_chunk.section_size())
    let p: *mut mc_chunk.Section = sec as *mut mc_chunk.Section
    (*p).count = 0
    (*p).blocks = mc_chunk.Container { bits: 0 as u32, pal_n: 0 as u32, pal: 0, data: 0, words: 0 }
    let pal: u64 = rt.heap_alloc(2)
    rt.st16(pal, 0, biome)
    (*p).biomes = mc_chunk.Container { bits: 0 as u32, pal_n: 1 as u32, pal: pal, data: 0, words: 0 }
    return sec
}

fn fill_grid(bio: u64, id: i32) {
    var i: usize = 0
    while i < 216 {
        rt.st16(bio, i, id as u16)
        i = i + 1
    }
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 1 }
    var reg: mc_registry.Registry = v.registry_of()
    if !mc_registry.registry_ok(&reg) { return 2 }
    var stk: mc_assets.PackStack = mc_assets.stack_new()
    {
        var b: rt.Buf = rt.buf_new()
        var w: zip.ZipWriter = zip.zip_writer_new(&b)
        if !add_text(&w, "pack.mcmeta", META) { return 3 }
        if !add_png(&w, "assets/minecraft/textures/block/oak_planks.png", 240 as u8, 240 as u8, 240 as u8, 255 as u8) { return 3 }
        if !add_up_model(&w, "ms_t", "oak_planks", true) { return 3 }
        if !add_state(&w, "stone", "block/ms_t") { return 3 }
        if !open_pack(&b, &w, &stk) { return 3 }
    }
    var ex0: mc_texext.TexExt = mc_texext.texext_new()
    var sc: Scene = Scene { tb: mc_mesh.MeshTables { opaque: 0, tiles: 0 }, ex: mc_texext.texext_new(), atlas: mc_texext.texext_atlas_new(16, &ex0), an: mc_assets.animset_new() }
    if !scene_init(&sc, &reg, &stk) { return 4 }
    var ms: mc_model_mesh.ModelSet = mc_model_mesh.ms_new(&reg, &stk, &sc.ex)
    let s_stone: i32 = sid(&reg, "stone")
    if s_stone < 0 { return 5 }
    let b_plains: i32 = biome_id(&reg, "plains")
    let b_jungle: i32 = biome_id(&reg, "jungle")
    let b_desert: i32 = biome_id(&reg, "desert")
    if b_plains < 0 || b_jungle < 0 || b_desert < 0 { return 6 }
    mc_model_mesh.ms_load_biomes(&ms)
    let P: u32 = 0x91BD59 as u32
    let D: u32 = 0xBFB755 as u32
    let b_swamp: i32 = biome_id(&reg, "swamp")
    if b_swamp < 0 { return 7 }
    let hs: i64 = 293737985876514017
    let bio: u64 = rt.heap_alloc(mc_model_mesh.BIO_BYTES)
    mc_model_mesh.ms_set_blend(&ms, 0)

    // grid: plains / desert in a checker of the cell coordinates (x, y, z = -1..4)
    var gy: i32 = 0 - 1
    while gy < 5 {
        var gz: i32 = 0 - 1
        while gz < 5 {
            var gx: i32 = 0 - 1
            while gx < 5 {
                var id: i32 = b_plains
                if iabs(gx * 7 + gy * 13 + gz * 3) % 2 == 1 { id = b_desert }
                rt.st16(bio, (((gy + 1) * 6 + gz + 1) * 6 + gx + 1) as usize, id as u16)
                gx = gx + 1
            }
            gz = gz + 1
        }
        gy = gy + 1
    }
    // without a seed: the plain 4x4x4 cell of the block
    if mc_model_mesh.ms_zoom_on(&ms) { return 10 }
    var lx: i32 = 0
    while lx < 16 {
        var y: i32 = 0
        while y < 16 {
            var z: i32 = 0
            while z < 16 {
                let cid: i32 = rt.ld16(bio, (((y / 4 + 1) * 6 + z / 4 + 1) * 6 + lx / 4 + 1) as usize) as i32
                var want: u32 = P
                if cid == b_desert { want = D }
                if mc_model_mesh.ms_blend_color_w(&ms, bio, 0, lx, y, z, 0 - 16, 0 - 64, 32) != want { return 11 }
                z = z + 3
            }
            y = y + 3
        }
        lx = lx + 3
    }
    // with the seed: every block takes the cell of BiomeManager.getBiome (bz_pick, checked against the real class by test 4092)
    mc_model_mesh.ms_set_seed(&ms, hs)
    if !mc_model_mesh.ms_zoom_on(&ms) { return 12 }
    var moved: i32 = 0
    lx = 0
    while lx < 16 {
        var y: i32 = 0
        while y < 16 {
            var z: i32 = 0
            while z < 16 {
                let q: mc_biome_zoom.BzQuart = mc_biome_zoom.bz_pick(hs as u64, 0 - 16 + lx, 0 - 64 + y, 32 + z)
                let rx: i32 = q.x - ((0 - 16) >> 2)
                let ry: i32 = q.y - ((0 - 64) >> 2)
                let rz: i32 = q.z - (32 >> 2)
                if rx < 0 - 1 || rx > 4 || ry < 0 - 1 || ry > 4 || rz < 0 - 1 || rz > 4 { return 13 }
                let cid: i32 = rt.ld16(bio, (((ry + 1) * 6 + rz + 1) * 6 + rx + 1) as usize) as i32
                var want: u32 = P
                if cid == b_desert { want = D }
                if mc_model_mesh.ms_blend_color_w(&ms, bio, 0, lx, y, z, 0 - 16, 0 - 64, 32) != want { return 14 }
                let hid: i32 = rt.ld16(bio, (((y / 4 + 1) * 6 + z / 4 + 1) * 6 + lx / 4 + 1) as usize) as i32
                if hid != cid { moved = moved + 1 }
                z = z + 1
            }
            y = y + 1
        }
        lx = lx + 1
    }
    // the zoom really moves the borders: a good part of the 4096 blocks sit in a different cell than the hard 4x4x4 grid says
    if moved < 500 { return 15 }

    // swamp: uniform swamp grid, colour of the column from the noise (values taken from the real class, test 4093)
    var i: usize = 0
    while i < 216 {
        rt.st16(bio, i, b_swamp as u16)
        i = i + 1
    }
    let SA: u32 = 0x4C763C as u32
    let SB: u32 = 0x6A7039 as u32
    if mc_model_mesh.ms_blend_color_w(&ms, bio, 0, 4, 3, 4, 0 - 304, 0, 0 - 304) != SA { return 20 } // column (-300, -300)
    if mc_model_mesh.ms_blend_color_w(&ms, bio, 0, 0, 3, 0, 64, 0, 64) != SA { return 21 } // (64, 64)
    if mc_model_mesh.ms_blend_color_w(&ms, bio, 0, 4, 3, 4, 496, 0, 496) != SB { return 22 } // (500, 500)
    if mc_model_mesh.ms_blend_color_w(&ms, bio, 0, 15, 3, 15, 0 - 16, 0, 0 - 16) != SB { return 23 } // (-1, -1)
    // foliage / water of a swamp keep the table colour
    if mc_model_mesh.ms_blend_color_w(&ms, bio, 1, 4, 3, 4, 0 - 304, 0, 0 - 304) != (0x6A7039 as u32) { return 24 }
    if mc_model_mesh.ms_blend_color_w(&ms, bio, 2, 4, 3, 4, 0 - 304, 0, 0 - 304) != (0x617B64 as u32) { return 25 }
    // blend radius 2: per channel integer mean of the 25 column colours
    mc_model_mesh.ms_set_blend(&ms, 2)
    var sn: mc_biome_zoom.SwampNoise = mc_biome_zoom.swamp_new()
    var sr: u32 = 0 as u32
    var sg: u32 = 0 as u32
    var sb: u32 = 0 as u32
    var dz: i32 = 0 - 2
    while dz <= 2 {
        var dx: i32 = 0 - 2
        while dx <= 2 {
            let c: u32 = mc_biome_zoom.swamp_grass(&sn, 0 - 300 + dx, 0 - 300 + dz)
            sr = sr + ((c >> (16 as u32)) & (255 as u32))
            sg = sg + ((c >> (8 as u32)) & (255 as u32))
            sb = sb + (c & (255 as u32))
            dx = dx + 1
        }
        dz = dz + 1
    }
    let want_avg: u32 = ((sr / (25 as u32)) << (16 as u32)) | ((sg / (25 as u32)) << (8 as u32)) | (sb / (25 as u32))
    if mc_model_mesh.ms_blend_color_w(&ms, bio, 0, 4, 3, 4, 0 - 304, 0, 0 - 304) != want_avg { return 26 }
    // ms_reset keeps the seed
    mc_model_mesh.ms_reset(&ms)
    if !mc_model_mesh.ms_zoom_on(&ms) { return 27 }
    mc_model_mesh.ms_clear_seed(&ms)
    if mc_model_mesh.ms_zoom_on(&ms) { return 28 }
    rt.heap_free(bio, mc_model_mesh.BIO_BYTES)
    mc_model_mesh.ms_free(&ms)
    return 0
}
