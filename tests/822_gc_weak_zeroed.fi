// expect_exit: 0
// RUNDE 47 — SCHWACHE FELDER WERDEN BEIM EINSAMMELN WIRKLICH GENULLT
// (SPEC 3.5.3 `S3`).
//
// Bis Runde 46 war das nur SCHEINBAR so: `stark(w)` lieferte 0, weil die
// Seriennummer nicht mehr passte — im Feld stand aber weiterhin das alte,
// verschleierte Bitmuster. Dieser Test sieht sich das ROHWORT des Feldes an
// und verlangt, dass es nach dem Sammellauf 0 ist.
//
// Geprueft wird ausserdem, was der Sammler NICHT kann und was deshalb
// ehrlich dokumentiert ist: ein `GcWeak[T]` in einer LOKALEN Veraenderlichen
// wird nicht angefasst (kein praeziser Stapel) — dort liefert `stark()`
// weiterhin 0, aber das Rohwort bleibt stehen.

gc class Target {
    chain: Gc[Target],
    value: u64,
}

gc class Observer {
    view: GcWeak[Target],
    count: u64,
}

// Rohwort eines schwachen Feldes im Heap (verschleierter Zeiger, 0 = leer).
fn raw(b: Gc[Observer]) -> u64 {
    return *(((&b.view) as u64) as *mut u64)
}

// Legt ein Ziel an, haengt es SCHWACH in den Beobachter und laesst den
// starken Verweis mit diesem Rahmen sterben. Rekursiv, damit der Einbetter
// die Funktion nicht in den Aufrufer zieht.
fn join(b: Gc[Observer], depth: u64) -> AllocError!bool {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    if depth > 0 {
        return try join(b, depth - 1)
    }
    let t: Gc[Target] = try gc Target{ chain: gc_null[Target](), value: 77 }
    b.view = weak(t)
    if strong(b.view) == gc_null[Target]() {
        return false
    }
    if strong(b.view).value != 77 {
        return false
    }
    return true
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}

fn run() -> AllocError!i32 {
    let b: Gc[Observer] = try gc Observer{ view: weak_null[Target](), count: 0 }
    if raw(b) != 0 {
        return 1
    }
    if !(try join(b, 2)) {
        return 2
    }
    // Vor dem Sammeln steht ein echtes (verschleiertes) Bitmuster im Feld.
    if raw(b) == 0 {
        return 3
    }
    let before: u64 = gc_weak_zeroed()

    gc_collect()

    // NACH dem Sammeln ist das Feld wirklich leer — nicht nur "wirkt leer".
    if raw(b) != 0 {
        return 4
    }
    if strong(b.view) != gc_null[Target]() {
        return 5
    }
    if gc_weak_zeroed() != before + 1 {
        return 6
    }
    // Der Beobachter selbst hat ueberlebt.
    if b.count != 0 {
        return 7
    }

    // --- zweiter Durchgang: es bleibt beim Nullen, nichts zaehlt doppelt ---
    if !(try join(b, 2)) {
        return 8
    }
    gc_collect()
    if raw(b) != 0 {
        return 9
    }
    if gc_weak_zeroed() != before + 2 {
        return 10
    }
    gc_collect()
    if gc_weak_zeroed() != before + 2 {
        return 11
    }

    // --- ein LEBENDES Ziel wird nicht genullt -------------------------------
    let lives: Gc[Target] = try gc Target{ chain: gc_null[Target](), value: 5 }
    b.view = weak(lives)
    gc_collect()
    if raw(b) == 0 {
        return 12
    }
    if strong(b.view) == gc_null[Target]() {
        return 13
    }
    if strong(b.view).value != 5 {
        return 14
    }
    if gc_weak_zeroed() != before + 2 {
        return 15
    }
    return 0
}
