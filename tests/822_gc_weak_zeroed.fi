// expect_exit: 0
// ROUND 47 -- WEAK FIELDS ARE REALLY CLEARED WHEN COLLECTED
// (SPEC 3.5.3 `S3`).
//
// Up to round 46 that was only APPARENTLY so: `strong(w)` yielded 0 because
// the serial number no longer matched -- but the old, obfuscated bit pattern
// was still standing in the field. This test looks at the RAW WORD of the
// field and demands that it is 0 after the collection.
//
// What the collector CANNOT do is checked as well, and it is documented
// honestly: a `GcWeak[T]` in a LOCAL mutable is not touched (there is no
// precise stack) -- there `strong()` still yields 0, but the raw word
// stays as it is.

gc class Target {
    chain: Gc[Target],
    value: u64,
}

gc class Observer {
    view: GcWeak[Target],
    count: u64,
}

// Raw word of a weak field on the heap (obfuscated pointer, 0 = empty).
fn raw(b: Gc[Observer]) -> u64 {
    return *(((&b.view) as u64) as *mut u64)
}

// Creates a target, hangs it WEAKLY into the observer and lets the strong
// reference die with this frame. Recursive, so that the inliner does not
// pull the function into the caller.
fn join(b: Gc[Observer], depth: u64) -> AllocError!bool {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    if depth > 0 {
        return try join(b, depth - 1)
    }
    let t: Gc[Target] = try gc Target { chain: gc_null[Target](), value: 77 }
    b.view = weak(t)
    if strong(b.view) == gc_null[Target]() {
        return false
    }
    if strong(b.view).value != 77 {
        return false
    }
    return true
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}

fn run() -> AllocError!i32 {
    let b: Gc[Observer] = try gc Observer { view: weak_null[Target](), count: 0 }
    if raw(b) != 0 {
        return 1
    }
    if !(try join(b, 2)) {
        return 2
    }
    // Before the collection a real (obfuscated) bit pattern stands in the field.
    if raw(b) == 0 {
        return 3
    }
    let before: u64 = gc_weak_zeroed()

    gc_collect()

    // AFTER the collection the field is really empty -- not just "looks empty".
    if raw(b) != 0 {
        return 4
    }
    if strong(b.view) != gc_null[Target]() {
        return 5
    }
    if gc_weak_zeroed() != before + 1 {
        return 6
    }
    // The observer itself survived.
    if b.count != 0 {
        return 7
    }

    // --- second pass: the clearing stays, nothing counts twice --------------
    if !(try join(b, 2)) {
        return 8
    }
    gc_collect()
    if raw(b) != 0 {
        return 9
    }
    if gc_weak_zeroed() != before + 2 {
        return 10
    }
    gc_collect()
    if gc_weak_zeroed() != before + 2 {
        return 11
    }

    // --- a LIVE target is not cleared ---------------------------------------
    let lives: Gc[Target] = try gc Target { chain: gc_null[Target](), value: 5 }
    b.view = weak(lives)
    gc_collect()
    if raw(b) == 0 {
        return 12
    }
    if strong(b.view) == gc_null[Target]() {
        return 13
    }
    if strong(b.view).value != 5 {
        return 14
    }
    if gc_weak_zeroed() != before + 2 {
        return 15
    }
    return 0
}
