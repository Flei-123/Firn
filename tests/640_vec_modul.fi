// expect_exit: 0
// `Vec[T]` AUS EINER BIBLIOTHEK — der Nachweis, dass alle drei Blocker aus
// docs/SELBSTHOSTING.md §7 gefallen sind:
//
//   B1  eine generische Vorlage aus einem Modul ist hier benutzbar
//   B2  `lib/rt/vec.fi` ruft `rt.heap_alloc` — eine Funktion aus einem
//       ANDEREN Modul — aus dem Rumpf einer generischen Vorlage
//   B3  `lib/rt/vec.fi` bindet `rt` aus seinem EIGENEN Verzeichnis ein
//
// Damit ist zum ersten Mal eine echte generische Sammlung als Bibliothek
// schreibbar — die Voraussetzung fuer `lib/std/` und damit fuer Stufe 1.
import modules.vec

fn main() -> i32 {
    // --- i32 ueber viele Verdopplungen
    var v: Vec[i32] = vec_neu[i32]()
    defer vec_frei[i32](&v)
    var i: i32 = 0
    while i < 1000 {
        if !vec_push[i32](&v, i * 7) {
            return 1
        }
        i = i + 1
    }
    if vec_len[i32](&v) != 1000 {
        return 2
    }
    if vec_at[i32](&v, 0) != 0 {
        return 3
    }
    if vec_at[i32](&v, 999) != 6993 {
        return 4
    }
    if vec_at[i32](&v, 99999) != 0 {
        return 5
    }

    // --- pop und letztes
    if vec_letztes[i32](&v) != 6993 {
        return 6
    }
    if vec_pop[i32](&v) != 6993 {
        return 7
    }
    if vec_len[i32](&v) != 999 {
        return 8
    }

    // --- setzen
    if !vec_setzen[i32](&v, 0, 4242) {
        return 9
    }
    if vec_at[i32](&v, 0) != 4242 {
        return 10
    }
    if vec_setzen[i32](&v, 99999, 1) {
        return 11
    }

    // --- andere Elementgroesse: eigene Auspraegung
    var b: Vec[u8] = vec_neu[u8]()
    defer vec_frei[u8](&b)
    var k: usize = 0
    while k < 300 {
        if !vec_push[u8](&b, (k % 251) as u8) {
            return 12
        }
        k = k + 1
    }
    if vec_len[u8](&b) != 300 {
        return 13
    }
    if vec_at[u8](&b, 299) != ((299 as u64) % 251) as u8 {
        return 14
    }

    // --- u64: die Skalierung muss stimmen
    var w: Vec[u64] = vec_neu[u64]()
    defer vec_frei[u64](&w)
    var j: u64 = 0
    while j < 100 {
        if !vec_push[u64](&w, j * 1000000007) {
            return 15
        }
        j = j + 1
    }
    if vec_at[u64](&w, 99) != 99 * 1000000007 {
        return 16
    }
    return 0
}
