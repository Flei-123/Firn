// expect_exit: 0
import std.rt
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_creative
import mc.mc_creative_rules

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn has(cr: *mut mc_creative.Creative, r: *mut mc_registry.Registry, name: str, tab: i32) -> bool {
    let id: i32 = mc_registry.reg_item_by_name(r, name.p as u64, name.n)
    if id < 0 { return false }
    return mc_creative.cr_in_tab(cr, id, tab)
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 1)
    var r: mc_registry.Registry = v.registry_of()
    var cr: mc_creative.Creative = mc_creative.cr_new()
    check(mc_creative.cr_build(&cr, &r), 2)
    check(has(&cr, &r, "oak_planks", mc_creative_rules.TAB_BUILDING), 3)
    check(!has(&cr, &r, "oak_planks", mc_creative_rules.TAB_NATURAL), 4)
    check(has(&cr, &r, "white_wool", mc_creative_rules.TAB_COLORED), 5)
    check(!has(&cr, &r, "white_wool", mc_creative_rules.TAB_BUILDING), 6)
    check(has(&cr, &r, "light_blue_concrete", mc_creative_rules.TAB_COLORED), 7)
    check(has(&cr, &r, "white_dye", mc_creative_rules.TAB_INGREDIENTS), 8)
    check(!has(&cr, &r, "white_dye", mc_creative_rules.TAB_COLORED), 9)
    check(has(&cr, &r, "oak_log", mc_creative_rules.TAB_NATURAL), 10)
    check(has(&cr, &r, "diamond_ore", mc_creative_rules.TAB_NATURAL), 11)
    check(has(&cr, &r, "furnace", mc_creative_rules.TAB_FUNCTIONAL), 12)
    check(has(&cr, &r, "repeater", mc_creative_rules.TAB_REDSTONE), 13)
    check(has(&cr, &r, "stone_button", mc_creative_rules.TAB_REDSTONE), 14)
    check(has(&cr, &r, "oak_door", mc_creative_rules.TAB_REDSTONE), 15)
    check(has(&cr, &r, "oak_door", mc_creative_rules.TAB_BUILDING), 16)
    check(has(&cr, &r, "iron_pickaxe", mc_creative_rules.TAB_TOOLS), 17)
    check(has(&cr, &r, "iron_axe", mc_creative_rules.TAB_TOOLS), 18)
    check(has(&cr, &r, "iron_axe", mc_creative_rules.TAB_COMBAT), 19)
    check(!has(&cr, &r, "iron_pickaxe", mc_creative_rules.TAB_COMBAT), 20)
    check(has(&cr, &r, "diamond_sword", mc_creative_rules.TAB_COMBAT), 21)
    check(has(&cr, &r, "golden_apple", mc_creative_rules.TAB_FOOD), 22)
    check(has(&cr, &r, "cooked_beef", mc_creative_rules.TAB_FOOD), 23)
    check(has(&cr, &r, "iron_ingot", mc_creative_rules.TAB_INGREDIENTS), 24)
    check(has(&cr, &r, "creeper_spawn_egg", mc_creative_rules.TAB_SPAWN), 25)
    check(!has(&cr, &r, "creeper_spawn_egg", mc_creative_rules.TAB_INGREDIENTS), 26)
    check(!has(&cr, &r, "command_block", mc_creative_rules.TAB_BUILDING), 27)
    check(!has(&cr, &r, "bedrock", mc_creative_rules.TAB_NATURAL), 28)
    check(has(&cr, &r, "stone", mc_creative_rules.TAB_NATURAL) && has(&cr, &r, "stone", mc_creative_rules.TAB_BUILDING), 29)

    mc_creative.cr_select(&cr, &r, mc_creative_rules.TAB_BUILDING)
    check(mc_creative.cr_count(&cr) > 200, 30)
    check(mc_creative.cr_rows(&cr) > 20 && mc_creative.cr_max_scroll(&cr) == mc_creative.cr_rows(&cr) - 5, 31)
    let first: i32 = mc_creative.cr_item(&cr, 0)
    check(first >= 0, 32)
    mc_creative.cr_scroll_rows(&cr, 3)
    check(mc_creative.cr_scroll(&cr) == 3, 33)
    check(mc_creative.cr_item(&cr, 0) != first, 34)
    mc_creative.cr_scroll_rows(&cr, 100000)
    check(mc_creative.cr_scroll(&cr) == mc_creative.cr_max_scroll(&cr), 35)
    mc_creative.cr_scroll_rows(&cr, 0 - 100000)
    check(mc_creative.cr_scroll(&cr) == 0, 36)
    mc_creative.cr_set_scroll_from_px(&cr, 1000, 112, 15)
    check(mc_creative.cr_scroll(&cr) == mc_creative.cr_max_scroll(&cr), 37)
    mc_creative.cr_set_scroll_from_px(&cr, 0, 112, 15)
    check(mc_creative.cr_scroll(&cr) == 0, 38)

    mc_creative.cr_select(&cr, &r, mc_creative_rules.TAB_SEARCH)
    check(mc_creative.cr_count(&cr) > 1000, 40)
    check(mc_creative.cr_query_push(&cr, &r, 105 as u32), 41)
    check(mc_creative.cr_query_push(&cr, &r, 114 as u32), 42)
    check(mc_creative.cr_query_push(&cr, &r, 111 as u32), 43)
    check(mc_creative.cr_query_push(&cr, &r, 110 as u32), 44)
    check(mc_creative.cr_query_push(&cr, &r, 32 as u32), 45)
    check(mc_creative.cr_query_push(&cr, &r, 112 as u32), 46)
    let n1: i32 = mc_creative.cr_count(&cr)
    check(n1 >= 1 && n1 < 20, 47)
    let pick: str = "iron_pickaxe"
    var found: bool = false
    var k: i32 = 0
    while k < n1 && k < 45 {
        if mc_creative.cr_item(&cr, k) == mc_registry.reg_item_by_name(&r, pick.p as u64, pick.n) { found = true }
        k = k + 1
    }
    check(found, 48)
    mc_creative.cr_query_clear(&cr, &r)
    check(mc_creative.cr_count(&cr) > 1000, 49)
    mc_creative.cr_select(&cr, &r, mc_creative_rules.TAB_BUILDING)
    check(!mc_creative.cr_query_push(&cr, &r, 97 as u32), 50)

    var total: i32 = 0
    var t: i32 = 0
    while t < mc_creative_rules.TAB_COUNT {
        if t != mc_creative_rules.TAB_SEARCH && t != mc_creative_rules.TAB_INVENTORY {
            mc_creative.cr_select(&cr, &r, t)
            check(mc_creative.cr_count(&cr) > 5, 60 + t)
            total = total + mc_creative.cr_count(&cr)
        }
        t = t + 1
    }
    check(total > 1000, 80)
    mc_creative.cr_free(&cr)
    return 0
}
