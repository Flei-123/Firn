// expect_exit: 0
// mc_inv 1.21.5+ hashed stacks: a stack received with data components is clicked; the Click Container packet carries the CRC32C hash of
// every component we can hash (damage, custom_name, unbreakable, enchantments, rarity, glint) and the removed component ids, and the generated
// packet schema (HashedSlot) accepts the body. Return codes: 1xx = setup, 2xx = packet shape, 3xx = hashes, 4xx = unsupported / plain stacks.
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_schema
import mc.mc_hash
import mc.mc_inv

fn put_stack(b: *mut bytes.Bytes, item: i32, comps: i32) {
    bytes.put_varint(b, 1)
    bytes.put_varint(b, item)
    if comps == 0 { bytes.put_varint(b, 0); bytes.put_varint(b, 0); return }
    bytes.put_varint(b, 6) // added
    bytes.put_varint(b, 1) // removed
    bytes.put_varint(b, 3); bytes.put_varint(b, 7) // damage 7
    bytes.put_varint(b, 5); bytes.put_u8(b, 8 as u8); bytes.put_u16(b, 2 as u16); bytes.put_u8(b, 72 as u8); bytes.put_u8(b, 105 as u8) // custom_name "Hi"
    bytes.put_varint(b, 4) // unbreakable
    bytes.put_varint(b, 10); bytes.put_varint(b, 2); bytes.put_varint(b, 3); bytes.put_varint(b, 5); bytes.put_varint(b, 9); bytes.put_varint(b, 1) // enchantments 3:5, 9:1
    bytes.put_varint(b, 9); bytes.put_varint(b, 2) // rarity rare
    bytes.put_varint(b, 18); bytes.put_bool(b, true) // glint override
    bytes.put_varint(b, 2) // removed: max_damage
}

fn hash_of(h: *mut mc_hash.HStack, t: i32) -> i64 {
    var i: i32 = 0
    while i < (*h).n_add {
        if (*h).add_t[i as usize] == t { return (bytes.bits_u32((*h).add_h[i as usize]) as i64) }
        i = i + 1
    }
    return 0 - 1
}

fn str_h(t: str) -> u32 { return mc_hash.hash_string(t.p as u64, t.n) }

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    let keys: u64 = rt.heap_alloc(64 * 4)
    var q: usize = 0
    while q < 64 { rt.st32(keys, q, str_h("minecraft:unknown")); q = q + 1 }
    rt.st32(keys, 3, str_h("minecraft:sharpness"))
    rt.st32(keys, 9, str_h("minecraft:efficiency"))
    mc_inv.inv_set_enchant_keys(&v, keys, 64)
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, 0) // window
    bytes.put_varint(&b, 5) // state
    bytes.put_varint(&b, 46)
    var i: i32 = 0
    while i < 46 {
        if i == 36 { put_stack(&b, 20, 1) } else if i == 37 { put_stack(&b, 21, 0) } else { bytes.put_varint(&b, 0) }
        i = i + 1
    }
    bytes.put_varint(&b, 0)
    bytes.bytes_set_pos(&b, 0)
    if !mc_inv.inv_on_window_items_v(&v, &ver, &b) { return 101 }
    if v.bad != 0 as u32 { return 102 }
    if mc_inv.inv_sig(&v, 36) == 0 { return 103 }
    // pick the stack up
    var cb: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(&v, p, 36, 0, 0, &cb) { return 200 }
    // the generated schema accepts the body
    let id: i32 = mc_version.version_pid(&ver, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK)
    let sch: u64 = ver.schema_of(mc_version.ST_PLAY, mc_version.DIR_C2S, id)
    if id < 0 || sch == 0 as u64 { return 201 }
    var out: rt.Buf = rt.buf_new()
    bytes.bytes_set_pos(&cb, 0)
    if !mc_schema.walk_values(sch, &cb, &out) { return 202 }
    rt.buf_free(&out)
    bytes.bytes_set_pos(&cb, 0)
    let w: i32 = bytes.get_varint(&cb) catch (0 - 1)
    let st: i32 = bytes.get_varint(&cb) catch (0 - 1)
    let sl: i16 = bytes.get_i16(&cb) catch (0 - 1 as i16)
    let bt: i8 = bytes.get_i8(&cb) catch (0 as i8)
    let md: i32 = bytes.get_varint(&cb) catch (0 - 1)
    if w != 0 || st != 5 || sl != 36 || bt != 0 as i8 || md != 0 { return 203 }
    let nc: i32 = bytes.get_varint(&cb) catch (0 - 1)
    if nc != 1 { return 204 }
    let cs: i16 = bytes.get_i16(&cb) catch (0 - 1 as i16)
    var h1: mc_hash.HStack = mc_hash.hstack_empty()
    if cs != 36 || !mc_hash.hstack_get(&cb, &h1) || h1.present { return 205 } // the slot is empty afterwards
    var h2: mc_hash.HStack = mc_hash.hstack_empty()
    if !mc_hash.hstack_get(&cb, &h2) || !h2.present || h2.item != 20 || h2.count != 1 { return 206 }
    if bytes.bytes_remaining(&cb) != 0 { return 207 }
    // hashes of the carried stack
    if h2.n_add != 6 { return 300 }
    if hash_of(&h2, 3) != (mc_hash.hash_int(7) as i64) { return 301 }
    if hash_of(&h2, 5) != (str_h("Hi") as i64) { return 302 }
    if hash_of(&h2, 4) != (mc_hash.hash_map(0, 0, 0) as i64) { return 303 }
    if hash_of(&h2, 9) != (str_h("rare") as i64) { return 304 }
    if hash_of(&h2, 18) != (mc_hash.hash_bool(true) as i64) { return 305 }
    let ek: u64 = rt.heap_alloc(16)
    let ev: u64 = rt.heap_alloc(16)
    rt.st32(ek, 0, str_h("minecraft:sharpness")); rt.st32(ev, 0, mc_hash.hash_int(5))
    rt.st32(ek, 1, str_h("minecraft:efficiency")); rt.st32(ev, 1, mc_hash.hash_int(1))
    let want_e: i64 = mc_hash.hash_map(ek, ev, 2) as i64
    rt.heap_free(ek, 16)
    rt.heap_free(ev, 16)
    if hash_of(&h2, 10) != want_e { return 306 }
    if h2.n_rem != 1 || h2.rem_t[0] != 2 { return 307 }
    // put it down again on the plain slot 37 (swap): slot 37 now holds the hashed stack, the carried stack is the plain one
    var cb2: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(&v, p, 37, 0, 0, &cb2) { return 400 }
    bytes.bytes_set_pos(&cb2, 0)
    let _a: i32 = bytes.get_varint(&cb2) catch 0
    let _b: i32 = bytes.get_varint(&cb2) catch 0
    let _c: i16 = bytes.get_i16(&cb2) catch (0 as i16)
    let _d: i8 = bytes.get_i8(&cb2) catch (0 as i8)
    let _e: i32 = bytes.get_varint(&cb2) catch 0
    if (bytes.get_varint(&cb2) catch (0 - 1)) != 1 { return 401 }
    let _f: i16 = bytes.get_i16(&cb2) catch (0 as i16)
    var h3: mc_hash.HStack = mc_hash.hstack_empty()
    if !mc_hash.hstack_get(&cb2, &h3) || h3.item != 20 || h3.n_add != 6 || h3.n_rem != 1 { return 402 }
    var h4: mc_hash.HStack = mc_hash.hstack_empty()
    if !mc_hash.hstack_get(&cb2, &h4) || h4.item != 21 || h4.n_add != 0 || h4.n_rem != 0 { return 403 }
    bytes.bytes_free(&cb2)
    bytes.bytes_free(&cb)
    bytes.bytes_free(&b)
    rt.heap_free(keys, 64 * 4)
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    let r1: i32 = check(770)
    if r1 != 0 { return r1 }
    let r2: i32 = check(772)
    if r2 != 0 { return r2 + 1000 }
    return 0
}
