// expect_exit: 0
// tests/4030_default_args_method_receiver2.fi -- r717: more receiver-type
// defaults: other default kinds, named arguments out of order, a pointer
// receiver, defaults inside arguments of another defaulted call.
const BASE: i32 = 40

struct Acc { n: i32 }
struct Scale { k: f64 }

impl Acc {
    fn add(*self, a: i32 = BASE, b: i32 = 2) -> i32 {
        (*self).n = (*self).n + a + b
        return (*self).n
    }
    fn flag(self, neg: bool = false, bias: i32 = 3 - 1) -> i32 {
        if neg {
            return 0 - self.n - bias
        }
        return self.n + bias
    }
}

impl Scale {
    fn add(*self, a: f64 = 1.5) -> f64 {
        (*self).k = (*self).k + a
        return (*self).k
    }
    fn flag(self, neg: bool = true, bias: f64 = 0.5) -> f64 {
        if neg {
            return 0.0 - self.k - bias
        }
        return self.k + bias
    }
}

fn fail(code: i32) -> i32 {
    return code
}

fn main() -> i32 {
    var a: Acc = Acc { n: 0 }
    var s: Scale = Scale { k: 0.0 }
    if a.add() != 42 { return fail(1) }
    if a.add(b: 8, a: 0) != 50 { return fail(2) }
    if a.add(a: 1) != 53 { return fail(3) }
    if s.add() != 1.5 { return fail(4) }
    if s.add(a: 0.5) != 2.0 { return fail(5) }
    if a.flag() != 55 { return fail(6) }
    if a.flag(neg: true) != 0 - 55 { return fail(7) }
    if a.flag(bias: 0, neg: true) != 0 - 53 { return fail(8) }
    if s.flag() != -2.5 { return fail(9) }
    if s.flag(neg: false, bias: 1.0) != 3.0 { return fail(10) }
    // a defaulted call as the argument of another one
    var t: Acc = Acc { n: 100 }
    if t.add(a: a.flag(), b: s.add(a: 1.0) as i32) != 100 + 55 + 3 { return fail(11) }
    return 0
}
