// expect_exit: 0
// ACCEPTANCE ITEM 6: compile-time code generation produces a Unicode table
// FROM THE UCD. `tests/data/upper_lower.txt` has the format of
// UnicodeData.txt (semicolon-separated fields, code point in field 0, the
// upper case mapping in field 12); the compiler reads it at compile time
// and produces the lookup function `ucd_big` from it.
//
// To see what comes out:  firnc --emit=comptime tests/602_comptime_ucd.fi
//
// SECURITY: `file_*` only reads relative to the root source file -- no
// absolute path, no `..` (DESIGN_GOALS 3, supply chain security).
// Negative tests: tests/neg/comptime_file_absolute.fi, comptime_file_parent.fi

fn is_line_end(c: i64) -> i64 {
    if c == 10 { return 1 }
    return 0
}

fn hex_digit(c: i64) -> i64 {
    if c >= 48 { if c <= 57 { return c - 48 } }
    if c >= 65 { if c <= 70 { return c - 55 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    return 0 - 1
}

comptime {
    let n: i64 = file_size("data/upper_lower.txt")
    emit_raw("fn ucd_big(c: i64) -> i64 {\n")
    var i: i64 = 0
    var lines: i64 = 0
    while i < n {
        // skip comment lines
        if file_byte("data/upper_lower.txt", i) == 35 {
            while i < n {
                if is_line_end(file_byte("data/upper_lower.txt", i)) == 1 { break }
                i = i + 1
            }
            i = i + 1
            continue
        }
        // field 0: code point in hex up to the ';'
        var cp: i64 = 0
        var digits: i64 = 0
        while i < n {
            let c: i64 = file_byte("data/upper_lower.txt", i)
            let d: i64 = hex_digit(c)
            if d < 0 { break }
            cp = cp * 16 + d
            digits = digits + 1
            i = i + 1
        }
        // spool forward to field 12
        var field: i64 = 0
        var line_end: i64 = 0
        while i < n {
            let c: i64 = file_byte("data/upper_lower.txt", i)
            if is_line_end(c) == 1 {
                line_end = 1
                break
            }
            if c == 59 { field = field + 1 }
            i = i + 1
            if field == 12 { break }
        }
        // field 12: the upper case mapping
        var gr: i64 = 0
        var grdigits: i64 = 0
        if line_end == 0 {
            while i < n {
                let c: i64 = file_byte("data/upper_lower.txt", i)
                let d: i64 = hex_digit(c)
                if d < 0 { break }
                gr = gr * 16 + d
                grdigits = grdigits + 1
                i = i + 1
            }
        }
        if digits > 0 {
            if grdigits > 0 {
                emit_raw("    if c == ")
                emit_number(cp)
                emit_raw(" { return ")
                emit_number(gr)
                emit_raw(" }\n")
                lines = lines + 1
            }
        }
        // rest of the line
        while i < n {
            if is_line_end(file_byte("data/upper_lower.txt", i)) == 1 { break }
            i = i + 1
        }
        i = i + 1
    }
    emit_raw("    return c\n}\n")
    emit_raw("const UCD_LINES: i64 = ")
    emit_number(lines)
    emit_raw("\n")
}

fn main() -> i32 {
    if ucd_big(97) != 65 { return 1 }
    if ucd_big(228) != 196 { return 2 }
    if ucd_big(255) != 376 { return 3 }
    if ucd_big(65) != 65 { return 4 }
    if UCD_LINES != 5 { return 5 }
    return 0
}
