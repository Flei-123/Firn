// expect_exit: 0
// ABNAHMEPUNKT 6: Kompilierzeit-Codegenerierung erzeugt eine Unicode-Tabelle
// AUS DER UCD. `tests/data/upper_lower.txt` hat das Format von
// UnicodeData.txt (semikolongetrennte Felder, Codepunkt in Feld 0, die
// Grossschreibung in Feld 12); der Compiler liest sie zur Uebersetzungszeit
// und erzeugt daraus die Nachschlagefunktion `ucd_gross`.
//
// Nachsehen, was dabei entsteht:  firnc --emit=comptime tests/602_comptime_ucd.fi
//
// SICHERHEIT: `datei_*` liest ausschliesslich relativ zur Wurzelquelldatei —
// kein absoluter Pfad, kein `..` (DESIGNZIELE §3, Lieferketten-Sicherheit).
// Negativtests: tests/neg/comptime_file_absolute.fi, comptime_file_parent.fi

fn is_line_end(c: i64) -> i64 {
    if c == 10 { return 1 }
    return 0
}

fn hex_digit(c: i64) -> i64 {
    if c >= 48 { if c <= 57 { return c - 48 } }
    if c >= 65 { if c <= 70 { return c - 55 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    return 0 - 1
}

comptime {
    let n: i64 = file_size("data/upper_lower.txt")
    emit_raw("fn ucd_big(c: i64) -> i64 {\n")
    var i: i64 = 0
    var lines: i64 = 0
    while i < n {
        // Kommentarzeilen ueberspringen
        if file_byte("data/upper_lower.txt", i) == 35 {
            while i < n {
                if is_line_end(file_byte("data/upper_lower.txt", i)) == 1 { break }
                i = i + 1
            }
            i = i + 1
            continue
        }
        // Feld 0: Codepunkt in hex bis zum ';'
        var cp: i64 = 0
        var digits: i64 = 0
        while i < n {
            let c: i64 = file_byte("data/upper_lower.txt", i)
            let d: i64 = hex_digit(c)
            if d < 0 { break }
            cp = cp * 16 + d
            digits = digits + 1
            i = i + 1
        }
        // bis Feld 12 vorspulen
        var field: i64 = 0
        var line_end: i64 = 0
        while i < n {
            let c: i64 = file_byte("data/upper_lower.txt", i)
            if is_line_end(c) == 1 {
                line_end = 1
                break
            }
            if c == 59 { field = field + 1 }
            i = i + 1
            if field == 12 { break }
        }
        // Feld 12: Grossschreibung
        var gr: i64 = 0
        var grdigits: i64 = 0
        if line_end == 0 {
            while i < n {
                let c: i64 = file_byte("data/upper_lower.txt", i)
                let d: i64 = hex_digit(c)
                if d < 0 { break }
                gr = gr * 16 + d
                grdigits = grdigits + 1
                i = i + 1
            }
        }
        if digits > 0 {
            if grdigits > 0 {
                emit_raw("    if c == ")
                emit_number(cp)
                emit_raw(" { return ")
                emit_number(gr)
                emit_raw(" }\n")
                lines = lines + 1
            }
        }
        // Rest der Zeile
        while i < n {
            if is_line_end(file_byte("data/upper_lower.txt", i)) == 1 { break }
            i = i + 1
        }
        i = i + 1
    }
    emit_raw("    return c\n}\n")
    emit_raw("const UCD_ZEILEN: i64 = ")
    emit_number(lines)
    emit_raw("\n")
}

fn main() -> i32 {
    if ucd_big(97) != 65 { return 1 }
    if ucd_big(228) != 196 { return 2 }
    if ucd_big(255) != 376 { return 3 }
    if ucd_big(65) != 65 { return 4 }
    if UCD_LINES != 5 { return 5 }
    return 0
}
