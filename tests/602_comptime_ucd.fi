// expect_exit: 0
// ABNAHMEPUNKT 6: Kompilierzeit-Codegenerierung erzeugt eine Unicode-Tabelle
// AUS DER UCD. `tests/daten/gross_klein.txt` hat das Format von
// UnicodeData.txt (semikolongetrennte Felder, Codepunkt in Feld 0, die
// Grossschreibung in Feld 12); der Compiler liest sie zur Uebersetzungszeit
// und erzeugt daraus die Nachschlagefunktion `ucd_gross`.
//
// Nachsehen, was dabei entsteht:  firnc --emit=comptime tests/602_comptime_ucd.fi
//
// SICHERHEIT: `datei_*` liest ausschliesslich relativ zur Wurzelquelldatei —
// kein absoluter Pfad, kein `..` (DESIGNZIELE §3, Lieferketten-Sicherheit).
// Negativtests: tests/neg/comptime_datei_absolut.fi, comptime_datei_eltern.fi

fn ist_zeilenende(c: i64) -> i64 {
    if c == 10 { return 1 }
    return 0
}

fn hex_ziffer(c: i64) -> i64 {
    if c >= 48 { if c <= 57 { return c - 48 } }
    if c >= 65 { if c <= 70 { return c - 55 } }
    if c >= 97 { if c <= 102 { return c - 87 } }
    return 0 - 1
}

comptime {
    let n: i64 = datei_groesse("daten/gross_klein.txt")
    emit_roh("fn ucd_gross(c: i64) -> i64 {\n")
    var i: i64 = 0
    var zeilen: i64 = 0
    while i < n {
        // Kommentarzeilen ueberspringen
        if datei_byte("daten/gross_klein.txt", i) == 35 {
            while i < n {
                if ist_zeilenende(datei_byte("daten/gross_klein.txt", i)) == 1 { break }
                i = i + 1
            }
            i = i + 1
            continue
        }
        // Feld 0: Codepunkt in hex bis zum ';'
        var cp: i64 = 0
        var stellen: i64 = 0
        while i < n {
            let c: i64 = datei_byte("daten/gross_klein.txt", i)
            let d: i64 = hex_ziffer(c)
            if d < 0 { break }
            cp = cp * 16 + d
            stellen = stellen + 1
            i = i + 1
        }
        // bis Feld 12 vorspulen
        var feld: i64 = 0
        var zeilenende: i64 = 0
        while i < n {
            let c: i64 = datei_byte("daten/gross_klein.txt", i)
            if ist_zeilenende(c) == 1 {
                zeilenende = 1
                break
            }
            if c == 59 { feld = feld + 1 }
            i = i + 1
            if feld == 12 { break }
        }
        // Feld 12: Grossschreibung
        var gr: i64 = 0
        var grstellen: i64 = 0
        if zeilenende == 0 {
            while i < n {
                let c: i64 = datei_byte("daten/gross_klein.txt", i)
                let d: i64 = hex_ziffer(c)
                if d < 0 { break }
                gr = gr * 16 + d
                grstellen = grstellen + 1
                i = i + 1
            }
        }
        if stellen > 0 {
            if grstellen > 0 {
                emit_roh("    if c == ")
                emit_zahl(cp)
                emit_roh(" { return ")
                emit_zahl(gr)
                emit_roh(" }\n")
                zeilen = zeilen + 1
            }
        }
        // Rest der Zeile
        while i < n {
            if ist_zeilenende(datei_byte("daten/gross_klein.txt", i)) == 1 { break }
            i = i + 1
        }
        i = i + 1
    }
    emit_roh("    return c\n}\n")
    emit_roh("const UCD_ZEILEN: i64 = ")
    emit_zahl(zeilen)
    emit_roh("\n")
}

fn main() -> i32 {
    if ucd_gross(97) != 65 { return 1 }
    if ucd_gross(228) != 196 { return 2 }
    if ucd_gross(255) != 376 { return 3 }
    if ucd_gross(65) != 65 { return 4 }
    if UCD_ZEILEN != 5 { return 5 }
    return 0
}
