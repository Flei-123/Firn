// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import rt.rt
import image.ccitt

fn main() -> i32 {
    var raw: [u8; 7] = [38 as u8, 172 as u8, 241 as u8, 70 as u8, 0 as u8, 32 as u8, 2 as u8]
    var out: rt.Buf = rt.buf_new()
    let rows: usize = ccitt.ccitt_decode((&raw[0]) as u64, 7, -1, 16, 2, false, false, true, &out)
    if rows != 2 || rt.buf_len(&out) != 4 {
        return 1
    }
    if rt.buf_at(&out, 0) != 240 as u8 || rt.buf_at(&out, 1) != 63 as u8 {
        return 2
    }
    if rt.buf_at(&out, 2) != 255 as u8 || rt.buf_at(&out, 3) != 255 as u8 {
        return 3
    }
    var inv: rt.Buf = rt.buf_new()
    ccitt.ccitt_decode((&raw[0]) as u64, 7, -1, 16, 2, false, false, false, &inv)
    if rt.buf_at(&inv, 0) != 15 as u8 || rt.buf_at(&inv, 3) != 0 as u8 {
        return 4
    }
    var junk: [u8; 4] = [255 as u8, 0 as u8, 0 as u8, 255 as u8]
    var j: rt.Buf = rt.buf_new()
    ccitt.ccitt_decode((&junk[0]) as u64, 4, 0, 32, 5, false, false, false, &j)
    if rt.buf_len(&j) != 20 {
        return 5
    }
    return 0
}
