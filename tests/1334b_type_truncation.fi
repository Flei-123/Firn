// expect_exit: 0
// only_mode: opt
// tests/1334b_type_truncation.fi -- split out of tests/1334_type_aliases.fi
// (round 72): the two promises this file proves --
//   * `int`/`long`/`short`/`byte` etc. are always exactly 32/64/16/8 bits
//     ("THE WIDTHS ARE FIXED", round 70, SPEC 13), proved by truncation,
//     not by `size_of`
//   * `--opt-level=release-fast` really wraps/truncates instead of
//     checking (SPEC section 13, `L9`, round 72)
// are BOTH only true, by construction, in the one build level that does
// not check `as` at all: every cast below deliberately narrows a value
// that does NOT fit, which round 72's checked dev/dev-fast/release-safe
// now correctly (and intentionally) panics on instead of truncating.
// `// only_mode: opt` (test.sh) runs this ONLY at `--opt-level=release-fast`
// -- the other two modes are exactly the two build levels this same
// program would legitimately panic in, proving nothing new about widths.

fn main() -> i32 {
    let w32: long = 4294967296
    if (w32 as int) != 0 { return 3 }
    if ((w32 - 1) as int) != -1 { return 4 }
    let w16: long = 65536
    if (w16 as short) != 0 as short { return 5 }
    if ((w16 - 1) as short) != -1 as short { return 6 }
    let w8: long = 256
    if (w8 as sbyte) != 0 as sbyte { return 7 }
    if (w8 as byte) != 0 as byte { return 8 }
    if ((w8 - 1) as byte) != 255 as byte { return 9 }
    if (w16 as ushort) != 0 as ushort { return 10 }
    if ((w16 - 1) as ushort) != 65535 as ushort { return 11 }
    if (w32 as uint) != 0 as uint { return 12 }
    // `int` truncates the very same way `i32` does
    if (w32 as int) != (w32 as i32) { return 14 }
    return 0
}
