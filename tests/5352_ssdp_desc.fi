// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import std.rt
import net.url
import ssdp.ssdp_desc

fn check_url(loc: str, d: *mut ssdp_desc.Desc, rel: str, want: str) -> i32 {
    var u: url.Url = url.url_new()
    if !ssdp_desc.desc_resolve(loc.p as u64, loc.n, d, rel.p as u64, rel.n, &u) {
        return 1
    }
    var b: rt.Buf = rt.buf_new()
    url.url_write(&u, &b)
    var bad: i32 = 0
    if b.len != want.n || !rt.mem_eq(b.ptr, want.p as u64, want.n) {
        bad = 1
    }
    rt.buf_free(&b)
    return bad
}

fn eq(a: str, b: str) -> bool {
    return a.n == b.n && rt.mem_eq(a.p as u64, b.p as u64, a.n)
}

fn main(start: u64) -> i32 {
    var fails: i32 = 0
    let text: str = "<?xml version=\"1.0\"?><root xmlns=\"urn:schemas-upnp-org:device-1-0\"><device><deviceType>urn:schemas-upnp-org:device:MediaServer:1</deviceType><friendlyName>Tom &amp; Jerry</friendlyName><manufacturer>Acme</manufacturer><modelName>M1</modelName><UDN>uuid:abc</UDN><serviceList><service><serviceType>urn:x:service:CD:1</serviceType><SCPDURL>/cd.xml</SCPDURL><controlURL>ctl/cd</controlURL><eventSubURL>http://o.h:81/ev</eventSubURL></service><service><serviceType>urn:x:service:CM:1</serviceType><SCPDURL>cm.xml</SCPDURL><controlURL>../ctl/cm</controlURL><eventSubURL>ev/cm</eventSubURL></service></serviceList></device></root>"
    var d: ssdp_desc.Desc = ssdp_desc.desc_new()
    if !ssdp_desc.desc_parse(text.p as u64, text.n, &d) {
        return 1
    }
    if !eq(ssdp_desc.desc_friendly(&d), "Tom & Jerry") || !eq(ssdp_desc.desc_manufacturer(&d), "Acme")
        || !eq(ssdp_desc.desc_model(&d), "M1") || !eq(ssdp_desc.desc_udn(&d), "uuid:abc")
        || !eq(ssdp_desc.desc_device_type(&d), "urn:schemas-upnp-org:device:MediaServer:1") {
        fails = fails + 1
    }
    if d.count != 2 || ssdp_desc.desc_service_find(&d, "urn:x:service:CM:1") != 1
        || ssdp_desc.desc_service_find(&d, "urn:x:none") != ssdp_desc.SERVICE_MAX {
        fails = fails + 1
    }
    let loc: str = "http://10.1.2.3:49152/upnp/dev/desc.xml"
    fails = fails + check_url(loc, &d, ssdp_desc.desc_service_control(&d, 0), "http://10.1.2.3:49152/upnp/dev/ctl/cd")
    fails = fails + check_url(loc, &d, ssdp_desc.desc_service_scpd(&d, 0), "http://10.1.2.3:49152/cd.xml")
    fails = fails + check_url(loc, &d, ssdp_desc.desc_service_events(&d, 0), "http://o.h:81/ev")
    fails = fails + check_url(loc, &d, ssdp_desc.desc_service_control(&d, 1), "http://10.1.2.3:49152/upnp/ctl/cm")
    var bad: ssdp_desc.Desc = ssdp_desc.desc_new()
    let broken: str = "<root><device></root>"
    if ssdp_desc.desc_parse(broken.p as u64, broken.n, &bad) {
        fails = fails + 1
    }
    let nodev: str = "<root><x/></root>"
    if ssdp_desc.desc_parse(nodev.p as u64, nodev.n, &bad) {
        fails = fails + 1
    }
    return fails
}
