// expect_out: ok
// ROUND FIRN-LUECKEN -- `const` carries floating point numbers.
//
// Until this round `compiler/src/sema.rs` said "'const' supports only
// integer and bool types in stage 0", and anyone who needed an `f64`
// constant had to write a FUNCTION -- `demos/choropleth/main.fi` had four
// of them for its map window, `lib/browser/sym.fi` in Certus has one and
// says why in a comment.
//
// What is checked here is the only thing that matters: the constant has to
// be the SAME NUMBER, bit for bit, as the value the program computes at
// run time. A constant folded in the compiler and an `addsd` on the
// machine may not disagree, and they do not, because the compiler folds in
// the same two formats with the same rounding.
import std.io

const LON0: f64 = -25.0
const SX: f64 = 22.0
const THIRD: f64 = 1.0 / 3.0
const MIX: f64 = LON0 + SX * 2.0
const NEG: f64 = -THIRD
const TENTH: f64 = 0.1
const SUM: f64 = TENTH + 0.2

const SMALL: f32 = 1.5f
const SMALL3: f32 = SMALL * 3.0f
const WIDE: f64 = SMALL

fn lon0() -> f64 {
    return 0.0 - 25.0
}

fn third() -> f64 {
    return 1.0 / 3.0
}

fn mix() -> f64 {
    return lon0() + 22.0 * 2.0
}

fn sum() -> f64 {
    return 0.1 + 0.2
}

fn bits(x: f64) -> u64 {
    var t: f64 = 0.0
    let p: u64 = (&t) as u64
    *(p as *mut f64) = x
    return *(p as *mut u64)
}

fn bits32(x: f32) -> u32 {
    var t: f32 = 0.0f
    let p: u64 = (&t) as u64
    *(p as *mut f32) = x
    return *(p as *mut u32)
}

fn main() -> i32 {
    if bits(LON0) != bits(lon0()) {
        io.print_line("LON0")
        return 1
    }
    if bits(THIRD) != bits(third()) {
        io.print_line("THIRD")
        return 2
    }
    if bits(MIX) != bits(mix()) {
        io.print_line("MIX")
        return 3
    }
    // 0.1 + 0.2 is the classic: the constant may not be "about" the same.
    if bits(SUM) != bits(sum()) {
        io.print_line("SUM")
        return 4
    }
    if bits(NEG) != bits(0.0 - third()) {
        io.print_line("NEG")
        return 5
    }
    if bits(SX) != bits(22.0) {
        io.print_line("SX")
        return 6
    }
    // f32 is computed as f32, not as a narrowed f64.
    if bits32(SMALL3) != bits32(4.5f) {
        io.print_line("SMALL3")
        return 7
    }
    // f32 -> f64 is exact and is the one implicit conversion of the
    // language (round 71).
    if bits(WIDE) != bits(1.5) {
        io.print_line("WIDE")
        return 8
    }
    // and a constant is a value like any other
    if LON0 * 2.0 != -50.0 {
        io.print_line("ARITH")
        return 9
    }
    io.print_line("ok")
    return 0
}
