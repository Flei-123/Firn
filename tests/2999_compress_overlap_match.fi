// expect_exit: 0
// tests/2999_compress_overlap_match.fi -- xz and Brotli matches whose distance is 8..31 and shorter than
// the length (overlapping forward copy). rt.mem_copy loads 32 octets before it stores, so the decoders
// must not use it for these (found by tools/compress/run.sh stage 81).
import compress.common
import compress.lzma
import compress.brotli
import std.rt
import std.io

const XZ12: str = __include_str("data/compress/period12.xz")
const XZ24: str = __include_str("data/compress/period24.xz")
const BR12: str = __include_str("data/compress/period12.br")
const BR24: str = __include_str("data/compress/period24.br")

// the plain data: octets (i * 7 + 3) % 251 repeated with the given period, 4000 octets
fn plain(period: usize) -> rt.Buf {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 4000 {
        rt.buf_push(&b, (((i % period) * 7 + 3) % 251) as u8)
        i = i + 1
    }
    return b
}

fn same(a: *mut rt.Buf, b: *mut rt.Buf) -> bool {
    return rt.buf_len(a) == rt.buf_len(b) && rt.mem_eq(rt.buf_ptr(a), rt.buf_ptr(b), rt.buf_len(a))
}

fn fail(what: str) -> i32 {
    io.print("FAIL ")
    io.print_line(what)
    return 1 as i32
}

static mut failed: bool = false

fn note(e: CompressError) -> usize {
    failed = true
    return 0
}

fn main() -> i32 {
    var bad: i32 = 0
    var p12: rt.Buf = plain(12)
    var p24: rt.Buf = plain(24)
    var o: rt.Buf = rt.buf_new()
    failed = false
    lzma.xz_decompress_limited(XZ12.p as u64, XZ12.length(), 0, &o) catch | e | (note(e))
    if failed || !same(&o, &p12) { bad = bad + fail("xz period 12") }
    rt.buf_clear(&o)
    failed = false
    lzma.xz_decompress_limited(XZ24.p as u64, XZ24.length(), 0, &o) catch | e | (note(e))
    if failed || !same(&o, &p24) { bad = bad + fail("xz period 24") }
    rt.buf_clear(&o)
    failed = false
    brotli.brotli_decompress_limited(BR12.p as u64, BR12.length(), 0, &o) catch | e | (note(e))
    if failed || !same(&o, &p12) { bad = bad + fail("brotli period 12") }
    rt.buf_clear(&o)
    failed = false
    brotli.brotli_decompress_limited(BR24.p as u64, BR24.length(), 0, &o) catch | e | (note(e))
    if failed || !same(&o, &p24) { bad = bad + fail("brotli period 24") }
    if bad == 0 as i32 { io.print_line("ok overlap matches") }
    return bad
}
