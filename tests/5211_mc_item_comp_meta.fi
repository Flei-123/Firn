// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_inv

fn put_window(b: *mut bytes.Bytes, p: i32) {
    if p == 767 { bytes.put_u8(b, 0 as u8) } else { bytes.put_varint(b, 0) }
}

fn put_str(b: *mut bytes.Bytes, s: str) {
    bytes.put_varint(b, s.n as i32)
    bytes.put_raw(b, s.p as u64, s.n)
}

fn put_f64(b: *mut bytes.Bytes, v: u64) {
    var i: i32 = 7
    while i >= 0 {
        bytes.put_u8(b, ((v >> ((i * 8) as u64)) & 255) as u8)
        i = i - 1
    }
}

fn has_line(p: u64, n: usize, lit: str) -> bool {
    var i: usize = 0
    while i + lit.n <= n {
        if rt.mem_eq(p + (i as u64), lit.p as u64, lit.n) { return true }
        i = i + 1
    }
    return false
}

fn put_attr(b: *mut bytes.Bytes, p: i32, type_id: i32, name: str, bits: u64, slot: i32, hidden: bool) {
    bytes.put_varint(b, type_id)
    put_str(b, name)
    put_f64(b, bits)
    bytes.put_varint(b, 0)
    bytes.put_varint(b, slot)
    if p >= 770 {
        if hidden { bytes.put_varint(b, 1) } else { bytes.put_varint(b, 0) }
    }
}

fn put_attr_stack(b: *mut bytes.Bytes, p: i32, attr_ct: i32, hidden: bool) {
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 794)
    bytes.put_varint(b, 3)
    bytes.put_varint(b, 0)
    bytes.put_varint(b, 2)
    bytes.put_varint(b, 100)
    bytes.put_varint(b, 3)
    bytes.put_varint(b, 10)
    bytes.put_varint(b, attr_ct)
    bytes.put_varint(b, 2)
    put_attr(b, p, 2, "minecraft:base_attack_damage", 0x4018000000000000 as u64, 1, hidden)
    put_attr(b, p, 4, "minecraft:test", 0xC003333333333333 as u64, 1, false)
    if p < 770 { bytes.put_bool(b, !hidden) }
}

fn put_potion_stack(b: *mut bytes.Bytes, pot_ct: i32) {
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 794)
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 0)
    bytes.put_varint(b, pot_ct)
    bytes.put_bool(b, true)
    bytes.put_varint(b, 13)
    bytes.put_bool(b, false)
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 0)
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 600)
    bytes.put_bool(b, false)
    bytes.put_bool(b, true)
    bytes.put_bool(b, true)
    bytes.put_bool(b, false)
    bytes.put_bool(b, false)
}

fn check(p: i32, attr_ct: i32, pot_ct: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 1 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    var b: bytes.Bytes = bytes.bytes_new()
    put_window(&b, p)
    bytes.put_varint(&b, 5)
    bytes.put_varint(&b, 46)
    var i: i32 = 0
    while i < 46 {
        if i == 36 { put_attr_stack(&b, p, attr_ct, false) } else if i == 37 { put_potion_stack(&b, pot_ct) } else if i == 38 { put_attr_stack(&b, p, attr_ct, true) } else { bytes.put_varint(&b, 0) }
        i = i + 1
    }
    bytes.put_varint(&b, 0)
    bytes.bytes_set_pos(&b, 0)
    if !mc_inv.inv_on_window_items_v(&v, &ver, &b) { return 2 }
    var mp: u64 = 0
    var mn: usize = 0
    if !mc_inv.inv_slot_meta(&v, 36, &mp, &mn) { return 3 }
    if !has_line(mp, mn, "m100") || !has_line(mp, mn, "d10") { return 4 }
    var ap: u64 = 0
    var an: usize = 0
    if p <= 767 { an = 0 }
    if !has_line(mp, mn, "\tmainhand\t1\n") { return 5 }
    if !has_line(mp, mn, "\t0\tmainhand\t1") { return 6 }
    if !has_line(mp, mn, "\t700\t0\tmainhand\t1\n") { return 7 }
    if !has_line(mp, mn, "\t160\t0\tmainhand\t0\n") && !has_line(mp, mn, "\t-240\t0\tmainhand\t0\n") { return 8 }
    if !mc_inv.inv_slot_meta(&v, 37, &mp, &mn) { return 9 }
    if !has_line(mp, mn, "p13\n") || !has_line(mp, mn, "f0\t1\t600\n") { return 10 }
    if !mc_inv.inv_slot_meta(&v, 38, &mp, &mn) { return 11 }
    if p < 770 && !has_line(mp, mn, "x1\n") { return 12 }
    if p >= 770 && has_line(mp, mn, "\t700\t0\tmainhand\t1\n") { return 13 }
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    var r: i32 = check(767, 12, 31)
    if r != 0 { return 100 + r }
    r = check(769, 13, 41)
    if r != 0 { return 200 + r }
    r = check(772, 13, 42)
    if r != 0 { return 300 + r }
    r = check(775, 16, 51)
    if r != 0 { return 400 + r }
    return 0
}
