// expect_exit: 0
import std.rt
import media.audio.source
import media.audio.sniff
import media.audio.open
import media.audio.all

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn put16(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 8) & 255 as u32) as u8)
}

fn put32(b: *mut rt.Buf, v: u32) {
    put16(b, v & 65535 as u32)
    put16(b, v >> 16)
}

fn tag(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, 4)
}

fn make_wav(b: *mut rt.Buf, frames: u32) {
    tag(b, "RIFF")
    put32(b, 36 as u32 + frames * 4 as u32)
    tag(b, "WAVE")
    tag(b, "fmt ")
    put32(b, 16 as u32)
    put16(b, 1 as u32)
    put16(b, 2 as u32)
    put32(b, 8000 as u32)
    put32(b, 32000 as u32)
    put16(b, 4 as u32)
    put16(b, 16 as u32)
    tag(b, "data")
    put32(b, frames * 4 as u32)
    var i: u32 = 0 as u32
    while i < frames {
        put16(b, i & 32767 as u32)
        put16(b, 65535 as u32 - (i & 32767 as u32))
        i = i + 1 as u32
    }
}

fn main(start: u64) -> i32 {
    var wav: rt.Buf = rt.buf_new()
    make_wav(&wav, 1000 as u32)
    check(sniff.sniff_format(rt.buf_ptr(&wav), rt.buf_len(&wav)) == source.FMT_WAV, 1)
    var reg: source.Registry = source.registry_new()
    all.register_all(&reg)
    var s: source.AudioSource = source.source_new()
    check(open.open_bytes(&reg, rt.buf_ptr(&wav), rt.buf_len(&wav), &s), 2)
    let inf: source.AudioInfo = source.source_info(&s)
    check(inf.format == source.FMT_WAV && inf.channels == 2 as u32 && inf.rate == 8000 as u32 && inf.frames == 1000 as u64, 3)
    check(inf.duration_ms == 125 as u64 && inf.known_length && inf.seekable, 4)
    let buf: u64 = rt.heap_alloc(400 * 2 * 4)
    check(source.source_read_f32(&s, buf, 400) == 400, 5)
    check(*((buf + 8) as *mut f32) == 1.0 / 32768.0, 6)
    check(source.source_position(&s) == 400 as u64, 7)
    check(source.source_seek(&s, 990 as u64), 8)
    check(source.source_read_f32(&s, buf, 400) == 10, 9)
    check(*((buf) as *mut f32) == 990.0 / 32768.0, 10)
    check(source.source_read_f32(&s, buf, 400) == 0 && source.source_eof(&s), 11)
    check(!source.source_seek(&s, 1001 as u64), 12)
    check(source.source_seek_ms(&s, 62 as u64), 13)
    check(source.source_position(&s) == 496 as u64, 14)
    source.source_close(&s)
    var junk: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&junk, "not audio at all, just text".p as u64, 20)
    check(sniff.sniff_format(rt.buf_ptr(&junk), rt.buf_len(&junk)) == source.FMT_UNKNOWN, 15)
    check(!open.open_bytes(&reg, rt.buf_ptr(&junk), rt.buf_len(&junk), &s), 16)
    rt.heap_free(buf, 400 * 2 * 4)
    return 0
}
