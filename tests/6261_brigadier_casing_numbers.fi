// expect_exit: 0
import std.rt
import std.io
import brigadier.bmem as mm
import brigadier.text as tx
import brigadier.casing as cs
import brigadier.javanum as jn

fn lowered(a: *mut mm.BumpArena, s: str) -> tx.U16 {
    return cs.u16_lower(a, tx.u16_from_str(a, s))
}

fn java_double(a: *mut mm.BumpArena, x: f64) -> str {
    var b: mm.Arr[u16] = tx.b16_new()
    jn.put_double(a, &b, x)
    return tx.u16_to_str(a, tx.b16_view(&b))
}

fn java_float(a: *mut mm.BumpArena, x: f32) -> str {
    var b: mm.Arr[u16] = tx.b16_new()
    jn.put_float(a, &b, x)
    return tx.u16_to_str(a, tx.b16_view(&b))
}

fn check(name: str, ok: bool, bad: *mut i32) {
    if !ok {
        io.fmt_print(f"FAIL {name}\n")
        *bad = *bad + 1
    }
}

fn main(start: u64) -> i32 {
    var a: mm.BumpArena = mm.arena_new()
    var bad: i32 = 0
    check("dotted I expands", lowered(&a, "İ").n == 2, &bad)
    check("final sigma", tx.u16_at(lowered(&a, "ΑΣ"), 1) == 0x3C2, &bad)
    check("medial sigma", tx.u16_at(lowered(&a, "ΑΣΑ"), 1) == 0x3C3, &bad)
    check("lone sigma", tx.u16_at(lowered(&a, "Σ"), 0) == 0x3C3, &bad)
    check("deseret", tx.u16_at(lowered(&a, "𐐀"), 1) == 0xDC28, &bad)
    check("ci sigma", cs.u16_cmp_ci(tx.u16_from_str(&a, "ς"), tx.u16_from_str(&a, "σ")) == 0, &bad)
    check("ci order", cs.u16_cmp_ci(tx.u16_from_str(&a, "Abc"), tx.u16_from_str(&a, "aBd")) < 0, &bad)
    check("ci prefix", cs.u16_cmp_ci(tx.u16_from_str(&a, "ab"), tx.u16_from_str(&a, "AbC")) == -1, &bad)
    check("double min", java_double(&a, 4.9e-324) == "4.9E-324", &bad)
    check("double min2", java_double(&a, 1.0e-323) == "9.9E-324", &bad)
    check("float min", java_float(&a, 1.4e-45) == "1.4E-45", &bad)
    check("float min7", java_float(&a, 1.0e-44) == "9.8E-45", &bad)
    mm.arena_free(&a)
    if bad == 0 {
        io.fmt_print(f"ok\n")
    }
    return bad
}
