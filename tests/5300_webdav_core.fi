// expect_exit: 0
import std.rt
import std.str
import webdav.wd_path
import webdav.wd_xml
import webdav.wd_auth

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn buf_is(b: *mut rt.Buf, want: str) -> bool {
    return rt.buf_len(b) == want.n && rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.n)
}

fn same(a: str, b: str) -> bool {
    return a.n == b.n && rt.mem_eq(a.p as u64, b.p as u64, a.n)
}

fn enc_is(src: str, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    wd_path.pct_encode_path(src.p as u64, src.n, &b)
    let ok: bool = buf_is(&b, want)
    rt.buf_free(&b)
    return ok
}

fn dec_is(src: str, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    let ok: bool = wd_path.pct_decode(src.p as u64, src.n, &b) && buf_is(&b, want)
    rt.buf_free(&b)
    return ok
}

fn dec_bad(src: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    let ok: bool = wd_path.pct_decode(src.p as u64, src.n, &b)
    rt.buf_free(&b)
    return !ok
}

fn norm_is(src: str, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    let ok: bool = wd_path.path_normalize(src.p as u64, src.n, &b) && buf_is(&b, want)
    rt.buf_free(&b)
    return ok
}

fn norm_bad(src: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    let ok: bool = wd_path.path_normalize(src.p as u64, src.n, &b)
    rt.buf_free(&b)
    return !ok
}

fn href_is(src: str, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    wd_path.href_to_path(src.p as u64, src.n, &b)
    let ok: bool = buf_is(&b, want)
    rt.buf_free(&b)
    return ok
}

fn seg_is(src: str, want: str) -> bool {
    var at: usize = 0
    let n: usize = wd_path.path_last_segment(src.p as u64, src.n, &at)
    return n == want.n && rt.mem_eq(src.p as u64 + at as u64, want.p as u64, n)
}

fn paths() {
    check("enc plain", enc_is("/a/b.txt", "/a/b.txt"))
    check("enc space", enc_is("/my file", "/my%20file"))
    check("enc utf8", enc_is("/\u{e4}", "/%C3%A4"))
    check("enc special", enc_is("/a#b?c%d", "/a%23b%3Fc%25d"))
    check("dec", dec_is("/my%20file%C3%A4", "/my file\u{e4}"))
    check("dec lower hex", dec_is("%2f%2F", "//"))
    check("dec bad short", dec_bad("abc%2"))
    check("dec bad hex", dec_bad("%zz"))
    check("norm dup slash", norm_is("//a///b/", "/a/b"))
    check("norm dot", norm_is("/a/./b", "/a/b"))
    check("norm root", norm_is("", "/"))
    check("norm dotdot", norm_bad("/a/../b"))
    check("href abs", href_is("https://h:8443/x/y/?q=1", "/x/y/"))
    check("href host only", href_is("http://h", "/"))
    check("href path", href_is("/x%20y", "/x%20y"))
    check("seg", seg_is("/a/b/c.txt", "c.txt"))
    check("seg dir", seg_is("/a/b/", "b"))
    check("seg root", seg_is("/", ""))
    var j: rt.Buf = rt.buf_new()
    wd_path.path_join("/a/".p as u64, 3, "/b/c".p as u64, 4, &j)
    check("join", buf_is(&j, "/a/b/c"))
    rt.buf_free(&j)
}

fn has(l: *mut wd_xml.Listing, i: usize, path: str, name: str, dir: bool, size: u64) -> bool {
    return same(wd_xml.list_path(l, i), path) && same(wd_xml.list_name(l, i), name) &&
        wd_xml.list_is_dir(l, i) == dir && wd_xml.list_size(l, i) == size
}

fn multistatus() {
    var l: wd_xml.Listing = wd_xml.listing_new()
    let a: str = "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<D:multistatus xmlns:D=\"DAV:\">\n<D:response><D:href>/dav/root/</D:href><D:propstat><D:prop><D:resourcetype><D:collection/></D:resourcetype><D:getlastmodified>Sun, 06 Nov 1994 08:49:37 GMT</D:getlastmodified></D:prop><D:status>HTTP/1.1 200 OK</D:status></D:propstat></D:response>\n<D:response><D:href>/dav/root/my%20file.txt</D:href><D:propstat><D:prop><D:resourcetype/><D:getcontentlength>1234</D:getcontentlength><D:getetag>\"abc\"</D:getetag><D:getcontenttype>text/plain</D:getcontenttype><D:displayname>my file.txt</D:displayname><D:getlastmodified>Sun, 06 Nov 1994 08:49:37 GMT</D:getlastmodified></D:prop><D:status>HTTP/1.1 200 OK</D:status></D:propstat><D:propstat><D:prop><D:quota/></D:prop><D:status>HTTP/1.1 404 Not Found</D:status></D:propstat></D:response>\n<D:response><D:href>http://h:80/dav/root/sub%C3%A4/</D:href><D:propstat><D:prop><D:resourcetype><D:collection/></D:resourcetype></D:prop><D:status>HTTP/1.1 200 OK</D:status></D:propstat></D:response>\n</D:multistatus>"
    check("ms parse a", wd_xml.parse_multistatus(&l, "/dav/root", a.p as u64, a.n))
    check("ms count a", wd_xml.list_count(&l) == 3)
    check("ms root", has(&l, 0, "/", "", true, 0))
    check("ms file", has(&l, 1, "/my file.txt", "my file.txt", false, 1234))
    check("ms file etag", same(wd_xml.list_etag(&l, 1), "\"abc\""))
    check("ms file ctype", same(wd_xml.list_ctype(&l, 1), "text/plain"))
    check("ms file disp", same(wd_xml.list_display(&l, 1), "my file.txt"))
    check("ms file mtime", wd_xml.list_mtime(&l, 1) == 784111777 as u64)
    check("ms file status", wd_xml.list_status(&l, 1) == 200 as u32)
    check("ms sub", has(&l, 2, "/sub\u{e4}", "sub\u{e4}", true, 0))
    wd_xml.listing_free(&l)

    var l2: wd_xml.Listing = wd_xml.listing_new()
    let b: str = "<multistatus xmlns=\"DAV:\"><response><href>/x/f</href><propstat><prop><getcontentlength>7</getcontentlength><resourcetype/></prop><status>HTTP/1.1 200 OK</status></propstat></response><response><href>/x/gone</href><status>HTTP/1.1 404 Not Found</status></response></multistatus>"
    check("ms parse b", wd_xml.parse_multistatus(&l2, "", b.p as u64, b.n))
    check("ms count b", wd_xml.list_count(&l2) == 2)
    check("ms b file", has(&l2, 0, "/x/f", "f", false, 7))
    check("ms b status", wd_xml.list_status(&l2, 1) == 404 as u32)
    wd_xml.listing_free(&l2)

    var l3: wd_xml.Listing = wd_xml.listing_new()
    let c: str = "<d:multistatus xmlns:d=\"DAV:\"><d:response><d:href>/other/f</d:href></d:response></d:multistatus>"
    check("ms outside root kept", wd_xml.parse_multistatus(&l3, "/dav", c.p as u64, c.n) && has(&l3, 0, "/other/f", "f", false, 0))
    wd_xml.listing_free(&l3)

    var l4: wd_xml.Listing = wd_xml.listing_new()
    let bad: str = "<multistatus><response></multistatus>"
    check("ms malformed", !wd_xml.parse_multistatus(&l4, "", bad.p as u64, bad.n))
    let wrong: str = "<html/>"
    check("ms wrong root", !wd_xml.parse_multistatus(&l4, "", wrong.p as u64, wrong.n))
    let dtd: str = "<!DOCTYPE x><multistatus/>"
    check("ms dtd refused", !wd_xml.parse_multistatus(&l4, "", dtd.p as u64, dtd.n))
    let trav: str = "<multistatus><response><href>/a/%2e%2e/../b</href></response></multistatus>"
    check("ms traversal refused", !wd_xml.parse_multistatus(&l4, "", trav.p as u64, trav.n))
    wd_xml.listing_free(&l4)

    var pb: rt.Buf = rt.buf_new()
    wd_xml.propfind_body(&pb)
    check("propfind body", rt.buf_len(&pb) > 100)
    rt.buf_free(&pb)
    check("status code", wd_xml.status_code_of("HTTP/1.1 207 Multi-Status".p as u64, 25) == 207 as u32)
    check("status bad", wd_xml.status_code_of("HTTP/1.1".p as u64, 8) == 0 as u32)
}

fn header_has(h: *mut rt.Buf, part: str) -> bool {
    var i: usize = 0
    while i + part.n <= rt.buf_len(h) {
        if rt.mem_eq(rt.buf_ptr(h) + i as u64, part.p as u64, part.n) {
            return true
        }
        i = i + 1
    }
    return false
}

fn auth() {
    var a: wd_auth.Auth = wd_auth.auth_new()
    wd_auth.auth_set_user(&a, "Mufasa", "Circle Of Life")
    wd_auth.auth_set_cnonce(&a, "0a4f113b")
    let ch: str = "Digest realm=\"testrealm@host.com\", qop=\"auth,auth-int\", nonce=\"dcd98b7102dd2f0e8b11d0f600bfb0c093\", opaque=\"5ccc069c403ebaf9f0171e9517f40e41\""
    check("digest challenge", wd_auth.auth_challenge(&a, ch.p as u64, ch.n) == wd_auth.SCHEME_DIGEST)
    var h: rt.Buf = rt.buf_new()
    check("digest header", wd_auth.auth_header(&a, "GET", "/dir/index.html".p as u64, 15, &h))
    check("rfc2617 response", header_has(&h, "response=\"6629fae49393a05397450978507c4ef1\""))
    check("rfc2617 nc", header_has(&h, "nc=00000001"))
    check("rfc2617 opaque", header_has(&h, "opaque=\"5ccc069c403ebaf9f0171e9517f40e41\""))
    rt.buf_clear(&h)
    wd_auth.auth_header(&a, "GET", "/dir/index.html".p as u64, 15, &h)
    check("nc counts", header_has(&h, "nc=00000002"))
    rt.buf_free(&h)
    wd_auth.auth_free(&a)

    var s: wd_auth.Auth = wd_auth.auth_new()
    wd_auth.auth_set_user(&s, "Mufasa", "Circle of Life")
    wd_auth.auth_set_cnonce(&s, "f2/wE4q74E6zIJEtWaHKaf5wv/H5QzzpXusqGemxURZJ")
    let ch2: str = "Digest realm=\"http-auth@example.org\", qop=\"auth, auth-int\", algorithm=SHA-256, nonce=\"7ypf/xlj9XXwfDPEoM4URrv/xwf94BcCAzFZH4GiTo0v\", opaque=\"FQhe/qaU925kfnzjCev0ciny7QMkPqMAFRtzCUYo5tdS\""
    check("sha256 challenge", wd_auth.auth_challenge(&s, ch2.p as u64, ch2.n) == wd_auth.SCHEME_DIGEST)
    var h2: rt.Buf = rt.buf_new()
    wd_auth.auth_header(&s, "GET", "/dir/index.html".p as u64, 15, &h2)
    check("rfc7616 sha256 response", header_has(&h2, "response=\"753927fa0e85d155564e2e272a28d1802ca10daf4496794697cf8db5856cb6c1\""))
    check("sha256 algorithm", header_has(&h2, "algorithm=SHA-256"))
    rt.buf_free(&h2)
    wd_auth.auth_free(&s)

    var b: wd_auth.Auth = wd_auth.auth_new()
    wd_auth.auth_set_user(&b, "Aladdin", "open sesame")
    let bc: str = "Basic realm=\"x\", charset=\"UTF-8\""
    check("basic challenge", wd_auth.auth_challenge(&b, bc.p as u64, bc.n) == wd_auth.SCHEME_BASIC)
    var h3: rt.Buf = rt.buf_new()
    wd_auth.auth_header(&b, "GET", "/".p as u64, 1, &h3)
    check("basic header", buf_is(&h3, "Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ=="))
    rt.buf_free(&h3)
    let both: str = "Basic realm=\"x\", Digest realm=\"y\", nonce=\"n1\""
    check("digest preferred", wd_auth.auth_challenge(&b, both.p as u64, both.n) == wd_auth.SCHEME_DIGEST)
    let unk: str = "Negotiate"
    check("unknown scheme", wd_auth.auth_challenge(&b, unk.p as u64, unk.n) == 0 as u32)
    let sha512: str = "Digest realm=\"r\", nonce=\"n\", algorithm=SHA-512-256"
    check("unsupported algorithm", wd_auth.auth_challenge(&b, sha512.p as u64, sha512.n) == 0 as u32)
    let intonly: str = "Digest realm=\"r\", nonce=\"n\", qop=\"auth-int\""
    check("auth-int only refused", wd_auth.auth_challenge(&b, intonly.p as u64, intonly.n) == 0 as u32)
    let legacy: str = "Digest realm=\"r\", nonce=\"n\""
    check("legacy digest", wd_auth.auth_challenge(&b, legacy.p as u64, legacy.n) == wd_auth.SCHEME_DIGEST)
    var h4: rt.Buf = rt.buf_new()
    wd_auth.auth_header(&b, "GET", "/".p as u64, 1, &h4)
    check("legacy without qop", !header_has(&h4, "qop=") && !header_has(&h4, "cnonce"))
    rt.buf_free(&h4)
    var q: rt.Buf = rt.buf_new()
    wd_auth.hash_hex(wd_auth.ALG_MD5, "abc".p as u64, 3, &q)
    check("md5 abc", buf_is(&q, "900150983cd24fb0d6963f7d28e17f72"))
    rt.buf_free(&q)
    wd_auth.auth_free(&b)
}

fn main() -> i32 {
    paths()
    multistatus()
    auth()
    if failures != 0 {
        return 1
    }
    return 0
}
