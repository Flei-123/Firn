// expect_exit: 71
// ROUND 47 -- A FINALIZER MUST NOT ALLOCATE.
//
// A GC allocation from inside a finalizer would start a collection in the
// MIDDLE of a collection: the queue, the free lists and the sweep markers
// are half finished at that moment. The collector would take itself
// apart.
//
// Firn does not let that happen silently. The lock sits in the same check
// that stands at the beginning of every allocation anyway (S_INIT: 0 = no
// gc_init, 1 = ready, 2 = a finalizer is running) -- so it costs the normal
// path NOTHING. The abort reports itself on standard error and ends with
// return value 71.
//
// Channel 2 is closed beforehand so that the message does not pollute the
// test log; what is checked is the return value. The text of the message
// is shown in docs/ROUND47.md.

const T_SYS_CLOSE: i64 = 3

gc class Case {
    next: Gc[Case],
    value: u64,
}

fn __gc_finalize(kind: u64, p: *mut u8) {
    if kind != 3 {
        return
    }
    let f: Gc[Case] = p as Gc[Case]
    if f == gc_null[Case]() {
        return
    }
    // FORBIDDEN: here the program aborts with 71.
    let new: Gc[Case] = gc Case { next: gc_null[Case](), value: 2 } catch gc_null[Case]()
    if new == gc_null[Case]() {
        return
    }
}

fn dies(depth: u64) -> AllocError!bool {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    if depth > 0 {
        return try dies(depth - 1)
    }
    let f: Gc[Case] = try gc Case { next: gc_null[Case](), value: 1 }
    return gc_finalizer_set(f as *mut u8, 3)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}

fn run() -> AllocError!i32 {
    if !(try dies(2)) {
        return 92
    }
    syscall(T_SYS_CLOSE, 2, 0, 0, 0, 0, 0)
    gc_collect()
    // The program does not get here: the finalizer aborted.
    return 93
}
