// expect_exit: 0
// r899: vec_free zeroes ptr/len/cap, so freeing the SAME variable twice is a no-op.
// (A COPY of the Vec struct is trivial and is not covered, see docs/SAFETY.md.)
import std.rt
import std.vec

fn main() -> i32 {
    if !gc_init() { return 9 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 5)
    vec_free[i32](&v)
    vec_free[i32](&v)
    if vec_len[i32](&v) != 0 { return 1 }
    return 0
}
