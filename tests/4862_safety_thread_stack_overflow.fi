// expect_exit: 101
// wasm_skip: threads need clone, not available in wasm
// only_target: x86_64
// N3 closed: unbounded recursion in a thread other than the main thread ends with "firn: stack overflow" and exit code 101.
import std.rt

fn recurse(n: u64) -> u64 {
    var pad: [u64; 64] = [0; 64]
    pad[(n % 64) as usize] = n
    return recurse(n + 1) + pad[0]
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return recurse(arg)
}

fn main() -> i32 {
    let h: u64 = thread_start(1, 0)
    thread_wait(h)
    return 0
}
