// expect_exit: 0
// r899: v[a:b:s] builds a NEW Vec; a write into the source does not show in the slice
// and freeing the source does not dangle the slice.
import std.rt
import std.vec

fn main() -> i32 {
    if !gc_init() { return 9 }
    var v: Vec[i64] = vec_new[i64]()
    vec_push[i64](&v, 1)
    vec_push[i64](&v, 2)
    vec_push[i64](&v, 3)
    var s: Vec[i64] = v[0:2:1]
    v[0] = 99
    vec_free[i64](&v)
    if s[0] != 1 { return 1 }
    if s[1] != 2 { return 2 }
    if vec_len[i64](&s) != 2 { return 3 }
    vec_free[i64](&s)
    return 0
}
