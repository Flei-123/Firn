// expect_exit: 0
import fui.nav_route
import std.rt

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn is(p: *mut u8, n: usize, want: str) -> bool {
    if n != want.n { return false }
    var i: usize = 0
    while i < n {
        if *((p as u64 + i as u64) as *mut u8) != *((want.p as u64 + i as u64) as *mut u8) { return false }
        i = i + 1
    }
    return *((p as u64 + n as u64) as *mut u8) == 0 as u8
}

fn main() -> i32 {
    var rs: nav_route.Routes = nav_route.nroute_new()
    let chat: usize = nav_route.nroute_add(&rs, "chat", "fleitec", "chat/:id")
    let mail: usize = nav_route.nroute_add(&rs, "mail", "app", "mail/:acct/:uid")
    let home: usize = nav_route.nroute_add(&rs, "inbox", "fleitec", "inbox")
    check("add", chat == 0 && mail == 1 && home == 2 && nav_route.nroute_count(&rs) == 3)
    check("dup id", nav_route.nroute_add(&rs, "chat", "fleitec", "x/:y") == nav_route.NAV_NONE)
    check("bad pattern empty seg", nav_route.nroute_add(&rs, "b1", "fleitec", "a//b") == nav_route.NAV_NONE)
    check("bad pattern dup param", nav_route.nroute_add(&rs, "b2", "fleitec", "a/:x/:x") == nav_route.NAV_NONE)
    check("bad pattern too many", nav_route.nroute_add(&rs, "b3", "fleitec", ":a/:b/:c/:d/:e") == nav_route.NAV_NONE)
    check("find", nav_route.nroute_find(&rs, "mail") == 1 && nav_route.nroute_find(&rs, "nope") == nav_route.NAV_NONE)

    var m: nav_route.Match = nav_route.nroute_parse(&rs, "fleitec://chat/abc123")
    check("parse chat", m.ok && m.route == 0 && m.np == 1)
    check("param value", nav_route.nroute_get(&m, "id").n == 6 && nav_route.nroute_get(&m, "nope").n == 0)
    var m2: nav_route.Match = nav_route.nroute_parse(&rs, "app://mail/work/42?folder=sent&x=1#frag")
    check("parse mail", m2.ok && m2.route == 1 && m2.np == 2)
    check("mail params", nav_route.nroute_get(&m2, "acct").n == 4 && nav_route.nroute_get(&m2, "uid").n == 2)
    check("query", nav_route.nroute_query(&m2, "folder").n == 4 && nav_route.nroute_query(&m2, "x").n == 1 && nav_route.nroute_query(&m2, "zz").n == 0)
    check("parse literal route", nav_route.nroute_parse(&rs, "fleitec://inbox").route == 2)
    check("wrong scheme", !nav_route.nroute_parse(&rs, "app://chat/abc").ok)
    check("wrong arity", !nav_route.nroute_parse(&rs, "app://mail/work").ok)
    check("empty param", !nav_route.nroute_parse(&rs, "fleitec://chat/").ok)
    check("no scheme", !nav_route.nroute_parse(&rs, "chat/abc").ok)
    check("unknown", !nav_route.nroute_parse(&rs, "fleitec://nothing/x").ok)

    var b: [u8; 96] = [0 as u8; 96]
    let bp: u64 = (&b[0]) as u64
    var n: usize = nav_route.nroute_make(&rs, "chat", "r42", "", "", bp, 96)
    check("make chat", is(bp as *mut u8, n, "fleitec://chat/r42"))
    n = nav_route.nroute_make(&rs, "mail", "me", "17", "", bp, 96)
    check("make mail", is(bp as *mut u8, n, "app://mail/me/17"))
    n = nav_route.nroute_make(&rs, "inbox", "", "", "", bp, 96)
    check("make literal", is(bp as *mut u8, n, "fleitec://inbox"))
    n = nav_route.nroute_make(&rs, "chat", "!room:srv", "", "", bp, 96)
    check("make encodes", is(bp as *mut u8, n, "fleitec://chat/%21room%3Asrv"))
    check("make missing value", nav_route.nroute_make(&rs, "chat", "", "", "", bp, 96) == 0)
    check("make unknown route", nav_route.nroute_make(&rs, "zzz", "a", "", "", bp, 96) == 0)
    check("make too small", nav_route.nroute_make(&rs, "chat", "abcdef", "", "", bp, 12) == 0)

    var dec: [u8; 32] = [0 as u8; 32]
    let dn: usize = nav_route.nroute_decode("%21room%3Asrv%zz", (&dec[0]) as u64, 32)
    check("decode", is((&dec[0]) as *mut u8, dn, "!room:srv%zz"))
    var mm: nav_route.Match = nav_route.nroute_match_new(&rs, "mail")
    check("match_new", mm.ok && mm.np == 2 && nav_route.nroute_set(&mm, "uid", "9") && !nav_route.nroute_set(&mm, "zz", "9"))
    nav_route.nroute_set(&mm, "acct", "a")
    mm.query = "q=1"
    n = nav_route.nroute_build(&rs, &mm, bp, 96)
    check("build with query", is(bp as *mut u8, n, "app://mail/a/9?q=1"))
    var back: nav_route.Match = nav_route.nroute_parse(&rs, "fleitec://chat/%21room%3Asrv")
    n = nav_route.nroute_decode(nav_route.nroute_get(&back, "id"), (&dec[0]) as u64, 32)
    check("roundtrip", is((&dec[0]) as *mut u8, n, "!room:srv"))

    var nav: nav_route.Nav = nav_route.nnav_new()
    check("empty nav", nav_route.nnav_depth(&nav) == 0 && !nav_route.nnav_can_back(&nav) && nav_route.nnav_top(&nav).n == 0 && !nav_route.nnav_pop(&nav))
    check("push", nav_route.nnav_push(&nav, &rs, "fleitec://inbox") && nav_route.nnav_push(&nav, &rs, "fleitec://chat/a") && nav_route.nnav_push(&nav, &rs, "app://mail/x/1"))
    check("depth", nav_route.nnav_depth(&nav) == 3 && nav_route.nnav_can_back(&nav) && nav_route.nnav_top(&nav).n == 14)
    check("push invalid", !nav_route.nnav_push(&nav, &rs, "fleitec://zzz") && nav_route.nnav_depth(&nav) == 3)
    check("push same is no-op", nav_route.nnav_push(&nav, &rs, "app://mail/x/1") && nav_route.nnav_depth(&nav) == 3)
    check("replace", nav_route.nnav_replace(&nav, &rs, "app://mail/x/2") && nav_route.nnav_depth(&nav) == 3 && nav_route.nnav_top(&nav).n == 14)
    check("replace invalid", !nav_route.nnav_replace(&nav, &rs, "nonsense"))
    var sv: [u8; 256] = [0 as u8; 256]
    let sn: usize = nav_route.nnav_save(&nav, (&sv[0]) as u64, 256)
    check("save", is((&sv[0]) as *mut u8, sn, "nav1\nfleitec://inbox\nfleitec://chat/a\napp://mail/x/2\n"))
    check("pop", nav_route.nnav_pop(&nav) && nav_route.nnav_depth(&nav) == 2 && nav_route.nnav_top(&nav).n == 16)
    check("pop to root", nav_route.nnav_pop(&nav) && !nav_route.nnav_pop(&nav) && nav_route.nnav_depth(&nav) == 1)
    check("save too small", nav_route.nnav_save(&nav, (&sv[0]) as u64, 10) == 0)

    var nav2: nav_route.Nav = nav_route.nnav_new()
    let rn: usize = nav_route.nnav_restore(&nav2, &rs, str { p: (&sv[0]) as *mut u8, n: sn })
    check("restore", rn == 3 && nav_route.nnav_depth(&nav2) == 3 && nav_route.nnav_at(&nav2, 0).n == 15 && nav_route.nnav_at(&nav2, 5).n == 0)
    check("restore keeps order", nav_route.nnav_at(&nav2, 2).n == 14)
    var rs2: nav_route.Routes = nav_route.nroute_new()
    nav_route.nroute_add(&rs2, "inbox", "fleitec", "inbox")
    var nav3: nav_route.Nav = nav_route.nnav_new()
    check("restore drops unknown routes", nav_route.nnav_restore(&nav3, &rs2, str { p: (&sv[0]) as *mut u8, n: sn }) == 1)
    check("restore bad header", nav_route.nnav_restore(&nav3, &rs, "junk\nfleitec://inbox\n") == 0 && nav_route.nnav_depth(&nav3) == 1)

    var big: nav_route.Nav = nav_route.nnav_new()
    var i: u32 = 0 as u32
    var url: [u8; 40] = [0 as u8; 40]
    while i < (30 as u32) {
        let s: str = "fleitec://chat/x"
        var k: usize = 0
        while k < s.n {
            url[k] = *((s.p as u64 + k as u64) as *mut u8)
            k = k + 1
        }
        url[k] = 48 as u8 + (i / (10 as u32)) as u8
        url[k + 1] = 48 as u8 + (i % (10 as u32)) as u8
        nav_route.nnav_push(&big, &rs, str { p: (&url[0]) as *mut u8, n: k + 2 })
        i = i + 1
    }
    check("stack limit", nav_route.nnav_depth(&big) == nav_route.NAV_MAX_STACK)
    check("stack drops oldest", nav_route.nnav_at(&big, 0).n == 18 && *((nav_route.nnav_at(&big, 0).p as u64 + 17) as *mut u8) == 54 as u8 && *((nav_route.nnav_top(&big).p as u64 + 17) as *mut u8) == 57 as u8)
    nav_route.nnav_clear(&big)
    check("clear", nav_route.nnav_depth(&big) == 0)

    if failures == 0 {
        rt.write_everything(1, "ok\n".p as u64, 3)
    }
    return failures
}
