// expect_exit: 0
// tests/2352_std_stats_edge.fi -- std.stats on bad input and under stress
// (SKRIPT-LIBS r316): empty set, one element, NaN, infinities, bad p, null
// pointer -- always a number, never a trap; and 40 random/patterned arrays
// where median/percentile (quickselect) must equal the sorted reference.
// Exit codes: the number of the first failing check.
import std.vec
import std.math
import std.stats

fn next(s: u64) -> u64 {
    return s *% 6364136223846793005 +% 1442695040888963407
}

fn is_nan(x: f64) -> bool {
    return x != x
}

fn bits(x: f64) -> u64 {
    return math.math_bits(x)
}

// reference percentile on an already sorted array (the numpy formula)
fn ref_percentile(a: *mut f64, n: usize, pct: f64) -> f64 {
    let pos: f64 = ((n - 1) as f64) * (pct / 100.0)
    let k: usize = math.floor(pos) as usize
    let t: f64 = pos - (k as f64)
    if k + 1 >= n || t == 0.0 {
        return *vec_at_ptr(a, k)
    }
    let x: f64 = *vec_at_ptr(a, k)
    let y: f64 = *vec_at_ptr(a, k + 1)
    let d: f64 = y - x
    if t >= 0.5 {
        return y - d * (1.0 - t)
    }
    return x + d * t
}

fn vec_at_ptr(a: *mut f64, i: usize) -> *mut f64 {
    return ((a as u64) + (i as u64) * 8) as *mut f64
}

fn fill(v: *mut Vec[f64], n: usize, kind: usize, seed: u64) {
    var s: u64 = seed
    var i: usize = 0
    while i < n {
        s = next(s)
        var x: f64 = math.ldexp((s >> 11) as f64, 0 - 53) * 200.0 - 100.0
        if kind == 1 { x = i as f64 } // ascending
        if kind == 2 { x = (n - i) as f64 } // descending
        if kind == 3 { x = 5.0 } // all equal
        if kind == 4 { x = ((s >> 40) % 7) as f64 } // many ties
        if kind == 5 { // organ pipe
            if i < n / 2 { x = i as f64 } else { x = (n - i) as f64 }
        }
        if kind == 6 { x = if i % 2 == 0 { 1e300 } else { 0.0 - 1e300 } } // magnitudes
        vec_push[f64](v, x)
        i = i + 1
    }
}

// position-weighted hash: changes when elements move, not only when they change
fn shape_hash(v: *mut Vec[f64], n: usize) -> u64 {
    var h: u64 = 1469598103934665603
    var i: usize = 0
    while i < n {
        h = (h ^ bits(*vec_elem_ptr[f64](v, i))) *% 1099511628211
        i = i + 1
    }
    return h
}

fn main() -> i32 {
    let inf: f64 = math.INF()
    let nan: f64 = math.NAN()
    // --- empty set: NaN (sum 0.0), never a trap ---
    var e: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&e)
    if stats.sum_vec(&e) != 0.0 { return 1 }
    if !is_nan(stats.mean_vec(&e)) { return 2 }
    if !is_nan(stats.min_vec(&e)) || !is_nan(stats.max_vec(&e)) { return 3 }
    if !is_nan(stats.median_vec(&e)) || !is_nan(stats.median_vec_inplace(&e)) { return 4 }
    if !is_nan(stats.percentile_vec(&e, 50.0)) { return 5 }
    if !is_nan(stats.variance_vec(&e)) || !is_nan(stats.stdev_vec(&e)) { return 6 }
    if !is_nan(stats.pvariance_vec(&e)) || !is_nan(stats.pstdev_vec(&e)) { return 7 }
    stats.sort_vec(&e)
    // null pointer with a count of 0, and a non-zero count with n == 0
    if !is_nan(stats.mean(0 as *mut f64, 0)) { return 8 }
    if stats.sum(0 as *mut f64, 0) != 0.0 { return 9 }
    // --- one element ---
    var one: [f64; 1] = [4.25]
    if stats.mean(&one[0], 1) != 4.25 || stats.median(&one[0], 1) != 4.25 { return 10 }
    if stats.percentile(&one[0], 1, 37.0) != 4.25 { return 11 }
    if stats.min(&one[0], 1) != 4.25 || stats.max(&one[0], 1) != 4.25 { return 12 }
    if !is_nan(stats.variance(&one[0], 1)) || !is_nan(stats.stdev(&one[0], 1)) { return 13 }
    if stats.pvariance(&one[0], 1) != 0.0 || stats.pstdev(&one[0], 1) != 0.0 { return 14 }
    // --- NaN anywhere: NaN out, the data stays as it was ---
    var bad: [f64; 5] = [1.0, 2.0, nan, 4.0, 5.0]
    if !is_nan(stats.sum(&bad[0], 5)) || !is_nan(stats.mean(&bad[0], 5)) { return 15 }
    if !is_nan(stats.min(&bad[0], 5)) || !is_nan(stats.max(&bad[0], 5)) { return 16 }
    if !is_nan(stats.median(&bad[0], 5)) || !is_nan(stats.median_inplace(&bad[0], 5)) { return 17 }
    if !is_nan(stats.percentile(&bad[0], 5, 10.0)) { return 18 }
    if !is_nan(stats.variance(&bad[0], 5)) || !is_nan(stats.pvariance(&bad[0], 5)) { return 19 }
    if bad[0] != 1.0 || bad[1] != 2.0 || bad[3] != 4.0 || bad[4] != 5.0 { return 20 }
    // NaN as the first / last element is found too
    var bad2: [f64; 3] = [nan, 1.0, 2.0]
    var bad3: [f64; 3] = [1.0, 2.0, nan]
    if !is_nan(stats.min(&bad2[0], 3)) || !is_nan(stats.max(&bad3[0], 3)) { return 21 }
    // --- infinities follow IEEE ---
    var infs: [f64; 3] = [1.0, inf, 2.0]
    if stats.sum(&infs[0], 3) != inf || stats.mean(&infs[0], 3) != inf { return 22 }
    if stats.max(&infs[0], 3) != inf || stats.min(&infs[0], 3) != 1.0 { return 23 }
    if stats.median(&infs[0], 3) != 2.0 { return 24 }
    if !is_nan(stats.variance(&infs[0], 3)) { return 25 }
    var pn: [f64; 2] = [inf, 0.0 - inf]
    if !is_nan(stats.sum(&pn[0], 2)) { return 26 }
    if !is_nan(stats.median(&pn[0], 2)) { return 27 }
    // --- p out of range or NaN ---
    var d: [f64; 3] = [1.0, 2.0, 3.0]
    if !is_nan(stats.percentile(&d[0], 3, 0.0 - 0.5)) { return 28 }
    if !is_nan(stats.percentile(&d[0], 3, 100.5)) { return 29 }
    if !is_nan(stats.percentile(&d[0], 3, nan)) { return 30 }
    if stats.percentile(&d[0], 3, 0.0) != 1.0 || stats.percentile(&d[0], 3, 100.0) != 3.0 { return 31 }
    // --- overflow: the median avoids it, sum does not hide it ---
    var big: [f64; 2] = [1e308, 1e308]
    if stats.median(&big[0], 2) != 1e308 { return 32 }
    if stats.sum(&big[0], 2) != inf { return 33 }
    // --- signed zeros: equal for min/max/sum, ordered in the sort ---
    var z: [f64; 2] = [0.0, math.math_f64(9223372036854775808)]
    stats.sort(&z[0], 2)
    if bits(z[0]) != 9223372036854775808 || bits(z[1]) != 0 { return 34 }
    // --- stress: quickselect against the sorted reference, 7 shapes x 6 sizes ---
    var kind: usize = 0
    var sizes: [usize; 6] = [2, 3, 17, 100, 1001, 4096]
    var seed: u64 = 99
    while kind < 7 {
        var si: usize = 0
        while si < 6 {
            let n: usize = sizes[si]
            var v: Vec[f64] = vec_new[f64]()
            fill(&v, n, kind, seed)
            seed = next(seed)
            var sorted: Vec[f64] = vec_new[f64]()
            vec_copy[f64](&v, &sorted)
            stats.sort_vec(&sorted)
            if !vec_is_sorted[f64](&sorted) { return 40 }
            let sp: *mut f64 = vec_elem_ptr[f64](&sorted, 0)
            let pre: u64 = shape_hash(&v, n)
            var q: usize = 0
            while q < 9 {
                var pct: f64 = 0.0
                if q == 1 { pct = 1.0 }
                if q == 2 { pct = 25.0 }
                if q == 3 { pct = 50.0 }
                if q == 4 { pct = 75.0 }
                if q == 5 { pct = 99.0 }
                if q == 6 { pct = 100.0 }
                if q == 7 { pct = 33.3 }
                if q == 8 { pct = 97.5 }
                let want: f64 = ref_percentile(sp, n, pct)
                if bits(stats.percentile_vec(&v, pct)) != bits(want) { return 41 }
                // in place on a copy must agree and keep the multiset
                var w: Vec[f64] = vec_new[f64]()
                vec_copy[f64](&v, &w)
                if bits(stats.percentile_vec_inplace(&w, pct)) != bits(want) { return 42 }
                var x1: u64 = 0
                var x2: u64 = 0
                var j: usize = 0
                while j < n {
                    x1 = x1 ^ bits(*vec_elem_ptr[f64](&v, j))
                    x2 = x2 ^ bits(*vec_elem_ptr[f64](&w, j))
                    j = j + 1
                }
                if x1 != x2 { return 43 }
                vec_free[f64](&w)
                q = q + 1
            }
            // median: odd -> the middle, even -> (a+b)/2 of the sorted data
            var med: f64 = *vec_elem_ptr[f64](&sorted, n / 2)
            if n % 2 == 0 {
                med = (*vec_elem_ptr[f64](&sorted, n / 2 - 1) + med) / 2.0
            }
            if kind != 6 && bits(stats.median_vec(&v)) != bits(med) { return 44 }
            if kind == 6 && stats.median_vec(&v) != med && !(n % 2 == 0) { return 45 }
            // plain forms leave the data alone
            if shape_hash(&v, n) != pre { return 46 }
            vec_free[f64](&v)
            vec_free[f64](&sorted)
            si = si + 1
        }
        kind = kind + 1
    }
    return 0
}
