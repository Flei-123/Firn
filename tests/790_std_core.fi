// expect_out: io:1 5 math:7 3 9 10 4 1024 2 3141 25 str:3 226 1 0 vec:6 3 map:1 77 num:3 1 12 mem:1 42 1 0
// tests/790_std_core.fi -- the std facade (round 39), each part touched once.
//
//   std.io    print/eprint/read_file/write_file + the Fmt builder that this
//             test uses as well to build its output (anticipating f"...")
//   std.math  abs/min/max/clamp/isqrt/pow (integer) + sqrt/powi/PI (f64)
//   std.str   utf8 (code point -> octets) and atom (interned names)
//   std.vec   re-export of lib/rt/vec.fi (generic Vec[T])
//   std.map   re-export of lib/rt/map.fi (generic Map[K, V])
//   std.num   strtod (text -> f64 bits) and bignum
//   std.mem   raw (alloc/free) + the rc heap (heap_*); the generic
//             rc API (rc_new, RefCount[T]) holds program-wide
//   std.rt    comes along: io/vec/map/mem resolve their `import rt` through it
//
// Everything is found through the search path from round 39a: test.sh sets
// FIRNLIB to <repo>/lib; no test copies modules any more.
import std.io
import std.math
import std.str
import std.rt
import std.vec
import std.map
import std.num
import std.rc
import std.mem

// Short forms so that the chain stays readable.
fn t(f: io.Fmt, p: u64, n: usize) -> io.Fmt { return io.fmt_text(f, p, n) }
fn z(f: io.Fmt, v: i64) -> io.Fmt { return io.fmt_number(f, v) }
fn sp(f: io.Fmt) -> io.Fmt {
    var s: [u8; 1] = " "
    return io.fmt_text(f, (&s[0]) as u64, 1)
}

fn main() -> i32 {
    var f: io.Fmt = io.fmt_new()

    // --- std.io: write a file and read it back, eprint on stderr
    var t_io: [u8; 3] = "io:"
    f = t(f, (&t_io[0]) as u64, 3)
    var w: [u8; 5] = "hello"
    var path: [u8; 20] = "/tmp/firn790_io.txt\0"
    var ok_io: i64 = 0
    if io.write_file((&path[0]) as u64, (&w[0]) as u64, 5) {
        ok_io = 1
    }
    var ins: rt.Buf = rt.buf_new()
    var read: usize = 0
    if io.read_file((&path[0]) as u64, &ins) {
        read = rt.buf_len(&ins)
    }
    rt.buf_free(&ins)
    var e1: [u8; 1] = "e"
    io.eprint_bytes((&e1[0]) as u64, 1)
    f = z(f, ok_io)
    f = sp(f)
    f = z(f, read as i64)
    f = sp(f)

    // --- std.math
    var t_ma: [u8; 5] = "math:"
    f = t(f, (&t_ma[0]) as u64, 5)
    f = z(f, math.abs(0 - 7))
    f = sp(f)
    f = z(f, math.min(3, 9))
    f = sp(f)
    f = z(f, math.max(3, 9))
    f = sp(f)
    f = z(f, math.clamp(12, 0, 10))
    f = sp(f)
    f = z(f, math.isqrt(17) as i64)
    f = sp(f)
    f = z(f, math.pow(2, 10))
    f = sp(f)
    f = z(f, math.sqrt(4.0) as i64)
    f = sp(f)
    f = z(f, (math.PI() * 1000.0) as i64)
    f = sp(f)
    f = z(f, (math.powi(2.0, 0 - 2) * 100.0) as i64)
    f = sp(f)

    // --- std.str: utf8 and atom
    var t_st: [u8; 4] = "str:"
    f = t(f, (&t_st[0]) as u64, 4)
    var b: str.Bytes = str.bytes_new()
    str.utf8_push_cp(&b, 8364) // U+20AC (Euro) -> 3 Oktette
    f = z(f, str.bytes_len(&b) as i64)
    f = sp(f)
    f = z(f, str.bytes_at(&b, 0) as i64) // 226 (0xE2)
    f = sp(f)
    str.bytes_free(&b)
    var ta: str.AtomTable = str.AtomTable {
        arena: 0 as *mut u8, arena_len: 0, arena_cap: 0,
        ents: 0 as *mut u8, count: 0, ents_cap: 0,
        buckets: 0 as *mut u8, nbuckets: 0,
    }
    str.atom_table_init(&ta)
    var nm: str.Bytes = str.bytes_new()
    str.bytes_push(&nm, 97 as u8)
    str.bytes_push(&nm, 98 as u8) // "ab"
    let a1: u32 = str.atom_intern(&ta, &nm)
    let a2: u32 = str.atom_intern(&ta, &nm)
    str.bytes_push(&nm, 99 as u8) // "abc"
    let a3: u32 = str.atom_intern(&ta, &nm)
    f = z(f, (a1 == a2) as i64)
    f = sp(f)
    f = z(f, (a1 == a3) as i64)
    f = sp(f)
    str.bytes_free(&nm)
    str.atom_free(&ta)

    // --- std.vec
    var t_ve: [u8; 4] = "vec:"
    f = t(f, (&t_ve[0]) as u64, 4)
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    vec_push[i32](&v, 3)
    f = z(f, (vec_at[i32](&v, 0) + vec_at[i32](&v, 1) + vec_at[i32](&v, 2)) as i64)
    f = sp(f)
    f = z(f, vec_len[i32](&v) as i64)
    f = sp(f)
    vec_free[i32](&v)

    // --- std.map
    var t_mp: [u8; 4] = "map:"
    f = t(f, (&t_mp[0]) as u64, 4)
    var m: Map[u64, u64] = map_new[u64, u64]()
    map_set[u64, u64](&m, 7, 77)
    var has: i64 = 0
    if map_has[u64, u64](&m, 7) {
        has = 1
    }
    f = z(f, has)
    f = sp(f)
    f = z(f, map_get[u64, u64](&m, 7) as i64)
    f = sp(f)
    map_free[u64, u64](&m)

    // --- std.num: strtod and bignum
    var t_nu: [u8; 4] = "num:"
    f = t(f, (&t_nu[0]) as u64, 4)
    var zt: [u8; 3] = "123"
    let zp: u64 = (&zt[0]) as u64
    var ws: [u8; 12288] = [0 as u8; 12288] // num.STRTOD_WS_BYTES
    let wp: u64 = (&ws[0]) as u64
    var consumed: usize = 0
    let bits: u64 = num.strtod(zp as *mut u8, 3, wp as *mut u8, &consumed)
    f = z(f, consumed as i64)
    f = sp(f)
    f = z(f, (bits == 4638355772470722560) as i64) // Bits von 123.0
    f = sp(f)
    let bm: *mut u8 = num.heap_alloc(num.BN_LIMBS * 4)
    var bn: num.Bn = num.Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    num.bn_init(&bn, bm, num.BN_LIMBS)
    num.bn_set_u64(&bn, 5)
    num.bn_add_small(&bn, 7)
    f = z(f, num.bn_limb(&bn, 0) as i64)
    f = sp(f)
    num.heap_free(bm, num.BN_LIMBS * 4)

    // --- std.mem: raw + rc
    var t_me: [u8; 4] = "mem:"
    f = t(f, (&t_me[0]) as u64, 4)
    let blk: u64 = mem.alloc(64)
    var raw_ok: i64 = 0
    if blk != 0 {
        raw_ok = 1
        mem.free(blk, 64)
    }
    f = z(f, raw_ok)
    f = sp(f)
    var h: rc.RcHeap = rc.RcHeap {
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
            0 as usize, 0 as usize, 0 as usize, 0 as usize],
        live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize,
    }
    if !mem.heap_init(&h, 65536 as usize) {
        return 90
    }
    var zv: RefCount[i64] = rc_empty[i64]()
    let okm: bool = rc_new[i64](&h, 42, &zv) catch false
    if !okm {
        return 91
    }
    f = z(f, rc_read[i64](zv) as i64)
    f = sp(f)
    f = z(f, rc_strong_number[i64](zv) as i64)
    f = sp(f)
    rc_free[i64](&h, &zv)
    f = z(f, mem.heap_live(&h) as i64)
    mem.heap_free(&h)

    var nl: [u8; 1] = "\n"
    f = t(f, (&nl[0]) as u64, 1)
    io.fmt_print(f)
    return 0
}
