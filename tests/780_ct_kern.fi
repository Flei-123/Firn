// expect_exit: 0
// CT-INTRINSICS IN DER KERNSPRACHE — der Test zur Runde 36 (docs/RUNDE36.md).
//
// Geprueft wird der ganze Weg in EINEM Programm:
//
//   * select(bedingung, a, b) auf Ganzzahlen — datenunabhaengig (cmov,
//     kein Sprung, SPEC §9.2)
//   * select auf Zeigern und u8-Werten — der Ergebnistyp ist der Zweigtyp
//   * secure_zero(zeiger, anzahl) nullt zuverlaessig und wird nie
//     wegoptimiert (SPEC §9.3, C3)
//   * barrier(x) als undurchschaubare Identitaet (SPEC §9.2)
//   * verschachtelt: select um barrier, barrier um select

fn main() -> i32 {
    // select auf i32
    var a: i32 = select(true, 40 as i32, 2 as i32)
    if a != 40 as i32 {
        return 1
    }
    a = select(false, 100 as i32, 7 as i32)
    if a != 7 as i32 {
        return 2
    }
    // select auf Zeigern
    var x: u8 = 11
    var y: u8 = 22
    let p: *u8 = select(x < y, &x, &y)
    if *p != 11 as u8 {
        return 3
    }
    // select auf u8
    let w: u8 = select(false, 1 as u8, 9 as u8)
    if w != 9 as u8 {
        return 4
    }
    // barrier ist die Identitaet
    let b: i32 = barrier(21 as i32)
    if b != 21 as i32 {
        return 5
    }
    // verschachtelt
    let v: i32 = select(barrier(b) > 20 as i32, barrier(3 as i32), 0 as i32)
    if v != 3 as i32 {
        return 6
    }
    // secure_zero nullt den ganzen Puffer
    var buf: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    secure_zero(&buf[0], 8 as usize)
    var i: usize = 0
    while i < 8 as usize {
        if buf[i] != 0 as u8 {
            return 7
        }
        i = i + 1 as usize
    }
    // secure_zero mit Teillaenge: der Rest bleibt stehen
    var buf2: [u8; 4] = [9, 9, 9, 9]
    secure_zero(&buf2[0], 2 as usize)
    if buf2[0] != 0 as u8 || buf2[1] != 0 as u8 {
        return 8
    }
    if buf2[2] != 9 as u8 || buf2[3] != 9 as u8 {
        return 9
    }
    return 0
}
