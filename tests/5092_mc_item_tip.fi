// expect_exit: 0
import std.rt
import mc.mc_tip_lines
import mc.mc_item_names
import mc.mc_item_tip

const LANG: str = "{\"item.minecraft.diamond_sword\":\"Diamond Sword\",\"item.minecraft.golden_apple\":\"Golden Apple\",\"enchantment.minecraft.sharpness\":\"Sharpness\",\"enchantment.minecraft.mending\":\"Mending\",\"enchantment.minecraft.binding_curse\":\"Curse of Binding\",\"enchantment.level.5\":\"V\",\"item.durability\":\"Durability: %s / %s\",\"item.unbreakable\":\"Unbreakable\",\"attribute.name.generic.attack_damage\":\"Attack Damage\",\"attribute.modifier.plus.0\":\"+%s %s\",\"item.modifiers.mainhand\":\"When in Main Hand:\"}"

fn line_is(t: *mut mc_tip_lines.TipLines, i: usize, want: str) -> bool {
    if mc_tip_lines.tl_len(t, i) != want.n { return false }
    return rt.mem_eq(mc_tip_lines.tl_text(t) + (mc_tip_lines.tl_off(t, i) as u64), want.p as u64, want.n)
}

fn line_rgb(t: *mut mc_tip_lines.TipLines, i: usize) -> i32 {
    return (rt.ld32(mc_tip_lines.tl_cols(t), mc_tip_lines.tl_off(t, i)) & 0xFFFFFF as u32) as i32
}

fn line_flag(t: *mut mc_tip_lines.TipLines, i: usize) -> u32 {
    return rt.ld8(mc_tip_lines.tl_flags(t), mc_tip_lines.tl_off(t, i)) as u32
}

fn build(t: *mut mc_tip_lines.TipLines, rec: str, item: str, protocol: i32, ench: str) {
    mc_tip_lines.tl_clear(t)
    mc_item_tip.tip_build(t, rec.p as u64, rec.n, item.p as u64, item.n, protocol, ench.p as u64, ench.n)
}

fn main() -> i32 {
    var t: mc_tip_lines.TipLines = mc_tip_lines.tl_new()
    build(&t, "", "golden_apple", 763, "")
    if mc_tip_lines.tl_count(&t) != 1 || !line_is(&t, 0, "Golden Apple") || line_rgb(&t, 0) != 0x55FFFF { return 1 }
    build(&t, "dummy", "golden_apple", 763, "")
    if !line_is(&t, 0, "Golden Apple") || line_rgb(&t, 0) != 0x55FFFF { return 2 }
    build(&t, "n{\"text\":\"Blade\"}\neminecraft:sharpness\t5\n", "diamond_sword", 763, "")
    if !line_is(&t, 0, "Blade") || !line_is(&t, 1, "Sharpness V") { return 3 }
    if line_rgb(&t, 0) != 0x55FFFF || (line_flag(&t, 0) & 2 as u32) == 0 as u32 { return 4 }
    if !mc_item_names.names_load(LANG.p as u64, LANG.n) { return 5 }
    build(&t, "", "golden_apple", 763, "")
    if !line_is(&t, 0, "Golden Apple") || line_rgb(&t, 0) != 0x55FFFF { return 6 }
    build(&t, "", "enchanted_golden_apple", 763, "")
    if line_rgb(&t, 0) != 0xFF55FF { return 7 }
    var rec: str = "n{\"text\":\"Blade\"}\nl{\"text\":\"Sharp \",\"extra\":[{\"text\":\"edge\",\"color\":\"red\"}]}\neminecraft:sharpness\t5\neminecraft:mending\t1\neminecraft:binding_curse\t1\nd6\nageneric.attack_damage\t700\t0\tmainhand\n"
    build(&t, rec, "diamond_sword", 763, "")
    if mc_tip_lines.tl_count(&t) != 9 { return 10 }
    if !line_is(&t, 0, "Blade") || line_rgb(&t, 0) != 0x55FFFF { return 11 }
    if !line_is(&t, 1, "Sharpness V") || line_rgb(&t, 1) != 0xAAAAAA { return 12 }
    if !line_is(&t, 2, "Mending") || !line_is(&t, 3, "Curse of Binding") || line_rgb(&t, 3) != 0xFF5555 { return 13 }
    if !line_is(&t, 4, "Sharp edge") || line_rgb(&t, 4) != 0xAA00AA || (line_flag(&t, 4) & 2 as u32) == 0 as u32 { return 14 }
    if mc_tip_lines.tl_len(&t, 5) != 0 || !line_is(&t, 6, "When in Main Hand:") { return 15 }
    if !line_is(&t, 7, "+7 Attack Damage") || line_rgb(&t, 7) != 0x5555FF { return 16 }
    if !line_is(&t, 8, "Durability: 1555 / 1561") { return 17 }
    var edge: usize = mc_tip_lines.tl_off(&t, 4) + 6
    if (rt.ld32(mc_tip_lines.tl_cols(&t), edge) & 0xFFFFFF as u32) != 0xFF5555 as u32 { return 18 }
    build(&t, "u1\nd6\n", "diamond_sword", 763, "")
    if mc_tip_lines.tl_count(&t) != 2 || !line_is(&t, 1, "Unbreakable") || line_rgb(&t, 1) != 0x5555FF { return 20 }
    build(&t, "E13\t3\nS37\t1\n", "enchanted_book", 766, "")
    if mc_tip_lines.tl_count(&t) != 3 || !line_is(&t, 1, "Sharpness III") || !line_is(&t, 2, "Mending") { return 21 }
    if line_rgb(&t, 0) != 0x55FFFF { return 22 }
    build(&t, "E1\t2\n", "iron_pickaxe", 770, "minecraft:aqua\nminecraft:sharpness\n")
    if !line_is(&t, 1, "Sharpness II") { return 23 }
    build(&t, "E7\t2\n", "iron_pickaxe", 770, "minecraft:aqua\nminecraft:sharpness\n")
    if mc_tip_lines.tl_count(&t) != 1 { return 24 }
    build(&t, "d3\n", "wooden_sword", 763, "")
    if !line_is(&t, 1, "Durability: 56 / 59") { return 25 }
    build(&t, "d3\n", "stone", 763, "")
    if mc_tip_lines.tl_count(&t) != 1 { return 26 }
    mc_item_names.names_release()
    build(&t, "", "oak_planks", 763, "")
    if !line_is(&t, 0, "Oak Planks") { return 30 }
    build(&t, "eminecraft:fortune\t3\nd0\n", "iron_pickaxe", 763, "")
    if !line_is(&t, 1, "Fortune III") || !line_is(&t, 2, "Durability: 250 / 250") { return 31 }
    mc_tip_lines.tl_free(&t)
    return 0
}
