// expect_exit: 0
fn fib(n: u32) -> u64 {
    if n < 2 {
        return n as u64
    }
    return fib(n - 1) + fib(n - 2)
}

fn tri(n: u32) -> u64 {
    if n < 3 {
        return n as u64
    }
    return tri(n - 1) + tri(n - 3) + 1
}

fn ping(n: u32) -> u64 {
    if n < 2 {
        return n as u64
    }
    return pong(n - 1) + pong(n - 2)
}

fn pong(n: u32) -> u64 {
    if n < 2 {
        return n as u64 + 7
    }
    return ping(n - 1) + ping(n - 2)
}

fn simd_sum(a: f64, b: f64) -> f64 {
    var v: [f64; 4] = [a, b, a + b, a - b]
    var s: f64 = 0.0
    var i: usize = 0
    while i < 4 {
        s = s + v[i]
        i = i + 1
    }
    return s
}

fn mixed(n: u32) -> f64 {
    if n < 2 {
        return simd_sum(n as f64, 1.0)
    }
    return mixed(n - 1) + mixed(n - 2)
}

fn pick(a: u64, b: u64, flag: u64) -> u64 {
    var x: u64 = a
    if flag > 3 {
        x = b
    }
    if flag == 9 {
        return x * 3 + fib(10)
    }
    return x + a
}

fn main() -> i32 {
    if fib(25) != 75025 {
        return 1
    }
    if fib(1) != 1 {
        return 2
    }
    if fib(0) != 0 {
        return 3
    }
    if tri(10) != 59 {
        return 4
    }
    if ping(12) != 956 {
        return 5
    }
    if mixed(10) != 254.0 {
        return 6
    }
    if pick(5, 7, 1) != 10 {
        return 7
    }
    if pick(5, 7, 5) != 12 {
        return 8
    }
    if pick(5, 7, 9) != 21 + 55 {
        return 9
    }
    return 0
}
