// expect_exit: 16
// r14: array index checks proven away by the range analysis (masks,
// remainders, flat 2D indices under loop guards, an index already checked
// against a shorter array) must still compute the same values.
fn feed(x: usize) -> usize {
    return x
}

fn main() -> i32 {
    var t: [i32; 32] = [0; 32]
    var u: [i32; 64] = [0; 64]
    var i: usize = 0
    while i < 4 {
        var j: usize = 0
        while j < 8 {
            t[i * 8 + j] = (i * 10 + j) as i32
            j = j + 1
        }
        i = i + 1
    }
    var h: [i32; 16] = [0; 16]
    var x: usize = 0
    while x < 1000 {
        h[x & 15] = h[x & 15] + 1
        h[(x * 7) % 16] = h[(x * 7) % 16] + 2
        x = x + 1
    }
    let k: usize = feed(21)
    t[k] = t[k] + 5
    u[k] = u[k] + t[k]
    var s: i32 = 0
    var n: usize = 0
    while n < 32 {
        s = s + t[n]
        n = n + 1
    }
    return (s + h[3] + u[21]) % 100
}
