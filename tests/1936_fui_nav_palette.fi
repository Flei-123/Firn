// expect_exit: 0
import fui.nav_palette
import fui.action
import std.rt

static mut failures: i32 = 0
static mut ran: u64 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn run_it(ud: u64, cx: *mut action.ActCtx) {
    ran = ran + ud
}

fn no(ud: u64, cx: *mut action.ActCtx) -> bool {
    return false
}

fn yes(ud: u64, cx: *mut action.ActCtx) -> bool {
    return true
}

fn same(a: str, b: str) -> bool {
    return action.str_eq(a, b)
}

fn main() -> i32 {
    var reg: action.Actions = action.actions_new()
    let a0: usize = action.act_add(&reg, "new_mail", "New mail", run_it, 1)
    let a1: usize = action.act_add(&reg, "new_meeting", "Plan meeting", run_it, 10)
    let a2: usize = action.act_add(&reg, "new_chat", "New chat", run_it, 100)
    let a3: usize = action.act_add(&reg, "secret", "Hidden thing", run_it, 1000)
    let a4: usize = action.act_add(&reg, "locked", "Locked action", run_it, 10000)
    action.act_set_shortcut(&reg, a0, 78 as u32, action.MOD_CTRL | action.MOD_SHIFT)
    action.act_set_visible(&reg, a3, no)
    action.act_set_enabled(&reg, a4, no)
    var cx: action.ActCtx = action.actx_new(0)

    var p: nav_palette.Pal = nav_palette.npal_new()
    check("added", nav_palette.npal_add_actions(&p, &reg, &cx) == 5)
    check("route", nav_palette.npal_add_route(&p, "Go to Inbox", "fleitec", "fleitec://inbox"))
    check("route needs title", !nav_palette.npal_add_route(&p, "", "", "fleitec://inbox"))
    check("closed", !nav_palette.npal_is_open(&p))
    nav_palette.npal_open(&p)
    check("open", nav_palette.npal_is_open(&p))
    check("all visible entries", nav_palette.npal_count(&p) == 5)
    check("order kept", same(nav_palette.npal_title(&p, 0), "New mail") && same(nav_palette.npal_title(&p, 4), "Go to Inbox"))
    check("hidden action not listed", !same(nav_palette.npal_title(&p, 2), "Hidden thing") && !same(nav_palette.npal_title(&p, 3), "Hidden thing"))

    nav_palette.npal_type(&p, 110 as u8)
    nav_palette.npal_type(&p, 99 as u8)
    check("filter nc", nav_palette.npal_count(&p) >= 1 && same(nav_palette.npal_title(&p, 0), "New chat"))
    check("query", nav_palette.npal_query(&p).n == 2)
    var pos: [u32; 8] = [0 as u32; 8]
    let np: usize = nav_palette.npal_positions(&p, 0, (&pos[0]) as *mut u32, 8)
    check("positions", np == 2 && pos[0] == 0 as u32 && pos[1] == 4 as u32)

    nav_palette.npal_set_query(&p, "inbox")
    check("filter route", nav_palette.npal_count(&p) == 1 && nav_palette.npal_is_route(&p, 0))
    var pk: nav_palette.Pick = nav_palette.npal_pick(&p)
    check("pick route", pk.ok && pk.kind == nav_palette.NP_ROUTE && same(pk.url, "fleitec://inbox"))

    nav_palette.npal_set_query(&p, "zzzz")
    check("no match", nav_palette.npal_count(&p) == 0 && !nav_palette.npal_pick(&p).ok && nav_palette.npal_selected(&p) == nav_palette.NP_NONE)
    nav_palette.npal_move(&p, 1)

    nav_palette.npal_set_query(&p, "new")
    check("new matches", nav_palette.npal_count(&p) == 2)
    check("selected starts at 0", nav_palette.npal_selected(&p) == 0)
    nav_palette.npal_move(&p, 1)
    check("move down", nav_palette.npal_selected(&p) == 1)
    nav_palette.npal_move(&p, 1)
    check("wraps down", nav_palette.npal_selected(&p) == 0)
    nav_palette.npal_move(&p, -1)
    check("wraps up", nav_palette.npal_selected(&p) == 1)

    nav_palette.npal_set_query(&p, "mail")
    pk = nav_palette.npal_pick(&p)
    check("pick action", pk.ok && pk.kind == nav_palette.NP_ACTION && pk.action == a0)
    check("run via registry", action.act_run(&reg, pk.action, &cx) && ran == 1)
    var sc: [u8; 24] = [0 as u8; 24]
    let sn: usize = nav_palette.npal_shortcut_text(&p, 0, (&sc[0]) as *mut u8, 24)
    check("shortcut text", sn > 0)

    nav_palette.npal_set_query(&p, "locked")
    check("disabled listed", nav_palette.npal_count(&p) == 1 && !nav_palette.npal_enabled(&p, 0))
    check("disabled cannot be picked", !nav_palette.npal_pick(&p).ok)
    check("enter on disabled is handled only", nav_palette.npal_key(&p, action.SK_ENTER, 0 as u32) == nav_palette.NK_HANDLED)

    nav_palette.npal_set_query(&p, "")
    check("empty query lists all", nav_palette.npal_count(&p) == 5)
    check("backspace on empty", !nav_palette.npal_backspace(&p))
    nav_palette.npal_type(&p, 112 as u8)
    nav_palette.npal_type(&p, 108 as u8)
    check("plan", nav_palette.npal_count(&p) >= 1 && same(nav_palette.npal_title(&p, 0), "Plan meeting"))
    nav_palette.npal_backspace(&p)
    check("backspace", nav_palette.npal_query(&p).n == 1)
    check("type rejects control bytes", !nav_palette.npal_type(&p, 7 as u8) && nav_palette.npal_query(&p).n == 1)

    nav_palette.npal_close(&p)
    check("typing while closed", !nav_palette.npal_type(&p, 97 as u8))
    check("keys while closed ignored", nav_palette.npal_key(&p, action.SK_DOWN, 0 as u32) == nav_palette.NK_IGNORED)
    check("toggle detect ctrl k", nav_palette.npal_toggle_key(75 as u32, action.MOD_CTRL) && nav_palette.npal_toggle_key(107 as u32, action.MOD_CTRL) && nav_palette.npal_toggle_key(75 as u32, action.MOD_META))
    check("toggle detect plain k", !nav_palette.npal_toggle_key(75 as u32, 0 as u32) && !nav_palette.npal_toggle_key(76 as u32, action.MOD_CTRL))
    check("ctrl k opens", nav_palette.npal_key(&p, 75 as u32, action.MOD_CTRL) == nav_palette.NK_HANDLED && nav_palette.npal_is_open(&p) && nav_palette.npal_query(&p).n == 0)
    check("down handled", nav_palette.npal_key(&p, action.SK_DOWN, 0 as u32) == nav_palette.NK_HANDLED && nav_palette.npal_selected(&p) == 1)
    check("up handled", nav_palette.npal_key(&p, action.SK_UP, 0 as u32) == nav_palette.NK_HANDLED && nav_palette.npal_selected(&p) == 0)
    check("enter picks", nav_palette.npal_key(&p, action.SK_ENTER, 0 as u32) == nav_palette.NK_PICK)
    check("escape closes", nav_palette.npal_key(&p, action.SK_ESCAPE, 0 as u32) == nav_palette.NK_CLOSED && !nav_palette.npal_is_open(&p))
    nav_palette.npal_key(&p, 75 as u32, action.MOD_CTRL)
    check("ctrl k closes", nav_palette.npal_key(&p, 75 as u32, action.MOD_CTRL) == nav_palette.NK_CLOSED && !nav_palette.npal_is_open(&p))

    nav_palette.npal_set_query(&p, "locked")
    action.act_set_enabled(&reg, a4, yes)
    nav_palette.npal_refresh_actions(&p, &reg, &cx)
    check("refresh enables", nav_palette.npal_enabled(&p, 0) && nav_palette.npal_pick(&p).ok)
    action.act_set_visible(&reg, a3, yes)
    nav_palette.npal_refresh_actions(&p, &reg, &cx)
    nav_palette.npal_set_query(&p, "hidden")
    check("refresh shows", nav_palette.npal_count(&p) == 1)
    nav_palette.npal_clear(&p)
    check("clear", nav_palette.npal_count(&p) == 0)

    if failures == 0 {
        rt.write_everything(1, "ok\n".p as u64, 3)
    }
    return failures
}
