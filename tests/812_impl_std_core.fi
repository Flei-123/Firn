// expect_out: Hallo, Welt, Firn | HALLO, WELT, FIRN | ok
// tests/812_impl_std_core.fi -- `std.str` WITH METHODS (round 45).
//
// The same as in tests/800_std_str_core.fi, only in the notation that
// `impl` makes possible:
//
//     str.trim(source)            ->   source.trim()
//     str.find(core, world)       ->   core.find(world)
//     str.bytes_push(&b, 65)      ->   b.add(65 as u8)
//
// The methods are pure SHELLS over exactly these free functions
// (lib/str/std_impl.fi) -- which makes this test at the same time the proof
// that the change does not alter the behaviour: both ways are computed side
// by side here and have to yield the same.
import std.io
import std.str

fn main() -> i32 {
    var raw: [u8; 22] = "  Hallo, Welt, Firn  \0"
    var world_c: [u8; 5] = "Welt\0"
    var comma_c: [u8; 2] = ",\0"
    var hello_c: [u8; 6] = "Hallo\0"
    var firn_c: [u8; 5] = "Firn\0"

    let source: str.Span = str.span_of_c((&raw[0]) as *mut u8)
    let world: str.Span = str.span_of_c((&world_c[0]) as *mut u8)
    let hello: str.Span = str.span_of_c((&hello_c[0]) as *mut u8)
    let firn: str.Span = str.span_of_c((&firn_c[0]) as *mut u8)

    // --- span: method and free function have to yield the same
    let core: str.Span = source.trim()
    if core.length() != str.length(str.trim(source)) {
        return 10
    }
    if core.length() != 17 {
        return 11
    }
    if core.find(world) != str.find(core, world) {
        return 12
    }
    if core.find(world) != 7 {
        return 13
    }
    if !core.starts_with(hello) {
        return 14
    }
    if !core.ends_with(firn) {
        return 15
    }
    if !core.contains(world) {
        return 16
    }
    if core.chars(0) != 72 as u8 {
        return 17
    }
    if core.part(0, 5).length() != 5 {
        return 18
    }
    if !core.part(0, 5).equal(hello) {
        return 19
    }
    if core.ab(7).length() != 10 {
        return 20
    }
    if core.to(5).compare(hello) != 0 {
        return 21
    }
    if core.utf8_char() != 17 {
        return 22
    }
    let commas: usize = core.count_char(44 as u8)
    if commas != 2 {
        return 23
    }

    // --- bytes: writing methods
    var b: str.Bytes = str.bytes_new()
    b.append(core)
    if b.length() != 17 {
        return 24
    }
    if b.at(0) != 72 as u8 {
        return 25
    }
    if !b.span().equal(core) {
        return 26
    }
    if !b.is_text() {
        return 27
    }
    b.write(1)

    var split: [u8; 4] = " | \0"
    io.print_bytes((&split[0]) as u64, 3)

    // upper case, in place -- and printed again
    b.big_here()
    b.write(1)
    io.print_bytes((&split[0]) as u64, 3)

    b.clear()
    if b.length() != 0 {
        return 28
    }
    b.add(65 as u8)
    b.add(66 as u8)
    if b.length() != 2 || b.at(1) != 66 as u8 {
        return 29
    }
    b.free()

    // --- Str16: the same shell over the WTF-16 side
    var s: str.Str16 = str.str16_new()
    s.add(72 as u16)
    s.add_cp(0x1F600 as u32)
    if s.length() != 3 {
        return 30
    }
    if s.at(0) != 72 as u16 {
        return 31
    }
    s.set_at(0, 73 as u16)
    if s.at(0) != 73 as u16 {
        return 32
    }
    s.clear()
    if s.length() != 0 {
        return 33
    }
    s.free()

    var out: str.Bytes = str.bytes_new()
    str.append_char(&out, 111 as u8)
    str.append_char(&out, 107 as u8)
    out.write(1)
    out.free()
    return 0
}
