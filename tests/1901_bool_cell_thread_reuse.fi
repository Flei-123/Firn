// expect_exit: 45
// ROUND PUSH -- a threaded bool cell whose load is read again later.
//
// `threading.rs::thread_bool_cells` (round 51) makes every predecessor of a
// fork block (`%v = load.bool %cell ; brcond %v, T, E`) jump past it. The
// fork block turns unreachable and dce removes it -- with the load. When
// the load had meanwhile become the value of the VARIABLE (`cse`/`mem2reg`
// reuse it for the later reads of `fr` below), those reads named a value
// defined in a dead block, and the register allocator handed them whatever
// the register held: `fr` came out false for good although `probe`
// returned true. The same rule round FIRN-LUECKEN gave the phi version
// (`1633_bool_phi_thread.fi`): the loaded value may be read by nothing but
// the fork's own `brcond`.
//
// Found in FIRNCHAT's window loop on Android: `let fr = window.in_front(f)`,
// `if fr && !front`, `if fr != front`, `front = fr` -- a tapped
// notification was never noticed in release-safe, dev was right.
// Transitions of 0..11 through (3, 8): 0 (true -> false), 4 (up), 8 (down):
// 100 + 101 + 100 = 301, exit code 301 mod 256 = 45. Miscompiled: 104.
static mut G_N: i64 = 0

fn probe(x: i64) -> bool {
    G_N = G_N + 1
    return x > 3 && x < 8
}

fn main() -> i32 {
    var front: bool = true
    var hits: i64 = 0
    var i: i64 = 0
    while i < 12 {
        let fr: bool = probe(i)
        if fr && !front {
            hits = hits + 1
        }
        if fr != front {
            hits = hits + 100
        }
        front = fr
        i = i + 1
    }
    return (hits % 256) as i32
}
