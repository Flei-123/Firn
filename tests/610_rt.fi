// expect_exit: 0
// `lib/rt/` — Laufzeitkern in Firn (docs/SELBSTHOSTING.md §4, Punkte 1, 5, 12):
// Allokator, wachsender Puffer, Zahlformatierung, Datei-Ein-/Ausgabe.
// Zusammen sind das die Bausteine, ohne die Stufe 1 nicht anfangen kann.
import modules.rt

fn main() -> i32 {
    // --- Allokator
    let p: u64 = rt.heap_alloc(4096)
    if p == 0 {
        return 1
    }
    rt.st64(p, 0, 12345)
    if rt.ld64(p, 0) != 12345 {
        return 2
    }
    rt.mem_set(p, 7 as u8, 16)
    if rt.ld8(p, 15) != 7 as u8 {
        return 3
    }
    let q: u64 = rt.heap_alloc(4096)
    if q == 0 {
        return 4
    }
    rt.mem_copy(q, p, 16)
    if !rt.mem_eq(p, q, 16) {
        return 5
    }
    rt.st8(q, 3, 9 as u8)
    if rt.mem_eq(p, q, 16) {
        return 6
    }
    rt.heap_free(q, 4096)

    // --- Puffer: wachsen ueber viele Verdopplungen
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 5000 {
        rt.buf_push(&b, (i % 251) as u8)
        i = i + 1
    }
    if rt.buf_len(&b) != 5000 {
        return 7
    }
    if rt.buf_at(&b, 0) != 0 as u8 {
        return 8
    }
    if rt.buf_at(&b, 4999) != ((4999 as u64) % 251) as u8 {
        return 9
    }
    // jenseits des Endes: 0, kein Absturz
    if rt.buf_at(&b, 99999) != 0 as u8 {
        return 10
    }

    // --- Zahlen -> Text
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&t, 0)
    rt.buf_push_dec_u64(&t, 1234567890)
    rt.buf_push_dec_i64(&t, 0 - 42)
    rt.buf_push_hex_u64(&t, 48879, 4)
    // "0" "1234567890" "-42" "beef"
    if rt.buf_len(&t) != 1 + 10 + 3 + 4 {
        return 11
    }
    if rt.buf_at(&t, 0) != 48 as u8 {
        return 12
    }
    if rt.buf_at(&t, 11) != 45 as u8 {
        return 13
    }
    if rt.buf_at(&t, 14) != 98 as u8 {
        return 14
    }
    if rt.buf_at(&t, 17) != 102 as u8 {
        return 15
    }

    // --- Datei lesen: der Compiler muss seine Quelle lesen koennen
    var path: [u8; 24] = "tests/data/rt_probe.txt\0"
    var content: rt.Buf = rt.buf_new()
    if !rt.read_file((&path[0]) as u64, &content) {
        return 16
    }
    if rt.buf_len(&content) != 12 {
        return 17
    }
    // "Firn liest.\n"
    if rt.buf_at(&content, 0) != 70 as u8 {
        return 18
    }
    if rt.buf_at(&content, 11) != 10 as u8 {
        return 19
    }

    // --- und schreiben
    if !rt.write_everything(1, rt.buf_ptr(&content), rt.buf_len(&content)) {
        return 20
    }

    rt.buf_free(&b)
    rt.buf_free(&t)
    rt.buf_free(&content)
    rt.heap_free(p, 4096)
    return 0
}
