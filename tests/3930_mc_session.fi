// expect_exit: 0
// tests/3930_mc_session.fi -- r39: FleiLauncher -> client hand-off, the session file parser (lib/mc/mc_session.fi).
import std.rt
import std.core
import mc.mc_session

static mut g_fail: i32 = 0

fn check(ok: bool, msg: str) {
    if !ok {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_bytes(&o, msg.p as u64, msg.n)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn val_is(p: u64, n: usize, key: str, want: str) -> bool {
    var t: rt.Buf = rt.buf_new()
    var ok: bool = mc_session.session_value(p, n, key, &t) && rt.buf_len(&t) == want.length()
    var i: usize = 0
    while ok && i < want.length() {
        if rt.ld8(rt.buf_ptr(&t), i) != want.chars(i) {
            ok = false
        }
        i = i + 1
    }
    rt.buf_free(&t)
    return ok
}

fn main() -> i32 {
    let txt: str = "# launcher session\r\nhost=127.0.0.1\r\nport=25565\nname=Steve\nuuid=0123456789abcdef0123456789abcdef\nmc_token=eyJ.abc=def\n#name=Hidden\nprotocol=763\nview=x\nempty=\nlast=1"
    let p: u64 = txt.p as u64
    let n: usize = txt.length()
    check(val_is(p, n, "host", "127.0.0.1"), "host (CRLF line)")
    check(val_is(p, n, "port", "25565"), "port")
    check(val_is(p, n, "name", "Steve"), "name: comment line must not match")
    check(val_is(p, n, "mc_token", "eyJ.abc=def"), "token with '=' inside")
    check(val_is(p, n, "last", "1"), "last line without newline")
    var t: rt.Buf = rt.buf_new()
    check(!mc_session.session_value(p, n, "nope", &t), "absent key")
    check(!mc_session.session_value(p, n, "hos", &t), "prefix of a key is no key")
    check(!mc_session.session_value(p, n, "hostx", &t), "longer key")
    rt.buf_free(&t)
    check(mc_session.session_int(p, n, "port", 0 - 1) == 25565, "int port")
    check(mc_session.session_int(p, n, "protocol", 0 - 1) == 763, "int protocol")
    check(mc_session.session_int(p, n, "view", 6) == 6, "int fallback on garbage")
    check(mc_session.session_int(p, n, "empty", 7) == 7, "int fallback on empty")
    check(mc_session.session_int(p, n, "nope", 9) == 9, "int fallback on absent")
    check(mc_session.session_has(p, n, "mc_token"), "has token")
    check(!mc_session.session_has(p, n, "empty"), "empty value is not present")
    check(!mc_session.session_has(p, n, "nope"), "absent is not present")
    // wipe
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, p, n)
    mc_session.session_wipe(&b)
    var zero: bool = true
    var i: usize = 0
    while i < rt.buf_len(&b) {
        if rt.ld8(rt.buf_ptr(&b), i) != 0 as u8 {
            zero = false
        }
        i = i + 1
    }
    check(zero, "wipe zeroes the text")
    rt.buf_free(&b)
    // load: file + missing file
    var f: rt.Buf = rt.buf_new()
    check(!mc_session.session_load("/nonexistent/mc_session_none\0".p as u64, &f), "missing file")
    rt.buf_free(&f)
    return g_fail
}
