// expect_exit: 0
import jobs.jobs
import scene3d.render
import scene3d.scene
import scene3d.camera
import scene3d.surface
import scene3d.vec3
import scene3d.material
import scene3d.mesh
import scene3d.geom

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0
}

fn add_quad(m: *mut mesh.Mesh, x0: f64, y0: f64, x1: f64, y1: f64, z: f64) {
    let n: vec3.V3 = vec3.v3(0.0, 0.0, 1.0)
    let a: u32 = mesh.mesh_add_vertex(m, vec3.v3(x0, y0, z), n, 0.0, 0.0)
    let b: u32 = mesh.mesh_add_vertex(m, vec3.v3(x1, y0, z), n, 1.0, 0.0)
    let c: u32 = mesh.mesh_add_vertex(m, vec3.v3(x1, y1, z), n, 1.0, 1.0)
    let d: u32 = mesh.mesh_add_vertex(m, vec3.v3(x0, y1, z), n, 0.0, 1.0)
    mesh.mesh_add_quad(m, a, b, c, d)
}

fn glass(sc: *mut scene.Scene, c: u32, a: f64) -> i32 {
    var m: material.Material = material.mat_with_opacity(material.mat_unlit(vec3.rgb_hex(c)), a)
    m.double_sided = true
    return scene.scene_add_material(sc, m)
}

fn base_scene() -> scene.Scene {
    var sc: scene.Scene = scene.scene_new()
    sc.bg_top = vec3.rgb_hex(0x303030)
    sc.bg_bottom = vec3.rgb_hex(0x303030)
    return sc
}

fn plate(sc: *mut scene.Scene, x0: f64, x1: f64, z: f64, mat: i32, order: i32) {
    var m: mesh.Mesh = mesh.mesh_new()
    add_quad(&m, x0, 0.0 - 1.5, x1, 1.5, z)
    let n: i32 = scene.scene_add_mesh_node(sc, 0 - 1, scene.scene_add_mesh(sc, m), mat)
    scene.node_set_render_order(scene.scene_node(sc, n), order)
}

fn plates(flip: bool, forced: bool) -> scene.Scene {
    var sc: scene.Scene = base_scene()
    let ra: i32 = glass(&sc, 0xff2020, 0.5)
    let rb: i32 = glass(&sc, 0x2020ff, 0.5)
    var oa: i32 = 0
    var ob: i32 = 0
    if forced { oa = 0 - 1 }
    if flip {
        plate(&sc, 0.0 - 0.4, 2.0, 0.0, rb, ob)
        plate(&sc, 0.0 - 2.0, 0.4, 1.0, ra, oa)
    } else {
        plate(&sc, 0.0 - 2.0, 0.4, 1.0, ra, oa)
        plate(&sc, 0.0 - 0.4, 2.0, 0.0, rb, ob)
    }
    return sc
}

fn ball(sc: *mut scene.Scene, r: f64, mat: i32, group: i32) {
    let n: i32 = scene.scene_add_mesh_node(sc, 0 - 1, scene.scene_add_mesh(sc, geom.geom_sphere(r, 16, 12)), mat)
    scene.node_set_sort_group(scene.scene_node(sc, n), group)
}

fn balls(flip: bool, grouped: bool) -> scene.Scene {
    var sc: scene.Scene = base_scene()
    let ro: i32 = glass(&sc, 0xff4040, 0.4)
    let ri: i32 = glass(&sc, 0x40ff40, 0.4)
    var g: i32 = 0 - 1
    if grouped { g = 3 }
    if flip {
        ball(&sc, 1.0, ri, g)
        ball(&sc, 2.0, ro, g)
    } else {
        ball(&sc, 2.0, ro, g)
        ball(&sc, 1.0, ri, g)
    }
    return sc
}

fn shot(sc: *mut scene.Scene, threads: i32, y: f64, z: f64) -> surface.Surface {
    var cam: camera.Camera = camera.cam_new(64, 48)
    cam.pos = vec3.v3(0.0, y, z)
    var rd: render.Renderer = render.renderer_new(64, 48, 2, threads)
    var out: surface.Surface = surface.surface_new(64, 48)
    render.render(&rd, sc, &cam, &out)
    render.renderer_free(&rd)
    return out
}

fn same(a: *mut surface.Surface, b: *mut surface.Surface) -> bool {
    var i: i32 = 0
    while i < 64 * 48 {
        if surface.surface_get(a, i % 64, i / 64) != surface.surface_get(b, i % 64, i / 64) { return false }
        i = i + 1
    }
    return true
}

fn chan(p: u32, c: i32) -> i32 {
    return ((p >> ((c * 8) as u32)) & 255 as u32) as i32
}

fn pair_check(a: *mut scene.Scene, b: *mut scene.Scene) -> bool {
    var sa: surface.Surface = shot(a, 0, 0.0, 10.0)
    var sb: surface.Surface = shot(b, 3, 0.0, 10.0)
    let ok: bool = same(&sa, &sb)
    surface.surface_free(&sa)
    surface.surface_free(&sb)
    return ok
}

fn main(start: u64) -> i32 {
    var code: i32 = 0
    var p1: scene.Scene = plates(false, false)
    var p2: scene.Scene = plates(true, false)
    if pair_check(&p1, &p2) == false { code = 1 }
    var f1: scene.Scene = plates(false, true)
    var f2: scene.Scene = plates(true, true)
    if code == 0 && pair_check(&f1, &f2) == false { code = 2 }
    if code == 0 && pair_check(&p1, &f1) { code = 3 }
    var g1: scene.Scene = balls(false, true)
    var g2: scene.Scene = balls(true, true)
    var u1: scene.Scene = balls(false, false)
    var u2: scene.Scene = balls(true, false)
    if code == 0 && pair_check(&u1, &u2) == false { code = 4 }
    if code == 0 && pair_check(&g1, &g2) == false { code = 5 }
    if code == 0 && pair_check(&g1, &u1) { code = 6 }
    var t0: surface.Surface = shot(&g1, 0, 0.0, 10.0)
    var t1: surface.Surface = shot(&g1, 1, 0.0, 10.0)
    var t3: surface.Surface = shot(&g1, 3, 0.0, 10.0)
    var t7: surface.Surface = shot(&g1, 7, 0.0, 10.0)
    if code == 0 && (same(&t0, &t1) == false || same(&t0, &t3) == false || same(&t0, &t7) == false) { code = 7 }
    surface.surface_free(&t0)
    surface.surface_free(&t1)
    surface.surface_free(&t3)
    surface.surface_free(&t7)
    var tx: scene.Scene = base_scene()
    let tid: i32 = scene.scene_add_texture(&tx, 8, 1)
    var i: i32 = 0
    while i < 8 {
        var px: u32 = 0 as u32
        if i >= 4 { px = 0xff0000ff as u32 }
        surface.surface_set(scene.scene_texture(&tx, tid), i, 0, px)
        i = i + 1
    }
    var qm: mesh.Mesh = mesh.mesh_new()
    add_quad(&qm, 0.0 - 2.0, 0.0 - 2.0, 2.0, 2.0, 0.0)
    scene.scene_add_mesh_node(&tx, 0 - 1, scene.scene_add_mesh(&tx, qm), scene.scene_add_material(&tx, material.mat_textured_alpha(tid)))
    var ts: surface.Surface = shot(&tx, 3, 0.0, 10.0)
    var tq: surface.Surface = shot(&tx, 0, 0.0, 10.0)
    if code == 0 && same(&ts, &tq) == false { code = 8 }
    if code == 0 && surface.surface_get(&ts, 23, 24) != surface.surface_get(&ts, 1, 1) { code = 9 }
    let rp: u32 = surface.surface_get(&ts, 41, 24)
    if code == 0 && (chan(rp, 0) < 200 || chan(rp, 1) > 30) { code = 10 }
    surface.surface_free(&ts)
    surface.surface_free(&tq)
    var fl: scene.Scene = base_scene()
    var fm: mesh.Mesh = mesh.mesh_new()
    let n: vec3.V3 = vec3.v3(0.0, 1.0, 0.0)
    let a: u32 = mesh.mesh_add_vertex(&fm, vec3.v3(0.0 - 50.0, 0.0 - 1.0, 50.0), n, 0.0, 0.0)
    let b: u32 = mesh.mesh_add_vertex(&fm, vec3.v3(50.0, 0.0 - 1.0, 50.0), n, 1.0, 0.0)
    let c: u32 = mesh.mesh_add_vertex(&fm, vec3.v3(50.0, 0.0 - 1.0, 0.0 - 50.0), n, 1.0, 1.0)
    let d: u32 = mesh.mesh_add_vertex(&fm, vec3.v3(0.0 - 50.0, 0.0 - 1.0, 0.0 - 50.0), n, 0.0, 1.0)
    mesh.mesh_add_quad(&fm, a, b, c, d)
    scene.scene_add_mesh_node(&fl, 0 - 1, scene.scene_add_mesh(&fl, fm), scene.scene_add_material(&fl, material.mat_unlit(vec3.v3(0.0, 1.0, 0.0))))
    var fa: surface.Surface = shot(&fl, 0, 0.0, 5.0)
    var fb: surface.Surface = shot(&fl, 3, 0.0, 5.0)
    if code == 0 && same(&fa, &fb) == false { code = 11 }
    let gp: u32 = surface.surface_get(&fa, 32, 47)
    if code == 0 && (chan(gp, 1) < 250 || chan(gp, 0) > 5) { code = 12 }
    surface.surface_free(&fa)
    surface.surface_free(&fb)
    scene.scene_free(&p1)
    scene.scene_free(&p2)
    scene.scene_free(&f1)
    scene.scene_free(&f2)
    scene.scene_free(&g1)
    scene.scene_free(&g2)
    scene.scene_free(&u1)
    scene.scene_free(&u2)
    scene.scene_free(&tx)
    scene.scene_free(&fl)
    return code
}
