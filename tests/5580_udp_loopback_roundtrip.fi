// expect_exit: 0
// tests/5580_udp_loopback_roundtrip.fi -- udp_sendto/udp_recvfrom over 127.0.0.1 on Linux and Windows.
import std.rt
import std.testkit
import net.udp

fn work() -> bool {
    let rx: i64 = udp.udp_open()
    testkit.check(rx >= 0, "receiver socket opens")
    testkit.check(udp.udp_bind(rx, 2130706433 as u32, 0 as u16) == 0, "receiver binds")
    testkit.check(udp.udp_set_timeout(rx, 2000 as u64) == 0, "receive timeout set")
    let port: i64 = udp.udp_local_port(rx)
    testkit.check(port > 0, "receiver has a port")
    let tx: i64 = udp.udp_open()
    testkit.check(tx >= 0, "sender socket opens")
    var msg: [u8; 5] = [104, 101, 108, 108, 111]
    let sent: i64 = udp.udp_sendto(tx, (&msg[0]) as u64, 5 as usize, 2130706433 as u32, port as u16)
    testkit.check(sent == 5, "sendto delivers 5 octets")
    var buf: [u8; 16] = [0; 16]
    var from_addr: u32 = 0 as u32
    var from_port: u16 = 0 as u16
    let got: i64 = udp.udp_recvfrom(rx, (&buf[0]) as u64, 16 as usize, &from_addr, &from_port)
    testkit.check(got == 5, "recvfrom returns 5 octets")
    testkit.check(buf[0] == (104 as u8) && buf[4] == (111 as u8), "payload intact")
    testkit.check(from_addr == (2130706433 as u32), "sender address is loopback")
    let again: i64 = udp.udp_recvfrom(rx, (&buf[0]) as u64, 16 as usize, &from_addr, &from_port)
    testkit.check(udp.udp_is_timeout(again), "empty socket times out")
    udp.udp_close(tx)
    udp.udp_close(rx)
    return true
}

fn main() -> i32 {
    work()
    return testkit.finish()
}
