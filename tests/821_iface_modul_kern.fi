// expect_exit: 0
// tests/821_iface_modul_kern.fi — SCHNITTSTELLEN UEBER DIE MODULGRENZE.
//
// `tests/modules/zeichnen.fi` deklariert die Schnittstelle `Groesse` und
// setzt sie fuer zwei Typen um. Hier wird beides von aussen benutzt:
//
//   * der Typ heisst `zeichnen.Kreis` — mit Modulnamen
//   * die Schnittstelle heisst `dyn Groesse` — OHNE Modulnamen, denn
//     `interface` gilt programmweit (docs/RUNDE46.md §9)
//   * die Methodentafel muss auf `zeichnen__Kreis__groesse` zeigen, also auf
//     den Namen NACH der Umbenennung
//
// Zusaetzlich: eine Umsetzung in der WURZELDATEI fuer einen Typ, der hier
// steht — dieselbe Schnittstelle, zwei Dateien.
import modules.zeichnen

struct Streifen { laenge: i64 }

impl Groesse for Streifen {
    fn groesse(*self) -> i64 { return (*self).laenge }
    fn wachse(*mut self, k: i64) { (*self).laenge = (*self).laenge + k }
}

fn summe(a: dyn Groesse, b: dyn Groesse) -> i64 {
    return a.groesse() + b.groesse()
}

fn main() -> i32 {
    var k: zeichnen.Kreis = zeichnen.neu_kreis(2)
    var q: zeichnen.Quadrat = zeichnen.neu_quadrat(5)
    var s: Streifen = Streifen{ laenge: 9 }

    let gk: dyn Groesse = (&k) as dyn Groesse
    let gq: dyn Groesse = (&q) as dyn Groesse
    let gs: dyn Groesse = (&s) as dyn Groesse

    if gk.groesse() != 12 {
        return 1
    }
    if gq.groesse() != 25 {
        return 2
    }
    if gs.groesse() != 9 {
        return 3
    }
    // schreibend ueber die Modulgrenze
    gk.wachse(1)
    if k.r != 3 {
        return 4
    }
    if gk.groesse() != 27 {
        return 5
    }
    gs.wachse(1)
    if s.laenge != 10 {
        return 6
    }
    if summe(gq, gs) != 35 {
        return 7
    }
    // statischer Aufruf derselben Methode, ohne Modulpraefix
    if k.groesse() != 27 {
        return 8
    }
    // die freie Funktion des Moduls ist nicht verdeckt
    if zeichnen.groesse(4) != 4 {
        return 9
    }
    return 0
}
