// expect_exit: 0
gc class Cell { value: u64, next: Gc[Cell] }
gc class Holder { f: fn() -> u64, tag: u64 }
gc class Slot { h: Gc[Holder], g: fn(u64) -> u64 }

fn plain() -> u64 {
    return 5
}

fn make(v: u64) -> AllocError!Gc[Holder] {
    let c: Gc[Cell] = try gc Cell { value: v, next: gc_null[Cell]() }
    let clo: fn() -> u64 = try gc fn() -> u64 { return c.value }
    return try gc Holder { f: clo, tag: 7 }
}

fn make_nested(v: u64) -> AllocError!fn() -> u64 {
    let c: Gc[Cell] = try gc Cell { value: v, next: gc_null[Cell]() }
    let inner: fn() -> u64 = try gc fn() -> u64 { return c.value }
    return try gc fn() -> u64 { return inner() + 1 }
}

fn make_slot(v: u64) -> AllocError!Gc[Slot] {
    let h: Gc[Holder] = try make(v)
    let k: u64 = v
    let adder: fn(u64) -> u64 = try gc fn(x: u64) -> u64 { return x + k }
    return try gc Slot { h: h, g: adder }
}

fn scrub(n: u64) {
    var buffer: [u64; 256] = [0; 256]
    let p: u64 = (&buffer) as u64
    var i: u64 = 0
    while i < 256 {
        *((p + i * 8) as *mut u64) = 0
        i = i + 1
    }
    if n > 0 {
        scrub(n - 1)
    }
}

fn churn(n: u64) -> AllocError!u64 {
    var i: u64 = 0
    var s: u64 = 0
    while i < n {
        let d: Gc[Cell] = try gc Cell { value: 999999, next: gc_null[Cell]() }
        let e: fn() -> u64 = try gc fn() -> u64 { return d.value }
        s = s + e()
        i = i + 1
    }
    return s
}

fn run() -> AllocError!i32 {
    let root: Gc[Holder] = try make(41)
    let nested: fn() -> u64 = try make_nested(100)
    let slot: Gc[Slot] = try make_slot(9)
    let late: Gc[Holder] = try gc Holder { f: plain, tag: 1 }
    scrub(4)
    var k: u64 = 0
    while k < 4 {
        gc_collect()
        let s: u64 = try churn(300)
        if s == 0 {
            return 1
        }
        k = k + 1
    }
    scrub(4)
    gc_collect()
    let c: Gc[Cell] = try gc Cell { value: 77, next: gc_null[Cell]() }
    let clo: fn() -> u64 = try gc fn() -> u64 { return c.value }
    late.f = clo
    scrub(4)
    gc_collect()
    let _ = try churn(300)
    gc_collect()
    let f: fn() -> u64 = root.f
    if f() != 41 {
        return 2
    }
    if nested() != 101 {
        return 3
    }
    let g: fn(u64) -> u64 = slot.g
    if g(1) != 10 {
        return 4
    }
    let h: fn() -> u64 = slot.h.f
    if h() != 9 {
        return 5
    }
    let lf: fn() -> u64 = late.f
    if lf() != 77 {
        return 6
    }
    return 0
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}
