// expect_exit: 0
import std.rt
import std.env
import mc.mc_death_ui
import mc.mc_gui_ui
import mc.mc_gui_pack
import mc.mc_raster
import html.mem
import paint.canvas
import paint.png

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn dump(r: *mut mc_raster.Raster, path: str) {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, (*r).w as usize, (*r).h as usize) { return }
    rt.mem_copy(canvas.canvas_pixels(&cv) as u64, (*r).color, ((*r).w as usize) * ((*r).h as usize) * 4)
    var enc: mem.Buf = mem.buf_new()
    if png.write_png(&cv, &enc) { rt.write_file(path.p as u64, mem.buf_ptr(&enc) as u64, mem.buf_len(&enc)) }
    mem.buf_free(&enc)
    canvas.canvas_free(&cv)
}

fn main() -> i32 {
    var x: i32 = 0
    var y: i32 = 0
    mc_death_ui.death_button_xy(427, 240, 0, &x, &y)
    check(x == 113 && y == 132, 1)
    mc_death_ui.death_button_xy(427, 240, 1, &x, &y)
    check(x == 113 && y == 156, 2)
    if !env.has("MC_VANILLA_JAR") { return 0 }
    var pk: mc_gui_pack.GuiPack = mc_gui_pack.gpack_new()
    check(mc_gui_pack.gpack_open(&pk, 763), 3)
    var ui: mc_gui_ui.Ui = mc_gui_ui.ui_new()
    ui.in_game = true
    var d: mc_death_ui.DeathUi = mc_death_ui.death_new()
    var r: mc_raster.Raster = mc_raster.raster_new(854, 480)
    mc_raster.raster_clear(&r, 0xFF405060 as u32)
    let msg: str = "Player13 was slain by Zombie"
    mc_gui_ui.ui_begin(&ui, &r, &pk, 2, 0, 0, false, 0 as u64)
    check(mc_death_ui.death_frame(&ui, &d, false, msg.p as u64, msg.n, 42, 5000 as u64) == mc_death_ui.DA_NONE, 4)
    mc_gui_ui.ui_end_frame(&ui)
    let o: str = env.get("DEATH_DUMP")
    if o.length() > 0 { dump(&r, o) }
    mc_gui_ui.ui_begin(&ui, &r, &pk, 2, 2 * 213, 2 * 142, true, 0 as u64)
    check(mc_death_ui.death_frame(&ui, &d, false, msg.p as u64, msg.n, 42, 500 as u64) == mc_death_ui.DA_NONE, 5)
    mc_gui_ui.ui_end_frame(&ui)
    mc_gui_ui.ui_begin(&ui, &r, &pk, 2, 2 * 213, 2 * 142, true, 0 as u64)
    check(mc_death_ui.death_frame(&ui, &d, false, msg.p as u64, msg.n, 42, 5000 as u64) == mc_death_ui.DA_RESPAWN, 7)
    mc_gui_ui.ui_end_frame(&ui)
    mc_gui_ui.ui_begin(&ui, &r, &pk, 2, 2 * 213, 2 * 166, true, 0 as u64)
    check(mc_death_ui.death_frame(&ui, &d, false, msg.p as u64, msg.n, 42, 5000 as u64) == mc_death_ui.DA_NONE, 8)
    check(d.confirm, 9)
    mc_gui_ui.ui_end_frame(&ui)
    mc_death_ui.death_free(&d)
    mc_gui_ui.ui_free(&ui)
    mc_gui_pack.gpack_free(&pk)
    return 0
}
