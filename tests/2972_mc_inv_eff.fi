// expect_exit: 0
// mc_inv Efficiency level + carried stack: <= 1.20.4 from the item NBT "Enchantments" (string ids), 1.20.5+ from the enchantments component (varint ids,
// the efficiency id comes from the Registry Data); carried item of Window Items, Set Slot window -1, Set Cursor Item (1.21.2+).
// Return codes: 1xx = NBT versions, 2xx = components (767 .. 775), 3xx = cursor packets.
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_inv

// component type ids per version: enchantments, use_remainder (-1 = none), enchantments carry a showTooltip bool
fn ench_id(p: i32) -> i32 {
    if p == 767 { return 9 }
    if p == 769 { return 10 }
    if p == 772 { return 10 }
    return 13
}
fn rem_id(p: i32) -> i32 {
    if p == 767 { return 0 - 1 }
    if p == 769 { return 23 }
    if p == 772 { return 22 }
    return 25
}
fn has_tooltip(p: i32) -> bool { return p <= 769 }

fn put_window(b: *mut bytes.Bytes, p: i32, w: i32) {
    if p == 767 { bytes.put_u8(b, w as u8) } else { bytes.put_varint(b, w) }
}

// an item stack with components: damage, enchantments, custom_data (empty compound), [use_remainder = 5 x item 9], one removed component
fn put_full(b: *mut bytes.Bytes, p: i32, item: i32, count: i32) {
    put_full_e(b, p, item, count, 5, 3)
}

fn put_full_e(b: *mut bytes.Bytes, p: i32, item: i32, count: i32, eid: i32, lvl: i32) {
    bytes.put_varint(b, count)
    bytes.put_varint(b, item)
    var added: i32 = 3
    if rem_id(p) >= 0 { added = 4 }
    bytes.put_varint(b, added)
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 3) // damage
    bytes.put_varint(b, 11)
    bytes.put_varint(b, ench_id(p))
    bytes.put_varint(b, 2)
    bytes.put_varint(b, eid)
    bytes.put_varint(b, lvl)
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 2)
    if has_tooltip(p) { bytes.put_bool(b, true) }
    bytes.put_varint(b, 0) // custom_data: nameless compound {}
    bytes.put_u8(b, 10 as u8)
    bytes.put_u8(b, 0 as u8)
    if rem_id(p) >= 0 {
        bytes.put_varint(b, rem_id(p))
        bytes.put_varint(b, 5) // nested Slot
        bytes.put_varint(b, 9)
        bytes.put_varint(b, 0)
        bytes.put_varint(b, 0)
    }
    bytes.put_varint(b, 2) // removed: max_damage
}

fn put_plain(b: *mut bytes.Bytes, item: i32, count: i32) {
    bytes.put_varint(b, count)
    bytes.put_varint(b, item)
    bytes.put_varint(b, 0)
    bytes.put_varint(b, 0)
}


fn put_nbt_name(b: *mut bytes.Bytes, tag: i32, name: str, named_root: bool) {
    bytes.put_u8(b, tag as u8)
    bytes.put_u16(b, name.n as u16)
    bytes.put_text(b, name.p as u64, name.n)
}

// slot value (<= 1.20.4): present, item, count, NBT {Enchantments:[{id:<ench>, lvl:<lvl>s}]}; ench = "" -> no NBT
fn put_nbt_slot(b: *mut bytes.Bytes, p: i32, item: i32, count: i32, ench: str, lvl: i32) {
    bytes.put_bool(b, true)
    bytes.put_varint(b, item)
    bytes.put_i8(b, count as i8)
    if ench.n == 0 { bytes.put_u8(b, 0 as u8); return }
    bytes.put_u8(b, 10 as u8)
    if p < 764 { bytes.put_u16(b, 0 as u16) } // named root
    put_nbt_name(b, 9, "Enchantments", true)
    bytes.put_u8(b, 10 as u8)
    bytes.put_i32(b, 2)
    // first entry: another compound key before id, then id, lvl
    put_nbt_name(b, 3, "x", true)
    bytes.put_i32(b, 7)
    put_nbt_name(b, 8, "id", true)
    bytes.put_u16(b, ench.n as u16)
    bytes.put_text(b, ench.p as u64, ench.n)
    put_nbt_name(b, 2, "lvl", true)
    bytes.put_i16(b, lvl as i16)
    bytes.put_u8(b, 0 as u8)
    // second entry: unbreaking 9
    put_nbt_name(b, 8, "id", true)
    bytes.put_u16(b, 20 as u16)
    bytes.put_text(b, "minecraft:unbreaking".p as u64, 20)
    put_nbt_name(b, 2, "lvl", true)
    bytes.put_i16(b, 9 as i16)
    bytes.put_u8(b, 0 as u8)
    bytes.put_u8(b, 0 as u8)
}

fn nbt_check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&b, 0 as u8)
    if p >= 756 { bytes.put_varint(&b, 3) }
    if p >= 756 { bytes.put_varint(&b, 46) } else { bytes.put_i16(&b, 46 as i16) }
    var i: i32 = 0
    while i < 46 {
        if i == 36 {
            put_nbt_slot(&b, p, 5, 1, "minecraft:efficiency", 4)
        } else if i == 37 {
            put_nbt_slot(&b, p, 6, 2, "minecraft:fortune", 3)
        } else if i == 38 {
            put_nbt_slot(&b, p, 7, 1, "", 0)
        } else {
            bytes.put_bool(&b, false)
        }
        i = i + 1
    }
    if p >= 756 { put_nbt_slot(&b, p, 9, 3, "minecraft:efficiency", 5) }
    bytes.bytes_set_pos(&b, 0)
    if !mc_inv.inv_on_window_items_v(&v, &ver, &b) { return 101 }
    if v.bad != 0 as u32 { return 102 }
    if mc_inv.inv_eff(&v, 36) != 4 || mc_inv.inv_held_eff(&v, 0) != 4 { return 103 }
    if mc_inv.inv_eff(&v, 37) != 0 || mc_inv.inv_eff(&v, 38) != 0 { return 104 }
    if mc_inv.inv_item(&v, 36) != 5 || mc_inv.inv_count(&v, 37) != 2 { return 105 }
    if p >= 756 {
        if mc_inv.inv_cursor_item(&v) != 9 || mc_inv.inv_cursor_count(&v) != 3 || v.cur_eff != 5 { return 106 }
        // Set Slot window -1 / slot -1 empties the carried stack, a normal Set Slot replaces the level
        var s: bytes.Bytes = bytes.bytes_new()
        bytes.put_u8(&s, 255 as u8)
        bytes.put_varint(&s, 4)
        bytes.put_i16(&s, (0 - 1) as i16)
        bytes.put_bool(&s, false)
        bytes.bytes_set_pos(&s, 0)
        if !mc_inv.inv_on_set_slot_v(&v, &ver, &s) { return 107 }
        if mc_inv.inv_cursor_item(&v) != 0 - 1 || mc_inv.inv_cursor_count(&v) != 0 { return 108 }
    }
    var s2: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&s2, 0 as u8)
    if p >= 756 { bytes.put_varint(&s2, 5) }
    bytes.put_i16(&s2, 36 as i16)
    put_nbt_slot(&s2, p, 5, 1, "minecraft:efficiency", 2)
    bytes.bytes_set_pos(&s2, 0)
    if !mc_inv.inv_on_set_slot_v(&v, &ver, &s2) { return 109 }
    if mc_inv.inv_eff(&v, 36) != 2 { return 110 }
    var s3: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&s3, 0 as u8)
    if p >= 756 { bytes.put_varint(&s3, 6) }
    bytes.put_i16(&s3, 36 as i16)
    put_nbt_slot(&s3, p, 5, 1, "", 0)
    bytes.bytes_set_pos(&s3, 0)
    mc_inv.inv_on_set_slot_v(&v, &ver, &s3)
    if mc_inv.inv_eff(&v, 36) != 0 { return 111 }
    mc_inv.inv_free(&v)
    return 0
}

fn comp_check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 200 }
    var k: i32 = 0
    while k < 3 {
        // efficiency id: 5 -> level 3, 1 -> level 2, unknown (-1) -> 0
        var eid: i32 = 5
        var want: i32 = 3
        if k == 1 { eid = 1; want = 2 }
        if k == 2 { eid = 0 - 1; want = 0 }
        var v: mc_inv.Inv = mc_inv.inv_new()
        mc_inv.inv_set_efficiency_id(&v, eid)
        var b: bytes.Bytes = bytes.bytes_new()
        put_window(&b, p, 0)
        bytes.put_varint(&b, 5)
        bytes.put_varint(&b, 46)
        var i: i32 = 0
        while i < 46 {
            if i == 36 { put_full(&b, p, 794, 1) } else if i == 37 { put_plain(&b, 3, 4) } else { bytes.put_varint(&b, 0) }
            i = i + 1
        }
        put_full(&b, p, 4, 3) // carried
        bytes.bytes_set_pos(&b, 0)
        if !mc_inv.inv_on_window_items_v(&v, &ver, &b) { return 201 }
        if mc_inv.inv_eff(&v, 36) != want { return 202 }
        if mc_inv.inv_eff(&v, 37) != 0 { return 203 }
        if mc_inv.inv_cursor_item(&v) != 4 || mc_inv.inv_cursor_count(&v) != 3 || v.cur_eff != want { return 204 }
        // Set Slot replaces the stack and its level; a plain stack resets it
        var s: bytes.Bytes = bytes.bytes_new()
        put_window(&s, p, 0)
        bytes.put_varint(&s, 6)
        bytes.put_i16(&s, 37 as i16)
        put_full_e(&s, p, 12, 1, 5, 4)
        bytes.bytes_set_pos(&s, 0)
        if !mc_inv.inv_on_set_slot_v(&v, &ver, &s) { return 205 }
        if k == 0 && mc_inv.inv_eff(&v, 37) != 4 { return 206 }
        var s2: bytes.Bytes = bytes.bytes_new()
        put_window(&s2, p, 0)
        bytes.put_varint(&s2, 7)
        bytes.put_i16(&s2, 36 as i16)
        put_plain(&s2, 794, 1)
        bytes.bytes_set_pos(&s2, 0)
        if !mc_inv.inv_on_set_slot_v(&v, &ver, &s2) { return 207 }
        if mc_inv.inv_eff(&v, 36) != 0 || mc_inv.inv_item(&v, 36) != 794 { return 208 }
        // Set Slot window -1 / slot -1 (as varint -1 from 1.21.2 on) = the carried stack
        var c: bytes.Bytes = bytes.bytes_new()
        if p == 767 { bytes.put_u8(&c, 255 as u8) } else { bytes.put_varint(&c, 0 - 1) }
        bytes.put_varint(&c, 8)
        bytes.put_i16(&c, (0 - 1) as i16)
        put_full_e(&c, p, 14, 2, 5, 2)
        bytes.bytes_set_pos(&c, 0)
        if !mc_inv.inv_on_set_slot_v(&v, &ver, &c) { return 209 }
        if mc_inv.inv_cursor_item(&v) != 14 || mc_inv.inv_cursor_count(&v) != 2 { return 210 }
        // Set Cursor Item (1.21.2+): just the slot value
        if mc_version.version_pid(&ver, mc_sem.SEM_PLAY_S2C_SET_CURSOR_ITEM) >= 0 {
            var u: bytes.Bytes = bytes.bytes_new()
            put_full_e(&u, p, 20, 7, 5, 5)
            bytes.bytes_set_pos(&u, 0)
            if !mc_inv.inv_on_set_cursor_v(&v, &ver, &u) { return 211 }
            if mc_inv.inv_cursor_item(&v) != 20 || mc_inv.inv_cursor_count(&v) != 7 { return 212 }
            if k == 0 && v.cur_eff != 5 { return 213 }
            var e: bytes.Bytes = bytes.bytes_new()
            bytes.put_varint(&e, 0)
            bytes.bytes_set_pos(&e, 0)
            if !mc_inv.inv_on_set_cursor_v(&v, &ver, &e) { return 214 }
            if mc_inv.inv_cursor_item(&v) != 0 - 1 { return 215 }
        } else if p >= 769 {
            return 216
        }
        // another window is still refused
        var o: bytes.Bytes = bytes.bytes_new()
        put_window(&o, p, 3)
        bytes.put_varint(&o, 9)
        bytes.put_i16(&o, 38 as i16)
        put_plain(&o, 9, 9)
        bytes.bytes_set_pos(&o, 0)
        if mc_inv.inv_on_set_slot_v(&v, &ver, &o) { return 217 }
        mc_inv.inv_free(&v)
        k = k + 1
    }
    return 0
}

fn main() -> i32 {
    var r: i32 = nbt_check(763)
    if r != 0 { return 1000 + r }
    r = nbt_check(758)
    if r != 0 { return 2000 + r }
    r = nbt_check(754)
    if r != 0 { return 3000 + r }
    r = nbt_check(764)
    if r != 0 { return 4000 + r }
    r = comp_check(767)
    if r != 0 { return 5000 + r }
    r = comp_check(769)
    if r != 0 { return 6000 + r }
    r = comp_check(772)
    if r != 0 { return 7000 + r }
    r = comp_check(774)
    if r != 0 { return 8000 + r }
    r = comp_check(775)
    if r != 0 { return 9000 + r }
    return 0
}
