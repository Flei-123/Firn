// expect_exit: 0
// tests/3947_mc_model_mesh.fi -- mesher side of the pack models (lib/mc/mc_model_mesh.fi): state string from the registry (r231), seed from the block
// position, '!' in "when", inner / outer stairs built-ins, texture name -> atlas tile, model vs cube classification, face culling against opaque /
// unknown neighbours, light of the cell in front, weighted variants per position. Packs are built in-process from own JSON (no Mojang file).
import std.rt
import zip.zip
import mc.mc_assets
import mc.mc_texture
import mc.mc_texext
import mc.mc_mesh
import mc.mc_model
import mc.mc_model_mesh
import mc.mc_registry
import mc.mc_version
import mc.mc_versions

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn add(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    let ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

fn push_pack(st: *mut mc_assets.PackStack, w: *mut zip.ZipWriter, b: *mut rt.Buf) -> bool {
    let n: usize = zip.zip_finish(w) catch | e | (0)
    zip.zip_writer_free(w)
    if n == 0 { return false }
    var p: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&p, rt.buf_ptr(b), rt.buf_len(b)) != mc_assets.ASSET_OK { return false }
    rt.buf_free(b)
    return mc_assets.stack_push(st, &p) == mc_assets.ASSET_OK
}

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"
const TEXOAK: str = "\"textures\":{\"bottom\":\"minecraft:block/oak_planks\",\"top\":\"block/oak_planks\",\"side\":\"block/oak_planks\"}"

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0001
}

fn build_pack(st: *mut mc_assets.PackStack) -> bool {
    var b: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&b)
    if !add(&w, "pack.mcmeta", META) { return false }
    // stairs: straight / inner / outer, selected by the registry's shape property (any property order)
    if !add(&w, "assets/minecraft/models/block/ms_straight.json", "{\"parent\":\"block/stairs\"," + TEXOAK + "}") { return false }
    if !add(&w, "assets/minecraft/models/block/ms_inner.json", "{\"parent\":\"block/inner_stairs\"," + TEXOAK + "}") { return false }
    if !add(&w, "assets/minecraft/models/block/ms_outer.json", "{\"parent\":\"block/outer_stairs\"," + TEXOAK + "}") { return false }
    if !add(&w, "assets/minecraft/blockstates/oak_stairs.json",
        "{\"variants\":{\"shape=straight\":{\"model\":\"block/ms_straight\"},\"shape=inner_left\":{\"model\":\"block/ms_inner\"},\"shape=inner_right\":{\"model\":\"block/ms_inner\"},\"shape=outer_left\":{\"model\":\"block/ms_outer\"},\"shape=outer_right\":{\"model\":\"block/ms_outer\"}}}") { return false }
    // a unit cube stays with the cube mesher; a block with an unknown texture is dropped; a weighted slab (bottom / top by position)
    if !add(&w, "assets/minecraft/models/block/ms_cube.json", "{\"parent\":\"block/cube_all\",\"textures\":{\"all\":\"block/stone\"}}") { return false }
    if !add(&w, "assets/minecraft/blockstates/stone.json", "{\"variants\":{\"\":{\"model\":\"block/ms_cube\"}}}") { return false }
    if !add(&w, "assets/minecraft/models/block/ms_slab_b.json", "{\"parent\":\"block/slab\"," + TEXOAK + "}") { return false }
    if !add(&w, "assets/minecraft/models/block/ms_slab_t.json", "{\"parent\":\"block/slab_top\"," + TEXOAK + "}") { return false }
    if !add(&w, "assets/minecraft/blockstates/oak_slab.json",
        "{\"variants\":{\"\":[{\"model\":\"block/ms_slab_b\"},{\"model\":\"block/ms_slab_t\"}]}}") { return false }
    if !add(&w, "assets/minecraft/models/block/ms_lost.json", "{\"parent\":\"block/slab\",\"textures\":{\"bottom\":\"block/zzz_no_such_tile\",\"top\":\"block/zzz_no_such_tile\",\"side\":\"block/zzz_no_such_tile\"}}") { return false }
    if !add(&w, "assets/minecraft/blockstates/oak_fence.json", "{\"variants\":{\"\":{\"model\":\"block/ms_lost\"}}}") { return false }
    // '!' in when
    if !add(&w, "assets/minecraft/models/block/ms_w.json", "{\"parent\":\"block/cube_all\",\"textures\":{\"all\":\"block/stone\"}}") { return false }
    if !add(&w, "assets/minecraft/blockstates/bang.json",
        "{\"multipart\":[{\"when\":{\"facing\":\"!north\"},\"apply\":{\"model\":\"block/ms_w\"}},{\"when\":{\"facing\":\"!north|south\",\"lit\":\"!false\"},\"apply\":{\"model\":\"block/ms_w\"}}]}") { return false }
    return push_pack(st, &w, &b)
}

fn cell(x: i32, y: i32, z: i32) -> usize { return ((y * 18 + z) * 18 + x) as usize }

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 1)
    var reg: mc_registry.Registry = v.registry_of()
    check(mc_registry.registry_ok(&reg), 2)

    // ---- r231: state string from the registry properties
    let stairs: i32 = mc_registry.reg_block_by_name(&reg, "oak_stairs".p as u64, 10)
    check(stairs >= 0, 3)
    let s0: i32 = mc_registry.reg_block_min_state(&reg, stairs)
    var nm: rt.Buf = rt.buf_new()
    var pr: rt.Buf = rt.buf_new()
    check(mc_model_mesh.ms_state_parts(&reg, s0, &nm, &pr), 4)
    check(rt.buf_len(&nm) == 10 && rt.mem_eq(rt.buf_ptr(&nm), "oak_stairs".p as u64, 10), 5)
    var full: rt.Buf = rt.buf_new()
    check(mc_registry.reg_state_text(&reg, s0, &full), 6)
    check(rt.buf_len(&full) == rt.buf_len(&nm) + rt.buf_len(&pr) + 2, 7) // "name[" + props + "]"
    check(rt.buf_len(&pr) > 20, 8)
    // stone has no property: empty list
    check(mc_model_mesh.ms_state_parts(&reg, 1, &nm, &pr), 9)
    check(rt.buf_len(&pr) == 0 && rt.buf_len(&nm) == 5, 10)
    check(!mc_model_mesh.ms_state_parts(&reg, 2000000, &nm, &pr), 11)

    // ---- seed from the block position: stable, position dependent
    check(mc_model.seed_from_pos(3, 70, 9) == mc_model.seed_from_pos(3, 70, 9), 12)
    check(mc_model.seed_from_pos(3, 70, 9) != mc_model.seed_from_pos(4, 70, 9), 13)
    check(mc_model.seed_from_pos(3, 70, 9) != mc_model.seed_from_pos(3, 70, 10), 14)
    check(mc_model.seed_from_pos(0 - 5, 0 - 20, 0 - 7) == mc_model.seed_from_pos(0 - 5, 0 - 20, 0 - 7), 15)

    var st: mc_assets.PackStack = mc_assets.stack_new()
    check(build_pack(&st), 20)

    // ---- '!' in when
    var sel: mc_model.Selection = mc_model.selection_new()
    check(mc_model.blockstate_select(&st, "bang", "facing=north,lit=true", 0 as u32, &sel) == 0, 21) // !north no, !north|south no
    check(mc_model.blockstate_select(&st, "bang", "facing=east,lit=true", 0 as u32, &sel) == 2, 22) // both match
    check(mc_model.blockstate_select(&st, "bang", "facing=south,lit=true", 0 as u32, &sel) == 1, 23) // second excludes south
    check(mc_model.blockstate_select(&st, "bang", "facing=east,lit=false", 0 as u32, &sel) == 1, 24) // second needs lit != false

    // ---- inner / outer stairs built-ins (straight 11 quads, inner 15, outer 11 + 1 more step top)
    var b: mc_model.Baked = mc_model.baked_new()
    check(mc_model.blockstate_bake(&st, "oak_stairs", "facing=east,half=bottom,shape=straight,waterlogged=false", 0 as u32, &b) == 11, 30)
    mc_model.baked_free(&b)
    b = mc_model.baked_new()
    check(mc_model.blockstate_bake(&st, "oak_stairs", "facing=east,half=bottom,shape=inner_right,waterlogged=false", 0 as u32, &b) == 15, 31)
    var tops: i32 = 0
    var i: usize = 0
    while i < mc_model.baked_count(&b) {
        if mc_model.baked_f(&b, i, mc_model.W_CULL) > 0.5 && mc_model.baked_f(&b, i, mc_model.W_CULL) < 1.5 { tops = tops + 1 }
        i = i + 1
    }
    check(tops == 2, 32) // step B and the extra step C reach the top of the block
    mc_model.baked_free(&b)
    b = mc_model.baked_new()
    check(mc_model.blockstate_bake(&st, "oak_stairs", "facing=east,half=bottom,shape=outer_left,waterlogged=false", 0 as u32, &b) == 11, 33)
    tops = 0
    i = 0
    var smallest: f64 = 10.0
    while i < mc_model.baked_count(&b) {
        if mc_model.baked_f(&b, i, mc_model.W_CULL) > 0.5 && mc_model.baked_f(&b, i, mc_model.W_CULL) < 1.5 {
            tops = tops + 1
            let dx: f64 = mc_model.baked_f(&b, i, mc_model.X0 + 2) - mc_model.baked_f(&b, i, mc_model.X0)
            if dx < 0.0 && 0.0 - dx < smallest { smallest = 0.0 - dx }
            if dx > 0.0 && dx < smallest { smallest = dx }
        }
        i = i + 1
    }
    check(tops == 1, 34)
    check(near(smallest, 0.5), 35) // the outer step is a quarter block: 8 x 8 units
    mc_model.baked_free(&b)

    // ---- ModelSet: classification, tiles
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    var ex: mc_texext.TexExt = mc_texext.texext_new()
    mc_texext.tex_build_tables_ext(&reg, &tb, &ex)
    var ms: mc_model_mesh.ModelSet = mc_model_mesh.ms_new(&reg, &st, &ex)
    let slab_b: i32 = mc_registry.reg_block_by_name(&reg, "oak_slab".p as u64, 8)
    let fence_b: i32 = mc_registry.reg_block_by_name(&reg, "oak_fence".p as u64, 9)
    check(slab_b >= 0 && fence_b >= 0, 40)
    let st_straight: u16 = mc_registry.reg_block_min_state(&reg, stairs) as u16 // north / top / straight / true: shape straight
    check(mc_model_mesh.ms_kind(&ms, st_straight) == mc_model_mesh.K_MODEL, 41)
    check(mc_model_mesh.ms_quad_count(&ms, st_straight) == 11, 42)
    check(mc_model_mesh.ms_kind(&ms, 1 as u16) == mc_model_mesh.K_PLAIN, 43) // stone: a unit cube -> cube mesher
    check(mc_model_mesh.ms_kind(&ms, 0 as u16) == mc_model_mesh.K_PLAIN, 44) // air: no blockstate
    check(mc_model_mesh.ms_kind(&ms, mc_mesh.UNKNOWN_ID) == mc_model_mesh.K_PLAIN, 45)
    check(ms.unmapped == 0, 46)
    // all faces of the stairs got the extended tile of oak_planks
    var tn: mc_model.Name = mc_model.name_new()
    mc_model.name_set(&tn, "minecraft:block/oak_planks".p as u64, 26)
    let tile: u32 = mc_model_mesh.ms_tex_tile(&ms, &tn)
    check(tile >= mc_texext.EXT_BASE, 47)
    mc_model.name_set(&tn, "block/zzz_nothing".p as u64, 17)
    check(mc_model_mesh.ms_tex_tile(&ms, &tn) == 0 as u32, 48)
    mc_model.name_set(&tn, "block/piston_top".p as u64, 16)
    let pt: u32 = mc_model_mesh.ms_tex_tile(&ms, &tn)
    check(pt >= mc_texext.EXT_BASE, 120)
    var cp: u64 = 0
    var cl: usize = 0
    check(mc_texext.texext_cand(&ex, (pt - mc_texext.EXT_BASE) as usize, 0, &cp, &cl), 121)
    check(cl == 10 && rt.mem_eq(cp, "piston_top".p as u64, 10), 122)
    // unknown texture: the model state exists but its quads are dropped and counted
    let fence_s: u16 = mc_registry.reg_block_min_state(&reg, fence_b) as u16
    check(mc_model_mesh.ms_kind(&ms, fence_s) == mc_model_mesh.K_MODEL, 49)
    check(mc_model_mesh.ms_quad_count(&ms, fence_s) == 0, 50)
    check(ms.unmapped > 0, 51)

    // ---- ms_prepare + ms_mesh on a padded section: one stairs block at padded (6, 6, 6) = section cell (5, 5, 5), stone below it
    let pad: u64 = rt.heap_alloc(5832 * 2)
    let lpad: u64 = rt.heap_alloc(5832)
    var k: usize = 0
    while k < 5832 {
        rt.st16(pad, k, 0 as u16)
        rt.st8(lpad, k, (7 * 16 + 3) as u8)
        k = k + 1
    }
    rt.st8(lpad, cell(6, 6, 6), (9 * 16 + 1) as u8) // the block's own cell
    rt.st16(pad, cell(6, 6, 6), st_straight)
    rt.st16(pad, cell(6, 5, 6), 1 as u16) // stone below
    // before ms_prepare the stairs still look like a cube to the cube mesher
    mc_texture.tex_build_tables(&reg, &tb)
    check(rt.ld16(tb.tiles, (st_straight as usize) * 6 + 3) != 0 as u16, 60)
    mc_model_mesh.ms_prepare(&ms, pad, &tb)
    check(rt.ld16(tb.tiles, (st_straight as usize) * 6 + 3) == 0 as u16, 61)
    check(rt.ld8(tb.opaque, st_straight as usize) == 0 as u8, 62)
    check(rt.ld8(tb.opaque, 1) == 1 as u8, 63) // stone keeps its faces / occlusion
    var out: rt.Buf = rt.buf_new()
    var nq: usize = mc_model_mesh.ms_mesh(&ms, pad, lpad, &tb, 0, 0, 0, &out)
    check(nq == 10, 64) // 11 quads, the bottom one (cullface down) is hidden by the stone
    check(rt.buf_len(&out) == nq * mc_model_mesh.MQ_WORDS * 8, 65)
    // every corner sits inside the block cell (5, 5, 5) .. (6, 6, 6) and the tile is the extended tile
    var okpos: bool = true
    var q: usize = 0
    var own_lit: i32 = 0
    var front_lit: i32 = 0
    while q < nq {
        var c: usize = 0
        while c < 4 {
            let x: f64 = math_f(rt.buf_ptr(&out), q * mc_model_mesh.MQ_WORDS + c)
            let y: f64 = math_f(rt.buf_ptr(&out), q * mc_model_mesh.MQ_WORDS + 4 + c)
            let z: f64 = math_f(rt.buf_ptr(&out), q * mc_model_mesh.MQ_WORDS + 8 + c)
            if x < 4.999 || x > 6.001 || y < 4.999 || y > 6.001 || z < 4.999 || z > 6.001 { okpos = false }
            c = c + 1
        }
        if !near(math_f(rt.buf_ptr(&out), q * mc_model_mesh.MQ_WORDS + 20), tile as f64) { okpos = false }
        let sky: f64 = math_f(rt.buf_ptr(&out), q * mc_model_mesh.MQ_WORDS + 22)
        let blk: f64 = math_f(rt.buf_ptr(&out), q * mc_model_mesh.MQ_WORDS + 23)
        if near(sky, 9.0) && near(blk, 1.0) { own_lit = own_lit + 1 }
        if near(sky, 7.0) && near(blk, 3.0) { front_lit = front_lit + 1 }
        q = q + 1
    }
    check(okpos, 66)
    check(own_lit > 0 && front_lit > 0 && own_lit + front_lit == 10, 67) // inner faces: own cell, culled-face quads: the neighbour in front
    // no light array: sky 15 / block 0
    nq = mc_model_mesh.ms_mesh(&ms, pad, 0, &tb, 0, 0, 0, &out)
    check(nq == 10 && near(math_f(rt.buf_ptr(&out), 22), 15.0) && near(math_f(rt.buf_ptr(&out), 23), 0.0), 68)
    // an opaque neighbour east and an UNKNOWN one north hide those side quads
    rt.st16(pad, cell(7, 6, 6), 1 as u16)
    rt.st16(pad, cell(6, 6, 5), mc_mesh.UNKNOWN_ID)
    nq = mc_model_mesh.ms_mesh(&ms, pad, lpad, &tb, 0, 0, 0, &out)
    check(nq == 6, 69) // 10 - east (slab, step) - north (slab, step)
    rt.heap_free(pad, 5832 * 2)
    rt.heap_free(lpad, 5832)

    // ---- weighted variants follow the block position (same position -> same variant; the positions together show both)
    let slab_s: u16 = mc_registry.reg_block_min_state(&reg, slab_b) as u16
    check(mc_model_mesh.ms_kind(&ms, slab_s) == mc_model_mesh.K_MODEL, 80)
    check(mc_model_mesh.ms_quad_count(&ms, slab_s) == 6, 81)
    let pad2: u64 = rt.heap_alloc(5832 * 2)
    k = 0
    while k < 5832 {
        rt.st16(pad2, k, 0 as u16)
        k = k + 1
    }
    rt.st16(pad2, cell(6, 6, 6), slab_s)
    var seen_low: bool = false
    var seen_high: bool = false
    var wx: i32 = 0
    while wx < 24 {
        let a: usize = mc_model_mesh.ms_mesh(&ms, pad2, 0, &tb, wx * 16, 0, 0, &out)
        check(a >= 5, 82)
        // the y extent of the whole block: bottom slab 5.0 .. 5.5, top slab 5.5 .. 6.0
        var ymax: f64 = 0.0
        var qq: usize = 0
        while qq < a {
            var c: usize = 0
            while c < 4 {
                let y: f64 = math_f(rt.buf_ptr(&out), qq * mc_model_mesh.MQ_WORDS + 4 + c)
                if y > ymax { ymax = y }
                c = c + 1
            }
            qq = qq + 1
        }
        if near(ymax, 5.5) { seen_low = true }
        if near(ymax, 6.0) { seen_high = true }
        // same position again: same variant
        let a2: usize = mc_model_mesh.ms_mesh(&ms, pad2, 0, &tb, wx * 16, 0, 0, &out)
        check(a2 == a, 83)
        wx = wx + 1
    }
    check(seen_low && seen_high, 84)
    rt.heap_free(pad2, 5832 * 2)
    mc_model_mesh.ms_free(&ms)
    mc_texext.texext_free(&ex)
    mc_texture.tex_free_tables(&tb)
    return 0
}

fn math_f(p: u64, i: usize) -> f64 {
    return *((p + (i as u64) * (8 as u64)) as *mut f64)
}
