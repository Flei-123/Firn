// expect_exit: 0
// tests/2300_std_xml.fi -- r319: `lib/std/xml.fi`, the API on a small document.
//
//   A  the shape: root, children (elements AND text), parent, names, kinds
//   B  access: child / next_named / children_named, text / text_all
//   C  attributes: by name, by index, absent vs empty, quote styles
//   D  character data: entities, character references, CDATA, comments
//   E  line ends: CR LF and CR become LF, white space in attribute values
//   F  prefixed names stay plain strings
import std.xml
import std.rt
import std.str

fn load(d: *mut xml.Doc, s: str) -> bool {
    return xml.parse_str(d, s) catch false
}

fn main() -> i32 {
    var d: xml.Doc = xml.doc_new()
    defer xml.doc_free(&d)

    // --- A/B/C: a document with every shape in it
    let doc: str = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- head -->\n<lib name='x' n=\"1\" empty=\"\">\n <book id=\"b1\">T1<author>A</author> tail</book>\n<book id=\"b2\"/>\n<other/>\n</lib>\n<!-- end -->"
    if !load(&d, doc) {
        return 10
    }
    if !xml.valid(&d) {
        return 11
    }
    let root: u32 = xml.root(&d)
    if root == xml.NONE || xml.kind(&d, root) != xml.ELEMENT {
        return 12
    }
    if !(xml.name(&d, root) == "lib") {
        return 13
    }
    if xml.parent(&d, root) != xml.NONE {
        return 14
    }
    if xml.attr_count(&d, root) != 3 {
        return 15
    }
    if !(xml.attr(&d, root, "name") == "x") || !(xml.attr(&d, root, "n") == "1") {
        return 16
    }
    if !xml.has_attr(&d, root, "empty") || !(xml.attr(&d, root, "empty") == "") {
        return 17
    }
    if xml.has_attr(&d, root, "absent") || !(xml.attr(&d, root, "absent") == "") {
        return 18
    }
    if !(xml.attr_name(&d, root, 0) == "name") || !(xml.attr_value(&d, root, 2) == "") {
        return 19
    }
    // children of lib: text " \n ", book, text "\n", book, text "\n", other, text "\n"
    if xml.child_count(&d, root) != 7 {
        return 20
    }
    let b1: u32 = xml.child(&d, root, "book")
    if b1 == xml.NONE || !(xml.attr(&d, b1, "id") == "b1") {
        return 21
    }
    if xml.parent(&d, b1) != root {
        return 22
    }
    let b2: u32 = xml.next_named(&d, b1, "book")
    if b2 == xml.NONE || !(xml.attr(&d, b2, "id") == "b2") {
        return 23
    }
    if xml.next_named(&d, b2, "book") != xml.NONE {
        return 24
    }
    var ids: [u32; 1] = [0; 1]
    if xml.children_named(&d, root, "book", &ids[0], 1) != 2 || ids[0] != b1 {
        return 25
    }
    if xml.children_named(&d, root, "nothing", &ids[0], 1) != 0 {
        return 26
    }
    if xml.child(&d, root, "nothing") != xml.NONE {
        return 27
    }
    // text: Element.text semantics, itertext
    if !(xml.text(&d, b1) == "T1") {
        return 28
    }
    if !(xml.text(&d, root) == "\n ") {
        return 29
    }
    var all: rt.Buf = rt.buf_new()
    defer rt.buf_free(&all)
    xml.text_all(&d, b1, &all)
    let exp: str = "T1A tail"
    if rt.buf_len(&all) != exp.n || !rt.mem_eq(rt.buf_ptr(&all), exp.p as u64, exp.n) {
        return 30
    }
    // the text node after <author>
    let au: u32 = xml.child(&d, b1, "author")
    let tail: u32 = xml.next(&d, au)
    if tail == xml.NONE || xml.kind(&d, tail) != xml.TEXT || !(xml.text(&d, tail) == " tail") {
        return 31
    }
    if xml.first(&d, b1) == xml.NONE || xml.last(&d, b1) != tail {
        return 32
    }
    if !(xml.name(&d, tail) == "") {
        return 33
    }
    // line of the start tag (counted from 1)
    if xml.line(&d, root) != 3 || xml.line(&d, b1) != 4 || xml.line(&d, b2) != 5 {
        return 34
    }
    // out of range ids are harmless
    if xml.child(&d, 99999, "a") != xml.NONE || !(xml.name(&d, 99999) == "") || xml.attr_count(&d, xml.NONE) != 0 {
        return 35
    }

    // --- D: entities, references, CDATA, comments
    if !load(&d, "<a>x &lt;&gt;&amp;&quot;&apos; &#65;&#x42;&#x20AC;&#x1F600; <![CDATA[<raw> & ]]]]><![CDATA[>]]><!-- c -->y<?pi data?>z</a>") {
        return 40
    }
    // one text node, with the comment and the PI skipped
    if xml.child_count(&d, xml.root(&d)) != 1 {
        return 41
    }
    if !(xml.text(&d, xml.root(&d)) == "x <>&\"' AB\u{20ac}\u{1f600} <raw> & ]]>yz") {
        return 42
    }
    // an empty CDATA section and an empty element leave no text node
    if !load(&d, "<a><![CDATA[]]><b></b></a>") || xml.child_count(&d, xml.root(&d)) != 1 {
        return 43
    }

    // --- E: line ends and attribute white space
    if !load(&d, "<a x=\"1\t2\n3\r\n4\r5\" y='&#9;&#10;&#13;'>a\r\nb\rc\nd</a>") {
        return 50
    }
    let r2: u32 = xml.root(&d)
    if !(xml.text(&d, r2) == "a\nb\nc\nd") {
        return 51
    }
    if !(xml.attr(&d, r2, "x") == "1 2 3 4 5") {
        return 52
    }
    if !(xml.attr(&d, r2, "y") == "\t\n\r") {
        return 53
    }

    // --- F: prefixed names are plain strings, nothing is resolved
    if !load(&d, "<svg:svg xmlns:svg=\"http://www.w3.org/2000/svg\" svg:w='1'><svg:rect/><other:x/></svg:svg>") {
        return 60
    }
    let r3: u32 = xml.root(&d)
    if !(xml.name(&d, r3) == "svg:svg") || !(xml.attr(&d, r3, "svg:w") == "1") {
        return 61
    }
    if xml.child(&d, r3, "svg:rect") == xml.NONE || xml.child(&d, r3, "rect") != xml.NONE {
        return 62
    }
    if xml.child(&d, r3, "other:x") == xml.NONE {
        return 63
    }

    // --- G: a document is parsed again into the same Doc, and a BOM is skipped
    if !load(&d, "\u{feff}<r>1</r>") || !(xml.text(&d, xml.root(&d)) == "1") {
        return 70
    }
    if !load(&d, "<second/>") || !(xml.name(&d, xml.root(&d)) == "second") {
        return 71
    }
    return 0
}
