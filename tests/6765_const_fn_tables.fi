// expect_exit: 0
const fn fact(n: i64) -> i64 {
    var r: i64 = 1
    var i: i64 = 2
    while i <= n { r *= i; i++ }
    return r
}
const fn fnv(seed: u32, n: u32) -> u32 {
    var h: u32 = seed
    for i in 0..n { h = (h ^ (i as u32)) * 16777619 }
    return h
}
const fn squares() -> [i32; 8] {
    var t: [i32; 8] = [0; 8]
    for i in 0..8 { t[i as usize] = (i * i) as i32 }
    return t
}
const fn grid() -> [[u8; 4]; 3] {
    var g: [[u8; 4]; 3] = [[0 as u8; 4]; 3]
    for r in 0..3 { for c in 0..4 { g[r as usize][c as usize] = (r * 4 + c) as u8 } }
    return g
}
const fn sum(a: [i32; 8]) -> i32 {
    var s: i32 = 0
    for i in 0..8 { s += a[i as usize] }
    return s
}
const fn total() -> i32 { return sum(squares()) }
const F5: i64 = fact(5)
const H: u32 = fnv(2166136261, 10)
static SQ: [i32; 8] = squares()
static G: [[u8; 4]; 3] = grid()
static TOT: i32 = total()
static HS: [u32; 3] = [fnv(1, 3), fnv(2, 3), fnv(3, 3)]
fn main() -> i32 {
    var bad: i32 = 0
    if F5 != 120 { bad += 1 }
    if SQ[7] != 49 { bad += 2 }
    if G[2][3] != 11 { bad += 4 }
    if TOT != 140 { bad += 8 }
    var h: u32 = 2166136261
    for i in 0..10 { h = (h ^ (i as u32)) *% 16777619 }
    if H != h { bad += 16 }
    return bad
}
