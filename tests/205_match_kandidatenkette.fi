// expect_exit: 155
// Mehrere Faelle mit demselben Schluessel: die Kette hinter der Sprungmarke
// probiert sie in Quelltextreihenfolge und faellt zuletzt in den Auffangzweig.
enum Wert { Zahl(i32), Text(u8), Leer }

fn klasse(w: *Wert) -> i32 {
    var r: i32 = 0
    match *w {
        Wert::Zahl(0) => { r = 1 as i32 }
        Wert::Zahl(1..=5) => { r = 2 as i32 }
        Wert::Zahl(x) => { r = 3 as i32 + x }
        Wert::Text(7) => { r = 40 as i32 }
        _ => { r = 50 as i32 }
    }
    return r
}

fn main() -> i32 {
    var summe: i32 = 0
    var a = Wert::Zahl(0 as i32)
    var b = Wert::Zahl(4 as i32)
    var c = Wert::Zahl(9 as i32)
    var d = Wert::Text(7 as u8)
    var e = Wert::Text(8 as u8)
    var f = Wert::Leer
    summe = summe + klasse(&a)
    summe = summe + klasse(&b)
    summe = summe + klasse(&c)
    summe = summe + klasse(&d)
    summe = summe + klasse(&e)
    summe = summe + klasse(&f)
    return summe
}
