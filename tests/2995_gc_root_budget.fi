// expect_exit: 0
// r290 (OpenPlan CLI): the allocation budget between two collections has to
// count the registered root areas (r169: the buffer of every `Vec[T]` of GC
// pointers). Every cycle re-scans all of them, so a SMALL GC heap behind a
// LARGE `Vec` buffer used to start a cycle every MIN_LIMIT (1 MiB) and
// re-scan the whole buffer each time (30 s instead of 1.5 s on a 56,400
// function project). Here: a 24 MiB `Vec[str]` whose elements all point at
// ONE string (live GC heap ~ 0), then 96 MiB of short-lived garbage.
// Measured on the old budget (live * 1/1): 90+ cycles; with root bytes in the
// budget: at most 6.
import std.vec

fn churn(rounds: u32) -> u64 {
    var k: u32 = 0
    var sum: u64 = 0
    while k < rounds {
        let s: str = "garbage-" + "0123456789abcdef0123456789abcdef"
        sum = sum + s.n as u64
        k = k + 1
    }
    return sum
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let shared: str = "shared-" + "element"
    var v: Vec[str] = vec_new[str]()
    var i: u32 = 0
    while i < 1500000 {
        if !vec_push[str](&v, shared) { return 2 }
        i = i + 1
    }
    gc_collect()
    // the live heap is tiny, the root area is big
    if gc_roots() == 0 { return 3 }
    if gc_live_bytes() > 1048576 { return 4 }
    let before: u64 = gc_collections()
    // ~ 96 MiB of garbage (each string ~ 48 octets + header)
    if churn(1500000) == 0 { return 5 }
    let runs: u64 = gc_collections() - before
    if runs > 6 { return 6 }
    // everything in the Vec is still intact after the cycles
    i = 0
    while i < 1500000 {
        let p: *mut str = vec_elem_ptr[str](&v, i as usize)
        if (*p) != shared { return 7 }
        i = i + 1
    }
    vec_free[str](&v)
    return 0
}
