// expect_exit: 0
// tests/4440_std_heap.fi -- std.heap against Python's heapq. The expected
// numbers come from CPython 3.11 (`heapq`) run on the same LCG-driven script
// (tools/libs_py_cross/heap_ref.py is the script): the heap ARRAY must be
// identical, not just the pop order. Covers push/pop/pushpop/replace/heapify,
// nsmallest/nlargest (stable ties, keys), empty heap, max-heap by callback.
import std.rt
import std.vec
import std.heap
import std.testkit

struct Item { key: i64, id: i64 }

struct Lcg { x: u64 }

fn lcg_next(g: *mut Lcg) -> u64 {
    (*g).x = ((*g).x * 1103515245 + 12345) & 0x7fffffff
    return (*g).x
}

fn lcg_val(g: *mut Lcg) -> i64 {
    return (((lcg_next(g) >> 8) % 1000) as i64)
}

fn ck_i64(v: *mut Vec[i64]) -> u64 {
    var h: u64 = 7
    var i: usize = 0
    while i < vec_len[i64](v) {
        h = (h * 31 + (*vec_elem_ptr[i64](v, i)) as u64) & 0xffffffff
        i = i + 1
    }
    return h
}

fn key_less(a: *Item, b: *Item) -> bool { return (*a).key < (*b).key }
fn key_more(a: *Item, b: *Item) -> bool { return (*a).key > (*b).key }

fn main() -> i32 {
    if !gc_init() { return 1 }
    // A: small exact array
    var a: Vec[i64] = vec_new[i64]()
    let src: [i64; 8] = [5, 3, 8, 1, 9, 2, 7, 3]
    for i in 0..(8 as usize) { heap_push[i64](&a, src[i]) }
    let want: [i64; 8] = [1, 3, 2, 3, 9, 8, 7, 5]
    var same: bool = vec_len[i64](&a) == 8
    for i in 0..(8 as usize) { if vec_at[i64](&a, i) != want[i] { same = false } }
    testkit.check(same && heap_is_heap[i64](&a), "A push array equals heapq")
    var out: i64 = 0
    var popped: Vec[i64] = vec_new[i64]()
    while heap_pop[i64](&a, &out) { vec_push[i64](&popped, out) }
    let wp: [i64; 8] = [1, 2, 3, 3, 5, 7, 8, 9]
    same = vec_len[i64](&popped) == 8
    for i in 0..(8 as usize) { if vec_at[i64](&popped, i) != wp[i] { same = false } }
    testkit.check(same, "A pop order")
    testkit.check(!heap_pop[i64](&a, &out) && heap_peek[i64](&a) == 0 as *mut i64, "empty pop / peek")
    testkit.check(heap_push_pop[i64](&a, 4) == 4 && vec_len[i64](&a) == 0, "pushpop on empty")
    testkit.check(!heap_replace[i64](&a, 4, &out), "replace on empty")

    // B: 3000 mixed operations
    var g: Lcg = Lcg { x: 12345 }
    var h: Vec[i64] = vec_new[i64]()
    var acc: u64 = 0
    for i in 0..(3000 as usize) {
        let r: u64 = lcg_next(&g)
        if r % 4 == 0 && vec_len[i64](&h) > 0 {
            heap_pop[i64](&h, &out)
            acc = (acc * 31 + out as u64) & 0xffffffff
        } else if r % 7 == 0 && vec_len[i64](&h) > 0 {
            let p: i64 = heap_push_pop[i64](&h, lcg_val(&g))
            acc = (acc * 31 + p as u64) & 0xffffffff
        } else if r % 11 == 0 && vec_len[i64](&h) > 0 {
            heap_replace[i64](&h, lcg_val(&g), &out)
            acc = (acc * 31 + out as u64) & 0xffffffff
        } else {
            heap_push[i64](&h, lcg_val(&g))
        }
    }
    testkit.check(vec_len[i64](&h) == 2339, "B length")
    testkit.check(ck_i64(&h) == 4113841412, "B heap array checksum")
    testkit.check(acc == 3965705319, "B pop checksum")
    testkit.check(heap_is_heap[i64](&h), "B is heap")

    // C: heapify
    var c: Vec[i64] = vec_new[i64]()
    for i in 0..(500 as usize) { vec_push[i64](&c, lcg_val(&g)) }
    heap_heapify[i64](&c)
    testkit.check(ck_i64(&c) == 3445519070 && vec_at[i64](&c, 2) == 10 && heap_is_heap[i64](&c), "C heapify array")

    // D: nsmallest / nlargest with ties on the key, stable by original order
    var items: Vec[Item] = vec_new[Item]()
    for i in 0..(300 as usize) { vec_push[Item](&items, Item { key: lcg_val(&g) % 20, id: i as i64 }) }
    var ns: Vec[Item] = vec_new[Item]()
    var nl: Vec[Item] = vec_new[Item]()
    heap_nsmallest_by[Item](&items, 10, &ns, key_less)
    heap_nlargest_by[Item](&items, 10, &nl, key_less)
    let ws: [i64; 10] = [6, 7, 19, 31, 56, 65, 75, 99, 128, 138]
    let wl: [i64; 10] = [11, 18, 41, 96, 121, 123, 141, 152, 190, 198]
    var ok_s: bool = vec_len[Item](&ns) == 10
    var ok_l: bool = vec_len[Item](&nl) == 10
    for i in 0..(10 as usize) {
        if (*vec_elem_ptr[Item](&ns, i)).id != ws[i] { ok_s = false }
        if (*vec_elem_ptr[Item](&nl, i)).id != wl[i] { ok_l = false }
    }
    testkit.check(ok_s, "D nsmallest key, stable ties")
    testkit.check(ok_l, "D nlargest key, stable ties")

    // E: Ord nsmallest / nlargest
    var ints: Vec[i64] = vec_new[i64]()
    for i in 0..(400 as usize) { vec_push[i64](&ints, lcg_val(&g)) }
    var o1: Vec[i64] = vec_new[i64]()
    var o2: Vec[i64] = vec_new[i64]()
    var o0: Vec[i64] = vec_new[i64]()
    var ob: Vec[i64] = vec_new[i64]()
    heap_nsmallest[i64](&ints, 25, &o1)
    heap_nlargest[i64](&ints, 25, &o2)
    heap_nsmallest[i64](&ints, 0, &o0)
    heap_nsmallest[i64](&ints, 1000, &ob)
    testkit.check(ck_i64(&o1) == 1511091727, "E nsmallest ints")
    testkit.check(ck_i64(&o2) == 2455873122, "E nlargest ints")
    testkit.check(vec_len[i64](&o0) == 0, "E n = 0")
    testkit.check(vec_len[i64](&ob) == 400 && ck_i64(&ob) == 3788998772, "E n > len = sorted")

    // F: max-heap through the callback, struct payload
    var q: Vec[Item] = vec_new[Item]()
    for i in 0..(50 as usize) { heap_push_by[Item](&q, Item { key: (i * 37 % 50) as i64, id: i as i64 }, key_more) }
    testkit.check(heap_is_heap_by[Item](&q, key_more), "F max-heap invariant")
    var it: Item = Item { key: 0, id: 0 }
    var last: i64 = 1000
    var mono: bool = true
    var cnt: usize = 0
    while heap_pop_by[Item](&q, &it, key_more) {
        if it.key > last { mono = false }
        last = it.key
        cnt = cnt + 1
    }
    testkit.check(mono && cnt == 50, "F pops descending")
    return testkit.finish()
}
