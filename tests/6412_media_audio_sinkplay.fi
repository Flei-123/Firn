// expect_exit: 0
import std.rt
import std.env
import media.audio.sinkplay
import audio.sink

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn put16(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 8) & 255 as u32) as u8)
}

fn put32(b: *mut rt.Buf, v: u32) {
    put16(b, v & 65535 as u32)
    put16(b, v >> 16)
}

fn tag(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, 4)
}

fn make_wav(b: *mut rt.Buf, frames: u32) {
    tag(b, "RIFF")
    put32(b, 36 as u32 + frames * 4 as u32)
    tag(b, "WAVE")
    tag(b, "fmt ")
    put32(b, 16 as u32)
    put16(b, 1 as u32)
    put16(b, 2 as u32)
    put32(b, 8000 as u32)
    put32(b, 32000 as u32)
    put16(b, 4 as u32)
    put16(b, 16 as u32)
    tag(b, "data")
    put32(b, frames * 4 as u32)
    var i: u32 = 0 as u32
    while i < frames {
        put16(b, (i * 7 as u32) & 32767 as u32)
        put16(b, 65535 as u32 - ((i * 7 as u32) & 32767 as u32))
        i = i + 1 as u32
    }
}

fn main(start: u64) -> i32 {
    var wav: rt.Buf = rt.buf_new()
    make_wav(&wav, 8000 as u32)
    var p: sinkplay.SinkPlay = sinkplay.sp_new()
    check(sinkplay.sp_open(&p, rt.buf_ptr(&wav), rt.buf_len(&wav)), 1)
    check(sinkplay.sp_duration_ms(&p) == 1000 as u64, 2)
    check(sinkplay.sp_attach(&p, sink.sink_open_file("/dev/null", 8000 as u32, 2 as u32, true)), 3)
    check(sinkplay.sp_state(&p) == sinkplay.SP_PLAYING, 4)
    sinkplay.sp_run_to_end(&p)
    check(sinkplay.sp_is_finished(&p), 5)
    check(sinkplay.sp_position_ms(&p) == 1000 as u64, 6)
    check(sinkplay.sp_seek_ms(&p, 500 as u64), 7)
    check(sinkplay.sp_state(&p) == sinkplay.SP_PLAYING, 8)
    check(sinkplay.sp_position_ms(&p) == 500 as u64, 9)
    sinkplay.sp_pause(&p)
    check(sinkplay.sp_state(&p) == sinkplay.SP_PAUSED, 10)
    sinkplay.sp_resume(&p)
    sinkplay.sp_run_to_end(&p)
    check(sinkplay.sp_is_finished(&p), 11)
    sinkplay.sp_set_volume(&p, 50 as u32)
    check(sinkplay.sp_volume(&p) == 50 as u32, 12)
    sinkplay.sp_close(&p)
    rt.buf_free(&wav)
    return 0
}
