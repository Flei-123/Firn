// expect_exit: 0
import std.rt
import std.io
import mc.mc_lightmap
import mc.mc_skylight

fn say(f: io.Fmt) {
    io.fmt_print(f)
}

fn near(a: i64, b: i64, tol: i64) -> bool {
    var d: i64 = a - b
    if d < 0 as i64 { d = 0 as i64 - d }
    return d <= tol
}

fn check(name: str, sl: f64, bl: f64, sd: i32, gm: i32, r: i64, g: i64, b: i64) -> bool {
    let c: mc_lightmap.LmRgb = mc_lightmap.lm_eval(sl, bl, sd, gm)
    if near(c.r, r, 1 as i64) && near(c.g, g, 1 as i64) && near(c.b, b, 1 as i64) { return true }
    say(f"FAIL {name} got {c.r} {c.g} {c.b} want {r} {g} {b}\n")
    return false
}

fn main() -> i32 {
    var ok: bool = true
    ok = check("full sky no gamma", 15.0, 0.0, 256, 0, 251, 251, 251) && ok
    ok = check("full sky default gamma", 15.0, 0.0, 256, 128, 252, 252, 252) && ok
    ok = check("dark", 0.0, 0.0, 256, 128, 25, 25, 25) && ok
    ok = check("sky 8 vanilla curve", 8.0, 0.0, 256, 128, 120, 120, 120) && ok
    ok = check("sky 8 no gamma", 8.0, 0.0, 256, 0, 67, 67, 67) && ok
    ok = check("block 15", 0.0, 15.0, 256, 128, 253, 253, 253) && ok
    ok = check("block 8 warm", 0.0, 8.0, 256, 128, 152, 130, 97) && ok
    ok = check("night sky 5 blue", 5.0, 0.0, 51, 128, 32, 32, 40) && ok
    ok = check("night dark", 0.0, 0.0, 51, 128, 25, 25, 25) && ok
    ok = check("night dark no gamma", 0.0, 0.0, 51, 0, 15, 15, 15) && ok
    ok = check("dusk sky 15", 15.0, 0.0, 180, 128, 199, 199, 218) && ok
    ok = check("max gamma", 3.0, 3.0, 256, 256, 137, 121, 107) && ok
    let lin: i64 = 8 as i64 * 256 as i64 / 15 as i64
    let c8: mc_lightmap.LmRgb = mc_lightmap.lm_eval(8.0, 0.0, 256, 128)
    if c8.r >= lin { say(f"FAIL mid level not darker than linear {c8.r} {lin}\n"); ok = false }
    if !near(mc_skylight.skylight_darken256(6000 as i64, 0, 0) as i64, 256 as i64, 1 as i64) { say(f"FAIL noon\n"); ok = false }
    if !near(mc_skylight.skylight_darken256(18000 as i64, 0, 0) as i64, 51 as i64, 1 as i64) { say(f"FAIL midnight\n"); ok = false }
    if !near(mc_skylight.skylight_darken256(12000 as i64, 0, 0) as i64, 180 as i64, 3 as i64) { say(f"FAIL sunset {mc_skylight.skylight_darken256(12000 as i64, 0, 0)}\n"); ok = false }
    if !near(mc_skylight.skylight_darken256(6000 as i64, 256, 0) as i64, 192 as i64, 1 as i64) { say(f"FAIL rain {mc_skylight.skylight_darken256(6000 as i64, 256, 0)}\n"); ok = false }
    if mc_lightmap.lm_unpack_sky(mc_skylight.skylight_vanilla_day(6000 as i64, 0, 0)) != 256 { say(f"FAIL pack\n"); ok = false }
    if !ok { return 1 }
    say(f"lightmap ok\n")
    return 0
}
