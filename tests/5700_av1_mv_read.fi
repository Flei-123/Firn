// expect_exit: 42
import av1.av1sym
import av1.av1ibc
import av1.av1mv
import av1.av1mem
import av1.av1cdfio

struct Rng {
    s: i64,
}

fn rng_next(r: *mut Rng) -> i64 {
    (*r).s = ((*r).s * 1103515245 + 12345) & 2147483647
    return (*r).s >> 8
}

fn check_defaults() -> i32 {
    let m: u64 = av1cdfio.buf_new(av1cdfio.MODE_CELLS)
    let k: u64 = av1cdfio.buf_new(av1cdfio.COEF_CELLS)
    av1cdfio.load_defaults(0, m, k)
    if av1cdfio.layout_check(m, k) != 0 {
        return 1
    }
    var ctx: i64 = 0
    while ctx < 2 {
        if av1cdfio.cell_at(m, av1mv.mv_cdf_joint(ctx)) != 4096 || av1cdfio.cell_at(m, av1mv.mv_cdf_joint(ctx) + 2) != 19328 {
            return 2
        }
        var comp: i64 = 0
        while comp < 2 {
            if av1cdfio.cell_at(m, av1mv.mv_cdf_sign(ctx, comp)) != 16384 {
                return 3
            }
            if av1cdfio.cell_at(m, av1mv.mv_cdf_class(ctx, comp) + 4) != 32551 || av1cdfio.cell_at(m, av1mv.mv_cdf_class(ctx, comp) + 10) != 32768 {
                return 4
            }
            if av1cdfio.cell_at(m, av1mv.mv_cdf_class0_bit(ctx, comp)) != 27648 {
                return 5
            }
            if av1cdfio.cell_at(m, av1mv.mv_cdf_class0_fr(ctx, comp, 1) + 1) != 21248 || av1cdfio.cell_at(m, av1mv.mv_cdf_class0_fr(ctx, comp, 0) + 2) != 26624 {
                return 6
            }
            if av1cdfio.cell_at(m, av1mv.mv_cdf_fr(ctx, comp) + 1) != 17408 {
                return 7
            }
            if av1cdfio.cell_at(m, av1mv.mv_cdf_class0_hp(ctx, comp)) != 20480 || av1cdfio.cell_at(m, av1mv.mv_cdf_hp(ctx, comp)) != 16384 {
                return 8
            }
            if av1cdfio.cell_at(m, av1mv.mv_cdf_bit(ctx, comp, 0)) != 17408 || av1cdfio.cell_at(m, av1mv.mv_cdf_bit(ctx, comp, 9)) != 30720 || av1cdfio.cell_at(m, av1mv.mv_cdf_bit(ctx, comp, 9) + 1) != 32768 {
                return 9
            }
            comp = comp + 1
        }
        ctx = ctx + 1
    }
    av1cdfio.buf_free(m, av1cdfio.MODE_CELLS)
    av1cdfio.buf_free(k, av1cdfio.COEF_CELLS)
    return 0
}

fn check_against_ibc(seed: i64) -> i32 {
    var rng: Rng = Rng { s: seed }
    let n: i64 = 600
    let data: u64 = av1mem.heap_alloc(n as usize) as u64
    var i: i64 = 0
    while i < n {
        *((data + (i as u64)) as *mut u8) = (rng_next(&rng) & 255) as u8
        i = i + 1
    }
    let ps: u64 = av1mem.heap_alloc((av1ibc.IBC_CELLS * 8) as usize) as u64
    let mn: i64 = 64 * 64
    let kind: u64 = av1mem.heap_alloc(mn as usize) as u64
    let mvs: u64 = av1mem.heap_alloc((mn * 4) as usize) as u64
    let mis: u64 = av1mem.heap_alloc(mn as usize) as u64
    let icdf: u64 = av1mem.heap_alloc(256) as u64
    av1ibc.ibc_bind(ps, kind, mvs, mis, icdf, 64, 64)
    av1ibc.ibc_set_tile(ps, 0, 64, 0, 64)
    av1ibc.ibc_set_sb(ps, 0)
    av1ibc.ibc_reset_cdfs(ps)
    let m: u64 = av1cdfio.buf_new(av1cdfio.MODE_CELLS)
    let k: u64 = av1cdfio.buf_new(av1cdfio.COEF_CELLS)
    av1cdfio.load_defaults(0, m, k)
    var s1: av1sym.Sym = av1sym.Sym { p: 0, n: 0, pos: 0, val: 0, rng: 0, maxbits: 0, upd: 0 }
    var s2: av1sym.Sym = av1sym.Sym { p: 0, n: 0, pos: 0, val: 0, rng: 0, maxbits: 0, upd: 0 }
    av1sym.sym_init(&s1, data, n, 1)
    av1sym.sym_init(&s2, data, n, 1)
    let out: u64 = av1mem.heap_alloc(16) as u64
    var rc: i32 = 0
    var t: i64 = 0
    while t < 60 && rc == 0 {
        av1ibc.ibc_decode_mv(ps, &s1, 0, 0, 3, 0, 1, 1)
        let joint: i64 = av1mv.mv_read_diff(&s2, m, av1mv.MV_CTX_INTRABC, 1, 0, out)
        let dr: i64 = *(out as *mut i64)
        let dc: i64 = *((out + 8) as *mut i64)
        if av1ibc.ibc_mv_row(ps) != dr || av1ibc.ibc_mv_col(ps) + 2560 != dc {
            rc = 2
        }
        if av1sym.sym_bits_left(&s1) != av1sym.sym_bits_left(&s2) {
            rc = 3
        }
        if joint < 0 || joint > 3 {
            rc = 4
        }
        t = t + 1
    }
    av1mem.heap_free(data as *mut u8, n as usize)
    av1cdfio.buf_free(m, av1cdfio.MODE_CELLS)
    av1cdfio.buf_free(k, av1cdfio.COEF_CELLS)
    return rc
}

fn check_precision(seed: i64) -> i32 {
    var rng: Rng = Rng { s: seed }
    let n: i64 = 4000
    let data: u64 = av1mem.heap_alloc(n as usize) as u64
    var i: i64 = 0
    while i < n {
        *((data + (i as u64)) as *mut u8) = (rng_next(&rng) & 255) as u8
        i = i + 1
    }
    let m: u64 = av1cdfio.buf_new(av1cdfio.MODE_CELLS)
    let k: u64 = av1cdfio.buf_new(av1cdfio.COEF_CELLS)
    av1cdfio.load_defaults(0, m, k)
    var sy: av1sym.Sym = av1sym.Sym { p: 0, n: 0, pos: 0, val: 0, rng: 0, maxbits: 0, upd: 0 }
    av1sym.sym_init(&sy, data, n, 1)
    let out: u64 = av1mem.heap_alloc(16) as u64
    var mode: i64 = 0
    var big: i64 = 0
    var t: i64 = 0
    while t < 400 {
        mode = t % 3
        var force_int: i64 = 0
        var hp: i64 = 0
        if mode == 0 {
            force_int = 1
        }
        if mode == 2 {
            hp = 1
        }
        av1mv.mv_read_diff(&sy, m, 0, force_int, hp, out)
        let dr: i64 = *(out as *mut i64)
        let dc: i64 = *((out + 8) as *mut i64)
        if mode == 0 && ((dr & 7) != 0 || (dc & 7) != 0) {
            return 1
        }
        if mode == 1 && ((dr & 1) != 0 || (dc & 1) != 0) {
            return 2
        }
        if dr > 16384 || dr < 0 - 16384 || dc > 16384 || dc < 0 - 16384 {
            return 3
        }
        if dr > 64 || dr < 0 - 64 {
            big = big + 1
        }
        t = t + 1
    }
    if big == 0 {
        return 4
    }
    av1mem.heap_free(data as *mut u8, n as usize)
    av1cdfio.buf_free(m, av1cdfio.MODE_CELLS)
    av1cdfio.buf_free(k, av1cdfio.COEF_CELLS)
    return 0
}

fn main() -> i32 {
    let a: i32 = check_defaults()
    if a != 0 {
        return 10 + a
    }
    var seed: i64 = 1
    while seed < 9 {
        let b: i32 = check_against_ibc(seed * 7919)
        if b != 0 {
            return 20 + b
        }
        seed = seed + 1
    }
    let c: i32 = check_precision(99)
    if c != 0 {
        return 40 + c
    }
    return 42
}
