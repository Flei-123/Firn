// expect_exit: 0
// tests/822_iface_gc_core.fi -- THE COLLECTOR AND THE FAT POINTER (round 46).
//
// The question this test answers: does the collector still find an object
// when it only stands BEHIND an interface value any more?
//
// The setup:
//
//   * `gc class Cell` -- the objects live on the GC heap
//   * `impl Counter for Cell` -- the receiver `*self` is thereby `Gc[Cell]`
//   * 64 cells are created and stored EXCLUSIVELY as `dyn Counter` in an
//     array in the frame
//   * after that `garbage(20000)` makes plenty of rubbish: cells that nobody
//     reaches any more. The collector runs at the allocation sites by itself
//     (SPEC 3.5.3) and releases their memory for reuse.
//   * IF THE FAT POINTERS WERE NO ROOTS, the 64 cells would be swept along
//     and their memory given to the rubbish. The values afterwards would be
//     garbage. Exactly that is what `sum` checks after every step.
//   * `add` writes into the same objects through the interface
//
// That the collector really collects (and that the test is not green just
// because nothing is ever swept) is shown by the count after the collection:
// of 20,064 cells at most 200 are alive afterwards -- and the 64 from the
// array are among them.

interface Counter {
    fn value(*self) -> i64
    fn add(*mut self, k: i64)
}

gc class Cell { n: i64 }

impl Counter for Cell {
    fn value(*self) -> i64 { return (*self).n }
    fn add(*mut self, k: i64) { (*self).n = (*self).n + k }
}

fn build(i: i64) -> Gc[Cell] {
    return gc Cell { n: i } catch gc_null[Cell]()
}

// Rubbish: the cells are unreachable after every loop pass.
fn garbage(n: i64) -> i64 {
    var i: i64 = 0
    var s: i64 = 0
    while i < n {
        let z: Gc[Cell] = build(i)
        if z == gc_null[Cell]() {
            return -1
        }
        s = s + 1
        i = i + 1
    }
    return s
}

fn sum(field: *mut [dyn Counter; 64]) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < 64 {
        s = s + (*field)[i].value()
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    var field: [dyn Counter; 64] = [(build(0)) as dyn Counter; 64]
    var i: i64 = 0
    while i < 64 {
        field[i as usize] = (build(i)) as dyn Counter
        i = i + 1
    }
    // 0+1+...+63 = 2016
    if sum(&field) != 2016 {
        return 1
    }
    // Produce plenty of rubbish. The runtime collects by itself while doing so.
    if garbage(20000) != 20000 {
        return 2
    }
    // The 64 cells live unchanged -- the data pointer in the fat pointer is a
    // real root.
    if sum(&field) != 2016 {
        return 3
    }
    gc_collect()
    gc_collect()
    if gc_collections() < 2 {
        return 4
    }
    // AFTER the collection: the 64 live, the 20,000 do not. The upper limit
    // leaves room for the few accidental hits of the conservative
    // stack scan (the same calculation as in tests/510).
    if gc_live_objects() < 64 {
        return 5
    }
    if gc_live_objects() > 200 {
        return 6
    }
    if sum(&field) != 2016 {
        return 11
    }
    // write through the interface -- it hits the same objects
    var k: usize = 0
    while k < 64 {
        field[k].add(2)
        k = k + 1
    }
    if sum(&field) != 2016 + 128 {
        return 7
    }
    if garbage(20000) != 20000 {
        return 8
    }
    if sum(&field) != 2016 + 128 {
        return 9
    }
    // The memory stays bounded: 40,000 unreachable cells were really
    // reused.
    if gc_heap_bytes() > 8388608 {
        return 10
    }
    return 0
}
