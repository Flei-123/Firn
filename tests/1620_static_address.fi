// expect_out: hello, world
// ROUND BOOTSTRAP -- THE ADDRESS OF A `static`.
//
// `docs/OSUM-K1.md` section 9 recorded this as a measured gap of the self
// hosted compiler on 2026-08-24: `firnc1` compiled a `static` array and
// read out of it, but taking its ADDRESS ended in `exit 1` without a word.
// The reason was in `lib/firnc1/sema.fi`: `lvalue` decided in ONE place
// whether something is a place AND whether it may be written to, and
// `static MSG` without `mut` may not be written to -- so `&MSG` counted as
// an attempt to write. `firnc0` has always kept the two apart
// (`sema.rs::lvalue` yields the type AND the mutability, and only the
// assigning statements look at the second).
//
// Four shapes, all of which have to work in BOTH compilers:
//   a  read out of an immutable `static` array
//   b  the address of an element:      `&MSG[0]`
//   c  the address of the whole array: `&MSG`
//   d  the address of a field of an immutable `static` struct
// and, as the counter-check, `static mut` still counts up
// (tests/neg/static_write_without_mut.fi is the other half: writing to an
// immutable `static` stays an error).

static MSG: [u8; 13] = "hello, world\n"
static mut COUNT: u64 = 0

struct Pair { a: u64, b: u64 }
static PAIR: Pair = Pair { a: 3, b: 4 }

fn main() -> i32 {
    // b -- the address of an element, handed to write(2)
    syscall(1, 1, (&MSG[0]) as u64, 13)
    // a -- reading still works
    if MSG[0] != 104 as u8 {
        return 1
    }
    // c -- the address of the whole array
    let whole: u64 = (&MSG) as u64
    if whole == 0 {
        return 2
    }
    if whole != (&MSG[0]) as u64 {
        return 3
    }
    // d -- the address of a field of a `static` struct
    let pb: u64 = (&PAIR.b) as u64
    if pb == 0 {
        return 4
    }
    if pb - (&PAIR.a) as u64 != 8 {
        return 5
    }
    if PAIR.a + PAIR.b != 7 {
        return 6
    }
    // the counter-check: `static mut` is still writable
    COUNT = COUNT + 1
    if COUNT != 1 {
        return 7
    }
    return 0
}
