// expect_exit: 155
// Several cases with the same key: the chain behind the jump label tries
// them in source order and finally falls into the catch-all arm.
enum Value { Number(i32), Text(u8), Empty }

fn class(w: *Value) -> i32 {
    var r: i32 = 0
    match *w {
        Value::Number(0) => { r = 1 as i32 }
        Value::Number(1..= 5) => { r = 2 as i32 }
        Value::Number(x) => { r = 3 as i32 + x }
        Value::Text(7) => { r = 40 as i32 }
        _ => { r = 50 as i32 }
    }
    return r
}

fn main() -> i32 {
    var sum: i32 = 0
    var a = Value::Number(0 as i32)
    var b = Value::Number(4 as i32)
    var c = Value::Number(9 as i32)
    var d = Value::Text(7 as u8)
    var e = Value::Text(8 as u8)
    var f = Value::Empty
    sum = sum + class(&a)
    sum = sum + class(&b)
    sum = sum + class(&c)
    sum = sum + class(&d)
    sum = sum + class(&e)
    sum = sum + class(&f)
    return sum
}
