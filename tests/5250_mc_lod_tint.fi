// expect_exit: 0
import std.rt
import mc.mc_mesh
import mc.mc_texture
import mc.mc_lod_tint

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn name_class(s: str) -> u32 {
    return mc_lod_tint.twin_class_of_name(s.p as u64, s.n)
}

fn main() -> i32 {
    check(name_class("grass_block") == mc_lod_tint.CLS_GRASS, 1)
    check(name_class("oak_leaves") == mc_lod_tint.CLS_FOLIAGE, 2)
    check(name_class("dark_oak_leaves") == mc_lod_tint.CLS_FOLIAGE, 3)
    check(name_class("birch_leaves") == mc_lod_tint.CLS_BIRCH, 4)
    check(name_class("spruce_leaves") == mc_lod_tint.CLS_SPRUCE, 5)
    check(name_class("azalea_leaves") == mc_lod_tint.CLS_NONE, 6)
    check(name_class("grass_block_snowy") == mc_lod_tint.CLS_NONE, 7)
    check(name_class("stone") == mc_lod_tint.CLS_NONE, 8)

    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    mc_lod_tint.twin_clear(tb.tiles)
    mc_lod_tint.twin_mark(tb.tiles, 5 as u32, mc_lod_tint.CLS_GRASS)
    mc_lod_tint.twin_mark(tb.tiles, 6 as u32, mc_lod_tint.CLS_BIRCH)
    mc_lod_tint.twin_mark(tb.tiles, 7 as u32, mc_lod_tint.CLS_FOLIAGE)
    let used: usize = mc_lod_tint.twin_assign(tb.tiles, 20 as u32)
    check(used == 17, 10)
    check(mc_lod_tint.twin_tile(tb.tiles, 5 as u32, 0) == 20 as u32, 11)
    check(mc_lod_tint.twin_tile(tb.tiles, 5 as u32, 7) == 27 as u32, 12)
    check(mc_lod_tint.twin_tile(tb.tiles, 6 as u32, 3) == 28 as u32, 13)
    check(mc_lod_tint.twin_tile(tb.tiles, 7 as u32, 2) == 31 as u32, 14)
    check(mc_lod_tint.twin_tile(tb.tiles, 8 as u32, 2) == 8 as u32, 15)

    var a: mc_texture.Atlas = mc_texture.atlas_new(16, 8, 8)
    check(a.px != 0, 20)
    var white: [u32; 256] = [0xFFFFFFFF as u32; 256]
    var t: u32 = 5 as u32
    while t <= 7 as u32 {
        check(mc_texture.atlas_set_tile(&a, t, (&white) as u64), 21)
        t = t + 1 as u32
    }
    mc_lod_tint.twins_fill(&a, tb.tiles, 7 as u32)
    check(mc_texture.atlas_texel(&a, 24 as u32, 3, 4) == mc_texture.pack_pixel(0x91 as u32, 0xBD as u32, 0x59 as u32, 255 as u32), 22)
    check(mc_texture.atlas_texel(&a, 28 as u32, 0, 0) == mc_texture.pack_pixel(0x80 as u32, 0xA7 as u32, 0x55 as u32, 255 as u32), 23)
    check(mc_texture.atlas_texel(&a, 5 as u32, 0, 0) == 0xFFFFFFFF as u32, 24)

    check(mc_lod_tint.pal_nearest(mc_lod_tint.CLS_GRASS, 0x91BD59 as u32) == 4, 30)
    check(mc_lod_tint.pal_nearest(mc_lod_tint.CLS_GRASS, 0x7FB398 as u32) == 2, 31)
    check(mc_lod_tint.pal_nearest(mc_lod_tint.CLS_FOLIAGE, 0xB0A030 as u32) == 7, 32)

    let btab: u64 = rt.heap_alloc(3 * mc_lod_tint.MAP_IDS * 4)
    rt.mem_set(btab, 0 as u8, 3 * mc_lod_tint.MAP_IDS * 4)
    rt.st32(btab, 9, 0x1000000 as u32 + 0x80B497 as u32)
    rt.st32(btab, mc_lod_tint.MAP_IDS + 9, 0x1000000 as u32 + 0x33BA0D as u32)
    let pmap: u64 = rt.heap_alloc(2 * mc_lod_tint.MAP_IDS)
    mc_lod_tint.map_build(btab, pmap)
    check(rt.ld8(pmap, 9) == 2 as u8, 40)
    check(rt.ld8(pmap, mc_lod_tint.MAP_IDS + 9) == 0 as u8, 41)
    check(rt.ld8(pmap, 10) == 4 as u8, 42)
    check(mc_lod_tint.resolve_tile(tb.tiles, pmap, 5 as u32, 9 as u16) == 22 as u32, 43)
    check(mc_lod_tint.resolve_tile(tb.tiles, pmap, 7 as u32, 9 as u16) == 29 as u32, 44)
    check(mc_lod_tint.resolve_tile(tb.tiles, pmap, 6 as u32, 9 as u16) == 28 as u32, 45)
    check(mc_lod_tint.resolve_tile(tb.tiles, pmap, 8 as u32, 9 as u16) == 8 as u32, 46)
    check(mc_lod_tint.resolve_tile(tb.tiles, 0, 5 as u32, 9 as u16) == 5 as u32, 47)
    return 0
}
