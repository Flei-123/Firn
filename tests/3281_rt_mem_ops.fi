// expect_exit: 0
// tests/3281_rt_mem_ops.fi -- `rt.mem_copy`, `rt.mem_set`, `rt.mem_eq` and the
// wipe of a cached heap block, against plain octet-by-octet reference loops.
// The three were rewritten with moving pointers and direct accesses (dev-fast
// has no inliner); every length around the 8 and 32 octet round borders and
// every start offset has to give the same octets as the naive loop.
import std.rt

const BUF: usize = 512

fn next_state(x: u64) -> u64 {
    return x *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
}

fn fill(buf: u64, n: usize, seed: u64) {
    var x: u64 = seed
    var i: usize = 0
    while i < n {
        x = next_state(x)
        *((buf + i as u64) as *mut u8) = ((x >> 33) & 255) as u8
        i = i + 1
    }
}

fn at(buf: u64, i: usize) -> u8 {
    return *((buf + i as u64) as *mut u8)
}

fn main() -> i32 {
    let src: u64 = rt.heap_alloc(BUF)
    let dst: u64 = rt.heap_alloc(BUF)
    let ref: u64 = rt.heap_alloc(BUF)
    if src == 0 || dst == 0 || ref == 0 { return 1 }
    fill(src, BUF, 12345 as u64)

    // --- A: mem_copy, disjoint, every length 0..100 and offsets 0..9 ---------
    var n: usize = 0
    while n <= 100 {
        var off: usize = 0
        while off < 10 {
            fill(dst, BUF, 777 as u64)
            fill(ref, BUF, 777 as u64)
            var i: usize = 0
            while i < n {
                *((ref + (off + i) as u64) as *mut u8) = at(src, 3 + i)
                i = i + 1
            }
            rt.mem_copy(dst + off as u64, src + 3 as u64, n)
            i = 0
            while i < BUF {
                if at(dst, i) != at(ref, i) { return 10 }
                i = i + 1
            }
            off = off + 1
        }
        n = n + 1
    }

    // --- B: mem_copy, forward overlap with distance 1..40 (match copy) -------
    var dist: usize = 1
    while dist <= 40 {
        var len: usize = 0
        while len <= 70 {
            fill(dst, BUF, 99 as u64)
            fill(ref, BUF, 99 as u64)
            // reference: the octet loop reads what it has just written. mem_copy
            // promises this only for distances >= 8 (word by word), below that
            // only the octets 0..dist are meaningful, so those are compared.
            var i: usize = 0
            while i < len {
                *((ref + (dist + i) as u64) as *mut u8) = at(ref, i)
                i = i + 1
            }
            rt.mem_copy(dst + dist as u64, dst, len)
            if dist >= 8 {
                i = 0
                while i < BUF {
                    if at(dst, i) != at(ref, i) { return 20 }
                    i = i + 1
                }
            }
            len = len + 1
        }
        dist = dist + 1
    }

    // --- C: mem_set, every length and offset ---------------------------------
    n = 0
    while n <= 100 {
        var off: usize = 0
        while off < 10 {
            fill(dst, BUF, 5 as u64)
            fill(ref, BUF, 5 as u64)
            var i: usize = 0
            while i < n {
                *((ref + (off + i) as u64) as *mut u8) = 171 as u8
                i = i + 1
            }
            rt.mem_set(dst + off as u64, 171 as u8, n)
            i = 0
            while i < BUF {
                if at(dst, i) != at(ref, i) { return 30 }
                i = i + 1
            }
            off = off + 1
        }
        n = n + 1
    }

    // --- D: mem_eq, equal and one octet different at every position ---------
    fill(dst, BUF, 12345 as u64)
    n = 0
    while n <= 100 {
        if !rt.mem_eq(src, dst, n) { return 40 }
        var k: usize = 0
        while k < n {
            let keep: u8 = at(dst, k)
            *((dst + k as u64) as *mut u8) = keep ^ 1 as u8
            if rt.mem_eq(src, dst, n) { return 41 }
            if k + 1 < n && !rt.mem_eq(src, dst, k) { return 42 }
            *((dst + k as u64) as *mut u8) = keep
            k = k + 1
        }
        n = n + 1
    }

    // --- E: a block that comes back from the cache is zero over its WHOLE size
    var round: usize = 0
    while round < 6 {
        let blk: u64 = rt.heap_alloc(8192)
        if blk == 0 { return 50 }
        var w: usize = 0
        while w < 8192 {
            if at(blk, w) != 0 as u8 { return 51 }
            w = w + 1
        }
        fill(blk, 8192, round as u64)
        rt.heap_free(blk, 8192)
        round = round + 1
    }

    rt.heap_free(src, BUF)
    rt.heap_free(dst, BUF)
    rt.heap_free(ref, BUF)
    return 0
}
