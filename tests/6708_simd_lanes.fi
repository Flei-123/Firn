// expect_exit: 0
import std.rt
import std.lanes.vf4
import std.lanes.vi4
import std.lanes.vu16
import std.lanes.vf8
import std.lanes.vi8
import std.lanes.vconv
import std.lanes.vmask

const ITERATIONS: i32 = 400

fn next(st: u64) -> u64 {
    var x: u64 = *(st as *mut u64)
    x = x ^ (x << (13 as u64))
    x = x ^ (x >> (7 as u64))
    x = x ^ (x << (17 as u64))
    *(st as *mut u64) = x
    return x
}

fn rf(st: u64) -> f32 {
    return (((next(st) % (4096 as u64)) as i32 - 2048) as f32) / (8.0 as f32)
}

fn rsmall(st: u64) -> i32 {
    return ((next(st) % (60000 as u64)) as i32) - 30000
}

fn rfull(st: u64) -> i32 {
    return (next(st) >> (11 as u64)) as% i32
}

fn rbyte(st: u64) -> u8 {
    return ((next(st) >> (9 as u64)) & (255 as u64)) as u8
}

fn fill_f(p: u64, n: i32, st: u64) {
    var i: i32 = 0
    while i < n {
        *((p + (i * 4) as u64) as *mut f32) = rf(st)
        i = i + 1
    }
}

fn fill_i(p: u64, n: i32, st: u64, full: bool) {
    var i: i32 = 0
    while i < n {
        if full { *((p + (i * 4) as u64) as *mut i32) = rfull(st) } else { *((p + (i * 4) as u64) as *mut i32) = rsmall(st) }
        i = i + 1
    }
}

fn fill_b(p: u64, st: u64) {
    var i: i32 = 0
    while i < 16 {
        *((p + i as u64) as *mut u8) = rbyte(st)
        i = i + 1
    }
}

fn gf(p: u64, i: i32) -> f32 { return *((p + (i * 4) as u64) as *mut f32) }
fn gi(p: u64, i: i32) -> i32 { return *((p + (i * 4) as u64) as *mut i32) }
fn gb(p: u64, i: i32) -> u8 { return *((p + i as u64) as *mut u8) }

fn ref_f(op: i32, x: f32, y: f32) -> f32 {
    if op == 0 { return x + y }
    if op == 1 { return x - y }
    if op == 2 { return x * y }
    if op == 3 { return x / (y * y + (0.5 as f32)) }
    if op == 4 { if x < y { return x } else { return y } }
    if op == 5 { if x > y { return x } else { return y } }
    if op == 6 { return __sqrt(y * y) }
    if op == 7 { if x < (0.0 as f32) { return (0.0 as f32) - x } else { return x } }
    if op == 8 { return (0.0 as f32) - x }
    return x * y + y
}

fn run_f4(op: i32, a: vf4.f32x4, b: vf4.f32x4) -> vf4.f32x4 {
    if op == 0 { return a.add(b) }
    if op == 1 { return a.sub(b) }
    if op == 2 { return a.mul(b) }
    if op == 3 { return a.div(b.mul(b).add(vf4.splat(0.5 as f32))) }
    if op == 4 { return a.min(b) }
    if op == 5 { return a.max(b) }
    if op == 6 { return b.mul(b).sqrt() }
    if op == 7 { return a.abs() }
    if op == 8 { return a.neg() }
    return a.mul_add(b, b)
}

fn run_f8(op: i32, a: vf8.f32x8, b: vf8.f32x8) -> vf8.f32x8 {
    if op == 0 { return a.add(b) }
    if op == 1 { return a.sub(b) }
    if op == 2 { return a.mul(b) }
    if op == 3 { return a.div(b.mul(b).add(vf8.splat(0.5 as f32))) }
    if op == 4 { return a.min(b) }
    if op == 5 { return a.max(b) }
    if op == 6 { return b.mul(b).sqrt() }
    if op == 7 { return a.abs() }
    if op == 8 { return a.neg() }
    return a.mul_add(b, b)
}

fn cmp_f(op: i32, x: f32, y: f32) -> bool {
    if op == 0 { return x < y }
    if op == 1 { return x <= y }
    if op == 2 { return x > y }
    if op == 3 { return x >= y }
    if op == 4 { return x == y }
    return x != y
}

fn cmp_f4(op: i32, a: vf4.f32x4, b: vf4.f32x4) -> vmask.mask4 {
    if op == 0 { return a.lt(b) }
    if op == 1 { return a.le(b) }
    if op == 2 { return a.gt(b) }
    if op == 3 { return a.ge(b) }
    if op == 4 { return a.eq(b) }
    return a.ne(b)
}

fn cmp_f8(op: i32, a: vf8.f32x8, b: vf8.f32x8) -> vmask.mask8 {
    if op == 0 { return a.lt(b) }
    if op == 1 { return a.le(b) }
    if op == 2 { return a.gt(b) }
    return a.ge(b)
}

fn ref_i(op: i32, x: i32, y: i32) -> i32 {
    if op == 0 { return (x as i64 + y as i64) as% i32 }
    if op == 1 { return (x as i64 - y as i64) as% i32 }
    if op == 2 { return (x as i64 * y as i64) as% i32 }
    if op == 3 { return x & y }
    if op == 4 { return x | y }
    if op == 5 { return x ^ y }
    if op == 6 { if x < y { return x } else { return y } }
    if op == 7 { if x > y { return x } else { return y } }
    if op == 8 { return (0 as i64 - x as i64) as% i32 }
    if op == 9 { if x < 0 { return (0 as i64 - x as i64) as% i32 } else { return x } }
    if op == 10 { return (x as% u32 >> (8 as u32)) as% i32 }
    if op == 11 { return ((x as% u32) << (16 as u32)) as% i32 }
    return x ^ (0 - 1)
}

fn run_i4(op: i32, a: vi4.i32x4, b: vi4.i32x4) -> vi4.i32x4 {
    if op == 0 { return a.add(b) }
    if op == 1 { return a.sub(b) }
    if op == 2 { return a.mul(b) }
    if op == 3 { return a.and(b) }
    if op == 4 { return a.or(b) }
    if op == 5 { return a.xor(b) }
    if op == 6 { return a.min(b) }
    if op == 7 { return a.max(b) }
    if op == 8 { return a.neg() }
    if op == 9 { return a.abs() }
    if op == 10 { return a.shr8() }
    if op == 11 { return a.shl16() }
    return a.not()
}

fn run_i8(op: i32, a: vi8.i32x8, b: vi8.i32x8) -> vi8.i32x8 {
    if op == 0 { return a.add(b) }
    if op == 1 { return a.sub(b) }
    if op == 2 { return a.mul(b) }
    if op == 3 { return a.and(b) }
    if op == 4 { return a.or(b) }
    if op == 5 { return a.xor(b) }
    if op == 6 { return a.min(b) }
    return a.max(b)
}

fn cmp_i(op: i32, x: i32, y: i32) -> bool {
    if op == 0 { return x < y }
    if op == 1 { return x <= y }
    if op == 2 { return x > y }
    if op == 3 { return x >= y }
    if op == 4 { return x == y }
    return x != y
}

fn cmp_i4(op: i32, a: vi4.i32x4, b: vi4.i32x4) -> vmask.mask4 {
    if op == 0 { return a.lt(b) }
    if op == 1 { return a.le(b) }
    if op == 2 { return a.gt(b) }
    if op == 3 { return a.ge(b) }
    if op == 4 { return a.eq(b) }
    return a.ne(b)
}

fn ref_b(op: i32, x: u8, y: u8) -> u8 {
    let p: u32 = x as u32
    let q: u32 = y as u32
    if op == 0 { return ((p + q) & (255 as u32)) as u8 }
    if op == 1 { return ((p + (256 as u32) - q) & (255 as u32)) as u8 }
    if op == 2 { if p + q > (255 as u32) { return 255 as u8 } else { return (p + q) as u8 } }
    if op == 3 { if p > q { return (p - q) as u8 } else { return 0 as u8 } }
    if op == 4 { if p < q { return x } else { return y } }
    if op == 5 { if p > q { return x } else { return y } }
    if op == 6 { if p > q { return (p - q) as u8 } else { return (q - p) as u8 } }
    if op == 7 { return (p & q) as u8 }
    if op == 8 { return (p | q) as u8 }
    return (p ^ q) as u8
}

fn run_b(op: i32, a: vu16.u8x16, b: vu16.u8x16) -> vu16.u8x16 {
    if op == 0 { return a.add(b) }
    if op == 1 { return a.sub(b) }
    if op == 2 { return a.add_sat(b) }
    if op == 3 { return a.sub_sat(b) }
    if op == 4 { return a.min(b) }
    if op == 5 { return a.max(b) }
    if op == 6 { return a.abs_diff(b) }
    if op == 7 { return a.and(b) }
    if op == 8 { return a.or(b) }
    return a.xor(b)
}

fn cmp_b(op: i32, x: u8, y: u8) -> bool {
    if op == 0 { return x < y }
    if op == 1 { return x <= y }
    if op == 2 { return x > y }
    if op == 3 { return x >= y }
    if op == 4 { return x == y }
    return x != y
}

fn cmp_b16(op: i32, a: vu16.u8x16, b: vu16.u8x16) -> vu16.mask16 {
    if op == 0 { return a.lt(b) }
    if op == 1 { return a.le(b) }
    if op == 2 { return a.gt(b) }
    if op == 3 { return a.ge(b) }
    if op == 4 { return a.eq(b) }
    return a.ne(b)
}

fn test_f4(pa: u64, pb: u64, st: u64) -> i32 {
    fill_f(pa, 4, st)
    fill_f(pb, 4, st)
    let a: vf4.f32x4 = vf4.load(pa)
    let b: vf4.f32x4 = vf4.load(pb)
    var op: i32 = 0
    while op < 10 {
        let r: vf4.f32x4 = run_f4(op, a, b)
        var i: i32 = 0
        while i < 4 {
            if r.lane(i) != ref_f(op, gf(pa, i), gf(pb, i)) { return 100 + op }
            i = i + 1
        }
        op = op + 1
    }
    op = 0
    while op < 6 {
        let m: u32 = cmp_f4(op, a, b).bits()
        var i: i32 = 0
        while i < 4 {
            let bit: bool = ((m >> (i as u32)) & (1 as u32)) != (0 as u32)
            if bit != cmp_f(op, gf(pa, i), gf(pb, i)) { return 120 + op }
            i = i + 1
        }
        op = op + 1
    }
    let s: vf4.f32x4 = vf4.select(a.lt(b), a, b)
    var i: i32 = 0
    while i < 4 {
        if s.lane(i) != ref_f(4, gf(pa, i), gf(pb, i)) { return 130 }
        i = i + 1
    }
    if a.hsum() != (gf(pa, 0) + gf(pa, 1)) + (gf(pa, 2) + gf(pa, 3)) { return 131 }
    if a.dot(b) != (gf(pa, 0) * gf(pb, 0) + gf(pa, 1) * gf(pb, 1)) + (gf(pa, 2) * gf(pb, 2) + gf(pa, 3) * gf(pb, 3)) { return 132 }
    var mn: f32 = gf(pa, 0)
    var mx: f32 = gf(pa, 0)
    i = 1
    while i < 4 {
        mn = ref_f(4, mn, gf(pa, i))
        mx = ref_f(5, mx, gf(pa, i))
        i = i + 1
    }
    if a.hmin() != mn { return 133 }
    if a.hmax() != mx { return 134 }
    if a.reverse().lane(0) != gf(pa, 3) { return 135 }
    if a.reverse().lane(3) != gf(pa, 0) { return 136 }
    if a.swap_pairs().lane(0) != gf(pa, 1) { return 137 }
    if a.swap_halves().lane(1) != gf(pa, 3) { return 138 }
    if a.rotate_left().lane(0) != gf(pa, 1) { return 139 }
    if a.rotate_right().lane(0) != gf(pa, 3) { return 140 }
    if a.broadcast(2).lane(0) != gf(pa, 2) { return 141 }
    if a.broadcast(3).lane(2) != gf(pa, 3) { return 142 }
    if a.dup_even().lane(1) != gf(pa, 0) { return 143 }
    if a.dup_odd().lane(0) != gf(pa, 1) { return 144 }
    if a.interleave_lo(b).lane(1) != gf(pb, 0) { return 145 }
    if a.interleave_hi(b).lane(2) != gf(pa, 3) { return 146 }
    let c: vi4.i32x4 = vconv.f32x4_to_i32x4(a)
    i = 0
    while i < 4 {
        if c.lane(i) != (gf(pa, i) as i32) { return 147 }
        if vconv.i32x4_to_f32x4(c).lane(i) != ((gf(pa, i) as i32) as f32) { return 148 }
        i = i + 1
    }
    let st2: u64 = pb + 64
    vf4.store(st2, a)
    i = 0
    while i < 4 {
        if gf(st2, i) != gf(pa, i) { return 149 }
        i = i + 1
    }
    return 0
}

fn test_f8(pa: u64, pb: u64, st: u64) -> i32 {
    fill_f(pa, 8, st)
    fill_f(pb, 8, st)
    let a: vf8.f32x8 = vf8.load(pa)
    let b: vf8.f32x8 = vf8.load(pb)
    var op: i32 = 0
    while op < 10 {
        let r: vf8.f32x8 = run_f8(op, a, b)
        var i: i32 = 0
        while i < 8 {
            if r.lane(i) != ref_f(op, gf(pa, i), gf(pb, i)) { return 200 + op }
            i = i + 1
        }
        op = op + 1
    }
    op = 0
    while op < 4 {
        let m: u32 = cmp_f8(op, a, b).bits()
        var i: i32 = 0
        while i < 8 {
            let bit: bool = ((m >> (i as u32)) & (1 as u32)) != (0 as u32)
            if bit != cmp_f(op, gf(pa, i), gf(pb, i)) { return 220 + op }
            i = i + 1
        }
        op = op + 1
    }
    var sum: f32 = 0.0 as f32
    var mn: f32 = gf(pa, 0)
    var mx: f32 = gf(pa, 0)
    var dot: f32 = 0.0 as f32
    var i: i32 = 0
    while i < 8 {
        sum = sum + gf(pa, i)
        dot = dot + gf(pa, i) * gf(pb, i)
        mn = ref_f(4, mn, gf(pa, i))
        mx = ref_f(5, mx, gf(pa, i))
        i = i + 1
    }
    if a.hsum() != sum { return 230 }
    if a.dot(b) != dot { return 231 }
    if a.hmin() != mn { return 232 }
    if a.hmax() != mx { return 233 }
    if a.reverse().lane(0) != gf(pa, 7) { return 234 }
    if a.swap_halves().lane(0) != gf(pa, 4) { return 235 }
    let w: vf8.f32x8 = vf8.join(a.high(), a.low())
    if w.lane(1) != gf(pa, 5) { return 236 }
    let sel: vf8.f32x8 = vf8.select(a.lt(b), a, b)
    i = 0
    while i < 8 {
        if sel.lane(i) != ref_f(4, gf(pa, i), gf(pb, i)) { return 237 }
        i = i + 1
    }
    let t: vi8.i32x8 = vconv.f32x8_to_i32x8(a)
    i = 0
    while i < 8 {
        if t.lane(i) != (gf(pa, i) as i32) { return 238 }
        if vconv.i32x8_to_f32x8(t).lane(i) != ((gf(pa, i) as i32) as f32) { return 239 }
        i = i + 1
    }
    return 0
}

fn test_i4(pa: u64, pb: u64, st: u64, full: bool) -> i32 {
    fill_i(pa, 4, st, full)
    fill_i(pb, 4, st, full)
    let a: vi4.i32x4 = vi4.load(pa)
    let b: vi4.i32x4 = vi4.load(pb)
    var op: i32 = 0
    while op < 13 {
        let r: vi4.i32x4 = run_i4(op, a, b)
        var i: i32 = 0
        while i < 4 {
            if r.lane(i) != ref_i(op, gi(pa, i), gi(pb, i)) { return 300 + op }
            i = i + 1
        }
        op = op + 1
    }
    op = 0
    while op < 6 {
        let m: u32 = cmp_i4(op, a, b).bits()
        var i: i32 = 0
        while i < 4 {
            let bit: bool = ((m >> (i as u32)) & (1 as u32)) != (0 as u32)
            if bit != cmp_i(op, gi(pa, i), gi(pb, i)) { return 320 + op }
            i = i + 1
        }
        op = op + 1
    }
    var sum: i32 = 0
    var mn: i32 = gi(pa, 0)
    var mx: i32 = gi(pa, 0)
    var i: i32 = 0
    while i < 4 {
        sum = ref_i(0, sum, gi(pa, i))
        mn = ref_i(6, mn, gi(pa, i))
        mx = ref_i(7, mx, gi(pa, i))
        i = i + 1
    }
    if a.hsum() != sum { return 330 }
    if a.hmin() != mn { return 331 }
    if a.hmax() != mx { return 332 }
    if a.reverse().lane(0) != gi(pa, 3) { return 333 }
    if a.broadcast(1).lane(3) != gi(pa, 1) { return 334 }
    if a.interleave_lo(b).lane(2) != gi(pa, 1) { return 335 }
    if a.interleave_hi(b).lane(1) != gi(pb, 2) { return 336 }
    let m: vi4.i32x4 = vi4.select(a.lt(b), a, b)
    i = 0
    while i < 4 {
        if m.lane(i) != ref_i(6, gi(pa, i), gi(pb, i)) { return 337 }
        i = i + 1
    }
    return 0
}

fn test_i8(pa: u64, pb: u64, st: u64, full: bool) -> i32 {
    fill_i(pa, 8, st, full)
    fill_i(pb, 8, st, full)
    let a: vi8.i32x8 = vi8.load(pa)
    let b: vi8.i32x8 = vi8.load(pb)
    var op: i32 = 0
    while op < 8 {
        let r: vi8.i32x8 = run_i8(op, a, b)
        var i: i32 = 0
        while i < 8 {
            if r.lane(i) != ref_i(op, gi(pa, i), gi(pb, i)) { return 400 + op }
            i = i + 1
        }
        op = op + 1
    }
    var sum: i32 = 0
    var i: i32 = 0
    while i < 8 {
        sum = ref_i(0, sum, gi(pa, i))
        i = i + 1
    }
    if a.hsum() != sum { return 410 }
    if a.swap_halves().lane(0) != gi(pa, 4) { return 411 }
    return 0
}

fn test_b(pa: u64, pb: u64, st: u64) -> i32 {
    fill_b(pa, st)
    fill_b(pb, st)
    var j: i32 = 0
    while j < 16 {
        if (next(st) & (3 as u64)) == (0 as u64) { *((pb + j as u64) as *mut u8) = gb(pa, j) }
        j = j + 1
    }
    let a: vu16.u8x16 = vu16.load(pa)
    let b: vu16.u8x16 = vu16.load(pb)
    var op: i32 = 0
    while op < 10 {
        let r: vu16.u8x16 = run_b(op, a, b)
        var i: i32 = 0
        while i < 16 {
            if r.lane(i) != ref_b(op, gb(pa, i), gb(pb, i)) { return 500 + op }
            i = i + 1
        }
        op = op + 1
    }
    op = 0
    while op < 6 {
        let m: u32 = cmp_b16(op, a, b).bits()
        var i: i32 = 0
        while i < 16 {
            let bit: bool = ((m >> (i as u32)) & (1 as u32)) != (0 as u32)
            if bit != cmp_b(op, gb(pa, i), gb(pb, i)) { return 520 + op }
            i = i + 1
        }
        op = op + 1
    }
    var sum: u32 = 0
    var i: i32 = 0
    while i < 16 {
        sum = sum + (gb(pa, i) as u32)
        i = i + 1
    }
    if a.hsum() != sum { return 530 }
    let sel: vu16.u8x16 = a.select(a.lt(b), b)
    i = 0
    while i < 16 {
        if sel.lane(i) != ref_b(4, gb(pa, i), gb(pb, i)) { return 531 }
        i = i + 1
    }
    if a.interleave_lo(b).lane(3) != gb(pb, 1) { return 532 }
    if a.interleave_hi(b).lane(4) != gb(pa, 10) { return 533 }
    if vu16.splat(77 as u8).lane(13) != (77 as u8) { return 534 }
    return 0
}

fn main() -> i32 {
    let pa: u64 = rt.heap_alloc(256)
    let pb: u64 = rt.heap_alloc(256)
    let st: u64 = rt.heap_alloc(8)
    *(st as *mut u64) = 0x9e3779b97f4a7c15 as u64
    var k: i32 = 0
    while k < ITERATIONS {
        var r: i32 = test_f4(pa, pb, st)
        if r != 0 { return r }
        r = test_f8(pa, pb, st)
        if r != 0 { return r }
        r = test_i4(pa, pb, st, (k & 1) == 1)
        if r != 0 { return r }
        r = test_i8(pa, pb, st, (k & 1) == 1)
        if r != 0 { return r }
        r = test_b(pa, pb, st)
        if r != 0 { return r }
        k = k + 1
    }
    return 0
}
