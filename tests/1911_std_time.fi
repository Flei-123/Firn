// expect_exit: 42
// tests/1911_std_time.fi -- std.time (OpenPlan LIB-002): clocks, the civil
// calendar, ISO 8601 both ways, and UTC offsets out of TZif files.
//
// The expected instants were computed with Python's datetime (UTC) and the
// offsets with zoneinfo over the same /usr/share/zoneinfo files; the wider
// comparison (thousands of instants in several zones) is
// tools/libmvp/run.sh.
import std.time
import std.str

fn iso(ms: i64) -> str {
    return time.format_iso8601(time.civil_from_unix(ms))
}

fn parses_to(s: str, ms: i64) -> bool {
    let t: time.DateTime = time.parse_iso8601(s) catch time.civil_from_unix(0 - 1)
    return time.unix_from_civil(t) == ms
}

// the error a text is refused with: 1 = Syntax, 2 = Range, 0 = accepted
fn refusal(s: str) -> i32 {
    var why: i32 = 0
    let t: time.DateTime = time.parse_iso8601(s) catch |e| (mark(e, &why))
    return why
}

fn mark(e: TimeError, why: *mut i32) -> time.DateTime {
    if e == TimeError::Syntax {
        *why = 1 as i32
    } else if e == TimeError::Range {
        *why = 2 as i32
    } else {
        *why = 9 as i32
    }
    return time.civil_from_unix(0)
}

fn zone_at(path: str, ms: i64) -> i32 {
    var z: time.Tz = time.tz_new()
    let ok: bool = time.tz_load(path, &z) catch false
    if !ok {
        return 9999 as i32
    }
    let off: i32 = time.tz_offset_min(&z, ms) catch 8888 as i32
    time.tz_free(&z)
    return off
}

fn main() -> i32 {
    // --- A. the civil calendar
    if iso(0) != "1970-01-01T00:00:00.000Z" { return 1 as i32 }
    if iso(1790351407123) != "2026-09-25T15:50:07.123Z" { return 2 as i32 }
    if iso(0 - 1) != "1969-12-31T23:59:59.999Z" { return 3 as i32 }
    if iso(951782400000) != "2000-02-29T00:00:00.000Z" { return 4 as i32 }
    if iso(0 - 11670868800000) != "1600-03-01T12:00:00.000Z" { return 5 as i32 }
    // every day from 1600 to 2400 goes there and back, and each is the day
    // after the one before
    var z: i64 = time.days_from_civil(1600, 1 as u32, 1 as u32)
    let stop: i64 = time.days_from_civil(2400, 12 as u32, 31 as u32)
    var prev: time.DateTime = time.civil_from_unix((z - 1) * 86400000)
    while z <= stop {
        let t: time.DateTime = time.civil_from_unix(z * 86400000)
        if time.days_from_civil(t.year, t.month, t.day) != z { return 6 as i32 }
        if t.day == 1 as u32 {
            if prev.day != time.days_in_month(prev.year, prev.month) { return 7 as i32 }
        } else if t.day != prev.day + 1 as u32 || t.month != prev.month {
            return 8 as i32
        }
        prev = t
        z = z + 1
    }
    if !time.is_leap_year(2000) || time.is_leap_year(1900) || !time.is_leap_year(2024) || time.is_leap_year(2026) { return 9 as i32 }
    let fri: time.DateTime = time.civil_from_unix(1790351407123)
    if time.weekday(fri) != 5 as u32 { return 10 as i32 } // Friday
    if time.weekday(time.civil_from_unix(0)) != 4 as u32 { return 11 as i32 } // Thursday
    if time.day_of_year(fri) != 268 as u32 { return 12 as i32 }
    if time.format_date(fri) != "2026-09-25" { return 13 as i32 }

    // --- B. formatting with an offset, and the unix value of it
    var local: time.DateTime = fri
    local.hour = 17 as u32
    local.offset_min = 120 as i32
    if time.format_iso8601(local) != "2026-09-25T17:50:07.123+02:00" { return 20 as i32 }
    if time.unix_from_civil(local) != 1790351407123 { return 21 as i32 }
    local.hour = 10 as u32
    local.minute = 20 as u32
    local.offset_min = 0 - 330 as i32
    if time.format_iso8601(local) != "2026-09-25T10:20:07.123-05:30" { return 22 as i32 }

    // --- C. parsing: the accepted forms
    if !parses_to("2026-09-25T15:50:07.123Z", 1790351407123) { return 30 as i32 }
    if !parses_to("2026-09-25T17:50:07.123+02:00", 1790351407123) { return 31 as i32 }
    if !parses_to("2026-09-25T17:50:07.123+0200", 1790351407123) { return 32 as i32 }
    if !parses_to("2026-09-25 15:50:07.123456789", 1790351407123) { return 33 as i32 }
    if !parses_to("2026-09-25T15:50:07,1239Z", 1790351407123) { return 34 as i32 }
    if !parses_to("  2000-02-29  ", 951782400000) { return 35 as i32 }
    if !parses_to("1970-01-01T00:00", 0) { return 36 as i32 }
    if !parses_to("1969-12-31T23:59:59.999z", 0 - 1) { return 37 as i32 }
    if !parses_to("2026-09-25T15:50:07.1Z", 1790351407100) { return 38 as i32 }
    if !parses_to("2026-09-25T18:50:07.123+03", 1790351407123) { return 39 as i32 }
    // a text written by format_iso8601 comes back as the same instant
    var ms: i64 = 0 - 62135596800000 // 0001-01-01
    while ms < 253402300799999 { // 9999-12-31
        let t: time.DateTime = time.parse_iso8601(iso(ms)) catch time.civil_from_unix(0)
        if time.unix_from_civil(t) != ms { return 40 as i32 }
        ms = ms + 7777777777777
    }
    // --- the refused ones
    if refusal("2026-09-25T15:50:07Z") != 0 { return 50 as i32 }
    if refusal("2026-13-01") != 2 { return 51 as i32 }
    if refusal("2026-02-29") != 2 { return 52 as i32 }
    if refusal("2026-04-31") != 2 { return 53 as i32 }
    if refusal("2026-09-25T24:00") != 2 { return 54 as i32 }
    if refusal("2026-09-25T23:60") != 2 { return 55 as i32 }
    if refusal("2026-09-25T23:59:60") != 2 { return 56 as i32 }
    if refusal("2026-9-25") != 1 { return 57 as i32 }
    if refusal("25.09.2026") != 1 { return 58 as i32 }
    if refusal("2026-09-25T15:50Zx") != 1 { return 59 as i32 }
    if refusal("2026-09-25T15:50+25:00") != 2 { return 60 as i32 }
    if refusal("") != 1 { return 61 as i32 }
    if refusal("2026-09-25T15:50:07.") != 1 { return 62 as i32 }
    if refusal("2026-09-25T15:50:07.1234567890") != 1 { return 63 as i32 }
    if refusal("2026-09-25X15:50") != 1 { return 64 as i32 }
    if refusal("+2026-09-25") != 0 { return 65 as i32 }
    if refusal("-0044-03-15") != 0 { return 66 as i32 }

    // --- D. time zones out of TZif files
    let wien: str = "/usr/share/zoneinfo/Europe/Vienna"
    if zone_at(wien, 1790351407123) != 120 as i32 { return 70 as i32 } // summer 2026
    if zone_at(wien, 1767225600000) != 60 as i32 { return 71 as i32 } // 2026-01-01
    // the change in March: 01:00 UTC exactly, one millisecond before
    if zone_at(wien, 1774746000000) != 120 as i32 { return 72 as i32 }
    if zone_at(wien, 1774746000000 - 1) != 60 as i32 { return 73 as i32 }
    if zone_at(wien, 1792890000000) != 60 as i32 { return 74 as i32 }
    if zone_at(wien, 1792890000000 - 1) != 120 as i32 { return 75 as i32 }
    // 2050: past the table, the footer rule answers
    if zone_at(wien, 2540246400000) != 120 as i32 { return 76 as i32 }
    if zone_at(wien, 2524608000000) != 60 as i32 { return 77 as i32 }
    if zone_at(wien, 0 - 2208988800000) != 60 as i32 { return 78 as i32 } // 1900
    if zone_at("/usr/share/zoneinfo/America/New_York", 1782864000000) != 0 - 240 as i32 { return 79 as i32 }
    // the southern half, and a DST of thirty minutes
    if zone_at("/usr/share/zoneinfo/Australia/Lord_Howe", 1782864000000) != 630 as i32 { return 80 as i32 }
    if zone_at("/usr/share/zoneinfo/Australia/Lord_Howe", 1767225600000) != 660 as i32 { return 81 as i32 }
    if zone_at("/usr/share/zoneinfo/Etc/UTC", 1790351407123) != 0 as i32 { return 82 as i32 }
    // not a zone file / no file
    if zone_at("/proc/self/status", 0) != 9999 as i32 { return 83 as i32 }
    if zone_at("/no/such/zone", 0) != 9999 as i32 { return 84 as i32 }
    var tz: time.Tz = time.tz_new()
    time.tz_load(wien, &tz) catch false
    if time.tz_rule(&tz) != "CET-1CEST,M3.5.0,M10.5.0/3" { return 85 as i32 }
    time.tz_free(&tz)
    // the local zone of this machine: whatever it is, a sane offset
    let lo: i32 = time.local_offset_min(time.now_unix_ms()) catch 0 as i32
    if lo < 0 - 720 as i32 || lo > 840 as i32 { return 86 as i32 }

    // --- E. clocks
    let now: i64 = time.now_unix_ms()
    if now < 1767225600000 || now > 4102444800000 { return 90 as i32 }
    let ns: i64 = time.now_unix_ns()
    if ns / 1000000 < now || ns / 1000000 > now + 60000 { return 91 as i32 }
    let m1: u64 = time.monotonic_ns()
    var spin: u64 = 0
    var k: u64 = 0
    while k < 100000 {
        spin = spin +% k
        k = k + 1
    }
    let m2: u64 = time.monotonic_ns()
    if m2 < m1 { return 92 as i32 }
    if spin == 7 as u64 { return 93 as i32 }
    return 42
}
