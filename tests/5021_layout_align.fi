// expect_exit: 0
#[align(16)]
struct A {
    a: u8,
}

#[align(64)]
struct B {
    a: u8,
    b: u32,
}

#[align(2)]
struct C {
    a: u32,
}

#[packed]
#[align(8)]
struct D {
    a: u8,
    b: u32,
}

struct W {
    x: u8,
    b: B,
    y: u8,
}

fn mod64(p: u64) -> u64 {
    return p % 64
}

fn first(b: B) -> u8 {
    return b.a
}

fn main() -> i32 {
    if size_of[A]() != 16 {
        return 1
    }
    if size_of[B]() != 64 {
        return 2
    }
    if size_of[C]() != 4 {
        return 3
    }
    if size_of[D]() != 8 {
        return 4
    }
    if size_of[W]() != 192 {
        return 5
    }
    var b: B = B { a: 9, b: 8 }
    if mod64((&b) as u64) != 0 {
        return 6
    }
    var arr: [B; 3] = [b, b, b]
    if mod64((&arr[0]) as u64) != 0 {
        return 7
    }
    if mod64((&arr[2]) as u64) != 0 {
        return 8
    }
    var w: W = W { x: 1, b: b, y: 2 }
    if mod64((&w) as u64) != 0 {
        return 9
    }
    if mod64((&w.b) as u64) != 0 {
        return 10
    }
    if ((&w.y) as u64) - ((&w) as u64) != 128 {
        return 11
    }
    var i: u32 = 0
    while i < 4 {
        var loc: B = B { a: 3, b: i }
        if mod64((&loc) as u64) != 0 {
            return 12
        }
        if loc.b != i {
            return 13
        }
        i = i + 1
    }
    if first(b) != 9 {
        return 14
    }
    var d: D = D { a: 1, b: 2 }
    if ((&d.b) as u64) - ((&d.a) as u64) != 1 {
        return 15
    }
    if d.b != 2 {
        return 16
    }
    return 0
}
