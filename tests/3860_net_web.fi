// expect_exit: 0
// wasm_skip: sockets and threads
// tests/3860_net_web.fi -- net.web (get/post/download against http.server in a thread), http.server
// listen()/port() with port 0, env.get_int, io.fmt_string, rt.buf_str.
import std.rt
import std.io
import std.net
import std.env
import std.fs
import std.testkit
import http.server as srv
import net.web

fn on_echo(r: *mut srv.Req) {
    if srv.method(r) == "POST" {
        srv.reply(r, 201, "text/plain", srv.body(r))
    } else {
        srv.reply(r, 200, "text/plain", "hello web")
    }
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    let a: *mut srv.App = arg as *mut srv.App
    while (*a).running { srv.step(a, 10) }
    return 0
}

#[allow_escape]
fn main() -> i32 {
    var app: srv.App = srv.app(0)
    app.addr = net.ADDR_LOCAL
    srv.set_quiet(&app, true)
    srv.route(&app, "/echo", on_echo)
    testkit.check(srv.listen(&app), "listen on port 0")
    testkit.check(srv.port(&app) != 0 as u16, "the kernel chose a port")
    let th: u64 = thread_start(0, (&app) as u64)
    let base: str = io.fmt_string(f"http://127.0.0.1:{srv.port(&app)}")
    var out: rt.Buf = rt.buf_new()
    testkit.check(web.get(base + "/echo", &out) == 200 as u32, "GET status")
    testkit.check(rt.buf_str(&out) == "hello web", "GET body")
    testkit.check(web.post_json(base + "/echo", "{\"a\": 1}", &out) == 201 as u32, "POST status")
    testkit.check(rt.buf_str(&out) == "{\"a\": 1}", "POST body echoed")
    testkit.check(web.get(base + "/missing", &out) == 404 as u32, "404 is an answer")
    let path: str = "/tmp/firn_t3860_web.txt"
    testkit.check(web.download(base + "/echo", path), "download written")
    var back: rt.Buf = rt.buf_new()
    fs.read_file(path, &back) catch 0
    testkit.check(rt.buf_str(&back) == "hello web", "downloaded file content")
    fs.remove(path) catch false
    testkit.check(web.download(base + "/missing", path) == false, "download of a 404 is refused")
    testkit.check(web.get("http://127.0.0.1:1/", &out) == 0 as u32, "refused connect answers 0")
    testkit.check(web.last_error() == 5 as u32, "error number 5 = connect")
    testkit.check(env.get_int("FIRN_T3860_UNSET", 42) == 42, "get_int default")
    srv.stop(&app)
    thread_wait(th)
    return testkit.finish()
}
