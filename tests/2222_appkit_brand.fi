// expect_exit: 0
// tests/2222_appkit_brand.fi -- appkit.brand_osum: the product brand read from the image files, and appkit.brand on a platform without an image brand.
import std.rt
import std.str
import std.io
import appkit.util
import appkit.brand_osum
import appkit.brand

static mut FAILED: u32 = 0

fn check(ok: bool, what: str) -> bool {
    if !ok {
        FAILED = FAILED + 1
        io.print_line("FAIL: " + what)
    }
    return ok
}

fn view(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: rt.buf_len(b) }
}

fn is(b: *mut rt.Buf, want: str) -> bool {
    return util.buf_eq_str(b, want)
}

fn main() -> i32 {
    var b: rt.Buf = rt.buf_new()

    let file: str = "product: Acme OS\nslug: acme\nvendor: Acme Inc\nweb: https://acme.example\n"
    check(brand_osum.brand_from_text(file, "product", &b) && is(&b, "Acme OS"), "product line")
    check(brand_osum.brand_from_text(file, "slug", &b) && is(&b, "acme"), "slug line")
    check(brand_osum.brand_from_text(file, "vendor", &b) && is(&b, "Acme Inc"), "vendor line")
    check(brand_osum.brand_from_text(file, "web", &b) && is(&b, "https://acme.example"), "web line")
    check(!brand_osum.brand_from_text(file, "feed", &b) && rt.buf_len(&b) == 0, "missing key")
    check(brand_osum.brand_from_text("slug:   spaced  \r\nproduct: X", "slug", &b) && is(&b, "spaced"), "padding and CR trimmed")
    check(brand_osum.brand_from_text("slug: a\nproduct: X", "product", &b) && is(&b, "X"), "last line without line feed")
    check(!brand_osum.brand_from_text("productive: no\n", "product", &b), "key prefix is not a key")
    check(!brand_osum.brand_from_text("product:\n", "product", &b), "empty value is no value")
    check(!brand_osum.brand_from_text("", "product", &b), "empty text")

    check(brand_osum.product_from_version("Acme OS (Firn) version 3 build abc image dev\n", &b) && is(&b, "Acme OS"), "version line product")
    check(!brand_osum.product_from_version("version 3 build abc\n", &b), "version line without the marker")
    check(!brand_osum.product_from_version(" (Firn) version 3\n", &b), "version line without a product")

    check(brand_osum.slug_from_product("Acme OS-2", &b) && is(&b, "acmeos2"), "slug derived from the product")
    check(!brand_osum.slug_from_product("--", &b), "slug of nothing")

    check(brand.product_name().n == 0, "no image brand on this platform: product")
    check(brand.product_slug().n == 0, "no image brand on this platform: slug")
    check(brand.vendor_name().n == 0, "no image brand on this platform: vendor")
    check(brand.brand_text("web").n == 0, "no image brand on this platform: web")

    rt.buf_free(&b)
    if FAILED != 0 {
        return 1
    }
    io.print_line("appkit brand: all checks passed")
    return 0
}
