// expect_out: ok
// ROUND TEMPO 14 -- full unrolling of short counted loops (unroll.rs).
//
// Every loop below has a trip count the compiler can know, and every one
// of them checks a different edge of the pass:
//
//   * branches on the counter that fold away once the loop is unrolled
//     (`k == 0`, `k & 1`) -- the shape of `synth` in the MP3 decoder,
//   * counting down, `<=`, `!=`, a step of 2 and of 3,
//   * a u8 counter that WRAPS on its way (250 .. 255, 0, 1),
//   * the counter read AFTER the loop (the header's value of the last pass),
//   * zero passes, and seventeen (one more than the pass will unroll),
//   * a loop nested in a loop, an array written by index, f32 sums whose
//     order must not change,
//   * a `break`, which leaves the loop through the body: that loop has to
//     stay a loop, and still compute the right thing.
//
// The inputs come from `start`, so that nothing is computed in advance
// except what the pass itself makes known.
import std.io

fn check(got: i64, want: i64, what: str) -> bool {
    if got != want {
        io.print("WRONG ")
        io.print(what)
        io.new_line()
        return false
    }
    return true
}

fn branches_on_counter(x: i64) -> i64 {
    var s: i64 = x
    var k: i32 = 0
    while k < 8 {
        if k == 0 {
            s = s + 1
        } else {
            if (k & 1) == 1 {
                s = s * 3
            } else {
                s = s - (k as i64)
            }
        }
        k = k + 1
    }
    return s
}

fn count_down(x: i64) -> i64 {
    var s: i64 = x
    var i: i64 = 10
    while i > 0 {
        s = s * 2 + i
        i = i - 3
    }
    return s * 100 + i
}

fn less_equal(x: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i <= 6 {
        s = s + i * x
        i = i + 2
    }
    return s * 10 + i
}

fn not_equal(x: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i != 12 {
        s = s ^ (x << i)
        i = i + 3
    }
    return s
}

fn wrapping_u8(x: i64) -> i64 {
    var s: i64 = x
    var b: u8 = 250
    while b != 2 {
        s = s * 7 + (b as i64)
        b = b +% 1
    }
    return s
}

fn zero_passes(x: i64) -> i64 {
    var s: i64 = x
    var i: i64 = 5
    while i < 5 {
        s = s + 1000
        i = i + 1
    }
    return s + i
}

fn seventeen(x: i64) -> i64 {
    var s: i64 = x
    var i: i64 = 0
    while i < 17 {
        s = s + i * i
        i = i + 1
    }
    return s
}

fn nested(x: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < 3 {
        var j: i64 = 0
        while j < 4 {
            s = s * 5 + i * j + x
            j = j + 1
        }
        s = s + j
        i = i + 1
    }
    return s
}

fn array_by_index(x: i32) -> i64 {
    var a: [i32; 8] = [0; 8]
    var k: usize = 0
    while k < 8 {
        a[k] = (k as i32) * x + 1
        k = k + 1
    }
    var s: i64 = 0
    var m: usize = 0
    while m < 8 {
        s = s * 3 + (a[7 - m] as i64)
        m = m + 1
    }
    return s
}

fn float_sum(x: i64) -> i64 {
    var s: f32 = (x as f32) * 0.1f
    var k: i32 = 0
    while k < 6 {
        s = s * 1.5f + (k as f32) * 0.3f
        k = k + 1
    }
    return (s * 1000.0f) as i64
}

fn with_break(x: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < 8 {
        if s > x {
            break
        }
        s = s + i + 1
        i = i + 1
    }
    return s * 10 + i
}

fn main(start: u64) -> i32 {
    var ok: bool = true
    var x: i64 = 5
    var y: i32 = 3
    if start == 7777777 {
        x = 1
        y = 1
    }
    ok = check(branches_on_counter(x), 378, "branches on the counter") && ok
    ok = check(count_down(x), 19698, "count down") && ok
    ok = check(less_equal(x), 608, "less or equal") && ok
    ok = check(not_equal(x), 2925, "not equal") && ok
    ok = check(wrapping_u8(x), 269182089, "wrapping u8") && ok
    ok = check(zero_passes(x), 10, "zero passes") && ok
    ok = check(seventeen(x), 1501, "seventeen passes") && ok
    ok = check(nested(x), 306764610, "nested") && ok
    ok = check(array_by_index(y), 67252, "array by index") && ok
    ok = check(float_sum(x), 14564, "f32 sum") && ok
    ok = check(with_break(x), 63, "break") && ok
    if ok {
        io.print_line("ok")
    }
    return 0
}
