// expect_exit: 0
import media.video.vp9.vp9mem
import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1fhdr
import media.video.av1.av1seq
import media.video.av1.av1mfmv
import media.video.av1.av1mvmi
import media.video.av1.av1mvref

const B16: i64 = 6
const NEARESTMV: i64 = 13
const NEAR_NEARMV: i64 = 18
const GLOBALMV: i64 = 15

struct Ctx {
    td: *mut av1blkst.TileDec,
    fh: *mut av1fhdr.FrameHdr,
}

fn setup(hp: i64) -> Ctx {
    let seq: *mut av1seq.SeqHdr = av1seq.seq_new()
    (*seq).subsampling_x = 1
    (*seq).subsampling_y = 1
    (*seq).num_planes = 3
    (*seq).bit_depth = 8
    let fh: *mut av1fhdr.FrameHdr = av1fhdr.fhdr_new()
    (*fh).mi_rows = 32
    (*fh).mi_cols = 32
    (*fh).frame_height = 128
    (*fh).upscaled_width = 128
    (*fh).allow_high_precision_mv = hp
    let td: *mut av1blkst.TileDec = av1blkst.td_new()
    av1blkst.td_setup_frame(td, seq, fh)
    (*td).mi_row_start = 0
    (*td).mi_row_end = 32
    (*td).mi_col_start = 0
    (*td).mi_col_end = 32
    return Ctx { td: td, fh: fh }
}

fn put(td: *mut av1blkst.TileDec, row: i64, col: i64, size: i64, f0: i64, f1: i64, mode: i64, r0: i64, c0: i64, r1: i64, c1: i64) {
    var y: i64 = 0
    while y < av1blkdat.bh4(size) {
        var x: i64 = 0
        while x < av1blkdat.bw4(size) {
            av1blkst.mi_set(td, (*td).mi_size_a, row + y, col + x, size)
            av1blkst.mi_set(td, (*td).inter_a, row + y, col + x, 1)
            av1blkst.mi_set(td, (*td).ymode_a, row + y, col + x, mode)
            av1blkst.mi_set(td, (*td).wr_a, row + y, col + x, 1)
            av1mvmi.ref_set(td, row + y, col + x, 0, f0)
            av1mvmi.ref_set(td, row + y, col + x, 1, f1)
            av1mvmi.mv_set(td, row + y, col + x, 0, 0, r0)
            av1mvmi.mv_set(td, row + y, col + x, 0, 1, c0)
            av1mvmi.mv_set(td, row + y, col + x, 1, 0, r1)
            av1mvmi.mv_set(td, row + y, col + x, 1, 1, c1)
            x = x + 1
        }
        y = y + 1
    }
}

fn put_intra(td: *mut av1blkst.TileDec, row: i64, col: i64, size: i64) {
    var y: i64 = 0
    while y < av1blkdat.bh4(size) {
        var x: i64 = 0
        while x < av1blkdat.bw4(size) {
            av1blkst.mi_set(td, (*td).mi_size_a, row + y, col + x, size)
            av1blkst.mi_set(td, (*td).wr_a, row + y, col + x, 1)
            av1mvmi.ref_set(td, row + y, col + x, 0, 0)
            av1mvmi.ref_set(td, row + y, col + x, 1, 0 - 1)
            x = x + 1
        }
        y = y + 1
    }
}

fn block(td: *mut av1blkst.TileDec, row: i64, col: i64, size: i64, f0: i64, f1: i64) {
    (*td).mi_row = row
    (*td).mi_col = col
    (*td).mi_size = size
    (*td).bw4 = av1blkdat.bw4(size)
    (*td).bh4 = av1blkdat.bh4(size)
    (*td).ref_frame[0] = f0
    (*td).ref_frame[1] = f1
}

fn mv_is(td: *mut av1blkst.TileDec, idx: i64, r0: i64, c0: i64) -> bool {
    return av1mvmi.stack_row(td, idx) == r0 && av1mvmi.stack_col(td, idx) == c0
}

fn mv2_is(td: *mut av1blkst.TileDec, idx: i64, r0: i64, c0: i64, r1: i64, c1: i64) -> bool {
    return mv_is(td, idx, r0, c0) && av1mvmi.stack_row1(td, idx) == r1 && av1mvmi.stack_col1(td, idx) == c1
}

fn case_nearest() -> i64 {
    let cx: Ctx = setup(1)
    let td: *mut av1blkst.TileDec = cx.td
    put(td, 4, 8, B16, 1, 0 - 1, NEARESTMV, 10, 20, 0, 0)
    put(td, 8, 4, B16, 1, 0 - 1, NEARESTMV, 10, 20, 0, 0)
    put(td, 4, 12, B16, 1, 0 - 1, NEARESTMV, 0 - 6, 3, 0, 0)
    block(td, 8, 8, B16, 1, 0 - 1)
    av1mvref.find_mv_stack(td)
    if (*td).num_mv_found != 2 {
        return 1
    }
    if !mv_is(td, 0, 10, 20) || (*td).stack_w[0] != 672 {
        return 2
    }
    if !mv_is(td, 1, 0 - 6, 3) || (*td).stack_w[1] != 644 {
        return 3
    }
    if (*td).mode_ctx != 85 {
        return 4
    }
    return 0
}

fn case_extra_single() -> i64 {
    let cx: Ctx = setup(1)
    let td: *mut av1blkst.TileDec = cx.td
    put_intra(td, 4, 8, B16)
    put(td, 8, 4, B16, 7, 0 - 1, NEARESTMV, 8, 0 - 8, 0, 0)
    block(td, 8, 8, B16, 1, 0 - 1)
    av1mvref.find_mv_stack(td)
    if (*td).num_mv_found != 1 || !mv_is(td, 0, 8, 0 - 8) || (*td).stack_w[0] != 2 {
        return 1
    }
    if !mv_is(td, 1, 0, 0) {
        return 2
    }
    if (*td).mode_ctx != 0 {
        return 3
    }
    (*cx.fh).ref_frame_sign_bias[7] = 1
    block(td, 8, 8, B16, 1, 0 - 1)
    av1mvref.find_mv_stack(td)
    if (*td).num_mv_found != 1 || !mv_is(td, 0, 0 - 8, 8) {
        return 4
    }
    return 0
}

fn case_compound() -> i64 {
    let cx: Ctx = setup(1)
    let td: *mut av1blkst.TileDec = cx.td
    put(td, 4, 8, B16, 1, 7, NEAR_NEARMV, 4, 4, 0 - 4, 0 - 4)
    put(td, 8, 4, B16, 1, 7, NEAR_NEARMV, 4, 4, 0 - 4, 0 - 4)
    block(td, 8, 8, B16, 1, 7)
    av1mvref.find_mv_stack(td)
    if (*td).num_mv_found != 2 {
        return 1
    }
    if !mv2_is(td, 0, 4, 4, 0 - 4, 0 - 4) || (*td).stack_w[0] != 672 {
        return 2
    }
    if !mv2_is(td, 1, 4, 4, 0 - 4, 0 - 4) || (*td).stack_w[1] != 2 {
        return 3
    }
    put(td, 4, 8, B16, 1, 7, NEAR_NEARMV, 4, 4, 0 - 4, 0 - 4)
    put(td, 8, 4, B16, 1, 7, NEAR_NEARMV, 12, 12, 0 - 12, 0 - 12)
    av1mvref.find_mv_stack(td)
    if (*td).num_mv_found != 2 || !mv2_is(td, 0, 4, 4, 0 - 4, 0 - 4) || !mv2_is(td, 1, 12, 12, 0 - 12, 0 - 12) {
        return 4
    }
    if (*td).stack_w[0] != 656 || (*td).stack_w[1] != 656 {
        return 5
    }
    return 0
}

fn case_global() -> i64 {
    let cx: Ctx = setup(1)
    let td: *mut av1blkst.TileDec = cx.td
    (*cx.fh).gm_type[1] = 1
    (*cx.fh).gm_params[6] = 64 << 13
    (*cx.fh).gm_params[7] = 0 - (16 << 13)
    block(td, 0, 0, B16, 1, 0 - 1)
    av1mvref.find_mv_stack(td)
    if (*td).num_mv_found != 0 || !mv_is(td, 0, 64, 0 - 16) || !mv_is(td, 1, 64, 0 - 16) {
        return 1
    }
    put(td, 4, 8, B16, 1, 0 - 1, GLOBALMV, 1, 1, 0, 0)
    block(td, 8, 8, B16, 1, 0 - 1)
    av1mvref.find_mv_stack(td)
    if (*td).num_mv_found != 1 || !mv_is(td, 0, 1, 1) {
        return 2
    }
    (*cx.fh).gm_type[1] = 2
    (*cx.fh).gm_params[8] = 1 << 16
    (*cx.fh).gm_params[11] = 1 << 16
    av1mvref.find_mv_stack(td)
    if (*td).num_mv_found != 2 || !mv_is(td, 0, 0 - 16, 64) || (*td).stack_w[0] != 656 {
        return 3
    }
    if !mv_is(td, 1, 1, 1) || (*td).stack_w[1] != 2 {
        return 4
    }
    return 0
}

fn fill_field(td: *mut av1blkst.TileDec, y8: i64, x8: i64, r: i64, c: i64) {
    let m: *mut av1mfmv.MotionField = av1mfmv.mfld_new(32, 32)
    var i: usize = 0
    while i < 8 * 16 * 16 * 2 {
        vp9mem.sti16((*m).mvs, i, av1mfmv.MFLD_INVALID)
        i = i + 1
    }
    let base: usize = (((1 * 16 + y8) * 16 + x8) * 2) as usize
    vp9mem.sti16((*m).mvs, base, r)
    vp9mem.sti16((*m).mvs, base + 1, c)
    (*td).mfld = m as u64
}

fn case_temporal() -> i64 {
    var hp: i64 = 1
    while hp >= 0 {
        let cx: Ctx = setup(hp)
        let td: *mut av1blkst.TileDec = cx.td
        (*cx.fh).use_ref_frame_mvs = 1
        fill_field(td, 4, 4, 17, 0 - 33)
        block(td, 8, 8, B16, 1, 0 - 1)
        av1mvref.find_mv_stack(td)
        if (*td).num_mv_found != 1 || (*td).stack_w[0] != 2 {
            return 1 + (1 - hp) * 10
        }
        if hp == 1 && !mv_is(td, 0, 17, 0 - 33) {
            return 2
        }
        if hp == 0 && !mv_is(td, 0, 16, 0 - 32) {
            return 12
        }
        if (*td).mode_ctx != 8 {
            return 3 + (1 - hp) * 10
        }
        hp = hp - 1
    }
    return 0
}

fn main() -> i32 {
    let a: i64 = case_nearest()
    if a != 0 {
        return (10 + a) as i32
    }
    let b: i64 = case_extra_single()
    if b != 0 {
        return (20 + b) as i32
    }
    let c: i64 = case_compound()
    if c != 0 {
        return (30 + c) as i32
    }
    let d: i64 = case_global()
    if d != 0 {
        return (40 + d) as i32
    }
    let e: i64 = case_temporal()
    if e != 0 {
        return (50 + e) as i32
    }
    return 0
}
