// expect_exit: 0
// BOUNDS ON TYPE PARAMETERS -- the core test for round 50.
//
// Up to round 49 a generic template could demand nothing of `T`: the three
// built-in bounds (`Any`, `Int`, `Scalar`) only say what SHAPE the type has,
// not what it CAN do. Since this round the name of an interface is a bound,
// `T: Order`, and the body may call the methods of that interface. The check
// happens at the instantiation.
//
// What is tried out here:
//   * a bound on a FUNCTION and on a STRUCT
//   * `Self` in the interface -- the condition for being able to write down
//     an order at all
//   * SEVERAL bounds on one parameter (`Scalar + Order`)
//   * a BASIC TYPE as an implementor (`impl Order for i64`)
//   * NESTED instantiation: a template with a bound calls another one
//   * the same interface from a MODULE, with a renamed type
//   * DYNAMIC dispatch next to it -- `dyn Showable` still exists, and both
//     ways lead to the same result. The difference sits in the
//     assembly, not in the behaviour (tools/bounds/run.sh).
import modules.bounds

interface Order {
    fn less(*self, b: *Self) -> bool
}

interface Showable {
    fn value(*self) -> i64
}

struct Dot { x: i64 }

impl Order for Dot {
    fn less(*self, b: *Dot) -> bool {
        return (*self).x < (*b).x
    }
}

impl Showable for Dot {
    fn value(*self) -> i64 {
        return (*self).x
    }
}

// The interface comes from the MODULE, the implementation stands here. Both
// together are the proof that `interface` names hold program-wide.
impl Row for Dot {
    fn rank(*self) -> i64 {
        return (*self).x
    }
}

impl Order for i64 {
    fn less(*self, b: *i64) -> bool {
        return *self < *b
    }
}

impl Order for u8 {
    fn less(*self, b: *u8) -> bool {
        return *self < *b
    }
}

// --- bound on a function -------------------------------------------------
fn smaller[T: Order](a: *T, b: *T) -> *T {
    if a.less(b) {
        return a
    }
    return b
}

// --- nested: template with a bound calls template with a bound ------------
fn smallest3[T: Order](a: *T, b: *T, c: *T) -> *T {
    return smaller[T](smaller[T](a, b), c)
}

// --- several bounds at the same time --------------------------------------
// `Scalar` for `0 as T`, `Order` for the comparison. Both hold.
fn less_as_null[T: Scalar + Order](a: T) -> bool {
    var x: T = a
    var null: T = 0 as T
    return x.less(&null)
}

// --- bound on a generic STRUCT --------------------------------------------
// The struct itself calls no method; the bound stands there all the same, so
// that nobody builds a `Pair` out of something that has no order.
struct Pair[T: Order] {
    a: T,
    b: T,
}

fn pair_less[T: Order](p: *Pair[T]) -> bool {
    return (&(*p).a).less(&(*p).b)
}

fn main() -> i32 {
    // --- struct with a bound
    var p: Dot = Dot { x: 3 }
    var q: Dot = Dot { x: 7 }
    var r: Dot = Dot { x: 1 }
    let k: *Dot = smaller[Dot](&p, &q)
    if (*k).x != 3 {
        return 1
    }
    let k3: *Dot = smallest3[Dot](&p, &q, &r)
    if (*k3).x != 1 {
        return 2
    }

    // --- basic type with a bound: the same code, a different type
    var a: i64 = 40
    var b: i64 = 2
    let ki: *i64 = smaller[i64](&a, &b)
    if *ki != 2 {
        return 3
    }
    var m: u8 = 200
    var n: u8 = 12
    let ku: *u8 = smaller[u8](&m, &n)
    if *ku != 12 {
        return 4
    }

    // --- two bounds on one parameter
    if !less_as_null[i64](0 - 5) {
        return 5
    }
    if less_as_null[i64](5) {
        return 6
    }
    if less_as_null[u8](5) {
        return 7
    }

    // --- bound on a generic struct
    var pp: Pair[Dot] = Pair[Dot] { a: Dot { x: 2 }, b: Dot { x: 9 } }
    if !pair_less[Dot](&pp) {
        return 8
    }
    var pi: Pair[i64] = Pair[i64] { a: 9, b: 2 }
    if pair_less[i64](&pi) {
        return 9
    }

    // --- interface and template from a MODULE, type from THIS file.
    // `Row` stands in `modules/bounds.fi` and holds here without the module
    // name all the same; `Dot` implements it below.
    if largest[Dot](&p, &q) != 7 {
        return 10
    }
    // ... and the same call with a basic type whose implementation stands in
    // the module: `u16__rank` carries NO module prefix.
    var g1: u16 = 300
    var g2: u16 = 65000
    if largest[u16](&g1, &g2) != 65000 {
        return 11
    }
    // ... and the module-internal call on the renamed type
    var mk: bounds.Mark = bounds.mark_new(11)
    if bounds.mark_rank(&mk) != 11 {
        return 14
    }

    // --- the dynamic way stands unchanged next to it
    let z: dyn Showable = (&q) as dyn Showable
    if z.value() != 7 {
        return 12
    }

    // --- static and dynamic yield the same
    if z.value() != (&q).value() {
        return 13
    }
    return 0
}
