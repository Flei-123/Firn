// expect_exit: 0
// tests/4042_closure_in_generic.fi -- a closure literal and a lambda inside a generic function:
// every instance gets its own closure function (r716).
fn apply[T](x: T, f: fn(T) -> T) -> T { return f(x) }

fn same[T](x: T) -> T {
    return apply[T](x, fn(a: T) -> T { return a })
}

fn twice_i32(x: i32) -> i32 {
    return apply[i32](x, |v| v * 2)
}

fn plus_one[T](x: T, one: T) -> T {
    return apply[T](x, fn(a: T) -> T { return a })
}

fn main() -> i32 {
    if same[i32](3) != 3 { return 1 }
    if same[i64](7) != 7 { return 2 }
    if same[u8](9) != 9 { return 3 }
    if twice_i32(21) != 42 { return 4 }
    if plus_one[i32](5, 1) != 5 { return 5 }
    return 0
}
