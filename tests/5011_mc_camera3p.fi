// expect_exit: 0
import std.rt
import std.math
import mc.mc_world
import mc.mc_render_world
import mc.mc_input
import mc.mc_camera
import mc.mc_camera3p
import mc.mc_entity_draw
import mc.mc_self_model

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64, e: f64) -> bool {
    return math.fabs(a - b) <= e
}

fn rec(l: *mut mc_entity_draw.EntList, box: usize, word: usize) -> f64 {
    let p: u64 = rt.buf_ptr(&(*l).buf) + ((box * 12 + word) as u64) * (8 as u64)
    return *(p as *mut f64)
}

fn top(l: *mut mc_entity_draw.EntList) -> f64 {
    var hi: f64 = 0.0
    var i: usize = 0
    while i < mc_entity_draw.entlist_boxes(l) {
        let t: f64 = rec(l, i, 1) + rec(l, i, 4) * 0.5
        if t > hi { hi = t }
        i = i + 1
    }
    return hi
}

fn main() -> i32 {
    var w: mc_world.World = mc_world.world_new()
    let ids: u64 = rt.heap_alloc(8192 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    i = 0
    while i < 4 * 256 {
        rt.st16(ids, i, 1 as u16)
        i = i + 1
    }
    check(mc_world.world_put(&w, mc_render_world.wr_make_chunk(0, 0, 2, ids)), 1)
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(2), solid: rt.heap_alloc(4), n: 2 }
    rt.st8(tb.pick, 0, 0 as u8)
    rt.st8(tb.pick, 1, 1 as u8)
    rt.st16(tb.solid, 0, 0 as u16)
    rt.st16(tb.solid, 1, 1 as u16)

    check(mc_camera3p.mode_next(0) == 1 && mc_camera3p.mode_next(1) == 2 && mc_camera3p.mode_next(2) == 0, 2)
    check(!mc_camera3p.mode_is_third(mc_camera3p.MODE_FIRST) && mc_camera3p.mode_is_third(mc_camera3p.MODE_BACK)
        && mc_camera3p.mode_is_third(mc_camera3p.MODE_FRONT), 3)

    let ex: f64 = 8.5
    let ey: f64 = 0.0 - 58.38
    let ez: f64 = 8.5
    var o: mc_camera3p.Cam3p = mc_camera3p.cam3p_new()

    mc_camera3p.cam3p_place(&w, 0 - 64, &tb, ex, ey, ez, 0.0, 0.0, mc_camera3p.MODE_FIRST, 4.0, &o)
    check(o.x == ex && o.y == ey && o.z == ez && o.yaw == 0.0 && o.pitch == 0.0 && o.dist == 0.0 && !o.clipped, 4)

    mc_camera3p.cam3p_place(&w, 0 - 64, &tb, ex, ey, ez, 0.0, 0.0, mc_camera3p.MODE_BACK, 4.0, &o)
    check(near(o.x, 8.5, 0.0001) && near(o.y, ey, 0.0001) && near(o.z, 4.5, 0.0001) && o.yaw == 0.0 && o.pitch == 0.0, 5)
    check(o.dist == 4.0 && !o.clipped, 6)

    mc_camera3p.cam3p_place(&w, 0 - 64, &tb, ex, ey, ez, 90.0, 0.0, mc_camera3p.MODE_BACK, 4.0, &o)
    check(near(o.x, 12.5, 0.0001) && near(o.z, 8.5, 0.0001), 7)

    mc_camera3p.cam3p_place(&w, 0 - 64, &tb, ex, ey, ez, 0.0, 20.0, mc_camera3p.MODE_FRONT, 4.0, &o)
    check(near(o.yaw, 0.0 - 180.0, 0.0001) && near(o.pitch, 0.0 - 20.0, 0.0001), 8)
    check(near(o.z, 8.5 + 4.0 * math.cos(20.0 * 0.017453292519943295), 0.001), 9)
    check(near(o.y, ey - 4.0 * math.sin(20.0 * 0.017453292519943295), 0.001), 10)

    mc_camera3p.cam3p_place(&w, 0 - 64, &tb, ex, ey, ez, 0.0, 0.0 - 50.0, mc_camera3p.MODE_BACK, 4.0, &o)
    check(o.clipped && o.dist > 1.9 && o.dist < 2.05, 11)
    check(o.y > 0.0 - 60.0 && o.y < 0.0 - 59.9 + 0.2, 12)

    mc_camera3p.cam3p_place(&w, 0 - 64, &tb, ex, 0.0 - 59.95, ez, 0.0, 0.0, mc_camera3p.MODE_BACK, 4.0, &o)
    check(o.dist == 0.0 && o.clipped && near(o.z, 8.5, 0.0001), 13)

    mc_camera3p.cam3p_place(&w, 0 - 64, &tb, 0.5, ey, 0.5, 180.0, 0.0, mc_camera3p.MODE_BACK, 4.0, &o)
    check(near(o.z, 4.5, 0.0001) || near(o.z, 0.5 + 4.0, 0.0001), 14)

    var cam: mc_camera.Camera = mc_camera.camera_new(64, 48)
    mc_camera3p.cam3p_apply(&cam, &w, 0 - 64, &tb, ex, ey, ez, 0.0, 0.0, mc_camera3p.MODE_BACK, 4.0, &o)
    check(near(cam.z, 4.5, 0.0001) && near(cam.fz, 1.0, 0.0001), 15)
    let z_before: f64 = cam.z
    mc_camera3p.cam3p_apply(&cam, &w, 0 - 64, &tb, ex, ey, ez, 0.0, 0.0, mc_camera3p.MODE_FIRST, 4.0, &o)
    check(cam.z == z_before, 16)

    check(mc_self_model.pose_of(false, false, false, false) == mc_self_model.POSE_STAND, 17)
    check(mc_self_model.pose_of(false, false, false, true) == mc_self_model.POSE_SNEAK, 18)
    check(mc_self_model.pose_of(false, false, true, false) == mc_self_model.POSE_SNEAK, 19)
    check(mc_self_model.pose_of(true, false, false, false) == mc_self_model.POSE_PRONE, 20)
    check(mc_self_model.pose_of(false, true, false, false) == mc_self_model.POSE_PRONE, 21)
    check(mc_self_model.pose_of(true, false, false, true) == mc_self_model.POSE_PRONE, 22)

    var l: mc_entity_draw.EntList = mc_entity_draw.entlist_new()
    mc_self_model.self_add(&l, 1.0, 2.0, 3.0, 0.0, mc_self_model.POSE_STAND)
    check(mc_entity_draw.entlist_boxes(&l) == 6 && near(top(&l), 2.0 + 2.0, 0.0001), 23)
    check(near(rec(&l, 0, 0), 1.0 - 0.125, 0.0001) && near(rec(&l, 0, 2), 3.0, 0.0001), 24)
    mc_entity_draw.entlist_clear(&l)
    mc_self_model.self_add(&l, 0.0, 0.0, 0.0, 0.0, mc_self_model.POSE_SNEAK)
    check(mc_entity_draw.entlist_boxes(&l) == 6 && top(&l) <= 1.5001 && top(&l) > 1.4, 25)
    mc_entity_draw.entlist_clear(&l)
    mc_self_model.self_add(&l, 0.0, 0.0, 0.0, 0.0, mc_self_model.POSE_PRONE)
    check(mc_entity_draw.entlist_boxes(&l) == 6 && top(&l) <= 0.6001 && top(&l) > 0.4, 26)
    mc_entity_draw.entlist_clear(&l)
    mc_self_model.self_add(&l, 0.0, 0.0, 0.0, 90.0, mc_self_model.POSE_PRONE)
    var minx: f64 = 100.0
    var j: usize = 0
    while j < mc_entity_draw.entlist_boxes(&l) {
        let bx: f64 = rec(&l, j, 0)
        if bx < minx { minx = bx }
        j = j + 1
    }
    check(minx < 0.0 - 0.7, 27)
    mc_entity_draw.entlist_free(&l)
    return g_fail
}
