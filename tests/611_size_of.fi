// expect_exit: 0
// `size_of[T]()` (SPEC §14.1.sizeof): die Groesse eines Typs in Bytes, zur
// Uebersetzungszeit. Vorbedingung fuer wachsende generische Sammlungen —
// ohne sie laesst sich die Adresse des i-ten Elements nicht ausrechnen.
struct Punkt {
    x: i64,
    y: i64,
}

struct Gemischt {
    a: u8,
    b: u64,
    c: u16,
}

fn groesse[T: Scalar]() -> usize {
    return size_of[T]()
}

fn main() -> i32 {
    if size_of[u8]() != 1 {
        return 1
    }
    if size_of[u16]() != 2 {
        return 2
    }
    if size_of[i32]() != 4 {
        return 3
    }
    if size_of[u64]() != 8 {
        return 4
    }
    if size_of[bool]() != 1 {
        return 5
    }
    if size_of[f64]() != 8 {
        return 6
    }
    if size_of[usize]() != 8 {
        return 7
    }
    // Structs: das gerechnete Layout, nicht die Summe der Felder
    if size_of[Punkt]() != 16 {
        return 8
    }
    // 1 + 7 Fuellbytes + 8 + 2 + 6 Fuellbytes = 24
    if size_of[Gemischt]() != 24 {
        return 9
    }
    // Auch mit einem TYPPARAMETER in einer generischen Vorlage — dafuer muss
    // die Monomorphisierung den Namen `size_of$T` mit ersetzen.
    if groesse[i32]() != 4 {
        return 10
    }
    if groesse[u8]() != 1 {
        return 11
    }
    // `groesse[Punkt]` geht NICHT: die Vorlage verlangt `Scalar`, und ein
    // Struct ist keiner. Das ist eine Einschraenkung der Generics, nicht von
    // `size_of` — direkt geschrieben stimmt die Groesse (oben, Zeile mit 8).
    // Das Ergebnis ist eine echte Konstante und taugt als Arraylaenge.
    var feld: [u8; 16] = [0 as u8; 16]
    feld[size_of[Punkt]() - 1] = 9 as u8
    if feld[15] != 9 as u8 {
        return 13
    }
    return 0
}
