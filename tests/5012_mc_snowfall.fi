// expect_exit: 0
import std.rt
import mc.mc_precip
import mc.mc_registry
import mc.mc_world
import mc.mc_chunk
import mc.mc_render_world
import mc.mc_snowfall
import mc.mc_snowfall_draw
import mc.mc_entity_draw
import mc.mc_camera
import mc.mc_raster
import mc.mc_backend
import mc.mc_texture
import mc.v763.mc_reg_v763

const CLEAR: u32 = 0xFF102030

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn word(rec: u64, i: usize) -> f64 {
    return *((rec + (i as u64) * (8 as u64)) as *mut f64)
}

fn run_snow(s: *mut mc_snowfall.Snowfall, p: *mut mc_precip.Precip, w: *mut mc_world.World, reg: *mut mc_registry.Registry,
    level: i32, kind: i32, from_ms: u64, steps: i32) -> u64 {
    var t: u64 = from_ms
    var i: i32 = 0
    while i < steps {
        mc_snowfall.snowfall_update(s, p, w, reg, 0, 4.5, 12.0, 5.5, level, kind, t)
        t = t + 50 as u64
        i = i + 1
    }
    return t
}

fn main() -> i32 {
    var reg: mc_registry.Registry = mc_reg_v763.registry_make()
    let b_air: i32 = mc_registry.reg_block_by_name(&reg, "air".p as u64, 3)
    let b_stone: i32 = mc_registry.reg_block_by_name(&reg, "stone".p as u64, 5)
    let st_air: i32 = mc_registry.reg_block_default_state(&reg, b_air)
    let st_stone: i32 = mc_registry.reg_block_default_state(&reg, b_stone)
    check(b_air >= 0 && b_stone >= 0, 1)

    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, st_air as u16)
        i = i + 1
    }
    var z: usize = 0
    while z < 16 {
        var x: usize = 0
        while x < 8 {
            rt.st16(ids, 10 * 256 + z * 16 + x, st_stone as u16)
            x = x + 1
        }
        z = z + 1
    }
    var w: mc_world.World = mc_world.world_new()
    check(mc_world.world_put(&w, mc_render_world.wr_make_chunk(0, 0, 2, ids)), 2)
    var p: mc_precip.Precip = mc_precip.precip_new()

    var s: mc_snowfall.Snowfall = mc_snowfall.snowfall_new()
    var t: u64 = run_snow(&s, &p, &w, &reg, 0, mc_precip.PRECIP_SNOW, 1000 as u64, 20)
    check(s.n_spawned == 0 as u64, 3)
    t = run_snow(&s, &p, &w, &reg, 1000, mc_precip.PRECIP_RAIN, t, 20)
    check(s.n_spawned == 0 as u64, 4)
    t = run_snow(&s, &p, &w, &reg, 1000, mc_precip.PRECIP_NONE, t, 20)
    check(s.n_spawned == 0 as u64, 5)
    t = run_snow(&s, &p, &w, &reg, 1000, mc_precip.PRECIP_SNOW, t, 20)
    check(s.n_spawned > 8 as u64, 6)
    let live: usize = mc_snowfall.snowfall_live(&s, t)
    check(live > 0 && live <= mc_snowfall.SNOW_MAX, 7)

    var k: usize = 0
    while k < mc_snowfall.SNOW_MAX {
        if s.born[k] != 0 as u64 {
            check(s.x[k] >= 0.0 && s.x[k] < 8.0 && s.z[k] >= 0.0 && s.z[k] < 16.0, 8)
            check(s.ground[k] > 11.03 && s.ground[k] < 11.05, 9)
            check(s.y[k] > s.ground[k] && s.y[k] <= 11.0 + (mc_snowfall.SNOW_FALL_HEIGHT as f64) + 1.0, 10)
            let a0: i32 = 0
            let a1: i32 = 500
            let dy: f64 = mc_snowfall.snowfall_y(&s, k, a0) - mc_snowfall.snowfall_y(&s, k, a1)
            check(dy >= 0.0 && dy <= 0.71, 11)
            if s.y[k] - s.ground[k] > 2.0 {
                check(dy > 0.69 && dy < 0.71, 12)
            }
            let ox: f64 = mc_snowfall.snowfall_x(&s, k, a1) - s.x[k]
            let oz: f64 = mc_snowfall.snowfall_z(&s, k, a1) - s.z[k]
            check(ox > 0.0 - 0.36 && ox < 0.36 && oz > 0.0 - 0.36 && oz < 0.36, 13)
        }
        k = k + 1
    }

    var s2: mc_snowfall.Snowfall = mc_snowfall.snowfall_new()
    let t2: u64 = run_snow(&s2, &p, &w, &reg, 1000, mc_precip.PRECIP_SNOW, 1000 as u64, 40)
    var s3: mc_snowfall.Snowfall = mc_snowfall.snowfall_new()
    let t3: u64 = run_snow(&s3, &p, &w, &reg, 1000, mc_precip.PRECIP_SNOW, 1000 as u64, 40)
    check(s2.n_spawned == s3.n_spawned && t2 == t3 && s2.x[3] == s3.x[3], 14)
    var light: mc_snowfall.Snowfall = mc_snowfall.snowfall_new()
    run_snow(&light, &p, &w, &reg, 200, mc_precip.PRECIP_SNOW, 1000 as u64, 40)
    check(light.n_spawned < s2.n_spawned, 15)

    var cam: mc_camera.Camera = mc_camera.camera_new(96, 72)
    mc_camera.camera_set_pos(&cam, 4.5, 24.0, 5.5)
    mc_camera.camera_set_angles(&cam, 0.0, 90.0)
    mc_camera.camera_update(&cam)
    var l: mc_entity_draw.EntList = mc_entity_draw.entlist_new()
    let added: usize = mc_snowfall_draw.entlist_add_snowfall(&l, &s2, &cam, t2)
    check(added > 0 && added <= mc_snowfall.SNOW_MAX, 16)
    check(mc_entity_draw.entlist_boxes(&l) == added, 17)
    let base: u64 = rt.buf_ptr(&l.buf)
    var b: usize = 0
    while b < added {
        let rec: u64 = base + (b * mc_backend.ENT_BYTES) as u64
        check(word(rec, 3) < 0.06 && word(rec, 3) > 0.05 && word(rec, 11) == 0.0, 18)
        check(word(rec, 1) >= 11.0, 19)
        b = b + 1
    }
    mc_entity_draw.entlist_free(&l)

    var one: mc_snowfall.Snowfall = mc_snowfall.snowfall_new()
    one.x[0] = 4.5
    one.z[0] = 5.5
    one.y[0] = 12.0
    mc_camera.camera_set_pos(&cam, 4.5, 14.0, 5.5)
    mc_camera.camera_update(&cam)
    one.ground[0] = 11.04
    one.born[0] = 1000 as u64
    l = mc_entity_draw.entlist_new()
    check(mc_snowfall_draw.entlist_add_snowfall(&l, &one, &cam, 1000 as u64) == 1, 20)
    var r: mc_raster.Raster = mc_raster.raster_new(96, 72)
    var at: mc_texture.Atlas = mc_texture.atlas_default()
    var be: mc_backend.Backend = mc_backend.backend_cpu(&r)
    be.upload_atlas(be.obj, (&at) as u64)
    be.begin(be.obj, (&cam) as u64, CLEAR)
    check(mc_entity_draw.entlist_draw(&l, &be) == 1 as u64, 21)
    var seen: i32 = 0
    var y: i32 = 0
    while y < 72 {
        var x: i32 = 0
        while x < 96 {
            if mc_raster.raster_pixel(&r, x, y) != CLEAR { seen = seen + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check(seen > 0, 22)
    mc_entity_draw.entlist_free(&l)
    mc_raster.raster_free(&r)

    check(mc_snowfall.snowfall_age_ms(&one, 0, 1000 as u64 + 2000 as u64) == 0 - 1, 23)
    check(mc_snowfall.snowfall_age_ms(&one, 0, 1000 as u64 + 500 as u64) == 500, 24)
    check(mc_snowfall.snowfall_y(&one, 0, 5000) == 11.04, 25)

    let late: u64 = t2 + 20000 as u64
    check(mc_snowfall.snowfall_live(&s2, late) == 0, 26)
    var l2: mc_entity_draw.EntList = mc_entity_draw.entlist_new()
    check(mc_snowfall_draw.entlist_add_snowfall(&l2, &s2, &cam, late) == 0, 27)
    mc_entity_draw.entlist_free(&l2)
    mc_snowfall.snowfall_reset(&s2)
    check(mc_snowfall.snowfall_live(&s2, t2) == 0, 28)
    return 0
}
