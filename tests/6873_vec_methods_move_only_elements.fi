// expect_exit: 0
struct Bag { items: Vec[int], tag: i64 }

fn make_bag(tag: i64, count: int) -> Bag {
    var items = Vec[int].new()
    var i = 0
    while i < count {
        items.push(i)
        i += 1
    }
    return Bag { items: items, tag: tag }
}

fn main() -> i32 {
    var bags: Vec[Bag] = Vec[Bag].new()
    bags.push(make_bag(1, 1))
    bags.push(make_bag(2, 2))
    bags.push(make_bag(3, 3))
    bags.reverse()
    if bags[0].tag != 3 || bags[2].tag != 1 { return 1 }
    var more: Vec[Bag] = Vec[Bag].new()
    more.push(make_bag(4, 4))
    bags.extend(more)
    if bags.len() != 4 || bags[3].items.len() != 4 { return 2 }
    bags.insert(0, make_bag(9, 0))
    if bags[0].tag != 9 || bags.len() != 5 { return 3 }
    return 0
}
