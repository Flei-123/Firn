// expect_exit: 0
// tests/2052_appkit_config.fi -- lib/appkit/config.fi: typed values, the
// file round trip, a missing file, a broken file, the limits, remove.
import std.rt
import std.fs
import appkit.config
import appkit.util

fn scratch() -> str {
    var b: rt.Buf = rt.buf_new()
    util.buf_push_str(&b, "/tmp/firn_appkit_cfg_2052_")
    rt.buf_push_dec_i64(&b, syscall(39, 0, 0, 0, 0, 0, 0))
    let s: str = util.buf_to_str_copy(&b)
    rt.buf_free(&b)
    return s
}

fn main() -> i32 {
    let root: str = scratch()
    fs.remove_tree(root) catch false
    let file: str = root + "/sub/config.json"
    var c: config.Config = config.config_new()
    if !config.config_path_set(&c, file) { return 1 }
    // a missing file is an empty config and ok
    if !config.config_load(&c) { return 2 }
    if config.config_count(&c) != 0 { return 3 }
    var out: rt.Buf = rt.buf_new()
    if config.get_str(&c, "update.channel", "stabil", &out) { return 4 }
    if !util.buf_eq_str(&out, "stabil") { return 5 }
    if config.get_int(&c, "window.width", 800) != 800 { return 6 }
    if !config.get_bool(&c, "ui.dark", true) { return 7 }
    // set, change type, read back
    if !config.set_str(&c, "update.channel", "beta") { return 8 }
    if !config.set_int(&c, "window.width", 1280) { return 9 }
    if !config.set_bool(&c, "ui.dark", false) { return 10 }
    if !config.set_str(&c, "name", "quote \" back \\ tab \t nl \n end") { return 11 }
    if !config.config_dirty(&c) { return 12 }
    if config.get_bool(&c, "ui.dark", true) { return 13 }
    // overwrite keeps ONE entry
    if !config.set_int(&c, "window.width", 1300) { return 14 }
    if config.config_count(&c) != 4 { return 15 }
    if !config.config_save(&c) { return 16 }
    if config.config_dirty(&c) { return 17 }
    // a fresh Config reads the same values from the file
    var d: config.Config = config.config_new()
    config.config_path_set(&d, file)
    if !config.config_load(&d) { return 18 }
    if config.config_count(&d) != 4 { return 19 }
    if !config.get_str(&d, "update.channel", "", &out) { return 20 }
    if !util.buf_eq_str(&out, "beta") { return 21 }
    if config.get_int(&d, "window.width", 0) != 1300 { return 22 }
    if config.get_bool(&d, "ui.dark", true) { return 23 }
    if !config.get_str(&d, "name", "", &out) { return 24 }
    if !util.buf_eq_str(&out, "quote \" back \\ tab \t nl \n end") { return 25 }
    // remove
    if !config.remove_key(&d, "name") { return 26 }
    if config.has(&d, "name") { return 27 }
    if config.config_count(&d) != 3 { return 28 }
    if config.remove_key(&d, "name") { return 29 }
    // a hand edited file: comment key, unknown kinds are ignored, ints
    let hand: str = "{\"_note\": \"x\", \"a\": 1, \"b\": true, \"c\": \"s\", \"d\": [1], \"e\": null, \"f\": 1.5}"
    fs.write_file(file, hand.p as u64, hand.n) catch 0
    var e: config.Config = config.config_new()
    config.config_path_set(&e, file)
    if !config.config_load(&e) { return 30 }
    if config.config_count(&e) != 3 { return 31 }
    if config.get_int(&e, "a", 0) != 1 { return 32 }
    if !config.get_bool(&e, "b", false) { return 33 }
    // a broken file: false, config empty
    let junk: str = "{ not json"
    fs.write_file(file, junk.p as u64, junk.n) catch 0
    var f: config.Config = config.config_new()
    config.config_path_set(&f, file)
    if config.config_load(&f) { return 34 }
    if config.config_count(&f) != 0 { return 35 }
    // limits: 64 entries, long key, long value
    var g: config.Config = config.config_new()
    config.config_path_set(&g, file)
    var i: usize = 0
    while i < 64 {
        var kb: rt.Buf = rt.buf_new()
        util.buf_push_str(&kb, "k")
        rt.buf_push_dec_i64(&kb, i as i64)
        let key: str = util.buf_to_str_copy(&kb)
        rt.buf_free(&kb)
        if !config.set_int(&g, key, i as i64) { return 40 }
        i = i + 1
    }
    if config.set_int(&g, "one-too-many", 1) { return 41 }
    if !config.set_int(&g, "k5", 55) { return 42 }
    if config.set_str(&g, "k6", "01234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789") { return 43 }
    fs.remove_tree(root) catch false
    return 0
}
