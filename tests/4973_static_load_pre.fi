// expect_exit: 0
import std.rt

static mut G_LEN: usize = 0
static mut G_CAP: usize = 4
static mut G_BUF: usize = 0
static mut G_TAKEN: u64 = 5
static mut G_PLAIN: u64 = 7
static mut G_FLAG: u64 = 0

fn ld8(p: u64, i: usize) -> u64 {
    let q: *mut u8 = (p + i as u64) as *mut u8
    let v: u8 = *q
    return v as u64
}

fn grow() {
    let ncap: usize = G_CAP * 2
    let nbuf: u64 = rt.heap_alloc(ncap)
    var j: usize = 0
    while j < G_LEN {
        *((nbuf + j as u64) as *mut u8) = *((G_BUF as u64 + j as u64) as *mut u8)
        j = j + 1
    }
    G_BUF = nbuf as usize
    G_CAP = ncap
}

fn push(b: u8) {
    if G_LEN == G_CAP {
        grow()
    }
    *((G_BUF as u64 + G_LEN as u64) as *mut u8) = b
    G_LEN = G_LEN + 1
}

fn bump_via(p: *mut u64) {
    *p = *p + 10
}

fn taken_case(p: *mut u64, flag: u64) -> u64 {
    var r: u64 = 0
    if flag == 1 {
        bump_via(p)
    }
    r = G_TAKEN
    *p = *p + 1
    r = r + G_TAKEN
    return r
}

fn plain_case(buf: u64, flag: u64) -> u64 {
    if flag == 1 {
        G_FLAG = G_FLAG + 1
    }
    let a: u64 = G_PLAIN
    *(buf as *mut u64) = a + 100
    let b: u64 = G_PLAIN
    return a * 1000 + b + *(buf as *mut u64)
}

fn main() -> i32 {
    G_BUF = rt.heap_alloc(G_CAP) as usize
    var i: usize = 0
    while i < 100 {
        push((i % 251) as u8)
        i = i + 1
    }
    if G_LEN != 100 { return 1 }
    var k: usize = 0
    var sum: u64 = 0
    while k < G_LEN {
        sum = sum + ld8(G_BUF as u64, k)
        k = k + 1
    }
    if sum != 4950 { return 2 }
    let p: *mut u64 = &G_TAKEN
    let r0: u64 = taken_case(p, 0)
    if r0 != 5 + 6 { return 3 }
    let r1: u64 = taken_case(p, 1)
    if r1 != 16 + 17 { return 4 }
    let buf: u64 = rt.heap_alloc(64)
    let q0: u64 = plain_case(buf, 0)
    if q0 != 7 * 1000 + 7 + 107 { return 5 }
    let q1: u64 = plain_case(buf, 1)
    if q1 != 7 * 1000 + 7 + 107 { return 6 }
    if G_FLAG != 1 { return 7 }
    return 0
}
