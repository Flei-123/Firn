// expect_exit: 0
// DIE STANDARDBIBLIOTHEK ORDNET UEBER EINE SCHNITTSTELLE — Runde 50.
//
// VORHER (bis Runde 49): `fn vec_sortiere[T: Scalar]`, im Rumpf `a < b`.
//   Der Vergleich war fest verdrahtet, also ging Sortieren NUR fuer Skalare.
//   Ein `Vec[Person]` liess sich anlegen und fuellen — sortieren nicht, und
//   der Fehler kam nicht aus `vec_sortiere`, sondern aus einer ausgepraegten
//   Kopie davon ("operator '<' fuer struct").
//
// NACHHER: `fn vec_sortiere[T: Ord]`, im Rumpf `a.kleiner(b)`. Die Ordnung
//   steht am Typ. Fuer die Grundtypen liefert `lib/rt/vec.fi` sie mit; jeder
//   andere Typ bringt sie selbst mit, und zwar in der Reihenfolge, die er
//   will (hier: erst Alter, dann Nummer).
//
// Dieser Test faehrt beide Seiten: dieselben Funktionen einmal mit `i32` und
// einmal mit einem Struct.
import std.vec

struct Person {
    alter: i64,
    nummer: i64,
}

// Zwei Schluessel, absteigend nach dem zweiten waere genauso moeglich —
// darum geht es: die Ordnung gehoert dem Typ, nicht dem Sortierer.
impl Ord for Person {
    fn kleiner(*self, b: *Person) -> bool {
        if (*self).alter != (*b).alter {
            return (*self).alter < (*b).alter
        }
        return (*self).nummer < (*b).nummer
    }
}

fn p(alter: i64, nummer: i64) -> Person {
    return Person{ alter: alter, nummer: nummer }
}

fn main() -> i32 {
    // --- der alte Weg, unveraendert: Skalare
    var z: Vec[i32] = vec_neu[i32]()
    var i: i32 = 0
    while i < 20 {
        vec_push[i32](&z, (i * 7) % 20)
        i = i + 1
    }
    vec_sortiere[i32](&z)
    if !vec_ist_sortiert[i32](&z) {
        return 1
    }
    if vec_binaersuche[i32](&z, 13) != 13 {
        return 2
    }
    if vec_binaersuche[i32](&z, 99) != vec_len[i32](&z) {
        return 3
    }
    // zwei Schranken an einem Parameter: `Scalar + Ord`
    if vec_min[i32](&z) != 0 || vec_max[i32](&z) != 19 {
        return 4
    }
    if !vec_sortiert_einfuegen[i32](&z, 10) {
        return 5
    }
    if !vec_ist_sortiert[i32](&z) || vec_len[i32](&z) != 21 {
        return 6
    }
    vec_frei[i32](&z)

    // --- der neue Weg: derselbe Sortierer, ein Struct
    var v: Vec[Person] = vec_neu[Person]()
    vec_push[Person](&v, p(30, 2))
    vec_push[Person](&v, p(20, 9))
    vec_push[Person](&v, p(30, 1))
    vec_push[Person](&v, p(10, 7))
    vec_push[Person](&v, p(20, 3))
    if vec_len[Person](&v) != 5 {
        return 7
    }
    if vec_ist_sortiert[Person](&v) {
        return 8
    }
    vec_sortiere[Person](&v)
    if !vec_ist_sortiert[Person](&v) {
        return 9
    }
    // erwartete Reihenfolge: (10,7) (20,3) (20,9) (30,1) (30,2)
    let a0: *mut Person = vec_zeiger[Person](&v, 0)
    let a1: *mut Person = vec_zeiger[Person](&v, 1)
    let a2: *mut Person = vec_zeiger[Person](&v, 2)
    let a3: *mut Person = vec_zeiger[Person](&v, 3)
    let a4: *mut Person = vec_zeiger[Person](&v, 4)
    if (*a0).alter != 10 || (*a0).nummer != 7 {
        return 10
    }
    if (*a1).alter != 20 || (*a1).nummer != 3 {
        return 11
    }
    if (*a2).alter != 20 || (*a2).nummer != 9 {
        return 12
    }
    if (*a3).alter != 30 || (*a3).nummer != 1 {
        return 13
    }
    if (*a4).alter != 30 || (*a4).nummer != 2 {
        return 14
    }
    // Binaersuche mit derselben Ordnung: Gleichheit ist `!(a<b) && !(b<a)`
    if vec_binaersuche[Person](&v, p(20, 9)) != 2 {
        return 15
    }
    if vec_binaersuche[Person](&v, p(20, 8)) != vec_len[Person](&v) {
        return 16
    }
    if vec_untere_schranke[Person](&v, p(20, 8)) != 2 {
        return 17
    }
    // sortiert einfuegen — die Ordnung bleibt
    if !vec_sortiert_einfuegen[Person](&v, p(25, 5)) {
        return 18
    }
    if !vec_ist_sortiert[Person](&v) || vec_len[Person](&v) != 6 {
        return 19
    }
    let n2: *mut Person = vec_zeiger[Person](&v, 3)
    if (*n2).alter != 25 || (*n2).nummer != 5 {
        return 20
    }
    // umkehren und tauschen gehen jetzt ebenfalls fuer Structs
    vec_umkehren[Person](&v)
    let r0: *mut Person = vec_zeiger[Person](&v, 0)
    if (*r0).alter != 30 || (*r0).nummer != 2 {
        return 21
    }
    vec_frei[Person](&v)
    return 0
}
