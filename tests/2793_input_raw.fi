// expect_exit: 0
// tests/2792_input_raw.fi -- lib/input/raw.fi state machine: scripted cases + 2000 random frames against a
// naive model; auto-repeat pairs / duplicate presses must change nothing; focus loss releases everything.
import std.rt
import window.window
import input.raw

static mut SEED: u64 = 12345

fn rnd() -> u64 {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return SEED / 65536
}

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    var r: raw.Raw = raw.raw_new()
    // scripted: press W, held across a frame with auto-repeat, released
    raw.raw_begin(&r)
    raw.raw_feed(&r, window.EV_RAWKEY, 17 as u32, 119 as u32, 100 as u32, 0 as u32)
    raw.raw_end(&r)
    check(raw.key_pressed(&r, raw.KEY_W) && raw.key_down(&r, raw.KEY_W) && raw.sym_down(&r, 119 as u32), 1)
    raw.raw_begin(&r)
    raw.raw_feed(&r, window.EV_RAWKEY_UP, 17 as u32, 119 as u32, 500 as u32, 0 as u32)
    raw.raw_feed(&r, window.EV_RAWKEY, 17 as u32, 119 as u32, 500 as u32, 0 as u32) // auto-repeat pair
    raw.raw_feed(&r, window.EV_RAWKEY, 17 as u32, 119 as u32, 540 as u32, 0 as u32) // repeat without release
    raw.raw_end(&r)
    check(raw.key_down(&r, raw.KEY_W) && !raw.key_pressed(&r, raw.KEY_W) && !raw.key_released(&r, raw.KEY_W), 2)
    raw.raw_begin(&r)
    raw.raw_feed(&r, window.EV_RAWKEY_UP, 17 as u32, 119 as u32, 900 as u32, 0 as u32)
    raw.raw_end(&r)
    check(!raw.key_down(&r, raw.KEY_W) && raw.key_released(&r, raw.KEY_W), 3)
    // a quick tap inside one frame: pressed AND released, not down
    raw.raw_begin(&r)
    raw.raw_feed(&r, window.EV_RAWKEY, 30 as u32, 97 as u32, 1000 as u32, 0 as u32)
    raw.raw_feed(&r, window.EV_RAWKEY_UP, 30 as u32, 97 as u32, 1010 as u32, 0 as u32)
    raw.raw_end(&r)
    check(raw.key_pressed(&r, raw.KEY_A) && raw.key_released(&r, raw.KEY_A) && !raw.key_down(&r, raw.KEY_A), 4)
    // focus loss releases the held keys and buttons
    raw.raw_begin(&r)
    raw.raw_feed(&r, window.EV_RAWKEY, 31 as u32, 115 as u32, 1100 as u32, 0 as u32)
    raw.raw_feed(&r, window.EV_BUTTON, 1 as u32, 5 as u32, 6 as u32, 0 as u32)
    raw.raw_end(&r)
    check(raw.key_down(&r, raw.KEY_S) && raw.mouse_down(&r, raw.MB_LEFT), 5)
    raw.raw_begin(&r)
    raw.raw_feed(&r, window.EV_FOCUS, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    raw.raw_end(&r)
    check(!raw.key_down(&r, raw.KEY_S) && raw.key_released(&r, raw.KEY_S) && raw.mouse_released(&r, raw.MB_LEFT) && !raw.has_focus(&r), 6)
    raw.raw_feed(&r, window.EV_FOCUS, 1 as u32, 0 as u32, 0 as u32, 0 as u32)
    // wheel
    raw.raw_begin(&r)
    raw.raw_feed(&r, window.EV_BUTTON, 4 as u32, 0 as u32, 0 as u32, 0 as u32)
    raw.raw_feed(&r, window.EV_BUTTON, 4 as u32, 0 as u32, 0 as u32, 0 as u32)
    raw.raw_feed(&r, window.EV_BUTTON, 5 as u32, 0 as u32, 0 as u32, 0 as u32)
    check(raw.wheel_y(&r) == 1, 7)
    // random frames against a naive model (8 keys), with injected auto-repeat noise
    var rr: raw.Raw = raw.raw_new()
    var model: [u8; 8] = [0 as u8; 8]
    var tm: u32 = 1000 as u32
    var frame: i32 = 0
    while frame < 2000 {
        raw.raw_begin(&rr)
        var exp_p: [u8; 8] = [0 as u8; 8]
        var exp_r: [u8; 8] = [0 as u8; 8]
        let n: u64 = rnd() % 5
        var e: u64 = 0
        while e < n {
            let k: usize = (rnd() % 8) as usize
            let sc: u32 = (20 + k) as u32
            tm = tm + 1 as u32 + (rnd() % 7) as u32
            if model[k] == 0 as u8 {
                model[k] = 1 as u8
                exp_p[k] = 1 as u8
                raw.raw_feed(&rr, window.EV_RAWKEY, sc, 100 as u32, tm, 0 as u32)
            } else {
                // noise: an auto-repeat pair or a duplicate press while it is held
                let nz: u64 = rnd() % 3
                if nz == 0 {
                    raw.raw_feed(&rr, window.EV_RAWKEY_UP, sc, 100 as u32, tm, 0 as u32)
                    raw.raw_feed(&rr, window.EV_RAWKEY, sc, 100 as u32, tm, 0 as u32)
                } else if nz == 1 {
                    raw.raw_feed(&rr, window.EV_RAWKEY, sc, 100 as u32, tm, 0 as u32)
                } else {
                    model[k] = 0 as u8
                    exp_r[k] = 1 as u8
                    raw.raw_feed(&rr, window.EV_RAWKEY_UP, sc, 100 as u32, tm, 0 as u32)
                }
            }
            e = e + 1
        }
        raw.raw_end(&rr)
        var i: usize = 0
        while i < 8 {
            let sc: u32 = (20 + i) as u32
            check(raw.key_down(&rr, sc) == (model[i] != 0 as u8), 10)
            check(raw.key_pressed(&rr, sc) == (exp_p[i] != 0 as u8), 11)
            check(raw.key_released(&rr, sc) == (exp_r[i] != 0 as u8), 12)
            i = i + 1
        }
        frame = frame + 1
    }
    return 0
}
