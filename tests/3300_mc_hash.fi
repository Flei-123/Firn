// expect_exit: 0
// mc_hash: CRC32C (standard check value) and the tagged hashing of the 1.21.5 hashed item stacks; reference values from an independent
// python implementation of the same byte layout (struct.pack + bitwise CRC32C).
import std.rt
import mc.mc_hash

fn main() -> i32 {
    if mc_hash.crc32c("123456789".p as u64, "123456789".n) != 3808858755 as u32 { return 1 }
    if mc_hash.hash_empty() != 2685849682 as u32 { return 2 }
    if mc_hash.hash_bool(true) != 3275148994 as u32 { return 3 }
    if mc_hash.hash_int(5) != 645064431 as u32 { return 4 }
    if mc_hash.hash_int(0 - 1) != 932039068 as u32 { return 5 }
    if mc_hash.hash_short(0 - 2) != 162015414 as u32 { return 6 }
    if mc_hash.hash_long(0 - 2) != 2061223958 as u32 { return 7 }
    if mc_hash.hash_byte(255) != 903050673 as u32 { return 8 }
    if mc_hash.hash_string("minecraft:efficiency".p as u64, "minecraft:efficiency".n) != 2725989558 as u32 { return 9 }
    // non-ASCII: 2 byte, 4 byte (surrogate pair) and ASCII
    if mc_hash.hash_string("é😀x".p as u64, "é😀x".n) != 2372862676 as u32 { return 10 }
    if mc_hash.hash_utf16_len("é😀x".p as u64, "é😀x".n) != 4 { return 11 }
    let hs: u64 = rt.heap_alloc(16)
    rt.st32(hs, 0, mc_hash.hash_int(1))
    rt.st32(hs, 1, mc_hash.hash_int(2))
    if mc_hash.hash_list(hs, 2) != 2921006628 as u32 { return 12 }
    if mc_hash.hash_map(hs, hs, 0) != 3312760008 as u32 { return 13 }
    rt.heap_free(hs, 16)
    // map entries are sorted by (key hash, value hash): the order of the input must not matter
    let ks: u64 = rt.heap_alloc(16)
    let vs: u64 = rt.heap_alloc(16)
    rt.st32(ks, 0, mc_hash.hash_string("b".p as u64, 1)); rt.st32(vs, 0, mc_hash.hash_int(2))
    rt.st32(ks, 1, mc_hash.hash_string("a".p as u64, 1)); rt.st32(vs, 1, mc_hash.hash_int(1))
    rt.st32(ks, 2, mc_hash.hash_string("c".p as u64, 1)); rt.st32(vs, 2, mc_hash.hash_int(3))
    if mc_hash.hash_map(ks, vs, 3) != 1411621057 as u32 { return 14 }
    rt.heap_free(ks, 16)
    rt.heap_free(vs, 16)
    return 0
}
