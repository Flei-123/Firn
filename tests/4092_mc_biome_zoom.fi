// expect_exit: 0
// tests/4092_mc_biome_zoom.fi -- r252 vanilla BiomeManager.getBiome (Voronoi zoom): LinearCongruentialGenerator.next, getFiddledDistance and the
// chosen quart cell, against values taken from the real 1.20.1 classes (server-1.20.1.jar: aow, cnm; tools/mc/biomezoom/Ref.java reproduces them).
import std.rt
import std.core
import mc.mc_biome_zoom
import mc.mc_noise

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d < 0.000000000001
}

// block (x, y, z) of the hashed seed `hs` takes the biome of the quart cell (qx, qy, qz)
fn pick_is(hs: i64, x: i32, y: i32, z: i32, qx: i32, qy: i32, qz: i32, code: i32) {
    let q: mc_biome_zoom.BzQuart = mc_biome_zoom.bz_pick(hs as u64, x, y, z)
    check(q.x == qx && q.y == qy && q.z == qz, code)
}

fn main() -> i32 {
    let s1: i64 = 0
    let r1: i64 = 5
    let t1: i64 = 296184137228677613
    check((mc_biome_zoom.bz_lcg(s1 as u64, 5) as i64) == r1, 1)
    check((mc_biome_zoom.bz_lcg(r1 as u64, 0 - 3) as i64) == t1, 2)
    let s3: i64 = 1
    let r3: i64 = 7806831264735756417
    let t3: i64 = 0 - 8078058728398711559
    check((mc_biome_zoom.bz_lcg(s3 as u64, 5) as i64) == r3, 3)
    check((mc_biome_zoom.bz_lcg(r3 as u64, 0 - 3) as i64) == t3, 4)
    let s5: i64 = 0 - 7046029254386353131
    let r5: i64 = 1962759240470588421
    let t5: i64 = 0 - 3657019982145970707
    check((mc_biome_zoom.bz_lcg(s5 as u64, 5) as i64) == r5, 5)
    check((mc_biome_zoom.bz_lcg(r5 as u64, 0 - 3) as i64) == t5, 6)
    let s7: i64 = 123456789012345
    let r7: i64 = 5383899436905693689
    let t7: i64 = 1095326672488693873
    check((mc_biome_zoom.bz_lcg(s7 as u64, 5) as i64) == r7, 7)
    check((mc_biome_zoom.bz_lcg(r7 as u64, 0 - 3) as i64) == t7, 8)
    check(near(mc_biome_zoom.bz_dist(293737985876514017 as u64, 0, 0, 0, 0.25, 0.5, 0.75), 0.8261981296539308), 9)
    check(near(mc_biome_zoom.bz_dist(293737985876514017 as u64, 1, (0 - 2), 3, 0.25, 0.5, 0.75), 1.6957114982604982), 10)
    check(near(mc_biome_zoom.bz_dist(293737985876514017 as u64, (0 - 5), 7, (0 - 9), 0.25, 0.5, 0.75), 1.081016139984131), 11)
    check(near(mc_biome_zoom.bz_dist(293737985876514017 as u64, 100, (0 - 4), 2000, 0.25, 0.5, 0.75), 0.539173355102539), 12)
    check(near(mc_biome_zoom.bz_dist(293737985876514017 as u64, (0 - 1), (0 - 1), (0 - 1), 0.25, 0.5, 0.75), 1.7719651985168456), 13)
    pick_is(293737985876514017, 27, 54, (0 - 62), 6, 13, (0 - 16), 14)
    pick_is(293737985876514017, (0 - 66), (0 - 49), (0 - 99), (0 - 17), (0 - 13), (0 - 25), 15)
    pick_is(293737985876514017, 10, 13, 31, 2, 3, 7, 16)
    pick_is(293737985876514017, (0 - 27), 71, 22, (0 - 8), 17, 5, 17)
    pick_is(293737985876514017, 23, 109, 71, 5, 26, 17, 18)
    pick_is(293737985876514017, (0 - 43), 77, 54, (0 - 11), 19, 13, 19)
    pick_is(293737985876514017, (0 - 99), 11, (0 - 59), (0 - 25), 2, (0 - 15), 20)
    pick_is(293737985876514017, (0 - 17), 55, (0 - 68), (0 - 5), 13, (0 - 17), 21)
    pick_is(293737985876514017, (0 - 92), 61, 3, (0 - 23), 15, 0, 22)
    pick_is(293737985876514017, (0 - 90), 15, 47, (0 - 23), 3, 11, 23)
    pick_is(293737985876514017, 73, 17, 87, 18, 4, 21, 24)
    pick_is(293737985876514017, (0 - 99), 133, (0 - 14), (0 - 25), 33, (0 - 4), 25)
    pick_is(3095511050341649436, 11, 40, (0 - 27), 2, 9, (0 - 7), 26)
    pick_is(3095511050341649436, 41, (0 - 6), (0 - 60), 9, (0 - 2), (0 - 16), 27)
    pick_is(3095511050341649436, (0 - 87), (0 - 13), (0 - 20), (0 - 22), (0 - 4), (0 - 6), 28)
    pick_is(3095511050341649436, 27, 27, (0 - 14), 6, 6, (0 - 4), 29)
    pick_is(3095511050341649436, (0 - 61), 11, (0 - 52), (0 - 15), 2, (0 - 13), 30)
    pick_is(3095511050341649436, 7, 51, 71, 1, 12, 17, 31)
    pick_is(3095511050341649436, (0 - 9), 74, (0 - 29), (0 - 3), 18, (0 - 8), 32)
    pick_is(3095511050341649436, (0 - 28), 31, 97, (0 - 8), 7, 24, 33)
    pick_is(3095511050341649436, (0 - 32), 105, (0 - 71), (0 - 9), 25, (0 - 18), 34)
    pick_is(3095511050341649436, (0 - 84), 109, 2, (0 - 21), 27, 0, 35)
    pick_is(3095511050341649436, 53, 57, 0, 13, 14, 0, 36)
    pick_is(3095511050341649436, (0 - 10), 55, (0 - 78), (0 - 3), 13, (0 - 20), 37)
    pick_is(8941161926598257533, 59, 3, (0 - 84), 14, 0, (0 - 21), 38)
    pick_is(8941161926598257533, (0 - 60), 110, (0 - 20), (0 - 16), 28, (0 - 5), 39)
    pick_is(8941161926598257533, (0 - 69), 83, (0 - 98), (0 - 18), 20, (0 - 25), 40)
    pick_is(8941161926598257533, (0 - 95), (0 - 47), 1, (0 - 24), (0 - 12), (0 - 1), 41)
    pick_is(8941161926598257533, 36, 92, 73, 9, 22, 18, 42)
    pick_is(8941161926598257533, (0 - 50), 44, (0 - 60), (0 - 13), 11, (0 - 15), 43)
    pick_is(8941161926598257533, 14, 50, (0 - 16), 3, 12, (0 - 4), 44)
    pick_is(8941161926598257533, 82, 126, 29, 20, 31, 7, 45)
    pick_is(8941161926598257533, 97, 49, (0 - 74), 24, 12, (0 - 19), 46)
    pick_is(8941161926598257533, (0 - 89), 82, 83, (0 - 23), 20, 20, 47)
    pick_is(8941161926598257533, 20, 19, 73, 4, 4, 17, 48)
    pick_is(8941161926598257533, 14, (0 - 43), 38, 3, (0 - 11), 9, 49)
    // 4000 random positions of Random(5): rolling checksum of the chosen cells (seed hash of world seed 12345)
    {
        var g: mc_noise.JavaRandom = mc_noise.jrandom_new(5)
        var sum: i64 = 0
        var i: i32 = 0
        while i < 4000 {
            let x: i32 = mc_noise.jrandom_next_int_bound(&g, 4000) - 2000
            let y: i32 = mc_noise.jrandom_next_int_bound(&g, 400) - 80
            let z: i32 = mc_noise.jrandom_next_int_bound(&g, 4000) - 2000
            let q: mc_biome_zoom.BzQuart = mc_biome_zoom.bz_pick(293737985876514017 as u64, x, y, z)
            sum = sum *% 31 +% (q.x as i64) *% 1000003 +% (q.y as i64) *% 1009 +% (q.z as i64)
            i = i + 1
        }
        check(sum == 0 - 7366515965195864559, 50)
    }
    // 4000 random positions of Random(5): rolling checksum of the chosen cells (seed hash of world seed -99)
    {
        var g: mc_noise.JavaRandom = mc_noise.jrandom_new(5)
        var sum: i64 = 0
        var i: i32 = 0
        while i < 4000 {
            let x: i32 = mc_noise.jrandom_next_int_bound(&g, 4000) - 2000
            let y: i32 = mc_noise.jrandom_next_int_bound(&g, 400) - 80
            let z: i32 = mc_noise.jrandom_next_int_bound(&g, 4000) - 2000
            let q: mc_biome_zoom.BzQuart = mc_biome_zoom.bz_pick(3095511050341649436 as u64, x, y, z)
            sum = sum *% 31 +% (q.x as i64) *% 1000003 +% (q.y as i64) *% 1009 +% (q.z as i64)
            i = i + 1
        }
        check(sum == 8219002525646498292, 51)
    }
    return 0
}
