// expect_exit: 12
// r739: error union with a function type as the ok type: -> AllocError!fn(..) -> R.
// firnc1 used to fail with "generics pass reported errors" when the expected type of
// `return gc |x| ..` was the error union placeholder (lamsugar.fi did not unwrap it).
import std.vec

gc class Cell { value: i64 }

fn make(v: i64) -> AllocError!fn(i64) -> i64 {
    let c: Gc[Cell] = try gc Cell { value: v }
    return try gc fn(x: i64) -> i64 { return c.value + x }
}

fn make_lambda(v: i64) -> AllocError!fn(i64) -> i64 {
    return gc |x| x + v
}

fn make_lambda_try(v: i64) -> AllocError!fn(i64) -> i64 {
    return try gc |x: i64| -> i64 x * v
}

#[no_inline]
fn plain(x: i64) -> i64 {
    return x
}

fn main() -> i32 {
    var fs: Vec[fn(i64) -> i64] = vec_new[fn(i64) -> i64]()
    vec_push[fn(i64) -> i64](&fs, make(2) catch plain)
    vec_push[fn(i64) -> i64](&fs, make_lambda(2) catch plain)
    vec_push[fn(i64) -> i64](&fs, make_lambda_try(3) catch plain)
    // 6 + 6 + 0
    return fs[0](4) as i32 + fs[1](4) as i32 + fs[2](0) as i32
}
