// expect_exit: 0
import std.parse

fn main() -> i32 {
    var bad: i32 = 0
    let a = parse.to_i64("123") catch 0 - 1
    if a != 123 { bad = bad + 1 }
    let b = parse.to_i64("-45") catch 0 - 1
    if b != 0 - 45 { bad = bad + 2 }
    let c = parse.to_i64("12x") catch 0 - 7
    if c != 0 - 7 { bad = bad + 4 }
    let d = parse.to_i64("") catch 0 - 8
    if d != 0 - 8 { bad = bad + 8 }
    let e = parse.to_i64("99999999999999999999") catch 0 - 9
    if e != 0 - 9 { bad = bad + 16 }
    let f = parse.to_i32("2147483648") catch 0 - 10
    if f != 0 - 10 { bad = bad + 32 }
    let g = parse.to_i32("2147483647") catch 0 - 10
    if g != 2147483647 { bad = bad + 64 }
    let h = parse.to_f64("2.5") catch 0.0
    if h != 2.5 { bad = bad + 128 }
    let i = parse.to_f64("abc") catch 1.5
    if i != 1.5 { bad = bad + 256 }
    let j = parse.to_u64("18446744073709551615") catch 0
    if j != 18446744073709551615 { bad = bad + 512 }
    let k = parse.to_u32("4294967296") catch 5
    if k != 5 { bad = bad + 1024 }
    let l = parse.to_bool("true") catch false
    if !l { bad = bad + 2048 }
    let m = parse.to_f32("0.1") catch 0.0f
    if m != 0.1f { bad = bad + 4096 }
    let n = parse.to_i64("7") catch | err | 0 - 1
    if n != 7 { bad = bad + 8192 }
    let o = parse.to_i64("zz") catch | err | 100
    if o != 100 { bad = bad + 16384 }
    var out: i64 = 0
    if !parse.try_i64("77", &out) { bad = bad + 32768 }
    if out != 77 { bad = bad + 65536 }
    if parse.try_i64("7x", &out) { bad = bad + 131072 }
    if out != 77 { bad = bad + 262144 }
    var x32: i32 = 0
    if parse.try_i32("3000000000", &x32) { bad = bad + 524288 }
    if !parse.try_i32("-3", &x32) { bad = bad + 1048576 }
    if x32 != 0 - 3 { bad = bad + 2097152 }
    var fv: f64 = 0.0
    if !parse.try_f64("1e3", &fv) { bad = bad + 4194304 }
    if fv != 1000.0 { bad = bad + 8388608 }
    return bad
}
