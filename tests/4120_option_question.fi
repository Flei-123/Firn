// expect_exit: 100
// tests/4120_option_question.fi -- `e?` on Option[T] (r725): early `return opt_none[U]()` when empty.
import std.option

struct Pt {
    x: i32,
    y: i32,
}

fn half(n: i32) -> Option[i32] {
    if n % 2 == 0 {
        return opt_some[i32](n / 2)
    }
    return opt_none[i32]()
}

// two steps: 40 -> 20 -> 10; odd anywhere -> none
fn quarter(n: i32) -> Option[i32] {
    let h = half(n)?
    let q = half(h)?
    return opt_some[i32](q)
}

// `?` inside a larger expression and a call argument
fn sum_halves(a: i32, b: i32) -> Option[i32] {
    return opt_some[i32](half(a)? + half(b)?)
}

// the operand runs once, in order, before the statement
static mut calls: i32 = 0

fn counted(n: i32) -> Option[i32] {
    calls = calls + 1
    return opt_some[i32](n)
}

fn twice_count() -> Option[i32] {
    let v = counted(5)? * counted(6)?
    return opt_some[i32](v)
}

// other result types: struct payload, if condition, statement `?`
fn make_pt(a: i32) -> Option[Pt] {
    let h = half(a)?
    if half(h)? == 1 {
        return opt_some[Pt](Pt { x: h, y: 1 })
    }
    return opt_some[Pt](Pt { x: h, y: 0 })
}

fn only_check(n: i32) -> Option[bool] {
    half(n)?
    return opt_some[bool](true)
}

fn assign(n: i32) -> Option[i32] {
    var r: i32 = 0
    r = half(n)? + 1
    return opt_some[i32](r)
}

// generic fn: `?` with Option[T]
fn first_or_none[T](o: Option[T]) -> Option[T] {
    let v = o?
    return opt_some[T](v)
}

fn main() -> i32 {
    var score: i32 = 0
    let a = quarter(40)
    if a.has && a.val == 10 {
        score = score + 1
    }
    if !quarter(42).has {
        score = score + 2
    }
    if !quarter(7).has {
        score = score + 4
    }
    let s = sum_halves(8, 6)
    if s.has && s.val == 7 {
        score = score + 8
    }
    if !sum_halves(8, 5).has {
        score = score + 16
    }
    let t = twice_count()
    if t.has && t.val == 30 && calls == 2 {
        score = score + 32
    }
    let pt = make_pt(8)
    if pt.has && pt.val.x == 4 && pt.val.y == 0 {
        score = score + 64
    }
    if !make_pt(3).has {
        score = score + 128
    }
    if only_check(2).has && !only_check(3).has {
        score = score + 256
    }
    let r = assign(10)
    if r.has && r.val == 6 && !assign(11).has {
        score = score + 512
    }
    let g = first_or_none[i32](opt_some[i32](7))
    if g.has && g.val == 7 && !first_or_none[i32](opt_none[i32]()).has {
        score = score + 1024
    }
    if score == 2047 {
        return 100
    }
    return 1
}
