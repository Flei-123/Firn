// expect_exit: 0
// tests/1242_asm_multi_out.fi -- ROUND 68: an `asm` block may have SEVERAL
// output operands, and they may be MEMORY.
//
// docs/ROUND59.md, section 8: "`asm` has exactly one output operand.
// `rdmsr` delivers its result in two registers (edx:eax). The way out was
// not a change to the language but a template that puts them together
// itself ... a second `out` would be the better form, and the kernel is the
// first user who would notice."
//
// The form: `out("rdx") p` writes the register into `*p` AFTER the template
// has run -- any number of those. `out("rax")` WITHOUT a target stays what
// it was: the value of the `asm(...)` expression, and of those there is
// still at most one.
//
// ROUND ARM-FREESTANDING: the same eight checks on both machines. The x86
// half below is the one that stood here before, character for character;
// the A64 half is the same eight questions asked in A64 (`#[arch(...)]`,
// compiler/src/archsel.rs). Two differences are worth naming, because they
// are the machine and not the language:
//
//   * A64 has no move-a-64-bit-immediate instruction, so point 5 builds
//     its two halves with `movz`/`movk` where x86 writes one `mov`.
//   * A64 has no memory operand on an arithmetic instruction, so point 6
//     needs a scratch register -- and a scratch register a template uses
//     has to stand in the clobber list, which is exactly what that list is
//     for.

#[arch(x86_64)]
fn main() -> i32 {
    // 1. three outputs, each into its own target
    var a: u64 = 0
    var b: u64 = 0
    var c: u64 = 0
    asm("mov rax, 11\nmov rcx, 22\nmov rdx, 33",
        out("rax") & a, out("rcx") & b, out("rdx") & c)
    if a != 11 { return 1 }
    if b != 22 { return 2 }
    if c != 33 { return 3 }

    // 2. the ORDER of the operands does not decide which register lands
    //    where -- the register name does.
    a = 0
    c = 0
    asm("mov rax, 1\nmov rdx, 2", out("rdx") & c, out("rax") & a)
    if a != 1 { return 4 }
    if c != 2 { return 5 }

    // 3. inputs and outputs together
    let x: u64 = 40
    let y: u64 = 2
    asm("add rax, rcx\nmov rdx, rax",
        in("rax") x, in("rcx") y, out("rax") & a, out("rdx") & b)
    if a != 42 { return 6 }
    if b != 42 { return 7 }

    // 4. the VALUE form and a memory output in one block
    b = 0
    let s: u64 = asm("mov rax, 7\nmov rdx, 9", out("rax"), out("rdx") & b)
    if s != 7 { return 8 }
    if b != 9 { return 9 }

    // 5. THE CASE FROM THE KERNEL: a 64-bit value that arrives in edx:eax.
    //    Up to round 67 the template had to shift and or it together
    //    itself; now the two halves come out separately and the language
    //    puts them together.
    var lo: u64 = 0
    var hi: u64 = 0
    asm("mov rax, 0x89ABCDEF\nmov rdx, 0x01234567",
        out("rax") & lo, out("rdx") & hi)
    let full: u64 = (hi << 32) | (lo & 0xFFFFFFFF)
    if full != 0x0123456789ABCDEF { return 10 }

    // 6. A MEMORY AREA as an operand: the address goes into a register, the
    //    template writes through it. `clobber("memory")` is what says that
    //    the block touches memory nobody named.
    var arr: [u64; 4] = [0; 4]
    let p: *mut u64 = &arr[0]
    asm("mov qword ptr [rcx], 5\nmov qword ptr [rcx + 8], 6",
        in("rcx") p, clobber("memory"))
    if arr[0] != 5 { return 11 }
    if arr[1] != 6 { return 12 }
    if arr[2] != 0 { return 13 }

    // 7. and the same the other way round: the block reads a memory area
    //    and hands both halves back separately.
    arr[2] = 77
    arr[3] = 88
    asm("mov rax, qword ptr [rcx + 16]\nmov rdx, qword ptr [rcx + 24]",
        in("rcx") p, out("rax") & a, out("rdx") & b)
    if a != 77 { return 14 }
    if b != 88 { return 15 }

    // 8. a pointer target is allowed as well -- eight octets is eight octets
    var q: *mut u64 = &arr[0]
    asm("mov rax, rcx", in("rcx") p, out("rax") & q)
    *q = 99
    if arr[0] != 99 { return 16 }
    return 0
}

#[arch(aarch64)]
fn main() -> i32 {
    // 1. three outputs, each into its own target
    var a: u64 = 0
    var b: u64 = 0
    var c: u64 = 0
    asm("mov x0, #11\nmov x1, #22\nmov x2, #33",
        out("x0") & a, out("x1") & b, out("x2") & c)
    if a != 11 { return 1 }
    if b != 22 { return 2 }
    if c != 33 { return 3 }

    // 2. the ORDER of the operands does not decide which register lands
    //    where -- the register name does.
    a = 0
    c = 0
    asm("mov x0, #1\nmov x2, #2", out("x2") & c, out("x0") & a)
    if a != 1 { return 4 }
    if c != 2 { return 5 }

    // 3. inputs and outputs together
    let x: u64 = 40
    let y: u64 = 2
    asm("add x0, x0, x1\nmov x2, x0",
        in("x0") x, in("x1") y, out("x0") & a, out("x2") & b)
    if a != 42 { return 6 }
    if b != 42 { return 7 }

    // 4. the VALUE form and a memory output in one block
    b = 0
    let s: u64 = asm("mov x0, #7\nmov x2, #9", out("x0"), out("x2") & b)
    if s != 7 { return 8 }
    if b != 9 { return 9 }

    // 5. THE CASE FROM THE KERNEL: a 64-bit value that arrives in two
    //    halves. On x86 that is edx:eax after a `rdmsr`; here the halves
    //    have to be BUILT, because A64 has no instruction that moves a
    //    32-bit immediate in one go -- `movz` writes the low sixteen bits
    //    and `movk` keeps what is already there while writing the next
    //    sixteen. Which is the same question the test asks: the language
    //    puts the two halves together, not the template.
    var lo: u64 = 0
    var hi: u64 = 0
    asm("movz x0, #0xCDEF\nmovk x0, #0x89AB, lsl #16\nmovz x2, #0x4567\nmovk x2, #0x0123, lsl #16",
        out("x0") & lo, out("x2") & hi)
    let full: u64 = (hi << 32) | (lo & 0xFFFFFFFF)
    if full != 0x0123456789ABCDEF { return 10 }

    // 6. A MEMORY AREA as an operand: the address goes into a register, the
    //    template writes through it. `clobber("memory")` is what says that
    //    the block touches memory nobody named -- and `clobber("x1")` says
    //    that the template needed a register of its own to do it, which on
    //    this machine it does: there is no store of an immediate.
    var arr: [u64; 4] = [0; 4]
    let p: *mut u64 = &arr[0]
    asm("mov x1, #5\nstr x1, [x0]\nmov x1, #6\nstr x1, [x0, #8]",
        in("x0") p, clobber("x1"), clobber("memory"))
    if arr[0] != 5 { return 11 }
    if arr[1] != 6 { return 12 }
    if arr[2] != 0 { return 13 }

    // 7. and the same the other way round: the block reads a memory area
    //    and hands both halves back separately.
    arr[2] = 77
    arr[3] = 88
    asm("ldr x0, [x1, #16]\nldr x2, [x1, #24]",
        in("x1") p, out("x0") & a, out("x2") & b)
    if a != 77 { return 14 }
    if b != 88 { return 15 }

    // 8. a pointer target is allowed as well -- eight octets is eight octets
    var q: *mut u64 = &arr[0]
    asm("mov x0, x1", in("x1") p, out("x0") & q)
    *q = 99
    if arr[0] != 99 { return 16 }
    return 0
}
