// expect_exit: 0
import media.video.vp9.vp9mem
import media.video.av1.av1blkst
import media.video.av1.av1fhdr
import media.video.av1.av1seq
import media.video.av1.av1ref
import media.video.av1.av1mfbuf
import media.video.av1.av1mfmv
import media.video.av1.av1lf

fn put_ref(ref_a: u64, mv_a: u64, mi: i64, list: i64, r: i64, mvr: i64, mvc: i64) {
    vp9mem.st8(ref_a, (mi * 2 + list) as usize, r)
    vp9mem.sti16(mv_a, (mi * 4 + list * 2) as usize, mvr)
    vp9mem.sti16(mv_a, (mi * 4 + list * 2 + 1) as usize, mvc)
}

fn check_save() -> i64 {
    let seq: *mut av1seq.SeqHdr = av1seq.seq_new()
    (*seq).enable_order_hint = 1
    (*seq).order_hint_bits = 7
    let fh: *mut av1fhdr.FrameHdr = av1fhdr.fhdr_new()
    (*fh).order_hint = 50
    (*fh).order_hints[1] = 40
    (*fh).order_hints[5] = 60
    (*fh).order_hints[7] = 50
    let ref_a: u64 = vp9mem.alloc(8 * 8 * 2)
    let mv_a: u64 = vp9mem.alloc(8 * 8 * 8)
    vp9mem.zero(ref_a, 128)
    vp9mem.zero(mv_a, 512)
    put_ref(ref_a, mv_a, 1 * 8 + 1, 0, 1, 10, 0 - 20)
    put_ref(ref_a, mv_a, 1 * 8 + 3, 0, 5, 7, 7)
    put_ref(ref_a, mv_a, 1 * 8 + 5, 0, 7, 7, 7)
    put_ref(ref_a, mv_a, 1 * 8 + 7, 0, 1, 4096, 0)
    put_ref(ref_a, mv_a, 3 * 8 + 1, 0, 5, 1, 1)
    put_ref(ref_a, mv_a, 3 * 8 + 1, 1, 1, 0 - 4095, 4095)
    put_ref(ref_a, mv_a, 3 * 8 + 3, 0, 1, 11, 12)
    put_ref(ref_a, mv_a, 3 * 8 + 3, 1, 1, 13, 14)
    put_ref(ref_a, mv_a, 2 * 8 + 1, 0, 1, 99, 99)
    let mf: *mut av1mfbuf.MfBuf = av1mfbuf.mfbuf_new(8, 8)
    av1mfbuf.mf_save_mvs(mf, ref_a, mv_a, fh, seq)
    var bad: i64 = 0
    if av1mfbuf.mf_ref_at(mf, 0, 0) != 1 || av1mfbuf.mf_mv_at(mf, 0, 0, 0) != 10 || av1mfbuf.mf_mv_at(mf, 0, 0, 1) != 0 - 20 {
        bad = 1
    }
    if av1mfbuf.mf_ref_at(mf, 0, 1) != 0 {
        bad = 2
    }
    if av1mfbuf.mf_ref_at(mf, 0, 2) != 0 {
        bad = 3
    }
    if av1mfbuf.mf_ref_at(mf, 0, 3) != 0 {
        bad = 4
    }
    if av1mfbuf.mf_ref_at(mf, 1, 0) != 1 || av1mfbuf.mf_mv_at(mf, 1, 0, 0) != 0 - 4095 || av1mfbuf.mf_mv_at(mf, 1, 0, 1) != 4095 {
        bad = 5
    }
    if av1mfbuf.mf_ref_at(mf, 1, 1) != 1 || av1mfbuf.mf_mv_at(mf, 1, 1, 0) != 13 || av1mfbuf.mf_mv_at(mf, 1, 1, 1) != 14 {
        bad = 6
    }
    av1mfbuf.mfbuf_release(mf)
    return bad
}

fn check_segids() -> i64 {
    let fh: *mut av1fhdr.FrameHdr = av1fhdr.fhdr_new()
    let mf: *mut av1mfbuf.MfBuf = av1mfbuf.mfbuf_new(4, 4)
    let cur: u64 = vp9mem.alloc(16)
    let prev: u64 = vp9mem.alloc(16)
    var i: usize = 0
    while i < 16 {
        vp9mem.st8(cur, i, 1 + i as i64 % 3)
        vp9mem.st8(prev, i, 5)
        i = i + 1
    }
    av1mfbuf.mf_save_segids(mf, cur, fh, prev)
    var bad: i64 = 0
    if av1mfbuf.mf_seg_at(mf, 2, 3) != 1 + 11 % 3 {
        bad = 1
    }
    (*fh).segmentation_enabled = 1
    (*fh).segmentation_update_map = 0
    av1mfbuf.mf_save_segids(mf, cur, fh, prev)
    if av1mfbuf.mf_seg_at(mf, 2, 3) != 5 {
        bad = 2
    }
    av1mfbuf.mf_save_segids(mf, cur, fh, 0)
    if av1mfbuf.mf_seg_at(mf, 2, 3) != 0 {
        bad = 3
    }
    (*fh).segmentation_update_map = 1
    av1mfbuf.mf_save_segids(mf, cur, fh, prev)
    if av1mfbuf.mf_seg_at(mf, 0, 1) != 2 {
        bad = 4
    }
    av1mfbuf.mfbuf_release(mf)
    return bad
}

fn check_refcount() -> i64 {
    let seq: *mut av1seq.SeqHdr = av1seq.seq_new()
    let fh: *mut av1fhdr.FrameHdr = av1fhdr.fhdr_new()
    let st: *mut av1ref.RefState = av1ref.ref_state_new()
    let mf: *mut av1mfbuf.MfBuf = av1mfbuf.mfbuf_new(8, 8)
    (*fh).refresh_frame_flags = 5
    (*fh).mi_rows = 8
    (*fh).mi_cols = 8
    av1ref.ref_update(st, fh, seq, mf as u64)
    var bad: i64 = 0
    if (*mf).refs != 3 || (*st).slots[0].mf != mf as u64 || (*st).slots[1].mf != 0 || (*st).slots[2].mf != mf as u64 {
        bad = 1
    }
    (*fh).refresh_frame_flags = 1
    let mf2: *mut av1mfbuf.MfBuf = av1mfbuf.mfbuf_new(8, 8)
    av1ref.ref_update(st, fh, seq, mf2 as u64)
    if (*mf).refs != 2 || (*mf2).refs != 2 {
        bad = 2
    }
    (*fh).segmentation_enabled = 1
    (*fh).primary_ref_frame = 0
    (*fh).ref_frame_idx[0] = 0
    (*fh).mi_rows = 8
    (*fh).mi_cols = 8
    if av1ref.ref_prev_segment_ids(st, fh) != (*mf2).seg_ids {
        bad = 3
    }
    (*fh).mi_rows = 10
    if av1ref.ref_prev_segment_ids(st, fh) != 0 {
        bad = 4
    }
    (*fh).frame_type = av1fhdr.KEY_FRAME
    (*fh).frame_to_show_map_idx = 2
    av1ref.ref_show_existing(st, fh)
    if (*mf).refs != 9 || (*mf2).refs != 1 || (*st).slots[7].mf != mf as u64 {
        bad = 5
    }
    av1ref.ref_state_free(st)
    if (*mf).refs != 1 {
        bad = 6
    }
    av1mfbuf.mfbuf_release(mf)
    av1mfbuf.mfbuf_release(mf2)
    return bad
}

fn check_lf_levels() -> i64 {
    let seq: *mut av1seq.SeqHdr = av1seq.seq_new()
    (*seq).num_planes = 1
    (*seq).bit_depth = 8
    (*seq).subsampling_x = 1
    (*seq).subsampling_y = 1
    let fh: *mut av1fhdr.FrameHdr = av1fhdr.fhdr_new()
    (*fh).mi_rows = 8
    (*fh).mi_cols = 8
    (*fh).frame_width = 32
    (*fh).frame_height = 32
    (*fh).upscaled_width = 32
    (*fh).tile_cols = 1
    (*fh).tile_rows = 1
    (*fh).mi_row_starts[1] = 8
    (*fh).mi_col_starts[1] = 8
    (*fh).loop_filter_level[0] = 20
    (*fh).loop_filter_level[1] = 40
    (*fh).loop_filter_delta_enabled = 1
    (*fh).loop_filter_ref_deltas[0] = 1
    (*fh).loop_filter_ref_deltas[1] = 0
    (*fh).loop_filter_ref_deltas[4] = 0 - 1
    (*fh).loop_filter_ref_deltas[7] = 0 - 1
    (*fh).loop_filter_mode_deltas[0] = 2
    (*fh).loop_filter_mode_deltas[1] = 0 - 3
    let td: *mut av1blkst.TileDec = av1blkst.td_new()
    av1blkst.td_setup_frame(td, seq, fh)
    av1blkst.mi_set(td, (*td).ref_a, 0, 0, 0)
    av1blkst.st((*td).ref_a, 2 * 1, 1)
    av1blkst.mi_set(td, (*td).ymode_a, 0, 1, 13)
    av1blkst.st((*td).ref_a, 2 * 2, 1)
    av1blkst.mi_set(td, (*td).ymode_a, 0, 2, 15)
    av1blkst.st((*td).ref_a, 2 * 3, 4)
    av1blkst.mi_set(td, (*td).ymode_a, 0, 3, 16)
    av1blkst.st((*td).ref_a, 2 * 4, 7)
    av1blkst.mi_set(td, (*td).ymode_a, 0, 4, 23)
    av1blkst.st((*td).ref_a, 2 * 5, 7)
    av1blkst.mi_set(td, (*td).ymode_a, 0, 5, 24)
    var bad: i64 = 0
    if av1lf.filter_level(td, 0, 0, 0, 0) != 21 {
        bad = 1
    }
    if av1lf.filter_level(td, 0, 1, 0, 0) != 17 {
        bad = 2
    }
    if av1lf.filter_level(td, 0, 2, 0, 0) != 22 {
        bad = 3
    }
    if av1lf.filter_level(td, 0, 3, 0, 0) != 16 {
        bad = 4
    }
    if av1lf.filter_level(td, 0, 4, 0, 0) != 21 {
        bad = 5
    }
    if av1lf.filter_level(td, 0, 5, 0, 0) != 16 {
        bad = 6
    }
    if av1lf.filter_level(td, 0, 0, 0, 1) != 42 {
        bad = 7
    }
    if av1lf.filter_level(td, 0, 3, 0, 1) != 32 {
        bad = 8
    }
    (*fh).loop_filter_delta_enabled = 0
    if av1lf.filter_level(td, 0, 3, 0, 0) != 20 {
        bad = 9
    }
    return bad
}

fn check_projection() -> i64 {
    if av1mfmv.mv_projection(100, 1, 1) != 100 || av1mfmv.mv_projection(100, 1, 2) != 50 || av1mfmv.mv_projection(100, 2, 1) != 200 {
        return 1
    }
    if av1mfmv.mv_projection(0 - 100, 1, 3) != 0 - 33 || av1mfmv.mv_projection(100, 0 - 1, 3) != 0 - 33 || av1mfmv.mv_projection(7, 3, 2) != 11 {
        return 2
    }
    if av1mfmv.mv_projection(16383, 31, 1) != 16383 || av1mfmv.mv_projection(0 - 16383, 40, 1) != 0 - 16383 || av1mfmv.mv_projection(100, 1, 40) != 3 {
        return 3
    }
    return 0
}

fn main() -> i32 {
    let a: i64 = check_save()
    if a != 0 {
        return (10 + a) as i32
    }
    let b: i64 = check_segids()
    if b != 0 {
        return (20 + b) as i32
    }
    let c: i64 = check_refcount()
    if c != 0 {
        return (30 + c) as i32
    }
    let d: i64 = check_lf_levels()
    if d != 0 {
        return (40 + d) as i32
    }
    let e: i64 = check_projection()
    if e != 0 {
        return (50 + e) as i32
    }
    return 0
}
