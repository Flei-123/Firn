// expect_exit: 0
// tests/2907_mc_wlight_region.fi -- moving light region (mc_wlight.wl_region_recenter).
//
// Terrain world of 9x9 columns, region 5x5 columns, margin 1.
// A  first call loads (2), memory bytes = cells * 5 and stays constant while moving
// B  hysteresis: moves inside the margin keep the region (0), crossing it moves the region (1) centered on the player
// C  after a move the volume == a fresh wl_region_load at the same origin (light_equal)
// D  an edit survives a move away and back (the volume == a fresh load of the edited world, emitter light intact)
import std.rt
import mc.mc_world
import mc.mc_terrain
import mc.mc_render_world
import mc.mc_light
import mc.mc_wlight

const NSEC: i32 = 6
const RAD: i32 = 4
const LAMP: i32 = 4

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn setup_wl(wl: *mut mc_wlight.WorldLight) {
    let op: u64 = rt.heap_alloc(32768)
    let em: u64 = rt.heap_alloc(32768)
    var i: usize = 0
    while i < 32768 {
        rt.st8(op, i, 0 as u8)
        rt.st8(em, i, 0 as u8)
        i = i + 1
    }
    rt.st8(op, 1, 15 as u8)
    rt.st8(op, 2, 15 as u8)
    rt.st8(op, 3, 15 as u8)
    rt.st8(op, 4, 1 as u8)
    rt.st8(em, 4, 14 as u8)
    mc_wlight.wl_set_tables(wl, op, em)
    rt.heap_free(op, 32768)
    rt.heap_free(em, 32768)
}

#[allow_escape]
fn load_world(w: *mut mc_world.World) {
    let ids: u64 = rt.heap_alloc(NSEC as usize * 4096 * 2)
    var cz: i32 = 0 - RAD
    while cz <= RAD {
        var cx: i32 = 0 - RAD
        while cx <= RAD {
            mc_terrain.terrain_column(cx, cz, NSEC, ids)
            let p: u64 = mc_render_world.wr_make_chunk(cx, cz, NSEC as usize, ids)
            check(p != 0, 50)
            check(mc_world.world_put(w, p), 51)
            cx = cx + 1
        }
        cz = cz + 1
    }
    rt.heap_free(ids, NSEC as usize * 4096 * 2)
}

#[allow_escape]
fn main() -> i32 {
    var w: mc_world.World = mc_world.world_new()
    load_world(&w)
    var wl: mc_wlight.WorldLight = mc_wlight.wl_new(0, NSEC)
    setup_wl(&wl)

    // A
    check(mc_wlight.wl_region_bytes(&wl) == 0, 1)
    check(mc_wlight.wl_region_recenter(&wl, &w, 0, 0, 5, 5, 1, false) == 2, 2)
    let bytes: usize = mc_wlight.wl_region_bytes(&wl)
    check(bytes == 80 * 96 * 80 * 5, 3)
    check(wl.cx0 == 0 - 2 && wl.cz0 == 0 - 2, 4)

    // B: region columns -2..2; margin 1 -> kept while the player column is in -1..1
    check(mc_wlight.wl_region_recenter(&wl, &w, 1, 0, 5, 5, 1, false) == 0, 5)
    check(mc_wlight.wl_region_recenter(&wl, &w, 0 - 1, 1, 5, 5, 1, false) == 0, 6)
    check(wl.cx0 == 0 - 2, 7)
    check(mc_wlight.wl_region_recenter(&wl, &w, 2, 0, 5, 5, 1, false) == 1, 8)
    check(wl.cx0 == 0 && wl.cz0 == 0 - 2, 9)
    check(mc_wlight.wl_region_bytes(&wl) == bytes, 10)

    // C
    {
        var f: mc_wlight.WorldLight = mc_wlight.wl_new(0, NSEC)
        setup_wl(&f)
        check(mc_wlight.wl_region_load(&f, &w, 0, 0 - 2, 5, 5, false) == 25, 11)
        check(mc_light.light_equal(&wl.vol, &f.vol) == 0, 12)
        mc_wlight.wl_free(&f)
    }

    // D: emitter in column (2, 0), move away (region -4..0) and back
    let ex: i32 = 40
    let ez: i32 = 8
    let ey: i32 = mc_terrain.terrain_height(ex, ez, NSEC) + 1
    check(mc_wlight.wl_edit(&wl, &w, ex, ey, ez, LAMP) >= 0, 13)
    check(mc_light.light_block(&wl.vol, ex - wl.cx0 * 16, ey, ez - wl.cz0 * 16) == 14 as u8, 14)
    check(mc_wlight.wl_region_recenter(&wl, &w, 0 - 2, 0, 5, 5, 1, false) == 1, 15)
    check(wl.cx0 == 0 - 4, 16)
    check(!mc_wlight.wl_region_covers(&wl, 2, 0), 17)
    check(mc_wlight.wl_region_recenter(&wl, &w, 2, 0, 5, 5, 1, false) == 1, 18)
    check(mc_light.light_block(&wl.vol, ex - wl.cx0 * 16, ey, ez - wl.cz0 * 16) == 14 as u8, 19)
    {
        var f: mc_wlight.WorldLight = mc_wlight.wl_new(0, NSEC)
        setup_wl(&f)
        check(mc_wlight.wl_region_load(&f, &w, wl.cx0, wl.cz0, 5, 5, false) == 25, 20)
        check(mc_light.light_equal(&wl.vol, &f.vol) == 0, 21)
        mc_wlight.wl_free(&f)
    }
    mc_wlight.wl_free(&wl)
    mc_world.world_free(&w)
    return 0
}
