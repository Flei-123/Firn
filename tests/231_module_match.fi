// expect_exit: 105
// 'enum' + 'match' in an IMPORTED module (tests/modules/state.fi).
// The body of a match case calls a module-internal function and reads a
// module-internal constant -- the module system has to rewrite both.
// Note (SPEC 14.1): enumeration names are program-wide today, not per
// module -- hence 'Light::Red' and not 'state.Light::Red'.
import modules.state

fn main() -> i32 {
    var a: Light = Light::Red
    var sum: i32 = 0
    var i: i32 = 0
    while i < 4 as i32 {
        sum = sum + state.duration(a)
        a = state.step(a)
        i = i + 1
    }
    // 30 + 10 + 25 + 15 = 80, after that the cycle is back at Red
    match a {
        Light::Red => { sum = sum + 25 as i32 }
        Light::RedYellow => { sum = sum + 1 as i32 }
        Light::Green => { sum = sum + 2 as i32 }
        Light::Yellow => { sum = sum + 3 as i32 }
    }
    return sum
}
