// expect_exit: 105
// 'enum' + 'match' in einem IMPORTIERTEN Modul (tests/modules/state.fi).
// Der Rumpf eines match-Falles ruft eine modulinterne Funktion und liest eine
// modulinterne Konstante — beides muss vom Modulsystem umgeschrieben werden.
// Anmerkung (SPEC §14.1): Aufzaehlungsnamen sind heute programmweit, nicht je
// Modul — deshalb 'Ampel::Rot' und nicht 'zustand.Ampel::Rot'.
import modules.state

fn main() -> i32 {
    var a: Light = Light::Red
    var sum: i32 = 0
    var i: i32 = 0
    while i < 4 as i32 {
        sum = sum + state.duration(a)
        a = state.step(a)
        i = i + 1
    }
    // 30 + 10 + 25 + 15 = 80, danach ist der Zyklus wieder bei Rot
    match a {
        Light::Red => { sum = sum + 25 as i32 }
        Light::RedYellow => { sum = sum + 1 as i32 }
        Light::Green => { sum = sum + 2 as i32 }
        Light::Yellow => { sum = sum + 3 as i32 }
    }
    return sum
}
