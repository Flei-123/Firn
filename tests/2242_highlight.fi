// expect_exit: 0
// tests/2242_highlight.fi -- lib/highlight: the rules of every language on sample
// text (the kind of a chosen word), the tiling guarantee (the spans cover the
// text exactly, in order, none empty) on 540 random texts in every language,
// the language names, and the linear time (sixteen kilobytes of one
// language tokenizes in one pass).
import highlight.highlight
import std.rt
import std.vec
import std.io
import std.time

static mut bad: i32 = 0
static mut done: i32 = 0
static mut seed: u64 = 99

fn rnd() -> u32 {
    seed = seed *% 6364136223846793005 +% 1442695040888963407
    return ((seed >> 33) & 2147483647) as u32
}

fn find(src: str, needle: str) -> usize {
    var i: usize = 0
    while i + needle.n <= src.n {
        var k: usize = 0
        while k < needle.n && rt.ld8(src.p as u64, i + k) == rt.ld8(needle.p as u64, k) {
            k++
        }
        if k == needle.n {
            return i
        }
        i++
    }
    return src.n
}

// the kind of the first octet of `needle` (its first occurrence) in `src`
fn kind_of(h: *mut highlight.Highlighter, lang: u32, src: str, needle: str) -> u32 {
    var sp: Vec[highlight.HlSpan] = vec_new[highlight.HlSpan]()
    highlight.hl_tokenize(h, lang, src.p as u64, src.n, &sp)
    let at: usize = find(src, needle)
    let k: u32 = highlight.hl_kind_at(&sp, at)
    vec_free[highlight.HlSpan](&sp)
    return k
}

fn expect(h: *mut highlight.Highlighter, lang: u32, src: str, needle: str, want: u32, what: str) {
    done = done + 1
    let k: u32 = kind_of(h, lang, src, needle)
    if k != want {
        bad = bad + 1
        io.fmt_print_line(f"FAIL {what}: [{needle}] is kind {k}, wanted {want}")
    }
}

fn tiles(h: *mut highlight.Highlighter, lang: u32, p: u64, n: usize) -> bool {
    var sp: Vec[highlight.HlSpan] = vec_new[highlight.HlSpan]()
    highlight.hl_tokenize(h, lang, p, n, &sp)
    var pos: usize = 0
    var i: usize = 0
    var good: bool = true
    while i < vec_len[highlight.HlSpan](&sp) {
        let s: *mut highlight.HlSpan = vec_elem_ptr[highlight.HlSpan](&sp, i)
        if (*s).start != pos || (*s).len == 0 || (*s).kind >= highlight.TK_COUNT {
            good = false
        }
        pos = pos + (*s).len
        i++
    }
    if pos != n {
        good = false
    }
    vec_free[highlight.HlSpan](&sp)
    return good
}

fn main() -> i32 {
    var h: highlight.Highlighter = highlight.hl_new()
    let J: u32 = highlight.HL_JSON
    let json: str = "{\"name\": \"x\", \"n\": [1, -2.5e3, true, null], // c\n  \"o\": {\"k\": 0}}"
    expect(&h, J, json, "\"name\"", highlight.TK_KEY, "json key")
    expect(&h, J, json, "\"x\"", highlight.TK_STRING, "json value")
    expect(&h, J, json, "-2.5e3", highlight.TK_NUMBER, "json number")
    expect(&h, J, json, "true", highlight.TK_CONSTANT, "json true")
    expect(&h, J, json, "null", highlight.TK_CONSTANT, "json null")
    expect(&h, J, json, "// c", highlight.TK_COMMENT, "json comment")
    expect(&h, J, json, "\"k\"", highlight.TK_KEY, "nested key")
    let toml: str = "# top\n[server]\nhost = \"a.b\"\nport = 8080\non = true\nwhen = 2026-09-25T10:00:00Z\nlist = [1, 2]\n"
    expect(&h, highlight.HL_TOML, toml, "# top", highlight.TK_COMMENT, "toml comment")
    expect(&h, highlight.HL_TOML, toml, "[server]", highlight.TK_TYPE, "toml table")
    expect(&h, highlight.HL_TOML, toml, "host", highlight.TK_KEY, "toml key")
    expect(&h, highlight.HL_TOML, toml, "\"a.b\"", highlight.TK_STRING, "toml string")
    expect(&h, highlight.HL_TOML, toml, "8080", highlight.TK_NUMBER, "toml number")
    expect(&h, highlight.HL_TOML, toml, "true", highlight.TK_CONSTANT, "toml bool")
    expect(&h, highlight.HL_TOML, toml, "2026-09", highlight.TK_NUMBER, "toml date")
    let ini: str = "; c\n[core]\nname = Fleitec Launcher\nverbose = yes\nlevel=3\n"
    expect(&h, highlight.HL_INI, ini, "; c", highlight.TK_COMMENT, "ini comment")
    expect(&h, highlight.HL_INI, ini, "[core]", highlight.TK_TYPE, "ini section")
    expect(&h, highlight.HL_INI, ini, "name", highlight.TK_KEY, "ini key")
    expect(&h, highlight.HL_INI, ini, "yes", highlight.TK_CONSTANT, "ini bool")
    expect(&h, highlight.HL_INI, ini, "3", highlight.TK_NUMBER, "ini number")
    let firn: str = "#[no_gc]\nfn main(x: u8) -> i32 {\n    let s: str = f\"n={x}\" // hi\n    return foo(x) + 0xFF as i32\n}\nstruct Point { x: i32 }\n/* block\n comment */"
    expect(&h, highlight.HL_FIRN, firn, "#[no_gc]", highlight.TK_ATTR, "firn attribute")
    expect(&h, highlight.HL_FIRN, firn, "fn", highlight.TK_KEYWORD, "firn fn")
    expect(&h, highlight.HL_FIRN, firn, "u8", highlight.TK_TYPE, "firn primitive")
    expect(&h, highlight.HL_FIRN, firn, "f\"n=", highlight.TK_STRING, "firn f-string")
    expect(&h, highlight.HL_FIRN, firn, "// hi", highlight.TK_COMMENT, "firn comment")
    expect(&h, highlight.HL_FIRN, firn, "return", highlight.TK_KEYWORD, "firn return")
    expect(&h, highlight.HL_FIRN, firn, "foo", highlight.TK_FUNCTION, "firn call")
    expect(&h, highlight.HL_FIRN, firn, "0xFF", highlight.TK_NUMBER, "firn hex")
    expect(&h, highlight.HL_FIRN, firn, "Point", highlight.TK_TYPE, "firn struct name")
    expect(&h, highlight.HL_FIRN, firn, "block", highlight.TK_COMMENT, "firn block comment")
    expect(&h, highlight.HL_FIRN, firn, "comment */", highlight.TK_COMMENT, "firn block comment end")
    expect(&h, highlight.HL_FIRN, firn, "main", highlight.TK_FUNCTION, "firn declared name")
    let sh: str = "# build\nif [ -f $HOME/x ]; then echo \"hi $USER\" --flag; fi\nexport N=${COUNT:-3}\n"
    expect(&h, highlight.HL_SHELL, sh, "# build", highlight.TK_COMMENT, "sh comment")
    expect(&h, highlight.HL_SHELL, sh, "if", highlight.TK_KEYWORD, "sh if")
    expect(&h, highlight.HL_SHELL, sh, "$HOME", highlight.TK_VARIABLE, "sh variable")
    expect(&h, highlight.HL_SHELL, sh, "echo", highlight.TK_FUNCTION, "sh command")
    expect(&h, highlight.HL_SHELL, sh, "\"hi", highlight.TK_STRING, "sh string")
    expect(&h, highlight.HL_SHELL, sh, "--flag", highlight.TK_ATTR, "sh option")
    expect(&h, highlight.HL_SHELL, sh, "export", highlight.TK_KEYWORD, "sh export")
    expect(&h, highlight.HL_SHELL, sh, "${COUNT:-3}", highlight.TK_VARIABLE, "sh braces")
    let md: str = "# Title\n\nSome **bold** and *it* and `code` [l](http://x)\n> quote\n- item\n```json\n{\"a\": 1}\n```\n"
    expect(&h, highlight.HL_MARKDOWN, md, "# Title", highlight.TK_HEADING, "md heading")
    expect(&h, highlight.HL_MARKDOWN, md, "**bold**", highlight.TK_EMPH, "md bold")
    expect(&h, highlight.HL_MARKDOWN, md, "*it*", highlight.TK_EMPH, "md italic")
    expect(&h, highlight.HL_MARKDOWN, md, "`code`", highlight.TK_STRING, "md code span")
    expect(&h, highlight.HL_MARKDOWN, md, "[l](", highlight.TK_LINK, "md link")
    expect(&h, highlight.HL_MARKDOWN, md, "> quote", highlight.TK_COMMENT, "md quote")
    expect(&h, highlight.HL_MARKDOWN, md, "```json", highlight.TK_STRING, "md fence")
    expect(&h, highlight.HL_MARKDOWN, md, "\"a\"", highlight.TK_STRING, "md fence body")
    let yml: str = "# c\nname: demo\nlist:\n  - a: 1\n  - b: \"x\"\nok: true\n"
    expect(&h, highlight.HL_YAML, yml, "# c", highlight.TK_COMMENT, "yaml comment")
    expect(&h, highlight.HL_YAML, yml, "name", highlight.TK_KEY, "yaml key")
    expect(&h, highlight.HL_YAML, yml, "\"x\"", highlight.TK_STRING, "yaml string")
    expect(&h, highlight.HL_YAML, yml, "true", highlight.TK_CONSTANT, "yaml bool")
    expect(&h, highlight.HL_YAML, yml, "1", highlight.TK_NUMBER, "yaml number")
    let js: str = "@Override\npublic static void main(String[] a) { int n = 0x1F; // c\n return new Foo(\"s\"); }"
    expect(&h, highlight.HL_CLIKE, js, "@Override", highlight.TK_ATTR, "java annotation")
    expect(&h, highlight.HL_CLIKE, js, "public", highlight.TK_KEYWORD, "java public")
    expect(&h, highlight.HL_CLIKE, js, "void", highlight.TK_KEYWORD, "java void")
    expect(&h, highlight.HL_CLIKE, js, "int", highlight.TK_TYPE, "java int")
    expect(&h, highlight.HL_CLIKE, js, "0x1F", highlight.TK_NUMBER, "java hex")
    expect(&h, highlight.HL_CLIKE, js, "// c", highlight.TK_COMMENT, "java comment")
    expect(&h, highlight.HL_CLIKE, js, "Foo", highlight.TK_TYPE, "java class")
    expect(&h, highlight.HL_CLIKE, js, "\"s\"", highlight.TK_STRING, "java string")

    // the language names
    done = done + 9
    if highlight.hl_language("json") != highlight.HL_JSON || highlight.hl_language("JSON") != highlight.HL_JSON { bad = bad + 1 }
    if highlight.hl_language("toml") != highlight.HL_TOML { bad = bad + 1 }
    if highlight.hl_language("properties") != highlight.HL_INI { bad = bad + 1 }
    if highlight.hl_language("firn") != highlight.HL_FIRN || highlight.hl_language("fi") != highlight.HL_FIRN { bad = bad + 1 }
    if highlight.hl_language("bash title=x") != highlight.HL_SHELL { bad = bad + 1 }
    if highlight.hl_language("md") != highlight.HL_MARKDOWN { bad = bad + 1 }
    if highlight.hl_language("yml") != highlight.HL_YAML { bad = bad + 1 }
    if highlight.hl_language("java") != highlight.HL_CLIKE { bad = bad + 1 }
    if highlight.hl_language("brainfuck") != highlight.HL_NONE || highlight.hl_language("") != highlight.HL_NONE { bad = bad + 1 }

    // the tiling guarantee on random text made of the characters the rules look at
    let alphabet: str = "ab \t\n\"'`#/*-+=:;,.{}[]()<>$@!&|\\0123xyzABC_ _\u{e4}\u{4e2d}"
    var round: u32 = 0
    var tile_fail: i32 = 0
    while round < 60 {
        let len: usize = (rnd() % 200) as usize
        var buf: rt.Buf = rt.buf_new()
        var q: usize = 0
        while q < len {
            // the alphabet holds multi-octet characters: pick a start octet
            var at: usize = (rnd() as usize) % alphabet.n
            while at < alphabet.n && (rt.ld8(alphabet.p as u64, at) & 192 as u8) == 128 as u8 {
                at++
            }
            if at >= alphabet.n {
                at = 0
            }
            var l: usize = 1
            let c0: u8 = rt.ld8(alphabet.p as u64, at)
            if c0 >= 240 as u8 { l = 4 } else if c0 >= 224 as u8 { l = 3 } else if c0 >= 192 as u8 { l = 2 }
            rt.buf_push_bytes(&buf, alphabet.p as u64 + at as u64, l)
            q++
        }
        var lang: u32 = 0
        while lang < highlight.HL_COUNT {
            done = done + 1
            if !tiles(&h, lang, rt.buf_ptr(&buf), rt.buf_len(&buf)) {
                bad = bad + 1
                tile_fail = tile_fail + 1
            }
            lang = lang + 1
        }
        rt.buf_free(&buf)
        round = round + 1
    }

    // linear time: 16 KiB of Firn-like text
    var big: rt.Buf = rt.buf_new()
    let unit: str = "fn add(a: i32, b: i32) -> i32 { return a + b } // comment \"str\"\n"
    while rt.buf_len(&big) < 16384 {
        rt.buf_push_bytes(&big, unit.p as u64, unit.n)
    }
    let t0: u64 = time.monotonic_ns()
    done = done + 1
    if !tiles(&h, highlight.HL_FIRN, rt.buf_ptr(&big), rt.buf_len(&big)) {
        bad = bad + 1
    }
    let ms: u64 = (time.monotonic_ns() - t0) / 1000000
    // generous: the build levels differ by 20x; the point is "not quadratic"
    if ms > 60000 {
        bad = bad + 1
        io.fmt_print_line(f"FAIL 16 KiB took {ms} ms")
    }
    rt.buf_free(&big)
    highlight.hl_free(&h)
    if bad > 0 {
        io.fmt_print_line(f"FAIL {bad} of {done}")
        return 1
    }
    io.fmt_print_line(f"highlight: ok ({done} checks)")
    return 0
}
