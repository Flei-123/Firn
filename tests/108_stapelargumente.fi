// expect_exit: 45
// Mehr als sechs Parameter: die weiteren liegen auf dem Stapel (abi.rs).
// Ersetzt tests/neg/too_many_params.fi aus Runde 1: dieser Negativtest pruefte
// die Grenze von 6 Parametern, die diese Runde aufhebt (SPEC §14.1 Punkt 9
// gestrichen). Die Zusicherung wird hier positiv geprueft, nicht abgeschwaecht.
fn neun(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32, g: i32, h: i32, i: i32) -> i32 {
    return a + b + c + d + e + f + g + h + i
}

fn zehn_u8(a: u8, b: u8, c: u8, d: u8, e: u8, f: u8, g: u8, h: u8) -> u8 {
    return a + b + c + d + e + f + g + h
}

fn main() -> i32 {
    let s: i32 = neun(1, 2, 3, 4, 5, 6, 7, 8, 9)
    let t: u8 = zehn_u8(1, 1, 1, 1, 1, 1, 1, 1)
    if t != 8 as u8 { return 1 }
    return s
}
