// expect_out: ok
// RUNDE TEMPO 11 -- Schleifenrotation.
//
// `compiler/src/regalloc.rs` schreibt am Ende eines Blocks, der mit `jmp`
// zu einem Schleifenkopf springt, statt des Sprungs den Kopf-Vergleich
// selbst hin (`cmp; jl body` statt `jmp head`). Der Kopf darf dabei bis zu
// drei schlichte Rechnungen vor dem Vergleich haben.
//
// Geprueft werden die Formen, bei denen das schiefgehen koennte:
//
//   * eine Schleife, die NULL Mal laeuft (der Kopf entscheidet beim
//     Eintritt, die Kopie im Rueckweg darf das nicht aendern),
//   * MEHRERE Rueckwege (`continue`) -- jeder bekommt seine eigene Kopie,
//   * ein Kopf mit einer Rechnung vor dem Vergleich (`i + 4 <= n`),
//   * VERSCHACHTELTE Schleifen, deren innerer Ausgang in den aeusseren
//     Rueckweg fuehrt,
//   * ein Vergleich auf Gleitzahlen und einer ohne Vorzeichen.
//
// Die Grenzen kommen aus `start`, damit nichts vorausgerechnet wird.
import std.io

fn check(got: i64, want: i64, what: str) -> bool {
    if got != want {
        io.print("FEHLER ")
        io.print(what)
        io.new_line()
        return false
    }
    return true
}

fn summe(n: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < n {
        s = s + i
        i = i + 1
    }
    return s
}

// Nur jede dritte Zahl zaehlt; `continue` ist ein zweiter Rueckweg.
fn mit_continue(n: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < n {
        i = i + 1
        if i % 3 != 0 {
            continue
        }
        s = s + i
    }
    return s
}

// Der Kopf rechnet vor dem Vergleich: `i + 4 <= n`.
fn vierer(n: i64) -> i64 {
    var z: i64 = 0
    var i: i64 = 0
    while i + 4 <= n {
        z = z + 1
        i = i + 4
    }
    return z * 1000 + i
}

fn verschachtelt(n: i64) -> i64 {
    var s: i64 = 0
    var a: i64 = 0
    while a < n {
        var b: i64 = 0
        while b < a {
            s = s + b
            b = b + 1
        }
        a = a + 1
    }
    return s
}

fn gleitzahl(grenze: f32) -> i64 {
    var x: f32 = 0.0
    var k: i64 = 0
    while x < grenze {
        x = x + 0.5
        k = k + 1
    }
    return k
}

fn ohne_vorzeichen(n: u64) -> i64 {
    var k: i64 = 0
    var u: u64 = n
    while u > 0 {
        u = u >> 1
        k = k + 1
    }
    return k
}

fn main(start: u64) -> i32 {
    var ok: bool = true
    var n: i64 = 100
    var null: i64 = 0
    if start == 7777777 {
        n = 1
        null = 5
    }
    ok = check(summe(n), 4950, "summe 100") && ok
    ok = check(summe(null), 0, "summe 0 (null Durchlaeufe)") && ok
    ok = check(summe(null - 3), 0, "summe negativ") && ok
    ok = check(mit_continue(n), 1683, "continue") && ok
    ok = check(vierer(n + 3), 25100, "kopf mit rechnung") && ok
    ok = check(vierer(null + 3), 0, "kopf mit rechnung, null Durchlaeufe") && ok
    ok = check(verschachtelt(n / 10), 120, "verschachtelt") && ok
    ok = check(gleitzahl(n as f32), 200, "gleitzahl") && ok
    ok = check(ohne_vorzeichen(n as u64 * 1000), 17, "ohne vorzeichen") && ok
    if ok {
        io.print_line("ok")
        return 0
    }
    return 1
}
