// expect_exit: 101
// wasm_skip: a null dereference is harmless in the wasm linear memory (exit 0)
// only_target: x86_64
// N1 closed: a write through a null raw pointer, also at a small offset, ends with exit code 101.
fn main() -> i32 {
    let p: *mut i64 = 0 as *mut i64
    *(p + 3) = 5
    return 0
}
