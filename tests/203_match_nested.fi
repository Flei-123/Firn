// expect_exit: 42
// Verschachtelte Muster (eine Ebene) und Literale als Untermuster.
enum Innen { Klein(i32), Gross(i32) }
enum Aussen { Leer, Eins(Innen), Zwei(i32, Innen) }

fn main() -> i32 {
    var r: i32 = 0
    let a = Aussen::Eins(Innen::Klein(3 as i32))
    let b = Aussen::Zwei(10 as i32, Innen::Gross(9 as i32))
    match a {
        Aussen::Eins(Innen::Klein(x)) => { r = r + x }
        Aussen::Eins(Innen::Gross(x)) => { r = r + 100 as i32 }
        _ => { r = r + 200 as i32 }
    }
    match b {
        Aussen::Zwei(10, Innen::Gross(y)) => { r = r + y * 4 as i32 }
        Aussen::Zwei(x, _) => { r = r + 300 as i32 }
        _ => { r = r + 400 as i32 }
    }
    match b {
        Aussen::Zwei(11, _) => { r = r + 500 as i32 }
        Aussen::Zwei(_, Innen::Klein(_)) => { r = r + 600 as i32 }
        _ => { r = r + 3 as i32 }
    }
    return r
}
