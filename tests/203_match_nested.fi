// expect_exit: 42
// Nested patterns (one level) and literals as subpatterns.
enum Inner { Small(i32), Big(i32) }
enum Outer { Empty, One(Inner), Two(i32, Inner) }

fn main() -> i32 {
    var r: i32 = 0
    let a = Outer::One(Inner::Small(3 as i32))
    let b = Outer::Two(10 as i32, Inner::Big(9 as i32))
    match a {
        Outer::One(Inner::Small(x)) => { r = r + x }
        Outer::One(Inner::Big(x)) => { r = r + 100 as i32 }
        _ => { r = r + 200 as i32 }
    }
    match b {
        Outer::Two(10, Inner::Big(y)) => { r = r + y * 4 as i32 }
        Outer::Two(x, _) => { r = r + 300 as i32 }
        _ => { r = r + 400 as i32 }
    }
    match b {
        Outer::Two(11, _) => { r = r + 500 as i32 }
        Outer::Two(_, Inner::Small(_)) => { r = r + 600 as i32 }
        _ => { r = r + 3 as i32 }
    }
    return r
}
