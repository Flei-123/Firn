// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import std.rt
import mdns.mdns_wire
import mdns.mdns_cache
import mdns.mdns_browse
import mdns.mdns_resp

fn check(fp: *mut i32, ok: bool) {
    if !ok {
        *fp = *fp + 1
    }
}

fn main(start: u64) -> i32 {
    var fails: i32 = 0
    var r: mdns_resp.Reg = mdns_resp.reg_new()
    let l: str = "My Printer"
    let t: str = "_ipp._tcp.local"
    let h: str = "printer.local"
    var txt: rt.Buf = rt.buf_new()
    let k: str = "rp"
    let v: str = "ipp/print"
    check(&fails, mdns_wire.txt_push_pair(&txt, k.p as u64, k.n, v.p as u64, v.n, true))
    let i: usize = mdns_resp.reg_add(&r, l.p as u64, l.n, t.p as u64, t.n, h.p as u64, h.n, 631 as u32,
        txt.ptr, txt.len, 3232235777 as u32, true)
    check(&fails, i == 0)
    var c: mdns_cache.Cache = mdns_cache.cache_new(16)
    var pk: mdns_wire.Pk = mdns_wire.pk_new(0 as u32, mdns_resp.RESP_FLAGS)
    mdns_resp.resp_announce(&r, i, &pk, false)
    check(&fails, mdns_browse.browse_ingest(&c, mdns_wire.pk_ptr(&pk), mdns_wire.pk_len(&pk), 1000 as u64) == 5 as u32)
    var tw: [u8; 256] = [0; 256]
    let tl: usize = mdns_wire.wname_from_text(t.p as u64, t.n, (&tw[0]) as u64, 256)
    let p: usize = mdns_cache.cache_find(&c, (&tw[0]) as u64, tl, mdns_wire.T_PTR, 0, 2000 as u64)
    check(&fails, p != mdns_cache.NONE)
    var f: mdns_browse.Found = mdns_browse.found_new()
    let got: u32 = mdns_browse.browse_resolve(&c, mdns_cache.cache_data(&c, p), mdns_cache.cache_dlen(&c, p), 2000 as u64, &f)
    check(&fails, got == 7 as u32)
    check(&fails, f.port == 631 as u32 && f.a4 == 3232235777 as u32 && f.tlen == txt.len)
    mdns_wire.pk_free(&pk)

    var q: mdns_wire.Pk = mdns_wire.pk_new(0 as u32, 0 as u32)
    mdns_browse.browse_query(&q, (&tw[0]) as u64, tl, mdns_wire.T_PTR, false, &c, 3000 as u64)
    mdns_wire.pk_finish(&q)
    var a: mdns_wire.Pk = mdns_wire.pk_new(0 as u32, mdns_resp.RESP_FLAGS)
    check(&fails, mdns_resp.resp_answer(&r, mdns_wire.pk_ptr(&q), mdns_wire.pk_len(&q), 5353 as u32, 5353 as u32, &a) == mdns_resp.MODE_NONE)
    mdns_wire.pk_free(&a)
    mdns_wire.pk_free(&q)

    var q2: mdns_wire.Pk = mdns_wire.pk_new(0 as u32, 0 as u32)
    mdns_wire.pk_q(&q2, (&tw[0]) as u64, tl, mdns_wire.T_PTR, false)
    mdns_wire.pk_finish(&q2)
    var a2: mdns_wire.Pk = mdns_wire.pk_new(0 as u32, mdns_resp.RESP_FLAGS)
    check(&fails, mdns_resp.resp_answer(&r, mdns_wire.pk_ptr(&q2), mdns_wire.pk_len(&q2), 5353 as u32, 5353 as u32, &a2) == mdns_resp.MODE_MULTICAST)
    check(&fails, a2.an == 1 as u32 && a2.ar == 3 as u32)
    var a3: mdns_wire.Pk = mdns_wire.pk_new(0 as u32, mdns_resp.RESP_FLAGS)
    check(&fails, mdns_resp.resp_answer(&r, mdns_wire.pk_ptr(&q2), mdns_wire.pk_len(&q2), 40000 as u32, 5353 as u32, &a3) == mdns_resp.MODE_UNICAST)
    mdns_wire.pk_free(&a3)
    mdns_wire.pk_free(&a2)
    mdns_wire.pk_free(&q2)

    var bye: mdns_wire.Pk = mdns_wire.pk_new(0 as u32, mdns_resp.RESP_FLAGS)
    mdns_resp.resp_announce(&r, i, &bye, true)
    mdns_browse.browse_ingest(&c, mdns_wire.pk_ptr(&bye), mdns_wire.pk_len(&bye), 4000 as u64)
    check(&fails, mdns_cache.cache_find(&c, (&tw[0]) as u64, tl, mdns_wire.T_PTR, 0, 5500 as u64) == mdns_cache.NONE)
    mdns_wire.pk_free(&bye)

    var e: [u8; 256] = [0; 256]
    let et: str = "a\\.b.c."
    let en: usize = mdns_wire.wname_from_text(et.p as u64, et.n, (&e[0]) as u64, 256)
    check(&fails, en == 7 && mdns_wire.wname_label_len((&e[0]) as u64) == 3)
    check(&fails, mdns_wire.wname_from_text(et.p as u64, 0, (&e[0]) as u64, 256) == 1)
    mdns_cache.cache_free(&c)
    return fails
}
