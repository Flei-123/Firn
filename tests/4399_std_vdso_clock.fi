// expect_exit: 42
// std.vdso: the clock read without a system call gives the same answers as
// the real system call 228 -- both clocks, the error for a bad clock, and a
// monotonic clock that never steps back. (Whether the vDSO is used at all
// depends on the machine; the answers must not.)
import std.time
import std.vdso

fn raw(clock: i64) -> i64 {
    var ts: [i64; 2] = [0; 2]
    let r: i64 = syscall(228, clock, (&ts[0]) as i64, 0, 0, 0, 0)
    if r != 0 { return 0 - 1 }
    return ts[0] * 1000000000 + ts[1]
}

fn fast(clock: i64) -> i64 {
    var ts: [i64; 2] = [0; 2]
    let r: i64 = vdso.clock_gettime(clock, (&ts[0]) as u64)
    if r != 0 { return 0 - 1 }
    return ts[0] * 1000000000 + ts[1]
}

fn main() -> i32 {
    // monotonic: the vDSO read lies between two system call reads
    let a: i64 = raw(1)
    let b: i64 = fast(1)
    let c: i64 = raw(1)
    if a <= 0 || b < a || b > c { return 1 as i32 }
    // realtime: within a second of each other, and after 2020
    let r0: i64 = raw(0)
    let r1: i64 = fast(0)
    if r0 < 1577836800000000000 { return 2 as i32 }
    if r1 < r0 || r1 - r0 > 1000000000 { return 3 as i32 }
    // a clock that does not exist: both say -EINVAL (22)
    var ts: [i64; 2] = [0; 2]
    let e1: i64 = syscall(228, 9999, (&ts[0]) as i64, 0, 0, 0, 0)
    let e2: i64 = vdso.clock_gettime(9999, (&ts[0]) as u64)
    if e1 >= 0 || e2 >= 0 { return 4 as i32 }
    // the std.time clocks never step back
    var last: u64 = time.monotonic_ns()
    var i: i32 = 0
    while i < 100000 {
        let t: u64 = time.monotonic_ns()
        if t < last { return 5 as i32 }
        last = t
        i = i + 1
    }
    let u0: i64 = time.now_unix_ns()
    let u1: i64 = time.now_unix_ms()
    if u1 < u0 / 1000000 - 1 || u1 > u0 / 1000000 + 1000 { return 6 as i32 }
    // sleeping is still measured
    let s0: u64 = time.monotonic_ns()
    time.sleep_ms(20)
    if time.monotonic_ns() - s0 < 20000000 { return 7 as i32 }
    return 42 as i32
}
