// expect_exit: 0
import std.rt
import std.time
import media.clock

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main(start: u64) -> i32 {
    var c: clock.Clock = clock.clock_new(48000 as u32)
    check(clock.clock_samples(&c) == 0 as u64, 1)
    clock.clock_advance(&c, 48000 as u64)
    check(clock.clock_samples(&c) == 48000 as u64, 2)
    check(clock.clock_millis(&c) == 1000 as u64, 3)
    clock.clock_set_latency(&c, 4800 as u64)
    check(clock.clock_samples(&c) == 43200 as u64, 4)
    check(clock.clock_seconds(&c) > 0.89 && clock.clock_seconds(&c) < 0.91, 5)
    clock.clock_reset(&c, 96000 as u64)
    check(clock.clock_samples(&c) == 96000 as u64, 6)
    clock.clock_advance(&c, 4800 as u64)
    check(clock.clock_samples(&c) == 96000 as u64, 7)
    clock.clock_advance(&c, 480 as u64)
    check(clock.clock_samples(&c) == 96480 as u64, 8)
    var w: clock.Clock = clock.clock_new(1000 as u32)
    clock.clock_use_wall(&w, true)
    time.sleep_ms(60 as u64)
    let a: u64 = clock.clock_samples(&w)
    check(a >= 55 as u64 && a < 400 as u64, 9)
    clock.clock_pause(&w)
    let b: u64 = clock.clock_samples(&w)
    time.sleep_ms(40 as u64)
    check(clock.clock_samples(&w) == b, 10)
    clock.clock_resume(&w)
    time.sleep_ms(20 as u64)
    check(clock.clock_samples(&w) >= b + 15 as u64, 11)
    return 0
}
