// expect_exit: 7
// A checked operation that feeds an asm or an MMIO operand must survive cse.
// Both operand kinds are untouchable (SPEC 9.2): `replace_uses` keeps their
// operands as they are, so deleting the second `base + 4096` as a duplicate
// of the first one left the instruction reading a value nobody defined.
#[arch(x86_64)]
fn asm_operand(base: u64) -> u64 {
    let held: u64 = base + 4096
    let seen: u64 = asm("mov rax, rcx", out("rax"), in("rcx") base + 4096)
    return seen - held
}

#[arch(aarch64)]
fn asm_operand(base: u64) -> u64 {
    let held: u64 = base + 4096
    let seen: u64 = asm("mov x9, x10", out("x9"), in("x10") base + 4096)
    return seen - held
}

fn mmio_operand(base: u64) -> u64 {
    var cell: u64 = 0
    let slot: *mut u64 = (&cell) as *mut u64
    let held: u64 = base + 4096
    __mmio_write64(slot, base + 4096)
    return __mmio_read64(slot) - held
}

fn main() -> i32 {
    var anchor: u64 = 5
    let base: u64 = (&anchor) as u64
    return (asm_operand(base) + mmio_operand(base) + 7) as i32
}
