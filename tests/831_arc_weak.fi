// expect_exit: 0
// ERZEUGT von lib/rc/gen_tests.sh: Zeile 1 und der Rumpf aus
// lib/rc/parts/831_arc_weak.fi, dazwischen tests/modules/rc.fi WOERTLICH.
// Modul 'arc' — `Arc[T]` aus SPEC §3.4: geteilter Besitz mit ATOMAREM
// Zaehler. Runde 47.
//
// `Rc[T]` (lib/rc/rc.fi) und `Arc[T]` sind absichtlich GETRENNTE Typen:
// einfaediger Code soll den atomaren Zaehler nicht bezahlen (SPEC §3.4).
// Der Unterschied steckt an genau vier Stellen — Erhoehen und Erniedrigen
// des starken und des schwachen Zaehlers — und er ist echt: dort steht
// `__atomar_addieren`, und das ist im Assembler ein `lock xadd`
// (compiler/src/atomic.rs, Nachweis tools/atomic/run.sh).
//
// Benutzung aus tests/:   die Datei wird WOERTLICH eingesetzt
//                         (lib/rc/gen_tests.sh, wie bei rc.fi)
//
// ------------------------------------------------------------------ EHRLICH
//
// E1  DER ZAEHLER IST FADENSICHER — SEIT RUNDE 49 AUCH DIE AUFWERTUNG.
//     `arc_klonen` und `arc_freigeben` sind mit `lock xadd` korrekt, auch
//     wenn mehrere Faeden gleichzeitig zugreifen: nur der Faden, der beim
//     Erniedrigen die 1 sieht, gibt frei — deshalb kann NIEMALS doppelt
//     freigegeben werden. `aufwerten_atomar` (schwach -> stark) brauchte
//     einen Vergleichs-Tausch; Runde 47 hatte den nicht und hat die Luecke
//     benannt (docs/RUNDE47.md §3.2). Seit Runde 49 gibt es
//     `__atomar_tauschen` (lock cmpxchg), und die Aufwertung erhoeht nur
//     noch, solange der Zaehler nicht 0 ist. Nachweis mit vielen Faeden auf
//     DERSELBEN Struktur: tests/843_arc_faden.fi.
//
//     WAS WEITER NICHT ZUGESAGT IST: der WERT hinter dem Verweis ist
//     unveraenderlich (E4), aber `Arc[T]` macht ihn nicht fadensicher
//     lesbar, wenn er selbst Zeiger auf veraenderlichen Speicher enthaelt.
//     Und die Arc-Halde (`arc_neu`/`arc_freigeben` als Speicherverwaltung)
//     hat KEINE eigene Sperre: wer aus mehreren Faeden alloziert, sperrt
//     selbst (faden_sperren).
//
// E2  ZYKLEN LECKEN, genau wie bei `Rc`. Zwei `Arc`, die sich gegenseitig
//     halten, werden nie frei — sichtbar gemacht in tests/833. Wer Zyklen
//     hat, nimmt `AtomSchwachverweis` (bricht ihn von Hand) oder `Gc[T]`
//     (loest ihn auf, SPEC §3.5).
//
// E3  ZUSAMMENSPIEL MIT DEM TRACING-GC (der Punkt dieser Runde):
//       * Die Arc-Halde ist ein eigenes mmap-Gebiet. Der Sammler kennt sie
//         NICHT — er findet Bloecke nur in seinen eigenen Chunks.
//       * Daraus folgt: ein `Gc[T]` im WERT eines `Arc` ist fuer den Sammler
//         unsichtbar und sein Ziel wird eingesammelt, obwohl es noch benutzt
//         wird. Das ist kein Sonderfall, das ist die Regel fuer JEDEN
//         Speicher ausserhalb des GC-Heaps.
//       * Deshalb gibt es seit Runde 47 `gc_wurzel_anmelden(p, bytes)`:
//         wer `Gc[T]` in einen `Arc` legt, meldet dessen Wertbereich als
//         externe Wurzel an (`arc_wert_adresse` + `arc_groesse_von`) und
//         beim Freigeben wieder ab. Nachweis in tests/834 — MIT und OHNE.
//       * KEIN DOPPELTES FREIGEBEN, und zwar aus einem strukturellen Grund:
//         der Zaehler entscheidet ausschliesslich ueber den ARC-BLOCK (er
//         geht in die Freiliste der Arc-Halde), der Sammler ausschliesslich
//         ueber GC-OBJEKTE (er kennt nur seine Chunks). Die beiden
//         Speicherbereiche ueberschneiden sich nicht, also kann keiner
//         freigeben, was dem anderen gehoert.
//
// E4  `Arc` ist wie `Rc` IMMER UNVERAENDERLICH (SPEC §3.4). `arc_lesen`
//     liefert eine Kopie; es gibt in diesem Modul keine schreibende Funktion.
//
// E5  Wie bei rc.fi: Stufe 0 hat keine Methoden (`Arc[T].neu` ist
//     `arc_neu`), kein `inout` (die Halde ist ein `*mut ArcHeap`), und der
//     Erfolgswert kommt ueber einen Ausgabezeiger, weil die
//     Monomorphisierung Typargumente in der Nutzlast einer Fehlerunion
//     nicht einsetzt. Die Allokation bleibt fehlbar (DESIGN_GOALS §2) und
//     das Ergebnis ist `#[must_consume]`.

export {
    AllocError, ArcHeap, AtomicRef, AtomWeakRef,
    arc_heap_init, arc_heap_free, arc_heap_capacity, arc_heap_live,
    arc_heap_used_bytes, arc_heap_allocations, arc_heap_releases,
    arc_size_of, arc_ld64, arc_st64,
    arc_new, arc_empty, arc_is_empty, arc_read, arc_clone, arc_free,
    arc_strong_number, arc_weak_number, arc_equal,
    arc_raw_address, arc_value_address, arc_raw_ref,
    aweak_of, aweak_empty, aweak_is_empty, promote_atomic, aweak_free,
    aweak_strong_number, aweak_raw_address
}

error AllocError { OutOfMemory }

const ARC_SYS_MMAP: i64 = 9
const ARC_SYS_MUNMAP: i64 = 11
const ARC_PROT_READ_WRITE: i64 = 3
const ARC_MAP_PRIVATE_ANON: i64 = 34

// Zweierkomplement von 1: Erniedrigen ist die Addition davon. Ein eigenes
// Primitiv fuer die Subtraktion waere Ballast (compiler/src/atomic.rs).
const ARC_MINUS1: u64 = 18446744073709551615

// Blockkopf: 32 Byte, danach der Wert.
//   +0   stark      u64   starke Verweise      (ATOMAR)
//   +8   schwach    u64   schwache Verweise    (ATOMAR)
//   +16  klasse     u64   Groessenklasse
//   +24  naechster  u64   Freilisten-Verkettung (nur wenn frei)
//   +32  wert       T
const ARC_HEADER: usize = 32
const ARC_CLASSES: usize = 8
const ARC_CLASS0: usize = 64

// `Arc[T]` aus SPEC §3.4. 'block' ist 0, wenn der Verweis leer ist.
struct AtomicRef[T] { block: usize }

// `Weak[T]` zu einem `Arc[T]` — haelt den Wert NICHT am Leben.
struct AtomWeakRef[T] { block: usize }

struct ArcHeap {
    base: usize,
    capacity: usize,
    next: usize,
    free: [usize; 8],
    live: usize,
    used: usize,
    allocations: usize,
    releases: usize,
}

struct ArcPair[T] { a: T, b: T }

fn arc_pages(n: usize) -> usize {
    return (n + 4095 as usize) / 4096 as usize * 4096 as usize
}

fn arc_ld64(addr: usize) -> u64 {
    return *(addr as *mut u64)
}

fn arc_st64(addr: usize, v: u64) {
    *(addr as *mut u64) = v
}

// Schrittweite (Groesse einschliesslich Ausrichtung) des Typs T.
fn arc_size_of[T: Any](pattern: T) -> usize {
    var p: ArcPair[T] = ArcPair[T]{ a: pattern, b: pattern }
    return (&p.b) as usize - (&p.a) as usize
}

fn arc_class_bytes(k: usize) -> usize {
    var b: usize = ARC_CLASS0
    var i: usize = 0 as usize
    while i < k {
        b = b * 2 as usize
        i = i + 1 as usize
    }
    return b
}

fn arc_class_for(total: usize) -> usize {
    var k: usize = 0 as usize
    while k < ARC_CLASSES {
        if total <= arc_class_bytes(k) {
            return k
        }
        k = k + 1 as usize
    }
    return ARC_CLASSES
}

fn arc_heap_init(h: *mut ArcHeap, bytes: usize) -> bool {
    (*h).base = 0 as usize
    (*h).capacity = 0 as usize
    (*h).next = 0 as usize
    (*h).live = 0 as usize
    (*h).used = 0 as usize
    (*h).allocations = 0 as usize
    (*h).releases = 0 as usize
    var i: usize = 0 as usize
    while i < ARC_CLASSES {
        (*h).free[i] = 0 as usize
        i = i + 1 as usize
    }
    if bytes == 0 as usize {
        return false
    }
    let len: usize = arc_pages(bytes)
    let r: i64 = syscall(ARC_SYS_MMAP, 0, len as i64, ARC_PROT_READ_WRITE,
                         ARC_MAP_PRIVATE_ANON, 0 - 1, 0)
    if r < 0 && r > 0 - 4096 {
        return false
    }
    if r == 0 {
        return false
    }
    (*h).base = r as usize
    (*h).capacity = len
    return true
}

fn arc_heap_free(h: *mut ArcHeap) {
    if (*h).base != 0 as usize {
        syscall(ARC_SYS_MUNMAP, (*h).base as i64, (*h).capacity as i64)
    }
    (*h).base = 0 as usize
    (*h).capacity = 0 as usize
    (*h).next = 0 as usize
}

fn arc_heap_capacity(h: *mut ArcHeap) -> usize { return (*h).capacity }
fn arc_heap_live(h: *mut ArcHeap) -> usize { return (*h).live }
fn arc_heap_used_bytes(h: *mut ArcHeap) -> usize { return (*h).used }
fn arc_heap_allocations(h: *mut ArcHeap) -> usize { return (*h).allocations }
fn arc_heap_releases(h: *mut ArcHeap) -> usize { return (*h).releases }

fn arc_block_get(h: *mut ArcHeap, payload: usize) -> usize {
    let k: usize = arc_class_for(ARC_HEADER + payload)
    if k >= ARC_CLASSES {
        return 0 as usize
    }
    let gr: usize = arc_class_bytes(k)
    var addr: usize = (*h).free[k]
    if addr != 0 as usize {
        (*h).free[k] = arc_ld64(addr + 24 as usize) as usize
    } else {
        if (*h).base == 0 as usize {
            return 0 as usize
        }
        if (*h).next + gr > (*h).capacity {
            return 0 as usize
        }
        addr = (*h).base + (*h).next
        (*h).next = (*h).next + gr
    }
    arc_st64(addr + 0 as usize, 0 as u64)
    arc_st64(addr + 8 as usize, 0 as u64)
    arc_st64(addr + 16 as usize, k as u64)
    arc_st64(addr + 24 as usize, 0 as u64)
    (*h).live = (*h).live + 1 as usize
    (*h).used = (*h).used + gr
    (*h).allocations = (*h).allocations + 1 as usize
    return addr
}

fn arc_block_back(h: *mut ArcHeap, addr: usize) {
    let k: usize = arc_ld64(addr + 16 as usize) as usize
    if k >= ARC_CLASSES {
        return
    }
    arc_st64(addr + 24 as usize, (*h).free[k] as u64)
    (*h).free[k] = addr
    (*h).live = (*h).live - 1 as usize
    (*h).used = (*h).used - arc_class_bytes(k)
    (*h).releases = (*h).releases + 1 as usize
}

// Legt 'wert' auf der Halde ab und liefert einen starken Verweis in '*aus'.
// FEHLBAR (DESIGN_GOALS §2); das Ergebnis ist '#[must_consume]'.
fn arc_new[T: Any](h: *mut ArcHeap, value: T, out: *mut AtomicRef[T]) -> AllocError!bool {
    (*out).block = 0 as usize
    let gr: usize = arc_size_of[T](value)
    let addr: usize = arc_block_get(h, gr)
    if addr == 0 as usize {
        return AllocError::OutOfMemory
    }
    arc_st64(addr + 0 as usize, 1 as u64)
    arc_st64(addr + 8 as usize, 0 as u64)
    *((addr + ARC_HEADER) as *mut T) = value
    (*out).block = addr
    return true
}

fn arc_empty[T: Any]() -> AtomicRef[T] {
    return AtomicRef[T]{ block: 0 as usize }
}

fn arc_is_empty[T: Any](r: AtomicRef[T]) -> bool {
    return r.block == 0 as usize
}

// NUR LESEN (SPEC §3.4): geliefert wird eine Kopie.
fn arc_read[T: Any](r: AtomicRef[T]) -> T {
    return *((r.block + ARC_HEADER) as *mut T)
}

// ATOMAR: `lock xadd`. Zwei Faeden, die gleichzeitig klonen, koennen keine
// Erhoehung verlieren.
fn arc_clone[T: Any](r: AtomicRef[T]) -> AtomicRef[T] {
    if r.block == 0 as usize {
        return AtomicRef[T]{ block: 0 as usize }
    }
    __atomic_add(r.block as *mut u64, 1)
    return AtomicRef[T]{ block: r.block }
}

// ATOMAR erniedrigen. KEIN DOPPELTES FREIGEBEN: freigegeben wird nur von dem
// Aufruf, der beim Erniedrigen den alten Wert 1 SIEHT — und den sieht genau
// einer, weil `lock xadd` den alten Wert unteilbar zurueckliefert.
fn arc_free[T: Any](h: *mut ArcHeap, r: *mut AtomicRef[T]) {
    let addr: usize = (*r).block
    if addr == 0 as usize {
        return
    }
    (*r).block = 0 as usize
    let old: u64 = __atomic_add(addr as *mut u64, ARC_MINUS1)
    if old == 0 as u64 {
        // War schon 0 — die Erniedrigung war ein Fehler des Aufrufers.
        // Wieder geradebiegen statt still unterlaufen zu lassen.
        __atomic_add(addr as *mut u64, 1)
        return
    }
    if old != 1 as u64 {
        return
    }
    if arc_ld64(addr + 8 as usize) == 0 as u64 {
        arc_block_back(h, addr)
    }
}

fn arc_strong_number[T: Any](r: AtomicRef[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return arc_ld64(r.block + 0 as usize)
}

fn arc_weak_number[T: Any](r: AtomicRef[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return arc_ld64(r.block + 8 as usize)
}

fn arc_equal[T: Any](a: AtomicRef[T], b: AtomicRef[T]) -> bool {
    return a.block == b.block
}

// Rohzugriff (SPEC §3.6). `arc_wert_adresse` ist zugleich die Adresse, die
// man dem Sammler als externe Wurzel meldet, wenn im Wert ein `Gc[T]` steckt
// (siehe E3 oben und tests/834).
fn arc_raw_address[T: Any](r: AtomicRef[T]) -> usize { return r.block }

fn arc_raw_ref[T: Any](addr: usize) -> AtomicRef[T] {
    return AtomicRef[T]{ block: addr }
}

fn arc_value_address[T: Any](r: AtomicRef[T]) -> usize {
    if r.block == 0 as usize {
        return 0 as usize
    }
    return r.block + ARC_HEADER
}

fn aweak_of[T: Any](r: AtomicRef[T]) -> AtomWeakRef[T] {
    if r.block == 0 as usize {
        return AtomWeakRef[T]{ block: 0 as usize }
    }
    __atomic_add((r.block + 8 as usize) as *mut u64, 1)
    return AtomWeakRef[T]{ block: r.block }
}

fn aweak_empty[T: Any]() -> AtomWeakRef[T] {
    return AtomWeakRef[T]{ block: 0 as usize }
}

fn aweak_is_empty[T: Any](w: AtomWeakRef[T]) -> bool {
    return w.block == 0 as usize
}

fn aweak_raw_address[T: Any](w: AtomWeakRef[T]) -> usize { return w.block }

fn aweak_strong_number[T: Any](w: AtomWeakRef[T]) -> u64 {
    if w.block == 0 as usize {
        return 0 as u64
    }
    return arc_ld64(w.block + 0 as usize)
}

// Aufwertung: leerer Verweis, wenn der starke Zaehler schon 0 ist.
//
// RUNDE 49 — JETZT MIT VERGLEICHS-TAUSCH, UND DAMIT WIRKLICH FADENSICHER.
//
// Runde 47 hat hier erhoeht und die Erhoehung zurueckgenommen, falls der alte
// Wert 0 war. Das schliesst das Wettrennen NICHT: zwischen dem Erhoehen und
// dem Zuruecknehmen kann ein anderer Faden den Zaehler sehen, ihn fuer
// lebendig halten und den Block benutzen, der gerade freigegeben wird. Genau
// diese Luecke steht als offener Punkt in docs/RUNDE47.md §3.2.
//
// Der klassische Schluss (Rusts `Weak::upgrade`) braucht einen Vergleichs-
// Tausch, und den gibt es seit dieser Runde (`__atomar_tauschen`,
// compiler/src/thread.rs). Die Schleife erhoeht NUR, solange der Zaehler nicht
// 0 ist — und wenn er 0 ist, war der letzte starke Verweis weg und bleibt weg.
// Der Zaehler geht nie von 0 zurueck auf 1: `arc_freigeben` gibt den Block
// frei, sobald es die 1 SIEHT, und das sieht genau einer.
fn promote_atomic[T: Any](w: AtomWeakRef[T]) -> AtomicRef[T] {
    if w.block == 0 as usize {
        return AtomicRef[T]{ block: 0 as usize }
    }
    let p: *mut u64 = w.block as *mut u64
    var n: u64 = arc_ld64(w.block + 0 as usize)
    var done: bool = false
    while !done {
        if n == 0 as u64 {
            return AtomicRef[T]{ block: 0 as usize }
        }
        let g: u64 = __atomic_swap(p, n, n + 1 as u64)
        if g == n {
            done = true
        } else {
            n = g
        }
    }
    return AtomicRef[T]{ block: w.block }
}

fn aweak_free[T: Any](h: *mut ArcHeap, w: *mut AtomWeakRef[T]) {
    let addr: usize = (*w).block
    if addr == 0 as usize {
        return
    }
    (*w).block = 0 as usize
    let old: u64 = __atomic_add((addr + 8 as usize) as *mut u64, ARC_MINUS1)
    if old == 0 as u64 {
        __atomic_add((addr + 8 as usize) as *mut u64, 1)
        return
    }
    if old != 1 as u64 {
        return
    }
    if arc_ld64(addr + 0 as usize) == 0 as u64 {
        arc_block_back(h, addr)
    }
}

// RUNDE 47 — schwache Verweise auf ein `Arc[T]` (SPEC 3.4 `Weak[T]`).
//
// Geprueft wird:
//   * ein schwacher Verweis haelt den Wert NICHT am Leben
//   * `aufwerten_atomar` liefert nach dem Tod sichtbar den LEEREN Verweis
//   * der Block wird erst frei, wenn BEIDE Zaehler 0 sind — und dann genau
//     EINMAL (kein doppeltes Freigeben ueber die beiden Wege)
//   * die Reihenfolge ist egal: stark-dann-schwach und schwach-dann-stark
//     ergeben beide genau eine Freigabe
//   * ein aufgewerteter Verweis haelt den Wert wieder am Leben

struct Node {
    value: u64,
    depth: u32,
}

fn main() -> i32 {
    var h: ArcHeap = ArcHeap{
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize; 8], live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize
    }
    if !arc_heap_init(&h, 65536 as usize) {
        return 90
    }
    let rc: i32 = run(&h) catch 91
    arc_heap_free(&h)
    return rc
}

fn run(h: *mut ArcHeap) -> AllocError!i32 {
    // --- schwach haelt nicht am Leben ---------------------------------------
    var a: AtomicRef[Node] = arc_empty[Node]()
    if !(try arc_new[Node](h, Node{ value: 5 as u64, depth: 1 }, &a)) {
        return 1
    }
    var w: AtomWeakRef[Node] = aweak_of[Node](a)
    if aweak_is_empty[Node](w) {
        return 2
    }
    if arc_strong_number[Node](a) != 1 as u64 {
        return 3
    }
    if arc_weak_number[Node](a) != 1 as u64 {
        return 4
    }
    if aweak_strong_number[Node](w) != 1 as u64 {
        return 5
    }

    // Aufwerten, solange es lebt.
    var s: AtomicRef[Node] = promote_atomic[Node](w)
    if arc_is_empty[Node](s) {
        return 6
    }
    if arc_read[Node](s).value != 5 as u64 {
        return 7
    }
    if arc_strong_number[Node](a) != 2 as u64 {
        return 8
    }
    arc_free[Node](h, &s)

    // Letzter starker Verweis geht: der WERT ist tot, der BLOCK bleibt,
    // weil noch ein schwacher Verweis darauf zeigt.
    arc_free[Node](h, &a)
    if arc_heap_releases(h) != 0 as usize {
        return 9
    }
    if arc_heap_live(h) != 1 as usize {
        return 10
    }
    if aweak_strong_number[Node](w) != 0 as u64 {
        return 11
    }
    // Aufwerten liefert jetzt sichtbar LEER.
    var dead: AtomicRef[Node] = promote_atomic[Node](w)
    if !arc_is_empty[Node](dead) {
        return 12
    }
    if aweak_strong_number[Node](w) != 0 as u64 {
        return 13
    }
    // Erst jetzt wird der Block frei — genau einmal.
    aweak_free[Node](h, &w)
    if arc_heap_releases(h) != 1 as usize {
        return 14
    }
    if arc_heap_live(h) != 0 as usize {
        return 15
    }
    aweak_free[Node](h, &w)
    if arc_heap_releases(h) != 1 as usize {
        return 16
    }

    // --- andere Reihenfolge: schwach zuerst ----------------------------------
    var b: AtomicRef[Node] = arc_empty[Node]()
    if !(try arc_new[Node](h, Node{ value: 8 as u64, depth: 2 }, &b)) {
        return 17
    }
    var w2: AtomWeakRef[Node] = aweak_of[Node](b)
    var w3: AtomWeakRef[Node] = aweak_of[Node](b)
    if arc_weak_number[Node](b) != 2 as u64 {
        return 18
    }
    aweak_free[Node](h, &w2)
    aweak_free[Node](h, &w3)
    if arc_heap_releases(h) != 1 as usize {
        return 19
    }
    arc_free[Node](h, &b)
    if arc_heap_releases(h) != 2 as usize {
        return 20
    }
    if arc_heap_live(h) != 0 as usize {
        return 21
    }

    // --- Dauerlauf mit beiden Wegen ------------------------------------------
    var round: u64 = 0
    while round < 10000 as u64 {
        var x: AtomicRef[Node] = arc_empty[Node]()
        if !(try arc_new[Node](h, Node{ value: round, depth: 3 }, &x)) {
            return 22
        }
        var wx: AtomWeakRef[Node] = aweak_of[Node](x)
        var yx: AtomicRef[Node] = promote_atomic[Node](wx)
        if arc_is_empty[Node](yx) {
            return 23
        }
        arc_free[Node](h, &yx)
        arc_free[Node](h, &x)
        if !arc_is_empty[Node](promote_atomic[Node](wx)) {
            return 24
        }
        aweak_free[Node](h, &wx)
        round = round + 1 as u64
    }
    if arc_heap_live(h) != 0 as usize {
        return 25
    }
    if arc_heap_allocations(h) != arc_heap_releases(h) {
        return 26
    }
    return 0
}
