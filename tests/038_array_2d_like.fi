// expect_exit: 36
// Array of arrays
fn main() -> i32 {
    var m: [[i32; 3]; 2] = [[1, 2, 3], [4, 5, 6]]
    var s: i32 = 0
    var i: usize = 0
    while i < 2 {
        var j: usize = 0
        while j < 3 {
            s = s + m[i][j] * (i as i32 + 1)
            j = j + 1
        }
        i = i + 1
    }
    return s
}
