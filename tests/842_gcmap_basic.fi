// expect_exit: 0
// Runde 53: `GcMap[K,V]` — die Abbildung mit veraenderlicher Groesse im
// GC-Heap (SPEC §3.5.2 `attrs: GcMap[Atom, Str]`).
//
// Geprueft:
//   1. setzen / holen / hat / entfernen / groesse / leeren,
//   2. Einstreuen (Rehash) beim Wachsen — die Eintraege duerfen dabei nicht
//      verlorengehen, obwohl der ganze Puffer neu gebaut wird,
//   3. Grabsteine: eine Suche darf hinter einer Loeschung nicht abbrechen,
//   4. der Sammler verfolgt SCHLUESSEL UND WERTE,
//   5. ein geloeschter Eintrag haelt sein Objekt NICHT mehr am Leben,
//   6. ein Zyklus ueber eine GcMap wird eingesammelt.

gc class Text {
    content: u64,
}

gc class Elem {
    attrs: Gc[GcMap],
    back: Gc[Elem],
    mark: u64,
}

fn text(x: u64) -> AllocError!Gc[Text] {
    return try gc Text{ content: x }
}

fn elem(mark: u64, kz: bool, wz: bool) -> AllocError!Gc[Elem] {
    return try gc Elem{
        attrs: try gcmap_new(kz, wz),
        back: gc_null[Elem](),
        mark: mark,
    }
}

// Zyklus: Element -> GcMap -> Text ... und Element -> GcMap -> Element
// zurueck. Beides muss der Sammler aufloesen.
fn cycle(n: u64) -> AllocError!u64 {
    let e: Gc[Elem] = try elem(1, false, true)
    var i: u64 = 0
    while i < n {
        let t: Gc[Text] = try text(i + 1)
        let ok: bool = try gcmap_set_value[Text](e.attrs, i + 2, t)
        i = i + 1
    }
    // Und ein Rueckverweis auf das Element selbst, als Wert in der Abbildung.
    let ok2: bool = try gcmap_set_value[Elem](e.attrs, 9999, e)
    return gcmap_size(e.attrs)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }

    // --- 1. rohe Abbildung: Zahl -> Zahl --------------------------------
    let m: Gc[GcMap] = gcmap_new(false, false) catch gc_null[GcMap]()
    if (m as u64) == 0 {
        return 91
    }
    if gcmap_size(m) != 0 || gcmap_capacity(m) != 0 {
        return 1
    }
    // 0 und 1 sind reservierte Schluessel und muessen abgewiesen werden.
    if gcmap_set(m, 0, 5) catch true {
        return 2
    }
    if gcmap_set(m, 1, 5) catch true {
        return 3
    }
    var i: u64 = 2
    while i < 5002 {
        let ok: bool = gcmap_set(m, i, i * 7) catch false
        if !ok {
            return 4
        }
        i = i + 1
    }
    if gcmap_size(m) != 5000 {
        return 5
    }
    i = 2
    while i < 5002 {
        if gcmap_get(m, i, 0) != i * 7 {
            return 6
        }
        if !gcmap_has(m, i) {
            return 7
        }
        i = i + 1
    }
    if gcmap_get(m, 999999, 4711) != 4711 {
        return 8
    }
    if gcmap_has(m, 999999) {
        return 9
    }
    // Ueberschreiben aendert die Groesse nicht.
    let o1: bool = gcmap_set(m, 100, 12345) catch false
    if !o1 || gcmap_size(m) != 5000 || gcmap_get(m, 100, 0) != 12345 {
        return 10
    }
    // Grabsteine: jeden zweiten loeschen, dann muessen die uebrigen noch
    // gefunden werden (die Suche darf an einem Grabstein NICHT abbrechen).
    i = 2
    while i < 5002 {
        if !gcmap_remove(m, i) {
            return 11
        }
        i = i + 2
    }
    if gcmap_size(m) != 2500 {
        return 12
    }
    i = 3
    while i < 5002 {
        if gcmap_get(m, i, 0) != i * 7 {
            return 13
        }
        i = i + 2
    }
    i = 2
    while i < 5002 {
        if gcmap_has(m, i) {
            return 14
        }
        i = i + 2
    }
    // Wieder einfuegen: die Grabsteine muessen wiederverwendet werden.
    i = 2
    while i < 5002 {
        let ok: bool = gcmap_set(m, i, i * 7) catch false
        if !ok {
            return 15
        }
        i = i + 2
    }
    if gcmap_size(m) != 5000 {
        return 16
    }
    // Durchlauf: jeder belegte Platz genau einmal.
    var counted: u64 = 0
    var sum: u64 = 0
    var p: u64 = 0
    while p < gcmap_capacity(m) {
        if gcmap_slot_used(m, p) {
            counted = counted + 1
            sum = sum + gcmap_slot_key(m, p)
        }
        p = p + 1
    }
    if counted != 5000 {
        return 17
    }
    // 2 + 3 + … + 5001
    if sum != (2 + 5001) * 5000 / 2 {
        return 18
    }
    gcmap_clear(m)
    if gcmap_size(m) != 0 || gcmap_has(m, 100) {
        return 19
    }

    // --- 2. verfolgte Werte ueberstehen das Einstreuen ------------------
    let w: Gc[GcMap] = gcmap_new(false, true) catch gc_null[GcMap]()
    i = 2
    while i < 3002 {
        let t: Gc[Text] = text(i * 11) catch gc_null[Text]()
        if (t as u64) == 0 {
            return 20
        }
        let ok: bool = gcmap_set_value[Text](w, i, t) catch false
        if !ok {
            return 21
        }
        i = i + 1
    }
    gc_collect()
    gc_collect()
    i = 2
    while i < 3002 {
        let t: Gc[Text] = gcmap_get_value[Text](w, i)
        if (t as u64) == 0 {
            return 22
        }
        if t.content != i * 11 {
            return 23
        }
        i = i + 1
    }

    // --- 3. verfolgte SCHLUESSEL ----------------------------------------
    let s: Gc[GcMap] = gcmap_new(true, true) catch gc_null[GcMap]()
    let ss: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
    i = 0
    while i < 500 {
        let k: Gc[Text] = text(i + 1) catch gc_null[Text]()
        let v: Gc[Text] = text(1000 + i) catch gc_null[Text]()
        let o3: bool = gcvec_append[Text](ss, k) catch false
        let o4: bool = gcmap_set(s, k as u64, v as u64) catch false
        if !o3 || !o4 {
            return 24
        }
        i = i + 1
    }
    gc_collect()
    gc_collect()
    i = 0
    while i < 500 {
        let k: Gc[Text] = gcvec_read[Text](ss, i)
        if k.content != i + 1 {
            return 25
        }
        let v: Gc[Text] = gcmap_get(s, k as u64, 0) as Gc[Text]
        if (v as u64) == 0 {
            return 26
        }
        if v.content != 1000 + i {
            return 27
        }
        i = i + 1
    }

    // --- 4. ein geloeschter Eintrag haelt nichts mehr -------------------
    gc_collect()
    let before: u64 = gc_live_objects()
    let d: Gc[GcMap] = gcmap_new(false, true) catch gc_null[GcMap]()
    i = 2
    while i < 1002 {
        let t: Gc[Text] = text(i) catch gc_null[Text]()
        let ok: bool = gcmap_set_value[Text](d, i, t) catch false
        if !ok {
            return 28
        }
        i = i + 1
    }
    gc_collect()
    if gc_live_objects() < before + 1000 {
        return 29
    }
    i = 2
    while i < 1002 {
        if !gcmap_remove(d, i) {
            return 30
        }
        i = i + 1
    }
    // MERGE R49+R53: der konservative Stapelscan darf tote Objekte behalten.
    // Runde 49 hat den Scan repariert (er beginnt jetzt wirklich unterhalb
    // des eigenen Rahmens und erfasst die geretteten callee-saved Register)
    // — seither hielten zwei alte Slot-Puffer dieser Karte samt ihrer 768
    // Werte als Zufallstreffer. Wer belegen will, dass etwas NICHT gehalten
    // wird, muss vorher den toten Stapel saeubern; genau dafuer gibt es
    // gc_stapel_saeubern() (gc.fi, Runde 49), und tests/833 sowie lib/dom
    // tun dasselbe.
    gc_stack_clean()
    gc_collect()
    gc_collect()
    if gc_live_objects() > before + 16 {
        return 31
    }

    // --- 5. Zyklen ueber eine GcMap werden eingesammelt -----------------
    gc_collect()
    let vor2: u64 = gc_live_objects()
    var z: u64 = 0
    while z < 200 {
        let n: u64 = cycle(20) catch 0
        if n != 21 {
            return 32
        }
        z = z + 1
    }
    gc_collect()
    gc_collect()
    if gc_live_objects() > vor2 + 24 {
        return 33
    }
    return 0
}
