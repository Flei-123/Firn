// expect_exit: 0
// tests/1002_js_interp.fi -- ROUND 63: the INTERPRETER and the built in
// objects, checked from inside JavaScript.
//
// The engine runs ONE JavaScript program with 71 numbered assertions and
// stores the number of the first failing one in the global variable
// `fail`. The Firn side reads that variable out of the global object and
// hands it back as the exit code -- so the exit code names exactly the
// check that broke.
//
// What is covered: the coercions (7.1) and `==` (7.2.15), `typeof`,
// closures and the per iteration environment of `for (let ...)`, `this`
// with `call`/`apply`/`bind`, prototype chains, property attributes and
// accessors, classes with `extends` and `super`, destructuring, spread,
// template literals, exceptions with `finally`, `for-in` and `for-of`,
// labels, `switch`, and the methods of Object, Array, String, Number,
// Math, JSON, Map and Set.
import html.mem
import js.lex
import js.ast
import js.parse
import js.val
import js.interp
import js.builtin

const SRC_LEN: usize = 3870

fn __gc_finalize(kind: u64, p: *mut u8) {
}

// ROUND 79 -- the realm is a GC object and is handed the addresses of `ctx`,
// `t` and `nm`, which lie in THIS frame. It is sound here and only here: the
// realm comes into being in this call, nothing outside gets hold of it, and
// it is garbage the moment this function returns. The escape analysis
// (compiler/src/escape.rs) cannot see that, so the exception is said out
// loud instead of the check being weakened (docs/ROUND79.md 3).
#[allow_escape]
fn run(src: *mut u8, len: usize) -> AllocError!u64 {
    var nm: lex.Names = lex.Names { pool: mem.cp_new(), off: mem.cp_new(),
        len: mem.cp_new(), hash: mem.cp_new(), buckets: mem.cp_new(),
        mask: 0, n: 0 }
    lex.names_init(&nm)
    var l: lex.Lexer = lex.lex_new()
    lex.lex_init(&l, &nm)
    var t: ast.Ast = ast.ast_new()
    ast.ast_init(&t)
    var p: parse.Parser = parse.parser_new()
    parse.parser_init(&p, &l, &t, &nm)
    lex.lex_set_ascii(&l, src, len)
    let prog: u32 = parse.parse_program(&p, false)
    if parse.parse_error(&p) != parse.ERR_NONE {
        return 900 + parse.parse_error_line(&p) as u64
    }
    var ctx: interp.Ctx = interp.ctx_new()
    ctx.native = builtin.native_dispatch
    ctx.arity = builtin.native_arity_of
    let r: Gc[Realm] = try val.realm_new()
    val.realm_set_ctx(r, (&ctx) as *mut u8)
    val.realm_set_ast(r, &t, &nm)
    let g: Gc[JsObj] = try builtin.install(r)
    let v: Gc[JsVal] = try interp.run_program(r, prog, r.global_env)
    if ctx.comp == interp.C_THROW {
        return 800
    }
    // Read the global `fail` back out of the global object.
    var name: [u8; 4] = "fail"
    let s: Gc[JsVal] = try val.str_from_ascii(r, &name[0], 4)
    let k: u64 = try val.key_for_str(r, s)
    let gv: Gc[JsVal] = g
    let f: Gc[JsVal] = try interp.get_prop(r, gv, k)
    let n: u64 = try interp.to_number(r, f)
    let x: f64 = math_of(n)
    return x as u64
}

fn math_of(bits: u64) -> f64 {
    var t: u64 = bits
    return *(((&t) as usize) as *mut f64)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    gc_set_max_bytes(1 << 30)
    var s: [u8; 3870] = "globalThis.fail=0;\nfunction ck(n,c){ if(!c && globalThis.fail===0) globalThis.fail=n; }\nck(1, 1+1===2);\nck(2, \"a\"+1===\"a1\");\nck(3, (0.1+0.2).toString()===\"0.30000000000000004\");\nck(4, 1/0===Infinity);\nck(5, isNaN(0/0));\nck(6, (-0).toString()===\"0\");\nck(7, 1/(-0)===-Infinity);\nck(8, null==undefined);\nck(9, !(null===undefined));\nck(10, !(null==0));\nck(11, \"\"==0);\nck(12, !(\"\"===\"0\"));\nck(13, \"2\"<\"10\"===false);\nck(14, 2<\"10\");\nck(15, []+{}===\"[object Object]\");\nck(16, +\"0x10\"===16);\nck(17, typeof null===\"object\");\nck(18, typeof (()=>1)===\"function\");\nck(19, typeof Symbol()===\"symbol\");\nck(20, (function(){return arguments.length})(1,2)===2);\nck(21, (function(a,b){return a+b}).length===2);\nck(22, ((a,b=1)=>a).length===1);\nck(23, new (function F(){this.x=3})().x===3);\nck(24, ({}).toString()===\"[object Object]\");\nck(25, Object.keys({a:1,b:2}).join()===\"a,b\");\nck(26, JSON.stringify({a:[1,null],b:\"x\"})==='{\"a\":[1,null],\"b\":\"x\"}');\nck(27, JSON.parse(\"[1,{\\\"a\\\":2}]\")[1].a===2);\nck(28, [3,1,2].sort().join()===\"1,2,3\");\nck(29, [1,2,3].reduce((a,b)=>a+b)===6);\nck(30, [1,2,3].map(x=>x*2).join()===\"2,4,6\");\nck(31, [1,2,3].filter(x=>x>1).length===2);\nck(32, \"abc\".toUpperCase()===\"ABC\");\nck(33, \"a,b\".split(\",\").length===2);\nck(34, \"abc\".slice(-2)===\"bc\");\nck(35, \"x\".repeat(3)===\"xxx\");\nck(36, \"a\".padStart(3,\"-\")===\"--a\");\nck(37, Math.max(1,2,3)===3);\nck(38, Math.round(-1.5)===-1);\nck(39, Math.pow(2,53)===9007199254740992);\nck(40, (255).toString(16)===\"ff\");\nck(41, (1.005).toFixed(2)===\"1.00\");\nck(42, Number.isInteger(5));\nck(43, !Number.isInteger(5.5));\nck(44, parseInt(\"12px\")===12);\nck(45, (function(){var n=0;var f=function(){return ++n};f();return f()})()===2);\nck(46, (function(){var a=[];for(let i=0;i<3;i++)a.push(()=>i);return a[0]()+a[1]()+a[2]()})()===3);\nck(47, (function(){try{throw new TypeError(\"x\")}catch(e){return e instanceof TypeError&&e.message===\"x\"}})());\nck(48, (function(){try{return 1}finally{}})()===1);\nck(49, (function(){var s=\"\";for(var k in {a:1,b:2})s+=k;return s})()===\"ab\");\nck(50, (function(){var s=0;for(var v of [1,2,3])s+=v;return s})()===6);\nck(51, (function(){class A{constructor(x){this.x=x}m(){return this.x}}class B extends A{m(){return super.m()*2}}return new B(4).m()})()===8);\nck(52, (function(){var{a,b=2}={a:1};return a+b})()===3);\nck(53, (function(){var[x,,z=9]=[1,2];return x+z})()===10);\nck(54, (function(){var o={get v(){return 7}};return o.v})()===7);\nck(55, (function(){var o={};Object.defineProperty(o,\"x\",{value:1});o.x=2;return o.x})()===1);\nck(56, (function(){\"use strict\";var o={};Object.defineProperty(o,\"x\",{value:1});try{o.x=2}catch(e){return true}return false})());\nck(57, (function(){var m=new Map();m.set(NaN,1);return m.get(NaN)===1&&m.size===1})());\nck(58, (function(){var s=new Set([1,1,2]);return s.size===2})());\nck(59, (function(){function f(){return this}return f.call(5).valueOf()===5})());\nck(60, (function(){function f(a,b){return a+b}return f.apply(null,[1,2])===3})());\nck(61, (function(){function f(a,b){return a+b};var g=f.bind(null,1);return g(2)===3})());\nck(62, (function(){return [...[1,2],...[3]].length===3})());\nck(63, (function(){return `x${1+1}y`===\"x2y\"})());\nck(64, (function(){var o={a:1};var p=Object.create(o);return p.a===1&&!p.hasOwnProperty(\"a\")})());\nck(65, (function(){return Object.prototype.toString.call([])===\"[object Array]\"})());\nck(66, (function(){var n=0;label:for(var i=0;i<3;i++){for(var j=0;j<3;j++){if(j)continue label;n++}}return n===3})());\nck(67, (function(){switch(2){case 1:return \"a\";case 2:return \"b\";default:return \"c\"}})()===\"b\");\nck(68, (function(){var x=0;var f=()=>this;return typeof f()===\"object\"||typeof f()===\"undefined\"})());\nck(69, (function(){return \"a\\u{1F600}b\".length===4})());\nck(70, (function(){return [1,2,3].indexOf(2)===1&&[1,2,3].includes(3)})());\nck(71, (function(){var a=[1,2,3,4];a.splice(1,2);return a.join()===\"1,4\"})());\n"
    let bad: u64 = run(&s[0], SRC_LEN) catch 999
    return bad as i32
}
