// expect_exit: 0
import std.rt
import mc.mc_tip_lines
import mc.mc_item_names
import mc.mc_item_tip

const LANG: str = "{\"item.minecraft.potion.effect.swiftness\":\"Potion of Swiftness\",\"effect.minecraft.speed\":\"Speed\",\"effect.minecraft.jump_boost\":\"Jump Boost\",\"effect.minecraft.instant_damage\":\"Instant Damage\",\"potion.withDuration\":\"%s (%s)\",\"potion.withAmplifier\":\"%s %s\",\"potion.potency.1\":\"II\",\"effect.none\":\"No Effects\",\"potion.whenDrank\":\"When Applied:\",\"attribute.name.generic.movement_speed\":\"Speed\",\"attribute.modifier.plus.2\":\"+%s%% %s\",\"effect.duration.infinite\":\"inf\"}"

fn line_is(t: *mut mc_tip_lines.TipLines, i: usize, want: str) -> bool {
    if mc_tip_lines.tl_len(t, i) != want.n { return false }
    return rt.mem_eq(mc_tip_lines.tl_text(t) + (mc_tip_lines.tl_off(t, i) as u64), want.p as u64, want.n)
}

fn line_rgb(t: *mut mc_tip_lines.TipLines, i: usize) -> i32 {
    return (rt.ld32(mc_tip_lines.tl_cols(t), mc_tip_lines.tl_off(t, i)) & 0xFFFFFF as u32) as i32
}

fn build(t: *mut mc_tip_lines.TipLines, rec: str, item: str, protocol: i32) {
    mc_tip_lines.tl_clear(t)
    mc_item_tip.tip_build(t, rec.p as u64, rec.n, item.p as u64, item.n, protocol, 0, 0)
}

fn main() -> i32 {
    var t: mc_tip_lines.TipLines = mc_tip_lines.tl_new()
    if !mc_item_names.names_load(LANG.p as u64, LANG.n) { return 1 }
    build(&t, "p13\n", "minecraft:potion", 772)
    if mc_tip_lines.tl_count(&t) != 5 { return 10 }
    if !line_is(&t, 0, "Potion of Swiftness") || !line_is(&t, 1, "Speed (3:00)") || line_rgb(&t, 1) != 0x5555FF { return 11 }
    if mc_tip_lines.tl_len(&t, 2) != 0 || !line_is(&t, 3, "When Applied:") || line_rgb(&t, 3) != 0xAA00AA { return 12 }
    if !line_is(&t, 4, "+20% Speed") || line_rgb(&t, 4) != 0x5555FF { return 13 }
    build(&t, "p10\n", "tipped_arrow", 772)
    if !line_is(&t, 0, "Tipped Arrow") || !line_is(&t, 1, "Jump Boost II (0:11)") { return 20 }
    build(&t, "p0\n", "potion", 772)
    if mc_tip_lines.tl_count(&t) != 2 || !line_is(&t, 0, "Potion") || !line_is(&t, 1, "No Effects") || line_rgb(&t, 1) != 0xAAAAAA { return 30 }
    build(&t, "", "splash_potion", 772)
    if mc_tip_lines.tl_count(&t) != 2 || !line_is(&t, 1, "No Effects") { return 31 }
    build(&t, "f6\t1\t1\n", "potion", 772)
    if mc_tip_lines.tl_count(&t) != 2 || !line_is(&t, 1, "Instant Damage II") || line_rgb(&t, 1) != 0xFF5555 { return 40 }
    build(&t, "qminecraft:swiftness\n", "potion", 763)
    if !line_is(&t, 0, "Potion of Swiftness") || !line_is(&t, 1, "Speed (3:00)") { return 50 }
    build(&t, "f0\t0\t0\n", "potion", 772)
    if !line_is(&t, 1, "Speed") { return 51 }
    build(&t, "f0\t0\t-1\n", "potion", 772)
    if !line_is(&t, 1, "Speed (inf)") { return 53 }
    build(&t, "f0\t0\t72000\n", "lingering_potion", 772)
    if !line_is(&t, 1, "Speed (15:00)") { return 54 }
    build(&t, "f0\t0\t72000\n", "potion", 772)
    if !line_is(&t, 1, "Speed (1:00:00)") { return 55 }
    build(&t, "p0\nf0\t0\t1200\n", "diamond", 772)
    if mc_tip_lines.tl_count(&t) != 1 { return 60 }
    return 0
}
