// expect_exit: 0
// 26.1 (protocol 775) chunk sections carry a second i16 (non-empty fluid count) after the block count
// (found from the raw bytes of a real 26.1 server). chunk_decode_for must read them with FLAG_SEC_FLUID and keep reading
// 1.21.8 (772) sections without it; the wrong layout must be refused or give other counts.
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_chunk

// map_chunk of 1.21.5+ shape with 2 single-value sections; `fluid` adds the i16 fluid count to each section
fn build(b: *mut bytes.Bytes, fluid: bool) {
    bytes.put_i32(b, 3)
    bytes.put_i32(b, 0 - 4)
    bytes.put_varint(b, 0) // heightmaps: empty keyed map
    var d: bytes.Bytes = bytes.bytes_new()
    var s: i32 = 0
    while s < 2 {
        bytes.put_i16(&d, 100 + s as i16) // block count
        if fluid { bytes.put_i16(&d, 7 as i16) }
        bytes.put_u8(&d, 0 as u8) // blocks: single value, no data array length (1.21.5+)
        bytes.put_varint(&d, 9 + s)
        bytes.put_u8(&d, 0 as u8) // biomes: single value
        bytes.put_varint(&d, 1)
        s = s + 1
    }
    bytes.put_varint(b, d.len as i32)
    bytes.put_raw(b, d.data, d.len)
    bytes.bytes_free(&d)
    bytes.put_varint(b, 0) // block entities
    var m: i32 = 0
    while m < 4 { bytes.put_varint(b, 0); m = m + 1 } // four masks
    bytes.put_varint(b, 0) // sky arrays
    bytes.put_varint(b, 0) // block arrays
}

fn decode(protocol: i32, fluid: bool, counts: *mut [i32; 2]) -> bool {
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(protocol, &v) { return false }
    var b: bytes.Bytes = bytes.bytes_new()
    build(&b, fluid)
    bytes.bytes_set_pos(&b, 0)
    var sc: mc_chunk.Scratch = mc_chunk.scratch_new()
    let p: u64 = mc_chunk.chunk_alloc()
    let c: *mut mc_chunk.Chunk = p as *mut mc_chunk.Chunk
    let ok: bool = mc_chunk.chunk_decode_for(&v, &b, &sc, c, 2) catch false
    if ok {
        let s0: *mut mc_chunk.Section = (*c).secs as *mut mc_chunk.Section
        let s1: *mut mc_chunk.Section = ((*c).secs + mc_chunk.section_size() as u64) as *mut mc_chunk.Section
        (*counts)[0] = (*s0).count
        (*counts)[1] = (*s1).count
    }
    mc_chunk.chunk_release(p)
    mc_chunk.scratch_free(&sc)
    bytes.bytes_free(&b)
    return ok
}

fn main() -> i32 {
    var cnt: [i32; 2] = [0, 0]
    if !decode(775, true, &cnt) { return 1 }
    if cnt[0] != 100 || cnt[1] != 101 { return 2 }
    var c2: [i32; 2] = [0, 0]
    if !decode(772, false, &c2) { return 3 }
    if c2[0] != 100 || c2[1] != 101 { return 4 }
    // 26.1 bytes read as 1.21.8: the fluid count shifts everything -> not a valid decode with the same counts
    var c3: [i32; 2] = [0, 0]
    let ok3: bool = decode(772, true, &c3)
    if ok3 && c3[0] == 100 && c3[1] == 101 { return 5 }
    return 0
}
