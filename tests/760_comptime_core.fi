// expect_exit: 0
// COMPTIME IN DER KERNSPRACHE — der Test zur Runde, in der `firnc1` den
// comptime-Interpreter (lib/firnc1/time.fi) bekommen hat.
//
// Geprueft wird ein kompaktes Bild dessen, was der Interpreter beherrschen
// muss: Funktionsaufrufe (auch rekursiv), eine Schleife mit `emit_zahl` UND
// `emit_roh`, eine Fallunterscheidung, und dass der erzeugte Quelltext im
// SELBEN Lauf gelext/geparst/angehaengt wird und danach ein GEWOEHNLICHER
// Teil des Programms ist (aufrufbar, typgeprueft, mitkompiliert).
fn is_even(n: i64) -> i64 {
    if n == 0 {
        return 1
    }
    return is_odd(n - 1)
}

fn is_odd(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    return is_even(n - 1)
}

// Erzeugt eine Nachschlagefunktion `quadrat_tab(i)` fuer 0..10, per
// Fallunterscheidung im erzeugten Text — nicht im Interpreter gerechnet.
comptime {
    emit_raw("fn square_tab(i: i64) -> i64 {\n")
    var i: i64 = 0
    while i < 10 {
        emit_raw("    if i == ")
        emit_number(i)
        emit_raw(" { return ")
        emit_number(i * i)
        emit_raw(" }\n")
        i = i + 1
    }
    emit_raw("    return 0 - 1\n}\n")
}

fn main() -> i32 {
    // rekursive Aufrufe zur Uebersetzungszeit
    if is_even(10) != 1 {
        return 1
    }
    if is_even(7) != 0 {
        return 2
    }
    // der erzeugte Code laeuft ZUR LAUFZEIT, ganz gewoehnlich
    if square_tab(0) != 0 {
        return 3
    }
    if square_tab(7) != 49 {
        return 4
    }
    if square_tab(9) != 81 {
        return 5
    }
    if square_tab(10) != (0 - 1) {
        return 6
    }
    return 0
}
