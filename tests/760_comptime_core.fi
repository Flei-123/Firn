// expect_exit: 0
// COMPTIME IN THE CORE LANGUAGE -- the test for the round in which `firnc1`
// got the comptime interpreter (lib/firnc1/time.fi).
//
// What is checked is a compact picture of what the interpreter has to
// master: function calls (recursive ones too), a loop with `emit_number` AND
// `emit_raw`, a case distinction, and that the produced source text is
// lexed/parsed/appended in the SAME run and is an ORDINARY part of the
// program afterwards (callable, type checked, compiled along).
fn is_even(n: i64) -> i64 {
    if n == 0 {
        return 1
    }
    return is_odd(n - 1)
}

fn is_odd(n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    return is_even(n - 1)
}

// Produces a lookup function `square_tab(i)` for 0..10, through a case
// distinction in the produced text -- not computed in the interpreter.
comptime {
    emit_raw("fn square_tab(i: i64) -> i64 {\n")
    var i: i64 = 0
    while i < 10 {
        emit_raw("    if i == ")
        emit_number(i)
        emit_raw(" { return ")
        emit_number(i * i)
        emit_raw(" }\n")
        i = i + 1
    }
    emit_raw("    return 0 - 1\n}\n")
}

fn main() -> i32 {
    // recursive calls at compile time
    if is_even(10) != 1 {
        return 1
    }
    if is_even(7) != 0 {
        return 2
    }
    // the produced code runs AT RUN TIME, quite ordinarily
    if square_tab(0) != 0 {
        return 3
    }
    if square_tab(7) != 49 {
        return 4
    }
    if square_tab(9) != 81 {
        return 5
    }
    if square_tab(10) != (0 - 1) {
        return 6
    }
    return 0
}
