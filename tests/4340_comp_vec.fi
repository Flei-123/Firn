// expect_exit: 0
// tests/4340_comp_vec.fi -- wf-py: list comprehension / list literal for `Vec[T]` (parser desugar,
// the target needs a declared type: `let x: Vec[T] = [..]` or `return [..]`).
import std.rt
import std.vec

struct P {
    a: i64,
    b: i64,
}

fn mk(n: i64) -> Vec[i64] {
    var v: Vec[i64] = vec_new[i64]()
    var i: i64 = 0
    while i < n {
        vec_push[i64](&v, i)
        i = i + 1
    }
    return v
}

fn squares(xs: *mut Vec[i64]) -> Vec[i64] {
    return [x * x for x in *xs]
}

fn evens(n: i64) -> Vec[i64] {
    return [i for i in 0..n if i % 2 == 0]
}

fn lit() -> Vec[i64] {
    return [7, 8, 9,]
}

fn sum(v: *mut Vec[i64]) -> i64 {
    var t: i64 = 0
    for x in *v {
        t = t + x
    }
    return t
}

#[no_inline]
fn run() -> i32 {
    var xs: Vec[i64] = mk(6)
    // plain map
    let sq: Vec[i64] = [x * x for x in xs]
    if vec_len[i64](&sq) != 6 || sum(&sq) != 55 { return 2 }
    // filter + map
    let odd: Vec[i64] = [x * 10 for x in xs if x % 2 == 1]
    if vec_len[i64](&odd) != 3 || sum(&odd) != 90 { return 3 }
    let n20: i64 = 20
    let n4: i64 = 4
    // range source, two `if` clauses
    let r: Vec[i64] = [i for i in 1..=n20 if i % 2 == 0 if i % 3 == 0]
    if vec_len[i64](&r) != 3 || sum(&r) != 36 { return 4 }
    // nested `for`: pairs i<j
    let pairs: Vec[i64] = [i * 10 + j for i in 0..n4 for j in 0..n4 if j > i]
    if vec_len[i64](&pairs) != 6 || sum(&pairs) != 12 + 13 + 23 + 1 + 2 + 3 { return 5 }
    // tuple pattern with enumerate
    let ix: Vec[i64] = [(i as i64) * x for (i, x) in enumerate(xs)]
    if sum(&ix) != 55 { return 6 }
    // struct elements
    let ps: Vec[P] = [P { a: x, b: x + 1 } for x in xs]
    if vec_len[P](&ps) != 6 { return 7 }
    // list literal, empty list, trailing comma
    let l: Vec[i64] = [1, 2, 3,]
    if vec_len[i64](&l) != 3 || sum(&l) != 6 { return 8 }
    let e: Vec[i64] = []
    if vec_len[i64](&e) != 0 { return 9 }
    // a comprehension over an empty source
    let none: Vec[i64] = [x for x in e]
    if vec_len[i64](&none) != 0 { return 10 }
    // return forms
    var q: Vec[i64] = squares(&xs)
    if sum(&q) != 55 { return 11 }
    var ev: Vec[i64] = evens(10)
    if vec_len[i64](&ev) != 5 || sum(&ev) != 20 { return 12 }
    var lt: Vec[i64] = lit()
    if sum(&lt) != 24 { return 13 }
    // multi-line
    let ml: Vec[i64] = [
        x + 1
        for x in xs
        if x > 2
    ]
    if sum(&ml) != 15 { return 14 }
    vec_free[i64](&xs)
    vec_free[i64](&sq)
    return 0
}

fn main() -> i32 {
    return run()
}
