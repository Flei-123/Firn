// expect_exit: 42
// Round GAPS: a `const` may use the constants of an imported module
// (certus ROUND54 6.3: "unknown name 'm__K'"). The merged program puts the
// importing file first; the constants are now checked in dependency order.
import modules.gapk

const FIRST: i32 = gapk.OP_BASE + 1
const COUNT: i32 = gapk.OP_LAST - gapk.OP_BASE + 1
const BYTES: u64 = gapk.WIDTH * 4
const LOCAL_AFTER: i32 = FIRST + COUNT

fn main() -> i32 {
    let buf: [u8; 32] = [1; BYTES]
    if COUNT != 10 { return 1 as i32 }
    if FIRST != 31 { return 2 as i32 }
    if LOCAL_AFTER != 41 { return 3 as i32 }
    if BYTES != 32 as u64 { return 4 as i32 }
    return LOCAL_AFTER + buf[31] as i32
}
