// expect_exit: 0
// r563: the root scan rejects every word outside the heap bounds without a
// call to __gc_mark. This must never lose a pointer at the EDGES of the heap
// (first and last chunk) and must cope with a Vec buffer that is mostly zero
// (capacity far above length) or holds stale words above its length.
import std.vec

fn make(i: u32) -> str {
    return "item-" + "0123456789abcdef" + "-x"
}

fn churn(rounds: u32) -> u64 {
    var k: u32 = 0
    var sum: u64 = 0
    while k < rounds {
        let s: str = "garbage-" + "0123456789abcdef0123456789abcdef"
        sum = sum + s.n as u64
        k = k + 1
    }
    return sum
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[str] = vec_new[str]()
    // first strings: lowest heap addresses
    var i: u32 = 0
    while i < 10 {
        if !vec_push[str](&v, make(i)) { return 2 }
        i = i + 1
    }
    // a lot of garbage in between so that many chunks exist
    if churn(400000) == 0 { return 3 }
    // last strings: highest heap addresses
    while i < 20 {
        if !vec_push[str](&v, make(i)) { return 4 }
        i = i + 1
    }
    // big capacity, short length: the tail of the buffer is zero
    if !vec_reserve[str](&v, 100000) { return 5 }
    var round: u32 = 0
    while round < 6 {
        gc_collect()
        if churn(100000) == 0 { return 6 }
        var j: usize = 0
        while j < vec_len[str](&v) {
            let p: u64 = vec_elem_ptr[str](&v, j) as u64
            let s: str = *(p as *mut str)
            if s.n != 23 { return 7 }
            if s != "item-0123456789abcdef-x" { return 8 }
            j = j + 1
        }
        round = round + 1
    }
    // stale words above the length (clear does not wipe the buffer)
    vec_clear[str](&v)
    gc_collect()
    if !vec_push[str](&v, make(99)) { return 9 }
    gc_collect()
    let q: u64 = vec_elem_ptr[str](&v, 0) as u64
    let t: str = *(q as *mut str)
    if t != "item-0123456789abcdef-x" { return 10 }
    return 0
}
