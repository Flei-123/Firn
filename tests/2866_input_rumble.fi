// expect_exit: 0
// tests/2866_input_rumble.fi -- rumble (r434): lib/input/padff.fi bytes (ff_effect 48 octets, input_event 24, ioctl numbers) and the
// padsys.fi call ORDER through the test tap (sys_ff_tap: a pipe records every would-be ioctl / write). No real pad.
import std.rt
import input.padff
import input.padset
import input.padsys
import input.pad

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

// the next record of the tap: tag, length, payload at p; false = pipe empty
fn next_rec(fd: i64, tag: *mut u32, len: *mut u32, p: u64) -> bool {
    var hd: [u64; 1] = [0 as u64; 1]
    let r: i64 = syscall(0, fd, (&hd[0]) as i64, 8, 0, 0, 0)
    if r != 8 {
        return false
    }
    *tag = rt.ld32((&hd[0]) as u64, 0)
    *len = rt.ld32((&hd[0]) as u64, 1)
    if *len > 0 as u32 {
        check(syscall(0, fd, p as i64, (*len) as i64, 0, 0, 0) == (*len) as i64, 90)
    }
    return true
}

fn main() -> i32 {
    // ---- constants (<linux/input.h>, 64 bit)
    check(padff.EVIOCSFF == 0x40304580 && padff.EVIOCRMFF == 0x40044581, 1)
    check(padff.EV_FF == 0x15 as u32 && padff.FF_RUMBLE == 0x50 as u32 && padff.FF_GAIN == 0x60 as u32, 2)
    check(padff.ff_ioc_bits() == 0x80104535, 3)
    check(padff.ff_scale(0.0) == 0 as u32 && padff.ff_scale(1.0) == 65535 as u32 && padff.ff_scale(0.5) == 32768 as u32, 4)
    check(padff.ff_scale(0.0 - 1.0) == 0 as u32 && padff.ff_scale(7.0) == 65535 as u32, 5)
    check(padff.ff_clamp_ms(0 as u32) == 65535 as u32 && padff.ff_clamp_ms(300 as u32) == 300 as u32 && padff.ff_clamp_ms(99999 as u32) == 65535 as u32, 6)
    // ---- ff_effect bytes
    var e: [u64; 6] = [7 as u64; 6]
    let b: u64 = (&e[0]) as u64
    padff.ff_rumble_effect(b, 0 - 1, 0xABCD as u32, 0x1234 as u32, 300 as u32)
    check(rt.ld16(b, 0) == 0x50 as u16 && rt.ld16(b, 1) == 0xFFFF as u16 && rt.ld16(b, 2) == 0 as u16, 10) // type, id, direction
    check(rt.ld16(b, 3) == 0 as u16 && rt.ld16(b, 4) == 0 as u16, 11) // trigger
    check(rt.ld16(b, 5) == 300 as u16 && rt.ld16(b, 6) == 0 as u16, 12) // replay length, delay
    check(rt.ld16(b, 8) == 0xABCD as u16 && rt.ld16(b, 9) == 0x1234 as u16, 13) // strong @16, weak @18
    check(rt.ld16(b, 7) == 0 as u16 && rt.ld64(b, 3) == 0 as u64 && rt.ld64(b, 4) == 0 as u64 && rt.ld64(b, 5) == 0 as u64, 14) // padding + rest of the union
    padff.ff_rumble_effect(b, 5, 1 as u32, 2 as u32, 0 as u32)
    check(rt.ld16(b, 1) == 5 as u16 && rt.ld16(b, 5) == 65535 as u16, 15)
    // ---- input_event bytes
    var ev: [u64; 3] = [9 as u64; 3]
    let q: u64 = (&ev[0]) as u64
    padff.ff_event(q, 3 as u32, 1 as u32)
    check(rt.ld64(q, 0) == 0 as u64 && rt.ld64(q, 1) == 0 as u64 && rt.ld16(q, 8) == 0x15 as u16 && rt.ld16(q, 9) == 3 as u16 && rt.ld32(q, 5) == 1 as u32, 20)

    // ---- the call order through the tap
    var fds: [i32; 2] = [0 as i32; 2]
    check(syscall(293, (&fds[0]) as i64, 2048, 0, 0, 0, 0) == 0, 30)
    let tr: i64 = fds[0] as i64
    let tw: i64 = fds[1] as i64
    var s: padset.PadSet = padset.padset_new()
    let slot: i64 = padset.padset_attach(&s, padset.KIND_EVDEV, 99 as i64, 7 as u32)
    check(slot == 0, 31)
    padsys.sys_ff_tap(tw)
    // no FF_RUMBLE / read only: honest false, nothing recorded
    check(!pad.pad_rumble_supported(&s, 0) && !pad.pad_rumble(&s, 0, 1.0, 1.0, 100 as u32) && !pad.pad_rumble_stop(&s, 0) && !pad.pad_rumble_gain(&s, 0, 1.0), 32)
    var tag: u32 = 0 as u32
    var len: u32 = 0 as u32
    var pay: [u64; 8] = [0 as u64; 8]
    let pp: u64 = (&pay[0]) as u64
    check(!next_rec(tr, &tag, &len, pp), 33)
    // a joydev slot never rumbles
    let js: i64 = padset.padset_attach(&s, padset.KIND_JOYDEV, 98 as i64, 3 as u32)
    padset.padset_set_ff_cap(&s, js as usize, true)
    check(!pad.pad_rumble_supported(&s, js as usize) && !pad.pad_rumble(&s, js as usize, 1.0, 1.0, 100 as u32), 34)
    // an empty slot
    check(!pad.pad_rumble_supported(&s, 5) && !pad.pad_rumble(&s, 5, 1.0, 1.0, 100 as u32), 35)
    // now the evdev slot can rumble
    padset.padset_set_ff_cap(&s, 0, true)
    check(pad.pad_rumble_supported(&s, 0), 36)
    // stop with nothing running = true, nothing written
    check(pad.pad_rumble_stop(&s, 0) && !next_rec(tr, &tag, &len, pp), 37)
    // 1: first rumble = upload (id -1) + play(new id 0)
    check(pad.pad_rumble(&s, 0, 1.0, 0.5, 300 as u32), 40)
    check(next_rec(tr, &tag, &len, pp) && tag == 1 as u32 && len == 48 as u32, 41)
    check(rt.ld16(pp, 0) == 0x50 as u16 && rt.ld16(pp, 1) == 0xFFFF as u16 && rt.ld16(pp, 5) == 300 as u16, 42)
    check(rt.ld16(pp, 8) == 65535 as u16 && rt.ld16(pp, 9) == 32768 as u16, 43)
    check(next_rec(tr, &tag, &len, pp) && tag == 3 as u32 && len == 24 as u32, 44)
    check(rt.ld16(pp, 8) == 0x15 as u16 && rt.ld16(pp, 9) == 0 as u16 && rt.ld32(pp, 5) == 1 as u32, 45) // EV_FF, effect 0, play once
    check(!next_rec(tr, &tag, &len, pp), 46)
    check(padset.padset_ff_id(&s, 0) == 0, 47)
    // 2: change in place = the SAME id uploaded again, then play
    check(pad.pad_rumble(&s, 0, 0.0, 1.0, 0 as u32), 50)
    check(next_rec(tr, &tag, &len, pp) && tag == 1 as u32, 51)
    check(rt.ld16(pp, 1) == 0 as u16 && rt.ld16(pp, 8) == 0 as u16 && rt.ld16(pp, 9) == 65535 as u16 && rt.ld16(pp, 5) == 65535 as u16, 52)
    check(next_rec(tr, &tag, &len, pp) && tag == 3 as u32 && rt.ld32(pp, 5) == 1 as u32, 53)
    // 3: gain
    check(pad.pad_rumble_gain(&s, 0, 0.5), 60)
    check(next_rec(tr, &tag, &len, pp) && tag == 3 as u32 && rt.ld16(pp, 8) == 0x15 as u16 && rt.ld16(pp, 9) == 0x60 as u16 && rt.ld32(pp, 5) == 32768 as u32, 61)
    // 4: stop (value 0) keeps the effect; a rumble of 0 / 0 is a stop too
    check(pad.pad_rumble_stop(&s, 0), 70)
    check(next_rec(tr, &tag, &len, pp) && tag == 3 as u32 && rt.ld16(pp, 9) == 0 as u16 && rt.ld32(pp, 5) == 0 as u32, 71)
    check(pad.pad_rumble(&s, 0, 0.0, 0.0, 100 as u32), 72)
    check(next_rec(tr, &tag, &len, pp) && tag == 3 as u32 && rt.ld32(pp, 5) == 0 as u32 && !next_rec(tr, &tag, &len, pp), 73)
    // 5: rumble again, then close = stop, then erase the effect (in that order)
    check(pad.pad_rumble(&s, 0, 0.3, 0.3, 50 as u32), 80)
    check(next_rec(tr, &tag, &len, pp) && tag == 1 as u32 && rt.ld16(pp, 1) == 0 as u16, 81)
    check(next_rec(tr, &tag, &len, pp) && tag == 3 as u32 && rt.ld32(pp, 5) == 1 as u32, 82)
    pad.pad_close(&s)
    check(next_rec(tr, &tag, &len, pp) && tag == 3 as u32 && rt.ld16(pp, 9) == 0 as u16 && rt.ld32(pp, 5) == 0 as u32, 83)
    check(next_rec(tr, &tag, &len, pp) && tag == 2 as u32 && len == 8 as u32 && rt.ld64(pp, 0) == 0 as u64, 84)
    check(!next_rec(tr, &tag, &len, pp), 85)
    check(!pad.pad_rumble_supported(&s, 0) && !pad.pad_rumble(&s, 0, 1.0, 1.0, 10 as u32), 86)
    padsys.sys_ff_tap(0 - 1)
    return 0
}
