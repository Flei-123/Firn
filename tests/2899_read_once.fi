// expect_exit: 0
// std.mem.read_once_*: exactly one load per call, right values at all widths.
import std.mem

struct Hdr { len: u32, tag: u8, pad: u8, w: u16, big: u64 }

#[no_inline]
fn checked_len(h: *mut Hdr) -> u32 {
    let n: u32 = mem.read_once_u32(&(*h).len)
    if n > 20 { return 0 }
    // `n` is the checked value; it is never re-read from *h
    return n + n
}

fn main() -> i32 {
    var h: Hdr = Hdr { len: 7, tag: 9, pad: 0, w: 513, big: 1234567890123 }
    if mem.read_once_u8(&h.tag) != 9 { return 1 }
    if mem.read_once_u16(&h.w) != 513 { return 2 }
    if mem.read_once_u32(&h.len) != 7 { return 3 }
    if mem.read_once_u64(&h.big) != 1234567890123 { return 4 }
    if checked_len(&h) != 14 { return 5 }
    h.len = 99
    if checked_len(&h) != 0 { return 6 }
    return 0
}
