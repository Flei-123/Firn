// expect_exit: 1
// tests/4323_vec_slice_step_assign_size.fi -- r744: a size mismatch in an extended slice assignment stops the program.
import std.rt
import std.vec

fn main() -> i32 {
    if !gc_init() { return 2 }
    var v: Vec[i64] = vec_new[i64]()
    var w: Vec[i64] = vec_new[i64]()
    var i: i64 = 0
    while i < 6 {
        vec_push[i64](&v, i)
        i = i + 1
    }
    vec_push[i64](&w, 1)
    vec_push[i64](&w, 2)
    v[::2] = w
    return 0
}
