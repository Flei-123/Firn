// expect_exit: 42
// Runde 52 (compiler/src/kern.rs): Inline-Assembler mit Ein- UND
// Ausgabeoperand. `out("rax")` und `in("rax") a` benennen dasselbe Register —
// das ist die Form eines Lese-Schreib-Operanden.
fn main() -> i32 {
    let a: u64 = 40
    let b: u64 = 2
    let s: u64 = asm("add rax, rcx", out("rax"), in("rax") a, in("rcx") b)
    return s as i32
}
