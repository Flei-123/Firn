// expect_exit: 0
// Several 'try'/'catch' in one expression, nested.
error E { A }

fn f(n: i32) -> E!i32 {
    if n < 0 {
        return E::A
    }
    return n
}

fn g(a: i32, b: i32, c: i32) -> E!i32 {
    return (try f(a)) + (try f(b)) * (try f(c))
}

fn main() -> i32 {
    if (g(1, 2, 3) catch 0) != 7 {
        return 1
    }
    if (g(1, 0 - 2, 3) catch 0 - 1) != 0 - 1 {
        return 2
    }
    if (g(0 - 1, 2, 3) catch 0 - 1) != 0 - 1 {
        return 3
    }
    if ((f(0 - 1) catch (f(5) catch 0)) + (f(2) catch 0)) != 7 {
        return 4
    }
    return 0
}
