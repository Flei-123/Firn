// expect_exit: 0
import std.rt
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_inv
import mc.mc_input
import mc.mc_world
import mc.mc_health
import mc.mc_hud_play
import mc.mc_hud_armor

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn put(inv: *mut mc_inv.Inv, r: *mut mc_registry.Registry, slot: i32, name: str) {
    let id: i32 = mc_registry.reg_item_by_name(r, name.p as u64, name.n)
    mc_inv.inv_set(inv, slot, id, 1)
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 1)
    var r: mc_registry.Registry = v.registry_of()
    var inv: mc_inv.Inv = mc_inv.inv_new()
    check(mc_hud_armor.armor_points(&inv, &r) == 0, 2)
    put(&inv, &r, 5, "diamond_helmet")
    put(&inv, &r, 6, "iron_chestplate")
    put(&inv, &r, 7, "leather_leggings")
    put(&inv, &r, 8, "golden_boots")
    check(mc_hud_armor.armor_points(&inv, &r) == 3 + 6 + 2 + 1, 3)
    put(&inv, &r, 5, "turtle_helmet")
    check(mc_hud_armor.armor_points(&inv, &r) == 2 + 6 + 2 + 1, 4)
    put(&inv, &r, 5, "netherite_chestplate")
    check(mc_hud_armor.armor_points(&inv, &r) == 6 + 2 + 1, 5)

    var hp: mc_hud_play.HudPlay = mc_hud_play.hp_new()
    var h: mc_health.Health = mc_health.health_new()
    var pl: mc_input.Player = mc_input.player_new(0.0, 80.0, 0.0)
    pl.slot = 4
    var w: mc_world.World = mc_world.world_new()
    h.known = true
    h.hp = 13
    h.food = 9
    h.mode = 0
    mc_hud_play.hp_tick(&hp, &h, &inv, &r, &pl, &w, 0 - 64)
    check(hp.view.slot == 4, 10)
    check(hp.view.hp_x2 == 13 && hp.view.food == 9, 11)
    check(hp.view.armor == 6 + 2 + 1, 12)
    check(hp.view.max_hp_x2 == 20, 13)
    check(hp.view.show_bars && hp.view.show_xp, 14)
    h.mode = 1
    mc_hud_play.hp_tick(&hp, &h, &inv, &r, &pl, &w, 0 - 64)
    check(!hp.view.show_bars && !hp.view.show_xp, 15)
    h.mode = 3
    mc_hud_play.hp_tick(&hp, &h, &inv, &r, &pl, &w, 0 - 64)
    check(!hp.view.show_bars, 16)
    h.mode = 2
    h.hp = 26
    mc_hud_play.hp_tick(&hp, &h, &inv, &r, &pl, &w, 0 - 64)
    check(hp.view.show_bars && hp.view.max_hp_x2 == 26, 17)
    h.hp = 0
    h.dead = true
    mc_hud_play.hp_tick(&hp, &h, &inv, &r, &pl, &w, 0 - 64)
    check(!hp.view.show_bars, 18)

    check(!mc_hud_play.hp_hidden(&hp) && !mc_hud_play.hp_debug(&hp), 20)
    mc_hud_play.hp_toggle_hidden(&hp)
    mc_hud_play.hp_toggle_debug(&hp)
    check(mc_hud_play.hp_hidden(&hp) && mc_hud_play.hp_debug(&hp), 21)
    mc_hud_play.hp_toggle_hidden(&hp)
    check(!mc_hud_play.hp_hidden(&hp), 22)
    check(!mc_hud_play.hp_open(&hp, 763, false) && !mc_hud_play.hp_vanilla(&hp), 23)
    return 0
}
