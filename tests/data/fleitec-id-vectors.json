 "http": {
  "login": {
   "request": {
    "method": "POST",
    "path": "/api/login",
    "body": {
     "username": "<trimmed>",
     "password": "<as typed>"
    }
   },
   "cases": [
    {
     "id": "ok",
     "status": 200,
     "body": {
      "username": "Justin",
      "token": "t.o.k"
     },
     "expect": {
      "kind": "ok",
      "username": "Justin",
      "token": "t.o.k"
     }
    },
    {
     "id": "ok_without_username",
     "status": 200,
     "body": {
      "token": "t.o.k"
     },
     "expect": {
      "kind": "ok",
      "username": "<the one typed>",
      "token": "t.o.k"
     }
    },
    {
     "id": "wrong_password",
     "status": 401,
     "body": {
      "error": "Falscher Benutzername oder Passwort"
     },
     "expect": {
      "kind": "bad_credentials"
     }
    },
    {
     "id": "rate_limited",
     "status": 429,
     "headers": {
      "Retry-After": "30"
     },
     "body": {
      "error": "Zu viele Fehlversuche. Bitte in 30s erneut versuchen."
     },
     "expect": {
      "kind": "rate_limited",
      "retryAfter": 30
     }
    },
    {
     "id": "ok_but_no_token",
     "status": 200,
     "body": {
      "username": "Justin"
     },
     "expect": {
      "kind": "failed",
      "status": 200
     }
    },
    {
     "id": "server_error",
     "status": 500,
     "body": null,
     "expect": {
      "kind": "failed",
      "status": 500
     }
    },
    {
     "id": "unreachable",
     "status": null,
     "body": null,
     "expect": {
      "kind": "unreachable"
     }
    }
   ]
  },
  "me": {
   "request": {
    "method": "GET",
    "path": "/api/me",
    "auth": "cookie fleitec_session, or ?token=<jwt>, or (relay -> JARVIS) cookie built from the token"
   },
   "cases": [
    {
     "id": "signed_in",
     "status": 200,
     "body": {
      "username": "Justin"
     },
     "expect": {
      "state": "signed_in",
      "username": "Justin"
     }
    },
    {
     "id": "signed_out",
     "status": 401,
     "body": {
      "error": "Nicht angemeldet"
     },
     "expect": {
      "state": "signed_out"
     }
    },
    {
     "id": "unknown_account",
     "status": 401,
     "body": {
      "error": "Konto unbekannt"
     },
     "expect": {
      "state": "signed_out"
     }
    },
    {
     "id": "server_error",
     "status": 503,
     "body": null,
     "expect": {
      "state": "error",
      "status": 503
     }
    },
    {
     "id": "unreachable",
     "status": null,
     "body": null,
     "expect": {
      "state": "error"
     }
    }
   ]
  }
 },
