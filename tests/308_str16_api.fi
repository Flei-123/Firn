// expect_out: 0 5 72 105 33 55296 56832 1 0 2 1 2
// GENERATED by tools/strlib/expand.py from tools/strlib/src/308_str16_api.fi -- do not edit by hand.
// The API contract with the module tok (PLAN 3.3): str16_new, str16_push,
// str16_len, str16_at, atom_intern. `str16_new()` returns an aggregate --
// possible ever since the module kern implemented the System V classification.
// The check covers an unpaired surrogate surviving this path unchanged as
// well, and that atoms are integers.
// lib/str/alloc.fi -- memory without libc (module str).
//
// Stage 0 has neither global variables nor aggregates across function
// boundaries; that is why the whole library works with pointers to
// structures held by the caller. The memory comes straight from mmap(2).
//
// Include:  //#include lib/str/alloc.fi

// ROUND 73: the pure memory work (copy/compare/zero, ld*/st*, page_round)
// moved to `lib/str/core_mem.fi` -- it is the part that a freestanding
// kernel may use. Everything that is LEFT here needs the operating
// system: mmap, munmap, write. Whoever includes this file gets both, so
// no existing caller notices the cut.
// lib/str/core_mem.fi -- memory work WITHOUT the operating system (round 73).
//
// The pure half of `lib/str/alloc.fi`: copying, comparing, zeroing and the
// raw load/store helpers for the 8/16/32/64 bit elements of a block.
// Not one of these functions asks anybody for memory and not one of them
// makes a system call -- they work on memory that the CALLER already
// holds. That is exactly the line along which round 73 cuts the library
// (docs/ROUND73.md): whatever stands here may be used under
// `profile kernel`.
//
// `page_round` stands here as well although it smells of mmap: it is
// arithmetic on a number and nothing else. Whoever rounds a length to
// pages has not yet asked for a single page.
//
// Include:  //#include lib/str/core_mem.fi

fn page_round(n: usize) -> usize {
    return (n + 4095) / 4096 * 4096
}

fn mem_copy(dst: *mut u8, src: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = *((src as usize + i) as *mut u8)
        i = i + 1
    }
}

fn mem_zero(dst: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = 0 as u8
        i = i + 1
    }
}

fn mem_eq(a: *mut u8, b: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if *((a as usize + i) as *mut u8) != *((b as usize + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

// Raw read/write helpers for the 16/32/64 bit elements of a block.
fn ld16(p: *mut u8, i: usize) -> u16 {
    return *((p as usize + i * 2) as *mut u16)
}
fn st16(p: *mut u8, i: usize, v: u16) {
    *((p as usize + i * 2) as *mut u16) = v
}
fn ld32(p: *mut u8, i: usize) -> u32 {
    return *((p as usize + i * 4) as *mut u32)
}
fn st32(p: *mut u8, i: usize, v: u32) {
    *((p as usize + i * 4) as *mut u32) = v
}
fn ld64(p: *mut u8, i: usize) -> u64 {
    return *((p as usize + i * 8) as *mut u64)
}
fn st64(p: *mut u8, i: usize, v: u64) {
    *((p as usize + i * 8) as *mut u64) = v
}
fn ld8(p: *mut u8, i: usize) -> u8 {
    return *((p as usize + i) as *mut u8)
}
fn st8(p: *mut u8, i: usize, v: u8) {
    *((p as usize + i) as *mut u8) = v
}

const SYS_WRITE: i64 = 1
const SYS_READ: i64 = 0
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const SYS_EXIT: i64 = 60
const PROT_READ_WRITE: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34

// Returns n contiguous bytes (zero initialized) or 0 on failure.
fn heap_alloc(n: usize) -> *mut u8 {
    if n == 0 {
        return 0 as *mut u8
    }
    let len: usize = page_round(n)
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
    // mmap reports failure as -1..-4095
    if r < 0 && r > -4096 {
        return 0 as *mut u8
    }
    return r as *mut u8
}

fn heap_free(p: *mut u8, n: usize) {
    if p as usize != 0 {
        syscall(SYS_MUNMAP, p as i64, page_round(n) as i64)
    }
}

fn write_all(fd: i64, p: *mut u8, n: usize) {
    var off: usize = 0
    while off < n {
        let r: i64 = syscall(SYS_WRITE, fd, (p as usize + off) as i64, (n - off) as i64)
        if r <= 0 {
            return
        }
        off = off + r as usize
    }
}

// lib/str/bytes.fi -- `Bytes` (raw octets) and `Str` (validated UTF-8).
//
// The layout is a contract (SPEC 8.1, PLAN 3.3):
//     Bytes { ptr: *mut u8, len: usize, cap: usize }
//     Str   has the same layout, its content is additionally validated UTF-8.
//
// `Bytes` NEVER turns into text silently: the conversion goes exclusively
// through `bytes_to_str` (which validates) or `str_from_bytes_lossy`.
//
// Include:  //#include lib/str/bytes.fi   (needs lib/str/alloc.fi)

struct Bytes {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

fn bytes_init(b: *mut Bytes) {
    (*b).ptr = 0 as *mut u8
    (*b).len = 0
    (*b).cap = 0
}

fn bytes_free(b: *mut Bytes) {
    heap_free((*b).ptr, (*b).cap)
    bytes_init(b)
}

fn bytes_reserve(b: *mut Bytes, need: usize) {
    if (*b).cap >= need {
        return
    }
    var cap: usize = (*b).cap
    if cap == 0 {
        cap = 32
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    if (*b).len > 0 {
        mem_copy(p, (*b).ptr, (*b).len)
    }
    heap_free((*b).ptr, (*b).cap)
    (*b).ptr = p
    (*b).cap = cap
}

fn bytes_push(b: *mut Bytes, v: u8) {
    bytes_reserve(b, (*b).len + 1)
    st8((*b).ptr, (*b).len, v)
    (*b).len = (*b).len + 1
}

fn bytes_len(b: *mut Bytes) -> usize {
    return (*b).len
}

fn bytes_at(b: *mut Bytes, i: usize) -> u8 {
    if i >= (*b).len {
        return 0 as u8
    }
    return ld8((*b).ptr, i)
}

fn bytes_clear(b: *mut Bytes) {
    (*b).len = 0
}

fn bytes_append(b: *mut Bytes, p: *mut u8, n: usize) {
    bytes_reserve(b, (*b).len + n)
    mem_copy(((*b).ptr as usize + (*b).len) as *mut u8, p, n)
    (*b).len = (*b).len + n
}

fn bytes_eq(a: *mut Bytes, b: *mut Bytes) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr, (*b).ptr, (*a).len)
}

fn bytes_write(fd: i64, b: *mut Bytes) {
    write_all(fd, (*b).ptr, (*b).len)
}

// --- UTF-8 validation (the Bytes -> Str boundary, SPEC 8.1) --------------

// Well formed UTF-8 per Unicode table 3-7: no overlong encoding,
// no surrogates (U+D800..U+DFFF), nothing above U+10FFFF.
fn utf8_is_valid(p: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let b0: u32 = ld8(p, i) as u32
        var need: usize = 0
        var lo: u32 = 0
        var hi: u32 = 0
        if b0 < 0x80 {
            need = 0
        } else if b0 >= 0xC2 && b0 <= 0xDF {
            need = 1
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xE0 {
            need = 2
            lo = 0xA0
            hi = 0xBF
        } else if b0 >= 0xE1 && b0 <= 0xEC {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xED {
            need = 2
            lo = 0x80
            hi = 0x9F
        } else if b0 >= 0xEE && b0 <= 0xEF {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF0 {
            need = 3
            lo = 0x90
            hi = 0xBF
        } else if b0 >= 0xF1 && b0 <= 0xF3 {
            need = 3
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF4 {
            need = 3
            lo = 0x80
            hi = 0x8F
        } else {
            return false
        }
        if need > 0 && i + need >= n {
            return false
        }
        var k: usize = 1
        while k <= need {
            let c: u32 = ld8(p, i + k) as u32
            if k == 1 {
                if c < lo || c > hi {
                    return false
                }
            } else {
                if c < 0x80 || c > 0xBF {
                    return false
                }
            }
            k = k + 1
        }
        i = i + need + 1
    }
    return true
}

// Bytes -> Str: succeeds only for well formed UTF-8 (validates, copies nothing).
fn bytes_is_str(b: *mut Bytes) -> bool {
    return utf8_is_valid((*b).ptr, (*b).len)
}

// lib/str/str16.fi -- `Str16`: a sequence of u16 code units (WTF-16, SPEC 8.2).
//
// Str16 validates NOTHING and normalizes NOTHING. Unpaired surrogates are
// allowed and are kept element by element -- that is deliberate: a
// JavaScript string is allowed to contain them.
//
// The layout is a contract:  Str16 { ptr: *mut u16, len: usize, cap: usize }
// (len/cap count CODE UNITS, not bytes.)
//
// API contract with the module tok (PLAN 3.3). Since stage 0 knows neither
// `inout`/`&` nor aggregates across function boundaries, the parameters are
// pointers and the constructor is called `str16_init(*mut Str16)` instead of
// `str16_new() -> Str16`. The names str16_push/str16_len/str16_at are unchanged.
//
// Include:  //#include lib/str/str16.fi   (needs alloc.fi, bytes.fi)

struct Str16 {
    ptr: *mut u16,
    len: usize,
    cap: usize,
}

fn str16_init(s: *mut Str16) {
    (*s).ptr = 0 as *mut u16
    (*s).len = 0
    (*s).cap = 0
}

fn str16_free(s: *mut Str16) {
    heap_free((*s).ptr as *mut u8, (*s).cap * 2)
    str16_init(s)
}

fn str16_reserve(s: *mut Str16, need: usize) {
    if (*s).cap >= need {
        return
    }
    var cap: usize = (*s).cap
    if cap == 0 {
        cap = 16
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap * 2)
    if (*s).len > 0 {
        mem_copy(p, (*s).ptr as *mut u8, (*s).len * 2)
    }
    heap_free((*s).ptr as *mut u8, (*s).cap * 2)
    (*s).ptr = p as *mut u16
    (*s).cap = cap
}

// Appends ONE code unit -- without any check (0xD800 on its own as well).
fn str16_push(s: *mut Str16, u: u16) {
    str16_reserve(s, (*s).len + 1)
    st16((*s).ptr as *mut u8, (*s).len, u)
    (*s).len = (*s).len + 1
}

fn str16_len(s: *mut Str16) -> usize {
    return (*s).len
}

fn str16_at(s: *mut Str16, i: usize) -> u16 {
    if i >= (*s).len {
        return 0 as u16
    }
    return ld16((*s).ptr as *mut u8, i)
}

fn str16_set(s: *mut Str16, i: usize, u: u16) {
    if i < (*s).len {
        st16((*s).ptr as *mut u8, i, u)
    }
}

fn str16_clear(s: *mut Str16) {
    (*s).len = 0
}

fn str16_eq(a: *mut Str16, b: *mut Str16) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr as *mut u8, (*b).ptr as *mut u8, (*a).len * 2)
}

// Append a code point: anything > 0xFFFF becomes a surrogate pair, everything
// else (including a lone surrogate!) becomes one code unit.
fn str16_push_cp(s: *mut Str16, cp: u32) {
    if cp > 0xFFFF {
        let v: u32 = cp - 0x10000
        str16_push(s, (0xD800 + (v >> 10)) as u16)
        str16_push(s, (0xDC00 + (v & 0x3FF)) as u16)
    } else {
        str16_push(s, cp as u16)
    }
}

fn is_high_surrogate(u: u32) -> bool {
    return u >= 0xD800 && u < 0xDC00
}
fn is_low_surrogate(u: u32) -> bool {
    return u >= 0xDC00 && u < 0xE000
}
fn is_surrogate(u: u32) -> bool {
    return u >= 0xD800 && u < 0xE000
}

// lib/str/str16_byval.fi -- constructors per the API contract (PLAN 3.3).
//
// `str16_new() -> Str16` and `bytes_new() -> Bytes` return an aggregate as
// their result. That has been possible only since the module `core` in
// round 2 implemented the System V classification (SPEC 14.1 item 1
// dropped). Whoever still has to do without takes `str16_init(&s)` /
// `bytes_init(&b)` from str16.fi or bytes.fi -- both ways yield the same
// empty value.
//
// Include:  //#include lib/str/str16_byval.fi  (needs bytes.fi, str16.fi)

fn str16_new() -> Str16 {
    var s: Str16 = Str16 { ptr: 0 as *mut u16, len: 0, cap: 0, }
    return s
}

fn bytes_new() -> Bytes {
    var b: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0, }
    return b
}

// lib/str/atom.fi -- `Atom` (SPEC 8.3): an interned name as a u32.
//
// Comparing two atoms is an INTEGER COMPARISON (`a == b`), not a character
// comparison. Whoever interns first gets the smallest number: the module
// tok interns its known tag names at startup in a fixed order and thereby
// gets fixed, small numbers (the prerequisite for jump tables over tag
// names).
//
// Stage 0 has no global variables; the table is therefore held by the
// caller and passed in as a pointer.
//
// Include:  //#include lib/str/atom.fi   (needs alloc.fi, bytes.fi)

struct AtomTable {
    arena: *mut u8, // all names one after another
    arena_len: usize,
    arena_cap: usize,
    ents: *mut u8, // two u64 per atom: offset, length
    count: usize,
    ents_cap: usize,
    buckets: *mut u8, // open addressing, one u32 per slot (0 = empty, otherwise id+1)
    nbuckets: usize,
}

fn atom_hash(p: *mut u8, len: usize) -> u64 {
    var h: u64 = 14695981039346656037
    var i: usize = 0
    while i < len {
        h = h ^ (ld8(p, i) as u64)
        h = h *% 1099511628211 // ROUND 72: FNV-1a wraps on purpose, *% says so
        i = i + 1
    }
    return h
}

fn atom_table_init(t: *mut AtomTable) {
    (*t).arena = heap_alloc(65536)
    (*t).arena_len = 0
    (*t).arena_cap = 65536
    (*t).ents = heap_alloc(1024 * 16)
    (*t).count = 0
    (*t).ents_cap = 1024
    (*t).nbuckets = 4096
    (*t).buckets = heap_alloc(4096 * 4)
    mem_zero((*t).buckets, 4096 * 4)
}

fn atom_free(t: *mut AtomTable) {
    heap_free((*t).arena, (*t).arena_cap)
    heap_free((*t).ents, (*t).ents_cap * 16)
    heap_free((*t).buckets, (*t).nbuckets * 4)
    (*t).count = 0
}

fn atom_off(t: *mut AtomTable, id: u32) -> usize {
    return ld64((*t).ents, (id as usize) * 2) as usize
}
fn atom_len(t: *mut AtomTable, id: u32) -> usize {
    return ld64((*t).ents, (id as usize) * 2 + 1) as usize
}
fn atom_ptr(t: *mut AtomTable, id: u32) -> *mut u8 {
    return ((*t).arena as usize + atom_off(t, id)) as *mut u8
}

fn atom_count(t: *mut AtomTable) -> usize {
    return (*t).count
}

// Copy the name of an atom into `out`.
fn atom_text(t: *mut AtomTable, id: u32, out: *mut Bytes) {
    bytes_clear(out)
    if id as usize >= (*t).count {
        return
    }
    bytes_append(out, atom_ptr(t, id), atom_len(t, id))
}

fn atom_rehash(t: *mut AtomTable) {
    let nb: usize = (*t).nbuckets * 2
    let nbuf: *mut u8 = heap_alloc(nb * 4)
    mem_zero(nbuf, nb * 4)
    heap_free((*t).buckets, (*t).nbuckets * 4)
    (*t).buckets = nbuf
    (*t).nbuckets = nb
    var id: usize = 0
    while id < (*t).count {
        let h: u64 = atom_hash(atom_ptr(t, id as u32), atom_len(t, id as u32))
        var slot: usize = (h as usize) & (nb - 1)
        while ld32(nbuf, slot) != 0 as u32 {
            slot = (slot + 1) & (nb - 1)
        }
        st32(nbuf, slot, (id + 1) as u32)
        id = id + 1
    }
}

fn atom_grow_arena(t: *mut AtomTable, need: usize) {
    if (*t).arena_len + need <= (*t).arena_cap {
        return
    }
    var cap: usize = (*t).arena_cap
    while cap < (*t).arena_len + need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    mem_copy(p, (*t).arena, (*t).arena_len)
    heap_free((*t).arena, (*t).arena_cap)
    (*t).arena = p
    (*t).arena_cap = cap
}

fn atom_grow_ents(t: *mut AtomTable) {
    if (*t).count < (*t).ents_cap {
        return
    }
    let cap: usize = (*t).ents_cap * 2
    let p: *mut u8 = heap_alloc(cap * 16)
    mem_copy(p, (*t).ents, (*t).count * 16)
    heap_free((*t).ents, (*t).ents_cap * 16)
    (*t).ents = p
    (*t).ents_cap = cap
}

// Core: interns `len` octets at `p` and returns the atom number.
fn atom_intern_raw(t: *mut AtomTable, p: *mut u8, len: usize) -> u32 {
    if (*t).count * 2 >= (*t).nbuckets {
        atom_rehash(t)
    }
    let h: u64 = atom_hash(p, len)
    let mask: usize = (*t).nbuckets - 1
    var slot: usize = (h as usize) & mask
    while true {
        let e: u32 = ld32((*t).buckets, slot)
        if e == 0 as u32 {
            atom_grow_arena(t, len)
            atom_grow_ents(t)
            let id: usize = (*t).count
            let off: usize = (*t).arena_len
            mem_copy(((*t).arena as usize + off) as *mut u8, p, len)
            (*t).arena_len = off + len
            st64((*t).ents, id * 2, off as u64)
            st64((*t).ents, id * 2 + 1, len as u64)
            (*t).count = id + 1
            st32((*t).buckets, slot, (id + 1) as u32)
            return id as u32
        }
        let id: u32 = e - 1 as u32
        if atom_len(t, id) == len {
            if mem_eq(atom_ptr(t, id), p, len) {
                return id
            }
        }
        slot = (slot + 1) & mask
    }
    return 0 as u32
}

// API contract with the module tok: `atom_intern` over `Bytes`.
fn atom_intern(t: *mut AtomTable, b: *mut Bytes) -> u32 {
    return atom_intern_raw(t, (*b).ptr, (*b).len)
}

// Comparing two atoms -- an integer comparison, nothing more.
fn atom_eq(a: u32, b: u32) -> bool {
    return a == b
}

// lib/str/print.fi -- minimal output without libc (numbers and octets).
// Used by the test programs only.
//
// Include:  //#include lib/str/print.fi   (needs lib/str/alloc.fi)

struct PrintBuf {
    b: [u8; 32],
    n: usize,
}

// A decimal number followed by a space.
fn print_num(v: u64) {
    print_num_sep(v, 32 as u8)
}

// A decimal number followed by a line break (the last value of a line).
fn print_num_nl(v: u64) {
    print_num_sep(v, 10 as u8)
}

// A decimal number followed by a separator of your choice.
fn print_num_sep(v: u64, sep: u8) {
    var p: PrintBuf = PrintBuf { b: [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8], n: 0, }
    var x: u64 = v
    var n: usize = 0
    if x == 0 {
        p.b[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        p.b[n] = (x % 10) as u8 + 48 as u8
        x = x / 10
        n = n + 1
    }
    var i: usize = 0
    while i < n / 2 {
        let t: u8 = p.b[i]
        p.b[i] = p.b[n - 1 - i]
        p.b[n - 1 - i] = t
        i = i + 1
    }
    p.b[n] = sep
    write_all(1, &p.b[0], n + 1)
}

// Line break.
fn print_nl() {
    var p: PrintBuf = PrintBuf { b: [10 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8], n: 0, }
    write_all(1, &p.b[0], 1)
}

// A single octet as a character (for text output from a Bytes buffer).
fn print_bytes_raw(b: *mut Bytes) {
    write_all(1, (*b).ptr, (*b).len)
}

fn main() -> i32 {
    var s: Str16 = str16_new()
    print_num(str16_len(&s) as u64) // 0: frisch und leer
    str16_push(&s, 72 as u16) // 'H'
    str16_push(&s, 105 as u16) // 'i'
    str16_push(&s, 33 as u16) // '!'
    str16_push(&s, 0xD800 as u16) // ungepaartes Surrogat
    str16_push(&s, 0xDE00 as u16) // tiefes Surrogat ohne Partner davor
    print_num(str16_len(&s) as u64) // 5
    var i: usize = 0
    while i < str16_len(&s) {
        print_num(str16_at(&s, i) as u64)
        i = i + 1
    }
    print_num((str16_at(&s, 3) as u32 == 0xD800) as u64) // 1: unveraendert
    print_num(str16_at(&s, 99) as u64) // 0: ausserhalb -> 0, kein Absturz

    var t: AtomTable = AtomTable { arena: 0 as *mut u8, arena_len: 0, arena_cap: 0,
        ents: 0 as *mut u8, count: 0, ents_cap: 0, buckets: 0 as *mut u8, nbuckets: 0, }
    atom_table_init(&t)
    var b: Bytes = bytes_new()
    bytes_push(&b, 100 as u8)
    bytes_push(&b, 105 as u8)
    bytes_push(&b, 118 as u8) // "div"
    let a1: u32 = atom_intern(&t, &b)
    bytes_clear(&b)
    bytes_push(&b, 112 as u8) // "p"
    let a2: u32 = atom_intern(&t, &b)
    bytes_clear(&b)
    bytes_push(&b, 100 as u8)
    bytes_push(&b, 105 as u8)
    bytes_push(&b, 118 as u8)
    let a3: u32 = atom_intern(&t, &b)
    print_num(atom_count(&t) as u64) // 2 verschiedene Namen
    print_num((a1 == a3) as u64) // 1
    print_num_nl((a2 != a1) as u64 + a2 as u64)

    str16_free(&s)
    bytes_free(&b)
    atom_free(&t)
    return 0
}
