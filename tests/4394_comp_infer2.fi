// expect_exit: 0
// tests/4394_comp_infer2.fi -- r751: untyped comprehensions in more places: inside a generic
// function, chained, nested, in an `if` condition, in loop bodies, dict/set values from locals.
import std.io
import std.rt
import std.vec
import std.map
import std.dict

fn mk(n: i64) -> Vec[i64] {
    var v: Vec[i64] = vec_new[i64]()
    var i: i64 = 0
    while i < n {
        vec_push[i64](&v, i)
        i = i + 1
    }
    return v
}

fn total(v: Vec[i64]) -> i64 {
    var t: i64 = 0
    var w: Vec[i64] = v
    for x in w {
        t = t + x
    }
    return t
}

fn copy_all[T](v: *mut Vec[T]) -> Vec[T] {
    let c = [x for x in *v]
    return c
}

#[no_inline]
fn run() -> i32 {
    var xs: Vec[i64] = mk(5)
    // chained: the second one iterates the inferred Vec
    let a = [x + 1 for x in xs]
    let b = [y * 2 for y in a]
    if total(b) != 30 { return 2 }
    // nested: an inner comprehension in the element
    let n = [total([y for y in xs]) + x for x in xs]
    if total(n) != 60 { return 3 }
    // in an `if` condition (hoisted in front of the statement, not into the block)
    var hit: i32 = 0
    if total([x for x in xs]) > 5 {
        hit = 1
    }
    if hit != 1 { return 4 }
    // in loop bodies
    var acc: i64 = 0
    for k in xs {
        let row = [k * j for j in xs]
        acc = acc + total(row)
    }
    if acc != 100 { return 5 }
    // generic function
    let c = copy_all[i64](&xs)
    if total(c) != 10 { return 6 }
    // set / dict from locals
    let base: i64 = 7
    let s = { base + x for x in xs }
    if set_len[i64](&s) != 5 { return 7 }
    let d = { "v": base * x for x in xs if x > 3 }
    if dict_len[i64](&d) != 1 { return 8 }
    // bool and f64 elements
    let big = [x >= 3 for x in xs]
    var nb: i32 = 0
    for f in big {
        if f { nb = nb + 1 }
    }
    if nb != 2 { return 9 }
    let fl = [1.5 for i in 0..3]
    var sum: f64 = 0.0
    for q in fl {
        sum = sum + q
    }
    if sum != 4.5 { return 10 }
    return 0
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    return run()
}
