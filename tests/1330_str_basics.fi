// expect_exit: 0
// tests/1330_str_basics.fi -- the language type `str` (round 70).
//
// A text literal has the type `str` right away: no `[u8; N]`, no null octet,
// no `span_of_c`. `==` and `!=` compare the CONTENT, `.p`/`.n` are the two
// words the value really is.
//
// The literal `"hello"` and the literal `"hello"` a few lines further down
// lie in DIFFERENT places in the frame -- and are equal all the same. That is
// exactly the point of the content comparison.

fn same(a: str, b: str) -> bool {
    return a == b
}

fn main() -> i32 {
    let a: str = "hello"
    if a.n != 5 { return 1 }
    if a.p as u64 == 0 { return 2 }
    // content, not address
    let b: str = "hello"
    if !same(a, b) { return 3 }
    if a != b { return 4 }
    if a == "hell" { return 5 }
    if a == "helloo" { return 6 }
    if a != "hello" { return 7 }
    // the empty literal is a valid, empty str
    let e: str = ""
    if e.n != 0 { return 8 }
    if !(e == "") { return 9 }
    if e == a { return 10 }
    // a str as a parameter and as a result
    if !same("x", "x") { return 11 }
    if same("x", "y") { return 12 }
    // umlauts are octets: "ae" in UTF-8 is two octets
    let u: str = "ä"
    if u.n != 2 { return 13 }
    return 0
}
