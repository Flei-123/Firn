// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import std.rt
import zip.zip
import docview.dvdoc
import docview.kinds
import docview.office.dx_open

fn add_str(w: *mut zip.ZipWriter, name: str, body: str) -> bool {
    return zip.zip_add(w, name, body.p as u64, body.n, false) catch | e | (false)
}

fn build_docx(out: *mut rt.Buf) -> bool {
    var w: zip.ZipWriter = zip.zip_writer_new(out)
    var ok: bool = add_str(&w, "[Content_Types].xml", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/><Default Extension=\"xml\" ContentType=\"application/xml\"/><Override PartName=\"/word/document.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml\"/></Types>")
    ok = add_str(&w, "_rels/.rels", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"word/document.xml\"/></Relationships>") && ok
    ok = add_str(&w, "word/document.xml", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><w:document xmlns:w=\"http://schemas.openxmlformats.org/wordprocessingml/2006/main\"><w:body><w:p><w:r><w:t>Hello Firn</w:t></w:r></w:p><w:p><w:r><w:rPr><w:b/></w:rPr><w:t>second paragraph</w:t></w:r></w:p><w:sectPr><w:pgSz w:w=\"11906\" w:h=\"16838\"/><w:pgMar w:top=\"1440\" w:right=\"1440\" w:bottom=\"1440\" w:left=\"1440\" w:header=\"708\" w:footer=\"708\" w:gutter=\"0\"/></w:sectPr></w:body></w:document>") && ok
    let n: usize = zip.zip_finish(&w) catch | e | (0)
    zip.zip_writer_free(&w)
    return ok && n > 0
}

fn main() -> i32 {
    var zbuf: rt.Buf = rt.buf_new()
    if !build_docx(&zbuf) {
        return 20
    }
    dx_open.docx_install_lazy()
    var d: dvdoc.Doc = dvdoc.doc_open(rt.buf_ptr(&zbuf), rt.buf_len(&zbuf))
    if !dvdoc.doc_ok(&d) {
        return 1
    }
    if dvdoc.doc_kind(&d) != kinds.KIND_DOCX {
        return 2
    }
    if dvdoc.doc_pages(&d) != 1 {
        return 3
    }
    var w: i32 = 0
    var h: i32 = 0
    if !dvdoc.doc_page_size(&d, 0, &w, &h) || w < 500 || h < 700 || h <= w {
        return 4
    }
    var buf: rt.Buf = rt.buf_new()
    var rw: i32 = 0
    var rh: i32 = 0
    if !dvdoc.doc_render(&d, 0, 1.0, &buf, &rw, &rh) || rw != w || rh != h || rt.buf_len(&buf) != (rw as usize) * (rh as usize) * 4 {
        return 5
    }
    var txt: rt.Buf = rt.buf_new()
    if !dvdoc.doc_text(&d, 0, &txt) {
        return 6
    }
    let want: str = "Hello Firn\nsecond paragraph"
    if rt.buf_len(&txt) != want.n {
        return 7
    }
    var i: usize = 0
    while i < want.n {
        if rt.buf_at(&txt, i) != rt.ld8(want.p as u64, i) {
            return 8
        }
        i = i + 1
    }
    if dvdoc.doc_page_size(&d, 1, &w, &h) {
        return 9
    }
    dvdoc.doc_free(&d)
    if dvdoc.doc_ok(&d) {
        return 10
    }
    var bad: str = "PK\x03\x04 garbage"
    var d2: dvdoc.Doc = dvdoc.doc_open(bad.p as u64, bad.n)
    if dvdoc.doc_ok(&d2) {
        return 11
    }
    rt.buf_free(&buf)
    rt.buf_free(&txt)
    rt.buf_free(&zbuf)
    return 0
}
