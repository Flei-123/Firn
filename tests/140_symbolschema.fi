// expect_exit: 33
// Symbol-Namensschema (DESIGNZIELE 4): Zwei Module duerfen dieselbe Funktion
// haben, ohne dass der Linker sie verwechselt. Die erzeugten Symbole tragen
// den reservierten Praefix und die Schemaversion (_F0.…), der Einstiegspunkt
// 'main' behaelt seinen nackten Namen.
fn help(x: i32) -> i32 { return x + 1 }

fn main() -> i32 {
    return help(10) + help(21)
}
