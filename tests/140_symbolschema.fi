// expect_exit: 33
// Symbol naming scheme (DESIGN_GOALS 4): two modules may hold the same
// function without the linker confusing them. The emitted symbols carry the
// reserved prefix and the scheme version (_F0....), the entry point
// 'main' keeps its bare name.
fn help(x: i32) -> i32 { return x + 1 }

fn main() -> i32 {
    return help(10) + help(21)
}
