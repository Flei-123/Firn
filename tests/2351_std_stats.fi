// expect_exit: 0
// tests/2351_std_stats.fi -- std.stats: the values of the Python `statistics`
// documentation and a few hand-computed cases (SKRIPT-LIBS r316).
// Floating point comparisons use math.near; the bit-exact cases are marked.
// Exit codes: the number of the first failing check.
import std.vec
import std.math
import std.stats

fn make(v: *mut Vec[f64], a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64) {
    vec_push[f64](v, a)
    vec_push[f64](v, b)
    vec_push[f64](v, c)
    vec_push[f64](v, d)
    vec_push[f64](v, e)
    vec_push[f64](v, f)
    vec_push[f64](v, g)
}

fn near(a: f64, b: f64) -> bool {
    return math.near(a, b, 0.0000000000001)
}

fn at(v: *mut Vec[f64], i: usize) -> f64 {
    let p: *mut f64 = vec_elem_ptr[f64](v, i)
    return *p
}

fn main() -> i32 {
    // statistics.variance([2.75, 1.75, 1.25, 0.25, 0.5, 1.25, 3.5]) = 1.37202380952381
    var a: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&a)
    make(&a, 2.75, 1.75, 1.25, 0.25, 0.5, 1.25, 3.5)
    if !near(stats.variance_vec(&a), 1.37202380952381) { return 1 }
    if !near(stats.stdev_vec(&a) * stats.stdev_vec(&a), 1.37202380952381) { return 2 }
    // statistics.pvariance([0.0, 0.25, 0.25, 1.25, 1.5, 1.75, 2.75, 3.25]) = 1.25 (exact)
    var b: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&b)
    make(&b, 0.0, 0.25, 0.25, 1.25, 1.5, 1.75, 2.75)
    vec_push[f64](&b, 3.25)
    if stats.pvariance_vec(&b) != 1.25 { return 3 }
    if stats.pstdev_vec(&b) != math.sqrt(1.25) { return 4 }
    // statistics.stdev([1.5, 2.5, 2.5, 2.75, 3.25, 4.75]) = 1.08108741552198
    var c: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&c)
    vec_push[f64](&c, 1.5)
    vec_push[f64](&c, 2.5)
    vec_push[f64](&c, 2.5)
    vec_push[f64](&c, 2.75)
    vec_push[f64](&c, 3.25)
    vec_push[f64](&c, 4.75)
    if !near(stats.stdev_vec(&c), 1.08108741552198) { return 5 }
    // mean / median: exact on binary fractions
    if stats.mean_vec(&c) != 2.875 { return 6 }
    if stats.median_vec(&c) != 2.625 { return 7 } // (2.5 + 2.75) / 2
    if stats.sum_vec(&c) != 17.25 { return 8 }
    if stats.min_vec(&c) != 1.5 || stats.max_vec(&c) != 4.75 { return 9 }
    // odd count: the middle value; the data is not reordered by median
    if stats.median_vec(&a) != 1.25 { return 10 }
    if at(&a, 0) != 2.75 || at(&a, 3) != 0.25 || at(&a, 6) != 3.5 { return 11 }
    // the compensation: ten times 0.1 is exactly 1.0 (a plain loop gives 0.9999999999999999)
    var t: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&t)
    var i: usize = 0
    while i < 10 {
        vec_push[f64](&t, 0.1)
        i = i + 1
    }
    if stats.sum_vec(&t) != 1.0 { return 12 }
    if stats.mean_vec(&t) != 0.1 { return 13 }
    // 1e100 + 1 - 1e100 survives the compensation (naive gives 0)
    var h: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&h)
    vec_push[f64](&h, 1e100)
    vec_push[f64](&h, 1.0)
    vec_push[f64](&h, 0.0 - 1e100)
    if stats.sum_vec(&h) != 1.0 { return 14 }
    // percentile: numpy.percentile([1, 2, 3, 4], q) -> 0:1.0  25:1.75  50:2.5  75:3.25  100:4.0
    var d: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&d)
    vec_push[f64](&d, 4.0)
    vec_push[f64](&d, 1.0)
    vec_push[f64](&d, 3.0)
    vec_push[f64](&d, 2.0)
    if stats.percentile_vec(&d, 0.0) != 1.0 { return 15 }
    if stats.percentile_vec(&d, 25.0) != 1.75 { return 16 }
    if stats.percentile_vec(&d, 50.0) != 2.5 { return 17 }
    if stats.percentile_vec(&d, 75.0) != 3.25 { return 18 }
    if stats.percentile_vec(&d, 100.0) != 4.0 { return 19 }
    if stats.percentile_vec(&d, 90.0) != 3.7 && !near(stats.percentile_vec(&d, 90.0), 3.7) { return 20 }
    if at(&d, 0) != 4.0 || at(&d, 1) != 1.0 { return 21 } // untouched
    // plain pointer + count form: the same code
    var arr: [f64; 5] = [5.0, 1.0, 4.0, 2.0, 3.0]
    if stats.mean(&arr[0], 5) != 3.0 { return 22 }
    if stats.median(&arr[0], 5) != 3.0 { return 23 }
    if arr[0] != 5.0 || arr[4] != 3.0 { return 24 }
    // in place: the same answer, the array is permuted (same multiset)
    if stats.median_inplace(&arr[0], 5) != 3.0 { return 25 }
    if stats.sum(&arr[0], 5) != 15.0 { return 26 }
    stats.sort(&arr[0], 5)
    if arr[0] != 1.0 || arr[1] != 2.0 || arr[2] != 3.0 || arr[3] != 4.0 || arr[4] != 5.0 { return 27 }
    if stats.percentile_inplace(&arr[0], 5, 25.0) != 2.0 { return 28 }
    // variance of two values: (a-b)^2 / 2
    var two: [f64; 2] = [1.0, 3.0]
    if stats.variance(&two[0], 2) != 2.0 { return 29 }
    if stats.pvariance(&two[0], 2) != 1.0 { return 30 }
    // a constant series has variance exactly 0
    var k5: [f64; 4] = [7.1, 7.1, 7.1, 7.1]
    if stats.variance(&k5[0], 4) != 0.0 { return 31 }
    // the mean and sort of a vec: sort_vec uses the total order
    stats.sort_vec(&d)
    if at(&d, 0) != 1.0 || at(&d, 3) != 4.0 { return 32 }
    return 0
}
