// expect_exit: 0
import std.rt
import std.env
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_creative
import mc.mc_creative_ui
import mc.mc_creative_rules
import mc.mc_item_src
import mc.mc_raster

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn painted(r: *mut mc_raster.Raster, x0: i32, y0: i32, w: i32, h: i32) -> i32 {
    var n: i32 = 0
    var y: i32 = y0
    while y < y0 + h {
        var x: i32 = x0
        while x < x0 + w {
            if rt.ld32((*r).color, (y as usize) * ((*r).w as usize) + (x as usize)) != 0xFF000000 as u32 { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn dump(r: *mut mc_raster.Raster, name: str) {
    let dir: str = env.get("SPR_DUMP_DIR")
    if dir.length() == 0 { return }
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, "P6\n".p as u64, 3)
    rt.buf_push_dec_u64(&b, (*r).w as u64)
    rt.buf_push(&b, 32)
    rt.buf_push_dec_u64(&b, (*r).h as u64)
    rt.buf_push_bytes(&b, "\n255\n".p as u64, 5)
    var i: usize = 0
    let n: usize = ((*r).w as usize) * ((*r).h as usize)
    while i < n {
        let c: u32 = rt.ld32((*r).color, i)
        rt.buf_push(&b, (c & 255) as u8)
        rt.buf_push(&b, ((c >> 8) & 255) as u8)
        rt.buf_push(&b, ((c >> 16) & 255) as u8)
        i = i + 1
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir.p as u64, dir.length())
    rt.buf_push(&path, 47)
    rt.buf_push_bytes(&path, name.p as u64, name.length())
    rt.buf_push(&path, 0)
    rt.write_file(rt.buf_ptr(&path) as u64, rt.buf_ptr(&b) as u64, rt.buf_len(&b))
    rt.buf_free(&path)
    rt.buf_free(&b)
}

fn main() -> i32 {
    if !env.has("MC_VANILLA_JAR") { return 0 }
    var p: i32 = 763
    if env.has("SPR_NEW") { p = 769 }
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(p, &v), 1)
    var reg: mc_registry.Registry = v.registry_of()
    var cr: mc_creative.Creative = mc_creative.cr_new()
    check(mc_creative.cr_build(&cr, &reg), 2)
    mc_creative.cr_select(&cr, &reg, mc_creative_rules.TAB_BUILDING)
    var src: mc_item_src.ItemSrc = mc_item_src.isrc_new()
    check(mc_item_src.isrc_open(&src, p), 3)
    var u: mc_creative_ui.CrUi = mc_creative_ui.crui_new()
    check(mc_creative_ui.crui_open(&u, &src), 4)
    check(mc_creative_ui.crui_sprites(&u) == env.has("SPR_NEW"), 5)
    var r: mc_raster.Raster = mc_raster.raster_new(500, 400)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_creative_ui.crui_draw(&r, &u, &cr, 40, 60, 2)
    check(painted(&r, 40, 60 - 28 * 2, 26 * 2, 28 * 2) > 1200, 6)
    check(painted(&r, 40 + 176 * 2, 60 + 18 * 2, 12 * 2, 15 * 2) > 200, 7)
    dump(&r, "creative.ppm")
    check(painted(&r, 40 + 27 * 2 * 3, 60 + 132 * 2, 26 * 2, 28 * 2) > 1200, 8)
    return 0
}
