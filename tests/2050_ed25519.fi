// expect_exit: 0
// tests/2050_ed25519.fi -- std.crypto.ed25519 against RFC 8032 section 7.1
// (TEST 1-3, asserted against the RFC literals by the generator), a
// longer message, and the signature of the REAL Fleitec store
// (store.fleitec.com: entry.json + entry.json.sig + oeffentlich.key, copied
// into tests/data/appkit/). The vectors come from Python's `cryptography`
// (tools/appkit/gen_ed25519_vectors.py) -- an Ed25519 nobody here wrote.
//
//   A  public key from a seed (RFC 8032 5.1.5)
//   B  sign == the expected octets (the scheme is deterministic)
//   C  verify accepts the good signature
//   D  verify REFUSES: a flipped bit in the message, in R, in S, in the key,
//      a wrong length key is not even possible here (fixed 32), and a
//      non-canonical S (S + L): a counter-check that the refusal is not
//      a verifier that always says no (A..C pass first).
//   E  the live store's entry.json verifies with its published key, and
//      does not verify with one flipped bit.
import std.rt
import std.crypto.ed25519

// generated by tools/appkit/gen_ed25519_vectors.py -- do not edit by hand
const NVEC: usize = 4
const V0_SEED: str = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
const V0_PUB: str = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
const V0_MSG: str = ""
const V0_SIG: str = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
const V1_SEED: str = "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"
const V1_PUB: str = "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
const V1_MSG: str = "72"
const V1_SIG: str = "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
const V2_SEED: str = "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7"
const V2_PUB: str = "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025"
const V2_MSG: str = "af82"
const V2_SIG: str = "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a"
const V3_SEED: str = "030a11181f262d343b424950575e656c737a81888f969da4abb2b9c0c7ced5dc"
const V3_PUB: str = "755c4cb9256ca7cdc4acfdc6cfeeda849017e5b9f9514e99191bd67e0b0d4276"
const V3_MSG: str = ""
const V3_SIG: str = "ef542b5511666fa0b9c9822aaf556a77dc895c0ba79159e5651c46208c05aa1b09dab2dc32290de9e46e9e489cf7cc66453350c8ba492b583a60bce98006f00c"
// the signature of V0 with S replaced by S+L: same point equation, not canonical
const MALLEABLE_SIG: str = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901554c8c7872aa064e049dbb3013fbf29380d25bf5f0595bbe24655141438e7a101b"

const STORE_ENTRY: str = __include_str("data/appkit/store-entry.json")
const STORE_ENTRY_SIG: str = __include_str("data/appkit/store-entry.json.sig")
const STORE_KEY: str = __include_str("data/appkit/store-oeffentlich.key")

fn nib(c: u8) -> u8 {
    if c >= 97 as u8 { return c - 87 as u8 }
    return c - 48 as u8
}

// hex text -> octets; returns the octet count
fn unhex(s: str, out: u64) -> usize {
    var i: usize = 0
    while i * 2 + 1 < s.n {
        let hi: u8 = nib(rt.ld8(s.p as u64, i * 2))
        let lo: u8 = nib(rt.ld8(s.p as u64, i * 2 + 1))
        rt.st8(out, i, (hi << 4 as u8) | lo)
        i = i + 1
    }
    return i
}

fn flip(p: u64, i: usize) {
    rt.st8(p, i, rt.ld8(p, i) ^ 1 as u8)
}

fn same(a: u64, b: u64, n: usize) -> bool {
    return rt.mem_eq(a, b, n)
}

// checks one vector; returns 0 or an error code (base + step)
fn check(c: *mut ed25519.Ctx, base: i32, seed: str, pubh: str, msgh: str,
    sigh: str) -> i32 {
    var seedb: [u8; 32] = [0; 32]
    var pubb: [u8; 32] = [0; 32]
    var sigb: [u8; 64] = [0; 64]
    var msgb: [u8; 256] = [0; 256]
    unhex(seed, (&seedb[0]) as u64)
    unhex(pubh, (&pubb[0]) as u64)
    unhex(sigh, (&sigb[0]) as u64)
    let mn: usize = unhex(msgh, (&msgb[0]) as u64)
    let mp: u64 = (&msgb[0]) as u64

    // A
    var got: [u8; 32] = [0; 32]
    if !ed25519.ed25519_public(c, (&seedb[0]) as u64, (&got[0]) as u64) {
        return base + 1
    }
    if !same((&got[0]) as u64, (&pubb[0]) as u64, 32) {
        return base + 2
    }
    // B
    var sg: [u8; 64] = [0; 64]
    if !ed25519.ed25519_sign(c, (&seedb[0]) as u64, mp, mn, (&sg[0]) as u64) {
        return base + 3
    }
    if !same((&sg[0]) as u64, (&sigb[0]) as u64, 64) {
        return base + 4
    }
    // C
    if !ed25519.ed25519_verify(c, (&pubb[0]) as u64, mp, mn, (&sigb[0]) as u64) {
        return base + 5
    }
    // D: one flipped bit anywhere is refused
    if mn > 0 {
        flip(mp, mn / 2)
        if ed25519.ed25519_verify(c, (&pubb[0]) as u64, mp, mn, (&sigb[0]) as u64) {
            return base + 6
        }
        flip(mp, mn / 2)
    }
    flip((&sigb[0]) as u64, 3)
    if ed25519.ed25519_verify(c, (&pubb[0]) as u64, mp, mn, (&sigb[0]) as u64) {
        return base + 7
    }
    flip((&sigb[0]) as u64, 3)
    flip((&sigb[0]) as u64, 40)
    if ed25519.ed25519_verify(c, (&pubb[0]) as u64, mp, mn, (&sigb[0]) as u64) {
        return base + 8
    }
    flip((&sigb[0]) as u64, 40)
    flip((&pubb[0]) as u64, 5)
    if ed25519.ed25519_verify(c, (&pubb[0]) as u64, mp, mn, (&sigb[0]) as u64) {
        return base + 9
    }
    flip((&pubb[0]) as u64, 5)
    // and the good one still passes after all the flipping back
    if !ed25519.ed25519_verify(c, (&pubb[0]) as u64, mp, mn, (&sigb[0]) as u64) {
        return base + 10
    }
    return 0
}

fn main() -> i32 {
    var c: ed25519.Ctx = ed25519.ctx_new()
    if !ed25519.ctx_init(&c) {
        return 1
    }
    var r: i32 = check(&c, 100, V0_SEED, V0_PUB, V0_MSG, V0_SIG)
    if r != 0 { return r }
    r = check(&c, 200, V1_SEED, V1_PUB, V1_MSG, V1_SIG)
    if r != 0 { return r }
    r = check(&c, 300, V2_SEED, V2_PUB, V2_MSG, V2_SIG)
    if r != 0 { return r }
    r = check(&c, 400, V3_SEED, V3_PUB, V3_MSG, V3_SIG)
    if r != 0 { return r }

    // D: a non-canonical S (S + L) is refused although [S]B == R + [k]A holds
    var pubb: [u8; 32] = [0; 32]
    var mal: [u8; 64] = [0; 64]
    var none: [u8; 1] = [0; 1]
    unhex(V0_PUB, (&pubb[0]) as u64)
    unhex(MALLEABLE_SIG, (&mal[0]) as u64)
    if ed25519.ed25519_verify(&c, (&pubb[0]) as u64, (&none[0]) as u64, 0,
        (&mal[0]) as u64) {
        return 500
    }

    // E: the real store
    if STORE_KEY.n != 32 || STORE_ENTRY_SIG.n != 64 {
        return 600
    }
    var msg: [u8; 4096] = [0; 4096]
    rt.mem_copy((&msg[0]) as u64, STORE_ENTRY.p as u64, STORE_ENTRY.n)
    if !ed25519.ed25519_verify(&c, STORE_KEY.p as u64, (&msg[0]) as u64,
        STORE_ENTRY.n, STORE_ENTRY_SIG.p as u64) {
        return 601
    }
    flip((&msg[0]) as u64, 100)
    if ed25519.ed25519_verify(&c, STORE_KEY.p as u64, (&msg[0]) as u64,
        STORE_ENTRY.n, STORE_ENTRY_SIG.p as u64) {
        return 602
    }
    return 0
}
