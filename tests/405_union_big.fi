// expect_exit: 0
// Grosses Aggregat (32 Byte): die Fehlerunion laeuft ueber den versteckten
// Rueckgabezeiger (sret, abi.rs) — ohne Aenderung am Codegen.
error E { A }

struct Big { a: i64, b: i64, c: i64, d: i64 }

fn big(n: i64) -> E!Big {
    if n == 0 {
        return E::A
    }
    return Big{ a: n, b: n + 1, c: n + 2, d: n + 3 }
}

fn sum(n: i64) -> E!i64 {
    let g = try big(n)
    return g.a + g.b + g.c + g.d
}

fn main() -> i32 {
    if (sum(1) catch 0 as i64) != 10 as i64 {
        return 1
    }
    if (sum(0) catch 0 as i64 - 4 as i64) != 0 as i64 - 4 as i64 {
        return 2
    }
    return 0
}
