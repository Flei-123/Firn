// expect_exit: 0
// tests/820_iface_kern.fi — SCHNITTSTELLEN UND DYNAMISCHER VERSAND (Runde 46).
//
// Geprueft wird in EINEM Programm, was `interface` in der Sprache ausmacht:
//
//   * eine Aufrufstelle, mehrere Typen: `f.flaeche()` laeuft ueber die
//     Methodentafel, nicht ueber den statischen Typ
//   * `*self` (lesend) und `*mut self` (schreibend) ueber die Schnittstelle —
//     eine Aenderung kommt beim ECHTEN Objekt an
//   * der Schnittstellenwert ist ein gewoehnlicher Wert: Parameter,
//     Rueckgabewert, Feld eines Structs, Element eines Arrays, kopierbar
//   * zwei Schnittstellen fuer denselben Typ
//   * die Methoden bleiben statisch aufrufbar (`r.flaeche()`), und eine
//     gleichnamige freie Funktion steht ungestoert daneben
//   * die Reihenfolge in der Tafel richtet sich nach der Schnittstelle, nicht
//     nach dem `impl`-Block
//
// Jeder Rueckgabewert != 0 nennt die Stelle.

interface Flaeche {
    fn flaeche(*self) -> i64
    fn skaliere(*mut self, k: i64)
}

interface Name {
    fn kennung(*self) -> i64
}

struct Rechteck { b: i64, h: i64 }
struct Kreis { r: i64 }
struct Punkt { x: i64, y: i64 }

// FREIE Funktion `flaeche` — sie heisst wie die Methode und bleibt erreichbar.
fn flaeche(a: i64, b: i64) -> i64 {
    return a * b
}

impl Flaeche for Rechteck {
    fn flaeche(*self) -> i64 { return (*self).b * (*self).h }
    fn skaliere(*mut self, k: i64) {
        (*self).b = (*self).b * k
        (*self).h = (*self).h * k
    }
}

// Die Methoden stehen hier in der UMGEKEHRTEN Reihenfolge der Schnittstelle.
// Die Tafel richtet sich trotzdem nach der Schnittstelle.
impl Flaeche for Kreis {
    fn skaliere(*mut self, k: i64) { (*self).r = (*self).r * k }
    fn flaeche(*self) -> i64 { return 3 * (*self).r * (*self).r }
}

impl Name for Kreis {
    fn kennung(*self) -> i64 { return 7 }
}

impl Name for Rechteck {
    fn kennung(*self) -> i64 { return 4 }
}

// Ein zweiter `impl`-Block fuer denselben Typ, ohne Schnittstelle: erlaubt,
// genau wie in Runde 45.
impl Rechteck {
    fn umfang(*self) -> i64 { return 2 * ((*self).b + (*self).h) }
}

struct Eintrag { was: dyn Flaeche, gewicht: i64 }

fn gesamt(liste: *mut [dyn Flaeche; 3], n: usize) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < n {
        s = s + (*liste)[i].flaeche()
        i = i + 1
    }
    return s
}

fn doppelt(f: dyn Flaeche) -> i64 {
    return f.flaeche() * 2
}

fn erster(a: dyn Flaeche, b: dyn Flaeche) -> dyn Flaeche {
    if a.flaeche() > b.flaeche() {
        return a
    }
    return b
}

fn main() -> i32 {
    var r: Rechteck = Rechteck{ b: 3, h: 4 }
    var k: Kreis = Kreis{ r: 2 }

    // 1. derselbe Aufruf, zwei Typen
    let fr: dyn Flaeche = (&r) as dyn Flaeche
    let fk: dyn Flaeche = (&k) as dyn Flaeche
    if fr.flaeche() != 12 {
        return 1
    }
    if fk.flaeche() != 12 {
        return 2
    }

    // 2. schreibende Methode ueber die Schnittstelle: sie trifft das Objekt
    fk.skaliere(3)
    if k.r != 6 {
        return 3
    }
    if fk.flaeche() != 108 {
        return 4
    }
    fr.skaliere(2)
    if r.b != 6 || r.h != 8 {
        return 5
    }

    // 3. als Argument (Aggregat in zwei Registern)
    if doppelt(fr) != 96 {
        return 6
    }

    // 4. als Rueckgabewert
    let groesser: dyn Flaeche = erster(fr, fk)
    if groesser.flaeche() != 108 {
        return 7
    }

    // 5. Feld eines Structs
    let e: Eintrag = Eintrag{ was: fr, gewicht: 2 }
    if e.was.flaeche() * e.gewicht != 96 {
        return 8
    }

    // 6. Array: eine Schleife, drei Typen
    var r2: Rechteck = Rechteck{ b: 1, h: 5 }
    var feld: [dyn Flaeche; 3] = [fr, fk, (&r2) as dyn Flaeche]
    if gesamt(&feld, 3) != 48 + 108 + 5 {
        return 9
    }

    // 7. zweite Schnittstelle auf denselben Typen
    let nk: dyn Name = (&k) as dyn Name
    let nr: dyn Name = (&r) as dyn Name
    if nk.kennung() != 7 || nr.kennung() != 4 {
        return 10
    }

    // 8. statischer Aufruf derselben Methode — unveraendert moeglich
    if r.flaeche() != 48 {
        return 11
    }
    if r.umfang() != 28 {
        return 12
    }

    // 9. die gleichnamige freie Funktion ist nicht verdeckt
    if flaeche(6, 7) != 42 {
        return 13
    }

    // 10. Kopie eines Schnittstellenwertes zeigt auf dasselbe Objekt
    var kopie: dyn Flaeche = fk
    kopie.skaliere(2)
    if k.r != 12 {
        return 14
    }
    if fk.flaeche() != 432 {
        return 15
    }

    // 11. der Wert ist ZWEI WOERTER gross — Datenzeiger und Methodentafel.
    // Gemessen am Abstand zweier Elemente des Arrays, ohne `size_of`.
    let a0: u64 = (&feld[0]) as u64
    let a1: u64 = (&feld[1]) as u64
    if a1 - a0 != 16 {
        return 16
    }
    return 0
}
