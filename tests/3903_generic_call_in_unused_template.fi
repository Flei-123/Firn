// expect_exit: 0
// firnc1_skip: generic library modules (std.env) are stage 0 only
// tests/3903_generic_call_in_unused_template.fi -- r229: a concrete generic call
// (`vec_len[str]`) inside the body of a generic function that is NEVER
// instantiated must not hide the instance for later users (std.fs remove_tree
// in std.env: "unknown function 'vec_len__str'").
import std.env
import std.vec
import std.testkit

fn never_used[T](p: *mut Vec[str], x: T) -> usize {
    return vec_len[str](p)
}

fn main() -> i32 {
    var v: Vec[str] = vec_new[str]()
    vec_push[str](&v, "a")
    testkit.check(vec_len[str](&v) == 1, "vec_len str")
    vec_free[str](&v)
    return testkit.finish()
}
