// expect_exit: 0
import std.rt
import std.io
import brigadier.mem as mm
import brigadier.text as tx
import brigadier.reader as rd
import brigadier.exc as ex
import brigadier.javanum as jn

fn msg(a: *mut mm.Arena, e: *mut ex.Exc) -> str {
    return tx.u16_to_str(a, ex.exc_message(a, e))
}

fn mk(a: *mut mm.Arena, s: str) -> rd.Reader {
    return rd.reader_new(a, tx.u16_from_str(a, s))
}

fn java_double(a: *mut mm.Arena, x: f64) -> str {
    var b: mm.Arr[u16] = tx.b16_new()
    jn.put_double(a, &b, x)
    return tx.u16_to_str(a, tx.b16_view(&b))
}

fn java_float(a: *mut mm.Arena, x: f32) -> str {
    var b: mm.Arr[u16] = tx.b16_new()
    jn.put_float(a, &b, x)
    return tx.u16_to_str(a, tx.b16_view(&b))
}

fn check(name: str, ok: bool, bad: *mut i32) {
    if !ok {
        io.fmt_print(f"FAIL {name}\n")
        *bad = *bad + 1
    }
}

fn main(start: u64) -> i32 {
    var a: mm.Arena = mm.arena_new()
    var bad: i32 = 0
    var e: ex.Exc = ex.exc_none()
    var iv: i32 = 0
    var r: rd.Reader = mk(&a, "12 abc")
    check("int ok", rd.read_int(&r, &iv, &e) && iv == 12 && r.cursor == 2, &bad)
    r = mk(&a, "1234567890123 x")
    check("int overflow", !rd.read_int(&r, &iv, &e) && r.cursor == 0 && msg(&a, &e) == "Invalid integer '1234567890123' at position 0: <--[HERE]", &bad)
    r = mk(&a, "abc")
    check("int expected", !rd.read_int(&r, &iv, &e) && msg(&a, &e) == "Expected integer at position 0: <--[HERE]", &bad)
    var lv: i64 = 0
    r = mk(&a, "-9223372036854775808")
    check("long min", rd.read_long(&r, &lv, &e) && lv == (0 -% 9223372036854775807) - 1, &bad)
    r = mk(&a, "9223372036854775808")
    check("long overflow", !rd.read_long(&r, &lv, &e) && msg(&a, &e) == "Invalid long '9223372036854775808' at position 0: <--[HERE]", &bad)
    r = mk(&a, "--5")
    check("int double minus", !rd.read_int(&r, &iv, &e), &bad)
    var dv: f64 = 0.0
    r = mk(&a, "-.5")
    check("double", rd.read_double(&r, &dv, &e) && dv == -0.5, &bad)
    r = mk(&a, "1.2.3")
    check("double bad", !rd.read_double(&r, &dv, &e) && msg(&a, &e) == "Invalid double '1.2.3' at position 0: <--[HERE]", &bad)
    r = mk(&a, "-")
    check("double lone minus", !rd.read_double(&r, &dv, &e), &bad)
    var fv: f32 = 0.0
    r = mk(&a, "1.")
    check("float trailing dot", rd.read_float(&r, &fv, &e) && fv == 1.0, &bad)
    var bv: bool = false
    r = mk(&a, "true foo")
    check("bool true", rd.read_bool(&r, &bv, &e) && bv && r.cursor == 4, &bad)
    r = mk(&a, "maybe")
    check("bool bad", !rd.read_bool(&r, &bv, &e) && r.cursor == 0 && msg(&a, &e) == "Invalid bool, expected true or false but found 'maybe' at position 0: <--[HERE]", &bad)
    r = mk(&a, "")
    check("bool expected", !rd.read_bool(&r, &bv, &e) && msg(&a, &e) == "Expected bool at position 0: <--[HERE]", &bad)
    var sv: tx.U16 = tx.u16_empty()
    r = mk(&a, "\"he said \\\"hi\\\" \\\\\" rest")
    check("quoted", rd.read_string(&r, &sv, &e) && tx.u16_to_str(&a, sv) == "he said \"hi\" \\" && r.cursor == 19, &bad)
    r = mk(&a, "\"abc\\n\"")
    check("bad escape", !rd.read_string(&r, &sv, &e) && r.cursor == 5 && msg(&a, &e) == "Invalid escape sequence 'n' in quoted string at position 5: \"abc\\<--[HERE]", &bad)
    r = mk(&a, "'open")
    check("unclosed", !rd.read_string(&r, &sv, &e) && msg(&a, &e) == "Unclosed quoted string at position 5: 'open<--[HERE]", &bad)
    r = mk(&a, "word_1.2-x+y z")
    check("unquoted", rd.read_string(&r, &sv, &e) && tx.u16_to_str(&a, sv) == "word_1.2-x+y" && r.cursor == 12, &bad)
    r = mk(&a, "abcdefghijklmnopq")
    rd.set_cursor(&r, 14)
    check("expect", !rd.expect_char(&r, 33, &e) && msg(&a, &e) == "Expected '!' at position 14: ...efghijklmn<--[HERE]", &bad)
    r = mk(&a, "\u{1F600}a b")
    check("surrogate cursor", rd.read_unquoted(&r).n == 0 && rd.total_length(&r) == 5, &bad)
    check("fmt 1.0", java_double(&a, 1.0) == "1.0", &bad)
    check("fmt 1e7", java_double(&a, 12345678.0) == "1.2345678E7", &bad)
    check("fmt small", java_double(&a, 0.0001234) == "1.234E-4", &bad)
    check("fmt max", java_double(&a, 1.7976931348623157e308) == "1.7976931348623157E308", &bad)
    check("fmt float max", java_float(&a, 3.4028235e38) == "3.4028235E38", &bad)
    check("fmt neg zero", java_double(&a, -0.0) == "-0.0", &bad)
    check("ws", tx.is_java_whitespace(32) && tx.is_java_whitespace(9) && !tx.is_java_whitespace(0xA0), &bad)
    check("ci", tx.u16_cmp_ci(tx.u16_from_str(&a, "Abc"), tx.u16_from_str(&a, "aBd")) < 0, &bad)
    mm.arena_free(&a)
    if bad == 0 {
        io.fmt_print(f"ok\n")
    }
    return bad
}
