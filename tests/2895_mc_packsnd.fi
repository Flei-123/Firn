// expect_exit: 0
// tests/2895_mc_packsnd.fi -- pack sounds: sounds.json + OGG (own test files tests/data/vorbis) -> audio.bank events through mc_audio.
// Packs are built in-process. Checks: events created, two samples of one event, "ns:" names, first pack wins, missing / broken files
// are skipped (counted), bus choice, volume/pitch, sounds=synth does nothing, sounds=both replaces only the named event.
import std.rt
import std.io
import std.fs
import zip.zip
import audio.engine
import audio.bank
import mc.mc_audio
import mc.mc_assets
import mc.mc_packs
import mc.mc_packsnd

struct T {
    fails: i32,
}

fn check(t: *mut T, ok: bool, what: str) {
    if ok {
        io.fmt_print(f"ok   {what}\n")
    } else {
        io.fmt_print(f"FAIL {what}\n")
        (*t).fails = (*t).fails + 1
    }
}

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"

fn add_str(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    var ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

fn add_file(w: *mut zip.ZipWriter, name: str, src: str) -> bool {
    var p: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&p, src.p as u64, src.length())
    rt.buf_push(&p, 0 as u8)
    var d: rt.Buf = rt.buf_new()
    var ok: bool = rt.read_file(rt.buf_ptr(&p), &d)
    if ok { ok = zip.zip_add(w, name, rt.buf_ptr(&d), rt.buf_len(&d), false) catch | e | (false) }
    rt.buf_free(&p)
    rt.buf_free(&d)
    return ok
}

fn finish(w: *mut zip.ZipWriter, b: *mut rt.Buf, stack: *mut mc_assets.PackStack) -> bool {
    var n: usize = zip.zip_finish(w) catch | e | (0)
    zip.zip_writer_free(w)
    if n == 0 { return false }
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&pk, rt.buf_ptr(b), rt.buf_len(b)) != mc_assets.ASSET_OK { return false }
    return mc_assets.stack_push(stack, &pk) == mc_assets.ASSET_OK
}

fn frames_sum(e: *mut engine.Engine) -> u64 {
    var sum: u64 = 0
    var i: usize = 0
    while i < engine.engine_sample_count(e) {
        sum = sum + engine.engine_sample_frames(e, i as i32)
        i = i + 1
    }
    return sum
}

fn near(a: f32, b: f32) -> bool {
    return a > b - 0.002 && a < b + 0.002
}

const OGG_A: str = "tests/data/vorbis/sine_m22k_q3.ogg"
const OGG_B: str = "tests/data/vorbis/impulse_m44k_q4.ogg"

#[allow_escape]
fn main(start: u64) -> i32 {
    var t: T = T { fails: 0 }
    var e: engine.Engine = engine.engine_new(48000 as u32, 64 as u32)
    var b: bank.Bank = bank.bank_new()
    var m: mc_audio.McAudio = mc_audio.mca_new(&e)
    var stack: mc_assets.PackStack = mc_assets.stack_new()

    // top pack: two events, one with two samples + volume/pitch, one with a namespace path, one with a missing file, one broken entry
    var b1: rt.Buf = rt.buf_new()
    var w1: zip.ZipWriter = zip.zip_writer_new(&b1)
    var ok: bool = add_str(&w1, "pack.mcmeta", META)
    ok = add_str(&w1, "assets/minecraft/sounds.json", "{\"block.stone.step\":{\"sounds\":[{\"name\":\"custom/a\",\"volume\":0.5,\"pitch\":1.5},\"custom/b\"]},\"ui.button.click\":{\"sounds\":[\"minecraft:custom/b\"]},\"entity.cow.moo\":{\"sounds\":[\"custom/missing\"]},\"entity.pig.say\":{\"sounds\":[{\"volume\":1}]},\"music.menu\":{\"sounds\":[\"custom/a\"]},\"block.gravel.step\":{\"replace\":true,\"sounds\":[\"custom/b\"]},\"block.sand.step\":{\"sounds\":[\"custom/a\",{\"name\":\"x\",\"type\":\"event\"}]},\"bad.event\":5}") && ok
    ok = add_file(&w1, "assets/minecraft/sounds/custom/a.ogg", OGG_A) && ok
    ok = add_file(&w1, "assets/minecraft/sounds/custom/b.ogg", OGG_B) && ok
    ok = finish(&w1, &b1, &stack) && ok
    check(&t, ok, "pack 1 built")

    // lower pack: redefines block.stone.step (must lose) and adds block.wood.step; its sounds.json holds a path escape attempt
    var b2: rt.Buf = rt.buf_new()
    var w2: zip.ZipWriter = zip.zip_writer_new(&b2)
    var ok2: bool = add_str(&w2, "pack.mcmeta", META)
    ok2 = add_str(&w2, "assets/minecraft/sounds.json", "{\"block.stone.step\":{\"sounds\":[\"low/c\"]},\"block.wood.step\":{\"sounds\":[\"low/c\"]},\"block.gravel.step\":{\"sounds\":[\"low/c\"]},\"block.sand.step\":{\"sounds\":[\"low/c\",\"custom/a\"]},\"evil\":{\"sounds\":[\"../x\"]}}") && ok2
    ok2 = add_file(&w2, "assets/minecraft/sounds/low/c.ogg", OGG_B) && ok2
    ok2 = finish(&w2, &b2, &stack) && ok2
    check(&t, ok2, "pack 2 built")

    var text: rt.Buf = rt.buf_new()
    let st: mc_packsnd.PackSnd = mc_packsnd.packsnd_build_text(&stack, &e, &b, &text)
    check(&t, st.events == 6, "6 events: stone.step, ui click, music.menu, gravel, sand, wood.step")
    check(&t, st.files == 3, "3 distinct files decoded (custom/a, custom/b, low/c)")
    check(&t, st.skipped_events >= 3, "missing file, no name, non-object skipped")
    check(&t, st.skipped_files >= 2, "missing and unsafe file names counted")

    // load through mc_audio (mode both)
    let n: i32 = mc_packsnd.packsnd_apply(&m, &b, &e, &stack, mc_packs.SOUNDS_BOTH)
    check(&t, n == 6, "packsnd_apply returns 6")
    let ev1: i32 = engine.engine_find_event(&e, "block.stone.step")
    let ev2: i32 = engine.engine_find_event(&e, "ui.button.click")
    let ev3: i32 = engine.engine_find_event(&e, "music.menu")
    let ev4: i32 = engine.engine_find_event(&e, "block.wood.step")
    check(&t, ev1 >= 0 && ev2 >= 0 && ev3 >= 0 && ev4 >= 0, "events exist in the engine")
    check(&t, engine.engine_find_event(&e, "entity.cow.moo") < 0 && engine.engine_find_event(&e, "evil") < 0, "unusable events do not exist")
    let d1: *mut engine.EventDef = engine.engine_event(&e, ev1)
    check(&t, (*d1).sample_n == 3, "stone.step: vanilla merge = 2 (top) + 1 (lower pack)")
    check(&t, (*d1).volume == 1.0 && (*d1).pitch == 1.0, "event-level volume / pitch stay 1.0 (factors are per entry)")
    check(&t, near(engine.engine_event_slot_volume(&e, ev1, 0), 0.5) && near(engine.engine_event_slot_pitch(&e, ev1, 0), 1.5), "slot 0 (custom/a): volume 0.5 / pitch 1.5")
    check(&t, near(engine.engine_event_slot_volume(&e, ev1, 1), 1.0) && near(engine.engine_event_slot_pitch(&e, ev1, 1), 1.0) && near(engine.engine_event_slot_volume(&e, ev1, 2), 1.0), "other entries keep 1.0 / 1.0")
    check(&t, engine.engine_bus_id(&e, "ui") == (*engine.engine_event(&e, ev2)).bus, "ui.* on the ui bus")
    check(&t, engine.engine_bus_id(&e, "music") == (*engine.engine_event(&e, ev3)).bus, "music.* on the music bus")
    check(&t, engine.engine_bus_id(&e, "sfx") == (*engine.engine_event(&e, ev4)).bus, "other events on the sfx bus")
    check(&t, (*engine.engine_event(&e, ev4)).sample_n == 1, "wood.step from the lower pack")
    let evg: i32 = engine.engine_find_event(&e, "block.gravel.step")
    let evs: i32 = engine.engine_find_event(&e, "block.sand.step")
    check(&t, evg >= 0 && (*engine.engine_event(&e, evg)).sample_n == 1, "gravel: replace=true cuts the lower pack (1 sample)")
    check(&t, evs >= 0 && (*engine.engine_event(&e, evs)).sample_n == 2, "sand: merged, duplicate file once, type=event ignored (2 samples)")
    check(&t, st.reused == 0 && st.decoded == 3 && st.replaced == 0, "first apply: 3 decoded, nothing reused")
    let h: u32 = mc_audio.mca_play_ui(&m, "ui.button.click", 1.0, 1.0)
    check(&t, h != 0 as u32, "the pack event plays")

    // block sound type fallback (mc_audio.mca_find): unknown types map to the nearest material event
    check(&t, mc_audio.mca_find(&m, "block.cherry_wood.step") == ev4 && mc_audio.mca_find(&m, "minecraft:block.bamboo_wood.step") == ev4, "fallback: cherry_wood -> wood")
    check(&t, mc_audio.mca_find(&m, "block.tuff.step") == ev1 && mc_audio.mca_find(&m, "block.stone.step") == ev1, "fallback: tuff -> stone, exact name wins")
    check(&t, mc_audio.mca_find(&m, "block.cherry_wood.nothing") < 0 && mc_audio.mca_find(&m, "entity.nothing.hurt") < 0 && mc_audio.mca_find(&m, "block.x") < 0, "fallback: unknown action / non-block = missing")

    // hot reload: same packs again -> no new samples, no new events, all reused
    let ns0: usize = engine.engine_sample_count(&e)
    let ne0: usize = engine.engine_event_count(&e)
    var text2: rt.Buf = rt.buf_new()
    let st2: mc_packsnd.PackSnd = mc_packsnd.packsnd_build_text(&stack, &e, &b, &text2)
    check(&t, st2.reused == 3 && st2.decoded == 0, "reload: 3 files reused by hash, 0 decoded")
    check(&t, mc_packsnd.packsnd_apply(&m, &b, &e, &stack, mc_packs.SOUNDS_BOTH) == 6, "reload: apply returns 6")
    check(&t, engine.engine_sample_count(&e) == ns0 && engine.engine_event_count(&e) == ne0, "reload: sample and event tables did not grow (no leak)")
    check(&t, mc_audio.mca_play_ui(&m, "ui.button.click", 1.0, 1.0) != 0 as u32, "reload: the event still plays")
    // changed file under the same path: new content takes over the old slot, the table does not grow
    let fr0: u64 = frames_sum(&e)
    var p1: mc_assets.PackStack = mc_assets.stack_new()
    var b5: rt.Buf = rt.buf_new()
    var w5: zip.ZipWriter = zip.zip_writer_new(&b5)
    var ok5: bool = add_str(&w5, "pack.mcmeta", META)
    ok5 = add_str(&w5, "assets/minecraft/sounds.json", "{\"ui.button.click\":{\"sounds\":[\"custom/b\"]}}") && ok5
    ok5 = add_file(&w5, "assets/minecraft/sounds/custom/b.ogg", OGG_A) && ok5 // was OGG_B in the first run
    ok5 = finish(&w5, &b5, &p1) && ok5
    let st3: mc_packsnd.PackSnd = mc_packsnd.packsnd_build_text(&p1, &e, &b, &text2)
    check(&t, ok5 && st3.decoded == 1 && st3.replaced == 1, "changed file: decoded once, took over the old slot")
    check(&t, engine.engine_sample_count(&e) == ns0, "changed file: sample table did not grow")
    check(&t, frames_sum(&e) != fr0, "changed file: the old slot holds the new PCM")

    // sounds=synth does nothing; no packs = 0
    var m2: mc_assets.PackStack = mc_assets.stack_new()
    check(&t, mc_packsnd.packsnd_apply(&m, &b, &e, &stack, mc_packs.SOUNDS_SYNTH) == 0, "sounds=synth: nothing read")
    check(&t, mc_packsnd.packsnd_apply(&m, &b, &e, &m2, mc_packs.SOUNDS_ORIGINAL) == 0, "no packs: nothing")

    // a pack with garbage sounds.json / garbage OGG must not crash
    var b3: rt.Buf = rt.buf_new()
    var w3: zip.ZipWriter = zip.zip_writer_new(&b3)
    var ok3: bool = add_str(&w3, "pack.mcmeta", META)
    ok3 = add_str(&w3, "assets/minecraft/sounds.json", "{\"x.y\":{\"sounds\":[\"g\"]},\"trunc") && ok3
    ok3 = finish(&w3, &b3, &m2) && ok3
    check(&t, ok3 && mc_packsnd.packsnd_apply(&m, &b, &e, &m2, mc_packs.SOUNDS_BOTH) == 0, "garbage sounds.json: no event, no crash")
    var b4: rt.Buf = rt.buf_new()
    var w4: zip.ZipWriter = zip.zip_writer_new(&b4)
    var ok4: bool = add_str(&w4, "pack.mcmeta", META)
    ok4 = add_str(&w4, "assets/minecraft/sounds.json", "{\"x.y\":{\"sounds\":[\"g\"]}}") && ok4
    ok4 = add_str(&w4, "assets/minecraft/sounds/g.ogg", "OggS this is not a vorbis stream at all") && ok4
    var m3: mc_assets.PackStack = mc_assets.stack_new()
    ok4 = finish(&w4, &b4, &m3) && ok4
    check(&t, ok4 && mc_packsnd.packsnd_apply(&m, &b, &e, &m3, mc_packs.SOUNDS_BOTH) == 0, "garbage OGG: event skipped, no crash")

    io.fmt_print(f"failures: {t.fails}\n")
    return t.fails
}
