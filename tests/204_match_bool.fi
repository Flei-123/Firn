// expect_exit: 13
// match over bool and over a binding of the whole value.
fn value(b: bool) -> i32 {
    var r: i32 = 0
    match b {
        true => { r = 4 as i32 }
        false => { r = 5 as i32 }
    }
    return r
}

fn main() -> i32 {
    var sum: i32 = 0
    sum = sum + value(true)
    sum = sum + value(false)
    let n: i32 = 4
    match n {
        0 => { sum = sum + 100 as i32 }
        k => { sum = sum + k }
    }
    return sum
}
