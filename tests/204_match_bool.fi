// expect_exit: 13
// match ueber bool und ueber eine Bindung des ganzen Wertes.
fn wert(b: bool) -> i32 {
    var r: i32 = 0
    match b {
        true => { r = 4 as i32 }
        false => { r = 5 as i32 }
    }
    return r
}

fn main() -> i32 {
    var summe: i32 = 0
    summe = summe + wert(true)
    summe = summe + wert(false)
    let n: i32 = 4
    match n {
        0 => { summe = summe + 100 as i32 }
        k => { summe = summe + k }
    }
    return summe
}
