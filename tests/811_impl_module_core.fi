// expect_exit: 0
// tests/811_impl_module_core.fi — Methoden UEBER DIE MODULGRENZE (Runde 45).
//
// `tests/modules/geo.fi` deklariert `Rechteck` samt Methoden. Hier wird der
// Typ ueber `geo.Rechteck` benutzt und die Methode OHNE Modulnamen gerufen:
// `r.flaeche()`. Das ist kein Zufall, sondern die Regel — eine Methode
// gehoert zum TYP, und der Typ traegt sein Modul bereits im Namen
// (`geo__Rechteck` -> `geo__Rechteck__flaeche`).
//
// Ebenfalls geprueft: dass ein zweiter `impl`-Block fuer denselben Typ
// erlaubt ist und dass eine freie Funktion `einheit()` neben der Methode
// `Rechteck.einheit()` bestehen bleibt.
import modules.geo

fn main() -> i32 {
    var r: geo.Rect = geo.new(1, 2, 3, 4)
    if r.area() != 12 {
        return 1
    }
    if r.extent() != 14 {
        return 2
    }
    if r.corner_sum() != 3 {
        return 3
    }
    if r.is_square() {
        return 4
    }
    // schreibende Methode, die ihrerseits eine Methode aufruft
    r.shift(10, 20)
    if r.corner_sum() != 33 {
        return 5
    }
    // Methode auf dem Ergebnis einer Modulfunktion (an eine Variable gebunden)
    var q: geo.Rect = geo.square(5)
    if !q.is_square() {
        return 6
    }
    if q.area() != 25 {
        return 7
    }
    // freie Funktion und Methode gleichen Namens
    if geo.unit() != 1 {
        return 8
    }
    if q.unit() != 6 {
        return 9
    }
    // Methode auf einem Feld eines Modultyps
    if r.corner.sum() != 33 {
        return 10
    }
    // Empfaenger ueber einen Zeiger
    let z: *mut geo.Rect = &q
    if z.area() != 25 {
        return 11
    }
    z.shift(1, 1)
    if q.corner.sum() != 2 {
        return 12
    }
    return 0
}
