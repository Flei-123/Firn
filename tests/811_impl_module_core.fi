// expect_exit: 0
// tests/811_impl_module_core.fi -- methods ACROSS THE MODULE BOUNDARY (round 45).
//
// `tests/modules/geo.fi` declares `Rect` together with its methods. Here the
// type is used through `geo.Rect` and the method is called WITHOUT the
// module name: `r.area()`. That is no accident but the rule -- a method
// belongs to the TYPE, and the type already carries its module in its name
// (`geo__Rect` -> `geo__Rect__area`).
//
// Checked on top of that: that a second `impl` block for the same type is
// allowed and that a free function `unit()` keeps existing next to the method
// `Rect.unit()`.
import modules.geo

fn main() -> i32 {
    var r: geo.Rect = geo.new(1, 2, 3, 4)
    if r.area() != 12 {
        return 1
    }
    if r.extent() != 14 {
        return 2
    }
    if r.corner_sum() != 3 {
        return 3
    }
    if r.is_square() {
        return 4
    }
    // a writing method that calls a method itself
    r.shift(10, 20)
    if r.corner_sum() != 33 {
        return 5
    }
    // method on the result of a module function (bound to a variable)
    var q: geo.Rect = geo.square(5)
    if !q.is_square() {
        return 6
    }
    if q.area() != 25 {
        return 7
    }
    // free function and method of the same name
    if geo.unit() != 1 {
        return 8
    }
    if q.unit() != 6 {
        return 9
    }
    // method on a field of a module type
    if r.corner.sum() != 33 {
        return 10
    }
    // receiver through a pointer
    let z: *mut geo.Rect = &q
    if z.area() != 25 {
        return 11
    }
    z.shift(1, 1)
    if q.corner.sum() != 2 {
        return 12
    }
    return 0
}
