// expect_exit: 101
// not_mode: opt
// only_target: x86_64
// r904 (SPEC 5.2 L12): unbounded recursion ends with "firn: stack overflow" and exit code 101, not a silent SIGSEGV. release-fast has no guard.
fn f(n: u64) -> u64 {
    var pad: [u64; 64] = [0; 64]
    pad[(n % 64) as usize] = n
    return f(n + 1) + pad[0]
}

fn main() -> i32 {
    return f(0) as i32
}
