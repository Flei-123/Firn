// expect_out: 12 160 1
// ROUND OPENPLAN-R73 -- flat module names: `lib/svg/stroke.fi` (the dash
// and outline code of the SVG painter) is now `lib/svg/dash.fi`, so one
// program can import it together with `paint.stroke`. Firn addresses a
// module by the LAST segment of its path; before the rename both files were
// the module `stroke` and the program did not build.
//
// The program uses both: an SVG whose line is dashed (svg -> dash) and a
// `paint.stroke` line. The dashed 20x4 line `4 4` covers three dashes of
// four columns, 12 of 20 columns are dark; the butt line 40 x 4 has the
// area 160 (as in tests/1631_stroke_outline.fi).
import std.io
import std.rt
import paint.stroke
import paint.png
import font.raster
import html.mem
import svg.svgimage
import svg.dash

fn dashed_columns() -> i64 {
    var svg: [u8; 159] = "<svg xmlns='http://www.w3.org/2000/svg' width='20' height='4'><line x1='0' y1='2' x2='20' y2='2' stroke='black' stroke-width='4' stroke-dasharray='4 4'/></svg>"
    var im: png.Image = png.image_new()
    if !svgimage.svg_to_image((&svg[0]) as u64, 159, &im, 0 as u64) {
        return -1
    }
    var dark: i64 = 0
    var x: usize = 0
    while x < png.image_width(&im) {
        // the middle row of the image
        let v: u32 = png.image_pixel(&im, x, 2)
        if (v >> 24) > 127 as u32 {
            dark = dark + 1
        }
        x = x + 1
    }
    png.image_free(&im)
    return dark
}

fn butt_area() -> i64 {
    var r: raster.Raster = raster.raster_new()
    let need: usize = raster.raster_bytes_needed(80, 80)
    let rm: *mut u8 = mem.heap_alloc(need)
    if rm as usize == 0 {
        return -1
    }
    raster.raster_attach(&r, rm, need)
    var s: stroke.Stroke = stroke.stroke_new()
    let sn: usize = stroke.stroke_bytes_needed(64)
    let sm: *mut u8 = mem.heap_alloc(sn)
    if sm as usize == 0 {
        return -2
    }
    stroke.stroke_attach(&s, sm, sn)
    stroke.stroke_set_width(&s, 4.0)
    stroke.stroke_set_cap(&s, stroke.CAP_BUTT)
    raster.raster_begin(&r, 0.0, 0.0, 80, 80)
    stroke.stroke_begin(&s, false)
    stroke.stroke_point(&s, 20.0, 40.0)
    stroke.stroke_point(&s, 60.0, 40.0)
    stroke.stroke_end(&s, &r)
    raster.raster_finish(&r)
    var sum: f64 = 0.0
    var y: usize = 0
    while y < 80 {
        var x: usize = 0
        while x < 80 {
            sum = sum + raster.raster_cov(&r, x, y)
            x = x + 1
        }
        y = y + 1
    }
    return (sum + 0.5) as i64
}

fn main() -> i32 {
    if !gc_init() {
        return 1
    }
    let a: i64 = dashed_columns()
    let b: i64 = butt_area()
    io.fmt_print_line(f"{a} {b} 1")
    return 0
}
