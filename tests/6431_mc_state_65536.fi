// expect_exit: 0
import std.rt
import mc.mc_chunk
import mc.mc_mesh
import mc.mc_texture
import mc.mc_version
import mc.mc_versions
import mc.mc_registry

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn all_faces(t: *mut mc_mesh.MeshTables, st: usize) -> bool {
    var f: usize = 0
    while f < 6 {
        if rt.ld16((*t).tiles, st * 6 + f) == 0 as u16 { return false }
        f = f + 1
    }
    return true
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(777, &v), 1)
    var r: mc_registry.Registry = v.registry_of()
    check(mc_registry.registry_ok(&r), 2)
    let ns: i32 = mc_registry.reg_state_count(&r)
    check(ns > 32768, 3)
    var t: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&t)
    mc_texture.tex_build_tables(&r, &t)
    var drawn: i32 = 0
    var solid_state: usize = 0
    var s: i32 = 32768
    while s < ns {
        if all_faces(&t, s as usize) {
            drawn = drawn + 1
            if solid_state == 0 && (rt.ld8(t.opaque, s as usize) & 1 as u8) != 0 as u8 { solid_state = s as usize }
        }
        s = s + 1
    }
    check(drawn > 0, 4)
    check(solid_state != 0, 5)

    var m: mc_mesh.Mesher = mc_mesh.mesher_new()
    let ids: u64 = rt.heap_alloc(4096 * 2)
    var i: usize = 0
    while i < 4096 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    rt.st16(ids, (8 * 16 + 8) * 16 + 8, solid_state as u16)
    var sec: mc_chunk.Section = mc_chunk.Section { count: 0, blocks: mc_chunk.Container { bits: 0 as u32, pal_n: 0 as u32, pal: 0, data: 0, words: 0 }, biomes: mc_chunk.Container { bits: 0 as u32, pal_n: 0 as u32, pal: 0, data: 0, words: 0 } }
    check(mc_mesh.section_pack(ids, &sec), 6)
    let none: u64 = rt.heap_alloc(48)
    i = 0
    while i < 6 {
        rt.st64(none, i, 0 as u64)
        i = i + 1
    }
    mc_mesh.mesh_section(&m, &sec, none, mc_mesh.MISSING_AIR, &t, mc_mesh.F_GREEDY | mc_mesh.F_AO)
    check(m.nquads == 6 as u32, 7)
    mc_mesh.section_free(&sec)
    rt.heap_free(ids, 4096 * 2)
    mc_texture.tex_free_tables(&t)
    rt.finish(0 as i64)
    return 0
}
