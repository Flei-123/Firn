// expect_exit: 42
// Round GAPS: `x as% T` -- the narrowing conversion that is never checked
// (docs/LUECKEN.md B12). A plain `300 as u8` panics on dev-fast,
// release-safe and --no-opt; `as%` keeps the low bits on every level.
const LOW: u8 = 0x1234 as% u8

fn low_byte(w: u32) -> u8 {
    return w as% u8
}

fn as_signed(bits: u32) -> i32 {
    return bits as% i32
}

fn main() -> i32 {
    if low_byte(300 as u32) != 44 { return 1 as i32 }
    if as_signed(0xffffffff as u32) != -1 { return 2 as i32 }
    let n: i64 = -1
    if n as% u16 != 65535 { return 3 as i32 }
    if LOW != 0x34 { return 4 as i32 }
    // a value that fits is unchanged, and the result takes part in
    // arithmetic like any other u8 (the literal gets its type from it)
    let k: u64 = 7
    if (k as% u8) + 1 != 8 { return 5 as i32 }
    // widening through as% is just as
    let b: u8 = 200
    if b as% u32 != 200 { return 6 as i32 }
    // the hash use: multiply, keep the low 32 bits
    let h: u64 = 0x9e3779b97f4a7c15
    let h32: u32 = (h *% 3) as% u32
    if h32 != ((h *% 3) & 0xffffffff) as u32 { return 7 as i32 }
    return 42
}
