// expect_exit: 0
import std.rt
import mc.mc_inv_drag

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn main() -> i32 {
    var d: mc_inv_drag.InvDrag = mc_inv_drag.idrag_new()
    check(mc_inv_drag.idrag_release(&d) == mc_inv_drag.REL_NONE, 1)
    mc_inv_drag.idrag_press(&d, 0, 10)
    check(mc_inv_drag.idrag_hover(&d, 10) == mc_inv_drag.EV_NONE, 2)
    check(mc_inv_drag.idrag_release(&d) == mc_inv_drag.REL_CLICK, 3)
    mc_inv_drag.idrag_press(&d, 1, 10)
    check(mc_inv_drag.idrag_hover(&d, 0 - 1) == mc_inv_drag.EV_NONE, 4)
    check(mc_inv_drag.idrag_hover(&d, 11) == mc_inv_drag.EV_BEGIN, 5)
    check(mc_inv_drag.idrag_dragging(&d), 6)
    check(mc_inv_drag.idrag_type(&d) == 1, 7)
    check(mc_inv_drag.idrag_hover(&d, 11) == mc_inv_drag.EV_NONE, 8)
    check(mc_inv_drag.idrag_hover(&d, 10) == mc_inv_drag.EV_NONE, 9)
    check(mc_inv_drag.idrag_hover(&d, 12) == mc_inv_drag.EV_ADD, 10)
    check(mc_inv_drag.idrag_release(&d) == mc_inv_drag.REL_END, 11)
    check(!mc_inv_drag.idrag_held(&d), 12)
    mc_inv_drag.idrag_press(&d, 0, 5)
    check(mc_inv_drag.idrag_type(&d) == 0, 13)
    check(mc_inv_drag.idrag_hover(&d, 6) == mc_inv_drag.EV_BEGIN, 14)
    return 0
}
