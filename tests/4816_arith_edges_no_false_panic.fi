// expect_exit: 0
// r903 r914: values next to the edges are fine in every level: -x of a normal value, the literal -128 for an i8,
// a shift by width - 1 with a count of any integer type, a division by -1 that does not overflow.
fn neg8(x: i8) -> i8 {
    return -x
}

fn shl_u8(x: u32, s: u8) -> u32 {
    return x << s
}

fn shr_i64(x: i32, s: i64) -> i32 {
    return x >> s
}

fn shl_u64(x: u64, s: u64) -> u64 {
    return x << s
}

fn main() -> i32 {
    let a: i8 = -127
    let lit: i8 = -128
    if neg8(a) != 127 { return 1 }
    if lit != -128 { return 2 }
    if shl_u8(1, 31) != 2147483648 { return 3 }
    if shr_i64(-8, 31) != -1 { return 4 }
    if shl_u64(1, 63) == 0 { return 5 }
    if shl_u8(3, 0) != 3 { return 6 }
    var x: u16 = 1
    var s: u16 = 15
    x <<= s
    if x != 32768 { return 7 }
    var d: i32 = -2147483647
    var m: i32 = -1
    if d / m != 2147483647 { return 8 }
    if -d != 2147483647 { return 9 }
    return 0
}
