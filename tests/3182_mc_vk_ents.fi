// expect_exit: 0
// mc.vk_mc entities (lavapipe, NO real GPU): b.draw_entities draws box records as one instanced cube draw. The front face of a red
// box in front of the camera has colour * 153 / 256 per channel, the world quad in front of a second box hides it (depth test), a box
// behind the camera draws nothing. SKIP (exit 0) without a Vulkan device.
import std.rt
import std.io
import mc.mc_backend
import mc.mc_camera
import mc.mc_texture
import mc.vk_mc

const W: i32 = 96
const H: i32 = 64

fn check(fails: *mut i32, what: str, ok: bool) {
    if ok {
        io.fmt_print(f"   ok   {what}\n")
    } else {
        io.fmt_print(f"   FAIL {what}\n")
        *fails = *fails + 1
    }
}

fn stf(p: u64, i: usize, v: f64) {
    *((p + (i as u64) * (8 as u64)) as *mut f64) = v
}

fn ent_rec(recs: u64, i: usize, x: f64, y: f64, z: f64, sx: f64, sy: f64, sz: f64, r: u32, g: u32, b: u32) {
    let e: u64 = recs + (i * mc_backend.ENT_BYTES) as u64
    stf(e, 0, x)
    stf(e, 1, y)
    stf(e, 2, z)
    stf(e, 3, sx)
    stf(e, 4, sy)
    stf(e, 5, sz)
    stf(e, 6, 0.0)
    stf(e, 7, 1.0)
    stf(e, 8, r as f64)
    stf(e, 9, g as f64)
    stf(e, 10, b as f64)
    stf(e, 11, 0.0)
}

fn px(p: u64, x: i32, y: i32) -> u32 {
    return rt.ld32(p, (y * W + x) as usize)
}

fn main() -> i32 {
    var vb: vk_mc.VkBackend = vk_mc.vkbe_open(W, H)
    if !vb.ok {
        io.fmt_print(f"SKIP vkbe_open step={vb.step}\n")
        return 0
    }
    var bg: mc_backend.Backend = vk_mc.vkbe_backend(&vb)
    var ta: mc_texture.Atlas = mc_texture.atlas_default()
    bg.upload_atlas(bg.obj, (&ta) as u64)
    var cam: mc_camera.Camera = mc_camera.camera_new(W, H)
    mc_camera.camera_set_pos(&cam, 8.0, 8.0, 0.0)
    mc_camera.camera_set_angles(&cam, 0.0, 0.0)
    mc_camera.camera_update(&cam)
    let clear: u32 = 0xFF302010 as u32
    var fails: i32 = 0
    let recs: u64 = rt.heap_alloc(4 * mc_backend.ENT_BYTES)

    // one red box straight ahead, one blue box behind the camera
    ent_rec(recs, 0, 8.0, 8.0, 6.0, 2.0, 2.0, 2.0, 200 as u32, 80 as u32, 40 as u32)
    ent_rec(recs, 1, 8.0, 8.0, 0.0 - 6.0, 2.0, 2.0, 2.0, 40 as u32, 80 as u32, 200 as u32)
    bg.begin(bg.obj, (&cam) as u64, clear)
    let drawn: u64 = bg.draw_entities(bg.ent_obj, recs, 2)
    bg.end(bg.obj)
    let p: u64 = bg.present(bg.obj)
    check(&fails, "draw_entities returns the box count", drawn == 2 as u64)
    check(&fails, "frame returned", p != 0 as u64)
    if p != 0 as u64 {
        check(&fails, "front face = colour * 153 / 256 (red box)", px(p, W / 2, H / 2) == 0xFF172F77 as u32)
        check(&fails, "outside the box = clear", px(p, 2, 2) == clear && px(p, W - 3, H - 3) == clear)
        var blue: u64 = 0
        var i: usize = 0
        while i < ((W * H) as usize) {
            let v: u32 = rt.ld32(p, i)
            if (v >> 16 as u32) & 255 as u32 > 150 as u32 { blue = blue + 1 as u64 }
            i = i + 1
        }
        check(&fails, "box behind the camera draws nothing", blue == 0 as u64)
    }

    // empty list and a frame afterwards without entities
    bg.begin(bg.obj, (&cam) as u64, clear)
    let none: u64 = bg.draw_entities(bg.ent_obj, recs, 0)
    bg.end(bg.obj)
    let pe: u64 = bg.present(bg.obj)
    check(&fails, "no records = nothing drawn", none == 0 as u64 && pe != 0 as u64 && px(pe, W / 2, H / 2) == clear)

    vk_mc.vkbe_close(&vb)
    if fails != 0 {
        io.fmt_print(f"FAIL {fails}\n")
        return 1
    }
    io.print("vk_mc ents ok\n")
    return 0
}
