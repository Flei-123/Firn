// expect_exit: 0
import std.rt
import mc.mc_camera
import mc.mc_math

static mut SEED: u64 = 12345

fn rnd(lo: f64, hi: f64) -> f64 {
    SEED = SEED *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
    return lo + (hi - lo) * (((SEED >> 33 as u64) % 100000 as u64) as f64 / 100000.0)
}

fn main() -> i32 {
    var cam: mc_camera.Camera = mc_camera.camera_new(640, 360)
    var cf: mc_math.SectionFrustum = mc_math.SectionFrustum { v: [0.0; 30] }
    var zero_diff: i32 = 0
    var class_diff: i32 = 0
    var column_bad: i32 = 0
    var total: i32 = 0
    var pose: i32 = 0
    while pose < 40 {
        mc_camera.camera_set_lens(&cam, rnd(40.0, 110.0), 0.05, rnd(100.0, 400.0))
        mc_camera.camera_set_pos(&cam, rnd(-200.0, 200.0), rnd(-60.0, 200.0), rnd(-200.0, 200.0))
        mc_camera.camera_set_angles(&cam, rnd(-180.0, 180.0), rnd(-89.0, 89.0))
        mc_camera.camera_update(&cam)
        mc_math.box_frustum_prepare(&cam.frustum, &cf, 8.0, 192.0, 8.0)
        var cz: i32 = -12
        while cz <= 12 {
            var cx: i32 = -12
            while cx <= 12 {
                var col_out: bool = mc_math.box_frustum_test(&cf, (cx * 16) as f64, -64.0, (cz * 16) as f64) == 0
                var sy: i32 = 0
                while sy < 24 {
                    let a: i32 = mc_math.frustum_test_section(&cam.frustum, cx, sy, cz, -64)
                    let b: i32 = mc_camera.camera_section_visible(&cam, cx, sy, cz, -64)
                    total = total + 1
                    if (a == 0) != (b == 0) { zero_diff = zero_diff + 1 }
                    if a != b { class_diff = class_diff + 1 }
                    if col_out && a != 0 { column_bad = column_bad + 1 }
                    sy = sy + 1
                }
                cx = cx + 1
            }
            cz = cz + 1
        }
        pose = pose + 1
    }
    if total < 500000 { return 1 }
    if zero_diff != 0 { return 2 }
    if class_diff > 20 { return 3 }
    if column_bad != 0 { return 4 }
    return 0
}
