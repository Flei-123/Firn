// expect_exit: 0
struct Calc { total: i32 }

enum Op { Add(i32), Sub(i32) }

impl Calc {
    fn Add(*mut self, n: i32) { self.total = self.total + n }
    fn Count(*self) -> i32 { return self.total }
}

fn Sum(a: i32, b: i32) -> i32 { return a + b }

fn main() -> i32 {
    var c = Calc { total: 0 }
    c.Add(5)
    c.Add(6)
    let op = Op::Add(1)
    var bad: i32 = 0
    if c.Count() != 11 { bad = bad + 1 }
    if Sum(2, 3) != 5 { bad = bad + 1 }
    match op {
        Op::Add(n) => { if n != 1 { bad = bad + 1 } }
        Op::Sub(n) => { bad = bad + 1 }
    }
    return bad
}
