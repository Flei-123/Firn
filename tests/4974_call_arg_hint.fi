// expect_exit: 0
fn fib(n: u32) -> u64 {
    if n < 2 {
        return n as u64
    }
    return fib(n - 1) + fib(n - 2)
}

fn mix(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64) -> u64 {
    return a + b * 3 + c * 5 + d * 7 + e * 11 + f * 13 + g * 17 + h * 19
}

fn swap2(a: u64, b: u64) -> u64 {
    return a * 1000 + b
}

fn chain(x: u64, y: u64) -> u64 {
    let p: u64 = x + 1
    let q: u64 = y + 2
    let r: u64 = swap2(q, p)
    let s: u64 = swap2(p, q)
    return r * 3 + s + mix(p, q, r, s, p, q, r, s)
}

fn twice(x: u64) -> u64 {
    let a: u64 = x + 1
    let b: u64 = swap2(a, a)
    let c: u64 = swap2(a, b)
    return swap2(b, c) + swap2(c, a)
}

fn rotate(a: u64, b: u64, c: u64, n: u64) -> u64 {
    if n == 0 {
        return a * 100 + b * 10 + c
    }
    return rotate(b, c, a, n - 1)
}

fn main() -> i32 {
    if fib(20) != 6765 {
        return 1
    }
    if mix(1, 2, 3, 4, 5, 6, 7, 8) != 1 + 6 + 15 + 28 + 55 + 78 + 119 + 152 {
        return 2
    }
    if swap2(3, 4) != 3004 {
        return 3
    }
    let c: u64 = chain(5, 9)
    let p: u64 = 6
    let q: u64 = 11
    let r: u64 = q * 1000 + p
    let s: u64 = p * 1000 + q
    if c != r * 3 + s + (p + q * 3 + r * 5 + s * 7 + p * 11 + q * 13 + r * 17 + s * 19) {
        return 4
    }
    let a: u64 = 8
    let b: u64 = a * 1000 + a
    let cc: u64 = a * 1000 + b
    if twice(7) != (b * 1000 + cc) + (cc * 1000 + a) {
        return 5
    }
    if rotate(1, 2, 3, 4) != 231 {
        return 6
    }
    if rotate(1, 2, 3, 3) != 123 {
        return 7
    }
    return 0
}
