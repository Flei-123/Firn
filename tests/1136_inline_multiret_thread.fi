// expect_exit: 0
// tests/1136_inline_multiret_thread.fi -- ROUND INLINE: a callee with SEVERAL
// `ret`s, embedded TWICE into one caller, the second call guarded by the
// result of the first.
//
// THE BUG THIS PINS DOWN (found in `tests/1133_js_class_private.fi`,
// assertion 4 -- the private brand check `#p in o` answered `true` for an
// object that has no such field):
//
// `inline.rs` returns the value of a multi-`ret` callee through a slot: every
// `ret v` becomes `store slot, v` + `br cont`, and the continuation block
// starts with `load slot`. `threading::thread_bool_cells` then sees a block
// whose single instruction is a bool `load` and whose terminator branches on
// exactly that value -- its pattern -- and makes every predecessor jump PAST
// the block straight into the two arms. The block becomes unreachable and the
// `load` with it, while the caller still names the loaded value further on,
// here in the phi that merges `have`. The register allocator then hands out
// whatever the register happened to hold: `outer(5, 7, 0)` came back `true`.
//
// `fork_at` now refuses when the loaded value is used outside its own block.
//
// The bug is older than the round that found it: this program miscompiles on
// the base commit too, as soon as the inliner's budget reaches the call site.

fn small(k: u64, cap: u64) -> bool {
    if k == 0 {
        return false
    }
    if cap == 0 {
        return false
    }
    return k == cap
}

fn outer(a: u64, b: u64, c: u64) -> bool {
    var have: bool = small(a, b)
    if !have {
        if c != 0 && small(c, b) {
            have = true
        }
    }
    return have
}

fn main() -> i32 {
    // small(5,7) = false, and c = 0, so the second call never runs:
    // `have` must stay false. This is the case that returned true.
    if outer(5, 7, 0) {
        return 1
    }
    // small(5,7) = false, small(9,7) = false -> false
    if outer(5, 7, 9) {
        return 2
    }
    // small(7,7) = true -> the guard is not entered at all
    if !outer(7, 7, 0) {
        return 3
    }
    // small(5,7) = false, small(7,7) = true -> true
    if !outer(5, 7, 7) {
        return 4
    }
    // both zero arguments take the early `return false` of the callee
    if outer(0, 7, 0) {
        return 5
    }
    if outer(5, 0, 0) {
        return 6
    }
    return 0
}
