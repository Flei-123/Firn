// expect_exit: 42
// A module keeps a `Vec` of a struct of its OWN (round MODGEN). Before,
// the module renamer qualified the struct (`genlocal__P`) but not the type
// argument of the instantiation, and `Vec[P]` failed with "unknown type 'P'".
// The root file declares a DIFFERENT struct `P` and a `Vec[P]` of it too:
// both instantiations must exist side by side (`Vec__P` for the root file,
// `Vec__genlocal__P` for the module).
import std.vec
import modules.genlocal

struct P { a: u8, b: u8, c: u8 }

fn main() -> i32 {
    var bag: genlocal.Bag = genlocal.bag_new()
    genlocal.bag_add(&bag, 10)
    genlocal.bag_add(&bag, 20)
    var mine: Vec[P] = vec_new[P]()
    vec_push[P](&mine, P { a: 5, b: 4, c: 3 })
    let q: *mut P = vec_elem_ptr[P](&mine, 0)
    let r: u32 = genlocal.bag_sum(&bag) + ((*q).a + (*q).b + (*q).c) as u32
    genlocal.bag_free(&bag)
    vec_free[P](&mine)
    return r as i32
}
