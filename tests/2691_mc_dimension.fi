// expect_exit: 0
// tests/2691_mc_dimension.fi -- mc_dimension: min_y / height out of a Join Game dimension codec.
// A codec with two dimension types is built with the NBT writer; the right entry must be found by
// name, a missing name and every truncation / damaged byte must give false (never a crash).
import std.bytes
import std.rt
import std.nbt
import mc.mc_dimension

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn entry(b: *mut bytes.Bytes, name: u64, n: usize, id: i32, min_y: i32, height: i32) {
    nbt.nbt_string(b, "name".p as u64, 4, name, n)
    nbt.nbt_int(b, "id".p as u64, 2, id)
    nbt.nbt_compound_begin(b, "element".p as u64, 7)
    nbt.nbt_byte(b, "ultrawarm".p as u64, 9, 0 as i8)
    nbt.nbt_int(b, "min_y".p as u64, 5, min_y)
    nbt.nbt_string(b, "infiniburn".p as u64, 10, "#minecraft:infiniburn_overworld".p as u64, 31)
    nbt.nbt_int(b, "height".p as u64, 6, height)
    nbt.nbt_float(b, "coordinate_scale".p as u64, 16, 1.0f)
    nbt.nbt_end(b)
    nbt.nbt_end(b)
}

fn build(b: *mut bytes.Bytes) {
    nbt.nbt_root_begin(b, 0, 0)
    nbt.nbt_compound_begin(b, "minecraft:dimension_type".p as u64, 24)
    nbt.nbt_string(b, "type".p as u64, 4, "minecraft:dimension_type".p as u64, 24)
    nbt.nbt_list_open(b, "value".p as u64, 5, 10 as u8, 2)
    entry(b, "minecraft:overworld".p as u64, 19, 0, 0 - 64, 384)
    entry(b, "minecraft:the_nether".p as u64, 20, 1, 0, 256)
    nbt.nbt_end(b)
    nbt.nbt_compound_begin(b, "minecraft:worldgen/biome".p as u64, 24)
    nbt.nbt_string(b, "type".p as u64, 4, "minecraft:worldgen/biome".p as u64, 24)
    nbt.nbt_end(b)
    nbt.nbt_end(b)
}

fn main() -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    build(&b)
    var d: mc_dimension.Dimension = mc_dimension.dim_default_overworld()
    check(mc_dimension.dim_sections(&d) == 24, 1)
    check(mc_dimension.dim_from_codec(&b, "minecraft:overworld".p as u64, 19, &d), 2)
    check(d.min_y == 0 - 64 && d.height == 384 && mc_dimension.dim_sections(&d) == 24, 3)
    bytes.bytes_reset(&b)
    check(mc_dimension.dim_from_codec(&b, "minecraft:the_nether".p as u64, 20, &d), 4)
    check(d.min_y == 0 && d.height == 256 && mc_dimension.dim_sections(&d) == 16, 5)
    bytes.bytes_reset(&b)
    var keep: mc_dimension.Dimension = d
    check(!mc_dimension.dim_from_codec(&b, "minecraft:the_end".p as u64, 17, &d), 6)
    check(d.min_y == keep.min_y && d.height == keep.height, 7) // untouched on failure

    // every truncation of the codec: no crash, never a wrong answer for the overworld
    var len: usize = bytes.bytes_len(&b)
    var cut: usize = 0
    while cut < len {
        var v: bytes.Bytes = bytes.Bytes { data: bytes.bytes_ptr(&b), cap: cut, len: cut, pos: 0, bad: false }
        var dd: mc_dimension.Dimension = mc_dimension.dim_default_overworld()
        if mc_dimension.dim_from_codec(&v, "minecraft:overworld".p as u64, 19, &dd) {
            check(dd.min_y == 0 - 64 && dd.height == 384, 8)
        }
        cut = cut + 1
    }
    // every single octet damaged: no crash
    var at: usize = 0
    while at < len {
        let old: u8 = rt.ld8(bytes.bytes_ptr(&b), at)
        rt.st8(bytes.bytes_ptr(&b), at, old ^ 0xFF as u8)
        var v: bytes.Bytes = bytes.Bytes { data: bytes.bytes_ptr(&b), cap: len, len: len, pos: 0, bad: false }
        var dd: mc_dimension.Dimension = mc_dimension.dim_default_overworld()
        mc_dimension.dim_from_codec(&v, "minecraft:overworld".p as u64, 19, &dd)
        rt.st8(bytes.bytes_ptr(&b), at, old)
        at = at + 1
    }
    // nonsense heights give 0 sections
    var bad: mc_dimension.Dimension = mc_dimension.Dimension { min_y: 0, height: 1000 }
    check(mc_dimension.dim_sections(&bad) == 0, 9)
    bad.height = 0 - 16
    check(mc_dimension.dim_sections(&bad) == 0, 10)
    bytes.bytes_free(&b)
    return 0
}
