// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import jobs.jobs
import scene3d.render
import scene3d.scene
import scene3d.camera
import scene3d.surface
import scene3d.vec3
import scene3d.material
import scene3d.geom
import scene3d.light
import scene3d.tonemap

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0
}

fn chan_diff(a: u32, b: u32) -> i32 {
    var worst: i32 = 0
    var c: i32 = 0
    while c < 3 {
        let x: i32 = ((a >> ((c * 8) as u32)) & 255 as u32) as i32
        let y: i32 = ((b >> ((c * 8) as u32)) & 255 as u32) as i32
        var d: i32 = x - y
        if d < 0 { d = 0 - d }
        if d > worst { worst = d }
        c = c + 1
    }
    return worst
}

fn build_scene(share: bool) -> scene.Scene {
    var sc: scene.Scene = scene.scene_new()
    sc.bg_top = vec3.v3(0.1, 0.12, 0.2)
    sc.bg_bottom = vec3.v3(0.2, 0.22, 0.3)
    sc.hemi_sky = vec3.v3(0.4, 0.45, 0.55)
    sc.hemi_ground = vec3.v3(0.15, 0.14, 0.12)
    scene.scene_set_tonemap(&sc, tonemap.TONEMAP_FILMIC)
    scene.scene_set_share_shading(&sc, share)
    let floor: i32 = scene.scene_add_mesh(&sc, geom.geom_plane(12.0, 12.0, 1, 1))
    let ball: i32 = scene.scene_add_mesh(&sc, geom.geom_sphere(1.0, 24, 16))
    let wood: i32 = scene.scene_add_material(&sc, material.mat_standard(vec3.rgb_hex(0xb08050), 0.0, 0.8))
    let red: i32 = scene.scene_add_material(&sc, material.mat_standard(vec3.rgb_hex(0xd04040), 0.0, 0.4))
    let glass: i32 = scene.scene_add_material(&sc, material.mat_glass(vec3.rgb_hex(0x60a0ff), 0.4))
    scene.scene_add_mesh_node(&sc, 0 - 1, floor, wood)
    let a: i32 = scene.scene_add_mesh_node(&sc, 0 - 1, ball, red)
    scene.node_set_pos(scene.scene_node(&sc, a), vec3.v3(0.0 - 1.2, 1.0, 0.0))
    let b: i32 = scene.scene_add_mesh_node(&sc, 0 - 1, ball, glass)
    scene.node_set_pos(scene.scene_node(&sc, b), vec3.v3(1.2, 1.0, 0.5))
    var l: light.Light = light.light_dir(vec3.v3_norm(vec3.v3(0.6, 1.0, 0.4)), vec3.v3(1.0, 0.97, 0.9), 2.5)
    light.light_set_shadow(&l, 512, 0.02, 1.0)
    scene.scene_add_light(&sc, l)
    return sc
}

fn shot(share: bool, threads: i32) -> surface.Surface {
    var sc: scene.Scene = build_scene(share)
    var cam: camera.Camera = camera.cam_new(96, 64)
    camera.cam_look_at(&cam, vec3.v3(0.0, 3.0, 7.0), vec3.v3(0.0, 0.8, 0.0))
    var rd: render.Renderer = render.renderer_new(96, 64, 2, threads)
    var sf: surface.Surface = surface.surface_new(96, 64)
    render.render(&rd, &sc, &cam, &sf)
    render.renderer_free(&rd)
    scene.scene_free(&sc)
    return sf
}

fn identical(a: *mut surface.Surface, b: *mut surface.Surface) -> bool {
    var i: i32 = 0
    while i < (*a).w * (*a).h {
        if surface.surface_get(a, i % (*a).w, i / (*a).w) != surface.surface_get(b, i % (*a).w, i / (*a).w) { return false }
        i = i + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    var off: surface.Surface = shot(false, 0)
    var on0: surface.Surface = shot(true, 0)
    var on3: surface.Surface = shot(true, 3)
    var code: i32 = 0
    if identical(&on0, &on3) == false { code = 1 }
    var big: i32 = 0
    var worst: i32 = 0
    var i: i32 = 0
    while i < off.w * off.h {
        let d: i32 = chan_diff(surface.surface_get(&off, i % off.w, i / off.w), surface.surface_get(&on0, i % off.w, i / off.w))
        if d > worst { worst = d }
        if d > 12 { big = big + 1 }
        i = i + 1
    }
    if worst > 80 { code = 2 }
    if big * 50 > off.w * off.h { code = 3 }
    if identical(&off, &on0) { code = 4 }
    surface.surface_free(&off)
    surface.surface_free(&on0)
    surface.surface_free(&on3)
    return code
}
