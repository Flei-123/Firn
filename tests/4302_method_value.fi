// expect_exit: 0
// tests/4302_method_value.fi -- r742: `Type.m` is the method as a function value
// (the receiver pointer is the first parameter).
struct Acc { n: i32 }

impl Acc {
    fn bump(*mut self, d: i32) -> i32 {
        (*self).n = (*self).n + d
        return (*self).n
    }
    fn get(*mut self) -> i32 { return (*self).n }
}

fn call_on(f: fn(*mut Acc, i32) -> i32, a: *mut Acc, d: i32) -> i32 { return f(a, d) }
struct Table { op: fn(*mut Acc, i32) -> i32 }

fn main() -> i32 {
    var a: Acc = Acc { n: 1 }
    let f = Acc.bump
    if f(&a, 4) != 5 { return 1 }
    if call_on(Acc.bump, &a, 2) != 7 { return 2 }
    let t = Table { op: Acc.bump }
    if t.op(&a, 3) != 10 { return 3 }
    let g: fn(*mut Acc) -> i32 = Acc.get
    if g(&a) != 10 { return 4 }
    return 0
}
