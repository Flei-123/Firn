// expect_exit: 0
import std.net
import std.rt
import std.bytes
import mc.mc_codec
import mc.mc_client
import mc.mc_sem
import mc.mc_version
import mc.mc_view_sync
import mc.v763.mc_proto_v763
import mc.v769.mc_proto_v769

fn read_view(sw: *mut mc_codec.Wire, ver: *mut mc_version.Version) -> i32 {
    var body: bytes.Bytes = bytes.bytes_new()
    let id: i32 = mc_codec.wire_read_packet(sw, &body) catch 0 - 100
    if id != mc_version.version_pid(ver, mc_sem.SEM_PLAY_C2S_SETTINGS) { return 0 - 1 }
    var i: i32 = 0
    while i < 6 {
        bytes.get_u8(&body) catch 0 as u8
        i = i + 1
    }
    return (bytes.get_u8(&body) catch 0) as i32
}

fn round(ver: mc_version.Version, base: i32) -> i32 {
    var v: mc_version.Version = ver
    var lst: net.Listener = net.listen_tcp(net.ipv4(127 as u8, 0 as u8, 0 as u8, 1 as u8), 0 as u16) catch net.listener_from_fd(0 - 1)
    let port: u16 = net.listener_port(&lst)
    var cc: net.Conn = net.connect_tcp(net.ipv4(127 as u8, 0 as u8, 0 as u8, 1 as u8), port) catch net.conn_from_fd(0 - 1)
    var sc: net.Conn = net.accept(&lst) catch net.conn_from_fd(0 - 1)
    var cl: mc_client.Client = mc_client.client_new(cc, v)
    var sw: mc_codec.Wire = mc_codec.wire_open(sc)
    mc_codec.wire_timeout(&sw, 300)
    var rc: i32 = 0
    cl.state = mc_version.ST_PLAY
    if !mc_client.client_send_settings(&cl, 12) { rc = base + 1 }
    if rc == 0 && read_view(&sw, &v) != 12 { rc = base + 2 }
    if rc == 0 && !mc_client.client_send_settings(&cl, 5) { rc = base + 3 }
    if rc == 0 && read_view(&sw, &v) != 5 { rc = base + 4 }
    if rc == 0 && !mc_client.client_send_settings(&cl, 32) { rc = base + 5 }
    if rc == 0 && read_view(&sw, &v) != 32 { rc = base + 6 }
    mc_codec.wire_close(&sw)
    mc_client.client_free(&cl)
    net.close_listener(&lst)
    return rc
}

fn main() -> i32 {
    var r: i32 = round(mc_proto_v763.version_make(), 10)
    if r != 0 { return r }
    r = round(mc_proto_v769.version_make(), 20)
    if r != 0 { return r }

    var vs: mc_view_sync.ViewSync = mc_view_sync.vs_new(8, false)
    if mc_view_sync.vs_poll(&vs, 8, false) != 0 { return 30 }
    if mc_view_sync.vs_poll(&vs, 0, false) != 0 { return 31 }
    if mc_view_sync.vs_poll(&vs, 12, true) != 0 { return 32 }
    if mc_view_sync.vs_applied(&vs) != 8 { return 33 }
    if mc_view_sync.vs_poll(&vs, 12, false) != 12 { return 34 }
    if mc_view_sync.vs_poll(&vs, 12, false) != 0 { return 35 }
    if mc_view_sync.vs_poll(&vs, 3, false) != 3 { return 36 }
    if mc_view_sync.vs_applied(&vs) != 3 { return 37 }
    var lk: mc_view_sync.ViewSync = mc_view_sync.vs_new(6, true)
    if mc_view_sync.vs_poll(&lk, 20, false) != 0 { return 38 }
    if mc_view_sync.vs_applied(&lk) != 6 { return 39 }
    if mc_view_sync.vs_wire(8, 12) != 12 { return 40 }
    if mc_view_sync.vs_wire(6, 0) != 6 { return 41 }
    return 0
}
