// expect_out: Hallo, Welt, Firn | HALLO, WELT, FIRN | ok
// tests/812_impl_std_kern.fi — `std.str` MIT METHODEN (Runde 45).
//
// Dasselbe wie in tests/800_std_str_kern.fi, nur in der Schreibweise, die
// `impl` moeglich macht:
//
//     str.trimme(quelle)          ->   quelle.trimme()
//     str.finde(kern, welt)       ->   kern.finde(welt)
//     str.bytes_push(&b, 65)      ->   b.dazu(65 as u8)
//
// Die Methoden sind reine HUELLEN ueber genau diese freien Funktionen
// (lib/str/std_impl.fi) — deshalb ist dieser Test zugleich der Nachweis,
// dass die Umstellung nichts am Verhalten aendert: beide Wege werden hier
// nebeneinander ausgerechnet und muessen dasselbe liefern.
import std.io
import std.str

fn main() -> i32 {
    var roh: [u8; 22] = "  Hallo, Welt, Firn  \0"
    var welt_c: [u8; 5] = "Welt\0"
    var komma_c: [u8; 2] = ",\0"
    var hallo_c: [u8; 6] = "Hallo\0"
    var firn_c: [u8; 5] = "Firn\0"

    let quelle: str.Spanne = str.spanne_von_c((&roh[0]) as *mut u8)
    let welt: str.Spanne = str.spanne_von_c((&welt_c[0]) as *mut u8)
    let hallo: str.Spanne = str.spanne_von_c((&hallo_c[0]) as *mut u8)
    let firn: str.Spanne = str.spanne_von_c((&firn_c[0]) as *mut u8)

    // --- Spanne: Methode und freie Funktion muessen dasselbe liefern
    let kern: str.Spanne = quelle.trimme()
    if kern.laenge() != str.laenge(str.trimme(quelle)) {
        return 10
    }
    if kern.laenge() != 17 {
        return 11
    }
    if kern.finde(welt) != str.finde(kern, welt) {
        return 12
    }
    if kern.finde(welt) != 7 {
        return 13
    }
    if !kern.beginnt_mit(hallo) {
        return 14
    }
    if !kern.endet_mit(firn) {
        return 15
    }
    if !kern.enthaelt(welt) {
        return 16
    }
    if kern.zeichen(0) != 72 as u8 {
        return 17
    }
    if kern.teil(0, 5).laenge() != 5 {
        return 18
    }
    if !kern.teil(0, 5).gleich(hallo) {
        return 19
    }
    if kern.ab(7).laenge() != 10 {
        return 20
    }
    if kern.bis(5).vergleiche(hallo) != 0 {
        return 21
    }
    if kern.utf8_zeichen() != 17 {
        return 22
    }
    let kommas: usize = kern.zaehle_zeichen(44 as u8)
    if kommas != 2 {
        return 23
    }

    // --- Bytes: schreibende Methoden
    var b: str.Bytes = str.bytes_new()
    b.anhaengen(kern)
    if b.laenge() != 17 {
        return 24
    }
    if b.bei(0) != 72 as u8 {
        return 25
    }
    if !b.spanne().gleich(kern) {
        return 26
    }
    if !b.ist_text() {
        return 27
    }
    b.schreibe(1)

    var trenn: [u8; 4] = " | \0"
    io.print((&trenn[0]) as u64, 3)

    // gross schreiben, an Ort und Stelle — und wieder ausgeben
    b.gross_hier()
    b.schreibe(1)
    io.print((&trenn[0]) as u64, 3)

    b.leeren()
    if b.laenge() != 0 {
        return 28
    }
    b.dazu(65 as u8)
    b.dazu(66 as u8)
    if b.laenge() != 2 || b.bei(1) != 66 as u8 {
        return 29
    }
    b.frei()

    // --- Str16: dieselbe Huelle ueber der WTF-16-Seite
    var s: str.Str16 = str.str16_new()
    s.dazu(72 as u16)
    s.dazu_cp(0x1F600 as u32)
    if s.laenge() != 3 {
        return 30
    }
    if s.bei(0) != 72 as u16 {
        return 31
    }
    s.setze_bei(0, 73 as u16)
    if s.bei(0) != 73 as u16 {
        return 32
    }
    s.leeren()
    if s.laenge() != 0 {
        return 33
    }
    s.frei()

    var aus: str.Bytes = str.bytes_new()
    str.anhaengen_zeichen(&aus, 111 as u8)
    str.anhaengen_zeichen(&aus, 107 as u8)
    aus.schreibe(1)
    aus.frei()
    return 0
}
