// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_bolt_shape
import mc.mc_entity_draw
import mc.mc_camera
import mc.mc_noise
import mc.mc_entity
import mc.mc_registry
import mc.mc_sem
import mc.mc_version
import mc.v763.mc_proto_v763
import mc.v763.mc_reg_v763

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn entity_type(reg: *mut mc_registry.Registry, name: str) -> i32 {
    var i: i32 = 0
    while i < mc_registry.reg_entity_count(reg) {
        var nl: usize = 0
        let np: u64 = mc_registry.reg_entity_name(reg, i, &nl)
        if nl == name.n && rt.mem_eq(np, name.p as u64, nl) { return mc_registry.reg_entity_id(reg, i) }
        i = i + 1
    }
    return 0 - 1
}

fn spawn(s: *mut mc_entity.Store, ver: *mut mc_version.Version, id: i32, ty: i32, x: f64, y: f64, z: f64) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, id)
    bytes.put_uuid(&b, 1 as u64, id as u64)
    bytes.put_varint(&b, ty)
    bytes.put_f64(&b, x)
    bytes.put_f64(&b, y)
    bytes.put_f64(&b, z)
    bytes.put_i8(&b, 0 as i8)
    bytes.put_u8(&b, 0 as u8)
    bytes.put_i8(&b, 0 as i8)
    bytes.put_varint(&b, 0)
    bytes.put_i16(&b, 0 as i16)
    bytes.put_i16(&b, 0 as i16)
    bytes.put_i16(&b, 0 as i16)
    bytes.bytes_set_pos(&b, 0)
    let r: bool = mc_entity.entity_on_packet(s, ver, (*ver).sem[mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY], &b)
    bytes.bytes_clear(&b)
    return r
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000001
}

fn main() -> i32 {
    var a: mc_bolt_shape.BoltShape = mc_bolt_shape.bolt_shape_new()
    var b: mc_bolt_shape.BoltShape = mc_bolt_shape.bolt_shape_new()
    var c: mc_bolt_shape.BoltShape = mc_bolt_shape.bolt_shape_new()
    mc_bolt_shape.bolt_shape_build(&a, mc_bolt_shape.bolt_seed(41))
    mc_bolt_shape.bolt_shape_build(&b, mc_bolt_shape.bolt_seed(41))
    mc_bolt_shape.bolt_shape_build(&c, mc_bolt_shape.bolt_seed(42))
    check(a.n == mc_bolt_shape.BOLT_SEGMENTS && b.n == a.n, 1)
    var same: bool = true
    var diff: bool = false
    var i: usize = 0
    while i < a.n * mc_bolt_shape.BOLT_WORDS {
        if a.v[i] != b.v[i] { same = false }
        if a.v[i] != c.v[i] { diff = true }
        i = i + 1
    }
    check(same, 2)
    check(diff, 3)
    var k: usize = 1
    while k < mc_bolt_shape.BOLT_MAIN_SEGMENTS {
        let o: usize = k * mc_bolt_shape.BOLT_WORDS
        let p: usize = (k - 1) * mc_bolt_shape.BOLT_WORDS
        check(near(a.v[o], a.v[p + 3]) && near(a.v[o + 1], a.v[p + 4]) && near(a.v[o + 2], a.v[p + 5]), 4)
        k = k + 1
    }
    let last: usize = (mc_bolt_shape.BOLT_MAIN_SEGMENTS - 1) * mc_bolt_shape.BOLT_WORDS
    check(near(a.v[last + 3], 0.0) && near(a.v[last + 4], 0.0) && near(a.v[last + 5], 0.0), 5)
    check(near(a.v[1], 128.0) && near(a.v[4], 112.0), 6)
    var br: usize = mc_bolt_shape.BOLT_MAIN_SEGMENTS
    while br < a.n {
        let o: usize = br * mc_bolt_shape.BOLT_WORDS
        check(a.v[o + 1] > a.v[o + 4] && near(a.v[o + 1] - a.v[o + 4], mc_bolt_shape.BOLT_SEG_HEIGHT), 7)
        br = br + 1
    }
    let o1: usize = mc_bolt_shape.BOLT_MAIN_SEGMENTS * mc_bolt_shape.BOLT_WORDS
    var on_main: bool = false
    var m: usize = 0
    while m < mc_bolt_shape.BOLT_MAIN_SEGMENTS {
        let q: usize = m * mc_bolt_shape.BOLT_WORDS
        if near(a.v[o1], a.v[q]) && near(a.v[o1 + 1], a.v[q + 1]) && near(a.v[o1 + 2], a.v[q + 2]) { on_main = true }
        m = m + 1
    }
    check(on_main, 8)
    var jr: mc_noise.JavaRandom = mc_noise.jrandom_new(mc_bolt_shape.bolt_seed(41))
    let s0: i32 = mc_noise.jrandom_next_int_bound(&jr, 11) - 5
    var top_x: f64 = 0.0
    var ax0: f64 = 0.0
    var t: i32 = 0
    var jr2: mc_noise.JavaRandom = mc_noise.jrandom_new(mc_bolt_shape.bolt_seed(41))
    while t < 8 {
        ax0 = ax0 + ((mc_noise.jrandom_next_int_bound(&jr2, 11) - 5) as f64)
        mc_noise.jrandom_next_int_bound(&jr2, 11)
        t = t + 1
    }
    top_x = 0.0 - ax0
    check(near(a.v[0], top_x), 9)
    check(s0 >= 0 - 5 && s0 <= 5, 10)

    var reg: mc_registry.Registry = mc_reg_v763.registry_make()
    var ver: mc_version.Version = mc_proto_v763.version_make()
    var s: mc_entity.Store = mc_entity.store_new()
    let bolt: i32 = entity_type(&reg, "lightning_bolt")
    check(bolt >= 0, 11)
    check(spawn(&s, &ver, 41, bolt, 0.0, 0.0, 30.0), 12)
    var cam: mc_camera.Camera = mc_camera.camera_new(64, 48)
    mc_camera.camera_set_pos(&cam, 0.0, 1.0, 0.0)
    mc_camera.camera_update(&cam)
    var l: mc_entity_draw.EntList = mc_entity_draw.entlist_new()
    mc_entity_draw.entlist_build_reg(&l, &s, &cam, 96.0, 40.0, &reg)
    check(mc_entity_draw.entlist_boxes(&l) == 1 && l.n_bolts == 0 as u32, 13)
    mc_entity_draw.entlist_set_bolt_type(&l, bolt)
    mc_entity_draw.entlist_build_reg(&l, &s, &cam, 96.0, 40.0, &reg)
    check(mc_entity_draw.entlist_boxes(&l) == mc_bolt_shape.BOLT_SEGMENTS * 16 && l.n_bolts == 1 as u32, 14)
    let first: u64 = rt.buf_ptr(&l.buf)
    check(near(*((first + 16 as u64) as *mut f64), 30.0 + a.v[2] + (a.v[5] - a.v[2]) * (0.5 / 16.0)), 16)
    check(near(*((first + 8 as u64) as *mut f64), a.v[1] + (a.v[4] - a.v[1]) * (0.5 / 16.0)), 17)
    mc_entity.store_clear(&s)
    check(spawn(&s, &ver, 43, bolt, 0.0, 0.0, 0.0 - 400.0), 18)
    mc_entity_draw.entlist_build_reg(&l, &s, &cam, 96.0, 40.0, &reg)
    check(mc_entity_draw.entlist_boxes(&l) == 0 && l.n_culled == 1 as u32, 19)
    mc_entity_draw.entlist_clear(&l)
    mc_entity_draw.entlist_add_box(&l, 1.0, 2.0, 3.0, 0.1, 0.1, 0.1, 255, 255, 255)
    mc_entity_draw.entlist_add_bolt(&l, 0.0, 0.0, 30.0, 41, 30.0)
    mc_entity_draw.entlist_add_box(&l, 4.0, 5.0, 6.0, 0.1, 0.1, 0.1, 255, 255, 255)
    check(mc_entity_draw.entlist_boxes(&l) == mc_bolt_shape.BOLT_SEGMENTS * 16 + 2 && l.n_bolt_boxes == (mc_bolt_shape.BOLT_SEGMENTS * 16) as u32, 20)
    mc_entity_draw.entlist_free(&l)
    return 0
}
