// expect_exit: 0
// tests/2923_spirv_ext.fi -- gpu.spirv: GLSL.std.450 (ext.frag): floor ceil fract abs min max clamp sign mix step smoothstep
// normalize length cross reflect pow exp log sin cos. Exact where the operation is exact, |error| < 1e-5 otherwise.
import std.rt
import std.math
import gpu.spirv

const SH: str = __include_str("../lib/gpu/spv/test/ext.frag.spv")

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn near(x: f32, y: f32) -> bool {
    var d: f32 = x - y
    if d < 0.0 {
        d = 0.0 - d
    }
    return d < 0.00001
}

fn run(m: *mut spirv.Spv, ent: u32, t: f32, base: i32) {
    let a: usize = spirv.spv_find_location(m, 1, 0)
    let b: usize = spirv.spv_find_location(m, 1, 1)
    let tt: usize = spirv.spv_find_location(m, 1, 2)
    let r0: usize = spirv.spv_find_location(m, 3, 0)
    let r1: usize = spirv.spv_find_location(m, 3, 1)
    let r2: usize = spirv.spv_find_location(m, 3, 2)
    let r3: usize = spirv.spv_find_location(m, 3, 3)
    let r4: usize = spirv.spv_find_location(m, 3, 4)
    let r5: usize = spirv.spv_find_location(m, 3, 5)
    let r6: usize = spirv.spv_find_location(m, 3, 6)
    let av: [f32; 3] = [1.0, 2.0, 2.0]
    let bv: [f32; 3] = [0.5, -1.0, 4.0]
    var k: usize = 0
    while k < 3 {
        spirv.spv_mem_set_f32(m, a, k, av[k])
        spirv.spv_mem_set_f32(m, b, k, bv[k])
        k = k + 1
    }
    spirv.spv_mem_set_f32(m, tt, 0, t)
    check(spirv.spv_run(m, ent, 10000), base)
    let fl: f32 = math.floor32(t)
    let ab: f32 = math.fabs32(t)
    check(spirv.spv_mem_get_f32(m, r0, 0) == fl, base + 1)
    check(spirv.spv_mem_get_f32(m, r0, 1) == math.ceil32(t), base + 2)
    check(spirv.spv_mem_get_f32(m, r0, 2) == t - fl, base + 3)
    check(spirv.spv_mem_get_f32(m, r0, 3) == ab, base + 4)
    check(spirv.spv_mem_get_f32(m, r1, 0) == 0.5, base + 5)
    check(spirv.spv_mem_get_f32(m, r1, 1) == 2.0, base + 6)
    var cl: f32 = t
    if cl < -0.5 {
        cl = -0.5
    }
    if cl > 0.5 {
        cl = 0.5
    }
    check(spirv.spv_mem_get_f32(m, r1, 2) == cl, base + 7)
    var sg: f32 = 1.0
    if t < 0.0 {
        sg = -1.0
    }
    check(spirv.spv_mem_get_f32(m, r1, 3) == sg, base + 8)
    check(spirv.spv_mem_get_f32(m, r2, 0) == 0.875, base + 9)
    var stp: f32 = 1.0
    if t < 0.5 {
        stp = 0.0
    }
    check(spirv.spv_mem_get_f32(m, r2, 1) == stp, base + 10)
    var u: f32 = t
    if u < 0.0 {
        u = 0.0
    }
    if u > 1.0 {
        u = 1.0
    }
    check(spirv.spv_mem_get_f32(m, r2, 2) == u * u * (3.0 - 2.0 * u), base + 11)
    // normalize: (1, 2, 2) / 3
    check(near(spirv.spv_mem_get_f32(m, r3, 0), 1.0 / 3.0), base + 12)
    check(near(spirv.spv_mem_get_f32(m, r3, 1), 2.0 / 3.0), base + 13)
    check(near(spirv.spv_mem_get_f32(m, r3, 2), 2.0 / 3.0), base + 14)
    check(spirv.spv_mem_get_f32(m, r3, 3) == 3.0, base + 15)
    // cross((1,2,2), (0.5,-1,4)) = (2*4 - (-1)*2, 2*0.5 - 4*1, 1*(-1) - 0.5*2) = (10, -3, -2)
    check(spirv.spv_mem_get_f32(m, r4, 0) == 10.0, base + 16)
    check(spirv.spv_mem_get_f32(m, r4, 1) == -3.0, base + 17)
    check(spirv.spv_mem_get_f32(m, r4, 2) == -2.0, base + 18)
    // reflect(a, normalize(b)) = a - 2 dot(n, a) n
    let lb: f32 = math.sqrt32(0.5 * 0.5 + 1.0 + 16.0)
    let n0: f32 = 0.5 / lb
    let n1: f32 = -1.0 / lb
    let n2: f32 = 4.0 / lb
    let dt: f32 = n0 * 1.0 + n1 * 2.0 + n2 * 2.0
    check(near(spirv.spv_mem_get_f32(m, r5, 0), 1.0 - 2.0 * dt * n0), base + 19)
    check(near(spirv.spv_mem_get_f32(m, r5, 1), 2.0 - 2.0 * dt * n1), base + 20)
    check(near(spirv.spv_mem_get_f32(m, r5, 2), 2.0 - 2.0 * dt * n2), base + 21)
    // transcendental (f64 math, rounded to f32)
    check(near(spirv.spv_mem_get_f32(m, r6, 0), math.powf(ab as f64, 2.5) as f32), base + 22)
    check(near(spirv.spv_mem_get_f32(m, r6, 1), math.exp(t as f64) as f32), base + 23)
    check(near(spirv.spv_mem_get_f32(m, r6, 2), math.ln((ab + 1.0) as f64) as f32), base + 24)
    check(near(spirv.spv_mem_get_f32(m, r6, 3), (math.sin(t as f64) * math.cos(t as f64)) as f32), base + 25)
}

fn main() -> i32 {
    var m: spirv.Spv = spirv.spv_zero()
    check(spirv.spv_new(SH.p as u64, SH.n, &m), 1)
    let ent: u32 = spirv.spv_find_entry(&m, 4)
    check(ent != 0, 2)
    run(&m, ent, 0.3, 10)
    run(&m, ent, -1.75, 50)
    run(&m, ent, 0.75, 90)
    spirv.spv_free(&m)
    return 0
}
