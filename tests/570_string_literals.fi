// expect_out: Hallo, Firn!
// Zeichenkettenliterale (SPEC §8, §14.1.str S1). Bis Runde 8 gab es sie im
// Compiler (`compiler/src/strings.rs`), aber nicht im Quelltext — jeder Text
// musste als Oktettliste geschrieben werden.
//
// Ein Literal ist ein ARRAY-LITERAL: `"abc"` hat den Typ `[u8; 3]`,
// `u"abc"` den Typ `[u16; 3]`. Damit gelten alle Regeln fuer Arrays, auch die
// Laengenpruefung.

fn main() -> i32 {
    // --- gewoehnliches Literal: geprueftes UTF-8
    var greeting: [u8; 13] = "Hallo, Firn!\n"
    let p: u64 = (&greeting[0]) as u64
    syscall(1, 1, p as i64, 13, 0, 0, 0)

    // --- Maskierungen
    var esc: [u8; 6] = "a\tb\\c\0"
    if esc[0] != 97 as u8 {
        return 1
    }
    if esc[1] != 9 as u8 {
        return 2
    }
    if esc[3] != 92 as u8 {
        return 3
    }
    if esc[5] != 0 as u8 {
        return 4
    }

    // --- Mehrbyte-UTF-8: das Eurozeichen sind drei Oktette
    var eu: [u8; 3] = "€"
    if eu[0] != 226 as u8 || eu[1] != 130 as u8 || eu[2] != 172 as u8 {
        return 5
    }

    // --- b"..." ist eine rohe Oktettfolge, ohne jede Pruefung
    var raw: [u8; 3] = b"\x00\xffZ"
    if raw[0] != 0 as u8 {
        return 6
    }
    if raw[1] != 255 as u8 {
        return 7
    }
    if raw[2] != 90 as u8 {
        return 8
    }

    // --- u"..." liefert UTF-16-Codeeinheiten
    var units: [u16; 2] = u"A€"
    if units[0] != 65 as u16 {
        return 9
    }
    if units[1] != 8364 as u16 {
        return 10
    }

    // --- WTF-16: ein UNGEPAARTES Surrogat muss erhalten bleiben.
    // Genau das verlangt die JS-Engine (FIRN-ANFORDERUNGEN §2); eine Sprache,
    // die nur wohlgeformtes Unicode zulaesst, kann JavaScript nicht umsetzen.
    var lonely: [u16; 3] = u"a\uD800b"
    if lonely[0] != 97 as u16 {
        return 11
    }
    if lonely[1] != 55296 as u16 {
        return 12
    }
    if lonely[2] != 98 as u16 {
        return 13
    }

    // --- ein Zeichen ausserhalb der BMP ist EIN Codepunkt, aber ZWEI
    // UTF-16-Codeeinheiten (Ersatzpaar) und VIER Oktette in UTF-8.
    var pair: [u16; 2] = u"\u{1F600}"
    if pair[0] != 55357 as u16 {
        return 14
    }
    if pair[1] != 56832 as u16 {
        return 15
    }
    var four: [u8; 4] = "\u{1F600}"
    if four[0] != 240 as u8 {
        return 16
    }
    return 0
}
