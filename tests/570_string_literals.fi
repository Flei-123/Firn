// expect_out: Hallo, Firn!
// String literals (SPEC 8, 14.1.str S1). Up to round 8 they existed in the
// compiler (`compiler/src/strings.rs`) but not in the source language --
// every text had to be written as a list of octets.
//
// A literal is an ARRAY LITERAL: `"abc"` has the type `[u8; 3]`,
// `u"abc"` the type `[u16; 3]`. All rules for arrays apply to it, the length
// check included.

fn main() -> i32 {
    // --- ordinary literal: validated UTF-8
    var greeting: [u8; 13] = "Hallo, Firn!\n"
    let p: u64 = (&greeting[0]) as u64
    syscall(1, 1, p as i64, 13, 0, 0, 0)

    // --- escapes
    var esc: [u8; 6] = "a\tb\\c\0"
    if esc[0] != 97 as u8 {
        return 1
    }
    if esc[1] != 9 as u8 {
        return 2
    }
    if esc[3] != 92 as u8 {
        return 3
    }
    if esc[5] != 0 as u8 {
        return 4
    }

    // --- multi-byte UTF-8: the euro sign is three octets
    var eu: [u8; 3] = "€"
    if eu[0] != 226 as u8 || eu[1] != 130 as u8 || eu[2] != 172 as u8 {
        return 5
    }

    // --- b"..." is a raw octet sequence, without any validation
    var raw: [u8; 3] = b"\x00\xffZ"
    if raw[0] != 0 as u8 {
        return 6
    }
    if raw[1] != 255 as u8 {
        return 7
    }
    if raw[2] != 90 as u8 {
        return 8
    }

    // --- u"..." yields UTF-16 code units
    var units: [u16; 2] = u"A€"
    if units[0] != 65 as u16 {
        return 9
    }
    if units[1] != 8364 as u16 {
        return 10
    }

    // --- WTF-16: an UNPAIRED surrogate has to be kept.
    // Exactly that is what the JS engine demands (FIRN-ANFORDERUNGEN 2); a
    // that only allows well-formed Unicode cannot implement JavaScript.
    var lonely: [u16; 3] = u"a\uD800b"
    if lonely[0] != 97 as u16 {
        return 11
    }
    if lonely[1] != 55296 as u16 {
        return 12
    }
    if lonely[2] != 98 as u16 {
        return 13
    }

    // --- a character outside the BMP is ONE code point, but TWO
    // UTF-16 code units (surrogate pair) and FOUR octets in UTF-8.
    var pair: [u16; 2] = u"\u{1F600}"
    if pair[0] != 55357 as u16 {
        return 14
    }
    if pair[1] != 56832 as u16 {
        return 15
    }
    var four: [u8; 4] = "\u{1F600}"
    if four[0] != 240 as u8 {
        return 16
    }
    return 0
}
