// expect_exit: 0
// tests/1000_js_lex.fi -- ROUND 63, the ECMAScript LEXER (ECMA-262 clause 12).
//
// The lexer is the part where a JavaScript engine most easily lies to
// itself, so the edges are checked here and not the middle:
//
//   * the longest match over the punctuators (`>>>=`, `??=`, `?.` -- and
//     `?.` must NOT win in `a?.5:b`, which is why the check looks at the
//     following digit),
//   * every numeric form with its EXACT bit pattern, the two legacy forms
//     marked instead of silently accepted, and the two power-of-two cases
//     that only come out right with round to nearest even
//     (0x20000000000001 -> 2^53, 0x20000000000003 -> 2^53+4),
//   * the string escapes including the surrogate pair of `\u{1F600}`,
//   * the same slash as a division operator and as a regular expression --
//     decided by the goal symbol, not by a heuristic,
//   * template pieces with cooked and raw text and the ES2018 rule that an
//     invalid escape only kills the cooked value,
//   * the line terminator bit that automatic semicolon insertion hangs on,
//     carried through a multi line comment as well,
//   * identifiers over the Unicode properties, with escapes.
//
// The return value names the check that failed.
import html.mem
import js.lex

fn main() -> i32 {
    var nm: lex.Names = lex.Names { pool: mem.cp_new(), off: mem.cp_new(),
        len: mem.cp_new(), hash: mem.cp_new(), buckets: mem.cp_new(),
        mask: 0, n: 0 }
    lex.names_init(&nm)
    var l: lex.Lexer = lex.lex_new()
    lex.lex_init(&l, &nm)

    // keywords, identifiers, punctuators, the longest match
    var s1: [u8; 38] = "var x1 = a >>>= b ?? c ?. d ??= e ** f"
    lex.lex_set_ascii(&l, &s1[0], 38)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_KEYWORD || l.code != lex.K_VAR {
        return 1
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_IDENT {
        return 2
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_PUNCT || l.code != lex.P_ASSIGN {
        return 3
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_IDENT {
        return 4
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_PUNCT || l.code != lex.P_USHRA {
        return 5
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_IDENT {
        return 6
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_PUNCT || l.code != lex.P_COALESCE {
        return 7
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_IDENT {
        return 8
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_PUNCT || l.code != lex.P_OPTCHAIN {
        return 9
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_IDENT {
        return 10
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_PUNCT || l.code != lex.P_COALESCEA {
        return 11
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_IDENT {
        return 12
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_PUNCT || l.code != lex.P_POW {
        return 13
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_IDENT {
        return 14
    }
    // every numeric form of 12.9.3, with the exact bit pattern
    var s2: [u8; 117] = "0x20000000000001 0x20000000000003 0b1010 0o17 017 08 1_000_000 .5 1e3 0.1 1e400 9007199254740993 0xFFFFFFFFFFFFFFFFFF"
    lex.lex_set_ascii(&l, &s2[0], 117)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x4340000000000000 {
        return 15
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x4340000000000002 {
        return 16
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x4024000000000000 {
        return 17
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x402E000000000000 {
        return 18
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x402E000000000000 {
        return 19
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x4020000000000000 {
        return 20
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x412E848000000000 {
        return 21
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x3FE0000000000000 {
        return 22
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x408F400000000000 {
        return 23
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x3FB999999999999A {
        return 24
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x7FF0000000000000 {
        return 25
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x4340000000000000 {
        return 26
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_NUM || l.numbits != 0x4470000000000000 {
        return 27
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_EOF {
        return 28
    }
    var s3: [u8; 3] = "017"
    lex.lex_set_ascii(&l, &s3[0], 3)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.flags & lex.F_LEGACY_OCT == 0 as u32 {
        return 29
    }
    var s4: [u8; 2] = "08"
    lex.lex_set_ascii(&l, &s4[0], 2)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.flags & lex.F_LEGACY_DEC == 0 as u32 {
        return 30
    }
    // a number must not be followed directly by an identifier
    var s5: [u8; 3] = "3in"
    lex.lex_set_ascii(&l, &s5[0], 3)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_ERROR || l.err != lex.E_IDENT_AFTER_NUMBER {
        return 31
    }
    // Round 66: `1n` is a BigInt literal; the digits lie in the pool.
    var s6: [u8; 2] = "1n"
    lex.lex_set_ascii(&l, &s6[0], 2)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_BIGINT || l.slen != 1 {
        return 32
    }
    if lex.lex_pool_at(&l, l.soff) != 49 as u32 {
        return 320
    }
    // A fraction, an exponent and the legacy forms are forbidden in front
    // of the `n`.
    var s6b: [u8; 4] = "1.5n"
    lex.lex_set_ascii(&l, &s6b[0], 4)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_ERROR || l.err != lex.E_BAD_NUMBER {
        return 321
    }
    var s6c: [u8; 3] = "01n"
    lex.lex_set_ascii(&l, &s6c[0], 3)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_ERROR || l.err != lex.E_BAD_NUMBER {
        return 322
    }
    // A radix prefix keeps its prefix, the separators fall out.
    var s6d: [u8; 8] = "0x1_2Fn "
    lex.lex_set_ascii(&l, &s6d[0], 7)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_BIGINT || l.slen != 5 {
        return 323
    }
    // string escapes
    var s7: [u8; 23] = "\"a\\n\\x41B\\u{1F600}\\101\""
    lex.lex_set_ascii(&l, &s7[0], 23)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_STRING {
        return 33
    }
    if l.slen != 7 {
        return 34
    }
    if lex.lex_pool_at(&l, l.soff + 0) != 97 as u32 {
        return 35
    }
    if lex.lex_pool_at(&l, l.soff + 1) != 10 as u32 {
        return 36
    }
    if lex.lex_pool_at(&l, l.soff + 2) != 65 as u32 {
        return 37
    }
    if lex.lex_pool_at(&l, l.soff + 3) != 66 as u32 {
        return 38
    }
    if lex.lex_pool_at(&l, l.soff + 4) != 55357 as u32 {
        return 39
    }
    if lex.lex_pool_at(&l, l.soff + 5) != 56832 as u32 {
        return 40
    }
    if lex.lex_pool_at(&l, l.soff + 6) != 65 as u32 {
        return 41
    }
    if l.flags & lex.F_OCT_ESCAPE == 0 as u32 {
        return 42
    }
    // a line continuation contributes nothing
    var s8: [u8; 7] = "\"a\\\n b\""
    lex.lex_set_ascii(&l, &s8[0], 7)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_STRING || l.slen != 3 {
        return 43
    }
    // a raw line terminator inside a string is an error
    var s9: [u8; 5] = "\"a\nb\""
    lex.lex_set_ascii(&l, &s9[0], 5)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_ERROR || l.err != lex.E_UNTERMINATED_STRING {
        return 44
    }
    // the same slash: division and a regular expression
    var sa: [u8; 5] = "a / b"
    lex.lex_set_ascii(&l, &sa[0], 5)
    lex.lex_next(&l, lex.GOAL_DIV)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_PUNCT || l.code != lex.P_DIV {
        return 45
    }
    var sb: [u8; 8] = "/[/]a/gi"
    lex.lex_set_ascii(&l, &sb[0], 8)
    lex.lex_next(&l, lex.GOAL_REGEXP)
    if l.kind != lex.T_REGEXP || l.slen != 4 || l.rlen != 2 {
        return 46
    }
    var sc: [u8; 5] = "/a/gg"
    lex.lex_set_ascii(&l, &sc[0], 5)
    lex.lex_next(&l, lex.GOAL_REGEXP)
    if l.kind != lex.T_ERROR || l.err != lex.E_BAD_FLAGS {
        return 47
    }
    // template pieces: head, middle, tail, with cooked and raw text
    var sd: [u8; 15] = "`a\\n${x}b${y}c`"
    lex.lex_set_ascii(&l, &sd[0], 15)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_TEMPLATE || l.flags & lex.F_TPL_HEAD == 0 as u32 {
        return 48
    }
    if l.flags & lex.F_TPL_TAIL != 0 as u32 {
        return 49
    }
    if l.slen != 2 || l.rlen != 3 {
        return 50
    }
    if lex.lex_pool_at(&l, l.soff + 1) != 10 as u32 {
        return 51
    }
    if lex.lex_pool_at(&l, l.roff + 1) != 92 as u32 {
        return 52
    }
    // an invalid escape only kills the cooked value (ES2018)
    var se: [u8; 6] = "`\\u{}`"
    lex.lex_set_ascii(&l, &se[0], 6)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_TEMPLATE || l.flags & lex.F_BAD_ESCAPE == 0 as u32 {
        return 53
    }
    // the bit that automatic semicolon insertion hangs on
    var sf: [u8; 5] = "a\nb c"
    lex.lex_set_ascii(&l, &sf[0], 5)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.nl {
        return 54
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if !l.nl {
        return 55
    }
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.nl {
        return 56
    }
    // a multi line comment carries the line terminator through
    var sg: [u8; 7] = "a/*\n*/b"
    lex.lex_set_ascii(&l, &sg[0], 7)
    lex.lex_next(&l, lex.GOAL_DIV)
    lex.lex_next(&l, lex.GOAL_DIV)
    if !l.nl {
        return 57
    }
    // identifiers over the real Unicode properties
    var sh: [u8; 20] = "var \\u0061\\u{62} = 1"
    lex.lex_set_ascii(&l, &sh[0], 20)
    lex.lex_next(&l, lex.GOAL_DIV)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_IDENT || l.flags & lex.F_ESCAPED == 0 as u32 {
        return 58
    }
    // an escaped reserved word is recognizable as a keyword
    var si: [u8; 8] = "\\u0076ar"
    lex.lex_set_ascii(&l, &si[0], 8)
    lex.lex_next(&l, lex.GOAL_DIV)
    if l.kind != lex.T_KEYWORD || l.code != lex.K_VAR {
        return 59
    }
    if l.flags & lex.F_ESCAPED == 0 as u32 {
        return 60
    }

    lex.lex_free(&l)
    lex.names_free(&nm)
    return 0
}
