// expect_exit: 0
import mc.mc_cont_ui

fn main() -> i32 {
    if mc_cont_ui.cui_test_kind(1) != mc_cont_ui.KIND_ANVIL { return 1 }
    if mc_cont_ui.cui_test_kind(2) != mc_cont_ui.KIND_ENCHANT { return 2 }
    if mc_cont_ui.cui_test_kind(3) != mc_cont_ui.KIND_GENERIC { return 3 }
    if mc_cont_ui.cui_test_kind(4) != mc_cont_ui.KIND_FURNACE { return 4 }
    if mc_cont_ui.cui_test_kind(5) != mc_cont_ui.KIND_CRAFT { return 5 }
    if mc_cont_ui.cui_test_kind(6) != mc_cont_ui.KIND_MERCHANT { return 6 }
    return 0
}
