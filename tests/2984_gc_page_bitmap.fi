// expect_exit: 0
// r563b: the root scan asks a page bitmap of the heap range before it calls
// __gc_mark. A block that is referenced ONLY by an interior pointer inside a
// Vec buffer (a root area) must survive while chunks enter the heap (garbage
// churn) and leave it again (everything freed, collected). The bitmap is stale
// after each of these changes and must be rebuilt at the next scan.
import std.vec
import std.rt

const HIDE: u64 = 0x5a5a5a5a5a5a5a5a

fn make(i: u32) -> str {
    return "item-" + "0123456789abcdef" + "-x"
}

fn churn(rounds: u32) -> u64 {
    var k: u32 = 0
    var sum: u64 = 0
    while k < rounds {
        let s: str = "garbage-" + "0123456789abcdef0123456789abcdef"
        sum = sum + s.n as u64
        k = k + 1
    }
    return sum
}


// Make `count` strings; keep only an interior pointer (base + 5) in `roots`
// (a Vec[str] whose word 0 we overwrite) and the hidden base in `hidden`.
fn fill(roots: *mut Vec[str], hidden: *mut Vec[str], count: u32) -> bool {
    var k: u32 = 0
    while k < count {
        let s: str = make(k)
        let base: u64 = rt.ld64((&s) as u64, 0)
        var r: str = make(k)
        rt.st64((&r) as u64, 0, base + 5)
        var h: str = make(k)
        rt.st64((&h) as u64, 0, base ^ HIDE)
        if !vec_push[str](roots, r) { return false }
        if !vec_push[str](hidden, h) { return false }
        k = k + 1
    }
    return true
}

// Every base still holds the text (a freed block would carry a free list link).
fn check(roots: *mut Vec[str], hidden: *mut Vec[str]) -> bool {
    var j: usize = 0
    while j < vec_len[str](hidden) {
        let hp: u64 = vec_elem_ptr[str](hidden, j) as u64
        let base: u64 = rt.ld64(hp, 0) ^ HIDE
        let rp: u64 = vec_elem_ptr[str](roots, j) as u64
        if rt.ld64(rp, 0) != base + 5 { return false }
        if rt.ld8(base, 0) != 105 { return false }
        if rt.ld8(base, 1) != 116 { return false }
        if rt.ld8(base, 2) != 101 { return false }
        if rt.ld8(base, 3) != 109 { return false }
        if rt.ld8(base, 4) != 45 { return false }
        if rt.ld8(base, 22) != 120 { return false }
        j = j + 1
    }
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var roots: Vec[str] = vec_new[str]()
    var hidden: Vec[str] = vec_new[str]()
    var round: u32 = 0
    while round < 6 {
        if !fill(&roots, &hidden, 200) { return 2 }
        // more chunks enter the heap
        if churn(60000) == 0 { return 3 }
        gc_collect()
        if !check(&roots, &hidden) { return 4 }
        if churn(60000) == 0 { return 5 }
        gc_collect()
        if !check(&roots, &hidden) { return 6 }
        round = round + 1
    }
    // the live set shrinks: empty chunks go back to the system
    var big: Vec[str] = vec_new[str]()
    var m: u32 = 0
    while m < 80000 {
        if !vec_push[str](&big, make(m)) { return 7 }
        m = m + 1
    }
    gc_collect()
    vec_clear[str](&big)
    vec_free[str](&big)
    gc_collect()
    gc_collect()
    if !check(&roots, &hidden) { return 8 }
    // and grow again after the chunks left
    if churn(80000) == 0 { return 9 }
    gc_collect()
    if !check(&roots, &hidden) { return 10 }
    return 0
}
