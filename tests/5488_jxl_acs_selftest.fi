// expect_exit: 0
import jxl.jxl_acs
import jxl.jxl_acstrans
import jxl.jxl_dct
import std.math
import std.rt

static mut failures: i32 = 0
static mut seed: u64 = 12345
static mut first_bad: i32 = 0

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn next_sample() -> f64 {
    seed = (seed * 1664525 + 1013904223) & 0xffffffff
    return ((seed >> 8) as u32 as f64) / 16777216.0 * 200.0 - 100.0
}

fn fill_image(img: u64, n: usize) {
    var i: usize = 0
    while i < n {
        fst(img, i, next_sample())
        i = i + 1
    }
}

fn max_diff(a: u64, b: u64, n: usize) -> f64 {
    var m: f64 = 0.0
    var i: usize = 0
    while i < n {
        var d: f64 = fld(a, i) - fld(b, i)
        if d < 0.0 {
            d = 0.0 - d
        }
        if d > m {
            m = d
        }
        i = i + 1
    }
    return m
}

fn forward_dct_family(t: u32, img: u64, coef: u64) {
    let pr: usize = jxl_acs.acs_cover_y(t) * 8
    let pc: usize = jxl_acs.acs_cover_x(t) * 8
    if pr < pc {
        jxl_dct.dct_2d_slow(pr, pc, img, coef)
        return
    }
    let tr: u64 = rt.heap_alloc(pr * pc * 8)
    var y: usize = 0
    while y < pr {
        var x: usize = 0
        while x < pc {
            fst(tr, x * pr + y, fld(img, y * pc + x))
            x = x + 1
        }
        y = y + 1
    }
    jxl_dct.dct_2d_slow(pc, pr, tr, coef)
    rt.heap_free(tr, pr * pc * 8)
}

fn forward_dct4x4(img: u64, coef: u64) {
    let blk: u64 = rt.heap_alloc(16 * 8)
    let tr: u64 = rt.heap_alloc(16 * 8)
    let dc: u64 = rt.heap_alloc(4 * 8)
    var by: usize = 0
    while by < 2 {
        var bx: usize = 0
        while bx < 2 {
            var r: usize = 0
            while r < 4 {
                var c: usize = 0
                while c < 4 {
                    fst(tr, c * 4 + r, fld(img, (by * 4 + r) * 8 + bx * 4 + c))
                    c = c + 1
                }
                r = r + 1
            }
            jxl_dct.dct_2d_slow(4, 4, tr, blk)
            fst(dc, by * 2 + bx, fld(blk, 0))
            var iy: usize = 0
            while iy < 4 {
                var ix: usize = 0
                while ix < 4 {
                    if ix != 0 || iy != 0 {
                        fst(coef, (by + iy * 2) * 8 + bx + ix * 2, fld(blk, iy * 4 + ix))
                    }
                    ix = ix + 1
                }
                iy = iy + 1
            }
            bx = bx + 1
        }
        by = by + 1
    }
    let d0: f64 = fld(dc, 0)
    let d1: f64 = fld(dc, 1)
    let d2: f64 = fld(dc, 2)
    let d3: f64 = fld(dc, 3)
    fst(coef, 0, (d0 + d1 + d2 + d3) / 4.0)
    fst(coef, 1, (d0 + d1 - d2 - d3) / 4.0)
    fst(coef, 8, (d0 - d1 + d2 - d3) / 4.0)
    fst(coef, 9, (d0 - d1 - d2 + d3) / 4.0)
    rt.heap_free(blk, 16 * 8)
    rt.heap_free(tr, 16 * 8)
    rt.heap_free(dc, 4 * 8)
}

fn roundtrip(t: u32, limit: f64) {
    let n: usize = jxl_acs.acs_cover_x(t) * jxl_acs.acs_cover_y(t) * 64
    let img: u64 = rt.heap_alloc(n * 8)
    let coef: u64 = rt.heap_alloc(n * 8)
    let out: u64 = rt.heap_alloc(n * 8)
    let scratch: u64 = rt.heap_alloc(jxl_acstrans.ats_scratch_bytes())
    rt.mem_set(coef, 0 as u8, n * 8)
    fill_image(img, n)
    if t == 3 {
        forward_dct4x4(img, coef)
    } else {
        forward_dct_family(t, img, coef)
    }
    if !jxl_acstrans.ats_pixels(t, coef, out, scratch) {
        failures = failures + 1
    } else if max_diff(img, out, n) > limit {
        failures = failures + 1
        if first_bad == 0 {
            first_bad = 100 + (t as i32)
        }
    }
    rt.heap_free(img, n * 8)
    rt.heap_free(coef, n * 8)
    rt.heap_free(out, n * 8)
    rt.heap_free(scratch, jxl_acstrans.ats_scratch_bytes())
}

fn main() -> i32 {
    let types: [u32; 20] = [0, 3, 4, 5, 6, 7, 8, 9, 10, 11, 18, 19, 20, 21, 22, 23, 24, 25, 26, 12]
    var i: usize = 0
    while i < 19 {
        roundtrip(types[i], 0.01)
        i = i + 1
    }
    if first_bad != 0 {
        return first_bad
    }
    return failures
}
