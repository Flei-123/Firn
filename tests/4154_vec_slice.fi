// expect_exit: 0
// tests/4154_vec_slice.fi -- r728: `v[a:b]` on Vec[T] is a non-owning view (cap = 0), Python bounds.
import std.io
import std.rt
import std.vec

struct P {
    a: i32,
    b: i32,
}

fn sum(v: *mut Vec[i64]) -> i64 {
    var s: i64 = 0
    for x in *v {
        s = s + x
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i64] = vec_new[i64]()
    var i: i64 = 0
    while i < 6 {
        vec_push[i64](&v, i * 10)
        i = i + 1
    }
    // v = [0, 10, 20, 30, 40, 50]
    let s1: Vec[i64] = v[1:4]
    if vec_len[i64](&s1) != 3 { return 2 }
    if s1[0] != 10 || s1[2] != 30 { return 3 }
    let s2: Vec[i64] = v[-2:]
    if vec_len[i64](&s2) != 2 || s2[0] != 40 || s2[-1] != 50 { return 4 }
    let s3: Vec[i64] = v[:2]
    if vec_len[i64](&s3) != 2 || s3[1] != 10 { return 5 }
    let s4: Vec[i64] = v[:]
    if vec_len[i64](&s4) != 6 { return 6 }
    // clamped and empty
    let s5: Vec[i64] = v[2:100]
    if vec_len[i64](&s5) != 4 || s5[0] != 20 { return 7 }
    let s6: Vec[i64] = v[-100:2]
    if vec_len[i64](&s6) != 2 || s6[0] != 0 { return 8 }
    let s7: Vec[i64] = v[4:2]
    if vec_len[i64](&s7) != 0 { return 9 }
    let s8: Vec[i64] = v[100:200]
    if vec_len[i64](&s8) != 0 { return 10 }
    let s9: Vec[i64] = v[-1:-3]
    if vec_len[i64](&s9) != 0 { return 11 }
    // view of a view
    let t: Vec[i64] = s1[1:]
    if vec_len[i64](&t) != 2 || t[0] != 20 { return 12 }
    // a view aliases the storage
    var s10: Vec[i64] = v[0:3]
    s10[0] = 99
    if v[0] != 99 { return 13 }
    // iteration over a view
    var sv: Vec[i64] = v[1:3]
    if sum(&sv) != 30 { return 14 }
    // through a pointer
    let pv: *mut Vec[i64] = &v
    let s11: Vec[i64] = pv[3:5]
    if vec_len[i64](&s11) != 2 || s11[1] != 40 { return 15 }
    // struct elements
    var ps: Vec[P] = vec_new[P]()
    vec_push[P](&ps, P { a: 1, b: 2 })
    vec_push[P](&ps, P { a: 3, b: 4 })
    vec_push[P](&ps, P { a: 5, b: 6 })
    let q: Vec[P] = ps[1:]
    if vec_len[P](&q) != 2 || q[0].a != 3 || q[1].b != 6 { return 16 }
    vec_free[i64](&v)
    vec_free[P](&ps)
    return 0
}
