// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import std.rt
import ssdp.ssdp_msg

fn main(start: u64) -> i32 {
    var fails: i32 = 0
    var b: rt.Buf = rt.buf_new()
    let st: str = "urn:schemas-upnp-org:device:MediaServer:1"
    ssdp_msg.build_msearch(&b, st.p as u64, st.n, 2 as u32, "firn/1")
    var m: ssdp_msg.Msg = ssdp_msg.msg_new()
    if !ssdp_msg.msg_parse(b.ptr, b.len, &m) || m.kind != ssdp_msg.KIND_SEARCH {
        fails = fails + 1
    }
    var mx: u32 = 0
    if !ssdp_msg.msg_header_u32(&m, "mx", &mx) || mx != 2 as u32 {
        fails = fails + 1
    }
    if !ssdp_msg.msg_header_eq(&m, "Man", "\"ssdp:discover\"") || !ssdp_msg.msg_header_eq(&m, "ST", "URN:schemas-upnp-org:device:MediaServer:1") {
        fails = fails + 1
    }
    var r: rt.Buf = rt.buf_new()
    let usn: str = "uuid:1234::upnp:rootdevice"
    let loc: str = "http://10.0.0.2:80/d.xml"
    ssdp_msg.build_response(&r, st.p as u64, st.n, usn.p as u64, usn.n, loc.p as u64, loc.n, 1800 as u32, "x/1 UPnP/1.1 firn/1")
    var rm: ssdp_msg.Msg = ssdp_msg.msg_new()
    if !ssdp_msg.msg_parse(r.ptr, r.len, &rm) || rm.kind != ssdp_msg.KIND_RESPONSE || rm.status != 200 as u32 {
        fails = fails + 1
    }
    var ma: u32 = 0
    var o: usize = 0
    var l: usize = 0
    if !ssdp_msg.msg_header(&rm, "location", &o, &l) || l != loc.n || !rt.mem_eq(r.ptr + o as u64, loc.p as u64, l) {
        fails = fails + 1
    }
    if !ssdp_msg.st_matches(st.p as u64, st.n, st.p as u64, st.n) || !ssdp_msg.st_matches("ssdp:all".p as u64, 8, st.p as u64, st.n)
        || ssdp_msg.st_matches("upnp:rootdevice".p as u64, 15, st.p as u64, st.n) {
        fails = fails + 1
    }
    var n: rt.Buf = rt.buf_new()
    ssdp_msg.build_notify(&n, st.p as u64, st.n, false, usn.p as u64, usn.n, loc.p as u64, loc.n, 0 as u32, "s")
    var nm: ssdp_msg.Msg = ssdp_msg.msg_new()
    if !ssdp_msg.msg_parse(n.ptr, n.len, &nm) || nm.kind != ssdp_msg.KIND_NOTIFY || !ssdp_msg.msg_header_eq(&nm, "NTS", "ssdp:byebye") {
        fails = fails + 1
    }
    return fails
}
