// expect_exit: 42
// ROUND REF: reference parameters `x: &T` (read-only) and `x: inout T`
// (modifiable), second class: parameters only. Inside the function the name
// dereferences automatically for `.field` and, for an array target, `[i]`;
// at the call, `&x` / `inout x` hand out the reference. Passing a reference
// parameter on (`rd(s)`, `bump(inout s)`) re-uses it, no pointer to a pointer.
struct Inner { n: i64 }
struct S { x: i64, inner: Inner, a: [i64; 3] }

fn bump(s: inout S) {
    s.x = s.x + 1
    s.inner.n += 10
    s.a[2] = s.a[2] * 2
}

fn rd(s: &S) -> i64 {
    return s.x + s.inner.n + s.a[2]
}

fn both(s: inout S) -> i64 {
    bump(inout s)
    return rd(s)
}

fn fill(a: inout [i64; 3]) {
    a[0] = 5
    a[1] = a[0] + 1
}

fn total(a: &[i64; 3]) -> i64 {
    return a[0] + a[1] + a[2]
}

fn main() -> i32 {
    var s: S = S { x: 1, inner: Inner { n: 2 }, a: [0, 0, 3] }
    // x = 2, inner.n = 12, a[2] = 6 -> 20
    let r: i64 = both(inout s)
    var arr: [i64; 3] = [0, 0, 5]
    fill(inout arr)
    // 5 + 6 + 5 = 16, plus rd via &s (20) plus the count of steps 6
    return (r + total(&arr) + rd(&s) - 20 + 6) as i32
}
