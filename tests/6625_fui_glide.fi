// expect_exit: 0
import fui.glide
import fui.panaxis
import std.rt

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn main() -> i32 {
    glide.set_limits(glide.CH_A, 0.0, 100.0)
    glide.set(glide.CH_A, 50.0)
    check("set", glide.pos(glide.CH_A) == 50.0)
    glide.add(glide.CH_A, 80.0)
    check("clamp high", glide.pos(glide.CH_A) == 100.0)
    glide.add(glide.CH_A, 0.0 - 500.0)
    check("clamp low", glide.pos(glide.CH_A) == 0.0)
    check("idle", !glide.busy())

    glide.fling(glide.CH_A, 1.0)
    check("fling busy", glide.busy_ch(glide.CH_A) && glide.busy())
    var ms: f64 = 1000.0
    var n: i32 = 0
    while glide.tick(ms) && n < 2000 {
        ms = ms + 16.0
        n += 1
    }
    check("fling stops", !glide.busy() && n < 2000)
    check("fling moved", glide.pos(glide.CH_A) > 10.0)
    check("fling limited", glide.pos(glide.CH_A) <= 100.0)

    glide.goto(glide.CH_B, 40.0)
    glide.set_limits(glide.CH_B, 0.0, 100.0)
    glide.goto(glide.CH_B, 40.0)
    n = 0
    while glide.tick(ms) && n < 2000 {
        ms = ms + 16.0
        n += 1
    }
    check("goto reaches", glide.pos(glide.CH_B) == 40.0)
    glide.nudge(glide.CH_B, 10.0)
    glide.nudge(glide.CH_B, 10.0)
    n = 0
    while glide.tick(ms) && n < 2000 {
        ms = ms + 16.0
        n += 1
    }
    check("nudge accumulates", glide.pos(glide.CH_B) == 60.0)

    glide.set_stop(glide.CH_C, 5.0)
    glide.fling(glide.CH_C, 2.0)
    check("stop threshold", !glide.busy_ch(glide.CH_C))

    panaxis.set_area(0.0, 0.0, 100.0, 100.0, true)
    check("in area", panaxis.in_area(50.0, 50.0) && !panaxis.in_area(150.0, 50.0))
    panaxis.begin(50.0, 50.0, true, 0.0)
    check("no axis yet", panaxis.move_to(52.0, 52.0, 10.0) == panaxis.AXIS_NONE)
    check("vertical axis", panaxis.move_to(52.0, 80.0, 20.0) == panaxis.AXIS_V)
    panaxis.move_to(52.0, 70.0, 30.0)
    check("dy", panaxis.last_dy() == 10.0)
    check("fling end", panaxis.end_at(35.0) == panaxis.END_FLING)

    panaxis.begin(80.0, 50.0, true, 0.0)
    check("horizontal axis", panaxis.move_to(10.0, 52.0, 20.0) == panaxis.AXIS_H)
    check("swipe end", panaxis.end_at(30.0) == panaxis.END_SWIPE)
    check("swipe dir", panaxis.swipe_dir() == 1)

    panaxis.begin(50.0, 50.0, false, 0.0)
    check("mouse no axis", panaxis.move_to(50.0, 90.0, 20.0) == panaxis.AXIS_NONE)
    check("tap end", panaxis.end_at(30.0) == panaxis.END_TAP)

    if failures == 0 {
        rt.write_everything(1, "glide ok\n".p as u64, 9)
    }
    return failures
}
