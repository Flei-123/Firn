// expect_exit: 77
// ROUND 96 -- the two patterns SPEC 9.1 names as the ANSWER to what it
// forbids.
//
//   * a secret condition does not steer an `if`, it steers `select`
//     (a `cmov`, no jump)
//   * a secret index does not steer `table[i]`, it steers a walk over the
//     WHOLE table where every entry is looked at and `select` keeps the one
//     that was meant -- the access pattern is the same for every index, so
//     the cache learns nothing (C4)
#[constant_time]
fn pick(table: [secret[u8]; 4], want: secret[u8]) -> secret[u8] {
    var out: secret[u8] = 0
    var i: usize = 0
    while i < 4 {
        // The index `i` is public, the comparison is secret, the choice is a
        // `cmov`. Every entry of the table is read, every time.
        let hit: secret[bool] = want == (i as u8)
        out = select(hit, table[i], out)
        i = i + 1
    }
    return out
}

fn main() -> i32 {
    var t: [secret[u8]; 4] = [11, 22, 33, 44]
    var idx: secret[u8] = 2
    let got: u8 = declassify(pick(t, idx))
    var flag: secret[bool] = true
    let a: secret[u8] = select(flag, 44 as u8, 0 as u8)
    let b: secret[u8] = select(!flag, 44 as u8, 0 as u8)
    return (got + declassify(a) + declassify(b)) as i32
}
