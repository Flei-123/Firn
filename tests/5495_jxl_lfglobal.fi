import jxl.jxl_frame
import jxl.jxl_vardct
import std.fs
import std.rt

static mut failures: i32 = 0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn expect(path: str, w: u32, h: u32, groups: u32, exact: bool) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    check(n != 0)
    var v: jxl_vardct.JxlVardct = jxl_vardct.vd_new()
    let r: i32 = jxl_vardct.vd_open(rt.buf_ptr(&data), n, &v)
    check(r == 0)
    check(v.doc.frame.encoding == jxl_frame.JF_VARDCT)
    check(v.doc.frame.width == w)
    check(v.doc.frame.height == h)
    check(v.doc.frame.num_groups == groups)
    check(v.doc.frame.group_dim == 256)
    check(v.doc.frame.x_qm_scale == 3)
    check(v.doc.frame.b_qm_scale == 2)
    check(!v.doc.frame.lf.gab)
    check(v.doc.frame.lf.epf_iters == 0)
    check(v.lfg.quant.global_scale > 0)
    check(v.lfg.quant.quant_dc > 0)
    check(v.lfg.bctx.num_ctxs >= 1 && v.lfg.bctx.num_ctxs <= 16)
    if exact {
        check(v.lfg_end == jxl_frame.jf_section_size(&v.doc.frame, 0))
    } else {
        check(v.lfg_end <= jxl_frame.jf_section_size(&v.doc.frame, 0))
    }
    jxl_vardct.vd_free(&v)
    rt.buf_free(&data)
}

fn main() -> i32 {
    expect("tests/data/jxl/vd/s64.jxl", 64, 64, 1, false)
    expect("tests/data/jxl/vd/t64.jxl", 64, 64, 1, false)
    expect("tests/data/jxl/vd/t37x29.jxl", 37, 29, 1, false)
    expect("tests/data/jxl/vd/s300x200.jxl", 300, 200, 2, true)
    expect("tests/data/jxl/vd/s600x300.jxl", 600, 300, 6, true)
    return failures
}
