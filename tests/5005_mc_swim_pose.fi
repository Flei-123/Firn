// expect_exit: 0
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_input
import mc.mc_move_fluid

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000000001
}

fn near2(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0005
}

fn put(ids: u64, x: i32, ly: i32, z: i32, id: u16) {
    rt.st16(ids, ((ly * 16 + z) * 16 + x) as usize, id)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

fn publish(w: *mut mc_world.World, ids: u64) {
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

fn fill(ids: u64, x0: i32, x1: i32, ly0: i32, ly1: i32, z0: i32, z1: i32, id: u16) {
    var ly: i32 = ly0
    while ly <= ly1 {
        var z: i32 = z0
        while z <= z1 {
            var x: i32 = x0
            while x <= x1 {
                put(ids, x, ly, z, id)
                x = x + 1
            }
            z = z + 1
        }
        ly = ly + 1
    }
}

fn tick(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32) {
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = keys
    mc_input.player_tick(p, &ev, w, tb, 0 - 64)
}

fn walk(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) {
    var t: i32 = 0
    while t < ticks {
        tick(p, w, tb, keys)
        t = t + 1
    }
}

const STONE: u16 = 1 as u16
const WATER: u16 = 2 as u16
const LAVA: u16 = 3 as u16
const LADDER: u16 = 4 as u16

fn base_ids() -> u64 {
    let ids: u64 = new_ids()
    fill(ids, 0, 15, 0, 2, 0, 15, STONE)
    return ids
}

fn new_player(x: f64, y: f64, z: f64) -> mc_input.Player {
    var p: mc_input.Player = mc_input.player_new(x, y, z)
    rt.st8(p.mv, WATER as usize, mc_move_fluid.fluid_kind(false, 8) as u8)
    rt.st8(p.mv, LAVA as usize, mc_move_fluid.fluid_kind(true, 8) as u8)
    rt.st8(p.mv, LADDER as usize, mc_move_fluid.MV_LADDER as u8)
    return p
}

fn tunnel_world() -> mc_world.World {
    let ids: u64 = base_ids()
    fill(ids, 0, 15, 3, 12, 0, 15, WATER)
    fill(ids, 0, 15, 4, 4, 6, 9, STONE)
    var w: mc_world.World = mc_world.world_new()
    publish(&w, ids)
    return w
}

fn main() -> i32 {
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(8), solid: rt.heap_alloc(16), n: 8 }
    var i: usize = 0
    while i < 8 {
        rt.st8(tb.pick, i, 1 as u8)
        rt.st16(tb.solid, i, 0 as u16)
        i = i + 1
    }
    rt.st16(tb.solid, STONE as usize, 1 as u16)

    let ids: u64 = base_ids()
    fill(ids, 0, 15, 3, 12, 0, 15, WATER)
    var w: mc_world.World = mc_world.world_new()
    publish(&w, ids)
    var s: mc_input.Player = new_player(8.5, 0.0 - 58.0, 1.0)
    check(near(mc_input.player_height(&s), 1.8) && near(mc_input.player_eye(&s), 1.62), 1)
    walk(&s, &w, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 30)
    check(s.swimming && s.low_pose, 2)
    check(near(mc_input.player_height(&s), 0.6) && near(mc_input.player_eye(&s), 0.4), 3)
    walk(&s, &w, &tb, mc_input.K_FORWARD, 1)
    check(!s.swimming && !s.low_pose, 4)
    check(near(mc_input.player_height(&s), 1.8) && near(mc_input.player_eye(&s), 1.62), 5)
    walk(&s, &w, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 1)
    check(s.swimming && s.low_pose, 6)
    walk(&s, &w, &tb, mc_input.K_SNEAK, 1)
    check(!s.swimming && !s.low_pose && s.sneaking, 7)
    mc_world.world_free(&w)

    let ids2: u64 = base_ids()
    fill(ids2, 0, 15, 3, 3, 0, 15, WATER)
    var w2: mc_world.World = mc_world.world_new()
    publish(&w2, ids2)
    var sh: mc_input.Player = new_player(8.5, 0.0 - 61.0, 4.5)
    walk(&sh, &w2, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 30)
    check(!sh.swimming && !sh.low_pose, 8)
    mc_world.world_free(&w2)

    var w3: mc_world.World = tunnel_world()
    var wk: mc_input.Player = new_player(8.5, 0.0 - 60.9, 1.0)
    walk(&wk, &w3, &tb, mc_input.K_FORWARD, 80)
    check(wk.z < 5.8, 9)
    check(!wk.low_pose, 10)
    mc_world.world_free(&w3)

    var w4: mc_world.World = tunnel_world()
    var t: mc_input.Player = new_player(8.5, 0.0 - 60.9, 1.0)
    var n: i32 = 0
    while t.z < 8.0 && n < 100 {
        tick(&t, &w4, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT)
        n = n + 1
    }
    check(t.z >= 8.0, 11)
    check(t.swimming && t.low_pose, 12)
    check(t.y > 0.0 - 61.01 && t.y < 0.0 - 60.5, 13)
    walk(&t, &w4, &tb, 0 as u32, 2)
    check(!t.swimming && t.low_pose, 14)
    check(near(mc_input.player_eye(&t), 0.4), 15)
    n = 0
    while t.z < 10.4 && n < 100 {
        tick(&t, &w4, &tb, mc_input.K_FORWARD)
        n = n + 1
    }
    check(t.z >= 10.4, 16)
    walk(&t, &w4, &tb, mc_input.K_FORWARD, 2)
    check(!t.low_pose, 17)
    check(near(mc_input.player_eye(&t), 1.62), 18)
    mc_world.world_free(&w4)

    if g_fail != 0 { return 1 }
    return 0
}
