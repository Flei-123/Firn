// expect_exit: 42
// Round GAPS: `A | B | C =>` -- alternatives in a match arm. Covers a dense
// integer match (one jump table, several keys per arm), named constants,
// ranges, bool, enum variants (exhaustiveness looks through the
// alternatives) and alternatives that still need a residual test
// (a payload pattern, a wide range).
const OP_ADD: i32 = 3
const OP_SUB: i32 = 4
const OP_MUL: i32 = 5

enum Tok {
    Num(i32),
    Plus,
    Minus,
    Star,
    End,
}

fn kind(op: i32) -> i32 {
    var r: i32 = 0
    match op {
        0 | 1 | 2 => { r = 1 }
        OP_ADD | OP_SUB => { r = 2 }
        OP_MUL | 6 | 7 => { r = 3 }
        8..= 10 | 12 => { r = 4 }
        _ => { r = 9 }
    }
    return r
}

fn wide(x: i64) -> i32 {
    var r: i32 = 0
    match x {
        -5 | 1000..= 5000000 => { r = 1 }
        7 => { r = 2 }
        _ => { r = 3 }
    }
    return r
}

fn is_op(t: Tok) -> i32 {
    var r: i32 = 0
    match t {
        Tok::Plus | Tok::Minus | Tok::Star => { r = 1 }
        Tok::Num(0) | Tok::End => { r = 2 }
        Tok::Num(_) => { r = 3 }
    }
    return r
}

fn truth(b: bool) -> i32 {
    var r: i32 = 0
    match b {
        true | false => { r = 5 }
    }
    return r
}

fn main() -> i32 {
    var s: i32 = 0
    // kind: 0..13 -> 1 1 1 2 2 3 3 3 4 4 4 9 4 9 = 50
    var i: i32 = 0
    while i < 14 {
        s = s + kind(i)
        i = i + 1
    }
    if s != 50 { return 1 as i32 }
    if wide(-5) != 1 || wide(1000) != 1 || wide(5000000) != 1 { return 2 as i32 }
    if wide(999) != 3 || wide(7) != 2 || wide(5000001) != 3 { return 3 as i32 }
    if is_op(Tok::Plus) != 1 || is_op(Tok::Star) != 1 || is_op(Tok::Minus) != 1 { return 4 as i32 }
    if is_op(Tok::Num(0)) != 2 || is_op(Tok::End) != 2 || is_op(Tok::Num(4)) != 3 { return 5 as i32 }
    if truth(true) + truth(false) != 10 { return 6 as i32 }
    return 42 as i32
}
