// expect_exit: 0
// DESIGN_GOALS 2: GC allocation is fallible too. When the heap is exhausted,
// it FIRST collects and THEN reports `AllocError::OutOfMemory`.
gc class Chunk {
    next: Gc[Chunk],
    fill: [u8; 1024],
}

// Keeps the whole chain alive -- the collector cannot free anything.
fn chain_build(n: i64) -> AllocError!u32 {
    var header: Gc[Chunk] = gc_null[Chunk]()
    var i: i64 = 0
    while i < n {
        header = try gc Chunk { next: header, fill: [0; 1024] }
        i = i + 1
    }
    if header == gc_null[Chunk]() {
        return 5
    }
    return 0
}

// DEPTH PADDING (round 47): the conservative stack scan (SPEC 3.5.3) reads
// dead frames as roots as far as `__gc_scrub` no longer reaches them -- it
// only clears BELOW its own frame, and the topmost words under the stack
// pointer of the program are occupied later by `gc_collect` and `__gc_scrub`
// themselves. A helper called SHALLOW puts its pointers exactly there.
// That is why the actual helper is called kilobytes deeper: recursively (so
// it is never inlined) and with padding.
fn deep(n: i64, t: u64) -> AllocError!u32 {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var i: u64 = 0
    while i < 128 {
        *((fp + i * 8) as *mut u64) = i
        i = i + 1
    }
    if t > 0 {
        return try deep(n, t - 1)
    }
    return try chain_build(n)
}

fn is_oom(e: AllocError) -> u32 {
    if e == AllocError::OutOfMemory {
        return 1
    }
    return 2
}

fn main() -> i32 {
    if !gc_init() {
        return 9
    }
    // Memory limit as for one tab: 256 KiB.
    gc_set_max_bytes(262144)
    let r = deep(100000, 2) catch | e | is_oom(e)
    if r != 1 {
        return 1
    }
    // Before the error it really did collect.
    if gc_collections() == 0 {
        return 2
    }
    if gc_heap_bytes() > 262144 {
        return 3
    }
    // After letting go of the chain there is room again.
    gc_collect()
    if gc_live_objects() > 8 {
        return 4
    }
    if (deep(10, 2) catch 7) != 0 {
        return 5
    }
    return 0
}
