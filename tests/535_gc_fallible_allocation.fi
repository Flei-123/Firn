// expect_exit: 0
// DESIGN_GOALS §2: auch die GC-Allokation ist fehlbar. Bei erschoepftem Heap
// wird ERST gesammelt und DANN `AllocError::OutOfMemory` gemeldet.
gc class Chunk {
    next: Gc[Chunk],
    fill: [u8; 1024],
}

// Haelt die ganze Kette am Leben — der Sammler kann nichts freigeben.
fn chain_build(n: i64) -> AllocError!u32 {
    var header: Gc[Chunk] = gc_null[Chunk]()
    var i: i64 = 0
    while i < n {
        header = try gc Chunk{ next: header, fill: [0; 1024] }
        i = i + 1
    }
    if header == gc_null[Chunk]() {
        return 5
    }
    return 0
}

// TIEFENPOLSTER (Runde 47): der konservative Stapelscan (SPEC 3.5.3) liest
// tote Rahmen als Wurzeln, soweit `__gc_scrub` sie nicht mehr erreicht — es
// nullt nur UNTERHALB seines eigenen Rahmens, und die obersten Worte unter dem
// Stapelzeiger des Programms belegen spaeter `gc_collect` und `__gc_scrub`
// selbst. Ein FLACH aufgerufener Helfer legt seine Zeiger genau dort ab.
// Deshalb wird der eigentliche Helfer kilobyteweise tiefer aufgerufen:
// rekursiv (wird also nie eingebettet) und mit Polster.
fn deep(n: i64, t: u64) -> AllocError!u32 {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var i: u64 = 0
    while i < 128 {
        *((fp + i * 8) as *mut u64) = i
        i = i + 1
    }
    if t > 0 {
        return try deep(n, t - 1)
    }
    return try chain_build(n)
}

fn is_oom(e: AllocError) -> u32 {
    if e == AllocError::OutOfMemory {
        return 1
    }
    return 2
}

fn main() -> i32 {
    if !gc_init() {
        return 9
    }
    // Speichergrenze wie fuer einen Tab: 256 KiB.
    gc_set_max_bytes(262144)
    let r = deep(100000, 2) catch |e| is_oom(e)
    if r != 1 {
        return 1
    }
    // Vor dem Fehler wurde wirklich gesammelt.
    if gc_collections() == 0 {
        return 2
    }
    if gc_heap_bytes() > 262144 {
        return 3
    }
    // Nach dem Loslassen der Kette ist wieder Platz.
    gc_collect()
    if gc_live_objects() > 8 {
        return 4
    }
    if (deep(10, 2) catch 7) != 0 {
        return 5
    }
    return 0
}
