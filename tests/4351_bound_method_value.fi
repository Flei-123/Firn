// expect_exit: 0
// tests/4351_bound_method_value.fi -- r750: `try x.m` (method of a pointer receiver, no call) is a closure
// `try gc |a..| x.m(a..)` that captures the receiver pointer.

// (the GC runtime that declares AllocError is pulled in by this import; the source has no `gc` token)
import std.vec

struct Acc {
    total: i64,
}

impl Acc {
    fn add(*mut self, x: i64) -> i64 {
        (*self).total = (*self).total + x
        return (*self).total
    }
    fn reset(*mut self) {
        (*self).total = 0
    }
    fn mix(*self, a: i64, b: i64) -> i64 {
        return (*self).total * 100 + a * 10 + b
    }
}

fn apply(f: fn(i64) -> i64, v: i64) -> i64 {
    return f(v)
}

struct Hook {
    f: fn(i64) -> i64,
}

fn make(p: *mut Acc) -> AllocError!fn(i64) -> i64 {
    return try p.add
}

fn run() -> AllocError!i32 {
    var acc: Acc = Acc { total: 0 }
    let p: *mut Acc = &acc
    // expected type from the parameter
    if apply(try p.add, 5) != 5 { return 1 }
    // expected type from a `let`
    let f: fn(i64) -> i64 = try p.add
    if f(7) != 12 || acc.total != 12 { return 2 }
    // no expected type: the signature of the method gives it
    let g = try p.add
    if g(8) != 20 { return 3 }
    // several parameters, `*self` receiver
    let h = try p.mix
    if h(2, 3) != 2023 { return 4 }
    // no result
    let r = try p.reset
    r()
    if acc.total != 0 { return 5 }
    // struct field and return
    let k = Hook { f: try p.add }
    if k.f(4) != 4 { return 6 }
    let m = try make(p)
    if m(6) != 10 { return 7 }
    return 0
}

fn main() -> i32 {
    let r: i32 = run() catch 99
    return r
}
