// expect_exit: 0
import std.rt
import std.fs
import fui.kpcodecvid
import media.video.vidops

fn count_frames(path: str, w: u32, h: u32) -> i64 {
    var b: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(path, &b) catch | e | (0 -% 1)
    if got == (0 -% 1) {
        return -1
    }
    let ops: vidops.VideoOps = kpcodecvid.video_ops()
    let hd: u64 = ops.create()
    if ops.open(hd, b.ptr, rt.buf_len(&b)) != vidops.VO_OK {
        ops.destroy(hd)
        return -2
    }
    if ops.width(hd) != w || ops.height(hd) != h {
        return -3
    }
    let out: u64 = rt.heap_alloc(ops.rgba_bytes(hd)) as u64
    var pts: i64 = 0
    var n: i64 = 0
    while ops.next_frame(hd, out, &pts) == 1 {
        n = n + 1
    }
    rt.heap_free(out, ops.rgba_bytes(hd))
    ops.close(hd)
    ops.destroy(hd)
    return n
}

fn main() -> i32 {
    if count_frames("testdata/media_video/vp8_inter_p0.webm", 64 as u32, 48 as u32) != 25 {
        return 1
    }
    if count_frames("testdata/media_video/vp8_inter_p3.webm", 48 as u32, 32 as u32) != 25 {
        return 2
    }
    if count_frames("testdata/media_video/vp8_inter_arf.webm", 64 as u32, 48 as u32) != 100 {
        return 3
    }
    if count_frames("testdata/media_video/av_main.mp4", 0 as u32, 0 as u32) != -3 {
        return 4
    }
    return 0
}
