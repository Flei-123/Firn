// expect_exit: 0
// tests/3351_mc_input_sneak.fi -- sneak edge clamp (vanilla maybeBackOffFromEdge): a sneaking player on the ground does not walk off a ledge,
// the walk speed is cut in 0.05 steps while no floor is within stepHeight below; walking normally falls, sneaking along the edge is free.
// expect_exit: 0
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_input
import mc.mc_math

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.00001
}

// floor y = -64..-61 (layers 0..3 of 32); block id `id` at layer 4 (y = -60) for z in [z0, z1) on every x
fn make_world(w: *mut mc_world.World, id: u16, z0: i32, z1: i32) {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    i = 0
    while i < 4 * 256 {
        rt.st16(ids, i, 1 as u16)
        i = i + 1
    }
    var z: i32 = z0
    while z < z1 {
        var x: i32 = 0
        while x < 16 {
            rt.st16(ids, ((4 * 16 + z) * 16 + x) as usize, id)
            x = x + 1
        }
        z = z + 1
    }
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

fn walk(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) {
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = keys
    var t: i32 = 0
    while t < ticks {
        mc_input.player_tick(p, &ev, w, tb, 0 - 64)
        t = t + 1
    }
}

fn box_eq(c: i32, i: i32, x0: f64, y0: f64, z0: f64, x1: f64, y1: f64, z1: f64) -> bool {
    var b: mc_math.Aabb = mc_math.Aabb { x0: 0.0, y0: 0.0, z0: 0.0, x1: 0.0, y1: 0.0, z1: 0.0 }
    mc_math.shape_box(c, i, &b)
    return near(b.x0, x0) && near(b.y0, y0) && near(b.z0, z0) && near(b.x1, x1) && near(b.y1, y1) && near(b.z1, z1)
}

// floor layers 0..3 (y -64..-61) only for z < zmax
fn make_ledge(w: *mut mc_world.World, zmax: i32) {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    var y: i32 = 0
    while y < 4 {
        var z: i32 = 0
        while z < zmax {
            var x: i32 = 0
            while x < 16 {
                rt.st16(ids, ((y * 16 + z) * 16 + x) as usize, 1 as u16)
                x = x + 1
            }
            z = z + 1
        }
        y = y + 1
    }
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

// like make_ledge, but behind the edge (z >= 10) the floor is a bottom slab at layer 3: a drop of only 0.5 (< stepHeight)
fn make_slab_drop(w: *mut mc_world.World) {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    var y: i32 = 0
    while y < 4 {
        var z: i32 = 0
        while z < 16 {
            var x: i32 = 0
            while x < 16 {
                var id: u16 = 1 as u16
                if y == 3 && z >= 10 { id = 2 as u16 }
                rt.st16(ids, ((y * 16 + z) * 16 + x) as usize, id)
                x = x + 1
            }
            z = z + 1
        }
        y = y + 1
    }
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

// floor only on the two cells (9, 10) and (10, 9) (diagonal neighbours): a diagonal move can leave the support while each axis alone cannot
fn make_diagonal(w: *mut mc_world.World) {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    var y: i32 = 0
    while y < 4 {
        rt.st16(ids, ((y * 16 + 10) * 16 + 9) as usize, 1 as u16)
        rt.st16(ids, ((y * 16 + 9) * 16 + 10) as usize, 1 as u16)
        y = y + 1
    }
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

fn main() -> i32 {
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(8), solid: rt.heap_alloc(16), n: 8 }
    var i: usize = 0
    while i < 8 {
        rt.st8(tb.pick, i, 1 as u8)
        rt.st16(tb.solid, i, 1 as u16)
        i = i + 1
    }
    rt.st16(tb.solid, 0, 0 as u16)
    rt.st16(tb.solid, 2, (mc_math.SHAPE_BASE + 1) as u16) // bottom slab
    let SN: u32 = mc_input.K_SNEAK

    // ledge at z = 10; walking normally goes over the edge and falls
    var w: mc_world.World = mc_world.world_new()
    make_ledge(&w, 10)
    var a: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 6.5)
    walk(&a, &w, &tb, 0 as u32, 2)
    check(near(a.y, 0.0 - 60.0) && a.on_ground, 1)
    walk(&a, &w, &tb, mc_input.K_FORWARD, 40)
    check(a.y < 0.0 - 61.0 && a.z > 10.0, 2)

    // sneaking forward stops at the edge: the box keeps overlapping the floor, centre z < 10.3
    var s: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 6.5)
    walk(&s, &w, &tb, 0 as u32, 2)
    walk(&s, &w, &tb, mc_input.K_FORWARD | SN, 120)
    check(near(s.y, 0.0 - 60.0) && s.on_ground && s.z > 10.2 && s.z < 10.3, 3)
    walk(&s, &w, &tb, mc_input.K_FORWARD | SN, 40)
    check(near(s.y, 0.0 - 60.0) && s.on_ground && s.z < 10.3, 4)

    // exact clamp: 0.0648 cut to 0.0148 (one 0.05 step) at z = 10.25
    var e: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 10.25)
    walk(&e, &w, &tb, 0 as u32, 2)
    walk(&e, &w, &tb, mc_input.K_FORWARD | SN, 1)
    check(near(e.z, 10.25 + 0.0294), 5)

    // sneaking along the edge (right = -x at yaw 0) is free
    var m: mc_input.Player = mc_input.player_new(12.5, 0.0 - 60.0, 10.2)
    walk(&m, &w, &tb, 0 as u32, 2)
    walk(&m, &w, &tb, mc_input.K_RIGHT | SN, 40)
    check(near(m.y, 0.0 - 60.0) && m.x < 12.5 - 2.0 && near(m.z, 10.2), 6)

    // diagonal sneak into the edge: z is cut, x slides on
    var dg: mc_input.Player = mc_input.player_new(12.5, 0.0 - 60.0, 10.2)
    walk(&dg, &w, &tb, 0 as u32, 2)
    walk(&dg, &w, &tb, mc_input.K_FORWARD | mc_input.K_RIGHT | SN, 60)
    check(near(dg.y, 0.0 - 60.0) && dg.on_ground && dg.z < 10.3 && dg.x < 11.0, 7)

    // sneaking backwards from the edge works, and sneaking on a wide floor is plain slow walking (0.0648 per tick)
    var f: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 3.5)
    walk(&f, &w, &tb, 0 as u32, 2)
    walk(&f, &w, &tb, mc_input.K_FORWARD | SN, 10)
    check(near(f.z, 3.5 + 0.56988018), 8)

    // flying + sneak (descend) is not clamped: fly off the edge
    var fl: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 9.0)
    fl.flying = true
    walk(&fl, &w, &tb, mc_input.K_FORWARD, 20)
    check(fl.z > 10.5, 9)

    // a drop of 0.5 (floor within stepHeight below) is NOT an edge: sneaking walks down onto the slab and on
    var ws: mc_world.World = mc_world.world_new()
    make_slab_drop(&ws)
    var sd: mc_input.Player = mc_input.player_new(8.5, 0.0 - 60.0, 6.5)
    walk(&sd, &ws, &tb, 0 as u32, 2)
    walk(&sd, &ws, &tb, mc_input.K_FORWARD | SN, 100)
    check(near(sd.y, 0.0 - 60.5) && sd.on_ground && sd.z > 11.0, 10)

    // diagonal clamp (third loop): x alone and z alone keep support, both together would not -> the move is cut to 0
    var wd: mc_world.World = mc_world.world_new()
    make_diagonal(&wd)
    var dd: mc_input.Player = mc_input.player_new(10.27, 0.0 - 60.0, 10.27)
    walk(&dd, &wd, &tb, 0 as u32, 2)
    check(near(dd.y, 0.0 - 60.0) && dd.on_ground, 11)
    walk(&dd, &wd, &tb, mc_input.K_FORWARD | mc_input.K_LEFT | SN, 12)
    check(near(dd.y, 0.0 - 60.0) && dd.on_ground && dd.x < 10.45 && dd.z < 10.45, 12)
    var dn: mc_input.Player = mc_input.player_new(10.27, 0.0 - 60.0, 10.27)
    walk(&dn, &wd, &tb, 0 as u32, 2)
    walk(&dn, &wd, &tb, mc_input.K_FORWARD | mc_input.K_LEFT, 1)
    check(dn.x > 10.3 && dn.z > 10.3, 13) // without sneaking the same step moves
    return g_fail
}
