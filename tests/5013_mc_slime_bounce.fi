// expect_exit: 0
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_input
import mc.mc_bounce
import mc.mc_slide

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000000001
}

fn near2(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0005
}

fn put(ids: u64, x: i32, ly: i32, z: i32, id: u16) {
    rt.st16(ids, ((ly * 16 + z) * 16 + x) as usize, id)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

fn publish(w: *mut mc_world.World, ids: u64) {
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

fn fill(ids: u64, x0: i32, x1: i32, ly0: i32, ly1: i32, z0: i32, z1: i32, id: u16) {
    var ly: i32 = ly0
    while ly <= ly1 {
        var z: i32 = z0
        while z <= z1 {
            var x: i32 = x0
            while x <= x1 {
                put(ids, x, ly, z, id)
                x = x + 1
            }
            z = z + 1
        }
        ly = ly + 1
    }
}

fn tick(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32) {
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = keys
    mc_input.player_tick(p, &ev, w, tb, 0 - 64)
}

fn walk(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) {
    var t: i32 = 0
    while t < ticks {
        tick(p, w, tb, keys)
        t = t + 1
    }
}

const STONE: u16 = 1 as u16
const SLIME: u16 = 3 as u16

fn new_player(x: f64, y: f64, z: f64) -> mc_input.Player {
    var p: mc_input.Player = mc_input.player_new(x, y, z)
    rt.st8(p.mv, SLIME as usize, mc_slide.MV_SLIME as u8)
    return p
}

fn drop_to_ground(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, pre_vy: *mut f64) -> bool {
    var t: i32 = 0
    while t < 80 {
        *pre_vy = (*p).vy
        tick(p, w, tb, keys)
        if (*p).on_ground { return true }
        t = t + 1
    }
    return false
}

fn peak_after(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) -> f64 {
    var top: f64 = (*p).y
    var t: i32 = 0
    while t < ticks {
        tick(p, w, tb, keys)
        if (*p).y > top { top = (*p).y }
        t = t + 1
    }
    return top
}

fn main() -> i32 {
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(8), solid: rt.heap_alloc(16), n: 8 }
    var i: usize = 0
    while i < 8 {
        rt.st8(tb.pick, i, 1 as u8)
        rt.st16(tb.solid, i, 0 as u16)
        i = i + 1
    }
    rt.st16(tb.solid, STONE as usize, 1 as u16)
    rt.st16(tb.solid, SLIME as usize, 1 as u16)

    let ids: u64 = new_ids()
    fill(ids, 0, 15, 0, 2, 0, 15, STONE)
    fill(ids, 0, 7, 2, 2, 0, 15, SLIME)
    var w: mc_world.World = mc_world.world_new()
    publish(&w, ids)

    check(mc_bounce.bounces(mc_slide.MV_SLIME, false), 1)
    check(!mc_bounce.bounces(mc_slide.MV_SLIME, true), 2)
    check(!mc_bounce.bounces(mc_slide.MV_ICE, false), 3)
    check(near(mc_bounce.landed_vy(mc_slide.MV_SLIME, 0.0 - 1.0, false, true), 1.0), 4)
    check(near(mc_bounce.landed_vy(mc_slide.MV_SLIME, 0.0 - 1.0, false, false), 0.8), 5)
    check(near(mc_bounce.landed_vy(mc_slide.MV_SLIME, 0.0 - 1.0, true, true), 0.0), 6)
    check(near(mc_bounce.landed_vy(mc_slide.MV_SLIME, 0.5, false, true), 0.0), 7)
    check(near(mc_bounce.landed_vy(0, 0.0 - 1.0, false, true), 0.0), 8)
    check(near(mc_bounce.fall_multiplier(mc_slide.MV_SLIME, false), 0.0), 9)
    check(near(mc_bounce.fall_multiplier(mc_slide.MV_SLIME, true), 1.0), 10)

    var a: mc_input.Player = new_player(4.5, 0.0 - 45.0, 4.5)
    var pre: f64 = 0.0
    check(drop_to_ground(&a, &w, &tb, 0 as u32, &pre), 11)
    check(pre < 0.0 - 1.0, 12)
    check(near(a.vy, (0.0 - pre - 0.08) * 0.9800000190734863), 13)
    check(a.vy > 1.0, 14)
    check(near(a.fall, 0.0), 15)
    let top_a: f64 = peak_after(&a, &w, &tb, 0 as u32, 60)
    check(top_a > 0.0 - 61.0 + 8.0, 16)
    check(top_a < 0.0 - 45.0 + 0.5, 25)

    var s: mc_input.Player = new_player(4.5, 0.0 - 45.0, 4.5)
    var pre_s: f64 = 0.0
    check(drop_to_ground(&s, &w, &tb, mc_input.K_SNEAK, &pre_s), 17)
    check(s.vy < 0.0, 18)
    let top_s: f64 = peak_after(&s, &w, &tb, mc_input.K_SNEAK, 40)
    check(top_s < 0.0 - 61.0 + 0.05, 19)
    check(s.on_ground, 20)

    var c: mc_input.Player = new_player(12.5, 0.0 - 45.0, 4.5)
    var pre_c: f64 = 0.0
    check(drop_to_ground(&c, &w, &tb, 0 as u32, &pre_c), 21)
    check(c.vy < 0.0, 22)
    let top_c: f64 = peak_after(&c, &w, &tb, 0 as u32, 40)
    check(top_c < 0.0 - 61.0 + 0.05, 23)

    var rest: mc_input.Player = new_player(4.5, 0.0 - 60.9, 4.5)
    walk(&rest, &w, &tb, 0 as u32, 40)
    check(rest.y > 0.0 - 61.05 && rest.y < 0.0 - 60.9, 24)

    if g_fail != 0 { return 1 }
    return 0
}
