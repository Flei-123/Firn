// expect_exit: 0
// wasm_skip: raw system calls (sockets) in lib/tls/tlsmini.fi
// push hello: tlsm_write refuses what it cannot send without touching a
// socket: a session that is not protected yet, an empty write, one over
// 1024 octets. (The records themselves are checked against OpenSSL by
// tools/tls/mini_check.py.)
import tls.tlsmini

#[no_gc]
fn write_fresh(n: usize) -> bool {
    var t: tlsmini.TlsM = tlsmini.tlsm_new()
    var b: [u8; 8] = [0 as u8; 8]
    return tlsmini.tlsm_write(&t, (&b[0]) as u64, n)
}

fn main() -> i32 {
    if write_fresh(4) {
        return 1
    }
    if write_fresh(0) {
        return 2
    }
    if write_fresh(1025) {
        return 3
    }
    return 0
}
