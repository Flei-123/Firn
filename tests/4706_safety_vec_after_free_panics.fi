// expect_exit: 101
// not_mode: opt
// r899: vec_free resets len to 0, so an index after the free is an ordinary out-of-bounds panic.
import std.rt
import std.vec

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 5)
    vec_free[i32](&v)
    var i: usize = 0
    return v[i]
}
