// expect_exit: 0
// Smaller additions of the Certus fork to the collector runtime:
//   * the time sums and counters per phase (`gc_time_by_phase`,
//     `gc_slices_by_phase`, `gc_scan_words`, `gc_swept`, `gc_freed`) -- they
//     also prove that the clock works (the vDSO path reads the monotonic
//     clock without a system call; a broken lookup would show as a zero or
//     a negative, i.e. gigantic, duration),
//   * `gc_cycle_finish` -- finishes a RUNNING cycle and is a no-op when none
//     runs (the Android host calls it where a full run was far too slow),
//   * `gc_bottom_swap` -- swaps the stack bottom the collector scans to, for
//     a coroutine on a stack of its own.

gc class Item {
    next: Gc[Item],
    v: u64,
}

fn chain(n: u64) -> AllocError!Gc[Item] {
    var head: Gc[Item] = gc_null[Item]()
    var i: u64 = 0
    while i < n {
        head = try gc Item { next: head, v: i }
        i = i + 1
    }
    return head
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    // nothing runs yet: finishing is a no-op and must not crash or count
    gc_cycle_finish()
    if gc_collections() != 0 {
        return 1
    }

    // garbage and a live chain, then a full run
    var i: u64 = 0
    while i < 20 {
        let junk = chain(5000) catch gc_null[Item]()
        if junk == gc_null[Item]() {
            return 91
        }
        i = i + 1
    }
    let keep = chain(1000) catch gc_null[Item]()
    if keep == gc_null[Item]() {
        return 92
    }
    gc_collect()
    gc_cycle_finish()

    // the clock: the full run took a measurable time, and not an absurd one
    let full: u64 = gc_time_by_phase(4)
    if full == 0 {
        return 2
    }
    if full > 60000000000 {
        return 3
    }
    if gc_slices_by_phase(4) == 0 {
        return 4
    }
    if gc_time_by_phase(5) != 0 {
        // an unknown phase answers 0
        return 5
    }
    // the root scan looked at words, the sweep looked at blocks and freed
    // the garbage
    if gc_scan_words() == 0 {
        return 6
    }
    if gc_swept() == 0 {
        return 7
    }
    if gc_freed() == 0 {
        return 8
    }
    if gc_freed() > gc_swept() {
        return 9
    }
    if gc_pause_ns_max() > 60000000000 {
        return 10
    }

    // the stack bottom: swapping returns the previous value, swapping back
    // restores it; a collection afterwards still works
    let marker: u64 = 4096
    let old: u64 = gc_bottom_swap(marker)
    let back: u64 = gc_bottom_swap(old)
    if back != marker {
        return 11
    }
    gc_collect()
    var c: Gc[Item] = keep
    var n: u64 = 0
    while c != gc_null[Item]() {
        n = n + 1
        c = c.next
    }
    if n != 1000 {
        return 12
    }
    return 0
}
