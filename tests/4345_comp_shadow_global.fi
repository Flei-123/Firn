// expect_exit: 0
// tests/4345_comp_shadow_global.fi -- a comprehension variable that shadows a global of the same
// name in a NON-root module (firnc1 read it as the global: element parsed before the loop).
import std.vec
import modules.comp_shadow

fn main() -> i32 {
    var v: Vec[i64] = vec_new[i64]()
    vec_push[i64](&v, 1)
    vec_push[i64](&v, 3)
    vec_push[i64](&v, 5)
    var a: Vec[i64] = comp_shadow.squares(&v)
    if vec_len[i64](&a) != 3 || vec_at[i64](&a, 0) != 1 || vec_at[i64](&a, 1) != 9 || vec_at[i64](&a, 2) != 25 {
        return 1
    }
    var b: Vec[i64] = comp_shadow.doubled(&v)
    if vec_len[i64](&b) != 2 || vec_at[i64](&b, 0) != 2 || vec_at[i64](&b, 1) != 10 {
        return 2
    }
    if comp_shadow.k != 100 {
        return 3
    }
    return 0
}
