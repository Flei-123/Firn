// expect_exit: 0
// tests/1180_layout_position.fi -- position: fixed, sticky and the initial containing block.
//
// #f   `position: fixed` measures against the VIEWPORT, and no
//      `position: relative` around it changes that: it sits at
//      (10, 20) although its parent stands at (30, 440).
// #k   `position: sticky` is pulled BACK into view, never pushed out
//      of it: `top: 60px` on a box whose flow position is y = 0
//      moves it down to 60 and no further than its containing block.
// #a   `position: absolute` with no positioned ancestor measures
//      against the INITIAL containing block, which is the window and
//      not the root box: `bottom: 0` is y = 540 in a 600 px window,
//      although the document is only 500 px tall.
//
// THE NUMBERS IN THIS FILE ARE COMPUTED BY HAND from CSS 2.1,
// css-position-3, css-flexbox-1 and css-sizing-3 -- not read off the
// engine. They were held against Chromium ONCE afterwards (the same
// document is a case in tools/layout/cases/), so that no arithmetic slip
// of the author is frozen into a test.
//
// The return value names the first check that fails.
import html.mem
import browser.node
import browser.names
import browser.driver
import css.tok
import css.cv
import css.sel
import css.cascade
import layout.box
import layout.build
import layout.flow

const SOURCE_LEN: usize = 144
const SHEET_LEN: usize = 317

#[no_gc]
fn source(out: *mut mem.Buf) {
    var t: [u8; 144] = "<!DOCTYPE html><html><head></head><body><div id=\"s\"><div id=\"k\"></div></div><div id=\"r\"><div id=\"f\"></div></div><div id=\"a\"></div></body></html>"
    mem.buf_clear(out)
    var i: usize = 0
    while i < SOURCE_LEN {
        mem.buf_push(out, t[i])
        i = i + 1
    }
}

#[no_gc]
fn sheet(out: *mut mem.CpBuf) {
    var t: [u8; 317] = "html,body,div{display:block;margin:0;padding:0;border:0}html{font-size:20px}#r{position:relative;left:30px;top:40px;width:200px;height:100px}#f{position:fixed;left:10px;top:20px;width:50px;height:60px}#s{height:400px}#k{position:sticky;top:60px;height:50px}#a{position:absolute;bottom:0;left:0;width:50px;height:60px}"
    mem.cp_clear(out)
    var i: usize = 0
    while i < SHEET_LEN {
        mem.cp_push(out, t[i] as u32)
        i = i + 1
    }
}

fn next_in_order(k: Gc[Node], root: Gc[Node]) -> Gc[Node] {
    if k.first_child != gc_null[Node]() {
        return k.first_child
    }
    var c: Gc[Node] = k
    while c != gc_null[Node]() && c != root {
        if c.next != gc_null[Node]() {
            return c.next
        }
        c = c.parent
    }
    return gc_null[Node]()
}

// The n-th elem in document order -- the same order the driver and a
// browser walk in, so an index here means the same thing everywhere.
fn elem_at(doc: Gc[Node], want: u64) -> Gc[Node] {
    var k: Gc[Node] = doc
    var i: u64 = 0
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            if i == want {
                return k
            }
            i = i + 1
        }
        k = next_in_order(k, doc)
    }
    return gc_null[Node]()
}

fn find_box(b: Gc[Box], k: Gc[Node]) -> Gc[Box] {
    if b.elem == k {
        return b
    }
    var i: u64 = 0
    while i < box.box_kids(b) {
        let r: Gc[Box] = find_box(box.box_kid(b, i), k)
        if r != gc_null[Box]() {
            return r
        }
        i = i + 1
    }
    return gc_null[Box]()
}

// Equal to a thousandth of a pixel. The engine computes in a grid of
// 1/64 px, so anything below that cannot be a difference of the algorithm.
fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d < 0.001
}

fn check(root: Gc[Box], doc: Gc[Node], index: u64, x: f64, y: f64,
    w: f64, h: f64) -> bool {
    let k: Gc[Node] = elem_at(doc, index)
    if k == gc_null[Node]() {
        return false
    }
    let b: Gc[Box] = find_box(root, k)
    if b == gc_null[Box]() {
        return false
    }
    return near(b.x, x) && near(b.y, y) && near(b.w, w) && near(b.h, h)
}

// The whole path in one call: HTML to DOM, CSS to rules, cascade, box
// tree, layout. Exactly what lib/layout/layout_main.fi does.
fn lay_out(l: *mut driver.Run, src: *mut mem.Buf, css: *mut mem.CpBuf,
    t: *mut tok.Tokens, tmp: *mut mem.CpBuf, cx: *mut sel.Ctx,
    w: *mut cascade.Winner, doc_out: *mut Gc[Node])
-> AllocError!Gc[Box] {
    driver.run_text_out_bytes(l, mem.buf_ptr(src), mem.buf_len(src))
    let rc: u32 = driver.run_document_build(l)
    if rc != 0 as u32 {
        return gc_null[Box]()
    }
    let doc: Gc[Document] = driver.run_document(l)
    let nm: *mut names.Names = driver.run_names(l)
    tok.tokenize(t, css)
    var p: cv.Parser = cv.parser_new(t)
    let sheet_tree = try cv.parse_stylesheet(&p)
    var order: u32 = 0
    let rules = try cascade.collect_rules(sheet_tree, cascade.ORIGIN_AUTHOR, 0,
        nm, tmp, &order)
    let styles = try gcmap_new(true, true)
    let root_style = try cascade.style_root()
    var k: Gc[Node] = doc
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            var parent_style: Gc[Style] = root_style
            let parent: Gc[Node] = k.parent
            if parent != gc_null[Node]() && parent.kind == node.K_ELEM {
                let found: Gc[Style] = gcmap_get_value[Style](styles,
                    parent as u64)
                if found != gc_null[Style]() {
                    parent_style = found
                }
            }
            let s = try cascade.cascade_elem(rules, k, parent_style, cx, w)
            let ok: bool = try gcmap_set_value[Style](styles, k as u64, s)
        }
        k = next_in_order(k, doc)
    }
    let root = try build.build_document(doc, styles, root_style, nm)
    if root == gc_null[Box]() {
        return gc_null[Box]()
    }
    let okl: bool = try flow.layout_document(root, 800.0, 600.0)
    *doc_out = doc
    return root
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    var src: mem.Buf = mem.buf_new()
    mem.buf_init(&src)
    source(&src)
    var css: mem.CpBuf = mem.cp_new()
    mem.cp_init(&css)
    sheet(&css)
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var tmp: mem.CpBuf = mem.cp_new()
    var l: driver.Run = driver.run_new()
    if !driver.run_init(&l) {
        return 91
    }
    var cx: sel.Ctx = sel.ctx_new(driver.run_names(&l))
    sel.ctx_init(&cx)
    var w: cascade.Winner = cascade.winner_new()
    var doc: Gc[Node] = gc_null[Node]()
    let root: Gc[Box] = lay_out(&l, &src, &css, &t, &tmp, &cx, &w, &doc)
    catch gc_null[Box]()
    if root == gc_null[Box]() || doc == gc_null[Node]() {
        return 92
    }
    // the root: 400 + 100, the out-of-flow boxes add nothing
    if !check(root, doc, 0, 0.0000, 0.0000, 800.0000, 500.0000) {
        return 1
    }
    // the body, the same
    if !check(root, doc, 2, 0.0000, 0.0000, 800.0000, 500.0000) {
        return 2
    }
    // #s
    if !check(root, doc, 3, 0.0000, 0.0000, 800.0000, 400.0000) {
        return 3
    }
    // #k: stuck at top = 60, not at its flow position 0
    if !check(root, doc, 4, 0.0000, 60.0000, 800.0000, 50.0000) {
        return 4
    }
    // #r: relative, moved by (30, 40) out of y = 400
    if !check(root, doc, 5, 30.0000, 440.0000, 200.0000, 100.0000) {
        return 5
    }
    // #f: fixed against the window, NOT against #r
    if !check(root, doc, 6, 10.0000, 20.0000, 50.0000, 60.0000) {
        return 6
    }
    // #a: bottom 0 of the 600 px window
    if !check(root, doc, 7, 0.0000, 540.0000, 50.0000, 60.0000) {
        return 7
    }
    return 0
}
