// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_entity
import mc.mc_entity_draw
import mc.mc_hurt_tint
import mc.mc_camera
import mc.mc_sem
import mc.mc_version
import mc.mc_combat_fx
import mc.v763.mc_proto_v763

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn spawn_object(s: *mut mc_entity.Store, ver: *mut mc_version.Version, id: i32, x: f64, y: f64, z: f64) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, id)
    bytes.put_uuid(&b, 1 as u64, id as u64)
    bytes.put_varint(&b, 5)
    bytes.put_f64(&b, x)
    bytes.put_f64(&b, y)
    bytes.put_f64(&b, z)
    bytes.put_i8(&b, 0 as i8)
    bytes.put_u8(&b, 0 as u8)
    bytes.put_i8(&b, 0 as i8)
    bytes.put_varint(&b, 0)
    bytes.put_i16(&b, 0 as i16)
    bytes.put_i16(&b, 0 as i16)
    bytes.put_i16(&b, 0 as i16)
    bytes.bytes_set_pos(&b, 0)
    let r: bool = mc_entity.entity_on_packet(s, ver, (*ver).sem[mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY], &b)
    bytes.bytes_free(&b)
    return r
}

fn rec_word(l: *mut mc_entity_draw.EntList, box: usize, w: usize) -> f64 {
    return *((rt.buf_ptr(&(*l).buf) + ((box * 12 + w) * 8) as u64) as *mut f64)
}

fn main() -> i32 {
    var t: mc_hurt_tint.HurtTable = mc_hurt_tint.hurt_new()
    check(mc_hurt_tint.hurt_age(&t, 7, 1000 as u64) < 0 && mc_hurt_tint.hurt_strength_permille(&t, 7, 1000 as u64) == 0, 1)
    mc_hurt_tint.hurt_mark(&t, 7, 1000 as u64)
    check(mc_hurt_tint.hurt_age(&t, 7, 1000 as u64) == 0 && mc_hurt_tint.hurt_age(&t, 7, 1499 as u64) == 499, 2)
    check(mc_hurt_tint.hurt_age(&t, 7, 1500 as u64) < 0 && mc_hurt_tint.hurt_age(&t, 7, 900 as u64) < 0, 3)
    check(mc_hurt_tint.hurt_age(&t, 8, 1100 as u64) < 0, 4)
    mc_hurt_tint.hurt_mark(&t, 7, 3000 as u64)
    check(mc_hurt_tint.hurt_age(&t, 7, 3100 as u64) == 100, 5)
    var i: i32 = 0
    while i < 20 {
        mc_hurt_tint.hurt_mark(&t, 100 + i, 5000 as u64)
        i = i + 1
    }
    check(mc_hurt_tint.hurt_age(&t, 119, 5100 as u64) == 100 && mc_hurt_tint.hurt_age(&t, 100, 5100 as u64) < 0, 6)
    let p: i32 = mc_hurt_tint.hurt_blend(100, 200, 50, 650)
    check((p & 255) >= 200 && ((p >> 8) & 255) < 80 && ((p >> 16) & 255) < 20, 7)
    check(mc_hurt_tint.hurt_blend(10, 20, 30, 0) == (10 | (20 << 8) | (30 << 16)), 8)

    var ver: mc_version.Version = mc_proto_v763.version_make()
    var s: mc_entity.Store = mc_entity.store_new()
    check(spawn_object(&s, &ver, 3, 0.0, 0.0, 5.0) && spawn_object(&s, &ver, 4, 1.0, 0.0, 5.0), 9)
    var cam: mc_camera.Camera = mc_camera.camera_new(64, 48)
    mc_camera.camera_set_pos(&cam, 0.0, 1.0, 0.0)
    mc_camera.camera_update(&cam)
    var l: mc_entity_draw.EntList = mc_entity_draw.entlist_new()
    mc_entity_draw.entlist_build(&l, &s, &cam, 64.0, 24.0)
    check(mc_entity_draw.entlist_boxes(&l) == 2, 10)
    let r0: f64 = rec_word(&l, 0, 8)
    let g0: f64 = rec_word(&l, 0, 9)
    let r1: f64 = rec_word(&l, 1, 8)
    let g1: f64 = rec_word(&l, 1, 9)
    let x0: f64 = rec_word(&l, 0, 0)

    var h: mc_hurt_tint.HurtTable = mc_hurt_tint.hurt_new()
    mc_hurt_tint.hurt_mark(&h, 3, 1000 as u64)
    mc_entity_draw.entlist_set_hurt(&l, &h, 1200 as u64)
    mc_entity_draw.entlist_build(&l, &s, &cam, 64.0, 24.0)
    var hurt_box: usize = 1
    var other_box: usize = 0
    if rec_word(&l, 0, 0) == x0 && x0 < 0.5 {
        hurt_box = 0
        other_box = 1
    }
    var hr: f64 = r1
    var hg: f64 = g1
    var orr: f64 = r0
    var og: f64 = g0
    if hurt_box == 0 {
        hr = r0
        hg = g0
        orr = r1
        og = g1
    }
    check(rec_word(&l, other_box, 8) == orr && rec_word(&l, other_box, 9) == og, 12)
    check(rec_word(&l, hurt_box, 8) > hr && rec_word(&l, hurt_box, 9) < hg, 13)
    mc_entity_draw.entlist_set_hurt(&l, &h, 1600 as u64)
    mc_entity_draw.entlist_build(&l, &s, &cam, 64.0, 24.0)
    check(rec_word(&l, 0, 8) == r0 && rec_word(&l, 1, 8) == r1 && l.tint_k == 0, 14)

    var fx: mc_combat_fx.CombatFx = mc_combat_fx.cfx_new()
    mc_combat_fx.cfx_on_hurt(&fx, 3, 99, 2000 as u64)
    check(mc_hurt_tint.hurt_age(&fx.tint, 3, 2100 as u64) == 100, 15)
    mc_combat_fx.cfx_on_hurt(&fx, 3, 99, 2050 as u64)
    check(mc_hurt_tint.hurt_age(&fx.tint, 3, 2100 as u64) == 100, 16)
    mc_combat_fx.cfx_on_hurt(&fx, 99, 99, 2200 as u64)
    check(mc_hurt_tint.hurt_age(&fx.tint, 99, 2300 as u64) == 100, 17)

    mc_entity_draw.entlist_free(&l)
    mc_entity.store_free(&s)
    return 0
}
