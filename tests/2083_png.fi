// expect_exit: 42
// tests/2083_png.fi -- lib/paint/png.fi, PNG in: every colour type with every
// legal bit depth (palette 1/2/4/8 with tRNS, grey 1..16 with a colour key,
// RGB/grey+alpha/RGBA at 8 and 16 bits), Adam7, and the refusals. The
// expectation (CRC-32 of the RGBA octets) was computed from the raw samples
// by tools/libmvp/pngmake.py, not by a decoder; tools/libmvp/check_png.py
// compares 185 generated files and the Modrinth icons octet for octet with
// Pillow (libpng) as well.
import paint.png
import std.fs
import std.rt
import std.deflate

fn crc_of(path: str, w: usize, h: usize) -> u32 {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    if n == 0 {
        return 1 as u32
    }
    var im: png.Image = png.image_new()
    if !png.decode_png(rt.buf_ptr(&data), n, &im) {
        return 2 as u32
    }
    if png.image_width(&im) != w || png.image_height(&im) != h {
        return 3 as u32
    }
    let c: u32 = deflate.crc32(im.px as u64, w * h * 4)
    png.image_free(&im)
    rt.buf_free(&data)
    return c
}

fn refused(p: u64, n: usize, limit: u64) -> bool {
    var im: png.Image = png.image_new()
    let ok: bool = png.decode_png_limited(p, n, limit, &im)
    if ok {
        png.image_free(&im)
    }
    return !ok
}

// the CRC-32 of every chunk repaired, so that damage gets past the checksum
fn repair(p: u64, n: usize) {
    var tab: deflate.CrcTable = deflate.crc_table()
    var off: usize = 8
    while off + 12 <= n {
        let len: usize = ((rt.ld8(p, off) as usize) << 24) | ((rt.ld8(p, off + 1) as usize) << 16)
            | ((rt.ld8(p, off + 2) as usize) << 8) | (rt.ld8(p, off + 3) as usize)
        if off + 12 + len > n {
            return
        }
        let c: u32 = deflate.crc32_more(&tab, 0 as u32, p + (off + 4) as u64, len + 4)
        rt.st8(p, off + 8 + len, (c >> 24) as u8)
        rt.st8(p, off + 9 + len, ((c >> 16) & 255 as u32) as u8)
        rt.st8(p, off + 10 + len, ((c >> 8) & 255 as u32) as u8)
        rt.st8(p, off + 11 + len, (c & 255 as u32) as u8)
        off = off + 12 + len
    }
}

static mut seed: u64 = 4242

fn rnd() -> u32 {
    seed = (seed * 1103515245 + 12345) & 2147483647
    return ((seed >> 8) & 16777215) as u32
}

// damaged copies, CRCs repaired half of the time: only "the program lives"
fn damage(path: str, copies: u32) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    if n == 0 {
        return false
    }
    var work: rt.Buf = rt.buf_new()
    var k: u32 = 0
    while k < copies {
        rt.buf_clear(&work)
        rt.buf_push_bytes(&work, rt.buf_ptr(&data), n)
        let hits: u32 = 1 + rnd() % 4
        var j: u32 = 0
        while j < hits {
            let at: usize = 8 + (rnd() as usize) % (n - 8)
            let m: u32 = rnd() % 3
            if m == 0 {
                rt.st8(rt.buf_ptr(&work), at, 255 as u8)
            } else if m == 1 {
                rt.st8(rt.buf_ptr(&work), at, 0 as u8)
            } else {
                rt.st8(rt.buf_ptr(&work), at, (rnd() % 256) as u8)
            }
            j = j + 1
        }
        if k % 2 == 0 {
            repair(rt.buf_ptr(&work), n)
        }
        refused(rt.buf_ptr(&work), n, 1000000)
        k = k + 1
    }
    rt.buf_free(&work)
    rt.buf_free(&data)
    return true
}

fn cuts(path: str) -> i32 {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    if n == 0 {
        return 1
    }
    let p: u64 = rt.buf_ptr(&data)
    var c: usize = 0
    // cut before IEND is complete: the picture is incomplete or the CRC of
    // the last chunk is missing -- refused. (The 12 octets of IEND itself
    // may go: the picture is whole then.)
    while c + 12 < n {
        if !refused(p, c, 1000000) {
            return 2
        }
        c = c + 1
    }
    rt.buf_free(&data)
    return 0
}

fn main() -> i32 {
    if crc_of("tests/data/png/pal8_trns.png", 20, 13) != 2169055219 as u32 { return 1 as i32 }
    if crc_of("tests/data/png/pal4_i.png", 19, 11) != 222477426 as u32 { return 2 as i32 }
    if crc_of("tests/data/png/pal2.png", 17, 5) != 3001834708 as u32 { return 3 as i32 }
    if crc_of("tests/data/png/pal1.png", 9, 9) != 1781629947 as u32 { return 4 as i32 }
    if crc_of("tests/data/png/grey2.png", 13, 7) != 1072317280 as u32 { return 5 as i32 }
    if crc_of("tests/data/png/grey4_i.png", 21, 9) != 3676909614 as u32 { return 6 as i32 }
    if crc_of("tests/data/png/grey8_key.png", 16, 8) != 3283776372 as u32 { return 7 as i32 }
    if crc_of("tests/data/png/grey16.png", 11, 6) != 4215299176 as u32 { return 8 as i32 }
    if crc_of("tests/data/png/rgb8_key.png", 14, 9) != 2809264219 as u32 { return 9 as i32 }
    if crc_of("tests/data/png/rgb16.png", 10, 7) != 177415429 as u32 { return 10 as i32 }
    if crc_of("tests/data/png/la8.png", 12, 12) != 3461162533 as u32 { return 11 as i32 }
    if crc_of("tests/data/png/la16_i.png", 9, 13) != 3545996473 as u32 { return 12 as i32 }
    if crc_of("tests/data/png/rgba8_i.png", 23, 17) != 291021789 as u32 { return 13 as i32 }
    if crc_of("tests/data/png/rgba16.png", 8, 8) != 870736219 as u32 { return 14 as i32 }
    // Pillow's pixels of the older test files
    if crc_of("tests/data/img/palette.png", 24, 16) != 3963351967 as u32 { return 15 as i32 }
    if crc_of("tests/data/img/rgba.png", 24, 16) != 3536439009 as u32 { return 16 as i32 }
    if crc_of("tests/data/img/same.png", 61, 47) != 2404311184 as u32 { return 17 as i32 }

    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file("tests/data/img/same.png", &data) catch 0
    let p: u64 = rt.buf_ptr(&data)
    // the pixel limit: 61 * 47 = 2867
    if !refused(p, n, 2866) { return 20 as i32 }
    if refused(p, n, 2867) { return 21 as i32 }
    // not a PNG; a short file; the signature damaged
    if !refused(p + 1, n - 1, 1000000) { return 22 as i32 }
    if !refused(p, 20, 1000000) { return 23 as i32 }
    // a damaged octet in the pixel data: the CRC says so
    var bad: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&bad, p, n)
    rt.st8(rt.buf_ptr(&bad), 60, (rt.ld8(p, 60) as u32 ^ 1 as u32) as u8)
    if !refused(rt.buf_ptr(&bad), n, 1000000) { return 24 as i32 }
    // a header that promises 2^31 x 2^31 pixels: refused before any memory
    rt.buf_clear(&bad)
    rt.buf_push_bytes(&bad, p, n)
    rt.st8(rt.buf_ptr(&bad), 16, 127 as u8)
    rt.st8(rt.buf_ptr(&bad), 17, 255 as u8)
    rt.st8(rt.buf_ptr(&bad), 18, 255 as u8)
    rt.st8(rt.buf_ptr(&bad), 19, 255 as u8)
    rt.st8(rt.buf_ptr(&bad), 20, 127 as u8)
    rt.st8(rt.buf_ptr(&bad), 21, 255 as u8)
    rt.st8(rt.buf_ptr(&bad), 22, 255 as u8)
    rt.st8(rt.buf_ptr(&bad), 23, 255 as u8)
    repair(rt.buf_ptr(&bad), n)
    if !refused(rt.buf_ptr(&bad), n, 16777216) { return 25 as i32 }
    // an illegal colour type / depth pair (palette at 16 bits), CRC repaired
    rt.buf_clear(&bad)
    rt.buf_push_bytes(&bad, p, n)
    rt.st8(rt.buf_ptr(&bad), 24, 16 as u8)
    rt.st8(rt.buf_ptr(&bad), 25, 3 as u8)
    repair(rt.buf_ptr(&bad), n)
    if !refused(rt.buf_ptr(&bad), n, 16777216) { return 26 as i32 }

    if cuts("tests/data/png/pal4_i.png") != 0 { return 30 as i32 }
    if cuts("tests/data/png/rgba16.png") != 0 { return 31 as i32 }
    if !damage("tests/data/png/pal8_trns.png", 300 as u32) { return 32 as i32 }
    if !damage("tests/data/png/rgba8_i.png", 300 as u32) { return 33 as i32 }
    if !damage("tests/data/png/grey4_i.png", 300 as u32) { return 34 as i32 }
    if !damage("tests/data/png/rgb16.png", 300 as u32) { return 35 as i32 }
    return 42
}
