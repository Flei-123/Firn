// expect_exit: 0
// tests/1338_assign_op_once.fi -- THE LEFT SIDE IS EVALUATED ONCE
// (round 70, part 5).
//
// This is the classic mistake of this extension: whoever implements
// `a[f()] += 1` by rewriting it into `a[f()] = a[f()] + 1` in the parser
// gets a program that calls `f()` TWICE. If `f()` has an effect -- and an
// index function often has one -- the program computes something else than
// it says.
//
// That is why `x op= e` is its OWN statement in this compiler
// (`Stmt::AssignOp`, `S_ZUWOP`) and the lowering computes the address of the
// target exactly once (`lower.rs`, `lower.fi`).
//
// The test counts the calls. Both directions are checked: the compound form
// has to count ONE, and the written out form -- as the counter-check that
// the counting works at all -- has to count TWO.

struct Cell {
    v: i32,
}

// Raises the counter and always yields the index 1.
fn ticking(counter: *mut i32) -> usize {
    *counter += 1
    return 1
}

// The same for a pointer: raises the counter and yields the address of the
// field.
fn ticking_ptr(counter: *mut i32, c: *mut Cell) -> *mut i32 {
    *counter += 1
    return &(*c).v
}

fn main() -> i32 {
    // --- 1. compound assignment on an array element
    var calls: i32 = 0
    var a: [i32; 3] = [10, 20, 30]
    a[ticking(&calls)] += 5
    if calls != 1 { return 1 }
    if a[1] != 25 { return 2 }

    // --- 2. the step operator, the same question
    a[ticking(&calls)]++
    if calls != 2 { return 3 }
    if a[1] != 26 { return 4 }
    a[ticking(&calls)]--
    if calls != 3 { return 5 }
    if a[1] != 25 { return 6 }

    // --- 3. through a POINTER that a function hands out
    var cell: Cell = Cell { v: 100 }
    calls = 0
    *ticking_ptr(&calls, &cell) += 11
    if calls != 1 { return 7 }
    if cell.v != 111 { return 8 }
    *ticking_ptr(&calls, &cell)++
    if calls != 2 { return 9 }
    if cell.v != 112 { return 10 }

    // --- 4. THE COUNTER-CHECK: written out, `ticking` really runs twice.
    // Without this line the test would also stay green if the counting were
    // broken.
    calls = 0
    a[ticking(&calls)] = a[ticking(&calls)] + 5
    if calls != 2 { return 11 }
    if a[1] != 30 { return 12 }

    // --- 5. the right side is evaluated exactly once too
    calls = 0
    var x: i32 = 1
    x += ticking(&calls) as i32
    if calls != 1 { return 13 }
    if x != 2 { return 14 }

    // --- 6. and the ORDER is the one of `x = x op e`: first the target,
    // then the value.
    var order: [i32; 4] = [0, 0, 0, 0]
    var step: i32 = 0
    order[note(&step, 0)] += note(&step, 1) as i32
    if step != 2 { return 15 }
    return 0
}

// Writes the running number into `step` and hands back `slot` as an index.
fn note(step: *mut i32, slot: usize) -> usize {
    *step += 1
    return slot
}
