// expect_exit: 0
// tests/2868_std_simd.fi -- std.simd wrappers: splat, hsum / dot4 against the scalar sum, Newton steps against the
// scalar value, clamp, masks, packs. x86-64 and (qemu) aarch64.
import std.rt
import std.simd
import std.math

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn ldf(a: u64, i: usize) -> f32 {
    return *((a + (i * 4) as u64) as *mut f32)
}

fn stf(a: u64, i: usize, v: f32) {
    *((a + (i * 4) as u64) as *mut f32) = v
}

fn rel_ok(got: f32, want: f32, tol: f32) -> bool {
    let d: f32 = (got - want) / want
    return d < tol && d > (0.0 as f32) - tol
}

fn main() -> i32 {
    let a: u64 = rt.heap_alloc(256)
    let b: u64 = rt.heap_alloc(256)
    let o: u64 = rt.heap_alloc(256)
    var k: i32 = 0
    while k < 100 {
        var i: usize = 0
        while i < 4 {
            let n: i32 = k * 7 + (i as i32) * 13 + 1
            stf(a, i, ((n % 997) as f32) / (8.0 as f32) + (0.25 as f32))
            stf(b, i, (((n * 31) % 389) as f32) / (4.0 as f32) - (20.0 as f32))
            i = i + 1
        }
        let va: v128 = simd.ld(a)
        let vb: v128 = simd.ld(b)
        // hsum / dot4: exactly the order ((x0 + x1) + (x2 + x3))
        let s: f32 = (ldf(a, 0) + ldf(a, 1)) + (ldf(a, 2) + ldf(a, 3))
        check(simd.hsum_f32(va) == s, 1)
        var dd: f32 = (ldf(a, 0) * ldf(b, 0) + ldf(a, 1) * ldf(b, 1)) + (ldf(a, 2) * ldf(b, 2) + ldf(a, 3) * ldf(b, 3))
        check(simd.dot4(va, vb) == dd, 2)
        // Newton steps: tight enough on both targets
        simd.st(o, simd.rcp_nr(va))
        simd.st(o + 16, simd.rsqrt_nr(va))
        simd.st(o + 32, simd.sqrt_f32(va))
        i = 0
        while i < 4 {
            let x: f32 = ldf(a, i)
            check(rel_ok(ldf(o, i), (1.0 as f32) / x, 0.0001 as f32), 3)
            check(rel_ok(ldf(o + 16, i), (1.0 as f32) / math.sqrt32(x), 0.0002 as f32), 4)
            check(ldf(o + 32, i) == math.sqrt32(x), 5)
            i = i + 1
        }
        // clamp, splat, masks
        let lo: v128 = simd.splat_f32(-3.5 as f32)
        let hi: v128 = simd.splat_f32(9.25 as f32)
        simd.st(o + 48, simd.clamp_f32(vb, lo, hi))
        i = 0
        while i < 4 {
            var w: f32 = ldf(b, i)
            if w < (-3.5 as f32) { w = -3.5 as f32 }
            if w > (9.25 as f32) { w = 9.25 as f32 }
            check(ldf(o + 48, i) == w, 6)
            i = i + 1
        }
        var neg: u32 = 0 as u32
        i = 0
        while i < 4 {
            if ldf(b, i) < (0.0 as f32) { neg = neg | (1 as u32 << i as u32) }
            i = i + 1
        }
        check(simd.mask_f32(vb) == neg, 7)
        check(simd.any_f32(vb) == (neg != 0 as u32), 8)
        k = k + 1
    }
    // packs with saturation: 70000 -> 32767, -70000 -> -32768, 300 -> 255 (u8)
    let p32: v128 = __v128_from_u64(0xFFFEEE90_00011170 as u64, 0x0000012C_FFFFFF38 as u64)
    let q32: v128 = simd.pack_i32_i16(p32, p32)
    check(__v128_get_u32(q32, 0) == 0x80007FFF as u32, 9)
    let q16: v128 = simd.pack_i16_u8(simd.pack_i32_i16(p32, p32), __v128_zero())
    check((__v128_get_u32(q16, 0) & 0xFF as u32) == 255 as u32, 10)
    return 0
}
