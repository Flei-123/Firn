fn run_fsum() {
    let lens: [u64; 127] = fsum_lens()
    let data: [u64; 1082] = fsum_data()
    let want: [u64; 127] = fsum_want()
    var pos: usize = 0
    var bad: usize = 0
    for c in 0..(127 as usize) {
        var v: Vec[f64] = vec_new[f64]()
        for k in 0..(lens[c] as usize) {
            vec_push[f64](&v, f(data[pos + k]))
        }
        pos = pos + (lens[c] as usize)
        if !same(mathx.fsum(&v), f(want[c])) { bad = bad + 1 }
        vec_free[f64](&v)
    }
    testkit.check(bad == 0, "fsum (127 vectors)")
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    run_asin()
    run_acos()
    run_sinh()
    run_cosh()
    run_tanh()
    run_asinh()
    run_acosh()
    run_atanh()
    run_expm1()
    run_log1p()
    run_cbrt()
    run_erf()
    run_erfc()
    run_gamma()
    run_lgamma()
    run_copysign()
    run_remainder()
    run_fmod_py()
    run_degrees()
    run_radians()
    run_isclose()
    run_fsum()
    return testkit.finish()
}
