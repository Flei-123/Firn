// expect_exit: 0
// tests/4521_std_mathx.fi -- std.mathx float functions against CPython 3.11 `math`.
// GENERATED by tools/libs_py_cross/mathx_gen.py: inputs and CPython results as IEEE bit patterns.
// copysign/remainder/fmod_py/degrees/radians/isclose: bit-exact. The others: relative 1e-11
// (std.math exp/ln/atan2 are series approximations, see tests/805).
import std.rt
import std.vec
import std.math
import std.mathx
import std.testkit

fn f(b: u64) -> f64 { return math.math_f64(b) }
fn close(got: f64, want: f64) -> bool {
    if math.is_nan(want) { return math.is_nan(got) }
    if math.is_infinite(want) { return got == want }
    let d: f64 = math.fabs(got - want)
    return d <= 1e-11 * math.fabs(want) || d == 0.0
}
fn same(got: f64, want: f64) -> bool {
    if math.is_nan(want) { return math.is_nan(got) }
    return math.math_bits(got) == math.math_bits(want)
}

