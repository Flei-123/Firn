// expect_out: ok
// tests/3412_photo_aspect.fi -- FirnCam output aspect: a 4:3 sensor frame cropped to 16:9 (Xiaomi-style wide picture) at full
// sensor resolution (4096 x 3072 -> 4096 x 2304), centred, even origin / size (CFA phase kept); raw_window_a delivers it.
import std.io
import std.rt
import photo.image
import photo.meta
import photo.camjob

fn check(c: bool, msg: str) -> bool {
    if !c { io.print(msg); io.new_line() }
    return c
}

fn main() -> i32 {
    var ok: bool = true
    var x: i32 = 0
    var y: i32 = 0
    var w: i32 = 0
    var h: i32 = 0
    camjob.aspect_window(4096, 3072, 1.0f, 16, 9, &x, &y, &w, &h)
    ok = check(w == 4096 && h == 2304 && x == 0 && y == 384, "4096x3072 -> 16:9") && ok
    camjob.aspect_window(4096, 3072, 1.0f, 0, 0, &x, &y, &w, &h)
    ok = check(w == 4096 && h == 3072 && x == 0 && y == 0, "no aspect = zoom window") && ok
    camjob.aspect_window(4096, 3072, 2.0f, 16, 9, &x, &y, &w, &h)
    ok = check(w == 2048 && h == 1152, "zoom 2 + 16:9") && ok
    camjob.aspect_window(3000, 4000, 1.0f, 16, 9, &x, &y, &w, &h)
    ok = check(w == 3000 && h == 1686 && (x & 1) == 0 && (y & 1) == 0, "portrait sensor") && ok
    // invariants over many sizes / zooms: inside the frame, even, ratio within one pixel row, centred
    var bad: i32 = 0
    var sw: i32 = 64
    while sw <= 4200 {
        var sh: i32 = 48
        while sh <= 3200 {
            var zi: i32 = 0
            while zi < 4 {
                let z: f32 = 1.0f + (zi as f32) * 0.7f
                camjob.aspect_window(sw, sh, z, 16, 9, &x, &y, &w, &h)
                if x < 0 || y < 0 || x + w > sw || y + h > sh { bad = bad + 1 }
                if (x & 1) != 0 || (y & 1) != 0 || (w & 1) != 0 || (h & 1) != 0 { bad = bad + 1 }
                let lhs: i64 = (w as i64) * 9
                let rhs: i64 = (h as i64) * 16
                var df: i64 = lhs - rhs
                if df < 0 { df = 0 - df }
                if w > 16 && h > 16 && df > 2 * 16 { bad = bad + 1 }
                zi = zi + 1
            }
            sh = sh + 713
        }
        sw = sw + 509
    }
    ok = check(bad == 0, "aspect window invariants") && ok
    // end to end: a flat 128 x 96 RGGB mosaic -> 128 x 72 image at max_px 1e6
    let n: usize = (128 * 96) as usize
    let p: u64 = rt.heap_alloc(n * 2)
    var i: usize = 0
    while i < n {
        *((p + (i as u64) * (2 as u64)) as *mut u16) = 20000 as u16
        i = i + 1
    }
    var m: meta.SensorMeta = meta.meta_default()
    var im: image.Image = camjob.raw_window_a(p, 128, 96, &m, 1000000, 1.0f, false, 16, 9)
    ok = check(im.w == 128 && im.h == 72, "raw_window_a size") && ok
    image.img_free(&im)
    var im2: image.Image = camjob.raw_window_a(p, 128, 96, &m, 4000, 1.0f, false, 16, 9)
    ok = check(im2.w * im2.h <= 4000 && im2.w * 9 >= im2.h * 16 - 40 && im2.w * 9 <= im2.h * 16 + 40, "fits max_px, keeps aspect") && ok
    image.img_free(&im2)
    rt.heap_free(p, n * 2)
    if ok { io.print("ok") } else { io.print("FAIL") }
    return 0
}
