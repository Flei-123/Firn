// expect_exit: 0
// tests/4190_lazy_lower_roots.fi -- lazy lowering in firnc1 (r734, FIRN_PRUNE_FIR=1) must keep
// every function that only a table, a function value, a closure, a spawn or the
// panic path names. tools/prune_compare.sh compares the lazy assembly with eager lowering
// plus pruning byte for byte.
//
//   * `Cube.area` is reached only through the method table of `dyn Shape`
//   * `quad` is reached only through a function value stored in a struct
//   * `late` is reached only through a function that is itself only reached by value
//   * `never_lowered` is reachable from nothing
interface Shape {
    fn area(*self) -> i64
}

struct Cube { s: i64 }

impl Shape for Cube {
    fn area(*self) -> i64 { return (*self).s * (*self).s * 6 }
}

struct Holder { f: fn(i64) -> i64 }

fn late(a: i64) -> i64 { return a + 7 }

fn via(a: i64) -> i64 { return late(a) * 2 }

fn quad(a: i64) -> i64 { return a * 4 }

fn never_lowered(a: i64) -> i64 { return a + 1000 }

fn main() -> i32 {
    var c: Cube = Cube { s: 2 }
    let d: dyn Shape = (&c) as dyn Shape
    if d.area() != 24 { return 1 }
    let h: Holder = Holder { f: quad }
    if h.f(3) != 12 { return 2 }
    let g: fn(i64) -> i64 = via
    if g(1) != 16 { return 3 }
    return 0
}
