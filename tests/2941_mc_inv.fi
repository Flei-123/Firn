// expect_exit: 0
// mc_inv: Window Items + Set Slot of window 0 (1.20.1 layout and the pre-1.17.1 layout), slot NBT skipped, other windows ignored.
import std.rt
import std.bytes
import mc.mc_inv

fn put_slot(b: *mut bytes.Bytes, item: i32, count: i32, nbt: bool) {
    if item < 0 {
        bytes.put_bool(b, false)
        return
    }
    bytes.put_bool(b, true)
    bytes.put_varint(b, item)
    bytes.put_i8(b, count as i8)
    if nbt {
        // compound "" { Damage: int 7 }
        bytes.put_u8(b, 10 as u8)
        bytes.put_u16(b, 0 as u16)
        bytes.put_u8(b, 3 as u8)
        bytes.put_u16(b, 6 as u16)
        bytes.put_raw(b, "Damage".p as u64, 6)
        bytes.put_i32(b, 7)
        bytes.put_u8(b, 0 as u8)
    } else {
        bytes.put_u8(b, 0 as u8)
    }
}

fn main() -> i32 {
    var v: mc_inv.Inv = mc_inv.inv_new()
    // 1.20.1: window 0, stateId 5, 46 slots, carried item
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&b, 0 as u8)
    bytes.put_varint(&b, 5)
    bytes.put_varint(&b, 46)
    var i: i32 = 0
    while i < 46 {
        if i == 36 {
            put_slot(&b, 1, 64, false)
        } else if i == 38 {
            put_slot(&b, 794, 1, true)
        } else if i == 20 {
            put_slot(&b, 3, 12, false)
        } else {
            put_slot(&b, 0 - 1, 0, false)
        }
        i = i + 1
    }
    put_slot(&b, 0 - 1, 0, false)
    bytes.bytes_set_pos(&b, 0)
    if !mc_inv.inv_on_window_items(&v, 763, &b) { return 1 }
    if mc_inv.inv_hotbar_item(&v, 0) != 1 || mc_inv.inv_hotbar_count(&v, 0) != 64 { return 2 }
    if mc_inv.inv_hotbar_item(&v, 2) != 794 || mc_inv.inv_held_item(&v, 2) != 794 { return 3 }
    if mc_inv.inv_hotbar_item(&v, 1) != 0 - 1 { return 4 }
    if mc_inv.inv_item(&v, 20) != 3 || mc_inv.inv_count(&v, 20) != 12 { return 5 }
    if v.state_id != 5 { return 6 }
    // Set Slot: window 0, stateId, slot 37, item 5 x 3 -> hotbar 1
    var s: bytes.Bytes = bytes.bytes_new()
    bytes.put_i8(&s, 0 as i8)
    bytes.put_varint(&s, 6)
    bytes.put_i16(&s, 37 as i16)
    put_slot(&s, 5, 3, true)
    bytes.bytes_set_pos(&s, 0)
    if !mc_inv.inv_on_set_slot(&v, 763, &s) { return 7 }
    if mc_inv.inv_hotbar_item(&v, 1) != 5 || mc_inv.inv_hotbar_count(&v, 1) != 3 { return 8 }
    // emptied slot
    var e: bytes.Bytes = bytes.bytes_new()
    bytes.put_i8(&e, 0 as i8)
    bytes.put_varint(&e, 7)
    bytes.put_i16(&e, 36 as i16)
    put_slot(&e, 0 - 1, 0, false)
    bytes.bytes_set_pos(&e, 0)
    if !mc_inv.inv_on_set_slot(&v, 763, &e) { return 9 }
    if mc_inv.inv_hotbar_item(&v, 0) != 0 - 1 { return 10 }
    // another window is ignored
    var o: bytes.Bytes = bytes.bytes_new()
    bytes.put_i8(&o, 2 as i8)
    bytes.put_varint(&o, 7)
    bytes.put_i16(&o, 40 as i16)
    put_slot(&o, 9, 9, false)
    bytes.bytes_set_pos(&o, 0)
    if mc_inv.inv_on_set_slot(&v, 763, &o) { return 11 }
    if mc_inv.inv_hotbar_item(&v, 4) != 0 - 1 { return 12 }
    // truncated packet: refused, nothing crashes
    var t: bytes.Bytes = bytes.bytes_new()
    bytes.put_i8(&t, 0 as i8)
    bytes.put_varint(&t, 7)
    bytes.put_i16(&t, 40 as i16)
    bytes.put_bool(&t, true)
    bytes.bytes_set_pos(&t, 0)
    if mc_inv.inv_on_set_slot(&v, 763, &t) { return 13 }
    // pre-1.17.1 (754 = 1.16.5): no stateId, i16 count
    var p: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&p, 0 as u8)
    bytes.put_i16(&p, 46 as i16)
    i = 0
    while i < 46 {
        if i == 44 { put_slot(&p, 7, 2, false) } else { put_slot(&p, 0 - 1, 0, false) }
        i = i + 1
    }
    bytes.bytes_set_pos(&p, 0)
    if !mc_inv.inv_on_window_items(&v, 754, &p) { return 14 }
    if mc_inv.inv_hotbar_item(&v, 8) != 7 || mc_inv.inv_hotbar_count(&v, 8) != 2 { return 15 }
    // unsupported layout (1.20.5+) is refused
    if mc_inv.inv_on_window_items(&v, 766, &p) { return 16 }
    mc_inv.inv_free(&v)
    return 0
}
