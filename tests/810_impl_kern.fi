// expect_exit: 0
// tests/810_impl_kern.fi — METHODEN (`impl`), der Test zur Runde 45.
//
// Geprueft wird in EINEM Programm, was `impl` in der Sprache ausmacht:
//
//   * die drei Empfaenger `self`, `*self` und `*mut self`
//   * die einzige Anpassung am Aufrufort: liegt der Empfaenger als WERT vor
//     und will die Methode einen Zeiger, wird seine Adresse genommen; liegt
//     er schon als Zeiger vor, wird er durchgereicht
//   * Empfaenger, die keine Variable sind: Feld, Arrayelement, `*p`
//   * eine Methode, die ein AGGREGAT liefert, und die Kette darauf
//     (`p.verschoben(1, 1).erstes()`)
//   * Methode ruft Methode auf demselben Typ
//   * eine freie Funktion und eine Methode DESSELBEN NAMENS stehen
//     nebeneinander, ohne sich zu verdecken (`summe(..)` vs `p.summe()`)
//
// Jeder Rueckgabewert != 0 nennt die Stelle.

struct Punkt { x: i32, y: i32 }

struct Rahmen { ecke: Punkt, breite: i32 }

// FREIE Funktion `summe` — sie heisst wie die Methode `Punkt.summe` und
// bleibt trotzdem erreichbar: die Methode heisst intern `Punkt__summe`.
fn summe(a: i32, b: i32) -> i32 {
    return a + b
}

impl Punkt {
    // lesender Zeiger
    fn summe(*self) -> i32 {
        return (*self).x + (*self).y
    }
    // schreibender Zeiger
    fn setze(*mut self, x: i32, y: i32) {
        (*self).x = x
        (*self).y = y
    }
    // Kopie
    fn erstes(self) -> i32 {
        return self.x
    }
    // Aggregat als Rueckgabe, Empfaenger als Kopie
    fn verschoben(self, dx: i32, dy: i32) -> Punkt {
        return Punkt{ x: self.x + dx, y: self.y + dy }
    }
    // Methode ruft Methode: beide auf demselben Empfaenger
    fn doppelt(*self) -> i32 {
        return self.summe() * 2
    }
    // Aggregat als ARGUMENT
    fn naeher_als(*self, andere: Punkt) -> bool {
        return self.summe() < andere.erstes() + andere.y
    }
}

impl Rahmen {
    fn flaeche(*self) -> i32 {
        return (*self).breite * (*self).breite
    }
    // Empfaenger ist ein FELD des eigenen Empfaengers
    fn eckensumme(*self) -> i32 {
        return (*self).ecke.summe()
    }
}

fn main() -> i32 {
    var p: Punkt = Punkt{ x: 1, y: 2 }

    // 1. *self auf einem Wert: die Adresse wird genommen
    if p.summe() != 3 {
        return 1
    }
    // 2. *mut self veraendert wirklich
    p.setze(40, 2)
    if p.x != 40 || p.y != 2 {
        return 2
    }
    if p.summe() != 42 {
        return 3
    }
    // 3. Empfaenger als Kopie
    if p.erstes() != 40 {
        return 4
    }
    // 4. Empfaenger liegt schon als Zeiger vor
    let z: *mut Punkt = &p
    if z.summe() != 42 {
        return 5
    }
    z.setze(1, 2)
    if p.summe() != 3 {
        return 6
    }
    // 5. Kopie aus einem Zeiger: ausdruecklich `(*z)`
    if (*z).erstes() != 1 {
        return 7
    }
    // 6. Aggregatrueckgabe und Kette darauf
    let q: Punkt = p.verschoben(10, 20)
    if q.x != 11 || q.y != 22 {
        return 8
    }
    if p.verschoben(1, 1).erstes() != 2 {
        return 9
    }
    // Eine Kette geht nur mit einem Empfaenger als KOPIE: das Ergebnis eines
    // Aufrufs hat keine Adresse, `summe` will einen Zeiger. Deshalb erst
    // binden — siehe tests/neg/impl_empfaenger_ohne_adresse.fi.
    let v: Punkt = p.verschoben(1, 1)
    if v.summe() != 5 {
        return 10
    }
    // 7. Methode ruft Methode
    if p.doppelt() != 6 {
        return 11
    }
    // 8. Aggregat als Argument
    if !p.naeher_als(q) {
        return 12
    }
    if q.naeher_als(p) {
        return 13
    }
    // 9. Empfaenger ist ein Feld
    var r: Rahmen = Rahmen{ ecke: Punkt{ x: 3, y: 4 }, breite: 5 }
    if r.ecke.summe() != 7 {
        return 14
    }
    if r.eckensumme() != 7 {
        return 15
    }
    if r.flaeche() != 25 {
        return 16
    }
    r.ecke.setze(6, 7)
    if r.eckensumme() != 13 {
        return 17
    }
    // 10. Empfaenger ist ein Arrayelement
    var feld: [Punkt; 3] = [Punkt{ x: 0, y: 0 }, Punkt{ x: 0, y: 0 }, Punkt{ x: 0, y: 0 }]
    var i: i32 = 0
    while i < 3 {
        feld[i as usize].setze(i, i * 2)
        i = i + 1
    }
    if feld[2 as usize].summe() != 6 {
        return 18
    }
    if feld[1 as usize].doppelt() != 6 {
        return 19
    }
    // 11. freie Funktion gleichen Namens — beide erreichbar
    if summe(20, 22) != 42 {
        return 20
    }
    if summe(p.summe(), q.summe()) != 36 {
        return 21
    }
    return 0
}
