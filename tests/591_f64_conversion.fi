// expect_exit: 0
// UMWANDLUNG ZWISCHEN GANZZAHL UND `f64` — Rueckfalltest zu einem echten
// Fehler in Stufe 0 (Runde 20).
//
// `f64` ist 64 Bit breit und gilt im FIR als vorzeichenlos. Zwei Stellen im
// Optimierer haben daraus geschlossen, `u64 -> f64` sei eine reine Umdeutung
// desselben Bitmusters:
//
//   * `mem2reg.rs` strich die Umwandlung ersatzlos,
//   * `opt.rs::fold_cast` faltete sie zu `to.<abschneiden>(from.<abschneiden>(a))`.
//
// Aus `100 as f64` wurde damit das BITMUSTER 100 — also 5e-322 statt 100.0.
// Es ist genau umgekehrt: von allen Umwandlungen ist die zwischen Ganzzahl
// und Gleitkomma die EINZIGE, die die Bits wirklich aendert (`cvtsi2sd`).
//
// Gefunden hat es der in Firn geschriebene Lexer: sein Tokenstrom fuer `10.0`
// stimmte mit `firnc0` nur ohne Optimierer ueberein. Die Testsuite faehrt
// jedes Programm mit UND ohne Optimierer — deshalb faengt dieser Test beide
// Wege.

fn u64_after_f64(m: u64) -> f64 {
    return m as f64
}

fn main() -> i32 {
    // --- vorzeichenlos -> f64, alle Breiten
    let a: u8 = 100
    let b: u16 = 100
    let c: u32 = 100
    let d: u64 = 100
    let e: usize = 100
    if a as f64 != 100.0 { return 1 }
    if b as f64 != 100.0 { return 2 }
    if c as f64 != 100.0 { return 3 }
    if d as f64 != 100.0 { return 4 }
    if e as f64 != 100.0 { return 5 }

    // --- vorzeichenbehaftet -> f64
    let f: i8 = 0 - 100
    let g: i32 = 0 - 100
    let h: i64 = 0 - 100
    if f as f64 != 0.0 - 100.0 { return 6 }
    if g as f64 != 0.0 - 100.0 { return 7 }
    if h as f64 != 0.0 - 100.0 { return 8 }

    // --- ueber eine Funktionsgrenze (nicht faltbar)
    if u64_after_f64(100) != 100.0 { return 9 }
    if u64_after_f64(0) != 0.0 { return 10 }
    if u64_after_f64(1) != 1.0 { return 11 }

    // --- f64 -> Ganzzahl, abschneidend Richtung null
    if (100.9 as u64) != 100 { return 12 }
    if (100.9 as usize) != 100 { return 13 }
    if (0.0 - 100.9) as i64 != 0 - 100 { return 14 }
    if (255.7 as u8) != 255 as u8 { return 15 }

    // --- Hin und zurueck ueber eine Zahl, deren Bitmuster als f64 winzig ist
    let big: u64 = 4636737291354636288
    if big as f64 == 100.0 { return 16 }   // das WAERE der alte Fehler
    if (big as f64) < 1e18 { return 17 }

    // --- Rechnen mit dem Ergebnis, damit die Umwandlung nicht wegoptimiert wird
    var sum: f64 = 0.0
    var i: u64 = 0
    while i < 10 {
        sum = sum + i as f64
        i = i + 1
    }
    if sum != 45.0 { return 18 }

    return 0
}
