// expect_exit: 0
// CONVERSION BETWEEN INTEGER AND `f64` -- a regression test for a real
// bug in stage 0 (round 20).
//
// `f64` is 64 bit wide and counts as unsigned in the FIR. Two places in the
// optimiser concluded from that that `u64 -> f64` was a pure reinterpretation
// of the same bit pattern:
//
//   * `mem2reg.rs` removed the conversion without replacement,
//   * `opt.rs::fold_cast` folded it into `to.<cut>(from.<cut>(a))`.
//
// `100 as f64` thereby became the BIT PATTERN 100 -- that is 5e-322 instead of 100.0.
// It is exactly the other way round: of all conversions the one between
// integer and floating point is the ONLY one that really changes the bits
//
// (`cvtsi2sd`). It was found by the lexer written in Firn: its token stream
// for `10.0` only matched `firnc0` without the optimiser. The test suite runs
// every program with AND without the optimiser -- which is why this test
// catches both ways.

fn u64_after_f64(m: u64) -> f64 {
    return m as f64
}

fn main() -> i32 {
    // --- unsigned -> f64, all widths
    let a: u8 = 100
    let b: u16 = 100
    let c: u32 = 100
    let d: u64 = 100
    let e: usize = 100
    if a as f64 != 100.0 { return 1 }
    if b as f64 != 100.0 { return 2 }
    if c as f64 != 100.0 { return 3 }
    if d as f64 != 100.0 { return 4 }
    if e as f64 != 100.0 { return 5 }

    // --- signed -> f64
    let f: i8 = 0 - 100
    let g: i32 = 0 - 100
    let h: i64 = 0 - 100
    if f as f64 != 0.0 - 100.0 { return 6 }
    if g as f64 != 0.0 - 100.0 { return 7 }
    if h as f64 != 0.0 - 100.0 { return 8 }

    // --- across a function boundary (not foldable)
    if u64_after_f64(100) != 100.0 { return 9 }
    if u64_after_f64(0) != 0.0 { return 10 }
    if u64_after_f64(1) != 1.0 { return 11 }

    // --- f64 -> integer, cutting towards zero
    if (100.9 as u64) != 100 { return 12 }
    if (100.9 as usize) != 100 { return 13 }
    if (0.0 - 100.9) as i64 != 0 - 100 { return 14 }
    if (255.7 as u8) != 255 as u8 { return 15 }

    // --- there and back over a number whose bit pattern is tiny as an f64
    let big: u64 = 4636737291354636288
    if big as f64 == 100.0 { return 16 } // das WAERE der alte Fehler
    if (big as f64) < 1e18 { return 17 }

    // --- compute with the result so that the conversion is not optimised away
    var sum: f64 = 0.0
    var i: u64 = 0
    while i < 10 {
        sum = sum + i as f64
        i = i + 1
    }
    if sum != 45.0 { return 18 }

    return 0
}
