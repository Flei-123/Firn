// expect_exit: 0
import std.rt
import std.net
import mc.mc_hostname
import mc.mc_serverlist
import mc.mc_connect

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn valid(t: str) -> bool {
    return mc_hostname.host_valid(t.p as u64, t.n)
}

fn entry_is(l: *mut mc_serverlist.ServerList, i: i32, t: str) -> bool {
    if mc_serverlist.sl_len(l, i) != t.n { return false }
    var k: usize = 0
    while k < t.n {
        if rt.ld8(mc_serverlist.sl_ptr(l, i), k) != rt.ld8(t.p as u64, k) { return false }
        k = k + 1
    }
    return true
}

fn main() -> i32 {
    check(valid("[::1]") && valid("[2001:db8::1]") && valid("[::ffff:1.2.3.4]"), 1)
    check(!valid("::1") && !valid("[]") && !valid("[::1") && !valid("::1]") && !valid("[zz]") && !valid("[1.2.3.4]") && !valid("a:b"), 2)

    var l: mc_serverlist.ServerList = mc_serverlist.sl_new()
    check(mc_serverlist.sl_add(&l, "[::1]".p as u64, 5, 25565), 3)
    check(mc_serverlist.sl_find(&l, "[::1]".p as u64, 5, 25565) == 0, 4)
    var h: rt.Buf = rt.buf_new()
    mc_serverlist.sl_host(&l, 0, &h)
    check(rt.buf_len(&h) == 5 && rt.ld8(rt.buf_ptr(&h), 0) == 91 as u8 && rt.ld8(rt.buf_ptr(&h), 4) == 93 as u8, 5)
    check(mc_serverlist.sl_port(&l, 0) == 25565, 6)
    var text: rt.Buf = rt.buf_new()
    mc_serverlist.sl_text(&l, &text)
    var back: mc_serverlist.ServerList = mc_serverlist.sl_new()
    mc_serverlist.sl_load(rt.buf_ptr(&text), rt.buf_len(&text), &back)
    check(mc_serverlist.sl_count(&back) == 1 && entry_is(&back, 0, "[::1]:25565"), 7)
    let junk: str = "server=::1:25565\nserver=[::1:25565\nserver=[zz]:25565\nserver=[2001:db8::1]:80\nserver=[::1]:\n"
    mc_serverlist.sl_load(junk.p as u64, junk.n, &back)
    check(mc_serverlist.sl_count(&back) == 1 && entry_is(&back, 0, "[2001:db8::1]:80"), 8)
    mc_serverlist.sl_free(&l)
    mc_serverlist.sl_free(&back)
    rt.buf_free(&h)
    rt.buf_free(&text)

    var lst: net.Listener = net.listen_tcp(net.ipv4(127 as u8, 0 as u8, 0 as u8, 1 as u8), 0 as u16) catch net.listener_from_fd(0 - 1)
    check(net.listener_is_open(&lst), 9)
    let port: u16 = net.listener_port(&lst)
    var which: usize = 0
    var c: net.Conn = mc_connect.connect_host("[::ffff:127.0.0.1]".p as u64, 18, port, &which)
    check(net.conn_is_open(&c), 10)
    net.close(&c)
    net.close_listener(&lst)
    return 0
}
