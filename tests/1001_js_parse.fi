// expect_exit: 0
// tests/1001_js_parse.fi -- ROUND 63, the PARSER and its EARLY ERRORS.
//
// A parser that only builds a tree is worth little for test262: a large
// part of the suite consists of programs that MUST NOT parse. So both
// directions are checked here -- 20 programs that have to parse and 30 that
// have to be rejected, each with the rule behind it:
//
//   strict mode (`with`, `eval` as a binding, `delete x`, octal literals,
//   duplicate parameters, the reserved words), duplicate lexical
//   declarations and the var/let clash, two constructors in a class, two
//   `__proto__` data properties, `??` mixed with `||`, `break`/`continue`
//   without a target, `return` outside a function, a declaration as the
//   body of `if`/`while`, an invalid escape in an UNTAGGED template, an
//   escaped reserved word, a number followed directly by an identifier,
//   BigInt (deliberately absent), and the arity of getters and setters.
//
// The return value names the case that went wrong -- the positive ones
// first, then the negative ones.
import html.mem
import js.lex
import js.ast
import js.parse

// Parse one program. `want_ok` says what is expected.
fn chk(p: *mut parse.Parser, l: *mut lex.Lexer, src: *mut u8, n: usize,
    want_ok: bool) -> bool {
    lex.lex_set_ascii(l, src, n)
    let prog: u32 = parse.parse_program(p, false)
    let err: u32 = parse.parse_error(p)
    if want_ok {
        return err == parse.ERR_NONE
    }
    return err != parse.ERR_NONE
}

fn main() -> i32 {
    var nm: lex.Names = lex.Names { pool: mem.cp_new(), off: mem.cp_new(),
        len: mem.cp_new(), hash: mem.cp_new(), buckets: mem.cp_new(),
        mask: 0, n: 0 }
    lex.names_init(&nm)
    var l: lex.Lexer = lex.lex_new()
    lex.lex_init(&l, &nm)

    var t0: ast.Ast = ast.ast_new()
    ast.ast_init(&t0)
    var p0: parse.Parser = parse.parser_new()
    parse.parser_init(&p0, &l, &t0, &nm)
    var g0: [u8; 24] = "var a = 1, b = 2; a += b"
    if !chk(&p0, &l, &g0[0], 24, true) {
        return 1
    }
    var t1: ast.Ast = ast.ast_new()
    ast.ast_init(&t1)
    var p1: parse.Parser = parse.parser_new()
    parse.parser_init(&p1, &l, &t1, &nm)
    var g1: [u8; 39] = "function f(a, b = 1, ...r) { return a }"
    if !chk(&p1, &l, &g1[0], 39, true) {
        return 2
    }
    var t2: ast.Ast = ast.ast_new()
    ast.ast_init(&t2)
    var p2: parse.Parser = parse.parser_new()
    parse.parser_init(&p2, &l, &t2, &nm)
    var g2: [u8; 77] = "class C extends D { constructor(){ super() } static m(){} get x(){return 1} }"
    if !chk(&p2, &l, &g2[0], 77, true) {
        return 3
    }
    var t3: ast.Ast = ast.ast_new()
    ast.ast_init(&t3)
    var p3: parse.Parser = parse.parser_new()
    parse.parser_init(&p3, &l, &t3, &nm)
    var g3: [u8; 54] = "for (const [a, b] of pairs) { a: for(;;) { break a } }"
    if !chk(&p3, &l, &g3[0], 54, true) {
        return 4
    }
    var t4: ast.Ast = ast.ast_new()
    ast.ast_init(&t4)
    var p4: parse.Parser = parse.parser_new()
    parse.parser_init(&p4, &l, &t4, &nm)
    var g4: [u8; 37] = "x = a ?? (b || c); y = a?.b?.[c]?.(d)"
    if !chk(&p4, &l, &g4[0], 37, true) {
        return 5
    }
    var t5: ast.Ast = ast.ast_new()
    ast.ast_init(&t5)
    var p5: parse.Parser = parse.parser_new()
    parse.parser_init(&p5, &l, &t5, &nm)
    var g5: [u8; 38] = "label: while (true) { continue label }"
    if !chk(&p5, &l, &g5[0], 38, true) {
        return 6
    }
    var t6: ast.Ast = ast.ast_new()
    ast.ast_init(&t6)
    var p6: parse.Parser = parse.parser_new()
    parse.parser_init(&p6, &l, &t6, &nm)
    var g6: [u8; 37] = "try { throw 1 } catch { } finally { }"
    if !chk(&p6, &l, &g6[0], 37, true) {
        return 7
    }
    var t7: ast.Ast = ast.ast_new()
    ast.ast_init(&t7)
    var p7: parse.Parser = parse.parser_new()
    parse.parser_init(&p7, &l, &t7, &nm)
    var g7: [u8; 65] = "obj = { __proto__: p, [k]: v, m(){}, get g(){return 1}, ...rest }"
    if !chk(&p7, &l, &g7[0], 65, true) {
        return 8
    }
    var t8: ast.Ast = ast.ast_new()
    ast.ast_init(&t8)
    var p8: parse.Parser = parse.parser_new()
    parse.parser_init(&p8, &l, &t8, &nm)
    var g8: [u8; 28] = "var {a = 1, b: {c} = {}} = o"
    if !chk(&p8, &l, &g8[0], 28, true) {
        return 9
    }
    var t9: ast.Ast = ast.ast_new()
    ast.ast_init(&t9)
    var p9: parse.Parser = parse.parser_new()
    parse.parser_init(&p9, &l, &t9, &nm)
    var g9: [u8; 34] = "t = `a${1}b${2}c`; u = tag`x\\u{}y`"
    if !chk(&p9, &l, &g9[0], 34, true) {
        return 10
    }
    var t10: ast.Ast = ast.ast_new()
    ast.ast_init(&t10)
    var p10: parse.Parser = parse.parser_new()
    parse.parser_init(&p10, &l, &t10, &nm)
    var g10: [u8; 31] = "x = 0b101 + 0o17 + 0x1f + 1_000"
    if !chk(&p10, &l, &g10[0], 31, true) {
        return 11
    }
    var t11: ast.Ast = ast.ast_new()
    ast.ast_init(&t11)
    var p11: parse.Parser = parse.parser_new()
    parse.parser_init(&p11, &l, &t11, &nm)
    var g11: [u8; 28] = "'use strict'; let yield1 = 1"
    if !chk(&p11, &l, &g11[0], 28, true) {
        return 12
    }
    var t12: ast.Ast = ast.ast_new()
    ast.ast_init(&t12)
    var p12: parse.Parser = parse.parser_new()
    parse.parser_init(&p12, &l, &t12, &nm)
    var g12: [u8; 5] = "a\n++b"
    if !chk(&p12, &l, &g12[0], 5, true) {
        return 13
    }
    var t13: ast.Ast = ast.ast_new()
    ast.ast_init(&t13)
    var p13: parse.Parser = parse.parser_new()
    parse.parser_init(&p13, &l, &t13, &nm)
    var g13: [u8; 21] = "if (x) function f(){}"
    if !chk(&p13, &l, &g13[0], 21, true) {
        return 14
    }
    var t14: ast.Ast = ast.ast_new()
    ast.ast_init(&t14)
    var p14: parse.Parser = parse.parser_new()
    parse.parser_init(&p14, &l, &t14, &nm)
    var g14: [u8; 21] = "x = /re/g.test(y) / 2"
    if !chk(&p14, &l, &g14[0], 21, true) {
        return 15
    }
    var t15: ast.Ast = ast.ast_new()
    ast.ast_init(&t15)
    var p15: parse.Parser = parse.parser_new()
    parse.parser_init(&p15, &l, &t15, &nm)
    var g15: [u8; 12] = "delete obj.x"
    if !chk(&p15, &l, &g15[0], 12, true) {
        return 16
    }
    var t16: ast.Ast = ast.ast_new()
    ast.ast_init(&t16)
    var p16: parse.Parser = parse.parser_new()
    parse.parser_init(&p16, &l, &t16, &nm)
    var g16: [u8; 33] = "function f(){ return new.target }"
    if !chk(&p16, &l, &g16[0], 33, true) {
        return 17
    }
    var t17: ast.Ast = ast.ast_new()
    ast.ast_init(&t17)
    var p17: parse.Parser = parse.parser_new()
    parse.parser_init(&p17, &l, &t17, &nm)
    var g17: [u8; 25] = "obj.if = 1; obj.class = 2"
    if !chk(&p17, &l, &g17[0], 25, true) {
        return 18
    }
    var t18: ast.Ast = ast.ast_new()
    ast.ast_init(&t18)
    var p18: parse.Parser = parse.parser_new()
    parse.parser_init(&p18, &l, &t18, &nm)
    var g18: [u8; 30] = "async = 1; let of = 2; get = 3"
    if !chk(&p18, &l, &g18[0], 30, true) {
        return 19
    }
    var t19: ast.Ast = ast.ast_new()
    ast.ast_init(&t19)
    var p19: parse.Parser = parse.parser_new()
    parse.parser_init(&p19, &l, &t19, &nm)
    var g19: [u8; 20] = "do ; while (0) x = 1"
    if !chk(&p19, &l, &g19[0], 20, true) {
        return 20
    }
    var t20: ast.Ast = ast.ast_new()
    ast.ast_init(&t20)
    var p20: parse.Parser = parse.parser_new()
    parse.parser_init(&p20, &l, &t20, &nm)
    var b0: [u8; 9] = "var a = ;"
    if !chk(&p20, &l, &b0[0], 9, false) {
        return 21
    }
    var t21: ast.Ast = ast.ast_new()
    ast.ast_init(&t21)
    var p21: parse.Parser = parse.parser_new()
    parse.parser_init(&p21, &l, &t21, &nm)
    var b1: [u8; 25] = "'use strict'; with (o) {}"
    if !chk(&p21, &l, &b1[0], 25, false) {
        return 22
    }
    var t22: ast.Ast = ast.ast_new()
    ast.ast_init(&t22)
    var p22: parse.Parser = parse.parser_new()
    parse.parser_init(&p22, &l, &t22, &nm)
    var b2: [u8; 26] = "'use strict'; var eval = 1"
    if !chk(&p22, &l, &b2[0], 26, false) {
        return 23
    }
    var t23: ast.Ast = ast.ast_new()
    ast.ast_init(&t23)
    var p23: parse.Parser = parse.parser_new()
    parse.parser_init(&p23, &l, &t23, &nm)
    var b3: [u8; 22] = "'use strict'; delete x"
    if !chk(&p23, &l, &b3[0], 22, false) {
        return 24
    }
    var t24: ast.Ast = ast.ast_new()
    ast.ast_init(&t24)
    var p24: parse.Parser = parse.parser_new()
    parse.parser_init(&p24, &l, &t24, &nm)
    var b4: [u8; 17] = "'use strict'; 012"
    if !chk(&p24, &l, &b4[0], 17, false) {
        return 25
    }
    var t25: ast.Ast = ast.ast_new()
    ast.ast_init(&t25)
    var p25: parse.Parser = parse.parser_new()
    parse.parser_init(&p25, &l, &t25, &nm)
    var b5: [u8; 33] = "'use strict'; function f(a, a) {}"
    if !chk(&p25, &l, &b5[0], 33, false) {
        return 26
    }
    var t26: ast.Ast = ast.ast_new()
    ast.ast_init(&t26)
    var p26: parse.Parser = parse.parser_new()
    parse.parser_init(&p26, &l, &t26, &nm)
    var b6: [u8; 13] = "let x; let x;"
    if !chk(&p26, &l, &b6[0], 13, false) {
