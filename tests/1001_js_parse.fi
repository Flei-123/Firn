    var t27: ast.Ast = ast.ast_new()
    ast.ast_init(&t27)
    var p27: parse.Parser = parse.parser_new()
    parse.parser_init(&p27, &l, &t27, &nm)
    var b7: [u8; 13] = "let y; var y;"
    if !chk(&p27, &l, &b7[0], 13, false) {
        return 28
    }
    var t28: ast.Ast = ast.ast_new()
    ast.ast_init(&t28)
    var p28: parse.Parser = parse.parser_new()
    parse.parser_init(&p28, &l, &t28, &nm)
    var b8: [u8; 43] = "class C { constructor(){} constructor(){} }"
    if !chk(&p28, &l, &b8[0], 43, false) {
        return 29
    }
    var t29: ast.Ast = ast.ast_new()
    ast.ast_init(&t29)
    var p29: parse.Parser = parse.parser_new()
    parse.parser_init(&p29, &l, &t29, &nm)
    var b9: [u8; 30] = "({__proto__: 1, __proto__: 2})"
    if !chk(&p29, &l, &b9[0], 30, false) {
        return 30
    }
    var t30: ast.Ast = ast.ast_new()
    ast.ast_init(&t30)
    var p30: parse.Parser = parse.parser_new()
    parse.parser_init(&p30, &l, &t30, &nm)
    var b10: [u8; 11] = "a ?? b || c"
    if !chk(&p30, &l, &b10[0], 11, false) {
        return 31
    }
    var t31: ast.Ast = ast.ast_new()
    ast.ast_init(&t31)
    var p31: parse.Parser = parse.parser_new()
    parse.parser_init(&p31, &l, &t31, &nm)
    var b11: [u8; 6] = "break;"
    if !chk(&p31, &l, &b11[0], 6, false) {
        return 32
    }
    var t32: ast.Ast = ast.ast_new()
    ast.ast_init(&t32)
    var p32: parse.Parser = parse.parser_new()
    parse.parser_init(&p32, &l, &t32, &nm)
    var b12: [u8; 13] = "continue foo;"
    if !chk(&p32, &l, &b12[0], 13, false) {
        return 33
    }
    var t33: ast.Ast = ast.ast_new()
    ast.ast_init(&t33)
    var p33: parse.Parser = parse.parser_new()
    parse.parser_init(&p33, &l, &t33, &nm)
    var b13: [u8; 9] = "return 1;"
    if !chk(&p33, &l, &b13[0], 9, false) {
        return 34
    }
    var t34: ast.Ast = ast.ast_new()
    ast.ast_init(&t34)
    var p34: parse.Parser = parse.parser_new()
    parse.parser_init(&p34, &l, &t34, &nm)
    var b14: [u8; 17] = "if (x) class C {}"
    if !chk(&p34, &l, &b14[0], 17, false) {
        return 35
    }
    var t35: ast.Ast = ast.ast_new()
    ast.ast_init(&t35)
    var p35: parse.Parser = parse.parser_new()
    parse.parser_init(&p35, &l, &t35, &nm)
    var b15: [u8; 21] = "while (0) const y = 1"
    if !chk(&p35, &l, &b15[0], 21, false) {
        return 36
    }
    var t36: ast.Ast = ast.ast_new()
    ast.ast_init(&t36)
