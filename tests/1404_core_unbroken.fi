// expect_exit: 0
// tests/1404_core_unbroken.fi -- ROUND 73: THE OLD NAMES STILL ANSWER.
//
// Round 73 cut the library in two. The cut runs through `lib/str/`,
// `lib/num/` and `lib/std/math.fi`, and it would be worthless if it broke
// the callers -- `std.str`, `std.num` and `std.math` have to keep offering
// exactly what they offered before.
//
// So this test uses BOTH halves side by side in ONE program: the same
// question is asked once of `core` and once of `str`/`num`/`math`, and the
// two answers have to agree. That also nails down the honest limit of the
// stage 0 module system: `core.Span` and `str.Span` are two DISTINCT types
// with the same shape (Firn has no type aliases), so the values cannot be
// swapped -- only their answers can be compared.
import std.core
import std.str
import std.num
import std.math

fn main() -> i32 {
    var line: [u8; 24] = "  vga=1 root=17 quiet  \0"
    var needle: [u8; 6] = "root=\0"

    // 1. the text side: one text, two facades, one answer
    let cs: core.Span = core.span_of_c(&line[0]).trim()
    let ss: str.Span = str.span_of_c(&line[0]).trim()
    if cs.length() != ss.length() { return 1 }
    if cs.find(core.span_of_c(&needle[0])) != ss.find(str.span_of_c(&needle[0])) { return 2 }
    if ss.find(str.span_of_c(&needle[0])) != 6 { return 3 }
    if cs.utf8_char() != ss.utf8_char() { return 4 }
    if core.compare(cs, cs) != str.compare(ss, ss) { return 5 }

    // 2. the number side: the same core, two front doors
    var a: i64 = 0
    var b: i64 = 0
    if !core.text_to_i64(cs.ab(11).p, 2, &a) { return 6 }
    if !num.text_to_i64(ss.ab(11).p, 2, &b) { return 7 }
    if a != 17 || b != 17 { return 8 }
    if num.parse_i64(ss.ab(11)).value != core.parse_i64(cs.ab(11)).value { return 9 }

    // 3. floating point: `num.text_to_f64` fetches its scratch memory with
    //    mmap, `core.text_to_f64_at` takes it from the frame. Same core,
    //    same bit pattern -- otherwise there would be two truths.
    var pi: [u8; 18] = "3.14159265358979\0\0"
    var ws: [u8; 12288] = [0; 12288]
    var x: f64 = 0.0
    var y: f64 = 0.0
    if !num.text_to_f64(&pi[0], 16, &x) { return 10 }
    if !core.text_to_f64_at(&pi[0], 16, &ws[0], &y) { return 11 }
    if num.f64_bits(x) != core.f64_bits(y) { return 12 }

    // 4. `std.num` still writes numbers as text -- that half stayed where
    //    it was, because it needs a `Bytes`, and a `Bytes` owns memory.
    var out: num.Bytes = num.bytes_new()
    num.write_i64(&out, 0 - 4711)
    num.write_hex(&out, 255, 4)
    if num.bytes_len(&out) != 9 { return 13 }
    if num.bytes_at(&out, 0) != 45 as u8 { return 14 }
    if num.bytes_at(&out, 8) != 102 as u8 { return 15 }
    num.bytes_free(&out)

    // 5. `std.str` still BUILDS text -- likewise
    var t: str.Bytes = str.bytes_new()
    str.append(&t, str.span_of_c(&needle[0]))
    str.after_big(&t, str.span_of_bytes(&t))
    if str.bytes_at(&t, 0) != 82 as u8 { return 16 }
    if t.length() != 5 { return 17 }
    str.bytes_free(&t)

    // 6. `std.math` answers under its old name, and `std.core` gives the
    //    same answer -- it is the SAME source text (lib/math/core_math.fi).
    if math.isqrt(144) != core.isqrt(144) { return 18 }
    if math.gcd(12, 18) != core.gcd(12, 18) { return 19 }
    if math.ilog10(1000) != core.ilog10(1000) { return 20 }
    if math.next_pow_two(100) != core.next_pow_two(100) { return 21 }
    if math.abs(0 - 5) != core.abs(0 - 5) { return 22 }
    if math.clamp(20, 0, 10) != core.clamp(20, 0, 10) { return 23 }
    if math.math_bits(math.sqrt(2.0)) != core.math_bits(core.sqrt(2.0)) { return 24 }
    if !math.near(math.PI(), core.PI(), 0.0) { return 25 }
    if math.math_bits(math.exp(1.0)) != core.math_bits(core.exp(1.0)) { return 26 }
    if math.math_bits(math.floor(0.0 - 2.5)) != core.math_bits(core.floor(0.0 - 2.5)) { return 27 }

    return 0
}
