// expect_exit: 0
// tests/4031_mc_biome_blend.fi -- r247 biome blend like vanilla ClientLevel.calculateBlockTint: per channel integer mean of the (2r+1)^2 columns around a
// block at its height, biome of a column = its 4x4x4 cell; the grid carries one cell ring of the neighbour sections (ms_snap_bio over 27 pointers).
import std.rt
import std.core
import std.math
import zip.zip
import pack.icons
import mc.mc_assets
import mc.mc_texture
import mc.mc_texext
import mc.mc_mesh
import mc.mc_model_mesh
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_chunk

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"

// 16 x 16 solid colour PNG
fn png_solid(r: u8, g: u8, b: u8, a: u8, out: *mut rt.Buf) -> bool {
    let px: u64 = rt.heap_alloc(16 * 16 * 4)
    var i: usize = 0
    while i < 256 {
        rt.st8(px, i * 4, r)
        rt.st8(px, i * 4 + 1, g)
        rt.st8(px, i * 4 + 2, b)
        rt.st8(px, i * 4 + 3, a)
        i = i + 1
    }
    let ok: bool = icons.png_encode(px, 16, 16, out)
    rt.heap_free(px, 16 * 16 * 4)
    return ok
}

fn add_text(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    let ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

fn add_png(w: *mut zip.ZipWriter, name: str, r: u8, g: u8, b: u8, a: u8) -> bool {
    var p: rt.Buf = rt.buf_new()
    if !png_solid(r, g, b, a, &p) { return false }
    let ok: bool = zip.zip_add(w, name, rt.buf_ptr(&p), rt.buf_len(&p), true) catch | e | (false)
    rt.buf_free(&p)
    return ok
}

// blockstate of a block without properties: one model for every state
fn add_state(w: *mut zip.ZipWriter, block: str, model: str) -> bool {
    return add_text(w, "assets/minecraft/blockstates/" + block + ".json", "{\"variants\":{\"\":{\"model\":\"" + model + "\"}}}")
}

// a model with ONE up face covering the whole top of the cell (flat on the cell face: AO applies), texture `tex`, optional tintindex 0
fn add_up_model(w: *mut zip.ZipWriter, name: str, tex: str, tinted: bool) -> bool {
    var tn: str = ""
    if tinted { tn = ",\"tintindex\":0" }
    return add_text(w, "assets/minecraft/models/block/" + name + ".json",
        "{\"textures\":{\"t\":\"block/" + tex + "\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"up\":{\"uv\":[0,0,16,16],\"texture\":\"#t\"" + tn + "}}}]}")
}

fn open_pack(b: *mut rt.Buf, w: *mut zip.ZipWriter, st: *mut mc_assets.PackStack) -> bool {
    let n: usize = zip.zip_finish(w) catch | e | (0)
    zip.zip_writer_free(w)
    if n == 0 { return false }
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&pk, rt.buf_ptr(b), rt.buf_len(b)) != mc_assets.ASSET_OK { return false }
    rt.buf_free(b)
    return mc_assets.stack_push(st, &pk) == mc_assets.ASSET_OK
}

fn sid(reg: *mut mc_registry.Registry, name: str) -> i32 {
    let blk: i32 = mc_registry.reg_block_by_name(reg, name.p as u64, name.length())
    if blk < 0 { return 0 - 1 }
    return mc_registry.reg_block_min_state(reg, blk)
}

// cell (x, y, z) of section 0 (a 16 x 16 x 16 u16 array per section, 2 sections)
fn put(ids: u64, x: i32, y: i32, z: i32, state: i32) {
    rt.st16(ids, ((y * 16 + z) * 16 + x) as usize, state as u16)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

fn chan(c: u32, k: i32) -> i32 {
    return ((c >> ((k * 8) as u32)) & (255 as u32)) as i32
}

fn iabs(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

// everything a scene needs, rebuilt per scene
struct Scene {
    tb: mc_mesh.MeshTables,
    ex: mc_texext.TexExt,
    atlas: mc_texture.Atlas,
    an: mc_assets.AnimSet,
}

fn scene_init(sc: *mut Scene, reg: *mut mc_registry.Registry, st: *mut mc_assets.PackStack) -> bool {
    (*sc).tb = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&(*sc).tb)
    (*sc).ex = mc_texext.texext_new()
    mc_texext.tex_build_tables_ext(reg, &(*sc).tb, &(*sc).ex)
    (*sc).atlas = mc_texext.texext_atlas_new(16, &(*sc).ex)
    (*sc).an = mc_assets.animset_new()
    return mc_assets.assets_apply_ext(st, &(*sc).atlas, &(*sc).ex, &(*sc).an) >= 1
}

fn biome_id(reg: *mut mc_registry.Registry, name: str) -> i32 {
    var i: i32 = 0
    while i < mc_registry.reg_biome_count(reg) {
        var nl: usize = 0
        let np: u64 = mc_registry.reg_biome_name(reg, i, &nl)
        var off: usize = 0
        if nl > 10 && rt.mem_eq(np, "minecraft:".p as u64, 10) { off = 10 }
        if nl - off == name.length() && rt.mem_eq(np + (off as u64), name.p as u64, nl - off) { return mc_registry.reg_biome_id(reg, i) }
        i = i + 1
    }
    return 0 - 1
}

// tint word of quad k of the buffer, unpacked to 0xRRGGBB (the mesher stores R | G << 8 | B << 16)
fn tint_of(buf: *mut rt.Buf, k: usize) -> u32 {
    let v: u32 = math.math_f64(rt.ld64(rt.buf_ptr(buf), k * 30 + 24)) as u32
    return ((v & (255 as u32)) << (16 as u32)) | (v & (65280 as u32)) | ((v >> (16 as u32)) & (255 as u32))
}

// the quad of cell (x, y, z): find it by its x0 (x + 0.0)
fn quad_at(buf: *mut rt.Buf, nq: usize, x: i32) -> usize {
    var k: usize = 0
    while k < nq {
        let qx: f64 = math.math_f64(rt.ld64(rt.buf_ptr(buf), k * 30))
        if qx > (x as f64) - 0.5 && qx < (x as f64) + 0.5 { return k }
        k = k + 1
    }
    return 999
}

fn avg3(a: u32, b: u32, c: u32, na: u32, nb: u32, nc: u32) -> u32 {
    let n: u32 = na + nb + nc
    var out: u32 = 0 as u32
    var k: i32 = 2
    while k >= 0 {
        let s: u32 = na * ((a >> ((k * 8) as u32)) & (255 as u32)) + nb * ((b >> ((k * 8) as u32)) & (255 as u32)) + nc * ((c >> ((k * 8) as u32)) & (255 as u32))
        out = (out << (8 as u32)) | ((s / n) & (255 as u32))
        k = k - 1
    }
    return out
}

fn new_sec(biome: u16) -> u64 {
    let sec: u64 = rt.heap_alloc(mc_chunk.section_size())
    let p: *mut mc_chunk.Section = sec as *mut mc_chunk.Section
    (*p).count = 0
    (*p).blocks = mc_chunk.Container { bits: 0 as u32, pal_n: 0 as u32, pal: 0, data: 0, words: 0 }
    let pal: u64 = rt.heap_alloc(2)
    rt.st16(pal, 0, biome)
    (*p).biomes = mc_chunk.Container { bits: 0 as u32, pal_n: 1 as u32, pal: pal, data: 0, words: 0 }
    return sec
}

fn fill_grid(bio: u64, id: i32) {
    var i: usize = 0
    while i < 216 {
        rt.st16(bio, i, id as u16)
        i = i + 1
    }
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 1 }
    var reg: mc_registry.Registry = v.registry_of()
    if !mc_registry.registry_ok(&reg) { return 2 }
    var stk: mc_assets.PackStack = mc_assets.stack_new()
    {
        var b: rt.Buf = rt.buf_new()
        var w: zip.ZipWriter = zip.zip_writer_new(&b)
        if !add_text(&w, "pack.mcmeta", META) { return 3 }
        if !add_png(&w, "assets/minecraft/textures/block/oak_planks.png", 240 as u8, 240 as u8, 240 as u8, 255 as u8) { return 3 }
        if !add_up_model(&w, "ms_t", "oak_planks", true) { return 3 }
        if !add_state(&w, "stone", "block/ms_t") { return 3 }
        if !open_pack(&b, &w, &stk) { return 3 }
    }
    var ex0: mc_texext.TexExt = mc_texext.texext_new()
    var sc: Scene = Scene { tb: mc_mesh.MeshTables { opaque: 0, tiles: 0 }, ex: mc_texext.texext_new(), atlas: mc_texext.texext_atlas_new(16, &ex0), an: mc_assets.animset_new() }
    if !scene_init(&sc, &reg, &stk) { return 4 }
    var ms: mc_model_mesh.ModelSet = mc_model_mesh.ms_new(&reg, &stk, &sc.ex)
    let s_stone: i32 = sid(&reg, "stone")
    if s_stone < 0 { return 5 }
    let b_plains: i32 = biome_id(&reg, "plains")
    let b_jungle: i32 = biome_id(&reg, "jungle")
    let b_desert: i32 = biome_id(&reg, "desert")
    if b_plains < 0 || b_jungle < 0 || b_desert < 0 { return 6 }
    mc_model_mesh.ms_load_biomes(&ms)
    let P: u32 = 0x91BD59 as u32
    let D: u32 = 0xBFB755 as u32
    let S: u32 = 0x59C93C as u32 // jungle (no swamp noise at the world origin columns)

    let bio: u64 = rt.heap_alloc(mc_model_mesh.BIO_BYTES)
    // uniform grid: any radius gives the plain colour
    fill_grid(bio, b_plains)
    var r: i32 = 0
    while r <= 4 {
        mc_model_mesh.ms_set_blend(&ms, r)
        if mc_model_mesh.ms_blend_color(&ms, bio, 0, 7, 5, 9) != P { return 10 }
        r = r + 1
    }
    // desert in cell (x 0, y 0, z 0) = blocks 0..3: grid index ((y + 1)*6 + z + 1)*6 + x + 1 = 43
    rt.st16(bio, 43, b_desert as u16)
    mc_model_mesh.ms_set_blend(&ms, 0)
    if mc_model_mesh.ms_blend_color(&ms, bio, 0, 2, 2, 2) != D { return 11 }
    // radius 1 around (2, 2, 2): columns 1..3 x 1..3 all in the desert cell
    mc_model_mesh.ms_set_blend(&ms, 1)
    if mc_model_mesh.ms_blend_color(&ms, bio, 0, 2, 2, 2) != D { return 12 }
    // radius 2 (vanilla default): x 0..4, z 0..4 -> 16 desert columns, 4 + 4 + 1 plains columns
    mc_model_mesh.ms_set_blend(&ms, 2)
    if mc_model_mesh.ms_blend_color(&ms, bio, 0, 2, 2, 2) != avg3(D, P, P, 16 as u32, 9 as u32, 0 as u32) { return 13 }
    // other tint class: foliage + water follow the same weights
    if mc_model_mesh.ms_blend_color(&ms, bio, 1, 2, 2, 2) != avg3(mc_model_mesh.ms_biome_color(&ms, 1, b_desert as usize), mc_model_mesh.ms_biome_color(&ms, 1, b_plains as usize), 0 as u32, 16 as u32, 9 as u32, 0 as u32) { return 14 }
    // a block one cell row higher (y 4..7) does not see the cell below
    if mc_model_mesh.ms_blend_color(&ms, bio, 0, 2, 5, 2) != P { return 15 }
    // radius 4 at the section edge reads the ring: jungle west ring column (cell x = -1, all z)
    var zc: i32 = 0 - 1
    while zc < 5 {
        rt.st16(bio, (((0 + 1) * 6 + zc + 1) * 6 + 0) as usize, b_jungle as u16)
        zc = zc + 1
    }
    mc_model_mesh.ms_set_blend(&ms, 2)
    // block x = 0: columns -2..2 -> 2 jungle columns (ring) + 3 in cell 0 (desert for z 0..3 rows, plains row z 4 is outside z 0..3 -> z = 1: rows -1..3 = cells -1 (z -1) and 0 (z 0..3))
    let want: u32 = avg3(S, D, P, 10 as u32, 12 as u32, 3 as u32)
    // jungle columns: 2 x 5 = 10; desert: x 0..2 (3 columns) x z in cell 0 (rows 0..3 = 4 rows) = 12; ring row z = -1 over x 0..2 is cell (0, -1) = plains idx 6*0+... = 3
    if mc_model_mesh.ms_blend_color(&ms, bio, 0, 0, 1, 1) != want { return 16 }
    // radius clamp
    mc_model_mesh.ms_set_blend(&ms, 99)
    if mc_model_mesh.ms_blend_color(&ms, bio, 0, 8, 1, 8) != P { return 17 }

    // end to end: a stone (grass class) at x = 15, y = 2, z = 8 of a section whose east neighbour is desert: 3 columns plains + 2 desert per row
    mc_model_mesh.ms_set_blend(&ms, 2)
    let pad: u64 = rt.heap_alloc(5832 * 2 + mc_model_mesh.BIO_BYTES)
    var i: usize = 0
    while i < 5832 {
        rt.st16(pad, i, 0 as u16)
        i = i + 1
    }
    rt.st16(pad, ((3 * 18 + 9) * 18 + 16) as usize, s_stone as u16)
    mc_model_mesh.ms_prepare(&ms, pad, &sc.tb)
    var secs: [u64; 27] = [0 as u64; 27]
    let mid: u64 = new_sec(b_plains as u16)
    secs[13] = mid
    secs[14] = new_sec(b_desert as u16) // dx = +1
    secs[10] = new_sec(b_jungle as u16) // dz = -1
    secs[12] = 0 // dx = -1 absent -> repeats the middle cells
    mc_model_mesh.ms_snap_bio((&secs[0]) as u64, pad + (mc_model_mesh.BIO_OFF as u64))
    let g: u64 = pad + (mc_model_mesh.BIO_OFF as u64)
    // grid: middle row z = 0, x = 4 (east ring) desert, x = -1 (west, absent) plains, z = -1 row jungle, y = 3 same
    if rt.ld16(g, ((0 + 1) * 6 + 1) * 6 + 3) != b_plains as u16 { return 20 } // y 0, z 0, x 2
    if rt.ld16(g, ((0 + 1) * 6 + 1) * 6 + 5) != b_desert as u16 { return 21 } // x = 4, z = 0
    if rt.ld16(g, ((3 + 1) * 6 + 4) * 6 + 5) != b_desert as u16 { return 22 } // x = 4, z = 3, y = 3
    if rt.ld16(g, ((0 + 1) * 6 + 1) * 6 + 0) != b_plains as u16 { return 23 } // x = -1 absent -> clamped middle cell
    if rt.ld16(g, ((1 + 1) * 6 + 0) * 6 + 3) != b_jungle as u16 { return 24 } // z = -1, x = 2, y = 1
    if rt.ld16(g, ((2 + 1) * 6 + 0) * 6 + 0) != b_plains as u16 && rt.ld16(g, ((2 + 1) * 6 + 0) * 6 + 0) != b_jungle as u16 { return 25 }
    var out: rt.Buf = rt.buf_new()
    var outt: rt.Buf = rt.buf_new()
    let nq: usize = mc_model_mesh.ms_mesh_split_bio(&ms, pad, 0, &sc.tb, 0, 0, 0, &out, &outt, g)
    if nq != 1 { return 30 }
    // columns x 13..17 (3 plains, 2 desert), rows z 6..10 (cells 1, 2: all plains / desert by x only)
    if tint_of(&out, 0) != avg3(P, D, 0 as u32, 15 as u32, 10 as u32, 0 as u32) { return 31 }
    // blend off: the cell colour only
    mc_model_mesh.ms_set_blend(&ms, 0)
    let nq0: usize = mc_model_mesh.ms_mesh_split_bio(&ms, pad, 0, &sc.tb, 0, 0, 0, &out, &outt, g)
    if nq0 != 1 { return 32 }
    if tint_of(&out, 0) != P { return 33 }
    // determinism + ms_reset keeps the radius
    mc_model_mesh.ms_set_blend(&ms, 3)
    mc_model_mesh.ms_reset(&ms)
    mc_model_mesh.ms_prepare(&ms, pad, &sc.tb)
    let nq3: usize = mc_model_mesh.ms_mesh_split_bio(&ms, pad, 0, &sc.tb, 0, 0, 0, &out, &outt, g)
    let t3: u32 = tint_of(&out, 0)
    let nq4: usize = mc_model_mesh.ms_mesh_split_bio(&ms, pad, 0, &sc.tb, 0, 0, 0, &out, &outt, g)
    if nq3 != 1 || nq4 != 1 || tint_of(&out, 0) != t3 { return 34 }
    // radius 3: x 12..18 = 4 plains + 3 desert columns
    if t3 != avg3(P, D, 0 as u32, 28 as u32, 21 as u32, 0 as u32) { return 35 }
    mc_model_mesh.ms_free(&ms)
    rt.heap_free(pad, 5832 * 2 + mc_model_mesh.BIO_BYTES)
    return 0
}
