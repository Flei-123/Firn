// expect_exit: 6
fn main() -> i32 {
    var r: i32 = 0
    var i: i32 = 0
    while i < 4 {
        if i > 0 {
            if i > 1 {
                if i > 2 {
                    r = r + 3
                } else {
                    r = r + 2
                }
            } else {
                r = r + 1
            }
        }
        i = i + 1
    }
    return r
}
