// expect_exit: 0
import hf.hub
import std.testkit

#[test]
fn add_and_read_back() {
    var l: hub.HfList = hub.hf_list_new()
    hub.hf_list_add(&l, "https://example.org/a.parquet", "a.parquet", 123)
    hub.hf_list_add(&l, "https://example.org/b.parquet", "b.parquet", 456789012345)
    testkit.assert_eq_i64(hub.hf_list_count(&l) as i64, 2)
    testkit.assert_true(hub.hf_list_a(&l, 0) == "https://example.org/a.parquet", "url 0")
    testkit.assert_true(hub.hf_list_b(&l, 1) == "b.parquet", "name 1")
    testkit.assert_eq_i64(hub.hf_list_size(&l, 0) as i64, 123)
    testkit.assert_eq_i64(hub.hf_list_size(&l, 1) as i64, 456789012345)
    hub.hf_list_free(&l)
    testkit.assert_eq_i64(hub.hf_list_count(&l) as i64, 0)
}
