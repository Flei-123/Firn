// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import html.mem
import rt.rt
import docview.pdf.pdf


fn fail(code: i32) -> i32 {
    return code
}

fn main() -> i32 {
    var SAMPLE: str = "%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj\n3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 200 100]/Contents 4 0 R/Resources<</Font<</F1 5 0 R>>>>/Annots[6 0 R]>>endobj\n4 0 obj<</Length 41>>stream\nBT /F1 18 Tf 10 50 Td (Hello Firn) Tj ET\nendstream\nendobj\n5 0 obj<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>endobj\n6 0 obj<</Type/Annot/Subtype/Link/Rect[10 40 100 70]/A<</S/URI/URI(https://firn.dev)>>>>endobj\ntrailer<</Root 1 0 R>>\n"
    var p: pdf.Pdf = pdf.pdf_new()
    if !pdf.pdf_open(&p, SAMPLE.p as u64, SAMPLE.n) {
        return fail(1)
    }
    if pdf.pdf_pages(&p) != 1 {
        return fail(2)
    }
    var w: f64 = 0.0
    var h: f64 = 0.0
    if !pdf.pdf_page_size(&p, 0, &w, &h) || w != 200.0 || h != 100.0 {
        return fail(3)
    }
    if !pdf.pdf_render(&p, 0, 2.0) || pdf.pdf_pixel_width(&p) != 400 || pdf.pdf_pixel_height(&p) != 200 {
        return fail(4)
    }
    var dark: usize = 0
    let px: u64 = pdf.pdf_pixels(&p)
    var i: usize = 0
    while i < 400 * 200 {
        if rt.ld8(px, i * 4) < 100 as u8 {
            dark = dark + 1
        }
        i = i + 1
    }
    if dark < 200 {
        return fail(5)
    }
    var t: mem.Buf = mem.buf_new()
    mem.buf_init(&t)
    if !pdf.pdf_text(&p, 0, &t) || mem.buf_len(&t) < 10 {
        return fail(6)
    }
    var hits: mem.Buf = mem.buf_new()
    mem.buf_init(&hits)
    var q: str = "FIRN"
    if pdf.pdf_find(&p, 0, q.p as u64, 4, &hits) != 1 {
        return fail(7)
    }
    var lk: mem.Buf = mem.buf_new()
    var us: mem.Buf = mem.buf_new()
    mem.buf_init(&lk)
    mem.buf_init(&us)
    if pdf.pdf_links(&p, 0, &lk, &us) != 1 || pdf.link_uri_len(&lk, 0) != 16 {
        return fail(8)
    }
    if rt.ld8(pdf.link_uri_at(&lk, &us, 0), 0) != 104 as u8 {
        return fail(9)
    }
    if pdf.link_w(&lk, 0) != 90.0 || pdf.link_h(&lk, 0) != 30.0 || pdf.link_y(&lk, 0) != 30.0 {
        return fail(10)
    }
    pdf.pdf_free(&p)
    var bad: pdf.Pdf = pdf.pdf_new()
    if pdf.pdf_open(&bad, SAMPLE.p as u64, 4) || pdf.pdf_error(&bad) != pdf.PDF_ERR_FORMAT {
        return fail(11)
    }
    return 0
}
