// expect_exit: 0
import std.rt
import std.vec
import std.testkit
import rvemu.machine as mc
import rvemu.bus as bus

fn main() -> i32 {
    var m: mc.Machine = mc.machine_new()
    mc.add_ram(&m, 2147483648 as u32, 65536 as u32)
    m.uart_on = true
    m.uart_base = 268435456 as u32
    m.fin_on = true
    m.fin_base = 1048576 as u32
    bus.write_word(&m, 2147483652 as u32, 305419896 as u32, 15 as u32)
    testkit.check(bus.read_word(&m, 2147483652 as u32) == 305419896 as u32, "word roundtrip")
    bus.write_word(&m, 2147483652 as u32, 65280 as u32, 2 as u32)
    testkit.check(bus.read_word(&m, 2147483652 as u32) == 305463160 as u32, "strobe merge")
    testkit.check(bus.read_word(&m, 268435460 as u32) == 24576 as u32, "uart status")
    bus.write_word(&m, 268435456 as u32, 65 as u32, 1 as u32)
    testkit.check(rt.buf_len(&m.out) == 1, "uart byte")
    bus.write_word(&m, 1048576 as u32, 21845 as u32, 15 as u32)
    testkit.check(m.exit_valid && m.exit_code == 0 as u32, "finisher pass")
    return testkit.finish()
}
