// expect_exit: 42
// Round GAPS: a gc class named through its module -- `Gc[m.C]`,
// `GcWeak[m.C]`, `gc m.C { }`, `gc_null[m.C]()`, `weak_null[m.C]()`
// (certus ROUND54 6.1: "expected ']' after the type argument, found '.'").
// Class names are global; the qualifier says where the class lives.
import modules.gapgc

fn sum(c: Gc[gapgc.Cell]) -> u64 {
    var s: u64 = 0
    var p: Gc[gapgc.Cell] = c
    while p != gc_null[gapgc.Cell]() {
        s = s + p.v
        p = p.next
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 3 as i32 }
    let a: Gc[gapgc.Cell] = gapgc.cell_new(12)
    let b: Gc[gapgc.Cell] = gc gapgc.Cell { next: a, v: 30 } catch gc_null[gapgc.Cell]()
    if b == gc_null[gapgc.Cell]() { return 1 as i32 }
    let w: GcWeak[gapgc.Cell] = weak_null[gapgc.Cell]()
    let s: u64 = sum(b)
    return s as i32
}
