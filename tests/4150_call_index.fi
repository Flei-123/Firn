// expect_exit: 0
// tests/4150_call_index.fi -- r728: call through an expression callee: `v[i](x)`, `s.fs[i](x)`, `(expr)(x)`.
import std.io
import std.rt
import std.vec

struct Ops {
    fs: Vec[fn(i64) -> i64],
    one: fn(i64) -> i64,
}

fn inc(x: i64) -> i64 {
    return x + 1
}

fn dbl(x: i64) -> i64 {
    return x * 2
}

fn pick(k: i64) -> fn(i64) -> i64 {
    if k == 0 {
        return inc
    }
    return dbl
}

fn capture() -> AllocError!i64 {
    let n: i64 = 10
    var fs: [fn(i64) -> i64; 2] = [inc, dbl]
    let cl: fn(i64) -> i64 = try gc |x| x + n
    fs[1] = cl
    return fs[1](5)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[fn(i64) -> i64] = vec_new[fn(i64) -> i64]()
    vec_push[fn(i64) -> i64](&v, inc)
    vec_push[fn(i64) -> i64](&v, dbl)
    vec_push[fn(i64) -> i64](&v, |x| x + 10)
    if v[0](5) != 6 { return 2 }
    if v[1](5) != 10 { return 3 }
    if v[2](5) != 15 { return 4 }
    if v[-1](1) != 11 { return 5 }
    // call result used inside an expression
    if v[0](v[1](3)) != 7 { return 6 }
    // array of fn values
    let arr: [fn(i64) -> i64; 2] = [dbl, inc]
    if arr[0](4) != 8 { return 7 }
    if arr[1](4) != 5 { return 8 }
    // field holding a Vec of fn values
    var o: Ops = Ops { fs: vec_new[fn(i64) -> i64](), one: dbl }
    vec_push[fn(i64) -> i64](&o.fs, inc)
    vec_push[fn(i64) -> i64](&o.fs, dbl)
    if o.fs[1](21) != 42 { return 9 }
    if o.fs[0](41) != 42 { return 10 }
    // parenthesised callee and call result as callee
    if (o.one)(8) != 16 { return 11 }
    if (pick(0))(1) != 2 { return 12 }
    if pick(1)(7) != 14 { return 13 }
    let c: i64 = capture() catch | e | 0
    if c != 15 { return 14 }
    return 0
}
