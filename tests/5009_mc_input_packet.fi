// expect_exit: 0
import std.net
import std.rt
import std.bytes
import mc.mc_codec
import mc.mc_client
import mc.mc_play
import mc.mc_input
import mc.mc_sem
import mc.mc_version
import mc.v763.mc_proto_v763
import mc.v769.mc_proto_v769
import mc.v775.mc_proto_v775

static mut g_fail: i32 = 0

fn check(ok: bool, msg: str) {
    if !ok {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_bytes(&o, msg.p as u64, msg.n)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn expect(got: i32, want: i32, msg: str) {
    if got != want {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_bytes(&o, msg.p as u64, msg.n)
        rt.buf_push_bytes(&o, " got ".p as u64, 5)
        rt.buf_push_dec_i64(&o, got as i64)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn read_inputs(sw: *mut mc_codec.Wire, ver: *mut mc_version.Version) -> i32 {
    var body: bytes.Bytes = bytes.bytes_new()
    let id: i32 = mc_codec.wire_read_packet(sw, &body) catch 0 - 100
    if id != mc_version.version_pid(ver, mc_sem.SEM_PLAY_C2S_PLAYER_INPUT) { return 0 - 1 }
    if bytes.bytes_remaining(&body) != 1 as usize { return 0 - 2 }
    return (bytes.get_u8(&body) catch 0) as i32
}

fn round(ver: mc_version.Version, expect_packet: bool) {
    var v: mc_version.Version = ver
    var lst: net.Listener = net.listen_tcp(net.ipv4(127 as u8, 0 as u8, 0 as u8, 1 as u8), 0 as u16) catch net.listener_from_fd(0 - 1)
    let port: u16 = net.listener_port(&lst)
    var cc: net.Conn = net.connect_tcp(net.ipv4(127 as u8, 0 as u8, 0 as u8, 1 as u8), port) catch net.conn_from_fd(0 - 1)
    var sc: net.Conn = net.accept(&lst) catch net.conn_from_fd(0 - 1)
    var cl: mc_client.Client = mc_client.client_new(cc, v)
    var sw: mc_codec.Wire = mc_codec.wire_open(sc)
    mc_codec.wire_timeout(&sw, 300)
    check(mc_play.send_input(&cl, mc_input.K_FORWARD | mc_input.K_SPRINT), "send forward+sprint")
    if expect_packet {
        expect(read_inputs(&sw, &v), 65, "forward+sprint = 0x41")
        check(mc_play.send_input(&cl, mc_input.K_SNEAK | mc_input.K_JUMP | mc_input.K_LEFT), "send jump+shift+left")
        expect(read_inputs(&sw, &v), 52, "left+jump+shift = 0x34")
        check(mc_play.send_input(&cl, 0 as u32), "send none")
        expect(read_inputs(&sw, &v), 0, "no keys = 0")
        check(mc_play.send_input(&cl, mc_input.K_BACK | mc_input.K_RIGHT), "send back+right")
        expect(read_inputs(&sw, &v), 10, "backward+right = 0x0a")
    } else {
        check(read_inputs(&sw, &v) == 0 - 1, "no Player Input before protocol 768")
    }
    mc_codec.wire_close(&sw)
    mc_client.client_free(&cl)
    net.close_listener(&lst)
}

fn main() -> i32 {
    round(mc_proto_v763.version_make(), false)
    round(mc_proto_v769.version_make(), true)
    round(mc_proto_v775.version_make(), true)
    return g_fail
}
