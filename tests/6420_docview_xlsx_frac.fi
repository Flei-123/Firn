// expect_exit: 0
import std.rt
import docview.office.xl_numfmt

fn say(s: str) {
    rt.write_everything(2, s.p as u64, s.n)
}

fn check(code: str, v: f64, want: str) -> bool {
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    xl_numfmt.format_value(code, v, false, &out)
    let got: str = rt.buf_str(&out)
    if got != want {
        say(code)
        say(" -> [")
        say(got)
        say("] want [")
        say(want)
        say("]\n")
        return false
    }
    return true
}

fn main() -> i32 {
    var bad: i32 = 0
    if !check("# ?/?", 3.75, "3 3/4") { bad = bad + 1 }
    if !check("# ?/?", 0.5, " 1/2") { bad = bad + 1 }
    if !check("# ??/??", 3.25, "3  1/4 ") { bad = bad + 1 }
    if !check("?/?", 2.5, "5/2") { bad = bad + 1 }
    if !check("# ?/8", 0.3, " 2/8") { bad = bad + 1 }
    if !check("# ?/?", 2.0, "2    ") { bad = bad + 1 }
    if !check("# ?/?", 1.99999, "2    ") { bad = bad + 1 }
    if !check("# ?/?", 0.333, " 1/3") { bad = bad + 1 }
    if !check("0.00", 3.14159, "3.14") { bad = bad + 1 }
    if !check("0%", 0.5, "50%") { bad = bad + 1 }
    return bad
}
