// expect_exit: 0
fn tri(n: usize) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < n {
        var j: usize = 0
        while j < n {
            let a: i64 = i as i64
            let b: i64 = j as i64
            s = s + (a + b) * (a + b + 1) / 2 + a + 1
            j = j + 1
        }
        i = i + 1
    }
    return s
}

fn rem_loop(n: usize) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < n {
        let a: i64 = i as i64
        s = s + (a * 7 + 3) % 8 + a * a / 4
        i = i + 1
    }
    return s
}

fn neg_values(v: i64, w: i64) -> i64 {
    return ((v / 4) * 3 + (v % 16)) * w
}

fn i32_mixed(n: i32) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    while i < n {
        s = s + (i * 3 - 50) / 8 + (i * 5 - 30) % 4
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if tri(50) != 3646875 {
        return 1
    }
    if rem_loop(100) != 82417 {
        return 2
    }
    let vals: [i64; 11] = [-9, -8, -7, -1, 0, 1, 7, 8, 9, 1000003, -1000003]
    var acc: i64 = 0
    var k: usize = 0
    while k < 11 {
        acc = acc + neg_values(vals[k], (k + 1) as i64)
        k = k + 1
    }
    if acc != -749757 {
        return 3
    }
    if i32_mixed(40) != 80 {
        return 4
    }
    return 0
}
