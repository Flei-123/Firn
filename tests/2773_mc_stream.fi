// expect_exit: 0
// tests/2773_mc_stream.fi -- mc_stream: threaded section meshing + chunk streaming.
//
// The reference image is built WITHOUT the stream: every section of the terrain world (mc_terrain) meshed from a padded
// array, drawn for the frustum section list of mc_cull (tests/2772 proved that equals the culled image).
// A  pool = 0 (inline): flush -> image == reference for 6 poses; cave culling really culls (visible < frustum)
// B  4 worker threads (jobs), synchronous flush: same images
// C  4 workers, asynchronous frames with a small upload budget: it converges and the image is the same
// D  neighbour wait: a lone column meshes only after nbr_wait frames; when the neighbours arrive it is remeshed (== reference)
// E  stream_mark_block: the section is dirty again and meshes to the same result
// F  stream_drop_far: far columns leave the stream and the world, nothing crashes, near ones stay
// G  stale queued jobs are cancelled when the camera turns away
// H  stream_window_sync: columns outside dist + extra leave the stream but stay in the world; they come back when the camera returns; idempotent
import std.rt
import mc.mc_chunk
import mc.mc_world
import mc.mc_mesh
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_backend
import mc.mc_cull
import mc.mc_terrain
import mc.mc_render_world
import mc.mc_stream
import jobs.jobs

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND {
        return jobs.worker_main(arg)
    }
    return 0
}

const NSEC: i32 = 6
const RAD: i32 = 3
const WIN: i32 = 6 // stream window: every generated column is inside it for any pose

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn floor_div16(v: i32) -> i32 {
    var q: i32 = v / 16
    if v % 16 != 0 && v < 0 { q = q - 1 }
    return q
}

fn fl(v: f64) -> i32 {
    var x: i32 = v as i32
    if (x as f64) > v { x = x - 1 }
    return x
}

fn world_pad(cx: i32, sy: i32, cz: i32, pad: u64) {
    var py: i32 = 0
    while py < 18 {
        var pz: i32 = 0
        while pz < 18 {
            var px: i32 = 0
            while px < 18 {
                let x: i32 = cx * 16 + px - 1
                let y: i32 = sy * 16 + py - 1
                let z: i32 = cz * 16 + pz - 1
                let colx: i32 = floor_div16(x)
                let colz: i32 = floor_div16(z)
                var id: u16 = 65535 as u16
                if colx >= 0 - RAD && colx <= RAD && colz >= 0 - RAD && colz <= RAD && y >= 0 && y < NSEC * 16 {
                    id = mc_terrain.terrain_block(x, y, z, NSEC)
                }
                rt.st16(pad, ((py * 18 + pz) * 18 + px) as usize, id)
                px = px + 1
            }
            pz = pz + 1
        }
        py = py + 1
    }
}

fn cell(cx: i32, sy: i32, cz: i32) -> usize {
    return (((cz + RAD) * (RAD * 2 + 1) + cx + RAD) * NSEC + sy) as usize
}

// reference handles of every section (0 = no faces)
fn build_ref(r: *mut mc_raster.Raster, tb: *mut mc_mesh.MeshTables, hs: u64) {
    var m: mc_mesh.Mesher = mc_mesh.mesher_new()
    let pad: u64 = rt.heap_alloc(5832 * 2)
    var cz: i32 = 0 - RAD
    while cz <= RAD {
        var cx: i32 = 0 - RAD
        while cx <= RAD {
            var sy: i32 = 0
            while sy < NSEC {
                world_pad(cx, sy, cz, pad)
                mc_mesh.mesh_padded(&m, pad, tb, mc_mesh.F_AO | mc_mesh.F_GREEDY)
                var hd: usize = 0
                if m.nverts > 0 as u32 {
                    hd = mc_raster.backend_mesh_upload(r, mc_cull.cull_pack(cx, sy, cz), m.verts, m.nverts as usize, m.idx, m.nidx as usize)
                }
                rt.st64(hs, cell(cx, sy, cz), hd as u64)
                sy = sy + 1
            }
            cx = cx + 1
        }
        cz = cz + 1
    }
    mc_mesh.mesher_free(&m)
    rt.heap_free(pad, 5832 * 2)
}

// reference image of the frustum section list
fn ref_image(r: *mut mc_raster.Raster, cam: *mut mc_camera.Camera, c: *mut mc_cull.Cull, hs: u64, h: u64) {
    let n: usize = mc_cull.cull_run_frustum(c, cam, WIN)
    mc_raster.backend_begin(r, cam, 0xFF3C2814 as u32)
    var k: usize = 0
    while k < n {
        let key: u64 = mc_cull.cull_out_key(c, k)
        let cx: i32 = mc_cull.cull_out_cx(key)
        let cz: i32 = mc_cull.cull_out_cz(key)
        let sy: i32 = mc_cull.cull_out_sy(key)
        k = k + 1
        if cx < 0 - RAD || cx > RAD || cz < 0 - RAD || cz > RAD { continue }
        let hd: usize = rt.ld64(hs, cell(cx, sy, cz)) as usize
        if hd != 0 {
            mc_raster.backend_draw(r, hd, (cx * 16) as f64, (sy * 16) as f64, (cz * 16) as f64)
        }
    }
    mc_raster.backend_end(r)
    mc_raster.raster_hash_hex(r, h)
}

// one stream frame -> image hash
#[allow_escape]
fn stream_image(s: *mut mc_stream.Stream, w: *mut mc_world.World, b: *mut mc_backend.Backend, r: *mut mc_raster.Raster,
    cam: *mut mc_camera.Camera, h: u64) -> u64 {
    (*b).begin((*b).obj, cam as u64, 0xFF3C2814 as u32)
    let tris: u64 = mc_stream.stream_frame(s, w, b, cam)
    (*b).end((*b).obj)
    mc_raster.raster_hash_hex(r, h)
    return tris
}

fn same_hash(a: u64, b: u64) -> bool {
    var i: usize = 0
    while i < 64 {
        if rt.ld8(a, i) != rt.ld8(b, i) { return false }
        i = i + 1
    }
    return true
}

#[allow_escape]
fn load_column(w: *mut mc_world.World, s: *mut mc_stream.Stream, cx: i32, cz: i32, ids: u64) {
    mc_terrain.terrain_column(cx, cz, NSEC, ids)
    check(mc_world.world_put(w, mc_render_world.wr_make_chunk(cx, cz, NSEC as usize, ids)), 50)
    check(mc_stream.stream_chunk_loaded(s, w, cx, cz), 51)
}

#[allow_escape]
fn load_all(w: *mut mc_world.World, s: *mut mc_stream.Stream, ids: u64) {
    var cz: i32 = 0 - RAD
    while cz <= RAD {
        var cx: i32 = 0 - RAD
        while cx <= RAD {
            load_column(w, s, cx, cz, ids)
            cx = cx + 1
        }
        cz = cz + 1
    }
}

static mut g_seed: u64 = 777

fn rnd_f(lo: f64, hi: f64) -> f64 {
    g_seed = g_seed *% 6364136223846793005 as u64 +% 1442695040888963407 as u64
    return lo + (hi - lo) * (((g_seed >> 33 as u64) % 100000 as u64) as f64 / 100000.0)
}

fn pose(cam: *mut mc_camera.Camera, i: i32) {
    var px: f64 = rnd_f(0.0 - 30.0, 30.0)
    var pz: f64 = rnd_f(0.0 - 30.0, 30.0)
    var py: f64 = (mc_terrain.terrain_height(fl(px), fl(pz), NSEC) + 3) as f64
    if i % 2 == 1 { py = rnd_f(6.0, 30.0) }
    var guard: i32 = 0
    while mc_terrain.terrain_block(fl(px), fl(py), fl(pz), NSEC) != 0 as u16 && guard < 80 {
        py = py + 1.0
        guard = guard + 1
    }
    mc_camera.camera_set_pos(cam, px, py, pz)
    mc_camera.camera_set_angles(cam, rnd_f(0.0 - 180.0, 180.0), rnd_f(0.0 - 25.0, 25.0))
    mc_camera.camera_update(cam)
}

fn fresh_raster(a: *mut mc_texture.Atlas) -> mc_raster.Raster {
    var r: mc_raster.Raster = mc_raster.raster_new(96, 54)
    mc_raster.backend_upload_atlas(&r, a)
    return r
}

// stream with 6 pose checks against the reference; returns the sum of visible and of frustum sections
#[allow_escape]
fn poses_equal(s: *mut mc_stream.Stream, w: *mut mc_world.World, b: *mut mc_backend.Backend, r: *mut mc_raster.Raster,
    rr: *mut mc_raster.Raster, cam: *mut mc_camera.Camera, c: *mut mc_cull.Cull, hs: u64, code: i32) -> u64 {
    let h1: u64 = rt.heap_alloc(64)
    let h2: u64 = rt.heap_alloc(64)
    var vis: u64 = 0
    var fr: u64 = 0
    var i: i32 = 0
    while i < 6 {
        pose(cam, i)
        let nfl: usize = mc_stream.stream_flush(s, w, b, cam, 200)
        check(nfl < 200, code)
        check(mc_stream.stream_pending(s) == 0, code + 1)
        ref_image(rr, cam, c, hs, h1)
        stream_image(s, w, b, r, cam, h2)
        check(same_hash(h1, h2), code + 2)
        vis = vis + (*s).st.visible as u64
        fr = fr + (mc_cull.cull_run_frustum(c, cam, WIN)) as u64
        i = i + 1
    }
    rt.heap_free(h1, 64)
    rt.heap_free(h2, 64)
    return vis * 100000 + fr
}

#[allow_escape]
fn main() -> i32 {
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_terrain.terrain_tables(&tb)
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    var rr: mc_raster.Raster = fresh_raster(&a) // reference raster
    var cam: mc_camera.Camera = mc_camera.camera_new(96, 54)
    mc_camera.camera_set_lens(&cam, 70.0, 0.05, 160.0)
    var c: mc_cull.Cull = mc_cull.cull_new(0, NSEC) // frustum lists only (no graph needed)
    let hs: u64 = rt.heap_alloc(7 * 7 * NSEC as usize * 8)
    build_ref(&rr, &tb, hs)
    let ids: u64 = rt.heap_alloc(NSEC as usize * 4096 * 2)

    // ---- A: inline
    {
        var r: mc_raster.Raster = fresh_raster(&a)
        var b: mc_backend.Backend = mc_backend.backend_cpu(&r)
        var w: mc_world.World = mc_world.world_new()
        var s: mc_stream.Stream = mc_stream.stream_new(0, NSEC, WIN, &tb, 0)
        s.nbr_wait = 3 as u32
        load_all(&w, &s, ids)
        check(mc_stream.stream_sections(&s) == 49 * NSEC as usize, 1)
        let vf: u64 = poses_equal(&s, &w, &b, &r, &rr, &cam, &c, hs, 2)
        let vis: u64 = vf / 100000
        let fr: u64 = vf % 100000
        check(vis < fr, 6) // cave culling culls something over 6 poses
        // measure flag: frustum >= visible
        s.measure = true
        mc_stream.stream_frame(&s, &w, &b, &cam)
        check(s.st.frustum >= s.st.visible && s.st.drawn > 0 as u32 && s.st.tris > 0 as u64, 7)
        mc_stream.stream_free(&s, &b)
        mc_world.world_free(&w)
    }

    // ---- B: 4 worker threads, synchronous flush
    var pool: jobs.Jobs = jobs.create(4)
    check(jobs.worker_count(&pool) > 0 as u64, 8)
    {
        var r: mc_raster.Raster = fresh_raster(&a)
        var b: mc_backend.Backend = mc_backend.backend_cpu(&r)
        var w: mc_world.World = mc_world.world_new()
        var s: mc_stream.Stream = mc_stream.stream_new(0, NSEC, WIN, &tb, (&pool) as *mut jobs.Jobs as u64)
        s.nbr_wait = 3 as u32
        load_all(&w, &s, ids)
        poses_equal(&s, &w, &b, &r, &rr, &cam, &c, hs, 10)
        mc_stream.stream_free(&s, &b)
        mc_world.world_free(&w)
    }

    // ---- C: asynchronous frames, small upload budget
    {
        var r: mc_raster.Raster = fresh_raster(&a)
        var b: mc_backend.Backend = mc_backend.backend_cpu(&r)
        var w: mc_world.World = mc_world.world_new()
        var s: mc_stream.Stream = mc_stream.stream_new(0, NSEC, WIN, &tb, (&pool) as *mut jobs.Jobs as u64)
        s.nbr_wait = 3 as u32
        s.upload_budget_us = 300 as u64
        s.max_inflight = 8
        s.max_submit = 4
        load_all(&w, &s, ids)
        pose(&cam, 0)
        let h1: u64 = rt.heap_alloc(64)
        let h2: u64 = rt.heap_alloc(64)
        var frames: i32 = 0
        var submitted: u32 = 0 as u32
        var uploaded: u32 = 0 as u32
        while frames < 200000 {
            stream_image(&s, &w, &b, &r, &cam, h2)
            submitted = submitted + s.st.submitted
            uploaded = uploaded + s.st.uploaded
            frames = frames + 1
            if mc_stream.stream_pending(&s) == 0 && s.inflight == 0 { break }
        }
        check(frames < 200000, 20)
        check(submitted > 0 as u32 && uploaded > 0 as u32, 21)
        ref_image(&rr, &cam, &c, hs, h1)
        stream_image(&s, &w, &b, &r, &cam, h2)
        check(same_hash(h1, h2), 22)
        // E: block marked -> dirty, meshes again, same image
        mc_stream.stream_mark_block(&s, 3, 20, 3)
        check(mc_stream.stream_pending(&s) > 0, 23) // dirty at once (before any frame; the workers may be faster than the frame)
        stream_image(&s, &w, &b, &r, &cam, h2)
        let nfl: usize = mc_stream.stream_flush(&s, &w, &b, &cam, 200)
        check(nfl < 200 && mc_stream.stream_pending(&s) == 0, 24)
        stream_image(&s, &w, &b, &r, &cam, h2)
        check(same_hash(h1, h2), 25)
        // G: turn around while a lot is queued: stale queued jobs get cancelled
        let secs: usize = mc_stream.stream_sections(&s)
        var k: i32 = 0 - RAD
        while k <= RAD {
            var j: i32 = 0 - RAD
            while j <= RAD {
                mc_stream.stream_mark_block(&s, k * 16 + 1, 20, j * 16 + 1)
                j = j + 1
            }
            k = k + 1
        }
        mc_camera.camera_set_pos(&cam, 0.5, 40.0, 0.5)
        mc_camera.camera_set_angles(&cam, 0.0, 0.0)
        mc_camera.camera_update(&cam)
        s.max_inflight = 32
        s.max_submit = 32
        stream_image(&s, &w, &b, &r, &cam, h2)
        mc_camera.camera_set_angles(&cam, 180.0, 0.0)
        mc_camera.camera_set_pos(&cam, 0.5, 40.0, 0.5 + 200.0)
        mc_camera.camera_update(&cam)
        var canceled: u32 = 0 as u32
        var t: i32 = 0
        while t < 4 {
            stream_image(&s, &w, &b, &r, &cam, h2)
            canceled = canceled + s.st.canceled
            t = t + 1
        }
        let fl2: usize = mc_stream.stream_flush(&s, &w, &b, &cam, 400)
        check(fl2 < 400 && s.inflight == 0, 26) // pending stays > 0: the columns are outside the window now
        check(mc_stream.stream_sections(&s) == secs, 27)
        // F: drop far columns (camera 200 blocks away): everything leaves
        let before: usize = mc_world.world_count(&w)
        let dropped: usize = mc_stream.stream_drop_far(&s, &w, &b, &cam, 0, 100, true)
        check(dropped > 0 && mc_world.world_count(&w) == before - dropped, 28)
        check(mc_stream.stream_sections(&s) < secs, 29)
        // the rest still renders without crashing
        mc_stream.stream_flush(&s, &w, &b, &cam, 50)
        stream_image(&s, &w, &b, &r, &cam, h2)
        mc_stream.stream_free(&s, &b)
        mc_world.world_free(&w)
        rt.heap_free(h1, 64)
        rt.heap_free(h2, 64)
    }

    // ---- D: neighbour wait
    {
        var r: mc_raster.Raster = fresh_raster(&a)
        var b: mc_backend.Backend = mc_backend.backend_cpu(&r)
        var w: mc_world.World = mc_world.world_new()
        var s: mc_stream.Stream = mc_stream.stream_new(0, NSEC, WIN, &tb, 0)
        s.nbr_wait = 6 as u32
        load_column(&w, &s, 0, 0, ids)
        pose(&cam, 0)
        mc_camera.camera_set_pos(&cam, 8.5, 40.0, 8.5)
        mc_camera.camera_update(&cam)
        let h1: u64 = rt.heap_alloc(64)
        let h2: u64 = rt.heap_alloc(64)
        var up: u32 = 0 as u32
        var deferred: u32 = 0 as u32
        var f: i32 = 0
        while f < 3 {
            stream_image(&s, &w, &b, &r, &cam, h2)
            up = up + s.st.uploaded + s.st.submitted
            deferred = deferred + s.st.deferred_nbr
            f = f + 1
        }
        check(up == 0 as u32 && deferred > 0 as u32, 40) // still waiting for the 8 neighbours
        var meshed: bool = false
        f = 0
        while f < 30 && !meshed {
            stream_image(&s, &w, &b, &r, &cam, h2)
            if s.st.submitted > 0 as u32 || s.st.skipped_empty > 0 as u32 { meshed = true }
            f = f + 1
        }
        check(meshed, 41) // gave up waiting
        // the neighbours arrive: the border sections are remeshed
        var cz: i32 = 0 - RAD
        while cz <= RAD {
            var cx: i32 = 0 - RAD
            while cx <= RAD {
                if cx != 0 || cz != 0 { load_column(&w, &s, cx, cz, ids) }
                cx = cx + 1
            }
            cz = cz + 1
        }
        pose(&cam, 2)
        let nfl: usize = mc_stream.stream_flush(&s, &w, &b, &cam, 200)
        check(nfl < 200 && mc_stream.stream_pending(&s) == 0, 42)
        ref_image(&rr, &cam, &c, hs, h1)
        stream_image(&s, &w, &b, &r, &cam, h2)
        check(same_hash(h1, h2), 43)
        mc_stream.stream_free(&s, &b)
        mc_world.world_free(&w)
        rt.heap_free(h1, 64)
        rt.heap_free(h2, 64)
    }

    // ---- H: window sync (client far-column logic)
    {
        var r: mc_raster.Raster = fresh_raster(&a)
        var b: mc_backend.Backend = mc_backend.backend_cpu(&r)
        var w: mc_world.World = mc_world.world_new()
        var s: mc_stream.Stream = mc_stream.stream_new(0, NSEC, 1, &tb, 0)
        load_all(&w, &s, ids)
        let total: usize = mc_world.world_count(&w)
        check(total == ((RAD * 2 + 1) * (RAD * 2 + 1)) as usize, 60)
        mc_camera.camera_set_pos(&cam, 8.5, 40.0, 8.5)
        mc_camera.camera_set_angles(&cam, 0.0, 0.0)
        mc_camera.camera_update(&cam)
        mc_stream.stream_flush(&s, &w, &b, &cam, 100)
        let secs0: usize = mc_stream.stream_sections(&s)
        // dist 1 + extra 1: columns with |dx| or |dz| > 2 leave the stream (24 of 49), the world keeps all of them
        let n1: usize = mc_stream.stream_window_sync(&s, &w, &b, &cam, 1, 1000, 1000)
        check(n1 == 24, 61)
        check(mc_world.world_count(&w) == total, 62)
        check(!mc_stream.stream_has_column(&s, 3, 0) && !mc_stream.stream_has_column(&s, 0, 0 - 3), 63)
        check(mc_stream.stream_has_column(&s, 2, 0) && mc_stream.stream_has_column(&s, 0 - 2, 2), 64)
        check(mc_stream.stream_sections(&s) < secs0, 65)
        check(mc_stream.stream_window_sync(&s, &w, &b, &cam, 1, 1000, 1000) == 0, 66) // idempotent
        // the budget limits the drops per call
        mc_camera.camera_set_pos(&cam, 3.0 * 16.0 + 8.5, 40.0, 8.5)
        mc_camera.camera_update(&cam)
        let n2: usize = mc_stream.stream_window_sync(&s, &w, &b, &cam, 1, 3, 2)
        check(n2 <= 5 && n2 > 0, 67)
        // walk until it settles: camera column 3 -> reach 1..5 in x, -2..2 in z
        var guard: i32 = 0
        while mc_stream.stream_window_sync(&s, &w, &b, &cam, 1, 3, 2) > 0 && guard < 100 { guard = guard + 1 }
        check(guard < 100, 68)
        check(mc_stream.stream_has_column(&s, 3, 0) && mc_stream.stream_has_column(&s, 1, 0 - 2), 69)
        check(!mc_stream.stream_has_column(&s, 0 - 3, 0) && !mc_stream.stream_has_column(&s, 0, 0), 70)
        // meshes the new window and draws without trouble
        mc_stream.stream_flush(&s, &w, &b, &cam, 40) // pending stays > 0 for the ring outside dist (as in F)
        check(s.inflight == 0, 71)
        check(mc_stream.stream_sections(&s) > 0, 72)
        mc_stream.stream_free(&s, &b)
        mc_world.world_free(&w)
    }
    jobs.destroy(&pool)
    mc_cull.cull_free(&c)
    return 0
}
