// expect_exit: 42
// tests/1930_fui_navkit.fi -- lib/fui/navkit.fi: the parts of a file manager and a task manager,
// read back pixel by pixel: sizes as text, the centre-line baseline, the thin scroll bar, a heat
// plate, a history curve with its area and grid, a bar.
import fui.navkit
import fui.navnum
import fui.painter
import paint.canvas
import std.rt

fn px(cv: *mut canvas.Canvas, x: u64, y: u64) -> u32 {
    return canvas.canvas_get(cv, x as usize, y as usize)
}

fn is(buf: *mut u8, want: str) -> bool {
    var i: usize = 0
    while i < want.n {
        if *((buf as u64 + i as u64) as *mut u8) != *((want.p as u64 + i as u64) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return *((buf as u64 + want.n as u64) as *mut u8) == 0 as u8
}

fn main() -> i32 {
    // --- A. size_text
    var b: [u8; 32] = [0 as u8; 32]
    let p: *mut u8 = (&b[0]) as *mut u8
    let _a: usize = navnum.size_text(0, p as u64, 32)
    if !is(p, "0 B") { return 1 as i32 }
    let _b: usize = navnum.size_text(354, p as u64, 32)
    if !is(p, "354 B") { return 2 as i32 }
    let _c: usize = navnum.size_text(1024, p as u64, 32)
    if !is(p, "1.0 KB") { return 3 as i32 }
    let _d: usize = navnum.size_text(1536, p as u64, 32)
    if !is(p, "1.5 KB") { return 4 as i32 }
    let _e: usize = navnum.size_text(12 * 1024, p as u64, 32)
    if !is(p, "12 KB") { return 5 as i32 }
    let _f: usize = navnum.size_text(10200, p as u64, 32)       // 9.96 KB rounds up to 10 KB
    if !is(p, "10 KB") { return 6 as i32 }
    let _g: usize = navnum.size_text(3 * 1024 * 1024 + 400 * 1024, p as u64, 32)
    if !is(p, "3.4 MB") { return 7 as i32 }
    let _h: usize = navnum.size_text(5 * 1024 * 1024 * 1024, p as u64, 32)
    if !is(p, "5.0 GB") { return 8 as i32 }
    // a cap too small never writes past it
    var s: [u8; 4] = [0 as u8; 4]
    let n: usize = navnum.size_text(123456, (&s[0]) as u64, 4)
    if n > 3 || s[3 as usize] != 0 as u8 && n != 3 { return 9 as i32 }

    // --- B. mid_base: the same baseline the OS used (h 32, 15 px -> top + 16 + 4.77 -> 21)
    if navnum.mid_base(0, 32, 15) != 21 { return 10 as i32 }
    if navnum.mid_base(10, 28, 15) != 29 { return 11 as i32 }
    if navnum.row_indent(8, 2, 16) != 40 { return 12 as i32 }

    // --- C. thumb geometry
    if navnum.thumb_len(200, 10, 100, 24) != 24 { return 13 as i32 }
    if navnum.thumb_len(200, 50, 100, 24) != 100 { return 14 as i32 }
    if navnum.thumb_len(200, 100, 100, 24) != 200 { return 15 as i32 }
    if navnum.thumb_off(200, 100, 0, 100, 50) != 0 { return 16 as i32 }
    if navnum.thumb_off(200, 100, 50, 100, 50) != 100 { return 17 as i32 }

    // --- D. paint on a canvas
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, 300, 200) { return 20 as i32 }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 300, 200) { return 21 as i32 }
    let black: u32 = 4278190080 as u32
    let red: u32 = 4294901760 as u32
    let blue: u32 = 4278190335 as u32
    let white: u32 = 4294967295 as u32
    canvas.canvas_clear(&cv, black)

    // thin bar: 100 rows, 10 visible, top 0, area x 0..100 y 0..100: thumb at the right edge
    navkit.paint_thumb(&z, 0.0, 0.0, 100.0, 100.0, 100, 10, 0, 1.0, white, false)
    if px(&cv, 100 - 4 - 2 + 2, 5) == black { return 22 as i32 }      // inside the 4 wide thumb
    if px(&cv, 50, 5) != black { return 23 as i32 }                    // no track
    // the thumb is at the top for top 0 and at the bottom for the last page
    canvas.canvas_clear(&cv, black)
    navkit.paint_thumb(&z, 0.0, 0.0, 100.0, 100.0, 100, 10, 90, 1.0, white, false)
    if px(&cv, 95, 97) == black { return 24 as i32 }
    if px(&cv, 95, 5) != black { return 25 as i32 }
    // no thumb when everything fits
    canvas.canvas_clear(&cv, black)
    navkit.paint_thumb(&z, 0.0, 0.0, 100.0, 100.0, 10, 10, 0, 1.0, white, true)
    if px(&cv, 95, 5) != black { return 26 as i32 }

    // heat: alpha grows with the value; 0 paints nothing
    if navnum.heat_alpha(0) != 20 { return 27 as i32 }
    if navnum.heat_alpha(1000) != 110 { return 28 as i32 }
    if navnum.heat_alpha(5000) != 110 { return 29 as i32 }
    canvas.canvas_clear(&cv, black)
    navkit.paint_heat(&z, 10.0, 10.0, 40.0, 20.0, 0, 4.0, red)
    if px(&cv, 30, 20) != black { return 30 as i32 }
    navkit.paint_heat(&z, 10.0, 10.0, 40.0, 20.0, 1000, 4.0, red)
    let hot: u32 = px(&cv, 30, 20)
    navkit.paint_heat(&z, 110.0, 10.0, 40.0, 20.0, 100, 4.0, red)
    let cool: u32 = px(&cv, 130, 20)
    // the red channel (bits 16..23): hotter is redder
    if ((hot >> 16) & 255 as u32) <= ((cool >> 16) & 255 as u32) { return 31 as i32 }
    if ((cool >> 16) & 255 as u32) == 0 as u32 { return 32 as i32 }

    // graph: a rising ramp 0..1000 over 11 samples in a 100 x 100 box at (50, 50)
    var hist: [u64; 11] = [0 as u64; 11]
    var i: u64 = 0
    while i < 11 {
        hist[i as usize] = i * 100
        i = i + 1
    }
    canvas.canvas_clear(&cv, black)
    let fill: u32 = 0x40FF0000 as u32
    navkit.paint_graph(&z, 50, 50, 100, 100, (&hist[0]) as u64, 11, white, fill, blue)
    // the left end is at the bottom, the right end at the top
    if px(&cv, 50, 149) == black { return 33 as i32 }                  // the line at the bottom-left
    if px(&cv, 149, 50) == black { return 34 as i32 }                  // the line at the top-right
    // above the curve at the left: nothing; below the curve at the right: the area
    if px(&cv, 55, 60) != black && px(&cv, 55, 60) != blue { return 35 as i32 }
    let under: u32 = px(&cv, 140, 148)
    if under == black || under == white { return 36 as i32 }
    // the grid: a hairline at a quarter of the height where no curve is (left part, high)
    if px(&cv, 52, 75) != blue { return 37 as i32 }
    // fewer than two samples: the grid only
    canvas.canvas_clear(&cv, black)
    navkit.paint_graph(&z, 50, 50, 100, 100, (&hist[0]) as u64, 1, white, fill, blue)
    if px(&cv, 52, 75) != blue { return 38 as i32 }
    if px(&cv, 148, 148) != black { return 39 as i32 }

    // bar: 500 of 1000 fills half
    canvas.canvas_clear(&cv, black)
    navkit.paint_bar(&z, 10.0, 10.0, 100.0, 10.0, 500, 5.0, blue, red)
    if px(&cv, 30, 15) != red { return 40 as i32 }
    if px(&cv, 90, 15) != blue { return 41 as i32 }
    return 42 as i32
}
