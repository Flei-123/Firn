// expect_exit: 0
// tests/1337_assign_op.fi -- the compound assignment and the step operators
// (round 70, part 5).
//
// `x op= e` is EXACTLY `x = x op e`: the same type rules, the same
// instruction, the same overflow behaviour. What is checked here is that
// each of the ten operators computes what its written out form computes --
// on every integer width, on f64, and on all three kinds of lvalue
// (variable, array element, field, and through a pointer).
//
// `++` and `--` are STATEMENTS. There is no `y = x++`; the negative test
// tests/neg/step_in_expression.fi nails that down.

struct Box {
    a: i32,
    b: i64,
}

fn main() -> i32 {
    // --- the five arithmetic ones on a variable
    var x: i32 = 10
    x += 5
    if x != 15 { return 1 }
    x -= 3
    if x != 12 { return 2 }
    x *= 2
    if x != 24 { return 3 }
    x /= 4
    if x != 6 { return 4 }
    x %= 4
    if x != 2 { return 5 }

    // --- the five bit ones
    var b: u8 = 12 as u8
    b &= 10 as u8
    if b != 8 as u8 { return 6 }
    b |= 1 as u8
    if b != 9 as u8 { return 7 }
    b ^= 8 as u8
    if b != 1 as u8 { return 8 }
    var s: i64 = 1
    s <<= 10
    if s != 1024 { return 9 }
    s >>= 3
    if s != 128 { return 10 }

    // --- the shift amount may have a width of its own, exactly as with `<<`
    var w: u64 = 1
    let amount: u8 = 5 as u8
    w <<= amount as u64
    if w != 32 { return 11 }

    // --- every integer width
    var i8v: i8 = 100 as i8
    i8v -= 50 as i8
    if i8v != 50 as i8 { return 12 }
    var i16v: i16 = 300 as i16
    i16v += 100 as i16
    if i16v != 400 as i16 { return 13 }
    var u16v: u16 = 60000 as u16
    u16v -= 10000 as u16
    if u16v != 50000 as u16 { return 14 }
    var u32v: u32 = 4000000000 as u32
    u32v /= 1000 as u32
    if u32v != 4000000 as u32 { return 15 }
    var u64v: u64 = 18446744073709551615
    u64v /= 3
    if u64v != 6148914691236517205 { return 16 }
    var uz: usize = 7
    uz *= 3
    if uz != 21 { return 17 }

    // --- f64: `+ - * /` are allowed, `%` is not (tests/neg/assign_op_f64.fi)
    var f: f64 = 1.5
    f += 0.5
    if f != 2.0 { return 18 }
    f *= 3.0
    if f != 6.0 { return 19 }
    f -= 1.0
    if f != 5.0 { return 20 }
    f /= 2.0
    if f != 2.5 { return 21 }

    // --- the same, with the second spelling of round 70
    var n: int = 4
    n += 1
    if n != 5 { return 22 }
    var m: long = 1
    m <<= 40
    if m != 1099511627776 { return 23 }

    // --- an ARRAY ELEMENT as target
    var arr: [i32; 4] = [1, 2, 3, 4]
    arr[2] += 10
    if arr[2] != 13 { return 24 }
    arr[0] *= 7
    if arr[0] != 7 { return 25 }
    var idx: usize = 3
    arr[idx] -= 4
    if arr[3] != 0 { return 26 }

    // --- a FIELD as target
    var k: Box = Box { a: 5, b: 100 }
    k.a += 5
    if k.a != 10 { return 27 }
    k.b /= 4
    if k.b != 25 { return 28 }

    // --- THROUGH A POINTER as target
    let p: *mut i32 = &k.a
    *p += 90
    if k.a != 100 { return 29 }

    // --- `++` and `--` on all four kinds of lvalue
    var c: i32 = 0
    c++
    c++
    c++
    if c != 3 { return 30 }
    c--
    if c != 2 { return 31 }
    arr[1]++
    if arr[1] != 3 { return 32 }
    k.a--
    if k.a != 99 { return 33 }
    *p++
    if k.a != 100 { return 34 }

    // --- the step counts in a loop, as one would write it
    var sum: i32 = 0
    var t: i32 = 0
    while t < 10 {
        sum += t
        t++
    }
    if sum != 45 { return 35 }
    if t != 10 { return 36 }

    // --- and the whole thing is the same as written out
    var one: i64 = 7
    var two: i64 = 7
    one += 13
    two = two + 13
    if one != two { return 37 }
    one <<= 3
    two = two << 3
    if one != two { return 38 }
    one %= 7
    two = two % 7
    if one != two { return 39 }
    return 0
}
