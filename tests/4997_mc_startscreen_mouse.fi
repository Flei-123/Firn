// expect_exit: 0
import std.rt
import mc.mc_raster
import mc.mc_launch_cfg
import mc.mc_serverlist
import mc.mc_startscreen

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn eq(f: *mut mc_startscreen.StartForm, k: i32, t: str) -> bool {
    if mc_startscreen.form_text_len(f, k) != t.n { return false }
    var i: usize = 0
    while i < t.n {
        if rt.ld8(mc_startscreen.form_text_ptr(f, k), i) != t.chars(i) { return false }
        i = i + 1
    }
    return true
}

fn click_box(f: *mut mc_startscreen.StartForm, b: mc_startscreen.Box, ms: u64) {
    mc_startscreen.form_pointer(f, 640, 480, 2, b.x + b.w / 2, b.y + b.h / 2, true, ms)
}

fn click_field(f: *mut mc_startscreen.StartForm, k: i32) {
    click_box(f, mc_startscreen.field_box(640, 480, 2, k), 1 as u64)
}

fn click_button(f: *mut mc_startscreen.StartForm, b: i32, ms: u64) {
    click_box(f, mc_startscreen.button_box(640, 480, 2, b), ms)
}

fn click_row(f: *mut mc_startscreen.StartForm, i: i32, ms: u64) {
    click_box(f, mc_startscreen.row_box(640, 480, 2, i), ms)
}

fn type_text(f: *mut mc_startscreen.StartForm, t: str) {
    var i: usize = 0
    while i < t.n {
        mc_startscreen.form_char(f, t.chars(i) as u32)
        i = i + 1
    }
}

fn main() -> i32 {
    var f: mc_startscreen.StartForm = mc_startscreen.form_new()
    check(f.active == mc_startscreen.FIELD_HOST, 1)
    click_field(&f, mc_startscreen.FIELD_NAME)
    check(f.active == mc_startscreen.FIELD_NAME, 2)
    click_field(&f, mc_startscreen.FIELD_PORT)
    check(f.active == mc_startscreen.FIELD_PORT, 3)
    mc_startscreen.form_pointer(&f, 640, 480, 2, 1, 1, true, 1 as u64)
    check(f.active == mc_startscreen.FIELD_PORT, 4)

    click_field(&f, mc_startscreen.FIELD_HOST)
    type_text(&f, "10.0.0.7")
    click_button(&f, mc_startscreen.BTN_SAVE, 2 as u64)
    check(mc_serverlist.sl_count(&f.servers) == 1 && f.problem == mc_startscreen.ERR_NONE, 5)
    click_button(&f, mc_startscreen.BTN_SAVE, 3 as u64)
    check(mc_serverlist.sl_count(&f.servers) == 1, 6)

    click_button(&f, mc_startscreen.BTN_JOIN, 4 as u64)
    check(!f.submitted && f.problem == mc_startscreen.ERR_NAME && f.active == mc_startscreen.FIELD_NAME, 7)

    click_field(&f, mc_startscreen.FIELD_HOST)
    mc_startscreen.form_set(&f, mc_startscreen.FIELD_HOST, "".p as u64, 0)
    type_text(&f, "192.168.1.20")
    mc_startscreen.form_set(&f, mc_startscreen.FIELD_PORT, "25599".p as u64, 5)
    click_button(&f, mc_startscreen.BTN_SAVE, 5 as u64)
    check(mc_serverlist.sl_count(&f.servers) == 2, 8)

    click_row(&f, 1, 1000 as u64)
    check(eq(&f, mc_startscreen.FIELD_HOST, "10.0.0.7") && eq(&f, mc_startscreen.FIELD_PORT, "25565"), 9)
    check(f.active == mc_startscreen.FIELD_NAME && !f.submitted, 10)
    click_row(&f, 0, 1100 as u64)
    check(eq(&f, mc_startscreen.FIELD_HOST, "192.168.1.20") && eq(&f, mc_startscreen.FIELD_PORT, "25599"), 11)

    click_row(&f, 5, 1200 as u64)
    check(eq(&f, mc_startscreen.FIELD_HOST, "192.168.1.20"), 12)

    click_button(&f, mc_startscreen.BTN_REMOVE, 1300 as u64)
    check(mc_serverlist.sl_count(&f.servers) == 1, 13)
    click_button(&f, mc_startscreen.BTN_REMOVE, 1301 as u64)
    check(mc_serverlist.sl_count(&f.servers) == 1, 14)

    click_row(&f, 0, 5000 as u64)
    check(eq(&f, mc_startscreen.FIELD_HOST, "10.0.0.7"), 15)
    type_text(&f, "Steve")
    click_row(&f, 0, 5200 as u64)
    check(f.submitted, 16)

    var g: mc_startscreen.StartForm = mc_startscreen.form_new()
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_HOST, "1.2.3.4".p as u64, 7)
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_NAME, "Alex".p as u64, 4)
    click_button(&g, mc_startscreen.BTN_JOIN, 10 as u64)
    check(g.submitted && mc_serverlist.sl_count(&g.servers) == 1, 17)
    var cfg: mc_launch_cfg.LaunchCfg = mc_launch_cfg.cfg_new()
    mc_startscreen.form_to_cfg(&g, &cfg)
    check(mc_serverlist.sl_count(&cfg.servers) == 1 && cfg.port == 25565, 18)
    var h: mc_startscreen.StartForm = mc_startscreen.form_new()
    mc_startscreen.form_from_cfg(&h, &cfg)
    check(mc_serverlist.sl_count(&h.servers) == 1, 19)

    var q: mc_startscreen.StartForm = mc_startscreen.form_new()
    click_button(&q, mc_startscreen.BTN_QUIT, 10 as u64)
    check(q.cancelled && !q.submitted, 20)

    var r: mc_raster.Raster = mc_raster.raster_new(640, 480)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_startscreen.form_pointer(&h, 640, 480, 2, 0 - 5, 0 - 5, false, 0 as u64)
    mc_startscreen.form_draw(&h, &r, 2, 0 as u64)
    let rb: mc_startscreen.Box = mc_startscreen.row_box(640, 480, 2, 0)
    check(mc_raster.raster_pixel(&r, 3, 3) == mc_startscreen.BG_COLOR, 21)
    check(mc_raster.raster_pixel(&r, rb.x + rb.w - 3, rb.y + rb.h - 3) != mc_startscreen.BG_COLOR, 22)
    return 0
}
