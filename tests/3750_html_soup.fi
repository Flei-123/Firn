// expect_exit: 0
// html.soup: parse, select, text, attr, walking, broken markup, invalid selectors, re-parse.
import std.rt
import std.str
import html.soup

fn page() -> str {
    return "<!DOCTYPE html><html><head><title>Shop &amp; Co</title></head><body>\n<div id=nav><a href=\"/home\">Home</a></div>\n<ul class=list><li class=item><a href=/p/1>Red &amp; Blue</a></li><li class=\"item sale\"><a href=/p/2>Desk <b>Fan</b></a></li><li class=item><a>No link</a></li></ul>\n<p>one<p>two<span></span><em> </em><i></i></body></html>"
}

fn main() -> i32 {
    var d: soup.Doc = soup.doc_new()
    defer soup.doc_free(&d)
    // selecting before parsing is an empty answer, not a crash
    if soup.count(soup.select(&d, "a")) != 0 { return 1 }
    if !soup.parse(&d, page()) { return 2 }
    let t: soup.El = soup.select_one(&d, "title")
    if !soup.text(&d, t).equal("Shop & Co") { return 3 }
    let links: soup.Hits = soup.select(&d, "li.item > a[href]")
    if soup.count(links) != 2 { return 4 }
    if !soup.attr(&d, soup.at(links, 0), "href").equal("/p/1") { return 5 }
    if !soup.text(&d, soup.at(links, 1)).equal("Desk Fan") { return 6 }
    if !soup.text_trim(&d, soup.at(links, 0)).equal("Red & Blue") { return 7 }
    if !soup.name(&d, soup.at(links, 0)).equal("a") { return 8 }
    // absent attribute / out of range
    if !soup.attr(&d, soup.at(soup.select(&d, "a"), 3), "href").equal("") { return 9 }
    if soup.has_attr(&d, soup.at(soup.select(&d, "a"), 3), "href") { return 10 }
    if !soup.is_none(soup.at(links, 5)) { return 11 }
    if !soup.is_none(soup.select_one(&d, "table")) { return 12 }
    // attribute names are case-insensitive in HTML
    if !soup.attr(&d, soup.at(links, 0), "HREF").equal("/p/1") { return 13 }
    // scoped select and walking
    let ul: soup.El = soup.select_one(&d, "ul.list")
    if soup.count(soup.select_in(&d, ul, "a")) != 3 { return 14 }
    if soup.count(soup.select_in(&d, ul, "div a")) != 0 { return 15 }
    if soup.count(soup.children(&d, ul)) != 3 { return 16 }
    let p1: soup.El = soup.parent(soup.at(links, 0))
    if !soup.name(&d, p1).equal("li") { return 17 }
    if !soup.is_none(soup.parent(soup.select_one(&d, "html"))) { return 18 }
    // the HTML5 tree builder: <p>one<p>two is two paragraphs
    if soup.count(soup.select(&d, "p")) != 2 { return 19 }
    if !soup.text(&d, soup.at(soup.select(&d, "p"), 0)).equal("one") { return 20 }
    // markup out
    if !soup.inner_html(&d, soup.at(soup.select(&d, "li.sale"), 0)).equal("<a href=\"/p/2\">Desk <b>Fan</b></a>") { return 21 }
    if !soup.outer_html(&d, soup.select_one(&d, "title")).equal("<title>Shop &amp; Co</title>") { return 22 }
    // :empty (text of length 0 only), of-type
    if soup.count(soup.select(&d, "span:empty")) != 1 { return 23 }
    if soup.count(soup.select(&d, "em:empty")) != 0 { return 24 }
    if soup.count(soup.select(&d, "li:first-of-type")) != 1 { return 25 }
    if soup.count(soup.select(&d, "li:last-of-type")) != 1 { return 26 }
    if soup.count(soup.select(&d, "li:nth-of-type(2)")) != 1 { return 27 }
    if !soup.text_trim(&d, soup.select_one(&d, "li:nth-of-type(2n+1)")).equal("Red & Blue") { return 28 }
    if soup.count(soup.select(&d, "li:nth-last-of-type(1)")) != 1 { return 29 }
    if soup.count(soup.select(&d, "title:only-of-type")) != 1 { return 30 }
    if soup.count(soup.select(&d, "a:not([href])")) != 1 { return 31 }
    // invalid selectors: empty answer + selector_ok false; the next good one resets it
    if soup.count(soup.select(&d, "a[")) != 0 || soup.selector_ok(&d) { return 32 }
    if soup.count(soup.select(&d, "")) != 0 || soup.selector_ok(&d) { return 33 }
    if soup.count(soup.select(&d, "li")) != 3 || !soup.selector_ok(&d) { return 34 }
    // many strings stay valid (arena): 2000 reads, all still intact at the end
    var keep: [str; 8] = ["", "", "", "", "", "", "", ""]
    var i: usize = 0
    while i < 2000 {
        keep[i % 8] = soup.text(&d, soup.at(links, i % 2))
        i = i + 1
    }
    if !keep[0].equal("Red & Blue") || !keep[1].equal("Desk Fan") { return 35 }
    // a big text (> arena chunk) and broken markup
    var big: rt.Buf = rt.buf_new()
    defer rt.buf_free(&big)
    i = 0
    while i < 40000 {
        rt.buf_push(&big, 120 as u8)
        i = i + 1
    }
    var html: rt.Buf = rt.buf_new()
    defer rt.buf_free(&html)
    rt.buf_push_bytes(&html, "<div><b>".p as u64, 8)
    rt.buf_push_bytes(&html, rt.buf_ptr(&big), rt.buf_len(&big))
    rt.buf_push_bytes(&html, "</i><td>&#xD800;&bogus;<!--".p as u64, 27)
    if !soup.parse(&d, str { p: rt.buf_data(&html), n: rt.buf_len(&html) }) { return 36 }
    let bt: str = soup.text(&d, soup.select_one(&d, "div"))
    if bt.n < 40000 { return 37 }
    // the old page is gone after a re-parse
    if soup.count(soup.select(&d, "li")) != 0 { return 38 }
    return 0
}
