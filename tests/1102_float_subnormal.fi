// expect_exit: 0
// Floating point literals below 2^-1022: the subnormal range.
//
// Below the smallest normal number a double loses bits, one by one, down to
// 2^-1074. Exactly there sits the nastiest tie of the whole format: half of
// the smallest double is 2^-1075, and rounding to even has to make that a
// ZERO -- while one step above it becomes the smallest double.
//
// The check runs over the BIT PATTERN, not over the printed value: two
// doubles that are one ULP apart print the same in almost every format --
// which is why the divergence of round 63 stayed unnoticed for so long.
// The detour through the address is the one from `lib/firnc1/lexer.fi`:
// a direct cast of `&t` to `*mut u64` is read by stage 0 as a value
// conversion, through the address it is a true reinterpretation.

fn bits_of(x: f64) -> u64 {
    var t: f64 = 0.0
    let p: u64 = (&t) as u64
    *(p as *mut f64) = x
    return *(p as *mut u64)
}

fn main() -> i32 {
    // the smallest positive double, 2^-1074
    if bits_of(5e-324) != 1 {
        return 1
    }
    // 2^-1075 is exactly half of it -> ties to even -> zero
    if bits_of(-1075) != 0 {
        return 2
    }
    // one step above that -> the smallest double
    if bits_of(-1075) != 1 {
        return 3
    }
    // just below half -> zero
    if bits_of(2.4703282292062327e-324) != 0 {
        return 4
    }
    // just above half -> the smallest double
    if bits_of(2.4703282292062328e-324) != 1 {
        return 5
    }
    if bits_of(1e-320) != 2024 {
        return 6
    }
    if bits_of(1e-323) != 2 {
        return 7
    }
    if bits_of(1.5e-323) != 3 {
        return 8
    }
    // the smallest NORMAL double
    if bits_of(2.2250738585072014e-308) != 4503599627370496 {
        return 9
    }
    // and the largest subnormal below it
    if bits_of(2.2250738585072009e-308) != 4503599627370495 {
        return 10
    }
    if bits_of(4.9406564584124654e-324) != 1 {
        return 11
    }
    // the smallest double written out in full
    if bits_of(0.) != 1 {
        return 12
    }
    // far below everything -> zero
    if bits_of(1e-400) != 0 {
        return 13
    }
    return 0
}
