// expect_exit: 0
import media.video.vp9.vp9mem
import media.video.av1.av1mem
import media.video.av1.av1sym
import media.video.av1.av1seq
import media.video.av1.av1fhdr
import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1cdfctx
import media.video.av1.av1coef
import media.video.av1.av1coefctx

static TXW: [u8; 19] = [4, 8, 16, 32, 64, 4, 8, 8, 16, 16, 32, 32, 64, 4, 16, 8, 32, 16, 64]
static TXH: [u8; 19] = [4, 8, 16, 32, 64, 8, 4, 16, 8, 32, 16, 64, 32, 16, 4, 32, 8, 64, 16]

fn fill(p: u64, n: usize, seed: i64) {
    var s: i64 = seed
    var i: usize = 0
    while i < n {
        s = (s * 1103515245 + 12345) & 2147483647
        vp9mem.st8(p, i, (s >> 8) & 255)
        i = i + 1
    }
}

fn check_block(td: *mut av1blkst.TileDec, plane: i64, tx: i64, eob: i64) -> i32 {
    let w: i64 = TXW[tx as usize] as i64
    let h: i64 = TXH[tx as usize] as i64
    var aw: i64 = w
    var ah: i64 = h
    if aw > 32 {
        aw = 32
    }
    if ah > 32 {
        ah = 32
    }
    if eob < 0 || eob > aw * ah {
        return 1
    }
    var nz: i64 = 0
    var r: i64 = 0
    while r < h {
        var c: i64 = 0
        while c < w {
            let v: i64 = av1coefctx.lv((*td).dequant, r * w + c)
            if v != 0 {
                nz = nz + 1
                if r >= ah || c >= aw {
                    return 2
                }
                if v > 32767 || v < 0 - 32768 {
                    return 3
                }
            }
            c = c + 1
        }
        r = r + 1
    }
    if nz > eob {
        return 4
    }
    let p: usize = plane as usize
    if av1blkst.ld((*td).above_level[p], 0) != av1blkst.ld((*td).left_level[p], 0) {
        return 5
    }
    if av1blkst.ld((*td).above_level[p], 0) > 63 {
        return 6
    }
    return 0
}

fn main() -> i32 {
    let seq: *mut av1seq.SeqHdr = av1seq.seq_new()
    (*seq).subsampling_x = 1
    (*seq).subsampling_y = 1
    (*seq).num_planes = 3
    (*seq).bit_depth = 8
    (*seq).use_128x128_superblock = 0
    let fh: *mut av1fhdr.FrameHdr = av1mem.av1_zalloc[av1fhdr.FrameHdr]()
    (*fh).mi_rows = 64
    (*fh).mi_cols = 64
    (*fh).frame_height = 256
    (*fh).upscaled_width = 256
    (*fh).base_q_idx = 90
    let td: *mut av1blkst.TileDec = av1blkst.td_new()
    av1blkst.td_setup_frame(td, seq, fh)
    let cdf: u64 = av1cdfctx.cdf_alloc()
    av1cdfctx.cdf_init_default(cdf)
    av1cdfctx.cdf_init_coef(cdf, 90)
    (*td).cdf = cdf
    let n: usize = 65536
    let data: u64 = vp9mem.alloc(n)
    var bad: i32 = 0
    var total_eob: i64 = 0
    var round: i64 = 0
    while round < 12 {
        fill(data, n, 77 + round * 13)
        av1sym.sym_init(&(*td).sym, data, n, true)
        (*td).mi_size = av1blkdat.BLOCK_64X64
        (*td).y_mode = round % 13
        (*td).uv_mode = (round * 5) % 14
        (*td).segment_id = 0
        var tx: i64 = 0
        while tx < 19 {
            var plane: i64 = 0
            while plane < 2 {
                let w: i64 = TXW[tx as usize] as i64
                let h: i64 = TXH[tx as usize] as i64
                if plane == 0 || (w <= 32 && h <= 32) {
                    let eob: i64 = av1coef.coef_read(td as u64, plane, 0, 0, tx)
                    let rc: i32 = check_block(td, plane, tx, eob)
                    if rc != 0 {
                        bad = bad + 1
                    }
                    if eob > 0 {
                        total_eob = total_eob + eob
                    }
                }
                plane = plane + 1
            }
            tx = tx + 1
        }
        round = round + 1
    }
    if total_eob == 0 {
        bad = bad + 100
    }
    av1blkst.td_free(td)
    return bad
}
