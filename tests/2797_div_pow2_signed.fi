// expect_exit: 0
// Signed division / remainder by a constant power of two (shift + sign correction, no idiv).
// Checked by the defining identity q * k + r == x, |r| < k, r has the sign of x (round towards zero).

fn chk64(x: i64, q: i64, r: i64, k: i64) -> i32 {
    if q * k + r != x { return 1 }
    if r >= k || r <= (0 as i64) - k { return 1 }
    if x >= 0 as i64 && r < 0 as i64 { return 1 }
    if x < 0 as i64 && r > 0 as i64 { return 1 }
    return 0
}

fn chk32(x: i32, q: i32, r: i32, k: i32) -> i32 {
    return chk64(x as i64, q as i64, r as i64, k as i64)
}

fn main() -> i32 {
    var bad: i32 = 0
    var s: u64 = 88172645463325252 as u64
    var i: i32 = 0
    while i < 20000 {
        s = s ^ (s << 13 as u64)
        s = s ^ (s >> 7 as u64)
        s = s ^ (s << 17 as u64)
        var x: i64 = s as i64
        let sel: i32 = i % 8
        if sel == 1 { x = x >> 20 as i64 }
        if sel == 2 { x = x >> 50 as i64 }
        if sel == 3 { x = ((i as i64) % 1000) - 500 }
        if sel == 4 { x = 0 as i64 - (i as i64) }
        var y: i32 = 0
        if x >= (0 as i64) - 2147483647 as i64 && x <= 2147483647 as i64 { y = x as i32 } else { y = (x >> 32 as i64) as i32 }
        bad = bad + chk64(x, x / 2 as i64, x % 2 as i64, 2)
        bad = bad + chk64(x, x / 4 as i64, x % 4 as i64, 4)
        bad = bad + chk64(x, x / 256 as i64, x % 256 as i64, 256)
        bad = bad + chk64(x, x / 65536 as i64, x % 65536 as i64, 65536)
        bad = bad + chk64(x, x / 1073741824 as i64, x % 1073741824 as i64, 1073741824)
        bad = bad + chk32(y, y / 2, y % 2, 2)
        bad = bad + chk32(y, y / 16, y % 16, 16)
        bad = bad + chk32(y, y / 256, y % 256, 256)
        bad = bad + chk32(y, y / 1073741824, y % 1073741824, 1073741824)
        i = i + 1
    }
    // fixed values
    let a: i64 = 0 as i64 - 1
    if a / 256 as i64 != 0 as i64 { bad = bad + 1 }
    if a % 256 as i64 != a { bad = bad + 1 }
    let b: i64 = 0 as i64 - 255
    if b / 256 as i64 != 0 as i64 { bad = bad + 1 }
    let c: i64 = 0 as i64 - 256
    if c / 256 as i64 != 0 as i64 - 1 as i64 { bad = bad + 1 }
    if c % 256 as i64 != 0 as i64 { bad = bad + 1 }
    let d: i64 = 0 as i64 - 257
    if d / 256 as i64 != 0 as i64 - 1 as i64 { bad = bad + 1 }
    if d % 256 as i64 != 0 as i64 - 1 as i64 { bad = bad + 1 }
    let m: i32 = -2147483647 - 1
    if m / 256 != -8388608 { bad = bad + 1 }
    if m % 256 != 0 { bad = bad + 1 }
    if m / 1073741824 != -2 { bad = bad + 1 }
    let e: i32 = 7
    if e / 2 != 3 { bad = bad + 1 }
    if (0 - e) / 2 != -3 { bad = bad + 1 }
    if (0 - e) % 2 != -1 { bad = bad + 1 }
    return bad
}
