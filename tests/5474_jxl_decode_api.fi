import jxl.jxl
import std.fs
import std.rt

static mut failures: i32 = 0

fn decode_file(path: str, pic: *mut jxl.JxlPicture) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    let ok: bool = jxl.jxl_decode(rt.buf_ptr(&data), n, pic) catch false
    rt.buf_free(&data)
    return ok
}

fn check_dims(path: str, w: u32, h: u32, ch: u32) {
    var pic: jxl.JxlPicture = jxl.JxlPicture { width: 0, height: 0, channels: 0, bytes_per_sample: 0, bits: 0, data: 0, size: 0 }
    if !decode_file(path, &pic) || pic.width != w || pic.height != h || pic.channels != ch || pic.size != (w * h * ch) as usize {
        failures = failures + 1
    }
    jxl.jxl_picture_free(&pic)
}

fn fuzz_file(path: str, seed: u32) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    var s: u32 = seed
    var round: u32 = 0
    while round < 60 {
        let copy: u64 = rt.heap_alloc(n)
        rt.mem_copy(copy, rt.buf_ptr(&data), n)
        s = s *% 1103515245 +% 12345
        let at: usize = ((s >> 4) as usize) % n
        s = s *% 1103515245 +% 12345
        let flip: u32 = (s >> 8) & 255
        let cell: *mut u8 = (copy +% at as u64) as *mut u8
        let old: u32 = (*cell) as u32
        *cell = (old ^ (flip | 1)) as u8
        var cut: usize = n
        if round % 3 == 0 {
            s = s *% 1103515245 +% 12345
            cut = ((s >> 4) as usize) % n
        }
        var pic: jxl.JxlPicture = jxl.JxlPicture { width: 0, height: 0, channels: 0, bytes_per_sample: 0, bits: 0, data: 0, size: 0 }
        let ok: bool = jxl.jxl_decode(copy, cut, &pic) catch false
        jxl.jxl_picture_free(&pic)
        rt.heap_free(copy, n)
        round = round + 1
    }
    rt.buf_free(&data)
}

fn main() -> i32 {
    check_dims("tests/data/jxl/mg/mg_rgb300x260_g0.jxl", 300, 260, 3)
    check_dims("tests/data/jxl/mg/mg_rgba300x200_g0.jxl", 300, 200, 4)
    check_dims("tests/data/jxl/mg/sq_grey129x65.jxl", 129, 65, 1)
    check_dims("tests/data/jxl/mg/sq_rgba150x130_g0.jxl", 150, 130, 4)
    fuzz_file("tests/data/jxl/mg/sq_rgb37x23.jxl", 1)
    fuzz_file("tests/data/jxl/mg/sq_rgb100x90.jxl", 2)
    fuzz_file("tests/data/jxl/rgb16x16.jxl", 3)
    fuzz_file("tests/data/jxl/mg/sq_grey129x65.jxl", 4)
    return failures
}
