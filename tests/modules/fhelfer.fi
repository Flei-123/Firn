// Modul 'fhelfer' — die Interpolation innerhalb eines IMPORTIERTEN Moduls
// (Runde 39): das Modul bindet `std.io` selbst ein, die Aufloesung von
// `io.fmt_*` und das Heben der Textsegmente laufen im Modulkontext.
import std.io

export { meldung }

fn meldung(n: i32) -> io.Fmt {
    return f"helfer sagt {n}"
}
