// tests/modules/tuple_geo.fi -- tuples with the structs of a module in them
// (tests 2414, tools/tuples/run.sh). `Dot` becomes `tuple_geo__Dot` when the
// files are merged, and the tuple `(Dot, Dot)` has to follow: a tuple type is
// named from the final names of its elements.
export { Dot, Rect, Corners, corners, middle, area_and_edge }

struct Dot { x: i32, y: i32 }

struct Rect { lo: Dot, hi: Dot }

type Corners = (Dot, Dot)

fn corners(r: Rect) -> Corners {
    return (r.lo, r.hi)
}

fn middle(r: Rect) -> (Dot, i32) {
    return (Dot { x: (r.lo.x + r.hi.x) / 2, y: (r.lo.y + r.hi.y) / 2 }, 1)
}

fn area_and_edge(r: Rect) -> (i32, (i32, i32)) {
    let w = r.hi.x - r.lo.x
    let h = r.hi.y - r.lo.y
    return (w * h, (w, h))
}
