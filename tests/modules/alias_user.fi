// tests/modules/alias_user.fi -- a module that builds on the aliases of another
// one: an alias for an alias of the other module, and a struct literal
// through a foreign alias.
import alias_base
export { Score, Cell, bump, cell }

type Score = alias_base.Count
type Cell = alias_base.Pair

fn bump(s: Score) -> Score {
    return s + 1
}

fn cell(a: i32) -> Cell {
    return alias_base.Pair { a: a, b: a * 2 }
}
