// Round GAPS: named opcodes for tests/1650_match_const_module.fi.
export { OP_HALT, OP_LOAD, OP_ADD, OP_SUB, OP_MUL, OP_JMP, OP_JF, OP_CALL, OP_RET, OP_NOP, classify }

const OP_HALT: u32 = 0
const OP_LOAD: u32 = 1
const OP_ADD: u32 = 2
const OP_SUB: u32 = 3
const OP_MUL: u32 = 4
const OP_JMP: u32 = 5
const OP_JF: u32 = 6
const OP_CALL: u32 = 7
const OP_RET: u32 = 8
const OP_NOP: u32 = 9

// A bare constant of the SAME module in a pattern (modules.rs rewrites it
// to the qualified name), and a binding that is no constant.
fn classify(op: u32) -> u32 {
    var r: u32 = 0
    match op {
        OP_ADD => { r = 1 }
        OP_SUB => { r = 1 }
        OP_JMP => { r = 2 }
        other => { r = other + 100 }
    }
    return r
}
