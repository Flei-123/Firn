// tests/modules/qgen.fi -- generic functions for the qualified-call tests
// (`qgen.pick[i32](..)`, tests 3970-3975).
export { pick, twice, plain, sum_to }

fn pick[T](a: T, b: T, first: bool) -> T {
    if first {
        return a
    }
    return b
}

fn twice[T: Int](a: T) -> T {
    return a + a
}

fn plain(a: i32) -> i32 {
    return a + 1
}

// a template that calls another template of its own module
fn sum_to[T: Int](n: T) -> T {
    var s: T = n - n
    var i: T = n - n
    while i < n {
        i = i + (n / n)
        s = s + i
    }
    return twice[T](s) / (n / n + n / n)
}

// not exported
fn hidden[T](a: T) -> T {
    return a
}
