// Module 'nogc_hot' -- imported by tests/542_no_gc_module.fi.
// All functions visible from outside carry #[no_gc] (SPEC 3.5.4): the
// promise holds across the module boundary, because the module system
// rewrites the names to 'nogc_hot__name' before the check and the checker
// sees the whole, flat call tree.
export { mix, round }

#[no_gc]
fn round(x: i32) -> i32 {
    return (x * 31 as i32) + 7 as i32
}

#[no_gc]
fn mix(a: i32, b: i32) -> i32 {
    return round(a) + round(b)
}
