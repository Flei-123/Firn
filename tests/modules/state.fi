// Module 'state' -- enumeration + 'match' IN A MODULE (not in the
// root file). Proof for modules.rs: the bodies of the cases lie in
// the registry of sema_match and have to be rewritten by the module system
// just like the rest of the AST.
export { Light, step, duration }

enum Light { Red, RedYellow, Green, Yellow }

// Module-internal helper function: it is called ONLY from a match body.
fn plus(a: i32, b: i32) -> i32 {
    return a + b
}

const BASE_TIME: i32 = 10

fn duration(a: Light) -> i32 {
    var d: i32 = 0
    match a {
        Light::Red => { d = plus(BASE_TIME, 20 as i32) }
        Light::RedYellow => { d = plus(BASE_TIME, 0 as i32) }
        Light::Green => { d = plus(BASE_TIME, 15 as i32) }
        Light::Yellow => { d = plus(BASE_TIME, 5 as i32) }
    }
    return d
}

fn step(a: Light) -> Light {
    var n: Light = Light::Red
    match a {
        Light::Red => { n = Light::RedYellow }
        Light::RedYellow => { n = Light::Green }
        Light::Green => { n = Light::Yellow }
        Light::Yellow => { n = Light::Red }
    }
    return n
}
