// tests/modules/draw.fi -- an interface IN A MODULE (round 46).
//
// The point of this module is the renaming. `Circle` becomes
// `draw__Circle` when merging, the method `size` becomes the function
// `draw__Circle__size`, and the method table has to point at EXACTLY that
// name. The name of the interface, in contrast, is NOT renamed:
// `interface` holds program-wide, like `enum` and `gc class`
// (SPEC 14.1 T6, docs/ROUND46.md 9).
//
// `firnc0` renames after parsing (modules.rs), `firnc1` during
// parsing (parser.fi). If they drift apart here, the table points into
// nothing -- and the comparison in tools/self_compare.sh notices it.
export { Circle, Square, new_circle, new_square, size }

interface Size {
    fn size(*self) -> i64
    fn grow(*mut self, k: i64)
}

struct Circle { r: i64 }

struct Square { page: i64 }

fn new_circle(r: i64) -> Circle {
    return Circle { r: r }
}

fn new_square(s: i64) -> Square {
    return Square { page: s }
}

// A free function with the same name as the method: nothing is hidden.
fn size(a: i64) -> i64 {
    return a
}

impl Size for Circle {
    fn size(*self) -> i64 { return 3 * (*self).r * (*self).r }
    fn grow(*mut self, k: i64) { (*self).r = (*self).r + k }
}

impl Size for Square {
    fn size(*self) -> i64 { return (*self).page * (*self).page }
    fn grow(*mut self, k: i64) { (*self).page = (*self).page + k }
}
