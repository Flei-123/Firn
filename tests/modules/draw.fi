// tests/modules/draw.fi — eine Schnittstelle IN EINEM MODUL (Runde 46).
//
// Der Punkt dieses Moduls ist die Umbenennung. Aus `Kreis` wird beim
// Zusammenfuehren `zeichnen__Kreis`, aus der Methode `flaeche` die Funktion
// `zeichnen__Kreis__flaeche`, und die Methodentafel muss auf GENAU diesen
// Namen zeigen. Der Name der Schnittstelle wird dagegen NICHT umbenannt:
// `interface` gilt programmweit, wie `enum` und `gc class`
// (SPEC §14.1 T6, docs/RUNDE46.md §9).
//
// `firnc0` benennt nach dem Parsen um (modules.rs), `firnc1` waehrend des
// Parsens (parser.fi). Laufen sie hier auseinander, zeigt die Tafel ins
// Leere — und der Vergleich in tools/self_compare.sh merkt es.
export { Circle, Square, new_circle, new_square, size }

interface Size {
    fn size(*self) -> i64
    fn grow(*mut self, k: i64)
}

struct Circle { r: i64 }

struct Square { page: i64 }

fn new_circle(r: i64) -> Circle {
    return Circle{ r: r }
}

fn new_square(s: i64) -> Square {
    return Square{ page: s }
}

// Eine freie Funktion, die wie die Methode heisst: verdeckt wird nichts.
fn size(a: i64) -> i64 {
    return a
}

impl Size for Circle {
    fn size(*self) -> i64 { return 3 * (*self).r * (*self).r }
    fn grow(*mut self, k: i64) { (*self).r = (*self).r + k }
}

impl Size for Square {
    fn size(*self) -> i64 { return (*self).page * (*self).page }
    fn grow(*mut self, k: i64) { (*self).page = (*self).page + k }
}
