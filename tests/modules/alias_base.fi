// tests/modules/alias_base.fi -- type aliases of a module (tests 2401, 2402).
//
// `Handle` and `Pair` mention a struct of THIS module; a user in another
// module has to get `alias_base__Item`, not an `Item` of its own.
export { Item, Handle, Count, Pair, Total, make, sum, Hidden }

struct Item { a: i32, b: i32 }
struct Other { z: i32 }

type Count = u64
type Handle = *mut Item
type Pair = Item
type Total = Count
type Hidden = Other

fn make(a: i32, b: i32) -> Pair {
    return Pair { a: a, b: b }
}

fn sum(h: Handle) -> Total {
    return ((*h).a + (*h).b) as Total
}
