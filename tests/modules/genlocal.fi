// Module for tests/1707_module_generic_local.fi: a `Vec` of a struct of
// the module's own, used only through the module's functions.
import std.vec
export { P, Bag, bag_new, bag_add, bag_sum, bag_free }
struct P { x: u32, tag: str }
struct Bag { items: Vec[P] }
fn bag_new() -> Bag { return Bag { items: vec_new[P]() } }
fn bag_add(b: *mut Bag, x: u32) {
    vec_push[P](&(*b).items, P { x: x, tag: "m" })
}
fn bag_sum(b: *mut Bag) -> u32 {
    var s: u32 = 0
    var i: usize = 0
    while i < vec_len[P](&(*b).items) {
        s = s + (*vec_elem_ptr[P](&(*b).items, i)).x
        i = i + 1
    }
    return s
}
fn bag_free(b: *mut Bag) { vec_free[P](&(*b).items) }
