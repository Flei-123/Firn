// Modul 'zustand' — Aufzaehlung + 'match' IN EINEM MODUL (nicht in der
// Wurzeldatei). Nachweis zu modules.rs: die Rumpfbloecke der Faelle liegen in
// der Registrierung von sema_match und muessen vom Modulsystem genauso
// umgeschrieben werden wie der uebrige AST.
export { Ampel, schritt, dauer }

enum Ampel { Rot, RotGelb, Gruen, Gelb }

// Modulinterne Hilfsfunktion: wird NUR aus einem match-Rumpf gerufen.
fn plus(a: i32, b: i32) -> i32 {
    return a + b
}

const GRUNDZEIT: i32 = 10

fn dauer(a: Ampel) -> i32 {
    var d: i32 = 0
    match a {
        Ampel::Rot => { d = plus(GRUNDZEIT, 20 as i32) }
        Ampel::RotGelb => { d = plus(GRUNDZEIT, 0 as i32) }
        Ampel::Gruen => { d = plus(GRUNDZEIT, 15 as i32) }
        Ampel::Gelb => { d = plus(GRUNDZEIT, 5 as i32) }
    }
    return d
}

fn schritt(a: Ampel) -> Ampel {
    var n: Ampel = Ampel::Rot
    match a {
        Ampel::Rot => { n = Ampel::RotGelb }
        Ampel::RotGelb => { n = Ampel::Gruen }
        Ampel::Gruen => { n = Ampel::Gelb }
        Ampel::Gelb => { n = Ampel::Rot }
    }
    return n
}
