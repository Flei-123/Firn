struct Cell { v: i32 }

struct Holder[T] { item: T, hits: i32 }

impl Holder[T] {
    fn peek(*self) -> T { return (*self).item }
    fn put(*mut self, v: T) {
        (*self).item = v
        (*self).hits = (*self).hits + bump()
    }
    fn hit_count(*self) -> i32 { return (*self).hits }
}

fn bump() -> i32 { return 1 }

fn make(v: i32) -> Holder[Cell] {
    return Holder[Cell] { item: Cell { v: v }, hits: 0 }
}

export { Cell, Holder, make }
