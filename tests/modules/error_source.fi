// Modul fuer tests/414_module_error.fi — Fehlermenge und Fehlerunion ueber
// die Modulgrenze (Fehlermengennamen sind programmweit, SPEC §14.1).
export { read }

error ReadError { End, Broken }

fn read(n: i32) -> ReadError!i32 {
    if n == 0 {
        return ReadError::End
    }
    if n < 0 {
        return ReadError::Broken
    }
    return n * 3
}
