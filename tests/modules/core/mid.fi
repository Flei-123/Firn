// Mittlere Ebene: bindet die untere ein und hat DENSELBEN Funktionsnamen.
import deep
export { value, duplicate, halve, code_of }

fn value() -> i32 {
    return deep.value() * 10
}

fn duplicate(x: i32) -> i32 {
    return x + x
}

// Fehlermenge und Fehlerunion im Modul (tests/740_error_union_core.fi) —
// Mengennamen gelten programmweit, deshalb steht die Menge nicht in der
// export-Liste (SPEC §14.1).
error ComputeError { Odd, Negative }

fn halve(n: i32) -> ComputeError!i32 {
    if n < 0 {
        return ComputeError::Negative
    }
    if n % 2 != 0 {
        return ComputeError::Odd
    }
    return n / 2
}

// Der reine Fehlerwert als Parameter; Vergleich mit == / !=.
fn code_of(e: ComputeError) -> i32 {
    if e == ComputeError::Odd {
        return 0 - 1
    }
    if e != ComputeError::Negative {
        return 0
    }
    return 0 - 2
}
