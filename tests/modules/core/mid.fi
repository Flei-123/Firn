// Middle level: imports the lower one and has THE SAME function name.
import deep
export { value, duplicate, halve, code_of }

fn value() -> i32 {
    return deep.value() * 10
}

fn duplicate(x: i32) -> i32 {
    return x + x
}

// Error set and error union in the module (tests/740_error_union_core.fi) --
// set names hold program-wide, which is why the set is not in the
// export list (SPEC 14.1).
error ComputeError { Odd, Negative }

fn halve(n: i32) -> ComputeError!i32 {
    if n < 0 {
        return ComputeError::Negative
    }
    if n % 2 != 0 {
        return ComputeError::Odd
    }
    return n / 2
}

// The bare error value as a parameter; comparison with == / !=.
fn code_of(e: ComputeError) -> i32 {
    if e == ComputeError::Odd {
        return 0 - 1
    }
    if e != ComputeError::Negative {
        return 0
    }
    return 0 - 2
}
