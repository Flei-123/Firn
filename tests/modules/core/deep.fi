// Unterste Ebene der Modulkette. Der Name `wert` kommt in JEDER Ebene vor —
// genau daran zeigt sich, ob die Umbenennung greift.
export { value, GRUND, Pair, sum }

const GRUND: i32 = 7

struct Pair {
    a: i32,
    b: i32,
}

fn value() -> i32 {
    return GRUND
}

fn sum(p: Pair) -> i32 {
    return p.a + p.b
}
