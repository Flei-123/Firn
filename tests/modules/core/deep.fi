// Lowest level of the module chain. The name `value` occurs in EVERY level --
// exactly that shows whether the renaming works.
export { value, BASE, Pair, sum }

const BASE: i32 = 7

struct Pair {
    a: i32,
    b: i32,
}

fn value() -> i32 {
    return BASE
}

fn sum(p: Pair) -> i32 {
    return p.a + p.b
}
