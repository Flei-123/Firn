// Der Kern-Test zur Runde 34: eine gc-Klasse in einem importierten Modul.
// Die Wurzeldatei enthaelt bewusst KEIN `gc`-Token — der Treiber muss die
// Sammler-Laufzeit trotzdem einziehen (Scan ueber den ganzen Importgraphen).

gc class Ring {
    next: Gc[Ring],
    value: u32,
}

// Ein Zyklus aus zwei Knoten: a -> b -> a. Ueberlebt gc_sammeln() nur,
// solange eine Wurzel zeigt.
fn ring_new(x: u32, y: u32) -> AllocError!Gc[Ring] {
    let a: Gc[Ring] = try gc Ring{ next: gc_null[Ring](), value: x }
    let b: Gc[Ring] = try gc Ring{ next: a, value: y }
    a.next = b
    return a
}
