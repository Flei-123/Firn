// The core test for round 34: a gc class in an imported module.
// The root file deliberately contains NO `gc` token -- the driver still has
// to pull in the collector runtime (a scan over the whole import graph).

gc class Ring {
    next: Gc[Ring],
    value: u32,
}

// A cycle of two nodes: a -> b -> a. It only survives gc_collect() when
// as long as a root points at it.
fn ring_new(x: u32, y: u32) -> AllocError!Gc[Ring] {
    let a: Gc[Ring] = try gc Ring { next: gc_null[Ring](), value: x }
    let b: Gc[Ring] = try gc Ring { next: a, value: y }
    a.next = b
    return a
}
