// Generic templates in a MODULE -- and three traps that only self
// compilation in round 31 uncovered (docs/SELF_HOSTING.md 21).
//
// 1. `lx` is a FUNCTION here and a PARAMETER in `take`. When a module is
//    renamed (`templates__name`), the parameter must not go along.
// 2. `Outer` contains `Inner`, which stands FURTHER DOWN -- the layout must
//    not depend on the order.
// 3. This module imports a module itself -- one NEXT TO IT
//    (`import deep`, not next to the root file). Without resolution over
//    several levels it was missing entirely.
import deep

export { Pair, pair_new, sum, size, lx, take, Outer, Inner, outer_new,
    double, length_of, basic_times }

struct Pair[T] {
    a: T,
    b: T,
}

// A struct that contains one declared LATER.
struct Outer {
    inner: Inner,
    n: i32,
}

struct Inner {
    x: i32,
    y: i32,
}

fn pair_new[T: Scalar](a: T, b: T) -> Pair[T] {
    return Pair[T] { a: a, b: b }
}

fn sum[T: Int](p: *mut Pair[T]) -> T {
    return (*p).a + (*p).b
}

// `size_of[T]()` in the body of a template: the type sits in the call name
// AND in the node, both have to be substituted at the instantiation.
fn size[T: Scalar]() -> usize {
    return size_of[T]()
}

// A template calls a template with the same type ...
fn double[T: Int](x: T) -> T {
    let p: Pair[T] = pair_new[T](x, x)
    var q: Pair[T] = p
    return sum[T](&q)
}

// ... and one with a FIXED, different type.
fn length_of[T: Scalar](count: usize) -> usize {
    return count * size[T]() + size[u8]()
}

fn lx(x: i32) -> i32 {
    return x + 1
}

// `lx` is the parameter here, not the function above it.
fn take(lx: i32) -> i32 {
    return lx
}

fn outer_new(x: i32, y: i32, n: i32) -> Outer {
    return Outer { inner: Inner { x: x, y: y }, n: n }
}

// So that the second level is really needed: a constant from there,
// used from inside the body of a TEMPLATE (blocker B2 from round 17).
fn basic_times[T: Int](x: T) -> T {
    return x * (deep.BASE as T)
}
