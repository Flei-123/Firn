// Module for tests/2392: a parameter has the same name as a function of the
// module, and the line after its use begins with `(`. The `(` belongs to the
// NEXT statement, so the parameter is a plain value and hides the function.
export { Node, fill, kind, child, line }

struct Node {
    kind: u8,
    child: u32,
    line: u32,
    after: u32,
}

fn fill(nd: *mut Node, kind: u8, child: u32, line: u32) {
    (*nd).kind = kind
    (*nd).child = child
    (*nd).line = line
    (*nd).after = 5
}

fn kind(nd: *mut Node) -> u8 {
    return (*nd).kind
}

fn child(nd: *mut Node) -> u32 {
    return (*nd).child
}

fn line(nd: *mut Node) -> u32 {
    return (*nd).line
}
