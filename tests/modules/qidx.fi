// tests/modules/qidx.fi -- tables and a generic template for the r729 test
// (`qidx.TABLE[expr]` is an index, not type arguments).
export { TABLE, NAMES, pick_t, Cell }

static TABLE: [u32; 4] = [10, 20, 30, 40]
static NAMES: [u8; 3] = [1, 2, 3]

struct Cell[T] { v: T }

fn pick_t[T](a: T, b: T) -> T {
    return b
}
