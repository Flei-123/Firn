// Module for tests/4345: a comprehension variable has the same name as a global of the
// module. The element `k * 2` is parsed before its `for k in ..`; `k` is still the loop
// variable (not the constant, not renamed to `comp_shadow__k`).
export { squares, doubled, k }
import std.vec

const k: i64 = 100

fn squares(v: *mut Vec[i64]) -> Vec[i64] {
    return [k * k for k in *v]
}

fn doubled(v: *mut Vec[i64]) -> Vec[i64] {
    let out: Vec[i64] = [k * 2 for k in *v if k != 3]
    return out
}
