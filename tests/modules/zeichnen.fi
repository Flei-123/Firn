// tests/modules/zeichnen.fi — eine Schnittstelle IN EINEM MODUL (Runde 46).
//
// Der Punkt dieses Moduls ist die Umbenennung. Aus `Kreis` wird beim
// Zusammenfuehren `zeichnen__Kreis`, aus der Methode `flaeche` die Funktion
// `zeichnen__Kreis__flaeche`, und die Methodentafel muss auf GENAU diesen
// Namen zeigen. Der Name der Schnittstelle wird dagegen NICHT umbenannt:
// `interface` gilt programmweit, wie `enum` und `gc class`
// (SPEC §14.1 T6, docs/RUNDE46.md §9).
//
// `firnc0` benennt nach dem Parsen um (modules.rs), `firnc1` waehrend des
// Parsens (parser.fi). Laufen sie hier auseinander, zeigt die Tafel ins
// Leere — und der Vergleich in tools/selbst_vergleich.sh merkt es.
export { Kreis, Quadrat, neu_kreis, neu_quadrat, groesse }

interface Groesse {
    fn groesse(*self) -> i64
    fn wachse(*mut self, k: i64)
}

struct Kreis { r: i64 }

struct Quadrat { seite: i64 }

fn neu_kreis(r: i64) -> Kreis {
    return Kreis{ r: r }
}

fn neu_quadrat(s: i64) -> Quadrat {
    return Quadrat{ seite: s }
}

// Eine freie Funktion, die wie die Methode heisst: verdeckt wird nichts.
fn groesse(a: i64) -> i64 {
    return a
}

impl Groesse for Kreis {
    fn groesse(*self) -> i64 { return 3 * (*self).r * (*self).r }
    fn wachse(*mut self, k: i64) { (*self).r = (*self).r + k }
}

impl Groesse for Quadrat {
    fn groesse(*self) -> i64 { return (*self).seite * (*self).seite }
    fn wachse(*mut self, k: i64) { (*self).seite = (*self).seite + k }
}
