// tests/modules/bounds.fi -- bounds ACROSS MODULE BOUNDARIES (round 50).
//
// Four things that are checked here at the same time and that one can only
// get wrong together:
//
//   * The interface `Row` holds PROGRAM-WIDE and is not renamed --
//     the root file writes `T: Row` without putting `bounds.` in front of
//     it, and implements it for its own types.
//   * The type `Mark` becomes `bounds__Mark`, its method becomes
//     `bounds__Mark__rank`. The implementation check has to find both under
//     the RENAMED name (iface.rs, the implementation lookup).
//   * `impl Row for u16` creates `u16__rank` -- WITHOUT a module prefix. A
//     basic type belongs to no module, so its methods belong to none
//     either. Were that different, the root file would not find `u16__rank`.
//   * The template `largest[T: Row]` stands here but is instantiated
//     OUTSIDE. Generic names hold program-wide; the bound has to see
//     the implementation of the calling module.
export { Mark, mark_new, mark_rank, largest }

interface Row {
    fn rank(*self) -> i64
}

struct Mark { n: i64 }

fn mark_new(n: i64) -> Mark {
    return Mark { n: n }
}

impl Row for Mark {
    fn rank(*self) -> i64 {
        return (*self).n
    }
}

impl Row for u16 {
    fn rank(*self) -> i64 {
        return (*self) as i64
    }
}

// A call INSIDE the module: `m.rank()` has to hit
// `bounds__Mark__rank` here.
fn mark_rank(m: *Mark) -> i64 {
    return m.rank()
}

// A template WITH a bound that stands in a module itself. Its name stays
// unchanged (generic names hold program-wide), but the body sees
// the names of this module.
fn largest[T: Row](a: *T, b: *T) -> i64 {
    let x: i64 = a.rank()
    let y: i64 = b.rank()
    if x < y {
        return y
    }
    return x
}
