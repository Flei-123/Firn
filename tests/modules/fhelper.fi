// Module 'fhelper' -- interpolation inside an IMPORTED module
// (round 39): the module imports `std.io` itself, the resolution of
// `io.fmt_*` and the hoisting of the text segments run in the module context.
import std.io

export { message }

fn message(n: i32) -> io.Fmt {
    return f"helfer sagt {n}"
}
