// tests/modules/qty.fi -- generic struct for the qualified-type tests
// (`qty.Box[i32]`, tests 3991-3995).
export { Box, Pair, make_box, unbox }

struct Box[T] { v: T }

struct Pair[A, B] { a: A, b: B }

fn make_box[T](x: T) -> Box[T] {
    return Box[T] { v: x }
}

fn unbox[T](b: Box[T]) -> T {
    return b.v
}
