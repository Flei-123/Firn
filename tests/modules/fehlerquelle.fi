// Modul fuer tests/414_modul_fehler.fi — Fehlermenge und Fehlerunion ueber
// die Modulgrenze (Fehlermengennamen sind programmweit, SPEC §14.1).
export { lies }

error LeseFehler { Ende, Kaputt }

fn lies(n: i32) -> LeseFehler!i32 {
    if n == 0 {
        return LeseFehler::Ende
    }
    if n < 0 {
        return LeseFehler::Kaputt
    }
    return n * 3
}
