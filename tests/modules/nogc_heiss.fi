// Modul 'nogc_heiss' — wird von tests/542_no_gc_modul.fi eingebunden.
// Alle nach aussen sichtbaren Funktionen tragen #[no_gc] (SPEC §3.5.4): die
// Zusage gilt ueber die Modulgrenze hinweg, weil das Modulsystem die Namen
// vor der Pruefung auf 'nogc_heiss__name' umschreibt und der Pruefer den
// ganzen, flachen Aufrufbaum sieht.
export { mische, runde }

#[no_gc]
fn runde(x: i32) -> i32 {
    return (x * 31 as i32) + 7 as i32
}

#[no_gc]
fn mische(a: i32, b: i32) -> i32 {
    return runde(a) + runde(b)
}
