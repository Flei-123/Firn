// tests/modules/schranken.fi — Schranken UEBER MODULGRENZEN (Runde 50).
//
// Vier Dinge, die hier gleichzeitig geprueft werden und die man nur zusammen
// falsch machen kann:
//
//   * Die Schnittstelle `Reihe` gilt PROGRAMMWEIT und wird nicht umbenannt —
//     die Wurzeldatei schreibt `T: Reihe`, ohne `schranken.` davorzusetzen,
//     und setzt sie fuer ihre eigenen Typen um.
//   * Der Typ `Marke` wird zu `schranken__Marke`, seine Methode zu
//     `schranken__Marke__rang`. Die Umsetzungspruefung muss beide unter dem
//     UMBENANNTEN Namen wiederfinden (`iface::typ_struct`).
//   * `impl Reihe for u16` legt `u16__rang` an — OHNE Modulpraefix. Ein
//     Grundtyp gehoert keinem Modul, also gehoeren seine Methoden auch
//     keinem. Waere das anders, fuende die Wurzeldatei `u16__rang` nicht.
//   * Die Vorlage `groesster[T: Reihe]` steht hier, wird aber DRAUSSEN
//     ausgepraegt. Generische Namen gelten programmweit; die Schranke muss
//     die Umsetzung des aufrufenden Moduls sehen.
export { Marke, marke_neu, marke_rang, groesster }

interface Reihe {
    fn rang(*self) -> i64
}

struct Marke { n: i64 }

fn marke_neu(n: i64) -> Marke {
    return Marke{ n: n }
}

impl Reihe for Marke {
    fn rang(*self) -> i64 {
        return (*self).n
    }
}

impl Reihe for u16 {
    fn rang(*self) -> i64 {
        return (*self) as i64
    }
}

// Ein Aufruf INNERHALB des Moduls: `m.rang()` muss hier
// `schranken__Marke__rang` treffen.
fn marke_rang(m: *Marke) -> i64 {
    return m.rang()
}

// Eine Vorlage MIT Schranke, die selbst in einem Modul steht. Ihr Name bleibt
// unveraendert (generische Namen gelten programmweit), der Rumpf sieht aber
// die Namen dieses Moduls.
fn groesster[T: Reihe](a: *T, b: *T) -> i64 {
    let x: i64 = a.rang()
    let y: i64 = b.rang()
    if x < y {
        return y
    }
    return x
}
