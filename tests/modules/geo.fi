// tests/modules/geo.fi -- a module with methods (round 45).
//
// The point of this module: the renaming. `Rect` becomes
// `geo__Rect` when merging, the method `area` becomes the function
// `geo__Rect__area`. Both compilers have to build the same name --
// `firnc0` renames after parsing (modules.rs), `firnc1`
// during parsing (parser.fi). If they drift apart here, the call
// `r.area()` in the root file finds nothing any more.
export { Rect, Dot, new, square, unit }

struct Dot { x: i32, y: i32 }

struct Rect { corner: Dot, width: i32, height: i32 }

fn new(x: i32, y: i32, b: i32, h: i32) -> Rect {
    return Rect { corner: Dot { x: x, y: y }, width: b, height: h }
}

fn square(page: i32) -> Rect {
    return new(0, 0, page, page)
}

// A free function with the same name as a method: `unit` exists here
// AND as `Rect.unit`. Nothing is hidden.
fn unit() -> i32 {
    return 1
}

impl Dot {
    fn sum(*self) -> i32 {
        return (*self).x + (*self).y
    }
}

impl Rect {
    fn area(*self) -> i32 {
        return (*self).width * (*self).height
    }
    fn extent(*self) -> i32 {
        return 2 * ((*self).width + (*self).height)
    }
    // A method calls the method of ANOTHER type of the same module.
    fn corner_sum(*self) -> i32 {
        return (*self).corner.sum()
    }
    fn shift(*mut self, dx: i32, dy: i32) {
        (*self).corner.set_x((*self).corner.x + dx)
        (*self).corner.y = (*self).corner.y + dy
    }
    fn is_square(*self) -> bool {
        return (*self).width == (*self).height
    }
    // Calls the FREE function `unit` -- not itself.
    fn unit(*self) -> i32 {
        return unit() + (*self).width
    }
}

impl Dot {
    // A second impl block for the same type is allowed: `impl` creates
    // functions, not a closed table.
    fn set_x(*mut self, x: i32) {
        (*self).x = x
    }
}
