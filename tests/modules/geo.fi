// tests/modules/geo.fi — ein Modul mit Methoden (Runde 45).
//
// Der Punkt dieses Moduls: die Umbenennung. Aus `Rechteck` wird beim
// Zusammenfuehren `geo__Rechteck`, aus der Methode `flaeche` die Funktion
// `geo__Rechteck__flaeche`. Beide Compiler muessen dabei denselben Namen
// bilden — `firnc0` benennt nach dem Parsen um (modules.rs), `firnc1`
// waehrend des Parsens (parser.fi). Laufen sie hier auseinander, findet der
// Aufruf `r.flaeche()` in der Wurzeldatei nichts mehr.
export { Rect, Dot, new, square, unit }

struct Dot { x: i32, y: i32 }

struct Rect { corner: Dot, width: i32, height: i32 }

fn new(x: i32, y: i32, b: i32, h: i32) -> Rect {
    return Rect{ corner: Dot{ x: x, y: y }, width: b, height: h }
}

fn square(page: i32) -> Rect {
    return new(0, 0, page, page)
}

// Eine freie Funktion, die wie eine Methode heisst: `einheit` gibt es hier
// UND als `Rechteck.einheit`. Verdeckt wird nichts.
fn unit() -> i32 {
    return 1
}

impl Dot {
    fn sum(*self) -> i32 {
        return (*self).x + (*self).y
    }
}

impl Rect {
    fn area(*self) -> i32 {
        return (*self).width * (*self).height
    }
    fn extent(*self) -> i32 {
        return 2 * ((*self).width + (*self).height)
    }
    // Methode ruft die Methode eines ANDEREN Typs desselben Moduls.
    fn corner_sum(*self) -> i32 {
        return (*self).corner.sum()
    }
    fn shift(*mut self, dx: i32, dy: i32) {
        (*self).corner.set_x((*self).corner.x + dx)
        (*self).corner.y = (*self).corner.y + dy
    }
    fn is_square(*self) -> bool {
        return (*self).width == (*self).height
    }
    // Ruft die FREIE Funktion `einheit` — nicht sich selbst.
    fn unit(*self) -> i32 {
        return unit() + (*self).width
    }
}

impl Dot {
    // Ein zweiter impl-Block fuer denselben Typ ist erlaubt: `impl` legt
    // Funktionen an, keine geschlossene Tafel.
    fn set_x(*mut self, x: i32) {
        (*self).x = x
    }
}
