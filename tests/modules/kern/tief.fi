// Unterste Ebene der Modulkette. Der Name `wert` kommt in JEDER Ebene vor —
// genau daran zeigt sich, ob die Umbenennung greift.
export { wert, GRUND, Paar, summe }

const GRUND: i32 = 7

struct Paar {
    a: i32,
    b: i32,
}

fn wert() -> i32 {
    return GRUND
}

fn summe(p: Paar) -> i32 {
    return p.a + p.b
}
