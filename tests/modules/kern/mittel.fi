// Mittlere Ebene: bindet die untere ein und hat DENSELBEN Funktionsnamen.
import tief
export { wert, doppelt, halbiere, code_von }

fn wert() -> i32 {
    return tief.wert() * 10
}

fn doppelt(x: i32) -> i32 {
    return x + x
}

// Fehlermenge und Fehlerunion im Modul (tests/740_fehlerunion_kern.fi) —
// Mengennamen gelten programmweit, deshalb steht die Menge nicht in der
// export-Liste (SPEC §14.1).
error RechenFehler { Ungerade, Negativ }

fn halbiere(n: i32) -> RechenFehler!i32 {
    if n < 0 {
        return RechenFehler::Negativ
    }
    if n % 2 != 0 {
        return RechenFehler::Ungerade
    }
    return n / 2
}

// Der reine Fehlerwert als Parameter; Vergleich mit == / !=.
fn code_von(e: RechenFehler) -> i32 {
    if e == RechenFehler::Ungerade {
        return 0 - 1
    }
    if e != RechenFehler::Negativ {
        return 0
    }
    return 0 - 2
}
