// Generische Vorlagen in einem MODUL — und drei Fallen, die erst das
// Selbstübersetzen in Runde 31 aufgedeckt hat (docs/SELBSTHOSTING.md §21).
//
// 1. `lx` ist hier eine FUNKTION und in `nimm` ein PARAMETER. Beim Umbenennen
//    eines Moduls (`vorlagen__name`) darf der Parameter nicht mitgehen.
// 2. `Aussen` enthält `Innen`, das WEITER UNTEN steht — das Layout darf nicht
//    von der Reihenfolge abhängen.
// 3. Dieses Modul bindet selbst ein Modul ein — und zwar eines NEBEN SICH
//    (`import tief`, nicht neben der Wurzeldatei). Ohne Auflösung über
//    mehrere Ebenen fehlte es ganz.
import tief

export { Paar, paar_neu, summe, groesse, lx, nimm, Aussen, Innen, aussen_neu,
         verdoppeln, laenge_von, grund_mal }

struct Paar[T] {
    a: T,
    b: T,
}

// Ein Struct, das einen SPÄTER deklarierten enthält.
struct Aussen {
    innen: Innen,
    n: i32,
}

struct Innen {
    x: i32,
    y: i32,
}

fn paar_neu[T: Scalar](a: T, b: T) -> Paar[T] {
    return Paar[T]{ a: a, b: b }
}

fn summe[T: Int](p: *mut Paar[T]) -> T {
    return (*p).a + (*p).b
}

// `size_of[T]()` im Rumpf einer Vorlage: der Typ steckt im Aufrufnamen UND im
// Knoten, beides muss bei der Ausprägung ersetzt werden.
fn groesse[T: Scalar]() -> usize {
    return size_of[T]()
}

// Eine Vorlage ruft eine Vorlage mit demselben Typ ...
fn verdoppeln[T: Int](x: T) -> T {
    let p: Paar[T] = paar_neu[T](x, x)
    var q: Paar[T] = p
    return summe[T](&q)
}

// ... und eine mit einem FESTEN, anderen Typ.
fn laenge_von[T: Scalar](anzahl: usize) -> usize {
    return anzahl * groesse[T]() + groesse[u8]()
}

fn lx(x: i32) -> i32 {
    return x + 1
}

// `lx` ist hier der Parameter, nicht die Funktion darüber.
fn nimm(lx: i32) -> i32 {
    return lx
}

fn aussen_neu(x: i32, y: i32, n: i32) -> Aussen {
    return Aussen{ innen: Innen{ x: x, y: y }, n: n }
}

// Damit die zweite Ebene wirklich gebraucht wird: eine Konstante von dort,
// benutzt aus dem Rumpf einer VORLAGE heraus (Blocker B2 aus Runde 17).
fn grund_mal[T: Int](x: T) -> T {
    return x * (tief.GRUND as T)
}
