// expect_exit: 0
// mc_hash 1.21.5+ rest (r207): NBT byte / int / long arrays (HashOps.createByteList / createIntList / createLongList), attribute_modifiers
// display override ({type: override, value: <text>}) and the empty block id list of a tool rule.
// Expected values come from an independent Python implementation (CRC32C over tagged bytes), the tags from HashOps of the 26.1 server jar.
import std.rt
import mc.mc_hash

fn hs(s: str) -> u32 { return mc_hash.hash_string(s.p as u64, s.n) }

fn main() -> i32 {
    // big endian payloads as the NBT wire has them
    let b: u64 = rt.heap_alloc(16)
    rt.st8(b, 0, 1 as u8)
    rt.st8(b, 1, 2 as u8)
    rt.st8(b, 2, 3 as u8)
    if mc_hash.hash_byte_array(b, 3) != (3903615044 as u32) { return 101 }
    if mc_hash.hash_byte_array(b, 0) != (1537857916 as u32) { return 102 }
    let i: u64 = rt.heap_alloc(16)
    rt.st8(i, 0, 0 as u8); rt.st8(i, 1, 0 as u8); rt.st8(i, 2, 0 as u8); rt.st8(i, 3, 1 as u8)
    rt.st8(i, 4, 255 as u8); rt.st8(i, 5, 255 as u8); rt.st8(i, 6, 255 as u8); rt.st8(i, 7, 254 as u8)
    if mc_hash.hash_int_array(i, 2) != (4211036725 as u32) { return 103 }
    if mc_hash.hash_int_array(i, 0) != (747749951 as u32) { return 104 }
    let l: u64 = rt.heap_alloc(16)
    var k: usize = 0
    while k < 7 { rt.st8(l, k, 0 as u8); k = k + 1 }
    rt.st8(l, 7, 1 as u8)
    k = 8
    while k < 15 { rt.st8(l, k, 255 as u8); k = k + 1 }
    rt.st8(l, 15, 254 as u8)
    if mc_hash.hash_long_array(l, 2) != (1998900184 as u32) { return 105 }
    // empty direct block set = the empty list
    if mc_hash.hash_blocks_ids(b, 0) != (2316960274 as u32) { return 106 }
    // attack_damage mainhand add_value 7.5 with display override "Hi"
    let e: u32 = mc_hash.hash_attr_entry(hs("minecraft:attack_damage"), hs("test:a"), 0x401e000000000000 as u64, 0, 1, 2, hs("Hi"))
    if e != (1273342388 as u32) { return 107 }
    return 0
}
