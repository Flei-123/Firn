// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
// tests/2152_msa.fi -- lib/auth/msa.fi without a network: the three request
// bodies of the Microsoft -> Xbox Live -> XSTS -> Minecraft chain (parsed
// back and compared field by field), the XErr texts, the dashed UUID, the
// session as JSON and back, the endpoints, the claims reader. The chain
// itself runs against tools/oauth/fake_msa.py (tools/oauth/check_msa.py).
import std.rt
import std.io
import std.json
import std.str
import auth.oauth
import auth.msa

fn bs(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: (*b).len }
}

fn gs(d: *mut json.Json, obj: u32, name: str) -> str {
    return oauth.oa_json_str(d, obj, name)
}

fn child(d: *mut json.Json, obj: u32, name: str) -> u32 {
    return json.json_get(d, obj, name.p as u64, name.length())
}

fn main() -> i32 {
    var d: json.Json = json.json_new()
    var b: rt.Buf = rt.buf_new()

    // ---- the Xbox Live body
    msa.msa_xbl_body("AbC.d-e_f\"quote", &b)
    if !(json.json_parse(&d, b.ptr, b.len) catch false) { return 1 as i32 }
    var root: u32 = json.json_root(&d)
    let props: u32 = child(&d, root, "Properties")
    if props == json.JSON_NONE { return 2 as i32 }
    if gs(&d, props, "AuthMethod") != "RPS" || gs(&d, props, "SiteName") != "user.auth.xboxlive.com" { return 3 as i32 }
    if gs(&d, props, "RpsTicket") != "d=AbC.d-e_f\"quote" { return 4 as i32 }
    if gs(&d, root, "RelyingParty") != "http://auth.xboxlive.com" || gs(&d, root, "TokenType") != "JWT" { return 5 as i32 }
    if json.json_count(&d, root) != 3 { return 6 as i32 }
    json.json_free(&d)
    d = json.json_new()

    // ---- XSTS
    rt.buf_clear(&b)
    msa.msa_xsts_body("XBLTOK", &b)
    if !(json.json_parse(&d, b.ptr, b.len) catch false) { return 10 as i32 }
    root = json.json_root(&d)
    let p2: u32 = child(&d, root, "Properties")
    if gs(&d, p2, "SandboxId") != "RETAIL" { return 11 as i32 }
    let ut: u32 = child(&d, p2, "UserTokens")
    if ut == json.JSON_NONE || json.json_kind(&d, ut) != json.JSON_ARRAY || json.json_count(&d, ut) != 1 { return 12 as i32 }
    let first: str = str { p: json.json_string(&d, json.json_child(&d, ut)).p, n: json.json_string(&d, json.json_child(&d, ut)).n }
    if first != "XBLTOK" { return 13 as i32 }
    if gs(&d, root, "RelyingParty") != "rp://api.minecraftservices.com/" || gs(&d, root, "TokenType") != "JWT" { return 14 as i32 }
    json.json_free(&d)
    d = json.json_new()

    // ---- login_with_xbox
    rt.buf_clear(&b)
    msa.msa_login_with_xbox_body("2535428504", "eyJ.abc.def", &b)
    if bs(&b) != "{\"identityToken\":\"XBL3.0 x=2535428504;eyJ.abc.def\"}" { return 20 as i32 }

    // ---- XErr texts and UUID
    if !msa.msa_xerr_text(msa.XERR_NO_ACCOUNT).contains("no Xbox account") { return 30 as i32 }
    if !msa.msa_xerr_text(msa.XERR_CHILD).contains("family") { return 31 as i32 }
    if !msa.msa_xerr_text(msa.XERR_COUNTRY).contains("country") { return 32 as i32 }
    if !msa.msa_xerr_text(msa.XERR_ADULT1).contains("adult") || !msa.msa_xerr_text(msa.XERR_ADULT2).contains("adult") { return 33 as i32 }
    if !msa.msa_xerr_text(msa.XERR_BANNED).contains("banned") { return 34 as i32 }
    if msa.msa_xerr_text(5).length() != 0 { return 35 as i32 }
    if msa.msa_uuid_dashed("069a79f444e94726a5befca90e38aaf5") != "069a79f4-44e9-4726-a5be-fca90e38aaf5" { return 36 as i32 }
    if msa.msa_uuid_dashed("tooshort") != "tooshort" { return 37 as i32 }
    if msa.msa_error_text(msa.MSA_XERR) != "xsts_refused" || msa.msa_error_text(msa.MSA_NOT_OWNED) != "not_owned" { return 38 as i32 }
    if msa.msa_error_text(oauth.OA_NET) != "network" { return 39 as i32 }

    // ---- the session as JSON
    var s: msa.MsaSession = msa.msa_session_new()
    s.ms.access = "msa"
    s.ms.refresh = "msr"
    s.ms.expires_at = 4102444800
    s.ms.scope = "XboxLive.signin offline_access"
    s.mc_token = "mc.tok\"en"
    s.mc_expires_at = 4102444800
    s.uhs = "12345"
    s.uuid = "069a79f444e94726a5befca90e38aaf5"
    s.name = "Steve_42"
    s.owns = true
    s.has_profile = true
    s.ok = true
    var js: rt.Buf = rt.buf_new()
    msa.msa_session_to_json(&s, &js)
    var s2: msa.MsaSession = msa.msa_session_new()
    if !msa.msa_session_from_json(bs(&js), &s2) { return 40 as i32 }
    if s2.ms.access != "msa" || s2.ms.refresh != "msr" || s2.ms.expires_at != 4102444800 { return 41 as i32 }
    if s2.mc_token != "mc.tok\"en" || s2.mc_expires_at != 4102444800 || s2.uhs != "12345" { return 42 as i32 }
    if s2.uuid != s.uuid || s2.name != "Steve_42" || !s2.owns || !s2.has_profile || !s2.ok { return 43 as i32 }
    if msa.msa_session_from_json("{}", &s2) { return 44 as i32 }
    if msa.msa_session_from_json("[1]", &s2) { return 45 as i32 }
    if !msa.msa_valid(&s2, 60) { return 46 as i32 }
    s2.mc_expires_at = oauth.oa_now() + 30
    if msa.msa_valid(&s2, 60) || !msa.msa_valid(&s2, 10) { return 47 as i32 }
    s2.ok = false
    if msa.msa_valid(&s2, 0) { return 48 as i32 }

    // ---- the default endpoints are the https ones
    let ep: msa.MsaEndpoints = msa.msa_endpoints_default()
    if !oauth.oa_endpoint_ok(ep.device_url) || !oauth.oa_endpoint_ok(ep.token_url) || !oauth.oa_endpoint_ok(ep.xbl_url) { return 50 as i32 }
    if !oauth.oa_endpoint_ok(ep.xsts_url) || !oauth.oa_endpoint_ok(ep.mc_login_url) || !oauth.oa_endpoint_ok(ep.mc_profile_url) { return 51 as i32 }
    if !ep.device_url.starts_with("https://login.microsoftonline.com/consumers/") { return 52 as i32 }
    if ep.xbl_url != "https://user.auth.xboxlive.com/user/authenticate" { return 53 as i32 }
    if ep.xsts_url != "https://xsts.auth.xboxlive.com/xsts/authorize" { return 54 as i32 }
    if ep.mc_login_url != "https://api.minecraftservices.com/authentication/login_with_xbox" { return 55 as i32 }

    // ---- the claims of a token, unverified (here: {"sub":"u","exp":5})
    let claims: str = msa.msa_parse_token_claims("eyJhbGciOiJSUzI1NiJ9.eyJzdWIiOiJ1IiwiZXhwIjo1fQ.c2ln")
    if claims != "{\"sub\":\"u\",\"exp\":5}" { return 60 as i32 }
    if msa.msa_parse_token_claims("nodots").length() != 0 { return 61 as i32 }

    // ---- a Msa without a client: refuses to start the device flow, no request
    var m: msa.Msa = msa.msa_new("")
    var da: oauth.DeviceAuth = oauth.deviceauth_new()
    if msa.msa_device_start(&m, &da) != oauth.OA_CONFIG { return 70 as i32 }
    var s3: msa.MsaSession = msa.msa_session_new()
    if msa.msa_refresh(&m, &s3) != oauth.OA_NOTOKEN { return 71 as i32 }
    json.json_free(&d)
    rt.buf_free(&b)
    rt.buf_free(&js)
    return 0 as i32
}
