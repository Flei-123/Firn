// expect_exit: 0
import std.json
import std.rt
import std.io

const FNV_PRIME: u64 = 1099511628211
const EXPECT_HASH: u64 = 4010713919871558497
const DOCS: usize = 3000

fn rnd(s: *mut u64) -> u64 {
    var x: u64 = *s
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    *s = x
    return x
}

fn pick(s: *mut u64, n: u64) -> u64 {
    return (rnd(s) >> 11) % n
}

fn gen_ws(s: *mut u64, b: *mut rt.Buf) {
    let m: u64 = pick(s, 8)
    var n: u64 = 0
    if m < 2 {
        n = 0
    } else if m < 5 {
        n = pick(s, 4)
    } else if m < 7 {
        n = pick(s, 26)
    } else {
        n = 8 * (pick(s, 4) + 1)
    }
    var i: u64 = 0
    while i < n {
        let t: u64 = pick(s, 40)
        if t == 0 {
            rt.buf_push(b, 9 as u8)
        } else if t == 1 {
            rt.buf_push(b, 13 as u8)
        } else if t == 2 {
            rt.buf_push(b, 10 as u8)
        } else {
            rt.buf_push(b, 32 as u8)
        }
        i = i + 1
    }
}

fn hexd(s: *mut u64, b: *mut rt.Buf) {
    let v: u64 = pick(s, 16)
    if v < 10 {
        rt.buf_push(b, (48 + v) as u8)
    } else {
        rt.buf_push(b, (87 + v) as u8)
    }
}

fn gen_u_escape(s: *mut u64, b: *mut rt.Buf, kind: u64) {
    rt.buf_push(b, 92 as u8)
    rt.buf_push(b, 117 as u8)
    if kind == 0 {
        hexd(s, b)
        hexd(s, b)
        hexd(s, b)
        hexd(s, b)
    } else if kind == 1 {
        rt.buf_push(b, 100 as u8)
        rt.buf_push(b, (56 + pick(s, 4)) as u8)
        hexd(s, b)
        hexd(s, b)
    } else {
        rt.buf_push(b, 100 as u8)
        rt.buf_push(b, (99 + pick(s, 4)) as u8)
        hexd(s, b)
        hexd(s, b)
    }
}

fn gen_string_body(s: *mut u64, b: *mut rt.Buf) {
    let lm: u64 = pick(s, 10)
    var n: u64 = 0
    if lm < 6 {
        n = pick(s, 20)
    } else if lm < 9 {
        n = pick(s, 70)
    } else {
        n = pick(s, 300)
    }
    var i: u64 = 0
    while i < n {
        let t: u64 = pick(s, 100)
        if t < 70 {
            var c: u64 = 32 + pick(s, 95)
            if c == 34 || c == 92 {
                c = 65
            }
            rt.buf_push(b, c as u8)
        } else if t < 76 {
            rt.buf_push(b, 92 as u8)
            let e: u64 = pick(s, 8)
            if e == 0 {
                rt.buf_push(b, 110 as u8)
            } else if e == 1 {
                rt.buf_push(b, 116 as u8)
            } else if e == 2 {
                rt.buf_push(b, 34 as u8)
            } else if e == 3 {
                rt.buf_push(b, 92 as u8)
            } else if e == 4 {
                rt.buf_push(b, 47 as u8)
            } else if e == 5 {
                rt.buf_push(b, 114 as u8)
            } else if e == 6 {
                rt.buf_push(b, 98 as u8)
            } else {
                rt.buf_push(b, 102 as u8)
            }
        } else if t < 80 {
            gen_u_escape(s, b, pick(s, 3))
            if pick(s, 2) == 0 {
                gen_u_escape(s, b, 2)
            }
        } else if t < 88 {
            rt.buf_push(b, (128 + pick(s, 128)) as u8)
        } else if t < 92 {
            let k: u64 = pick(s, 6)
            if k == 0 {
                if pick(s, 25) == 0 {
                    rt.buf_push(b, 31 as u8)
                } else {
                    rt.buf_push(b, 32 as u8)
                }
            } else if k == 1 {
                rt.buf_push(b, 32 as u8)
            } else if k == 2 {
                rt.buf_push(b, 33 as u8)
            } else if k == 3 {
                rt.buf_push(b, 35 as u8)
            } else if k == 4 {
                rt.buf_push(b, 91 as u8)
            } else {
                rt.buf_push(b, 93 as u8)
            }
        } else if t < 93 {
            rt.buf_push(b, 127 as u8)
        } else {
            rt.buf_push(b, 32 as u8)
        }
        i = i + 1
    }
}

fn gen_number(s: *mut u64, b: *mut rt.Buf) {
    if pick(s, 4) == 0 {
        rt.buf_push(b, 45 as u8)
    }
    var digits: u64 = 1 + pick(s, 7)
    if pick(s, 6) == 0 {
        digits = 15 + pick(s, 8)
    }
    var i: u64 = 0
    while i < digits {
        rt.buf_push(b, (48 + pick(s, 10)) as u8)
        i = i + 1
    }
    if pick(s, 3) == 0 {
        rt.buf_push(b, 46 as u8)
        let fd: u64 = 1 + pick(s, 5)
        var j: u64 = 0
        while j < fd {
            rt.buf_push(b, (48 + pick(s, 10)) as u8)
            j = j + 1
        }
    }
    if pick(s, 8) == 0 {
        rt.buf_push(b, 101 as u8)
        if pick(s, 2) == 0 {
            rt.buf_push(b, 45 as u8)
        }
        rt.buf_push(b, (48 + pick(s, 10)) as u8)
    }
}

fn gen_lit(b: *mut rt.Buf, k: u64) {
    if k == 0 {
        rt.buf_push(b, 116 as u8)
        rt.buf_push(b, 114 as u8)
        rt.buf_push(b, 117 as u8)
        rt.buf_push(b, 101 as u8)
    } else if k == 1 {
        rt.buf_push(b, 102 as u8)
        rt.buf_push(b, 97 as u8)
        rt.buf_push(b, 108 as u8)
        rt.buf_push(b, 115 as u8)
        rt.buf_push(b, 101 as u8)
    } else {
        rt.buf_push(b, 110 as u8)
        rt.buf_push(b, 117 as u8)
        rt.buf_push(b, 108 as u8)
        rt.buf_push(b, 108 as u8)
    }
}

fn gen_value(s: *mut u64, b: *mut rt.Buf, depth: u64) {
    gen_ws(s, b)
    var k: u64 = pick(s, 10)
    if depth >= 4 && k < 4 {
        k = 4 + pick(s, 6)
    }
    if k < 2 {
        rt.buf_push(b, 123 as u8)
        let n: u64 = pick(s, 6)
        var i: u64 = 0
        while i < n {
            if i > 0 {
                gen_ws(s, b)
                rt.buf_push(b, 44 as u8)
            }
            gen_ws(s, b)
            rt.buf_push(b, 34 as u8)
            gen_string_body(s, b)
            rt.buf_push(b, 34 as u8)
            gen_ws(s, b)
            rt.buf_push(b, 58 as u8)
            gen_value(s, b, depth + 1)
            i = i + 1
        }
        gen_ws(s, b)
        rt.buf_push(b, 125 as u8)
    } else if k < 4 {
        rt.buf_push(b, 91 as u8)
        let n: u64 = pick(s, 6)
        var i: u64 = 0
        while i < n {
            if i > 0 {
                gen_ws(s, b)
                rt.buf_push(b, 44 as u8)
            }
            gen_value(s, b, depth + 1)
            i = i + 1
        }
        gen_ws(s, b)
        rt.buf_push(b, 93 as u8)
    } else if k < 7 {
        rt.buf_push(b, 34 as u8)
        gen_string_body(s, b)
        rt.buf_push(b, 34 as u8)
    } else if k < 9 {
        gen_number(s, b)
    } else {
        gen_lit(b, pick(s, 3))
    }
    gen_ws(s, b)
}

fn mutate(s: *mut u64, b: *mut rt.Buf) {
    let n: usize = rt.buf_len(b)
    if n == 0 {
        return
    }
    let m: u64 = pick(s, 10)
    if m < 6 {
        return
    }
    let p: usize = pick(s, n as u64) as usize
    if m < 8 {
        rt.buf_set_len(b, p)
        return
    }
    var ib: [u8; 16] = [0, 9, 10, 13, 31, 32, 33, 34, 35, 44, 58, 91, 92, 93, 123, 255]
    var c: u8 = ib[pick(s, 16) as usize]
    if pick(s, 3) == 0 {
        c = pick(s, 256) as u8
    }
    *(((rt.buf_ptr(b)) +% p as u64) as *mut u8) = c
}

fn hash_add(h: *mut u64, v: u64) {
    *h = (*h ^ (v & 255)) *% FNV_PRIME
    *h = (*h ^ ((v >> 8) & 255)) *% FNV_PRIME
    *h = (*h ^ ((v >> 16) & 255)) *% FNV_PRIME
    *h = (*h ^ ((v >> 24) & 255)) *% FNV_PRIME
}

fn main() -> i32 {
    var d: json.Json = json.json_new()
    defer json.json_free(&d)
    var doc: rt.Buf = rt.buf_new()
    defer rt.buf_free(&doc)
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    var line: rt.Buf = rt.buf_new()
    defer rt.buf_free(&line)
    var s: u64 = 88172645463325252
    var h: u64 = 14695981039346656037
    var good: u64 = 0
    var bad: u64 = 0
    var di: usize = 0
    while di < DOCS {
        rt.buf_clear(&doc)
        gen_value(&s, &doc, 0)
        mutate(&s, &doc)
        let ok: bool = json.json_parse(&d, rt.buf_ptr(&doc), rt.buf_len(&doc)) catch false
        hash_add(&h, json.json_err_code(&d) as u64)
        hash_add(&h, json.json_err_line(&d) as u64)
        hash_add(&h, json.json_err_col(&d) as u64)
        if ok && json.json_valid(&d) {
            good = good + 1
            rt.buf_clear(&out)
            json.json_write(&d, json.json_root(&d), &out, false)
            var i: usize = 0
            let n: usize = rt.buf_len(&out)
            while i < n {
                h = (h ^ (rt.buf_at(&out, i) as u64)) *% FNV_PRIME
                i = i + 1
            }
        } else {
            bad = bad + 1
        }
        di = di + 1
    }
    rt.buf_clear(&line)
    rt.buf_push_dec_u64(&line, good)
    rt.buf_push(&line, 32 as u8)
    rt.buf_push_dec_u64(&line, bad)
    rt.buf_push(&line, 32 as u8)
    rt.buf_push_dec_u64(&line, h)
    rt.buf_push(&line, 10 as u8)
    io.print_bytes(rt.buf_ptr(&line), rt.buf_len(&line))
    if EXPECT_HASH != 0 && h != EXPECT_HASH {
        return 1
    }
    return 0
}
