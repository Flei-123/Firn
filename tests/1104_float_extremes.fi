// expect_exit: 0
// Floating point literals at the edges: overflow, underflow, exponents out of range.
//
// An exponent may be larger than an i64 and the value still has to come out
// right -- infinity or zero, but never a wrapped around number. Zero with a
// huge exponent stays zero, and 2^64-1 rounds UP to 2^64 because there is
// no double in between.
//
// The check runs over the BIT PATTERN, not over the printed value: two
// doubles that are one ULP apart print the same in almost every format --
// which is why the divergence of round 63 stayed unnoticed for so long.
// The detour through the address is the one from `lib/firnc1/lexer.fi`:
// a direct cast of `&t` to `*mut u64` is read by stage 0 as a value
// conversion, through the address it is a true reinterpretation.

fn bits_of(x: f64) -> u64 {
    var t: f64 = 0.0
    let p: u64 = (&t) as u64
    *(p as *mut f64) = x
    return *(p as *mut u64)
}

fn main() -> i32 {
    // the largest double
    if bits_of(1.7976931348623157e308) != 9218868437227405311 {
        return 1
    }
    // one step further -> infinity
    if bits_of(1.7976931348623159e308) != 9218868437227405312 {
        return 2
    }
    // infinity
    if bits_of(1e309) != 9218868437227405312 {
        return 3
    }
    // infinity, through the exponent
    if bits_of(1e99999) != 9218868437227405312 {
        return 4
    }
    // an exponent that no longer fits into an i32
    if bits_of(1e2147483647) != 9218868437227405312 {
        return 5
    }
    // and one that no longer fits into an i64
    if bits_of(1e9223372036854775807) != 9218868437227405312 {
        return 6
    }
    // zero
    if bits_of(1e-99999) != 0 {
        return 7
    }
    // zero
    if bits_of(1e-9223372036854775807) != 0 {
        return 8
    }
    // zero stays zero, whatever the exponent says
    if bits_of(0e999999) != 0 {
        return 9
    }
    if bits_of(0e-999999) != 0 {
        return 10
    }
    if bits_of(0.0e-400) != 0 {
        return 11
    }
    // 2^128, exactly representable
    if bits_of(340282366920938463463374607431768211456.0) != 5183643171103440896 {
        return 12
    }
    // 2^64-1 rounds up to 2^64
    if bits_of(18446744073709551615.0) != 4895412794951729152 {
        return 13
    }
    // 2^53 itself
    if bits_of(9007199254740992.0) != 4845873199050653696 {
        return 14
    }
    // the largest power of ten that is exactly representable
    if bits_of(1e22) != 4936209963552724370 {
        return 15
    }
    if bits_of(1e-22) != 4277919505920253670 {
        return 16
    }
    // above the fast path
    if bits_of(1e37) != 5160588303184390427 {
        return 17
    }
    // the capital E is the same thing
    if bits_of(1E38) != 5175426328141668785 {
        return 18
    }
    return 0
}
