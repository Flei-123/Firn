// expect_out: ok
// tests/3711_jtext.fi -- plat.android.jtext: UTF-8 <-> UTF-16 for JNI strings (emoji = surrogate pair), caps,
// invalid input becomes U+FFFD. Cross-check against Python codecs: tools/android/pcmwav_cross/run.sh.
import std.io
import plat.android.jtext

fn main() -> i32 {
    // "aä€😀" = 61 | C3 A4 | E2 82 AC | F0 9F 98 80
    var s: [u8; 10] = [97 as u8, 195 as u8, 164 as u8, 226 as u8, 130 as u8, 172 as u8, 240 as u8, 159 as u8, 152 as u8, 128 as u8]
    let sp: u64 = (&s[0]) as u64
    if jtext.utf8_units(sp, 10) != 5 { io.print("units"); return 1 }
    var u: [u16; 12] = [0 as u16; 12]
    let up: u64 = (&u[0]) as u64
    if jtext.utf8_to_units(sp, 10, up, 12) != 5 { io.print("conv"); return 2 }
    if u[0] != 97 as u16 || u[1] != 228 as u16 || u[2] != 8364 as u16 || u[3] != 55357 as u16 || u[4] != 56832 as u16 { io.print("values"); return 3 }
    // a pair is never split by a small capacity
    if jtext.utf8_to_units(sp, 10, up, 4) != 3 { io.print("cap pair"); return 4 }
    if jtext.units_utf8_len(up, 5) != 10 { io.print("back len"); return 5 }
    var b: [u8; 10] = [0 as u8; 10]
    if jtext.units_to_utf8(up, 5, (&b[0]) as u64, 10) != 10 { io.print("back"); return 6 }
    var i: usize = 0
    while i < 10 { if b[i] != s[i] { io.print("roundtrip"); return 7 }; i = i + 1 }
    if jtext.units_to_utf8(up, 5, (&b[0]) as u64, 9) != 6 { io.print("cap char"); return 8 }
    // invalid: lone continuation, truncated 3-octet sequence, overlong C0 80, surrogate ED A0 80
    var bad: [u8; 9] = [128 as u8, 226 as u8, 130 as u8, 192 as u8, 128 as u8, 237 as u8, 160 as u8, 128 as u8, 65 as u8]
    let n: usize = jtext.utf8_to_units((&bad[0]) as u64, 9, up, 12)
    if n != 9 || u[0] != 65533 as u16 || u[8] != 65 as u16 { io.print("invalid"); return 9 }
    // lone surrogates in UTF-16
    u[0] = 55357 as u16
    u[1] = 65 as u16
    u[2] = 56832 as u16
    if jtext.units_to_utf8(up, 3, (&b[0]) as u64, 10) != 7 { io.print("lone"); return 10 }
    if jtext.utf8_units(sp, 0) != 0 || jtext.units_to_utf8(up, 0, (&b[0]) as u64, 10) != 0 { io.print("empty"); return 11 }
    io.print("ok")
    return 0
}
