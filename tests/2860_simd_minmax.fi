// expect_exit: 0
// tests/2860_simd_minmax.fi -- v128 intrinsics of graphics stack way E: min/max/div f32, min/max u8,
// saturating add/sub u8, 32-bit multiply. Every lane is compared with a scalar reference on random data.
import std.rt

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn rnd(seed: u64) -> u64 {
    return (seed * 1664525 as u64 + 1013904223 as u64) & 0xFFFFFFFF as u64
}

fn fval(seed: u64) -> f32 {
    // range -100 .. 100, never NaN, never exactly zero
    let v: i32 = (((seed >> 8 as u64) & 0xFFFF as u64) as i32) - 32768
    return ((v * 2 + 1) as f32) / (655.36 as f32)
}

fn main() -> i32 {
    let a: u64 = rt.heap_alloc(4096)
    let b: u64 = rt.heap_alloc(4096)
    let o: u64 = rt.heap_alloc(4096)
    var seed: u64 = 12345 as u64
    var round: i32 = 0
    var lanes: i32 = 0
    while round < 200 {
        // 64 floats in a and b
        var i: usize = 0
        while i < 64 {
            seed = rnd(seed)
            *((a + (i * 4) as u64) as *mut f32) = fval(seed)
            seed = rnd(seed)
            *((b + (i * 4) as u64) as *mut f32) = fval(seed)
            i = i + 1
        }
        // f32: min / max / div
        i = 0
        while i + 4 <= 64 {
            let off: u64 = (i * 4) as u64
            let va: v128 = __v128_load((a + off) as *u8)
            let vb: v128 = __v128_load((b + off) as *u8)
            __v128_store((o + off) as *mut u8, __v128_minf32(va, vb))
            __v128_store((o + 512 + off) as *mut u8, __v128_maxf32(va, vb))
            __v128_store((o + 1024 + off) as *mut u8, __v128_divf32(va, vb))
            i = i + 4
        }
        i = 0
        while i < 64 {
            let x: f32 = *((a + (i * 4) as u64) as *mut f32)
            let y: f32 = *((b + (i * 4) as u64) as *mut f32)
            var mn: f32 = y
            if x < y { mn = x }
            var mx: f32 = y
            if x > y { mx = x }
            check(*((o + (i * 4) as u64) as *mut f32) == mn, 1)
            check(*((o + 512 + (i * 4) as u64) as *mut f32) == mx, 2)
            check(*((o + 1024 + (i * 4) as u64) as *mut f32) == x / y, 3)
            i = i + 1
        }
        // bytes: 64 random octets in a and b (overwrites the floats)
        i = 0
        while i < 64 {
            seed = rnd(seed)
            *((a + i as u64) as *mut u8) = ((seed >> 8 as u64) & 255 as u64) as u8
            seed = rnd(seed)
            *((b + i as u64) as *mut u8) = ((seed >> 8 as u64) & 255 as u64) as u8
            i = i + 1
        }
        i = 0
        while i + 16 <= 64 {
            let off: u64 = i as u64
            let va: v128 = __v128_load((a + off) as *u8)
            let vb: v128 = __v128_load((b + off) as *u8)
            __v128_store((o + off) as *mut u8, __v128_minu8(va, vb))
            __v128_store((o + 128 + off) as *mut u8, __v128_maxu8(va, vb))
            __v128_store((o + 256 + off) as *mut u8, __v128_addsat_u8(va, vb))
            __v128_store((o + 384 + off) as *mut u8, __v128_subsat_u8(va, vb))
            i = i + 16
        }
        i = 0
        while i < 64 {
            let x: u32 = (*((a + i as u64) as *mut u8)) as u32
            let y: u32 = (*((b + i as u64) as *mut u8)) as u32
            var mn: u32 = y
            if x < y { mn = x }
            var mx: u32 = x
            if y > x { mx = y }
            var sa: u32 = x + y
            if sa > 255 as u32 { sa = 255 as u32 }
            var ss: u32 = 0 as u32
            if x > y { ss = x - y }
            check((*((o + i as u64) as *mut u8)) as u32 == mn, 4)
            check((*((o + 128 + i as u64) as *mut u8)) as u32 == mx, 5)
            check((*((o + 256 + i as u64) as *mut u8)) as u32 == sa, 6)
            check((*((o + 384 + i as u64) as *mut u8)) as u32 == ss, 7)
            i = i + 1
        }
        // u32 multiply, low half (wraps): compare through u64 arithmetic
        i = 0
        while i < 16 {
            seed = rnd(seed)
            *((a + (i * 4) as u64) as *mut u32) = seed as u32
            seed = rnd(seed)
            *((b + (i * 4) as u64) as *mut u32) = seed as u32
            i = i + 1
        }
        i = 0
        while i + 4 <= 16 {
            let off: u64 = (i * 4) as u64
            let va: v128 = __v128_load((a + off) as *u8)
            let vb: v128 = __v128_load((b + off) as *u8)
            __v128_store((o + off) as *mut u8, __v128_mullo32(va, vb))
            i = i + 4
        }
        i = 0
        while i < 16 {
            let x: u64 = (*((a + (i * 4) as u64) as *mut u32)) as u64
            let y: u64 = (*((b + (i * 4) as u64) as *mut u32)) as u64
            let want: u64 = (x * y) & 0xFFFFFFFF as u64
            check((*((o + (i * 4) as u64) as *mut u32)) as u64 == want, 8)
            lanes = lanes + 1
            i = i + 1
        }
        round = round + 1
    }
    check(lanes == 3200, 9)
    // NaN-free hand values
    let h1: v128 = __v128_from_u64(0x4000000040a00000 as u64, 0x3f800000c0000000 as u64)
    let h2: v128 = __v128_from_u64(0x40400000bf800000 as u64, 0x4000000040400000 as u64)
    let mx: v128 = __v128_maxf32(h1, h2)
    check(__v128_get_u64(mx, 0) == 0x4040000040a00000 as u64, 10)
    return 0
}
