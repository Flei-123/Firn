// expect_exit: 0
// tests/2650_mc_schema_basic.fi -- mc_schema (the runtime walker over the generated packet
// schemas) and the version objects, hand-made vectors, no node needed. The big conformance
// run against the reference serializer, for every game version, is tools/mc/schema/run.sh.
import std.rt
import std.bytes
import mc.mc_schema
import mc.mc_version
import mc.mc_sem
import mc.mc_versions
import mc.v763.mc_proto_v763
import mc.v340.mc_proto_v340

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    // keep alive: one i64
    let ka: u64 = mc_proto_v763.packet_schema(mc_version.ST_PLAY, mc_version.DIR_S2C, mc_proto_v763.PLAY_S2C_KEEP_ALIVE)
    check(ka != 0, 1)
    bytes.put_i64(&b, 77)
    check(mc_schema.walk(ka, &b, 0 as *mut rt.Buf), 2)
    check(bytes.bytes_remaining(&b) == 0, 3)
    // one octet too many / too few
    bytes.bytes_clear(&b)
    bytes.put_i64(&b, 77)
    bytes.put_u8(&b, 0)
    check(!mc_schema.walk(ka, &b, 0 as *mut rt.Buf), 4)
    check(bytes.bytes_pos(&b) == 0, 5)
    check(mc_schema.walk_prefix(ka, &b, 0 as *mut rt.Buf), 6)
    check(bytes.bytes_pos(&b) == 8, 7)
    bytes.bytes_clear(&b)
    bytes.put_u32(&b, 1)
    check(!mc_schema.walk(ka, &b, 0 as *mut rt.Buf), 8)

    // names
    let nm: u64 = mc_proto_v763.packet_name(mc_version.ST_PLAY, mc_version.DIR_S2C, mc_proto_v763.PLAY_S2C_MAP_CHUNK)
    check(nm != 0, 9)
    check(rt.c_length(nm) == 9, 10)
    check(mc_proto_v763.packet_name(mc_version.ST_PLAY, mc_version.DIR_S2C, 4000) == 0, 11)
    check(mc_proto_v763.packet_schema(mc_version.ST_PLAY, mc_version.DIR_S2C, -1) == 0, 12)
    check(mc_proto_v763.PROTOCOL_VERSION == 763, 13)

    // a hostile array count: spawn_entity-like packets cannot be tricked into reading; use
    // declare_commands (array of nodes) with count 2^31-1 and nothing behind it
    let dc: u64 = mc_proto_v763.packet_schema(mc_version.ST_PLAY, mc_version.DIR_S2C, mc_proto_v763.PLAY_S2C_DECLARE_COMMANDS)
    check(dc != 0, 14)
    bytes.bytes_clear(&b)
    bytes.put_varint(&b, 2147483647)
    check(!mc_schema.walk(dc, &b, 0 as *mut rt.Buf), 15)

    // a varint of six octets is refused
    bytes.bytes_clear(&b)
    bytes.put_u8(&b, 255)
    bytes.put_u8(&b, 255)
    bytes.put_u8(&b, 255)
    bytes.put_u8(&b, 255)
    bytes.put_u8(&b, 255)
    bytes.put_u8(&b, 1)
    let sp: u64 = mc_proto_v763.packet_schema(mc_version.ST_LOGIN, mc_version.DIR_S2C, mc_proto_v763.LOGIN_S2C_COMPRESS)
    check(sp != 0, 16)
    check(!mc_schema.walk(sp, &b, 0 as *mut rt.Buf), 17)

    // field_range: update_time = two i64; "time" is the second
    let ut: u64 = mc_proto_v763.packet_schema(mc_version.ST_PLAY, mc_version.DIR_S2C, mc_proto_v763.PLAY_S2C_UPDATE_TIME)
    check(ut != 0, 18)
    bytes.bytes_clear(&b)
    bytes.put_i64(&b, 1)
    bytes.put_i64(&b, 2)
    var off: usize = 0
    var len: usize = 0
    var nameb: [u8; 4] = "time"
    check(mc_schema.field_range(ut, (&nameb[0]) as u64, 4, &b, &off, &len), 19)
    check(off == 8 && len == 8, 20)
    var nameb2: [u8; 4] = "nope"
    check(!mc_schema.field_range(ut, (&nameb2[0]) as u64, 4, &b, &off, &len), 21)

    // the dump: "path=value" lines
    var o: rt.Buf = rt.buf_new()
    bytes.bytes_reset(&b)
    check(mc_schema.walk(ut, &b, &o), 22)
    check(rt.buf_len(&o) > 0, 23)
    check(rt.buf_at(&o, 0) == 97, 24) // starts with "age=" (worldAge)
    bytes.bytes_free(&b)
    rt.buf_free(&o)

    // ---- the version objects (one binary, several versions chosen at run time)
    var v763: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v763), 30)
    check(v763.protocol == 763, 31)
    check(v763.chunk_format == mc_version.CF_CONTAINERS_118, 32)
    check(!mc_version.version_has(&v763, mc_version.FLAG_CONFIG_PHASE), 33)
    check(mc_version.version_has(&v763, mc_version.FLAG_PALETTE_CHUNKS), 34)
    check(mc_version.version_pid(&v763, mc_sem.SEM_PLAY_S2C_MAP_CHUNK) == mc_proto_v763.PLAY_S2C_MAP_CHUNK, 35)
    check(mc_version.version_pid(&v763, mc_sem.SEM_PLAY_S2C_KEEP_ALIVE) == mc_proto_v763.PLAY_S2C_KEEP_ALIVE, 36)
    check(mc_version.version_pid(&v763, mc_sem.SEM_CONFIG_S2C_FINISH) == 0 - 1, 37) // no configuration phase in 1.20.1
    let nm2: u64 = v763.name_of(mc_version.ST_PLAY, mc_version.DIR_S2C, mc_version.version_pid(&v763, mc_sem.SEM_PLAY_S2C_MAP_CHUNK))
    check(nm2 != 0 && rt.c_length(nm2) == 9, 38)

    var v340: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(340, &v340), 40)
    check(v340.chunk_format == mc_version.CF_SECTIONS_19, 41)
    check(!mc_version.version_has(&v340, mc_version.FLAG_FLATTENING), 42)
    check(mc_version.version_pid(&v340, mc_sem.SEM_PLAY_S2C_MAP_CHUNK) == mc_proto_v340.PLAY_S2C_MAP_CHUNK, 43)
    check(mc_version.version_pid(&v340, mc_sem.SEM_PLAY_S2C_UNLOAD_CHUNK) >= 0, 44)
    check(mc_version.version_pid(&v340, mc_sem.SEM_PLAY_S2C_MAP_CHUNK) != mc_version.version_pid(&v763, mc_sem.SEM_PLAY_S2C_MAP_CHUNK), 45)

    var v764: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(764, &v764), 50)
    check(mc_version.version_has(&v764, mc_version.FLAG_CONFIG_PHASE), 51)
    check(mc_version.version_pid(&v764, mc_sem.SEM_CONFIG_S2C_FINISH) >= 0, 52)
    check(mc_version.version_pid(&v764, mc_sem.SEM_LOGIN_C2S_LOGIN_ACKNOWLEDGED) >= 0, 53)

    var vx: mc_version.Version = mc_version.version_empty()
    check(!mc_versions.version_by_protocol(12345, &vx), 60) // unknown protocol numbers are refused
    return 0
}
