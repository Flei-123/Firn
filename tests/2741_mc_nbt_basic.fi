// expect_exit: 0
// tests/2741_mc_nbt_basic.fi -- mc_nbt: tree getters, byte identical write-back, SNBT, hostile input.
// The comparison with prismarine-nbt (60 random trees, both root forms) is tools/mc/nbt/run.sh.
import std.rt
import std.bytes
import std.nbt
import mc.mc_nbt

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn sample(b: *mut bytes.Bytes, anon: bool) {
    if anon {
        nbt.nbt_root_begin_anon(b)
    } else {
        nbt.nbt_root_begin(b, "root".p as u64, 4)
    }
    nbt.nbt_int(b, "answer".p as u64, 6, 42)
    nbt.nbt_string(b, "text".p as u64, 4, "hi \"you\"".p as u64, 8)
    nbt.nbt_byte(b, "flag".p as u64, 4, 0 - 1 as i8)
    nbt.nbt_long(b, "big".p as u64, 3, 0 - 9000000000)
    nbt.nbt_list_open(b, "xs".p as u64, 2, 3 as u8, 3)
    bytes.put_i32(b, 10)
    bytes.put_i32(b, 20)
    bytes.put_i32(b, 30)
    nbt.nbt_compound_begin(b, "inner".p as u64, 5)
    nbt.nbt_short(b, "s".p as u64, 1, 7 as i16)
    nbt.nbt_end(b)
    var longs: [i64; 2] = [1, 0 - 2]
    nbt.nbt_long_array(b, "la".p as u64, 2, (&longs[0]) as u64, 2)
    nbt.nbt_end(b)
}

fn view(b: *mut bytes.Bytes) -> bytes.Bytes {
    return bytes.Bytes { data: bytes.bytes_ptr(b), cap: bytes.bytes_len(b), len: bytes.bytes_len(b), pos: 0, bad: false }
}

fn main() -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    sample(&b, false)
    var v: bytes.Bytes = view(&b)
    var d: mc_nbt.Doc = mc_nbt.doc_new()
    check(mc_nbt.doc_parse(&d, &v, false, true) catch false, 1)
    var rn: usize = 0
    let rp: u64 = mc_nbt.doc_root_name(&d, &rn)
    check(rn == 4 && rt.mem_eq(rp, "root".p as u64, 4), 2)
    let root: u32 = mc_nbt.doc_root(&d)
    let a: u32 = mc_nbt.nbt_get(&d, root, "answer".p as u64, 6)
    check(a != 0 as u32 && mc_nbt.nbt_kind(&d, a) == nbt.TAG_INT && mc_nbt.nbt_i64(&d, a) == 42, 3)
    check(mc_nbt.nbt_get(&d, root, "nope".p as u64, 4) == 0 as u32, 4)
    let t: u32 = mc_nbt.nbt_get(&d, root, "text".p as u64, 4)
    var tl: usize = 0
    let tp: u64 = mc_nbt.nbt_str(&d, t, &tl)
    check(tl == 8 && rt.mem_eq(tp, "hi \"you\"".p as u64, 8), 5)
    check(mc_nbt.nbt_i64(&d, mc_nbt.nbt_get(&d, root, "flag".p as u64, 4)) == 0 - 1, 6)
    check(mc_nbt.nbt_i64(&d, mc_nbt.nbt_get(&d, root, "big".p as u64, 3)) == 0 - 9000000000, 7)
    let xs: u32 = mc_nbt.nbt_get(&d, root, "xs".p as u64, 2)
    check(mc_nbt.nbt_count(&d, xs) == 3 && mc_nbt.nbt_elem_kind(&d, xs) == nbt.TAG_INT, 8)
    check(mc_nbt.nbt_i64(&d, mc_nbt.nbt_at(&d, xs, 2 as u32)) == 30, 9)
    check(mc_nbt.nbt_at(&d, xs, 3 as u32) == 0 as u32, 10)
    let inner: u32 = mc_nbt.nbt_get(&d, root, "inner".p as u64, 5)
    check(mc_nbt.nbt_i64(&d, mc_nbt.nbt_get(&d, inner, "s".p as u64, 1)) == 7, 11)
    let la: u32 = mc_nbt.nbt_get(&d, root, "la".p as u64, 2)
    check(mc_nbt.nbt_count(&d, la) == 2 && mc_nbt.nbt_arr_i64(&d, la, 1 as u32) == 0 - 2, 12)
    // write back: byte identical
    var w: bytes.Bytes = bytes.bytes_new()
    mc_nbt.doc_write(&d, &w)
    check(bytes.bytes_len(&w) == bytes.bytes_len(&b) && rt.mem_eq(bytes.bytes_ptr(&w), bytes.bytes_ptr(&b), bytes.bytes_len(&b)), 13)
    // SNBT
    var s: rt.Buf = rt.buf_new()
    mc_nbt.doc_snbt(&d, &s)
    check(rt.buf_len(&s) > 40 && rt.buf_at(&s, 0) == 123 as u8, 14)
    rt.buf_free(&s)
    bytes.bytes_free(&w)
    mc_nbt.doc_free(&d)

    // the nameless root of 1.20.2+
    var ba: bytes.Bytes = bytes.bytes_new()
    sample(&ba, true)
    var va: bytes.Bytes = view(&ba)
    var da: mc_nbt.Doc = mc_nbt.doc_new()
    check(mc_nbt.doc_parse(&da, &va, true, true) catch false, 20)
    check(mc_nbt.nbt_i64(&da, mc_nbt.nbt_get(&da, mc_nbt.doc_root(&da), "answer".p as u64, 6)) == 42, 21)
    var wa: bytes.Bytes = bytes.bytes_new()
    mc_nbt.doc_write(&da, &wa)
    check(bytes.bytes_len(&wa) == bytes.bytes_len(&ba) && rt.mem_eq(bytes.bytes_ptr(&wa), bytes.bytes_ptr(&ba), bytes.bytes_len(&ba)), 22)
    // reading the nameless form as named must NOT work silently
    var vb: bytes.Bytes = view(&ba)
    var db: mc_nbt.Doc = mc_nbt.doc_new()
    check(!(mc_nbt.doc_parse(&db, &vb, false, true) catch false), 23)
    mc_nbt.doc_free(&db)
    mc_nbt.doc_free(&da)
    bytes.bytes_free(&wa)
    bytes.bytes_free(&ba)

    // trailing octets: an error only in strict mode
    bytes.put_u8(&b, 99 as u8)
    var vt: bytes.Bytes = view(&b)
    var dt: mc_nbt.Doc = mc_nbt.doc_new()
    check(!(mc_nbt.doc_parse(&dt, &vt, false, true) catch false), 24)
    var vt2: bytes.Bytes = view(&b)
    check(mc_nbt.doc_parse(&dt, &vt2, false, false) catch false, 25)
    mc_nbt.doc_free(&dt)

    // hostile: a root that is not a compound, a depth bomb, a list count bomb, every truncation
    var h: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&h, 3 as u8)
    var vh: bytes.Bytes = view(&h)
    var dh: mc_nbt.Doc = mc_nbt.doc_new()
    check(!(mc_nbt.doc_parse(&dh, &vh, true, false) catch false), 30)
    var deep: bytes.Bytes = bytes.bytes_new()
    nbt.nbt_root_begin_anon(&deep)
    var i: i32 = 0
    while i < 3000 {
        nbt.nbt_compound_begin(&deep, "a".p as u64, 1)
        i = i + 1
    }
    var vd: bytes.Bytes = view(&deep)
    check(!(mc_nbt.doc_parse(&dh, &vd, true, false) catch false), 31)
    var bomb: bytes.Bytes = bytes.bytes_new()
    nbt.nbt_root_begin_anon(&bomb)
    nbt.nbt_list_open(&bomb, "l".p as u64, 1, 10 as u8, 2147483647)
    var vbm: bytes.Bytes = view(&bomb)
    check(!(mc_nbt.doc_parse(&dh, &vbm, true, false) catch false), 32)
    var bomb2: bytes.Bytes = bytes.bytes_new()
    nbt.nbt_root_begin_anon(&bomb2)
    nbt.nbt_c_long_array(&bomb2, "l".p as u64, 0, 0)
    bytes.put_i32(&bomb2, 0 - 5)
    var vbm2: bytes.Bytes = view(&bomb2)
    check(!(mc_nbt.doc_parse(&dh, &vbm2, true, false) catch false), 33)
    var n: usize = 0
    sample(&ba, true)
    let total: usize = bytes.bytes_len(&ba)
    while n < total {
        var vc: bytes.Bytes = bytes.Bytes { data: bytes.bytes_ptr(&ba), cap: n, len: n, pos: 0, bad: false }
        check(!(mc_nbt.doc_parse(&dh, &vc, true, false) catch false), 34)
        n = n + 1
    }
    mc_nbt.doc_free(&dh)
    bytes.bytes_free(&ba)
    bytes.bytes_free(&h)
    bytes.bytes_free(&deep)
    bytes.bytes_free(&bomb)
    bytes.bytes_free(&bomb2)
    bytes.bytes_free(&b)
    return 0
}
