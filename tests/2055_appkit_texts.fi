// expect_exit: 0
// tests/2055_appkit_i18n.fi -- lib/appkit/texts.fi: appkit's own English and
// German texts, a program's catalog on top, fallback to English and to the
// key, arguments, plurals, switching the language.
import std.rt
import appkit.texts
import appkit.util

const APP_EN: str = "@lang en\nfiles[one] = {count:number} file\nfiles[other] = {count:number} files\nhello = Hello {who}\nonly-en = English only\n"
const APP_DE: str = "@lang de\nfiles[one] = {count:number} Datei\nfiles[other] = {count:number} Dateien\nhello = Hallo {who}\n"

fn main() -> i32 {
    if !texts.tr_register("en", APP_EN) { return 1 }
    if !texts.tr_register("de", APP_DE) { return 2 }
    // too short / too long codes are refused
    if texts.tr_register("e", APP_EN) { return 3 }
    if texts.tr_register("abcdefgh", APP_EN) { return 4 }

    // German: appkit's text and the program's
    if !texts.tr_select("de") { return 10 }
    if texts.tr_lang() != "de" { return 11 }
    if texts.tr("update.check") != "Nach Updates suchen" { return 12 }
    if texts.tr1("hello", "who", "Welt") != "Hallo Welt" { return 13 }
    if texts.trn("files", "count", 1.0) != "1 Datei" { return 14 }
    if texts.trn("files", "count", 3.0) != "3 Dateien" { return 15 }
    // a key only English has: the English text
    if texts.tr("only-en") != "English only" { return 16 }
    // a key nobody has: the key
    if texts.tr("no.such.key") != "no.such.key" { return 17 }
    if texts.tr1("update.available", "version", "2.0.1") != "Version 2.0.1 ist verfügbar." { return 18 }

    // English
    if !texts.tr_select("en") { return 20 }
    if texts.tr("update.check") != "Check for updates" { return 21 }
    if texts.trn("files", "count", 1.0) != "1 file" { return 22 }
    if texts.trn("files", "count", 2.0) != "2 files" { return 23 }

    // a language without a catalog -> English
    if !texts.tr_select("fr") { return 30 }
    if texts.tr_lang() != "en" { return 31 }
    if texts.tr("update.check") != "Check for updates" { return 32 }
    // a regional code is cut to two letters
    if !texts.tr_select("de-AT") { return 33 }
    if texts.tr_lang() != "de" { return 34 }
    // back and forth many times (the bundle is rebuilt, not leaked)
    var k: usize = 0
    while k < 200 {
        texts.tr_select("en")
        texts.tr_select("de")
        k = k + 1
    }
    if texts.tr("settings.title") != "Einstellungen" { return 40 }
    return 0
}
