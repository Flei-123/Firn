// expect_exit: 0
// Protocol 777 (26.3) client tables through the selectors: break times and harvest rules (mc_dig_sel) and crafting predictions
// (mc_craft_sel, recipes from the server jar with item tags expanded). Return codes: 1xx = table/registry missing, 2xx = dig, 3xx = craft.
import std.rt
import mc.mc_registry
import mc.mc_dig
import mc.mc_dig_sel
import mc.mc_craft
import mc.mc_craft_sel
import mc.v777.mc_reg_v777

fn item(r: *mut mc_registry.Registry, name: str) -> i32 { return mc_registry.reg_item_by_name(r, name.p as u64, name.n) }

fn ticks(r: *mut mc_registry.Registry, d: *mut mc_dig.DigData, blk: str, tool: str) -> i32 {
    let b: i32 = mc_registry.reg_block_by_name(r, blk.p as u64, blk.n)
    if b < 0 { return 0 - 99 }
    var it: i32 = 0 - 1
    if tool.n > 0 { it = item(r, tool) }
    return mc_dig.dig_ticks(d, b, mc_registry.reg_block_hardness_milli(r, b), it, 0, true, false)
}

fn grid4(a: u32, b: u32, c: u32, d: u32) -> u64 {
    let g: u64 = rt.heap_alloc(16)
    rt.st32(g, 0, a)
    rt.st32(g, 1, b)
    rt.st32(g, 2, c)
    rt.st32(g, 3, d)
    return g
}

fn craft_result(rcp: *mut mc_craft.Recipes, g: u64, cnt: *mut i32) -> i32 {
    let r: i32 = mc_craft.craft_match(rcp, g, 2, cnt)
    rt.heap_free(g, 16)
    return r
}

fn main() -> i32 {
    var r: mc_registry.Registry = mc_reg_v777.registry_make()
    if !mc_registry.registry_ok(&r) { return 100 }
    var d: mc_dig.DigData = mc_dig_sel.dig_for_protocol(777)
    if !mc_dig.dig_ok(&d) { return 101 }
    if ticks(&r, &d, "stone", "") != 150 { return 200 }
    if ticks(&r, &d, "stone", "iron_pickaxe") != 8 { return 201 }
    if ticks(&r, &d, "dirt", "iron_shovel") != 3 { return 202 }
    if ticks(&r, &d, "oak_log", "iron_axe") != 10 { return 203 }
    if ticks(&r, &d, "bedrock", "diamond_pickaxe") != 0 - 1 { return 204 }
    if mc_dig.dig_can_harvest(&d, mc_registry.reg_block_by_name(&r, "iron_ore".p as u64, 8), item(&r, "wooden_pickaxe")) { return 205 }
    if !mc_dig.dig_can_harvest(&d, mc_registry.reg_block_by_name(&r, "iron_ore".p as u64, 8), item(&r, "stone_pickaxe")) { return 206 }
    var rcp: mc_craft.Recipes = mc_craft_sel.recipes_for_protocol(777)
    if !mc_craft.craft_ok(&rcp) { return 102 }
    let log: i32 = item(&r, "oak_log")
    let planks: i32 = item(&r, "oak_planks")
    let birch: i32 = item(&r, "birch_planks")
    let table: i32 = item(&r, "crafting_table")
    var cnt: i32 = 0
    if craft_result(&rcp, grid4((log + 1) as u32, 0 as u32, 0 as u32, 0 as u32), &cnt) != planks || cnt != 4 { return 300 }
    let p: u32 = (planks + 1) as u32
    if craft_result(&rcp, grid4(p, p, p, p), &cnt) != table || cnt != 1 { return 301 }
    let b: u32 = (birch + 1) as u32
    if craft_result(&rcp, grid4(b, b, b, b), &cnt) != table { return 302 }
    if craft_result(&rcp, grid4(p, p, p, 0 as u32), &cnt) >= 0 { return 303 }
    return 0
}
