import jxl.jxl
import std.fs
import std.math
import std.rt

static mut failures: i32 = 0
static mut last_psnr: f64 = 0.0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn body_offset(d: *mut rt.Buf, n: usize, lines: u32) -> usize {
    var nl: u32 = 0
    var i: usize = 0
    while i < n && nl < lines {
        if rt.ld8(rt.buf_ptr(d), i) == 10 {
            nl = nl + 1
        }
        i = i + 1
    }
    return i
}

fn sample_at(p: u64, i: usize, bps: usize, big: bool) -> f64 {
    if bps == 1 {
        return rt.ld8(p, i) as f64
    }
    let a: u32 = rt.ld8(p, i * 2) as u32
    let b: u32 = rt.ld8(p, i * 2 + 1) as u32
    if big {
        return (a * 256 + b) as f64
    }
    return (b * 256 + a) as f64
}

fn expect(path: str, ref_path: str, ref_lines: u32, peak: f64, bps: usize, channels: u32, min_psnr: f64) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    var ref: rt.Buf = rt.buf_new()
    let rn: usize = fs.read_file(ref_path, &ref) catch 0
    check(n != 0 && rn != 0)
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let ok: bool = jxl.jxl_decode(rt.buf_ptr(&data), n, &pic) catch false
    check(ok)
    if ok {
        check(pic.channels == channels && pic.bytes_per_sample == bps as u32)
        let total: usize = (pic.width as usize) * (pic.height as usize) * (channels as usize)
        check(pic.size == total * bps)
        let base: u64 = rt.buf_ptr(&ref) + (body_offset(&ref, rn, ref_lines) as u64)
        if pic.size == total * bps && rn >= body_offset(&ref, rn, ref_lines) + total * bps {
            var sum: f64 = 0.0
            var i: usize = 0
            while i < total {
                let e: f64 = sample_at(pic.data, i, bps, false) - sample_at(base, i, bps, bps == 2)
                sum = sum + e * e
                i = i + 1
            }
            var p: f64 = 99.0
            if sum > 0.0 {
                p = 10.0 * math.log10(peak * peak * (total as f64) / sum)
            }
            last_psnr = p
            check(p >= min_psnr)
        } else {
            check(false)
        }
    }
    jxl.jxl_picture_free(&pic)
    rt.buf_free(&data)
    rt.buf_free(&ref)
}

fn main() -> i32 {
    expect("tests/data/jxl/ecup/rgba300_vd_r2.jxl", "tests/data/jxl/ecup/rgba300_vd_r2.pam", 7, 255.0, 1, 4, 45.0)
    expect("tests/data/jxl/ecup/rgba300_md_r2.jxl", "tests/data/jxl/ecup/rgba300_md_r2.pam", 7, 255.0, 1, 4, 45.0)
    expect("tests/data/jxl/ecup/rgba300_vd_r4.jxl", "tests/data/jxl/ecup/rgba300_vd_r4.pam", 7, 255.0, 1, 4, 45.0)
    expect("tests/data/jxl/ecup/rgba300_md_r4.jxl", "tests/data/jxl/ecup/rgba300_md_r4.pam", 7, 255.0, 1, 4, 45.0)
    expect("tests/data/jxl/ecup/rgba300_vd_r8.jxl", "tests/data/jxl/ecup/rgba300_vd_r8.pam", 7, 255.0, 1, 4, 45.0)
    expect("tests/data/jxl/ecup/rgba300_md_r8.jxl", "tests/data/jxl/ecup/rgba300_md_r8.pam", 7, 255.0, 1, 4, 45.0)
    expect("tests/data/jxl/ecup/rgba64_vd_r2.jxl", "tests/data/jxl/ecup/rgba64_vd_r2.pam", 7, 255.0, 1, 4, 45.0)
    return failures
}
