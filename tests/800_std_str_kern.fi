// expect_out: Hallo | teile 3 woerter 3 pos 7 ersetzt 3 | Hallo-Welt-Firn | zeichen 7 oktette 11 ue 252 euro 8364 mitte 5 | ....FirnFirn.. | npos 1 kaputt 0
// tests/800_std_str_kern.fi — die Textarbeit von `std.str` (Runde 42).
//
// Geprueft wird die ganze Kette an EINEM Beispieltext: trimmen, teilen,
// verbinden, suchen, ersetzen, Gross/Klein, auffuellen, vergleichen — und
// danach UTF-8: dekodieren, vorwaerts und rueckwaerts laufen, nach ZEICHEN
// statt nach Oktetten schneiden.
//
// Jede Erwartung steht als `return <code>` im Programm: schlaegt eine fehl,
// endet der Test mit genau diesem Code, und test.sh nennt ihn. Die
// gedruckte Zeile ist zusaetzlich der Vergleichspunkt fuer
// tools/selbst_vergleich.sh — firnc0 und firnc1 muessen sie zeichengleich
// erzeugen.
import std.io
import std.str

fn zeig(b: *mut str.Bytes) {
    io.print((*b).ptr as u64, (*b).len)
}

fn main() -> i32 {
    var roh: [u8; 22] = "  Hallo, Welt, Firn  \0"
    var tr: [u8; 3] = ", \0"
    var strich: [u8; 2] = "-\0"
    var hallo: [u8; 6] = "Hallo\0"
    var firn: [u8; 5] = "Firn\0"
    var welt: [u8; 5] = "Welt\0"
    var kl_l: [u8; 2] = "l\0"
    var gr_l: [u8; 2] = "L\0"
    var leerz: [u8; 2] = " \0"

    let quelle: str.Spanne = str.spanne_von_c((&roh[0]) as *mut u8)
    let trenner: str.Spanne = str.spanne_von_c((&tr[0]) as *mut u8)
    let bindestrich: str.Spanne = str.spanne_von_c((&strich[0]) as *mut u8)

    if quelle.n != 21 {
        return 10
    }

    // --- trimmen
    let kern: str.Spanne = str.trimme(quelle)
    if kern.n != 17 {
        return 11
    }
    if str.trimme_links(quelle).n != 19 {
        return 12
    }
    if str.trimme_rechts(quelle).n != 19 {
        return 13
    }

    // --- teilen und wieder verbinden
    var teiler: str.Teiler = str.teiler_neu(kern, trenner)
    var stueck: str.Spanne = str.spanne_leer()
    var verbunden: str.Bytes = str.bytes_new()
    var teile: usize = 0
    while str.teiler_naechst(&teiler, &stueck) {
        teile = teile + 1
        str.verbinde_teil(&verbunden, stueck, bindestrich)
    }
    if teile != 3 {
        return 14
    }
    if str.teile_zaehle(kern, trenner) != 3 {
        return 15
    }
    if str.bytes_len(&verbunden) != 15 {
        return 16
    }

    // Leerraum-Teiler: dieselbe Quelle, aber Kommas bleiben am Wort haengen.
    var wt: str.Teiler = str.teiler_leerraum(quelle)
    var wort: str.Spanne = str.spanne_leer()
    var woerter: usize = 0
    while str.teiler_naechst(&wt, &wort) {
        woerter = woerter + 1
    }
    if woerter != 3 {
        return 17
    }

    // --- suchen
    if !str.beginnt_mit(kern, str.spanne_von_c((&hallo[0]) as *mut u8)) {
        return 20
    }
    if !str.endet_mit(kern, str.spanne_von_c((&firn[0]) as *mut u8)) {
        return 21
    }
    let pos_welt: usize = str.finde(kern, str.spanne_von_c((&welt[0]) as *mut u8))
    if pos_welt != 7 {
        return 22
    }
    if str.finde(kern, str.spanne_von_c((&strich[0]) as *mut u8)) != str.npos() {
        return 23
    }
    if str.finde_zeichen(kern, 44 as u8) != 5 {
        return 24
    }
    if str.finde_zeichen_rueck(kern, 44 as u8) != 11 {
        return 25
    }
    if str.zaehle_zeichen(kern, 44 as u8) != 2 {
        return 26
    }
    if str.zaehle_teil(quelle, str.spanne_von_c((&leerz[0]) as *mut u8)) != 6 {
        return 27
    }
    if !str.enthaelt(kern, str.spanne_von_c((&welt[0]) as *mut u8)) {
        return 28
    }
    if str.finde_rueck(kern, str.spanne_von_c((&firn[0]) as *mut u8)) != 13 {
        return 29
    }

    // --- ersetzen
    var ersetzt: str.Bytes = str.bytes_new()
    let wieoft: usize = str.ersetze(&ersetzt, kern,
        str.spanne_von_c((&kl_l[0]) as *mut u8),
        str.spanne_von_c((&gr_l[0]) as *mut u8))
    if wieoft != 3 {
        return 30
    }
    if str.bytes_len(&ersetzt) != 17 {
        return 31
    }
    if str.bytes_at(&ersetzt, 2) != 76 as u8 {
        return 32
    }
    if str.ersetze_zeichen_hier(&ersetzt, 76 as u8, 108 as u8) != 3 {
        return 33
    }

    // --- Gross und Klein
    var gross: str.Bytes = str.bytes_new()
    str.nach_gross(&gross, str.spanne_von_c((&hallo[0]) as *mut u8))
    if str.bytes_at(&gross, 1) != 65 as u8 {
        return 40
    }
    var klein: str.Bytes = str.bytes_new()
    str.nach_klein(&klein, str.spanne_von_bytes(&gross))
    if str.bytes_at(&klein, 0) != 104 as u8 {
        return 41
    }
    if !str.gleich_ohne_fall(str.spanne_von_bytes(&gross),
                             str.spanne_von_c((&hallo[0]) as *mut u8)) {
        return 42
    }
    if str.gleich(str.spanne_von_bytes(&gross),
                  str.spanne_von_c((&hallo[0]) as *mut u8)) {
        return 43
    }
    if str.vergleiche(str.spanne_von_c((&firn[0]) as *mut u8),
                      str.spanne_von_c((&welt[0]) as *mut u8)) != 0 - 1 {
        return 44
    }
    if str.vergleiche(kern, kern) != 0 {
        return 45
    }

    // --- auffuellen
    var breit: str.Bytes = str.bytes_new()
    str.fuelle_links(&breit, str.spanne_von_c((&firn[0]) as *mut u8), 8, 46 as u8)
    if str.bytes_len(&breit) != 8 {
        return 50
    }
    if str.bytes_at(&breit, 0) != 46 as u8 {
        return 51
    }
    str.fuelle_rechts(&breit, str.spanne_von_c((&firn[0]) as *mut u8), 6, 46 as u8)
    if str.bytes_len(&breit) != 14 {
        return 52
    }

    // --- Zeichenklassen
    if !str.ist_ziffer(55 as u8) || str.ist_ziffer(65 as u8) {
        return 55
    }
    if !str.ist_hexziffer(102 as u8) || str.hexwert(102 as u8) != 15 {
        return 56
    }
    if str.hexwert(122 as u8) != 0 - 1 {
        return 57
    }
    if str.gross_zeichen(122 as u8) != 90 as u8 {
        return 58
    }
    if !str.ist_leerraum(9 as u8) || str.ist_leerraum(48 as u8) {
        return 59
    }

    // --- UTF-8
    var uni: [u8; 12] = "Grüße €\0"
    let u: str.Spanne = str.spanne_von_c((&uni[0]) as *mut u8)
    if u.n != 11 {
        return 60
    }
    if str.utf8_zaehle(u) != 7 {
        return 61
    }
    if !str.utf8_is_valid(u.p, u.n) {
        return 62
    }
    let z_ue: str.Zeichenfund = str.utf8_lies(u, 2)
    if !z_ue.gueltig || z_ue.cp != 252 || z_ue.laenge != 2 {
        return 63
    }
    let z_eur: str.Zeichenfund = str.utf8_lies(u, 8)
    if !z_eur.gueltig || z_eur.cp != 8364 || z_eur.laenge != 3 {
        return 64
    }
    if str.utf8_naechst(u, 2) != 4 {
        return 65
    }
    if str.utf8_vorher(u, 8) != 7 {
        return 66
    }
    if str.utf8_ist_grenze(u, 3) {
        return 67
    }
    if !str.utf8_ist_grenze(u, 4) {
        return 68
    }
    // Zeichen 1..3 sind "rüß" — nach Oktetten waeren das 1..4.
    let mitte: str.Spanne = str.utf8_teil(u, 1, 3)
    if mitte.n != 5 {
        return 69
    }
    // Ungueltiges Oktett wird als EIN Zeichen gemeldet, damit jede Schleife
    // vorankommt.
    var kaputt: [u8; 3] = [97 as u8, 255 as u8, 98 as u8]
    let k: str.Spanne = str.spanne((&kaputt[0]) as *mut u8, 3)
    let zk: str.Zeichenfund = str.utf8_lies(k, 1)
    if zk.gueltig || zk.laenge != 1 || zk.cp != 65533 {
        return 70
    }
    if str.utf8_zaehle(k) != 3 {
        return 71
    }
    // Rueckweg: Codepunkt anhaengen und wieder lesen.
    var rund: str.Bytes = str.bytes_new()
    str.utf8_anhaengen(&rund, 8364)
    if str.bytes_len(&rund) != 3 {
        return 72
    }

    // BEFUND Runde 42 (benannt, nicht umgebaut): ein MODULQUALIFIZIERTER
    // Aufruf im Ausdruck eines f"..." kommt in den kanonischen Baeumen der
    // beiden Compiler verschieden heraus — firnc0 schreibt `str.npos`,
    // firnc1 den internen Namen `str__npos`. Das Verhalten ist gleich (der
    // Selbstvergleich ist GLEICH), aber tools/parser_vergleich.sh vergleicht
    // den Baum Oktett fuer Oktett. Deshalb stehen die Werte hier VOR der
    // Interpolation in einer Bindung. Siehe docs/RUNDE42.md, Abschnitt 5C.
    let zeichenzahl: usize = str.utf8_zaehle(u)
    let npos_ganz_gesetzt: bool = str.npos() == 0 - 1
    io.print((&roh[0]) as u64 + 2, 5)
    io.fmt_druck(f" | teile {teile} woerter {woerter} pos {pos_welt} ersetzt {wieoft} | ")
    zeig(&verbunden)
    io.fmt_druck(f" | zeichen {zeichenzahl} oktette {u.n} ue {z_ue.cp} euro {z_eur.cp} mitte {mitte.n} | ")
    zeig(&breit)
    io.fmt_druck(f" | npos {npos_ganz_gesetzt} kaputt {zk.gueltig}\n")

    str.bytes_free(&verbunden)
    str.bytes_free(&ersetzt)
    str.bytes_free(&gross)
    str.bytes_free(&klein)
    str.bytes_free(&breit)
    str.bytes_free(&rund)
    return 0
}
