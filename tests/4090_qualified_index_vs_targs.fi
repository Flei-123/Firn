// expect_exit: 0
// r729: `mod.TABLE[expr]` is an INDEX even when the next line starts with `(`;
// `mod.fn[T](..)` and `mod.Type[T]` still work.
import modules.qidx

// a local template also marks the file "not core" for the generics-free AST
// dump of parser_compare
fn local_id[T](a: T) -> T {
    return a
}

struct Box { n: u32 }

fn main() -> i32 {
    var b: [u32; 2] = [0 as u32; 2]
    var bx: Box = Box { n: 0 as u32 }
    let pb: *mut Box = &bx
    let d: u32 = 2 as u32
    let i: usize = 1 as usize
    // a cast inside the brackets, the next line begins with `(`
    b[0] = qidx.TABLE[d as usize]
    (*pb).n = 5 as u32
    if b[0] != 30 as u32 {
        return 1 as i32
    }
    // plain identifier, literal, arithmetic
    b[1] = qidx.TABLE[i]
    (*pb).n = (*pb).n + 1 as u32
    if b[1] != 20 as u32 {
        return 2 as i32
    }
    let e: u32 = qidx.TABLE[0]
    (*pb).n = (*pb).n + e
    if (*pb).n != 16 as u32 {
        return 3 as i32
    }
    let f: u32 = qidx.TABLE[(d as usize) + 1 as usize]
    (*pb).n = f
    if (*pb).n != 40 as u32 {
        return 4 as i32
    }
    let g: u8 = qidx.NAMES[i - 1 as usize]
    (*pb).n = g as u32
    if (*pb).n != 1 as u32 {
        return 5 as i32
    }
    // the generic forms keep working, also with a `(` on the next line
    let c: qidx.Cell[i32] = qidx.Cell[i32] { v: 3 as i32 }
    if local_id[i32](c.v) != 3 as i32 {
        return 6 as i32
    }
    if qidx.pick_t[i32](1 as i32, 2 as i32) != 2 as i32 {
        return 7 as i32
    }
    return 0 as i32
}
