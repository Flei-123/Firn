// expect_exit: 0
// tests/4861_chan_doc_example.fi -- the MPSC example of docs/CHAN.md: two producers send (id, n) records, the consumer uses chan_recv_timeout, close after the producers are joined, drain until RECV_CLOSED.
import std.rt
import chan.chan

static mut g_blk: u64 = 0

fn __thread_work(kind: u64, arg: u64) -> u64 {
    var c: chan.Chan = chan.Chan { blk: g_blk }
    var rec: [u64; 2] = [0; 2]
    var n: u64 = 0
    while n < 1000 {
        rec[0] = arg
        rec[1] = n
        if !chan.chan_send(&c, &rec[0]) {
            return 1
        }
        n = n + 1
    }
    return 0
}

fn main() -> i32 {
    var c: chan.Chan = chan.chan_new(16, 2)
    if c.blk == 0 {
        return 1
    }
    g_blk = c.blk
    let a: u64 = thread_start(1, 0)
    let b: u64 = thread_start(1, 1)
    var next: [u64; 2] = [0; 2]
    var out: [u64; 2] = [0; 2]
    var total: u64 = 0
    var closed: bool = false
    while true {
        let r: u64 = chan.chan_recv_timeout(&c, &out[0], 20)
        if r == chan.RECV_OK {
            if out[0] > 1 || out[1] != next[out[0] as usize] {
                return 2
            }
            next[out[0] as usize] = out[1] + 1
            total = total + 1
        } else if r == chan.RECV_CLOSED {
            break
        } else if !closed && total == 2000 {
            // both producers are done: nobody sends any more, so closing loses nothing
            thread_wait(a)
            thread_wait(b)
            chan.chan_close(&c)
            closed = true
        }
    }
    chan.chan_free(&c)
    if total != 2000 {
        return 3
    }
    return 0
}
