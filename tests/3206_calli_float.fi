// expect_exit: 0
// ROUND CALLI-FLOAT: a call through a function value (`calli`) with floating point
// arguments and results. The register allocator's arm for `CallIndirect` counted argument
// POSITIONS only (integer registers) and always took `rax` as the result: an `f64` result
// came back as garbage in every optimised build, f64 arguments went into the wrong
// registers. `--no-opt` (the base path in codegen_x86.rs) was right, which hid it.
// Found in OrientOS: fUi's `textbuf.tb_x_of` measures through `fn(u64, u64, usize) -> f64`,
// so the caret of every text field stood at the left end.
fn mix(a: u64, x: f64, b: u64, y: f64, c: u64) -> f64 {
    return x * 2.0 + y + (a + b + c) as f64
}

fn mixi(a: u64, x: f64) -> u64 {
    return a + (x as u64)
}

fn mixf(a: f32, b: f32) -> f32 {
    return a + b
}

fn meas(ctx: u64, p: u64, n: usize) -> f64 {
    return (n as f64) * 7.5
}

fn run(m: fn(u64, f64, u64, f64, u64) -> f64, n: fn(u64, f64) -> u64,
    k: fn(f32, f32) -> f32, g: fn(u64, u64, usize) -> f64) -> i32 {
    var rc: i32 = 0
    let r: f64 = m(1, 10.0, 2, 3.5, 4)
    if !(r > 30.4 && r < 30.6) {
        rc = rc + 1
    }
    let q: u64 = n(5, 7.0)
    if q != 12 {
        rc = rc + 2
    }
    let z: f32 = k(1.5, 2.25)
    if !(z > 3.7 && z < 3.8) {
        rc = rc + 4
    }
    let w: f64 = g(0, 5, 5)
    if !(w > 37.4 && w < 37.6) {
        rc = rc + 8
    }
    return rc
}

fn main() -> i32 {
    return run(mix, mixi, mixf, meas)
}
