// expect_exit: 0
import std.rt
import std.fs
import std.md5
import media.demux
import media.video.vp8.vp8dec
import media.video.vp8.vp8state

fn digest_of(path: str) -> u64 {
    var b: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(path, &b) catch | e | (0 -% 1)
    if got == (0 -% 1) {
        return 0
    }
    var dm: demux.Demux = demux.demux_new()
    if demux.demux_open(&dm, b.ptr, rt.buf_len(&b)) != 0 {
        return 0
    }
    let t: i32 = demux.demux_find_track(&dm, demux.TK_VIDEO)
    if t < 0 || demux.demux_track_codec(&dm, t) != demux.CODEC_VP8 {
        return 0
    }
    var dec: vp8state.Vp8 = vp8state.vp8_new()
    var h: md5.Md5 = md5.md5_new()
    var i: usize = 0
    while i < demux.demux_nsamples(&dm, t) {
        let rc: i64 = vp8dec.dec_frame(&dec, b.ptr + demux.demux_sample_off(&dm, t, i), demux.demux_sample_size(&dm, t, i) as usize)
        if rc != vp8dec.DEC_OK {
            return 0
        }
        let sz: usize = vp8dec.dec_yuv_size(&dec)
        let tmp: u64 = rt.heap_alloc(sz) as u64
        vp8dec.dec_copy_yuv420(&dec, tmp)
        md5.md5_update(&h, tmp, sz)
        rt.heap_free(tmp, sz)
        i = i + 1
    }
    var d: [u8; 16] = [0 as u8; 16]
    md5.md5_final(&h, (&d[0]) as u64)
    var v: u64 = 0
    var k: usize = 0
    while k < 8 {
        v = (v << 8) | (d[k] as u64)
        k = k + 1
    }
    vp8state.vp8_release(&dec)
    return v
}

fn main() -> i32 {
    if digest_of("testdata/media_video/vp8_kf_odd.webm") != 2261435625758439830 {
        return 1
    }
    if digest_of("testdata/media_video/vp8_kf_seg.webm") != 9692419954514247380 {
        return 2
    }
    if digest_of("testdata/media_video/vp8_kf_simple.webm") != 8230401078142737804 {
        return 3
    }
    return 0
}
