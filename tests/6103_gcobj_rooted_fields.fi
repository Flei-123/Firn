// expect_exit: 0
import std.gcobj

gc class Node {
    id: u32,
}

struct Holder {
    a: Gc[Node],
    b: Gc[Node],
}

fn fill(h: *mut Holder, base: u32) -> AllocError!bool {
    (*h).a = try gc Node { id: base }
    (*h).b = try gc Node { id: base + 1 }
    return true
}

fn churn(rounds: u32) -> AllocError!u32 {
    var i: u32 = 0
    var s: u32 = 0
    while i < rounds {
        let n: Gc[Node] = try gc Node { id: i }
        s = s + n.id
        i = i + 1
    }
    return s
}

fn collect_rounds() {
    var k: u32 = 0
    while k < 4 {
        let s: u32 = churn(2000) catch 0
        if s == 0 { return }
        gc_collect()
        k = k + 1
    }
}

fn rooted_case() -> i32 {
    let h: *mut Holder = gcobj.alloc[Holder](size_of[Holder]()) as *mut Holder
    if h as u64 == 0 { return 1 }
    let ok: bool = fill(h, 10) catch false
    if !ok { return 2 }
    collect_rounds()
    if (*h).a.id != 10 || (*h).b.id != 11 { return 3 }
    gcobj.free[Holder](h as u64, size_of[Holder]())
    return 0
}

fn main() -> i32 {
    return rooted_case()
}
