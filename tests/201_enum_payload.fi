// expect_exit: 47
// Nutzdaten: Bindung im Muster, mehrere Felder, Ueberlagerung der Varianten.
enum Value { Nothing, Number(i32), Pair(i32, i32) }

fn main() -> i32 {
    var sum: i32 = 0
    let a = Value::Number(5 as i32)
    let b = Value::Pair(7 as i32, 35 as i32)
    let c = Value::Nothing
    match a {
        Value::Nothing => { sum = sum + 100 as i32 }
        Value::Number(x) => { sum = sum + x }
        Value::Pair(x, y) => { sum = sum + x + y }
    }
    match b {
        Value::Nothing => { sum = sum + 100 as i32 }
        Value::Number(x) => { sum = sum + x }
        Value::Pair(x, y) => { sum = sum + y }
    }
    match c {
        Value::Nothing => { sum = sum + 7 as i32 }
        _ => { sum = sum + 100 as i32 }
    }
    return sum
}
