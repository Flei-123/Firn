// expect_exit: 47
// Nutzdaten: Bindung im Muster, mehrere Felder, Ueberlagerung der Varianten.
enum Wert { Nichts, Zahl(i32), Paar(i32, i32) }

fn main() -> i32 {
    var summe: i32 = 0
    let a = Wert::Zahl(5 as i32)
    let b = Wert::Paar(7 as i32, 35 as i32)
    let c = Wert::Nichts
    match a {
        Wert::Nichts => { summe = summe + 100 as i32 }
        Wert::Zahl(x) => { summe = summe + x }
        Wert::Paar(x, y) => { summe = summe + x + y }
    }
    match b {
        Wert::Nichts => { summe = summe + 100 as i32 }
        Wert::Zahl(x) => { summe = summe + x }
        Wert::Paar(x, y) => { summe = summe + y }
    }
    match c {
        Wert::Nichts => { summe = summe + 7 as i32 }
        _ => { summe = summe + 100 as i32 }
    }
    return summe
}
