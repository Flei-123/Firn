// expect_exit: 0
// GC IN DER KERNSPRACHE — der Test zur Runde 34 (docs/SELBSTHOSTING.md §25).
//
// Geprüft wird der ganze Weg in EINEM Programm:
//
//   * eine gc-Klasse in einem MODUL (`modules/kern/gccore.fi`) — diese
//     Datei hier enthaelt absichtlich KEIN `gc`-Token, der Treiber muss
//     die Laufzeit trotzdem einziehen (Runde-34-Fund: der Scan lief mit
//     -1 weiter, wenn nur Module `gc class` enthielten)
//   * `AllocError!Gc[T]` durch die Modulgrenze hindurch (`catch`)
//   * ein Zyklus, der unter einer Wurzel einen Sammellauf ueberlebt
//   * die Statistik der Laufzeit (`gc_heap_bytes`, `gc_collections`,
//     `gc_live_objects` — gezaehlt wird beim Sammellauf)
import modules.core.gccore

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    let root: Gc[Ring] = gccore.ring_new(3, 4) catch gc_null[Ring]()
    if root == gc_null[Ring]() {
        return 91
    }
    if gc_heap_bytes() == 0 {
        return 92
    }
    // Der Zyklus a <-> b lebt, weil `wurzel` zeigt.
    gc_collect()
    if gc_collections() != 1 {
        return 93
    }
    if gc_live_objects() != 2 {
        return 94
    }
    if root.value != 3 {
        return 1
    }
    if root.next.value != 4 {
        return 2
    }
    if root.next.next.value != 3 {
        // der Ringschluss zeigt wieder auf a
        return 3
    }
    return 0
}
