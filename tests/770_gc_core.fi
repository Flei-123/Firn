// expect_exit: 0
// GC IN THE CORE LANGUAGE -- the test for round 34 (docs/SELF_HOSTING.md 25).
//
// The whole path is checked in ONE program:
//
//   * a gc class in a MODULE (`modules/kern/gccore.fi`) -- this file here
//     deliberately contains NO `gc` token, the driver has to pull in the
//     runtime anyway (round 34 finding: the scan continued with -1 when
//     only modules contained `gc class`)
//   * `AllocError!Gc[T]` through the module boundary (`catch`)
//   * a cycle that survives a collection under a root
//   * the statistics of the runtime (`gc_heap_bytes`, `gc_collections`,
//     `gc_live_objects` -- counted during the collection)
import modules.core.gccore

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    let root: Gc[Ring] = gccore.ring_new(3, 4) catch gc_null[Ring]()
    if root == gc_null[Ring]() {
        return 91
    }
    if gc_heap_bytes() == 0 {
        return 92
    }
    // The cycle a <-> b lives because `root` points at it.
    gc_collect()
    if gc_collections() != 1 {
        return 93
    }
    if gc_live_objects() != 2 {
        return 94
    }
    if root.value != 3 {
        return 1
    }
    if root.next.value != 4 {
        return 2
    }
    if root.next.next.value != 3 {
        // the ring closes back onto a
        return 3
    }
    return 0
}
