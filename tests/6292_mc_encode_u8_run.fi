// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_schema
import mc.mc_encode
import mc.mc_version
import mc.v763.mc_proto_v763

fn say(msg: str) {
    var o: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&o, msg.p as u64, msg.n)
    rt.buf_push(&o, 10)
    rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
    rt.buf_free(&o)
}

fn fill_light(p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        rt.st8(p, i, ((i * 7 + 3) % 251) as u8)
        i = i + 1
    }
}

fn base_values(v: *mut rt.Buf) {
    mc_encode.vals_i64(v, "chunkX", 1)
    mc_encode.vals_i64(v, "chunkZ", 2)
    mc_encode.vals_raw(v, "skyLightMask", "#1")
    mc_encode.vals_raw(v, "skyLightMask[0]", "1")
    mc_encode.vals_raw(v, "blockLightMask", "#0")
    mc_encode.vals_raw(v, "emptySkyLightMask", "#0")
    mc_encode.vals_raw(v, "emptyBlockLightMask", "#0")
    mc_encode.vals_raw(v, "skyLight", "#1")
    mc_encode.vals_raw(v, "skyLight[0]", "#2048")
}

fn main() -> i32 {
    let sch: u64 = mc_proto_v763.packet_schema(mc_version.ST_PLAY, mc_version.DIR_S2C, mc_proto_v763.PLAY_S2C_UPDATE_LIGHT)
    if sch == 0 {
        say("FAIL schema handle")
        return 1
    }
    let data: u64 = rt.heap_alloc(2048)
    fill_light(data, 2048)
    var failures: i32 = 0

    var v: rt.Buf = rt.buf_new()
    base_values(&v)
    mc_encode.vals_hex(&v, "skyLight[0]", data, 2048)
    mc_encode.vals_raw(&v, "blockLight", "#0")
    var out: bytes.Bytes = bytes.bytes_new()
    var err: rt.Buf = rt.buf_new()
    if !mc_encode.encode_buf(sch, &v, &out, &err) {
        say("FAIL encode refused")
        rt.write_everything(1, rt.buf_ptr(&err), rt.buf_len(&err))
        return 1
    }
    let head: usize = 17
    let want_len: usize = head + 2048 + 1
    if bytes.bytes_len(&out) != want_len {
        say("FAIL length")
        failures = failures + 1
    } else {
        if bytes.bytes_at(&out, 0) as i32 != 1 || bytes.bytes_at(&out, 1) as i32 != 2 || bytes.bytes_at(&out, 2) as i32 != 1 {
            say("FAIL header")
            failures = failures + 1
        }
        if bytes.bytes_at(&out, 3) as i32 != 0 || bytes.bytes_at(&out, 10) as i32 != 1 || bytes.bytes_at(&out, 11) as i32 != 0 || bytes.bytes_at(&out, 13) as i32 != 0 {
            say("FAIL mask bytes")
            failures = failures + 1
        }
        if bytes.bytes_at(&out, 14) as i32 != 1 || bytes.bytes_at(&out, 15) as i32 != 0x80 || bytes.bytes_at(&out, 16) as i32 != 0x10 {
            say("FAIL array count and length")
            failures = failures + 1
        }
        var i: usize = 0
        var same: bool = true
        while i < 2048 {
            if bytes.bytes_at(&out, 17 + i) != rt.ld8(data, i) { same = false }
            i = i + 1
        }
        if !same {
            say("FAIL light bytes")
            failures = failures + 1
        }
        if bytes.bytes_at(&out, want_len - 1) as i32 != 0 {
            say("FAIL trailing block light count")
            failures = failures + 1
        }
    }

    rt.buf_clear(&v)
    bytes.bytes_free(&out)
    out = bytes.bytes_new()
    rt.buf_clear(&err)
    base_values(&v)
    mc_encode.vals_hex(&v, "skyLight[0]", data, 2047)
    mc_encode.vals_raw(&v, "blockLight", "#0")
    if mc_encode.encode_buf(sch, &v, &out, &err) {
        say("FAIL short run accepted")
        failures = failures + 1
    }

    bytes.bytes_free(&out)
    rt.buf_free(&err)
    rt.buf_free(&v)
    if failures == 0 {
        say("ok")
    }
    return failures
}
