// expect_out: ok
// tests/2954_photo_meta.fi -- photo.meta: defaults, CFA colour tables, noise model per colour, ISO fallback.
import std.io
import photo.meta

fn near(a: f32, b: f32) -> bool {
    var d: f32 = a - b
    if d < 0.0f { d = 0.0f - d }
    return d < 1.0e-9f
}

fn want_cfa(cfa: u32, c0: u32, c1: u32, c2: u32, c3: u32) -> bool {
    return meta.cfa_color(cfa, 0 as u32) == c0 && meta.cfa_color(cfa, 1 as u32) == c1 &&
    meta.cfa_color(cfa, 2 as u32) == c2 && meta.cfa_color(cfa, 3 as u32) == c3
}

fn main() -> i32 {
    var ok: bool = true
    // 0 red, 1 green, 2 blue
    ok = want_cfa(meta.CFA_RGGB, 0 as u32, 1 as u32, 1 as u32, 2 as u32) && ok
    ok = want_cfa(meta.CFA_GRBG, 1 as u32, 0 as u32, 2 as u32, 1 as u32) && ok
    ok = want_cfa(meta.CFA_GBRG, 1 as u32, 2 as u32, 0 as u32, 1 as u32) && ok
    ok = want_cfa(meta.CFA_BGGR, 2 as u32, 1 as u32, 1 as u32, 0 as u32) && ok
    var m: meta.SensorMeta = meta.meta_default()
    ok = !m.has_noise && !m.has_black && !m.has_forward && !m.has_wb && !m.has_focus && ok
    // fallback: noise grows with ISO
    var r: [f32; 6] = [0.0f; 6]
    meta.noise_model_rgb(&m, &r[0])
    let s100: f32 = r[0]
    m.iso = 800 as u32
    meta.noise_model_rgb(&m, &r[0])
    ok = r[0] > 7.9f * s100 && r[0] < 8.1f * s100 && ok
    // profile: green = mean of the two green sites
    meta.meta_set_noise(&m, 0, 1.0e-4f, 1.0e-6f)
    meta.meta_set_noise(&m, 1, 2.0e-4f, 2.0e-6f)
    meta.meta_set_noise(&m, 2, 4.0e-4f, 4.0e-6f)
    meta.meta_set_noise(&m, 3, 8.0e-4f, 8.0e-6f)
    meta.noise_model_rgb(&m, &r[0])
    ok = near(r[0], 1.0e-4f) && near(r[2], 3.0e-4f) && near(r[4], 8.0e-4f) && near(r[3], 3.0e-6f) && ok
    meta.meta_set_focus(&m, 10.0f, 0.5f, meta.CALIB_APPROX)
    ok = m.has_focus && m.focus_calib == meta.CALIB_APPROX && near(m.min_focus_distance, 10.0f) && ok
    // XYZ D50 white -> linear sRGB white (1, 1, 1)
    let x: f32 = 0.9642f
    let z: f32 = 0.8249f
    let rr: f32 = meta.srgb_from_xyz_d50(0) * x + meta.srgb_from_xyz_d50(1) + meta.srgb_from_xyz_d50(2) * z
    let bb: f32 = meta.srgb_from_xyz_d50(6) * x + meta.srgb_from_xyz_d50(7) + meta.srgb_from_xyz_d50(8) * z
    ok = rr > 0.995f && rr < 1.005f && bb > 0.995f && bb < 1.005f && ok
    if ok {
        io.print("ok")
        io.new_line()
        return 0
    }
    return 1
}
