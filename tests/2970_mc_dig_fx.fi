// expect_exit: 0
// mc_dig Efficiency / Haste / Mining Fatigue (vanilla Player.getDestroySpeed order: tool, efficiency, haste, fatigue, water, air) for 1.20.1.
// Reference values: speed / hardness / 30 per tick, ceil(1 / damage). Return codes: 1x = setup, 2xx = wrong ticks.
import std.rt
import mc.mc_registry
import mc.mc_dig
import mc.v763.mc_reg_v763
import mc.v763.mc_dig_v763

fn fx(r: *mut mc_registry.Registry, d: *mut mc_dig.DigData, blk: str, tool: str, eff: i32, haste: i32, fat: i32, ground: bool, water: bool) -> i32 {
    let b: i32 = mc_registry.reg_block_by_name(r, blk.p as u64, blk.n)
    if b < 0 { return 0 - 99 }
    var it: i32 = 0 - 1
    if tool.n > 0 { it = mc_registry.reg_item_by_name(r, tool.p as u64, tool.n) }
    return mc_dig.dig_ticks_fx(d, b, mc_registry.reg_block_hardness_milli(r, b), it, eff, haste, fat, ground, water)
}

fn main() -> i32 {
    var r: mc_registry.Registry = mc_reg_v763.registry_make()
    var d: mc_dig.DigData = mc_dig_v763.dig_make()
    if !mc_registry.registry_ok(&r) { return 10 }
    if !mc_dig.dig_ok(&d) { return 11 }
    // stone with an iron pickaxe: speed 6, hardness 1.5
    if fx(&r, &d, "stone", "iron_pickaxe", 0, 0, 0, true, false) != 8 { return 200 }
    if fx(&r, &d, "stone", "iron_pickaxe", 0, 1, 0, true, false) != 7 { return 201 } // Haste I: x1.2
    if fx(&r, &d, "stone", "iron_pickaxe", 0, 3, 0, true, false) != 5 { return 202 } // Haste III: x1.6
    if fx(&r, &d, "stone", "iron_pickaxe", 0, 0, 1, true, false) != 25 { return 203 } // Mining Fatigue I: x0.3
    if fx(&r, &d, "stone", "iron_pickaxe", 0, 0, 2, true, false) != 84 { return 204 } // x0.09
    if fx(&r, &d, "stone", "iron_pickaxe", 0, 0, 3, true, false) != 2778 { return 205 } // x0.0027
    if fx(&r, &d, "stone", "iron_pickaxe", 0, 0, 4, true, false) != 9260 { return 206 } // x0.00081
    if fx(&r, &d, "stone", "iron_pickaxe", 0, 0, 9, true, false) != 9260 { return 207 } // level 4+ stays at x0.00081
    if fx(&r, &d, "stone", "iron_pickaxe", 3, 0, 0, true, false) != 3 { return 208 } // Efficiency III: 6 + 10
    if fx(&r, &d, "stone", "iron_pickaxe", 3, 2, 0, true, false) != 3 { return 209 } // (6 + 10) x 1.4 = 22.4
    if fx(&r, &d, "stone", "iron_pickaxe", 3, 2, 0, false, false) != 11 { return 210 } // in the air: / 5
    // Haste / Efficiency + Fatigue cancel partly: (6 + 10) x 1.4 x 0.3 = 6.72 -> 0.1493 per tick -> 7
    if fx(&r, &d, "stone", "iron_pickaxe", 3, 2, 1, true, false) != 7 { return 211 }
    // by hand (speed 1): Efficiency does nothing, Haste does: dirt 0.5 hardness, 1 -> 15 ticks, 1.2 -> 13
    if fx(&r, &d, "dirt", "", 5, 0, 0, true, false) != 15 { return 212 }
    if fx(&r, &d, "dirt", "", 5, 1, 0, true, false) != 13 { return 213 }
    // dig_ticks stays the same as dig_ticks_fx without effects
    let b: i32 = mc_registry.reg_block_by_name(&r, "stone".p as u64, "stone".n)
    let it: i32 = mc_registry.reg_item_by_name(&r, "iron_pickaxe".p as u64, "iron_pickaxe".n)
    let hm: i32 = mc_registry.reg_block_hardness_milli(&r, b)
    if mc_dig.dig_ticks(&d, b, hm, it, 3, true, false) != mc_dig.dig_ticks_fx(&d, b, hm, it, 3, 0, 0, true, false) { return 220 }
    // unbreakable / instant are unchanged
    if fx(&r, &d, "bedrock", "iron_pickaxe", 5, 3, 0, true, false) != 0 - 1 { return 221 }
    if mc_dig.dig_fatigue_factor(0) != 1.0 { return 222 }
    return 0
}
