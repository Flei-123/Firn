// expect_exit: 0
// r234: SWAP (hotbar key / off hand) and DROP (Q, Ctrl+Q) on the crafting result slot are predicted: the result moves into an EMPTY target slot (the result slot takes
// nothing, so a full target does nothing) or the WHOLE result is dropped (empty cursor only); then one of every ingredient is used up (remainders as for a pick up).
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_schema
import mc.mc_registry
import mc.mc_craft
import mc.mc_craft_sel
import mc.mc_inv

fn it(r: *mut mc_registry.Registry, name: str) -> i32 { return mc_registry.reg_item_by_name(r, name.p as u64, name.n) }

fn layout(ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let id: i32 = mc_version.version_pid(ver, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK)
    if id < 0 { return false }
    let sch: u64 = (*ver).schema_of(mc_version.ST_PLAY, mc_version.DIR_C2S, id)
    if sch == 0 as u64 { return false }
    bytes.bytes_set_pos(b, 0)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk(sch, b, &out)
    rt.buf_free(&out)
    return ok
}

// one click; the packet must parse with the schema of the version; returns the number of changed slots (>= 0) or -1 / -2
fn clk(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32) -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(v, (*ver).protocol, slot, button, mode, &b) { return 0 - 1 }
    let ok: bool = layout(ver, &b)
    var n: i32 = 0
    if (*ver).protocol >= 756 { n = bytes.bytes_at(&b, 6) as i32 }
    bytes.bytes_free(&b)
    if !ok { return 0 - 2 }
    return n
}

fn open_table(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    var typ: i32 = 11
    if (*ver).protocol >= 765 { typ = 12 }
    bytes.put_varint(&b, id)
    bytes.put_varint(&b, typ)
    bytes.put_u8(&b, 0 as u8)
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_open_window_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn total(v: *mut mc_inv.Inv, item: i32) -> i32 {
    var n: i32 = 0
    var k: i32 = 9
    while k < 45 {
        if mc_inv.inv_item(v, k) == item { n = n + mc_inv.inv_count(v, k) }
        k = k + 1
    }
    return n
}

fn fresh(r: *mut mc_registry.Registry, rc: *mut mc_craft.Recipes) -> mc_inv.Inv {
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_use_registry(&v, r)
    if rc != 0 as *mut mc_craft.Recipes { mc_inv.inv_use_recipes(&v, rc) }
    return v
}

fn grid4(v: *mut mc_inv.Inv, it: i32, c: i32) {
    mc_inv.inv_set(v, 1, it, c)
    mc_inv.inv_set(v, 2, it, c)
    mc_inv.inv_set(v, 3, it, c)
    mc_inv.inv_set(v, 4, it, c)
    mc_inv.inv_craft_update(v)
}

fn fill(v: *mut mc_inv.Inv, item: i32, from: i32, to: i32) {
    var k: i32 = from
    while k < to { mc_inv.inv_set(v, k, item, 1); k = k + 1 }
}

fn all4(v: *mut mc_inv.Inv, c: i32) -> bool {
    return mc_inv.inv_count(v, 1) == c && mc_inv.inv_count(v, 2) == c && mc_inv.inv_count(v, 3) == c && mc_inv.inv_count(v, 4) == c
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var r: mc_registry.Registry = ver.registry_of()
    if !mc_registry.registry_ok(&r) { return 101 }
    var rc: mc_craft.Recipes = mc_craft_sel.recipes_for_protocol(p)
    if !mc_craft.craft_ok(&rc) { return 102 }
    let planks: i32 = it(&r, "oak_planks")
    let stick: i32 = it(&r, "stick")
    let honey: i32 = it(&r, "honey_bottle")
    let hblock: i32 = it(&r, "honey_block")
    let gb: i32 = it(&r, "glass_bottle")
    let dirt: i32 = it(&r, "dirt")
    let milk: i32 = it(&r, "milk_bucket")
    let bucket: i32 = it(&r, "bucket")
    let sugar: i32 = it(&r, "sugar")
    let egg: i32 = it(&r, "egg")
    let wheat: i32 = it(&r, "wheat")
    let cake: i32 = it(&r, "cake")
    let potion: i32 = it(&r, "potion")
    if planks < 0 || stick < 0 || honey < 0 || hblock < 0 || gb < 0 || dirt < 0 || milk < 0 || bucket < 0 || sugar < 0 || egg < 0 || wheat < 0 || cake < 0 || potion < 0 { return 103 }

    // 1: SWAP with hotbar key 2 (internal 38): stick x4 moves there, one plank of each grid slot is used up, the result is recomputed
    var a: mc_inv.Inv = fresh(&r, &rc)
    mc_inv.inv_set(&a, 1, planks, 2)
    mc_inv.inv_set(&a, 3, planks, 2)
    mc_inv.inv_craft_update(&a)
    let n1: i32 = clk(&a, &ver, 0, 2, 2)
    if n1 < 0 { return 110 }
    if mc_inv.inv_item(&a, 38) != stick || mc_inv.inv_count(&a, 38) != 4 || mc_inv.inv_count(&a, 1) != 1 || mc_inv.inv_count(&a, 3) != 1 || mc_inv.inv_item(&a, 0) != stick { return 111 }
    if p >= 756 && n1 != 3 { return 112 } // result slot (same item, same count: unchanged); changed: grid 1, grid 3, hotbar 38
    // 1b: the target is full now: nothing happens
    if clk(&a, &ver, 0, 2, 2) < 0 || mc_inv.inv_count(&a, 38) != 4 || mc_inv.inv_count(&a, 1) != 1 { return 113 }
    // 1c: off hand (button 40) is empty: the second craft goes there
    if clk(&a, &ver, 0, 40, 2) < 0 || mc_inv.inv_item(&a, 45) != stick || mc_inv.inv_count(&a, 45) != 4 || mc_inv.inv_item(&a, 1) != 0 - 1 || mc_inv.inv_item(&a, 0) != 0 - 1 { return 114 }
    mc_inv.inv_free(&a)
    // 2: DROP: Q drops the whole result (4 sticks, not 1), nothing arrives in the inventory or the cursor
    var b: mc_inv.Inv = fresh(&r, &rc)
    mc_inv.inv_set(&b, 1, planks, 3)
    mc_inv.inv_set(&b, 3, planks, 3)
    mc_inv.inv_craft_update(&b)
    if clk(&b, &ver, 0, 0, 4) < 0 || mc_inv.inv_cursor_item(&b) != 0 - 1 || mc_inv.inv_count(&b, 1) != 2 || mc_inv.inv_count(&b, 3) != 2 || mc_inv.inv_item(&b, 0) != stick { return 120 }
    var any: i32 = 0
    var k: i32 = 5
    while k < 46 {
        if mc_inv.inv_item(&b, k) >= 0 { any = any + 1 }
        k = k + 1
    }
    if any != 0 { return 121 }
    // Ctrl+Q does the same
    if clk(&b, &ver, 0, 1, 4) < 0 || mc_inv.inv_count(&b, 1) != 1 || mc_inv.inv_count(&b, 3) != 1 { return 122 }
    // with a stack in the hand nothing happens
    mc_inv.inv_set(&b, 10, dirt, 5)
    if clk(&b, &ver, 10, 0, 0) < 0 || mc_inv.inv_cursor_item(&b) != dirt { return 123 }
    if clk(&b, &ver, 0, 0, 4) < 0 || mc_inv.inv_count(&b, 1) != 1 || mc_inv.inv_cursor_count(&b) != 5 { return 124 }
    mc_inv.inv_free(&b)
    // 3: SWAP of a honey block recipe with stacks of 2: the result sits in hotbar 0 first, THEN the bottles go to the inventory (not onto the block): first free slot 37
    var c: mc_inv.Inv = fresh(&r, &rc)
    grid4(&c, honey, 2)
    if clk(&c, &ver, 0, 0, 2) < 0 || mc_inv.inv_item(&c, 36) != hblock || mc_inv.inv_item(&c, 37) != gb || mc_inv.inv_count(&c, 37) != 4 || !all4(&c, 1) { return 130 }
    // 3b: the second craft (single bottles): the glass bottles stay in the grid slots, the result goes to hotbar slot 4
    if clk(&c, &ver, 0, 4, 2) < 0 || mc_inv.inv_item(&c, 40) != hblock || mc_inv.inv_item(&c, 1) != gb || mc_inv.inv_item(&c, 4) != gb || mc_inv.inv_item(&c, 0) != 0 - 1 { return 131 }
    mc_inv.inv_free(&c)
    // 4: no room for the bottles (inventory full, hotbar target 36 empty): vanilla would drop them -> the click stays with the server, nothing changes
    var d: mc_inv.Inv = fresh(&r, &rc)
    fill(&d, dirt, 9, 45)
    mc_inv.inv_set(&d, 36, 0 - 1, 0)
    grid4(&d, honey, 2)
    if clk(&d, &ver, 0, 0, 2) < 0 || mc_inv.inv_item(&d, 36) != 0 - 1 || !all4(&d, 2) || mc_inv.inv_item(&d, 0) != hblock { return 140 }
    // DROP with a full inventory (slot 36 filled again): same
    mc_inv.inv_set(&d, 36, dirt, 1)
    if clk(&d, &ver, 0, 0, 4) < 0 || !all4(&d, 2) || mc_inv.inv_item(&d, 0) != hblock { return 141 }
    mc_inv.inv_free(&d)
    // 5: cake in a crafting table: DROP leaves the three buckets in the grid, SWAP likewise
    var t: mc_inv.Inv = fresh(&r, &rc)
    if !open_table(&t, &ver, 9) { return 150 }
    let g: i32 = 46
    mc_inv.inv_set(&t, g + 1, milk, 1)
    mc_inv.inv_set(&t, g + 2, milk, 1)
    mc_inv.inv_set(&t, g + 3, milk, 1)
    mc_inv.inv_set(&t, g + 4, sugar, 2)
    mc_inv.inv_set(&t, g + 5, egg, 1)
    mc_inv.inv_set(&t, g + 6, sugar, 1)
    mc_inv.inv_set(&t, g + 7, wheat, 3)
    mc_inv.inv_set(&t, g + 8, wheat, 1)
    mc_inv.inv_set(&t, g + 9, wheat, 1)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != cake { return 151 }
    if clk(&t, &ver, 0, 0, 4) < 0 || mc_inv.inv_item(&t, g + 1) != bucket || mc_inv.inv_item(&t, g + 3) != bucket || mc_inv.inv_item(&t, g + 5) != 0 - 1 || mc_inv.inv_count(&t, g + 4) != 1 || mc_inv.inv_cursor_item(&t) != 0 - 1 { return 152 }
    mc_inv.inv_set(&t, g + 1, milk, 1)
    mc_inv.inv_set(&t, g + 2, milk, 1)
    mc_inv.inv_set(&t, g + 3, milk, 1)
    mc_inv.inv_set(&t, g + 5, egg, 1)
    mc_inv.inv_set(&t, g + 6, sugar, 1)
    mc_inv.inv_set(&t, g + 7, wheat, 1)
    mc_inv.inv_set(&t, g + 8, wheat, 1)
    mc_inv.inv_set(&t, g + 9, wheat, 1)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != cake { return 153 }
    // hotbar key 1 = window slot 37 in the table; the same key in the packet is the button
    if clk(&t, &ver, 0, 1, 2) < 0 || mc_inv.inv_item(&t, 37) != cake || mc_inv.inv_item(&t, g + 2) != bucket { return 154 }
    // 6: an unknown remainder (potion) keeps SWAP and DROP with the server
    mc_inv.inv_set(&t, g + 1, potion, 1)
    mc_inv.inv_set(&t, g + 2, planks, 1)
    mc_inv.inv_craft_update(&t)
    mc_inv.inv_set(&t, g, stick, 4) // pretend the server reported a result
    if clk(&t, &ver, 0, 2, 2) < 0 || mc_inv.inv_item(&t, 38) != 0 - 1 || mc_inv.inv_item(&t, g + 1) != potion { return 160 }
    if clk(&t, &ver, 0, 0, 4) < 0 || mc_inv.inv_item(&t, g + 1) != potion || mc_inv.inv_item(&t, g) != stick { return 161 }
    mc_inv.inv_free(&t)
    return 0
}

fn main() -> i32 {
    let protos: [i32; 5] = [754, 763, 767, 772, 775]
    var k: usize = 0
    while k < 5 {
        let rcode: i32 = check(protos[k])
        if rcode != 0 { return rcode + (k as i32 + 1) * 1000 }
        k = k + 1
    }
    return 0
}
