// expect_out: ok 42
// Sichtbare Ausgabe: Erfolgs- und Fehlerpfad einer Fehlerunion.
error E { Leer }

fn wert(n: i32) -> E!i32 {
    if n == 0 {
        return E::Leer
    }
    return n
}

fn schreib(p: *u8, n: i64) {
    syscall(1, 1, p, n)
}

fn main() -> i32 {
    var buf: [u8; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
    let a = wert(42) catch 0
    let b = wert(0) catch 0
    buf[0] = 111
    buf[1] = 107
    buf[2] = 32
    buf[3] = (a / 10) as u8 + 48
    buf[4] = (a % 10) as u8 + 48
    buf[5] = 10
    if b != 0 {
        return 1
    }
    schreib(&buf[0], 6)
    return 0
}
