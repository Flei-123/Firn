// expect_exit: 0
import std.testkit
import scene3d.vec3
import scene3d.mat4
import scene3d.mesh
import scene3d.curve
import scene3d.geom
import scene3d.quat
import std.math

fn rel_ok(a: f64, b: f64, tol: f64) -> bool {
    return vec3.absf(a - b) <= tol * vec3.absf(b)
}

fn check_shape(g: *mut mesh.Mesh, label: str) {
    let nv: usize = mesh.mesh_vertex_count(g)
    let nt: usize = mesh.mesh_tri_count(g)
    var i: usize = 0
    var unit_ok: bool = true
    while i < nv {
        if vec3.absf(vec3.v3_len(mesh.mesh_nrm(g, i)) - 1.0) > 0.000000001 { unit_ok = false }
        i = i + 1
    }
    testkit.assert_true(unit_ok, label)
    var t: usize = 0
    var wind_ok: bool = true
    var idx_ok: bool = true
    while t < nt {
        let gn: vec3.V3 = vec3.v3_norm(mesh.mesh_tri_normal(g, t))
        var avg: vec3.V3 = vec3.v3_zero()
        var k: usize = 0
        while k < 3 {
            let vi: u32 = mesh.mesh_index(g, t * 3 + k)
            if vi as usize >= nv { idx_ok = false }
            avg = vec3.v3_add(avg, mesh.mesh_nrm(g, vi as usize))
            k = k + 1
        }
        if vec3.v3_dot(gn, vec3.v3_norm(avg)) < 0.5 { wind_ok = false }
        t = t + 1
    }
    testkit.assert_true(idx_ok, label)
    testkit.assert_true(wind_ok, label)
}

#[test]
fn box_counts_bounds_volume() {
    var g: mesh.Mesh = geom.geom_box(2.0, 3.0, 4.0)
    testkit.assert_eq_i64(mesh.mesh_vertex_count(&g) as i64, 24)
    testkit.assert_eq_i64(mesh.mesh_tri_count(&g) as i64, 12)
    check_shape(&g, "box shape")
    testkit.assert_near(mesh.mesh_volume(&g), 24.0, 0.000000001)
    testkit.assert_near(mesh.mesh_area(&g), 52.0, 0.000000001)
    var lo: vec3.V3 = vec3.v3_zero()
    var hi: vec3.V3 = vec3.v3_zero()
    mesh.mesh_bounds(&g, &lo, &hi)
    testkit.assert_true(vec3.v3_same(lo, vec3.v3(0.0 - 1.0, 0.0 - 1.5, 0.0 - 2.0), 0.000000001), "box lo")
    testkit.assert_true(vec3.v3_same(hi, vec3.v3(1.0, 1.5, 2.0), 0.000000001), "box hi")
    mesh.mesh_free(&g)
    testkit.assert_eq_i64(mesh.mesh_vertex_count(&g) as i64, 0)
}

#[test]
fn box_open_walls() {
    var g: mesh.Mesh = geom.geom_box_open(4.0, 3.0, 2.0, 0.5)
    testkit.assert_eq_i64(mesh.mesh_tri_count(&g) as i64, 28)
    check_shape(&g, "open box shape")
    testkit.assert_near(mesh.mesh_area(&g), 67.0, 0.000000001)
    var lo: vec3.V3 = vec3.v3_zero()
    var hi: vec3.V3 = vec3.v3_zero()
    mesh.mesh_bounds(&g, &lo, &hi)
    testkit.assert_true(vec3.v3_same(lo, vec3.v3(0.0 - 2.0, 0.0 - 1.5, 0.0 - 1.0), 0.000000001), "open lo")
    testkit.assert_true(vec3.v3_same(hi, vec3.v3(2.0, 1.5, 1.0), 0.000000001), "open hi")
    var inner_back: bool = false
    var i: usize = 0
    while i < mesh.mesh_vertex_count(&g) {
        let p: vec3.V3 = mesh.mesh_pos(&g, i)
        let n: vec3.V3 = mesh.mesh_nrm(&g, i)
        if vec3.absf(p.z + 0.5) < 0.000000001 && n.z > 0.99 { inner_back = true }
        i = i + 1
    }
    testkit.assert_true(inner_back, "inner back wall faces +z at z=-0.5")
    mesh.mesh_free(&g)
}

#[test]
fn plane_grid() {
    var g: mesh.Mesh = geom.geom_plane(2.0, 4.0, 3, 4)
    testkit.assert_eq_i64(mesh.mesh_vertex_count(&g) as i64, 20)
    testkit.assert_eq_i64(mesh.mesh_tri_count(&g) as i64, 24)
    check_shape(&g, "plane shape")
    testkit.assert_near(mesh.mesh_area(&g), 8.0, 0.000000001)
    testkit.assert_near(mesh.mesh_nrm(&g, 5).y, 1.0, 0.000000001)
    mesh.mesh_free(&g)
}

#[test]
fn cylinder_variants() {
    var g: mesh.Mesh = geom.geom_cylinder(1.0, 1.0, 2.0, 12, false)
    testkit.assert_eq_i64(mesh.mesh_vertex_count(&g) as i64, 54)
    testkit.assert_eq_i64(mesh.mesh_tri_count(&g) as i64, 48)
    check_shape(&g, "cylinder shape")
    mesh.mesh_free(&g)
    var o: mesh.Mesh = geom.geom_cylinder(1.0, 1.0, 2.0, 12, true)
    testkit.assert_eq_i64(mesh.mesh_vertex_count(&o) as i64, 26)
    testkit.assert_eq_i64(mesh.mesh_tri_count(&o) as i64, 24)
    mesh.mesh_free(&o)
    var f: mesh.Mesh = geom.geom_cylinder(1.5, 1.5, 3.0, 96, false)
    testkit.assert_true(rel_ok(mesh.mesh_volume(&f), vec3.PI * 2.25 * 3.0, 0.002), "cylinder volume")
    var lo: vec3.V3 = vec3.v3_zero()
    var hi: vec3.V3 = vec3.v3_zero()
    mesh.mesh_bounds(&f, &lo, &hi)
    testkit.assert_near(lo.y, 0.0 - 1.5, 0.000000001)
    testkit.assert_near(hi.y, 1.5, 0.000000001)
    mesh.mesh_free(&f)
    var cone: mesh.Mesh = geom.geom_cylinder(0.0, 1.0, 2.0, 96, false)
    check_shape(&cone, "cone shape")
    testkit.assert_true(rel_ok(mesh.mesh_volume(&cone), vec3.PI * 2.0 / 3.0, 0.003), "cone volume")
    mesh.mesh_free(&cone)
}

#[test]
fn sphere_properties() {
    var g: mesh.Mesh = geom.geom_sphere(1.0, 16, 8)
    testkit.assert_eq_i64(mesh.mesh_vertex_count(&g) as i64, 153)
    testkit.assert_eq_i64(mesh.mesh_tri_count(&g) as i64, 224)
    check_shape(&g, "sphere shape")
    mesh.mesh_free(&g)
    var f: mesh.Mesh = geom.geom_sphere(2.0, 96, 48)
    check_shape(&f, "fine sphere shape")
    testkit.assert_true(rel_ok(mesh.mesh_volume(&f), 4.0 / 3.0 * vec3.PI * 8.0, 0.005), "sphere volume")
    testkit.assert_true(rel_ok(mesh.mesh_area(&f), 4.0 * vec3.PI * 4.0, 0.005), "sphere area")
    var lo: vec3.V3 = vec3.v3_zero()
    var hi: vec3.V3 = vec3.v3_zero()
    mesh.mesh_bounds(&f, &lo, &hi)
    testkit.assert_true(vec3.v3_same(hi, vec3.v3(2.0, 2.0, 2.0), 0.000000001), "sphere hi")
    testkit.assert_true(vec3.v3_same(lo, vec3.v3(0.0 - 2.0, 0.0 - 2.0, 0.0 - 2.0), 0.000000001), "sphere lo")
    var outward: bool = true
    var i: usize = 0
    while i < mesh.mesh_vertex_count(&f) {
        if vec3.v3_dot(vec3.v3_norm(mesh.mesh_pos(&f, i)), mesh.mesh_nrm(&f, i)) < 0.999999 { outward = false }
        i = i + 1
    }
    testkit.assert_true(outward, "sphere normals outward")
    mesh.mesh_free(&f)
}

#[test]
fn torus_properties() {
    var g: mesh.Mesh = geom.geom_torus(2.0, 0.5, 12, 24)
    testkit.assert_eq_i64(mesh.mesh_vertex_count(&g) as i64, 325)
    testkit.assert_eq_i64(mesh.mesh_tri_count(&g) as i64, 576)
    mesh.mesh_free(&g)
    var f: mesh.Mesh = geom.geom_torus(3.0, 1.0, 48, 96)
    check_shape(&f, "torus shape")
    testkit.assert_true(rel_ok(mesh.mesh_volume(&f), 2.0 * vec3.PI * vec3.PI * 3.0, 0.005), "torus volume")
    var lo: vec3.V3 = vec3.v3_zero()
    var hi: vec3.V3 = vec3.v3_zero()
    mesh.mesh_bounds(&f, &lo, &hi)
    testkit.assert_near(hi.x, 4.0, 0.000000001)
    testkit.assert_near(hi.y, 1.0, 0.000000001)
    testkit.assert_near(lo.y, 0.0 - 1.0, 0.000000001)
    mesh.mesh_free(&f)
}

#[test]
fn append_transform_and_mirror() {
    var dst: mesh.Mesh = mesh.mesh_new()
    var src: mesh.Mesh = geom.geom_box(1.0, 1.0, 1.0)
    mesh.mesh_append(&dst, &src, mat4.m4_compose(vec3.v3(5.0, 0.0, 0.0), quat_id(), vec3.v3(2.0, 3.0, 4.0)))
    testkit.assert_eq_i64(mesh.mesh_vertex_count(&dst) as i64, 24)
    testkit.assert_near(mesh.mesh_volume(&dst), 24.0, 0.000000001)
    check_shape(&dst, "scaled append")
    mesh.mesh_append(&dst, &src, mat4.m4_scale(vec3.v3(0.0 - 1.0, 1.0, 1.0)))
    testkit.assert_eq_i64(mesh.mesh_tri_count(&dst) as i64, 24)
    testkit.assert_near(mesh.mesh_volume(&dst), 25.0, 0.000000001)
    check_shape(&dst, "mirrored append")
    var lo: vec3.V3 = vec3.v3_zero()
    var hi: vec3.V3 = vec3.v3_zero()
    mesh.mesh_bounds(&dst, &lo, &hi)
    testkit.assert_near(hi.x, 6.0, 0.000000001)
    mesh.mesh_translate(&dst, vec3.v3(0.0 - 1.0, 2.0, 0.0))
    mesh.mesh_bounds(&dst, &lo, &hi)
    testkit.assert_near(hi.x, 5.0, 0.000000001)
    mesh.mesh_free(&dst)
    mesh.mesh_free(&src)
}

fn quat_id() -> quat.Q4 {
    return quat.q_axis_angle(vec3.v3(0.0, 1.0, 0.0), 0.0)
}

#[test]
fn smooth_normals_follow_surface() {
    var g: mesh.Mesh = geom.geom_sphere(1.0, 32, 16)
    mesh.mesh_smooth_normals(&g)
    var ok: bool = true
    var i: usize = 0
    while i < mesh.mesh_vertex_count(&g) {
        let p: vec3.V3 = mesh.mesh_pos(&g, i)
        let n: vec3.V3 = mesh.mesh_nrm(&g, i)
        if vec3.absf(vec3.v3_len(n) - 1.0) > 0.000000001 { ok = false }
        if vec3.v3_dot(vec3.v3_norm(p), n) < 0.97 { ok = false }
        i = i + 1
    }
    testkit.assert_true(ok, "smoothed sphere normals")
    mesh.mesh_free(&g)
}

#[test]
fn curve_line_and_controls() {
    var cv: curve.Curve = curve.curve_new()
    curve.curve_add(&cv, vec3.v3(0.0, 0.0, 0.0))
    curve.curve_add(&cv, vec3.v3(1.0, 0.0, 0.0))
    curve.curve_add(&cv, vec3.v3(2.0, 0.0, 0.0))
    curve.curve_build(&cv)
    testkit.assert_near(curve.curve_length(&cv), 2.0, 0.000000001)
    testkit.assert_true(vec3.v3_same(curve.curve_point(&cv, 0.5), vec3.v3(1.0, 0.0, 0.0), 0.000000001), "mid")
    testkit.assert_true(vec3.v3_same(curve.curve_point(&cv, 1.0), vec3.v3(2.0, 0.0, 0.0), 0.000000001), "end")
    testkit.assert_true(vec3.v3_same(curve.curve_tangent(&cv, 0.3), vec3.v3(1.0, 0.0, 0.0), 0.000000001), "tangent")
    testkit.assert_true(vec3.v3_same(curve.curve_point_at_len(&cv, 0.5), vec3.v3(0.5, 0.0, 0.0), 0.000001), "at len")
    testkit.assert_true(vec3.v3_same(curve.curve_point_at_len(&cv, 9.0), vec3.v3(2.0, 0.0, 0.0), 0.000000001), "clamp")
    curve.curve_free(&cv)
    var bent: curve.Curve = curve.curve_new()
    curve.curve_add(&bent, vec3.v3(0.0, 0.0, 0.0))
    curve.curve_add(&bent, vec3.v3(1.0, 2.0, 0.0))
    curve.curve_add(&bent, vec3.v3(3.0, 2.0, 1.0))
    curve.curve_add(&bent, vec3.v3(4.0, 0.0, 1.0))
    curve.curve_build(&bent)
    testkit.assert_true(vec3.v3_same(curve.curve_point(&bent, 1.0 / 3.0), vec3.v3(1.0, 2.0, 0.0), 0.000000001), "passes ctrl 1")
    testkit.assert_true(vec3.v3_same(curve.curve_point(&bent, 2.0 / 3.0), vec3.v3(3.0, 2.0, 1.0), 0.000000001), "passes ctrl 2")
    curve.curve_free(&bent)
}

#[test]
fn curve_circle_length() {
    var cv: curve.Curve = curve.curve_new()
    var i: i32 = 0
    while i <= 64 {
        let a: f64 = (i as f64) / 64.0 * vec3.TAU
        curve.curve_add(&cv, vec3.v3(3.0 * cos_(a), 0.0, 3.0 * sin_(a)))
        i = i + 1
    }
    curve.curve_build(&cv)
    testkit.assert_true(rel_ok(curve.curve_length(&cv), vec3.TAU * 3.0, 0.001), "circle length")
    curve.curve_free(&cv)
}

fn cos_(a: f64) -> f64 {
    return math.cos(a)
}

fn sin_(a: f64) -> f64 {
    return math.sin(a)
}

#[test]
fn helix_length_and_arc_param() {
    var h: curve.Curve = curve.curve_helix(vec3.v3(1.0, 2.0, 3.0), 2.4, 1.5, 8.0, 24)
    let formula: f64 = 8.0 * vec3.sqrtf64((vec3.TAU * 2.4) * (vec3.TAU * 2.4) + 1.5 * 1.5)
    testkit.assert_true(rel_ok(curve.curve_length(&h), formula, 0.001), "helix length")
    let total: f64 = curve.curve_length(&h)
    testkit.assert_true(vec3.v3_same(curve.curve_point_at_len(&h, 0.0), curve.curve_control(&h, 0), 0.000001), "start")
    testkit.assert_true(vec3.v3_same(curve.curve_point_at_len(&h, total), curve.curve_control(&h, 192), 0.000001), "stop")
    var mid: vec3.V3 = curve.curve_point(&h, 0.5)
    testkit.assert_near(mid.y, 2.0 + 0.0 * 1.0, 0.1)
    var prev: vec3.V3 = curve.curve_point_at_len(&h, 0.0)
    var first: vec3.V3 = prev
    var mono: bool = true
    var steps_ok: bool = true
    var dir_ok: bool = true
    var k: i32 = 1
    while k <= 400 {
        let s: f64 = total * (k as f64) / 400.0
        let p: vec3.V3 = curve.curve_point_at_len(&h, s)
        let step: f64 = vec3.v3_dist(p, prev)
        let expect: f64 = total / 400.0
        if vec3.absf(step - expect) > 0.02 * expect { steps_ok = false }
        if vec3.v3_dot(curve.curve_tangent_at_len(&h, s), vec3.v3_sub(p, prev)) <= 0.0 { dir_ok = false }
        if vec3.v3_dist(p, first) < 0.0 { mono = false }
        prev = p
        k = k + 1
    }
    testkit.assert_true(steps_ok, "even steps")
    testkit.assert_true(dir_ok, "tangent forward")
    testkit.assert_true(mono, "mono")
    curve.curve_free(&h)
}

#[test]
fn tube_straight_closed() {
    var cv: curve.Curve = curve.curve_new()
    curve.curve_add(&cv, vec3.v3(0.0, 0.0, 0.0))
    curve.curve_add(&cv, vec3.v3(0.0, 5.0, 0.0))
    curve.curve_build(&cv)
    var g: mesh.Mesh = geom.geom_tube(&cv, 0.5, 10, 8, false)
    testkit.assert_eq_i64(mesh.mesh_vertex_count(&g) as i64, 99)
    testkit.assert_eq_i64(mesh.mesh_tri_count(&g) as i64, 160)
    check_shape(&g, "open tube shape")
    mesh.mesh_free(&g)
    var cap: mesh.Mesh = geom.geom_tube(&cv, 0.5, 10, 8, true)
    testkit.assert_eq_i64(mesh.mesh_vertex_count(&cap) as i64, 119)
    testkit.assert_eq_i64(mesh.mesh_tri_count(&cap) as i64, 176)
    check_shape(&cap, "capped tube shape")
    let poly: f64 = 0.5 * 8.0 * 0.25 * 0.7071067811865476
    testkit.assert_near(mesh.mesh_volume(&cap), poly * 5.0, 0.0000001)
    mesh.mesh_free(&cap)
    curve.curve_free(&cv)
}

#[test]
fn tube_helix_clean() {
    var h: curve.Curve = curve.curve_helix(vec3.v3_zero(), 2.0, 1.0, 4.0, 24)
    let total: f64 = curve.curve_length(&h)
    var g: mesh.Mesh = geom.geom_tube(&h, 0.1, 400, 12, true)
    check_shape(&g, "helix tube shape")
    var on_ring: bool = true
    var perp: bool = true
    var smooth: bool = true
    var i: i32 = 0
    while i <= 400 {
        let s: f64 = total * (i as f64) / 400.0
        let p: vec3.V3 = curve.curve_point_at_len(&h, s)
        let tg: vec3.V3 = curve.curve_tangent_at_len(&h, s)
        var j: i32 = 0
        while j <= 12 {
            let vi: usize = (i * 13 + j) as usize
            let off: vec3.V3 = vec3.v3_sub(mesh.mesh_pos(&g, vi), p)
            if vec3.absf(vec3.v3_len(off) - 0.1) > 0.000000001 { on_ring = false }
            if vec3.absf(vec3.v3_dot(off, tg)) > 0.000000001 { perp = false }
            if i > 0 {
                let before: vec3.V3 = vec3.v3_sub(mesh.mesh_pos(&g, vi - 13), curve.curve_point_at_len(&h, total * ((i - 1) as f64) / 400.0))
                if vec3.v3_dot(vec3.v3_norm(off), vec3.v3_norm(before)) < 0.98 { smooth = false }
            }
            j = j + 1
        }
        i = i + 1
    }
    testkit.assert_true(on_ring, "ring radius")
    testkit.assert_true(perp, "ring plane")
    testkit.assert_true(smooth, "no twist flips")
    testkit.assert_true(rel_ok(mesh.mesh_volume(&g), vec3.PI * 0.01 * total * 12.0 / vec3.TAU * 0.5, 0.01), "helix tube volume")
    mesh.mesh_free(&g)
    curve.curve_free(&h)
}
