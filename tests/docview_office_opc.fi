// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import std.rt
import std.xml
import zip.zip
import docview.office.opc
import docview.office.ooxml

fn add(w: *mut zip.ZipWriter, name: str, body: str) -> bool {
    return zip.zip_add(w, name, body.p as u64, body.n, true) catch false
}

fn build(out: *mut rt.Buf) -> bool {
    var w: zip.ZipWriter = zip.zip_writer_new(out)
    defer zip.zip_writer_free(&w)
    if !add(&w, "[Content_Types].xml", "<?xml version=\"1.0\"?><Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\"><Default Extension=\"xml\" ContentType=\"application/xml\"/><Override PartName=\"/word/document.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml\"/></Types>") { return false }
    if !add(&w, "_rels/.rels", "<?xml version=\"1.0\"?><Relationships xmlns=\"x\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"word/document.xml\"/></Relationships>") { return false }
    if !add(&w, "word/document.xml", "<w:document xmlns:w=\"x\"><w:body/></w:document>") { return false }
    if !add(&w, "word/_rels/document.xml.rels", "<Relationships><Relationship Id=\"rId7\" Type=\"http://x/image\" Target=\"media/a.png\"/><Relationship Id=\"rId8\" Type=\"http://x/hyperlink\" Target=\"http://e.com/\" TargetMode=\"External\"/><Relationship Id=\"rId9\" Type=\"http://x/header\" Target=\"../word/./sub/../header1.xml\"/></Relationships>") { return false }
    zip.zip_finish(&w) catch 0
    return true
}

fn main() -> i32 {
    var buf: rt.Buf = rt.buf_new()
    defer rt.buf_free(&buf)
    if !build(&buf) { return 1 }
    var pk: opc.Package = opc.pkg_new()
    defer opc.pkg_free(&pk)
    if !opc.pkg_open(&pk, rt.buf_ptr(&buf), rt.buf_len(&buf)) { return 2 }
    var main_part: rt.Buf = rt.buf_new()
    defer rt.buf_free(&main_part)
    if !opc.pkg_main_part(&pk, &main_part) { return 3 }
    if !(rt.buf_str(&main_part) == "word/document.xml") { return 4 }
    if !opc.pkg_content_type_is(&pk, "word/document.xml", "wordprocessingml.document.main+xml") { return 5 }
    var rl: opc.Rels = opc.rels_new()
    defer opc.rels_free(&rl)
    if !opc.rels_load(&pk, "word/document.xml", &rl) { return 6 }
    if opc.rels_count(&rl) != 3 { return 7 }
    let i: i64 = opc.rels_find_id(&rl, "rId7")
    if i < 0 { return 8 }
    if !(opc.rels_target(&rl, i as usize) == "word/media/a.png") { return 9 }
    let j: i64 = opc.rels_find_id(&rl, "rId8")
    if j < 0 || !opc.rels_external(&rl, j as usize) { return 10 }
    if !(opc.rels_target(&rl, j as usize) == "http://e.com/") { return 11 }
    let k: i64 = opc.rels_find_id(&rl, "rId9")
    if k < 0 { return 12 }
    if !(opc.rels_target(&rl, k as usize) == "word/header1.xml") { return 13 }
    if opc.rels_find_type(&rl, "/image") != i { return 14 }
    var bad: rt.Buf = rt.buf_new()
    defer rt.buf_free(&bad)
    rt.buf_push_bytes(&bad, rt.buf_ptr(&buf), 100)
    var pk2: opc.Package = opc.pkg_new()
    defer opc.pkg_free(&pk2)
    if opc.pkg_open(&pk2, rt.buf_ptr(&bad), rt.buf_len(&bad)) { return 15 }
    if ooxml.local_name("w:p") != "p" { return 16 }
    return 0
}
