// expect_exit: 0
fn check(got: str, want: str, code: i32) -> i32 {
    if got == want {
        return 0
    }
    return code
}

fn main() -> i32 {
    var bad: i32 = 0
    let x: i64 = 3
    let y: i32 = 4
    let z: f64 = 7.5
    bad = bad + check(x.to_str(), "3", 1)
    bad = bad + check(format.format3("z = {0} + {1} = {2}", x.to_str(), y.to_str(), z.to_str()), "z = 3 + 4 = 7.5", 2)
    let n: i32 = parse.to_i32("17") catch 0
    if n != 17 {
        bad = bad + 4
    }
    let bad_n: i32 = parse.to_i32("x") catch -1
    if bad_n != -1 {
        bad = bad + 8
    }
    if chars.count("h\u{e9}llo") != 5 {
        bad = bad + 16
    }
    print("prelude ")
    println("ok")
    return bad
}
