// expect_exit: 0
// tests/3950_default_args_methods.fi -- default and named arguments on METHOD
// calls (`x.m(a, b: 1)`) and on GENERIC templates (`f[T](..)`), r704.
const BASE: i32 = 100

struct Acc { total: i32 }

impl Acc {
    fn add(*mut self, a: i32, b: i32 = 5, c: i32 = BASE) -> i32 {
        (*self).total = (*self).total + a * 1000 + b * 10 + c
        return (*self).total
    }
    fn get(*self, scale: i32 = 2) -> i32 {
        return (*self).total * scale
    }
}

struct Pt { x: i32, y: i32 }

impl Pt {
    fn shift(self, dx: i32, dy: i32 = 7) -> Pt {
        return Pt { x: self.x + dx, y: self.y + dy }
    }
}

fn pick[T](a: T, b: T = 3 as T) -> T {
    return a + b
}

fn scale[T](a: T, k: T = 2 as T, off: T = 1 as T) -> T {
    return a * k + off
}

fn fail(code: i32) -> i32 {
    return code
}

fn main() -> i32 {
    var acc: Acc = Acc { total: 0 }
    // methods: defaults fill the tail, named arguments skip
    if acc.add(1) != 1150 { return fail(1) }
    acc.total = 0
    if acc.add(1, 2) != 1120 { return fail(2) }
    acc.total = 0
    if acc.add(1, c: 1) != 1051 { return fail(3) }
    acc.total = 0
    if acc.add(c: 2, a: 3, b: 4) != 3042 { return fail(4) }
    acc.total = 10
    if acc.get() != 20 { return fail(5) }
    if acc.get(scale: 3) != 30 { return fail(6) }
    // method calls nested in arguments and as receivers
    let p: Pt = Pt { x: 1, y: 2 }
    let q: Pt = p.shift(1).shift(dy: 1, dx: 2)
    if q.x != 4 || q.y != 10 { return fail(7) }
    if acc.get(scale: acc.get(scale: 1) - 8) != 20 { return fail(8) }
    // generic templates
    if pick[i32](1) != 4 { return fail(9) }
    if pick[i32](1, b: 1) != 2 { return fail(10) }
    if pick[i64](40 as i64) != 43 as i64 { return fail(11) }
    if scale[i32](5) != 11 { return fail(12) }
    if scale[i32](5, off: 0) != 10 { return fail(13) }
    if scale[i32](off: 2, a: 1, k: 9) != 11 { return fail(14) }
    return 0
}
