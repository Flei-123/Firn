// expect_exit: 0
// SPEC §4.4: Einfachvererbung fuer `gc class`, kostenlose Aufwaertsumwandlung,
// gepruefte Abwaertsumwandlung mit `.as?[T]`.
gc class Node {
    parent: Gc[Node],
    id: u32,
}

gc class Elem extends Node {
    tag: u32,
}

gc class Text extends Node {
    length: u32,
}

fn elem(tag: u32) -> AllocError!Gc[Elem] {
    return try gc Elem{ parent: gc_null[Node](), id: 1, tag: tag }
}

fn text(l: u32) -> AllocError!Gc[Text] {
    return try gc Text{ parent: gc_null[Node](), id: 2, length: l }
}

fn main() -> i32 {
    if !gc_init() {
        return 9
    }
    let e = elem(42) catch gc_null[Elem]()
    let t = text(7) catch gc_null[Text]()
    if e == gc_null[Elem]() || t == gc_null[Text]() {
        return 1
    }
    // Praefixlayout: geerbte Felder liegen vorne und sind lesbar.
    if e.id != 1 || e.tag != 42 {
        return 2
    }
    // Aufwaertsumwandlung ohne Kosten
    let n: Gc[Node] = e
    if n.id != 1 {
        return 3
    }
    // Abwaerts geprueft: passt
    let z = n.as?[Elem]
    if z == gc_null[Elem]() {
        return 4
    }
    if z.tag != 42 {
        return 5
    }
    // Abwaerts geprueft: passt NICHT (Element ist kein Text)
    if n.as?[Text] != gc_null[Text]() {
        return 6
    }
    // Der Elternverweis traegt die Basis, das Kind bleibt erreichbar.
    e.parent = t
    gc_collect()
    if e.parent.id != 2 {
        return 7
    }
    if gc_live_objects() < 2 {
        return 8
    }
    return 0
}
