// expect_exit: 0
// SPEC 4.4: single inheritance for `gc class`, free upcast,
// checked downcast with `.as?[T]`.
gc class Node {
    parent: Gc[Node],
    id: u32,
}

gc class Elem extends Node {
    tag: u32,
}

gc class Text extends Node {
    length: u32,
}

fn elem(tag: u32) -> AllocError!Gc[Elem] {
    return try gc Elem { parent: gc_null[Node](), id: 1, tag: tag }
}

fn text(l: u32) -> AllocError!Gc[Text] {
    return try gc Text { parent: gc_null[Node](), id: 2, length: l }
}

fn main() -> i32 {
    if !gc_init() {
        return 9
    }
    let e = elem(42) catch gc_null[Elem]()
    let t = text(7) catch gc_null[Text]()
    if e == gc_null[Elem]() || t == gc_null[Text]() {
        return 1
    }
    // Prefix layout: inherited fields lie in front and are readable.
    if e.id != 1 || e.tag != 42 {
        return 2
    }
    // Upcast without cost
    let n: Gc[Node] = e
    if n.id != 1 {
        return 3
    }
    // Downcast checked: it fits
    let z = n.as?[Elem]
    if z == gc_null[Elem]() {
        return 4
    }
    if z.tag != 42 {
        return 5
    }
    // Downcast checked: it does NOT fit (an element is no text)
    if n.as?[Text] != gc_null[Text]() {
        return 6
    }
    // The parent reference carries the base, the child stays reachable.
    e.parent = t
    gc_collect()
    if e.parent.id != 2 {
        return 7
    }
    if gc_live_objects() < 2 {
        return 8
    }
    return 0
}
