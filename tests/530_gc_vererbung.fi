// expect_exit: 0
// SPEC §4.4: Einfachvererbung fuer `gc class`, kostenlose Aufwaertsumwandlung,
// gepruefte Abwaertsumwandlung mit `.as?[T]`.
gc class Knoten {
    eltern: Gc[Knoten],
    kennung: u32,
}

gc class Element extends Knoten {
    tag: u32,
}

gc class Text extends Knoten {
    laenge: u32,
}

fn element(tag: u32) -> AllocError!Gc[Element] {
    return try gc Element{ eltern: gc_null[Knoten](), kennung: 1, tag: tag }
}

fn text(l: u32) -> AllocError!Gc[Text] {
    return try gc Text{ eltern: gc_null[Knoten](), kennung: 2, laenge: l }
}

fn main() -> i32 {
    if !gc_init() {
        return 9
    }
    let e = element(42) catch gc_null[Element]()
    let t = text(7) catch gc_null[Text]()
    if e == gc_null[Element]() || t == gc_null[Text]() {
        return 1
    }
    // Praefixlayout: geerbte Felder liegen vorne und sind lesbar.
    if e.kennung != 1 || e.tag != 42 {
        return 2
    }
    // Aufwaertsumwandlung ohne Kosten
    let n: Gc[Knoten] = e
    if n.kennung != 1 {
        return 3
    }
    // Abwaerts geprueft: passt
    let z = n.as?[Element]
    if z == gc_null[Element]() {
        return 4
    }
    if z.tag != 42 {
        return 5
    }
    // Abwaerts geprueft: passt NICHT (Element ist kein Text)
    if n.as?[Text] != gc_null[Text]() {
        return 6
    }
    // Der Elternverweis traegt die Basis, das Kind bleibt erreichbar.
    e.eltern = t
    gc_collect()
    if e.eltern.kennung != 2 {
        return 7
    }
    if gc_live_objects() < 2 {
        return 8
    }
    return 0
}
