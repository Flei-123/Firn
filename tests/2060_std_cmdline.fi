// expect_exit: 0
// tests/2060_std_cmdline.fi -- std.cmdline: Windows command line quoting.
//
// A. The documented parsing examples of the C runtime (the "Parsing C++
//    command-line arguments" table): the knife reads them as published.
// B. Round trip: for a list of nasty arguments (spaces, tabs, quotes,
//    trailing backslashes, JSON, a UNC path, non-ASCII), quote them, glue
//    the line, cut it again -- every argument must come back unchanged.
// C. UTF-8 -> UTF-16 including a surrogate pair and an invalid octet.
import std.rt
import std.cmdline
import std.str

// The block of NUL terminated strings `blob` holds exactly the strings
// `want[0..n]`? Compared one by one.
fn blob_has(blob: *mut rt.Buf, index: usize, want: str) -> bool {
    var at: usize = 0
    var k: usize = 0
    while k < index {
        while rt.buf_at(blob, at) != 0 as u8 {
            at = at + 1
        }
        at = at + 1
        k = k + 1
    }
    var j: usize = 0
    while j < want.length() {
        if rt.buf_at(blob, at + j) != want.chars(j) {
            return false
        }
        j = j + 1
    }
    return rt.buf_at(blob, at + want.length()) == 0 as u8
}

fn add(blob: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(blob, s.p as u64, s.length())
    rt.buf_push(blob, 0 as u8)
}

fn roundtrip(prog: str, a: *mut rt.Buf, n: usize) -> bool {
    var line: rt.Buf = rt.buf_new()
    cmdline.win_command_line(prog, a, n, &line)
    var back: rt.Buf = rt.buf_new()
    let text: str = str { p: rt.buf_data(&line), n: rt.buf_len(&line) }
    let m: usize = cmdline.win_split_command_line(text, &back)
    var ok: bool = m == n + 1
    if ok {
        ok = blob_has(&back, 0, prog)
    }
    var k: usize = 0
    var at: usize = 0
    while ok && k < n {
        // argument k of `a`
        var e: usize = at
        while rt.buf_at(a, e) != 0 as u8 {
            e = e + 1
        }
        let one: str = str { p: (rt.buf_ptr(a) + at as u64) as *mut u8, n: e - at }
        ok = blob_has(&back, k + 1, one)
        at = e + 1
        k = k + 1
    }
    rt.buf_free(&line)
    rt.buf_free(&back)
    return ok
}

fn main() -> i32 {
    // --- A. published examples
    var out: rt.Buf = rt.buf_new()
    var n: usize = cmdline.win_split_command_line("prog \"a b c\" d e", &out)
    if n != 4 { return 1 as i32 }
    if !blob_has(&out, 0, "prog") { return 2 as i32 }
    if !blob_has(&out, 1, "a b c") { return 3 as i32 }
    if !blob_has(&out, 2, "d") { return 4 as i32 }
    if !blob_has(&out, 3, "e") { return 5 as i32 }

    rt.buf_clear(&out)
    n = cmdline.win_split_command_line("prog \"ab\\\"c\" \"\\\\\" d", &out)
    if n != 4 { return 6 as i32 }
    if !blob_has(&out, 1, "ab\"c") { return 7 as i32 }
    if !blob_has(&out, 2, "\\") { return 8 as i32 }
    if !blob_has(&out, 3, "d") { return 9 as i32 }

    rt.buf_clear(&out)
    n = cmdline.win_split_command_line("prog a\\\\\\b d\"e f\"g h", &out)
    if n != 4 { return 10 as i32 }
    if !blob_has(&out, 1, "a\\\\\\b") { return 11 as i32 }
    if !blob_has(&out, 2, "de fg") { return 12 as i32 }
    if !blob_has(&out, 3, "h") { return 13 as i32 }

    rt.buf_clear(&out)
    n = cmdline.win_split_command_line("prog a\\\\\\\"b c d", &out)
    if n != 4 { return 14 as i32 }
    if !blob_has(&out, 1, "a\\\"b") { return 15 as i32 }

    rt.buf_clear(&out)
    n = cmdline.win_split_command_line("prog a\\\\\\\\\"b c\" d e", &out)
    if n != 4 { return 16 as i32 }
    if !blob_has(&out, 1, "a\\\\b c") { return 17 as i32 }
    if !blob_has(&out, 2, "d") { return 18 as i32 }

    // the program name: quotes, no backslash processing
    rt.buf_clear(&out)
    n = cmdline.win_split_command_line("\"C:\\Program Files\\x\\\" a", &out)
    if n != 2 { return 19 as i32 }
    if !blob_has(&out, 0, "C:\\Program Files\\x\\") { return 20 as i32 }
    if !blob_has(&out, 1, "a") { return 21 as i32 }

    // the "" inside quotes is one quote (post-2008 rule)
    rt.buf_clear(&out)
    n = cmdline.win_split_command_line("prog \"a \"\"b\"", &out)
    if n != 2 { return 22 as i32 }
    if !blob_has(&out, 1, "a \"b") { return 23 as i32 }

    // --- B. round trip
    var a: rt.Buf = rt.buf_new()
    add(&a, "plain")
    add(&a, "")
    add(&a, "a b")
    add(&a, "a\"b")
    add(&a, "a\\")
    add(&a, "a\\\\\"b")
    add(&a, "C:\\Program Files\\x\\")
    add(&a, "-Dname=\"a b\"")
    add(&a, "tab\there")
    add(&a, "{\"k\":\"v w\"}")
    add(&a, "\\\\server\\share dir\\")
    add(&a, "ends with backslashes \\\\\\")
    add(&a, "K\u{e4}se \u{1F600}")
    add(&a, "\"")
    add(&a, "\"\"")
    add(&a, "\\\"")
    add(&a, "-cp")
    add(&a, "libs/a.jar;libs/b.jar")
    if !roundtrip("C:\\Program Files\\Java\\bin\\javaw.exe", &a, 18) { return 30 as i32 }
    if !roundtrip("java", &a, 18) { return 31 as i32 }
    // an argument that needs no quotes is written unchanged
    var line: rt.Buf = rt.buf_new()
    var plain: rt.Buf = rt.buf_new()
    add(&plain, "-Xmx2G")
    add(&plain, "--demo")
    cmdline.win_command_line("java", &plain, 2, &line)
    let lt: str = str { p: rt.buf_data(&line), n: rt.buf_len(&line) }
    if lt != "java -Xmx2G --demo" { return 32 as i32 }
    rt.buf_clear(&line)
    var sp: rt.Buf = rt.buf_new()
    add(&sp, "")
    add(&sp, "a b")
    cmdline.win_command_line("p", &sp, 2, &line)
    let st: str = str { p: rt.buf_data(&line), n: rt.buf_len(&line) }
    if st != "p \"\" \"a b\"" { return 33 as i32 }

    // --- C. UTF-16
    var w: rt.Buf = rt.buf_new()
    var src: rt.Buf = rt.buf_new()
    add(&src, "K\u{e4}se\u{1F600}")
    // the octets of the string without the final zero
    cmdline.utf8_to_utf16(rt.buf_ptr(&src), rt.buf_len(&src) - 1, &w)
    if rt.buf_len(&w) != 12 { return 40 as i32 }
    if rt.ld16(rt.buf_ptr(&w), 0) != 75 as u16 { return 41 as i32 }
    if rt.ld16(rt.buf_ptr(&w), 1) != 228 as u16 { return 42 as i32 }
    if rt.ld16(rt.buf_ptr(&w), 4) != 55357 as u16 { return 43 as i32 }
    if rt.ld16(rt.buf_ptr(&w), 5) != 56832 as u16 { return 44 as i32 }
    rt.buf_clear(&w)
    var bad: [u8; 3] = [65 as u8, 255 as u8, 66 as u8]
    cmdline.utf8_to_utf16((&bad[0]) as u64, 3, &w)
    if rt.buf_len(&w) != 6 { return 45 as i32 }
    if rt.ld16(rt.buf_ptr(&w), 1) != 65533 as u16 { return 46 as i32 }

    rt.buf_free(&out)
    rt.buf_free(&a)
    rt.buf_free(&line)
    rt.buf_free(&plain)
    rt.buf_free(&sp)
    rt.buf_free(&src)
    rt.buf_free(&w)
    return 0
}
