// expect_exit: 0
// wasm_skip: under wasm32-browser plat.hostwin is the web twin (backend "web"), this case checks the default stub
import plat.hostwin
import plat.hostev

fn paint_none(ud: u64, w: u64) -> bool { return false }

fn event_none(ud: u64, w: u64, e: *mut hostev.HostEvent) -> bool { return false }

fn main() -> i32 {
    if hostwin.backend_name() != "none" { return 1 }
    if hostwin.app(0 as u64, paint_none, event_none) { return 2 }
    if hostwin.css_width(0 as u64) != 0 || hostwin.css_height(0 as u64) != 0 { return 3 }
    if hostwin.transitions(0 as u64) || hostwin.fade_busy(0 as u64) { return 4 }
    hostwin.want_frame(0 as u64)
    hostwin.cursor(hostev.CURSOR_TEXT)
    hostwin.damage(0 as u64, 0.0, 0.0, 1.0, 1.0)
    hostwin.set_keep(true)
    hostwin.set_opaque(true)
    hostwin.on_demand(true)
    hostwin.use_gpu(true)
    hostwin.gpu_enable()
    return 0
}
