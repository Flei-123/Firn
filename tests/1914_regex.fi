// expect_exit: 42
// tests/1914_regex.fi -- lib/regex (OpenPlan LIB-008): leftmost-first
// matching, groups, flags, replacement, the refusals -- and the linear
// time: a pattern that takes a backtracking engine 2^n steps finishes
// here in one pass. The comparison with Python's re over 20,000 random
// patterns is tools/libmvp/check_regex.py.
import regex.regex
import std.rt
import std.str

fn compile(p: str, flags: u32) -> regex.Regex {
    return regex.regex_compile(p, flags) catch | e | (never())
}

fn never() -> regex.Regex {
    syscall(60, 99, 0, 0, 0, 0, 0)
    return never()
}

// the span of the first match as "start-end", or "none"
fn span(p: str, flags: u32, s: str) -> i64 {
    var r: regex.Regex = compile(p, flags)
    var m: regex.Match = regex.match_new()
    var v: i64 = -1
    if regex.regex_find(&r, s, 0, &m) {
        v = m.start * 1000 + m.end
    }
    regex.regex_free(&r)
    return v
}

fn replaced(p: str, flags: u32, s: str, repl: str) -> str {
    var r: regex.Regex = compile(p, flags)
    let t: str = regex.regex_replace_all(&r, s, repl)
    regex.regex_free(&r)
    return t
}

fn refusal(p: str) -> i32 {
    var why: i32 = 0
    var r: regex.Regex = regex.regex_compile(p, 0 as u32) catch | e | (mark(e, &why))
    regex.regex_free(&r)
    return why
}

fn mark(e: RegexError, why: *mut i32) -> regex.Regex {
    if e == RegexError::Syntax { *why = 1 as i32 }
    if e == RegexError::Unsupported { *why = 2 as i32 }
    if e == RegexError::TooBig { *why = 3 as i32 }
    if e == RegexError::TooManyGroups { *why = 4 as i32 }
    return regex.regex_compile("", 0 as u32) catch | f | (never())
}

fn main() -> i32 {
    // --- A. leftmost-first
    if span("a|ab", 0 as u32, "ab") != 1 { return 1 as i32 } // 0-1
    if span("ab|a", 0 as u32, "ab") != 2 { return 2 as i32 }
    if span("a*?b", 0 as u32, "xaab") != 1004 { return 3 as i32 }
    if span("x{2,3}", 0 as u32, "xxxxx") != 3 { return 4 as i32 }
    if span("x{2,3}?", 0 as u32, "xxxxx") != 2 { return 5 as i32 }
    if span("K\\d+", 0 as u32, "-Q1 -K12 -K3") != 5008 { return 6 as i32 }
    if span("\\bK\\d\\b", 0 as u32, "AK1 K2") != 4006 { return 7 as i32 }
    if span("nope", 0 as u32, "abc") != -1 { return 8 as i32 }
    if span("", 0 as u32, "") != 0 { return 9 as i32 }
    // characters, not octets: "." eats all of "ä"
    if span("H.u", 0 as u32, "Häuser") != 4 { return 10 as i32 }
    if span("[äöü]+", 0 as u32, "Häuser") != 1003 { return 11 as i32 }
    // anchors and lines
    if span("^K", 0 as u32, "a\nK") != -1 { return 12 as i32 }
    if span("^K", regex.REGEX_MULTILINE, "a\nK") != 2003 { return 13 as i32 }
    if span("a$", 0 as u32, "a\n") != -1 { return 14 as i32 }
    if span("a$", regex.REGEX_MULTILINE, "a\n") != 1 { return 15 as i32 }
    if span("a.c", 0 as u32, "a\nc") != -1 { return 16 as i32 }
    if span("a.c", regex.REGEX_DOTALL, "a\nc") != 3 { return 17 as i32 }
    // case
    if span("schütz", regex.REGEX_ICASE, "-K1 SCHÜTZ") != 4011 { return 18 as i32 }
    if span("(?i)ΩΣ", 0 as u32, "ωσ") != 4 { return 19 as i32 }
    if span("(?i:k)1", 0 as u32, "k1") != 2 { return 20 as i32 }
    if span("(?i:k)1", 0 as u32, "K1") != 2 { return 21 as i32 }
    if span("[a-z]+", regex.REGEX_ICASE, "ABC") != 3 { return 22 as i32 }

    // --- B. groups
    var r: regex.Regex = compile("(?P<tag>-[A-Z]+)(?P<num>\\d+)(x)?", 0 as u32)
    if regex.regex_group_count(&r) != 4 as u32 { return 30 as i32 }
    if regex.regex_group_index(&r, "num") != 2 || regex.regex_group_index(&r, "nope") != -1 { return 31 as i32 }
    var m: regex.Match = regex.match_new()
    let s: str = "=+A1-QA12"
    if !regex.regex_find(&r, s, 0, &m) { return 32 as i32 }
    if regex.match_group_text(&m, s, 0 as u32) != "-QA12" { return 33 as i32 }
    if regex.match_group_text(&m, s, 1 as u32) != "-QA" { return 34 as i32 }
    if regex.match_group_text(&m, s, 2 as u32) != "12" { return 35 as i32 }
    var a: usize = 0
    var b: usize = 0
    if regex.match_group(&m, 3 as u32, &a, &b) { return 36 as i32 } // did not take part
    // searching from an offset
    if regex.regex_find(&r, s, 6, &m) { return 37 as i32 }
    regex.regex_free(&r)

    // --- C. replacement
    if replaced("-K(\\d+)", 0 as u32, "-K1 -K22 -Q3", "-Q$1") != "-Q1 -Q22 -Q3" { return 40 as i32 }
    if replaced("(\\w+)=(\\w+)", 0 as u32, "a=b c=d", "$2=$1") != "b=a d=c" { return 41 as i32 }
    if replaced("(?P<x>\\d)", 0 as u32, "a1b2", "<${x}>") != "a<1>b<2>" { return 42 as i32 }
    if replaced("\\d", 0 as u32, "a1", "$$") != "a$" { return 43 as i32 }
    if replaced("x*", 0 as u32, "abc", "-") != "-a-b-c-" { return 44 as i32 }
    if replaced("", 0 as u32, "äb", "|") != "|ä|b|" { return 45 as i32 }
    if replaced("(a)|b", 0 as u32, "ab", "[$1]") != "[a][]" { return 46 as i32 }
    if replaced("K", 0 as u32, "", "x") != "" { return 47 as i32 }

    // --- D. refusals
    if refusal("(a)\\1") != 2 { return 50 as i32 }
    if refusal("a(?=b)") != 2 { return 51 as i32 }
    if refusal("(?<=a)b") != 2 { return 52 as i32 }
    if refusal("(") != 1 || refusal(")") != 1 || refusal("[a") != 1 || refusal("*a") != 1 { return 53 as i32 }
    if refusal("a**") != 1 || refusal("x{3,2}") != 1 || refusal("[z-a]") != 1 || refusal("\\q") != 1 { return 54 as i32 }
    if refusal("x{1001}") != 3 || refusal("(x{1000}){1000}") != 3 { return 55 as i32 }
    if refusal("((((((((((((((((((((((((((((((((a))))))))))))))))))))))))))))))))") != 4 { return 56 as i32 }
    if refusal("a{") != 0 || refusal("a{x}") != 0 || refusal("[]a]") != 0 { return 57 as i32 }
    if refusal("ab)") != 1 || regex.regex_error_offset() != 2 { return 58 as i32 }

    // --- E. linear time: (a|a)*b and (a*)*b on 20,000 "a" -- a backtracking
    // engine needs 2^20000 steps; here it is one pass
    var buf: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 20000 {
        rt.buf_push(&buf, 97 as u8)
        i = i + 1
    }
    let many: str = str { p: rt.buf_data(&buf), n: rt.buf_len(&buf) }
    let t0: i64 = now_ms()
    if span("(a|a)*b", 0 as u32, many) != -1 { return 60 as i32 }
    if span("(a*)*b", 0 as u32, many) != -1 { return 61 as i32 }
    if span("^(a+)+$", 0 as u32, many) != 20000 { return 62 as i32 }
    if now_ms() - t0 > 20000 { return 63 as i32 } // generous for -O0 under qemu
    return 42
}

fn now_ms() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}
