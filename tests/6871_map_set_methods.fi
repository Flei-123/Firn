// expect_exit: 0
fn main() -> i32 {
    var m = Map[u32, int].new()
    m.set(1, 10)
    m.set(2, 20)
    m.set(3, 30)
    if m.get(1) != 10 || m.get_or(9, 7) != 7 || m.get(9) != 0 { return 1 }
    if !m.has(2) || m.has(9) { return 2 }
    if !m.remove(2) || m.remove(2) { return 3 }
    if m.len() != 2 || m.is_empty() { return 4 }
    var sum = 0
    let keys = m.keys()
    let values = m.values()
    var i: usize = 0
    while i < keys.len() {
        sum += keys.get(i) as int + values.get(i)
        i += 1
    }
    if keys.len() != 2 || sum != 44 { return 5 }
    m.clear()
    if !m.is_empty() { return 6 }
    var s = Set[u32].new()
    if !s.add(4) || s.add(4) { return 7 }
    if !s.has(4) || s.has(5) { return 8 }
    if s.len() != 1 { return 9 }
    if !s.remove(4) || s.remove(4) { return 10 }
    if !s.is_empty() { return 11 }
    return 0
}
