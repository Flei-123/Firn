// expect_exit: 0
// tests/3824_testkit_tables.fi -- testkit: assert_ne/lt/le/gt/ge, assert_eq_buf,
// sub_* cases (all passing here; the failing path is test 3825), tables,
// each_field, fixture slot, with_dir.
import std.io
import std.rt
import std.fs
import std.testkit

struct Fx { n: i64 }

fn dbl(n: i64) -> i64 { return n * 2 }
fn len_of(s: str) -> i64 { return s.length() as i64 }
fn fmt2(n: i64, b: *mut rt.Buf) { rt.buf_push_dec_i64(b, n); rt.buf_push_bytes(b, "!".p as u64, 1) }
fn one(f: str, ctx: u64) { *(ctx as *mut i64) = *(ctx as *mut i64) + f.length() as i64 }
fn in_dir(d: str, ctx: u64) {
    testkit.assert_true(fs.exists(d), "dir exists")
    *(ctx as *mut str) = d
}
fn uses_fixture() -> i64 { return (*(testkit.fixture() as *mut Fx)).n }

#[allow_escape]
fn main() -> i32 {
    if !gc_init() { return 1 }
    assert_ne[i32](1, 2)
    assert_lt[u8](1 as u8, 2 as u8)
    assert_le[i64](-3, -3)
    assert_gt[u64](18446744073709551615, 0)
    assert_ge[i16](5 as i16, 5 as i16)
    testkit.assert_ne_str("a", "b")
    var b: rt.Buf = rt.buf_new()
    fmt2(5, &b)
    testkit.assert_eq_buf(&b, "5!")
    rt.buf_free(&b)
    testkit.sub_eq_i64("a", 1, 1)
    testkit.sub_eq_str("b", "x", "x")
    testkit.sub_true("c", true)
    testkit.sub_end()
    testkit.table_i64_i64(dbl, "1=2,5=10,0=0,-3=-6")
    testkit.table_str_i64(len_of, "abc=3,=0,x=1,hello world=11")
    testkit.table_i64_str(fmt2, "1=1!,22=22!,-4=-4!")
    var total: i64 = 0
    testkit.each_field("a,bb,ccc,,", ",", one, (&total) as u64)
    testkit.check(total == 6, "each_field visits every field (empty ones too)")
    testkit.check(testkit.sub_failed() == 0, "no sub-case failed")
    var fx: Fx = Fx { n: 41 }
    testkit.fixture_set((&fx) as u64)
    testkit.check(uses_fixture() == 41, "fixture slot")
    var seen: str = ""
    testkit.with_dir(in_dir, (&seen) as u64)
    testkit.check(seen.length() > 3 && !fs.exists(seen), "with_dir removes the directory")
    return testkit.finish()
}
