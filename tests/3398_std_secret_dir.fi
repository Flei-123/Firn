// expect_exit: 0
// wasm_skip: needs /proc and the file system
// tests/3398_std_secret_dir.fi -- std.secret app-dir mode (secret_use_dir): the vault and a random key file live in one
// directory (Android: no HOME, no machine id). Set/get/delete survive a fresh read, the key file is mode 0600, a lost key file
// makes the vault unreadable (never a silent empty result), a relative or empty path is refused.
import std.secret
import std.fs
import std.rt
import std.io

fn scratch() -> str {
    var b: rt.Buf = rt.buf_new()
    let head: str = "/tmp/firn_secret_3398_"
    rt.buf_push_bytes(&b, head.p as u64, head.length())
    rt.buf_push_dec_i64(&b, syscall(39, 0, 0, 0, 0, 0, 0))
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

fn fails(n: *mut i64, what: str, ok: bool) {
    if !ok {
        *n = *n + 1
        io.print("FAIL ")
        io.print_line(what)
    }
}

fn main() -> i32 {
    var bad: i64 = 0
    fails(&bad, "relative path refused", !secret.secret_use_dir("rel/dir"))
    fails(&bad, "empty path refused", !secret.secret_use_dir(""))
    let dir: str = scratch() + "/priv/data"
    fails(&bad, "absolute path accepted", secret.secret_use_dir(dir))
    fails(&bad, "default path is inside the dir", (secret.secret_default_path() catch "") == dir + "/secrets.v1")
    let w: bool = secret.secret_set("svc", "token", "abc123") catch false
    fails(&bad, "set", w)
    fails(&bad, "vault file made", fs.exists(dir + "/secrets.v1"))
    fails(&bad, "key file made", fs.exists(dir + "/secrets.key"))
    let g: str = secret.secret_get("svc", "token") catch "ERR"
    fails(&bad, "get returns the value", g == "abc123")
    let w2: bool = secret.secret_set("svc", "token", "second") catch false
    let g2: str = secret.secret_get("svc", "token") catch "ERR"
    fails(&bad, "replace", w2 && g2 == "second")
    let st: fs.FileInfo = fs.stat(dir + "/secrets.key") catch fs.FileInfo { kind: 255 as u8, mode: 0 as u32, size: 0, mtime_ns: 0 }
    fails(&bad, "key file mode 0600", (st.mode & 511 as u32) == 384 as u32)
    fails(&bad, "key file is 32 octets", st.size == 32)
    let d: bool = secret.secret_delete("svc", "token") catch false
    let g3: str = secret.secret_get("svc", "token") catch "GONE"
    fails(&bad, "delete", d && g3 == "GONE")
    let w3: bool = secret.secret_set("svc", "token", "keep") catch false
    fs.remove(dir + "/secrets.key") catch false
    let g4: str = secret.secret_get("svc", "token") catch "LOST"
    fails(&bad, "lost key file never reads as a value", g4 != "keep")
    fs.remove_tree(scratch()) catch false
    if bad == 0 { io.print_line("OK") }
    return bad as i32
}
