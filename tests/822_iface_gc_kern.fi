// expect_exit: 0
// tests/822_iface_gc_kern.fi — DER SAMMLER UND DER FETTE ZEIGER (Runde 46).
//
// Die Frage, die dieser Test beantwortet: findet der Sammler ein Objekt noch,
// wenn es nur noch HINTER einem Schnittstellenwert steht?
//
// Der Aufbau:
//
//   * `gc class Zelle` — die Objekte leben auf dem GC-Heap
//   * `impl Zaehler for Zelle` — der Empfaenger `*self` ist damit `Gc[Zelle]`
//   * 64 Zellen werden erzeugt und AUSSCHLIESSLICH als `dyn Zaehler` in einem
//     Array im Rahmen abgelegt
//   * danach macht `muell(20000)` reichlich Abfall: Zellen, die niemand mehr
//     erreicht. Der Sammler laeuft an den Allokationsstellen von selbst
//     (SPEC §3.5.3) und gibt ihren Speicher zur Wiederverwendung frei.
//   * WAEREN DIE FETTEN ZEIGER KEINE WURZELN, wuerden die 64 Zellen mitgefegt
//     und ihr Speicher an den Abfall vergeben. Die Werte danach waeren Muell.
//     Genau das prueft `summe` nach jedem Schritt.
//   * `dazu` schreibt ueber die Schnittstelle in dieselben Objekte
//
// Dass der Sammler wirklich einsammelt (und der Test nicht nur deshalb gruen
// ist, weil nie etwas gefegt wird), zeigt die Zaehlung nach dem Sammellauf:
// von 20.064 Zellen leben danach hoechstens 200 — und die 64 aus dem Array
// sind darunter.

interface Zaehler {
    fn wert(*self) -> i64
    fn dazu(*mut self, k: i64)
}

gc class Zelle { n: i64 }

impl Zaehler for Zelle {
    fn wert(*self) -> i64 { return (*self).n }
    fn dazu(*mut self, k: i64) { (*self).n = (*self).n + k }
}

fn baue(i: i64) -> Gc[Zelle] {
    return gc Zelle{ n: i } catch gc_null[Zelle]()
}

// Abfall: die Zellen sind nach jedem Schleifendurchlauf unerreichbar.
fn muell(n: i64) -> i64 {
    var i: i64 = 0
    var s: i64 = 0
    while i < n {
        let z: Gc[Zelle] = baue(i)
        if z == gc_null[Zelle]() {
            return -1
        }
        s = s + 1
        i = i + 1
    }
    return s
}

fn summe(feld: *mut [dyn Zaehler; 64]) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < 64 {
        s = s + (*feld)[i].wert()
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    var feld: [dyn Zaehler; 64] = [(baue(0)) as dyn Zaehler; 64]
    var i: i64 = 0
    while i < 64 {
        feld[i as usize] = (baue(i)) as dyn Zaehler
        i = i + 1
    }
    // 0+1+...+63 = 2016
    if summe(&feld) != 2016 {
        return 1
    }
    // Reichlich Abfall erzeugen. Dabei sammelt die Laufzeit von selbst.
    if muell(20000) != 20000 {
        return 2
    }
    // Die 64 Zellen leben unveraendert — der Datenzeiger im fetten Zeiger ist
    // eine echte Wurzel.
    if summe(&feld) != 2016 {
        return 3
    }
    gc_collect()
    gc_collect()
    if gc_collections() < 2 {
        return 4
    }
    // NACH dem Sammellauf: die 64 leben, die 20.000 nicht. Die Obergrenze
    // laesst Luft fuer die wenigen Zufallstreffer des konservativen
    // Stapelscans (dieselbe Rechnung wie in tests/510).
    if gc_live_objects() < 64 {
        return 5
    }
    if gc_live_objects() > 200 {
        return 6
    }
    if summe(&feld) != 2016 {
        return 11
    }
    // ueber die Schnittstelle schreiben — trifft dieselben Objekte
    var k: usize = 0
    while k < 64 {
        feld[k].dazu(2)
        k = k + 1
    }
    if summe(&feld) != 2016 + 128 {
        return 7
    }
    if muell(20000) != 20000 {
        return 8
    }
    if summe(&feld) != 2016 + 128 {
        return 9
    }
    // Der Speicher bleibt beschraenkt: 40.000 unerreichbare Zellen wurden
    // wirklich wiederverwendet.
    if gc_heap_bytes() > 8388608 {
        return 10
    }
    return 0
}
