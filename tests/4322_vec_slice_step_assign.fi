// expect_exit: 0
// tests/4322_vec_slice_step_assign.fi -- r744: `v[a:b:c] = w` (extended slice assignment, equal sizes).
import std.io
import std.rt
import std.vec
import std.testkit

fn fill(n: i64) -> Vec[i64] {
    var v: Vec[i64] = vec_new[i64]()
    var i: i64 = 0
    while i < n {
        vec_push[i64](&v, i)
        i = i + 1
    }
    return v
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i64] = fill(8)
    var w: Vec[i64] = vec_new[i64]()
    vec_push[i64](&w, 10)
    vec_push[i64](&w, 20)
    vec_push[i64](&w, 30)
    vec_push[i64](&w, 40)
    v[::2] = w
    testkit.check(v[0] == 10 && v[1] == 1 && v[2] == 20 && v[4] == 30 && v[6] == 40 && v[7] == 7, "every second")
    var r: Vec[i64] = fill(4)
    r[::-1] = w
    testkit.check(r[0] == 40 && r[1] == 30 && r[2] == 20 && r[3] == 10, "reversed")
    // a view is written through
    var x: Vec[i64] = fill(8)
    var one: Vec[i64] = vec_new[i64]()
    vec_push[i64](&one, 99)
    vec_push[i64](&one, 98)
    x[1:6:3] = one
    testkit.check(x[1] == 99 && x[4] == 98 && vec_len[i64](&x) == 8, "range with step")
    // an aliasing source: v[::2] = v[1::2] (private copy of the source)
    var y: Vec[i64] = fill(6)
    y[::2] = y[1::2].copy()
    testkit.check(y[0] == 1 && y[2] == 3 && y[4] == 5 && y[1] == 1, "alias")
    // step 1 is a plain slice assignment (may change the length)
    var z: Vec[i64] = fill(4)
    z[1:2:1] = w
    testkit.check(vec_len[i64](&z) == 7 && z[1] == 10 && z[4] == 40 && z[5] == 2, "step 1 grows")
    // the empty selection
    var q: Vec[i64] = fill(3)
    var empty: Vec[i64] = vec_new[i64]()
    q[3::2] = empty
    testkit.check(vec_len[i64](&q) == 3, "empty")
    vec_free[i64](&v)
    vec_free[i64](&w)
    vec_free[i64](&r)
    vec_free[i64](&x)
    vec_free[i64](&one)
    vec_free[i64](&y)
    vec_free[i64](&z)
    vec_free[i64](&q)
    vec_free[i64](&empty)
    return testkit.finish()
}
