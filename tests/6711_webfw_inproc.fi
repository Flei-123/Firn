// expect_exit: 0
// wasm_skip: sockets and threads
// tests/6711_webfw_inproc.fi -- a webfw app in a thread against net.web: routes, params, JSON, middleware order, groups, 405.
import std.rt
import std.io
import std.net
import std.json
import std.testkit
import webfw.wf_types
import webfw.wf_web
import webfw.wf_ctx
import net.web

fn hello(c: *mut wf_types.Ctx) {
    wf_ctx.text(c, 200, "hi " + wf_ctx.param(c, "who") + " " + wf_ctx.query(c, "x"))
}

fn echo_json(c: *mut wf_types.Ctx) {
    if !wf_ctx.json_in(c) {
        wf_ctx.json_error(c, 400, "bad json")
        return
    }
    var w = wf_ctx.json_out(c, 201)
    json.jw_begin_object(&w)
    json.jw_key(&w, "v".p as u64, 1)
    json.jw_int(&w, wf_ctx.json_int(c, "v", 0 - 1) + 1)
    json.jw_end(&w)
    json.jw_free(&w)
}

fn trace(c: *mut wf_types.Ctx) -> bool {
    wf_ctx.set_header(c, "X-Trace", "on")
    return true
}

fn deny(c: *mut wf_types.Ctx) -> bool {
    wf_ctx.status_error(c, 403, "denied")
    return false
}

fn inner(c: *mut wf_types.Ctx) {
    wf_ctx.text(c, 200, "inner")
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return wf_web.serve_main(arg)
}

#[allow_escape]
fn main() -> i32 {
    var w: wf_types.Web = wf_web.web_new(0)
    wf_web.set_quiet(&w, true)
    w.app.addr = net.ADDR_LOCAL
    wf_web.get(&w, "/hi/:who", hello)
    wf_web.post(&w, "/j", echo_json)
    var open = wf_web.group(&w, "/open")
    wf_web.group_use(&open, trace)
    wf_web.g_get(&open, "/x", inner)
    var shut = wf_web.sub(&open, "/shut")
    wf_web.group_use(&shut, deny)
    wf_web.g_get(&shut, "/x", inner)
    let th: u64 = wf_web.serve_background(&w)
    let base: str = io.fmt_string(f"http://127.0.0.1:{wf_web.port(&w)}")
    var out: rt.Buf = rt.buf_new()
    testkit.check(web.get(base + "/hi/bob%20b?x=1%262", &out) == 200 as u32, "route status")
    testkit.check(rt.buf_str(&out) == "hi bob b 1&2", "route body")
    testkit.check(web.post_json(base + "/j", "{\"v\": 41}", &out) == 201 as u32, "json status")
    testkit.check(rt.buf_str(&out) == "{\"v\":42}", "json body")
    testkit.check(web.post_json(base + "/j", "{nope", &out) == 400 as u32, "bad json status")
    testkit.check(web.get(base + "/j", &out) == 405 as u32, "method not allowed")
    testkit.check(web.get(base + "/open/x", &out) == 200 as u32 && rt.buf_str(&out) == "inner", "group route")
    testkit.check(web.get(base + "/open/shut/x", &out) == 403 as u32, "nested middleware stops the chain")
    testkit.check(web.get(base + "/nothing", &out) == 404 as u32, "404")
    wf_web.stop_wait(&w, th)
    return testkit.finish()
}
