// expect_exit: 0
// 'try' reicht den Fehler unveraendert nach oben durch — ueber zwei Ebenen.
error E { A, B }

fn stufe0(n: i32) -> E!i32 {
    if n == 0 {
        return E::B
    }
    return n
}

fn stufe1(n: i32) -> E!i32 {
    let v = try stufe0(n)
    return v * 2
}

fn stufe2(n: i32) -> E!i32 {
    let v = try stufe1(n)
    return v + 1
}

fn main() -> i32 {
    if (stufe2(3) catch 0) != 7 {
        return 1
    }
    if (stufe2(0) catch 0 - 5) != 0 - 5 {
        return 2
    }
    return 0
}
