// expect_exit: 0
import mc.mc_focus

fn main() -> i32 {
    var p: u32 = mc_focus.focus_loss_plan(true, false, true, false, false, false)
    if p != (mc_focus.FL_RELEASE | mc_focus.FL_PAUSE) { return 1 }
    p = mc_focus.focus_loss_plan(false, false, true, false, false, false)
    if p != 0 as u32 { return 2 }
    p = mc_focus.focus_loss_plan(true, true, true, false, false, false)
    if p != mc_focus.FL_RELEASE { return 3 }
    p = mc_focus.focus_loss_plan(true, false, false, false, false, false)
    if p != mc_focus.FL_RELEASE { return 4 }
    p = mc_focus.focus_loss_plan(true, false, true, true, false, false)
    if p != mc_focus.FL_RELEASE { return 5 }
    p = mc_focus.focus_loss_plan(true, false, true, false, true, false)
    if p != mc_focus.FL_RELEASE { return 6 }
    p = mc_focus.focus_loss_plan(true, false, true, false, false, true)
    if p != mc_focus.FL_RELEASE { return 7 }
    if !mc_focus.may_grab(true, false, false, false, false) { return 8 }
    if mc_focus.may_grab(false, false, false, false, false) { return 9 }
    if mc_focus.may_grab(true, true, false, false, false) { return 10 }
    if mc_focus.may_grab(true, false, true, false, false) { return 11 }
    if mc_focus.may_grab(true, false, false, true, false) { return 12 }
    if mc_focus.may_grab(true, false, false, false, true) { return 13 }
    return 0
}
