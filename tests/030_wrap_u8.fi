// expect_exit: 44
// only_mode: opt
// ROUND 72: this program exists to show the wraparound of `u8` addition, which is true by
// definition only in the ONE build level that does not check it --
// `--opt-level=release-fast` (SPEC 13, item L9). dev/dev-fast/
// release-safe correctly panic on it instead.
// Wrapping arithmetic on u8: 200 + 100 = 300 & 0xFF = 44
fn main() -> i32 {
    var a: u8 = 200
    let b: u8 = 100
    a = a + b
    return a as i32
}
