// expect_exit: 57
// only_mode: opt
// ROUND 72: this program exists to show the truncation of a narrowing `as`, which is true by
// definition only in the ONE build level that does not check it --
// `--opt-level=release-fast` (SPEC 13, item L9). dev/dev-fast/
// release-safe correctly panic on it instead.
// 313 truncated to u8 = 57
fn main() -> i32 {
    let a: i32 = 313
    let b: u8 = a as u8
    return b as i32
}
