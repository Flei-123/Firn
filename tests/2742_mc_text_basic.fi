// expect_exit: 0
// tests/2742_mc_text_basic.fi -- mc_text: flattening, style inheritance, translate, legacy codes, limits.
// The exhaustive comparison with an independent python implementation is tools/mc/text/run.sh.
import std.rt
import mc.mc_text

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn flat(json: u64, n: usize, t: *mut mc_text.TextDoc, tr: *mut mc_text.Translations) -> bool {
    return mc_text.text_from_json(t, json, n, tr)
}

fn plain_is(t: *mut mc_text.TextDoc, want: u64, n: usize) -> bool {
    return mc_text.text_len(t) == n && rt.mem_eq(mc_text.text_ptr(t), want, n)
}

fn main() -> i32 {
    var tr: mc_text.Translations = mc_text.tr_new()
    let lang: str = "\x7b\"hello\":\"Hi %s and %1$s, 100%%\"}"
    check(mc_text.tr_load(&tr, lang.p as u64, lang.n), 1)
    check(mc_text.tr_count(&tr) == 1, 2)

    // a plain string
    var a: mc_text.TextDoc = mc_text.text_new()
    check(flat("\"abc\"".p as u64, 5, &a, &tr), 3)
    check(plain_is(&a, "abc".p as u64, 3) && mc_text.text_span_count(&a) == 1, 4)
    check(mc_text.text_span_color(&a, 0) == mc_text.NO_COLOR && mc_text.text_span_flags(&a, 0) == 0 as u32, 5)
    mc_text.text_free(&a)

    // inheritance: the extra component keeps red + bold and adds italic; "bold": false switches it off again
    var b: mc_text.TextDoc = mc_text.text_new()
    let j: str = "\x7b\"text\":\"A\",\"color\":\"red\",\"bold\":true,\"extra\":[{\"text\":\"B\",\"italic\":true},{\"text\":\"C\",\"bold\":false}]}"
    check(flat(j.p as u64, j.n, &b, &tr), 6)
    check(plain_is(&b, "ABC".p as u64, 3) && mc_text.text_span_count(&b) == 3, 7)
    check(mc_text.text_span_color(&b, 1) == 16733525, 8)
    check(mc_text.text_span_flags(&b, 0) == mc_text.F_BOLD, 9)
    check(mc_text.text_span_flags(&b, 1) == (mc_text.F_BOLD | mc_text.F_ITALIC), 10)
    check(mc_text.text_span_flags(&b, 2) == 0 as u32, 11)
    mc_text.text_free(&b)

    // translate: %s, %1$s, %% and an unknown key (shows as itself)
    var c: mc_text.TextDoc = mc_text.text_new()
    let t1: str = "\x7b\"translate\":\"hello\",\"with\":[\"Bob\"]}"
    check(flat(t1.p as u64, t1.n, &c, &tr), 12)
    check(plain_is(&c, "Hi Bob and Bob, 100%".p as u64, 20), 13)
    mc_text.text_free(&c)
    var d: mc_text.TextDoc = mc_text.text_new()
    let t2: str = "\x7b\"translate\":\"no.such.key\"}"
    check(flat(t2.p as u64, t2.n, &d, &tr), 14)
    check(plain_is(&d, "no.such.key".p as u64, 11), 15)
    mc_text.text_free(&d)

    // an array is the first element with the others as its extra; #RRGGBB
    var e: mc_text.TextDoc = mc_text.text_new()
    let arr: str = "[\x7b\"text\":\"x\",\"color\":\"#102030\"},\"y\"]"
    check(flat(arr.p as u64, arr.n, &e, &tr), 16)
    check(mc_text.text_span_count(&e) == 1 && mc_text.text_span_color(&e, 0) == 1056816, 17) // both inherit #102030
    mc_text.text_free(&e)

    // legacy codes in and out
    var f: mc_text.TextDoc = mc_text.text_new()
    let lg: str = "\u{a7}aGreen\u{a7}lBold\u{a7}r!"
    mc_text.text_from_legacy(&f, lg.p as u64, lg.n)
    check(plain_is(&f, "GreenBold!".p as u64, 10) && mc_text.text_span_count(&f) == 3, 18)
    check(mc_text.text_span_color(&f, 0) == 5635925, 19) // legacy code a = 0x55FF55
    check(mc_text.text_span_flags(&f, 1) == mc_text.F_BOLD && mc_text.text_span_color(&f, 2) == mc_text.NO_COLOR, 24)
    mc_text.text_free(&f)

    // not JSON: false, nothing added
    var g: mc_text.TextDoc = mc_text.text_new()
    check(!flat("\x7b\"text\":".p as u64, 8, &g, &tr), 20)
    check(mc_text.text_len(&g) == 0, 21)
    mc_text.text_free(&g)

    // depth limit: 100 nested arrays do not crash and cut off
    var deep: rt.Buf = rt.buf_new()
    var i: i32 = 0
    while i < 100 {
        rt.buf_push(&deep, 91 as u8)
        i = i + 1
    }
    rt.buf_push_bytes(&deep, "\"x\"".p as u64, 3)
    i = 0
    while i < 100 {
        rt.buf_push(&deep, 93 as u8)
        i = i + 1
    }
    var h: mc_text.TextDoc = mc_text.text_new()
    check(flat(rt.buf_ptr(&deep), rt.buf_len(&deep), &h, &tr), 22)
    check(mc_text.text_len(&h) == 0, 23) // cut at MAX_DEPTH, the text is not reached
    mc_text.text_free(&h)
    rt.buf_free(&deep)
    mc_text.tr_free(&tr)
    return 0
}
