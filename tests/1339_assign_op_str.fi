// expect_out: hello world|abcabc|1 |ok
// tests/1339_assign_op_str.fi -- `+=` on `str` (round 70, parts 1 and 5).
//
// `s += x` is `s = s + x`, and on `str` that means: the collector builds
// new octets, both operands stay untouched (`str` is immutable). The target
// is passed to `__str_concat` as an ARGUMENT and written back at the same
// time -- and its address is computed exactly ONCE while doing so
// (`pin_set` in the lowering).
import std.io
import std.str

fn main() -> i32 {
    if !gc_init() { return 1 }
    var s: str = "hello"
    s += " world"
    if s != "hello world" { return 2 }
    io.print_str(s)

    // in a loop: three times the same piece
    var t: str = ""
    var k: i32 = 0
    while k < 3 {
        t += "abc"
        k++
    }
    if t.length() != 9 { return 3 }
    if t != "abcabcabc" { return 4 }
    var bar: [u8; 1] = "|"
    io.print_bytes((&bar[0]) as u64, 1)
    io.print_str(str.span_part(t, 0, 6))

    // an ARRAY ELEMENT of type str as target -- the index runs once
    var calls: i32 = 0
    var lines: [str; 2] = ["a", "b"]
    lines[bump(&calls)] += "!"
    if calls != 1 { return 5 }
    if lines[1] != "b!" { return 6 }
    io.print_bytes((&bar[0]) as u64, 1)
    io.fmt_print(f"{calls} ")

    // the collector really took the intermediate results back
    gc_collect()
    io.println_str("|ok")
    return 0
}

fn bump(c: *mut i32) -> usize {
    *c += 1
    return 1
}
