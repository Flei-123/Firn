// expect_exit: 0
import std.io

struct Clock {
    time: i64,
}

fn math(a: i32) -> i32 {
    return a + 1
}

fn main() -> i32 {
    var bad: i32 = 0
    let c: Clock = Clock { time: 5 }
    if c.time != 5 {
        bad = bad + 1
    }
    if math(2) != 3 {
        bad = bad + 2
    }
    let json: i32 = 4
    if json + 1 != 5 {
        bad = bad + 4
    }
    io.print_line("own names win")
    return bad
}
