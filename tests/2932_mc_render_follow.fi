// expect_exit: 0
// tests/2932_mc_render_follow.fi -- mc_render_world.wr_region_follow: the light region follows the player and dirties
// exactly the cached sections of the old + new region rectangle (nothing when the region is kept).
import std.rt
import mc.mc_chunk
import mc.mc_world
import mc.mc_mesh
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_render_world
import mc.mc_wlight

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn frame(wr: *mut mc_render_world.WorldRender, w: *mut mc_world.World, r: *mut mc_raster.Raster, cam: *mut mc_camera.Camera) {
    mc_raster.backend_begin(r, cam, 0xFF000000 as u32)
    mc_render_world.wr_render(wr, w, r, cam, 0 - 1)
}

fn main() -> i32 {
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: rt.heap_alloc(32768), tiles: rt.heap_alloc(32768 * 6 * 2) }
    var i: usize = 0
    while i < 32768 {
        rt.st8(tb.opaque, i, 0 as u8)
        i = i + 1
    }
    i = 0
    while i < 32768 * 6 {
        rt.st16(tb.tiles, i, 0 as u16)
        i = i + 1
    }
    i = 0
    while i < 6 {
        rt.st16(tb.tiles, 6 + i, (1 + i) as u16)
        i = i + 1
    }
    rt.st8(tb.opaque, 1, 1 as u8)
    var w: mc_world.World = mc_world.world_new()
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var cx: i32 = 0
    while cx < 3 {
        i = 0
        while i < 8192 {
            rt.st16(ids, i, 0 as u16)
            i = i + 1
        }
        i = 0
        while i < 4 * 256 {
            rt.st16(ids, i, 1 as u16)
            i = i + 1
        }
        check(mc_world.world_put(&w, mc_render_world.wr_make_chunk(cx, 0, 2, ids)), 1)
        cx = cx + 1
    }
    // light: block 1 is a solid filter-15 block
    var wl: mc_wlight.WorldLight = mc_wlight.wl_new(0 - 64, 2)
    let op: u64 = rt.heap_alloc(32768)
    let em: u64 = rt.heap_alloc(32768)
    i = 0
    while i < 32768 {
        rt.st8(op, i, 0 as u8)
        rt.st8(em, i, 0 as u8)
        i = i + 1
    }
    rt.st8(op, 1, 15 as u8)
    mc_wlight.wl_set_tables(&wl, op, em)
    var cam: mc_camera.Camera = mc_camera.camera_new(160, 90)
    mc_camera.camera_set_pos(&cam, 24.0, -64.0 + 9.0, 0.0)
    mc_camera.camera_set_angles(&cam, 0.0, 35.0)
    mc_camera.camera_update(&cam)
    var r: mc_raster.Raster = mc_raster.raster_new(160, 90)
    mc_raster.backend_upload_atlas(&r, &a)
    var wr: mc_render_world.WorldRender = mc_render_world.wr_new(0 - 64, 8, &tb)

    // no light set: follow does nothing
    check(mc_render_world.wr_region_follow(&wr, &w, 1, 0, 3, 3, 1, false) == 0, 2)
    mc_render_world.wr_set_light(&wr, (&wl) as *mut mc_wlight.WorldLight as u64)
    frame(&wr, &w, &r, &cam)
    check(wr.st.meshed >= 1 as u32, 3)
    frame(&wr, &w, &r, &cam)
    check(wr.st.meshed == 0 as u32, 4)

    // first load: everything cached is dirtied once
    check(mc_render_world.wr_region_follow(&wr, &w, 1, 0, 3, 3, 1, false) == 2, 5)
    check(wl.cx0 == 0 && wl.cz0 == 0 - 1 && wl.ncx == 3, 6)
    frame(&wr, &w, &r, &cam)
    check(wr.st.meshed >= 1 as u32, 7)
    frame(&wr, &w, &r, &cam)
    check(wr.st.meshed == 0 as u32, 8)

    // kept: nothing dirty
    check(mc_render_world.wr_region_follow(&wr, &w, 1, 0, 3, 3, 1, false) == 0, 9)
    frame(&wr, &w, &r, &cam)
    check(wr.st.meshed == 0 as u32, 10)

    // moved by one column: dirty again, then calm
    check(mc_render_world.wr_region_follow(&wr, &w, 2, 0, 3, 3, 1, false) == 1, 11)
    check(wl.cx0 == 1, 12)
    frame(&wr, &w, &r, &cam)
    check(wr.st.meshed >= 1 as u32, 13)
    frame(&wr, &w, &r, &cam)
    check(wr.st.meshed == 0 as u32, 14)
    mc_render_world.wr_free(&wr, &r)
    mc_wlight.wl_free(&wl)
    mc_world.world_free(&w)
    return 0
}
