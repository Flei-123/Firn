import jxl.jxl
import jxl.jxl_dither
import std.fs
import std.rt

static mut failures: i32 = 0
static mut mismatches: usize = 0
static mut total_samples: usize = 0
static mut max_diff: i32 = 0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn body_offset(d: *mut rt.Buf, n: usize, lines: u32) -> usize {
    var nl: u32 = 0
    var i: usize = 0
    while i < n && nl < lines {
        if rt.ld8(rt.buf_ptr(d), i) == 10 {
            nl = nl + 1
        }
        i = i + 1
    }
    return i
}

fn measure(path: str, ref_path: str, ref_lines: u32, channels: u32) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    var ref: rt.Buf = rt.buf_new()
    let rn: usize = fs.read_file(ref_path, &ref) catch 0
    check(n != 0 && rn != 0)
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let ok: bool = jxl.jxl_decode(rt.buf_ptr(&data), n, &pic) catch false
    check(ok)
    mismatches = 0
    total_samples = 1
    max_diff = 99
    if ok {
        let total: usize = (pic.width as usize) * (pic.height as usize) * (channels as usize)
        let off: usize = body_offset(&ref, rn, ref_lines)
        check(pic.channels == channels && pic.bytes_per_sample == 1 && pic.size == total && rn >= off + total)
        if pic.size == total && rn >= off + total {
            let base: u64 = rt.buf_ptr(&ref) + (off as u64)
            var bad: usize = 0
            var worst: i32 = 0
            var i: usize = 0
            while i < total {
                var e: i32 = (rt.ld8(pic.data, i) as i32) - (rt.ld8(base, i) as i32)
                if e < 0 {
                    e = 0 - e
                }
                if e != 0 {
                    bad = bad + 1
                }
                if e > worst {
                    worst = e
                }
                i = i + 1
            }
            mismatches = bad
            total_samples = total
            max_diff = worst
        }
    }
    jxl.jxl_picture_free(&pic)
    rt.buf_free(&data)
    rt.buf_free(&ref)
}

fn expect_ppm(jxl_path: str, ref_path: str, limit_per_10k: usize) {
    measure(jxl_path, ref_path, 3, 3)
    check(max_diff <= 1)
    check(mismatches * 10000 <= limit_per_10k * total_samples)
}

fn expect_pam(jxl_path: str, ref_path: str, limit_per_10k: usize) {
    measure(jxl_path, ref_path, 7, 4)
    check(max_diff <= 1)
    check(mismatches * 10000 <= limit_per_10k * total_samples)
}

fn main() -> i32 {
    expect_pam("tests/data/jxl/ecmix/rgba300_vd_c1_e2.jxl", "tests/data/jxl/ecmix/rgba300_vd_c1_e2.pam", 5)
    expect_pam("tests/data/jxl/ecmix/rgba300_md_c2_e8.jxl", "tests/data/jxl/ecmix/rgba300_md_c2_e8.pam", 5)
    expect_pam("tests/data/jxl/ecmix/rgba300_vd_c4_e8.jxl", "tests/data/jxl/ecmix/rgba300_vd_c4_e8.pam", 5)
    expect_pam("tests/data/jxl/ecmix/rgba64_md_c2_e4.jxl", "tests/data/jxl/ecmix/rgba64_md_c2_e4.pam", 5)
    expect_pam("tests/data/jxl/ecup/rgba300_vd_r2.jxl", "tests/data/jxl/ecup/rgba300_vd_r2.pam", 5)
    expect_pam("tests/data/jxl/ecup/rgba300_md_r4.jxl", "tests/data/jxl/ecup/rgba300_md_r4.pam", 5)
    expect_pam("tests/data/jxl/ecup/rgba300_vd_r8.jxl", "tests/data/jxl/ecup/rgba300_vd_r8.pam", 5)
    expect_pam("tests/data/jxl/vd/rgba300_a.jxl", "tests/data/jxl/vd/rgba300_a.pam", 5)
    expect_ppm("tests/data/jxl/nx/s300x200_noise1600.jxl", "tests/data/jxl/nx/s300x200_noise1600.ppm", 5)
    expect_ppm("tests/data/jxl/nx/s600x300_noise3200.jxl", "tests/data/jxl/nx/s600x300_noise3200.ppm", 5)
    expect_ppm("tests/data/jxl/nx/text_noise6400.jxl", "tests/data/jxl/nx/text_noise6400.ppm", 5)
    expect_ppm("tests/data/jxl/nx/text_noise800.jxl", "tests/data/jxl/nx/text_noise800.ppm", 5)
    expect_ppm("tests/data/jxl/pns/s300x200_noise.jxl", "tests/data/jxl/pns/s300x200_noise.ppm", 5)
    expect_ppm("tests/data/jxl/nup/s300x200_vd_r4.jxl", "tests/data/jxl/nup/s300x200_vd_r4.ppm", 5)
    expect_ppm("tests/data/jxl/vd/s300x200_e7.jxl", "tests/data/jxl/vd/s300x200_e7.ppm", 5)
    expect_ppm("tests/data/jxl/or/o2_vd.jxl", "tests/data/jxl/or/o2_vd.ppm", 5)
    expect_ppm("tests/data/jxl/or/o3_md.jxl", "tests/data/jxl/or/o3_md.ppm", 5)
    expect_ppm("tests/data/jxl/or/o4_vd.jxl", "tests/data/jxl/or/o4_vd.ppm", 5)
    expect_ppm("tests/data/jxl/or/o5_md.jxl", "tests/data/jxl/or/o5_md.ppm", 5)
    expect_ppm("tests/data/jxl/or/o6_vd.jxl", "tests/data/jxl/or/o6_vd.ppm", 5)
    expect_ppm("tests/data/jxl/or/o6_md.jxl", "tests/data/jxl/or/o6_md.ppm", 5)
    expect_ppm("tests/data/jxl/or/o7_vd.jxl", "tests/data/jxl/or/o7_vd.ppm", 5)
    expect_ppm("tests/data/jxl/or/o8_md.jxl", "tests/data/jxl/or/o8_md.ppm", 5)
    jxl_dither.dither_set_enabled(false)
    measure("tests/data/jxl/nx/s300x200_noise1600.jxl", "tests/data/jxl/nx/s300x200_noise1600.ppm", 3, 3)
    check(mismatches * 100 > 5 * total_samples)
    measure("tests/data/jxl/ecmix/rgba300_vd_c1_e2.jxl", "tests/data/jxl/ecmix/rgba300_vd_c1_e2.pam", 7, 4)
    check(mismatches * 100 > 5 * total_samples)
    jxl_dither.dither_set_enabled(true)
    return failures
}
