// expect_exit: 0
// tests/2750_mc_camera.fi -- mc_camera with hand-computed values. Randomised cross-check against
// an independent numpy implementation: tools/mc/camera/run.sh.

import std.rt
import std.math
import mc.mc_math
import mc.mc_camera

fn near(a: f64, b: f64) -> bool {
    return math.fabs(a - b) < 1.0e-9
}

fn main(start: u64) -> i32 {
    var c: mc_camera.Camera = mc_camera.camera_new(640, 360)
    mc_camera.camera_set_pos(&c, 10.0, 70.0, -5.0)
    mc_camera.camera_set_angles(&c, 0.0, 0.0)
    mc_camera.camera_update(&c)
    // yaw 0 = south (+z)
    if !near(c.fz, 1.0) || !near(c.fx, 0.0) || !near(c.fy, 0.0) { return 1 }
    // facing south the right hand is west (-x), up is +y
    if !near(c.rx, -1.0) || !near(c.uy, 1.0) { return 2 }
    mc_camera.camera_set_angles(&c, 90.0, 0.0)
    mc_camera.camera_update(&c)
    if !near(c.fx, -1.0) || !near(c.fz, 0.0) { return 3 }
    mc_camera.camera_set_angles(&c, -90.0, 0.0)
    mc_camera.camera_update(&c)
    if !near(c.fx, 1.0) { return 4 }
    // pitch +90 looks straight down, basis stays finite
    mc_camera.camera_set_angles(&c, 30.0, 95.0)
    if !near(c.pitch, 90.0) { return 5 }
    mc_camera.camera_update(&c)
    if !near(c.fy, -1.0) || !near(c.uy, 0.0) { return 6 }
    if !math.is_finite(c.view.m[0]) || !math.is_finite(c.uz) { return 7 }
    // yaw wrap
    mc_camera.camera_set_angles(&c, 270.0, 0.0)
    if !near(c.yaw, -90.0) { return 8 }
    mc_camera.camera_set_angles(&c, 180.0, 0.0)
    if !near(c.yaw, -180.0) { return 9 }

    // projection: a point straight ahead lands in the image centre
    mc_camera.camera_set_angles(&c, 0.0, 0.0)
    mc_camera.camera_update(&c)
    var p: mc_math.Vec3 = mc_math.v3(0.0, 0.0, 0.0)
    if !mc_camera.camera_project(&c, 10.0, 70.0, 5.0, &p) { return 10 }
    if !near(p.x, 320.0) || !near(p.y, 180.0) || !near(p.z, 10.0) { return 11 }
    // behind the camera
    if mc_camera.camera_project(&c, 10.0, 70.0, -50.0, &p) { return 12 }
    // 1 block to the west (-x) at distance 1 with fov 70: right side of the image
    mc_camera.camera_set_lens(&c, 90.0, 0.05, 100.0)
    mc_camera.camera_resize(&c, 200, 100)
    mc_camera.camera_update(&c)
    // tan(45) = 1: vertical half extent at distance 1 is 1 block, horizontal 2 blocks
    if !mc_camera.camera_project(&c, 9.0, 70.0, -4.0, &p) { return 13 }
    if !near(p.x, 100.0 + 50.0) || !near(p.y, 50.0) { return 14 }
    if !mc_camera.camera_project(&c, 10.0, 71.0, -4.0, &p) { return 15 }
    if !near(p.x, 100.0) || !near(p.y, 0.0) { return 16 }

    // pick ray: centre pixel = forward, corners are unit length
    var o: mc_math.Vec3 = mc_math.v3(0.0, 0.0, 0.0)
    var d: mc_math.Vec3 = mc_math.v3(0.0, 0.0, 0.0)
    mc_camera.camera_pick_ray(&c, 100.0, 50.0, &o, &d)
    if !near(d.z, 1.0) || !near(d.x, 0.0) || !near(o.x, 10.0) { return 17 }
    mc_camera.camera_pick_ray(&c, 0.0, 0.0, &o, &d)
    if !near(math.sqrt(d.x * d.x + d.y * d.y + d.z * d.z), 1.0) { return 18 }
    // top left corner: left = east (+x) when facing south, up
    if !(d.x > 0.0) || !(d.y > 0.0) || !(d.z > 0.0) { return 19 }
    // the ray of the projected pixel hits the projected point's direction
    mc_camera.camera_project(&c, 13.0, 72.0, 0.0, &p)
    mc_camera.camera_pick_ray(&c, p.x, p.y, &o, &d)
    let tx: f64 = 13.0 - 10.0
    let ty: f64 = 72.0 - 70.0
    let tz: f64 = 0.0 - (0.0 - 5.0)
    let tl: f64 = math.sqrt(tx * tx + ty * ty + tz * tz)
    if !near(d.x, tx / tl) || !near(d.y, ty / tl) || !near(d.z, tz / tl) { return 20 }

    // frustum: a section ahead is visible, behind is not
    mc_camera.camera_set_pos(&c, 8.0, 8.0, 8.0)
    mc_camera.camera_set_angles(&c, 0.0, 0.0)
    mc_camera.camera_set_lens(&c, 70.0, 0.05, 256.0)
    mc_camera.camera_resize(&c, 640, 360)
    mc_camera.camera_update(&c)
    if mc_camera.camera_section_visible(&c, 0, 4, 3, -64) == 0 { return 21 }
    // section index 4 with min_y -64 is y 0..16: the camera is inside the section (0,4,0)
    if mc_camera.camera_section_visible(&c, 0, 4, 0, -64) == 0 { return 22 }
    if mc_camera.camera_section_visible(&c, 0, 4, -4, -64) != 0 { return 23 }
    // far plane
    if mc_camera.camera_section_visible(&c, 0, 4, 40, -64) != 0 { return 24 }
    // too far to the side
    if mc_camera.camera_section_visible(&c, 30, 4, 2, -64) != 0 { return 25 }
    if mc_camera.camera_box_visible(&c, 7.0, 7.0, 20.0, 9.0, 9.0, 22.0) != 2 { return 26 }

    // look_at
    mc_camera.camera_set_pos(&c, 0.0, 0.0, 0.0)
    mc_camera.camera_look_at(&c, 0.0, 0.0, 10.0)
    if !near(c.yaw, 0.0) || !near(c.pitch, 0.0) { return 27 }
    mc_camera.camera_look_at(&c, -10.0, 0.0, 0.0)
    if !near(c.yaw, 90.0) { return 28 }
    mc_camera.camera_look_at(&c, 0.0, -5.0, 0.0)
    if !near(c.pitch, 90.0) { return 29 }
    mc_camera.camera_look_at(&c, 5.0, 5.0, 5.0)
    mc_camera.camera_update(&c)
    var q: mc_math.Vec3 = mc_math.v3(0.0, 0.0, 0.0)
    mc_camera.camera_to_view(&c, 5.0, 5.0, 5.0, &q)
    if !near(q.x, 0.0) || !near(q.y, 0.0) || !near(q.z, math.sqrt(75.0)) { return 30 }

    // block pick: a wall of solid blocks at z = 20 is hit by the centre pixel
    let ids: u64 = rt.heap_alloc(32 * 32 * 32 * 2)
    var i: usize = 0
    while i < 32 * 32 * 32 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    var yy: usize = 0
    while yy < 32 {
        var xx: usize = 0
        while xx < 32 {
            rt.st16(ids, (yy * 32 + 20) * 32 + xx, 1 as u16)
            xx = xx + 1
        }
        yy = yy + 1
    }
    let solid: u64 = rt.heap_alloc(4)
    rt.st8(solid, 0, 0 as u8)
    rt.st8(solid, 1, 1 as u8)
    var g: mc_math.BlockGrid = mc_math.grid_view(0, 0, 0, 32, 32, 32, ids, solid, 2 as u32, false)
    mc_camera.camera_set_pos(&c, 16.5, 16.5, 5.5)
    mc_camera.camera_set_angles(&c, 0.0, 0.0)
    mc_camera.camera_update(&c)
    var hit: mc_math.RayHit = mc_math.RayHit { x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, dist: 0.0, id: 0 }
    if !mc_camera.camera_pick_block(&c, &g, 320.0, 180.0, 50.0, &hit) { return 31 }
    if hit.x != 16 || hit.y != 16 || hit.z != 20 || hit.nz != -1 { return 32 }
    if !near(hit.dist, 14.5) { return 33 }
    // out of reach
    if mc_camera.camera_pick_block(&c, &g, 320.0, 180.0, 10.0, &hit) { return 34 }
    return 0
}
