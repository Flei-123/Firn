// expect_exit: 0
// tests/3663_text_fuzzy.fi -- text.fuzzy: positions, case modes, boundary bonuses, ranking, UTF-8, bad bytes.
// The comparison with reference tools over thousands of random cases is tools/textlibs_cross/run.sh.
import text.fuzzy
import std.rt
import std.vec

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn sp(s: str) -> u64 {
    return s.p as u64
}

fn buf_is(b: *mut rt.Buf, s: str) -> bool {
    return rt.buf_len(b) == s.n && rt.mem_eq(rt.buf_ptr(b), s.p as u64, s.n)
}

fn main() -> i32 {
    var m: fuzzy.Match = fuzzy.match_new()
    check("match", fuzzy.match_text("opfi", "Open File...", fuzzy.CASE_SMART, &m))
    check("positions", fuzzy.match_count(&m) == 4 && fuzzy.match_pos(&m, 0) == 0 && fuzzy.match_pos(&m, 1) == 1 && fuzzy.match_pos(&m, 2) == 5 && fuzzy.match_pos(&m, 3) == 6)
    check("no match", !fuzzy.match_text("xyz", "Open File...", fuzzy.CASE_SMART, &m))
    check("order matters", !fuzzy.match_text("fo", "Open File", fuzzy.CASE_SMART, &m))
    check("empty pattern", !fuzzy.match_text("", "abc", fuzzy.CASE_SMART, &m))
    // smart case: an upper case letter in the pattern makes it case sensitive
    check("smart lower", fuzzy.match_text("file", "Open File", fuzzy.CASE_SMART, &m))
    check("smart upper", !fuzzy.match_text("FILE", "Open file", fuzzy.CASE_SMART, &m))
    check("ignore", fuzzy.match_text("FILE", "Open file", fuzzy.CASE_IGNORE, &m))
    check("respect", !fuzzy.match_text("file", "Open File", fuzzy.CASE_RESPECT, &m))
    // a word start scores higher than a place in the middle of a word
    var a: fuzzy.Match = fuzzy.match_new()
    var b: fuzzy.Match = fuzzy.match_new()
    check("both", fuzzy.match_text("f", "open file", fuzzy.CASE_SMART, &a) && fuzzy.match_text("f", "xfx", fuzzy.CASE_SMART, &b))
    check("boundary bonus", a.score > b.score)
    // consecutive beats scattered
    check("both2", fuzzy.match_text("abc", "abc", fuzzy.CASE_SMART, &a) && fuzzy.match_text("abc", "a_b_c", fuzzy.CASE_SMART, &b))
    check("consecutive", a.score > b.score)
    // UTF-8: positions are characters, bytes are reported too
    check("utf8", fuzzy.match_text("\u00fc", "gr\u00fcn", fuzzy.CASE_SMART, &m) && fuzzy.match_pos(&m, 0) == 2 && fuzzy.match_byte(&m, 0) == 2 && fuzzy.match_byte_len(&m, 0) == 2)
    check("utf8 fold", fuzzy.match_text("\u00dcn", "gr\u00fcn", fuzzy.CASE_IGNORE, &m))
    // a bad byte never matches a real character and does not crash
    var junk: rt.Buf = rt.buf_new()
    rt.buf_push(&junk, 255 as u8)
    rt.buf_push(&junk, 254 as u8)
    check("bad byte", !fuzzy.match_text("a", str { p: rt.buf_ptr(&junk) as *mut u8, n: 2 }, fuzzy.CASE_SMART, &m))
    // rank: best first, shorter text wins a tie, non-matches are left out
    var items: Vec[str] = vec_new[str]()
    vec_push[str](&items, "open file")
    vec_push[str](&items, "xyz")
    vec_push[str](&items, "of")
    vec_push[str](&items, "xo_f")
    var order: Vec[usize] = vec_new[usize]()
    fuzzy.rank("of", &items, fuzzy.CASE_SMART, &order)
    check("rank count", vec_len[usize](&order) == 3)
    check("rank first", vec_at[usize](&order, 0) == 2)
    check("rank last", vec_at[usize](&order, 2) == 3)
    fuzzy.match_free(&m)
    fuzzy.match_free(&a)
    fuzzy.match_free(&b)
    return failures
}
