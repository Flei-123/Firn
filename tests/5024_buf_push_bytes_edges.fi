// expect_exit: 0
import std.rt

fn main() -> i32 {
    var src: [u8; 96] = [0 as u8; 96]
    var k: usize = 0
    while k < 96 {
        src[k] = ((k * 7 + 3) & 255) as u8
        k = k + 1
    }
    var bad: u32 = 0
    var pre: usize = 0
    while pre < 130 {
        var n: usize = 0
        while n <= 80 {
            var b: rt.Buf = rt.buf_new()
            var i: usize = 0
            while i < pre {
                rt.buf_push(&b, 120 as u8)
                i = i + 1
            }
            rt.buf_push_bytes(&b, (&src[0]) as u64, n)
            rt.buf_push(&b, 33 as u8)
            if rt.buf_len(&b) != pre + n + 1 { bad = bad + 1 }
            var d: usize = 0
            while d < n {
                if rt.ld8(rt.buf_ptr(&b), pre + d) != src[d] { bad = bad + 1 }
                d = d + 1
            }
            if rt.ld8(rt.buf_ptr(&b), pre + n) != 33 as u8 { bad = bad + 1 }
            d = 0
            while d < pre {
                if rt.ld8(rt.buf_ptr(&b), d) != 120 as u8 { bad = bad + 1 }
                d = d + 1
            }
            rt.buf_free(&b)
            n = n + 1
        }
        pre = pre + 1
    }
    if bad != 0 { return 1 }
    return 0
}
