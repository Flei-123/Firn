// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_nbt
import mc.mc_item_meta

fn put_name(b: *mut bytes.Bytes, s: str) {
    bytes.put_u16(b, s.n as u16)
    bytes.put_raw(b, s.p as u64, s.n)
}

fn put_entry_str(b: *mut bytes.Bytes, k: str, v: str) {
    bytes.put_u8(b, 8 as u8)
    put_name(b, k)
    put_name(b, v)
}

fn has_line(p: u64, n: usize, lit: str) -> bool {
    var i: usize = 0
    while i + lit.n <= n {
        if rt.mem_eq(p + (i as u64), lit.p as u64, lit.n) { return true }
        i = i + 1
    }
    return false
}

fn main() -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&b, 10 as u8)
    put_name(&b, "")
    bytes.put_u8(&b, 10 as u8)
    put_name(&b, "display")
    put_entry_str(&b, "Name", "{\"text\":\"Blade\"}")
    bytes.put_u8(&b, 9 as u8)
    put_name(&b, "Lore")
    bytes.put_u8(&b, 8 as u8)
    bytes.put_u32(&b, 1 as u32)
    put_name(&b, "{\"text\":\"Sharp\"}")
    bytes.put_u8(&b, 0 as u8)
    bytes.put_u8(&b, 9 as u8)
    put_name(&b, "Enchantments")
    bytes.put_u8(&b, 10 as u8)
    bytes.put_u32(&b, 1 as u32)
    put_entry_str(&b, "id", "minecraft:sharpness")
    bytes.put_u8(&b, 2 as u8)
    put_name(&b, "lvl")
    bytes.put_u16(&b, 5 as u16)
    bytes.put_u8(&b, 0 as u8)
    bytes.put_u8(&b, 3 as u8)
    put_name(&b, "Damage")
    bytes.put_u32(&b, 7 as u32)
    bytes.put_u8(&b, 0 as u8)
    bytes.bytes_set_pos(&b, 0)
    var d: mc_nbt.Doc = mc_nbt.doc_new()
    if !(mc_nbt.doc_parse(&d, &b, false, false) catch false) { return 1 }
    var m: mc_item_meta.Pool = mc_item_meta.im_new()
    mc_item_meta.im_begin(&m)
    mc_item_meta.im_from_nbt(&m, &d)
    let sig: i32 = mc_item_meta.im_sig_of_bytes(bytes.bytes_ptr(&b), bytes.bytes_len(&b))
    mc_item_meta.im_commit(&m, sig)
    var p: u64 = 0
    var n: usize = 0
    if !mc_item_meta.im_find(&m, sig, &p, &n) { return 2 }
    if !has_line(p, n, "n{\"text\":\"Blade\"}") { return 3 }
    if !has_line(p, n, "l{\"text\":\"Sharp\"}") { return 4 }
    if !has_line(p, n, "eminecraft:sharpness\t5") { return 5 }
    if !has_line(p, n, "d7") { return 6 }
    if mc_item_meta.im_find(&m, sig + 2, &p, &n) { return 7 }
    mc_item_meta.im_free(&m)
    mc_nbt.doc_free(&d)
    bytes.bytes_free(&b)
    return 0
}
