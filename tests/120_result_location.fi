// expect_exit: 83
// Result-location guarantee (SPEC 13.1, DESIGN_GOALS.md 6):
// `let g = build(41)` passes the address of `g` to `build`; the 1 MB struct
// is built THERE, not on the stack of `build` and then copied.
// The proof through the frame sizes is in tools/result_location/run.sh.
struct Big {
    a: i64,
    buffer: [u8; 1048576],
    b: i64,
}

fn build(x: i64) -> Big {
    return Big { a: x, buffer: [0; 1048576], b: x + 1, }
}

fn main() -> i32 {
    let g = build(41)
    return (g.a + g.b) as i32
}
