// expect_exit: 0
// tests/4523_std_setops.fi -- std.setops against CPython sets (|, &, -, ^, <=, >=,
// isdisjoint, ==, |=, &=, -=). Mirrors tools/libs_py_cross/setops_ref.py.
import std.rt
import std.vec
import std.map
import std.setops
import std.testkit

struct Rng { x: u64 }
struct Hash { h: u64 }

fn rnd(g: *mut Rng, m: u64) -> u64 {
    (*g).x = ((*g).x * 1103515245 + 12345) & 0x7fffffff
    return ((*g).x >> 8) % m
}

fn feed(h: *mut Hash, x: u64) {
    (*h).h = ((*h).h * 31 + (x & 0xffffffff)) & 0xffffffff
}

fn feed_bool(h: *mut Hash, b: bool) {
    if b { feed(h, 1) } else { feed(h, 0) }
}

fn feed_set(h: *mut Hash, s: *mut Set[i64]) {
    var v: Vec[i64] = vec_new[i64]()
    set_to_vec[i64](s, &v)
    vec_sort[i64](&v)
    feed(h, vec_len[i64](&v) as u64)
    var i: usize = 0
    while i < vec_len[i64](&v) {
        feed(h, (*vec_elem_ptr[i64](&v, i)) as u64)
        i = i + 1
    }
    vec_free[i64](&v)
}

fn copy_set(dst: *mut Set[i64], src: *mut Set[i64]) {
    set_update[i64](dst, src)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var g: Rng = Rng { x: 31337 }
    var hh: Hash = Hash { h: 7 }
    let h: *mut Hash = &hh
    for r in 0..(400 as u64) {
        let n1: u64 = rnd(&g, 30)
        let n2: u64 = rnd(&g, 30)
        let m: u64 = 1 + rnd(&g, 60)
        var a: Set[i64] = set_new[i64]()
        var b: Set[i64] = set_new[i64]()
        for i in 0..n1 { set_put_i(&a, rnd(&g, m) as i64) }
        for i in 0..n2 { set_put_i(&b, rnd(&g, m) as i64) }
        var u: Set[i64] = set_new[i64]()
        var n: Set[i64] = set_new[i64]()
        var d: Set[i64] = set_new[i64]()
        var x: Set[i64] = set_new[i64]()
        set_union[i64](&a, &b, &u)
        set_intersection[i64](&a, &b, &n)
        set_difference[i64](&a, &b, &d)
        set_symmetric_difference[i64](&a, &b, &x)
        feed_set(h, &u)
        feed_set(h, &n)
        feed_set(h, &d)
        feed_set(h, &x)
        feed_bool(h, set_is_subset[i64](&a, &b))
        feed_bool(h, set_is_superset[i64](&a, &b))
        feed_bool(h, set_is_disjoint[i64](&a, &b))
        feed_bool(h, set_equal[i64](&a, &b))
        var c: Set[i64] = set_new[i64]()
        copy_set(&c, &a)
        set_update[i64](&c, &b)
        feed_set(h, &c)
        set_clear[i64](&c)
        copy_set(&c, &a)
        set_intersection_update[i64](&c, &b)
        feed_set(h, &c)
        set_clear[i64](&c)
        copy_set(&c, &a)
        set_difference_update[i64](&c, &b)
        feed_set(h, &c)
        // subset-heavy: keep each element of sorted(a) with probability 2/3
        var av: Vec[i64] = vec_new[i64]()
        set_to_vec[i64](&a, &av)
        vec_sort[i64](&av)
        var sub: Set[i64] = set_new[i64]()
        for j in 0..vec_len[i64](&av) {
            if rnd(&g, 3) > 0 { set_put_i(&sub, *vec_elem_ptr[i64](&av, j)) }
        }
        feed_bool(h, set_is_subset[i64](&sub, &a))
        feed_bool(h, set_is_superset[i64](&a, &sub))
        feed_bool(h, set_equal[i64](&sub, &a))
        vec_free[i64](&av)
        set_free[i64](&sub)
        set_free[i64](&c)
        set_free[i64](&u)
        set_free[i64](&n)
        set_free[i64](&d)
        set_free[i64](&x)
        set_free[i64](&a)
        set_free[i64](&b)
    }
    testkit.check((*h).h == 1756540967, "400 random set algebra rounds equal CPython")
    return testkit.finish()
}

fn set_put_i(s: *mut Set[i64], k: i64) {
    var added: bool = false
    set_add[i64](s, k, &added)
}
