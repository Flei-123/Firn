// expect_exit: 0
// firnc1_skip: f-string format specs are stage-0 only
// tests/3982_fstring_repr.fi -- `{x!r}` (Python repr of a text), `{x!s}`, with a spec (r708).
import std.io
import std.rt
import std.testkit

fn main() -> i32 {
    if !gc_init() { return 1 }
    let s: str = "ab"
    let q: str = "it's"
    let d: str = "say \"hi\""
    let b: str = "both ' and \""
    let e: str = "back\\slash"
    let n: i32 = 42
    let x: f64 = 2.5
    testkit.check(io.fmt_string(f"{s!r}") == "'ab'", "plain")
    testkit.check(io.fmt_string(f"{q!r}") == "\"it's\"", "single quote -> double quotes")
    testkit.check(io.fmt_string(f"{d!r}") == "'say \"hi\"'", "double quote stays")
    testkit.check(io.fmt_string(f"{b!r}") == "'both \\' and \"'", "both quotes")
    testkit.check(io.fmt_string(f"{e!r}") == "'back\\\\slash'", "backslash")
    let c: str = "a\nb\tc"
    testkit.check(io.fmt_string(f"{c!r}") == "'a\\nb\\tc'", "control octets")
    testkit.check(io.fmt_string(f"[{s!r:>6}]") == "[  'ab']", "align")
    testkit.check(io.fmt_string(f"[{s!r:<6s}]") == "['ab'  ]", "left with s")
    testkit.check(io.fmt_string(f"[{s!r:*^8}]") == "[**'ab'**]", "fill")
    testkit.check(io.fmt_string(f"{n!r} {x!r} {n!s} {s!s}") == "42 2.5 42 ab", "numbers and !s")
    testkit.check(io.fmt_string(f"{true!r}") == "true", "bool")
    testkit.check(io.fmt_string(f"{n != 3}") == "true", "!= is no conversion")
    return testkit.finish()
}
