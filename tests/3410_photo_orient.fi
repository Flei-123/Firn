// expect_out: ok
// tests/3410_photo_orient.fi -- FirnCam EXIF orientation: tag from SENSOR_ORIENTATION and the screen rotation at the shot.
// The Xiaomi 14T Pro case of the Boss: back lens, sensor 90, phone held in landscape (display 90) -> pixels are already
// upright -> tag 1 (the old code wrote 6 from the sensor value alone and the picture showed up turned by 90 degrees).
import std.io
import photo.camjob

fn check(c: bool, msg: str) -> bool {
    if !c { io.print(msg); io.new_line() }
    return c
}

fn main() -> i32 {
    var ok: bool = true
    // back lens, sensor 90: portrait (display 0) -> 6, landscape (90) -> 1, upside down (180) -> 8, other landscape (270) -> 3
    ok = check(camjob.capture_orientation(90, 0, false) == 6, "back 90/0") && ok
    ok = check(camjob.capture_orientation(90, 90, false) == 1, "back 90/90") && ok
    ok = check(camjob.capture_orientation(90, 180, false) == 8, "back 90/180") && ok
    ok = check(camjob.capture_orientation(90, 270, false) == 3, "back 90/270") && ok
    // front lens, sensor 270: portrait -> 8, landscape 90 -> 3 (rotation 360 = 0 -> 1 for 270 + 90)
    ok = check(camjob.capture_orientation(270, 0, true) == 8, "front 270/0") && ok
    ok = check(camjob.capture_orientation(270, 90, true) == 1, "front 270/90") && ok
    ok = check(camjob.capture_orientation(270, 180, true) == 6, "front 270/180") && ok
    ok = check(camjob.capture_orientation(270, 270, true) == 3, "front 270/270") && ok
    // sensor 0 / 180 devices (tablets) and wrap-around
    ok = check(camjob.capture_orientation(0, 0, false) == 1, "back 0/0") && ok
    ok = check(camjob.capture_orientation(0, 90, false) == 8, "back 0/90") && ok
    ok = check(camjob.capture_orientation(180, 90, false) == 6, "back 180/90") && ok
    ok = check(camjob.capture_orientation(90, 270, true) == 1, "front 90/270") && ok
    // invalid / odd inputs never leave the tag range
    var s: i32 = 0 - 360
    var bad: i32 = 0
    while s <= 720 {
        var d: i32 = 0 - 90
        while d <= 450 {
            let t: i32 = camjob.capture_orientation(s, d, (s / 90) % 2 == 0)
            if t != 1 && t != 3 && t != 6 && t != 8 { bad = bad + 1 }
            d = d + 90
        }
        s = s + 90
    }
    ok = check(bad == 0, "tag range") && ok
    ok = check(camjob.exif_orientation(0) == 1 && camjob.exif_orientation(90) == 6 && camjob.exif_orientation(180) == 3 && camjob.exif_orientation(270) == 8, "exif map") && ok
    if ok { io.print("ok") } else { io.print("FAIL") }
    return 0
}
