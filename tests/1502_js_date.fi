// expect_exit: 0
// tests/1502_js_date.fi -- ROUND 74: dates -- the calendar arithmetic of clause 21.4
//
// The engine runs ONE JavaScript program with numbered assertions; the
// number of the FIRST failing one lands in the global variable `fail` and
// comes back as the exit code, so the code names the check that broke.
// Produced by tools/js/mktest.py out of tools/js/progs/1502_date.js.
import html.mem
import js.lex
import js.ast
import js.parse
import js.val
import js.interp
import js.builtin
import js.gen

const SRC_LEN: usize = 3007

fn __gc_finalize(kind: u64, p: *mut u8) {
}

// ROUND 79 -- the realm is a GC object and is handed the addresses of `ctx`,
// `t` and `nm`, which lie in THIS frame. It is sound here and only here: the
// realm comes into being in this call, nothing outside gets hold of it, and
// it is garbage the moment this function returns. The escape analysis
// (compiler/src/escape.rs) cannot see that, so the exception is said out
// loud instead of the check being weakened (docs/ROUND79.md 3).
#[allow_escape]
fn run(src: *mut u8, len: usize) -> AllocError!u64 {
    var nm: lex.Names = lex.Names { pool: mem.cp_new(), off: mem.cp_new(),
        len: mem.cp_new(), hash: mem.cp_new(), buckets: mem.cp_new(),
        mask: 0, n: 0 }
    lex.names_init(&nm)
    var l: lex.Lexer = lex.lex_new()
    lex.lex_init(&l, &nm)
    var t: ast.Ast = ast.ast_new()
    ast.ast_init(&t)
    var p: parse.Parser = parse.parser_new()
    parse.parser_init(&p, &l, &t, &nm)
    lex.lex_set_ascii(&l, src, len)
    let prog: u32 = parse.parse_program(&p, false)
    if parse.parse_error(&p) != parse.ERR_NONE {
        return 900 + parse.parse_error_line(&p) as u64
    }
    var ctx: interp.Ctx = interp.ctx_new()
    ctx.native = builtin.native_dispatch
    ctx.arity = builtin.native_arity_of
    ctx.gen_start = gen.gen_start
    ctx.gen_native = gen.gen_native
    var sp: gen.Susp = gen.susp_new()
    gen.susp_init(&sp)
    ctx.gen_data = (&sp) as *mut u8
    let r: Gc[Realm] = try val.realm_new()
    val.realm_set_ctx(r, (&ctx) as *mut u8)
    val.realm_set_ast(r, &t, &nm)
    let g: Gc[JsObj] = try builtin.install(r)
    let okg: bool = try gen.install_gen(r)
    let v: Gc[JsVal] = try interp.run_program(r, prog, r.global_env)
    if ctx.comp == interp.C_THROW {
        return 800
    }
    let okj: bool = try gen.run_jobs(r)
    if ctx.comp == interp.C_THROW {
        return 801
    }
    var name: [u8; 4] = "fail"
    let s: Gc[JsVal] = try val.str_from_ascii(r, &name[0], 4)
    let k: u64 = try val.key_for_str(r, s)
    let gv: Gc[JsVal] = g
    let f: Gc[JsVal] = try interp.get_prop(r, gv, k)
    let n: u64 = try interp.to_number(r, f)
    let x: f64 = math_of(n)
    gen.susp_free(&sp)
    return x as u64
}

fn math_of(bits: u64) -> f64 {
    var t: u64 = bits
    return *(((&t) as usize) as *mut f64)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    gc_set_max_bytes(1 << 30)
    var s: [u8; 3007] = "globalThis.fail=0;\nfunction ck(n,c){ if(!c && globalThis.fail===0) globalThis.fail=n; }\nvar d=new Date(Date.UTC(2020,0,2,3,4,5,6));\nck(1, d.toISOString()===\"2020-01-02T03:04:05.006Z\");\nck(2, d.getTime()===1577934245006);\nck(3, d.getUTCFullYear()===2020 && d.getUTCMonth()===0 && d.getUTCDate()===2);\nck(4, d.getUTCDay()===4 && d.getUTCHours()===3 && d.getUTCMinutes()===4);\nck(5, d.getUTCSeconds()===5 && d.getUTCMilliseconds()===6);\nck(6, new Date(0).toISOString()===\"1970-01-01T00:00:00.000Z\");\nck(7, new Date(-1).toISOString()===\"1969-12-31T23:59:59.999Z\");\nck(8, new Date(8.64e15).toISOString()===\"+275760-09-13T00:00:00.000Z\");\nck(9, isNaN(new Date(8.64e15+1).getTime()));\nck(10, Date.parse(\"2020-01-02T03:04:05.006Z\")===1577934245006);\nck(11, Date.parse(\"2020-01-02\")===1577923200000);\nck(12, isNaN(Date.parse(\"bogus\")));\nck(13, String(new Date(NaN))===\"Invalid Date\" && isNaN(new Date(NaN).getTime()));\nvar e=new Date(0); e.setUTCFullYear(1999); e.setUTCMonth(11); e.setUTCDate(31);\nck(14, e.toISOString()===\"1999-12-31T00:00:00.000Z\");\nck(15, new Date(2020,0,1).getFullYear()===2020);\nck(16, new Date(2020,0,1).getTimezoneOffset()===0);\nck(17, typeof Date.now()===\"number\" && Date.now()>1600000000000);\nck(18, new Date(Date.UTC(2020,0,2)).toUTCString()===\"Thu, 02 Jan 2020 00:00:00 GMT\");\nck(19, JSON.stringify({d:new Date(Date.UTC(2020,0,2))})==='{\"d\":\"2020-01-02T00:00:00.000Z\"}');\nck(20, +new Date(Date.UTC(2000,1,29))===951782400000);\nck(21, Date.parse(new Date(Date.UTC(2020,5,15,10,20,30)).toString())===Date.UTC(2020,5,15,10,20,30));\nck(22, new Date(Date.UTC(-1,0,1)).toISOString()===\"-000001-01-01T00:00:00.000Z\");\nck(23, Date.UTC(2020)===1577836800000 && Date.UTC(2020,0)===1577836800000);\nck(24, new Date(Date.UTC(2020,0,1)).getUTCDay()===3);\nck(25, new Date(Date.UTC(1900,1,28)).getUTCMonth()===1 && new Date(Date.UTC(1900,1,29)).getUTCMonth()===2);\nck(26, new Date(Date.UTC(2000,1,29)).getUTCDate()===29);\nck(27, (function(){var x=new Date(0); x.setTime(1000); return x.getTime()===1000;})());\nck(28, (function(){var x=new Date(0); x.setUTCHours(5,6,7,8); return x.toISOString()===\"1970-01-01T05:06:07.008Z\";})());\nck(29, new Date(99,0,1).getFullYear()===1999);\nck(30, (function(){try{new Date(NaN).toISOString()}catch(err){return err instanceof RangeError}return false})());\nck(31, typeof Date.prototype[Symbol.toPrimitive]===\"function\");\nck(32, (new Date(5)+\"\").indexOf(\"GMT\")>0 && +new Date(5)===5);\nck(33, Object.prototype.toString.call(new Date(0))===\"[object Date]\");\nck(34, new Date(Date.UTC(2020,0,2)).toDateString()===\"Thu Jan 02 2020\");\nck(35, new Date(Date.UTC(2020,0,2,7,8,9)).toTimeString().indexOf(\"07:08:09\")===0);\nck(36, new Date(2020,0,2).valueOf()===Date.UTC(2020,0,2));\nck(37, new Date(\"2020-01-02T00:00:00Z\").getTime()===1577923200000);\nck(38, (function(){var x=new Date(NaN); x.setUTCFullYear(2000); return x.getUTCFullYear()===2000;})());\nck(39, new Date(Date.UTC(2020,12,1)).getUTCFullYear()===2021);\nck(40, new Date(Date.UTC(2020,-1,1)).getUTCFullYear()===2019);\n"
    let bad: u64 = run(&s[0], SRC_LEN) catch 999
    return bad as i32
}
