// expect_exit: 42
// Round GAPS: std.dir -- the entries of a directory (docs/LUECKEN.md B23).
// /proc/self/fd always holds 0, 1 and 2 (links), never "." or ".." as an
// entry of the walk.
import std.dir

fn main() -> i32 {
    var d: dir.Dir = dir.open("/proc/self/fd")
    if !dir.is_open(&d) { return 1 as i32 }
    var seen: u32 = 0
    var count: u32 = 0
    while dir.next(&d) {
        count = count + 1
        if d.name == "." || d.name == ".." { return 2 as i32 }
        if d.name == "0" || d.name == "1" || d.name == "2" {
            if d.kind != dir.KIND_LINK { return 3 as i32 }
            seen = seen + 1
        }
    }
    dir.close(&d)
    if seen != 3 { return 4 as i32 }
    if count < 3 { return 5 as i32 }
    // after the end it stays at the end, and closing twice is harmless
    if dir.next(&d) { return 6 as i32 }
    dir.close(&d)
    // a directory that does not exist does not open
    var m: dir.Dir = dir.open("/no/such/directory/here")
    if dir.is_open(&m) { return 7 as i32 }
    if dir.next(&m) { return 8 as i32 }
    // a FILE opens but has no entries
    var f: dir.Dir = dir.open("/proc/self/status")
    if dir.next(&f) { return 9 as i32 }
    dir.close(&f)
    // "/" has entries and at least one directory among them
    var r: dir.Dir = dir.open("/")
    var dirs: u32 = 0
    while dir.next(&r) {
        if r.kind == dir.KIND_DIR { dirs = dirs + 1 }
    }
    dir.close(&r)
    if dirs == 0 { return 10 as i32 }
    return 42
}
