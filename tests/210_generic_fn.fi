// expect_exit: 30
// Generic functions: monomorphisation, several instances, bound 'Int'.
fn greater[T: Int](a: T, b: T) -> T {
    if a > b { return a }
    return b
}

fn sum3[T: Int](a: T, b: T, c: T) -> T {
    return a + b + c
}

fn main() -> i32 {
    let a: i32 = greater[i32](7, 4)
    let b: u8 = greater[u8](3, 9)
    let c: i64 = sum3[i64](5, 6, 3)
    return a + b as i32 + c as i32
}
