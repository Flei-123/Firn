// expect_exit: 44
// r740: a lambda on the right side of an assignment takes its type from the target:
// a local `f = |x| ..`, a field `s.f = |x| ..`, a Vec element `v[i] = |x| ..`,
// a nested target `s.fs[i] = ..` and a capturing `try gc |x| ..`.
import std.vec

struct Holder { f: fn(i64) -> i64, fs: Vec[fn(i64) -> i64] }

#[no_inline]
fn plain(x: i64) -> i64 {
    return x
}

#[no_inline]
fn fill(h: *mut Holder, k: i64) -> AllocError!i64 {
    (*h).f = |x| x + 1
    (*h).fs[1] = try gc |x| x * k
    (*h).fs[0] = |x| x - 1
    return 0
}

fn main() -> i32 {
    var h: Holder = Holder { f: plain, fs: vec_new[fn(i64) -> i64]() }
    vec_push[fn(i64) -> i64](&h.fs, plain)
    vec_push[fn(i64) -> i64](&h.fs, plain)
    let r: i64 = fill(&h, 3) catch 0
    var g: fn(i64) -> i64 = plain
    g = |x| x * 2
    var v: Vec[fn(i64) -> i64] = vec_new[fn(i64) -> i64]()
    vec_push[fn(i64) -> i64](&v, plain)
    v[0] = |x| x + 10
    // h.f(5)=6, h.fs[0](5)=4, h.fs[1](5)=15, g(5)=10, v[0](5)=15  -> 50 - 6 ... computed below
    let total: i64 = h.f(5) + h.fs[0](5) + h.fs[1](5) + g(5) + v[0](5) + r
    return (total - 6) as i32
}
