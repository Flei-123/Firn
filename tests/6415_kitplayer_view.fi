// expect_exit: 0
import std.rt
import std.fs
import paint.canvas
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.kitview
import fui.kitplayer
import fui.kpplayer
import fui.kpmodel
import fui.kplayout
import fui.kpdraw
import fui.editor

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn load(path: str, b: *mut rt.Buf) -> bool {
    let got: usize = fs.read_file(path, b) catch | e | (0 -% 1)
    return got != (0 -% 1)
}

fn put16(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255 as u32) as u8)
    rt.buf_push(b, ((v >> 8) & 255 as u32) as u8)
}

fn put32(b: *mut rt.Buf, v: u32) {
    put16(b, v & 65535 as u32)
    put16(b, v >> 16)
}

fn tag(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, 4)
}

fn make_wav(b: *mut rt.Buf, frames: u32) {
    tag(b, "RIFF")
    put32(b, 36 as u32 + frames * 4 as u32)
    tag(b, "WAVE")
    tag(b, "fmt ")
    put32(b, 16 as u32)
    put16(b, 1 as u32)
    put16(b, 2 as u32)
    put32(b, 8000 as u32)
    put32(b, 32000 as u32)
    put16(b, 4 as u32)
    put16(b, 16 as u32)
    tag(b, "data")
    put32(b, frames * 4 as u32)
    var i: u32 = 0 as u32
    while i < frames {
        put16(b, (i * 7 as u32) & 32767 as u32)
        put16(b, 65535 as u32 - ((i * 7 as u32) & 32767 as u32))
        i = i + 1 as u32
    }
}

struct Rig {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
}

fn rig_new(w: usize, h: usize) -> *mut Rig {
    let r: *mut Rig = rt.heap_alloc(1 << 20) as *mut Rig
    (*r).m = theme.theme_new(true)
    (*r).z = painter.painter_new()
    (*r).cv = canvas.canvas_new()
    if !canvas.canvas_init(&(*r).cv, w, h) || !painter.painter_init(&(*r).z, &(*r).cv, w, h) {
        rt.finish(90)
    }
    (*r).c = render.ctx_new(&(*r).m, &(*r).z)
    return r
}

fn px(r: *mut Rig, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*r).cv, x as usize, y as usize)
}

fn cx(rc: *mut kplayout.Rect) -> f64 {
    return (*rc).x + (*rc).w / 2.0
}

fn cy(rc: *mut kplayout.Rect) -> f64 {
    return (*rc).y + (*rc).h / 2.0
}

fn count_diff(r: *mut Rig, rc: *mut kplayout.Rect, col: u32) -> usize {
    var n: usize = 0
    var y: f64 = (*rc).y
    while y < (*rc).y + (*rc).h {
        var x: f64 = (*rc).x
        while x < (*rc).x + (*rc).w {
            if px(r, x, y) != col {
                n = n + 1
            }
            x = x + 4.0
        }
        y = y + 4.0
    }
    return n
}

fn check_video() {
    var b: rt.Buf = rt.buf_new()
    check(load("testdata/media_video/av_main.mp4", &b), 1)
    var v: kitview.View = kitview.view_new()
    check(kitview.view_open(&v, rt.buf_ptr(&b), rt.buf_len(&b), "av_main.mp4") == kitview.MODE_MEDIA, 2)
    let pv: *mut kitplayer.PlayerView = kitview.view_media(&v)
    check(pv as u64 != 0, 3)
    let p: *mut kpplayer.Player = kitplayer.pv_player(pv)
    kpplayer.pl_set_discard(p, true)
    check(kpplayer.pl_has_video(p) && kpplayer.pl_has_frame(p), 4)
    let r: *mut Rig = rig_new(640, 420)
    canvas.canvas_clear(&(*r).cv, 4294967295 as u32)
    kitview.view_draw(&(*r).c, &v, 0.0, 0.0, 640.0, 420.0)
    let l: *mut kplayout.Layout = kitplayer.pv_layout_ptr(pv)
    check((*l).surface.h > 300.0 && (*l).bar.h > 40.0, 5)
    check(count_diff(r, &(*l).surface, 4294967295 as u32) > 1000, 6)
    check(px(r, (*l).surface.x + 2.0, (*l).surface.y + 2.0) != 4294967295 as u32, 7)
    check(count_diff(r, &(*l).bar, 4294967295 as u32) > 100, 8)

    check(kpdraw.frame_key(1 as u64, p) != kpdraw.frame_key(2 as u64, p), 9)
    let key0: u64 = kpdraw.frame_key(1 as u64, p)
    check(kpdraw.frame_key(1 as u64, p) == key0, 10)

    check(kpplayer.pl_state(p) == kpmodel.TS_READY, 11)
    check(kitview.view_press(&v, cx(&(*l).play), cy(&(*l).play)), 12)
    check(kpplayer.pl_state(p) == kpmodel.TS_PLAYING, 13)
    check(kitview.view_animating(&v), 14)
    check(kitview.view_char(&v, 32 as u32, 0 as u32), 15)
    check(kpplayer.pl_state(p) == kpmodel.TS_PAUSED, 16)
    check(kitview.view_press(&v, cx(&(*l).surface), cy(&(*l).surface)), 17)
    check(kpplayer.pl_state(p) == kpmodel.TS_PLAYING, 18)
    check(kitview.view_key(&v, editor.KEY_ESC, 0 as u32) == false, 19)
    kitview.view_char(&v, 107 as u32, 0 as u32)

    let sk: *mut kplayout.Rect = &(*l).seek
    let sx0: f64 = (*sk).x + 8.0
    let sw: f64 = (*sk).w - 16.0
    check(kitview.view_press(&v, sx0 + sw / 2.0, cy(sk)), 20)
    check(kpplayer.pl_scrubbing(p) && kitplayer.pv_drag(pv) == kplayout.HIT_SEEK, 21)
    check(kitview.view_move(&v, sx0 + sw / 4.0, cy(sk)), 22)
    let pm: i64 = kpplayer.pl_permille(p)
    check(pm > 200 && pm < 300, 23)
    check(kitview.view_release(&v, sx0 + sw / 4.0, cy(sk)), 24)
    check(!kpplayer.pl_scrubbing(p) && kitplayer.pv_drag(pv) == kplayout.HIT_NONE, 25)
    check(kpplayer.pl_permille(p) > 150 && kpplayer.pl_permille(p) < 350, 26)
    check(kpplayer.pl_state(p) == kpmodel.TS_PAUSED, 27)

    check((*l).has_vol, 28)
    let vl: *mut kplayout.Rect = &(*l).vol
    let vx0: f64 = (*vl).x + 8.0
    let vw: f64 = (*vl).w - 16.0
    check(kitview.view_press(&v, vx0 + vw * 0.2, cy(vl)), 29)
    check(kpplayer.pl_volume(p) >= 18 as u32 && kpplayer.pl_volume(p) <= 22 as u32, 30)
    check(kitview.view_move(&v, vx0 + vw * 0.8, cy(vl)), 31)
    check(kpplayer.pl_volume(p) >= 78 as u32 && kpplayer.pl_volume(p) <= 82 as u32, 32)
    check(kitview.view_release(&v, vx0 + vw * 0.8, cy(vl)), 33)
    check(!kitview.view_move(&v, vx0, cy(vl)), 34)

    check(!kpplayer.pl_muted(p), 35)
    check(kitview.view_press(&v, cx(&(*l).mute), cy(&(*l).mute)), 36)
    check(kpplayer.pl_muted(p), 37)
    kitview.view_char(&v, 109 as u32, 0 as u32)
    check(!kpplayer.pl_muted(p), 38)
    check(kitview.view_wheel(&v, 1.0), 39)
    check(kpplayer.pl_volume(p) < 80 as u32, 40)
    check(kitview.view_key(&v, editor.KEY_UP, 0 as u32), 41)

    let before: i64 = kpplayer.pl_permille(p)
    check(kitview.view_key(&v, editor.KEY_RIGHT, 0 as u32), 42)
    check(kpplayer.pl_permille(p) > before, 43)
    check(kitview.view_key(&v, editor.KEY_HOME, 0 as u32), 44)
    check(kpplayer.pl_permille(p) < 50, 45)
    check(kitview.view_press(&v, 5.0, 5.0 + 500.0) == false, 46)

    kitview.view_free(&v)
    rt.buf_free(&b)
}

fn check_audio() {
    var b: rt.Buf = rt.buf_new()
    make_wav(&b, 8000 as u32)
    var v: kitview.View = kitview.view_new()
    check(kitview.view_open(&v, rt.buf_ptr(&b), rt.buf_len(&b), "tone.wav") == kitview.MODE_MEDIA, 50)
    let pv: *mut kitplayer.PlayerView = kitview.view_media(&v)
    let p: *mut kpplayer.Player = kitplayer.pv_player(pv)
    kpplayer.pl_set_discard(p, true)
    check(!kpplayer.pl_has_video(p) && kpplayer.pl_has_audio(p), 51)
    check(kpplayer.pl_duration_ms(p) == 1000 as u64, 52)
    let r: *mut Rig = rig_new(480, 320)
    canvas.canvas_clear(&(*r).cv, 4294967295 as u32)
    kitview.view_draw(&(*r).c, &v, 0.0, 0.0, 480.0, 320.0)
    let l: *mut kplayout.Layout = kitplayer.pv_layout_ptr(pv)
    let accent: u32 = theme.opaque(render.color_of(&(*r).c, style.color_token(style.TOK_ACCENT)))
    let ax: f64 = (*l).surface.x + (*l).surface.w / 2.0
    let ay: f64 = (*l).surface.y + (*l).surface.h / 2.0 - 14.0
    check(px(r, ax - 40.0, ay) == accent, 53)
    check(kitview.view_press(&v, cx(&(*l).play), cy(&(*l).play)), 54)
    check(kpplayer.pl_state(p) == kpmodel.TS_PLAYING, 55)
    var i: usize = 0
    while i < 400 && kpplayer.pl_state(p) == kpmodel.TS_PLAYING {
        kitview.view_tick(&v)
        i = i + 1
    }
    check(kpplayer.pl_state(p) == kpmodel.TS_ENDED, 56)
    kitview.view_draw(&(*r).c, &v, 0.0, 0.0, 480.0, 320.0)
    check(kitview.view_press(&v, cx(&(*l).play), cy(&(*l).play)), 57)
    check(kpplayer.pl_state(p) == kpmodel.TS_PLAYING, 58)
    kitview.view_free(&v)
    rt.buf_free(&b)
}

fn check_broken() {
    var v: kitview.View = kitview.view_new()
    var b: rt.Buf = rt.buf_new()
    tag(&b, "fLaC")
    put32(&b, 0 as u32)
    check(kitview.view_open(&v, rt.buf_ptr(&b), rt.buf_len(&b), "bad.flac") == kitview.MODE_MEDIA, 70)
    let pv: *mut kitplayer.PlayerView = kitview.view_media(&v)
    check(kpplayer.pl_state(kitplayer.pv_player(pv)) == kpmodel.TS_FAILED, 71)
    let r: *mut Rig = rig_new(480, 320)
    kitview.view_draw(&(*r).c, &v, 0.0, 0.0, 480.0, 320.0)
    check(!kitview.view_release(&v, 5.0, 5.0), 72)
    check(!kitview.view_tick(&v), 73)
    check(kitview.view_open(&v, "# x\n".p as u64, 4, "a.md") == kitview.MODE_MARKDOWN, 74)
    check(kitview.view_media(&v) as u64 == 0, 75)
    kitview.view_free(&v)
    rt.buf_free(&b)
}

fn main(start: u64) -> i32 {
    check_video()
    check_audio()
    check_broken()
    return 0
}
