// expect_exit: 0
import std.rt
import std.testkit
import mc.mc_snd_events

fn work() -> bool {
    testkit.check(mc_snd_events.sev_cadence_hit(0 as u64, 0 - 1), "first hit at once")
    testkit.check(mc_snd_events.sev_cadence_hit(200 as u64, 0), "hit after 200 ms")
    testkit.check(!mc_snd_events.sev_cadence_hit(399 as u64, 1), "no hit inside the period")
    testkit.check(mc_snd_events.sev_cadence_hit(400 as u64, 1), "next hit at 400 ms")
    testkit.check(mc_snd_events.sev_damage_name(5, 763) == "entity.player.hurt_drown", "drown")
    testkit.check(mc_snd_events.sev_damage_name(28, 763) == "entity.player.hurt_on_fire", "on fire")
    testkit.check(mc_snd_events.sev_damage_name(37, 763) == "entity.player.hurt_sweet_berry_bush", "berry bush")
    testkit.check(mc_snd_events.sev_damage_name(15, 763) == "entity.player.hurt_freeze", "freeze")
    testkit.check(mc_snd_events.sev_damage_name(16, 763) == "entity.player.hurt", "generic")
    testkit.check(mc_snd_events.sev_damage_name(5, 769) == "entity.player.hurt", "other protocol falls back")
    testkit.check(mc_snd_events.sev_swim_volume(0.0, 0.0, 0.0) == 0.0, "still water is silent")
    testkit.check(mc_snd_events.sev_swim_volume(10.0, 10.0, 10.0) == 1.0, "volume is capped")
    return true
}

fn main() -> i32 {
    work()
    return testkit.finish()
}
