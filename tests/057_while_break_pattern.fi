// expect_exit: 7
// No 'break' in stage 0 -- leave the loop through a flag (SPEC 12)
fn main() -> i32 {
    var i: i32 = 0
    var found: i32 = 0
    var run: bool = true
    while run {
        if i * i > 40 {
            found = i
            run = false
        }
        i = i + 1
    }
    return found
}
