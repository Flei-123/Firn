// expect_exit: 0
// tests/2753_mc_render_world.fi -- mc_render_world: world -> meshes -> image, cache, dirty remesh, culling, budget.
import std.rt
import mc.mc_world
import mc.mc_mesh
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_render_world

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: rt.heap_alloc(32768), tiles: rt.heap_alloc(32768 * 6 * 2) }
    var i: usize = 0
    while i < 32768 {
        rt.st8(tb.opaque, i, 0 as u8)
        i = i + 1
    }
    i = 0
    while i < 32768 * 6 {
        rt.st16(tb.tiles, i, 0 as u16)
        i = i + 1
    }
    i = 0
    while i < 6 {
        rt.st16(tb.tiles, 6 + i, (1 + i) as u16)
        i = i + 1
    }
    rt.st8(tb.opaque, 1, 1 as u8)
    // world: 3 x 1 columns of 2 sections, solid floor y = 0..3 of section 0
    var w: mc_world.World = mc_world.world_new()
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var cx: i32 = 0
    while cx < 3 {
        i = 0
        while i < 8192 {
            rt.st16(ids, i, 0 as u16)
            i = i + 1
        }
        i = 0
        while i < 4 * 256 {
            rt.st16(ids, i, 1 as u16)
            i = i + 1
        }
        check(mc_world.world_put(&w, mc_render_world.wr_make_chunk(cx, 0, 2, ids)), 1)
        cx = cx + 1
    }
    var cam: mc_camera.Camera = mc_camera.camera_new(160, 90)
    mc_camera.camera_set_pos(&cam, 24.0, -64.0 + 9.0, 0.0)
    mc_camera.camera_set_angles(&cam, 0.0, 35.0)
    mc_camera.camera_update(&cam)
    var r: mc_raster.Raster = mc_raster.raster_new(160, 90)
    mc_raster.backend_upload_atlas(&r, &a)
    var wr: mc_render_world.WorldRender = mc_render_world.wr_new(0 - 64, 8, &tb)
    mc_raster.backend_begin(&r, &cam, 0xFF000000 as u32)
    mc_render_world.wr_render(&wr, &w, &r, &cam, 0 - 1)
    check(wr.st.chunks == 3 as u32 && wr.st.sections == 6 as u32 && wr.st.meshed >= 1 as u32, 2)
    check(r.st.pixels > 3000 as u64, 3)
    let h1: u64 = rt.heap_alloc(64)
    let h2: u64 = rt.heap_alloc(64)
    mc_raster.raster_hash_hex(&r, h1)
    // second frame: nothing meshed again, identical image
    mc_raster.backend_begin(&r, &cam, 0xFF000000 as u32)
    mc_render_world.wr_render(&wr, &w, &r, &cam, 0 - 1)
    check(wr.st.meshed == 0 as u32, 4)
    mc_raster.raster_hash_hex(&r, h2)
    i = 0
    while i < 64 {
        check(rt.ld8(h1, i) == rt.ld8(h2, i), 5)
        i = i + 1
    }
    // a changed block (marks the neighbours too) remeshes only the touching sections
    mc_render_world.wr_mark_block(&wr, 16, 3 - 64, 5)
    mc_raster.backend_begin(&r, &cam, 0xFF000000 as u32)
    mc_render_world.wr_render(&wr, &w, &r, &cam, 0 - 1)
    check(wr.st.meshed >= 2 as u32 && wr.st.meshed <= 4 as u32, 6)
    // distance limit
    var near: mc_render_world.WorldRender = mc_render_world.wr_new(0 - 64, 0, &tb)
    mc_raster.backend_begin(&r, &cam, 0xFF000000 as u32)
    mc_render_world.wr_render(&near, &w, &r, &cam, 0 - 1)
    check(near.st.chunks == 1 as u32 && near.st.far_chunks == 2 as u32, 7)
    // budget: one mesh per frame, the rest is deferred and arrives later
    var bud: mc_render_world.WorldRender = mc_render_world.wr_new(0 - 64, 8, &tb)
    mc_raster.backend_begin(&r, &cam, 0xFF000000 as u32)
    mc_render_world.wr_render(&bud, &w, &r, &cam, 1)
    check(bud.st.meshed == 1 as u32 && bud.st.deferred >= 1 as u32, 8)
    var n: i32 = 0
    while n < 8 {
        mc_raster.backend_begin(&r, &cam, 0xFF000000 as u32)
        mc_render_world.wr_render(&bud, &w, &r, &cam, 1)
        n = n + 1
    }
    mc_raster.raster_hash_hex(&r, h2)
    i = 0
    while i < 64 {
        check(rt.ld8(h1, i) == rt.ld8(h2, i), 9)
        i = i + 1
    }
    // camera looking away: everything culled, nothing drawn
    mc_camera.camera_set_angles(&cam, 180.0, 0.0)
    mc_camera.camera_update(&cam)
    mc_raster.backend_begin(&r, &cam, 0xFF000000 as u32)
    mc_render_world.wr_render(&wr, &w, &r, &cam, 0 - 1)
    check(wr.st.drawn == 0 as u32 && wr.st.culled == wr.st.sections, 10)
    mc_render_world.wr_free(&wr, &r)
    return 0
}
