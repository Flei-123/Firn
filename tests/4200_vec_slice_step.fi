// expect_exit: 0
// tests/4200_vec_slice_step.fi -- r738: `v[a:b:c]` (owning copy, Python step rules), `v.copy()`, `v[a:b] = w`.
import std.io
import std.rt
import std.vec

fn mk(n: i64) -> Vec[i64] {
    var v: Vec[i64] = vec_new[i64]()
    var i: i64 = 0
    while i < n {
        vec_push[i64](&v, i * 10)
        i = i + 1
    }
    return v
}

fn eq(v: *mut Vec[i64], a: i64, b: i64, c: i64, d: i64, n: usize) -> bool {
    if vec_len[i64](v) != n { return false }
    if n > 0 && (*v)[0] != a { return false }
    if n > 1 && (*v)[1] != b { return false }
    if n > 2 && (*v)[2] != c { return false }
    if n > 3 && (*v)[3] != d { return false }
    return true
}

#[no_inline]
fn run() -> i32 {
    var v: Vec[i64] = mk(8)
    // v = [0, 10, 20, 30, 40, 50, 60, 70]
    var s1: Vec[i64] = v[::2]
    if !eq(&s1, 0, 20, 40, 60, 4) { return 2 }
    var s2: Vec[i64] = v[1::3]
    if !eq(&s2, 10, 40, 70, 0, 3) { return 3 }
    var s3: Vec[i64] = v[::-1]
    if !eq(&s3, 70, 60, 50, 40, 8) { return 4 }
    var s4: Vec[i64] = v[6:1:-2]
    if !eq(&s4, 60, 40, 20, 0, 3) { return 5 }
    var s5: Vec[i64] = v[-1:-4:-1]
    if !eq(&s5, 70, 60, 50, 0, 3) { return 6 }
    var s6: Vec[i64] = v[2:6:1]
    if !eq(&s6, 20, 30, 40, 50, 4) { return 7 }
    var s7: Vec[i64] = v[5:2:1]
    if vec_len[i64](&s7) != 0 { return 8 }
    var s8: Vec[i64] = v[100::-3]
    if !eq(&s8, 70, 40, 10, 0, 3) { return 9 }
    var s9: Vec[i64] = v[:-9:-1]
    if !eq(&s9, 70, 60, 50, 40, 8) { return 10 }
    // the copy owns its storage: writing it leaves v alone
    s1[0] = 999
    if v[0] != 0 { return 11 }
    // copy of a view
    var w: Vec[i64] = v[2:5]
    var c: Vec[i64] = w.copy()
    c[0] = 1
    if v[2] != 20 || w[0] != 20 || c[0] != 1 { return 12 }
    if vec_len[i64](&c) != 3 || c[2] != 40 { return 13 }
    var e: Vec[i64] = v[3:3].copy()
    if vec_len[i64](&e) != 0 { return 14 }
    var whole: Vec[i64] = v.copy()
    if !eq(&whole, 0, 10, 20, 30, 8) { return 15 }
    vec_free[i64](&s1)
    vec_free[i64](&s2)
    vec_free[i64](&s3)
    vec_free[i64](&s4)
    vec_free[i64](&s5)
    vec_free[i64](&s6)
    vec_free[i64](&s8)
    vec_free[i64](&s9)
    vec_free[i64](&c)
    vec_free[i64](&whole)
    vec_free[i64](&v)
    return 0
}

#[no_inline]
fn assign() -> i32 {
    var v: Vec[i64] = mk(6)
    // v = [0, 10, 20, 30, 40, 50]
    var r: Vec[i64] = mk(2)
    r[0] = 7
    r[1] = 8
    v[1:3] = r
    if !eq(&v, 0, 7, 8, 30, 6) { return 20 }
    // growing
    var g: Vec[i64] = mk(4)
    v[1:2] = g
    if vec_len[i64](&v) != 9 || v[1] != 0 || v[4] != 30 || v[5] != 8 || v[8] != 50 { return 21 }
    // shrinking
    var one: Vec[i64] = mk(1)
    one[0] = 5
    v[2:7] = one
    if vec_len[i64](&v) != 5 || v[0] != 0 || v[2] != 5 || v[3] != 40 || v[4] != 50 { return 22 }
    // insert (empty range) and delete (empty source)
    var two: Vec[i64] = mk(2)
    v[1:1] = two
    if vec_len[i64](&v) != 7 || v[1] != 0 || v[2] != 10 || v[3] != 0 { return 23 }
    var none: Vec[i64] = vec_new[i64]()
    v[0:2] = none
    if vec_len[i64](&v) != 5 || v[0] != 10 { return 24 }
    // alias: v[0:2] = v[3:5]
    v[0:2] = v[3:5]
    if v[0] != 40 || v[1] != 50 || vec_len[i64](&v) != 5 { return 25 }
    // write through a view (equal length)
    var view: Vec[i64] = v[1:3]
    var pair: Vec[i64] = mk(2)
    view[0:2] = pair
    if v[1] != 0 || v[2] != 10 { return 26 }
    vec_free[i64](&v)
    vec_free[i64](&r)
    vec_free[i64](&g)
    vec_free[i64](&one)
    vec_free[i64](&two)
    vec_free[i64](&pair)
    return 0
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let a: i32 = run()
    if a != 0 { return a }
    return assign()
}
