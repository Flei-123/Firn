// expect_exit: 0
// tests/4400_testkit_mock.fi -- std.mock: spies with scripted returns, argument checks, ordered call log.
import std.rt
import std.mock
import std.testkit

struct Mailer {
    send: fn(u64, i64, i64) -> i64,
    ctx: u64,
}

fn spy_send(ctx: u64, to: i64, size: i64) -> i64 {
    return mock.spy_call2(mock.spy_from_ctx(ctx), to, size)
}

fn notify_all(m: *Mailer, first: i64, last: i64) -> i64 {
    var failed: i64 = 0
    var to: i64 = first
    while to <= last {
        if (*m).send((*m).ctx, to, to * 10) != 0 {
            failed = failed + 1
        }
        to = to + 1
    }
    return failed
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var spy: mock.Spy = mock.spy_new()
    mock.assert_never_called(&spy)
    mock.spy_returns(&spy, 0)
    mock.spy_returns(&spy, 7)
    mock.spy_default(&spy, 0)
    let m: Mailer = Mailer { send: spy_send, ctx: mock.spy_ctx(&spy) }
    let failed: i64 = notify_all(&m, 1, 4)
    testkit.assert_eq_i64(failed, 1)
    mock.assert_calls(&spy, 4)
    mock.assert_call2(&spy, 0, 1, 10)
    mock.assert_call2(&spy, 3, 4, 40)
    testkit.assert_eq_i64(mock.spy_arg(&spy, 1, 1), 20)
    testkit.assert_eq_i64(mock.spy_arg(&spy, 9, 0), 0)
    mock.spy_reset(&spy)
    mock.assert_never_called(&spy)
    mock.spy_free(&spy)

    var log: mock.CallLog = mock.log_new()
    mock.log_add(&log, "open")
    mock.log_add(&log, "write")
    mock.log_add(&log, "close")
    mock.assert_log(&log, "open,write,close")
    mock.log_free(&log)
    return 0
}
