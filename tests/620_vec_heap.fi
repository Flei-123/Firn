// expect_exit: 0
// `Vec[T]` on the HEAP -- item 2 of the self-hosting list
// (docs/SELF_HOSTING.md 4). A field of fixed size has worked since round 2;
// growing only became possible once `size_of[T]()` gave the element size
// (round 16).
//
// The definition lives here in the root file and not in `lib/rt/vec.fi`.
// The reason are TWO limits of today's module system (docs/SELF_HOSTING.md 7):
// `module.Vec[i32]` cannot be written, and a generic template does not see
// module calls. That is why the three memory functions live here instead of
// in `lib/rt/`. The mechanism is the same.

const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11

fn heap_alloc(n: usize) -> u64 {
    if n == 0 {
        return 0
    }
    let len: usize = (n + 4095) / 4096 * 4096
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, 3, 34, -1, 0)
    if r < 0 && r > 0 - 4096 {
        return 0
    }
    return r as u64
}

fn heap_free(p: u64, n: usize) {
    if p == 0 {
        return
    }
    syscall(SYS_MUNMAP, p as i64, ((n + 4095) / 4096 * 4096) as i64, 0, 0, 0, 0)
}

fn mem_copy(target: u64, source: u64, n: usize) {
    var i: usize = 0
    while i < n {
        *((target + i as u64) as *mut u8) = *((source + i as u64) as *mut u8)
        i = i + 1
    }
}

struct Vec[T] {
    ptr: u64,
    len: usize,
    cap: usize,
}

fn vec_new[T: Scalar]() -> Vec[T] {
    return Vec[T] { ptr: 0, len: 0, cap: 0 }
}

fn vec_free[T: Scalar](v: *mut Vec[T]) {
    heap_free((*v).ptr, (*v).cap * size_of[T]())
    (*v).ptr = 0
    (*v).len = 0
    (*v).cap = 0
}

fn vec_grow[T: Scalar](v: *mut Vec[T], needed: usize) -> bool {
    let gr: usize = size_of[T]()
    var cap: usize = (*v).cap
    if cap == 0 {
        cap = 8
    }
    while cap < needed {
        cap = cap * 2
    }
    let new: u64 = heap_alloc(cap * gr)
    if new == 0 {
        return false
    }
    if (*v).len > 0 {
        mem_copy(new, (*v).ptr, (*v).len * gr)
    }
    heap_free((*v).ptr, (*v).cap * gr)
    (*v).ptr = new
    (*v).cap = cap
    return true
}

fn vec_push[T: Scalar](v: *mut Vec[T], value: T) -> bool {
    if (*v).len >= (*v).cap {
        if !vec_grow[T](v, (*v).len + 1) {
            return false
        }
    }
    let addr: u64 = (*v).ptr + (*v).len as u64 * size_of[T]() as u64
    *(addr as *mut T) = value
    (*v).len = (*v).len + 1
    return true
}

fn vec_at[T: Scalar](v: *mut Vec[T], i: usize) -> T {
    if i >= (*v).len {
        return 0 as T
    }
    let addr: u64 = (*v).ptr + i as u64 * size_of[T]() as u64
    return *(addr as *mut T)
}

fn vec_len[T: Scalar](v: *mut Vec[T]) -> usize {
    return (*v).len
}

fn main() -> i32 {
    // --- i32: 1000 elements, many doublings
    var v: Vec[i32] = vec_new[i32]()
    defer vec_free[i32](&v)
    var i: i32 = 0
    while i < 1000 {
        if !vec_push[i32](&v, i * 3) {
            return 1
        }
        i = i + 1
    }
    if vec_len[i32](&v) != 1000 {
        return 2
    }
    if vec_at[i32](&v, 0) != 0 {
        return 3
    }
    if vec_at[i32](&v, 999) != 2997 {
        return 4
    }
    // beyond the end: the null value, no crash
    if vec_at[i32](&v, 5000) != 0 {
        return 5
    }

    // --- u8: a different element size, an instance of its own
    var b: Vec[u8] = vec_new[u8]()
    defer vec_free[u8](&b)
    var k: usize = 0
    while k < 300 {
        if !vec_push[u8](&b, (k % 251) as u8) {
            return 6
        }
        k = k + 1
    }
    if vec_len[u8](&b) != 300 {
        return 7
    }
    if vec_at[u8](&b, 299) != ((299 as u64) % 251) as u8 {
        return 8
    }

    // --- u64: the scaling has to be right
    var w: Vec[u64] = vec_new[u64]()
    defer vec_free[u64](&w)
    var j: u64 = 0
    while j < 100 {
        if !vec_push[u64](&w, j * 1000000007) {
            return 9
        }
        j = j + 1
    }
    if vec_at[u64](&w, 99) != 99 * 1000000007 {
        return 10
    }
    return 0
}
