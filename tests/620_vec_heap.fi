// expect_exit: 0
// `Vec[T]` auf dem HEAP — Punkt 2 der Selbsthosting-Liste
// (docs/SELBSTHOSTING.md §4). Ein Feld fester Groesse geht seit Runde 2;
// wachsen kann es erst, seit `size_of[T]()` die Elementgroesse liefert
// (Runde 16).
//
// Die Definition steht hier in der Wurzeldatei und nicht in `lib/rt/vec.fi`.
// Grund sind ZWEI Grenzen des heutigen Modulsystems (docs/SELBSTHOSTING.md §7):
// `modul.Vec[i32]` laesst sich nicht schreiben, und eine generische Vorlage
// sieht keine Modulaufrufe. Deshalb stehen auch die drei Speicherfunktionen
// hier statt in `lib/rt/`. Der Mechanismus ist derselbe.

const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11

fn heap_alloc(n: usize) -> u64 {
    if n == 0 {
        return 0
    }
    let len: usize = (n + 4095) / 4096 * 4096
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, 3, 34, -1, 0)
    if r < 0 && r > 0 - 4096 {
        return 0
    }
    return r as u64
}

fn heap_free(p: u64, n: usize) {
    if p == 0 {
        return
    }
    syscall(SYS_MUNMAP, p as i64, ((n + 4095) / 4096 * 4096) as i64, 0, 0, 0, 0)
}

fn mem_copy(ziel: u64, quelle: u64, n: usize) {
    var i: usize = 0
    while i < n {
        *((ziel + i as u64) as *mut u8) = *((quelle + i as u64) as *mut u8)
        i = i + 1
    }
}

struct Vec[T] {
    ptr: u64,
    len: usize,
    kap: usize,
}

fn vec_neu[T: Scalar]() -> Vec[T] {
    return Vec[T]{ ptr: 0, len: 0, kap: 0 }
}

fn vec_frei[T: Scalar](v: *mut Vec[T]) {
    heap_free((*v).ptr, (*v).kap * size_of[T]())
    (*v).ptr = 0
    (*v).len = 0
    (*v).kap = 0
}

fn vec_wachse[T: Scalar](v: *mut Vec[T], noetig: usize) -> bool {
    let gr: usize = size_of[T]()
    var kap: usize = (*v).kap
    if kap == 0 {
        kap = 8
    }
    while kap < noetig {
        kap = kap * 2
    }
    let neu: u64 = heap_alloc(kap * gr)
    if neu == 0 {
        return false
    }
    if (*v).len > 0 {
        mem_copy(neu, (*v).ptr, (*v).len * gr)
    }
    heap_free((*v).ptr, (*v).kap * gr)
    (*v).ptr = neu
    (*v).kap = kap
    return true
}

fn vec_push[T: Scalar](v: *mut Vec[T], wert: T) -> bool {
    if (*v).len >= (*v).kap {
        if !vec_wachse[T](v, (*v).len + 1) {
            return false
        }
    }
    let adr: u64 = (*v).ptr + (*v).len as u64 * size_of[T]() as u64
    *(adr as *mut T) = wert
    (*v).len = (*v).len + 1
    return true
}

fn vec_at[T: Scalar](v: *mut Vec[T], i: usize) -> T {
    if i >= (*v).len {
        return 0 as T
    }
    let adr: u64 = (*v).ptr + i as u64 * size_of[T]() as u64
    return *(adr as *mut T)
}

fn vec_len[T: Scalar](v: *mut Vec[T]) -> usize {
    return (*v).len
}

fn main() -> i32 {
    // --- i32: 1000 Elemente, viele Verdopplungen
    var v: Vec[i32] = vec_neu[i32]()
    defer vec_frei[i32](&v)
    var i: i32 = 0
    while i < 1000 {
        if !vec_push[i32](&v, i * 3) {
            return 1
        }
        i = i + 1
    }
    if vec_len[i32](&v) != 1000 {
        return 2
    }
    if vec_at[i32](&v, 0) != 0 {
        return 3
    }
    if vec_at[i32](&v, 999) != 2997 {
        return 4
    }
    // jenseits des Endes: Nullwert, kein Absturz
    if vec_at[i32](&v, 5000) != 0 {
        return 5
    }

    // --- u8: andere Elementgroesse, eigene Auspraegung
    var b: Vec[u8] = vec_neu[u8]()
    defer vec_frei[u8](&b)
    var k: usize = 0
    while k < 300 {
        if !vec_push[u8](&b, (k % 251) as u8) {
            return 6
        }
        k = k + 1
    }
    if vec_len[u8](&b) != 300 {
        return 7
    }
    if vec_at[u8](&b, 299) != ((299 as u64) % 251) as u8 {
        return 8
    }

    // --- u64: die Skalierung muss stimmen
    var w: Vec[u64] = vec_neu[u64]()
    defer vec_frei[u64](&w)
    var j: u64 = 0
    while j < 100 {
        if !vec_push[u64](&w, j * 1000000007) {
            return 9
        }
        j = j + 1
    }
    if vec_at[u64](&w, 99) != 99 * 1000000007 {
        return 10
    }
    return 0
}
