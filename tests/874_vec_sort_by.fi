// expect_exit: 0
// ROUND 58 -- THE APPLICATION: sorting with an ordering OF YOUR OWN.
//
// Up to round 57 `vec_sort[T: Ord]` took its ordering off the TYPE. That is
// right where a type has exactly one natural order -- and wrong as soon as
// the same data has to be sorted twice differently. There was no way out but
// to copy the sorter.
//
// `vec_sort_by[T](v, less)` takes the ordering as a VALUE. One sorter, any
// number of orderings. The same holds for the predicate:
// `vec_index_where`, `vec_count_where`, `vec_all`, `vec_any` are the same
// loop with a question that comes from outside.

import std.vec

struct Point { x: i32, y: i32 }

fn by_x(a: *Point, b: *Point) -> bool { return (*a).x < (*b).x }
fn by_y(a: *Point, b: *Point) -> bool { return (*a).y < (*b).y }
fn desc_x(a: *Point, b: *Point) -> bool { return (*b).x < (*a).x }
fn positive_x(p: *Point) -> bool { return (*p).x > 0 }
fn negative_x(p: *Point) -> bool { return (*p).x < 0 }

fn i32_less(a: *i32, b: *i32) -> bool { return *a < *b }
fn i32_greater(a: *i32, b: *i32) -> bool { return *b < *a }
fn even(a: *i32) -> bool { return *a % 2 == 0 }

fn point_at(v: *mut Vec[Point], i: usize) -> Point {
    let p: *mut Point = vec_elem_ptr[Point](v, i)
    return *p
}

fn main() -> i32 {
    // --- scalars, both directions, ONE sorter ---
    var n: Vec[i32] = vec_new[i32]()
    defer vec_free[i32](&n)
    vec_push[i32](&n, 5)
    vec_push[i32](&n, 1)
    vec_push[i32](&n, 4)
    vec_push[i32](&n, 1)
    vec_push[i32](&n, 3)
    vec_sort_by[i32](&n, i32_less)
    if !vec_is_sorted_by[i32](&n, i32_less) { return 1 }
    if vec_at[i32](&n, 0) != 1 { return 2 }
    if vec_at[i32](&n, 4) != 5 { return 3 }
    vec_sort_by[i32](&n, i32_greater)
    if !vec_is_sorted_by[i32](&n, i32_greater) { return 4 }
    if vec_at[i32](&n, 0) != 5 { return 5 }

    // the ordering as an ANONYMOUS function
    vec_sort_by[i32](&n, fn(a: *i32, b: *i32) -> bool { return *a < *b })
    if vec_at[i32](&n, 0) != 1 { return 6 }

    // --- predicates ---
    if vec_count_where[i32](&n, even) != 1 { return 7 }
    if vec_index_where[i32](&n, even) != 3 { return 8 }
    if !vec_any[i32](&n, even) { return 9 }
    if vec_all[i32](&n, even) { return 10 }
    if vec_min_by[i32](&n, i32_less) != 0 { return 11 }
    if vec_max_by[i32](&n, i32_less) != 4 { return 12 }

    // --- structs: the same data, two orderings ---
    var v: Vec[Point] = vec_new[Point]()
    defer vec_free[Point](&v)
    vec_push[Point](&v, Point { x: 3, y: 1 })
    vec_push[Point](&v, Point { x: 1, y: 3 })
    vec_push[Point](&v, Point { x: 2, y: 2 })
    vec_push[Point](&v, Point { x: 0 - 1, y: 4 })

    vec_sort_by[Point](&v, by_x)
    if point_at(&v, 0).x != -1 { return 13 }
    if point_at(&v, 3).x != 3 { return 14 }
    if !vec_is_sorted_by[Point](&v, by_x) { return 15 }

    vec_sort_by[Point](&v, by_y)
    if point_at(&v, 0).y != 1 { return 16 }
    if point_at(&v, 3).y != 4 { return 17 }
    if !vec_is_sorted_by[Point](&v, by_y) { return 18 }

    vec_sort_by[Point](&v, desc_x)
    if point_at(&v, 0).x != 3 { return 19 }
    if point_at(&v, 3).x != -1 { return 20 }

    if vec_count_where[Point](&v, positive_x) != 3 { return 21 }
    if vec_count_where[Point](&v, negative_x) != 1 { return 22 }
    if vec_index_where[Point](&v, negative_x) != 3 { return 23 }
    if vec_all[Point](&v, positive_x) { return 24 }
    if !vec_any[Point](&v, positive_x) { return 25 }

    // empty and single element: `all` true, `any` false, sorted
    var e: Vec[i32] = vec_new[i32]()
    defer vec_free[i32](&e)
    vec_sort_by[i32](&e, i32_less)
    if !vec_all[i32](&e, even) { return 26 }
    if vec_any[i32](&e, even) { return 27 }
    if !vec_is_sorted_by[i32](&e, i32_less) { return 28 }
    vec_push[i32](&e, 8)
    vec_sort_by[i32](&e, i32_less)
    if vec_at[i32](&e, 0) != 8 { return 29 }
    return 0
}
