// expect_exit: 0
// tests/3090_mc_vk_shader_spv.fi -- the committed Vulkan SPIR-V of the MC renderer (lib/gpu/spv/vk_*.spv, embedded by
// lib/gpu/vk_shaders.fi) against the interface the host code relies on (docs/VK-RENDERER.md (Shaders)). Pure binary parse, no GPU,
// no glslang: per module header (magic, SPIR-V 1.0, word count), ONE entry point "main" of the right stage, descriptor set 0 with
// exactly the expected bindings, input / output location masks, push constant variable only in mc.vert, and the std140 member
// offsets of the `Frame` UBO and the `Obj` push block equal to the U_* / PC_* constants. A vertex output mask must equal the input
// mask of its fragment shader (mc, ent). Does not prove the shaders RENDER correctly (no GPU here, see docs/VK-RENDERER.md (Shaders)).
import std.rt
import std.io
import gpu.vk_shaders

fn w(code: u64, i: usize) -> u64 {
    return rt.ld32(code, i) as u64
}

fn name_eq(code: u64, wi: usize, s: str) -> bool {
    var k: usize = 0
    while k < s.n {
        let b: u64 = (w(code, wi + k / 4) >> (((k % 4) * 8) as u64)) & 255
        if b != (*(s.p + k)) as u64 { return false }
        k = k + 1
    }
    let z: u64 = (w(code, wi + s.n / 4) >> (((s.n % 4) * 8) as u64)) & 255
    return z == 0
}

// member index of struct `sid` called `nm` (OpMemberName), or -1
fn find_member(code: u64, nw: usize, sid: u64, nm: str) -> i64 {
    var pos: usize = 5
    while pos < nw {
        let h: u64 = w(code, pos)
        let wc: usize = (h >> 16) as usize
        let op: u64 = h & 0xFFFF
        if wc == 0 { return 0 - 1 }
        if op == 6 && w(code, pos + 1) == sid && name_eq(code, pos + 3, nm) {
            return w(code, pos + 2) as i64
        }
        pos = pos + wc
    }
    return 0 - 1
}

// Offset decoration of member `idx` of struct `sid`, or -1
fn member_offset(code: u64, nw: usize, sid: u64, idx: u64) -> i64 {
    var pos: usize = 5
    while pos < nw {
        let h: u64 = w(code, pos)
        let wc: usize = (h >> 16) as usize
        let op: u64 = h & 0xFFFF
        if wc == 0 { return 0 - 1 }
        if op == 72 && w(code, pos + 1) == sid && w(code, pos + 2) == idx && w(code, pos + 3) == 35 {
            return w(code, pos + 4) as i64
        }
        pos = pos + wc
    }
    return 0 - 1
}

// id of the struct type called `nm` (OpName), 0 = none
fn find_struct(code: u64, nw: usize, nm: str) -> u64 {
    var pos: usize = 5
    while pos < nw {
        let h: u64 = w(code, pos)
        let wc: usize = (h >> 16) as usize
        let op: u64 = h & 0xFFFF
        if wc == 0 { return 0 }
        if op == 5 && name_eq(code, pos + 2, nm) { return w(code, pos + 1) }
        pos = pos + wc
    }
    return 0
}

static mut fails: i32 = 0

fn fail(msg: io.Fmt, i: i32) {
    io.fmt_print(f"FAIL {vk_shaders.shader_name(i)}: ")
    io.fmt_print_line(msg)
    fails = fails + 1
}

fn member_is(code: u64, nw: usize, sid: u64, nm: str, want: usize, i: i32) {
    let idx: i64 = find_member(code, nw, sid, nm)
    if idx < 0 {
        fail(f"member {nm} missing", i)
        return
    }
    let off: i64 = member_offset(code, nw, sid, idx as u64)
    if off != (want as i64) {
        fail(f"member {nm} offset {off} != {want}", i)
    }
}

fn frame_members(code: u64, nw: usize, i: i32) {
    let fid: u64 = find_struct(code, nw, "Frame")
    if fid == 0 {
        fail(f"struct Frame missing", i)
        return
    }
    member_is(code, nw, fid, "u_rv", vk_shaders.U_RV, i)
    member_is(code, nw, fid, "u_fog", vk_shaders.U_FOG, i)
    member_is(code, nw, fid, "u_fade", vk_shaders.U_FADE, i)
    member_is(code, nw, fid, "u_light", vk_shaders.U_LIGHT, i)
    member_is(code, nw, fid, "u_cam", vk_shaders.U_CAM, i)
    member_is(code, nw, fid, "u_sun", vk_shaders.U_SUN, i)
    member_is(code, nw, fid, "u_fogc", vk_shaders.U_FOGC, i)
    member_is(code, nw, fid, "u_r", vk_shaders.U_R, i)
    member_is(code, nw, fid, "u_u", vk_shaders.U_U, i)
    member_is(code, nw, fid, "u_f", vk_shaders.U_F, i)
    member_is(code, nw, fid, "u_zen", vk_shaders.U_ZEN, i)
    member_is(code, nw, fid, "u_hor", vk_shaders.U_HOR, i)
    member_is(code, nw, fid, "u_glc", vk_shaders.U_GLC, i)
    member_is(code, nw, fid, "u_tint", vk_shaders.U_TINT, i)
    member_is(code, nw, fid, "u_tiles", vk_shaders.U_TILES, i)
    member_is(code, nw, fid, "u_size", vk_shaders.U_SIZE, i)
    member_is(code, nw, fid, "u_pagel", vk_shaders.U_PAGEL, i)
    member_is(code, nw, fid, "u_trans", vk_shaders.U_TRANS, i)
    member_is(code, nw, fid, "u_filter", vk_shaders.U_FILTER, i)
    member_is(code, nw, fid, "u_discs", vk_shaders.U_DISCS, i)
    member_is(code, nw, fid, "u_invert", vk_shaders.U_INVERT, i)
    member_is(code, nw, fid, "u_h", vk_shaders.U_H, i)
}

// results of one module scan
static mut scan_bind_mask: u64 = 0
static mut scan_in_mask: u64 = 0
static mut scan_out_mask: u64 = 0
static mut scan_push_vars: i32 = 0
static mut scan_entries: i32 = 0

fn scan(i: i32) {
    let code: u64 = vk_shaders.shader_code(i)
    let n: usize = vk_shaders.shader_size(i)
    scan_bind_mask = 0
    scan_in_mask = 0
    scan_out_mask = 0
    scan_push_vars = 0
    scan_entries = 0
    if n < 24 || (n % 4) != 0 {
        fail(f"size", i)
        return
    }
    let nw: usize = n / 4
    if w(code, 0) != 0x07230203 { fail(f"magic", i) }
    if w(code, 1) != 0x00010000 { fail(f"version is not SPIR-V 1.0", i) }
    let bound: usize = w(code, 3) as usize
    if bound == 0 || bound > 100000 {
        fail(f"id bound", i)
        return
    }
    let bsz: usize = (bound + 1) * 4
    let binding: u64 = rt.heap_alloc(bsz)
    let dset: u64 = rt.heap_alloc(bsz)
    let loc: u64 = rt.heap_alloc(bsz)
    var k: usize = 0
    while k <= bound {
        rt.st32(binding, k, 0xFFFFFFFF as u32)
        rt.st32(dset, k, 0xFFFFFFFF as u32)
        rt.st32(loc, k, 0xFFFFFFFF as u32)
        k = k + 1
    }
    var pos: usize = 5
    while pos < nw {
        let h: u64 = w(code, pos)
        let wc: usize = (h >> 16) as usize
        let op: u64 = h & 0xFFFF
        if wc == 0 || pos + wc > nw {
            fail(f"broken instruction stream", i)
            break
        }
        if op == 15 {
            scan_entries = scan_entries + 1
            if w(code, pos + 1) != (vk_shaders.shader_stage(i) as u64) { fail(f"wrong execution model", i) }
            if !name_eq(code, pos + 3, "main") { fail(f"entry point is not main", i) }
        }
        if op == 71 {
            let t: usize = w(code, pos + 1) as usize
            let d: u64 = w(code, pos + 2)
            if t <= bound {
                if d == 33 { rt.st32(binding, t, w(code, pos + 3) as u32) }
                if d == 34 { rt.st32(dset, t, w(code, pos + 3) as u32) }
                if d == 30 { rt.st32(loc, t, w(code, pos + 3) as u32) }
            }
        }
        if op == 59 {
            // OpVariable: result type, result id, storage class
            let id: usize = w(code, pos + 2) as usize
            let sc: u64 = w(code, pos + 3)
            if sc == 9 { scan_push_vars = scan_push_vars + 1 }
            if id <= bound {
                let bd: u64 = rt.ld32(binding, id) as u64
                let st: u64 = rt.ld32(dset, id) as u64
                let lc: u64 = rt.ld32(loc, id) as u64
                if bd != 0xFFFFFFFF {
                    if st != 0 { fail(f"descriptor set is not 0", i) }
                    scan_bind_mask = scan_bind_mask | (1 << bd)
                }
                if sc == 1 && lc != 0xFFFFFFFF { scan_in_mask = scan_in_mask | (1 << lc) }
                if sc == 3 && lc != 0xFFFFFFFF { scan_out_mask = scan_out_mask | (1 << lc) }
            }
        }
        pos = pos + wc
    }
    if scan_entries != 1 { fail(f"not exactly one entry point", i) }
    rt.heap_free(binding, bsz)
    rt.heap_free(dset, bsz)
    rt.heap_free(loc, bsz)
}

fn expect_masks(i: i32, bind: u64, inm: u64, outm: u64, push: i32) {
    scan(i)
    if scan_bind_mask != bind { fail(f"binding mask {scan_bind_mask} != {bind}", i) }
    if scan_in_mask != inm { fail(f"input location mask {scan_in_mask} != {inm}", i) }
    if scan_out_mask != outm { fail(f"output location mask {scan_out_mask} != {outm}", i) }
    if scan_push_vars != push { fail(f"push constant variables {scan_push_vars} != {push}", i) }
}

fn main() -> i32 {
    // index: 0 mc.vert 1 mc.frag 2 sky.vert 3 sky.frag 4 ent.vert 5 ent.frag 6 hud.vert 7 hud.frag 8 tint.frag 9 model.vert 10 model.frag
    // masks: bindings (bit = binding number), input locations, output locations, push constant variables
    expect_masks(0, 0x61, 0x01, 0x1F, 1)
    expect_masks(1, 0x1F, 0x1F, 0x01, 0)
    expect_masks(2, 0x00, 0x00, 0x00, 0)
    expect_masks(3, 0x01, 0x00, 0x01, 0)
    expect_masks(4, 0x01, 0x1F, 0x07, 0)
    expect_masks(5, 0x01, 0x07, 0x01, 0)
    expect_masks(6, 0x01, 0x03, 0x01, 0)
    expect_masks(7, 0x01, 0x01, 0x01, 0)
    expect_masks(8, 0x01, 0x00, 0x01, 0)
    expect_masks(9, 0x01, 0x07, 0x3F, 1)
    expect_masks(10, 0x1F, 0x3F, 0x01, 0)
    // vertex outputs feed the fragment inputs
    scan(0)
    let mc_out: u64 = scan_out_mask
    scan(1)
    if mc_out != scan_in_mask { fail(f"mc vertex outputs != fragment inputs", 0) }
    scan(4)
    let ent_out: u64 = scan_out_mask
    scan(5)
    if ent_out != scan_in_mask { fail(f"ent vertex outputs != fragment inputs", 4) }
    scan(6)
    let hud_out: u64 = scan_out_mask
    scan(7)
    if hud_out != scan_in_mask { fail(f"hud vertex outputs != fragment inputs", 6) }
    scan(9)
    let model_out: u64 = scan_out_mask
    scan(10)
    if model_out != scan_in_mask { fail(f"model vertex outputs != fragment inputs", 9) }
    // std140 offsets of the Frame UBO in every module that uses it, push block layout in mc.vert
    var i: i32 = 0
    while i < vk_shaders.SHADER_COUNT {
        if i != 2 {
            let code: u64 = vk_shaders.shader_code(i)
            frame_members(code, vk_shaders.shader_size(i) / 4, i)
        }
        i = i + 1
    }
    let mcv: u64 = vk_shaders.shader_code(0)
    let mcn: usize = vk_shaders.shader_size(0) / 4
    let obj: u64 = find_struct(mcv, mcn, "Obj")
    if obj == 0 {
        fail(f"struct Obj missing", 0)
    } else {
        member_is(mcv, mcn, obj, "u_origin", vk_shaders.PC_ORIGIN, 0)
        member_is(mcv, mcn, obj, "u_pool", vk_shaders.PC_POOL, 0)
    }
    // tint reuses the sky strip
    if vk_shaders.TINT_VS.n != vk_shaders.SKY_VS.n { fails = fails + 1 }
    if fails == 0 {
        io.fmt_print_line(f"ok: {vk_shaders.SHADER_COUNT} Vulkan SPIR-V modules match the interface")
        return 0
    }
    io.fmt_print_line(f"{fails} failures")
    return 1
}
