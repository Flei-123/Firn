// expect_exit: 0
// tests/3601_cal_vcard.fi -- cal.vcard: RFC 6350 / RFC 2426 / vCard 2.1 examples, TYPE notations,
// structured values, quoted-printable + Latin-1, photos (base64, data: URI), GEO, BDAY, builders and
// write -> parse round trips for the three versions.
import std.rt
import std.str
import cal.content
import cal.vcard

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn same(b: *mut rt.Buf, want: str) -> bool {
    return rt.buf_len(b) == want.n && rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.n)
}

// the k-th property `name` of the card (0-based), -1 if there is none
fn nth(d: *mut content.Doc, card: usize, name: str, k: usize) -> i64 {
    var p: i64 = content.find_prop(d, card, name, -1)
    var i: usize = 0
    while p >= 0 && i < k {
        p = content.find_prop(d, card, name, p)
        i = i + 1
    }
    return p
}

fn field_is(d: *mut content.Doc, p: i64, idx: usize, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    vcard.field(d, p as usize, idx, &b)
    let ok: bool = same(&b, want)
    rt.buf_free(&b)
    return ok
}

fn text_is(d: *mut content.Doc, p: i64, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    vcard.text(d, p as usize, &b)
    let ok: bool = same(&b, want)
    rt.buf_free(&b)
    return ok
}

fn rfc6350() {
    let raw: str = "BEGIN:VCARD\r\nVERSION:4.0\r\nFN:Simon Perreault\r\nN:Perreault;Simon;;;ing. jr,M.Sc.\r\nBDAY:--0203\r\nANNIVERSARY:20090808T1430-0500\r\nGENDER:M\r\nLANG;PREF=1:fr\r\nLANG;PREF=2:en\r\nORG;TYPE=work:Viagenie\r\nADR;TYPE=work:;Suite D2-630;2875 Laurier;Quebec;QC;G1V 2M2;Canada\r\nTEL;VALUE=uri;PREF=1;TYPE=\"voice,home\":tel:+1-418-656-9254;ext=102\r\nTEL;VALUE=uri;TYPE=\"voice,work,cell,video,text\":tel:+1-418-262-6501\r\nEMAIL;TYPE=work:simon.perreault@viagenie.ca\r\nGEO;TYPE=work:geo:46.772673,-71.282945\r\nKEY;TYPE=work;VALUE=uri:http://www.viagenie.ca/simon.perreault/simon.asc\r\nTZ:-0500\r\nURL;TYPE=home:http://nomis80.org\r\nEND:VCARD\r\n"
    var d: content.Doc = content.doc_new()
    check("6350 clean", content.parse(raw, &d) == 0)
    let c: i64 = vcard.card_first(&d)
    check("6350 card", c >= 0)
    check("6350 no second card", vcard.card_next(&d, c) < 0)
    check("6350 version", vcard.version(&d, c as usize) == 40)
    let n: i64 = nth(&d, c as usize, "N", 0)
    check("6350 family", field_is(&d, n, vcard.N_FAMILY, "Perreault"))
    check("6350 given", field_is(&d, n, vcard.N_GIVEN, "Simon"))
    check("6350 additional empty", field_is(&d, n, vcard.N_ADDITIONAL, ""))
    check("6350 suffix items", vcard.field_item_count(&d, n as usize, vcard.N_SUFFIX) == 2)
    var b: rt.Buf = rt.buf_new()
    vcard.field_item(&d, n as usize, vcard.N_SUFFIX, 1, &b)
    check("6350 suffix item 1", same(&b, "M.Sc."))
    rt.buf_free(&b)
    let adr: i64 = nth(&d, c as usize, "ADR", 0)
    check("6350 adr count", vcard.field_count(&d, adr as usize) == 7)
    check("6350 adr ext", field_is(&d, adr, vcard.ADR_EXT, "Suite D2-630"))
    check("6350 adr street", field_is(&d, adr, vcard.ADR_STREET, "2875 Laurier"))
    check("6350 adr locality", field_is(&d, adr, vcard.ADR_LOCALITY, "Quebec"))
    check("6350 adr region", field_is(&d, adr, vcard.ADR_REGION, "QC"))
    check("6350 adr code", field_is(&d, adr, vcard.ADR_CODE, "G1V 2M2"))
    check("6350 adr country", field_is(&d, adr, vcard.ADR_COUNTRY, "Canada"))
    check("6350 adr type", vcard.has_type(&d, adr as usize, "WORK") && !vcard.has_type(&d, adr as usize, "home"))
    let t0: i64 = nth(&d, c as usize, "TEL", 0)
    let t1: i64 = nth(&d, c as usize, "TEL", 1)
    check("6350 tel0 types", vcard.has_type(&d, t0 as usize, "voice") && vcard.has_type(&d, t0 as usize, "HOME") && !vcard.has_type(&d, t0 as usize, "work"))
    check("6350 tel1 types", vcard.has_type(&d, t1 as usize, "cell") && vcard.has_type(&d, t1 as usize, "text") && vcard.has_type(&d, t1 as usize, "video"))
    check("6350 pref", vcard.is_pref(&d, t0 as usize) && !vcard.is_pref(&d, t1 as usize))
    check("6350 tel value", text_is(&d, t0, "tel:+1-418-656-9254;ext=102"))
    var by: i64 = 0
    var bm: i64 = 0
    var bd: i64 = 0
    check("6350 bday", vcard.bday(&d, nth(&d, c as usize, "BDAY", 0) as usize, &by, &bm, &bd) && by == 0 && bm == 2 && bd == 3)
    var lat: i64 = 0
    var lon: i64 = 0
    check("6350 geo", vcard.geo(&d, nth(&d, c as usize, "GEO", 0) as usize, &lat, &lon) && lat == 46772673 && lon == -71282945)
    var nm: rt.Buf = rt.buf_new()
    vcard.display_name(&d, c as usize, &nm)
    check("6350 display name", same(&nm, "Simon Perreault"))
    rt.buf_free(&nm)
    var bytes: rt.Buf = rt.buf_new()
    var mime: rt.Buf = rt.buf_new()
    check("6350 key is uri", vcard.media(&d, nth(&d, c as usize, "KEY", 0) as usize, &bytes, &mime) == vcard.MEDIA_URI && same(&bytes, "http://www.viagenie.ca/simon.perreault/simon.asc"))
    rt.buf_free(&bytes)
    rt.buf_free(&mime)
    // write -> parse gives the same lines
    var out: rt.Buf = rt.buf_new()
    content.write(&d, &out)
    var d2: content.Doc = content.doc_new()
    check("6350 re-parse clean", content.parse(str { p: rt.buf_data(&out), n: rt.buf_len(&out) }, &d2) == 0)
    var out2: rt.Buf = rt.buf_new()
    content.write(&d2, &out2)
    check("6350 write stable", rt.buf_len(&out) == rt.buf_len(&out2) && rt.mem_eq(rt.buf_ptr(&out), rt.buf_ptr(&out2), rt.buf_len(&out)))
    check("6350 write equals input", same(&out, raw))
    rt.buf_free(&out)
    rt.buf_free(&out2)
    content.doc_free(&d)
    content.doc_free(&d2)
}

fn rfc2426() {
    let raw: str = "BEGIN:vCard\r\nVERSION:3.0\r\nFN:Frank Dawson\r\nORG:Lotus Development Corporation\r\nADR;TYPE=WORK,POSTAL,PARCEL:;;6544 Battleford Drive\r\n ;Raleigh;NC;27613-3502;U.S.A.\r\nTEL;TYPE=VOICE,MSG,WORK:+1-919-676-9515\r\nTEL;TYPE=FAX,WORK:+1-919-676-9564\r\nEMAIL;TYPE=INTERNET,PREF:Frank_Dawson@Lotus.com\r\nEMAIL;TYPE=INTERNET:fdawson@earthlink.net\r\nURL:http://home.earthlink.net/~fdawson\r\nEND:vCard\r\n"
    var d: content.Doc = content.doc_new()
    check("2426 clean", content.parse(raw, &d) == 0)
    let c: i64 = vcard.card_first(&d)
    check("2426 card (lower case BEGIN)", c >= 0 && vcard.version(&d, c as usize) == 30)
    let adr: i64 = nth(&d, c as usize, "ADR", 0)
    check("2426 adr unfolded", field_is(&d, adr, vcard.ADR_STREET, "6544 Battleford Drive") && field_is(&d, adr, vcard.ADR_LOCALITY, "Raleigh"))
    check("2426 adr types", vcard.has_type(&d, adr as usize, "postal") && vcard.has_type(&d, adr as usize, "PARCEL") && vcard.has_type(&d, adr as usize, "work"))
    check("2426 adr code + country", field_is(&d, adr, vcard.ADR_CODE, "27613-3502") && field_is(&d, adr, vcard.ADR_COUNTRY, "U.S.A."))
    check("2426 email pref", vcard.is_pref(&d, nth(&d, c as usize, "EMAIL", 0) as usize) && !vcard.is_pref(&d, nth(&d, c as usize, "EMAIL", 1) as usize))
    check("2426 email text", text_is(&d, nth(&d, c as usize, "EMAIL", 1), "fdawson@earthlink.net"))
    check("2426 org", text_is(&d, nth(&d, c as usize, "ORG", 0), "Lotus Development Corporation"))
    var nm: rt.Buf = rt.buf_new()
    vcard.display_name(&d, c as usize, &nm)
    check("2426 display name", same(&nm, "Frank Dawson"))
    rt.buf_free(&nm)
    content.doc_free(&d)
}

fn v21() {
    // bare TYPE, quoted-printable with a soft line break, Latin-1, base64 photo with the blank line
    let raw: str = "BEGIN:VCARD\r\nVERSION:2.1\r\nN;CHARSET=ISO-8859-1;ENCODING=QUOTED-PRINTABLE:M=FCller;Hans;;Dr.;\r\nFN;CHARSET=UTF-8;ENCODING=QUOTED-PRINTABLE:Hans M=C3=BCller\r\nTEL;WORK;VOICE:+43 1 2345\r\nTEL;CELL;PREF:+43 660 1\r\nADR;HOME;ENCODING=QUOTED-PRINTABLE:;;Stra=C3=9Fe 1=0D=0A=\r\nStock 2;Wien;;1010;\r\nNOTE;ENCODING=QUOTED-PRINTABLE:eins=\r\n zwei=3Dx\r\nPHOTO;ENCODING=BASE64;JPEG:AAECAwQF\r\n BgcICQ==\r\n\r\nEND:VCARD\r\n"
    var d: content.Doc = content.doc_new()
    check("2.1 clean", content.parse(raw, &d) == 0)
    let c: i64 = vcard.card_first(&d)
    check("2.1 version", vcard.version(&d, c as usize) == 21)
    let n: i64 = nth(&d, c as usize, "N", 0)
    check("2.1 latin1 family", field_is(&d, n, vcard.N_FAMILY, "M\u{FC}ller"))
    check("2.1 prefix", field_is(&d, n, vcard.N_PREFIX, "Dr."))
    check("2.1 suffix empty", field_is(&d, n, vcard.N_SUFFIX, ""))
    check("2.1 utf8 qp fn", text_is(&d, nth(&d, c as usize, "FN", 0), "Hans M\u{FC}ller"))
    let t0: i64 = nth(&d, c as usize, "TEL", 0)
    let t1: i64 = nth(&d, c as usize, "TEL", 1)
    check("2.1 bare types", vcard.has_type(&d, t0 as usize, "WORK") && vcard.has_type(&d, t0 as usize, "voice"))
    check("2.1 bare pref", vcard.is_pref(&d, t1 as usize) && vcard.has_type(&d, t1 as usize, "cell"))
    let adr: i64 = nth(&d, c as usize, "ADR", 0)
    check("2.1 qp street with soft break", field_is(&d, adr, vcard.ADR_STREET, "Stra\u{DF}e 1\r\nStock 2"))
    check("2.1 adr locality", field_is(&d, adr, vcard.ADR_LOCALITY, "Wien"))
    check("2.1 qp note, soft break keeps the space", text_is(&d, nth(&d, c as usize, "NOTE", 0), "eins zwei=x"))
    var bytes: rt.Buf = rt.buf_new()
    var mime: rt.Buf = rt.buf_new()
    let k: u32 = vcard.media(&d, nth(&d, c as usize, "PHOTO", 0) as usize, &bytes, &mime)
    check("2.1 photo binary", k == vcard.MEDIA_BINARY && rt.buf_len(&bytes) == 10)
    check("2.1 photo bytes", same(&bytes, "\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09"))
    rt.buf_free(&bytes)
    rt.buf_free(&mime)
    content.doc_free(&d)
}

fn photos() {
    let raw: str = "BEGIN:VCARD\r\nVERSION:3.0\r\nFN:A\r\nPHOTO;ENCODING=b;TYPE=JPEG:AAECAwQFBgcICQ==\r\nLOGO;ENCODING=b;TYPE=PNG:AAEC\r\nSOUND;ENCODING=b;TYPE=wave:AAEC\r\nPHOTO;VALUE=uri:http://x.example/a.jpg\r\nPHOTO;ENCODING=b:A!B\r\nEND:VCARD\r\nBEGIN:VCARD\r\nVERSION:4.0\r\nFN:B\r\nPHOTO:data:image/png;base64,AAECAwQFBgcICQ==\r\nPHOTO:data:text/plain,a%20b%2Cc\r\nPHOTO;MEDIATYPE=image/gif:http://x.example/b.gif\r\nPHOTO:data:image/png;base64,@@@\r\nPHOTO:data:nocomma\r\nEND:VCARD\r\n"
    var d: content.Doc = content.doc_new()
    check("photos clean", content.parse(raw, &d) == 0)
    let c1: i64 = vcard.card_first(&d)
    let c2: i64 = vcard.card_next(&d, c1)
    check("photos two cards", c1 >= 0 && c2 >= 0 && vcard.card_next(&d, c2) < 0)
    var bytes: rt.Buf = rt.buf_new()
    var mime: rt.Buf = rt.buf_new()
    check("3.0 jpeg", vcard.media(&d, nth(&d, c1 as usize, "PHOTO", 0) as usize, &bytes, &mime) == vcard.MEDIA_BINARY && same(&mime, "image/jpeg") && rt.buf_len(&bytes) == 10)
    rt.buf_clear(&bytes)
    rt.buf_clear(&mime)
    check("3.0 logo png", vcard.media(&d, nth(&d, c1 as usize, "LOGO", 0) as usize, &bytes, &mime) == vcard.MEDIA_BINARY && same(&mime, "image/png") && same(&bytes, "\x00\x01\x02"))
    rt.buf_clear(&bytes)
    rt.buf_clear(&mime)
    check("3.0 sound keeps the type", vcard.media(&d, nth(&d, c1 as usize, "SOUND", 0) as usize, &bytes, &mime) == vcard.MEDIA_BINARY && same(&mime, "wave"))
    rt.buf_clear(&bytes)
    rt.buf_clear(&mime)
    check("3.0 uri", vcard.media(&d, nth(&d, c1 as usize, "PHOTO", 1) as usize, &bytes, &mime) == vcard.MEDIA_URI && same(&bytes, "http://x.example/a.jpg"))
    rt.buf_clear(&bytes)
    rt.buf_clear(&mime)
    check("3.0 bad base64", vcard.media(&d, nth(&d, c1 as usize, "PHOTO", 2) as usize, &bytes, &mime) == vcard.MEDIA_BAD)
    rt.buf_clear(&bytes)
    rt.buf_clear(&mime)
    check("4.0 data base64", vcard.media(&d, nth(&d, c2 as usize, "PHOTO", 0) as usize, &bytes, &mime) == vcard.MEDIA_BINARY && same(&mime, "image/png") && rt.buf_len(&bytes) == 10)
    rt.buf_clear(&bytes)
    rt.buf_clear(&mime)
    check("4.0 data percent", vcard.media(&d, nth(&d, c2 as usize, "PHOTO", 1) as usize, &bytes, &mime) == vcard.MEDIA_BINARY && same(&mime, "text/plain") && same(&bytes, "a b,c"))
    rt.buf_clear(&bytes)
    rt.buf_clear(&mime)
    check("4.0 uri + mediatype", vcard.media(&d, nth(&d, c2 as usize, "PHOTO", 2) as usize, &bytes, &mime) == vcard.MEDIA_URI && same(&mime, "image/gif"))
    rt.buf_clear(&bytes)
    rt.buf_clear(&mime)
    check("4.0 bad base64", vcard.media(&d, nth(&d, c2 as usize, "PHOTO", 3) as usize, &bytes, &mime) == vcard.MEDIA_BAD)
    rt.buf_clear(&bytes)
    rt.buf_clear(&mime)
    check("4.0 data without comma", vcard.media(&d, nth(&d, c2 as usize, "PHOTO", 4) as usize, &bytes, &mime) == vcard.MEDIA_BAD)
    rt.buf_free(&bytes)
    rt.buf_free(&mime)
    content.doc_free(&d)
}

fn values() {
    var d: content.Doc = content.doc_new()
    content.parse("BEGIN:VCARD\r\nVERSION:3.0\r\nNOTE:a\\nb\\, c\\; d\\\\e\r\nCATEGORIES:work,friends,a\\,b\r\nGEO:37.386013;-122.082932\r\nGEO:91;0\r\nGEO:x;y\r\nGEO:1.2345678;-0.0000005\r\nBDAY:1996-04-15\r\nBDAY:19960415T120000Z\r\nBDAY:--04-15\r\nBDAY:19960230\r\nBDAY:--0230\r\nBDAY:garbage\r\nBDAY:20000229\r\nEND:VCARD\r\n", &d)
    let c: i64 = vcard.card_first(&d)
    check("note escapes", text_is(&d, nth(&d, c as usize, "NOTE", 0), "a\nb, c; d\\e"))
    let cat: i64 = nth(&d, c as usize, "CATEGORIES", 0)
    check("categories count", vcard.item_count(&d, cat as usize) == 3)
    var b: rt.Buf = rt.buf_new()
    vcard.item(&d, cat as usize, 2, &b)
    check("categories escaped comma", same(&b, "a,b"))
    rt.buf_free(&b)
    var lat: i64 = 0
    var lon: i64 = 0
    check("geo 3.0", vcard.geo(&d, nth(&d, c as usize, "GEO", 0) as usize, &lat, &lon) && lat == 37386013 && lon == -122082932)
    check("geo lat out of range", !vcard.geo(&d, nth(&d, c as usize, "GEO", 1) as usize, &lat, &lon))
    check("geo junk", !vcard.geo(&d, nth(&d, c as usize, "GEO", 2) as usize, &lat, &lon))
    check("geo rounding", vcard.geo(&d, nth(&d, c as usize, "GEO", 3) as usize, &lat, &lon) && lat == 1234568 && lon == -1)
    var y: i64 = 0
    var m: i64 = 0
    var dd: i64 = 0
    check("bday dashes", vcard.bday(&d, nth(&d, c as usize, "BDAY", 0) as usize, &y, &m, &dd) && y == 1996 && m == 4 && dd == 15)
    check("bday with time", vcard.bday(&d, nth(&d, c as usize, "BDAY", 1) as usize, &y, &m, &dd) && y == 1996 && m == 4 && dd == 15)
    check("bday no year", vcard.bday(&d, nth(&d, c as usize, "BDAY", 2) as usize, &y, &m, &dd) && y == 0 && m == 4 && dd == 15)
    check("bday impossible", !vcard.bday(&d, nth(&d, c as usize, "BDAY", 3) as usize, &y, &m, &dd))
    check("bday 30 Feb no year", !vcard.bday(&d, nth(&d, c as usize, "BDAY", 4) as usize, &y, &m, &dd))
    check("bday garbage", !vcard.bday(&d, nth(&d, c as usize, "BDAY", 5) as usize, &y, &m, &dd))
    check("bday leap day", vcard.bday(&d, nth(&d, c as usize, "BDAY", 6) as usize, &y, &m, &dd) && y == 2000 && m == 2 && dd == 29)
    content.doc_free(&d)
    // no VERSION, no FN: display name from N, then ORG, then EMAIL
    var d2: content.Doc = content.doc_new()
    content.parse("BEGIN:VCARD\r\nN:Doe;Jane;Q.;Ms.;PhD\r\nEND:VCARD\r\nBEGIN:VCARD\r\nORG:Acme;Sales\r\nEND:VCARD\r\nBEGIN:VCARD\r\nEMAIL:a@b.c\r\nEND:VCARD\r\nBEGIN:VCARD\r\nEND:VCARD\r\n", &d2)
    var c2: i64 = vcard.card_first(&d2)
    check("no version is 0", vcard.version(&d2, c2 as usize) == 0)
    var nm: rt.Buf = rt.buf_new()
    vcard.display_name(&d2, c2 as usize, &nm)
    check("display from N", same(&nm, "Ms. Jane Q. Doe PhD"))
    rt.buf_clear(&nm)
    c2 = vcard.card_next(&d2, c2)
    vcard.display_name(&d2, c2 as usize, &nm)
    check("display from ORG", same(&nm, "Acme"))
    rt.buf_clear(&nm)
    c2 = vcard.card_next(&d2, c2)
    vcard.display_name(&d2, c2 as usize, &nm)
    check("display from EMAIL", same(&nm, "a@b.c"))
    rt.buf_clear(&nm)
    c2 = vcard.card_next(&d2, c2)
    vcard.display_name(&d2, c2 as usize, &nm)
    check("display empty", rt.buf_len(&nm) == 0)
    rt.buf_free(&nm)
    content.doc_free(&d2)
}

// builds one card with awkward text, writes it, parses it again and compares every piece
fn roundtrip(ver: u32) {
    let weird: str = "Stra\u{DF}e 1, Stock 2; \"Tor\" \\ rechts\nzweite Zeile \u{20AC} =x"
    var photo: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 300 {
        rt.buf_push(&photo, (i % 256) as u8)
        i = i + 1
    }
    var d: content.Doc = content.doc_new()
    vcard.begin_card(&d, ver)
    vcard.add_text(&d, ver, "FN", "Max M\u{FC}ller-Lehmann")
    vcard.add_n(&d, ver, "M\u{FC}ller-Lehmann", "Max", "J.", "Dr.", "jr.")
    vcard.add_adr(&d, ver, "", "", weird, "Wien", "", "1010", "\u{D6}sterreich")
    vcard.add_type(&d, "HOME")
    vcard.add_type(&d, "POSTAL")
    vcard.add_text(&d, ver, "TEL", "+43 1 2345")
    vcard.add_type(&d, "CELL")
    vcard.add_text(&d, ver, "NOTE", "x")
    vcard.add_geo(&d, ver, 48208176, -16373819)
    vcard.add_media(&d, ver, "PHOTO", "image/jpeg", rt.buf_ptr(&photo), rt.buf_len(&photo))
    vcard.end_card(&d)
    var out: rt.Buf = rt.buf_new()
    content.write(&d, &out)
    var d2: content.Doc = content.doc_new()
    check("rt clean", content.parse(str { p: rt.buf_data(&out), n: rt.buf_len(&out) }, &d2) == 0)
    let c: i64 = vcard.card_first(&d2)
    check("rt version", vcard.version(&d2, c as usize) == ver)
    check("rt fn", text_is(&d2, nth(&d2, c as usize, "FN", 0), "Max M\u{FC}ller-Lehmann"))
    let n: i64 = nth(&d2, c as usize, "N", 0)
    check("rt n", field_is(&d2, n, vcard.N_FAMILY, "M\u{FC}ller-Lehmann") && field_is(&d2, n, vcard.N_GIVEN, "Max") && field_is(&d2, n, vcard.N_ADDITIONAL, "J.") && field_is(&d2, n, vcard.N_PREFIX, "Dr.") && field_is(&d2, n, vcard.N_SUFFIX, "jr."))
    let a: i64 = nth(&d2, c as usize, "ADR", 0)
    check("rt adr street", field_is(&d2, a, vcard.ADR_STREET, weird))
    check("rt adr rest", field_is(&d2, a, vcard.ADR_LOCALITY, "Wien") && field_is(&d2, a, vcard.ADR_CODE, "1010") && field_is(&d2, a, vcard.ADR_COUNTRY, "\u{D6}sterreich") && field_is(&d2, a, vcard.ADR_POBOX, ""))
    check("rt adr types", vcard.has_type(&d2, a as usize, "home") && vcard.has_type(&d2, a as usize, "postal"))
    check("rt tel", text_is(&d2, nth(&d2, c as usize, "TEL", 0), "+43 1 2345") && vcard.has_type(&d2, nth(&d2, c as usize, "TEL", 0) as usize, "cell"))
    var lat: i64 = 0
    var lon: i64 = 0
    check("rt geo", vcard.geo(&d2, nth(&d2, c as usize, "GEO", 0) as usize, &lat, &lon) && lat == 48208176 && lon == -16373819)
    var bytes: rt.Buf = rt.buf_new()
    var mime: rt.Buf = rt.buf_new()
    check("rt photo kind", vcard.media(&d2, nth(&d2, c as usize, "PHOTO", 0) as usize, &bytes, &mime) == vcard.MEDIA_BINARY)
    check("rt photo mime", same(&mime, "image/jpeg"))
    check("rt photo bytes", rt.buf_len(&bytes) == rt.buf_len(&photo) && rt.mem_eq(rt.buf_ptr(&bytes), rt.buf_ptr(&photo), rt.buf_len(&photo)))
    // every written line is at most 75 octets (CRLF excluded)
    var ok: bool = true
    var run: usize = 0
    var k: usize = 0
    while k < rt.buf_len(&out) {
        let ch: u8 = rt.buf_at(&out, k)
        if ch == 13 as u8 {
            if run > 75 { ok = false }
            run = 0
        } else if ch != 10 as u8 {
            run = run + 1
        }
        k = k + 1
    }
    check("rt line length", ok)
    rt.buf_free(&bytes)
    rt.buf_free(&mime)
    rt.buf_free(&out)
    rt.buf_free(&photo)
    content.doc_free(&d)
    content.doc_free(&d2)
}

fn main() -> i32 {
    rfc6350()
    rfc2426()
    v21()
    photos()
    values()
    roundtrip(21)
    roundtrip(30)
    roundtrip(40)
    if failures == 0 {
        rt.write_everything(1, "ok\n".p as u64, 3)
        return 0
    }
    return 1
}
