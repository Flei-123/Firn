// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
// tests/2892_dns_edns_search.fi -- EDNS0 query bytes and resolv.conf
// `search` / `domain` / `options ndots:` parsing (lib/net/dns.fi D2, D3).
// The behaviour against a server is tools/dns/edns_check.py.
import std.rt
import net.dns

static mut fails: u32 = 0

fn check(ok: bool, code: u32) {
    if !ok {
        fails = fails + 1
        var d: [u8; 8] = "FAIL 000"
        d[5] = (48 + (code / 100) % 10) as u8
        d[6] = (48 + (code / 10) % 10) as u8
        d[7] = (48 + code % 10) as u8
        syscall(1, 2, (&d[0]) as i64, 8, 0, 0, 0)
    }
}

fn text_is(a: *mut [u8; 256], n: usize, want: str) -> bool {
    if n != want.n {
        return false
    }
    var i: usize = 0
    while i < n {
        if (*a)[i] != rt.ld8(want.p as u64, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn parse(text: str, out: *mut [u8; 256], nd: *mut u32) -> usize {
    return dns.dns_parse_search(text.p as u64, text.n, out, nd)
}

fn main() -> i32 {
    // the query: header ARCOUNT 1, OPT after the question
    var q: rt.Buf = rt.buf_new()
    let nm: str = "a.test"
    check(dns.dns_build_query_edns(&q, 4660 as u32, nm.p as u64, nm.n, 1 as u32, 1232 as u32), 1)
    // 12 header + (1+1+1+4+1) name + 4 = 24, then OPT 11 octets
    check(q.len == 35, 2)
    let p: u64 = rt.buf_ptr(&q)
    check(rt.ld8(p, 10) == 0 as u8 && rt.ld8(p, 11) == 1 as u8, 3) // ARCOUNT
    check(rt.ld8(p, 24) == 0 as u8, 4) // root
    check(rt.ld8(p, 25) == 0 as u8 && rt.ld8(p, 26) == 41 as u8, 5) // TYPE OPT
    check(rt.ld8(p, 27) == 4 as u8 && rt.ld8(p, 28) == 208 as u8, 6) // CLASS 1232
    check(rt.ld8(p, 29) == 0 as u8 && rt.ld8(p, 33) == 0 as u8 && rt.ld8(p, 34) == 0 as u8, 7)
    var plain: rt.Buf = rt.buf_new()
    check(dns.dns_build_query(&plain, 4660 as u32, nm.p as u64, nm.n, 1 as u32), 8)
    check(plain.len == 24 && rt.ld8(rt.buf_ptr(&plain), 11) == 0 as u8, 9)
    rt.buf_free(&q)
    rt.buf_free(&plain)

    var out: [u8; 256] = [0; 256]
    var nd: u32 = 1 as u32
    var n: usize = parse("nameserver 1.1.1.1\nsearch Corp.Example. lab.example # c\noptions timeout:2 ndots:3\n", &out, &nd)
    check(text_is(&out, n, "corp.example lab.example"), 20)
    check(nd == 3 as u32, 21)
    // the last of search/domain wins
    n = parse("search a.test b.test\ndomain c.test\n", &out, &nd)
    check(text_is(&out, n, "c.test"), 22)
    n = parse("domain c.test\nsearch a.test b.test\n", &out, &nd)
    check(text_is(&out, n, "a.test b.test"), 23)
    // ndots clamps to 15; no option leaves the value alone
    nd = 1 as u32
    n = parse("options ndots:99\n", &out, &nd)
    check(n == 0 && nd == 15 as u32, 24)
    nd = 7 as u32
    n = parse("nameserver 1.1.1.1\n", &out, &nd)
    check(n == 0 && nd == 7 as u32, 25)
    // more than six domains: the first six
    n = parse("search a b c d e f g h\n", &out, &nd)
    check(text_is(&out, n, "a b c d e f"), 26)

    // the resolver keeps them
    var res: dns.Resolver = dns.resolver_new()
    dns.resolver_set_ndots(&res, 99 as u32)
    check(res.ndots == 15 as u32, 30)
    check(dns.resolver_set_search(&res, "x.test y.test".p as u64, 13), 31)
    check(res.nsearch == 13, 32)
    check(res.edns == 1232 as u32, 33)
    dns.resolver_free(&res)
    if fails == 0 {
        return 0
    }
    return 1
}
