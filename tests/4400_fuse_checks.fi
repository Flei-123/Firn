// expect_exit: 0
// r806: `ar + i as u64 * 4` (checked cast + checked multiply by 2^k) is fused into one
// compare with a cold block. Fast path: values in range give the same result.
import std.rt

fn aget(ar: u64, i: i64) -> u32 { return *((ar + i as u64 * 4 as u64) as *mut u32) }
fn aset(ar: u64, i: i64, v: u32) { *((ar + i as u64 * 4 as u64) as *mut u32) = v }
fn fget(a: u64, i: usize) -> f64 { return *((a + (i * 8) as u64) as *mut f64) }

fn main() -> i32 {
    let p: u64 = rt.heap_alloc(64)
    var i: i64 = 0
    while i < 16 {
        aset(p, i, (i * 3) as u32)
        i = i + 1
    }
    var sum: u32 = 0
    i = 15
    while i >= 0 {
        sum = sum + aget(p, i)
        i = i - 1
    }
    if sum != 360 { return 1 }
    let q: u64 = rt.heap_alloc(32)
    var k: usize = 0
    while k < 4 {
        *((q + (k * 8) as u64) as *mut f64) = 1.5
        k = k + 1
    }
    k = 0
    var t: f64 = 0.0
    while k < 4 {
        t = t + fget(q, k)
        k = k + 1
    }
    if t != 6.0 { return 2 }
    rt.heap_free(p, 64)
    rt.heap_free(q, 32)
    return 0
}
