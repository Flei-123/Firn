// expect_exit: 0
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_input
import mc.mc_math
import mc.mc_move_fluid
import mc.mc_slide

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000000001
}

fn near2(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0005
}

fn put(ids: u64, x: i32, ly: i32, z: i32, id: u16) {
    rt.st16(ids, ((ly * 16 + z) * 16 + x) as usize, id)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

fn publish(w: *mut mc_world.World, ids: u64) {
    mc_world.world_put(w, mc_render_world.wr_make_chunk(0, 0, 2, ids))
}

fn fill(ids: u64, x0: i32, x1: i32, ly0: i32, ly1: i32, z0: i32, z1: i32, id: u16) {
    var ly: i32 = ly0
    while ly <= ly1 {
        var z: i32 = z0
        while z <= z1 {
            var x: i32 = x0
            while x <= x1 {
                put(ids, x, ly, z, id)
                x = x + 1
            }
            z = z + 1
        }
        ly = ly + 1
    }
}

fn tick(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32) {
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = keys
    mc_input.player_tick(p, &ev, w, tb, 0 - 64)
}

fn walk(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) {
    var t: i32 = 0
    while t < ticks {
        tick(p, w, tb, keys)
        t = t + 1
    }
}

const STONE: u16 = 1 as u16
const FALLING: u16 = 4 as u16
const ICE: u16 = 5 as u16
const PACKED: u16 = 6 as u16
const SLAB: u16 = 7 as u16
const FULLSHAPE: u16 = 8 as u16
const TOPSLAB: u16 = 9 as u16

fn near_eps(a: f64, b: f64, eps: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < eps
}

fn new_player(x: f64, y: f64, z: f64) -> mc_input.Player {
    var p: mc_input.Player = mc_input.player_new(x, y, z)
    rt.st8(p.mv, FALLING as usize, mc_move_fluid.fluid_kind_falling(false, 8) as u8)
    rt.st8(p.mv, ICE as usize, mc_slide.MV_ICE as u8)
    rt.st8(p.mv, PACKED as usize, mc_slide.MV_PACKED_ICE as u8)
    return p
}

fn column(ids: u64, z: i32, wall: u16) {
    fill(ids, 2, 2, 3, 8, z, z, FALLING)
    fill(ids, 3, 3, 3, 8, z, z, wall)
}

fn pulled(w: *mut mc_world.World, tb: *mut mc_input.InputTables, z: i32) -> bool {
    var p: mc_input.Player = new_player(2.5, 0.0 - 58.0, (z as f64) + 0.5)
    tick(&p, w, tb, 0 as u32)
    return p.vy < 0.0 - 0.01
}

fn main() -> i32 {
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(64), solid: rt.heap_alloc(128), n: 64 }
    var i: usize = 0
    while i < 64 {
        rt.st8(tb.pick, i, 1 as u8)
        rt.st16(tb.solid, i, 0 as u16)
        i = i + 1
    }
    rt.st16(tb.solid, STONE as usize, 1 as u16)
    rt.st16(tb.solid, ICE as usize, 1 as u16)
    rt.st16(tb.solid, PACKED as usize, 1 as u16)
    rt.st16(tb.solid, SLAB as usize, (mc_math.SHAPE_BASE + 1) as u16)
    rt.st16(tb.solid, TOPSLAB as usize, (mc_math.SHAPE_BASE + 2) as u16)
    rt.st16(tb.solid, FULLSHAPE as usize, mc_math.SHAPE_BASE as u16)

    let ids: u64 = new_ids()
    fill(ids, 0, 15, 0, 2, 0, 15, STONE)
    column(ids, 2, STONE)
    column(ids, 4, ICE)
    column(ids, 6, PACKED)
    column(ids, 8, SLAB)
    column(ids, 10, FULLSHAPE)
    column(ids, 12, TOPSLAB)
    column(ids, 14, 0 as u16)
    var w: mc_world.World = mc_world.world_new()
    publish(&w, ids)

    check(pulled(&w, &tb, 2), 1)
    check(!pulled(&w, &tb, 4), 2)
    check(pulled(&w, &tb, 6), 3)
    check(!pulled(&w, &tb, 8), 4)
    check(pulled(&w, &tb, 10), 5)
    check(!pulled(&w, &tb, 12), 6)
    check(!pulled(&w, &tb, 14), 7)
    if g_fail != 0 { return 1 }
    return 0
}
