// expect_out: array|str|both
// tests/1333_str_array_unchanged.fi -- THE COMPATIBILITY PROOF (round 70).
//
// Since round 39 a text literal is an array literal: `var t: [u8; 20] =
// "...\0"` stands about 1000 times in this source tree. Round 70 gives the
// literal the type `str` -- WITHOUT breaking a single one of those places.
//
// The rule: the CONTEXT decides. Where an array type is wanted, the literal
// is the array literal it always was; everywhere else it is a `str`. Nothing
// can break through that, because a text literal WITHOUT an array context is
// an error today ("the type of the array literal cannot be inferred").
import std.io

struct Holder { name: [u8; 4] }

fn takes_array(p: [u8; 6]) -> u8 {
    return p[0]
}

fn main() -> i32 {
    // 1. the classic form, with a null octet and a fixed length
    var t: [u8; 6] = "array\0"
    if t[5] != 0 as u8 { return 1 }
    if takes_array(t) != 97 as u8 { return 2 }
    io.print_c((&t[0]) as u64)

    // 2. a literal in an ARRAY FIELD of a struct
    let h: Holder = Holder { name: "firn" }
    if h.name[3] != 110 as u8 { return 3 }

    // 3. a literal as an argument with an array parameter
    if takes_array("array\0") != 97 as u8 { return 4 }

    // 4. a literal in an array of arrays
    var pair: [[u8; 2]; 2] = ["ab", "cd"]
    if pair[1][0] != 99 as u8 { return 5 }

    // 5. `u"..."` stays WTF-16 and stays an array
    var w: [u16; 3] = u"abc"
    if w[2] != 99 as u16 { return 6 }

    // 6. `b"..."` stays raw octets
    var r: [u8; 3] = b"xyz"
    if r[0] != 120 as u8 { return 7 }

    // 7. and the very same spelling is a `str` without an array context
    let s: str = "str"
    var bar: [u8; 1] = "|"
    io.print_bytes((&bar[0]) as u64, 1)
    io.print_str(s)
    io.print_bytes((&bar[0]) as u64, 1)

    // 8. both in one expression
    var c: [u8; 4] = "both"
    if s == "str" && c[0] == 98 as u8 {
        io.print_line_bytes((&c[0]) as u64, 4)
        return 0
    }
    return 8
}
