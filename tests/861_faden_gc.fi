// expect_exit: 0
// RUNDE 49 — DER SAMMLER UNTER MEHREREN FAEDEN.
//
// Das ist der eigentliche Punkt der Runde. Geprueft wird:
//   A  Mehrere Faeden allozieren GLEICHZEITIG aus demselben Heap, und der
//      Sammler laeuft dabei. Das Ergebnis ist DETERMINISTISCH: jeder Faden
//      liefert dieselbe Summe wie in einem Einfadenlauf.
//   B  Was ein Faden festhaelt, ueberlebt — auch wenn ein ANDERER Faden den
//      Sammellauf fuehrt. Jede Kette wird am Ende Glied fuer Glied
//      nachgerechnet; ein einziges eingesammeltes Glied faellt auf.
//   C  Was der HAUPTFADEN festhaelt, ueberlebt ebenso (sein Stapel ist der
//      einzige, den der Sammler vor Runde 49 kannte).
//   D  Die Welt wurde wirklich angehalten (gc_stw_laeufe() > 0) und es gab
//      wirklich Sammellaeufe (gc_collections() > 0). Ohne diese beiden
//      Zahlen koennte der Test bestehen, ohne je einen Sammler gesehen zu
//      haben.
//   E  Kein Faden bleibt uebrig (faden_anzahl() == 1) und der Heap bleibt
//      beschraenkt.

gc class Knoten {
    naechster: Gc[Knoten],
    wert: u64,
}

const KETTE: u64 = 400
const MUELL: u64 = 6000

// Baut eine Kette von KETTE Gliedern mit den Werten `art*1000 + i` und
// erzeugt dazwischen MUELL kurzlebige Objekte, damit der Sammler wirklich
// arbeiten muss. Liefert den Kopf der Kette.
fn kette_bauen(art: u64) -> AllocError!Gc[Knoten] {
    var kopf: Gc[Knoten] = gc_null[Knoten]()
    var i: u64 = 0
    while i < KETTE {
        let n: Gc[Knoten] = try gc Knoten{ naechster: kopf, wert: art * 1000 + i }
        kopf = n
        var m: u64 = 0
        while m < MUELL / KETTE {
            let tot: Gc[Knoten] = try gc Knoten{ naechster: gc_null[Knoten](), wert: 0 }
            if tot.wert != 0 {
                return kopf
            }
            m = m + 1
        }
        i = i + 1
    }
    return kopf
}

// Rechnet die Kette nach: Laenge, Reihenfolge und Werte. 0 = in Ordnung,
// sonst die Nummer des ersten Fehlers.
fn kette_pruefen(kopf: Gc[Knoten], art: u64) -> u64 {
    var p: Gc[Knoten] = kopf
    var i: u64 = KETTE
    while i > 0 {
        i = i - 1
        if p == gc_null[Knoten]() {
            return 1
        }
        if p.wert != art * 1000 + i {
            return 2
        }
        p = p.naechster
    }
    if p != gc_null[Knoten]() {
        return 3
    }
    return 0
}

fn arbeit(art: u64) -> AllocError!u64 {
    let kopf: Gc[Knoten] = try kette_bauen(art)
    // Erst NACH einem weiteren Sammellauf nachrechnen: die Kette haengt in
    // diesem Augenblick nur noch am Stapel DIESES Fadens.
    gc_collect()
    let rc: u64 = kette_pruefen(kopf, art)
    if rc != 0 {
        return 900 + rc
    }
    return art
}

fn __faden_arbeit(art: u64, arg: u64) -> u64 {
    let _unbenutzt: u64 = arg
    let r: AllocError!u64 = arbeit(art)
    return r catch 800
}

fn lauf() -> AllocError!i32 {
    // C: der Hauptfaden haelt seine eigene Kette waehrend des ganzen Laufs.
    let meine: Gc[Knoten] = try kette_bauen(9)

    var h: [u64; 6] = [0; 6]
    var i: u64 = 0
    while i < 6 {
        h[i as usize] = faden_starten(i + 1, 0)
        if h[i as usize] == 0 {
            return 1
        }
        i = i + 1
    }
    // Der Hauptfaden alloziert waehrenddessen selbst weiter.
    var eigen: u64 = 0
    while eigen < 4 {
        let k: Gc[Knoten] = try kette_bauen(20 + eigen)
        if kette_pruefen(k, 20 + eigen) != 0 {
            return 2
        }
        eigen = eigen + 1
    }

    var summe: u64 = 0
    i = 0
    while i < 6 {
        let r: u64 = faden_warten(h[i as usize])
        if r >= 800 {
            return 3
        }
        summe = summe + r
        i = i + 1
    }
    if summe != 21 {
        return 4
    }
    if kette_pruefen(meine, 9) != 0 {
        return 5
    }
    if gc_collections() == 0 {
        return 6
    }
    if gc_stw_laeufe() == 0 {
        return 7
    }
    if faden_anzahl() != 1 {
        return 8
    }
    if gc_heap_bytes() > 33554432 {
        return 9
    }
    return 0
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    if !faden_init() {
        return 91
    }
    return lauf() catch 92
}
