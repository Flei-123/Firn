// expect_out: io: zeilen 5 summe 21 ohne 3/123 datei 33 fmt 69 gefangen 11 abc
// tests/806_std_io_kern.fi — Zeilen, Dateien und der ausgebaute Fmt-Builder
// von `std.io` (Runde 42).
//
// Drei Teile:
//   1. Dateien: schreiben, ANHAENGEN (O_APPEND — der Unterschied zwischen
//      einem Protokoll und einem verlorenen Protokoll), gibt es sie?
//   2. Zeilen: der Kursor `Zeilenleser` ueber einen gelesenen Block —
//      \r\n wird abgeraeumt, ein abschliessendes \n erzeugt KEINE leere
//      Schlusszeile.
//   3. Fmt: Zeichen, bool, u64, Hex, C-Text, Wiederholung, Breite,
//      Verketten zweier Builder, Inhalt in einen Puffer.
//
// Die Funktionen, die selbst einen ZEILENUMBRUCH schreiben (`println`,
// `print_zeile`, `fmt_druck_zeile`), lassen sich nicht mitten in eine
// einzeilige Testausgabe stellen. Sie werden deshalb WIRKLICH ausgefuehrt,
// aber mit umgebogenem Deskriptor 1: `dup`/`dup2` schieben stdout kurz in
// eine Datei, und danach wird geprueft, was drinsteht. Kein Weglassen,
// keine Behauptung ohne Messung.
import std.io
import std.rt

const SYS_DUP: i64 = 32
const SYS_DUP2: i64 = 33
const SYS_OEFFNEN: i64 = 2
const SYS_SCHLIESSEN: i64 = 3
const O_SCHREIB: i64 = 577
const RECHTE: i64 = 493

fn main() -> i32 {
    var pfad: [u8; 24] = "/tmp/firn806_zeilen.txt\0"
    var pfad2: [u8; 24] = "/tmp/firn806_stdout.txt\0"
    var fehlt: [u8; 26] = "/tmp/firn806_gibtsnicht.x\0"
    var teil1: [u8; 21] = "eins\r\nzwei\ndrei\nvier\n"
    var teil2: [u8; 6] = "fuenf\n"

    // --- 1. Dateien
    if !io.write_file((&pfad[0]) as u64, (&teil1[0]) as u64, 21) {
        return 10
    }
    if !io.append_file((&pfad[0]) as u64, (&teil2[0]) as u64, 6) {
        return 11
    }
    if !io.file_exists((&pfad[0]) as u64) {
        return 12
    }
    if io.file_exists((&fehlt[0]) as u64) {
        return 13
    }
    var b: rt.Buf = rt.buf_neu()
    if !io.read_file((&pfad[0]) as u64, &b) {
        return 14
    }
    if rt.buf_len(&b) != 27 {
        return 15
    }
    // Zweimal anhaengen darf nicht ueberschreiben.
    if !io.append_file((&pfad[0]) as u64, (&teil2[0]) as u64, 6) {
        return 16
    }
    var b2: rt.Buf = rt.buf_neu()
    io.read_file((&pfad[0]) as u64, &b2)
    let dateilaenge: usize = rt.buf_len(&b2)
    if dateilaenge != 33 {
        return 17
    }
    rt.buf_frei(&b2)

    // --- 2. Zeilen
    var z: io.Zeilenleser = io.zeilen_von_buf(&b)
    var p: u64 = 0
    var n: usize = 0
    var zeilen: usize = 0
    var summe: usize = 0
    while io.zeilen_naechst(&z, &p, &n) {
        zeilen = zeilen + 1
        summe = summe + n
    }
    // "eins" (das \r faellt weg), "zwei", "drei", "vier", "fuenf"
    if zeilen != 5 {
        return 20
    }
    if summe != 21 {
        return 21
    }
    if io.zeilen_zahl(rt.buf_ptr(&b), rt.buf_len(&b)) != 5 {
        return 22
    }
    // Ohne abschliessenden Umbruch bleibt die letzte Zeile trotzdem eine.
    var ohne: [u8; 9] = "a\nbb\nccc\0"
    var z2: io.Zeilenleser = io.zeilen_neu((&ohne[0]) as u64, 8)
    var laengen: usize = 0
    var k: usize = 0
    while io.zeilen_naechst(&z2, &p, &n) {
        k = k + 1
        laengen = laengen * 10 + n
    }
    if k != 3 || laengen != 123 {
        return 23
    }
    if io.zeilen_zahl((&ohne[0]) as u64, 0) != 0 {
        return 24
    }
    rt.buf_frei(&b)

    // --- 3. Fmt
    var f: io.Fmt = io.fmt_neu()
    f = io.fmt_zeichen(f, 65 as u8)
    f = io.fmt_bool(f, true)
    f = io.fmt_bool(f, false)
    f = io.fmt_u64(f, 18446744073709551615)
    f = io.fmt_hex(f, 48879, 6)
    f = io.fmt_wiederhole(f, 46 as u8, 3)
    f = io.fmt_breit(f, 0 - 42, 6, 32 as u8)
    f = io.fmt_c(f, (&pfad[0]) as u64)
    let erwartet: usize = 1 + 4 + 6 + 20 + 6 + 3 + 6 + 23
    if io.fmt_len(f) != erwartet {
        return 30
    }
    var puffer: rt.Buf = rt.buf_neu()
    io.fmt_inhalt(f, &puffer)
    if rt.buf_len(&puffer) != erwartet {
        return 31
    }
    if rt.buf_at(&puffer, 0) != 65 as u8 {
        return 32
    }
    // "wahr" + "falsch"
    if rt.buf_at(&puffer, 1) != 119 as u8 || rt.buf_at(&puffer, 5) != 102 as u8 {
        return 33
    }
    // fmt_hex fuellt links mit Nullen auf: 48879 = beef -> "00beef"
    if rt.buf_at(&puffer, 31) != 48 as u8 || rt.buf_at(&puffer, 33) != 98 as u8 {
        return 34
    }
    // fmt_breit ist rechtsbuendig: drei Fuellzeichen vor "-42"
    if rt.buf_at(&puffer, 40) != 32 as u8 || rt.buf_at(&puffer, 43) != 45 as u8 {
        return 35
    }
    rt.buf_frei(&puffer)

    // Zwei Builder verketten; der zweite wird dabei freigegeben.
    var g: io.Fmt = io.fmt_anhaengen(f"a={1 + 1}", f" b={7}")
    if io.fmt_len(g) != 7 {
        return 36
    }
    var p2: rt.Buf = rt.buf_neu()
    io.fmt_inhalt(g, &p2)
    if rt.buf_at(&p2, 2) != 50 as u8 || rt.buf_at(&p2, 6) != 55 as u8 {
        return 37
    }
    rt.buf_frei(&p2)
    // In eine Datei schreiben und den Builder dabei freigeben.
    // BEFUND Runde 42 (keine Compileraenderung, nur benannt): ein `f"..."`
    // direkt in der BEDINGUNG eines `if` meldet "unbekannter name '_fsegN'" —
    // die versteckten Textsegmente werden vor die Anweisung gehoben, und die
    // Bedingung wird vor dem Rumpfblock ausgewertet. Ein Zwischenwert loest
    // es; in docs/RUNDE42.md steht der Fall.
    let inhalt: io.Fmt = f"zahl {255}"
    if !io.fmt_in_datei(inhalt, (&pfad2[0]) as u64) {
        return 38
    }
    var p3: rt.Buf = rt.buf_neu()
    io.read_file((&pfad2[0]) as u64, &p3)
    if rt.buf_len(&p3) != 8 {
        return 39
    }
    rt.buf_frei(&p3)

    // --- die Zeilenschreiber, mit umgebogenem Deskriptor 1
    var abc: [u8; 3] = "abc"
    var cd: [u8; 3] = "cd\0"
    let gesichert: i64 = syscall(SYS_DUP, 1, 0, 0, 0, 0, 0)
    if gesichert < 0 {
        return 40
    }
    let fd: i64 = syscall(SYS_OEFFNEN, (&pfad2[0]) as i64, O_SCHREIB, RECHTE, 0, 0, 0)
    if fd < 0 {
        return 41
    }
    syscall(SYS_DUP2, fd, 1, 0, 0, 0, 0)
    io.println((&abc[0]) as u64, 3)
    io.print_zeile()
    io.fmt_druck_zeile(f"x={7}")
    io.print_c((&cd[0]) as u64)
    syscall(SYS_DUP2, gesichert, 1, 0, 0, 0, 0)
    syscall(SYS_SCHLIESSEN, fd, 0, 0, 0, 0, 0)
    syscall(SYS_SCHLIESSEN, gesichert, 0, 0, 0, 0, 0)

    var gefangen: rt.Buf = rt.buf_neu()
    if !io.read_file((&pfad2[0]) as u64, &gefangen) {
        return 42
    }
    // "abc\n" + "\n" + "x=7\n" + "cd"
    if rt.buf_len(&gefangen) != 11 {
        return 43
    }
    if rt.buf_at(&gefangen, 3) != 10 as u8 || rt.buf_at(&gefangen, 4) != 10 as u8 {
        return 44
    }
    if rt.buf_at(&gefangen, 7) != 55 as u8 || rt.buf_at(&gefangen, 8) != 10 as u8 {
        return 45
    }
    if rt.buf_at(&gefangen, 10) != 100 as u8 {
        return 46
    }
    let gefangen_len: usize = rt.buf_len(&gefangen)
    rt.buf_frei(&gefangen)

    // stderr-Wege einmal anfassen (nicht Teil der verglichenen Ausgabe).
    io.eprintln((&abc[0]) as u64, 3)
    io.eprint_c((&cd[0]) as u64)
    io.fmt_eprint(f"e{1}")
    io.fmt_eprint_zeile(f"e{2}")
    io.print_fd(2, (&abc[0]) as u64, 3)

    io.fmt_druck(f"io: zeilen {zeilen} summe {summe} ohne {k}/{laengen} ")
    io.fmt_druck(f"datei {dateilaenge} fmt {erwartet} gefangen {gefangen_len} ")
    io.println((&abc[0]) as u64, 3)
    return 0
}
