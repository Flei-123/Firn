// expect_exit: 0
// wasm_skip: files and directories
// tls.trust.trust_load_dir: an Android style directory store (one PEM per root,
// like /system/etc/security/cacerts). Two roots in two files + noise (a text file,
// an empty file, a sub directory) -> exactly 2 roots; a missing directory -> 0.
import std.rt
import std.fs
import std.fsx
import tls.trust
import tls.x509

const ROOTS: str = __include_str("../lib/appkit/roots.pem")

fn fail(code: i32, tmp: *mut fsx.TempDir) -> i32 {
    fsx.temp_dir_drop(tmp)
    return code
}

fn main() -> i32 {
    // split roots.pem after its first END line
    let mark: str = "-----END CERTIFICATE-----\n"
    var cut: usize = 0
    var i: usize = 0
    while i + mark.n <= ROOTS.n && cut == 0 {
        var same: bool = true
        var k: usize = 0
        while k < mark.n && same {
            if ROOTS.chars(i + k) != mark.chars(k) { same = false }
            k = k + 1
        }
        if same { cut = i + mark.n }
        i = i + 1
    }
    if cut == 0 || cut >= ROOTS.n { return 1 as i32 }
    var tmp: fsx.TempDir = fsx.temp_dir("trustdir") catch fsx.TempDir { path: rt.buf_new(), armed: false }
    if !tmp.armed { return 2 as i32 }
    let base: str = fsx.temp_dir_path(&tmp)
    let f1: str = base + "/aaaaaaaa.0"
    let f2: str = base + "/bbbbbbbb.0"
    let f3: str = base + "/README"
    let f4: str = base + "/empty.0"
    let sub: str = base + "/sub"
    let w1: usize = fs.write_file(f1, ROOTS.p as u64, cut) catch 999999
    if w1 == 999999 { return fail(3 as i32, &tmp) }
    let w2: usize = fs.write_file(f2, (ROOTS.p as u64) + (cut as u64), ROOTS.n - cut) catch 999999
    if w2 == 999999 { return fail(4 as i32, &tmp) }
    let junk: str = "this is not a certificate\n"
    let w3: usize = fs.write_file(f3, junk.p as u64, junk.n) catch 999999
    if w3 == 999999 { return fail(5 as i32, &tmp) }
    let w4: usize = fs.write_file(f4, junk.p as u64, 0) catch 999999
    if w4 == 999999 { return fail(6 as i32, &tmp) }
    let m: bool = fs.mkdir(sub) catch false
    if !m { return fail(7 as i32, &tmp) }

    var st: x509.Store = x509.store_new()
    let got: usize = trust.trust_load_dir(&st, base)
    if got != 2 { return fail(10 as i32, &tmp) }
    if x509.store_count(&st) != 2 { return fail(11 as i32, &tmp) }
    // a missing directory and a plain file give 0 and no crash
    var s2: x509.Store = x509.store_new()
    if trust.trust_load_dir(&s2, base + "/nope") != 0 { return fail(12 as i32, &tmp) }
    if trust.trust_load_dir(&s2, f3) != 0 { return fail(13 as i32, &tmp) }
    if trust.trust_load_dir(&s2, sub) != 0 { return fail(14 as i32, &tmp) }
    if x509.store_count(&s2) != 0 { return fail(15 as i32, &tmp) }
    x509.store_free(&st)
    x509.store_free(&s2)
    fsx.temp_dir_drop(&tmp)
    return 0
}
