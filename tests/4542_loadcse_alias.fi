// expect_exit: 0
// Load CSE / store-to-load forwarding must respect aliasing: a store through
// a pointer that may equal another pointer invalidates earlier loads; stores
// to distinct locals / globals / disjoint offsets must not.
static mut GA: i64 = 5
static mut GB: i64 = 7

fn two_ptrs(p: *mut i64, q: *mut i64) -> i64 {
    let a: i64 = *p
    *q = 100
    let b: i64 = *p
    return a * 1000 + b
}

fn same_ptr_twice(p: *mut i64) -> i64 {
    *p = 1
    let a: i64 = *p
    *p = 2
    let b: i64 = *p
    return a * 10 + b
}

fn disjoint_offsets(p: *mut i32) -> i32 {
    let q: *mut i32 = (p as usize + 4) as *mut i32
    *p = 11
    *q = 22
    let a: i32 = *p
    let b: i32 = *q
    return a * 100 + b
}

fn overlap_store(p: *mut u64) -> u64 {
    *p = 0x1122334455667788
    let lo: *mut u8 = p as *mut u8
    *lo = 0xFF
    return *p
}

fn globals() -> i64 {
    GA = 1
    let a: i64 = GA
    GB = 2
    let b: i64 = GA
    return a * 10 + b + GB * 100
}

fn global_via_ptr(p: *mut i64) -> i64 {
    GA = 3
    let a: i64 = GA
    *p = 9
    let b: i64 = GA
    return a * 10 + b
}

fn local_and_ptr(p: *mut i64) -> i64 {
    var buf: [i64; 4] = [1, 2, 3, 4]
    let iv: i64 = *p
    let i: usize = iv as usize
    let a: i64 = buf[i]
    *p = 50
    let b: i64 = buf[i]
    buf[i] = 77
    let c: i64 = buf[i]
    return a * 10000 + b * 100 + c
}

fn after_call(p: *mut i64) -> i64 {
    let a: i64 = *p
    bump(p)
    let b: i64 = *p
    return a * 100 + b
}

fn bump(p: *mut i64) {
    *p = *p + 1
}

fn main() -> i32 {
    var bad: i32 = 0
    var x: i64 = 3
    // aliasing pair: p == q
    if two_ptrs(&x, &x) != 3 * 1000 + 100 {
        bad = bad + 1
    }
    var y: i64 = 4
    if two_ptrs(&x, &y) != 100 * 1000 + 100 {
        // x is 100 now
        bad = bad + 1
    }
    if same_ptr_twice(&x) != 12 {
        bad = bad + 1
    }
    var pair: [i32; 2] = [0, 0]
    if disjoint_offsets(&pair[0]) != 1122 {
        bad = bad + 1
    }
    var w: u64 = 0
    if overlap_store(&w) != 0x11223344556677FF {
        bad = bad + 1
    }
    if globals() != 1 * 10 + 1 + 200 {
        bad = bad + 1
    }
    if global_via_ptr(&GA) != 3 * 10 + 9 {
        bad = bad + 1
    }
    var z: i64 = 2
    if local_and_ptr(&z) != 3 * 10000 + 3 * 100 + 77 {
        bad = bad + 1
    }
    var k: i64 = 5
    if after_call(&k) != 5 * 100 + 6 {
        bad = bad + 1
    }
    return bad
}
