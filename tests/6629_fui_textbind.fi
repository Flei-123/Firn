// expect_exit: 0
import std.rt
import fui.textbind

fn check(c: bool, code: i64) {
    if !c {
        rt.finish(code)
    }
}

fn main() -> i32 {
    var buf: [u8; 16] = [0; 16]
    var cur: usize = 0
    var anc: usize = 0
    let hello: str = "hello"
    textbind.bind(1, hello.p as u64, hello.n, hello.n, hello.n, false, false)
    check(textbind.text_len() == 5, 1)
    check(textbind.caret() == 5, 2)
    let bang: str = "!"
    check(textbind.insert(bang.p as u64, bang.n, 16), 3)
    check(textbind.text_len() == 6, 4)
    let left: str = "ArrowLeft"
    let r: u32 = textbind.key(left.p as u64, left.n, false, false, false, 16)
    check(r != 0 as u32, 5)
    check(textbind.caret() == 5, 6)
    let n: usize = textbind.out((&buf[0]) as u64, 16, &cur, &anc)
    check(n == 6, 7)
    check(cur == 5 && anc == 5, 8)
    let host: str = "ab\ncd"
    let kept: usize = textbind.replace(host.p as u64, host.n, 2, 0, 16)
    check(kept == 2, 9)
    check(textbind.text_len() == 2 && textbind.caret() == 2 && textbind.anchor() == 0, 10)
    let long: str = "abcdefgh"
    let cut: usize = textbind.replace(long.p as u64, long.n, 8, 8, 4)
    check(cut == 4 && textbind.text_len() == 4, 11)
    let nl: str = "x\ny"
    check(textbind.insert(nl.p as u64, nl.n, 16), 12)
    check(textbind.text_len() == 6, 13)
    textbind.release()
    return 0
}
