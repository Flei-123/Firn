// expect_exit: 0
// BUILD-UP PHASE WITHOUT STOP-THE-WORLD -- the test for round 44.
//
// Up to round 43 the collector ran ATOMICALLY below 8 MiB of heap. While
// building up a large live set that measured three full stop-the-world runs
// with up to 11.8 ms (docs/ROUND44.md). Since round 44 the cycle runs in
// slices from the very first run on.
//
// The check is deterministic (NO time comparison -- that would be shaky on
// a loaded machine):
//   * while building up beyond the old threshold NO full stop-the-world
//     cycle runs any more (gc_full_runs() == 0),
//   * something was collected at all (otherwise the test checks nothing),
//   * the heap stays close to the live set -- that catches the regression
//     where the sliced sweep uses fresh chunks again instead of the free
//     lists (round 44: that doubled the heap),
//   * the chain is COMPLETE afterwards and in the right order:
//     the incremental cycle must not collect anything live.

const N: u64 = 200000

gc class Node {
    next: Gc[Node],
    value: u64,
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}

fn run() -> AllocError!i32 {
    var header: Gc[Node] = gc_null[Node]()
    var i: u64 = 0
    while i < N {
        let k: Gc[Node] = try gc Node { next: header, value: i }
        header = k
        i = i + 1
    }
    // The heap has to have grown beyond the old switching threshold (8 MiB),
    // otherwise the test says nothing about the build-up phase.
    if gc_heap_bytes() < 8388608 {
        return 1
    }
    if gc_collections() == 0 {
        return 2
    }
    // The core of round 44.
    if gc_full_runs() != 0 {
        return 3
    }
    // Heap close to the live set (measured 1.2x; 2.5x is the generous
    // limit, the old bug was above twice as much).
    let live: u64 = gc_live_bytes()
    if live == 0 {
        return 4
    }
    if gc_heap_bytes() / 1024 > live / 1024 * 5 / 2 {
        return 5
    }
    // Nothing live may have been lost.
    var n: u64 = 0
    var p: Gc[Node] = header
    while p != gc_null[Node]() {
        if p.value != N - 1 - n {
            return 6
        }
        p = p.next
        n = n + 1
    }
    if n != N {
        return 7
    }
    return 0
}
