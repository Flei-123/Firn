// expect_exit: 0
import fui.chipflow
import std.rt

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn main() -> i32 {
    var f: chipflow.Flow = chipflow.flow_new(10.0, 200.0, 6.0, 34.0, 3)
    var pos: [f64; 2] = [0.0; 2]
    check("first row 0", chipflow.flow_place(&f, 80.0, &pos) == 0)
    check("first x", pos[0] == 10.0 && pos[1] == 0.0)
    check("second same row", chipflow.flow_place(&f, 80.0, &pos) == 0)
    check("second x", pos[0] == 96.0)
    check("third wraps", chipflow.flow_place(&f, 80.0, &pos) == 1)
    check("third at left and row y", pos[0] == 10.0 && pos[1] == 34.0)
    check("rows 2", chipflow.flow_rows(&f) == 2)
    check("height 68", chipflow.flow_height(&f) == 68.0)
    chipflow.flow_place(&f, 150.0, &pos)
    check("wide wraps", chipflow.flow_rows(&f) == 3)
    chipflow.flow_place(&f, 150.0, &pos)
    check("row cap holds", chipflow.flow_rows(&f) == 3)
    var g: chipflow.Flow = chipflow.flow_new(10.0, 50.0, 6.0, 30.0, 4)
    chipflow.flow_place(&g, 300.0, &pos)
    check("oversize first stays", pos[0] == 10.0 && chipflow.flow_rows(&g) == 1)
    check("zone left", chipflow.zone_left(10.0, 100.0, 24.0) == 86.0)
    check("zone hit inside", chipflow.zone_hit(100.0, 20.0, 10.0, 10.0, 100.0, 30.0, 24.0))
    check("zone miss body", !chipflow.zone_hit(50.0, 20.0, 10.0, 10.0, 100.0, 30.0, 24.0))
    check("zone miss below", !chipflow.zone_hit(100.0, 60.0, 10.0, 10.0, 100.0, 30.0, 24.0))
    if failures > 0 {
        return 1
    }
    return 0
}
