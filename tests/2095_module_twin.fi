// expect_exit: 0
// The same file under two spellings is ONE module (r203).
//
// `twin/b/twin.fi` is a symlink to `twin/a/twin.fi`. This program imports the
// module directly (`twin.a.twin`) and again through `twin/mid.fi`, which
// imports it by the symlink. firnc0 takes the file once; firnc1 used to load
// it twice and the assembler stopped at `symbol already defined`.
import twin.a.twin
import twin.mid

fn main() -> i32 {
    // bump(40) = 41, twice(0) = 2 -> 43 - 43 = 0
    let r: i64 = twin.bump(40) + mid.twice(0)
    if r != 43 {
        return 1
    }
    return 0
}
