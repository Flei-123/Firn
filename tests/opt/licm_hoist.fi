// expect_exit: 42
// LICM (compiler/src/licm.rs): `breite * zeile` haengt von keiner
// Schleifenvariablen ab und muss VOR die Schleife wandern. Ohne diesen
// Durchgang stand die Multiplikation in jeder Iteration im Rumpf — bei
// `bench/firn/matmul.fi` 240 Mal je Zeile.
//
// Nachweis in test_opt.sh Abschnitt (f): im Schleifenblock des FIR darf kein
// `mul.u64` mehr stehen, im Vorkopf muss eines stehen.

fn sum(field: *mut u8, width: u64, line: u64, n: u64) -> u64 {
    var s: u64 = 0
    var i: u64 = 0
    while i < n {
        // `breite * zeile` ist schleifeninvariant, `+ i` nicht.
        let offset: u64 = width * line + i
        let p: *mut u8 = (field as u64 + offset) as *mut u8
        s = s + (*p) as u64
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    var buffer: [u8; 32] = [0; 32]
    var i: usize = 0
    while i < 32 {
        buffer[i] = (i + 1) as u8
        i = i + 1
    }
    // Zeile 1 bei Breite 8 -> Bytes 8..11 = 9 + 10 + 11 + 12 = 42
    let s: u64 = sum(&buffer[0], 8, 1, 4)
    return s as i32
}
