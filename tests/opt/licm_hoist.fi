// expect_exit: 42
// LICM (compiler/src/licm.rs): `width * line` depends on no
// loop variable and has to move IN FRONT OF the loop. Without this
// pass the multiplication stood in the body in every iteration -- with
// `bench/firn/matmul.fi` 240 times per row.
//
// Proof in test_opt.sh section (f): in the loop block of the FIR there must
// be no `mul.u64` any more, in the preheader there has to be one.

fn sum(field: *mut u8, width: u64, line: u64, n: u64) -> u64 {
    var s: u64 = 0
    var i: u64 = 0
    while i < n {
        // `width * line` is loop invariant, `+ i` is not.
        let offset: u64 = width * line + i
        let p: *mut u8 = (field as u64 + offset) as *mut u8
        s = s + (*p) as u64
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    var buffer: [u8; 32] = [0; 32]
    var i: usize = 0
    while i < 32 {
        buffer[i] = (i + 1) as u8
        i = i + 1
    }
    // Row 1 at width 8 -> bytes 8..11 = 9 + 10 + 11 + 12 = 42
    let s: u64 = sum(&buffer[0], 8, 1, 4)
    return s as i32
}
