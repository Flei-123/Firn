// expect_exit: 12
// Bereichspruefung: dieselbe Bedingung wird zweimal geprueft. Die zweite
// Pruefung ist beweisbar wahr und faellt weg (nur noch EIN brcond).
fn wert(i: i32, n: i32) -> i32 {
    if n < 0 {
        return wert(0, 0)
    }
    if i < n {
        if i < n {
            return i + 10
        }
        return 0
    }
    return 1
}
fn main() -> i32 {
    return wert(2, 5)
}
