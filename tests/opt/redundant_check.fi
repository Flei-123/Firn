// expect_exit: 12
// Range check: the same condition is checked twice. The second
// check is provably true and falls away (only ONE brcond left).
fn value(i: i32, n: i32) -> i32 {
    if n < 0 {
        return value(0, 0)
    }
    if i < n {
        if i < n {
            return i + 10
        }
        return 0
    }
    return 1
}
fn main() -> i32 {
    return value(2, 5)
}
