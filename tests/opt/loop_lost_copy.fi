// expect_exit: 0
// r178, the lost copy: `prev = x; x = next(x)` in a loop whose `x = ...`
// is itself a join (the `if` inside the body). Phi coalescing merged the
// join into `x`, so the back edge overwrote `x` before `prev` copied it:
// `prev` read the NEW `x`, and a linked list was unlinked at the wrong
// node (OpenPlan pmodel/doc.fi, release builds only).
import std.vec

struct D {
    first: Vec[u32],
    last: Vec[u32],
    next: Vec[u32],
}

fn nxt(d: *mut D, v: u32) -> u32 { return vec_at[u32](&(*d).next, v as usize) }

fn unlink(d: *mut D, parent: u32, c: u32) -> bool {
    var prev: u32 = 9
    var x: u32 = vec_at[u32](&(*d).first, parent as usize)
    while x != 9 {
        if x == c {
            let nx: u32 = nxt(d, x)
            if prev == 9 {
                vec_set[u32](&(*d).first, parent as usize, nx)
            } else {
                vec_set[u32](&(*d).next, prev as usize, nx)
            }
            if vec_at[u32](&(*d).last, parent as usize) == c { vec_set[u32](&(*d).last, parent as usize, prev) }
            vec_set[u32](&(*d).next, c as usize, 9)
            return true
        }
        prev = x
        x = nxt(d, x)
    }
    return false
}

fn main() -> i32 {
    // node 0 = parent with children 1 -> 2 -> 3
    var d: D = D { first: vec_new[u32](), last: vec_new[u32](), next: vec_new[u32]() }
    var i: u32 = 0
    while i < 4 {
        vec_push[u32](&d.first, 9)
        vec_push[u32](&d.last, 9)
        vec_push[u32](&d.next, 9)
        i = i + 1
    }
    vec_set[u32](&d.first, 0, 1)
    vec_set[u32](&d.last, 0, 3)
    vec_set[u32](&d.next, 1, 2)
    vec_set[u32](&d.next, 2, 3)
    if !unlink(&d, 0, 2) { return 1 }
    if vec_at[u32](&d.first, 0) != 1 { return 2 }
    if vec_at[u32](&d.next, 1) != 3 { return 3 }
    if vec_at[u32](&d.next, 2) != 9 { return 4 }
    return 0
}
