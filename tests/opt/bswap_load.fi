// expect_exit: 0
fn ld8(p: usize, i: usize) -> u8 {
    let q: *mut u8 = (p + i) as *mut u8
    return *q
}

fn st8(p: usize, i: usize, v: u8) {
    let q: *mut u8 = (p + i) as *mut u8
    *q = v
}

fn be32(p: usize, o: usize) -> u32 {
    return ((ld8(p, o) as u32) << 24) | ((ld8(p, o + 1) as u32) << 16) | ((ld8(p, o + 2) as u32) << 8) | (ld8(p, o + 3) as u32)
}

fn le32(p: usize, o: usize) -> u32 {
    return (ld8(p, o) as u32) | ((ld8(p, o + 1) as u32) << 8) | ((ld8(p, o + 2) as u32) << 16) | ((ld8(p, o + 3) as u32) << 24)
}

fn mixed32(p: usize, o: usize) -> u32 {
    return ((ld8(p, o) as u32) << 24) | ((ld8(p, o + 2) as u32) << 16) | ((ld8(p, o + 1) as u32) << 8) | (ld8(p, o + 3) as u32)
}

fn store_between(p: usize, o: usize) -> u32 {
    let a: u32 = (ld8(p, o) as u32) << 24
    let b: u32 = (ld8(p, o + 1) as u32) << 16
    st8(p, o + 3, 0x77)
    let c: u32 = (ld8(p, o + 2) as u32) << 8
    let d: u32 = ld8(p, o + 3) as u32
    return a | b | c | d
}

fn main() -> i32 {
    let buf: usize = syscall(9, 0, 4096, 3, 34, -1, 0) as usize
    var i: usize = 0
    while i < 64 {
        st8(buf, i, ((i * 37 + 11) & 255) as u8)
        i = i + 1
    }
    var o: usize = 0
    while o < 40 {
        let b0: u32 = ld8(buf, o) as u32
        let b1: u32 = ld8(buf, o + 1) as u32
        let b2: u32 = ld8(buf, o + 2) as u32
        let b3: u32 = ld8(buf, o + 3) as u32
        if be32(buf, o) != ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) {
            return 1
        }
        if le32(buf, o) != ((b3 << 24) | (b2 << 16) | (b1 << 8) | b0) {
            return 2
        }
        if mixed32(buf, o) != ((b0 << 24) | (b2 << 16) | (b1 << 8) | b3) {
            return 3
        }
        o = o + 1
    }
    let before: u32 = (ld8(buf, 5) as u32) << 24 | ((ld8(buf, 6) as u32) << 16) | ((ld8(buf, 7) as u32) << 8)
    let got: u32 = store_between(buf, 5)
    if got != (before | 0x77) {
        return 4
    }
    return 0
}
