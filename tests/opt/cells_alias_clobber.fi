// expect_exit: 0
// Zellen-Alias (Runde 40) DARF NICHT gelten, wenn zwischen dem Load und der
// Verwendung ein anderer Wert in dasselbe Zellenregister geschrieben wird.
//
// Fehlerbild (Runde 41, echt gefunden in bin/print.fi/drucke_binop): nach der
// Schleife stand `43 - start` im Code. Der Verteiler gab der Adresse
// `&tab[start]` genau das Register, in dem die Zelle `start` liegt (`lea r12,
// [rbp+r12-...]`), der Alias las danach die ADRESSE statt des Zaehlers — die
// Laenge lief unter Null. In .astdump drehte sich buf_wachse deshalb bei
// JEDEM `||` ewig; test.sh hing in Abschnitt 12.
//
// EHRLICH: dieser Test hat den Fehler NICHT selbst gefunden und loest ihn in
// dieser Groesse auch nicht aus — ob das Zellenregister ueberschrieben wird,
// haengt vom Registerdruck des ganzen Moduls ab. Zuverlaessiger Waechter ist
// Abschnitt 12 von test.sh (Parservergleich ueber das ganze Korpus, `.astdump`
// gegen firnc0). Das Muster steht hier trotzdem als lesbare Beschreibung.
fn take(b: *mut u64, p: u64, n: usize) {
    if p != 0 {
        *b = n as u64
    }
}

fn binop(b: *mut u64, op: u32) -> usize {
    var tab: [u8; 43] = "+~-~*~/~%~&~|~^~<<~>>~==~!=~<~<=~>~>=~&&~||"
    var i: usize = 0
    var nr: u32 = 0
    var start: usize = 0
    while i < 43 {
        if tab[i] == 126 as u8 {
            if nr == op {
                take(b, (&tab[start]) as u64, i - start)
                return (*b) as usize
            }
            nr = nr + 1
            start = i + 1
        }
        i = i + 1
    }
    if nr == op {
        take(b, (&tab[start]) as u64, 43 - start)
        return (*b) as usize
    }
    return 0
}

fn main() -> i32 {
    // Laengen der 18 Operatortexte, der letzte (`||`) ueber den Pfad NACH
    // der Schleife — genau der miscompilierte.
    var z: u64 = 0
    var o: u32 = 0
    while o < 18 {
        let l: usize = binop(&z, o)
        if l == 0 || l > 2 {
            return 1
        }
        o = o + 1
    }
    if binop(&z, 17) != 2 {
        return 2
    }
    return 0
}
