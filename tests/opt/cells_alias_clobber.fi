// expect_exit: 0
// The cell alias (round 40) MUST NOT hold when another value is written
// into the same cell register between the load and the use.
//
// Symptom (round 41, really found in bin/print.fi/print_binop): after the
// loop `43 - start` stood in the code. The allocator gave the address
// `&tab[start]` exactly the register the cell `start` lies in (`lea r12,
// [rbp+r12-...]`), after that the alias read the ADDRESS instead of the
// counter -- the length ran below zero. In .astdump buf_grow therefore
// spun forever at EVERY `||`; test.sh hung in section 12.
//
// HONEST: this test did NOT find the bug itself and does not trigger it at
// this size either -- whether the cell register is overwritten
// depends on the register pressure of the whole module. The reliable guard is
// section 12 of test.sh (parser comparison over the whole corpus, `.astdump`
// against firnc0). The pattern stands here all the same as a readable description.
fn take(b: *mut u64, p: u64, n: usize) {
    if p != 0 {
        *b = n as u64
    }
}

fn binop(b: *mut u64, op: u32) -> usize {
    var tab: [u8; 43] = "+~-~*~/~%~&~|~^~<<~>>~==~!=~<~<=~>~>=~&&~||"
    var i: usize = 0
    var nr: u32 = 0
    var start: usize = 0
    while i < 43 {
        if tab[i] == 126 as u8 {
            if nr == op {
                take(b, (&tab[start]) as u64, i - start)
                return (*b) as usize
            }
            nr = nr + 1
            start = i + 1
        }
        i = i + 1
    }
    if nr == op {
        take(b, (&tab[start]) as u64, 43 - start)
        return (*b) as usize
    }
    return 0
}

fn main() -> i32 {
    // Lengths of the 18 operator texts, the last one (`||`) over the path AFTER
    // the loop -- exactly the miscompiled one.
    var z: u64 = 0
    var o: u32 = 0
    while o < 18 {
        let l: usize = binop(&z, o)
        if l == 0 || l > 2 {
            return 1
        }
        o = o + 1
    }
    if binop(&z, 17) != 2 {
        return 2
    }
    return 0
}
