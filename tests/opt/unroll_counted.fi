// expect_exit: 45
// opt (round TEMPO 14): a loop with a trip count known at compile time is
// unrolled completely -- after the optimizer there is no phi (no counter)
// and no compare on `k` left; the branches on `k == 0` fold away.
fn main(start: u64) -> i32 {
    var s: i32 = 1
    if start == 7777777 {
        s = 2
    }
    var k: i32 = 0
    while k < 4 {
        if k == 0 {
            s = s * 3
        } else {
            s = s + k * 2
        }
        k = k + 1
    }
    return s + 30
}
