// expect_exit: 5
// Common subexpressions: (n * n) stands twice in the loop body and
// may only be computed ONCE. The self call prevents inlining so that
// the proof can be led on the body itself.
fn loop_fn(n: i32) -> i32 {
    if n <= 0 {
        return 0
    }
    var s: i32 = 0
    var i: i32 = 0
    while i < n {
        s = s + (n * n) - (n * n) + 1
        i = i + 1
    }
    return s + loop_fn(0)
}
fn main() -> i32 {
    return loop_fn(5)
}
