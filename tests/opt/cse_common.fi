// expect_exit: 5
// Gemeinsame Teilausdruecke: (n * n) steht zweimal im Schleifenrumpf und
// darf nur EINMAL berechnet werden. Der Selbstaufruf verhindert Inlining,
// damit der Nachweis am Rumpf selbst gefuehrt werden kann.
fn loop_fn(n: i32) -> i32 {
    if n <= 0 {
        return 0
    }
    var s: i32 = 0
    var i: i32 = 0
    while i < n {
        s = s + (n * n) - (n * n) + 1
        i = i + 1
    }
    return s + loop_fn(0)
}
fn main() -> i32 {
    return loop_fn(5)
}
