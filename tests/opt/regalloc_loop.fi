// expect_exit: 55
// Registerzuteilung: Zaehler und Summe muessen im Schleifenrumpf in
// Registern liegen — kein einziger Stackzugriff im heissen Block.
fn sum(n: i32) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    while i <= n {
        s = s + i
        i = i + 1
    }
    return s
}
fn main() -> i32 {
    return sum(10)
}
