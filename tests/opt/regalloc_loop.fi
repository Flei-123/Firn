// expect_exit: 55
// Register allocation: counter and sum have to lie in registers in the loop
// body -- not a single stack access in the hot block.
fn sum(n: i32) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    while i <= n {
        s = s + i
        i = i + 1
    }
    return s
}
fn main() -> i32 {
    return sum(10)
}
