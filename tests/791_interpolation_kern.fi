// expect_out: x = 41, y = 42 | leer | rechnung: 83 | mehrere: 1 2 3 | typen: -5 7 200 1 | schachtel: f(9) = 81 | grenze: -9223372036854775807 | helfer sagt 7
// tests/791_interpolation_kern.fi — die String-Interpolation (Runde 39).
//
// `f"..."` wird ZUR UEBERSETZUNGSZEIT in eine Aufrufkette auf den
// Fmt-Builder aus `std.io` zerlegt — keine Varargs, kein Laufzeit-Parsen:
//
//   f"x = {x}"  ==>  io.fmt_text(io.fmt_zahl(io.fmt_text(io.fmt_neu(),
//                                &_fseg0[0], 4), (x) as i64), ...)
//
// Geprueft: mehrere Segmente und Ausdruecke, ein leerer Rumpfteil,
// Ausdruecke mit Operatoren und Aufrufen, die Skalare i32/u64/u8/bool
// (Anzeige ist die von i64 — die ehrlich dokumentierte Grenze der
// Kernfassung), i64::MIN+1, und eine Interpolation in einem IMPORTIERTEN
// Modul (tests/modules/fhelfer.fi).
import std.io
import modules.fhelfer

fn quadrat(a: i32) -> i32 {
    return a * a
}

fn main() -> i32 {
    let x: i32 = 41
    let y: i32 = x + 1
    io.fmt_druck(f"x = {x}, y = {y} | leer | rechnung: {x * 2 + 1} | ")
    let a: i32 = 1
    let b: i32 = 2
    let c: i32 = 3
    io.fmt_druck(f"mehrere: {a} {b} {c} | ")
    let neg: i32 = 0 - 5
    let gross: u64 = 7
    let klein: u8 = 200
    let w: bool = true
    io.fmt_druck(f"typen: {neg} {gross} {klein} {w} | ")
    io.fmt_druck(f"schachtel: f(9) = {quadrat(9)} | ")
    let grenze: i64 = 0 - 9223372036854775807
    io.fmt_druck(f"grenze: {grenze} | ")
    io.fmt_druck(fhelfer.meldung(7))
    return 0
}
