// expect_out: ok
// r144 -- full unrolling of counted loops that have a SECOND way out
// (unroll.rs, `fix_side_exits`). The shape is `while s < 4 && !done`: the
// header leaves after the known number of passes, a block in the body leaves
// early. Behind the loop every value that was a header phi exists in several
// versions (one per exit edge), and a value computed in the body can flow
// into a phi of the exit block.
//
//   * count1_like   -- the MP3 count1 loop: two exits, five live-out values,
//                      inside an outer loop,
//   * break_value   -- a body value (`v`) leaves through a phi,
//   * two_exits     -- two different `break`s, each with its own tag,
//   * nested_exit   -- an inner `&&` loop inside a counted outer loop.
//
// The inputs come from `start`, so nothing is known in advance.
import std.io

fn check(got: i64, want: i64, what: str) -> bool {
    if got != want {
        io.print("WRONG ")
        io.print(what)
        io.new_line()
        return false
    }
    return true
}

fn count1_like(x: i64) -> i64 {
    var np: i64 = x % 3 + 1
    var done: bool = false
    var acc: i64 = 0
    var group: i64 = 0
    while !done {
        var s: i64 = 0
        while s < 4 && !done {
            if s == 0 || s == 2 {
                np = np - 1
                if np == 0 {
                    done = true
                }
            }
            if !done {
                acc = acc * 7 + s + group
                s = s + 1
            }
        }
        group = group + s
        if group > 11 {
            done = true
        }
    }
    return acc * 100 + group * 10 + np
}

fn break_value(x: i64) -> i64 {
    var last: i64 = 0 - 1
    var i: i64 = 0
    while i < 6 {
        let v: i64 = i * x + 3
        if v > 20 {
            last = v
            break
        }
        i = i + 1
    }
    return last * 100 + i
}

fn two_exits(x: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    var tag: i64 = 0
    while i < 7 {
        if s > x * 4 {
            tag = 1
            break
        }
        s = s + i * 3
        if s == x * 5 {
            tag = 2
            break
        }
        i = i + 1
    }
    return s * 100 + i * 10 + tag
}

fn nested_exit(x: i64) -> i64 {
    var total: i64 = 0
    var o: i64 = 0
    while o < 3 {
        var j: i64 = 0
        var s: i64 = x + o
        while j < 4 && s < 40 {
            s = s * 2 + j
            j = j + 1
        }
        total = total * 100 + s + j
        o = o + 1
    }
    return total
}

fn main(start: u64) -> i32 {
    var ok: bool = true
    var x: i64 = 5
    var z: i64 = 11
    if start == 7777777 {
        x = 1
        z = 1
    }
    ok = check(count1_like(x), 6640, "count1 x") && ok
    ok = check(count1_like(z), 6640, "count1 z") && ok
    ok = check(break_value(x), 2304, "break value x") && ok
    ok = check(break_value(z), 2502, "break value z") && ok
    ok = check(two_exits(x), 3051, "two exits x") && ok
    ok = check(two_exits(z), 4561, "two exits z") && ok
    ok = check(nested_exit(x), 475563, "nested exit x") && ok
    ok = check(nested_exit(z), 475155, "nested exit z") && ok
    if ok {
        io.print_line("ok")
    }
    return 0
}
