// expect_exit: 0
interface Named {
    fn id(*self) -> i64
}
interface Sized {
    fn size(*self) -> i64
}
interface Shape: Named + Sized {
    fn area(*self) -> i64
    fn tag(*self) -> i64 { return self.id() * 100 + self.area() }
}
struct Sq { s: i64 }
impl Named for Sq {
    fn id(*self) -> i64 { return 1 }
}
impl Sized for Sq {
    fn size(*self) -> i64 { return (*self).s }
}
impl Shape for Sq {
    fn area(*self) -> i64 { return (*self).s * (*self).s }
}
fn dynamic(x: dyn Shape) -> i64 { return x.id() * 1000 + x.size() * 100 + x.area() }
fn bound[T: Shape](x: *T) -> i64 { return x.id() + x.size() + x.area() }
fn main() -> i32 {
    let a: Sq = Sq { s: 3 }
    if dynamic((&a) as dyn Shape) != 1309 { return 1 }
    if bound[Sq](&a) != 13 { return 2 }
    if a.tag() != 109 { return 3 }
    return 0
}
