// expect_exit: 0
// Mob voices through the REAL 1.20.1 sound id table: server Sound Effect packets (ambient / hurt / death / step of the ten common mobs)
// resolve to a bank event, play at the mob position, use the mob category and are culled beyond hearing range.
import std.rt
import std.io
import audio.engine
import audio.bank
import mc.mc_audio
import mc.mc_camera
import mc.mc_entity
import mc.v763.mc_snd_v763

struct T { fails: i32, checks: i32 }

fn check(t: *mut T, ok: bool, what: str) {
    (*t).checks = (*t).checks + 1
    if ok {
        io.fmt_print(f"ok   {what}\n")
    } else {
        io.fmt_print(f"FAIL {what}\n")
        (*t).fails = (*t).fails + 1
    }
}

fn dc(e: *mut engine.Engine, frames: usize, v: f32) -> i32 {
    let p: u64 = rt.heap_alloc(frames * 4)
    var i: usize = 0
    while i < frames {
        *((p + (i * 4) as u64) as *mut f32) = v
        i = i + 1
    }
    return engine.engine_add_sample(e, p, frames as u64, 1 as u32)
}

fn id_of(m: *mut mc_audio.McAudio, name: str) -> i32 {
    var i: i32 = 0
    while i < 1474 {
        let n: str = mc_audio.mca_sound_name(m, i)
        if n.length() == name.length() && rt.mem_eq(n.p as u64, name.p as u64, name.length()) { return i }
        i = i + 1
    }
    return 0 - 1
}

fn put(b: *mut rt.Buf, s: str) { rt.buf_push_bytes(b, s.p as u64, s.length()) }

// "entity.<mob>.<action>" in a scratch buffer
fn evname(b: *mut rt.Buf, mob: str, act: str) -> str {
    rt.buf_clear(b)
    put(b, "entity.")
    put(b, mob)
    put(b, ".")
    put(b, act)
    return str { p: rt.buf_data(b), n: rt.buf_len(b) }
}

#[allow_escape]
fn main(start: u64) -> i32 {
    var t: T = T { fails: 0, checks: 0 }
    var e: engine.Engine = engine.engine_new(48000 as u32, 64 as u32)
    var b: bank.Bank = bank.bank_new()
    var m: mc_audio.McAudio = mc_audio.mca_new(&e)
    mc_audio.mca_sound_table_load(&m, mc_snd_v763.SND_BLOB.p as u64, mc_snd_v763.SND_COUNT, mc_snd_v763.SND_FIRST)
    let mobs: [str; 10] = ["zombie", "skeleton", "creeper", "spider", "cow", "pig", "sheep", "chicken", "villager", "enderman"]
    let acts: [str; 4] = ["ambient", "hurt", "death", "step"]
    // bank: one event per (mob, action) that exists in the 1.20.1 table
    bank.bank_provide(&b, "dc.wav", dc(&e, 24000, 0.5))
    var txt: rt.Buf = rt.buf_new()
    var nb: rt.Buf = rt.buf_new()
    put(&txt, "{ \"events\": [ ")
    var present: i32 = 0
    var mi: usize = 0
    while mi < 10 {
        var ai: usize = 0
        while ai < 4 {
            let nm: str = evname(&nb, mobs[mi], acts[ai])
            if id_of(&m, nm) >= 0 {
                if present > 0 { put(&txt, ", ") }
                put(&txt, "{ \"name\": \"")
                put(&txt, nm)
                put(&txt, "\", \"sample\": \"dc.wav\" }")
                present = present + 1
            }
            ai = ai + 1
        }
        mi = mi + 1
    }
    put(&txt, " ] }")
    io.fmt_print(f"mob events in the 1.20.1 table: {present} of 40\n")
    check(&t, present >= 30, "table has >= 30 of the 40 mob events")
    check(&t, mc_audio.mca_bank_load_text(&m, &b, rt.buf_data(&txt) as u64, rt.buf_len(&txt), "") == bank.BANK_OK, "bank loads")

    var cam: mc_camera.Camera = mc_camera.camera_new(160, 90)
    mc_camera.camera_set_pos(&cam, 0.0, 0.0, 0.0)
    mc_camera.camera_set_angles(&cam, 0.0, 0.0)
    mc_camera.camera_update(&cam)
    mc_audio.mca_update(&m, &cam, 0.05)

    // every present event: Sound Effect with the registry id, category from the packet, near = plays, far (40 blocks) = culled
    var played: i32 = 0
    var culled_ok: i32 = 0
    mi = 0
    while mi < 10 {
        var ai: usize = 0
        while ai < 4 {
            let nm: str = evname(&nb, mobs[mi], acts[ai])
            let id: i32 = id_of(&m, nm)
            if id >= 0 {
                var cat: i32 = mc_audio.CAT_NEUTRAL
                if mi < 4 || mi == 9 { cat = mc_audio.CAT_HOSTILE }
                var sp: mc_audio.SoundPkt = mc_audio.SoundPkt { id: id, name_p: 0, name_n: 0, has_range: false, range: 0.0, category: cat, entity: 0 - 1,
                    x: 3.0, y: 0.0, z: 2.0, volume: 1.0, pitch: 1.0, seed: 0 as i64 }
                if mc_audio.mca_apply_sound(&m, &sp, 0 as *mut mc_entity.Store) != 0 as u32 { played = played + 1 }
                let c0: u64 = m.n_culled
                sp.x = 40.0
                sp.z = 0.0
                if mc_audio.mca_apply_sound(&m, &sp, 0 as *mut mc_entity.Store) == 0 as u32 && m.n_culled == c0 + 1 as u64 { culled_ok = culled_ok + 1 }
                mc_audio.mca_stop_all(&m, 0.0)
            }
            ai = ai + 1
        }
        mi = mi + 1
    }
    check(&t, played == present, "all mob events play near the listener")
    check(&t, culled_ok == present, "all mob events are culled at 40 blocks")
    check(&t, m.n_missing == 0 as u64, "no event missing in the bank")

    // categories guessed from the name (used when a pack / named sound carries none): hostile vs neutral
    var cat_ok: bool = true
    mi = 0
    while mi < 10 {
        let nm: str = evname(&nb, mobs[mi], "hurt")
        let c: i32 = mc_audio.mca_category_of_event(nm.p as u64, nm.length())
        var want: i32 = mc_audio.CAT_NEUTRAL
        if mi < 4 || mi == 9 { want = mc_audio.CAT_HOSTILE }
        if c != want { cat_ok = false }
        mi = mi + 1
    }
    check(&t, cat_ok, "name category: zombie/skeleton/creeper/spider/enderman hostile, animals + villager neutral")
    io.fmt_print(f"{t.fails} failed of {t.checks}\n")
    return t.fails
}
