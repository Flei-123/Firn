// expect_exit: 0
// AUFRUFARGUMENTE — `fn main(start: u64) -> i32`.
//
// Beim Prozessstart zeigt `rsp` auf [argc][argv0]..[argvN][0][envp..].
// `_start` legt diesen Zeiger nach `rdi`, also in den ersten Parameter von
// `main`. Programme mit `fn main() -> i32` merken davon nichts.
//
// Ohne das kann ein in Firn geschriebenes Programm keinen Dateinamen
// entgegennehmen — und `firnc1` muss genau das koennen.
import modules.rt

fn main(start: u64) -> i32 {
    // Beim Test laeuft das Programm ohne weitere Argumente: argc == 1,
    // argv[0] ist der Programmname und endet auf "660_argumente" o. ae.
    if rt.arg_anzahl(start) < 1 {
        return 1
    }
    let p: u64 = rt.arg_zeiger(start, 0)
    if p == 0 {
        return 2
    }
    let n: usize = rt.c_laenge(p)
    if n == 0 {
        return 3
    }
    // Der Programmname enthaelt kein Nulloktett vor dem Ende.
    var i: usize = 0
    while i < n {
        if rt.ld8(p, i) == 0 as u8 {
            return 4
        }
        i = i + 1
    }
    // Jenseits von argc gibt es nichts.
    if rt.arg_zeiger(start, rt.arg_anzahl(start)) != 0 {
        return 5
    }
    // Der Abschluss der argv-Liste ist ein Nullzeiger.
    if rt.ld64(start, 1 + rt.arg_anzahl(start)) != 0 {
        return 6
    }
    // `c_laenge` auf einem Nullzeiger ist 0, nicht ein Absturz.
    if rt.c_laenge(0) != 0 {
        return 7
    }
    return 0
}
