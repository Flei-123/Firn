// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_text
import mc.mc_text_nbt
import mc.mc_chat

fn put_name(b: *mut bytes.Bytes, s: str) {
    bytes.put_u16(b, s.n as u16)
    bytes.put_raw(b, s.p as u64, s.n)
}

fn put_entry_str(b: *mut bytes.Bytes, k: str, v: str) {
    bytes.put_u8(b, 8 as u8)
    put_name(b, k)
    put_name(b, v)
}

fn line_is(ch: *mut mc_chat.Chat, k: usize, s: str) -> bool {
    if mc_chat.chat_line_len(ch, k) != s.n { return false }
    return rt.mem_eq(mc_chat.chat_line_ptr(ch, k), s.p as u64, s.n)
}

fn input_is(ch: *mut mc_chat.Chat, s: str) -> bool {
    if mc_chat.chat_input_len(ch) != s.n { return false }
    return rt.mem_eq(mc_chat.chat_input_ptr(ch), s.p as u64, s.n)
}

fn main() -> i32 {
    var ch: mc_chat.Chat = mc_chat.chat_new()
    mc_chat.chat_add_plain(&ch, "one".p as u64, 3, mc_chat.WHITE, 1000 as u64)
    mc_chat.chat_add_plain(&ch, "two\nthree".p as u64, 9, mc_chat.WHITE, 2000 as u64)
    if mc_chat.chat_line_count(&ch) != 3 { return 1 }
    if !line_is(&ch, 0, "three") || !line_is(&ch, 1, "two") || !line_is(&ch, 2, "one") { return 2 }
    if mc_chat.chat_line_time(&ch, 0) != 2000 as u32 { return 3 }
    var i: i32 = 0
    while i < 150 {
        mc_chat.chat_add_plain(&ch, "x".p as u64, 1, mc_chat.WHITE, 3000 as u64)
        i = i + 1
    }
    if mc_chat.chat_line_count(&ch) != mc_chat.MAX_LINES { return 4 }
    mc_chat.chat_add_plain(&ch, "caf\u{e9}".p as u64, 5, mc_chat.WHITE, 3000 as u64)
    if mc_chat.chat_line_len(&ch, 0) != 4 || mc_chat.chat_line_ptr(&ch, 0) == 0 as u64 { return 5 }
    if rt.ld8(mc_chat.chat_line_ptr(&ch, 0), 3) != 130 as u8 { return 5 }

    var tr: mc_text.Translations = mc_text.tr_new()
    var doc: mc_text.TextDoc = mc_text.text_new()
    let js: str = "{\"text\":\"a\",\"color\":\"red\",\"extra\":[{\"text\":\"b\"}]}"
    if !mc_text.text_from_json(&doc, js.p as u64, js.n, &tr) { return 6 }
    mc_chat.chat_add_doc(&ch, &doc, 4000 as u64)
    if !line_is(&ch, 0, "ab") { return 7 }
    if mc_chat.chat_line_color(&ch, 0, 0) != 0xFF5555FF as u32 { return 8 }
    mc_text.text_free(&doc)

    var nb: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&nb, 10 as u8)
    put_entry_str(&nb, "text", "hi ")
    put_entry_str(&nb, "color", "red")
    bytes.put_u8(&nb, 9 as u8)
    put_name(&nb, "extra")
    bytes.put_u8(&nb, 10 as u8)
    bytes.put_u32(&nb, 1 as u32)
    put_entry_str(&nb, "text", "there")
    bytes.put_u8(&nb, 1 as u8)
    put_name(&nb, "bold")
    bytes.put_u8(&nb, 1 as u8)
    bytes.put_u8(&nb, 0 as u8)
    bytes.put_u8(&nb, 0 as u8)
    var d2: mc_text.TextDoc = mc_text.text_new()
    if !mc_text_nbt.text_from_nbt(&d2, bytes.bytes_ptr(&nb), bytes.bytes_len(&nb), &tr) { return 9 }
    var plain: rt.Buf = rt.buf_new()
    mc_text.text_plain(&d2, &plain)
    if rt.buf_len(&plain) != 8 || !rt.mem_eq(rt.buf_ptr(&plain), "hi there".p as u64, 8) { return 10 }
    if mc_text.text_span_count(&d2) < 2 || (mc_text.text_span_flags(&d2, 1) & mc_text.F_BOLD) == 0 as u32 { return 11 }
    mc_text.text_free(&d2)
    rt.buf_free(&plain)
    bytes.bytes_free(&nb)

    var sb: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&sb, 8 as u8)
    put_name(&sb, "plain \"root\"")
    var d3: mc_text.TextDoc = mc_text.text_new()
    if !mc_text_nbt.text_from_nbt(&d3, bytes.bytes_ptr(&sb), bytes.bytes_len(&sb), &tr) { return 12 }
    if mc_text.text_len(&d3) != 12 { return 13 }
    mc_text.text_free(&d3)
    bytes.bytes_free(&sb)
    mc_text.tr_free(&tr)

    mc_chat.chat_input_clear(&ch)
    mc_chat.chat_input_char(&ch, 104 as u32)
    mc_chat.chat_input_char(&ch, 105 as u32)
    mc_chat.chat_input_char(&ch, 233 as u32)
    if !input_is(&ch, "hi\u{e9}") || mc_chat.chat_input_cursor(&ch) != 4 { return 14 }
    mc_chat.chat_input_backspace(&ch)
    if !input_is(&ch, "hi") { return 15 }
    mc_chat.chat_input_left(&ch)
    mc_chat.chat_input_char(&ch, 120 as u32)
    if !input_is(&ch, "hxi") || mc_chat.chat_input_cursor(&ch) != 2 { return 16 }
    mc_chat.chat_input_delete(&ch)
    if !input_is(&ch, "hx") { return 17 }
    mc_chat.chat_input_home(&ch)
    mc_chat.chat_input_delete(&ch)
    if !input_is(&ch, "x") { return 18 }
    i = 0
    while i < 400 { mc_chat.chat_input_char(&ch, 97 as u32); i = i + 1 }
    if mc_chat.chat_input_len(&ch) != mc_chat.INPUT_MAX { return 19 }

    mc_chat.chat_set_action(&ch, "act".p as u64, 3, mc_chat.WHITE, 100 as u64)
    if !mc_chat.chat_action_live(&ch, 2000 as u64) || mc_chat.chat_action_live(&ch, 4000 as u64) { return 20 }
    mc_chat.chat_free(&ch)
    return 0
}
