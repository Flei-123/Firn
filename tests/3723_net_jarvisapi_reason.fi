// expect_exit: 0
// tests/3723_net_jarvisapi_reason.fi -- net.jarvisapi tells WHY a request failed: a refused connection is status 0 with layer "tcp"
// (not just "no connection"), a request to a name that cannot be resolved is layer "dns" or "tcp"; ja_net_ms is the time it took.
import std.rt
import async.loop
import async.ahttp
import net.jarvisapi

static mut failures: i32 = 0
static mut G_DONE: i32 = 0
static mut G_STATUS: i64 = 0 - 1
static mut G_LAYER: u32 = 99 as u32
static mut G_MS: i64 = 0 - 1

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn cb(a: *mut jarvisapi.Api, ud: u64, kind: u32, status: i64) {
    G_STATUS = status
    G_LAYER = jarvisapi.ja_net_layer(a)
    G_MS = jarvisapi.ja_net_ms(a)
    G_DONE = G_DONE + 1
}

#[allow_escape]
fn main() -> i32 {
    var l: loop.Loop = loop.loop_new()
    check("loop", loop.loop_init(&l))
    let a: *mut jarvisapi.Api = jarvisapi.ja_new(&l, cb, 0)
    // nothing listens on port 1 of the loopback: the connection is refused
    jarvisapi.ja_set_base(a, "http://127.0.0.1:1")
    check("request started", jarvisapi.ja_tasks(a))
    var n: i32 = 0
    while G_DONE < 1 && n < 1000 {
        loop.run_once(&l, 10)
        n = n + 1
    }
    check("answered", G_DONE == 1)
    check("status 0 (no connection)", G_STATUS == 0)
    check("layer tcp", G_LAYER == ahttp.NL_TCP)
    check("layer name", jarvisapi.ja_net_layer_name(a) == "tcp")
    check("time is measured", G_MS >= 0 && G_MS < 5000)
    // no base: the request is not even started (the caller must say so, not leave "Loading")
    let b: *mut jarvisapi.Api = jarvisapi.ja_new(&l, cb, 0)
    check("no base: not started", !jarvisapi.ja_tasks(b))
    if failures == 0 {
        rt.write_everything(1, "ok\n".p as u64, 3)
    }
    return failures
}
