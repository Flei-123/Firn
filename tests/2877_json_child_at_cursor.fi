// expect_exit: 0
// r173: json_child_at(d, i, k) walked from the first child every time, so a
// loop over an array by index was quadratic (56k functions: 13 s instead of
// 0.9 s). Now the last position is remembered. Checks: forward loop over a
// big array, backwards, random-ish order, two containers interleaved, an
// index behind the end, and a second parse into the same document.
import std.json
import std.rt

fn build(n: i64, buf: *mut rt.Buf) {
    var w: json.JsonWriter = json.jw_new(buf, false)
    json.jw_begin_array(&w)
    var i: i64 = 0
    while i < n {
        json.jw_int(&w, i * 3)
        i = i + 1
    }
    json.jw_end(&w)
    json.jw_free(&w)
}

fn main() -> i32 {
    var buf: rt.Buf = rt.buf_new()
    let n: i64 = 60000
    build(n, &buf)
    var d: json.Json = json.json_new()
    let ok: bool = json.json_parse(&d, rt.buf_ptr(&buf), rt.buf_len(&buf)) catch false
    if !ok {
        return 1
    }
    let root: u32 = json.json_root(&d)
    if json.json_count(&d, root) != n as usize {
        return 2
    }
    // forward
    var sum: i64 = 0
    var k: usize = 0
    while k < n as usize {
        let c: u32 = json.json_child_at(&d, root, k)
        sum = sum + json.json_int(&d, c)
        k = k + 1
    }
    if sum != 3 * (n * (n - 1) / 2) {
        return 3
    }
    // backwards (every call restarts behind the cursor)
    k = 0
    while k < 200 {
        let idx: usize = (n as usize) - 1 - k
        let c: u32 = json.json_child_at(&d, root, idx)
        if json.json_int(&d, c) != (idx as i64) * 3 {
            return 4
        }
        k = k + 1
    }
    // jumping order
    k = 0
    while k < 1000 {
        let idx: usize = (k * 7919) % (n as usize)
        let c: u32 = json.json_child_at(&d, root, idx)
        if json.json_int(&d, c) != (idx as i64) * 3 {
            return 5
        }
        k = k + 1
    }
    // behind the end, and the cursor still works afterwards
    if json.json_child_at(&d, root, n as usize) != json.JSON_NONE {
        return 6
    }
    if json.json_int(&d, json.json_child_at(&d, root, 5)) != 15 {
        return 7
    }
    // a new document in the same Json: the cursor must not leak over
    var small: rt.Buf = rt.buf_new()
    build(4, &small)
    let ok2: bool = json.json_parse(&d, rt.buf_ptr(&small), rt.buf_len(&small)) catch false
    if !ok2 {
        return 8
    }
    let r2: u32 = json.json_root(&d)
    if json.json_int(&d, json.json_child_at(&d, r2, 3)) != 9 {
        return 9
    }
    if json.json_child_at(&d, r2, 4) != json.JSON_NONE {
        return 10
    }
    json.json_free(&d)
    rt.buf_free(&buf)
    rt.buf_free(&small)
    return 0
}
