// expect_exit: 0
// tests/4860_shellthread_app_loop.fi -- the app side of docs/SHELL_THREAD.md: dispatcher, start, event loop, frame acquire/submit, resize, title, stop. Passes also when no window can be opened (headless): then only the failure path is checked.
import std.rt
import std.time
import window.window
import window.shellthread
import window.shellproto

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == shellproto.SHELL_KIND {
        return shellthread.shell_main(arg)
    }
    return 9
}

fn paint(pix: u64, w: usize, h: usize, frame: u32) {
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            rt.st32(pix + (y * w * 4) as u64, x, 0xFF000000 | (frame * 8) | ((x as u32) & 255) << 8)
            x = x + 1
        }
        y = y + 1
    }
}

fn main() -> i32 {
    let sh: u64 = shellthread.shell_start("app loop", 320, 200)
    if sh == 0 {
        return 1
    }
    if !shellthread.shell_wait_open(sh, 8000) {
        // headless: the thread ended with ST_FAILED, stop must still clean up
        shellthread.shell_stop(sh)
        return 0
    }
    var rec: [u64; 8] = [0; 8]
    var frame: u32 = 0
    var closed: bool = false
    var seen_configure: bool = false
    while frame < 30 && !closed {
        // 1. events
        while shellthread.shell_poll(sh, &rec[0]) {
            if rec[0] == window.EV_CLOSED as u64 {
                closed = true
            }
            if rec[0] == window.EV_CONFIGURE as u64 {
                seen_configure = true
            }
        }
        // 2. frame at the CURRENT size
        let w: usize = shellthread.shell_width(sh)
        let h: usize = shellthread.shell_height(sh)
        let pix: u64 = shellthread.shell_frame_acquire(sh, w, h)
        if pix != 0 {
            paint(pix, w, h, frame)
            if !shellthread.shell_frame_submit(sh, pix, w, h) {
                return 2
            }
        }
        if frame == 5 {
            shellthread.shell_set_title(sh, "app loop 2")
            shellthread.shell_set_size(sh, 400, 300)
        }
        frame = frame + 1
        thread_sleep(10)
    }
    if shellthread.shell_stat(sh, shellproto.STAT_SHOWN) == 0 {
        return 3
    }
    shellthread.shell_stop(sh)
    return 0
}
