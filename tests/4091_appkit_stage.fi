// expect_exit: 0
// tests/4091_appkit_stage.fi -- lib/appkit/stage.fi: the startup stages of a run are kept for the next one.
// Run 1 marks a few stages and never reaches "first_frame"; run 2 (stage_open again) must see exactly those, not more.
import std.rt
import std.fs
import appkit.stage
import appkit.util

#[allow_escape]
fn main(start: u64) -> i32 {
    var dir: rt.Buf = rt.buf_new()
    util.buf_push_str(&dir, "/tmp/firn_appkit_stage_2055_")
    rt.buf_push_dec_i64(&dir, syscall(39, 0, 0, 0, 0, 0, 0))
    let d: str = util.buf_to_str_copy(&dir)
    fs.remove_tree(d) catch false
    stage.stage_mark("before_open")
    if !stage.stage_open(d) { return 1 }
    if stage.stage_prev_len() != 0 { return 2 }
    stage.stage_mark("main_enter")
    stage.stage_mark("egl_initialize")
    // run 2
    if !stage.stage_open(d) { return 3 }
    if !stage.stage_prev_has("main_enter") { return 4 }
    if !stage.stage_prev_has("egl_initialize") { return 5 }
    if stage.stage_prev_has("first_frame") { return 6 }
    if stage.stage_prev_has("egl_init") { return 7 }
    if stage.stage_prev_has("before_open") { return 8 }
    stage.stage_mark("first_frame")
    // run 3 sees run 2's single mark
    if !stage.stage_open(d) { return 9 }
    if !stage.stage_prev_has("first_frame") { return 10 }
    if stage.stage_prev_has("main_enter") { return 11 }
    var last: rt.Buf = rt.buf_new()
    stage.stage_prev_last(&last)
    if rt.buf_len(&last) != 11 { return 12 }
    fs.remove_tree(d) catch false
    return 0
}
