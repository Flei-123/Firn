}

gc class Observer {
    view: GcWeak[Target],
    keep: Gc[K69],
}

fn attach(b: Gc[Observer], depth: u64) -> AllocError!bool {
    var fill: [u64; 64] = [0; 64]
    fill[depth as usize] = depth
    if depth > 0 {
        return try attach(b, depth - 1)
    }
    let pad: Gc[Target] = try gc Target { value: 0 }
    let t: Gc[Target] = try gc Target { value: 7 + pad.value }
    b.view = weak(t)
    return strong(b.view).value == 7 && fill[0] == 0
}

