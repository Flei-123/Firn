// expect_exit: 0
import std.rt
import mc.mc_supported
import mc.server.sv_ver
import mc.server.sv_vers

fn fail(msg: str) -> i32 {
    rt.write_everything(2, msg.p as u64, msg.n)
    rt.write_everything(2, "\n".p as u64, 1)
    return 1
}

fn main(start: u64) -> i32 {
    if mc_supported.supported_count() < 2 { return fail("manifest too small") }
    if mc_supported.supported_protocol_by_name("1.20.1") != 763 { return fail("1.20.1 must map to 763") }
    if mc_supported.supported_protocol_by_name("1.20") != 763 { return fail("alias 1.20 must map to 763") }
    if mc_supported.supported_protocol_by_name("1.8.9") != 47 { return fail("1.8.9 must map to 47") }
    if mc_supported.supported_protocol_by_name("9.9.9") != 0 - 1 { return fail("unknown name must map to -1") }
    var joinable: usize = 0
    var i: usize = 0
    while i < mc_supported.supported_count() {
        let proto: i32 = mc_supported.supported_protocol_at(i)
        let server: bool = mc_supported.supported_server_at(i)
        if server != sv_vers.server_version_supported(proto) { return fail("server flag differs from the server registry") }
        if server {
            var a: sv_ver.ServerVersion = sv_ver.adapter_none()
            if !sv_vers.server_version_by_protocol(proto, &a) { return fail("registry lookup failed") }
            if a.protocol != proto { return fail("adapter protocol differs") }
        }
        if mc_supported.supported_joinable_at(i) {
            joinable = joinable + 1
            if !mc_supported.supported_client_at(i) { return fail("joinable entry without client flag") }
        } else if mc_supported.supported_client_at(i) || server {
            return fail("tables_only entry with client/server flag")
        }
        i = i + 1
    }
    if joinable != 2 { return fail("exactly 1.20.1 and 26.3 must be joinable today") }
    let expect: str = "{\"versions\":[{\"name\":\"1.20.1\",\"protocol\":763,\"aliases\":[\"1.20\"],\"client\":true,\"server\":true},{\"name\":\"26.3\",\"protocol\":777,\"aliases\":[],\"client\":true,\"server\":false}]}"
    let json: str = mc_supported.JOINABLE_JSON
    if json.n != expect.n || !rt.mem_eq(json.p as u64, expect.p as u64, json.n) { return fail("joinable json differs") }
    var none: sv_ver.ServerVersion = sv_ver.adapter_none()
    if sv_vers.server_version_by_protocol(764, &none) { return fail("764 must be unsupported") }
    if sv_vers.server_version_supported(0) { return fail("0 must be unsupported") }
    return 0
}
