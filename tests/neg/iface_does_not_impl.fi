// expect_error: 18:24 'Dot' setzt die schnittstelle 'Area' nicht um
// expect_error_count: 1
// Ein Typ, der die Schnittstelle nicht umsetzt, wird auch nicht zu einem
// Schnittstellenwert. Es gibt keine Methodentafel, die man anhaengen koennte.
interface Area {
    fn area(*self) -> i64
}

struct Circle { r: i64 }
struct Dot { x: i64 }

impl Area for Circle {
    fn area(*self) -> i64 { return (*self).r }
}

fn main() -> i32 {
    var p: Dot = Dot{ x: 1 }
    let f: dyn Area = (&p) as dyn Area
    return 0
}
