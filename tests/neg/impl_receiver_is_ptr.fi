// expect_error: 15:12 'Dot.first' expects the receiver as a value, found *mut Dot
// expect_error_count: 1
// The reverse case: the method wants a COPY, the receiver is present as a
// pointer. There is no silent dereference -- whoever means the
// copy writes it down: `(*z).first()`.
struct Dot { x: i32, y: i32 }

impl Dot {
    fn first(self) -> i32 { return self.x }
}

fn main() -> i32 {
    var p: Dot = Dot { x: 1, y: 2 }
    let z: *mut Dot = &p
    return z.first()
}
