// expect_error: 28:22 typ 'Circle' setzt die schnittstelle 'Order' nicht um
// expect_error_count: 1
// Der Regelfall: ein Typ ohne `impl`. Gemeldet wird an der AUSPRAEGUNG, und
// die Meldung nennt die Methode, die fehlen wuerde — nicht "unbekannte
// methode 'kleiner'" mitten in einer ausgepraegten Kopie von `kleineres`.
interface Order {
    fn less(*self, b: *Self) -> bool
}

struct Dot { x: i64 }

struct Circle { r: i64 }

impl Order for Dot {
    fn less(*self, b: *Dot) -> bool { return (*self).x < (*b).x }
}

fn smaller[T: Order](a: *T, b: *T) -> *T {
    if a.less(b) {
        return a
    }
    return b
}

fn main() -> i32 {
    var a: Circle = Circle{ r: 1 }
    var b: Circle = Circle{ r: 2 }
    let k: *Circle = smaller[Circle](&a, &b)
    return (*k).r as i32
}
