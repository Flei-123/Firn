// expect_error: 28:22 type 'Circle' does not implement the interface 'Order' — bound on the type parameter 'T' of 'smaller'
// expect_error_count: 1
// The normal case: a type without an `impl`. It is reported at the
// INSTANTIATION, and the message names the method that would be missing --
// not "unknown method 'less'" in the middle of an instantiated copy of
interface Order {
    fn less(*self, b: *Self) -> bool
}

struct Dot { x: i64 }

struct Circle { r: i64 }

impl Order for Dot {
    fn less(*self, b: *Dot) -> bool { return (*self).x < (*b).x }
}

fn smaller[T: Order](a: *T, b: *T) -> *T {
    if a.less(b) {
        return a
    }
    return b
}

fn main() -> i32 {
    var a: Circle = Circle { r: 1 }
    var b: Circle = Circle { r: 2 }
    let k: *Circle = smaller[Circle](&a, &b)
    return (*k).r as i32
}
