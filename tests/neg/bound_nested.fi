// expect_error: 18:12 type 'Circle' does not implement the interface 'Order' — bound on the type parameter 'T' of 'inner'
// expect_error_count: 1
// THE BOUND IS ONLY VIOLATED AT THE SECOND LEVEL. `outer[T]` has
// no bound and compiles on its own; only the call of
// `inner[T: Order]` in its body demands something that `Circle` does not have.
// It is reported at the inner instantiation -- that is where the reason is.
interface Order {
    fn less(*self, b: *Self) -> bool
}

struct Circle { r: i64 }

fn inner[T: Order](a: *T, b: *T) -> bool {
    return a.less(b)
}

fn outer[T](a: *T, b: *T) -> bool {
    return inner[T](a, b)
}

fn main() -> i32 {
    var x: Circle = Circle { r: 1 }
    var y: Circle = Circle { r: 2 }
    if outer[Circle](&x, &y) {
        return 1
    }
    return 0
}
