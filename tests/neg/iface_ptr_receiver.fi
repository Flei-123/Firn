// expect_error: 19:12 'dyn Area.area' expects the interface value itself, found *mut dyn Area
// expect_error_count: 1
// A POINTER to an interface value is not an interface value. The
// message says how it is meant: `(*z).m()`.
interface Area {
    fn area(*self) -> i64
}

struct Circle { r: i64 }

impl Area for Circle {
    fn area(*self) -> i64 { return (*self).r }
}

fn main() -> i32 {
    var k: Circle = Circle { r: 3 }
    var f: dyn Area = (&k) as dyn Area
    let z: *mut dyn Area = &f
    return z.area() as i32
}
