// expect_error: 6:30 a closure cannot capture 'p' of type Point (8 octets)
gc class Dummy { v: i64 }
struct Point { x: i32, y: i32 }
fn run() -> AllocError!i32 {
    let p: Point = Point { x: 1, y: 2 }
    let f: fn() -> i32 = try gc fn() -> i32 { return p.x }
    return f()
}
fn main() -> i32 {
    return run() catch 91
}
