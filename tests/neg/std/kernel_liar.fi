// tests/std/kernel_liar.fi -- ROUND 73: A MODULE THAT LIES.
//
// It calls itself `profile kernel` and asks mmap for memory all the same.
// That is exactly the case the rule of round 73 has to survive: the
// declaration in the first line is a CLAIM, not a permission slip. Because
// Firn compiles whole programs, this module lands in the SAME compilation
// unit as the kernel that imports it -- and there the syscall ban of the
// kernel profile catches it, at the line where the `syscall` stands.
//
// It lies in `tests/neg/std/`, so that `import std.kernel_liar` finds it next
// to the importing file. Not a test of its own: the test is
// tests/neg/kernel_liar.fi.
profile kernel

export { obtain }

fn obtain(n: usize) -> u64 {
    return syscall(9, 0, n as i64, 3, 34, 0 - 1, 0) as u64
}
