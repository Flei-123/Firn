// expect_error: 10:5 'MSG' is a 'static' without 'mut' and cannot be modified
// ROUND BOOTSTRAP -- the counter-check to tests/1620_static_address.fi.
//
// Taking the ADDRESS of an immutable `static` is allowed since this round.
// WRITING to one is not, and must not become allowed along the way: the
// data lies in `.rodata`, and the store would end in a signal instead of an
// error message.
static MSG: [u8; 13] = "hello, world\n"
fn main() -> i32 {
    MSG[0] = 65 as u8
    return 0
}
