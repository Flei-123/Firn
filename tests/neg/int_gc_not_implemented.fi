// expect_error: 6:12 unknown gc class 'i32'
// Integration: der GC aus SPEC §3.5 ist jetzt gebaut (Runde „Haertetest 2").
// `Gc[T]` traegt deshalb NICHT mehr die Meldung „nicht umgesetzt", sondern
// prueft sein Typargument: `Gc[T]` gibt es nur ueber einer `gc class`.
fn main() -> i32 {
    let x: Gc[i32] = 0 as i32
    return 0
}
