// expect_error: 13:13 argument 1 of 'Dot.set_x' has type bool, expected i32
// expect_error_count: 1
// The arguments of a method are checked like those of any other function --
// counted WITHOUT the receiver: `p.set_x(w)` has ONE argument.
struct Dot { x: i32, y: i32 }

impl Dot {
    fn set_x(*mut self, x: i32) { (*self).x = x }
}

fn main() -> i32 {
    var p: Dot = Dot { x: 1, y: 2 }
    p.set_x(true)
    return 0
}
