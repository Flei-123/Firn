// expect_error_count: 1
// Argumente einer Methode werden wie die jeder anderen Funktion geprueft —
// gezaehlt wird OHNE den Empfaenger: `p.setze_x(w)` hat EIN Argument.
struct Dot { x: i32, y: i32 }

impl Dot {
    fn set_x(*mut self, x: i32) { (*self).x = x }
}

fn main() -> i32 {
    var p: Dot = Dot{ x: 1, y: 2 }
    p.set_x(true)
    return 0
}
