// expect_error: 6:9 'n' is captured by value and cannot be assigned inside the closure
gc class Dummy { v: i64 }
fn run() -> AllocError!i32 {
    var n: i32 = 5
    let f: fn(i32) -> i32 = try gc fn(a: i32) -> i32 {
        n = n + a
        return n
    }
    return f(1)
}
fn main() -> i32 {
    return run() catch 91
}
