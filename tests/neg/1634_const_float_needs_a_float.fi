// expect_error: 7:16 constant 'A' has type f64, the value is of type usize
// ROUND FIRN-LUECKEN: `const` takes floating point numbers now -- but an
// integer does not become one on the way in. That is exactly the mistake
// `opt.rs::fold_cast` reports from round 20: the constant 100 became a
// `const.f64` with the BIT PATTERN 100, which is 5e-322.
const N: usize = 100
const A: f64 = N
fn main() -> i32 {
    return 0
}
