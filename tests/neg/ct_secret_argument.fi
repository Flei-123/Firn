// expect_error: 10:18 argument 1 of 'plain' has type secret[u8], expected u8
// ROUND 96: a function that promises nothing about its running time does
// not get a secret handed to it by accident.
fn plain(x: u8) -> u8 {
    return x
}

fn main() -> i32 {
    var s: secret[u8] = 7
    return plain(s) as i32
}
