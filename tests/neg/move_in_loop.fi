// expect_error: 12:18 'a' is moved inside a loop
struct Guard { id: i64 }

impl Guard { fn drop(inout self) { self.id = 0 } }

fn eat(g: Guard) -> i64 { return g.id }

fn main() -> i32 {
    let a: Guard = Guard { id: 1 }
    var i: i64 = 0
    while i < 2 {
        i += eat(a)
    }
    return 0
}
