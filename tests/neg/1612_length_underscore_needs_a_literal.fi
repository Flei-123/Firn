// expect_error: 11:12 the length '_' can only be taken from a literal
// ROUND 79 (gap 10 of docs/ROUND66.md): `[T; _]` takes its length out of the
// INITIALIZER, and only out of a literal -- a text literal, an array literal
// or `[v; n]`. A call yields no length the parser could read, and guessing
// one would be exactly the sort of quiet mistake this is meant to remove.
fn make() -> [u8; 4] {
    return "abcd"
}

fn main() -> i32 {
    var m: [u8; _] = make()
    return m[0] as i32
}
