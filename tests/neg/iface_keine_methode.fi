// expect_error: 23:14 die schnittstelle 'Flaeche' hat keine methode 'umfang'
// expect_error_count: 1
// Ueber einen Schnittstellenwert ist NUR erreichbar, was in der Schnittstelle
// steht — auch dann, wenn der konkrete Typ mehr kann. Sonst waere die Tafel
// nicht die ganze Wahrheit.
interface Flaeche {
    fn flaeche(*self) -> i64
}

struct Kreis { r: i64 }

impl Flaeche for Kreis {
    fn flaeche(*self) -> i64 { return (*self).r }
}

impl Kreis {
    fn umfang(*self) -> i64 { return 6 * (*self).r }
}

fn main() -> i32 {
    var k: Kreis = Kreis{ r: 1 }
    let f: dyn Flaeche = (&k) as dyn Flaeche
    return f.umfang() as i32
}
