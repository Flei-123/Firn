// expect_error: 9:14 an interpolation f"{…}" cannot show a value of type secret[u8]
// ROUND 96: printing a secret is the plainest side channel there is. It is
// caught by the ordinary rule that an interpolation shows integers, bool,
// f32, f64 and str -- a `secret[u8]` is none of those.
import std.io

fn main() -> i32 {
    var s: secret[u8] = 7
    io.print(f"{s}\n")
    return 0
}
