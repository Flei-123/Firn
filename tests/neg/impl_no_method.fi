// expect_error: 14:14 type 'Dot' has no method 'diff'
// expect_error_count: 1
// A method that does not exist is reported as such -- with the TYPE in the
// text and the existing methods in the note. The call does NOT fall back
// to a free function of the same name (compiler/src/impls.rs).
struct Dot { x: i32, y: i32 }

impl Dot {
    fn sum(*self) -> i32 { return (*self).x + (*self).y }
}

fn main() -> i32 {
    var p: Dot = Dot { x: 1, y: 2 }
    return p.diff()
}
