// expect_error: 18:12 typ 'Kreis' setzt die schnittstelle 'Ordnung' nicht um
// expect_error_count: 1
// DIE SCHRANKE WIRD ERST IN DER ZWEITEN STUFE VERLETZT. `aussen[T]` hat
// keine Schranke und uebersetzt fuer sich genommen; erst der Aufruf von
// `innen[T: Ordnung]` in seinem Rumpf verlangt etwas, das `Kreis` nicht hat.
// Gemeldet wird an der inneren Auspraegung — dort steht der Grund.
interface Ordnung {
    fn kleiner(*self, b: *Self) -> bool
}

struct Kreis { r: i64 }

fn innen[T: Ordnung](a: *T, b: *T) -> bool {
    return a.kleiner(b)
}

fn aussen[T](a: *T, b: *T) -> bool {
    return innen[T](a, b)
}

fn main() -> i32 {
    var x: Kreis = Kreis{ r: 1 }
    var y: Kreis = Kreis{ r: 2 }
    if aussen[Kreis](&x, &y) {
        return 1
    }
    return 0
}
