// expect_error: 6:27 is no permitted name for an environment variable
// ROUND FIRN-ENV -- the SHAPE of the name. `A-Z`, `0-9`, `_`, at most 64
// octets. Not because lower case would be technically hard, but because
// `__env_or("path", ...)` standing next to `PATH` is a trap.
fn main() -> i32 {
    let s: str = __env_or("firn_x", "none")
    return 0
}
