// expect_error: 8:18 operator '&' is not defined for f32
// Bit operations on a floating point value have no sensible meaning.
// Whoever wants the bits fetches them: `math.math_bits32(x)` gives the u32
// and `math.math_f32(b)` gives the f32 back (round 71).
fn main() -> i32 {
    let a: f32 = 1.5
    let b: f32 = 2.5
    let c: f32 = a & b
    let _ = c
    return 0
}
