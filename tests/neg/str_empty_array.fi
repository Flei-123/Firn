// expect_error: 6:22 empty string literal
// ROUND 70: `""` is a valid, EMPTY `str` -- but an array literal needs at
// least one element. The message therefore comes from the type check now,
// which is the only place that knows the context.
fn main() -> i32 {
    var t: [u8; 4] = ""
    return t[0] as i32
}
