// expect_error: 11:5 'a' is moved in only one branch
struct Guard { id: i64 }

impl Guard { fn drop(inout self) { self.id = 0 } }

fn eat(g: Guard) -> i64 { return g.id }

fn main() -> i32 {
    let a: Guard = Guard { id: 1 }
    var x: i64 = 0
    if x == 0 {
        x = eat(a)
    }
    return x as i32
}
