// expect_error: 7:39 '__thread_start' expects a pointer to the tid word as third argument, found u64
// ROUND 49: the third argument is the pointer to the TID word. The kernel
// writes there and clears it when the thread ends -- a number instead of a
// pointer would be a silent write to an arbitrary address.
fn main() -> i32 {
    var t: u64 = 7
    let r: i64 = __thread_start(1, 2, t)
    return r as i32
}
