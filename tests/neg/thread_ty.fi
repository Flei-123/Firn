// expect_error: 7:39 '__thread_start' expects a pointer to the tid word as third argument, found u64
// RUNDE 49: das dritte Argument ist der Zeiger auf das TID-Wort. Der Kern
// schreibt dort hin und nullt es beim Fadenende — eine Zahl statt eines
// Zeigers waere ein stiller Schreibzugriff auf eine beliebige Adresse.
fn main() -> i32 {
    var t: u64 = 7
    let r: i64 = __thread_start(1, 2, t)
    return r as i32
}
