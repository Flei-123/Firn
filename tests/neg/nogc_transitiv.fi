// expect_error: 21:17 'mid' is #[no_gc], but calls 'below' without #[no_gc]
// expect_error_count: 1
// Transitivity over two levels (SPEC 3.5.4): 'top' calls 'mid', both
// carry #[no_gc] -- the break sits one level deeper, in 'mid' -> 'below'.
// What is reported is exactly the place where the chain tears, not the call
// at the very top.
fn below(a: i32) -> i32 {
    return a + 1 as i32
}

#[no_gc]
fn top(a: i32) -> i32 {
    return mid(a) + mid(a + 1 as i32)
}

#[no_gc]
fn mid(a: i32) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    while i < 2 as i32 {
        s = s + below(a)
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    return top(0 as i32)
}
