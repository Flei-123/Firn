// expect_error: 21:17 'mid' is #[no_gc], but calls 'below' without #[no_gc]
// expect_error_count: 1
// Transitivitaet ueber zwei Ebenen (SPEC §3.5.4): 'oben' ruft 'mitte', beide
// tragen #[no_gc] — der Bruch steckt eine Ebene tiefer, in 'mitte' -> 'unten'.
// Gemeldet wird genau die Stelle, an der die Kette reisst, nicht der Aufruf
// ganz oben.
fn below(a: i32) -> i32 {
    return a + 1 as i32
}

#[no_gc]
fn top(a: i32) -> i32 {
    return mid(a) + mid(a + 1 as i32)
}

#[no_gc]
fn mid(a: i32) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    while i < 2 as i32 {
        s = s + below(a)
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    return top(0 as i32)
}
