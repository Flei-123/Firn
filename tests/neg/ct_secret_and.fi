// expect_error: 7:8 '&&' must not depend on a secret value, found secret[bool]
// ROUND 96 (SPEC 9.1): `&&` skips its right hand side -- a branch written
// without the word `if`.
fn main() -> i32 {
    var s: secret[bool] = true
    var p: bool = false
    if s && p {
        return 1
    }
    return 0
}
