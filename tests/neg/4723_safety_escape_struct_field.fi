// expect_error: 9:5 the address of the local 'x' escapes through the return value
// r899: a struct field that holds the address of a local must not be returned.
struct S { p: *mut i64 }

fn mk() -> S {
    var x: i64 = 5
    var s: S = S { p: 0 as *mut i64 }
    s.p = &x
    return s
}

fn main() -> i32 {
    let s: S = mk()
    return 0
}
