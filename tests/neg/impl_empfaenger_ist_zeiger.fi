// expect_error: 15:12 erwartet den empfaenger als wert
// expect_error_count: 1
// Umgekehrter Fall: die Methode will eine KOPIE, der Empfaenger liegt als
// Zeiger vor. Es gibt keine stillschweigende Dereferenzierung — wer die
// Kopie meint, schreibt sie hin: `(*z).erstes()`.
struct Punkt { x: i32, y: i32 }

impl Punkt {
    fn erstes(self) -> i32 { return self.x }
}

fn main() -> i32 {
    var p: Punkt = Punkt{ x: 1, y: 2 }
    let z: *mut Punkt = &p
    return z.erstes()
}
