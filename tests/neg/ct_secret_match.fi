// expect_error: 6:11 'match' works on enums, integers and bool, not on secret[i32]
// ROUND 96 (SPEC 9.1): `match` is a jump table, and a jump table indexed
// by a secret is both a branch and an index.
fn main() -> i32 {
    var s: secret[i32] = 3
    match s {
        1 => {
            return 1
        }
        _ => {
            return 2
        }
    }
}
