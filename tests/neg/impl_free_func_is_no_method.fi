// expect_error: 15:14 type 'Dot' has no method 'dot_sum'
// expect_error_count: 1
// NAME RESOLUTION: a free function is no method, even when its
// first parameter is the matching pointer. Methods are called
// `Type__name` internally -- `dot_sum` is not called that and is therefore
// not found by `p.dot_sum()`. Nothing can hide anything here, they are two names.
struct Dot { x: i32, y: i32 }

fn dot_sum(p: *mut Dot) -> i32 {
    return (*p).x + (*p).y
}

fn main() -> i32 {
    var p: Dot = Dot { x: 1, y: 2 }
    return p.dot_sum()
}
