// expect_error: 17:32 'step' is #[no_gc], but calls 'log' without #[no_gc]
// expect_error_count: 1
// The violation sits in the body of a 'match' case. These blocks do not lie
// in the AST but in the registry of sema_match.rs -- without descending
// into it every state machine would be a blind spot, that is exactly
// the code #[no_gc] is meant for.
enum State { Start, End }

fn log(c: i32) -> i32 {
    return c
}

#[no_gc]
fn step(z: State, c: i32) -> i32 {
    match z {
        State::Start => { return c * 2 as i32 }
        State::End => { return log(c) }
    }
}

fn main() -> i32 {
    return step(State::Start, 0 as i32)
}
