// the size) is thrown away is refused at compile time: a failed decode must not be
// able to pass for a successful one by accident.
import compress.zstd
import std.rt

fn main() -> i32 {
    var out: rt.Buf = rt.buf_new()
    zstd.zstd_decompress(0, 0, &out)
    return 0
}
