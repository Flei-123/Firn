// expect_error: 8:9 this lambda takes 2 parameter(s) but the expected function type has 1
// tests/neg/4242_lambda_assign_wrong_arity.fi -- r740: the expected type of `g = |a, b| ..` is the declared type of `g`.
fn plain(x: i64) -> i64 {
    return x
}
fn main() -> i32 {
    var g: fn(i64) -> i64 = plain
    g = |a, b| a + b
    return g(1) as i32
}
