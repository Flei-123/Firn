// expect_error: 10:12 ruft aber 'nogc_kalt.aufwaendig' ohne #[no_gc]
// expect_error_count: 1
// Regel (ii) ueber die MODULGRENZE (SPEC §3.5.4). Das Modulsystem schreibt
// den Namen intern auf 'nogc_kalt__aufwaendig' um; die Meldung zeigt wieder
// die Schreibweise aus dem Quelltext.
import modules.nogc_kalt

#[no_gc]
fn heiss(a: i32) -> i32 {
    return nogc_kalt.aufwaendig(a)
}

fn main() -> i32 {
    return heiss(0 as i32)
}
