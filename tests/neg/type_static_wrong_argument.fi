// Arguments of a type-name call are checked like those of any function.
struct Counter { n: i32 }

impl Counter {
    fn from(n: i32) -> Counter { return Counter { n: n } }
}

fn main() -> i32 {
    let c: Counter = Counter.from("seven")
    return c.n
}
