// expect_error: 22:8 type argument 'Dot' does not satisfy the bound 'Int' of the type parameter 'T' of 'f'
// expect_error_count: 1
// MEHRERE SCHRANKEN, EINE VERLETZT. `Punkt` setzt `Ordnung` um, ist aber
// kein Ganzzahltyp — `Int` schlaegt fehl. Gemeldet wird die ERSTE verletzte
// Schranke; eine zweite Meldung zu demselben Typargument saegte nichts Neues.
interface Order {
    fn less(*self, b: *Self) -> bool
}

struct Dot { x: i64 }

impl Order for Dot {
    fn less(*self, b: *Dot) -> bool { return (*self).x < (*b).x }
}

fn f[T: Int + Order](a: *T) -> bool {
    return a.less(a)
}

fn main() -> i32 {
    var p: Dot = Dot{ x: 1 }
    if f[Dot](&p) {
        return 1
    }
    return 0
}
