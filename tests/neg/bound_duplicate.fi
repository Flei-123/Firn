// expect_error: 9:17 the bound 'Order' appears twice on 'T'
// expect_error_count: 1
// The same bound twice. That is no tightening but a
// typing mistake -- reported while parsing, not only at the instantiation.
interface Order {
    fn less(*self, b: *Self) -> bool
}

fn f[T: Order + Order](a: *T) -> bool {
    return a.less(a)
}

fn main() -> i32 {
    return 0
}
