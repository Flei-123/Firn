// expect_error: 8:33 '__atomic_add' expects a *mut u64 as first argument, found *mut u32
// ROUND BOOTSTRAP -- the counter-check to the atomic width.
// `firnc1` used to accept ANY pointer here. The instruction exchanges
// exactly one 64-bit word, so a `*mut u32` would write over the four
// octets next to it -- silently, and only sometimes.
fn main() -> i32 {
    var w: u32 = 0
    let old: u64 = __atomic_add(&w, 1)
    return old as i32
}
