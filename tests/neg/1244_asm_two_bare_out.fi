// expect_error: 5:64 an asm block has at most one 'out' register WITHOUT a target
// ROUND 68: the VALUE form `out("rax")` is still limited to one -- an
// expression has ONE value. Whoever wants more writes the target behind it.
fn main() -> i32 {
    let s: u64 = asm("mov rax, 1\nmov rdx, 2", out("rax"), out("rdx"))
    return s as i32
}
