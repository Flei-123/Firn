// expect_error: 7:25 operator '+|' is not allowed on a secret value
// ROUND 96: the saturating form clamps with `jo`/`jc`
// (codegen_x86::emit_wrap_sat) -- a conditional jump on a secret.
fn main() -> i32 {
    var a: secret[u8] = 200
    var b: secret[u8] = 100
    let c: secret[u8] = a +| b
    return declassify(c) as i32
}
