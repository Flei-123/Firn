// expect_error: 10:7 'Bytes' has it
// expect_error_count: 1
// ROUND 88: `push`/`add` exists -- on `Bytes`, not on `str`. Saying "this
// method does not exist" would be a lie; a `str` is a view of octets that
// nobody may change any more (SPEC 8.0), and that is what the message says.
import std.str

fn main() -> i32 {
    let a: str = "hello"
    a.add(1 as u8)
    return 0
}
