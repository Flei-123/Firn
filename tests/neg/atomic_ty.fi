// expect_error: 8:31 '__atomic_add' expects a *mut u64 as first argument, found *mut u32
// ROUND 47 -- the atomic primitive changes EXACTLY one 64-bit word. A pointer
// to anything else is an error with a line/column, not silent arithmetic on
// the lower 32 bits (compiler/src/atomic.rs, lib/firnc1/sema.fi).

fn main() -> i32 {
    var z: u32 = 5
    let a: u64 = __atomic_add(&z, 7)
    if a == 0 {
        return 1
    }
    return 0
}
