// expect_error: 8:31 '__atomic_add' expects a *mut u64 as first argument, found *mut u32
// RUNDE 47 — das atomare Primitiv aendert GENAU ein 64-Bit-Wort. Ein Zeiger
// auf etwas anderes ist ein Fehler mit Zeile/Spalte, kein stilles Rechnen auf
// den unteren 32 Bit (compiler/src/atomic.rs, lib/firnc1/sema.fi).

fn main() -> i32 {
    var z: u32 = 5
    let a: u64 = __atomic_add(&z, 7)
    if a == 0 {
        return 1
    }
    return 0
}
