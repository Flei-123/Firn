// expect_error: 19:12 'dyn Flaeche.flaeche' erwartet den schnittstellenwert selbst, gefunden *mut dyn Flaeche
// expect_error_count: 1
// Ein ZEIGER auf einen Schnittstellenwert ist kein Schnittstellenwert. Die
// Meldung sagt, wie es gemeint ist: `(*z).m()`.
interface Flaeche {
    fn flaeche(*self) -> i64
}

struct Kreis { r: i64 }

impl Flaeche for Kreis {
    fn flaeche(*self) -> i64 { return (*self).r }
}

fn main() -> i32 {
    var k: Kreis = Kreis{ r: 3 }
    var f: dyn Flaeche = (&k) as dyn Flaeche
    let z: *mut dyn Flaeche = &f
    return z.flaeche() as i32
}
