// expect_error: 7:17 a secret value cannot be converted to the public type u8
// ROUND 96 (SPEC 9.1): `as` must not take the marking off -- that would be
// declassification through the back door, and nobody would find it in a
// review.
fn main() -> i32 {
    var a: secret[u8] = 7
    let b: u8 = a as u8
    return b as i32
}
