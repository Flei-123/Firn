// expect_error: 21:8 typ 'u8' setzt die schnittstelle 'Ordnung' nicht um
// expect_error_count: 1
// Ein GRUNDTYP ohne Umsetzung. Seit Runde 50 darf `i32` eine Schnittstelle
// umsetzen — automatisch tut er es nicht. Die Meldung nennt die Methode, die
// in `impl Ordnung for u8` stehen muesste.
interface Ordnung {
    fn kleiner(*self, b: *Self) -> bool
}

impl Ordnung for i32 {
    fn kleiner(*self, b: *i32) -> bool { return *self < *b }
}

fn f[T: Ordnung](a: *T, b: *T) -> bool {
    return a.kleiner(b)
}

fn main() -> i32 {
    var x: u8 = 1
    var y: u8 = 2
    if f[u8](&x, &y) {
        return 1
    }
    return 0
}
