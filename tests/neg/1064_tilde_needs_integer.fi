// expect_error: 7:19 unary '~' expects an integer type, found bool
// ROUND 68: up to round 67 this file held the LEXER hint "Firn has no '~'".
// Firn has it now; what is left over is the type rule -- `~` wants an
// integer, `!` wants a bool, and neither stands in for the other.
fn main() -> i32 {
    let a: bool = true
    let b: bool = ~a
    if b { return 1 }
    return 0
}
