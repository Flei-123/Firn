// expect_error: 393:5 das ergebnis darf nicht verworfen werden
// ERZEUGT von lib/rc/gen_tests.sh: Zeile 1 und der Rumpf aus
// lib/rc/parts/neg_rc_discarded.fi, dazwischen tests/modules/rc.fi WOERTLICH.
// Modul 'rc' — Stufe 2 des Speichermodells (SPEC.md §3.4, Anforderung S7):
// geteilte, IMMER UNVERAENDERLICHE Werte mit Zaehlung, plus schwache
// Verweise, die Zyklen von Hand brechen.
//
// Reines Firn, keine Compileraenderung. Der Speicher kommt direkt von mmap(2)
// (kein MAP_FIXED, keine feste Adresse; ein fehlgeschlagenes mmap wird
// sichtbar gemeldet und nie stillschweigend als Erfolg ausgegeben).
//
// Benutzung aus tests/:      import modules.rc
// Bibliothekspfad:           lib/rc/rc.fi  (Symlink auf genau diese Datei)
//
// ABWEICHUNGEN von SPEC §3.4 (Begruendung im Bericht docs/berichte/rclib.md
// und in docs/RC.md):
//   A1  Die Typnamen heissen 'Zaehlverweis[T]' und 'Schwachverweis[T]'.
//       'Rc'/'Weak'/'Arc' sind im Parser als noch nicht umgesetzte
//       Typkonstruktoren reserviert (compiler/src/parser.rs,
//       nicht_umgesetzter_typ) und koennen von einem reinen Firn-Modul nicht
//       belegt werden. Die Funktionsnamen folgen dem vereinbarten Vertrag
//       (rc_neu, rc_lesen, rc_klonen, rc_freigeben, rc_stark_zahl,
//       weak_von, aufwerten, weak_freigeben).
//   A2  Stufe 0 kennt keine Methoden: 'Rc[T].neu' ist die Funktion 'rc_neu'.
//   A3  Stufe 0 kennt kein 'inout': der Halde-Parameter ist ein '*mut RcHeap'.
//   A4  Der Erfolgswert der Allokation kommt ueber einen Ausgabezeiger, die
//       Rueckgabe ist 'AllocError!bool'. Grund: die Monomorphisierung setzt
//       Typargumente in der Nutzlast einer Fehlerunion nicht ein —
//       'fn f[T](..) -> AllocError!Zaehlverweis[T]' meldet
//       "unbekannter typ 'Zaehlverweis__T'". Die Allokation bleibt damit
//       vollstaendig fehlbar (DESIGNZIELE §2) und das Ergebnis ist
//       '#[must_consume]'; Verwerfen ist ein Compilerfehler
//       (tests/neg/rc_discarded.fi).
//   A5  'Arc[T]' (atomarer Zaehler) ist NICHT gebaut — offen.
//
// ZYKLEN LECKEN. Das ist gewollt und wird in tests/552_rc_cycle_leak.fi
// sichtbar gemacht, nicht versteckt. Fuer den DOM ist 'Rc' deshalb
// ausdruecklich NICHT vorgesehen — dafuer gibt es 'gc class'/'Gc[T]'
// (SPEC §3.5). Siehe docs/RC.md.

export {
    AllocError, RcHeap, RefCount, WeakRef,
    rc_heap_init, rc_heap_free, rc_heap_capacity, rc_heap_live,
    rc_heap_used_bytes, rc_heap_allocations, rc_heap_releases,
    rc_size_of, rc_ld64, rc_st64,
    rc_new, rc_empty, rc_is_empty, rc_read, rc_clone, rc_free,
    rc_strong_number, rc_weak_number, rc_equal,
    rc_raw_address, rc_value_address, rc_raw_ref,
    weak_of, weak_empty, weak_is_empty, promote, weak_free,
    weak_strong_number, weak_raw_address
}

// Die Fehlermenge der fehlbaren Allokation (DESIGNZIELE §2). Fehlermengennamen
// sind programmweit (SPEC §14.1); im Endstand deklariert sie die GC-Laufzeit
// (Modul 'gckern'). Solange die noch nicht im Baum ist, steht sie hier —
// Modul 'mess' loest die Doppelung auf, sobald beide Fassungen existieren.
error AllocError { OutOfMemory }

const RC_SYS_MMAP: i64 = 9
const RC_SYS_MUNMAP: i64 = 11
const RC_PROT_READ_WRITE: i64 = 3
const RC_MAP_PRIVATE_ANON: i64 = 34

// Blockkopf: 32 Byte, danach der Wert.
//   +0   stark      u64   Zahl der starken Verweise
//   +8   schwach    u64   Zahl der schwachen Verweise
//   +16  klasse     u64   Groessenklasse (fuer die Freiliste)
//   +24  naechster  u64   Verkettung in der Freiliste (nur wenn frei)
//   +32  wert       T
const RC_KOPF: usize = 32
const RC_KLASSEN: usize = 8
const RC_KLASSE0: usize = 64

// Zaehlender, geteilter, unveraenderlicher Verweis (SPEC §3.4 'Rc[T]').
// 'block' ist 0, wenn der Verweis leer ist.
struct RefCount[T] { block: usize }

// Schwacher Verweis (SPEC §3.4 'Weak[T]'), haelt den Wert NICHT am Leben.
struct WeakRef[T] { block: usize }

// Die Halde. Feste Kapazitaet — genau das macht die Allokation fehlbar und
// ist die Grundlage fuer Speichergrenzen pro Auftrag.
struct RcHeap {
    base: usize,
    capacity: usize,
    next: usize,
    free: [usize; 8],
    live: usize,
    used: usize,
    allocations: usize,
    releases: usize,
}

// Hilfstyp, um die Schrittweite eines Typs ohne 'sizeof' zu bestimmen.
struct RcPair[T] { a: T, b: T }

fn rc_pages(n: usize) -> usize {
    return (n + 4095 as usize) / 4096 as usize * 4096 as usize
}

fn rc_ld64(addr: usize) -> u64 {
    return *(addr as *mut u64)
}

fn rc_st64(addr: usize, v: u64) {
    *(addr as *mut u64) = v
}

// Schrittweite (Groesse einschliesslich Ausrichtung) des Typs T.
fn rc_size_of[T: Any](pattern: T) -> usize {
    var p: RcPair[T] = RcPair[T]{ a: pattern, b: pattern }
    return (&p.b) as usize - (&p.a) as usize
}

fn rc_class_bytes(k: usize) -> usize {
    var b: usize = RC_KLASSE0
    var i: usize = 0 as usize
    while i < k {
        b = b * 2 as usize
        i = i + 1 as usize
    }
    return b
}

// Kleinste Klasse, in die 'gesamt' Bytes passen; RC_KLASSEN = zu gross.
fn rc_class_for(total: usize) -> usize {
    var k: usize = 0 as usize
    while k < RC_KLASSEN {
        if total <= rc_class_bytes(k) {
            return k
        }
        k = k + 1 as usize
    }
    return RC_KLASSEN
}

// Legt die Halde an. false = mmap fehlgeschlagen (sichtbarer Fehlschlag,
// der Aufrufer MUSS abbrechen). Ohne feste Adresse, ohne MAP_FIXED.
fn rc_heap_init(h: *mut RcHeap, bytes: usize) -> bool {
    (*h).base = 0 as usize
    (*h).capacity = 0 as usize
    (*h).next = 0 as usize
    (*h).live = 0 as usize
    (*h).used = 0 as usize
    (*h).allocations = 0 as usize
    (*h).releases = 0 as usize
    var i: usize = 0 as usize
    while i < RC_KLASSEN {
        (*h).free[i] = 0 as usize
        i = i + 1 as usize
    }
    if bytes == 0 as usize {
        return false
    }
    let len: usize = rc_pages(bytes)
    let r: i64 = syscall(RC_SYS_MMAP, 0, len as i64, RC_PROT_READ_WRITE,
                         RC_MAP_PRIVATE_ANON, 0 - 1, 0)
    if r < 0 && r > 0 - 4096 {
        return false
    }
    if r == 0 {
        return false
    }
    (*h).base = r as usize
    (*h).capacity = len
    return true
}

fn rc_heap_free(h: *mut RcHeap) {
    if (*h).base != 0 as usize {
        syscall(RC_SYS_MUNMAP, (*h).base as i64, (*h).capacity as i64)
    }
    (*h).base = 0 as usize
    (*h).capacity = 0 as usize
    (*h).next = 0 as usize
}

fn rc_heap_capacity(h: *mut RcHeap) -> usize { return (*h).capacity }
fn rc_heap_live(h: *mut RcHeap) -> usize { return (*h).live }
fn rc_heap_used_bytes(h: *mut RcHeap) -> usize { return (*h).used }
fn rc_heap_allocations(h: *mut RcHeap) -> usize { return (*h).allocations }
fn rc_heap_releases(h: *mut RcHeap) -> usize { return (*h).releases }

// Rohblock holen. 0 = kein Speicher mehr.
fn rc_block_get(h: *mut RcHeap, payload: usize) -> usize {
    let k: usize = rc_class_for(RC_KOPF + payload)
    if k >= RC_KLASSEN {
        return 0 as usize
    }
    let gr: usize = rc_class_bytes(k)
    var addr: usize = (*h).free[k]
    if addr != 0 as usize {
        (*h).free[k] = rc_ld64(addr + 24 as usize) as usize
    } else {
        if (*h).base == 0 as usize {
            return 0 as usize
        }
        if (*h).next + gr > (*h).capacity {
            return 0 as usize
        }
        addr = (*h).base + (*h).next
        (*h).next = (*h).next + gr
    }
    rc_st64(addr + 0 as usize, 0 as u64)
    rc_st64(addr + 8 as usize, 0 as u64)
    rc_st64(addr + 16 as usize, k as u64)
    rc_st64(addr + 24 as usize, 0 as u64)
    (*h).live = (*h).live + 1 as usize
    (*h).used = (*h).used + gr
    (*h).allocations = (*h).allocations + 1 as usize
    return addr
}

fn rc_block_back(h: *mut RcHeap, addr: usize) {
    let k: usize = rc_ld64(addr + 16 as usize) as usize
    if k >= RC_KLASSEN {
        return
    }
    rc_st64(addr + 24 as usize, (*h).free[k] as u64)
    (*h).free[k] = addr
    (*h).live = (*h).live - 1 as usize
    (*h).used = (*h).used - rc_class_bytes(k)
    (*h).releases = (*h).releases + 1 as usize
}

// Legt 'wert' auf der Halde ab und liefert einen starken Verweis in '*aus'.
// FEHLBAR (DESIGNZIELE §2): bei erschoepfter Halde AllocError::OutOfMemory.
// Das Ergebnis ist '#[must_consume]' — Verwerfen ist ein Compilerfehler.
fn rc_new[T: Any](h: *mut RcHeap, value: T, out: *mut RefCount[T]) -> AllocError!bool {
    (*out).block = 0 as usize
    let gr: usize = rc_size_of[T](value)
    let addr: usize = rc_block_get(h, gr)
    if addr == 0 as usize {
        return AllocError::OutOfMemory
    }
    rc_st64(addr + 0 as usize, 1 as u64)
    rc_st64(addr + 8 as usize, 0 as u64)
    *((addr + RC_KOPF) as *mut T) = value
    (*out).block = addr
    return true
}

fn rc_empty[T: Any]() -> RefCount[T] {
    return RefCount[T]{ block: 0 as usize }
}

fn rc_is_empty[T: Any](r: RefCount[T]) -> bool {
    return r.block == 0 as usize
}

// NUR LESEN. 'Rc' ist immer unveraenderlich (SPEC §3.4): es gibt kein
// RefCell-Aequivalent und in diesem Modul keine schreibende Funktion.
// Geliefert wird eine Kopie des Wertes — Aenderungen daran wirken nicht
// zurueck auf den geteilten Wert.
fn rc_read[T: Any](r: RefCount[T]) -> T {
    return *((r.block + RC_KOPF) as *mut T)
}

fn rc_clone[T: Any](r: RefCount[T]) -> RefCount[T] {
    if r.block == 0 as usize {
        return RefCount[T]{ block: 0 as usize }
    }
    rc_st64(r.block + 0 as usize, rc_ld64(r.block + 0 as usize) + 1 as u64)
    return RefCount[T]{ block: r.block }
}

// Gibt einen starken Verweis zurueck und leert ihn. Faellt der starke Zaehler
// auf 0 und haelt kein schwacher Verweis mehr den Block, wird er wiederverwendbar.
fn rc_free[T: Any](h: *mut RcHeap, r: *mut RefCount[T]) {
    let addr: usize = (*r).block
    if addr == 0 as usize {
        return
    }
    (*r).block = 0 as usize
    let s: u64 = rc_ld64(addr + 0 as usize)
    if s == 0 as u64 {
        return
    }
    rc_st64(addr + 0 as usize, s - 1 as u64)
    if s - 1 as u64 == 0 as u64 && rc_ld64(addr + 8 as usize) == 0 as u64 {
        rc_block_back(h, addr)
    }
}

fn rc_strong_number[T: Any](r: RefCount[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return rc_ld64(r.block + 0 as usize)
}

fn rc_weak_number[T: Any](r: RefCount[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return rc_ld64(r.block + 8 as usize)
}

fn rc_equal[T: Any](a: RefCount[T], b: RefCount[T]) -> bool {
    return a.block == b.block
}

// Rohzugriff (SPEC §3.6): die Blockadresse bzw. die Adresse des Wertes.
// Nur fuer Werkzeuge und den Leck-Nachweis — kein Weg, 'Rc' schreibbar zu
// machen; wer hierueber schreibt, verlaesst die geprueften Typen.
fn rc_raw_address[T: Any](r: RefCount[T]) -> usize { return r.block }

// Aus einer Blockadresse wieder einen Verweis bilden, OHNE den Zaehler zu
// aendern. Nur fuer Werkzeuge: Stufe 0 kennt keine Destruktoren, deshalb
// muessen in einem Objekt gespeicherte Verweise von Hand aufgeloest werden
// (SPEC §3.6 Rohzeiger; im Endstand macht das 'drop', SPEC §3.3).
fn rc_raw_ref[T: Any](addr: usize) -> RefCount[T] {
    return RefCount[T]{ block: addr }
}
fn rc_value_address[T: Any](r: RefCount[T]) -> usize {
    if r.block == 0 as usize {
        return 0 as usize
    }
    return r.block + RC_KOPF
}

fn weak_of[T: Any](r: RefCount[T]) -> WeakRef[T] {
    if r.block == 0 as usize {
        return WeakRef[T]{ block: 0 as usize }
    }
    rc_st64(r.block + 8 as usize, rc_ld64(r.block + 8 as usize) + 1 as u64)
    return WeakRef[T]{ block: r.block }
}

fn weak_empty[T: Any]() -> WeakRef[T] {
    return WeakRef[T]{ block: 0 as usize }
}

fn weak_is_empty[T: Any](w: WeakRef[T]) -> bool {
    return w.block == 0 as usize
}

fn weak_raw_address[T: Any](w: WeakRef[T]) -> usize { return w.block }

fn weak_strong_number[T: Any](w: WeakRef[T]) -> u64 {
    if w.block == 0 as usize {
        return 0 as u64
    }
    return rc_ld64(w.block + 0 as usize)
}

// Aufwertung: liefert sichtbar den LEEREN Verweis, wenn der starke Zaehler
// bereits 0 ist (das Ziel also eingesammelt wurde).
fn promote[T: Any](w: WeakRef[T]) -> RefCount[T] {
    if w.block == 0 as usize {
        return RefCount[T]{ block: 0 as usize }
    }
    let s: u64 = rc_ld64(w.block + 0 as usize)
    if s == 0 as u64 {
        return RefCount[T]{ block: 0 as usize }
    }
    rc_st64(w.block + 0 as usize, s + 1 as u64)
    return RefCount[T]{ block: w.block }
}

fn weak_free[T: Any](h: *mut RcHeap, w: *mut WeakRef[T]) {
    let addr: usize = (*w).block
    if addr == 0 as usize {
        return
    }
    (*w).block = 0 as usize
    let s: u64 = rc_ld64(addr + 8 as usize)
    if s == 0 as u64 {
        return
    }
    rc_st64(addr + 8 as usize, s - 1 as u64)
    if s - 1 as u64 == 0 as u64 && rc_ld64(addr + 0 as usize) == 0 as u64 {
        rc_block_back(h, addr)
    }
}

// Fehlbare Allokation, ernst genommen: 'rc_neu' liefert 'AllocError!bool'
// und ist damit '#[must_consume]' (SPEC §5.1). Wer das Ergebnis wegwirft,
// bekommt einen Compilerfehler mit Zeile und Spalte.

struct Style { color: u32, size: u32, lines: i64 }

fn main() -> i32 {
    var h: RcHeap = RcHeap{
        base: 0 as usize, capacity: 0 as usize, next: 0 as usize,
        free: [0 as usize, 0 as usize, 0 as usize, 0 as usize,
               0 as usize, 0 as usize, 0 as usize, 0 as usize],
        live: 0 as usize, used: 0 as usize,
        allocations: 0 as usize, releases: 0 as usize,
    }
    if rc_heap_init(&h, 4096 as usize) == false { return 1 }
    var v: RefCount[Style] = rc_empty[Style]()
    rc_new[Style](&h, Style{ color: 1 as u32, size: 2 as u32, lines: 3 }, &v)
    return 0
}
