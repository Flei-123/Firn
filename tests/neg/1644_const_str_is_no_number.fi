// expect_error: 9:31 the length of a repetition literal must be an integer, found str
// ROUND FIRN-ENV -- `consts` carries a 0 for a text constant so that the
// name is taken. Handing THAT out where a NUMBER is wanted would turn
// `[0 as u8; NAME]` into an empty array without a word: the type check
// stops it first, and `eval_const` says the same thing behind it
// ("'NAME' is a text constant and is not a number here").
const NAME: str = "abc"

static B: [u8; 3] = [0 as u8; NAME]

fn main() -> i32 {
    return 0
}
