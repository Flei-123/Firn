// expect_error: 8:18 operator '%' is not defined for f32
// `%` would be `fmod` and needs a library function -- the same rule that
// has held for f64 since round 11 (SPEC 14.1.f64), now for the second
// width. `math.fmod` is one call away.
fn main() -> i32 {
    let a: f32 = 1.5
    let b: f32 = 2.5
    let c: f32 = a % b
    let _ = c
    return 0
}
