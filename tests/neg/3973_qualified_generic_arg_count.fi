// expect_error: 10:13 generic function 'twice' expects 1 type argument(s), found 2
import modules.qgen

// a local template (keeps the generics-free AST dump of parser_compare out)
fn local_id[T](a: T) -> T {
    return a
}

fn main() -> i32 {
    let x = qgen.twice[i32, u8](1 as i32)
    return x
}
