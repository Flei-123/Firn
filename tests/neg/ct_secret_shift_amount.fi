// expect_error: 7:25 the shift amount of '<<' must not be a secret value, found secret[u8]
// ROUND 96: the shifted VALUE may be secret, the shift AMOUNT may not --
// a variable shift is not constant time on every processor.
fn main() -> i32 {
    var a: secret[u8] = 200
    var n: secret[u8] = 3
    let c: secret[u8] = a << n
    return declassify(c) as i32
}
