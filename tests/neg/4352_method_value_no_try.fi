// expect_error: 12:13 used as a value without a call needs `try`
// tests/neg/4352_method_value_no_try.fi -- r750: a bound method value allocates a closure record: `try` is required.
struct Acc { n: i32 }

impl Acc {
    fn get(*mut self) -> i32 { return (*self).n }
}

fn main() -> i32 {
    var a: Acc = Acc { n: 1 }
    let p: *mut Acc = &a
    let f = p.get
    return 0
}
