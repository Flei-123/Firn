// expect_error: 17:35 'schritt' ist #[no_gc], ruft aber 'protokoll' ohne #[no_gc]
// expect_error_count: 1
// Der Verstoss steckt im Rumpf eines 'match'-Falles. Diese Bloecke liegen
// nicht im AST, sondern in der Registrierung von sema_match.rs — ohne den
// Abstieg dorthin waere jede Zustandsmaschine ein blinder Fleck, also genau
// der Code, fuer den #[no_gc] gedacht ist.
enum Zustand { Anfang, Ende }

fn protokoll(c: i32) -> i32 {
    return c
}

#[no_gc]
fn schritt(z: Zustand, c: i32) -> i32 {
    match z {
        Zustand::Anfang => { return c * 2 as i32 }
        Zustand::Ende => { return protokoll(c) }
    }
}

fn main() -> i32 {
    return schritt(Zustand::Anfang, 0 as i32)
}
