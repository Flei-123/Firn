// expect_error: 9:13 'try' liefert fehler der menge 'F', die funktion liefert fehler der menge 'E'
// Die Fehlermengen stimmen nicht ueberein.
error E { A }
error F { B }

fn g() -> F!i32 { return F::B }

fn f() -> E!i32 {
    let v = try g()
    return v
}

fn main() -> i32 {
    return f() catch 0
}
