// expect_error: 10:20 'a' is moved in only one branch
struct Guard { id: i64 }

impl Guard { fn drop(inout self) { self.id = 0 } }

fn main() -> i32 {
    let a: Guard = Guard { id: 1 }
    let b: Guard = Guard { id: 2 }
    let c: bool = true
    let r: Guard = if c { a } else { b }
    return 0
}
