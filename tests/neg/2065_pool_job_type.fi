// expect_error: 12:21 argument 2 of 'pool__submit' has type fn(i32, i32) -> i32, expected fn(u64) -> u64
// A job is `fn(u64) -> u64`. A function with another signature is refused at
// compile time, not called with the wrong arguments on a worker thread.
import std.pool

fn wrong(a: i32, b: i32) -> i32 {
    return a + b
}

fn main() -> i32 {
    var p: pool.Pool = pool.Pool { blk: 0 }
    pool.submit(&p, wrong, 1)
    return 0
}
