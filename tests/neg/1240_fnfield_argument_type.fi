// expect_error: 10:22 argument 2 of 'Ctx.hook' has type bool, expected i32
// ROUND 68: the argument types of a function value in a field are checked
// against the signature of the field, and the message names the field the
// way a method is named.
struct Ctx { hook: fn(i32, i32) -> i32 }
fn add(a: i32, b: i32) -> i32 { return a + b }
fn main() -> i32 {
    var c: Ctx = Ctx { hook: add }
    let t: bool = true
    return c.hook(1, t)
}
