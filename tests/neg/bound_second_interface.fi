// expect_error: 28:12 es fehlt 'fn zeige(*self) -> i64'
// expect_error_count: 1
// Zwei Schnittstellenschranken, die zweite nicht erfuellt. Die Meldung nennt
// genau die Methode, die in `impl Anzeige for Punkt` stehen muesste.
interface Order {
    fn less(*self, b: *Self) -> bool
}

interface Display {
    fn show(*self) -> i64
}

struct Dot { x: i64 }

impl Order for Dot {
    fn less(*self, b: *Dot) -> bool { return (*self).x < (*b).x }
}

fn f[T: Order + Display](a: *T) -> i64 {
    if a.less(a) {
        return 0
    }
    return a.show()
}

fn main() -> i32 {
    var p: Dot = Dot{ x: 1 }
    return f[Dot](&p) as i32
}
