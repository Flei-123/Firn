// expect_error: 28:12 'fn show(*self) -> i64' is missing in 'impl Display for Dot { … }'
// expect_error_count: 1
// stand. The message says exactly that instead of "no impl found".
// Two interface bounds, the second one not satisfied. The message names
interface Order {
    fn less(*self, b: *Self) -> bool
}

interface Display {
    fn show(*self) -> i64
}

struct Dot { x: i64 }

impl Order for Dot {
    fn less(*self, b: *Dot) -> bool { return (*self).x < (*b).x }
}

fn f[T: Order + Display](a: *T) -> i64 {
    if a.less(a) {
        return 0
    }
    return a.show()
}

fn main() -> i32 {
    var p: Dot = Dot { x: 1 }
    return f[Dot](&p) as i32
}
