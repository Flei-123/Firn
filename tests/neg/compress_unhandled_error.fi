// expect_error: 14:20 expected type usize, found CompressError!usize
// tests/neg/compress_unhandled_error.fi -- the error union of the compression
// modules cannot be used as a plain size: it has to be tried or caught.
import compress.lz4
import std.rt

fn f(out: *mut rt.Buf) -> CompressError!usize {
    let n: usize = try lz4.lz4_frame_decompress(0, 0, out)
    return n
}

fn main() -> i32 {
    var out: rt.Buf = rt.buf_new()
    let n: usize = f(&out)
    return n as i32
}
