// expect_error: 5:29 a closure literal inside a generic function is not supported
fn apply(f: fn(i32) -> i32, x: i32) -> i32 { return f(x) }

fn build[T: Int](x: T) -> i32 {
    let f: fn(i32) -> i32 = fn(a: i32) -> i32 { return a + 1 }
    return apply(f, 1)
}

fn main() -> i32 {
    return build[i32](2)
}
