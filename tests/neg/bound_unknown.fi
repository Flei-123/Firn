// expect_error: 16:12 unknown interface 'Ordr' as bound on the type parameter 'T' of 'f'
// expect_error_count: 1
// does not know the difference.
// A bound that is not an interface. Because `Bound::parse` takes every
// unknown name as an interface name (an `interface`
// declaration may come later), the typo only shows up at the
interface Order {
    fn less(*self, b: *Self) -> bool
}

fn f[T: Ordr](a: T) -> T {
    return a
}

fn main() -> i32 {
    return f[i32](0)
}
