// expect_error: 16:12 unknown interface 'Ordr' as bound on the type parameter 'T' of 'f'
// expect_error_count: 1
// Eine Schranke, die keine Schnittstelle ist. Weil `Bound::parse` jeden
// unbekannten Namen als Schnittstellennamen nimmt (eine `interface`-
// Deklaration darf spaeter stehen), faellt der Tippfehler erst bei der
// Auspraegung auf — dafuer mit der Liste der bekannten Namen.
interface Order {
    fn less(*self, b: *Self) -> bool
}

fn f[T: Ordr](a: T) -> T {
    return a
}

fn main() -> i32 {
    return f[i32](0)
}
