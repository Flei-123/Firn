// expect_error: 6:34 '__atomic_swap' expects a *mut u64 as first argument, found *mut u32
// ROUND 49: the compare and swap works on exactly one 64-bit word.
// A *mut u32 would silently swap the wrong width.
fn main() -> i32 {
    var t: u32 = 0
    let old: u64 = __atomic_swap(&t, 0, 1)
    return old as i32
}
