// expect_error: 6:38 '__atomic_swap' erwartet als erstes argument einen *mut u64, gefunden *mut u32
// RUNDE 49: der Vergleichs-Tausch arbeitet auf genau einem 64-Bit-Wort.
// Ein *mut u32 wuerde stillschweigend die falsche Breite tauschen.
fn main() -> i32 {
    var t: u32 = 0
    let old: u64 = __atomic_swap(&t, 0, 1)
    return old as i32
}
