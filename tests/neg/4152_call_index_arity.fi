import std.rt
import std.vec

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[fn(i64) -> i64] = vec_new[fn(i64) -> i64]()
    let x: i64 = v[0](1, 2)
    return 0
}
