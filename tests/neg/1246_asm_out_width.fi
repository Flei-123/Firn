// expect_error: 7:34 the output operand for 'rax' points at u32, that is not eight octets wide
// ROUND 68: an output operand always writes the WHOLE register. A narrower
// target would have its neighbour in the frame overwritten silently, so the
// type checker refuses it instead.
fn main() -> i32 {
    var a: u32 = 0
    asm("mov rax, 1", out("rax") & a)
    return 0
}
