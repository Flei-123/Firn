// expect_error: 5:5 the address of the local 'x' escapes through the pointer 'out'
// r899: storing the address of a local through an out pointer is rejected.
fn leak(out: *mut *mut i64) {
    var x: i64 = 5
    *out = &x
}

fn main() -> i32 {
    var p: *mut i64 = 0 as *mut i64
    leak(&p)
    return 0
}
