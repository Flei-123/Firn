// expect_error: 10:20 cannot move a field out of its owner
struct Guard { id: i64 }

impl Guard { fn drop(inout self) { self.id = 0 } }

struct Pair { a: Guard, b: Guard }

fn main() -> i32 {
    let p: Pair = Pair { a: Guard { id: 1 }, b: Guard { id: 2 } }
    let x: Guard = p.a
    return x.id as i32
}
