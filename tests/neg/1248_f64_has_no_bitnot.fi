// expect_error: 7:18 unary '~' expects an integer type, found f64
// ROUND 68: `-x` works on an `f64` from this round on, `~x` does not. A
// floating point value has no bits whose flipping would mean anything --
// whoever wants that goes through the bit pattern (`math_bits`).
fn main() -> i32 {
    let a: f64 = 1.5
    let b: f64 = ~a
    if b > 0.0 { return 1 }
    return 0
}
