// expect_error: 8:5 the address of the local 'x' escapes through the return value
// ROUND 79: gap 9 of docs/ROUND66.md. A raw pointer into a local used to
// leave its frame without the compiler saying a word; since round 79 it is
// an error at COMPILE TIME (compiler/src/escape.rs, lib/firnc1/escape.fi).
// The whole set of cases stands in tools/escape/.
fn bad() -> *mut i64 {
    var x: i64 = 5
    return &x
}

fn main() -> i32 {
    let p: *mut i64 = bad()
    return (*p) as i32
}
