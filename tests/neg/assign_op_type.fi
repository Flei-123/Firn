// expect_error: 7:5 operator '+' expects two operands of the same integer type, found i32 and i64
// ROUND 70: there is no implicit conversion in a compound assignment either.
// `x += y` is `x = x + y`, and that is where it fails.
fn main() -> i32 {
    var x: i32 = 1
    let y: i64 = 2
    x += y
    return x
}
