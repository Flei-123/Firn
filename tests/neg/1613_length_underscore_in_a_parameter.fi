// expect_error: 6:18 the length '_' needs an initializer to be taken from
// ROUND 79 (gap 10 of docs/ROUND66.md): `_` works where there is something
// to take the length from -- a `let`/`var` with a literal. A parameter has
// no initializer, so the number has to be written out. Caught rather than
// silently turned into an array of 2^64 elements.
fn first(a: [u8; _]) -> u8 {
    return a[0]
}

fn main() -> i32 {
    var m: [u8; 3] = "abc"
    return first(m) as i32
}
