// expect_error: 11:27 may not be read here
// ROUND FIRN-ENV -- the allow list. A translator that writes ARBITRARY
// environment into the binary is a way to get a build machine's secrets
// into a program that gets shipped. Only `FIRN_` is permitted without an
// option; everything else the BUILD has to allow with `--env-allow=`.
//
// The refusal does not depend on whether `PATH` happens to be set: an
// error that came and went with the environment would be a second way for
// two builds to differ without anybody noticing.
fn main() -> i32 {
    let s: str = __env_or("PATH", "none")
    return 0
}
