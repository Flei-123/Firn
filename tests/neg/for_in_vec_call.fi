// expect_error: 9:14 'for ... in' needs an array variable
// r664: the loop reads the sequence twice, so it must be a name or a field path.
import std.vec

fn make() -> Vec[i32] { return vec_new[i32]() }

fn main() -> i32 {
    var s: i32 = 0
    for x in make() {
        s += x
    }
    return s
}
