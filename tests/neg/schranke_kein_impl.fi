// expect_error: 28:21 typ 'Kreis' setzt die schnittstelle 'Ordnung' nicht um
// expect_error_count: 1
// Der Regelfall: ein Typ ohne `impl`. Gemeldet wird an der AUSPRAEGUNG, und
// die Meldung nennt die Methode, die fehlen wuerde — nicht "unbekannte
// methode 'kleiner'" mitten in einer ausgepraegten Kopie von `kleineres`.
interface Ordnung {
    fn kleiner(*self, b: *Self) -> bool
}

struct Punkt { x: i64 }

struct Kreis { r: i64 }

impl Ordnung for Punkt {
    fn kleiner(*self, b: *Punkt) -> bool { return (*self).x < (*b).x }
}

fn kleineres[T: Ordnung](a: *T, b: *T) -> *T {
    if a.kleiner(b) {
        return a
    }
    return b
}

fn main() -> i32 {
    var a: Kreis = Kreis{ r: 1 }
    var b: Kreis = Kreis{ r: 2 }
    let k: *Kreis = kleineres[Kreis](&a, &b)
    return (*k).r as i32
}
