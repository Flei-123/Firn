// expect_error: 9:15 'A' and 'B' are not related
// SPEC §4.4: `.as?[T]` prueft nur innerhalb einer Vererbungskette.
gc class A { x: u32 }

gc class B { y: u32 }

fn main() -> i32 {
    let a = gc A{ x: 1 } catch gc_null[A]()
    let b = a.as?[B]
    if b == gc_null[B]() {
        return 1
    }
    return 0
}
