// Die Stelligkeit wird OHNE den Empfaenger genannt: `setze_x` nimmt ein
// Argument, nicht zwei.
struct Punkt { x: i32, y: i32 }

impl Punkt {
    fn setze_x(*mut self, x: i32) { (*self).x = x }
}

fn main() -> i32 {
    var p: Punkt = Punkt{ x: 1, y: 2 }
    p.setze_x(1, 2)
    return 0
}
