// expect_error: 9:1 attribute 'unwinds' is not implemented in stage 0
// ROUND 96 -- successor of tests/neg/attr_not_implemented.fi, which asked
// for `#[constant_time]` and was answered by this round (attrs.rs now lists
// it as implemented, lower.rs switches the check in the code generator on).
//
// The guard stays, on the next attribute of the register that is known and
// planned but NOT built: silently dropping an attribute would be the most
// dangerous kind of error this language can have.
#[unwinds]
fn may_throw(a: i32) -> i32 {
    return a
}

fn main() -> i32 {
    return may_throw(0)
}
