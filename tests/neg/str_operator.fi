// expect_error: 7:18 operator '-' is not defined for the type str
// ROUND 70: `str` knows `==`, `!=` and `+`. Everything else is a question
// for the library (std.str), not for an operator.
fn main() -> i32 {
    let a: str = "ab"
    let b: str = "cd"
    let c: str = a - b
    return c.n as i32
}
