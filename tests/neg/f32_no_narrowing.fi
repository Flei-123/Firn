// expect_error: 10:18 expected type f32, found f64
// THE ONE IMPLICIT CONVERSION GOES ONE WAY (round 71, SPEC 8.6).
//
// f32 -> f64 loses nothing and is therefore allowed without `as`. The other
// way round digits fall away, and the language does not do that silently --
// `a as f32` says it out loud. That is the whole rule; there is no second
// implicit conversion in Firn.
fn main() -> i32 {
    let a: f64 = 1.5
    let b: f32 = a
    let _ = b
    return 0
}
