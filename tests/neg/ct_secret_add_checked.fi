// expect_error: 10:25 operator '+' is not allowed on a secret value
// ROUND 96 -- the find of the round. At `dev`, `dev-fast` and
// `release-safe` a `+` carries an overflow test, and that test is a
// CONDITIONAL JUMP on a flag that came out of secret operands. The type
// check refuses it at EVERY build level, so that a program cannot compile
// at one level and leak at another.
fn main() -> i32 {
    var a: secret[u8] = 200
    var b: secret[u8] = 100
    let c: secret[u8] = a + b
    return declassify(c) as i32
}
