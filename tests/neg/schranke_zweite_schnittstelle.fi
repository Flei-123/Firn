// expect_error: 28:12 es fehlt 'fn zeige(*self) -> i64'
// expect_error_count: 1
// Zwei Schnittstellenschranken, die zweite nicht erfuellt. Die Meldung nennt
// genau die Methode, die in `impl Anzeige for Punkt` stehen muesste.
interface Ordnung {
    fn kleiner(*self, b: *Self) -> bool
}

interface Anzeige {
    fn zeige(*self) -> i64
}

struct Punkt { x: i64 }

impl Ordnung for Punkt {
    fn kleiner(*self, b: *Punkt) -> bool { return (*self).x < (*b).x }
}

fn f[T: Ordnung + Anzeige](a: *T) -> i64 {
    if a.kleiner(a) {
        return 0
    }
    return a.zeige()
}

fn main() -> i32 {
    var p: Punkt = Punkt{ x: 1 }
    return f[Punkt](&p) as i32
}
