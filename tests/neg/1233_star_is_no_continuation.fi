// expect_error: 9:5 dereference expects a pointer, found i32
// ROUND 68, the counter-check to the line continuation: `*` at the start of
// a line is a DEREFERENCE, never a multiplication of the line before. If it
// continued, `*b` here would silently become `3 * b` and every `*p = 0` in
// the kernel would change its meaning.
fn main() -> i32 {
    let a: i32 = 2
    let b: i32 = 3
    *b
    return a
}
