// expect_error: 15:12 expected AllocError!Gc[Elem] (success value Gc[Elem] or an error of the set 'AllocError'), found Gc[Node]
// ROUND 68, the counter-check to the free upcast: it goes UPWARD only.
// A base pointer does not fit into an error union over the derived type --
// downwards runs exclusively through the checked `x.as?[C]`.
gc class Node {
    id: u32,
}

gc class Elem extends Node {
    tag: u32,
}

fn wrong() -> AllocError!Gc[Elem] {
    let n: Gc[Node] = try gc Node { id: 1 }
    return n
}

fn main() -> i32 {
    let e: Gc[Elem] = wrong() catch gc_null[Elem]()
    if e == gc_null[Elem]() {
        return 1
    }
    return 0
}
