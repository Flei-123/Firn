// expect_error: 7:27 has to be a text literal
// ROUND FIRN-ENV -- the name is read while PARSING, so it has to stand
// there. An intrinsic that took a computed name would need a second, half
// interpreter; `comptime` is where that belongs.
fn main() -> i32 {
    let n: str = "FIRN_X"
    let s: str = __env_or(n, "none")
    return 0
}
