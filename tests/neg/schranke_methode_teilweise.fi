// expect_error: 24:8 es fehlt 'fn gleich(*self, *Self) -> bool'
// expect_error_count: 1
// Der Typ hat EINE der beiden Methoden (aus einem gewoehnlichen `impl`-Block),
// aber keinen `impl Ordnung for`-Block. Die Meldung zaehlt nur die Methode
// auf, die wirklich fehlt — sie liest die Funktionsnamen des Programms, statt
// pauschal "setzt nicht um" zu sagen.
interface Ordnung {
    fn kleiner(*self, b: *Self) -> bool
    fn gleich(*self, b: *Self) -> bool
}

struct Punkt { x: i64 }

impl Punkt {
    fn kleiner(*self, b: *Punkt) -> bool { return (*self).x < (*b).x }
}

fn f[T: Ordnung](a: *T) -> bool {
    return a.kleiner(a)
}

fn main() -> i32 {
    var p: Punkt = Punkt{ x: 1 }
    if f[Punkt](&p) {
        return 1
    }
    return 0
}
