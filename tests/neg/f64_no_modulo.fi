// expect_error: 6:18 operator '%' is not defined for f64
// There is no implicit conversion between integer and floating point.
// '%' would be fmod and needs a library function; the bit operations
fn main() -> i32 {
    let a: f64 = 5.5
    let b: f64 = a % 2.0
    if b != 1.5 {
        return 1
    }
    return 0
}
