// expect_error: 6:18 operator '%' is not defined for f64
// '%' waere fmod und braucht eine Bibliotheksfunktion; die Bitoperationen
// haetten auf einem Bitmuster keine sinnvolle Bedeutung.
fn main() -> i32 {
    let a: f64 = 5.5
    let b: f64 = a % 2.0
    if b != 1.5 {
        return 1
    }
    return 0
}
