// expect_error: 7:5 operator '%' is not defined for f64
// ROUND 70: `x %= e` is exactly `x = x % e` -- including the rule that `%`
// is not defined for f64 (it would be `fmod` and needs a library function).
// The message comes out of the very same place as the one for `%`.
fn main() -> i32 {
    var x: f64 = 5.5
    x %= 2.0
    return 0
}
