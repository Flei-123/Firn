// Argumente einer Methode werden wie die jeder anderen Funktion geprueft —
// gezaehlt wird OHNE den Empfaenger: `p.setze_x(w)` hat EIN Argument.
struct Punkt { x: i32, y: i32 }

impl Punkt {
    fn setze_x(*mut self, x: i32) { (*self).x = x }
}

fn main() -> i32 {
    var p: Punkt = Punkt{ x: 1, y: 2 }
    p.setze_x(true)
    return 0
}
