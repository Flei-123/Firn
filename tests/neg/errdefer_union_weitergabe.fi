// expect_error: 15:5 'errdefer' und die weitergabe einer fertigen fehlerunion
// Ehrliche Grenze der Stufe 0 (SPEC §14.1 F5): bei der Weitergabe einer
// FERTIGEN Fehlerunion steht erst zur Laufzeit fest, ob der Fehlerpfad
// genommen wird. Statt 'errdefer' still zu uebergehen, wird der Fall
// abgelehnt.
error E { Broken }

fn source() -> E!i32 {
    return 1
}

fn next() -> E!i32 {
    errdefer cleanup()
    let u: E!i32 = source()
    return u
}

fn cleanup() {}

fn main() -> i32 {
    return next() catch 0
}
