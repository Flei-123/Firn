// Module 'math' -- imported by tests/110_module.fi.
// Only 'square' and 'DREI' are visible from outside.
export { square, DREI, Dot }

const DREI: i32 = 3
const GEHEIM: i32 = 99

struct Dot { x: i32, y: i32 }

fn square(a: i32) -> i32 {
    return a * a
}

// Not needed from outside, but it calls the module's own constant.
fn intern() -> i32 {
    return GEHEIM
}
