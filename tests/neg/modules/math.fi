// Modul 'mathe' — wird von tests/110_module.fi eingebunden.
// Nur 'quadrat' und 'DREI' sind nach aussen sichtbar.
export { square, DREI, Dot }

const DREI: i32 = 3
const GEHEIM: i32 = 99

struct Dot { x: i32, y: i32 }

fn square(a: i32) -> i32 {
    return a * a
}

// Wird von aussen nicht gebraucht, ruft aber die eigene Konstante auf.
fn intern() -> i32 {
    return GEHEIM
}
