// expect_error_count: 1
// ROUND 88: the note under "type 'str' has no method 'prat'" used to print
// EVERY name the type had -- over 200 in one line, with the one that was
// meant somewhere in the middle. Now the five closest come first (edit
// distance, ties by the longer common beginning, then alphabetically) and
// the rest is counted.
import std.str

fn main() -> i32 {
    let a: str = "hello"
    let b = a.prat(0, 1)
    return b.length() as i32
}
