// expect_error: 11:23 an interface value is made from a pointer, found i64
// expect_error_count: 1
// An interface value comes from a pointer to a struct -- not
// from a number.
interface Area {
    fn area(*self) -> i64
}

fn main() -> i32 {
    let x: i64 = 5
    let f: dyn Area = x as dyn Area
    return 0
}
