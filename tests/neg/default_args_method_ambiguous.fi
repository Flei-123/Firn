// expect_error: 12:12 the method 'm' needs default or named arguments but exists on several types
struct A { v: i32 }
struct B { v: i32 }
impl A {
    fn m(self, a: i32 = 1) -> i32 { return self.v + a }
}
impl B {
    fn m(self, a: i32, b: i32 = 2) -> i32 { return self.v + a + b }
}
fn main() -> i32 {
    let s: A = A { v: 1 }
    return s.m()
}
