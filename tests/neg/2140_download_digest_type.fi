// expect_error: 8:90 argument 5 of 'download__dl_add' has type u32, expected str
// The digest of an item is TEXT (hex): a number is not a digest.
import std.hashfile
import net.download

fn main() -> i32 {
    var d: download.Dl = download.dl_new(1)
    let i: i64 = download.dl_add(&d, "http://127.0.0.1/x", "/tmp/x", hashfile.HASH_SHA1, 1234 as u32, 0 as u64)
    return i as i32
}
