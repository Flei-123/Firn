// expect_error: 18:27 'Punkt' setzt die schnittstelle 'Flaeche' nicht um
// expect_error_count: 1
// Ein Typ, der die Schnittstelle nicht umsetzt, wird auch nicht zu einem
// Schnittstellenwert. Es gibt keine Methodentafel, die man anhaengen koennte.
interface Flaeche {
    fn flaeche(*self) -> i64
}

struct Kreis { r: i64 }
struct Punkt { x: i64 }

impl Flaeche for Kreis {
    fn flaeche(*self) -> i64 { return (*self).r }
}

fn main() -> i32 {
    var p: Punkt = Punkt{ x: 1 }
    let f: dyn Flaeche = (&p) as dyn Flaeche
    return 0
}
