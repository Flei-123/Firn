// expect_error: 23:14 the interface 'Area' has no method 'extent'
// expect_error_count: 1
// Through an interface value ONLY what stands in the interface is reachable
// -- even when the concrete type can do more. Otherwise the table would
// not be the whole truth.
interface Area {
    fn area(*self) -> i64
}

struct Circle { r: i64 }

impl Area for Circle {
    fn area(*self) -> i64 { return (*self).r }
}

impl Circle {
    fn extent(*self) -> i64 { return 6 * (*self).r }
}

fn main() -> i32 {
    var k: Circle = Circle { r: 1 }
    let f: dyn Area = (&k) as dyn Area
    return f.extent() as i32
}
