interface Order {
    fn less(*self, b: *Self) -> bool
}

struct Circle { r: i64 }

struct Pair[T: Order] {
    a: T,
    b: T,
}

fn main() -> i32 {
    var p: Pair[Circle] = Pair[Circle]{ a: Circle{ r: 1 }, b: Circle{ r: 2 } }
    return p.a.r as i32
}
