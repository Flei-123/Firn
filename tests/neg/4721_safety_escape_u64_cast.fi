// expect_error: 6:5 the address of the local 'x' escapes through the return value
// r899: laundering the address of a local through 'as u64' does not hide it from the escape check.
fn addr() -> u64 {
    var x: i64 = 5
    let a: u64 = (&x) as u64
    return a
}

fn main() -> i32 {
    let a: u64 = addr()
    return 0
}
