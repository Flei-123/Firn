// expect_error: 7:25 operator '/' is not allowed on a secret value
// ROUND 96 (SPEC 9.1): a division takes a different amount of time for
// different operands, on every processor this compiler emits for.
fn main() -> i32 {
    var a: secret[u8] = 200
    var b: secret[u8] = 3
    let c: secret[u8] = a / b
    return declassify(c) as i32
}
