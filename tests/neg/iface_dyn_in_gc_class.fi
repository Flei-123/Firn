// expect_error: 13:5 field type dyn Area is not allowed in a gc class
// expect_error_count: 1
// An interface value must not lie on the heap: the collector traces there
// PRECISELY along the field layout (SPEC 3.5.3) and does not know the data
// pointer behind `dyn`. A hole in this promise would be worse than a
// missing convenience (docs/ROUND46.md).
interface Area {
    fn area(*self) -> i64
}

gc class Node {
    value: i64,
    f: dyn Area,
}

fn main() -> i32 {
    return 0
}
