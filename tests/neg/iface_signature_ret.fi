// expect_error: 11:6 'Circle.area' returns i32, the interface 'Area' requires i64
// expect_error_count: 1
// The method is there but yields the wrong type. An interface is
// a contract about the SIGNATURE, not about the name.
interface Area {
    fn area(*self) -> i64
}

struct Circle { r: i64 }

impl Area for Circle {
    fn area(*self) -> i32 { return 1 }
}

fn main() -> i32 {
    return 0
}
