// expect_error: 6:15 comptime: '/etc/passwd' ist ein absoluter pfad
// Uebersetzungszeit-Dateizugriff ist ein Einfallstor fuer Lieferketten-
// Angriffe. Deshalb: nur relativ zur Quelldatei (DESIGNZIELE §3).
comptime {
    emit_raw("const X: i64 = ")
    emit_number(file_size("/etc/passwd"))
    emit_raw("\n")
}

fn main() -> i32 {
    return X as i32
}
