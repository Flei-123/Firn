// expect_error: 6:17 comptime: '/etc/passwd' is an absolute path — only paths relative to the source file are allowed
// Uebersetzungszeit-Dateizugriff ist ein Einfallstor fuer Lieferketten-
// Angriffe. Deshalb: nur relativ zur Quelldatei (DESIGN_GOALS §3).
comptime {
    emit_raw("const X: i64 = ")
    emit_number(file_size("/etc/passwd"))
    emit_raw("\n")
}

fn main() -> i32 {
    return X as i32
}
