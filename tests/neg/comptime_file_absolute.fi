// expect_error: 6:17 comptime: '/etc/passwd' is an absolute path — only paths relative to the source file are allowed
// A comptime run must not hang the compiler.
// Compile-time file access is a way in for supply chain
comptime {
    emit_raw("const X: i64 = ")
    emit_number(file_size("/etc/passwd"))
    emit_raw("\n")
}

fn main() -> i32 {
    return X as i32
}
