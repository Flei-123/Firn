// expect_error: 9:12 the function value 'Ctx.hook' of type fn(i32, i32) -> i32 expects 2 argument(s), found 1
// ROUND 68: a function value in a field is checked like every other one --
// the arity is counted WITHOUT the receiver, because the receiver is no
// argument here but only the place the value is read from.
struct Ctx { hook: fn(i32, i32) -> i32 }
fn add(a: i32, b: i32) -> i32 { return a + b }
fn main() -> i32 {
    var c: Ctx = Ctx { hook: add }
    return c.hook(1)
}
