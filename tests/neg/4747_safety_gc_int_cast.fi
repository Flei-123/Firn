// expect_error: 5:18 conversion from Gc[Target] to u64 is not allowed
// Safety (N13): a Gc[T] cannot be cast to an integer, the integer would not be a collector root.
gc class Target { v: u64 }

fn main() -> i32 {
    let t = gc Target { v: 5 } catch gc_null[Target]()
    let a: u64 = t as u64
    return a as i32
}
