// expect_error: 7:18 '__atomic_add' expects exactly two arguments (pointer, addend), found 1
// ROUND 47 -- wrong number of digits at the atomic primitive. The message
// names the agreed form so that one does not have to guess.

fn main() -> i32 {
    var z: u64 = 5
    let a: u64 = __atomic_add(&z)
    if a == 0 {
        return 1
    }
    return 0
}
