// expect_error: 7:18 '__atomic_add' expects exactly two arguments (pointer, addend), found 1
// RUNDE 47 — falsche Stellenzahl beim atomaren Primitiv. Die Meldung nennt
// die vereinbarte Form, damit man nicht raten muss.

fn main() -> i32 {
    var z: u64 = 5
    let a: u64 = __atomic_add(&z)
    if a == 0 {
        return 1
    }
    return 0
}
