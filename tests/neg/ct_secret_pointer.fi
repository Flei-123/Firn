// expect_error: 6:12 'secret[T]' works on integer and bool types only, found *mut u8
// ROUND 96: an ADDRESS is public by nature -- what leaks about a pointer
// is where it points, and that is not something the marking can hide.
// A pointer TO a secret is written `*mut secret[u8]` and is allowed.
fn main() -> i32 {
    var p: secret[*mut u8] = 0 as *mut u8
    return 0
}
