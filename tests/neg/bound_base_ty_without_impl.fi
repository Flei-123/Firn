// expect_error: 21:8 type 'u8' does not implement the interface 'Order' — bound on the type parameter 'T' of 'f'
// expect_error_count: 1
// A BASIC TYPE without an implementation. Since round 50 `i32` may implement
// an interface -- it does not do so automatically. The message names the
// method that would have to stand in `impl Order for u8`.
interface Order {
    fn less(*self, b: *Self) -> bool
}

impl Order for i32 {
    fn less(*self, b: *i32) -> bool { return *self < *b }
}

fn f[T: Order](a: *T, b: *T) -> bool {
    return a.less(b)
}

fn main() -> i32 {
    var x: u8 = 1
    var y: u8 = 2
    if f[u8](&x, &y) {
        return 1
    }
    return 0
}
