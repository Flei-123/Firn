// expect_error: 13:6 parameter 1 von 'Dot.less' hat typ *i64, die schnittstelle 'Order' verlangt *Punkt
// expect_error_count: 1
// Der `impl`-Block ist da, aber die Signatur passt nicht: `Self` steht in der
// Schnittstelle fuer den umsetzenden Typ, hier also fuer `*Punkt`. Diese
// Pruefung gehoert dem Typpruefer (`iface::pruefe_umsetzung`) — die Schranke
// selbst ist erfuellt, es GIBT ja einen Block.
interface Order {
    fn less(*self, b: *Self) -> bool
}

struct Dot { x: i64 }

impl Order for Dot {
    fn less(*self, b: *i64) -> bool { return (*self).x < *b }
}

fn main() -> i32 {
    return 0
}
