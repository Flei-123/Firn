// expect_error: 13:6 parameter 1 of 'Dot.less' has type *i64, the interface 'Order' requires *Dot
// expect_error_count: 1
// points at the way that does work -- the bound.
// The `impl` block is there, but the signature does not fit: `Self` stands in
// the interface for the implementing type, so here for `*Dot`. This
// check belongs to the type checker (`iface::check_impl`) -- the bound
interface Order {
    fn less(*self, b: *Self) -> bool
}

struct Dot { x: i64 }

impl Order for Dot {
    fn less(*self, b: *i64) -> bool { return (*self).x < *b }
}

fn main() -> i32 {
    return 0
}
