// expect_error: 7:21 floating point (the type f32) is allowed in profile 'kernel' only with #[allow_fp]
// In the kernel the FPU/SSE registers belong to the interrupted thread
// (SPEC 2). The rule has held for f64 since round 52 and holds for f32 in
// exactly the same way -- a second width is not a second permission.
profile kernel

fn scale(x: f32) -> f32 {
    return x * 2.0
}
