// expect_error: 11:12 'hot' is #[no_gc], but calls 'slow' without #[no_gc]
// expect_error_count: 1
// Rule (ii) from SPEC 3.5.4: a #[no_gc] function must not call a function
// that does not carry the promise -- otherwise the promise would be worthless.
fn slow(a: i32) -> i32 {
    return a + 1 as i32
}

#[no_gc]
fn hot(a: i32) -> i32 {
    return slow(a)
}

fn main() -> i32 {
    return hot(0 as i32)
}
