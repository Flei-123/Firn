// expect_error: 11:12 ist #[no_gc], ruft aber 'langsam' ohne #[no_gc]
// expect_error_count: 1
// Regel (ii) aus SPEC §3.5.4: eine #[no_gc]-Funktion darf keine Funktion
// rufen, die die Zusage nicht traegt — sonst waere die Zusage wertlos.
fn slow(a: i32) -> i32 {
    return a + 1 as i32
}

#[no_gc]
fn hot(a: i32) -> i32 {
    return slow(a)
}

fn main() -> i32 {
    return hot(0 as i32)
}
