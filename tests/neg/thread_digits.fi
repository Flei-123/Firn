// expect_error: 5:18 '__thread_start' expects exactly three arguments (argument, stack, tid word), found 2
// ROUND 49: the number of digits of the thread primitive. The message names
// the agreed form, otherwise one would have to look it up in the compiler.
fn main() -> i32 {
    let r: i64 = __thread_start(1, 2)
    return r as i32
}
