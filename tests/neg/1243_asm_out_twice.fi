// expect_error: 8:5 the register 'rax' is an output operand twice
// ROUND 68: several output operands are allowed -- but each one needs a
// register of its own. Two outputs on the same register would lose one of
// the two results without a word being said.
fn main() -> i32 {
    var a: u64 = 0
    var b: u64 = 0
    asm("mov rax, 1", out("rax") & a, out("rax") & b)
    return 0
}
