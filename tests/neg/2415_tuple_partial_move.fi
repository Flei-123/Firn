// expect_error: 19:10 cannot move a field out of its owner
// Round TUPLES and ownership: `let (a, b)` would move the elements out of the
// tuple one by one; partial moves do not exist (SPEC 3.3).
static mut LOG: i64 = 0

struct Guard { id: i64 }

impl Guard {
    fn drop(inout self) {
        LOG = LOG * 10 + self.id
    }
}

fn pair() -> (Guard, Guard) {
    return (Guard { id: 1 }, Guard { id: 2 })
}

fn main() -> i32 {
    let (x, y) = pair()
    return 0
}
