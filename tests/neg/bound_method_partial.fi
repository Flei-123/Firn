// expect_error: 24:8 'fn equal(*self, *Self) -> bool' is missing in 'impl Order for Dot { … }'
// expect_error_count: 1
// The type has ONE of the two methods (from an ordinary `impl` block),
// but no `impl Order for` block. The message only lists the method
// that is really missing -- it reads the function names of the program instead
// of saying "does not implement" wholesale.
interface Order {
    fn less(*self, b: *Self) -> bool
    fn equal(*self, b: *Self) -> bool
}

struct Dot { x: i64 }

impl Dot {
    fn less(*self, b: *Dot) -> bool { return (*self).x < (*b).x }
}

fn f[T: Order](a: *T) -> bool {
    return a.less(a)
}

fn main() -> i32 {
    var p: Dot = Dot { x: 1 }
    if f[Dot](&p) {
        return 1
    }
    return 0
}
