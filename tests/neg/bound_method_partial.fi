// expect_error: 24:8 'fn equal(*self, *Self) -> bool' is missing in 'impl Order for Dot { … }'
// expect_error_count: 1
// Der Typ hat EINE der beiden Methoden (aus einem gewoehnlichen `impl`-Block),
// aber keinen `impl Ordnung for`-Block. Die Meldung zaehlt nur die Methode
// auf, die wirklich fehlt — sie liest die Funktionsnamen des Programms, statt
// pauschal "setzt nicht um" zu sagen.
interface Order {
    fn less(*self, b: *Self) -> bool
    fn equal(*self, b: *Self) -> bool
}

struct Dot { x: i64 }

impl Dot {
    fn less(*self, b: *Dot) -> bool { return (*self).x < (*b).x }
}

fn f[T: Order](a: *T) -> bool {
    return a.less(a)
}

fn main() -> i32 {
    var p: Dot = Dot{ x: 1 }
    if f[Dot](&p) {
        return 1
    }
    return 0
}
