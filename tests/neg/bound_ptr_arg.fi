// expect_error: 23:8 typargument '*Punkt' erfuellt die schranke 'Ordnung'
// expect_error_count: 1
// Ein ZEIGER als Typargument. Eine Schnittstelle wird mit `impl I for <typ>`
// umgesetzt; `*Punkt` hat keinen Namen, unter dem so ein Block stehen
// koennte. Die Meldung sagt genau das, statt "kein impl gefunden".
interface Order {
    fn less(*self, b: *Self) -> bool
}

struct Dot { x: i64 }

impl Order for Dot {
    fn less(*self, b: *Dot) -> bool { return (*self).x < (*b).x }
}

fn f[T: Order](a: *T) -> bool {
    return a.less(a)
}

fn main() -> i32 {
    var p: Dot = Dot{ x: 1 }
    var z: *Dot = &p
    if f[*Dot](&z) {
        return 1
    }
    return 0
}
