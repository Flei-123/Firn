// expect_error: 23:8 type argument '*Dot' does not satisfy the bound 'Order' of the type parameter 'T' of 'f'
// expect_error_count: 1
// `smaller`.
// A POINTER as a type argument. An interface is implemented with
// `impl I for <type>`; `*Dot` has no name under which such a block could
interface Order {
    fn less(*self, b: *Self) -> bool
}

struct Dot { x: i64 }

impl Order for Dot {
    fn less(*self, b: *Dot) -> bool { return (*self).x < (*b).x }
}

fn f[T: Order](a: *T) -> bool {
    return a.less(a)
}

fn main() -> i32 {
    var p: Dot = Dot { x: 1 }
    var z: *Dot = &p
    if f[*Dot](&z) {
        return 1
    }
    return 0
}
