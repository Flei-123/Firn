// expect_error: 16:5 the address of the local 'x' escapes into 'keep', which keeps its argument 1
// ROUND 79: the interprocedural half. `keep` stores the pointer it is given
// somewhere that outlives it -- that is allowed and is not the error. The
// error is the CALL that hands it the address of a local, and that is where
// it is reported. Nothing had to be annotated for it: the fact about `keep`
// is worked out from its body and driven to a fixed point over the whole
// program (compiler/src/escape.rs).
const SLOT: u64 = 8192

fn keep(p: *mut i64) {
    *(SLOT as *mut u64) = p as u64
}

fn main() -> i32 {
    var x: i64 = 5
    keep(&x)
    return 0
}
