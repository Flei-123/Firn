// expect_error: 7:5 'match' is not exhaustive: the variant Char::End is not covered
enum Char { Letter(u8), Digit(u8), End }

fn main() -> i32 {
    let z = Char::End
    var r: i32 = 0
    match z {
        Char::Letter(c) => { r = 1 as i32 }
        Char::Digit(c) => { r = 2 as i32 }
    }
    return r
}
