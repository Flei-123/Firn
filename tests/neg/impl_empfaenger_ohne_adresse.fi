// expect_error: 15:12 braucht eine adresse
// expect_error_count: 1
// Verlangt die Methode einen Zeiger, muss der Empfaenger eine Adresse haben.
// Das Ergebnis eines Aufrufs hat keine — es wird kein stiller Zwischenwert
// angelegt, dessen Aenderungen nirgends ankaemen. Erst binden, dann rufen.
struct Punkt { x: i32, y: i32 }

impl Punkt {
    fn summe(*self) -> i32 { return (*self).x + (*self).y }
    fn verschoben(self, dx: i32) -> Punkt { return Punkt{ x: self.x + dx, y: self.y } }
}

fn main() -> i32 {
    var p: Punkt = Punkt{ x: 1, y: 2 }
    return p.verschoben(1).summe()
}
