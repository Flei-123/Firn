// expect_error: 11:1 struct 'Point' is already declared
// expect_error_count: 1
// The SAME fields in both, on purpose: what is at stake is the name, and
// after the error the two compilers keep different halves of the layout
// (stage 0 lets the second declaration overwrite the first, stage 1 keeps
// the first). Nothing is generated from a refused program, so it makes no
// difference -- but tools/types_compare.sh reads the layout of every file
// in tests/ and would report the harmless difference as a deviation.
struct Point { x: i32, y: i32 }

struct Point { x: i32, y: i32 }

fn main() -> i32 {
    let p: Point = Point { x: 1, y: 2 }
    return p.x
}
