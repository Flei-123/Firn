// expect_error: 15:6 'i32' already implements the interface 'Order'
// expect_error_count: 2
// Twice the same implementation for the same basic type. What is compared is
// the METHOD PREFIX of the carrier, not the struct index -- otherwise the
// check for basic types (index `usize::MAX`) would find every implementation
// twice or none. The second block additionally creates a duplicate function.
interface Order {
    fn less(*self, b: *Self) -> bool
}

impl Order for i32 {
    fn less(*self, b: *i32) -> bool { return *self < *b }
}

impl Order for i32 {
    fn less(*self, b: *i32) -> bool { return *b < *self }
}

fn main() -> i32 {
    return 0
}
