// expect_error: 17:28 an interface value is made from a pointer to a struct, found *mut i64
// expect_error_count: 1
// A basic type implements the interface -- that does not make it an
// INTERFACE VALUE. `dyn I` carries a data pointer and a method table; a
// table only exists per struct implementation (docs/ROUND50.md, "deliberately
// left out"). What is reported is reported at the conversion.
interface Showable {
    fn value(*self) -> i64
}

impl Showable for i64 {
    fn value(*self) -> i64 { return *self }
}

fn main() -> i32 {
    var n: i64 = 7
    let d: dyn Showable = (&n) as dyn Showable
    return d.value() as i32
}
