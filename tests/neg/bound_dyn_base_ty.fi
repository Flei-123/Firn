// expect_error: 17:28 an interface value is made from a pointer to a struct, found *mut i64
// expect_error_count: 1
// Ein Grundtyp setzt die Schnittstelle um — ein SCHNITTSTELLENWERT wird er
// darum nicht. `dyn I` traegt einen Datenzeiger und eine Methodentafel; eine
// Tafel gibt es nur je Struct-Umsetzung (docs/RUNDE50.md, "Bewusst
// weggelassen"). Gemeldet wird an der Umwandlung.
interface Showable {
    fn value(*self) -> i64
}

impl Showable for i64 {
    fn value(*self) -> i64 { return *self }
}

fn main() -> i32 {
    var n: i64 = 7
    let d: dyn Showable = (&n) as dyn Showable
    return d.value() as i32
}
