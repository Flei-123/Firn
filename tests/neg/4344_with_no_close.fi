// expect_error: 9:10 type 'NoClose' has no method 'close'
// tests/neg/4344_with_no_close.fi -- r749: `with` needs a `close` method on the bound value.
struct NoClose { n: i64 }

fn make() -> NoClose { return NoClose { n: 1 } }

fn main() -> i32 {
    var s: i64 = 0
    with x = make() {
        s = x.n
    }
    return 0
}
