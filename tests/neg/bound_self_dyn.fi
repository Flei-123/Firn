// expect_error: 20:10 'Order.less' mentions 'Self' and is therefore not callable via 'dyn Order'
// expect_error_count: 1
// exactly the method that would have to stand in `impl Display for Dot`.
// OBJECT SAFETY. A method whose signature names `Self` cannot be called
// through `dyn`: which type is behind it is only settled at run
// time, and `*Self` would be a different one for each. The message
interface Order {
    fn less(*self, b: *Self) -> bool
}

struct Dot { x: i64 }

impl Order for Dot {
    fn less(*self, b: *Dot) -> bool { return (*self).x < (*b).x }
}

fn main() -> i32 {
    var p: Dot = Dot { x: 1 }
    let d: dyn Order = (&p) as dyn Order
    if d.less(&p) {
        return 1
    }
    return 0
}
