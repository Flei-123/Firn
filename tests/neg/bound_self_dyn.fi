// expect_error: 20:10 nennt 'Self' und ist deshalb nicht ueber 'dyn Ordnung' aufrufbar
// expect_error_count: 1
// OBJEKTSICHERHEIT. Eine Methode, deren Signatur `Self` nennt, laesst sich
// nicht ueber `dyn` rufen: welcher Typ dahintersteckt, steht erst zur
// Laufzeit fest, und `*Self` waere fuer jeden ein anderer. Die Meldung
// verweist auf den Weg, der geht — die Schranke.
interface Order {
    fn less(*self, b: *Self) -> bool
}

struct Dot { x: i64 }

impl Order for Dot {
    fn less(*self, b: *Dot) -> bool { return (*self).x < (*b).x }
}

fn main() -> i32 {
    var p: Dot = Dot{ x: 1 }
    let d: dyn Order = (&p) as dyn Order
    if d.less(&p) {
        return 1
    }
    return 0
}
