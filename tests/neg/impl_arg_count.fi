// expect_error: 13:5 method 'Dot.set_x' expects 1 argument(s), found 2
// expect_error_count: 1
// The arity is named WITHOUT the receiver: `set_x` takes one
// argument, not two.
struct Dot { x: i32, y: i32 }

impl Dot {
    fn set_x(*mut self, x: i32) { (*self).x = x }
}

fn main() -> i32 {
    var p: Dot = Dot { x: 1, y: 2 }
    p.set_x(1, 2)
    return 0
}
