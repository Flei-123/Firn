// expect_error: 15:14 hat keine methode
// expect_error_count: 1
// NAMENSAUFLOESUNG: eine freie Funktion ist keine Methode, auch wenn ihr
// erster Parameter der passende Zeiger ist. Methoden heissen intern
// `Typ__name` — `punkt_summe` heisst nicht so und wird von `p.punkt_summe()`
// deshalb nicht gefunden. Verdecken kann hier nichts, weil es zwei Namen sind.
struct Punkt { x: i32, y: i32 }

fn punkt_summe(p: *mut Punkt) -> i32 {
    return (*p).x + (*p).y
}

fn main() -> i32 {
    var p: Punkt = Punkt{ x: 1, y: 2 }
    return p.punkt_summe()
}
