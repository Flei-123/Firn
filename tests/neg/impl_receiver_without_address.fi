// expect_error: 15:12 the receiver of 'Dot.sum' needs an address, this expression has none
// expect_error_count: 1
// Verlangt die Methode einen Zeiger, muss der Empfaenger eine Adresse haben.
// Das Ergebnis eines Aufrufs hat keine — es wird kein stiller Zwischenwert
// angelegt, dessen Aenderungen nirgends ankaemen. Erst binden, dann rufen.
struct Dot { x: i32, y: i32 }

impl Dot {
    fn sum(*self) -> i32 { return (*self).x + (*self).y }
    fn moved(self, dx: i32) -> Dot { return Dot{ x: self.x + dx, y: self.y } }
}

fn main() -> i32 {
    var p: Dot = Dot{ x: 1, y: 2 }
    return p.moved(1).sum()
}
