// expect_error: 10:10 'a' is passed as 'inout' and used again in the same call
// r899: one inout place plus a pointer to the same place in one call is rejected.
fn bump(x: inout i64, p: *mut i64) {
    *x = 1
    *p = 2
}

fn main() -> i32 {
    var a: i64 = 0
    bump(inout a, &a)
    return a as i32
}
