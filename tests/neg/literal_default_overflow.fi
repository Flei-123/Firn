// expect_error: 6:13 integer literal 5000000000 does not fit into the type i32
// ROUND 70: the default type does NOT soften the overflow check. Without a
// context an integer literal is `i32` -- and 5000000000 does not fit into
// that, exactly as it would not at an explicit `i32`.
fn main() -> i32 {
    let x = 5000000000
    return x
}
