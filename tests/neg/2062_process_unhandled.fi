// expect_error: 8:29 expected type process__Child, found ProcError!process__Child
// `spawn` can fail (the program may not exist): its result is an error
// union and cannot be used as a `Child` without `try` or `catch`.
import std.process

fn main() -> i32 {
    var c: process.Command = process.command("no-such-program")
    var ch: process.Child = process.spawn(&c)
    return ch.pid as i32
}
