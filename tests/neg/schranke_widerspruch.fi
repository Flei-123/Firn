// expect_error: 22:8 erfuellt die schranke 'Int' des typparameters 'T' von 'f' nicht
// expect_error_count: 1
// MEHRERE SCHRANKEN, EINE VERLETZT. `Punkt` setzt `Ordnung` um, ist aber
// kein Ganzzahltyp — `Int` schlaegt fehl. Gemeldet wird die ERSTE verletzte
// Schranke; eine zweite Meldung zu demselben Typargument saegte nichts Neues.
interface Ordnung {
    fn kleiner(*self, b: *Self) -> bool
}

struct Punkt { x: i64 }

impl Ordnung for Punkt {
    fn kleiner(*self, b: *Punkt) -> bool { return (*self).x < (*b).x }
}

fn f[T: Int + Ordnung](a: *T) -> bool {
    return a.kleiner(a)
}

fn main() -> i32 {
    var p: Punkt = Punkt{ x: 1 }
    if f[Punkt](&p) {
        return 1
    }
    return 0
}
