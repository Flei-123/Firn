// expect_out: ok
// tests/3411_photo_look.fi -- photo.look: black point, mid tone, colour, clarity of the final display image.
// (1) a milky bright flat picture (black floor 0.2, median 0.6, weak colour): after the look the black floor is gone,
//     the median is at tmed, the colour is stronger and the hue of every pixel is kept;
// (2) a dark picture keeps its mood (the median is never lifted, only the black point is cut);
// (3) strength 0 is the identity; (4) the luma curve against a direct formula (no table) on a gradient, clarity off;
// (5) the result stays in 0..1 and never turns NaN on constant / tiny / saturated pictures; (6) clarity adds local contrast.
import std.io
import std.rt
import std.math
import photo.image
import photo.look

fn check(c: bool, msg: str) -> bool {
    if !c { io.print(msg); io.new_line() }
    return c
}

fn fabs(x: f32) -> f32 {
    if x < 0.0f { return 0.0f - x }
    return x
}

fn luma(im: *mut image.Image, x: i32, y: i32) -> f32 {
    return 0.2126f * image.img_get(im, 0, x, y) + 0.7152f * image.img_get(im, 1, x, y) + 0.0722f * image.img_get(im, 2, x, y)
}

// milky picture: luma ramp 0.2..0.95 left to right, a smooth vertical colour tilt
fn milky(w: i32, h: i32) -> image.Image {
    var im: image.Image = image.img_new(w, h, 3)
    var y: i32 = 0
    while y < h {
        var x: i32 = 0
        while x < w {
            let t: f32 = (x as f32) / ((w - 1) as f32)
            let v: f32 = 0.2f + 0.75f * t * t * (3.0f - 2.0f * t)
            let tilt: f32 = 0.04f * ((y as f32) / ((h - 1) as f32) - 0.5f)
            image.img_set(&im, 0, x, y, image.fclampf(v + tilt, 0.0f, 1.0f))
            image.img_set(&im, 1, x, y, v)
            image.img_set(&im, 2, x, y, image.fclampf(v - tilt, 0.0f, 1.0f))
            x = x + 1
        }
        y = y + 1
    }
    return im
}

fn median_luma(im: *mut image.Image) -> f32 {
    var hist: [i32; 256] = [0; 256]
    let n: i32 = (*im).w * (*im).h
    var y: i32 = 0
    while y < (*im).h {
        var x: i32 = 0
        while x < (*im).w {
            var b: i32 = (luma(im, x, y) * 255.0f) as i32
            if b < 0 { b = 0 }
            if b > 255 { b = 255 }
            hist[b as usize] = hist[b as usize] + 1
            x = x + 1
        }
        y = y + 1
    }
    var acc: i32 = 0
    var k: i32 = 0
    while k < 256 {
        acc = acc + hist[k as usize]
        if acc * 2 >= n { break }
        k = k + 1
    }
    return (k as f32) / 255.0f
}

fn mean_chroma(im: *mut image.Image) -> f32 {
    var s: f32 = 0.0f
    var y: i32 = 0
    while y < (*im).h {
        var x: i32 = 0
        while x < (*im).w {
            let r: f32 = image.img_get(im, 0, x, y)
            let g: f32 = image.img_get(im, 1, x, y)
            let b: f32 = image.img_get(im, 2, x, y)
            var mx: f32 = r
            var mn: f32 = r
            if g > mx { mx = g }
            if b > mx { mx = b }
            if g < mn { mn = g }
            if b < mn { mn = b }
            s = s + (mx - mn)
            x = x + 1
        }
        y = y + 1
    }
    return s / (((*im).w * (*im).h) as f32)
}

fn mean_luma(im: *mut image.Image) -> f32 {
    var s: f32 = 0.0f
    var y: i32 = 0
    while y < (*im).h {
        var x: i32 = 0
        while x < (*im).w {
            s = s + luma(im, x, y)
            x = x + 1
        }
        y = y + 1
    }
    return s / (((*im).w * (*im).h) as f32)
}

fn in_range(im: *mut image.Image) -> bool {
    var c: i32 = 0
    while c < 3 {
        var y: i32 = 0
        while y < (*im).h {
            var x: i32 = 0
            while x < (*im).w {
                let v: f32 = image.img_get(im, c, x, y)
                if !(v >= 0.0f && v <= 1.0f) { return false }
                x = x + 1
            }
            y = y + 1
        }
        c = c + 1
    }
    return true
}

fn main() -> i32 {
    var ok: bool = true
    // (1) milky picture
    var a: image.Image = milky(128, 96)
    var o: look.LookOpts = look.look_default()
    o.clarity = 0.0f
    let m0: f32 = median_luma(&a)
    let c0: f32 = mean_chroma(&a) / mean_luma(&a)
    let min0: f32 = luma(&a, 0, 48)
    var b: image.Image = image.img_copy(&a)
    look.look_apply(&b, &o)
    let min1: f32 = luma(&b, 0, 48)
    let m1: f32 = median_luma(&b)
    ok = check(min0 > 0.15f && min1 < 0.03f, "black floor not cut") && ok
    ok = check(m0 > 0.5f && fabs(m1 - o.tmed) < 0.04f, "median not at tmed") && ok
    ok = check(mean_chroma(&b) / mean_luma(&b) > c0 * 1.3f, "colour not stronger") && ok
    // hue kept: R-B sign of the tilt is the same everywhere the chroma is large enough
    var flips: i32 = 0
    var y: i32 = 0
    while y < 96 {
        var x: i32 = 8
        while x < 120 {
            let d0: f32 = image.img_get(&a, 0, x, y) - image.img_get(&a, 2, x, y)
            let d1: f32 = image.img_get(&b, 0, x, y) - image.img_get(&b, 2, x, y)
            if d0 > 0.01f && d1 < 0.0f { flips = flips + 1 }
            if d0 < 0.0f - 0.01f && d1 > 0.0f { flips = flips + 1 }
            x = x + 1
        }
        y = y + 1
    }
    ok = check(flips == 0, "hue flipped") && ok
    ok = check(in_range(&b), "out of range") && ok
    // (2) dark picture: median stays, black cut only
    var dk: image.Image = image.img_new(64, 48, 3)
    y = 0
    while y < 48 {
        var x: i32 = 0
        while x < 64 {
            let v: f32 = 0.04f + 0.30f * ((x as f32) / 63.0f)
            image.img_set(&dk, 0, x, y, v)
            image.img_set(&dk, 1, x, y, v)
            image.img_set(&dk, 2, x, y, v)
            x = x + 1
        }
        y = y + 1
    }
    let dm0: f32 = median_luma(&dk)
    look.look_apply(&dk, &o)
    let dm1: f32 = median_luma(&dk)
    ok = check(dm1 <= dm0 + 0.01f, "dark picture lifted") && ok
    ok = check(dm0 < o.tmed, "test picture is not dark") && ok
    // (3) strength 0 is the identity
    var id: image.Image = milky(64, 48)
    var ref: image.Image = image.img_copy(&id)
    var o0: look.LookOpts = look.look_scaled(0.0f)
    look.look_apply(&id, &o0)
    var dmax: f32 = 0.0f
    var c: i32 = 0
    while c < 3 {
        y = 0
        while y < 48 {
            var x: i32 = 0
            while x < 64 {
                let d: f32 = fabs(image.img_get(&id, c, x, y) - image.img_get(&ref, c, x, y))
                if d > dmax { dmax = d }
                x = x + 1
            }
            y = y + 1
        }
        c = c + 1
    }
    ok = check(dmax < 0.002f, "strength 0 is not identity") && ok
    // (4) luma curve against the direct formula on a gray gradient (no colour: sat does not matter), clarity off
    var gr: image.Image = image.img_new(256, 4, 3)
    y = 0
    while y < 4 {
        var x: i32 = 0
        while x < 256 {
            let v: f32 = 0.15f + 0.8f * ((x as f32) / 255.0f)
            c = 0
            while c < 3 {
                image.img_set(&gr, c, x, y, v)
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    var og: look.LookOpts = look.look_default()
    og.clarity = 0.0f
    // table curve vs the direct formula (gamma from the median of the base curve), through look_apply on gray pixels
    let pb: f32 = ((((0.15f * 1023.0f) as i32) as f32) + 0.5f) / 1023.0f
    look.look_apply(&gr, &og)
    var worst: f32 = 0.0f
    var x2: i32 = 0
    while x2 < 256 {
        let got: f32 = image.img_get(&gr, 1, x2, 1)
        if x2 > 0 {
            let prev: f32 = image.img_get(&gr, 1, x2 - 1, 1)
            if got + 1.0e-6f < prev { worst = worst + 1.0f }
        }
        x2 = x2 + 1
    }
    ok = check(worst < 0.5f, "curve not monotone") && ok
    // the first gradient pixel (luma 0.15 = the black percentile) maps to ~0, the last (0.95) stays below 1
    ok = check(image.img_get(&gr, 1, 0, 1) < 0.02f && image.img_get(&gr, 1, 255, 1) <= 1.0f && pb > 0.14f, "gradient ends") && ok
    // direct formula for the midpoint pixel: u = (y - bp) / (1 - bp), smoothstep blend, gamma to the median target
    var o2: look.LookOpts = look.look_default()
    o2.clarity = 0.0f
    let bp2: f32 = pb
    let ym: f32 = 0.55f
    let um: f32 = (ym - bp2) / (1.0f - bp2)
    let sm: f32 = um * um * (3.0f - 2.0f * um)
    let base_m: f32 = um + o2.contrast * (sm - um)
    // the median of the gradient is y = 0.55 -> its base value is base_m; the gamma moves it to tmed
    let want: f32 = o2.tmed
    var gamma: f32 = 1.0f
    if base_m > o2.tmed { gamma = math.ln(want as f64) as f32 / (math.ln(base_m as f64) as f32) }
    var gray: image.Image = image.img_new(8, 8, 3)
    c = 0
    while c < 3 {
        y = 0
        while y < 8 {
            var x: i32 = 0
            while x < 8 {
                // fill with the gradient so the percentiles match: left half 0.15, the rest 0.55 .. 0.95
                var v: f32 = 0.15f
                if x >= 1 { v = 0.55f }
                if x >= 6 { v = 0.95f }
                image.img_set(&gray, c, x, y, v)
                x = x + 1
            }
            y = y + 1
        }
        c = c + 1
    }
    look.look_apply(&gray, &o2)
    // pixel x = 1 is the median (y = 0.55): expect the formula's value within the table error
    let got_m: f32 = image.img_get(&gray, 1, 1, 3)
    ok = check(fabs(got_m - want) < 0.02f, "median pixel differs from the formula") && ok
    ok = check(gamma >= 1.0f, "gamma sign") && ok
    // (5) robustness
    var k: i32 = 0
    while k < 6 {
        var w: i32 = 1
        var h: i32 = 1
        if k == 1 { w = 2; h = 2 }
        if k >= 2 { w = 17; h = 9 }
        var t: image.Image = image.img_new(w, h, 3)
        var yy: i32 = 0
        while yy < h {
            var xx: i32 = 0
            while xx < w {
                var v: f32 = 0.0f
                if k == 3 { v = 1.0f }
                if k == 4 { v = 0.5f }
                if k == 5 { v = if (xx + yy) % 2 == 0 { 1.0f } else { 0.0f } }
                image.img_set(&t, 0, xx, yy, v)
                image.img_set(&t, 1, xx, yy, 1.0f - v)
                image.img_set(&t, 2, xx, yy, v * 0.5f)
                xx = xx + 1
            }
            yy = yy + 1
        }
        var od: look.LookOpts = look.look_default()
        look.look_apply(&t, &od)
        ok = check(in_range(&t), "robustness range") && ok
        image.img_free(&t)
        k = k + 1
    }
    // (6) clarity: a soft step edge gets steeper next to the edge (overshoot on both sides)
    var st: image.Image = image.img_new(96, 32, 3)
    y = 0
    while y < 32 {
        var x: i32 = 0
        while x < 96 {
            var v: f32 = 0.35f
            if x >= 48 { v = 0.55f }
            c = 0
            while c < 3 {
                image.img_set(&st, c, x, y, v)
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    var oc: look.LookOpts = look.look_scaled(1.0f)
    oc.black = 0.0f
    oc.contrast = 0.0f
    oc.dark = 0.0f
    oc.sat = 1.0f
    oc.clarity = 0.5f
    oc.clarity_r = 0.03f
    var st2: image.Image = image.img_copy(&st)
    look.look_apply(&st2, &oc)
    let lo_d: f32 = luma(&st, 47, 16) - luma(&st2, 47, 16)
    let hi_d: f32 = luma(&st2, 48, 16) - luma(&st, 48, 16)
    ok = check(lo_d > 0.005f && hi_d > 0.005f, "clarity adds no local contrast") && ok
    ok = check(fabs(luma(&st2, 2, 16) - luma(&st, 2, 16)) < 0.01f, "clarity changed a flat area") && ok
    if ok { io.print("ok") } else { io.print("FAIL") }
    return 0
}
