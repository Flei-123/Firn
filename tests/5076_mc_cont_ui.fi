// expect_exit: 0
import std.rt
import mc.mc_cont_ui
import mc.mc_menu

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn main() -> i32 {
    check(mc_cont_ui.cui_kind(27, 9) == mc_cont_ui.KIND_GENERIC, 1)
    check(mc_cont_ui.cui_kind(54, 9) == mc_cont_ui.KIND_GENERIC, 2)
    check(mc_cont_ui.cui_kind(9, 3) == mc_cont_ui.KIND_DISPENSER, 3)
    check(mc_cont_ui.cui_kind(9, 9) == mc_cont_ui.KIND_GENERIC, 4)
    check(mc_cont_ui.cui_kind(5, 5) == mc_cont_ui.KIND_HOPPER, 5)
    check(mc_cont_ui.cui_kind(10, 3) == mc_cont_ui.KIND_CRAFT, 6)
    check(mc_cont_ui.cui_kind(3, 3) == mc_cont_ui.KIND_FURNACE, 7)
    check(mc_cont_ui.cui_panel_h(mc_cont_ui.KIND_GENERIC, 54) == 222, 8)
    check(mc_cont_ui.cui_panel_h(mc_cont_ui.KIND_GENERIC, 27) == 168, 9)
    var x: i32 = 0
    var y: i32 = 0
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_GENERIC, 27, 27, &x, &y), 10)
    check(x == 8 && y == 85, 11)
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_GENERIC, 27, 27 + 27 + 8, &x, &y), 12)
    check(x == 152 && y == 143, 13)
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_CRAFT, 10, 0, &x, &y) && x == 124 && y == 35, 14)
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_CRAFT, 10, 9, &x, &y) && x == 66 && y == 53, 15)
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_CRAFT, 10, 10 + 27, &x, &y) && x == 8 && y == 142, 16)
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_FURNACE, 3, 2, &x, &y) && x == 116 && y == 35, 17)
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_HOPPER, 5, 4, &x, &y) && x == 116 && y == 20, 18)
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_HOPPER, 5, 5 + 27, &x, &y) && x == 8 && y == 109, 19)
    check(!mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_HOPPER, 5, 41, &x, &y), 20)
    check(mc_cont_ui.cui_slot_at(mc_cont_ui.KIND_CRAFT, 10, 100, 50, 2, 100 + 125 * 2, 50 + 36 * 2) == 0, 21)
    check(mc_cont_ui.cui_slot_at(mc_cont_ui.KIND_CRAFT, 10, 100, 50, 2, 0, 0) == 0 - 999, 22)
    check(mc_cont_ui.cui_slot_at(mc_cont_ui.KIND_CRAFT, 10, 100, 50, 2, 100 + 2, 50 + 2) == 0 - 1, 23)
    check(mc_menu.menu_kind(7, 763) == mc_menu.MK_ANVIL && mc_menu.menu_kind(8, 765) == mc_menu.MK_ANVIL, 30)
    check(mc_menu.menu_kind(10, 763) == mc_menu.MK_BREWING && mc_menu.menu_kind(11, 769) == mc_menu.MK_BREWING, 31)
    check(mc_menu.menu_kind(12, 763) == mc_menu.MK_ENCHANT && mc_menu.menu_kind(13, 769) == mc_menu.MK_ENCHANT, 32)
    check(mc_menu.menu_kind(18, 763) == mc_menu.MK_MERCHANT && mc_menu.menu_kind(19, 769) == mc_menu.MK_MERCHANT, 33)
    check(mc_menu.menu_kind(9, 763) == mc_menu.MK_BLAST && mc_menu.menu_kind(10, 765) == mc_menu.MK_BLAST, 34)
    check(mc_menu.menu_kind(21, 763) == mc_menu.MK_SMOKER && mc_menu.menu_kind(22, 769) == mc_menu.MK_SMOKER, 35)
    check(mc_menu.menu_kind(7, 765) == mc_menu.MK_NONE && mc_menu.menu_kind(19, 763) == mc_menu.MK_SHULKER && mc_menu.menu_kind(20, 769) == mc_menu.MK_SHULKER, 36)
    check(mc_menu.menu_slots(mc_menu.MK_ENCHANT, 12, 763) == 2 && mc_menu.menu_slots(mc_menu.MK_BREWING, 10, 763) == 5 && mc_menu.menu_slots(mc_menu.MK_SMITHING, 20, 763) == 4, 37)
    check(mc_cont_ui.cui_kind_of(mc_menu.MK_GRIND, 3, 3) == mc_cont_ui.KIND_GRIND && mc_cont_ui.cui_kind_of(mc_menu.MK_GENERIC, 27, 9) == mc_cont_ui.KIND_GENERIC, 38)
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_ANVIL, 3, 2, &x, &y) && x == 134 && y == 47, 39)
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_BREWING, 5, 4, &x, &y) && x == 17 && y == 17, 40)
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_MERCHANT, 3, 3, &x, &y) && x == 108 && y == 84, 41)
    check(mc_cont_ui.cui_panel_w(mc_cont_ui.KIND_MERCHANT) == 276 && mc_cont_ui.cui_panel_w(mc_cont_ui.KIND_ANVIL) == 176, 42)
    check(mc_cont_ui.cui_slot_xy(mc_cont_ui.KIND_HORSE, 17, 2, &x, &y) && x == 80 && y == 18, 43)
    check(mc_cont_ui.cui_enchant_at(0, 0, 2, 2 * 70, 2 * 25) == 0 && mc_cont_ui.cui_enchant_at(0, 0, 2, 2 * 70, 2 * 60) == 2, 44)
    return 0
}
