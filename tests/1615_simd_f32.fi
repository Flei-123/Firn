// expect_exit: 0
// tests/1615_simd_f32.fi -- ROUND TEMPO 4: the packed floating-point instructions
// (`addps`/`subps`/`mulps`) against the same calculation LANE BY LANE.
//
// Why this is the right probe: the three instructions promise exactly to calculate
// four times the same as the single calculation. If this promise
// is broken -- a lane swapped, a sign wrong, a different
// rounding --, then at least one lane deviates from `a[i] + b[i]`, and that
// stands here as a comparison. In addition the two instructions that the sound decoder
// needs besides: `pshufd` (pull one value onto all four lanes) and
// `__v128_zero`.
//
// The test runs in all four build stages and on both machines; it is
// also the probe that `v128` arrives correctly in the path with register allocation
// (round TEMPO 4: before, every function with a vector went onto the
// basic path).
fn main() -> i32 {
    var a: [f32; 8] = [1.5f, -2.25f, 3.75f, 0.5f, 7.0f, -0.125f, 2.0f, 9.5f]
    var b: [f32; 8] = [0.25f, 4.0f, -1.5f, 2.5f, -3.0f, 8.0f, 0.75f, -6.0f]
    var vsum: [f32; 8] = [0.0f; 8]
    var vdif: [f32; 8] = [0.0f; 8]
    var vprd: [f32; 8] = [0.0f; 8]
    var i: usize = 0
    while i < 8 {
        let va: v128 = __v128_load(((&a[i]) as u64) as *u8)
        let vb: v128 = __v128_load(((&b[i]) as u64) as *u8)
        __v128_store(((&vsum[i]) as u64) as *mut u8, __v128_addf32(va, vb))
        __v128_store(((&vdif[i]) as u64) as *mut u8, __v128_subf32(va, vb))
        __v128_store(((&vprd[i]) as u64) as *mut u8, __v128_mulf32(va, vb))
        i = i + 4
    }
    // lane by lane the same, scalar
    i = 0
    while i < 8 {
        if vsum[i] != a[i] + b[i] { return 1 }
        if vdif[i] != a[i] - b[i] { return 2 }
        if vprd[i] != a[i] * b[i] { return 3 }
        i = i + 1
    }
    // pshufd: lane 0 onto all four
    var br: [f32; 4] = [0.0f; 4]
    let v0: v128 = __v128_load(((&a[0]) as u64) as *u8)
    __v128_store(((&br[0]) as u64) as *mut u8, __v128_shuffle32(v0, 0))
    i = 0
    while i < 4 {
        if br[i] != a[0] { return 4 }
        i = i + 1
    }
    // zero
    var z: [f32; 4] = [1.0f; 4]
    __v128_store(((&z[0]) as u64) as *mut u8, __v128_zero())
    i = 0
    while i < 4 {
        if z[i] != 0.0f { return 5 }
        i = i + 1
    }
    return 0
}
