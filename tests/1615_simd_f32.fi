// expect_exit: 0
// tests/1615_simd_f32.fi -- RUNDE TEMPO 4: die gepackten Fliesskommabefehle
// (`addps`/`subps`/`mulps`) gegen dieselbe Rechnung SPUR FUER SPUR.
//
// Warum das die richtige Probe ist: die drei Befehle versprechen genau, vier
// Mal dasselbe zu rechnen wie die einzelne Rechnung. Wird dieses Versprechen
// gebrochen -- eine Spur vertauscht, ein Vorzeichen falsch, eine andere
// Rundung --, dann weicht mindestens eine Spur von `a[i] + b[i]` ab, und das
// steht hier als Vergleich. Dazu die beiden Befehle, die der Tondekoder
// ausserdem braucht: `pshufd` (einen Wert auf alle vier Spuren ziehen) und
// `__v128_zero`.
//
// Der Test laeuft in allen vier Baustufen und auf beiden Maschinen; er ist
// auch die Probe darauf, dass `v128` im Weg mit Registerzuteilung richtig
// ankommt (Runde TEMPO 4: vorher ging jede Funktion mit einem Vektor auf den
// Grundweg).
fn main() -> i32 {
    var a: [f32; 8] = [1.5f, -2.25f, 3.75f, 0.5f, 7.0f, -0.125f, 2.0f, 9.5f]
    var b: [f32; 8] = [0.25f, 4.0f, -1.5f, 2.5f, -3.0f, 8.0f, 0.75f, -6.0f]
    var vsum: [f32; 8] = [0.0f; 8]
    var vdif: [f32; 8] = [0.0f; 8]
    var vprd: [f32; 8] = [0.0f; 8]
    var i: usize = 0
    while i < 8 {
        let va: v128 = __v128_load(((&a[i]) as u64) as *u8)
        let vb: v128 = __v128_load(((&b[i]) as u64) as *u8)
        __v128_store(((&vsum[i]) as u64) as *mut u8, __v128_addf32(va, vb))
        __v128_store(((&vdif[i]) as u64) as *mut u8, __v128_subf32(va, vb))
        __v128_store(((&vprd[i]) as u64) as *mut u8, __v128_mulf32(va, vb))
        i = i + 4
    }
    // Spur fuer Spur dasselbe, skalar
    i = 0
    while i < 8 {
        if vsum[i] != a[i] + b[i] { return 1 }
        if vdif[i] != a[i] - b[i] { return 2 }
        if vprd[i] != a[i] * b[i] { return 3 }
        i = i + 1
    }
    // pshufd: Spur 0 auf alle vier
    var br: [f32; 4] = [0.0f; 4]
    let v0: v128 = __v128_load(((&a[0]) as u64) as *u8)
    __v128_store(((&br[0]) as u64) as *mut u8, __v128_shuffle32(v0, 0))
    i = 0
    while i < 4 {
        if br[i] != a[0] { return 4 }
        i = i + 1
    }
    // zero
    var z: [f32; 4] = [1.0f; 4]
    __v128_store(((&z[0]) as u64) as *mut u8, __v128_zero())
    i = 0
    while i < 4 {
        if z[i] != 0.0f { return 5 }
        i = i + 1
    }
    return 0
}
