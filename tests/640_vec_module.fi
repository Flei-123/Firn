// expect_exit: 0
// `Vec[T]` FROM A LIBRARY -- the proof that all three blockers from
// docs/SELF_HOSTING.md 7 have fallen:
//
//   B1  a generic template from a module is usable here
//   B2  `lib/rt/vec.fi` calls `rt.heap_alloc` -- a function from ANOTHER
//       module -- from the body of a generic template
//   B3  `lib/rt/vec.fi` imports `rt` from its OWN directory
//
// For the first time a real generic collection can be written as a library --
// the precondition for `lib/std/` and thereby for stage 1.
import modules.vec

fn main() -> i32 {
    // --- i32 over many doublings
    var v: Vec[i32] = vec_new[i32]()
    defer vec_free[i32](&v)
    var i: i32 = 0
    while i < 1000 {
        if !vec_push[i32](&v, i * 7) {
            return 1
        }
        i = i + 1
    }
    if vec_len[i32](&v) != 1000 {
        return 2
    }
    if vec_at[i32](&v, 0) != 0 {
        return 3
    }
    if vec_at[i32](&v, 999) != 6993 {
        return 4
    }
    if vec_at[i32](&v, 99999) != 0 {
        return 5
    }

    // --- pop and last
    if vec_last[i32](&v) != 6993 {
        return 6
    }
    if vec_pop[i32](&v) != 6993 {
        return 7
    }
    if vec_len[i32](&v) != 999 {
        return 8
    }

    // --- set
    if !vec_set[i32](&v, 0, 4242) {
        return 9
    }
    if vec_at[i32](&v, 0) != 4242 {
        return 10
    }
    if vec_set[i32](&v, 99999, 1) {
        return 11
    }

    // --- a different element size: an instance of its own
    var b: Vec[u8] = vec_new[u8]()
    defer vec_free[u8](&b)
    var k: usize = 0
    while k < 300 {
        if !vec_push[u8](&b, (k % 251) as u8) {
            return 12
        }
        k = k + 1
    }
    if vec_len[u8](&b) != 300 {
        return 13
    }
    if vec_at[u8](&b, 299) != ((299 as u64) % 251) as u8 {
        return 14
    }

    // --- u64: the scaling has to be right
    var w: Vec[u64] = vec_new[u64]()
    defer vec_free[u64](&w)
    var j: u64 = 0
    while j < 100 {
        if !vec_push[u64](&w, j * 1000000007) {
            return 15
        }
        j = j + 1
    }
    if vec_at[u64](&w, 99) != 99 * 1000000007 {
        return 16
    }
    return 0
}
