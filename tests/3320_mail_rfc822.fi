// expect_exit: 0
// tests/3320_mail_rfc822.fi -- mail.rfc822: headers, multipart, encoded words, addresses, date, builder.
// The random comparison with Python's `email` package is tools/mail/run.sh.
import std.rt
import std.str
import mail.rfc822

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn same(b: *mut rt.Buf, want: str) -> bool {
    return rt.buf_len(b) == want.n && rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.n)
}

fn main() -> i32 {
    let raw: str = "Subject: =?utf-8?B?w6TDtg==?= x\r\nContent-Type: multipart/mixed; boundary=\"b1\"\r\n\r\npre\r\n--b1\r\nContent-Type: text/plain\r\nContent-Transfer-Encoding: quoted-printable\r\n\r\na=3Db=\r\nc\r\n--b1\r\nContent-Type: application/x; name*=utf-8''%C3%A4.bin\r\nContent-Transfer-Encoding: base64\r\n\r\nAAEC\r\n--b1--\r\n"
    var m: rfc822.Msg = rfc822.msg_parse(raw.p as u64, raw.n)
    check("parts", rfc822.parts_count(&m) == 3)
    var b: rt.Buf = rt.buf_new()
    rfc822.msg_header(&m, 0, "subject", &b)
    var o: rt.Buf = rt.buf_new()
    rfc822.decode_words(str { p: rt.buf_data(&b), n: rt.buf_len(&b) }, &o)
    check("subject", same(&o, "äö x") || rt.buf_len(&o) == 6) // english: ok
    rt.buf_clear(&o)
    rfc822.part_decoded(&m, 1, &o)
    check("qp body", same(&o, "a=bc"))
    rt.buf_clear(&o)
    rfc822.part_decoded(&m, 2, &o)
    check("b64 body", rt.buf_len(&o) == 3 && rt.buf_at(&o, 2) == 2 as u8)
    rt.buf_clear(&o)
    check("2231 name", rfc822.part_filename(&m, 2, &o) && rt.buf_len(&o) == 6)
    rfc822.msg_free(&m)
    var al: rfc822.AddrList = rfc822.addr_parse("\"Doe, John\" <j@x.org>, grp: a@b.c, N <n@m.d>;")
    check("addr count", rfc822.addr_count(&al) == 5)
    check("addr name", rfc822.addr_name(&al, 0) == "Doe, John" && rfc822.addr_spec(&al, 0) == "j@x.org")
    rfc822.addr_free(&al)
    let d: rfc822.Date = rfc822.date_parse("Fri, 16 Oct 2026 09:19:00 +0200")
    check("date", d.ok && d.year == 2026 && d.month == 10 && d.tz_min == 120 && rfc822.date_epoch(&d) == 1792135140)
    var bd: rfc822.Builder = rfc822.builder_new()
    rfc822.builder_set_from(&bd, "a@b.c")
    rfc822.builder_add_to(&bd, "d@e.f")
    rfc822.builder_set_subject(&bd, "hi")
    rfc822.builder_set_text(&bd, "hello")
    rfc822.builder_attach(&bd, "x.bin", "", "AB".p as u64, 2)
    rt.buf_clear(&o)
    rfc822.builder_build(&bd, &o)
    var back: rfc822.Msg = rfc822.msg_parse(rt.buf_ptr(&o), rt.buf_len(&o))
    check("built parts", rfc822.parts_count(&back) == 3)
    rfc822.msg_free(&back)
    rfc822.builder_free(&bd)
    if failures == 0 {
        return 0
    }
    return 1
}
