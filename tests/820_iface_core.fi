// expect_exit: 0
// tests/820_iface_core.fi -- INTERFACES AND DYNAMIC DISPATCH (round 46).
//
// What makes `interface` in the language is checked in ONE program:
//
//   * one call site, several types: `f.area()` goes through the method
//     table, not through the static type
//   * `*self` (reading) and `*mut self` (writing) through the interface --
//     a change arrives at the REAL object
//   * the interface value is an ordinary value: parameter, return value,
//     field of a struct, element of an array, copyable
//   * two interfaces for the same type
//   * the methods stay callable statically (`r.area()`), and a free function
//     of the same name stands undisturbed next to it
//   * the order in the table follows the interface, not
//     the `impl` block
//
// Every return value != 0 names the place.

interface Area {
    fn area(*self) -> i64
    fn scale(*mut self, k: i64)
}

interface Name {
    fn id(*self) -> i64
}

struct Rect { b: i64, h: i64 }
struct Circle { r: i64 }
struct Dot { x: i64, y: i64 }

// FREE function `area` -- it has the same name as the method and stays reachable.
fn area(a: i64, b: i64) -> i64 {
    return a * b
}

impl Area for Rect {
    fn area(*self) -> i64 { return (*self).b * (*self).h }
    fn scale(*mut self, k: i64) {
        (*self).b = (*self).b * k
        (*self).h = (*self).h * k
    }
}

// The methods stand here in the REVERSE order of the interface.
// The table follows the interface all the same.
impl Area for Circle {
    fn scale(*mut self, k: i64) { (*self).r = (*self).r * k }
    fn area(*self) -> i64 { return 3 * (*self).r * (*self).r }
}

impl Name for Circle {
    fn id(*self) -> i64 { return 7 }
}

impl Name for Rect {
    fn id(*self) -> i64 { return 4 }
}

// A second `impl` block for the same type, without an interface: allowed,
// exactly as in round 45.
impl Rect {
    fn extent(*self) -> i64 { return 2 * ((*self).b + (*self).h) }
}

struct Entry { what: dyn Area, weight: i64 }

fn total(list: *mut [dyn Area; 3], n: usize) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < n {
        s = s + (*list)[i].area()
        i = i + 1
    }
    return s
}

fn duplicate(f: dyn Area) -> i64 {
    return f.area() * 2
}

fn first(a: dyn Area, b: dyn Area) -> dyn Area {
    if a.area() > b.area() {
        return a
    }
    return b
}

fn main() -> i32 {
    var r: Rect = Rect { b: 3, h: 4 }
    var k: Circle = Circle { r: 2 }

    // 1. the same call, two types
    let fr: dyn Area = (&r) as dyn Area
    let fk: dyn Area = (&k) as dyn Area
    if fr.area() != 12 {
        return 1
    }
    if fk.area() != 12 {
        return 2
    }

    // 2. a writing method through the interface: it hits the object
    fk.scale(3)
    if k.r != 6 {
        return 3
    }
    if fk.area() != 108 {
        return 4
    }
    fr.scale(2)
    if r.b != 6 || r.h != 8 {
        return 5
    }

    // 3. as an argument (aggregate in two registers)
    if duplicate(fr) != 96 {
        return 6
    }

    // 4. as a return value
    let greater: dyn Area = first(fr, fk)
    if greater.area() != 108 {
        return 7
    }

    // 5. field of a struct
    let e: Entry = Entry { what: fr, weight: 2 }
    if e.what.area() * e.weight != 96 {
        return 8
    }

    // 6. array: one loop, three types
    var r2: Rect = Rect { b: 1, h: 5 }
    var field: [dyn Area; 3] = [fr, fk, (&r2) as dyn Area]
    if total(&field, 3) != 48 + 108 + 5 {
        return 9
    }

    // 7. a second interface on the same types
    let nk: dyn Name = (&k) as dyn Name
    let nr: dyn Name = (&r) as dyn Name
    if nk.id() != 7 || nr.id() != 4 {
        return 10
    }

    // 8. static call of the same method -- still possible
    if r.area() != 48 {
        return 11
    }
    if r.extent() != 28 {
        return 12
    }

    // 9. the free function of the same name is not hidden
    if area(6, 7) != 42 {
        return 13
    }

    // 10. a copy of an interface value points at the same object
    var copy: dyn Area = fk
    copy.scale(2)
    if k.r != 12 {
        return 14
    }
    if fk.area() != 432 {
        return 15
    }

    // 11. the value is TWO WORDS in size -- data pointer and method table.
    // Measured through the distance of two elements of the array, without `size_of`.
    let a0: u64 = (&field[0]) as u64
    let a1: u64 = (&field[1]) as u64
    if a1 - a0 != 16 {
        return 16
    }
    return 0
}
