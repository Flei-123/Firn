// expect_exit: 0
// tests/820_iface_core.fi — SCHNITTSTELLEN UND DYNAMISCHER VERSAND (Runde 46).
//
// Geprueft wird in EINEM Programm, was `interface` in der Sprache ausmacht:
//
//   * eine Aufrufstelle, mehrere Typen: `f.flaeche()` laeuft ueber die
//     Methodentafel, nicht ueber den statischen Typ
//   * `*self` (lesend) und `*mut self` (schreibend) ueber die Schnittstelle —
//     eine Aenderung kommt beim ECHTEN Objekt an
//   * der Schnittstellenwert ist ein gewoehnlicher Wert: Parameter,
//     Rueckgabewert, Feld eines Structs, Element eines Arrays, kopierbar
//   * zwei Schnittstellen fuer denselben Typ
//   * die Methoden bleiben statisch aufrufbar (`r.flaeche()`), und eine
//     gleichnamige freie Funktion steht ungestoert daneben
//   * die Reihenfolge in der Tafel richtet sich nach der Schnittstelle, nicht
//     nach dem `impl`-Block
//
// Every return value != 0 names the place.

interface Area {
    fn area(*self) -> i64
    fn scale(*mut self, k: i64)
}

interface Name {
    fn id(*self) -> i64
}

struct Rect { b: i64, h: i64 }
struct Circle { r: i64 }
struct Dot { x: i64, y: i64 }

// FREIE Funktion `flaeche` — sie heisst wie die Methode und bleibt erreichbar.
fn area(a: i64, b: i64) -> i64 {
    return a * b
}

impl Area for Rect {
    fn area(*self) -> i64 { return (*self).b * (*self).h }
    fn scale(*mut self, k: i64) {
        (*self).b = (*self).b * k
        (*self).h = (*self).h * k
    }
}

// Die Methoden stehen hier in der UMGEKEHRTEN Reihenfolge der Schnittstelle.
// Die Tafel richtet sich trotzdem nach der Schnittstelle.
impl Area for Circle {
    fn scale(*mut self, k: i64) { (*self).r = (*self).r * k }
    fn area(*self) -> i64 { return 3 * (*self).r * (*self).r }
}

impl Name for Circle {
    fn id(*self) -> i64 { return 7 }
}

impl Name for Rect {
    fn id(*self) -> i64 { return 4 }
}

// Ein zweiter `impl`-Block fuer denselben Typ, ohne Schnittstelle: erlaubt,
// genau wie in Runde 45.
impl Rect {
    fn extent(*self) -> i64 { return 2 * ((*self).b + (*self).h) }
}

struct Entry { what: dyn Area, weight: i64 }

fn total(list: *mut [dyn Area; 3], n: usize) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < n {
        s = s + (*list)[i].area()
        i = i + 1
    }
    return s
}

fn duplicate(f: dyn Area) -> i64 {
    return f.area() * 2
}

fn first(a: dyn Area, b: dyn Area) -> dyn Area {
    if a.area() > b.area() {
        return a
    }
    return b
}

fn main() -> i32 {
    var r: Rect = Rect{ b: 3, h: 4 }
    var k: Circle = Circle{ r: 2 }

    // 1. derselbe Aufruf, zwei Typen
    let fr: dyn Area = (&r) as dyn Area
    let fk: dyn Area = (&k) as dyn Area
    if fr.area() != 12 {
        return 1
    }
    if fk.area() != 12 {
        return 2
    }

    // 2. schreibende Methode ueber die Schnittstelle: sie trifft das Objekt
    fk.scale(3)
    if k.r != 6 {
        return 3
    }
    if fk.area() != 108 {
        return 4
    }
    fr.scale(2)
    if r.b != 6 || r.h != 8 {
        return 5
    }

    // 3. als Argument (Aggregat in zwei Registern)
    if duplicate(fr) != 96 {
        return 6
    }

    // 4. als Rueckgabewert
    let greater: dyn Area = first(fr, fk)
    if greater.area() != 108 {
        return 7
    }

    // 5. Feld eines Structs
    let e: Entry = Entry{ what: fr, weight: 2 }
    if e.what.area() * e.weight != 96 {
        return 8
    }

    // 6. Array: eine Schleife, drei Typen
    var r2: Rect = Rect{ b: 1, h: 5 }
    var field: [dyn Area; 3] = [fr, fk, (&r2) as dyn Area]
    if total(&field, 3) != 48 + 108 + 5 {
        return 9
    }

    // 7. zweite Schnittstelle auf denselben Typen
    let nk: dyn Name = (&k) as dyn Name
    let nr: dyn Name = (&r) as dyn Name
    if nk.id() != 7 || nr.id() != 4 {
        return 10
    }

    // 8. statischer Aufruf derselben Methode — unveraendert moeglich
    if r.area() != 48 {
        return 11
    }
    if r.extent() != 28 {
        return 12
    }

    // 9. die gleichnamige freie Funktion ist nicht verdeckt
    if area(6, 7) != 42 {
        return 13
    }

    // 10. Kopie eines Schnittstellenwertes zeigt auf dasselbe Objekt
    var copy: dyn Area = fk
    copy.scale(2)
    if k.r != 12 {
        return 14
    }
    if fk.area() != 432 {
        return 15
    }

    // 11. der Wert ist ZWEI WOERTER gross — Datenzeiger und Methodentafel.
    // Gemessen am Abstand zweier Elemente des Arrays, ohne `size_of`.
    let a0: u64 = (&field[0]) as u64
    let a1: u64 = (&field[1]) as u64
    if a1 - a0 != 16 {
        return 16
    }
    return 0
}
