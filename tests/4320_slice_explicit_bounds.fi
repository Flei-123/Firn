// expect_exit: 0
// tests/4320_slice_explicit_bounds.fi -- r744: an explicit bound i64::MAX-1 is a real bound, not "omitted".
import std.rt
import std.vec
import std.str
import std.pystr
import std.testkit

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i64] = vec_new[i64]()
    var i: i64 = 0
    while i < 6 {
        vec_push[i64](&v, i)
        i = i + 1
    }
    let big: i64 = 9223372036854775806
    // positive step: start = big is past the end -> empty; omitted start -> everything
    var e1: Vec[i64] = v[big::1]
    testkit.check(vec_len[i64](&e1) == 0, "explicit big start, step 1")
    var e2: Vec[i64] = v[::1]
    testkit.check(vec_len[i64](&e2) == 6, "omitted start, step 1")
    // negative step: stop = big clamps to the last index -> empty; omitted stop -> down to index 0
    var e3: Vec[i64] = v[:big:-1]
    testkit.check(vec_len[i64](&e3) == 0, "explicit big stop, step -1")
    var e4: Vec[i64] = v[::-1]
    testkit.check(vec_len[i64](&e4) == 6 && e4[0] == 5 && e4[5] == 0, "omitted bounds, step -1")
    var e5: Vec[i64] = v[big::-2]
    testkit.check(vec_len[i64](&e5) == 3 && e5[0] == 5 && e5[2] == 1, "big start, step -2")
    var e6: Vec[i64] = v[1:big:2]
    testkit.check(vec_len[i64](&e6) == 3 && e6[0] == 1 && e6[2] == 5, "big stop, step 2")
    // str: the sugar needs the same flags
    let s: str = "hello world"
    testkit.check(s[:big:-1] == "", "str explicit big stop, step -1")
    testkit.check(s[::-1] == "dlrow olleh", "str omitted, step -1")
    testkit.check(s[big::1] == "", "str explicit big start, step 1")
    vec_free[i64](&v)
    vec_free[i64](&e2)
    vec_free[i64](&e4)
    vec_free[i64](&e5)
    vec_free[i64](&e6)
    return testkit.finish()
}
