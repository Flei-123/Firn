// expect_exit: 0
import mc.mc_item_dur

fn check(name: str, want: i32, code: i32) -> i32 {
    if mc_item_dur.dur_max(name.p as u64, name.n) != want { return code }
    return 0
}

fn main() -> i32 {
    if check("wooden_sword", 59, 1) != 0 { return 1 }
    if check("diamond_pickaxe", 1561, 2) != 0 { return 2 }
    if check("netherite_hoe", 2031, 3) != 0 { return 3 }
    if check("golden_axe", 32, 4) != 0 { return 4 }
    if check("leather_helmet", 55, 5) != 0 { return 5 }
    if check("iron_chestplate", 240, 6) != 0 { return 6 }
    if check("diamond_leggings", 495, 7) != 0 { return 7 }
    if check("diamond_boots", 429, 8) != 0 { return 8 }
    if check("netherite_helmet", 407, 9) != 0 { return 9 }
    if check("chainmail_boots", 195, 10) != 0 { return 10 }
    if check("golden_chestplate", 112, 11) != 0 { return 11 }
    if check("bow", 384, 12) != 0 { return 12 }
    if check("turtle_helmet", 275, 13) != 0 { return 13 }
    if check("elytra", 432, 14) != 0 { return 14 }
    if check("stone", 0, 15) != 0 { return 15 }
    if check("iron_horse_armor", 0, 16) != 0 { return 16 }
    if check("iron_ingot", 0, 17) != 0 { return 17 }
    return 0
}
