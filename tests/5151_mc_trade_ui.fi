// expect_exit: 0
import mc.mc_trade
import mc.mc_trade_ui

fn main() -> i32 {
    if mc_trade_ui.tui_row_hit(100, 50, 2, 100 + 10 * 2, 50 + 17 * 2 + 1) != 0 { return 1 }
    if mc_trade_ui.tui_row_hit(100, 50, 2, 100 + 10 * 2, 50 + (17 + 20 * 6 + 19) * 2) != 6 { return 2 }
    if mc_trade_ui.tui_row_hit(100, 50, 2, 100 + 10 * 2, 50 + (17 + 140) * 2) != 0 - 1 { return 3 }
    if mc_trade_ui.tui_row_hit(100, 50, 2, 100 + 94 * 2, 50 + 40 * 2) != 0 - 1 { return 4 }
    if mc_trade_ui.tui_row_hit(100, 50, 2, 100 + 4 * 2, 50 + 40 * 2) != 0 - 1 { return 5 }
    var x: i32 = 0
    var y: i32 = 0
    mc_trade_ui.tui_item_xy(2, mc_trade_ui.TUI_RESULT, &x, &y)
    if x != 73 || y != 59 { return 6 }
    mc_trade_ui.tui_item_xy(0, mc_trade_ui.TUI_COST_A, &x, &y)
    if x != 10 || y != 19 { return 7 }
    mc_trade_ui.tui_item_xy(0, mc_trade_ui.TUI_COST_B, &x, &y)
    if x != 40 { return 8 }
    if mc_trade_ui.tui_item_at(0, 0, 1, 11, 20, 3) != 0 { return 9 }
    if mc_trade_ui.tui_item_at(0, 0, 1, 74, 60, 3) != 2 * 3 + 2 { return 10 }
    if mc_trade_ui.tui_item_at(0, 0, 1, 74, 60, 2) != 0 - 1 { return 11 }
    if !mc_trade_ui.tui_scroller_hit(0, 0, 1, 96, 30) || mc_trade_ui.tui_scroller_hit(0, 0, 1, 101, 30) { return 12 }
    var t: mc_trade.Trades = mc_trade.tr_new()
    t.n = 12
    mc_trade_ui.tui_scroll_from_y(&t, 0, 1, 0)
    if mc_trade.tr_scroll(&t) != 0 { return 13 }
    mc_trade_ui.tui_scroll_from_y(&t, 0, 1, 400)
    if mc_trade.tr_scroll(&t) != 5 { return 14 }
    mc_trade_ui.tui_scroll_from_y(&t, 0, 1, 18 + 13 + 56)
    if mc_trade.tr_scroll(&t) != 2 && mc_trade.tr_scroll(&t) != 3 { return 15 }
    return 0
}
