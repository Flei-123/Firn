012000000000000, 0x4013000000000000, 0x4009000000000000, 0x4007000000000000, 0x3fd0000000000000, 0x3fec000000000000, 0x4000000000000000, 0x3ffc000000000000, 0x3ff8000000000000, 0x4010000000000000, 0x4014000000000000, 0x400a000000000000, 0x400f000000000000, 0x4012000000000000, 0x4010000000000000, 0x4006000000000000, 0x4013800000000000, 0x3ff8000000000000, 0x400d000000000000, 0x3fe0000000000000, 0x40709a0000000000, 0x4001000000000000, 0x3ffc000000000000, 0x400b000000000000, 0x4011800000000000, 0x404b580000000000, 0x4019000000000000, 0x404c200000000000, 0x4041f80000000000, 0x4037700000000000, 0x403c200000000000, 0x4003000000000000, 0x3ffa000000000000, 0x400c000000000000, 0x400e000000000000, 0x3fe0000000000000, 0x4013800000000000, 0x3ffc000000000000, 0x407d4c0000000000, 0x4047700000000000, 0x4071940000000000, 0x402f400000000000, 0x4079640000000000, 0x4081940000000000, 0x4046a80000000000, 0x4012c00000000000, 0x4034500000000000, 0x4079640000000000, 0x407f400000000000, 0x405b580000000000, 0x40757c0000000000, 0x4076760000000000, 0x3ff4000000000000, 0x4013800000000000, 0x400d000000000000, 0x4013800000000000, 0x4010800000000000, 0x3ffa000000000000, 0x4010000000000000, 0x3ff2000000000000, 0x3ff0000000000000, 0x3ff4000000000000, 0x405f400000000000, 0x4061940000000000, 0x4079640000000000, 0x4069640000000000, 0x407f400000000000, 0x4053880000000000, 0x400b000000000000, 0x4012000000000000, 0x3ffc000000000000, 0x407d4c0000000000, 0x403f400000000000, 0x4022c00000000000, 0x4042c00000000000, 0x4035e00000000000, 0x403db00000000000, 0x3ffc000000000000, 0x4011000000000000, 0x3ffa000000000000, 0x3ff0000000000000, 0x3ff8000000000000, 0x4010000000000000, 0x4029000000000000, 0x4003000000000000, 0x4013000000000000, 0x4013800000000000, 0x4006000000000000, 0x4074820000000000, 0x4071940000000000, 0x40801d0000000000, 0x4037700000000000, 0x4009000000000000, 0x4049000000000000, 0x403c200000000000, 0x4004000000000000, 0x4002000000000000, 0x3fe4000000000000, 0x4011000000000000, 0x4071940000000000, 0x407f400000000000, 0x3ff2000000000000, 0x4002000000000000, 0x3ffe000000000000, 0x3fe8000000000000, 0x3ff6000000000000, 0x4002000000000000, 0x4008000000000000, 0x3ff2000000000000, 0x4012000000000000, 0x4010000000000000, 0x4010800000000000, 0x4014000000000000, 0x3fe0000000000000, 0x3ff6000000000000, 0x4011000000000000, 0x4057700000000000, 0x4084050000000000, 0x4069640000000000, 0x4081940000000000, 0x407c520000000000, 0x406b580000000000, 0x402f400000000000, 0x406f400000000000, 0x400f000000000000, 0x400e000000000000, 0x3ffe000000000000, 0x4013800000000000, 0x3fd0000000000000, 0x400d000000000000, 0x4069640000000000] }
fn main() -> i32 {
    if !gc_init() { return 1 }
    let ln: [u64; 80] = lens()
    let xd: [u64; 871] = xs()
    let yd: [u64; 871] = ys()
    let w: [u64; 2800] = want()
    let ml: [u64; 80] = mm_lens()
    let md: [u64; 229] = mm_data()
    var pos: usize = 0
    var mpos: usize = 0
    var bad_exact: usize = 0
    var bad_close: usize = 0
    var bad_mm: usize = 0
    for c in 0..(80 as usize) {
        var x: Vec[f64] = vec_new[f64]()
        var y: Vec[f64] = vec_new[f64]()
        for k in 0..(ln[c] as usize) {
            vec_push[f64](&x, f(xd[pos + k]))
            vec_push[f64](&y, f(yd[pos + k]))
        }
        pos = pos + (ln[c] as usize)
        let b: usize = c * 35
        if !same(statx.median_low(&x), f(w[b])) { bad_exact = bad_exact + 1 }
        if !same(statx.median_high(&x), f(w[b + 1])) { bad_exact = bad_exact + 1 }
        if !close(statx.fmean(&x), f(w[b + 2])) { bad_close = bad_close + 1 }
        if !close(statx.geometric_mean(&x), f(w[b + 3])) { bad_close = bad_close + 1 }
        if !close(statx.harmonic_mean(&x), f(w[b + 4])) { bad_close = bad_close + 1 }
        var md1: f64 = 0.0
        stat_mode[f64](&x, &md1)
        if !same(md1, f(w[b + 5])) { bad_exact = bad_exact + 1 }
        var mm: Vec[f64] = vec_new[f64]()
        stat_multimode[f64](&x, &mm)
        if (vec_len[f64](&mm) as u64) != ml[c] { bad_mm = bad_mm + 1 }
        else {
            for k in 0..(ml[c] as usize) {
                if !same(*vec_elem_ptr[f64](&mm, k), f(md[mpos + k])) { bad_mm = bad_mm + 1 }
            }
        }
        mpos = mpos + (ml[c] as usize)
        vec_free[f64](&mm)
        if !close(statx.covariance(&x, &y), f(w[b + 7])) { bad_close = bad_close + 1 }
        if !close(statx.correlation(&x, &y), f(w[b + 8])) { bad_close = bad_close + 1 }
        var sl: f64 = 0.0
        var ic: f64 = 0.0
        if !statx.linear_regression(&x, &y, &sl, &ic) { bad_close = bad_close + 1 }
        if !close(sl, f(w[b + 9])) { bad_close = bad_close + 1 }
        if !close(ic, f(w[b + 10])) { bad_close = bad_close + 1 }
        var q: Vec[f64] = vec_new[f64]()
        statx.quantiles(&x, 4, false, &q)
        statx.quantiles(&x, 4, true, &q)
        statx.quantiles(&x, 10, false, &q)
        statx.quantiles(&x, 10, true, &q)
        if vec_len[f64](&q) != 24 { bad_exact = bad_exact + 1 }
        else {
            for k in 0..(24 as usize) {
                if !same(*vec_elem_ptr[f64](&q, k), f(w[b + 11 + k])) { bad_exact = bad_exact + 1 }
            }
        }
        vec_free[f64](&q)
        vec_free[f64](&x)
        vec_free[f64](&y)
    }
    testkit.check(bad_exact == 0, "median_low/high, mode, quantiles bit-exact (80 sets)")
    testkit.check(bad_mm == 0, "multimode (80 sets)")
    testkit.check(bad_close == 0, "fmean/geometric/harmonic/covariance/correlation/regression within 1e-11")
    return testkit.finish()
}

