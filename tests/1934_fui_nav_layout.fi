// expect_exit: 0
import fui.nav_layout
import std.rt

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn r_is(r: nav_layout.Rect, x: i32, y: i32, w: i32, h: i32) -> bool {
    return r.x == x && r.y == y && r.w == w && r.h == h
}

fn overlap(a: nav_layout.Rect, b: nav_layout.Rect) -> bool {
    if a.w == 0 || b.w == 0 || a.h == 0 || b.h == 0 { return false }
    return a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h
}

fn main() -> i32 {
    check("mode wide", nav_layout.nlay_mode(1100) == nav_layout.NL_WIDE && nav_layout.nlay_mode(1920) == nav_layout.NL_WIDE)
    check("mode mid", nav_layout.nlay_mode(1099) == nav_layout.NL_MID && nav_layout.nlay_mode(700) == nav_layout.NL_MID)
    check("mode stack", nav_layout.nlay_mode(699) == nav_layout.NL_STACK && nav_layout.nlay_mode(320) == nav_layout.NL_STACK && nav_layout.nlay_mode(0) == nav_layout.NL_STACK)

    var p: nav_layout.LayoutParams = nav_layout.nlay_params()
    var l: nav_layout.Layout = nav_layout.nlay_compute(1400, 800, &p)
    check("wide rail", r_is(l.rail, 0, 0, 64, 800))
    check("wide list", r_is(l.list, 64, 0, 320, 800))
    check("wide content", r_is(l.content, 384, 0, 1016, 800))
    check("wide no detail", l.detail.w == 0 && !l.detail_overlay && l.tabbar.h == 0)
    p.detail_open = true
    l = nav_layout.nlay_compute(1400, 800, &p)
    check("wide detail", r_is(l.detail, 1120, 0, 280, 800) && r_is(l.content, 384, 0, 736, 800))
    check("wide four columns tile", l.rail.x + l.rail.w == l.list.x && l.list.x + l.list.w == l.content.x && l.content.x + l.content.w == l.detail.x && l.detail.x + l.detail.w == 1400)
    l = nav_layout.nlay_compute(1100, 700, &p)
    check("wide at breakpoint", l.mode == nav_layout.NL_WIDE && l.content.w >= 360 && l.list.w == 320 && l.content.w == 436)
    check("wide no overlap", !overlap(l.rail, l.list) && !overlap(l.list, l.content) && !overlap(l.content, l.detail))

    l = nav_layout.nlay_compute(900, 600, &p)
    check("mid mode", l.mode == nav_layout.NL_MID && r_is(l.rail, 0, 0, 64, 600))
    check("mid list share", l.list.w == 836 * 36 / 100 && l.list.x == 64)
    check("mid content", l.content.x == 64 + l.list.w && l.content.x + l.content.w == 900)
    check("mid detail is overlay", l.detail_overlay && l.detail.x + l.detail.w == 900 && l.detail.w <= 280 && l.detail.w > 0)
    p.detail_open = false
    l = nav_layout.nlay_compute(900, 600, &p)
    check("mid detail closed", !l.detail_overlay && l.detail.w == 0)
    l = nav_layout.nlay_compute(700, 600, &p)
    check("mid lower edge", l.mode == nav_layout.NL_MID && l.list.w + l.content.w + 64 == 700 && l.content.w >= 300)

    l = nav_layout.nlay_compute(400, 800, &p)
    check("stack list", l.mode == nav_layout.NL_STACK && r_is(l.list, 0, 0, 400, 744) && r_is(l.tabbar, 0, 744, 400, 56))
    check("stack no rail", l.rail.w == 0 && l.content.w == 0 && l.detail.w == 0)
    p.page = nav_layout.NL_PAGE_CONTENT
    l = nav_layout.nlay_compute(400, 800, &p)
    check("stack content full", r_is(l.content, 0, 0, 400, 800) && l.list.w == 0 && l.tabbar.h == 0)
    p.page = nav_layout.NL_PAGE_DETAIL
    l = nav_layout.nlay_compute(400, 800, &p)
    check("stack detail full", r_is(l.detail, 0, 0, 400, 800) && l.content.w == 0 && l.page == nav_layout.NL_PAGE_DETAIL)

    l = nav_layout.nlay_compute(0, 0, &p)
    check("zero size", l.detail.w >= 0 && l.list.w >= 0 && l.content.w >= 0)
    p.page = nav_layout.NL_PAGE_LIST
    l = nav_layout.nlay_compute(300, 40, &p)
    check("short window never negative", l.list.h >= 0 && l.tabbar.y >= -16)

    p.list_w = 5000
    l = nav_layout.nlay_compute(1200, 700, &p)
    check("huge list width is capped", l.content.w >= 360)
    check("rect has", nav_layout.nlay_rect_has(l.rail, 10, 10) && !nav_layout.nlay_rect_has(l.rail, 64, 10) && !nav_layout.nlay_rect_has(l.rail, 10, 700))

    var w: i32 = 200
    var ok: bool = true
    while w <= 1800 {
        var q: nav_layout.LayoutParams = nav_layout.nlay_params()
        q.detail_open = (w / 7) % 2 == 0
        let t: nav_layout.Layout = nav_layout.nlay_compute(w, 700, &q)
        if t.mode != nav_layout.NL_STACK {
            if t.content.w < 0 || t.list.w < 0 || overlap(t.list, t.content) || overlap(t.rail, t.list) { ok = false }
            if !t.detail_overlay && overlap(t.content, t.detail) { ok = false }
            if t.content.x + t.content.w > w { ok = false }
        }
        w = w + 13
    }
    check("sweep keeps columns apart", ok)

    if failures == 0 {
        rt.write_everything(1, "ok\n".p as u64, 3)
    }
    return failures
}
