// expect_exit: 42
import std.time

const K_SLEEPER: u64 = 1

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == K_SLEEPER {
        time.sleep_ms(arg)
        return 7
    }
    return 0
}

fn main() -> i32 {
    let h: u64 = thread_start(K_SLEEPER, 3000)
    if h == 0 { return 1 as i32 }
    time.sleep_ms(200)
    let a: u64 = time.monotonic_ns()
    gc_collect()
    let b: u64 = time.monotonic_ns()
    if b - a > 1000000000 { return 2 as i32 }
    if thread_wait(h) != 7 { return 3 as i32 }
    return 42 as i32
}
