// expect_exit: 0
// ROUND 58 -- FUNCTIONS AS VALUES, part 1: the function pointer.
//
// The type `fn(A, B) -> R` is ONE machine word: the address of a FUNCTION
// RECORD whose word 0 holds the code address (docs/ROUND58.md). What is
// checked here is everything a value has to be able to do:
//
//   * take a named function as a value, with and without a type annotation
//   * hand it over as a parameter and get it back as a result
//   * keep it in a struct field, in an array and -- through a wrapper
//     struct -- in a Vec (an HONEST LIMIT: a function type as the type
//     ARGUMENT of a template, `Vec[fn(i32) -> i32]`, does not work; see
//     docs/ROUND58.md)
//   * call it through the pointer, with 0, 1, 2 and 6 arguments
//   * a function WITHOUT a result as a value
//   * compare two function values (a pointer comparison)

import std.vec

fn add(a: i32, b: i32) -> i32 { return a + b }
fn sub(a: i32, b: i32) -> i32 { return a - b }
fn zero() -> i32 { return 0 }
fn six(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) -> i32 {
    return a + b + c + d + e + f
}

// No result: only its EFFECT is visible, through a pointer.
fn note(sum: *mut i32, v: i32) { *sum = *sum + v }

fn apply(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 { return f(a, b) }

fn pick(which: bool) -> fn(i32, i32) -> i32 {
    if which {
        return add
    }
    return sub
}

struct Op2 { f: fn(i32, i32) -> i32, tag: i32 }
// The wrapper for the Vec: `Vec[Op2]` works, `Vec[fn(i32, i32) -> i32]`
// does not (a function type as a type ARGUMENT is not implemented).
struct Slot { f: fn(i32, i32) -> i32 }

fn main() -> i32 {
    // 1. as a value, with and without an annotation
    let f: fn(i32, i32) -> i32 = add
    let g = sub
    if f(10, 3) != 13 { return 1 }
    if g(10, 3) != 7 { return 2 }

    // 2. as a parameter
    if apply(add, 2, 3) != 5 { return 3 }
    if apply(g, 2, 3) != -1 { return 4 }

    // 3. as a result
    let h: fn(i32, i32) -> i32 = pick(false)
    if h(9, 4) != 5 { return 5 }

    // 4. in a struct field
    let o: Op2 = Op2 { f: add, tag: 7 }
    let of: fn(i32, i32) -> i32 = o.f
    if of(1, 1) != 2 { return 6 }
    if o.tag != 7 { return 7 }

    // 5. in an array
    var tab: [fn(i32, i32) -> i32; 2] = [add; 2]
    tab[1] = sub
    let t0: fn(i32, i32) -> i32 = tab[0]
    let t1: fn(i32, i32) -> i32 = tab[1]
    if t0(8, 5) != 13 { return 8 }
    if t1(8, 5) != 3 { return 9 }

    // 6. in a Vec (through the wrapper struct)
    var v: Vec[Slot] = vec_new[Slot]()
    defer vec_free[Slot](&v)
    vec_push[Slot](&v, Slot { f: add })
    vec_push[Slot](&v, Slot { f: sub })
    let s0: *mut Slot = vec_elem_ptr[Slot](&v, 0)
    let s1: *mut Slot = vec_elem_ptr[Slot](&v, 1)
    let e0: fn(i32, i32) -> i32 = (*s0).f
    let e1: fn(i32, i32) -> i32 = (*s1).f
    if e0(4, 4) != 8 { return 10 }
    if e1(4, 4) != 0 { return 11 }

    // 7. no argument, six arguments
    let z: fn() -> i32 = zero
    if z() != 0 { return 12 }
    let s6: fn(i32, i32, i32, i32, i32, i32) -> i32 = six
    if s6(1, 2, 3, 4, 5, 6) != 21 { return 13 }

    // 8. without a result
    var sum: i32 = 0
    let n: fn(*mut i32, i32) = note
    n(&sum, 5)
    n(&sum, 6)
    if sum != 11 { return 14 }

    // 9. two values of the same function are the same pointer
    let a1: fn(i32, i32) -> i32 = add
    let a2: fn(i32, i32) -> i32 = add
    if a1 != a2 { return 15 }
    if a1 == g { return 16 }
    return 0
}
