// expect_exit: 0
// tests/2730_mc_mesh_basic.fi -- mc_mesh on real mc_chunk sections: a single block, neighbours,
// "unknown" neighbours, greedy merging. The 128-mesh brute-force comparison is tools/mc/mesh/run.sh.
import std.rt
import mc.mc_chunk
import mc.mc_mesh

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn tables(t: *mut mc_mesh.MeshTables) {
    let opaque: u64 = rt.heap_alloc(32768)
    let tiles: u64 = rt.heap_alloc(32768 * 6 * 2)
    var i: usize = 0
    while i < 32768 {
        rt.st8(opaque, i, 0 as u8)
        i = i + 1
    }
    i = 0
    while i < 32768 * 6 {
        rt.st16(tiles, i, 0 as u16)
        i = i + 1
    }
    var f: usize = 0
    while f < 6 {
        rt.st16(tiles, 1 * 6 + f, (11 + f) as u16)
        rt.st16(tiles, 2 * 6 + f, (21 + f) as u16)
        f = f + 1
    }
    rt.st8(opaque, 1, 1 as u8)
    rt.st8(opaque, 2, 1 as u8)
    (*t).opaque = opaque
    (*t).tiles = tiles
}

fn make_section(ids: u64, sec: *mut mc_chunk.Section) -> bool {
    return mc_mesh.section_pack(ids, sec)
}

fn main() -> i32 {
    var t: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    tables(&t)
    var m: mc_mesh.Mesher = mc_mesh.mesher_new()
    let ids: u64 = rt.heap_alloc(4096 * 2)
    var i: usize = 0
    while i < 4096 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    // a single block in the middle: 6 visible faces, 6 quads, 24 vertices, 36 indices
    rt.st16(ids, (8 * 16 + 8) * 16 + 8, 1 as u16)
    var sec: mc_chunk.Section = mc_chunk.Section { count: 0, blocks: mc_chunk.Container { bits: 0 as u32, pal_n: 0 as u32, pal: 0, data: 0, words: 0 }, biomes: mc_chunk.Container { bits: 0 as u32, pal_n: 0 as u32, pal: 0, data: 0, words: 0 } }
    check(make_section(ids, &sec), 1)
    let none: u64 = rt.heap_alloc(48)
    i = 0
    while i < 6 {
        rt.st64(none, i, 0 as u64)
        i = i + 1
    }
    mc_mesh.mesh_section(&m, &sec, none, mc_mesh.MISSING_AIR, &t, mc_mesh.F_GREEDY | mc_mesh.F_AO)
    check(m.nquads == 6 as u32 && m.nverts == 24 as u32 && m.nidx == 36 as u32 && m.nfaces == 6 as u32, 2)
    check(mc_mesh.mesh_used_bytes(&m) == 24 * 8 + 36 * 4, 3)
    mc_mesh.section_free(&sec)

    // a full section of stone: only the 6 outer faces, merged to 6 big quads by greedy; naive: 6 * 256
    i = 0
    while i < 4096 {
        rt.st16(ids, i, 1 as u16)
        i = i + 1
    }
    check(make_section(ids, &sec), 4)
    mc_mesh.mesh_section(&m, &sec, none, mc_mesh.MISSING_AIR, &t, mc_mesh.F_GREEDY)
    check(m.nquads == 6 as u32 && m.nfaces == 1536 as u32, 5)
    mc_mesh.mesh_section(&m, &sec, none, mc_mesh.MISSING_AIR, &t, 0 as u32)
    check(m.nquads == 1536 as u32, 6)
    // unknown neighbours: no faces toward them at all
    mc_mesh.mesh_section(&m, &sec, none, mc_mesh.MISSING_UNKNOWN, &t, mc_mesh.F_GREEDY)
    check(m.nquads == 0 as u32, 7)
    // a loaded opaque neighbour above (+y, index 3) hides the top; the rest stays
    let nbp: u64 = rt.heap_alloc(256) // a Section lives on the heap here: its address is stored in memory
    check(make_section(ids, nbp as *mut mc_chunk.Section), 8)
    let nbrs: u64 = rt.heap_alloc(48)
    i = 0
    while i < 6 {
        rt.st64(nbrs, i, 0 as u64)
        i = i + 1
    }
    rt.st64(nbrs, 3, nbp)
    mc_mesh.mesh_section(&m, &sec, nbrs, mc_mesh.MISSING_AIR, &t, mc_mesh.F_GREEDY)
    check(m.nquads == 5 as u32 && m.nfaces == 1280 as u32, 9)
    mc_mesh.section_free(nbp as *mut mc_chunk.Section)
    rt.heap_free(nbp, 256)
    mc_mesh.section_free(&sec)

    // the vertex words round trip
    check(mc_mesh.vtx_tile(11 as u32 | (3 as u32 << 16 as u32)) == 11 as u32, 10)
    check(mc_mesh.vtx_u(11 as u32 | (3 as u32 << 16 as u32)) == 3 as u32, 11)
    mc_mesh.mesher_free(&m)
    rt.heap_free(none, 48)
    rt.heap_free(nbrs, 48)
    rt.heap_free(ids, 4096 * 2)
    return 0
}
