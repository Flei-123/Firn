// Bindet ein Modul aus DEMSELBEN Verzeichnis ein. Vor Runde 17 ging das nicht:
// der Pfad wurde relativ zur Wurzeldatei gesucht, also in `tests/`.
import tief

export { mittel_wert, GenPaar, gen_summe }

fn mittel_wert() -> i64 {
    return tief.tief_wert() * 6
}

// Eine generische Vorlage, die ein Modul anbietet. Vor Runde 17 war sie
// unbenutzbar: die Wurzeldatei kannte den Namen nicht, weil die Vorabsuche
// nach Vorlagen je Datei UNMITTELBAR vor deren Parsen lief.
struct GenPaar[T] {
    a: T,
    b: T,
}

fn gen_summe[T: Scalar](p: *mut GenPaar[T]) -> T {
    return (*p).a + (*p).b
}
