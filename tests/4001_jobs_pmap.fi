// expect_exit: 0
// tests/4001_jobs_pmap.fi -- jobs_map_texts: f gets the path and the file text,
// results in path order on 0 and 3 workers, empty files, an unreadable path
// leaves a zeroed slot and does not call f, a repeated call clears `out`.
import std.io
import std.rt
import std.fs
import std.fsx
import std.vec
import std.testkit
import jobs.jobs
import jobs.pmap

struct Info { n: u64, nl: u64, first: u8 }

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0
}

fn info(path: *str, text: *str, out: *mut Info) {
    var nl: u64 = 0
    var first: u8 = 0 as u8
    for i in 0..(*text).n {
        let c: u8 = *(((*text).p as u64 + i as u64) as *mut u8)
        if i == 0 { first = c }
        if c == (10 as u8) { nl = nl + 1 }
    }
    *out = Info { n: (*text).n as u64, nl: nl, first: first }
}

#[allow_escape]
fn run(j: *mut jobs.Jobs, count: usize, label: str) -> FsError!bool {
    var dir: fsx.TempDir = try fsx.temp_dir("pmap_")
    defer fsx.temp_dir_drop(&dir)
    let root: str = fsx.temp_dir_path(&dir)
    var paths: Vec[str] = vec_new[str]()
    for i in 0..count {
        let p: str = io.fmt_string(f"{root}/f{i}.txt")
        var b: rt.Buf = rt.buf_new()
        for k in 0..i % 50 { io.fmt_content(f"x{k}\n", &b) }
        try fs.write_file(p, rt.buf_ptr(&b), rt.buf_len(&b))
        rt.buf_free(&b)
        vec_push[str](&paths, p)
    }
    var res: Vec[Info] = vec_new[Info]()
    var ok: bool = jobs_map_texts[Info](j, &paths, info, &res) && vec_len[Info](&res) == count
    for i in 0..count {
        let r: Info = *vec_elem_ptr[Info](&res, i)
        let lines: u64 = (i % 50) as u64
        if r.nl != lines { ok = false }
        if lines == 0 && r.n != 0 { ok = false }
        if lines > 0 && r.first != (120 as u8) { ok = false }
    }
    testkit.check(ok, label)
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var j0: jobs.Jobs = jobs.create(0)
    var j3: jobs.Jobs = jobs.create(3)
    run(&j0, 0, "0 workers n=0") catch false
    run(&j0, 5, "0 workers n=5") catch false
    run(&j3, 1, "3 workers n=1") catch false
    run(&j3, 200, "3 workers n=200") catch false
    var bad: Vec[str] = vec_new[str]()
    vec_push[str](&bad, "/nonexistent/dir/file.txt")
    var res: Vec[Info] = vec_new[Info]()
    let ok: bool = jobs_map_texts[Info](&j3, &bad, info, &res)
    testkit.check(ok && vec_len[Info](&res) == 1 && (*vec_elem_ptr[Info](&res, 0)).n == 0 && (*vec_elem_ptr[Info](&res, 0)).first == (0 as u8), "unreadable file: zero slot")
    jobs_map_texts[Info](&j3, &bad, info, &res)
    vec_clear[str](&bad)
    jobs_map_texts[Info](&j3, &bad, info, &res)
    testkit.check(vec_len[Info](&res) == 0, "out is cleared first")
    jobs.destroy(&j0)
    jobs.destroy(&j3)
    return testkit.finish()
}
