// expect_exit: 0
// Abnahmepunkt 2 (FIRN-ANFORDERUNGEN.md §13): der DOM-Prototyp mit ECHTEN
// Zyklen — Eltern/Kind in beide Richtungen stark, Listener <-> Knoten,
// JS-Wrapper <-> Knoten, live Sammlung auf ihre Wurzel — und die Gegenprobe,
// dass ein schwacher Beobachter sein Ziel NICHT am Leben haelt.
//
// Der Dauerlauf mit Speichermessung steht in tools/dom_soak/run.sh; hier wird
// die Struktur geprueft, dort das Verhalten ueber viele Zyklen.
import modules.dom

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    // Zyklenarten 1, 2, 3, 4 und 6
    let a: i32 = dom.dom_selbsttest()
    if a != 0 {
        return a
    }
    // Zyklenart 5: GcWeak haelt nicht
    let b: i32 = dom.dom_observer_test()
    if b != 0 {
        return 50 + b
    }
    // Ein Satz aus dem Dauerlauf legt wirklich sieben Objekte an ...
    let n: u64 = dom.dom_zyklus_bauen() catch 0
    if n != dom.DOM_OBJEKTE_JE_SATZ {
        return 80
    }
    // ... und ueberlebt keinen Sammellauf, sobald er unerreichbar ist.
    dom.dom_zyklus_verwerfen()
    gc_collect()
    let lebend: u64 = gc_live_objects()

    // 200 weitere Saetze = 1400 Objekte; der Verbrauch darf nicht wachsen.
    var i: u64 = 0
    while i < 200 {
        let m: u64 = dom.dom_zyklus_bauen() catch 0
        if m != dom.DOM_OBJEKTE_JE_SATZ {
            return 81
        }
        i = i + 1
    }
    dom.dom_zyklus_verwerfen()
    gc_collect()
    // Nach 201 Saetzen duerfen nicht mehr Objekte leben als nach dem ersten
    // (zuzueglich der wenigen Zufallstreffer des konservativen Stapelscans).
    if gc_live_objects() > lebend + 8 {
        return 82
    }
    if gc_heap_bytes() > 4194304 {
        return 83
    }
    return 0
}
