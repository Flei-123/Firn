// expect_exit: 0
import std.rt
import brigadier.mem as m
import brigadier.text as tx
import brigadier.exc as ex
import brigadier.reader as rd
import brigadier.argtype as at
import mc.cmd.cmd_entity as ce

static mut g_fail: i32 = 0

fn check(ok: bool, msg: str) {
    if !ok {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_bytes(&o, msg.p as u64, msg.n)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn parse(a: *mut m.Arena, input: str, flags: i32, v: *mut at.Value) -> bool {
    var r: rd.Reader = rd.reader_new(a, tx.u16_from_str(a, input))
    var e: ex.Exc = ex.exc_none()
    var ctx: ce.EntityCtx = ce.EntityCtx { types: "minecraft:zombie\nminecraft:player\n", quirks: 0, flags: flags }
    return ce.entity_parse(&r, &ctx, v, &e)
}

fn main() -> i32 {
    var a: m.Arena = m.arena_new()
    var v: at.Value = at.Value { kind: 0, i: 0, f: 0.0, s: tx.u16_empty() }
    check(parse(&a, "@e[type=!zombie,limit=2,name=Bob]", 0, &v), "selector with options parses")
    let s: *mut ce.Sel = v.i as u64 as *mut ce.Sel
    check((*s).max_results == 2 && (*s).type_inverse && (*s).name_eq && ce.sel_filter_count(s) == 2, "option state")
    check(!parse(&a, "@a[type=zombie]", 0, &v), "type not applicable to @a")
    check(!parse(&a, "@e", ce.ENT_SINGLE, &v), "@e is not single")
    check(parse(&a, "@s", ce.ENT_SINGLE | ce.ENT_PLAYERS, &v), "@s single player")
    check(!parse(&a, "@e[type=bogus]", 0, &v), "unknown entity type")
    check(parse(&a, "1-1-1-1-1", 0, &v), "short uuid parses")
    var hi: i64 = 0
    var lo: i64 = 0
    check(ce.uuid_parse(tx.u16_from_str(&a, "00000001-0001-0001-0001-000000000001"), &hi, &lo) && hi == 4295032833 && lo == 281474976710657, "uuid bits")
    check(!ce.uuid_parse(tx.u16_from_str(&a, "1-1-1-1"), &hi, &lo), "uuid needs four dashes")
    if g_fail == 0 {
        rt.write_everything(1, "ok\n".p as u64, 3)
    }
    return g_fail
}
