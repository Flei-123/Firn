// expect_exit: 0
// tests/3981_for_tuple_core.fi -- `for (a, b) in array_of_tuples` (core subset: runs through
// firnc1 as well, so parser_compare / sema_compare / fir_compare see the desugared tree).
import std.io
import std.rt
import std.testkit

fn main() -> i32 {
    if !gc_init() { return 1 }
    let v: [(i32, i64); 3] = [(1, 10), (2, 20), (3, 30)]
    var sa: i32 = 0
    var sb: i64 = 0
    for (a, b) in v {
        sa += a
        sb += b
    }
    testkit.check(sa == 6 && sb == 60, "pairs")
    var only_b: i64 = 0
    for (_, b) in v {
        if b == 20 { continue }
        only_b += b
    }
    testkit.check(only_b == 40, "skip and continue")
    var stop: i32 = 0
    for (a, _) in v {
        stop = a
        if a == 2 { break }
    }
    testkit.check(stop == 2, "break")
    let w: [(i32, i32, i32); 2] = [(1, 2, 3), (4, 5, 6)]
    var tri: i32 = 0
    for (x, y, z) in w {
        tri += x * 100 + y * 10 + z
    }
    testkit.check(tri == 123 + 456, "triples")
    var chk: i64 = 0
    for (i, (a, b)) in enumerate(v) {
        chk += (i as i64 + 1) * (a as i64 + b)
    }
    testkit.check(chk == 11 + 44 + 99, "enumerate nested")
    let nv: [(i32, (i32, i32)); 2] = [(1, (2, 3)), (4, (5, 6))]
    var nsum: i32 = 0
    for (a, (b, c)) in nv {
        nsum += a * b + c
    }
    testkit.check(nsum == 5 + 26, "nested element")
    let arr: [i32; 3] = [7, 8, 9]
    var zs: i64 = 0
    for (n, (a, b)) in zip(arr, v) {
        zs += n as i64 * (a as i64 + b)
    }
    testkit.check(zs == 77 + 176 + 297, "zip with tuple")
    var cnt: i64 = 0
    for (a, b) in v {
        for (c, d) in v {
            cnt += a as i64 * c as i64 + b - d
        }
    }
    testkit.check(cnt == 36, "nested loops")
    return testkit.finish()
}
