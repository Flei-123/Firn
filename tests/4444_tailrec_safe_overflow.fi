// expect_exit: 101
// not_mode: opt
// A checked `+` in a recursion must still panic on overflow (no re-association
// of checked arithmetic): 100 levels of `+ 100` overflow a u8 on the way back.
fn up(n: u8) -> u8 {
    if n == 0 {
        return 0
    }
    return 100 + up(n - 1)
}

fn main() -> i32 {
    let r: u8 = up(100)
    if r == 0 {
        return 0
    }
    return 7
}
