import jxl.jxl
import jxl.jxl_float
import std.fs
import std.rt

static mut failures: i32 = 0
static mut first_bad: i32 = 0 - 1
static mut index: i32 = 0

fn expect_float(raw: i64, bits: u32, exp_bits: u32, want: u64) {
    if jxl_float.int_to_float_bits(raw, bits, exp_bits) != want {
        failures = failures + 1
    }
}

fn sample(pic: *mut jxl.JxlPicture, i: usize) -> u64 {
    let at: usize = i * ((*pic).bytes_per_sample as usize)
    var v: u64 = 0
    var k: usize = 0
    while k < ((*pic).bytes_per_sample as usize) {
        v = v | ((rt.ld8((*pic).data, at + k) as u64) << ((k * 8) as u64))
        k = k + 1
    }
    return v
}

fn expect(name: str, w: u32, h: u32, ch: u32, bps: u32, bits: u32, want: u64) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(name, &data) catch 0
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let ok: bool = jxl.jxl_decode(rt.buf_ptr(&data), n, &pic) catch false
    var s: u64 = 0
    var good: bool = ok && pic.width == w && pic.height == h && pic.channels == ch && pic.bytes_per_sample == bps && pic.bits == bits
    if good {
        var i: usize = 0
        while i < ((w * h * ch) as usize) {
            s = (s * 31 + sample(&pic, i)) % 1000000007
            i = i + 1
        }
        good = s == want
    }
    if !good {
        failures = failures + 1
        if first_bad < 0 {
            first_bad = index
        }
    }
    index = index + 1
    jxl.jxl_picture_free(&pic)
    rt.buf_free(&data)
}

fn main() -> i32 {
    expect("tests/data/jxl/depth/d_rgb16.jxl", 70, 50, 3, 2, 16, 672342708)
    expect("tests/data/jxl/depth/d_grey16.jxl", 64, 40, 1, 2, 16, 494373277)
    expect("tests/data/jxl/depth/d_rgba16.jxl", 50, 40, 4, 2, 16, 526400426)
    expect("tests/data/jxl/depth/d_rgb12.jxl", 60, 40, 3, 2, 12, 581385270)
    expect("tests/data/jxl/depth/d_rgb10.jxl", 60, 40, 3, 2, 10, 272492736)
    expect("tests/data/jxl/depth/d_f3.jxl", 48, 32, 3, 4, 32, 484629098)
    expect("tests/data/jxl/depth/d_f1.jxl", 48, 32, 1, 4, 32, 568847028)
    expect_float(0, 16, 5, 0)
    expect_float(32768, 16, 5, 2147483648)
    expect_float(15360, 16, 5, 1065353216)
    expect_float(48128, 16, 5, 3212836864)
    expect_float(1, 16, 5, 864026624)
    expect_float(1023, 16, 5, 947896320)
    expect_float(1024, 16, 5, 947912704)
    expect_float(31743, 16, 5, 1199562752)
    expect_float(64511, 16, 5, 3347046400)
    expect_float(13653, 16, 5, 1051369472)
    expect_float(22080, 16, 5, 1120403456)
    expect_float(341, 16, 5, 933920768)
    expect_float(32769, 16, 5, 3011510272)
    expect_float(11878, 16, 5, 1036828672)
    expect_float(16256, 16, 8, 1065353216)
    expect_float(49024, 16, 8, 3212836864)
    expect_float(1, 16, 8, 65536)
    expect_float(16457, 16, 8, 1078525952)
    expect_float(32639, 16, 8, 2139029504)
    expect_float(32768, 16, 8, 2147483648)
    return failures
}
