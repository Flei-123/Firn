// expect_exit: 0
// ROUND OWN-3 (r192): more owners, the same in both compilers -- overwriting
// a variable destroys the old value, a parameter dies in the callee, array
// elements die in order, fields die in order of declaration, and a value
// that travels through a function and back dies exactly once.
// `LOG` records the ids as decimal digits.
static mut LOG: i64 = 0

struct Guard { id: i64 }

impl Guard {
    fn drop(inout self) {
        LOG = LOG * 10 + self.id
    }
}

struct Wrap { first: Guard, n: i64, second: Guard }

fn mk(id: i64) -> Guard { return Guard { id: id } }
fn consume(g: Guard, k: i64) -> i64 { return k + 1 }
fn relay(g: Guard) -> Guard { return g }

fn main() -> i32 {
    {
        var g: Guard = mk(1)
        g = mk(2)
    }
    if LOG != 12 { return 1 }

    LOG = 0
    {
        let a: Guard = mk(3)
        let r: i64 = consume(a, 1)
        LOG = LOG * 10 + 9
    }
    if LOG != 39 { return 2 }

    LOG = 0
    {
        let arr: [Guard; 3] = [mk(1), mk(2), mk(3)]
    }
    if LOG != 123 { return 3 }

    LOG = 0
    {
        let w: Wrap = Wrap { first: mk(4), n: 0, second: mk(5) }
    }
    if LOG != 45 { return 4 }

    LOG = 0
    {
        let a: Guard = mk(6)
        let b: Guard = relay(a)
    }
    if LOG != 6 { return 5 }
    return 0
}
