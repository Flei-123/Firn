// expect_exit: 32
// [wert; N] — Wiederholungsliteral, klein (entrollt) und gross (Schleife).
const N: usize = 100

fn main() -> i32 {
    var klein: [i32; 4] = [3; 4]
    var gross: [u8; 100] = [2 as u8; N]
    var s: i32 = 0
    for i in 0 as usize..4 as usize {
        s = s + klein[i]
    }
    var t: i32 = 0
    for i in 0 as usize..N {
        t = t + gross[i] as i32
    }
    // 12 + 200/10 = 32
    return s + t / 10 as i32
}
