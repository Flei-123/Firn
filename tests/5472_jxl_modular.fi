// expect_exit: 0
import std.fs
import std.rt
import jxl.jxl_img
import jxl.jxl_modular

static mut failures: i32 = 0

fn hash_image(im: *mut jxl_img.JxlImage) -> u64 {
    var s: u64 = 0
    var c: usize = 0
    while c < jxl_img.img_count(im) {
        var i: usize = 0
        let w: usize = jxl_img.img_w(im, c)
        while i < w * jxl_img.img_h(im, c) {
            s = (s * 31 + (jxl_img.img_get(im, c, i % w, i / w) as u64)) % 1000000007
            i = i + 1
        }
        c = c + 1
    }
    return s
}

fn expect(path: str, channels: usize, want: u64) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    var im: jxl_img.JxlImage = jxl_img.img_new()
    let r: i32 = jxl_modular.modular_decode(rt.buf_ptr(&data), n, &im)
    if r != 0 || jxl_img.img_count(&im) != channels || hash_image(&im) != want {
        failures = failures + 1
    }
    jxl_img.img_free(&im)
    rt.buf_free(&data)
}

fn main() -> i32 {
    expect("tests/data/jxl/grey20x20.jxl", 1, 9049629)
    expect("tests/data/jxl/greya24x24.jxl", 2, 676987850)
    expect("tests/data/jxl/rgb16x16.jxl", 3, 928391129)
    expect("tests/data/jxl/rgb1x1.jxl", 3, 15840)
    expect("tests/data/jxl/rgb300x20.jxl", 3, 20975070)
    expect("tests/data/jxl/rgb300x200.jxl", 3, 834872128)
    expect("tests/data/jxl/rgb37x23.jxl", 3, 185926274)
    expect("tests/data/jxl/rgb40x40_e3.jxl", 3, 603846751)
    expect("tests/data/jxl/rgb40x40_e5.jxl", 3, 603846751)
    expect("tests/data/jxl/rgb513x7.jxl", 3, 190106427)
    expect("tests/data/jxl/rgb64x64_e1.jxl", 3, 215986988)
    expect("tests/data/jxl/rgb64x64_e9.jxl", 3, 224714264)
    expect("tests/data/jxl/rgba17x9.jxl", 4, 431956331)
    return failures
}
