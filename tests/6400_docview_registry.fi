// expect_exit: 0
import std.rt
import std.testkit
import docview.registry
import docview.lazy
import docview.doc
import docview.kinds

static mut inits: i32 = 0

fn fake_pages(h: u64) -> usize {
    return 3
}

fn fake_open(p: u64, n: usize) -> u64 {
    return 7
}

fn fake_size(h: u64, page: usize, w: *mut i32, hh: *mut i32) -> bool {
    *w = 100
    *hh = 200
    return true
}

fn fake_render(h: u64, page: usize, scale: f64, out: *mut rt.Buf, w: *mut i32, hh: *mut i32) -> bool {
    rt.buf_push(out, 9 as u8)
    *w = 1
    *hh = 1
    return true
}

fn fake_text(h: u64, page: usize, out: *mut rt.Buf) -> bool {
    rt.buf_push(out, 65 as u8)
    return true
}

fn fake_ops() -> registry.DocOps {
    var o: registry.DocOps = registry.ops_empty()
    o.open = fake_open
    o.pages = fake_pages
    o.page_size = fake_size
    o.render = fake_render
    o.text = fake_text
    return o
}

fn init_fake() {
    inits = inits + 1
    registry.register("fake.pdf", kinds.KIND_PDF, fake_ops())
}

#[test]
fn register_and_find() {
    registry.registry_reset()
    testkit.assert_true(registry.register("a", kinds.KIND_PDF, fake_ops()), "check")
    testkit.assert_eq_i64(registry.opener_count() as i64, 1)
    testkit.assert_true(registry.has_kind(kinds.KIND_PDF), "check")
    testkit.assert_true(!registry.has_kind(kinds.KIND_DOCX), "check")
    testkit.assert_true((registry.find_by_name("a") as u64) != 0, "check")
    testkit.assert_true((registry.find_by_name("b") as u64) == 0, "check")
}

#[test]
fn register_same_name_replaces() {
    registry.registry_reset()
    registry.register("a", kinds.KIND_PDF, fake_ops())
    registry.register("a", kinds.KIND_DOCX, fake_ops())
    testkit.assert_eq_i64(registry.opener_count() as i64, 1)
    testkit.assert_true(registry.has_kind(kinds.KIND_DOCX), "check")
    testkit.assert_true(!registry.has_kind(kinds.KIND_PDF), "check")
}

#[test]
fn later_registration_wins_per_kind() {
    registry.registry_reset()
    registry.register("a", kinds.KIND_PDF, fake_ops())
    registry.register("b", kinds.KIND_PDF, registry.ops_empty())
    let o: *mut registry.Opener = registry.find_by_kind(kinds.KIND_PDF)
    testkit.assert_eq_str((*o).name, "b")
}

#[test]
fn unregister_removes() {
    registry.registry_reset()
    registry.register("a", kinds.KIND_PDF, fake_ops())
    registry.register("b", kinds.KIND_DOCX, fake_ops())
    testkit.assert_true(registry.unregister("a"), "check")
    testkit.assert_true(!registry.unregister("a"), "check")
    testkit.assert_eq_i64(registry.opener_count() as i64, 1)
    testkit.assert_true(registry.has_kind(kinds.KIND_DOCX), "check")
}

#[test]
fn lazy_runs_init_once_on_demand() {
    registry.registry_reset()
    lazy.lazy_reset()
    inits = 0
    lazy.lazy_register("fake.pdf", kinds.KIND_PDF, init_fake)
    testkit.assert_eq_i64(inits as i64, 0)
    testkit.assert_true(lazy.lazy_ensure_kind(kinds.KIND_PDF), "check")
    testkit.assert_true(lazy.lazy_ensure_kind(kinds.KIND_PDF), "check")
    testkit.assert_eq_i64(inits as i64, 1)
    testkit.assert_true(!lazy.lazy_ensure_kind(kinds.KIND_DOCX), "check")
}

#[test]
fn doc_api_goes_through_registry() {
    registry.registry_reset()
    lazy.lazy_reset()
    lazy.lazy_register("fake.pdf", kinds.KIND_PDF, init_fake)
    let s: str = "%PDF-1.4 x"
    var d: doc.Doc = doc.doc_open_named(s.p as u64, s.n, "x.pdf")
    testkit.assert_true(doc.doc_ok(&d), "check")
    testkit.assert_eq_i64(doc.doc_pages(&d) as i64, 3)
    var w: i32 = 0
    var h: i32 = 0
    testkit.assert_true(doc.doc_page_size(&d, 1, &w, &h), "check")
    testkit.assert_eq_i64(w as i64, 100)
    testkit.assert_true(!doc.doc_page_size(&d, 3, &w, &h), "check")
    var b: rt.Buf = rt.buf_new()
    testkit.assert_true(doc.doc_render(&d, 0, 1.0, &b, &w, &h), "check")
    testkit.assert_eq_i64(rt.buf_len(&b) as i64, 1)
    testkit.assert_true(!doc.doc_render(&d, 0, 0.0, &b, &w, &h), "check")
    rt.buf_clear(&b)
    testkit.assert_true(doc.doc_text(&d, 2, &b), "check")
    testkit.assert_eq_i64(rt.buf_at(&b, 0) as i64, 65)
    doc.doc_free(&d)
    testkit.assert_true(!doc.doc_ok(&d), "check")
    testkit.assert_eq_i64(doc.doc_pages(&d) as i64, 0)
    rt.buf_free(&b)
}

#[test]
fn unknown_kind_gives_closed_doc() {
    registry.registry_reset()
    lazy.lazy_reset()
    let s: str = "\x00\x01\x02\x03\x04"
    var d: doc.Doc = doc.doc_open(s.p as u64, s.n)
    testkit.assert_true(!doc.doc_ok(&d), "check")
    doc.doc_free(&d)
}
