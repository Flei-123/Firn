// expect_exit: 0
import std.rt
import std.io
import std.bytes
import mc.mc_entity
import mc.mc_sem
import mc.mc_version
import mc.v777.mc_proto_v777

fn check(failures: *mut i32, ok: bool, what: str) {
    if !ok {
        io.fmt_print(f"FAIL {what}\n")
        *failures = *failures + 1
    }
}

fn feed(s: *mut mc_entity.Store, ver: *mut mc_version.Version, sem: usize, b: *mut bytes.Bytes) -> bool {
    bytes.bytes_set_pos(b, 0)
    let id: i32 = (*ver).sem[sem]
    let r: bool = mc_entity.entity_on_packet(s, ver, id, b)
    bytes.bytes_clear(b)
    return r
}

fn put_delta(b: *mut bytes.Bytes, dx: i16, dy: i16, dz: i16) {
    bytes.put_i16(b, dx)
    bytes.put_i16(b, dy)
    bytes.put_i16(b, dz)
}

fn main() -> i32 {
    var failures: i32 = 0
    var ver: mc_version.Version = mc_proto_v777.version_make()
    var s: mc_entity.Store = mc_entity.store_new()
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, 5)
    bytes.put_uuid(&b, 7 as u64, 5 as u64)
    bytes.put_varint(&b, 100)
    bytes.put_f64(&b, 1.0)
    bytes.put_f64(&b, 2.0)
    bytes.put_f64(&b, 3.0)
    bytes.put_u8(&b, 0 as u8)
    bytes.put_i8(&b, 64 as i8)
    bytes.put_i8(&b, 32 as i8)
    bytes.put_i8(&b, 0 as i8)
    bytes.put_varint(&b, 0)
    check(&failures, feed(&s, &ver, mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY, &b), "spawn handled")
    let e: *mut mc_entity.Entity = mc_entity.store_get(&s, 5)
    check(&failures, (e as u64) != 0 as u64, "entity exists")
    if (e as u64) == 0 as u64 {
        return 1
    }
    check(&failures, (*e).x == 1.0 && (*e).z == 3.0 && (*e).yaw == 45.0 && (*e).pitch == 90.0, "spawn fields behind lpVec3")

    bytes.put_varint(&b, 5)
    bytes.put_varint(&b, 1)
    put_delta(&b, 4096 as i16, 0 as i16, (0 - 2048) as i16)
    check(&failures, feed(&s, &ver, mc_sem.SEM_PLAY_S2C_REL_ENTITY_MOVE, &b), "rel move handled")
    check(&failures, (*e).x == 2.0 && (*e).y == 2.0 && (*e).z == 2.5 && (*e).on_ground, "rel move steps 0 ground")

    bytes.put_varint(&b, 5)
    bytes.put_varint(&b, 4)
    bytes.put_varint(&b, 1)
    put_delta(&b, 4096 as i16, 4096 as i16, 0 as i16)
    bytes.put_varint(&b, 1)
    put_delta(&b, 2048 as i16, 0 as i16, 0 as i16)
    check(&failures, feed(&s, &ver, mc_sem.SEM_PLAY_S2C_REL_ENTITY_MOVE, &b), "rel move path handled")
    check(&failures, (*e).x == 3.5 && (*e).y == 3.0 && (*e).z == 2.5 && !(*e).on_ground, "rel move steps 2 summed")

    bytes.put_varint(&b, 5)
    bytes.put_varint(&b, 0)
    put_delta(&b, 0 as i16, 4096 as i16, 0 as i16)
    bytes.put_i8(&b, 64 as i8)
    bytes.put_i8(&b, 32 as i8)
    check(&failures, feed(&s, &ver, mc_sem.SEM_PLAY_S2C_ENTITY_MOVE_LOOK, &b), "move look handled")
    check(&failures, (*e).y == 4.0 && (*e).yaw == 90.0 && (*e).pitch == 45.0, "move look applied")

    bytes.put_varint(&b, 5)
    bytes.put_varint(&b, 0)
    bytes.put_f64(&b, 10.5)
    bytes.put_f64(&b, 70.0)
    bytes.put_f64(&b, 0.0 - 9.25)
    bytes.put_f32(&b, 90.0 as f32)
    bytes.put_f32(&b, 30.0 as f32)
    bytes.put_bool(&b, true)
    check(&failures, feed(&s, &ver, mc_sem.SEM_PLAY_S2C_SYNC_ENTITY_POSITION, &b), "sync handled")
    check(&failures, (*e).x == 10.5 && (*e).y == 70.0 && (*e).z == 0.0 - 9.25 && (*e).yaw == 90.0 && (*e).pitch == 30.0 && (*e).on_ground, "sync path applied")

    bytes.put_u8(&b, 29 as u8)
    bytes.put_varint(&b, 1)
    bytes.put_uuid(&b, 7 as u64, 5 as u64)
    bytes.put_varint(&b, 3)
    bytes.put_u8(&b, 66 as u8)
    bytes.put_u8(&b, 111 as u8)
    bytes.put_u8(&b, 98 as u8)
    bytes.put_varint(&b, 0)
    bytes.put_varint(&b, 1)
    bytes.put_varint(&b, 1)
    bytes.put_varint(&b, 0)
    check(&failures, feed(&s, &ver, mc_sem.SEM_PLAY_S2C_PLAYER_INFO, &b), "player info handled")
    check(&failures, mc_entity.store_player_count(&s) == 1, "player info named the player")

    bytes.bytes_free(&b)
    check(&failures, s.bad == 0 as u64 && s.misses == 0 as u64, "nothing bad or missed")
    mc_entity.store_free(&s)
    if failures != 0 {
        io.fmt_print(f"entity v777: {failures} failures\n")
        return 1
    }
    io.fmt_print(f"entity v777: ok\n")
    return 0
}
