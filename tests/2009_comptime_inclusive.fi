// expect_exit: 55
// ROUND REF2/REF3: `for i in a..=b` also runs at compile time (`comptime`,
// both compilers): the end value is part of the range.
comptime {
    var n: i64 = 0
    for i in 1..= 10 {
        n = n + i
    }
    emit_raw("const TOTAL: i64 = ")
    emit_number(n)
    emit_raw("\n")
}

fn main() -> i32 {
    return TOTAL as i32
}
