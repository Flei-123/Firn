// expect_exit: 7
// Ein Aggregatparameter ist eine KOPIE: Aenderungen wirken nicht zurueck.
struct P { x: i32, y: i32 }

fn change(p: P) -> i32 {
    var q: P = p
    q.x = 99
    return q.x - p.x
}

fn main() -> i32 {
    let p: P = P{ x: 92, y: 0 }
    let d: i32 = change(p)
    // 99 - 92 = 7, das Original bleibt unveraendert
    if p.x != 92 { return 1 }
    return d
}
