// expect_exit: 7
// An aggregate parameter is a COPY: changes do not propagate back.
struct P { x: i32, y: i32 }

fn change(p: P) -> i32 {
    var q: P = p
    q.x = 99
    return q.x - p.x
}

fn main() -> i32 {
    let p: P = P { x: 92, y: 0 }
    let d: i32 = change(p)
    // 99 - 92 = 7, the original stays unchanged
    if p.x != 92 { return 1 }
    return d
}
