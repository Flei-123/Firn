// expect_exit: 0
// mc_inv shift click (Click Container mode 1) of the player inventory, vanilla InventoryMenu.quickMoveStack: main <-> hotbar, armour / shield
// slots, craft grid + armour -> inventory, merge before fill (stack limits from the registry), nothing moves when full, the result slot is left
// to the server. The changed-slot list of the packet is the diff (checked on the bytes of 1.20.1 and via the schema for every version).
// Return codes: 1xx = setup, 2xx.. = cases (case*10 + check).
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_schema
import mc.mc_registry
import mc.mc_inv

fn it(r: *mut mc_registry.Registry, name: str) -> i32 { return mc_registry.reg_item_by_name(r, name.p as u64, name.n) }

fn layout(ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let id: i32 = mc_version.version_pid(ver, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK)
    if id < 0 { return false }
    let sch: u64 = (*ver).schema_of(mc_version.ST_PLAY, mc_version.DIR_C2S, id)
    if sch == 0 as u64 { return false }
    bytes.bytes_set_pos(b, 0)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk(sch, b, &out)
    rt.buf_free(&out)
    return ok
}

// one click, the packet must parse with the schema of the version; returns the number of changed slots (>= 0) or -1
fn click(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32) -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(v, (*ver).protocol, slot, button, mode, &b) { return 0 - 1 }
    let ok: bool = layout(ver, &b)
    var n: i32 = 0
    if (*ver).protocol >= 756 {
        // window id (u8 until 1.21.1, varint from 1.21.2 = 1 byte for 0), stateId 5 (1 byte), slot i16, button i8, mode varint (1 byte), count
        n = bytes.bytes_at(&b, 6) as i32
    }
    bytes.bytes_free(&b)
    if !ok { return 0 - 2 }
    return n
}

fn fresh(r: *mut mc_registry.Registry) -> mc_inv.Inv {
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_use_registry(&v, r)
    return v
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var r: mc_registry.Registry = ver.registry_of()
    if !mc_registry.registry_ok(&r) { return 101 }
    let stone: i32 = it(&r, "stone")
    let dirt: i32 = it(&r, "dirt")
    let pearl: i32 = it(&r, "ender_pearl")
    let helmet: i32 = it(&r, "iron_helmet")
    let chest: i32 = it(&r, "iron_chestplate")
    let boots: i32 = it(&r, "iron_boots")
    let shield: i32 = it(&r, "shield")
    let elytra: i32 = it(&r, "elytra")
    if stone < 0 || dirt < 0 || pearl < 0 || helmet < 0 || chest < 0 || boots < 0 || shield < 0 || elytra < 0 { return 102 }
    var v: mc_inv.Inv = fresh(&r)

    // 1: main -> hotbar: merge into the 30 first (64 max), the rest 6 into the first free hotbar slot
    mc_inv.inv_set(&v, 10, stone, 40)
    mc_inv.inv_set(&v, 36, stone, 30)
    mc_inv.inv_set(&v, 37, dirt, 1)
    var n: i32 = click(&v, &ver, 10, 0, 1)
    if n < 0 { return 10 }
    if mc_inv.inv_count(&v, 36) != 64 || mc_inv.inv_item(&v, 38) != stone || mc_inv.inv_count(&v, 38) != 6 || mc_inv.inv_item(&v, 10) != 0 - 1 { return 11 }
    if mc_inv.inv_item(&v, 37) != dirt { return 12 }
    if p >= 756 && n != 3 { return 13 } // slots 10, 36, 38 changed
    // 2: hotbar -> main (first free main slot, merge first)
    mc_inv.inv_set(&v, 12, stone, 60)
    if click(&v, &ver, 38, 0, 1) < 0 { return 20 }
    if mc_inv.inv_count(&v, 12) != 64 || mc_inv.inv_item(&v, 9) != stone || mc_inv.inv_count(&v, 9) != 2 || mc_inv.inv_item(&v, 38) != 0 - 1 { return 21 }
    // 3: right button = same as left; armour goes to its slot, a second helmet (slot taken) goes to the hotbar
    mc_inv.inv_set(&v, 13, helmet, 1)
    mc_inv.inv_set(&v, 14, helmet, 1)
    mc_inv.inv_set(&v, 15, chest, 1)
    mc_inv.inv_set(&v, 16, boots, 1)
    mc_inv.inv_set(&v, 17, shield, 1)
    mc_inv.inv_set(&v, 18, elytra, 1)
    if click(&v, &ver, 13, 1, 1) < 0 { return 30 }
    if mc_inv.inv_item(&v, 5) != helmet || mc_inv.inv_item(&v, 13) != 0 - 1 { return 31 }
    if click(&v, &ver, 14, 0, 1) < 0 { return 32 }
    if mc_inv.inv_item(&v, 5) != helmet || mc_inv.inv_item(&v, 14) != 0 - 1 || mc_inv.inv_item(&v, 38) != helmet { return 33 }
    if click(&v, &ver, 15, 0, 1) < 0 || mc_inv.inv_item(&v, 6) != chest { return 34 }
    if click(&v, &ver, 16, 0, 1) < 0 || mc_inv.inv_item(&v, 8) != boots { return 35 }
    if click(&v, &ver, 17, 0, 1) < 0 || mc_inv.inv_item(&v, 45) != shield { return 36 }
    if click(&v, &ver, 18, 0, 1) < 0 || mc_inv.inv_item(&v, 6) != chest || mc_inv.inv_item(&v, 39) != elytra { return 37 } // chest slot taken -> hotbar
    // 4: off hand taken: a second shield goes to the hotbar; from the armour slot / off hand / craft grid back into the inventory
    mc_inv.inv_set(&v, 19, shield, 1)
    if click(&v, &ver, 19, 0, 1) < 0 || mc_inv.inv_item(&v, 45) != shield || mc_inv.inv_item(&v, 40) != shield { return 40 }
    if click(&v, &ver, 45, 0, 1) < 0 || mc_inv.inv_item(&v, 45) != 0 - 1 || mc_inv.inv_item(&v, 10) != shield { return 41 }
    if click(&v, &ver, 5, 0, 1) < 0 || mc_inv.inv_item(&v, 5) != 0 - 1 || mc_inv.inv_item(&v, 11) != helmet { return 42 }
    mc_inv.inv_set(&v, 2, stone, 5)
    if click(&v, &ver, 2, 0, 1) < 0 || mc_inv.inv_item(&v, 2) != 0 - 1 || mc_inv.inv_count(&v, 9) != 7 { return 43 }
    mc_inv.inv_free(&v)

    // 5: stack limit 16 (ender pearls): 10 + 10 -> 16 + 4
    v = fresh(&r)
    mc_inv.inv_set(&v, 14, pearl, 10)
    mc_inv.inv_set(&v, 40, pearl, 10)
    if click(&v, &ver, 40, 0, 1) < 0 { return 50 }
    if mc_inv.inv_count(&v, 14) != 16 || mc_inv.inv_item(&v, 9) != pearl || mc_inv.inv_count(&v, 9) != 4 || mc_inv.inv_item(&v, 40) != 0 - 1 { return 51 }
    mc_inv.inv_free(&v)

    // 6: nothing fits (hotbar full of dirt): nothing changes, no changed slot in the packet
    v = fresh(&r)
    var k: i32 = 36
    while k < 45 { mc_inv.inv_set(&v, k, dirt, 64); k = k + 1 }
    mc_inv.inv_set(&v, 10, stone, 5)
    n = click(&v, &ver, 10, 0, 1)
    if n < 0 { return 60 }
    if mc_inv.inv_item(&v, 10) != stone || mc_inv.inv_count(&v, 10) != 5 || mc_inv.inv_item(&v, 36) != dirt { return 61 }
    if p >= 756 && n != 0 { return 62 }
    // empty slot: nothing to do
    if click(&v, &ver, 11, 0, 1) < 0 || mc_inv.inv_item(&v, 11) != 0 - 1 { return 63 }
    // 7: result slot: not predicted (the server answers)
    mc_inv.inv_set(&v, 0, stone, 1)
    if click(&v, &ver, 0, 0, 1) < 0 || mc_inv.inv_item(&v, 0) != stone || mc_inv.inv_count(&v, 0) != 1 { return 70 }
    mc_inv.inv_free(&v)

    // 8: a drag in progress ends with a shift click; the carried stack is not touched by a shift click; click outside with shift drops it
    v = fresh(&r)
    mc_inv.inv_set(&v, 10, stone, 3)
    if click(&v, &ver, 10, 0, 0) < 0 { return 80 } // pick up
    if mc_inv.inv_cursor_count(&v) != 3 { return 81 }
    if click(&v, &ver, 0 - 999, 0, 1) < 0 || mc_inv.inv_cursor_item(&v) != 0 - 1 { return 82 }
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    // exit codes are 8 bit: the failing check, the stage is the first failing protocol
    var r: i32 = check(754)
    if r != 0 { return r }
    r = check(763)
    if r != 0 { return r }
    r = check(769)
    if r != 0 { return r }
    r = check(772)
    if r != 0 { return r }
    r = check(775)
    if r != 0 { return r }
    return 0
}
