// expect_exit: 0
// tests/1004_js_f64_union.fi -- ROUND 63 found the gap, ROUND 68 closed it:
// an error union over `f64` carries its value.
//
// Up to round 67 this file held the gap fast: `E!f64` compiled, but the
// value that came out the other side was not the one that went in, and the
// third check below asserted exactly that -- "if this check ever fails, the
// compiler has been fixed".
//
// It has been fixed. The cause was not the System V classification, as the
// report of round 63 suspected, but a COPY: `lower_errors.rs` carried a
// `scalar_fty` of its own that did not know `Type::F64`, so `copy_value`
// copied NOTHING and left the target slot as it was.
// `lib/firnc1/lower.fi` had the same hole, written in deliberately to stay
// bug compatible. Both are gone; there is one table now
// (docs/ROUND68.md).
//
// The workaround in `lib/js/interp.fi` -- every conversion that can fail
// hands the BIT PATTERN back as a `u64` -- stays as it is. It is still
// correct, it is merely no longer forced.
import std.math

error TestError { Bad }

fn f64_union(x: f64) -> TestError!f64 {
    return x * 2.0
}

fn u64_union(x: f64) -> TestError!u64 {
    return math.math_bits(x * 2.0)
}

fn plain(x: f64) -> f64 {
    return x * 2.0
}

fn main() -> i32 {
    // 1. A plain `f64` return is correct.
    if math.math_bits(plain(0.1)) != math.math_bits(0.2) {
        return 1
    }
    // 2. The bit pattern through an error union is correct.
    let b: u64 = u64_union(0.1) catch 0
    if b != math.math_bits(0.2) {
        return 2
    }
    // 3. THE GAP, CLOSED: the same value through `TestError!f64` is the
    //    same value -- bit for bit, and equal to the two ways above.
    let w: f64 = f64_union(0.1) catch 0.0
    if math.math_bits(w) != math.math_bits(0.2) {
        return 3
    }
    if math.math_bits(w) != b {
        return 4
    }
    return 0
}
