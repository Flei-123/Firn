// expect_exit: 0
// tests/1004_js_f64_union.fi -- ROUND 63, the SPRACHLUECKE found:
// an error union over `f64` returns a WRONG value.
//
// `E!f64` compiles, but the value that comes out the other side is not the
// one that went in. `E!u64` with the same shape is correct, and so is a
// plain `f64` return -- so it is the error union over a floating point
// success type, not floating point itself.
//
// The suspicion, written down so that whoever fixes it has a starting
// point: an error union is the struct `{ __err: u32, __val: T }`
// (SPEC 14.1.error_unions). For `T = f64` the System V classification of
// that struct says SSE for the second eightbyte, while stage 0 passes
// `f64` as a BIT PATTERN in the INTEGER registers (SPEC 14.1.f64, F2).
// The two rules disagree exactly here.
//
// The engine of this round therefore hands every conversion that can fail
// back as a BIT PATTERN in a `u64` (`interp.to_number`), exactly as
// `lib/num/strtod.fi` does. This test holds the gap fast so that it cannot
// be forgotten -- it checks the WORKAROUND, and documents the broken case
// in a comment instead of failing on it.
import std.math

error TestError { Bad }

fn f64_union(x: f64) -> TestError!f64 {
    return x * 2.0
}

fn u64_union(x: f64) -> TestError!u64 {
    return math.math_bits(x * 2.0)
}

fn plain(x: f64) -> f64 {
    return x * 2.0
}

fn main() -> i32 {
    // 1. A plain `f64` return is correct.
    if math.math_bits(plain(0.1)) != math.math_bits(0.2) {
        return 1
    }
    // 2. The bit pattern through an error union is correct.
    let b: u64 = u64_union(0.1) catch 0
    if b != math.math_bits(0.2) {
        return 2
    }
    // 3. THE GAP: the same value through `TestError!f64` is NOT correct.
    //    If this check ever fails, the compiler has been fixed -- then the
    //    workaround in lib/js/interp.fi can go, and this test with it.
    let w: f64 = f64_union(0.1) catch 0.0
    if math.math_bits(w) == math.math_bits(0.2) {
        return 3
    }
    return 0
}
