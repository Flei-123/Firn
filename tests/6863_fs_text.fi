// expect_exit: 0
fn main() -> i32 {
    var bad: i32 = 0
    let path: str = "/tmp/firn_6863_fs_text.txt"
    let w = fs.write_text(path, "one\ntwo\n") catch 0
    if w != 8 { bad = bad + 1 }
    let a = fs.append_text(path, "three\n") catch 0
    if a != 6 { bad = bad + 2 }
    let t = fs.read_text(path) catch ""
    if t != "one\ntwo\nthree\n" { bad = bad + 4 }
    let lines = t.trim().split("\n")
    if lines.len() != 3 { bad = bad + 8 }
    var raw = fs.read_bytes(path) catch rt.buf_new()
    if rt.buf_len(&raw) != 14 { bad = bad + 16 }
    rt.buf_free(&raw)
    let missing = fs.read_text("/tmp/firn_6863_missing_file") catch "gone"
    if missing != "gone" { bad = bad + 32 }
    let removed = fs.remove(path) catch false
    if !removed { bad = bad + 64 }
    return bad
}
