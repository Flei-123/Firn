// expect_out: alias 3 3|field move 12 -4 ''|int -4 0 2147483647 -2147483648|b64 Zg== Zm8= Zm9v Zm9vYmFy|url -_8|back foobar true false|ok
// Round NET-REMOTE: `import a.b as c` (a module under a name of the
// program's choosing), lib/std/text.fi (fields and numbers that cannot
// trap) and lib/std/base64.fi (the RFC 4648 section 10 vectors).
import std.rt
import std.io
import std.text as t
import std.base64 as b64
import std.text

fn enc(s: str, out: *mut rt.Buf) -> str {
    rt.buf_clear(out)
    b64.encode(s.p as u64, s.n, out)
    return str { p: (*out).ptr as *mut u8, n: (*out).len }
}

fn main() -> i32 {
    // the same module under two names
    let a: str = t.field("a,b,c", ",", 2)
    let b: str = text.field("a,b,c", ",", 2)
    let na: u64 = (a.p as u64) - ("a,b,c".p as u64)
    let nb: u64 = (b.p as u64) + 1 - (b.p as u64)
    let msg: str = "move,12,-4"
    let f0: str = t.field(msg, ",", 0)
    let f1: str = t.field(msg, ",", 1)
    let f2: str = t.field(msg, ",", 2)
    let f3: str = t.field(msg, ",", 3)
    let i1: i64 = t.int("-4")
    let i2: i64 = t.int("12px")
    let i3: i32 = t.int32("99999999999999999999")
    let i4: i32 = t.int32("-99999999999")
    var o1: rt.Buf = rt.buf_new()
    var o2: rt.Buf = rt.buf_new()
    var o3: rt.Buf = rt.buf_new()
    var o4: rt.Buf = rt.buf_new()
    let e1: str = enc("f", &o1)
    let e2: str = enc("fo", &o2)
    let e3: str = enc("foo", &o3)
    let e4: str = enc("foobar", &o4)
    var u: rt.Buf = rt.buf_new()
    var raw: [u8; 2] = [251, 255]
    b64.encode_url((&raw[0]) as u64, 2, &u)
    let us: str = str { p: u.ptr as *mut u8, n: u.len }
    var back: rt.Buf = rt.buf_new()
    let good: bool = b64.decode(o4.ptr, o4.len, &back)
    let bs: str = str { p: back.ptr as *mut u8, n: back.len }
    var junk: rt.Buf = rt.buf_new()
    let bad: bool = b64.decode("Zm9v!".p as u64, 5, &junk)
    io.fmt_print_line(f"alias {na - 1} {nb + 2}|field {f0} {f1} {f2} '{f3}'|int {i1} {i2} {i3} {i4}|b64 {e1} {e2} {e3} {e4}|url {us}|back {bs} {good} {bad}|ok")
    return 0
}
