// expect_exit: 0
// mc_dig: break times of the vanilla formula for 1.20.1 (protocol 763), checked against known in-game values
// (stone by hand 7.5 s, iron pickaxe 0.4 s, dirt by hand 0.75 s, obsidian diamond 9.4 s / netherite 8.35 s, bedrock unbreakable).
// A failing case returns its number (10 + index); the harvest checks return 50..54.
import std.rt
import mc.mc_registry
import mc.mc_dig
import mc.v763.mc_reg_v763
import mc.v763.mc_dig_v763

fn ticks(r: *mut mc_registry.Registry, d: *mut mc_dig.DigData, blk: str, tool: str, eff: i32, ground: bool, water: bool) -> i32 {
    let b: i32 = mc_registry.reg_block_by_name(r, blk.p as u64, blk.n)
    if b < 0 { return 0 - 99 }
    var it: i32 = 0 - 1
    if tool.n > 0 { it = mc_registry.reg_item_by_name(r, tool.p as u64, tool.n) }
    return mc_dig.dig_ticks(d, b, mc_registry.reg_block_hardness_milli(r, b), it, eff, ground, water)
}

fn harvest(r: *mut mc_registry.Registry, d: *mut mc_dig.DigData, blk: str, tool: str) -> bool {
    let b: i32 = mc_registry.reg_block_by_name(r, blk.p as u64, blk.n)
    var it: i32 = 0 - 1
    if tool.n > 0 { it = mc_registry.reg_item_by_name(r, tool.p as u64, tool.n) }
    return mc_dig.dig_can_harvest(d, b, it)
}

fn main() -> i32 {
    var r: mc_registry.Registry = mc_reg_v763.registry_make()
    var d: mc_dig.DigData = mc_dig_v763.dig_make()
    if !mc_registry.registry_ok(&r) { return 1 }
    if !mc_dig.dig_ok(&d) { return 2 }
    if ticks(&r, &d, "stone", "", 0, true, false) != 150 { return 10 }
    if ticks(&r, &d, "stone", "wooden_pickaxe", 0, true, false) != 23 { return 11 }
    if ticks(&r, &d, "stone", "iron_pickaxe", 0, true, false) != 8 { return 12 }
    if ticks(&r, &d, "stone", "iron_pickaxe", 3, true, false) != 3 { return 13 }
    if ticks(&r, &d, "stone", "iron_pickaxe", 0, false, false) != 38 { return 14 }
    if ticks(&r, &d, "stone", "iron_pickaxe", 0, true, true) != 38 { return 15 }
    if ticks(&r, &d, "dirt", "", 0, true, false) != 15 { return 16 }
    if ticks(&r, &d, "dirt", "iron_shovel", 0, true, false) != 3 { return 17 }
    if ticks(&r, &d, "grass_block", "", 0, true, false) != 18 { return 18 }
    if ticks(&r, &d, "oak_log", "", 0, true, false) != 60 { return 19 }
    if ticks(&r, &d, "oak_log", "iron_axe", 0, true, false) != 10 { return 20 }
    if ticks(&r, &d, "obsidian", "diamond_pickaxe", 0, true, false) != 188 { return 21 }
    if ticks(&r, &d, "obsidian", "netherite_pickaxe", 0, true, false) != 167 { return 22 }
    if ticks(&r, &d, "bedrock", "diamond_pickaxe", 0, true, false) != 0 - 1 { return 23 }
    if ticks(&r, &d, "grass", "", 0, true, false) != 0 { return 24 }
    if ticks(&r, &d, "cobweb", "iron_sword", 0, true, false) != 8 { return 25 }
    if harvest(&r, &d, "iron_ore", "wooden_pickaxe") { return 50 }
    if !harvest(&r, &d, "iron_ore", "stone_pickaxe") { return 51 }
    if !harvest(&r, &d, "dirt", "") { return 52 }
    if harvest(&r, &d, "diamond_ore", "stone_pickaxe") { return 53 }
    if !harvest(&r, &d, "diamond_ore", "iron_pickaxe") { return 54 }
    return 0
}
