// expect_exit: 0
// wasm_skip: the feed is part of the native Android host backend
import std.rt
import plat.android.ssefeed

fn push(f: *mut ssefeed.Feed, s: str) {
    ssefeed.feed_push(f, s.p as u64, s.n)
}

fn same(b: *mut rt.Buf, s: str) -> bool {
    if rt.buf_len(b) != s.n { return false }
    var i: usize = 0
    while i < s.n {
        if rt.ld8(rt.buf_ptr(b), i) != rt.ld8(s.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    var f: ssefeed.Feed = ssefeed.feed_new()
    var name: rt.Buf = rt.buf_new()
    var data: rt.Buf = rt.buf_new()
    push(&f, ": keepalive\n\nevent: msg\ndata: {\"a\":1}\n")
    if ssefeed.feed_take(&f, &name, &data) { return 1 }
    push(&f, "\r\n")
    if !ssefeed.feed_take(&f, &name, &data) { return 2 }
    if !same(&name, "msg") || !same(&data, "{\"a\":1}") { return 3 }
    push(&f, "data: one\ndata: two\n\n")
    if !ssefeed.feed_take(&f, &name, &data) { return 4 }
    if !same(&name, "message") || !same(&data, "one\ntwo") { return 5 }
    push(&f, "data: spl")
    if ssefeed.feed_take(&f, &name, &data) { return 6 }
    push(&f, "it\n\n")
    if !ssefeed.feed_take(&f, &name, &data) { return 7 }
    if !same(&data, "split") { return 8 }
    if ssefeed.feed_take(&f, &name, &data) { return 9 }
    ssefeed.feed_free(&f)
    rt.buf_free(&name)
    rt.buf_free(&data)
    return 0
}
