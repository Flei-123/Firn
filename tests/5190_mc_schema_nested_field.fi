// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_schema
import mc.mc_version
import mc.v767.mc_proto_v767

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn spawn_info(b: *mut bytes.Bytes, mode: i8) {
    bytes.put_varint(b, 0)
    bytes.put_string(b, "minecraft:overworld".p as u64, 19)
    bytes.put_i64(b, 99)
    bytes.put_i8(b, mode)
    bytes.put_u8(b, 255)
    bytes.put_bool(b, false)
    bytes.put_bool(b, false)
    bytes.put_bool(b, false)
    bytes.put_varint(b, 0)
}

fn range(schema: u64, b: *mut bytes.Bytes, name: str, off: *mut usize, len: *mut usize) -> bool {
    return mc_schema.field_range(schema, name.p as u64, name.n, b, off, len)
}

fn main() -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    var off: usize = 0
    var len: usize = 0
    let login: u64 = mc_proto_v767.packet_schema(mc_version.ST_PLAY, mc_version.DIR_S2C, mc_proto_v767.PLAY_S2C_LOGIN)
    check(login != 0, 1)
    bytes.put_i32(&b, 7)
    bytes.put_bool(&b, true)
    bytes.put_varint(&b, 1)
    bytes.put_string(&b, "minecraft:overworld".p as u64, 19)
    bytes.put_varint(&b, 20)
    bytes.put_varint(&b, 8)
    bytes.put_varint(&b, 8)
    bytes.put_bool(&b, false)
    bytes.put_bool(&b, true)
    bytes.put_bool(&b, false)
    spawn_info(&b, 1)
    bytes.put_bool(&b, false)
    check(range(login, &b, "worldState.gamemode", &off, &len), 2)
    check(len == 1 && rt.ld8(bytes.bytes_data(&b), off) == 1 as u8, 3)
    check(range(login, &b, "isHardcore", &off, &len) && len == 1 && off == 4, 4)
    check(!range(login, &b, "gamemode", &off, &len), 5)
    check(!range(login, &b, "worldState.nope", &off, &len), 6)
    check(!range(login, &b, "worldState", &off, &len) || len > 1, 7)
    check(range(login, &b, "enforcesSecureChat", &off, &len) && len == 1, 8)

    let resp: u64 = mc_proto_v767.packet_schema(mc_version.ST_PLAY, mc_version.DIR_S2C, mc_proto_v767.PLAY_S2C_RESPAWN)
    check(resp != 0, 9)
    bytes.bytes_clear(&b)
    spawn_info(&b, 3)
    bytes.put_u8(&b, 0)
    check(range(resp, &b, "worldState.gamemode", &off, &len), 10)
    check(len == 1 && rt.ld8(bytes.bytes_data(&b), off) == 3 as u8, 11)
    return 0
}
