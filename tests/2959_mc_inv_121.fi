// expect_exit: 0
// mc_inv for 1.20.5+ (data components): Window Items + Set Slot of window 0 for 767/769/772/774/775, slots with components
// (damage, enchantments, custom_data NBT, removed component, nested slot in use_remainder) are skipped exactly through the
// packet schema; foreign windows, truncated packets and the Set Creative Slot layout are checked as well.
// Return codes: 1xx = setup, 2xx = window items, 3xx = set slot, 4xx = refusals.
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_inv

// component type ids per version: enchantments, use_remainder (-1 = none), enchantments carry a showTooltip bool
fn ench_id(p: i32) -> i32 {
    if p == 767 { return 9 }
    if p == 769 { return 10 }
    if p == 772 { return 10 }
    return 13
}
fn rem_id(p: i32) -> i32 {
    if p == 767 { return 0 - 1 }
    if p == 769 { return 23 }
    if p == 772 { return 22 }
    return 25
}
fn has_tooltip(p: i32) -> bool { return p <= 769 }

fn put_window(b: *mut bytes.Bytes, p: i32, w: i32) {
    if p == 767 { bytes.put_u8(b, w as u8) } else { bytes.put_varint(b, w) }
}

// an item stack with components: damage, enchantments, custom_data (empty compound), [use_remainder = 5 x item 9], one removed component
fn put_full(b: *mut bytes.Bytes, p: i32, item: i32, count: i32) {
    bytes.put_varint(b, count)
    bytes.put_varint(b, item)
    var added: i32 = 3
    if rem_id(p) >= 0 { added = 4 }
    bytes.put_varint(b, added)
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 3) // damage
    bytes.put_varint(b, 11)
    bytes.put_varint(b, ench_id(p))
    bytes.put_varint(b, 2)
    bytes.put_varint(b, 5)
    bytes.put_varint(b, 3)
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 2)
    if has_tooltip(p) { bytes.put_bool(b, true) }
    bytes.put_varint(b, 0) // custom_data: nameless compound {}
    bytes.put_u8(b, 10 as u8)
    bytes.put_u8(b, 0 as u8)
    if rem_id(p) >= 0 {
        bytes.put_varint(b, rem_id(p))
        bytes.put_varint(b, 5) // nested Slot
        bytes.put_varint(b, 9)
        bytes.put_varint(b, 0)
        bytes.put_varint(b, 0)
    }
    bytes.put_varint(b, 2) // removed: max_damage
}

fn put_plain(b: *mut bytes.Bytes, item: i32, count: i32) {
    bytes.put_varint(b, count)
    bytes.put_varint(b, item)
    bytes.put_varint(b, 0)
    bytes.put_varint(b, 0)
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    if mc_inv.inv_slot_format(p) != 2 { return 101 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    var b: bytes.Bytes = bytes.bytes_new()
    put_window(&b, p, 0)
    bytes.put_varint(&b, 5)
    bytes.put_varint(&b, 46)
    var i: i32 = 0
    while i < 46 {
        if i == 36 {
            put_plain(&b, 1, 64)
        } else if i == 38 {
            put_full(&b, p, 794, 1)
        } else if i == 20 {
            put_full(&b, p, 3, 12)
        } else if i == 45 {
            put_plain(&b, 77, 2)
        } else {
            bytes.put_varint(&b, 0)
        }
        i = i + 1
    }
    put_full(&b, p, 4, 3) // carried item
    bytes.bytes_set_pos(&b, 0)
    if !mc_inv.inv_on_window_items_v(&v, &ver, &b) { return 200 }
    if mc_inv.inv_hotbar_item(&v, 0) != 1 || mc_inv.inv_hotbar_count(&v, 0) != 64 { return 201 }
    if mc_inv.inv_hotbar_item(&v, 2) != 794 || mc_inv.inv_held_item(&v, 2) != 794 || mc_inv.inv_hotbar_count(&v, 2) != 1 { return 202 }
    if mc_inv.inv_hotbar_item(&v, 1) != 0 - 1 || mc_inv.inv_hotbar_count(&v, 1) != 0 { return 203 }
    if mc_inv.inv_item(&v, 20) != 3 || mc_inv.inv_count(&v, 20) != 12 { return 204 }
    if mc_inv.inv_item(&v, 45) != 77 || mc_inv.inv_count(&v, 45) != 2 { return 205 }
    if mc_inv.inv_item(&v, 0) != 0 - 1 || mc_inv.inv_item(&v, 44) != 0 - 1 { return 206 }
    if v.state_id != 5 || v.bad != 0 as u32 { return 207 }
    // Set Slot: window 0, stateId 6, slot 37 = 5 x item 6 with components -> hotbar 1; then slot 36 emptied
    var s: bytes.Bytes = bytes.bytes_new()
    put_window(&s, p, 0)
    bytes.put_varint(&s, 6)
    bytes.put_i16(&s, 37 as i16)
    put_full(&s, p, 6, 5)
    bytes.bytes_set_pos(&s, 0)
    if !mc_inv.inv_on_set_slot_v(&v, &ver, &s) { return 300 }
    if mc_inv.inv_hotbar_item(&v, 1) != 6 || mc_inv.inv_hotbar_count(&v, 1) != 5 { return 301 }
    if v.state_id != 6 { return 302 }
    var e: bytes.Bytes = bytes.bytes_new()
    put_window(&e, p, 0)
    bytes.put_varint(&e, 7)
    bytes.put_i16(&e, 36 as i16)
    bytes.put_varint(&e, 0)
    bytes.bytes_set_pos(&e, 0)
    if !mc_inv.inv_on_set_slot_v(&v, &ver, &e) { return 303 }
    if mc_inv.inv_hotbar_item(&v, 0) != 0 - 1 { return 304 }
    // another window is ignored
    var o: bytes.Bytes = bytes.bytes_new()
    put_window(&o, p, 3)
    bytes.put_varint(&o, 8)
    bytes.put_i16(&o, 38 as i16)
    put_plain(&o, 9, 9)
    bytes.bytes_set_pos(&o, 0)
    if mc_inv.inv_on_set_slot_v(&v, &ver, &o) { return 400 }
    if mc_inv.inv_hotbar_item(&v, 2) != 794 { return 401 }
    // truncated Window Items: refused, inventory unchanged, bad counted
    var t: bytes.Bytes = bytes.bytes_new()
    put_window(&t, p, 0)
    bytes.put_varint(&t, 9)
    bytes.put_varint(&t, 46)
    put_full(&t, p, 5, 1)
    bytes.put_varint(&t, 3) // slot cut off after the count
    bytes.bytes_set_pos(&t, 0)
    if mc_inv.inv_on_window_items_v(&v, &ver, &t) { return 402 }
    if v.bad != 1 as u32 { return 403 }
    if mc_inv.inv_hotbar_item(&v, 2) != 794 { return 404 }
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    var r: i32 = check(767)
    if r != 0 { return 1000 + r }
    r = check(769)
    if r != 0 { return 2000 + r }
    r = check(772)
    if r != 0 { return 3000 + r }
    r = check(774)
    if r != 0 { return 4000 + r }
    r = check(775)
    if r != 0 { return 5000 + r }
    // the old formats still go through the same entry point; unknown protocols are refused
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &ver) { return 6000 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&b, 0 as u8)
    bytes.put_varint(&b, 1)
    bytes.put_varint(&b, 46)
    var i: i32 = 0
    while i < 46 {
        if i == 36 {
            bytes.put_bool(&b, true)
            bytes.put_varint(&b, 1)
            bytes.put_i8(&b, 64 as i8)
            bytes.put_u8(&b, 0 as u8)
        } else {
            bytes.put_bool(&b, false)
        }
        i = i + 1
    }
    bytes.put_bool(&b, false)
    bytes.bytes_set_pos(&b, 0)
    if !mc_inv.inv_on_window_items_v(&v, &ver, &b) { return 6001 }
    if mc_inv.inv_hotbar_item(&v, 0) != 1 || mc_inv.inv_hotbar_count(&v, 0) != 64 { return 6002 }
    if mc_inv.inv_slot_format(47) != 0 || mc_inv.inv_slot_format(1000) != 2 { return 6003 }
    return 0
}
