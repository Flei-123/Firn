// expect_exit: 0
// tests/2360_std_json_sort.fi -- json_write_opts = Python's json.dumps
// (SKRIPT-LIBS r315). Every expected text below is the output of
// python3 json.dumps with the keyword arguments named next to it.
// Exit codes: the number of the first failing check.
import std.rt
import std.str
import std.json

fn expect(doc: str, o: *mut json.JsonOpts, want: str) -> bool {
    var d: json.Json = json.json_new()
    defer json.json_free(&d)
    let ok: bool = json.json_parse(&d, doc.p as u64, doc.length()) catch false
    if !ok {
        return false
    }
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    if !json.json_write_opts(&d, json.json_root(&d), &out, o) {
        return false
    }
    if rt.buf_len(&out) != want.length() {
        return false
    }
    return rt.mem_eq(rt.buf_ptr(&out), want.p as u64, want.length())
}

fn sorted() -> json.JsonOpts {
    var o: json.JsonOpts = json.json_opts_new()
    o.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
    return o
}

fn main() -> i32 {
    let doc1: str = "{\"b\":1,\"a\":[3,{\"z\":0,\"y\":1}],\"B\":null,\"\\u00e4\":true}"

    // 1. json.dumps(x, sort_keys=True)
    var o1: json.JsonOpts = sorted()
    if !expect(doc1, &o1, "{\"B\": null, \"a\": [3, {\"y\": 1, \"z\": 0}], \"b\": 1, \"\\u00e4\": true}") { return 1 }
    // json.dumps(x): the order of the document stays
    var o0: json.JsonOpts = json.json_opts_new()
    if !expect(doc1, &o0, "{\"b\": 1, \"a\": [3, {\"z\": 0, \"y\": 1}], \"B\": null, \"\\u00e4\": true}") { return 2 }
    // 2. sort_keys=True, indent=2
    var o2: json.JsonOpts = json.json_opts_indent(2)
    o2.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
    if !expect(doc1, &o2, "{\n  \"B\": null,\n  \"a\": [\n    3,\n    {\n      \"y\": 1,\n      \"z\": 0\n    }\n  ],\n  \"b\": 1,\n  \"\\u00e4\": true\n}") { return 3 }
    // 3. floats are Python's repr: exponent from 1e16 and below 1e-4, two digit exponent,
    //    whole numbers keep ".0", -0.0 keeps its sign; the 20 digit integer is a double here (J4)
    let fl: str = "[1e16, 1e-5, 0.1, -0.0, 100.0, 1.5e300, 5e-324, 1e22, 123456789.123, 9999999999999998.0, 0.0001, 1.0, -2.5e-7, 1.7976931348623157e308, -0, 12]"
    if !expect(fl, &o0, "[1e+16, 1e-05, 0.1, -0.0, 100.0, 1.5e+300, 5e-324, 1e+22, 123456789.123, 9999999999999998.0, 0.0001, 1.0, -2.5e-07, 1.7976931348623157e+308, 0, 12]") { return 4 }
    // 3b. indent=3 on a one element array
    var o3: json.JsonOpts = json.json_opts_indent(3)
    if !expect("[1]", &o3, "[\n   1\n]") { return 5 }
    // 4. empty containers stay "[]" / "{}" under indent
    var o4: json.JsonOpts = json.json_opts_indent(2)
    o4.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
    if !expect("{\"c\":[[],{}],\"b\":{},\"a\":[]}", &o4, "{\n  \"a\": [],\n  \"b\": {},\n  \"c\": [\n    [],\n    {}\n  ]\n}") { return 6 }
    if !expect("{}", &o4, "{}") { return 7 }
    if !expect("[]", &o4, "[]") { return 8 }
    // 5. separators=(" ; ", " = ")
    var o5: json.JsonOpts = sorted()
    var a: [u8; 4] = " ; \0"
    var b: [u8; 4] = " = \0"
    if !json.json_opts_set_separators(&o5, (&a[0]) as u64, 3, (&b[0]) as u64, 3) { return 9 }
    if !expect(doc1, &o5, "{\"B\" = null ; \"a\" = [3 ; {\"y\" = 1 ; \"z\" = 0}] ; \"b\" = 1 ; \"\\u00e4\" = true}") { return 10 }
    // too long separators are refused and change nothing
    var big: [u8; 20] = "01234567890123456789"
    if json.json_opts_set_separators(&o5, (&big[0]) as u64, 17, (&b[0]) as u64, 3) { return 11 }
    if !expect(doc1, &o5, "{\"B\" = null ; \"a\" = [3 ; {\"y\" = 1 ; \"z\" = 0}] ; \"b\" = 1 ; \"\\u00e4\" = true}") { return 12 }
    // 6. indent="\t"
    var o6: json.JsonOpts = json.json_opts_indent(1)
    var tab: [u8; 2] = "\t\0"
    if !json.json_opts_set_indent_text(&o6, (&tab[0]) as u64, 1) { return 13 }
    o6.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
    if !expect(doc1, &o6, "{\n\t\"B\": null,\n\t\"a\": [\n\t\t3,\n\t\t{\n\t\t\t\"y\": 1,\n\t\t\t\"z\": 0\n\t\t}\n\t],\n\t\"b\": 1,\n\t\"\\u00e4\": true\n}") { return 14 }
    // 7. ensure_ascii True / False: surrogate pair, DEL, U+2028, e acute, control, quote, backslash
    let esc: str = "[\"\\ud83d\\ude00 \\u007f \\u2028 \\u00e9 \\u0001 \\\" \\\\ / \\b\\f\\n\\r\\t\"]"
    if !expect(esc, &o0, "[\"\\ud83d\\ude00 \\u007f \\u2028 \\u00e9 \\u0001 \\\" \\\\ / \\b\\f\\n\\r\\t\"]") { return 15 }
    var o7: json.JsonOpts = json.json_opts_new()
    o7.flags = 0 as u32
    if !expect(esc, &o7, "[\"\u{1f600} \u{7f} \u{2028} \u{e9} \\u0001 \\\" \\\\ / \\b\\f\\n\\r\\t\"]") { return 16 }
    // 8. keys by CODE POINT (Python): "~" < DEL-escaped < U+FF5E < U+1F600 -- not by UTF-16 unit
    let keys: str = "{\"\\uff5e\":1,\"\\ud83d\\ude00\":2,\"~\":3,\"\\u007f\":4}"
    if !expect(keys, &o1, "{\"~\": 3, \"\\u007f\": 4, \"\\uff5e\": 1, \"\\ud83d\\ude00\": 2}") { return 17 }
    var o8: json.JsonOpts = json.json_opts_new()
    o8.flags = json.JSON_SORT_KEYS
    if !expect(keys, &o8, "{\"~\": 3, \"\u{7f}\": 4, \"\u{ff5e}\": 1, \"\u{1f600}\": 2}") { return 18 }
    // 9. prefix keys, empty key, NUL in a key; indent=1
    var o9: json.JsonOpts = json.json_opts_indent(1)
    o9.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
    if !expect("{\"b\":{\"y\":1,\"x\":2},\"a\":1,\"\":0,\"aa\":2,\"a\\u0000\":3}", &o9, "{\n \"\": 0,\n \"a\": 1,\n \"a\\u0000\": 3,\n \"aa\": 2,\n \"b\": {\n  \"x\": 2,\n  \"y\": 1\n }\n}") { return 19 }
    // 10. duplicate keys are kept, in document order (J7)
    if !expect("{\"k\":2,\"a\":0,\"k\":1}", &o1, "{\"a\": 0, \"k\": 2, \"k\": 1}") { return 20 }
    // 11. Infinity: null unless JSON_PY_NONFINITE (then Python's text)
    if !expect("[1e999,-1e999]", &o1, "[null, null]") { return 21 }
    var o11: json.JsonOpts = sorted()
    o11.flags = o11.flags | json.JSON_PY_NONFINITE
    if !expect("[1e999,-1e999]", &o11, "[Infinity, -Infinity]") { return 22 }
    // 12. indent=0: line breaks without blanks
    var o12: json.JsonOpts = json.json_opts_indent(0)
    if !expect("{\"a\":[1,2]}", &o12, "{\n\"a\": [\n1,\n2\n]\n}") { return 23 }
    // 13. separators=(", ", ": ") with indent=1 keeps the blank before the line break
    var o13: json.JsonOpts = json.json_opts_new()
    json.json_opts_set_indent(&o13, 1)
    if !expect("[1,2]", &o13, "[\n 1, \n 2\n]") { return 24 }
    // 14. compact
    var o14: json.JsonOpts = json.json_opts_compact()
    o14.flags = json.JSON_ASCII | json.JSON_SORT_KEYS
    if !expect(doc1, &o14, "{\"B\":null,\"a\":[3,{\"y\":1,\"z\":0}],\"b\":1,\"\\u00e4\":true}") { return 25 }
    // 15. scalars at top level
    if !expect("  \"x\\u00e9\"  ", &o0, "\"x\\u00e9\"") { return 26 }
    if !expect("-12", &o0, "-12") { return 27 }
    if !expect("null", &o0, "null") { return 28 }
    // 16. the OLD calls are unchanged: shortest float text, no forced exponent range
    var d: json.Json = json.json_new()
    defer json.json_free(&d)
    let old: str = "[1e16,1e-5,-0.0,{\"b\":1,\"a\":2}]"
    let ok: bool = json.json_parse(&d, old.p as u64, old.length()) catch false
    if !ok { return 29 }
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    json.json_write(&d, json.json_root(&d), &out, true)
    let want_old: str = "[10000000000000000.0,0.00001,0.0,{\"b\":1,\"a\":2}]"
    if rt.buf_len(&out) != want_old.length() { return 30 }
    if !rt.mem_eq(rt.buf_ptr(&out), want_old.p as u64, want_old.length()) { return 31 }
    // 17. an exact tie between two shortest digit strings: the EVEN digit wins, as in
    //     Python's repr (1576992552742323.25 is exact in binary; repr gives ...23.2)
    if !expect("[1576992552742323.25, 1576992552742323.75, 9007199254740993.0]", &o0, "[1576992552742323.2, 1576992552742323.8, 9007199254740992.0]") { return 32 }
    return 0
}
