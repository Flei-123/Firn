// expect_exit: 0
// tests/2863_grapheme_cluster.fi -- extended grapheme clusters (lib/str/grapheme.fi, UAX #29).
// Hand-made cases for every rule family; the full official file and a regex cross-check run in
// tools/grapheme/run.sh (gate 135).
import std.rt
import str.grapheme

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

// Number of clusters in the UTF-8 octets [a, b, ...] written into a buffer.
fn clusters(t: u64, s: str) -> usize {
    return grapheme.gb_count(t, s.p as u64, s.n)
}

fn main() -> i32 {
    let t: u64 = grapheme.gb_map()
    check(t != 0, 1)
    check(clusters(t, "") == 0, 2)
    check(clusters(t, "abc") == 3, 3)
    // GB3: CR LF is one; LF CR is two
    check(clusters(t, "\r\n") == 1, 4)
    check(clusters(t, "\n\r") == 2, 5)
    // GB9: e + COMBINING ACUTE; ZWJ
    check(clusters(t, "e\u{301}") == 1, 6)
    check(clusters(t, "e\u{301}\u{301}x") == 2, 7)
    // GB11: man ZWJ woman ZWJ girl = 1; a ZWJ not between pictographs does not join
    check(clusters(t, "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}") == 1, 8)
    check(clusters(t, "a\u{200D}\u{1F468}") == 2, 9)
    // skin tone, VS16, keycap
    check(clusters(t, "\u{1F44D}\u{1F3FD}") == 1, 10)
    check(clusters(t, "\u{2764}\u{FE0F}") == 1, 11)
    check(clusters(t, "1\u{FE0F}\u{20E3}") == 1, 12)
    // GB12/13: four regional indicators = two flags, three = flag + single
    check(clusters(t, "\u{1F1E6}\u{1F1F9}\u{1F1E9}\u{1F1EA}") == 2, 13)
    check(clusters(t, "\u{1F1E6}\u{1F1F9}\u{1F1E9}") == 2, 14)
    // Hangul: L V T = 1, LV T = 1, but L after T starts a new one
    check(clusters(t, "\u{1100}\u{1161}\u{11A8}") == 1, 15)
    check(clusters(t, "\u{AC00}\u{11A8}") == 1, 16)
    check(clusters(t, "\u{11A8}\u{1100}") == 2, 17)
    // GB9b Prepend, GB9a SpacingMark
    check(clusters(t, "\u{600}a") == 1, 18)
    check(clusters(t, "\u{915}\u{93E}") == 1, 19)
    // GB9c: DEVANAGARI KA + VIRAMA + SSA is one conjunct
    check(clusters(t, "\u{915}\u{94D}\u{937}") == 1, 20)
    check(clusters(t, "\u{915}\u{937}") == 2, 21)
    // table values
    check(grapheme.gb_class(t, 13) == grapheme.GB_CR, 22)
    check(grapheme.gb_class(t, 0x200D) == grapheme.GB_ZWJ, 23)
    check(grapheme.gb_ext_pict(t, 0x1F600), 24)
    check(!grapheme.gb_ext_pict(t, 65), 25)
    check(grapheme.gb_incb(t, 0x94D) == 2 as u32, 26)
    // malformed octets: one U+FFFD each, always progress
    var bad: [u8; 4] = [255 as u8, 192 as u8, 65 as u8, 128 as u8]
    check(grapheme.gb_count(t, (&bad) as u64, 4) == 4, 27)
    grapheme.gb_free(t)
    return 0
}
