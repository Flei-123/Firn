// expect_exit: 0
// RUNDE 49 — DER SAMMLER UNTER MEHREREN FAEDEN.
//
// Das ist der eigentliche Punkt der Runde. Geprueft wird:
//   A  Mehrere Faeden allozieren GLEICHZEITIG aus demselben Heap, und der
//      Sammler laeuft dabei. Das Ergebnis ist DETERMINISTISCH: jeder Faden
//      liefert dieselbe Summe wie in einem Einfadenlauf.
//   B  Was ein Faden festhaelt, ueberlebt — auch wenn ein ANDERER Faden den
//      Sammellauf fuehrt. Jede Kette wird am Ende Glied fuer Glied
//      nachgerechnet; ein einziges eingesammeltes Glied faellt auf.
//   C  Was der HAUPTFADEN festhaelt, ueberlebt ebenso (sein Stapel ist der
//      einzige, den der Sammler vor Runde 49 kannte).
//   D  Die Welt wurde wirklich angehalten (gc_stw_laeufe() > 0) und es gab
//      wirklich Sammellaeufe (gc_collections() > 0). Ohne diese beiden
//      Zahlen koennte der Test bestehen, ohne je einen Sammler gesehen zu
//      haben.
//   E  Kein Faden bleibt uebrig (faden_anzahl() == 1) und der Heap bleibt
//      beschraenkt.

gc class Node {
    next: Gc[Node],
    value: u64,
}

const KETTE: u64 = 400
const MUELL: u64 = 6000

// Baut eine Kette von KETTE Gliedern mit den Werten `art*1000 + i` und
// erzeugt dazwischen MUELL kurzlebige Objekte, damit der Sammler wirklich
// arbeiten muss. Liefert den Kopf der Kette.
fn chain_build(kind: u64) -> AllocError!Gc[Node] {
    var header: Gc[Node] = gc_null[Node]()
    var i: u64 = 0
    while i < KETTE {
        let n: Gc[Node] = try gc Node{ next: header, value: kind * 1000 + i }
        header = n
        var m: u64 = 0
        while m < MUELL / KETTE {
            let dead: Gc[Node] = try gc Node{ next: gc_null[Node](), value: 0 }
            if dead.value != 0 {
                return header
            }
            m = m + 1
        }
        i = i + 1
    }
    return header
}

// Rechnet die Kette nach: Laenge, Reihenfolge und Werte. 0 = in Ordnung,
// sonst die Nummer des ersten Fehlers.
fn chain_check(header: Gc[Node], kind: u64) -> u64 {
    var p: Gc[Node] = header
    var i: u64 = KETTE
    while i > 0 {
        i = i - 1
        if p == gc_null[Node]() {
            return 1
        }
        if p.value != kind * 1000 + i {
            return 2
        }
        p = p.next
    }
    if p != gc_null[Node]() {
        return 3
    }
    return 0
}

fn work(kind: u64) -> AllocError!u64 {
    let header: Gc[Node] = try chain_build(kind)
    // Erst NACH einem weiteren Sammellauf nachrechnen: die Kette haengt in
    // diesem Augenblick nur noch am Stapel DIESES Fadens.
    gc_collect()
    let rc: u64 = chain_check(header, kind)
    if rc != 0 {
        return 900 + rc
    }
    return kind
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    let _unused: u64 = arg
    let r: AllocError!u64 = work(kind)
    return r catch 800
}

fn run() -> AllocError!i32 {
    // C: der Hauptfaden haelt seine eigene Kette waehrend des ganzen Laufs.
    let my: Gc[Node] = try chain_build(9)

    var h: [u64; 6] = [0; 6]
    var i: u64 = 0
    while i < 6 {
        h[i as usize] = thread_start(i + 1, 0)
        if h[i as usize] == 0 {
            return 1
        }
        i = i + 1
    }
    // Der Hauptfaden alloziert waehrenddessen selbst weiter.
    var own: u64 = 0
    while own < 4 {
        let k: Gc[Node] = try chain_build(20 + own)
        if chain_check(k, 20 + own) != 0 {
            return 2
        }
        own = own + 1
    }

    var sum: u64 = 0
    i = 0
    while i < 6 {
        let r: u64 = thread_wait(h[i as usize])
        if r >= 800 {
            return 3
        }
        sum = sum + r
        i = i + 1
    }
    if sum != 21 {
        return 4
    }
    if chain_check(my, 9) != 0 {
        return 5
    }
    if gc_collections() == 0 {
        return 6
    }
    if gc_stw_runs() == 0 {
        return 7
    }
    if thread_count() != 1 {
        return 8
    }
    if gc_heap_bytes() > 33554432 {
        return 9
    }
    return 0
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    if !thread_init() {
        return 91
    }
    return run() catch 92
}
