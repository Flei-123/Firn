// expect_exit: 42
// r167: Firn threads next to glibc. A program with `#[link_lib(c)]` (std.dynlib)
// runs on glibc's TLS (`fs`). The thread runtime used to replace the main
// thread's `fs` base by the Firn thread block, so the first TLS access of
// loaded code (errno, Mesa/libGLdispatch `__thread`, dlopen's slotinfo) read
// garbage and crashed. Now such a program keeps its thread block behind `gs`.
//
//   A  `fs` base of the main thread is the same before and after the first thread
//   B  `gs` base is the thread block (non zero) once threads exist
//   C  glibc TLS still works afterwards: errno through `__errno_location`,
//      dlopen of a library that was not loaded yet, a C call from main
//   D  the Firn thread still runs and joins
import std.dynlib

const T_GET_FS: i64 = 4099
const T_GET_GS: i64 = 4100
const T_SYS_PRCTL: i64 = 158

fn __thread_work(kind: u64, arg: u64) -> u64 {
    return arg + 1
}

fn fs_base() -> u64 {
    var v: [u64; 2] = [0; 2]
    syscall(T_SYS_PRCTL, T_GET_FS, (&v[0]) as i64, 0, 0, 0, 0)
    return v[0]
}

fn gs_base() -> u64 {
    var v: [u64; 2] = [0; 2]
    syscall(T_SYS_PRCTL, T_GET_GS, (&v[0]) as i64, 0, 0, 0, 0)
    return v[0]
}

fn main() -> i32 {
    let h: u64 = dynlib.open("libc.so.6")
    if h == 0 { return 1 }
    let el: u64 = dynlib.sym(h, "__errno_location")
    if el == 0 { return 2 }
    let fs0: u64 = fs_base()
    if fs0 == 0 { return 3 }

    let t: u64 = thread_start(1, 41)
    if t == 0 { return 4 }

    // A
    if fs_base() != fs0 { return 5 }
    // B
    if gs_base() == 0 { return 6 }
    // C: errno lives in glibc's TLS block
    let ep: u64 = dynlib.ci0(el)
    if ep == 0 { return 7 }
    *(ep as *mut i32) = 1234
    let ep2: u64 = dynlib.ci0(el)
    if ep2 != ep { return 8 }
    if *(ep2 as *mut i32) != 1234 { return 9 }
    // a library that is loaded only now: ld.so has to walk the TLS slot info of this thread
    let hm: u64 = dynlib.open("libm.so.6")
    if hm == 0 { return 10 }
    let fl: u64 = dynlib.sym(hm, "floor")
    var a: [u64; 2] = [0; 2]
    a[0] = __bits(2.5) as u64
    if __f64_from_bits(dynlib.callx(fl, "d", (&a[0]) as u64, true)) != 2.0 { return 11 }
    if *(dynlib.ci0(el) as *mut i32) != 1234 { return 12 }
    // D
    if thread_wait(t) != 42 { return 13 }
    if fs_base() != fs0 { return 14 }
    return 42
}
