// expect_exit: 1
// only_mode: opt
// ROUND 72: this program exists to show the wraparound of `i16` addition, which is true by
// definition only in the ONE build level that does not check it --
// `--opt-level=release-fast` (SPEC 13, item L9). dev/dev-fast/
// release-safe correctly panic on it instead.
// 16-bit types: wrapping and signed division
fn main() -> i32 {
    var a: i16 = 30000
    a = a + 10000 // laeuft um: 40000 - 65536 = -25536
    let b: i16 = a / 100 // -255
    if a == -25536 && b == -255 { return 1 }
    return 0
}
