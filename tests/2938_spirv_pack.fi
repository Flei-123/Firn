// expect_exit: 0
// tests/2938_spirv_pack.fi -- gpu.spirv GLSL.std.450 Pack/Unpack (54-58, 60-64) from pack.frag (glslang): hand-computed
// constants, exhaustive-style round trips (unorm/snorm 8 + 16 bit, every 5th half), 96 float->half cases from numpy float16
// (round to nearest even, subnormals, overflow), half->float against a pow() formula.
import std.rt
import std.math
import gpu.spirv

const SH: str = __include_str("../lib/gpu/spv/test/pack.frag.spv")

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn outw(m: *mut spirv.Spv, loc: u32, k: usize) -> u32 {
    return spirv.spv_mem_get(m, spirv.spv_find_location(m, 3, loc), k)
}

fn outf(m: *mut spirv.Spv, loc: u32, k: usize) -> f32 {
    return spirv.spv_mem_get_f32(m, spirv.spv_find_location(m, 3, loc), k)
}

fn set4(m: *mut spirv.Spv, a: f32, b: f32, c: f32, d: f32) {
    let p: usize = spirv.spv_find_location(m, 1, 0)
    spirv.spv_mem_set_f32(m, p, 0, a)
    spirv.spv_mem_set_f32(m, p, 1, b)
    spirv.spv_mem_set_f32(m, p, 2, c)
    spirv.spv_mem_set_f32(m, p, 3, d)
}

fn setu(m: *mut spirv.Spv, x: u32, y: u32) {
    let p: usize = spirv.spv_find_location(m, 1, 1)
    spirv.spv_mem_set(m, p, 0, x)
    spirv.spv_mem_set(m, p, 1, y)
}

// half bits -> f32 by the textbook formula (no bit tricks)
fn half_ref(h: u32) -> f32 {
    let e: i32 = ((h >> 10) & 0x1f) as i32
    let mant: f32 = (h & 0x3ff) as f32
    var mag: f32 = 0.0
    if e == 0 {
        mag = mant / 1024.0 * 0.00006103515625
    } else {
        mag = (1.0 + mant / 1024.0) * (math.powf(2.0, (e - 15) as f64) as f32)
    }
    if (h & 0x8000) != 0 {
        return 0.0 - mag
    }
    return mag
}

fn main() -> i32 {
    let HALF_IN: [u32; 96] = [0x00000000, 0x80000000, 0x3f800000, 0xc0000000, 0x477fe000, 0x477feffd, 0x477ff000, 0x322bcc77, 0x33800000, 0x33000000, 0x3300d959, 0x38800000, 0x387fc000, 0x3f802000, 0x3f801000, 0x3f803000, 0x45000800, 0x45001000, 0x3dcccccd, 0x3eaaaa9f, 0xbf333333, 0x47c35000, 0xc7c35000, 0x7f7fc99e, 0x00800000, 0x00000001, 0xb9b28994, 0xb42ecee5, 0xb404cca8, 0xbc1ece0c, 0xbee9d64a, 0xb5d0b85a, 0xbfc9de82, 0xbb85f66c, 0x44b5a659, 0x3ec7b683, 0xc14a71e0, 0x400c789b, 0xc1cf3bb5, 0x3de37c3c, 0x3d2e4855, 0xb85978a6, 0x384339a4, 0x4524db25, 0xc7c18704, 0x3693743b, 0xbdfb2371, 0x34ab8921, 0x3aca3a02, 0xbcf8eb4f, 0xbd07c404, 0x41a46da0, 0x3b02e358, 0xbcce329d, 0xbde25575, 0xb5b2ee50, 0x460a507d, 0x3cf112b9, 0x445a6b35, 0x47fa96f0, 0xb6135dbf, 0xc0be1342, 0x3fa4164e, 0x364e0e55, 0xb9d86219, 0xbe3a734d, 0x4532f3f2, 0x3b513067, 0xb47e0997, 0xbc2b86e1, 0xb4488c5e, 0x3ece8ef1, 0xb4ce99d0, 0x367a4cc7, 0x3f8fb94b, 0x44bd7d96, 0xb98d147c, 0x3a3d437c, 0xc11a447c, 0x4692c3df, 0xbee10ad4, 0xb9591cfa, 0x38f441d1, 0xbac42bfd, 0x435176ee, 0xbfe72d95, 0xc41996ea, 0xbdfeab55, 0x43212ca0, 0x41393ec2, 0x46fa3d76, 0xba8d137c, 0x3d1a28e8, 0xbfbd5f63, 0xc0ead5c6, 0x35e42280]
    let HALF_OUT: [u32; 96] = [0x0000, 0x8000, 0x3c00, 0xc000, 0x7bff, 0x7bff, 0x7c00, 0x0000, 0x0001, 0x0000, 0x0001, 0x0400, 0x03ff, 0x3c01, 0x3c00, 0x3c02, 0x6800, 0x6800, 0x2e66, 0x3555, 0xb99a, 0x7c00, 0xfc00, 0x7c00, 0x0000, 0x0000, 0x8d94, 0x8003, 0x8002, 0xa0f6, 0xb74f, 0x801a, 0xbe4f, 0x9c30, 0x65ad, 0x363e, 0xca54, 0x4064, 0xce7a, 0x2f1c, 0x2972, 0x8366, 0x030d, 0x6927, 0xfc00, 0x004a, 0xafd9, 0x0005, 0x1652, 0xa7c7, 0xa83e, 0x4d23, 0x1817, 0xa672, 0xaf13, 0x8016, 0x7053, 0x2789, 0x62d3, 0x7c00, 0x8025, 0xc5f1, 0x3d21, 0x0034, 0x8ec3, 0xb1d4, 0x6998, 0x1a8a, 0x8004, 0xa15c, 0x8003, 0x3674, 0x8006, 0x003f, 0x3c7e, 0x65ec, 0x8c69, 0x11ea, 0xc8d2, 0x7496, 0xb708, 0x8ac9, 0x07a2, 0x9621, 0x5a8c, 0xbf39, 0xe0cd, 0xaff5, 0x5909, 0x49ca, 0x77d2, 0x9469, 0x28d1, 0xbdeb, 0xc757, 0x001d]
    var m: spirv.Spv = spirv.spv_zero()
    check(spirv.spv_new(SH.p as u64, SH.n, &m), 1)
    let ent: u32 = spirv.spv_find_entry(&m, 4)
    check(ent != 0, 2)
    // hand-computed constants
    set4(&m, 1.0, 0.25, -1.0, 0.25)
    setu(&m, 0x80ff7f00, 0xc0003c00)
    check(spirv.spv_run(&m, ent, 100000), 3)
    check(outw(&m, 0, 0) == 0x400040ff, 10)
    check(outw(&m, 1, 0) == 0x2081207f, 11)
    check(outw(&m, 2, 0) == 0x4000ffff, 12)
    check(outw(&m, 3, 0) == 0x20008001, 13)
    check(outw(&m, 4, 0) == 0xbc003400, 14)
    check(outf(&m, 5, 0) == 0.0 && outf(&m, 5, 1) == 127.0 / 255.0 && outf(&m, 5, 2) == 1.0 && outf(&m, 5, 3) == 128.0 / 255.0, 15)
    check(outf(&m, 6, 0) == 0.0 && outf(&m, 6, 1) == 1.0 && outf(&m, 6, 2) == -1.0 / 127.0 && outf(&m, 6, 3) == -1.0, 16)
    check(outf(&m, 7, 0) == 15360.0 / 65535.0 && outf(&m, 7, 1) == 49152.0 / 65535.0, 17)
    check(outf(&m, 8, 0) == 15360.0 / 32767.0 && outf(&m, 8, 1) == -16384.0 / 32767.0, 18)
    check(outf(&m, 9, 0) == 1.0 && outf(&m, 9, 1) == -2.0, 19)
    // clamping
    set4(&m, 2.0, -3.0, 70000.0, 0.0)
    check(spirv.spv_run(&m, ent, 100000), 20)
    check(outw(&m, 0, 0) == 0x00ff00ff && outw(&m, 1, 0) == 0x007f817f && outw(&m, 2, 0) == 0x0000ffff, 21)
    check(outw(&m, 3, 0) == 0x00007fff && outw(&m, 4, 0) == 0x7c00c200, 22)
    // 8-bit round trips: every byte value in every position
    var i: u32 = 0
    while i < 64 {
        let x: u32 = i | ((i + 64) << 8) | ((i + 128) << 16) | ((i + 192) << 24)
        setu(&m, x, 0)
        check(spirv.spv_run(&m, ent, 100000), 30)
        var k: usize = 0
        while k < 4 {
            let b: u32 = (x >> ((k as u32) * 8)) & 0xff
            check(outf(&m, 5, k) == (b as f32) / 255.0, 3100 + (i as i32) * 4 + (k as i32))
            var sn: f32 = ((b ^ 0x80) as f32 - 128.0) / 127.0
            if sn < -1.0 {
                sn = -1.0
            }
            check(outf(&m, 6, k) == sn, 3400 + (i as i32) * 4 + (k as i32))
            k = k + 1
        }
        // back through pack: unorm exact, snorm exact except -128 -> -127
        set4(&m, outf(&m, 5, 0), outf(&m, 5, 1), outf(&m, 5, 2), outf(&m, 5, 3))
        check(spirv.spv_run(&m, ent, 100000), 31)
        check(outw(&m, 0, 0) == x, 3700 + i as i32)
        var want: u32 = 0
        k = 0
        while k < 4 {
            var b: u32 = (x >> ((k as u32) * 8)) & 0xff
            if b == 0x80 {
                b = 0x81
            }
            want = want | (b << ((k as u32) * 8))
            k = k + 1
        }
        setu(&m, x, 0)
        check(spirv.spv_run(&m, ent, 100000), 32)
        set4(&m, outf(&m, 6, 0), outf(&m, 6, 1), outf(&m, 6, 2), outf(&m, 6, 3))
        check(spirv.spv_run(&m, ent, 100000), 33)
        check(outw(&m, 1, 0) == want, 3800 + i as i32)
        i = i + 1
    }
    // 16-bit round trips and half -> float, every 5th half (all exponents, both signs, subnormals)
    var h: u32 = 0
    while h < 65536 {
        let h2: u32 = (h + 2500) & 0xffff
        setu(&m, 0, h | (h2 << 16))
        check(spirv.spv_run(&m, ent, 100000), 40)
        let e1: u32 = (h >> 10) & 0x1f
        let e2: u32 = (h2 >> 10) & 0x1f
        if e1 != 31 {
            check(outf(&m, 9, 0) == half_ref(h), 41)
        }
        if e2 != 31 {
            check(outf(&m, 9, 1) == half_ref(h2), 42)
        }
        check(outf(&m, 7, 0) == ((h & 0xffff) as f32) / 65535.0 && outf(&m, 7, 1) == (h2 as f32) / 65535.0, 43)
        if e1 != 31 && e2 != 31 {
            // half pair -> floats -> packHalf2x16 (y, z of the input) is the identity
            set4(&m, 0.0, outf(&m, 9, 0), outf(&m, 9, 1), 0.0)
            check(spirv.spv_run(&m, ent, 100000), 44)
            var want: u32 = h | (h2 << 16)
            if h == 0x8000 {
                want = (want & 0xffff0000) | 0x8000
            }
            check(outw(&m, 4, 0) == want, 45)
        }
        // unorm16 / snorm16 round trip
        set4(&m, outf(&m, 7, 0), outf(&m, 7, 1), outf(&m, 8, 0), outf(&m, 8, 1))
        check(spirv.spv_run(&m, ent, 100000), 46)
        check(outw(&m, 2, 0) == (h | (h2 << 16)), 47)
        var sw: u32 = h | (h2 << 16)
        if h == 0x8000 {
            sw = (sw & 0xffff0000) | 0x8001
        }
        if h2 == 0x8000 {
            sw = (sw & 0xffff) | 0x80010000
        }
        check(outw(&m, 3, 0) == sw, 48)
        h = h + 5
    }
    // float -> half against numpy
    var t: usize = 0
    while t < 96 {
        set4(&m, 0.0, math.math_f32(HALF_IN[t]), 0.0, 0.0)
        check(spirv.spv_run(&m, ent, 100000), 50)
        check((outw(&m, 4, 0) & 0xffff) == HALF_OUT[t], 5000 + t as i32)
        t = t + 1
    }
    spirv.spv_free(&m)
    return 0
}
