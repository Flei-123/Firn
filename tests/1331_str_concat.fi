// expect_exit: 0
// tests/1331_str_concat.fi -- `+` on `str` (round 70).
//
// The result of a concatenation outlives both operands, so it needs an
// owner: the collector. `__str_concat` allocates in the GC heap
// (lib/gc/gc.fi), the conservative stack scan keeps the octets alive as long
// as a `str` in a frame points at them.
//
// A program that concatenates therefore calls `gc_init()` first -- like
// everything else in this language that allocates (SPEC 3.5).

fn main() -> i32 {
    if !gc_init() { return 1 }
    let a: str = "hello"
    let b: str = " world"
    let c: str = a + b
    if c.n != 11 { return 2 }
    if c != "hello world" { return 3 }
    if c == "hello worlds" { return 4 }
    // neither operand has changed -- `str` is immutable
    if a != "hello" { return 5 }
    if b != " world" { return 6 }
    // the empty side costs no allocation and changes nothing
    let e: str = ""
    if (a + e) != "hello" { return 7 }
    if (e + a) != "hello" { return 8 }
    if (e + e) != "" { return 9 }
    // chained
    let d: str = a + " " + "again" + "!"
    if d != "hello again!" { return 10 }
    // in a loop: many short lived strings, the collector takes them back
    var k: i32 = 0
    var last: str = ""
    while k < 2000 {
        last = "abc" + "def"
        k = k + 1
    }
    if last != "abcdef" { return 11 }
    // the collector really ran and gave the short lived pieces back
    gc_collect()
    let live: u64 = gc_live_objects()
    if live > 64 { return 12 }
    return 0
}
