// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_schema
import mc.mc_registry
import mc.mc_inv

fn it(r: *mut mc_registry.Registry, name: str) -> i32 { return mc_registry.reg_item_by_name(r, name.p as u64, name.n) }

fn layout(ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let id: i32 = mc_version.version_pid(ver, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK)
    if id < 0 { return false }
    let sch: u64 = (*ver).schema_of(mc_version.ST_PLAY, mc_version.DIR_C2S, id)
    if sch == 0 as u64 { return false }
    bytes.bytes_set_pos(b, 0)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk(sch, b, &out)
    rt.buf_free(&out)
    return ok
}

fn click(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32, win: *mut i32) -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(v, (*ver).protocol, slot, button, mode, &b) { bytes.bytes_free(&b); return 0 - 1 }
    *win = bytes.bytes_at(&b, 0) as i32
    let ok: bool = layout(ver, &b)
    var n: i32 = 0
    if (*ver).protocol >= 756 { n = bytes.bytes_at(&b, 6) as i32 }
    bytes.bytes_free(&b)
    if !ok { return 0 - 2 }
    return n
}

fn clk(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32) -> i32 {
    var w: i32 = 0
    return click(v, ver, slot, button, mode, &w)
}

fn put_stack(b: *mut bytes.Bytes, p: i32, item: i32, count: i32) {
    if p >= 766 {
        if item < 0 { bytes.put_varint(b, 0); return }
        bytes.put_varint(b, count)
        bytes.put_varint(b, item)
        bytes.put_varint(b, 0)
        bytes.put_varint(b, 0)
    } else {
        if item < 0 { bytes.put_bool(b, false); return }
        bytes.put_bool(b, true)
        bytes.put_varint(b, item)
        bytes.put_i8(b, count as i8)
        bytes.put_u8(b, 0 as u8)
    }
}

fn open_win(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32, typ: i32, legacy_name: str, legacy_n: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    if (*ver).protocol >= 477 {
        bytes.put_varint(&b, id)
        bytes.put_varint(&b, typ)
        bytes.put_u8(&b, 0 as u8)
    } else {
        bytes.put_u8(&b, id as u8)
        bytes.put_string(&b, legacy_name.p as u64, legacy_name.n)
        bytes.put_string(&b, "{}".p as u64, 2)
        bytes.put_u8(&b, legacy_n as u8)
    }
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_open_window_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn win_items(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32, items: u64, counts: u64, n: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    let p: i32 = (*ver).protocol
    bytes.put_u8(&b, id as u8)
    if p >= 756 {
        bytes.put_varint(&b, 7) // stateId
        bytes.put_varint(&b, n)
    } else {
        bytes.put_i16(&b, n as i16)
    }
    var i: i32 = 0
    while i < n {
        put_stack(&b, p, rt.ld32(items, i as usize) as i32 - 1, rt.ld32(counts, i as usize) as i32)
        i = i + 1
    }
    if p >= 756 { put_stack(&b, p, 0 - 1, 0) } // carried item
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_window_items_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn set_slot(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32, slot: i32, item: i32, count: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    let p: i32 = (*ver).protocol
    bytes.put_u8(&b, id as u8)
    if p >= 756 { bytes.put_varint(&b, 8) }
    bytes.put_i16(&b, slot as i16)
    put_stack(&b, p, item, count)
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_set_slot_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn fresh(r: *mut mc_registry.Registry) -> mc_inv.Inv {
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_use_registry(&v, r)
    return v
}

fn alloc_win(n: i32) -> u64 {
    let a: u64 = rt.heap_alloc((n as usize) * 4)
    var k: usize = 0
    while k < (n as usize) { rt.st32(a, k, 0 as u32); k = k + 1 }
    return a
}

fn open_typed(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32, typ: i32, n: i32) -> bool {
    if !open_win(v, ver, id, typ, "", 0) { return false }
    let items: u64 = alloc_win(n)
    let counts: u64 = alloc_win(n)
    let ok: bool = win_items(v, ver, id, items, counts, n)
    rt.heap_free(items, (n as usize) * 4)
    rt.heap_free(counts, (n as usize) * 4)
    return ok
}

fn table_case(p: i32, typ: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var r: mc_registry.Registry = ver.registry_of()
    if !mc_registry.registry_ok(&r) { return 101 }
    let stone: i32 = it(&r, "stone")
    let dirt: i32 = it(&r, "dirt")
    var v: mc_inv.Inv = fresh(&r)
    if !open_typed(&v, &ver, 4, typ, 46) { return 110 }
    if mc_inv.inv_window_slots(&v) != 10 { return 111 }
    if !set_slot(&v, &ver, 4, 10, stone, 10) { return 112 }
    if clk(&v, &ver, 10, 0, 1) < 0 { return 120 }
    if mc_inv.inv_win_item(&v, 1) != stone || mc_inv.inv_win_count(&v, 1) != 10 { return 121 }
    if mc_inv.inv_win_item(&v, 10) != 0 - 1 || mc_inv.inv_item(&v, 9) != 0 - 1 { return 122 }
    if clk(&v, &ver, 1, 0, 1) < 0 { return 130 }
    if mc_inv.inv_win_item(&v, 1) != 0 - 1 || mc_inv.inv_item(&v, 9) != stone || mc_inv.inv_count(&v, 9) != 10 { return 131 }
    var g: i32 = 1
    while g <= 9 {
        if !set_slot(&v, &ver, 4, g, stone, 64) { return 140 }
        g = g + 1
    }
    if !set_slot(&v, &ver, 4, 11, dirt, 3) { return 141 }
    if clk(&v, &ver, 11, 0, 1) < 0 { return 150 }
    if mc_inv.inv_item(&v, 36) != dirt || mc_inv.inv_count(&v, 36) != 3 || mc_inv.inv_item(&v, 10) != 0 - 1 { return 151 }
    if clk(&v, &ver, 37, 0, 1) < 0 { return 160 }
    if mc_inv.inv_item(&v, 36) != 0 - 1 || mc_inv.inv_item(&v, 10) != dirt || mc_inv.inv_count(&v, 10) != 3 { return 161 }
    mc_inv.inv_free(&v)
    return 0
}

fn furnace_case(p: i32, typ: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var r: mc_registry.Registry = ver.registry_of()
    if !mc_registry.registry_ok(&r) { return 101 }
    let stone: i32 = it(&r, "stone")
    let coal: i32 = it(&r, "coal")
    var v: mc_inv.Inv = fresh(&r)
    if !open_typed(&v, &ver, 5, typ, 39) { return 210 }
    if mc_inv.inv_window_slots(&v) != 3 { return 211 }
    if !set_slot(&v, &ver, 5, 1, coal, 8) { return 212 }
    if !set_slot(&v, &ver, 5, 0, stone, 5) { return 213 }
    if !set_slot(&v, &ver, 5, 3, stone, 60) { return 214 }
    if clk(&v, &ver, 1, 0, 1) < 0 { return 220 }
    if mc_inv.inv_win_item(&v, 1) != 0 - 1 || mc_inv.inv_item(&v, 10) != coal || mc_inv.inv_count(&v, 10) != 8 { return 221 }
    if clk(&v, &ver, 0, 0, 1) < 0 { return 230 }
    if mc_inv.inv_win_item(&v, 0) != 0 - 1 || mc_inv.inv_item(&v, 9) != stone || mc_inv.inv_count(&v, 9) != 64 || mc_inv.inv_item(&v, 11) != stone || mc_inv.inv_count(&v, 11) != 1 { return 231 }
    if clk(&v, &ver, 3, 0, 1) < 0 { return 240 }
    if mc_inv.inv_item(&v, 9) != stone || mc_inv.inv_count(&v, 9) != 64 { return 241 }
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    var r: i32 = table_case(763, 11)
    if r != 0 { return r }
    r = table_case(769, 12)
    if r != 0 { return r }
    r = furnace_case(763, 13)
    if r != 0 { return r }
    r = furnace_case(769, 14)
    if r != 0 { return r }
    return 0
}
