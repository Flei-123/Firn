// expect_exit: 0
// tests/2700_mc_noise_basic.fi -- mc_noise sanity: published vectors, determinism, ranges.
// The exhaustive comparison (bit for bit with python, value for value with the real
// java.util.Random) is tools/mc/noise/run.sh.
import std.rt
import mc.mc_noise

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    // splitmix64, seed 0: the published first outputs
    var sm: mc_noise.SplitMix64 = mc_noise.splitmix_new(0 as u64)
    check(mc_noise.splitmix_next(&sm) == 16294208416658607535 as u64, 1)
    check(mc_noise.splitmix_next(&sm) == 7960286522194355700 as u64, 2)
    check(mc_noise.splitmix_next(&sm) == 487617019471545679 as u64, 3)

    // java.util.Random(42): nextInt() = -1170105035, then 234785527 (documented, widely reproduced)
    var j: mc_noise.JavaRandom = mc_noise.jrandom_new(42)
    check(mc_noise.jrandom_next_int(&j) == 0 - 1170105035, 4)
    check(mc_noise.jrandom_next_int(&j) == 234785527, 5)
    // nextInt(bound) stays in range for awkward bounds
    var k: i32 = 0
    while k < 1000 {
        let v: i32 = mc_noise.jrandom_next_int_bound(&j, 37)
        check(v >= 0 && v < 37, 6)
        k = k + 1
    }

    // improved noise: Ken Perlin's reference value
    var pl: mc_noise.Perlin = mc_noise.perlin_reference()
    let v: f64 = mc_noise.perlin3(&pl, 3.14, 42.0, 7.0)
    check(v > 0.13691995878399 && v < 0.13691995878402, 7)
    // lattice points are zero
    check(mc_noise.perlin3(&pl, 5.0, 9.0, 2.0) == 0.0, 8)

    // determinism and seed dependence
    var a: mc_noise.Perlin = mc_noise.perlin_seeded(7)
    var b: mc_noise.Perlin = mc_noise.perlin_seeded(7)
    var c: mc_noise.Perlin = mc_noise.perlin_seeded(8)
    check(mc_noise.perlin3(&a, 0.31, 0.47, 0.59) == mc_noise.perlin3(&b, 0.31, 0.47, 0.59), 9)
    check(mc_noise.perlin3(&a, 0.31, 0.47, 0.59) != mc_noise.perlin3(&c, 0.31, 0.47, 0.59), 10)

    // range of 20000 samples of each function
    var lo: f64 = 0.0
    var hi: f64 = 0.0
    var i: i32 = 0
    while i < 20000 {
        let x: f64 = i as f64 * 0.0731
        let y: f64 = i as f64 * 0.0517
        let n1: f64 = mc_noise.perlin3(&a, x, y, 1.5)
        let n2: f64 = mc_noise.simplex2(&a, x, y)
        let n3: f64 = mc_noise.simplex3(&a, x, y, 0.3)
        let n4: f64 = mc_noise.perlin_octaves3(&a, x, y, 0.2, 5, 2.0, 0.5)
        if n1 < lo { lo = n1 }
        if n1 > hi { hi = n1 }
        check(n1 >= 0.0 - 1.1 && n1 <= 1.1, 11)
        check(n2 >= 0.0 - 1.1 && n2 <= 1.1, 12)
        check(n3 >= 0.0 - 1.1 && n3 <= 1.1, 13)
        check(n4 >= 0.0 - 1.1 && n4 <= 1.1, 14)
        i = i + 1
    }
    check(lo < 0.0 - 0.5 && hi > 0.5, 15) // the function really varies
    // a heightmap of a chunk is reproducible and within sane bounds
    let h: u64 = rt.heap_alloc(256 * 4)
    mc_noise.heightmap_16x16(&a, 3, 0 - 2, h)
    var z: usize = 0
    while z < 256 {
        let hv: i32 = rt.ld32(h, z) as i32
        check(hv > 20 && hv < 110, 16)
        z = z + 1
    }
    rt.heap_free(h, 256 * 4)
    return 0
}
