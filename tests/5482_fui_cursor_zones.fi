// expect_exit: 42
// tests/5482_fui_cursor_zones.fi -- lib/fui/cursorreq.fi zones, the hotreg zone and the standard widgets' kinds.
import fui.cursorreq
import fui.hotreg
import fui.kit

fn main() -> i32 {
    cursorreq.begin()
    cursorreq.zone(0.0, 0.0, 100.0, 100.0, cursorreq.CURSOR_POINTER)
    cursorreq.zone(10.0, 10.0, 20.0, 20.0, cursorreq.CURSOR_TEXT)
    if cursorreq.kind_at(15.0, 15.0) != cursorreq.CURSOR_TEXT {
        return 1
    }
    if cursorreq.kind_at(50.0, 50.0) != cursorreq.CURSOR_POINTER {
        return 2
    }
    if cursorreq.kind_at(150.0, 50.0) != cursorreq.CURSOR_DEFAULT {
        return 3
    }
    cursorreq.zone(0.0, 0.0, 100.0, 100.0, cursorreq.CURSOR_DEFAULT)
    if cursorreq.kind_at(15.0, 15.0) != cursorreq.CURSOR_DEFAULT {
        return 4
    }
    cursorreq.begin()
    cursorreq.zone(0.0, 0.0, 0.0, 10.0, cursorreq.CURSOR_POINTER)
    if cursorreq.zone_count() != 0 {
        return 5
    }
    cursorreq.zone(0.0, 0.0, 10.0, 10.0, cursorreq.CURSOR_RESIZE_EW)
    cursorreq.pointer_set(5.0, 5.0)
    if cursorreq.wanted() != cursorreq.CURSOR_RESIZE_EW {
        return 6
    }
    cursorreq.request(cursorreq.CURSOR_WAIT)
    if cursorreq.wanted() != cursorreq.CURSOR_WAIT {
        return 7
    }
    cursorreq.pointer_gone()
    cursorreq.begin()
    hotreg.reset()
    let a: u32 = hotreg.state(1 as u32, 10.0, 10.0, 50.0, 20.0, true)
    let b: u32 = hotreg.state_kind(2 as u32, 10.0, 50.0, 50.0, 20.0, true, cursorreq.CURSOR_TEXT)
    let c: u32 = hotreg.state(3 as u32, 10.0, 90.0, 50.0, 20.0, false)
    if cursorreq.kind_at(20.0, 20.0) != cursorreq.CURSOR_POINTER {
        return 8
    }
    if cursorreq.kind_at(20.0, 60.0) != cursorreq.CURSOR_TEXT {
        return 9
    }
    if cursorreq.kind_at(20.0, 95.0) != cursorreq.CURSOR_DEFAULT {
        return 10
    }
    return 42
}
