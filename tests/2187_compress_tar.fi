// expect_exit: 0
// tests/2187_compress_tar.fi -- std.tar / std.extract with the formats of
// lib/compress: a small tar (directories, an executable, a symlink, text, a
// binary file) packed as .tar, .tar.gz, .tar.zst, .tar.xz, .tar.bz2 and
// .tar.lz4 (made by python/zstd/xz); every one opens, lists, reads and EXTRACTS
// to the same tree (the format found by content, the executable keeps 0755, the
// link is made); the size limit holds for every format (a bomb is TooLarge, not
// inflated first and looked at afterwards); damaged compressed streams are
// refused with the archive error that fits.
import compress.common
import compress.auto
import std.tar
import std.extract
import std.safefs
import std.fs
import std.dir
import std.rt
import std.io
import std.vec

const PLAIN: str = __include_str("data/compress/plain.bin")
const RANDOM: str = __include_str("data/compress/random.bin")
const T_RAW: str = __include_str("data/compress/pack.tar")
const T_GZ: str = __include_str("data/compress/pack.tar.gz")
const T_ZST: str = __include_str("data/compress/pack.tar.zst")
const T_XZ: str = __include_str("data/compress/pack.tar.xz")
const T_BZ2: str = __include_str("data/compress/pack.tar.bz2")
const T_LZ4: str = __include_str("data/compress/pack.tar.lz4")

struct Tally {
    total: i64,
    fails: i64,
}

fn check(t: *mut Tally, what: str, ok: bool) {
    (*t).total = (*t).total + 1
    if !ok {
        (*t).fails = (*t).fails + 1
        io.print("FAIL ")
        io.print_line(what)
    }
}

static mut code: u32 = 0

fn why(e: CompressError) -> usize {
    if e == CompressError::Data { code = 1 }
    if e == CompressError::Format { code = 2 }
    if e == CompressError::Checksum { code = 3 }
    if e == CompressError::Truncated { code = 4 }
    if e == CompressError::TooLarge { code = 5 }
    if e == CompressError::OutOfMemory { code = 6 }
    if e == CompressError::Unsupported { code = 7 }
    if e == CompressError::Dictionary { code = 8 }
    if e == CompressError::Io { code = 9 }
    return 0
}

fn is_plain(b: *mut rt.Buf, want: str) -> bool {
    return rt.buf_len(b) == want.length() && rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.length())
}

fn view(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: rt.buf_len(b) }
}

fn scratch(tag: str) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, "/tmp/firn_".p as u64, 10)
    rt.buf_push_bytes(&b, tag.p as u64, tag.length())
    rt.buf_push(&b, 95 as u8)
    rt.buf_push_dec_i64(&b, syscall(39, 0, 0, 0, 0, 0, 0))
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

// deterministic pseudo random octets
fn pseudo(n: usize, seed: u64) -> rt.Buf {
    var b: rt.Buf = rt.buf_new()
    var x: u64 = seed
    var i: usize = 0
    while i < n {
        x = x *% 6364136223846793005 +% 1442695040888963407
        rt.buf_push(&b, ((x >> 33) & 255) as u8)
        i = i + 1
    }
    return b
}

fn zeros(n: usize) -> rt.Buf {
    var z: rt.Buf = rt.buf_new()
    rt.buf_reserve(&z, n)
    rt.mem_set(rt.buf_ptr(&z), 0 as u8, n)
    rt.buf_set_len(&z, n)
    return z
}

fn finish(t: *mut Tally) -> i32 {
    io.print("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&nb, (*t).total)
    io.print_bytes(rt.buf_ptr(&nb), rt.buf_len(&nb))
    io.print_line("")
    if (*t).fails != 0 {
        return 1 as i32
    }
    return 0
}

fn err_code(e: ArchiveError) -> u32 {
    if e == ArchiveError::NotArchive { return 1 as u32 }
    if e == ArchiveError::Corrupt { return 2 as u32 }
    if e == ArchiveError::Truncated { return 3 as u32 }
    if e == ArchiveError::Unsupported { return 4 as u32 }
    if e == ArchiveError::Checksum { return 5 as u32 }
    if e == ArchiveError::TooLarge { return 6 as u32 }
    if e == ArchiveError::OutOfMemory { return 7 as u32 }
    return 99 as u32
}

fn bad_reader(e: ArchiveError, c: *mut u32) -> tar.TarReader {
    *c = err_code(e)
    return tar.TarReader { data: 0, n: 0, names: rt.buf_new(), entries: vec_new[tar.TarEntry]() }
}

fn bad_stats(e: ArchiveError, c: *mut u32) -> safefs.ExtractStats {
    *c = err_code(e)
    return safefs.ExtractStats { files: 0, dirs: 0, links: 0, bytes: 0 }
}

static mut acode: u32 = 0

// opens `z` as a (compressed) tar; checks the listing and two files
fn lists_ok(z: str, lim: tar.TarLimits) -> bool {
    acode = 0
    var sc: rt.Buf = rt.buf_new()
    var r: tar.TarReader = tar.tar_open_auto(z.p as u64, z.length(), lim, &sc) catch | e | (bad_reader(e, &acode))
    var ok: bool = acode == 0 as u32 && tar.tar_entry_count(&r) == 7
    if ok {
        let i: i64 = tar.tar_find(&r, "pkg/readme.txt")
        let j: i64 = tar.tar_find(&r, "pkg/data/blob.bin")
        let k: i64 = tar.tar_find(&r, "pkg/bin/run")
        ok = i >= 0 && j >= 0 && k >= 0 && tar.tar_entry_size(&r, i as usize) == 3000
        && tar.tar_entry_size(&r, j as usize) == (RANDOM.length() as u64)
        && tar.tar_entry_mode(&r, k as usize) == 493 as u32
        if ok {
            ok = rt.mem_eq(tar.tar_entry_data(&r, i as usize), PLAIN.p as u64, 3000)
            && rt.mem_eq(tar.tar_entry_data(&r, j as usize), RANDOM.p as u64, RANDOM.length())
        }
    }
    tar.tar_reader_free(&r)
    rt.buf_free(&sc)
    return ok
}

fn tree_ok(root: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    var ok: bool = true
    let n1: usize = fs.read_file(join(root, "pkg/readme.txt"), &b) catch 0
    ok = n1 == 3000 && rt.mem_eq(rt.buf_ptr(&b), PLAIN.p as u64, 3000)
    rt.buf_clear(&b)
    let n2: usize = fs.read_file(join(root, "pkg/data/blob.bin"), &b) catch 0
    ok = ok && n2 == RANDOM.length() && rt.mem_eq(rt.buf_ptr(&b), RANDOM.p as u64, n2)
    rt.buf_clear(&b)
    let n3: usize = fs.read_file(join(root, "pkg/bin/run"), &b) catch 0
    ok = ok && n3 == 38
    rt.buf_free(&b)
    let info: fs.FileInfo = fs.stat(join(root, "pkg/bin/run")) catch fs.FileInfo { kind: 0 as u8, mode: 0, size: 0, mtime_ns: 0 }
    ok = ok && (info.mode & 511) == 493
    let tgt: str = fs.readlink(join(root, "pkg/bin/run-link")) catch ""
    ok = ok && tgt == "run"
    return ok
}

fn join(a: str, b: str) -> str {
    var x: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&x, a.p as u64, a.length())
    rt.buf_push(&x, 47 as u8)
    rt.buf_push_bytes(&x, b.p as u64, b.length())
    let s: str = __str_copy(str { p: rt.buf_data(&x), n: rt.buf_len(&x) })
    rt.buf_free(&x)
    return s
}

// extracts `z` into a fresh directory below `base`; true when the tree is right
fn extracts_ok(base: str, tag: str, z: str, expect_fmt: u32) -> bool {
    let dest: str = join(base, tag)
    acode = 0
    let fmt: u32 = extract.detect_format(z.p as u64, z.length(), "")
    let st: safefs.ExtractStats = extract.extract_memory(z.p as u64, z.length(), "", dest, safefs.extract_options_default(),
        tar.tar_limits_default()) catch | e | (bad_stats(e, &acode))
    var ok: bool = fmt == expect_fmt && acode == 0 as u32 && st.files == 3 && st.dirs == 3 && st.links == 1
    if ok {
        ok = tree_ok(dest)
    }
    return ok
}

fn main() -> i32 {
    var t: Tally = Tally { total: 0, fails: 0 }
    let base: str = scratch("tar2187")
    fs.mkdir(base) catch false

    // A. listing and reading, every format
    let lim: tar.TarLimits = tar.tar_limits_default()
    check(&t, "list .tar", lists_ok(T_RAW, lim))
    check(&t, "list .tar.gz", lists_ok(T_GZ, lim))
    check(&t, "list .tar.zst", lists_ok(T_ZST, lim))
    check(&t, "list .tar.xz", lists_ok(T_XZ, lim))
    check(&t, "list .tar.bz2", lists_ok(T_BZ2, lim))
    check(&t, "list .tar.lz4", lists_ok(T_LZ4, lim))
    // B. extraction, every format, to the same tree
    check(&t, "extract .tar", extracts_ok(base, "raw", T_RAW, extract.FORMAT_TAR))
    check(&t, "extract .tar.gz", extracts_ok(base, "gz", T_GZ, extract.FORMAT_TARGZ))
    check(&t, "extract .tar.zst", extracts_ok(base, "zst", T_ZST, extract.FORMAT_TARZ))
    check(&t, "extract .tar.xz", extracts_ok(base, "xz", T_XZ, extract.FORMAT_TARZ))
    check(&t, "extract .tar.bz2", extracts_ok(base, "bz2", T_BZ2, extract.FORMAT_TARZ))
    check(&t, "extract .tar.lz4", extracts_ok(base, "lz4", T_LZ4, extract.FORMAT_TARZ))
    // C. the limit
    var small: tar.TarLimits = tar.tar_limits_default()
    small.max_archive_size = T_RAW.length() - 1
    var pack: [str; 4] = [T_ZST, T_XZ, T_BZ2, T_LZ4]
    var i: usize = 0
    var bad: usize = 0
    while i < 4 {
        lists_ok(pack[i], small)
        if acode != 6 as u32 {
            bad = bad + 1
        }
        i = i + 1
    }
    check(&t, "max_archive_size: a compressed tar that inflates past it is TooLarge", bad == 0)
    var exact: tar.TarLimits = tar.tar_limits_default()
    exact.max_archive_size = T_RAW.length()
    check(&t, "...and passes at exactly the size", lists_ok(T_ZST, exact) && lists_ok(T_XZ, exact))
    // a bomb: a tar of zeros, 3 MiB, packed
    var zero: rt.Buf = zeros(3145728)
    var zb: rt.Buf = rt.buf_new()
    auto.compress(auto.KIND_ZSTD, rt.buf_ptr(&zero), 3145728, 3, &zb) catch 0
    check(&t, "the zeros bomb is tiny", rt.buf_len(&zb) < 2000)
    var bl: tar.TarLimits = tar.tar_limits_default()
    bl.max_archive_size = 1048576
    var bsc: rt.Buf = rt.buf_new()
    acode = 0
    tar.tar_open_auto(rt.buf_ptr(&zb), rt.buf_len(&zb), bl, &bsc) catch | e | (bad_reader(e, &acode))
    check(&t, "a zstd bomb stops at the limit (TooLarge) without inflating past it", acode == 6 as u32 && rt.buf_len(&bsc) <= 1048576)
    rt.buf_free(&bsc)
    rt.buf_free(&zb)
    rt.buf_free(&zero)
    // D. damaged compressed archives
    var dmg: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&dmg, T_ZST.p as u64, T_ZST.length())
    rt.st8(rt.buf_ptr(&dmg), T_ZST.length() - 1, rt.ld8(rt.buf_ptr(&dmg), T_ZST.length() - 1) ^ 1 as u8)
    lists_ok(view(&dmg), lim)
    check(&t, "a flipped zstd checksum is Checksum", acode == 5 as u32)
    rt.buf_clear(&dmg)
    rt.buf_push_bytes(&dmg, T_XZ.p as u64, T_XZ.length() - 20)
    lists_ok(view(&dmg), lim)
    check(&t, "a cut .tar.xz is Truncated", acode == 3 as u32)
    rt.buf_clear(&dmg)
    rt.buf_push_bytes(&dmg, T_BZ2.p as u64, T_BZ2.length())
    rt.st8(rt.buf_ptr(&dmg), 12, rt.ld8(rt.buf_ptr(&dmg), 12) ^ 0x10 as u8)
    lists_ok(view(&dmg), lim)
    check(&t, "a damaged .tar.bz2 is refused", acode == 5 as u32 || acode == 2 as u32)
    rt.buf_free(&dmg)
    // a compressed stream that is no tar
    var notar: rt.Buf = rt.buf_new()
    auto.compress(auto.KIND_ZSTD, PLAIN.p as u64, PLAIN.length(), 3, &notar) catch 0
    lists_ok(view(&notar), lim)
    check(&t, "a zstd file that does not hold a tar is refused", acode != 0 as u32)
    rt.buf_free(&notar)

    fs.remove_tree(base) catch false
    return finish(&t)
}
