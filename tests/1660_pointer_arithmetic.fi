// expect_exit: 42
// Round GAPS: arithmetic on typed pointers -- `p + n` / `p - n` move n
// ELEMENTS, `p - q` is the distance in elements, `p += n`, `p++` (docs/LUECKEN.md B13; was
// written by hand as `((p as usize) + 8) as *mut i32`).
struct Pair {
    a: i64,
    b: i32,
}

fn sum(p: *mut i32, n: usize) -> i32 {
    var s: i32 = 0
    var q: *mut i32 = p
    let end: *mut i32 = p + n
    while q != end {
        s = s + *q
        q++
    }
    return s
}

fn main() -> i32 {
    var a: [i32; 5] = [1 as i32, 2 as i32, 3 as i32, 4 as i32, 5 as i32]
    let p: *mut i32 = &a[0]
    if *(p + 3) != 4 { return 1 as i32 }
    let e: *mut i32 = p + 4 as usize
    if *e != 5 { return 2 as i32 }
    if *(e - 2) != 3 { return 3 as i32 }
    // signed offsets go both ways
    let back: i64 = -3
    if *(e + back) != 2 { return 4 as i32 }
    let k: i32 = 1
    if *(p + k) != 2 { return 5 as i32 }
    // distance in elements, not octets
    if e - p != 4 { return 6 as i32 }
    if p - e != -4 { return 7 as i32 }
    // the element size is the struct's (16 octets here)
    var ps: [Pair; 3] = [Pair { a: 1, b: 2 }, Pair { a: 3, b: 4 }, Pair { a: 30, b: 12 }]
    let pp: *mut Pair = &ps[0]
    let third: *mut Pair = pp + 2
    if ((third as usize) - (pp as usize)) != 2 * 16 { return 8 as i32 }
    if third - pp != 2 { return 9 as i32 }
    // compound forms
    var w: *mut i32 = p
    w += 3
    w -= 1
    w++
    w--
    if *w != 3 { return 12 as i32 }
    // writing through it
    *(p + 1) = 20 as i32
    if a[1] != 20 { return 10 as i32 }
    if sum(p, 5) != 1 + 20 + 3 + 4 + 5 { return 11 as i32 }
    return ((*third).a + (*third).b as i64) as i32
}
