// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
// tests/2893_tar_times_dirmodes.fi -- tar_extract_all with keep_times and
// exact_dir_modes (r207): file and directory mtimes come out as in the
// archive (the directory's after its content was written), a 0555
// directory does not stop the files inside it, and without the options
// nothing changes (mtime = now, directory mode | 0700).
import std.rt
import std.fs
import std.tar
import std.safefs

static mut fails: u32 = 0

fn check(ok: bool, code: u32) {
    if !ok {
        fails = fails + 1
        var d: [u8; 8] = "FAIL 000"
        d[5] = (48 + (code / 100) % 10) as u8
        d[6] = (48 + (code / 10) % 10) as u8
        d[7] = (48 + code % 10) as u8
        syscall(1, 2, (&d[0]) as i64, 8, 0, 0, 0)
    }
}

fn mtime_of(path: str) -> i64 {
    let st: fs.FileInfo = fs.stat(path) catch fs.FileInfo { kind: 0 as u8, mode: 0 as u32, size: 0, mtime_ns: 0 }
    return st.mtime_ns / 1000000000
}

fn mode_of(path: str) -> u32 {
    let st: fs.FileInfo = fs.stat(path) catch fs.FileInfo { kind: 0 as u8, mode: 0 as u32, size: 0, mtime_ns: 0 }
    return st.mode & 511 as u32
}

fn body() -> ArchiveError!bool {
    var out: rt.Buf = rt.buf_new()
    var w: tar.TarWriter = tar.tar_writer_new(&out)
    tar.tar_add_dir(&w, "top", 493 as u32, 1500000000) catch false
    tar.tar_add_dir(&w, "top/ro", 365 as u32, 1500000100) catch false // 0555
    tar.tar_add_file(&w, "top/ro/a.txt", "hello".p as u64, 5, 420 as u32, 1500000200) catch false
    tar.tar_add_file(&w, "top/b.txt", "world".p as u64, 5, 493 as u32, 1500000300) catch false
    tar.tar_finish(&w) catch 0
    var r: tar.TarReader = try tar.tar_reader_open(rt.buf_ptr(&out), out.len)

    let base: str = fs.temp_name_for("tartimes")
    var o1: safefs.ExtractOptions = safefs.extract_options_default()
    o1.keep_times = true
    o1.exact_dir_modes = true
    let s1: safefs.ExtractStats = tar.tar_extract_all(&r, base + "/x", o1) catch safefs.ExtractStats { files: 0, dirs: 0, links: 0, bytes: 0 }
    check(s1.files == 2 && s1.dirs == 2, 1)
    check(mtime_of(base + "/x/top/b.txt") == 1500000300, 2)
    check(mtime_of(base + "/x/top/ro/a.txt") == 1500000200, 3)
    check(mtime_of(base + "/x/top/ro") == 1500000100, 4)
    check(mtime_of(base + "/x/top") == 1500000000, 5)
    check(mode_of(base + "/x/top/ro") == 365 as u32, 6)
    check(mode_of(base + "/x/top") == 493 as u32, 7)

    let o2: safefs.ExtractOptions = safefs.extract_options_default()
    let s2: safefs.ExtractStats = tar.tar_extract_all(&r, base + "/y", o2) catch safefs.ExtractStats { files: 0, dirs: 0, links: 0, bytes: 0 }
    check(s2.files == 2, 10)
    check(mtime_of(base + "/y/top/b.txt") != 1500000300, 11)
    check(mode_of(base + "/y/top/ro") == 493 as u32, 12) // 0555 | 0700

    fs.chmod(base + "/x/top/ro", 493 as u32) catch false
    fs.remove_tree(base) catch false
    tar.tar_reader_free(&r)
    rt.buf_free(&out)
    return true
}

fn main() -> i32 {
    let ok: bool = body() catch false
    if ok && fails == 0 {
        return 0
    }
    return 1
}
