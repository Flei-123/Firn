// expect_out: ok
// Folding an address computation belongs to ONE instruction, not to a value.
//
// After phi elimination and coalescing, `q` below is one value with two
// writers: `q = base + idx * 4` in front of the loop and `q = q + 4` inside
// it. The scaled sum of the first writer (round TEMPO 3, one `lea` with
// `*4`) was looked up by the VALUE and emitted for the second writer too:
// `q = q + 4` became `lea q, [k + q*4]` and the loop wrote through a wild
// pointer. Found in fUi's `canvas_fill_rect` (x11demo at Xft.dpi 192,
// release-fast) after TEMPO 1-13 were merged onto main. This is the shape of
// that loop, cut down.
import std.io

fn st8(p: u64, v: u8) {
    let q: *mut u8 = p as *mut u8
    *q = v
}

fn ld8(p: u64) -> u8 {
    let q: *u8 = p as *u8
    return *q
}

fn fill_row(px: u64, w: usize, y: usize, x0: usize, x1: usize, r: u8, g: u8, b: u8) {
    var q: u64 = px + ((y * w + x0) * 4) as u64
    var k: usize = x0
    while k < x1 {
        st8(q, r)
        st8(q + 1, g)
        st8(q + 2, b)
        st8(q + 3, 255 as u8)
        q = q + 4
        k = k + 1
    }
}

fn main(start: u64) -> i32 {
    var buf: [u8; 1024] = [0; 1024]
    let px: u64 = (&buf[0]) as u64
    var w: usize = 16
    var y: usize = 3
    var x0: usize = 5
    var x1: usize = 12
    if start == 7777777 {
        w = 8
        y = 1
    }
    fill_row(px, w, y, x0, x1, 10 as u8, 20 as u8, 30 as u8)
    fill_row(px, w, y + 2, 0, 16, 1 as u8, 2 as u8, 3 as u8)
    var sum: u64 = 0
    var i: usize = 0
    while i < 1024 {
        sum = sum * 31 + (ld8(px + i as u64) as u64)
        i = i + 1
    }
    // written: row 3 pixels 5..12 and row 5 pixels 0..16, nothing else
    var ok: bool = true
    if ld8(px + ((3 * 16 + 5) * 4) as u64) != 10 as u8 { ok = false }
    if ld8(px + ((3 * 16 + 11) * 4 + 3) as u64) != 255 as u8 { ok = false }
    if ld8(px + ((3 * 16 + 12) * 4) as u64) != 0 as u8 { ok = false }
    if ld8(px + ((5 * 16 + 15) * 4 + 2) as u64) != 3 as u8 { ok = false }
    var n: u64 = 0
    i = 0
    while i < 1024 {
        if ld8(px + i as u64) != 0 as u8 {
            n = n + 1
        }
        i = i + 1
    }
    if n != (7 + 16) * 4 { ok = false }
    if ok {
        io.print_line("ok")
    } else {
        io.print_line("WRONG")
    }
    return 0
}
