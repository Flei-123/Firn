// expect_exit: 0
// tests/3921_for_enumerate_zip.fi -- `for (i, x) in enumerate(v)` and `for (x, y) in zip(a, b)` (r666).
import std.io
import std.rt
import std.vec
import std.testkit

struct P {
    a: i32,
    b: i32,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i64] = vec_new[i64]()
    vec_push[i64](&v, 10)
    vec_push[i64](&v, 20)
    vec_push[i64](&v, 30)
    // enumerate over a Vec: index is usize, element a copy
    var idx_sum: usize = 0
    var val_sum: i64 = 0
    for (i, x) in enumerate(v) {
        idx_sum += i
        val_sum += x * (i as i64 + 1)
    }
    testkit.check(idx_sum == 3, "enumerate index sum")
    testkit.check(val_sum == 10 + 40 + 90, "enumerate value sum")
    // enumerate over an array and a str (bytes)
    let arr: [i32; 4] = [5, 6, 7, 8]
    var last: usize = 0
    for (i, a) in enumerate(arr) {
        if a == 7 { last = i }
    }
    testkit.check(last == 2, "enumerate array")
    let s: str = "abc"
    var code: u64 = 0
    for (i, c) in enumerate(s) {
        code = code * 256 + c as u64 + i as u64
    }
    testkit.check(code == (97 * 256 + 99) * 256 + 101, "enumerate str bytes")
    // zip walks to the shorter length
    var w: Vec[i64] = vec_new[i64]()
    vec_push[i64](&w, 1)
    vec_push[i64](&w, 2)
    var dot: i64 = 0
    var n: i32 = 0
    for (a, b) in zip(v, w) {
        dot += a * b
        n += 1
    }
    testkit.check(dot == 10 + 40 && n == 2, "zip shorter second")
    n = 0
    for (a, b) in zip(w, v) {
        n += 1
    }
    testkit.check(n == 2, "zip shorter first")
    // zip an array with a Vec, break / continue / nested
    var seen: i32 = 0
    for (a, b) in zip(arr, v) {
        if seen == 1 { continue }
        seen += 1
        testkit.check(a == 5 && b == 10, "zip first pair")
    }
    var cnt: i32 = 0
    for (i, x) in enumerate(v) {
        for (j, y) in enumerate(w) {
            if j > i { break }
            cnt += 1
        }
    }
    testkit.check(cnt == 1 + 2 + 2, "nested enumerate with break")
    // field path as the sequence
    var ps: [P; 2] = [P { a: 1, b: 2 }, P { a: 3, b: 4 }]
    var tot: i32 = 0
    for (i, p) in enumerate(ps) {
        tot += p.a * 10 + p.b + i as i32
    }
    testkit.check(tot == 12 + 34 + 1, "enumerate array of structs")
    vec_free[i64](&v)
    vec_free[i64](&w)
    return testkit.finish()
}
