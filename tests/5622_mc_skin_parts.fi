// expect_exit: 0
import mc.mc_skin
import mc.mc_vox
import mc.mc_player_parts
import mc.mc_player_model
import mc.mc_held_item
import mc.mc_xf

fn main() -> i32 {
    var s: mc_skin.Skin = mc_skin.skin_new()
    mc_skin.skin_default_for(&s, 0 as u64, 0 as u64)
    if !mc_skin.skin_ok(&s) || mc_skin.skin_is_slim(&s) { return 1 }
    var s2: mc_skin.Skin = mc_skin.skin_new()
    mc_skin.skin_default_for(&s2, 0 as u64, 1 as u64)
    if !mc_skin.skin_is_slim(&s2) { return 2 }
    var pc: mc_player_parts.PlayerCubes = mc_player_parts.pc_new()
    mc_player_parts.pc_build(&pc, &s)
    if !mc_player_parts.pc_built(&pc) { return 3 }
    if mc_vox.cl_len(&pc.parts[mc_player_parts.PART_HEAD]) != 296 { return 4 }
    if mc_vox.cl_len(&pc.parts[mc_player_parts.PART_BODY]) != 264 { return 5 }
    if mc_vox.cl_len(&pc.parts[mc_player_parts.PART_RARM]) != 152 { return 6 }
    mc_player_parts.pc_build(&pc, &s2)
    if mc_vox.cl_len(&pc.parts[mc_player_parts.PART_RARM]) != 3 * 12 * 4 - 1 * 10 * 2 { return 7 }
    var pd: mc_player_parts.PartDef = mc_player_parts.part_def(mc_player_parts.PART_RARM, true)
    if pd.w != 3 { return 8 }
    var h: mc_held_item.Held = mc_held_item.held_new()
    if mc_held_item.held_kind(&h) != mc_held_item.HELD_NONE { return 9 }
    mc_held_item.held_free(&h)
    mc_player_parts.pc_free(&pc)
    mc_skin.skin_free(&s)
    mc_skin.skin_free(&s2)
    return 0
}
