// expect_exit: 0
// ROUND OWN-1: the move checker accepts correct ownership. A value with a
// `drop` has exactly one owner; handing it over moves it, `&` / `inout` only
// lend it, and a moved name gets a new value by assignment.
struct Guard { id: i64 }

impl Guard {
    fn drop(inout self) {
        self.id = 0
    }
}

struct Pair { a: Guard, b: Guard }

fn eat(g: Guard) -> i64 { return g.id }
fn pass(g: Guard) -> Guard { return g }
fn peek(g: &Guard) -> i64 { return g.id }
fn bump(g: inout Guard) { g.id += 1 }

fn pick(c: bool, g: Guard) -> i64 {
    if c {
        return eat(g)
    }
    // the then-branch left through `return`, so `g` is still ours here
    return eat(g) + 100
}

fn main() -> i32 {
    let a: Guard = Guard { id: 1 }
    if peek(&a) != 1 { return 1 }
    var b: Guard = pass(a)
    bump(inout b)
    let c: Guard = b
    b = Guard { id: 7 }
    if eat(c) != 2 { return 2 }
    let p: Pair = Pair { a: b, b: Guard { id: 3 } }
    if p.a.id != 7 { return 3 }
    let d: Guard = Guard { id: 9 }
    var r: i64 = 0
    if p.b.id == 3 {
        r = eat(d)
    } else {
        r = eat(d) + 1
    }
    if r != 9 { return 4 }
    if pick(true, Guard { id: 5 }) != 5 { return 5 }
    if pick(false, Guard { id: 5 }) != 105 { return 6 }
    return 0
}
