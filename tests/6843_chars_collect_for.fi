// expect_exit: 0
import std.chars

fn main() -> i32 {
    let text: str = "héllo €"
    let cs: Vec[u32] = chars.collect(text)
    var n: usize = 0
    var sum: u32 = 0
    for c in cs {
        n += 1
        sum += c
    }
    if n != 7 { return 1 }
    if n != chars.count(text) { return 2 }
    if sum != 104 + 233 + 108 + 108 + 111 + 32 + 8364 { return 3 }
    let empty: Vec[u32] = chars.collect("")
    var none: i32 = 0
    for c in empty {
        none += 1
    }
    if none != 0 { return 4 }
    return 0
}
