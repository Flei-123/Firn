// expect_exit: 0
import media.video.av1.av1fg
import media.video.av1.av1mem
import media.video.av1.av1frame
import media.video.av1.av1fgapp
import media.video.av1.av1fgsyn
import media.video.av1.av1tabfg
import media.video.av1.av1ipm

fn make_params(lag: i64, seed: i64, cfl: i64, overlap: i64, restricted: i64) -> *mut av1fg.FilmGrain {
    let g: *mut av1fg.FilmGrain = av1mem.av1_zalloc[av1fg.FilmGrain]()
    (*g).apply_grain = 1
    (*g).grain_seed = seed
    (*g).num_y_points = 3
    (*g).point_y_value[0] = 0
    (*g).point_y_scaling[0] = 20
    (*g).point_y_value[1] = 100
    (*g).point_y_scaling[1] = 90
    (*g).point_y_value[2] = 255
    (*g).point_y_scaling[2] = 40
    (*g).chroma_scaling_from_luma = cfl
    if cfl == 0 {
        (*g).num_cb_points = 2
        (*g).point_cb_value[0] = 16
        (*g).point_cb_scaling[0] = 60
        (*g).point_cb_value[1] = 200
        (*g).point_cb_scaling[1] = 30
        (*g).num_cr_points = 1
        (*g).point_cr_value[0] = 128
        (*g).point_cr_scaling[0] = 70
        (*g).cb_mult = 128
        (*g).cb_luma_mult = 192
        (*g).cb_offset = 256
        (*g).cr_mult = 140
        (*g).cr_luma_mult = 100
        (*g).cr_offset = 280
    }
    (*g).grain_scaling_minus_8 = 2
    (*g).ar_coeff_lag = lag
    var i: usize = 0
    while i < 24 {
        (*g).ar_coeffs_y_plus_128[i] = 128 + ((i as i64 * 7) % 11) - 5
        i = i + 1
    }
    i = 0
    while i < 25 {
        (*g).ar_coeffs_cb_plus_128[i] = 128 + ((i as i64 * 5) % 9) - 4
        (*g).ar_coeffs_cr_plus_128[i] = 128 + ((i as i64 * 3) % 7) - 3
        i = i + 1
    }
    (*g).ar_coeff_shift_minus_6 = 1
    (*g).grain_scale_shift = 0
    (*g).overlap_flag = overlap
    (*g).clip_to_restricted_range = restricted
    return g
}

fn make_frame(w: i64, h: i64, ssx: i64, ssy: i64, planes: i64, bd: i64) -> *mut av1frame.Frame {
    let f: *mut av1frame.Frame = av1frame.frame_new(w, h, (w + 3) / 4, (h + 3) / 4, ssx, ssy, planes, bd)
    var p: usize = 0
    while (p as i64) < planes {
        var y: i64 = 0
        while y < 80 {
            var x: i64 = 0
            while x < 80 {
                av1ipm.st((*f).planes[p], y * (*f).strides[p] + x, (((x * 3 + y * 5 + p as i64 * 40) & 255) << ((bd - 8) as u64)))
                x = x + 1
            }
            y = y + 1
        }
        p = p + 1
    }
    return f
}

fn checksum(f: *mut av1frame.Frame) -> i64 {
    var h: i64 = 17
    var p: usize = 0
    while (p as i64) < (*f).num_planes {
        var y: i64 = 0
        while y < (*f).height {
            var x: i64 = 0
            while x < (*f).width {
                h = (h * 31 + av1ipm.ld((*f).planes[p], y * (*f).strides[p] + x)) & 2147483647
                x = x + 1
            }
            y = y + 1
        }
        p = p + 1
    }
    return h
}

fn expect(name: i64, got: i64, want: i64) -> bool {
    if got != want {
        return false
    }
    return true
}

fn main() -> i32 {
    var ok: bool = true
    ok = ok && expect(1, av1tabfg.GAUSSIAN_SEQUENCE[0] as i64, 56)
    ok = ok && expect(2, av1tabfg.GAUSSIAN_SEQUENCE[2047] as i64, 0 - 484)
    let t: *mut av1fgsyn.GrainTpl = av1fgsyn.grain_tpl_new()
    (*t).rng = 1
    ok = ok && expect(3, av1fgsyn.grain_rand(t, 8), 128)
    ok = ok && expect(4, av1fgsyn.grain_rand(t, 8), 64)
    av1fgsyn.grain_tpl_free(t)
    let g0: *mut av1fg.FilmGrain = make_params(0, 1234, 0, 1, 0)
    (*g0).num_y_points = 0
    (*g0).num_cb_points = 0
    (*g0).num_cr_points = 0
    let a: *mut av1frame.Frame = make_frame(70, 50, 1, 1, 3, 8)
    let before: i64 = checksum(a)
    av1fgapp.fg_apply_frame(a, g0, 1)
    ok = ok && expect(5, checksum(a), before)
    let g1: *mut av1fg.FilmGrain = make_params(3, 4321, 0, 1, 1)
    let b: *mut av1frame.Frame = make_frame(70, 50, 1, 1, 3, 8)
    av1fgapp.fg_apply_frame(b, g1, 1)
    ok = ok && expect(6, checksum(b), 1998877115)
    let g2: *mut av1fg.FilmGrain = make_params(2, 777, 1, 0, 0)
    let c: *mut av1frame.Frame = make_frame(67, 41, 0, 0, 3, 10)
    av1fgapp.fg_apply_frame(c, g2, 0)
    ok = ok && expect(7, checksum(c), 1971339147)
    let d: *mut av1frame.Frame = make_frame(33, 45, 1, 0, 1, 12)
    let g3: *mut av1fg.FilmGrain = make_params(1, 99, 0, 1, 0)
    av1fgapp.fg_apply_frame(d, g3, 1)
    ok = ok && expect(8, checksum(d), 1341210292)
    if ok {
        return 0
    }
    return 1
}
