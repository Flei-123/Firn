fn main() -> i32 {
    sc_jump_stand()
    sc_walk_start_stop()
    sc_sprint_run_stop()
    sc_sprint_jump()
    sc_sprint_hop_hold()
    sc_sneak_walk()
    sc_air_control()
    sc_strafe_diag()
    sc_ice_walk()
    sc_sneak_diag_back()
    var o: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&o, "fails ".p as u64, 6)
    rt.buf_push_hex_u64(&o, g_fail as u64, 2)
    rt.buf_push(&o, 10)
    rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
    rt.buf_free(&o)
    return g_fail
}
