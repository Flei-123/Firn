// expect_exit: 43
// only_mode: opt
// r900 (differential test): a shift count is taken modulo 32 for every type up to 32 bits
// (modulo 64 for 64-bit types), the way the hardware does it. firnc1 used to shift in 64 bits
// and returned 0 for `3 << 32` where firnc0 returned 3.
fn main() -> i32 {
    var cnt: [u32; 3] = [32, 33, 35]
    var v: [u32; 1] = [3]
    let a: u32 = v[0] << cnt[0]
    let b: u32 = v[0] << cnt[1]
    let c: u32 = 0x80000000 >> cnt[2]
    var w: [i32; 1] = [0 - 64]
    let d: i32 = w[0] >> cnt[1]
    var q: [u64; 1] = [5]
    var k: [u64; 1] = [64]
    let e: u64 = q[0] << k[0]
    return (a + b + c) as i32 + d + e as i32 + 61
}
