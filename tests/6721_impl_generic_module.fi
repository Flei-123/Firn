// expect_exit: 0
import modules.gbox

fn main() -> i32 {
    var h: gbox.Holder[gbox.Cell] = gbox.make(4)
    if h.peek().v != 4 { return 1 }
    h.put(gbox.Cell { v: 9 })
    if h.peek().v != 9 { return 2 }
    if h.hit_count() != 1 { return 3 }
    var n: gbox.Holder[i32] = gbox.Holder[i32] { item: 3, hits: 0 }
    n.put(5)
    if n.peek() != 5 { return 4 }
    return 0
}
