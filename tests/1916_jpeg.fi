// expect_exit: 42
// tests/1916_jpeg.fi -- lib/jpeg (OpenPlan LIB-010): every picture in
// tests/data/jpeg decodes to exactly the pixels Pillow (libjpeg-turbo)
// gives -- compared by the CRC-32 of the RGBA octets -- plus the refusals.
// More pictures and pixel-by-pixel comparison: tools/libmvp/check_jpeg.py.
import jpeg.jpeg
import std.fs
import std.rt
import std.deflate

fn crc_of(path: str, w: u32, h: u32) -> u32 {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    if n == 0 {
        return 1 as u32
    }
    var im: jpeg.JpegImage = jpeg.jpeg_image_new()
    let ok: bool = jpeg.jpeg_decode(rt.buf_ptr(&data), n, &im) catch false
    if !ok || im.w != w || im.h != h {
        return 2 as u32
    }
    let c: u32 = deflate.crc32(rt.buf_ptr(&im.px), rt.buf_len(&im.px))
    jpeg.jpeg_image_free(&im)
    rt.buf_free(&data)
    return c
}

fn why(e: JpegError) -> bool {
    if e == JpegError::NotJpeg { code = 1 }
    if e == JpegError::Corrupt { code = 2 }
    if e == JpegError::Unsupported { code = 3 }
    if e == JpegError::TooLarge { code = 4 }
    return false
}

static mut code: i32 = 0

fn refusal(p: u64, n: usize, limit: u64) -> i32 {
    code = 0
    var im: jpeg.JpegImage = jpeg.jpeg_image_new()
    jpeg.jpeg_decode_limited(p, n, limit, &im) catch | e | (why(e))
    jpeg.jpeg_image_free(&im)
    return code
}

fn main() -> i32 {
    if crc_of("tests/data/jpeg/base444.jpg", 123 as u32, 77 as u32) != 3066833226 as u32 { return 1 as i32 }
    if crc_of("tests/data/jpeg/base420.jpg", 123 as u32, 77 as u32) != 2716695594 as u32 { return 2 as i32 }
    if crc_of("tests/data/jpeg/prog420.jpg", 123 as u32, 77 as u32) != 2716695594 as u32 { return 3 as i32 }
    if crc_of("tests/data/jpeg/gray.jpg", 123 as u32, 77 as u32) != 1073646419 as u32 { return 4 as i32 }
    if crc_of("tests/data/jpeg/rst.jpg", 123 as u32, 77 as u32) != 1299009908 as u32 { return 5 as i32 }
    if crc_of("tests/data/jpeg/exif6.jpg", 77 as u32, 123 as u32) != 555926571 as u32 { return 6 as i32 }
    if crc_of("tests/data/jpeg/cmyk.jpg", 123 as u32, 77 as u32) != 3600179656 as u32 { return 7 as i32 }
    if crc_of("tests/data/jpeg/q10.jpg", 123 as u32, 77 as u32) != 3438183169 as u32 { return 8 as i32 }

    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file("tests/data/jpeg/base420.jpg", &data) catch 0
    let p: u64 = rt.buf_ptr(&data)
    var w: u32 = 0
    var h: u32 = 0
    if !jpeg.jpeg_info(p, n, &w, &h) || w != 123 || h != 77 { return 10 as i32 }
    // the pixel limit
    if refusal(p, n, 9000) != 4 { return 11 as i32 }
    if refusal(p, n, 9471) != 0 { return 12 as i32 } // exactly 123 x 77
    // not a JPEG
    if refusal(p + 1, n - 1, 1000000) != 1 { return 13 as i32 }
    // cut in the header: corrupt
    if refusal(p, 200, 1000000) != 2 { return 14 as i32 }
    // arithmetic coding (SOF9): patch the frame marker
    var arith: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&arith, p, n)
    var i: usize = 2
    while i + 1 < n {
        if rt.ld8(p, i) == 255 as u8 && rt.ld8(p, i + 1) == 192 as u8 {
            rt.st8(rt.buf_ptr(&arith), i + 1, 201 as u8)
            i = n
        }
        i = i + 1
    }
    if refusal(rt.buf_ptr(&arith), n, 1000000) != 3 { return 15 as i32 }
    // cut in the entropy-coded data: decodes what is there (as libjpeg
    // does -- a camera file cut short still shows its top)
    if refusal(p, n - 1000, 1000000) != 0 { return 16 as i32 }
    // garbage
    var junk: rt.Buf = rt.buf_new()
    rt.buf_push(&junk, 255 as u8)
    rt.buf_push(&junk, 216 as u8)
    i = 0
    while i < 300 {
        rt.buf_push(&junk, (i * 7 % 256) as u8)
        i = i + 1
    }
    if refusal(rt.buf_ptr(&junk), rt.buf_len(&junk), 1000000) != 2 { return 17 as i32 }
    return 42
}
