// expect_exit: 0
// tests/3920_fstring_spec.fi -- f-string format specs {x:>8} {x:.2f} {n:05} {n:x} ... (r665).
// Expected values come from Python's format(); the random comparison is tools/fmtspec_cross/run.sh.
import std.io
import std.rt
import std.testkit

fn main() -> i32 {
    if !gc_init() { return 1 }
    let n_9: i32 = 42
    testkit.check(io.fmt_string(f"{n_9:05}") == "00042", "{n:05}")
    let n_11: i32 = -42
    testkit.check(io.fmt_string(f"{n_11:05}") == "-0042", "{n:05}")
    let n_13: i32 = 42
    testkit.check(io.fmt_string(f"{n_13:>8}") == "      42", "{n:>8}")
    let n_15: i32 = 42
    testkit.check(io.fmt_string(f"{n_15:<8}") == "42      ", "{n:<8}")
    let n_17: i32 = 42
    testkit.check(io.fmt_string(f"{n_17:^8}") == "   42   ", "{n:^8}")
    let n_19: i32 = 255
    testkit.check(io.fmt_string(f"{n_19:x}") == "ff", "{n:x}")
    let n_21: i32 = 255
    testkit.check(io.fmt_string(f"{n_21:X}") == "FF", "{n:X}")
    let n_23: i32 = 255
    testkit.check(io.fmt_string(f"{n_23:#x}") == "0xff", "{n:#x}")
    let n_25: i32 = 255
    testkit.check(io.fmt_string(f"{n_25:08b}") == "11111111", "{n:08b}")
    let n_27: i32 = 8
    testkit.check(io.fmt_string(f"{n_27:o}") == "10", "{n:o}")
    let n_29: i32 = 255
    testkit.check(io.fmt_string(f"{n_29:#06x}") == "0x00ff", "{n:#06x}")
    let n_31: i32 = 7
    testkit.check(io.fmt_string(f"{n_31:+}") == "+7", "{n:+}")
    let n_33: i32 = 7
    testkit.check(io.fmt_string(f"{n_33: }") == " 7", "{n: }")
    let n_35: i32 = -7
    testkit.check(io.fmt_string(f"{n_35:+d}") == "-7", "{n:+d}")
    let n_37: i32 = 42
    testkit.check(io.fmt_string(f"{n_37:*^9}") == "***42****", "{n:*^9}")
    let n_39: i32 = 42
    testkit.check(io.fmt_string(f"{n_39:-<6}") == "42----", "{n:-<6}")
    let n_41: i32 = -255
    testkit.check(io.fmt_string(f"{n_41:x}") == "-ff", "{n:x}")
    let x_43: f64 = 3.14159
    testkit.check(io.fmt_string(f"{x_43:.2f}") == "3.14", "{x:.2f}")
    let x_45: f64 = 3.14159
    testkit.check(io.fmt_string(f"{x_45:8.3f}") == "   3.142", "{x:8.3f}")
    let x_47: f64 = 3.14159
    testkit.check(io.fmt_string(f"{x_47:<8.1f}") == "3.1     ", "{x:<8.1f}")
    let x_49: f64 = -2.5
    testkit.check(io.fmt_string(f"{x_49:08.2f}") == "-0002.50", "{x:08.2f}")
    let x_51: f64 = 2.675
    testkit.check(io.fmt_string(f"{x_51:.2f}") == "2.67", "{x:.2f}")
    let x_53: f64 = 0.125
    testkit.check(io.fmt_string(f"{x_53:.2f}") == "0.12", "{x:.2f}")
    let x_55: f64 = 1234.5
    testkit.check(io.fmt_string(f"{x_55:.0f}") == "1234", "{x:.0f}")
    let x_57: f64 = 2.5
    testkit.check(io.fmt_string(f"{x_57:f}") == "2.500000", "{x:f}")
    let x_59: f64 = 0.256
    testkit.check(io.fmt_string(f"{x_59:.1%}") == "25.6%", "{x:.1%}")
    let x_61: f64 = 1.5
    testkit.check(io.fmt_string(f"{x_61:+.1f}") == "+1.5", "{x:+.1f}")
    let x_63: f64 = 1.5
    testkit.check(io.fmt_string(f"{x_63:>6}") == "   1.5", "{x:>6}")
    let s_65: str = "ab"
    testkit.check(io.fmt_string(f"{s_65:>5}") == "   ab", "{s:>5}")
    let s_67: str = "ab"
    testkit.check(io.fmt_string(f"{s_67:<5}|") == "ab   |", "{s:<5}|")
    let s_69: str = "ab"
    testkit.check(io.fmt_string(f"{s_69:^5}|") == " ab  |", "{s:^5}|")
    let s_71: str = "ab"
    testkit.check(io.fmt_string(f"{s_71:*^6}") == "**ab**", "{s:*^6}")
    let s_73: str = "abcdef"
    testkit.check(io.fmt_string(f"{s_73:.3}") == "abc", "{s:.3}")
    let s_75: str = "abcdef"
    testkit.check(io.fmt_string(f"{s_75:8.3}|") == "abc     |", "{s:8.3}|")
    let s_77: str = "abcdef"
    testkit.check(io.fmt_string(f"{s_77:>8.3}") == "     abc", "{s:>8.3}")
    let s_79: str = "hä"
    testkit.check(io.fmt_string(f"{s_79:>5}") == "   hä", "{s:>5}")
    let s_81: str = "x"
    testkit.check(io.fmt_string(f"{s_81:s}") == "x", "{s:s}")
    let n_83: i64 = 123456789012
    testkit.check(io.fmt_string(f"{n_83:>15}") == "   123456789012", "{n:>15}")
    let n_85: u8 = 200
    testkit.check(io.fmt_string(f"{n_85:04}") == "0200", "{n:04}")
    let b_87: bool = true
    testkit.check(io.fmt_string(f"{b_87:>6}") == "  true", "{b:>6}")
    let n_89: i32 = 5
    testkit.check(io.fmt_string(f"{n_89:f}") == "5.000000", "{n:f}")
    let n_91: i32 = 5
    testkit.check(io.fmt_string(f"{n_91:.2f}") == "5.00", "{n:.2f}")
    return testkit.finish()
}
