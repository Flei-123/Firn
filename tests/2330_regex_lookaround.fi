// expect_exit: 42
// tests/2330_regex_lookaround.fi -- r320: lookaround in lib/regex, still in
// linear time per lookaround evaluation (see the header of lib/regex/regex.fi
// for the worst case and tools/regex_look/ for the measurement).
//
//   A  (?= (?! (?<= (?<! on the shapes real scripts use: OpenPlan's two
//      patterns, password rules, thousands separators, word boundaries
//   B  every row of the table is checked against Python's `re` (the
//      expectations were computed with it; variable-width lookbehinds, which
//      Python refuses, are written there as alternatives of fixed width)
//   C  replacement with zero-width matches, groups outside a lookaround,
//      the Matcher over many finds
//   D  UTF-8: lookbehind steps back by CHARACTERS, also over invalid octets
//   E  refusals: unbounded lookbehind, a capture inside, a quantified
//      lookaround, too deep nesting, too wide a lookbehind, a missing ")"
//   F  nesting: the memo that keeps nested lookarounds polynomial gives the
//      same answers
//   G  the counter-example text: (?=.*z)a on 1,500 "a" takes a quadratic
//      number of steps and finishes; nothing exponential
import regex.regex
import std.rt
import std.str

fn compile(p: str, flags: u32) -> regex.Regex {
    return regex.regex_compile(p, flags) catch | e | (never())
}

fn never() -> regex.Regex {
    syscall(60, 99, 0, 0, 0, 0, 0)
    return never()
}

// the span of the first match as start*1000+end, or -1
fn span(p: str, flags: u32, s: str) -> i64 {
    var r: regex.Regex = compile(p, flags)
    var m: regex.Match = regex.match_new()
    var v: i64 = -1
    if regex.regex_find(&r, s, 0, &m) {
        v = m.start * 1000 + m.end
    }
    regex.regex_free(&r)
    return v
}

fn replaced(p: str, flags: u32, s: str, repl: str) -> str {
    var r: regex.Regex = compile(p, flags)
    let t: str = regex.regex_replace_all(&r, s, repl)
    regex.regex_free(&r)
    return t
}

fn refusal(p: str) -> i32 {
    var why: i32 = 0
    var r: regex.Regex = regex.regex_compile(p, 0 as u32) catch | e | (mark(e, &why))
    regex.regex_free(&r)
    return why
}

fn mark(e: RegexError, why: *mut i32) -> regex.Regex {
    if e == RegexError::Syntax { *why = 1 as i32 }
    if e == RegexError::Unsupported { *why = 2 as i32 }
    if e == RegexError::TooBig { *why = 3 as i32 }
    if e == RegexError::TooManyGroups { *why = 4 as i32 }
    return regex.regex_compile("", 0 as u32) catch | f | (never())
}

fn now_ms() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

fn main() -> i32 {
    // --- A/B: the table (computed with Python's re)
    if span("a(?=b)", 0 as u32, "acab") != 2003 { return 100 as i32 }
    if span("a(?!b)", 0 as u32, "abac") != 2003 { return 101 as i32 }
    if span("(?<=a)b", 0 as u32, "cbab") != 3004 { return 102 as i32 }
    if span("(?<!a)b", 0 as u32, "abcb") != 3004 { return 103 as i32 }
    if span("(?<![A-Za-z])de:", 0 as u32, "code:de: x") != 5008 { return 104 as i32 }
    if span("[A-Z\u{c4}\u{d6}\u{dc}]+(?![a-z\u{e4}\u{f6}\u{fc}\u{df}])", 0 as u32, "ABc DEF") != 1 { return 105 as i32 }
    if span("[A-Z\u{c4}\u{d6}\u{dc}]+(?![a-z\u{e4}\u{f6}\u{fc}\u{df}])", 0 as u32, "\u{c4}\u{d6}\u{fc} \u{dc}B") != 2 { return 106 as i32 }
    if span("^(?=.*\\d)(?=.*[a-z]).{4,}$", 0 as u32, "abc1") != 4 { return 107 as i32 }
    if span("^(?=.*\\d)(?=.*[a-z]).{4,}$", 0 as u32, "abcd") != -1 { return 108 as i32 }
    if span("^(?=.*\\d)(?=.*[a-z]).{4,}$", 0 as u32, "ab1") != -1 { return 109 as i32 }
    if span("(?<=a|bc)x", 0 as u32, "zx bcx") != 5006 { return 110 as i32 }
    if span("(?<=a)(?<=ba)x", 0 as u32, "bax") != 2003 { return 111 as i32 }
    if span("(?<!a|bc)x", 0 as u32, "ax bcx zx") != 8009 { return 112 as i32 }
    if span("(?<=\u{e4})x", 0 as u32, "\u{e4}x") != 2003 { return 113 as i32 }
    if span("(?<=.)x", 0 as u32, "\u{e4}x") != 2003 { return 114 as i32 }
    if span("(?<=^)x", 0 as u32, "x") != 1 { return 115 as i32 }
    if span("(?<=\\bfoo)bar", 0 as u32, "foobar") != 3006 { return 116 as i32 }
    if span("(?<!\\bfoo)bar", 0 as u32, "foobar xbar") != 8011 { return 117 as i32 }
    if span("(?i)(?<=A)b", 0 as u32, "ab") != 1002 { return 118 as i32 }
    if span("(?<=a)B", regex.REGEX_ICASE, "aB") != 1002 { return 119 as i32 }
    if span("(?=(?<=a)b)b", 0 as u32, "ab") != 1002 { return 120 as i32 }
    if span("(?=(?=(?=a)a)a)a", 0 as u32, "aa") != 1 { return 121 as i32 }
    if span("(?<=(?<=a)b)c", 0 as u32, "abc") != 2003 { return 122 as i32 }
    if span("(?<!(?<!a)b)c", 0 as u32, "xbc abc") != 6007 { return 123 as i32 }
    if span("(?=a(?!b))a", 0 as u32, "ab ac") != 3004 { return 124 as i32 }
    if span("x(?=$)", regex.REGEX_MULTILINE, "ax\nb") != 1002 { return 125 as i32 }
    if span("(?=x$)x", 0 as u32, "ax\nb") != -1 { return 126 as i32 }
    if span("(?m:x(?=$))", 0 as u32, "ax\nb") != 1002 { return 127 as i32 }
    if span("(?<=^)b", regex.REGEX_MULTILINE, "a\nb") != 2003 { return 128 as i32 }
    if span("(?<=\\d)(?=(?:\\d{3})+$)", 0 as u32, "1234567") != 1001 { return 129 as i32 }
    if span("a(?=b|c)", 0 as u32, "ad ac") != 3004 { return 130 as i32 }
    if span("a(?=)", 0 as u32, "a") != 1 { return 131 as i32 }
    if span("(?<=)a", 0 as u32, "a") != 1 { return 132 as i32 }
    if span("(?!)a", 0 as u32, "a") != -1 { return 133 as i32 }
    if span("(?<=a{2,3})b", 0 as u32, "ab aab") != 5006 { return 134 as i32 }
    if span("(?<!a{2,3})b", 0 as u32, "aab ab") != 5006 { return 135 as i32 }
    if span("(?<=a?)b", 0 as u32, "b") != 1 { return 136 as i32 }

    // --- C. replacement and groups
    if replaced("(?<=\\d)(?=(?:\\d{3})+$)", 0 as u32, "1234567", ",") != "1,234,567" { return 20 as i32 }
    if replaced("(?<![0-9])x", 0 as u32, "x1x x", "-") != "-1x -" { return 21 as i32 }
    if replaced("(\\w+)(?=,)", 0 as u32, "ab, cd, ef", "<$1>") != "<ab>, <cd>, ef" { return 22 as i32 }
    if replaced("\\b(?!un)(\\w)(\\w*)", 0 as u32, "unit run", "$2") != "unit un" { return 23 as i32 }
    var r: regex.Regex = compile("(\\w+)(?=,)(,)", 0 as u32)
    var m: regex.Match = regex.match_new()
    let text: str = "ab, cd"
    if !regex.regex_find(&r, text, 0, &m) { return 24 as i32 }
    if regex.match_group_text(&m, text, 1) != "ab" || regex.match_group_text(&m, text, 2) != "," { return 25 as i32 }
    regex.regex_free(&r)
    // the Matcher: many finds over one text, lookbehind across the start offset
    var r2: regex.Regex = compile("(?<=a)b", 0 as u32)
    var mt: regex.Matcher = regex.matcher_new(&r2)
    let t2: str = "ab xb ab"
    var count: i32 = 0
    var from: usize = 0
    while regex.matcher_find(&mt, t2, from, &m) {
        count = count + 1
        from = m.end as usize
    }
    regex.matcher_free(&mt)
    regex.regex_free(&r2)
    if count != 2 { return 26 as i32 }
    // a find that starts in the middle still sees the text before it
    var r3: regex.Regex = compile("(?<=a)b", 0 as u32)
    if regex.regex_find(&r3, "ab", 1, &m) == false { return 27 as i32 }
    regex.regex_free(&r3)

    // --- D. UTF-8: characters, not octets
    var bad: rt.Buf = rt.buf_new()
    rt.buf_push(&bad, 255 as u8) // an invalid octet: one character U+FFFD
    rt.buf_push(&bad, 120 as u8)
    if span("(?<=.)x", 0 as u32, str { p: rt.buf_data(&bad), n: 2 }) != 1002 { return 30 as i32 }
    if span("(?<=\\x{fffd})x", 0 as u32, str { p: rt.buf_data(&bad), n: 2 }) != 1002 { return 31 as i32 }
    rt.buf_clear(&bad)
    rt.buf_push(&bad, 226 as u8) // a truncated euro sign, then a lone continuation octet
    rt.buf_push(&bad, 130 as u8)
    rt.buf_push(&bad, 120 as u8)
    // E2 82 78: E2 alone, 82 alone, 78 -> x is the third character
    if span("(?<=..)x", 0 as u32, str { p: rt.buf_data(&bad), n: 3 }) != 2003 { return 32 as i32 }
    if span("(?<=...)x", 0 as u32, str { p: rt.buf_data(&bad), n: 3 }) != -1 { return 33 as i32 }
    rt.buf_clear(&bad)
    rt.buf_push_bytes(&bad, "\u{20ac}\u{1f600}x".p as u64, 8)
    if span("(?<=..)x", 0 as u32, str { p: rt.buf_data(&bad), n: 8 }) != 7008 { return 34 as i32 }
    if span("(?<=^..)x", 0 as u32, str { p: rt.buf_data(&bad), n: 8 }) != 7008 { return 35 as i32 }
    if span("(?<=^.)x", 0 as u32, str { p: rt.buf_data(&bad), n: 8 }) != -1 { return 36 as i32 }
    rt.buf_free(&bad)

    // --- E. refusals
    if refusal("(?<=a*)b") != 2 || refusal("(?<=a+)b") != 2 || refusal("(?<=a{2,})b") != 2 { return 40 as i32 }
    if refusal("(?<=a{1000})b") != 0 || refusal("(?<=a{1001})b") != 3 || refusal("(?<=a{500}b{501})c") != 3 { return 41 as i32 }
    if refusal("(?=(a))") != 2 || refusal("(?<=(a))b") != 2 || refusal("(?!(?P<n>a))") != 2 { return 42 as i32 }
    if refusal("(?=a)*") != 1 || refusal("(?=a)+") != 1 || refusal("(?<!a)?") != 1 || refusal("(?=a){2}") != 1 { return 43 as i32 }
    if refusal("(?=a") != 1 || refusal("(?<=a") != 1 || refusal("(?=a))") != 1 { return 44 as i32 }
    if refusal("(?=(?=(?=a)))") != 0 || refusal("(?=(?=(?=(?=a))))") != 3 { return 45 as i32 }
    if refusal("(?:(?=a)b)+") != 0 || refusal("(a)(?=b)") != 0 || refusal("(?=a)(b)\\1") != 2 { return 46 as i32 }
    if refusal("(?<a)") != 1 && refusal("(?<a)") != 0 { return 47 as i32 } // (?<name>...) syntax rules unchanged
    if refusal("(?<n>a)") != 0 { return 48 as i32 }

    // --- F. nesting, with the memo: the same answers as the plain run
    if span("(?=(?=(?=.*c).*b).*a)x", 0 as u32, "xabc") != 1 { return 50 as i32 }
    if span("(?=(?=(?=.*c).*b).*a)x", 0 as u32, "xab") != -1 { return 51 as i32 }
    if span("(?<=(?<=(?<=a)b)c)d", 0 as u32, "abcd") != 3004 { return 52 as i32 }
    if span("(?!(?!(?!a)))b", 0 as u32, "ab") != 1002 { return 53 as i32 }
    if span("(?!(?!(?!a)))b", 0 as u32, "bb") != 1 { return 54 as i32 }

    // --- G. the counter-example text
    var buf: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 1500 {
        rt.buf_push(&buf, 97 as u8)
        i = i + 1
    }
    let many: str = str { p: rt.buf_data(&buf), n: rt.buf_len(&buf) }
    let t0: i64 = now_ms()
    if span("(?=.*z)a", 0 as u32, many) != -1 { return 60 as i32 }
    if span("(?=(?=.*z).*y)a", 0 as u32, many) != -1 { return 61 as i32 }
    if span("(?<![b])a(?=a*$)", 0 as u32, many) != 1 { return 62 as i32 }
    if span("(?<=a{1,40})b", 0 as u32, many) != -1 { return 63 as i32 }
    if now_ms() - t0 > 60000 { return 64 as i32 } // generous for -O0 under qemu
    rt.buf_free(&buf)
    return 42
}
