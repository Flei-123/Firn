// expect_exit: 0
// RUNDE 47 — die NEGATIVSEITE der Finalisierer-Schnittstelle.
//
// Jede Ablehnung wird geprueft. Nichts davon darf still durchgehen:
//   * Nullzeiger, Zeiger auf den Stapel, Zeiger mitten in ein Objekt
//   * Aufraeumart 0 und Aufraeumart > 16777215
//   * doppelte Registrierung
//   * `gc_finalisierer_loeschen` VOR dem Sammeln nimmt sie wirklich zurueck —
//     das Objekt wird dann OHNE Finalisierer eingesammelt
//   * `gc_finalisierer_art` liefert 0, wenn keine registriert ist

const ART_ZU_GROSS: u64 = 16777216
const ART_GRENZE: u64 = 16777215

gc class Ding {
    naechster: Gc[Ding],
    wert: u64,
}

fn __gc_finalisiere(art: u64, p: *mut u8) {
    // Dieser Test zaehlt nur die LAEUFE (gc_fin_laeufe()); der Verteiler
    // selbst muss nichts tun. Die Parameter werden absichtlich beruehrt,
    // damit klar ist, dass die Signatur die vereinbarte ist.
    let d: Gc[Ding] = p as Gc[Ding]
    if art == 0 {
        return
    }
    if d == gc_null[Ding]() {
        return
    }
}

fn weg(tiefe: u64) -> AllocError!bool {
    var fuell: [u64; 128] = [0; 128]
    let fp: u64 = (&fuell) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    if tiefe > 0 {
        return try weg(tiefe - 1)
    }
    let d: Gc[Ding] = try gc Ding{ naechster: gc_null[Ding](), wert: 1 }
    if !gc_finalisierer_setzen(d as *mut u8, 4) {
        return false
    }
    if !gc_finalisierer_loeschen(d as *mut u8) {
        return false
    }
    if gc_finalisierer_art(d as *mut u8) != 0 {
        return false
    }
    return true
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return lauf() catch 91
}

fn lauf() -> AllocError!i32 {
    var stapelwert: u64 = 12345
    let d: Gc[Ding] = try gc Ding{ naechster: gc_null[Ding](), wert: 3 }

    // --- Zeiger, die keine Objektanfaenge sind -----------------------------
    if gc_finalisierer_setzen(0 as *mut u8, 1) {
        return 1
    }
    if gc_finalisierer_setzen((&stapelwert) as *mut u8, 1) {
        return 2
    }
    // Mitten ins Objekt (Feld 2) — kein Objektanfang.
    if gc_finalisierer_setzen((&d.wert) as *mut u8, 1) {
        return 3
    }

    // --- unerlaubte Aufraeumarten -------------------------------------------
    if gc_finalisierer_setzen(d as *mut u8, 0) {
        return 4
    }
    if gc_finalisierer_setzen(d as *mut u8, ART_ZU_GROSS) {
        return 5
    }
    if gc_finalisierer_art(d as *mut u8) != 0 {
        return 6
    }

    // --- die groesste erlaubte Art geht ------------------------------------
    if !gc_finalisierer_setzen(d as *mut u8, ART_GRENZE) {
        return 7
    }
    if gc_finalisierer_art(d as *mut u8) != ART_GRENZE {
        return 8
    }
    // --- doppelt geht nicht --------------------------------------------------
    if gc_finalisierer_setzen(d as *mut u8, 2) {
        return 9
    }
    if gc_finalisierer_art(d as *mut u8) != ART_GRENZE {
        return 10
    }
    // --- zuruecknehmen ------------------------------------------------------
    if !gc_finalisierer_loeschen(d as *mut u8) {
        return 11
    }
    if gc_finalisierer_art(d as *mut u8) != 0 {
        return 12
    }
    if gc_finalisierer_loeschen(d as *mut u8) {
        return 13
    }
    if gc_finalisierer_loeschen(0 as *mut u8) {
        return 14
    }

    // --- ein zurueckgenommener Finalisierer laeuft NICHT --------------------
    // Bis hier ist GENAU EINE Registrierung durchgekommen (ART_GRENZE auf `d`);
    // alle abgelehnten Versuche zaehlen nicht mit.
    if gc_fin_registriert() != 1 {
        return 15
    }
    if !(try weg(2)) {
        return 16
    }
    if gc_fin_registriert() != 2 {
        return 21
    }
    gc_collect()
    gc_collect()
    if gc_fin_laeufe() != 0 {
        return 17
    }
    if gc_fin_wartend() != 0 {
        return 18
    }
    // `d` lebt weiter (es steht hier noch im Rahmen).
    if d.wert != 3 {
        return 19
    }
    if stapelwert != 12345 {
        return 20
    }
    return 0
}
