// expect_exit: 0
// tests/3826_std_log_infof.fi -- std.log f-string forms and `enabled`.
import std.rt
import std.fs
import std.fsx
import std.io
import std.log
import std.testkit

fn slurp(path: str) -> str {
    var b: rt.Buf = rt.buf_new()
    fs.read_file(path, &b) catch 0
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

#[allow_escape]
fn work() -> FsError!bool {
    var d: fsx.TempDir = try fsx.temp_dir("logf_t_")
    defer fsx.temp_dir_drop(&d)
    let path: str = fsx.temp_dir_path(&d) + "/a.log"
    var lg: log.Logging = log.logging(log.INFO, "%(levelname)s|%(name)s|%(message)s")
    log.add_file(&lg, path, log.NOTSET, 0, 0)
    var n: i32 = 7
    log.debugf(&lg, "a", f"hidden {n}")
    log.infof(&lg, "a", f"n={n}")
    log.warningf(&lg, "a.b", f"w {n + 1}")
    log.errf(&lg, "a", f"e")
    log.criticalf(&lg, "a", f"c")
    testkit.check(slurp(path) == "INFO|a|n=7\nWARNING|a.b|w 8\nERROR|a|e\nCRITICAL|a|c\n", "f-string forms")
    testkit.check(!log.enabled(&lg, "a", log.DEBUG) && log.enabled(&lg, "a", log.INFO), "enabled")
    log.set_level(&lg, "a", log.DEBUG)
    testkit.check(log.enabled(&lg, "a.b", log.DEBUG), "enabled follows the logger levels")
    log.close(&lg)
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    testkit.check(work() catch | e | false, "work ran")
    return testkit.finish()
}
