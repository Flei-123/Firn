import jobs.jobs
import scene3d.render
import scene3d.scene
import scene3d.camera
import scene3d.surface
import scene3d.vec3
import scene3d.material
import scene3d.mesh

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0
}

fn add_quad(m: *mut mesh.Mesh, p0: vec3.V3, p1: vec3.V3, p2: vec3.V3, p3: vec3.V3, n: vec3.V3) {
    let a: u32 = mesh.mesh_add_vertex(m, p0, n, 0.0, 0.0)
    let b: u32 = mesh.mesh_add_vertex(m, p1, n, 1.0, 0.0)
    let c: u32 = mesh.mesh_add_vertex(m, p2, n, 1.0, 1.0)
    let d: u32 = mesh.mesh_add_vertex(m, p3, n, 0.0, 1.0)
    mesh.mesh_add_quad(m, a, b, c, d)
}

fn front_quad(m: *mut mesh.Mesh, z: f64, s: f64) {
    add_quad(m, vec3.v3(0.0 - s, 0.0 - s, z), vec3.v3(s, 0.0 - s, z), vec3.v3(s, s, z), vec3.v3(0.0 - s, s, z), vec3.v3(0.0, 0.0, 1.0))
}

fn back_quad(m: *mut mesh.Mesh, z: f64, s: f64) {
    add_quad(m, vec3.v3(0.0 - s, s, z), vec3.v3(s, s, z), vec3.v3(s, 0.0 - s, z), vec3.v3(0.0 - s, 0.0 - s, z), vec3.v3(0.0, 0.0, 0.0 - 1.0))
}

fn floor_quad(m: *mut mesh.Mesh, y: f64, s: f64) {
    add_quad(m, vec3.v3(0.0 - s, y, s), vec3.v3(s, y, s), vec3.v3(s, y, 0.0 - s), vec3.v3(0.0 - s, y, 0.0 - s), vec3.v3(0.0, 1.0, 0.0))
}

fn chan(p: u32, c: i32) -> i32 {
    return ((p >> ((c * 8) as u32)) & 255 as u32) as i32
}

fn close(p: u32, r: i32, g: i32, b: i32, tol: i32) -> bool {
    let dr: i32 = chan(p, 0) - r
    let dg: i32 = chan(p, 1) - g
    let db: i32 = chan(p, 2) - b
    return dr <= tol && dr >= 0 - tol && dg <= tol && dg >= 0 - tol && db <= tol && db >= 0 - tol
}

fn same(a: *mut surface.Surface, b: *mut surface.Surface) -> bool {
    var i: i32 = 0
    while i < (*a).w * (*a).h {
        if surface.surface_get(a, i % (*a).w, i / (*a).w) != surface.surface_get(b, i % (*a).w, i / (*a).w) { return false }
        i = i + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    var sc: scene.Scene = scene.scene_new()
    var m0: mesh.Mesh = mesh.mesh_new()
    front_quad(&m0, 0.0, 1.0)
    let red_mesh: i32 = scene.scene_add_mesh(&sc, m0)
    var m1: mesh.Mesh = mesh.mesh_new()
    front_quad(&m1, 1.0, 0.5)
    let glass_mesh: i32 = scene.scene_add_mesh(&sc, m1)
    var m2: mesh.Mesh = mesh.mesh_new()
    back_quad(&m2, 0.5, 3.0)
    let back_mesh: i32 = scene.scene_add_mesh(&sc, m2)
    var m3: mesh.Mesh = mesh.mesh_new()
    floor_quad(&m3, 0.0 - 1.0, 50.0)
    let floor_mesh: i32 = scene.scene_add_mesh(&sc, m3)
    let red: i32 = scene.scene_add_material(&sc, material.mat_unlit(vec3.v3(1.0, 0.0, 0.0)))
    let blue: i32 = scene.scene_add_material(&sc, material.mat_with_opacity(material.mat_unlit(vec3.v3(0.0, 0.0, 1.0)), 0.5))
    let green: i32 = scene.scene_add_material(&sc, material.mat_unlit(vec3.v3(0.0, 1.0, 0.0)))
    let n_red: i32 = scene.scene_add_mesh_node(&sc, 0 - 1, red_mesh, red)
    let n_glass: i32 = scene.scene_add_mesh_node(&sc, 0 - 1, glass_mesh, blue)
    let n_back: i32 = scene.scene_add_mesh_node(&sc, 0 - 1, back_mesh, green)
    let n_floor: i32 = scene.scene_add_mesh_node(&sc, 0 - 1, floor_mesh, green)
    scene.node_set_visible(scene.scene_node(&sc, n_back), false)
    scene.node_set_visible(scene.scene_node(&sc, n_floor), false)
    var cam: camera.Camera = camera.cam_new(64, 48)
    var ra: render.Renderer = render.renderer_new(64, 48, 2, 0)
    var rb: render.Renderer = render.renderer_new(64, 48, 2, 3)
    var sa: surface.Surface = surface.surface_new(64, 48)
    var sb: surface.Surface = surface.surface_new(64, 48)
    var code: i32 = 0
    render.render(&ra, &sc, &cam, &sa)
    render.render(&rb, &sc, &cam, &sb)
    if same(&sa, &sb) == false { code = 1 }
    if code == 0 && close(surface.surface_get(&sa, 32, 24), 188, 0, 188, 3) == false { code = 2 }
    if code == 0 && close(surface.surface_get(&sa, 32, 19), 255, 0, 0, 0) == false { code = 3 }
    if code == 0 && chan(surface.surface_get(&sa, 1, 1), 0) == 255 { code = 4 }
    scene.node_set_visible(scene.scene_node(&sc, n_back), true)
    render.render(&ra, &sc, &cam, &sa)
    if code == 0 && close(surface.surface_get(&sa, 32, 19), 255, 0, 0, 0) == false { code = 5 }
    if code == 0 && close(surface.surface_get(&sa, 5, 5), 0, 255, 0, 0) { code = 6 }
    scene.node_set_visible(scene.scene_node(&sc, n_back), false)
    scene.node_set_visible(scene.scene_node(&sc, n_floor), true)
    cam.pos = vec3.v3(0.0, 0.0, 5.0)
    render.render(&ra, &sc, &cam, &sa)
    render.render(&rb, &sc, &cam, &sb)
    if code == 0 && same(&sa, &sb) == false { code = 7 }
    if code == 0 && close(surface.surface_get(&sa, 32, 47), 0, 255, 0, 0) == false { code = 8 }
    scene.node_set_opacity(scene.scene_node(&sc, n_red), 0.0)
    render.render(&ra, &sc, &cam, &sa)
    if code == 0 && close(surface.surface_get(&sa, 32, 19), 255, 0, 0, 0) { code = 9 }
    render.renderer_free(&ra)
    render.renderer_free(&rb)
    surface.surface_free(&sa)
    surface.surface_free(&sb)
    scene.scene_free(&sc)
    return code
}
