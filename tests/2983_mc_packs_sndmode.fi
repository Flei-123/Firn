// expect_exit: 0
// tests/2983_mc_packs_sndmode.fi -- sounds= mode of the pack manager (config text) + the mcplay flow of packsnd_apply:
// synth bank first (both), pack events on top, reload with a CHANGED file does not grow the sample table, original mode = pack events only.
import std.rt
import std.io
import zip.zip
import audio.engine
import audio.bank
import mc.mc_audio
import mc.mc_assets
import mc.mc_packs
import mc.mc_packsnd

struct T {
    fails: i32,
}

fn check(t: *mut T, ok: bool, what: str) {
    if ok {
        io.fmt_print(f"ok   {what}\n")
    } else {
        io.fmt_print(f"FAIL {what}\n")
        (*t).fails = (*t).fails + 1
    }
}

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"

fn add_str(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    var ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

fn add_file(w: *mut zip.ZipWriter, name: str, src: str) -> bool {
    var p: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&p, src.p as u64, src.length())
    rt.buf_push(&p, 0 as u8)
    var d: rt.Buf = rt.buf_new()
    var ok: bool = rt.read_file(rt.buf_ptr(&p), &d)
    if ok { ok = zip.zip_add(w, name, rt.buf_ptr(&d), rt.buf_len(&d), false) catch | e | (false) }
    rt.buf_free(&p)
    rt.buf_free(&d)
    return ok
}

// One pack in memory: block.stone.step -> custom/a, ui.button.click -> custom/b (the files are chosen by the caller).
fn make_stack(stack: *mut mc_assets.PackStack, buf: *mut rt.Buf, ogg_a: str, ogg_b: str) -> bool {
    var w: zip.ZipWriter = zip.zip_writer_new(buf)
    var ok: bool = add_str(&w, "pack.mcmeta", META)
    ok = add_str(&w, "assets/minecraft/sounds.json", "{\"block.stone.step\":{\"sounds\":[\"custom/a\"]},\"ui.button.click\":{\"sounds\":[\"custom/b\"]}}") && ok
    ok = add_file(&w, "assets/minecraft/sounds/custom/a.ogg", ogg_a) && ok
    ok = add_file(&w, "assets/minecraft/sounds/custom/b.ogg", ogg_b) && ok
    let n: usize = zip.zip_finish(&w) catch | e | (0)
    zip.zip_writer_free(&w)
    if n == 0 || !ok { return false }
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&pk, rt.buf_ptr(buf), rt.buf_len(buf)) != mc_assets.ASSET_OK { return false }
    return mc_assets.stack_push(stack, &pk) == mc_assets.ASSET_OK
}

fn mode_of(text: str) -> i32 {
    var m: mc_packs.ResMgr = mc_packs.res_new()
    mc_packs.res_load_config_text(&m, text, "")
    let r: i32 = mc_packs.res_sounds_mode(&m)
    mc_packs.res_free(&m)
    return r
}

#[allow_escape]
fn main(start: u64) -> i32 {
    var t: T = T { fails: 0 }
    // config text -> mode
    check(&t, mode_of("") == mc_packs.SOUNDS_SYNTH, "default = synth")
    check(&t, mode_of("sounds=original\n") == mc_packs.SOUNDS_ORIGINAL, "sounds=original")
    check(&t, mode_of("# c\nsounds=both\n") == mc_packs.SOUNDS_BOTH, "sounds=both")
    check(&t, mode_of("sounds=nonsense\n") == mc_packs.SOUNDS_SYNTH, "unknown value = synth")

    // runtime toggle (mcplay key O): synth <-> last pack mode (default both)
    var tm: mc_packs.ResMgr = mc_packs.res_new()
    check(&t, mc_packs.res_toggle_sounds(&tm) == mc_packs.SOUNDS_BOTH, "toggle from synth -> both (default pack mode)")
    check(&t, mc_packs.res_toggle_sounds(&tm) == mc_packs.SOUNDS_SYNTH && mc_packs.res_sounds_mode(&tm) == mc_packs.SOUNDS_SYNTH, "toggle again -> synth")
    mc_packs.res_load_config_text(&tm, "sounds=original\n", "")
    check(&t, mc_packs.res_toggle_sounds(&tm) == mc_packs.SOUNDS_SYNTH, "config original: first toggle -> synth")
    check(&t, mc_packs.res_toggle_sounds(&tm) == mc_packs.SOUNDS_ORIGINAL, "toggle remembers original")
    check(&t, mc_packs.res_sounds_name(mc_packs.SOUNDS_ORIGINAL) == "original" && mc_packs.res_sounds_name(mc_packs.SOUNDS_BOTH) == "both" && mc_packs.res_sounds_name(mc_packs.SOUNDS_SYNTH) == "synth", "mode names")
    mc_packs.res_free(&tm)

    // mcplay flow, mode both: apply, reload with the same packs, reload with a changed file
    var e: engine.Engine = engine.engine_new(48000 as u32, 64 as u32)
    var b: bank.Bank = bank.bank_new()
    var m: mc_audio.McAudio = mc_audio.mca_new(&e)
    var s1: mc_assets.PackStack = mc_assets.stack_new()
    var buf1: rt.Buf = rt.buf_new()
    check(&t, make_stack(&s1, &buf1, "tests/data/vorbis/sine_m22k_q3.ogg", "tests/data/vorbis/impulse_m44k_q4.ogg"), "pack 1 built")
    let n1: i32 = mc_packsnd.packsnd_apply(&m, &b, &e, &s1, mc_packs.SOUNDS_BOTH)
    check(&t, n1 == 2, "both: 2 pack events")
    let ns1: usize = engine.engine_sample_count(&e)
    let ne1: usize = engine.engine_event_count(&e)
    check(&t, ns1 == 2 && ne1 == 2, "2 samples, 2 events")
    check(&t, mc_packsnd.packsnd_apply(&m, &b, &e, &s1, mc_packs.SOUNDS_BOTH) == 2 && engine.engine_sample_count(&e) == ns1 && engine.engine_event_count(&e) == ne1, "same reload: tables stay")

    // T key: the stack is rebuilt (new Pack objects), file a.ogg is now another OGG
    var s2: mc_assets.PackStack = mc_assets.stack_new()
    var buf2: rt.Buf = rt.buf_new()
    check(&t, make_stack(&s2, &buf2, "tests/data/vorbis/tone_s48k_q0.ogg", "tests/data/vorbis/impulse_m44k_q4.ogg"), "pack 2 built (a.ogg changed)")
    let f0: u64 = engine.engine_sample_frames(&e, 0)
    check(&t, mc_packsnd.packsnd_apply(&m, &b, &e, &s2, mc_packs.SOUNDS_BOTH) == 2, "changed reload ok")
    check(&t, engine.engine_sample_count(&e) == ns1 && engine.engine_event_count(&e) == ne1, "changed reload: sample table did not grow")
    check(&t, engine.engine_sample_frames(&e, 0) != f0 || engine.engine_sample_frames(&e, 1) != engine.engine_sample_frames(&e, 0), "changed reload: new PCM in the slot")
    check(&t, mc_audio.mca_play_ui(&m, "ui.button.click", 1.0, 1.0) != 0 as u32, "the pack event plays after reload")

    // original: a fresh engine/bank gets ONLY the pack events
    var e2: engine.Engine = engine.engine_new(48000 as u32, 64 as u32)
    var b2: bank.Bank = bank.bank_new()
    var m2: mc_audio.McAudio = mc_audio.mca_new(&e2)
    check(&t, mc_packsnd.packsnd_apply(&m2, &b2, &e2, &s2, mc_packs.SOUNDS_ORIGINAL) == 2, "original: 2 events")
    check(&t, engine.engine_event_count(&e2) == 2 && engine.engine_find_event(&e2, "block.stone.step") >= 0, "original: only pack events exist")
    check(&t, mc_audio.mca_play_ui(&m2, "ui.button.click", 1.0, 1.0) != 0 as u32, "original: pack event plays")
    // synth: nothing
    var e3: engine.Engine = engine.engine_new(48000 as u32, 64 as u32)
    var b3: bank.Bank = bank.bank_new()
    var m3: mc_audio.McAudio = mc_audio.mca_new(&e3)
    check(&t, mc_packsnd.packsnd_apply(&m3, &b3, &e3, &s2, mc_packs.SOUNDS_SYNTH) == 0 && engine.engine_event_count(&e3) == 0, "synth: nothing loaded")

    if t.fails == 0 {
        io.fmt_print(f"OK\n")
        return 0
    }
    io.fmt_print(f"{t.fails} FAILED\n")
    return 1
}
