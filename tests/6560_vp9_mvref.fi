// expect_exit: 0
import media.video.vp9.vp9mem
import media.video.vp9.vp9state
import media.video.vp9.vp9mvmi
import media.video.vp9.vp9mvref

fn put(f: *mut vp9state.Vp9, row: i64, col: i64, ref0: i64, r: i64, c: i64, mode: i64) {
    let mi: u64 = vp9state.mi_ptr(f, row, col)
    vp9mem.st8(mi, vp9state.MI_REF0, ref0)
    vp9mem.st8(mi, vp9state.MI_MODE, mode)
    vp9mvmi.set_mv(mi, 0, r, c)
}

fn main() -> i32 {
    var f: vp9state.Vp9 = vp9state.vp9_new()
    if !vp9state.vp9_setup(&f, 128, 128) {
        return 1
    }
    f.tile_c1 = f.mi_cols
    put(&f, 2, 1, 1, 4, 6, 12)
    put(&f, 1, 2, 2, 8, 0 - 2, 10)
    var o: vp9mvref.MvRefs = vp9mvref.mvrefs_new()
    vp9mvref.find_mv_refs(&f, &o, 2, 2, 3, 1, 0 - 1)
    if o.count != 2 || o.r0 != 4 || o.c0 != 6 || o.r1 != 8 || o.c1 != 0 - 2 {
        return 2
    }
    if vp9mvref.mode_context(&f, 2, 2, 3) != 1 {
        return 3
    }
    f.sign_bias[2] = 1
    vp9mvref.find_mv_refs(&f, &o, 2, 2, 3, 1, 0 - 1)
    if o.r1 != 0 - 8 || o.c1 != 2 {
        return 4
    }
    f.sign_bias[2] = 0
    put(&f, 2, 1, 1, 4000, 0 - 4000, 12)
    vp9mvref.find_mv_refs(&f, &o, 2, 2, 3, 1, 0 - 1)
    if o.r0 != 960 || o.c0 != 0 - (2 * 64 + 128) {
        return 5
    }
    o.r0 = 5
    o.c0 = 0 - 3
    vp9mvref.lower_mv_precision(&o, false, 0)
    if o.r0 != 4 || o.c0 != 0 - 2 {
        return 6
    }
    o.r0 = 5
    o.c0 = 0 - 3
    vp9mvref.lower_mv_precision(&o, true, 0)
    if o.r0 != 5 || o.c0 != 0 - 3 {
        return 7
    }
    let cur: u64 = vp9state.mi_ptr(&f, 6, 6)
    vp9mvmi.set_bmi(cur, 0, 0, 2, 2)
    vp9mvmi.set_bmi(cur, 1, 0, 1, 1)
    vp9mvmi.set_bmi(cur, 2, 0, 1, 1)
    vp9mvref.append_sub8x8(&f, cur, &o, 6, 6, 0, 11, 3, 0, 1)
    if o.r0 != 2 || o.c0 != 2 {
        return 8
    }
    vp9mvref.append_sub8x8(&f, cur, &o, 6, 6, 0, 10, 1, 0, 1)
    if o.r0 != 2 || o.c0 != 2 {
        return 9
    }
    let pv: u64 = f.prev_mi + (((9 * (f.sb_cols * 8) + 9) as usize) * vp9state.MI_SIZE) as u64
    vp9mem.st8(pv, vp9state.MI_REF0, 1)
    vp9mvmi.set_mv(pv, 0, 7, 7)
    f.last_w = f.w
    f.last_h = f.h
    f.last_show = true
    if !vp9mvref.use_prev_mvs(&f) {
        return 10
    }
    vp9mvref.find_mv_refs(&f, &o, 9, 9, 3, 1, 0 - 1)
    if o.count != 1 || o.r0 != 7 || o.c0 != 7 {
        return 11
    }
    f.last_show = false
    vp9mvref.find_mv_refs(&f, &o, 9, 9, 3, 1, 0 - 1)
    if o.count != 0 {
        return 12
    }
    return 0
}
