// expect_exit: 99
// #[no_gc] and 'match': the bodies of the cases do not live in the AST but in
// the registry of sema_match.rs. The check in nogc.rs descends into it --
// otherwise every state machine would be a blind spot.
// Here all functions called from a case are marked, so the program compiles.
// The counter-check is in tests/neg/nogc_match_case.fi.
enum State { Start, Name, Value, End }

#[no_gc]
fn weight(c: i32) -> i32 {
    return c * 2 as i32
}

#[no_gc]
fn next(z: State) -> State {
    match z {
        State::Start => { return State::Name }
        State::Name => { return State::Value }
        State::Value => { return State::End }
        State::End => { return State::Start }
    }
}

#[no_gc]
fn step(z: State, c: i32) -> i32 {
    match z {
        State::Start => { return weight(c) }
        State::Name => { return weight(c) + 1 as i32 }
        State::Value => { return weight(c) + 2 as i32 }
        State::End => { return 0 as i32 }
    }
}

#[no_gc]
fn run(n: i32) -> i32 {
    var z: State = State::Start
    var sum: i32 = 0
    var i: i32 = 0
    while i < n {
        sum = sum + step(z, i)
        z = next(z)
        i = i + 1
    }
    return sum
}

fn main() -> i32 {
    // i=0: start 0 | i=1: name 3 | i=2: value 6 | i=3: end 0
    // i=4: start 8 | i=5: name 11 | i=6: value 14 | i=7: end 0
    // i=8: start 16 | i=9: name 19 | i=10: value 22 | i=11: end 0
    // Sum = 99
    return run(12 as i32)
}
