// expect_exit: 99
// #[no_gc] und 'match': die Rumpfbloecke der Faelle liegen nicht im AST,
// sondern in der Registrierung von sema_match.rs. Die Pruefung in nogc.rs
// steigt dort hinein — sonst waere jede Zustandsmaschine ein blinder Fleck.
// Hier sind alle aus einem Fall gerufenen Funktionen markiert, das Programm
// uebersetzt also. Die Gegenprobe steht in tests/neg/nogc_match_case.fi.
enum State { Start, Name, Value, End }

#[no_gc]
fn weight(c: i32) -> i32 {
    return c * 2 as i32
}

#[no_gc]
fn next(z: State) -> State {
    match z {
        State::Start => { return State::Name }
        State::Name => { return State::Value }
        State::Value => { return State::End }
        State::End => { return State::Start }
    }
}

#[no_gc]
fn step(z: State, c: i32) -> i32 {
    match z {
        State::Start => { return weight(c) }
        State::Name => { return weight(c) + 1 as i32 }
        State::Value => { return weight(c) + 2 as i32 }
        State::End => { return 0 as i32 }
    }
}

#[no_gc]
fn run(n: i32) -> i32 {
    var z: State = State::Start
    var sum: i32 = 0
    var i: i32 = 0
    while i < n {
        sum = sum + step(z, i)
        z = next(z)
        i = i + 1
    }
    return sum
}

fn main() -> i32 {
    // i=0: Anfang 0 | i=1: Name 3 | i=2: Wert 6 | i=3: Ende 0
    // i=4: Anfang 8 | i=5: Name 11 | i=6: Wert 14 | i=7: Ende 0
    // i=8: Anfang 16 | i=9: Name 19 | i=10: Wert 22 | i=11: Ende 0
    // Summe = 99
    return run(12 as i32)
}
