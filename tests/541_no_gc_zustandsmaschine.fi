// expect_exit: 99
// #[no_gc] und 'match': die Rumpfbloecke der Faelle liegen nicht im AST,
// sondern in der Registrierung von sema_match.rs. Die Pruefung in nogc.rs
// steigt dort hinein — sonst waere jede Zustandsmaschine ein blinder Fleck.
// Hier sind alle aus einem Fall gerufenen Funktionen markiert, das Programm
// uebersetzt also. Die Gegenprobe steht in tests/neg/nogc_match_fall.fi.
enum Zustand { Anfang, Name, Wert, Ende }

#[no_gc]
fn gewicht(c: i32) -> i32 {
    return c * 2 as i32
}

#[no_gc]
fn naechster(z: Zustand) -> Zustand {
    match z {
        Zustand::Anfang => { return Zustand::Name }
        Zustand::Name => { return Zustand::Wert }
        Zustand::Wert => { return Zustand::Ende }
        Zustand::Ende => { return Zustand::Anfang }
    }
}

#[no_gc]
fn schritt(z: Zustand, c: i32) -> i32 {
    match z {
        Zustand::Anfang => { return gewicht(c) }
        Zustand::Name => { return gewicht(c) + 1 as i32 }
        Zustand::Wert => { return gewicht(c) + 2 as i32 }
        Zustand::Ende => { return 0 as i32 }
    }
}

#[no_gc]
fn lauf(n: i32) -> i32 {
    var z: Zustand = Zustand::Anfang
    var summe: i32 = 0
    var i: i32 = 0
    while i < n {
        summe = summe + schritt(z, i)
        z = naechster(z)
        i = i + 1
    }
    return summe
}

fn main() -> i32 {
    // i=0: Anfang 0 | i=1: Name 3 | i=2: Wert 6 | i=3: Ende 0
    // i=4: Anfang 8 | i=5: Name 11 | i=6: Wert 14 | i=7: Ende 0
    // i=8: Anfang 16 | i=9: Name 19 | i=10: Wert 22 | i=11: Ende 0
    // Summe = 99
    return lauf(12 as i32)
}
