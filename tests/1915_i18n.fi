// expect_exit: 42
// tests/1915_i18n.fi -- lib/i18n (OpenPlan LIB-007): the .opmsg catalog,
// the fallback chain, variant selection, arguments, and the refusals.
// Plural rules, numbers and dates against ICU in eight languages:
// tools/libmvp/check_i18n.py.
import i18n.i18n
import std.str

fn load(text: str, lang: str) -> i18n.Catalog {
    return i18n.catalog_load(text.p as u64, text.n, lang) catch | e | (dead())
}

fn dead() -> i18n.Catalog {
    syscall(60, 99, 0, 0, 0, 0, 0)
    return dead()
}

// the error a catalog is refused with: 0 = accepted
fn refusal(text: str, lang: str) -> i32 {
    var why: i32 = 0
    var c: i18n.Catalog = i18n.catalog_load(text.p as u64, text.n, lang) catch | e | (mark(e, &why))
    i18n.catalog_free(&c)
    return why
}

fn mark(e: I18nError, why: *mut i32) -> i18n.Catalog {
    if e == I18nError::Syntax { *why = 1 as i32 }
    if e == I18nError::MissingOther { *why = 2 as i32 }
    if e == I18nError::Duplicate { *why = 3 as i32 }
    if e == I18nError::BadLang { *why = 4 as i32 }
    let ok: str = "@lang x"
    return load(ok, "")
}

fn main() -> i32 {
    let en: str = "# OpenPlan -- source language\n@lang en-US\n\npage-of = Page {page:number} of {total:number}\ndevices-selected[=0] = No device selected\ndevices-selected[one] = {count:number} device selected\ndevices-selected[other] = {count:number} devices selected\nonly-english = English only\nrevision-date = Revision {index}, released {date:date}\nkind[plc] = PLC card {name}\nkind[other] = Device {name}\nescapes = a\\nb \\{literal\\} back\\\\slash\n"
    let de: str = "\u{FEFF}@lang de\r\npage-of = Seite {page:number} von {total:number}\r\ndevices-selected[one] = {count:number} Gerät ausgewählt\r\ndevices-selected[other] = {count:number} Geräte ausgewählt\r\nrevision-date = Revision {index}, freigegeben am {date:date}\r\n"
    let ru: str = "@lang ru\nfiles[one] = {n:number} файл\nfiles[few] = {n:number} файла\nfiles[many] = {n:number} файлов\nfiles[other] = {n:number} файла\n"
    var ce: i18n.Catalog = load(en, "en-US")
    var cd: i18n.Catalog = load(de, "de")
    var cr: i18n.Catalog = load(ru, "")
    if i18n.catalog_lang(&cr) != "ru" || !i18n.catalog_has(&ce, "page-of") || i18n.catalog_has(&cd, "only-english") { return 1 as i32 }

    // --- A. the chain de -> en-US
    var b: i18n.Bundle = i18n.bundle_new()
    i18n.bundle_add(&b, cd)
    i18n.bundle_add(&b, ce)
    var a: i18n.Args = i18n.args_new()
    i18n.args_num(&a, "page", 3.0)
    i18n.args_num(&a, "total", 12.0)
    if i18n.msg(&b, "page-of", &a) != "Seite 3 von 12" { return 10 as i32 }
    if i18n.msg(&b, "only-english", &a) != "English only" { return 11 as i32 }
    if i18n.msg(&b, "no-such-key", &a) != "no-such-key" { return 12 as i32 }

    // --- B. variants: exact number, plural category, select, fallback
    var n0: i18n.Args = i18n.args_new()
    i18n.args_num(&n0, "count", 0.0)
    var n1: i18n.Args = i18n.args_new()
    i18n.args_num(&n1, "count", 1.0)
    var n2: i18n.Args = i18n.args_new()
    i18n.args_num(&n2, "count", 1234.5)
    if i18n.msg(&b, "devices-selected", &n1) != "1 Gerät ausgewählt" { return 20 as i32 }
    if i18n.msg(&b, "devices-selected", &n2) != "1.234,5 Geräte ausgewählt" { return 21 as i32 }
    // the German catalog has no "=0": its "other" answers, in German
    if i18n.msg(&b, "devices-selected", &n0) != "0 Geräte ausgewählt" { return 22 as i32 }
    var be: i18n.Bundle = i18n.bundle_new()
    i18n.bundle_add(&be, load(en, "en-US"))
    if i18n.msg(&be, "devices-selected", &n0) != "No device selected" { return 23 as i32 }
    if i18n.msg(&be, "devices-selected", &n2) != "1,234.5 devices selected" { return 24 as i32 }
    var sel: i18n.Args = i18n.args_new()
    i18n.args_str(&sel, "name", "-A1")
    if i18n.msg(&be, "kind", &sel) != "Device -A1" { return 25 as i32 }
    // a select argument decides only when the text says {x:select}; here
    // the first :number/:select is missing, so "other" answers
    if i18n.msg(&be, "escapes", &sel) != "a\nb {literal} back\\slash" { return 26 as i32 }
    // Russian: one / few / many
    var br: i18n.Bundle = i18n.bundle_new()
    i18n.bundle_add(&br, cr)
    var r: i18n.Args = i18n.args_new()
    i18n.args_num(&r, "n", 21.0)
    if i18n.msg(&br, "files", &r) != "21 файл" { return 27 as i32 }
    var r2: i18n.Args = i18n.args_new()
    i18n.args_num(&r2, "n", 3.0)
    if i18n.msg(&br, "files", &r2) != "3 файла" { return 28 as i32 }
    var r3: i18n.Args = i18n.args_new()
    i18n.args_num(&r3, "n", 11.0)
    if i18n.msg(&br, "files", &r3) != "11 файлов" { return 29 as i32 }

    // --- C. dates and missing arguments
    var d: i18n.Args = i18n.args_new()
    i18n.args_str(&d, "index", "B")
    i18n.args_date(&d, "date", 1790351407123, 120 as i32) // 2026-09-25 17:50 in Vienna
    if i18n.msg(&b, "revision-date", &d) != "Revision B, freigegeben am 25.09.2026" { return 30 as i32 }
    if i18n.msg(&be, "revision-date", &d) != "Revision B, released Sep 25, 2026" { return 31 as i32 }
    var none: i18n.Args = i18n.args_new()
    if i18n.msg(&b, "page-of", &none) != "Seite {page:number} von {total:number}" { return 32 as i32 }

    // --- D. the functions on their own
    if i18n.plural_category("de", 1.0) != i18n.PLURAL_ONE || i18n.plural_category_v("en", 1.0, 1 as u32) != i18n.PLURAL_OTHER { return 40 as i32 }
    if i18n.plural_category("pl", 22.0) != i18n.PLURAL_FEW || i18n.plural_category("pl", 25.0) != i18n.PLURAL_MANY { return 41 as i32 }
    if i18n.plural_category("cs", 1.5) != i18n.PLURAL_MANY || i18n.plural_category("fr", 0.0) != i18n.PLURAL_ONE { return 42 as i32 }
    if i18n.format_number("en-US", 2.5, 1 as u32) != "2.5" || i18n.format_number("de-AT", 2.5, 1 as u32) != "2,5" { return 43 as i32 }
    if i18n.format_number("fr", 1234567.891, 2 as u32) != "1\u{202F}234\u{202F}567,89" { return 44 as i32 }
    if i18n.format_number("en", 0.125, 2 as u32) != "0.12" || i18n.format_number("en", 0.375, 2 as u32) != "0.38" { return 45 as i32 }
    if i18n.format_number("en", -0.001, 2 as u32) != "0.00" || i18n.format_number("en", 999.996, 2 as u32) != "1,000.00" { return 46 as i32 }
    if i18n.lang_parent("de-AT") != "de" || i18n.lang_parent("de") != "en-US" || i18n.lang_parent("en-GB") != "en-US" || i18n.lang_parent("en-US") != "" { return 47 as i32 }
    if i18n.pseudo_localize("Page {page:number}") != "[Þåĝé {page:number} on]" { return 48 as i32 }

    // --- E. refusals
    if refusal("@lang de\nkey = text\n", "de") != 0 { return 50 as i32 }
    if refusal("key = text\n", "") != 4 { return 51 as i32 } // no @lang
    if refusal("@lang de\n", "fr") != 4 { return 52 as i32 } // not the language asked for
    if refusal("@lang de\nKey = text\n", "") != 1 { return 53 as i32 } // capital letter in the key
    if refusal("@lang de\nkey text\n", "") != 1 { return 54 as i32 }
    if refusal("@lang de\nkey = {open\n", "") != 1 { return 55 as i32 }
    if refusal("@lang de\nkey = {x:money}\n", "") != 1 { return 56 as i32 }
    if refusal("@lang de\nkey = a \\q\n", "") != 1 { return 57 as i32 }
    if refusal("@lang de\nkey[one] = a\n", "") != 2 { return 58 as i32 }
    if refusal("@lang de\nkey = a\nkey = b\n", "") != 3 { return 59 as i32 }
    if refusal("@lang de\nkey = a\nkey[other] = b\n", "") != 3 { return 60 as i32 }
    if refusal("@lang de\n\n\nbad line\n", "") != 1 || i18n.catalog_error_line() != 4 as u32 { return 61 as i32 }
    return 42
}
