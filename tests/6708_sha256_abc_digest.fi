// expect_out: ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad
import std.rt
import std.crypto.sha256

fn main() -> i32 {
    var msg: [u8; 3] = "abc"
    var digest: [u8; 32] = [0; 32]
    var hex: [u8; 65] = [0; 65]
    var alphabet: [u8; 16] = "0123456789abcdef"
    sha256.sha256((&msg[0]) as u64, 3, (&digest[0]) as u64)
    var i: usize = 0
    while i < 32 {
        hex[i * 2] = alphabet[(digest[i] >> 4) as usize]
        hex[i * 2 + 1] = alphabet[(digest[i] & 15) as usize]
        i = i + 1
    }
    hex[64] = 10 as u8
    rt.write_everything(1, (&hex[0]) as u64, 65)
    return 0
}
