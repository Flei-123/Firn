// expect_exit: 0
// SQL function names are case-insensitive: COUNT(*), SUM(x), Avg(x) work like count/sum/avg.
import std.rt
import std.fs
import db.dberr
import db.dbcore as dc
import db.sqlite as sq

fn main() -> i32 {
    fs.remove("/tmp/firn_db_3731.db") catch false
    fs.remove("/tmp/firn_db_3731.db-journal") catch false
    let d: *mut dc.Db = sq.db_open("/tmp/firn_db_3731.db", sq.OPEN_CREATE) catch (0 as *mut dc.Db)
    if (d as u64) == 0 { return 1 }
    sq.db_exec(d, "CREATE TABLE t(a INTEGER)") catch false
    sq.db_exec(d, "INSERT INTO t VALUES (1),(2),(3)") catch false
    let c: i64 = sq.db_query_int(d, "SELECT COUNT(*) FROM t", -1) catch -2
    if c != 3 { return 2 }
    let s: i64 = sq.db_query_int(d, "SELECT SUM(a) FROM t", -1) catch -2
    if s != 6 { return 3 }
    let m: i64 = sq.db_query_int(d, "SELECT Max(a) FROM t", -1) catch -2
    if m != 3 { return 4 }
    let u: str = sq.db_query_text(d, "SELECT LOWER('AbC')") catch "ERR"
    if !u.equal("abc") { return 5 }
    sq.db_close(d)
    fs.remove("/tmp/firn_db_3731.db") catch false
    return 0
}
