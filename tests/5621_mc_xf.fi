// expect_exit: 0
import std.math
import mc.mc_xf

fn near(a: f64, b: f64) -> bool {
    return math.fabs(a - b) < 0.000001
}

fn main() -> i32 {
    var x: mc_xf.Xf = mc_xf.xf_ident()
    mc_xf.xf_rot_x(&x, 90.0)
    var o: [f64; 3] = [0.0; 3]
    mc_xf.xf_apply(&x, 0.0, 1.0, 0.0, &o)
    if !near(o[0], 0.0) || !near(o[1], 0.0) || !near(o[2], 1.0) { return 1 }
    var y: mc_xf.Xf = mc_xf.xf_ident()
    mc_xf.xf_translate(&y, 1.0, 2.0, 3.0)
    mc_xf.xf_rot_y(&y, 90.0)
    mc_xf.xf_apply(&y, 0.0, 0.0, 1.0, &o)
    if !near(o[0], 2.0) || !near(o[1], 2.0) || !near(o[2], 3.0) { return 2 }
    var z: mc_xf.Xf = mc_xf.xf_ident()
    mc_xf.xf_rot_z(&z, 90.0)
    mc_xf.xf_apply(&z, 1.0, 0.0, 0.0, &o)
    if !near(o[0], 0.0) || !near(o[1], 1.0) { return 3 }
    mc_xf.xf_scale(&z, 2.0)
    mc_xf.xf_apply(&z, 1.0, 0.0, 0.0, &o)
    if !near(o[1], 2.0) { return 4 }
    return 0
}
