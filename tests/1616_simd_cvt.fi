// expect_exit: 0
// tests/1616_simd_cvt.fi -- RUNDE TEMPO 5: wandeln, vergleichen, auswaehlen.
//
// `__v128_trunc_f32_i32` schneidet zur Null hin ab (wie `as i32` in Firn),
// `__v128_cvt_i32_f32` wandelt zurueck. Die drei Vergleiche liefern je Spur
// eine Maske aus lauter Einsen oder lauter Nullen; damit laesst sich mit
// `and`/`andnot`/`or` auswaehlen, ohne zu springen. Genau diese Kette
// braucht die Wandlung der Abtastwerte im Tondekoder.
//
// Wichtig ist der Unterschied zwischen `cmplt` und `cmpnlt`: bei NaN sind
// beide Vergleiche ungeordnet, und `cmpnlt` sagt dann WAHR. Der Test haelt
// das fest, damit die aarch64-Fassung (fcmgt + mvn) nicht davon abweicht.
fn main() -> i32 {
    var a: [f32; 4] = [1.75f, -2.25f, 3.0f, -0.5f]
    var r: [i32; 4] = [0; 4]
    let va: v128 = __v128_load(((&a[0]) as u64) as *u8)
    __v128_store(((&r[0]) as u64) as *mut u8, __v128_trunc_f32_i32(va))
    if r[0] != 1 { return 1 }
    if r[1] != -2 { return 2 }
    if r[2] != 3 { return 3 }
    if r[3] != 0 { return 4 }
    // zurueck
    var f: [f32; 4] = [0.0f; 4]
    let vi: v128 = __v128_load(((&r[0]) as u64) as *u8)
    __v128_store(((&f[0]) as u64) as *mut u8, __v128_cvt_i32_f32(vi))
    if f[0] != 1.0f { return 5 }
    if f[1] != -2.0f { return 6 }
    // Vergleiche als Maske
    var b: [f32; 4] = [2.0f, -2.25f, 0.0f, 100.0f]
    let vb: v128 = __v128_load(((&b[0]) as u64) as *u8)
    var m: [u32; 4] = [0; 4]
    __v128_store(((&m[0]) as u64) as *mut u8, __v128_cmplt_f32(va, vb))
    if m[0] != 4294967295 { return 7 }   // 1.75 < 2.0
    if m[1] != 0 { return 8 }            // -2.25 < -2.25 falsch
    if m[2] != 0 { return 9 }            // 3.0 < 0.0 falsch
    if m[3] != 4294967295 { return 10 }
    __v128_store(((&m[0]) as u64) as *mut u8, __v128_cmple_f32(va, vb))
    if m[1] != 4294967295 { return 11 }  // -2.25 <= -2.25
    __v128_store(((&m[0]) as u64) as *mut u8, __v128_cmpnlt_f32(va, vb))
    if m[0] != 0 { return 12 }
    if m[1] != 4294967295 { return 13 }
    // auswaehlen: (m & x) | (~m & y)
    var x: [i32; 4] = [10, 20, 30, 40]
    var y: [i32; 4] = [-1, -2, -3, -4]
    let vm: v128 = __v128_cmplt_f32(va, vb)
    let vx: v128 = __v128_load(((&x[0]) as u64) as *u8)
    let vy: v128 = __v128_load(((&y[0]) as u64) as *u8)
    __v128_store(((&r[0]) as u64) as *mut u8, __v128_or(__v128_and(vm, vx), __v128_andnot(vm, vy)))
    if r[0] != 10 { return 14 }
    if r[1] != -2 { return 15 }
    if r[2] != -3 { return 16 }
    if r[3] != 40 { return 17 }
    return 0
}
