gc class Cell {
    next: Gc[Cell],
    val: u64,
}

fn main() -> i32 {
    var c: Gc[Cell] = gc Cell { next: gc_null[Cell](), val: 7 } catch gc_null[Cell]()
    if c.val != 7 {
        return 1
    }
    if gc_cards_table() != 0 {
        return 2
    }
    if !gc_cards_enable() {
        return 3
    }
    let t: u64 = gc_cards_table()
    if t == 0 {
        return 4
    }
    if gc_cards_diag(0) != 1 {
        return 5
    }
    if *((t + 4095) as *mut u8) != 1 as u8 {
        return 6
    }
    if !gc_cards_enable() || gc_cards_table() != t {
        return 7
    }
    return 0
}
