gc class Tree {
    left: Gc[Tree],
    right: Gc[Tree],
    val: u64,
}

fn make(depth: u64, v: u64) -> Gc[Tree] {
    if depth == 0 {
        return gc Tree { left: gc_null[Tree](), right: gc_null[Tree](), val: v } catch gc_null[Tree]()
    }
    let l: Gc[Tree] = make(depth - 1, v * 2)
    let r: Gc[Tree] = make(depth - 1, v * 2 + 1)
    return gc Tree { left: l, right: r, val: v } catch gc_null[Tree]()
}

fn total(t: Gc[Tree], depth: u64) -> u64 {
    if depth == 0 {
        return t.val
    }
    return t.val + total(t.left, depth - 1) + total(t.right, depth - 1)
}

fn churn(n: u64) -> u64 {
    var s: u64 = 0
    var i: u64 = 0
    while i < n {
        let g: Gc[Tree] = gc Tree { left: gc_null[Tree](), right: gc_null[Tree](), val: 7 } catch gc_null[Tree]()
        s = s + g.val
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    gc_init()
    if gc_par_set(3, 0) == 0 {
        return 2
    }
    gc_par_min_set(1)
    let depth: u64 = 14
    let root: Gc[Tree] = make(depth, 1)
    let want: u64 = total(root, depth)
    var round: u64 = 0
    while round < 8 {
        if churn(100000) != 700000 {
            return 3
        }
        gc_collect()
        if total(root, depth) != want {
            return 1
        }
        round = round + 1
    }
    if gc_par_diag(0) == 0 {
        return 4
    }
    return 0
}
