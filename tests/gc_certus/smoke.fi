gc class Node {
    next: Gc[Node],
    val: u64,
}

fn build(n: u64) -> Gc[Node] {
    var head: Gc[Node] = gc_null[Node]()
    var i: u64 = 0
    while i < n {
        head = gc Node { next: head, val: i } catch gc_null[Node]()
        i = i + 1
    }
    return head
}

fn sum(h: Gc[Node], n: u64) -> u64 {
    var s: u64 = 0
    var p: Gc[Node] = h
    var i: u64 = 0
    while i < n {
        s = s + p.val
        p = p.next
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    gc_init()
    let keep: Gc[Node] = build(20000)
    gc_perm_seal(1)
    var r: u64 = 0
    while r < 20 {
        let t: Gc[Node] = build(5000)
        if sum(t, 5000) != 12497500 { return 3 }
        r = r + 1
    }
    gc_collect()
    if sum(keep, 20000) != 199990000 { return 1 }
    gc_set_step_hook(0, 0)
    return 0
}
