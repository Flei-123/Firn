// expect_exit: 0
// tests/2943_input_webpad_rumble.fi -- lib/input/webpad.fi rumble: webpad_rumble queues a request for the browser host
// (glweb.js plays it with gamepad.vibrationActuator). The host exports are plain Firn functions, so a native program
// plays the host's part: capability flag, request counter, magnitude scaling (0..1 -> 0..1000), clamping, duration
// limits, stop, and the cap going away with the pad.
import std.rt
import input.webpad

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn plug(slot: u32) {
    webpad.firn_pad_state(slot, 0 as u32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32, 0 as i32)
}

fn main() -> i32 {
    // no pad: no rumble, nothing queued
    check(!webpad.webpad_rumble_supported(0), 1)
    check(!webpad.webpad_rumble(0, 1.0, 1.0, 100 as u32), 2)
    check(webpad.firn_pad_rumble_seq(0 as u32) == 0 as u32, 3)

    // a pad without an actuator (the browser did not give one): honestly false
    plug(0 as u32)
    check(webpad.webpad_present(0) && !webpad.webpad_rumble_supported(0), 4)
    check(!webpad.webpad_rumble(0, 1.0, 1.0, 100 as u32), 5)

    // the host reports an actuator
    webpad.firn_pad_rumble_cap(0 as u32, 1 as u32)
    check(webpad.webpad_rumble_supported(0), 6)
    check(webpad.webpad_rumble(0, 0.8, 0.25, 300 as u32), 7)
    check(webpad.firn_pad_rumble_seq(0 as u32) == 1 as u32, 8)
    check(webpad.firn_pad_rumble_strong(0 as u32) == 800 && webpad.firn_pad_rumble_weak(0 as u32) == 250, 9)
    check(webpad.firn_pad_rumble_ms(0 as u32) == 300, 10)

    // clamping: below 0 and above 1; ms 0 / huge = the longest (65535)
    check(webpad.webpad_rumble(0, 0.0 - 3.0, 7.5, 0 as u32), 11)
    check(webpad.firn_pad_rumble_strong(0 as u32) == 0 && webpad.firn_pad_rumble_weak(0 as u32) == 1000, 12)
    check(webpad.firn_pad_rumble_ms(0 as u32) == 65535 && webpad.firn_pad_rumble_seq(0 as u32) == 2 as u32, 13)
    check(webpad.webpad_rumble(0, 0.5, 0.5, 4000000 as u32), 14)
    check(webpad.firn_pad_rumble_ms(0 as u32) == 65535, 15)
    check(webpad.webpad_rumble(0, 0.0004, 0.9996, 50 as u32), 16) // rounds to nearest per mille
    check(webpad.firn_pad_rumble_strong(0 as u32) == 0 && webpad.firn_pad_rumble_weak(0 as u32) == 1000, 17)

    // stop = both zero, duration 0, and the counter moves (the host calls reset())
    let before: u32 = webpad.firn_pad_rumble_seq(0 as u32)
    check(webpad.webpad_rumble_stop(0), 18)
    check(webpad.firn_pad_rumble_seq(0 as u32) == before + 1 as u32, 19)
    check(webpad.firn_pad_rumble_strong(0 as u32) == 0 && webpad.firn_pad_rumble_weak(0 as u32) == 0 && webpad.firn_pad_rumble_ms(0 as u32) == 0, 20)
    check(webpad.webpad_rumble(0, 0.0, 0.0, 500 as u32), 21) // 0/0 is a stop whatever the duration says
    check(webpad.firn_pad_rumble_ms(0 as u32) == 0, 22)

    // slots are independent; out-of-range slots are refused and the host getters answer 0
    plug(2 as u32)
    check(!webpad.webpad_rumble_supported(2), 23)
    webpad.firn_pad_rumble_cap(2 as u32, 1 as u32)
    check(webpad.webpad_rumble(2, 1.0, 0.0, 10 as u32), 24)
    check(webpad.firn_pad_rumble_seq(2 as u32) == 1 as u32 && webpad.firn_pad_rumble_seq(1 as u32) == 0 as u32, 25)
    check(!webpad.webpad_rumble(9, 1.0, 1.0, 10 as u32) && !webpad.webpad_rumble_supported(9), 26)
    check(webpad.firn_pad_rumble_seq(9 as u32) == 0 as u32 && webpad.firn_pad_rumble_strong(9 as u32) == 0, 27)
    webpad.firn_pad_rumble_cap(9 as u32, 1 as u32) // out of range: ignored, no crash

    // unplug: the capability goes with the pad, a replug does not bring it back until the host says so again
    webpad.firn_pad_gone(0 as u32)
    check(!webpad.webpad_rumble_supported(0) && !webpad.webpad_rumble(0, 1.0, 1.0, 10 as u32), 28)
    plug(0 as u32)
    check(!webpad.webpad_rumble_supported(0), 29)
    webpad.firn_pad_rumble_cap(0 as u32, 1 as u32)
    check(webpad.webpad_rumble_supported(0), 30)
    webpad.firn_pad_rumble_cap(0 as u32, 0 as u32)
    check(!webpad.webpad_rumble_supported(0), 31)

    // the counter keeps counting
    webpad.firn_pad_rumble_cap(0 as u32, 1 as u32)
    var i: i32 = 0
    while i < 300 {
        check(webpad.webpad_rumble(0, 0.1, 0.1, 10 as u32), 32)
        i = i + 1
    }
    check(webpad.firn_pad_rumble_seq(0 as u32) == (before + 1 as u32 + 1 as u32 + 300 as u32), 33)
    return 0
}
