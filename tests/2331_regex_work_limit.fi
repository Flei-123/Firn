// expect_exit: 0
// tests/2331_regex_work_limit.fi -- the work limit of lib/regex: a pattern
// with a lookahead can be quadratic, so a caller that matches untrusted text
// can cap the work of one find. Over the cap the find returns false and
// regex_exhausted() says why.
import regex.regex
import std.rt
import std.str

fn compile(p: str) -> regex.Regex {
    return regex.regex_compile(p, 0 as u32) catch | e | (never())
}

fn never() -> regex.Regex {
    syscall(60, 99, 0, 0, 0, 0, 0)
    return never()
}

fn as_str(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: rt.buf_len(b) }
}

fn main() -> i32 {
    var text: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 3000 {
        rt.buf_push(&text, 97 as u8)
        i = i + 1
    }
    var m: regex.Match = regex.match_new()

    // 1. no limit (the default): a quadratic scan that finishes, no match
    var r: regex.Regex = compile("(?=.*z)a")
    if regex.regex_find(&r, as_str(&text), 0, &m) { return 1 }
    if regex.regex_exhausted(&r) { return 2 }

    // 2. a small limit: abandoned, and the flag says so
    regex.regex_set_work_limit(&r, 100000)
    if regex.regex_find(&r, as_str(&text), 0, &m) { return 3 }
    if !regex.regex_exhausted(&r) { return 4 }

    // 3. the next find starts afresh: a short text with a 'z' is found
    if !regex.regex_find(&r, "aaaaz", 0, &m) { return 5 }
    if regex.regex_exhausted(&r) { return 6 }
    if m.start != 0 || m.end != 1 { return 7 }

    // 4. a big limit does not get in the way of the same long text
    regex.regex_set_work_limit(&r, 1000000000)
    if regex.regex_find(&r, as_str(&text), 0, &m) { return 8 }
    if regex.regex_exhausted(&r) { return 9 }

    // 5. without lookaround the limit is never used up
    var plain: regex.Regex = compile("a+b?")
    regex.regex_set_work_limit(&plain, 1)
    if !regex.regex_find(&plain, as_str(&text), 0, &m) { return 10 }
    if regex.regex_exhausted(&plain) { return 11 }

    // 6. a lookbehind (linear) with a limit that is enough
    var lb: regex.Regex = compile("(?<=a)b")
    regex.regex_set_work_limit(&lb, 1000)
    if !regex.regex_find(&lb, "xab", 0, &m) { return 12 }
    if regex.regex_exhausted(&lb) { return 13 }

    rt.buf_free(&text)
    return 0
}
