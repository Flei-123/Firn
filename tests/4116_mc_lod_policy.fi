// expect_exit: 0
import std.io
import mc.mc_lod_policy

fn check(name: str, view: i32, lod_env: i32, want_view: i32, want_lod: i32) -> bool {
    let p: mc_lod_policy.LodPlan = mc_lod_policy.lod_plan(view, lod_env)
    if p.view == want_view && p.lod == want_lod { return true }
    io.eprint_line(name)
    return false
}

fn main() -> i32 {
    var ok: bool = true
    ok = check("view 6 default", 6, mc_lod_policy.LOD_UNSET, 6, 0) && ok
    ok = check("view 8 default", 8, mc_lod_policy.LOD_UNSET, 8, 0) && ok
    ok = check("view 9 default", 9, mc_lod_policy.LOD_UNSET, 8, 9) && ok
    ok = check("view 16 default", 16, mc_lod_policy.LOD_UNSET, 8, 16) && ok
    ok = check("view 16 opt-out", 16, 0, 16, 0) && ok
    ok = check("view 3 explicit lod 9", 3, 9, 3, 9) && ok
    ok = check("view 12 explicit lod 20", 12, 20, 12, 20) && ok
    if ok { return 0 }
    return 1
}
