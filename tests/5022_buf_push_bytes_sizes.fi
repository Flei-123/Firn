// expect_exit: 0
import std.rt

fn fill(src: *mut u8, n: usize, seed: u32) {
    var i: usize = 0
    while i < n {
        *((src as u64 +% i as u64) as *mut u8) = (((i as u32) * 7 + seed) & 255) as u8
        i = i + 1
    }
}

fn main() -> i32 {
    var src: [u8; 96] = [0 as u8; 96]
    fill(&src[0], 96, 3)
    var bad: u32 = 0
    var n: usize = 0
    while n <= 70 {
        var off: usize = 0
        while off < 4 {
            var b: rt.Buf = rt.buf_new()
            rt.buf_push(&b, 200 as u8)
            rt.buf_push_bytes(&b, (&src[0]) as u64 + off as u64, n)
            rt.buf_push(&b, 201 as u8)
            if rt.buf_len(&b) != n + 2 { bad = bad + 1 }
            var i: usize = 0
            while i < n {
                if rt.ld8(rt.buf_ptr(&b), i + 1) != src[off + i] { bad = bad + 1 }
                i = i + 1
            }
            if rt.ld8(rt.buf_ptr(&b), 0) != 200 as u8 { bad = bad + 1 }
            if rt.ld8(rt.buf_ptr(&b), n + 1) != 201 as u8 { bad = bad + 1 }
            rt.buf_free(&b)
            off = off + 1
        }
        n = n + 1
    }
    var acc: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < 300 {
        rt.buf_push_bytes(&acc, (&src[0]) as u64, k % 40)
        k = k + 1
    }
    var total: usize = 0
    k = 0
    while k < 300 {
        total = total + k % 40
        k = k + 1
    }
    if rt.buf_len(&acc) != total { bad = bad + 1 }
    var pos: usize = 0
    k = 0
    while k < 300 {
        var j: usize = 0
        while j < k % 40 {
            if rt.ld8(rt.buf_ptr(&acc), pos + j) != src[j] { bad = bad + 1 }
            j = j + 1
        }
        pos = pos + k % 40
        k = k + 1
    }
    rt.buf_free(&acc)
    if bad == 0 {
        return 0
    }
    return 1
}
