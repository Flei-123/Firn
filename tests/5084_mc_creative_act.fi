// expect_exit: 0
import std.rt
import std.net
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_client
import mc.mc_inv
import mc.mc_creative
import mc.mc_creative_act
import mc.mc_creative_rules

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn id(r: *mut mc_registry.Registry, name: str) -> i32 {
    return mc_registry.reg_item_by_name(r, name.p as u64, name.n)
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 1)
    var reg: mc_registry.Registry = v.registry_of()
    var cc: net.Conn = net.conn_from_fd(0 - 1)
    var cl: mc_client.Client = mc_client.client_new(cc, v)
    var inv: mc_inv.Inv = mc_inv.inv_new()
    mc_inv.inv_use_registry(&inv, &reg)
    var cr: mc_creative.Creative = mc_creative.cr_new()
    check(mc_creative.cr_build(&cr, &reg), 2)
    mc_creative.cr_select(&cr, &reg, mc_creative_rules.TAB_BUILDING)
    let first: i32 = mc_creative.cr_item(&cr, 0)
    check(first >= 0, 3)
    mc_creative_act.cra_pick(&cr, &reg, &inv, 0, mc_creative_act.CRA_LEFT, false)
    check(mc_inv.inv_cursor_item(&inv) == first && mc_inv.inv_cursor_count(&inv) == 1, 4)
    mc_creative_act.cra_pick(&cr, &reg, &inv, 0, mc_creative_act.CRA_LEFT, false)
    mc_creative_act.cra_pick(&cr, &reg, &inv, 0, mc_creative_act.CRA_LEFT, false)
    check(mc_inv.inv_cursor_count(&inv) == 3, 5)
    mc_creative_act.cra_pick(&cr, &reg, &inv, 0, mc_creative_act.CRA_RIGHT, false)
    check(mc_inv.inv_cursor_count(&inv) == 2, 6)
    mc_creative_act.cra_pick(&cr, &reg, &inv, 0, mc_creative_act.CRA_LEFT, true)
    let mx: i32 = mc_registry.reg_item_stack(&reg, first)
    check(mc_inv.inv_cursor_count(&inv) == mx && mx > 1, 7)
    mc_creative_act.cra_slot(&cl, &reg, &inv, 36, mc_creative_act.CRA_LEFT, false)
    check(mc_inv.inv_item(&inv, 36) == first && mc_inv.inv_count(&inv, 36) == mx && mc_inv.inv_cursor_item(&inv) < 0, 8)
    mc_creative_act.cra_slot(&cl, &reg, &inv, 36, mc_creative_act.CRA_RIGHT, false)
    check(mc_inv.inv_cursor_count(&inv) == (mx + 1) / 2 && mc_inv.inv_count(&inv, 36) == mx / 2, 9)
    mc_creative_act.cra_slot(&cl, &reg, &inv, 37, mc_creative_act.CRA_RIGHT, false)
    check(mc_inv.inv_item(&inv, 37) == first && mc_inv.inv_count(&inv, 37) == 1, 10)
    mc_creative_act.cra_slot(&cl, &reg, &inv, 36, mc_creative_act.CRA_LEFT, false)
    check(mc_inv.inv_count(&inv, 36) == mx / 2 + (mx + 1) / 2 - 1 && mc_inv.inv_cursor_item(&inv) < 0, 11)
    mc_creative_act.cra_delete(&cl, &inv, false, false)
    check(mc_inv.inv_cursor_item(&inv) < 0, 12)
    mc_creative_act.cra_key_swap(&cl, &cr, &reg, &inv, 1, 4, false)
    check(mc_inv.inv_item(&inv, 40) == mc_creative.cr_item(&cr, 1) && mc_inv.inv_count(&inv, 40) > 0, 13)
    mc_creative_act.cra_pick(&cr, &reg, &inv, 0, mc_creative_act.CRA_MIDDLE, false)
    check(mc_inv.inv_cursor_count(&inv) == mx, 14)
    mc_creative_act.cra_pick(&cr, &reg, &inv, 1, mc_creative_act.CRA_LEFT, false)
    check(mc_inv.inv_cursor_item(&inv) < 0, 15)
    mc_creative_act.cra_pick(&cr, &reg, &inv, 0, mc_creative_act.CRA_LEFT, false)
    mc_creative_act.cra_outside(&cl, &inv, mc_creative_act.CRA_LEFT, false)
    check(mc_inv.inv_cursor_item(&inv) < 0, 16)
    mc_creative_act.cra_delete(&cl, &inv, true, false)
    check(mc_inv.inv_item(&inv, 36) < 0 && mc_inv.inv_item(&inv, 40) < 0, 17)
    mc_creative.cr_free(&cr)
    return 0
}
