// expect_exit: 0
// firnc1_skip: generic library modules (std.dict, regex.regex) are stage 0 only
// tests/3764_import_order_generics.fi -- the result must not depend on the
// import order: std.dict is imported BEFORE regex.regex, and both use the same
// generic instances (vec_push[str], vec_set[u8]). The first sighting of an
// instance inside a generic template used to hide the later concrete use
// ("unknown function 'vec_set__u8'").
import std.io
import std.rt
import std.dict
import regex.regex
import std.str
import std.vec
import std.testkit

fn never() -> regex.Regex {
    return regex.regex_compile("", 0 as u32) catch | f | (never())
}

fn compile(p: str) -> regex.Regex {
    return regex.regex_compile(p, 0 as u32) catch | e | (never())
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var d: Dict[i32] = dict_new[i32]()
    defer dict_free[i32](&d)
    dict_set[i32](&d, "a", 1)
    dict_inc[i32](&d, "a", 2)
    testkit.check(dict_get_or[i32](&d, "a", 0) == 3, "dict value")
    var rr: regex.Regex = compile("a+b")
    testkit.check(regex.regex_is_match(&rr, "caab"), "regex match")
    testkit.check(!regex.regex_is_match(&rr, "cb"), "regex no match")
    var v: Vec[str] = vec_new[str]()
    vec_push[str](&v, "x")
    testkit.check(vec_len[str](&v) == 1, "vec_push str")
    vec_free[str](&v)
    var u: Vec[u8] = vec_new[u8]()
    vec_push[u8](&u, 7 as u8)
    vec_set[u8](&u, 0, 9 as u8)
    testkit.check(vec_at[u8](&u, 0) == 9 as u8, "vec_set u8")
    vec_free[u8](&u)
    return testkit.finish()
}
