// expect_exit: 0
// tests/4842_shellproto_layout.fi -- lib/window/shellproto: block offsets do not overlap, the title area fits, the pool fits in the block, give_back puts a pointer on the free channel.
import std.rt
import chan.chan
import window.shellproto

fn check(c: bool, code: i64) {
    if !c {
        rt.finish(code)
    }
}

fn main() -> i32 {
    check(shellproto.B_TITLE + shellproto.TITLE_MAX / 8 == shellproto.B_WIN, 1)
    check(shellproto.B_WORDS == shellproto.B_POOL, 2)
    check(shellproto.B_POOL + (shellproto.MAX_BUFS as usize) * shellproto.POOL_ENTRY <= shellproto.B_SEQ, 3)
    check(shellproto.B_HWND < shellproto.B_TOTAL && shellproto.B_SEQ < shellproto.B_HWND, 4)
    check(shellproto.CMD_WORDS * 8 >= 16 + shellproto.TITLE_MAX, 5)
    let blk: u64 = rt.heap_alloc(shellproto.B_TOTAL * 8)
    rt.mem_set(blk, 0 as u8, shellproto.B_TOTAL * 8)
    var fr: chan.Chan = chan.chan_new(4, shellproto.FREE_WORDS as u64)
    shellproto.sh_put(blk, shellproto.B_FREE, fr.blk)
    shellproto.give_back(blk, 4242)
    var rec: [u64; 2] = [0; 2]
    var c: chan.Chan = shellproto.sh_chan(blk, shellproto.B_FREE)
    check(chan.chan_try_recv(&c, &rec[0]), 6)
    check(rec[0] == 4242, 7)
    check(!chan.chan_try_recv(&c, &rec[0]), 8)
    chan.chan_free(&c)
    rt.heap_free(blk, shellproto.B_TOTAL * 8)
    return 0
}
