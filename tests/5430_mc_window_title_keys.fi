// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_inv
import mc.mc_item_names
import mc.mc_title_keys

fn open_with_title(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, typ: i32, json: str) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, 3)
    bytes.put_varint(&b, typ)
    bytes.put_string(&b, json.p as u64, json.n)
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_open_window_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn title_is(v: *mut mc_inv.Inv, want: str) -> bool {
    var n: usize = 0
    let p: u64 = mc_inv.inv_window_title(v, &n)
    return n == want.n && rt.mem_eq(p, want.p as u64, n)
}

fn main() -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &ver) { return 100 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    if !open_with_title(&v, &ver, 12, "{\"translate\":\"container.enchant\"}") { return 101 }
    if !title_is(&v, "Enchant") { return 102 }
    if !open_with_title(&v, &ver, 8, "{\"translate\":\"container.repair\"}") { return 103 }
    if !title_is(&v, "Repair & Name") { return 104 }
    if !open_with_title(&v, &ver, 11, "{\"translate\":\"container.brewing\"}") { return 105 }
    if !title_is(&v, "Brewing Stand") { return 106 }
    if !open_with_title(&v, &ver, 2, "{\"translate\":\"container.grindstone_title\"}") { return 107 }
    if !title_is(&v, "Repair & Disenchant") { return 108 }
    if !open_with_title(&v, &ver, 2, "{\"text\":\"My Chest\"}") { return 109 }
    if !title_is(&v, "My Chest") { return 110 }
    if !open_with_title(&v, &ver, 2, "{\"translate\":\"unknown.key.x\"}") { return 111 }
    if !title_is(&v, "unknown.key.x") { return 112 }
    let lang: str = "{\"container.enchant\":\"Verzaubern\"}"
    if !mc_item_names.names_load(lang.p as u64, lang.n) { return 113 }
    if !open_with_title(&v, &ver, 12, "{\"translate\":\"container.enchant\"}") { return 114 }
    if !title_is(&v, "Verzaubern") { return 115 }
    mc_item_names.names_release()
    if mc_title_keys.tk_builtin("container.stonecutter".p as u64, "container.stonecutter".n).n == 0 { return 116 }
    return 0
}
