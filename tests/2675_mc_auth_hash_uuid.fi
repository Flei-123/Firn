// expect_exit: 0
// tests/2675_mc_auth_hash_uuid.fi -- server hash, offline UUID, UUID text forms and the
// session-join argument checks of lib/mc/mc_auth.fi. Vectors from python hashlib / uuid / md5.
// (The network half is tools/mc/auth/run.sh against a local mock; nothing here opens a socket.)
import std.rt
import std.str
import mc.mc_auth

fn hexval(c: u8) -> u8 {
    if c >= 97 as u8 {
        return c - 87 as u8
    }
    return c - 48 as u8
}

fn unhex(s: str, out: *mut rt.Buf) {
    var i: usize = 0
    while i + 1 < s.length() {
        rt.buf_push(out, (hexval(s.chars(i)) << 4 as u8) | hexval(s.chars(i + 1)))
        i = i + 2
    }
}

fn same(b: *mut rt.Buf, want: str) -> bool {
    if rt.buf_len(b) != want.length() {
        return false
    }
    var i: usize = 0
    while i < want.length() {
        if rt.buf_at(b, i) != want.chars(i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn dig(hex: str, want: str) -> bool {
    var d: rt.Buf = rt.buf_new()
    unhex(hex, &d)
    var out: rt.Buf = rt.buf_new()
    mc_auth.digest_to_signed_hex(rt.buf_ptr(&d), &out)
    return same(&out, want)
}

fn shash(sid: str, sec: str, key: str, want: str) -> bool {
    var s: rt.Buf = rt.buf_new()
    var k: rt.Buf = rt.buf_new()
    unhex(sec, &s)
    unhex(key, &k)
    var out: rt.Buf = rt.buf_new()
    mc_auth.server_hash(sid.p as u64, sid.length(), rt.buf_ptr(&s), rt.buf_len(&s),
        rt.buf_ptr(&k), rt.buf_len(&k), &out)
    return same(&out, want)
}

fn uu(name: str, want: str) -> bool {
    var u: [u8; 16] = [0; 16]
    if !mc_auth.offline_uuid(name.p as u64, name.length(), (&u[0]) as u64) {
        return false
    }
    var out: rt.Buf = rt.buf_new()
    mc_auth.uuid_to_text((&u[0]) as u64, true, &out)
    if !same(&out, want) {
        return false
    }
    // parse the dashed text back, print without dashes, parse that too
    var back: [u8; 16] = [0; 16]
    if !mc_auth.uuid_from_text(rt.buf_ptr(&out), rt.buf_len(&out), (&back[0]) as u64) {
        return false
    }
    if !rt.mem_eq((&back[0]) as u64, (&u[0]) as u64, 16) {
        return false
    }
    var plain: rt.Buf = rt.buf_new()
    mc_auth.uuid_to_text((&u[0]) as u64, false, &plain)
    return rt.buf_len(&plain) == 32 && mc_auth.uuid_from_text(rt.buf_ptr(&plain), 32, (&back[0]) as u64)
}

fn main() -> i32 {
    // ---- signed hex of ready digests: zero, -1, minimum, one, short positives/negatives
    if !dig("0000000000000000000000000000000000000000", "0") { return 10 as i32 }
    if !dig("ffffffffffffffffffffffffffffffffffffffff", "-1") { return 11 as i32 }
    if !dig("8000000000000000000000000000000000000000", "-8000000000000000000000000000000000000000") { return 12 as i32 }
    if !dig("0000000000000000000000000000000000000001", "1") { return 13 as i32 }
    if !dig("0faaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "faaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa") { return 14 as i32 }
    if !dig("f055555555555555555555555555555555555555", "-faaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab") { return 15 as i32 }
    if !dig("fffffffffffffffffffffffffffffffffffffffe", "-2") { return 16 as i32 }
    if !dig("7fffffffffffffffffffffffffffffffffffffff", "7fffffffffffffffffffffffffffffffffffffff") { return 17 as i32 }
    // ---- the well known strings (python value for jeb_, see docs/mc/auth.md)
    if !shash("Notch", "", "", "4ed1f46bbe04bc756bcb17c0c7ce3e4632f06a48") { return 20 as i32 }
    if !shash("jeb_", "", "", "-7c9d5b0044c130109a5d7b5fb5c317c02b4e28c1") { return 21 as i32 }
    if !shash("simon", "", "", "88e16a1019277b15d58faf0541e11910eb756f6") { return 22 as i32 }
    if !shash("Notch", "", "", "4ed1f46bbe04bc756bcb17c0c7ce3e4632f06a48") { return 30 as i32 }
    if !shash("", "000102030405060708090a0b0c0d0e0f", "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f505152535455565758595a5b5c5d5e5f60616263", "63a070ed4df4ec66072a4533d8ea4627121d11bb") { return 31 as i32 }
    if !shash("abc", "01010101010101010101010101010101", "020202", "7b2f1b0658ab9b9252c58f1e208230dfb8253818") { return 32 as i32 }
    // ---- offline UUIDs
    if !uu("Notch", "b50ad385-829d-3141-a216-7e7d7539ba7f") { return 50 as i32 }
    if !uu("jeb_", "a762f560-4fce-3236-812a-b80efff0b62b") { return 51 as i32 }
    if !uu("a", "52428a0e-1e30-3cb1-976c-e728b2614047") { return 52 as i32 }
    if !uu("Player_12345678", "093afc8c-b218-3bc3-b5ed-7b511c19f66b") { return 53 as i32 }
    if !uu("Steve", "5627dd98-e6be-3c21-b8a8-e92344183641") { return 54 as i32 }
    // ---- UUID text edge cases
    var tmp: [u8; 16] = [0; 16]
    var bad1: str = "069a79f444e94726a5befca90e38aaf"
    var bad2: str = "069a79f4-44e9-4726-a5be-fca90e38aaf55"
    var bad3: str = "069a79f4x44e9-4726-a5be-fca90e38aaf5"
    var bad4: str = "069a79f444e94726a5befca90e38aafg"
    var good: str = "069A79F444E94726A5BEFCA90E38AAF5"
    if mc_auth.uuid_from_text(bad1.p as u64, bad1.length(), (&tmp[0]) as u64) { return 60 as i32 }
    if mc_auth.uuid_from_text(bad2.p as u64, bad2.length(), (&tmp[0]) as u64) { return 61 as i32 }
    if mc_auth.uuid_from_text(bad3.p as u64, bad3.length(), (&tmp[0]) as u64) { return 62 as i32 }
    if mc_auth.uuid_from_text(bad4.p as u64, bad4.length(), (&tmp[0]) as u64) { return 63 as i32 }
    if !mc_auth.uuid_from_text(good.p as u64, good.length(), (&tmp[0]) as u64) { return 64 as i32 }
    if tmp[0] != 6 as u8 || tmp[15] != 245 as u8 { return 65 as i32 }
    var empty: [u8; 1] = [0; 1]
    if mc_auth.offline_uuid((&empty[0]) as u64, 0, (&tmp[0]) as u64) { return 66 as i32 }

    // ---- join body escaping + argument / config refusals (no socket is opened)
    var b: rt.Buf = rt.buf_new()
    mc_auth.join_body("t\"k\\n", "p", "-1a", &b)
    if !same(&b, "{\"accessToken\":\"t\\\"k\\\\n\",\"selectedProfile\":\"p\",\"serverId\":\"-1a\"}") { return 70 as i32 }
    var c: mc_auth.SessionClient = mc_auth.session_new()
    if !mc_auth.session_init(&c) { return 71 as i32 }
    let pid: str = "069a79f444e94726a5befca90e38aaf5"
    if mc_auth.session_join(&c, "", pid, "1a") != mc_auth.JOIN_ARG { return 72 as i32 }
    if mc_auth.session_join(&c, "t", "nothex", "1a") != mc_auth.JOIN_ARG { return 73 as i32 }
    if mc_auth.session_join(&c, "t", pid, "-") != mc_auth.JOIN_ARG { return 74 as i32 }
    if mc_auth.session_join(&c, "t", pid, "xyz") != mc_auth.JOIN_ARG { return 75 as i32 }
    mc_auth.session_set_base(&c, "http://example.com")
    if mc_auth.session_join(&c, "t", pid, "1a") != mc_auth.JOIN_CONFIG { return 76 as i32 }
    mc_auth.session_set_base(&c, "ftp://127.0.0.1")
    if mc_auth.session_join(&c, "t", pid, "1a") != mc_auth.JOIN_CONFIG { return 77 as i32 }
    if mc_auth.session_status(&c) != 0 as u32 { return 78 as i32 }
    mc_auth.session_free(&c)
    return 0
}
