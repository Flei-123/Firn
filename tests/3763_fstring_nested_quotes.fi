// expect_out: [name] [{}] 7
// r664: a text literal may stand inside `{ ... }` of an f-string, braces in it
// included. firnfmt knows the rule too (r708): the blanks inside the nested
// literals stay as written (tools/fmt/cases/fstring_nested).
import std.io

fn pick(a: str, b: str, which: i32) -> str {
    if which == 0 { return a }
    return b
}

fn main() -> i32 {
    let n: i32 = 7
    io.print_line(io.fmt_string(f"[{pick("name", "{}", 0)}] [{pick("name", "{}", 1)}] {n}"))
    return 0
}
