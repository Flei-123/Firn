// expect_out: ok
// r935: compound assignments inside the range, bit operations and shifts, and the explicit wrapping spelling stay unchecked-compatible.
import std.io

fn main() -> i32 {
    var a: i32 = 2147483646
    a += 1
    var b: u8 = 255
    b -= 255
    var c: i64 = 3037000499
    c *= c
    var d: u32 = 7
    d++
    d--
    d <<= 3
    d >>= 1
    d ^= 5
    d |= 64
    d &= 127
    var e: i32 = 100
    e /= 7
    e %= 5
    var s: u8 = 250
    s = s +% 10
    var w: u8 = 250
    w = w -% 255
    if a == 2147483647 && b == 0 && c == 9223372030926249001 && d == 89 && e == 4 && s == 4 && w == 251 {
        io.fmt_print_line(f"ok")
        return 0
    }
    io.fmt_print_line(f"bad {a} {b} {c} {d} {e} {s} {w}")
    return 1
}
