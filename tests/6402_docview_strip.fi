// expect_exit: 0
import std.rt
import std.vec
import std.testkit
import docview.registry
import docview.lazy
import docview.dvdoc
import docview.kinds
import docview.dvstrip
import docview.search
import docview.pagecache

static mut renders: i32 = 0

fn fk_open(p: u64, n: usize) -> u64 { return 1 }
fn fk_pages(h: u64) -> usize { return 5 }
fn fk_size(h: u64, page: usize, w: *mut i32, hh: *mut i32) -> bool {
    *w = 100
    *hh = 200
    if page == 2 { *w = 150 }
    return true
}
fn fk_render(h: u64, page: usize, scale: f64, out: *mut rt.Buf, w: *mut i32, hh: *mut i32) -> bool {
    renders = renders + 1
    rt.buf_push(out, page as u8)
    *w = 1
    *hh = 1
    return true
}
fn fk_text(h: u64, page: usize, out: *mut rt.Buf) -> bool {
    if page == 1 { rt.buf_push_bytes(out, "Hello hello HELLO".p as u64, 17) }
    if page == 3 { rt.buf_push_bytes(out, "say hello".p as u64, 9) }
    return true
}

fn open_fake() -> dvdoc.Doc {
    registry.registry_reset()
    lazy.lazy_reset()
    var o: registry.DocOps = registry.ops_empty()
    o.open = fk_open
    o.pages = fk_pages
    o.page_size = fk_size
    o.render = fk_render
    o.text = fk_text
    registry.register("fk", kinds.KIND_PDF, o)
    return dvdoc.doc_open_kind("x".p as u64, 1, kinds.KIND_PDF)
}

#[test]
fn strip_positions() {
    var d: dvdoc.Doc = open_fake()
    var s: dvstrip.Strip = dvstrip.strip_new()
    dvstrip.strip_build(&d, 1.0, 10.0, 20.0, &s)
    testkit.assert_eq_i64(dvstrip.strip_y_of(&s, 0) as i64, 20)
    testkit.assert_eq_i64(dvstrip.strip_y_of(&s, 1) as i64, 230)
    testkit.assert_eq_i64(s.total as i64, 20 + 5 * 200 + 4 * 10 + 20)
    testkit.assert_eq_i64(s.maxw as i64, 150)
    dvstrip.strip_build(&d, 2.0, 10.0, 20.0, &s)
    testkit.assert_eq_i64(dvstrip.strip_y_of(&s, 1) as i64, 20 + 400 + 10)
    dvstrip.strip_free(&s)
    dvdoc.doc_free(&d)
}

#[test]
fn strip_visible_range() {
    var d: dvdoc.Doc = open_fake()
    var s: dvstrip.Strip = dvstrip.strip_new()
    dvstrip.strip_build(&d, 1.0, 10.0, 20.0, &s)
    var a: usize = 0
    var b: usize = 0
    testkit.assert_true(dvstrip.strip_visible(&s, 0.0, 100.0, &a, &b), "vis")
    testkit.assert_eq_i64(a as i64, 0)
    testkit.assert_eq_i64(b as i64, 0)
    dvstrip.strip_visible(&s, 500.0, 300.0, &a, &b)
    testkit.assert_eq_i64(a as i64, 2)
    testkit.assert_eq_i64(b as i64, 3)
    testkit.assert_eq_i64(dvstrip.strip_page_at(&s, 99999.0) as i64, 4)
    dvstrip.strip_free(&s)
    dvdoc.doc_free(&d)
}

#[test]
fn fit_width_and_clamp() {
    var d: dvdoc.Doc = open_fake()
    let z: f64 = dvstrip.strip_fit_zoom(&d, 324.0, 12.0)
    testkit.assert_eq_i64((z * 1000.0) as i64, 1.0 as i64 * 2000)
    testkit.assert_true(dvstrip.strip_clamp_zoom(100.0) == dvstrip.ZOOM_MAX, "max")
    testkit.assert_true(dvstrip.strip_clamp_zoom(0.0) == dvstrip.ZOOM_MIN, "min")
    dvdoc.doc_free(&d)
}

#[test]
fn search_is_case_insensitive_and_ordered() {
    var d: dvdoc.Doc = open_fake()
    var hits: Vec[search.Hit] = vec_new[search.Hit]()
    testkit.assert_eq_i64(search.search_run(&d, "HELLO", &hits) as i64, 4)
    testkit.assert_eq_i64((*vec_elem_ptr[search.Hit](&hits, 3)).page as i64, 3)
    testkit.assert_eq_i64(search.hit_after(&hits, 1, 0) as i64, 1)
    testkit.assert_eq_i64(search.hit_after(&hits, 3, 100) as i64, 0)
    testkit.assert_eq_i64(search.hit_before(&hits, 1, 0) as i64, 3)
    testkit.assert_eq_i64(search.hit_before(&hits, 3, 100) as i64, 3)
    testkit.assert_eq_i64(search.search_run(&d, "", &hits) as i64, 0)
    testkit.assert_eq_i64(search.search_run(&d, "zzz", &hits) as i64, 0)
    vec_free[search.Hit](&hits)
    dvdoc.doc_free(&d)
}

#[test]
fn cache_hits_and_evicts() {
    var d: dvdoc.Doc = open_fake()
    renders = 0
    var c: pagecache.PageCache = pagecache.cache_new(2)
    testkit.assert_true((pagecache.cache_get(&c, &d, 0, 1.0) as u64) != 0, "e0")
    pagecache.cache_get(&c, &d, 0, 1.0)
    testkit.assert_eq_i64(renders as i64, 1)
    pagecache.cache_get(&c, &d, 1, 1.0)
    pagecache.cache_get(&c, &d, 0, 1.0)
    pagecache.cache_get(&c, &d, 2, 1.0)
    testkit.assert_eq_i64(pagecache.cache_count(&c) as i64, 2)
    testkit.assert_eq_i64(renders as i64, 3)
    pagecache.cache_get(&c, &d, 1, 1.0)
    testkit.assert_eq_i64(renders as i64, 4)
    pagecache.cache_get(&c, &d, 0, 2.0)
    testkit.assert_eq_i64(renders as i64, 5)
    pagecache.cache_free(&c)
    dvdoc.doc_free(&d)
}
