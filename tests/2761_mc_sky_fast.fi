// expect_exit: 0
// tests/2761_mc_sky_fast.fi -- mc_sky: the fast background pass (row bisection, glow shortcut, disc boxes) must give exactly the
// pixels of the plain model (sky_draw_plain) on random scenes: any time of day, rain, yaw / pitch, lens 20..170 degrees, odd sizes.
import std.rt
import mc.mc_camera
import mc.mc_raster
import mc.mc_sky

struct Rng { s: u64 }

fn next(r: *mut Rng) -> u64 {
    (*r).s = ((*r).s * 1103515245 as u64 + 12345 as u64) % (2147483648 as u64)
    return (*r).s >> 4 as u64
}

fn frac(r: *mut Rng) -> f64 {
    return ((next(r) % (1000000 as u64)) as f64) / 1000000.0
}

fn diff_pixels(a: *mut mc_raster.Raster, b: *mut mc_raster.Raster) -> i64 {
    var n: i64 = 0
    var i: usize = 0
    let total: usize = ((*a).w as usize) * ((*a).h as usize)
    while i < total {
        if rt.ld32((*a).color, i) != rt.ld32((*b).color, i) { n = n + 1 }
        i = i + 1
    }
    return n
}

fn main() -> i32 {
    var rng: Rng = Rng { s: 12345 as u64 }
    var s: mc_sky.Sky = mc_sky.sky_new()
    var bad: i64 = 0
    var scene: i32 = 0
    while scene < 120 {
        let w: i32 = 64 + (next(&rng) % (300 as u64)) as i32
        let h: i32 = 48 + (next(&rng) % (200 as u64)) as i32
        var cam: mc_camera.Camera = mc_camera.camera_new(w, h)
        var a: mc_raster.Raster = mc_raster.raster_new(w, h)
        var b: mc_raster.Raster = mc_raster.raster_new(w, h)
        // ticks: half of the scenes near sunrise / sunset (glow), the rest anywhere; rain in a quarter
        var ticks: i64 = (next(&rng) % (24000 as u64)) as i64
        if scene % 2 == 0 {
            let base: i64 = if scene % 4 == 0 { 0 as i64 } else { 12000 as i64 }
            ticks = base + ((next(&rng) % (3000 as u64)) as i64) - 1500 as i64
        }
        var rain: i32 = 0
        if scene % 4 == 1 { rain = (next(&rng) % (257 as u64)) as i32 }
        mc_sky.sky_set_time(&s, ticks, rain)
        mc_camera.camera_set_pos(&cam, 0.0, 0.0, 0.0)
        mc_camera.camera_set_angles(&cam, frac(&rng) * 360.0, frac(&rng) * 180.0 - 90.0)
        mc_camera.camera_set_lens(&cam, 20.0 + frac(&rng) * 150.0, 0.05, 512.0)
        mc_camera.camera_update(&cam)
        mc_raster.raster_set_camera(&a, &cam)
        mc_raster.raster_set_camera(&b, &cam)
        mc_sky.sky_draw(&s, &a)
        mc_sky.sky_draw_plain(&s, &b)
        bad = bad + diff_pixels(&a, &b)
        mc_raster.raster_free(&a)
        mc_raster.raster_free(&b)
        scene = scene + 1
    }
    if bad != 0 as i64 { return 1 }
    return 0
}
