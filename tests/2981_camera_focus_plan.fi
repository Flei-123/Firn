// expect_out: ok
// tests/2981_camera_focus_plan.fi -- plat.android.focusplan: focus_plan (near to far, count adapts,
// fixed-focus lens = no plan). The camera itself needs a device (tools/android).
import std.io
import plat.android.focusplan

fn main() -> i32 {
    var out: [f32; 16] = [0.0f; 16]
    let p: u64 = (&out[0]) as u64
    // fixed focus lens: no plan
    if focusplan.focus_plan(0.0f, 0.0f, 0.0f, 8, p) != 0 { io.print("fixed focus"); return 1 }
    // far >= near: no plan
    if focusplan.focus_plan(2.0f, 3.0f, 0.5f, 8, p) != 0 { io.print("far>=near"); return 2 }
    // 10 dpt (10 cm) to infinity, step 2.5: 5 positions, first near, last far
    let n: i32 = focusplan.focus_plan(10.0f, 0.0f, 2.5f, 16, p)
    if n != 5 { io.print("count"); return 3 }
    if out[0] != 10.0f || out[4] != 0.0f { io.print("ends"); return 4 }
    var i: usize = 1
    while i < 5 {
        if !(out[i] < out[i - 1]) { io.print("order"); return 5 }
        i = i + 1
    }
    // nmax caps the count
    if focusplan.focus_plan(10.0f, 0.0f, 0.1f, 6, p) != 6 { io.print("cap"); return 6 }
    // default step (0) = near/4 -> 4 intervals + 1
    if focusplan.focus_plan(8.0f, 0.0f, 0.0f, 16, p) != 5 { io.print("default step"); return 7 }
    io.print("ok")
    return 0
}
