// expect_exit: 0
// tests/2944_promote_spin_wait.fi -- r489: a loop that WAITS for memory another thread changes must keep its load
// in the loop (compiler/src/promote.rs polls_cell). Without it release-fast loaded the flag once in front of the
// loop and the wait never ended. Every wait here is bounded (LIMIT rounds) so that a miscompiled wait FAILS
// instead of hanging; the writer thread sets the flags after a short sleep.
import std.rt

const LIMIT: u64 = 3000000000

struct Shared {
    flag: u32,
    other: u32,
    byte: u8,
    step: u32,
    flag2: u32,
    other2: u32,
}

// the writer raises them one after the other, 30 ms apart: each wait starts while its own flag is still 0
static mut G_PTR: u32 = 0
static mut G_FLAG: u32 = 0
static mut G_SH: Shared = Shared { flag: 0, other: 0, byte: 0 as u8, step: 0, flag2: 0, other2: 0 }
static mut G_DONE: u32 = 0

fn wait_ptr(p: *mut u32) -> u64 {
    var n: u64 = 0
    while (*p) == 0 as u32 && n < LIMIT {
        n = n + 1
    }
    return n
}

fn wait_global() -> u64 {
    var n: u64 = 0
    while G_FLAG == 0 as u32 && n < LIMIT {
        n = n + 1
    }
    return n
}

fn wait_field(s: *mut Shared) -> u64 {
    var n: u64 = 0
    while (*s).flag == 0 as u32 && n < LIMIT {
        n = n + 1
    }
    return n
}

fn wait_byte(s: *mut Shared) -> u64 {
    var n: u64 = 0
    while (*s).byte == 0 as u8 && n < LIMIT {
        n = n + 1
    }
    return n
}

// the waited-for value is compared with a number that changes in an OUTER loop
fn wait_steps(s: *mut Shared) -> u64 {
    var want: u32 = 1 as u32
    var total: u64 = 0
    while want <= 3 as u32 {
        var n: u64 = 0
        while (*s).step < want && n < LIMIT {
            n = n + 1
        }
        if n >= LIMIT {
            return LIMIT
        }
        total = total + n
        want = want + 1 as u32
    }
    return total
}

// waiting while another field is also read in the loop (the exit test reads two cells of the structure)
fn wait_two(s: *mut Shared) -> u64 {
    var n: u64 = 0
    while (*s).flag2 == 0 as u32 && (*s).other2 == 0 as u32 && n < LIMIT {
        n = n + 1
    }
    return n
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    thread_sleep(30)
    G_PTR = 1 as u32
    thread_sleep(30)
    G_FLAG = 1 as u32
    thread_sleep(30)
    G_SH.flag = 1 as u32
    thread_sleep(30)
    G_SH.byte = 1 as u8
    thread_sleep(30)
    G_SH.other2 = 1 as u32
    var i: u32 = 1 as u32
    while i <= 3 as u32 {
        thread_sleep(30)
        G_SH.step = i
        i = i + 1 as u32
    }
    G_DONE = 1 as u32
    return 0
}

fn main() -> i32 {
    let h: u64 = thread_start(1, 0)
    if h == 0 { return 1 }
    if wait_ptr(&G_PTR) >= LIMIT { return 2 }
    if wait_global() >= LIMIT { return 3 }
    if wait_field(&G_SH) >= LIMIT { return 4 }
    if wait_byte(&G_SH) >= LIMIT { return 5 }
    if wait_two(&G_SH) >= LIMIT { return 6 }
    if wait_steps(&G_SH) >= LIMIT { return 7 }
    thread_wait(h)
    if G_DONE != 1 as u32 { return 8 }
    return 0
}
