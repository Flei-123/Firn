// expect_exit: 0
import std.str

fn check(a: str, b: str, want: i32) -> i32 {
    var bad: i32 = 0
    if str.compare(a, b) != want {
        bad = bad + 1
    }
    if str.compare(b, a) != 0 - want {
        bad = bad + 1
    }
    return bad
}

fn main() -> i32 {
    var bad: i32 = 0
    bad = bad + check("", "", 0)
    bad = bad + check("", "a", 0 - 1)
    bad = bad + check("abcdefgh", "abcdefgh", 0)
    bad = bad + check("abcdefgh", "abcdefgi", 0 - 1)
    bad = bad + check("abcdefghi", "abcdefgh", 1)
    bad = bad + check("abcdefghabcdefgh", "abcdefghabcdefgh", 0)
    bad = bad + check("abcdefghabcdefgh", "abcdefghabcdefgx", 0 - 1)
    bad = bad + check("abcdefghabcdefghz", "abcdefghabcdefgh", 1)
    bad = bad + check("abcdefghabcdefghabc", "abcdefghabcdefghabd", 0 - 1)
    bad = bad + check("abcdefg", "abcdefgh", 0 - 1)
    bad = bad + check("xbcdefghabcdefgh", "abcdefghabcdefgh", 1)
    bad = bad + check("abcdefgxabcdefgh", "abcdefghabcdefgh", 1)
    bad = bad + check("é", "e", 1)
    bad = bad + check("abcdefghé", "abcdefghz", 1)
    bad = bad + check("abcdefghabcdefghabcdefgh1", "abcdefghabcdefghabcdefgh", 1)
    return bad
}
