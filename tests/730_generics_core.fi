// expect_exit: 0
// GENERISCHE VORLAGEN IN DER KERNSPRACHE — der Test zur Runde, in der
// `firnc1` sich selbst übersetzt hat (docs/SELBSTHOSTING.md §21).
//
// Geprüft wird genau das, was auf dem Weg zum Fixpunkt schiefging:
//
//   * eine Vorlage aus einem MODUL, mit mehreren Typen ausgeprägt
//   * eine Vorlage, die eine Vorlage ruft — mit demselben und mit einem
//     anderen Typ
//   * `size_of[T]()` im Rumpf einer Vorlage
//   * ein Parameter, der eine Funktion desselben Moduls verdeckt (`lx`)
//   * ein Struct, das einen WEITER UNTEN deklarierten enthält (`vorlagen.Aussen`)
//   * ein Modul, das selbst ein Modul einbindet (`vorlagen` bindet `tief`
//     ein) — und eine Vorlage, die eine Konstante von dort benutzt
import modules.core.templates

struct Own {
    p: Pair[i32],
    q: Pair[u8],
}

fn main() -> i32 {
    // --- dieselbe Vorlage, zwei Typen
    var pi: Pair[i32] = pair_new[i32](20, 22)
    if sum[i32](&pi) != 42 {
        return 1
    }
    var pu: Pair[u8] = pair_new[u8](100, 55)
    if sum[u8](&pu) != 155 {
        return 2
    }
    var pl: Pair[i64] = pair_new[i64](1000000, 2000000)
    if sum[i64](&pl) != 3000000 {
        return 3
    }

    // --- Größen zur Übersetzungszeit, aus dem Rumpf einer Vorlage heraus
    if size[i32]() != 4 {
        return 4
    }
    if size[u8]() != 1 {
        return 5
    }
    if size[i64]() != 8 {
        return 6
    }

    // --- Vorlage ruft Vorlage: gleicher Typ ...
    if double[i32](21) != 42 {
        return 7
    }
    if double[i64](-5) != -10 {
        return 8
    }
    // ... und fester zweiter Typ (`groesse[u8]` innerhalb von `laenge_von[T]`)
    if length_of[i32](3) != 13 {
        return 9
    }
    if length_of[u8](3) != 4 {
        return 10
    }

    // --- ein Parameter verdeckt eine Funktion desselben Moduls
    if templates.lx(41) != 42 {
        return 11
    }
    if templates.take(7) != 7 {
        return 12
    }

    // --- Struct mit Vorwärtsverweis: das Layout muss stimmen, nicht nur
    // übersetzen. Ohne richtige Größe von `Innen` liegt `n` falsch.
    var a: templates.Outer = templates.outer_new(3, 4, 5)
    if a.inner.x != 3 {
        return 13
    }
    if a.inner.y != 4 {
        return 14
    }
    if a.n != 5 {
        return 15
    }
    a.inner.y = 40
    if a.inner.y + a.n != 45 {
        return 16
    }

    // --- Ausprägungen als Feld eines eigenen Structs
    var e: Own = Own{ p: pair_new[i32](1, 2), q: pair_new[u8](3, 4) }
    if sum[i32](&e.p) != 3 {
        return 17
    }
    if sum[u8](&e.q) != 7 {
        return 18
    }

    // --- eine Vorlage benutzt eine Konstante aus dem Modul ihres Moduls
    if basic_times[i32](6) != 42 {
        return 21
    }
    if basic_times[i64](0) != 0 {
        return 22
    }

    // --- Wert kopieren, Original unverändert
    var copy: Pair[i32] = pi
    copy.a = 0
    if sum[i32](&copy) != 22 {
        return 19
    }
    if sum[i32](&pi) != 42 {
        return 20
    }
    return 0
}
