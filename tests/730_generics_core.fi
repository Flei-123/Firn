// expect_exit: 0
// GENERIC TEMPLATES IN THE CORE LANGUAGE -- the test for the round in which
// `firnc1` compiled itself (docs/SELF_HOSTING.md 21).
//
// What is checked is exactly what went wrong on the way to the fixpoint:
//
//   * a template from a MODULE, instantiated with several types
//   * a template that calls a template -- with the same and with a
//     different type
//   * `size_of[T]()` in the body of a template
//   * a parameter that hides a function of the same module (`lx`)
//   * a struct containing one declared FURTHER DOWN (`templates.Outer`)
//   * a module that imports a module itself (`templates` imports `deep`)
//     -- and a template that uses a constant from there
import modules.core.templates

struct Own {
    p: Pair[i32],
    q: Pair[u8],
}

fn main() -> i32 {
    // --- the same template, two types
    var pi: Pair[i32] = pair_new[i32](20, 22)
    if sum[i32](&pi) != 42 {
        return 1
    }
    var pu: Pair[u8] = pair_new[u8](100, 55)
    if sum[u8](&pu) != 155 {
        return 2
    }
    var pl: Pair[i64] = pair_new[i64](1000000, 2000000)
    if sum[i64](&pl) != 3000000 {
        return 3
    }

    // --- sizes at compile time, from inside the body of a template
    if size[i32]() != 4 {
        return 4
    }
    if size[u8]() != 1 {
        return 5
    }
    if size[i64]() != 8 {
        return 6
    }

    // --- template calls template: same type ...
    if double[i32](21) != 42 {
        return 7
    }
    if double[i64](-5) != -10 {
        return 8
    }
    // ... and a fixed second type (`size[u8]` inside `length_of[T]`)
    if length_of[i32](3) != 13 {
        return 9
    }
    if length_of[u8](3) != 4 {
        return 10
    }

    // --- a parameter hides a function of the same module
    if templates.lx(41) != 42 {
        return 11
    }
    if templates.take(7) != 7 {
        return 12
    }

    // --- struct with a forward reference: the layout has to be right, not just
    // compile. Without the right size of `Inner`, `n` sits in the wrong place.
    var a: templates.Outer = templates.outer_new(3, 4, 5)
    if a.inner.x != 3 {
        return 13
    }
    if a.inner.y != 4 {
        return 14
    }
    if a.n != 5 {
        return 15
    }
    a.inner.y = 40
    if a.inner.y + a.n != 45 {
        return 16
    }

    // --- instances as a field of a struct of one's own
    var e: Own = Own { p: pair_new[i32](1, 2), q: pair_new[u8](3, 4) }
    if sum[i32](&e.p) != 3 {
        return 17
    }
    if sum[u8](&e.q) != 7 {
        return 18
    }

    // --- a template uses a constant from the module of its module
    if basic_times[i32](6) != 42 {
        return 21
    }
    if basic_times[i64](0) != 0 {
        return 22
    }

    // --- copy a value, the original stays unchanged
    var copy: Pair[i32] = pi
    copy.a = 0
    if sum[i32](&copy) != 22 {
        return 19
    }
    if sum[i32](&pi) != 42 {
        return 20
    }
    return 0
}
