// expect_exit: 0
// r115: a call through a function value stored in a struct FIELD with narrow
// integer parameters. The argument widening picked the type of the next
// parameter (the receiver is not in the parameter list), so a u32 went in
// as u64 and wasm32 call_indirect trapped with "function signature mismatch".
// tools/wasm/run.sh runs this program native and as WebAssembly.
struct Api { bind: fn(u32, u32), data: fn(u32, usize, u32) -> u32, f1: fn(f32, i32) -> i32 }
static mut last: u32 = 0
fn w_bind(t: u32, id: u32) { last = last + t * 3 + id }
fn w_data(t: u32, n: usize, usage: u32) -> u32 { return t + (n as u32) + usage }
fn w_f1(x: f32, k: i32) -> i32 { return (x as i32) + k }
fn fill(t: *mut Api) {
    (*t).bind = w_bind
    (*t).data = w_data
    (*t).f1 = w_f1
}
fn use_it(api: *mut Api, n: usize) -> u32 {
    let kind: u32 = 34962
    (*api).bind(kind, (n as u32) + 1)
    let a: u32 = (*api).data(kind, n, 35044)
    let b: i32 = (*api).f1(1.5, (n as i32) - 3)
    return a + (b as u32)
}
fn main() -> i32 {
    var api: Api = Api { bind: w_bind, data: w_data, f1: w_f1 }
    fill(&api)
    let r: u32 = use_it(&api, 5)
    if r != 34962 + 5 + 35044 + (1 + 5 - 3) as u32 {
        return 1
    }
    if last != 34962 * 3 + 6 {
        return 2
    }
    return 0
}
