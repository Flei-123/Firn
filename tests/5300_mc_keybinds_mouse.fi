// expect_exit: 0
import std.rt
import input.raw
import mc.mc_keybinds

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    check(mc_keybinds.kb_mouse_button(256) == raw.MB_LEFT, 1)
    check(mc_keybinds.kb_mouse_button(257) == raw.MB_RIGHT, 2)
    check(mc_keybinds.kb_mouse_button(258) == raw.MB_MIDDLE, 3)
    var c: i32 = 256
    while c <= 258 {
        check(mc_keybinds.kb_mouse_code(mc_keybinds.kb_mouse_button(c)) == c, 4)
        c = c + 1
    }
    return 0
}
