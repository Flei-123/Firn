// expect_exit: 0
// Counterpart to tests/neg/err_discarded.fi: a '!T' value that is bound or
// passed on is fine (SPEC 5.1, #[must_consume]).
error E { A }

fn source(n: i32) -> E!i32 {
    if n == 0 {
        return E::A
    }
    return n
}

fn passthrough(n: i32) -> E!i32 {
    return source(n)
}

fn main() -> i32 {
    let bound = source(2)
    if (bound catch 0) != 2 {
        return 1
    }
    let next = passthrough(3) catch 0
    if next != 3 {
        return 2
    }
    if (passthrough(0) catch 0 - 1) != 0 - 1 {
        return 3
    }
    return 0
}
