// expect_exit: 0
// Round OPT-GENERAL: struct fields kept in registers across a loop
// (compiler/src/promote.rs). The inner loops store through a raw address
// that MAY be -- and here IS -- the very field the outer loop keeps in a
// register. The pass has to write the field back before such an inner loop
// and read it again after it; an inner loop that does not run must change
// nothing. Every result is checked against the arithmetic it has to give.

fn ld32(p: usize, i: usize) -> u32 {
    let q: *mut u32 = (p + i * 4) as *mut u32
    return *q
}

fn st32(p: usize, i: usize, v: u32) {
    let q: *mut u32 = (p + i * 4) as *mut u32
    *q = v
}

struct St {
    tick: u32,
    evals: u64,
    n: usize,
    rq: usize,
    wq: usize,
}

// tick += 1 per pass; the inner loop adds 1 to *alias per element
fn run(s: *mut St, alias: usize, t: u32) {
    var k: u32 = 0
    while k < t {
        (*s).tick = (*s).tick + 1
        var j: usize = 0
        while j < (*s).n {
            st32(alias, 0, ld32(alias, 0) + 1)
            j = j + 1
        }
        (*s).evals = (*s).evals + (*s).n as u64
        let q: usize = (*s).rq
        (*s).rq = (*s).wq
        (*s).wq = q
        k = k + 1
    }
}

// a loop that only reads a field, with a `continue` that keeps a flag
// unchanged (a header phi naming itself -- the rotation bug of this round:
// after rotation the first pass reaches the latch without the header)
fn scan(s: *mut St, data: usize) -> u32 {
    var in_class: bool = false
    var hits: u32 = 0
    var i: usize = 0
    while i < (*s).n {
        let c: u32 = ld32(data, i)
        let w: u32 = (*s).tick
        if c == 9 {
            i = i + 2
            continue
        }
        if c == 1 {
            in_class = true
        } else if c == 2 {
            in_class = false
        } else if c == 7 && !in_class {
            break
        }
        if in_class {
            hits = hits + w
        }
        i = i + 1
    }
    if in_class {
        hits = hits + 1000
    }
    return hits
}

fn main() -> i32 {
    var s: St = St { tick: 0, evals: 0, n: 3, rq: 11, wq: 22 }
    // alias = the tick field itself
    let alias: usize = (&s.tick) as usize
    run(&s, alias, 5)
    if s.tick != 20 { return 1 }
    if s.evals != 15 { return 2 }
    if s.rq != 22 { return 3 }
    // an inner loop that never runs
    s.n = 0
    run(&s, alias, 4)
    if s.tick != 24 { return 4 }
    if s.rq != 22 { return 5 }
    // alias somewhere else
    var other: [u32; 2] = [0; 2]
    s.n = 2
    run(&s, (&other[0]) as usize, 3)
    if s.tick != 27 { return 6 }
    if other[0] != 6 { return 7 }
    // the scan
    var d: [u32; 7] = [1, 9, 9, 3, 2, 7, 5]
    s.tick = 10
    s.n = 7
    if scan(&s, (&d[0]) as usize) != 20 { return 8 }
    var e: [u32; 3] = [9, 9, 1]
    s.n = 3
    if scan(&s, (&e[0]) as usize) != 1010 { return 9 }
    var g: [u32; 4] = [9, 0, 7, 1]
    s.n = 4
    if scan(&s, (&g[0]) as usize) != 0 { return 10 }
    return 0
}
