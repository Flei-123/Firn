// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
// tests/2153_fleitec_login.fi -- lib/appkit/fleitec_login.fi ("Sign in with
// Fleitec-ID") against a stand-in ID server in this process
// (lib/http/server.fi, its own thread) that follows docs/FLEITEC-ID.md
// section 7: it checks the JSON of the login request, answers 401 / 429 +
// Retry-After / 500 / a 200 without a token, and on /api/me it wants the
// cookie `fleitec_session=<token>` exactly.
//
// A  login ok: token and name; the request body is the JSON the server wants
// B  bad credentials (401), rate limited (429, Retry-After 17), a 500, a 200
//    without a token, a 200 with a body that is no JSON: the five answers
// C  a name missing from the answer falls back to the typed one, trimmed
// D  me: signed in (with username, deviceToken, admin), signed out (401),
//    an error (500); the cookie the server saw is `fleitec_session=` + the
//    token percent-encoded; signed out without any request
// E  logout calls the server and forgets the token
// F  unreachable: a closed port
// G  the token as JSON and back; `exp` read from the token
// H  an address over plain http to a stranger is refused (no request)
import std.rt
import std.net
import std.io
import std.time
import std.str
import appkit.fleitec_login as fid
import http.server as http

const KIND_SERVER: u64 = 7772
const S_PORT: u64 = 0
const S_QUIT: u64 = 8
const S_READY: u64 = 16
const S_LOGINS: u64 = 24
const S_ME: u64 = 32
const S_LOGOUTS: u64 = 40
const S_COOKIE_N: u64 = 48
const S_COOKIE: u64 = 56 // up to 120 octets
const S_BODY_OK: u64 = 184
const S_SIZE: usize = 256

static mut SH: u64 = 0

fn ld(a: u64, o: u64) -> u64 { return *((a + o) as *mut u64) }
fn st(a: u64, o: u64, v: u64) { *((a + o) as *mut u64) = v }

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == KIND_SERVER {
        return serve_thread(arg)
    }
    return 0
}

// the value of a string member of a flat JSON object: tiny, for the test
fn jfield(body: str, name: str) -> str {
    var key: rt.Buf = rt.buf_new()
    rt.buf_push(&key, 34 as u8)
    rt.buf_push_bytes(&key, name.p as u64, name.length())
    rt.buf_push(&key, 34 as u8)
    rt.buf_push(&key, 58 as u8)
    let k: str = str { p: rt.buf_data(&key), n: key.len }
    let at: usize = body.find(k)
    var out: str = ""
    if at < body.length() {
        let rest: str = body.ab(at + k.length())
        if rest.length() > 0 && rest.chars(0) == 34 as u8 {
            var e: usize = 1
            while e < rest.length() && rest.chars(e) != 34 as u8 {
                if rest.chars(e) == 92 as u8 {
                    e = e + 1 // an escaped octet belongs to the value
                }
                e = e + 1
            }
            out = __str_copy(rest.part(1, e - 1))
        }
    }
    rt.buf_free(&key)
    return out
}

fn on_login(r: *mut http.Req) {
    let sh: u64 = SH
    __atomic_add((sh + S_LOGINS) as *mut u64, 1)
    if http.method(r) != "POST" {
        http.reply(r, 405, "application/json", "{\"error\":\"POST\"}")
        return
    }
    let body: str = http.body(r)
    let ctype: str = http.header(r, "content-type")
    let user: str = jfield(body, "username")
    let pass: str = jfield(body, "password")
    // the request the spec shows: {"username":..,"password":..}
    st(sh, S_BODY_OK, 0)
    if ctype.starts_with("application/json") && user.length() > 0 && pass.length() > 0 &&
    body.starts_with("{\"username\":") {
        st(sh, S_BODY_OK, 1)
    }
    if user == "justin" && pass == "pw \\\"quoted\\\" \\\\ end" {
        http.reply(r, 200, "application/json",
            "{\"username\":\"Justin\",\"token\":\"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1aWQiOiJ1X3giLCJuYW1lIjoiSnVzdGluIiwiZXhwIjo0MTAyNDQ0ODAwfQ.c2ln\"}")
    } else if user == "throttled" {
        http.reply_ex(r, 429, "application/json", "Retry-After: 17\r\n", "{\"error\":\"zu viele Versuche\"}")
    } else if user == "broken" {
        http.reply(r, 500, "application/json", "{\"error\":\"kaputt\"}")
    } else if user == "notoken" {
        http.reply(r, 200, "application/json", "{\"username\":\"x\"}")
    } else if user == "nojson" {
        http.reply(r, 200, "application/json", "nope")
    } else if user.trim() == "noname" {
        http.reply(r, 200, "application/json", "{\"token\":\"TOKEN.valid\"}")
    } else if user == "pct" {
        http.reply(r, 200, "application/json", "{\"username\":\"P\",\"token\":\"a b/c+d=e\"}")
    } else {
        http.reply(r, 401, "application/json", "{\"error\":\"Falsches Passwort\"}")
    }
}

fn on_me(r: *mut http.Req) {
    let sh: u64 = SH
    __atomic_add((sh + S_ME) as *mut u64, 1)
    let c: str = http.header(r, "cookie")
    var k: usize = 0
    while k < c.length() && k < 120 {
        *((sh + S_COOKIE + k as u64) as *mut u8) = c.chars(k)
        k = k + 1
    }
    st(sh, S_COOKIE_N, c.length() as u64)
    if c == "fleitec_session=TOKEN.valid" {
        http.reply(r, 200, "application/json", "{\"username\":\"Justin\",\"admin\":true,\"deviceToken\":\"dev-123\",\"settings\":{}}")
    } else if c == "fleitec_session=TOKEN.broken" {
        http.reply(r, 500, "application/json", "{}")
    } else if c == "fleitec_session=a%20b%2Fc%2Bd%3De" {
        http.reply(r, 200, "application/json", "{\"username\":\"P\"}")
    } else {
        http.reply(r, 401, "application/json", "{\"error\":\"Nicht angemeldet\"}")
    }
}

fn on_logout(r: *mut http.Req) {
    __atomic_add((SH + S_LOGOUTS) as *mut u64, 1)
    http.reply(r, 200, "application/json", "{\"ok\":true}")
}

#[allow_escape]
fn serve_thread(sh: u64) -> u64 {
    var port: u64 = 33000 + (ld(sh, 0) % 2000)
    var tries: u32 = 0 as u32
    while tries < 200 as u32 {
        var app: http.App = http.app(port as u16)
        app.addr = net.ADDR_LOCAL
        http.set_quiet(&app, true)
        http.route(&app, "/api/login", on_login)
        http.route(&app, "/api/me", on_me)
        http.route(&app, "/api/logout", on_logout)
        if http.step(&app, 0) {
            st(sh, S_PORT, port)
            st(sh, S_READY, 1)
            while ld(sh, S_QUIT) == 0 {
                http.step(&app, 20)
            }
            http.close_server(&app)
            return 0
        }
        port = port + 1
        tries = tries + 1 as u32
    }
    st(sh, S_READY, 2)
    return 0
}

fn cookie_seen() -> str {
    return __str_copy(str { p: rt.ptr_of(SH + S_COOKIE), n: ld(SH, S_COOKIE_N) as usize })
}

fn tests() -> i32 {
    var f: fid.Fid = fid.fid_new()
    if !fid.fid_init(&f) { return 2 as i32 }
    var base: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&base, "http://127.0.0.1:".p as u64, 17)
    rt.buf_push_dec_u64(&base, ld(SH, S_PORT))
    fid.fid_set_server(&f, __str_copy(str { p: rt.buf_data(&base), n: base.len }))

    // ---- D (first part): signed out without a request
    if fid.fid_me(&f) != fid.FID_SIGNED_OUT || ld(SH, S_ME) != 0 { return 10 as i32 }
    if fid.fid_signed_in(&f) || fid.fid_cookie_header(&f).length() != 0 { return 11 as i32 }

    // ---- A
    if fid.fid_login(&f, "justin", "pw \"quoted\" \\ end") != fid.FID_OK { return 20 as i32 }
    if ld(SH, S_BODY_OK) != 1 { return 21 as i32 }
    if f.username != "Justin" || !fid.fid_signed_in(&f) { return 22 as i32 }
    if !f.token.starts_with("eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.") { return 23 as i32 }

    // ---- G (exp)
    if fid.fid_token_expiry(&f) != 4102444800 { return 24 as i32 }

    // ---- B
    var g: fid.Fid = fid.fid_new()
    fid.fid_init(&g)
    g.server = f.server
    if fid.fid_login(&g, "nobody", "x") != fid.FID_BAD_CREDENTIALS || fid.fid_signed_in(&g) { return 30 as i32 }
    if fid.fid_login(&g, "throttled", "x") != fid.FID_RATE_LIMITED || g.retry_after != 17 { return 31 as i32 }
    if fid.fid_login(&g, "broken", "x") != fid.FID_FAILED { return 32 as i32 }
    if fid.fid_login(&g, "notoken", "x") != fid.FID_FAILED || fid.fid_signed_in(&g) { return 33 as i32 }
    if fid.fid_login(&g, "nojson", "x") != fid.FID_FAILED { return 34 as i32 }

    // ---- C
    if fid.fid_login(&g, "  noname  ", "x") != fid.FID_OK || g.username != "noname" { return 35 as i32 } // the typed name, trimmed
    if g.token != "TOKEN.valid" { return 36 as i32 }

    // ---- D
    g.token = "TOKEN.valid"
    if fid.fid_me(&g) != fid.FID_SIGNED_IN { return 40 as i32 }
    if cookie_seen() != "fleitec_session=TOKEN.valid" { return 41 as i32 }
    if g.username != "Justin" || g.device_token != "dev-123" || !g.admin { return 42 as i32 }
    g.token = "TOKEN.expired"
    if fid.fid_me(&g) != fid.FID_SIGNED_OUT { return 43 as i32 }
    g.token = "TOKEN.broken"
    if fid.fid_me(&g) != fid.FID_ERROR { return 44 as i32 }
    // a token with characters that need escaping travels percent-encoded
    if fid.fid_login(&g, "pct", "x") != fid.FID_OK { return 45 as i32 }
    if fid.fid_me(&g) != fid.FID_SIGNED_IN { return 46 as i32 }
    if cookie_seen() != "fleitec_session=a%20b%2Fc%2Bd%3De" { return 47 as i32 }
    if fid.fid_cookie_header(&g) != "fleitec_session=a%20b%2Fc%2Bd%3De" { return 48 as i32 }

    // ---- E
    let lo0: u64 = ld(SH, S_LOGOUTS)
    fid.fid_logout(&g)
    if ld(SH, S_LOGOUTS) != lo0 + 1 || fid.fid_signed_in(&g) || g.device_token.length() != 0 { return 50 as i32 }
    fid.fid_logout(&g)
    if ld(SH, S_LOGOUTS) != lo0 + 1 { return 51 as i32 } // nothing to log out: no request

    // ---- G (json)
    var js: rt.Buf = rt.buf_new()
    fid.fid_to_json(&f, &js)
    var h: fid.Fid = fid.fid_new()
    if !fid.fid_from_json(str { p: rt.buf_data(&js), n: js.len }, &h) { return 60 as i32 }
    if h.token != f.token || h.username != "Justin" || h.server != f.server { return 61 as i32 }
    if fid.fid_from_json("{\"server\":\"x\"}", &h) || fid.fid_from_json("nope", &h) { return 62 as i32 }

    // ---- F
    var u: fid.Fid = fid.fid_new()
    fid.fid_init(&u)
    u.server = "http://127.0.0.1:1"
    if fid.fid_login(&u, "justin", "x") != fid.FID_UNREACHABLE { return 70 as i32 }
    u.token = "t"
    if fid.fid_me(&u) != fid.FID_ERROR { return 71 as i32 }

    // ---- H
    let n0: u64 = ld(SH, S_LOGINS)
    u.server = "http://evil.example"
    if fid.fid_login(&u, "justin", "x") != fid.FID_UNREACHABLE { return 80 as i32 }
    if ld(SH, S_LOGINS) != n0 { return 81 as i32 }

    return 0 as i32
}

fn main() -> i32 {
    SH = rt.heap_alloc(S_SIZE)
    rt.mem_set(SH, 0 as u8, S_SIZE)
    st(SH, 0, time.monotonic_ns() % 1000003)
    let th: u64 = thread_start(KIND_SERVER, SH)
    var waited: u32 = 0 as u32
    while ld(SH, S_READY) == 0 && waited < 500 as u32 {
        time.sleep_ms(10)
        waited = waited + 1 as u32
    }
    if ld(SH, S_READY) != 1 { return 1 as i32 }

    let rc: i32 = tests()
    st(SH, S_QUIT, 1)
    thread_wait(th)
    return rc
}
