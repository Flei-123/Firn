// expect_exit: 0
// Erfolgstyp ist ein Struct: 'try' liefert das Aggregat, 'catch' den Ersatz.
error E { Leer }

struct P { x: i32, y: i32 }

fn punkt(n: i32) -> E!P {
    if n == 0 {
        return E::Leer
    }
    return P{ x: n, y: n * 2 }
}

fn summe(n: i32) -> E!i32 {
    let p = try punkt(n)
    return p.x + p.y
}

fn main() -> i32 {
    if (summe(3) catch 0) != 9 {
        return 1
    }
    if (summe(0) catch 0 - 4) != 0 - 4 {
        return 2
    }
    let p = punkt(0) catch P{ x: 11, y: 0 }
    if p.x != 11 {
        return 3
    }
    return 0
}
