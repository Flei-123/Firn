// expect_exit: 0
// The success type is a struct: 'try' yields the aggregate, 'catch' the fallback.
error E { Empty }

struct P { x: i32, y: i32 }

fn dot(n: i32) -> E!P {
    if n == 0 {
        return E::Empty
    }
    return P { x: n, y: n * 2 }
}

fn sum(n: i32) -> E!i32 {
    let p = try dot(n)
    return p.x + p.y
}

fn main() -> i32 {
    if (sum(3) catch 0) != 9 {
        return 1
    }
    if (sum(0) catch 0 - 4) != 0 - 4 {
        return 2
    }
    let p = dot(0) catch P { x: 11, y: 0 }
    if p.x != 11 {
        return 3
    }
    return 0
}
