// expect_exit: 0
// ROUND OWN-2: a method taking `self` by value moves the receiver (the callee
// drops it); a struct that CONTAINS a value with a `drop` moves as a whole and
// is dropped field by field; lending (`&`, a pointer) never moves.
static mut LOG: i64 = 0
struct G { id: i64 }
impl G {
    fn drop(inout self) { LOG = LOG * 10 + self.id }
    fn consume(self) -> i64 { return self.id }
    fn peek(&self) -> i64 { return self.id }
}
struct H { g: G, n: i64 }
fn take(h: H) -> i64 { return h.n }
fn mk(i: i64) -> G { return G { id: i } }
fn via_ptr(p: *mut G) { (*p).id += 1 }
fn main() -> i32 {
    {
        let g: G = mk(1)
        let n: i64 = g.consume()
    }
    if LOG != 1 { return 1 }
    LOG = 0
    {
        let h: H = H { g: mk(2), n: 5 }
        let r: i64 = take(h)
        if r != 5 { return 2 }
    }
    if LOG != 2 { return 3 }
    LOG = 0
    {
        var g: G = mk(3)
        via_ptr(&g)
        let k: i64 = g.peek()
        if k != 4 { return 4 }
    }
    if LOG != 4 { return 5 }
    return 0
}
