// expect_exit: 0
import std.tostr

fn check(got: str, want: str, code: i32) -> i32 {
    if got == want {
        return 0
    }
    return code
}

fn main() -> i32 {
    let a: i8 = 0 - 5
    let b: u64 = 18446744073709551615
    let c: f64 = 0.1 + 0.2
    let d: f32 = 1.5f
    let e: i64 = 0 - 9223372036854775807
    let f: usize = 12
    let g: u8 = 255
    let h = 7
    let t: bool = true
    let n: long = 5
    var bad: i32 = 0
    bad = bad + check(a.to_str(), "-5", 1)
    bad = bad + check(b.to_str(), "18446744073709551615", 2)
    bad = bad + check(c.to_str(), "0.30000000000000004", 4)
    bad = bad + check(d.to_str(), "1.5", 8)
    bad = bad + check(e.to_str(), "-9223372036854775807", 16)
    bad = bad + check(f.to_str(), "12", 32)
    bad = bad + check(g.to_str(), "255", 64)
    bad = bad + check(h.to_str(), "7", 128)
    bad = bad + check(t.to_str(), "true", 256)
    bad = bad + check(n.to_str(), "5", 512)
    bad = bad + check(t.to_str() + "!", "true!", 1024)
    return bad
}
