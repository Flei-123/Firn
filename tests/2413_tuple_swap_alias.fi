// expect_exit: 0
// Round TUPLES: an assignment whose literal reads the place it writes --
// `t = (t.1, t.0)`, and the same for structs and arrays -- has to read the OLD
// value for every element. (Until this round the literal was written field by
// field into the target, so `p = P { x: p.y, y: p.x }` gave `x == y`.)
struct P { x: i32, y: i32 }

fn rot(p: *mut (i32, i32, i32)) {
    *p = ((*p).1, (*p).2, (*p).0)
}

fn main() -> i32 {
    var t = (1, 2)
    t = (t.1, t.0)
    if t.0 != 2 || t.1 != 1 { return 1 }
    var p = P { x: 1, y: 2 }
    p = P { x: p.y, y: p.x }
    if p.x != 2 || p.y != 1 { return 2 }
    var a: [i32; 3] = [1, 2, 3]
    a = [a[2], a[1], a[0]]
    if a[0] != 3 || a[1] != 2 || a[2] != 1 { return 3 }
    var r = (1, 2, 3)
    rot(&r)
    if r.0 != 2 || r.1 != 3 || r.2 != 1 { return 4 }
    var n = ((1, 2), 3)
    n = ((n.0.1, n.0.0), n.1 + 10)
    if n.0.0 != 2 || n.0.1 != 1 || n.1 != 13 { return 5 }
    // a literal that reads nothing of the target is written in place as before
    var q = P { x: 1, y: 2 }
    q = P { x: 5, y: 6 }
    if q.x != 5 || q.y != 6 { return 6 }
    return 0
}
