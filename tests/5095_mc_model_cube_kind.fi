// expect_exit: 0
import std.rt
import zip.zip
import mc.mc_assets
import mc.mc_texture
import mc.mc_texext
import mc.mc_mesh
import mc.mc_model
import mc.mc_model_mesh
import mc.mc_registry
import mc.mc_version
import mc.mc_versions

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn add(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    let ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

fn push_pack(st: *mut mc_assets.PackStack, w: *mut zip.ZipWriter, b: *mut rt.Buf) -> bool {
    let n: usize = zip.zip_finish(w) catch | e | (0)
    zip.zip_writer_free(w)
    if n == 0 { return false }
    var p: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&p, rt.buf_ptr(b), rt.buf_len(b)) != mc_assets.ASSET_OK { return false }
    rt.buf_free(b)
    return mc_assets.stack_push(st, &p) == mc_assets.ASSET_OK
}

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"
const TEXOAK: str = "\"textures\":{\"bottom\":\"minecraft:block/oak_planks\",\"top\":\"block/oak_planks\",\"side\":\"block/oak_planks\"}"

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0001
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 1)
    var reg: mc_registry.Registry = v.registry_of()
    var st: mc_assets.PackStack = mc_assets.stack_new()
    var b: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&b)
    check(add(&w, "pack.mcmeta", META), 2)
    check(add(&w, "assets/minecraft/models/block/ck_all.json", "{\"parent\":\"block/cube_all\",\"textures\":{\"all\":\"block/stone\"}}"), 3)
    check(add(&w, "assets/minecraft/blockstates/stone.json", "{\"variants\":{\"\":{\"model\":\"block/ck_all\"}}}"), 4)
    check(add(&w, "assets/minecraft/models/block/ck_front.json", "{\"parent\":\"block/block\",\"textures\":{\"front\":\"block/oak_planks\",\"side\":\"block/stone\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"down\":{\"texture\":\"#side\",\"cullface\":\"down\"},\"up\":{\"texture\":\"#side\",\"cullface\":\"up\"},\"north\":{\"texture\":\"#front\",\"cullface\":\"north\"},\"south\":{\"texture\":\"#side\",\"cullface\":\"south\"},\"west\":{\"texture\":\"#side\",\"cullface\":\"west\"},\"east\":{\"texture\":\"#side\",\"cullface\":\"east\"}}}]}"), 5)
    check(add(&w, "assets/minecraft/blockstates/furnace.json", "{\"variants\":{\"facing=north,lit=false\":{\"model\":\"block/ck_front\"},\"facing=south,lit=false\":{\"model\":\"block/ck_front\",\"y\":180},\"facing=east,lit=false\":{\"model\":\"block/ck_front\",\"y\":90},\"facing=west,lit=false\":{\"model\":\"block/ck_front\",\"y\":270},\"facing=north,lit=true\":{\"model\":\"block/ck_front\"},\"facing=south,lit=true\":{\"model\":\"block/ck_front\",\"y\":180},\"facing=east,lit=true\":{\"model\":\"block/ck_front\",\"y\":90},\"facing=west,lit=true\":{\"model\":\"block/ck_front\",\"y\":270}}}"), 6)
    check(add(&w, "assets/minecraft/models/block/ck_tint.json", "{\"parent\":\"block/block\",\"textures\":{\"all\":\"block/stone\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"down\":{\"texture\":\"#all\",\"cullface\":\"down\",\"tintindex\":0},\"up\":{\"texture\":\"#all\",\"cullface\":\"up\",\"tintindex\":0},\"north\":{\"texture\":\"#all\",\"cullface\":\"north\",\"tintindex\":0},\"south\":{\"texture\":\"#all\",\"cullface\":\"south\",\"tintindex\":0},\"west\":{\"texture\":\"#all\",\"cullface\":\"west\",\"tintindex\":0},\"east\":{\"texture\":\"#all\",\"cullface\":\"east\",\"tintindex\":0}}}]}"), 7)
    check(add(&w, "assets/minecraft/blockstates/oak_leaves.json", "{\"variants\":{\"\":{\"model\":\"block/ck_tint\"}}}"), 8)
    check(push_pack(&st, &w, &b), 9)
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    var ex: mc_texext.TexExt = mc_texext.texext_new()
    mc_texext.tex_build_tables_ext(&reg, &tb, &ex)
    var ms: mc_model_mesh.ModelSet = mc_model_mesh.ms_new(&reg, &st, &ex)
    let furnace: i32 = mc_registry.reg_block_by_name(&reg, "furnace".p as u64, 7)
    let leaves: i32 = mc_registry.reg_block_by_name(&reg, "oak_leaves".p as u64, 10)
    check(furnace >= 0 && leaves >= 0, 10)
    check(mc_model_mesh.ms_kind(&ms, 1 as u16) == mc_model_mesh.K_PLAIN, 11)
    check(mc_model_mesh.ms_kind(&ms, mc_registry.reg_block_min_state(&reg, furnace) as u16) == mc_model_mesh.K_MODEL, 12)
    check(mc_model_mesh.ms_kind(&ms, mc_registry.reg_block_min_state(&reg, leaves) as u16) == mc_model_mesh.K_MODEL, 13)
    check(mc_model_mesh.ms_quad_count(&ms, mc_registry.reg_block_min_state(&reg, leaves) as u16) == 6, 14)
    return 0
}
