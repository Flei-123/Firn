// expect_exit: 0
// tests/1401_core_number.fi -- ROUND 73: text -> number out of `std.core`.
//
// Everything a kernel needs to read a number, and NOTHING that asks for
// memory. The point of the round sits in the last section: `strtod`
// computes correctly rounded in exact big number arithmetic and needs
// scratch memory for it. The convenient form in `std.num` fetches it with
// `mmap`; the `_at` form here takes it as a PARAMETER, so that at the call
// site you can see what it costs and whose memory it is.
import std.core

fn s(p: *mut u8) -> core.Span {
    return core.span_of_c(p)
}

fn main() -> i32 {
    var t17: [u8; 3] = "17\0"
    var tminus: [u8; 5] = "-123\0"
    var tplus: [u8; 4] = "+42\0"
    var thex: [u8; 7] = "0xBEEF\0"
    var tbin: [u8; 7] = "0b1011\0"
    var toct: [u8; 6] = "0o755\0"
    var tspace: [u8; 5] = " 17 \0"
    var tjunk: [u8; 5] = "17ab\0"
    var tbig: [u8; 21] = "99999999999999999999\0"
    var tpi: [u8; 18] = "3.14159265358979\0\0"
    var thard: [u8; 24] = "2.2250738585072011e-308\0"

    // 1. the strict form -- the WHOLE text has to be the number
    var v: i64 = 0
    if !core.text_to_i64(s(&t17[0]).p, 2, &v) { return 1 }
    if v != 17 { return 2 }
    if !core.text_to_i64(s(&tminus[0]).p, 4, &v) { return 3 }
    if v != 0 - 123 { return 4 }
    if !core.text_to_i64(s(&tplus[0]).p, 3, &v) { return 5 }
    if v != 42 { return 6 }
    if core.text_to_i64(s(&tspace[0]).p, 4, &v) { return 7 }
    if core.text_to_i64(s(&tjunk[0]).p, 4, &v) { return 8 }

    var u: u64 = 0
    if !core.text_to_u64(s(&t17[0]).p, 2, &u) { return 9 }
    if u != 17 { return 10 }
    if !core.text_to_u64_auto(s(&thex[0]).p, 6, &u) { return 11 }
    if u != 48879 { return 12 }
    if !core.text_to_u64_auto(s(&tbin[0]).p, 6, &u) { return 13 }
    if u != 11 { return 14 }
    if !core.text_to_u64_auto(s(&toct[0]).p, 5, &u) { return 15 }
    if u != 493 { return 16 }
    if !core.text_to_u64_base(s(&thex[0]).ab(2).p, 4, 16, &u) { return 17 }
    if u != 48879 { return 18 }

    // 2. reading on: `read_*` says how many octets it used up
    var over: bool = false
    let used: usize = core.read_i64(s(&tjunk[0]).p, 4, 0, &v, &over)
    if used != 2 || v != 17 || over { return 19 }

    // 3. OVERFLOW IS REPORTED, not hushed up
    if core.text_to_u64(s(&tbig[0]).p, 20, &u) { return 20 }
    let z: usize = core.read_u64(s(&tbig[0]).p, 20, 0, &u, &over)
    if z != 20 { return 21 }
    if !over { return 22 }

    // 4. the comfort layer: a Span in, a value out, no output parameter
    let a: core.ParsedI64 = core.parse_i64(s(&t17[0]))
    if !a.ok || a.overflow || a.value != 17 { return 23 }
    let b: core.ParsedI64 = core.parse_i64(s(&tjunk[0]))
    if b.ok { return 24 }
    if b.value_or(0 - 1) != 0 - 1 { return 25 }
    let c: core.ParsedU64 = core.parse_u64_auto(s(&thex[0]))
    if !c.ok || c.value != 48879 { return 26 }
    let d: core.ParsedU64 = core.parse_u64(s(&tbig[0]))
    if d.ok || !d.overflow { return 27 }
    if core.parsed_i64_none().ok { return 28 }
    if core.parsed_u64_none().ok { return 29 }
    // ` 17 ` trimmed IS a number -- the parser does not trim on its own,
    // and that is the point: `s.trim()` says what it does.
    if !core.parse_i64(s(&tspace[0]).trim()).ok { return 30 }

    // 5. digits
    if core.digit_count(999, 10) != 3 { return 31 }
    if core.digit_count(0, 10) != 1 { return 32 }
    if core.digit_count(255, 16) != 2 { return 33 }
    if core.digit_value(102 as u8) != 15 { return 34 }
    if core.digit_value(33 as u8) != 0 - 1 { return 35 }
    if core.u64_max() == 0 { return 36 }
    if core.i64_max() != 9223372036854775807 { return 37 }
    if core.i64_min() != 0 - 9223372036854775807 - 1 { return 38 }

    // 6. FLOATING POINT WITHOUT A HIDDEN mmap.
    //    The scratch memory lies HERE, in this frame. That is the whole
    //    difference to `num.text_to_f64` -- and it is the reason a kernel
    //    may read a floating point number at all.
    var ws: [u8; 12288] = [0; 12288]
    if core.strtod_work_bytes() != 12288 { return 39 }
    var x: f64 = 0.0
    if !core.text_to_f64_at(&tpi[0], 16, &ws[0], &x) { return 40 }
    if !core.near(x, 3.14159265358979, 0.0000000001) { return 41 }
    // The hard case out of the strtod literature (the one that used to hang
    // PHP), correctly rounded. Compared is the BIT PATTERN, and it is held
    // against the number reader OF THE COMPILER -- two readers written
    // independently of one another, one answer. That is the same
    // comparison round 65 made for four readers.
    var bits: u64 = 0
    if !core.text_to_f64_bits_at(&thard[0], 23, &ws[0], &bits) { return 42 }
    if bits != core.f64_bits(2.2250738585072011e-308) { return 43 }
    // Reading on works here too: the octets used up are reported.
    var y: f64 = 0.0
    if core.read_f64_at(&tjunk[0], 4, &ws[0], &y) != 2 { return 44 }
    if core.f64_bits(y) != core.f64_bits(17.0) { return 45 }
    // The bit tests -- pure integer arithmetic, no FPU
    if !core.f64_is_nan(core.bits_f64(9221120237041090560)) { return 46 }
    if !core.f64_is_infinite(core.bits_f64(9218868437227405312)) { return 47 }
    if !core.f64_is_null(0.0) { return 48 }
    if !core.f64_sign(0.0 - 1.0) { return 49 }
    if core.f64_sign(1.0) { return 50 }

    return 0
}
