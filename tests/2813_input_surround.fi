// expect_exit: 0
// tests/2813_input_surround.fi -- surrounding text of lib/input/textcore.fi (text_set_surrounding / text_delete_surrounding) and
// the fUi side (editor.editor_delete_surrounding, editor_ime_cancel) driven by the textcore events.
import std.rt
import input.textcore
import fui.editor
import fui.textbuf

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn next_del(t: *mut textcore.Text, b: *mut usize, a: *mut usize) -> bool {
    var ev: textcore.TextEvent = textcore.TextEvent { kind: 0 as u32, n: 0, cp: [0 as u32; 32] }
    let k: u32 = textcore.text_event_next(t, &ev)
    if k != textcore.TE_DELETE_SURROUNDING {
        return false
    }
    *b = ev.cp[0] as usize
    *a = ev.cp[1] as usize
    return true
}

fn main() -> i32 {
    var t: textcore.Text = textcore.text_new()
    // "aé€𝄞z": 1 + 2 + 3 + 4 + 1 octets; cursor behind the euro sign (octet 6)
    var s: [u8; 11] = [97 as u8, 195 as u8, 169 as u8, 226 as u8, 130 as u8, 172 as u8, 240 as u8, 157 as u8, 132 as u8, 158 as u8, 122 as u8]
    textcore.text_set_surrounding(&t, (&s[0]) as u64, 11, 6, 6)
    check(textcore.text_surround_known(&t), 1)
    check(textcore.text_surround_len(&t) == 11 && textcore.text_surround_cursor(&t) == 6, 2)
    check(textcore.text_surround_cursor_cp(&t) == 3, 3)
    check(textcore.text_surround_cursor_utf16(&t) == 3, 4)
    // 2 code points before = "é€" (5 octets), 1 behind = the clef (4 octets)
    var b: usize = 0
    var a: usize = 0
    check(textcore.text_delete_surrounding(&t, 2, 1, textcore.SU_CP), 5)
    check(next_del(&t, &b, &a) && b == 5 && a == 4, 6)
    // the window follows the deletion: "az", cursor 1
    check(textcore.text_surround_len(&t) == 2 && textcore.text_surround_cursor(&t) == 1, 7)
    // UTF-16 units: a pair behind the cursor does not fit into 1 unit
    textcore.text_set_surrounding(&t, (&s[0]) as u64, 11, 6, 6)
    check(!textcore.text_delete_surrounding(&t, 0, 1, textcore.SU_UTF16), 8)
    check(textcore.text_delete_surrounding(&t, 0, 2, textcore.SU_UTF16), 9)
    check(next_del(&t, &b, &a) && b == 0 && a == 4, 10)
    // octets: never cut inside a character (3 octets before the cursor would start inside the euro sign: moves inwards)
    textcore.text_set_surrounding(&t, (&s[0]) as u64, 11, 6, 6)
    check(textcore.text_delete_surrounding(&t, 4, 0, textcore.SU_BYTES), 11)
    check(next_del(&t, &b, &a) && b == 3 && a == 0, 12)
    // unknown surrounding text: only octets work
    textcore.text_clear_surrounding(&t)
    check(!textcore.text_delete_surrounding(&t, 1, 0, textcore.SU_CP), 13)
    check(textcore.text_delete_surrounding(&t, 1, 0, textcore.SU_BYTES), 14)
    check(next_del(&t, &b, &a) && b == 1 && a == 0, 15)
    // a long field keeps a window of at most SURMAX octets that starts and ends on code point borders
    var big: [u8; 3000] = [195 as u8; 3000]
    var i: usize = 1
    while i < 3000 {
        big[i] = 169 as u8
        big[i - 1] = 195 as u8
        i = i + 2
    }
    textcore.text_set_surrounding(&t, (&big[0]) as u64, 3000, 1500, 1500)
    check(textcore.text_surround_len(&t) <= textcore.SURMAX, 16)
    check(textcore.text_surround_base(&t) % 2 == 0, 17)
    check(textcore.text_surround_len(&t) % 2 == 0, 18)
    check(textcore.text_surround_base(&t) + textcore.text_surround_cursor(&t) == 1500, 19)

    // ---- the field: editor_delete_surrounding on a real text buffer
    var ed: editor.Editor = editor.editor_new()
    let buf: u64 = rt.heap_alloc(256)
    check(editor.editor_init(&ed, buf, 256), 19)
    let tb: *mut textbuf.TextBuf = editor.editor_buf(&ed)
    check(textbuf.tb_insert(tb, (&s[0]) as u64, 11), 20)
    textbuf.tb_set_range(tb, 6, 6)
    let r: u32 = editor.editor_delete_surrounding(&ed, 5, 4)
    check(r == editor.RES_CHANGED, 21)
    check(textbuf.tb_len(tb) == 2 && textbuf.tb_caret(tb) == 1, 22)
    check(rt.ld8(textbuf.tb_ptr(tb), 0) == 97 as u8 && rt.ld8(textbuf.tb_ptr(tb), 1) == 122 as u8, 23)
    // nothing to delete -> RES_NONE; a pre-edit text blocks it
    check(editor.editor_delete_surrounding(&ed, 0, 0) == editor.RES_NONE, 24)
    var pre: [u8; 2] = [105 as u8, 106 as u8]
    check(editor.editor_ime_preedit(&ed, (&pre[0]) as u64, 2, 2) == editor.RES_CHANGED, 25)
    check(editor.editor_delete_surrounding(&ed, 1, 0) == editor.RES_NONE, 26)
    // cancel: the pre-edit text goes away
    check(editor.editor_ime_cancel(&ed) == editor.RES_CHANGED, 27)
    check(textbuf.tb_len(tb) == 2, 28)
    check(editor.editor_ime_cancel(&ed) == editor.RES_NONE, 29)
    return 0
}
