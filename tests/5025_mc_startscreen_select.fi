// expect_exit: 0
import std.rt
import window.window
import input.raw
import mc.mc_startscreen

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn type_text(f: *mut mc_startscreen.StartForm, t: str) {
    var i: usize = 0
    while i < t.n {
        mc_startscreen.form_char(f, t.chars(i) as u32)
        i = i + 1
    }
}

fn eq(f: *mut mc_startscreen.StartForm, k: i32, t: str) -> bool {
    if mc_startscreen.form_text_len(f, k) != t.n { return false }
    var i: usize = 0
    while i < t.n {
        if rt.ld8(mc_startscreen.form_text_ptr(f, k), i) != t.chars(i) { return false }
        i = i + 1
    }
    return true
}

fn press_chord(f: *mut mc_startscreen.StartForm, rw: *mut raw.Raw, ctrl: u32, key: u32) {
    raw.raw_begin(rw)
    raw.raw_feed(rw, window.EV_RAWKEY, ctrl, 0 as u32, 1 as u32, 0 as u32)
    raw.raw_feed(rw, window.EV_RAWKEY, key, 0 as u32, 2 as u32, 0 as u32)
    raw.raw_end(rw)
    mc_startscreen.form_keys(f, rw)
    raw.raw_begin(rw)
    raw.raw_feed(rw, window.EV_RAWKEY_UP, key, 0 as u32, 3 as u32, 0 as u32)
    raw.raw_feed(rw, window.EV_RAWKEY_UP, ctrl, 0 as u32, 3 as u32, 0 as u32)
    raw.raw_end(rw)
}

fn main() -> i32 {
    var rw: raw.Raw = raw.raw_new()
    var f: mc_startscreen.StartForm = mc_startscreen.form_new()
    f.active = mc_startscreen.FIELD_PORT
    press_chord(&f, &rw, 29 as u32, 30 as u32)
    check(f.selected, 1)
    type_text(&f, "7")
    check(eq(&f, mc_startscreen.FIELD_PORT, "7"), 2)
    check(!f.selected, 3)
    type_text(&f, "8")
    check(eq(&f, mc_startscreen.FIELD_PORT, "78"), 4)

    press_chord(&f, &rw, 97 as u32, 30 as u32)
    check(f.selected, 5)
    raw.raw_begin(&rw)
    raw.raw_feed(&rw, window.EV_RAWKEY, 14 as u32, 0 as u32, 4 as u32, 0 as u32)
    raw.raw_end(&rw)
    mc_startscreen.form_keys(&f, &rw)
    check(mc_startscreen.form_text_len(&f, mc_startscreen.FIELD_PORT) == 0, 6)
    check(!f.selected, 7)

    press_chord(&f, &rw, 29 as u32, 30 as u32)
    f.active = mc_startscreen.FIELD_HOST
    mc_startscreen.form_set(&f, mc_startscreen.FIELD_HOST, "1.2.3.4".p as u64, 7)
    mc_startscreen.form_keys(&f, &rw)
    check(f.selected, 8)

    var g: mc_startscreen.StartForm = mc_startscreen.form_new()
    check(!g.persist, 9)
    mc_startscreen.form_save(&g)
    check(!g.persist, 10)
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_HOST, "1.2.3.4".p as u64, 7)
    mc_startscreen.form_save(&g)
    check(g.persist, 11)
    g.persist = false
    mc_startscreen.form_remove(&g)
    check(g.persist, 12)
    return 0
}
