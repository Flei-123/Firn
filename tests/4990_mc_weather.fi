// expect_exit: 0
import std.rt
import mc.mc_raster
import mc.mc_weather
import mc.mc_weather_fx
import mc.mc_sky

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn differs(a: *mut mc_raster.Raster, b: *mut mc_raster.Raster) -> i32 {
    var n: i32 = 0
    var y: i32 = 0
    while y < (*a).h {
        var x: i32 = 0
        while x < (*a).w {
            if mc_raster.raster_pixel(a, x, y) != mc_raster.raster_pixel(b, x, y) { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main() -> i32 {
    var w: mc_weather.Weather = mc_weather.weather_new()
    check(!mc_weather.weather_active(&w) && mc_weather.weather_sky_rain(&w) == 0, 1)
    check(mc_weather.weather_on_game_state(&w, 1, 0.0 as f32), 2)
    check(w.raining && w.rain == 0, 3)
    check(mc_weather.weather_on_game_state(&w, 7, 0.3 as f32), 4)
    check(mc_weather.weather_rain_milli(&w) == 300 && mc_weather.weather_raining(&w), 4)
    check(mc_weather.weather_on_game_state(&w, 7, 1.0 as f32), 5)
    check(mc_weather.weather_rain_milli(&w) == 1000, 5)
    check(mc_weather.weather_sky_rain(&w) == 192, 6)
    check(mc_weather.weather_on_game_state(&w, 8, 1.0 as f32), 7)
    check(mc_weather.weather_thunder_milli(&w) == 1000 && mc_weather.weather_thundering(&w), 8)
    check(mc_weather.weather_sky_rain(&w) == 256, 9)
    check(w.thunder == 1000, 10)
    check(mc_weather.weather_on_game_state(&w, 2, 0.0 as f32), 11)
    check(!w.raining && w.rain == 1000, 12)
    check(w.rain == 1000, 13)
    check(mc_weather.weather_on_game_state(&w, 7, 0.5 as f32), 14)
    check(w.rain == 500, 15)
    check(!mc_weather.weather_on_game_state(&w, 3, 1.0 as f32), 16)
    check(!mc_weather.weather_on_game_state(&w, 11, 1.0 as f32), 17)
    check(mc_weather.weather_on_game_state(&w, 7, 7.0 as f32), 18)
    check(w.rain == 1000, 19)
    check(mc_weather.weather_on_game_state(&w, 7, 0.0 as f32 - 3.0 as f32), 20)
    check(w.rain == 0 && !mc_weather.weather_active(&w), 21)
    mc_weather.weather_on_game_state(&w, 1, 0.0 as f32)
    mc_weather.weather_on_game_state(&w, 7, 0.8 as f32)
    mc_weather.weather_on_respawn(&w)
    check(!w.raining && w.rain == 0 && w.thunder == 0, 22)

    var s: mc_sky.Sky = mc_sky.sky_new()
    mc_sky.sky_set_time(&s, 6000 as i64, 0)
    let dry_zr: i32 = s.zr
    mc_sky.sky_set_time(&s, 6000 as i64, 192)
    check(s.zr != dry_zr && !s.discs, 23)

    check(mc_weather_fx.weather_fx_count(640, 360, 0) == 0, 24)
    check(mc_weather_fx.weather_fx_count(640, 360, 1000) == 329, 25)
    check(mc_weather_fx.weather_fx_dim_alpha(1000, 1000) == 68, 26)

    var a: mc_raster.Raster = mc_raster.raster_new(160, 90)
    var b: mc_raster.Raster = mc_raster.raster_new(160, 90)
    mc_raster.raster_clear(&a, 0xFF404040 as u32)
    mc_raster.raster_clear(&b, 0xFF404040 as u32)
    var dry: mc_weather.Weather = mc_weather.weather_new()
    mc_weather_fx.weather_fx_draw(&a, 1, &dry, 1000 as u64)
    check(differs(&a, &b) == 0, 27)
    var wet: mc_weather.Weather = mc_weather.weather_new()
    mc_weather.weather_on_game_state(&wet, 7, 1.0 as f32)
    mc_weather_fx.weather_fx_draw(&a, 1, &wet, 1000 as u64)
    let d1: i32 = differs(&a, &b)
    check(d1 > 400, 28)
    mc_raster.raster_clear(&a, 0xFF404040 as u32)
    mc_weather_fx.weather_fx_draw(&a, 1, &wet, 1000 as u64)
    var c: mc_raster.Raster = mc_raster.raster_new(160, 90)
    mc_raster.raster_clear(&c, 0xFF404040 as u32)
    mc_weather_fx.weather_fx_draw(&c, 1, &wet, 1000 as u64)
    check(differs(&a, &c) == 0, 29)
    mc_raster.raster_clear(&c, 0xFF404040 as u32)
    mc_weather_fx.weather_fx_draw(&c, 1, &wet, 1300 as u64)
    check(differs(&a, &c) > 20, 30)
    check(mc_weather_fx.weather_fx_count(640, 360, 200) < mc_weather_fx.weather_fx_count(640, 360, 1000), 31)
    check(mc_weather_fx.weather_fx_dim_alpha(200, 0) < mc_weather_fx.weather_fx_dim_alpha(1000, 0), 32)
    return 0
}
