// expect_exit: 42
import av1.still
import av1.seqdec
import std.fs
import std.rt
import std.deflate

fn load(name: str, data: *mut rt.Buf) -> usize {
    let n: usize = fs.read_file(name, data) catch 0
    return n
}

fn crc_of(name: str, want_crc: u32, want_size: usize) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    let h: u64 = seqdec.seq_open(rt.buf_ptr(&data), n)
    if h == 0 {
        return false
    }
    var all: rt.Buf = rt.buf_new()
    while true {
        var f: still.Frame = still.frame_new()
        let rc: i32 = seqdec.seq_next(h, &f)
        if rc == seqdec.SEQ_END {
            break
        }
        if rc == seqdec.SEQ_FRAME {
            rt.buf_push_bytes(&all, f.y, f.y_bytes)
            rt.buf_push_bytes(&all, f.u, f.u_bytes)
            rt.buf_push_bytes(&all, f.v, f.v_bytes)
            still.frame_free(&f)
        } else if rc != seqdec.SEQ_HIDDEN {
            seqdec.seq_free(h)
            rt.buf_free(&all)
            rt.buf_free(&data)
            return false
        }
    }
    seqdec.seq_free(h)
    let c: u32 = deflate.crc32(rt.buf_ptr(&all), rt.buf_len(&all))
    let sz: usize = rt.buf_len(&all)
    rt.buf_free(&all)
    rt.buf_free(&data)
    return c == want_crc && sz == want_size
}

fn ends_with(name: str, want_shown: i32, want_rc: i32) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    let h: u64 = seqdec.seq_open(rt.buf_ptr(&data), n)
    if h == 0 {
        return false
    }
    var shown: i32 = 0
    var rc: i32 = 0
    while true {
        var f: still.Frame = still.frame_new()
        rc = seqdec.seq_next(h, &f)
        if rc == seqdec.SEQ_FRAME {
            still.frame_free(&f)
            shown = shown + 1
        } else if rc != seqdec.SEQ_HIDDEN {
            break
        }
    }
    seqdec.seq_free(h)
    rt.buf_free(&data)
    return shown == want_shown && rc == want_rc
}

fn survives_cuts(name: str, step: usize) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    var c: usize = 8
    while c < n {
        let h: u64 = seqdec.seq_open(rt.buf_ptr(&data), c)
        if h != 0 {
            var guard: i32 = 0
            while guard < 16 {
                var f: still.Frame = still.frame_new()
                let rc: i32 = seqdec.seq_next(h, &f)
                if rc == seqdec.SEQ_FRAME {
                    still.frame_free(&f)
                }
                if rc != seqdec.SEQ_FRAME && rc != seqdec.SEQ_HIDDEN {
                    break
                }
                guard = guard + 1
            }
            seqdec.seq_free(h)
        }
        c = c + step
    }
    rt.buf_free(&data)
    return true
}

