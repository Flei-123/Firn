// expect_exit: 0
import std.rt
import std.net
import std.bytes
import mc.mc_client
import mc.mc_sem
import mc.mc_version
import mc.mc_chat_net
import mc.mc_tablist
import mc.mc_hud_vfont
import mc.v763.mc_proto_v763
import mc.v769.mc_proto_v769

fn build_info(ver: mc_version.Version, protocol: i32, name: str, uuid_lo: u64) -> mc_client.Client {
    var cl: mc_client.Client = mc_client.client_new(net.conn_from_fd(0 - 1), ver)
    var b: bytes.Bytes = bytes.bytes_new()
    var action: u8 = 29 as u8 + 32 as u8
    if protocol >= 768 { action = action + 64 as u8 + 128 as u8 }
    bytes.put_u8(&b, action)
    bytes.put_varint(&b, 1)
    bytes.put_uuid(&b, 7 as u64, uuid_lo)
    bytes.put_string(&b, name.p as u64, name.n)
    bytes.put_varint(&b, 0)
    bytes.put_varint(&b, 1)
    bytes.put_bool(&b, true)
    bytes.put_varint(&b, 120)
    bytes.put_bool(&b, false)
    if protocol >= 768 {
        bytes.put_varint(&b, 5)
        bytes.put_bool(&b, true)
    }
    cl.body = b
    return cl
}

fn info_round(ver: mc_version.Version, protocol: i32) -> i32 {
    var v: mc_version.Version = ver
    var net_state: mc_chat_net.ChatNet = mc_chat_net.chat_net_new()
    var tl: mc_tablist.TabList = mc_tablist.tab_new()
    var cl: mc_client.Client = build_info(v, protocol, "Bob", 1 as u64)
    let id: i32 = mc_version.version_pid(&v, mc_sem.SEM_PLAY_S2C_PLAYER_INFO)
    if id < 0 { return 1 }
    if !mc_tablist.tab_on_packet(&tl, &net_state, &cl, id) { return 2 }
    if mc_tablist.tab_count(&tl) != 1 { return 3 }
    if mc_tablist.tab_name_len(&tl, 0) != 3 || rt.ld8(mc_tablist.tab_name_ptr(&tl, 0), 0) != 66 as u8 { return 4 }
    if mc_tablist.tab_gamemode(&tl, 0) != 1 || mc_tablist.tab_latency(&tl, 0) != 120 { return 5 }
    if mc_tablist.tab_has_display(&tl, 0) { return 6 }
    var cl2: mc_client.Client = build_info(v, protocol, "Alice", 2 as u64)
    if !mc_tablist.tab_on_packet(&tl, &net_state, &cl2, id) { return 7 }
    if mc_tablist.tab_count(&tl) != 2 { return 8 }
    if mc_tablist.tab_find_name(&tl, "Alice".p as u64, 5) < 0 { return 9 }
    mc_tablist.tab_free(&tl)
    mc_chat_net.chat_net_free(&net_state)
    return 0
}

fn wrap_round() -> i32 {
    let s: str = "aa bb cc dd"
    let p: u64 = s.p as u64
    let adv: i32 = mc_hud_vfont.vfont_adv(97 as u32, 0 as u32)
    if adv <= 0 { return 21 }
    if mc_hud_vfont.vtext_wrap(p, 0 as u64, 0, s.n, 1000) != s.n { return 22 }
    if mc_hud_vfont.vtext_wrap(p, 0 as u64, 0, s.n, adv * 8) != 6 { return 23 }
    if mc_hud_vfont.vtext_wrap(p, 0 as u64, 3, s.n - 3, adv * 5) != 3 { return 24 }
    let w: str = "abcdefgh"
    if mc_hud_vfont.vtext_wrap(w.p as u64, 0 as u64, 0, w.n, adv * 3) != 3 { return 25 }
    if mc_hud_vfont.vtext_wrap(w.p as u64, 0 as u64, 0, 0, adv * 3) != 0 { return 26 }
    return 0
}

fn main() -> i32 {
    var r: i32 = wrap_round()
    if r != 0 { return r }
    r = info_round(mc_proto_v763.version_make(), 763)
    if r != 0 { return 100 + r }
    r = info_round(mc_proto_v769.version_make(), 769)
    if r != 0 { return 200 + r }
    return 0
}
