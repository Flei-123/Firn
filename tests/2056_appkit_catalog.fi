// expect_exit: 0
// tests/2056_appkit_catalog.fi -- lib/appkit/catalog.fi (+ the pure parts of
// fetch.fi): the entry of the REAL store (tests/data/appkit/store-entry.json,
// copied from store.fleitec.com) parsed, judged and verified; a catalog of
// every package kind in the format (apk, opk, exe, bin with per-platform
// pointers, an old style package without builds) and which build each
// platform/channel gets; the update decision table; refusals.
import std.rt
import std.json
import std.str
import appkit.catalog
import appkit.fetch
import appkit.util

const ENTRY: str = __include_str("data/appkit/store-entry.json")
const ENTRY_SIG: str = __include_str("data/appkit/store-entry.json.sig")
const KEY: str = __include_str("data/appkit/store-oeffentlich.key")

const H1: str = "1111111111111111111111111111111111111111111111111111111111111111"
const H2: str = "2222222222222222222222222222222222222222222222222222222222222222"
const H3: str = "3333333333333333333333333333333333333333333333333333333333333333"
const H4: str = "4444444444444444444444444444444444444444444444444444444444444444"
const H5: str = "5555555555555555555555555555555555555555555555555555555555555555"

const CATALOG: str = __include_str("data/appkit/catalog-kinds.json")

fn sel(d: *mut json.Json, pkg: str, ch: str, plat: str, art: str, b: *mut catalog.Build) -> u32 {
    return catalog.catalog_select(d, pkg, ch, plat, art, b)
}

fn ver_is(b: *mut catalog.Build, s: str) -> bool {
    return (*b).nversion == s.n && rt.mem_eq((&(*b).version[0]) as u64, s.p as u64, s.n)
}

fn main() -> i32 {
    // ---------------------------------------------------------- the real entry
    var ent: catalog.Entry = catalog.entry_new()
    if !catalog.entry_parse(ENTRY.p as u64, ENTRY.n, &ent) { return 1 }
    if ent.revision != 155 || ent.eingang != 1 { return 2 }
    if ent.cat_size != 175118 as u64 { return 3 }
    if ent.ncat_sha != 64 { return 4 }
    // the signature of the real entry
    if !catalog.verify_signature(KEY.p as u64, ENTRY.p as u64, ENTRY.n, ENTRY_SIG.p as u64, ENTRY_SIG.n) { return 5 }
    // the policy, with a fixed "now" (2026-10-05 and 2026-11-01; it expires 2026-10-18)
    // 1791158400 = 2026-10-04T... check relative: use the entry's own times
    if catalog.entry_check(&ent, 1791200000, -1, "") != catalog.EC_OK { return 10 }
    if catalog.entry_check(&ent, 1793000000, -1, "") != catalog.EC_EXPIRED { return 11 }
    if catalog.entry_check(&ent, 1791200000, 156, "") != catalog.EC_REVISION { return 12 }
    if catalog.entry_check(&ent, 1791200000, 155, "") != catalog.EC_OK { return 13 }
    if catalog.entry_check(&ent, 1791200000, -1, "2026-10-05T00:00:00Z") != catalog.EC_ROLLBACK { return 14 }
    if catalog.entry_check(&ent, 1791200000, -1, "2026-10-04T04:17:02Z") != catalog.EC_OK { return 15 }
    // a device whose clock is far BEFORE the entry is not locked out by the expiry
    if catalog.entry_check(&ent, 1000000000, -1, "") != catalog.EC_OK { return 16 }
    var bad: catalog.Entry = ent
    bad.eingang = 2
    if catalog.entry_check(&bad, 1791200000, -1, "") != catalog.EC_FORMAT { return 17 }
    var junk: catalog.Entry = catalog.entry_new()
    if catalog.entry_parse("{}".p as u64, 2, &junk) { return 18 }
    if catalog.entry_parse("not json".p as u64, 8, &junk) { return 19 }
    // catalog bytes against the entry: wrong size / wrong hash
    if catalog.catalog_check(&ent, ENTRY.p as u64, ENTRY.n) != catalog.EC_SIZE { return 20 }
    var e2: catalog.Entry = ent
    e2.cat_size = ENTRY.n as u64
    if catalog.catalog_check(&e2, ENTRY.p as u64, ENTRY.n) != catalog.EC_HASH { return 21 }
    // the hash of the entry text itself, computed here, makes it pass
    var hex: [u8; 64] = [0; 64]
    catalog.sha256_hex(ENTRY.p as u64, ENTRY.n, (&hex[0]) as u64)
    rt.mem_copy((&e2.cat_sha[0]) as u64, (&hex[0]) as u64, 64)
    if catalog.catalog_check(&e2, ENTRY.p as u64, ENTRY.n) != catalog.EC_OK { return 22 }

    // ------------------------------------------------------------ the catalog
    var d: json.Json = json.json_new()
    let okp: bool = json.json_parse(&d, CATALOG.p as u64, CATALOG.n) catch false
    if !okp { return 30 }
    if catalog.catalog_format(&d) != 1 || catalog.catalog_revision(&d) != 9 { return 31 }
    var b: catalog.Build = catalog.build_new()
    // linux-x86_64 stabil -> build 3 (plain pointer), notes and date carried
    if sel(&d, "bin:app", "stabil", "linux-x86_64", "bin", &b) != catalog.SEL_OK { return 40 }
    if b.build_id != 3 || !ver_is(&b, "1.2.0") || b.size != 300 as u64 { return 41 }
    if b.nnotes != 17 || b.ncreated != 20 { return 42 }
    if b.nfloor != 5 { return 43 }
    // linux-aarch64 stabil -> its own pointer: build 2
    if sel(&d, "bin:app", "stabil", "linux-aarch64", "bin", &b) != catalog.SEL_OK { return 44 }
    if b.build_id != 2 { return 45 }
    // beta on x86_64 -> build 4 (no beta@platform pointer: the plain one)
    if sel(&d, "bin:app", "beta", "linux-x86_64", "bin", &b) != catalog.SEL_OK { return 46 }
    if b.build_id != 4 || !ver_is(&b, "1.3.0-beta.1") { return 47 }
    // beta on aarch64 -> the plain beta pointer is build 4, which is for x86_64 only
    if sel(&d, "bin:app", "beta", "linux-aarch64", "bin", &b) != catalog.SEL_PLATFORM { return 48 }
    // a channel the package does not have
    if sel(&d, "bin:app", "nightly", "linux-x86_64", "bin", &b) != catalog.SEL_NO_CHANNEL { return 49 }
    // the wrong platform / art / package
    if sel(&d, "bin:app", "stabil", "windows-x86_64", "bin", &b) != catalog.SEL_PLATFORM { return 50 }
    if sel(&d, "bin:app", "stabil", "linux-x86_64", "exe", &b) != catalog.SEL_ART { return 51 }
    if sel(&d, "bin:nope", "stabil", "linux-x86_64", "bin", &b) != catalog.SEL_NO_PACKAGE { return 52 }
    // windows exe
    if sel(&d, "exe:app", "stabil", "windows-x86_64", "exe", &b) != catalog.SEL_OK { return 53 }
    if !ver_is(&b, "0.9.0") || b.nfloor != 0 { return 54 }
    // an apk: versionName is the version, versionCode is carried
    if sel(&d, "org.x.apk", "stabil", "android-arm64", "apk", &b) != catalog.SEL_OK { return 55 }
    if !ver_is(&b, "0.59") || b.version_code != 64 { return 56 }
    // an old style package (no builds, no channels): the first of `fassungen`
    if sel(&d, "opk:old", "stabil", "osum-x86_64", "opk", &b) != catalog.SEL_OK { return 57 }
    if !ver_is(&b, "2.0.0") { return 58 }
    // refusals: an escaping path, a short hash, a pointer to a build that is not there
    if sel(&d, "bin:broken", "stabil", "linux-x86_64", "bin", &b) != catalog.SEL_INCOMPLETE { return 60 }
    if b.found { return 61 }
    if sel(&d, "bin:nosha", "stabil", "linux-x86_64", "bin", &b) != catalog.SEL_INCOMPLETE { return 62 }
    if sel(&d, "bin:ghost", "stabil", "linux-x86_64", "bin", &b) != catalog.SEL_NO_BUILD { return 63 }

    // which build is the file with this hash?
    if catalog.catalog_build_by_sha(&d, "bin:app", H3.p as u64) != 3 { return 70 }
    if catalog.catalog_build_by_sha(&d, "bin:app", H1.p as u64) != 1 { return 71 }
    if catalog.catalog_build_by_sha(&d, "bin:app", H5.p as u64) != -1 { return 72 }
    if catalog.catalog_build_by_sha(&d, "bin:nope", H1.p as u64) != -1 { return 73 }
    json.json_free(&d)

    // ------------------------------------------------------- the paths
    if !catalog.build_url_ok("speicher/ab/abcd.bin".p as u64, 20) { return 80 }
    if catalog.build_url_ok("/etc/passwd".p as u64, 11) { return 81 }
    if catalog.build_url_ok("../x".p as u64, 4) { return 82 }
    if catalog.build_url_ok("a/../x".p as u64, 6) { return 83 }
    if catalog.build_url_ok("http://evil/x".p as u64, 13) { return 84 }
    if catalog.build_url_ok("a\\b".p as u64, 3) { return 85 }
    if catalog.build_url_ok("".p as u64, 0) { return 86 }

    // -------------------------------------------------- the decision table
    var o: catalog.Build = catalog.build_new()
    var dj: json.Json = json.json_new()
    let ok2: bool = json.json_parse(&dj, CATALOG.p as u64, CATALOG.n) catch false
    sel(&dj, "bin:app", "stabil", "linux-x86_64", "bin", &o) // 1.2.0, build 3, floor 1.0.0
    json.json_free(&dj)
    // the same file: up to date whatever the numbers say
    if catalog.decide("0.1.0", -1, true, &o) != catalog.D_UPTODATE { return 90 }
    // a newer offer
    if catalog.decide("1.1.0", -1, false, &o) != catalog.D_UPDATE { return 91 }
    if catalog.decide("1.2.0-beta.1", -1, false, &o) != catalog.D_UPDATE { return 92 }
    // the same version: only a KNOWN older build is replaced; an unknown one
    // (a developer's own build) is left alone
    if catalog.decide("1.2.0", 2, false, &o) != catalog.D_UPDATE { return 93 }
    if catalog.decide("1.2.0", 3, false, &o) != catalog.D_UPTODATE { return 94 }
    if catalog.decide("1.2.0", -1, false, &o) != catalog.D_UPTODATE { return 95 }
    // an older offer: a publisher's rollback only when the installed build is known and newer
    if catalog.decide("1.5.0", 9, false, &o) != catalog.D_ROLLBACK { return 96 }
    if catalog.decide("1.5.0", -1, false, &o) != catalog.D_UPTODATE { return 97 }
    // a version that is not one
    if catalog.decide("banana", -1, false, &o) != catalog.D_BROKEN { return 98 }
    // below the floor: the offer is 1.2.0, floor 1.0.0 -> fine; push the floor up
    if catalog.decide("1.1.0", -1, false, &o) != catalog.D_UPDATE { return 99 }
    o.floor[0] = 57 as u8 // floor "9.0.0"
    o.floor[1] = 46 as u8
    o.floor[2] = 48 as u8
    o.floor[3] = 46 as u8
    o.floor[4] = 48 as u8
    if catalog.decide("1.1.0", -1, false, &o) != catalog.D_BELOW_FLOOR { return 100 }
    var none: catalog.Build = catalog.build_new()
    if catalog.decide("1.0.0", -1, false, &none) != catalog.D_BROKEN { return 101 }

    // ---------------------------------------- the pure parts of the fetcher
    var hdr: str = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\ncontent-LENGTH:  1234 \r\nLocation: /x\r\n\r\n"
    var off: usize = 0
    var len: usize = 0
    if !fetch.fetch_header_find(hdr.p as u64, hdr.n, "content-length", &off, &len) { return 110 }
    if len != 4 || rt.ld8(hdr.p as u64, off) != 49 as u8 { return 111 }
    if !fetch.fetch_header_find(hdr.p as u64, hdr.n, "location", &off, &len) || len != 2 { return 112 }
    if fetch.fetch_header_find(hdr.p as u64, hdr.n, "x-nothing", &off, &len) { return 113 }
    // the status line is not a header
    if fetch.fetch_header_find(hdr.p as u64, hdr.n, "http/1.1 200 ok", &off, &len) { return 114 }
    var addr: u32 = 0
    if !fetch.resolve_basic("127.0.0.1".p as u64, 9, &addr) { return 120 }
    if !fetch.resolve_basic("localhost".p as u64, 9, &addr) { return 121 }
    if fetch.resolve_basic("example.com".p as u64, 11, &addr) { return 122 }
    if fetch.resolve_basic("1.2.3".p as u64, 5, &addr) { return 123 }
    if fetch.resolve_basic("1.2.3.400".p as u64, 9, &addr) { return 124 }
    return 0
}
