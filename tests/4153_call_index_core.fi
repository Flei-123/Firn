// expect_exit: 0
// tests/4153_call_index_core.fi -- r728: call through an expression callee, core language only (compare tools).
struct Ops {
    one: fn(i64) -> i64,
    two: [fn(i64) -> i64; 2],
}

fn inc(x: i64) -> i64 {
    return x + 1
}

fn dbl(x: i64) -> i64 {
    return x * 2
}

fn pick(k: i64) -> fn(i64) -> i64 {
    if k == 0 {
        return inc
    }
    return dbl
}

fn add(a: i64, b: i64) -> i64 {
    return a + b
}

fn main() -> i32 {
    let arr: [fn(i64) -> i64; 2] = [dbl, inc]
    if arr[0](4) != 8 { return 1 }
    if arr[1](arr[0](4)) != 9 { return 2 }
    let o: Ops = Ops { one: dbl, two: [inc, dbl] }
    if (o.one)(8) != 16 { return 3 }
    if o.two[1](21) != 42 { return 4 }
    if (pick(0))(1) != 2 { return 5 }
    if pick(1)(7) != 14 { return 6 }
    let g: [fn(i64, i64) -> i64; 1] = [add]
    if g[0](20, 22) != 42 { return 7 }
    return 0
}
