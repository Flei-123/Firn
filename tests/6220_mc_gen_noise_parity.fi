// expect_exit: 0
// tests/6220_mc_gen_noise_parity.fi -- Minecraft worldgen random + noise primitives, values measured on the real server-26.1.jar (tools/mc/gen/run.sh).
import std.rt
import std.io
import std.math
import mc.gen.mg_random
import mc.gen.mg_wgen
import mc.gen.mg_mth
import mc.gen.mg_noise
import noise.improved
import noise.perlin
import noise.simplex
import noise.psimplex

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn hx(v: f64) -> u64 {
    return math.math_bits(v)
}

fn main() -> i32 {
    var x: mg_random.Rng = mg_random.rng_xoro(0)
    let a: i64 = mg_random.rng_next_long(&x)
    let b: i32 = mg_random.rng_next_int_bound(&x, 1000)
    let c: f64 = mg_random.rng_next_double(&x)
    let d: f64 = mg_random.rng_next_gaussian(&x)
    check((a) == 3038984756725240190, 1)
    check((b) == 182, 2)
    check((hx(c)) == 0x3fd013992e09bd2e as u64, 3)
    check((hx(d)) == 0x3fe7a0edcbf3d3f5 as u64, 4)
    var l: mg_random.Rng = mg_random.rng_legacy(0)
    let l1: i32 = mg_random.rng_next_int(&l)
    let l2: i32 = mg_random.rng_next_int_bound(&l, 37)
    let l3: f64 = mg_random.rng_next_double(&l)
    let l4: f64 = mg_random.rng_next_gaussian(&l)
    check((l1) == 0 - 1155484576, 5)
    check((l2) == 19, 6)
    check((hx(l3)) == 0x3fcec9e5b3672e14 as u64, 7)
    check((hx(l4)) == 0x4000a5b9cca3a4b8 as u64, 8)
    var w: mg_random.Rng = mg_random.rng_wrap(mg_random.rng_xoro(5))
    let k: i64 = mg_wgen.set_decoration_seed(&w, 12345, -7, 9)
    let w1: i64 = mg_random.rng_next_long(&w)
    check((k) == 1889471821952150669, 9)
    check((w1) == 0 - 7147103625287246798, 10)
    check((w.count) == 6, 11)
    check((mg_mth.get_seed(-5, 70, 123456)) == 46192769417378, 12)
    var r1: mg_random.Rng = mg_random.rng_xoro(1)
    let im: improved.Improved = mg_noise.improved_from_rng(&r1)
    let i1: f64 = improved.improved_noise(&im, 1.5, -2.25, 3.75)
    let i2: f64 = improved.improved_noise_smear(&im, 100.3, 64.1, -9.9, 0.5, 0.25)
    check((hx(im.xo)) == 0x406e34f5964cec6b as u64, 13)
    check((hx(i1)) == 0x3fbb90bed586c0f6 as u64, 14)
    check((hx(i2)) == 0x3fb096e3a7b51d00 as u64, 15)
    var r2: mg_random.Rng = mg_random.rng_xoro(2)
    var am: [f64; 32] = [0.0; 32]
    am[0] = 1.0
    am[1] = 2.0
    am[2] = 0.0
    am[3] = 1.5
    let pn: perlin.Perlin = mg_noise.perlin_create(&r2, -5, &am, 4, true)
    check((hx(perlin.perlin_value(&pn, 10.5, 3.25, -7.125))) == 0x3fce9f79d1acd913 as u64, 16)
    check((hx(perlin.perlin_max_broken(&pn, 1.0))) == 0x400c000000000000 as u64, 17)
    var r3: mg_random.Rng = mg_random.rng_xoro(3)
    var an: [f64; 32] = [0.0; 32]
    an[0] = 1.0
    an[1] = 1.0
    let nn: perlin.Normal = mg_noise.normal_create(&r3, -7, &an, 2, true)
    check((hx(perlin.normal_value(&nn, 10.5, 3.25, -7.125))) == 0x3fe3be46b16d9769 as u64, 18)
    check((hx(nn.max_value)) == 0x4011c71c71c71c71 as u64, 19)
    var r4: mg_random.Rng = mg_random.rng_legacy(0)
    let bn: perlin.Blended = mg_noise.blended_create(&r4, 1.0, 1.0, 80.0, 160.0, 8.0)
    check((hx(perlin.blended_value(&bn, 5, 70, 9))) == 0xbfd336c7db48aa50 as u64, 20)
    var r5: mg_random.Rng = mg_random.rng_legacy(9)
    let sn: simplex.Simplex = mg_noise.simplex_from_rng(&r5)
    check((hx(simplex.simplex_value2(&sn, 1.3, 2.7))) == 0xbfdda27a40f7ab77 as u64, 21)
    check((hx(simplex.simplex_value3(&sn, 1.3, 2.7, -4.1))) == 0xbfd113af98617e44 as u64, 22)
    var r6: mg_random.Rng = mg_random.rng_wrap(mg_random.rng_legacy(77))
    var os: mg_noise.OctaveSet = mg_noise.octave_range(-2, 1)
    let ps: psimplex.PerlinSimplex = mg_noise.psimplex_create(&r6, &os)
    check((hx(psimplex.psimplex_value(&ps, 3.3, 4.4, true))) == 0xbfd84ffa7a69a954 as u64, 23)
    return 0
}
