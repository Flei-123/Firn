// expect_out: ok
// tests/2980_dng_write.fi -- plat.android.dngwrite: a synthetic RAW16 frame becomes a structurally valid DNG
// (header, sorted IFD, strip offsets, black/white level, CFA pattern, matrices, noise profile) and the
// pixels come back unchanged. tools/camera/dng_verify.py reads the same bytes with an independent parser.
import std.io
import photo.meta
import plat.android.dngwrite

fn main() -> i32 {
    let w: u32 = 8 as u32
    let h: u32 = 6 as u32
    var raw: [u16; 48] = [0 as u16; 48]
    var i: usize = 0
    while i < 48 {
        raw[i] = (i * 1000 + 17) as u16
        i = i + 1
    }
    var m: meta.SensorMeta = meta.meta_default()
    m.cfa = meta.CFA_BGGR
    meta.meta_set_black(&m, 0, 64.0f, 1023.0f)
    meta.meta_set_black(&m, 1, 64.0f, 1023.0f)
    meta.meta_set_black(&m, 2, 64.0f, 1023.0f)
    meta.meta_set_black(&m, 3, 65.5f, 1023.0f)
    meta.meta_set_noise(&m, 0, 2.0e-5f, 1.0e-6f)
    meta.meta_set_noise(&m, 1, 2.0e-5f, 1.0e-6f)
    meta.meta_set_noise(&m, 2, 2.0e-5f, 1.0e-6f)
    meta.meta_set_noise(&m, 3, 2.0e-5f, 1.0e-6f)
    var k: usize = 0
    while k < 9 {
        meta.meta_set_forward(&m, k, 0.1f * (k as f32) - 0.25f)
        k = k + 1
    }
    var ex: dngwrite.DngExtra = dngwrite.dng_extra_default()
    ex.has_neutral = true
    ex.neutral = [0.5f, 1.0f, 0.6f]
    ex.has_color = true
    ex.illuminant = dngwrite.DNG_ILLUM_D65
    ex.orientation = 6 as u32
    ex.has_model = true
    ex.model[0] = 70 as u8
    ex.model[1] = 67 as u8
    let cap: usize = dngwrite.dng_max_size(w, h)
    var buf: [u8; 4096] = [0 as u8; 4096]
    if cap > 4096 {
        io.print("cap")
        return 1
    }
    let n: usize = dngwrite.dng_write((&buf[0]) as u64, cap, (&raw[0]) as u64, w, h, &m, &ex)
    if n == 0 {
        io.print("write failed")
        return 2
    }
    let c: i32 = dngwrite.dng_check((&buf[0]) as u64, n, w, h)
    if c != 0 {
        io.print("check failed")
        return 3
    }
    // pixels unchanged at the end
    let off: usize = n - 96
    var j: usize = 0
    while j < 48 {
        let lo: u32 = buf[off + j * 2] as u32
        let hi: u32 = buf[off + j * 2 + 1] as u32
        if (lo | (hi << 8 as u32)) != (raw[j] as u32) {
            io.print("pixel mismatch")
            return 4
        }
        j = j + 1
    }
    // bad arguments
    if dngwrite.dng_write(0, cap, (&raw[0]) as u64, w, h, &m, &ex) != 0 {
        return 5
    }
    if dngwrite.dng_write((&buf[0]) as u64, 10, (&raw[0]) as u64, w, h, &m, &ex) != 0 {
        return 6
    }
    // dump for the independent reader when asked
    io.print("ok")
    return 0
}
