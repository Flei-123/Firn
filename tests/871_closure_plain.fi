// expect_exit: 0
// ROUND 58 -- FUNCTIONS AS VALUES, part 2: the closure WITHOUT captures.
//
// `fn(a: i32) -> i32 { ... }` in an expression is an anonymous function. As
// long as it captures nothing, its record is ONE word in `.rodata` -- no
// allocation, no collector, usable under `profile kernel` and inside
// `#[no_gc]`. It is exactly as good a value as a named function.

fn apply(f: fn(i32) -> i32, x: i32) -> i32 { return f(x) }
fn twice(f: fn(i32) -> i32, x: i32) -> i32 { return f(f(x)) }
fn pick(up: bool) -> fn(i32) -> i32 {
    if up {
        return fn(a: i32) -> i32 { return a + 1 }
    }
    return fn(a: i32) -> i32 { return a - 1 }
}

struct Table { f: fn(i32) -> i32 }

fn main() -> i32 {
    // directly, without a detour
    let inc: fn(i32) -> i32 = fn(a: i32) -> i32 { return a + 1 }
    if inc(5) != 6 { return 1 }

    // handed over
    if apply(inc, 5) != 6 { return 2 }
    if twice(inc, 5) != 7 { return 3 }
    if apply(fn(a: i32) -> i32 { return a * 3 }, 5) != 15 { return 4 }

    // as a result
    let up: fn(i32) -> i32 = pick(true)
    let down: fn(i32) -> i32 = pick(false)
    if up(10) != 11 { return 5 }
    if down(10) != 9 { return 6 }

    // in a struct field
    let t: Table = Table { f: fn(a: i32) -> i32 { return 0 - a } }
    let tf: fn(i32) -> i32 = t.f
    if tf(4) != -4 { return 7 }

    // several parameters, a body with control flow
    let mx: fn(i32, i32) -> i32 = fn(a: i32, b: i32) -> i32 {
        if a > b {
            return a
        }
        return b
    }
    if mx(3, 9) != 9 { return 8 }
    if mx(9, 3) != 9 { return 9 }

    // no result: the effect goes through a pointer
    var acc: i32 = 0
    let addto: fn(*mut i32, i32) = fn(p: *mut i32, v: i32) { *p = *p + v }
    addto(&acc, 4)
    addto(&acc, 5)
    if acc != 9 { return 10 }

    // no parameters
    let seven: fn() -> i32 = fn() -> i32 { return 7 }
    if seven() != 7 { return 11 }

    // a closure calls a named function
    if apply(fn(a: i32) -> i32 { return double(a) }, 6) != 12 { return 12 }
    return 0
}

fn double(a: i32) -> i32 { return a + a }
