// expect_exit: 83
// Ergebnisort-Garantie (SPEC §13.1, DESIGNZIELE.md §6):
// `let g = baue(41)` uebergibt die Adresse von `g` an `baue`; die 1-MB-Struktur
// wird DORT gebaut, nicht auf dem Stapel von `baue` und dann kopiert.
// Der Nachweis ueber die Rahmengroessen steht in tools/ergebnisort/run.sh.
struct Gross {
    a: i64,
    puffer: [u8; 1048576],
    b: i64,
}

fn baue(x: i64) -> Gross {
    return Gross{ a: x, puffer: [0; 1048576], b: x + 1, }
}

fn main() -> i32 {
    let g = baue(41)
    return (g.a + g.b) as i32
}
