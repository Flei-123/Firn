// expect_exit: 0
enum In { A(i32), N }
enum Out { I(In), O }

fn f(o: Out) -> i32 {
    match o {
        Out::I(In::A(v)) => { return v }
        Out::I(In::N) => { return 100 }
        Out::O => { return 200 }
    }
    return 0
}

fn g(o: Out) -> i32 {
    match o {
        Out::I(In::A(v)) => { return v }
        Out::I(_) => { return 7 }
        Out::O => { return 8 }
    }
    return 0
}

fn h(b: bool, o: Out) -> i32 {
    match o {
        Out::I(x) => {
            match x {
                In::A(_) => { return 1 }
                In::N => { return 2 }
            }
        }
        Out::O => { return 3 }
    }
    return 0
}

fn main() -> i32 {
    if f(Out::I(In::A(5))) != 5 { return 1 }
    if f(Out::I(In::N)) != 100 { return 2 }
    if f(Out::O) != 200 { return 3 }
    if g(Out::I(In::N)) != 7 { return 4 }
    if h(true, Out::O) != 3 { return 5 }
    return 0
}
