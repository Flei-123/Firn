// expect_out: ok
// tests/2964_photo_document.fi -- FirnCam document scanner: a warm tinted page (160x110 page units) with ink lines,
// shaded by a gradient plus a round shadow, photographed with perspective on a dark brown textured table
// (240x180 px). Checks: find_quad hits the 4 true corners within 3 px; rectify + flatten beats rectify-only by
// > 3 dB PSNR against the ideal flat white page and reaches > 16 dB; the paper is neutral after flatten
// (|R - B| < 0.04, before > 0.1); the PDF writer emits a well formed single page file whose startxref offset
// points at "xref". Deterministic.
import std.io
import std.rt
import photo.image
import photo.document

const PW: f32 = 160.0f
const PH: f32 = 110.0f

// ideal ink coverage 0..1 at page coordinates (u, v)
fn ink(u: f32, v: f32) -> f32 {
    if u < 6.0f || v < 6.0f || u > PW - 6.0f || v > PH - 6.0f { return 0.0f }
    if v >= 10.0f && v < 15.0f && u > 20.0f && u < 110.0f { return 0.85f }
    var j: i32 = 0
    while j < 8 {
        let y0: f32 = 24.0f + 11.0f * (j as f32)
        if v >= y0 && v < y0 + 3.0f {
            let seg: i32 = (u / 7.0f) as i32
            if (seg + j * 3) % 4 != 0 && u < PW - 20.0f { return 0.8f }
        }
        j = j + 1
    }
    return 0.0f
}

// light on the page: gradient + a round soft shadow
fn shade(u: f32, v: f32) -> f32 {
    var s: f32 = 0.55f + 0.45f * (u / PW)
    let du: f32 = u - 45.0f
    let dv: f32 = v - 70.0f
    let d: f32 = image.sqrtf(du * du + dv * dv)
    if d < 30.0f { s = s * (0.6f + 0.4f * d / 30.0f) }
    return s
}

fn pf(s: str, v: f32) {
    io.print(s)
    io.fmt_print_line(io.fmt_f32(io.fmt_new(), v))
}

fn main() -> i32 {
    let w: i32 = 240
    let h: i32 = 180
    var ok: bool = true
    var qx: [f32; 4] = [38.0f, 205.0f, 222.0f, 25.0f]
    var qy: [f32; 4] = [22.0f, 35.0f, 160.0f, 150.0f]
    var rx: [f32; 4] = [0.0f, PW, PW, 0.0f]
    var ry: [f32; 4] = [0.0f, 0.0f, PH, PH]
    var to_page: [f64; 9] = [0.0; 9]
    ok = document.homography4(&qx, &qy, &rx, &ry, &to_page) && ok
    var photo: image.Image = image.img_new(w, h, 3)
    var rng: image.Rng = image.rng_new(21 as u64)
    var y: i32 = 0
    while y < h {
        var x: i32 = 0
        while x < w {
            var u: f32 = 0.0f
            var v: f32 = 0.0f
            document.hmap(&to_page, (x as f32) + 0.5f, (y as f32) + 0.5f, &u, &v)
            var r: f32 = 0.0f
            var g: f32 = 0.0f
            var b: f32 = 0.0f
            if u >= 0.0f && v >= 0.0f && u < PW && v < PH {
                let k: f32 = ink(u, v)
                let s: f32 = shade(u, v)
                // warm paper tint (1.0, 0.92, 0.80) times the light, ink darkens towards 0.1
                r = (1.0f - 0.9f * k) * 1.00f * s
                g = (1.0f - 0.9f * k) * 0.92f * s
                b = (1.0f - 0.9f * k) * 0.80f * s
            } else {
                let t: f32 = 0.04f * image.rng_gauss(&rng)
                r = 0.30f + t
                g = 0.22f + t
                b = 0.15f + t
            }
            image.img_set(&photo, 0, x, y, image.fclampf(r, 0.0f, 1.0f))
            image.img_set(&photo, 1, x, y, image.fclampf(g, 0.0f, 1.0f))
            image.img_set(&photo, 2, x, y, image.fclampf(b, 0.0f, 1.0f))
            x = x + 1
        }
        y = y + 1
    }
    var o: document.DocOpts = document.doc_default()
    var q: document.Quad = document.Quad { x: [0.0f; 4], y: [0.0f; 4] }
    let found: bool = document.find_quad(&photo, &o, &q)
    ok = found && ok
    var worst: f32 = 0.0f
    var k: i32 = 0
    while k < 4 {
        var ex: f32 = q.x[k as usize] - qx[k as usize]
        var ey: f32 = q.y[k as usize] - qy[k as usize]
        if ex < 0.0f { ex = 0.0f - ex }
        if ey < 0.0f { ey = 0.0f - ey }
        if ex > worst { worst = ex }
        if ey > worst { worst = ey }
        k = k + 1
    }
    pf("worst corner error px: ", worst)
    ok = worst < 3.0f && ok

    var flat: image.Image = image.img_new(1, 1, 3)
    image.img_free(&flat)
    document.rectify(&photo, &q, &o, &flat)
    var raw: image.Image = image.img_copy(&flat)
    document.flatten(&flat, &o)
    // ideal flat page at the output size (white paper, same ink)
    var ideal: image.Image = image.img_new(flat.w, flat.h, 3)
    y = 0
    while y < flat.h {
        var x: i32 = 0
        while x < flat.w {
            let k2: f32 = ink(((x as f32) + 0.5f) * PW / (flat.w as f32), ((y as f32) + 0.5f) * PH / (flat.h as f32))
            var c: i32 = 0
            while c < 3 {
                image.img_set(&ideal, c, x, y, 1.0f - 0.9f * k2)
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    let p_raw: f32 = image.psnr(&raw, &ideal, 1.0f)
    let p_flat: f32 = image.psnr(&flat, &ideal, 1.0f)
    pf("rectify only dB: ", p_raw)
    pf("flattened dB: ", p_flat)
    ok = p_flat > p_raw + 3.0f && p_flat > 16.0f && ok
    // neutral paper: a text free patch (page coordinates 130..150 x 90..100)
    let px: i32 = (flat.w * 140) / 160
    let py: i32 = (flat.h * 95) / 110
    var d0: f32 = image.img_get(&raw, 0, px, py) - image.img_get(&raw, 2, px, py)
    var d1: f32 = image.img_get(&flat, 0, px, py) - image.img_get(&flat, 2, px, py)
    if d1 < 0.0f { d1 = 0.0f - d1 }
    pf("paper R-B before: ", d0)
    pf("paper R-B after: ", d1)
    ok = d0 > 0.1f && d1 < 0.04f && ok

    // PDF
    var buf: rt.Buf = rt.buf_new()
    ok = document.pdf_write(&flat, 200.0f, &buf) && ok
    let n: usize = rt.buf_len(&buf)
    ok = n > 200 && rt.buf_at(&buf, 0) == 37 && ok     // '%'
    // startxref offset must point at "xref": read the number after the last "startxref\n"
    var i: usize = n - 1
    var sx: usize = 0
    var found_sx: bool = false
    while i > 10 && !found_sx {
        // "startxref\n" ends with 'f' '\n' ; look for 'x','r','e','f','\n' preceded by "start"
        if rt.buf_at(&buf, i) == 10 && rt.buf_at(&buf, i - 1) == 102 && rt.buf_at(&buf, i - 2) == 101 && rt.buf_at(&buf, i - 3) == 114 && rt.buf_at(&buf, i - 4) == 120 && rt.buf_at(&buf, i - 5) == 116 {
            found_sx = true
            var j: usize = i + 1
            while rt.buf_at(&buf, j) >= 48 && rt.buf_at(&buf, j) <= 57 {
                sx = sx * 10 + ((rt.buf_at(&buf, j) - 48) as usize)
                j = j + 1
            }
        }
        i = i - 1
    }
    ok = found_sx && sx > 0 && sx < n && rt.buf_at(&buf, sx) == 120 && rt.buf_at(&buf, sx + 1) == 114 && ok     // "xr"
    rt.buf_free(&buf)
    if ok {
        io.print("ok")
        io.new_line()
        return 0
    }
    return 1
}
