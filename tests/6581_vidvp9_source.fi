// expect_exit: 0
import std.rt
import std.fs
import fui.kpcodecvid
import media.video.vidops

fn sum_frames(path: str, w: u32, h: u32, count: i64, total: u64) -> i32 {
    var b: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(path, &b) catch | e | (0 -% 1)
    if got == (0 -% 1) {
        return 1
    }
    let ops: vidops.VideoOps = kpcodecvid.video_ops()
    let hd: u64 = ops.create()
    if ops.open(hd, b.ptr, rt.buf_len(&b)) != vidops.VO_OK {
        ops.destroy(hd)
        return 2
    }
    if ops.width(hd) != w || ops.height(hd) != h {
        return 3
    }
    let nb: usize = ops.rgba_bytes(hd)
    let out: u64 = rt.heap_alloc(nb) as u64
    var pts: i64 = 0
    var last: i64 = -1
    var n: i64 = 0
    var sum: u64 = 0
    var sorted: bool = true
    while ops.next_frame(hd, out, &pts) == 1 {
        if pts <= last {
            sorted = false
        }
        last = pts
        var i: usize = 0
        while i < nb {
            sum = sum + (rt.ld8(out, i) as u64)
            i = i + 1
        }
        n = n + 1
    }
    var ok: bool = sorted && n == count && sum == total
    let k: i64 = ops.seek(hd, 0)
    ok = ok && k == 0 && ops.next_frame(hd, out, &pts) == 1 && pts == 0
    rt.heap_free(out, nb)
    ops.close(hd)
    ops.destroy(hd)
    if !ok {
        return 4
    }
    return 0
}

fn main() -> i32 {
    if sum_frames("testdata/media_video/vp9_inter.webm", 64 as u32, 48 as u32, 25, 34526174 as u64) != 0 {
        return 1
    }
    if sum_frames("testdata/media_video/vp9_inter.mp4", 64 as u32, 48 as u32, 25, 34526174 as u64) != 0 {
        return 2
    }
    if sum_frames("testdata/media_video/vp9_arf.webm", 100 as u32, 62 as u32, 50, 226665417 as u64) != 0 {
        return 3
    }
    return 0
}
