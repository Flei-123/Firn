// expect_exit: 42
// Round GAPS: a jump table must not destroy a register-allocated value.
// codegen_switch.rs loaded the table base with `lea rdx, [rip+...]`, but
// `rdx` is in the allocator's POOL: here `arg` lived in `rdx` across the
// ten-way `match`, the table address overwrote it, and the `jmp 5` arm
// sent the program counter to the table address (exit 254 on dev-fast,
// release-safe and release-fast; only --no-opt was right). Found while
// testing named constants as patterns.

fn run(code: *u32, n: usize) -> i64 {
    var acc: i64 = 0
    var pc: usize = 0
    var steps: u32 = 0
    while pc < n && steps < 1000 {
        steps = steps + 1
        let op: u32 = *(((code as usize) + pc * 8) as *u32)
        let argw: u32 = *(((code as usize) + pc * 8 + 4) as *u32)
        let arg: i64 = argw as i64
        pc = pc + 1
        match op {
            0 => { return acc }
            1 => { acc = arg }
            2 => { acc = acc + arg }
            3 => { acc = acc - arg }
            4 => { acc = acc * arg }
            5 => { pc = arg as usize }
            6 => { if acc == 0 { pc = arg as usize } }
            7 => { acc = acc + 1000 }
            8 => { return acc + 7 }
            9 => { }
            _ => { return -1 }
        }
    }
    return -2
}

fn main() -> i32 {
    // load 5; mul 8; nop; jmp 5; add 999 (skipped); sub 5; halt  -> 35
    var prog: [u32; 14] = [1, 5, 4, 8, 9, 0, 5, 5, 2, 999, 3, 5, 0, 0]
    let r: i64 = run((&prog[0]) as *u32, 7)
    if r != 35 {
        return 1
    }
    return 42
}
