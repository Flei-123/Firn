// expect_exit: 0
// Error union across the module boundary (import/export).
import modules.error_source

fn top(n: i32) -> ReadError!i32 {
    let v = try error_source.read(n)
    return v + 1
}

fn main() -> i32 {
    if (top(2) catch 0) != 7 {
        return 1
    }
    if (top(0) catch 0 - 2) != 0 - 2 {
        return 2
    }
    if (top(0 - 3) catch 0 - 2) != 0 - 2 {
        return 3
    }
    return 0
}
