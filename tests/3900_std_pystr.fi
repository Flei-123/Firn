// expect_exit: 0
// tests/3900_std_pystr.fi -- std.pystr: the Python str methods on `str` (case, strip,
// split/join, replace, search, justify, classes, sorted_set), UTF-8 and bad octets.
// The random comparison with Python is tools/pystr_cross/run.sh.
import std.rt
import std.pystr
import std.str
import std.vec
import std.testkit

fn parts(s: str, sep: str) -> str {
    var v: Vec[str] = vec_new[str]()
    pystr.split(s, sep, &v)
    let j: str = pystr.join(&v, "|")
    let n: usize = vec_len[str](&v)
    vec_free[str](&v)
    return j + "#" + pystr.repeat("n", n)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    // case (ASCII only, other octets unchanged)
    testkit.check(pystr.lower("Hello WORLD ä") == "hello world ä", "lower") // english: ok
    testkit.check(pystr.upper("Hello ä") == "HELLO ä", "upper") // english: ok
    testkit.check(pystr.capitalize("hELLO wORLD") == "Hello world", "capitalize")
    testkit.check(pystr.title("hello wORLD 3d a-b") == "Hello World 3D A-B", "title")
    testkit.check(pystr.swapcase("aBc1") == "AbC1", "swapcase")
    testkit.check(pystr.lower("") == "", "lower empty")
    // strip: views, Python whitespace set
    testkit.check(pystr.strip("  x y \t\n") == "x y", "strip")
    testkit.check(pystr.lstrip("  x ") == "x " && pystr.rstrip(" x  ") == " x", "lstrip rstrip")
    testkit.check(pystr.strip(" 　x ") == "x", "strip unicode spaces")
    testkit.check(pystr.strip("   ") == "" && pystr.strip("") == "", "strip all space")
    testkit.check(pystr.strip_chars("xxhixy", "xy") == "hi", "strip_chars")
    testkit.check(pystr.lstrip_chars("xxhix", "x") == "hix" && pystr.rstrip_chars("xhixx", "x") == "xhi", "l/rstrip_chars")
    testkit.check(pystr.strip_chars("ääxää", "ä") == "x", "strip_chars unicode") // english: ok
    // split / join
    testkit.check(parts("a,b,,c", ",") == "a|b||c#nnnn", "split keeps empties")
    testkit.check(parts("", ",") == "#n", "split of empty text is one empty piece")
    testkit.check(parts("a--b--", "--") == "a|b|#nnn", "split long separator")
    testkit.check(parts("abc", "") == "abc#n", "empty separator gives the text whole")
    var v: Vec[str] = vec_new[str]()
    defer vec_free[str](&v)
    pystr.split_n("a,b,c,d", ",", 2, &v)
    testkit.check(pystr.join(&v, "|") == "a|b|c,d", "split_n maxsplit")
    pystr.split_ws("  one  two\tthree\n", &v)
    testkit.check(vec_len[str](&v) == 3 && pystr.join(&v, "|") == "one|two|three", "split_ws")
    pystr.split_ws(" a b　", &v)
    testkit.check(vec_len[str](&v) == 2, "split_ws unicode")
    pystr.split_ws("   ", &v)
    testkit.check(vec_len[str](&v) == 0, "split_ws blank")
    pystr.splitlines("a\nb\r\nc\rd\n", &v)
    testkit.check(vec_len[str](&v) == 4 && pystr.join(&v, "|") == "a|b|c|d", "splitlines")
    pystr.splitlines("a\n\nb", &v)
    testkit.check(vec_len[str](&v) == 3, "splitlines keeps an empty line")
    pystr.splitlines("", &v)
    testkit.check(vec_len[str](&v) == 0, "splitlines empty")
    pystr.split("b,a,b,c,a", ",", &v)
    pystr.sorted_set(&v)
    testkit.check(pystr.join(&v, "") == "abc", "sorted_set")
    // replace
    testkit.check(pystr.replace("aXbXc", "X", "--") == "a--b--c", "replace")
    testkit.check(pystr.replace("ab", "", "-") == "-a-b-", "replace empty old")
    testkit.check(pystr.replace("äb", "", "-") == "-ä-b-", "replace empty old keeps a character whole") // english: ok
    testkit.check(pystr.replace_n("aaaa", "a", "b", 2) == "bbaa", "replace_n")
    testkit.check(pystr.replace_n("ab", "", "-", 1) == "-ab" && pystr.replace_n("ab", "", "-", 0) == "ab", "replace_n empty old")
    testkit.check(pystr.replace("aaa", "aa", "b") == "ba", "replace does not overlap")
    // search
    testkit.check(pystr.startswith("firn", "fi") && !pystr.startswith("fi", "firn") && pystr.startswith("x", ""), "startswith")
    testkit.check(pystr.endswith("firn", "rn") && !pystr.endswith("rn", "firn") && pystr.endswith("x", ""), "endswith")
    testkit.check(pystr.count("banana", "an") == 2 && pystr.count("aaa", "aa") == 1 && pystr.count("äb", "") == 3, "count")
    testkit.check(pystr.find("hello", "l") == 2 && pystr.rfind("hello", "l") == 3 && pystr.find("hello", "z") == -1, "find rfind")
    testkit.check(pystr.find("äb", "b") == 2, "find answers an octet offset")
    testkit.check(pystr.find("abc", "") == 0 && pystr.rfind("abc", "") == 3, "find empty")
    testkit.check(pystr.contains("abc", "bc") && !pystr.contains("abc", "cb"), "contains")
    // justify
    testkit.check(pystr.ljust("ab", 5, 46 as u8) == "ab..." && pystr.rjust("ab", 5, 46 as u8) == "...ab", "ljust rjust")
    testkit.check(pystr.center("ab", 5, 42 as u8) == "**ab*" && pystr.center("ab", 6, 42 as u8) == "**ab**", "center")
    testkit.check(pystr.center("abc", 6, 42 as u8) == "*abc**", "center odd pad goes left only when width is odd")
    testkit.check(pystr.rjust("ä", 3, 32 as u8) == "  ä", "rjust counts characters") // english: ok
    testkit.check(pystr.zfill("42", 5) == "00042" && pystr.zfill("-42", 5) == "-0042" && pystr.zfill("+7", 4) == "+007", "zfill")
    testkit.check(pystr.zfill("12345", 3) == "12345" && pystr.zfill("", 2) == "00", "zfill short")
    testkit.check(pystr.repeat("ab", 3) == "ababab" && pystr.repeat("ab", 0) == "", "repeat")
    // classes
    testkit.check(pystr.isdigit("123") && !pystr.isdigit("12a") && !pystr.isdigit(""), "isdigit")
    testkit.check(pystr.isalpha("abC") && !pystr.isalpha("ab1") && !pystr.isalpha(""), "isalpha")
    testkit.check(pystr.isalnum("ab1") && !pystr.isalnum("ab 1"), "isalnum")
    testkit.check(pystr.isspace(" \t\n") && !pystr.isspace("") && !pystr.isspace(" a"), "isspace")
    testkit.check(pystr.isupper("AB1") && !pystr.isupper("Ab") && !pystr.isupper("1"), "isupper")
    testkit.check(pystr.islower("ab1") && !pystr.islower("aB") && !pystr.islower("1"), "islower")
    testkit.check(pystr.isascii("abc") && !pystr.isascii("aä") && pystr.isascii(""), "isascii")
    testkit.check(pystr.char_len("aä€😀") == 4 && pystr.char_len("") == 0, "char_len") // english: ok
    // bad octets never trap
    var bad: Vec[str] = vec_new[str]()
    defer vec_free[str](&bad)
    let junk: str = pystr.repeat("ä", 3)
    let cut: str = str { p: junk.p, n: 3 }
    testkit.check(pystr.char_len(cut) == 2, "cut character counts as one stray octet")
    testkit.check(pystr.strip(cut).n == 3, "strip on a cut character")
    pystr.split_ws(cut, &bad)
    testkit.check(vec_len[str](&bad) == 1, "split_ws on a cut character")
    // the input is never changed
    let orig: str = "Mixed Case"
    let low: str = pystr.lower(orig)
    testkit.check(orig == "Mixed Case" && low == "mixed case", "lower copies")
    return testkit.finish()
}
