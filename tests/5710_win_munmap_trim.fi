// expect_exit: 0
import std.rt
import std.testkit

const MAP_BYTES: i64 = 10485760
const KEEP_BYTES: i64 = 8388608
const ALIGN_BYTES: i64 = 2097152
const STEP_BYTES: i64 = 1048576

fn map(n: i64) -> i64 {
    return syscall(9, 0, n, 3, 34, -1, 0)
}

fn unmap(p: i64, n: i64) {
    syscall(11, p, n, 0, 0, 0, 0)
}

fn touch_all(start: i64, n: i64, tag: u64) -> bool {
    var off: i64 = 0
    while off < n {
        rt.st64((start + off) as u64, 0, tag + off as u64)
        off = off + STEP_BYTES
    }
    off = 0
    while off < n {
        if rt.ld64((start + off) as u64, 0) != tag + off as u64 {
            return false
        }
        off = off + STEP_BYTES
    }
    return true
}

fn trim_keeps_middle() {
    let raw: i64 = map(MAP_BYTES)
    testkit.check(raw > 0, "mapped")
    let start: i64 = (raw + ALIGN_BYTES - 1) / ALIGN_BYTES * ALIGN_BYTES
    if start > raw {
        unmap(raw, start - raw)
    }
    let tail: i64 = raw + MAP_BYTES - (start + KEEP_BYTES)
    if tail > 0 {
        unmap(start + KEEP_BYTES, tail)
    }
    testkit.check(touch_all(start, KEEP_BYTES, 1000), "middle survives head and tail trim")
    unmap(start, KEEP_BYTES)
}

fn whole_unmap_then_remap() {
    let a: i64 = map(MAP_BYTES)
    testkit.check(a > 0, "mapped whole")
    testkit.check(touch_all(a, MAP_BYTES, 77), "whole mapping usable")
    unmap(a, MAP_BYTES)
    let b: i64 = map(MAP_BYTES)
    testkit.check(b > 0, "remapped after whole unmap")
    testkit.check(touch_all(b, MAP_BYTES, 99), "remap usable")
    unmap(b, MAP_BYTES)
}

fn main() -> i32 {
    trim_keeps_middle()
    whole_unmap_then_remap()
    return testkit.finish()
}
