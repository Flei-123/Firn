// expect_exit: 0
// r905: the free mark must not leak into reused blocks: a block that comes back from the cache is zero everywhere, also at the mark word, for many sizes and many rounds.
import std.rt

fn main() -> i32 {
    var round: usize = 0
    while round < 200 {
        var n: usize = 16
        while n <= 20000 {
            let p: u64 = rt.heap_alloc(n)
            var i: usize = 0
            while i < n {
                if *((p + i as u64) as *mut u8) != 0 { return 1 }
                i = i + 1
            }
            *((p + 8) as *mut u64) = 123456789
            *(p as *mut u64) = 42
            rt.heap_free(p, n)
            n = n * 3
        }
        round = round + 1
    }
    return 0
}
