// expect_exit: 0
// tests/4840_shellthread_lifecycle.fi -- lib/window/shellthread: start, wait for the window (it opens or fails, both are clean), commands, stats, stop and free; no leak, no hang.
import std.rt
import window.shellthread
import window.shellproto

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == shellproto.SHELL_KIND {
        return shellthread.shell_main(arg)
    }
    return 9
}

fn check(c: bool, code: i64) {
    if !c {
        rt.finish(code)
    }
}

fn main() -> i32 {
    var round: u64 = 0
    while round < 3 {
        let sh: u64 = shellthread.shell_start("shell test", 320, 200)
        check(sh != 0, 1)
        let opened: bool = shellthread.shell_wait_open(sh, 8000)
        let st: u64 = shellthread.shell_state(sh)
        check(st == shellproto.ST_OPEN || st == shellproto.ST_FAILED, 2)
        check(opened == (st == shellproto.ST_OPEN), 3)
        check(shellthread.shell_set_title(sh, "renamed"), 4)
        check(shellthread.shell_set_cursor(sh, 2 as u32), 5)
        check(shellthread.shell_redraw(sh), 6)
        var rec: [u64; 8] = [0; 8]
        var spins: u64 = 0
        while shellthread.shell_poll(sh, &rec[0]) {
            spins = spins + 1
        }
        check(shellthread.shell_stat(sh, shellproto.STAT_EVDROP) == 0, 7)
        shellthread.shell_stop(sh)
        round = round + 1
    }
    return 0
}
