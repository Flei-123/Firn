// expect_exit: 0
// Erfolgstypen bool und u8.
error E { A }

fn frage(n: i32) -> E!bool {
    if n < 0 {
        return E::A
    }
    return n > 10
}

fn byte(n: i32) -> E!u8 {
    if n < 0 {
        return E::A
    }
    return n as u8
}

fn main() -> i32 {
    if (frage(20) catch false) != true {
        return 1
    }
    if (frage(1) catch true) != false {
        return 2
    }
    if (frage(0 - 1) catch true) != true {
        return 3
    }
    if (byte(200) catch 0 as u8) != 200 as u8 {
        return 4
    }
    if (byte(0 - 1) catch 9 as u8) != 9 as u8 {
        return 5
    }
    return 0
}
