// expect_exit: 139
// wasm_skip: wild addresses do not exist in the wasm linear memory
// only_target: x86_64
// The null guard only claims faults below 4096; a wild address stays a plain SIGSEGV (139).
fn main() -> i32 {
    let p: *mut i64 = 8192 as *mut i64
    let v: i64 = *(p + 1000000000)
    return v as i32
}
