// Imports a module from THE SAME directory. Before round 17 that did not work:
// the path was looked up relative to the root file, that is in `tests/`.
import deep

export { mid_value, GenPair, gen_sum }

fn mid_value() -> i64 {
    return deep.deep_value() * 6
}

// A generic template that a module offers. Before round 17 it was
// unusable: the root file did not know the name, because the pre-scan
// for templates per file ran IMMEDIATELY before that file was parsed.
struct GenPair[T] {
    a: T,
    b: T,
}

fn gen_sum[T: Scalar](p: *mut GenPair[T]) -> T {
    return (*p).a + (*p).b
}
