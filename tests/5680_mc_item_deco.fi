// expect_exit: 0
import std.rt
import std.testkit
import mc.mc_item_deco

fn work() -> bool {
    testkit.check(mc_item_deco.deco_bar_width(100, 0) == 13, "full bar")
    testkit.check(mc_item_deco.deco_bar_width(100, 50) == 7, "half bar rounds up")
    testkit.check(mc_item_deco.deco_bar_width(100, 100) == 0, "empty bar")
    testkit.check(mc_item_deco.deco_bar_width(100, 500) == 0, "overdamage clamps")
    testkit.check(mc_item_deco.deco_bar_width(59, 1) == 13, "one damage still 13")
    testkit.check(mc_item_deco.deco_bar_color(100, 0) == (0xFF00FF00 as u32), "full is green")
    testkit.check(mc_item_deco.deco_bar_color(100, 100) == (0xFF0000FF as u32), "empty is red")
    testkit.check(mc_item_deco.deco_bar_color(100, 75) == (0xFF007FFF as u32), "quarter is orange")
    testkit.check(mc_item_deco.deco_is_foil("enchanted_golden_apple".p as u64, 22, 0 as u64, 0, false), "notch apple foil")
    testkit.check(!mc_item_deco.deco_is_foil("stone".p as u64, 5, 0 as u64, 0, false), "stone no foil")
    return true
}

fn main() -> i32 {
    work()
    return testkit.finish()
}
