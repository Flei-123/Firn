// expect_exit: 0
import std.rt
import std.io
import std.fs
import std.env
import std.str
import std.json
import zip.zip
import audio.engine
import audio.bank
import mc.mc_assets
import mc.mc_packsnd
import mc.mc_vanilla
import mc.mc_vanilla_snd
import mc.mc_assetindex

struct T {
    fails: i32,
}

fn check(t: *mut T, ok: bool, what: str) {
    if ok {
        io.fmt_print(f"ok   {what}\n")
    } else {
        io.fmt_print(f"FAIL {what}\n")
        (*t).fails = (*t).fails + 1
    }
}

const OGG_A: str = "tests/data/vorbis/sine_m22k_q3.ogg"
const OGG_B: str = "tests/data/vorbis/impulse_m44k_q4.ogg"
const HASH_A: str = "aa11223344556677889900aabbccddeeff001122"
const HASH_B: str = "bb11223344556677889900aabbccddeeff001122"
const HASH_J: str = "cc11223344556677889900aabbccddeeff001122"
const HASH_M: str = "dd11223344556677889900aabbccddeeff001122"

fn push(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.length())
}

fn join(base: *mut rt.Buf, tail: str) -> rt.Buf {
    var r: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&r, rt.buf_ptr(base), rt.buf_len(base))
    push(&r, tail)
    return r
}

fn put(base: *mut rt.Buf, rel: str, p: u64, n: usize) -> bool {
    var path: rt.Buf = join(base, rel)
    let dir: str = mc_vanilla.vanilla_dir_of(rt.buf_str(&path))
    fs.mkdir_all(dir) catch false
    let wrote: usize = fs.write_file(rt.buf_str(&path), p, n) catch | e | (0)
    let ok: bool = wrote == n
    rt.buf_free(&path)
    return ok
}

fn put_str(base: *mut rt.Buf, rel: str, body: str) -> bool {
    return put(base, rel, body.p as u64, body.length())
}

fn put_copy(base: *mut rt.Buf, rel: str, src: str) -> bool {
    var d: rt.Buf = rt.buf_new()
    let got: usize = fs.read_file(src, &d) catch | e | (0)
    var ok: bool = false
    if got > 0 { ok = put(base, rel, rt.buf_ptr(&d), rt.buf_len(&d)) }
    rt.buf_free(&d)
    return ok
}

const INDEX: str = "{\"objects\":{\"minecraft/sounds.json\":{\"hash\":\"cc11223344556677889900aabbccddeeff001122\",\"size\":10},\"minecraft/sounds/dig/stone1.ogg\":{\"hash\":\"aa11223344556677889900aabbccddeeff001122\",\"size\":1},\"minecraft/sounds/dig/stone2.ogg\":{\"hash\":\"bb11223344556677889900aabbccddeeff001122\",\"size\":1},\"minecraft/sounds/music/menu/m.ogg\":{\"hash\":\"dd11223344556677889900aabbccddeeff001122\",\"size\":1},\"minecraft/sounds/records/r.ogg\":{\"hash\":\"dd11223344556677889900aabbccddeeff001122\",\"size\":1},\"minecraft/sounds/dig/gone.ogg\":{\"hash\":\"ee11223344556677889900aabbccddeeff001122\",\"size\":1},\"minecraft/sounds/dig/evil.ogg\":{\"hash\":\"../../x\",\"size\":1},\"minecraft/lang/en_us.json\":{\"hash\":\"dd11223344556677889900aabbccddeeff001122\",\"size\":1},\"icons/icon_16x16.png\":{\"hash\":\"dd11223344556677889900aabbccddeeff001122\",\"size\":1}}}"
const SOUNDS_JSON: str = "{\"block.stone.step\":{\"sounds\":[\"dig/stone1\",\"dig/stone2\",\"dig/gone\",\"dig/evil\"]},\"music.menu\":{\"sounds\":[\"music/menu/m\"]}}"
const VERSION_JSON: str = "{\"id\":\"1.20.1\",\"assetIndex\":{\"id\":\"5\",\"sha1\":\"x\"},\"assets\":\"5\"}"

#[allow_escape]
fn main(start: u64) -> i32 {
    var t: T = T { fails: 0 }

    check(&t, mc_vanilla_snd.vsnd_keep("minecraft/sounds.json".p as u64, 21), "keep sounds.json")
    check(&t, mc_vanilla_snd.vsnd_keep("minecraft/sounds/dig/stone1.ogg".p as u64, 31), "keep an ogg")
    check(&t, !mc_vanilla_snd.vsnd_keep("minecraft/sounds/music/menu/m.ogg".p as u64, 33), "skip music")
    check(&t, !mc_vanilla_snd.vsnd_keep("minecraft/sounds/records/r.ogg".p as u64, 30), "skip records")
    check(&t, !mc_vanilla_snd.vsnd_keep("minecraft/sounds/dig/x.txt".p as u64, 26), "skip non-ogg")
    check(&t, !mc_vanilla_snd.vsnd_keep("minecraft/lang/en_us.json".p as u64, 25), "skip lang")

    var ix: mc_assetindex.AssetIndex = mc_assetindex.aidx_new()
    check(&t, mc_assetindex.aidx_parse(&ix, INDEX.p as u64, INDEX.length()), "index parses")
    check(&t, mc_assetindex.aidx_count(&ix) == 9, "index has 9 objects")
    let e: u32 = mc_assetindex.aidx_lookup(&ix, "minecraft/sounds/dig/stone2.ogg".p as u64, 31)
    check(&t, e != json.JSON_NONE, "lookup finds a name")
    var hp: rt.Buf = rt.buf_new()
    check(&t, mc_assetindex.aidx_object_path("/a", mc_assetindex.aidx_hash(&ix, e), &hp) && rt.buf_str(&hp) == "/a/objects/bb/bb11223344556677889900aabbccddeeff001122", "object path = objects/<2>/<hash>")
    check(&t, mc_assetindex.aidx_lookup(&ix, "nope".p as u64, 4) == json.JSON_NONE, "lookup misses")
    let ev: u32 = mc_assetindex.aidx_lookup(&ix, "minecraft/sounds/dig/evil.ogg".p as u64, 29)
    var ep: rt.Buf = rt.buf_new()
    check(&t, ev != json.JSON_NONE && !mc_assetindex.aidx_object_path("/a", mc_assetindex.aidx_hash(&ix, ev), &ep), "unsafe hash rejected")
    var bad: mc_assetindex.AssetIndex = mc_assetindex.aidx_new()
    check(&t, !mc_assetindex.aidx_parse(&bad, "{\"x\":1}".p as u64, 7), "index without objects rejected")
    mc_assetindex.aidx_free(&bad)

    var idb: rt.Buf = rt.buf_new()
    check(&t, mc_assetindex.aidx_version_index_id(VERSION_JSON.p as u64, VERSION_JSON.length(), &idb) && rt.buf_str(&idb) == "5", "version json assetIndex.id")
    var idb2: rt.Buf = rt.buf_new()
    check(&t, mc_assetindex.aidx_version_index_id("{\"assets\":\"legacy\"}".p as u64, 19, &idb2) && rt.buf_str(&idb2) == "legacy", "version json assets fallback")

    let tmp: str = env.get("TMPDIR")
    var base: rt.Buf = rt.buf_new()
    if tmp.length() > 0 { push(&base, tmp) } else { push(&base, "/tmp") }
    push(&base, "/mc_vanilla_snd_test_5015")
    fs.remove_tree(rt.buf_str(&base)) catch false

    var ok: bool = put_str(&base, "/mc/versions/1.20.1/1.20.1.jar", "jar")
    ok = put_str(&base, "/mc/versions/1.20.1/1.20.1.json", VERSION_JSON) && ok
    ok = put_str(&base, "/mc/assets/indexes/5.json", INDEX) && ok
    ok = put_copy(&base, "/mc/assets/objects/aa/aa11223344556677889900aabbccddeeff001122", OGG_A) && ok
    ok = put_copy(&base, "/mc/assets/objects/bb/bb11223344556677889900aabbccddeeff001122", OGG_B) && ok
    ok = put_str(&base, "/mc/assets/objects/cc/cc11223344556677889900aabbccddeeff001122", SOUNDS_JSON) && ok
    ok = put_str(&base, "/mc/assets/objects/dd/dd11223344556677889900aabbccddeeff001122", "music-bytes") && ok
    check(&t, ok, "fixture launcher dir written")

    var jar: rt.Buf = join(&base, "/mc/versions/1.20.1/1.20.1.jar")
    var assets: rt.Buf = rt.buf_new()
    var id: rt.Buf = rt.buf_new()
    check(&t, mc_vanilla_snd.vsnd_locate(rt.buf_str(&jar), "1.20.1", &assets, &id), "locate assets dir + index id from the jar path")
    check(&t, rt.buf_str(&id) == "5", "index id 5")

    var dest: rt.Buf = join(&base, "/cache/vanillasnd.zip")
    var kept: i32 = 0
    let rc: i32 = mc_vanilla_snd.vsnd_build_cache(rt.buf_str(&assets), rt.buf_str(&id), rt.buf_str(&dest), 15, &kept)
    check(&t, rc == mc_vanilla.VANILLA_OK, "build cache ok")
    check(&t, kept == 3, "3 entries kept (sounds.json + 2 oggs; music, records, missing, unsafe, lang skipped)")

    var e2: engine.Engine = engine.engine_new(48000 as u32, 64 as u32)
    var b: bank.Bank = bank.bank_new()
    var stack: mc_assets.PackStack = mc_assets.stack_new()
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    check(&t, mc_assets.pack_open_file(&pk, rt.buf_str(&dest)) == mc_assets.ASSET_OK && pk.format == 15, "cache opens as a pack, format 15")
    check(&t, mc_assets.stack_push(&stack, &pk) == mc_assets.ASSET_OK, "pack pushed")
    var text: rt.Buf = rt.buf_new()
    let st: mc_packsnd.PackSnd = mc_packsnd.packsnd_build_text(&stack, &e2, &b, &text)
    check(&t, st.events == 1 && st.files == 2, "pack sounds: 1 event, 2 files decoded")

    var bad_id: rt.Buf = rt.buf_new()
    push(&bad_id, "99")
    var kept2: i32 = 0
    check(&t, mc_vanilla_snd.vsnd_build_cache(rt.buf_str(&assets), rt.buf_str(&bad_id), rt.buf_str(&dest), 15, &kept2) == mc_vanilla.VANILLA_NO_ASSETS, "missing index -> NO_ASSETS")

    var jar2: rt.Buf = join(&base, "/other/x.jar")
    var a2: rt.Buf = rt.buf_new()
    var i2: rt.Buf = rt.buf_new()
    check(&t, !mc_vanilla_snd.vsnd_locate(rt.buf_str(&jar2), "1.20.1", &a2, &i2), "locate fails without launcher layout")

    fs.remove_tree(rt.buf_str(&base)) catch false
    if t.fails != 0 {
        io.fmt_print(f"mc_vanilla_sounds FAIL {t.fails}\n")
        return 1
    }
    io.fmt_print(f"mc_vanilla_sounds ok\n")
    return 0
}
