// expect_exit: 0
import std.parse
import std.tostr

fn main() -> i32 {
    var bad: i32 = 0
    let a = int.parse("123") catch 0 - 1
    if a != 123 { bad = bad + 1 }
    let b = int.parse("12x") catch 0 - 1
    if b != 0 - 1 { bad = bad + 2 }
    let c = i64.parse("-45") catch 0
    if c != 0 - 45 { bad = bad + 4 }
    let d = f64.parse("2.5") catch 0.0
    if d != 2.5 { bad = bad + 8 }
    let e = bool.parse("true") catch false
    if !e { bad = bad + 16 }
    let f = u32.parse("7") catch 0
    if f != 7 { bad = bad + 32 }
    var n: i32 = 0
    if !int.try_parse("77", &n) { bad = bad + 64 }
    if n != 77 { bad = bad + 128 }
    var m: i64 = 5
    if i64.try_parse("zz", &m) { bad = bad + 256 }
    if m != 5 { bad = bad + 512 }
    let g = long.parse("99999999999") catch 0
    if g != 99999999999 { bad = bad + 1024 }
    let h = int.parse("3000000000") catch |err| 0 - 2
    if h != 0 - 2 { bad = bad + 2048 }
    return bad
}
