// expect_exit: 0
// tests/4350_unused_import.fi -- r752: a module that is imported but never used compiles the same in every
// stage. `firnc0 --emit=fir-raw` lowers every function of an imported module (stage 1 `firdump` has no
// module loader), so tools/fir_compare.sh files such a program under IMPORTS, not under DIFFERENT.
import std.str

fn add(a: i32, b: i32) -> i32 { return a + b }

fn main() -> i32 {
    if add(2, 3) != 5 {
        return 1
    }
    return 0
}
