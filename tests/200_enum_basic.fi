// expect_exit: 21
// Aufzaehlung ohne Nutzdaten, match ueber alle Varianten (SPEC §6.3).
enum Farbe { Rot, Gruen, Blau }

fn main() -> i32 {
    var summe: i32 = 0
    var f: Farbe = Farbe::Rot
    var i: i32 = 0
    while i < 3 as i32 {
        match f {
            Farbe::Rot => { summe = summe + 1 as i32; f = Farbe::Gruen }
            Farbe::Gruen => { summe = summe + 6 as i32; f = Farbe::Blau }
            Farbe::Blau => { summe = summe + 14 as i32; f = Farbe::Rot }
        }
        i = i + 1 as i32
    }
    return summe
}
