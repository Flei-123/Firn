// expect_exit: 21
// Enumeration without payload, match over all variants (SPEC 6.3).
enum Color { Red, Green, Blue }

fn main() -> i32 {
    var sum: i32 = 0
    var f: Color = Color::Red
    var i: i32 = 0
    while i < 3 as i32 {
        match f {
            Color::Red => { sum = sum + 1 as i32; f = Color::Green }
            Color::Green => { sum = sum + 6 as i32; f = Color::Blue }
            Color::Blue => { sum = sum + 14 as i32; f = Color::Red }
        }
        i = i + 1 as i32
    }
    return sum
}
