// expect_exit: 0
import std.rt
import mc.mc_entity_draw
import mc.mc_camera
import mc.mc_raster
import mc.mc_backend
import mc.mc_texture
import mc.mc_bolt_shape
import mc.mc_weather
import mc.mc_weather_fx
import mc.mc_precip

const CLEAR: u32 = 0xFF102030
const RAIN_W: i32 = 160
const RAIN_H: i32 = 90

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn word(rec: u64, i: usize) -> f64 {
    return *((rec + (i as u64) * (8 as u64)) as *mut f64)
}

fn brighter_pixels(r: *mut mc_raster.Raster, clear: u32) -> i32 {
    var n: i32 = 0
    var y: i32 = 0
    while y < (*r).h {
        var x: i32 = 0
        while x < (*r).w {
            if (mc_raster.raster_pixel(r, x, y) & 255 as u32) > (clear & 255 as u32) { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn bolt_pass(fog: bool) -> i32 {
    var l: mc_entity_draw.EntList = mc_entity_draw.entlist_new()
    mc_entity_draw.entlist_add_bolt(&l, 0.0, 0.0 - 10.0, 60.0, mc_bolt_shape.bolt_seed(7), 60.0)
    check(mc_entity_draw.entlist_boxes(&l) > 100, 1)
    let base: u64 = rt.buf_ptr(&l.buf)
    var i: usize = 0
    while i < mc_entity_draw.entlist_boxes(&l) {
        let rec: u64 = base + (i * mc_backend.ENT_BYTES) as u64
        check(word(rec, 11) < 0.0 - 0.5, 2)
        check(word(rec, 8) >= 240.0 && word(rec, 9) >= 240.0 && word(rec, 10) >= 240.0, 3)
        i = i + 1
    }
    var r: mc_raster.Raster = mc_raster.raster_new(96, 72)
    var cam: mc_camera.Camera = mc_camera.camera_new(96, 72)
    mc_camera.camera_set_pos(&cam, 0.0, 50.0, 0.0)
    mc_camera.camera_update(&cam)
    var at: mc_texture.Atlas = mc_texture.atlas_default()
    var b: mc_backend.Backend = mc_backend.backend_cpu(&r)
    b.upload_atlas(b.obj, (&at) as u64)
    b.begin(b.obj, (&cam) as u64, CLEAR)
    if fog { mc_raster.raster_set_fog(&r, true, 1.0, 2.0, 16 as u32, 32 as u32, 48 as u32) }
    let n: u64 = mc_entity_draw.entlist_draw(&l, &b)
    check(n == (mc_entity_draw.entlist_boxes(&l) as u64), 4)
    var bright: i32 = 0
    var dark: i32 = 0
    var y: i32 = 0
    while y < 72 {
        var x: i32 = 0
        while x < 96 {
            let p: u32 = mc_raster.raster_pixel(&r, x, y)
            if p != CLEAR {
                let pr: u32 = p & 255 as u32
                if pr >= 240 as u32 { bright = bright + 1 } else { dark = dark + 1 }
            }
            x = x + 1
        }
        y = y + 1
    }
    check(bright > 20, 5)
    check(dark == 0, 6)
    mc_entity_draw.entlist_free(&l)
    mc_raster.raster_free(&r)
    return bright
}

fn rain_pass(snow: bool, rain_milli_value: f32) -> i32 {
    var w: mc_weather.Weather = mc_weather.weather_new()
    mc_weather.weather_on_game_state(&w, 1, 0.0 as f32)
    mc_weather.weather_on_game_state(&w, 7, rain_milli_value)
    var kind: i32 = mc_precip.PRECIP_RAIN
    if snow { kind = mc_precip.PRECIP_SNOW }
    mc_weather.weather_set_local(&w, kind, mc_precip.EXPOSURE_MAX)
    var r: mc_raster.Raster = mc_raster.raster_new(RAIN_W, RAIN_H)
    mc_raster.raster_clear(&r, CLEAR)
    mc_weather_fx.weather_fx_draw(&r, 1, &w, 1234 as u64)
    let n: i32 = brighter_pixels(&r, CLEAR)
    mc_raster.raster_free(&r)
    return n
}

fn main() -> i32 {
    let nofog: i32 = bolt_pass(false)
    let fogged: i32 = bolt_pass(true)
    check(nofog > 0 && fogged > 0, 7)
    var seen: [i32; 3] = [0, 0, 0]
    var i: i32 = 0
    while i < 300 {
        let layer: i32 = mc_weather_fx.streak_layer(i)
        check(layer >= 0 && layer < mc_weather_fx.LAYER_COUNT, 8)
        seen[layer as usize] = seen[layer as usize] + 1
        i = i + 1
    }
    check(seen[0] > 50 && seen[1] > 50 && seen[2] > 50, 9)
    let light: i32 = rain_pass(false, 0.2 as f32)
    let heavy: i32 = rain_pass(false, 1.0 as f32)
    check(light > 0, 10)
    check(heavy > light, 11)
    let snow: i32 = rain_pass(true, 1.0 as f32)
    check(snow > 0, 12)
    check(rain_pass(false, 0.0 as f32) == 0, 13)
    return 0
}
