// expect_exit: 0
import jxl.jxl
import std.fs
import std.rt

static mut failures: i32 = 0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn body_offset(d: *mut rt.Buf, n: usize, lines: u32) -> usize {
    var nl: u32 = 0
    var i: usize = 0
    while i < n && nl < lines {
        if rt.ld8(rt.buf_ptr(d), i) == 10 {
            nl = nl + 1
        }
        i = i + 1
    }
    return i
}

fn sample(p: u64, bps: u32, idx: usize) -> i32 {
    if bps == 1 {
        return rt.ld8(p, idx) as i32
    }
    let hi: i32 = rt.ld8(p, idx * 2) as i32
    let lo: i32 = rt.ld8(p, idx * 2 + 1) as i32
    return hi * 256 + lo
}

fn pic_sample(p: u64, bps: u32, idx: usize) -> i32 {
    if bps == 1 {
        return rt.ld8(p, idx) as i32
    }
    let lo: i32 = rt.ld8(p, idx * 2) as i32
    let hi: i32 = rt.ld8(p, idx * 2 + 1) as i32
    return hi * 256 + lo
}

fn expect(name: str, rgb_max: i32, alpha_max: i32, alpha_bad_max: usize) {
    let path: str = "tests/data/jxl/fec/" + name + ".jxl"
    let ref_path: str = "tests/data/jxl/fec/" + name + ".pam"
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    var ref: rt.Buf = rt.buf_new()
    let rn: usize = fs.read_file(ref_path, &ref) catch 0
    check(n != 0 && rn != 0)
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let ok: bool = jxl.jxl_decode(rt.buf_ptr(&data), n, &pic) catch false
    check(ok)
    if ok {
        let total: usize = (pic.width as usize) * (pic.height as usize)
        let bps: u32 = pic.bytes_per_sample
        let off: usize = body_offset(&ref, rn, 7)
        let bytes: usize = total * 4 * (bps as usize)
        check(pic.channels == 4 && pic.size == bytes && rn >= off + bytes)
        if pic.size == bytes && rn >= off + bytes {
            let base: u64 = rt.buf_ptr(&ref) + (off as u64)
            var rgb_worst: i32 = 0
            var alpha_worst: i32 = 0
            var alpha_bad: usize = 0
            var i: usize = 0
            while i < total {
                var k: usize = 0
                while k < 4 {
                    var e: i32 = pic_sample(pic.data, bps, i * 4 + k) - sample(base, bps, i * 4 + k)
                    if e < 0 {
                        e = 0 - e
                    }
                    if k < 3 {
                        if e > rgb_worst {
                            rgb_worst = e
                        }
                    } else {
                        if e > alpha_worst {
                            alpha_worst = e
                        }
                        if e != 0 {
                            alpha_bad = alpha_bad + 1
                        }
                    }
                    k = k + 1
                }
                i = i + 1
            }
            check(rgb_worst <= rgb_max)
            check(alpha_worst <= alpha_max)
            check(alpha_bad <= alpha_bad_max)
        }
    }
    jxl.jxl_picture_free(&pic)
    rt.buf_free(&data)
    rt.buf_free(&ref)
}

fn main() -> i32 {
    expect("f32_md_1_1", 0, 0, 0)
    expect("f32_md_1_2", 0, 1, 12)
    expect("f32_md_1_4", 0, 0, 0)
    expect("f32_mx_1_1", 0, 0, 0)
    expect("f32_mx_1_2", 0, 1, 8)
    expect("f32_mx_2_4", 1, 0, 0)
    expect("f32_mx_1_8", 0, 1, 100)
    expect("f32_vd_1_2", 3, 1, 20)
    expect("f32_vd_1_8", 3, 0, 0)
    expect("f32_vd_2_2", 3, 0, 0)
    expect("f32_vd_2_4", 2, 0, 0)
    expect("h16_mx_1_2", 0, 0, 0)
    expect("h16_vd_2_4", 2, 1, 8)
    expect("f24_mx_1_4", 0, 0, 0)
    expect("i8_md_1_2", 0, 0, 0)
    expect("i8_md_1_4", 0, 0, 0)
    expect("i8_md_1_8", 0, 0, 0)
    return failures
}
