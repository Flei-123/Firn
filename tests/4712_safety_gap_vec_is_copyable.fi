// expect_exit: 0
// r899 (documents a NON-guarantee): Vec[T] is a struct of ptr/len/cap, i.e. a trivial type.
// `let w = v` copies it, passing it to a function does not move it, so no use-after-move error.
import std.rt
import std.vec

fn eat(v: Vec[i64]) -> usize {
    return vec_len[i64](&v)
}

fn main() -> i32 {
    if !gc_init() { return 9 }
    var v: Vec[i64] = vec_new[i64]()
    vec_push[i64](&v, 1)
    let a: usize = eat(v)
    let b: usize = vec_len[i64](&v)
    if a != 1 { return 1 }
    if b != 1 { return 2 }
    vec_free[i64](&v)
    return 0
}
