// expect_exit: 0
// tests/2762_mc_hud.fi -- mc_hud: blending, clipping, glyphs, text width, crosshair, hotbar, number formatting, debug lines.
// The pixel exact comparison with the python implementation is tools/mc/hud/run.sh.
import std.rt
import mc.mc_raster
import mc.mc_hud

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn px(r: *mut mc_raster.Raster, x: i32, y: i32) -> u32 {
    return mc_raster.raster_pixel(r, x, y)
}

// both frames have exactly the same pixels
fn same(a: *mut mc_raster.Raster, b: *mut mc_raster.Raster) -> bool {
    var i: usize = 0
    let n: usize = ((*a).w as usize) * ((*a).h as usize)
    while i < n {
        if rt.ld32((*a).color, i) != rt.ld32((*b).color, i) { return false }
        i = i + 1
    }
    return true
}

fn fixed_eq(v: f64, dec: i32, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    mc_hud.hud_push_fixed(&b, v, dec)
    var ok: bool = rt.buf_len(&b) == want.n
    var i: usize = 0
    while ok && i < want.n {
        if rt.buf_at(&b, i) != rt.ld8(want.p as u64, i) { ok = false }
        i = i + 1
    }
    rt.buf_free(&b)
    return ok
}

fn line_eq(d: *mut mc_hud.HudDebug, k: i32, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    mc_hud.hud_debug_line(d, k, &b)
    var ok: bool = rt.buf_len(&b) == want.n
    var i: usize = 0
    while ok && i < want.n {
        if rt.buf_at(&b, i) != rt.ld8(want.p as u64, i) { ok = false }
        i = i + 1
    }
    rt.buf_free(&b)
    return ok
}

fn count_white(r: *mut mc_raster.Raster, x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    var n: i32 = 0
    var y: i32 = y0
    while y < y1 {
        var x: i32 = x0
        while x < x1 {
            if px(r, x, y) == 0xFFFFFFFF as u32 { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main() -> i32 {
    var r: mc_raster.Raster = mc_raster.raster_new(200, 120)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    // blend: alpha 0 draws nothing, 255 copies, 128 mixes, clipping at all four edges
    mc_hud.hud_rect(&r, 10, 10, 4, 4, 0x00FFFFFF as u32)
    check(px(&r, 10, 10) == 0xFF000000 as u32, 1)
    mc_hud.hud_rect(&r, 10, 10, 4, 4, 0xFF0000FF as u32)
    check(px(&r, 10, 10) == 0xFF0000FF as u32 && px(&r, 13, 13) == 0xFF0000FF as u32 && px(&r, 14, 14) == 0xFF000000 as u32, 2)
    mc_hud.hud_rect(&r, 10, 10, 4, 4, 0x80FFFFFF as u32) // (255 * 128 + 0 * 127) / 255 = 128 on the blue channel, red (255*128+255*127)/255 = 255
    check(px(&r, 10, 10) == 0xFF80_80FF as u32, 3)
    mc_hud.hud_rect(&r, -5, -5, 8, 8, 0xFF00FF00 as u32)
    check(px(&r, 0, 0) == 0xFF00FF00 as u32 && px(&r, 2, 2) == 0xFF00FF00 as u32 && px(&r, 3, 3) == 0xFF000000 as u32, 4)
    mc_hud.hud_rect(&r, 195, 115, 20, 20, 0xFFFFFFFF as u32)
    check(px(&r, 199, 119) == 0xFFFFFFFF as u32 && px(&r, 194, 119) == 0xFF000000 as u32, 5)
    mc_hud.hud_rect(&r, 300, 300, 5, 5, 0xFFFFFFFF as u32) // completely outside: no crash
    // invert twice = identity
    mc_hud.hud_invert(&r, 50, 50, 3, 3)
    check(px(&r, 51, 51) == 0xFFFFFFFF as u32, 6)
    mc_hud.hud_invert(&r, 50, 50, 3, 3)
    check(px(&r, 51, 51) == 0xFF000000 as u32, 7)
    // text: 'I' (73) glyph has a bar in the middle column, text width, shadow
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_hud.hud_glyph(&r, 20, 20, 1, 0xFFFFFFFF as u32, 73 as u32)
    check(px(&r, 22, 20) == 0xFFFFFFFF as u32 && px(&r, 22, 23) == 0xFFFFFFFF as u32 && px(&r, 20, 23) == 0xFF000000 as u32, 8)
    check(mc_hud.hud_text_width(0, 2) == 0 && mc_hud.hud_text_width(1, 1) == 5 && mc_hud.hud_text_width(3, 2) == 34, 9)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_hud.hud_text(&r, 40, 40, 1, 0xFFFFFFFF as u32, 0xFF404040 as u32, "I")
    check(px(&r, 42, 40) == 0xFFFFFFFF as u32 && px(&r, 43, 41) == 0xFF404040 as u32, 10)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_hud.hud_glyph(&r, 20, 20, 1, 0xFFFFFFFF as u32, 200 as u32) // outside 32..126 -> '?'
    var q: mc_raster.Raster = mc_raster.raster_new(200, 120)
    mc_raster.raster_clear(&q, 0xFF000000 as u32)
    mc_hud.hud_glyph(&q, 20, 20, 1, 0xFFFFFFFF as u32, 63 as u32)
    check(same(&r, &q), 11)
    mc_raster.raster_free(&q)
    // crosshair: symmetric plus around the centre, inverted
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_hud.hud_crosshair(&r, 1)
    check(px(&r, 100, 60) == 0xFFFFFFFF as u32 && px(&r, 96, 60) == 0xFFFFFFFF as u32 && px(&r, 104, 60) == 0xFFFFFFFF as u32, 12)
    check(px(&r, 100, 56) == 0xFFFFFFFF as u32 && px(&r, 100, 64) == 0xFFFFFFFF as u32 && px(&r, 95, 60) == 0xFF000000 as u32 && px(&r, 101, 61) == 0xFF000000 as u32, 13)
    check(count_white(&r, 0, 0, 200, 120) == 17, 14)
    // hotbar: frame of the selected slot moves with the slot
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_hud.hud_hotbar(&r, 1, 0)
    let a0: i32 = count_white(&r, 0, 0, 200, 120)
    var r2: mc_raster.Raster = mc_raster.raster_new(200, 120)
    mc_raster.raster_clear(&r2, 0xFF000000 as u32)
    mc_hud.hud_hotbar(&r2, 1, 8)
    check(a0 > 100 && count_white(&r2, 0, 0, 200, 120) > 100 && count_white(&r2, 0, 0, 100, 120) < 20 && count_white(&r, 100, 0, 200, 120) < 20, 15)
    check(!same(&r, &r2), 16)
    mc_raster.raster_free(&r2)
    // numbers
    check(fixed_eq(12.3456, 3, "12.346") && fixed_eq(-3.5, 3, "-3.500") && fixed_eq(0.0, 3, "0.000") && fixed_eq(-0.0004, 3, "0.000"), 17)
    check(fixed_eq(99.95, 1, "100.0") && fixed_eq(45.0, 1, "45.0") && fixed_eq(7.0, 0, "7") && fixed_eq(2.5, 0, "3"), 18)
    check(fixed_eq(1.0e12, 3, "?") && fixed_eq(0.0 / 1.0e-300 - 0.0, 1, "0.0"), 19)
    var d: mc_hud.HudDebug = mc_hud.hud_debug_new()
    d.fps = 60
    d.x = 12.35
    d.y = 64.0
    d.z = -3.5
    d.yaw = 45.0
    d.pitch = -10.04
    check(line_eq(&d, 0, "FPS: 60") && line_eq(&d, 1, "XYZ: 12.350 64.000 -3.500") && line_eq(&d, 2, "Block: none"), 20)
    check(line_eq(&d, 3, "Face: -") && line_eq(&d, 4, "Yaw: 45.0 Pitch: -10.0"), 21)
    d.has_block = true
    d.bx = 12
    d.by = 63
    d.bz = -4
    d.id = 1
    d.ny = 1
    check(line_eq(&d, 2, "Block: 12 63 -4 (id 1)") && line_eq(&d, 3, "Face: +y"), 22)
    d.ny = 0
    d.nz = -1
    check(line_eq(&d, 3, "Face: -z"), 23)
    d.nz = 0
    check(line_eq(&d, 3, "Face: inside"), 24)
    // whole frame: flags select the parts (nothing selected = nothing drawn)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    var r3: mc_raster.Raster = mc_raster.raster_new(200, 120)
    mc_raster.raster_clear(&r3, 0xFF000000 as u32)
    mc_hud.hud_frame(&r, 1, 0 as u32, 3, &d)
    check(same(&r, &r3), 25)
    mc_hud.hud_frame(&r, 1, mc_hud.HUD_DEBUG, 3, &d)
    check(!same(&r, &r3), 26)
    check(mc_hud.hud_scale(640, 360) == 1 && mc_hud.hud_scale(1920, 1080) == 4 && mc_hud.hud_scale(10, 10) == 1 && mc_hud.hud_scale(1280, 720) == 3, 27)
    mc_raster.raster_free(&r3)
    mc_raster.raster_free(&r)
    return 0
}
