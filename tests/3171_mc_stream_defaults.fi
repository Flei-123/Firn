// expect_exit: 0
// tests/3171_mc_stream_defaults.fi -- r187: the stream scheduling defaults. 8 submits / 16 in flight per frame made the frame
// loop (not the workers) the limit of the mesh pipeline (tools/mc/perf/stream_scale.sh: 1..4 workers all ~same wall time);
// the defaults are 32 / 64 now (still bounded by snap_budget_us and the records STREAM_NREC).
import std.rt
import mc.mc_mesh
import mc.mc_terrain
import mc.mc_stream

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_terrain.terrain_tables(&tb)
    var s: mc_stream.Stream = mc_stream.stream_new(0, 6, 4, &tb, 0)
    check(s.max_submit == 32, 1)
    check(s.max_inflight == 64, 2)
    check(s.max_inflight <= mc_stream.STREAM_NREC, 3)
    check(s.max_submit <= s.max_inflight, 4)
    check(s.snap_budget_us > 0 as u64 && s.upload_budget_us > 0 as u64, 5)
    return 0
}
