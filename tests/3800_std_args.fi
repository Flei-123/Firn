// expect_exit: 0
// tests/3800_std_args.fi -- std.args against Python 3.11 argparse: the parse
// results, the exact help texts and error texts (expected strings taken from
// argparse), and a deterministic fuzz (random words: no crash, status is one
// of OK/HELP/ERROR). The wider comparison is tools/vspy/check_sys.sh.
import std.rt
import std.args
import std.testkit

fn build(p: *mut args.Cmd) {
    let add: *mut args.Cmd = args.sub(p, "add", "add an item")
    args.opt(add, "--name", args.STR | args.REQUIRED, "", "item name")
    args.opt(add, "--count", args.INT, "1", "how many")
    args.opt(add, "-v,--verbose", args.FLAG, "", "verbose output")
    let rm: *mut args.Cmd = args.sub(p, "rm", "remove an item")
    args.pos(rm, "id", args.INT, "item id")
    args.opt(rm, "--force", args.FLAG, "", "no questions")
}

fn text_is(line: str, status: i32, text: str, what: str) {
    var p: args.Cmd = args.cmd("tool", "item tool")
    build(&p)
    let r: args.Result = args.parse_words(&p, line)
    testkit.check(r.status == status && r.text == text, what)
}

static mut SEED: u64 = 12345

fn rnd(n: u64) -> u64 {
    SEED = SEED *% 6364136223846793005 +% 1442695040888963407
    return (SEED >> 33) % n
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var p: args.Cmd = args.cmd("tool", "item tool")
    build(&p)
    var r: args.Result = args.parse_words(&p, "add --name X --count 3 -v")
    testkit.check(r.status == args.OK && r.cmd == "add", "add parses")
    testkit.check(args.get(&r, "name") == "X" && args.get_int(&r, "count") == 3 && args.is_set(&r, "verbose"), "add values")
    r = args.parse_words(&p, "add --name=Y --count -5")
    testkit.check(r.status == args.OK && args.get(&r, "name") == "Y" && args.get_int(&r, "count") == -5 && !args.is_set(&r, "verbose"), "= form, negative number as value")
    r = args.parse_words(&p, "add --name Y")
    testkit.check(args.get_int(&r, "count") == 1, "default value")
    r = args.parse_words(&p, "rm 7 --force")
    testkit.check(r.cmd == "rm" && args.get_int(&r, "id") == 7 && args.is_set(&r, "force"), "positional and flag")

    text_is("add --name Z --count abc", args.ERROR, "tool add: error: argument --count: invalid int value: 'abc'", "invalid int")
    text_is("add", args.ERROR, "tool add: error: the following arguments are required: --name", "required option")
    text_is("frob", args.ERROR, "tool: error: argument cmd: invalid choice: 'frob' (choose from 'add', 'rm')", "invalid choice")
    text_is("add --name Q --bogus", args.ERROR, "tool: error: unrecognized arguments: --bogus", "unrecognized")
    text_is("rm", args.ERROR, "tool rm: error: the following arguments are required: id", "required positional")
    text_is("", args.ERROR, "tool: error: the following arguments are required: cmd", "sub command required")
    text_is("add --name", args.ERROR, "tool add: error: argument --name: expected one argument", "missing value")
    text_is("add --help", args.HELP, "usage: tool add [-h] --name NAME [--count COUNT] [-v]\n\noptions:\n  -h, --help     show this help message and exit\n  --name NAME    item name\n  --count COUNT  how many\n  -v, --verbose  verbose output", "help of a sub command")
    text_is("--help", args.HELP, "usage: tool [-h] {add,rm} ...\n\nitem tool\n\npositional arguments:\n  {add,rm}\n    add       add an item\n    rm        remove an item\n\noptions:\n  -h, --help  show this help message and exit", "help of the program")

    // fuzz: random words from a small alphabet, many shapes
    let words: [str; 12] = ["add", "rm", "--name", "--count", "-v", "--force", "7", "x", "--help", "-5", "--name=a", "--bogus"]
    var bad: u32 = 0
    for k in 0..3000 {
        var line: rt.Buf = rt.buf_new()
        let n: u64 = rnd(7)
        for j in 0..n {
            if j > 0 {
                rt.buf_push(&line, 32 as u8)
            }
            let w: str = words[rnd(12) as usize]
            rt.buf_push_bytes(&line, w.p as u64, w.n)
        }
        let q: args.Result = args.parse_words(&p, str { p: rt.buf_data(&line), n: rt.buf_len(&line) })
        if q.status != args.OK && q.status != args.HELP && q.status != args.ERROR {
            bad = bad + 1
        }
        if q.status != args.OK && q.text.length() == 0 {
            bad = bad + 1
        }
        rt.buf_free(&line)
    }
    testkit.check(bad == 0, "fuzz: 3000 random command lines, always a status and a text")
    return testkit.finish()
}
