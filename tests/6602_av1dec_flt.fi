static OFFSETS: [i64; 5] = [
    0, 1352, 2640, 3382, 4750
]

static HASHES: [i64; 4] = [
    1281724903, 1657761083, 1569896875, 1977419328
]

static LENGTHS: [i64; 4] = [
    18432, 18432, 115200, 18432
]

fn hash_bytes(p: u64, n: usize) -> i64 {
    var h: i64 = 0
    var i: usize = 0
    while i < n {
        h = (h * 31 + vp9mem.ld8(p, i)) & 2147483647
        i = i + 1
    }
    return h
}

fn check_clip(k: usize) -> bool {
    let start: i64 = OFFSETS[k]
    let n: usize = (OFFSETS[k + 1] - start) as usize
    let buf: u64 = vp9mem.alloc(n)
    var i: usize = 0
    while i < n {
        vp9mem.st8(buf, i, CLIPS[(start as usize) + i] as i64)
        i = i + 1
    }
    var out: rt.Buf = rt.buf_new()
    let d: *mut av1dec.Decoder = av1dec.dec_new()
    av1dec.dec_stream(d, &out, buf, n)
    var ok: bool = (*d).err == 0 && (*d).frames_out == 1 && (rt.buf_len(&out) as i64) == LENGTHS[k]
    if ok {
        ok = hash_bytes(rt.buf_ptr(&out), rt.buf_len(&out)) == HASHES[k]
    }
    av1dec.dec_free(d)
    vp9mem.free(buf, n)
    return ok
}

fn main() -> i32 {
    var k: usize = 0
    while k < 4 {
        if !check_clip(k) {
            return (k as i32) + 1
        }
        k = k + 1
    }
    return 0
}
