// expect_exit: 97
// Integer patterns: literals, half-open and inclusive range, '_'.
fn class(n: i32) -> i32 {
    var r: i32 = 0
    match n {
        0 => { r = 1 as i32 }
        1..4 => { r = 2 as i32 }
        4..= 9 => { r = 3 as i32 }
        -5..= -1 => { r = 4 as i32 }
        _ => { r = 5 as i32 }
    }
    return r
}

fn main() -> i32 {
    var sum: i32 = 0
    sum = sum + class(0 as i32) * 1 as i32
    sum = sum + class(2 as i32) * 2 as i32
    sum = sum + class(3 as i32) * 3 as i32
    sum = sum + class(4 as i32) * 4 as i32
    sum = sum + class(9 as i32) * 5 as i32
    sum = sum + class(-3 as i32) * 6 as i32
    sum = sum + class(100 as i32) * 7 as i32
    return sum
}
