// expect_exit: 0
// tests/4343_with_stmt.fi -- r749: `with NAME = expr { .. }` is `{ let NAME = expr; defer NAME.close(); .. }`
// (parser desugar). Several bindings close in reverse order; `with` stays a usable identifier.
import std.io

static mut closed: i64 = 0
static mut order: i64 = 0

struct Res {
    id: i64,
    live: i64,
}

impl Res {
    fn close(*mut self) {
        order = order * 10 + (*self).id
        closed = closed + 1
    }
}

fn open_res(id: i64) -> Res {
    return Res { id: id, live: 1 }
}

fn early(flag: i64) -> i64 {
    with r = open_res(7) {
        if flag != 0 {
            return r.live + 100
        }
    }
    return 5
}

fn main() -> i32 {
    var with: i64 = 3
    with = with + 1
    // single binding: closed when the block is left
    var seen: i64 = 0
    with r = open_res(1) {
        seen = r.id + r.live
        if closed != 0 {
            return 1
        }
    }
    if seen != 2 || closed != 1 || order != 1 {
        return 2
    }
    // two bindings: reverse order of closing
    with a = open_res(2), b = open_res(3) {
        seen = a.id * 10 + b.id
    }
    if seen != 23 || closed != 3 || order != 1 * 100 + 3 * 10 + 2 {
        return 3
    }
    // return inside the block still closes
    if early(1) != 101 || closed != 4 || order != 1327 {
        return 4
    }
    if early(0) != 5 || closed != 5 {
        return 5
    }
    // the name is local to the block: shadowing outside is fine
    let r: i64 = 9
    with r = open_res(4) {
        seen = r.id
    }
    if r != 9 || seen != 4 || with != 4 {
        return 6
    }
    // break/continue leave the block too
    var i: i64 = 0
    while i < 3 {
        i = i + 1
        with q = open_res(5) {
            if i == 2 {
                continue
            }
            if i == 3 {
                break
            }
        }
    }
    if closed != 9 {
        return 7
    }
    return 0
}
