// expect_exit: 0
// tests/4043_vec_of_fn.fi -- Vec[fn(..)] holds function values and lambdas (r716).
import std.vec

fn inc(a: i32) -> i32 { return a + 1 }

fn main() -> i32 {
    var v: Vec[fn(i32) -> i32] = vec_new[fn(i32) -> i32]()
    defer vec_free[fn(i32) -> i32](&v)
    vec_push[fn(i32) -> i32](&v, inc)
    vec_push[fn(i32) -> i32](&v, |x| x * 10)
    let f0: fn(i32) -> i32 = vec_at[fn(i32) -> i32](&v, 0)
    let f1: fn(i32) -> i32 = vec_at[fn(i32) -> i32](&v, 1)
    if f0(1) != 2 { return 1 }
    if f1(4) != 40 { return 2 }
    return 0
}
