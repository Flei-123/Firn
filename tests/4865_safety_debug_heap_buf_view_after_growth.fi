// expect_exit: 139
// wasm_skip: page protection does not exist in the wasm linear memory
// not_mode: opt
// only_target: x86_64
// N8 in debug heap mode: a str view of a Buf read after the Buf grew faults (SIGSEGV 139).
import std.rt

fn main() -> i32 {
    rt.heap_debug_enable()
    if !gc_init() { return 1 }
    var b: rt.Buf = rt.buf_new()
    rt.buf_push(&b, 65 as u8)
    let s: str = rt.buf_str(&b)
    var i: u64 = 0
    while i < 100000 {
        rt.buf_push(&b, 66 as u8)
        i = i + 1
    }
    let c: u8 = *(s.p)
    if c == 65 { return 0 }
    return 1
}
