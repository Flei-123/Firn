// expect_exit: 0
// tests/4841_shellthread_frames.fi -- lib/window/shellthread: frame buffer pool (at most 4 in flight, size changes, reuse after the shell hands one back), checked without depending on whether a window could open.
import std.rt
import window.shellthread
import window.shellproto

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == shellproto.SHELL_KIND {
        return shellthread.shell_main(arg)
    }
    return 9
}

fn check(c: bool, code: i64) {
    if !c {
        rt.finish(code)
    }
}

fn main() -> i32 {
    let sh: u64 = shellthread.shell_start("frames", 200, 100)
    check(sh != 0, 1)
    let opened: bool = shellthread.shell_wait_open(sh, 8000)
    var p: [u64; 5] = [0; 5]
    var i: usize = 0
    while i < 4 {
        p[i] = shellthread.shell_frame_acquire(sh, 64, 48)
        check(p[i] != 0, 10 + i as i64)
        rt.st32(p[i], 0, (i + 1) as u32)
        i = i + 1
    }
    check(p[0] != p[1] && p[1] != p[2] && p[2] != p[3], 2)
    check(shellthread.shell_frame_acquire(sh, 64, 48) == 0, 3)
    check(shellthread.shell_frame_acquire(sh, 0, 48) == 0, 4)
    check(shellthread.shell_frame_submit(sh, p[0], 64, 48), 5)
    check(!shellthread.shell_frame_submit(sh, 12345, 64, 48), 6)
    if opened {
        var waited: u64 = 0
        var got: u64 = 0
        while got == 0 && waited < 4000 {
            thread_sleep(5)
            waited = waited + 5
            got = shellthread.shell_frame_acquire(sh, 640, 480)
        }
        check(got != 0, 7)
        check(shellthread.shell_stat(sh, shellproto.STAT_SHOWN) >= 1, 8)
        rt.st32(got, 0, 7 as u32)
        check(shellthread.shell_frame_submit(sh, got, 640, 480), 9)
    }
    shellthread.shell_stop(sh)
    return 0
}
