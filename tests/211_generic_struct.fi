// expect_exit: 54
// Generic struct Vec[T] with a fixed capacity, two instances.
struct Vec[T] { data: [T; 8], len: usize }

fn vec_new[T: Scalar](v: *mut Vec[T]) {
    (*v).len = 0 as usize
}

fn vec_push[T: Scalar](v: *mut Vec[T], x: T) -> bool {
    if (*v).len >= 8 as usize { return false }
    (*v).data[(*v).len] = x
    (*v).len = (*v).len + 1 as usize
    return true
}

fn vec_get[T: Scalar](v: *mut Vec[T], i: usize) -> T {
    return (*v).data[i]
}

fn vec_len[T: Scalar](v: *mut Vec[T]) -> usize {
    return (*v).len
}

fn main() -> i32 {
    var vi: Vec[i32] = Vec[i32] { data: [0, 0, 0, 0, 0, 0, 0, 0], len: 0 as usize }
    var vb: Vec[u8] = Vec[u8] { data: [0, 0, 0, 0, 0, 0, 0, 0], len: 0 as usize }
    vec_new[i32](&vi)
    vec_new[u8](&vb)
    var i: i32 = 1
    while i <= 5 as i32 {
        let ok = vec_push[i32](&vi, i * 3 as i32)
        i = i + 1 as i32
    }
    let ok2 = vec_push[u8](&vb, 8 as u8)
    var sum: i32 = 0
    var k: usize = 0 as usize
    while k < vec_len[i32](&vi) {
        sum = sum + vec_get[i32](&vi, k)
        k = k + 1 as usize
    }
    return sum + vec_get[u8](&vb, 0 as usize) as i32 + vec_len[u8](&vb) as i32
}
