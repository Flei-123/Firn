// expect_exit: 42
// #[no_gc] (SPEC 3.5.4): a call tree over four levels, every level marked.
// That is exactly what a hot path should look like -- tokenizer, rasteriser,
// crypto. If the tree compiles, the promise holds: in none of the four
// functions can a collection be triggered.
#[no_gc]
fn ebene4(x: i32) -> i32 {
    return x + 1 as i32
}

#[no_gc]
fn ebene3(x: i32) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    while i < 3 as i32 {
        s = s + ebene4(x)
        i = i + 1
    }
    return s
}

#[no_gc]
fn ebene2(x: i32) -> i32 {
    if x > 0 as i32 {
        return ebene3(x)
    }
    return ebene3(0 as i32)
}

#[no_gc]
fn ebene1(x: i32) -> i32 {
    return ebene2(x) + ebene2(0 as i32)
}

// Not marked: an ordinary function MAY call a #[no_gc] function
// call a #[no_gc] function. Only the other direction is forbidden.
fn main() -> i32 {
    let a = ebene1(12 as i32)
    // ebene1(12) = (3*13) + (3*1) = 42
    return a
}
