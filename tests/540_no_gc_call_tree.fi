// expect_exit: 42
// #[no_gc] (SPEC §3.5.4): ein Aufrufbaum ueber vier Ebenen, jede Ebene
// markiert. Genau so soll ein heisser Pfad aussehen — Tokenizer, Rasterizer,
// Krypto. Uebersetzt der Baum, ist die Zusage gehalten: in keiner der vier
// Funktionen kann ein Sammellauf ausgeloest werden.
#[no_gc]
fn ebene4(x: i32) -> i32 {
    return x + 1 as i32
}

#[no_gc]
fn ebene3(x: i32) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    while i < 3 as i32 {
        s = s + ebene4(x)
        i = i + 1
    }
    return s
}

#[no_gc]
fn ebene2(x: i32) -> i32 {
    if x > 0 as i32 {
        return ebene3(x)
    }
    return ebene3(0 as i32)
}

#[no_gc]
fn ebene1(x: i32) -> i32 {
    return ebene2(x) + ebene2(0 as i32)
}

// Nicht markiert: eine gewoehnliche Funktion DARF eine #[no_gc]-Funktion
// rufen. Verboten ist nur die Gegenrichtung.
fn main() -> i32 {
    let a = ebene1(12 as i32)
    // ebene1(12) = (3*13) + (3*1) = 42
    return a
}
