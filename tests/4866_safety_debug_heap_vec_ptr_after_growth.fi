// expect_exit: 139
// wasm_skip: page protection does not exist in the wasm linear memory
// not_mode: opt
// only_target: x86_64
// N9 in debug heap mode: a pointer to a Vec element read after the Vec grew faults (SIGSEGV 139).
import std.rt
import std.vec

fn main() -> i32 {
    rt.heap_debug_enable()
    if !gc_init() { return 9 }
    var v: Vec[i64] = vec_new[i64]()
    vec_push[i64](&v, 7)
    let p: *mut i64 = &v[0]
    var i: i64 = 0
    while i < 100000 {
        vec_push[i64](&v, i)
        i = i + 1
    }
    let r: i64 = *p
    if r == 7 { return 0 }
    return 1
}
