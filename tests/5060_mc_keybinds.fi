// expect_exit: 0
import std.rt
import std.fs
import mc.mc_keybinds
import mc.mc_keynames
import mc.mc_input

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn same(a: str, b: str) -> bool {
    if a.length() != b.length() { return false }
    var i: usize = 0
    while i < a.length() {
        if a.chars(i) != b.chars(i) { return false }
        i = i + 1
    }
    return true
}

fn label_is(kb: *mut mc_keybinds.Keybinds, action: i32, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    mc_keybinds.kb_key_label(kb, action, &b)
    var ok: bool = rt.buf_len(&b) == want.length()
    var i: usize = 0
    while ok && i < want.length() {
        if rt.buf_at(&b, i) != want.chars(i) { ok = false }
        i = i + 1
    }
    rt.buf_free(&b)
    return ok
}

fn main() -> i32 {
    var kb: mc_keybinds.Keybinds = mc_keybinds.kb_new()
    check(mc_keybinds.kb_count() == 34, 1)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_FORWARD) == 17, 2)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_LEFT) == 30, 3)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_BACK) == 31, 4)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_RIGHT) == 32, 5)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_JUMP) == 57, 6)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_SNEAK) == 42, 7)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_SPRINT) == 29, 8)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_ATTACK) == 256, 9)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_USE) == 257, 10)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_PICK) == 258, 11)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_INVENTORY) == 18, 12)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_DROP) == 16, 13)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_SWAP) == 33, 14)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_CHAT) == 20, 15)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_COMMAND) == 53, 16)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_PLAYERLIST) == 15, 17)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_SCREENSHOT) == 60, 18)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_PERSPECTIVE) == 63, 19)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_FULLSCREEN) == 87, 20)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_SMOOTH) == 0, 21)
    var h: i32 = 0
    while h < 9 {
        check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_HOTBAR1 + h) == 2 + h, 30 + h)
        h = h + 1
    }
    check(same(mc_keybinds.kb_name(mc_keybinds.KB_FORWARD), "key.forward"), 40)
    check(same(mc_keybinds.kb_name(mc_keybinds.KB_HOTBAR1 + 8), "key.hotbar.9"), 41)
    check(same(mc_keybinds.kb_name(mc_keybinds.KB_SPECTATOR_OUTLINES), "key.spectatorOutlines"), 42)
    check(same(mc_keybinds.kb_category(mc_keybinds.KB_ATTACK), "key.categories.gameplay"), 43)
    check(same(mc_keybinds.kb_category(mc_keybinds.KB_FULLSCREEN), "key.categories.misc"), 44)
    check(mc_keybinds.kb_find("key.jump") == mc_keybinds.KB_JUMP, 45)
    check(mc_keybinds.kb_find("key.nothing") == mc_keybinds.KB_NONE, 46)
    var a: i32 = 0
    while a < mc_keybinds.kb_count() {
        check(mc_keybinds.kb_find(mc_keybinds.kb_name(a)) == a, 50)
        check(mc_keybinds.kb_conflict(&kb, a) == mc_keybinds.KB_NONE, 51)
        check(mc_keybinds.kb_is_default(&kb, a), 52)
        a = a + 1
    }
    check(mc_keybinds.kb_move_bits(&kb, 17) == mc_input.K_FORWARD, 60)
    check(mc_keybinds.kb_move_bits(&kb, 29) == mc_input.K_SPRINT, 61)
    check(mc_keybinds.kb_move_bits(&kb, 18) == 0, 62)
    check(mc_keybinds.kb_set(&kb, mc_keybinds.KB_FORWARD, 103), 63)
    check(mc_keybinds.kb_move_bits(&kb, 17) == 0, 64)
    check(mc_keybinds.kb_move_bits(&kb, 103) == mc_input.K_FORWARD, 65)
    check(mc_keybinds.kb_action_of(&kb, 103) == mc_keybinds.KB_FORWARD, 66)
    check(!mc_keybinds.kb_is_default(&kb, mc_keybinds.KB_FORWARD), 67)
    check(mc_keybinds.kb_set(&kb, mc_keybinds.KB_JUMP, 103), 68)
    check(mc_keybinds.kb_conflict(&kb, mc_keybinds.KB_JUMP) == mc_keybinds.KB_FORWARD, 69)
    check(mc_keybinds.kb_move_bits(&kb, 103) == (mc_input.K_FORWARD | mc_input.K_JUMP), 70)
    check(!mc_keybinds.kb_set(&kb, 99, 5), 71)
    check(!mc_keybinds.kb_set(&kb, 0, 1000), 72)
    check(!mc_keybinds.kb_set(&kb, 0, 0 - 1), 73)
    check(mc_keybinds.kb_reset(&kb, mc_keybinds.KB_JUMP), 74)
    check(mc_keybinds.kb_get(&kb, mc_keybinds.KB_JUMP) == 57, 75)
    check(mc_keybinds.kb_set(&kb, mc_keybinds.KB_SPRINT, 0), 76)
    check(mc_keybinds.kb_move_bits(&kb, 29) == 0, 77)
    check(label_is(&kb, mc_keybinds.KB_SPRINT, "Not bound"), 78)
    check(label_is(&kb, mc_keybinds.KB_FORWARD, "Up"), 79)
    check(label_is(&kb, mc_keybinds.KB_ATTACK, "Left Button"), 80)
    check(label_is(&kb, mc_keybinds.KB_SNEAK, "Left Shift"), 81)
    check(mc_keybinds.kb_set(&kb, mc_keybinds.KB_SWAP, 257), 82)
    check(mc_keybinds.kb_set(&kb, mc_keybinds.KB_CHAT, 259), 83)

    var text: rt.Buf = rt.buf_new()
    mc_keybinds.kb_text(&kb, &text)
    var back: mc_keybinds.Keybinds = mc_keybinds.kb_new()
    mc_keybinds.kb_parse(&back, rt.buf_ptr(&text), rt.buf_len(&text))
    a = 0
    while a < mc_keybinds.kb_count() {
        check(mc_keybinds.kb_get(&back, a) == mc_keybinds.kb_get(&kb, a), 90)
        a = a + 1
    }
    check(mc_keybinds.kb_get(&back, mc_keybinds.KB_SPRINT) == 0, 91)
    check(mc_keybinds.kb_get(&back, mc_keybinds.KB_FORWARD) == 103, 92)
    rt.buf_free(&text)

    var fresh: mc_keybinds.Keybinds = mc_keybinds.kb_new()
    var empty: rt.Buf = rt.buf_new()
    mc_keybinds.kb_text(&fresh, &empty)
    check(rt.buf_len(&empty) == 0, 93)
    rt.buf_free(&empty)

    let junk: str = "key.forward=abc\nkey.jump=999\n# key.sneak=5\nkey.sneak=6\nkey.unknown=3\n"
    mc_keybinds.kb_parse(&fresh, junk.p as u64, junk.n)
    check(mc_keybinds.kb_get(&fresh, mc_keybinds.KB_FORWARD) == 17, 94)
    check(mc_keybinds.kb_get(&fresh, mc_keybinds.KB_JUMP) == 57, 95)
    check(mc_keybinds.kb_get(&fresh, mc_keybinds.KB_SNEAK) == 6, 96)

    mc_keybinds.kb_reset_all(&kb)
    a = 0
    while a < mc_keybinds.kb_count() {
        check(mc_keybinds.kb_is_default(&kb, a), 100)
        a = a + 1
    }

    let base: str = "/tmp/mc_keybinds_test_5060.cfg"
    check(mc_keybinds.kb_set(&fresh, mc_keybinds.KB_INVENTORY, 24), 110)
    check(mc_keybinds.kb_save(base, &fresh), 111)
    var loaded: mc_keybinds.Keybinds = mc_keybinds.kb_new()
    check(mc_keybinds.kb_load(base, &loaded), 112)
    check(mc_keybinds.kb_get(&loaded, mc_keybinds.KB_INVENTORY) == 24, 113)
    check(mc_keybinds.kb_get(&loaded, mc_keybinds.KB_SNEAK) == 6, 114)
    fs.remove(base) catch false
    return 0
}
