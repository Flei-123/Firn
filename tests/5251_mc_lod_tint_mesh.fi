// expect_exit: 0
import std.rt
import mc.mc_chunk
import mc.mc_mesh
import mc.mc_terrain
import mc.mc_render_world
import mc.mc_lod
import mc.mc_lod_tint

const NSEC: i32 = 4

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn make_col(ids: u64, biome: u16) -> u64 {
    var y: i32 = 0
    while y < NSEC * 16 {
        let s: i32 = y / 16
        let ly: i32 = y - s * 16
        var z: i32 = 0
        while z < 16 {
            var x: i32 = 0
            while x < 16 {
                var id: u16 = 0 as u16
                if y < 20 { id = 3 as u16 }
                rt.st16(ids, (s * 4096 + (ly * 16 + z) * 16 + x) as usize, id)
                x = x + 1
            }
            z = z + 1
        }
        y = y + 1
    }
    let ch: u64 = mc_render_world.wr_make_chunk(0, 0, NSEC as usize, ids)
    var s: usize = 0
    while s < NSEC as usize {
        let sec: *mut mc_chunk.Section = mc_chunk.chunk_section(ch as *mut mc_chunk.Chunk, s)
        let pal: u64 = rt.heap_alloc(2)
        rt.st16(pal, 0, biome)
        (*sec).biomes = mc_chunk.Container { bits: 0 as u32, pal_n: 1 as u32, pal: pal, data: 0, words: 0 }
        s = s + 1
    }
    return ch
}

fn all_top_tiles(m: *mut mc_mesh.Mesher, want: u32) -> bool {
    var k: usize = 0
    while k < (*m).nverts as usize {
        let w0: u32 = rt.ld32((*m).verts, k * 2)
        if mc_mesh.vtx_face(w0) == 3 as u32 && mc_mesh.vtx_tile(rt.ld32((*m).verts, k * 2 + 1)) != want { return false }
        k = k + 1
    }
    return true
}

fn main() -> i32 {
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_terrain.terrain_tables(&tb)
    mc_lod_tint.twin_clear(tb.tiles)
    mc_lod_tint.twin_mark(tb.tiles, 3 as u32, mc_lod_tint.CLS_GRASS)
    check(mc_lod_tint.twin_assign(tb.tiles, 200 as u32) == 8, 1)

    let btab: u64 = rt.heap_alloc(3 * mc_lod_tint.MAP_IDS * 4)
    rt.mem_set(btab, 0 as u8, 3 * mc_lod_tint.MAP_IDS * 4)
    rt.st32(btab, 5, 0x1000000 as u32 + 0x80B497 as u32)
    rt.st32(btab, 6, 0x1000000 as u32 + 0xBEB955 as u32)
    let pmap: u64 = rt.heap_alloc(2 * mc_lod_tint.MAP_IDS)
    mc_lod_tint.map_build(btab, pmap)

    let ids: u64 = rt.heap_alloc(NSEC as usize * 4096 * 2)
    let hs: u64 = rt.heap_alloc(512)
    let hi: u64 = rt.heap_alloc(512)
    let hb: u64 = rt.heap_alloc(512)
    let bh: u64 = rt.heap_alloc(512)
    let bi: u64 = rt.heap_alloc(512)
    let bb: u64 = rt.heap_alloc(512)
    var m: mc_mesh.Mesher = mc_mesh.mesher_new()

    let c5: u64 = make_col(ids, 5 as u16)
    check(c5 != 0, 2)
    mc_lod.lod_heights_bio(c5 as *mut mc_chunk.Chunk, &tb, hs, hi, hb)
    var k: usize = 0
    while k < 256 {
        check(rt.ld16(hs, k) == 20 as u16 && rt.ld16(hi, k) == 3 as u16 && rt.ld16(hb, k) == 5 as u16, 3)
        k = k + 1
    }
    mc_lod.lod_bin_bio(hs, hi, hb, 4, bh, bi, bb)
    let y0: i32 = mc_lod.lod_mesh_tint(&m, &tb, 4, bh, bi, bb, pmap, 0)
    check(y0 == 20, 5)
    check(m.nquads == 16 as u32, 6)
    check(all_top_tiles(&m, 202 as u32), 7)

    mc_lod.lod_mesh_tint(&m, &tb, 4, bh, bi, bb, 0, 0)
    check(all_top_tiles(&m, 3 as u32), 8)
    mc_lod.lod_mesh(&m, &tb, 4, bh, bi, 0)
    check(all_top_tiles(&m, 3 as u32), 9)

    let c6: u64 = make_col(ids, 6 as u16)
    mc_lod.lod_heights_bio(c6 as *mut mc_chunk.Chunk, &tb, hs, hi, hb)
    mc_lod.lod_bin_bio(hs, hi, hb, 4, bh, bi, bb)
    mc_lod.lod_mesh_tint(&m, &tb, 4, bh, bi, bb, pmap, 0)
    check(all_top_tiles(&m, 207 as u32), 10)

    mc_lod.lod_heights(c6 as *mut mc_chunk.Chunk, &tb, hs, hi)
    mc_lod.lod_bin(hs, hi, 4, bh, bi)
    mc_lod.lod_mesh_tint(&m, &tb, 4, bh, bi, 0, pmap, 0)
    check(all_top_tiles(&m, 204 as u32), 11)
    return 0
}
