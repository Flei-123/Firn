// expect_exit: 0
import std.rt
import mc.mc_cull

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    var c: mc_cull.Cull = mc_cull.cull_new(-64, 24)
    let g0: u64 = c.gen
    mc_cull.cull_set(&c, 1, 3, 2, 0x0F as u32)
    check(c.gen == g0 + 1 as u64, 1)
    mc_cull.cull_set(&c, 1, 3, 2, 0x0F as u32)
    check(c.gen == g0 + 1 as u64, 2)
    mc_cull.cull_set(&c, 1, 3, 2, 0x1F as u32)
    check(c.gen == g0 + 2 as u64, 3)
    check(mc_cull.cull_get(&c, 1, 3, 2) == 0x1F as u32, 4)
    mc_cull.cull_set(&c, 1, 4, 2, 0x1F as u32)
    check(c.gen == g0 + 3 as u64, 5)
    mc_cull.cull_remove_column(&c, 1, 2)
    check(c.gen == g0 + 4 as u64, 6)
    check(mc_cull.cull_get(&c, 1, 3, 2) == 0xFFFFFFFF as u32, 7)
    mc_cull.cull_set(&c, 1, 3, 2, 0x1F as u32)
    check(c.gen == g0 + 5 as u64, 8)
    check(mc_cull.cull_get(&c, 1, 3, 2) == 0x1F as u32, 9)
    mc_cull.cull_free(&c)
    return 0
}
