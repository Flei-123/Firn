// expect_exit: 42
import rt.rt
import av1.avif
import av1.av1fhx
import std.fs

fn dec(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v as u64)
    let s: str = __str_copy(rt.buf_str(&b))
    rt.buf_free(&b)
    return s
}

fn cell(info: u64, i: usize) -> i64 {
    return avif.avif_cell(info, avif.FH_BASE + i)
}

fn headers_text(name: str) -> str {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(name, &data) catch 0
    if n == 0 {
        return "read failed"
    }
    let src: u64 = rt.buf_ptr(&data)
    let info: u64 = avif.avif_obu_open(src, n)
    if info == 0 {
        return "open failed"
    }
    var text: str = ""
    var at: usize = 0
    while at < n {
        let nx: i64 = avif.avif_obu_next(src, n, info, at)
        if nx < 0 {
            return "bad obu"
        }
        at = nx as usize
        if cell(info, avif.FH_NEW_FRAME) == 0 {
            continue
        }
        text = text + dec(cell(info, avif.FH_OK)) + "," + dec(cell(info, avif.FH_FRAME_TYPE)) + "," + dec(cell(info, avif.FH_SHOW_EXISTING)) + "," + dec(cell(info, av1fhx.FH_PRIMARY_REF)) + "," + dec(cell(info, avif.FH_REFRESH)) + "," + dec(cell(info, avif.FH_ORDER_HINT)) + "," + dec(cell(info, avif.FH_HDR_BITS)) + ","
        var i: usize = 0
        while i < 7 {
            text = text + dec(cell(info, av1fhx.FH_REF_IDX + i))
            i = i + 1
        }
        text = text + ";"
        avif.avif_ref_update(info, cell(info, avif.FH_REFRESH))
    }
    avif.avif_info_free(info)
    rt.buf_free(&data)
    return text
}

fn main() -> i32 {
    if headers_text("tests/data/av1/inter/lag8.obu") != "1,0,0,7,255,0,82,0000000;1,1,0,7,2,1,130,0000000;1,1,0,0,4,2,142,1000000;1,1,0,0,8,3,142,2100000;1,1,0,7,16,4,142,3210000;1,1,0,0,32,5,130,3214000;1,1,0,0,64,6,130,5324010;1,1,0,0,128,7,142,6534021;1,1,0,4,2,8,133,7654032;1,1,0,5,1,11,134,7651043;1,1,0,7,4,9,131,7651430;1,1,0,0,8,10,131,2761540;1,1,0,0,0,11,130,3271460;" { return 1 }
    if headers_text("tests/data/av1/inter/errres.obu") != "1,0,0,7,255,0,85,0000000;1,1,0,7,2,1,306,0000000;1,1,0,7,4,2,294,0001000;1,1,0,7,8,3,294,1002000;1,1,0,7,16,4,294,2103000;1,1,0,7,32,5,282,3214000;" { return 2 }
    if headers_text("tests/data/av1/inter/gmv.obu") != "1,0,0,7,255,0,82,0000000;1,1,0,7,2,1,118,0000000;1,1,0,7,4,2,118,1000000;1,1,0,0,8,3,118,1002000;1,1,0,6,16,4,133,3102000;1,1,0,0,32,5,130,3214000;1,1,0,2,64,6,130,5324010;1,1,0,0,128,7,130,5436021;" { return 3 }
    if headers_text("tests/data/av1/inter/grain.obu") != "1,0,0,7,255,0,848,0000000;1,1,0,6,2,1,921,0000000;1,1,0,3,4,2,909,0001000;1,1,0,3,8,3,921,1002000;1,1,0,3,16,4,909,2103000;1,1,0,3,32,5,909,3214000;" { return 4 }
    return 42
}
