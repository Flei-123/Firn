// expect_exit: 0
// tests/2220_desktop_watch.fi -- desktop.watch (inotify): creates, writes, renames and
// removals in a watched tree, recursion into new folders, quiet, a missing path, the root going away.
import std.rt
import std.str
import std.fs
import std.env
import desktop.watch

fn pid_text(out: *mut rt.Buf) {
    rt.buf_push_dec_u64(out, syscall(39, 0, 0, 0, 0, 0, 0) as u64)
}

// Collects events until `ms` of quiet; each as "<kind>:<D|F>:<path>\n".
fn drain(w: *mut watch.Watcher, out: *mut rt.Buf) {
    var ev: watch.WatchEvent = watch.watch_event_zero()
    while watch.watch_poll(w, 250, &ev) {
        rt.buf_push_dec_u64(out, ev.kind as u64)
        rt.buf_push(out, 58 as u8)
        if ev.is_dir {
            rt.buf_push(out, 68 as u8)
        } else {
            rt.buf_push(out, 70 as u8)
        }
        rt.buf_push(out, 58 as u8)
        let p: str = watch.watch_event_path(w)
        rt.buf_push_bytes(out, p.p as u64, p.length())
        rt.buf_push(out, 10 as u8)
    }
}

fn has(b: *mut rt.Buf, s: str) -> bool {
    let all: str = str { p: rt.buf_data(b), n: rt.buf_len(b) }
    return all.find(s) != str.npos()
}

fn touch(path: str, text: str) -> bool {
    let r: usize = fs.write_file(path, text.p as u64, text.length()) catch 99999
    return r == text.length()
}

fn main(start: u64) -> i32 {
    var base: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&base, "/tmp/firn-2220-".p as u64, 15)
    pid_text(&base)
    let root: str = str { p: rt.buf_data(&base), n: rt.buf_len(&base) }
    fs.remove_tree(root) catch false
    fs.mkdir_all(root) catch false

    var w: watch.Watcher = watch.watch_new()
    if watch.watch_fd(&w) < 0 { return 1 }
    if watch.watch_add(&w, "/tmp/firn-2220-does-not-exist", true) { return 2 }
    if !watch.watch_add(&w, root, true) { return 3 }

    var ev: watch.WatchEvent = watch.watch_event_zero()
    if watch.watch_poll(&w, 50, &ev) { return 4 } // quiet

    var a: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&a, root.p as u64, root.length())
    rt.buf_push_bytes(&a, "/a.txt".p as u64, 6)
    let pa: str = str { p: rt.buf_data(&a), n: rt.buf_len(&a) }
    if !touch(pa, "hello") { return 5 }
    var log: rt.Buf = rt.buf_new()
    drain(&w, &log)
    var want1: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&want1, "1:F:".p as u64, 4)
    rt.buf_push_bytes(&want1, pa.p as u64, pa.length())
    if !has(&log, str { p: rt.buf_data(&want1), n: rt.buf_len(&want1) }) { return 6 }
    var want2: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&want2, "2:F:".p as u64, 4)
    rt.buf_push_bytes(&want2, pa.p as u64, pa.length())
    if !has(&log, str { p: rt.buf_data(&want2), n: rt.buf_len(&want2) }) { return 7 }

    // a folder, then a file in it: recursion
    var sub: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&sub, root.p as u64, root.length())
    rt.buf_push_bytes(&sub, "/sub".p as u64, 4)
    let ps: str = str { p: rt.buf_data(&sub), n: rt.buf_len(&sub) }
    fs.mkdir(ps) catch false
    rt.buf_clear(&log)
    drain(&w, &log)
    var wd: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&wd, "1:D:".p as u64, 4)
    rt.buf_push_bytes(&wd, ps.p as u64, ps.length())
    if !has(&log, str { p: rt.buf_data(&wd), n: rt.buf_len(&wd) }) { return 8 }
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, ps.p as u64, ps.length())
    rt.buf_push_bytes(&b, "/b.txt".p as u64, 6)
    let pb: str = str { p: rt.buf_data(&b), n: rt.buf_len(&b) }
    if !touch(pb, "x") { return 9 }
    rt.buf_clear(&log)
    drain(&w, &log)
    var wb: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&wb, "1:F:".p as u64, 4)
    rt.buf_push_bytes(&wb, pb.p as u64, pb.length())
    if !has(&log, str { p: rt.buf_data(&wb), n: rt.buf_len(&wb) }) { return 10 }

    // a rename: two events with one cookie
    var c: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&c, root.p as u64, root.length())
    rt.buf_push_bytes(&c, "/c.txt".p as u64, 6)
    let pc: str = str { p: rt.buf_data(&c), n: rt.buf_len(&c) }
    fs.rename(pa, pc) catch false
    var ck_from: u32 = 0
    var ck_to: u32 = 0
    var got_from: bool = false
    var got_to: bool = false
    while watch.watch_poll(&w, 250, &ev) {
        if ev.kind == watch.EV_RENAMED_FROM && watch.watch_event_path(&w) == pa {
            got_from = true
            ck_from = ev.cookie
        }
        if ev.kind == watch.EV_RENAMED_TO && watch.watch_event_path(&w) == pc {
            got_to = true
            ck_to = ev.cookie
        }
    }
    if !got_from || !got_to { return 11 }
    if ck_from != ck_to || ck_from == 0 as u32 { return 12 }

    // a removal
    fs.remove(pc) catch false
    rt.buf_clear(&log)
    drain(&w, &log)
    var wr: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&wr, "3:F:".p as u64, 4)
    rt.buf_push_bytes(&wr, pc.p as u64, pc.length())
    if !has(&log, str { p: rt.buf_data(&wr), n: rt.buf_len(&wr) }) { return 13 }

    // a folder with content that appears by one move (the scan must not miss the file inside)
    var stage: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&stage, "/tmp/firn-2220-stage-".p as u64, 21)
    pid_text(&stage)
    let pst: str = str { p: rt.buf_data(&stage), n: rt.buf_len(&stage) }
    fs.remove_tree(pst) catch false
    fs.mkdir_all(pst) catch false
    var inner: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&inner, pst.p as u64, pst.length())
    rt.buf_push_bytes(&inner, "/inner.txt".p as u64, 10)
    touch(str { p: rt.buf_data(&inner), n: rt.buf_len(&inner) }, "in")
    var dest: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&dest, root.p as u64, root.length())
    rt.buf_push_bytes(&dest, "/moved".p as u64, 6)
    let pd: str = str { p: rt.buf_data(&dest), n: rt.buf_len(&dest) }
    fs.rename(pst, pd) catch false
    rt.buf_clear(&log)
    drain(&w, &log)
    var wi: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&wi, "1:F:".p as u64, 4)
    rt.buf_push_bytes(&wi, pd.p as u64, pd.length())
    rt.buf_push_bytes(&wi, "/inner.txt".p as u64, 10)
    if !has(&log, str { p: rt.buf_data(&wi), n: rt.buf_len(&wi) }) { return 14 }
    // ... and a later change inside it is seen (the new folder is watched)
    var inner2: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&inner2, pd.p as u64, pd.length())
    rt.buf_push_bytes(&inner2, "/inner.txt".p as u64, 10)
    touch(str { p: rt.buf_data(&inner2), n: rt.buf_len(&inner2) }, "changed")
    rt.buf_clear(&log)
    drain(&w, &log)
    var wm: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&wm, "2:F:".p as u64, 4)
    rt.buf_push_bytes(&wm, pd.p as u64, pd.length())
    rt.buf_push_bytes(&wm, "/inner.txt".p as u64, 10)
    if !has(&log, str { p: rt.buf_data(&wm), n: rt.buf_len(&wm) }) { return 15 }

    // the root goes away
    fs.remove_tree(root) catch false
    var gone: bool = false
    while watch.watch_poll(&w, 300, &ev) {
        if ev.kind == watch.EV_ROOT_GONE {
            gone = true
        }
    }
    if !gone { return 16 }
    watch.watch_close(&w)
    return 0
}
