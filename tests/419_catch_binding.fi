// expect_exit: 0
// 'catch |e| fallback' binds the error value; error values of the same set
// can be compared with == and !=.
error IoError { NotFound, Permission, Closed }

fn open(n: i32) -> IoError!i32 {
    if n == 0 {
        return IoError::NotFound
    }
    if n == 1 {
        return IoError::Permission
    }
    if n == 2 {
        return IoError::Closed
    }
    return n
}

fn code(n: i32) -> i32 {
    return open(n) catch | e | (if_code(e))
}

fn if_code(e: IoError) -> i32 {
    if e == IoError::NotFound {
        return 0 - 1
    }
    if e == IoError::Permission {
        return 0 - 2
    }
    if e != IoError::Closed {
        return 0 - 99
    }
    return 0 - 3
}

fn main() -> i32 {
    if code(0) != 0 - 1 {
        return 1
    }
    if code(1) != 0 - 2 {
        return 2
    }
    if code(2) != 0 - 3 {
        return 3
    }
    if code(7) != 7 {
        return 4
    }
    let e: IoError = IoError::Permission
    if (e == IoError::Permission) != true {
        return 5
    }
    if (e == IoError::Closed) != false {
        return 6
    }
    return 0
}
