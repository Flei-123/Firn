// expect_exit: 42
// Round GAPS: __bits / __f64_from_bits / __f32_from_bits -- the IEEE 754
// pattern of a float as an integer and back, without a stack slot.
fn round_trip(x: f64) -> bool {
    let u: u64 = __bits(x)
    let y: f64 = __f64_from_bits(u)
    return __bits(y) == u
}

fn sign_of(x: f64) -> u64 {
    return __bits(x) >> 63
}

fn exponent(x: f64) -> i64 {
    return ((__bits(x) >> 52) & (0x7FF as u64)) as i64 - 1023
}

fn main() -> i32 {
    if __bits(1.0) != (0x3FF0000000000000 as u64) { return 1 as i32 }
    if __bits(-2.0) != (0xC000000000000000 as u64) { return 2 as i32 }
    if __bits(0.0) != (0 as u64) { return 3 as i32 }
    if sign_of(-0.0) != (1 as u64) { return 4 as i32 }
    if exponent(1024.0) != 10 { return 5 as i32 }
    if __f64_from_bits(0x4045000000000000 as u64) != 42.0 { return 6 as i32 }
    // a value that is only known at run time
    var s: f64 = 0.0
    var i: i32 = 0
    while i < 7 {
        s = s + 6.0
        i = i + 1
    }
    if __bits(s) != (0x4045000000000000 as u64) { return 7 as i32 }
    if !round_trip(s) || !round_trip(-0.0) || !round_trip(1.0e308) { return 8 as i32 }
    // NaN: the pattern survives, and NaN != NaN still holds
    let nan: f64 = __f64_from_bits(0x7FF8000000000001 as u64)
    if nan == nan { return 9 as i32 }
    if __bits(nan) != (0x7FF8000000000001 as u64) { return 10 as i32 }
    // f32: 32 bits, upper half clear
    let h: f32 = 1.5 as f32
    let hb: u32 = __bits(h)
    if hb != (0x3FC00000 as u32) { return 11 as i32 }
    if (hb as u64) >> 32 != (0 as u64) { return 12 as i32 }
    if __f32_from_bits(0x40490FDB as u32) != 3.14159274 as f32 { return 13 as i32 }
    let back: f32 = __f32_from_bits(hb)
    if back != h { return 14 as i32 }
    return 42 as i32
}
