// expect_exit: 0
// ERROR UNIONS IN THE CORE LANGUAGE -- the test for round 33
// (docs/SELF_HOSTING.md 23).
//
// The whole path is checked in ONE program:
//
//   * an error set and an error union from a MODULE
//     (`modules/kern/mid.fi`) -- set names hold program-wide
//   * `try` over two levels through the module boundary
//   * `catch fallback` and `catch |e| fallback` comparing the error values
//   * the implicit conversion at `return`, `let`, assignment and argument
//   * a union as a struct field and as a parameter type
//   * must_consume: the value is bound or passed on everywhere
import modules.core.mid

// A set of its own next to the one from the module -- the codes start at 1
// in each set.
error Local { Lazy }

fn local(n: i32) -> Local!i32 {
    if n == 0 {
        return Local::Lazy
    }
    return n
}

// `try` through TWO levels, the innermost one lies in the module.
fn level1(n: i32) -> ComputeError!i32 {
    let v = try mid.halve(n)
    return v + 1
}

fn level2(n: i32) -> ComputeError!i32 {
    let v = try level1(n)
    return v * 2
}

// Union as a struct field.
struct Account {
    state: ComputeError!i32,
    pin: i32,
}

// Union as a parameter: the call converts implicitly.
fn eval(r: ComputeError!i32) -> i32 {
    return r catch 0 - 100
}

fn main() -> i32 {
    // --- try chain across the module boundary
    if (level2(10) catch 0) != 12 {
        return 1
    }
    if (level2(7) catch 0 - 1) != 0 - 1 {
        return 2
    }
    if (level2(0 - 4) catch 0 - 1) != 0 - 1 {
        return 3
    }
    // --- catch |e| comparing the error values
    let c1 = level2(7) catch | e | (mid.code_of(e))
    if c1 != 0 - 1 {
        return 4
    }
    let c2 = level2(0 - 4) catch | e | (mid.code_of(e))
    if c2 != 0 - 2 {
        return 5
    }
    // --- assignment: value and error variant
    var d: ComputeError!i32 = mid.halve(8)
    if (d catch 0) != 4 {
        return 6
    }
    d = 9
    if (d catch 0) != 9 {
        return 7
    }
    d = ComputeError::Negative
    if (d catch 0 - 3) != 0 - 3 {
        return 8
    }
    // --- union as a struct field and as an argument
    var k: Account = Account { state: ComputeError::Odd, pin: 7 }
    if (k.state catch 0 - 5) != 0 - 5 {
        return 9
    }
    k.state = 33
    if (k.state catch 0) != 33 {
        return 10
    }
    if eval(12) != 12 {
        return 11
    }
    if eval(ComputeError::Negative) != 0 - 100 {
        return 12
    }
    // --- two sets side by side
    if (local(3) catch 0) != 3 {
        return 13
    }
    if (local(0) catch 0 - 7) != 0 - 7 {
        return 14
    }
    return 0
}
