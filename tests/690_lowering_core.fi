// expect_exit: 0
// LOWERING OF THE SCALAR CORE -- the shapes that value numbering and block
// building depend on.
//
// `tools/fir_compare.sh` checks that `lib/firnc1/lower.fi` produces EXACTLY
// the same FIR for this file as `firnc0 --emit=fir-raw` -- value numbers,
// block numbers and order included. Here the same file stands next to it as
// a running program: equal AND right.

fn two(a: i32, b: i32) -> i32 {
    return a * 2 + b
}

fn nothing(p: *mut i32) {
    *p = *p + 1
}

fn main() -> i32 {
    // --- nested calls: the argument lists must not slide into one
    // another
    if two(two(1, 2), two(3, 4)) != 4 * 2 + 10 {
        return 1
    }

    // --- a call without a return value defines NO value
    var x: i32 = 5
    nothing(&x)
    nothing(&x)
    if x != 7 {
        return 2
    }

    // --- short circuit: its own slot, its own blocks
    var counter: i32 = 0
    if x > 0 && x < 100 {
        counter = counter + 1
    }
    if x < 0 || x > 5 {
        counter = counter + 10
    }
    if !(x > 0 && x > 1000) {
        counter = counter + 100
    }
    if counter != 111 {
        return 3
    }

    // --- loops with break and continue: after every jump a new, unreachable
    // block begins
    var sum: i32 = 0
    var i: i32 = 0
    while true {
        i = i + 1
        if i > 10 {
            break
        }
        if i % 2 == 0 {
            continue
        }
        sum = sum + i
    }
    if sum != 1 + 3 + 5 + 7 + 9 {
        return 4
    }

    // --- for with continue: the step block still has to run
    var t: usize = 0
    for k in 0 as usize..10 {
        if k == 3 {
            continue
        }
        t = t + k
    }
    if t != 45 - 3 {
        return 5
    }

    // --- shift with a right operand of a different width
    let wide: u64 = 1
    let narrow: u32 = 8
    if (wide << narrow as u64) != 256 {
        return 6
    }

    // --- largest u64 value: the constant must not show up as -1
    let full: u64 = 18446744073709551615
    // ROUND 72: u64::MAX + 1 == 0 is exactly the wraparound this line
    // exists to show; `+%` asks for it instead of panicking.
    if full +% 1 != 0 {
        return 7
    }

    // --- pointer to pointer, loading through two levels
    var z: i32 = 42
    let p: *mut i32 = &z
    let pp: *mut *mut i32 = &p
    if *(*pp) != 42 {
        return 8
    }
    *(*pp) = 43
    if z != 43 {
        return 9
    }

    return 0
}
