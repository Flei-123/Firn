// expect_exit: 0
// LOWERING DES SKALAREN KERNS — die Formen, an denen die Wertnummerierung und
// die Blockbildung haengen.
//
// `tools/fir_compare.sh` prueft, dass `lib/firnc1/lower.fi` fuer diese Datei
// GENAU dieselbe FIR erzeugt wie `firnc0 --emit=fir-raw` — Wertnummern,
// Blocknummern und Reihenfolge eingeschlossen. Hier steht dieselbe Datei als
// laufendes Programm daneben: gleich UND richtig.

fn two(a: i32, b: i32) -> i32 {
    return a * 2 + b
}

fn nothing(p: *mut i32) {
    *p = *p + 1
}

fn main() -> i32 {
    // --- verschachtelte Aufrufe: die Argumentlisten duerfen sich nicht
    // ineinanderschieben
    if two(two(1, 2), two(3, 4)) != 4 * 2 + 10 {
        return 1
    }

    // --- Aufruf ohne Rueckgabewert definiert KEINEN Wert
    var x: i32 = 5
    nothing(&x)
    nothing(&x)
    if x != 7 {
        return 2
    }

    // --- Kurzschluss: eigener Platz, eigene Bloecke
    var counter: i32 = 0
    if x > 0 && x < 100 {
        counter = counter + 1
    }
    if x < 0 || x > 5 {
        counter = counter + 10
    }
    if !(x > 0 && x > 1000) {
        counter = counter + 100
    }
    if counter != 111 {
        return 3
    }

    // --- Schleifen mit break und continue: nach jedem Sprung beginnt ein
    // neuer, unerreichbarer Block
    var sum: i32 = 0
    var i: i32 = 0
    while true {
        i = i + 1
        if i > 10 {
            break
        }
        if i % 2 == 0 {
            continue
        }
        sum = sum + i
    }
    if sum != 1 + 3 + 5 + 7 + 9 {
        return 4
    }

    // --- for mit continue: der Fortschaltblock muss trotzdem laufen
    var t: usize = 0
    for k in 0 as usize..10 {
        if k == 3 {
            continue
        }
        t = t + k
    }
    if t != 45 - 3 {
        return 5
    }

    // --- Verschiebung mit ungleich breitem rechten Operanden
    let wide: u64 = 1
    let narrow: u32 = 8
    if (wide << narrow as u64) != 256 {
        return 6
    }

    // --- groesster u64-Wert: die Konstante darf nicht als -1 erscheinen
    let full: u64 = 18446744073709551615
    if full + 1 != 0 {
        return 7
    }

    // --- Zeiger auf Zeiger, Laden durch zwei Ebenen
    var z: i32 = 42
    let p: *mut i32 = &z
    let pp: *mut *mut i32 = &p
    if *(*pp) != 42 {
        return 8
    }
    *(*pp) = 43
    if z != 43 {
        return 9
    }

    return 0
}
