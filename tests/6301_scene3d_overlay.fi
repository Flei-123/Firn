import std.rt
import std.vec
import std.testkit
import scene3d.vec3
import scene3d.camera
import scene3d.surface
import scene3d.ov_px
import scene3d.ov_shapes
import scene3d.overlay
import scene3d.labels

const BG: u32 = 0xFF646464

fn make_surface(w: i32, h: i32, bg: u32) -> surface.Surface {
    let n: usize = (w as usize) * (h as usize)
    let p: u64 = rt.heap_alloc(n * 4)
    var i: usize = 0
    while i < n {
        rt.st32(p, i, bg)
        i = i + 1
    }
    return surface.Surface { px: p, w: w, h: h }
}

fn drop_surface(s: *mut surface.Surface) {
    rt.heap_free((*s).px, ((*s).w as usize) * ((*s).h as usize) * 4)
}

fn ink_count(s: *mut surface.Surface, bg: u32) -> i32 {
    var n: i32 = 0
    var y: i32 = 0
    while y < (*s).h {
        var x: i32 = 0
        while x < (*s).w {
            if ov_px.px_read(s, x, y) != bg { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn lowest_ink_row(s: *mut surface.Surface, bg: u32) -> i32 {
    var low: i32 = -1
    var y: i32 = 0
    while y < (*s).h {
        var x: i32 = 0
        while x < (*s).w {
            if ov_px.px_read(s, x, y) != bg { low = y }
            x = x + 1
        }
        y = y + 1
    }
    return low
}

fn highest_ink_row(s: *mut surface.Surface, bg: u32) -> i32 {
    var y: i32 = 0
    while y < (*s).h {
        var x: i32 = 0
        while x < (*s).w {
            if ov_px.px_read(s, x, y) != bg { return y }
            x = x + 1
        }
        y = y + 1
    }
    return -1
}

fn near_i(a: i32, b: i32, tol: i32) -> bool {
    var d: i32 = a - b
    if d < 0 { d = 0 - d }
    return d <= tol
}

fn overlaps(a: labels.LabelBox, b: labels.LabelBox) -> bool {
    return a.x < b.x + b.w && b.x < a.x + a.w && a.y < b.y + b.h && b.y < a.y + a.h
}

fn test_cam() -> camera.Camera {
    var c: camera.Camera = camera.cam_new(320, 180)
    camera.cam_look_at(&c, vec3.v3(0.0, 0.0, 10.0), vec3.v3(0.0, 0.0, 0.0))
    return c
}

#[test]
fn rgba_packs_and_clamps() {
    testkit.assert_true(ov_px.rgba(1, 2, 3, 4) == 0x04030201 as u32, "pack order")
    testkit.assert_true(ov_px.rgba(300, -5, 7, 999) == 0xFF0700FF as u32, "clamp")
    testkit.assert_true(ov_px.color_fade(ov_px.rgba(1, 2, 3, 200), 0.5) == ov_px.rgba(1, 2, 3, 100), "fade")
}

#[test]
fn alpha_blend_matches_expected() {
    var s: surface.Surface = make_surface(4, 4, BG)
    ov_shapes.ov_fill_rect(&s, 0.0, 0.0, 4.0, 4.0, ov_px.rgba(255, 0, 0, 128))
    let c: u32 = ov_px.px_read(&s, 1, 1)
    testkit.assert_true(near_i(ov_px.color_r(c), 178, 1), "red channel")
    testkit.assert_true(near_i(ov_px.color_g(c), 50, 1), "green channel")
    testkit.assert_true(near_i(ov_px.color_b(c), 50, 1), "blue channel")
    testkit.assert_true(ov_px.color_alpha(c) == 255, "opaque stays opaque")
    var t: surface.Surface = make_surface(2, 2, 0 as u32)
    ov_shapes.ov_fill_rect(&t, 0.0, 0.0, 2.0, 2.0, ov_px.rgba(10, 20, 30, 128))
    let d: u32 = ov_px.px_read(&t, 0, 0)
    testkit.assert_true(ov_px.color_alpha(d) == 128 && ov_px.color_r(d) == 10 && ov_px.color_b(d) == 30, "onto transparent")
    drop_surface(&s)
    drop_surface(&t)
}

#[test]
fn fill_rect_exact_and_fractional() {
    var s: surface.Surface = make_surface(16, 16, BG)
    ov_shapes.ov_fill_rect(&s, 2.0, 3.0, 4.0, 5.0, ov_px.rgb(255, 255, 255))
    testkit.assert_true(ov_px.px_read(&s, 2, 3) == ov_px.rgb(255, 255, 255), "corner in")
    testkit.assert_true(ov_px.px_read(&s, 5, 7) == ov_px.rgb(255, 255, 255), "last in")
    testkit.assert_true(ov_px.px_read(&s, 6, 7) == BG, "right out")
    testkit.assert_true(ov_px.px_read(&s, 5, 8) == BG, "bottom out")
    ov_shapes.ov_fill_rect(&s, 10.5, 10.0, 2.0, 1.0, ov_px.rgb(255, 255, 255))
    let half: u32 = ov_px.px_read(&s, 10, 10)
    testkit.assert_true(near_i(ov_px.color_r(half), 178, 2), "half coverage left edge")
    drop_surface(&s)
}

#[test]
fn shapes_cover_expected_pixels() {
    var s: surface.Surface = make_surface(64, 64, BG)
    ov_shapes.ov_disc(&s, 20.0, 20.0, 6.0, ov_px.rgb(255, 0, 0))
    testkit.assert_true(ov_px.px_read(&s, 20, 20) == ov_px.rgb(255, 0, 0), "disc centre")
    testkit.assert_true(ov_px.px_read(&s, 30, 30) == BG, "disc far")
    ov_shapes.ov_round_rect(&s, 30.0, 30.0, 20.0, 20.0, 5.0, ov_px.rgb(0, 255, 0), ov_px.rgb(0, 0, 255), 2.0)
    testkit.assert_true(ov_px.px_read(&s, 40, 40) == ov_px.rgb(0, 255, 0), "round rect fill")
    testkit.assert_true(ov_px.color_b(ov_px.px_read(&s, 40, 30)) > 200, "round rect border top")
    testkit.assert_true(ov_px.px_read(&s, 30, 30) == BG, "round rect corner cut")
    ov_shapes.ov_line(&s, 2.0, 60.0, 60.0, 60.0, 2.0, ov_px.rgb(255, 255, 0))
    testkit.assert_true(ov_px.px_read(&s, 30, 59) == ov_px.rgb(255, 255, 0) || ov_px.px_read(&s, 30, 60) == ov_px.rgb(255, 255, 0), "line body")
    testkit.assert_true(ov_px.px_read(&s, 30, 50) == BG, "line away")
    drop_surface(&s)
}

#[test]
fn diagonal_and_steep_lines_connect() {
    var s: surface.Surface = make_surface(64, 64, BG)
    ov_shapes.ov_line(&s, 4.0, 4.0, 50.0, 40.0, 2.0, ov_px.rgb(255, 255, 255))
    ov_shapes.ov_line(&s, 60.0, 4.0, 56.0, 60.0, 2.0, ov_px.rgb(255, 255, 255))
    var hits: i32 = 0
    var x: i32 = 4
    while x < 50 {
        let yy: f64 = 4.0 + (36.0 * ((x as f64) + 0.5 - 4.0)) / 46.0
        let ym: i32 = yy as i32
        if ov_px.px_read(&s, x, ym) != BG || ov_px.px_read(&s, x, ym - 1) != BG { hits = hits + 1 }
        x = x + 1
    }
    testkit.assert_true(hits >= 46, "no gaps on shallow line")
    var vh: i32 = 0
    var y: i32 = 4
    while y < 60 {
        let xx: i32 = (60.0 - (4.0 * ((y as f64) - 4.0)) / 56.0) as i32
        if ov_px.px_read(&s, xx, y) != BG || ov_px.px_read(&s, xx - 1, y) != BG { vh = vh + 1 }
        y = y + 1
    }
    testkit.assert_true(vh >= 55, "no gaps on steep line")
    drop_surface(&s)
}

#[test]
fn plot_draws_inside_rect_only() {
    var s: surface.Surface = make_surface(64, 40, BG)
    var ys: vec.Vec[f64] = vec.vec_new[f64]()
    var i: i32 = 0
    while i < 20 {
        vec.vec_push[f64](&ys, (i as f64) * 0.1)
        i = i + 1
    }
    ov_shapes.ov_plot(&s, 4.0, 4.0, 56.0, 32.0, &ys, 0.0, 2.0, 2.0, ov_px.rgb(0, 255, 0))
    testkit.assert_true(ink_count(&s, BG) > 40, "curve inked")
    testkit.assert_true(ov_px.px_read(&s, 2, 20) == BG && ov_px.px_read(&s, 62, 20) == BG, "outside untouched")
    vec.vec_free[f64](&ys)
    drop_surface(&s)
}

#[test]
fn text_renders_umlauts_and_subscript() {
    let o: *mut overlay.Overlay = overlay.overlay_default()
    testkit.assert_true(o as u64 != 0, "font load")
    var s: surface.Surface = make_surface(220, 60, BG)
    overlay.ov_text(o, &s, 4.0, 40.0, 28.0, ov_px.rgb(255, 255, 255), "äöüß", false)
    testkit.assert_true(ink_count(&s, BG) > 100, "umlauts inked")
    var a: surface.Surface = make_surface(60, 60, BG)
    var ae: surface.Surface = make_surface(60, 60, BG)
    overlay.ov_text(o, &a, 4.0, 40.0, 28.0, ov_px.rgb(255, 255, 255), "a", false)
    overlay.ov_text(o, &ae, 4.0, 40.0, 28.0, ov_px.rgb(255, 255, 255), "ä", false)
    testkit.assert_true(highest_ink_row(&ae, BG) < highest_ink_row(&a, BG), "diaeresis above a")
    testkit.assert_true(ink_count(&ae, BG) > ink_count(&a, BG), "more ink than a")
    var two: surface.Surface = make_surface(60, 60, BG)
    var sub: surface.Surface = make_surface(60, 60, BG)
    overlay.ov_text(o, &two, 4.0, 40.0, 28.0, ov_px.rgb(255, 255, 255), "2", false)
    overlay.ov_text(o, &sub, 4.0, 40.0, 28.0, ov_px.rgb(255, 255, 255), "₂", false)
    testkit.assert_true(ink_count(&sub, BG) > 20, "subscript two inked")
    testkit.assert_true(ink_count(&sub, BG) < ink_count(&two, BG), "subscript smaller than two")
    testkit.assert_true(highest_ink_row(&sub, BG) > highest_ink_row(&two, BG) + 4, "subscript is small")
    var sp: surface.Surface = make_surface(60, 60, BG)
    overlay.ov_text(o, &sp, 4.0, 40.0, 28.0, ov_px.rgb(255, 255, 255), " ", false)
    testkit.assert_true(ink_count(&sp, BG) == 0, "space is empty")
    drop_surface(&s)
    drop_surface(&a)
    drop_surface(&ae)
    drop_surface(&two)
    drop_surface(&sub)
    drop_surface(&sp)
    overlay.overlay_free(o)
}

#[test]
fn text_width_and_shadow() {
    let o: *mut overlay.Overlay = overlay.overlay_default()
    let w1: f64 = overlay.ov_text_width(o, 20.0, "Hello")
    let w2: f64 = overlay.ov_text_width(o, 40.0, "Hello")
    testkit.assert_true(w1 > 20.0, "width positive")
    testkit.assert_true(w2 > w1 * 1.9 && w2 < w1 * 2.1, "width scales with size")
    testkit.assert_true(overlay.ov_text_width_ex(o, 20.0, "Hello", true) > w1, "bold wider")
    testkit.assert_true(overlay.ov_text_width(o, 20.0, "H₂O") > overlay.ov_text_width(o, 20.0, "HO"), "subscript adds width")
    var plain: surface.Surface = make_surface(120, 40, BG)
    var shad: surface.Surface = make_surface(120, 40, BG)
    let adv: f64 = overlay.ov_text(o, &plain, 4.0, 28.0, 22.0, ov_px.rgb(255, 255, 255), "Abc", false)
    overlay.ov_text(o, &shad, 4.0, 28.0, 22.0, ov_px.rgb(255, 255, 255), "Abc", true)
    testkit.assert_true(adv > 20.0, "advance returned")
    testkit.assert_true(ink_count(&shad, BG) > ink_count(&plain, BG), "shadow adds pixels")
    drop_surface(&plain)
    drop_surface(&shad)
    overlay.overlay_free(o)
}

#[test]
fn label_leader_hits_anchor_and_box_inside() {
    let o: *mut overlay.Overlay = overlay.overlay_default()
    var s: surface.Surface = make_surface(320, 180, BG)
    var c: camera.Camera = test_cam()
    var st: labels.LabelStyle = labels.label_style()
    st.size = 14.0
    var b: labels.LabelBox = labels.LabelBox { x: 0.0, y: 0.0, w: 0.0, h: 0.0, ax: 0.0, ay: 0.0 }
    let ok: bool = labels.ov_label_ex(o, &s, &c, vec3.v3(0.0, 0.0, 0.0), "Kühlmantel\nD₂O 15 cm", st, 1.0, &b)
    testkit.assert_true(ok, "label drawn")
    testkit.assert_true(near_i(b.ax as i32, 160, 1) && near_i(b.ay as i32, 90, 1), "anchor projected to centre")
    testkit.assert_true(ov_px.px_read(&s, b.ax as i32, b.ay as i32) != BG, "anchor pixel inked")
    testkit.assert_true(b.w > 40.0 && b.h > 30.0, "box has size")
    testkit.assert_true(b.x >= 0.0 && b.y >= 0.0 && b.x + b.w <= 320.0 && b.y + b.h <= 180.0, "box inside frame")
    let ex: f64 = vec3.clampf(b.ax, b.x, b.x + b.w)
    let ey: f64 = vec3.clampf(b.ay, b.y, b.y + b.h)
    let mx: i32 = ((ex + b.ax) * 0.5) as i32
    let my: i32 = ((ey + b.ay) * 0.5) as i32
    testkit.assert_true(ov_px.px_read(&s, mx, my) != BG || ov_px.px_read(&s, mx, my - 1) != BG || ov_px.px_read(&s, mx - 1, my) != BG, "leader midpoint inked")
    testkit.assert_true(ov_px.px_read(&s, (b.x + b.w * 0.5) as i32, (b.y + 2.0) as i32) != BG, "box filled")
    drop_surface(&s)
    overlay.overlay_free(o)
}

#[test]
fn label_clamps_to_screen_corners() {
    let o: *mut overlay.Overlay = overlay.overlay_default()
    var s: surface.Surface = make_surface(320, 180, BG)
    var c: camera.Camera = test_cam()
    var st: labels.LabelStyle = labels.label_style()
    var b: labels.LabelBox = labels.LabelBox { x: 0.0, y: 0.0, w: 0.0, h: 0.0, ax: 0.0, ay: 0.0 }
    testkit.assert_true(labels.ov_label_ex(o, &s, &c, vec3.v3(-6.2, 3.4, 0.0), "Oben links", st, 1.0, &b), "tl drawn")
    testkit.assert_true(b.x >= 0.0 && b.y >= 0.0 && b.x + b.w <= 320.0 && b.y + b.h <= 180.0, "tl inside")
    overlay.overlay_frame_begin(o)
    testkit.assert_true(labels.ov_label_ex(o, &s, &c, vec3.v3(6.2, -3.4, 0.0), "Unten rechts", st, 1.0, &b), "br drawn")
    testkit.assert_true(b.x >= 0.0 && b.y >= 0.0 && b.x + b.w <= 320.0 && b.y + b.h <= 180.0, "br inside")
    overlay.overlay_frame_begin(o)
    st.auto = false
    st.dx = 500.0
    st.dy = 500.0
    testkit.assert_true(labels.ov_label_ex(o, &s, &c, vec3.v3(0.0, 0.0, 0.0), "Offset", st, 1.0, &b), "offset drawn")
    testkit.assert_true(b.x + b.w <= 320.0 && b.y + b.h <= 180.0 && b.x >= 0.0, "offset clamped")
    drop_surface(&s)
    overlay.overlay_free(o)
}

#[test]
fn label_behind_camera_or_invisible_skipped() {
    let o: *mut overlay.Overlay = overlay.overlay_default()
    var s: surface.Surface = make_surface(320, 180, BG)
    var c: camera.Camera = test_cam()
    let st: labels.LabelStyle = labels.label_style()
    testkit.assert_true(!labels.ov_label(o, &s, &c, vec3.v3(0.0, 0.0, 30.0), "Hinten", st, 1.0), "behind camera")
    testkit.assert_true(!labels.ov_label(o, &s, &c, vec3.v3(0.0, 0.0, 0.0), "Unsichtbar", st, 0.0), "alpha zero")
    testkit.assert_true(ink_count(&s, BG) == 0, "nothing drawn")
    drop_surface(&s)
    overlay.overlay_free(o)
}

#[test]
fn label_fade_blends_toward_background() {
    let o: *mut overlay.Overlay = overlay.overlay_default()
    var full: surface.Surface = make_surface(320, 180, BG)
    var half: surface.Surface = make_surface(320, 180, BG)
    var c: camera.Camera = test_cam()
    let st: labels.LabelStyle = labels.label_style()
    var b: labels.LabelBox = labels.LabelBox { x: 0.0, y: 0.0, w: 0.0, h: 0.0, ax: 0.0, ay: 0.0 }
    labels.ov_label_ex(o, &full, &c, vec3.v3(0.0, 0.0, 0.0), "Fade", st, 1.0, &b)
    overlay.overlay_frame_begin(o)
    labels.ov_label_ex(o, &half, &c, vec3.v3(0.0, 0.0, 0.0), "Fade", st, 0.5, &b)
    let px_x: i32 = (b.x + 3.0) as i32
    let px_y: i32 = (b.y + 3.0) as i32
    let f: u32 = ov_px.px_read(&full, px_x, px_y)
    let h: u32 = ov_px.px_read(&half, px_x, px_y)
    testkit.assert_true(ov_px.color_b(f) < ov_px.color_b(h) && ov_px.color_b(h) < ov_px.color_b(BG) + 1, "half alpha sits between fill and background")
    let fa: f64 = (ov_px.color_alpha(st.fill) as f64) / 255.0
    let exp_h: i32 = ((ov_px.color_b(st.fill) as f64) * fa * 0.5 + (ov_px.color_b(BG) as f64) * (1.0 - fa * 0.5) + 0.5) as i32
    testkit.assert_true(near_i(ov_px.color_b(h), exp_h, 2), "half alpha matches formula")
    drop_surface(&full)
    drop_surface(&half)
    overlay.overlay_free(o)
}

#[test]
fn labels_in_one_frame_do_not_overlap() {
    let o: *mut overlay.Overlay = overlay.overlay_default()
    var s: surface.Surface = make_surface(320, 180, BG)
    var c: camera.Camera = test_cam()
    let st: labels.LabelStyle = labels.label_style()
    var b1: labels.LabelBox = labels.LabelBox { x: 0.0, y: 0.0, w: 0.0, h: 0.0, ax: 0.0, ay: 0.0 }
    var b2: labels.LabelBox = labels.LabelBox { x: 0.0, y: 0.0, w: 0.0, h: 0.0, ax: 0.0, ay: 0.0 }
    var b3: labels.LabelBox = labels.LabelBox { x: 0.0, y: 0.0, w: 0.0, h: 0.0, ax: 0.0, ay: 0.0 }
    overlay.overlay_frame_begin(o)
    labels.ov_label_ex(o, &s, &c, vec3.v3(0.0, 0.0, 0.0), "Erstes Label", st, 1.0, &b1)
    labels.ov_label_ex(o, &s, &c, vec3.v3(0.1, 0.0, 0.0), "Zweites Label", st, 1.0, &b2)
    labels.ov_label_ex(o, &s, &c, vec3.v3(0.0, 0.1, 0.0), "Drittes Label", st, 1.0, &b3)
    testkit.assert_true(!overlaps(b1, b2), "1 vs 2")
    testkit.assert_true(!overlaps(b1, b3), "1 vs 3")
    testkit.assert_true(!overlaps(b2, b3), "2 vs 3")
    drop_surface(&s)
    overlay.overlay_free(o)
}

#[test]
fn draws_into_any_surface_size() {
    let o: *mut overlay.Overlay = overlay.overlay_default()
    var tex: surface.Surface = make_surface(48, 24, ov_px.rgba(0, 0, 0, 255))
    var ys: vec.Vec[f64] = vec.vec_new[f64]()
    vec.vec_push[f64](&ys, 0.2)
    vec.vec_push[f64](&ys, 0.9)
    ov_shapes.ov_plot(&tex, 2.0, 2.0, 44.0, 20.0, &ys, 0.0, 1.0, 1.0, ov_px.rgb(0, 255, 0))
    vec.vec_free[f64](&ys)
    overlay.ov_text(o, &tex, 2.0, 14.0, 12.0, ov_px.rgb(255, 255, 255), "Text", false)
    overlay.ov_text(o, &tex, 40.0, 20.0, 30.0, ov_px.rgb(255, 255, 255), "Clipped far right", false)
    ov_shapes.ov_line(&tex, -20.0, -20.0, 80.0, 50.0, 3.0, ov_px.rgb(255, 0, 0))
    testkit.assert_true(ink_count(&tex, ov_px.rgba(0, 0, 0, 255)) > 30, "small texture drawn without crash")
    drop_surface(&tex)
    overlay.overlay_free(o)
}
