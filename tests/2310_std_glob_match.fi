// expect_exit: 0
// tests/2310_std_glob_match.fi -- std.glob: the pattern language (fnmatch).
//
// The behaviour is Python's fnmatch.fnmatchcase (tools/glob_cross/run.sh holds
// it against Python on thousands of random patterns); this file pins the rules
// one by one so that a failure names the rule.
//
//   A  `*` and `?`
//   B  classes: members, ranges, negation, `]` first, a dash, backwards ranges,
//      a `[` that never closes
//   C  UTF-8: one `?` is one character, however many bytes it has
//   D  no escape character, case sensitive, nothing special about `/` and `.`
//   E  it stays fast on patterns built to be slow
//   F  has_magic and escape
import std.rt
import std.str
import std.glob

static mut failures: i32 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn t(pat: str, name: str) {
    if !glob.matches(pat, name) {
        failures = failures + 1
        say("  FAIL  should match: ")
        say(pat)
        say("  <-  ")
        say(name)
        say("\n")
    }
}

fn f(pat: str, name: str) {
    if glob.matches(pat, name) {
        failures = failures + 1
        say("  FAIL  should NOT match: ")
        say(pat)
        say("  <-  ")
        say(name)
        say("\n")
    }
}

fn main() -> i32 {
    // --- A: * and ?
    t("", "")
    f("", "a")
    t("*", "")
    t("*", "abc")
    t("a*", "a")
    t("a*", "abc")
    f("a*", "ba")
    t("*c", "abc")
    f("*c", "abcd")
    t("a*c", "abc")
    t("a*c", "ac")
    t("a*c", "abxc")
    f("a*c", "abxcd")
    t("*a*b*", "xxaxxbxx")
    f("*a*b*", "xxbxxaxx")
    t("**", "anything")
    t("a**b", "ab")
    t("?", "a")
    f("?", "")
    f("?", "ab")
    t("??", "ab")
    t("a?c", "abc")
    f("a?c", "ac")
    t("*?", "x")
    f("*?", "")
    t("?*?", "ab")
    f("?*?", "a")

    // --- B: classes
    t("[abc]", "a")
    t("[abc]", "c")
    f("[abc]", "d")
    f("[abc]", "")
    f("[abc]", "ab")
    t("[a-c]", "b")
    t("[a-c]", "c")
    f("[a-c]", "d")
    t("[a-cx-z]", "y")
    f("[a-cx-z]", "m")
    t("[!a]", "b")
    f("[!a]", "a")
    f("[!a]", "")
    t("[!a-c]", "d")
    f("[!a-c]", "b")
    t("[]]", "]")
    f("[]]", "a")
    t("[]a]", "a")
    t("[!]]", "a")
    f("[!]]", "]")
    t("[!]a]", "b")
    f("[!]a]", "a")
    t("[a-]", "-")
    t("[a-]", "a")
    f("[a-]", "b")
    t("[-a]", "-")
    t("[-a]", "a")
    t("[a-c-e]", "-")
    t("[a-c-e]", "e")
    f("[a-c-e]", "d")
    t("[+--]", ",")
    t("[^a]", "^")
    t("[^a]", "a")
    f("[^a]", "b")
    t("[a^]", "^")
    t("[!!]", "a")
    f("[!!]", "!")
    f("[z-a]", "m")
    f("[z-a]", "z")
    f("[z-a]", "a")
    t("[!z-a]", "m")
    t("[!z-a]", "z")
    t("[z-a-c]", "c")
    t("[z-a-c]", "-")
    f("[z-a-c]", "z")
    // Python cuts a backwards range out of the class text and reads what is left:
    // the leftovers are sometimes a different class (`[]--!]` becomes "!" = any character)
    t("[]--!]", "a")
    f("[b-a!c]", "c")
    t("[b-a!c]", "d")
    t("[b-a!c]", "!")
    t("[*]", "*")
    f("[*]", "a")
    t("[?]", "?")
    t("[[]", "[")
    t("[a[]", "[")
    t("a[b]c", "abc")
    t("[a-c][x-z]", "by")
    // a `[` that never closes is an ordinary `[`
    t("[", "[")
    t("[a", "[a")
    f("[a", "a")
    t("a[", "a[")
    t("[!", "[!")
    t("[!]", "[!]")
    t("[]", "[]")
    t("[]a", "[]a")
    t("*[", "x[")
    // the closing bracket after the class is an ordinary `]`
    t("a]", "a]")
    t("[a]]", "a]")
    // a range reaches from one character to the other, in code points
    t("[ -~]", "q")
    f("[ -~]", "\n")

    // --- C: UTF-8, one character is one `?`
    t("?", "\u{e9}")
    f("??", "\u{e9}")
    t("?", "\u{20ac}")
    f("??", "\u{20ac}")
    t("?", "\u{1f600}")
    f("???", "\u{1f600}")
    t("a?b", "a\u{20ac}b")
    f("a??b", "a\u{20ac}b")
    t("[\u{20ac}]", "\u{20ac}")
    f("[\u{20ac}]", "\u{e9}")
    t("[\u{e9}-\u{20ac}]", "\u{3b1}")
    f("[\u{e9}-\u{20ac}]", "a")
    t("[!a]", "\u{e9}")
    t("[a-\u{ff}]", "\u{e9}")
    t("*\u{e9}", "caf\u{e9}")
    f("*e", "caf\u{e9}")
    // a byte that is not UTF-8 is one character of its own
    var bad: [u8; 3] = [97 as u8, 255 as u8, 98 as u8]
    var bad_str: str = str { p: &bad[0], n: 3 }
    t("a?b", bad_str)
    f("a??b", bad_str)
    t("a*b", bad_str)
    var lone: [u8; 1] = [226 as u8]
    t("?", str { p: &lone[0], n: 1 })
    var cut: [u8; 2] = [226 as u8, 130 as u8]
    t("??", str { p: &cut[0], n: 2 })
    f("?", str { p: &cut[0], n: 2 })

    // --- D: no escape, case, separators, dots
    t("a\\b", "a\\b")
    f("a\\b", "ab")
    f("a", "A")
    t("[A-Z]", "Q")
    f("[A-Z]", "q")
    t("*", "a/b")
    t("a?b", "a/b")
    t("*", ".hidden")
    t("?a", ".a")
    t("a*", "a\nb")
    t("a?b", "a\nb")
    t("[!a]", "\n")
    t("a.b", "a.b")
    f("a.b", "axb")

    // --- E: slow patterns stay fast
    var many: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 20000 {
        rt.buf_push(&many, 97 as u8)
        i = i + 1
    }
    var pat: rt.Buf = rt.buf_new()
    i = 0
    while i < 12 {
        rt.buf_push(&pat, 97 as u8)
        rt.buf_push(&pat, 42 as u8)
        i = i + 1
    }
    rt.buf_push(&pat, 98 as u8)
    if glob.matches(str { p: rt.buf_data(&pat), n: rt.buf_len(&pat) }, str { p: rt.buf_data(&many), n: rt.buf_len(&many) }) {
        failures = failures + 1
        say("  FAIL  a*a*...*b must not match aaaa...\n")
    }
    rt.buf_push(&many, 98 as u8)
    if !glob.matches(str { p: rt.buf_data(&pat), n: rt.buf_len(&pat) }, str { p: rt.buf_data(&many), n: rt.buf_len(&many) }) {
        failures = failures + 1
        say("  FAIL  a*a*...*b must match aaaa...b\n")
    }
    rt.buf_free(&pat)
    rt.buf_free(&many)

    // --- F: has_magic, escape
    if !glob.has_magic("a*") || !glob.has_magic("?") || !glob.has_magic("x[y") || glob.has_magic("plain.txt") || glob.has_magic("") || glob.has_magic("a]b") {
        failures = failures + 1
        say("  FAIL  has_magic\n")
    }
    var esc: rt.Buf = rt.buf_new()
    glob.escape("a*b?c[d]e/f", &esc)
    if rt.buf_len(&esc) != 17 || !glob.matches(str { p: rt.buf_data(&esc), n: rt.buf_len(&esc) }, "a*b?c[d]e/f") || glob.matches(str { p: rt.buf_data(&esc), n: rt.buf_len(&esc) }, "aXb?c[d]e/f") {
        failures = failures + 1
        say("  FAIL  escape\n")
    }
    rt.buf_free(&esc)

    if failures != 0 {
        return 1
    }
    return 0
}
