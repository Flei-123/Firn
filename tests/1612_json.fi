// expect_exit: 0
// tests/1612_json.fi -- ROUND 81: `lib/std/json.fi` inside one process.
//
// The formal proof is JSONTestSuite in `tools/stdlib81/run.sh` (95 `y_`
// accepted, 188 `n_` refused). What stands here is what a test suite of
// FILES cannot check: the API. Does `json_get` find the right member, does
// a number come out as an integer when it is one, does the writer produce
// something the parser reads back, and does a refusal name the right LINE
// AND COLUMN.
//
//   A  the shapes: object, array, string, number, true, false, null
//   B  ACCESS: by key, by index, nested, and a key that is not there
//   C  NUMBERS: integer stays exact (i64), float stays float, the sign, the
//      exponent
//   D  ESCAPES in both directions, including \u with a surrogate pair
//   E  REFUSALS with line and column: the standard's own forbidden cases
//   F  the round trip: write, parse again, compare
//   G  `JsonWriter` -- JSON without a document
import std.json
import std.rt
import std.io
import std.str

fn parse(d: *mut json.Json, text: u64, n: usize) -> bool {
    return json.json_parse(d, text, n) catch false
}

fn key_is(d: *mut json.Json, node: u32, lit: u64) -> bool {
    let s: str.Span = json.json_key(d, node)
    let n: usize = rt.c_length(lit)
    if s.n != n {
        return false
    }
    return rt.mem_eq(s.p as u64, lit, n)
}

fn str_is(d: *mut json.Json, node: u32, lit: u64) -> bool {
    let s: str.Span = json.json_string(d, node)
    let n: usize = rt.c_length(lit)
    if s.n != n {
        return false
    }
    return rt.mem_eq(s.p as u64, lit, n)
}

fn main() -> i32 {
    var d: json.Json = json.json_new()
    defer json.json_free(&d)

    // --- A/B/C: a document with every shape in it
    var doc: [u8; 119] =
    "{\"n\": null, \"t\": true, \"f\": false, \"i\": -42, \"x\": 1.5e2, \"s\": \"a\\u00e4b\", \"arr\": [1, 2, {\"deep\": \"yes\"}], \"empty\": {}}\0"
    if !parse(&d, (&doc[0]) as u64, rt.c_length((&doc[0]) as u64)) {
        return 10
    }
    let root: u32 = json.json_root(&d)
    if json.json_kind(&d, root) != json.JSON_OBJECT {
        return 11
    }
    if json.json_count(&d, root) != 8 {
        return 12
    }
    var k_n: [u8; 2] = "n\0"
    var k_t: [u8; 2] = "t\0"
    var k_f: [u8; 2] = "f\0"
    var k_i: [u8; 2] = "i\0"
    var k_x: [u8; 2] = "x\0"
    var k_s: [u8; 2] = "s\0"
    var k_arr: [u8; 4] = "arr\0"
    var k_none: [u8; 5] = "nope\0"
    if !json.json_is_null(&d, json.json_get_c(&d, root, (&k_n[0]) as u64)) {
        return 13
    }
    if !json.json_bool(&d, json.json_get_c(&d, root, (&k_t[0]) as u64)) {
        return 14
    }
    if json.json_bool(&d, json.json_get_c(&d, root, (&k_f[0]) as u64)) {
        return 15
    }
    if json.json_get_c(&d, root, (&k_none[0]) as u64) != json.JSON_NONE {
        return 16
    }
    // C: the integer is EXACT and is marked as an integer
    let ni: u32 = json.json_get_c(&d, root, (&k_i[0]) as u64)
    if !json.json_is_int(&d, ni) || json.json_int(&d, ni) != 0 - 42 {
        return 17
    }
    // 1.5e2 is 150 and is NOT an integer
    let nx: u32 = json.json_get_c(&d, root, (&k_x[0]) as u64)
    if json.json_is_int(&d, nx) {
        return 18
    }
    if json.json_number(&d, nx) != 150.0 {
        return 19
    }
    // D: ä becomes the two UTF-8 octets C3 A4
    let ns: u32 = json.json_get_c(&d, root, (&k_s[0]) as u64)
    let sp: str.Span = json.json_string(&d, ns)
    if sp.n != 4 {
        return 20
    }
    if rt.ld8(sp.p as u64, 0) != 97 as u8 || rt.ld8(sp.p as u64, 1) != 195 as u8
    || rt.ld8(sp.p as u64, 2) != 164 as u8 || rt.ld8(sp.p as u64, 3) != 98 as u8 {
        return 21
    }
    // B: into the array and one level deeper
    let arr: u32 = json.json_get_c(&d, root, (&k_arr[0]) as u64)
    if json.json_kind(&d, arr) != json.JSON_ARRAY || json.json_count(&d, arr) != 3 {
        return 22
    }
    if json.json_int(&d, json.json_child_at(&d, arr, 1)) != 2 {
        return 23
    }
    let deep: u32 = json.json_child_at(&d, arr, 2)
    var k_deep: [u8; 5] = "deep\0"
    var v_yes: [u8; 4] = "yes\0"
    if !str_is(&d, json.json_get_c(&d, deep, (&k_deep[0]) as u64),
        (&v_yes[0]) as u64) {
        return 24
    }
    // the key of a member of an object
    if !key_is(&d, arr, (&k_arr[0]) as u64) {
        return 25
    }

    // --- D: a surrogate pair becomes ONE code point (U+1F600, four octets)
    var emoji: [u8; 17] = "[\"\\ud83d\\ude00\"]\0"
    var d2: json.Json = json.json_new()
    defer json.json_free(&d2)
    if !parse(&d2, (&emoji[0]) as u64, rt.c_length((&emoji[0]) as u64)) {
        return 30
    }
    let es: str.Span = json.json_string(&d2, json.json_child(&d2,
            json.json_root(&d2)))
    if es.n != 4 {
        return 31
    }
    if rt.ld8(es.p as u64, 0) != 240 as u8 || rt.ld8(es.p as u64, 1) != 159 as u8
    || rt.ld8(es.p as u64, 2) != 152 as u8 || rt.ld8(es.p as u64, 3) != 128 as u8 {
        return 32
    }

    // --- E: what the standard forbids, with the position
    var bad1: [u8; 10] = "{\"a\": 01}\0" // a leading zero
    var bad2: [u8; 8] = "[1, 2,]\0" // a trailing comma
    var bad3: [u8; 9] = "{'a': 1}\0" // single quotes
    var bad4: [u8; 9] = "[1] junk\0" // something behind the value
    var bad5: [u8; 5] = "[.5]\0" // a number without a digit in front
    var bad6: [u8; 5] = "[1e]\0" // an exponent without digits
    var bad7: [u8; 8] = "[\"a\nb\"]\0" // a raw newline inside a string
    var bad8: [u8; 6] = "[tru]\0" // a broken literal
    var d3: json.Json = json.json_new()
    defer json.json_free(&d3)
    if parse(&d3, (&bad1[0]) as u64, rt.c_length((&bad1[0]) as u64)) { return 40 }
    if parse(&d3, (&bad2[0]) as u64, rt.c_length((&bad2[0]) as u64)) { return 41 }
    if parse(&d3, (&bad3[0]) as u64, rt.c_length((&bad3[0]) as u64)) { return 42 }
    if parse(&d3, (&bad4[0]) as u64, rt.c_length((&bad4[0]) as u64)) { return 43 }
    if parse(&d3, (&bad5[0]) as u64, rt.c_length((&bad5[0]) as u64)) { return 44 }
    if parse(&d3, (&bad6[0]) as u64, rt.c_length((&bad6[0]) as u64)) { return 45 }
    if parse(&d3, (&bad7[0]) as u64, rt.c_length((&bad7[0]) as u64)) { return 46 }
    if parse(&d3, (&bad8[0]) as u64, rt.c_length((&bad8[0]) as u64)) { return 47 }
    // the position of the last refusal: line 1, and the column has to point
    // INTO the text, not at 0 and not past its end
    if json.json_err_line(&d3) != 1 {
        return 48
    }
    if json.json_err_col(&d3) < 2 || json.json_err_col(&d3) > 8 {
        return 49
    }
    // a refusal on the THIRD line has to say 3
    var multi: [u8; 23] = "{\n  \"a\": 1,\n  \"b\": :\n}\0"
    if parse(&d3, (&multi[0]) as u64, rt.c_length((&multi[0]) as u64)) {
        return 50
    }
    if json.json_err_line(&d3) != 3 {
        return 51
    }

    // --- F: the round trip through the writer
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    json.json_write(&d, root, &out, true)
    var d4: json.Json = json.json_new()
    defer json.json_free(&d4)
    if !parse(&d4, rt.buf_ptr(&out), rt.buf_len(&out)) {
        return 60
    }
    if json.json_count(&d4, json.json_root(&d4)) != 8 {
        return 61
    }
    let ni2: u32 = json.json_get_c(&d4, json.json_root(&d4), (&k_i[0]) as u64)
    if json.json_int(&d4, ni2) != 0 - 42 {
        return 62
    }
    // the string survives the escaping
    var want_s: [u8; 5] = [97, 195, 164, 98, 0]
    if !str_is(&d4, json.json_get_c(&d4, json.json_root(&d4),
            (&k_s[0]) as u64), (&want_s[0]) as u64) {
        return 63
    }

    // --- G: the writer without a document
    var wbuf: rt.Buf = rt.buf_new()
    defer rt.buf_free(&wbuf)
    var w: json.JsonWriter = json.jw_new(&wbuf, false)
    var wk: [u8; 3] = "id\0"
    var wv: [u8; 5] = "list\0"
    json.jw_begin_object(&w)
    json.jw_key_c(&w, (&wk[0]) as u64)
    json.jw_int(&w, 7)
    json.jw_key_c(&w, (&wv[0]) as u64)
    json.jw_begin_array(&w)
    json.jw_int(&w, 1)
    json.jw_bool(&w, false)
    json.jw_null(&w)
    json.jw_end(&w)
    json.jw_end(&w)
    if !json.jw_ok(&w) {
        return 70
    }
    json.jw_free(&w)
    var d5: json.Json = json.json_new()
    defer json.json_free(&d5)
    if !parse(&d5, rt.buf_ptr(&wbuf), rt.buf_len(&wbuf)) {
        return 71
    }
    let wl: u32 = json.json_get_c(&d5, json.json_root(&d5), (&wv[0]) as u64)
    if json.json_count(&d5, wl) != 3 {
        return 72
    }
    if json.json_int(&d5, json.json_get_c(&d5, json.json_root(&d5),
            (&wk[0]) as u64)) != 7 {
        return 73
    }

    var ok: [u8; 8] = "json ok\0"
    io.print_line_bytes((&ok[0]) as u64, 7)
    return 0
}
