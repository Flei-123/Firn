// expect_exit: 0
// MODULE CHAIN IN THE CORE LANGUAGE -- the proof that `firnc1` compiles
// several files and keeps the names apart while doing it.
//
// Three levels, and the name `value` exists in ALL three. Without renaming,
// one version would hide the other; with renaming they are called
// `deep__value`, `mid__value` and `value` internally.
//
// On top of that: a constant and a struct from another module, and a module
// chain over two levels (`mid` imports `deep`).
import modules.core.mid
import modules.core.deep

fn value() -> i32 {
    return 1
}

fn main() -> i32 {
    // its own version
    if value() != 1 {
        return 1
    }
    // the one of the middle level: 7 * 10
    if mid.value() != 70 {
        return 2
    }
    // the one of the lowest level
    if deep.value() != 7 {
        return 3
    }
    // a constant from another module
    if deep.BASE != 7 {
        return 4
    }
    // a struct from another module, passed by value
    let p: deep.Pair = deep.Pair { a: 20, b: 22 }
    if deep.sum(p) != 42 {
        return 5
    }
    // a function of the middle level on a value of the lowest
    if mid.duplicate(deep.BASE) != 14 {
        return 6
    }
    return 0
}
