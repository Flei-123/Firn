// expect_exit: 0
import std.rt
import mc.mc_inv_tooltip

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn same(b: *mut rt.Buf, t: str) -> bool {
    if rt.buf_len(b) != t.length() { return false }
    var i: usize = 0
    while i < t.length() {
        if rt.ld8(rt.buf_ptr(b), i) != rt.ld8(t.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    var b: rt.Buf = rt.buf_new()
    let a: str = "iron_pickaxe"
    mc_inv_tooltip.tip_title(a.p as u64, a.length(), &b)
    check(same(&b, "Iron Pickaxe"), 1)
    rt.buf_free(&b)
    var c: rt.Buf = rt.buf_new()
    let z: str = "stone"
    mc_inv_tooltip.tip_title(z.p as u64, z.length(), &c)
    check(same(&c, "Stone"), 2)
    rt.buf_free(&c)
    return 0
}
