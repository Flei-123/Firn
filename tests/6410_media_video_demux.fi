// expect_exit: 0
import std.rt
import std.fs
import media.demux

fn load(path: str, b: *mut rt.Buf) -> bool {
    let got: usize = fs.read_file(path, b) catch | e | (0 -% 1)
    return got != (0 -% 1)
}

fn check_av_main() -> bool {
    var b: rt.Buf = rt.buf_new()
    if !load("testdata/media_video/av_main.mp4", &b) {
        return false
    }
    var d: demux.Demux = demux.demux_new()
    if demux.demux_open(&d, b.ptr, rt.buf_len(&b)) != 0 {
        return false
    }
    let v: i32 = demux.demux_find_track(&d, demux.TK_VIDEO)
    let a: i32 = demux.demux_find_track(&d, demux.TK_AUDIO)
    var ok: bool = demux.demux_format(&d) == demux.FMT_MP4 && demux.demux_ntracks(&d) == 2 && v >= 0 && a >= 0
    ok = ok && demux.demux_track_codec(&d, v) == demux.CODEC_H264 && demux.demux_track_codec(&d, a) == demux.CODEC_AAC
    ok = ok && demux.demux_track_width(&d, v) == (64 as u32) && demux.demux_track_height(&d, v) == (48 as u32)
    ok = ok && demux.demux_nsamples(&d, v) == 50 && demux.demux_nsamples(&d, a) == 88
    ok = ok && demux.demux_track_hz(&d, a) == (44100 as u32)
    ok = ok && demux.demux_sample_sync(&d, v, 0) && !demux.demux_sample_sync(&d, v, 1)
    ok = ok && demux.demux_sample_pts_us(&d, v, 0) == 0 && demux.demux_sample_pts_us(&d, v, 1) == 120000
    ok = ok && demux.demux_seek_sync(&d, v, 900000) == 0 && demux.demux_seek_sync(&d, v, 1100000) == 25
    ok = ok && demux.demux_duration_us(&d) > 1990000 && demux.demux_duration_us(&d) < 2030000
    ok = ok && demux.demux_track_cfg_len(&d, v) > 0 && demux.demux_track_cfg(&d, v) != 0
    demux.demux_free(&d)
    rt.buf_free(&b)
    return ok
}

fn check_webm() -> bool {
    var b: rt.Buf = rt.buf_new()
    if !load("testdata/media_video/av_vp8.webm", &b) {
        return false
    }
    var d: demux.Demux = demux.demux_new()
    if demux.demux_open(&d, b.ptr, rt.buf_len(&b)) != 0 {
        return false
    }
    let v: i32 = demux.demux_find_track(&d, demux.TK_VIDEO)
    let a: i32 = demux.demux_find_track(&d, demux.TK_AUDIO)
    var ok: bool = demux.demux_format(&d) == demux.FMT_WEBM && demux.demux_ntracks(&d) == 2 && v >= 0 && a >= 0
    ok = ok && demux.demux_track_codec(&d, v) == demux.CODEC_VP8 && demux.demux_track_codec(&d, a) == demux.CODEC_OPUS
    ok = ok && demux.demux_nsamples(&d, v) == 50 && demux.demux_nsamples(&d, a) == 101
    ok = ok && demux.demux_track_width(&d, v) == (64 as u32) && demux.demux_track_hz(&d, a) == (48000 as u32)
    ok = ok && demux.demux_duration_us(&d) == 2008000
    ok = ok && demux.demux_sample_sync(&d, v, 0) && demux.demux_sample_pts_us(&d, v, 0) == 7000
    demux.demux_free(&d)
    rt.buf_free(&b)
    return ok
}

fn check_fragmented() -> bool {
    var b: rt.Buf = rt.buf_new()
    if !load("testdata/media_video/frag.mp4", &b) {
        return false
    }
    var d: demux.Demux = demux.demux_new()
    if demux.demux_open(&d, b.ptr, rt.buf_len(&b)) != 0 {
        return false
    }
    let v: i32 = demux.demux_find_track(&d, demux.TK_VIDEO)
    let ok: bool = v >= 0 && demux.demux_nsamples(&d, v) == 50 && demux.demux_duration_us(&d) == 2000000
    demux.demux_free(&d)
    rt.buf_free(&b)
    return ok
}

fn check_garbage() -> bool {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 64 {
        rt.buf_push(&b, ((i * 7) % 256) as u8)
        i = i + 1
    }
    var d: demux.Demux = demux.demux_new()
    let rc: i32 = demux.demux_open(&d, b.ptr, rt.buf_len(&b))
    let ok: bool = rc != 0 && demux.demux_ntracks(&d) == 0
    demux.demux_free(&d)
    rt.buf_free(&b)
    return ok
}

fn main() -> i32 {
    if !check_av_main() {
        return 1
    }
    if !check_webm() {
        return 2
    }
    if !check_fragmented() {
        return 3
    }
    if !check_garbage() {
        return 4
    }
    return 0
}
