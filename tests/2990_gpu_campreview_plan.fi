// expect_out: ok
// tests/2990_gpu_campreview_plan.fi -- gpu.campreview: the pure part of the GPU camera preview. For every rotation
// (0/90/180/270), mirror on/off, cover/contain and several box shapes the plan must (1) map the four corners of the
// box to the right corner of the sensor image (rotation direction as the old CPU preview did it: rotate the sensor
// image CLOCKWISE), (2) never stretch (the visible part of the picture has the aspect of the box in cover mode, the
// bars keep the picture's aspect in contain mode), (3) stay inside the sensor image, and cp_rotation follows the
// Android camera guide (back: sensor - display, front: sensor + display).
import std.io
import gpu.campreview

fn fail(msg: str) -> bool {
    io.print(msg)
    io.new_line()
    return false
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000001
}

// The old CPU preview (camera_preview_bgrx) for output (ox, oy) of ow x oh and sensor w x h, rot, no mirror:
// the source pixel in sensor coordinates 0..1 (corner centres of the box).
fn cpu_old(w: i32, h: i32, ow: i32, oh: i32, rot: i32, ox: i32, oy: i32, sx: *mut f64, sy: *mut f64) {
    var a: i32 = 0
    var b: i32 = 0
    if rot == 90 {
        a = oy * w / oh
        b = (ow - 1 - ox) * h / ow
    } else if rot == 270 {
        a = (oh - 1 - oy) * w / oh
        b = ox * h / ow
    } else if rot == 180 {
        a = (ow - 1 - ox) * w / ow
        b = (oh - 1 - oy) * h / oh
    } else {
        a = ox * w / ow
        b = oy * h / oh
    }
    *sx = ((a as f64) + 0.5) / (w as f64)
    *sy = ((b as f64) + 0.5) / (h as f64)
}

fn main() -> i32 {
    var ok: bool = true
    // 1. rotation formula
    if campreview.cp_rotation(90, 0, false) != 90 { ok = fail("back 90/0") }
    if campreview.cp_rotation(90, 90, false) != 0 { ok = fail("back 90/90") }
    if campreview.cp_rotation(90, 270, false) != 180 { ok = fail("back 90/270") }
    if campreview.cp_rotation(270, 0, true) != 270 { ok = fail("front 270/0") }
    if campreview.cp_rotation(270, 90, true) != 0 { ok = fail("front 270/90") }
    if campreview.cp_rotation(0, 270, false) != 90 { ok = fail("back 0/270") }
    if campreview.cp_rotation(90, 0 - 90, false) != 180 { ok = fail("negative display") }
    // 2. plan against the old CPU mapping, no mirror, box with the picture's own aspect (no crop)
    var rots: [i32; 4] = [0, 90, 180, 270]
    var ri: usize = 0
    while ri < 4 {
        let rot: i32 = rots[ri]
        let iw: i32 = 640
        let ih: i32 = 480
        var vw: i32 = 480
        var vh: i32 = 640
        if rot == 0 || rot == 180 {
            vw = 640
            vh = 480
        }
        var pl: campreview.Plan = campreview.Plan { crop: [0.0; 4], m: [0.0; 4], t: [0.0; 2], quad: [1.0; 2], rot: 0 }
        campreview.cp_plan(iw, ih, rot, false, vw, vh, true, &pl)
        if pl.rot != rot { ok = fail("rot kept") }
        if !near(pl.crop[2], 1.0) || !near(pl.crop[3], 1.0) { ok = fail("no crop at own aspect") }
        // the four corner pixel centres
        var k: i32 = 0
        while k < 4 {
            var ox: i32 = 0
            var oy: i32 = 0
            if k == 1 || k == 3 { ox = vw - 1 }
            if k == 2 || k == 3 { oy = vh - 1 }
            var gx: f64 = 0.0
            var gy: f64 = 0.0
            campreview.cp_map(&pl, ((ox as f64) + 0.5) / (vw as f64), ((oy as f64) + 0.5) / (vh as f64), &gx, &gy)
            var cx: f64 = 0.0
            var cy: f64 = 0.0
            cpu_old(iw, ih, vw, vh, rot, ox, oy, &cx, &cy)
            if !near(gx, cx) && !(gx - cx < 0.01 && cx - gx < 0.01) { ok = fail("corner x differs from the CPU preview") }
            if !(gy - cy < 0.01 && cy - gy < 0.01) { ok = fail("corner y differs from the CPU preview") }
            k = k + 1
        }
        ri = ri + 1
    }
    // 3. mirror flips the display left/right
    var pa: campreview.Plan = campreview.Plan { crop: [0.0; 4], m: [0.0; 4], t: [0.0; 2], quad: [1.0; 2], rot: 0 }
    var pb: campreview.Plan = campreview.Plan { crop: [0.0; 4], m: [0.0; 4], t: [0.0; 2], quad: [1.0; 2], rot: 0 }
    campreview.cp_plan(640, 480, 270, false, 360, 720, true, &pa)
    campreview.cp_plan(640, 480, 270, true, 360, 720, true, &pb)
    var q: f64 = 0.0
    while q < 1.0 {
        var x0: f64 = 0.0
        var y0: f64 = 0.0
        var x1: f64 = 0.0
        var y1: f64 = 0.0
        campreview.cp_map(&pa, q, 0.3, &x0, &y0)
        campreview.cp_map(&pb, 1.0 - q, 0.3, &x1, &y1)
        if !near(x0, x1) || !near(y0, y1) { ok = fail("mirror is not a left/right flip") }
        q = q + 0.125
    }
    // 4. cover: visible window has the aspect of the box and lies inside the picture; contain: bars keep the aspect
    var shapes: [i32; 8] = [360, 720, 720, 360, 1080, 1080, 100, 900]
    ri = 0
    while ri < 4 {
        var si: usize = 0
        while si < 4 {
            let vw: i32 = shapes[si * 2]
            let vh: i32 = shapes[si * 2 + 1]
            var pc: campreview.Plan = campreview.Plan { crop: [0.0; 4], m: [0.0; 4], t: [0.0; 2], quad: [1.0; 2], rot: 0 }
            var pk: campreview.Plan = campreview.Plan { crop: [0.0; 4], m: [0.0; 4], t: [0.0; 2], quad: [1.0; 2], rot: 0 }
            let iw: i32 = 4000
            let ih: i32 = 3000
            campreview.cp_plan(iw, ih, rots[ri], false, vw, vh, true, &pc)
            campreview.cp_plan(iw, ih, rots[ri], false, vw, vh, false, &pk)
            var dw: f64 = iw as f64
            var dh: f64 = ih as f64
            if rots[ri] == 90 || rots[ri] == 270 { dw = ih as f64; dh = iw as f64 }
            // cover: (crop.w * dw) / (crop.h * dh) == vw / vh
            let aspect_box: f64 = (vw as f64) / (vh as f64)
            let aspect_vis: f64 = (pc.crop[2] * dw) / (pc.crop[3] * dh)
            if !near(aspect_box, aspect_vis) { ok = fail("cover stretches") }
            if pc.crop[0] < 0.0 - 0.000001 || pc.crop[1] < 0.0 - 0.000001 || pc.crop[0] + pc.crop[2] > 1.000001 || pc.crop[1] + pc.crop[3] > 1.000001 { ok = fail("cover leaves the picture") }
            if !near(pc.quad[0], 1.0) || !near(pc.quad[1], 1.0) { ok = fail("cover quad") }
            // contain: the bars: (quad.x * vw) / (quad.y * vh) == dw / dh and one side full
            let aspect_pic: f64 = dw / dh
            let aspect_bar: f64 = (pk.quad[0] * (vw as f64)) / (pk.quad[1] * (vh as f64))
            if !near(aspect_pic, aspect_bar) { ok = fail("contain stretches") }
            if !(near(pk.quad[0], 1.0) || near(pk.quad[1], 1.0)) { ok = fail("contain fills no side") }
            if !near(pk.crop[2], 1.0) || !near(pk.crop[3], 1.0) { ok = fail("contain crops") }
            si = si + 1
        }
        ri = ri + 1
    }
    if ok { io.print("ok") }
    return 0
}
