// expect_exit: 42
import av1.still
import av1.seqdec
import av1.av1cdfio
import av1.avif_cdf
import std.fs
import std.rt

fn diff_cells(a: u64, b: u64, n: i64) -> i64 {
    var d: i64 = 0
    var i: i64 = 0
    while i < n {
        if av1cdfio.cell_at(a, i) != av1cdfio.cell_at(b, i) {
            d = d + 1
        }
        i = i + 1
    }
    return d
}

fn run_all(h: u64) -> bool {
    var guard: i32 = 0
    while guard < 64 {
        var f: still.Frame = still.frame_new()
        let rc: i32 = seqdec.seq_next(h, &f)
        if rc == seqdec.SEQ_END {
            return true
        }
        if rc == seqdec.SEQ_FRAME {
            still.frame_free(&f)
        } else if rc != seqdec.SEQ_HIDDEN {
            return false
        }
        guard = guard + 1
    }
    return false
}

fn run_first(h: u64) -> bool {
    var f: still.Frame = still.frame_new()
    let rc: i32 = seqdec.seq_next(h, &f)
    if rc == seqdec.SEQ_FRAME {
        still.frame_free(&f)
        return true
    }
    return rc == seqdec.SEQ_HIDDEN
}

fn count_valid(h: u64) -> i64 {
    let m: u64 = av1cdfio.buf_new(av1cdfio.MODE_CELLS)
    let k: u64 = av1cdfio.buf_new(av1cdfio.COEF_CELLS)
    var n: i64 = 0
    var s: i64 = 0
    while s < 8 {
        if seqdec.seq_cdfs(h, s, m, k) {
            n = n + 1
        }
        s = s + 1
    }
    return n
}

fn check_file(name: str, all_equal: bool, first_only: bool, expect_adapted: bool) -> i32 {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(name, &data) catch 0
    if n == 0 {
        return 1
    }
    let h: u64 = seqdec.seq_open(rt.buf_ptr(&data), n)
    if h == 0 {
        return 2
    }
    if first_only {
        if !run_first(h) || count_valid(h) != 8 {
            return 3
        }
    } else if !run_all(h) {
        return 3
    }
    let dm: u64 = av1cdfio.buf_new(av1cdfio.MODE_CELLS)
    let dk: u64 = av1cdfio.buf_new(av1cdfio.COEF_CELLS)
    let sm: u64 = av1cdfio.buf_new(av1cdfio.MODE_CELLS)
    let sk: u64 = av1cdfio.buf_new(av1cdfio.COEF_CELLS)
    let tm: u64 = av1cdfio.buf_new(av1cdfio.MODE_CELLS)
    let tk: u64 = av1cdfio.buf_new(av1cdfio.COEF_CELLS)
    var rc: i32 = 0
    var valid: i64 = 0
    var adapted: i64 = 0
    var slot: i64 = 0
    while slot < 8 {
        if seqdec.seq_cdfs(h, slot, sm, sk) {
            valid = valid + 1
            if av1cdfio.layout_check(sm, sk) != 0 {
                rc = 4
            }
            var q: i64 = 0
            var best: i64 = 1 << 40
            while q < 4 {
                av1cdfio.load_defaults(q, dm, dk)
                let d: i64 = diff_cells(sk, dk, av1cdfio.COEF_CELLS)
                if d < best {
                    best = d
                }
                q = q + 1
            }
            av1cdfio.load_defaults(0, dm, dk)
            let is_default: bool = diff_cells(sm, dm, av1cdfio.MODE_CELLS) == 0 && best == 0
            if !expect_adapted && !is_default {
                rc = 5
            }
            if !is_default {
                adapted = adapted + 1
            }
            if all_equal {
                if !seqdec.seq_cdfs(h, 0, tm, tk) || diff_cells(sm, tm, av1cdfio.MODE_CELLS) != 0 || diff_cells(sk, tk, av1cdfio.COEF_CELLS) != 0 {
                    rc = 6
                }
            }
        }
        slot = slot + 1
    }
    if valid == 0 {
        rc = 7
    }
    if expect_adapted && adapted != valid {
        rc = 9
    }
    if all_equal && valid != 8 {
        rc = 8
    }
    seqdec.seq_free(h)
    rt.buf_free(&data)
    return rc
}

fn main() -> i32 {
    let dm: u64 = av1cdfio.buf_new(av1cdfio.MODE_CELLS)
    let dk: u64 = av1cdfio.buf_new(av1cdfio.COEF_CELLS)
    var q: i64 = 0
    while q < 4 {
        av1cdfio.load_defaults(q, dm, dk)
        if av1cdfio.layout_check(dm, dk) != 0 { return 1 }
        q = q + 1
    }
    let r1: i32 = check_file("tests/data/av1/seq/seq_c129_420_hk_se.obu", true, false, false)
    if r1 != 0 { return 10 + r1 }
    let r2: i32 = check_file("tests/data/av1/seq/seq_c200_420_io.obu", false, false, false)
    if r2 != 0 { return 20 + r2 }
    let r3: i32 = check_file("tests/data/av1/inter/gmv.obu", true, true, true)
    if r3 != 0 { return 30 + r3 }
    let r4: i32 = check_file("tests/data/av1/inter/lag8.obu", true, true, true)
    if r4 != 0 { return 40 + r4 }
    let r5: i32 = check_file("tests/data/av1/inter/grain.obu", true, true, true)
    if r5 != 0 { return 50 + r5 }
    return 42
}
