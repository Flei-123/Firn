// expect_exit: 0
// ROUND 47 -- the NEGATIVE SIDE of the finalizer interface.
//
// Every rejection is checked. None of it may pass silently:
//   * null pointer, pointer to the stack, pointer into the middle of an object
//   * cleanup kind 0 and cleanup kind > 16777215
//   * double registration
//   * `gc_finalizer_delete` BEFORE the collection really takes it back --
//     the object is then collected WITHOUT a finalizer
//   * `gc_finalizer_kind` yields 0 when none is registered

const KIND_TOO_BIG: u64 = 16777216
const KIND_LIMIT: u64 = 16777215

gc class Thing {
    next: Gc[Thing],
    value: u64,
}

fn __gc_finalize(kind: u64, p: *mut u8) {
    // This test only counts the RUNS (gc_fin_runs()); the dispatcher itself has
    // to do nothing. The parameters are touched deliberately so that it is
    // clear that the signature is the agreed one.
    let d: Gc[Thing] = p as Gc[Thing]
    if kind == 0 {
        return
    }
    if d == gc_null[Thing]() {
        return
    }
}

fn away(depth: u64) -> AllocError!bool {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    if depth > 0 {
        return try away(depth - 1)
    }
    let d: Gc[Thing] = try gc Thing { next: gc_null[Thing](), value: 1 }
    if !gc_finalizer_set(d as *mut u8, 4) {
        return false
    }
    if !gc_finalizer_delete(d as *mut u8) {
        return false
    }
    if gc_finalizer_kind(d as *mut u8) != 0 {
        return false
    }
    return true
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}

fn run() -> AllocError!i32 {
    var stack_value: u64 = 12345
    let d: Gc[Thing] = try gc Thing { next: gc_null[Thing](), value: 3 }

    // --- pointers that are not the start of an object ----------------------
    if gc_finalizer_set(0 as *mut u8, 1) {
        return 1
    }
    if gc_finalizer_set((&stack_value) as *mut u8, 1) {
        return 2
    }
    // Into the middle of the object (field 2) -- not the start of an object.
    if gc_finalizer_set((&d.value) as *mut u8, 1) {
        return 3
    }

    // --- forbidden cleanup kinds -------------------------------------------
    if gc_finalizer_set(d as *mut u8, 0) {
        return 4
    }
    if gc_finalizer_set(d as *mut u8, KIND_TOO_BIG) {
        return 5
    }
    if gc_finalizer_kind(d as *mut u8) != 0 {
        return 6
    }

    // --- the largest allowed kind works ------------------------------------
    if !gc_finalizer_set(d as *mut u8, KIND_LIMIT) {
        return 7
    }
    if gc_finalizer_kind(d as *mut u8) != KIND_LIMIT {
        return 8
    }
    // --- twice does not work -------------------------------------------------
    if gc_finalizer_set(d as *mut u8, 2) {
        return 9
    }
    if gc_finalizer_kind(d as *mut u8) != KIND_LIMIT {
        return 10
    }
    // --- taking it back -----------------------------------------------------
    if !gc_finalizer_delete(d as *mut u8) {
        return 11
    }
    if gc_finalizer_kind(d as *mut u8) != 0 {
        return 12
    }
    if gc_finalizer_delete(d as *mut u8) {
        return 13
    }
    if gc_finalizer_delete(0 as *mut u8) {
        return 14
    }

    // --- a finalizer that was taken back does NOT run ----------------------
    // Up to here EXACTLY ONE registration got through (KIND_LIMIT on `d`);
    // all rejected attempts do not count.
    if gc_fin_registered() != 1 {
        return 15
    }
    if !(try away(2)) {
        return 16
    }
    if gc_fin_registered() != 2 {
        return 21
    }
    gc_collect()
    gc_collect()
    if gc_fin_runs() != 0 {
        return 17
    }
    if gc_fin_waiting() != 0 {
        return 18
    }
    // `d` lives on (it is still in this frame).
    if d.value != 3 {
        return 19
    }
    if stack_value != 12345 {
        return 20
    }
    return 0
}
