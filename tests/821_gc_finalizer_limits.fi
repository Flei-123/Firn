// expect_exit: 0
// RUNDE 47 — die NEGATIVSEITE der Finalisierer-Schnittstelle.
//
// Jede Ablehnung wird geprueft. Nichts davon darf still durchgehen:
//   * Nullzeiger, Zeiger auf den Stapel, Zeiger mitten in ein Objekt
//   * Aufraeumart 0 und Aufraeumart > 16777215
//   * doppelte Registrierung
//   * `gc_finalisierer_loeschen` VOR dem Sammeln nimmt sie wirklich zurueck —
//     das Objekt wird dann OHNE Finalisierer eingesammelt
//   * `gc_finalisierer_art` liefert 0, wenn keine registriert ist

const ART_ZU_GROSS: u64 = 16777216
const ART_GRENZE: u64 = 16777215

gc class Thing {
    next: Gc[Thing],
    value: u64,
}

fn __gc_finalize(kind: u64, p: *mut u8) {
    // Dieser Test zaehlt nur die LAEUFE (gc_fin_laeufe()); der Verteiler
    // selbst muss nichts tun. Die Parameter werden absichtlich beruehrt,
    // damit klar ist, dass die Signatur die vereinbarte ist.
    let d: Gc[Thing] = p as Gc[Thing]
    if kind == 0 {
        return
    }
    if d == gc_null[Thing]() {
        return
    }
}

fn away(depth: u64) -> AllocError!bool {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    if depth > 0 {
        return try away(depth - 1)
    }
    let d: Gc[Thing] = try gc Thing{ next: gc_null[Thing](), value: 1 }
    if !gc_finalizer_set(d as *mut u8, 4) {
        return false
    }
    if !gc_finalizer_delete(d as *mut u8) {
        return false
    }
    if gc_finalizer_kind(d as *mut u8) != 0 {
        return false
    }
    return true
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}

fn run() -> AllocError!i32 {
    var stack_value: u64 = 12345
    let d: Gc[Thing] = try gc Thing{ next: gc_null[Thing](), value: 3 }

    // --- Zeiger, die keine Objektanfaenge sind -----------------------------
    if gc_finalizer_set(0 as *mut u8, 1) {
        return 1
    }
    if gc_finalizer_set((&stack_value) as *mut u8, 1) {
        return 2
    }
    // Mitten ins Objekt (Feld 2) — kein Objektanfang.
    if gc_finalizer_set((&d.value) as *mut u8, 1) {
        return 3
    }

    // --- unerlaubte Aufraeumarten -------------------------------------------
    if gc_finalizer_set(d as *mut u8, 0) {
        return 4
    }
    if gc_finalizer_set(d as *mut u8, ART_ZU_GROSS) {
        return 5
    }
    if gc_finalizer_kind(d as *mut u8) != 0 {
        return 6
    }

    // --- die groesste erlaubte Art geht ------------------------------------
    if !gc_finalizer_set(d as *mut u8, ART_GRENZE) {
        return 7
    }
    if gc_finalizer_kind(d as *mut u8) != ART_GRENZE {
        return 8
    }
    // --- doppelt geht nicht --------------------------------------------------
    if gc_finalizer_set(d as *mut u8, 2) {
        return 9
    }
    if gc_finalizer_kind(d as *mut u8) != ART_GRENZE {
        return 10
    }
    // --- zuruecknehmen ------------------------------------------------------
    if !gc_finalizer_delete(d as *mut u8) {
        return 11
    }
    if gc_finalizer_kind(d as *mut u8) != 0 {
        return 12
    }
    if gc_finalizer_delete(d as *mut u8) {
        return 13
    }
    if gc_finalizer_delete(0 as *mut u8) {
        return 14
    }

    // --- ein zurueckgenommener Finalisierer laeuft NICHT --------------------
    // Bis hier ist GENAU EINE Registrierung durchgekommen (ART_GRENZE auf `d`);
    // alle abgelehnten Versuche zaehlen nicht mit.
    if gc_fin_registered() != 1 {
        return 15
    }
    if !(try away(2)) {
        return 16
    }
    if gc_fin_registered() != 2 {
        return 21
    }
    gc_collect()
    gc_collect()
    if gc_fin_runs() != 0 {
        return 17
    }
    if gc_fin_waiting() != 0 {
        return 18
    }
    // `d` lebt weiter (es steht hier noch im Rahmen).
    if d.value != 3 {
        return 19
    }
    if stack_value != 12345 {
        return 20
    }
    return 0
}
