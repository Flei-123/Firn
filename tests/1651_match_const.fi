// expect_exit: 42
// Round GAPS: a bare name that names a `const` is that constant in a
// pattern (Rust's rule); any other bare name binds. Bool constants work as
// `true`/`false`, negative ones as negative literals, and inside enum
// payload patterns too.
const RED: i32 = 1
const GREEN: i32 = 2
const MINUS: i32 = -4
const ON: bool = true

enum Shape {
    Dot(i32),
    Line(i32, i32),
}

fn color(c: i32) -> i32 {
    var r: i32 = 0
    match c {
        RED => { r = 10 }
        GREEN => { r = 20 }
        MINUS => { r = 30 }
        n => { r = n }
    }
    return r
}

fn flag(b: bool) -> i32 {
    var r: i32 = 0
    match b {
        ON => { r = 1 }
        false => { r = 2 }
    }
    return r
}

fn shape(s: Shape) -> i32 {
    var r: i32 = 0
    match s {
        Shape::Dot(RED) => { r = 3 }
        Shape::Dot(x) => { r = x }
        Shape::Line(GREEN, y) => { r = y }
        Shape::Line(_, _) => { r = 0 }
    }
    return r
}

fn main() -> i32 {
    if color(1) != 10 || color(2) != 20 || color(-4) != 30 || color(77) != 77 {
        return 1
    }
    if flag(true) != 1 || flag(false) != 2 {
        return 2
    }
    if shape(Shape::Dot(1)) != 3 || shape(Shape::Dot(9)) != 9 {
        return 3
    }
    if shape(Shape::Line(2, 11)) != 11 || shape(Shape::Line(3, 11)) != 0 {
        return 4
    }
    return 42
}
