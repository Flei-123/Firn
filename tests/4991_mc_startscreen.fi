// expect_exit: 0
import std.rt
import mc.mc_raster
import mc.mc_launch_cfg
import mc.mc_startscreen

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn type_text(f: *mut mc_startscreen.StartForm, t: str) {
    var i: usize = 0
    while i < t.n {
        mc_startscreen.form_char(f, t.chars(i) as u32)
        i = i + 1
    }
}

fn eq(f: *mut mc_startscreen.StartForm, k: i32, t: str) -> bool {
    if mc_startscreen.form_text_len(f, k) != t.n { return false }
    var i: usize = 0
    while i < t.n {
        if rt.ld8(mc_startscreen.form_text_ptr(f, k), i) != t.chars(i) { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    var f: mc_startscreen.StartForm = mc_startscreen.form_new()
    check(eq(&f, mc_startscreen.FIELD_PORT, "25565"), 1)
    check(mc_startscreen.form_validate(&f) == mc_startscreen.ERR_HOST, 2)
    type_text(&f, "192.168.1.20x")
    check(eq(&f, mc_startscreen.FIELD_HOST, "192.168.1.20"), 3)
    check(mc_startscreen.form_validate(&f) == mc_startscreen.ERR_NAME, 4)
    f.active = mc_startscreen.FIELD_NAME
    type_text(&f, "Steve!-_1")
    check(eq(&f, mc_startscreen.FIELD_NAME, "Steve_1"), 5)
    check(mc_startscreen.form_validate(&f) == mc_startscreen.ERR_NONE && mc_startscreen.form_port(&f) == 25565, 6)
    var o: mc_startscreen.StartForm = mc_startscreen.form_new()
    o.active = mc_startscreen.FIELD_NAME
    type_text(&o, "123456789012345678")
    check(mc_startscreen.form_text_len(&o, mc_startscreen.FIELD_NAME) == 16, 7)

    var g: mc_startscreen.StartForm = mc_startscreen.form_new()
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_HOST, "300.1.1.1".p as u64, 9)
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_NAME, "A".p as u64, 1)
    check(mc_startscreen.form_validate(&g) == mc_startscreen.ERR_HOST, 8)
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_HOST, "1.2.3".p as u64, 5)
    check(mc_startscreen.form_validate(&g) == mc_startscreen.ERR_HOST, 9)
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_HOST, "1.2.3.4".p as u64, 7)
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_PORT, "70000".p as u64, 5)
    check(mc_startscreen.form_validate(&g) == mc_startscreen.ERR_PORT, 10)
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_PORT, "".p as u64, 0)
    check(mc_startscreen.form_validate(&g) == mc_startscreen.ERR_PORT, 11)
    mc_startscreen.form_set(&g, mc_startscreen.FIELD_PORT, "25599".p as u64, 5)
    check(mc_startscreen.form_validate(&g) == mc_startscreen.ERR_NONE, 12)

    var cfg: mc_launch_cfg.LaunchCfg = mc_launch_cfg.cfg_new()
    mc_startscreen.form_to_cfg(&f, &cfg)
    check(mc_launch_cfg.cfg_complete(&cfg) && cfg.port == 25565, 13)
    var text: rt.Buf = rt.buf_new()
    mc_launch_cfg.cfg_text(&cfg, &text)
    let want: str = "host=192.168.1.20\nport=25565\nname=Steve_1\n"
    check(rt.buf_len(&text) == want.n, 14)
    var i: usize = 0
    while i < want.n {
        check(rt.ld8(rt.buf_ptr(&text), i) == want.chars(i), 15)
        i = i + 1
    }

    var path: str = "/tmp/mc_startscreen_test_4991/sub/mcplay.cfg"
    check(mc_launch_cfg.cfg_save(path, &cfg), 16)
    var back: mc_launch_cfg.LaunchCfg = mc_launch_cfg.cfg_new()
    check(mc_launch_cfg.cfg_load(path, &back), 17)
    check(mc_launch_cfg.cfg_complete(&back) && back.port == 25565 && rt.buf_len(&back.host) == 12 && rt.buf_len(&back.name) == 7, 18)
    var h: mc_startscreen.StartForm = mc_startscreen.form_new()
    mc_startscreen.form_from_cfg(&h, &back)
    check(eq(&h, mc_startscreen.FIELD_HOST, "192.168.1.20") && eq(&h, mc_startscreen.FIELD_NAME, "Steve_1") && h.active == mc_startscreen.FIELD_NAME, 19)
    var none: mc_launch_cfg.LaunchCfg = mc_launch_cfg.cfg_new()
    check(!mc_launch_cfg.cfg_load("/tmp/mc_startscreen_test_4991/missing.cfg", &none) && !mc_launch_cfg.cfg_complete(&none), 20)

    var r: mc_raster.Raster = mc_raster.raster_new(640, 480)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_startscreen.form_draw(&f, &r, 2, 0 as u64)
    check(mc_raster.raster_pixel(&r, 3, 3) == mc_startscreen.BG_COLOR, 21)
    var lit: i32 = 0
    var y: i32 = 0
    while y < 480 {
        var x: i32 = 0
        while x < 640 {
            if mc_raster.raster_pixel(&r, x, y) == mc_startscreen.BOX_ACTIVE { lit = lit + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check(lit > 300, 23)
    return 0
}
