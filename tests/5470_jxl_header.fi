import jxl.jxl
import std.fs
import std.rt

static mut failures: i32 = 0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn info_of(path: str, i: *mut jxl.JxlInfo) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    if n == 0 {
        return false
    }
    let ok: bool = jxl.jxl_info(rt.buf_ptr(&data), n, i) catch false
    rt.buf_free(&data)
    return ok
}

fn expect(path: str, w: u32, h: u32, cc: u32, alpha: bool) {
    var i: jxl.JxlInfo = jxl.JxlInfo { width: 0, height: 0, color_channels: 0, extra_channels: 0, has_alpha: false,
        bits: 0, is_float: false, xyb: false, want_icc: false, animated: false, orientation: 0, boxed: false }
    if !info_of(path, &i) {
        failures = failures + 1
        return
    }
    check(i.width == w)
    check(i.height == h)
    check(i.color_channels == cc)
    check(i.has_alpha == alpha)
    check(i.bits == 8)
    check(!i.xyb)
    check(!i.is_float)
}

fn sweep(path: str) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    check(n > 0)
    var cut: usize = 0
    var rejected: i32 = 0
    while cut < 4 && cut < n {
        var i: jxl.JxlInfo = jxl.JxlInfo { width: 0, height: 0, color_channels: 0, extra_channels: 0, has_alpha: false,
            bits: 0, is_float: false, xyb: false, want_icc: false, animated: false, orientation: 0, boxed: false }
        let ok: bool = jxl.jxl_info(rt.buf_ptr(&data), cut, &i) catch false
        if !ok {
            rejected = rejected + 1
        }
        cut = cut + 1
    }
    check(rejected >= 3)
    var junk: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < 16 {
        rt.buf_push(&junk, 7 as u8)
        k = k + 1
    }
    var ji: jxl.JxlInfo = jxl.JxlInfo { width: 0, height: 0, color_channels: 0, extra_channels: 0, has_alpha: false,
        bits: 0, is_float: false, xyb: false, want_icc: false, animated: false, orientation: 0, boxed: false }
    let jok: bool = jxl.jxl_info(rt.buf_ptr(&junk), 16, &ji) catch false
    check(!jok)
    rt.buf_free(&junk)
    rt.buf_free(&data)
}

fn main() -> i32 {
    sweep("tests/data/jxl/rgb300x200.jxl")
    expect("tests/data/jxl/rgb16x16.jxl", 16, 16, 3, false)
    expect("tests/data/jxl/rgb37x23.jxl", 37, 23, 3, false)
    expect("tests/data/jxl/grey20x20.jxl", 20, 20, 1, false)
    expect("tests/data/jxl/rgba17x9.jxl", 17, 9, 3, true)
    expect("tests/data/jxl/rgb300x200.jxl", 300, 200, 3, false)
    expect("tests/data/jxl/greya24x24.jxl", 24, 24, 1, true)
    expect("tests/data/jxl/rgb1x1.jxl", 1, 1, 3, false)
    expect("tests/data/jxl/rgb513x7.jxl", 513, 7, 3, false)
    expect("tests/data/jxl/rgb300x20.jxl", 300, 20, 3, false)
    return failures
}
