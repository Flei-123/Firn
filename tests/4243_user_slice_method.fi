// expect_exit: 65
// r741: a user method called `slice` wins over the slice sugar `v[a:b]` (own struct and
// a function `Vec__i64__slice`); another Vec type keeps the sugar (a view of 2 elements).
import std.vec

struct Box { n: i64 }
impl Box {
    fn slice(*self, a: i64, b: i64) -> i64 {
        return (*self).n + a + b
    }
}

fn Vec__i64__slice(self: *Vec[i64], a: i64, b: i64) -> i64 {
    return a * 10 + b
}

fn main() -> i32 {
    var b: Box = Box { n: 1 }
    var v: Vec[i64] = vec_new[i64]()
    vec_push[i64](&v, 5)
    var w: Vec[u8] = vec_new[u8]()
    vec_push[u8](&w, 1 as u8)
    vec_push[u8](&w, 2 as u8)
    vec_push[u8](&w, 3 as u8)
    let view: Vec[u8] = w[1:3]
    let x: i64 = b.slice(2, 3)
    let y: i64 = v[1:2]
    let z: i64 = b[2:3]
    let a: i64 = v.slice(3, 4)
    // 6 + 12 + 6 + 34 + len(view)=2 + view[0]=2 + view[1]=3
    return (x + y + z + a + vec_len[u8](&view) as i64 + (view[0] as i64) + (view[1] as i64)) as i32
}
