// expect_exit: 0
// tests/1187_layout_reflow.fi -- THE SPLIT: what a second layout may keep
// and what it has to throw away.
//
// A browser lays the same tree out again and again -- the window is
// resized, a script changes a style. The engine of this round separates
// the two halves of a layout:
//
//   VIEWPORT-INDEPENDENT   the box tree, the style on every box, and the
//                          intrinsic contribution `int_min`/`int_max`
//                          of each box. Style and text alone decide it,
//                          percentages count as zero (css-sizing-3), so
//                          no window width can change it. It is computed
//                          ONCE and read out of the box afterwards.
//   VIEWPORT-DEPENDENT     every used value: positions, sizes, the four
//                          rings, line boxes, fragments, collapsed
//                          margins. `flow.relayout_document` throws all
//                          of it away and computes it again.
//
// The test is the one that matters: laying out at 800, then at 400, then
// at 800 again has to give EXACTLY the tree a first layout at 800 gives.
// A single used value that survives the reset shows up here as a
// difference, and the layout at 400 in between proves that the second
// pass really did something.
//
// A second, independently built tree is laid out at 800 as well, and the
// two checksums are held against each other -- so the test cannot be
// satisfied by an engine that simply does nothing on the second call.
//
// The return value names the first check that fails.
import html.mem
import browser.node
import browser.names
import browser.driver
import css.tok
import css.cv
import css.sel
import css.cascade
import layout.box
import layout.build
import layout.flow

const SOURCE_LEN: usize = 226
const SHEET_LEN: usize = 246

#[no_gc]
fn source(out: *mut mem.Buf) {
    var t: [u8; 226] = "<!DOCTYPE html><html><head></head><body><div id=\"a\">one two three four five six seven<span id=\"b\">tail</span></div><div id=\"c\"><div id=\"d\"></div><div id=\"e\">text</div></div><div id=\"f\"><div id=\"g\">abc</div></div></body></html>"
    mem.buf_clear(out)
    var i: usize = 0
    while i < SOURCE_LEN {
        mem.buf_push(out, t[i])
        i = i + 1
    }
}

#[no_gc]
fn sheet(out: *mut mem.CpBuf) {
    var t: [u8; 246] = "html,body,div,span{display:block;margin:0;padding:0;border:0}span{display:inline}html{font-size:20px}#a{padding:5px;border:2px solid black}#c{display:flex;height:60px}#d{width:30%;background:red}#e{flex:1}#f{height:100px}#g{height:50%;float:left}"
    mem.cp_clear(out)
    var i: usize = 0
    while i < SHEET_LEN {
        mem.cp_push(out, t[i] as u32)
        i = i + 1
    }
}

fn next_in_order(k: Gc[Node], root: Gc[Node]) -> Gc[Node] {
    if k.first_child != gc_null[Node]() {
        return k.first_child
    }
    var c: Gc[Node] = k
    while c != gc_null[Node]() && c != root {
        if c.next != gc_null[Node]() {
            return c.next
        }
        c = c.parent
    }
    return gc_null[Node]()
}

// The n-th elem in document order -- the same order the driver and a
// browser walk in, so an index here means the same thing everywhere.
fn elem_at(doc: Gc[Node], want: u64) -> Gc[Node] {
    var k: Gc[Node] = doc
    var i: u64 = 0
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            if i == want {
                return k
            }
            i = i + 1
        }
        k = next_in_order(k, doc)
    }
    return gc_null[Node]()
}

fn find_box(b: Gc[Box], k: Gc[Node]) -> Gc[Box] {
    if b.elem == k {
        return b
    }
    var i: u64 = 0
    while i < box.box_kids(b) {
        let r: Gc[Box] = find_box(box.box_kid(b, i), k)
        if r != gc_null[Box]() {
            return r
        }
        i = i + 1
    }
    return gc_null[Box]()
}

// Equal to a thousandth of a pixel. The engine computes in a grid of
// 1/64 px, so anything below that cannot be a difference of the algorithm.
fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d < 0.001
}

fn check(root: Gc[Box], doc: Gc[Node], index: u64, x: f64, y: f64,
    w: f64, h: f64) -> bool {
    let k: Gc[Node] = elem_at(doc, index)
    if k == gc_null[Node]() {
        return false
    }
    let b: Gc[Box] = find_box(root, k)
    if b == gc_null[Box]() {
        return false
    }
    return near(b.x, x) && near(b.y, y) && near(b.w, w) && near(b.h, h)
}

// A number that stands for the whole geometry of the tree. The four
// members are weighted with different primes so that two boxes cannot
// swap their positions without the sum noticing.
fn tree_sum(b: Gc[Box]) -> f64 {
    var v: f64 = b.x + b.y * 3.0 + b.w * 5.0 + b.h * 7.0 +
    b.ml * 11.0 + b.mt * 13.0 + b.baseline * 17.0
    var i: u64 = 0
    let n: u64 = box.box_kids(b)
    while i < n {
        v = v + tree_sum(box.box_kid(b, i))
        i = i + 1
    }
    return v
}

// Has every box that was asked for its intrinsic width kept the answer?
fn cache_filled(b: Gc[Box]) -> u64 {
    var c: u64 = 0
    if b.int_ok == 1 as u32 {
        c = 1
    }
    var i: u64 = 0
    let n: u64 = box.box_kids(b)
    while i < n {
        c = c + cache_filled(box.box_kid(b, i))
        i = i + 1
    }
    return c
}

fn box_count(b: Gc[Box]) -> u64 {
    var c: u64 = 1
    var i: u64 = 0
    let n: u64 = box.box_kids(b)
    while i < n {
        c = c + box_count(box.box_kid(b, i))
        i = i + 1
    }
    return c
}

fn lay_out_at(l: *mut driver.Run, src: *mut mem.Buf, css: *mut mem.CpBuf,
    t: *mut tok.Tokens, tmp: *mut mem.CpBuf, cx: *mut sel.Ctx,
    w: *mut cascade.Winner, vw: f64, vh: f64) -> AllocError!Gc[Box] {
    driver.run_text_out_bytes(l, mem.buf_ptr(src), mem.buf_len(src))
    let rc: u32 = driver.run_document_build(l)
    if rc != 0 as u32 {
        return gc_null[Box]()
    }
    let doc: Gc[Document] = driver.run_document(l)
    let nm: *mut names.Names = driver.run_names(l)
    tok.tokenize(t, css)
    var p: cv.Parser = cv.parser_new(t)
    let sheet_tree = try cv.parse_stylesheet(&p)
    var order: u32 = 0
    let rules = try cascade.collect_rules(sheet_tree, cascade.ORIGIN_AUTHOR, 0,
        nm, tmp, &order)
    let styles = try gcmap_new(true, true)
    let root_style = try cascade.style_root()
    var k: Gc[Node] = doc
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            var parent_style: Gc[Style] = root_style
            let parent: Gc[Node] = k.parent
            if parent != gc_null[Node]() && parent.kind == node.K_ELEM {
                let found: Gc[Style] = gcmap_get_value[Style](styles,
                    parent as u64)
                if found != gc_null[Style]() {
                    parent_style = found
                }
            }
            let s = try cascade.cascade_elem(rules, k, parent_style, cx, w)
            let ok: bool = try gcmap_set_value[Style](styles, k as u64, s)
        }
        k = next_in_order(k, doc)
    }
    let root = try build.build_document(doc, styles, root_style, nm)
    if root == gc_null[Box]() {
        return gc_null[Box]()
    }
    let okl: bool = try flow.layout_document(root, vw, vh)
    return root
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    var src: mem.Buf = mem.buf_new()
    mem.buf_init(&src)
    source(&src)
    var css: mem.CpBuf = mem.cp_new()
    mem.cp_init(&css)
    sheet(&css)
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var tmp: mem.CpBuf = mem.cp_new()
    var l1: driver.Run = driver.run_new()
    if !driver.run_init(&l1) {
        return 91
    }
    var cx: sel.Ctx = sel.ctx_new(driver.run_names(&l1))
    sel.ctx_init(&cx)
    var w: cascade.Winner = cascade.winner_new()

    let root: Gc[Box] = lay_out_at(&l1, &src, &css, &t, &tmp, &cx, &w,
        800.0, 600.0) catch gc_null[Box]()
    if root == gc_null[Box]() {
        return 92
    }
    let first: f64 = tree_sum(root)
    let boxes: u64 = box_count(root)
    if boxes < 8 {
        return 1
    }
    // The intrinsic cache has to be filled -- a flex container asks for
    // it, and this document has one.
    if cache_filled(root) == 0 {
        return 2
    }

    // ---- the window gets narrower
    let ok4: bool = flow.relayout_document(root, 400.0, 600.0) catch false
    if !ok4 {
        return 3
    }
    let narrow: f64 = tree_sum(root)
    if near(narrow, first) {
        // Nothing moved at 400 px -- then the second pass did not run,
        // and the check below would prove nothing.
        return 4
    }

    // ---- and back
    let ok8: bool = flow.relayout_document(root, 800.0, 600.0) catch false
    if !ok8 {
        return 5
    }
    let again: f64 = tree_sum(root)
    if !near(again, first) {
        return 6
    }
    if box_count(root) != boxes {
        return 7
    }

    // ---- a SECOND tree, built from scratch, laid out once at 800
    var l2: driver.Run = driver.run_new()
    if !driver.run_init(&l2) {
        return 93
    }
    var cx2: sel.Ctx = sel.ctx_new(driver.run_names(&l2))
    sel.ctx_init(&cx2)
    let fresh: Gc[Box] = lay_out_at(&l2, &src, &css, &t, &tmp, &cx2, &w,
        800.0, 600.0) catch gc_null[Box]()
    if fresh == gc_null[Box]() {
        return 94
    }
    if !near(tree_sum(fresh), first) {
        return 8
    }
    if box_count(fresh) != boxes {
        return 9
    }
    return 0
}
