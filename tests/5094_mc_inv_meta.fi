// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_inv

// component type ids per version: enchantments, use_remainder (-1 = none), enchantments carry a showTooltip bool
fn ench_id(p: i32) -> i32 {
    if p == 767 { return 9 }
    if p == 769 { return 10 }
    if p == 772 { return 10 }
    return 13
}
fn rem_id(p: i32) -> i32 {
    if p == 767 { return 0 - 1 }
    if p == 769 { return 23 }
    if p == 772 { return 22 }
    return 25
}
fn has_tooltip(p: i32) -> bool { return p <= 769 }

fn put_window(b: *mut bytes.Bytes, p: i32, w: i32) {
    if p == 767 { bytes.put_u8(b, w as u8) } else { bytes.put_varint(b, w) }
}

// an item stack with components: damage, enchantments, custom_data (empty compound), [use_remainder = 5 x item 9], one removed component
fn put_full(b: *mut bytes.Bytes, p: i32, item: i32, count: i32) {
    put_full_e(b, p, item, count, 5, 3)
}

fn put_full_e(b: *mut bytes.Bytes, p: i32, item: i32, count: i32, eid: i32, lvl: i32) {
    bytes.put_varint(b, count)
    bytes.put_varint(b, item)
    var added: i32 = 3
    if rem_id(p) >= 0 { added = 4 }
    bytes.put_varint(b, added)
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 3) // damage
    bytes.put_varint(b, 11)
    bytes.put_varint(b, ench_id(p))
    bytes.put_varint(b, 2)
    bytes.put_varint(b, eid)
    bytes.put_varint(b, lvl)
    bytes.put_varint(b, 1)
    bytes.put_varint(b, 2)
    if has_tooltip(p) { bytes.put_bool(b, true) }
    bytes.put_varint(b, 0) // custom_data: nameless compound {}
    bytes.put_u8(b, 10 as u8)
    bytes.put_u8(b, 0 as u8)
    if rem_id(p) >= 0 {
        bytes.put_varint(b, rem_id(p))
        bytes.put_varint(b, 5) // nested Slot
        bytes.put_varint(b, 9)
        bytes.put_varint(b, 0)
        bytes.put_varint(b, 0)
    }
    bytes.put_varint(b, 2) // removed: max_damage
}

fn put_plain(b: *mut bytes.Bytes, item: i32, count: i32) {
    bytes.put_varint(b, count)
    bytes.put_varint(b, item)
    bytes.put_varint(b, 0)
    bytes.put_varint(b, 0)
}

fn has_line(p: u64, n: usize, lit: str) -> bool {
    var i: usize = 0
    while i + lit.n <= n {
        if rt.mem_eq(p + (i as u64), lit.p as u64, lit.n) { return true }
        i = i + 1
    }
    return false
}

fn put_name(b: *mut bytes.Bytes, s: str) {
    bytes.put_u16(b, s.n as u16)
    bytes.put_raw(b, s.p as u64, s.n)
}

fn put_entry_str(b: *mut bytes.Bytes, k: str, v: str) {
    bytes.put_u8(b, 8 as u8)
    put_name(b, k)
    put_name(b, v)
}

fn put_meta_nbt(b: *mut bytes.Bytes, named_root: bool, lvl: i32) {
    bytes.put_u8(b, 10 as u8)
    if named_root { put_name(b, "") }
    bytes.put_u8(b, 10 as u8)
    put_name(b, "display")
    put_entry_str(b, "Name", "{\"text\":\"Blade\"}")
    bytes.put_u8(b, 0 as u8)
    bytes.put_u8(b, 9 as u8)
    put_name(b, "Enchantments")
    bytes.put_u8(b, 10 as u8)
    bytes.put_u32(b, 1 as u32)
    put_entry_str(b, "id", "minecraft:sharpness")
    bytes.put_u8(b, 2 as u8)
    put_name(b, "lvl")
    bytes.put_u16(b, lvl as u16)
    bytes.put_u8(b, 0 as u8)
    bytes.put_u8(b, 3 as u8)
    put_name(b, "Damage")
    bytes.put_u32(b, 7 as u32)
    bytes.put_u8(b, 0 as u8)
}

fn nbt_check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&b, 0 as u8)
    if p >= 756 { bytes.put_varint(&b, 3) }
    if p >= 756 { bytes.put_varint(&b, 46) } else { bytes.put_i16(&b, 46 as i16) }
    var i: i32 = 0
    while i < 46 {
        if i == 36 || i == 38 {
            bytes.put_bool(&b, true)
            bytes.put_varint(&b, 5)
            bytes.put_i8(&b, 1 as i8)
            var lv: i32 = 5
            if i == 38 { lv = 2 }
            put_meta_nbt(&b, p < 764, lv)
        } else if i == 37 {
            bytes.put_bool(&b, true)
            bytes.put_varint(&b, 6)
            bytes.put_i8(&b, 2 as i8)
            bytes.put_u8(&b, 0 as u8)
        } else {
            bytes.put_bool(&b, false)
        }
        i = i + 1
    }
    if p >= 756 { bytes.put_bool(&b, false) }
    bytes.bytes_set_pos(&b, 0)
    if !mc_inv.inv_on_window_items_v(&v, &ver, &b) { return 101 }
    var mp: u64 = 0
    var mn: usize = 0
    if !mc_inv.inv_slot_meta(&v, 36, &mp, &mn) { return 102 }
    if !has_line(mp, mn, "n{\"text\":\"Blade\"}") { return 103 }
    if !has_line(mp, mn, "eminecraft:sharpness\t5") { return 104 }
    if !has_line(mp, mn, "d7") { return 105 }
    if mc_inv.inv_sig(&v, 36) == 0 || mc_inv.inv_sig(&v, 36) == mc_inv.inv_sig(&v, 38) { return 106 }
    if !mc_inv.inv_slot_meta(&v, 38, &mp, &mn) || !has_line(mp, mn, "eminecraft:sharpness\t2") { return 107 }
    if mc_inv.inv_slot_meta(&v, 37, &mp, &mn) { return 108 }
    mc_inv.inv_free(&v)
    return 0
}

fn comp_check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 200 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    var b: bytes.Bytes = bytes.bytes_new()
    put_window(&b, p, 0)
    bytes.put_varint(&b, 5)
    bytes.put_varint(&b, 46)
    var i: i32 = 0
    while i < 46 {
        if i == 36 { put_full(&b, p, 794, 1) } else if i == 37 { put_plain(&b, 3, 4) } else { bytes.put_varint(&b, 0) }
        i = i + 1
    }
    put_full(&b, p, 4, 3)
    bytes.bytes_set_pos(&b, 0)
    if !mc_inv.inv_on_window_items_v(&v, &ver, &b) { return 201 }
    var mp: u64 = 0
    var mn: usize = 0
    if !mc_inv.inv_slot_meta(&v, 36, &mp, &mn) { return 202 }
    if !has_line(mp, mn, "d11") { return 203 }
    if !has_line(mp, mn, "E5\t3") { return 204 }
    if !has_line(mp, mn, "E1\t2") { return 205 }
    if mc_inv.inv_slot_meta(&v, 37, &mp, &mn) { return 206 }
    if !mc_inv.inv_cursor_meta(&v, &mp, &mn) || !has_line(mp, mn, "E5\t3") { return 207 }
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    var r: i32 = nbt_check(763)
    if r != 0 { return 1000 + r }
    r = nbt_check(758)
    if r != 0 { return 2000 + r }
    r = nbt_check(764)
    if r != 0 { return 4000 + r }
    r = comp_check(767)
    if r != 0 { return 5000 + r }
    r = comp_check(769)
    if r != 0 { return 6000 + r }
    r = comp_check(772)
    if r != 0 { return 7000 + r }
    r = comp_check(774)
    if r != 0 { return 8000 + r }
    r = comp_check(775)
    if r != 0 { return 9000 + r }
    return 0
}
