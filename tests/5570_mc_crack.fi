// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_raster
import mc.mc_hud
import mc.mc_gui_tex
import mc.mc_camera
import mc.mc_crack
import mc.mc_crack_anim

fn stage_tex(opaque_gray: u32, hole_x: i32) -> mc_gui_tex.GuiTex {
    var t: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    mc_gui_tex.gtex_blank(&t, 16, 16)
    var y: i32 = 0
    while y < 16 {
        var x: i32 = 0
        while x < 16 {
            var c: u32 = 0x01FFFFFF as u32
            if x != hole_x { c = 0xFF000000 as u32 | (opaque_gray << 16 as u32) | (opaque_gray << 8 as u32) | opaque_gray }
            mc_gui_tex.gtex_set(&t, x, y, c)
            x = x + 1
        }
        y = y + 1
    }
    return t
}

fn build_tex(t: *mut mc_crack.CrackTex, gray: u32) -> bool {
    var st: [mc_gui_tex.GuiTex; 10] = [mc_gui_tex.gtex_empty(); 10]
    var i: usize = 0
    while i < 10 {
        st[i] = stage_tex(gray, 0 - 1)
        i = i + 1
    }
    let ok: bool = mc_crack.crack_tex_from_stages(t, &st)
    i = 0
    while i < 10 {
        mc_gui_tex.gtex_free(&st[i])
        i = i + 1
    }
    return ok
}

fn record_count(rec: *mut rt.Buf) -> usize {
    return rt.buf_len(rec) / 24
}

fn rect_word(rec: *mut rt.Buf, i: usize, k: usize) -> u32 {
    return rt.ld32(rt.buf_ptr(rec), i * 6 + k)
}

fn packet(eid: i32, x: i32, y: i32, z: i32, stage: i32) -> bytes.Bytes {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, eid)
    bytes.put_position(&b, x, y, z)
    bytes.put_i8(&b, stage as i8)
    return b
}

#[allow_escape]
fn main() -> i32 {
    if mc_crack.crack_stage(0 as u64, 1000 as u64) != 0 { return 1 }
    if mc_crack.crack_stage(500 as u64, 1000 as u64) != 5 { return 2 }
    if mc_crack.crack_stage(999 as u64, 1000 as u64) != 9 { return 3 }
    if mc_crack.crack_stage(5000 as u64, 1000 as u64) != 9 { return 4 }
    if mc_crack.crack_stage(10 as u64, 0 as u64) != 0 - 1 { return 5 }
    if mc_crack.crack_color(0x01FFFFFF as u32) != 0 as u32 { return 6 }
    if mc_crack.crack_color(0xFF3D3D3D as u32) != 0x85000000 as u32 { return 7 }
    if mc_crack.crack_color(0xFF9B9B9B as u32) != 0x1BFFFFFF as u32 { return 8 }
    if mc_crack.crack_color(0xFF808080 as u32) != 0 as u32 && (mc_crack.crack_color(0xFF808080 as u32) >> 24 as u32) > 1 as u32 { return 9 }

    var t: mc_crack.CrackTex = mc_crack.crack_tex_new()
    if mc_crack.crack_tex_ok(&t) { return 10 }
    if !build_tex(&t, 61 as u32) { return 11 }
    if !mc_crack.crack_tex_ok(&t) { return 12 }

    var cam: mc_camera.Camera = mc_camera.camera_new(160, 90)
    mc_camera.camera_set_pos(&cam, 0.5, 0.5, 0.0 - 3.0)
    mc_camera.camera_set_angles(&cam, 0.0, 0.0)
    mc_camera.camera_update(&cam)
    var box: mc_crack.CrackBox = mc_crack.CrackBox { x0: 0.0, y0: 0.0, z0: 0.0, x1: 1.0, y1: 1.0, z1: 1.0 }
    var r: mc_raster.Raster = mc_raster.raster_new(160, 90)

    var rec: rt.Buf = rt.buf_new()
    mc_hud.hud_record(&rec)
    mc_crack.crack_draw(&r, &cam, &t, 0 - 1, &box, mc_crack.CRACK_ALL_FACES)
    if record_count(&rec) != 0 { return 20 }
    mc_crack.crack_draw(&r, &cam, &t, 10, &box, mc_crack.CRACK_ALL_FACES)
    if record_count(&rec) != 0 { return 21 }
    mc_crack.crack_draw(&r, &cam, &t, 4, &box, 1 as u32)
    if record_count(&rec) != 0 { return 22 }
    mc_crack.crack_draw(&r, &cam, &t, 4, &box, mc_crack.CRACK_ALL_FACES)
    let n_front: usize = record_count(&rec)
    if n_front == 0 { return 23 }
    var covered: i64 = 0
    var i: usize = 0
    while i < n_front {
        let x0: u32 = rect_word(&rec, i, 0)
        let y0: u32 = rect_word(&rec, i, 1)
        let x1: u32 = rect_word(&rec, i, 2)
        let y1: u32 = rect_word(&rec, i, 3)
        if x1 <= x0 || y1 <= y0 || x1 > 160 as u32 || y1 > 90 as u32 { return 24 }
        if rect_word(&rec, i, 4) != 0x85000000 as u32 { return 25 }
        covered = covered + ((x1 - x0) as i64) * ((y1 - y0) as i64)
        i = i + 1
    }
    if covered < 380 || covered > 520 { return 26 }

    rt.buf_clear(&rec)
    mc_crack.crack_draw(&r, &cam, &t, 4, &box, 47 as u32)
    if record_count(&rec) != 0 { return 27 }
    mc_crack.crack_draw(&r, &cam, &t, 4, &box, 16 as u32)
    if record_count(&rec) != n_front { return 28 }

    mc_camera.camera_set_pos(&cam, 0.5, 0.5, 4.0)
    mc_camera.camera_set_angles(&cam, 180.0, 0.0)
    mc_camera.camera_update(&cam)
    rt.buf_clear(&rec)
    mc_crack.crack_draw(&r, &cam, &t, 4, &box, 16 as u32)
    if record_count(&rec) != 0 { return 29 }
    mc_crack.crack_draw(&r, &cam, &t, 4, &box, 32 as u32)
    if record_count(&rec) == 0 { return 30 }

    mc_camera.camera_set_pos(&cam, 0.5, 0.5, 0.5)
    mc_camera.camera_update(&cam)
    rt.buf_clear(&rec)
    mc_crack.crack_draw(&r, &cam, &t, 4, &box, mc_crack.CRACK_ALL_FACES)
    if record_count(&rec) != 0 { return 31 }

    mc_hud.hud_record(0 as *mut rt.Buf)
    rt.buf_free(&rec)

    mc_camera.camera_set_pos(&cam, 0.5, 0.5, 0.0 - 3.0)
    mc_camera.camera_set_angles(&cam, 0.0, 0.0)
    mc_camera.camera_update(&cam)
    mc_raster.raster_clear(&r, 0xFF808080 as u32)
    mc_crack.crack_draw(&r, &cam, &t, 9, &box, mc_crack.CRACK_ALL_FACES)
    var dark: i32 = 0
    var untouched: i32 = 0
    var p: usize = 0
    while p < 160 * 90 {
        let c: u32 = rt.ld32(r.color, p)
        if c == 0xFF808080 as u32 { untouched = untouched + 1 }
        if (c & 255 as u32) < 100 as u32 { dark = dark + 1 }
        p = p + 1
    }
    if dark < 380 || untouched < 13800 { return 32 }

    var a: mc_crack_anim.CrackAnims = mc_crack_anim.crack_anims_new()
    var b1: bytes.Bytes = packet(7, 10, 64, 0 - 5, 3)
    if !mc_crack_anim.crack_anims_on_packet(&a, &b1, 1000 as u64) { return 40 }
    if mc_crack_anim.crack_anims_count(&a) != 1 { return 41 }
    var ax: i32 = 0
    var ay: i32 = 0
    var az: i32 = 0
    var ast: i32 = 0
    if !mc_crack_anim.crack_anims_at(&a, 0, &ax, &ay, &az, &ast) { return 42 }
    if ax != 10 || ay != 64 || az != 0 - 5 || ast != 3 { return 43 }
    var b2: bytes.Bytes = packet(7, 10, 64, 0 - 5, 6)
    mc_crack_anim.crack_anims_on_packet(&a, &b2, 1500 as u64)
    if mc_crack_anim.crack_anims_count(&a) != 1 { return 44 }
    mc_crack_anim.crack_anims_at(&a, 0, &ax, &ay, &az, &ast)
    if ast != 6 { return 45 }
    var b3: bytes.Bytes = packet(8, 0 - 1, 70, 2, 0)
    mc_crack_anim.crack_anims_on_packet(&a, &b3, 1600 as u64)
    if mc_crack_anim.crack_anims_count(&a) != 2 { return 46 }
    var b4: bytes.Bytes = packet(7, 10, 64, 0 - 5, 0 - 1)
    mc_crack_anim.crack_anims_on_packet(&a, &b4, 1700 as u64)
    if mc_crack_anim.crack_anims_count(&a) != 1 { return 47 }
    var b5: bytes.Bytes = packet(8, 0 - 1, 70, 2, 10)
    mc_crack_anim.crack_anims_on_packet(&a, &b5, 1800 as u64)
    if mc_crack_anim.crack_anims_count(&a) != 0 { return 48 }
    var b6: bytes.Bytes = packet(8, 0 - 1, 70, 2, 0)
    mc_crack_anim.crack_anims_on_packet(&a, &b6, 2000 as u64)
    mc_crack_anim.crack_anims_expire(&a, 2000 as u64 + mc_crack_anim.CRACK_ANIM_TTL_MS)
    if mc_crack_anim.crack_anims_count(&a) != 1 { return 49 }
    mc_crack_anim.crack_anims_expire(&a, 2001 as u64 + mc_crack_anim.CRACK_ANIM_TTL_MS)
    if mc_crack_anim.crack_anims_count(&a) != 0 { return 50 }
    var bad: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&bad, 5)
    if mc_crack_anim.crack_anims_on_packet(&a, &bad, 1 as u64) { return 51 }
    var k: i32 = 0
    while k < 40 {
        var bk: bytes.Bytes = packet(100 + k, k, 1, 1, 2)
        mc_crack_anim.crack_anims_on_packet(&a, &bk, (3000 + k) as u64)
        bytes.bytes_free(&bk)
        k = k + 1
    }
    if mc_crack_anim.crack_anims_count(&a) != 32 { return 52 }
    mc_crack_anim.crack_anims_clear(&a)
    if mc_crack_anim.crack_anims_count(&a) != 0 { return 53 }

    mc_crack.crack_tex_free(&t)
    mc_raster.raster_free(&r)
    return 0
}
