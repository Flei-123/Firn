// expect_exit: 0
// tests/4051_mc_alpha_gl.fi -- r248 texel-alpha translucency (model quads of a partly transparent texture, no glass / ice name) on the GL back end
// against the CPU raster: the same two-quad scene as tests/4050 (alpha 128 near, alpha 60 far, stacked) is drawn through wr_render_b on both back ends
// (translucent pass = MESH_MODEL_T), per channel the centre pixel must agree (<= 2 levels) and the whole picture must reach PSNR >= 34 dB. The atlas-less
// GL picture of the near quad (cut out) must differ from the blended one. SKIP (exit 0) without a GL context. Vulkan: tests/3993 covers the same pass.
import std.rt
import std.core
import std.math
import std.io
import zip.zip
import pack.packicons
import mc.mc_assets
import mc.mc_texture
import mc.mc_texext
import mc.mc_mesh
import mc.mc_model_mesh
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_world
import mc.mc_camera
import mc.mc_backend
import mc.mc_raster
import mc.mc_render_world
import gpu.gl_mc

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"
const W: i32 = 96
const H: i32 = 72
const CLEAR: u32 = 0xFF40A0C0 as u32 // R 0xC0 G 0xA0 B 0x40 (little endian R | G << 8 | B << 16)
const MIN_Y: i32 = 0 - 64

// 16 x 16 solid colour PNG
fn png_solid(r: u8, g: u8, b: u8, a: u8, out: *mut rt.Buf) -> bool {
    let px: u64 = rt.heap_alloc(16 * 16 * 4)
    var i: usize = 0
    while i < 256 {
        rt.st8(px, i * 4, r)
        rt.st8(px, i * 4 + 1, g)
        rt.st8(px, i * 4 + 2, b)
        rt.st8(px, i * 4 + 3, a)
        i = i + 1
    }
    let ok: bool = packicons.png_encode(px, 16, 16, out)
    rt.heap_free(px, 16 * 16 * 4)
    return ok
}

fn add_text(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    let ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

fn add_png(w: *mut zip.ZipWriter, name: str, r: u8, g: u8, b: u8, a: u8) -> bool {
    var p: rt.Buf = rt.buf_new()
    if !png_solid(r, g, b, a, &p) { return false }
    let ok: bool = zip.zip_add(w, name, rt.buf_ptr(&p), rt.buf_len(&p), true) catch | e | (false)
    rt.buf_free(&p)
    return ok
}

// blockstate of a block without properties: one model for every state
fn add_state(w: *mut zip.ZipWriter, block: str, model: str) -> bool {
    return add_text(w, "assets/minecraft/blockstates/" + block + ".json", "{\"variants\":{\"\":{\"model\":\"" + model + "\"}}}")
}

// a model with ONE down face covering the whole bottom of the cell (not a unit cube, so the state is a model), texture `tex`
fn add_down_model(w: *mut zip.ZipWriter, name: str, tex: str) -> bool {
    return add_text(w, "assets/minecraft/models/block/" + name + ".json",
        "{\"textures\":{\"t\":\"block/" + tex + "\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"down\":{\"uv\":[0,0,16,16],\"texture\":\"#t\"}}}]}")
}

fn open_pack(b: *mut rt.Buf, w: *mut zip.ZipWriter, st: *mut mc_assets.PackStack) -> bool {
    let n: usize = zip.zip_finish(w) catch | e | (0)
    zip.zip_writer_free(w)
    if n == 0 { return false }
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&pk, rt.buf_ptr(b), rt.buf_len(b)) != mc_assets.ASSET_OK { return false }
    rt.buf_free(b)
    return mc_assets.stack_push(st, &pk) == mc_assets.ASSET_OK
}

fn sid(reg: *mut mc_registry.Registry, name: str) -> i32 {
    let blk: i32 = mc_registry.reg_block_by_name(reg, name.p as u64, name.length())
    if blk < 0 { return 0 - 1 }
    return mc_registry.reg_block_min_state(reg, blk)
}

// cell (x, y, z) of section 0 (a 16 x 16 x 16 u16 array per section, 2 sections)
fn put(ids: u64, x: i32, y: i32, z: i32, state: i32) {
    rt.st16(ids, ((y * 16 + z) * 16 + x) as usize, state as u16)
}

fn new_ids() -> u64 {
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return ids
}

fn chan(c: u32, k: i32) -> i32 {
    return ((c >> ((k * 8) as u32)) & (255 as u32)) as i32
}

fn iabs(v: i32) -> i32 {
    if v < 0 { return 0 - v }
    return v
}

// everything a scene needs, rebuilt per scene
struct Scene {
    tb: mc_mesh.MeshTables,
    ex: mc_texext.TexExt,
    atlas: mc_texture.Atlas,
    an: mc_assets.AnimSet,
}

fn scene_init(sc: *mut Scene, reg: *mut mc_registry.Registry, st: *mut mc_assets.PackStack) -> bool {
    (*sc).tb = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&(*sc).tb)
    (*sc).ex = mc_texext.texext_new()
    mc_texext.tex_build_tables_ext(reg, &(*sc).tb, &(*sc).ex)
    (*sc).atlas = mc_texext.texext_atlas_new(16, &(*sc).ex)
    (*sc).an = mc_assets.animset_new()
    return mc_assets.assets_apply_ext(st, &(*sc).atlas, &(*sc).ex, &(*sc).an) >= 1
}

// look from (ex, ey, ez) at (tx, ty, tz), render and return the centre pixel
fn shot(r: *mut mc_raster.Raster, wr: *mut mc_render_world.WorldRender, w: *mut mc_world.World, cam: *mut mc_camera.Camera,
    ex: f64, ey: f64, ez: f64, tx: f64, ty: f64, tz: f64) -> u32 {
    mc_camera.camera_set_pos(cam, ex, ey, ez)
    mc_camera.camera_look_at(cam, tx, ty, tz)
    mc_camera.camera_update(cam)
    mc_raster.backend_begin(r, cam, CLEAR)
    mc_render_world.wr_render(wr, w, r, cam, 0 - 1)
    return mc_raster.raster_pixel(r, W / 2, H / 2)
}

fn build(st: *mut mc_assets.PackStack) -> bool {
    var b: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&b)
    if !add_text(&w, "pack.mcmeta", META) { return false }
    if !add_png(&w, "assets/minecraft/textures/block/dirt.png", 230 as u8, 40 as u8, 40 as u8, 60 as u8) { return false } // far: red, alpha 60
    if !add_png(&w, "assets/minecraft/textures/block/stone.png", 40 as u8, 60 as u8, 240 as u8, 128 as u8) { return false } // near: blue, alpha 128
    if !add_down_model(&w, "tg_far", "dirt") { return false }
    if !add_down_model(&w, "tg_near", "stone") { return false }
    if !add_state(&w, "dirt", "block/tg_far") { return false }
    if !add_state(&w, "stone", "block/tg_near") { return false }
    return open_pack(&b, &w, st)
}

// src-alpha blend of the raster, per channel
fn bl(c: i32, dst: i32, a: i32) -> i32 {
    return (c * a + dst * (255 - a) + 127) / 255
}

fn blend(src: u32, dst: u32, a: i32) -> u32 {
    let r: i32 = bl(chan(src, 0), chan(dst, 0), a)
    let g: i32 = bl(chan(src, 1), chan(dst, 1), a)
    let b: i32 = bl(chan(src, 2), chan(dst, 2), a)
    return (r as u32) | ((g as u32) << 8 as u32) | ((b as u32) << 16 as u32) | (0xFF000000 as u32)
}

fn psnr_of(a: u64, b: u64, n: usize) -> f64 {
    var sq: f64 = 0.0
    var i: usize = 0
    while i < n {
        let pa: u32 = rt.ld32(a, i)
        let pb: u32 = rt.ld32(b, i)
        var k: i32 = 0
        while k < 3 {
            let d: i32 = chan(pa, k) - chan(pb, k)
            sq = sq + (d * d) as f64
            k = k + 1
        }
        i = i + 1
    }
    if sq == 0.0 { return 99.0 }
    return 10.0 * math.log10(255.0 * 255.0 / (sq / ((n as f64) * 3.0)))
}

struct Pair {
    pc: u32, pg: u32, psnr: f64,
}

// One picture on both back ends. `atlas`: ms_set_atlas on or off.
fn scene(reg: *mut mc_registry.Registry, st: *mut mc_assets.PackStack, sc: *mut Scene, gb: *mut gl_mc.GlBackend, near: bool, far: bool, atlas: bool, out: *mut Pair) -> bool {
    let ids: u64 = new_ids()
    if near { put(ids, 8, 8, 8, sid(reg, "stone")) }
    if far { put(ids, 8, 12, 8, sid(reg, "dirt")) }
    var ms: mc_model_mesh.ModelSet = mc_model_mesh.ms_new(reg, st, &(*sc).ex)
    if atlas { mc_model_mesh.ms_set_atlas(&ms, &(*sc).atlas) }
    let msp: *mut mc_model_mesh.ModelSet = &ms
    var wd: mc_world.World = mc_world.world_new()
    if !mc_world.world_put(&wd, mc_render_world.wr_make_chunk(0, 0, 2, ids)) { return false }
    var r: mc_raster.Raster = mc_raster.raster_new(W, H)
    var bc: mc_backend.Backend = mc_backend.backend_cpu(&r)
    var bg: mc_backend.Backend = gl_mc.glbe_backend(gb)
    bc.upload_atlas(bc.obj, (&(*sc).atlas) as u64)
    bg.upload_atlas(bg.obj, (&(*sc).atlas) as u64)
    var cam: mc_camera.Camera = mc_camera.camera_new(W, H)
    mc_camera.camera_set_lens(&cam, 40.0, 0.05, 200.0)
    let base: f64 = (MIN_Y as f64)
    mc_camera.camera_set_pos(&cam, 8.5, base + 4.0, 8.9)
    mc_camera.camera_look_at(&cam, 8.5, base + 12.0, 8.5)
    mc_camera.camera_update(&cam)
    var wrc: mc_render_world.WorldRender = mc_render_world.wr_new(MIN_Y, 8, &(*sc).tb)
    var wrg: mc_render_world.WorldRender = mc_render_world.wr_new(MIN_Y, 8, &(*sc).tb)
    mc_render_world.wr_set_models(&wrc, msp as u64)
    mc_render_world.wr_set_models(&wrg, msp as u64)
    mc_render_world.wr_set_translucent(&wrc, true, mc_texture.T_WATER, mc_texture.T_ICE, mc_texture.T_GLASS)
    mc_render_world.wr_set_translucent(&wrg, true, mc_texture.T_WATER, mc_texture.T_ICE, mc_texture.T_GLASS)
    bc.begin(bc.obj, (&cam) as u64, CLEAR)
    mc_render_world.wr_render_b(&wrc, &wd, &bc, &cam, 0 - 1)
    bc.end(bc.obj)
    bg.begin(bg.obj, (&cam) as u64, CLEAR)
    mc_render_world.wr_render_b(&wrg, &wd, &bg, &cam, 0 - 1)
    bg.end(bg.obj)
    let pc: u64 = bc.present(bc.obj)
    let pg: u64 = bg.present(bg.obj)
    let n: usize = (W as usize) * (H as usize)
    let mid: usize = ((H / 2) * W + W / 2) as usize
    (*out).pc = rt.ld32(pc, mid)
    (*out).pg = rt.ld32(pg, mid)
    (*out).psnr = psnr_of(pc, pg, n)
    mc_render_world.wr_free_b(&wrc, &bc)
    mc_render_world.wr_free_b(&wrg, &bg)
    mc_model_mesh.ms_free(&ms)
    return true
}

fn close(a: u32, b: u32) -> bool {
    var k: i32 = 0
    while k < 3 {
        if iabs(chan(a, k) - chan(b, k)) > 2 { return false }
        k = k + 1
    }
    return true
}

fn main() -> i32 {
    var gb: gl_mc.GlBackend = gl_mc.glbe_open(W, H)
    if !gb.ok {
        io.print("SKIP: no GL context\n")
        return 0
    }
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 1 }
    var reg: mc_registry.Registry = v.registry_of()
    if !mc_registry.registry_ok(&reg) { return 2 }
    var st: mc_assets.PackStack = mc_assets.stack_new()
    if !build(&st) { return 3 }
    var ex0: mc_texext.TexExt = mc_texext.texext_new()
    var sc: Scene = Scene { tb: mc_mesh.MeshTables { opaque: 0, tiles: 0 }, ex: mc_texext.texext_new(), atlas: mc_texext.texext_atlas_new(16, &ex0), an: mc_assets.animset_new() }
    if !scene_init(&sc, &reg, &st) { return 4 }
    var cut: Pair = Pair { pc: 0 as u32, pg: 0 as u32, psnr: 0.0 }
    var bn: Pair = Pair { pc: 0 as u32, pg: 0 as u32, psnr: 0.0 }
    var bf: Pair = Pair { pc: 0 as u32, pg: 0 as u32, psnr: 0.0 }
    var bb: Pair = Pair { pc: 0 as u32, pg: 0 as u32, psnr: 0.0 }
    if !scene(&reg, &st, &sc, &gb, true, false, false, &cut) { return 10 }
    if !scene(&reg, &st, &sc, &gb, true, false, true, &bn) { return 11 }
    if !scene(&reg, &st, &sc, &gb, false, true, true, &bf) { return 12 }
    if !scene(&reg, &st, &sc, &gb, true, true, true, &bb) { return 13 }
    io.fmt_print(f"cut cpu {chan(cut.pc, 0)} {chan(cut.pc, 1)} {chan(cut.pc, 2)} gpu {chan(cut.pg, 0)} {chan(cut.pg, 1)} {chan(cut.pg, 2)}\n")
    io.fmt_print(f"near cpu {chan(bn.pc, 0)} {chan(bn.pc, 1)} {chan(bn.pc, 2)} gpu {chan(bn.pg, 0)} {chan(bn.pg, 1)} {chan(bn.pg, 2)} psnr {bn.psnr}\n")
    io.fmt_print(f"far  cpu {chan(bf.pc, 0)} {chan(bf.pc, 1)} {chan(bf.pc, 2)} gpu {chan(bf.pg, 0)} {chan(bf.pg, 1)} {chan(bf.pg, 2)} psnr {bf.psnr}\n")
    io.fmt_print(f"both cpu {chan(bb.pc, 0)} {chan(bb.pc, 1)} {chan(bb.pc, 2)} gpu {chan(bb.pg, 0)} {chan(bb.pg, 1)} {chan(bb.pg, 2)} psnr {bb.psnr}\n")
    if !close(cut.pc, cut.pg) { return 20 }
    if !close(bn.pc, bn.pg) { return 21 }
    if !close(bf.pc, bf.pg) { return 22 }
    if !close(bb.pc, bb.pg) { return 23 }
    if cut.pg == bn.pg { return 24 } // blended differs from cut out on GL too
    if bn.psnr < 34.0 || bf.psnr < 34.0 || bb.psnr < 34.0 || cut.psnr < 34.0 { return 25 }
    gl_mc.glbe_close(&gb)
    return 0
}
