// expect_exit: 0
// mc_effect: Haste / Mining Fatigue of the own player from Entity Effect / Remove Entity Effect, per protocol layout
// (754: effect id i8; 758+: varint; amplifier i8 up to 1.20.4, varint from 1.20.5; effect ids 3 / 4 up to 1.20.1, 2 / 3 from 1.20.2).
// Return codes: 1xx = join, 2xx = 1.20.1, 3xx = 1.16.5, 4xx = 1.21.x, 5xx = other entity / other effects.
import std.rt
import std.bytes
import mc.mc_effect

fn eff_pkt(b: *mut bytes.Bytes, protocol: i32, eid: i32, id: i32, amp: i32) {
    bytes.put_varint(b, eid)
    if protocol >= 758 { bytes.put_varint(b, id) } else { bytes.put_i8(b, id as i8) }
    if protocol >= 766 { bytes.put_varint(b, amp) } else { bytes.put_i8(b, amp as i8) }
    bytes.put_varint(b, 600)
    if protocol >= 767 { bytes.put_u8(b, 0 as u8) } else { bytes.put_i8(b, 0 as i8) }
    if protocol >= 758 && protocol < 767 { bytes.put_bool(b, false) } // factor codec option (1.19.4 .. 1.20.4)
    bytes.bytes_set_pos(b, 0)
}

fn rm_pkt(b: *mut bytes.Bytes, protocol: i32, eid: i32, id: i32) {
    bytes.put_varint(b, eid)
    if protocol >= 758 { bytes.put_varint(b, id) } else { bytes.put_i8(b, id as i8) }
    bytes.bytes_set_pos(b, 0)
}

fn run(protocol: i32, haste_id: i32, fat_id: i32) -> i32 {
    var f: mc_effect.Fx = mc_effect.fx_new()
    mc_effect.fx_set_own(&f, 7)
    var b: bytes.Bytes = bytes.bytes_new()
    eff_pkt(&b, protocol, 7, haste_id, 2)
    if !mc_effect.fx_on_effect(&f, protocol, &b) { return 1 }
    if mc_effect.fx_haste(&f) != 3 || mc_effect.fx_fatigue(&f) != 0 { return 2 }
    var c: bytes.Bytes = bytes.bytes_new()
    eff_pkt(&c, protocol, 7, fat_id, 4)
    if !mc_effect.fx_on_effect(&f, protocol, &c) { return 3 }
    if mc_effect.fx_haste(&f) != 3 || mc_effect.fx_fatigue(&f) != 5 { return 4 }
    // another entity and an unrelated effect (speed) change nothing
    var o: bytes.Bytes = bytes.bytes_new()
    eff_pkt(&o, protocol, 8, haste_id, 0)
    if mc_effect.fx_on_effect(&f, protocol, &o) { return 5 }
    var sp: bytes.Bytes = bytes.bytes_new()
    eff_pkt(&sp, protocol, 7, 99, 0)
    if mc_effect.fx_on_effect(&f, protocol, &sp) { return 6 }
    if mc_effect.fx_haste(&f) != 3 { return 7 }
    // amplifier 0 = level 1, a later packet replaces the level
    var up: bytes.Bytes = bytes.bytes_new()
    eff_pkt(&up, protocol, 7, haste_id, 0)
    mc_effect.fx_on_effect(&f, protocol, &up)
    if mc_effect.fx_haste(&f) != 1 { return 8 }
    var r: bytes.Bytes = bytes.bytes_new()
    rm_pkt(&r, protocol, 7, haste_id)
    if !mc_effect.fx_on_remove(&f, protocol, &r) { return 9 }
    if mc_effect.fx_haste(&f) != 0 || mc_effect.fx_fatigue(&f) != 5 { return 10 }
    var r2: bytes.Bytes = bytes.bytes_new()
    rm_pkt(&r2, protocol, 9, fat_id) // another entity
    if mc_effect.fx_on_remove(&f, protocol, &r2) { return 11 }
    var r3: bytes.Bytes = bytes.bytes_new()
    rm_pkt(&r3, protocol, 7, fat_id)
    mc_effect.fx_on_remove(&f, protocol, &r3)
    if mc_effect.fx_fatigue(&f) != 0 { return 12 }
    // truncated packet: ignored
    var t: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&t, 7)
    bytes.bytes_set_pos(&t, 0)
    if mc_effect.fx_on_effect(&f, protocol, &t) { return 13 }
    return 0
}

fn main() -> i32 {
    var f: mc_effect.Fx = mc_effect.fx_new()
    var j: bytes.Bytes = bytes.bytes_new()
    bytes.put_i32(&j, 42)
    bytes.put_bool(&j, false)
    bytes.bytes_set_pos(&j, 0)
    if !mc_effect.fx_own_from_join(&f, &j) || f.own != 42 { return 100 }
    if bytes.bytes_pos(&j) != 0 { return 101 }
    if mc_effect.fx_haste_id(763) != 3 || mc_effect.fx_fatigue_id(763) != 4 { return 102 }
    if mc_effect.fx_haste_id(764) != 2 || mc_effect.fx_fatigue_id(775) != 3 { return 103 }
    var rc: i32 = run(763, 3, 4)
    if rc != 0 { return 200 + rc }
    rc = run(754, 3, 4)
    if rc != 0 { return 300 + rc }
    rc = run(758, 3, 4)
    if rc != 0 { return 320 + rc }
    rc = run(764, 2, 3)
    if rc != 0 { return 340 + rc }
    rc = run(767, 2, 3)
    if rc != 0 { return 400 + rc }
    rc = run(769, 2, 3)
    if rc != 0 { return 420 + rc }
    rc = run(775, 2, 3)
    if rc != 0 { return 440 + rc }
    return 0
}
