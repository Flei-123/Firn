// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
// tests/2909_syscall_stat_pipe_rmdir_readlink.fi -- r75: the raw x86-64
// calls stat(4) lstat(6) pipe(22) rmdir(84) readlink(89) give the same
// answers on x86-64 and on aarch64 (where they are rewritten to
// newfstatat / pipe2 / unlinkat(AT_REMOVEDIR) / readlinkat).
import std.rt
import std.fs

static mut fails: u32 = 0

fn check(ok: bool, code: u32) {
    if !ok {
        fails = fails + 1
        var d: [u8; 8] = "FAIL 000"
        d[5] = (48 + (code / 100) % 10) as u8
        d[6] = (48 + (code / 10) % 10) as u8
        d[7] = (48 + code % 10) as u8
        syscall(1, 2, (&d[0]) as i64, 8, 0, 0, 0)
    }
}

fn cs(path: str) -> rt.Buf {
    var c: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < path.length() {
        rt.buf_push(&c, path.chars(i))
        i = i + 1
    }
    rt.buf_push(&c, 0 as u8)
    return c
}

fn main() -> i32 {
    let pid: i64 = syscall(39, 0, 0, 0, 0, 0, 0)
    var bb: rt.Buf = rt.buf_new()
    let pre: str = "/tmp/firn_2909_"
    var k: usize = 0
    while k < pre.length() {
        rt.buf_push(&bb, pre.chars(k))
        k = k + 1
    }
    var pv: i64 = pid
    while pv > 0 {
        rt.buf_push(&bb, (48 + pv % 10) as u8)
        pv = pv / 10
    }
    let base: str = str { p: rt.buf_data(&bb), n: rt.buf_len(&bb) }
    fs.remove_tree(base) catch false
    fs.mkdir(base) catch false
    var stat_buf: [u8; 256] = [0; 256]
    let sb: i64 = (&stat_buf[0]) as i64

    let sf: str = base + "/f"
    let sl: str = base + "/l"
    let sd: str = base + "/dl"
    let ss: str = base + "/sub"
    let sn: str = base + "/nope"
    let data: [u8; 3] = "abc"
    fs.write_file(sf, (&data[0]) as u64, 3) catch 0
    fs.symlink("f", sl) catch false
    fs.symlink("nowhere", sd) catch false
    fs.mkdir(ss) catch false
    var pf: rt.Buf = cs(sf)
    var pl: rt.Buf = cs(sl)
    var pd: rt.Buf = cs(sd)
    var ps: rt.Buf = cs(ss)
    var pn: rt.Buf = cs(sn)

    // stat / lstat
    check(syscall(4, rt.buf_ptr(&pf) as i64, sb, 0, 0, 0, 0) == 0, 1)
    check(syscall(4, rt.buf_ptr(&pn) as i64, sb, 0, 0, 0, 0) == -2, 2)
    check(syscall(4, rt.buf_ptr(&pl) as i64, sb, 0, 0, 0, 0) == 0, 3)
    check(syscall(4, rt.buf_ptr(&pd) as i64, sb, 0, 0, 0, 0) == -2, 4)
    check(syscall(6, rt.buf_ptr(&pd) as i64, sb, 0, 0, 0, 0) == 0, 5)
    check(syscall(6, rt.buf_ptr(&pn) as i64, sb, 0, 0, 0, 0) == -2, 6)

    // readlink
    var lb: [u8; 64] = [0; 64]
    let n: i64 = syscall(89, rt.buf_ptr(&pl) as i64, (&lb[0]) as i64, 64, 0, 0, 0)
    check(n == 1, 7)
    check(lb[0] == 102 as u8, 8)
    check(syscall(89, rt.buf_ptr(&pf) as i64, (&lb[0]) as i64, 64, 0, 0, 0) == -22, 9)
    let n2: i64 = syscall(89, rt.buf_ptr(&pd) as i64, (&lb[0]) as i64, 3, 0, 0, 0)
    check(n2 == 3, 10)

    // pipe
    var fds: [i32; 2] = [0; 2]
    check(syscall(22, (&fds[0]) as i64, 0, 0, 0, 0, 0) == 0, 11)
    check(syscall(1, fds[1] as i64, (&data[0]) as i64, 3, 0, 0, 0) == 3, 12)
    var rb: [u8; 8] = [0; 8]
    check(syscall(0, fds[0] as i64, (&rb[0]) as i64, 8, 0, 0, 0) == 3, 13)
    check(rb[0] == 97 as u8 && rb[2] == 99 as u8, 14)
    syscall(3, fds[0] as i64, 0, 0, 0, 0, 0)
    syscall(3, fds[1] as i64, 0, 0, 0, 0, 0)

    // rmdir
    check(syscall(84, rt.buf_ptr(&pf) as i64, 0, 0, 0, 0, 0) == -20, 15)
    check(syscall(84, rt.buf_ptr(&ps) as i64, 0, 0, 0, 0, 0) == 0, 16)
    check(syscall(84, rt.buf_ptr(&ps) as i64, 0, 0, 0, 0, 0) == -2, 17)
    var pb: rt.Buf = cs(base)
    check(syscall(84, rt.buf_ptr(&pb) as i64, 0, 0, 0, 0, 0) == -39, 18)

    rt.buf_free(&pf)
    rt.buf_free(&pl)
    rt.buf_free(&pd)
    rt.buf_free(&ps)
    rt.buf_free(&pn)
    rt.buf_free(&pb)
    fs.remove_tree(base) catch false
    if fails != 0 {
        return 1
    }
    return 0
}
