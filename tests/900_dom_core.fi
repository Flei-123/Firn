// expect_exit: 0
// tests/900_dom_core.fi -- THE DOM CORE (round 54, lib/browser/node.fi).
//
// What makes up the data structure that tree building, CSS and layout sit
// on is checked in ONE program:
//
//   * the five kinds of node (document, element, text, comment, doctype)
//     and the inheritance (`Gc[Element]` is a `Gc[Node]` for free)
//   * parent, child AND BOTH sibling references, all strong -- that is the
//     cycle the collector exists for
//   * inserting at the end, inserting BEFORE a sibling, removing,
//     moving all children (the adoption agency procedure needs that)
//   * attributes with a namespace and the rule for duplicate names
//   * namespaces as markers (HTML, SVG, MathML)
//   * chains: append, length, indexing across piece boundaries,
//     comparison, conversion into a code point buffer and back
//
// Every return value != 0 names the place.

import html.mem
import browser.node

// The kind of node behind a Gc pointer. The function does little and stands
// here all the same: a `Gc[...]` in a SIGNATURE is the mark by which the
// parser from lib/firnc1 recognises that this file is no longer core
// language. Without it it reports a syntax error instead of "not core"
// (docs/ROUND54.md 6.8) -- the file uses GC types but declares no
// `gc class` itself, and exactly that case did not exist before round 54.
fn kind_of(k: Gc[Node]) -> u32 {
    if k == gc_null[Node]() {
        return 0
    }
    return k.kind
}

fn chains_probe() -> i32 {
    let k = node.chain_new() catch gc_null[Chain]()
    if k == gc_null[Chain]() {
        return 1
    }
    if !node.chain_empty(k) {
        return 2
    }
    // Across several pieces (one piece holds 28 characters).
    var i: u32 = 0
    while i < 100 as u32 {
        let ok: bool = node.chain_push(k, 65 as u32 + (i % 26 as u32)) catch false
        if !ok {
            return 3
        }
        i = i + 1
    }
    if node.chain_len(k) != 100 {
        return 4
    }
    // Piece boundary at 28: characters 27, 28 and 29 have to be right.
    if node.chain_at(k, 27) != 65 as u32 + 1 as u32 {
        return 5
    }
    if node.chain_at(k, 28) != 65 as u32 + 2 as u32 {
        return 6
    }
    if node.chain_at(k, 99) != 65 as u32 + 21 as u32 {
        return 7
    }
    if node.chain_at(k, 100) != 0 as u32 {
        return 8
    }
    // Equality across piece boundaries
    let k2 = node.chain_new() catch gc_null[Chain]()
    i = 0
    while i < 100 as u32 {
        let ok: bool = node.chain_push(k2, 65 as u32 + (i % 26 as u32)) catch false
        i = i + 1
    }
    if !node.chain_equal(k, k2) {
        return 9
    }
    let ok3: bool = node.chain_push(k2, 33 as u32) catch false
    if node.chain_equal(k, k2) {
        return 10
    }
    // ASCII comparison, case insensitive as well
    let k3 = node.chain_new() catch gc_null[Chain]()
    var lit: [u8; 4] = "html"
    var i2: usize = 0
    while i2 < 4 {
        let ok: bool = node.chain_push(k3, lit[i2] as u32) catch false
        i2 = i2 + 1
    }
    if !node.chain_equal_ascii(k3, &lit[0], 4) {
        return 11
    }
    var lit2: [u8; 2] = "ht"
    if !node.chain_starts_ascii_small(k3, &lit2[0], 2) {
        return 12
    }
    var lit3: [u8; 4] = "HTML"
    if !node.chain_equal_ascii_small(k3, &lit3[0], 4) {
        return 13
    }
    if node.chain_equal_ascii(k3, &lit3[0], 4) {
        return 14
    }
    // There and back over a code point buffer
    var buf: mem.CpBuf = mem.cp_new()
    mem.cp_init(&buf)
    node.chain_after_cpbuf(k, &buf)
    if mem.cp_len(&buf) != 100 {
        return 15
    }
    let k4 = node.chain_out_cpbuf(&buf) catch gc_null[Chain]()
    if !node.chain_equal(k, k4) {
        return 16
    }
    mem.cp_free(&buf)
    return 0
}

fn tree_probe() -> i32 {
    let d = node.document_new() catch gc_null[Document]()
    if d == gc_null[Document]() {
        return 1
    }
    if node.doc_mode(d) != node.MODE_NO_QUIRKS {
        return 2
    }
    node.doc_mode_set(d, node.MODE_QUIRKS)
    if node.doc_mode(d) != node.MODE_QUIRKS {
        return 3
    }
    let html = node.elem_new(1, node.NS_HTML) catch gc_null[Elem]()
    let a = node.elem_new(2, node.NS_HTML) catch gc_null[Elem]()
    let b = node.elem_new(3, node.NS_SVG) catch gc_null[Elem]()
    let c = node.elem_new(4, node.NS_MATHML) catch gc_null[Elem]()
    if html == gc_null[Elem]() || a == gc_null[Elem]() {
        return 4
    }
    node.append_child(d, html)
    node.append_child(html, a)
    node.append_child(html, b)
    // Parent <-> child, both strong: the cycle
    if a.parent != html || html.first_child != a || html.last_child != b {
        return 5
    }
    if a.parent.first_child != a {
        return 6
    }
    // Siblings in BOTH directions
    if a.next != b || b.previous != a {
        return 7
    }
    if a.previous != gc_null[Node]() || b.next != gc_null[Node]() {
        return 8
    }
    if html.children != 2 as u32 {
        return 9
    }
    // Inserting BEFORE a sibling
    node.kind_insert_before(html, c, b)
    if a.next != c || c.next != b || b.previous != c || c.previous != a {
        return 10
    }
    if html.children != 3 as u32 {
        return 11
    }
    if node.node_index(c) != 1 {
        return 12
    }
    if node.child_at(html, 2) != b {
        return 13
    }
    // Removing
    node.kind_remove(c)
    if a.next != b || b.previous != a || html.children != 2 as u32 {
        return 14
    }
    if c.parent != gc_null[Node]() {
        return 15
    }
    // Namespaces as markers
    if node.elem_ns(a) != node.NS_HTML || node.elem_ns(b) != node.NS_SVG {
        return 16
    }
    if node.elem_ns(c) != node.NS_MATHML {
        return 17
    }
    if !node.elem_is(a, 2) {
        return 18
    }
    // `elem_is` ALWAYS asks for the HTML namespace
    if node.elem_is(b, 3) {
        return 19
    }
    // Inheritance: upcast for free, downcast checked
    let n: Gc[Node] = a
    if node.node_as_elem(n) != a {
        return 20
    }
    let t = node.text_new(gc_null[Chain]()) catch gc_null[Text]()
    node.append_child(a, t)
    if node.node_as_elem(t) != gc_null[Elem]() {
        return 21
    }
    if !node.node_is_elem(a) || node.node_is_elem(t) {
        return 22
    }
    if node.node_depth(t) != 3 as u32 {
        return 23
    }
    if !node.node_ancestor_is(t, html) || node.node_ancestor_is(t, b) {
        return 24
    }
    // Move all children (adoption agency step 16)
    let target = node.elem_new(9, node.NS_HTML) catch gc_null[Elem]()
    node.relink_children(html, target)
    if html.children != 0 as u32 || target.children != 2 as u32 {
        return 25
    }
    if target.first_child != a || target.last_child != b {
        return 26
    }
    if a.parent != target {
        return 27
    }
    // A collection in the middle of operation must not take anything reachable away.
    let before: u64 = gc_collections()
    gc_collect()
    if gc_collections() != before + 1 {
        return 28
    }
    if target.first_child != a || a.parent != target || a.first_child != t {
        return 29
    }
    return 0
}

fn attr_probe() -> i32 {
    let e = node.elem_new(1, node.NS_HTML) catch gc_null[Elem]()
    let w1 = node.chain_new() catch gc_null[Chain]()
    let w2 = node.chain_new() catch gc_null[Chain]()
    let w3 = node.chain_new() catch gc_null[Chain]()
    let ok1: bool = node.chain_push(w1, 65 as u32) catch false
    let ok2: bool = node.chain_push(w2, 66 as u32) catch false
    let ok3: bool = node.chain_push(w3, 67 as u32) catch false
    if node.attr_number(e) != 0 as u32 {
        return 1
    }
    let g1: bool = node.attr_set(e, 10, 0, w1) catch false
    if !g1 || node.attr_number(e) != 1 as u32 {
        return 2
    }
    // A duplicate name in the same namespace: it is NOT set.
    let g2: bool = node.attr_set(e, 10, 0, w2) catch false
    if g2 || node.attr_number(e) != 1 as u32 {
        return 3
    }
    // The same name in a DIFFERENT namespace is a different attribute.
    let g3: bool = node.attr_set(e, 10, node.NS_XLINK, w3) catch false
    if !g3 || node.attr_number(e) != 2 as u32 {
        return 4
    }
    if node.attr_value(e, 10, 0) != w1 {
        return 5
    }
    if node.attr_value(e, 10, node.NS_XLINK) != w3 {
        return 6
    }
    if node.attr_value(e, 11, 0) != gc_null[Chain]() {
        return 7
    }
    // The order stays the one of the source text
    let a1: Gc[Attr] = node.attr_first(e)
    if a1.name != 10 as u32 || a1.ns != 0 as u32 {
        return 8
    }
    if a1.next.ns != node.NS_XLINK {
        return 9
    }
    if a1.next.next != gc_null[Attr]() {
        return 10
    }
    return 0
}

fn special_node_probe() -> i32 {
    let name = node.chain_new() catch gc_null[Chain]()
    let pub = node.chain_new() catch gc_null[Chain]()
    let sys = node.chain_new() catch gc_null[Chain]()
    let dt = node.doctype_new(name, pub, sys, true, false) catch gc_null[Doctype]()
    if dt == gc_null[Doctype]() {
        return 1
    }
    if kind_of(dt) != node.K_DOCTYPE || !dt.has_pubid || dt.has_sysid {
        return 2
    }
    let km = node.comment_new(name) catch gc_null[Comment]()
    if kind_of(km) != node.K_COMMENT {
        return 3
    }
    let tx = node.text_new(name) catch gc_null[Text]()
    if kind_of(tx) != node.K_TEXT {
        return 4
    }
    let fr = node.fragment_new(7) catch gc_null[Fragment]()
    if kind_of(fr) != node.K_FRAGMENT || fr.host != 7 as u32 {
        return 5
    }
    if kind_of(gc_null[Node]()) != 0 as u32 {
        return 6
    }
    return 0
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    let a: i32 = chains_probe()
    if a != 0 {
        return a
    }
    let b: i32 = tree_probe()
    if b != 0 {
        return 30 + b
    }
    let c: i32 = attr_probe()
    if c != 0 {
        return 70 + c
    }
    let d: i32 = special_node_probe()
    if d != 0 {
        return 90 + d
    }
    return 0
}
