// expect_exit: 0
// tests/3910_default_args.fi -- default parameter values and named call
// arguments (docs/DEFAULT-ARGS.md): defaults fill the tail, named arguments
// go in any order and may skip optional parameters.
import std.str

const BASE: i32 = 100

fn add3(a: i32, b: i32 = 2, c: i32 = 30) -> i32 {
    return a * 1000 + b * 100 + c
}

fn flags(on: bool = true, level: u8 = 7 as u8, neg: i64 = -5) -> i64 {
    var r: i64 = neg
    if on {
        r = r + level as i64
    }
    return r
}

fn based(x: i32 = BASE + 5, y: i32 = (BASE as i32) * 2) -> i32 {
    return x + y
}

fn width(s: str = "abcd") -> usize {
    return s.length()
}

fn sizes(n: usize = (BASE as usize) / 12) -> usize {
    return n
}

fn only_named(host: i32, port: i32) -> i32 {
    return host * 10 + port
}

fn fail(code: i32) -> i32 {
    return code
}

fn main() -> i32 {
    // defaults
    if add3(1) != 1230 { return fail(1) }
    if add3(1, 5) != 1530 { return fail(2) }
    if add3(1, 5, 7) != 1507 { return fail(3) }
    // named
    if add3(1, c: 9) != 1209 { return fail(4) }
    if add3(c: 1, a: 4, b: 3) != 4301 { return fail(5) }
    if add3(2, b: 8) != 2830 { return fail(6) }
    if only_named(port: 4, host: 3) != 34 { return fail(7) }
    // other types
    if flags() != 2 { return fail(8) }
    if flags(false) != -5 { return fail(9) }
    if flags(level: 10 as u8) != 5 { return fail(10) }
    if based() != 305 { return fail(11) }
    if based(y: 1) != 106 { return fail(12) }
    if width() != 4 { return fail(13) }
    if width("xy") != 2 { return fail(14) }
    if sizes() != 8 { return fail(15) }
    // a call inside an argument of another call
    if add3(add3(1, c: 0) - 1100, b: add3(0, 0, 0) / 100) != 100030 { return fail(16) }
    return 0
}
