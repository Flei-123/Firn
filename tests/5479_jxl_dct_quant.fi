// expect_exit: 0
import jxl.jxl_bits
import jxl.jxl_dct
import jxl.jxl_quant
import std.math
import std.rt

static mut failures: i32 = 0

fn fld(p: u64, i: usize) -> f64 {
    return *((p +% ((i * 8) as u64)) as *mut f64)
}

fn fst(p: u64, i: usize, v: f64) {
    *((p +% ((i * 8) as u64)) as *mut f64) = v
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    return math.fabs(a - b) <= tol
}

fn check(cond: bool) {
    if !cond {
        failures = failures + 1
    }
}

fn fill(p: u64, n: usize, seed: u64) {
    var s: u64 = seed
    var i: usize = 0
    while i < n {
        s = s *% 6364136223846793005 +% 1442695040888963407
        fst(p, i, (((s >> 33) % 2001) as f64) / 100.0 - 10.0)
        i = i + 1
    }
}

fn check_1d(n: usize) {
    let x: u64 = rt.heap_alloc(n * 8)
    let a: u64 = rt.heap_alloc(n * 8)
    let b: u64 = rt.heap_alloc(n * 8)
    fill(x, n, n as u64)
    check(jxl_dct.idct_1d(x, n, a))
    jxl_dct.idct_1d_slow(x, n, b)
    var i: usize = 0
    while i < n {
        check(near(fld(a, i), fld(b, i), 0.000000001))
        i = i + 1
    }
    rt.heap_free(x, n * 8)
    rt.heap_free(a, n * 8)
    rt.heap_free(b, n * 8)
}

fn check_2d(rows: usize, cols: usize) {
    let n: usize = rows * cols
    let x: u64 = rt.heap_alloc(n * 8)
    let f: u64 = rt.heap_alloc(n * 8)
    let y: u64 = rt.heap_alloc(n * 8)
    fill(x, n, (rows * 1000 + cols) as u64)
    jxl_dct.dct_2d_slow(rows, cols, x, f)
    check(jxl_dct.idct_2d(rows, cols, f, y))
    var i: usize = 0
    while i < n {
        check(near(fld(x, i), fld(y, i), 0.000000001))
        i = i + 1
    }
    rt.heap_free(x, n * 8)
    rt.heap_free(f, n * 8)
    rt.heap_free(y, n * 8)
}

fn check_dc(rows: usize, cols: usize) {
    let n: usize = rows * cols
    let x: u64 = rt.heap_alloc(n * 8)
    let y: u64 = rt.heap_alloc(n * 8)
    var i: usize = 0
    while i < n {
        fst(x, i, 0.0)
        i = i + 1
    }
    fst(x, 0, 3.25)
    check(jxl_dct.idct_2d(rows, cols, x, y))
    i = 0
    while i < n {
        check(near(fld(y, i), 3.25, 0.000000001))
        i = i + 1
    }
    rt.heap_free(x, n * 8)
    rt.heap_free(y, n * 8)
}

fn put_bits(buf: u64, pos: *mut usize, v: u32, n: u32) {
    var i: u32 = 0
    while i < n {
        if ((v >> i) & 1) == 1 {
            let at: usize = (*pos) / 8
            rt.st8(buf, at, rt.ld8(buf, at) | ((1 as u8) << (((*pos) % 8) as u8)))
        }
        *pos = *pos + 1
        i = i + 1
    }
}

fn check_quant() {
    let buf: u64 = rt.heap_alloc(16)
    rt.mem_set(buf, 0 as u8, 16)
    var pos: usize = 0
    put_bits(buf, &pos, 1, 2)
    put_bits(buf, &pos, 2047, 11)
    put_bits(buf, &pos, 2, 2)
    put_bits(buf, &pos, 63, 8)
    put_bits(buf, &pos, 1, 1)
    var b: jxl_bits.JxlBits = jxl_bits.jb_new(buf, 16)
    var q: jxl_quant.JxlQuant = jxl_quant.quant_default()
    check(jxl_quant.quant_read(&b, &q) == 0)
    check(q.global_scale == 4096)
    check(q.quant_dc == 64)
    check(jxl_quant.lf_dequant_read(&b, &q) == 0)
    check(near(jxl_quant.quant_inv_global_scale(&q), 16.0, 0.0000001))
    check(near(jxl_quant.quant_dc_step(&q, 1), 0.25 / 512.0, 0.000000001))
    check(near(jxl_quant.quant_inv_dc_step(&q, 2), 256.0 * (4096.0 / 65536.0 * 64.0), 0.0001))
    rt.heap_free(buf, 16)
}

fn check_known() {
    let x: u64 = rt.heap_alloc(64)
    let y: u64 = rt.heap_alloc(64)
    var i: usize = 0
    while i < 8 {
        fst(x, i, 0.0)
        i = i + 1
    }
    fst(x, 1, 1.0)
    check(jxl_dct.idct_1d(x, 8, y))
    check(near(fld(y, 0), 1.3870398453221475, 0.000000001))
    check(near(fld(y, 7), 0.0 - 1.3870398453221475, 0.000000001))
    rt.heap_free(x, 64)
    rt.heap_free(y, 64)
}

fn main() -> i32 {
    check_1d(1)
    check_1d(2)
    check_1d(8)
    check_1d(16)
    check_1d(32)
    check_1d(64)
    check_1d(128)
    check_1d(256)
    check_2d(8, 8)
    check_2d(16, 8)
    check_2d(8, 32)
    check_2d(32, 32)
    check_2d(64, 128)
    check_2d(16, 256)
    check_known()
    check_dc(8, 8)
    check_dc(32, 16)
    check(!jxl_dct.valid_size(12))
    check_quant()
    return failures
}
