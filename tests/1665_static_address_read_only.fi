// expect_exit: 42
// Taking the address of a plain (not `mut`) `static` only READS it -- both
// compilers have to accept `&TABLE[i]` and `&WORD`. firnc1 used to treat
// the operand of `&` as a write and stopped silently (exit 1 with no
// message) on every fUi program that pulled in fui/themefile.fi.
static KEYS: [u8; 9] = "red green"
static ANSWER: u64 = 40

fn byte_at(p: u64, i: u64) -> u8 {
    return *((p + i) as *mut u8)
}

fn main() -> i32 {
    let p: u64 = (&KEYS[0]) as u64
    if byte_at(p, 0) != 114 { return 1 as i32 } // 'r'
    let q: u64 = (&KEYS[4]) as u64
    if byte_at(q, 0) != 103 { return 2 as i32 } // 'g'
    let a: *mut u64 = &ANSWER
    return (*a + 2) as i32
}
