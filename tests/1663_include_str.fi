// expect_out: hello, file|line two|21|0 1 254 255|42
// Round GAPS: `__include_str("file")` -- a file's octets as a text literal,
// read at build time, relative to THIS file (docs/LUECKEN.md B21).
import std.io

const GREETING: str = __include_str("data/include_greeting.txt")

fn first_line(s: str) -> str {
    var i: usize = 0
    while i < s.n && *(s.p + i) != 10 as u8 {
        i = i + 1
    }
    return str { p: s.p, n: i }
}

fn main() -> i32 {
    let g: str = GREETING
    let second: str = str { p: g.p + 12, n: 8 }
    // an array context gets the octets as an array, binary included
    var b: [u8; 4] = __include_str("data/include_bytes.bin")
    let n: u64 = g.n as u64
    io.fmt_print_line(f"{first_line(g)}|{second}|{n}|{b[0]} {b[1]} {b[2]} {b[3]}|42")
    return 0
}
