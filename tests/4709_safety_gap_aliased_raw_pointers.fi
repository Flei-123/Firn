// expect_exit: 6
// r899 (documents a NON-guarantee): two raw pointers to the same local are accepted,
// no aliasing rule applies to raw pointers. Result is deterministic: 5, then 5 + 1.
fn main() -> i32 {
    var x: i64 = 1
    let a: *mut i64 = &x
    let b: *mut i64 = &x
    *a = 5
    *b = *b + 1
    return x as i32
}
