// expect_exit: 0
import std.rt
import std.vec

fn xor_i32(v: *mut Vec[i64], lo: i32) -> i64 {
    var s: i64 = 0
    var i: i32 = lo
    let n: i32 = vec_len[i64](v) as i32
    while i < n {
        s = s ^ ((*v)[i] + (*v)[i - lo])
        i = i + 1
    }
    return s
}

fn add_i64(v: *mut Vec[i64]) -> i64 {
    var s: i64 = 0
    var i: i64 = 1
    let n: i64 = vec_len[i64](v) as i64
    while i < n {
        s = s + ((*v)[i] & (*v)[i - 1])
        i = i + 1
    }
    return s
}

fn map_i32(v: *mut Vec[i32], w: *mut Vec[i32]) {
    var i: i32 = 0
    let n: i32 = vec_len[i32](v) as i32
    while i < n {
        (*w)[i] = ((*v)[i] ^ 77) + 3
        i = i + 1
    }
}

fn ref_xor(v: *mut Vec[i64], lo: usize) -> i64 {
    var s: i64 = 0
    var i: usize = lo
    while i < vec_len[i64](v) {
        s = s ^ ((*v)[i] + (*v)[i - lo])
        i = i + 1
    }
    return s
}

fn check(len: i64) -> i32 {
    var v: Vec[i64] = vec_new[i64]()
    var a: Vec[i32] = vec_new[i32]()
    var b: Vec[i32] = vec_new[i32]()
    var k: i64 = 0
    while k < len {
        vec_push[i64](&v, k * 7919 + (k ^ 21) * 31)
        vec_push[i32](&a, (k * 37 + 5) as i32)
        vec_push[i32](&b, 0)
        k = k + 1
    }
    var lo: i32 = 0
    while lo < 4 {
        if xor_i32(&v, lo) != ref_xor(&v, lo as usize) { return 1 }
        lo = lo + 1
    }
    var r: i64 = 0
    var j: usize = 1
    while j < vec_len[i64](&v) {
        r = (r * 3 + ((*(&v))[j] & (*(&v))[j - 1])) & 4294967295
        j = j + 1
    }
    var t: i64 = 0
    j = 1
    while j < vec_len[i64](&v) {
        t = t + ((*(&v))[j] & (*(&v))[j - 1])
        j = j + 1
    }
    if add_i64(&v) != t { return 2 }
    map_i32(&a, &b)
    j = 0
    while j < vec_len[i32](&a) {
        if (*(&b))[j] != ((*(&a))[j] ^ 77) + 3 { return 3 }
        j = j + 1
    }
    if r == 1 { return 4 }
    return 0
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var len: i64 = 0
    while len < 70 {
        let rc = check(len)
        if rc != 0 { return rc * 10 }
        len = len + 1
    }
    return 0
}
