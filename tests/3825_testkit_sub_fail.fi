// expect_exit: 101
// tests/3825_testkit_sub_fail.fi -- a failing table lists EVERY bad row and then
// panics once (exit 101): rows 5=11 and 4=9 are wrong, 1=2 is right.
import std.rt
import std.testkit

fn dbl(n: i64) -> i64 { return n * 2 }

fn main() -> i32 {
    if !gc_init() { return 1 }
    testkit.table_i64_i64(dbl, "1=2,5=11,4=9")
    testkit.fail("table did not stop the program")
    return 0
}
