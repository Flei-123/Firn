// expect_exit: 0
// Floating point literals: the bit patterns that both lexers have to read alike.
//
// Every literal here was read DIFFERENTLY by `firnc0` (Rust) and by the
// lexer in Firn until round 65 -- from one ULP up to a completely
// different number. `tools/lexnum/run.sh` proves the general case; this
// test nails the named ones so they cannot come back.
//
// The check runs over the BIT PATTERN, not over the printed value: two
// doubles that are one ULP apart print the same in almost every format --
// which is why the divergence of round 63 stayed unnoticed for so long.
// The detour through the address is the one from `lib/firnc1/lexer.fi`:
// a direct cast of `&t` to `*mut u64` is read by stage 0 as a value
// conversion, through the address it is a true reinterpretation.

fn bits_of(x: f64) -> u64 {
    var t: f64 = 0.0
    let p: u64 = (&t) as u64
    *(p as *mut f64) = x
    return *(p as *mut u64)
}

fn main() -> i32 {
    // 2^53-1: was 4845873199050653694, one ULP too small (round 63, gap 8)
    if bits_of(9007199254740991.0) != 4845873199050653695 {
        return 1
    }
    // was one ULP too small
    if bits_of(1e308) != 9214871658872686752 {
        return 2
    }
    // the PHP hanger: was four ULP too large
    if bits_of(2.2250738585072011e-308) != 4503599627370495 {
        return 3
    }
    // 2^64: the mantissa wrapped around in the u64 -- the literal became 0.0
    if bits_of(18446744073709551616.0) != 4895412794951729152 {
        return 4
    }
    // the same wraparound: the literal became 0.3
    if bits_of(1844674407370955161.9) != 4880100556218669466 {
        return 5
    }
    // and here it became a number larger than 2^63
    if bits_of(123456789012345678901234567890.0) != 5042042089369253694 {
        return 6
    }
    // the classic sum 0.1 + 0.2, one ULP off
    if bits_of(0.30000000000000004) != 4599075939470750516 {
        return 7
    }
    // 2^53+1 is not representable and rounds to the EVEN 2^53
    if bits_of(9007199254740993.0) != 4845873199050653696 {
        return 8
    }
    // 2^53+3 rounds to 2^53+4, the even one on the other side
    if bits_of(9007199254740995.0) != 4845873199050653698 {
        return 9
    }
    // not representable; one multiplication, one rounding
    if bits_of(1e23) != 4950912855330343670 {
        return 10
    }
    // the everyday case has to stay right too
    if bits_of(0.1) != 4591870180066957722 {
        return 11
    }
    if bits_of(1.0) != 4607182418800017408 {
        return 12
    }
    if bits_of(0.0) != 0 {
        return 13
    }
    // the separator does not change the value
    if bits_of(1_000.5) != 4652011706887700480 {
        return 14
    }
    return 0
}
