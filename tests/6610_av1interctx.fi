import media.video.vp9.vp9mem
import media.video.av1.av1blkst
import media.video.av1.av1interctx

// expect_exit: 0

fn set_ref(td: *mut av1blkst.TileDec, row: i64, col: i64, r0: i64, r1: i64) {
    av1blkst.st((*td).ref_a, (row * (*td).mi_cols + col) * 2, r0 + 1)
    av1blkst.st((*td).ref_a, (row * (*td).mi_cols + col) * 2 + 1, r1 + 1)
}

fn expect(name: i64, got: i64, want: i64) -> i64 {
    if got != want {
        return name
    }
    return 0
}

fn first(a: i64, b: i64) -> i64 {
    if a != 0 {
        return a
    }
    return b
}

fn main() -> i32 {
    let td: *mut av1blkst.TileDec = av1blkst.td_new()
    (*td).mi_cols = 4
    (*td).mi_rows = 4
    (*td).ref_a = vp9mem.alloc(32)
    vp9mem.zero((*td).ref_a, 32)
    (*td).mi_row = 1
    (*td).mi_col = 1
    (*td).avail_u = 1
    (*td).avail_l = 1
    var bad: i64 = 0
    set_ref(td, 0, 1, 1, 0 - 1)
    set_ref(td, 1, 0, 5, 0 - 1)
    bad = first(bad, expect(1, av1interctx.ctx_intra_inter(td), 0))
    bad = first(bad, expect(2, av1interctx.ctx_comp_inter(td), 1))
    bad = first(bad, expect(3, av1interctx.ctx_single_p1(td), 1))
    bad = first(bad, expect(4, av1interctx.ctx_single_p2(td), 2))
    bad = first(bad, expect(5, av1interctx.ctx_comp_ref_type(td), 1))
    bad = first(bad, expect(6, av1interctx.ctx_single_p3(td), 2))
    bad = first(bad, expect(7, av1interctx.ctx_single_p4(td), 2))
    bad = first(bad, expect(8, av1interctx.ctx_single_p6(td), 2))
    set_ref(td, 0, 1, 1, 7)
    set_ref(td, 1, 0, 0, 0 - 1)
    bad = first(bad, expect(10, av1interctx.ctx_intra_inter(td), 1))
    bad = first(bad, expect(11, av1interctx.ctx_comp_inter(td), 3))
    bad = first(bad, expect(12, av1interctx.ctx_comp_ref_type(td), 1))
    bad = first(bad, expect(13, av1interctx.ctx_single_p1(td), 1))
    set_ref(td, 0, 1, 5, 7)
    (*td).avail_l = 0
    bad = first(bad, expect(20, av1interctx.ctx_comp_ref_type(td), 4))
    bad = first(bad, expect(21, av1interctx.ctx_comp_inter(td), 3))
    bad = first(bad, expect(22, av1interctx.ctx_intra_inter(td), 0))
    (*td).avail_u = 0
    bad = first(bad, expect(30, av1interctx.ctx_comp_inter(td), 1))
    bad = first(bad, expect(31, av1interctx.ctx_comp_ref_type(td), 2))
    bad = first(bad, expect(32, av1interctx.ctx_intra_inter(td), 0))
    if bad != 0 {
        return bad as i32
    }
    return 0
}
