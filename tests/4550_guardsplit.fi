// expect_exit: 0
// Guard split: the pure entry guard of a self-recursive function is copied
// to the recursive call sites. Results must equal the iterative versions.
fn fib(n: u32) -> u64 {
    if n < 2 {
        return n as u64
    }
    return fib(n - 1) + fib(n - 2)
}

fn trib(n: u32) -> u64 {
    if n < 3 {
        return (n as u64) * 2
    }
    return trib(n - 1) + trib(n - 2) + trib(n - 3)
}

fn sgn(n: i64) -> i64 {
    if n <= 0 {
        return -n
    }
    return sgn(n - 2) + sgn(n - 3) + 1
}

fn inverted(n: u32) -> u64 {
    if n >= 4 {
        return inverted(n - 1) + inverted(n - 4)
    }
    return (n as u64) + 1
}

fn fib_iter(n: u32) -> u64 {
    var a: u64 = 0
    var b: u64 = 1
    var i: u32 = 0
    while i < n {
        let t: u64 = a + b
        a = b
        b = t
        i = i + 1
    }
    return a
}

fn trib_iter(n: u32) -> u64 {
    var v: [u64; 40] = [0; 40]
    var i: usize = 0
    while i < 40 {
        if i < 3 {
            v[i] = (i as u64) * 2
        } else {
            v[i] = v[i - 1] + v[i - 2] + v[i - 3]
        }
        i = i + 1
    }
    return v[n as usize]
}

fn sgn_ref(n: i64) -> i64 {
    if n <= 0 {
        return -n
    }
    var s: i64 = 1
    s = s + sgn_ref(n - 2)
    s = s + sgn_ref(n - 3)
    return s
}

fn inverted_ref(n: u32) -> u64 {
    var v: [u64; 40] = [0; 40]
    var i: usize = 0
    while i < 40 {
        if i >= 4 {
            v[i] = v[i - 1] + v[i - 4]
        } else {
            v[i] = (i as u64) + 1
        }
        i = i + 1
    }
    return v[n as usize]
}

fn main() -> i32 {
    var n: u32 = 0
    while n < 25 {
        if fib(n) != fib_iter(n) {
            return 1
        }
        if trib(n) != trib_iter(n) {
            return 2
        }
        if inverted(n) != inverted_ref(n) {
            return 3
        }
        n = n + 1
    }
    var k: i64 = -5
    while k < 20 {
        if sgn(k) != sgn_ref(k) {
            return 4
        }
        k = k + 1
    }
    return 0
}
