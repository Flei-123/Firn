// expect_exit: 0
// 'try' inside a loop: the first error leaves the function immediately.
error E { TooMuch }

fn step(n: i32) -> E!i32 {
    if n > 3 {
        return E::TooMuch
    }
    return n
}

fn to(n: i32) -> E!i32 {
    var acc: i32 = 0
    var i: i32 = 0
    while i <= n {
        acc = acc + try step(i)
        i = i + 1
    }
    return acc
}

fn main() -> i32 {
    if (to(3) catch 0 - 1) != 6 {
        return 1
    }
    if (to(9) catch 0 - 1) != 0 - 1 {
        return 2
    }
    return 0
}
