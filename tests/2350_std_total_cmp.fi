// expect_exit: 0
// tests/2350_std_total_cmp.fi -- math.total_cmp (IEEE 754 totalOrder) and
// `vec_sort[f64]` (SKRIPT-LIBS r316).
//
// The order under test:
//   -NaN < -inf < negative finite < -0.0 < +0.0 < positive finite < +inf < +NaN
// and equal bit patterns compare equal (NaN payloads are ordered by payload).
// Exit codes: the number of the first failing check.
import std.vec
import std.math

fn neg_nan() -> f64 {
    return math.math_f64(18444492273895866368)
}

fn neg_zero() -> f64 {
    return math.math_f64(9223372036854775808)
}

fn lt(a: f64, b: f64) -> bool {
    return math.total_cmp(a, b) == 0 - 1 && math.total_cmp(b, a) == 1 && math.total_less(a, b) && !math.total_less(b, a)
}

fn at(v: *mut Vec[f64], i: usize) -> f64 {
    let p: *mut f64 = vec_elem_ptr[f64](v, i)
    return *p
}

// next pseudo random number (64 bit LCG, wraps on purpose)
fn next(s: u64) -> u64 {
    return s *% 6364136223846793005 +% 1442695040888963407
}

fn main() -> i32 {
    let inf: f64 = math.INF()
    let nan: f64 = math.NAN()
    // --- the chain, strictly ascending ---
    var chain: [f64; 9] = [neg_nan(), 0.0 - inf, 0.0 - 1.5, 0.0 - 5e-324, neg_zero(), 0.0, 5e-324, 2.5, inf]
    var i: usize = 0
    while i < 8 {
        if !lt(chain[i], chain[i + 1]) { return 1 }
        i = i + 1
    }
    if !lt(inf, nan) { return 2 }
    if !lt(neg_nan(), 0.0 - inf) { return 3 }
    // --- reflexive, also for NaN and the zeros ---
    if math.total_cmp(nan, nan) != 0 { return 4 }
    if math.total_cmp(neg_zero(), neg_zero()) != 0 { return 5 }
    if math.total_cmp(neg_zero(), 0.0) != 0 - 1 { return 6 }
    if math.total_cmp(0.0, neg_zero()) != 1 { return 7 }
    // NaN payloads are ordered by payload
    if !lt(math.math_f64(9221120237041090560), math.math_f64(9221120237041090561)) { return 8 }
    // --- agreement with `<` wherever `<` is an ordering (random finite pairs) ---
    var s: u64 = 12345
    var k: usize = 0
    while k < 20000 {
        s = next(s)
        let a: f64 = math.math_f64(s)
        s = next(s)
        let b: f64 = math.math_f64(s)
        if math.is_finite(a) && math.is_finite(b) && a != b {
            let want: i32 = if a < b { 0 - 1 } else { 1 }
            if math.total_cmp(a, b) != want { return 9 }
        }
        k = k + 1
    }
    // --- vec_sort[f64]: NaN and zeros, deterministic, input of every shape ---
    var v: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&v)
    vec_push[f64](&v, 3.0)
    vec_push[f64](&v, nan)
    vec_push[f64](&v, 0.0)
    vec_push[f64](&v, 0.0 - inf)
    vec_push[f64](&v, neg_zero())
    vec_push[f64](&v, neg_nan())
    vec_push[f64](&v, inf)
    vec_push[f64](&v, 0.0 - 2.0)
    vec_push[f64](&v, 3.0)
    vec_sort[f64](&v)
    if !vec_is_sorted[f64](&v) { return 10 }
    if math.math_bits(at(&v, 0)) != 18444492273895866368 { return 11 }
    if at(&v, 1) != 0.0 - inf { return 12 }
    if at(&v, 2) != 0.0 - 2.0 { return 13 }
    if math.math_bits(at(&v, 3)) != 9223372036854775808 { return 14 }
    if math.math_bits(at(&v, 4)) != 0 { return 15 }
    if at(&v, 5) != 3.0 || at(&v, 6) != 3.0 { return 16 }
    if at(&v, 7) != inf { return 17 }
    if math.math_bits(at(&v, 8)) != 9221120237041090560 { return 18 }
    // --- a big random sort is ascending in the total order and keeps the bits ---
    var w: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&w)
    var xor: u64 = 0
    k = 0
    while k < 3000 {
        s = next(s)
        vec_push[f64](&w, math.math_f64(s))
        xor = xor ^ s
        k = k + 1
    }
    vec_sort[f64](&w)
    k = 1
    while k < 3000 {
        if math.total_cmp(at(&w, k - 1), at(&w, k)) > 0 { return 19 }
        k = k + 1
    }
    var xor2: u64 = 0
    k = 0
    while k < 3000 {
        xor2 = xor2 ^ math.math_bits(at(&w, k))
        k = k + 1
    }
    if xor != xor2 { return 20 }
    // sorted search works on the total order too
    if vec_binary_search[f64](&v, 3.0) == vec_len[f64](&v) { return 21 }
    return 0
}
