// expect_exit: 0
// Fehlerunion ueber die Modulgrenze (import/export).
import modules.fehlerquelle

fn haupt(n: i32) -> LeseFehler!i32 {
    let v = try fehlerquelle.lies(n)
    return v + 1
}

fn main() -> i32 {
    if (haupt(2) catch 0) != 7 {
        return 1
    }
    if (haupt(0) catch 0 - 2) != 0 - 2 {
        return 2
    }
    if (haupt(0 - 3) catch 0 - 2) != 0 - 2 {
        return 3
    }
    return 0
}
