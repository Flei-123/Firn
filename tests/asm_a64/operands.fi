// expect_exit: 0
import std.rt

fn main() -> i32 {
    let buf: u64 = rt.heap_alloc(64)
    var sum: u64 = 0
    var high: u64 = 0
    var product: u64 = 0
    var swapped: u64 = 0
    var below: u64 = 0
    var narrow: u64 = 0
    var loaded: u64 = 0
    unsafe {
        sum = asm("add x0, x0, x1", out("x0"), in("x0") 40 as u64, in("x1") 2 as u64)
        asm("mul x0, x2, x3\numulh x1, x2, x3", out("x0") & product, out("x1") & high, in("x2") (1 as u64) << (63 as u64), in("x3") 4 as u64)
        swapped = asm("rev x0, x0", out("x0"), in("x0") 0x0102030405060708 as u64)
        asm("str x0, [x1]", in("x0") 77 as u64, in("x1") buf, clobber("memory"))
        below = asm("cmp x0, x1\ncset x2, lo", out("x2"), in("x0") 3 as u64, in("x1") 9 as u64)
        narrow = asm("add w0, w0, w1", out("x0"), in("w0") 0xfffffff0 as u64, in("w1") 0x20 as u64)
        loaded = asm("ldr x0, [x1]", out("x0"), in("x1") buf, clobber("memory"))
    }
    if sum != 42 { return 1 }
    if product != 0 { return 2 }
    if high != 2 { return 3 }
    if swapped != 0x0807060504030201 as u64 { return 4 }
    var stored: u64 = 0
    unsafe {
        stored = *(buf as *mut u64)
    }
    if stored != 77 { return 5 }
    if below != 1 { return 6 }
    if narrow != 0x10 { return 7 }
    if loaded != 77 { return 8 }
    return 0
}
