// expect_out: .CBA
// `defer` (SPEC §5.1, §5.4): die aufgeschobene Anweisung laeuft beim Verlassen
// des umschliessenden Blocks, in UMGEKEHRTER Reihenfolge der Vereinbarung —
// auch bei `return`, `break` und `continue`.
//
// AUSWERTUNGSZEITPUNKT (Firn folgt Zig, nicht Go): der Rumpf wird ERST beim
// Verlassen ausgewertet, mit den Werten von dann. Go wertet die Argumente
// sofort aus und braucht dafuer versteckte Kopien — das widerspricht dem
// Grundsatz „nichts Verstecktes" (SPEC §2). Geprueft wird das unten mit
// `zaehler_beim_verlassen`.

fn schreib(c: u8) {
    var b: [u8; 1] = [0 as u8; 1]
    b[0] = c
    let p: u64 = (&b[0]) as u64
    syscall(1, 1, p as i64, 1, 0, 0, 0)
}

// --- 1. Reihenfolge: rueckwaerts
fn rueckwaerts() {
    defer schreib(65 as u8)   // 'A' laeuft zuletzt
    defer schreib(66 as u8)   // 'B'
    defer schreib(67 as u8)   // 'C' laeuft zuerst
    schreib(46 as u8)         // '.'
}

// --- 2. `return` fuehrt ALLE Ebenen aus, innerste zuerst
fn ebenen(n: i32, aus: *mut i32) -> i32 {
    defer aussen_merken(aus)
    if n > 0 {
        defer innen_merken(aus)
        return 7
    }
    return 0
}

fn aussen_merken(aus: *mut i32) {
    *aus = *aus * 10 + 1
}

fn innen_merken(aus: *mut i32) {
    *aus = *aus * 10 + 2
}

// --- 3. Auswertung erst beim Verlassen
fn zaehler_beim_verlassen(aus: *mut i32) {
    var i: i32 = 5
    defer merke(aus, i)
    i = 9
    // Beim Verlassen ist i == 9, nicht 5.
}

fn merke(aus: *mut i32, v: i32) {
    *aus = v
}

// --- 4. je Schleifendurchlauf ein eigener Rumpf
fn schleife(aus: *mut i32) {
    var i: i32 = 0
    while i < 3 {
        defer zaehl(aus)
        i = i + 1
    }
}

fn zaehl(aus: *mut i32) {
    *aus = *aus + 1
}

// --- 5. `break` raeumt nur die Ebenen INNERHALB der Schleife ab
fn mit_break(aus: *mut i32) {
    defer zaehl_gross(aus)
    var i: i32 = 0
    while i < 5 {
        defer zaehl(aus)
        if i == 1 {
            break
        }
        i = i + 1
    }
}

fn zaehl_gross(aus: *mut i32) {
    *aus = *aus + 100
}

fn main() -> i32 {
    // 1. Reihenfolge
    rueckwaerts()
    schreib(10 as u8)

    // 2. Ebenen bei `return`: innen (2) vor aussen (1) -> 0*10+2=2, 2*10+1=21
    var e: i32 = 0
    if ebenen(1, &e) != 7 {
        return 1
    }
    if e != 21 {
        return 2
    }

    // 3. Auswertung erst beim Verlassen
    var z: i32 = 0
    zaehler_beim_verlassen(&z)
    if z != 9 {
        return 3
    }

    // 4. drei Durchlaeufe, drei Ausfuehrungen
    var s: i32 = 0
    schleife(&s)
    if s != 3 {
        return 4
    }

    // 5. zwei Durchlaeufe bis zum `break` (i=0 und i=1), danach die aeussere
    // Ebene: 2 + 100
    var b: i32 = 0
    mit_break(&b)
    if b != 102 {
        return 5
    }
    return 0
}
