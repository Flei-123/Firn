// expect_out: .CBA
// `defer` (SPEC 5.1, 5.4): the deferred statement runs when the enclosing
// block is left, in REVERSE order of declaration -- for `return`, `break`
// and `continue` as well.
//
// TIME OF EVALUATION (Firn follows Zig, not Go): the body is evaluated ONLY
// when the block is left, with the values of that moment. Go evaluates the
// arguments immediately and needs hidden copies for that -- which
// contradicts the principle "nothing hidden" (SPEC 2). That is checked below
// with `counter_at_leave`.

fn write(c: u8) {
    var b: [u8; 1] = [0 as u8; 1]
    b[0] = c
    let p: u64 = (&b[0]) as u64
    syscall(1, 1, p as i64, 1, 0, 0, 0)
}

// --- 1. order: backwards
fn backward() {
    defer write(65 as u8) // 'A' laeuft zuletzt
    defer write(66 as u8) // 'B'
    defer write(67 as u8) // 'C' laeuft zuerst
    write(46 as u8) // '.'
}

// --- 2. `return` runs ALL levels, innermost first
fn levels(n: i32, out: *mut i32) -> i32 {
    defer outer_remember(out)
    if n > 0 {
        defer inner_remember(out)
        return 7
    }
    return 0
}

fn outer_remember(out: *mut i32) {
    *out = *out * 10 + 1
}

fn inner_remember(out: *mut i32) {
    *out = *out * 10 + 2
}

// --- 3. evaluation only when the block is left
fn counter_at_leave(out: *mut i32) {
    var i: i32 = 5
    defer remember(out, i)
    i = 9
    // When the block is left i == 9, not 5.
}

fn remember(out: *mut i32, v: i32) {
    *out = v
}

// --- 4. one body of its own per loop pass
fn loop_fn(out: *mut i32) {
    var i: i32 = 0
    while i < 3 {
        defer count(out)
        i = i + 1
    }
}

fn count(out: *mut i32) {
    *out = *out + 1
}

// --- 5. `break` only unwinds the levels INSIDE the loop
fn with_break(out: *mut i32) {
    defer count_big(out)
    var i: i32 = 0
    while i < 5 {
        defer count(out)
        if i == 1 {
            break
        }
        i = i + 1
    }
}

fn count_big(out: *mut i32) {
    *out = *out + 100
}

fn main() -> i32 {
    // 1. order
    backward()
    write(10 as u8)

    // 2. levels at `return`: inner (2) before outer (1) -> 0*10+2=2, 2*10+1=21
    var e: i32 = 0
    if levels(1, &e) != 7 {
        return 1
    }
    if e != 21 {
        return 2
    }

    // 3. evaluation only when the block is left
    var z: i32 = 0
    counter_at_leave(&z)
    if z != 9 {
        return 3
    }

    // 4. three passes, three executions
    var s: i32 = 0
    loop_fn(&s)
    if s != 3 {
        return 4
    }

    // 5. two passes up to the `break` (i=0 and i=1), after that the outer
    // level: 2 + 100
    var b: i32 = 0
    with_break(&b)
    if b != 102 {
        return 5
    }
    return 0
}
