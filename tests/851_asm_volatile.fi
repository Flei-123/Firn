// expect_exit: 7
// Runde 52: DIE FALLE AUS RUNDE 40. Der asm-Block hat keinen Ausgabeoperanden
// und sein Ergebnis wird nie gelesen — trotzdem darf ihn kein Durchgang
// entfernen. Er schreibt naemlich in den Speicher, und genau davon haengt der
// Rueckgabewert ab. Faellt der Block weg, liefert das Programm 0.
fn main() -> i32 {
    var z: u64 = 0
    asm("mov qword ptr [rcx], 7", in("rcx") (&z) as u64, clobber("memory"))
    return z as i32
}
