// expect_exit: 7
// Round 52: THE TRAP FROM ROUND 40. The asm block has no output operand
// and its result is never read -- still no pass may remove it. It writes
// into memory after all, and exactly that is what the return value depends
// on. If the block falls away, the program yields 0.
fn main() -> i32 {
    var z: u64 = 0
    asm("mov qword ptr [rcx], 7", in("rcx")(&z) as u64, clobber("memory"))
    return z as i32
}
