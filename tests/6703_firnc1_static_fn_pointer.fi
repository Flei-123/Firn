// expect_out: 7|0
import std.io

fn seven() -> i32 {
    return 7
}

static mut G_HOOK: fn() -> i32 = 0 as fn() -> i32

fn main() -> i32 {
    let before: u64 = G_HOOK as u64
    G_HOOK = seven
    let hook: fn() -> i32 = G_HOOK
    let now: i32 = hook()
    io.fmt_print_line(f"{now}|{before}")
    return 0
}
