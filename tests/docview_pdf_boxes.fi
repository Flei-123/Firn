// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import html.mem
import rt.rt
import docview.pdf.pdf

fn main() -> i32 {
    var S: str = "%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R/Dests<</here [3 0 R /XYZ 20 80 0]>>>>endobj\n2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj\n3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 200 100]/Rotate 90/Contents 4 0 R/Resources<</Font<</F1 5 0 R>>>>/Annots[6 0 R 7 0 R]>>endobj\n4 0 obj<</Length 41>>stream\nBT /F1 18 Tf 10 50 Td (Hello Firn) Tj ET\nendstream\nendobj\n5 0 obj<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>endobj\n6 0 obj<</Type/Annot/Subtype/Link/Rect[10 40 100 70]/Dest(here)>>endobj\n7 0 obj<</Type/Annot/Subtype/Link/Rect[0 0 50 20]/A<</S/GoTo/D[3 0 R/Fit]>>>>endobj\ntrailer<</Root 1 0 R>>\n"
    var p: pdf.Pdf = pdf.pdf_new()
    if !pdf.pdf_open(&p, S.p as u64, S.n) {
        return 1
    }
    var t: mem.Buf = mem.buf_new()
    var b: mem.Buf = mem.buf_new()
    mem.buf_init(&t)
    mem.buf_init(&b)
    if !pdf.pdf_text_boxes(&p, 0, &t, &b) {
        return 2
    }
    if mem.buf_len(&b) / 32 != mem.buf_len(&t) {
        return 3
    }
    var q: str = "Firn"
    var r: mem.Buf = mem.buf_new()
    mem.buf_init(&r)
    if pdf.pdf_find_rects(&p, 0, q.p as u64, q.n, &r) != 1 {
        return 4
    }
    if pdf.rect_w(&r, 0) > pdf.rect_h(&r, 0) || pdf.rect_h(&r, 0) < 20.0 || pdf.rect_x(&r, 0) < 0.0 {
        return 5
    }
    var lk: mem.Buf = mem.buf_new()
    var us: mem.Buf = mem.buf_new()
    mem.buf_init(&lk)
    mem.buf_init(&us)
    if pdf.pdf_links(&p, 0, &lk, &us) != 2 {
        return 6
    }
    if pdf.link_page(&lk, 0) != 0 || !pdf.link_has_pos(&lk, 0) || pdf.link_page(&lk, 1) != 0 || pdf.link_has_pos(&lk, 1) {
        return 7
    }
    if pdf.link_w(&lk, 0) > pdf.link_h(&lk, 0) {
        return 8
    }
    return 0
}
