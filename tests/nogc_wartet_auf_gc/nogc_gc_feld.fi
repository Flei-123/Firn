// expect_error: 12:7 ist #[no_gc], schreibt aber in das GC-Feld 'naechster'
// expect_error_count: 1
// Regel (iii) aus SPEC §3.5.4: das Schreiben eines Gc-Zeigers in ein Feld
// braucht die Einfuegebarriere und ist in einem #[no_gc]-Aufrufbaum verboten.
gc class Knoten {
    naechster: Gc[Knoten]
    marke: i32
}

#[no_gc]
fn haenge_an(a: Gc[Knoten], b: Gc[Knoten]) -> i32 {
    a.naechster = b
    return a.marke
}

fn main() -> i32 {
    return 0 as i32
}
