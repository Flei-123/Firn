// expect_exit: 0
// CT INTRINSICS IN THE CORE LANGUAGE -- the test for round 36 (docs/ROUND36.md).
//
// The whole path is checked in ONE program:
//
//   * select(cond, a, b) on integers -- data independent (cmov,
//     no branch, SPEC 9.2)
//   * select on pointers and u8 values -- the result type is the arm type
//   * secure_zero(pointer, count) clears reliably and is never
//     optimised away (SPEC 9.3, C3)
//   * barrier(x) as an opaque identity (SPEC 9.2)
//   * nested: select around barrier, barrier around select

fn main() -> i32 {
    // select on i32
    var a: i32 = select(true, 40 as i32, 2 as i32)
    if a != 40 as i32 {
        return 1
    }
    a = select(false, 100 as i32, 7 as i32)
    if a != 7 as i32 {
        return 2
    }
    // select on pointers
    var x: u8 = 11
    var y: u8 = 22
    let p: *u8 = select(x < y, &x, &y)
    if *p != 11 as u8 {
        return 3
    }
    // select on u8
    let w: u8 = select(false, 1 as u8, 9 as u8)
    if w != 9 as u8 {
        return 4
    }
    // barrier is the identity
    let b: i32 = barrier(21 as i32)
    if b != 21 as i32 {
        return 5
    }
    // nested
    let v: i32 = select(barrier(b) > 20 as i32, barrier(3 as i32), 0 as i32)
    if v != 3 as i32 {
        return 6
    }
    // secure_zero clears the whole buffer
    var buf: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
    secure_zero(&buf[0], 8 as usize)
    var i: usize = 0
    while i < 8 as usize {
        if buf[i] != 0 as u8 {
            return 7
        }
        i = i + 1 as usize
    }
    // secure_zero with a partial length: the rest stays as it is
    var buf2: [u8; 4] = [9, 9, 9, 9]
    secure_zero(&buf2[0], 2 as usize)
    if buf2[0] != 0 as u8 || buf2[1] != 0 as u8 {
        return 8
    }
    if buf2[2] != 9 as u8 || buf2[3] != 9 as u8 {
        return 9
    }
    return 0
}
