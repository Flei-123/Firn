// expect_exit: 0
// tests/2794_input_padcore.fi -- lib/input/padcore.fi: evdev / joydev byte parsing, SDL mapping lines, kernel default
// mapping, deadzones, hats, XInput, SYN_DROPPED, event ring; 4000 random events against a naive model.
import std.rt
import std.str
import input.padcore

static mut SEED: u64 = 987654321

fn rnd() -> u64 {
    SEED = (SEED * 1103515245 + 12345) % 2147483648
    return SEED / 65536
}

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000001
}

// one struct input_event into buf at slot i
fn put_ev(buf: u64, i: usize, t: u32, c: u32, v: i32) {
    let q: u64 = buf + (i * 24) as u64
    rt.st64(q, 0, 1000 as u64)
    rt.st64(q, 1, 0 as u64)
    rt.st16(q, 8, t as u16)
    rt.st16(q, 9, c as u16)
    rt.st32(q, 5, padcore.u32_of_i32(v))
}

fn feed1(p: *mut padcore.Pad, t: u32, c: u32, v: i32) {
    var b: [u8; 24] = [0 as u8; 24]
    put_ev((&b[0]) as u64, 0, t, c, v)
    check(padcore.pad_feed_evdev(p, (&b[0]) as u64, 24) == 24, 90)
}

fn xbox(p: *mut padcore.Pad) {
    padcore.pad_reset(p)
    padcore.pad_set_identity(p, 3 as u32, 0x045e as u32, 0x028e as u32, 0x0114 as u32)
    // scrambled on purpose: pad_finish_keys has to produce SDL order
    padcore.pad_add_key(p, 318 as u32)
    padcore.pad_add_key(p, 304 as u32)
    padcore.pad_add_key(p, 272 as u32)  // BTN_LEFT: sorts after the joystick range
    padcore.pad_add_key(p, 310 as u32)
    padcore.pad_add_key(p, 305 as u32)
    padcore.pad_add_key(p, 308 as u32)
    padcore.pad_add_key(p, 307 as u32)
    padcore.pad_add_key(p, 311 as u32)
    padcore.pad_add_key(p, 314 as u32)
    padcore.pad_add_key(p, 315 as u32)
    padcore.pad_add_key(p, 316 as u32)
    padcore.pad_add_key(p, 317 as u32)
    padcore.pad_add_key(p, 304 as u32) // doubled: ignored
    padcore.pad_finish_keys(p)
    padcore.pad_set_abs(p, 0 as u32, 0 - 32768, 32767, 128, 0)
    padcore.pad_set_abs(p, 1 as u32, 0 - 32768, 32767, 128, 0)
    padcore.pad_set_abs(p, 2 as u32, 0, 255, 0, 0)
    padcore.pad_set_abs(p, 3 as u32, 0 - 32768, 32767, 128, 0)
    padcore.pad_set_abs(p, 4 as u32, 0 - 32768, 32767, 128, 0)
    padcore.pad_set_abs(p, 5 as u32, 0, 255, 0, 0)
    padcore.pad_set_abs(p, 16 as u32, 0 - 1, 1, 0, 0)
    padcore.pad_set_abs(p, 17 as u32, 0 - 1, 1, 0, 0)
}

// apply one SDL line given as a string
fn sdl(p: *mut padcore.Pad, s: str) -> bool {
    var b: [u8; 512] = [0 as u8; 512]
    let n: usize = s.length()
    var i: usize = 0
    while i < n && i < 512 {
        b[i] = s.chars(i)
        i = i + 1
    }
    return padcore.pad_apply_sdl(p, (&b[0]) as u64, n)
}

fn main() -> i32 {
    var p: padcore.Pad = padcore.pad_new()
    xbox(&p)
    // SDL order: 0x130 0x131 0x133 0x134 0x136 0x137 0x13a 0x13b 0x13c 0x13d 0x13e, then 0x110
    check(padcore.pad_key_index(&p, 304 as u32) == 0 && padcore.pad_key_index(&p, 318 as u32) == 10, 1)
    check(padcore.pad_key_index(&p, 272 as u32) == 11 && p.nkeys == 12, 2)
    // axis numbering skips the hats
    check(padcore.pad_abs_index(&p, 0) == 0 as u32 && padcore.pad_abs_index(&p, 5) == 5 as u32 && padcore.pad_abs_index(&p, 6) == 999 as u32, 3)
    // GUID
    var g: [u8; 40] = [0 as u8; 40]
    padcore.pad_sdl_guid(&p, (&g[0]) as u64)
    var want: [u8; 33] = "030000005e0400008e02000014010000\0"
    var i: usize = 0
    while i < 33 {
        check(g[i] == want[i], 4)
        i = i + 1
    }

    // ---- the SDL line for the Xbox 360 pad
    check(sdl(&p, "030000005e0400008e02000014010000,Xbox 360 Controller,a:b0,b:b1,back:b6,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,dpup:h0.1,guide:b8,leftshoulder:b4,leftstick:b9,lefttrigger:a2,leftx:a0,lefty:a1,rightshoulder:b5,rightstick:b10,righttrigger:a5,rightx:a3,righty:a4,start:b7,x:b2,y:b3,platform:Linux,"), 5)
    check(padcore.pad_mapped(&p), 6)
    padcore.pad_begin(&p)
    feed1(&p, 1 as u32, 304 as u32, 1 as i32) // BTN_SOUTH -> a
    feed1(&p, 1 as u32, 310 as u32, 1 as i32) // BTN_TL -> leftshoulder
    feed1(&p, 3 as u32, 16 as u32, 0 - 1) // hat left
    feed1(&p, 3 as u32, 17 as u32, 1 as i32) // hat down
    feed1(&p, 3 as u32, 2 as u32, 255 as i32) // left trigger full
    feed1(&p, 3 as u32, 0 as u32, 32767 as i32) // left stick full right
    check(!padcore.pad_down(&p, padcore.PB_A), 7) // nothing before SYN_REPORT
    feed1(&p, 0 as u32, 0 as u32, 0 as i32)
    check(padcore.pad_down(&p, padcore.PB_A) && padcore.pad_pressed(&p, padcore.PB_A), 8)
    check(padcore.pad_down(&p, padcore.PB_LSHOULDER) && padcore.pad_down(&p, padcore.PB_DLEFT) && padcore.pad_down(&p, padcore.PB_DDOWN), 9)
    check(!padcore.pad_down(&p, padcore.PB_DUP) && !padcore.pad_down(&p, padcore.PB_DRIGHT) && !padcore.pad_down(&p, padcore.PB_B), 10)
    check(near(padcore.pad_axis(&p, padcore.PA_LT), 1.0) && near(padcore.pad_axis(&p, padcore.PA_LX), 1.0) && near(padcore.pad_axis(&p, padcore.PA_RT), 0.0), 11)
    // a new frame: pressed is cleared, down stays
    padcore.pad_begin(&p)
    check(padcore.pad_down(&p, padcore.PB_A) && !padcore.pad_pressed(&p, padcore.PB_A), 12)
    feed1(&p, 1 as u32, 304 as u32, 0 as i32)
    feed1(&p, 0 as u32, 0 as u32, 0 as i32)
    check(!padcore.pad_down(&p, padcore.PB_A) && padcore.pad_released(&p, padcore.PB_A), 13)
    // auto-repeat (value 2) changes nothing, even for a released key
    feed1(&p, 1 as u32, 304 as u32, 2 as i32)
    feed1(&p, 0 as u32, 0 as u32, 0 as i32)
    check(!padcore.pad_down(&p, padcore.PB_A), 14)
    // deadzone: a stick at 3000/32768 = 0.09 reads exactly 0, at 0.5 it is rescaled
    feed1(&p, 3 as u32, 0 as u32, 3000 as i32)
    feed1(&p, 3 as u32, 1 as u32, 0 as i32)
    feed1(&p, 0 as u32, 0 as u32, 0 as i32)
    check(padcore.pad_axis(&p, padcore.PA_LX) == 0.0, 15)
    feed1(&p, 3 as u32, 0 as u32, 16384 as i32)
    feed1(&p, 0 as u32, 0 as u32, 0 as i32)
    let lx: f64 = padcore.pad_axis(&p, padcore.PA_LX)
    let n0: f64 = (2.0 * (16384.0 + 32768.0)) / 65535.0 - 1.0
    check(near(lx, (n0 - 0.15) / 0.85), 16)
    // a corner of the square (1,1) is clamped to the unit circle
    feed1(&p, 3 as u32, 0 as u32, 32767 as i32)
    feed1(&p, 3 as u32, 1 as u32, 32767 as i32)
    feed1(&p, 0 as u32, 0 as u32, 0 as i32)
    let cx: f64 = padcore.pad_axis(&p, padcore.PA_LX)
    let cy: f64 = padcore.pad_axis(&p, padcore.PA_LY)
    check(near(cx * cx + cy * cy, 1.0) && cx > 0.0 && cy > 0.0, 17)
    // events: drained in order
    var idx: u32 = 0 as u32
    var val: f64 = 0.0
    var seen_a: bool = false
    var seen_ax: bool = false
    var k: u32 = padcore.pad_event_next(&p, &idx, &val)
    while k != 0 as u32 {
        if k == padcore.PE_BUTTON_DOWN && idx == padcore.PB_A as u32 { seen_a = true }
        if k == padcore.PE_AXIS && idx == padcore.PA_LX as u32 { seen_ax = true }
        k = padcore.pad_event_next(&p, &idx, &val)
    }
    check(seen_a && seen_ax, 18)
    // SYN_DROPPED: events up to the next SYN_REPORT are garbage
    feed1(&p, 1 as u32, 305 as u32, 1 as i32)
    feed1(&p, 0 as u32, 3 as u32, 0 as i32)
    feed1(&p, 1 as u32, 307 as u32, 1 as i32) // dropped (garbage)
    feed1(&p, 0 as u32, 0 as u32, 0 as i32) // ends the dropped block, applies nothing
    check(!padcore.pad_down(&p, padcore.PB_B) && !padcore.pad_down(&p, padcore.PB_X), 19)
    feed1(&p, 1 as u32, 305 as u32, 1 as i32)
    feed1(&p, 0 as u32, 0 as u32, 0 as i32)
    check(padcore.pad_down(&p, padcore.PB_B), 20)
    // keys the device does not have are ignored; a partial event at the end is not consumed
    feed1(&p, 1 as u32, 400 as u32, 1 as i32)
    var two: [u8; 48] = [0 as u8; 48]
    put_ev((&two[0]) as u64, 0, 1 as u32, 304 as u32, 1 as i32)
    check(padcore.pad_feed_evdev(&p, (&two[0]) as u64, 47) == 24, 21)

    // ---- an SDL line with an unknown platform / junk is refused; a half-range trigger and a button trigger
    check(!sdl(&p, "030000005e0400008e02000014010000,X,a:b0,platform:Windows,"), 22)
    check(!sdl(&p, "#comment"), 23)
    xbox(&p)
    check(sdl(&p, "030000005e0400008e02000014010000,T,a:b0,righttrigger:+a1,lefttrigger:b1,leftx:a0~,righty:-a4,dpup:b2,platform:Linux,"), 24)
    feed1(&p, 3 as u32, 1 as u32, 32767 as i32) // axis 1 -> righttrigger (+half)
    feed1(&p, 1 as u32, 305 as u32, 1 as i32) // b1 -> lefttrigger as a button -> 1.0
    feed1(&p, 3 as u32, 0 as u32, 32767 as i32) // leftx inverted
    feed1(&p, 3 as u32, 4 as u32, 0 - 32768) // righty: -half
    feed1(&p, 1 as u32, 307 as u32, 1 as i32) // dpup from a button
    feed1(&p, 0 as u32, 0 as u32, 0 as i32)
    check(near(padcore.pad_axis(&p, padcore.PA_RT), 1.0) && near(padcore.pad_axis(&p, padcore.PA_LT), 1.0), 25)
    check(padcore.pad_axis(&p, padcore.PA_LX) < 0.0 - 0.99 && padcore.pad_axis(&p, padcore.PA_RY) > 0.99, 26)
    check(padcore.pad_down(&p, padcore.PB_DUP), 27)

    // ---- joydev: index -> code through the maps
    xbox(&p)
    padcore.pad_apply_default(&p)
    var bm: [u16; 4] = [304 as u16, 305 as u16, 310 as u16, 0 as u16]
    var am: [u8; 4] = [0 as u8, 1 as u8, 16 as u8, 17 as u8]
    padcore.pad_js_maps(&p, 3, (&bm[0]) as u64, 4, (&am[0]) as u64)
    var js: [u8; 24] = [0 as u8; 24]
    // button 1 down (BTN_EAST -> b), axis 2 (hat0x) = -1 -> dpleft, axis 0 = 32767 -> lx
    rt.st32((&js[0]) as u64, 0, 5 as u32)
    rt.st16((&js[0]) as u64, 2, 1 as u16)
    js[6] = 1 as u8
    js[7] = 1 as u8
    rt.st16((&js[0]) as u64, 6, 65535 as u16) // -1
    js[14] = 2 as u8
    js[15] = 2 as u8
    rt.st16((&js[0]) as u64, 10, 32767 as u16)
    js[22] = 130 as u8 // 0x80 | axis: the INIT flag is ignored as a flag
    js[23] = 0 as u8
    check(padcore.pad_feed_joydev(&p, (&js[0]) as u64, 24) == 24, 28)
    check(padcore.pad_down(&p, padcore.PB_B) && padcore.pad_down(&p, padcore.PB_DLEFT) && near(padcore.pad_axis(&p, padcore.PA_LX), 1.0), 29)

    // ---- XInput
    var xp: padcore.Pad = padcore.pad_new()
    padcore.pad_feed_xinput(&xp, (0x1000 | 0x0001 | 0x0100) as u32, 255 as u32, 0 as u32, 32767 as i32, 0 as i32, 0 as i32, 0 - 32768)
    check(padcore.pad_down(&xp, padcore.PB_A) && padcore.pad_down(&xp, padcore.PB_DUP) && padcore.pad_down(&xp, padcore.PB_LSHOULDER), 30)
    check(near(padcore.pad_axis(&xp, padcore.PA_LT), 1.0) && near(padcore.pad_axis(&xp, padcore.PA_LX), 1.0), 31)
    check(near(padcore.pad_axis(&xp, padcore.PA_RY), 1.0), 32) // XInput y is up: -32768 -> down = +1
    check(padcore.pad_pressed(&xp, padcore.PB_A), 33)

    // ---- 4000 random events against a model (kernel default mapping)
    xbox(&p)
    padcore.pad_apply_default(&p)
    var mkey: [u8; 12] = [0 as u8; 12]
    var mabs: [i64; 8] = [0; 8]
    var codes: [u32; 11] = [304 as u32, 305 as u32, 307 as u32, 308 as u32, 310 as u32, 311 as u32, 314 as u32, 315 as u32, 316 as u32, 317 as u32, 318 as u32]
    var acodes: [u32; 8] = [0 as u32, 1 as u32, 2 as u32, 3 as u32, 4 as u32, 5 as u32, 16 as u32, 17 as u32]
    var round: usize = 0
    while round < 4000 {
        let r: u64 = rnd() % 10
        if r < 4 {
            let ki: usize = (rnd() % 11) as usize
            let st: i32 = (rnd() % 3) as i32 // 0 up, 1 down, 2 repeat
            feed1(&p, 1 as u32, codes[ki], st)
            if st == 0 as i32 { mkey[ki] = 0 as u8 }
            if st == 1 as i32 { mkey[ki] = 1 as u8 }
        } else if r < 8 {
            let ai: usize = (rnd() % 8) as usize
            var v: i64 = 0
            if ai < 2 || ai == 3 || ai == 4 {
                v = (rnd() % 65536) as i64 - 32768
            } else if ai == 2 || ai == 5 {
                v = (rnd() % 256) as i64
            } else {
                v = (rnd() % 3) as i64 - 1
            }
            feed1(&p, 3 as u32, acodes[ai], v as i32)
            mabs[ai] = v
        } else {
            feed1(&p, 0 as u32, 0 as u32, 0 as i32)
            // model: buttons
            var want_mask: u32 = 0 as u32
            // slot order of the kernel default mapping
            if mkey[0] != 0 as u8 { want_mask = want_mask | 1 as u32 }       // a  = BTN_SOUTH
            if mkey[1] != 0 as u8 { want_mask = want_mask | 2 as u32 }       // b  = BTN_EAST
            if mkey[2] != 0 as u8 { want_mask = want_mask | 4 as u32 }       // x  = BTN_NORTH
            if mkey[3] != 0 as u8 { want_mask = want_mask | 8 as u32 }       // y  = BTN_WEST
            if mkey[6] != 0 as u8 { want_mask = want_mask | 16 as u32 }      // back
            if mkey[8] != 0 as u8 { want_mask = want_mask | 32 as u32 }      // guide
            if mkey[7] != 0 as u8 { want_mask = want_mask | 64 as u32 }      // start
            if mkey[9] != 0 as u8 { want_mask = want_mask | 128 as u32 }     // leftstick
            if mkey[10] != 0 as u8 { want_mask = want_mask | 256 as u32 }    // rightstick
            if mkey[4] != 0 as u8 { want_mask = want_mask | 512 as u32 }     // leftshoulder
            if mkey[5] != 0 as u8 { want_mask = want_mask | 1024 as u32 }    // rightshoulder
            if mabs[7] < 0 { want_mask = want_mask | 2048 as u32 }           // dpup: hat y < 0
            if mabs[7] > 0 { want_mask = want_mask | 4096 as u32 }           // dpdown
            if mabs[6] < 0 { want_mask = want_mask | 8192 as u32 }           // dpleft
            if mabs[6] > 0 { want_mask = want_mask | 16384 as u32 }          // dpright
            check(p.buttons == want_mask, 40)
            // model: left stick (radial deadzone 0.15) and a trigger (threshold 0.05)
            let sx: f64 = (2.0 * ((mabs[0] + 32768) as f64)) / 65535.0 - 1.0
            let sy: f64 = (2.0 * ((mabs[1] + 32768) as f64)) / 65535.0 - 1.0
            let m: f64 = __sqrt(sx * sx + sy * sy)
            var ex: f64 = 0.0
            var ey: f64 = 0.0
            if m > 0.15 {
                var mm: f64 = m
                if mm > 1.0 { mm = 1.0 }
                let f: f64 = ((mm - 0.15) / 0.85) / m
                ex = sx * f
                ey = sy * f
            }
            check(near(padcore.pad_axis(&p, padcore.PA_LX), ex) && near(padcore.pad_axis(&p, padcore.PA_LY), ey), 41)
            var tv: f64 = (mabs[2] as f64) / 255.0
            if tv < 0.05 { tv = 0.0 } else { tv = (tv - 0.05) / 0.95 }
            check(near(padcore.pad_axis(&p, padcore.PA_LT), tv), 42)
        }
        round = round + 1
    }
    return 0
}
