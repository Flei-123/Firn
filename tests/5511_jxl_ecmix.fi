// expect_exit: 0
import jxl.jxl
import std.fs
import std.io
import std.math
import std.rt

static mut failures: i32 = 0
static mut alpha_max: i32 = 0
static mut rgb_psnr: f64 = 0.0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn body_offset(d: *mut rt.Buf, n: usize, lines: u32) -> usize {
    var nl: u32 = 0
    var i: usize = 0
    while i < n && nl < lines {
        if rt.ld8(rt.buf_ptr(d), i) == 10 {
            nl = nl + 1
        }
        i = i + 1
    }
    return i
}

fn measure(path: str, ref_path: str) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    var ref: rt.Buf = rt.buf_new()
    let rn: usize = fs.read_file(ref_path, &ref) catch 0
    check(n != 0 && rn != 0)
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let ok: bool = jxl.jxl_decode(rt.buf_ptr(&data), n, &pic) catch false
    check(ok)
    alpha_max = 0 - 1
    rgb_psnr = 0.0
    if ok {
        let total: usize = (pic.width as usize) * (pic.height as usize)
        let off: usize = body_offset(&ref, rn, 7)
        check(pic.channels == 4 && pic.bytes_per_sample == 1 && pic.size == total * 4 && rn >= off + total * 4)
        if pic.size == total * 4 && rn >= off + total * 4 {
            let base: u64 = rt.buf_ptr(&ref) + (off as u64)
            var sum: f64 = 0.0
            var amax: i32 = 0
            var i: usize = 0
            while i < total {
                var k: usize = 0
                while k < 4 {
                    let e: i32 = (rt.ld8(pic.data, i * 4 + k) as i32) - (rt.ld8(base, i * 4 + k) as i32)
                    if k < 3 {
                        sum = sum + ((e * e) as f64)
                    } else {
                        var a: i32 = e
                        if a < 0 {
                            a = 0 - a
                        }
                        if a > amax {
                            amax = a
                        }
                    }
                    k = k + 1
                }
                i = i + 1
            }
            alpha_max = amax
            rgb_psnr = 99.0
            if sum > 0.0 {
                rgb_psnr = 10.0 * math.log10(255.0 * 255.0 * ((total * 3) as f64) / sum)
            }
        }
    }
    jxl.jxl_picture_free(&pic)
    rt.buf_free(&data)
    rt.buf_free(&ref)
}

fn expect(path: str, ref_path: str, max_alpha: i32, min_psnr: f64) {
    measure(path, ref_path)
    check(alpha_max >= 0 && alpha_max <= max_alpha)
    check(rgb_psnr >= min_psnr)
}

fn main() -> i32 {
    expect("tests/data/jxl/ecmix/rgba300_vd_c1_e2.jxl", "tests/data/jxl/ecmix/rgba300_vd_c1_e2.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba300_md_c1_e2.jxl", "tests/data/jxl/ecmix/rgba300_md_c1_e2.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba300_vd_c1_e4.jxl", "tests/data/jxl/ecmix/rgba300_vd_c1_e4.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba300_md_c1_e4.jxl", "tests/data/jxl/ecmix/rgba300_md_c1_e4.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba300_vd_c1_e8.jxl", "tests/data/jxl/ecmix/rgba300_vd_c1_e8.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba300_md_c1_e8.jxl", "tests/data/jxl/ecmix/rgba300_md_c1_e8.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba300_vd_c2_e4.jxl", "tests/data/jxl/ecmix/rgba300_vd_c2_e4.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba300_md_c2_e4.jxl", "tests/data/jxl/ecmix/rgba300_md_c2_e4.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba300_vd_c2_e8.jxl", "tests/data/jxl/ecmix/rgba300_vd_c2_e8.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba300_md_c2_e8.jxl", "tests/data/jxl/ecmix/rgba300_md_c2_e8.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba300_vd_c4_e8.jxl", "tests/data/jxl/ecmix/rgba300_vd_c4_e8.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba300_md_c4_e8.jxl", "tests/data/jxl/ecmix/rgba300_md_c4_e8.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba64_vd_c1_e2.jxl", "tests/data/jxl/ecmix/rgba64_vd_c1_e2.pam", 1, 40.0)
    expect("tests/data/jxl/ecmix/rgba64_md_c2_e4.jxl", "tests/data/jxl/ecmix/rgba64_md_c2_e4.pam", 1, 40.0)
    return failures
}
