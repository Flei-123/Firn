// expect_exit: 42
// std.time.sleep_ms: the monotonic clock sees at least the time slept.
import std.time

fn main() -> i32 {
    let a: u64 = time.monotonic_ns()
    time.sleep_ms(30)
    let b: u64 = time.monotonic_ns()
    if b - a < 30000000 { return 1 as i32 }
    time.sleep_ms(0)
    return 42 as i32
}
