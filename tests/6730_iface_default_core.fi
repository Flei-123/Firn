// expect_exit: 0
interface Shape {
    fn area(*self) -> i64
    fn double_area(*self) -> i64 {
        return self.area() * 2
    }
    fn describe(*self, k: i64) -> i64 {
        return self.double_area() + k
    }
    fn bigger_than(*self, o: *Self) -> bool {
        return self.area() > o.area()
    }
}

interface Named {
    fn id(*self) -> i64
    fn tag(*self) -> i64 { return self.id() + 100 }
}

struct Sq { s: i64 }
struct Rect { w: i64, h: i64 }

impl Shape for Sq {
    fn area(*self) -> i64 { return (*self).s * (*self).s }
}

impl Shape for Rect {
    fn area(*self) -> i64 { return (*self).w * (*self).h }
    fn describe(*self, k: i64) -> i64 { return 1000 + k }
}

impl Named for Sq {
    fn id(*self) -> i64 { return (*self).s }
}

impl Named for Rect {
    fn id(*self) -> i64 { return (*self).w }
    fn tag(*self) -> i64 { return 7 }
}

fn through_dyn(x: dyn Shape) -> i64 {
    return x.double_area() + x.describe(1)
}

fn main() -> i32 {
    let a: Sq = Sq { s: 3 }
    let b: Rect = Rect { w: 2, h: 5 }
    let c: Rect = Rect { w: 1, h: 1 }
    if a.double_area() != 18 { return 1 }
    if a.describe(1) != 19 { return 2 }
    if b.double_area() != 20 { return 3 }
    if b.describe(1) != 1001 { return 4 }
    if !b.bigger_than(&c) { return 5 }
    if a.bigger_than(&a) { return 6 }
    if a.tag() != 103 { return 7 }
    if b.tag() != 7 { return 8 }
    let d: dyn Shape = (&a) as dyn Shape
    if d.double_area() != 18 { return 9 }
    if through_dyn((&b) as dyn Shape) != 1021 { return 10 }
    if through_dyn((&a) as dyn Shape) != 37 { return 11 }
    return 0
}
