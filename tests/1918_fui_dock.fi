// expect_exit: 42
// tests/1918_fui_dock.fi -- lib/fui/dock.fi (OpenPlan LIB-005): the docked
// panels' rectangles, dragging a splitter and a tab, hiding, and saving
// and loading the arrangement; the free-standing Split.
import fui.dock
import fui.layout
import std.rt
import std.str

fn is(r: layout.Rect, x: i64, y: i64, w: i64, h: i64) -> bool {
    return r.x == x && r.y == y && r.w == w && r.h == h
}

fn main() -> i32 {
    var d: dock.Dock = dock.dock_new()
    dock.dock_set_metrics(&d, 20, 4, 60, 100)
    let pages: u32 = dock.dock_add(&d, 11, dock.AREA_LEFT, "Pages")
    let devices: u32 = dock.dock_add(&d, 12, dock.AREA_LEFT, "Devices")
    let props: u32 = dock.dock_add(&d, 13, dock.AREA_RIGHT, "Properties")
    let msgs: u32 = dock.dock_add(&d, 14, dock.AREA_BOTTOM, "Messages")
    dock.dock_layout(&d, 0, 0, 1000, 600)
    // --- A. the rectangles: left 240, right 260, bottom 180, bars 4
    if !is(dock.dock_area_rect(&d, dock.AREA_LEFT), 0, 0, 240, 600) { return 1 as i32 }
    if !is(dock.dock_splitter(&d, dock.AREA_LEFT), 240, 0, 4, 600) { return 2 as i32 }
    if !is(dock.dock_area_rect(&d, dock.AREA_RIGHT), 740, 0, 260, 600) { return 3 as i32 }
    if !is(dock.dock_splitter(&d, dock.AREA_RIGHT), 736, 0, 4, 600) { return 4 as i32 }
    // bottom under the middle column: x 244 .. 736
    if !is(dock.dock_area_rect(&d, dock.AREA_BOTTOM), 244, 420, 492, 180) { return 5 as i32 }
    if !is(dock.dock_splitter(&d, dock.AREA_BOTTOM), 244, 416, 492, 4) { return 6 as i32 }
    // the centre has no panels: no tab strip
    if !is(dock.dock_center(&d), 244, 0, 492, 416) { return 7 as i32 }
    // two tabs share the left strip; the first panel is active
    if !is(dock.dock_tab(&d, pages), 0, 0, 120, 20) || !is(dock.dock_tab(&d, devices), 120, 0, 120, 20) { return 8 as i32 }
    if !is(dock.dock_content(&d, pages), 0, 20, 240, 580) { return 9 as i32 }
    if dock.dock_content(&d, devices).w != 0 { return 10 as i32 } // not the active tab

    // --- B. a click on the second tab makes it active
    if dock.dock_mouse_down(&d, 150, 10) != dock.HIT_TAB { return 20 as i32 }
    dock.dock_mouse_up(&d, 150, 10)
    if dock.dock_active(&d, dock.AREA_LEFT) != devices as i64 || dock.dock_content(&d, devices).w != 240 { return 21 as i32 }
    if dock.dock_mouse_down(&d, 500, 200) != dock.HIT_CENTER { return 22 as i32 }
    if dock.dock_mouse_down(&d, 800, 300) != dock.HIT_CONTENT { return 23 as i32 }

    // --- C. dragging the left splitter by 60 px, and past the limits
    if dock.dock_mouse_down(&d, 241, 300) != dock.HIT_SPLITTER { return 30 as i32 }
    dock.dock_mouse_drag(&d, 301, 300)
    dock.dock_mouse_up(&d, 301, 300)
    if dock.dock_size(&d, dock.AREA_LEFT) != 300 || dock.dock_area_rect(&d, dock.AREA_LEFT).w != 300 { return 31 as i32 }
    dock.dock_mouse_down(&d, 301, 300)
    dock.dock_mouse_drag(&d, 5, 300) // below the minimum
    dock.dock_mouse_up(&d, 5, 300)
    if dock.dock_size(&d, dock.AREA_LEFT) != 60 { return 32 as i32 }
    // the bottom splitter upwards by 100
    dock.dock_mouse_down(&d, 400, 417)
    dock.dock_mouse_drag(&d, 400, 317)
    dock.dock_mouse_up(&d, 400, 317)
    if dock.dock_size(&d, dock.AREA_BOTTOM) != 280 { return 33 as i32 }

    // --- D. dragging the Properties tab into the bottom area
    let tr: layout.Rect = dock.dock_tab(&d, props)
    if dock.dock_mouse_down(&d, tr.x + 5, tr.y + 5) != dock.HIT_TAB { return 40 as i32 }
    dock.dock_mouse_drag(&d, tr.x + 7, tr.y + 5) // two pixels: still a click
    if dock.dock_drop_hint(&d) != dock.AREA_NONE { return 41 as i32 }
    let bot: layout.Rect = dock.dock_area_rect(&d, dock.AREA_BOTTOM)
    dock.dock_mouse_drag(&d, bot.x + 50, bot.y + 50)
    if dock.dock_drop_hint(&d) != dock.AREA_BOTTOM { return 42 as i32 }
    if !dock.dock_mouse_up(&d, bot.x + 50, bot.y + 50) { return 43 as i32 }
    let pi: i64 = dock.dock_panel_of(&d, 13)
    if pi < 0 || dock.dock_area_of(&d, pi as u32) != dock.AREA_BOTTOM || dock.dock_active(&d, dock.AREA_BOTTOM) != pi { return 44 as i32 }
    // the right area is empty now and takes no space
    if dock.dock_area_rect(&d, dock.AREA_RIGHT).w != 0 { return 45 as i32 }
    if dock.dock_center(&d).x + dock.dock_center(&d).w != 1000 { return 46 as i32 }

    // --- E. hiding: Messages hidden, Properties stays active at the bottom
    let mi: u32 = dock.dock_panel_of(&d, 14) as u32
    dock.dock_set_visible(&d, mi, false)
    dock.dock_layout(&d, 0, 0, 1000, 600)
    if dock.dock_tab(&d, mi).w != 0 || dock.dock_active(&d, dock.AREA_BOTTOM) != dock.dock_panel_of(&d, 13) { return 50 as i32 }

    // --- F. saving and loading
    var saved: rt.Buf = rt.buf_new()
    dock.dock_layout_save(&d, &saved)
    let text: str = str { p: rt.buf_data(&saved), n: rt.buf_len(&saved) }
    if !text.contains("\"version\":1") || !text.contains("\"left\":60") || !text.contains("\"area\":\"bottom\"") { return 60 as i32 }
    var e: dock.Dock = dock.dock_new()
    dock.dock_set_metrics(&e, 20, 4, 60, 100)
    dock.dock_add(&e, 14, dock.AREA_BOTTOM, "Messages")
    dock.dock_add(&e, 13, dock.AREA_RIGHT, "Properties")
    dock.dock_add(&e, 12, dock.AREA_LEFT, "Devices")
    dock.dock_add(&e, 11, dock.AREA_LEFT, "Pages")
    dock.dock_add(&e, 99, dock.AREA_RIGHT, "New in this version")
    if !dock.dock_layout_load(&e, rt.buf_ptr(&saved), rt.buf_len(&saved)) { return 61 as i32 }
    dock.dock_layout(&e, 0, 0, 1000, 600)
    var again: rt.Buf = rt.buf_new()
    dock.dock_layout_save(&e, &again)
    // the loaded arrangement saves the same -- plus the panel it did not know
    let t2: str = str { p: rt.buf_data(&again), n: rt.buf_len(&again) }
    if !t2.contains(text.part(0, text.n - 2)) && !t2.starts_with(text.part(0, 60)) { return 62 as i32 }
    if dock.dock_area_of(&e, dock.dock_panel_of(&e, 13) as u32) != dock.AREA_BOTTOM { return 63 as i32 }
    if dock.dock_is_visible(&e, dock.dock_panel_of(&e, 14) as u32) { return 64 as i32 }
    if dock.dock_active(&e, dock.AREA_LEFT) != dock.dock_panel_of(&e, 12) { return 65 as i32 }
    if dock.dock_area_of(&e, dock.dock_panel_of(&e, 99) as u32) != dock.AREA_RIGHT { return 66 as i32 }
    if dock.dock_size(&e, dock.AREA_BOTTOM) != 280 { return 67 as i32 }
    // broken or foreign files change nothing
    let bad1: str = "{\"version\":2,\"panels\":[]}"
    let bad2: str = "{\"version\":1,\"panels\":[{\"id\":13,\"area\":\"top\"}]}"
    let bad3: str = "not json"
    if dock.dock_layout_load(&e, bad1.p as u64, bad1.n) || dock.dock_layout_load(&e, bad2.p as u64, bad2.n) ||
    dock.dock_layout_load(&e, bad3.p as u64, bad3.n) { return 68 as i32 }
    if dock.dock_area_of(&e, dock.dock_panel_of(&e, 13) as u32) != dock.AREA_BOTTOM { return 69 as i32 }

    // --- G. a small window squeezes the sides, the centre keeps its minimum
    var f: dock.Dock = dock.dock_new()
    dock.dock_set_metrics(&f, 20, 4, 60, 100)
    dock.dock_add(&f, 1, dock.AREA_LEFT, "L")
    dock.dock_add(&f, 2, dock.AREA_RIGHT, "R")
    dock.dock_layout(&f, 0, 0, 400, 300)
    if dock.dock_center(&f).w < 100 { return 70 as i32 }
    if dock.dock_area_rect(&f, dock.AREA_LEFT).w < 60 || dock.dock_area_rect(&f, dock.AREA_RIGHT).w < 60 { return 71 as i32 }

    // --- H. Split
    var s: dock.Split = dock.split_new(dock.SPLIT_H, 300)
    dock.split_layout(&s, 10, 10, 800, 400)
    if !is(dock.split_first(&s), 10, 10, 300, 400) || !is(dock.split_bar(&s), 310, 10, 5, 400) || !is(dock.split_second(&s), 315, 10, 495, 400) { return 80 as i32 }
    if !dock.split_mouse_down(&s, 312, 100) { return 81 as i32 }
    dock.split_mouse_drag(&s, 412, 100)
    dock.split_mouse_up(&s)
    if dock.split_first(&s).w != 400 || dock.split_ratio(&s) != 500 { return 82 as i32 }
    dock.split_mouse_down(&s, 412, 100)
    dock.split_mouse_drag(&s, 2000, 100) // clamped: the second pane keeps 40
    if dock.split_second(&s).w != 40 { return 83 as i32 }
    var v: dock.Split = dock.split_new(dock.SPLIT_V, 100)
    dock.split_layout(&v, 0, 0, 200, 300)
    if !is(dock.split_second(&v), 0, 105, 200, 195) { return 84 as i32 }
    return 42
}
