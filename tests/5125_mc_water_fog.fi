// expect_exit: 0
import std.rt
import mc.mc_water_fog

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.001
}

fn main() -> i32 {
    check(near(mc_water_fog.wfog_vision(0), 0.0), 1)
    check(near(mc_water_fog.wfog_vision(100), 0.6), 2)
    check(near(mc_water_fog.wfog_vision(350), 0.6 + 0.4 * 0.5), 3)
    check(near(mc_water_fog.wfog_vision(600), 1.0), 4)
    check(near(mc_water_fog.wfog_vision(5000), 1.0), 5)
    check(near(mc_water_fog.wfog_end(0), 24.0), 6)
    check(near(mc_water_fog.wfog_end(600), 96.0), 7)
    let a: mc_water_fog.ViewFog = mc_water_fog.wfog_view(false, 0, 256, 100.0, 200.0, 1 as u32, 2 as u32, 3 as u32, 329011 as u32)
    check(!a.under && near(a.start, 100.0) && near(a.end, 200.0) && a.r == 1 as u32 && a.b == 3 as u32, 8)
    let b: mc_water_fog.ViewFog = mc_water_fog.wfog_view(true, 600, 256, 100.0, 200.0, 1 as u32, 2 as u32, 3 as u32, 329011 as u32)
    check(b.under && near(b.start, 0.0 - 8.0) && near(b.end, 96.0) && b.r == 5 as u32 && b.g == 5 as u32 && b.b == 51 as u32, 9)
    let n: mc_water_fog.ViewFog = mc_water_fog.wfog_view(true, 600, 0, 100.0, 200.0, 1 as u32, 2 as u32, 3 as u32, 329011 as u32)
    check(n.b < 10 as u32 && n.b > 0 as u32, 10)
    var wc: mc_water_fog.WaterFogColor = mc_water_fog.wfc_new()
    check(mc_water_fog.wfc_step(&wc, 329011 as u32, 1000 as u64) == 329011 as u32, 11)
    check(mc_water_fog.wfc_step(&wc, 329011 as u32, 9000 as u64) == 329011 as u32, 12)
    check(mc_water_fog.wfc_step(&wc, 2302743 as u32, 10000 as u64) == 329011 as u32, 13)
    check(mc_water_fog.wfc_step(&wc, 2302743 as u32, 10000 as u64) == 329011 as u32, 14)
    let mid: u32 = mc_water_fog.wfc_step(&wc, 2302743 as u32, 12500 as u64)
    check(((mid >> 16 as u32) & 255 as u32) == 20 as u32 && (mid & 255 as u32) == 37 as u32, 15)
    check(mc_water_fog.wfc_step(&wc, 2302743 as u32, 15000 as u64) == 2302743 as u32, 16)
    check(mc_water_fog.wfc_step(&wc, 2302743 as u32, 99000 as u64) == 2302743 as u32, 17)
    check(near(mc_water_fog.wfog_fov(70.0, true), 70.0 * 0.85714287), 18)
    check(near(mc_water_fog.wfog_fov(70.0, false), 70.0), 19)
    if g_fail == 0 { return 0 }
    return 1
}
