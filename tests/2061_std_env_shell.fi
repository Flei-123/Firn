// expect_exit: 0
// tests/2061_std_env_shell.fi -- std.env and std.shell, on Linux and (the
// parts marked W) on Windows. The program starts ITSELF as a child with a
// controlled environment (`argv[0] --child <mode>`), so the answers do not
// depend on the machine it runs on.
//
// A  env: get / has / list_into / find_executable
// B  shell: the well known directories (HOME, XDG_*, %APPDATA% ...) from a given environment
// C  shell: refusals (open_url of anything that is not a plain URL, open_path of a missing path)
// D  shell: open_url / open_path / reveal hand the argument over EXACTLY (Linux: a fake `xdg-open`)
// E  shell: find_java / java_major_version with fake `java` scripts (Linux)
import std.rt
import std.str
import std.env
import std.fs
import std.shell
import std.process

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn read_text(path: str) -> str {
    var b: rt.Buf = rt.buf_new()
    fs.read_file(path, &b) catch 0
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn eq(b: *mut rt.Buf, s: str) -> bool {
    if rt.buf_len(b) != s.length() {
        return false
    }
    return rt.mem_eq(rt.buf_ptr(b), s.p as u64, s.length())
}

fn terr(e: ProcError) -> i32 {
    return 1000
}

fn child_main(start: u64) -> i32 {
    let mode: str = arg(start, 2)
    if mode == "dirs" {
        say(shell.home_dir())
        say("\n")
        say(shell.config_dir())
        say("\n")
        say(shell.data_dir())
        say("\n")
        say(shell.cache_dir())
        say("\n")
        say(shell.temp_dir())
        say("\n")
        say(shell.minecraft_dir())
        say("\n")
        return 0
    }
    if mode == "open" {
        // opens whatever the second argument says
        var ok: bool = false
        if arg(start, 3) == "url" {
            ok = shell.open_url(arg(start, 4)) catch false
        } else if arg(start, 3) == "path" {
            ok = shell.open_path(arg(start, 4)) catch false
        } else {
            ok = shell.reveal_in_file_manager(arg(start, 4)) catch false
        }
        if ok {
            return 0
        }
        return 1
    }
    if mode == "java" {
        let j: str = shell.find_java(false)
        say(j)
        say("|")
        var v: rt.Buf = rt.buf_new()
        rt.buf_push_dec_i64(&v, shell.java_major_version(j) as i64)
        say(str { p: rt.buf_data(&v), n: rt.buf_len(&v) })
        return 0
    }
    return 99
}

// runs this program as the child `mode ...` with the environment `vars`
// (pairs of strings; the environment is CLEARED first when `clear`) and
// returns what it printed
fn run_child(self_path: str, mode: str, a3: str, a4: str, clear: bool, k1: str, v1: str,
    k2: str, v2: str, k3: str, v3: str, k4: str, v4: str, out: *mut rt.Buf) -> i32 {
    var c: process.Command = process.command(self_path)
    process.add_arg(&c, "--child")
    process.add_arg(&c, mode)
    if a3.length() > 0 { process.add_arg(&c, a3) }
    if a4.length() > 0 { process.add_arg(&c, a4) }
    if clear { process.clear_env(&c) }
    if k1.length() > 0 { process.set_env(&c, k1, v1) }
    if k2.length() > 0 { process.set_env(&c, k2, v2) }
    if k3.length() > 0 { process.set_env(&c, k3, v3) }
    if k4.length() > 0 { process.set_env(&c, k4, v4) }
    var err: rt.Buf = rt.buf_new()
    let code: i32 = process.run_capture(&c, out, &err, 30000) catch | e | terr(e)
    process.command_free(&c)
    rt.buf_free(&err)
    return code
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) >= 3 && arg(start, 1) == "--child" {
        return child_main(start)
    }
    let self_path: str = arg(start, 0)
    let win: bool = env.PATH_SEP == 59 as u8

    // --- A. env
    if !env.has("PATH") { return 1 as i32 }
    if env.has("FIRN_2061_NOT_SET") { return 2 as i32 }
    var v: rt.Buf = rt.buf_new()
    if !env.get_into("PATH", &v) { return 3 as i32 }
    if rt.buf_len(&v) == 0 { return 4 as i32 }
    let pv: str = str { p: rt.buf_data(&v), n: rt.buf_len(&v) }
    if env.get("PATH") != pv { return 5 as i32 }
    if env.get("FIRN_2061_NOT_SET") != "" { return 6 as i32 }
    if env.get_into("A=B", &v) || env.get_into("", &v) { return 7 as i32 }
    var all: rt.Buf = rt.buf_new()
    let cnt: usize = env.list_into(&all)
    if cnt < 1 { return 8 as i32 }
    // the entries are "K=V\0": count the zero octets
    var zeros: usize = 0
    var i: usize = 0
    while i < rt.buf_len(&all) {
        if rt.buf_at(&all, i) == 0 as u8 { zeros = zeros + 1 }
        i = i + 1
    }
    if zeros != cnt { return 9 as i32 }
    var found: rt.Buf = rt.buf_new()
    if win {
        if !env.find_executable(self_path, &found) { return 10 as i32 }
    } else {
        if !env.find_executable("sh", &found) { return 11 as i32 }
        if rt.buf_len(&found) < 4 || rt.buf_at(&found, 0) != 47 as u8 { return 12 as i32 }
        rt.buf_clear(&found)
        if !env.find_executable("/bin/sh", &found) { return 13 as i32 }
        if env.find_executable("/tmp", &found) { return 14 as i32 }
        if env.find_executable("/etc/passwd", &found) { return 15 as i32 }
    }
    if env.find_executable("firn_2061_no_such_program", &found) { return 16 as i32 }
    if env.find_executable("", &found) { return 17 as i32 }
    if shell.find_in_path("firn_2061_no_such_program") != "" { return 18 as i32 }
    if win {
        if shell.find_in_path(self_path) == "" { return 19 as i32 }
    } else {
        if shell.find_in_path("sh") == "" { return 19 as i32 }
    }

    // --- B. the well known directories
    var out: rt.Buf = rt.buf_new()
    if win {
        let r: i32 = run_child(self_path, "dirs", "", "", true, "USERPROFILE", "C:\\h",
            "APPDATA", "C:\\h\\Roam", "LOCALAPPDATA", "C:\\h\\Loc", "TEMP", "C:\\h\\Tmp", &out)
        if r != 0 { return 20 as i32 }
        if !eq(&out, "C:\\h\nC:\\h\\Roam\nC:\\h\\Loc\nC:\\h\\Loc\nC:\\h\\Tmp\nC:\\h\\Roam\\.minecraft\n") {
            return 21 as i32
        }
    } else {
        let r: i32 = run_child(self_path, "dirs", "", "", true, "HOME", "/h", "", "", "", "", "", "", &out)
        if r != 0 { return 20 as i32 }
        if !eq(&out, "/h\n/h/.config\n/h/.local/share\n/h/.cache\n/tmp\n/h/.minecraft\n") { return 21 as i32 }
        rt.buf_clear(&out)
        let r2: i32 = run_child(self_path, "dirs", "", "", true, "HOME", "/h", "XDG_CONFIG_HOME", "/x/cfg",
            "XDG_DATA_HOME", "relative/is/ignored", "TMPDIR", "/var/tmp/u", &out)
        if r2 != 0 { return 22 as i32 }
        if !eq(&out, "/h\n/x/cfg\n/h/.local/share\n/h/.cache\n/var/tmp/u\n/h/.minecraft\n") { return 23 as i32 }
        // no HOME at all: empty answers, no crash
        rt.buf_clear(&out)
        let r3: i32 = run_child(self_path, "dirs", "", "", true, "", "", "", "", "", "", "", "", &out)
        if r3 != 0 { return 24 as i32 }
        if !eq(&out, "\n\n\n\n/tmp\n\n") { return 25 as i32 }
    }

    // --- C. refusals
    let bad1: bool = shell.open_url("not a url") catch false
    if bad1 { return 30 as i32 }
    let bad2: bool = shell.open_url("--help") catch false
    if bad2 { return 31 as i32 }
    let bad3: bool = shell.open_url("javascript:alert(1)") catch false
    if bad3 { return 32 as i32 }
    let bad4: bool = shell.open_url("http://exa mple.org") catch false
    if bad4 { return 33 as i32 }
    let bad5: bool = shell.open_url("") catch false
    if bad5 { return 34 as i32 }
    let bad6: bool = shell.open_url("https://x\ny") catch false
    if bad6 { return 35 as i32 }
    let bad7: bool = shell.open_path("/firn_2061/does/not/exist") catch false
    if bad7 { return 36 as i32 }
    let bad8: bool = shell.reveal_in_file_manager("") catch false
    if bad8 { return 37 as i32 }

    if win {
        return 0
    }

    // --- D. a fake xdg-open writes down what it was given
    let root: str = fs.path_join(fs.temp_dir(), "firn_2061_dir")
    fs.remove_tree(root) catch false
    fs.mkdir_all(root + "/bin") catch false
    let log: str = root + "/log"
    var sc: rt.Buf = rt.buf_new()
    let body: str = "#!/bin/sh\nprintf '%s\\n' \"$#\" \"$@\" > " + log + "\n"
    rt.buf_push_bytes(&sc, body.p as u64, body.length())
    fs.write_file(root + "/bin/xdg-open", rt.buf_ptr(&sc), rt.buf_len(&sc)) catch 0
    var cp: rt.Buf = rt.buf_new()
    let cps: str = root + "/bin/xdg-open"
    rt.buf_push_bytes(&cp, cps.p as u64, cps.length())
    rt.buf_push(&cp, 0 as u8)
    syscall(90, rt.buf_ptr(&cp) as i64, 493, 0, 0, 0, 0)
    let fakepath: str = root + "/bin:/usr/bin:/bin"

    let url: str = "https://example.org/a?b=1&c=$(touch pwned);d=`x` e"
    // a space is not allowed in a URL: encoded form
    let url2: str = "https://example.org/a?b=1&c=$(touch%20pwned);d=%60x%60"
    rt.buf_clear(&out)
    let ro: i32 = run_child(self_path, "open", "url", url2, false, "PATH", fakepath, "", "", "", "", "", "", &out)
    if ro != 0 { return 40 as i32 }
    var got: rt.Buf = rt.buf_new()
    var wait: u32 = 0
    // the opener is detached: wait until it has written
    while wait < 100 && !fs.exists(log) {
        var ts: [i64; 2] = [0, 20000000]
        syscall(35, (&ts[0]) as i64, 0, 0, 0, 0, 0)
        wait = wait + 1
    }
    var ts2: [i64; 2] = [0, 100000000]
    syscall(35, (&ts2[0]) as i64, 0, 0, 0, 0, 0)
    let gl: str = read_text(log)
    if gl != "1\n" + url2 + "\n" { return 41 as i32 }
    if fs.exists("pwned") { return 42 as i32 }
    fs.remove(log) catch false

    // a path that begins with '-' is made a path
    let dashed: str = root + "/-odd name"
    fs.write_file(dashed, rt.buf_ptr(&sc), 3) catch 0
    var cwdbuf: rt.Buf = rt.buf_new()
    rt.buf_clear(&out)
    // open_path with the path relative to root: run the child with cwd = root is not offered, so give the absolute path
    let rp: i32 = run_child(self_path, "open", "path", dashed, false, "PATH", fakepath, "", "", "", "", "", "", &out)
    if rp != 0 { return 43 as i32 }
    wait = 0
    while wait < 100 && !fs.exists(log) {
        var ts3: [i64; 2] = [0, 20000000]
        syscall(35, (&ts3[0]) as i64, 0, 0, 0, 0, 0)
        wait = wait + 1
    }
    syscall(35, (&ts2[0]) as i64, 0, 0, 0, 0, 0)
    let gl2: str = read_text(log)
    if gl2 != "1\n" + dashed + "\n" { return 44 as i32 }
    fs.remove(log) catch false

    // no opener at all: NotFound, not a crash
    rt.buf_clear(&out)
    let rn: i32 = run_child(self_path, "open", "url", "https://example.org/", true, "PATH", root + "/empty", "", "", "", "", "", "", &out)
    if rn != 1 { return 45 as i32 }

    // --- E. Java: JAVA_HOME with a fake `java`
    var k: u32 = 0
    while k < 5 {
        var line: str = "openjdk version \"17.0.2\" 2022-01-18"
        var want: str = "17"
        if k == 1 { line = "java version \"1.8.0_292\""; want = "8" }
        if k == 2 { line = "openjdk version \"21\" 2023-09-19"; want = "21" }
        if k == 3 { line = "openjdk version \"25-ea\" 2025-09-16"; want = "25" }
        if k == 4 { line = "this is not java"; want = "-1" }
        fs.remove_tree(root + "/jh") catch false
        fs.mkdir_all(root + "/jh/bin") catch false
        let js: str = "#!/bin/sh\necho '" + line + "' 1>&2\n"
        fs.write_file(root + "/jh/bin/java", js.p as u64, js.length()) catch 0
        var jp: rt.Buf = rt.buf_new()
        let jps: str = root + "/jh/bin/java"
        rt.buf_push_bytes(&jp, jps.p as u64, jps.length())
        rt.buf_push(&jp, 0 as u8)
        syscall(90, rt.buf_ptr(&jp) as i64, 493, 0, 0, 0, 0)
        rt.buf_free(&jp)
        rt.buf_clear(&out)
        let rj: i32 = run_child(self_path, "java", "", "", true, "JAVA_HOME", root + "/jh", "HOME", root + "/nohome",
            "PATH", "/usr/bin:/bin", "", "", &out)
        if rj != 0 { return 50 as i32 }
        if !eq(&out, root + "/jh/bin/java|" + want) { return (60 + k) as i32 }
        k = k + 1
    }
    fs.remove_tree(root) catch false
    return 0
}
