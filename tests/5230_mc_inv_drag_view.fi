// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_registry
import mc.mc_inv

fn it(r: *mut mc_registry.Registry, name: str) -> i32 { return mc_registry.reg_item_by_name(r, name.p as u64, name.n) }

fn click(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    let ok: bool = mc_inv.inv_click_build(v, (*ver).protocol, slot, button, mode, &b)
    bytes.bytes_free(&b)
    return ok
}

fn fresh(r: *mut mc_registry.Registry) -> mc_inv.Inv {
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_use_registry(&v, r)
    return v
}

fn hold(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, item: i32, count: i32) -> bool {
    mc_inv.inv_set(v, 44, item, count)
    if !click(v, ver, 44, 0, 0) { return false }
    return mc_inv.inv_cursor_count(v) == count
}

fn view(v: *mut mc_inv.Inv, ws: i32, want: i32, want_clamped: bool) -> bool {
    var shown: i32 = 0
    var clamped: bool = false
    if !mc_inv.inv_drag_slot_view(v, ws, &shown, &clamped) { return false }
    return shown == want && clamped == want_clamped
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var r: mc_registry.Registry = ver.registry_of()
    if !mc_registry.registry_ok(&r) { return 101 }
    let stone: i32 = it(&r, "stone")
    if stone < 0 { return 102 }

    var v: mc_inv.Inv = fresh(&r)
    mc_inv.inv_set(&v, 11, stone, 5)
    if !hold(&v, &ver, stone, 10) { return 1 }
    if mc_inv.inv_drag_slots(&v) != 0 || mc_inv.inv_drag_left(&v) != 10 { return 2 }
    if !click(&v, &ver, 0 - 999, 0, 5) { return 3 }
    if !click(&v, &ver, 10, 1, 5) { return 4 }
    if mc_inv.inv_drag_slots(&v) != 1 || view(&v, 10, 10, false) { return 5 }
    if !click(&v, &ver, 11, 1, 5) || !click(&v, &ver, 12, 1, 5) { return 6 }
    if mc_inv.inv_drag_slots(&v) != 3 { return 7 }
    if !view(&v, 10, 3, false) || !view(&v, 11, 8, false) || !view(&v, 12, 3, false) { return 8 }
    var shown: i32 = 0
    var clamped: bool = false
    if mc_inv.inv_drag_slot_view(&v, 13, &shown, &clamped) { return 9 }
    if mc_inv.inv_drag_left(&v) != 1 { return 10 }
    if !click(&v, &ver, 0 - 999, 2, 5) { return 11 }
    if mc_inv.inv_drag_slots(&v) != 0 || mc_inv.inv_drag_slot_view(&v, 10, &shown, &clamped) { return 12 }
    if mc_inv.inv_count(&v, 10) != 3 || mc_inv.inv_count(&v, 11) != 8 || mc_inv.inv_cursor_count(&v) != 1 { return 13 }
    mc_inv.inv_free(&v)

    v = fresh(&r)
    if !hold(&v, &ver, stone, 10) { return 20 }
    if !click(&v, &ver, 0 - 999, 4, 5) || !click(&v, &ver, 10, 5, 5) || !click(&v, &ver, 11, 5, 5) || !click(&v, &ver, 12, 5, 5) { return 21 }
    if !view(&v, 10, 1, false) || !view(&v, 11, 1, false) || !view(&v, 12, 1, false) || mc_inv.inv_drag_left(&v) != 7 { return 22 }
    mc_inv.inv_free(&v)

    v = fresh(&r)
    mc_inv.inv_set(&v, 10, stone, 63)
    if !hold(&v, &ver, stone, 10) { return 30 }
    if !click(&v, &ver, 0 - 999, 0, 5) || !click(&v, &ver, 10, 1, 5) || !click(&v, &ver, 11, 1, 5) { return 31 }
    if !view(&v, 10, 64, true) || !view(&v, 11, 5, false) || mc_inv.inv_drag_left(&v) != 4 { return 32 }
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    var r: i32 = check(763)
    if r != 0 { return r }
    r = check(769)
    if r != 0 { return r }
    return check(754)
}
