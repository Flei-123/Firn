// expect_exit: 0
// RUNDE 49 — VARIANTE B: FREILISTEN JE FADEN.
//
// Die Allokation kann auf zwei Wegen laufen (docs/RUNDE49.md §5):
//   A  jede Allokation nimmt die GC-Sperre (Voreinstellung)
//   B  jeder Faden holt sich unter der Sperre einen SCHWUNG Bloecke in seine
//      eigene Freiliste und bedient sich daraus ohne Sperre
//
// Dieser Test verlangt, dass B dasselbe Ergebnis liefert wie A — im SELBEN
// Prozess und mit bitgleichem Code, umgeschaltet mit `gc_set_lokal`. Genau
// so wird in docs/RUNDE49.md auch gemessen; ein Messwert von zwei
// verschiedenen Binaries waere durch das Codelayout verfaelscht.
//
// Zusaetzlich geprueft:
//   * die lokalen Listen werden wirklich benutzt (gc_lokal_nachfuellungen())
//   * ein Faden, der endet, gibt seine Liste zurueck — sonst waeren die
//     Bloecke weder frei noch belegt und der Heap wuechse mit jeder Runde

gc class Zelle {
    naechster: Gc[Zelle],
    wert: u64,
}

const KETTE: u64 = 250
const MUELL: u64 = 4000

fn kette_bauen(art: u64) -> AllocError!Gc[Zelle] {
    var kopf: Gc[Zelle] = gc_null[Zelle]()
    var i: u64 = 0
    while i < KETTE {
        let n: Gc[Zelle] = try gc Zelle{ naechster: kopf, wert: art * 1000 + i }
        kopf = n
        var m: u64 = 0
        while m < MUELL / KETTE {
            let tot: Gc[Zelle] = try gc Zelle{ naechster: gc_null[Zelle](), wert: 0 }
            if tot.wert != 0 {
                return kopf
            }
            m = m + 1
        }
        i = i + 1
    }
    return kopf
}

fn kette_pruefen(kopf: Gc[Zelle], art: u64) -> u64 {
    var p: Gc[Zelle] = kopf
    var i: u64 = KETTE
    while i > 0 {
        i = i - 1
        if p == gc_null[Zelle]() {
            return 1
        }
        if p.wert != art * 1000 + i {
            return 2
        }
        p = p.naechster
    }
    return 0
}

fn arbeit(art: u64) -> AllocError!u64 {
    let kopf: Gc[Zelle] = try kette_bauen(art)
    gc_collect()
    if kette_pruefen(kopf, art) != 0 {
        return 900
    }
    return art
}

fn __faden_arbeit(art: u64, arg: u64) -> u64 {
    let _unbenutzt: u64 = arg
    let r: AllocError!u64 = arbeit(art)
    return r catch 800
}

// Ein ganzer Satz Faeden. Liefert die Summe der Ergebnisse.
fn satz(n: u64) -> u64 {
    var h: [u64; 4] = [0; 4]
    var i: u64 = 0
    while i < n {
        h[i as usize] = faden_starten(i + 1, 0)
        if h[i as usize] == 0 {
            return 0
        }
        i = i + 1
    }
    var s: u64 = 0
    i = 0
    while i < n {
        let r: u64 = faden_warten(h[i as usize])
        if r >= 800 {
            return 0
        }
        s = s + r
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    if !faden_init() {
        return 91
    }

    // --- A: alles unter der GC-Sperre ---------------------------------------
    if gc_lokal() != 0 {
        return 1
    }
    if satz(4) != 10 {
        return 2
    }
    if gc_lokal_nachfuellungen() != 0 {
        return 3
    }
    let heap_a: u64 = gc_heap_bytes()

    // --- B: Freilisten je Faden ---------------------------------------------
    gc_set_lokal(1)
    if gc_lokal() != 1 {
        return 4
    }
    if satz(4) != 10 {
        return 5
    }
    if gc_lokal_nachfuellungen() == 0 {
        return 6
    }

    // Noch zwei Saetze: gaeben die endenden Faeden ihre Listen nicht zurueck,
    // wuechse der Heap mit jedem Satz weiter.
    if satz(4) != 10 {
        return 7
    }
    if satz(4) != 10 {
        return 8
    }
    gc_collect()
    let heap_b: u64 = gc_heap_bytes()
    if heap_b > heap_a * 3 + 4194304 {
        return 9
    }

    // --- zurueck auf A: derselbe Weg muss weiter stimmen ---------------------
    gc_set_lokal(0)
    if satz(4) != 10 {
        return 10
    }
    if faden_anzahl() != 1 {
        return 11
    }
    return 0
}
