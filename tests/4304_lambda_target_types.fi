// expect_exit: 0
// tests/4304_lambda_target_types.fi -- r742: the type of a lambda assignment target
// is found even when no local declares it: result of a method call, `try`,
// cast / address-of, shadowing and block scopes.
import std.vec

struct Hook { f: fn(i64) -> i64 }
struct Other { g: fn(i64) -> i64, tag: i64 }

struct Maker { k: i64 }
impl Maker {
    fn make(*mut self) -> Hook { return Hook { f: ident } }
}

fn ident(x: i64) -> i64 { return x }
fn mk_hook() -> Hook { return Hook { f: ident } }
fn mk_other() -> Other { return Other { g: ident, tag: 0 } }
fn try_hook() -> AllocError!Hook { return Hook { f: ident } }

#[no_inline]
fn run() -> AllocError!i64 {
    var m: Maker = Maker { k: 1 }
    var x = m.make()
    x.f = |a| a + 1
    if x.f(1) != 2 { return 1 }
    var y = mk_hook()
    y.f = |a| a * 3
    if y.f(2) != 6 { return 2 }
    var z = try try_hook()
    z.f = |a| a - 1
    if z.f(5) != 4 { return 3 }
    // shadowing with another struct type in an inner block: the lambda follows the NEW type
    var s = mk_hook()
    s.f = |a| a + 1
    if s.f(1) != 2 { return 5 }
    {
        var s = mk_other()
        s.g = |a| a + 2
        if s.g(1) != 3 { return 6 }
        {
            var s = mk_hook()
            s.f = |a| a * 10
            if s.f(2) != 20 { return 7 }
        }
        s.g = |a| a + 4
        if s.g(1) != 5 { return 8 }
    }
    // the outer `s` is a Hook again after the block
    s.f = |a| a + 5
    if s.f(1) != 6 { return 11 }
    // for variable shadows an outer local of another type
    var i = mk_hook()
    for i in 0..2 {
        let q = i + 1
        if q < 1 { return 9 }
    }
    i.f = |a| a + 7
    if i.f(1) != 8 { return 10 }
    return 0
}

fn main() -> i32 {
    let r: i64 = run() catch 99
    return r as i32
}
