// expect_exit: 0
// tests/3946_mc_model_ref.fi -- CPU reference view of baked model quads (lib/mc/mc_model_ref.fi): texture orientation of every face seen from
// outside, slab half coverage, variant x / y rotation of the texture, uvlock. Textures: 16 px PNG, left half red, right half blue (own pixels).
import std.rt
import zip.zip
import pack.icons
import mc.mc_assets
import mc.mc_model
import mc.mc_model_ref

// size x size PNG: left half (r,g,b), right half (b,g,r)
fn mk_png(size: usize, r: u32, g: u32, b: u32, out: *mut rt.Buf) -> bool {
    let px: u64 = rt.heap_alloc(size * size * 4)
    var y: usize = 0
    while y < size {
        var x: usize = 0
        while x < size {
            let i: usize = (y * size + x) * 4
            if x < size / 2 {
                rt.st8(px, i, r as u8)
                rt.st8(px, i + 1, g as u8)
                rt.st8(px, i + 2, b as u8)
            } else {
                rt.st8(px, i, b as u8)
                rt.st8(px, i + 1, g as u8)
                rt.st8(px, i + 2, r as u8)
            }
            rt.st8(px, i + 3, 255 as u8)
            x = x + 1
        }
        y = y + 1
    }
    let ok: bool = icons.png_encode(px, size, size, out)
    rt.heap_free(px, size * size * 4)
    return ok
}

fn add(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    let ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

fn add_png(w: *mut zip.ZipWriter, name: str) -> bool {
    var p: rt.Buf = rt.buf_new()
    var ok: bool = mk_png(16, 255 as u32, 0 as u32, 0 as u32, &p)
    if ok { ok = zip.zip_add(w, name, rt.buf_ptr(&p), rt.buf_len(&p), true) catch | e | (false) }
    rt.buf_free(&p)
    return ok
}

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"

fn build(st: *mut mc_assets.PackStack) -> bool {
    var b: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&b)
    if !add(&w, "pack.mcmeta", META) { return false }
    if !add_png(&w, "assets/minecraft/textures/block/lr.png") { return false }
    if !add(&w, "assets/minecraft/models/block/t_all.json", "{\"parent\":\"block/cube_all\",\"textures\":{\"all\":\"block/lr\"}}") { return false }
    if !add(&w, "assets/minecraft/models/block/t_slab.json", "{\"parent\":\"block/slab\",\"textures\":{\"bottom\":\"block/lr\",\"top\":\"block/lr\",\"side\":\"block/lr\"}}") { return false }
    if !add(&w, "assets/minecraft/models/block/t_north.json", "{\"textures\":{\"t\":\"block/lr\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"north\":{\"texture\":\"#t\",\"cullface\":\"north\"}}}]}") { return false }
    if !add(&w, "assets/minecraft/models/block/t_up.json", "{\"textures\":{\"t\":\"block/lr\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"up\":{\"texture\":\"#t\"}}}]}") { return false }
    if !add(&w, "assets/minecraft/models/block/t_gone.json", "{\"textures\":{\"t\":\"block/not_in_pack\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"up\":{\"texture\":\"#t\"}}}]}") { return false }
    let n: usize = zip.zip_finish(&w) catch | e | (0)
    zip.zip_writer_free(&w)
    if n == 0 { return false }
    var p: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&p, rt.buf_ptr(&b), rt.buf_len(&b)) != mc_assets.ASSET_OK { return false }
    rt.buf_free(&b)
    return mc_assets.stack_push(st, &p) == mc_assets.ASSET_OK
}

const RED: u32 = 4278190335
const BLUE: u32 = 4294901760
const MAGENTA: u32 = 4294902015

// renders model `name` (x / y rotation, uvlock) from direction `view` into img (16x16)
fn shot(st: *mut mc_assets.PackStack, name: str, rx: i32, ry: i32, lock: bool, view: usize, img: u64) -> i32 {
    var b: mc_model.Baked = mc_model.baked_new()
    let n: i32 = mc_model.model_bake(st, name, rx, ry, lock, &b)
    var tex: rt.Buf = rt.buf_new()
    mc_model_ref.baked_load_textures(st, &b, 16, &tex)
    mc_model_ref.ref_render(&b, rt.buf_ptr(&tex), 16, view, 16, img)
    rt.buf_free(&tex)
    mc_model.baked_free(&b)
    return n
}

fn px(img: u64, x: usize, y: usize) -> u32 { return rt.ld32(img, y * 16 + x) }

fn main() -> i32 {
    var st: mc_assets.PackStack = mc_assets.stack_new()
    if !build(&st) { return 1 }
    let img: u64 = rt.heap_alloc(16 * 16 * 4)
    // 1. cube: from every side the texture stands upright (left red, right blue), fully opaque
    var v: usize = 0
    while v < 6 {
        if shot(&st, "block/t_all", 0, 0, false, v, img) != 6 { return 10 }
        if px(img, 2, 8) != RED || px(img, 13, 8) != BLUE || px(img, 2, 1) != RED || px(img, 13, 14) != BLUE { return 11 + (v as i32) }
        v = v + 1
    }
    // 2. bottom slab seen from the north: lower half covered, upper half empty; from above fully covered
    if shot(&st, "block/t_slab", 0, 0, false, 2, img) != 6 { return 20 }
    if px(img, 8, 2) != (0 as u32) || px(img, 8, 7) != (0 as u32) { return 21 }
    if px(img, 3, 12) != RED || px(img, 12, 12) != BLUE { return 22 }
    if shot(&st, "block/t_slab", 0, 0, false, 1, img) != 6 { return 23 }
    if px(img, 3, 3) != RED || px(img, 12, 12) != BLUE { return 24 }
    // 3. one north face: y = 90 -> an east face (upright from the east, empty from the north); x = 90 -> a down face seen upside down
    if shot(&st, "block/t_north", 0, 90, false, 5, img) != 1 { return 30 }
    if px(img, 2, 8) != RED || px(img, 13, 8) != BLUE { return 31 }
    shot(&st, "block/t_north", 0, 90, false, 2, img)
    if px(img, 8, 8) != (0 as u32) { return 32 }
    shot(&st, "block/t_north", 90, 0, false, 0, img)
    if px(img, 13, 8) != RED || px(img, 2, 8) != BLUE { return 33 }
    // 4. up face, y = 90: without uvlock the texture turns (red at the north edge), with uvlock it stays (red on the left)
    shot(&st, "block/t_up", 0, 90, false, 1, img)
    if px(img, 8, 2) != RED || px(img, 8, 13) != BLUE { return 40 }
    shot(&st, "block/t_up", 0, 90, true, 1, img)
    if px(img, 2, 8) != RED || px(img, 13, 8) != BLUE { return 41 }
    shot(&st, "block/t_up", 0, 180, true, 1, img)
    if px(img, 2, 8) != RED || px(img, 13, 8) != BLUE { return 42 }
    shot(&st, "block/t_up", 0, 180, false, 1, img)
    if px(img, 13, 8) != RED || px(img, 2, 8) != BLUE { return 43 }
    // 5. texture missing in all packs -> magenta
    shot(&st, "block/t_gone", 0, 0, false, 1, img)
    if px(img, 8, 8) != MAGENTA { return 50 }
    rt.heap_free(img, 16 * 16 * 4)
    mc_assets.stack_free(&st)
    return 0
}
