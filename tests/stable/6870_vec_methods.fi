// expect_exit: 0
fn main() -> i32 {
    var v = Vec[int].new()
    v.push(3)
    v.push(1)
    v.push(2)
    if v.len() != 3 { return 1 }
    v.sort()
    if v.get(0) != 1 || v.first() != 1 || v.last() != 3 { return 2 }
    if !v.contains(2) || v.contains(9) { return 3 }
    if v.index_of(3) != 2 { return 4 }
    v.insert(1, 9)
    if v.remove_at(1) != 9 { return 5 }
    v.set(0, 7)
    v.reverse()
    if v.pop() != 7 || v.len() != 2 { return 6 }
    var w = Vec[int].new()
    w.push(5)
    v.extend(w)
    if v.len() != 3 || v.last() != 5 { return 7 }
    v.clear()
    if !v.is_empty() { return 8 }
    return 0
}
