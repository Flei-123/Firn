// expect_levels: dev=7 dev-fast=7 release-safe=7 release-fast=7
fn main() -> i32 {
    let max: i32 = 2147483647
    let min: i32 = -2147483647 - 1
    var s: i32 = max - 1
    s = s + 1
    if s != max { return 1 }
    var t: i32 = min + 1
    t = t - 1
    if t != min { return 2 }
    var u: u64 = 18446744073709551615
    u = u - 1
    if u != 18446744073709551614 { return 3 }
    let w: i64 = 4294967296
    if w * 2147483647 != 9223372032559808512 { return 4 }
    return 7
}
