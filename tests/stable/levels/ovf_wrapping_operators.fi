// expect_levels: dev=7 dev-fast=7 release-safe=7 release-fast=7
fn wadd(a: i32, b: i32) -> i32 {
    return a +% b
}

fn wsub(a: u32, b: u32) -> u32 {
    return a -% b
}

fn wmul(a: u64, b: u64) -> u64 {
    return a *% b
}

fn sadd(a: u8, b: u8) -> u8 {
    return a +| b
}

fn ssub(a: u8, b: u8) -> u8 {
    return a -| b
}

fn main() -> i32 {
    let min: i32 = -2147483647 - 1
    if wadd(2147483647, 1) != min { return 1 }
    if wsub(0, 1) != 4294967295 { return 2 }
    if wmul(9223372036854775808, 2) != 0 { return 3 }
    if sadd(250, 10) != 255 { return 4 }
    if ssub(3, 10) != 0 { return 5 }
    return 7
}
