// expect_levels: dev=101 dev-fast=101 release-safe=101 release-fast=7
fn quot(a: i32, b: i32) -> i32 {
    return a / b
}

fn rem(a: i32, b: i32) -> i32 {
    return a % b
}

fn main() -> i32 {
    let m: i32 = -2147483647 - 1
    if rem(m, -1) == 0 && quot(m, -1) == m {
        return 7
    }
    return 8
}
