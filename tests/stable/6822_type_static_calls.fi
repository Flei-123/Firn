// expect_exit: 0
import std.tostr

struct Counter { n: i32 }

impl Counter {
    fn start() -> Counter { return Counter { n: 0 } }
    fn from(n: i32) -> Counter { return Counter { n: n } }
    fn next(*self) -> Counter { return Counter { n: (*self).n + 1 } }
    fn get(*self) -> i32 { return (*self).n }
}

enum Shape { Dot, Box(i32) }

impl Shape {
    fn unit() -> Shape { return Shape::Box(1) }
    fn area(*self) -> i32 {
        var out: i32 = 0
        match *self {
            Shape::Dot => { out = 0 }
            Shape::Box(w) => { out = w * w }
        }
        return out
    }
}

impl i32 {
    fn twice(v: i32) -> i32 { return v * 2 }
    fn clamp_to(v: i32, hi: i32) -> i32 {
        if v > hi { return hi }
        return v
    }
}

fn start() -> i32 { return 100 }

fn main() -> i32 {
    var bad: i32 = 0
    let c: Counter = Counter.start()
    if c.get() != 0 { bad = bad + 1 }
    if Counter.from(4).next().next().get() != 6 { bad = bad + 2 }
    if Shape.unit().area() != 1 { bad = bad + 4 }
    if int.twice(21) != 42 { bad = bad + 8 }
    if i32.clamp_to(50, 10) != 10 { bad = bad + 16 }
    if Counter.start().next().get().to_str() != "1" { bad = bad + 32 }
    if start() != 100 { bad = bad + 64 }
    let Counter: i32 = 5
    if Counter != 5 { bad = bad + 128 }
    return bad
}
