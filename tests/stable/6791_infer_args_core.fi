// expect_exit: 67
enum Opt[T] { Some(T), None }
enum Pair[A, B] { Both(A, B), Left(A) }

fn pick[T](a: T, b: T) -> T { if a > b { return a } return b }
fn first[T](a: T, b: i32) -> T { return a }

fn main() -> i32 {
    var total: i32 = 0
    let o = Opt::Some(4)
    match o {
        Opt::Some(x) => { total = total + x }
        Opt::None => { total = total + 100 }
    }
    let big: i64 = 40
    let q = Opt::Some(big)
    match q {
        Opt::Some(x) => { total = total + (x as i32) }
        Opt::None => { total = total + 100 }
    }
    let w: Opt[i64] = Opt::Some(3)
    match w {
        Opt::Some(x) => { total = total + (x as i32) }
        Opt::None => { total = total + 100 }
    }
    let p = Pair::Both(1, true)
    match p {
        Pair::Both(a, b) => { if b { total = total + a } }
        Pair::Left(a) => { total = total + 100 }
    }
    let a: i64 = 5
    total = total + (pick(a, 9) as i32)
    total = total + pick(2, 3)
    total = total + first(7, 1)
    return total
}
