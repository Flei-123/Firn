// expect_exit: 0
// firnc1_skip: generic enum Eq/Ord/Json generate nested match or firnc0-only code (tests/diff/derive_generic_enum.fi covers firnc1)
#[derive(Debug, Eq, Ord, Hash, Clone, Json)]
enum Opt[T] { Some(T), None }

#[derive(Debug, Eq, Clone)]
enum Res[T, E] { Ok(T), Err(E) }

#[derive(Debug, Clone)]
enum Flag[T] { On(T), Off }

fn main() -> i32 {
    if !gc_init() { return 99 }
    let a: Opt[i32] = Opt::Some(5)
    let b: Opt[i32] = Opt::Some(5)
    let n: Opt[i32] = Opt::None
    if a != b { return 1 }
    if a == n { return 2 }
    if a.debug() != "Some(5)" { return 3 }
    if n.debug() != "None" { return 4 }
    let a2 = a.clone()
    if a2 != a { return 5 }
    if a.hash() != b.hash() { return 6 }
    if a.hash() == n.hash() { return 7 }
    if a.cmp(n) >= 0 { return 8 }
    let c: Opt[i32] = Opt::Some(9)
    if a.cmp(c) >= 0 { return 9 }
    if c.cmp(a) <= 0 { return 10 }
    if a.to_json() != "{\"Some\":[5]}" { return 11 }
    if n.to_json() != "\"None\"" { return 12 }
    let f: Flag[bool] = Flag::On(true)
    if f.debug() != "On(true)" { return 13 }
    let r: Res[i32, bool] = Res::Err(true)
    if r.debug() != "Err(true)" { return 14 }
    let r2 = r.clone()
    if r != r2 { return 15 }
    let ok: Res[i32, bool] = Res::Ok(3)
    if ok == r { return 16 }
    return 0
}
