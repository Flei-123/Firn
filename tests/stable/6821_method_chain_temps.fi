// expect_exit: 0
import std.tostr

struct V { x: i32, y: i32 }

impl V {
    fn sum(*self) -> i32 { return (*self).x + (*self).y }
    fn add(*self, o: V) -> V { return V { x: (*self).x + o.x, y: (*self).y + o.y } }
    fn mul(*self, k: i32) -> V { return V { x: (*self).x * k, y: (*self).y * k } }
    fn moved(self, dx: i32) -> V { return V { x: self.x + dx, y: self.y } }
}

fn make(a: i32) -> V { return V { x: a, y: a + 1 } }
fn count(a: i32) -> i32 { return a * 2 }

fn main() -> i32 {
    var bad: i32 = 0
    var p: V = V { x: 1, y: 2 }
    if p.moved(1).sum() != 4 { bad = bad + 1 }
    if make(3).sum() != 7 { bad = bad + 2 }
    let a: V = V { x: 1, y: 1 }
    let b: V = V { x: 2, y: 3 }
    let c: V = V { x: 2, y: 2 }
    let r: V = (a + b) * 2
    if r.x != 6 || r.y != 8 { bad = bad + 4 }
    if (a + b + c).sum() != 11 { bad = bad + 8 }
    if make(1).add(make(2)).mul(2).sum() != 16 { bad = bad + 16 }
    let s: str = count(21).to_str()
    if s != "42" { bad = bad + 32 }
    let t: str = (count(1) + 1).to_str()
    if t != "3" { bad = bad + 64 }
    return bad
}
