// expect_exit: 0
fn sum_i32(v: [i32; 4], n: i32) -> i32 {
    var s: i32 = 0
    for i in 0..n {
        s += v[i]
    }
    return s
}

fn at_u32(v: [i32; 4], i: u32) -> i32 { return v[i] }

fn at_i64(v: [i32; 4], i: i64) -> i32 { return v[i] }

fn at_u8(v: [i32; 4], i: u8) -> i32 { return v[i] }

fn main() -> i32 {
    var v: [i32; 4] = [0, 0, 0, 0]
    for i in 0..4 {
        v[i] = i * 3
    }
    if v[3] != 9 { return 1 }
    if sum_i32(v, 4) != 18 { return 2 }
    if at_u32(v, 2) != 6 { return 3 }
    if at_i64(v, 1) != 3 { return 4 }
    if at_u8(v, 3) != 9 { return 5 }
    var k: i64 = 0
    while k < 4 {
        v[k] += 1
        k += 1
    }
    if v[0] != 1 || v[3] != 10 { return 6 }
    return 0
}
