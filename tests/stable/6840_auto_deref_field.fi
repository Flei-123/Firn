// expect_exit: 0
struct Counter { n: i32 }

struct Pair { a: Counter, b: i64 }

impl Counter {
    fn start() -> Counter { return Counter { n: 0 } }
    fn bump(*self) { self.n += 1 }
    fn add(*self, d: i32) -> i32 {
        self.n = self.n + d
        return self.n
    }
    fn get(*self) -> i32 { return self.n }
}

fn read(p: *Counter) -> i32 { return p.n }

fn write(p: *mut Counter, v: i32) { p.n = v }

fn nested(p: *Pair) -> i64 { return p.b + (p.a.n as i64) }

fn main() -> i32 {
    var c: Counter = Counter.start()
    c.bump()
    c.bump()
    if c.get() != 2 { return 1 }
    if c.add(5) != 7 { return 2 }
    write(&c, 40)
    if read(&c) != 40 { return 3 }
    let q: *mut Counter = &c
    q.n += 2
    q.n = q.n * 2
    if (*q).n != 84 { return 4 }
    var pr: Pair = Pair { a: Counter { n: 3 }, b: 100 }
    if nested(&pr) != 103 { return 5 }
    let pp: *mut Pair = &pr
    pp.a.n = 9
    pp.b -= 1
    if nested(&pr) != 108 { return 6 }
    return 0
}
