// expect_error: 11:22 unknown name 'Counter'
// expect_error_count: 1
// A type name before the dot only reaches a function that the impl block declares.
struct Counter { n: i32 }

impl Counter {
    fn start() -> Counter { return Counter { n: 0 } }
}

fn main() -> i32 {
    let c: Counter = Counter.begin()
    return c.n
}
