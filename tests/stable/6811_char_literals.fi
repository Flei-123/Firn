// expect_exit: 0
fn code(c: char) -> u32 {
    return c
}

fn main() -> i32 {
    var bad: i32 = 0
    let a: char = 'a'
    if a != 97 { bad = bad + 1 }
    if code('z') != 122 { bad = bad + 2 }
    if '\n' != 10 { bad = bad + 4 }
    if '\u{1F600}' != 128512 { bad = bad + 8 }
    if 'é' != 233 { bad = bad + 16 }
    if '\'' != 39 { bad = bad + 32 }
    if '\\' != 92 { bad = bad + 64 }
    if 'é' != 233 { bad = bad + 128 }
    if '€' != 8364 { bad = bad + 256 }
    let b: u8 = 'x'
    if b != 120 { bad = bad + 512 }
    if !('a' < 'b') { bad = bad + 1024 }
    let d: char = '0'
    if (d - '0') != 0 { bad = bad + 2048 }
    if '"' != 34 { bad = bad + 4096 }
    return bad
}
