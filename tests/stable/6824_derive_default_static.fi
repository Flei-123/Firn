// expect_exit: 0
#[derive(Default)]
struct Config { width: i32, name: str, on: bool, ratio: f64 }

#[derive(Default)]
struct Wrapper { inner: Config, count: u64 }

fn main() -> i32 {
    var bad: i32 = 0
    let c: Config = Config.default()
    if c.width != 0 { bad = bad + 1 }
    if c.name != "" { bad = bad + 2 }
    if c.on { bad = bad + 4 }
    if c.ratio != 0.0 { bad = bad + 8 }
    let w: Wrapper = Wrapper.default()
    if w.count != 0 { bad = bad + 16 }
    if w.inner.width != 0 { bad = bad + 32 }
    let d: Config = default_Config()
    if d.width != 0 { bad = bad + 64 }
    return bad
}
