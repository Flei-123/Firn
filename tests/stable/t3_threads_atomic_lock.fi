// expect_exit: 0
import std.rt

const MMAP: i64 = 9
const PROT_RW: i64 = 3
const MAP_ANON: i64 = 34
const MUTEX: u64 = 0
const LOCKED: u64 = 8
const ATOMIC: u64 = 16
const ROUNDS: u64 = 4000
const WORKERS: usize = 4

fn page() -> u64 {
    let r: i64 = syscall(MMAP, 0, 4096, PROT_RW, MAP_ANON, -1, 0)
    if r < 0 {
        return 0
    }
    return r as u64
}

fn cell(z: u64, off: u64) -> *mut u64 {
    return (z + off) as *mut u64
}

fn count(z: u64) -> u64 {
    var i: u64 = 0
    while i < ROUNDS {
        thread_lock(cell(z, MUTEX))
        *cell(z, LOCKED) = *cell(z, LOCKED) + 1
        thread_unlock(cell(z, MUTEX))
        __atomic_add(cell(z, ATOMIC), 1)
        i = i + 1
    }
    return z & 255
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == 1 {
        return count(arg)
    }
    return 0
}

fn main() -> i32 {
    let z: u64 = page()
    if z == 0 { return 1 }
    var handles: [u64; 4] = [0, 0, 0, 0]
    var k: usize = 0
    while k < WORKERS {
        handles[k] = thread_start(1, z)
        if handles[k] == 0 { return 2 }
        k = k + 1
    }
    k = 0
    var bad: u64 = 0
    while k < WORKERS {
        if thread_wait(handles[k]) != (z & 255) {
            bad = bad + 1
        }
        k = k + 1
    }
    if bad != 0 { return 3 }
    if *cell(z, LOCKED) != ROUNDS * 4 { return 4 }
    if *cell(z, ATOMIC) != ROUNDS * 4 { return 5 }
    return 0
}
