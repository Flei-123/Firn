// expect_exit: 0
import std.rt
import std.vec
import std.option

struct Pair[A, B] {
    first: A,
    second: B,
}

fn swap_pair[A: Scalar, B: Scalar](p: Pair[A, B]) -> Pair[B, A] {
    return Pair[B, A] { first: p.second, second: p.first }
}

fn largest[T: Int](a: T, b: T) -> T {
    if a > b { return a }
    return b
}

fn main() -> i32 {
    let o: Option[i64] = opt_some[i64](41)
    if !o.has { return 1 }
    if o.val != 41 { return 2 }
    let n: Option[i64] = opt_none[i64]()
    if n.has { return 3 }
    if opt_unwrap_or[i64](n, -1) != -1 { return 4 }
    if opt_unwrap_or[i64](o, -1) != 41 { return 5 }
    if !opt_is_some[i64](o) || !opt_is_none[i64](n) { return 6 }
    let s: Pair[i32, u8] = swap_pair[u8, i32](Pair[u8, i32] { first: 9, second: -3 })
    if s.first != -3 || s.second != 9 { return 7 }
    if largest[u16](7, 900) != 900 { return 8 }
    return 0
}
