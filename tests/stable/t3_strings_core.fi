// expect_out: firn-1|OK
import std.str
import std.io

fn main() -> i32 {
    if !gc_init() { return 1 }
    let a: str = "fi" + "rn"
    let b: str = a + "-" + "1"
    if b.length() != 6 { return 2 }
    if b != "firn-1" { return 3 }
    if b == "firn-2" { return 4 }
    if !b.starts_with("fir") || !b.ends_with("-1") { return 5 }
    if b.find("rn") != 2 { return 6 }
    let t: str = "  x y ".trim()
    if t != "x y" { return 7 }
    io.print_str(b)
    io.print_str("|OK")
    return 0
}
