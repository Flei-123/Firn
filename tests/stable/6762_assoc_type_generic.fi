// expect_exit: 0
import std.vec
interface Source {
    type Item
    fn get(*self, i: i32) -> Self::Item
    fn size(*self) -> i32
}
struct Evens { n: i32 }
impl Source for Evens {
    type Item = i64
    fn get(*self, i: i32) -> i64 { return (i as i64) * 2 }
    fn size(*self) -> i32 { return (*self).n }
}
fn collect[S: Source](s: *S) -> Vec[S::Item] {
    var out: Vec[S::Item] = vec_new[S::Item]()
    var i = 0
    while i < s.size() {
        vec_push[S::Item](&out, s.get(i))
        i = i + 1
    }
    return out
}
fn main() -> i32 {
    let e = Evens { n: 4 }
    let v = collect[Evens](&e)
    if vec_len[i64](&v) != 4 { return 1 }
    if vec_at[i64](&v, 3) != 6 { return 2 }
    return 0
}
