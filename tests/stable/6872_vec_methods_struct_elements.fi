// expect_exit: 0
struct Point { x: i32, y: i32 }

fn total(v: Vec[i32]) -> i32 {
    var sum = 0
    var i: usize = 0
    while i < v.len() {
        sum += v.get(i)
        i += 1
    }
    return sum
}

fn main() -> i32 {
    var points: Vec[Point] = Vec[Point].new()
    points.push(Point { x: 1, y: 2 })
    points.push(Point { x: 3, y: 4 })
    points.reverse()
    if points.len() != 2 || points[0].x != 3 { return 1 }
    var numbers: Vec[int] = Vec[int].new()
    numbers.push(4)
    numbers.push(5)
    if total(numbers) != 9 { return 2 }
    var old_style: Vec[i32] = vec_new[i32]()
    vec_push[i32](&old_style, 6)
    old_style.push(7)
    if vec_len[i32](&old_style) != 2 || total(old_style) != 13 { return 3 }
    return 0
}
