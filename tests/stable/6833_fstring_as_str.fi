// expect_exit: 0
import std.io

fn take(s: str) -> bool {
    return s == "n=7"
}

fn make(n: i32) -> str {
    return f"n={n}"
}

struct Holder {
    label: str,
}

fn main() -> i32 {
    var bad: i32 = 0
    let n: i32 = 7
    let s: str = f"n={n}"
    if s != "n=7" {
        bad = bad + 1
    }
    if !take(f"n={n}") {
        bad = bad + 2
    }
    if make(n) != s {
        bad = bad + 4
    }
    let t: str = s + f" and {n + 1}"
    if t != "n=7 and 8" {
        bad = bad + 8
    }
    let h: Holder = Holder { label: f"L{n}" }
    if h.label != "L7" {
        bad = bad + 16
    }
    if s == f"n=8" {
        bad = bad + 32
    }
    io.print_line(f"direct {n}")
    io.fmt_print_line(f"builder {n}")
    println(f"println {n}")
    return bad
}
