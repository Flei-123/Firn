// expect_exit: 0
import std.rt
import std.vec

fn diffs(v: *mut Vec[i64]) -> i64 {
    var s: i64 = 0
    var i: i32 = 1
    let n: i32 = vec_len[i64](v) as i32
    while i < n {
        s = s + ((*v)[i] ^ (*v)[i - 1])
        i = i + 1
    }
    return s
}

fn from_end(v: *mut Vec[i64], k: i32) -> i64 {
    var s: i64 = 0
    var i: i32 = 0 - k
    while i < 0 {
        s = s * 31 + (*v)[i]
        i = i + 1
    }
    return s
}

fn wide(v: *mut Vec[i64]) -> i64 {
    var s: i64 = 0
    var i: i64 = 2
    let n: i64 = vec_len[i64](v) as i64
    while i < n {
        s = s + (*v)[i - 2] * 3 - (*v)[i]
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i64] = vec_new[i64]()
    var k: i64 = 0
    while k < 50 {
        vec_push[i64](&v, k * k + 7)
        k = k + 1
    }
    var d: i64 = 0
    var j: usize = 1
    while j < 50 {
        d = d + (v[j] ^ v[j - 1])
        j = j + 1
    }
    if diffs(&v) != d { return 2 }
    var e: i64 = 0
    var t: usize = 45
    while t < 50 {
        e = e * 31 + v[t]
        t = t + 1
    }
    if from_end(&v, 5) != e { return 3 }
    var w: i64 = 0
    var u: usize = 2
    while u < 50 {
        w = w + v[u - 2] * 3 - v[u]
        u = u + 1
    }
    if wide(&v) != w { return 4 }
    return 0
}
