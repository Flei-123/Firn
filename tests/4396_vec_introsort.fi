// expect_exit: 0
// vec_sort / vec_sort_by (introsort): shapes that break naive quicksorts,
// sizes around the insertion cutoff, multiset preserved, struct and f64 keys.
import std.vec

struct Pair { k: i32, tag: i32 }

impl Ord for Pair {
    fn less(*self, b: *Pair) -> bool { return (*self).k < (*b).k }
}

fn pair_less(a: *Pair, b: *Pair) -> bool { return (*a).k < (*b).k }
fn i32_greater(a: *i32, b: *i32) -> bool { return *b < *a }

static mut SEED: i64 = 987654321

fn rnd() -> i64 {
    SEED = (SEED * 1103515245 + 12345) & 2147483647
    return SEED
}

// shape: 0 random, 1 ascending, 2 descending, 3 all equal, 4 four values,
// 5 organ pipe, 6 sawtooth, 7 ascending with a random tail, 8 two values alternating
fn fill(v: *mut Vec[i32], n: usize, shape: i32) {
    vec_clear[i32](v)
    var i: usize = 0
    while i < n {
        var x: i32 = 0
        if shape == 0 { x = (rnd() % 100000) as i32 - 50000 }
        else if shape == 1 { x = i as i32 }
        else if shape == 2 { x = (n - i) as i32 }
        else if shape == 3 { x = 7 }
        else if shape == 4 { x = (rnd() % 4) as i32 }
        else if shape == 5 { if i < n / 2 { x = i as i32 } else { x = (n - i) as i32 } }
        else if shape == 6 { x = (i % 37) as i32 }
        else if shape == 7 { if i < n - n / 10 { x = i as i32 } else { x = rnd() as i32 } }
        else { x = (i % 2) as i32 }
        vec_push[i32](v, x)
        i = i + 1
    }
}

fn mix(v: *mut Vec[i32]) -> i64 {
    var s: i64 = 0
    var q: i64 = 0
    var i: usize = 0
    while i < (*v).len {
        let x: i64 = vec_at[i32](v, i) as i64
        s = s + x
        let y: i64 = x & 65535
        q = (q + y * y * 31 + (x ^ 5)) & 281474976710655
        i = i + 1
    }
    return s * 1000003 + q
}

fn check(n: usize, shape: i32, desc: bool) -> bool {
    var v: Vec[i32] = vec_new[i32]()
    defer vec_free[i32](&v)
    fill(&v, n, shape)
    let before: i64 = mix(&v)
    if desc {
        vec_sort_by[i32](&v, i32_greater)
        if !vec_is_sorted_by[i32](&v, i32_greater) { return false }
    } else {
        vec_sort[i32](&v)
        if !vec_is_sorted[i32](&v) { return false }
    }
    return mix(&v) == before
}

fn main() -> i32 {
    var sizes: [usize; 14] = [0, 1, 2, 3, 15, 16, 17, 18, 31, 100, 127, 128, 129, 5000]
    var si: usize = 0
    while si < 14 {
        var shape: i32 = 0
        while shape < 9 {
            if !check(sizes[si], shape, false) { return 1 + shape }
            if !check(sizes[si], shape, true) { return 20 + shape }
            shape = shape + 1
        }
        si = si + 1
    }
    // a big random run and a big sorted/equal run
    if !check(300000, 0, false) { return 40 }
    if !check(300000, 3, false) { return 41 }
    if !check(300000, 1, true) { return 42 }
    if !check(100000, 5, false) { return 43 }
    if !check(100001, 8, false) { return 44 }

    // structs: key order holds, the multiset of tags is kept
    var p: Vec[Pair] = vec_new[Pair]()
    defer vec_free[Pair](&p)
    var i: i32 = 0
    var tagsum: i64 = 0
    while i < 4000 {
        vec_push[Pair](&p, Pair { k: (rnd() % 50) as i32, tag: i })
        tagsum = tagsum + i as i64
        i = i + 1
    }
    vec_sort[Pair](&p)
    var j: usize = 1
    var ts: i64 = 0
    while j < p.len {
        let a: *mut Pair = vec_elem_ptr[Pair](&p, j - 1)
        let b: *mut Pair = vec_elem_ptr[Pair](&p, j)
        if (*b).k < (*a).k { return 50 }
        ts = ts + (*b).tag as i64
        j = j + 1
    }
    ts = ts + (*vec_elem_ptr[Pair](&p, 0)).tag as i64
    if ts != tagsum { return 51 }
    vec_sort_by[Pair](&p, pair_less)
    if !vec_is_sorted_by[Pair](&p, pair_less) { return 52 }

    // f64 total order with NaN and signed zeros
    var f: Vec[f64] = vec_new[f64]()
    defer vec_free[f64](&f)
    i = 0
    while i < 300 {
        var x: f64 = (rnd() % 1000) as f64 - 500.0
        if i % 17 == 0 { x = 0.0 / 0.0 }
        vec_push[f64](&f, x)
        i = i + 1
    }
    vec_sort[f64](&f)
    if !vec_is_sorted[f64](&f) { return 60 }
    return 0
}
