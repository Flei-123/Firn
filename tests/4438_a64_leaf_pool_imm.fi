// expect_exit: 0
// tests/4438_a64_leaf_pool_imm.fi -- r841/r842: on aarch64 a leaf function with a loop may use x25-x28 and caller-saved
// registers, `and`/`orr`/`eor` take a bitmask immediate and a constant shift count is the immediate form. The expected
// values come from a Python model of the same loops (generated once, see the numbers), so a wrong register or a wrong
// immediate shows on either machine.
//
//   mix   many live values, masks that ARE bitmask immediates (0xffffffff, 0xff, 0x00ff00ff, 0x5555..., 0xff00, 0xf0, 0xf)
//         and one that is NOT (3), narrow types (u8/u16/i32), constant shift counts 1, 3, 5, 7, 9, 13, 31, 63
//   sum9  nine parameters (the ninth on the stack) that must not land in a caller-saved register of the scan
import std.io

fn mix(seed: u64, n: u64) -> u64 {
    var a: u64 = seed & 4294967295
    var b: u64 = (seed >> 7) & 4294967295
    var c: u64 = (seed >> 13) & 4294967295
    var d: u64 = (seed >> 3) & 4294967295
    var e: u64 = seed ^ 6148914691236517205
    var f: u64 = (seed << 5) & 16711935
    var g: u64 = seed >> 1
    var h: u64 = (seed >> 11) & 255
    var acc: u64 = 0
    var i: u64 = 0
    while i < n {
        let t0: u64 = (a ^ 4294967295) & b
        let t1: u64 = ((c << 13) | (d >> 7)) & 4294967295
        let t2: u64 = (e & 255) | (f & 16711935)
        let t3: u64 = g ^ 6148914691236517205
        let t4: u64 = (h & 3) + (a & 65280)
        let t5: u64 = ((b >> 31) | (c << 1)) & 4294967295
        let n8: u8 = ((a >> 5) & 255) as u8
        let m8: u8 = (n8 ^ 15) & 240
        let s16: u16 = ((b >> 9) & 65535) as u16
        let m16: u16 = (s16 << 4) | (s16 >> 12)
        let v32: i32 = ((c >> 1) & 2147483647) as i32
        let m32: i32 = ((v32 & -256) ^ 4095) >> 3
        a = (t0 + t1) & 4294967295
        b = (t2 ^ t3) & 4294967295
        c = (t4 + t5) & 4294967295
        d = (d + t0) & 4294967295
        e = e ^ t1 ^ (m16 as u64)
        f = (f + t2) & 4294967295
        g = (g >> 1) ^ (t3 << 63) ^ ((m8 as u64) << 8)
        h = ((h + (m32 as u64)) & 255) | (t5 & 3)
        acc = acc ^ a ^ (b << 3) ^ c ^ d ^ e ^ f ^ g ^ h
        i = i + 1
    }
    return acc
}

fn sum9(p0: u64, p1: u64, p2: u64, p3: u64, p4: u64, p5: u64, p6: u64, p7: u64, p8: u64, n: u64) -> u64 {
    var q0: u64 = p0
    var q1: u64 = p1
    var q2: u64 = p2
    var q3: u64 = p3
    var q4: u64 = p4
    var q5: u64 = p5
    var q6: u64 = p6
    var q7: u64 = p7
    var acc: u64 = 0
    var i: u64 = 0
    while i < n {
        acc = acc ^ (q0 + i) ^ (q1 << 1) ^ (q2 + q3) ^ (q4 >> 1) ^ (q5 & 18374966859414961920) ^ (q6 | 3) ^ (q7 ^ i) ^ p8
        let t: u64 = q0
        q0 = q1
        q1 = q2
        q2 = q3
        q3 = q4
        q4 = q5
        q5 = q6
        q6 = q7
        q7 = t
        i = i + 1
    }
    return acc
}

fn main() -> i32 {
    var bad: i32 = 0
    if mix(88172645463325252, 300) != 12312536942469591832 { bad = bad + 1 }
    if mix(1234567890123456789, 300) != 14814724677926363118 { bad = bad + 1 }
    if mix(3, 300) != 734465004067285774 { bad = bad + 1 }
    if sum9(1, 2, 3, 4, 5, 6, 7, 8, 9, 200) != 28 { bad = bad + 1 }
    if sum9(76861433640456465, 1070935975390360080, 77, 99, 12345, 67890, 31337, 4242, 5, 200) != 1770163691284498559 { bad = bad + 1 }
    if bad != 0 { io.println_str("a64 leaf pool/immediates: mismatches") }
    return bad
}
