// expect_exit: 105
// 'enum' + 'match' in einem IMPORTIERTEN Modul (tests/modules/zustand.fi).
// Der Rumpf eines match-Falles ruft eine modulinterne Funktion und liest eine
// modulinterne Konstante — beides muss vom Modulsystem umgeschrieben werden.
// Anmerkung (SPEC §14.1): Aufzaehlungsnamen sind heute programmweit, nicht je
// Modul — deshalb 'Ampel::Rot' und nicht 'zustand.Ampel::Rot'.
import modules.zustand

fn main() -> i32 {
    var a: Ampel = Ampel::Rot
    var summe: i32 = 0
    var i: i32 = 0
    while i < 4 as i32 {
        summe = summe + zustand.dauer(a)
        a = zustand.schritt(a)
        i = i + 1
    }
    // 30 + 10 + 25 + 15 = 80, danach ist der Zyklus wieder bei Rot
    match a {
        Ampel::Rot => { summe = summe + 25 as i32 }
        Ampel::RotGelb => { summe = summe + 1 as i32 }
        Ampel::Gruen => { summe = summe + 2 as i32 }
        Ampel::Gelb => { summe = summe + 3 as i32 }
    }
    return summe
}
