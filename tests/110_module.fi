// expect_exit: 60
// Module system: import/export, access through 'module.name' (modules.rs).
import modules.math
import modules.text

fn square(a: i32) -> i32 {
    // same name as in module 'math' -- its own namespace
    return a + a
}

fn main() -> i32 {
    let a: i32 = math.square(7) // 49
    let b: i32 = square(2) // 4
    let c: i32 = math.DREI // 3
    let d: i32 = text.length(2) // 4 + 3 = 7
    let p: math.Dot = math.Dot { x: 1, y: 2 }
    return a + b + c + d - p.x - p.y // 49+4+3+7-3 = 60
}
