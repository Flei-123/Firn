// expect_exit: 60
// Modulsystem: import/export, Zugriff ueber 'modul.name' (modules.rs).
import modules.mathe
import modules.text

fn quadrat(a: i32) -> i32 {
    // gleicher Name wie im Modul 'mathe' — eigener Namensraum
    return a + a
}

fn main() -> i32 {
    let a: i32 = mathe.quadrat(7)      // 49
    let b: i32 = quadrat(2)            // 4
    let c: i32 = mathe.DREI            // 3
    let d: i32 = text.laenge(2)        // 4 + 3 = 7
    let p: mathe.Punkt = mathe.Punkt{ x: 1, y: 2 }
    return a + b + c + d - p.x - p.y   // 49+4+3+7-3 = 60
}
