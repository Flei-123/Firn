// expect_exit: 0
// G25: qualified generic calls next to `size_of[T]()` as an argument.
import modules.qgen

struct Pair { a: u8, b: u32 }

// a bare call next to the qualified ones; the local template also marks the
// file "not core" for the generics-free AST dump of parser_compare
fn local_id[T](a: T) -> T {
    return a
}

fn main() -> i32 {
    if local_id[usize](size_of[u32]()) != 4 as usize {
        return 3 as i32
    }
    let n: usize = qgen.twice[usize](size_of[i32]())
    if n != 8 as usize {
        return 1 as i32
    }
    let m: usize = qgen.pick[usize](size_of[u8](), size_of[Pair](), false)
    if m != 8 as usize {
        return 2 as i32
    }
    return 0 as i32
}
