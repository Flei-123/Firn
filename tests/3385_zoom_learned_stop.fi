// expect_out: ok
// tests/3385_zoom_learned_stop.fi -- plat.android.focusplan.learned_stop / switch_between: a tele lens learned at run time.
import std.io
import plat.android.focusplan

fn row_is(x: *mut [i32; 8], o: *mut [i32; 8], n: i32, wx: *mut [i32; 8], wo: *mut [i32; 8], wn: i32) -> bool {
    if n != wn { return false }
    var i: i32 = 0
    while i < wn {
        if (*x)[i as usize] != (*wx)[i as usize] || (*o)[i as usize] != (*wo)[i as usize] { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    // Xiaomi 14T Pro row from the real dump: 0.6o 1o 2d 3d 5d 8d, tele switch learned at 2.6x -> replaces the 3d stop
    var x: [i32; 8] = [6, 10, 20, 30, 50, 80, 0, 0]
    var o: [i32; 8] = [1, 1, 0, 0, 0, 0, 0, 0]
    var wx: [i32; 8] = [6, 10, 20, 26, 50, 80, 0, 0]
    var wo: [i32; 8] = [1, 1, 0, 1, 0, 0, 0, 0]
    let n1: i32 = focusplan.learned_stop((&x[0]) as u64, (&o[0]) as u64, 6, 6, 26)
    if !row_is(&x, &o, n1, &wx, &wo, 6) { io.print("A "); return 1 }
    // a switch far from any stop (4.4x, nothing within 30 %) in a full row: the nearest digital stop (5d) goes
    var x2: [i32; 8] = [6, 10, 20, 30, 50, 80, 0, 0]
    var o2: [i32; 8] = [1, 1, 0, 0, 0, 0, 0, 0]
    let n2: i32 = focusplan.learned_stop((&x2[0]) as u64, (&o2[0]) as u64, 6, 6, 100)
    // 10.0x is within 30 % of 8 -> replaces it
    if n2 != 6 || x2[5] != 100 || o2[5] != 1 { io.print("B "); return 2 }
    // room in the row: inserted in order
    var x3: [i32; 8] = [10, 80, 0, 0, 0, 0, 0, 0]
    var o3: [i32; 8] = [1, 0, 0, 0, 0, 0, 0, 0]
    let n3: i32 = focusplan.learned_stop((&x3[0]) as u64, (&o3[0]) as u64, 2, 6, 40)
    if n3 != 3 || x3[0] != 10 || x3[1] != 40 || x3[2] != 80 || o3[1] != 1 || o3[2] != 0 { io.print("C "); return 3 }
    // full row of lens stops only: nothing to drop, row unchanged
    var x4: [i32; 8] = [6, 10, 26, 0, 0, 0, 0, 0]
    var o4: [i32; 8] = [1, 1, 1, 0, 0, 0, 0, 0]
    let n4: i32 = focusplan.learned_stop((&x4[0]) as u64, (&o4[0]) as u64, 3, 3, 60)
    if n4 != 3 || x4[2] != 26 { io.print("D "); return 4 }
    // full row, new far stop: the nearest digital one is dropped, order kept
    var x5: [i32; 8] = [6, 10, 20, 30, 0, 0, 0, 0]
    var o5: [i32; 8] = [1, 1, 0, 0, 0, 0, 0, 0]
    let n5: i32 = focusplan.learned_stop((&x5[0]) as u64, (&o5[0]) as u64, 4, 4, 50)
    if n5 != 4 || x5[0] != 6 || x5[1] != 10 || x5[2] != 20 || x5[3] != 50 || o5[3] != 1 || o5[2] != 0 { io.print("E "); return 5 }
    // bisection: 1.0 (same) .. 3.0 (other) converges on the switch at 2.6
    var same: i32 = 10
    var diff: i32 = 30
    var steps: i32 = 0
    while steps < 20 {
        let m: i32 = focusplan.switch_between(same, diff)
        if m == 0 { break }
        if m >= 26 { diff = m } else { same = m }
        steps = steps + 1
    }
    if diff != 26 || steps > 6 { io.print("F "); return 6 }
    io.print("ok")
    return 0
}
