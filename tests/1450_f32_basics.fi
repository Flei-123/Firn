// expect_exit: 0
// tests/1450_f32_basics.fi -- `f32`, the second floating point type
// (SPEC 8.6, 14.1.f32, round 71).
//
// Without it you cannot read a WAV, an OBJ, a glTF, an STL or a GPU buffer:
// 32-bit floats stand in all of them. And it is not only a matter of
// reading -- a 128-bit SSE register holds FOUR of them and only two f64.
//
// What is checked here is the language: arithmetic, all six comparisons,
// the sign, the conversions, IEEE-754 in the awkward cases, and the second
// spelling `float`.

fn square(x: f32) -> f32 {
    return x * x
}

fn sum3(a: f32, b: f32, c: f32) -> f32 {
    return a + b + c
}

fn main() -> i32 {
    // --- basic arithmetic
    let a: f32 = 1.5
    let b: f32 = 2.25
    if a + b != 3.75 { return 1 }
    if b - a != 0.75 { return 2 }
    if a * b != 3.375 { return 3 }
    if b / a != 1.5 { return 4 }

    // --- comparisons (all six)
    if !(a < b) { return 5 }
    if !(a <= b) { return 6 }
    if !(b > a) { return 7 }
    if !(b >= a) { return 8 }
    if !(a != b) { return 9 }
    if !(a == 1.5) { return 10 }

    // --- change of sign: only bit 31 flips
    let n: f32 = 0.0 - a
    if n != 0.0 - 1.5 { return 11 }
    if 0.0 - n != a { return 12 }

    // --- function boundaries (arguments and result in xmm registers)
    if square(3.0) != 9.0 { return 13 }
    if sum3(1.0, 2.5, 0.25) != 3.75 { return 14 }

    // --- `float` is the second spelling of `f32` (SPEC 8.2)
    let c: float = 2.5
    if c != 2.5 { return 15 }
    if square(c) != 6.25 { return 16 }

    // --- the suffix, where no context says anything
    let d = 2.5f
    if d != c { return 17 }
    if 1.5f != a { return 18 }
    if 7f != 7.0 { return 19 }

    // --- conversions
    let i: i64 = 7
    if i as f32 != 7.0 { return 20 }
    if (3.99f as i64) != 3 { return 21 }
    // cutting towards zero, not rounding down
    if (0.0 - 3.99) as i32 != 0 - 3 { return 22 }
    let w: f64 = a as f64
    if w != 1.5 { return 23 }
    if (2.5 as f32) != c { return 24 }

    // --- the width is really four bytes. Measured on the ADDRESSES, not
    //     asked of `size_of`: two neighbouring elements of an array lie
    //     exactly one element apart, and that is the layout itself.
    var row: [f32; 2] = [0.0, 0.0]
    if ((&row[1]) as usize) - ((&row[0]) as usize) != 4 { return 25 }
    var wide: [f64; 2] = [0.0, 0.0]
    if ((&wide[1]) as usize) - ((&wide[0]) as usize) != 8 { return 26 }

    // --- notations
    if 1e3f != 1000.0 { return 27 }
    if 1.5e-1f != 0.15 { return 28 }
    if 1_000.5f != 1000.5 { return 29 }

    // --- IEEE-754: NaN equals NOTHING, not even itself
    let null: f32 = 0.0
    let nan: f32 = null / null
    if nan == nan { return 30 }
    if !(nan != nan) { return 31 }
    if nan < 1.0 { return 32 }
    if nan > 1.0 { return 33 }
    if nan >= nan { return 34 }

    // --- infinity
    let inf: f32 = 1.0 / null
    if !(inf > 3.0e38) { return 35 }
    if inf == 0.0 - inf { return 36 }

    // --- negative zero: `-0.0 == 0.0` is true (IEEE-754)
    let minus_null: f32 = 0.0 - 0.0
    if !(minus_null == 0.0) { return 37 }

    // --- the range is narrower than that of f64, and it shows
    let big: f32 = 3.4028235e38
    if !(big > 3.0e38) { return 38 }
    if !(big * 2.0 > big) { return 39 }
    if (1.0e-50 as f32) != 0.0 { return 40 }
    // the smallest subnormal is not zero
    let tiny: f32 = 1.0e-45
    if tiny == 0.0 { return 41 }
    if !(tiny > 0.0) { return 42 }

    // --- f32 really rounds: 0.1 as f32 is a different number from 0.1
    let tenth: f32 = 0.1
    if tenth as f64 == 0.1 { return 43 }

    return 0
}
