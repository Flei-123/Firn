// expect_out: math: gcd 6 lcm 12 ilog2 9 pot 1024 pow 3486784401 floor -3 round 3 fmod 15 hypot 5 ldexp 1024 frexp -1073
// tests/804_std_math_core.fi -- the EXACT part of `std.math` (round 42).
//
// Only what has to be right down to the last bit and is therefore checked
// with `==` stands here:
//   * integer: sign/min_u/max_u/clamp_u/abs_diff/gcd/lcm/ilog2/ilog10,
//     powers of two, pow_u
//   * floating point WITHOUT arithmetic: fabs/fmin/fmax/fclamp and above all
//     trunc/floor/ceil/round -- they cut bits off instead of adding 0.5,
//     and are therefore right at 2^52 and at 0.49999999999999994 as well
//   * fmod, ldexp, frexp, hypot: exact, because every intermediate number
//     lies on the same bit raster
//
// The approximated part (exp/ln/sin/cos/atan) is in tests/805 -- there it is
// checked against limits, not for equality.
import std.io
import std.math

fn main() -> i32 {
    // --- integer
    if math.sign(0 - 3) != 0 - 1 || math.sign(0) != 0 || math.sign(9) != 1 {
        return 10
    }
    if math.min_u(3, 9) != 3 || math.max_u(3, 9) != 9 {
        return 11
    }
    if math.clamp_u(12, 0, 10) != 10 || math.clamp_u(0, 3, 10) != 3 {
        return 12
    }
    if math.abs_diff(0 - 5, 5) != 10 {
        return 13
    }
    // The edge: |i64::MIN - i64::MAX| does not fit into i64, into u64 it does.
    if math.abs_diff(0 - 9223372036854775807 - 1, 9223372036854775807) != 18446744073709551615 {
        return 14
    }
    if math.gcd(48, 18) != 6 || math.gcd(17, 5) != 1 || math.gcd(0, 7) != 7 {
        return 15
    }
    if math.lcm(4, 6) != 12 || math.lcm(0, 5) != 0 {
        return 16
    }
    if math.ilog2(1) != 0 || math.ilog2(1023) != 9 || math.ilog2(1024) != 10 {
        return 17
    }
    if math.ilog10(0) != 0 || math.ilog10(999) != 2 || math.ilog10(1000) != 3 {
        return 18
    }
    if !math.is_pow_two(1024) || math.is_pow_two(1023) {
        return 19
    }
    if math.is_pow_two(0) {
        return 20
    }
    if math.next_pow_two(1000) != 1024 {
        return 21
    }
    if math.next_pow_two(1024) != 1024 || math.next_pow_two(0) != 1 {
        return 22
    }
    if math.next_pow_two(9223372036854775809) != 0 {
        return 23
    }
    if math.pow_u(3, 20) != 3486784401 || math.pow_u(2, 63) != 9223372036854775808 {
        return 24
    }
    if math.pow_u(7, 0) != 1 {
        return 25
    }
    // The round 39 names still hold unchanged.
    if math.abs(0 - 7) != 7 || math.clamp(12, 0, 10) != 10 || math.isqrt(17) != 4 {
        return 26
    }

    // --- floating point: selection and magnitude
    if math.fabs(0.0 - 2.5) != 2.5 || math.fabs(2.5) != 2.5 {
        return 30
    }
    if math.fmin(1.0, 2.0) != 1.0 || math.fmax(1.0, 2.0) != 2.0 {
        return 31
    }
    // NaN is passed over, not passed on -- otherwise a single NaN would poison
    // every minimum over a field.
    if math.fmin(math.NAN(), 3.0) != 3.0 || math.fmax(math.NAN(), 3.0) != 3.0 {
        return 32
    }
    if math.fclamp(5.0, 0.0, 1.0) != 1.0 {
        return 33
    }

    // --- cutting and rounding
    if math.trunc(2.7) != 2.0 || math.trunc(0.0 - 2.7) != 0.0 - 2.0 {
        return 40
    }
    if math.floor(2.7) != 2.0 || math.floor(0.0 - 2.7) != 0.0 - 3.0 {
        return 41
    }
    if math.ceil(2.1) != 3.0 || math.ceil(0.0 - 2.1) != 0.0 - 2.0 {
        return 42
    }
    if math.floor(3.0) != 3.0 || math.ceil(3.0) != 3.0 || math.trunc(3.0) != 3.0 {
        return 43
    }
    if math.round(0.5) != 1.0 || math.round(0.0 - 0.5) != 0.0 - 1.0 {
        return 44
    }
    if math.round(2.4) != 2.0 || math.round(2.5) != 3.0 {
        return 45
    }
    // The famous case: the LARGEST double below 0.5. `floor(x + 0.5)` would be
    // 1.0 here -- wrong. The value is built from the bit pattern instead of
    // being written as a 17-digit literal: firnc0 and firnc1 do not round such
    // literals alike (docs/ROUND42.md, section 5B).
    let tight_under_half: f64 = math.math_f64(math.math_bits(0.5) - 1)
    if tight_under_half >= 0.5 {
        return 46
    }
    if math.round(tight_under_half) != 0.0 {
        return 47
    }
    if math.floor(tight_under_half + 0.5) != 1.0 {
        return 48
    }
    // Beyond 2^52 no double has fractional digits any more.
    if math.trunc(4503599627370496.0) != 4503599627370496.0 {
        return 55
    }
    // The edge of the raster, WITHOUT a 17-digit literal: at 2^51 the distance
    // between two doubles is 0.5 -- there are real half numbers there, and
    // floor/ceil/round have to handle them correctly. (Literals like
    // 9007199254740993.0 are deliberately avoided here: firnc0 and firnc1
    // do not round 17-digit floating point literals alike, measured in
    // docs/ROUND42.md.)
    let two51: f64 = math.ldexp(1.0, 51)
    let half: f64 = two51 + 0.5
    if half == two51 {
        return 56
    }
    if math.floor(half) != two51 || math.trunc(half) != two51 {
        return 57
    }
    if math.ceil(half) != two51 + 1.0 || math.round(half) != two51 + 1.0 {
        return 58
    }

    // --- remainder, scaling, splitting
    if math.fmod(7.5, 2.0) != 1.5 {
        return 100
    }
    if math.fmod(0.0 - 7.5, 2.0) != 0.0 - 1.5 {
        return 101
    }
    if math.fmod(7.5, 0.0 - 2.0) != 1.5 {
        return 102
    }
    if math.fmod(1.0, 4.0) != 1.0 {
        return 103
    }
    if math.fmod(1.0e15, 3.0) != 1.0 {
        return 104
    }
    if !math.is_nan(math.fmod(1.0, 0.0)) {
        return 105
    }
    if math.ldexp(1.0, 10) != 1024.0 || math.ldexp(3.0, 0 - 2) != 0.75 {
        return 106
    }
    if math.ldexp(1.0, 0 - 1074) == 0.0 {
        return 107
    }
    if math.ldexp(1.0, 0 - 1075) != 0.0 {
        return 108
    }
    var e: i64 = 0
    if math.frexp(12.0, &e) != 0.75 || e != 4 {
        return 109
    }
    if math.frexp(0.0 - 0.5, &e) != 0.0 - 0.5 || e != 0 {
        return 110
    }
    // Subnormals: the exponent is not in the field and is only scaled up later.
    if math.frexp(math.ldexp(1.0, 0 - 1074), &e) != 0.5 || e != 0 - 1073 {
        return 111
    }
    if math.hypot(3.0, 4.0) != 5.0 || math.hypot(0.0, 0.0) != 0.0 {
        return 112
    }
    if math.hypot(0.0 - 3.0, 0.0 - 4.0) != 5.0 {
        return 113
    }

    // --- special values
    if !math.is_infinite(math.INF()) || math.is_finite(math.INF()) {
        return 120
    }
    if !math.is_nan(math.NAN()) || math.is_infinite(math.NAN()) {
        return 121
    }
    if !math.is_finite(1.0) || math.is_nan(1.0) {
        return 122
    }
    if math.EPSILON() + 1.0 == 1.0 {
        return 123
    }
    if math.EPSILON() / 2.0 + 1.0 != 1.0 {
        return 124
    }
    if math.math_bits(1.0) != 4607182418800017408 {
        return 125
    }
    if math.math_f64(4607182418800017408) != 1.0 {
        return 126
    }
    if !math.near(1.0, 1.0 + math.EPSILON(), 0.000000000000001) {
        return 127
    }
    if math.near(1.0, 1.1, 0.000000000000001) {
        return 128
    }

    // FINDING of round 42 (named, not rebuilt): a MODULE-QUALIFIED call in the
    // expression of an f"..." comes out differently in the canonical trees of
    // the two compilers -- firnc0 writes `str.npos`, firnc1 the internal name
    // `str__npos`. The behaviour is the same (the self comparison is EQUAL),
    // but tools/parser_compare.sh compares the tree octet for octet. That is
    // why the values stand in a binding here BEFORE the interpolation.
    // See docs/ROUND42.md, section 5C.
    let a_gcd: u64 = math.gcd(48, 18)
    let a_lcm: u64 = math.lcm(4, 6)
    let a_ilog2: usize = math.ilog2(1023)
    let a_pot: u64 = math.next_pow_two(1000)
    let a_pow: u64 = math.pow_u(3, 20)
    let a_floor: f64 = math.floor(0.0 - 2.7)
    let a_round: f64 = math.round(2.5)
    let a_fmod: f64 = math.fmod(7.5, 2.0) * 10.0
    let a_hypot: f64 = math.hypot(3.0, 4.0)
    let a_ldexp: f64 = math.ldexp(1.0, 10)
    io.fmt_print(f"math: gcd {a_gcd} lcm {a_lcm} ilog2 {a_ilog2} ")
    io.fmt_print(f"pot {a_pot} pow {a_pow} ")
    io.fmt_print(f"floor {a_floor} round {a_round} fmod {a_fmod} ")
    io.fmt_print(f"hypot {a_hypot} ldexp {a_ldexp} frexp {e}\n")
    return 0
}
