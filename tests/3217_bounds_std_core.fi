// expect_exit: 0
// THE STANDARD LIBRARY ORDERS THROUGH AN INTERFACE -- round 50.
//
// BEFORE (up to round 49): `fn vec_sort[T: Scalar]`, `a < b` in the body.
//   The comparison was hard-wired, so sorting only worked for scalars.
//   A `Vec[Person]` could be created and filled -- but not sorted, and
//   the error did not come from `vec_sort` but from an instantiated
//   copy of it ("operator '<' for struct").
//
// AFTER: `fn vec_sort[T: Ord]`, `a.less(b)` in the body. The order
//   sits at the type. For the basic types `lib/rt/vec.fi` brings it along;
//   every other type brings it itself, and in the order it
//   wants (here: age first, then number).
//
// This test drives both sides: the same functions once with `i32` and
// once with a struct.
import std.vec

struct Person {
    age: i64,
    tok_nr: i64,
}

// Two keys, descending by the second one would be just as possible --
// that is the point: the order belongs to the type, not to the sorter.
impl Ord for Person {
    fn less(*self, b: *Person) -> bool {
        if (*self).age != (*b).age {
            return (*self).age < (*b).age
        }
        return (*self).tok_nr < (*b).tok_nr
    }
}

fn p(age: i64, tok_nr: i64) -> Person {
    return Person { age: age, tok_nr: tok_nr }
}

fn main() -> i32 {
    // --- the old way, unchanged: scalars
    var z: Vec[i32] = vec_new[i32]()
    var i: i32 = 0
    while i < 20 {
        vec_push[i32](&z, (i * 7) % 20)
        i = i + 1
    }
    vec_sort[i32](&z)
    if !vec_is_sorted[i32](&z) {
        return 1
    }
    if vec_binary_search[i32](&z, 13) != 13 {
        return 2
    }
    if vec_binary_search[i32](&z, 99) != vec_len[i32](&z) {
        return 3
    }
    // two bounds on one parameter: `Scalar + Ord`
    if vec_min[i32](&z) != 0 || vec_max[i32](&z) != 19 {
        return 4
    }
    if !vec_sorted_insert[i32](&z, 10) {
        return 5
    }
    if !vec_is_sorted[i32](&z) || vec_len[i32](&z) != 21 {
        return 6
    }
    vec_free[i32](&z)

    // --- the new way: the same sorter, a struct
    var v: Vec[Person] = vec_new[Person]()
    vec_push[Person](&v, p(30, 2))
    vec_push[Person](&v, p(20, 9))
    vec_push[Person](&v, p(30, 1))
    vec_push[Person](&v, p(10, 7))
    vec_push[Person](&v, p(20, 3))
    if vec_len[Person](&v) != 5 {
        return 7
    }
    if vec_is_sorted[Person](&v) {
        return 8
    }
    vec_sort[Person](&v)
    if !vec_is_sorted[Person](&v) {
        return 9
    }
    // expected order: (10,7) (20,3) (20,9) (30,1) (30,2)
    let a0: *mut Person = vec_elem_ptr[Person](&v, 0)
    let a1: *mut Person = vec_elem_ptr[Person](&v, 1)
    let a2: *mut Person = vec_elem_ptr[Person](&v, 2)
    let a3: *mut Person = vec_elem_ptr[Person](&v, 3)
    let a4: *mut Person = vec_elem_ptr[Person](&v, 4)
    if (*a0).age != 10 || (*a0).tok_nr != 7 {
        return 10
    }
    if (*a1).age != 20 || (*a1).tok_nr != 3 {
        return 11
    }
    if (*a2).age != 20 || (*a2).tok_nr != 9 {
        return 12
    }
    if (*a3).age != 30 || (*a3).tok_nr != 1 {
        return 13
    }
    if (*a4).age != 30 || (*a4).tok_nr != 2 {
        return 14
    }
    // Binary search with the same order: equality is `!(a<b) && !(b<a)`
    if vec_binary_search[Person](&v, p(20, 9)) != 2 {
        return 15
    }
    if vec_binary_search[Person](&v, p(20, 8)) != vec_len[Person](&v) {
        return 16
    }
    if vec_lower_bound[Person](&v, p(20, 8)) != 2 {
        return 17
    }
    // sorted insert -- the order holds
    if !vec_sorted_insert[Person](&v, p(25, 5)) {
        return 18
    }
    if !vec_is_sorted[Person](&v) || vec_len[Person](&v) != 6 {
        return 19
    }
    let n2: *mut Person = vec_elem_ptr[Person](&v, 3)
    if (*n2).age != 25 || (*n2).tok_nr != 5 {
        return 20
    }
    // reversing and swapping now work for structs as well
    vec_invert[Person](&v)
    let r0: *mut Person = vec_elem_ptr[Person](&v, 0)
    if (*r0).age != 30 || (*r0).tok_nr != 2 {
        return 21
    }
    vec_free[Person](&v)
    return 0
}
