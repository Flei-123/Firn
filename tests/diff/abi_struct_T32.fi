// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
struct T32 {
    f0: i64,
    f1: i64,
    f2: i64,
    f3: i64,
}
fn make(k: i64) -> T32 {
    return T32 { f0: (k + 0) as i64, f1: (k + 1) as i64, f2: (k + 2) as i64, f3: (k + 3) as i64, }
}
fn total(s: T32) -> i64 {
    return (s.f0 as i64) + (s.f1 as i64) + (s.f2 as i64) + (s.f3 as i64)
}
fn bump(s: T32) -> T32 {
    var r: T32 = s
    r.f0 = r.f0 + 1
    return r
}
fn main() -> i32 {
    let a: T32 = make(5)
    let b: T32 = bump(a)
    put(total(a))
    put(total(b))
    put(total(bump(bump(make(9)))))
    let c: T32 = T32 { f0: 3, f1: 17, f2: 54, f3: 85, }
    put(total(c))
    return 0
}
