// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn classify(v: i64) -> i64 {
    if v < -50 { return -2 }
    if v < 0 { return -1 }
    if v == 0 { return 0 }
    if v < 50 { return 1 }
    if v < 1000 { return 2 }
    return 3
}
fn main() -> i32 {
    var x: u64 = 31337
    var hist: [i64; 6] = [0; 6]
    var i: u64 = 0
    while i < 50000 {
        x = x *% 6364136223846793005 +% 1442695040888963407
        let v: i64 = ((x >> 33) % 2200) as i64 - 300
        let c: i64 = classify(v)
        hist[(c + 2) as usize] = hist[(c + 2) as usize] + 1
        if c == 3 && v % 3 == 0 { hist[5] = hist[5] + 1 }
        i = i + 1
    }
    var k: usize = 0
    while k < 6 {
        put(hist[k])
        k = k + 1
    }
    return 0
}
