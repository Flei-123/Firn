// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn main() -> i32 {
    var a: [i64; 200] = [0; 200]
    var x: u64 = 9
    var i: usize = 0
    while i < 200 {
        x = x *% 6364136223846793005 +% 1442695040888963407
        a[i] = ((x >> 40) as i64) - 4000000
        i = i + 1
    }
    var n: usize = 200
    while n > 1 {
        var j: usize = 0
        while j + 1 < n {
            if a[j] > a[j + 1] {
                let t: i64 = a[j]
                a[j] = a[j + 1]
                a[j + 1] = t
            }
            j = j + 1
        }
        n = n - 1
    }
    put(a[0])
    put(a[200 / 2])
    put(a[200 - 1])
    var sum: i64 = 0
    var k: usize = 0
    while k < 200 {
        sum = sum + a[k] * ((k as i64) + 1)
        k = k + 1
    }
    put(sum)
    return 0
}
