// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn pick[T](a: T, b: T) -> T {
    if a > b { return a }
    return b
}
fn first[T](a: T, b: i32) -> T { return a }
fn id[T](v: T) -> T { return v }
fn main() -> i32 {
    let a: i64 = 5
    put(pick(a, 9))
    put(pick(2, 3) as i64)
    put(first(7, 1) as i64)
    put(id(2 + 3) as i64)
    return 0
}
