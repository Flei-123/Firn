// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
struct P { x: i64, y: i64 }
impl P {
    fn mul(*self, o: P) -> i64 { return (*self).x * o.x + (*self).y * o.y }
    fn add(*self, o: P) -> P { return P { x: (*self).x + o.x, y: (*self).y + o.y } }
    fn eq(*self, o: P) -> bool { return (*self).x == o.x && (*self).y == o.y }
    fn cmp(*self, o: P) -> i64 {
        if (*self).x < o.x { return 0 - 1 }
        if (*self).x > o.x { return 1 }
        return 0
    }
}
fn twice(p: P) -> P { return p + p }
fn main() -> i32 {
    let a: P = P { x: 2, y: 3 }
    let b: P = P { x: 4, y: 5 }
    put(a * b)
    let sum: P = a + b
    put(sum * a)
    put(twice(a).y)
    var acc: P = a
    acc = acc + b
    put(acc.x)
    let t: P = twice(a)
    let u: P = a + a
    if t == u { put(1) }
    if a < b && !(b < a) { put(2) }
    if a != a { put(3) }
    return 0
}
