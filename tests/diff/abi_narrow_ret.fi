// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn r8(x: i64) -> i8 { return x as i8 }
fn ru8(x: u64) -> u8 { return (x & 255) as u8 }
fn r16(x: i64) -> i16 { return (x & 32767) as i16 }
fn rb(x: i64) -> bool { return x > 3 }
fn main() -> i32 {
    put(r8(-100) as i64)
    put(ru8(1023) as i64)
    put(r16(70000) as i64)
    if rb(5) { put(1) } else { put(0) }
    return 0
}
