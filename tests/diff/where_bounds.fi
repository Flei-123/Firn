// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
interface Area { fn area(*self) -> i64 }
struct Sq { s: i64 }
impl Area for Sq {
    fn area(*self) -> i64 { return (*self).s * (*self).s }
}
fn total[T, U](a: *T, b: U) -> i64 where T: Area, U: Int {
    return a.area() + (b as i64)
}
fn pick[T](a: T, b: T) -> T where T: Int + Scalar {
    if a > b { return a }
    return b
}
fn main() -> i32 {
    let q: Sq = Sq { s: 4 }
    put(total[Sq, i32](&q, 3 as i32))
    put(pick[i32](5, 9) as i64)
    return 0
}
