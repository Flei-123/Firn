// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
enum Opt[T] { Some(T), None }
enum Out[T] { I(Opt[T]), O }
fn f(o: Out[i32]) -> i32 {
    match o {
        Out::I(Opt::Some(v)) => { return v }
        Out::I(Opt::None) => { return 1 }
        Out::O => { return 200 }
    }
    return 0
}
fn main() -> i32 {
    put(f(Out[i32]::O) as i64)
    put(f(Out[i32]::I(Opt[i32]::None)) as i64)
    return 0
}
