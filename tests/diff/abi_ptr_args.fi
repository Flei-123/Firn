// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn fill(p: *mut u8, n: usize, v: u8) {
    var i: usize = 0
    while i < n {
        p[i] = v + (i as u8)
        i = i + 1
    }
}
fn main() -> i32 {
    var b: [u8; 8] = [0; 8]
    fill(&b[0], 8, 10)
    var k: usize = 0
    while k < 8 {
        put(b[k] as i64)
        k = k + 1
    }
    return 0
}
