// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
enum Opt[T] { Some(T), None }
enum Pair[A, B] { Both(A, B), Left(A) }
fn main() -> i32 {
    let o = Opt::Some(4)
    match o {
        Opt::Some(x) => { put(x as i64) }
        Opt::None => { put(100) }
    }
    let big: i64 = 40
    let q = Opt::Some(big)
    match q {
        Opt::Some(x) => { put(x) }
        Opt::None => { put(100) }
    }
    let w: Opt[i64] = Opt::Some(3)
    match w {
        Opt::Some(x) => { put(x) }
        Opt::None => { put(100) }
    }
    let p = Pair::Both(1, true)
    match p {
        Pair::Both(a, b) => { if b { put(a as i64) } }
        Pair::Left(a) => { put(100) }
    }
    return 0
}
