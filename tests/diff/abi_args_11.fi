fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn f(a0: u32, a1: i32, a2: u16, a3: u64, a4: bool, a5: u32, a6: i32, a7: bool, a8: u32, a9: u8, a10: u64) -> i64 {
    var acc: i64 = 0
    acc = acc *% 31 +% (a0 as i64)
    acc = acc *% 31 +% (a1 as i64)
    acc = acc *% 31 +% (a2 as i64)
    acc = acc *% 31 +% (a3 as i64)
    acc = acc *% 31 +% ((a4 as u8) as i64)
    acc = acc *% 31 +% (a5 as i64)
    acc = acc *% 31 +% (a6 as i64)
    acc = acc *% 31 +% ((a7 as u8) as i64)
    acc = acc *% 31 +% (a8 as i64)
    acc = acc *% 31 +% (a9 as i64)
    acc = acc *% 31 +% (a10 as i64)
    return acc
}
fn main() -> i32 {
    put(f(4294967295, 1, 65535, 0, false, 0, (0 - 1), false, 2147483648, 26, 18446744073709551615))
    return 0
