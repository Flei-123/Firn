// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn main() -> i32 {
    var s: [u8; 50] = [1; 50]
    s[0] = 0
    s[1] = 0
    var i: usize = 2
    while i * i < 50 {
        if s[i] == 1 {
            var j: usize = i * i
            while j < 50 {
                s[j] = 0
                j = j + i
            }
        }
        i = i + 1
    }
    var c: u64 = 0
    var k: usize = 0
    while k < 50 {
        c = c + (s[k] as u64)
        k = k + 1
    }
    putu(c)
    return 0
}
