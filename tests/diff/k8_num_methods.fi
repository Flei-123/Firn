// diff: run
// levels: same
fn main() -> i32 {
    var bad: i32 = 0
    let a: i32 = 0 - 5
    let b: i64 = 0 - 9
    let n: usize = 7
    let x: f64 = 2.25
    let y: f64 = 0.0 - 2.5
    if a.abs() != 5 { bad = bad + 1 }
    if a.max(3) != 3 || a.min(3) != a { bad = bad + 2 }
    if a.clamp(0, 10) != 0 || (12 - a).clamp(0, 10) != 10 { bad = bad + 4 }
    if b.abs() != 9 || b.pow(2) != 81 { bad = bad + 8 }
    if n.min(3) != 3 || n.max(9) != 9 || n.clamp(1, 5) != 5 { bad = bad + 16 }
    if x.sqrt() != 1.5 { bad = bad + 32 }
    if y.abs() != 2.5 || y.floor() != 0.0 - 3.0 || y.ceil() != 0.0 - 2.0 || y.round() != 0.0 - 3.0 { bad = bad + 64 }
    if x.pow(2.0) != 5.0625 { bad = bad + 128 }
    if x.to_int() != 2 { bad = bad + 256 }
    if x.min(1.0) != 1.0 || x.max(3.0) != 3.0 || x.clamp(0.0, 2.0) != 2.0 { bad = bad + 512 }
    let z: f64 = 0.0
    if z.sin() != 0.0 || z.cos() != 1.0 { bad = bad + 1024 }
    if math.sqrt(x) != 1.5 { bad = bad + 2048 }
    return bad
}
