// diff: run
// levels: same
enum Opt[T] { Some(T), None }
enum Res[T, E] { Ok(T), Err(E) }

fn pick[T](o: Opt[T], d: T) -> T {
    match o {
        Opt::Some(v) => { return v }
        Opt::None => { return d }
    }
    return d
}

fn bucket[T](x: T) -> i32 {
    var r: i32 = 0
    match x as i64 {
        0 => { r = 10 }
        1..=9 => { r = 20 }
        _ => { r = 30 }
    }
    return r
}

fn unwrap_res[T, E](r: Res[T, E], d: T) -> T {
    match r {
        Res::Ok(v) => { return v }
        Res::Err(_) => { return d }
    }
    return d
}

fn main() -> i32 {
    let a: Opt[i32] = Opt::Some(5)
    let b: Opt[u8] = Opt::None
    if pick[i32](a, 9) != 5 { return 1 }
    if pick[u8](b, 7 as u8) != 7 as u8 { return 2 }
    if bucket[i32](0) != 10 { return 3 }
    if bucket[u8](4 as u8) != 20 { return 4 }
    if bucket[i64](99) != 30 { return 5 }
    let r: Res[i32, bool] = Res::Err(true)
    if unwrap_res[i32, bool](r, 11) != 11 { return 9 }
    return 0
}
