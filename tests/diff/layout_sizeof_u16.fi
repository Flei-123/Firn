fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
struct A { a: u16 }
struct B { a: u16, b: u16 }
struct C { a: u8, b: u16 }
struct D { a: u16, b: u8 }
fn main() -> i32 {
    putu(size_of[u16]())
    putu(size_of[A]())
    putu(size_of[B]())
    putu(size_of[C]())
    putu(size_of[D]())
    return 0
}
