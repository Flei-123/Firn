// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn main() -> i32 {
    var a: [i64; 16] = [0; 16]
    var b: [i64; 16] = [0; 16]
    var c: [i64; 16] = [0; 16]
    var i: usize = 0
    while i < 16 {
        a[i] = ((i * 7 + 3) % 17) as i64 - 8
        b[i] = ((i * 2 + 5) % 13) as i64 - 6
        i = i + 1
    }
    var r: usize = 0
    while r < 4 {
        var q: usize = 0
        while q < 4 {
            var acc: i64 = 0
            var k: usize = 0
            while k < 4 {
                acc = acc + a[r * 4 + k] * b[k * 4 + q]
                k = k + 1
            }
            c[r * 4 + q] = acc
            q = q + 1
        }
        r = r + 1
    }
    var t: i64 = 0
    var z: usize = 0
    while z < 16 {
        t = t * 7 + c[z]
        z = z + 1
    }
    put(t)
    put(c[5])
    return 0
}
