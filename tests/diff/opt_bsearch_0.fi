// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn main() -> i32 {
    var a: [i32; 10] = [0; 10]
    var i: usize = 0
    while i < 10 {
        a[i] = (i as i32) * 3 - 100
        i = i + 1
    }
    var found: i64 = 0
    var t: i32 = -150
    while t < 10 * 3 {
        var lo: usize = 0
        var hi: usize = 10
        while lo < hi {
            let mid: usize = lo + (hi - lo) / 2
            if a[mid] < t { lo = mid + 1 } else { hi = mid }
        }
        if lo < 10 {
            if a[lo] == t { found = found + 1 }
        }
        t = t + 1
    }
    put(found)
    return 0
}
