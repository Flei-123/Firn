// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
interface Counter {
    type Item
    fn next(*mut self) -> Self::Item
}
struct Up { n: i32 }
struct Down { n: i64 }
impl Counter for Up {
    type Item = i32
    fn next(*mut self) -> Self::Item {
        (*self).n = (*self).n + 1
        return (*self).n
    }
}
impl Counter for Down {
    type Item = i64
    fn next(*mut self) -> i64 {
        (*self).n = (*self).n - 1
        return (*self).n
    }
}
fn two[T: Counter](c: *mut T) -> T::Item {
    let a: T::Item = c.next()
    let b: T::Item = c.next()
    return b
}
fn main() -> i32 {
    var u = Up { n: 0 }
    var d = Down { n: 10 }
    put(two[Up](&u) as i64)
    put(two[Down](&d))
    return 0
}
