// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
struct Box[T] { value: T, count: i32 }
impl Box[T] {
    fn get(*self) -> T { return (*self).value }
    fn set(*mut self, v: T) {
        (*self).value = v
        (*self).count = (*self).count + 1
    }
}
fn main() -> i32 {
    var a: Box[i32] = Box[i32] { value: 7, count: 0 }
    a.set(a.get() + 2)
    put(a.get() as i64)
    put(a.count as i64)
    var b: Box[u8] = Box[u8] { value: 200 as u8, count: 0 }
    b.set(b.get() + 5 as u8)
    put(b.get() as i64)
    return 0
}
