// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
interface Shape {
    fn area(*self) -> i64
    fn double_area(*self) -> i64 { return self.area() * 2 }
}
struct Sq { s: i64 }
struct Dot { x: i64 }
impl Shape for Sq {
    fn area(*self) -> i64 { return (*self).s * (*self).s }
}
impl Shape for Dot {
    fn area(*self) -> i64 { return (*self).x }
}
fn twice(x: dyn Shape) -> i64 { return x.double_area() }
fn main() -> i32 {
    let a: Sq = Sq { s: 3 }
    let d: Dot = Dot { x: 7 }
    put(twice((&a) as dyn Shape))
    put(twice((&d) as dyn Shape))
    return 0
}
