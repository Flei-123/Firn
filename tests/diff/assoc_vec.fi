fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
import std.vec
interface Source {
    type Item
    fn get(*self, i: i32) -> Self::Item
    fn size(*self) -> i32
}
struct Evens { n: i32 }
impl Source for Evens {
    type Item = i64
    fn get(*self, i: i32) -> i64 { return (i as i64) * 2 }
    fn size(*self) -> i32 { return (*self).n }
}
fn collect[S: Source](s: *S) -> Vec[S::Item] {
    var out: Vec[S::Item] = vec_new[S::Item]()
    var i = 0
    while i < s.size() {
        vec_push[S::Item](&out, s.get(i))
        i = i + 1
    }
    return out
}
fn main() -> i32 {
    let e = Evens { n: 4 }
    var v = collect[Evens](&e)
    put(vec_len[i64](&v) as i64)
    put(vec_at[i64](&v, 3))
    return 0
}
