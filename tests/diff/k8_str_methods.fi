// diff: run
// levels: same
fn check(got: str, want: str, code: i32) -> i32 {
    if got == want { return 0 }
    return code
}

fn main() -> i32 {
    var bad: i32 = 0
    let s: str = "  Hello World  "
    bad = bad + check(s.trim(), "Hello World", 1)
    bad = bad + check(s.to_upper(), "  HELLO WORLD  ", 2)
    bad = bad + check(s.to_lower(), "  hello world  ", 4)
    bad = bad + check(s.replace("o", "0"), "  Hell0 W0rld  ", 8)
    let parts = s.trim().split(" ")
    if parts.len() != 2 { bad = bad + 16 }
    bad = bad + check(",".join(parts), "Hello,World", 32)
    bad = bad + check(s.trim().pad_left(13), "  Hello World", 64)
    bad = bad + check(s.trim().pad_right(13, 46), "Hello World..", 128)
    bad = bad + check(s.trim().substring(6, 5), "World", 256)
    bad = bad + check(s.trim().substring(6, 99), "World", 512)
    if s.index_of("World") != 8 { bad = bad + 1024 }
    if s.index_of("xyz") != -1 { bad = bad + 2048 }
    bad = bad + check("ab".repeat(3), "ababab", 4096)
    if "h\u{e9}llo".char_count() != 5 { bad = bad + 8192 }
    if !s.contains("World") || !s.trim().starts_with("Hello") || !s.trim().ends_with("World") { bad = bad + 16384 }
    if "".is_empty() == false { bad = bad + 32768 }
    return bad
}
