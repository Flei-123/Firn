// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn steps(n: u64) -> u64 {
    var x: u64 = n
    var c: u64 = 0
    while x != 1 {
        if x % 2 == 0 { x = x / 2 } else { x = 3 * x + 1 }
        c = c + 1
    }
    return c
}
fn main() -> i32 {
    var best: u64 = 0
    var arg: u64 = 0
    var n: u64 = 27
    while n < 28 {
        let s: u64 = steps(n)
        if s > best {
            best = s
            arg = n
        }
        n = n + 1
    }
    putu(arg)
    putu(best)
    return 0
}
