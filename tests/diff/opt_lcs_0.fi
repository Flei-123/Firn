// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn main() -> i32 {
    var s1: [u8; 8] = [0; 8]
    var s2: [u8; 8] = [0; 8]
    var x: u64 = 1
    var i: usize = 0
    while i < 8 {
        x = x *% 6364136223846793005 +% 1442695040888963407
        s1[i] = ((x >> 50) % 4) as u8
        x = x *% 6364136223846793005 +% 1442695040888963407
        s2[i] = ((x >> 50) % 4) as u8
        i = i + 1
    }
    var dp: [u32; (8 + 1) * (8 + 1)] = [0; (8 + 1) * (8 + 1)]
    var r: usize = 1
    while r <= 8 {
        var q: usize = 1
        while q <= 8 {
            let w: usize = 8 + 1
            if s1[r - 1] == s2[q - 1] {
                dp[r * w + q] = dp[(r - 1) * w + q - 1] + 1
            } else {
                let up: u32 = dp[(r - 1) * w + q]
                let lf: u32 = dp[r * w + q - 1]
                if up > lf { dp[r * w + q] = up } else { dp[r * w + q] = lf }
            }
            q = q + 1
        }
        r = r + 1
    }
    putu(dp[8 * (8 + 1) + 8] as u64)
    return 0
}
