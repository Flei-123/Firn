// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
struct T12 {
    f0: u32,
    f1: u32,
    f2: u32,
}
fn make(k: i64) -> T12 {
    return T12 { f0: (k + 0) as u32, f1: (k + 1) as u32, f2: (k + 2) as u32, }
}
fn total(s: T12) -> i64 {
    return (s.f0 as i64) + (s.f1 as i64) + (s.f2 as i64)
}
fn bump(s: T12) -> T12 {
    var r: T12 = s
    r.f0 = r.f0 + 1
    return r
}
fn main() -> i32 {
    let a: T12 = make(5)
    let b: T12 = bump(a)
    put(total(a))
    put(total(b))
    put(total(bump(bump(make(9)))))
    let c: T12 = T12 { f0: 54, f1: 44, f2: 27, }
    put(total(c))
    return 0
}
