// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
struct Q { a: i64, b: i64 }
struct Big { a: i64, b: i64, c: i64, d: i64 }
fn mix(x: i32, q: Q, y: i32, g: Big, z: i32, w: i32, v: u8, u: i16) -> i64 {
    return q.a + q.b * 3 + g.a + g.b * 5 + g.c + g.d * 7 + (x + y + z + w) as i64 + (v as i64) * 11 + (u as i64)
}
fn main() -> i32 {
    let q: Q = Q { a: 34, b: -13 }
    let g: Big = Big { a: -20, b: -32, c: 18, d: 42 }
    put(mix(-1, q, 9, g, -8, 7, 0, -32768))
    return 0
}
