// diff: run
// levels: same
const fn wrap_u8(x: i32) -> u8 {
    var v: u8 = 250
    v += x as u8
    return v
}
const fn wrap_i8(x: i32) -> i8 {
    var v: i8 = 120
    v += x as i8
    return v
}
const fn wrap_u16(x: i32) -> u16 {
    return (x * 70000) as u16
}
const fn bit_mix(seed: u32) -> u32 {
    var h: u32 = seed
    h = h ^ (h << 13)
    h = h ^ (h >> 17)
    h = h ^ (h << 5)
    return h
}
const fn flags(x: i32) -> bool {
    return x > 3 && x < 9
}
const fn fib(n: i32) -> i32 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}
const fn pascal() -> [[u32; 6]; 6] {
    var t: [[u32; 6]; 6] = [[0 as u32; 6]; 6]
    for r in 0..6 {
        t[r as usize][0] = 1
        for c in 1..=r {
            t[r as usize][c as usize] = t[(r - 1) as usize][(c - 1) as usize] + t[(r - 1) as usize][c as usize]
        }
    }
    return t
}
const fn bump(a: [i32; 4]) -> i32 {
    var b: [i32; 4] = a
    b[0] += 100
    return b[0]
}
const fn untouched() -> i32 {
    var a: [i32; 4] = [1, 2, 3, 4]
    let r: i32 = bump(a)
    return r + a[0]
}
const fn first_even(limit: i32) -> i32 {
    var i: i32 = 1
    var found: i32 = -1
    while i < limit {
        i += 1
        if i % 2 == 1 {
            continue
        }
        found = i
        break
    }
    return found
}
const fn countdown() -> i32 {
    var n: i32 = 10
    var steps: i32 = 0
    while n > 0 {
        n--
        steps++
    }
    return steps
}
const A8: u8 = wrap_u8(10)
const B8: i8 = wrap_i8(10)
const C16: u16 = wrap_u16(3)
const MIX: u32 = bit_mix(2463534242)
const FL: bool = flags(5)
const F12: i32 = fib(12)
const U: i32 = untouched()
const FE: i32 = first_even(50)
const CD: i32 = countdown()
static PT: [[u32; 6]; 6] = pascal()
static BIG: [u8; 300] = [7; 300]
fn main() -> i32 {
    var bad: i32 = 0
    if A8 != 4 { bad += 1 }
    if B8 != -126 { bad += 2 }
    if C16 != 13392 { bad += 4 }
    var h: u32 = 2463534242
    h = h ^ (h << 13)
    h = h ^ (h >> 17)
    h = h ^ (h << 5)
    if MIX != h { bad += 8 }
    if !FL { bad += 16 }
    if F12 != 144 { bad += 32 }
    if U != 102 { bad += 64 }
    if FE != 2 { bad += 128 }
    if CD != 10 { bad += 256 }
    if PT[5][2] != 10 { bad += 512 }
    if PT[4][4] != 1 { bad += 1024 }
    if BIG[299] != 7 { bad += 2048 }
    if bad != 0 { return 1 }
    return 0
}
