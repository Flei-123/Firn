// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
enum Opt[T] { Some(T), None }
fn find(v: i32) -> Opt[i32] {
    if v > 0 { return Opt::Some(v) }
    return Opt::None
}
fn main() -> i32 {
    var total: i64 = 0
    match find(5) {
        Opt::Some(x) => { total = total + (x as i64) }
        Opt::None => { total = total + 100 }
    }
    match find(0 - 1) {
        Opt::Some(x) => { total = total + (x as i64) }
        Opt::None => { total = total + 1000 }
    }
    let c: Opt[i64] = Opt[i64]::Some(40)
    match c {
        Opt::Some(f) => { total = total + f }
        Opt::None => { total = total + 1 }
    }
    put(total)
    return 0
}
