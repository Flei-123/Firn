// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
struct T40 {
    f0: i64,
    f1: u32,
    f2: i64,
    f3: u8,
    f4: i64,
    f5: i16,
}
fn make(k: i64) -> T40 {
    return T40 { f0: (k + 0) as i64, f1: (k + 1) as u32, f2: (k + 2) as i64, f3: (k + 3) as u8, f4: (k + 4) as i64, f5: (k + 5) as i16, }
}
fn total(s: T40) -> i64 {
    return (s.f0 as i64) + (s.f1 as i64) + (s.f2 as i64) + (s.f3 as i64) + (s.f4 as i64) + (s.f5 as i64)
}
fn bump(s: T40) -> T40 {
    var r: T40 = s
    r.f0 = r.f0 + 1
    return r
}
fn main() -> i32 {
    let a: T40 = make(5)
    let b: T40 = bump(a)
    put(total(a))
    put(total(b))
    put(total(bump(bump(make(9)))))
    let c: T40 = T40 { f0: 44, f1: 78, f2: 43, f3: 54, f4: 49, f5: 75, }
    put(total(c))
    return 0
}
