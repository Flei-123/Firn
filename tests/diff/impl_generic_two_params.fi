// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
struct Pair[A, B] { first: A, second: B }
impl Pair[A, B] {
    fn swapped(*self) -> Pair[B, A] {
        return Pair[B, A] { first: (*self).second, second: (*self).first }
    }
    fn second_of(*self) -> B { return (*self).second }
}
fn main() -> i32 {
    var p: Pair[i32, i64] = Pair[i32, i64] { first: 5, second: 90 }
    let q: Pair[i64, i32] = p.swapped()
    put(q.first)
    put(q.second_of() as i64)
    put(p.second_of())
    return 0
}
