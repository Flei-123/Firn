// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn main() -> i32 {
    var v = Vec[int].new()
    v.push(3)
    v.push(1)
    v.push(2)
    v.sort()
    v.insert(1, 9)
    let removed: int = v.remove_at(1)
    v.reverse()
    put((v.get(0) * 100 + v.last() * 10 + v.len() as int + removed) as i64)
    return 0
}
