// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
enum Res[T, E] { Ok(T), Err(E) }
fn div(a: i32, b: i32) -> Res[i32, bool] {
    if b == 0 { return Res::Err(true) }
    return Res::Ok(a / b)
}
fn main() -> i32 {
    match div(10, 2) {
        Res::Ok(q) => { put(q as i64) }
        Res::Err(e) => { put(0 - 1) }
    }
    match div(1, 0) {
        Res::Ok(q) => { put(q as i64) }
        Res::Err(e) => { if e { put(77) } }
    }
    return 0
}
