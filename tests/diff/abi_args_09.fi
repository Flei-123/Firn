fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn f(a0: i32, a1: u8, a2: i32, a3: u32, a4: u16, a5: i16, a6: i16, a7: u8, a8: i16) -> i64 {
    var acc: i64 = 0
    acc = acc *% 31 +% (a0 as i64)
    acc = acc *% 31 +% (a1 as i64)
    acc = acc *% 31 +% (a2 as i64)
    acc = acc *% 31 +% (a3 as i64)
    acc = acc *% 31 +% (a4 as i64)
    acc = acc *% 31 +% (a5 as i64)
    acc = acc *% 31 +% (a6 as i64)
    acc = acc *% 31 +% (a7 as i64)
    acc = acc *% 31 +% (a8 as i64)
    return acc
}
fn main() -> i32 {
    put(f(0, 125, 2147483647, 4294967295, 0, 1, 1, 1, (0 - 4807)))
