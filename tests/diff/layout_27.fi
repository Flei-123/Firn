// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
struct S {
    f0: i32,
    f1: u16,
    f2: i16,
    f3: u8,
    f4: u64,
}
fn main() -> i32 {
    var s: S = S { f0: 1, f1: 2, f2: 3, f3: 4, f4: 5, }
    let base: u64 = (&s.f0) as u64
    putu((&s.f1) as u64 - base)
    putu((&s.f2) as u64 - base)
    putu((&s.f3) as u64 - base)
    putu((&s.f4) as u64 - base)
    putu(size_of[S]() as u64)
    var arr: [S; 2] = [s, s]
    putu((&arr[1].f0) as u64 - (&arr[0].f0) as u64)
    return 0
}
