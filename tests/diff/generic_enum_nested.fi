// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
enum Wrap[T] { Item(T), Nothing }
fn nested(w: Wrap[Wrap[i32]]) -> i32 {
    match w {
        Wrap::Item(Wrap::Item(v)) => { return v }
        Wrap::Item(_) => { return 2 }
        Wrap::Nothing => { return 3 }
    }
    return 0
}
fn main() -> i32 {
    let inner: Wrap[i32] = Wrap::Item(42)
    let outer: Wrap[Wrap[i32]] = Wrap::Item(inner)
    put(nested(outer) as i64)
    let outer2: Wrap[Wrap[i32]] = Wrap::Item(Wrap::Nothing)
    put(nested(outer2) as i64)
    return 0
}
