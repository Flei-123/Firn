// diff: run
// levels: same
import std.io
#[derive(Debug, Eq, Ord, Hash, Clone, Default)]
struct P { x: i32, name: str, ok: bool }

#[derive(Debug, Eq, Clone)]
struct Pair[A, B] { first: A, second: B }

#[derive(Debug, Hash, Clone)]
enum E { A, B(i32, bool), C(str) }

#[derive(Debug, Eq, Hash, Clone)]
struct Outer { p: P, n: i32 }

fn main() -> i32 {
    if !gc_init() { return 99 }
    let a = P { x: 1, name: "n", ok: true }
    let b = a.clone()
    if a != b { return 1 }
    if a.debug() != "P { x: 1, name: \"n\", ok: true }" { return 2 }
    if a.hash() != b.hash() { return 3 }
    let c = P { x: 2, name: "n", ok: true }
    if !(a < c) { return 4 }
    if a > c { return 5 }
    let d = default_P()
    if d.x != 0 || d.name != "" { return 6 }
    let pr = Pair[i32, bool] { first: 3, second: true }
    if pr.debug() != "Pair { first: 3, second: true }" { return 7 }
    if pr != pr.clone() { return 8 }
    let e1 = E::B(1, true)
    let e2 = e1.clone()
    if e1.debug() != "B(1, true)" { return 11 }
    let ec = E::C("z")
    let ea = E::A
    if ec.debug() != "C(\"z\")" { return 12 }
    if ea.debug() != "A" { return 13 }
    if e1.hash() != e2.hash() { return 15 }
    if e1.hash() == ea.hash() { return 16 }
    let o = Outer { p: a, n: 7 }
    if o.debug() != "Outer { p: P { x: 1, name: \"n\", ok: true }, n: 7 }" { return 17 }
    if o != o.clone() { return 18 }
    let o2 = o.clone()
    if o.hash() != o2.hash() { return 19 }
    io.print_str(o.debug())
    io.print_str("\n")
    io.print_str(ea.debug())
    io.print_str("\n")
    io.print_str(e1.debug())
    io.print_str("\n")
    io.print_str(pr.debug())
    io.print_str("\n")
    return 0
}
