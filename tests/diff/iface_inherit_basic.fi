// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
interface Named {
    fn id(*self) -> i64
}
interface Shape: Named {
    fn area(*self) -> i64
    fn tag(*self) -> i64 { return self.id() * 100 + self.area() }
}
struct Sq { s: i64 }
struct Dot { x: i64 }
impl Named for Sq {
    fn id(*self) -> i64 { return 1 }
}
impl Shape for Sq {
    fn area(*self) -> i64 { return (*self).s * (*self).s }
}
impl Named for Dot {
    fn id(*self) -> i64 { return 2 }
}
impl Shape for Dot {
    fn area(*self) -> i64 { return (*self).x }
}
fn both(x: dyn Shape) -> i64 { return x.id() * 1000 + x.area() }
fn bound[T: Shape](x: *T) -> i64 { return x.id() + x.area() }
fn main() -> i32 {
    let a: Sq = Sq { s: 3 }
    let d: Dot = Dot { x: 7 }
    put(both((&a) as dyn Shape))
    put(both((&d) as dyn Shape))
    put(bound[Sq](&a))
    put(bound[Dot](&d))
    put(a.tag())
    return 0
}
