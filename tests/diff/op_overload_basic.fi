// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
struct V2 { x: i64, y: i64 }
impl V2 {
    fn add(self, o: V2) -> V2 { return V2 { x: self.x + o.x, y: self.y + o.y } }
    fn sub(self, o: V2) -> V2 { return V2 { x: self.x - o.x, y: self.y - o.y } }
    fn mul(self, k: i64) -> V2 { return V2 { x: self.x * k, y: self.y * k } }
    fn neg(self) -> V2 { return V2 { x: 0 - self.x, y: 0 - self.y } }
    fn eq(self, o: V2) -> bool { return self.x == o.x && self.y == o.y }
    fn cmp(self, o: V2) -> i64 { return self.x - o.x }
}
fn main() -> i32 {
    let a: V2 = V2 { x: 1, y: 2 }
    let b: V2 = V2 { x: 3, y: 5 }
    let c: V2 = a + b + a
    put(c.x)
    put(c.y)
    let d: V2 = (b - a) * 3
    put(d.x)
    put(d.y)
    let n: V2 = -a
    put(n.x)
    if a == a { put(1) }
    if a != b { put(2) }
    if a < b { put(3) }
    if b >= a { put(4) }
    if b <= a { put(5) }
    return 0
}
