// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
#[align(16)]
struct A {
    a: u8,
}
#[align(64)]
struct B {
    a: u8,
    b: u32,
}
#[packed]
#[align(8)]
struct D {
    a: u8,
    b: u32,
}
struct W {
    x: u8,
    b: B,
    y: u8,
}
fn first(b: B) -> u8 {
    return b.a
}
fn main() -> i32 {
    putu(size_of[A]() as u64)
    putu(size_of[B]() as u64)
    putu(size_of[D]() as u64)
    putu(size_of[W]() as u64)
    var b: B = B { a: 9, b: 8 }
    putu((&b) as u64 % 64)
    var arr: [B; 3] = [b, b, b]
    putu((&arr[0]) as u64 % 64)
    putu((&arr[2]) as u64 % 64)
    putu((&arr[2]) as u64 - (&arr[0]) as u64)
    var w: W = W { x: 1, b: b, y: 2 }
    putu((&w) as u64 % 64)
    putu((&w.b) as u64 - (&w) as u64)
    putu((&w.y) as u64 - (&w) as u64)
    putu(first(b) as u64)
    var d: D = D { a: 1, b: 2 }
    putu((&d.b) as u64 - (&d.a) as u64)
    putu(d.b as u64)
    return 0
}
