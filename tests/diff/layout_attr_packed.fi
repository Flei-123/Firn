// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
#[packed]
struct P {
    a: u8,
    b: u32,
    c: u16,
    d: u64,
}
#[packed]
struct Q {
    a: u8,
    f: f64,
    g: f32,
}
struct W {
    x: u8,
    p: P,
    y: u8,
}
fn total(p: P) -> u64 {
    return (p.a as u64) + (p.b as u64) + (p.c as u64) + p.d
}
fn main() -> i32 {
    var p: P = P { a: 1, b: 2, c: 3, d: 4 }
    let base: u64 = (&p.a) as u64
    putu(size_of[P]() as u64)
    putu(size_of[Q]() as u64)
    putu(size_of[W]() as u64)
    putu((&p.b) as u64 - base)
    putu((&p.c) as u64 - base)
    putu((&p.d) as u64 - base)
    p.b = 0x01020304
    p.d = 0x0102030405060708
    p.c = 0xABCD
    putu(p.a as u64)
    putu(p.b as u64)
    putu(p.c as u64)
    putu(p.d)
    var arr: [P; 2] = [p, p]
    arr[1].d = 99
    putu((&arr[1].a) as u64 - (&arr[0].a) as u64)
    putu(arr[0].d)
    putu(arr[1].d)
    putu(total(p))
    var q: Q = Q { a: 7, f: 2.5, g: 4.0 }
    q.f = 1.5
    putu(q.a as u64)
    putu((q.f * 2.0) as u64)
    putu((q.g * 2.0) as u64)
    var w: W = W { x: 5, p: p, y: 6 }
    let wb: u64 = (&w.x) as u64
    putu((&w.p) as u64 - wb)
    putu((&w.y) as u64 - wb)
    putu(w.p.d)
    return 0
}
