// diff: run
fn f() -> i32 {
    var total: i32 = 0
    defer {
        var i: i32 = 0
        while i < 4 {
            i = i + 1
            if i == 2 {
                continue
            }
            if i == 4 {
                break
            }
            total = total + i
        }
    }
    return 7
}

fn main() -> i32 {
    return f()
}
