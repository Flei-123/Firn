// diff: run
// levels: same
import std.chars

fn main() -> i32 {
    var bad: i32 = 0
    let s: str = "héllo €\u{1F600}!"
    if chars.count(s) != 9 { bad = bad + 1 }
    if chars.at(s, 1) != 'é' { bad = bad + 2 }
    if chars.at(s, 7) != '\u{1F600}' { bad = bad + 4 }
    if chars.at(s, 99) != 0 { bad = bad + 8 }
    var it: chars.CharIter = chars.iter(s)
    var sum: u32 = 0
    var n: usize = 0
    while chars.next(&it) {
        sum = sum + 1
        n = n + 1
    }
    if sum != 9 || n != 9 { bad = bad + 16 }
    var rebuilt: str = ""
    var jt: chars.CharIter = chars.iter(s)
    while chars.next(&jt) {
        rebuilt = rebuilt + jt.cp.char_str()
    }
    if rebuilt != s { bad = bad + 32 }
    let c: char = 'q'
    if c.char_str() != "q" { bad = bad + 64 }
    if chars.to_str('\u{1F600}') != "\u{1F600}" { bad = bad + 128 }
    if !chars.is_digit('7') || chars.is_digit('x') { bad = bad + 256 }
    if chars.to_upper('a') != 'A' || chars.to_lower('Q') != 'q' { bad = bad + 512 }
    if !chars.is_space(' ') || chars.is_space('a') { bad = bad + 1024 }
    if chars.to_str('a') != "a" { bad = bad + 2048 }
    return bad
}
