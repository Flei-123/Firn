// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn g(x: i64) -> i64 { return x * 3 + 1 }
fn f(a: i64, b: i64, c: i64, d: i64, e: i64) -> i64 {
    let t1: i64 = g(a)
    let t2: i64 = g(b + t1)
    let t3: i64 = g(c + t2)
    let t4: i64 = g(d + t3)
    return a + b + c + d + e + t1 + t2 + t3 + t4 + g(e)
}
fn main() -> i32 {
    put(f(1, 2, 3, 4, 5))
    put(f(-7, 80, -900, 1000, -11))
    return 0
}
