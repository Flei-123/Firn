// diff: run
// levels: same
fn putu(v: u64) {
    var buf: [u8; 24] = [0; 24]
    var u: u64 = v
    var i: usize = 23
    buf[23] = 10
    if u == 0 {
        i = 22
        buf[22] = 48
    }
    while u > 0 {
        i = i - 1
        buf[i] = (48 + u % 10) as u8
        u = u / 10
    }
    syscall(1, 1, &buf[i], (24 - i) as u64)
}
fn put(v: i64) {
    if v < 0 {
        var m: [u8; 1] = [45]
        syscall(1, 1, &m[0], 1)
        putu(0 -% (v as u64))
        return
    }
    putu(v as u64)
}
fn gcd(a: u64, b: u64) -> u64 {
    var x: u64 = a
    var y: u64 = b
    while y != 0 {
        let t: u64 = x % y
        x = y
        y = t
    }
    return x
}
fn main() -> i32 {
    var acc: u64 = 0
    var i: u64 = 1
    while i < 2000 {
        acc = acc + gcd(i * 9, 1001 + i)
        i = i + 1
    }
    putu(acc)
    return 0
}
