// expect_exit: 0
// only_mode: opt
// r903 r913 r914: release-fast never traps on these edges. -MIN stays MIN, MIN / -1 is MIN, MIN % -1 is 0,
// a shift count is taken modulo the width (32 up to 32 bits, 64 for 64-bit types).
fn neg32(x: i32) -> i32 {
    return -x
}

fn neg64(x: i64) -> i64 {
    return -x
}

fn div32(a: i32, b: i32) -> i32 {
    return a / b
}

fn rem32(a: i32, b: i32) -> i32 {
    return a % b
}

fn div64(a: i64, b: i64) -> i64 {
    return a / b
}

fn rem64(a: i64, b: i64) -> i64 {
    return a % b
}

fn div8(a: i8, b: i8) -> i8 {
    return a / b
}

fn shl32(x: u32, s: u32) -> u32 {
    return x << s
}

fn shr64(x: u64, s: u64) -> u64 {
    return x >> s
}

fn main() -> i32 {
    let m32: i32 = -2147483647 - 1
    let m64: i64 = -9223372036854775807 - 1
    let m8: i8 = -128
    if neg32(m32) != m32 { return 1 }
    if neg64(m64) != m64 { return 2 }
    if div32(m32, -1) != m32 { return 3 }
    if rem32(m32, -1) != 0 { return 4 }
    if div64(m64, -1) != m64 { return 5 }
    if rem64(m64, -1) != 0 { return 6 }
    if div8(m8, -1) != m8 { return 7 }
    if div32(7, -1) != -7 { return 8 }
    if rem32(7, -1) != 0 { return 9 }
    if div32(-7, 2) != -3 { return 10 }
    if rem32(-7, 2) != -1 { return 11 }
    if div64(100, -1) != -100 { return 12 }
    if shl32(1, 33) != 2 { return 13 }
    if shr64(256, 72) != 1 { return 14 }
    return 0
}
