// expect_exit: 0
// Error unions next to enumerations and 'match' in the same program.
error E { Unknown }

enum Mark { Red, Green, Blue }

fn value(m: Mark) -> E!i32 {
    match m {
        Mark::Red => { return 1 }
        Mark::Green => { return 2 }
        Mark::Blue => { return E::Unknown }
    }
    return 0
}

fn main() -> i32 {
    if (value(Mark::Red) catch 0) != 1 {
        return 1
    }
    if (value(Mark::Green) catch 0) != 2 {
        return 2
    }
    if (value(Mark::Blue) catch 0 - 7) != 0 - 7 {
        return 3
    }
    return 0
}
