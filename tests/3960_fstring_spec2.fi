// expect_exit: 0
// tests/3960_fstring_spec2.fi -- f-string specs: grouping , _, e E g G c n, nested {w}/{p}, BMP fill (r699).
// Expected values come from Python's format(); the random comparison is tools/fmtspec_cross/run.sh.
import std.io
import std.rt
import std.testkit

fn main() -> i32 {
    if !gc_init() { return 1 }
    let v0: i64 = 1234567
    testkit.check(io.fmt_string(f"{v0:,}") == "1,234,567", "case 0")
    let v1: i64 = -1234567
    testkit.check(io.fmt_string(f"{v1:_}") == "-1_234_567", "case 1")
    let v2: i64 = 1234
    testkit.check(io.fmt_string(f"{v2:010,}") == "00,001,234", "case 2")
    let v3: i64 = 1234
    testkit.check(io.fmt_string(f"{v3:08,}") == "0,001,234", "case 3")
    let v4: i64 = 255
    testkit.check(io.fmt_string(f"{v4:#012_x}") == "0x0_0000_00ff", "case 4")
    let v5: i64 = 255
    testkit.check(io.fmt_string(f"{v5:08_b}") == "1111_1111", "case 5")
    let v6: f64 = 1234567.891
    testkit.check(io.fmt_string(f"{v6:,.2f}") == "1,234,567.89", "case 6")
    let v7: f64 = 1234.5
    testkit.check(io.fmt_string(f"{v7:012,.1f}") == "00,001,234.5", "case 7")
    let v8: f64 = 12345.6789
    testkit.check(io.fmt_string(f"{v8:.3G}") == "1.23E+04", "case 8")
    let v9: f64 = 12345.678
    testkit.check(io.fmt_string(f"{v9:E}") == "1.234568E+04", "case 9")
    let v10: f64 = 5e-324
    testkit.check(io.fmt_string(f"{v10:e}") == "4.940656e-324", "case 10")
    let v11: f64 = 1.7976931348623157e+308
    testkit.check(io.fmt_string(f"{v11:.17g}") == "1.7976931348623157e+308", "case 11")
    let v12: f64 = 0.0001234
    testkit.check(io.fmt_string(f"{v12:g}") == "0.0001234", "case 12")
    let v13: f64 = 1234567.0
    testkit.check(io.fmt_string(f"{v13:g}") == "1.23457e+06", "case 13")
    let v14: f64 = 100000.0
    testkit.check(io.fmt_string(f"{v14:g}") == "100000", "case 14")
    let v15: f64 = 1e-05
    testkit.check(io.fmt_string(f"{v15:g}") == "1e-05", "case 15")
    let v16: f64 = 0.0
    testkit.check(io.fmt_string(f"{v16:g}") == "0", "case 16")
    let v17: f64 = 9.999
    testkit.check(io.fmt_string(f"{v17:.3g}") == "10", "case 17")
    let v18: f64 = 1.0
    testkit.check(io.fmt_string(f"{v18:.0e}") == "1e+00", "case 18")
    let v19: f64 = 123456789.0
    testkit.check(io.fmt_string(f"{v19:.3e}") == "1.235e+08", "case 19")
    let v20: f64 = 1234.5
    testkit.check(io.fmt_string(f"{v20:n}") == "1234.5", "case 20")
    let v21: f64 = 0.5
    testkit.check(io.fmt_string(f"{v21:.0g}") == "0.5", "case 21")
    let v22: i64 = 255
    testkit.check(io.fmt_string(f"{v22:n}") == "255", "case 22")
    let v23: i64 = 5
    testkit.check(io.fmt_string(f"{v23:e}") == "5.000000e+00", "case 23")
    let v24: i64 = 65
    testkit.check(io.fmt_string(f"{v24:5c}") == "    A", "case 24")
    let v25: i64 = 65
    testkit.check(io.fmt_string(f"{v25:<5c}") == "A    ", "case 25")
    let v26: i64 = 20013
    testkit.check(io.fmt_string(f"{v26:*^5c}") == "**中**", "case 26")
    let v27: i64 = 8364
    testkit.check(io.fmt_string(f"{v27:c}") == "€", "case 27")
    let v28: i64 = 7
    testkit.check(io.fmt_string(f"{v28:中^5d}") == "中中7中中", "case 28")
    let v29: i64 = 7
    testkit.check(io.fmt_string(f"{v29:é>4d}") == "ééé7", "case 29")
    let v30: str = "ab"
    testkit.check(io.fmt_string(f"{v30:€<6}") == "ab€€€€", "case 30")
    let v31: i64 = 42
    let w31: i32 = 6
    testkit.check(io.fmt_string(f"{v31:{w31}}") == "    42", "case 31")
    let v32: f64 = 3.14159
    let w32: i32 = 10
    let p32: i32 = 3
    testkit.check(io.fmt_string(f"{v32:{w32}.{p32}f}") == "     3.142", "case 32")
    let v33: f64 = 3.14159
    let w33: i32 = 9
    let p33: i32 = 2
    testkit.check(io.fmt_string(f"{v33:>{w33}.{p33}f}") == "     3.14", "case 33")
    let v34: f64 = 1234567.891
    let w34: i32 = 14
    let p34: i32 = 2
    testkit.check(io.fmt_string(f"{v34:{w34},.{p34}e}") == "      1.23e+06", "case 34")
    let v35: str = "hello"
    let p35: i32 = 3
    testkit.check(io.fmt_string(f"{v35:.{p35}}") == "hel", "case 35")
    let v36: str = "hi"
    let w36: i32 = 7
    testkit.check(io.fmt_string(f"{v36:*^{w36}}") == "**hi***", "case 36")
    let v37: i64 = 255
    let w37: i32 = 8
    testkit.check(io.fmt_string(f"{v37:#0{w37}x}") == "0x0000ff", "case 37")
    return testkit.finish()
}
