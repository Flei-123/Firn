// expect_exit: 0
const fn crc_table() -> [u32; 256] {
    var t: [u32; 256] = [0 as u32; 256]
    var i: u32 = 0
    while i < 256 {
        var c: u32 = i
        var k: i32 = 0
        while k < 8 {
            if c & 1 == 1 { c = 0xEDB88320 ^ (c >> 1) } else { c = c >> 1 }
            k += 1
        }
        t[i as usize] = c
        i += 1
    }
    return t
}

static CRC: [u32; 256] = crc_table()

fn crc32(data: *mut u8, n: usize) -> u32 {
    var c: u32 = 0xFFFFFFFF
    var i: usize = 0
    while i < n {
        c = CRC[((c ^ ((*(data + i)) as u32)) & 0xFF) as usize] ^ (c >> 8)
        i += 1
    }
    return c ^ 0xFFFFFFFF
}

fn main() -> i32 {
    var msg: [u8; 9] = "123456789"
    if CRC[1] != 0x77073096 { return 1 }
    if CRC[255] != 0x2D02EF8D { return 2 }
    if crc32(&msg[0], 9) != 0xCBF43926 { return 3 }
    return 0
}
