// expect_out: mc_vanilla_real ok
import std.rt
import std.io
import std.env
import mc.mc_version
import mc.mc_versions
import mc.mc_registry
import mc.mc_texture
import mc.mc_mesh
import mc.mc_packs
import mc.mc_model
import mc.mc_model_mesh
import mc.mc_vanilla

fn main() -> i32 {
    if !env.has("MC_VANILLA_JAR") {
        io.fmt_eprint_line(f"mc_vanilla_real skipped: MC_VANILLA_JAR not set")
        io.fmt_print(f"mc_vanilla_real ok\n")
        return 0
    }
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &ver) { return 1 }
    var reg: mc_registry.Registry = ver.registry_of()
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    var res: mc_packs.ResMgr = mc_packs.res_new()
    mc_packs.res_build_tables(&res, &reg, &tb)
    var path: rt.Buf = rt.buf_new()
    if mc_vanilla.vanilla_ensure(763, &path) != mc_vanilla.VANILLA_OK { return 2 }
    mc_packs.res_add_path(&res, rt.buf_str(&path))
    if mc_packs.res_reload(&res) != 1 { return 3 }
    if mc_packs.res_warn_count(&res) != 0 { return 4 }
    var ms: mc_model_mesh.ModelSet = mc_model_mesh.ms_new(&reg, &res.stack, &res.ex)
    var total: i32 = 0
    var baked: i32 = 0
    var unmapped: i32 = 0
    var s: i32 = 0
    while s < 32768 {
        var name: rt.Buf = rt.buf_new()
        var props: rt.Buf = rt.buf_new()
        if !mc_model_mesh.ms_state_parts(&reg, s, &name, &props) {
            rt.buf_free(&name)
            rt.buf_free(&props)
            break
        }
        total = total + 1
        var b: mc_model.Baked = mc_model.baked_new()
        if mc_model.blockstate_bake(&res.stack, rt.buf_str(&name), rt.buf_str(&props), 0 as u32, &b) > 0 {
            baked = baked + 1
            var ti: usize = 0
            while ti < mc_model.baked_tex_count(&b) {
                var tn: mc_model.Name = mc_model.name_new()
                if mc_model.baked_tex_name(&b, ti, &tn) && mc_model_mesh.ms_tex_tile(&ms, &tn) == 0 as u32 { unmapped = unmapped + 1 }
                ti = ti + 1
            }
        }
        mc_model.baked_free(&b)
        rt.buf_free(&name)
        rt.buf_free(&props)
        s = s + 1
    }
    if total < 24000 { return 5 }
    if baked < 21500 { return 6 }
    if unmapped != 0 {
        io.fmt_print(f"mc_vanilla_real FAIL unmapped={unmapped}\n")
        return 7
    }
    io.fmt_eprint_line(f"mc_vanilla_real states={total} baked={baked}")
    io.fmt_print(f"mc_vanilla_real ok\n")
    return 0
}
