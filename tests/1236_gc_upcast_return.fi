// expect_exit: 0
// tests/1236_gc_upcast_return.fi -- ROUND 68: `Gc[T]` upcasts implicitly at
// `return`, in a `let`, as an argument and behind `catch`.
//
// docs/ROUND63.md, gap 7: "`return derived` in a function that returns
// `AllocError!Gc[Base]` is rejected although the upcast is free (SPEC 4.4).
// A local of the base type in between fixes it. Roughly 200 places in this
// round."
//
// The cause was one copy too many: `sema::assignable` knew the rule,
// `errors.rs::compatible` -- the path that every conversion into an error
// union runs through -- did not. `lib/firnc1/types.fi` had it right since
// round 54, so the two compilers disagreed as well.

gc class Node {
    id: u32,
}

gc class Elem extends Node {
    tag: u32,
}

gc class Button extends Elem {
    pressed: u32,
}

// 1. THE CASE FROM THE REPORT: the derived value goes out directly, with no
//    local of the base type in between.
fn make_elem(tag: u32) -> AllocError!Gc[Node] {
    let e: Gc[Elem] = try gc Elem { id: 1, tag: tag }
    return e
}

// 2. two levels up at once
fn make_button() -> AllocError!Gc[Node] {
    let b: Gc[Button] = try gc Button { id: 2, tag: 7, pressed: 1 }
    return b
}

// 3. and the same from the middle of the chain
fn make_button_as_elem() -> AllocError!Gc[Elem] {
    let b: Gc[Button] = try gc Button { id: 3, tag: 8, pressed: 0 }
    return b
}

// 4. as an ARGUMENT of error union type
fn id_of(x: AllocError!Gc[Node]) -> u32 {
    let n: Gc[Node] = x catch gc_null[Node]()
    if n == gc_null[Node]() {
        return 0
    }
    return n.id
}

fn main() -> i32 {
    if !gc_init() {
        return 9
    }
    let a: Gc[Node] = make_elem(42) catch gc_null[Node]()
    if a == gc_null[Node]() { return 1 }
    if a.id != 1 { return 2 }
    // it really is the derived object -- the checked downcast finds it again
    let back = a.as?[Elem]
    if back == gc_null[Elem]() { return 3 }
    if back.tag != 42 { return 4 }

    let b: Gc[Node] = make_button() catch gc_null[Node]()
    if b.id != 2 { return 5 }
    let bb = b.as?[Button]
    if bb == gc_null[Button]() { return 6 }
    if bb.tag != 7 || bb.pressed != 1 { return 7 }

    let c: Gc[Elem] = make_button_as_elem() catch gc_null[Elem]()
    if c.id != 3 || c.tag != 8 { return 8 }

    // 5. in a `let` of error union type
    let d: Gc[Button] = gc Button { id: 4, tag: 9, pressed: 5 } catch gc_null[Button]()
    if d == gc_null[Button]() { return 10 }
    let u: AllocError!Gc[Node] = d
    if id_of(u) != 4 { return 11 }

    // 6. as an argument, without a local in between
    if id_of(d) != 4 { return 12 }

    // 7. the replacement value of `catch` may be a derived one too
    let e2: Gc[Node] = make_elem(1) catch d
    if e2.id != 1 { return 13 }

    // 8. the collector still sees the objects through the base reference
    gc_collect()
    if a.id != 1 || b.id != 2 || c.id != 3 || d.id != 4 { return 14 }
    return 0
}
