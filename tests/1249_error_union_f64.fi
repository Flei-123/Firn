// expect_exit: 0
// tests/1249_error_union_f64.fi -- ROUND 68: an error union over `f64`
// carries its value.
//
// docs/ROUND63.md, gap 2: "`E!f64` compiles, but the value that comes out
// the other side is not the one that went in ... This bug is dangerous
// because it is SILENT."
//
// The cause was not the ABI, as the report suspected, but a COPY:
// `lower_errors.rs` had a `scalar_fty` of its own that did not know
// `Type::F64`. `copy_value` then copied NOTHING and left the slot as it
// was. `lib/firnc1/lower.fi` had the same hole -- written in deliberately,
// to stay bug compatible. Both are gone.
import std.math

error TestError { Bad, Worse }

fn doubled(x: f64) -> TestError!f64 {
    if x < 0.0 {
        return TestError::Bad
    }
    return x * 2.0
}

fn as_bits(x: f64) -> TestError!u64 {
    return math.math_bits(x * 2.0)
}

fn sum3(a: f64, b: f64, c: f64) -> TestError!f64 {
    let x: f64 = try doubled(a)
    let y: f64 = try doubled(b)
    let z: f64 = try doubled(c)
    return x + y + z
}

fn value_of(e: TestError) -> f64 {
    if e == TestError::Bad {
        return 0.25
    }
    return 0.75
}

fn main() -> i32 {
    // 1. the success value arrives -- bit for bit
    let w: f64 = doubled(0.1) catch 0.0
    if math.math_bits(w) != math.math_bits(0.2) { return 1 }

    // 2. and it is the same as through the workaround of round 63
    let b: u64 = as_bits(0.1) catch 0
    if math.math_bits(w) != b { return 2 }

    // 3. the error path still works
    let e: f64 = doubled(0.0 - 1.0) catch 7.5
    if e != 7.5 { return 3 }

    // 4. `try` through several levels
    let s: f64 = sum3(1.0, 2.0, 3.0) catch 0.0
    if s != 12.0 { return 4 }
    let s2: f64 = sum3(1.0, 0.0 - 2.0, 3.0) catch 99.5
    if s2 != 99.5 { return 5 }

    // 5. -0.0 survives the union as well -- the sign bit is a bit like any
    //    other, and copying nothing would have looked like +0.0
    let mz: f64 = doubled(0.0 - 0.0) catch 1.0
    if math.math_bits(mz) != math.math_bits(0.0 - 0.0) { return 6 }

    // 6. the error VALUE is readable, and the bound name reaches the
    //    replacement expression
    let q: f64 = doubled(0.0 - 5.0) catch | err | (value_of(err))
    if q != 0.25 { return 7 }
    return 0
}
