// expect_exit: 0
// Der Kernnachweis (SPEC §3.5.5): zwei Objekte, die sich GEGENSEITIG halten
// und sonst unerreichbar sind, werden eingesammelt. Genau das kann ein
// Zaehlverweis nicht.
gc class Node {
    parent: Gc[Node],
    kind: Gc[Node],
    id: u32,
}

// Baut einen Zyklus aus zwei Objekten und laesst ihn unerreichbar werden.
fn cycle() -> AllocError!u32 {
    let a = try gc Node{ parent: gc_null[Node](), kind: gc_null[Node](), id: 1 }
    let b = try gc Node{ parent: a, kind: gc_null[Node](), id: 2 }
    a.kind = b
    // a haelt b, b haelt a — der Zyklus ist echt.
    return a.kind.id + b.parent.id
}

fn many(n: i64) -> AllocError!u32 {
    var i: i64 = 0
    var s: u32 = 0
    while i < n {
        s = s + try cycle()
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    if (many(20000) catch 0) != 60000 {
        return 1
    }
    // Gesammelt wird an den Allokationsstellen — ohne einen einzigen
    // ausdruecklichen Aufruf (SPEC 3.5.3).
    if gc_collections() == 0 {
        return 6
    }
    // Die Einfuegebarriere wurde wirklich durchlaufen (a.kind = b).
    if gc_barriers() < 20000 {
        return 7
    }
    gc_collect()
    if gc_collections() == 0 {
        return 2
    }
    // 40.000 Objekte in Zyklen, alle unerreichbar: es darf fast nichts
    // uebrig bleiben (der Rest sind die wenigen Zufallstreffer des
    // konservativen Stapelscans).
    if gc_live_objects() > 8 {
        return 4
    }
    // Der Verbrauch bleibt beschraenkt: kein unbegrenztes Wachstum.
    if gc_heap_bytes() > 8388608 {
        return 5
    }
    return 0
}
