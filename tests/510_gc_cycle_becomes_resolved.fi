// expect_exit: 0
// The core proof (SPEC 3.5.5): two objects that hold EACH OTHER and are
// unreachable otherwise are collected. That is exactly what a reference
// count cannot do.
gc class Node {
    parent: Gc[Node],
    kind: Gc[Node],
    id: u32,
}

// Builds a cycle out of two objects and lets it become unreachable.
fn cycle() -> AllocError!u32 {
    let a = try gc Node { parent: gc_null[Node](), kind: gc_null[Node](), id: 1 }
    let b = try gc Node { parent: a, kind: gc_null[Node](), id: 2 }
    a.kind = b
    // a holds b, b holds a -- the cycle is real.
    return a.kind.id + b.parent.id
}

fn many(n: i64) -> AllocError!u32 {
    var i: i64 = 0
    var s: u32 = 0
    while i < n {
        s = s + try cycle()
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    if (many(20000) catch 0) != 60000 {
        return 1
    }
    // Collection happens at the allocation sites -- without a single
    // explicit call (SPEC 3.5.3).
    if gc_collections() == 0 {
        return 6
    }
    // The write barrier really did run (a.kind = b).
    if gc_barriers() < 20000 {
        return 7
    }
    gc_collect()
    if gc_collections() == 0 {
        return 2
    }
    // 40,000 objects in cycles, all unreachable: almost nothing may be
    // left over (the rest are the few accidental hits of the
    // conservative stack scan).
    if gc_live_objects() > 8 {
        return 4
    }
    // The consumption stays bounded: no unlimited growth.
    if gc_heap_bytes() > 8388608 {
        return 5
    }
    return 0
}
