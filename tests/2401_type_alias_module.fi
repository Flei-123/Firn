// expect_exit: 0
// Round TUPLES (docs/GAPS.md B14): a type alias is an item of its module --
// `m.Name` in a type position, in a struct literal and as the target of an
// alias of the importing module. The target is read from the point of view
// of the module that declared it (`Pair` is `alias_base.Item`, not an `Item`
// of this file).
import modules.alias_base
import modules.alias_user

type Mine = alias_base.Total
type Wrapped = alias_user.Score

struct Item { only_here: i32 }

fn total(h: alias_base.Handle) -> Mine {
    return alias_base.sum(h)
}

fn main() -> i32 {
    var it: alias_base.Item = alias_base.make(3, 4)
    let t: Mine = total(&it)
    let w: Wrapped = alias_user.bump(t)
    if w != 8 {
        return 1
    }
    // all spellings of the one type interchange
    let c1: alias_base.Count = w
    let c2: u64 = c1
    if c2 != 8 {
        return 2
    }
    // a struct literal through the alias of another module
    let p: alias_base.Pair = alias_base.Pair { a: 5, b: 6 }
    let q: alias_base.Item = p
    if q.a + q.b != 11 {
        return 3
    }
    // a module returns a struct under its alias for it
    let cl: alias_user.Cell = alias_user.cell(7)
    let cm: alias_base.Item = cl
    if cm.b != 14 {
        return 4
    }
    // this file's own `Item` is another type than the module's
    let mine: Item = Item { only_here: 1 }
    if mine.only_here != 1 {
        return 5
    }
    return 0
}
