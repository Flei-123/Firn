// expect_exit: 0
// tests/3722_net_jarvisapi_pushpoll.fi -- net.jarvisapi, the answer of the push long poll (GET /api/m/push/poll, docs/ANDROID-APP-API.md
// of the JARVIS server): events with id / type / title / body / cid, `last`; an empty poll; broken documents are refused, every proper
// prefix is refused, 1500 seeded byte mutations never crash.
import std.rt
import std.vec
import net.jarvisapi

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

const F_EV: str = "{\"events\":[{\"id\":17,\"type\":\"reminder\",\"title\":\"JARVIS -- Erinnerung\",\"body\":\"Anruf Opa\",\"cid\":null,\"at\":1760726000000},{\"id\":18,\"type\":\"done\",\"title\":\"Worker fertig\",\"body\":\"Build gruen \\u00e4\",\"cid\":\"c_ab12\",\"at\":1760726000500}],\"last\":18}"
const F_EMPTY: str = "{\"events\":[],\"last\":5}"

fn run(p: u64, n: usize) -> bool {
    var e: jarvisapi.PushEvents = jarvisapi.pushevents_new()
    let ok: bool = jarvisapi.parse_push_events(p, n, &e)
    jarvisapi.pushevents_free(&e)
    return ok
}

#[allow_escape]
fn main() -> i32 {
    var e: jarvisapi.PushEvents = jarvisapi.pushevents_new()
    check("events parse", jarvisapi.parse_push_events(F_EV.p as u64, F_EV.n, &e))
    check("event count + last", vec_len[jarvisapi.PushEvent](&e.rows) == 2 && e.last == 18)
    let e0: *mut jarvisapi.PushEvent = vec_elem_ptr[jarvisapi.PushEvent](&e.rows, 0)
    let e1: *mut jarvisapi.PushEvent = vec_elem_ptr[jarvisapi.PushEvent](&e.rows, 1)
    check("event 0", (*e0).id == 17 && (*e0).kind == "reminder" && (*e0).title == "JARVIS -- Erinnerung" && (*e0).body == "Anruf Opa" && (*e0).cid.n == 0 && (*e0).at == 1760726000000)
    check("event 1", (*e1).id == 18 && (*e1).kind == "done" && (*e1).cid == "c_ab12" && (*e1).body.n > 10)
    jarvisapi.pushevents_free(&e)

    var q: jarvisapi.PushEvents = jarvisapi.pushevents_new()
    check("empty poll", jarvisapi.parse_push_events(F_EMPTY.p as u64, F_EMPTY.n, &q) && vec_len[jarvisapi.PushEvent](&q.rows) == 0 && q.last == 5)
    jarvisapi.pushevents_free(&q)

    check("no events array refused", !run("{\"last\":3}".p as u64, 10))
    check("not json refused", !run("hello".p as u64, 5))
    check("empty body refused", !run("".p as u64, 0))

    var cut_ok: i32 = 0
    var n: usize = 0
    while n < F_EV.n {
        if run(F_EV.p as u64, n) { cut_ok += 1 }
        n += 1
    }
    check("no cut document accepted", cut_ok == 0)

    var seed: u64 = 88172645463325252
    var it: i32 = 0
    while it < 1500 {
        var b: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&b, F_EV.p as u64, F_EV.n)
        var m: i32 = 0
        while m < 3 {
            seed ^= seed << 13
            seed ^= seed >> 7
            seed ^= seed << 17
            let at: usize = (seed % (F_EV.n as u64)) as usize
            *((b.ptr + at as u64) as *mut u8) = ((seed >> 20) & 255) as u8
            m += 1
        }
        let r: bool = run(b.ptr, b.len)
        rt.buf_free(&b)
        it += 1
    }

    if failures == 0 {
        rt.write_everything(1, "OK\n".p as u64, 3)
        return 0
    }
    return 1
}
