// expect_exit: 0
import async.loop
import async.fut

async fn val(l: *mut loop.Loop, n: i32) -> i32 {
    let w: bool = fut.sleep_ms(l, 1).await
    return n
}

fn add3(a: i32, b: i32, c: i32) -> i32 { return a + b * 10 + c * 100 }

async fn expr_form(l: *mut loop.Loop) -> i32 {
    let a: i32 = val(l, 1).await + val(l, 2).await * 5
    return a
}

async fn call_form(l: *mut loop.Loop) -> i32 {
    var total: i32 = add3(val(l, 1).await, val(l, 2).await, val(l, 3).await)
    total = total + val(l, 4).await
    return total
}

async fn cond_form(l: *mut loop.Loop) -> i32 {
    if val(l, 5).await > 3 { return 11 }
    return 22
}

async fn return_form(l: *mut loop.Loop) -> i32 {
    return val(l, 6).await + val(l, 7).await
}

async fn nested_form(l: *mut loop.Loop) -> i32 {
    let x: i32 = val(l, val(l, 3).await).await
    return x
}

#[allow_escape]
fn main() -> i32 {
    var l: loop.Loop = loop.loop_new()
    if !loop.loop_init(&l) { return 1 }
    if fut.block_on[i32](&l, expr_form(&l)) != 11 { return 2 }
    if fut.block_on[i32](&l, call_form(&l)) != 321 + 4 { return 3 }
    if fut.block_on[i32](&l, cond_form(&l)) != 11 { return 4 }
    if fut.block_on[i32](&l, return_form(&l)) != 13 { return 5 }
    if fut.block_on[i32](&l, nested_form(&l)) != 3 { return 6 }
    loop.loop_free(&l)
    return 0
}
