// expect_exit: 0
// tests/1400_core_span.fi -- ROUND 73: the reading text facade out of
// `std.core`, in the APP profile.
//
// The same code runs in a kernel (demos/freestanding/kcore.fi, section 30 of
// test.sh). Here it is nailed down case by case, because a kernel can only
// report a handful of numbers over a serial line and this test can compare
// three dozen.
//
// What is checked: every function of `lib/str/core_facade.fi` that a
// kernel actually needs -- views, character classes, comparing, searching,
// trimming, the splitting cursor and the UTF-8 reader -- plus the methods
// out of `lib/str/core_impl.fi`. Not one line of it allocates.
import std.core

fn s(p: *mut u8) -> core.Span {
    return core.span_of_c(p)
}

fn main() -> i32 {
    var line: [u8; 24] = "  vga=1 root=17 quiet  \0"
    var root: [u8; 6] = "root=\0"
    var quiet: [u8; 6] = "quiet\0"
    var vga: [u8; 6] = "vga=1\0"
    var blank: [u8; 2] = " \0"
    var empty: [u8; 1] = "\0"
    var upper: [u8; 6] = "ROOT=\0"

    // 1. views
    let raw: core.Span = s(&line[0])
    if raw.length() != 23 { return 1 }
    if raw.is_empty() { return 2 }
    if raw.chars(2) != 118 as u8 { return 3 }
    if raw.chars(999) != 0 as u8 { return 4 }

    // 2. trim
    let all: core.Span = raw.trim()
    if all.length() != 19 { return 5 }
    if all.chars(0) != 118 as u8 { return 6 }
    if core.trim_left(raw).length() != 21 { return 7 }
    if core.trim_right(raw).length() != 21 { return 8 }

    // 3. searching
    if all.find(s(&root[0])) != 6 { return 9 }
    if all.find(s(&quiet[0])) != 14 { return 10 }
    if all.find_char(61 as u8) != 3 { return 11 }
    if core.find_char_back(all, 61 as u8) != 10 { return 12 }
    if all.find(s(&upper[0])) != core.npos() { return 13 }
    if !all.contains(s(&root[0])) { return 14 }
    if all.count_char(61 as u8) != 2 { return 15 }
    if all.count_part(s(&blank[0])) != 2 { return 16 }
    // The empty needle is found at the start -- the rule of C# and Rust.
    if all.find(s(&empty[0])) != 0 { return 17 }

    // 4. comparing
    if !all.starts_with(s(&vga[0])) { return 18 }
    if !all.ends_with(s(&quiet[0])) { return 19 }
    if all.equal(raw) { return 20 }
    if core.compare(s(&root[0]), s(&quiet[0])) <= 0 { return 21 }
    if core.compare(s(&root[0]), s(&root[0])) != 0 { return 22 }
    if !core.equal_without_case(s(&root[0]), s(&upper[0])) { return 23 }
    if core.compare_without_case(s(&root[0]), s(&upper[0])) != 0 { return 24 }

    // 5. pieces
    if all.to(5).length() != 5 { return 25 }
    if all.ab(14).length() != 5 { return 26 }
    if !all.ab(14).equal(s(&quiet[0])) { return 27 }
    if all.part(6, 5).equal(s(&quiet[0])) { return 28 }
    if !all.without_prefix(s(&vga[0])).starts_with(s(&blank[0])) { return 29 }
    if all.without_suffix(s(&quiet[0])).length() != 14 { return 30 }

    // 6. character classes
    if !core.is_digit(53 as u8) { return 31 }
    if core.is_digit(65 as u8) { return 32 }
    if !core.is_hex_digit(102 as u8) { return 33 }
    if !core.is_letter(122 as u8) { return 34 }
    if !core.is_alphanumeric(48 as u8) { return 35 }
    if !core.is_whitespace(9 as u8) { return 36 }
    if core.hex_value(70 as u8) != 15 { return 37 }
    if core.hex_value(71 as u8) != 0 - 1 { return 38 }
    if core.big_char(97 as u8) != 65 as u8 { return 39 }
    if core.small_char(90 as u8) != 122 as u8 { return 40 }

    // 7. the splitting cursor -- three pieces, no allocation
    var t: core.Divisor = core.divisor_whitespace(all)
    var piece: core.Span = core.span_empty()
    var parts: usize = 0
    var value: core.Span = core.span_empty()
    while core.divisor_next(&t, &piece) {
        parts = parts + 1
        if piece.starts_with(s(&root[0])) {
            value = piece.ab(5)
        }
    }
    if parts != 3 { return 41 }
    if value.length() != 2 { return 42 }
    // With a separator instead of whitespace: "a,b,,c" gives four pieces.
    var csv: [u8; 7] = "a,b,,c\0"
    var comma: [u8; 2] = ",\0"
    var t2: core.Divisor = core.divisor_new(s(&csv[0]), s(&comma[0]))
    var n2: usize = 0
    var empties: usize = 0
    while core.divisor_next(&t2, &piece) {
        n2 = n2 + 1
        if piece.is_empty() {
            empties = empties + 1
        }
    }
    if n2 != 4 || empties != 1 { return 43 }
    if core.parts_count(s(&csv[0]), s(&comma[0])) != 4 { return 44 }

    // 8. UTF-8: "a" + U+03BB (2 octets) + U+20AC (3 octets) + "b"
    var u: [u8; 8] = [0; 8]
    u[0] = 97 as u8
    u[1] = 206 as u8
    u[2] = 187 as u8
    u[3] = 226 as u8
    u[4] = 130 as u8
    u[5] = 172 as u8
    u[6] = 98 as u8
    let text: core.Span = core.span(&u[0], 7)
    if text.utf8_char() != 4 { return 45 }
    let a: core.CharHit = core.utf8_read(text, 1)
    if !a.valid || a.cp != 955 || a.length != 2 { return 46 }
    let b: core.CharHit = core.utf8_read(text, 3)
    if !b.valid || b.cp != 8364 || b.length != 3 { return 47 }
    if core.utf8_next(text, 1) != 3 { return 48 }
    if core.utf8_before(text, 5) != 3 { return 49 }
    if !core.utf8_is_limit(text, 3) { return 50 }
    if core.utf8_is_limit(text, 4) { return 51 }
    if text.utf8_part(1, 2).length() != 5 { return 52 }
    // An invalid octet is ONE character with valid = false, so that every
    // loop makes progress.
    var wrong: [u8; 2] = [0; 2]
    wrong[0] = 255 as u8
    let z: core.CharHit = core.utf8_read(core.span(&wrong[0], 1), 0)
    if z.valid || z.length != 1 || z.cp != 65533 { return 53 }

    return 0
}
