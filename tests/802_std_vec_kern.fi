// expect_out: vec: len 10 erst 9 letzt 1 such 4 kap 1 u64 9223372036854775808 gross 200 min 7
// tests/802_std_vec_kern.fi — die Feld-Helfer von `std.vec` (Runde 42).
//
// `Vec[T]` konnte bisher wachsen, lesen, schreiben und poppen. Dazu kommen
// jetzt die Handgriffe, die man in jedem zweiten Programm braucht: suchen,
// einfuegen, entfernen (mit und ohne Reihenfolge), kopieren, vergleichen,
// umkehren, sortieren und binaer suchen.
//
// Alles ist generisch — deshalb wird hier mit ZWEI Typen gearbeitet (i32 und
// u64): eine Vorlage, die nur fuer eine Ausprägung uebersetzt, faellt sonst
// nicht auf. Bei u64 zeigt der Sortierlauf zugleich, dass die VORZEICHENLOSE
// Ordnung genommen wird: 2^63 gehoert ans Ende, nicht an den Anfang.
import std.io
import std.vec

fn main() -> i32 {
    // --- i32: aufbauen, suchen, sortieren
    var v: Vec[i32] = vec_neu[i32]()
    if !vec_ist_leer[i32](&v) {
        return 10
    }
    var i: i32 = 0
    while i < 10 {
        vec_push[i32](&v, (i * 7) % 10)
        i = i + 1
    }
    if vec_len[i32](&v) != 10 {
        return 11
    }
    if !vec_enthaelt[i32](&v, 3) || vec_enthaelt[i32](&v, 99) {
        return 12
    }
    if vec_index_von[i32](&v, 7) != 1 {
        return 13
    }
    if vec_index_von[i32](&v, 99) != vec_len[i32](&v) {
        return 14
    }
    if vec_zaehle[i32](&v, 0) != 1 {
        return 15
    }
    if vec_ist_sortiert[i32](&v) {
        return 16
    }
    vec_sortiere[i32](&v)
    if !vec_ist_sortiert[i32](&v) {
        return 17
    }
    if vec_at[i32](&v, 0) != 0 || vec_at[i32](&v, 9) != 9 {
        return 18
    }
    if vec_min[i32](&v) != 0 || vec_max[i32](&v) != 9 {
        return 19
    }

    // --- binaer suchen und sortiert einfuegen
    if vec_binaersuche[i32](&v, 5) != 5 {
        return 20
    }
    if vec_binaersuche[i32](&v, 42) != vec_len[i32](&v) {
        return 21
    }
    if vec_untere_schranke[i32](&v, 0 - 1) != 0 {
        return 22
    }
    if vec_untere_schranke[i32](&v, 100) != 10 {
        return 23
    }
    if !vec_sortiert_einfuegen[i32](&v, 4) {
        return 24
    }
    if vec_len[i32](&v) != 11 || !vec_ist_sortiert[i32](&v) {
        return 25
    }
    if vec_zaehle[i32](&v, 4) != 2 {
        return 26
    }

    // --- einfuegen, entfernen, tauschen, umkehren
    if !vec_einfuegen[i32](&v, 0, 42) {
        return 30
    }
    if vec_at[i32](&v, 0) != 42 || vec_at[i32](&v, 1) != 0 {
        return 31
    }
    if vec_entfernen[i32](&v, 0) != 42 {
        return 32
    }
    if vec_at[i32](&v, 0) != 0 || vec_len[i32](&v) != 11 {
        return 33
    }
    let letztes: i32 = vec_letztes[i32](&v)
    if vec_entfernen_schnell[i32](&v, 0) != 0 {
        return 34
    }
    if vec_at[i32](&v, 0) != letztes || vec_len[i32](&v) != 10 {
        return 35
    }
    if !vec_tausche[i32](&v, 0, 9) {
        return 36
    }
    if vec_tausche[i32](&v, 0, 99) {
        return 37
    }
    vec_sortiere[i32](&v)
    vec_umkehren[i32](&v)
    if vec_at[i32](&v, 0) != 9 || vec_at[i32](&v, 9) != 1 {
        return 38
    }

    // --- kopieren, anhaengen, vergleichen, kuerzen, fuellen
    var w: Vec[i32] = vec_neu[i32]()
    if !vec_kopie[i32](&v, &w) {
        return 40
    }
    if !vec_gleich[i32](&v, &w) {
        return 41
    }
    if !vec_anhaengen[i32](&w, &v) {
        return 42
    }
    if vec_len[i32](&w) != 20 || vec_gleich[i32](&v, &w) {
        return 43
    }
    vec_kuerzen[i32](&w, 3)
    if vec_len[i32](&w) != 3 {
        return 44
    }
    vec_fuellen[i32](&w, 5)
    if vec_zaehle[i32](&w, 5) != 3 {
        return 45
    }
    var leer: Vec[i32] = vec_neu[i32]()
    if !vec_kopie[i32](&leer, &w) {
        return 46
    }
    if !vec_ist_leer[i32](&w) {
        return 47
    }

    // --- u64: die vorzeichenlose Ordnung
    var u: Vec[u64] = vec_neu[u64]()
    vec_push[u64](&u, 9223372036854775808)
    vec_push[u64](&u, 1)
    vec_push[u64](&u, 18446744073709551615)
    vec_push[u64](&u, 0)
    vec_sortiere[u64](&u)
    if vec_at[u64](&u, 0) != 0 || vec_at[u64](&u, 1) != 1 {
        return 50
    }
    if vec_at[u64](&u, 3) != 18446744073709551615 {
        return 51
    }
    if vec_max[u64](&u) != 18446744073709551615 {
        return 52
    }
    if vec_binaersuche[u64](&u, 9223372036854775808) != 2 {
        return 53
    }

    // --- Sortieren bleibt auch bei vielen gleichen Werten O(n log n)-sicher
    var gross: Vec[i32] = vec_neu[i32]()
    var k: i32 = 0
    while k < 200 {
        vec_push[i32](&gross, 200 - k)
        k = k + 1
    }
    vec_sortiere[i32](&gross)
    if !vec_ist_sortiert[i32](&gross) {
        return 60
    }
    if vec_at[i32](&gross, 0) != 1 || vec_at[i32](&gross, 199) != 200 {
        return 61
    }
    vec_fuellen[i32](&gross, 7)
    vec_sortiere[i32](&gross)
    if !vec_ist_sortiert[i32](&gross) || vec_min[i32](&gross) != 7 {
        return 62
    }

    // Der Wert 2^63 zeigt zugleich die Grenze der Interpolation: `f"{x}"`
    // zeigt IMMER i64. Wer u64 richtig sehen will, nimmt `io.fmt_u64` —
    // genau dafuer gibt es die Stufe seit Runde 42.
    var zeile: io.Fmt = f"vec: len {vec_len[i32](&v)} erst {vec_at[i32](&v, 0)} letzt {vec_letztes[i32](&v)} such {vec_index_von[i32](&v, 5)} kap {vec_kap[i32](&v) >= 11} u64 "
    zeile = io.fmt_u64(zeile, vec_at[u64](&u, 2))
    io.fmt_druck(io.fmt_anhaengen(zeile,
        f" gross {vec_len[i32](&gross)} min {vec_min[i32](&gross)}\n"))

    vec_frei[i32](&v)
    vec_frei[i32](&w)
    vec_frei[i32](&leer)
    vec_frei[i32](&gross)
    vec_frei[u64](&u)
    return 0
}
