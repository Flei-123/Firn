// expect_exit: 0
// MEMORY LAYOUT AND CALLING CONVENTION -- the shapes the corpus does not
// contain otherwise.
//
// Two things are checked here, and against each other:
//   1. that the GENERATED CODE uses the field offsets the layout
//      prescribes -- recomputed through address differences at run time,
//      not through a table in someone's head;
//   2. that aggregates cross function boundaries correctly over each of the
//      three ABI borders: up to 8 bytes (one word), 9..16 bytes (two words,
//      but the return already through the hidden pointer), above
//      16 bytes (memory).
//
// `tools/types_compare.sh` additionally checks that `lib/firnc1/types.fi`
// computes THE SAME numbers for the same file as `firnc0`.

struct Small { // 8 Byte, ein Wort
    a: i32,
    b: i32,
}

struct Mid { // 16 Byte, zwei Woerter
    a: i64,
    b: i64,
}

struct Big { // 24 Byte, Speicher
    a: i64,
    b: i64,
    c: i64,
}

struct Holes { // Ausrichtung erzwingt Luecken
    a: u8,
    b: i64,
    c: u8,
    d: i32,
    e: u8,
}

struct Nested { // Struct im Struct
    header: u8,
    inner: Holes,
    tail: u8,
}

struct WithField { // Array im Struct
    a: u16,
    f: [i32; 3],
    b: u8,
}

fn sum_small(k: Small) -> i32 {
    return k.a + k.b
}

fn sum_mid(m: Mid) -> i64 {
    return m.a + m.b
}

fn sum_big(g: Big) -> i64 {
    return g.a + g.b + g.c
}

fn make_mid(a: i64, b: i64) -> Mid {
    return Mid { a: a, b: b }
}

fn make_big(a: i64) -> Big {
    return Big { a: a, b: a * 2, c: a * 3 }
}

// An aggregate AND scalars mixed, more than six words in total.
fn mixed(k: Small, x: i64, g: Big, y: i64, m: Mid, z: i64) -> i64 {
    return k.a as i64 + k.b as i64 + x + g.a + g.b + g.c + y + m.a + m.b + z
}

fn offset(base: u64, field: u64) -> u64 {
    return field - base
}

fn main() -> i32 {
    // --- 1. recompute the offsets at run time
    var l: Holes = Holes { a: 1 as u8, b: 2, c: 3 as u8, d: 4, e: 5 as u8 }
    let bl: u64 = (&l) as u64
    if offset(bl, (&l.a) as u64) != 0 {
        return 1
    }
    if offset(bl, (&l.b) as u64) != 8 {
        return 2
    }
    if offset(bl, (&l.c) as u64) != 16 {
        return 3
    }
    if offset(bl, (&l.d) as u64) != 20 {
        return 4
    }
    if offset(bl, (&l.e) as u64) != 24 {
        return 5
    }

    var v: Nested = Nested {
        header: 9 as u8,
        inner: Holes { a: 1 as u8, b: 2, c: 3 as u8, d: 4, e: 5 as u8 },
        tail: 7 as u8,
    }
    let bv: u64 = (&v) as u64
    if offset(bv, (&v.header) as u64) != 0 {
        return 6
    }
    // Holes has alignment 8 -> the inner struct starts at 8
    if offset(bv, (&v.inner) as u64) != 8 {
        return 7
    }
    if offset(bv, (&v.inner.b) as u64) != 16 {
        return 8
    }
    // Holes is 32 bytes -> tail at 40
    if offset(bv, (&v.tail) as u64) != 40 {
        return 9
    }

    var mf: WithField = WithField { a: 1 as u16, f: [7, 8, 9], b: 2 as u8 }
    let bm: u64 = (&mf) as u64
    if offset(bm, (&mf.a) as u64) != 0 {
        return 10
    }
    // [i32; 3] has alignment 4 -> starts at 4
    if offset(bm, (&mf.f[0]) as u64) != 4 {
        return 11
    }
    if offset(bm, (&mf.f[2]) as u64) != 12 {
        return 12
    }
    if offset(bm, (&mf.b) as u64) != 16 {
        return 13
    }

    // --- 2. aggregates across function boundaries
    let k: Small = Small { a: 3, b: 4 }
    if sum_small(k) != 7 {
        return 14
    }
    let m: Mid = make_mid(10, 20)
    if m.a != 10 || m.b != 20 {
        return 15
    }
    if sum_mid(m) != 30 {
        return 16
    }
    let g: Big = make_big(5)
    if g.a != 5 || g.b != 10 || g.c != 15 {
        return 17
    }
    if sum_big(g) != 30 {
        return 18
    }
    // 1 + 1 + 3 + 1 + 2 + 1 = nine words: the last ones travel on the stack
    if mixed(k, 100, g, 200, m, 300) != 7 + 100 + 30 + 200 + 30 + 300 {
        return 19
    }

    // --- 3. copy semantics: an aggregate is passed BY VALUE
    var g2: Big = g
    g2.a = 999
    if g.a != 5 {
        return 20
    }
    if sum_big(g2) != 999 + 10 + 15 {
        return 21
    }

    return 0
}
