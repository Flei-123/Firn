// expect_exit: 0
// SPEICHERLAYOUT UND AUFRUFKONVENTION — die Formen, die das Korpus sonst
// nicht enthaelt.
//
// Zwei Dinge werden hier geprueft, und zwar gegeneinander:
//   1. dass der ERZEUGTE CODE die Feldversaetze benutzt, die das Layout
//      vorschreibt — nachgerechnet ueber Adressdifferenzen zur Laufzeit,
//      nicht ueber eine Tabelle im Kopf;
//   2. dass Aggregate ueber jede der drei ABI-Grenzen hinweg richtig durch
//      Funktionsgrenzen kommen: bis 8 Byte (ein Wort), 9..16 Byte (zwei
//      Woerter, Rueckgabe aber schon ueber den versteckten Zeiger), ueber
//      16 Byte (Speicher).
//
// `tools/typen_vergleich.sh` prueft zusaetzlich, dass `lib/firnc1/typen.fi`
// fuer dieselbe Datei DIESELBEN Zahlen ausrechnet wie `firnc0`.

struct Klein {          // 8 Byte, ein Wort
    a: i32,
    b: i32,
}

struct Mittel {         // 16 Byte, zwei Woerter
    a: i64,
    b: i64,
}

struct Gross {          // 24 Byte, Speicher
    a: i64,
    b: i64,
    c: i64,
}

struct Loecher {        // Ausrichtung erzwingt Luecken
    a: u8,
    b: i64,
    c: u8,
    d: i32,
    e: u8,
}

struct Verschachtelt {  // Struct im Struct
    kopf: u8,
    innen: Loecher,
    schwanz: u8,
}

struct MitFeld {        // Array im Struct
    a: u16,
    f: [i32; 3],
    b: u8,
}

fn summe_klein(k: Klein) -> i32 {
    return k.a + k.b
}

fn summe_mittel(m: Mittel) -> i64 {
    return m.a + m.b
}

fn summe_gross(g: Gross) -> i64 {
    return g.a + g.b + g.c
}

fn mach_mittel(a: i64, b: i64) -> Mittel {
    return Mittel{ a: a, b: b }
}

fn mach_gross(a: i64) -> Gross {
    return Gross{ a: a, b: a * 2, c: a * 3 }
}

// Aggregat UND Skalare gemischt, mehr als sechs Woerter insgesamt.
fn gemischt(k: Klein, x: i64, g: Gross, y: i64, m: Mittel, z: i64) -> i64 {
    return k.a as i64 + k.b as i64 + x + g.a + g.b + g.c + y + m.a + m.b + z
}

fn versatz(basis: u64, feld: u64) -> u64 {
    return feld - basis
}

fn main() -> i32 {
    // --- 1. Versaetze zur Laufzeit nachrechnen
    var l: Loecher = Loecher{ a: 1 as u8, b: 2, c: 3 as u8, d: 4, e: 5 as u8 }
    let bl: u64 = (&l) as u64
    if versatz(bl, (&l.a) as u64) != 0 {
        return 1
    }
    if versatz(bl, (&l.b) as u64) != 8 {
        return 2
    }
    if versatz(bl, (&l.c) as u64) != 16 {
        return 3
    }
    if versatz(bl, (&l.d) as u64) != 20 {
        return 4
    }
    if versatz(bl, (&l.e) as u64) != 24 {
        return 5
    }

    var v: Verschachtelt = Verschachtelt{
        kopf: 9 as u8,
        innen: Loecher{ a: 1 as u8, b: 2, c: 3 as u8, d: 4, e: 5 as u8 },
        schwanz: 7 as u8,
    }
    let bv: u64 = (&v) as u64
    if versatz(bv, (&v.kopf) as u64) != 0 {
        return 6
    }
    // Loecher hat Ausrichtung 8 -> der innere Struct beginnt bei 8
    if versatz(bv, (&v.innen) as u64) != 8 {
        return 7
    }
    if versatz(bv, (&v.innen.b) as u64) != 16 {
        return 8
    }
    // Loecher ist 32 Byte gross -> schwanz bei 40
    if versatz(bv, (&v.schwanz) as u64) != 40 {
        return 9
    }

    var mf: MitFeld = MitFeld{ a: 1 as u16, f: [7, 8, 9], b: 2 as u8 }
    let bm: u64 = (&mf) as u64
    if versatz(bm, (&mf.a) as u64) != 0 {
        return 10
    }
    // [i32; 3] hat Ausrichtung 4 -> beginnt bei 4
    if versatz(bm, (&mf.f[0]) as u64) != 4 {
        return 11
    }
    if versatz(bm, (&mf.f[2]) as u64) != 12 {
        return 12
    }
    if versatz(bm, (&mf.b) as u64) != 16 {
        return 13
    }

    // --- 2. Aggregate ueber Funktionsgrenzen
    let k: Klein = Klein{ a: 3, b: 4 }
    if summe_klein(k) != 7 {
        return 14
    }
    let m: Mittel = mach_mittel(10, 20)
    if m.a != 10 || m.b != 20 {
        return 15
    }
    if summe_mittel(m) != 30 {
        return 16
    }
    let g: Gross = mach_gross(5)
    if g.a != 5 || g.b != 10 || g.c != 15 {
        return 17
    }
    if summe_gross(g) != 30 {
        return 18
    }
    // 1 + 1 + 3 + 1 + 2 + 1 = neun Woerter: die letzten laufen ueber den Stapel
    if gemischt(k, 100, g, 200, m, 300) != 7 + 100 + 30 + 200 + 30 + 300 {
        return 19
    }

    // --- 3. Kopiersemantik: ein Aggregat wird als WERT uebergeben
    var g2: Gross = g
    g2.a = 999
    if g.a != 5 {
        return 20
    }
    if summe_gross(g2) != 999 + 10 + 15 {
        return 21
    }

    return 0
}
