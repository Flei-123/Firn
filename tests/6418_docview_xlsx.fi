// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import std.rt
import zip.zip
import docview.dvdoc
import docview.kinds
import docview.office.xl_open
import docview.office.dx_imgfui

fn add_str(w: *mut zip.ZipWriter, name: str, body: str) -> bool {
    return zip.zip_add(w, name, body.p as u64, body.n, false) catch | e | (false)
}

fn build_xlsx(out: *mut rt.Buf) -> bool {
    var w: zip.ZipWriter = zip.zip_writer_new(out)
    var ok: bool = add_str(&w, "_rels/.rels", "<?xml version=\"1.0\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/></Relationships>")
    ok = add_str(&w, "xl/workbook.xml", "<?xml version=\"1.0\" encoding=\"UTF-8\"?><workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\"><sheets><sheet name=\"Data\" sheetId=\"1\" r:id=\"rId1\"/></sheets></workbook>") && ok
    ok = add_str(&w, "xl/_rels/workbook.xml.rels", "<?xml version=\"1.0\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet1.xml\"/><Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/sharedStrings\" Target=\"sharedStrings.xml\"/></Relationships>") && ok
    ok = add_str(&w, "xl/sharedStrings.xml", "<?xml version=\"1.0\"?><sst xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><si><t>Hello</t></si><si><r><t>Fi</t></r><r><t>rn</t></r></si></sst>") && ok
    ok = add_str(&w, "xl/worksheets/sheet1.xml", "<?xml version=\"1.0\"?><worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\"><sheetData><row r=\"1\"><c r=\"A1\" t=\"s\"><v>0</v></c><c r=\"B1\" t=\"s\"><v>1</v></c></row><row r=\"2\"><c r=\"A2\"><v>1234.5</v></c><c r=\"C2\" t=\"b\"><v>1</v></c></row></sheetData><mergeCells count=\"1\"><mergeCell ref=\"A1:A1\"/></mergeCells></worksheet>") && ok
    let n: usize = zip.zip_finish(&w) catch | e | (0)
    zip.zip_writer_free(&w)
    return ok && n > 0
}

fn main() -> i32 {
    var zbuf: rt.Buf = rt.buf_new()
    if !build_xlsx(&zbuf) {
        return 20
    }
    xl_open.xlsx_install_lazy()
    dx_imgfui.install_images()
    var d: dvdoc.Doc = dvdoc.doc_open_named(rt.buf_ptr(&zbuf), rt.buf_len(&zbuf), "x.xlsx")
    if !dvdoc.doc_ok(&d) {
        return 1
    }
    if dvdoc.doc_kind(&d) != kinds.KIND_XLSX {
        return 2
    }
    if dvdoc.doc_pages(&d) != 1 {
        return 3
    }
    var w: i32 = 0
    var h: i32 = 0
    if !dvdoc.doc_page_size(&d, 0, &w, &h) || w < 700 || h < 500 || w <= h {
        return 4
    }
    var buf: rt.Buf = rt.buf_new()
    var rw: i32 = 0
    var rh: i32 = 0
    if !dvdoc.doc_render(&d, 0, 1.0, &buf, &rw, &rh) || rw != w || rh != h || rt.buf_len(&buf) != (rw as usize) * (rh as usize) * 4 {
        return 5
    }
    var txt: rt.Buf = rt.buf_new()
    if !dvdoc.doc_text(&d, 0, &txt) {
        return 6
    }
    let want: str = "Data\nHello\nFirn\n1234.5\nTRUE"
    if rt.buf_len(&txt) != want.n {
        return 7
    }
    var i: usize = 0
    while i < want.n {
        if rt.buf_at(&txt, i) != rt.ld8(want.p as u64, i) {
            return 8
        }
        i = i + 1
    }
    if dvdoc.doc_page_size(&d, 1, &w, &h) {
        return 9
    }
    dvdoc.doc_free(&d)
    if dvdoc.doc_ok(&d) {
        return 10
    }
    var bad: str = "PK\x03\x04 garbage"
    var d2: dvdoc.Doc = dvdoc.doc_open(bad.p as u64, bad.n)
    if dvdoc.doc_ok(&d2) {
        return 11
    }
    rt.buf_free(&buf)
    rt.buf_free(&txt)
    rt.buf_free(&zbuf)
    return 0
}
