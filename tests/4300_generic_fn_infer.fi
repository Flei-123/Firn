// expect_exit: 0
// tests/4300_generic_fn_infer.fi -- r742: type arguments of a generic fn come from the expected `fn` type.
import std.vec

struct Ops { f: fn(i32) -> i32 }

fn id[T](x: T) -> T { return x }
fn dbl[T](x: T) -> T { return x + x }
fn add2[T](a: T, b: T) -> T { return a + b }
fn apply(f: fn(i32) -> i32, v: i32) -> i32 { return f(v) }
fn apply64(f: fn(i64) -> i64, v: i64) -> i64 { return f(v) }
fn apply2(f: fn(u8, u8) -> u8, a: u8, b: u8) -> u8 { return f(a, b) }
fn count[T](v: *mut Vec[T]) -> i32 { return vec_len[T](v) as i32 }
fn call_count(f: fn(*mut Vec[i32]) -> i32, v: *mut Vec[i32]) -> i32 { return f(v) }

#[no_inline]
fn pick() -> fn(i64) -> i64 {
    return dbl
}

fn main() -> i32 {
    if apply(id, 4) != 4 { return 1 }
    if apply64(dbl, 21) != 42 { return 2 }
    if apply2(add2, 3, 4) != 7 { return 3 }
    let f: fn(i32) -> i32 = dbl
    if f(5) != 10 { return 4 }
    var g: fn(i64) -> i64 = id
    if g(9) != 9 { return 5 }
    g = dbl
    if g(9) != 18 { return 6 }
    let o = Ops { f: dbl }
    if o.f(4) != 8 { return 7 }
    if pick()(8) != 16 { return 8 }
    var v: Vec[i32] = vec_new[i32]()
    defer vec_free[i32](&v)
    vec_push[i32](&v, 77)
    vec_push[i32](&v, 78)
    if call_count(count, &v) != 2 { return 9 }
    return 0
}
