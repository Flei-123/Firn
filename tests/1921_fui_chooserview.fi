// expect_exit: 42
// tests/1921_fui_chooserview.fi -- lib/fuishell/chooserview.fi (OpenPlan
// LIB-005): the file chooser on the screen -- its layout, the keys (with
// scrolling that follows the selection), the wheel, clicks and double
// clicks, the "up" button, typing a name in a save dialog (UTF-8 aware
// backspace), the size column, and the pixels it draws. Works in a
// directory of its own under /tmp.
import fuishell.filechooser
import fuishell.chooserview
import fui.layout
import fui.painter
import fui.theme
import paint.canvas
import font.metrics
import std.fs
import std.rt
import std.str

const FONTSET_BYTES: usize = 4096

fn scratch() -> str {
    var b: rt.Buf = rt.buf_new()
    let head: str = "/tmp/firn_fc_1921_"
    rt.buf_push_bytes(&b, head.p as u64, head.length())
    rt.buf_push_dec_i64(&b, syscall(39, 0, 0, 0, 0, 0, 0))
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

fn touch(path: str, size: usize) {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < size {
        rt.buf_push(&b, 120 as u8)
        i = i + 1
    }
    fs.write_file(path, rt.buf_ptr(&b), size) catch 0
    rt.buf_free(&b)
}

fn size_is(n: u64, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    chooserview.fcv_size_text(&b, n)
    let ok: bool = str { p: rt.buf_data(&b), n: rt.buf_len(&b) } == want
    rt.buf_free(&b)
    return ok
}

fn is(r: layout.Rect, x: i64, y: i64, w: i64, h: i64) -> bool {
    return r.x == x && r.y == y && r.w == w && r.h == h
}

fn px(cv: *mut canvas.Canvas, x: i64, y: i64) -> u32 {
    return canvas.canvas_get(cv, x as usize, y as usize) | 4278190080 as u32
}

fn col(c: u32) -> u32 {
    return c | 4278190080 as u32
}

fn main() -> i32 {
    // --- A. the size column
    if !size_is(0, "0 B") || !size_is(1023, "1023 B") || !size_is(1024, "1.0 KB") { return 1 as i32 }
    if !size_is(1536, "1.5 KB") || !size_is(12582912, "12.0 MB") || !size_is(10485759, "9.9 MB") { return 2 as i32 }

    let root: str = scratch()
    fs.remove_tree(root) catch false
    fs.mkdir_all(root + "/sub") catch false
    touch(root + "/sub/inner.opz", 4)
    var k: usize = 0
    while k < 30 {
        var nb: rt.Buf = rt.buf_new()
        let head: str = "/f"
        rt.buf_push_bytes(&nb, head.p as u64, 2)
        if k < 10 { rt.buf_push(&nb, 48 as u8) }
        rt.buf_push_dec_u64(&nb, k as u64)
        let tail: str = ".opz"
        rt.buf_push_bytes(&nb, tail.p as u64, 4)
        touch(root + __str_copy(str { p: rt.buf_data(&nb), n: rt.buf_len(&nb) }), 1536)
        rt.buf_free(&nb)
        k = k + 1
    }

    var fc: filechooser.FileChooser = filechooser.fc_new(filechooser.FC_OPEN, "*.opz")
    if !filechooser.fc_open_dir(&fc, root) { return 3 as i32 }
    if filechooser.fc_count(&fc) != 31 { return 4 as i32 }

    // --- B. the layout: bar 28, bottom 36, list 236 = 11 rows of 20
    var v: chooserview.ChooserView = chooserview.fcv_new(20)
    chooserview.fcv_set_labels(&v, "Open", "Cancel")
    chooserview.fcv_layout(&v, 0, 0, 400, 300, false)
    if !is(chooserview.fcv_list_rect(&v), 0, 28, 400, 236) { return 5 as i32 }
    if chooserview.fcv_visible_rows(&v) != 11 { return 6 as i32 }
    if !is(chooserview.fcv_ok_rect(&v), 296, 272, 96, 20) { return 7 as i32 }
    if !is(chooserview.fcv_cancel_rect(&v), 192, 272, 96, 20) { return 8 as i32 }
    if !is(chooserview.fcv_up_rect(&v), 4, 4, 20, 20) { return 9 as i32 }
    if chooserview.fcv_name_rect(&v).w != 0 { return 10 as i32 }
    if !is(chooserview.fcv_row_rect(&v, 3), 0, 88, 400, 20) || chooserview.fcv_row_rect(&v, 11).w != 0 { return 11 as i32 }

    // --- C. keys: the list follows the selection
    if filechooser.fc_selected(&fc) != 0 { return 12 as i32 }
    chooserview.fcv_key(&v, &fc, chooserview.FCK_END)
    if filechooser.fc_selected(&fc) != 30 || chooserview.fcv_top(&v) != 20 { return 13 as i32 }
    chooserview.fcv_key(&v, &fc, chooserview.FCK_HOME)
    if filechooser.fc_selected(&fc) != 0 || chooserview.fcv_top(&v) != 0 { return 14 as i32 }
    chooserview.fcv_key(&v, &fc, chooserview.FCK_PAGE_DOWN)
    if filechooser.fc_selected(&fc) != 11 || chooserview.fcv_top(&v) != 1 { return 15 as i32 }
    chooserview.fcv_key(&v, &fc, chooserview.FCK_DOWN)
    if filechooser.fc_selected(&fc) != 12 || chooserview.fcv_top(&v) != 2 { return 16 as i32 }
    chooserview.fcv_key(&v, &fc, chooserview.FCK_PAGE_UP)
    if filechooser.fc_selected(&fc) != 1 || chooserview.fcv_top(&v) != 1 { return 17 as i32 }
    chooserview.fcv_key(&v, &fc, chooserview.FCK_UP)
    if filechooser.fc_selected(&fc) != 0 || chooserview.fcv_top(&v) != 0 { return 18 as i32 }
    if chooserview.fcv_key(&v, &fc, chooserview.FCK_ESCAPE) != chooserview.FCV_CANCEL { return 19 as i32 }

    // --- D. the wheel, clamped at both ends
    chooserview.fcv_scroll(&v, &fc, 100)
    if chooserview.fcv_top(&v) != 20 { return 20 as i32 }
    chooserview.fcv_scroll(&v, &fc, -3)
    if chooserview.fcv_top(&v) != 17 { return 21 as i32 }
    // row 0 on the screen is now entry 17
    if chooserview.fcv_row_at(&v, &fc, 50, 30) != 17 { return 22 as i32 }
    chooserview.fcv_scroll(&v, &fc, -100)
    if chooserview.fcv_top(&v) != 0 { return 23 as i32 }
    // below the last row, in the bar, outside: no row
    if chooserview.fcv_row_at(&v, &fc, 50, 10) != -1 || chooserview.fcv_row_at(&v, &fc, 50, 270) != -1 { return 24 as i32 }

    // --- E. the mouse
    if chooserview.fcv_mouse_down(&v, &fc, 50, 28 + 20 + 5, 1) != chooserview.FCV_SELECTED { return 25 as i32 }
    if filechooser.fc_selected(&fc) != 1 { return 26 as i32 }
    // a double click on the directory "sub" (row 0) goes in
    if chooserview.fcv_mouse_down(&v, &fc, 50, 28 + 5, 2) != chooserview.FCV_ENTERED { return 27 as i32 }
    if filechooser.fc_dir(&fc) != root + "/sub" || filechooser.fc_count(&fc) != 1 { return 28 as i32 }
    // the "up" button comes back
    if chooserview.fcv_mouse_down(&v, &fc, 10, 10, 1) != chooserview.FCV_ENTERED { return 29 as i32 }
    if filechooser.fc_dir(&fc) != root || filechooser.fc_count(&fc) != 31 { return 30 as i32 }
    // Enter on the directory: in; Backspace: out again
    filechooser.fc_select(&fc, 0)
    if chooserview.fcv_key(&v, &fc, chooserview.FCK_ENTER) != chooserview.FCV_ENTERED { return 31 as i32 }
    if chooserview.fcv_key(&v, &fc, chooserview.FCK_BACKSPACE) != chooserview.FCV_ENTERED { return 32 as i32 }
    if filechooser.fc_dir(&fc) != root { return 33 as i32 }
    // cancel, then a double click on a file chooses it
    if chooserview.fcv_mouse_down(&v, &fc, 200, 280, 1) != chooserview.FCV_CANCEL { return 34 as i32 }
    if chooserview.fcv_mouse_down(&v, &fc, 50, 28 + 20 + 5, 2) != chooserview.FCV_CHOSEN { return 35 as i32 }
    if filechooser.fc_result(&fc) != root + "/f00.opz" { return 36 as i32 }
    // the OK button chooses the selection
    filechooser.fc_select(&fc, 5)
    if chooserview.fcv_mouse_down(&v, &fc, 300, 280, 1) != chooserview.FCV_CHOSEN { return 37 as i32 }
    if filechooser.fc_result(&fc) != root + "/f04.opz" { return 38 as i32 }
    // typing is ignored outside a save dialog
    if chooserview.fcv_type(&v, &fc, "x") != chooserview.FCV_NOTHING { return 39 as i32 }

    // --- F. a save dialog: the name field and typing
    var sc: filechooser.FileChooser = filechooser.fc_new(filechooser.FC_SAVE, "*.opz")
    if !filechooser.fc_open_dir(&sc, root) { return 40 as i32 }
    var sv: chooserview.ChooserView = chooserview.fcv_new(20)
    chooserview.fcv_layout(&sv, 0, 0, 400, 300, true)
    if !is(chooserview.fcv_name_rect(&sv), 8, 272, 176, 20) { return 41 as i32 }
    filechooser.fc_set_name(&sc, "")
    chooserview.fcv_type(&sv, &sc, "pl")
    chooserview.fcv_type(&sv, &sc, "an")
    if filechooser.fc_typed_name(&sc) != "plan" { return 48 as i32 }
    chooserview.fcv_type(&sv, &sc, "ü")
    if filechooser.fc_typed_name(&sc).n != 6 { return 43 as i32 }
    chooserview.fcv_key(&sv, &sc, chooserview.FCK_BACKSPACE)
    if filechooser.fc_typed_name(&sc) != "plan" { return 44 as i32 }
    chooserview.fcv_key(&sv, &sc, chooserview.FCK_BACKSPACE)
    chooserview.fcv_type(&sv, &sc, "n")
    // backspace edited the name -- the directory stayed
    if filechooser.fc_dir(&sc) != root { return 45 as i32 }
    if chooserview.fcv_key(&sv, &sc, chooserview.FCK_ENTER) != chooserview.FCV_CHOSEN { return 46 as i32 }
    if filechooser.fc_result(&sc) != root + "/plan.opz" { return 47 as i32 }

    // --- G. the pixels
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, 400, 300) { return 50 as i32 }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 400, 200) { return 51 as i32 }
    var m: theme.Theme = theme.theme_new(false)
    let c: *mut theme.Colors = theme.theme_colors(&m)
    filechooser.fc_select(&fc, 2)
    canvas.canvas_clear(&cv, 4278190080 as u32)
    chooserview.fcv_paint(&v, &fc, &z, c, 13.0)
    // the selected row (entry 2 = third row) against a plain one
    if px(&cv, 396, 28 + 40 + 10) != col((*c).selection) { return 52 as i32 }
    if px(&cv, 396, 28 + 60 + 10) != col((*c).base) { return 53 as i32 }
    // the directory mark (row 0) is filled with the accent, a file's is a frame
    if px(&cv, 8 + 5, 28 + 10) != col((*c).accent) { return 54 as i32 }
    if px(&cv, 8, 28 + 20 + 10) != col((*c).text_muted) { return 55 as i32 }
    if px(&cv, 8 + 5, 28 + 20 + 10) != col((*c).base) { return 56 as i32 }
    // OK is the accent button, Cancel a plain one with a frame
    if px(&cv, 300, 275) != col((*c).accent) { return 57 as i32 }
    if px(&cv, 194, 275) != col((*c).button) || px(&cv, 192, 272) != col((*c).border_col) { return 58 as i32 }
    // the path field and the dialog ground
    if px(&cv, 390, 8) != col((*c).field) { return 59 as i32 }
    if px(&cv, 2, 2) != col((*c).surface) { return 60 as i32 }
    // the save dialog shows its name field with an accent frame
    canvas.canvas_clear(&cv, 4278190080 as u32)
    chooserview.fcv_paint(&sv, &sc, &z, c, 13.0)
    if px(&cv, 8, 280) != col((*c).accent) || px(&cv, 150, 285) != col((*c).field_focus) { return 61 as i32 }

    // --- H. with a font: names, sizes and the path get ink
    var fbuf: rt.Buf = rt.buf_new()
    var fpath: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
    if rt.read_file((&fpath[0]) as u64, &fbuf) {
        let fsp: *mut metrics.FontSet = rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
        *fsp = metrics.fontset_new()
        if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) { return 62 as i32 }
        painter.painter_set_font(&z, fsp as u64)
        canvas.canvas_clear(&cv, 4278190080 as u32)
        chooserview.fcv_paint(&v, &fc, &z, c, 13.0)
        var name_ink: i64 = 0
        var size_ink: i64 = 0
        var y: i64 = 28 + 60
        while y < 28 + 80 {
            var x: i64 = 30
            while x < 120 {
                if px(&cv, x, y) != col((*c).base) { name_ink = name_ink + 1 }
                x = x + 1
            }
            x = 302
            while x < 392 {
                if px(&cv, x, y) != col((*c).base) { size_ink = size_ink + 1 }
                x = x + 1
            }
            y = y + 1
        }
        if name_ink < 20 || size_ink < 20 { return 63 as i32 }
        // the size is right-aligned: the last pixels before the pad carry ink
        var right: i64 = 0
        y = 28 + 60
        while y < 28 + 80 {
            var x2: i64 = 380
            while x2 < 392 {
                if px(&cv, x2, y) != col((*c).base) { right = right + 1 }
                x2 = x2 + 1
            }
            y = y + 1
        }
        if right == 0 { return 64 as i32 }
    }

    fs.remove_tree(root) catch false
    filechooser.fc_free(&fc)
    filechooser.fc_free(&sc)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 42 as i32
}
