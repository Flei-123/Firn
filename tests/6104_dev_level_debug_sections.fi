// expect_exit: 0
import std.rt

struct Pair {
    left: i32
    right: i32
}

fn leaf(a: i32, b: i32) -> i32 {
    var p: Pair = Pair { left: a, right: b }
    var arr: [i32; 4] = [0; 4]
    arr[1] = p.left
    arr[2] = p.right
    return arr[1] + arr[2]
}

fn main() -> i32 {
    let r: i32 = leaf(7, 5)
    if r != 12 {
        return 1
    }
    return 0
}
