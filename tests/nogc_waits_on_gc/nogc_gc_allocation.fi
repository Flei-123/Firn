// expect_error: 11:13 ist #[no_gc], alloziert aber ueber
// expect_error_count: 1
// Regel (i) aus SPEC §3.5.4: in einem #[no_gc]-Aufrufbaum darf keine
// GC-Allokation stehen, weil sie einen Sammellauf ausloesen kann.
gc class Node {
    mark: i32
}

#[no_gc]
fn hot() -> i32 {
    let k = gc Node{ mark: 1 as i32 }
    return k.mark
}

fn main() -> i32 {
    return hot()
}
