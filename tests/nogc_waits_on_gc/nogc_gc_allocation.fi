// expect_error: 11:13 is #[no_gc], but allocates on the GC heap via
// expect_error_count: 1
// Rule (i) from SPEC 3.5.4: in a #[no_gc] call tree there must be no
// GC allocation, because it can trigger a collection.
gc class Node {
    mark: i32
}

#[no_gc]
fn hot() -> i32 {
    let k = gc Node { mark: 1 as i32 }
    return k.mark
}

fn main() -> i32 {
    return hot()
}
