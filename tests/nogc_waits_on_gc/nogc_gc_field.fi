// expect_error: 12:7 ist #[no_gc], schreibt aber in das GC-Feld 'next'
// expect_error_count: 1
// Regel (iii) aus SPEC §3.5.4: das Schreiben eines Gc-Zeigers in ein Feld
// braucht die Einfuegebarriere und ist in einem #[no_gc]-Aufrufbaum verboten.
gc class Node {
    next: Gc[Node]
    mark: i32
}

#[no_gc]
fn hang_an(a: Gc[Node], b: Gc[Node]) -> i32 {
    a.next = b
    return a.mark
}

fn main() -> i32 {
    return 0 as i32
}
