// expect_error: 12:7 is #[no_gc], but writes into the GC field 'next'
// expect_error_count: 1
// Rule (iii) from SPEC 3.5.4: writing a Gc pointer into a field
// needs the write barrier and is forbidden in a #[no_gc] call tree.
gc class Node {
    next: Gc[Node]
    mark: i32
}

#[no_gc]
fn hang_an(a: Gc[Node], b: Gc[Node]) -> i32 {
    a.next = b
    return a.mark
}

fn main() -> i32 {
    return 0 as i32
}
