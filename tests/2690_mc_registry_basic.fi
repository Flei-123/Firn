// expect_exit: 0
// tests/2690_mc_registry_basic.fi -- mc_registry through the version object (1.20.1 and 1.12.2):
// lookups, state decoding, the opaque table, hostile arguments. The exhaustive comparison with
// minecraft-data / prismarine-block (all states of five versions) is tools/mc/registry/run.sh.
import std.rt
import mc.mc_registry
import mc.mc_version
import mc.mc_versions

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn text_is(r: *mut mc_registry.Registry, state: i32, want: u64, n: usize) -> bool {
    var b: rt.Buf = rt.buf_new()
    let ok: bool = mc_registry.reg_state_text(r, state, &b)
    let same: bool = ok && rt.buf_len(&b) == n && rt.mem_eq(rt.buf_ptr(&b), want, n)
    rt.buf_free(&b)
    return same
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 1)
    var r: mc_registry.Registry = v.registry_of()
    check(mc_registry.registry_ok(&r), 2)
    check(mc_registry.reg_block_count(&r) == 1003, 3)
    check(mc_registry.reg_state_count(&r) == 24135, 4)
    // state 0 is air, state 1 is stone
    check(text_is(&r, 0, "air".p as u64, 3), 5)
    check(text_is(&r, 1, "stone".p as u64, 5), 6)
    let stone: i32 = mc_registry.reg_block_by_name(&r, "stone".p as u64, 5)
    check(stone >= 0, 7)
    check(mc_registry.reg_block_min_state(&r, stone) == 1, 8)
    check(mc_registry.reg_block_of_state(&r, 1) == stone, 9)
    // out of range and negative states are refused
    check(mc_registry.reg_block_of_state(&r, 0 - 1) == 0 - 1, 10)
    check(mc_registry.reg_block_of_state(&r, 24135) == 0 - 1, 11)
    check(mc_registry.reg_block_of_state(&r, 2000000000) == 0 - 1, 12)
    check(mc_registry.reg_block_by_name(&r, "no_such_block".p as u64, 13) == 0 - 1, 13)
    // a block with properties: grass_block[snowy=true] is the first of its two states
    let gb: i32 = mc_registry.reg_block_by_name(&r, "grass_block".p as u64, 11)
    check(gb >= 0 && mc_registry.reg_prop_count(&r, gb) == 1, 14)
    check(text_is(&r, mc_registry.reg_block_min_state(&r, gb), "grass_block[snowy=true]".p as u64, 23), 15)
    check(text_is(&r, mc_registry.reg_block_max_state(&r, gb), "grass_block[snowy=false]".p as u64, 24), 16)
    // items and the opaque table
    check(mc_registry.reg_item_by_name(&r, "stone".p as u64, 5) == 1, 17)
    let tab: u64 = rt.heap_alloc(24135)
    mc_registry.reg_fill_opaque(&r, tab)
    check(rt.ld8(tab, 0) == 0 as u8, 18) // air is not opaque
    check(rt.ld8(tab, 1) == 1 as u8, 19) // stone is
    rt.heap_free(tab, 24135)

    // a pre-flattening version: state = id << 4 | metadata, no properties
    var o: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(340, &o), 30)
    var q: mc_registry.Registry = o.registry_of()
    check(mc_registry.registry_ok(&q), 31)
    check(mc_registry.reg_state_count(&q) == 4096, 32)
    let st: i32 = mc_registry.reg_block_by_name(&q, "stone".p as u64, 5)
    check(st == 1, 33)
    check(mc_registry.reg_block_min_state(&q, st) == 16, 34)
    check(text_is(&q, 16 + 3, "stone".p as u64, 5), 35) // stone, metadata 3 (diorite)

    // an empty registry (no blob) must not crash and reports itself as not ok
    var none: mc_registry.Registry = mc_registry.registry_open(0)
    check(!mc_registry.registry_ok(&none), 40)
    return 0
}
