// expect_exit: 0
// tests/4981_mc_scaffold_states.fi -- scaffolding block states: shape code (stable / sagging) and movement kind from the registry; ice / slime / bubble column kinds.
import std.rt
import mc.mc_version
import mc.mc_versions
import mc.mc_registry
import mc.mc_shapes
import mc.mc_move_fluid
import mc.mc_scaffold
import mc.mc_slide

fn name_is(np: u64, nl: usize, s: str) -> bool {
    if nl != s.n { return false }
    var i: usize = 0
    while i < nl {
        if rt.ld8(np, i) != rt.ld8(s.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

fn bump(t: u64, i: i32) {
    rt.st32(t, i as usize, rt.ld32(t, i as usize) + 1 as u32)
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 1 }
    var r: mc_registry.Registry = v.registry_of()
    let ns: i32 = mc_registry.reg_state_count(&r)
    var stable: i32 = 0
    var sagging: i32 = 0
    var climb: i32 = 0
    var ice: i32 = 0
    var blue: i32 = 0
    var packed: i32 = 0
    var slime: i32 = 0
    var up: i32 = 0
    var down: i32 = 0
    var s: i32 = 0
    while s < ns {
        let b: i32 = mc_registry.reg_block_of_state(&r, s)
        var nl: usize = 0
        let np: u64 = mc_registry.reg_block_name(&r, b, &nl)
        if name_is(np, nl, "scaffolding") {
            let c: i32 = mc_shapes.shape_code_for_state(&r, s)
            if c == mc_scaffold.CODE_STABLE { stable = stable + 1 }
            if c == mc_scaffold.CODE_SAGGING { sagging = sagging + 1 }
            if mc_shapes.move_kind_for_state(&r, s) == mc_move_fluid.MV_SCAFFOLD { climb = climb + 1 }
        }
        let k: i32 = mc_shapes.move_kind_for_state(&r, s)
        if k == mc_slide.MV_ICE { ice = ice + 1 }
        if k == mc_slide.MV_PACKED_ICE { packed = packed + 1 }
        if k == mc_slide.MV_BLUE_ICE { blue = blue + 1 }
        if k == mc_slide.MV_SLIME { slime = slime + 1 }
        if name_is(np, nl, "bubble_column") {
            if mc_move_fluid.kind_bubble(k) == 1 { up = up + 1 }
            if mc_move_fluid.kind_bubble(k) == 2 { down = down + 1 }
        }
        s = s + 1
    }
    if ice != 5 || packed != 1 { return 5 }
    if blue != 1 { return 6 }
    if slime != 1 { return 7 }
    if up != 1 || down != 1 { return 8 }
    if stable != 18 { return 2 }
    if sagging != 14 { return 3 }
    if climb != 16 { return 4 }
    return 0
}
