// expect_exit: 0
// tests/2756_mc_blend.fi -- mc_blend: the 4-pixels-at-a-time SIMD mix is bit identical to the scalar version
// (every weight 0..256, every tail length 0..9, random pixels), plus hand-computed values.
import std.rt
import mc.mc_blend

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    // hand computed: (c * (256 - f) + k * f) >> 8 per channel, alpha stays 255
    check(mc_blend.mix_pixel(0xFF000000 as u32, 0x00FFFFFF as u32, 128 as u32) == 0xFF7F7F7F as u32, 1)
    check(mc_blend.mix_pixel(0xFF102030 as u32, 0x00FFFFFF as u32, 0 as u32) == 0xFF102030 as u32, 2)
    check(mc_blend.mix_pixel(0xFF102030 as u32, 0x00AABBCC as u32, 256 as u32) == 0xFFAABBCC as u32, 3)
    check(mc_blend.mix_pixel(0xFFFFFFFF as u32, 0 as u32, 256 as u32) == 0xFF000000 as u32, 4)
    let a: u64 = rt.heap_alloc(64 * 4)
    let b: u64 = rt.heap_alloc(64 * 4)
    var seed: u64 = 12345 as u64
    var f: u32 = 0 as u32
    var cases: i32 = 0
    while f <= 256 as u32 {
        var n: usize = 0
        while n < 10 {
            var i: usize = 0
            while i < 40 {
                seed = (seed * 1664525 as u64 + 1013904223 as u64) & 0xFFFFFFFF as u64
                let px: u32 = (seed as u32) | 0xFF000000 as u32
                rt.st32(a, i, px)
                rt.st32(b, i, px)
                i = i + 1
            }
            seed = (seed * 1664525 as u64 + 1013904223 as u64) & 0xFFFFFFFF as u64
            let rgb: u32 = (seed as u32) & 0xFFFFFF as u32
            mc_blend.mix_span(a, n + 24, rgb, f)
            mc_blend.mix_span_scalar(b, n + 24, rgb, f)
            i = 0
            while i < 40 {
                check(rt.ld32(a, i) == rt.ld32(b, i), 10)
                i = i + 1
            }
            cases = cases + 1
            n = n + 1
        }
        f = f + 3 as u32
    }
    // blend_span (the mc_hud formula, exact /255): every alpha 0..255 against the scalar version
    var al: u32 = 0 as u32
    while al <= 255 as u32 {
        var n2: usize = 0
        while n2 < 6 {
            var j: usize = 0
            while j < 40 {
                seed = (seed * 1664525 as u64 + 1013904223 as u64) & 0xFFFFFFFF as u64
                let px: u32 = (seed as u32) | 0xFF000000 as u32
                rt.st32(a, j, px)
                rt.st32(b, j, px)
                j = j + 1
            }
            seed = (seed * 1664525 as u64 + 1013904223 as u64) & 0xFFFFFFFF as u64
            let rgb2: u32 = (seed as u32) & 0xFFFFFF as u32
            mc_blend.blend_span(a, n2 + 25, rgb2, al)
            mc_blend.blend_span_scalar(b, n2 + 25, rgb2, al)
            j = 0
            while j < 40 {
                check(rt.ld32(a, j) == rt.ld32(b, j), 20)
                j = j + 1
            }
            n2 = n2 + 1
        }
        al = al + 1 as u32
    }
    check(mc_blend.blend_pixel(0xFF000000 as u32, 0x00FFFFFF as u32, 128 as u32) == 0xFF808080 as u32, 21)
    check(mc_blend.blend_pixel(0xFF336699 as u32, 0x00FFFFFF as u32, 0 as u32) == 0xFF336699 as u32, 22)
    check(mc_blend.blend_pixel(0xFF336699 as u32, 0x00102030 as u32, 255 as u32) == 0xFF102030 as u32, 23)
    // f = 256 exactly (3 does not hit it) and a weight above 256 (clamped)
    var i2: usize = 0
    while i2 < 8 {
        rt.st32(a, i2, 0xFF336699 as u32)
        i2 = i2 + 1
    }
    mc_blend.mix_span(a, 8, 0x00102030 as u32, 256 as u32)
    check(rt.ld32(a, 7) == 0xFF102030 as u32, 11)
    mc_blend.mix_span(a, 8, 0x00FFFFFF as u32, 1000 as u32)
    check(rt.ld32(a, 0) == 0xFFFFFFFF as u32, 12)
    check(cases == 860, 13)
    return 0
}
