// expect_exit: 6
// r200: an enum with a `drop` in its payload destroys ONLY the payload of the
// variant that is stored, chosen by the tag at run time.
struct R {
    c: *mut i64
}
impl R {
    fn drop(inout self) {
        *self.c = *self.c + 1
    }
}
enum E {
    A(R),
    B(i64),
    C(R, R),
    D
}
fn run(k: i32, c: *mut i64) {
    var e: E = E::B(3)
    if k == 1 {
        e = E::A(R { c: c })
    }
    if k == 2 {
        e = E::C(R { c: c }, R { c: c })
    }
    if k == 3 {
        e = E::D
    }
    match e {
        E::A(_) => {}
        E::B(v) => {
            *c = *c + v - v
        }
        _ => {}
    }
}
fn main() -> i32 {
    var n: i64 = 0
    run(0, &n)
    run(1, &n)
    run(2, &n)
    run(3, &n)
    run(1, &n)
    run(2, &n)
    return n as i32
}
