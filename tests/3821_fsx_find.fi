// expect_exit: 0
// tests/3821_fsx_find.fi -- fsx.find: glob on the base name, min size, mtime
// limit, sorted full paths, appending to a non-empty Vec. Random trees against
// Python: tools/vspy_cross/run.sh.
import std.io
import std.rt
import std.fs
import std.fsx
import std.vec
import std.str
import std.testkit

static mut ZEROS: [u8; 4096] = [0; 4096]

#[allow_escape]
fn work() -> FsError!bool {
    var d: fsx.TempDir = try fsx.temp_dir("find_t_")
    defer fsx.temp_dir_drop(&d)
    let root: str = fsx.temp_dir_path(&d)
    for i in 0..12 {
        let dir: str = io.fmt_string(f"{root}/d{i % 3}/s{i % 2}")
        try fs.mkdir_all(dir)
        var ext: str = "txt"
        if i % 4 == 1 { ext = "log" }
        let p: str = io.fmt_string(f"{dir}/f{i}.{ext}")
        try fs.write_file(p, (&ZEROS[0]) as u64, (i * 100) as usize)
        try fs.set_mtime(p, 1000000 + (i * 1000) as i64, true)
    }
    var all: Vec[str] = vec_new[str]()
    let n0 = try fsx.find(root, "*", 0, fsx.FIND_ANY_TIME, &all)
    testkit.check(n0 == 12 && vec_len[str](&all) == 12, "all files")
    var sorted: bool = true
    for i in 1..vec_len[str](&all) {
        if str.compare(*vec_elem_ptr[str](&all, i - 1), *vec_elem_ptr[str](&all, i)) >= 0 { sorted = false }
    }
    testkit.check(sorted, "sorted by full path")
    var txt: Vec[str] = vec_new[str]()
    let n1 = try fsx.find(root, "*.txt", 500, 1008000 * 1000000000, &txt)
    // txt: i%4 != 1 -> i in 0,2,3,4,6,7,8 ; size i*100 >= 500 -> 6,7,8 ; mtime < 1008000 -> i < 8
    testkit.check(n1 == 2, "pattern + size + mtime")
    testkit.check(fsx.relpath(*vec_elem_ptr[str](&txt, 0), root) == "d0/s0/f6.txt", "first hit")
    let n2 = try fsx.find(root, "f1?.log", 0, fsx.FIND_ANY_TIME, &txt)
    testkit.check(n2 == 0 && vec_len[str](&txt) == 2, "no hit appends nothing")
    let n3 = try fsx.find(root, "f?.log", 0, fsx.FIND_ANY_TIME, &txt)
    testkit.check(n3 == 3 && vec_len[str](&txt) == 5, "appends after existing entries")
    var none: Vec[str] = vec_new[str]()
    testkit.check((fsx.find(root + "/missing", "*", 0, fsx.FIND_ANY_TIME, &none) catch 99) == 99, "missing root is an error")
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    testkit.check(work() catch | e | false, "work ran")
    return testkit.finish()
}
