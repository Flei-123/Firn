// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_raster
import mc.mc_hud
import mc.mc_gui_tex
import mc.mc_camera
import mc.mc_crack
import mc.mc_crack_anim
import mc.mc_ray_clear

fn stage_tex(opaque_gray: u32, hole_x: i32) -> mc_gui_tex.GuiTex {
    var t: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    mc_gui_tex.gtex_blank(&t, 16, 16)
    var y: i32 = 0
    while y < 16 {
        var x: i32 = 0
        while x < 16 {
            var c: u32 = 0x01FFFFFF as u32
            if x != hole_x { c = 0xFF000000 as u32 | (opaque_gray << 16 as u32) | (opaque_gray << 8 as u32) | opaque_gray }
            mc_gui_tex.gtex_set(&t, x, y, c)
            x = x + 1
        }
        y = y + 1
    }
    return t
}

fn build_tex(t: *mut mc_crack.CrackTex, gray: u32) -> bool {
    var st: [mc_gui_tex.GuiTex; 10] = [mc_gui_tex.gtex_empty(); 10]
    var i: usize = 0
    while i < 10 {
        st[i] = stage_tex(gray, 0 - 1)
        i = i + 1
    }
    let ok: bool = mc_crack.crack_tex_from_stages(t, &st)
    i = 0
    while i < 10 {
        mc_gui_tex.gtex_free(&st[i])
        i = i + 1
    }
    return ok
}

fn record_count(rec: *mut rt.Buf) -> usize {
    return rt.buf_len(rec) / 24
}

fn rect_word(rec: *mut rt.Buf, i: usize, k: usize) -> u32 {
    return rt.ld32(rt.buf_ptr(rec), i * 6 + k)
}

fn wall_z2(ud: u64, x: i32, y: i32, z: i32) -> bool {
    return z == 2 && x >= 0 - 5 && x <= 5
}

fn vis_never(ud: u64, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) -> bool {
    return false
}

fn vis_wall(ud: u64, ax: f64, ay: f64, az: f64, bx: f64, by: f64, bz: f64) -> bool {
    return mc_ray_clear.ray_clear(wall_z2, ud, ax, ay, az, bx, by, bz)
}

fn covered(rec: *mut rt.Buf) -> i64 {
    var total: i64 = 0
    var i: usize = 0
    while i < record_count(rec) {
        total = total + ((rect_word(rec, i, 2) - rect_word(rec, i, 0)) as i64) * ((rect_word(rec, i, 3) - rect_word(rec, i, 1)) as i64)
        i = i + 1
    }
    return total
}

#[allow_escape]
fn main() -> i32 {
    if mc_ray_clear.ray_clear(wall_z2, 0 as u64, 0.5, 0.5, 0.0 - 3.0, 0.5, 0.5, 5.0) { return 1 }
    if !mc_ray_clear.ray_clear(wall_z2, 0 as u64, 0.5, 0.5, 0.0 - 3.0, 0.5, 0.5, 1.99) { return 2 }
    if !mc_ray_clear.ray_clear(wall_z2, 0 as u64, 0.5, 0.5, 6.0, 0.5, 0.5, 3.01) { return 3 }
    if mc_ray_clear.ray_clear(wall_z2, 0 as u64, 0.5, 0.5, 6.0, 0.5, 0.5, 0.5) { return 4 }
    if !mc_ray_clear.ray_clear(wall_z2, 0 as u64, 0.5, 0.5, 0.0 - 3.0, 9.5, 0.5, 5.0) { return 5 }
    if mc_ray_clear.ray_clear(wall_z2, 0 as u64, 0.5, 0.5, 0.0 - 3.0, 0.0 - 4.5, 3.5, 8.0) { return 6 }
    if mc_ray_clear.ray_clear(wall_z2, 0 as u64, 0.0 - 0.5, 4.5, 0.0 - 3.0, 3.5, 0.5, 6.0) { return 7 }

    var t: mc_crack.CrackTex = mc_crack.crack_tex_new()
    if !build_tex(&t, 61 as u32) { return 11 }
    var cam: mc_camera.Camera = mc_camera.camera_new(160, 90)
    mc_camera.camera_set_pos(&cam, 0.5, 0.5, 0.0 - 3.0)
    mc_camera.camera_set_angles(&cam, 0.0, 0.0)
    mc_camera.camera_update(&cam)
    var r: mc_raster.Raster = mc_raster.raster_new(160, 90)

    var front: mc_crack.CrackBox = mc_crack.CrackBox { x0: 0.0, y0: 0.0, z0: 0.0, x1: 1.0, y1: 1.0, z1: 1.0 }
    var behind: mc_crack.CrackBox = mc_crack.CrackBox { x0: 0.0, y0: 0.0, z0: 4.0, x1: 1.0, y1: 1.0, z1: 5.0 }
    var vis_w: mc_crack.CrackVis = mc_crack.CrackVis { test: vis_wall, ud: 0 as u64 }
    var vis_n: mc_crack.CrackVis = mc_crack.CrackVis { test: vis_never, ud: 0 as u64 }

    var rec: rt.Buf = rt.buf_new()
    mc_hud.hud_record(&rec)
    mc_crack.crack_draw(&r, &cam, &t, 4, &front, mc_crack.CRACK_ALL_FACES)
    let base: i64 = covered(&rec)
    if base <= 0 { return 20 }
    rt.buf_clear(&rec)
    mc_crack.crack_draw_vis(&r, &cam, &t, 4, &front, mc_crack.CRACK_ALL_FACES, &vis_w)
    if covered(&rec) != base { return 21 }
    rt.buf_clear(&rec)
    mc_crack.crack_draw_vis(&r, &cam, &t, 4, &front, mc_crack.CRACK_ALL_FACES, &vis_n)
    if record_count(&rec) != 0 { return 22 }
    rt.buf_clear(&rec)
    mc_crack.crack_draw(&r, &cam, &t, 4, &behind, mc_crack.CRACK_ALL_FACES)
    if covered(&rec) <= 0 { return 23 }
    rt.buf_clear(&rec)
    mc_crack.crack_draw_vis(&r, &cam, &t, 4, &behind, mc_crack.CRACK_ALL_FACES, &vis_w)
    if record_count(&rec) != 0 { return 24 }
    mc_hud.hud_record(0 as *mut rt.Buf)
    return 0
}
