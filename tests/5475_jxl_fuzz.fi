// expect_exit: 0
import jxl.jxl
import std.fs
import std.rt

static mut failures: i32 = 0
static mut runs: i32 = 0

fn next(s: *mut u32) -> u32 {
    *s = *s *% 1103515245 +% 12345
    return *s >> 8
}

fn try_decode(p: u64, n: usize) {
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let ok: bool = jxl.jxl_decode(p, n, &pic) catch false
    if ok && pic.size != (pic.width * pic.height * pic.channels * pic.bytes_per_sample) as usize {
        failures = failures + 1
    }
    jxl.jxl_picture_free(&pic)
    var info: jxl.JxlInfo = jxl.jxl_info_new()
    let ok2: bool = jxl.jxl_info(p, n, &info) catch false
    var fi: jxl.JxlFrameInfo = jxl.JxlFrameInfo { encoding: 0, flags: 0, width: 0, height: 0, num_passes: 0, num_groups: 0,
        num_lf_groups: 0, is_last: false, toc_count: 0, toc_total: 0, body_start: 0, remaining: 0 }
    let ok3: bool = jxl.jxl_frame_info(p, n, &fi) catch false
    runs = runs + 1
}

fn load_copy(path: str, out_n: *mut usize) -> u64 {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    let copy: u64 = rt.heap_alloc(n)
    rt.mem_copy(copy, rt.buf_ptr(&data), n)
    rt.buf_free(&data)
    *out_n = n
    return copy
}

fn fuzz_bits(path: str, nbytes: usize) {
    var n: usize = 0
    let base: u64 = load_copy(path, &n)
    let work: u64 = rt.heap_alloc(n)
    var limit: usize = nbytes
    if limit > n {
        limit = n
    }
    var i: usize = 0
    while i < limit * 8 {
        rt.mem_copy(work, base, n)
        let cell: *mut u8 = (work +% (i / 8) as u64) as *mut u8
        *cell = ((*cell) as u32 ^ ((1 as u32) << ((i % 8) as u32))) as u8
        try_decode(work, n)
        i = i + 1
    }
    rt.heap_free(work, n)
    rt.heap_free(base, n)
}

fn fuzz_random(path: str, seed: u32, rounds: u32) {
    var n: usize = 0
    let base: u64 = load_copy(path, &n)
    let work: u64 = rt.heap_alloc(n)
    var s: u32 = seed
    var r: u32 = 0
    while r < rounds {
        rt.mem_copy(work, base, n)
        let hits: u32 = 1 + next(&s) % 4
        var h: u32 = 0
        while h < hits {
            let at: usize = (next(&s) as usize) % n
            let cell: *mut u8 = (work +% at as u64) as *mut u8
            *cell = ((*cell) as u32 ^ (next(&s) & 255 | 1)) as u8
            h = h + 1
        }
        var cut: usize = n
        if r % 4 == 0 {
            cut = (next(&s) as usize) % n
        }
        try_decode(work, cut)
        r = r + 1
    }
    rt.heap_free(work, n)
    rt.heap_free(base, n)
}

fn fuzz_prefixes(path: str, step: usize) {
    var n: usize = 0
    let base: u64 = load_copy(path, &n)
    var cut: usize = 0
    while cut < n {
        try_decode(base, cut)
        cut = cut + step
    }
    rt.heap_free(base, n)
}

fn main() -> i32 {
    fuzz_bits("tests/data/jxl/rgb16x16.jxl", 40)
    fuzz_bits("tests/data/jxl/rgba17x9.jxl", 40)
    fuzz_bits("tests/data/jxl/grey20x20.jxl", 40)
    fuzz_bits("tests/data/jxl/greya24x24.jxl", 40)
    fuzz_bits("tests/data/jxl/mg/sq_rgb37x23.jxl", 48)
    fuzz_bits("tests/data/jxl/rgb40x40_e3.jxl", 48)
    fuzz_bits("tests/data/jxl/rgb64x64_e1.jxl", 48)
    fuzz_bits("tests/data/jxl/mg/sq_grey129x65.jxl", 40)
    fuzz_prefixes("tests/data/jxl/rgb16x16.jxl", 1)
    fuzz_prefixes("tests/data/jxl/mg/sq_rgb37x23.jxl", 1)
    fuzz_prefixes("tests/data/jxl/mg/mg_rgb300x260_order.jxl", 997)
    fuzz_random("tests/data/jxl/rgb16x16.jxl", 11, 400)
    fuzz_random("tests/data/jxl/rgb64x64_e9.jxl", 12, 300)
    fuzz_random("tests/data/jxl/rgb40x40_e3.jxl", 13, 300)
    fuzz_random("tests/data/jxl/mg/sq_rgb37x23.jxl", 14, 300)
    fuzz_random("tests/data/jxl/mg/sq_grey129x65.jxl", 15, 200)
    fuzz_random("tests/data/jxl/mg/mg_rgb300x260_order.jxl", 16, 40)
    fuzz_random("tests/data/jxl/mg/prog_rgb300x200.jxl", 17, 40)
    fuzz_random("tests/data/jxl/mg/pred_rgb120x100_p15.jxl", 18, 60)
    if runs < 3000 {
        failures = failures + 1
    }
    return failures
}
