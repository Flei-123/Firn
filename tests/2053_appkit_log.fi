// expect_exit: 0
// tests/2053_appkit_log.fi -- lib/appkit/log.fi: levels, the line format,
// rotation (keep 2), the tail, silence before open.
import std.rt
import std.fs
import appkit.log
import appkit.util

fn scratch() -> str {
    var b: rt.Buf = rt.buf_new()
    util.buf_push_str(&b, "/tmp/firn_appkit_log_2053_")
    rt.buf_push_dec_i64(&b, syscall(39, 0, 0, 0, 0, 0, 0))
    let s: str = util.buf_to_str_copy(&b)
    rt.buf_free(&b)
    return s
}

fn count_lines(p: u64, n: usize) -> usize {
    var k: usize = 0
    var i: usize = 0
    while i < n {
        if rt.ld8(p, i) == 10 as u8 { k = k + 1 }
        i = i + 1
    }
    return k
}

fn contains(p: u64, n: usize, w: str) -> bool {
    var i: usize = 0
    while i + w.n <= n {
        if rt.mem_eq(p + i as u64, w.p as u64, w.n) { return true }
        i = i + 1
    }
    return false
}

fn main() -> i32 {
    let root: str = scratch()
    fs.remove_tree(root) catch false
    // silent before open
    log.log_error("x", "nobody listens")
    if !log.log_open(root + "/logs", "app", log.LOG_INFO, 4096, 2) { return 1 }
    log.log_debug("t", "below the level")
    log.log_info("update", "checking the store")
    log.log_warn("update", "slow answer\nsecond line")
    log.log_error("net", "failed")
    var b: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(root + "/logs/app.log", &b) catch 0
    if count_lines(rt.buf_ptr(&b), n) != 3 { return 2 }
    if contains(rt.buf_ptr(&b), n, "below the level") { return 3 }
    if !contains(rt.buf_ptr(&b), n, " INFO  update: checking the store\n") { return 4 }
    if !contains(rt.buf_ptr(&b), n, " WARN  update: slow answer second line\n") { return 5 }
    if !contains(rt.buf_ptr(&b), n, " ERROR net: failed\n") { return 6 }
    // the time stamp: 2026-..-..T..:..:..sss Z
    if rt.ld8(rt.buf_ptr(&b), 4) != 45 as u8 || rt.ld8(rt.buf_ptr(&b), 10) != 84 as u8 ||
    rt.ld8(rt.buf_ptr(&b), 23) != 90 as u8 { return 7 }
    // rotation: 4096 bytes max, keep 2
    var i: usize = 0
    while i < 200 {
        log.log_info("fill", "0123456789012345678901234567890123456789")
        i = i + 1
    }
    if !fs.exists(root + "/logs/app.log") { return 10 }
    if !fs.exists(root + "/logs/app.log.1") { return 11 }
    if !fs.exists(root + "/logs/app.log.2") { return 12 }
    if fs.exists(root + "/logs/app.log.3") { return 13 }
    let info: fs.FileInfo = fs.stat(root + "/logs/app.log") catch | e | fs.FileInfo { kind: 0 as u8, mode: 0 as u32, size: 0 as u64, mtime_ns: 0 }
    if info.size > 4096 as u64 || info.size == 0 as u64 { return 14 }
    // the tail: the last 200 octets, starting at a line
    var t: rt.Buf = rt.buf_new()
    if !log.log_tail(200, &t) { return 15 }
    if rt.buf_len(&t) > 200 || rt.buf_len(&t) == 0 { return 16 }
    if rt.ld8(rt.buf_ptr(&t), 0) != 50 as u8 { return 17 }
    // level change
    log.log_set_level(log.LOG_ERROR)
    let before: u64 = info.size
    log.log_warn("x", "dropped")
    let info2: fs.FileInfo = fs.stat(root + "/logs/app.log") catch | e | fs.FileInfo { kind: 0 as u8, mode: 0 as u32, size: 0 as u64, mtime_ns: 0 }
    if info2.size != before { return 18 }
    log.log_close()
    log.log_error("x", "closed: no-op")
    fs.remove_tree(root) catch false
    return 0
}
