// expect_exit: 0
// tests/2957_unroll_side_exit_reach.fi -- r531: a loop with `&&` is unrolled with side exits; a later loop that
// reads the counter got an undefined value on its back edge (dev-fast: results changed from run to run).
import std.io

const MAXLEV: i32 = 5

fn use_it(k: i32) -> i32 {
    return k * 3
}

fn work(w: i32, h: i32) -> i32 {
    var levels: i32 = 1
    var m: i32 = w
    if h < m { m = h }
    while levels < MAXLEV && m >= 32 {
        m = (m + 1) / 2
        levels = levels + 1
    }
    var acc: i32 = use_it(levels)
    var i: i32 = 0
    while i < 3 {
        acc = acc + use_it(levels + i)
        i = i + 1
    }
    var lv: i32 = levels - 1
    var s: i32 = 0
    while lv >= 0 {
        var has_prev: bool = false
        if lv < levels - 1 { has_prev = true }
        if has_prev { s = s + 100 }
        s = s + lv
        lv = lv - 1
    }
    return acc * 1000 + s
}

fn poison(v: i32) -> i32 {
    var a: [i32; 64] = [v; 64]
    var t: i32 = 0
    var i: usize = 0
    while i < 64 {
        t = t + a[i]
        i = i + 1
    }
    return t
}

fn main() -> i32 {
    var k: i32 = 0
    while k < 6 {
        let p: i32 = poison(k * 7 - 3)
        if p == 12345 { return 9 }
        if work(640, 480) != 69410 { return 1 }
        if work(100, 90) != 45203 { return 2 }
        if work(20, 500) != 21000 { return 3 }
        k = k + 1
    }
    io.print_line("ok")
    return 0
}
