// expect_exit: 73
// RUNDE 47 — WIEDERBELEBUNG (resurrection) IST UNMOEGLICH, UND ZWAR ERZWUNGEN.
//
// Java laesst einen Finalisierer sein Objekt zurueck in den lebenden Graphen
// haengen; der Sammler braucht dafuer einen zweiten Zyklus, und die Semantik
// ist beruechtigt schwer. Firn entscheidet anders und sagt es klar:
//
//   * vor dem Aufruf sind alle Gc-/GcWeak-Felder des Objekts genullt,
//   * `stark(w)` auf ein wartendes Objekt liefert 0,
//   * der Block wird freigegeben, sobald der Finalisierer zurueckkehrt,
//   * und der VERSUCH, waehrenddessen einen Gc-Zeiger in ein Heapfeld zu
//     schreiben, bricht das Programm sichtbar mit 73 ab.
//
// Der letzte Punkt ist das, was dieser Test ausloest: die Einfuegebarriere
// (die bei JEDEM Schreiben eines Gc-Zeigers in den Heap ohnehin laeuft)
// erkennt die Sperre. Der Test kostet den Normalfall nichts, weil die
// Pruefung innerhalb des Zweiges "es laeuft gerade ein Zyklus" sitzt.
//
// Kanal 2 wird vorher geschlossen (siehe 823); geprueft wird der
// Ruecksprungwert.

const T_SYS_CLOSE: i64 = 3

gc class Chain {
    next: Gc[Chain],
    value: u64,
}

fn __gc_finalize(kind: u64, p: *mut u8) {
    if kind != 8 {
        return
    }
    let k: Gc[Chain] = p as Gc[Chain]
    if k == gc_null[Chain]() {
        return
    }
    // Das Feld MUSS genullt sein — der Finalisierer sieht nie einen Nachbarn.
    if k.next != gc_null[Chain]() {
        return
    }
    // VERBOTEN: sich selbst wieder einhaengen. Hier bricht es mit 73 ab.
    k.next = k
}

fn dies(depth: u64) -> AllocError!bool {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    if depth > 0 {
        return try dies(depth - 1)
    }
    let a: Gc[Chain] = try gc Chain{ next: gc_null[Chain](), value: 1 }
    let b: Gc[Chain] = try gc Chain{ next: a, value: 2 }
    a.next = b
    return gc_finalizer_set(a as *mut u8, 8)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}

fn run() -> AllocError!i32 {
    if !(try dies(2)) {
        return 92
    }
    syscall(T_SYS_CLOSE, 2, 0, 0, 0, 0, 0)
    gc_collect()
    return 93
}
