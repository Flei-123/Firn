// expect_exit: 73
// ROUND 47 -- RESURRECTION IS IMPOSSIBLE, AND ENFORCED AT THAT.
//
// Java lets a finalizer hang its object back into the live graph; the
// collector needs a second cycle for that, and the semantics is notoriously
// hard. Firn decides differently and says so clearly:
//
//   * before the call all Gc/GcWeak fields of the object are cleared,
//   * `strong(w)` on a waiting object yields 0,
//   * the block is released as soon as the finalizer returns,
//   * and the ATTEMPT to write a Gc pointer into a heap field while that
//     happens aborts the program visibly with 73.
//
// The last point is what this test triggers: the write barrier (which runs
// on EVERY write of a Gc pointer into the heap anyway) recognises the lock.
// The test costs the normal case nothing, because the check sits inside the
// branch "a cycle is running right now".
//
// Channel 2 is closed beforehand (see 823); what is checked is the
// return value.

const T_SYS_CLOSE: i64 = 3

gc class Chain {
    next: Gc[Chain],
    value: u64,
}

fn __gc_finalize(kind: u64, p: *mut u8) {
    if kind != 8 {
        return
    }
    let k: Gc[Chain] = p as Gc[Chain]
    if k == gc_null[Chain]() {
        return
    }
    // The field MUST be cleared -- the finalizer never sees a neighbour.
    if k.next != gc_null[Chain]() {
        return
    }
    // FORBIDDEN: hanging itself back in. Here it aborts with 73.
    k.next = k
}

fn dies(depth: u64) -> AllocError!bool {
    var fill: [u64; 128] = [0; 128]
    let fp: u64 = (&fill) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    if depth > 0 {
        return try dies(depth - 1)
    }
    let a: Gc[Chain] = try gc Chain { next: gc_null[Chain](), value: 1 }
    let b: Gc[Chain] = try gc Chain { next: a, value: 2 }
    a.next = b
    return gc_finalizer_set(a as *mut u8, 8)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}

fn run() -> AllocError!i32 {
    if !(try dies(2)) {
        return 92
    }
    syscall(T_SYS_CLOSE, 2, 0, 0, 0, 0, 0)
    gc_collect()
    return 93
}
