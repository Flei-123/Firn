// expect_exit: 42
import av1.still
import std.fs
import std.rt
import std.deflate

static mut seed: u64 = 987654321

fn rnd() -> u32 {
    seed = (seed * 1103515245 + 12345) & 2147483647
    return ((seed >> 8) & 16777215) as u32
}

fn load(name: str, data: *mut rt.Buf) -> usize {
    let n: usize = fs.read_file(name, data) catch 0
    return n
}

fn crc_of(name: str, want_crc: u32, want_size: usize) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    var f: still.Frame = still.frame_new()
    let rc: i32 = still.still_decode(rt.buf_ptr(&data), n, &f)
    if rc != still.STILL_OK {
        return false
    }
    var all: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&all, f.y, f.y_bytes)
    rt.buf_push_bytes(&all, f.u, f.u_bytes)
    rt.buf_push_bytes(&all, f.v, f.v_bytes)
    let c: u32 = deflate.crc32(rt.buf_ptr(&all), rt.buf_len(&all))
    let sz: usize = rt.buf_len(&all)
    rt.buf_free(&all)
    still.frame_free(&f)
    rt.buf_free(&data)
    return c == want_crc && sz == want_size
}

fn refuses(name: str, want_rc: i32) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    var f: still.Frame = still.frame_new()
    let rc: i32 = still.still_decode(rt.buf_ptr(&data), n, &f)
    rt.buf_free(&data)
    if rc == still.STILL_OK {
        still.frame_free(&f)
        return false
    }
    return rc == want_rc
}

fn survives_cuts(name: str, step: usize) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    var c: usize = 0
    while c < n {
        var f: still.Frame = still.frame_new()
        let rc: i32 = still.still_decode_limited(rt.buf_ptr(&data), c, 4000000, &f)
        if rc == still.STILL_OK {
            still.frame_free(&f)
        }
        c = c + step
    }
    rt.buf_free(&data)
    return true
}

fn survives_flips(name: str, copies: u32) -> bool {
    var data: rt.Buf = rt.buf_new()
    let n: usize = load(name, &data)
    if n == 0 {
        return false
    }
    var work: rt.Buf = rt.buf_new()
    var k: u32 = 0
    while k < copies {
        rt.buf_clear(&work)
        rt.buf_push_bytes(&work, rt.buf_ptr(&data), n)
        let hits: u32 = 1 + rnd() % 3
        var j: u32 = 0
        while j < hits {
            let at: usize = (rnd() as usize) % n
            rt.st8(rt.buf_ptr(&work), at, (rnd() % 256) as u8)
            j = j + 1
        }
        var f: still.Frame = still.frame_new()
        let rc: i32 = still.still_decode_limited(rt.buf_ptr(&work), n, 4000000, &f)
        if rc == still.STILL_OK {
            still.frame_free(&f)
        }
        k = k + 1
    }
    rt.buf_free(&work)
    rt.buf_free(&data)
    return true
}

fn main() -> i32 {
    if !crc_of("tests/data/av1/lsr_d10.avif", 0x2292b7d7 as u32, 60000) { return 1 }
    if !crc_of("tests/data/av1/lsr_d10_10b.avif", 0x637ce63e as u32, 120000) { return 2 }
    if !crc_of("tests/data/av1/lsr_d10_400.avif", 0xc387b92a as u32, 60000) { return 3 }
    if !crc_of("tests/data/av1/lsr_d11.avif", 0xd8d441b5 as u32, 60000) { return 4 }
    if !crc_of("tests/data/av1/lsr_d11_422.avif", 0x49b72199 as u32, 80000) { return 5 }
    if !crc_of("tests/data/av1/lsr_d12.avif", 0x37a98a8e as u32, 60000) { return 6 }
    if !crc_of("tests/data/av1/lsr_d12_big.avif", 0x51173a29 as u32, 345600) { return 7 }
    if !crc_of("tests/data/av1/lsr_d12_nocdef.avif", 0x9f356be3 as u32, 60000) { return 8 }
    if !crc_of("tests/data/av1/lsr_d12_nolr.avif", 0x6ea8d47f as u32, 60000) { return 9 }
    if !crc_of("tests/data/av1/lsr_d13.avif", 0x99232731 as u32, 60000) { return 10 }
    if !crc_of("tests/data/av1/lsr_d13_odd.avif", 0x1f97c04b as u32, 15235) { return 11 }
    if !crc_of("tests/data/av1/lsr_d14.avif", 0xe8be410d as u32, 60000) { return 12 }
    if !crc_of("tests/data/av1/lsr_d14_12b.avif", 0xd8bafa96 as u32, 120000) { return 13 }
    if !crc_of("tests/data/av1/lsr_d15.avif", 0x7281f5e2 as u32, 60000) { return 14 }
    if !crc_of("tests/data/av1/lsr_d16.avif", 0xe64c236c as u32, 60000) { return 15 }
    if !crc_of("tests/data/av1/lsr_d16_444.avif", 0xebd211a8 as u32, 120000) { return 16 }
    if !crc_of("tests/data/av1/lsr_d9.avif", 0x26690009 as u32, 60000) { return 17 }
    if !crc_of("tests/data/av1/lsr_d9_444_10b.avif", 0xd819a381 as u32, 240000) { return 18 }
    if !crc_of("tests/data/av1/lsr_d9_small.avif", 0x548631c1 as u32, 14688) { return 19 }
    return 42
}
