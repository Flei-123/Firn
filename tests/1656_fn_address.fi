// expect_exit: 42
// Round GAPS: a function value as a number and back (`f as u64`,
// `n as fn(..)`), the null function (`0 as fn(..)`), and the machine code
// address (`__code_of`).
fn add1(x: i32) -> i32 { return x + 1 as i32 }
fn twice(x: i32) -> i32 { return x * 2 as i32 }

struct Ops {
    run: fn(i32) -> i32,
}

fn apply_or(o: Ops, x: i32, fallback: i32) -> i32 {
    if (o.run as u64) == 0 as u64 {
        return fallback
    }
    return o.run(x)
}

fn main() -> i32 {
    var f: fn(i32) -> i32 = add1
    let r: u64 = f as u64
    if r == 0 as u64 { return 1 as i32 }
    // the way back is the same function
    let g: fn(i32) -> i32 = r as fn(i32) -> i32
    if g(41) != 42 { return 2 as i32 }
    // usize works the same
    let ru: usize = f as usize
    let h: fn(i32) -> i32 = ru as fn(i32) -> i32
    if h(1) != 2 { return 3 as i32 }
    // null function in a table
    let none: Ops = Ops { run: 0 as fn(i32) -> i32 }
    let some: Ops = Ops { run: twice }
    if apply_or(none, 5, 7) != 7 { return 4 as i32 }
    if apply_or(some, 5, 7) != 10 { return 5 as i32 }
    // the code address: word 0 of the record -- the same through every
    // copy of the value, different from the record address, different
    // per function
    let c1: u64 = __code_of(f)
    if c1 == 0 as u64 { return 6 as i32 }
    if c1 == r { return 7 as i32 }
    if __code_of(g) != c1 || __code_of(h) != c1 { return 8 as i32 }
    if c1 != *(r as *u64) { return 10 as i32 }
    f = twice
    if __code_of(f) == c1 { return 9 as i32 }
    return 42 as i32
}
