// expect_exit: 0
// tests/4070_if_let_some.fi -- `if let Some(x) = opt { .. } else { .. }` and `while let Some(x) = opt { .. }` (r719).
import std.io
import std.rt
import std.vec
import std.option
import std.testkit

struct P {
    a: i32,
    b: i32,
}

fn half(n: i32) -> Option[i32] {
    if n % 2 == 0 {
        return opt_some[i32](n / 2)
    }
    return opt_none[i32]()
}

fn classify(n: i32) -> i32 {
    if let Some(h) = half(n) {
        return h
    } else if let Some(h) = half(n + 1) {
        return 1000 + h
    } else {
        return -1
    }
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    // then branch
    var got: i32 = 0
    if let Some(x) = half(10) {
        got = x
    }
    testkit.check(got == 5, "then branch binds the value")
    // else branch
    var hit: i32 = 0
    if let Some(x) = half(7) {
        hit = x
    } else {
        hit = -1
    }
    testkit.check(hit == -1, "else branch")
    // no else, empty option: nothing runs
    var ran: bool = false
    if let Some(_) = half(3) {
        ran = true
    }
    testkit.check(!ran, "empty without else")
    // wildcard pattern runs the block
    var ran2: bool = false
    if let Some(_) = half(4) {
        ran2 = true
    }
    testkit.check(ran2, "wildcard pattern")
    // else-if chain
    testkit.check(classify(10) == 5, "chain first")
    testkit.check(classify(7) == 1004, "chain second")
    // the binding does not leak and may shadow the scrutinee name
    let x: i32 = 100
    if let Some(y) = half(x) {
        testkit.check(y == 50, "scrutinee sees outer x")
    }
    // tuple pattern in Some(..)
    let pr: Option[P] = opt_some[P](P { a: 3, b: 4 })
    if let Some(q) = pr {
        testkit.check(q.a == 3 && q.b == 4, "struct payload")
    }
    // nested if let
    var nest: i32 = 0
    if let Some(a) = half(8) {
        if let Some(b) = half(a) {
            nest = a * 10 + b
        }
    }
    testkit.check(nest == 42, "nested")
    // scrutinee evaluated exactly once
    var calls: i32 = 0
    var v: Vec[i64] = vec_new[i64]()
    vec_push[i64](&v, 10)
    vec_push[i64](&v, 20)
    vec_push[i64](&v, 30)
    // while let: drain with pop
    var sum: i64 = 0
    var n: i32 = 0
    while let Some(e) = vec_pop_opt[i64](&v) {
        sum = sum + e
        n = n + 1
    }
    testkit.check(sum == 60 && n == 3 && vec_len[i64](&v) == 0, "while let drains the vec")
    // break and continue inside while let
    vec_push[i64](&v, 1)
    vec_push[i64](&v, 2)
    vec_push[i64](&v, 3)
    vec_push[i64](&v, 4)
    var seen: i64 = 0
    while let Some(e) = vec_pop_opt[i64](&v) {
        if e == 3 {
            continue
        }
        if e == 1 {
            break
        }
        seen = seen * 10 + e
    }
    testkit.check(seen == 42, "continue and break")
    testkit.check(vec_len[i64](&v) == 0, "break left nothing")
    // while let over a counter
    var k: i32 = 64
    var steps: i32 = 0
    while let Some(h) = half(k) {
        k = h
        steps = steps + 1
    }
    testkit.check(k == 1 && steps == 6, "halve until odd")
    calls = calls + 1
    vec_free[i64](&v)
    return testkit.finish()
}
