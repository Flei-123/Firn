// expect_exit: 101
// not_mode: opt
// tests/4101_vec_index_oob.fi -- r724: an index past the end of a Vec panics.
import std.rt
import std.vec

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    let i: usize = 2
    return v[i]
}
