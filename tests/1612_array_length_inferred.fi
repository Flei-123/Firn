// expect_exit: 0
// tests/1612_array_length_inferred.fi -- ROUND 79: `[T; _]`.
//
// Gap 10 of docs/ROUND66.md. Round 66 wrote about two hundred message texts
// as `var m: [u8; 40] = "..."` and counted every one of them by hand. An
// off-by-one there is not a compile error but a text quietly padded with
// blanks, plus a SECOND, independent length passed on beside it -- a class
// of bug a reader cannot see. The length now comes out of the literal.
//
// Only the outermost length and only from a LITERAL; everything else stays
// an error (tests/neg/1612, tests/neg/1613).
fn last(p: *mut u8, n: usize) -> u8 {
    return *(((p as usize) + n - 1) as *mut u8)
}

fn main() -> i32 {
    // A text literal: its length is the number of octets, a written null
    // octet included.
    var greeting: [u8; _] = "hello"
    if greeting[0] != 104 as u8 { return 1 }
    if greeting[4] != 111 as u8 { return 2 }

    var terminated: [u8; _] = "abc\0"
    if terminated[3] != 0 as u8 { return 3 }

    // An array literal.
    var numbers: [i64; _] = [10, 20, 30]
    if numbers[2] != 30 { return 4 }

    // A repeat literal.
    var zeros: [u8; _] = [7 as u8; 5]
    if zeros[4] != 7 as u8 { return 5 }

    // The lengths really are the ones the literals have: the sum over the
    // whole array has to come out, and it can only do that if the array is
    // exactly as long as it should be.
    var sum: i64 = 0
    var i: usize = 0
    while i < 3 {
        sum = sum + numbers[i]
        i = i + 1
    }
    if sum != 60 { return 6 }

    // Written out and inferred describe the SAME type: the inferred one is
    // handed to a function that takes the address of the FIFTH octet, which
    // only exists if the array really is five long.
    var written: [u8; 5] = "hello"
    var inferred: [u8; _] = "hello"
    if written[4] != inferred[4] { return 7 }
    if last(&inferred[0], 5) != 111 as u8 { return 8 }

    return 0
}
