// expect_exit: 0
// tests/2051_appkit_version.fi -- lib/appkit/version.fi: parse, order, print.
//
//   A  the semver 2.0.0 section 11 example chain is strictly ascending, in
//      BOTH directions of the comparison (a < b and b > a)
//   B  numbers compare as numbers (0.5.10 > 0.5.9), "1.2" == "1.2.0", four
//      places, a leading v, build metadata is ignored
//   C  what is not a version is refused
//   D  printing: a missing place prints as 0, the pre-release stays
import std.rt
import appkit.version

fn lt(a: str, b: str) -> bool {
    var ok: bool = false
    let c1: i32 = version.version_cmp_text(a, b, &ok)
    if !ok || c1 != -1 { return false }
    let c2: i32 = version.version_cmp_text(b, a, &ok)
    return ok && c2 == 1
}

fn eq(a: str, b: str) -> bool {
    var ok: bool = false
    let c1: i32 = version.version_cmp_text(a, b, &ok)
    return ok && c1 == 0
}

fn bad(s: str) -> bool {
    var v: version.Version = version.version_new()
    return !version.version_parse(s.p as u64, s.n, &v)
}

fn shows(s: str, want: str) -> bool {
    var v: version.Version = version.version_new()
    if !version.version_parse(s.p as u64, s.n, &v) { return false }
    var b: rt.Buf = rt.buf_new()
    version.version_write(&v, &b)
    let same: bool = rt.buf_len(&b) == want.n &&
        rt.mem_eq(rt.buf_ptr(&b), want.p as u64, want.n)
    rt.buf_free(&b)
    return same
}

fn main() -> i32 {
    // A
    if !lt("1.0.0-alpha", "1.0.0-alpha.1") { return 1 }
    if !lt("1.0.0-alpha.1", "1.0.0-alpha.beta") { return 2 }
    if !lt("1.0.0-alpha.beta", "1.0.0-beta") { return 3 }
    if !lt("1.0.0-beta", "1.0.0-beta.2") { return 4 }
    if !lt("1.0.0-beta.2", "1.0.0-beta.11") { return 5 }
    if !lt("1.0.0-beta.11", "1.0.0-rc.1") { return 6 }
    if !lt("1.0.0-rc.1", "1.0.0") { return 7 }
    // B
    if !lt("0.5.9", "0.5.10") { return 10 }
    if !lt("0.5.5", "0.6.0") { return 11 }
    if !lt("0.9.9", "1.0.0") { return 12 }
    if !lt("1.2", "1.2.1") { return 13 }
    if !eq("1.2", "1.2.0") { return 14 }
    if !eq("1.2.0.0", "1.2") { return 15 }
    if !lt("1.2.0.1", "1.2.1") { return 16 }
    if !lt("1.2.3.4", "1.2.3.5") { return 17 }
    if !eq("v2.0.0", "2.0.0") { return 18 }
    if !eq("1.0.0+abc", "1.0.0+xyz") { return 19 }
    if !eq("1.0.0-rc.1+abc", "1.0.0-rc.1") { return 20 }
    if !lt("2.0.0", "10.0.0") { return 21 }
    if !lt("1.2", "2.0.0") { return 22 }
    if !lt("0.58", "0.59") { return 23 }
    if !lt("0.9", "0.10") { return 24 }
    if !lt("1.0.0-9", "1.0.0-10") { return 25 }
    if !lt("1.0.0-9", "1.0.0-a") { return 26 }
    // C
    if !bad("") { return 30 }
    if !bad("x") { return 31 }
    if !bad("1..2") { return 32 }
    if !bad("1.2.3.4.5") { return 33 }
    if !bad("1.2.") { return 34 }
    if !bad(".1") { return 35 }
    if !bad("1.2-") { return 36 }
    if !bad("1.2+") { return 37 }
    if !bad("1.2 ") { return 38 }
    if !bad("1.-2") { return 39 }
    if !bad("99999999999999999999") { return 40 }
    var ok: bool = true
    let c: i32 = version.version_cmp_text("1.0.0", "garbage", &ok)
    if ok || c != 0 { return 41 }
    // D
    if !shows("1.2", "1.2.0") { return 50 }
    if !shows("v0.5.5", "0.5.5") { return 51 }
    if !shows("0.6.0-beta.2+meta", "0.6.0-beta.2") { return 52 }
    if !shows("1.2.3.4", "1.2.3.4") { return 53 }
    return 0
}
