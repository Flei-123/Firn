// expect_exit: 0
// tests/1247_f64_negation.fi -- ROUND 68: `-x` works on `f64`.
//
// docs/ROUND63.md, gap 1: "there is no unary minus for `f64`. `-x` on a
// floating point value is a type error ... SPEC 14.1.f64 names 'the sign
// -x' as implemented; it is not."
//
// The code generator could do it all along: it flips BIT 63 instead of
// running `neg`. That difference is the whole point of the exercise --
// `-0.0` has to come out as -0.0, and `0.0 - x` does NOT give that
// (`0.0 - 0.0` is `+0.0`). Only the type checker was missing.
import std.math

fn twice(x: f64) -> f64 { return x + x }

fn main() -> i32 {
    // 1. on a variable
    let a: f64 = 3.5
    let b: f64 = -a
    if b != 0.0 - 3.5 { return 1 }

    // 2. on a literal
    let c: f64 = -3.5
    if c != b { return 2 }

    // 3. THE REASON FOR THE BIT: -0.0 is not +0.0
    let z: f64 = 0.0
    if math.math_bits(-z) != 9223372036854775808 { return 3 }
    if math.math_bits(0.0 - z) != 0 { return 4 }
    if math.math_bits(-0.0) != 9223372036854775808 { return 5 }

    // 4. twice negated is the identity, bit for bit
    if math.math_bits(-(-a)) != math.math_bits(a) { return 6 }
    if math.math_bits(-(-z)) != math.math_bits(z) { return 7 }

    // 5. in an expression, as an argument, as a return value
    if -a + 4.0 != 0.5 { return 8 }
    if twice(-a) != 0.0 - 7.0 { return 9 }
    if -twice(a) != 0.0 - 7.0 { return 10 }

    // 6. the integer case is unchanged
    let i: i32 = 7
    if -i != -7 { return 11 }
    return 0
}
