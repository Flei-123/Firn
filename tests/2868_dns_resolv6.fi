// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
// tests/2868_dns_resolv6.fi -- resolv.conf with IPv6 name servers
// (dns_parse_resolv_conf_all): order kept, duplicates dropped, zone ids and
// garbage skipped, at most four. The old v4-only parser is unchanged.
import std.rt
import net.dns

static mut fails: u32 = 0

fn check(ok: bool, code: u32) {
    if !ok {
        fails = fails + 1
        var d: [u8; 8] = "FAIL 000"
        d[5] = (48 + (code / 100) % 10) as u8
        d[6] = (48 + (code / 10) % 10) as u8
        d[7] = (48 + code % 10) as u8
        syscall(1, 2, (&d[0]) as i64, 8, 0, 0, 0)
    }
}

fn parse(text: str, v4: *mut [u32; 4], v6: *mut [u8; 64], fam: *mut [u8; 4]) -> usize {
    var i: usize = 0
    while i < 4 {
        (*v4)[i] = 0 as u32
        (*fam)[i] = 0 as u8
        i = i + 1
    }
    return dns.dns_parse_resolv_conf_all(text.p as u64, text.n, v4, v6, fam)
}

fn main() -> i32 {
    var v4: [u32; 4] = [0; 4]
    var v6: [u8; 64] = [0; 64]
    var fam: [u8; 4] = [0; 4]

    // mixed, in file order; "::1" is 15 zero octets and a one
    var n: usize = parse("# c\nnameserver 192.0.2.1\nnameserver ::1\nnameserver 2001:db8::53\nsearch x\n", &v4, &v6, &fam)
    check(n == 3, 1)
    check(fam[0] == 4 as u8 && v4[0] == 3221225985 as u32, 2)
    check(fam[1] == 6 as u8 && v6[16 + 15] == 1 as u8 && v6[16] == 0 as u8, 3)
    check(fam[2] == 6 as u8 && v6[32] == 32 as u8 && v6[33] == 1 as u8 && v6[34] == 13 as u8
        && v6[35] == 184 as u8 && v6[47] == 83 as u8, 4)

    // duplicates dropped (both families), a zone id and garbage skipped
    n = parse("nameserver ::1\nnameserver ::1\nnameserver 192.0.2.1\nnameserver 192.0.2.1\nnameserver fe80::1%eth0\nnameserver nonsense\nnameserver\n", &v4, &v6, &fam)
    check(n == 2, 5)
    check(fam[0] == 6 as u8 && fam[1] == 4 as u8, 6)

    // at most four
    n = parse("nameserver ::1\nnameserver ::2\nnameserver ::3\nnameserver ::4\nnameserver ::5\n", &v4, &v6, &fam)
    check(n == 4 && v6[3 * 16 + 15] == 4 as u8, 7)

    // empty / comments only
    n = parse("# nothing\n; here\n", &v4, &v6, &fam)
    check(n == 0, 8)

    // the old parser still sees only IPv4
    var old: [u32; 4] = [0; 4]
    let txt: str = "nameserver ::1\nnameserver 192.0.2.1\n"
    let k: usize = dns.dns_parse_resolv_conf(txt.p as u64, txt.n, &old)
    check(k == 1 && old[0] == 3221225985 as u32, 9)

    if fails != 0 {
        return 1
    }
    return 0
}
