// expect_exit: 3
// Round 52: two LITERALLY equal asm blocks must not be folded into one
// zusammengelegt werden (kein CSE ueber volatile). Jeder erhoeht den Zaehler
// einmal — kommt 2 statt 3 heraus, hat ein Durchgang zugeschlagen.
fn main() -> i32 {
    var z: u64 = 1
    let p: u64 = (&z) as u64
    asm("inc qword ptr [rcx]", in("rcx") p, clobber("memory"))
    asm("inc qword ptr [rcx]", in("rcx") p, clobber("memory"))
    return z as i32
}
