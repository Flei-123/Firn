// expect_exit: 3
// Round 52: two LITERALLY equal asm blocks must not be folded into one
// folded into one (no CSE over volatile). Each one increments the counter
// once -- if 2 comes out instead of 3, a pass has struck.
//
// ROUND ARM-FREESTANDING: one variant per machine (`#[arch(...)]`). A64 has
// no read-modify-write instruction on memory, so the increment is three
// instructions -- which makes the case sharper rather than weaker: three
// instructions are three more opportunities for a pass to merge two blocks
// that must not be merged.
#[arch(x86_64)]
fn main() -> i32 {
    var z: u64 = 1
    let p: u64 = (&z) as u64
    asm("inc qword ptr [rcx]", in("rcx") p, clobber("memory"))
    asm("inc qword ptr [rcx]", in("rcx") p, clobber("memory"))
    return z as i32
}

#[arch(aarch64)]
fn main() -> i32 {
    var z: u64 = 1
    let p: u64 = (&z) as u64
    asm("ldr x10, [x9]\nadd x10, x10, #1\nstr x10, [x9]", in("x9") p, clobber("x10"), clobber("memory"))
    asm("ldr x10, [x9]\nadd x10, x10, #1\nstr x10, [x9]", in("x9") p, clobber("x10"), clobber("memory"))
    return z as i32
}
