// expect_exit: 0
// Error union as a struct field -- it is an ordinary aggregate.
error E { A, B }

struct Holder { r: E!i32, n: i32 }

fn main() -> i32 {
    var h: Holder = Holder { r: E::B, n: 1 }
    if (h.r catch 0 - 1) != 0 - 1 {
        return 1
    }
    h.r = 5
    if (h.r catch 0 - 1) != 5 {
        return 2
    }
    if h.n != 1 {
        return 3
    }
    return 0
}
