// expect_exit: 0
// `comptime` (SPEC §6.4, FIRN-ANFORDERUNGEN §6): eigene Funktionen laufen zur
// UEBERSETZUNGSZEIT — mit Schleifen, Verzweigungen und Rekursion. Erster
// Schritt zu Abnahmepunkt 6 (erzeugte Unicode-/Web-IDL-Tabellen).

fn factorial(n: i64) -> i64 {
    var r: i64 = 1
    var i: i64 = 2
    while i <= n {
        r = r * i
        i = i + 1
    }
    return r
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// Zaehlt die gesetzten Bits — die Art Kennzahl, die man sonst von Hand
// ausrechnet und als Literal hinschreibt.
fn bits(x: u64) -> i64 {
    var n: i64 = 0
    var v: u64 = x
    while v != 0 {
        n = n + (v & 1) as i64
        v = v >> 1
    }
    return n
}

// `for` und `break` gehen ebenfalls.
fn first_divisible(limit: i64, by: i64) -> i64 {
    for i in 1..limit {
        if i % by == 0 {
            return i
        }
    }
    return 0
}

const FAK10: i64 = factorial(10)
const FIB20: i64 = fib(20)
const BITS: i64 = bits(255)
const TEILER: i64 = first_divisible(100, 17)
const GROESSE: usize = factorial(5) as usize
// Konstanten duerfen aufeinander aufbauen.
const DOPPELT: i64 = FAK10 * 2

fn main() -> i32 {
    if FAK10 != 3628800 {
        return 1
    }
    if FIB20 != 6765 {
        return 2
    }
    if BITS != 8 {
        return 3
    }
    if TEILER != 17 {
        return 4
    }
    if GROESSE != 120 {
        return 5
    }
    if DOPPELT != 7257600 {
        return 6
    }
    // Das Ergebnis taugt als Arraylaenge — es ist eine echte Konstante.
    var field: [u8; 120] = [0 as u8; 120]
    field[GROESSE - 1] = 7 as u8
    if field[119] != 7 as u8 {
        return 7
    }
    return 0
}
