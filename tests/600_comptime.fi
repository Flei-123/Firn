// expect_exit: 0
// `comptime` (SPEC 6.4, FIRN-ANFORDERUNGEN 6): your own functions run at
// COMPILE TIME -- with loops, branches and recursion. The first step towards
// acceptance item 6 (generated Unicode/Web IDL tables).

fn factorial(n: i64) -> i64 {
    var r: i64 = 1
    var i: i64 = 2
    while i <= n {
        r = r * i
        i = i + 1
    }
    return r
}

fn fib(n: i64) -> i64 {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// Counts the bits that are set -- the kind of number one otherwise computes
// by hand and writes down as a literal.
fn bits(x: u64) -> i64 {
    var n: i64 = 0
    var v: u64 = x
    while v != 0 {
        n = n + (v & 1) as i64
        v = v >> 1
    }
    return n
}

// `for` and `break` work as well.
fn first_divisible(limit: i64, by: i64) -> i64 {
    for i in 1..limit {
        if i % by == 0 {
            return i
        }
    }
    return 0
}

const FACT10: i64 = factorial(10)
const FIB20: i64 = fib(20)
const BITS: i64 = bits(255)
const DIVISOR: i64 = first_divisible(100, 17)
const SIZE: usize = factorial(5) as usize
// Constants may build on each other.
const DUPLICATE: i64 = FACT10 * 2

fn main() -> i32 {
    if FACT10 != 3628800 {
        return 1
    }
    if FIB20 != 6765 {
        return 2
    }
    if BITS != 8 {
        return 3
    }
    if DIVISOR != 17 {
        return 4
    }
    if SIZE != 120 {
        return 5
    }
    if DUPLICATE != 7257600 {
        return 6
    }
    // The result works as an array length -- it is a real constant.
    var field: [u8; 120] = [0 as u8; 120]
    field[SIZE - 1] = 7 as u8
    if field[119] != 7 as u8 {
        return 7
    }
    return 0
}
