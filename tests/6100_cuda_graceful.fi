// expect_exit: 0
// wasm_skip: needs shared libraries from the host
import std.rt
import cuda.driver as cu
import cuda.kernel as kn
import std.io as io

fn main() -> i32 {
    if !cu.init() {
        io.print_line("cuda: no driver, skipped")
        return 0
    }
    cu.info_line()
    let m: u64 = kn.load_source("extern \"C\" __global__ void fill(float* x, int n, float v) { int i = blockIdx.x * blockDim.x + threadIdx.x; if (i < n) x[i] = v * (float)i; }")
    if m == 0 {
        return 1
    }
    let f: u64 = kn.func(m, "fill")
    if f == 0 {
        return 2
    }
    let d: u64 = cu.alloc(4096)
    if d == 0 {
        return 3
    }
    let a: u64 = kn.args_new()
    kn.arg_ptr(a, d)
    kn.arg_i32(a, 1024)
    kn.arg_f32(a, 0.5)
    if !kn.launch(f, 4, 1, 256, 0, a) {
        return 4
    }
    if !cu.sync() {
        return 5
    }
    let h: u64 = rt.heap_alloc(4096)
    if !cu.download(h, d, 4096) {
        return 6
    }
    let bits: u32 = rt.ld32(h, 1000)
    io.print_line("cuda: element 1000 bits ok check")
    if bits != 1140457472 {
        return 100 + (bits >> 24) as i32
    }
    cu.free(d)
    io.print_line("cuda: round trip ok")
    return 0
}
