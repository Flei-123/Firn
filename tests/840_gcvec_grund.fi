// expect_exit: 0
// Runde 53: `GcVec` — die Sammlung mit veraenderlicher Laenge im GC-Heap
// (SPEC §3.5.2). Grundlagen: anhaengen, lesen, setzen, abhaengen,
// entfernen, leeren, wachsen — und die beiden Zusagen, auf die es ankommt:
//
//   1. der Sammler verfolgt die Elemente AUCH nach dem Wachsen (also nach
//      dem Umkopieren in einen neuen Puffer),
//   2. ein Zyklus, der ueber eine `GcVec` laeuft (Knoten -> GcVec -> Knoten),
//      wird eingesammelt. Das ist der DOM-Normalfall.

gc class Knoten {
    kinder: Gc[GcVec],
    eltern: Gc[Knoten],
    marke: u64,
}

fn knoten(marke: u64) -> AllocError!Gc[Knoten] {
    return try gc Knoten{
        kinder: try gcvec_neu(),
        eltern: gc_null[Knoten](),
        marke: marke,
    }
}

// Ein Zyklus: Elter haelt die Kinder ueber eine GcVec, jedes Kind haelt den
// Elter stark zurueck. Ein Zaehlverweis gibt so etwas nie frei.
fn zyklus(n: u64) -> AllocError!u64 {
    let e: Gc[Knoten] = try knoten(1)
    var i: u64 = 0
    while i < n {
        let k: Gc[Knoten] = try knoten(100 + i)
        k.eltern = e
        let ok: bool = try gcvec_anhaengen[Knoten](e.kinder, k)
        i = i + 1
    }
    return gcvec_laenge(e.kinder)
}

// Toten Stapelbereich unter dem eigenen Rahmen nullen. Der Scan ist
// KONSERVATIV: in bereits verlassenen Rahmen stehen noch alte Zeiger, und
// jeder einzelne haelt einen ganzen Teilbaum am Leben (ein Elter zieht seine
// GcVec, deren Puffer und 20 Kinder mit). Ohne Optimierer bleiben davon
// deutlich mehr stehen als mit — deshalb gehoert das Nullen in den Test und
// nicht in die Toleranz (dieselbe Bauart wie __gc_scrub_tief).
fn scrub(n: u64) {
    var puffer: [u64; 256] = [0; 256]
    let p: u64 = (&puffer) as u64
    var i: u64 = 0
    while i < 256 {
        *((p + i * 8) as *mut u64) = 0
        i = i + 1
    }
    if n > 0 {
        scrub(n - 1)
    }
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }

    // --- 1. roher Vektor: Zahlen, vom Sammler NICHT verfolgt -------------
    let r: Gc[GcVec] = gcvec_neu_roh() catch gc_null[GcVec]()
    if (r as u64) == 0 {
        return 91
    }
    if gcvec_laenge(r) != 0 {
        return 1
    }
    if gcvec_kapazitaet(r) != 0 {
        return 2
    }
    var i: u64 = 0
    while i < 1000 {
        let ok: bool = gcvec_anhaengen_roh(r, i * 3 + 1) catch false
        if !ok {
            return 3
        }
        i = i + 1
    }
    if gcvec_laenge(r) != 1000 {
        return 4
    }
    // Verdoppelnd, also nie mehr als das Doppelte der Laenge.
    if gcvec_kapazitaet(r) < 1000 || gcvec_kapazitaet(r) > 2048 {
        return 5
    }
    i = 0
    while i < 1000 {
        if gcvec_lesen_roh(r, i) != i * 3 + 1 {
            return 6
        }
        i = i + 1
    }
    // Ausserhalb: 0, kein Absturz.
    if gcvec_lesen_roh(r, 1000) != 0 {
        return 7
    }
    if gcvec_setzen_roh(r, 1000, 5) {
        return 8
    }
    if !gcvec_setzen_roh(r, 7, 4242) {
        return 9
    }
    if gcvec_lesen_roh(r, 7) != 4242 {
        return 10
    }
    // abhaengen
    if gcvec_abhaengen_roh(r) != 999 * 3 + 1 {
        return 11
    }
    if gcvec_laenge(r) != 999 {
        return 12
    }
    // entfernen erhaelt die Reihenfolge
    if !gcvec_entfernen(r, 0) {
        return 13
    }
    if gcvec_laenge(r) != 998 {
        return 14
    }
    if gcvec_lesen_roh(r, 0) != 4 {
        return 15
    }
    if gcvec_lesen_roh(r, 6) != 4242 {
        return 16
    }
    // finden
    if gcvec_finden_roh(r, 4242) != 6 {
        return 17
    }
    if gcvec_finden_roh(r, 999999) != 998 {
        return 18
    }
    gcvec_leeren(r)
    if gcvec_laenge(r) != 0 {
        return 19
    }
    // Nach dem Leeren bleibt der Puffer, es wird also nicht neu alloziert.
    if gcvec_kapazitaet(r) < 998 {
        return 20
    }

    // --- 2. Zeigervektor: Elemente ueberleben das Wachsen ----------------
    let v: Gc[GcVec] = gcvec_neu() catch gc_null[GcVec]()
    if (v as u64) == 0 {
        return 92
    }
    var j: u64 = 0
    while j < 5000 {
        let k: Gc[Knoten] = knoten(j + 1) catch gc_null[Knoten]()
        if (k as u64) == 0 {
            return 21
        }
        let ok: bool = gcvec_anhaengen[Knoten](v, k) catch false
        if !ok {
            return 22
        }
        j = j + 1
    }
    // Ein voller Sammellauf: jedes Element muss ihn ueberstehen, obwohl der
    // Puffer inzwischen mehrfach umkopiert wurde.
    gc_collect()
    gc_collect()
    j = 0
    while j < 5000 {
        let k: Gc[Knoten] = gcvec_lesen[Knoten](v, j)
        if (k as u64) == 0 {
            return 23
        }
        if k.marke != j + 1 {
            return 24
        }
        j = j + 1
    }
    // setzen mit Barriere, dann wieder lesen
    let ersatz: Gc[Knoten] = knoten(777777) catch gc_null[Knoten]()
    if !gcvec_setzen[Knoten](v, 100, ersatz) {
        return 25
    }
    gc_collect()
    if gcvec_lesen[Knoten](v, 100).marke != 777777 {
        return 26
    }
    if gcvec_finden[Knoten](v, ersatz) != 100 {
        return 27
    }

    // --- 3. Zyklus ueber eine GcVec wird eingesammelt --------------------
    gc_collect()
    let vor: u64 = gc_live_objects()
    // 200 Saetze zu je 1 Elter + 1 GcVec + 1 Puffer + 20 Kinder mit je
    // eigener (leerer) GcVec.
    var s: u64 = 0
    while s < 200 {
        let n: u64 = zyklus(20) catch 0
        if n != 20 {
            return 28
        }
        s = s + 1
    }
    scrub(8)
    gc_collect()
    gc_collect()
    // 200 Saetze zu je 43 Objekten = 8600. Bleibt davon mehr als ein
    // Bruchteil uebrig, leckt die Sammlung. Die Schranke ist grosszuegig,
    // weil ein einziger Zufallstreffer des konservativen Scans 43 Objekte
    // festhaelt — sie liegt aber zwei Groessenordnungen unter dem, was ein
    // echtes Leck ergaebe.
    if gc_live_objects() > vor + 400 {
        return 29
    }
    return 0
}
