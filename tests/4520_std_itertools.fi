// expect_exit: 0
// tests/4520_std_itertools.fi -- std.itertools against CPython 3.11 `itertools`.
// The expected (count, checksum) pairs come from tools/libs_py_cross/itertools_ref.py,
// which this file mirrors step by step (same LCG, same call order).
import std.io
import std.rt
import std.vec
import std.itertools
import std.testkit

struct Rng { x: u64 }
struct Hash { h: u64 }

fn rnd(g: *mut Rng, m: u64) -> u64 {
    (*g).x = ((*g).x * 1103515245 + 12345) & 0x7fffffff
    return ((*g).x >> 8) % m
}

fn feed(h: *mut Hash, x: u64) {
    (*h).h = ((*h).h * 31 + x) & 0xffffffff
}

fn feed_vec(h: *mut Hash, v: *mut Vec[i64]) {
    var i: usize = 0
    while i < vec_len[i64](v) {
        feed(h, (*vec_elem_ptr[i64](v, i)) as u64)
        i = i + 1
    }
}

fn feed_idx(h: *mut Hash, v: *mut Vec[usize]) {
    var i: usize = 0
    while i < vec_len[usize](v) {
        feed(h, (*vec_elem_ptr[usize](v, i)) as u64)
        i = i + 1
    }
}

fn feed_pairs(h: *mut Hash, v: *mut Vec[IterPair[i64, i64]]) {
    var i: usize = 0
    while i < vec_len[IterPair[i64, i64]](v) {
        let p: *mut IterPair[i64, i64] = vec_elem_ptr[IterPair[i64, i64]](v, i)
        feed(h, (*p).a as u64)
        feed(h, (*p).b as u64)
        i = i + 1
    }
}

fn rand_vec(g: *mut Rng, n: usize, m: u64) -> Vec[i64] {
    var v: Vec[i64] = vec_new[i64]()
    var i: usize = 0
    while i < n {
        vec_push[i64](&v, rnd(g, m) as i64)
        i = i + 1
    }
    return v
}

fn append_all(dst: *mut Vec[i64], src: *mut Vec[i64]) {
    var i: usize = 0
    while i < vec_len[i64](src) {
        vec_push[i64](dst, *vec_elem_ptr[i64](src, i))
        i = i + 1
    }
}

fn add_i64(a: i64, b: i64) -> i64 { return a + b }
fn max_i64(a: i64, b: i64) -> i64 { return if a > b { a } else { b } }
fn lt700(p: *i64) -> bool { return (*p) < 700 }
fn lt300(p: *i64) -> bool { return (*p) < 300 }
fn is_odd(p: *i64) -> bool { return (*p) % 2 == 1 }
fn div3(p: *i64) -> i64 { return (*p) / 3 }

fn report(name: str, count: usize, h: *mut Hash, want_count: usize, want_ck: u64) {
    testkit.check(count == want_count && (*h).h == want_ck, name)
    (*h).h = 7
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var g: Rng = Rng { x: 4242 }
    var hh: Hash = Hash { h: 7 }
    let h: *mut Hash = &hh
    var out: Vec[i64] = vec_new[i64]()

    // A: combinatorics over pools of size 0..nmax, r in 0..rmax
    var total: usize = 0
    var n: usize = 0
    var r: usize = 0
    while n <= 6 {
        var pool: Vec[i64] = rand_vec(&g, n, 1000)
        r = 0
        while r <= 7 {
            vec_clear[i64](&out)
            let c: usize = it_permutations[i64](&pool, r, &out)
            total = total + c
            feed(h, c as u64)
            feed_vec(h, &out)
            r = r + 1
        }
        vec_free[i64](&pool)
        n = n + 1
    }
    report("permutations", total, h, 2372, 1578652996)
    total = 0
    n = 0
    while n <= 6 {
        var pool: Vec[i64] = rand_vec(&g, n, 1000)
        r = 0
        while r <= 7 {
            vec_clear[i64](&out)
            let c: usize = it_combinations[i64](&pool, r, &out)
            total = total + c
            feed(h, c as u64)
            feed_vec(h, &out)
            r = r + 1
        }
        vec_free[i64](&pool)
        n = n + 1
    }
    report("combinations", total, h, 127, 3605727930)
    total = 0
    n = 0
    while n <= 5 {
        var pool: Vec[i64] = rand_vec(&g, n, 1000)
        r = 0
        while r <= 6 {
            vec_clear[i64](&out)
            let c: usize = it_combinations_with_replacement[i64](&pool, r, &out)
            total = total + c
            feed(h, c as u64)
            feed_vec(h, &out)
            r = r + 1
        }
        vec_free[i64](&pool)
        n = n + 1
    }
    report("combinations_with_replacement", total, h, 792, 978564016)
    total = 0
    n = 0
    while n <= 5 {
        var pool: Vec[i64] = rand_vec(&g, n, 1000)
        r = 0
        while r <= 5 {
            vec_clear[i64](&out)
            let c: usize = it_product[i64](&pool, r, &out)
            total = total + c
            feed(h, c as u64)
            feed_vec(h, &out)
            r = r + 1
        }
        vec_free[i64](&pool)
        n = n + 1
    }
    report("product", total, h, 5705, 568536562)

    // B: islice
    total = 0
    var round: usize = 0
    while round < 300 {
        let len: usize = rnd(&g, 31) as usize
        var v: Vec[i64] = rand_vec(&g, len, 1000)
        let start: usize = rnd(&g, 36) as usize
        let s: usize = rnd(&g, 45) as usize
        var stop: usize = s
        if s >= 40 { stop = itertools.it_none() }
        let step: usize = 1 + rnd(&g, 5) as usize
        vec_clear[i64](&out)
        it_islice[i64](&v, start, stop, step, &out)
        total = total + vec_len[i64](&out)
        feed(h, vec_len[i64](&out) as u64)
        feed_vec(h, &out)
        vec_free[i64](&v)
        round = round + 1
    }
    report("islice", total, h, 470, 2188060358)

    // C: accumulate
    total = 0
    round = 0
    while round < 200 {
        let len: usize = rnd(&g, 25) as usize
        var v: Vec[i64] = rand_vec(&g, len, 1000)
        var a: Vec[i64] = vec_new[i64]()
        var b: Vec[i64] = vec_new[i64]()
        var c: Vec[i64] = vec_new[i64]()
        it_accumulate[i64](&v, add_i64, &a)
        it_accumulate[i64](&v, max_i64, &b)
        it_accumulate_from[i64](&v, 5, add_i64, &c)
        total = total + vec_len[i64](&a) + vec_len[i64](&b) + vec_len[i64](&c)
        feed_vec(h, &a)
        feed_vec(h, &b)
        feed_vec(h, &c)
        vec_free[i64](&a)
        vec_free[i64](&b)
        vec_free[i64](&c)
        vec_free[i64](&v)
        round = round + 1
    }
    report("accumulate", total, h, 7466, 3331492769)

    // C2: pairwise / batched / zip / zip_longest
    total = 0
    round = 0
    while round < 200 {
        let len: usize = rnd(&g, 25) as usize
        var v: Vec[i64] = rand_vec(&g, len, 1000)
        var p: Vec[IterPair[i64, i64]] = vec_new[IterPair[i64, i64]]()
        it_pairwise[i64](&v, &p)
        total = total + vec_len[IterPair[i64, i64]](&p)
        feed(h, vec_len[IterPair[i64, i64]](&p) as u64)
        feed_pairs(h, &p)
        vec_free[IterPair[i64, i64]](&p)
        let k: usize = 1 + rnd(&g, 6) as usize
        var bs: Vec[Vec[i64]] = vec_new[Vec[i64]]()
        it_batched[i64](&v, k, &bs)
        feed(h, vec_len[Vec[i64]](&bs) as u64)
        var bi: usize = 0
        while bi < vec_len[Vec[i64]](&bs) {
            let bp: *mut Vec[i64] = vec_elem_ptr[Vec[i64]](&bs, bi)
            feed(h, vec_len[i64](bp) as u64)
            feed_vec(h, bp)
            vec_free[i64](bp)
            bi = bi + 1
        }
        vec_free[Vec[i64]](&bs)
        let wl: usize = rnd(&g, 25) as usize
        var w: Vec[i64] = rand_vec(&g, wl, 1000)
        var z: Vec[IterPair[i64, i64]] = vec_new[IterPair[i64, i64]]()
        var zl: Vec[IterPair[i64, i64]] = vec_new[IterPair[i64, i64]]()
        it_zip[i64, i64](&v, &w, &z)
        it_zip_longest[i64, i64](&v, &w, 7, 7, &zl)
        total = total + vec_len[IterPair[i64, i64]](&z) + vec_len[IterPair[i64, i64]](&zl)
        feed(h, vec_len[IterPair[i64, i64]](&z) as u64)
        feed_pairs(h, &z)
        feed(h, vec_len[IterPair[i64, i64]](&zl) as u64)
        feed_pairs(h, &zl)
        vec_free[IterPair[i64, i64]](&z)
        vec_free[IterPair[i64, i64]](&zl)
        vec_free[i64](&w)
        vec_free[i64](&v)
        round = round + 1
    }
    report("pairwise_batched_zip", total, h, 7077, 3844562290)

    // D: groupby / runs
    total = 0
    round = 0
    while round < 300 {
        let len: usize = rnd(&g, 30) as usize
        var v: Vec[i64] = rand_vec(&g, len, 12)
        var s1: Vec[usize] = vec_new[usize]()
        var s2: Vec[usize] = vec_new[usize]()
        let n1: usize = it_groupby[i64, i64](&v, div3, &s1)
        total = total + n1
        feed(h, n1 as u64)
        feed_idx(h, &s1)
        let n2: usize = it_runs[i64](&v, &s2)
        feed(h, n2 as u64)
        feed_idx(h, &s2)
        vec_free[usize](&s1)
        vec_free[usize](&s2)
        vec_free[i64](&v)
        round = round + 1
    }
    report("groupby", total, h, 3320, 4283106528)

    // E: takewhile / dropwhile / filterfalse / compress / cycle / repeat / chain
    total = 0
    round = 0
    while round < 300 {
        let len: usize = rnd(&g, 30) as usize
        var v: Vec[i64] = rand_vec(&g, len, 1000)
        let sl: usize = rnd(&g, 35) as usize
        var sel: Vec[u8] = vec_new[u8]()
        var si: usize = 0
        while si < sl {
            vec_push[u8](&sel, rnd(&g, 2) as u8)
            si = si + 1
        }
        var t: Vec[i64] = vec_new[i64]()
        var d: Vec[i64] = vec_new[i64]()
        var f: Vec[i64] = vec_new[i64]()
        var cp: Vec[i64] = vec_new[i64]()
        var cy: Vec[i64] = vec_new[i64]()
        var rp: Vec[i64] = vec_new[i64]()
        var ch: Vec[i64] = vec_new[i64]()
        it_takewhile[i64](&v, lt700, &t)
        it_dropwhile[i64](&v, lt300, &d)
        it_filterfalse[i64](&v, is_odd, &f)
        it_compress[i64](&v, &sel, &cp)
        it_cycle[i64](&v, rnd(&g, 40) as usize, &cy)
        let rv: i64 = rnd(&g, 1000) as i64
        it_repeat[i64](rv, rnd(&g, 9) as usize, &rp)
        let wl: usize = rnd(&g, 10) as usize
        var w: Vec[i64] = rand_vec(&g, wl, 1000)
        it_chain[i64](&v, &w, &ch)
        total = total + vec_len[i64](&t) + vec_len[i64](&d) + vec_len[i64](&f)
            + vec_len[i64](&cp) + vec_len[i64](&cy) + vec_len[i64](&rp) + vec_len[i64](&ch)
        feed(h, vec_len[i64](&t) as u64)
        feed_vec(h, &t)
        feed(h, vec_len[i64](&d) as u64)
        feed_vec(h, &d)
        feed(h, vec_len[i64](&f) as u64)
        feed_vec(h, &f)
        feed(h, vec_len[i64](&cp) as u64)
        feed_vec(h, &cp)
        feed(h, vec_len[i64](&cy) as u64)
        feed_vec(h, &cy)
        feed(h, vec_len[i64](&rp) as u64)
        feed_vec(h, &rp)
        feed(h, vec_len[i64](&ch) as u64)
        feed_vec(h, &ch)
        vec_free[i64](&t)
        vec_free[i64](&d)
        vec_free[i64](&f)
        vec_free[i64](&cp)
        vec_free[i64](&cy)
        vec_free[i64](&rp)
        vec_free[i64](&ch)
        vec_free[i64](&w)
        vec_free[u8](&sel)
        vec_free[i64](&v)
        round = round + 1
    }
    report("filters_chain", total, h, 21348, 1359699513)

    // F: next_permutation walks every DISTINCT permutation once, in order
    total = 0
    var b: usize = 0
    while b < 5 {
        var cur: Vec[i64] = vec_new[i64]()
        if b == 0 { for i in 0..(6 as usize) { vec_push[i64](&cur, i as i64) } }
        if b == 1 {
            vec_push[i64](&cur, 1)
            vec_push[i64](&cur, 1)
            vec_push[i64](&cur, 2)
            vec_push[i64](&cur, 2)
            vec_push[i64](&cur, 3)
        }
        if b == 2 { for i in 0..(3 as usize) { vec_push[i64](&cur, 5) } }
        if b == 3 { vec_push[i64](&cur, 3) }
        var states: Vec[i64] = vec_new[i64]()
        var cnt: usize = 1
        append_all(&states, &cur)
        while it_next_permutation[i64](&cur) {
            append_all(&states, &cur)
            cnt = cnt + 1
        }
        // cur is sorted ascending again; the walk back must be the reverse order
        var back: usize = 1
        var ok: bool = true
        it_prev_permutation[i64](&cur)
        while it_prev_permutation[i64](&cur) {
            back = back + 1
        }
        ok = (back == cnt)
        total = total + cnt
        feed(h, cnt as u64)
        feed_vec(h, &states)
        testkit.check(ok, "prev_permutation walk length")
        vec_free[i64](&cur)
        vec_free[i64](&states)
        b = b + 1
    }
    report("next_permutation", total, h, 753, 507545742)
    return testkit.finish()
}
