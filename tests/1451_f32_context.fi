// expect_exit: 0
// tests/1451_f32_context.fi -- the float literal takes its type from the
// context, and the ONE implicit conversion (SPEC 8.6, round 71).
//
// Up to round 70 floating point literals were NOT typeless: `1.5` was
// always an f64, because there was only one type. With f32 that becomes an
// inference from the context, exactly as it has been for integer literals
// since round 70 -- `let y: float = 2.5` gets by without a suffix, and the
// suffix is only needed where nothing at all says anything.
//
// And exactly ONE implicit conversion exists: f32 -> f64. It loses nothing
// (every binary32 IS a binary64). The other way round throws digits away
// and needs `as f32` (tests/neg/f32_no_narrowing.fi).

struct Both {
    d: f64,
    f: f32,
}

fn takes_f32(x: f32) -> f32 {
    return x
}

fn takes_f64(x: f64) -> f64 {
    return x
}

fn widened(x: f32) -> f64 {
    return x
}

fn main() -> i32 {
    // --- the literal takes the type from the declaration
    let a: f32 = 2.5
    let b: f64 = 2.5
    if a as f64 != b { return 1 }

    // --- ... from the parameter
    if takes_f32(0.5) != 0.5 { return 2 }
    if takes_f64(0.5) != 0.5 { return 3 }

    // --- ... and where nothing says anything, f64 holds
    let c = 2.5
    let d: f64 = c
    if d != 2.5 { return 4 }

    // --- 0.1 is the case where the two widths really differ
    let e: f32 = 0.1
    let f: f64 = 0.1
    if e as f64 == f { return 5 }

    // --- the arithmetic follows the operands, and the literal adapts
    let g: f32 = 1.5 + 2.5
    if g != 4.0 { return 6 }
    let h: f32 = 0.1 + 0.2
    let i: f64 = 0.1 + 0.2
    if h as f64 == i { return 7 }

    // --- THE ONE IMPLICIT CONVERSION: f32 -> f64
    let j: f64 = a
    if j != 2.5 { return 8 }
    if takes_f64(a) != 2.5 { return 9 }
    if widened(a) != 2.5 { return 10 }
    var k: f64 = 0.0
    k = a
    if k != 2.5 { return 11 }
    let s = Both { d: a, f: a }
    if s.d != 2.5 { return 12 }
    if s.f != 2.5 { return 13 }
    var arr: [f64; 2] = [0.0, 0.0]
    arr[0] = a
    if arr[0] != 2.5 { return 14 }

    // --- mixed arithmetic: the WIDER one wins, in both orders
    let m: f32 = 1.5
    let n: f64 = 2.5
    if m + n != 4.0 { return 15 }
    if n + m != 4.0 { return 16 }
    if !(m < n) { return 17 }
    if !(n > m) { return 18 }
    if m * n != 3.75 { return 19 }

    // --- compound assignment goes the same way
    var p: f64 = 1.0
    p += m
    if p != 2.5 { return 20 }
    var q: f32 = 1.0
    q += 0.5
    if q != 1.5 { return 21 }
    q *= 2.0
    if q != 3.0 { return 22 }

    // --- `return` widens too
    if widened(0.25) != 0.25 { return 23 }

    // --- the suffix beats the context: `1.5f` stays an f32 everywhere
    let r: f64 = 0.1f
    if r == 0.1 { return 24 }
    if r != (0.1 as f32) as f64 { return 25 }

    return 0
}
