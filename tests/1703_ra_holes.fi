// expect_out: ok
// RUNDE TEMPO 13 -- Lebensdauer mit Luecken im Registerzuteiler.
//
// Zwei Werte duerfen jetzt dasselbe Register haben, wenn sie nie an
// derselben Stelle leben -- auch wenn ihre Intervalle "von erster bis letzter
// Beruehrung" sich ueberschneiden. Geprueft werden die Formen, an denen das
// schiefginge, wenn die Stuecke falsch berechnet waeren:
//
//   * viele Werte, die VOR einer Schleife entstehen und erst DANACH gelesen
//     werden (sie leben durch die Schleife -- keine Luecke!),
//   * ein Wert, der am ENDE des Schleifenrumpfs entsteht und am ANFANG des
//     naechsten Durchlaufs gelesen wird: dazwischen, mitten im Rumpf, ist er
//     tot, und dort darf ein anderer sein Register haben,
//   * zwei Zweige eines `if`, die je eigene Werte haben,
//   * eine Schleife, die NULL Mal laeuft.
//
// Die Eingaben kommen aus `start`, damit nichts vorausgerechnet wird.
import std.io

fn check(got: i64, want: i64, what: str) -> bool {
    if got != want {
        io.print("FEHLER ")
        io.print(what)
        io.new_line()
        return false
    }
    return true
}

fn durch_die_schleife(n: i64, k: i64) -> i64 {
    let a: i64 = k + 1
    let b: i64 = k * 3
    let c: i64 = k - 7
    let d: i64 = k ^ 5
    let e: i64 = k + 11
    let g: i64 = k * k
    let h: i64 = k + 13
    let m: i64 = k * 5
    var s: i64 = 0
    var i: i64 = 0
    while i < n {
        let x: i64 = i * 2
        let y: i64 = x + i
        let z: i64 = y ^ i
        let w: i64 = z + x * y
        s = s + (w & 1023) + (z & 7)
        i = i + 1
    }
    return s + a + b + c + d + e + g + h + m
}

// `vor` entsteht am Ende des Rumpfs und wird am Anfang des naechsten
// Durchlaufs gelesen. Im Rumpf leben dazwischen `t1..t4`.
fn ueber_die_kante(n: i64) -> i64 {
    var vor: i64 = 1
    var s: i64 = 0
    var i: i64 = 0
    while i < n {
        s = s + vor
        let t1: i64 = s * 3 + i
        let t2: i64 = t1 ^ (i * 7)
        let t3: i64 = t2 + t1 * 2
        let t4: i64 = (t3 & 255) + (t2 & 15)
        s = s + t4
        vor = (i * 5 + 3) & 31
        i = i + 1
    }
    return s
}

fn zweige(n: i64, k: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < n {
        if (i & 1) == 0 {
            let p: i64 = i * k
            let q: i64 = p + 3
            let r: i64 = q ^ p
            s = s + (r & 127)
        } else {
            let u: i64 = i + k
            let v: i64 = u * u
            let w: i64 = v - u
            s = s + (w & 63)
        }
        i = i + 1
    }
    return s
}

fn main(start: u64) -> i32 {
    var ok: bool = true
    var n: i64 = 50
    var k: i64 = 9
    var null: i64 = 0
    if start == 7777777 {
        n = 1
        k = 1
        null = 3
    }
    ok = check(durch_die_schleife(n, k), 20885, "durch die Schleife") && ok
    ok = check(durch_die_schleife(null, k), 219, "null Durchlaeufe") && ok
    ok = check(ueber_die_kante(n), 7494, "ueber die Kante") && ok
    ok = check(zweige(n, k), 1213, "zweige") && ok
    if ok {
        io.print_line("ok")
        return 0
    }
    return 1
}
