// expect_out: ok
// ROUND TEMPO 13 -- lifetime with gaps in the register allocator.
//
// Two values may now have the same register if they never live at the
// same place -- even if their intervals "from first to last
// touch" overlap. Checked are the forms in which that
// would go wrong if the pieces were calculated wrongly:
//
//   * many values that arise BEFORE a loop and are read only AFTER it
//     (they live through the loop -- no gap!),
//   * a value that arises at the END of the loop body and is read at the START of the
//     next iteration: in between, in the middle of the body, it is
//     dead, and there another may have its register,
//   * two branches of an `if` that each have values of their own,
//   * a loop that runs ZERO times.
//
// The inputs come from `start`, so that nothing is calculated in advance.
import std.io

fn check(got: i64, want: i64, what: str) -> bool {
    if got != want {
        io.print("FEHLER ")
        io.print(what)
        io.new_line()
        return false
    }
    return true
}

fn through_the_loop(n: i64, k: i64) -> i64 {
    let a: i64 = k + 1
    let b: i64 = k * 3
    let c: i64 = k - 7
    let d: i64 = k ^ 5
    let e: i64 = k + 11
    let g: i64 = k * k
    let h: i64 = k + 13
    let m: i64 = k * 5
    var s: i64 = 0
    var i: i64 = 0
    while i < n {
        let x: i64 = i * 2
        let y: i64 = x + i
        let z: i64 = y ^ i
        let w: i64 = z + x * y
        s = s + (w & 1023) + (z & 7)
        i = i + 1
    }
    return s + a + b + c + d + e + g + h + m
}

// `vor` arises at the end of the body and is read at the start of the next
// iteration. In the body `t1..t4` live in between.
fn over_the_edge(n: i64) -> i64 {
    var vor: i64 = 1
    var s: i64 = 0
    var i: i64 = 0
    while i < n {
        s = s + vor
        let t1: i64 = s * 3 + i
        let t2: i64 = t1 ^ (i * 7)
        let t3: i64 = t2 + t1 * 2
        let t4: i64 = (t3 & 255) + (t2 & 15)
        s = s + t4
        vor = (i * 5 + 3) & 31
        i = i + 1
    }
    return s
}

fn zweige(n: i64, k: i64) -> i64 {
    var s: i64 = 0
    var i: i64 = 0
    while i < n {
        if (i & 1) == 0 {
            let p: i64 = i * k
            let q: i64 = p + 3
            let r: i64 = q ^ p
            s = s + (r & 127)
        } else {
            let u: i64 = i + k
            let v: i64 = u * u
            let w: i64 = v - u
            s = s + (w & 63)
        }
        i = i + 1
    }
    return s
}

fn main(start: u64) -> i32 {
    var ok: bool = true
    var n: i64 = 50
    var k: i64 = 9
    var null: i64 = 0
    if start == 7777777 {
        n = 1
        k = 1
        null = 3
    }
    ok = check(through_the_loop(n, k), 20885, "durch die Schleife") && ok
    ok = check(through_the_loop(null, k), 219, "null Durchlaeufe") && ok
    ok = check(over_the_edge(n), 7494, "ueber die Kante") && ok
    ok = check(zweige(n, k), 1213, "zweige") && ok
    if ok {
        io.print_line("ok")
        return 0
    }
    return 1
}
