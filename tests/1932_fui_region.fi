// expect_exit: 42
// tests/1932_fui_region.fi -- lib/fui/region.fi against a bitmap oracle: a region built from random rectangles covers
// exactly the points a bitmap shows after the same rectangles were drawn into it (while it did not collapse), the
// rectangles never overlap, a collapse covers at least everything that was added, and clip / hits / contains agree
// with the bitmap.
import fui.region
import std.rt

static mut bm: [u8; 4096] = [0 as u8; 4096] // 64 x 64
static mut rg: [i64; 65] = [0 as i64; 65]
static mut seed: u64 = 88172645463325252

fn rnd() -> u64 {
    // xorshift without overflow traps: 32 bit steps
    var x: u64 = seed
    x = x ^ ((x << 13) & 4294967295)
    x = x ^ (x >> 17)
    x = x ^ ((x << 5) & 4294967295)
    seed = x & 4294967295
    return seed
}

fn draw(x0: i64, y0: i64, x1: i64, y1: i64) {
    var y: i64 = y0
    while y < y1 {
        var x: i64 = x0
        while x < x1 {
            if x >= 0 && x < 64 && y >= 0 && y < 64 {
                bm[(y * 64 + x) as usize] = 1 as u8
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn main() -> i32 {
    let r: u64 = (&rg[0]) as u64
    seed = 2463534242
    var round: u64 = 0
    var collapsed_seen: bool = false
    var exact_seen: bool = false
    while round < 300 {
        region.region_clear(r)
        var k: u64 = 0
        while k < 4096 {
            bm[k as usize] = 0 as u8
            k = k + 1
        }
        let nrect: u64 = 1 + rnd() % 12
        var i: u64 = 0
        var collapsed: bool = false
        while i < nrect {
            let x0: i64 = (rnd() % 44) as i64
            let y0: i64 = (rnd() % 44) as i64
            let w: i64 = (1 + rnd() % 20) as i64
            let h: i64 = (1 + rnd() % 20) as i64
            draw(x0, y0, x0 + w, y0 + h)
            region.region_add(r, x0, y0, x0 + w, y0 + h)
            // exact until the area stops matching the bitmap (a collapse made it bigger and stays so)
            var bn: u64 = 0
            var bk: u64 = 0
            while bk < 4096 {
                if bm[bk as usize] != 0 as u8 {
                    bn = bn + 1
                }
                bk = bk + 1
            }
            if region.region_area(r) != bn {
                collapsed = true
            }
            i = i + 1
        }
        // the rectangles never overlap and have an area
        var a: u64 = 0
        var p: u64 = 0
        while p < region.region_count(r) {
            if region.region_rect(r, p, 0) >= region.region_rect(r, p, 2) { return 1 as i32 }
            if region.region_rect(r, p, 1) >= region.region_rect(r, p, 3) { return 2 as i32 }
            var q: u64 = p + 1
            while q < region.region_count(r) {
                if region.region_rect(r, p, 0) < region.region_rect(r, q, 2)
                    && region.region_rect(r, q, 0) < region.region_rect(r, p, 2)
                    && region.region_rect(r, p, 1) < region.region_rect(r, q, 3)
                    && region.region_rect(r, q, 1) < region.region_rect(r, p, 3) {
                    // two rectangles overlap -- only allowed after a collapse (then there is ONE)
                    return 3 as i32
                }
                q = q + 1
            }
            p = p + 1
        }
        // the covered points: at least the bitmap; exactly the bitmap unless it collapsed
        var covered: u64 = 0
        var bits: u64 = 0
        var y: i64 = 0
        while y < 64 {
            var x: i64 = 0
            while x < 64 {
                let b: bool = bm[(y * 64 + x) as usize] != 0 as u8
                let c: bool = region.region_contains(r, x, y)
                if b && !c { return 4 as i32 }
                if b {
                    bits = bits + 1
                }
                if c {
                    covered = covered + 1
                }
                x = x + 1
            }
            y = y + 1
        }
        a = region.region_area(r)
        if collapsed {
            collapsed_seen = true
        } else {
            exact_seen = true
            // exact: the area is the number of points
            if a != bits { return 5 as i32 }
            if covered != bits { return 6 as i32 }
        }
        // clip to a window: the covered points inside stay, the others go
        region.region_clip(r, 10, 10, 40, 40)
        var yy: i64 = 0
        while yy < 64 {
            var xx: i64 = 0
            while xx < 64 {
                let inside: bool = xx >= 10 && xx < 40 && yy >= 10 && yy < 40
                if region.region_contains(r, xx, yy) && !inside { return 7 as i32 }
                xx = xx + 1
            }
            yy = yy + 1
        }
        round = round + 1
    }
    if !collapsed_seen || !exact_seen { return 8 as i32 }
    // a rectangle fully inside a region adds nothing; an empty rectangle adds nothing
    region.region_clear(r)
    region.region_add(r, 0, 0, 10, 10)
    region.region_add(r, 2, 2, 5, 5)
    if region.region_count(r) != 1 { return 9 as i32 }
    region.region_add(r, 5, 5, 5, 9)
    if region.region_count(r) != 1 { return 10 as i32 }
    // two far apart changes stay two rectangles (the point of a region)
    region.region_add(r, 100, 100, 110, 110)
    if region.region_count(r) != 2 { return 11 as i32 }
    if region.region_area(r) != 200 { return 12 as i32 }
    if region.region_hits(r, 50, 50, 60, 60) { return 13 as i32 }
    if !region.region_hits(r, 105, 105, 106, 106) { return 14 as i32 }
    if region.region_bounds(r, 0) != 0 || region.region_bounds(r, 2) != 110 { return 15 as i32 }
    // an L shape: two rectangles overlapping at a corner are cut into disjoint pieces with the right area
    region.region_clear(r)
    region.region_add(r, 0, 0, 10, 4)
    region.region_add(r, 0, 2, 4, 10)
    if region.region_area(r) != 40 + 32 - 8 { return 16 as i32 }
    return 42 as i32
}
