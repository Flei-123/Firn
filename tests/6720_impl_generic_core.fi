// expect_exit: 0
struct Box[T] { value: T, count: i32 }

struct Pair[A, B] { first: A, second: B }

struct Dot { x: i32, y: i32 }

impl Box[T] {
    fn get(*self) -> T { return (*self).value }
    fn set(*mut self, v: T) {
        (*self).value = v
        (*self).count = (*self).count + 1
    }
    fn copy_value(self) -> T { return self.value }
    fn replaced(*self, v: T) -> Box[T] {
        return Box[T] { value: v, count: (*self).count }
    }
    fn bump_twice(*mut self, a: T, b: T) -> i32 {
        self.set(a)
        self.set(b)
        return (*self).count
    }
}

impl Box[U] {
    fn uses(*self) -> i32 { return (*self).count }
}

impl Pair[A, B] {
    fn swapped(*self) -> Pair[B, A] {
        return Pair[B, A] { first: (*self).second, second: (*self).first }
    }
    fn second_of(*self) -> B { return (*self).second }
}

fn main() -> i32 {
    var a: Box[i32] = Box[i32] { value: 7, count: 0 }
    if a.get() != 7 { return 1 }
    a.set(9)
    if a.get() != 9 { return 2 }
    if a.uses() != 1 { return 3 }
    if a.copy_value() != 9 { return 4 }
    let b: Box[i32] = a.replaced(40)
    if b.get() != 40 { return 5 }
    if b.uses() != 1 { return 6 }
    if a.bump_twice(1, 2) != 3 { return 7 }
    var c: Box[u8] = Box[u8] { value: 200 as u8, count: 5 }
    c.set(201 as u8)
    if c.get() != 201 as u8 { return 8 }
    if c.uses() != 6 { return 9 }
    var d: Box[Dot] = Box[Dot] { value: Dot { x: 3, y: 4 }, count: 0 }
    let dv: Dot = d.get()
    if dv.x + dv.y != 7 { return 10 }
    d.set(Dot { x: 10, y: 20 })
    if d.copy_value().y != 20 { return 11 }
    var n: Box[Box[i32]] = Box[Box[i32]] { value: a, count: 0 }
    let inner: Box[i32] = n.get()
    if inner.get() != 2 { return 12 }
    var p: Pair[i32, bool] = Pair[i32, bool] { first: 5, second: true }
    let q: Pair[bool, i32] = p.swapped()
    if q.first != true { return 13 }
    if q.second_of() != 5 { return 14 }
    if !p.second_of() { return 15 }
    return 0
}
