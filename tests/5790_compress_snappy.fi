// expect_exit: 0
import compress.common
import compress.snappy
import std.rt
import std.testkit

const TEXT_RAW: str = __include_str("data/parquet/snappy_text.raw")
const TEXT_SNP: str = __include_str("data/parquet/snappy_text.snappy")
const RND_RAW: str = __include_str("data/parquet/snappy_rnd.raw")
const RND_SNP: str = __include_str("data/parquet/snappy_rnd.snappy")
const RUNS_RAW: str = __include_str("data/parquet/snappy_runs.raw")
const RUNS_SNP: str = __include_str("data/parquet/snappy_runs.snappy")
const MIX_RAW: str = __include_str("data/parquet/snappy_mix.raw")
const MIX_SNP: str = __include_str("data/parquet/snappy_mix.snappy")
const ONE_RAW: str = __include_str("data/parquet/snappy_one.raw")
const ONE_SNP: str = __include_str("data/parquet/snappy_one.snappy")
const EMPTY_SNP: str = __include_str("data/parquet/snappy_empty.snappy")

const BAD: usize = 18446744073709551615

fn decode_n(z: u64, zn: usize, max: usize, out: *mut rt.Buf) -> usize {
    return snappy.snappy_decompress(z, zn, max, out) catch | e | (BAD)
}

fn decode_ok(z: str, want: str) -> bool {
    var out: rt.Buf = rt.buf_new()
    let r: usize = decode_n(z.p as u64, z.length(), want.length(), &out)
    var ok: bool = r != BAD
    if ok {
        ok = rt.buf_len(&out) == want.length() && rt.mem_eq(rt.buf_ptr(&out), want.p as u64, want.length())
    }
    rt.buf_free(&out)
    return ok
}

fn roundtrip_ok(want: str) -> bool {
    var z: rt.Buf = rt.buf_new()
    let r: usize = snappy.snappy_compress(want.p as u64, want.length(), &z) catch | e | (BAD)
    var ok: bool = r != BAD
    if ok {
        ok = decode_ok(rt.buf_str(&z), want)
    }
    rt.buf_free(&z)
    return ok
}

fn refuses(z: u64, zn: usize, max: usize) -> bool {
    var out: rt.Buf = rt.buf_new()
    let r: usize = decode_n(z, zn, max, &out)
    rt.buf_free(&out)
    return r == BAD
}

#[test]
fn decodes_pyarrow_blocks() {
    testkit.assert_true(decode_ok(TEXT_SNP, TEXT_RAW), "text")
    testkit.assert_true(decode_ok(RND_SNP, RND_RAW), "rnd")
    testkit.assert_true(decode_ok(RUNS_SNP, RUNS_RAW), "runs")
    testkit.assert_true(decode_ok(MIX_SNP, MIX_RAW), "mix")
    testkit.assert_true(decode_ok(ONE_SNP, ONE_RAW), "one")
    testkit.assert_true(decode_ok(EMPTY_SNP, ""), "empty")
}

#[test]
fn encoder_roundtrips() {
    testkit.assert_true(roundtrip_ok(TEXT_RAW), "text")
    testkit.assert_true(roundtrip_ok(RND_RAW), "rnd")
    testkit.assert_true(roundtrip_ok(RUNS_RAW), "runs")
    testkit.assert_true(roundtrip_ok(MIX_RAW), "mix")
    testkit.assert_true(roundtrip_ok(ONE_RAW), "one")
    testkit.assert_true(roundtrip_ok(""), "empty")
}

#[test]
fn encoder_compresses() {
    var z: rt.Buf = rt.buf_new()
    let r: usize = snappy.snappy_compress(TEXT_RAW.p as u64, TEXT_RAW.length(), &z) catch | e | (BAD)
    testkit.assert_true(r != BAD && rt.buf_len(&z) < TEXT_RAW.length() / 2, "ratio")
    rt.buf_free(&z)
}

#[test]
fn refusals() {
    testkit.assert_true(refuses(TEXT_SNP.p as u64, TEXT_SNP.length(), 1000), "too large")
    testkit.assert_true(refuses(TEXT_SNP.p as u64, 1000, 0), "cut")
    testkit.assert_true(refuses(TEXT_SNP.p as u64, 0, 0), "empty input")
    var bad: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 6 {
        rt.buf_push(&bad, 255 as u8)
        i = i + 1
    }
    testkit.assert_true(refuses(rt.buf_ptr(&bad), 6, 0), "bad varint")
    rt.buf_free(&bad)
}

#[test]
fn reports_length() {
    let n: usize = snappy.snappy_uncompressed_len(TEXT_SNP.p as u64, TEXT_SNP.length()) catch | e | (BAD)
    testkit.assert_eq_i64(n as i64, TEXT_RAW.length() as i64)
}
