// expect_out: r69 parse: i64 42 u64 255/255 f64 0.1 fallback 7 checks 23 ok
// tests/1281_std_num_parse.fi -- parsing WITHOUT an output parameter
// (round 69).
//
// The old way needed a mutable variable, a `*mut` and a second variable for
// the overflow. The new one returns a STRUCT -- Firn has the result
// location guarantee (SPEC 13.1), so that costs nothing:
//
//     let r: num.ParsedI64 = num.parse_i64(s)
//     if !r.ok { ... }     // r.value is the number, r.overflow the reason
//
// Checked are the EDGES, because that is where a parser is decided:
// i64::MIN (its magnitude does not fit into i64), i64::MAX + 1 and
// u64::MAX + 1 (reported as an overflow instead of wrapping around),
// leftovers behind the number, an empty text, blanks (NOT swallowed --
// `trim` is the caller's), base 16 and the 0x/0b/0o prefix, and a floating
// point number over the exact `strtod` core.
//
// PLUS the proof that nothing was reimplemented: for every case the old
// `text_to_*` and the new `parse_*` have to agree.
//
// The spans come out of `io.text_of(f"...")` -- that is the way to get a
// `Span` out of a string LITERAL today, without writing out `[u8; N]`.
import std.io
import std.num
import std.str

fn as_i64(text: io.Fmt) -> num.ParsedI64 {
    var t: io.Text = io.text_of(text)
    let r: num.ParsedI64 = num.parse_i64(t.span())
    t.free()
    return r
}

fn as_u64(text: io.Fmt) -> num.ParsedU64 {
    var t: io.Text = io.text_of(text)
    let r: num.ParsedU64 = num.parse_u64(t.span())
    t.free()
    return r
}

fn as_f64(text: io.Fmt) -> num.ParsedF64 {
    var t: io.Text = io.text_of(text)
    let r: num.ParsedF64 = num.parse_f64(t.span())
    t.free()
    return r
}

// The counter-check: the old form on the same text.
fn old_i64(text: io.Fmt, out: *mut i64) -> bool {
    var t: io.Text = io.text_of(text)
    let s: str.Span = t.span()
    let ok: bool = num.text_to_i64(s.p, s.n, out)
    t.free()
    return ok
}

fn main() -> i32 {
    var checks: usize = 0

    // --- i64: the ordinary case
    let a: num.ParsedI64 = as_i64(f"42")
    if !a.ok || a.value != 42 || a.overflow {
        return 10
    }
    checks = checks + 1

    let b: num.ParsedI64 = as_i64(f"-42")
    if !b.ok || b.value != 0 - 42 {
        return 11
    }
    checks = checks + 1

    // --- i64: the edges
    let c: num.ParsedI64 = as_i64(f"-9223372036854775808")
    if !c.ok || c.value != num.i64_min() {
        return 12
    }
    checks = checks + 1

    let d: num.ParsedI64 = as_i64(f"9223372036854775807")
    if !d.ok || d.value != num.i64_max() {
        return 13
    }
    checks = checks + 1

    // i64::MAX + 1: an overflow, and it is SAID so
    let e: num.ParsedI64 = as_i64(f"9223372036854775808")
    if e.ok || !e.overflow {
        return 14
    }
    checks = checks + 1

    // --- i64: what is not a number
    // NOTE (docs/ROUND42.md, still true): an `f"..."` may not stand
    // directly in the CONDITION of an `if` -- its hidden text segments are
    // hoisted IN FRONT OF the statement, and the condition is evaluated
    // before the body. An intermediate value solves it. Round 69 makes the
    // case common, because `f"..."` is now an argument all the time.
    let rest_behind: num.ParsedI64 = as_i64(f"12x")
    if rest_behind.ok {
        return 15
    }
    checks = checks + 1
    let rest_ahead: num.ParsedI64 = as_i64(f"x12")
    if rest_ahead.ok {
        return 16
    }
    checks = checks + 1
    // blanks are NOT swallowed -- trimming is the caller's decision
    let blank: num.ParsedI64 = as_i64(f" 42")
    if blank.ok {
        return 17
    }
    checks = checks + 1
    let plus: num.ParsedI64 = as_i64(f"+7")
    if plus.value != 7 {
        return 18
    }
    checks = checks + 1
    // "nothing was there at all"
    let none: num.ParsedI64 = num.parsed_i64_none()
    if none.ok || none.value != 0 || none.overflow {
        return 19
    }
    checks = checks + 1

    // --- u64: the edge and the bases
    let f1: num.ParsedU64 = as_u64(f"18446744073709551615")
    if !f1.ok || f1.value != num.u64_max() {
        return 20
    }
    checks = checks + 1
    let g: num.ParsedU64 = as_u64(f"18446744073709551616")
    if g.ok || !g.overflow {
        return 21
    }
    checks = checks + 1

    var hex: io.Text = io.text_of(f"ff")
    let h: num.ParsedU64 = num.parse_u64_base(hex.span(), 16)
    hex.free()
    if !h.ok || h.value != 255 {
        return 22
    }
    checks = checks + 1

    var pre: io.Text = io.text_of(f"0xff")
    let i1: num.ParsedU64 = num.parse_u64_auto(pre.span())
    pre.free()
    if !i1.ok || i1.value != 255 {
        return 23
    }
    checks = checks + 1

    var bin: io.Text = io.text_of(f"0b1010")
    let j: num.ParsedU64 = num.parse_u64_auto(bin.span())
    bin.free()
    if !j.ok || j.value != 10 {
        return 24
    }
    checks = checks + 1

    if num.parsed_u64_none().ok {
        return 25
    }
    checks = checks + 1

    // --- f64 over the exact strtod core
    let k: num.ParsedF64 = as_f64(f"0.1")
    if !k.ok || k.value != 0.1 {
        return 26
    }
    checks = checks + 1
    let l: num.ParsedF64 = as_f64(f"-2.5e2")
    if !l.ok || l.value != 0.0 - 250.0 {
        return 27
    }
    checks = checks + 1
    let letters: num.ParsedF64 = as_f64(f"abc")
    if letters.ok {
        return 28
    }
    checks = checks + 1
    let tail: num.ParsedF64 = as_f64(f"1.5x")
    if tail.ok {
        return 29
    }
    checks = checks + 1
    if num.parsed_f64_none().ok {
        return 30
    }
    checks = checks + 1

    // --- the fallback: TryParse with an `out` becomes an expression
    let nonsense: num.ParsedI64 = as_i64(f"nonsense")
    if nonsense.value_or(7) != 7 {
        return 40
    }
    let five: num.ParsedI64 = as_i64(f"5")
    if five.value_or(7) != 5 {
        return 41
    }
    let nope: num.ParsedU64 = as_u64(f"nope")
    if num.u64_or(nope, 9) != 9 {
        return 42
    }
    let nope_f: num.ParsedF64 = as_f64(f"nope")
    if nope_f.value_or(1.5) != 1.5 {
        return 43
    }
    checks = checks + 1

    // --- the counter-check: old and new have to agree
    var old: i64 = 0
    let old_min: bool = old_i64(f"-9223372036854775808", &old)
    if !old_min || old != c.value {
        return 50
    }
    let old_over: bool = old_i64(f"9223372036854775808", &old)
    if old_over {
        return 51
    }
    let old_blank: bool = old_i64(f" 42", &old)
    if old_blank {
        return 52
    }
    checks = checks + 1

    io.fmt_print(f"r69 parse: i64 {a.value} u64 {h.value}/{i1.value} ")
    io.fmt_print_line(io.fmt_append(io.fmt_f64(f"f64 ", k.value),
            f" fallback 7 checks {checks} ok"))
    return 0
}
