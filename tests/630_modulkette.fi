// expect_exit: 0
// Zwei Grenzen des Modulsystems, behoben in Runde 17
// (docs/SELBSTHOSTING.md §7):
//
//   B3  Importe werden zuerst relativ zur IMPORTIERENDEN Datei gesucht.
//       `tests/chain/mid.fi` bindet `tief` aus seinem eigenen Verzeichnis
//       ein — vorher wurde in `tests/` gesucht und nicht gefunden.
//   B1  Eine generische Vorlage aus einem Modul ist in der Wurzeldatei
//       benutzbar. Vorher kannte der Parser den Namen `GenPaar` nicht, weil
//       die Vorabsuche je Datei unmittelbar vor deren Parsen lief — und die
//       Wurzel wird zuerst geparst.
import chain.mid

fn main() -> i32 {
    // ueber zwei Modulebenen hinweg: 7 * 6 = 42
    if mid.mid_value() != 42 {
        return 1
    }
    // generische Vorlage aus einem Modul
    var p: GenPair[i32] = GenPair[i32]{ a: 17, b: 25 }
    if gen_sum[i32](&p) != 42 {
        return 2
    }
    var q: GenPair[u8] = GenPair[u8]{ a: 3 as u8, b: 4 as u8 }
    if gen_sum[u8](&q) != 7 as u8 {
        return 3
    }
    return 0
}
