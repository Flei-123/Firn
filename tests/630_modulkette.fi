// expect_exit: 0
// Two limits of the module system, lifted in round 17
// (docs/SELF_HOSTING.md 7):
//
//   B3  imports are looked up relative to the IMPORTING file first.
//       `tests/chain/mid.fi` imports `deep` from its own directory --
//       before, the search happened in `tests/` and found nothing.
//   B1  a generic template from a module is usable in the root file.
//       Before, the parser did not know the name `GenPair`, because the
//       pre-scan per file ran immediately before parsing that file -- and
//       the root is parsed first.
import chain.mid

fn main() -> i32 {
    // across two module levels: 7 * 6 = 42
    if mid.mid_value() != 42 {
        return 1
    }
    // generic template from a module
    var p: GenPair[i32] = GenPair[i32] { a: 17, b: 25 }
    if gen_sum[i32](&p) != 42 {
        return 2
    }
    var q: GenPair[u8] = GenPair[u8] { a: 3 as u8, b: 4 as u8 }
    if gen_sum[u8](&q) != 7 as u8 {
        return 3
    }
    return 0
}
