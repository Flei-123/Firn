// expect_exit: 0
// div128 (Knuth D) against the old bit-by-bit loop: 300000 random cases incl. tiny and power-of-two divisors.
// Both functions are copies of lib/num/strtod.fi (the old one renamed), like tests/304.
const D_TWO63: u64 = 9223372036854775808
// (nhi,nlo) / d, with the remainder in `rem`. REQUIRES nhi < d, which makes
// the quotient fit into 64 bits.
//
// Bit by bit, sixty-four steps. Knuth's two-limb algorithm would be about
// four times as short, but it needs the wrap-around of the unsigned
// subtraction in three places, and this file is not the place to depend on
// that -- round 83 is putting checked arithmetic into the language next
// door. Every step here stays inside the range: the only difficult case is
// `r >= 2^63`, where doubling would overflow, and there `2r + bit - d` is
// written as `r - (d - r) + bit`, which is non-negative because d - r < 2^63
// <= r.
fn div128_old(nhi: u64, nlo: u64, d: u64, rem: *mut u64) -> u64 {
    var r: u64 = nhi
    var q: u64 = 0
    var i: usize = 0
    while i < 64 {
        let bit: u64 = (nlo >> (63 - i)) & 1
        if r >= D_TWO63 {
            // 2r >= 2^64 > d, so the subtraction always happens
            r = r - (d - r) + bit
            q = (q << 1) | 1
        } else {
            let r2: u64 = (r << 1) | bit
            if r2 >= d {
                r = r2 - d
                q = (q << 1) | 1
            } else {
                r = r2
                q = q << 1
            }
        }
        i = i + 1
    }
    *rem = r
    return q
}

// (nhi,nlo) / d, with the remainder in `rem`. REQUIRES nhi < d, which makes
// the quotient fit into 64 bits.
//
// Knuth's algorithm D with two 32 bit limbs (Hacker's Delight `divlu`): two
// hardware divisions of 64 by 32 bits and a few corrections instead of the
// sixty-four bit-by-bit steps this used to be (that loop was 9 % of all
// instructions of a JSON parse full of floats). The wrap-around operators
// (`+%`, `-%`, `*%`) are used exactly where the true value is known to fit
// modulo 2^64: `un21` and `un0` below are smaller than `d` by construction.
// Cross-checked against the old bit loop in tests/4397_div128_cross.fi.
fn div128(nhi: u64, nlo: u64, d: u64, rem: *mut u64) -> u64 {
    // normalise: shift d left until its top bit is set
    var s: usize = 0
    var t: u64 = d
    if t < 4294967296 {
        s = s + 32
        t = t << 32
    }
    while t < D_TWO63 {
        s = s + 1
        t = t << 1
    }
    let dn: u64 = d << s
    var un32: u64 = nhi
    var un10: u64 = nlo
    if s > 0 {
        un32 = (nhi << s) | (nlo >> (64 - s))
        un10 = nlo << s
    }
    let b: u64 = 4294967296
    let dn1: u64 = dn >> 32
    let dn0: u64 = dn & 4294967295
    let un1: u64 = un10 >> 32
    let un0: u64 = un10 & 4294967295

    var q1: u64 = un32 / dn1
    var rhat: u64 = un32 - q1 * dn1
    var again1: bool = true
    while again1 {
        again1 = false
        if q1 >= b || q1 * dn0 > b * rhat + un1 {
            q1 = q1 - 1
            rhat = rhat + dn1
            if rhat < b {
                again1 = true
            }
        }
    }
    let un21: u64 = un32 *% b +% un1 -% q1 *% dn

    var q0: u64 = un21 / dn1
    rhat = un21 - q0 * dn1
    var again2: bool = true
    while again2 {
        again2 = false
        if q0 >= b || q0 * dn0 > b * rhat + un0 {
            q0 = q0 - 1
            rhat = rhat + dn1
            if rhat < b {
                again2 = true
            }
        }
    }
    *rem = (un21 *% b +% un0 -% q0 *% dn) >> s
    return q1 * b + q0
}

static mut S: u64 = 88172645463325252
fn rnd() -> u64 {
    var x: u64 = S
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    S = x
    return x
}
fn main() -> i32 {
    var i: usize = 0
    while i < 300000 {
        var d: u64 = rnd()
        let k: u64 = rnd() % 4
        if k == 0 { d = d >> (rnd() % 64) }
        if k == 1 { d = (rnd() % 100000) + 1 }
        if k == 2 { d = (1 << (rnd() % 64)) + (rnd() % 3) }
        if d == 0 { d = 1 }
        let nhi: u64 = rnd() % d
        let nlo: u64 = rnd()
        var r1: u64 = 0
        var r2: u64 = 0
        let q1: u64 = div128_old(nhi, nlo, d, &r1)
        let q2: u64 = div128(nhi, nlo, d, &r2)
        if q1 != q2 || r1 != r2 { return 1 }
        i = i + 1
    }
    return 0
}
