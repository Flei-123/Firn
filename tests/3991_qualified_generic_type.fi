// expect_exit: 0
// r707 (G25 rest): `mod.Type[T]` -- a generic struct named through its module,
// in type position and as a literal.
import modules.qty

// a local template also marks the file "not core" for the generics-free AST
// dump of parser_compare
fn local_id[T](a: T) -> T {
    return a
}

fn total(b: qty.Box[i32], p: qty.Pair[i32, u8]) -> i32 {
    return b.v + p.a + (p.b as i32)
}

fn main() -> i32 {
    var x: qty.Box[i32] = qty.Box[i32] { v: 5 as i32 }
    let y: qty.Pair[i32, u8] = qty.Pair[i32, u8] { a: 1 as i32, b: 2 as u8 }
    let z: qty.Box[i32] = qty.make_box[i32](9 as i32)
    if local_id[i32](x.v) != 5 as i32 {
        return 1 as i32
    }
    if y.b != 2 as u8 {
        return 2 as i32
    }
    if qty.unbox[i32](z) != 9 as i32 {
        return 3 as i32
    }
    if total(x, y) != 8 as i32 {
        return 4 as i32
    }
    // nested type arguments, bare and qualified spelling side by side
    let n: qty.Box[qty.Pair[i32, u8]] = qty.Box[qty.Pair[i32, u8]] { v: y }
    if n.v.a != 1 as i32 {
        return 5 as i32
    }
    let m: Box[i32] = x
    if m.v != 5 as i32 {
        return 6 as i32
    }
    return 0 as i32
}
