// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
// tests/2151_oauth.fi -- the parts of lib/auth/oauth.fi that need no network:
//
// A  the PKCE challenge of RFC 7636 appendix B; a fresh verifier has 43
//    characters of the base64url alphabet and two are never equal
// B  percent encoding (RFC 3986 unreserved set) and decoding, '+' only when asked
// C  form_add builds "a=b&c=d" with the values encoded
// D  oa_endpoint_ok: https yes; http only for 127.0.0.1 and localhost;
//    ftp, javascript:, empty and relative references no
// E  the authorize URL: every parameter present and encoded, `?` or `&` as
//    the endpoint needs, S256, the extra parameters appended
// F  the token set as JSON and back; a broken JSON; the validity window
// G  a pasted redirect URL: another `state` is OA_STATE before anything is
//    sent; an error answer carries err_code and err_desc; no query at all
//    is a protocol error
// H  OA_CONFIG when the endpoints are missing (no request is made)
import std.rt
import std.io
import std.str
import auth.oauth

fn bs(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: (*b).len }
}

fn is_b64url(s: str) -> bool {
    var i: usize = 0
    while i < s.length() {
        let c: u8 = s.chars(i)
        let ok: bool = (c >= 48 as u8 && c <= 57 as u8) || (c >= 65 as u8 && c <= 90 as u8) ||
        (c >= 97 as u8 && c <= 122 as u8) || c == 45 as u8 || c == 95 as u8
        if !ok { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    // ---- A
    if oauth.pkce_challenge_of("dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk") != "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM" {
        return 1 as i32
    }
    var p1: oauth.Pkce = oauth.Pkce { verifier: "", challenge: "", state: "", nonce: "" }
    var p2: oauth.Pkce = oauth.Pkce { verifier: "", challenge: "", state: "", nonce: "" }
    if !oauth.pkce_new(&p1) || !oauth.pkce_new(&p2) { return 2 as i32 }
    if p1.verifier.length() != 43 || !is_b64url(p1.verifier) { return 3 as i32 }
    if p1.verifier == p2.verifier || p1.state == p2.state || p1.nonce == p2.nonce { return 4 as i32 }
    if p1.challenge.length() != 43 || p1.challenge != oauth.pkce_challenge_of(p1.verifier) { return 5 as i32 }
    if p1.state.length() != 32 || !is_b64url(p1.state) { return 6 as i32 }

    // ---- B
    var b: rt.Buf = rt.buf_new()
    let raw: str = "a b&c=d/é~-._Z9"
    oauth.pct_encode(raw.p as u64, raw.length(), &b)
    if bs(&b) != "a%20b%26c%3Dd%2F%C3%A9~-._Z9" { return 10 as i32 }
    var d: rt.Buf = rt.buf_new()
    if !oauth.pct_decode(b.ptr, b.len, false, &d) { return 11 as i32 }
    if bs(&d) != raw { return 12 as i32 }
    rt.buf_clear(&d)
    let plus: str = "a+b%2Bc"
    if !oauth.pct_decode(plus.p as u64, plus.length(), true, &d) { return 13 as i32 }
    if bs(&d) != "a b+c" { return 14 as i32 }
    rt.buf_clear(&d)
    if !oauth.pct_decode(plus.p as u64, plus.length(), false, &d) { return 15 as i32 }
    if bs(&d) != "a+b+c" { return 16 as i32 }
    rt.buf_clear(&d)
    let broken: str = "abc%4"
    if oauth.pct_decode(broken.p as u64, broken.length(), true, &d) { return 17 as i32 }
    let broken2: str = "abc%zz"
    if oauth.pct_decode(broken2.p as u64, broken2.length(), true, &d) { return 18 as i32 }
    let atend: str = "ab%"
    if oauth.pct_decode(atend.p as u64, atend.length(), true, &d) { return 19 as i32 }
    let ok2: str = "x%41"
    rt.buf_clear(&d)
    if !oauth.pct_decode(ok2.p as u64, ok2.length(), true, &d) || bs(&d) != "xA" { return 20 as i32 }

    // ---- C
    rt.buf_clear(&b)
    oauth.form_add_str(&b, "grant_type", "authorization_code")
    oauth.form_add_str(&b, "redirect_uri", "http://127.0.0.1:5/cb?x=1")
    oauth.form_add_str(&b, "empty", "")
    if bs(&b) != "grant_type=authorization_code&redirect_uri=http%3A%2F%2F127.0.0.1%3A5%2Fcb%3Fx%3D1&empty=" { return 21 as i32 }

    // ---- D
    if !oauth.oa_endpoint_ok("https://login.example.com/token") { return 30 as i32 }
    if !oauth.oa_endpoint_ok("http://127.0.0.1:8080/token") { return 31 as i32 }
    if !oauth.oa_endpoint_ok("http://localhost/token") { return 32 as i32 }
    if !oauth.oa_endpoint_ok("http://LOCALHOST:99/token") { return 33 as i32 }
    if oauth.oa_endpoint_ok("http://[::1]:99/token") { return 34 as i32 } // net.http is IPv4 only
    if oauth.oa_endpoint_ok("http://example.com/token") { return 35 as i32 }
    if oauth.oa_endpoint_ok("http://127.0.0.1.example.com/token") { return 36 as i32 }
    if oauth.oa_endpoint_ok("http://localhost.evil.com/token") { return 37 as i32 }
    if oauth.oa_endpoint_ok("ftp://127.0.0.1/token") { return 38 as i32 }
    if oauth.oa_endpoint_ok("javascript:alert(1)") { return 39 as i32 }
    if oauth.oa_endpoint_ok("") { return 40 as i32 }
    if oauth.oa_endpoint_ok("/token") { return 41 as i32 }

    // ---- E
    var o: oauth.OAuth = oauth.oauth_new("my client&id")
    oauth.oauth_set_endpoints(&o, "https://idp.example/authorize", "https://idp.example/token", "", "")
    oauth.oauth_set_scope(&o, "openid profile")
    var pk: oauth.Pkce = oauth.Pkce { verifier: "v", challenge: "CHAL", state: "ST", nonce: "NO" }
    let u: str = oauth.oauth_auth_url(&o, &pk, "http://127.0.0.1:5000/callback")
    if u != "https://idp.example/authorize?response_type=code&client_id=my%20client%26id&redirect_uri=http%3A%2F%2F127.0.0.1%3A5000%2Fcallback&scope=openid%20profile&state=ST&code_challenge=CHAL&code_challenge_method=S256&nonce=NO" {
        io.print_line(u)
        return 50 as i32
    }
    oauth.oauth_set_endpoints(&o, "https://idp.example/authorize?tenant=x", "https://idp.example/token", "", "")
    oauth.oauth_set_extra_auth(&o, "prompt=login")
    let u2: str = oauth.oauth_auth_url(&o, &pk, "http://127.0.0.1:1/c")
    if !u2.starts_with("https://idp.example/authorize?tenant=x&response_type=code&") { return 51 as i32 }
    if !u2.ends_with("&nonce=NO&prompt=login") { return 52 as i32 }

    // ---- F
    var t: oauth.Tokens = oauth.tokens_new()
    t.access = "acc\"ess\n"
    t.refresh = "ref"
    t.id_token = "a.b.c"
    t.token_type = "Bearer"
    t.scope = "openid offline_access"
    t.expires_at = 4102444800
    t.issued_at = 100
    t.ok = true
    var js: rt.Buf = rt.buf_new()
    oauth.tokens_to_json(&t, &js)
    var t2: oauth.Tokens = oauth.tokens_new()
    if !oauth.tokens_from_json(bs(&js), &t2) { return 60 as i32 }
    if t2.access != t.access || t2.refresh != "ref" || t2.id_token != "a.b.c" || t2.scope != t.scope { return 61 as i32 }
    if t2.expires_at != 4102444800 || t2.issued_at != 100 || t2.token_type != "Bearer" { return 62 as i32 }
    if oauth.tokens_from_json("not json", &t2) { return 63 as i32 }
    if oauth.tokens_from_json("{\"scope\":\"x\"}", &t2) { return 64 as i32 }
    if !oauth.tokens_valid(&t, 60) { return 65 as i32 }
    t.expires_at = oauth.oa_now() + 30
    if oauth.tokens_valid(&t, 60) || !oauth.tokens_valid(&t, 10) { return 66 as i32 }
    if oauth.tokens_expires_in(&t) > 30 || oauth.tokens_expires_in(&t) < 25 { return 67 as i32 }
    t.expires_at = 0
    if !oauth.tokens_valid(&t, 60) || oauth.tokens_expires_in(&t) != -1 { return 68 as i32 }

    // ---- G
    var pk2: oauth.Pkce = oauth.Pkce { verifier: "verifier", challenge: "c", state: "GOODSTATE", nonce: "" }
    var tk: oauth.Tokens = oauth.tokens_new()
    if oauth.oauth_complete_redirect(&o, &pk2, "http://127.0.0.1:1/c",
        "http://127.0.0.1:1/c?code=abc&state=OTHER", &tk) != oauth.OA_STATE { return 70 as i32 }
    if oauth.oauth_complete_redirect(&o, &pk2, "http://127.0.0.1:1/c",
        "http://127.0.0.1:1/c?code=abc", &tk) != oauth.OA_STATE { return 71 as i32 }
    if oauth.oauth_complete_redirect(&o, &pk2, "http://127.0.0.1:1/c",
        "http://127.0.0.1:1/c", &tk) != oauth.OA_PROTOCOL { return 72 as i32 }
    if oauth.oauth_complete_redirect(&o, &pk2, "http://127.0.0.1:1/c",
        "http://127.0.0.1:1/c?error=access_denied&error_description=No%20thanks&state=GOODSTATE", &tk) != oauth.OA_DENIED { return 73 as i32 }
    if oauth.oauth_err_code(&o) != "access_denied" || oauth.oauth_err_desc(&o) != "No thanks" { return 74 as i32 }
    if oauth.oauth_complete_redirect(&o, &pk2, "http://127.0.0.1:1/c",
        "http://127.0.0.1:1/c?error=server_error&state=GOODSTATE#frag", &tk) != oauth.OA_ERROR { return 75 as i32 }
    // a state hidden in the fragment is not the query's state
    if oauth.oauth_complete_redirect(&o, &pk2, "http://127.0.0.1:1/c",
        "http://127.0.0.1:1/c?code=abc#state=GOODSTATE", &tk) != oauth.OA_STATE { return 76 as i32 }

    // ---- H
    var o2: oauth.OAuth = oauth.oauth_new("cid")
    var da: oauth.DeviceAuth = oauth.deviceauth_new()
    var tk2: oauth.Tokens = oauth.tokens_new()
    if oauth.oauth_device_start(&o2, &da) != oauth.OA_CONFIG { return 80 as i32 }
    if oauth.oauth_device_poll_once(&o2, &da, &tk2) != oauth.OA_CONFIG { return 81 as i32 }
    if oauth.oauth_login_loopback(&o2, &tk2, 100) != oauth.OA_CONFIG { return 82 as i32 }
    if oauth.oauth_refresh(&o2, &tk2) != oauth.OA_NOTOKEN { return 83 as i32 }
    tk2.refresh = "r"
    if oauth.oauth_refresh(&o2, &tk2) != oauth.OA_CONFIG { return 84 as i32 }
    if oauth.oauth_ensure_fresh(&o2, &tk2, 10) != oauth.OA_NOTOKEN { return 85 as i32 }
    // an endpoint over plain http to a stranger is refused before any request
    oauth.oauth_set_endpoints(&o2, "http://evil.example/a", "http://evil.example/t", "http://evil.example/d", "")
    tk2.ok = true
    if oauth.oauth_refresh(&o2, &tk2) != oauth.OA_CONFIG { return 86 as i32 }
    if oauth.oauth_device_start(&o2, &da) != oauth.OA_CONFIG { return 87 as i32 }
    if oauth.oauth_login_loopback(&o2, &tk2, 100) != oauth.OA_CONFIG { return 88 as i32 }
    if oauth.oauth_net_error(&o2) != 0 as u32 { return 89 as i32 }

    rt.buf_free(&b)
    rt.buf_free(&d)
    rt.buf_free(&js)
    return 0 as i32
}
