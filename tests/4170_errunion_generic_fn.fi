// expect_exit: 7
// r733: error union with a type parameter: -> E!T in a generic fn, try/catch with generics.
error MyErr { Bad }
fn pass[T](x: T) -> MyErr!T {
    return x
}
fn pass_try[T](x: T) -> MyErr!T {
    let v = try pass[T](x)
    return v
}
fn main() -> i32 {
    let a: i32 = pass[i32](3) catch 0
    let b: i64 = try_it(4)
    return a + (b as i32)
}
fn try_it(x: i64) -> i64 {
    return pass_try[i64](x) catch 0
}
