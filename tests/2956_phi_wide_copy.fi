struct Img {
    w: i32,
    h: i32,
    ch: i32,
    px: u64,
}

#[inline]
fn img_get(im: *mut Img, c: i32, x: i32, y: i32) -> f32 {
    return *(((*im).px + (((c * (*im).h + y) * (*im).w + x) as u64) * (4 as u64)) as *mut f32)
}

fn window_const(a: *mut Img, b: *mut Img) -> f64 {
    var total: f64 = 0.0
    var y: i32 = 5
    while y < 6 {
        var x: i32 = 3
        while x < 13 {
            var sa: f64 = 0.0
            var sb: f64 = 0.0
            var dy: i32 = -3
            while dy <= 3 {
                var dx: i32 = -3
                while dx <= 3 {
                    let va: f64 = img_get(a, 0, x + dx, y + dy) as f64
                    let vb: f64 = img_get(b, 0, x + dx, y + dy) as f64
                    sa = sa + va
                    sb = sb + vb
                    dx = dx + 1
                }
                dy = dy + 1
            }
            total = total + sa / 49.0 + sb / 49.0
            x = x + 1
        }
        y = y + 1
    }
    return total
}

fn window_dyn(a: *mut Img, b: *mut Img, r: i32) -> f64 {
    var total: f64 = 0.0
    var y: i32 = 5
    while y < 6 {
        var x: i32 = 3
        while x < 13 {
            var sa: f64 = 0.0
            var sb: f64 = 0.0
            var dy: i32 = 0 - r
            while dy <= r {
                var dx: i32 = 0 - r
                while dx <= r {
                    let va: f64 = img_get(a, 0, x + dx, y + dy) as f64
                    let vb: f64 = img_get(b, 0, x + dx, y + dy) as f64
                    sa = sa + va
                    sb = sb + vb
                    dx = dx + 1
                }
                dy = dy + 1
            }
            total = total + sa / 49.0 + sb / 49.0
            x = x + 1
        }
        y = y + 1
    }
    return total
}

fn main() -> i32 {
    if counters() != 17558640 { return 1 }
    if rotate() != 122640 { return 2 }
    let n: usize = 16 * 16 * 3 * 4
    let pa: u64 = rt.heap_alloc(n)
    let pb: u64 = rt.heap_alloc(n)
    var i: i32 = 0
    while i < 768 {
        *((pa + (i as u64) * (4 as u64)) as *mut f32) = ((i * 7 % 13) as f32) * 0.1f
        *((pb + (i as u64) * (4 as u64)) as *mut f32) = ((i * 5 % 11) as f32) * 0.1f
        i = i + 1
    }
    var a: Img = Img { w: 16, h: 16, ch: 3, px: pa }
    var b: Img = Img { w: 16, h: 16, ch: 3, px: pb }
    let c: f64 = window_const(&a, &b)
    let d: f64 = window_dyn(&a, &b, 3)
    var diff: f64 = c - d
    if diff < 0.0 { diff = 0.0 - diff }
    if diff > 0.000000001 { return 3 }
    io.print_line("ok")
    return 0
}
