// expect_exit: 0
// tests/1232_line_continuation.fi -- ROUND 68: an expression may run over
// several lines.
//
// Both gap lists asked for this. docs/ROUND59.md, section 8: "line
// continuation -- an expression has to stand on one line, which is why the
// descriptor fields are assembled with `var ... =` and `|=`-like steps".
// docs/ROUND63.md, gap 3: "a binary operator may not begin a line ... it
// cost this round four passes of a reformatting script over every file".
//
// The rule: a token that can ONLY continue an expression -- a binary
// operator, the `.` of a field access, the `as` of a conversion -- carries
// the expression over the line break. `*`, `(` and `[` are deliberately not
// in that set; section 9 of this file is the counter-check.

struct Inner { v: i32, w: i32 }
struct Outer { inner: Inner, tag: i32 }

fn add3(a: u64, b: u64, c: u64) -> u64 { return a + b + c }

fn main() -> i32 {
    // 1. THE KERNEL CASE: a descriptor assembled out of its fields, with
    //    the operator at the START of the line instead of at the end.
    let base: u64 = 0x00123456789A
    let limit: u64 = 0xFFFFF
    let desc: u64 = (limit & 0xFFFF)
    | ((base & 0xFFFF) << 16)
    | (((base >> 16) & 0xFF) << 32)
    | (0x9A << 40)
    | (((limit >> 16) & 0xF) << 48)
    | (0xC << 52)
    | (((base >> 24) & 0xFF) << 56)
    if desc != 0x34CF9A56789AFFFF { return 1 }

    // 2. THE JAVASCRIPT CASE: a long condition, broken at `&&` / `||`.
    let a: i32 = 3
    let b: i32 = 4
    let c: i32 = 5
    if a > 0
    && b > 0
    && c > 0
    && a + b > c {
        // reached
    } else {
        return 2
    }
    if a > 100
    || b > 100
    || c == 5 {
        // reached over the third alternative
    } else {
        return 3
    }
    var n: i32 = 0
    while n < 10
    && n * n < 30 {
        n = n + 1
    }
    if n != 6 { return 4 }

    // 3. arithmetic over four lines, in a `let`
    let s: i32 = 1
    +2
    +3
    -4 *
    2
    if s != -2 { return 5 }

    // 4. the same in an assignment and in a `return` value
    var t: i32 = 0
    t = a
    +b
    +c
    if t != 12 { return 6 }

    // 5. comparison and equality at the start of a line
    let eq: bool = a + b
    == 7
    if !eq { return 7 }
    let lt: bool = a
    < b
    if !lt { return 8 }

    // 6. `.` at the start of a line -- a chain of field accesses
    let o: Outer = Outer { inner: Inner { v: 41, w: 1 }, tag: 9 }
    let deep: i32 = o
    .inner
    .v
    if deep != 41 { return 9 }
    let both: i32 = o
    .inner
    .v
    +o
    .inner
    .w
    if both != 42 { return 10 }

    // 7. `as` at the start of a line
    let wide: u64 = a
    as u64
    if wide != 3 { return 11 }

    // 8. mixed with what already worked: operator at the END of the line,
    //    and a line break inside brackets.
    let mix: u64 = add3(1,
        2,
        3) +
    add3(4, 5,
        6) + wide
    if mix != 24 { return 12 }

    // 9. THE COUNTER-CHECK. A line that begins with `*` is a STORE, not a
    //    multiplication of the line before -- otherwise the two statements
    //    below would silently become `q = (v * (*q)) = 7`.
    var v: i32 = 6
    let q: *mut i32 = &v
    *q = 7
    if v != 7 { return 13 }
    // and the same for `(` at the start of a line: an assignment through a
    // dereferenced pointer, NOT a call of the line before.
    let r: *mut Outer = &o
    (*r).tag = 99
    if o.tag != 99 { return 14 }
    return 0
}
