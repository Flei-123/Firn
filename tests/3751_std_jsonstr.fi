// expect_exit: 0
// std.jsonstr: str keys/values for std.json, dumps(indent, sort_keys) from compact writer output.
import std.rt
import std.str
import std.json
import std.jsonstr

fn main() -> i32 {
    var raw: rt.Buf = rt.buf_new()
    defer rt.buf_free(&raw)
    var w: json.JsonWriter = json.jw_new(&raw, false)
    json.jw_begin_object(&w)
    jsonstr.key(&w, "b")
    jsonstr.value(&w, "x\"y")
    jsonstr.key(&w, "a")
    json.jw_begin_array(&w)
    json.jw_int(&w, 1)
    json.jw_int(&w, 2)
    json.jw_end(&w)
    json.jw_end(&w)
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    if !jsonstr.dumps(&raw, 2, true, &out) { return 1 }
    let want: str = "{\n  \"a\": [\n    1,\n    2\n  ],\n  \"b\": \"x\\\"y\"\n}"
    if rt.buf_len(&out) != want.n { return 2 }
    var i: usize = 0
    while i < want.n {
        if rt.buf_at(&out, i) != *(want.p + i) { return 3 }
        i = i + 1
    }
    var d: json.Json = json.json_new()
    defer json.json_free(&d)
    let ok: bool = json.json_parse(&d, rt.buf_ptr(&raw), rt.buf_len(&raw)) catch false
    if !ok { return 4 }
    let b: u32 = jsonstr.get(&d, json.json_root(&d), "b")
    if !jsonstr.string(&d, b).equal("x\"y") { return 5 }
    if jsonstr.get(&d, json.json_root(&d), "zz") != json.JSON_NONE { return 6 }
    var bad: rt.Buf = rt.buf_new()
    defer rt.buf_free(&bad)
    rt.buf_push_bytes(&bad, "{\"a\":".p as u64, 5)
    if jsonstr.dumps(&bad, 2, true, &out) { return 7 }
    return 0
}
