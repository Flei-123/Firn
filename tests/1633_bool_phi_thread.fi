// expect_out: 1 1 1
// ROUND FIRN-LUECKEN -- the value of a threaded join is read elsewhere.
//
// `threading.rs::thread_bool_phis` (round SPEED) makes a predecessor jump
// past a join that does nothing but branch on a bool phi. It drops the
// predecessor's entry from that phi in the same step -- and if the LAST
// entry goes, the phi has no entries at all and the value it defines has
// no definition.
//
// The round wrote the rule down ("a pass may delete a block's control
// flow, but not a definition another instruction still names") and applied
// it to the dead block, not to the value. This is the shape where that
// costs the answer:
//
//     bb3: %21 = phi.bool [bb1 %6, bb2 %3] ; brcond %21, bb5, bb4
//     bb6: %20 = phi.bool [bb5 %21, bb9 %19] ; brcond %20, bb11, bb10
//
// `%21` travels on into the phi of bb6. Threading bb3 leaves that entry
// pointing at nothing, and `found` comes out false however it was set.
//
// It is not an exotic shape: it is `var found = false` followed by a chain
// of `if !found { ... found = true }`, which is how every search with
// several places to look is written. In `bin/firnc1.fi` it is
// `imports_collect`, and with the miscompiled version the self compiled
// compiler answered "module not found" for a file it had just found --
// stage 1 of the fixpoint stopped working.
import std.io

fn is_file(x: i32) -> bool {
    return x == 1
}

// Three places to look, the answer in a bool that survives all three.
fn probe(k: i32) -> bool {
    var found: bool = false
    if is_file(k) {
        found = true
    }
    if !found {
        if is_file(k + 1) {
            found = true
        }
    }
    if !found {
        var qi: i32 = 0
        while qi < 3 {
            if is_file(k + qi) {
                found = true
                break
            }
            qi = qi + 1
        }
    }
    if !found {
        return false
    }
    return true
}

fn yes(b: bool) -> i64 {
    if b {
        return 1
    }
    return 0
}

fn main() -> i32 {
    // 1 hits in the first place, 0 in the second, -1 in the third.
    let a: i64 = yes(probe(1))
    let b: i64 = yes(probe(0))
    let c: i64 = yes(probe(0 - 1))
    io.fmt_print_line(f"{a} {b} {c}")
    return 0
}
