// expect_exit: 100
// #[no_gc] across the module boundary (SPEC 3.5.4): a marked function in the
// root file calls marked functions from an imported module. The
// counter-check -- the same arrangement with an unmarked module function --
// is in tests/neg/nogc_module_boundary.fi.
import modules.nogc_hot

#[no_gc]
fn core(a: i32) -> i32 {
    return nogc_hot.mix(a, a + 1 as i32)
}

fn main() -> i32 {
    // round(1) = 38, round(2) = 69, mix(1,2) = 107
    let x = core(1 as i32)
    return x - 7 as i32
}
