// expect_exit: 100
// #[no_gc] ueber die Modulgrenze (SPEC §3.5.4): eine markierte Funktion in der
// Wurzeldatei ruft markierte Funktionen aus einem eingebundenen Modul. Die
// Gegenprobe — dieselbe Anordnung mit einer unmarkierten Modulfunktion —
// steht in tests/neg/nogc_modulgrenze.fi.
import modules.nogc_hot

#[no_gc]
fn core(a: i32) -> i32 {
    return nogc_hot.mix(a, a + 1 as i32)
}

fn main() -> i32 {
    // runde(1) = 38, runde(2) = 69, mische(1,2) = 107
    let x = core(1 as i32)
    return x - 7 as i32
}
