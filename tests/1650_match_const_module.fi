// expect_exit: 42
// Round GAPS: named constants as `match` patterns across modules. A
// dispatch over named opcodes used to need an `if op == ...` chain (a bare
// name bound the value, `module.NAME` did not parse); a `match` with ten
// dense arms becomes a jump table (codegen_switch.rs).
import modules.opcodes

fn run(code: *u32, n: usize) -> i64 {
    var acc: i64 = 0
    var pc: usize = 0
    var steps: u32 = 0
    while pc < n && steps < 1000 {
        steps = steps + 1
        let op: u32 = *(((code as usize) + pc * 8) as *u32)
        let argw: u32 = *(((code as usize) + pc * 8 + 4) as *u32)
        let arg: i64 = argw as i64
        pc = pc + 1
        match op {
            opcodes.OP_HALT => { return acc }
            opcodes.OP_LOAD => { acc = arg }
            opcodes.OP_ADD => { acc = acc + arg }
            opcodes.OP_SUB => { acc = acc - arg }
            opcodes.OP_MUL => { acc = acc * arg }
            opcodes.OP_JMP => { pc = arg as usize }
            opcodes.OP_JF => { if acc == 0 { pc = arg as usize } }
            opcodes.OP_CALL => { acc = acc + 1000 }
            opcodes.OP_RET => { return acc + 7 }
            opcodes.OP_NOP => { }
            _ => { return -1 }
        }
    }
    return -2
}

fn main() -> i32 {
    // load 5; mul 8; nop; jmp 5; add 999 (skipped); sub 5; halt  -> 35
    var prog: [u32; 14] = [1, 5, 4, 8, 9, 0, 5, 5, 2, 999, 3, 5, 0, 0]
    let r: i64 = run((&prog[0]) as *u32, 7)
    if r != 35 {
        return 1
    }
    if opcodes.classify(2) != 1 || opcodes.classify(3) != 1 || opcodes.classify(5) != 2 {
        return 2
    }
    // not a constant: `other` binds
    if opcodes.classify(9) != 109 {
        return 3
    }
    return 42
}
