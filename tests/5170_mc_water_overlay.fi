// expect_exit: 0
import std.rt
import mc.mc_raster
import mc.mc_gui_tex
import mc.mc_water_overlay

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn px(r: *mut mc_raster.Raster, x: i32, y: i32) -> u32 {
    return rt.ld32((*r).color, (y as usize) * ((*r).w as usize) + (x as usize))
}

fn main() -> i32 {
    var t: mc_gui_tex.GuiTex = mc_gui_tex.gtex_empty()
    check(mc_gui_tex.gtex_blank(&t, 16, 16), 1)
    var i: i32 = 0
    while i < 256 {
        mc_gui_tex.gtex_set(&t, i % 16, i / 16, 0xFFFF0000 as u32)
        i = i + 1
    }
    var r: mc_raster.Raster = mc_raster.raster_new(128, 72)
    var k: usize = 0
    while k < 128 * 72 {
        rt.st32(r.color, k, 0xFF000000 as u32)
        k = k + 1
    }
    mc_water_overlay.wov_draw(&r, &t, 0.0, 0.0, 256)
    let c: u32 = px(&r, 64, 36)
    check(((c >> 16 as u32) & 255 as u32) > 5 as u32 && ((c >> 16 as u32) & 255 as u32) < 40 as u32, 2)
    check((c & 255 as u32) == 0 as u32, 3)
    var r2: mc_raster.Raster = mc_raster.raster_new(128, 72)
    k = 0
    while k < 128 * 72 {
        rt.st32(r2.color, k, 0xFF000000 as u32)
        k = k + 1
    }
    mc_water_overlay.wov_draw(&r2, &t, 90.0, 20.0, 20)
    let d: u32 = px(&r2, 10, 10)
    check(((d >> 16 as u32) & 255 as u32) < 4 as u32, 4)
    mc_gui_tex.gtex_free(&t)
    if g_fail == 0 { return 0 }
    return 1
}
