// expect_exit: 0
// tests/4321_str_slice_step_sugar.fi -- r744: `s[a:b:c]` on str/Span is a copying GC string (Python semantics).
import std.io
import std.rt
import std.vec
import std.str
import std.pystr
import std.testkit

#[no_inline]
fn rev(s: str) -> str {
    return s[::-1]
}

#[no_inline]
fn pick(s: str, a: i64, b: i64, c: i64) -> str {
    return s[a:b:c]
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let s: str = "hello world"
    testkit.check(s[::2] == "hlowrd", "every second")
    testkit.check(s[::-1] == "dlrow olleh", "reverse")
    testkit.check(rev("abc") == "cba", "reverse in a function")
    testkit.check(s[1:8:3] == "eoo", "range with step")
    testkit.check(s[-1:-5:-2] == "dr", "negative range, negative step")
    testkit.check(s[100::-4] == "dwl", "clamped start")
    testkit.check(s[5:2:1] == "", "empty")
    testkit.check(pick(s, 2, 9, 2) == "lowr", "variable bounds")
    let t: str = s[::1]
    testkit.check(t == s && t.p != s.p, "owning copy")
    let u: str = "abcdef"
    testkit.check(s[2:4:1] == "ll" && u[::3] == "ad", "positive steps")
    return testkit.finish()
}
