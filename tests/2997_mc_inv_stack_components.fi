// expect_exit: 0
// mc_inv 1.20.5+: every stack carries a signature of its component list and its max_stack_size component. Click prediction merges only
// stacks with the same components, respects the max_stack_size limit and moves signature + limit with a swapped stack.
// Return codes: 1xx = setup, 2xx = decoded signatures / limits, 3xx = click prediction, 4xx = Set Slot resets.
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_inv

fn put_window(b: *mut bytes.Bytes, p: i32, w: i32) {
    if p == 767 { bytes.put_u8(b, w as u8) } else { bytes.put_varint(b, w) }
}

// item stack with two components: max_stack_size (type 1) = mx, damage (type 3) = dmg
fn put_comp(b: *mut bytes.Bytes, item: i32, count: i32, mx: i32, dmg: i32) {
    bytes.put_varint(b, count)
    bytes.put_varint(b, item)
    bytes.put_varint(b, 2)
    bytes.put_varint(b, 0)
    bytes.put_varint(b, 1)
    bytes.put_varint(b, mx)
    bytes.put_varint(b, 3)
    bytes.put_varint(b, dmg)
}

fn put_plain(b: *mut bytes.Bytes, item: i32, count: i32) {
    bytes.put_varint(b, count)
    bytes.put_varint(b, item)
    bytes.put_varint(b, 0)
    bytes.put_varint(b, 0)
}

fn click(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    let ok: bool = mc_inv.inv_click_build(v, (*ver).protocol, slot, 0, 0, &b)
    bytes.bytes_free(&b)
    return ok
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    var b: bytes.Bytes = bytes.bytes_new()
    put_window(&b, p, 0)
    bytes.put_varint(&b, 5)
    bytes.put_varint(&b, 46)
    var i: i32 = 0
    while i < 46 {
        if i == 10 { put_comp(&b, 6, 10, 16, 0) }
        else if i == 11 { put_comp(&b, 6, 5, 16, 0) }
        else if i == 12 { put_plain(&b, 6, 5) }
        else if i == 13 { put_comp(&b, 6, 5, 16, 7) }
        else if i == 14 { put_comp(&b, 6, 14, 16, 0) }
        else if i == 15 { put_comp(&b, 6, 3, 99, 0) }
        else if i == 16 { put_comp(&b, 7, 60, 99, 0) }
        else if i == 17 { put_comp(&b, 7, 30, 99, 0) }
        else { bytes.put_varint(&b, 0) }
        i = i + 1
    }
    bytes.put_varint(&b, 0) // empty carried stack
    bytes.bytes_set_pos(&b, 0)
    if !mc_inv.inv_on_window_items_v(&v, &ver, &b) { return 101 }
    if v.bad != 0 as u32 { return 102 }
    let s: i32 = mc_inv.inv_sig(&v, 10)
    if s == 0 || mc_inv.inv_sig(&v, 11) != s || mc_inv.inv_sig(&v, 14) != s { return 201 }
    if mc_inv.inv_sig(&v, 12) != 0 || mc_inv.inv_max_stack(&v, 12) != 0 { return 202 }
    if mc_inv.inv_sig(&v, 13) == 0 || mc_inv.inv_sig(&v, 13) == s { return 203 }
    if mc_inv.inv_max_stack(&v, 10) != 16 || mc_inv.inv_max_stack(&v, 13) != 16 || mc_inv.inv_max_stack(&v, 15) != 99 { return 204 }
    if mc_inv.inv_sig(&v, 15) == s { return 205 }
    if mc_inv.inv_sig(&v, 20) != 0 || mc_inv.inv_max_stack(&v, 20) != 0 { return 206 }
    // pick up slot 10, put it on slot 11 (same components): merge 10 + 5 = 15 <= 16
    if !click(&v, &ver, 10) { return 300 }
    if mc_inv.inv_cursor_count(&v) != 10 || mc_inv.inv_cursor_sig(&v) != s || mc_inv.inv_item(&v, 10) != 0 - 1 { return 301 }
    if mc_inv.inv_sig(&v, 10) != 0 || mc_inv.inv_max_stack(&v, 10) != 0 { return 302 }
    if !click(&v, &ver, 11) { return 303 }
    if mc_inv.inv_count(&v, 11) != 15 || mc_inv.inv_cursor_item(&v) != 0 - 1 || mc_inv.inv_sig(&v, 11) != s { return 304 }
    // different components never merge: stack 11 (components) onto slot 12 (plain) swaps
    if !click(&v, &ver, 11) { return 305 }
    if !click(&v, &ver, 12) { return 306 }
    if mc_inv.inv_count(&v, 12) != 15 || mc_inv.inv_sig(&v, 12) != s || mc_inv.inv_max_stack(&v, 12) != 16 { return 307 }
    if mc_inv.inv_cursor_count(&v) != 5 || mc_inv.inv_cursor_sig(&v) != 0 || mc_inv.inv_item(&v, 11) != 0 - 1 { return 308 }
    // the carried plain stack on slot 13 (damage 7): swap, not merge
    if !click(&v, &ver, 13) { return 309 }
    if mc_inv.inv_count(&v, 13) != 5 || mc_inv.inv_sig(&v, 13) != 0 || mc_inv.inv_cursor_count(&v) != 5 || mc_inv.inv_cursor_sig(&v) == 0 { return 310 }
    if !click(&v, &ver, 20) { return 311 }
    if mc_inv.inv_count(&v, 20) != 5 || mc_inv.inv_max_stack(&v, 20) != 16 || mc_inv.inv_cursor_item(&v) != 0 - 1 { return 312 }
    // max_stack_size limit: 15 on top of 14 with limit 16 -> 16, 13 stay in hand
    if !click(&v, &ver, 12) { return 313 }
    if !click(&v, &ver, 14) { return 314 }
    if mc_inv.inv_count(&v, 14) != 16 || mc_inv.inv_cursor_count(&v) != 13 { return 315 }
    // other components (limit 99 instead of 16): swap, no merge
    if !click(&v, &ver, 15) { return 316 }
    if mc_inv.inv_count(&v, 15) != 13 || mc_inv.inv_cursor_count(&v) != 3 || mc_inv.inv_cursor_sig(&v) == s { return 317 }
    // a max_stack_size above the default 64 is honoured: 30 onto 60 -> 90
    if !click(&v, &ver, 17) { return 318 }
    if !click(&v, &ver, 16) { return 319 }
    if mc_inv.inv_count(&v, 16) != 90 { return 320 }
    // Set Slot overwrites signature + limit (plain stack) and clears them (empty)
    var t: bytes.Bytes = bytes.bytes_new()
    put_window(&t, p, 0)
    bytes.put_varint(&t, 6)
    bytes.put_i16(&t, 14 as i16)
    put_plain(&t, 6, 4)
    bytes.bytes_set_pos(&t, 0)
    if !mc_inv.inv_on_set_slot_v(&v, &ver, &t) { return 400 }
    if mc_inv.inv_count(&v, 14) != 4 || mc_inv.inv_sig(&v, 14) != 0 || mc_inv.inv_max_stack(&v, 14) != 0 { return 401 }
    var e: bytes.Bytes = bytes.bytes_new()
    put_window(&e, p, 0)
    bytes.put_varint(&e, 7)
    bytes.put_i16(&e, 12 as i16)
    bytes.put_varint(&e, 0)
    bytes.bytes_set_pos(&e, 0)
    if !mc_inv.inv_on_set_slot_v(&v, &ver, &e) { return 402 }
    if mc_inv.inv_item(&v, 12) != 0 - 1 || mc_inv.inv_sig(&v, 12) != 0 || mc_inv.inv_max_stack(&v, 12) != 0 { return 403 }
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    var r: i32 = check(767)
    if r != 0 { return 1000 + r }
    r = check(769)
    if r != 0 { return 2000 + r }
    r = check(772)
    if r != 0 { return 3000 + r }
    r = check(774)
    if r != 0 { return 4000 + r }
    r = check(775)
    if r != 0 { return 5000 + r }
    return 0
}
