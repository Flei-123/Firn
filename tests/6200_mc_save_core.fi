// expect_exit: 0
// tests/6200_mc_save_core.fi -- save core: BitStorage, LZ4 block stream (known answer), region with every compression, chunk codec.
// The comparison with real vanilla worlds is tools/mc/save/run.sh.
import std.rt
import std.bytes
import std.nbt
import mc.mc_anvil
import mc.mc_nbt
import mc.save.save_bits
import mc.save.save_lz4
import mc.save.save_chunk

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn hexval(c: u8) -> u8 {
    if c >= 97 as u8 {
        return c - 87 as u8
    }
    return c - 48 as u8
}

fn bits_case(bits: usize, count: usize) -> bool {
    var idx: rt.Buf = rt.buf_new()
    rt.buf_reserve(&idx, count * 2)
    idx.len = count * 2
    var i: usize = 0
    let mask: usize = ((1 as usize) << bits) - 1
    while i < count {
        rt.st16(idx.ptr, i, ((i * 2654435761) & mask) as u16)
        i = i + 1
    }
    var packed: rt.Buf = rt.buf_new()
    let n: usize = save_bits.bits_pack(idx.ptr, count, bits, &packed)
    var back: rt.Buf = rt.buf_new()
    rt.buf_reserve(&back, count * 2)
    back.len = count * 2
    let ok: bool = save_bits.bits_unpack(packed.ptr, n, bits, count, back.ptr)
    let same: bool = ok && rt.mem_eq(idx.ptr, back.ptr, count * 2)
    rt.buf_free(&idx)
    rt.buf_free(&packed)
    rt.buf_free(&back)
    return same
}

fn main() -> i32 {
    var b: usize = 1
    while b <= 16 {
        check(bits_case(b, 4096), 1)
        check(bits_case(b, 64), 2)
        b = b + 1
    }
    check(save_bits.bits_for_palette(1) == 0 && save_bits.bits_for_palette(2) == 1 && save_bits.bits_for_palette(17) == 5, 3)
    check(save_bits.bits_long_count(4096, 4) == 256 && save_bits.bits_long_count(4096, 5) == 342, 4)

    let hex: str = "4c5a34426c6f636b26090000001f000000c5d923043f61626303000810584c5a34426c6f636b160c0000000c000000fd92a50068656c6c6f20726567696f6e4c5a34426c6f636b16000000000000000000000000"
    var fixture: rt.Buf = rt.buf_new()
    var h: usize = 0
    while h < hex.n {
        rt.buf_push(&fixture, (hexval(rt.ld8(hex.p as u64, h)) << (4 as u8)) | hexval(rt.ld8(hex.p as u64, h + 1)))
        h = h + 2
    }
    var plain: rt.Buf = rt.buf_new()
    let got: usize = save_lz4.lz4s_decompress(fixture.ptr, fixture.len, 1000, &plain) catch 99999999999
    check(got == 43, 5)
    check(rt.mem_eq(plain.ptr, "abcabcabcabcabcabcabcabcabcabcXhello region".p as u64, 43), 6)
    var damaged: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&damaged, fixture.ptr, fixture.len)
    rt.st8(damaged.ptr, 40, rt.ld8(damaged.ptr, 40) ^ (1 as u8))
    var junk: rt.Buf = rt.buf_new()
    check((save_lz4.lz4s_decompress(damaged.ptr, damaged.len, 1000, &junk) catch 99999999999) == 99999999999, 7)

    var big: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 200000 {
        rt.buf_push(&big, ((i * 7 + (i >> 5)) & 255) as u8)
        i = i + 1
    }
    var packed: rt.Buf = rt.buf_new()
    let pn: usize = save_lz4.lz4s_compress(big.ptr, big.len, &packed)
    var round: rt.Buf = rt.buf_new()
    let rn: usize = save_lz4.lz4s_decompress(packed.ptr, pn, 400000, &round) catch 99999999999
    check(rn == 200000 && rt.mem_eq(round.ptr, big.ptr, 200000), 8)

    var r: mc_anvil.Region = mc_anvil.region_new()
    var ct: u8 = 1
    while ct <= 4 {
        let w: bool = mc_anvil.region_write(&r, ct as i32, 0 - (ct as i32), big.ptr, 9000 * (ct as usize), ct, 100 as u32) catch false
        check(w, 9)
        ct = ct + 1 as u8
    }
    check((mc_anvil.region_check(&r) catch 99999999999) == 4, 10)
    ct = 1
    while ct <= 4 {
        var out: rt.Buf = rt.buf_new()
        let n: usize = mc_anvil.region_read(&r, ct as i32, 0 - (ct as i32), &out) catch 99999999999
        check(n == 9000 * (ct as usize) && rt.mem_eq(out.ptr, big.ptr, n), 11)
        ct = ct + 1 as u8
    }
    let ext: bool = mc_anvil.region_mark_external(&r, 9, 9, 2 as u8, 5 as u32) catch false
    check(ext, 12)
    var o2: rt.Buf = rt.buf_new()
    check((mc_anvil.region_read(&r, 9, 9, &o2) catch 99999999999) == 99999999999, 13)
    check((mc_anvil.region_check(&r) catch 99999999999) == 5, 14)

    var nb: bytes.Bytes = bytes.bytes_new()
    nbt.nbt_root_begin(&nb, "".p as u64, 0)
    nbt.nbt_int(&nb, "DataVersion".p as u64, 11, 3465)
    nbt.nbt_int(&nb, "xPos".p as u64, 4, 3)
    nbt.nbt_int(&nb, "zPos".p as u64, 4, 0 - 5)
    nbt.nbt_string(&nb, "Status".p as u64, 6, "minecraft:full".p as u64, 14)
    nbt.nbt_list_open(&nb, "sections".p as u64, 8, 10 as u8, 1)
    nbt.nbt_byte(&nb, "Y".p as u64, 1, 2 as i8)
    var idx: rt.Buf = rt.buf_new()
    rt.buf_reserve(&idx, 8192)
    idx.len = 8192
    i = 0
    while i < 4096 {
        rt.st16(idx.ptr, i, ((i / 37) % 5) as u16)
        i = i + 1
    }
    save_chunk.write_block_states(&nb, "minecraft:air\nminecraft:stone\nminecraft:dirt\nminecraft:water\nminecraft:glass", 5, idx.ptr)
    var bio: rt.Buf = rt.buf_new()
    rt.buf_reserve(&bio, 128)
    bio.len = 128
    i = 0
    while i < 64 {
        rt.st16(bio.ptr, i, (i % 2) as u16)
        i = i + 1
    }
    save_chunk.write_biomes(&nb, "minecraft:plains\nminecraft:desert", 2, bio.ptr)
    nbt.nbt_end(&nb)
    nbt.nbt_end(&nb)
    nbt.nbt_end(&nb)
    var ch: save_chunk.Chunk = save_chunk.Chunk { doc: mc_nbt.doc_new(), level: 0 as u32, legacy: false }
    check(save_chunk.chunk_open(&ch, bytes.bytes_ptr(&nb), bytes.bytes_len(&nb)) catch false, 15)
    var cx: i32 = 0
    var cz: i32 = 0
    save_chunk.chunk_pos(&ch, &cx, &cz)
    check(cx == 3 && cz == 0 - 5 && save_chunk.chunk_data_version(&ch) == 3465, 16)
    check(save_chunk.chunk_section_count(&ch) == 1, 17)
    let sec: u32 = save_chunk.chunk_section(&ch, 0 as u32)
    check(save_chunk.chunk_section_y(&ch, sec) == 2, 18)
    var back: rt.Buf = rt.buf_new()
    rt.buf_reserve(&back, 8192)
    back.len = 8192
    check(save_chunk.section_blocks(&ch, sec, back.ptr) catch false, 19)
    check(rt.mem_eq(back.ptr, idx.ptr, 8192), 20)
    check(save_chunk.section_blocks_repack_equal(&ch, sec, back.ptr), 21)
    var nl: usize = 0
    let np: u64 = save_chunk.section_block_name(&ch, sec, 3 as u32, &nl)
    check(nl == 15 && rt.mem_eq(np, "minecraft:water".p as u64, 15), 22)
    var bb: rt.Buf = rt.buf_new()
    rt.buf_reserve(&bb, 128)
    bb.len = 128
    check(save_chunk.section_biomes(&ch, sec, bb.ptr) catch false, 23)
    check(rt.mem_eq(bb.ptr, bio.ptr, 128), 24)
    check(save_chunk.section_biomes_repack_equal(&ch, sec, bb.ptr), 25)
    save_chunk.chunk_close(&ch)
    check(!(save_chunk.chunk_open(&ch, bytes.bytes_ptr(&nb), 40) catch false), 26)
    return 0
}
