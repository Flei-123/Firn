// expect_exit: 0
// tests/3940_mc_model.fi -- resource pack blockstates + models (lib/mc/mc_model.fi): variants (partial keys, any property order, weighted
// lists), multipart (when / OR / AND / "a|b"), parent chain + #texture references, element rotation, face rotation, variant x / y rotation
// of quads + cullfaces, uvlock, pack priority, built-in own parents, garbage input. Packs are built in-process from own JSON.
import std.rt
import zip.zip
import mc.mc_assets
import mc.mc_model

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0001
}

fn add(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    var ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

// finishes the ZIP in `b` and pushes it as the next (lower priority) pack of `st`
fn push_pack(st: *mut mc_assets.PackStack, w: *mut zip.ZipWriter, b: *mut rt.Buf) -> bool {
    var n: usize = zip.zip_finish(w) catch | e | (0)
    zip.zip_writer_free(w)
    if n == 0 { return false }
    var p: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&p, rt.buf_ptr(b), rt.buf_len(b)) != mc_assets.ASSET_OK { return false }
    rt.buf_free(b)
    return mc_assets.stack_push(st, &p) == mc_assets.ASSET_OK
}

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"
const M: str = "assets/minecraft/models/block/"
const S: str = "assets/minecraft/blockstates/"

fn q(b: *mut mc_model.Baked, i: usize, k: usize) -> f64 { return mc_model.baked_f(b, i, k) }

fn tex_is(b: *mut mc_model.Baked, i: usize, s: str) -> bool {
    var nm: mc_model.Name = mc_model.name_new()
    if !mc_model.baked_tex_name(b, q(b, i, mc_model.W_TEX) as usize, &nm) { return false }
    return mc_model.name_str_eq(&nm, s)
}

fn build_a(st: *mut mc_assets.PackStack) -> bool {
    var b: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&b)
    if !add(&w, "pack.mcmeta", META) { return false }
    // models
    if !add(&w, "assets/minecraft/models/block/t_all.json", "{\"parent\":\"block/cube_all\",\"textures\":{\"all\":\"block/stone\"}}") { return false }
    if !add(&w, "assets/minecraft/models/block/t_slab_b.json", "{\"parent\":\"block/slab\",\"textures\":{\"bottom\":\"minecraft:block/sb\",\"top\":\"#side\",\"side\":\"#s2\",\"s2\":\"block/ss\"}}") { return false }
    if !add(&w, "assets/minecraft/models/block/t_slab_t.json", "{\"parent\":\"block/slab_top\",\"textures\":{\"bottom\":\"block/sb\",\"top\":\"block/st\",\"side\":\"block/ss\"}}") { return false }
    if !add(&w, "assets/minecraft/models/block/t_a.json", "{\"parent\":\"block/t_all\",\"textures\":{\"all\":\"block/a\"}}") { return false }
    if !add(&w, "assets/minecraft/models/block/t_b.json", "{\"parent\":\"block/t_all\",\"textures\":{\"all\":\"block/b\"}}") { return false }
    // one north face only (cullface north), full cube: for the x / y rotation tests
    if !add(&w, "assets/minecraft/models/block/t_north.json", "{\"textures\":{\"t\":\"block/n\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"north\":{\"texture\":\"#t\",\"cullface\":\"north\",\"tintindex\":2}}}]}") { return false }
    // one up face only: face rotation, uvlock
    if !add(&w, "assets/minecraft/models/block/t_up.json", "{\"textures\":{\"t\":\"block/u\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"up\":{\"texture\":\"#t\"}}}]}") { return false }
    if !add(&w, "assets/minecraft/models/block/t_up_r90.json", "{\"textures\":{\"t\":\"block/u\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"faces\":{\"up\":{\"texture\":\"#t\",\"rotation\":90}}}]}") { return false }
    // child with own elements wins over the parent's; unresolved texture -> missingno
    if !add(&w, "assets/minecraft/models/block/t_child.json", "{\"parent\":\"block/t_all\",\"elements\":[{\"from\":[4,0,4],\"to\":[12,8,12],\"faces\":{\"up\":{\"texture\":\"#nope\"},\"down\":{\"texture\":\"#all\",\"uv\":[0,0,8,8]}}}]}") { return false }
    // blockstates
    if !add(&w, "assets/minecraft/blockstates/t_slab.json", "{\"variants\":{\"type=bottom\":{\"model\":\"minecraft:block/t_slab_b\"},\"type=top\":{\"model\":\"block/t_slab_t\"},\"facing=north,half=top\":{\"model\":\"block/t_north\",\"x\":180,\"y\":90,\"uvlock\":true}}}") { return false }
    if !add(&w, "assets/minecraft/blockstates/t_weighted.json", "{\"variants\":{\"\":[{\"model\":\"block/t_a\"},{\"model\":\"block/t_b\",\"weight\":3}]}}") { return false }
    if !add(&w, "assets/minecraft/blockstates/t_fence.json", "{\"multipart\":[{\"apply\":{\"model\":\"block/t_all\"}},{\"when\":{\"north\":\"true\"},\"apply\":{\"model\":\"block/t_a\"}},{\"when\":{\"OR\":[{\"east\":\"true\"},{\"west\":\"true\"}]},\"apply\":{\"model\":\"block/t_b\",\"y\":90}},{\"when\":{\"AND\":[{\"axis\":\"x|z\"},{\"waterlogged\":\"false\"}]},\"apply\":[{\"model\":\"block/t_up\"}]}]}") { return false }
    if !add(&w, "assets/minecraft/blockstates/t_rot.json", "{\"variants\":{\"\":{\"model\":\"block/t_north\",\"y\":90}}}") { return false }
    if !add(&w, "assets/minecraft/blockstates/t_rotx.json", "{\"variants\":{\"\":{\"model\":\"block/t_north\",\"x\":90}}}") { return false }
    if !add(&w, "assets/minecraft/blockstates/t_lock.json", "{\"variants\":{\"a=1\":{\"model\":\"block/t_up\",\"y\":90},\"a=2\":{\"model\":\"block/t_up\",\"y\":90,\"uvlock\":true}}}") { return false }
    if !add(&w, "assets/minecraft/blockstates/t_bad.json", "{\"variants\":{\"\":{\"model\":\"block/missing_model\"}}}") { return false }
    if !add(&w, "assets/minecraft/blockstates/t_garbage.json", "{\"variants\":{\"\":{\"model\":") { return false }
    return push_pack(st, &w, &b)
}

// second (lower priority) pack: a model the first pack also has (loses) and one only it has
fn build_b(st: *mut mc_assets.PackStack) -> bool {
    var b: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&b)
    if !add(&w, "pack.mcmeta", META) { return false }
    if !add(&w, "assets/minecraft/models/block/t_a.json", "{\"parent\":\"block/t_all\",\"textures\":{\"all\":\"block/LOSES\"}}") { return false }
    if !add(&w, "assets/minecraft/models/block/t_only_b.json", "{\"parent\":\"block/cube_column\",\"textures\":{\"side\":\"block/cs\",\"end\":\"block/ce\"}}") { return false }
    return push_pack(st, &w, &b)
}

fn build_c(st: *mut mc_assets.PackStack) -> bool {
    var b: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&b)
    if !add(&w, "pack.mcmeta", META) { return false }
    if !add(&w, "assets/minecraft/models/block/t_cross.json", "{\"parent\":\"block/cross\",\"textures\":{\"cross\":\"block/flower\"}}") { return false }
    return push_pack(st, &w, &b)
}

fn main() -> i32 {
    var st: mc_assets.PackStack = mc_assets.stack_new()
    if !build_a(&st) { return 1 }
    if !build_b(&st) { return 2 }

    // ---- 1. cube_all through two parents: 6 quads, one texture, default UV, cullfaces down up north south west east
    var b: mc_model.Baked = mc_model.baked_new()
    if mc_model.model_bake(&st, "block/t_all", 0, 0, false, &b) != 6 { return 10 }
    if mc_model.baked_tex_count(&b) != 1 || !tex_is(&b, 0, "block/stone") { return 11 }
    var i: usize = 0
    while i < 6 {
        if !near(q(&b, i, mc_model.W_CULL), i as f64) || !near(q(&b, i, mc_model.W_DIR), i as f64) { return 12 }
        if !near(q(&b, i, mc_model.W_SHADE), 1.0) || !near(q(&b, i, mc_model.W_TINT), 0.0 - 1.0) { return 13 }
        i = i + 1
    }
    // up face: corner 0 = (0,1,0) uv (0,0); corner 2 = (1,1,1) uv (16,16)
    if !near(q(&b, 1, mc_model.X0), 0.0) || !near(q(&b, 1, mc_model.Y0), 1.0) || !near(q(&b, 1, mc_model.Z0), 0.0) { return 14 }
    if !near(q(&b, 1, mc_model.U0), 0.0) || !near(q(&b, 1, mc_model.V0), 0.0) { return 15 }
    if !near(q(&b, 1, mc_model.X0 + 2), 1.0) || !near(q(&b, 1, mc_model.Z0 + 2), 1.0) { return 16 }
    if !near(q(&b, 1, mc_model.U0 + 2), 16.0) || !near(q(&b, 1, mc_model.V0 + 2), 16.0) { return 17 }
    // north face: corner 0 = (1,1,0), uv (0,0); corner 1 = (1,0,0), uv (0,16)
    if !near(q(&b, 2, mc_model.X0), 1.0) || !near(q(&b, 2, mc_model.Y0), 1.0) || !near(q(&b, 2, mc_model.Z0), 0.0) { return 18 }
    if !near(q(&b, 2, mc_model.V0 + 1), 16.0) || !near(q(&b, 2, mc_model.U0 + 1), 0.0) { return 19 }
    mc_model.baked_free(&b)

    // ---- 2. slabs by blockstate: bottom half (y <= 0.5), side UV [0,8,16,16], up has no cullface; texture variable chain #side -> #s2 -> block/ss
    var sel: mc_model.Selection = mc_model.selection_new()
    if mc_model.blockstate_select(&st, "t_slab", "type=bottom,waterlogged=false", 0 as u32, &sel) != 1 { return 20 }
    if !mc_model.name_str_eq(&sel.p[0].name, "block/t_slab_b") { return 21 }
    b = mc_model.baked_new()
    if mc_model.blockstate_bake(&st, "t_slab", "waterlogged=false,type=bottom", 0 as u32, &b) != 6 { return 22 }
    i = 0
    while i < 6 {
        var c: usize = 0
        while c < 4 {
            if q(&b, i, mc_model.Y0 + c) > 0.5001 { return 23 }
            c = c + 1
        }
        i = i + 1
    }
    if !near(q(&b, 1, mc_model.W_CULL), 0.0 - 1.0) || !near(q(&b, 2, mc_model.W_CULL), 2.0) { return 24 }
    if !near(q(&b, 2, mc_model.V0), 8.0) || !near(q(&b, 2, mc_model.V0 + 1), 16.0) { return 25 }
    if !tex_is(&b, 0, "block/sb") || !tex_is(&b, 1, "block/ss") || !tex_is(&b, 2, "block/ss") { return 26 }
    if mc_model.baked_tex_count(&b) != 2 { return 27 }
    mc_model.baked_free(&b)
    b = mc_model.baked_new()
    if mc_model.blockstate_bake(&st, "t_slab", "type=top", 0 as u32, &b) != 6 { return 28 }
    if !near(q(&b, 0, mc_model.Y0), 0.5) || !near(q(&b, 1, mc_model.Y0), 1.0) { return 29 }
    mc_model.baked_free(&b)
    // no key matches -> 0 parts; missing file -> -1; broken JSON -> -1; model missing -> 0 quads
    if mc_model.blockstate_select(&st, "t_slab", "type=double", 0 as u32, &sel) != 0 { return 30 }
    if mc_model.blockstate_select(&st, "nope", "", 0 as u32, &sel) != 0 - 1 { return 31 }
    if mc_model.blockstate_select(&st, "t_garbage", "", 0 as u32, &sel) != 0 - 1 { return 32 }
    b = mc_model.baked_new()
    if mc_model.blockstate_bake(&st, "t_bad", "", 0 as u32, &b) != 0 || mc_model.baked_count(&b) != 0 { return 33 }
    if mc_model.model_bake(&st, "block/nothing_here", 0, 0, false, &b) != 0 - 1 { return 34 }
    mc_model.baked_free(&b)
    // two-property key, any order
    if mc_model.blockstate_select(&st, "t_slab", "half=top,facing=north", 0 as u32, &sel) != 1 { return 35 }
    if sel.p[0].rx != 180 || sel.p[0].ry != 90 || !sel.p[0].uvlock { return 36 }
    if mc_model.blockstate_select(&st, "t_slab", "half=top", 0 as u32, &sel) != 0 { return 37 }

    // ---- 3. weighted list: weights 1 + 3 -> seed % 4 == 0 picks A, else B; priority: pack A's t_a wins over pack B's
    var na: i32 = 0
    var nb: i32 = 0
    var seed: u32 = 0 as u32
    while seed < (8 as u32) {
        if mc_model.blockstate_select(&st, "t_weighted", "", seed, &sel) != 1 { return 40 }
        if mc_model.name_str_eq(&sel.p[0].name, "block/t_a") { na = na + 1 }
        if mc_model.name_str_eq(&sel.p[0].name, "block/t_b") { nb = nb + 1 }
        seed = seed + (1 as u32)
    }
    if na != 2 || nb != 6 { return 41 }
    b = mc_model.baked_new()
    mc_model.model_bake(&st, "block/t_a", 0, 0, false, &b)
    if !tex_is(&b, 0, "block/a") { return 42 }
    mc_model.baked_free(&b)
    b = mc_model.baked_new()
    if mc_model.model_bake(&st, "block/t_only_b", 0, 0, false, &b) != 6 { return 43 }
    if !tex_is(&b, 0, "block/ce") || !tex_is(&b, 2, "block/cs") { return 44 }
    mc_model.baked_free(&b)

    // ---- 4. multipart: always the post; north=true adds t_a; east|west adds t_b (y 90); axis x|z AND waterlogged=false adds the list
    if mc_model.blockstate_select(&st, "t_fence", "north=false,east=false,west=false,axis=y,waterlogged=false", 0 as u32, &sel) != 1 { return 50 }
    if mc_model.blockstate_select(&st, "t_fence", "north=true,east=false,west=false,axis=y,waterlogged=false", 0 as u32, &sel) != 2 { return 51 }
    if !mc_model.name_str_eq(&sel.p[1].name, "block/t_a") { return 52 }
    if mc_model.blockstate_select(&st, "t_fence", "north=false,east=true,west=false,axis=x,waterlogged=false", 0 as u32, &sel) != 3 { return 53 }
    if sel.p[1].ry != 90 || !mc_model.name_str_eq(&sel.p[2].name, "block/t_up") { return 54 }
    if mc_model.blockstate_select(&st, "t_fence", "north=true,east=true,west=true,axis=z,waterlogged=true", 0 as u32, &sel) != 3 { return 55 }
    b = mc_model.baked_new()
    if mc_model.blockstate_bake(&st, "t_fence", "north=true,east=false,west=true,axis=x,waterlogged=false", 0 as u32, &b) != 6 + 6 + 6 + 1 { return 56 }
    mc_model.baked_free(&b)

    // ---- 5. variant rotation of quads and cullfaces. t_north = one north face, cullface north, tintindex 2
    b = mc_model.baked_new()
    if mc_model.blockstate_bake(&st, "t_rot", "", 0 as u32, &b) != 1 { return 60 }
    // y = 90: north -> east; corner 0 (1,1,0) -> (1,1,1)
    if !near(q(&b, 0, mc_model.W_DIR), 5.0) || !near(q(&b, 0, mc_model.W_CULL), 5.0) || !near(q(&b, 0, mc_model.W_TINT), 2.0) { return 61 }
    if !near(q(&b, 0, mc_model.X0), 1.0) || !near(q(&b, 0, mc_model.Y0), 1.0) || !near(q(&b, 0, mc_model.Z0), 1.0) { return 62 }
    if !near(q(&b, 0, mc_model.Z0 + 2), 0.0) { return 63 }
    mc_model.baked_free(&b)
    b = mc_model.baked_new()
    if mc_model.blockstate_bake(&st, "t_rotx", "", 0 as u32, &b) != 1 { return 64 }
    // x = 90: north -> down; corner 0 (1,1,0) -> (1,0,0)
    if !near(q(&b, 0, mc_model.W_DIR), 0.0) || !near(q(&b, 0, mc_model.W_CULL), 0.0) { return 65 }
    if !near(q(&b, 0, mc_model.X0), 1.0) || !near(q(&b, 0, mc_model.Y0), 0.0) || !near(q(&b, 0, mc_model.Z0), 0.0) { return 66 }
    mc_model.baked_free(&b)
    // four y quarter turns come back to the start; 360 and -90 are normalised
    b = mc_model.baked_new()
    mc_model.model_bake(&st, "block/t_north", 0, 360, false, &b)
    mc_model.model_bake(&st, "block/t_north", 0, 0 - 90, false, &b)
    if !near(q(&b, 0, mc_model.W_DIR), 2.0) || !near(q(&b, 0, mc_model.X0), 1.0) || !near(q(&b, 0, mc_model.Z0), 0.0) { return 67 }
    if !near(q(&b, 1, mc_model.W_DIR), 4.0) { return 68 }
    mc_model.baked_free(&b)

    // ---- 6. uvlock: up face, y = 90. Without: UV turns with the block (corner 0 = (0,0)); with: UV stays on the world axes -> corner 0 at (16, 0)
    b = mc_model.baked_new()
    mc_model.blockstate_bake(&st, "t_lock", "a=1", 0 as u32, &b)
    if !near(q(&b, 0, mc_model.U0), 0.0) || !near(q(&b, 0, mc_model.V0), 0.0) { return 70 }
    if !near(q(&b, 0, mc_model.X0), 1.0) || !near(q(&b, 0, mc_model.Z0), 0.0) { return 71 }
    mc_model.baked_free(&b)
    b = mc_model.baked_new()
    mc_model.blockstate_bake(&st, "t_lock", "a=2", 0 as u32, &b)
    var c: usize = 0
    while c < 4 {
        // the UV of every corner = (x, z) of its position (the unrotated "up" projection)
        if !near(q(&b, 0, mc_model.U0 + c), q(&b, 0, mc_model.X0 + c) * 16.0) { return 72 }
        if !near(q(&b, 0, mc_model.V0 + c), q(&b, 0, mc_model.Z0 + c) * 16.0) { return 73 }
        c = c + 1
    }
    mc_model.baked_free(&b)

    // ---- 7. face rotation 90: corner i takes the UV of corner i + 1 (corner 0 -> (0,16), corner 1 -> (16,16))
    b = mc_model.baked_new()
    mc_model.model_bake(&st, "block/t_up_r90", 0, 0, false, &b)
    if !near(q(&b, 0, mc_model.U0), 0.0) || !near(q(&b, 0, mc_model.V0), 16.0) { return 80 }
    if !near(q(&b, 0, mc_model.U0 + 1), 16.0) || !near(q(&b, 0, mc_model.V0 + 1), 16.0) { return 81 }
    mc_model.baked_free(&b)

    // ---- 8. child elements win; "#nope" -> missingno; explicit uv; default uv of a partial box (up of [4,_,4]-[12,_,12] = [4,4,12,12])
    b = mc_model.baked_new()
    if mc_model.model_bake(&st, "block/t_child", 0, 0, false, &b) != 2 { return 90 }
    if !tex_is(&b, 0, "block/stone") || !tex_is(&b, 1, "missingno") { return 91 }
    // quad order = face order: down first, then up
    if !near(q(&b, 0, mc_model.U0 + 2), 8.0) || !near(q(&b, 0, mc_model.V0 + 2), 8.0) { return 92 }
    if !near(q(&b, 1, mc_model.U0), 4.0) || !near(q(&b, 1, mc_model.V0), 4.0) || !near(q(&b, 1, mc_model.X0), 0.25) { return 93 }
    mc_model.baked_free(&b)

    // ---- 9. element rotation: the built-in cross (45 degrees, rescale) -> 4 quads on the diagonals, no cullface, no shade
    if !build_c(&st) { return 101 }
    b = mc_model.baked_new()
    if mc_model.model_bake(&st, "block/t_cross", 0, 0, false, &b) != 4 { return 104 }
    if !tex_is(&b, 0, "block/flower") { return 105 }
    // quad 0 = first element, north face: corner 0 (15.2, 16, 8) rotated -> (15.2, 16, 0.8)
    if !near(q(&b, 0, mc_model.X0), 0.95) || !near(q(&b, 0, mc_model.Y0), 1.0) || !near(q(&b, 0, mc_model.Z0), 0.05) { return 106 }
    if !near(q(&b, 0, mc_model.W_CULL), 0.0 - 1.0) || !near(q(&b, 0, mc_model.W_SHADE), 0.0) { return 107 }
    mc_model.baked_free(&b)

    // ---- 10. built-in parents without any pack file: stairs (2 elements, 6 + 5 faces), column, bottom_top
    var empty: mc_assets.PackStack = mc_assets.stack_new()
    b = mc_model.baked_new()
    if mc_model.model_bake(&empty, "block/stairs", 0, 0, false, &b) != 11 { return 110 }
    mc_model.baked_free(&b)
    b = mc_model.baked_new()
    if mc_model.model_bake(&empty, "block/cube_bottom_top", 0, 0, false, &b) != 6 { return 111 }
    mc_model.baked_free(&b)

    // ---- 11. garbage never crashes: every prefix of a valid blockstate + model, and random bytes
    var big: rt.Buf = rt.buf_new()
    var zz: zip.ZipWriter = zip.zip_writer_new(&big)
    if !add(&zz, "pack.mcmeta", META) { return 120 }
    let good: str = "{\"parent\":\"block/cube_all\",\"textures\":{\"all\":\"#all\"},\"elements\":[{\"from\":[0,0,0],\"to\":[16,16,16],\"rotation\":{\"origin\":[8,8,8],\"axis\":\"q\",\"angle\":1e999},\"faces\":{\"up\":{\"texture\":3,\"uv\":[1,2],\"rotation\":\"x\",\"cullface\":7},\"down\":{\"uv\":[0,0,0,0]},\"north\":5}}]}"
    var cut: usize = 7
    var survived: bool = true
    while cut < good.length() && survived {
        var gb: rt.Buf = rt.buf_new()
        var gz: zip.ZipWriter = zip.zip_writer_new(&gb)
        if !add(&gz, "pack.mcmeta", META) { return 121 }
        var one: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&one, good.p as u64, cut)
        var okz: bool = zip.zip_add(&gz, "assets/minecraft/models/block/g.json", rt.buf_ptr(&one), rt.buf_len(&one), true) catch | e | (false)
        rt.buf_free(&one)
        if !okz { return 122 }
        var gs: mc_assets.PackStack = mc_assets.stack_new()
        if !push_pack(&gs, &gz, &gb) { return 123 }
        var gbk: mc_model.Baked = mc_model.baked_new()
        mc_model.model_bake(&gs, "block/g", 90, 270, true, &gbk)
        mc_model.baked_free(&gbk)
        mc_assets.stack_free(&gs)
        cut = cut + 7
    }
    // the complete odd model parses without crash as well (unknown axis, huge angle, wrong types)
    var gb2: rt.Buf = rt.buf_new()
    var gz2: zip.ZipWriter = zip.zip_writer_new(&gb2)
    if !add(&gz2, "pack.mcmeta", META) { return 124 }
    if !add(&gz2, "assets/minecraft/models/block/g.json", good) { return 125 }
    var gs2: mc_assets.PackStack = mc_assets.stack_new()
    if !push_pack(&gs2, &gz2, &gb2) { return 126 }
    var gbk2: mc_model.Baked = mc_model.baked_new()
    mc_model.model_bake(&gs2, "block/g", 0, 0, false, &gbk2)
    mc_model.baked_free(&gbk2)
    mc_assets.stack_free(&gs2)
    rt.buf_free(&big)
    zip.zip_writer_free(&zz)

    mc_assets.stack_free(&st)
    mc_assets.stack_free(&empty)
    return 0
}
