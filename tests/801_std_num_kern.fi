// expect_out: z | basis36 1295 gelesen 2 neg -42 |     420000-7 | 0.30000000000000004 | ziffern 4 runde 1 ueberlauf 1
// tests/801_std_num_kern.fi — Zahl <-> Text in `std.num` (Runde 42).
//
// Die drei Richtungen der Fassade an ihren Raendern:
//   schreibe_*   Zahl -> Text, angehaengt (Basis 2..36, Auffuellen, i64::MIN)
//   lies_*       Text -> Zahl, mit der Zahl der verbrauchten Oktette
//   text_zu_*    streng: der GANZE Text oder `false`
//
// Wichtig sind die Raender: u64::MAX geht, u64::MAX+1 wird als UEBERLAUF
// gemeldet statt umzubrechen; i64::MIN geht in beide Richtungen, obwohl sein
// Betrag nicht in i64 passt. Gleitkomma laeuft ueber die exakten Kerne
// (dtoa/strtod) — hier wird die Huelle geprueft, nicht die Rundung.
import std.io
import std.num

fn zeig(b: *mut num.Bytes) {
    io.print((*b).ptr as u64, (*b).len)
}

fn main() -> i32 {
    var b: num.Bytes = num.Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0 }

    // --- Zahl -> Text
    num.schreibe_u64(&b, 0)
    num.schreibe_u64(&b, 1234567890)
    if num.bytes_len(&b) != 11 {
        return 10
    }
    num.bytes_clear(&b)
    num.schreibe_u64(&b, num.u64_max())
    if num.bytes_len(&b) != 20 {
        return 11
    }
    num.bytes_clear(&b)
    num.schreibe_i64(&b, num.i64_min())
    if num.bytes_len(&b) != 20 || num.bytes_at(&b, 0) != 45 as u8 {
        return 12
    }
    num.bytes_clear(&b)
    num.schreibe_hex(&b, 48879, 6)
    if num.bytes_len(&b) != 6 || num.bytes_at(&b, 0) != 48 as u8 {
        return 13
    }
    num.bytes_clear(&b)
    num.schreibe_hex_gross(&b, 48879, 0)
    if num.bytes_len(&b) != 4 || num.bytes_at(&b, 0) != 66 as u8 {
        return 14
    }
    num.bytes_clear(&b)
    num.schreibe_binaer(&b, 5, 8)
    if num.bytes_len(&b) != 8 || num.bytes_at(&b, 7) != 49 as u8 {
        return 15
    }
    num.bytes_clear(&b)
    num.schreibe_oktal(&b, 8, 0)
    if num.bytes_len(&b) != 2 {
        return 16
    }
    num.bytes_clear(&b)
    num.schreibe_basis(&b, 35, 36, false)
    if num.bytes_len(&b) != 1 || num.bytes_at(&b, 0) != 122 as u8 {
        return 17
    }
    if num.ziffernzahl(0, 10) != 1 || num.ziffernzahl(999, 10) != 3 {
        return 18
    }
    if num.ziffernzahl(255, 16) != 2 {
        return 19
    }

    var tab: num.Bytes = num.Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0 }
    num.schreibe_breit_u64(&tab, 42, 6, 32 as u8)
    num.schreibe_breit_i64(&tab, 0 - 7, 6, 48 as u8)
    if num.bytes_len(&tab) != 12 {
        return 20
    }
    if num.bytes_at(&tab, 6) != 48 as u8 || num.bytes_at(&tab, 10) != 45 as u8 {
        return 21
    }

    // --- Text -> Zahl, streng
    var t_max: [u8; 21] = "18446744073709551615\0"
    var t_ueber: [u8; 21] = "18446744073709551616\0"
    var t_min: [u8; 21] = "-9223372036854775808\0"
    var t_unter: [u8; 21] = "-9223372036854775809\0"
    var w: u64 = 0
    var v: i64 = 0
    if !num.text_zu_u64((&t_max[0]) as *mut u8, 20, &w) || w != num.u64_max() {
        return 30
    }
    if num.text_zu_u64((&t_ueber[0]) as *mut u8, 20, &w) {
        return 31
    }
    if !num.text_zu_i64((&t_min[0]) as *mut u8, 20, &v) || v != num.i64_min() {
        return 32
    }
    if num.text_zu_i64((&t_unter[0]) as *mut u8, 20, &v) {
        return 33
    }
    var t_leer: [u8; 1] = "\0"
    if num.text_zu_u64((&t_leer[0]) as *mut u8, 0, &w) {
        return 34
    }
    var t_rest: [u8; 8] = "12 rest\0"
    if num.text_zu_u64((&t_rest[0]) as *mut u8, 7, &w) {
        return 35
    }

    // --- Text -> Zahl, lesend (Rest bleibt stehen)
    var ue: bool = false
    let gelesen: usize = num.lies_u64((&t_rest[0]) as *mut u8, 7, 0, &w, &ue)
    if gelesen != 2 || w != 12 || ue {
        return 40
    }
    var t_neg: [u8; 9] = "-000042x\0"
    let gelesen2: usize = num.lies_i64((&t_neg[0]) as *mut u8, 8, 0, &v, &ue)
    if gelesen2 != 7 || v != 0 - 42 || ue {
        return 41
    }
    if num.lies_u64_basis((&t_neg[0]) as *mut u8, 8, 0, 10, &w, &ue) != 0 {
        return 42
    }
    var t_hex: [u8; 7] = "0xff00\0"
    var t_bin: [u8; 7] = "0b1011\0"
    var t_okt: [u8; 5] = "0o17\0"
    if !num.text_zu_u64_auto((&t_hex[0]) as *mut u8, 6, &w) || w != 65280 {
        return 43
    }
    if !num.text_zu_u64_auto((&t_bin[0]) as *mut u8, 6, &w) || w != 11 {
        return 44
    }
    if !num.text_zu_u64_auto((&t_okt[0]) as *mut u8, 4, &w) || w != 15 {
        return 45
    }
    var t_36: [u8; 3] = "zz\0"
    var w36: u64 = 0
    if !num.text_zu_u64_basis((&t_36[0]) as *mut u8, 2, 36, &w36) || w36 != 1295 {
        return 46
    }
    // Ueberlauf wird gemeldet, nicht verschwiegen.
    if num.lies_u64((&t_ueber[0]) as *mut u8, 20, 0, &w, &ue) != 20 {
        return 47
    }
    if !ue {
        return 48
    }

    // --- Gleitkomma
    var f: num.Bytes = num.Bytes{ ptr: 0 as *mut u8, len: 0, cap: 0 }
    if !num.schreibe_f64(&f, 0.1) {
        return 50
    }
    if num.bytes_len(&f) != 3 {
        return 51
    }
    num.bytes_clear(&f)
    if !num.schreibe_f64(&f, 0.0 - 1.5) {
        return 52
    }
    if num.bytes_len(&f) != 4 || num.bytes_at(&f, 0) != 45 as u8 {
        return 53
    }
    num.bytes_clear(&f)
    num.schreibe_f64(&f, 1.0e21)
    if num.bytes_len(&f) != 5 || num.bytes_at(&f, 1) != 101 as u8 {
        return 54
    }
    var t_f: [u8; 6] = "2.5e3\0"
    var x: f64 = 0.0
    if !num.text_zu_f64((&t_f[0]) as *mut u8, 5, &x) || x != 2500.0 {
        return 55
    }
    var t_ganz: [u8; 4] = "123\0"
    if num.lies_f64((&t_ganz[0]) as *mut u8, 3, &x) != 3 || x != 123.0 {
        return 56
    }
    if num.f64_bits(1.0) != 4607182418800017408 {
        return 57
    }
    if num.bits_f64(4607182418800017408) != 1.0 {
        return 58
    }
    let unendlich: f64 = 1.0 / 0.0
    if !num.f64_ist_unendlich(unendlich) || num.f64_ist_nan(unendlich) {
        return 59
    }
    let keine: f64 = 0.0 / 0.0
    if !num.f64_ist_nan(keine) {
        return 60
    }
    if !num.f64_ist_null(0.0) || !num.f64_vorzeichen(0.0 - 1.0) {
        return 61
    }
    if num.dtoa_arbeitsbytes() != 14336 || num.strtod_arbeitsbytes() != 12288 {
        return 62
    }
    // Hin und zurueck: der kuerzeste Text liest sich als dieselbe Zahl.
    // Der Wert wird GERECHNET (0.1 + 0.2), nicht als Literal geschrieben —
    // firnc0 und firnc1 runden 17-stellige Gleitkommaliterale nicht gleich
    // (gemessen, siehe docs/RUNDE42.md), und dieser Test soll die
    // Zahlenbibliothek pruefen, nicht den Lexer.
    let krumm: f64 = 0.1 + 0.2
    num.bytes_clear(&f)
    num.schreibe_f64(&f, krumm)
    if num.bytes_len(&f) != 19 {
        return 63
    }
    var y: f64 = 0.0
    if !num.text_zu_f64((*(&f)).ptr, num.bytes_len(&f), &y) {
        return 64
    }
    if y != krumm {
        return 65
    }

    zeig(&b)
    io.fmt_druck(f" | basis36 {w36} gelesen {gelesen} neg {v} | ")
    zeig(&tab)
    io.fmt_druck(f" | ")
    zeig(&f)
    io.fmt_druck(f" | ziffern {num.ziffernzahl(1000, 10)} runde {y == krumm} ueberlauf {ue}\n")

    num.bytes_free(&b)
    num.bytes_free(&tab)
    num.bytes_free(&f)
    return 0
}
