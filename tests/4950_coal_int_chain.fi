// expect_exit: 0
// Integer two-operand chains (xor/and/or/sub/mul/shift/rotate) whose links
// share one register after coalescing. Results are compared with constants
// computed by an independent reference (Python, same LCG, same wrap rules).
fn rotr(x: u32, n: u32) -> u32 {
    return (x >> n) | (x << (32 - n))
}

fn c1(x: u32, y: u32, z: u32, w: u32) -> u32 {
    return ((x ^ y) ^ z) ^ w
}

fn c2(x: u32, y: u32, z: u32, w: u32) -> u32 {
    return ((x & y) | z) ^ w
}

fn c3(x: u32, y: u32, z: u32, w: u32) -> u32 {
    return ((x -% y) -% z) -% w
}

fn c4(x: u32, y: u32, z: u32, w: u32) -> u32 {
    return rotr(x, 5) ^ rotr(y, 9) ^ rotr(z, 13) ^ (w >> 3) ^ (x << 7)
}

fn c5(x: u32, y: u32, z: u32, w: u32) -> u32 {
    return ((x *% y) *% z) ^ w
}

fn d1(x: u64, y: u64, z: u64, w: u64) -> u64 {
    return ((x ^ y) & (z | w)) ^ (x -% w) ^ ((y *% z) >> 7)
}

fn d2(x: u64, y: u64) -> u64 {
    return (x ^ x) ^ (y -% y) ^ (x & x) ^ (y | y)
}

fn lcg(s: u64) -> u64 {
    return s *% 6364136223846793005 +% 1442695040888963407
}

fn main() -> i32 {
    var s: u64 = 12345
    var h1: u32 = 0
    var h2: u32 = 0
    var h3: u32 = 0
    var h4: u32 = 0
    var h5: u32 = 0
    var h6: u64 = 0
    var h7: u64 = 0
    var i: u32 = 0
    while i < 1000 {
        s = lcg(s)
        let x: u32 = (s >> 32) as u32
        let y: u32 = ((s >> 16) & 0xFFFFFFFF) as u32
        s = lcg(s)
        let z: u32 = (s >> 32) as u32
        let w: u32 = ((s >> 8) & 0xFFFFFFFF) as u32
        h1 = h1 +% c1(x, y, z, w)
        h2 = h2 +% c2(x, y, z, w)
        h3 = h3 +% c3(x, y, z, w)
        h4 = h4 +% c4(x, y, z, w)
        h5 = h5 +% c5(x, y, z, w)
        h6 = h6 +% d1(s, s >> 3, s >> 11, s >> 17)
        h7 = h7 +% d2(s, s >> 5)
        i = i + 1
    }
    var bad: i32 = 0
    if h1 != 2345151375 {
        bad = 1
    }
    if h2 != 993596607 {
        bad = 2
    }
    if h3 != 979865357 {
        bad = 3
    }
    if h4 != 2306867835 {
        bad = 4
    }
    if h5 != 2646166836 {
        bad = 5
    }
    if h6 != 7214619595646971536 {
        bad = 6
    }
    if h7 != 2253254532863294085 {
        bad = 7
    }
    return bad
}
