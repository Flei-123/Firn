// expect_exit: 0
// A parameter named like a function of its module, used as the last token of
// a line while the next line starts with `(*p).f = ...`: stage 1 used to read
// `kind\n(*nd)` as a CALL, renamed the parameter to `param_shadow__kind` and
// then exited with code 1 and no message (found with std.xml). The module is
// tests/modules/param_shadow.fi.
import modules.param_shadow

fn main() -> i32 {
    var nd: param_shadow.Node = param_shadow.Node { kind: 0, child: 0, line: 0, after: 0 }
    param_shadow.fill(&nd, 3, 40, 500)
    if param_shadow.kind(&nd) != 3 { return 1 }
    if param_shadow.child(&nd) != 40 { return 2 }
    if param_shadow.line(&nd) != 500 { return 3 }
    if nd.after != 5 { return 4 }
    return 0
}
