// expect_exit: 0
// tests/1603_md5_uuid.fi -- ROUND 76: MD5 and the offline UUID.
//
// TWO SETS OF NUMBERS, and neither comes from this repository:
//
//   1. The seven test vectors of RFC 1321, appendix A.5. They have stood
//      there since 1992.
//   2. Four UUIDs that the REAL vanilla server 1.20.4 handed out on this
//      machine on 2026-08-21 -- captured with `tools/mcserver/harness.py`
//      against `java -jar server.jar` in offline mode
//      (docs/ROUND76.md names the run). If the derivation were wrong, this
//      server would give every player a different identity than every other
//      server: inventories, permissions and statistics all hang on that
//      number.
//
// The vectors of RFC 1321 also cover the two cases in which a padding is
// usually wrong: the empty message (one block of pure padding) and the 56
// octet boundary at which the length no longer fits into the block and a
// SECOND block is needed. The 80 octet vector is the one that forces it.
import std.md5
import std.rt

fn hex_digit(c: u8) -> u8 {
    if c >= 48 as u8 && c <= 57 as u8 {
        return c - 48 as u8
    }
    return c - 87 as u8
}

// Compares a digest against its hexadecimal spelling.
fn digest_is(d: u64, want: u64) -> bool {
    var i: usize = 0
    while i < 16 {
        let hi: u8 = hex_digit(rt.ld8(want, i * 2))
        let lo: u8 = hex_digit(rt.ld8(want, i * 2 + 1))
        if rt.ld8(d, i) != hi * 16 as u8 + lo {
            return false
        }
        i = i + 1
    }
    return true
}

fn check(msg: u64, n: usize, want: u64) -> bool {
    var d: [u8; 16] = [0; 16]
    md5.md5(msg, n, (&d[0]) as u64)
    return digest_is((&d[0]) as u64, want)
}

// A UUID as 32 hexadecimal digits, no dashes.
fn uuid_is(high: u64, low: u64, want: u64) -> bool {
    var i: usize = 0
    while i < 16 {
        var v: u8 = 0
        if i < 8 {
            v = ((high >> ((7 - i) as u64 * 8)) & 255 as u64) as u8
        } else {
            v = ((low >> ((15 - i) as u64 * 8)) & 255 as u64) as u8
        }
        let hi: u8 = hex_digit(rt.ld8(want, i * 2))
        let lo: u8 = hex_digit(rt.ld8(want, i * 2 + 1))
        if v != hi * 16 as u8 + lo {
            return false
        }
        i = i + 1
    }
    return true
}

fn check_uuid(name: u64, n: usize, want: u64) -> bool {
    var h: u64 = 0
    var l: u64 = 0
    if !md5.md5_offline_uuid(name, n, &h, &l) {
        return false
    }
    return uuid_is(h, l, want)
}

fn main() -> i32 {
    // ---------------------------------------- 1. RFC 1321, appendix A.5
    var m0: [u8; 1] = "\0"
    var d0: [u8; 33] = "d41d8cd98f00b204e9800998ecf8427e\0"
    if !check((&m0[0]) as u64, 0, (&d0[0]) as u64) { return 1 }

    var m1: [u8; 2] = "a\0"
    var d1: [u8; 33] = "0cc175b9c0f1b6a831c399e269772661\0"
    if !check((&m1[0]) as u64, 1, (&d1[0]) as u64) { return 2 }

    var m2: [u8; 4] = "abc\0"
    var d2: [u8; 33] = "900150983cd24fb0d6963f7d28e17f72\0"
    if !check((&m2[0]) as u64, 3, (&d2[0]) as u64) { return 3 }

    var m3: [u8; 15] = "message digest\0"
    var d3: [u8; 33] = "f96b697d7cb7938d525a2f31aaf161d0\0"
    if !check((&m3[0]) as u64, 14, (&d3[0]) as u64) { return 4 }

    var m4: [u8; 27] = "abcdefghijklmnopqrstuvwxyz\0"
    var d4: [u8; 33] = "c3fcd3d76192e4007dfb496cca67e13b\0"
    if !check((&m4[0]) as u64, 26, (&d4[0]) as u64) { return 5 }

    // 62 octets -- past the 56 octet boundary, so the length no longer fits
    // into the first block and a second one is needed. This is the vector
    // that catches a wrong padding.
    var m5: [u8; 63] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789\0"
    var d5: [u8; 33] = "d174ab98d277d9f5a5611c2c9f419d9f\0"
    if !check((&m5[0]) as u64, 62, (&d5[0]) as u64) { return 6 }

    // 80 octets -- two blocks of message plus a third of padding
    var m6: [u8; 81] = "12345678901234567890123456789012345678901234567890123456789012345678901234567890\0"
    var d6: [u8; 33] = "57edf4a22be3c955ac49da2e2107b67a\0"
    if !check((&m6[0]) as u64, 80, (&d6[0]) as u64) { return 7 }

    // the two exact boundaries around one block
    var m7: [u8; 65] = "0123456789012345678901234567890123456789012345678901234567890123\0"
    var d7: [u8; 33] = "7f7bfd348709deeaace19e3f535f8c54\0"
    if !check((&m7[0]) as u64, 64, (&d7[0]) as u64) { return 8 }
    // 55 octets: the last length that still fits into ONE block. The digest
    // HAS to be a different one -- if the same came out, the length would
    // not be going into the hash at all.
    if check((&m7[0]) as u64, 55, (&d7[0]) as u64) { return 9 }
    var d55: [u8; 33] = "6e7a4fc92eb1c3f6e652425bcc8d44b5\0"
    if !check((&m7[0]) as u64, 55, (&d55[0]) as u64) { return 10 }
    // 56 octets: the first length that does NOT fit -- the boundary itself.
    var d56: [u8; 33] = "8af270b2847610e742b0791b53648c09\0"
    if !check((&m7[0]) as u64, 56, (&d56[0]) as u64) { return 11 }

    // ------------------------- 2. what the real vanilla server handed out
    var u1n: [u8; 12] = "GroundTruth\0"
    var u1v: [u8; 33] = "516c93e270973054b24e7e67046ba75b\0"
    if !check_uuid((&u1n[0]) as u64, 11, (&u1v[0]) as u64) { return 20 }

    var u2n: [u8; 6] = "Notch\0"
    var u2v: [u8; 33] = "b50ad385829d3141a2167e7d7539ba7f\0"
    if !check_uuid((&u2n[0]) as u64, 5, (&u2v[0]) as u64) { return 21 }

    var u3n: [u8; 7] = "Tester\0"
    var u3v: [u8; 33] = "f3d28cb072253cb1baeb2dadd2be89ae\0"
    if !check_uuid((&u3n[0]) as u64, 6, (&u3v[0]) as u64) { return 22 }

    var u4n: [u8; 5] = "jeb_\0"
    var u4v: [u8; 33] = "a762f5604fce3236812ab80efff0b62b\0"
    if !check_uuid((&u4n[0]) as u64, 4, (&u4v[0]) as u64) { return 23 }

    // The two patched fields, read back out of the number itself: version 3
    // in the upper nibble of octet 6, variant 10 in the top two bits of
    // octet 8. Without them the client would accept the number and every
    // other server would compute a different one.
    var h: u64 = 0
    var l: u64 = 0
    if !md5.md5_offline_uuid((&u2n[0]) as u64, 5, &h, &l) { return 24 }
    if ((h >> 12) & 15 as u64) != 3 as u64 { return 25 }
    if ((l >> 62) & 3 as u64) != 2 as u64 { return 26 }

    // a name longer than the buffer is refused instead of overrun
    var longname: [u8; 200] = [65; 200]
    if md5.md5_offline_uuid((&longname[0]) as u64, 199, &h, &l) { return 27 }
    return 0
}
