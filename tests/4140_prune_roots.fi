// expect_exit: 0
// tests/4140_prune_roots.fi -- functions that only a TABLE or a VALUE names must survive
// FIR pruning (r731, FIRN_PRUNE_FIR=1 in firnc0 and firnc1; checked by tools/prune_compare.sh).
//
//   * `Sq.area` is reached only through the method table of `dyn Shape`
//   * `triple` is reached only through a function value
//   * `never_called` is reachable from nothing and is dropped when pruning is on
interface Shape {
    fn area(*self) -> i64
}

struct Sq { s: i64 }

impl Shape for Sq {
    fn area(*self) -> i64 { return (*self).s * (*self).s }
}

fn triple(a: i64) -> i64 { return a * 3 }

fn never_called(a: i64) -> i64 { return a + 1000 }

fn main() -> i32 {
    var q: Sq = Sq { s: 4 }
    let d: dyn Shape = (&q) as dyn Shape
    if d.area() != 16 { return 1 }
    let f: fn(i64) -> i64 = triple
    if f(5) != 15 { return 2 }
    return 0
}
