// expect_exit: 0
// 1.17.0 (protocol 755): version lookup, chunk format, destroy packet is the single-id layout (1.17.1 = 756 sends an array),
// version list is sorted ascending and contains 755 exactly once.
import std.rt
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_entity_layout
import std.bytes
import mc.mc_entity

fn check(ok: bool, code: i32) {
    if !ok { rt.finish(code as i64) }
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(755, &v), 10)
    check(v.protocol == 755, 11)
    check(v.chunk_format == mc_version.CF_SECTIONS_114, 12)
    check(mc_version.version_has(&v, mc_version.FLAG_FLATTENING), 13)
    check(mc_version.version_pid(&v, mc_sem.SEM_PLAY_S2C_MAP_CHUNK) >= 0, 14)

    var w: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(756, &w), 20)
    check(w.protocol == 756, 21)

    // 1.17.0 destroy_entity = one varint id ("Ev"); 1.17.1 = count + ids ("Av")
    check(mc_entity_layout.layout(755, mc_entity_layout.KIND_DESTROY) == "Ev", 30)
    check(mc_entity_layout.layout(756, mc_entity_layout.KIND_DESTROY) == "Av", 31)

    // behaviour: spawn living (id 7), destroy it with the single-id packet; a 756 array packet must NOT be read as single id
    check(v.sem[mc_sem.SEM_PLAY_S2C_ENTITY_DESTROY] >= 0, 32)
    var s: mc_entity.Store = mc_entity.store_new()
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, 7)
    bytes.put_uuid(&b, 0 as u64, 2 as u64)
    bytes.put_varint(&b, 30)
    bytes.put_f64(&b, 1.5)
    bytes.put_f64(&b, 64.0)
    bytes.put_f64(&b, 0.0 - 2.0)
    bytes.put_i8(&b, 0 as i8)
    bytes.put_i8(&b, 0 as i8)
    bytes.bytes_set_pos(&b, 0)
    check(mc_entity.entity_on_packet(&s, &v, v.sem[mc_sem.SEM_PLAY_S2C_SPAWN_ENTITY_LIVING], &b), 33)
    bytes.bytes_clear(&b)
    check(mc_entity.store_count(&s) == 1, 34)
    bytes.put_varint(&b, 7)
    bytes.bytes_set_pos(&b, 0)
    check(mc_entity.entity_on_packet(&s, &v, v.sem[mc_sem.SEM_PLAY_S2C_ENTITY_DESTROY], &b), 35)
    bytes.bytes_clear(&b)
    check(mc_entity.store_count(&s) == 0, 36)
    bytes.bytes_free(&b)
    mc_entity.store_free(&s)

    var n755: i32 = 0
    var last: i32 = 0
    var i: usize = 0
    while i < mc_versions.version_count() {
        let p: i32 = mc_versions.version_protocol_at(i)
        check(p > last, 40)
        last = p
        if p == 755 { n755 = n755 + 1 }
        i = i + 1
    }
    check(n755 == 1, 41)
    return 0
}
