// expect_exit: 37
// SPEC §9.2: select(bedingung, a, b) waehlt datenunabhaengig aus (im Backend cmov).
fn waehle(b: bool, a: i32, c: i32) -> i32 {
    return select(b, a, c)
}

fn main() -> i32 {
    var summe: i32 = 0
    summe = summe + waehle(true, 30 as i32, 5 as i32)
    summe = summe + waehle(false, 100 as i32, 7 as i32)
    let z: i32 = select(summe > 0 as i32, 0 as i32, 99 as i32)
    return summe + z
}
