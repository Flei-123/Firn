// expect_exit: 37
// SPEC 9.2: select(cond, a, b) chooses data-independently (cmov in the backend).
fn choose(b: bool, a: i32, c: i32) -> i32 {
    return select(b, a, c)
}

fn main() -> i32 {
    var sum: i32 = 0
    sum = sum + choose(true, 30 as i32, 5 as i32)
    sum = sum + choose(false, 100 as i32, 7 as i32)
    let z: i32 = select(sum > 0 as i32, 0 as i32, 99 as i32)
    return sum + z
}
