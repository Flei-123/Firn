// expect_exit: 0
#[packed]
struct P {
    a: u8,
    b: u32,
    c: u16,
    d: u64,
}

#[packed]
struct Q {
    a: u8,
    f: f64,
    g: f32,
}

struct W {
    x: u8,
    p: P,
    y: u8,
}

fn off(base: u64, field: u64) -> u64 {
    return field - base
}

fn total(p: P) -> u64 {
    return (p.a as u64) + (p.b as u64) + (p.c as u64) + p.d
}

fn scale(q: Q) -> f64 {
    return q.f * (q.g as f64)
}

fn main() -> i32 {
    if size_of[P]() != 15 {
        return 1
    }
    if size_of[Q]() != 13 {
        return 2
    }
    if size_of[W]() != 17 {
        return 3
    }
    var p: P = P { a: 1, b: 2, c: 3, d: 4 }
    let base: u64 = (&p.a) as u64
    if off(base, (&p.b) as u64) != 1 {
        return 4
    }
    if off(base, (&p.c) as u64) != 5 {
        return 5
    }
    if off(base, (&p.d) as u64) != 7 {
        return 6
    }
    p.b = 0x01020304
    p.d = 0x0102030405060708
    p.c = 0xABCD
    if p.b != 0x01020304 {
        return 7
    }
    if p.d != 0x0102030405060708 {
        return 8
    }
    if p.c != 0xABCD {
        return 9
    }
    if p.a != 1 {
        return 10
    }
    var arr: [P; 2] = [p, p]
    if off((&arr[0].a) as u64, (&arr[1].a) as u64) != 15 {
        return 11
    }
    arr[1].d = 99
    if arr[0].d != 0x0102030405060708 {
        return 12
    }
    if arr[1].d != 99 {
        return 13
    }
    let t: u64 = total(P { a: 1, b: 2, c: 3, d: 4 })
    if t != 10 {
        return 14
    }
    var q: Q = Q { a: 7, f: 2.5, g: 4.0 }
    if scale(q) != 10.0 {
        return 15
    }
    q.f = 1.5
    if q.f != 1.5 {
        return 16
    }
    if q.a != 7 {
        return 17
    }
    var w: W = W { x: 5, p: p, y: 6 }
    if off((&w.x) as u64, (&w.p) as u64) != 1 {
        return 18
    }
    if off((&w.x) as u64, (&w.y) as u64) != 16 {
        return 19
    }
    if w.p.d != 0x0102030405060708 {
        return 20
    }
    return 0
}
