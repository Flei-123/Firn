// expect_exit: 0
// The success type is a pointer.
error E { Null }

fn check(p: *mut i32) -> E!*mut i32 {
    if p == 0 as *mut i32 {
        return E::Null
    }
    return p
}

fn main() -> i32 {
    var z: i32 = 41
    let q = check(&z) catch 0 as *mut i32
    if *q != 41 {
        return 1
    }
    let empty = check(0 as *mut i32) catch &z
    if *empty != 41 {
        return 2
    }
    return 0
}
