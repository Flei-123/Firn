// expect_exit: 0
// tests/3602_cal_ical.fi -- cal.ical: RFC 5545 examples (3.6.1 event, 3.3.x value types), recurrence
// sets with RDATE / EXDATE, VTIMEZONE offsets, UTC UNTIL with a zone, builder and write -> parse round trip.
import std.rt
import std.vec
import cal.civil
import cal.content
import cal.ical
import cal.rrule

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn same(b: *mut rt.Buf, want: str) -> bool {
    return rt.buf_len(b) == want.n && rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.n)
}

fn secs(y: i32, m: u32, d: u32, hh: i64, mm: i64, ss: i64) -> i64 {
    return civil.days_from_civil(y, m, d) * 86400 + hh * 3600 + mm * 60 + ss
}

fn dur(s: str) -> i64 {
    var v: i64 = 0
    if !ical.parse_duration(s, &v) {
        return -999999999
    }
    return v
}

fn bad_dur(s: str) -> bool {
    var v: i64 = 0
    return !ical.parse_duration(s, &v)
}

fn bad_dt(s: str) -> bool {
    var v: ical.DateVal = ical.DateVal { y: 0, m: 0, d: 0, hh: 0, mm: 0, ss: 0, date_only: false, utc: false }
    return !ical.parse_datetime(s, &v)
}

fn values() {
    check("duration 15d5h20s", dur("P15DT5H0M20S") == 1314020)
    check("duration weeks", dur("P7W") == 4233600)
    check("duration negative", dur("-PT15M") == -900)
    check("duration plus", dur("+P1D") == 86400)
    check("duration zero", dur("PT0S") == 0)
    check("duration hm", dur("PT1H30M") == 5400)
    check("duration bad P", bad_dur("P"))
    check("duration bad PT", bad_dur("PT"))
    check("duration bad no P", bad_dur("1D"))
    check("duration bad H before T", bad_dur("P1H"))
    check("duration bad text", bad_dur("PTxS"))
    check("duration empty", bad_dur(""))
    var b: rt.Buf = rt.buf_new()
    ical.format_duration(1314020, &b)
    check("format duration", same(&b, "P15DT5H20S"))
    rt.buf_clear(&b)
    ical.format_duration(-900, &b)
    check("format negative duration", same(&b, "-PT15M"))
    rt.buf_clear(&b)
    ical.format_duration(0, &b)
    check("format zero duration", same(&b, "PT0S"))
    rt.buf_clear(&b)

    var v: ical.DateVal = ical.DateVal { y: 0, m: 0, d: 0, hh: 0, mm: 0, ss: 0, date_only: false, utc: false }
    check("datetime utc", ical.parse_datetime("19970714T173000Z", &v) && v.y == 1997 && v.m == 7 && v.d == 14 && v.hh == 17 && v.mm == 30 && v.ss == 0 && v.utc && !v.date_only)
    check("datetime floating", ical.parse_datetime("19980118T230000", &v) && !v.utc && !v.date_only && v.hh == 23)
    check("date", ical.parse_datetime("19970714", &v) && v.date_only && v.d == 14)
    ical.format_datetime(v, &b)
    check("format date", same(&b, "19970714"))
    rt.buf_clear(&b)
    ical.parse_datetime("20260102T030405Z", &v)
    ical.format_datetime(v, &b)
    check("format datetime", same(&b, "20260102T030405Z"))
    rt.buf_clear(&b)
    check("secs of epoch", ical.parse_datetime("19700101T000000Z", &v) && ical.secs_of(v) == 0)
    check("secs of 2000", ical.parse_datetime("20000301T000001", &v) && ical.secs_of(v) == 951868801)
    let back: ical.DateVal = ical.from_secs(951868801, false, false)
    check("from secs", back.y == 2000 && back.m == 3 && back.d == 1 && back.ss == 1)
    check("datetime bad 30 Feb", bad_dt("19970230T000000"))
    check("datetime bad hour 24", bad_dt("19970101T240000"))
    check("datetime bad length", bad_dt("1997"))
    check("datetime bad trailer", bad_dt("19970101T000000X"))
    check("datetime bad separator", bad_dt("19970101 000000"))
    check("datetime bad empty", bad_dt(""))
    check("datetime bad letters", bad_dt("abcdefghTijklmn"))

    var a: i64 = 0
    var e: i64 = 0
    check("period explicit", ical.parse_period("19970101T180000Z/19970102T070000Z", &a, &e) && a == secs(1997, 1, 1, 18, 0, 0) && e == secs(1997, 1, 2, 7, 0, 0))
    check("period duration", ical.parse_period("19970101T180000Z/PT5H30M", &a, &e) && e - a == 19800)
    check("period bad", !ical.parse_period("19970101T180000Z", &a, &e) && !ical.parse_period("x/y", &a, &e))
    var off: i64 = 0
    check("offset +0100", ical.parse_offset("+0100", &off) && off == 3600)
    check("offset -0530", ical.parse_offset("-0530", &off) && off == -19800)
    check("offset seconds", ical.parse_offset("+013045", &off) && off == 5445)
    check("offset bad", !ical.parse_offset("0100", &off) && !ical.parse_offset("+01", &off) && !ical.parse_offset("+01:00", &off))
    rt.buf_free(&b)
}

fn list_is(name: str, d: *mut content.Doc, comp: i64, from: i64, to: i64, max_n: usize, want: str) {
    var out: Vec[i64] = vec_new[i64]()
    ical.occurrences(d, comp as usize, from, to, max_n, &out)
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < vec_len[i64](&out) {
        if i > 0 {
            rt.buf_push(&b, 44 as u8)
        }
        ical.format_datetime(ical.from_secs(vec_at[i64](&out, i), false, false), &b)
        i = i + 1
    }
    if !same(&b, want) {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, " got ".p as u64, 5)
        rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
        rt.write_everything(1, "\n".p as u64, 1)
    }
    rt.buf_free(&b)
    vec_free[i64](&out)
}

fn event_example() {
    let raw: str = "BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//hacksw/handcal//NONSGML v1.0//EN\r\nBEGIN:VEVENT\r\nUID:19970610T172345Z-AF23B2@example.com\r\nDTSTAMP:19970610T172345Z\r\nDTSTART:19970714T170000Z\r\nDTEND:19970715T040000Z\r\nSUMMARY:Bastille Day Party\r\nGEO:48.85299;2.36885\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"
    var d: content.Doc = content.doc_new()
    check("5545 clean", content.parse(raw, &d) == 0)
    let cal: i64 = content.comp_first_child(&d, -1)
    let ev: i64 = content.find_comp(&d, cal, "VEVENT", -1)
    check("5545 event found", ev >= 0)
    var s: i64 = 0
    var date_only: bool = false
    var utc: bool = false
    var tz: str = ""
    check("5545 start", ical.event_start(&d, ev as usize, &s, &date_only, &utc, &tz) && s == secs(1997, 7, 14, 17, 0, 0) && utc && !date_only)
    check("5545 duration from DTEND", ical.event_duration(&d, ev as usize) == 39600)
    check("5545 summary", ical.get_prop(&d, ev as usize, "SUMMARY") == "Bastille Day Party")
    list_is("5545 single occurrence", &d, ev, -1000000000000, 1000000000000, 10, "19970714T170000")
    var out: rt.Buf = rt.buf_new()
    content.write(&d, &out)
    check("5545 write equals input", same(&out, raw))
    rt.buf_free(&out)
    content.doc_free(&d)

    // all-day events and DURATION
    var d2: content.Doc = content.doc_new()
    content.parse("BEGIN:VEVENT\r\nDTSTART;VALUE=DATE:19970714\r\nDTEND;VALUE=DATE:19970716\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nDTSTART:19970714T170000Z\r\nDURATION:PT1H30M\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nDTSTART:19970714T170000Z\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nDTSTART;VALUE=DATE:19970714\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nSUMMARY:no start\r\nEND:VEVENT\r\n", &d2)
    let e0: i64 = content.find_comp(&d2, -1, "VEVENT", -1)
    let e1: i64 = content.find_comp(&d2, -1, "VEVENT", e0)
    let e2: i64 = content.find_comp(&d2, -1, "VEVENT", e1)
    let e3: i64 = content.find_comp(&d2, -1, "VEVENT", e2)
    let e4: i64 = content.find_comp(&d2, -1, "VEVENT", e3)
    check("all-day start", ical.event_start(&d2, e0 as usize, &s, &date_only, &utc, &tz) && date_only && !utc)
    check("all-day duration", ical.event_duration(&d2, e0 as usize) == 172800)
    check("DURATION property", ical.event_duration(&d2, e1 as usize) == 5400)
    check("no end: zero duration", ical.event_duration(&d2, e2 as usize) == 0)
    check("no end for DATE: one day", ical.event_duration(&d2, e3 as usize) == 86400)
    var o: Vec[i64] = vec_new[i64]()
    check("no DTSTART is refused", ical.occurrences(&d2, e4 as usize, 0, 1000, 10, &o) == 100 && vec_len[i64](&o) == 0)
    vec_free[i64](&o)
    content.doc_free(&d2)
}

fn recurrence_sets() {
    let far0: i64 = 0 - rrule.FAR
    let far1: i64 = rrule.FAR
    var d: content.Doc = content.doc_new()
    content.parse("BEGIN:VCALENDAR\r\nBEGIN:VEVENT\r\nDTSTART:19970902T090000\r\nRRULE:FREQ=DAILY;COUNT=4\r\nEXDATE:19970903T090000\r\nRDATE:19970910T100000,19970902T090000\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nDTSTART:19970902T090000\r\nRRULE:FREQ=WEEKLY;COUNT=3\r\nRRULE:FREQ=MONTHLY;COUNT=2\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nDTSTART:19970902T090000\r\nRRULE:FREQ=DAILY;COUNT=5\r\nEXDATE;VALUE=DATE:19970904\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nDTSTART:19970903T090000\r\nRRULE:FREQ=WEEKLY;BYDAY=MO;COUNT=2\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n", &d)
    let cal: i64 = content.comp_first_child(&d, -1)
    let e0: i64 = content.find_comp(&d, cal, "VEVENT", -1)
    let e1: i64 = content.find_comp(&d, cal, "VEVENT", e0)
    let e2: i64 = content.find_comp(&d, cal, "VEVENT", e1)
    let e3: i64 = content.find_comp(&d, cal, "VEVENT", e2)
    list_is("set: exdate, rdate, duplicate rdate", &d, e0, far0, far1, 100, "19970902T090000,19970904T090000,19970905T090000,19970910T100000")
    list_is("two RRULEs united", &d, e1, far0, far1, 100, "19970902T090000,19970909T090000,19970916T090000,19971002T090000")
    list_is("DATE exdate removes the day", &d, e2, far0, far1, 100, "19970902T090000,19970903T090000,19970905T090000,19970906T090000")
    list_is("DTSTART is first instance although the rule skips it", &d, e3, far0, far1, 100, "19970903T090000,19970908T090000,19970915T090000")
    list_is("window", &d, e0, secs(1997, 9, 4, 0, 0, 0), secs(1997, 9, 5, 23, 59, 59), 100, "19970904T090000,19970905T090000")
    list_is("max_n", &d, e0, far0, far1, 2, "19970902T090000,19970904T090000")
    content.doc_free(&d)
}

fn zones() {
    let tz: str = "BEGIN:VCALENDAR\r\nBEGIN:VTIMEZONE\r\nTZID:Europe/Vienna\r\nBEGIN:STANDARD\r\nDTSTART:19701025T030000\r\nRRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU\r\nTZOFFSETFROM:+0200\r\nTZOFFSETTO:+0100\r\nTZNAME:CET\r\nEND:STANDARD\r\nBEGIN:DAYLIGHT\r\nDTSTART:19700329T020000\r\nRRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU\r\nTZOFFSETFROM:+0100\r\nTZOFFSETTO:+0200\r\nTZNAME:CEST\r\nEND:DAYLIGHT\r\nEND:VTIMEZONE\r\nBEGIN:VEVENT\r\nDTSTART;TZID=Europe/Vienna:20261024T230000\r\nRRULE:FREQ=DAILY;UNTIL=20261025T225000Z\r\nEND:VEVENT\r\nBEGIN:VEVENT\r\nDTSTART;TZID=Nowhere/Land:20261024T230000\r\nEND:VEVENT\r\nEND:VCALENDAR\r\n"
    var d: content.Doc = content.doc_new()
    check("zone clean", content.parse(tz, &d) == 0)
    var u: i64 = 0
    check("summer noon", ical.local_to_utc(&d, "Europe/Vienna", secs(2026, 7, 1, 12, 0, 0), &u) && u == secs(2026, 7, 1, 10, 0, 0))
    check("winter noon", ical.local_to_utc(&d, "Europe/Vienna", secs(2026, 1, 15, 12, 0, 0), &u) && u == secs(2026, 1, 15, 11, 0, 0))
    check("day before the spring switch", ical.local_to_utc(&d, "Europe/Vienna", secs(2026, 3, 28, 12, 0, 0), &u) && u == secs(2026, 3, 28, 11, 0, 0))
    check("day of the spring switch", ical.local_to_utc(&d, "Europe/Vienna", secs(2026, 3, 29, 12, 0, 0), &u) && u == secs(2026, 3, 29, 10, 0, 0))
    check("day before the autumn switch", ical.local_to_utc(&d, "Europe/Vienna", secs(2026, 10, 24, 12, 0, 0), &u) && u == secs(2026, 10, 24, 10, 0, 0))
    check("day of the autumn switch", ical.local_to_utc(&d, "Europe/Vienna", secs(2026, 10, 25, 12, 0, 0), &u) && u == secs(2026, 10, 25, 11, 0, 0))
    check("case-insensitive TZID", ical.local_to_utc(&d, "europe/vienna", secs(2026, 7, 1, 12, 0, 0), &u))
    check("unknown zone", !ical.local_to_utc(&d, "Nowhere/Land", secs(2026, 7, 1, 12, 0, 0), &u))
    check("no calendar for the zone name", ical.find_vtimezone(&d, "Europe/Vienna") >= 0 && ical.find_vtimezone(&d, "Europe/Berlin") < 0)
    // 25 Oct 2026 22:50Z is 23:50 CET: moved into the wall clock it keeps the 23:00 start of the 25th
    // (unmoved, 22:50 would cut it off) and drops the 26th
    let cal: i64 = content.comp_first_child(&d, -1)
    let ev: i64 = content.find_comp(&d, cal, "VEVENT", -1)
    list_is("UTC until with TZID", &d, ev, 0 - rrule.FAR, rrule.FAR, 100, "20261024T230000,20261025T230000")
    content.doc_free(&d)
}

fn builder() {
    var d: content.Doc = content.doc_new()
    content.begin(&d, "VCALENDAR")
    content.add_prop(&d, "", "VERSION", "2.0")
    content.add_prop(&d, "", "PRODID", "-//firn//cal//EN")
    content.begin(&d, "VEVENT")
    ical.add_text(&d, "UID", "a1@example.com")
    ical.add_text(&d, "SUMMARY", "Plan, review; \"ship\"\nsecond line \\ end")
    ical.add_datetime(&d, "DTSTART", ical.DateVal { y: 2026, m: 10, d: 16, hh: 9, mm: 30, ss: 0, date_only: false, utc: false }, "Europe/Vienna")
    ical.add_datetime(&d, "DTEND", ical.DateVal { y: 2026, m: 10, d: 16, hh: 10, mm: 0, ss: 0, date_only: false, utc: true }, "Europe/Vienna")
    ical.add_datetime(&d, "X-DAY", ical.DateVal { y: 2026, m: 10, d: 17, hh: 0, mm: 0, ss: 0, date_only: true, utc: false }, "")
    ical.add_duration(&d, "X-LEN", 5400)
    var r: rrule.Rule = rrule.rule_new()
    rrule.parse("FREQ=WEEKLY;COUNT=3;BYDAY=FR", &r)
    ical.add_rrule(&d, &r)
    rrule.rule_free(&r)
    content.end(&d)
    content.end(&d)
    var out: rt.Buf = rt.buf_new()
    content.write(&d, &out)
    var d2: content.Doc = content.doc_new()
    check("builder clean", content.parse(str { p: rt.buf_data(&out), n: rt.buf_len(&out) }, &d2) == 0)
    let cal: i64 = content.comp_first_child(&d2, -1)
    let ev: i64 = content.find_comp(&d2, cal, "VEVENT", -1)
    var t: rt.Buf = rt.buf_new()
    content.text_unescape(ical.get_prop(&d2, ev as usize, "SUMMARY"), &t)
    check("builder summary", same(&t, "Plan, review; \"ship\"\nsecond line \\ end"))
    let ds: i64 = content.find_prop(&d2, ev as usize, "DTSTART", -1)
    check("builder tzid param", content.param(&d2, ds as usize, "TZID") == "Europe/Vienna")
    check("builder dtstart value", content.prop_value(&d2, ds as usize) == "20261016T093000")
    let de: i64 = content.find_prop(&d2, ev as usize, "DTEND", -1)
    check("builder utc has no tzid", content.prop_value(&d2, de as usize) == "20261016T100000Z" && !content.has_param(&d2, de as usize, "TZID"))
    let dd: i64 = content.find_prop(&d2, ev as usize, "X-DAY", -1)
    check("builder date", content.prop_value(&d2, dd as usize) == "20261017" && content.param(&d2, dd as usize, "VALUE") == "DATE")
    check("builder duration", ical.get_prop(&d2, ev as usize, "X-LEN") == "PT1H30M")
    list_is("builder rrule", &d2, ev, 0 - rrule.FAR, rrule.FAR, 10, "20261016T093000,20261023T093000,20261030T093000")
    rt.buf_free(&t)
    rt.buf_free(&out)
    content.doc_free(&d)
    content.doc_free(&d2)
}

fn main() -> i32 {
    values()
    event_example()
    recurrence_sets()
    zones()
    builder()
    if failures == 0 {
        rt.write_everything(1, "ok\n".p as u64, 3)
        return 0
    }
    return 1
}
