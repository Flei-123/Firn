// expect_exit: 5
// r733: E!T as a field of a generic struct and as return type of a generic accessor.
error MyErr { Bad }
struct Cell[T] { r: MyErr!T, n: i32 }
fn mkc[T](x: T) -> Cell[T] {
    return Cell[T]{ r: x, n: 2 }
}
fn get[T](c: *Cell[T]) -> MyErr!T {
    return (*c).r
}
fn main() -> i32 {
    var c = mkc[i32](3)
    let v = get[i32](&c) catch 0
    return v + c.n
}
