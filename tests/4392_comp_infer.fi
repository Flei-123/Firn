// expect_exit: 0
// firnc1_skip: untyped comprehensions are stage 0 only (r751; firnc1 twin pending)
// tests/4392_comp_infer.fi -- r751: comprehensions WITHOUT a declared type (`let x = [e for ..]`,
// as argument): the element type comes from the element expression (literal, arithmetic,
// loop variable of a Vec / range, call result, field).
import std.io
import std.rt
import std.vec
import std.map
import std.dict

struct P {
    a: i64,
    b: i64,
}

fn mk(n: i64) -> Vec[i64] {
    var v: Vec[i64] = vec_new[i64]()
    var i: i64 = 0
    while i < n {
        vec_push[i64](&v, i)
        i = i + 1
    }
    return v
}

fn twice(x: i64) -> i64 { return x * 2 }

fn sum(v: *mut Vec[i64]) -> i64 {
    var t: i64 = 0
    for x in *v {
        t = t + x
    }
    return t
}

fn total(v: Vec[i64]) -> i64 {
    var t: i64 = 0
    var w: Vec[i64] = v
    for x in w {
        t = t + x
    }
    return t
}

#[no_inline]
fn run() -> i32 {
    var xs: Vec[i64] = mk(6)
    // iteration element + arithmetic
    let sq = [x * x for x in xs]
    if vec_len[i64](&sq) != 6 || sum(&sq) != 55 { return 2 }
    // filter, literal operand
    let odd = [x * 10 + 1 for x in xs if x % 2 == 1]
    if vec_len[i64](&odd) != 3 || sum(&odd) != 93 { return 3 }
    // range with a typed bound
    let n: i64 = 5
    let r = [i * i for i in 0..n]
    if vec_len[i64](&r) != 5 || sum(&r) != 30 { return 4 }
    // call result
    let tw = [twice(x) for x in xs]
    if sum(&tw) != 30 { return 5 }
    // literal only: i32
    let ones = [1 for i in 0..3]
    var o: i32 = 0
    for k in ones {
        o = o + k
    }
    if o != 3 { return 6 }
    // as an argument
    if total([x + 1 for x in xs]) != 21 { return 7 }
    // later use of the inferred variable
    let first = sq[2]
    if first != 4 { return 8 }
    // field of a struct element
    var ps: Vec[P] = vec_new[P]()
    vec_push[P](&ps, P { a: 1, b: 10 })
    vec_push[P](&ps, P { a: 2, b: 20 })
    let bs = [p.b for p in ps]
    if sum(&bs) != 30 { return 9 }
    // comparison -> bool
    let flags = [x > 2 for x in xs]
    var cnt: i32 = 0
    for f in flags {
        if f { cnt = cnt + 1 }
    }
    if cnt != 3 { return 10 }
    // set and dict
    let s = { x % 3 for x in xs }
    if set_len[i64](&s) != 3 { return 11 }
    let d = { "k": x for x in xs }
    if dict_len[i64](&d) != 1 { return 12 }
    return 0
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    return run()
}
