// expect_exit: 0
// tests/2671_mc_crypto_rsa.fi -- SPKI parsing + PKCS#1 v1.5 encryption of lib/mc/mc_crypto.fi.
//
//  A  a real 1024 bit SPKI (made by OpenSSL via python `cryptography`): n, e, bit length
//  B  encrypt 6 message sizes (0 .. 117 = maximum) 20 times each; the private exponent d
//     (test only: plain modular exponentiation with std.crypto.rsa.rsa_public_op) opens
//     it again and the block must be 00 02 PS(>= 8, no zero octet) 00 M
//  C  limits: 118 octets too long, output too small, empty key; same message twice differs
//  D  twenty hand made SPKI variants (e = 0/1/2/even/9 octets, even or tiny or oversized
//     modulus, negative modulus, bad parameters, unused bits, trailing octets, EC key, other
//     OID, absent NULL, leading zeros) with their exact expected result code
//  The same keys are also decrypted by node and python in tools/mc/crypto/run.sh.
import std.rt
import std.str
import std.crypto.rsa
import mc.mc_crypto

fn hexval(c: u8) -> u8 {
    if c >= 97 as u8 {
        return c - 87 as u8
    }
    return c - 48 as u8
}

fn unhex(s: str, out: *mut rt.Buf) {
    var i: usize = 0
    while i + 1 < s.length() {
        rt.buf_push(out, (hexval(s.chars(i)) << 4 as u8) | hexval(s.chars(i + 1)))
        i = i + 2
    }
}

fn new_key() -> mc_crypto.RsaKey {
    return mc_crypto.RsaKey { n: [0; 512], nlen: 0, e: [0; 8], elen: 0 }
}

fn expect(hex: str, code: i32, id: i32) -> bool {
    var der: rt.Buf = rt.buf_new()
    unhex(hex, &der)
    var key: mc_crypto.RsaKey = new_key()
    let rc: i32 = mc_crypto.rsa_key_from_spki(rt.buf_ptr(&der), rt.buf_len(&der), &key)
    if rc != code {
        return false
    }
    if rc != mc_crypto.CR_OK {
        // a refused key leaves an EMPTY key behind
        return mc_crypto.rsa_key_bytes(&key) == 0
    }
    // an accepted key must be usable
    var msg: [u8; 16] = [9; 16]
    var out: [u8; 512] = [0; 512]
    var olen: usize = 0
    var mlen: usize = 16
    if key.nlen < 27 + 16 {
        mlen = 4
    }
    if mc_crypto.rsa_encrypt_pkcs1(&key, (&msg[0]) as u64, mlen, (&out[0]) as u64, 512, &olen) != mc_crypto.CR_OK {
        return false
    }
    return olen == key.nlen
}

// d-side check of one ciphertext: returns the message length found, or 1000 on a malformed block
fn open_block(nb: u64, nlen: usize, d: u64, dlen: usize, ct: u64, mlen: usize, msg: u64) -> bool {
    var em: [u8; 128] = [0; 128]
    if !rsa.rsa_public_op(nb, nlen, d, dlen, ct, nlen, (&em[0]) as u64) {
        return false
    }
    if em[0] != 0 as u8 || em[1] != 2 as u8 {
        return false
    }
    let z: usize = nlen - mlen - 1
    if z < 10 {
        return false
    }
    var i: usize = 2
    while i < z {
        if em[i] == 0 as u8 {
            return false
        }
        i = i + 1
    }
    if em[z] != 0 as u8 {
        return false
    }
    return rt.mem_eq((&em[0]) as u64 + (z + 1) as u64, msg, mlen)
}

fn main() -> i32 {
    var der: rt.Buf = rt.buf_new()
    var n: rt.Buf = rt.buf_new()
    var e: rt.Buf = rt.buf_new()
    var d: rt.Buf = rt.buf_new()
    unhex("", &der)
    unhex("a4bd5fdce2d994b3733f723c20f3b8b60fd7cf71762d4f2147b7e21ce396cb0f21167b4510da44c8e613d05c7fed9af53243da63910615b42e095d8144f8561f665c2a3b11e4252086ca1d58128b18658f9c0119c758415cf06b4bb4f15c61db0c1deb17f64db47055b87441c4e95dbdbb2cc0c4071f0b233580f7daf715caa3", &n)
    unhex("010001", &e)
    unhex("6738e1a01de40770897defae0d57a91d2ac0269309614a7ba7dc682981d1325ac078bdb480e2c2c6bea31ba359e51f7b138bc08332938575e882a5bc21e318d2824872b15e98b708ba638251f51603701daf6622ddbfd5729b631d3e2030a2e9172b5e7065b280c66d7d89a20644cac4d0d76d0fc0bbedfacf4718c08ad6b241", &d)

    // ---- A
    var key: mc_crypto.RsaKey = new_key()
    if mc_crypto.rsa_key_from_spki(rt.buf_ptr(&der), rt.buf_len(&der), &key) != mc_crypto.CR_OK { return 1 as i32 }
    if key.nlen != 128 || key.elen != 3 { return 2 as i32 }
    if !rt.mem_eq((&key.n[0]) as u64, rt.buf_ptr(&n), 128) { return 3 as i32 }
    if !rt.mem_eq((&key.e[0]) as u64, rt.buf_ptr(&e), 3) { return 4 as i32 }
    if mc_crypto.rsa_key_bits(&key) != 1024 || mc_crypto.rsa_key_bytes(&key) != 128 { return 5 as i32 }

    // ---- B
    var sizes: [usize; 6] = [0, 1, 16, 32, 100, 117]
    var si: usize = 0
    while si < 6 {
        let mlen: usize = sizes[si]
        var msg: rt.Buf = rt.buf_new()
        var i: usize = 0
        while i < mlen {
            rt.buf_push(&msg, ((i * 29 + 7) % 251) as u8)
            i = i + 1
        }
        var rep: usize = 0
        while rep < 20 {
            var ct: [u8; 128] = [0; 128]
            var olen: usize = 0
            if mc_crypto.rsa_encrypt_pkcs1(&key, rt.buf_ptr(&msg), mlen, (&ct[0]) as u64, 128, &olen) != mc_crypto.CR_OK { return 10 as i32 }
            if olen != 128 { return 11 as i32 }
            if !open_block(rt.buf_ptr(&n), 128, rt.buf_ptr(&d), 128, (&ct[0]) as u64, mlen, rt.buf_ptr(&msg)) { return 12 as i32 }
            rep = rep + 1
        }
        si = si + 1
    }

    // ---- C
    var m16: [u8; 16] = [5; 16]
    var c1: [u8; 128] = [0; 128]
    var c2: [u8; 128] = [0; 128]
    var olen2: usize = 7
    mc_crypto.rsa_encrypt_pkcs1(&key, (&m16[0]) as u64, 16, (&c1[0]) as u64, 128, &olen2)
    mc_crypto.rsa_encrypt_pkcs1(&key, (&m16[0]) as u64, 16, (&c2[0]) as u64, 128, &olen2)
    if rt.mem_eq((&c1[0]) as u64, (&c2[0]) as u64, 128) { return 20 as i32 }
    var big: [u8; 130] = [1; 130]
    if mc_crypto.rsa_encrypt_pkcs1(&key, (&big[0]) as u64, 118, (&c1[0]) as u64, 128, &olen2) != mc_crypto.CR_MSG_TOO_LONG { return 21 as i32 }
    if olen2 != 0 { return 22 as i32 }
    if mc_crypto.rsa_encrypt_pkcs1(&key, (&big[0]) as u64, 117, (&c1[0]) as u64, 127, &olen2) != mc_crypto.CR_OUT_SMALL { return 23 as i32 }
    var empty: mc_crypto.RsaKey = new_key()
    if mc_crypto.rsa_encrypt_pkcs1(&empty, (&big[0]) as u64, 1, (&c1[0]) as u64, 128, &olen2) != mc_crypto.CR_ARG { return 24 as i32 }
    if mc_crypto.rsa_key_bits(&empty) != 0 { return 25 as i32 }
    if mc_crypto.rsa_key_from_spki(0, 0, &empty) != mc_crypto.CR_ARG { return 26 as i32 }
    var sec: [u8; 16] = [0; 16]
    var sec2: [u8; 16] = [0; 16]
    if !mc_crypto.shared_secret_new((&sec[0]) as u64) || !mc_crypto.shared_secret_new((&sec2[0]) as u64) { return 27 as i32 }
    if rt.mem_eq((&sec[0]) as u64, (&sec2[0]) as u64, 16) { return 28 as i32 }
    var nz: usize = 0
    var q: usize = 0
    while q < 16 {
        if sec[q] != 0 as u8 {
            nz = nz + 1
        }
        q = q + 1
    }
    if nz == 0 { return 29 as i32 }

    // ---- D
    if !expect("", mc_crypto.CR_BAD_KEY, 1) { return 100 as i32 }
    if !expect("", mc_crypto.CR_BAD_KEY, 2) { return 101 as i32 }
    if !expect("", mc_crypto.CR_BAD_KEY, 3) { return 102 as i32 }
    if !expect("", mc_crypto.CR_BAD_KEY, 4) { return 103 as i32 }
    if !expect("", mc_crypto.CR_BAD_KEY, 5) { return 104 as i32 }
    if !expect("", mc_crypto.CR_BAD_KEY, 6) { return 105 as i32 }
    if !expect("303c300d06092a864886f70d0101010500032b003028022100b324feeecd2a6304560ed209db89eb5ee992899748eddba2f5be4fea36692be50203010001", mc_crypto.CR_BAD_KEY, 7) { return 106 as i32 }
    if !expect("305b300d06092a864886f70d0101010500034a003047024000b8791aa279ddafce5d366fe49d4b2d4351a5ac3be49db6d6e8eb2771fa0334c95c955b23590c418943b0a98180e6c2182abed91b5ffc7fbe84516898c545e70203010001", mc_crypto.CR_BAD_KEY, 8) { return 107 as i32 }
    if !expect("305c300d06092a864886f70d0101010500034b003048024100c1bc198a24dfc2c6cbc1b309fe2bd21c95f0e18a68e1c0e36ca6c42b4dc4dbd9346f0be767bec8079a96d85594c116217cfdda30487a6aa004a197dc0ff0c5210203010001", mc_crypto.CR_OK, 9) { return 108 as i32 }
    if !expect("", mc_crypto.CR_OK, 10) { return 109 as i32 }
    if !expect("", mc_crypto.CR_BAD_KEY, 11) { return 110 as i32 }
    if !expect("", mc_crypto.CR_BAD_DER, 12) { return 111 as i32 }
    if !expect("", mc_crypto.CR_OK, 13) { return 112 as i32 }
    if !expect("", mc_crypto.CR_BAD_DER, 14) { return 113 as i32 }
    if !expect("", mc_crypto.CR_BAD_DER, 15) { return 114 as i32 }
    if !expect("", mc_crypto.CR_BAD_DER, 16) { return 115 as i32 }
    if !expect("", mc_crypto.CR_BAD_DER, 17) { return 116 as i32 }
    if !expect("", mc_crypto.CR_OK, 18) { return 117 as i32 }
    if !expect("3059301306072a8648ce3d020106082a8648ce3d03010703420004c9b219561c212e4455acdcbd50c17810a1f31eaf372b858d8f7526177f0cf8ef66e3ae9d2ed523d372d62fb3a05816aec5c6cdbc375857260db55ce1827c405b", mc_crypto.CR_NOT_RSA, 19) { return 118 as i32 }
    if !expect("", mc_crypto.CR_NOT_RSA, 20) { return 119 as i32 }
    return 0
}
