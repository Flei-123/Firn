// expect_exit: 0
import std.rt
import mc.mc_text
import mc.mc_chat
import mc.mc_chat_lang

fn line_is(ch: *mut mc_chat.Chat, k: usize, s: str) -> bool {
    if mc_chat.chat_line_len(ch, k) != s.n { return false }
    var i: usize = 0
    while i < s.n {
        if rt.ld8(mc_chat.chat_line_ptr(ch, k), i) != rt.ld8(s.p as u64, i) { return false }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    var tr: mc_text.Translations = mc_text.tr_new()
    var lang: rt.Buf = rt.buf_new()
    mc_chat_lang.lang_basic(&lang)
    mc_text.tr_load(&tr, rt.buf_ptr(&lang), rt.buf_len(&lang))
    rt.buf_free(&lang)
    var ch: mc_chat.Chat = mc_chat.chat_new()
    var doc: mc_text.TextDoc = mc_text.text_new()
    let js: str = "{\"translate\":\"multiplayer.player.joined\",\"with\":[{\"insertion\":\"ChatA\",\"clickEvent\":{\"action\":\"suggest_command\",\"value\":\"/tell ChatA \"},\"hoverEvent\":{\"action\":\"show_entity\",\"contents\":{\"type\":\"minecraft:player\",\"id\":\"6a3a7c0f-3a77-3c5c-8f0e-1b5f4a1f7e11\",\"name\":{\"text\":\"ChatA\"}}},\"text\":\"ChatA\"}],\"color\":\"yellow\"}"
    if !mc_text.text_from_json(&doc, js.p as u64, js.n, &tr) { return 1 }
    mc_chat.chat_add_doc(&ch, &doc, 1000 as u64)
    if mc_chat.chat_line_count(&ch) != 1 { return 2 }
    if !line_is(&ch, 0, "ChatA joined the game") { return 3 }
    mc_text.text_free(&doc)
    return 0
}
