// expect_exit: 0
// Promotion heuristic (compiler/src/promote.rs): a loop with two inner loops
// that may clobber a field gains nothing from keeping that field in a
// register when it is read only once or twice outside those inner loops, so
// the pass leaves such a field in memory. Either way the results must be
// exact: the inner loops store through a raw address that IS the field.

fn ld32(p: usize, i: usize) -> u32 {
    let q: *mut u32 = (p + i * 4) as *mut u32
    return *q
}

fn st32(p: usize, i: usize, v: u32) {
    let q: *mut u32 = (p + i * 4) as *mut u32
    *q = v
}

struct Cfg {
    mode: u32,
    base: usize,
    sum: u64,
}

// `mode` is read once per pass, both inner loops write through `alias`
fn count(c: *mut Cfg, alias: usize, passes: u32) -> u64 {
    var total: u64 = 0
    var done: bool = false
    var n: u32 = 0
    while !done {
        total = total + (*c).mode as u64
        var s: u32 = 0
        while s < 2 {
            st32(alias, 0, ld32(alias, 0) + 1)
            s = s + 1
        }
        var t: u32 = 0
        while t < 3 {
            st32(alias, 0, ld32(alias, 0) + 2)
            t = t + 1
        }
        n = n + 1
        if n == passes {
            done = true
        }
    }
    return total
}

fn main() -> i32 {
    var c: Cfg = Cfg { mode: 1, base: 5, sum: 0 }
    let alias: usize = (&c.mode) as usize
    // pass 1 reads 1; the inner loops add 2 + 6 = 8: 9, 17, 25 ...
    let r: u64 = count(&c, alias, 4)
    if r != 1 + 9 + 17 + 25 { return 1 }
    if c.mode != 33 { return 2 }
    if c.base != 5 { return 3 }
    // alias somewhere else: the field stays put
    var other: [u32; 1] = [0; 1]
    c.mode = 7
    let r2: u64 = count(&c, (&other[0]) as usize, 3)
    if r2 != 21 { return 4 }
    if other[0] != 24 { return 5 }
    if c.mode != 7 { return 6 }
    return 0
}
