// expect_exit: 0
// r234: the remainder item of a crafting ingredient STACK (honey bottle x2+ -> glass bottle) goes into the player inventory in the order of vanilla
// Inventory.add (selected hotbar slot, off hand, first stack with room hotbar -> main, first empty slot hotbar -> main). With no room (vanilla drops it) the click is
// left to the server and NOTHING changes locally (also not partly). Player window: result 0, grid 1..4, hotbar 36..44, off hand 45.
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_schema
import mc.mc_registry
import mc.mc_craft
import mc.mc_craft_sel
import mc.mc_inv

fn it(r: *mut mc_registry.Registry, name: str) -> i32 { return mc_registry.reg_item_by_name(r, name.p as u64, name.n) }

fn layout(ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let id: i32 = mc_version.version_pid(ver, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK)
    if id < 0 { return false }
    let sch: u64 = (*ver).schema_of(mc_version.ST_PLAY, mc_version.DIR_C2S, id)
    if sch == 0 as u64 { return false }
    bytes.bytes_set_pos(b, 0)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk(sch, b, &out)
    rt.buf_free(&out)
    return ok
}

// one click; the packet must parse with the schema of the version; returns the number of changed slots (>= 0) or -1 / -2
fn clk(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32) -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(v, (*ver).protocol, slot, button, mode, &b) { return 0 - 1 }
    let ok: bool = layout(ver, &b)
    var n: i32 = 0
    if (*ver).protocol >= 756 { n = bytes.bytes_at(&b, 6) as i32 }
    bytes.bytes_free(&b)
    if !ok { return 0 - 2 }
    return n
}

fn open_table(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    var typ: i32 = 11
    if (*ver).protocol >= 765 { typ = 12 }
    bytes.put_varint(&b, id)
    bytes.put_varint(&b, typ)
    bytes.put_u8(&b, 0 as u8)
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_open_window_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn total(v: *mut mc_inv.Inv, item: i32) -> i32 {
    var n: i32 = 0
    var k: i32 = 9
    while k < 45 {
        if mc_inv.inv_item(v, k) == item { n = n + mc_inv.inv_count(v, k) }
        k = k + 1
    }
    return n
}

fn fresh(r: *mut mc_registry.Registry, rc: *mut mc_craft.Recipes) -> mc_inv.Inv {
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_use_registry(&v, r)
    if rc != 0 as *mut mc_craft.Recipes { mc_inv.inv_use_recipes(&v, rc) }
    return v
}


fn grid4(v: *mut mc_inv.Inv, it: i32, c: i32) {
    mc_inv.inv_set(v, 1, it, c)
    mc_inv.inv_set(v, 2, it, c)
    mc_inv.inv_set(v, 3, it, c)
    mc_inv.inv_set(v, 4, it, c)
    mc_inv.inv_craft_update(v)
}

fn fill(v: *mut mc_inv.Inv, item: i32, from: i32, to: i32) {
    var k: i32 = from
    while k < to { mc_inv.inv_set(v, k, item, 1); k = k + 1 }
}

fn all4(v: *mut mc_inv.Inv, c: i32) -> bool {
    return mc_inv.inv_count(v, 1) == c && mc_inv.inv_count(v, 2) == c && mc_inv.inv_count(v, 3) == c && mc_inv.inv_count(v, 4) == c
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var r: mc_registry.Registry = ver.registry_of()
    if !mc_registry.registry_ok(&r) { return 101 }
    var rc: mc_craft.Recipes = mc_craft_sel.recipes_for_protocol(p)
    if !mc_craft.craft_ok(&rc) { return 102 }
    let honey: i32 = it(&r, "honey_bottle")
    let hblock: i32 = it(&r, "honey_block")
    let gb: i32 = it(&r, "glass_bottle")
    let dirt: i32 = it(&r, "dirt")
    if honey < 0 || hblock < 0 || gb < 0 || dirt < 0 { return 103 }

    // A: empty inventory, selected slot 0: the first bottle takes the first empty hotbar slot, the others stack on it
    var a: mc_inv.Inv = fresh(&r, &rc)
    grid4(&a, honey, 2)
    if mc_inv.inv_item(&a, 0) != hblock { return 110 }
    if clk(&a, &ver, 0, 0, 0) < 0 || mc_inv.inv_cursor_item(&a) != hblock { return 111 }
    if mc_inv.inv_item(&a, 36) != gb || mc_inv.inv_count(&a, 36) != 4 || !all4(&a, 1) { return 112 }
    mc_inv.inv_free(&a)
    // B: selected slot 3 (internal 39) holding bottles wins over an earlier hotbar stack
    var b: mc_inv.Inv = fresh(&r, &rc)
    mc_inv.inv_set_selected(&b, 3)
    mc_inv.inv_set(&b, 39, gb, 10)
    mc_inv.inv_set(&b, 36, gb, 5)
    grid4(&b, honey, 2)
    if clk(&b, &ver, 0, 0, 0) < 0 || mc_inv.inv_count(&b, 39) != 14 || mc_inv.inv_count(&b, 36) != 5 { return 120 }
    mc_inv.inv_free(&b)
    // B2: an EMPTY selected slot is no stack with room: the first hotbar stack takes the bottles
    var b2: mc_inv.Inv = fresh(&r, &rc)
    mc_inv.inv_set_selected(&b2, 3)
    mc_inv.inv_set(&b2, 41, gb, 5)
    mc_inv.inv_set(&b2, 9, gb, 5)
    grid4(&b2, honey, 2)
    if clk(&b2, &ver, 0, 0, 0) < 0 || mc_inv.inv_count(&b2, 41) != 9 || mc_inv.inv_count(&b2, 9) != 5 || mc_inv.inv_item(&b2, 39) != 0 - 1 { return 121 }
    mc_inv.inv_free(&b2)
    // C: the off hand (45) comes before the other hotbar stacks
    var c: mc_inv.Inv = fresh(&r, &rc)
    mc_inv.inv_set(&c, 36, dirt, 1)
    mc_inv.inv_set(&c, 45, gb, 2)
    mc_inv.inv_set(&c, 37, gb, 5)
    grid4(&c, honey, 2)
    if clk(&c, &ver, 0, 0, 0) < 0 || mc_inv.inv_count(&c, 45) != 6 || mc_inv.inv_count(&c, 37) != 5 { return 130 }
    mc_inv.inv_free(&c)
    // D: a full stack (64) is skipped, the next stack with room takes the bottles; the main inventory is searched after the hotbar
    var d: mc_inv.Inv = fresh(&r, &rc)
    mc_inv.inv_set(&d, 36, dirt, 1)
    mc_inv.inv_set(&d, 37, gb, 64)
    mc_inv.inv_set(&d, 20, gb, 3)
    mc_inv.inv_set(&d, 38, gb, 3)
    grid4(&d, honey, 2)
    if clk(&d, &ver, 0, 0, 0) < 0 || mc_inv.inv_count(&d, 37) != 64 || mc_inv.inv_count(&d, 38) != 7 || mc_inv.inv_count(&d, 20) != 3 { return 140 }
    mc_inv.inv_free(&d)
    // E: no stack with room: the first EMPTY slot, hotbar before main
    var e: mc_inv.Inv = fresh(&r, &rc)
    fill(&e, dirt, 36, 45)
    mc_inv.inv_set(&e, 41, 0 - 1, 0)
    grid4(&e, honey, 2)
    if clk(&e, &ver, 0, 0, 0) < 0 || mc_inv.inv_item(&e, 41) != gb || mc_inv.inv_count(&e, 41) != 4 { return 150 }
    mc_inv.inv_free(&e)
    var e2: mc_inv.Inv = fresh(&r, &rc)
    fill(&e2, dirt, 9, 45)
    mc_inv.inv_set(&e2, 12, 0 - 1, 0)
    mc_inv.inv_set(&e2, 30, 0 - 1, 0)
    grid4(&e2, honey, 2)
    if clk(&e2, &ver, 0, 0, 0) < 0 || mc_inv.inv_item(&e2, 12) != gb || mc_inv.inv_count(&e2, 12) != 4 || mc_inv.inv_item(&e2, 30) != 0 - 1 { return 151 }
    mc_inv.inv_free(&e2)
    // F: inventory full: vanilla would drop the bottles -> left to the server, nothing changes (cursor empty, grid and result intact)
    var f: mc_inv.Inv = fresh(&r, &rc)
    fill(&f, dirt, 9, 45)
    grid4(&f, honey, 2)
    if clk(&f, &ver, 0, 0, 0) < 0 || mc_inv.inv_cursor_item(&f) != 0 - 1 || !all4(&f, 2) || mc_inv.inv_item(&f, 0) != hblock || mc_inv.inv_item(&f, 36) != dirt { return 160 }
    mc_inv.inv_free(&f)
    // F2: room for ONE bottle only, four needed: the first fits, the second does not -> everything undone
    var f2: mc_inv.Inv = fresh(&r, &rc)
    fill(&f2, dirt, 9, 45)
    mc_inv.inv_set(&f2, 20, gb, 63)
    grid4(&f2, honey, 2)
    if clk(&f2, &ver, 0, 0, 0) < 0 || mc_inv.inv_cursor_item(&f2) != 0 - 1 || mc_inv.inv_count(&f2, 20) != 63 || !all4(&f2, 2) || mc_inv.inv_item(&f2, 0) != hblock { return 161 }
    // ... with room for exactly four it works
    mc_inv.inv_set(&f2, 20, gb, 60)
    if clk(&f2, &ver, 0, 0, 0) < 0 || mc_inv.inv_cursor_item(&f2) != hblock || mc_inv.inv_count(&f2, 20) != 64 || !all4(&f2, 1) { return 162 }
    mc_inv.inv_free(&f2)
    // G: shift click: the result needs the only free slot, so the bottles find no room: nothing happens locally
    var g: mc_inv.Inv = fresh(&r, &rc)
    fill(&g, dirt, 9, 45)
    mc_inv.inv_set(&g, 30, 0 - 1, 0)
    grid4(&g, honey, 2)
    if clk(&g, &ver, 0, 0, 1) < 0 || mc_inv.inv_item(&g, 30) != 0 - 1 || !all4(&g, 2) || mc_inv.inv_item(&g, 0) != hblock { return 170 }
    mc_inv.inv_free(&g)
    // H: shift click with room: 3 crafts (stacks of 3: two crafts send a bottle into the inventory, the third leaves it in the grid slot)
    var h: mc_inv.Inv = fresh(&r, &rc)
    grid4(&h, honey, 3)
    if clk(&h, &ver, 0, 0, 1) < 0 { return 180 }
    if mc_inv.inv_item(&h, 44) != hblock || mc_inv.inv_count(&h, 44) != 3 || mc_inv.inv_item(&h, 36) != gb || mc_inv.inv_count(&h, 36) != 8 { return 181 }
    if mc_inv.inv_item(&h, 1) != gb || mc_inv.inv_count(&h, 1) != 1 || mc_inv.inv_item(&h, 4) != gb || mc_inv.inv_item(&h, 0) != 0 - 1 { return 182 }
    mc_inv.inv_free(&h)
    return 0
}

fn main() -> i32 {
    let protos: [i32; 5] = [754, 763, 767, 772, 775]
    var k: usize = 0
    while k < 5 {
        let rcode: i32 = check(protos[k])
        if rcode != 0 { return rcode + (k as i32 + 1) * 1000 }
        k = k + 1
    }
    return 0
}
