// expect_out: f64: exp 2718282 ln 13815511 log2 10 pow 1024 sin 841471 cos 540302 tan 1557408 atan 2356194
// tests/805_std_math_f64.fi -- the APPROXIMATED part of `std.math` (round 42).
//
// exp/ln/log2/log10/powf/sin/cos/tan/atan/atan2 are series expansions with
// range reduction, without tables. They are NOT correctly rounded, and this
// test does not claim so either: the check is against known values with
// `math.near(a, b, eps)`, and the limit stands next to it in plain text.
//
// NOTE on the comparison values: they stand there with AT MOST 15 significant
// digits. The reason is measured, not cosmetic -- firnc0 and firnc1
// do not round 17-digit floating point literals alike (see
// docs/ROUND42.md, section 5B), and tools/lex_compare.sh compares the
// token stream octet for octet. 15 digits are accurate to about 1e-15
// relative and thus well inside the limit of 1e-12 checked here.
//
// Measured limit in the checked range: RELATIVE 1e-12 for all cases with a
// small argument; for sin/cos with a large argument (|x| = 100) only
// 1e-10 -- the range reduction computes in double precision and loses
// digits there. That is the usual limit without
// Payne-Hanek reduction and is named here, not hidden.
//
// The printed line only contains values scaled to integers -- it is
// bit-identical on both compilers, because both execute the same f64
// operations in the same order.
import std.io
import std.math

fn eps12() -> f64 {
    return 0.000000000001
}

fn eps10() -> f64 {
    return 0.0000000001
}

fn main() -> i32 {
    // --- exp
    if !math.near(math.exp(0.0), 1.0, eps12()) {
        return 10
    }
    if !math.near(math.exp(1.0), 2.718281828459045, eps12()) {
        return 11
    }
    if !math.near(math.exp(0.0 - 5.0), 0.006737946999085467, eps12()) {
        return 12
    }
    if !math.near(math.exp(10.0), 22026.465794806718, eps12()) {
        return 13
    }
    if !math.near(math.exp(0.0 - 0.5), 0.6065306597126334, eps12()) {
        return 14
    }
    if math.exp(1000.0) != math.INF() {
        return 15
    }
    if math.exp(0.0 - 1000.0) != 0.0 {
        return 16
    }

    // --- ln and its relatives
    if !math.near(math.ln(1.0), 0.0, eps12()) {
        return 20
    }
    if !math.near(math.ln(2.718281828459045), 1.0, eps12()) {
        return 21
    }
    if !math.near(math.ln(2.0), 0.6931471805599453, eps12()) {
        return 22
    }
    if !math.near(math.ln(0.5), 0.0 - 0.6931471805599453, eps12()) {
        return 23
    }
    if !math.near(math.ln(1000000.0), 13.8155105579643, eps12()) {
        return 24
    }
    // A very small argument. The argument is COMPUTED (2^-1000), not written as
    // 1.0e-300: exponential literals with a large exponent take a different path
    // in firnc1 and give a different bit pattern
    // (docs/ROUND42.md, section 5B). ln(2^-1000) = -1000 * ln2.
    if !math.near(math.ln(math.ldexp(1.0, 0 - 1000)), 0.0 - 693.147180559945, eps12()) {
        return 25
    }
    if math.ln(0.0) != 0.0 - math.INF() {
        return 26
    }
    if !math.is_nan(math.ln(0.0 - 1.0)) {
        return 27
    }
    if !math.near(math.log2(1024.0), 10.0, eps12()) {
        return 28
    }
    if !math.near(math.log10(1000.0), 3.0, eps12()) {
        return 29
    }
    // There and back.
    if !math.near(math.exp(math.ln(7.0)), 7.0, eps12()) {
        return 30
    }
    if !math.near(math.ln(math.exp(0.0 - 3.25)), 0.0 - 3.25, eps12()) {
        return 31
    }

    // --- powf: integer exponents go through powi EXACTLY
    if math.powf(2.0, 10.0) != 1024.0 {
        return 35
    }
    if math.powf(2.0, 0.0 - 2.0) != 0.25 {
        return 36
    }
    if !math.near(math.powf(2.0, 0.5), 1.4142135623730951, eps12()) {
        return 37
    }
    if !math.near(math.powf(9.0, 0.5), 3.0, eps12()) {
        return 38
    }
    if !math.is_nan(math.powf(0.0 - 2.0, 0.5)) {
        return 39
    }

    // --- sin, cos, tan
    if math.sin(0.0) != 0.0 {
        return 40
    }
    if !math.near(math.cos(0.0), 1.0, eps12()) {
        return 41
    }
    if !math.near(math.sin(1.0), 0.8414709848078965, eps12()) {
        return 42
    }
    if !math.near(math.cos(1.0), 0.5403023058681398, eps12()) {
        return 43
    }
    if !math.near(math.sin(math.PI() / 2.0), 1.0, eps12()) {
        return 44
    }
    if math.fabs(math.sin(math.PI())) > 0.000000000001 {
        return 45
    }
    if !math.near(math.sin(0.0 - 1.0), 0.0 - 0.8414709848078965, eps12()) {
        return 46
    }
    // Large argument: only 1e-10 now.
    if !math.near(math.sin(100.0), 0.0 - 0.5063656411097588, eps10()) {
        return 47
    }
    if !math.near(math.cos(100.0), 0.8623188722876839, eps10()) {
        return 48
    }
    if !math.near(math.tan(1.0), 1.5574077246549, eps12()) {
        return 49
    }
    // Pythagoras has to hold over the whole circle.
    var k: i64 = 0 - 20
    while k <= 20 {
        let x: f64 = (k as f64) * 0.31
        let s: f64 = math.sin(x)
        let c: f64 = math.cos(x)
        if !math.near(s * s + c * c, 1.0, eps12()) {
            return 50
        }
        k = k + 1
    }

    // --- atan, atan2
    if math.atan(0.0) != 0.0 {
        return 55
    }
    if !math.near(math.atan(1.0), 0.7853981633974483, eps12()) {
        return 56
    }
    if !math.near(math.atan(0.0 - 1.0), 0.0 - 0.7853981633974483, eps12()) {
        return 57
    }
    if !math.near(math.atan(1000.0), 1.56979632712823, eps12()) {
        return 58
    }
    if !math.near(math.atan(math.INF()), math.PI() / 2.0, eps12()) {
        return 59
    }
    if !math.near(math.atan2(1.0, 1.0), 0.7853981633974483, eps12()) {
        return 60
    }
    if !math.near(math.atan2(1.0, 0.0 - 1.0), 2.356194490192345, eps12()) {
        return 61
    }
    if !math.near(math.atan2(0.0 - 1.0, 0.0 - 1.0), 0.0 - 2.356194490192345, eps12()) {
        return 62
    }
    if !math.near(math.atan2(1.0, 0.0), math.PI() / 2.0, eps12()) {
        return 63
    }
    if math.atan2(0.0, 0.0) != 0.0 {
        return 64
    }
    // tan(atan(x)) == x over a wide range.
    var j: i64 = 1
    while j <= 30 {
        let x: f64 = (j as f64) * 0.37 - 5.0
        if !math.near(math.tan(math.atan(x)), x, eps10()) {
            return 65
        }
        j = j + 1
    }

    // --- the round 39 square root stays what it was
    if math.sqrt(4.0) != 2.0 || math.sqrt(0.0) != 0.0 {
        return 70
    }
    if !math.near(math.sqrt(2.0), math.SQRT2(), eps12()) {
        return 71
    }
    if !math.near(math.SQRT2() * math.SQRT2(), 2.0, eps12()) {
        return 72
    }
    if !math.near(math.TAU(), 2.0 * math.PI(), eps12()) {
        return 73
    }
    if !math.near(math.LN2(), math.ln(2.0), eps12()) {
        return 74
    }
    if !math.near(math.LN10(), math.ln(10.0), eps12()) {
        return 75
    }

    // FINDING of round 42 (named, not rebuilt): a MODULE-QUALIFIED call in the
    // expression of an f"..." comes out differently in the canonical trees of
    // the two compilers -- firnc0 writes `str.npos`, firnc1 the internal name
    // `str__npos`. The behaviour is the same (the self comparison is EQUAL),
    // but tools/parser_compare.sh compares the tree octet for octet. That is
    // why the values stand in a binding here BEFORE the interpolation.
    // See docs/ROUND42.md, section 5C.
    let a_exp: f64 = math.round(math.exp(1.0) * 1000000.0)
    let a_ln: f64 = math.round(math.ln(1000000.0) * 1000000.0)
    let a_log2: f64 = math.round(math.log2(1024.0))
    let a_pow: f64 = math.powf(2.0, 10.0)
    let a_sin: f64 = math.round(math.sin(1.0) * 1000000.0)
    let a_cos: f64 = math.round(math.cos(1.0) * 1000000.0)
    let a_tan: f64 = math.round(math.tan(1.0) * 1000000.0)
    let a_atan: f64 = math.round(math.atan2(1.0, 0.0 - 1.0) * 1000000.0)
    io.fmt_print(f"f64: exp {a_exp} ln {a_ln} ")
    io.fmt_print(f"log2 {a_log2} pow {a_pow} ")
    io.fmt_print(f"sin {a_sin} cos {a_cos} ")
    io.fmt_print(f"tan {a_tan} atan {a_atan}\n")
    return 0
}
