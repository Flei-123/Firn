// expect_out: f64: exp 2718282 ln 13815511 log2 10 pow 1024 sin 841471 cos 540302 tan 1557408 atan 2356194
// tests/805_std_math_f64.fi — der GENAEHERTE Teil von `std.math` (Runde 42).
//
// exp/ln/log2/log10/powf/sin/cos/tan/atan/atan2 sind Reihenentwicklungen mit
// Bereichsreduktion, ohne Tabellen. Sie sind NICHT korrekt gerundet, und
// dieser Test behauptet das auch nicht: geprueft wird gegen bekannte Werte
// mit `math.nahe(a, b, eps)`, und die Schranke steht im Klartext daneben.
//
// ACHTUNG bei den Vergleichswerten: sie stehen mit HOECHSTENS 15 gueltigen
// Ziffern da. Grund ist gemessen, nicht kosmetisch — firnc0 und firnc1
// runden 17-stellige Gleitkommaliterale nicht gleich (siehe
// docs/RUNDE42.md, Abschnitt 5B), und tools/lex_vergleich.sh vergleicht den
// Tokenstrom Oktett fuer Oktett. 15 Ziffern sind relativ ~1e-15 genau und
// damit weit innerhalb der hier gepruefte Schranke von 1e-12.
//
// Gemessene Schranke im geprueften Bereich: RELATIV 1e-12 fuer alle Faelle
// mit kleinem Argument; fuer sin/cos mit grossem Argument (|x| = 100) nur
// noch 1e-10 — die Bereichsreduktion rechnet in doppelter Genauigkeit und
// verliert dort Stellen. Das ist die uebliche Grenze ohne
// Payne-Hanek-Reduktion und wird hier benannt, nicht versteckt.
//
// Die gedruckte Zeile enthaelt nur ganzzahlig skalierte Werte — sie ist auf
// beiden Compilern bitgleich, weil beide dieselben f64-Operationen in
// derselben Reihenfolge ausfuehren.
import std.io
import std.math

fn eps12() -> f64 {
    return 0.000000000001
}

fn eps10() -> f64 {
    return 0.0000000001
}

fn main() -> i32 {
    // --- exp
    if !math.nahe(math.exp(0.0), 1.0, eps12()) {
        return 10
    }
    if !math.nahe(math.exp(1.0), 2.718281828459045, eps12()) {
        return 11
    }
    if !math.nahe(math.exp(0.0 - 5.0), 0.006737946999085467, eps12()) {
        return 12
    }
    if !math.nahe(math.exp(10.0), 22026.465794806718, eps12()) {
        return 13
    }
    if !math.nahe(math.exp(0.0 - 0.5), 0.6065306597126334, eps12()) {
        return 14
    }
    if math.exp(1000.0) != math.INF() {
        return 15
    }
    if math.exp(0.0 - 1000.0) != 0.0 {
        return 16
    }

    // --- ln und seine Verwandten
    if !math.nahe(math.ln(1.0), 0.0, eps12()) {
        return 20
    }
    if !math.nahe(math.ln(2.718281828459045), 1.0, eps12()) {
        return 21
    }
    if !math.nahe(math.ln(2.0), 0.6931471805599453, eps12()) {
        return 22
    }
    if !math.nahe(math.ln(0.5), 0.0 - 0.6931471805599453, eps12()) {
        return 23
    }
    if !math.nahe(math.ln(1000000.0), 13.8155105579643, eps12()) {
        return 24
    }
    // Sehr kleines Argument. Das Argument wird GERECHNET (2^-1000), nicht als
    // 1.0e-300 geschrieben: Exponentialliterale mit grossem Exponenten gehen
    // bei firnc1 durch einen anderen Pfad und ergeben ein anderes Bitmuster
    // (docs/RUNDE42.md, Abschnitt 5B). ln(2^-1000) = -1000 * ln2.
    if !math.nahe(math.ln(math.ldexp(1.0, 0 - 1000)), 0.0 - 693.147180559945, eps12()) {
        return 25
    }
    if math.ln(0.0) != 0.0 - math.INF() {
        return 26
    }
    if !math.ist_nan(math.ln(0.0 - 1.0)) {
        return 27
    }
    if !math.nahe(math.log2(1024.0), 10.0, eps12()) {
        return 28
    }
    if !math.nahe(math.log10(1000.0), 3.0, eps12()) {
        return 29
    }
    // Hin und zurueck.
    if !math.nahe(math.exp(math.ln(7.0)), 7.0, eps12()) {
        return 30
    }
    if !math.nahe(math.ln(math.exp(0.0 - 3.25)), 0.0 - 3.25, eps12()) {
        return 31
    }

    // --- powf: ganzzahlige Exponenten gehen EXAKT ueber powi
    if math.powf(2.0, 10.0) != 1024.0 {
        return 35
    }
    if math.powf(2.0, 0.0 - 2.0) != 0.25 {
        return 36
    }
    if !math.nahe(math.powf(2.0, 0.5), 1.4142135623730951, eps12()) {
        return 37
    }
    if !math.nahe(math.powf(9.0, 0.5), 3.0, eps12()) {
        return 38
    }
    if !math.ist_nan(math.powf(0.0 - 2.0, 0.5)) {
        return 39
    }

    // --- sin, cos, tan
    if math.sin(0.0) != 0.0 {
        return 40
    }
    if !math.nahe(math.cos(0.0), 1.0, eps12()) {
        return 41
    }
    if !math.nahe(math.sin(1.0), 0.8414709848078965, eps12()) {
        return 42
    }
    if !math.nahe(math.cos(1.0), 0.5403023058681398, eps12()) {
        return 43
    }
    if !math.nahe(math.sin(math.PI() / 2.0), 1.0, eps12()) {
        return 44
    }
    if math.fabs(math.sin(math.PI())) > 0.000000000001 {
        return 45
    }
    if !math.nahe(math.sin(0.0 - 1.0), 0.0 - 0.8414709848078965, eps12()) {
        return 46
    }
    // Grosses Argument: nur noch 1e-10.
    if !math.nahe(math.sin(100.0), 0.0 - 0.5063656411097588, eps10()) {
        return 47
    }
    if !math.nahe(math.cos(100.0), 0.8623188722876839, eps10()) {
        return 48
    }
    if !math.nahe(math.tan(1.0), 1.5574077246549, eps12()) {
        return 49
    }
    // Der Pythagoras muss ueber den ganzen Kreis halten.
    var k: i64 = 0 - 20
    while k <= 20 {
        let x: f64 = (k as f64) * 0.31
        let s: f64 = math.sin(x)
        let c: f64 = math.cos(x)
        if !math.nahe(s * s + c * c, 1.0, eps12()) {
            return 50
        }
        k = k + 1
    }

    // --- atan, atan2
    if math.atan(0.0) != 0.0 {
        return 55
    }
    if !math.nahe(math.atan(1.0), 0.7853981633974483, eps12()) {
        return 56
    }
    if !math.nahe(math.atan(0.0 - 1.0), 0.0 - 0.7853981633974483, eps12()) {
        return 57
    }
    if !math.nahe(math.atan(1000.0), 1.56979632712823, eps12()) {
        return 58
    }
    if !math.nahe(math.atan(math.INF()), math.PI() / 2.0, eps12()) {
        return 59
    }
    if !math.nahe(math.atan2(1.0, 1.0), 0.7853981633974483, eps12()) {
        return 60
    }
    if !math.nahe(math.atan2(1.0, 0.0 - 1.0), 2.356194490192345, eps12()) {
        return 61
    }
    if !math.nahe(math.atan2(0.0 - 1.0, 0.0 - 1.0), 0.0 - 2.356194490192345, eps12()) {
        return 62
    }
    if !math.nahe(math.atan2(1.0, 0.0), math.PI() / 2.0, eps12()) {
        return 63
    }
    if math.atan2(0.0, 0.0) != 0.0 {
        return 64
    }
    // tan(atan(x)) == x ueber einen weiten Bereich.
    var j: i64 = 1
    while j <= 30 {
        let x: f64 = (j as f64) * 0.37 - 5.0
        if !math.nahe(math.tan(math.atan(x)), x, eps10()) {
            return 65
        }
        j = j + 1
    }

    // --- die Runde-39-Wurzel bleibt, was sie war
    if math.sqrt(4.0) != 2.0 || math.sqrt(0.0) != 0.0 {
        return 70
    }
    if !math.nahe(math.sqrt(2.0), math.SQRT2(), eps12()) {
        return 71
    }
    if !math.nahe(math.SQRT2() * math.SQRT2(), 2.0, eps12()) {
        return 72
    }
    if !math.nahe(math.TAU(), 2.0 * math.PI(), eps12()) {
        return 73
    }
    if !math.nahe(math.LN2(), math.ln(2.0), eps12()) {
        return 74
    }
    if !math.nahe(math.LN10(), math.ln(10.0), eps12()) {
        return 75
    }

    // BEFUND Runde 42 (benannt, nicht umgebaut): ein MODULQUALIFIZIERTER
    // Aufruf im Ausdruck eines f"..." kommt in den kanonischen Baeumen der
    // beiden Compiler verschieden heraus — firnc0 schreibt `str.npos`,
    // firnc1 den internen Namen `str__npos`. Das Verhalten ist gleich (der
    // Selbstvergleich ist GLEICH), aber tools/parser_vergleich.sh vergleicht
    // den Baum Oktett fuer Oktett. Deshalb stehen die Werte hier VOR der
    // Interpolation in einer Bindung. Siehe docs/RUNDE42.md, Abschnitt 5C.
    let a_exp: f64 = math.round(math.exp(1.0) * 1000000.0)
    let a_ln: f64 = math.round(math.ln(1000000.0) * 1000000.0)
    let a_log2: f64 = math.round(math.log2(1024.0))
    let a_pow: f64 = math.powf(2.0, 10.0)
    let a_sin: f64 = math.round(math.sin(1.0) * 1000000.0)
    let a_cos: f64 = math.round(math.cos(1.0) * 1000000.0)
    let a_tan: f64 = math.round(math.tan(1.0) * 1000000.0)
    let a_atan: f64 = math.round(math.atan2(1.0, 0.0 - 1.0) * 1000000.0)
    io.fmt_druck(f"f64: exp {a_exp} ln {a_ln} ")
    io.fmt_druck(f"log2 {a_log2} pow {a_pow} ")
    io.fmt_druck(f"sin {a_sin} cos {a_cos} ")
    io.fmt_druck(f"tan {a_tan} atan {a_atan}\n")
    return 0
}
