// expect_out: x = 41, y = 42 | leer | rechnung: 83 | mehrere: 1 2 3 | typen: -5 7 200 true | schachtel: f(9) = 81 | grenze: -9223372036854775807 | helfer sagt 7
// tests/791_interpolation_core.fi -- string interpolation (round 39).
//
// `f"..."` is taken apart AT COMPILE TIME into a chain of calls on the
// Fmt builder from `std.io` -- no varargs, no parsing at run time:
//
//   f"x = {x}"  ==>  io.fmt_text(io.fmt_number(io.fmt_text(io.fmt_new(),
//                                &_fseg0[0], 4), (x) as i64), ...)
//
// Checked: several segments and expressions, an empty body part,
// expressions with operators and calls, the scalars i32/u64/u8/bool
// (they are shown the way i64 is -- the honestly documented limit of the
// core version), i64::MIN+1, and an interpolation in an IMPORTED
// module (tests/modules/fhelper.fi).
import std.io
import modules.fhelper

fn square(a: i32) -> i32 {
    return a * a
}

fn main() -> i32 {
    let x: i32 = 41
    let y: i32 = x + 1
    io.fmt_print(f"x = {x}, y = {y} | leer | rechnung: {x * 2 + 1} | ")
    let a: i32 = 1
    let b: i32 = 2
    let c: i32 = 3
    io.fmt_print(f"mehrere: {a} {b} {c} | ")
    let neg: i32 = 0 - 5
    let big: u64 = 7
    let small: u8 = 200
    let w: bool = true
    io.fmt_print(f"typen: {neg} {big} {small} {w} | ")
    io.fmt_print(f"schachtel: f(9) = {square(9)} | ")
    let limit: i64 = 0 - 9223372036854775807
    io.fmt_print(f"grenze: {limit} | ")
    io.fmt_print(fhelper.message(7))
    return 0
}
