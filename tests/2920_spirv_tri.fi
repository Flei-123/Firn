// expect_exit: 0
// tests/2920_spirv_tri.fi -- gpu.spirv: parse + run the committed tri.vert / tri.frag (glslang output, spirv-val clean).
import std.rt
import gpu.spirv

const VS: str = __include_str("../lib/gpu/spv/tri.vert.spv")
const FS: str = __include_str("../lib/gpu/spv/tri.frag.spv")

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    var v: spirv.Spv = spirv.spv_zero()
    check(spirv.spv_new(VS.p as u64, VS.n, &v), 1)
    let ent: u32 = spirv.spv_find_entry(&v, 0)
    check(ent != 0, 2)
    let pos: usize = spirv.spv_find_location(&v, 1, 0)
    let col: usize = spirv.spv_find_location(&v, 1, 1)
    let vcol: usize = spirv.spv_find_location(&v, 3, 0)
    let gp: usize = spirv.spv_find_builtin(&v, 3, 0)
    check(pos != spirv.SPV_NONE && col != spirv.SPV_NONE && vcol != spirv.SPV_NONE && gp != spirv.SPV_NONE, 3)
    spirv.spv_mem_set_f32(&v, pos, 0, 0.5)
    spirv.spv_mem_set_f32(&v, pos, 1, -0.25)
    spirv.spv_mem_set_f32(&v, col, 0, 1.0)
    spirv.spv_mem_set_f32(&v, col, 1, 0.5)
    spirv.spv_mem_set_f32(&v, col, 2, 0.25)
    check(spirv.spv_run(&v, ent, 1000), 4)
    check(spirv.spv_mem_get_f32(&v, gp, 0) == 0.5, 5)
    check(spirv.spv_mem_get_f32(&v, gp, 1) == -0.25, 6)
    check(spirv.spv_mem_get_f32(&v, gp, 2) == 0.0, 7)
    check(spirv.spv_mem_get_f32(&v, gp, 3) == 1.0, 8)
    check(spirv.spv_mem_get_f32(&v, vcol, 0) == 1.0, 9)
    check(spirv.spv_mem_get_f32(&v, vcol, 1) == 0.5, 10)
    check(spirv.spv_mem_get_f32(&v, vcol, 2) == 0.25, 11)
    spirv.spv_free(&v)

    var f: spirv.Spv = spirv.spv_zero()
    check(spirv.spv_new(FS.p as u64, FS.n, &f), 20)
    let fe: u32 = spirv.spv_find_entry(&f, 4)
    check(fe != 0, 21)
    let fin: usize = spirv.spv_find_location(&f, 1, 0)
    let fout: usize = spirv.spv_find_location(&f, 3, 0)
    spirv.spv_mem_set_f32(&f, fin, 0, 0.125)
    spirv.spv_mem_set_f32(&f, fin, 1, 0.5)
    spirv.spv_mem_set_f32(&f, fin, 2, 0.75)
    check(spirv.spv_run(&f, fe, 1000), 22)
    check(spirv.spv_mem_get_f32(&f, fout, 0) == 0.125, 23)
    check(spirv.spv_mem_get_f32(&f, fout, 1) == 0.5, 24)
    check(spirv.spv_mem_get_f32(&f, fout, 2) == 0.75, 25)
    check(spirv.spv_mem_get_f32(&f, fout, 3) == 1.0, 26)
    spirv.spv_free(&f)
    return 0
}
