// expect_exit: 0
import jxl.jxl
import jxl.jxl_dither
import jxl.jxl_f32
import std.fs
import std.rt

static mut failures: i32 = 0
static mut mismatches: usize = 0
static mut total_samples: usize = 0
static mut max_diff: i32 = 0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn body_offset(d: *mut rt.Buf, n: usize, lines: u32) -> usize {
    var nl: u32 = 0
    var i: usize = 0
    while i < n && nl < lines {
        if rt.ld8(rt.buf_ptr(d), i) == 10 {
            nl = nl + 1
        }
        i = i + 1
    }
    return i
}

fn sample_at(p: u64, i: usize, wide: bool, big_endian: bool) -> i32 {
    if !wide {
        return rt.ld8(p, i) as i32
    }
    let a: i32 = rt.ld8(p, i * 2) as i32
    let b: i32 = rt.ld8(p, i * 2 + 1) as i32
    if big_endian {
        return a * 256 + b
    }
    return b * 256 + a
}

fn measure(path: str, ref_path: str, channels: u32, wide: bool) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    var ref: rt.Buf = rt.buf_new()
    let rn: usize = fs.read_file(ref_path, &ref) catch 0
    check(n != 0 && rn != 0)
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let ok: bool = jxl.jxl_decode(rt.buf_ptr(&data), n, &pic) catch false
    check(ok)
    mismatches = 0
    total_samples = 1
    max_diff = 99
    if ok {
        var bps: usize = 1
        if wide {
            bps = 2
        }
        let count: usize = (pic.width as usize) * (pic.height as usize) * (channels as usize)
        let off: usize = body_offset(&ref, rn, 3)
        check(pic.channels == channels && (pic.bytes_per_sample as usize) == bps && pic.size == count * bps && rn >= off + count * bps)
        if pic.size == count * bps && rn >= off + count * bps {
            let base: u64 = rt.buf_ptr(&ref) + (off as u64)
            var bad: usize = 0
            var worst: i32 = 0
            var i: usize = 0
            while i < count {
                var e: i32 = sample_at(pic.data, i, wide, false) - sample_at(base, i, wide, true)
                if e < 0 {
                    e = 0 - e
                }
                if e != 0 {
                    bad = bad + 1
                }
                if e > worst {
                    worst = e
                }
                i = i + 1
            }
            mismatches = bad
            total_samples = count
            max_diff = worst
        }
    }
    jxl.jxl_picture_free(&pic)
    rt.buf_free(&data)
    rt.buf_free(&ref)
}

fn expect(jxl_path: str, ref_path: str, wide: bool, max_allowed: i32, limit_per_10k: usize) {
    measure(jxl_path, ref_path, 3, wide)
    check(max_diff <= max_allowed)
    check(mismatches * 10000 <= limit_per_10k * total_samples)
}

fn check_dither_offsets() {
    let plain: jxl_dither.JxlDither = jxl_dither.dither_new(1, 64, 48, 0, 0)
    let moved: jxl_dither.JxlDither = jxl_dither.dither_new(1, 64, 48, 5, 3)
    let flipped: jxl_dither.JxlDither = jxl_dither.dither_new(3, 64, 48, 0, 0)
    var y: usize = 0
    while y < 20 {
        var x: usize = 0
        while x < 40 {
            var c: usize = 0
            while c < 4 {
                check(jxl_dither.dither_offset(&moved, x, y, c) == jxl_dither.dither_offset(&plain, x + 5, y + 3, c))
                check(jxl_dither.dither_offset(&flipped, x, y, c) == jxl_dither.dither_offset(&plain, 63 - x, 47 - y, c))
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn check_f32_helpers() {
    check(jxl_f32.nearest_int(2.5) == 2)
    check(jxl_f32.nearest_int(3.5) == 4)
    check(jxl_f32.nearest_int(3.49) == 3)
    check(jxl_f32.nearest_int(0.0 - 0.0) == 0)
    check(jxl_f32.fast_erff(0.0) == 0.0)
    check(jxl_f32.fast_erff(0.0 - 1.0) == 0.0 - jxl_f32.fast_erff(1.0))
    let e: f64 = jxl_f32.fast_erff(1.0)
    check(e > 0.8426 && e < 0.8436)
    check(jxl_f32.round32(0.1) != 0.1)
}

fn main() -> i32 {
    expect("tests/data/jxl/spl/s300x200_e7_a.jxl", "tests/data/jxl/spl/s300x200_e7_a.ppm", false, 1, 1)
    expect("tests/data/jxl/spl/s300x200_e7_b.jxl", "tests/data/jxl/spl/s300x200_e7_b.ppm", false, 1, 1)
    expect("tests/data/jxl/spl/t64_e7_a.jxl", "tests/data/jxl/spl/t64_e7_a.ppm", false, 1, 3)
    expect("tests/data/jxl/spl/t64_e7_b.jxl", "tests/data/jxl/spl/t64_e7_b.ppm", false, 1, 3)
    expect("tests/data/jxl/vd/d16_300.jxl", "tests/data/jxl/vd/d16_300.ppm", true, 2, 250)
    expect("tests/data/jxl/vd/d16_64.jxl", "tests/data/jxl/vd/d16_64.ppm", true, 2, 250)
    check_dither_offsets()
    check_f32_helpers()
    return failures
}
