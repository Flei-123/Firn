// expect_exit: 0
// r174: rt.mem_copy / mem_set / mem_eq work in words now. Cross-check
// against plain octet loops for every length 0..75 and all alignments of
// source and target 0..8: result, and the octets in front of and behind
// the target must stay untouched.
import std.rt

fn fill_pattern(p: u64, n: usize, seed: u64) {
    var i: usize = 0
    var x: u64 = seed
    while i < n {
        x = (x * 1103515245 + 12345) % 2147483648
        rt.st8(p, i, ((x / 256) % 251) as u8)
        i = i + 1
    }
}

fn main() -> i32 {
    let cap: usize = 256
    let src: u64 = rt.heap_alloc(cap)
    let dst: u64 = rt.heap_alloc(cap)
    let ref: u64 = rt.heap_alloc(cap)
    var n: usize = 0
    while n < 76 {
        var so: usize = 0
        while so < 9 {
            var to: usize = 0
            while to < 9 {
                fill_pattern(src, cap, 11 + n as u64)
                fill_pattern(dst, cap, 99)
                fill_pattern(ref, cap, 99)
                // reference: octet loop
                var i: usize = 0
                while i < n {
                    rt.st8(ref, 16 + to + i, rt.ld8(src, 16 + so + i))
                    i = i + 1
                }
                rt.mem_copy(dst + 16 + to as u64, src + 16 + so as u64, n)
                if !rt.mem_eq(dst, ref, cap) {
                    return 1
                }
                // mem_eq must see a difference in any single octet
                if n > 0 {
                    let at: usize = 16 + to + (n - 1)
                    rt.st8(dst, at, rt.ld8(dst, at) + 1 as u8)
                    if rt.mem_eq(dst, ref, cap) {
                        return 2
                    }
                    if rt.mem_eq(dst + 16 + to as u64, ref + 16 + to as u64, n - 1) == false {
                        return 3
                    }
                }
                // mem_set against the reference
                fill_pattern(dst, cap, 5)
                fill_pattern(ref, cap, 5)
                i = 0
                while i < n {
                    rt.st8(ref, 20 + to + i, 0xA7 as u8)
                    i = i + 1
                }
                rt.mem_set(dst + 20 + to as u64, 0xA7 as u8, n)
                if !rt.mem_eq(dst, ref, cap) {
                    return 4
                }
                to = to + 1
            }
            so = so + 1
        }
        n = n + 1
    }
    // overlapping forward copy (LZ match), distance 8..40: must equal the
    // octet loop that repeats the pattern
    var dist: usize = 8
    while dist < 41 {
        var m: usize = 0
        while m < 100 {
            fill_pattern(dst, cap, 7 + dist as u64)
            fill_pattern(ref, cap, 7 + dist as u64)
            var j: usize = 0
            while j < m {
                rt.st8(ref, 64 + j, rt.ld8(ref, 64 + j - dist))
                j = j + 1
            }
            rt.mem_copy(dst + 64, dst + 64 - dist as u64, m)
            if !rt.mem_eq(dst, ref, cap) {
                return 5
            }
            m = m + 1
        }
        dist = dist + 1
    }
    return 0
}
