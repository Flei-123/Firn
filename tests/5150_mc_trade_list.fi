// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_trade

fn put_stack(b: *mut bytes.Bytes, p: i32, item: i32, count: i32) {
    if p >= 766 {
        bytes.put_varint(b, count)
        bytes.put_varint(b, item)
        bytes.put_varint(b, 0)
        bytes.put_varint(b, 0)
    } else {
        bytes.put_bool(b, true)
        bytes.put_varint(b, item)
        bytes.put_i8(b, count as i8)
        bytes.put_u8(b, 0 as u8)
    }
}

fn put_cost(b: *mut bytes.Bytes, p: i32, item: i32, count: i32) {
    if p >= 766 {
        bytes.put_varint(b, item)
        bytes.put_varint(b, count)
        bytes.put_varint(b, 0)
    } else {
        put_stack(b, p, item, count)
    }
}

fn put_trade(b: *mut bytes.Bytes, p: i32, i: i32, second: bool, disabled: bool) {
    put_cost(b, p, 3 + i, 22)
    put_stack(b, p, 9, 1)
    if p >= 766 {
        bytes.put_bool(b, second)
        if second { put_cost(b, p, 5, 2) }
    } else {
        if second { put_stack(b, p, 5, 2) } else { bytes.put_bool(b, false) }
    }
    bytes.put_bool(b, disabled)
    bytes.put_i32(b, 1)
    bytes.put_i32(b, 12)
    bytes.put_i32(b, 5)
    bytes.put_i32(b, 0 - 2)
    bytes.put_f32(b, 0.05 as f32)
    bytes.put_i32(b, 3)
}

fn build(p: i32, count: i32, b: *mut bytes.Bytes) {
    bytes.put_varint(b, 7)
    bytes.put_varint(b, count)
    var i: i32 = 0
    while i < count {
        put_trade(b, p, i, i == 1, i == 1)
        i = i + 1
    }
    bytes.put_varint(b, 2)
    bytes.put_varint(b, 10)
    bytes.put_bool(b, true)
    bytes.put_bool(b, true)
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var t: mc_trade.Trades = mc_trade.tr_new()
    var b: bytes.Bytes = bytes.bytes_new()
    build(p, 2, &b)
    bytes.bytes_set_pos(&b, 0)
    if !mc_trade.tr_on_list(&t, &ver, &b) { return 101 }
    if mc_trade.tr_window(&t) != 7 { return 102 }
    if mc_trade.tr_count(&t) != 2 { return 103 }
    if mc_trade.tr_level(&t) != 2 || mc_trade.tr_xp(&t) != 10 { return 104 }
    if !mc_trade.tr_regular(&t) || !mc_trade.tr_restock(&t) { return 105 }
    if mc_trade.tr_item_a(&t, 0) != 3 || mc_trade.tr_item_a(&t, 1) != 4 { return 110 }
    if mc_trade.tr_base_a(&t, 0) != 22 { return 111 }
    if mc_trade.tr_cost_a(&t, 0) != 23 { return 112 }
    if mc_trade.tr_item_r(&t, 0) != 9 || mc_trade.tr_count_r(&t, 0) != 1 { return 113 }
    if mc_trade.tr_item_b(&t, 0) != 0 - 1 || mc_trade.tr_count_b(&t, 0) != 0 { return 114 }
    if mc_trade.tr_item_b(&t, 1) != 5 || mc_trade.tr_count_b(&t, 1) != 2 { return 115 }
    if mc_trade.tr_out_of_stock(&t, 0) || !mc_trade.tr_out_of_stock(&t, 1) { return 120 }
    if mc_trade.tr_uses(&t, 0) != 1 || mc_trade.tr_max_uses(&t, 0) != 12 || mc_trade.tr_trade_xp(&t, 0) != 5 { return 121 }
    bytes.bytes_free(&b)
    return 0
}

fn check_scroll(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 200 }
    var t: mc_trade.Trades = mc_trade.tr_new()
    var b: bytes.Bytes = bytes.bytes_new()
    build(p, 10, &b)
    bytes.bytes_set_pos(&b, 0)
    if !mc_trade.tr_on_list(&t, &ver, &b) { return 201 }
    if mc_trade.tr_count(&t) != 10 { return 202 }
    if mc_trade.tr_visible(&t) != 7 || mc_trade.tr_max_scroll(&t) != 3 { return 203 }
    mc_trade.tr_scroll_by(&t, 5)
    if mc_trade.tr_scroll(&t) != 3 || mc_trade.tr_visible(&t) != 7 { return 204 }
    if mc_trade.tr_index_of_row(&t, 0) != 3 || mc_trade.tr_index_of_row(&t, 6) != 9 || mc_trade.tr_index_of_row(&t, 7) != 0 - 1 { return 205 }
    mc_trade.tr_scroll_by(&t, 0 - 9)
    if mc_trade.tr_scroll(&t) != 0 { return 206 }
    if !mc_trade.tr_select(&t, 8) || mc_trade.tr_selected(&t) != 8 { return 207 }
    if mc_trade.tr_select(&t, 10) || mc_trade.tr_select(&t, 0 - 1) { return 208 }
    mc_trade.tr_scroll_by(&t, 2)
    bytes.bytes_free(&b)
    var b2: bytes.Bytes = bytes.bytes_new()
    build(p, 3, &b2)
    bytes.bytes_set_pos(&b2, 0)
    if !mc_trade.tr_on_list(&t, &ver, &b2) { return 209 }
    if mc_trade.tr_count(&t) != 3 || mc_trade.tr_scroll(&t) != 0 || mc_trade.tr_selected(&t) != 0 { return 210 }
    bytes.bytes_free(&b2)
    mc_trade.tr_clear(&t)
    if mc_trade.tr_count(&t) != 0 || mc_trade.tr_window(&t) != 0 - 1 { return 211 }
    return 0
}

fn price_checks() -> i32 {
    if mc_trade.tr_price_cost(22, 0 - 2, 3, 0.05 as f32) != 23 { return 300 }
    if mc_trade.tr_price_cost(1, 0 - 5, 0, 0.0 as f32) != 1 { return 301 }
    if mc_trade.tr_price_cost(60, 20, 10, 0.5 as f32) != 64 { return 302 }
    if mc_trade.tr_price_cost(10, 0, 0 - 4, 0.5 as f32) != 10 { return 303 }
    if mc_trade.tr_price_cost(5, 0, 2, 0.2 as f32) != 7 { return 304 }
    return 0
}

fn main() -> i32 {
    var rc: i32 = check(763)
    if rc != 0 { return rc }
    rc = check(769)
    if rc != 0 { return rc + 1000 }
    rc = check_scroll(763)
    if rc != 0 { return rc }
    rc = check_scroll(769)
    if rc != 0 { return rc + 1000 }
    return price_checks()
}
