// expect_exit: 0
// ROUND OWN-2: `fn drop(inout self)` runs by itself where the owner dies --
// at the end of the block, in REVERSE order of declaration, once per value:
// a moved value is dropped by its new owner only. Fields follow their
// struct (in order of declaration). `LOG` records the ids as decimal digits.
static mut LOG: i64 = 0

struct Guard { id: i64 }

impl Guard {
    fn drop(inout self) {
        LOG = LOG * 10 + self.id
    }
}

struct Pair { a: Guard, b: Guard }

fn mk(id: i64) -> Guard { return Guard { id: id } }
fn eat(g: Guard) {}
fn pass(g: Guard) -> Guard { return g }

fn early(c: bool) -> i64 {
    let a: Guard = mk(1)
    if c {
        return 7
    }
    let b: Guard = mk(2)
    return 8
}

fn both(c: bool) {
    let g: Guard = mk(4)
    if c {
        eat(g)
    } else {
        let h: Guard = mk(5)
        eat(g)
    }
}

fn leave_in_loop() {
    var i: i64 = 0
    while i < 5 {
        let g: Guard = mk(i + 1)
        i += 1
        if i == 2 { continue }
        if i == 4 { break }
    }
}

fn main() -> i32 {
    {
        let a: Guard = mk(1)
        let b: Guard = mk(2)
    }
    if LOG != 21 { return 1 }

    LOG = 0
    {
        let a: Guard = mk(3)
        eat(a)
        let b: Guard = mk(4)
    }
    if LOG != 34 { return 2 }

    LOG = 0
    {
        let a: Guard = mk(5)
        let b: Guard = pass(a)
    }
    if LOG != 5 { return 3 }

    LOG = 0
    if early(true) != 7 { return 4 }
    if LOG != 1 { return 5 }
    LOG = 0
    if early(false) != 8 { return 6 }
    if LOG != 21 { return 7 }

    LOG = 0
    {
        var g: Guard = mk(6)
        g = mk(7)
    }
    if LOG != 67 { return 8 }

    LOG = 0
    {
        var g: Guard = mk(1)
        eat(g)
        g = mk(2)
    }
    if LOG != 12 { return 9 }

    LOG = 0
    {
        let p: Pair = Pair { a: mk(1), b: mk(2) }
    }
    if LOG != 12 { return 10 }

    LOG = 0
    both(true)
    if LOG != 4 { return 11 }
    LOG = 0
    both(false)
    if LOG != 45 { return 12 }

    LOG = 0
    leave_in_loop()
    // rounds: 1 -> 1, 2 (continue) -> 2, 3 -> 3, 4 (break) -> 4
    if LOG != 1234 { return 13 }

    LOG = 0
    {
        let arr: [Guard; 2] = [mk(1), mk(2)]
    }
    if LOG != 12 { return 14 }
    return 0
}
