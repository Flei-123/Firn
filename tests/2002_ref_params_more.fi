// expect_exit: 0
// ROUND REF3: reference parameters `x: &T` / `x: inout T` in generic
// functions, methods and closures (and not only in plain functions).
struct Acc { n: i64, hist: [i64; 3] }

fn bump[T: Int](x: inout T) { *x = *x + 1 }
fn peek[T: Int](x: &T) -> T { return *x }
fn put[T: Int](a: inout[T; 3], v: T) { a[1] = v }

impl Acc {
    fn add(*mut self, by: i64, out: inout Acc) {
        (*self).n += by
        out.n += by * 2
        out.hist[0] = by
    }
    fn total(*self, other: &Acc) -> i64 {
        return (*self).n + other.n + other.hist[0]
    }
}

fn main() -> i32 {
    var a: i64 = 1
    bump[i64](inout a)
    bump[i64](inout a)
    if a != 3 { return 1 }
    if peek[i64](&a) != 3 { return 2 }
    var h: [u8; 3] = [0, 0, 0]
    put[u8](inout h, 9)
    if h[1] != 9 { return 3 }
    var x: Acc = Acc { n: 1, hist: [0, 0, 0] }
    var y: Acc = Acc { n: 10, hist: [0, 0, 0] }
    x.add(5, inout y)
    if x.n != 6 { return 4 }
    if y.n != 20 { return 5 }
    if y.hist[0] != 5 { return 6 }
    if x.total(&y) != 6 + 20 + 5 { return 7 }
    let f: fn(*Acc) -> i64 = fn(s: &Acc) -> i64 { return s.n + s.hist[0] }
    if f(&y) != 25 { return 8 }
    var k: i64 = 0
    let g: fn(*mut i64) = fn(c: inout i64) { *c = *c + 7 }
    g(inout k)
    if k != 7 { return 9 }
    return 0
}
