// expect_exit: 0
import std.rt
import std.env
import mc.mc_item_src
import mc.mc_raster
import mc.mc_trade_ui

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn main() -> i32 {
    if !env.has("MC_VANILLA_JAR") { return 0 }
    var p: i32 = 763
    if env.has("SPR_NEW") { p = 769 }
    var src: mc_item_src.ItemSrc = mc_item_src.isrc_new()
    check(mc_item_src.isrc_open(&src, p), 1)
    var u: mc_trade_ui.TradeUi = mc_trade_ui.tui_new()
    check(mc_trade_ui.tui_open(&u, &src), 2)
    var r: mc_raster.Raster = mc_raster.raster_new(300 * 2, 170 * 2)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_trade_ui.tui_draw_strike(&r, &u, 0, 0, 2, 1)
    var x: i32 = 0
    var y: i32 = 0
    mc_trade_ui.tui_strike_xy(1, &x, &y)
    check(x == 17 && y == 51, 3)
    let red: u32 = rt.ld32(r.color, ((y * 2) as usize) * (r.w as usize) + ((x * 2) as usize))
    check(red == (0xFF0F37BA as u32), 4)
    let grey: u32 = rt.ld32(r.color, (((y + 1) * 2) as usize) * (r.w as usize) + (((x + 4) * 2) as usize))
    check(grey == (0xFF373737 as u32), 5)
    let blank: u32 = rt.ld32(r.color, (((y + 1) * 2) as usize) * (r.w as usize) + ((x * 2) as usize))
    check(blank == (0xFF000000 as u32), 6)
    return 0
}
