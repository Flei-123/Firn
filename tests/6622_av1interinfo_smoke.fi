// expect_exit: 0
import media.video.vp9.vp9mem
import media.video.av1.av1blkst
import media.video.av1.av1blkdat
import media.video.av1.av1cdfctx
import media.video.av1.av1fhdr
import media.video.av1.av1seq
import media.video.av1.av1sym
import media.video.av1.av1interdef
import media.video.av1.av1interinfo

fn fill(buf: u64, n: i64, seed: i64) {
    var x: i64 = (seed * 2654435761 + 12345) & 2147483647
    var i: i64 = 0
    while i < n {
        x = (x * 1103515245 + 12345) & 2147483647
        av1blkst.st(buf, i, x >> 16)
        i = i + 1
    }
}

fn store_basic(td: *mut av1blkst.TileDec) {
    var y: i64 = 0
    while y < (*td).bh4 {
        var x: i64 = 0
        while x < (*td).bw4 {
            let r: i64 = (*td).mi_row + y
            let c: i64 = (*td).mi_col + x
            if r < (*td).mi_rows && c < (*td).mi_cols {
                av1blkst.mi_set(td, (*td).mi_size_a, r, c, (*td).mi_size)
                av1blkst.mi_set(td, (*td).skip_a, r, c, (*td).skip)
                av1blkst.mi_set(td, (*td).seg_a, r, c, (*td).segment_id)
                av1blkst.mi_set(td, (*td).ymode_a, r, c, (*td).y_mode)
                av1blkst.mi_set(td, (*td).inter_a, r, c, (*td).is_inter)
            }
            x = x + 1
        }
        y = y + 1
    }
}

fn check_block(td: *mut av1blkst.TileDec) -> bool {
    let r0: i64 = (*td).ref_frame[0]
    let r1: i64 = (*td).ref_frame[1]
    if r0 < 0 || r0 > 7 || r1 < 0 - 1 || r1 > 7 {
        return false
    }
    if (*td).is_inter == 0 {
        return r0 == 0 && r1 == 0 - 1 && (*td).y_mode < 13
    }
    if r0 < 1 || (*td).y_mode < 13 || (*td).y_mode > 24 {
        return false
    }
    if av1interdef.is_compound_mode((*td).y_mode) != (r1 > 0) {
        return false
    }
    if (*td).interp_filter[0] > 2 || (*td).interp_filter[1] > 2 || (*td).motion_mode > 2 || (*td).ref_mv_idx > 3 {
        return false
    }
    if (*td).compound_type < 0 || (*td).compound_type > 4 || (*td).num_samples > 8 {
        return false
    }
    if (*td).motion_mode == 2 && (*td).num_samples == 0 {
        return false
    }
    if r1 > 0 && ((*td).interintra != 0 || (*td).motion_mode != 0) {
        return false
    }
    var k: usize = 0
    while k < 4 {
        if (*td).mvs[k] < 0 - 32768 || (*td).mvs[k] > 32767 {
            return false
        }
        k = k + 1
    }
    return true
}

fn run_case(seed: i64, stats: *mut [i64; 4]) -> bool {
    let seq: *mut av1seq.SeqHdr = av1seq.seq_new()
    (*seq).subsampling_x = 1
    (*seq).subsampling_y = 1
    (*seq).num_planes = 3
    (*seq).bit_depth = 8
    (*seq).enable_cdef = 1
    (*seq).enable_interintra_compound = 1
    (*seq).enable_masked_compound = seed & 1
    (*seq).enable_warped_motion = 1
    (*seq).enable_dual_filter = (seed >> 1) & 1
    (*seq).enable_order_hint = 1
    (*seq).order_hint_bits = 7
    (*seq).enable_jnt_comp = 1
    let fh: *mut av1fhdr.FrameHdr = av1fhdr.fhdr_new()
    (*fh).frame_is_intra = 0
    (*fh).mi_rows = 24
    (*fh).mi_cols = 32
    (*fh).frame_width = 128
    (*fh).frame_height = 96
    (*fh).upscaled_width = 128
    (*fh).tile_cols = 1
    (*fh).tile_rows = 1
    (*fh).mi_row_starts[1] = 24
    (*fh).mi_col_starts[1] = 32
    (*fh).base_q_idx = 100
    (*fh).tx_mode = 2
    (*fh).reference_select = 1
    (*fh).skip_mode_present = (seed >> 2) & 1
    (*fh).skip_mode_frame[0] = 1
    (*fh).skip_mode_frame[1] = 7
    (*fh).is_motion_mode_switchable = 1
    (*fh).allow_warped_motion = 1
    (*fh).allow_high_precision_mv = (seed >> 3) & 1
    (*fh).interpolation_filter = 4
    (*fh).order_hint = 20
    var o: usize = 0
    while o < 8 {
        (*fh).order_hints[o] = 10 + o as i64 * 3
        o = o + 1
    }
    (*fh).segmentation_enabled = (seed >> 4) & 1
    (*fh).segmentation_update_map = 1
    (*fh).last_active_seg_id = 3
    var cdfs: av1cdfctx.CdfState = av1cdfctx.cdfs_new()
    av1cdfctx.cdfs_begin_frame(&cdfs, true, 0, 100)
    let td: *mut av1blkst.TileDec = av1blkst.td_new()
    av1blkst.td_setup_frame(td, seq, fh)
    let n: i64 = 4000
    let buf: u64 = vp9mem.alloc(n as usize)
    fill(buf, n, seed)
    (*td).mi_row_start = 0
    (*td).mi_row_end = 24
    (*td).mi_col_start = 0
    (*td).mi_col_end = 32
    av1cdfctx.cdfs_begin_tile(&cdfs)
    (*td).cdf = cdfs.tile
    av1sym.sym_init(&(*td).sym, buf, n as usize, true)
    var ok: bool = true
    var r: i64 = 0
    while r < 24 && ok {
        var c: i64 = 0
        while c < 32 && ok {
            var size: i64 = av1blkdat.BLOCK_8X8
            if ((r + c + seed) % 5) == 0 {
                size = 6
            }
            if ((r + c + seed) % 7) == 0 {
                size = 3 + (seed % 4) * 2
            }
            (*td).mi_row = r
            (*td).mi_col = c
            (*td).mi_size = size
            (*td).bw4 = av1blkdat.bw4(size)
            (*td).bh4 = av1blkdat.bh4(size)
            (*td).has_chroma = 1
            (*td).avail_u = 0
            (*td).avail_l = 0
            if r > 0 {
                (*td).avail_u = 1
            }
            if c > 0 {
                (*td).avail_l = 1
            }
            (*td).avail_uc = (*td).avail_u
            (*td).avail_lc = (*td).avail_l
            if (*td).mi_row % (*td).bh4 == 0 && (*td).mi_col % (*td).bw4 == 0 {
                av1interinfo.inter_frame_mode_info(td)
                if !check_block(td) {
                    ok = false
                }
                if (*td).is_inter != 0 {
                    (*stats)[0] = (*stats)[0] + 1
                }
                if (*td).ref_frame[1] > 0 {
                    (*stats)[1] = (*stats)[1] + 1
                }
                if (*td).motion_mode != 0 {
                    (*stats)[2] = (*stats)[2] + 1
                }
                if (*td).skip_mode != 0 {
                    (*stats)[3] = (*stats)[3] + 1
                }
                store_basic(td)
                av1interinfo.store_inter_mi(td)
            }
            c = c + 2
        }
        r = r + 2
    }
    vp9mem.free(buf, n as usize)
    av1blkst.td_free(td)
    av1cdfctx.cdfs_free(&cdfs)
    av1fhdr.fhdr_free(fh)
    return ok
}

fn main() -> i32 {
    var stats: [i64; 4] = [0, 0, 0, 0]
    var seed: i64 = 1
    while seed <= 40 {
        if !run_case(seed, &stats) {
            return seed as i32
        }
        seed = seed + 1
    }
    if stats[0] < 100 || stats[1] < 5 {
        return 99
    }
    return 0
}
