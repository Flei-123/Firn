// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import std.rt
import zip.zip
import docview.dvdoc
import docview.kinds
import docview.office.pp_open
import docview.office.dx_imgfui

fn add_str(w: *mut zip.ZipWriter, name: str, body: str) -> bool {
    return zip.zip_add(w, name, body.p as u64, body.n, false) catch | e | (false)
}

fn build_pptx(out: *mut rt.Buf) -> bool {
    var w: zip.ZipWriter = zip.zip_writer_new(out)
    var ok: bool = true
    ok = add_str(&w, "_rels/.rels", "<?xml version=\"1.0\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"ppt/presentation.xml\"/></Relationships>") && ok
    ok = add_str(&w, "ppt/presentation.xml", "<?xml version=\"1.0\"?><p:presentation xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\"><p:sldIdLst><p:sldId id=\"256\" r:id=\"rId2\"/></p:sldIdLst><p:sldSz cx=\"9144000\" cy=\"6858000\"/></p:presentation>") && ok
    ok = add_str(&w, "ppt/_rels/presentation.xml.rels", "<?xml version=\"1.0\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideMaster\" Target=\"slideMasters/slideMaster1.xml\"/><Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide\" Target=\"slides/slide1.xml\"/></Relationships>") && ok
    ok = add_str(&w, "ppt/slideMasters/slideMaster1.xml", "<?xml version=\"1.0\"?><p:sldMaster xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id=\"1\" name=\"\"/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/></p:spTree></p:cSld></p:sldMaster>") && ok
    ok = add_str(&w, "ppt/slideLayouts/slideLayout1.xml", "<?xml version=\"1.0\"?><p:sldLayout xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id=\"1\" name=\"\"/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/></p:spTree></p:cSld></p:sldLayout>") && ok
    ok = add_str(&w, "ppt/slideLayouts/_rels/slideLayout1.xml.rels", "<?xml version=\"1.0\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideMaster\" Target=\"../slideMasters/slideMaster1.xml\"/></Relationships>") && ok
    ok = add_str(&w, "ppt/slides/slide1.xml", "<?xml version=\"1.0\"?><p:sld xmlns:a=\"http://schemas.openxmlformats.org/drawingml/2006/main\" xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\" xmlns:p=\"http://schemas.openxmlformats.org/presentationml/2006/main\"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id=\"1\" name=\"\"/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/><p:sp><p:nvSpPr><p:cNvPr id=\"2\" name=\"T\"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x=\"457200\" y=\"457200\"/><a:ext cx=\"6000000\" cy=\"900000\"/></a:xfrm><a:solidFill><a:srgbClr val=\"FFC000\"/></a:solidFill></p:spPr><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang=\"en-US\" sz=\"2400\"/><a:t>Hello</a:t></a:r></a:p><a:p><a:pPr><a:buChar char=\"-\"/></a:pPr><a:r><a:t>Firn</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld></p:sld>") && ok
    ok = add_str(&w, "ppt/slides/_rels/slide1.xml.rels", "<?xml version=\"1.0\"?><Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\"><Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideLayout\" Target=\"../slideLayouts/slideLayout1.xml\"/></Relationships>") && ok
    let n: usize = zip.zip_finish(&w) catch | e | (0)
    zip.zip_writer_free(&w)
    return ok && n > 0
}

fn main() -> i32 {
    var zbuf: rt.Buf = rt.buf_new()
    if !build_pptx(&zbuf) {
        return 20
    }
    pp_open.pptx_install_lazy()
    dx_imgfui.install_images()
    var d: dvdoc.Doc = dvdoc.doc_open_named(rt.buf_ptr(&zbuf), rt.buf_len(&zbuf), "x.pptx")
    if !dvdoc.doc_ok(&d) {
        return 1
    }
    if dvdoc.doc_kind(&d) != kinds.KIND_PPTX {
        return 2
    }
    if dvdoc.doc_pages(&d) != 1 {
        return 3
    }
    var w: i32 = 0
    var h: i32 = 0
    if !dvdoc.doc_page_size(&d, 0, &w, &h) || w != 960 || h != 720 {
        return 4
    }
    var buf: rt.Buf = rt.buf_new()
    var rw: i32 = 0
    var rh: i32 = 0
    if !dvdoc.doc_render(&d, 0, 1.0, &buf, &rw, &rh) || rw != w || rh != h || rt.buf_len(&buf) != (rw as usize) * (rh as usize) * 4 {
        return 5
    }
    var txt: rt.Buf = rt.buf_new()
    if !dvdoc.doc_text(&d, 0, &txt) {
        return 6
    }
    let want: str = "Hello\nFirn"
    if rt.buf_len(&txt) != want.n {
        return 7
    }
    var i: usize = 0
    while i < want.n {
        if rt.buf_at(&txt, i) != rt.ld8(want.p as u64, i) {
            return 8
        }
        i = i + 1
    }
    if dvdoc.doc_page_size(&d, 1, &w, &h) {
        return 9
    }
    dvdoc.doc_free(&d)
    if dvdoc.doc_ok(&d) {
        return 10
    }
    var bad: str = "PK\x03\x04 garbage"
    var d2: dvdoc.Doc = dvdoc.doc_open(bad.p as u64, bad.n)
    if dvdoc.doc_ok(&d2) {
        return 11
    }
    rt.buf_free(&buf)
    rt.buf_free(&txt)
    rt.buf_free(&zbuf)
    return 0
}
