// expect_exit: 0
// tests/810_impl_core.fi — METHODEN (`impl`), der Test zur Runde 45.
//
// Geprueft wird in EINEM Programm, was `impl` in der Sprache ausmacht:
//
//   * die drei Empfaenger `self`, `*self` und `*mut self`
//   * die einzige Anpassung am Aufrufort: liegt der Empfaenger als WERT vor
//     und will die Methode einen Zeiger, wird seine Adresse genommen; liegt
//     er schon als Zeiger vor, wird er durchgereicht
//   * Empfaenger, die keine Variable sind: Feld, Arrayelement, `*p`
//   * eine Methode, die ein AGGREGAT liefert, und die Kette darauf
//     (`p.verschoben(1, 1).erstes()`)
//   * Methode ruft Methode auf demselben Typ
//   * eine freie Funktion und eine Methode DESSELBEN NAMENS stehen
//     nebeneinander, ohne sich zu verdecken (`summe(..)` vs `p.summe()`)
//
// Jeder Rueckgabewert != 0 nennt die Stelle.

struct Dot { x: i32, y: i32 }

struct Frame { corner: Dot, width: i32 }

// FREIE Funktion `summe` — sie heisst wie die Methode `Punkt.summe` und
// bleibt trotzdem erreichbar: die Methode heisst intern `Punkt__summe`.
fn sum(a: i32, b: i32) -> i32 {
    return a + b
}

impl Dot {
    // lesender Zeiger
    fn sum(*self) -> i32 {
        return (*self).x + (*self).y
    }
    // schreibender Zeiger
    fn set(*mut self, x: i32, y: i32) {
        (*self).x = x
        (*self).y = y
    }
    // Kopie
    fn first(self) -> i32 {
        return self.x
    }
    // Aggregat als Rueckgabe, Empfaenger als Kopie
    fn moved(self, dx: i32, dy: i32) -> Dot {
        return Dot{ x: self.x + dx, y: self.y + dy }
    }
    // Methode ruft Methode: beide auf demselben Empfaenger
    fn duplicate(*self) -> i32 {
        return self.sum() * 2
    }
    // Aggregat als ARGUMENT
    fn closer_as(*self, other: Dot) -> bool {
        return self.sum() < other.first() + other.y
    }
}

impl Frame {
    fn area(*self) -> i32 {
        return (*self).width * (*self).width
    }
    // Empfaenger ist ein FELD des eigenen Empfaengers
    fn corner_sum(*self) -> i32 {
        return (*self).corner.sum()
    }
}

fn main() -> i32 {
    var p: Dot = Dot{ x: 1, y: 2 }

    // 1. *self auf einem Wert: die Adresse wird genommen
    if p.sum() != 3 {
        return 1
    }
    // 2. *mut self veraendert wirklich
    p.set(40, 2)
    if p.x != 40 || p.y != 2 {
        return 2
    }
    if p.sum() != 42 {
        return 3
    }
    // 3. Empfaenger als Kopie
    if p.first() != 40 {
        return 4
    }
    // 4. Empfaenger liegt schon als Zeiger vor
    let z: *mut Dot = &p
    if z.sum() != 42 {
        return 5
    }
    z.set(1, 2)
    if p.sum() != 3 {
        return 6
    }
    // 5. Kopie aus einem Zeiger: ausdruecklich `(*z)`
    if (*z).first() != 1 {
        return 7
    }
    // 6. Aggregatrueckgabe und Kette darauf
    let q: Dot = p.moved(10, 20)
    if q.x != 11 || q.y != 22 {
        return 8
    }
    if p.moved(1, 1).first() != 2 {
        return 9
    }
    // Eine Kette geht nur mit einem Empfaenger als KOPIE: das Ergebnis eines
    // Aufrufs hat keine Adresse, `summe` will einen Zeiger. Deshalb erst
    // binden — siehe tests/neg/impl_receiver_without_address.fi.
    let v: Dot = p.moved(1, 1)
    if v.sum() != 5 {
        return 10
    }
    // 7. Methode ruft Methode
    if p.duplicate() != 6 {
        return 11
    }
    // 8. Aggregat als Argument
    if !p.closer_as(q) {
        return 12
    }
    if q.closer_as(p) {
        return 13
    }
    // 9. Empfaenger ist ein Feld
    var r: Frame = Frame{ corner: Dot{ x: 3, y: 4 }, width: 5 }
    if r.corner.sum() != 7 {
        return 14
    }
    if r.corner_sum() != 7 {
        return 15
    }
    if r.area() != 25 {
        return 16
    }
    r.corner.set(6, 7)
    if r.corner_sum() != 13 {
        return 17
    }
    // 10. Empfaenger ist ein Arrayelement
    var field: [Dot; 3] = [Dot{ x: 0, y: 0 }, Dot{ x: 0, y: 0 }, Dot{ x: 0, y: 0 }]
    var i: i32 = 0
    while i < 3 {
        field[i as usize].set(i, i * 2)
        i = i + 1
    }
    if field[2 as usize].sum() != 6 {
        return 18
    }
    if field[1 as usize].duplicate() != 6 {
        return 19
    }
    // 11. freie Funktion gleichen Namens — beide erreichbar
    if sum(20, 22) != 42 {
        return 20
    }
    if sum(p.sum(), q.sum()) != 36 {
        return 21
    }
    return 0
}
