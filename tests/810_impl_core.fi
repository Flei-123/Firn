// expect_exit: 0
// tests/810_impl_core.fi -- METHODS (`impl`), the test for round 45.
//
// What makes `impl` in the language is checked in ONE program:
//
//   * the three receivers `self`, `*self` and `*mut self`
//   * the only adjustment at the call site: if the receiver is present as a
//     VALUE and the method wants a pointer, its address is taken; if it is
//     already a pointer, it is passed through
//   * receivers that are not a variable: field, array element, `*p`
//   * a method that yields an AGGREGATE, and the chain on it
//     (`p.moved(1, 1).first()`)
//   * method calls method on the same type
//   * a free function and a method of THE SAME NAME stand next to each
//     other without hiding each other (`sum(..)` vs `p.sum()`)
//
// Every return value != 0 names the place.

struct Dot { x: i32, y: i32 }

struct Frame { corner: Dot, width: i32 }

// FREE function `sum` -- it has the same name as the method `Dot.sum` and
// still stays reachable: the method is called `Dot__sum` internally.
fn sum(a: i32, b: i32) -> i32 {
    return a + b
}

impl Dot {
    // reading pointer
    fn sum(*self) -> i32 {
        return (*self).x + (*self).y
    }
    // writing pointer
    fn set(*mut self, x: i32, y: i32) {
        (*self).x = x
        (*self).y = y
    }
    // copy
    fn first(self) -> i32 {
        return self.x
    }
    // aggregate as the return, receiver as a copy
    fn moved(self, dx: i32, dy: i32) -> Dot {
        return Dot { x: self.x + dx, y: self.y + dy }
    }
    // method calls method: both on the same receiver
    fn duplicate(*self) -> i32 {
        return self.sum() * 2
    }
    // aggregate as an ARGUMENT
    fn closer_as(*self, other: Dot) -> bool {
        return self.sum() < other.first() + other.y
    }
}

impl Frame {
    fn area(*self) -> i32 {
        return (*self).width * (*self).width
    }
    // the receiver is a FIELD of one's own receiver
    fn corner_sum(*self) -> i32 {
        return (*self).corner.sum()
    }
}

fn main() -> i32 {
    var p: Dot = Dot { x: 1, y: 2 }

    // 1. *self on a value: the address is taken
    if p.sum() != 3 {
        return 1
    }
    // 2. *mut self really changes it
    p.set(40, 2)
    if p.x != 40 || p.y != 2 {
        return 2
    }
    if p.sum() != 42 {
        return 3
    }
    // 3. receiver as a copy
    if p.first() != 40 {
        return 4
    }
    // 4. the receiver is already present as a pointer
    let z: *mut Dot = &p
    if z.sum() != 42 {
        return 5
    }
    z.set(1, 2)
    if p.sum() != 3 {
        return 6
    }
    // 5. copy from a pointer: explicitly `(*z)`
    if (*z).first() != 1 {
        return 7
    }
    // 6. aggregate return and the chain on it
    let q: Dot = p.moved(10, 20)
    if q.x != 11 || q.y != 22 {
        return 8
    }
    if p.moved(1, 1).first() != 2 {
        return 9
    }
    // A chain only works with a receiver as a COPY: the result of a call has no
    // address, `sum` wants a pointer. So bind it first --
    // see tests/neg/impl_receiver_without_address.fi.
    let v: Dot = p.moved(1, 1)
    if v.sum() != 5 {
        return 10
    }
    // 7. method calls method
    if p.duplicate() != 6 {
        return 11
    }
    // 8. aggregate as an argument
    if !p.closer_as(q) {
        return 12
    }
    if q.closer_as(p) {
        return 13
    }
    // 9. the receiver is a field
    var r: Frame = Frame { corner: Dot { x: 3, y: 4 }, width: 5 }
    if r.corner.sum() != 7 {
        return 14
    }
    if r.corner_sum() != 7 {
        return 15
    }
    if r.area() != 25 {
        return 16
    }
    r.corner.set(6, 7)
    if r.corner_sum() != 13 {
        return 17
    }
    // 10. the receiver is an array element
    var field: [Dot; 3] = [Dot { x: 0, y: 0 }, Dot { x: 0, y: 0 }, Dot { x: 0, y: 0 }]
    var i: i32 = 0
    while i < 3 {
        field[i as usize].set(i, i * 2)
        i = i + 1
    }
    if field[2 as usize].sum() != 6 {
        return 18
    }
    if field[1 as usize].duplicate() != 6 {
        return 19
    }
    // 11. free function of the same name -- both reachable
    if sum(20, 22) != 42 {
        return 20
    }
    if sum(p.sum(), q.sum()) != 36 {
        return 21
    }
    return 0
}
