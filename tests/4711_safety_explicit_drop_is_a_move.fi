// expect_exit: 1
// r907: an explicit g.drop() moves g: the scope end does not run drop a second time (LOG counts one).
static mut LOG: i64 = 0

struct G { id: i64 }

impl G { fn drop(inout self) { LOG = LOG + 1 } }

fn main() -> i32 {
    {
        var g: G = G { id: 1 }
        g.drop()
    }
    return LOG as i32
}
