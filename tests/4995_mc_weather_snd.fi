// expect_exit: 0
import std.rt
import mc.mc_weather
import mc.mc_weather_fx
import mc.mc_weather_snd
import mc.mc_precip
import mc.mc_raster

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn differs(a: *mut mc_raster.Raster, b: *mut mc_raster.Raster) -> i32 {
    var n: i32 = 0
    var y: i32 = 0
    while y < (*a).h {
        var x: i32 = 0
        while x < (*a).w {
            if mc_raster.raster_pixel(a, x, y) != mc_raster.raster_pixel(b, x, y) { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn bright(r: *mut mc_raster.Raster) -> i32 {
    var n: i32 = 0
    var y: i32 = 0
    while y < (*r).h {
        var x: i32 = 0
        while x < (*r).w {
            let p: u32 = mc_raster.raster_pixel(r, x, y)
            if (p & 255 as u32) > 80 as u32 || ((p >> 8 as u32) & 255 as u32) > 80 as u32 || ((p >> 16 as u32) & 255 as u32) > 80 as u32 { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn lit_white(r: *mut mc_raster.Raster) -> i32 {
    var n: i32 = 0
    var y: i32 = 0
    while y < (*r).h {
        var x: i32 = 0
        while x < (*r).w {
            let p: u32 = mc_raster.raster_pixel(r, x, y)
            if (p & 255 as u32) > 200 as u32 && ((p >> 8 as u32) & 255 as u32) > 200 as u32 && ((p >> 16 as u32) & 255 as u32) > 200 as u32 { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main() -> i32 {
    var ws: mc_weather_snd.WeatherSnd = mc_weather_snd.wsnd_new(7 as i64)
    check(mc_weather_snd.wsnd_rain_step(&ws, 0, mc_precip.PRECIP_RAIN, false, 0.05) == mc_weather_snd.SND_NONE, 1)
    check(mc_weather_snd.wsnd_rain_step(&ws, 50, mc_precip.PRECIP_RAIN, false, 0.05) == mc_weather_snd.SND_NONE, 2)
    check(mc_weather_snd.wsnd_rain_step(&ws, 1000, mc_precip.PRECIP_RAIN, false, 0.05) == mc_weather_snd.SND_RAIN, 3)
    check(mc_weather_snd.wsnd_rain_step(&ws, 1000, mc_precip.PRECIP_RAIN, false, 1.0) == mc_weather_snd.SND_NONE, 4)
    var n: i32 = 0
    var t: i32 = 0
    while t < 100 {
        if mc_weather_snd.wsnd_rain_step(&ws, 1000, mc_precip.PRECIP_RAIN, false, 0.05) == mc_weather_snd.SND_RAIN { n = n + 1 }
        t = t + 1
    }
    check(n == 1, 5)
    mc_weather_snd.wsnd_rain_step(&ws, 0, mc_precip.PRECIP_RAIN, true, 0.05)
    check(mc_weather_snd.wsnd_rain_step(&ws, 1000, mc_precip.PRECIP_RAIN, true, 0.05) == mc_weather_snd.SND_RAIN_ROOF, 6)
    check(mc_weather_snd.wsnd_rain_step(&ws, 1000, mc_precip.PRECIP_SNOW, false, 5.0) == mc_weather_snd.SND_NONE, 7)
    check(mc_weather_snd.wsnd_rain_step(&ws, 1000, mc_precip.PRECIP_NONE, false, 5.0) == mc_weather_snd.SND_NONE, 8)
    check(mc_weather_snd.wsnd_rain_step(&ws, 1000, mc_precip.PRECIP_RAIN, false, 0.05) == mc_weather_snd.SND_RAIN, 9)
    check(mc_weather_snd.wsnd_rain_volume(1000, false) > mc_weather_snd.wsnd_rain_volume(1000, true), 10)
    check(mc_weather_snd.wsnd_rain_volume(500, false) < mc_weather_snd.wsnd_rain_volume(1000, false), 11)
    check(mc_weather_snd.wsnd_rain_volume(0, false) == 0.0 as f32, 12)

    check(mc_weather_fx.weather_fx_effective_milli(1000, 1000) == 1000 && mc_weather_fx.weather_fx_effective_milli(1000, 180) == 180, 13)

    var a: mc_raster.Raster = mc_raster.raster_new(320, 180)
    var b: mc_raster.Raster = mc_raster.raster_new(320, 180)
    mc_raster.raster_clear(&b, 0xFF404040 as u32)
    var wet: mc_weather.Weather = mc_weather.weather_new()
    mc_weather.weather_on_game_state(&wet, 7, 1.0 as f32)
    mc_raster.raster_clear(&a, 0xFF404040 as u32)
    mc_weather_fx.weather_fx_draw(&a, 1, &wet, 1000 as u64)
    let rain_open: i32 = bright(&a)
    check(rain_open > 100 && lit_white(&a) == 0, 14)

    mc_weather.weather_set_local(&wet, mc_precip.PRECIP_RAIN, 180)
    mc_raster.raster_clear(&a, 0xFF404040 as u32)
    mc_weather_fx.weather_fx_draw(&a, 1, &wet, 1000 as u64)
    let rain_roof: i32 = bright(&a)
    check(rain_roof < rain_open && rain_roof > 0, 15)

    mc_weather.weather_set_local(&wet, mc_precip.PRECIP_SNOW, 1000)
    mc_raster.raster_clear(&a, 0xFF404040 as u32)
    mc_weather_fx.weather_fx_draw(&a, 1, &wet, 1000 as u64)
    check(lit_white(&a) > 20, 16)
    mc_raster.raster_clear(&b, 0xFF404040 as u32)
    mc_weather_fx.weather_fx_draw(&b, 1, &wet, 2000 as u64)
    check(differs(&a, &b) > 20, 17)

    mc_weather.weather_set_local(&wet, mc_precip.PRECIP_NONE, 1000)
    mc_raster.raster_clear(&a, 0xFF404040 as u32)
    mc_weather_fx.weather_fx_draw(&a, 1, &wet, 1000 as u64)
    check(bright(&a) == 0, 18)
    var plain: mc_raster.Raster = mc_raster.raster_new(320, 180)
    mc_raster.raster_clear(&plain, 0xFF404040 as u32)
    check(differs(&a, &plain) == 320 * 180, 19)
    return 0
}
