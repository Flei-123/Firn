// expect_exit: 0
// tests/1238_fnfield_call.fi -- ROUND 68: a function value in a STRUCT
// FIELD is called directly.
//
// docs/ROUND63.md, gap 6: "`c.hook(a, b)` reports 'type Ctx has no method
// hook'; it has to be loaded into a local first (`let h = c.hook; h(a, b)`).
// That is consistent with round 58 but surprising."
//
// The resolution order is unchanged and that is the point: a METHOD of the
// same name still wins (section 7 below), the field is only looked at when
// there is no method. What the emitted code does is measured, not claimed:
// tools/fnfield/run.sh.

struct Ctx {
    hook: fn(i32, i32) -> i32,
    n: i32,
}

struct Outer {
    inner: Ctx,
    tag: i32,
}

struct Sink {
    put: fn(i32),
    seen: i32,
}

struct Nullary {
    get: fn() -> i32,
}

struct Named {
    twice: fn(i32) -> i32,
}

impl Named {
    fn twice(*mut self, x: i32) -> i32 { return x + 100 }
}

fn add(a: i32, b: i32) -> i32 { return a + b }
fn mul(a: i32, b: i32) -> i32 { return a * b }
fn nothing(x: i32) {}
fn forty_two() -> i32 { return 42 }
fn doubled(x: i32) -> i32 { return x + x }
fn sub(a: i32, b: i32) -> i32 { return a - b }

// through a POINTER receiver
fn via_ptr(c: *mut Ctx, a: i32, b: i32) -> i32 { return c.hook(a, b) }

// the value goes on being passed as a value as well
fn call_twice(c: Ctx) -> i32 { return c.hook(1, 2) + c.hook(3, 4) }

fn main() -> i32 {
    // 1. the plain case
    var c: Ctx = Ctx { hook: add, n: 0 }
    if c.hook(3, 4) != 7 { return 1 }

    // 2. the field is a variable -- assigning changes the call target
    c.hook = mul
    if c.hook(3, 4) != 12 { return 2 }

    // 3. through a pointer receiver
    if via_ptr(&c, 3, 4) != 12 { return 3 }

    // 4. as a copy
    if call_twice(c) != 2 + 12 { return 4 }

    // 5. a field of a nested struct is a receiver too
    var o: Outer = Outer { inner: Ctx { hook: add, n: 0 }, tag: 5 }
    if o.inner.hook(20, 22) != 42 { return 5 }
    if o.tag != 5 { return 6 }

    // 6. the way of round 58 -- loading into a local first -- still leads
    //    to the same result. That is what this round makes unnecessary,
    //    not what it forbids. (A CLOSURE in a field is proved in
    //    tools/fnfield/run.sh; it is deliberately not in this file,
    //    because the generated `__closure#N` functions stand in a
    //    different place in the two compilers -- the known deviation of
    //    round 58, see tools/fir_compare.sh.)
    c.hook = sub
    let h2: fn(i32, i32) -> i32 = c.hook
    if h2(10, 3) != c.hook(10, 3) { return 7 }
    if c.hook(10, 3) != 7 { return 14 }

    // 7. A METHOD OF THE SAME NAME WINS. `Named` has both a field `twice`
    //    and a method `twice`; the method is what runs.
    var nm: Named = Named { twice: doubled }
    if nm.twice(5) != 105 { return 8 }
    let h: fn(i32) -> i32 = nm.twice
    if h(5) != 10 { return 9 }

    // 8. no result, no argument
    var s: Sink = Sink { put: nothing, seen: 0 }
    s.put(1)
    var z: Nullary = Nullary { get: forty_two }
    if z.get() != 42 { return 10 }

    // 9. in a condition, as an argument, and nested in itself
    if !(c.hook(9, 2) == 7) { return 11 }
    if add(c.hook(9, 2), z.get()) != 49 { return 12 }
    c.hook = add
    if c.hook(c.hook(1, 2), c.hook(3, 4)) != 10 { return 13 }
    return 0
}
