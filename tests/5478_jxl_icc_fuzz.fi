import jxl.jxl
import std.fs
import std.rt

static mut runs: i32 = 0

fn run_one(p: u64, n: usize) {
    var icc: jxl.JxlIcc = jxl.jxl_icc_new()
    let ok: bool = jxl.jxl_icc_profile(p, n, &icc) catch false
    jxl.jxl_icc_free(&icc)
    var info: jxl.JxlInfo = jxl.jxl_info_new()
    let ok2: bool = jxl.jxl_info(p, n, &info) catch false
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let ok3: bool = jxl.jxl_decode(p, n, &pic) catch false
    jxl.jxl_picture_free(&pic)
    runs = runs + 1
}

fn fuzz_file(path: str) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    let p: u64 = rt.buf_ptr(&data)
    var i: usize = 0
    while i < n {
        var bit: u32 = 0
        while bit < 8 {
            rt.st8(p, i, rt.ld8(p, i) ^ ((1 as u8) << (bit as u8)))
            run_one(p, n)
            rt.st8(p, i, rt.ld8(p, i) ^ ((1 as u8) << (bit as u8)))
            bit = bit + 1
        }
        i = i + 1
    }
    i = 0
    while i < n {
        run_one(p, i)
        i = i + 7
    }
    rt.buf_free(&data)
}

fn main() -> i32 {
    fuzz_file("tests/data/jxl/icc/sgray.jxl")
    fuzz_file("tests/data/jxl/icc/scrgb.jxl")
    fuzz_file("tests/data/jxl/icc/a98.jxl")
    fuzz_file("tests/data/jxl/icc/romm.jxl")
    fuzz_file("tests/data/jxl/icc/p3.jxl")
    if runs < 10000 {
        return 1
    }
    return 0
}
