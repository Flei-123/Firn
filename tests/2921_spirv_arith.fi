// expect_exit: 0
// tests/2921_spirv_arith.fi -- gpu.spirv: arithmetic of arith.frag (glslang -> SPIR-V) against the same expressions in Firn:
// f32 + - * / dot length sqrt (bit equal), i32 * / % << >> & ^ , u32 ops, mat2 * vec2, vec2 * mat2.
import std.rt
import std.math
import gpu.spirv

const SH: str = __include_str("../lib/gpu/spv/test/arith.frag.spv")

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn fv(m: *mut spirv.Spv, base: usize, k: usize, x: f32) {
    spirv.spv_mem_set_f32(m, base, k, x)
}

fn iv(m: *mut spirv.Spv, base: usize, k: usize, x: i32) {
    spirv.spv_mem_set(m, base, k, x as% u32)
}

fn gi(m: *mut spirv.Spv, base: usize, k: usize) -> i32 {
    return spirv.spv_mem_get(m, base, k) as% i32
}

// OpSMod: the sign follows the divisor (GLSL `%` compiles to it)
fn smod(a: i32, b: i32) -> i32 {
    var r: i32 = a % b
    if r != 0 && ((r < 0) != (b < 0)) {
        r = r + b
    }
    return r
}

fn main() -> i32 {
    var m: spirv.Spv = spirv.spv_zero()
    check(spirv.spv_new(SH.p as u64, SH.n, &m), 1)
    let ent: u32 = spirv.spv_find_entry(&m, 4)
    let a: usize = spirv.spv_find_location(&m, 1, 0)
    let b: usize = spirv.spv_find_location(&m, 1, 1)
    let ia: usize = spirv.spv_find_location(&m, 1, 2)
    let ib: usize = spirv.spv_find_location(&m, 1, 3)
    let ua: usize = spirv.spv_find_location(&m, 1, 4)
    let o0: usize = spirv.spv_find_location(&m, 3, 0)
    let o1: usize = spirv.spv_find_location(&m, 3, 1)
    let o2: usize = spirv.spv_find_location(&m, 3, 2)
    let o3: usize = spirv.spv_find_location(&m, 3, 3)
    let o4: usize = spirv.spv_find_location(&m, 3, 4)
    let o5: usize = spirv.spv_find_location(&m, 3, 5)
    check(ent != 0 && a != spirv.SPV_NONE && o5 != spirv.SPV_NONE, 2)
    let av: [f32; 4] = [1.5, -2.25, 3.0, 0.5]
    let bv: [f32; 4] = [4.0, 0.75, -1.5, 8.0]
    let iav: [i32; 4] = [17, 5, 20, 100]
    let ibv: [i32; 4] = [3, 4, 7, 9]
    var k: usize = 0
    while k < 4 {
        fv(&m, a, k, av[k])
        fv(&m, b, k, bv[k])
        iv(&m, ia, k, iav[k])
        iv(&m, ib, k, ibv[k])
        k = k + 1
    }
    spirv.spv_mem_set(&m, ua, 0, 10)
    spirv.spv_mem_set(&m, ua, 1, 25)
    check(spirv.spv_run(&m, ent, 10000), 3)

    // o0 = a * b + a - b / 2
    k = 0
    while k < 4 {
        let want: f32 = av[k] * bv[k] + av[k] - bv[k] / 2.0
        check(spirv.spv_mem_get_f32(&m, o0, k) == want, 10 + k as i32)
        k = k + 1
    }
    // o1
    let d: f32 = av[0] * bv[0] + av[1] * bv[1] + av[2] * bv[2]
    check(spirv.spv_mem_get_f32(&m, o1, 0) == d, 20)
    let s2: f32 = av[0] * av[0] + av[1] * av[1] + av[2] * av[2]
    check(spirv.spv_mem_get_f32(&m, o1, 1) == math.sqrt32(s2), 21)
    check(spirv.spv_mem_get_f32(&m, o1, 2) == math.sqrt32(av[0]), 22)
    check(spirv.spv_mem_get_f32(&m, o1, 3) == av[0] / bv[1], 23)
    // o2 = ia * ib + ia / ib - ib % ia
    k = 0
    while k < 4 {
        check(gi(&m, o2, k) == iav[k] * ibv[k] + iav[k] / ibv[k] - smod(ibv[k], iav[k]), 30 + k as i32)
        k = k + 1
    }
    // o3
    check(gi(&m, o3, 0) == 68, 40)
    check(gi(&m, o3, 1) == 2, 41)
    check(gi(&m, o3, 2) == 4, 42)
    check(gi(&m, o3, 3) == 109, 43)
    // o4: mat2(a.xy, b.xy) * (a.z, b.z) and (a.w, b.w) * mat2
    check(spirv.spv_mem_get_f32(&m, o4, 0) == av[0] * av[2] + bv[0] * bv[2], 50)
    check(spirv.spv_mem_get_f32(&m, o4, 1) == av[1] * av[2] + bv[1] * bv[2], 51)
    check(spirv.spv_mem_get_f32(&m, o4, 2) == av[3] * av[0] + bv[3] * av[1], 52)
    check(spirv.spv_mem_get_f32(&m, o4, 3) == av[3] * bv[0] + bv[3] * bv[1], 53)
    // o5: (35 + 8 + 5, 250 + 3 + 25)
    check(spirv.spv_mem_get(&m, o5, 0) == 48, 60)
    check(spirv.spv_mem_get(&m, o5, 1) == 278, 61)
    // second run with negative integers: SDiv truncates towards zero, wraps like the CPU
    iv(&m, ia, 0, -17)
    iv(&m, ib, 0, 5)
    iv(&m, ia, 1, -9)
    iv(&m, ib, 1, -2)
    check(spirv.spv_run(&m, ent, 10000), 70)
    check(gi(&m, o2, 0) == -17 * 5 + (-17 / 5) - smod(5, -17), 71)
    check(gi(&m, o2, 1) == (-9) * (-2) + (-9 / -2) - smod(-2, -9), 72)
    spirv.spv_free(&m)
    return 0
}
