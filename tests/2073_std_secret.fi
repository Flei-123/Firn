// expect_exit: 0
// tests/2073_std_secret.fi -- std.secret: the encrypted vault (machine-bound
// and password variants), its file format against a vault made by Python's
// `cryptography` + PyNaCl (a known-answer file), tampering, the name and size
// rules, and two handles on one file.
//
// The simple API (secret_set/get/delete) picks its file from $HOME, so it is
// exercised by tools/stdarchive/run.sh with a scratch HOME; here only what has
// no side effects outside /tmp.
import std.secret
import std.fs
import std.dir
import std.rt
import std.osinfo
import std.io
import std.str

const VAULT_PW: str = __include_str("data/archives/vault_pw.v1")

struct Tally {
    total: i64,
    fails: i64,
}

fn check(t: *mut Tally, what: str, ok: bool) {
    (*t).total = (*t).total + 1
    if !ok {
        (*t).fails = (*t).fails + 1
        io.print("FAIL ")
        io.print_line(what)
    }
}

fn scratch() -> str {
    var b: rt.Buf = rt.buf_new()
    let head: str = "/tmp/firn_secret_2073_"
    rt.buf_push_bytes(&b, head.p as u64, head.length())
    rt.buf_push_dec_i64(&b, syscall(39, 0, 0, 0, 0, 0, 0))
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

fn code_of(e: SecretError) -> u32 {
    if e == SecretError::NotFound { return 1 as u32 }
    if e == SecretError::Unavailable { return 2 as u32 }
    if e == SecretError::TooLarge { return 3 as u32 }
    if e == SecretError::Invalid { return 4 as u32 }
    if e == SecretError::WrongKey { return 5 as u32 }
    if e == SecretError::Corrupt { return 6 as u32 }
    return 99 as u32
}

fn dummy(e: SecretError, code: *mut u32) -> secret.Vault {
    *code = code_of(e)
    return secret.Vault { path: "", kdf: 0 as u32, key: [0 as u8; 32], salt: [0 as u8; 16], m_kib: 0 as u32, t: 0 as u32 }
}

fn bset(e: SecretError, code: *mut u32) -> bool {
    *code = code_of(e)
    return false
}

fn nset(e: SecretError, code: *mut u32) -> usize {
    *code = code_of(e)
    return 0
}

fn open_m(path: str, code: *mut u32) -> secret.Vault {
    *code = 0 as u32
    return secret.vault_open_machine(path) catch | e | (dummy(e, code))
}

fn open_p(path: str, pw: str, m: u32, t: u32, code: *mut u32) -> secret.Vault {
    *code = 0 as u32
    return secret.vault_open_password_params(path, pw, m, t) catch | e | (dummy(e, code))
}

fn put(v: *mut secret.Vault, svc: str, key: str, val: str) -> u32 {
    var code: u32 = 0
    secret.vault_set(v, svc, key, val.p as u64, val.length()) catch | e | (bset(e, &code))
    return code
}

// the value as a string, or "<code>" via `code`
fn get(v: *mut secret.Vault, svc: str, key: str, code: *mut u32) -> str {
    *code = 0 as u32
    var b: rt.Buf = rt.buf_new()
    secret.vault_get_into(v, svc, key, &b) catch | e | (nset(e, code))
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

fn mode_of(path: str) -> u32 {
    return (fs.stat(path) catch fs.FileInfo { kind: 0 as u8, mode: 0 as u32, size: 0, mtime_ns: 0 }).mode
}

fn size_of(path: str) -> u64 {
    return (fs.stat(path) catch fs.FileInfo { kind: 0 as u8, mode: 0 as u32, size: 0, mtime_ns: 0 }).size
}

fn count(v: *mut secret.Vault) -> usize {
    return secret.vault_count(v) catch 9999
}

fn main() -> i32 {
    var t: Tally = Tally { total: 0, fails: 0 }
    let win: bool = osinfo.is_windows()
    let root: str = scratch()
    fs.remove_tree(root) catch false
    fs.mkdir_all(root) catch false
    var code: u32 = 0

    // =============================================== A. a file Python made (known answer)
    let kat: str = root + "/kat.v1"
    fs.write_file(kat, VAULT_PW.p as u64, VAULT_PW.length()) catch 0
    var vk: secret.Vault = open_p(kat, "firn-test-password", 65536 as u32, 3 as u32, &code)
    check(&t, "KAT: the Python-made Argon2id vault opens (the file's own parameters win)", code == 0 as u32)
    check(&t, "KAT: svc/tok = hello", get(&vk, "svc", "tok", &code) == "hello" && code == 0 as u32)
    var kb: rt.Buf = rt.buf_new()
    secret.vault_get_into(&vk, "svc2", "key", &kb) catch 0
    check(&t, "KAT: svc2/key = 00 ff 'binary'", rt.buf_len(&kb) == 8 && rt.ld8(rt.buf_ptr(&kb), 0) == 0 as u8 && rt.ld8(rt.buf_ptr(&kb), 1) == 255 as u8 && rt.ld8(rt.buf_ptr(&kb), 2) == 98 as u8)
    check(&t, "KAT: two secrets", count(&vk) == 2)
    secret.vault_free(&vk)
    var vw: secret.Vault = open_p(kat, "wrong password", 65536 as u32, 3 as u32, &code)
    check(&t, "KAT: a wrong password is WrongKey at open", code == 5 as u32)
    var vm: secret.Vault = open_m(kat, &code)
    check(&t, "KAT: the machine key on a password file is WrongKey", code == 5 as u32 || code == 2 as u32)

    // =============================================== B. the password vault, new
    let pw: str = root + "/pw/secrets.v1"
    var vp: secret.Vault = open_p(pw, "correct horse", 64 as u32, 1 as u32, &code)
    check(&t, "password vault: a new one opens", code == 0 as u32)
    check(&t, "password vault: set", put(&vp, "svc", "tok", "geheim") == 0 as u32)
    check(&t, "password vault: get", get(&vp, "svc", "tok", &code) == "geheim")
    check(&t, "password vault: the file is 0600, its directory 0700", win || (mode_of(pw) == 384 as u32 && mode_of(root + "/pw") == 448 as u32))
    var vp2: secret.Vault = open_p(pw, "correct horse", 64 as u32, 1 as u32, &code)
    check(&t, "password vault: reopened with the right password", code == 0 as u32 && get(&vp2, "svc", "tok", &code) == "geheim")
    var vp3: secret.Vault = open_p(pw, "Correct horse", 64 as u32, 1 as u32, &code)
    check(&t, "password vault: a wrong password is WrongKey", code == 5 as u32)
    var vp4: secret.Vault = open_p(pw, "", 64 as u32, 1 as u32, &code)
    check(&t, "password vault: an empty password is Invalid", code == 4 as u32)
    var vp5: secret.Vault = open_p(root + "/pw/new", "x", 4 as u32, 1 as u32, &code)
    check(&t, "password vault: memory below 8 KiB is Invalid", code == 4 as u32)
    var vp6: secret.Vault = open_p(root + "/pw/new", "x", 64 as u32, 99 as u32, &code)
    check(&t, "password vault: 99 passes is Invalid", code == 4 as u32)
    var vp7: secret.Vault = open_p(root + "/pw/new", "x", 4000000 as u32, 1 as u32, &code)
    check(&t, "password vault: 4 GB of memory is Invalid", code == 4 as u32)
    var vp8: secret.Vault = open_m(pw, &code)
    check(&t, "password vault: opened as a machine vault it is WrongKey", code == 5 as u32 || code == 2 as u32)
    // a hostile header that asks for a terabyte of memory
    var blob: rt.Buf = rt.buf_new()
    fs.read_file(pw, &blob) catch 0
    rt.st8(rt.buf_ptr(&blob), 31, 64 as u8) // m_kib = 0x40000000
    let hostile: str = root + "/pw/hostile"
    fs.write_file(hostile, rt.buf_ptr(&blob), rt.buf_len(&blob)) catch 0
    var vh: secret.Vault = open_p(hostile, "correct horse", 64 as u32, 1 as u32, &code)
    check(&t, "a header that asks for 1 TiB of Argon2 memory is Corrupt, not an attempt", code == 6 as u32)

    // =============================================== C. the machine vault
    let mp: str = root + "/m/secrets.v1"
    var v: secret.Vault = open_m(mp, &code)
    if code == 2 as u32 {
        io.print_line("note: no machine id here -- the machine vault checks are skipped")
        check(&t, "no machine id: Unavailable (not a crash)", true)
    } else {
        check(&t, "machine vault: a new one opens", code == 0 as u32)
        check(&t, "set", put(&v, "svc", "tok", "hello-token") == 0 as u32)
        check(&t, "get", get(&v, "svc", "tok", &code) == "hello-token" && code == 0 as u32)
        check(&t, "file mode 0600, directory 0700", win || (mode_of(mp) == 384 as u32 && mode_of(root + "/m") == 448 as u32))
        check(&t, "the secret is not in the file in the clear", file_lacks(mp, "hello-token") && file_lacks(mp, "svc"))
        let before: u64 = size_of(mp)
        check(&t, "an empty vault is 64 octets; one secret adds 8 + names + value", before == 48 + 16 + 8 + 3 + 3 + 11)
        // replace keeps one entry
        check(&t, "replace", put(&v, "svc", "tok", "second") == 0 as u32 && get(&v, "svc", "tok", &code) == "second" && count(&v) == 1)
        check(&t, "a second key", put(&v, "svc", "other", "x") == 0 as u32 && put(&v, "svc2", "tok", "y") == 0 as u32 && count(&v) == 3)
        check(&t, "the same key under another service is another secret", get(&v, "svc2", "tok", &code) == "y" && get(&v, "svc", "tok", &code) == "second")
        // Unicode and binary
        check(&t, "Unicode names and values", put(&v, "dienst", "schlüssel Ω", "wert ü") == 0 as u32 && get(&v, "dienst", "schlüssel Ω", &code) == "wert ü")
        var bin: [u8; 5] = [0, 255, 0, 10, 13]
        var vb: u32 = 0
        secret.vault_set(&v, "bin", "k", (&bin[0]) as u64, 5) catch | e | (bset(e, &vb))
        var bb: rt.Buf = rt.buf_new()
        secret.vault_get_into(&v, "bin", "k", &bb) catch 0
        check(&t, "binary values with NUL, CR, LF", vb == 0 as u32 && rt.buf_len(&bb) == 5 && rt.mem_eq(rt.buf_ptr(&bb), (&bin[0]) as u64, 5))
        check(&t, "an empty value", put(&v, "svc", "empty", "") == 0 as u32 && get(&v, "svc", "empty", &code) == "" && code == 0 as u32)
        // sizes
        var big: rt.Buf = rt.buf_new()
        var i: usize = 0
        while i < 65536 {
            rt.buf_push(&big, ((i * 3) & 255) as u8)
            i = i + 1
        }
        var vs: u32 = 0
        secret.vault_set(&v, "svc", "big", rt.buf_ptr(&big), 65536) catch | e | (bset(e, &vs))
        check(&t, "64 KiB is the largest value", vs == 0 as u32)
        var gb: rt.Buf = rt.buf_new()
        secret.vault_get_into(&v, "svc", "big", &gb) catch 0
        check(&t, "64 KiB comes back whole", rt.buf_len(&gb) == 65536 && rt.mem_eq(rt.buf_ptr(&gb), rt.buf_ptr(&big), 65536))
        vs = 0
        secret.vault_set(&v, "svc", "toobig", rt.buf_ptr(&big), 65537) catch | e | (bset(e, &vs))
        check(&t, "65537 octets is TooLarge", vs == 3 as u32)
        // names
        check(&t, "an empty service is Invalid", put(&v, "", "k", "v") == 4 as u32)
        check(&t, "an empty key is Invalid", put(&v, "s", "", "v") == 4 as u32)
        check(&t, "a service with / is Invalid", put(&v, "a/b", "k", "v") == 4 as u32)
        check(&t, "a key with / is fine", put(&v, "s", "a/b", "v") == 0 as u32)
        check(&t, "a control character in a name is Invalid", put(&v, "s", "a\nb", "v") == 4 as u32 && put(&v, "s\t", "k", "v") == 4 as u32)
        check(&t, "255 octets of name are fine, 256 are not", put(&v, rep(97 as u8, 255), "k", "v") == 0 as u32 && put(&v, rep(97 as u8, 256), "k", "v") == 4 as u32)
        get(&v, "svc", "nope", &code)
        check(&t, "a missing secret is NotFound", code == 1 as u32)
        // delete
        var dd: bool = secret.vault_delete(&v, "svc", "other") catch false
        var dn: bool = secret.vault_delete(&v, "svc", "other") catch true
        check(&t, "delete: true the first time, false the second (idempotent)", dd && !dn)
        get(&v, "svc", "other", &code)
        check(&t, "a deleted secret is NotFound", code == 1 as u32)
        check(&t, "the others are still there", get(&v, "svc", "tok", &code) == "second")
        // persistence: another handle on the same file
        var v2: secret.Vault = open_m(mp, &code)
        check(&t, "a second handle opens the file", code == 0 as u32 && get(&v2, "svc", "tok", &code) == "second")
        // two handles writing alternately lose nothing (each write re-reads under the lock)
        put(&v, "two", "a", "from v1")
        put(&v2, "two", "b", "from v2")
        put(&v, "two", "c", "from v1 again")
        check(&t, "two handles: nothing is lost", get(&v, "two", "b", &code) == "from v2" && get(&v2, "two", "a", &code) == "from v1" && get(&v2, "two", "c", &code) == "from v1 again")
        // two handles on a file that does not exist yet (each picks its own salt)
        let np: str = root + "/m2/secrets.v1"
        var n1: secret.Vault = open_m(np, &code)
        var n2: secret.Vault = open_m(np, &code)
        check(&t, "two fresh handles", put(&n1, "s", "a", "1") == 0 as u32 && put(&n2, "s", "b", "2") == 0 as u32)
        check(&t, "the second one adopted the first one's salt: both secrets are there", get(&n1, "s", "b", &code) == "2" && get(&n1, "s", "a", &code) == "1")
        // every save uses a fresh nonce
        var f1: rt.Buf = rt.buf_new()
        fs.read_file(mp, &f1) catch 0
        put(&v, "svc", "tok", "second")
        var f2: rt.Buf = rt.buf_new()
        fs.read_file(mp, &f2) catch 0
        check(&t, "a fresh nonce on every save", rt.buf_len(&f1) == rt.buf_len(&f2) && !rt.mem_eq(rt.buf_ptr(&f1) + 36, rt.buf_ptr(&f2) + 36, 12) && rt.mem_eq(rt.buf_ptr(&f1) + 12, rt.buf_ptr(&f2) + 12, 16))
        // tampering with the ciphertext, the header, the tag; truncation; a foreign file
        var tamper: u32 = 0
        var ti: usize = 0
        var flips: [usize; 5] = [60, 40, 20, 8, 48]
        var tampered: u32 = 0
        while ti < 5 {
            var c: rt.Buf = rt.buf_new()
            rt.buf_push_bytes(&c, rt.buf_ptr(&f2), rt.buf_len(&f2))
            rt.st8(rt.buf_ptr(&c), flips[ti], rt.ld8(rt.buf_ptr(&c), flips[ti]) ^ 1 as u8)
            let tp: str = root + "/m/tampered"
            fs.write_file(tp, rt.buf_ptr(&c), rt.buf_len(&c)) catch 0
            var tc: u32 = 0
            var vt: secret.Vault = open_m(tp, &tc)
            if tc == 5 as u32 || tc == 6 as u32 {
                tampered = tampered + 1
            }
            ti = ti + 1
        }
        check(&t, "a flipped bit anywhere (octet 8, 20, 40, 48, 60) is refused", tampered == 5)
        var cut: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&cut, rt.buf_ptr(&f2), rt.buf_len(&f2) - 1)
        fs.write_file(root + "/m/cut", rt.buf_ptr(&cut), rt.buf_len(&cut)) catch 0
        var vc: secret.Vault = open_m(root + "/m/cut", &code)
        check(&t, "a file one octet short is refused", code == 5 as u32 || code == 6 as u32)
        fs.write_file(root + "/m/foreign", "just some text that is long enough to pass for a header, but it is not one.".p as u64, 75) catch 0
        var vf: secret.Vault = open_m(root + "/m/foreign", &code)
        check(&t, "a foreign file is Corrupt", code == 6 as u32)
        // the machine key does not open a file whose salt/key came from elsewhere: use the password file
        var vx: secret.Vault = open_p(mp, "pw", 64 as u32, 1 as u32, &code)
        check(&t, "a machine file opened with a password is WrongKey", code == 5 as u32)
    }

    // =============================================== D. the simple API without side effects
    var inv: u32 = 0
    secret.secret_set("", "k", "v") catch | e | (bset(e, &inv))
    check(&t, "secret_set: an empty service is Invalid", inv == 4 as u32)
    inv = 0
    secret.secret_set("a/b", "k", "v") catch | e | (bset(e, &inv))
    check(&t, "secret_set: a service with / is Invalid", inv == 4 as u32)
    inv = 0
    secret.secret_get("s", "k\n") catch | e | (sset(e, &inv))
    check(&t, "secret_get: a control character is Invalid", inv == 4 as u32)
    inv = 0
    secret.secret_delete("", "k") catch | e | (bset(e, &inv))
    check(&t, "secret_delete: an empty service is Invalid", inv == 4 as u32)
    var bigv: rt.Buf = rt.buf_new()
    rt.buf_reserve(&bigv, 65537)
    var bi: usize = 0
    while bi < 65537 {
        rt.buf_push(&bigv, 120 as u8)
        bi = bi + 1
    }
    inv = 0
    secret.secret_set_bytes("s", "k", rt.buf_ptr(&bigv), 65537) catch | e | (bset(e, &inv))
    check(&t, "secret_set_bytes: over 64 KiB is TooLarge", inv == 3 as u32)
    check(&t, "secret_backend names the store", secret.secret_backend() == "file" || secret.secret_backend() == "wincred")

    fs.remove_tree(root) catch false
    io.print("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&nb, t.total)
    io.print_bytes(rt.buf_ptr(&nb), rt.buf_len(&nb))
    io.print_line("")
    if t.fails != 0 {
        return 1 as i32
    }
    return 0
}

fn sset(e: SecretError, code: *mut u32) -> str {
    *code = code_of(e)
    return ""
}

fn rep(c: u8, n: usize) -> str {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < n {
        rt.buf_push(&b, c)
        i = i + 1
    }
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

// whether the file does NOT contain the text
fn file_lacks(path: str, text: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    fs.read_file(path, &b) catch 0
    var i: usize = 0
    let n: usize = rt.buf_len(&b)
    while i + text.length() <= n {
        if rt.mem_eq(rt.buf_ptr(&b) + i as u64, text.p as u64, text.length()) {
            return false
        }
        i = i + 1
    }
    return true
}
