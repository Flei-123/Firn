// expect_exit: 42
// Round GAPS: `__sqrt` is ONE instruction (sqrtsd/sqrtss on x86-64, fsqrt
// on aarch64), correctly rounded by IEEE 754 -- including the edges that
// the old Newton loop in lib/std/core.fi got wrong or never left:
// sqrt(-0) = -0, sqrt(x < 0) = NaN, sqrt(inf) = inf, sqrt(NaN) = NaN.

fn bits(x: f64) -> u64 {
    var t: f64 = x
    return *(((&t) as usize) as *mut u64)
}

fn bits32(x: f32) -> u32 {
    var t: f32 = x
    return *(((&t) as usize) as *mut u32)
}

fn is_nan(x: f64) -> bool {
    return x != x
}

fn root_of(x: f64) -> f64 {
    return __sqrt(x)
}

fn main() -> i32 {
    if __sqrt(16.0) != 4.0 {
        return 1
    }
    if __sqrt(2.0) != 1.4142135623730951 {
        return 2
    }
    // correctly rounded: the exact bit pattern of sqrt(2)
    if bits(root_of(2.0)) != 0x3FF6A09E667F3BCD {
        return 3
    }
    let zero: f64 = 0.0
    let negzero: f64 = -zero
    if bits(root_of(negzero)) != 0x8000000000000000 {
        return 4
    }
    let inf: f64 = 1.0 / 0.0
    if root_of(inf) != inf {
        return 5
    }
    if !is_nan(root_of(0.0 - 1.0)) {
        return 6
    }
    if !is_nan(root_of(inf - inf)) {
        return 7
    }
    // huge and tiny magnitudes: exact squares come back exactly
    if root_of(1.0e300) != 1.0e150 {
        return 8
    }
    if root_of(1.0e-300) != 1.0e-150 {
        return 9
    }
    // f32 stays f32 (sqrtss)
    let h: f32 = 2.25 as f32
    let r: f32 = __sqrt(h)
    if bits32(r) != bits32(1.5 as f32) {
        return 10
    }
    // a loop: sum of sqrt(i) for i in 1..=10000 against the known value
    var s: f64 = 0.0
    var i: i64 = 1
    while i <= 10000 {
        s = s + root_of(i as f64)
        i = i + 1
    }
    if s < 666716.4 || s > 666716.5 {
        return 11
    }
    return 42
}
