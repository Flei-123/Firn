// expect_exit: 0
// AUFGESCHOBENE ANWEISUNGEN — die Reihenfolgen, an denen `defer` haengt
// (SPEC §5.1).
//
// Innerhalb eines Blocks laufen sie RUECKWAERTS. Bei `return` laufen ALLE
// Ebenen der Funktion, bei `break` und `continue` nur die, die INNERHALB der
// Schleife vereinbart wurden — die aeusseren laufen erst beim Verlassen ihres
// eigenen Blocks.
//
// Aufgeschrieben wird in einen Puffer, den der Aufrufer prueft: nur so ist die
// REIHENFOLGE sichtbar und nicht nur die Zahl der Aufrufe.

struct Trace {
    n: usize,
    z: [u8; 32],
}

fn remember(s: *mut Trace, c: u8) {
    if (*s).n < 32 {
        (*s).z[(*s).n] = c
        (*s).n = (*s).n + 1
    }
}

fn backward(s: *mut Trace) {
    defer remember(s, 65 as u8)
    defer remember(s, 66 as u8)
    defer remember(s, 67 as u8)
    remember(s, 46 as u8)
}

fn with_return(s: *mut Trace) -> i32 {
    defer remember(s, 97 as u8)
    {
        defer remember(s, 98 as u8)
        remember(s, 46 as u8)
        return 1
    }
}

fn in_loop(s: *mut Trace) {
    defer remember(s, 90 as u8)
    var i: i32 = 0
    while i < 3 {
        // ACHTUNG: das ARGUMENT wird erst beim Ablaufen ausgewertet, nicht
        // bei der Vereinbarung. Deshalb steht hier ein fester Wert — sonst
        // pruefte der Test die Reihenfolge und die Auswertungszeit auf einmal.
        defer remember(s, 120 as u8)
        i = i + 1
        if i == 2 {
            continue
        }
        if i == 3 {
            break
        }
    }
    remember(s, 46 as u8)
}

fn check(s: *mut Trace, expected: *mut Trace) -> bool {
    if (*s).n != (*expected).n {
        return false
    }
    var i: usize = 0
    while i < (*s).n {
        if (*s).z[i] != (*expected).z[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    // --- rueckwaerts innerhalb eines Blocks: ".CBA"
    var s1: Trace = Trace{ n: 0, z: [0 as u8; 32] }
    backward(&s1)
    if s1.n != 4 {
        return 1
    }
    if s1.z[0] != 46 as u8 || s1.z[1] != 67 as u8 || s1.z[2] != 66 as u8 || s1.z[3] != 65 as u8 {
        return 2
    }

    // --- `return` aus einem inneren Block: erst der innere, dann der aeussere
    var s2: Trace = Trace{ n: 0, z: [0 as u8; 32] }
    if with_return(&s2) != 1 {
        return 3
    }
    if s2.n != 3 {
        return 4
    }
    if s2.z[0] != 46 as u8 || s2.z[1] != 98 as u8 || s2.z[2] != 97 as u8 {
        return 5
    }

    // --- Schleife: je Durchlauf laeuft das innere `defer`, das aeussere erst
    // ganz am Ende. Erwartet: "xxx.Z"
    var s3: Trace = Trace{ n: 0, z: [0 as u8; 32] }
    in_loop(&s3)
    if s3.n != 5 {
        return 6
    }
    if s3.z[0] != 120 as u8 || s3.z[1] != 120 as u8 || s3.z[2] != 120 as u8 {
        return 7
    }
    if s3.z[3] != 46 as u8 || s3.z[4] != 90 as u8 {
        return 8
    }
    return 0
}
