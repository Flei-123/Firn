// expect_exit: 0
// DEFERRED STATEMENTS -- the orders that `defer` depends on
// (SPEC 5.1).
//
// Inside a block they run BACKWARDS. At `return` ALL levels of the function
// run, at `break` and `continue` only those declared INSIDE the loop -- the
// outer ones only run when their own block is
// left.
//
// What is written goes into a buffer that the caller checks: only that way
// is the ORDER visible and not just the number of calls.

struct Trace {
    n: usize,
    z: [u8; 32],
}

fn remember(s: *mut Trace, c: u8) {
    if (*s).n < 32 {
        (*s).z[(*s).n] = c
        (*s).n = (*s).n + 1
    }
}

fn backward(s: *mut Trace) {
    defer remember(s, 65 as u8)
    defer remember(s, 66 as u8)
    defer remember(s, 67 as u8)
    remember(s, 46 as u8)
}

fn with_return(s: *mut Trace) -> i32 {
    defer remember(s, 97 as u8)
    {
        defer remember(s, 98 as u8)
        remember(s, 46 as u8)
        return 1
    }
}

fn in_loop(s: *mut Trace) {
    defer remember(s, 90 as u8)
    var i: i32 = 0
    while i < 3 {
        // NOTE: the ARGUMENT is only evaluated when the deferred statement runs, not
        // at the declaration. That is why a fixed value stands here -- otherwise
        // the test would check the order and the evaluation time at once.
        defer remember(s, 120 as u8)
        i = i + 1
        if i == 2 {
            continue
        }
        if i == 3 {
            break
        }
    }
    remember(s, 46 as u8)
}

fn check(s: *mut Trace, expected: *mut Trace) -> bool {
    if (*s).n != (*expected).n {
        return false
    }
    var i: usize = 0
    while i < (*s).n {
        if (*s).z[i] != (*expected).z[i] {
            return false
        }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    // --- backwards inside a block: ".CBA"
    var s1: Trace = Trace { n: 0, z: [0 as u8; 32] }
    backward(&s1)
    if s1.n != 4 {
        return 1
    }
    if s1.z[0] != 46 as u8 || s1.z[1] != 67 as u8 || s1.z[2] != 66 as u8 || s1.z[3] != 65 as u8 {
        return 2
    }

    // --- `return` from an inner block: the inner one first, then the outer
    var s2: Trace = Trace { n: 0, z: [0 as u8; 32] }
    if with_return(&s2) != 1 {
        return 3
    }
    if s2.n != 3 {
        return 4
    }
    if s2.z[0] != 46 as u8 || s2.z[1] != 98 as u8 || s2.z[2] != 97 as u8 {
        return 5
    }

    // --- loop: the inner `defer` runs per pass, the outer one only at the
    // very end. Expected: "xxx.Z"
    var s3: Trace = Trace { n: 0, z: [0 as u8; 32] }
    in_loop(&s3)
    if s3.n != 5 {
        return 6
    }
    if s3.z[0] != 120 as u8 || s3.z[1] != 120 as u8 || s3.z[2] != 120 as u8 {
        return 7
    }
    if s3.z[3] != 46 as u8 || s3.z[4] != 90 as u8 {
        return 8
    }
    return 0
}
