// expect_out: r69 bridge: span 11 caught 22 built 31 ok
// tests/1280_std_io_span.fi -- the ONE address form (round 69).
//
// `rt` carries an address as a `u64`, `str` and `num` as a `*mut u8`.
// Outward there is exactly one form now, and it is `*mut u8`
// (docs/ROUND69.md). What is checked here:
//
//   1. THE BRIDGE. `rt.buf_data` gives the contents of a buffer their
//      honest type; `rt.addr_of`/`rt.ptr_of` carry the same address back
//      and forth. `rt.buf_ptr` is now a thin shell over `rt.buf_data` --
//      both have to deliver the SAME address, otherwise there would be two
//      truths about one buffer again.
//   2. OUTPUT WITHOUT A CAST. `io.write`/`write_line`/`write_c`/
//      `write_c_line` take a `Span` resp. a typed pointer. They write onto
//      descriptor 1, so the test catches it with `dup`/`dup2` in a file and
//      counts the octets -- the same method tests/806 uses.
//   3. THE BUILDER. `io.fmt_span` (a `Span` as a segment), `io.fmt_f64`
//      (the shortest decimal text that reads back) and `io.fmt_bool` (now
//      `true`/`false`, no longer German) are compared against the expected
//      text CHARACTER BY CHARACTER, not just by length.
import std.io
import std.rt
import std.str

const SYS_DUP: i64 = 32
const SYS_DUP2: i64 = 33
const SYS_CLOSE: i64 = 3

fn main() -> i32 {
    var path: [u8; 22] = "/tmp/firn1280_out.txt\0"
    var source: [u8; 11] = "hello world"
    var cs: [u8; 3] = "ab\0"
    var want: [u8; 32] = "hello world|0.1|-2.5|true|false\0"

    // --- 1. the bridge: one buffer, one address, two spellings
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, rt.addr_of(&source[0]), 11)
    if rt.addr_of(rt.buf_data(&b)) != rt.buf_ptr(&b) {
        return 10
    }
    if rt.addr_of(rt.ptr_of(rt.buf_ptr(&b))) != rt.buf_ptr(&b) {
        return 11
    }
    let s: str.Span = io.span_of_buf(&b)
    if s.n != 11 {
        return 12
    }
    if !str.equal(s, str.span(&source[0], 11)) {
        return 13
    }
    // An empty buffer gives an empty span, not a null pointer with a length.
    var empty: rt.Buf = rt.buf_new()
    if io.span_of_buf(&empty).length() != 0 {
        return 14
    }
    rt.buf_free(&empty)

    // --- 2. output as a Span, caught on descriptor 1
    let saved: i64 = syscall(SYS_DUP, 1, 0, 0, 0, 0, 0)
    if saved < 0 {
        return 20
    }
    let fd: i64 = syscall(2, rt.addr_of(&path[0]) as i64, 577, 493, 0, 0, 0)
    if fd < 0 {
        return 21
    }
    syscall(SYS_DUP2, fd, 1, 0, 0, 0, 0)
    io.write(s) // 11
    io.write_line(str.span_to(s, 5)) // 5 + 1
    io.write_c(&cs[0]) // 2
    io.write_c_line(&cs[0]) // 2 + 1
    syscall(SYS_DUP2, saved, 1, 0, 0, 0, 0)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    syscall(SYS_CLOSE, saved, 0, 0, 0, 0, 0)

    var caught: rt.Buf = rt.buf_new()
    if !io.read_file(rt.addr_of(&path[0]), &caught) {
        return 22
    }
    let caught_length: usize = rt.buf_len(&caught)
    if caught_length != 22 {
        return 23
    }
    // "hello world" "hello\n" "ab" "ab\n"
    if rt.buf_at(&caught, 16) != 10 as u8 || rt.buf_at(&caught, 21) != 10 as u8 {
        return 24
    }
    rt.buf_free(&caught)

    // the stderr paths get walked once (not part of the compared output)
    io.write_err(str.span_to(s, 2))
    io.write_err_line(str.span_to(s, 2))

    // --- 3. the builder: span, f64, bool
    var f: io.Fmt = io.fmt_new()
    f = io.fmt_span(f, s)
    f = io.fmt_char(f, 124 as u8)
    f = io.fmt_f64(f, 0.1)
    f = io.fmt_char(f, 124 as u8)
    f = io.fmt_f64(f, 0.0 - 2.5)
    f = io.fmt_char(f, 124 as u8)
    f = io.fmt_bool(f, true)
    f = io.fmt_char(f, 124 as u8)
    f = io.fmt_bool(f, false)
    let built: usize = io.fmt_len(f)
    var out: rt.Buf = rt.buf_new()
    io.fmt_content(f, &out)
    if !str.equal(io.span_of_buf(&out), str.span_of_c(&want[0])) {
        return 30
    }
    if built != 31 {
        return 31
    }
    rt.buf_free(&out)
    rt.buf_free(&b)

    io.fmt_print(f"r69 bridge: span {s.n} caught {caught_length} ")
    io.fmt_print_line(f"built {built} ok")
    return 0
}
