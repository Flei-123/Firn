// expect_exit: 0
// mc_inv container windows (chest 9x3 / 9x6, unsupported type): Open Window -> Window Items / Set Slot of that window -> Click Container with
// window slot numbers (container slot k = window slot k, the 36 player slots follow), shift click container <-> player (ChestMenu.quickMoveStack),
// pick up, drag across container slots (also slots >= 64 internal), Close Window. The click packets must parse with the schema of the version.
// Return codes: 1xx = setup, 2xx.. = cases (case*10 + check).
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_schema
import mc.mc_registry
import mc.mc_inv

fn it(r: *mut mc_registry.Registry, name: str) -> i32 { return mc_registry.reg_item_by_name(r, name.p as u64, name.n) }

fn layout(ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let id: i32 = mc_version.version_pid(ver, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK)
    if id < 0 { return false }
    let sch: u64 = (*ver).schema_of(mc_version.ST_PLAY, mc_version.DIR_C2S, id)
    if sch == 0 as u64 { return false }
    bytes.bytes_set_pos(b, 0)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk(sch, b, &out)
    rt.buf_free(&out)
    return ok
}

// one click; returns the number of changed slots (>= 0, only >= 1.17), -1 = not built, -2 = does not parse. `win` receives the window id byte.
fn click(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32, win: *mut i32) -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(v, (*ver).protocol, slot, button, mode, &b) { bytes.bytes_free(&b); return 0 - 1 }
    *win = bytes.bytes_at(&b, 0) as i32
    let ok: bool = layout(ver, &b)
    var n: i32 = 0
    if (*ver).protocol >= 756 { n = bytes.bytes_at(&b, 6) as i32 }
    bytes.bytes_free(&b)
    if !ok { return 0 - 2 }
    return n
}

fn clk(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32) -> i32 {
    var w: i32 = 0
    return click(v, ver, slot, button, mode, &w)
}

fn put_stack(b: *mut bytes.Bytes, p: i32, item: i32, count: i32) {
    if p >= 766 {
        if item < 0 { bytes.put_varint(b, 0); return }
        bytes.put_varint(b, count)
        bytes.put_varint(b, item)
        bytes.put_varint(b, 0)
        bytes.put_varint(b, 0)
    } else {
        if item < 0 { bytes.put_bool(b, false); return }
        bytes.put_bool(b, true)
        bytes.put_varint(b, item)
        bytes.put_i8(b, count as i8)
        bytes.put_u8(b, 0 as u8)
    }
}

// Open Window: 1.14+ varint id, varint type, title; 1.13.2 u8 id, type string, title string, u8 slot count
fn open_win(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32, typ: i32, legacy_name: str, legacy_n: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    if (*ver).protocol >= 477 {
        bytes.put_varint(&b, id)
        bytes.put_varint(&b, typ)
        bytes.put_u8(&b, 0 as u8)
    } else {
        bytes.put_u8(&b, id as u8)
        bytes.put_string(&b, legacy_name.p as u64, legacy_name.n)
        bytes.put_string(&b, "{}".p as u64, 2)
        bytes.put_u8(&b, legacy_n as u8)
    }
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_open_window_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn win_items(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32, items: u64, counts: u64, n: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    let p: i32 = (*ver).protocol
    bytes.put_u8(&b, id as u8)
    if p >= 756 {
        bytes.put_varint(&b, 7) // stateId
        bytes.put_varint(&b, n)
    } else {
        bytes.put_i16(&b, n as i16)
    }
    var i: i32 = 0
    while i < n {
        put_stack(&b, p, rt.ld32(items, i as usize) as i32 - 1, rt.ld32(counts, i as usize) as i32)
        i = i + 1
    }
    if p >= 756 { put_stack(&b, p, 0 - 1, 0) } // carried item
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_window_items_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn set_slot(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32, slot: i32, item: i32, count: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    let p: i32 = (*ver).protocol
    bytes.put_u8(&b, id as u8)
    if p >= 756 { bytes.put_varint(&b, 8) }
    bytes.put_i16(&b, slot as i16)
    put_stack(&b, p, item, count)
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_set_slot_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn close_win(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    if (*ver).protocol >= 768 { bytes.put_varint(&b, id) } else { bytes.put_u8(&b, id as u8) }
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_close_window_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn fresh(r: *mut mc_registry.Registry) -> mc_inv.Inv {
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_use_registry(&v, r)
    return v
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var r: mc_registry.Registry = ver.registry_of()
    if !mc_registry.registry_ok(&r) { return 101 }
    let stone: i32 = it(&r, "stone")
    let dirt: i32 = it(&r, "dirt")
    if stone < 0 || dirt < 0 { return 102 }
    var v: mc_inv.Inv = fresh(&r)

    // 1: open a 9x3 chest (window 3, menu type 2 / "minecraft:chest" with 27 slots)
    if !open_win(&v, &ver, 3, 2, "minecraft:chest", 27) { return 10 }
    if mc_inv.inv_window(&v) != 3 || mc_inv.inv_window_slots(&v) != 27 || mc_inv.inv_window_size(&v) != 63 { return 11 }
    // 2: Window Items: container slot 0 = 10 stone, slot 26 = 5 dirt, window slot 27 (= main slot 9) = 60 stone, window slot 54 (= hotbar 36) = 1 dirt
    let items: u64 = rt.heap_alloc(63 * 4)
    let counts: u64 = rt.heap_alloc(63 * 4)
    var k: usize = 0
    while k < 63 { rt.st32(items, k, 0 as u32); rt.st32(counts, k, 0 as u32); k = k + 1 }
    rt.st32(items, 0, (stone + 1) as u32); rt.st32(counts, 0, 10 as u32)
    rt.st32(items, 26, (dirt + 1) as u32); rt.st32(counts, 26, 5 as u32)
    rt.st32(items, 27, (stone + 1) as u32); rt.st32(counts, 27, 60 as u32)
    rt.st32(items, 54, (dirt + 1) as u32); rt.st32(counts, 54, 1 as u32)
    let okw: bool = win_items(&v, &ver, 3, items, counts, 63)
    rt.heap_free(items, 63 * 4)
    rt.heap_free(counts, 63 * 4)
    if !okw { return 20 }
    if mc_inv.inv_win_item(&v, 0) != stone || mc_inv.inv_win_count(&v, 0) != 10 || mc_inv.inv_win_item(&v, 26) != dirt { return 21 }
    if mc_inv.inv_item(&v, 9) != stone || mc_inv.inv_count(&v, 9) != 60 || mc_inv.inv_item(&v, 36) != dirt || mc_inv.inv_item(&v, 10) != 0 - 1 { return 22 }
    // a Window Items of another window id is ignored
    if win_items(&v, &ver, 9, 0 as u64, 0 as u64, 0) { return 23 }
    // 3: Set Slot of the container window, and of window 0 (identity)
    if !set_slot(&v, &ver, 3, 1, stone, 3) || mc_inv.inv_win_item(&v, 1) != stone || mc_inv.inv_win_count(&v, 1) != 3 { return 30 }
    if !set_slot(&v, &ver, 0, 38, dirt, 2) || mc_inv.inv_item(&v, 38) != dirt { return 31 }
    if !set_slot(&v, &ver, 3, 27 + 29, dirt, 4) || mc_inv.inv_item(&v, 38) != dirt || mc_inv.inv_count(&v, 38) != 4 { return 32 } // window 56 = hotbar 38
    if !set_slot(&v, &ver, 3, 1, 0 - 1, 0) { return 33 }

    // 4: shift click container slot 0 (10 stone) -> player inventory from the back: merges into the 60 (4), the other 6 go to the last free slot (44)
    var w: i32 = 0
    let n4: i32 = click(&v, &ver, 0, 0, 1, &w)
    if n4 < 0 { return 40 }
    if w != 3 { return 41 }
    if mc_inv.inv_win_item(&v, 0) != 0 - 1 || mc_inv.inv_count(&v, 9) != 64 || mc_inv.inv_item(&v, 44) != stone || mc_inv.inv_count(&v, 44) != 6 { return 42 }
    if p >= 756 && n4 != 3 { return 43 } // container slot 0, window slot 27 (main 9), window slot 62 (hotbar 44)
    // 5: shift click a player slot (window slot 54 = hotbar 36, 1 dirt) -> container: merges into the 5 dirt of slot 26
    if clk(&v, &ver, 54, 0, 1) < 0 { return 50 }
    if mc_inv.inv_win_item(&v, 26) != dirt || mc_inv.inv_win_count(&v, 26) != 6 || mc_inv.inv_item(&v, 36) != 0 - 1 { return 51 }
    // shift click a stone from the player side: no stack to merge with in the container -> first empty container slot (0)
    if clk(&v, &ver, 27, 0, 1) < 0 { return 52 }
    if mc_inv.inv_win_item(&v, 0) != stone || mc_inv.inv_win_count(&v, 0) != 64 || mc_inv.inv_item(&v, 9) != 0 - 1 { return 53 }
    // 6: pick up / put down in the container
    if clk(&v, &ver, 26, 0, 0) < 0 || mc_inv.inv_cursor_item(&v) != dirt || mc_inv.inv_cursor_count(&v) != 6 || mc_inv.inv_win_item(&v, 26) != 0 - 1 { return 60 }
    if clk(&v, &ver, 3, 0, 0) < 0 || mc_inv.inv_cursor_item(&v) != 0 - 1 || mc_inv.inv_win_item(&v, 3) != dirt || mc_inv.inv_win_count(&v, 3) != 6 { return 61 }
    // 7: drag 6 dirt-free: pick up 6 dirt again, drag (left = split evenly) over container slots 5, 6, 7 -> 2 each
    if clk(&v, &ver, 3, 0, 0) < 0 { return 70 }
    if clk(&v, &ver, 0 - 999, 0, 5) < 0 || clk(&v, &ver, 5, 1, 5) < 0 || clk(&v, &ver, 6, 1, 5) < 0 || clk(&v, &ver, 7, 1, 5) < 0 || clk(&v, &ver, 0 - 999, 2, 5) < 0 { return 71 }
    if mc_inv.inv_win_count(&v, 5) != 2 || mc_inv.inv_win_count(&v, 6) != 2 || mc_inv.inv_win_count(&v, 7) != 2 || mc_inv.inv_cursor_item(&v) != 0 - 1 { return 72 }
    // 8: out of the window: nothing predicted, packet still valid
    if clk(&v, &ver, 63, 0, 0) < 0 { return 80 }
    // 9: the server closes the window: slots forgotten, window 0 again
    if close_win(&v, &ver, 4) { return 90 }
    if !close_win(&v, &ver, 3) { return 91 }
    if mc_inv.inv_window(&v) != 0 || mc_inv.inv_item(&v, 46) != 0 - 1 || mc_inv.inv_item(&v, 51) != 0 - 1 { return 92 }
    var w0: i32 = 9
    if click(&v, &ver, 12, 0, 0, &w0) < 0 || w0 != 0 { return 93 }

    // 10: a big chest (9x6, menu type 5): drag over container slots 50 and 51 (internal 96, 97 = the second 64-bit mask word)
    if !open_win(&v, &ver, 5, 5, "minecraft:chest", 54) { return 100 }
    if mc_inv.inv_window_slots(&v) != 54 { return 101 }
    if !set_slot(&v, &ver, 5, 54, stone, 4) { return 102 }
    if clk(&v, &ver, 54, 0, 0) < 0 || mc_inv.inv_cursor_count(&v) != 4 { return 103 }
    if clk(&v, &ver, 0 - 999, 0, 5) < 0 || clk(&v, &ver, 50, 1, 5) < 0 || clk(&v, &ver, 51, 1, 5) < 0 || clk(&v, &ver, 0 - 999, 2, 5) < 0 { return 104 }
    if mc_inv.inv_win_count(&v, 50) != 2 || mc_inv.inv_win_count(&v, 51) != 2 || mc_inv.inv_cursor_item(&v) != 0 - 1 { return 105 }
    // shift click from the last container slot into the player inventory; shift click from the player back
    if clk(&v, &ver, 50, 0, 1) < 0 || mc_inv.inv_win_item(&v, 50) != 0 - 1 || mc_inv.inv_item(&v, 44) != stone { return 106 }
    // local close (client side)
    mc_inv.inv_local_close(&v)
    if mc_inv.inv_window(&v) != 0 || mc_inv.inv_item(&v, 46 + 51) != 0 - 1 { return 107 }

    // 11: a window type we do not model (menu type 7+): tracked, items ignored, clicks not built
    if !open_win(&v, &ver, 6, 99, "minecraft:unknown", 3) { return 110 }
    if mc_inv.inv_window(&v) != 6 || mc_inv.inv_window_slots(&v) >= 0 { return 111 }
    if win_items(&v, &ver, 6, 0 as u64, 0 as u64, 0) { return 112 }
    if clk(&v, &ver, 10, 0, 0) != 0 - 1 { return 113 }
    if !close_win(&v, &ver, 6) || mc_inv.inv_window(&v) != 0 { return 114 }
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    // exit codes are 8 bit: the failing check, the stage is the first failing protocol
    var r: i32 = check(498)
    if r != 0 { return r }
    r = check(754)
    if r != 0 { return r }
    r = check(763)
    if r != 0 { return r }
    r = check(769)
    if r != 0 { return r }
    r = check(775)
    if r != 0 { return r }
    return 0
}
