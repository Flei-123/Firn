// expect_exit: 0
// tests/2813_mc_assets_ext.fi -- resource packs in the client: default tile upscale, extended tiles (every solid block, top / side /
// bottom), animated textures (frametime, frames, interpolate), pack_format table + range, pack manager (config, auto discovery,
// hot reload, backend upload). Packs are built in-process from own pixel patterns (no Mojang files).
import std.rt
import std.fs
import std.fsx
import zip.zip
import pack.icons
import mc.mc_version
import mc.mc_versions
import mc.mc_registry
import mc.mc_mesh
import mc.mc_texture
import mc.mc_texext
import mc.mc_blocktex
import mc.mc_assets
import mc.mc_raster
import mc.mc_backend
import mc.mc_packs


fn px_of(r: u32, g: u32, b: u32) -> u32 {
    return mc_texture.pack_pixel(r, g, b, 255 as u32)
}

// size x size PNG: left half (r,g,b), right half (b,g,r)
fn mk_png(size: usize, r: u32, g: u32, b: u32, out: *mut rt.Buf) -> bool {
    let px: u64 = rt.heap_alloc(size * size * 4)
    var y: usize = 0
    while y < size {
        var x: usize = 0
        while x < size {
            let i: usize = (y * size + x) * 4
            if x < size / 2 {
                rt.st8(px, i, r as u8)
                rt.st8(px, i + 1, g as u8)
                rt.st8(px, i + 2, b as u8)
            } else {
                rt.st8(px, i, b as u8)
                rt.st8(px, i + 1, g as u8)
                rt.st8(px, i + 2, r as u8)
            }
            rt.st8(px, i + 3, 255 as u8)
            x = x + 1
        }
        y = y + 1
    }
    let ok: bool = icons.png_encode(px, size, size, out)
    rt.heap_free(px, size * size * 4)
    return ok
}

// vertical strip of nf solid frames: frame f = (10 + 50 f, 100, 200 - 40 f)
fn mk_strip(w: usize, nf: usize, out: *mut rt.Buf) -> bool {
    let h: usize = w * nf
    let px: u64 = rt.heap_alloc(w * h * 4)
    var y: usize = 0
    while y < h {
        let f: usize = y / w
        var x: usize = 0
        while x < w {
            let i: usize = (y * w + x) * 4
            rt.st8(px, i, (10 + 50 * f) as u8)
            rt.st8(px, i + 1, 100 as u8)
            rt.st8(px, i + 2, (200 - 40 * f) as u8)
            rt.st8(px, i + 3, 255 as u8)
            x = x + 1
        }
        y = y + 1
    }
    let ok: bool = icons.png_encode(px, w, h, out)
    rt.heap_free(px, w * h * 4)
    return ok
}

fn add_str(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    var ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

fn add_png(w: *mut zip.ZipWriter, name: str, size: usize, r: u32, g: u32, b: u32) -> bool {
    var p: rt.Buf = rt.buf_new()
    var ok: bool = mk_png(size, r, g, b, &p)
    if ok { ok = zip.zip_add(w, name, rt.buf_ptr(&p), rt.buf_len(&p), true) catch | e | (false) }
    rt.buf_free(&p)
    return ok
}

fn add_strip(w: *mut zip.ZipWriter, name: str, size: usize, nf: usize) -> bool {
    var p: rt.Buf = rt.buf_new()
    var ok: bool = mk_strip(size, nf, &p)
    if ok { ok = zip.zip_add(w, name, rt.buf_ptr(&p), rt.buf_len(&p), true) catch | e | (false) }
    rt.buf_free(&p)
    return ok
}

fn save(path: str, b: *mut rt.Buf) -> bool {
    var n: usize = fs.write_file(path, rt.buf_ptr(b), rt.buf_len(b)) catch | e | (0)
    return n == rt.buf_len(b)
}

const META15: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"

// pack 1: stone (32 px, A = 200,10,10), grass top / side, dirt, oak_planks, oak_log + top, water strip (3 frames, frametime 2)
fn build_pack1(path: str, stone_r: u32) -> bool {
    var b: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&b)
    let t: str = "assets/minecraft/textures/block/"
    if !add_str(&w, "pack.mcmeta", META15) { return false }
    if !add_png(&w, "assets/minecraft/textures/block/stone.png", 32, stone_r, 10 as u32, 10 as u32) { return false }
    if !add_png(&w, "assets/minecraft/textures/block/grass_block_top.png", 16, 20 as u32, 200 as u32, 20 as u32) { return false }
    if !add_png(&w, "assets/minecraft/textures/block/grass_block_side.png", 16, 20 as u32, 150 as u32, 30 as u32) { return false }
    if !add_png(&w, "assets/minecraft/textures/block/dirt.png", 16, 120 as u32, 80 as u32, 40 as u32) { return false }
    if !add_png(&w, "assets/minecraft/textures/block/oak_planks.png", 16, 190 as u32, 150 as u32, 90 as u32) { return false }
    if !add_png(&w, "assets/minecraft/textures/block/oak_log.png", 16, 100 as u32, 70 as u32, 40 as u32) { return false }
    if !add_png(&w, "assets/minecraft/textures/block/oak_log_top.png", 16, 170 as u32, 140 as u32, 80 as u32) { return false }
    if !add_strip(&w, "assets/minecraft/textures/block/water_still.png", 16, 3) { return false }
    if !add_str(&w, "assets/minecraft/textures/block/water_still.png.mcmeta", "{\"animation\":{\"frametime\":2}}") { return false }
    var n: usize = zip.zip_finish(&w) catch | e | (0)
    zip.zip_writer_free(&w)
    var ok: bool = n > 0 && save(path, &b)
    rt.buf_free(&b)
    return ok
}

// pack 2: lava strip (2 frames, frametime 4, interpolate) + a stone in another colour (loses against pack 1)
fn build_pack2(path: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&b)
    if !add_str(&w, "pack.mcmeta", META15) { return false }
    if !add_strip(&w, "assets/minecraft/textures/block/lava_still.png", 16, 2) { return false }
    if !add_str(&w, "assets/minecraft/textures/block/lava_still.png.mcmeta", "{\"animation\":{\"frametime\":4,\"interpolate\":true}}") { return false }
    if !add_png(&w, "assets/minecraft/textures/block/stone.png", 16, 1 as u32, 2 as u32, 3 as u32) { return false }
    var n: usize = zip.zip_finish(&w) catch | e | (0)
    zip.zip_writer_free(&w)
    var ok: bool = n > 0 && save(path, &b)
    rt.buf_free(&b)
    return ok
}

fn build_meta_pack(path: str, meta: str, stone_r: u32) -> bool {
    var b: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&b)
    if !add_str(&w, "pack.mcmeta", meta) { return false }
    if !add_png(&w, "assets/minecraft/textures/block/stone.png", 16, stone_r, 10 as u32, 10 as u32) { return false }
    var n: usize = zip.zip_finish(&w) catch | e | (0)
    zip.zip_writer_free(&w)
    var ok: bool = n > 0 && save(path, &b)
    rt.buf_free(&b)
    return ok
}

fn tile_checksum(tb: *mut mc_mesh.MeshTables) -> u64 {
    var h: u64 = 1469598103934665603 as u64
    var i: usize = 0
    while i < 32768 * 6 {
        h = (h ^ (rt.ld16((*tb).tiles, i) as u64)) *% 1099511628211 as u64
        i = i + 1
    }
    return h
}

fn state_of(r: *mut mc_registry.Registry, name: str) -> usize {
    let b: i32 = mc_registry.reg_block_by_name(r, name.p as u64, name.length())
    if b < 0 { return 0 }
    return mc_registry.reg_block_min_state(r, b) as usize
}

fn body(base: str) -> i32 {
    // ---- 1. default tiles at a bigger tile size are not empty
    var a16: mc_texture.Atlas = mc_texture.atlas_default()
    var a32: mc_texture.Atlas = mc_texture.atlas_new(32, 16, 16)
    if !mc_texture.atlas_fill_default(&a32) { return 1 }
    if mc_texture.atlas_texel(&a32, mc_texture.T_SAND, 8, 8) != mc_texture.atlas_texel(&a16, mc_texture.T_SAND, 4, 4) { return 2 }
    if mc_texture.atlas_texel(&a32, mc_texture.T_SAND, 9, 9) != mc_texture.atlas_texel(&a16, mc_texture.T_SAND, 4, 4) { return 3 }
    if (mc_texture.atlas_texel(&a32, mc_texture.T_STONE, 31, 31) >> 24 as u32) != 255 as u32 { return 4 }
    if mc_texture.atlas_texel(&a32, mc_texture.T_UNKNOWN, 0, 0) != mc_texture.atlas_texel(&a16, mc_texture.T_UNKNOWN, 0, 0) { return 5 }

    // ---- 2. generated name table + extended tables for 1.20.1
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 10 }
    var reg: mc_registry.Registry = v.registry_of()
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    var m: mc_packs.ResMgr = mc_packs.res_new()
    mc_packs.res_build_tables(&m, &reg, &tb)
    let nex: usize = mc_texext.texext_count(&m.ex)
    if nex < 100 || nex > 1200 { return 11 }
    let st_stone: usize = state_of(&reg, "stone")
    let st_grass: usize = state_of(&reg, "grass_block")
    let st_stairs: usize = state_of(&reg, "oak_stairs")
    let st_planks: usize = state_of(&reg, "oak_planks")
    let st_log: usize = state_of(&reg, "oak_log")
    let st_water: usize = state_of(&reg, "water")
    let st_lava: usize = state_of(&reg, "lava")
    let st_dandelion: usize = state_of(&reg, "dandelion")
    let t_stone: u32 = rt.ld16(tb.tiles, st_stone * 6) as u32
    if t_stone < 64 as u32 || mc_texext.texext_default(&m.ex, (t_stone - 64 as u32) as usize) != mc_texture.T_STONE { return 12 }
    let g_side: u32 = rt.ld16(tb.tiles, st_grass * 6) as u32
    let g_top: u32 = rt.ld16(tb.tiles, st_grass * 6 + 3) as u32
    let g_bot: u32 = rt.ld16(tb.tiles, st_grass * 6 + 2) as u32
    if g_side < 64 as u32 || g_top < 64 as u32 || g_bot < 64 as u32 { return 13 }
    if g_side == g_top || g_side == g_bot || g_top == g_bot { return 14 }
    if rt.ld16(tb.tiles, st_grass * 6 + 5) as u32 != g_side { return 15 }
    if rt.ld16(tb.tiles, st_dandelion * 6) != 0 as u16 { return 16 } // plants: still no face
    let l_side: u32 = rt.ld16(tb.tiles, st_log * 6) as u32
    let l_top: u32 = rt.ld16(tb.tiles, st_log * 6 + 3) as u32
    if l_side == l_top || rt.ld16(tb.tiles, st_log * 6 + 2) as u32 != l_top { return 17 }
    let s_face: u32 = rt.ld16(tb.tiles, st_stairs * 6) as u32
    if s_face < 64 as u32 { return 18 }
    // the generated table knows more than the old rules: a name lookup works and stone has side == top == bottom
    var slot: [u32; 3] = [0 as u32; 3]
    if !mc_texext.texext_lookup(&m.ex, "oak_planks".p as u64, 10, &slot) { return 19 }
    if mc_texext.texext_lookup(&m.ex, "no_such_block".p as u64, 13, &slot) { return 20 }
    // pack_format table
    if mc_blocktex.pack_format_for_protocol(763) != 15 || mc_blocktex.pack_format_for_protocol(47) != 1 { return 21 }
    if mc_blocktex.pack_format_for_protocol(1) != 0 - 1 { return 22 }

    // ---- 3. without packs the extended atlas looks like the default one
    var ax: mc_texture.Atlas = mc_texext.texext_atlas_new(16, &m.ex)
    if mc_texture.atlas_texel(&ax, t_stone, 3, 5) != mc_texture.atlas_texel(&ax, mc_texture.T_STONE, 3, 5) { return 30 }
    mc_texture.atlas_free(&ax)

    // ---- 4. packs on disk -> manager
    fs.remove_tree(base) catch | e | (false)
    fs.mkdir_all(base) catch | e | (false)
    if !build_pack1("" + base + "/p1.zip", 200 as u32) { return 40 }
    if !build_pack2("" + base + "/p2.zip") { return 41 }
    mc_packs.res_set_protocol(&m, 763)
    if !mc_packs.res_add_path(&m, "" + base + "/p1.zip") { return 42 }
    if !mc_packs.res_add_path(&m, "" + base + "/p2.zip") { return 43 }
    if !mc_packs.res_add_path(&m, "" + base + "/p2.zip") { return 44 } // duplicate: ignored
    if mc_packs.res_path_count(&m) != 2 { return 45 }
    var r: mc_raster.Raster = mc_raster.raster_new(64, 64)
    var be: mc_backend.Backend = mc_backend.backend_cpu(&r)
    if mc_packs.res_reload_upload(&m, &be) != 2 { return 46 }
    if mc_packs.res_warn_count(&m) != 0 { return 47 }
    if mc_packs.res_tile_size(&m) != 32 { return 48 }
    if r.apx != m.atlas.px || r.atile != 32 { return 49 }
    let at: *mut mc_texture.Atlas = &m.atlas
    // stone: pack 1 wins over pack 2, both tile 1 and the extended tile; left half A, right half mirrored
    if mc_texture.atlas_texel(at, mc_texture.T_STONE, 3, 3) != px_of(200 as u32, 10 as u32, 10 as u32) { return 50 }
    if mc_texture.atlas_texel(at, t_stone, 3, 3) != px_of(200 as u32, 10 as u32, 10 as u32) { return 51 }
    if mc_texture.atlas_texel(at, t_stone, 28, 3) != px_of(10 as u32, 10 as u32, 200 as u32) { return 52 }
    // grass: three different textures
    if mc_texture.atlas_texel(at, g_top, 2, 2) != px_of(20 as u32, 200 as u32, 20 as u32) { return 53 }
    if mc_texture.atlas_texel(at, g_side, 2, 2) != px_of(20 as u32, 150 as u32, 30 as u32) { return 54 }
    if mc_texture.atlas_texel(at, g_bot, 2, 2) != px_of(120 as u32, 80 as u32, 40 as u32) { return 55 }
    // stairs reach their material: oak_stairs -> oak_planks.png (planks and stairs use different tiles, same pixels)
    if mc_texture.atlas_texel(at, s_face, 2, 2) != px_of(190 as u32, 150 as u32, 90 as u32) { return 56 }
    if mc_texture.atlas_texel(at, rt.ld16(tb.tiles, st_planks * 6) as u32, 2, 2) != px_of(190 as u32, 150 as u32, 90 as u32) { return 57 }
    // log: bark on the sides, rings on top and bottom
    if mc_texture.atlas_texel(at, l_side, 2, 2) != px_of(100 as u32, 70 as u32, 40 as u32) { return 58 }
    if mc_texture.atlas_texel(at, l_top, 2, 2) != px_of(170 as u32, 140 as u32, 80 as u32) { return 59 }
    // an untouched block keeps its default tile
    let st_sand: usize = state_of(&reg, "sand")
    let t_sand: u32 = rt.ld16(tb.tiles, st_sand * 6) as u32
    if mc_texture.atlas_texel(at, t_sand, 8, 8) != mc_texture.atlas_texel(&a16, mc_texture.T_SAND, 4, 4) { return 60 }

    // ---- 5. animation: water (pack 1, frametime 2, 3 frames), lava (pack 2, frametime 4, interpolate, 2 frames)
    let t_water: u32 = rt.ld16(tb.tiles, st_water * 6) as u32
    let t_lava: u32 = rt.ld16(tb.tiles, st_lava * 6) as u32
    if mc_assets.animset_count(&m.anim) < 2 { return 70 }
    if mc_texture.atlas_texel(at, t_water, 5, 5) != px_of(10 as u32, 100 as u32, 200 as u32) { return 71 } // tick 0 = frame 0
    if mc_packs.res_tick(&m, 1 as i64, &be) <= 0 { return 72 } // lava interpolates (changes every tick); water keeps frame 0
    // lava (interpolate) changes every tick, water (frametime 2) does not at tick 1
    if mc_texture.atlas_texel(at, t_water, 5, 5) != px_of(10 as u32, 100 as u32, 200 as u32) { return 73 }
    if mc_packs.res_tick(&m, 2 as i64, &be) <= 0 { return 74 }
    if mc_texture.atlas_texel(at, t_water, 5, 5) != px_of(60 as u32, 100 as u32, 160 as u32) { return 75 } // frame 1
    mc_packs.res_tick(&m, 4 as i64, &be)
    if mc_texture.atlas_texel(at, t_water, 5, 5) != px_of(110 as u32, 100 as u32, 120 as u32) { return 76 } // frame 2
    mc_packs.res_tick(&m, 6 as i64, &be)
    if mc_texture.atlas_texel(at, t_water, 5, 5) != px_of(10 as u32, 100 as u32, 200 as u32) { return 77 } // cycle: 6 ticks
    // lava: tick 0 -> frame 0, tick 2 -> halfway (r = (10*128 + 60*128) >> 8 = 35), tick 4 -> frame 1 exactly
    mc_packs.res_tick(&m, 0 as i64, &be)
    if mc_texture.atlas_texel(at, t_lava, 5, 5) != px_of(10 as u32, 100 as u32, 200 as u32) { return 78 }
    mc_packs.res_tick(&m, 2 as i64, &be)
    if mc_texture.atlas_texel(at, t_lava, 5, 5) != px_of(35 as u32, 100 as u32, 180 as u32) { return 79 }
    mc_packs.res_tick(&m, 4 as i64, &be)
    if mc_texture.atlas_texel(at, t_lava, 5, 5) != px_of(60 as u32, 100 as u32, 160 as u32) { return 80 }
    if mc_texture.atlas_texel(at, mc_texture.T_LAVA, 5, 5) != mc_texture.atlas_texel(at, t_lava, 5, 5) { return 81 }

    // ---- 6. hot reload: edit the pack on disk, reload; tile ids (meshes) unchanged, picture changed, backend re-uploaded
    let sum0: u64 = tile_checksum(&tb)
    if !build_pack1("" + base + "/p1.zip", 90 as u32) { return 90 }
    if mc_packs.res_reload_upload(&m, &be) != 2 { return 91 }
    if tile_checksum(&tb) != sum0 { return 92 }
    if mc_texture.atlas_texel(&m.atlas, t_stone, 3, 3) != px_of(90 as u32, 10 as u32, 10 as u32) { return 93 }
    if r.apx != m.atlas.px { return 94 }

    // ---- 7. pack_format: declared range, mismatch is a warning only
    if !build_meta_pack("" + base + "/f18.zip", "{\"pack\":{\"pack_format\":18}}", 11 as u32) { return 100 }
    if !build_meta_pack("" + base + "/f_range.zip", "{\"pack\":{\"pack_format\":18,\"supported_formats\":[13,16]}}", 12 as u32) { return 101 }
    if !build_meta_pack("" + base + "/f_min.zip", "{\"pack\":{\"min_format\":[84,0],\"max_format\":[85,0],\"description\":\"x\"}}", 13 as u32) { return 102 }
    var q: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_file(&q, "" + base + "/f18.zip") != mc_assets.ASSET_OK { return 103 }
    if q.format != 18 || mc_assets.pack_format_ok(&q, 15) || !mc_assets.pack_format_ok(&q, 18) { return 104 }
    mc_assets.pack_close(&q)
    if mc_assets.pack_open_file(&q, "" + base + "/f_range.zip") != mc_assets.ASSET_OK { return 105 }
    if q.fmin != 13 || q.fmax != 16 || !mc_assets.pack_format_ok(&q, 15) || mc_assets.pack_format_ok(&q, 17) { return 106 }
    mc_assets.pack_close(&q)
    if mc_assets.pack_open_file(&q, "" + base + "/f_min.zip") != mc_assets.ASSET_OK { return 107 }
    if q.format != 84 || q.fmin != 84 || q.fmax != 85 { return 108 }
    mc_assets.pack_close(&q)
    var m2: mc_packs.ResMgr = mc_packs.res_new()
    mc_packs.res_build_tables(&m2, &reg, &tb)
    mc_packs.res_set_protocol(&m2, 763)
    mc_packs.res_add_path(&m2, "" + base + "/f18.zip")
    mc_packs.res_add_path(&m2, "" + base + "/f_range.zip")
    mc_packs.res_add_path(&m2, "" + base + "/missing.zip")
    mc_packs.res_add_path(&m2, "" + base + "/f_min.zip")
    if mc_packs.res_reload(&m2) != 3 { return 109 } // the missing one is skipped
    if mc_packs.res_warn_count(&m2) != 3 { return 110 } // f18 mismatch, missing, f_min mismatch (84..85 vs 15)
    if mc_packs.res_warn_text(&m2).length() < 20 { return 111 }
    // top pack wins even with the "wrong" format
    if mc_texture.atlas_texel(&m2.atlas, mc_texture.T_STONE, 3, 3) != px_of(11 as u32, 10 as u32, 10 as u32) { return 112 }
    mc_packs.res_free(&m2)

    // ---- 8. config text + auto discovery (lowest priority, name order, only .zip)
    fs.mkdir_all("" + base + "/mc/resourcepacks") catch | e | (false)
    if !build_meta_pack("" + base + "/mc/resourcepacks/b_pack.zip", META15, 31 as u32) { return 120 }
    if !build_meta_pack("" + base + "/mc/resourcepacks/a_pack.zip", META15, 32 as u32) { return 121 }
    if !build_meta_pack("" + base + "/mc/resourcepacks/note.txt", META15, 33 as u32) { return 122 }
    var m3: mc_packs.ResMgr = mc_packs.res_new()
    mc_packs.res_build_tables(&m3, &reg, &tb)
    let cfg: str = "# test\ntile=64\ntile_max=32\nauto=1\nsounds=both\npack=cfg_rel.zip\n  /abs/other.zip  \nbogus line\n"
    if mc_packs.res_load_config_text(&m3, cfg, "/base/dir/") < 5 { return 123 }
    if m3.tile_cfg != 64 || m3.tile_max != 32 || !m3.auto_on || mc_packs.res_sounds_mode(&m3) != mc_packs.SOUNDS_BOTH { return 124 }
    if mc_packs.res_path_count(&m3) != 3 { return 125 } // cfg_rel, other, "bogus line" (a bare path is accepted; it just fails to open)
    var m4: mc_packs.ResMgr = mc_packs.res_new()
    mc_packs.res_build_tables(&m4, &reg, &tb)
    if mc_packs.res_autodiscover(&m4, "" + base + "/mc") != 2 { return 126 }
    if mc_packs.res_reload(&m4) != 2 { return 127 }
    if mc_texture.atlas_texel(&m4.atlas, mc_texture.T_STONE, 3, 3) != px_of(32 as u32, 10 as u32, 10 as u32) { return 128 } // a_pack first
    if mc_packs.res_tile_size(&m4) != 16 { return 129 }
    // explicit pack list is above the auto-found ones
    mc_packs.res_free(&m3)
    mc_packs.res_free(&m4)
    var m5: mc_packs.ResMgr = mc_packs.res_new()
    mc_packs.res_build_tables(&m5, &reg, &tb)
    if mc_packs.res_add_list(&m5, "" + base + "/f18.zip," + base + "/p2.zip") != 2 { return 130 }
    mc_packs.res_autodiscover(&m5, "" + base + "/mc")
    if mc_packs.res_path_count(&m5) != 4 { return 131 }
    if mc_packs.res_reload(&m5) != 4 { return 132 }
    if mc_texture.atlas_texel(&m5.atlas, mc_texture.T_STONE, 3, 3) != px_of(11 as u32, 10 as u32, 10 as u32) { return 133 }
    mc_packs.res_free(&m5)

    mc_packs.res_free(&m)
    mc_texture.atlas_free(&a16)
    mc_texture.atlas_free(&a32)
    mc_texture.tex_free_tables(&tb)
    return 0
}

fn main() -> i32 {
    // a private directory per run (random name): parallel runs and the four
    // build levels never share files (r479)
    var td: fsx.TempDir = fsx.temp_dir("mcr1_2813_") catch | e | fsx.TempDir { path: rt.buf_new(), armed: false }
    defer fsx.temp_dir_drop(&td)
    if !td.armed { return 1 }
    let rc: i32 = body(fsx.temp_dir_path(&td))
    return rc
}
