// expect_exit: 0
// tests/911_css_parser.fi -- the CSS parser (css-syntax-3 section 5).
//
// The quota against the official suite stands in tools/css/run.sh. Checked
// here are the four decisions the cascade rests on:
//
//   1. a list of component values: blocks are nested, not flattened
//   2. error tolerance: a stray `}` becomes an error node, and the parser
//      carries on
//   3. `!important`: the value is TRUNCATED at the `!`, nothing is
//      trimmed afterwards
//   4. "parse a block's contents": `a:hover {c:1}` is a QUALIFIED RULE and
//      not a declaration with the value `hover {c:1}`
//
// The return value names the first case that deviates (1..4).
import html.mem
import browser.node
import css.tok
import css.cv

fn feed(src: *mut mem.CpBuf, p: u64, n: usize) {
    mem.cp_clear(src)
    var i: usize = 0
    while i < n {
        mem.cp_push(src, (*((p + i as u64) as *mut u8)) as u32)
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var src: mem.CpBuf = mem.cp_new()

    // 1. nesting
    var s1: [u8; 11] = "a{b:c} d(e)"
    feed(&src, (&s1[0]) as u64, 11)
    tok.tokenize(&t, &src)
    var p1: cv.Parser = cv.parser_new(&t)
    let list1 = cv.parse_component_value_list(&p1) catch gc_null[Cv]()
    if cv.cv_kids_count(list1) != 4 {
        return 1
    }
    if cv.cv_kid(list1, 1).kind != cv.CV_CURLY {
        return 1
    }
    if cv.cv_kids_count(cv.cv_kid(list1, 1)) != 3 {
        return 1
    }
    if cv.cv_kid(list1, 3).kind != cv.CV_FUNCTION {
        return 1
    }

    // 2. a stray closing brace
    var s2: [u8; 3] = "a}b"
    feed(&src, (&s2[0]) as u64, 3)
    tok.tokenize(&t, &src)
    var p2: cv.Parser = cv.parser_new(&t)
    let list2 = cv.parse_component_value_list(&p2) catch gc_null[Cv]()
    if cv.cv_kids_count(list2) != 3 {
        return 2
    }
    if cv.cv_kid(list2, 1).kind != cv.CV_ERROR {
        return 2
    }
    if cv.cv_kid(list2, 1).r0 != cv.E_CLOSE_CURLY {
        return 2
    }
    if cv.cv_kid(list2, 2).kind != tok.T_IDENT {
        return 2
    }

    // 3. !important truncates at the `!`
    var s3: [u8; 21] = "foo: 9000  !Important"
    feed(&src, (&s3[0]) as u64, 21)
    tok.tokenize(&t, &src)
    var p3: cv.Parser = cv.parser_new(&t)
    let d3 = cv.parse_one_declaration(&p3) catch gc_null[Cv]()
    if d3.kind != cv.CV_DECLARATION {
        return 3
    }
    if (d3.flags & cv.F_IMPORTANT) == 0 as u32 {
        return 3
    }
    // The value keeps the whitespace in FRONT of the `!`: " ", 9000, " "
    if cv.cv_kids_count(d3) != 3 {
        return 3
    }
    if cv.cv_kid(d3, 2).kind != tok.T_WHITESPACE {
        return 3
    }

    // 4. a block's contents: hover is a rule, not a declaration
    var s4: [u8; 18] = "z:x; a:hover {c:1}"
    feed(&src, (&s4[0]) as u64, 18)
    tok.tokenize(&t, &src)
    var p4: cv.Parser = cv.parser_new(&t)
    let list4 = cv.parse_block_contents(&p4) catch gc_null[Cv]()
    if cv.cv_kids_count(list4) != 2 {
        return 4
    }
    if cv.cv_kid(list4, 0).kind != cv.CV_DECLARATION {
        return 4
    }
    if cv.cv_kid(list4, 1).kind != cv.CV_QUALIFIED_RULE {
        return 4
    }
    tok.tokens_free(&t)
    mem.cp_free(&src)
    return 0
}
