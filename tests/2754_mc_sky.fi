// expect_exit: 0
// tests/2754_mc_sky.fi -- mc_sky: time of day, colours, discs, wrap, tint, fog hand-over. The byte exact comparison
// with the python implementation is tools/mc/sky/run.sh.
import std.rt
import mc.mc_camera
import mc.mc_raster
import mc.mc_sky

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    var s: mc_sky.Sky = mc_sky.sky_new()
    // noon: sun high in the south, full day, no glow
    mc_sky.sky_set_time(&s, 6000 as i64, 0)
    check(s.daylight == 256 && s.glow == 0 && s.suny > 0.89 && s.suny < 0.91, 1)
    check(s.sunx > -0.01 && s.sunx < 0.01 && s.sunz > 0.43, 2)
    // midnight: dark, the sun is below the horizon
    mc_sky.sky_set_time(&s, 18000 as i64, 0)
    check(s.daylight == 0 && s.suny < -0.89 && s.zb < 20 && s.tr < 100, 3)
    // sunrise (0) and sunset (12000): sun on the horizon, strong glow, sun to the east / west
    mc_sky.sky_set_time(&s, 0 as i64, 0)
    check(s.glow == 256 && s.sunx > 0.99, 4)
    mc_sky.sky_set_time(&s, 12000 as i64, 0)
    check(s.glow == 256 && s.sunx < -0.99, 5)
    // ticks wrap, negative too
    mc_sky.sky_set_time(&s, 6000 as i64 + 24000 as i64 * 5 as i64, 0)
    let a: f64 = s.suny
    mc_sky.sky_set_time(&s, 6000 as i64 - 24000 as i64, 0)
    check(s.suny == a && s.time == 6000 as i64, 6)
    // the sine approximation: exact at 0 / 90 / 180 / 270, cosine shifted
    check(mc_sky.sky_sin_deg(90.0) == 1.0 && mc_sky.sky_sin_deg(0.0) == 0.0 && mc_sky.sky_sin_deg(270.0) == -1.0, 7)
    check(mc_sky.sky_cos_deg(0.0) == 1.0 && mc_sky.sky_cos_deg(180.0) == -1.0, 8)
    // rain: darker and greyer, heavy rain hides the discs
    mc_sky.sky_set_time(&s, 6000 as i64, 0)
    let clear_zb: i32 = s.zb
    mc_sky.sky_set_time(&s, 6000 as i64, 256)
    check(s.zb < clear_zb && !s.discs && s.rain == 256, 9)
    mc_sky.sky_set_time(&s, 6000 as i64, 0 - 5)
    check(s.rain == 0 && s.discs, 10)
    // image: looking at the zenith at noon = zenith colour (no sun in the way), at the horizon = horizon colour
    var cam: mc_camera.Camera = mc_camera.camera_new(32, 32)
    var r: mc_raster.Raster = mc_raster.raster_new(32, 32)
    mc_camera.camera_set_angles(&cam, 0.0, 0.0)
    mc_camera.camera_update(&cam)
    mc_raster.raster_set_camera(&r, &cam)
    mc_sky.sky_set_time(&s, 6000 as i64, 0)
    mc_sky.sky_draw(&s, &r)
    let mid: u32 = mc_raster.raster_pixel(&r, 16, 16)
    check((mid >> 24 as u32) == 255 as u32, 11)
    let top: u32 = mc_raster.raster_pixel(&r, 16, 0)
    check((top & 255 as u32) <= (mid & 255 as u32), 12) // higher = nearer to the zenith (less red)
    check((top & 255 as u32) <= 190 as u32 && (mid & 255 as u32) >= 82 as u32, 13)
    // looking straight at the sun: pixel is the sun colour
    mc_camera.camera_set_angles(&cam, 0.0, -64.16)
    mc_camera.camera_update(&cam)
    mc_raster.raster_set_camera(&r, &cam)
    mc_sky.sky_draw(&s, &r)
    check(mc_raster.raster_pixel(&r, 16, 16) == 0xFFC8F8FF as u32, 14)
    // tint: only pixels with a depth entry change
    mc_sky.sky_set_time(&s, 18000 as i64, 0)
    mc_raster.raster_clear(&r, 0xFFFFFFFF as u32)
    *((r.depth + (5 * 8) as u64) as *mut f64) = 2.0
    mc_sky.sky_tint_frame(&s, &r)
    check(mc_raster.raster_pixel(&r, 5, 0) != 0xFFFFFFFF as u32 && mc_raster.raster_pixel(&r, 6, 0) == 0xFFFFFFFF as u32, 15)
    check((mc_raster.raster_pixel(&r, 5, 0) & 255 as u32) == (255 * s.tr as u32) / 256 as u32, 16)
    // fog hand-over
    mc_sky.sky_set_raster_fog(&s, &r, 10.0, 90.0)
    check(r.fog_on && r.fog_r == s.fr as u32 && r.fog_b == s.fb as u32 && r.fog_end == 90.0, 17)
    mc_raster.raster_free(&r)
    return 0
}
