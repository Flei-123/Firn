import std.fs
import std.rt
import jxl.jxl_img
import jxl.jxl_modular

static mut failures: i32 = 0
static mut first_bad: i32 = 0 - 1
static mut index: i32 = 0

fn hash_image(im: *mut jxl_img.JxlImage) -> u64 {
    var s: u64 = 0
    var c: usize = 0
    while c < jxl_img.img_count(im) {
        var i: usize = 0
        let w: usize = jxl_img.img_w(im, c)
        while i < w * jxl_img.img_h(im, c) {
            s = (s * 31 + (jxl_img.img_get(im, c, i % w, i / w) as u64)) % 1000000007
            i = i + 1
        }
        c = c + 1
    }
    return s
}

fn expect(path: str, channels: usize, want: u64) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    var im: jxl_img.JxlImage = jxl_img.img_new()
    let r: i32 = jxl_modular.modular_decode(rt.buf_ptr(&data), n, &im)
    if r != 0 || jxl_img.img_count(&im) != channels || hash_image(&im) != want {
        failures = failures + 1
        if first_bad < 0 {
            first_bad = index
        }
    }
    index = index + 1
    jxl_img.img_free(&im)
    rt.buf_free(&data)
}

fn main() -> i32 {
    expect("tests/data/jxl/mg/mg_rgb300x260_g0.jxl", 3, 524369114)
    expect("tests/data/jxl/mg/mg_rgb520x300_g1.jxl", 3, 256421987)
    expect("tests/data/jxl/mg/mg_rgb300x200_wp.jxl", 3, 672560116)
    expect("tests/data/jxl/mg/mg_rgba300x200_g0.jxl", 4, 262026776)
    expect("tests/data/jxl/mg/mg_grey260x130_g0.jxl", 1, 667978955)
    expect("tests/data/jxl/mg/mg_greya200x140_g0.jxl", 2, 215629677)
    expect("tests/data/jxl/mg/mg_rgb300x260_order.jxl", 3, 234642835)
    expect("tests/data/jxl/mg/sq_rgb100x90.jxl", 3, 193756757)
    expect("tests/data/jxl/mg/sq_rgb37x23.jxl", 3, 902781087)
    expect("tests/data/jxl/mg/sq_rgb300x200_g0.jxl", 3, 265805763)
    expect("tests/data/jxl/mg/sq_rgba150x130_g0.jxl", 4, 397662075)
    expect("tests/data/jxl/mg/sq_grey129x65.jxl", 1, 390284994)
    expect("tests/data/jxl/mg/sq_rgb513x7.jxl", 3, 910829676)
    expect("tests/data/jxl/mg/sq_rgb7x300.jxl", 3, 486957308)
    expect("tests/data/jxl/mg/sq_rgb200x150_wp.jxl", 3, 807810755)
    expect("tests/data/jxl/mg/pred_rgb120x100_p0.jxl", 3, 554754942)
    expect("tests/data/jxl/mg/pred_rgb120x100_p4.jxl", 3, 299034821)
    expect("tests/data/jxl/mg/pred_rgb120x100_p13.jxl", 3, 665658883)
    expect("tests/data/jxl/mg/pred_rgb120x100_p15.jxl", 3, 769243692)
    expect("tests/data/jxl/mg/prog_rgb300x200.jxl", 3, 429936204)
    return failures
}
