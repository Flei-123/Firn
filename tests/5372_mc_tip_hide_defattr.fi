// expect_exit: 0
import std.rt
import mc.mc_tip_lines
import mc.mc_item_tip
import mc.mc_item_hide

fn has_line(t: *mut mc_tip_lines.TipLines, want: str) -> bool {
    var i: usize = 0
    while i < mc_tip_lines.tl_count(t) {
        if mc_tip_lines.tl_len(t, i) == want.n && rt.mem_eq(mc_tip_lines.tl_text(t) + (mc_tip_lines.tl_off(t, i) as u64), want.p as u64, want.n) { return true }
        i = i + 1
    }
    return false
}

fn build(t: *mut mc_tip_lines.TipLines, rec: str, item: str, protocol: i32) {
    mc_tip_lines.tl_clear(t)
    mc_item_tip.tip_build(t, rec.p as u64, rec.n, item.p as u64, item.n, protocol, 0, 0)
}

fn main() -> i32 {
    var t: mc_tip_lines.TipLines = mc_tip_lines.tl_new()
    build(&t, "", "diamond_sword", 763)
    if !has_line(&t, "When in Main Hand:") || !has_line(&t, " 7 Attack Damage") || !has_line(&t, " 1.6 Attack Speed") { return 1 }
    build(&t, "", "netherite_chestplate", 769)
    if !has_line(&t, "When on Body:") { return 21 }
    if !has_line(&t, "+8 Armor") { return 22 }
    if !has_line(&t, "+3 Armor Toughness") { return 23 }
    if !has_line(&t, "+1 Knockback Resistance") { return 24 }
    build(&t, "", "golden_apple", 763)
    if mc_tip_lines.tl_count(&t) != 1 { return 3 }
    build(&t, "k16\n", "diamond_sword", 769)
    if mc_tip_lines.tl_count(&t) != 0 { return 4 }
    build(&t, "k8\n", "diamond_sword", 769)
    if mc_tip_lines.tl_count(&t) != 1 { return 5 }
    build(&t, "k1\neminecraft:sharpness\t5\n", "diamond_sword", 763)
    if has_line(&t, "Sharpness V") || !has_line(&t, " 7 Attack Damage") { return 6 }
    build(&t, "eminecraft:sharpness\t5\n", "diamond_sword", 763)
    if !has_line(&t, "Sharpness V") { return 7 }
    var m: i64 = 0
    if !mc_item_hide.ih_line(769, 16, "type".p as u64, 4, "16".p as u64, 2, &m) || m != mc_item_hide.HIDE_ALL { return 8 }
    if !mc_item_hide.ih_line(767, 9, "data.showInTooltip".p as u64, 18, "false".p as u64, 5, &m) || m != mc_item_hide.HIDE_ENCH { return 9 }
    if mc_item_hide.ih_line(767, 9, "data.showInTooltip".p as u64, 18, "true".p as u64, 4, &m) { return 10 }
    if !mc_item_hide.ih_line(772, 15, "data.hideTooltip".p as u64, 16, "true".p as u64, 4, &m) || m != mc_item_hide.HIDE_ALL { return 11 }
    if !mc_item_hide.ih_line(772, 15, "data.hiddenComponents[0]".p as u64, 24, "13".p as u64, 2, &m) || m != mc_item_hide.HIDE_ATTR { return 12 }
    if !mc_item_hide.ih_line(775, 18, "data.hiddenComponents[1]".p as u64, 24, "13".p as u64, 2, &m) || m != mc_item_hide.HIDE_ENCH { return 13 }
    if mc_item_hide.ih_line(775, 99, "data.hiddenComponents[1]".p as u64, 24, "13".p as u64, 2, &m) { return 14 }
    return 0
}
