// expect_exit: 21
// Regression: r8/r9 are argument registers 5/6 AND scratch registers of the
// allocator at the same time. If the prologue is emitted naively in order,
// parameter 1 overwrites argument 5 before it has been read. Without inlining
// this file used to yield 13 instead of 21 (regalloc.rs, parallel_reg_moves).
//
// Substitute for #[inline(never)]: the function is big enough that the size
// heuristic does not inline it -- and the test additionally runs with
// --opt-level=dev-fast anyway, that is entirely without inlining.
fn six(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    while i < 1 {
        s = a + b
        s = s + c
        s = s + d
        s = s + e
        s = s + f
        i = i + 1
    }
    return s
}

// Calls with six NON-constant arguments: the call site has to move them in
// parallel as well, otherwise argument 5 destroys the source of argument 6.
fn passthrough(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) -> i32 {
    return six(f, e, d, c, b, a)
}

fn main() -> i32 {
    let x = six(1, 2, 3, 4, 5, 6)
    let y = passthrough(1, 2, 3, 4, 5, 6)
    if x != 21 { return 91 }
    if y != 21 { return 92 }
    return x
}
