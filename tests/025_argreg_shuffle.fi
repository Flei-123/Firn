// expect_exit: 21
// Regression: r8/r9 sind zugleich Argumentregister 5/6 UND Arbeitsregister der
// Zuteilung. Wird der Prolog naiv der Reihe nach umgesetzt, ueberschreibt
// Parameter 1 das noch ungelesene Argument 5. Ohne Einbettung lieferte diese
// Datei frueher 13 statt 21 (regalloc.rs, parallele_reg_bewegungen).
//
// #[inline(never)]-Ersatz: die Funktion ist gross genug, dass die
// Groessenheuristik sie nicht einbettet — und der Test laeuft ohnehin
// zusaetzlich mit --opt-level=dev-fast, also ganz ohne Einbettung.
fn six(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    while i < 1 {
        s = a + b
        s = s + c
        s = s + d
        s = s + e
        s = s + f
        i = i + 1
    }
    return s
}

// Ruft mit sechs NICHT-konstanten Argumenten auf: auch die Aufrufstelle muss
// parallel umsetzen, sonst zerstoert Argument 5 die Quelle von Argument 6.
fn passthrough(a: i32, b: i32, c: i32, d: i32, e: i32, f: i32) -> i32 {
    return six(f, e, d, c, b, a)
}

fn main() -> i32 {
    let x = six(1, 2, 3, 4, 5, 6)
    let y = passthrough(1, 2, 3, 4, 5, 6)
    if x != 21 { return 91 }
    if y != 21 { return 92 }
    return x
}
