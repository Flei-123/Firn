// expect_exit: 0
// tests/3396_appkit_channels.fi -- appkit.catalog.catalog_channels: which channels the store offers one program on one
// platform (the Jarvis app shows a channel switch only when this lists more than one name).
import std.rt
import std.json
import std.str
import appkit.catalog

const CATALOG: str = __include_str("data/appkit/catalog-kinds.json")

fn chans(d: *mut json.Json, pkg: str, plat: str, art: str, want: str, want_n: u32) -> bool {
    var b: rt.Buf = rt.buf_new()
    let n: u32 = catalog.catalog_channels(d, pkg, plat, art, &b)
    let got: str = str { p: rt.buf_ptr(&b) as *mut u8, n: rt.buf_len(&b) }
    let ok: bool = n == want_n && got == want
    rt.buf_free(&b)
    return ok
}

fn main() -> i32 {
    var d: json.Json = json.json_new()
    let okp: bool = json.json_parse(&d, CATALOG.p as u64, CATALOG.n) catch false
    if !okp { return 1 }
    // bin:app: stabil (+ the per-platform pointer stabil@linux-aarch64, listed once) and beta (a linux-x86_64 build only)
    if !chans(&d, "bin:app", "linux-x86_64", "bin", "stabil beta", 2) { return 2 }
    if !chans(&d, "bin:app", "linux-aarch64", "bin", "stabil", 1) { return 3 }
    if !chans(&d, "exe:app", "windows-x86_64", "exe", "stabil", 1) { return 4 }
    // wrong kind, unknown package, wrong platform: nothing
    if !chans(&d, "bin:app", "linux-x86_64", "exe", "", 0) { return 5 }
    if !chans(&d, "bin:nope", "linux-x86_64", "bin", "", 0) { return 6 }
    if !chans(&d, "bin:app", "windows-x86_64", "bin", "", 0) { return 7 }
    json.json_free(&d)
    // broken input must not crash
    var e: json.Json = json.json_new()
    let okb: bool = json.json_parse(&e, "{\"pakete\":{\"x\":{\"art\":\"bin\",\"kanaele\":[1,2]}}}".p as u64, 47) catch false
    if okb {
        if !chans(&e, "x", "linux-x86_64", "bin", "", 0) { return 8 }
    }
    json.json_free(&e)
    var f: json.Json = json.json_new()
    let okf: bool = json.json_parse(&f, "[]".p as u64, 2) catch false
    if okf {
        if !chans(&f, "x", "linux-x86_64", "bin", "", 0) { return 9 }
    }
    json.json_free(&f)
    return 0
}
