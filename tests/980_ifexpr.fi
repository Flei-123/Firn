// expect_exit: 42
// ROUND IFEXPR: `if c { a } else { b }` in expression position.
// SPEC T1 had put this off while stage 0 had no merge of values. Since
// round 92 it has one; the lowering does not even need it and writes into
// an alloca place out of which mem2reg makes the phi.

fn max2(a: i32, b: i32) -> i32 {
    return if a > b { a } else { b }
}

fn sign(n: i32) -> i32 {
    let s: i32 = if n < 0 { -1 } else if n > 0 { 1 } else { 0 }
    return s
}

fn main() -> i32 {
    let m: i32 = max2(7, 3)
    let k: i32 = max2(3, 7)
    let a: i32 = sign(-5)
    let b: i32 = sign(5)
    let c: i32 = sign(0)

    // inside a larger expression and nested
    let d: i32 = 10 * (if m == 7 { 4 } else { 9 }) + (if a == -1 { 2 } else { 0 })

    // in a loop, with a mutable variable
    var total: i32 = 0
    var i: i32 = 0
    while i < 5 {
        total = total + if i % 2 == 0 { i } else { 0 }
        i = i + 1
    }

    // floating point: the untyped literal adapts to the context
    let f: f64 = if m >= k { 1.5 } else { 2.5 }

    // as the argument of a call
    let g: i32 = max2(if a < 0 { 3 } else { 99 }, 2)

    var ok: i32 = 0
    if m == 7 && k == 7 && a == -1 && b == 1 && c == 0 && d == 42
    && total == 6 && f == 1.5 && g == 3 {
        ok = 42
    }
    return ok
}
