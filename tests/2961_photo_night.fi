// expect_exit: 0
// tests/2961_photo_night.fi -- FirnCam night mode: 12 very dark frames (scene * 0.05, SNR ~1-2 per pixel) with
// hand shake, grain keep 0.4 (the same for the baseline). Checks: night_process beats the lifted single frame by > 2 dB PSNR (vs the lifted noise free
// scene), the lift brings the mean near the target, output size is right. Deterministic.
import std.io
import std.rt
import photo.image
import photo.meta
import photo.merge
import photo.synth
import photo.night

fn main() -> i32 {
    let w: i32 = 96
    let h: i32 = 72
    var ok: bool = true
    var scene: image.Image = image.scene_make(w, h)
    image.img_clamp01(&scene)
    var i: i32 = 0
    while i < w * h * 3 {
        let p: *mut f32 = (scene.px + (i as u64) * (4 as u64)) as *mut f32
        *p = *p * 0.05f
        i = i + 1
    }
    var rng: image.Rng = image.rng_new(11 as u64)
    var m: meta.SensorMeta = meta.meta_default()
    var k: usize = 0
    while k < 4 {
        meta.meta_set_noise(&m, k, 2.0e-3f, 2.0e-5f)
        k = k + 1
    }
    var b: merge.Burst = merge.burst_new()
    synth.synth_burst_lo(&scene, 12, 1.0f, 2.0e-3f, 2.0e-5f, 2.0f, -1.0f, &rng, &b)
    var o: night.NightOpts = night.night_default()
    o.pipe.keep = 0.4f // natural grain: 40 % of the removed residual stays; the merged frame leaves far less noise in it
    o.ref_idx = 0 // frame 0 has shift 0: the same geometry as the noise free scene
    var ideal: image.Image = image.img_new(1, 1, 3)
    var o1: image.Image = image.img_new(1, 1, 3)
    var on: image.Image = image.img_new(1, 1, 3)
    image.img_free(&ideal)
    image.img_free(&o1)
    image.img_free(&on)
    var oi: night.NightOpts = o // the reference picture: same lift + tone, (almost) no denoise
    oi.denoise = 0.01f
    night.night_single(&scene, &m, &oi, &ideal)
    night.night_single(&b.frames[0], &m, &o, &o1)
    night.night_process(&b, &m, &o, &on)
    let p1: f32 = image.psnr(&o1, &ideal, 1.0f)
    let pn: f32 = image.psnr(&on, &ideal, 1.0f)
    io.print("single dB: ")
    io.fmt_print_line(io.fmt_f32(io.fmt_new(), p1))
    io.print("night dB: ")
    io.fmt_print_line(io.fmt_f32(io.fmt_new(), pn))
    ok = pn > p1 + 2.0f && ok
    ok = on.w == w && on.h == h && ok
    if ok {
        io.print("ok")
        io.new_line()
        return 0
    }
    return 1
}
