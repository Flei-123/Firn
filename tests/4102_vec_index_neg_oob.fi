// expect_exit: 101
// not_mode: opt
// tests/4102_vec_index_neg_oob.fi -- r724: a negative index below -len panics.
import std.io
import std.rt
import std.vec

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 1)
    vec_push[i32](&v, 2)
    let i: i32 = -3
    return v[i]
}
