// expect_out: vec: len 10 first 9 last 1 find 4 cap true u64 9223372036854775808 big 200 min 7
// tests/802_std_vec_core.fi -- the field helpers of `std.vec` (round 42).
//
// `Vec[T]` could grow, read, write and pop so far. Now the moves come on top
// that one needs in every second program: search, insert, remove
// (with and without order), copy, compare, reverse, sort and binary
// search.
//
// Everything is generic -- which is why TWO types are used here (i32 and
// u64): a template that only compiles for one instance would not show up
// otherwise. With u64 the sorting run shows on top of that that the UNSIGNED
// order is taken: 2^63 belongs at the end, not at the beginning.
import std.io
import std.vec

fn main() -> i32 {
    // --- i32: build up, search, sort
    var v: Vec[i32] = vec_new[i32]()
    if !vec_is_empty[i32](&v) {
        return 10
    }
    var i: i32 = 0
    while i < 10 {
        vec_push[i32](&v, (i * 7) % 10)
        i = i + 1
    }
    if vec_len[i32](&v) != 10 {
        return 11
    }
    if !vec_contains[i32](&v, 3) || vec_contains[i32](&v, 99) {
        return 12
    }
    if vec_index_of[i32](&v, 7) != 1 {
        return 13
    }
    if vec_index_of[i32](&v, 99) != vec_len[i32](&v) {
        return 14
    }
    if vec_count[i32](&v, 0) != 1 {
        return 15
    }
    if vec_is_sorted[i32](&v) {
        return 16
    }
    vec_sort[i32](&v)
    if !vec_is_sorted[i32](&v) {
        return 17
    }
    if vec_at[i32](&v, 0) != 0 || vec_at[i32](&v, 9) != 9 {
        return 18
    }
    if vec_min[i32](&v) != 0 || vec_max[i32](&v) != 9 {
        return 19
    }

    // --- binary search and sorted insert
    if vec_binary_search[i32](&v, 5) != 5 {
        return 20
    }
    if vec_binary_search[i32](&v, 42) != vec_len[i32](&v) {
        return 21
    }
    if vec_lower_bound[i32](&v, 0 - 1) != 0 {
        return 22
    }
    if vec_lower_bound[i32](&v, 100) != 10 {
        return 23
    }
    if !vec_sorted_insert[i32](&v, 4) {
        return 24
    }
    if vec_len[i32](&v) != 11 || !vec_is_sorted[i32](&v) {
        return 25
    }
    if vec_count[i32](&v, 4) != 2 {
        return 26
    }

    // --- insert, remove, swap, reverse
    if !vec_insert[i32](&v, 0, 42) {
        return 30
    }
    if vec_at[i32](&v, 0) != 42 || vec_at[i32](&v, 1) != 0 {
        return 31
    }
    if vec_remove[i32](&v, 0) != 42 {
        return 32
    }
    if vec_at[i32](&v, 0) != 0 || vec_len[i32](&v) != 11 {
        return 33
    }
    let last: i32 = vec_last[i32](&v)
    if vec_remove_fast[i32](&v, 0) != 0 {
        return 34
    }
    if vec_at[i32](&v, 0) != last || vec_len[i32](&v) != 10 {
        return 35
    }
    if !vec_swap[i32](&v, 0, 9) {
        return 36
    }
    if vec_swap[i32](&v, 0, 99) {
        return 37
    }
    vec_sort[i32](&v)
    vec_invert[i32](&v)
    if vec_at[i32](&v, 0) != 9 || vec_at[i32](&v, 9) != 1 {
        return 38
    }

    // --- copy, append, compare, shorten, fill
    var w: Vec[i32] = vec_new[i32]()
    if !vec_copy[i32](&v, &w) {
        return 40
    }
    if !vec_equal[i32](&v, &w) {
        return 41
    }
    if !vec_append[i32](&w, &v) {
        return 42
    }
    if vec_len[i32](&w) != 20 || vec_equal[i32](&v, &w) {
        return 43
    }
    vec_shorten[i32](&w, 3)
    if vec_len[i32](&w) != 3 {
        return 44
    }
    vec_fill[i32](&w, 5)
    if vec_count[i32](&w, 5) != 3 {
        return 45
    }
    var empty: Vec[i32] = vec_new[i32]()
    if !vec_copy[i32](&empty, &w) {
        return 46
    }
    if !vec_is_empty[i32](&w) {
        return 47
    }

    // --- u64: the unsigned order
    var u: Vec[u64] = vec_new[u64]()
    vec_push[u64](&u, 9223372036854775808)
    vec_push[u64](&u, 1)
    vec_push[u64](&u, 18446744073709551615)
    vec_push[u64](&u, 0)
    vec_sort[u64](&u)
    if vec_at[u64](&u, 0) != 0 || vec_at[u64](&u, 1) != 1 {
        return 50
    }
    if vec_at[u64](&u, 3) != 18446744073709551615 {
        return 51
    }
    if vec_max[u64](&u) != 18446744073709551615 {
        return 52
    }
    if vec_binary_search[u64](&u, 9223372036854775808) != 2 {
        return 53
    }

    // --- sorting stays O(n log n) safe even with many equal values
    var big: Vec[i32] = vec_new[i32]()
    var k: i32 = 0
    while k < 200 {
        vec_push[i32](&big, 200 - k)
        k = k + 1
    }
    vec_sort[i32](&big)
    if !vec_is_sorted[i32](&big) {
        return 60
    }
    if vec_at[i32](&big, 0) != 1 || vec_at[i32](&big, 199) != 200 {
        return 61
    }
    vec_fill[i32](&big, 7)
    vec_sort[i32](&big)
    if !vec_is_sorted[i32](&big) || vec_min[i32](&big) != 7 {
        return 62
    }

    // The value 2^63 shows the limit of the interpolation as well: `f"{x}"`
    // ALWAYS shows i64. Whoever wants to see u64 correctly takes `io.fmt_u64` --
    // that is exactly what the stage has existed for since round 42.
    var line: io.Fmt = f"vec: len {vec_len[i32](&v)} first {vec_at[i32](&v, 0)} last {vec_last[i32](&v)} find {vec_index_of[i32](&v, 5)} cap {vec_cap[i32](&v) >= 11} u64 "
    line = io.fmt_u64(line, vec_at[u64](&u, 2))
    io.fmt_print(io.fmt_append(line,
            f" big {vec_len[i32](&big)} min {vec_min[i32](&big)}\n"))

    vec_free[i32](&v)
    vec_free[i32](&w)
    vec_free[i32](&empty)
    vec_free[i32](&big)
    vec_free[u64](&u)
    return 0
}
