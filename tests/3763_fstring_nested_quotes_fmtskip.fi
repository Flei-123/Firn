// expect_out: [name] [{}] 7
// r664: a text literal may stand inside `{ ... }` of an f-string, braces in it
// included. The file name ends in _fmtskip: firnfmt's own lexer does not know
// this yet (tools/fmt/run.sh skips such files).
import std.io

fn pick(a: str, b: str, which: i32) -> str {
    if which == 0 { return a }
    return b
}

fn main() -> i32 {
    let n: i32 = 7
    io.print_line(io.fmt_string(f"[{pick("name", "{}", 0)}] [{pick("name", "{}", 1)}] {n}"))
    return 0
}
