// expect_exit: 0
// tests/4341_dict_literal.fi -- wf-py: dict literal and dict comprehension for `Dict[V]` (std.dict),
// list literal of text, return forms.
import std.io
import std.rt
import std.vec
import std.dict

fn base() -> Dict[i64] {
    return { "one": 1, "two": 2, "three": 3, }
}

fn none() -> Dict[i64] {
    return {}
}

fn names() -> Vec[str] {
    return ["ann", "bob", "cy"]
}

#[no_inline]
fn run() -> i32 {
    var d: Dict[i64] = { "a": 10, "b": 20, "c": 30 }
    if dict_len[i64](&d) != 3 { return 2 }
    if dict_get_or[i64](&d, "b", 0) != 20 { return 3 }
    if dict_has[i64](&d, "z") { return 4 }
    let e: Dict[i64] = {}
    if dict_len[i64](&e) != 0 { return 5 }
    var b: Dict[i64] = base()
    if dict_len[i64](&b) != 3 || dict_get_or[i64](&b, "three", 0) != 3 { return 6 }
    var n: Dict[i64] = none()
    if dict_len[i64](&n) != 0 { return 7 }
    // dict comprehension over a Vec of text
    var ns: Vec[str] = names()
    let lens: Dict[i64] = { s: (s.length() as i64) for s in ns }
    if dict_len[i64](&lens) != 3 || dict_get_or[i64](&lens, "ann", 0) != 3 { return 8 }
    // dict comprehension over a range with a filter
    let pos: Dict[i64] = { s: (i as i64) for (i, s) in enumerate(ns) if i != 1 }
    if dict_len[i64](&pos) != 2 || dict_get_or[i64](&pos, "cy", 0) != 2 || dict_has[i64](&pos, "bob") { return 9 }
    if vec_len[str](&ns) != 3 { return 10 }
    return 0
}

fn main() -> i32 {
    return run()
}
