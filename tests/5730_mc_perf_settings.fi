// expect_exit: 0
import std.rt
import mc.mc_opts
import mc.mc_frame_limit
import mc.mc_workers
import mc.mc_net_budget
import std.cpus

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn main() -> i32 {
    check(mc_workers.workers_for_cores(1) == 2, 1)
    check(mc_workers.workers_for_cores(4) == 2, 2)
    check(mc_workers.workers_for_cores(8) == 6, 3)
    check(mc_workers.workers_for_cores(16) == 12, 4)
    check(mc_workers.workers_for_cores(64) == 12, 5)
    let cores: i32 = cpus.cpu_count()
    check(cores >= 1 && cores <= 4096, 6)
    let w: i32 = mc_workers.workers_default()
    check(w >= mc_workers.WORKERS_MIN && w <= mc_workers.WORKERS_MAX, 7)

    check(mc_frame_limit.fl_vsync_on(1, false, 0), 10)
    check(!mc_frame_limit.fl_vsync_on(0, false, 1), 11)
    check(!mc_frame_limit.fl_vsync_on(1, true, 0), 12)
    check(mc_frame_limit.fl_vsync_on(0, true, 1), 13)

    check(mc_frame_limit.fl_frame_ns(mc_opts.FPS_UNLIMITED, false, 0, true) == 0 as u64, 20)
    check(mc_frame_limit.fl_frame_ns(mc_opts.FPS_UNLIMITED, false, 0, false) == 16666666 as u64, 21)
    check(mc_frame_limit.fl_frame_ns(100, false, 0, true) == 10000000 as u64, 22)
    check(mc_frame_limit.fl_frame_ns(100, true, 0, true) == 0 as u64, 23)
    check(mc_frame_limit.fl_frame_ns(100, true, 250, true) == 4000000 as u64, 24)
    check(mc_frame_limit.fl_frame_ns(mc_opts.FPS_UNLIMITED, true, 60, true) == 16666666 as u64, 25)

    var o: mc_opts.Opts = mc_opts.opts_new()
    check(o.fps_limit == mc_opts.FPS_UNLIMITED && o.vsync == 1, 30)
    o.fps_limit = 144
    o.vsync = 0
    var out: rt.Buf = rt.buf_new()
    mc_opts.opts_text(&o, &out)
    var q: mc_opts.Opts = mc_opts.opts_new()
    mc_opts.opts_parse(rt.buf_ptr(&out), rt.buf_len(&out), &q)
    check(q.fps_limit == 144, 31)
    check(q.vsync == 0, 32)
    q.fps_limit = 3
    mc_opts.opts_clamp(&q)
    check(q.fps_limit == mc_opts.FPS_MIN, 33)
    q.fps_limit = 9999
    mc_opts.opts_clamp(&q)
    check(q.fps_limit == mc_opts.FPS_UNLIMITED, 34)
    rt.buf_free(&out)

    check(mc_net_budget.nb_limit_ns(5000 as u64, false, false, 0) == 0 as u64, 40)
    check(mc_net_budget.nb_limit_ns(5000 as u64, true, false, 0) == 0 as u64, 41)
    check(mc_net_budget.nb_limit_ns(5000 as u64 + mc_net_budget.NB_WARMUP_MS, true, false, 0) == 1500000 as u64, 42)
    check(mc_net_budget.nb_limit_ns(1 as u64, true, true, 0) == 0 as u64, 43)
    check(mc_net_budget.nb_limit_ns(1 as u64, false, true, 800) == 800000 as u64, 44)
    check(!mc_net_budget.nb_over(10 as u64, 9999999 as u64, 0 as u64), 45)
    check(mc_net_budget.nb_over(10 as u64, 2000010 as u64, 1500000 as u64), 46)
    check(!mc_net_budget.nb_over(10 as u64, 1000010 as u64, 1500000 as u64), 47)
    rt.finish(0 as i64)
    return 0
}
