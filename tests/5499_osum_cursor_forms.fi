// expect_exit: 42
import window.osumcursor

fn main() -> i32 {
    let want: [u64; 9] = [0, 1, 2, 7, 8, 3, 4, 7, 9]
    var s: usize = 0
    while s < 9 {
        if osumcursor.form_for(s as u32) != want[s] {
            return 1 + s as i32
        }
        s = s + 1
    }
    if osumcursor.form_for(9 as u32) != osumcursor.FORM_ARROW {
        return 20
    }
    if osumcursor.form_for(4000 as u32) != osumcursor.FORM_ARROW {
        return 21
    }
    s = 0
    while s < 9 {
        if osumcursor.form_for(s as u32) > osumcursor.FORM_KERNEL_MAX {
            return 30
        }
        s = s + 1
    }
    return 42
}
