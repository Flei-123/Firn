// expect_exit: 0
// tests/945_layout_gc.fi -- the box tree leaves nothing behind.
//
// The long endurance run stands in tools/layout/gc_layout.sh (RSS flat
// over 60 seconds). What is checked HERE is the same promise in the
// small, so that it is part of test.sh: after N rounds of DOM, style
// table, box tree, line boxes and fragments, the number of LIVE GC
// objects has to be back where it was -- and the counter check, which
// holds every tree onto a chain, MUST push it up. A test that only
// checks the good case cannot see a leak at all.
//
// The box tree is the harder of the two structures. It points in every
// direction at once: a box holds its style, its elem, its children,
// its inline items and its line boxes; an item holds a box; a fragment
// holds the box it belongs to; and an inline box broken over three lines
// is pointed at by three fragments. A reference count would keep all of
// it alive as soon as any one of them survived.
//
// The return value names the first case that deviates (1..3).
import html.mem
import browser.node
import browser.names
import browser.driver
import css.tok
import css.cv
import css.sel
import css.cascade
import layout.box
import layout.build
import layout.flow

const SOURCE_LEN: usize = 247
const SHEET_LEN: usize = 303
const ROUNDS: u64 = 30

#[no_gc]
fn source(out: *mut mem.Buf) {
    var t: [u8; 247] = "<!DOCTYPE html><html><body><div class=\"w\"><div class=\"f\"></div><p>one two three four five six</p><p>tail <span class=\"i\">inline</span> end</p></div><div class=\"r\"><div class=\"a\"></div></div><div class=\"x\"><div></div><div></div></div></body></html>"
    mem.buf_clear(out)
    var i: usize = 0
    while i < SOURCE_LEN {
        mem.buf_push(out, t[i])
        i = i + 1
    }
}

#[no_gc]
fn sheet(out: *mut mem.CpBuf) {
    var t: [u8; 303] = "html,body,div,p{display:block;margin:0;padding:0}html{font-size:16px}.w{width:300px;padding:4px;border:2px solid}.f{float:left;width:60px;height:40px}.i{padding:1px 3px}.r{position:relative;width:100px;height:30px}.a{position:absolute;left:5px;top:5px;width:10px;height:10px}.x{display:flex;width:200px}"
    mem.cp_clear(out)
    var i: usize = 0
    while i < SHEET_LEN {
        mem.cp_push(out, t[i] as u32)
        i = i + 1
    }
}

gc class Holder {
    tree: Gc[Box],
    next: Gc[Holder],
}

fn scrub_deep(n: u64) {
    var buffer: [u64; 512] = [0; 512]
    var i: usize = 0
    while i < 512 {
        buffer[i] = 0
        i = i + 1
    }
    barrier(&buffer)
    if n > 0 {
        scrub_deep(n - 1)
    }
}

fn next_in_order(k: Gc[Node], root: Gc[Node]) -> Gc[Node] {
    if k.first_child != gc_null[Node]() {
        return k.first_child
    }
    var c: Gc[Node] = k
    while c != gc_null[Node]() && c != root {
        if c.next != gc_null[Node]() {
            return c.next
        }
        c = c.parent
    }
    return gc_null[Node]()
}

fn count_boxes(b: Gc[Box]) -> u64 {
    var n: u64 = 1
    var i: u64 = 0
    while i < box.box_kids(b) {
        n = n + count_boxes(box.box_kid(b, i))
        i = i + 1
    }
    return n
}

fn one_round(l: *mut driver.Run, src: *mut mem.Buf, css: *mut mem.CpBuf,
    t: *mut tok.Tokens, tmp: *mut mem.CpBuf, cx: *mut sel.Ctx,
    w: *mut cascade.Winner, keep: *mut Gc[Box]) -> AllocError!u64 {
    driver.run_text_out_bytes(l, mem.buf_ptr(src), mem.buf_len(src))
    let rc: u32 = driver.run_document_build(l)
    if rc != 0 as u32 {
        return 0
    }
    let doc: Gc[Document] = driver.run_document(l)
    let nm: *mut names.Names = driver.run_names(l)
    tok.tokenize(t, css)
    var p: cv.Parser = cv.parser_new(t)
    let sheet_tree = try cv.parse_stylesheet(&p)
    var order: u32 = 0
    let rules = try cascade.collect_rules(sheet_tree, cascade.ORIGIN_AUTHOR, 0,
        nm, tmp, &order)
    let styles = try gcmap_new(true, true)
    let root_style = try cascade.style_root()
    var k: Gc[Node] = doc
    while k != gc_null[Node]() {
        if k.kind == node.K_ELEM {
            var parent_style: Gc[Style] = root_style
            let parent: Gc[Node] = k.parent
            if parent != gc_null[Node]() && parent.kind == node.K_ELEM {
                let found: Gc[Style] = gcmap_get_value[Style](styles,
                    parent as u64)
                if found != gc_null[Style]() {
                    parent_style = found
                }
            }
            let s = try cascade.cascade_elem(rules, k, parent_style, cx, w)
            let ok: bool = try gcmap_set_value[Style](styles, k as u64, s)
        }
        k = next_in_order(k, doc)
    }
    let root = try build.build_document(doc, styles, root_style, nm)
    if root == gc_null[Box]() {
        return 0
    }
    let okl: bool = try flow.layout_document(root, 800.0, 600.0)
    *keep = root
    return count_boxes(root)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    var src: mem.Buf = mem.buf_new()
    mem.buf_init(&src)
    source(&src)
    var css: mem.CpBuf = mem.cp_new()
    mem.cp_init(&css)
    sheet(&css)
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var tmp: mem.CpBuf = mem.cp_new()
    var run: driver.Run = driver.run_new()
    if !driver.run_init(&run) {
        return 91
    }
    var cx: sel.Ctx = sel.ctx_new(driver.run_names(&run))
    sel.ctx_init(&cx)
    var w: cascade.Winner = cascade.winner_new()
    var keep: Gc[Box] = gc_null[Box]()

    // 1. the first round has to produce a box tree at all
    let boxes: u64 = one_round(&run, &src, &css, &t, &tmp, &cx, &w, &keep)
    catch 0
    if boxes < 10 {
        return 1
    }
    keep = gc_null[Box]()
    driver.run_tree_release(&run)
    scrub_deep(3)
    gc_collect()
    let base: u64 = gc_live_objects()

    // 2. after ROUNDS further rounds nothing more may be alive
    var i: u64 = 0
    while i < ROUNDS {
        let n: u64 = one_round(&run, &src, &css, &t, &tmp, &cx, &w, &keep)
        catch 0
        if n != boxes {
            return 2
        }
        keep = gc_null[Box]()
        i = i + 1
    }
    driver.run_tree_release(&run)
    scrub_deep(3)
    gc_collect()
    let after: u64 = gc_live_objects()
    if after > base + 200 {
        return 2
    }

    // 3. the counter check: every tree is held onto -- it HAS to grow
    var chain: Gc[Holder] = gc_null[Holder]()
    i = 0
    while i < ROUNDS {
        let n: u64 = one_round(&run, &src, &css, &t, &tmp, &cx, &w, &keep)
        catch 0
        if n != boxes {
            return 3
        }
        let h = gc Holder { tree: keep, next: chain } catch gc_null[Holder]()
        if h == gc_null[Holder]() {
            return 3
        }
        chain = h
        keep = gc_null[Box]()
        i = i + 1
    }
    gc_collect()
    let leaked: u64 = gc_live_objects()
    if chain == gc_null[Holder]() {
        return 3
    }
    // Every held box tree keeps its whole document, its style table, its
    // line boxes and its inline items alive. The limit lies well below
    // what is really measured, so that the check strikes without becoming
    // brittle.
    if leaked < base + 300 {
        return 3
    }
    driver.run_free(&run)
    return 0
}
