// expect_exit: 0
import std.rt
import mc.mc_raster
import mc.mc_combat_fx
import mc.mc_combat_ui
import mc.mc_use_bar

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn kind(name: str) -> i32 {
    return mc_use_bar.use_kind_of(name.p as u64, name.n)
}

fn held(fx: *mut mc_combat_fx.CombatFx, id: i32, name: str, now: u64) {
    mc_combat_fx.cfx_set_held(fx, id, name.p as u64, name.n, now)
}

fn px(r: *mut mc_raster.Raster, x: i32, y: i32) -> u32 {
    return mc_raster.raster_pixel(r, x, y)
}

fn main() -> i32 {
    check(kind("bow") == mc_use_bar.USE_BOW && kind("crossbow") == mc_use_bar.USE_CROSSBOW && kind("trident") == mc_use_bar.USE_TRIDENT, 1)
    check(kind("apple") == mc_use_bar.USE_EAT && kind("cooked_beef") == mc_use_bar.USE_EAT && kind("golden_carrot") == mc_use_bar.USE_EAT, 2)
    check(kind("potion") == mc_use_bar.USE_EAT && kind("milk_bucket") == mc_use_bar.USE_EAT && kind("honey_bottle") == mc_use_bar.USE_EAT, 3)
    check(kind("dried_kelp") == mc_use_bar.USE_EAT && kind("mushroom_stew") == mc_use_bar.USE_EAT && kind("pumpkin_pie") == mc_use_bar.USE_EAT, 4)
    check(kind("stone") == mc_use_bar.USE_NONE && kind("snowball") == mc_use_bar.USE_NONE && kind("splash_potion") == mc_use_bar.USE_NONE, 5)
    check(kind("cow_spawn_egg") == mc_use_bar.USE_NONE && kind("carrot_on_a_stick") == mc_use_bar.USE_NONE && kind("water_bucket") == mc_use_bar.USE_NONE, 6)
    check(kind("wheat_seeds") == mc_use_bar.USE_NONE && kind("rabbit_foot") == mc_use_bar.USE_NONE && kind("diamond_sword") == mc_use_bar.USE_NONE, 7)

    check(mc_use_bar.use_progress_permille(mc_use_bar.USE_BOW, 1000 as u64, 250 as u64) == 250, 8)
    check(mc_use_bar.use_progress_permille(mc_use_bar.USE_BOW, 1000 as u64, 5000 as u64) == 1000, 9)
    check(mc_use_bar.use_progress_permille(mc_use_bar.USE_EAT, 1600 as u64, 800 as u64) == 500, 10)
    check(mc_use_bar.use_progress_permille(mc_use_bar.USE_EAT, 1600 as u64, 1600 as u64) < 0, 11)
    check(mc_use_bar.use_progress_permille(mc_use_bar.USE_NONE, 1000 as u64, 10 as u64) < 0, 12)

    var fx: mc_combat_fx.CombatFx = mc_combat_fx.cfx_new()
    held(&fx, 1, "bow", 100 as u64)
    check(fx.use_kind == mc_use_bar.USE_BOW && fx.use_full_ms == 1000 as u64 && !mc_combat_fx.cfx_use_active(&fx), 13)
    check(mc_combat_fx.cfx_use_progress(&fx, 200 as u64) < 0, 14)
    mc_combat_fx.cfx_use_begin(&fx, 1000 as u64)
    check(mc_combat_fx.cfx_use_active(&fx) && mc_combat_fx.cfx_use_progress(&fx, 1500 as u64) == 500, 15)
    check(mc_combat_fx.cfx_use_progress(&fx, 900 as u64) < 0, 16)

    var r: mc_raster.Raster = mc_raster.raster_new(200, 120)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_combat_ui.combat_ui_draw(&fx, &r, 1, 1500 as u64)
    check(px(&r, 95, 73) == mc_combat_ui.USE_BAR_FILL && px(&r, 105, 73) != mc_combat_ui.USE_BAR_FILL && px(&r, 105, 73) != 0xFF000000 as u32, 17)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_combat_ui.combat_ui_draw(&fx, &r, 1, 2500 as u64)
    check(px(&r, 100, 73) == mc_combat_ui.USE_BAR_FULL, 18)
    mc_combat_fx.cfx_use_end(&fx)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    mc_combat_ui.combat_ui_draw(&fx, &r, 1, 2600 as u64)
    check(px(&r, 95, 73) == 0xFF000000 as u32, 19)

    held(&fx, 2, "apple", 3000 as u64)
    check(fx.use_kind == mc_use_bar.USE_EAT && fx.use_full_ms == 1600 as u64, 20)
    mc_combat_fx.cfx_use_begin(&fx, 3000 as u64)
    check(mc_combat_fx.cfx_use_progress(&fx, 3800 as u64) == 500 && mc_combat_fx.cfx_use_progress(&fx, 4700 as u64) < 0, 21)
    held(&fx, 3, "stone", 3900 as u64)
    check(!mc_combat_fx.cfx_use_active(&fx) && fx.use_kind == mc_use_bar.USE_NONE, 22)
    mc_combat_fx.cfx_use_begin(&fx, 4000 as u64)
    check(!mc_combat_fx.cfx_use_active(&fx), 23)
    held(&fx, 4, "crossbow", 5000 as u64)
    check(fx.use_full_ms == 1250 as u64, 24)
    return 0
}
