// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
// tests/2894_ahttp_sink.fi -- async.ahttp file sink (areq_set_sink): the body of a 200 answer goes to a
// file descriptor and through SHA-256, never into memory. A small HTTP/1.1 server lives in the same loop.
//
// A  Content-Length body (5000 octets): file = pattern, digest = digest of the pattern, body in memory empty
// B  chunked body dribbled 9 octets per ms (3501 octets)
// C  3 MiB, progress callback sees a growing count and the last value is the size
// D  a redirect (302 -> 200): only the final body is in the file
// E  an error page (503) is NOT written (file stays empty, sink_got 0)
// F  max body 1000 < 5000: error 15, the file never gets more than the limit
// G  the callback returns nonzero: AE_CANCELLED
// H  the sink to a closed descriptor: sink_failed, error 7
import std.rt
import std.net
import std.crypto.sha256
import net.http
import async.loop
import async.stream
import async.ahttp

static mut fails: u32 = 0

fn check(ok: bool, code: u32) {
    if !ok {
        fails = fails + 1
        let m: [u8; 5] = "FAIL "
        syscall(1, 2, (&m[0]) as i64, 5, 0, 0, 0)
        var d: [u8; 4] = [48, 48, 48, 10]
        d[0] = (48 + (code / 100) % 10) as u8
        d[1] = (48 + (code / 10) % 10) as u8
        d[2] = (48 + code % 10) as u8
        syscall(1, 2, (&d[0]) as i64, 4, 0, 0, 0)
    }
}

// ---------------------------------------------------------------- server

struct SConn {
    out: rt.Buf,
    pos: usize,
    dribble: usize, // octets per millisecond, 0 = all at once
    timer: u64,
    s: *mut stream.Stream,
    live: bool,
    close_after: bool,
}

static mut srv_requests: u32 = 0
static mut saw_cookie: u32 = 0
static mut saw_post_body: u32 = 0
static mut gz_blob: [u8; 37] = [31, 139, 8, 0, 0, 0, 0, 0, 2, 3, 203, 72, 205, 201, 201, 87, 72, 175, 202, 44, 80, 84, 200, 24, 101, 15, 59, 54, 0, 117, 14, 220, 42, 224, 1, 0, 0]

fn push(b: *mut rt.Buf, t: str) {
    rt.buf_push_bytes(b, t.p as u64, t.n)
}

fn bbyte(i: usize) -> u8 {
    return ((i * 7 + (i >> 8)) & 255) as u8
}

const NOLEN: usize = 18446744073709551615

fn head(b: *mut rt.Buf, status: str, extra: str, clen: usize, chunked: bool) {
    push(b, "HTTP/1.1 ")
    push(b, status)
    push(b, "\r\n")
    push(b, extra)
    if chunked {
        push(b, "Transfer-Encoding: chunked\r\n")
    } else if clen != NOLEN {
        push(b, "Content-Length: ")
        rt.buf_push_dec_u64(b, clen as u64)
        push(b, "\r\n")
    }
    push(b, "\r\n")
}

fn find(p: u64, n: usize, lit: str) -> usize {
    var i: usize = 0
    while i + lit.n <= n {
        if rt.mem_eq(p + i as u64, lit.p as u64, lit.n) {
            return i
        }
        i = i + 1
    }
    return n
}

fn starts(p: u64, n: usize, lit: str) -> bool {
    return n >= lit.n && rt.mem_eq(p, lit.p as u64, lit.n)
}

fn pump(l: *mut loop.Loop, ud: u64) {
    let c: *mut SConn = ud as *mut SConn
    (*c).timer = 0
    if !(*c).live {
        return
    }
    var k: usize = (*c).out.len - (*c).pos
    if (*c).dribble != 0 && k > (*c).dribble {
        k = (*c).dribble
    }
    if k > 0 {
        stream.stream_write((*c).s, (*c).out.ptr + (*c).pos as u64, k)
        (*c).pos = (*c).pos + k
    }
    if (*c).pos < (*c).out.len {
        (*c).timer = loop.timer_after(l, 1, pump, ud)
    } else if (*c).close_after {
        stream.stream_close((*c).s)
    }
}

fn srv_event(s: *mut stream.Stream, ud: u64, kind: u32, arg: i64) {
    let c: *mut SConn = ud as *mut SConn
    if kind == stream.SE_DATA {
        if (*c).out.len != 0 {
            stream.stream_consume(s, stream.stream_in_len(s))
            return
        }
        let p: u64 = stream.stream_in_ptr(s)
        let n: usize = stream.stream_in_len(s)
        let he: usize = find(p, n, "\r\n\r\n")
        if he >= n {
            return
        }
        // Content-Length of the request
        var clen: usize = 0
        let ci: usize = find(p, he, "Content-Length: ")
        if ci < he {
            var q: usize = ci + 16
            while q < he && rt.ld8(p, q) >= 48 as u8 && rt.ld8(p, q) <= 57 as u8 {
                clen = clen * 10 + (rt.ld8(p, q) - 48 as u8) as usize
                q = q + 1
            }
        }
        if n < he + 4 + clen {
            return
        }
        srv_requests = srv_requests + 1
        respond(s, c, p, he, p + (he + 4) as u64, clen)
        stream.stream_consume(s, n)
        pump(stream.stream_loop(s), c as u64)
    } else if kind == stream.SE_CLOSED {
        (*c).live = false
        if (*c).timer != 0 {
            loop.timer_cancel(stream.stream_loop(s), (*c).timer)
        }
        rt.buf_free(&(*c).out)
    }
}

fn respond(s: *mut stream.Stream, c: *mut SConn, p: u64, he: usize, body: u64, clen: usize) {
    let o: *mut rt.Buf = &(*c).out
    (*c).close_after = true
    if starts(p, he, "GET /len ") {
        head(o, "200 OK", "", 5000, false)
        var i: usize = 0
        while i < 5000 {
            rt.buf_push(o, bbyte(i))
            i = i + 1
        }
    } else if starts(p, he, "GET /big ") {
        head(o, "200 OK", "", 3145728, false)
        var i2: usize = 0
        while i2 < 3145728 {
            rt.buf_push(o, bbyte(i2))
            i2 = i2 + 1
        }
    } else if starts(p, he, "GET /chunked ") {
        (*c).dribble = 9
        head(o, "200 OK", "", 0, true)
        push(o, "3e8\r\n")
        var j: usize = 0
        while j < 1000 {
            rt.buf_push(o, bbyte(j))
            j = j + 1
        }
        push(o, "\r\n9C5\r\n")
        j = 0
        while j < 2501 {
            rt.buf_push(o, bbyte(1000 + j))
            j = j + 1
        }
        push(o, "\r\n0\r\n\r\n")
    } else if starts(p, he, "GET /r1 ") {
        head(o, "302 Found", "Location: /len\r\n", 0, false)
    } else if starts(p, he, "GET /err ") {
        head(o, "503 Unavailable", "", 12, false)
        push(o, "do not store")
    } else {
        head(o, "404 Not Found", "", 0, false)
    }
}

fn on_conn(l: *mut loop.Loop, ud: u64, cn: net.Conn) {
    let q: u64 = rt.heap_alloc(size_of[SConn]())
    let c: *mut SConn = q as *mut SConn
    *c = SConn { out: rt.buf_new(), pos: 0, dribble: 0, timer: 0,
        s: 0 as *mut stream.Stream, live: true, close_after: true }
    (*c).s = stream.stream_adopt(l, cn, 20000, srv_event, q)
}

// ---------------------------------------------------------------- clients

static mut f_done: bool = false
static mut f_err: u32 = 0
static mut f_status: u32 = 0
static mut f_got: u64 = 0
static mut f_failed: bool = false
static mut f_mem: usize = 0
static mut f_digest: [u8; 32] = [0 as u8; 32]
static mut cb_calls: u32 = 0
static mut cb_last: u64 = 0
static mut cb_mono: bool = true
static mut cb_abort_at: u64 = 0 // 0 = never

fn on_done(r: *mut ahttp.Request, ud: u64) {
    f_done = true
    f_err = ahttp.areq_error(r)
    f_status = ahttp.areq_status(r)
    f_got = ahttp.areq_sink_got(r)
    f_failed = ahttp.areq_sink_failed(r)
    f_mem = ahttp.areq_body_len(r)
    ahttp.areq_sink_digest(r, (&f_digest[0]) as u64)
}

fn on_progress(ud: u64, got: u64) -> u32 {
    cb_calls = cb_calls + 1
    if got <= cb_last {
        cb_mono = false
    }
    cb_last = got
    if cb_abort_at != 0 && got >= cb_abort_at {
        return 1 as u32
    }
    return 0 as u32
}

fn t_stop(l: *mut loop.Loop, ud: u64) { loop.stop(l) }

fn t_check(l: *mut loop.Loop, ud: u64) {
    if f_done {
        loop.stop(l)
    }
}

fn run_one(l: *mut loop.Loop, ms: i64) {
    let h: u64 = loop.timer_after(l, ms, t_stop, 0)
    let c: u64 = loop.timer_every(l, 2, t_check, 0)
    loop.run(l)
    loop.timer_cancel(l, h)
    loop.timer_cancel(l, c)
}

fn url_to(port: u16, path: str, out: *mut rt.Buf) {
    rt.buf_clear(out)
    push(out, "http://127.0.0.1:")
    rt.buf_push_dec_u64(out, port as u64)
    push(out, path)
}

fn path_of(buf: *mut [u8; 64], id: u64) {
    var k: usize = 0
    let pre: str = "/tmp/t2894_sink_"
    while k < pre.n {
        (*buf)[k] = rt.ld8(pre.p as u64, k)
        k = k + 1
    }
    var v: u64 = id
    var dg: usize = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        dg = dg + 1
    }
    var q: usize = dg
    while q > 0 {
        q = q - 1
        (*buf)[k + q] = (48 + v % 10) as u8
        v = v / 10
    }
    k = k + dg
    (*buf)[k] = 0 as u8
}

fn open_sink(path: u64) -> i64 {
    // O_WRONLY | O_CREAT | O_TRUNC, 0600
    return syscall(2, path as i64, 577, 384, 0, 0, 0)
}

// the file: size, and every octet = bbyte(i)
fn file_is_pattern(path: u64, want: usize, digest: u64) -> bool {
    let fd: i64 = syscall(2, path as i64, 0, 0, 0, 0, 0)
    if fd < 0 {
        return false
    }
    var buf: rt.Buf = rt.buf_new()
    var chunk: [u8; 4096] = [0 as u8; 4096]
    var ok: bool = true
    var total: usize = 0
    var sh: sha256.Sha256 = sha256.sha256_new()
    while true {
        let n: i64 = syscall(0, fd, (&chunk[0]) as i64, 4096, 0, 0, 0)
        if n < 0 {
            ok = false
            break
        }
        if n == 0 {
            break
        }
        var i: usize = 0
        while i < n as usize {
            if chunk[i] != bbyte(total + i) {
                ok = false
            }
            i = i + 1
        }
        sha256.sha256_update(&sh, (&chunk[0]) as u64, n as usize)
        total = total + n as usize
    }
    syscall(3, fd, 0, 0, 0, 0, 0)
    rt.buf_free(&buf)
    var dg: [u8; 32] = [0 as u8; 32]
    sha256.sha256_final(&sh, (&dg[0]) as u64)
    if total != want {
        ok = false
    }
    if !rt.mem_eq((&dg[0]) as u64, digest, 32) {
        ok = false
    }
    return ok
}

fn file_size(path: u64) -> i64 {
    let fd: i64 = syscall(2, path as i64, 0, 0, 0, 0, 0)
    if fd < 0 {
        return 0 - 1
    }
    let sz: i64 = syscall(8, fd, 0, 2, 0, 0, 0) // lseek(fd, 0, SEEK_END)
    syscall(3, fd, 0, 0, 0, 0, 0)
    return sz
}

fn reset_state() {
    f_done = false
    f_err = 0
    f_status = 0
    f_got = 0
    f_failed = false
    f_mem = 0
    cb_calls = 0
    cb_last = 0
    cb_mono = true
    cb_abort_at = 0
}

// one GET with a sink on a fresh file; returns the file path in `path`
fn fetch(a: *mut ahttp.AClient, l: *mut loop.Loop, port: u16, url: str, maxbody: usize, path: *mut [u8; 64]) {
    var u: rt.Buf = rt.buf_new()
    url_to(port, url, &u)
    reset_state()
    let fd: i64 = open_sink((path as u64))
    check(fd >= 0, 900)
    let r: *mut ahttp.Request = ahttp.aclient_get(a, u.ptr, u.len, 20000, on_done, 0)
    check(r as u64 != 0, 901)
    if maxbody != 0 {
        ahttp.areq_set_max_body(r, maxbody)
    }
    ahttp.areq_set_sink(r, fd, on_progress, 0)
    run_one(l, 20000)
    syscall(3, fd, 0, 0, 0, 0, 0)
    rt.buf_free(&u)
}

// the digest of the first n pattern octets
fn pattern_digest(n: usize, out: u64) {
    var sh: sha256.Sha256 = sha256.sha256_new()
    var i: usize = 0
    while i < n {
        var one: [u8; 1] = [bbyte(i)]
        sha256.sha256_update(&sh, (&one[0]) as u64, 1)
        i = i + 1
    }
    sha256.sha256_final(&sh, out)
}

#[allow_escape]
fn suite(force_poll: bool, id: u64) {
    var l: loop.Loop = loop.loop_new()
    var ok: bool = false
    if force_poll {
        ok = loop.loop_init_poll(&l)
    } else {
        ok = loop.loop_init(&l)
    }
    check(ok, 1)
    var a: ahttp.AClient = ahttp.aclient_new()
    check(ahttp.aclient_init(&a, &l), 2)
    http.client_set_max_redirects(ahttp.aclient_http(&a), 5)
    let acc: *mut stream.Acceptor = stream.acceptor_new(&l, net.ADDR_LOCAL, 0 as u16, 256, on_conn, 0)
    check(acc as u64 != 0, 3)
    let port: u16 = stream.acceptor_port(acc)
    var path: [u8; 64] = [0 as u8; 64]
    path_of(&path, id)
    var want: [u8; 32] = [0 as u8; 32]

    // ---- A
    fetch(&a, &l, port, "/len", 0, &path)
    pattern_digest(5000, (&want[0]) as u64)
    check(f_done && f_err == 0 && f_status == 200, 10)
    check(f_got == 5000 && !f_failed && f_mem == 0, 11)
    check(file_is_pattern((&path[0]) as u64, 5000, (&want[0]) as u64), 12)
    check(rt.mem_eq((&f_digest[0]) as u64, (&want[0]) as u64, 32), 13)
    check(cb_calls >= 1 && cb_mono && cb_last == 5000, 14)

    // ---- B: chunked, dribbled
    fetch(&a, &l, port, "/chunked", 0, &path)
    pattern_digest(3501, (&want[0]) as u64)
    check(f_done && f_err == 0 && f_status == 200, 20)
    check(f_got == 3501 && f_mem == 0, 21)
    check(file_is_pattern((&path[0]) as u64, 3501, (&want[0]) as u64), 22)
    check(rt.mem_eq((&f_digest[0]) as u64, (&want[0]) as u64, 32), 23)
    check(cb_calls > 1 && cb_mono, 24)

    // ---- C: 3 MiB
    fetch(&a, &l, port, "/big", 0, &path)
    pattern_digest(3145728, (&want[0]) as u64)
    check(f_done && f_err == 0 && f_status == 200, 30)
    check(f_got == 3145728 && f_mem == 0, 31)
    check(file_is_pattern((&path[0]) as u64, 3145728, (&want[0]) as u64), 32)
    check(rt.mem_eq((&f_digest[0]) as u64, (&want[0]) as u64, 32), 33)
    check(cb_calls > 1 && cb_mono && cb_last == 3145728, 34)

    // ---- D: redirect, only the final body
    fetch(&a, &l, port, "/r1", 0, &path)
    pattern_digest(5000, (&want[0]) as u64)
    check(f_done && f_err == 0 && f_status == 200 && f_got == 5000, 40)
    check(file_is_pattern((&path[0]) as u64, 5000, (&want[0]) as u64), 41)

    // ---- E: an error page is not written
    fetch(&a, &l, port, "/err", 0, &path)
    check(f_done && f_status == 503 && f_got == 0, 50)
    check(file_size((&path[0]) as u64) == 0, 51)

    // ---- F: size limit
    fetch(&a, &l, port, "/len", 1000, &path)
    check(f_done && f_err == 15, 60)
    check(file_size((&path[0]) as u64) <= 1000, 61)

    // ---- G: cancelled from the callback
    reset_state()
    var u: rt.Buf = rt.buf_new()
    url_to(port, "/big", &u)
    let fdg: i64 = open_sink((&path[0]) as u64)
    let rg: *mut ahttp.Request = ahttp.aclient_get(&a, u.ptr, u.len, 20000, on_done, 0)
    ahttp.areq_set_sink(rg, fdg, on_progress, 0)
    cb_abort_at = 100000
    run_one(&l, 20000)
    syscall(3, fdg, 0, 0, 0, 0, 0)
    check(f_done && f_err == ahttp.AE_CANCELLED, 70)
    check(file_size((&path[0]) as u64) < 3145728, 71)

    // ---- H: a descriptor that cannot be written
    reset_state()
    url_to(port, "/len", &u)
    let rh: *mut ahttp.Request = ahttp.aclient_get(&a, u.ptr, u.len, 20000, on_done, 0)
    ahttp.areq_set_sink(rh, 9999, on_progress, 0)
    run_one(&l, 20000)
    check(f_done && f_failed && f_err == 7, 80)
    rt.buf_free(&u)

    syscall(87, (&path[0]) as i64, 0, 0, 0, 0, 0) // unlink
    stream.acceptor_close(acc)
    let t1: i64 = loop.mono_ms()
    while loop.watch_count(&l) > 0 && loop.mono_ms() - t1 < 1000 {
        loop.run_once(&l, 10)
    }
    ahttp.aclient_free(&a)
    loop.loop_free(&l)
}

fn main() -> i32 {
    let pid: u64 = syscall(39, 0, 0, 0, 0, 0, 0) as u64
    suite(false, pid * 10)
    suite(true, pid * 10 + 1)
    if fails != 0 {
        return 1
    }
    return 0
}
