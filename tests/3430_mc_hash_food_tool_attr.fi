// expect_exit: 0
// mc_hash 1.21.5+: food, tool and attribute_modifiers component hashes, and the crafting table / furnace window sizes of mc_inv.
// Expected values come from an independent Python implementation of the hashing ops (CRC32C over tagged bytes).
// Return codes: 1xx = hashes, 2xx = windows.
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_hash
import mc.mc_inv

fn hs(s: str) -> u32 { return mc_hash.hash_string(s.p as u64, s.n) }

fn open_win(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32, typ: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&b, id)
    bytes.put_varint(&b, typ)
    bytes.put_u8(&b, 0 as u8)
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_open_window_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn win_check(p: i32, craft: i32, furnace: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 200 }
    var v: mc_inv.Inv = mc_inv.inv_new()
    if !open_win(&v, &ver, 3, craft) { return 201 }
    if mc_inv.inv_window_slots(&v) != 10 || mc_inv.inv_window_cols(&v) != 3 { return 202 }
    if !open_win(&v, &ver, 4, furnace) { return 203 }
    if mc_inv.inv_window_slots(&v) != 3 { return 204 }
    if !open_win(&v, &ver, 5, 99) { return 205 }
    if mc_inv.inv_window_slots(&v) > 0 { return 206 }
    mc_inv.inv_free(&v)
    return 0
}

fn main() -> i32 {
    if mc_hash.hash_food(4, 0x40200000 as u32, true) != (1478675052 as u32) { return 101 }
    if mc_hash.hash_food(1, 0 as u32, false) != (4222663997 as u32) { return 102 }
    // attribute_modifiers: [attack_damage mainhand add_value 7.5, water_movement_efficiency any add_multiplied_base 0.25]
    let e1: u32 = mc_hash.hash_attr_entry(hs("minecraft:attack_damage"), hs("test:a"), 0x401e000000000000 as u64, 0, 1, 0)
    let e2: u32 = mc_hash.hash_attr_entry(hs("minecraft:water_movement_efficiency"), hs("test:b"), 0x3fd0000000000000 as u64, 1, 0, 0)
    let el: u64 = rt.heap_alloc(16)
    rt.st32(el, 0, e1)
    rt.st32(el, 1, e2)
    if mc_hash.hash_list(el, 2) != (776068227 as u32) { return 103 }
    // tool: tag rule, two block ids, one block id
    let r0: u32 = mc_hash.hash_tool_rule(mc_hash.hash_blocks_tag("minecraft:mineable/pickaxe".p as u64, "minecraft:mineable/pickaxe".n), true, 0x41000000 as u32, true, true)
    let ids: u64 = rt.heap_alloc(16)
    rt.st32(ids, 0, hs("minecraft:dirt"))
    rt.st32(ids, 1, hs("minecraft:sand"))
    let r1: u32 = mc_hash.hash_tool_rule(mc_hash.hash_blocks_ids(ids, 2), true, 0x40000000 as u32, false, false)
    let one: u64 = rt.heap_alloc(16)
    rt.st32(one, 0, hs("minecraft:stone"))
    let r2: u32 = mc_hash.hash_tool_rule(mc_hash.hash_blocks_ids(one, 1), false, 0 as u32, false, false)
    let rl: u64 = rt.heap_alloc(16)
    rt.st32(rl, 0, r0)
    rt.st32(rl, 1, r1)
    rt.st32(rl, 2, r2)
    if mc_hash.hash_tool(rl, 3, 0x3fc00000 as u32, 2, false) != (2099146768 as u32) { return 104 }
    let w1: i32 = win_check(763, 11, 13)
    if w1 != 0 { return w1 }
    let w2: i32 = win_check(769, 12, 14)
    if w2 != 0 { return w2 }
    return 0
}
