// expect_out: ok
// tests/3383_zoom_stops.fi -- plat.android.focusplan.zoom_stops: the zoom chip row from lens factors and the zoom range.
import std.io
import plat.android.focusplan

fn expect(tag: str, eq: *mut [f32; 4], n: i32, refi: i32, cur: i32, zmin: f32, zmax: f32, ex: *mut [f32; 2], nx: i32, cap: i32, want: *mut [i32; 8], wopt: *mut [i32; 8], nw: i32) -> bool {
    var ox: [i32; 8] = [0; 8]
    var oo: [i32; 8] = [0; 8]
    let got: i32 = focusplan.zoom_stops((&(*eq)[0]) as u64, n, refi, cur, zmin, zmax, (&(*ex)[0]) as u64, nx, (&ox[0]) as u64, (&oo[0]) as u64, cap)
    var ok: bool = got == nw
    var i: i32 = 0
    while i < nw && i < 8 {
        if ox[i as usize] != (*want)[i as usize] || oo[i as usize] != (*wopt)[i as usize] { ok = false }
        i = i + 1
    }
    if !ok { io.print(tag); io.print(" ") }
    return ok
}

fn main() -> i32 {
    var none: [f32; 2] = [0.0f; 2]
    // Xiaomi-like: ultra wide 14, main 23, tele 60 (35 mm equivalent), zoom range 0.6 .. 10 on the main lens
    var a: [f32; 4] = [23.0f, 14.0f, 60.0f, 0.0f]
    var wa: [i32; 8] = [6, 10, 20, 26, 50, 80, 0, 0]
    var oa: [i32; 8] = [1, 1, 0, 1, 0, 0, 0, 0]
    if !expect("A", &a, 3, 0, 0, 1.0f, 10.0f, &none, 0, 6, &wa, &oa, 6) { return 1 }
    // fewer chips: lens factors first
    var wf: [i32; 8] = [6, 10, 26, 0, 0, 0, 0, 0]
    var of: [i32; 8] = [1, 1, 1, 0, 0, 0, 0, 0]
    if !expect("F", &a, 3, 0, 0, 1.0f, 10.0f, &none, 0, 3, &wf, &of, 3) { return 2 }
    // the same lenses seen from the tele lens (zoom ratio range 1 .. 10 of the tele itself): the row is the same
    var wt: [i32; 8] = [6, 10, 20, 26, 50, 80, 0, 0]
    var ot: [i32; 8] = [1, 1, 0, 1, 0, 0, 0, 0]
    if !expect("T", &a, 3, 0, 2, 1.0f, 10.0f, &none, 0, 6, &wt, &ot, 6) { return 3 }
    // main + ultra wide only (tele hidden), logical range 0.6 .. 10 -> digital stops fill the row
    var b: [f32; 4] = [23.0f, 14.0f, 0.0f, 0.0f]
    var wb: [i32; 8] = [6, 10, 20, 30, 50, 80, 0, 0]
    var ob: [i32; 8] = [1, 1, 0, 0, 0, 0, 0, 0]
    if !expect("B", &b, 2, 0, 0, 0.6f, 10.0f, &none, 0, 6, &wb, &ob, 6) { return 4 }
    // a single lens, range 1 .. 8: its own 1x is a lens stop, the rest digital
    var c: [f32; 4] = [26.0f, 0.0f, 0.0f, 0.0f]
    var wc: [i32; 8] = [10, 20, 30, 50, 80, 0, 0, 0]
    var oc: [i32; 8] = [1, 0, 0, 0, 0, 0, 0, 0]
    if !expect("C", &c, 1, 0, 0, 1.0f, 8.0f, &none, 0, 6, &wc, &oc, 5) { return 5 }
    // front camera without zoom
    var wd: [i32; 8] = [10, 0, 0, 0, 0, 0, 0, 0]
    var od: [i32; 8] = [1, 0, 0, 0, 0, 0, 0, 0]
    if !expect("D", &c, 1, 0, 0, 1.0f, 1.0f, &none, 0, 6, &wd, &od, 1) { return 6 }
    // tele known only from the focal length list of the logical camera
    var ex: [f32; 2] = [60.0f, 0.0f]
    var we: [i32; 8] = [10, 23, 30, 50, 80, 100, 0, 0]
    var oe: [i32; 8] = [1, 1, 0, 0, 0, 0, 0, 0]
    if !expect("E", &c, 1, 0, 0, 1.0f, 10.0f, &ex, 1, 6, &we, &oe, 6) { return 7 }
    // a range below 1 on a camera without listed ultra wide still gets its 0.6 stop
    var wg: [i32; 8] = [6, 10, 20, 30, 50, 80, 0, 0]
    var og: [i32; 8] = [1, 1, 0, 0, 0, 0, 0, 0]
    if !expect("G", &c, 1, 0, 0, 0.6f, 10.0f, &none, 0, 6, &wg, &og, 6) { return 8 }
    // bad input
    var bad: [i32; 8] = [0; 8]
    if focusplan.zoom_stops((&c[0]) as u64, 1, 0, 0, 1.0f, 8.0f, 0, 0, (&bad[0]) as u64, (&bad[0]) as u64, 0) != 0 { io.print("cap0"); return 9 }
    io.print("ok")
    return 0
}
