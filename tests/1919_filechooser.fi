// expect_exit: 42
// tests/1919_filechooser.fi -- lib/fui/filechooser.fi (OpenPlan LIB-005):
// listing, sorting, filtering, hidden files, entering and leaving
// directories, and what open/save/directory dialogs choose. Works in a
// directory of its own under /tmp.
import fui.filechooser
import std.fs
import std.rt
import std.str

fn scratch() -> str {
    var b: rt.Buf = rt.buf_new()
    let head: str = "/tmp/firn_fc_1919_"
    rt.buf_push_bytes(&b, head.p as u64, head.length())
    rt.buf_push_dec_i64(&b, syscall(39, 0, 0, 0, 0, 0, 0))
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

fn touch(path: str, size: usize) {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < size {
        rt.buf_push(&b, 120 as u8)
        i = i + 1
    }
    fs.write_file(path, rt.buf_ptr(&b), size) catch 0
    rt.buf_free(&b)
}

fn main() -> i32 {
    let root: str = scratch()
    fs.remove_tree(root) catch false
    fs.mkdir_all(root + "/Projects/Old") catch false
    fs.mkdir_all(root + "/archive") catch false
    fs.mkdir_all(root + "/.cache") catch false
    touch(root + "/b-plan.opz", 10)
    touch(root + "/A-Plan.OPZ", 20)
    touch(root + "/notes.txt", 5)
    touch(root + "/data.json", 7)
    touch(root + "/.hidden.opz", 1)
    touch(root + "/Projects/Wende.opz", 3)

    // --- A. glob
    if !filechooser.fc_matches("*.opz", "x.OPZ") || filechooser.fc_matches("*.opz", "x.opzz") { return 1 as i32 }
    if !filechooser.fc_matches("*.opz; *.json", "a.json") || !filechooser.fc_matches("", "any") { return 2 as i32 }
    if !filechooser.fc_matches("plan-??.pdf", "plan-07.pdf") || filechooser.fc_matches("plan-??.pdf", "plan-7.pdf") { return 3 as i32 }
    if !filechooser.fc_matches("*a*b*c", "xxaxxbxxc") || filechooser.fc_matches("*a*b*c", "xxaxxcxxb") { return 4 as i32 }

    // --- B. open: directories first, then files, case-insensitive; the
    // filter hides notes.txt, the hidden ones stay hidden
    var fc: filechooser.FileChooser = filechooser.fc_new(filechooser.FC_OPEN, "*.opz;*.json")
    if !filechooser.fc_open_dir(&fc, root) { return 10 as i32 }
    if filechooser.fc_count(&fc) != 5 { return 11 as i32 }
    if filechooser.fc_name(&fc, 0) != "archive" || filechooser.fc_name(&fc, 1) != "Projects" { return 12 as i32 }
    if !filechooser.fc_is_dir(&fc, 0) || filechooser.fc_is_dir(&fc, 2) { return 13 as i32 }
    if filechooser.fc_name(&fc, 2) != "A-Plan.OPZ" || filechooser.fc_name(&fc, 3) != "b-plan.opz" || filechooser.fc_name(&fc, 4) != "data.json" { return 14 as i32 }
    if filechooser.fc_size(&fc, 2) != 20 || filechooser.fc_mtime_ns(&fc, 2) < 1767225600000000000 { return 15 as i32 }
    // hidden entries on request
    filechooser.fc_show_hidden(&fc, true)
    filechooser.fc_open_dir(&fc, root)
    if filechooser.fc_count(&fc) != 7 || filechooser.fc_name(&fc, 0) != ".cache" { return 16 as i32 }
    filechooser.fc_show_hidden(&fc, false)
    filechooser.fc_open_dir(&fc, root)

    // --- C. keyboard and activation
    if filechooser.fc_selected(&fc) != 0 { return 20 as i32 }
    filechooser.fc_move(&fc, 3)
    if filechooser.fc_selected(&fc) != 3 { return 21 as i32 }
    filechooser.fc_move(&fc, 100)
    if filechooser.fc_selected(&fc) != 4 { return 22 as i32 }
    filechooser.fc_move(&fc, -100)
    if filechooser.fc_selected(&fc) != 0 { return 23 as i32 }
    // into "Projects": Old (a directory), Wende.opz
    if filechooser.fc_activate(&fc, 1) != filechooser.FC_ENTERED { return 24 as i32 }
    if filechooser.fc_dir(&fc) != root + "/Projects" || filechooser.fc_count(&fc) != 2 || filechooser.fc_name(&fc, 1) != "Wende.opz" { return 25 as i32 }
    if filechooser.fc_activate(&fc, 1) != filechooser.FC_CHOSEN || filechooser.fc_result(&fc) != root + "/Projects/Wende.opz" { return 26 as i32 }
    // and back up
    if !filechooser.fc_up(&fc) || filechooser.fc_dir(&fc) != root { return 27 as i32 }
    // a directory that cannot be read leaves the listing as it was
    if filechooser.fc_open_dir(&fc, root + "/nope") || filechooser.fc_count(&fc) != 5 { return 28 as i32 }

    // --- D. save: the typed name, the filter's extension added
    var sv: filechooser.FileChooser = filechooser.fc_new(filechooser.FC_SAVE, "*.opz;*.json")
    filechooser.fc_open_dir(&sv, root)
    filechooser.fc_set_name(&sv, "Neu")
    if filechooser.fc_activate(&sv, -1) != filechooser.FC_CHOSEN || filechooser.fc_result(&sv) != root + "/Neu.opz" { return 30 as i32 }
    filechooser.fc_set_name(&sv, "export.json")
    filechooser.fc_activate(&sv, -1)
    if filechooser.fc_result(&sv) != root + "/export.json" { return 31 as i32 }
    // selecting an existing file puts its name into the field
    filechooser.fc_select(&sv, 3)
    if filechooser.fc_activate(&sv, -1) != filechooser.FC_CHOSEN || filechooser.fc_result(&sv) != root + "/b-plan.opz" { return 32 as i32 }
    filechooser.fc_set_name(&sv, "a/b")
    if filechooser.fc_activate(&sv, -1) != filechooser.FC_NOTHING { return 33 as i32 }

    // --- E. choose a directory: only directories are listed
    var dc: filechooser.FileChooser = filechooser.fc_new(filechooser.FC_DIR, "")
    filechooser.fc_open_dir(&dc, root)
    if filechooser.fc_count(&dc) != 2 { return 40 as i32 }
    filechooser.fc_activate(&dc, 1)
    if filechooser.fc_activate(&dc, -1) != filechooser.FC_CHOSEN || filechooser.fc_result(&dc) != root + "/Projects" { return 41 as i32 }

    fs.remove_tree(root) catch false
    return 42
}
