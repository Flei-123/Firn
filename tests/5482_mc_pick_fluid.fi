// expect_exit: 0
import std.rt
import mc.mc_version
import mc.mc_versions
import mc.mc_registry
import mc.mc_shapes

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn text_is(p: u64, n: usize, s: str) -> bool {
    if n < s.n { return false }
    var i: usize = 0
    while i < s.n {
        if rt.ld8(p, i) != rt.ld8(s.p as u64, i) { return false }
        i = i + 1
    }
    return n == s.n || rt.ld8(p, s.n) == 91 as u8
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &v) { return 30 }
    var r: mc_registry.Registry = v.registry_of()
    var t: rt.Buf = rt.buf_new()
    let n: i32 = mc_registry.reg_state_count(&r)
    var fluids: i32 = 0
    var s: i32 = 0
    while s < n {
        rt.buf_clear(&t)
        if mc_registry.reg_state_text(&r, s, &t) {
            let p: u64 = rt.buf_ptr(&t)
            let l: usize = rt.buf_len(&t)
            let want: bool = text_is(p, l, "water") || text_is(p, l, "lava")
            let got: bool = mc_shapes.is_pure_fluid_state(&r, s)
            check(want == got, 40)
            if got { fluids = fluids + 1 }
        }
        s = s + 1
    }
    rt.buf_free(&t)
    check(fluids == 32, 41)
    return 0
}
