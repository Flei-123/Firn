fn hash_bytes(p: u64, n: usize) -> i64 {
    var h: i64 = 0
    var i: usize = 0
    while i < n {
        h = (h * 31 + vp9mem.ld8(p, i)) & 2147483647
        i = i + 1
    }
    return h
}

fn decode_hash(buf: u64, n: usize, out_len: *mut usize) -> i64 {
    var out: rt.Buf = rt.buf_new()
    let d: *mut av1dec.Decoder = av1dec.dec_new()
    av1dec.dec_stream(d, &out, buf, n)
    var h: i64 = 0 - 1
    if (*d).err == 0 && (*d).frames_out == 1 {
        h = hash_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
        *out_len = rt.buf_len(&out)
    }
    av1dec.dec_free(d)
    return h
}

