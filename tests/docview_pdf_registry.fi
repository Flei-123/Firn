// expect_exit: 0
// SPDX-License-Identifier: MPL-2.0
import std.rt
import docview.dvdoc
import docview.kinds
import docview.pdf.opener

fn main() -> i32 {
    var SAMPLE: str = "%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n2 0 obj<</Type/Pages/Kids[3 0 R]/Count 1>>endobj\n3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 200 100]/Contents 4 0 R/Resources<</Font<</F1 5 0 R>>>>>>endobj\n4 0 obj<</Length 41>>stream\nBT /F1 18 Tf 10 50 Td (Hello Firn) Tj ET\nendstream\nendobj\n5 0 obj<</Type/Font/Subtype/Type1/BaseFont/Helvetica>>endobj\ntrailer<</Root 1 0 R>>\n"
    opener.pdf_install_lazy()
    var d: dvdoc.Doc = dvdoc.doc_open(SAMPLE.p as u64, SAMPLE.n)
    if !dvdoc.doc_ok(&d) {
        return 1
    }
    if dvdoc.doc_kind(&d) != kinds.KIND_PDF {
        return 2
    }
    if dvdoc.doc_pages(&d) != 1 {
        return 3
    }
    var w: i32 = 0
    var h: i32 = 0
    if !dvdoc.doc_page_size(&d, 0, &w, &h) || w != 200 || h != 100 {
        return 4
    }
    var buf: rt.Buf = rt.buf_new()
    if !dvdoc.doc_render(&d, 0, 1.0, &buf, &w, &h) || w != 200 || h != 100 || rt.buf_len(&buf) != 200 * 100 * 4 {
        return 5
    }
    var txt: rt.Buf = rt.buf_new()
    if !dvdoc.doc_text(&d, 0, &txt) || rt.buf_len(&txt) < 10 {
        return 6
    }
    dvdoc.doc_free(&d)
    if dvdoc.doc_ok(&d) {
        return 7
    }
    var bad: str = "%PDF-1.4 garbage"
    var d2: dvdoc.Doc = dvdoc.doc_open(bad.p as u64, bad.n)
    if dvdoc.doc_ok(&d2) {
        return 8
    }
    return 0
}
