// expect_exit: 0
// E!i64 is 16 bytes and travels through the hidden return pointer.
error E { A }

fn big(n: i64) -> E!i64 {
    if n == 0 as i64 {
        return E::A
    }
    return n * 1000000 as i64
}

fn next(n: i64) -> E!i64 {
    let v = try big(n)
    return v + 1 as i64
}

fn main() -> i32 {
    if (next(1 as i64) catch 0 as i64) != 1000001 as i64 {
        return 1
    }
    if (next(0 as i64) catch 0 as i64 - 1 as i64) != 0 as i64 - 1 as i64 {
        return 2
    }
    return 0
}
