// expect_exit: 0
// E!i64 ist 16 Byte gross und laeuft ueber den versteckten Rueckgabezeiger.
error E { A }

fn gross(n: i64) -> E!i64 {
    if n == 0 as i64 {
        return E::A
    }
    return n * 1000000 as i64
}

fn weiter(n: i64) -> E!i64 {
    let v = try gross(n)
    return v + 1 as i64
}

fn main() -> i32 {
    if (weiter(1 as i64) catch 0 as i64) != 1000001 as i64 {
        return 1
    }
    if (weiter(0 as i64) catch 0 as i64 - 1 as i64) != 0 as i64 - 1 as i64 {
        return 2
    }
    return 0
}
