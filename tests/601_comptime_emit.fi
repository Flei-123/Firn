// expect_exit: 0
// `comptime` + `emit` (SPEC §6.4, Abnahmepunkt 6): ein `comptime`-Block
// erzeugt FIRN-QUELLTEXT, den derselbe Uebersetzungslauf weiterverarbeitet.
// Genau so entstehen in einem Browser die Unicode-Tabellen, die
// CSS-Eigenschaften und die Web-IDL-Bindungen.

// Die Regel, aus der die Tabelle entsteht — hier von Hand, spaeter aus einer
// Datenquelle.
fn is_lower_letter(c: i64) -> i64 {
    if c >= 97 {
        if c <= 122 {
            return 1
        }
    }
    return 0
}

fn big(c: i64) -> i64 {
    if is_lower_letter(c) == 1 {
        return c - 32
    }
    return c
}

// Erzeugt eine Nachschlagefunktion fuer den ASCII-Bereich. Der Rumpf entsteht
// Zeile fuer Zeile zur Uebersetzungszeit.
comptime {
    emit_raw("fn tab_big(c: i64) -> i64 {\n")
    for c in 97..123 {
        emit_raw("    if c == ")
        emit_number(c)
        emit_raw(" { return ")
        emit_number(big(c))
        emit_raw(" }\n")
    }
    emit_raw("    return c\n}\n")

    // Auch Kennzahlen lassen sich so festschreiben.
    emit_raw("const COUNT_LOWERCASE: i64 = ")
    var n: i64 = 0
    for c in 0..128 {
        n = n + is_lower_letter(c)
    }
    emit_number(n)
    emit_raw("\n")
}

fn main() -> i32 {
    // 'a' -> 'A'
    if tab_big(97) != 65 {
        return 1
    }
    // 'z' -> 'Z'
    if tab_big(122) != 90 {
        return 2
    }
    // Ziffern bleiben unveraendert
    if tab_big(48) != 48 {
        return 3
    }
    // schon gross bleibt gross
    if tab_big(65) != 65 {
        return 4
    }
    if COUNT_LOWERCASE != 26 {
        return 5
    }
    return 0
}
