// expect_exit: 0
// `comptime` + `emit` (SPEC §6.4, Abnahmepunkt 6): ein `comptime`-Block
// erzeugt FIRN-QUELLTEXT, den derselbe Uebersetzungslauf weiterverarbeitet.
// Genau so entstehen in einem Browser die Unicode-Tabellen, die
// CSS-Eigenschaften und die Web-IDL-Bindungen.

// Die Regel, aus der die Tabelle entsteht — hier von Hand, spaeter aus einer
// Datenquelle.
fn ist_kleinbuchstabe(c: i64) -> i64 {
    if c >= 97 {
        if c <= 122 {
            return 1
        }
    }
    return 0
}

fn gross(c: i64) -> i64 {
    if ist_kleinbuchstabe(c) == 1 {
        return c - 32
    }
    return c
}

// Erzeugt eine Nachschlagefunktion fuer den ASCII-Bereich. Der Rumpf entsteht
// Zeile fuer Zeile zur Uebersetzungszeit.
comptime {
    emit_roh("fn tab_gross(c: i64) -> i64 {\n")
    for c in 97..123 {
        emit_roh("    if c == ")
        emit_zahl(c)
        emit_roh(" { return ")
        emit_zahl(gross(c))
        emit_roh(" }\n")
    }
    emit_roh("    return c\n}\n")

    // Auch Kennzahlen lassen sich so festschreiben.
    emit_roh("const ANZAHL_KLEINBUCHSTABEN: i64 = ")
    var n: i64 = 0
    for c in 0..128 {
        n = n + ist_kleinbuchstabe(c)
    }
    emit_zahl(n)
    emit_roh("\n")
}

fn main() -> i32 {
    // 'a' -> 'A'
    if tab_gross(97) != 65 {
        return 1
    }
    // 'z' -> 'Z'
    if tab_gross(122) != 90 {
        return 2
    }
    // Ziffern bleiben unveraendert
    if tab_gross(48) != 48 {
        return 3
    }
    // schon gross bleibt gross
    if tab_gross(65) != 65 {
        return 4
    }
    if ANZAHL_KLEINBUCHSTABEN != 26 {
        return 5
    }
    return 0
}
