// expect_exit: 0
// `comptime` + `emit` (SPEC 6.4, acceptance item 6): a `comptime` block
// produces FIRN SOURCE TEXT which the same compilation run processes further.
// That is exactly how the Unicode tables, the CSS properties and the Web IDL
// bindings come about in a browser.

// The rule the table is made from -- by hand here, from a data source
// later on.
fn is_lower_letter(c: i64) -> i64 {
    if c >= 97 {
        if c <= 122 {
            return 1
        }
    }
    return 0
}

fn big(c: i64) -> i64 {
    if is_lower_letter(c) == 1 {
        return c - 32
    }
    return c
}

// Produces a lookup function for the ASCII range. The body comes about line
// by line at compile time.
comptime {
    emit_raw("fn tab_big(c: i64) -> i64 {\n")
    for c in 97..123 {
        emit_raw("    if c == ")
        emit_number(c)
        emit_raw(" { return ")
        emit_number(big(c))
        emit_raw(" }\n")
    }
    emit_raw("    return c\n}\n")

    // Key numbers can be fixed this way too.
    emit_raw("const COUNT_LOWERCASE: i64 = ")
    var n: i64 = 0
    for c in 0..128 {
        n = n + is_lower_letter(c)
    }
    emit_number(n)
    emit_raw("\n")
}

fn main() -> i32 {
    // 'a' -> 'A'
    if tab_big(97) != 65 {
        return 1
    }
    // 'z' -> 'Z'
    if tab_big(122) != 90 {
        return 2
    }
    // Digits stay unchanged
    if tab_big(48) != 48 {
        return 3
    }
    // already upper case stays upper case
    if tab_big(65) != 65 {
        return 4
    }
    if COUNT_LOWERCASE != 26 {
        return 5
    }
    return 0
}
