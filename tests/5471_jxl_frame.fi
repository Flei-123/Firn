import jxl.jxl
import std.fs
import std.rt

static mut failures: i32 = 0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn expect(path: str, w: u32, h: u32, groups: u32, lf_groups: u32) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    if n == 0 {
        failures = failures + 1
        return
    }
    var fi: jxl.JxlFrameInfo = jxl.JxlFrameInfo { encoding: 9, flags: 0, width: 0, height: 0, num_passes: 0,
        num_groups: 0, num_lf_groups: 0, is_last: false, toc_count: 0, toc_total: 0, body_start: 0, remaining: 0 }
    let ok: bool = jxl.jxl_frame_info(rt.buf_ptr(&data), n, &fi) catch false
    check(ok)
    check(fi.encoding == 1)
    check(fi.width == w)
    check(fi.height == h)
    check(fi.num_groups == groups)
    check(fi.num_lf_groups == lf_groups)
    check(fi.num_passes == 1)
    check(fi.is_last)
    check(fi.flags == 0)
    check(fi.toc_total == fi.remaining)
    rt.buf_free(&data)
}

fn main() -> i32 {
    expect("tests/data/jxl/rgb16x16.jxl", 16, 16, 1, 1)
    expect("tests/data/jxl/rgb37x23.jxl", 37, 23, 1, 1)
    expect("tests/data/jxl/grey20x20.jxl", 20, 20, 1, 1)
    expect("tests/data/jxl/rgba17x9.jxl", 17, 9, 1, 1)
    expect("tests/data/jxl/rgb300x200.jxl", 300, 200, 1, 1)
    expect("tests/data/jxl/greya24x24.jxl", 24, 24, 1, 1)
    expect("tests/data/jxl/rgb1x1.jxl", 1, 1, 1, 1)
    expect("tests/data/jxl/rgb513x7.jxl", 513, 7, 3, 1)
    expect("tests/data/jxl/rgb300x20.jxl", 300, 20, 1, 1)
    expect("tests/data/jxl/rgb64x64_e1.jxl", 64, 64, 1, 1)
    expect("tests/data/jxl/rgb64x64_e9.jxl", 64, 64, 1, 1)
    expect("tests/data/jxl/rgb40x40_e3.jxl", 40, 40, 1, 1)
    expect("tests/data/jxl/rgb40x40_e5.jxl", 40, 40, 1, 1)
    return failures
}
