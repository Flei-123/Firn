// expect_exit: 0
// only_mode: opt
// tests/4437_rotr32_pattern.fi -- r837: the 32-bit rotate written with 64-bit
// values (as in SHA-256 code) must compute the same on every target. The
// aarch64 build turns it into one `ror w, w, #n` (compiler/src/rotate.rs);
// the cross check against x86-64 (which keeps the shifts) proves it.
//
//   A  five counts, each through a wrapper so the count is a constant
//   B  swapped operands and the mask written first
//   C  an input that was masked before (no inner mask in the expression)
//   D  NOT a rotate: no inner mask, the upper half leaks into the result
import std.io

const M32: u64 = 4294967295

fn rotr32(x: u64, n: u64) -> u64 {
    return (((x & M32) >> n) | (x << (32 as u64 - n))) & M32
}

// reference: n single-bit rotations of the low half
fn ref_rotr(x: u64, n: u64) -> u64 {
    var v: u64 = x & M32
    var k: u64 = 0
    while k < n {
        v = (v >> 1) | ((v & 1) << 31)
        k = k + 1
    }
    return v
}

fn r1(x: u64) -> u64 { return rotr32(x, 1) }
fn r7(x: u64) -> u64 { return rotr32(x, 7) }
fn r13(x: u64) -> u64 { return rotr32(x, 13) }
fn r25(x: u64) -> u64 { return rotr32(x, 25) }
fn r31(x: u64) -> u64 { return rotr32(x, 31) }
fn s11(x: u64) -> u64 { return M32 & ((x << (21 as u64)) | ((x & M32) >> 11)) }
fn p18(x: u64) -> u64 {
    let b: u64 = x & M32
    return ((b >> 18) | (b << 14)) & M32
}
fn u5(x: u64) -> u64 { return ((x >> 5) | (x << 27)) & M32 }
fn u5_ref(x: u64) -> u64 { return ((x >> 5) & M32) | ((x << 27) & M32) }

fn main() -> i32 {
    var x: u64 = 88172645463325252
    var bad: i32 = 0
    var i: u64 = 0
    while i < 3000 {
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        if r1(x) != ref_rotr(x, 1) { bad = bad + 1 }
        if r7(x) != ref_rotr(x, 7) { bad = bad + 1 }
        if r13(x) != ref_rotr(x, 13) { bad = bad + 1 }
        if r25(x) != ref_rotr(x, 25) { bad = bad + 1 }
        if r31(x) != ref_rotr(x, 31) { bad = bad + 1 }
        if s11(x) != ref_rotr(x, 11) { bad = bad + 1 }
        if p18(x) != ref_rotr(x, 18) { bad = bad + 1 }
        if u5(x) != u5_ref(x) { bad = bad + 1 }
        i = i + 1
    }
    if bad != 0 {
        io.println_str("rotr32 mismatches")
        return 1
    }
    return 0
}
