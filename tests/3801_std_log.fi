// expect_exit: 0
// tests/3801_std_log.fi -- std.log: levels, inherited logger levels, the
// format string, and rotation by size (same numbers as Python's
// RotatingFileHandler(maxBytes=250, backupCount=2); the full comparison is
// examples/vs_python/18_logging + tools/vspy/check_sys.sh).
import std.rt
import std.fs
import std.fsx
import std.log
import std.io
import std.testkit

fn slurp(path: str) -> str {
    var b: rt.Buf = rt.buf_new()
    fs.read_file(path, &b) catch 0
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

#[allow_escape]
fn work() -> FsError!bool {
    var d: fsx.TempDir = try fsx.temp_dir("log_t_")
    defer fsx.temp_dir_drop(&d)
    let path: str = fsx.temp_dir_path(&d) + "/a.log"
    var lg: log.Logging = log.logging(log.INFO, "%(levelname)-8s|%(name)s|%(message)s")
    log.add_file(&lg, path, log.NOTSET, 80, 2)
    log.set_level(&lg, "x.y", log.DEBUG)
    log.debug(&lg, "x", "hidden")
    log.debug(&lg, "x.y.z", "inherits DEBUG")
    log.info(&lg, "x", "one")
    testkit.check(slurp(path) == "DEBUG   |x.y.z|inherits DEBUG\nINFO    |x|one\n", "levels, inheritance, format")
    for i in 0..6 {
        log.info(&lg, "r", io.fmt_string(f"line {i}"))
    }
    testkit.check(fs.exists(path + ".1") && fs.exists(path + ".2") && !fs.exists(path + ".3"), "rotation keeps two backups")
    testkit.check(slurp(path) == "INFO    |r|line 5\n", "newest line in the live file")
    log.close(&lg)
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    testkit.check(work() catch | e | false, "work ran")
    return testkit.finish()
}
