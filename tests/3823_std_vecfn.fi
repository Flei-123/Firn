// expect_exit: 0
// tests/3823_std_vecfn.fi -- std.vecfn: sum, product, map, filter, reduce,
// slice, get/item for non-scalar elements, each, empty vecs, f64.
import std.rt
import std.vec
import std.vecfn
import std.testkit

struct P { a: i64, b: f64 }

fn sq(e: *i32) -> i32 { return (*e) * (*e) }
fn odd(e: *i32) -> bool { return (*e) % 2 == 1 }
fn plus(acc: i64, e: *i32) -> i64 { return acc + (*e) as i64 }
fn pa(e: *P) -> i64 { return (*e).a }
fn bump(i: usize, e: *P, ctx: u64) { *(ctx as *mut i64) = *(ctx as *mut i64) + (*e).a * (i as i64 + 1) }

fn ints(n: i32) -> Vec[i32] {
    var v: Vec[i32] = vec_new[i32]()
    for i in 1..n + 1 { vec_push[i32](&v, i) }
    return v
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = ints(7)
    var o: Vec[i32] = vec_new[i32]()
    var e: Vec[i32] = vec_new[i32]()
    testkit.check(vec_sum[i32](&v) == 28 && vec_product[i32](&v) == 5040, "sum, product")
    testkit.check(vec_sum[i32](&e) == 0 && vec_product[i32](&e) == 1, "empty sum/product")
    vec_map[i32, i32](&v, sq, &o)
    testkit.check(vec_len[i32](&o) == 7 && vec_at[i32](&o, 6) == 49 && vec_sum[i32](&o) == 140, "map")
    var f: Vec[i32] = vec_new[i32]()
    vec_filter[i32](&v, odd, &f)
    testkit.check(vec_len[i32](&f) == 4 && vec_at[i32](&f, 3) == 7, "filter")
    testkit.check(vec_reduce[i32, i64](&v, 100, plus) == 128, "reduce")
    var s: Vec[i32] = vec_new[i32]()
    vec_slice[i32](&v, 2, 5, &s)
    vec_slice[i32](&v, 5, 99, &s)
    vec_slice[i32](&v, 9, 3, &s)
    testkit.check(vec_len[i32](&s) == 5 && vec_at[i32](&s, 0) == 3 && vec_at[i32](&s, 4) == 7, "slice clamps")
    var t: Vec[i32] = vec_new[i32]()
    vec_last_n[i32](&v, 2, &t)
    testkit.check(vec_len[i32](&t) == 2 && vec_at[i32](&t, 0) == 6, "last_n")
    var ps: Vec[P] = vec_new[P]()
    vec_push[P](&ps, P { a: 4, b: 2.5 })
    vec_push[P](&ps, P { a: 5, b: 1.5 })
    var got: P = P { a: 0, b: 0.0 }
    testkit.check(vec_get[P](&ps, 1, &got) && got.a == 5 && !vec_get[P](&ps, 2, &got) && got.a == 5, "get")
    let it = vec_item[P](&ps, 0)
    let miss = vec_item[P](&ps, 9)
    var none: Vec[P] = vec_new[P]()
    let emp = vec_item[P](&none, 0)
    testkit.check(it.a == 4 && it.b == 2.5 && miss.a == 0 && miss.b == 0.0 && emp.a == 0, "item, zero when missing")
    var ids: Vec[i64] = vec_new[i64]()
    vec_map[P, i64](&ps, pa, &ids)
    testkit.check(vec_sum[i64](&ids) == 9, "map struct to scalar")
    var acc: i64 = 0
    vec_each[P](&ps, bump, (&acc) as u64)
    testkit.check(acc == 4 * 1 + 5 * 2, "each with index")
    var fv: Vec[f64] = vec_new[f64]()
    vec_push[f64](&fv, 1.5)
    vec_push[f64](&fv, 2.25)
    testkit.check(vec_sum[f64](&fv) == 3.75, "f64 sum")
    return testkit.finish()
}
