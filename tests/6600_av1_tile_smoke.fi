// expect_exit: 0
import media.video.vp9.vp9mem
import media.video.av1.av1blkst
import media.video.av1.av1cdfctx
import media.video.av1.av1fhdr
import media.video.av1.av1seq
import media.video.av1.av1tile

fn fill(buf: u64, n: i64, seed: i64) {
    var x: i64 = (seed * 2654435761 + 12345) & 2147483647
    var i: i64 = 0
    while i < n {
        x = (x * 1103515245 + 12345) & 2147483647
        av1blkst.st(buf, i, x >> 16)
        i = i + 1
    }
}

fn run_case(sb128: i64, ssx: i64, ssy: i64, planes: i64, screen: i64, seed: i64, stats: *mut [i64; 4]) -> bool {
    let seq: *mut av1seq.SeqHdr = av1seq.seq_new()
    (*seq).subsampling_x = ssx
    (*seq).subsampling_y = ssy
    (*seq).num_planes = planes
    (*seq).bit_depth = 8
    (*seq).use_128x128_superblock = sb128
    (*seq).enable_cdef = 1
    (*seq).enable_filter_intra = 1
    let fh: *mut av1fhdr.FrameHdr = av1fhdr.fhdr_new()
    (*fh).frame_is_intra = 1
    (*fh).mi_rows = 26
    (*fh).mi_cols = 34
    (*fh).frame_width = 136
    (*fh).frame_height = 104
    (*fh).upscaled_width = 136
    (*fh).tile_cols = 1
    (*fh).tile_rows = 1
    (*fh).mi_row_starts[1] = 26
    (*fh).mi_col_starts[1] = 34
    (*fh).base_q_idx = 100
    (*fh).tx_mode = 2
    (*fh).cdef_bits = 2
    (*fh).allow_screen_content_tools = screen
    (*fh).segmentation_enabled = seed & 1
    (*fh).last_active_seg_id = 3
    (*fh).delta_q_present = 1
    (*fh).delta_lf_present = 1
    (*fh).delta_lf_multi = seed & 1
    (*fh).delta_q_res = 1
    (*fh).delta_lf_res = 1
    var cdfs: av1cdfctx.CdfState = av1cdfctx.cdfs_new()
    av1cdfctx.cdfs_begin_frame(&cdfs, true, 0, 100)
    let td: *mut av1blkst.TileDec = av1blkst.td_new()
    av1blkst.td_setup_frame(td, seq, fh)
    let n: i64 = 6000
    let buf: u64 = vp9mem.alloc(n as usize)
    fill(buf, n, seed)
    let rc: i64 = av1tile.tile_decode(td, &cdfs, 0, buf, n)
    var ok: bool = rc == av1blkst.TD_OK || rc == av1blkst.TD_ERR || rc == av1blkst.TD_UNSUPPORTED
    if rc == av1blkst.TD_OK {
        (*stats)[0] = (*stats)[0] + 1
        ok = ok && (*td).n_blocks > 0 && (*td).n_tx >= (*td).n_blocks
    } else if rc == av1blkst.TD_UNSUPPORTED {
        (*stats)[1] = (*stats)[1] + 1
    } else {
        (*stats)[2] = (*stats)[2] + 1
    }
    (*stats)[3] = (*stats)[3] + (*td).n_blocks
    vp9mem.free(buf, n as usize)
    av1blkst.td_free(td)
    av1cdfctx.cdfs_free(&cdfs)
    av1fhdr.fhdr_free(fh)
    av1seq.seq_free(seq)
    return ok
}

fn main() -> i32 {
    var stats: [i64; 4] = [0, 0, 0, 0]
    var seed: i64 = 1
    var ok: bool = true
    while seed <= 24 {
        ok = run_case(seed & 2 >> 1, 1, 1, 3, 0, seed, &stats) && ok
        ok = run_case(0, 1, 1, 3, 1, seed, &stats) && ok
        ok = run_case(1, 0, 0, 3, 0, seed, &stats) && ok
        ok = run_case(0, 1, 1, 1, 0, seed, &stats) && ok
        seed = seed + 1
    }
    if !ok {
        return 1
    }
    if stats[3] < 1000 {
        return 2
    }
    return 0
}
