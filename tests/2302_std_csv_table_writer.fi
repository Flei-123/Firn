// expect_exit: 0
// tests/2302_std_csv_table_writer.fi -- std.csv: Table (header + cells by
// column name) and Writer (QUOTE_MINIMAL, as Python's csv.writer).
//
//   A  Table: cell by column name, short rows, long rows, blank lines, a header
//      that repeats a name, an error inside the table
//   B  Writer: when a field is quoted, the terminator, the empty row and the
//      row of one empty field, dialects, a field that cannot be written
//   C  Writer -> Reader round trip over hostile fields
import std.rt
import std.str
import std.csv

static mut failures: i32 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn fail(name: str) {
    failures = failures + 1
    say("  FAIL  ")
    say(name)
    say("\n")
}

fn check(ok: bool, name: str) {
    if !ok {
        fail(name)
    }
}

fn out_is(b: *mut rt.Buf, want: str) -> bool {
    return rt.buf_len(b) == want.n && rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.n)
}

fn main() -> i32 {
    // --- A: the table
    var src: str = "name,qty,note\r\nbolt,4,\"M8, zinc\"\r\n\r\nnut,12\r\nwasher,7,x,extra\r\n"
    var t: csv.Table = csv.table_parse(src.p, src.n)
    check(csv.table_error(&t) == csv.E_NONE, "table: no error")
    check(csv.rows(&t) == 3, "table: three data rows, the blank line skipped")
    check(csv.cols(&t) == 3, "table: three columns")
    check(csv.header(&t, 1).equal("qty") && csv.header(&t, 3).n == 0, "table: header names")
    check(csv.col(&t, "note") == 2 && csv.col(&t, "nope") == csv.NO_COL, "table: column index")
    check(csv.cell(&t, 0, "name").equal("bolt") && csv.cell(&t, 0, "note").equal("M8, zinc"), "table: quoted cell by name")
    check(csv.cell(&t, 1, "qty").equal("12"), "table: second row")
    check(csv.cell(&t, 1, "note").n == 0 && !csv.has_cell(&t, 1, "note") && csv.has_cell(&t, 1, "qty"), "table: a short row has no cell")
    check(csv.row_len(&t, 1) == 2 && csv.row_len(&t, 2) == 4, "table: row lengths")
    check(csv.cell_at(&t, 2, 3).equal("extra") && csv.cell(&t, 2, "name").equal("washer"), "table: a long row keeps its extra cell")
    check(csv.cell(&t, 3, "name").n == 0 && csv.cell(&t, 0, "nope").n == 0, "table: no such row / column is \"\"")
    csv.table_free(&t)

    var dup: str = "a,a,b\n1,2,3\n"
    var td: csv.Table = csv.table_parse(dup.p, dup.n)
    check(csv.cell(&td, 0, "a").equal("1") && csv.cell_at(&td, 0, 1).equal("2"), "table: a repeated name finds the first")
    csv.table_free(&td)

    var empty: csv.Table = csv.table_parse("".p, 0)
    check(csv.rows(&empty) == 0 && csv.cols(&empty) == 0 && csv.cell(&empty, 0, "a").n == 0 && csv.col(&empty, "a") == csv.NO_COL, "table: empty input")
    csv.table_free(&empty)

    var only: str = "a,b\n"
    var th: csv.Table = csv.table_parse(only.p, only.n)
    check(csv.rows(&th) == 0 && csv.cols(&th) == 2, "table: header only")
    csv.table_free(&th)

    var broken: str = "k,v\n1,2\n3,\"4\n"
    var tb: csv.Table = csv.table_parse(broken.p, broken.n)
    check(csv.table_error(&tb) == csv.E_UNTERMINATED && csv.rows(&tb) == 1 && csv.table_error_row(&tb) == 3 && csv.table_error_line(&tb) == 3, "table: an error keeps the rows before it")
    csv.table_free(&tb)

    var semi: str = "a;b\n1;\"x;y\"\n"
    var rs: csv.Reader = csv.reader_str(semi)
    csv.set_delimiter(&rs, 59 as u8)
    var ts: csv.Table = csv.table_load(&rs)
    csv.reader_free(&rs)
    check(csv.cell(&ts, 0, "b").equal("x;y"), "table_load with a dialect")
    csv.table_free(&ts)

    // --- B: the writer
    var out: rt.Buf = rt.buf_new()
    var w: csv.Writer = csv.writer(&out)
    csv.put(&w, "plain")
    csv.put(&w, "a,b")
    csv.put(&w, "say \"hi\"")
    csv.put(&w, "two\nlines")
    csv.put(&w, "cr\rhere")
    csv.put(&w, "")
    csv.put(&w, " spaced ")
    check(csv.end_row(&w), "writer: end_row")
    check(out_is(&out, "plain,\"a,b\",\"say \"\"hi\"\"\",\"two\nlines\",\"cr\rhere\",, spaced \r\n"), "writer: QUOTE_MINIMAL with CRLF")

    rt.buf_clear(&out)
    csv.end_row(&w)
    check(out_is(&out, "\r\n"), "writer: a row without a field is the terminator")
    rt.buf_clear(&out)
    csv.put(&w, "")
    csv.end_row(&w)
    check(out_is(&out, "\"\"\r\n"), "writer: a row of one empty field is \"\"")
    rt.buf_clear(&out)
    csv.put(&w, "")
    csv.put(&w, "")
    csv.end_row(&w)
    check(out_is(&out, ",\r\n"), "writer: two empty fields")

    rt.buf_clear(&out)
    check(csv.set_terminator(&w, "\n"), "writer: set_terminator")
    csv.put(&w, "a")
    csv.put(&w, "b\rc")
    csv.put(&w, "d\ne")
    csv.end_row(&w)
    check(out_is(&out, "a,b\rc,\"d\ne\"\n"), "writer: with LF only a lone CR is NOT quoted (as Python)")
    check(!csv.set_terminator(&w, "0123456789abcdef"), "writer: a terminator of 16 bytes is refused")

    rt.buf_clear(&out)
    csv.set_terminator(&w, "\r\n")
    csv.set_writer_delimiter(&w, 59 as u8)
    csv.put(&w, "a;b")
    csv.put(&w, "c,d")
    csv.put_i64(&w, -42)
    csv.put_i64(&w, 0)
    csv.end_row(&w)
    check(out_is(&out, "\"a;b\";c,d;-42;0\r\n"), "writer: semicolon dialect and numbers")
    check(!csv.set_writer_delimiter(&w, 10 as u8) && !csv.set_writer_quote(&w, 13 as u8), "writer: CR / LF refused")

    rt.buf_clear(&out)
    csv.set_writer_delimiter(&w, 44 as u8)
    csv.set_writer_quote(&w, 39 as u8)
    csv.put(&w, "it's")
    csv.put(&w, "\"x\"")
    csv.end_row(&w)
    check(out_is(&out, "'it''s',\"x\"\r\n"), "writer: quote character '")

    rt.buf_clear(&out)
    csv.set_writer_quote(&w, 34 as u8)
    csv.set_writer_doublequote(&w, false)
    csv.put(&w, "ok")
    check(!csv.put(&w, "has \" inside"), "writer: doublequote off, a quote inside refuses the field")
    check(!csv.end_row(&w) && rt.buf_len(&out) == 0, "writer: the refused row is dropped")
    csv.put(&w, "next")
    check(csv.end_row(&w) && out_is(&out, "next\r\n"), "writer: the writer works after a refused row")
    rt.buf_free(&out)

    // appends to what is in the buffer already
    var pre: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&pre, "head\n".p as u64, 5)
    var w2: csv.Writer = csv.writer(&pre)
    csv.put(&w2, "x")
    csv.end_row(&w2)
    check(out_is(&pre, "head\nx\r\n"), "writer: appends to a non-empty buffer")
    rt.buf_free(&pre)

    // --- C: round trip
    var hostile: [str; 8] = ["", "a", "a,b", "\"", "\"\"", "x\r\ny", "\n", ",\",\n\r"]
    var tab: rt.Buf = rt.buf_new()
    var wr: csv.Writer = csv.writer(&tab)
    var row: usize = 0
    while row < 8 {
        var c: usize = 0
        while c < row % 5 {
            csv.put(&wr, hostile[(row + c * 3) % 8])
            c = c + 1
        }
        csv.end_row(&wr)
        row = row + 1
    }
    var rr: csv.Reader = csv.reader(rt.buf_data(&tab), rt.buf_len(&tab))
    var rows_ok: bool = true
    row = 0
    while row < 8 {
        if !csv.next_row(&rr) || csv.field_count(&rr) != row % 5 {
            rows_ok = false
            break
        }
        var c: usize = 0
        while c < row % 5 {
            if !csv.field(&rr, c).equal(hostile[(row + c * 3) % 8]) {
                rows_ok = false
            }
            c = c + 1
        }
        row = row + 1
    }
    check(rows_ok && !csv.next_row(&rr) && csv.error_code(&rr) == csv.E_NONE, "round trip over hostile fields")
    csv.reader_free(&rr)
    rt.buf_free(&tab)

    if failures != 0 {
        return 1
    }
    return 0
}
