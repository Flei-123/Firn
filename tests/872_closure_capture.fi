// expect_exit: 0
// ROUND 58 -- FUNCTIONS AS VALUES, part 3: the CAPTURING closure.
//
// A closure that reads a value out of the enclosing function needs storage
// for it. In Firn that storage is a GC object, and the source says so:
// `gc fn(...)` yields an `AllocError!fn(...)` exactly as `gc C{...}` yields
// an `AllocError!Gc[C]`. Whoever allocates sees it at the place where it
// happens (SPEC 1, guiding principle 1).
//
// CAPTURED IS A COPY, at the moment the closure is created. That is the
// whole rule; docs/ROUND58.md gives the reasoning.

gc class Box { v: i64 }

fn adder(n: i32) -> AllocError!fn(i32) -> i32 {
    return try gc fn(a: i32) -> i32 { return a + n }
}

fn apply(f: fn(i32) -> i32, x: i32) -> i32 { return f(x) }

// Two captured values, and one of them used twice.
fn between(lo: i32, hi: i32) -> AllocError!fn(i32) -> bool {
    return try gc fn(x: i32) -> bool { return x >= lo && x <= hi }
}

// A captured value survives the frame it came from: `adder`'s frame is long
// gone when the closure runs.
fn run() -> AllocError!i32 {
    let add5: fn(i32) -> i32 = try adder(5)
    let add7: fn(i32) -> i32 = try adder(7)
    if add5(1) != 6 { return 1 }
    if add7(1) != 8 { return 2 }
    // two closures out of the same template are two DIFFERENT records
    if add5 == add7 { return 3 }
    if apply(add5, 10) != 15 { return 4 }

    let ok: fn(i32) -> bool = try between(3, 6)
    if ok(2) { return 5 }
    if !ok(3) { return 6 }
    if !ok(6) { return 7 }
    if ok(7) { return 8 }

    // the copy is a COPY: changing the original afterwards does not touch it
    var base: i32 = 100
    let snapshot: fn() -> i32 = try gc fn() -> i32 { return base }
    base = 200
    if snapshot() != 100 { return 9 }

    // a captured Gc pointer: the object stays reachable through the record
    let b: Gc[Box] = try gc Box { v: 42 }
    let read: fn() -> i64 = try gc fn() -> i64 { return b.v }
    if read() != 42 { return 10 }
    b.v = 43
    if read() != 43 { return 11 }

    // a closure inside a loop: one record per pass
    var total: i32 = 0
    var i: i32 = 0
    while i < 4 {
        let f: fn(i32) -> i32 = try gc fn(a: i32) -> i32 { return a * i }
        total = total + f(2)
        i = i + 1
    }
    if total != 12 { return 12 }
    return 0
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return run() catch 91
}
