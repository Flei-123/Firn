// expect_exit: 0
// tests/3822_jobs_map.fi -- jobs_map / jobs_map_into / jobs_map_files: results per
// index equal the sequential ones for n = 0, 1, 7 and 5000 on 0 and 3 workers;
// struct, str and f64 results; a repeated call clears `out`.
import std.io
import std.rt
import std.vec
import std.testkit
import jobs.jobs

struct P { a: i64, b: f64 }

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    return 0
}

fn sq(i: u64) -> i32 { return (i * i % 1000) as i32 }
fn flag(i: u64) -> bool { return i % 3 == 0 }
fn big(i: u64) -> u64 { return i * 4294967311 }
fn mk(i: u64, out: *mut P) { *out = P { a: i as i64 * 3 - 5, b: i as f64 / 4.0 } }
fn nm(i: u64, out: *mut str) { *out = io.fmt_string(f"item{i}") }
fn ln(p: *str, out: *mut u64) { *out = (*p).n as u64 }

fn check_n(j: *mut jobs.Jobs, n: u64, label: str) {
    var a: Vec[i32] = vec_new[i32]()
    var b: Vec[bool] = vec_new[bool]()
    var c: Vec[u64] = vec_new[u64]()
    var ok: bool = jobs_map[i32](j, n, sq, &a) && jobs_map[bool](j, n, flag, &b) && jobs_map[u64](j, n, big, &c)
    ok = ok && vec_len[i32](&a) == n as usize && vec_len[bool](&b) == n as usize && vec_len[u64](&c) == n as usize
    var i: u64 = 0
    while i < n {
        if vec_at[i32](&a, i as usize) != sq(i) || vec_at[bool](&b, i as usize) != flag(i) || vec_at[u64](&c, i as usize) != big(i) {
            ok = false
        }
        i = i + 1
    }
    testkit.check(ok, label)
    var ps: Vec[P] = vec_new[P]()
    var names: Vec[str] = vec_new[str]()
    var lens: Vec[u64] = vec_new[u64]()
    jobs_map_into[P](j, n, mk, &ps)
    jobs_map_into[str](j, n, nm, &names)
    jobs_map_files[u64](j, &names, ln, &lens)
    var ok2: bool = vec_len[P](&ps) == n as usize && vec_len[str](&names) == n as usize && vec_len[u64](&lens) == n as usize
    i = 0
    while i < n {
        let p: P = *vec_elem_ptr[P](&ps, i as usize)
        let s: str = *vec_elem_ptr[str](&names, i as usize)
        let want: str = io.fmt_string(f"item{i}")
        if p.a != i as i64 * 3 - 5 || p.b != i as f64 / 4.0 || s != want || vec_at[u64](&lens, i as usize) != s.n as u64 {
            ok2 = false
        }
        i = i + 1
    }
    testkit.check(ok2, label)
    vec_free[i32](&a)
    vec_free[bool](&b)
    vec_free[u64](&c)
    vec_free[P](&ps)
    vec_free[str](&names)
    vec_free[u64](&lens)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var j0: jobs.Jobs = jobs.create(0)
    var j3: jobs.Jobs = jobs.create(3)
    check_n(&j0, 0, "0 workers n=0")
    check_n(&j0, 1, "0 workers n=1")
    check_n(&j0, 7, "0 workers n=7")
    check_n(&j3, 0, "3 workers n=0")
    check_n(&j3, 1, "3 workers n=1")
    check_n(&j3, 7, "3 workers n=7")
    check_n(&j3, 5000, "3 workers n=5000")
    var again: Vec[i32] = vec_new[i32]()
    jobs_map[i32](&j3, 100, sq, &again)
    jobs_map[i32](&j3, 4, sq, &again)
    testkit.check(vec_len[i32](&again) == 4, "out is cleared first")
    jobs.destroy(&j0)
    jobs.destroy(&j3)
    return testkit.finish()
}
