// expect_exit: 152
// ROUND 96 -- `secret[T]` (SPEC 9.1): what is ALLOWED on a secret value.
//
// Everything in here is data independent: bit operations, the explicit
// wrapping arithmetic, a shift by a PUBLIC amount, a comparison (which hands
// back a `secret[bool]`) and the one way out, `declassify`.
//
// The counter-part -- what is refused -- lies in tests/neg/ct_secret_*.fi.
fn main() -> i32 {
    var s: secret[u8] = 200
    var t: secret[u8] = 100
    // Wrapping is what crypto code means; the checked '+' would jump on the
    // overflow flag of a secret value and is refused for exactly that.
    let a: secret[u8] = s +% t
    let b: secret[u8] = s ^ t
    let c: secret[u8] = ~s
    let d: secret[u8] = s << 2
    let e: secret[bool] = s > t
    // Classification: a PUBLIC value may go into a secret place.
    let f: secret[u8] = 7
    var acc: u8 = declassify(a) ^ declassify(b) ^ declassify(c) ^ declassify(d)
    if declassify(e) {
        acc = acc +% 1
    }
    if declassify(f) == 7 as u8 {
        acc = acc
    }
    return acc as i32
}
