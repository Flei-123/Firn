fn reset() {
    registry.registry_reset()
    lazy.lazy_reset()
    dvinstall.install_builtin()
}

#[test]
fn png_document_opens_and_renders() {
    reset()
    var b: rt.Buf = rt.buf_new()
    png_bytes(&b)
    var d: dvdoc.Doc = dvdoc.doc_open_named(rt.buf_ptr(&b), rt.buf_len(&b), "x.png")
    testkit.assert_true(dvdoc.doc_ok(&d), "open")
    testkit.assert_eq_i64(dvdoc.doc_kind(&d) as i64, kinds.KIND_PNG as i64)
    testkit.assert_eq_i64(dvdoc.doc_pages(&d) as i64, 1)
    var w: i32 = 0
    var h: i32 = 0
    testkit.assert_true(dvdoc.doc_page_size(&d, 0, &w, &h), "size")
    testkit.assert_eq_i64(w as i64, 4)
    testkit.assert_eq_i64(h as i64, 2)
    var px: rt.Buf = rt.buf_new()
    testkit.assert_true(dvdoc.doc_render(&d, 0, 2.0, &px, &w, &h), "render")
    testkit.assert_eq_i64(w as i64, 8)
    testkit.assert_eq_i64(h as i64, 4)
    testkit.assert_eq_i64(rt.buf_len(&px) as i64, 8 * 4 * 4)
    testkit.assert_eq_i64(rt.buf_at(&px, 5 * 4 + 3) as i64, 255)
    testkit.assert_true(!dvdoc.doc_text(&d, 0, &px), "no text")
    dvdoc.doc_free(&d)
    rt.buf_free(&px)
    rt.buf_free(&b)
}

#[test]
fn broken_png_does_not_open() {
    reset()
    var b: rt.Buf = rt.buf_new()
    png_bytes(&b)
    rt.buf_set_len(&b, 30)
    var d: dvdoc.Doc = dvdoc.doc_open_named(rt.buf_ptr(&b), rt.buf_len(&b), "x.png")
    testkit.assert_true(!dvdoc.doc_ok(&d), "closed")
    dvdoc.doc_free(&d)
    rt.buf_free(&b)
}

#[test]
fn text_document_is_flow() {
    reset()
    let s: str = "line one\nline two is longer\n"
    var d: dvdoc.Doc = dvdoc.doc_open_named(s.p as u64, s.n, "a.txt")
    testkit.assert_true(dvdoc.doc_ok(&d), "open")
    testkit.assert_true(dvdoc.doc_is_flow(&d), "flow")
    var w: i32 = 0
    var h: i32 = 0
    dvdoc.doc_page_size(&d, 0, &w, &h)
    testkit.assert_eq_i64(h as i64, 3 * 16)
    testkit.assert_eq_i64(w as i64, 18 * 8)
    var out: rt.Buf = rt.buf_new()
    testkit.assert_true(dvdoc.doc_text(&d, 0, &out), "text")
    testkit.assert_eq_i64(rt.buf_len(&out) as i64, s.n as i64)
    dvdoc.doc_free(&d)
    rt.buf_free(&out)
}

#[test]
fn code_view_indexes_lines() {
    var v: kitcode.CodeView = kitcode.code_new()
    let s: str = "fn main() {\n    return 0\n}\n"
    kitcode.code_set(&v, s.p as u64, s.n, 4 as u32)
    testkit.assert_eq_i64(kitcode.code_line_count(&v) as i64, 4)
    testkit.assert_eq_i64(kitcode.code_line_start(&v, 1) as i64, 12)
    testkit.assert_eq_i64(kitcode.code_line_end(&v, 0) as i64, 11)
    testkit.assert_eq_i64(kitcode.code_line_end(&v, 3) as i64, s.n as i64)
    testkit.assert_true(kitcode.code_height(&v) > 0.0, "height")
    kitcode.code_free(&v)
}

fn push4(b: *mut rt.Buf, a: u32, c: u32, d: u32, e: u32) {
    rt.buf_clear(b)
    rt.buf_push(b, a as u8)
    rt.buf_push(b, c as u8)
    rt.buf_push(b, d as u8)
    rt.buf_push(b, e as u8)
}

#[test]
fn dispatcher_picks_viewers() {
    var v: kitview.View = kitview.view_new()
    testkit.assert_eq_i64(kitview.view_open(&v, "# t\n".p as u64, 4, "a.md") as i64, kitview.MODE_MARKDOWN as i64)
    testkit.assert_eq_i64(kitview.view_open(&v, "x = 1\n".p as u64, 6, "a.toml") as i64, kitview.MODE_CODE as i64)
    testkit.assert_eq_i64(kitview.view_open(&v, "plain\n".p as u64, 6, "a.txt") as i64, kitview.MODE_CODE as i64)
    var b: rt.Buf = rt.buf_new()
    push4(&b, 102, 76, 97, 67)
    testkit.assert_eq_i64(kitview.view_open(&v, rt.buf_ptr(&b), rt.buf_len(&b), "a.flac") as i64, kitview.MODE_MEDIA as i64)
    push4(&b, 1, 2, 3, 4)
    testkit.assert_eq_i64(kitview.view_open(&v, rt.buf_ptr(&b), rt.buf_len(&b), "a.bin") as i64, kitview.MODE_UNSUPPORTED as i64)
    rt.buf_clear(&b)
    png_bytes(&b)
    testkit.assert_eq_i64(kitview.view_open(&v, rt.buf_ptr(&b), rt.buf_len(&b), "a.png") as i64, kitview.MODE_PAGES as i64)
    rt.buf_free(&b)
    kitview.view_free(&v)
}
