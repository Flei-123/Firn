// expect_exit: 0
// tests/2311_std_glob_expand.fi -- std.glob: expanding a pattern over a real
// directory tree (built in a temp directory, removed at the end).
//
//   A  `*`, `?`, classes, several levels, sorted result, `./` and a root
//   B  hidden names: not matched by `*`, matched by `.*`, GLOB_HIDDEN
//   C  `**`: zero or more directories, `lib/**`, only with GLOB_RECURSIVE
//   D  trailing `/` finds directories; literal names only have to exist
//   E  symbolic links: listed, not walked by `**` unless GLOB_FOLLOW
//   F  nothing found, unreadable directory, appending, nth / count_names
//   G  a directory of 300 files: all there, sorted
import std.rt
import std.str
import std.fs
import std.glob

static mut failures: i32 = 0
static mut root_path: rt.Buf = rt.Buf { ptr: 0, len: 0, cap: 0 }

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn fail(what: str, got: *mut rt.Buf, want: str) {
    failures = failures + 1
    say("  FAIL  ")
    say(what)
    say("\n    got  ")
    rt.write_everything(1, rt.buf_ptr(got), rt.buf_len(got))
    say("\n    want ")
    say(want)
    say("\n")
}

fn root() -> str {
    return str { p: rt.buf_data(&root_path), n: rt.buf_len(&root_path) }
}

fn full(rel: str, out: *mut rt.Buf) {
    rt.buf_push_bytes(out, root().p as u64, root().n)
    rt.buf_push(out, 47 as u8)
    rt.buf_push_bytes(out, rel.p as u64, rel.n)
}

fn touch(rel: str) {
    var p: rt.Buf = rt.buf_new()
    full(rel, &p)
    fs.write_file(str { p: rt.buf_data(&p), n: rt.buf_len(&p) }, "x".p as u64, 1) catch 0
    rt.buf_free(&p)
}

fn mkdir(rel: str) {
    var p: rt.Buf = rt.buf_new()
    full(rel, &p)
    fs.mkdir_all(str { p: rt.buf_data(&p), n: rt.buf_len(&p) }) catch false
    rt.buf_free(&p)
}

fn link(target: str, rel: str) {
    var p: rt.Buf = rt.buf_new()
    full(rel, &p)
    fs.symlink(target, str { p: rt.buf_data(&p), n: rt.buf_len(&p) }) catch false
    rt.buf_free(&p)
}

// the names of a result list joined by '|'
fn joined(out: *mut rt.Buf, n: usize, res: *mut rt.Buf) {
    var i: usize = 0
    while i < n {
        if i > 0 {
            rt.buf_push(res, 124 as u8)
        }
        let nm: str = glob.nth(out, i)
        rt.buf_push_bytes(res, nm.p as u64, nm.n)
        i = i + 1
    }
}

// expand `pat` below the temp root with `flags`; the answer has to be `want`
fn expect(pat: str, flags: u32, want: str) {
    var out: rt.Buf = rt.buf_new()
    let n: usize = glob.expand_in(root(), pat, flags, &out)
    var res: rt.Buf = rt.buf_new()
    joined(&out, n, &res)
    var what: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&what, pat.p as u64, pat.n)
    rt.buf_push_bytes(&what, "   flags ".p as u64, 9)
    rt.buf_push_dec_i64(&what, flags as i64)
    if rt.buf_len(&res) != want.n || !rt.mem_eq(rt.buf_ptr(&res), want.p as u64, want.n) || glob.count_names(&out) != n {
        fail(str { p: rt.buf_data(&what), n: rt.buf_len(&what) }, &res, want)
    }
    rt.buf_free(&what)
    rt.buf_free(&res)
    rt.buf_free(&out)
}

fn main() -> i32 {
    rt.buf_push_bytes(&root_path, "/tmp/firn-glob-test-".p as u64, 20)
    rt.buf_push_dec_i64(&root_path, syscall(39, 0, 0, 0, 0, 0, 0))
    fs.remove_tree(root()) catch false
    mkdir("")
    touch("a.json")
    touch("b.json")
    touch("c.txt")
    touch(".hidden.json")
    touch("sp ace.txt")
    mkdir(".git")
    touch(".git/config")
    mkdir("lib/x")
    touch("lib/x/one.json")
    touch("lib/x/two.txt")
    mkdir("lib/y/deep")
    touch("lib/y/three.json")
    touch("lib/y/.dot.json")
    touch("lib/y/deep/four.json")
    link("lib", "link_dir")
    link("a.json", "link_file")
    link("nowhere", "broken")

    let R: u32 = glob.GLOB_RECURSIVE
    let H: u32 = glob.GLOB_HIDDEN
    let F: u32 = glob.GLOB_FOLLOW

    // --- A
    expect("*.json", 0 as u32, "a.json|b.json")
    expect("?.json", 0 as u32, "a.json|b.json")
    expect("[ab].json", 0 as u32, "a.json|b.json")
    expect("[!a].json", 0 as u32, "b.json")
    expect("[a-a].json", 0 as u32, "a.json")
    expect("*.txt", 0 as u32, "c.txt|sp ace.txt")
    expect("lib/*/*.json", 0 as u32, "lib/x/one.json|lib/y/three.json")
    expect("lib/*/two.txt", 0 as u32, "lib/x/two.txt")
    expect("li*/x/*", 0 as u32, "lib/x/one.json|lib/x/two.txt|link_dir/x/one.json|link_dir/x/two.txt")
    expect("./*.json", 0 as u32, "./a.json|./b.json")
    expect("lib//x/*.json", 0 as u32, "lib//x/one.json")
    expect("*", 0 as u32, "a.json|b.json|broken|c.txt|lib|link_dir|link_file|sp ace.txt")

    // --- B: hidden
    expect(".*.json", 0 as u32, ".hidden.json")
    expect("*.json", H, ".hidden.json|a.json|b.json")
    expect("lib/*/*.json", H, "lib/x/one.json|lib/y/.dot.json|lib/y/three.json")
    expect(".git/*", 0 as u32, ".git/config")
    expect("*/config", 0 as u32, "")
    expect(".*/config", 0 as u32, ".git/config")
    expect("[.]git", 0 as u32, "")
    expect("[.]git", H, ".git")
    expect(".git", 0 as u32, ".git")
    expect(".hidden.json", 0 as u32, ".hidden.json")

    // --- C: **
    expect("lib/**/*.json", R, "lib/x/one.json|lib/y/deep/four.json|lib/y/three.json")
    expect("lib/**/*.json", 0 as u32, "lib/x/one.json|lib/y/three.json")
    expect("**/*.json", R, "a.json|b.json|lib/x/one.json|lib/y/deep/four.json|lib/y/three.json")
    expect("**/*.json", R | H, ".hidden.json|a.json|b.json|lib/x/one.json|lib/y/.dot.json|lib/y/deep/four.json|lib/y/three.json")
    expect("**", R, "a.json|b.json|broken|c.txt|lib|lib/x|lib/x/one.json|lib/x/two.txt|lib/y|lib/y/deep|lib/y/deep/four.json|lib/y/three.json|link_dir|link_file|sp ace.txt")
    expect("**", 0 as u32, "a.json|b.json|broken|c.txt|lib|link_dir|link_file|sp ace.txt")
    expect("lib/**", R, "lib/|lib/x|lib/x/one.json|lib/x/two.txt|lib/y|lib/y/deep|lib/y/deep/four.json|lib/y/three.json")
    expect("lib/**/", R, "lib/|lib/x/|lib/y/|lib/y/deep/")
    expect("nodir/**", R, "")
    expect("**/four.json", R, "lib/y/deep/four.json")
    // link_dir is a directory to `**/x` (the link itself is listed), but `**` does not walk below it
    expect("**/x/**/*.txt", R, "lib/x/two.txt|link_dir/x/two.txt")
    expect("lib/**/deep/*", R, "lib/y/deep/four.json")
    expect("a**", R, "a.json")

    // --- D: trailing slash, literal names
    expect("*/", 0 as u32, "lib/|link_dir/")
    expect("lib/", 0 as u32, "lib/")
    expect("lib/*/", 0 as u32, "lib/x/|lib/y/")
    expect("a.json/", 0 as u32, "")
    expect("a.json", 0 as u32, "a.json")
    expect("lib/x/one.json", 0 as u32, "lib/x/one.json")
    expect("nothing", 0 as u32, "")
    expect("lib/nothing/*", 0 as u32, "")
    expect("broken", 0 as u32, "broken")
    expect("", 0 as u32, "")

    // --- E: symbolic links
    expect("link_dir/*", 0 as u32, "link_dir/x|link_dir/y")
    expect("link_dir/*/*.json", 0 as u32, "link_dir/x/one.json|link_dir/y/three.json")
    expect("link_*", 0 as u32, "link_dir|link_file")
    expect("link_*/", 0 as u32, "link_dir/")
    expect("**/one.json", R, "lib/x/one.json")
    expect("**/one.json", R | F, "lib/x/one.json|link_dir/x/one.json")
    expect("link_dir/**", R, "link_dir/|link_dir/x|link_dir/x/one.json|link_dir/x/two.txt|link_dir/y|link_dir/y/deep|link_dir/y/deep/four.json|link_dir/y/three.json")

    // --- F: results, appending, nth, count
    var out: rt.Buf = rt.buf_new()
    let n1: usize = glob.expand_in(root(), "*.json", 0 as u32, &out)
    let n2: usize = glob.expand_in(root(), "*.txt", 0 as u32, &out)
    if n1 != 2 || n2 != 2 || glob.count_names(&out) != 4 || !glob.nth(&out, 0).equal("a.json") || !glob.nth(&out, 2).equal("c.txt") || glob.nth(&out, 4).n != 0 {
        failures = failures + 1
        say("  FAIL  appending / nth / count_names\n")
    }
    rt.buf_free(&out)

    // the current directory: expand and expand_opts
    var o2: rt.Buf = rt.buf_new()
    let n3: usize = glob.expand("/tmp/firn-glob-test-nothing-here-*", &o2)
    let n4: usize = glob.expand_opts("/tmp/firn-glob-test-nothing-here-**", R | H, &o2)
    if n3 != 0 || n4 != 0 || rt.buf_len(&o2) != 0 {
        failures = failures + 1
        say("  FAIL  an absolute pattern that finds nothing\n")
    }
    rt.buf_free(&o2)
    var o3: rt.Buf = rt.buf_new()
    var pat3: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&pat3, root().p as u64, root().n)
    rt.buf_push_bytes(&pat3, "/lib/*/three.*".p as u64, 14)
    let n5: usize = glob.expand(str { p: rt.buf_data(&pat3), n: rt.buf_len(&pat3) }, &o3)
    if n5 != 1 || glob.nth(&o3, 0).n != root().n + 17 {
        failures = failures + 1
        say("  FAIL  an absolute pattern\n")
    }
    rt.buf_free(&pat3)
    rt.buf_free(&o3)

    // --- G: 300 files
    mkdir("big")
    var k: i64 = 0
    while k < 300 {
        var nm: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&nm, "big/f".p as u64, 5)
        if k < 100 {
            rt.buf_push(&nm, 48 as u8)
        }
        if k < 10 {
            rt.buf_push(&nm, 48 as u8)
        }
        rt.buf_push_dec_i64(&nm, k)
        touch(str { p: rt.buf_data(&nm), n: rt.buf_len(&nm) })
        rt.buf_free(&nm)
        k = k + 1
    }
    var o4: rt.Buf = rt.buf_new()
    let n6: usize = glob.expand_in(root(), "big/f*", 0 as u32, &o4)
    var sorted: bool = n6 == 300
    var j: usize = 0
    while sorted && j < 300 {
        let nm2: str = glob.nth(&o4, j)
        // "big/f" + three digits of j (8 bytes)
        if nm2.n != 8 || (*(nm2.p + 5) - 48 as u8) as usize * 100 + (*(nm2.p + 6) - 48 as u8) as usize * 10 + (*(nm2.p + 7) - 48 as u8) as usize != j {
            sorted = false
        }
        j = j + 1
    }
    if !sorted {
        failures = failures + 1
        say("  FAIL  300 files, sorted\n")
    }
    rt.buf_free(&o4)

    fs.remove_tree(root()) catch false
    rt.buf_free(&root_path)
    if failures != 0 {
        return 1
    }
    return 0
}
