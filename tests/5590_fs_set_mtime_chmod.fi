// expect_exit: 0
// tests/5590_fs_set_mtime_chmod.fi -- fs.set_mtime and fs.chmod on Linux and Windows (read-only bit).
import std.io
import std.rt
import std.fs
import std.fsx
import std.str
import std.testkit

static mut DATA: [u8; 16] = [0; 16]

#[allow_escape]
fn work() -> FsError!bool {
    var d: fsx.TempDir = try fsx.temp_dir("mtime_chmod_")
    defer fsx.temp_dir_drop(&d)
    let root: str = fsx.temp_dir_path(&d)
    let file: str = io.fmt_string(f"{root}/a.bin")
    let sub: str = io.fmt_string(f"{root}/sub")
    try fs.write_file(file, (&DATA[0]) as u64, 16 as usize)
    try fs.mkdir(sub)

    try fs.set_mtime(file, 1000000, true)
    var info: fs.FileInfo = try fs.stat(file)
    testkit.check(info.mtime_ns == 1000000 * 1000000000, "file mtime set")
    testkit.check(info.size == (16 as u64), "size untouched")

    try fs.set_mtime(file, 1700000123, true)
    info = try fs.stat(file)
    testkit.check(info.mtime_ns == 1700000123 * 1000000000, "file mtime set again")

    try fs.set_mtime(sub, 2000000, true)
    var dinfo: fs.FileInfo = try fs.stat(sub)
    testkit.check(dinfo.mtime_ns == 2000000 * 1000000000, "directory mtime set")
    testkit.check(dinfo.kind == fs.KIND_DIR, "still a directory")

    testkit.check((fs.set_mtime(io.fmt_string(f"{root}/missing"), 5, true) catch | e | false) == false, "missing path is an error")

    try fs.chmod(file, 292 as u32)
    info = try fs.stat(file)
    testkit.check((info.mode & 146 as u32) == (0 as u32), "read-only: no write bits")
    testkit.check((info.mode & 292 as u32) == (292 as u32), "read-only: read bits stay")
    testkit.check(info.mtime_ns == 1700000123 * 1000000000, "mtime survives chmod")

    try fs.chmod(file, 420 as u32)
    info = try fs.stat(file)
    testkit.check((info.mode & 128 as u32) == (128 as u32), "writable again")
    try fs.write_file(file, (&DATA[0]) as u64, 8 as usize)
    info = try fs.stat(file)
    testkit.check(info.size == (8 as u64), "rewrite after chmod")

    try fs.chmod(sub, 493 as u32)
    dinfo = try fs.stat(sub)
    testkit.check(dinfo.kind == fs.KIND_DIR, "chmod on directory ok")
    testkit.check((fs.chmod(io.fmt_string(f"{root}/missing"), 420 as u32) catch | e | false) == false, "chmod missing is an error")
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    testkit.check(work() catch | e | false, "work ran")
    return testkit.finish()
}
