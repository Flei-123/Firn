import media.video.av1.av1blkst
import media.video.av1.av1intermode

// expect_exit: 0

fn main() -> i32 {
    var bad: i64 = 0
    if av1intermode.compound_mode_ctx(0) != 0 {
        bad = bad + 1
    }
    if av1intermode.compound_mode_ctx((4 << 4) | 3) != 6 {
        bad = bad + 2
    }
    if av1intermode.compound_mode_ctx((5 << 4) | 7) != 7 {
        bad = bad + 4
    }
    if av1intermode.compound_mode_ctx((2 << 4) | 1) != 2 {
        bad = bad + 8
    }
    let td: *mut av1blkst.TileDec = av1blkst.td_new()
    (*td).stack_w[0] = 700
    (*td).stack_w[1] = 700
    (*td).stack_w[2] = 700
    (*td).stack_w[3] = 10
    (*td).stack_w[4] = 10
    if av1intermode.drl_ctx(td, 0) != 0 {
        bad = bad + 16
    }
    if av1intermode.drl_ctx(td, 2) != 1 {
        bad = bad + 32
    }
    if av1intermode.drl_ctx(td, 3) != 2 {
        bad = bad + 64
    }
    return bad as i32
}
