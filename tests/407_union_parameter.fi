// expect_exit: 0
// Fehlerunion als Parameter; beim Aufruf wird implizit umgewandelt.
error E { A, B }

fn nimm(r: E!i32) -> i32 {
    return r catch 0 - 1
}

fn quelle(n: i32) -> E!i32 {
    if n == 0 {
        return E::A
    }
    return n
}

fn main() -> i32 {
    if nimm(7) != 7 {
        return 1
    }
    if nimm(E::B) != 0 - 1 {
        return 2
    }
    if nimm(quelle(3)) != 3 {
        return 3
    }
    if nimm(quelle(0)) != 0 - 1 {
        return 4
    }
    return 0
}
