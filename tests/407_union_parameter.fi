// expect_exit: 0
// Error union as a parameter; the call converts implicitly.
error E { A, B }

fn take(r: E!i32) -> i32 {
    return r catch 0 - 1
}

fn source(n: i32) -> E!i32 {
    if n == 0 {
        return E::A
    }
    return n
}

fn main() -> i32 {
    if take(7) != 7 {
        return 1
    }
    if take(E::B) != 0 - 1 {
        return 2
    }
    if take(source(3)) != 3 {
        return 3
    }
    if take(source(0)) != 0 - 1 {
        return 4
    }
    return 0
}
