// expect_exit: 0
// Safety: literal operands inside the valid range are not rejected: divisor 1, modulus 7, shift counts 0 and bits-1, float division by 0.0.
fn main() -> i32 {
    var a: i32 = 100
    var b: u32 = 1
    var c: u64 = 1
    var f: f64 = 1.0
    a = a / 1
    a = a % 7
    b = b << 31
    b = b >> 31
    c = c << 63
    c = c >> 0
    c >>= 63
    f = f / 0.0
    if a != 2 { return 1 }
    if b != 1 { return 2 }
    if c != 1 { return 3 }
    if f < 1.0e300 { return 4 }
    return 0
}
