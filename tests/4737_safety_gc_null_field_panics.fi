// expect_exit: 101
// wasm_skip: a null dereference is harmless in the wasm linear memory
// only_target: x86_64
// N2 closed: reading a field of a null Gc[T] ends with exit code 101.
gc class N { v: u64 }

fn main() -> i32 {
    if !gc_init() { return 9 }
    let n: Gc[N] = gc_null[N]()
    return n.v as i32
}
