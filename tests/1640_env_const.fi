// expect_out: FreeViewer|FreeViewer 1.0|stock|10|FreeViewer|ok
// ROUND FIRN-ENV -- environment variables AT BUILD TIME, and `const` with a
// text.
//
// The occasion was a branded build in the OrientOS tree. In Rust it reads
//
//     pub const NAME: &str = match option_env!("FV_BRAND_NAME") {
//         Some(s) => s, None => "FreeViewer" };
//
// and in Firn it read `tools/marke-einsetzen.py`: a script that wrote the
// values into a COPY of the source text before translating, because "Firn
// knows no option_env!, so the build does it". Since this round the
// language does it.
//
// WHAT IS CHECKED HERE is the case WITHOUT the variable: the written
// default comes out, and it comes out as a real `str`. The other case --
// the variable IS set -- needs a second translation of the same file with a
// different environment and therefore stands in `tools/env/run.sh`, which
// runs BOTH compilers over both cases and compares.
//
// The name deliberately carries the prefix `FIRN_`: it is the only one
// permitted without `--env-allow`, so this file translates the same way in
// every driver of the corpus (compiler/src/env.rs).
import std.io

// The whole point of the round: `__env_or` in a `const`, and a `const` of
// type `str` at all. Both were errors before this round.
const NAME: str = __env_or("FIRN_TEST_BRAND", "FreeViewer")
const VERSION: str = "1.0"
// A text constant is COMPUTED at compile time: `+` puts the octets one
// after another, and it means at compile time what it means at run time.
const TITLE: str = NAME + " " + VERSION
const BRANDED: bool = __env_has("FIRN_TEST_BRAND")

fn main() -> i32 {
    io.print(NAME)
    io.print("|")
    io.print(TITLE)
    io.print("|")
    if BRANDED {
        io.print("branded")
    } else {
        io.print("stock")
    }
    io.print("|")
    // It is a real `str`, not a special case that only `print` knows: the
    // string library reaches it through its methods.
    let n: i64 = NAME.length() as i64
    io.fmt_print(f"{n}")
    io.print("|")
    // A local of the same spelling still wins, exactly as it does for a
    // number constant.
    let NAME: str = "FreeViewer"
    io.print(NAME)
    io.print("|")
    // The content is the content: what the compiler folded and what a
    // written literal produces are the same octets.
    if TITLE == "FreeViewer 1.0" {
        io.print_line("ok")
    } else {
        io.print_line("DIFFERENT")
    }
    return 0
}
