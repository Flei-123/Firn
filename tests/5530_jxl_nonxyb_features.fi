// expect_exit: 0
import jxl.jxl
import std.fs
import std.rt

static mut failures: i32 = 0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn body_offset(d: *mut rt.Buf, n: usize, lines: u32) -> usize {
    var nl: u32 = 0
    var i: usize = 0
    while i < n && nl < lines {
        if rt.ld8(rt.buf_ptr(d), i) == 10 {
            nl = nl + 1
        }
        i = i + 1
    }
    return i
}

fn expect(name: str, max_diff: i32) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(name + ".jxl", &data) catch 0
    var ref: rt.Buf = rt.buf_new()
    let rn: usize = fs.read_file(name + ".ppm", &ref) catch 0
    check(n != 0 && rn != 0)
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let ok: bool = jxl.jxl_decode(rt.buf_ptr(&data), n, &pic) catch false
    check(ok)
    if ok {
        let off: usize = body_offset(&ref, rn, 3)
        check(pic.channels == 3 && pic.bytes_per_sample == 1 && rn - off == pic.size)
        if rn - off == pic.size {
            var worst: i32 = 0
            var i: usize = 0
            while i < pic.size {
                var d: i32 = (rt.ld8(pic.data, i) as i32) - (rt.ld8(rt.buf_ptr(&ref), off + i) as i32)
                if d < 0 {
                    d = 0 - d
                }
                if d > worst {
                    worst = d
                }
                i = i + 1
            }
            check(worst <= max_diff)
        }
    }
    jxl.jxl_picture_free(&pic)
    rt.buf_free(&data)
    rt.buf_free(&ref)
}

fn main() -> i32 {
    expect("tests/data/jxl/nx/text_patches", 0)
    expect("tests/data/jxl/nx/text_patches_e9", 0)
    expect("tests/data/jxl/nx/text_noise800", 1)
    expect("tests/data/jxl/nx/text_noise6400", 1)
    expect("tests/data/jxl/nx/s300x200_noise1600", 1)
    expect("tests/data/jxl/nx/s600x300_noise3200", 1)
    expect("tests/data/jxl/nx/t37x29_noise3200", 1)
    expect("tests/data/jxl/nx/s64_noise100", 1)
    return failures
}
