// expect_exit: 0
// tests/3961_mc_model_pick.fi -- pick table for pack models (lib/mc/mc_model_pick.fi, r236b): rays hit the baked quads of model cells (stairs, weighted slab,
// cross plant) instead of the whole voxel, pass through the empty part of a model cell, ignore the table's pick flag for model cells, report the quad
// distance and a unit face normal, give model bounds for the selection box; without model cells the result equals mc_input.input_pick bit for bit.
// The pack is built in-process from own JSON (no Mojang file).
import std.rt
import std.math
import zip.zip
import mc.mc_assets
import mc.mc_texture
import mc.mc_texext
import mc.mc_mesh
import mc.mc_model
import mc.mc_model_mesh
import mc.mc_model_pick
import mc.mc_input
import mc.mc_registry
import mc.mc_render_world
import mc.mc_version
import mc.mc_versions
import mc.mc_world

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn add(w: *mut zip.ZipWriter, name: str, s: str) -> bool {
    var ok: bool = zip.zip_add(w, name, s.p as u64, s.length(), true) catch | e | (false)
    return ok
}

const META: str = "{\"pack\":{\"pack_format\": 15, \"description\":\"t\"}}"
const TEXOAK: str = "\"textures\":{\"bottom\":\"minecraft:block/oak_planks\",\"top\":\"block/oak_planks\",\"side\":\"block/oak_planks\"}"

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.0001
}

fn build_pack(st: *mut mc_assets.PackStack) -> bool {
    var b: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&b)
    if !add(&w, "pack.mcmeta", META) { return false }
    if !add(&w, "assets/minecraft/models/block/mp_stairs.json", "{\"parent\":\"block/stairs\"," + TEXOAK + "}") { return false }
    if !add(&w, "assets/minecraft/blockstates/oak_stairs.json", "{\"variants\":{\"shape=straight\":{\"model\":\"block/mp_stairs\"}}}") { return false }
    if !add(&w, "assets/minecraft/models/block/mp_slab_b.json", "{\"parent\":\"block/slab\"," + TEXOAK + "}") { return false }
    if !add(&w, "assets/minecraft/models/block/mp_slab_t.json", "{\"parent\":\"block/slab_top\"," + TEXOAK + "}") { return false }
    if !add(&w, "assets/minecraft/blockstates/oak_slab.json", "{\"variants\":{\"\":[{\"model\":\"block/mp_slab_b\"},{\"model\":\"block/mp_slab_t\"}]}}") { return false }
    if !add(&w, "assets/minecraft/models/block/mp_cross.json", "{\"parent\":\"block/cross\",\"textures\":{\"cross\":\"minecraft:block/oak_planks\"}}") { return false }
    if !add(&w, "assets/minecraft/blockstates/dead_bush.json", "{\"variants\":{\"\":{\"model\":\"block/mp_cross\"}}}") { return false }
    var n: usize = zip.zip_finish(&w) catch | e | (0)
    zip.zip_writer_free(&w)
    if n == 0 { return false }
    var p: mc_assets.Pack = mc_assets.pack_empty()
    if mc_assets.pack_open_mem(&p, rt.buf_ptr(&b), rt.buf_len(&b)) != mc_assets.ASSET_OK { return false }
    rt.buf_free(&b)
    return mc_assets.stack_push(st, &p) == mc_assets.ASSET_OK
}

fn put(ids: u64, x: i32, y: i32, z: i32, id: u16) {
    rt.st16(ids, (((y + 64) * 16 + z) * 16 + x) as usize, id)
}

fn pk() -> mc_input.Pick { return mc_input.Pick { x: 0, y: 0, z: 0, nx: 0, ny: 0, nz: 0, dist: 0.0, id: 0 } }

fn unit(p: *mut mc_input.Pick) -> bool {
    var a: i32 = (*p).nx
    var b: i32 = (*p).ny
    var c: i32 = (*p).nz
    if a < 0 { a = 0 - a }
    if b < 0 { b = 0 - b }
    if c < 0 { c = 0 - c }
    return a + b + c == 1
}

fn main() -> i32 {
    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 1)
    var reg: mc_registry.Registry = v.registry_of()
    check(mc_registry.registry_ok(&reg), 2)
    var st: mc_assets.PackStack = mc_assets.stack_new()
    check(build_pack(&st), 3)
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_texture.tex_alloc_tables(&tb)
    var ex: mc_texext.TexExt = mc_texext.texext_new()
    mc_texext.tex_build_tables_ext(&reg, &tb, &ex)
    var ms: mc_model_mesh.ModelSet = mc_model_mesh.ms_new(&reg, &st, &ex)

    let b_st: i32 = mc_registry.reg_block_by_name(&reg, "oak_stairs".p as u64, 10)
    let b_sl: i32 = mc_registry.reg_block_by_name(&reg, "oak_slab".p as u64, 8)
    let b_bu: i32 = mc_registry.reg_block_by_name(&reg, "dead_bush".p as u64, 9)
    check(b_st >= 0 && b_sl >= 0 && b_bu >= 0, 4)
    let s_st: u16 = mc_registry.reg_block_min_state(&reg, b_st) as u16 // shape=straight
    let s_sl: u16 = mc_registry.reg_block_min_state(&reg, b_sl) as u16
    let s_bu: u16 = mc_registry.reg_block_min_state(&reg, b_bu) as u16
    check(mc_model_mesh.ms_kind(&ms, s_st) == mc_model_mesh.K_MODEL && mc_model_mesh.ms_kind(&ms, s_sl) == mc_model_mesh.K_MODEL, 5)
    check(mc_model_mesh.ms_kind(&ms, s_bu) == mc_model_mesh.K_MODEL, 6)
    check(ms.unmapped == 0, 7)

    // ---- world: chunk (0, 0), y = -64 .. -33; model blocks on y = -60
    var w: mc_world.World = mc_world.world_new()
    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    put(ids, 2, 0 - 60, 2, s_st) // stairs, upper step on the east half (model block/stairs, no rotation)
    put(ids, 2, 0 - 60, 3, s_sl) // slab: bottom or top by position (weighted)
    put(ids, 5, 0 - 60, 3, 1 as u16) // stone behind the slab
    put(ids, 2, 0 - 60, 6, s_bu) // cross plant
    put(ids, 5, 0 - 60, 6, 1 as u16) // stone behind the plant
    var x: i32 = 0
    while x < 16 {
        put(ids, x, 0 - 60, 8, s_sl) // slab row for the variant check
        x = x + 1
    }
    check(mc_world.world_put(&w, mc_render_world.wr_make_chunk(0, 0, 2, ids)), 8)
    var it: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(32768), solid: rt.heap_alloc(65536), n: 32768 }
    i = 0
    while i < 32768 {
        rt.st8(it.pick, i, 0 as u8)
        rt.st16(it.solid, i, 0 as u16)
        i = i + 1
    }
    rt.st8(it.pick, 1, 1 as u8)
    rt.st8(it.pick, s_st as usize, 1 as u8)
    rt.st8(it.pick, s_sl as usize, 1 as u8)
    rt.st8(it.pick, s_bu as usize, 1 as u8)
    let min_y: i32 = 0 - 64

    // ---- 1. stairs: through the air above the lower half, into the upper step (voxel pick would stop at the cell border, t = 1.5)
    var h: mc_input.Pick = pk()
    check(mc_model_pick.mp_pick(&w, min_y, &it, &ms, 0.5, 0.0 - 59.25, 2.5, 1.0, 0.0, 0.0, 10.0, &h), 10)
    check(h.x == 2 && h.y == 0 - 60 && h.z == 2 && h.id == s_st as i32, 11)
    check(near(h.dist, 2.0) && h.nx == 0 - 1 && h.ny == 0 && h.nz == 0, 12) // west face of the step at x = 2.5
    var hv: mc_input.Pick = pk()
    check(mc_input.input_pick(&w, min_y, &it, 0.5, 0.0 - 59.25, 2.5, 1.0, 0.0, 0.0, 10.0, &hv), 13)
    check(near(hv.dist, 1.5) && hv.x == 2, 14) // the old voxel pick: the whole cell
    // lower half: same distance as the cell border
    check(mc_model_pick.mp_pick(&w, min_y, &it, &ms, 0.5, 0.0 - 59.75, 2.5, 1.0, 0.0, 0.0, 10.0, &h), 15)
    check(near(h.dist, 1.5) && h.nx == 0 - 1, 16)
    // from above: the lower half's top at y = 0.5, the step's top at y = 1.0
    check(mc_model_pick.mp_pick(&w, min_y, &it, &ms, 2.25, 0.0 - 55.0, 2.5, 0.0, 0.0 - 1.0, 0.0, 10.0, &h), 17)
    check(near(h.dist, 4.5) && h.ny == 1 && h.x == 2 && h.y == 0 - 60, 18)
    check(mc_model_pick.mp_pick(&w, min_y, &it, &ms, 2.75, 0.0 - 55.0, 2.5, 0.0, 0.0 - 1.0, 0.0, 10.0, &h), 19)
    check(near(h.dist, 4.0) && h.ny == 1, 20)
    // reach: the step is 2.0 away
    check(!mc_model_pick.mp_pick(&w, min_y, &it, &ms, 0.5, 0.0 - 59.25, 2.5, 1.0, 0.0, 0.0, 1.9, &h), 21)
    check(mc_model_pick.mp_pick(&w, min_y, &it, &ms, 0.5, 0.0 - 59.25, 2.5, 1.0, 0.0, 0.0, 2.1, &h), 22)
    // the table's pick flag does not matter for model cells (the mesher clears the tiles of model states)
    rt.st8(it.pick, s_st as usize, 0 as u8)
    check(mc_model_pick.mp_pick(&w, min_y, &it, &ms, 0.5, 0.0 - 59.25, 2.5, 1.0, 0.0, 0.0, 10.0, &h), 23)
    check(h.x == 2 && near(h.dist, 2.0), 24)
    rt.st8(it.pick, s_st as usize, 1 as u8)

    // ---- 2. slab by position: a ray straight down hits y = 0.5 (bottom) or y = 1.0 (top); bounds agree; the miss case passes through to the stone
    var nb: i32 = 0
    var nt: i32 = 0
    x = 0
    while x < 16 {
        var bx: mc_model_pick.MpBox = mc_model_pick.MpBox { x0: 0.0, y0: 0.0, z0: 0.0, x1: 0.0, y1: 0.0, z1: 0.0 }
        check(mc_model_pick.mp_bounds(&ms, s_sl as i32, x, 0 - 60, 8, &bx), 30)
        check(mc_model_pick.mp_pick(&w, min_y, &it, &ms, (x as f64) + 0.5, 0.0 - 55.0, 8.5, 0.0, 0.0 - 1.0, 0.0, 10.0, &h), 31)
        check(h.x == x && h.y == 0 - 60 && h.ny == 1 && near(h.dist, 5.0 - bx.y1), 32)
        if near(bx.y1, 0.5) { nb = nb + 1 } else if near(bx.y1, 1.0) { nt = nt + 1 }
        x = x + 1
    }
    check(nb > 0 && nt > 0 && nb + nt == 16, 34) // both variants appear along the row
    // slab at (2, 3): the ray at y = 0.75 passes through a bottom slab and hits the stone at x = 5, or stops at the top slab's west face
    var bs: mc_model_pick.MpBox = mc_model_pick.MpBox { x0: 0.0, y0: 0.0, z0: 0.0, x1: 0.0, y1: 0.0, z1: 0.0 }
    check(mc_model_pick.mp_bounds(&ms, s_sl as i32, 2, 0 - 60, 3, &bs), 35)
    check(mc_model_pick.mp_pick(&w, min_y, &it, &ms, 0.5, 0.0 - 59.25, 3.5, 1.0, 0.0, 0.0, 10.0, &h), 36)
    if near(bs.y1, 0.5) {
        check(h.x == 5 && h.id == 1 && near(h.dist, 4.5) && h.nx == 0 - 1, 37)
    } else {
        check(h.x == 2 && near(h.dist, 1.5) && h.nx == 0 - 1, 38)
    }

    // ---- 3. cross plant: the diagonal quads are hit where they are, the empty corners of the cell let the ray through
    check(mc_model_pick.mp_pick(&w, min_y, &it, &ms, 0.5, 0.0 - 59.5, 6.3, 1.0, 0.0, 0.0, 10.0, &h), 40)
    check(h.x == 2 && h.z == 6 && h.id == s_bu as i32 && near(h.dist, 1.8) && unit(&h), 41) // plane z - 6.5 = -(x - 2.5) at x = 2.3
    check(mc_input.input_pick(&w, min_y, &it, 0.5, 0.0 - 59.5, 6.3, 1.0, 0.0, 0.0, 10.0, &hv), 42)
    check(near(hv.dist, 1.5), 43)
    check(mc_model_pick.mp_pick(&w, min_y, &it, &ms, 0.5, 0.0 - 59.5, 6.02, 1.0, 0.0, 0.0, 10.0, &h), 44)
    check(h.x == 5 && h.id == 1 && near(h.dist, 4.5) && h.nx == 0 - 1, 45) // beyond the plane tips (0.05 .. 0.95): on to the stone
    // from the south (+z) at x = 2.3: the planes cross it at z = 6.7 and 6.3, the nearer one is hit
    check(mc_model_pick.mp_pick(&w, min_y, &it, &ms, 2.3, 0.0 - 59.5, 7.9, 0.0, 0.0, 0.0 - 1.0, 10.0, &h), 46)
    check(h.x == 2 && h.z == 6 && near(h.dist, 1.2) && unit(&h), 47)

    // ---- 4. selection box bounds
    var bb: mc_model_pick.MpBox = mc_model_pick.MpBox { x0: 9.0, y0: 9.0, z0: 9.0, x1: 9.0, y1: 9.0, z1: 9.0 }
    check(mc_model_pick.mp_bounds(&ms, s_st as i32, 2, 0 - 60, 2, &bb), 50)
    check(near(bb.x0, 0.0) && near(bb.y0, 0.0) && near(bb.z0, 0.0) && near(bb.x1, 1.0) && near(bb.y1, 1.0) && near(bb.z1, 1.0), 51)
    check(mc_model_pick.mp_bounds(&ms, s_bu as i32, 2, 0 - 60, 6, &bb), 52)
    check(bb.x0 > 0.0 && bb.x1 < 1.0 && near(bb.y0, 0.0) && near(bb.y1, 1.0) && bb.z0 > 0.0 && bb.z1 < 1.0, 53)
    check(!mc_model_pick.mp_bounds(&ms, 1, 5, 0 - 60, 3, &bb), 54) // stone: not a model
    check(!mc_model_pick.mp_bounds(&ms, 0, 0, 0, 0, &bb), 55) // air

    // ---- 4b. selection box for GL / Vulkan (r248): world box + 12 edge boxes, same geometry as mp_draw_box
    var pkx: mc_input.Pick = mc_input.Pick { x: 2, y: 0 - 60, z: 3, nx: 0, ny: 0, nz: 0, dist: 0.0, id: s_sl as i32 }
    var wb: mc_model_pick.MpBox = mc_model_pick.MpBox { x0: 9.0, y0: 9.0, z0: 9.0, x1: 9.0, y1: 9.0, z1: 9.0 }
    mc_model_pick.mp_pick_box(&ms, &pkx, &wb)
    check(near(wb.x0, 2.0) && near(wb.x1, 3.0) && near(wb.z0, 3.0) && near(wb.z1, 4.0) && near(wb.y0, 0.0 - 60.0) && near(wb.y1, 0.0 - 60.0 + bs.y1), 56)
    pkx.id = 1 // stone: unit cube
    mc_model_pick.mp_pick_box(&ms, &pkx, &wb)
    check(near(wb.x0, 2.0) && near(wb.y1, 0.0 - 59.0) && near(wb.z1, 4.0), 57)
    pkx.id = s_sl as i32
    mc_model_pick.mp_pick_box(&ms, &pkx, &wb)
    var eg: mc_model_pick.MpEdge = mc_model_pick.MpEdge { cx: 0.0, cy: 0.0, cz: 0.0, sx: 0.0, sy: 0.0, sz: 0.0 }
    var ei: i32 = 0
    var nlong: i32 = 0
    while ei < 12 {
        mc_model_pick.mp_sel_edge(&wb, 0.03, ei, &eg)
        // every edge box lies on the box edges: centre on a face plane in the two short axes, thickness 0.03 there, length = extent + 0.03 along its axis
        let ax: i32 = ei / 4
        if ax == 0 { check(near(eg.sx, 1.03) && near(eg.sy, 0.03) && near(eg.sz, 0.03) && near(eg.cx, 2.5), 58) }
        if ax == 1 { check(near(eg.sy, bs.y1 + 0.03) && near(eg.sx, 0.03) && near(eg.cy, wb.y0 + bs.y1 * 0.5), 59) }
        if ax == 2 { check(near(eg.sz, 1.03) && near(eg.cz, 3.5), 60) }
        check((near(eg.cx, 2.0) || near(eg.cx, 3.0) || ax == 0) && (near(eg.cy, wb.y0) || near(eg.cy, wb.y1) || ax == 1) && (near(eg.cz, 3.0) || near(eg.cz, 4.0) || ax == 2), 61)
        nlong = nlong + 1
        ei = ei + 1
    }
    check(nlong == 12, 62)

    // ---- 5. default equivalence: without model cells in the way mp_pick == input_pick bit for bit (hits, misses, origin inside a block, unloaded)
    var w2: mc_world.World = mc_world.world_new()
    let ids2: u64 = rt.heap_alloc(2 * 4096 * 2)
    i = 0
    while i < 8192 {
        rt.st16(ids2, i, 0 as u16)
        i = i + 1
    }
    var seed: u64 = 12345 as u64
    i = 0
    while i < 900 {
        seed = (seed *% 6364136223846793005 as u64) +% 1442695040888963407 as u64
        let at: usize = ((seed >> (33 as u8)) % (4096 as u64)) as usize
        rt.st16(ids2, at, 1 as u16)
        i = i + 1
    }
    check(mc_world.world_put(&w2, mc_render_world.wr_make_chunk(0, 0, 2, ids2)), 60)
    var same: i32 = 0
    var hits: i32 = 0
    i = 0
    while i < 400 {
        seed = (seed *% 6364136223846793005 as u64) +% 1442695040888963407 as u64
        let ox: f64 = (((seed >> (20 as u8)) % (2400 as u64)) as f64) / 100.0 - 4.0
        let oy: f64 = (((seed >> (30 as u8)) % (800 as u64)) as f64) / 100.0 - 64.0
        let oz: f64 = (((seed >> (40 as u8)) % (2400 as u64)) as f64) / 100.0 - 4.0
        let dx: f64 = (((seed >> (7 as u8)) % (2001 as u64)) as f64) / 1000.0 - 1.0
        let dy: f64 = (((seed >> (50 as u8)) % (2001 as u64)) as f64) / 1000.0 - 1.0
        let dz: f64 = (((seed >> (13 as u8)) % (2001 as u64)) as f64) / 1000.0 - 1.0
        var a: mc_input.Pick = pk()
        var c: mc_input.Pick = pk()
        let ra: bool = mc_input.input_pick(&w2, min_y, &it, ox, oy, oz, dx, dy, dz, 6.0, &a)
        let rc: bool = mc_model_pick.mp_pick(&w2, min_y, &it, &ms, ox, oy, oz, dx, dy, dz, 6.0, &c)
        if ra != rc { return 70 }
        if ra {
            hits = hits + 1
            if a.x != c.x || a.y != c.y || a.z != c.z || a.nx != c.nx || a.ny != c.ny || a.nz != c.nz || a.id != c.id { return 71 }
            if !(a.dist == c.dist) { return 72 }
        }
        same = same + 1
        i = i + 1
    }
    check(same == 400 && hits > 40, 73)
    return 0
}
