// expect_out: mc_piston_uv_dump ok
import std.rt
import std.io
import std.env
import mc.mc_assets
import mc.mc_model
import mc.mc_vanilla

fn scaled(v: f64) -> i32 {
    var x: f64 = v * 1000.0
    if x < 0.0 { return (0.0 - ((0.0 - x) + 0.5)) as i32 }
    return (x + 0.5) as i32
}

fn dump_state(st: *mut mc_assets.PackStack, block: str, props: str) -> i32 {
    var b: mc_model.Baked = mc_model.baked_new()
    let n: i32 = mc_model.blockstate_bake(st, block, props, 0 as u32, &b)
    io.fmt_print(f"STATE {block} {props} quads={n}\n")
    var i: usize = 0
    while i < mc_model.baked_count(&b) {
        var tn: mc_model.Name = mc_model.name_new()
        let ti: usize = mc_model.baked_f(&b, i, mc_model.W_TEX) as usize
        mc_model.baked_tex_name(&b, ti, &tn)
        io.fmt_print(f"Q dir={scaled(mc_model.baked_f(&b, i, mc_model.W_DIR))} cull={scaled(mc_model.baked_f(&b, i, mc_model.W_CULL))} tex={ti}\n")
        var c: usize = 0
        while c < 4 {
            io.fmt_print(f"V {scaled(mc_model.baked_f(&b, i, mc_model.X0 + c))} {scaled(mc_model.baked_f(&b, i, mc_model.Y0 + c))} {scaled(mc_model.baked_f(&b, i, mc_model.Z0 + c))} {scaled(mc_model.baked_f(&b, i, mc_model.U0 + c))} {scaled(mc_model.baked_f(&b, i, mc_model.V0 + c))}\n")
            c = c + 1
        }
        i = i + 1
    }
    var t: usize = 0
    while t < mc_model.baked_tex_count(&b) {
        var tn: mc_model.Name = mc_model.name_new()
        mc_model.baked_tex_name(&b, t, &tn)
        io.fmt_print(f"T {t}")
        var k: usize = 0
        while k < tn.n {
            io.fmt_print(f" {rt.ld8(mc_model.name_ptr(&tn), k) as i32}")
            k = k + 1
        }
        io.fmt_print(f"\n")
        t = t + 1
    }
    mc_model.baked_free(&b)
    return n
}

fn main() -> i32 {
    if !env.has("MC_VANILLA_JAR") || !env.has("PISTON_DUMP") {
        io.fmt_print(f"mc_piston_uv_dump ok\n")
        return 0
    }
    var st: mc_assets.PackStack = mc_assets.stack_new()
    var pk: mc_assets.Pack = mc_assets.pack_empty()
    var path: rt.Buf = rt.buf_new()
    if mc_vanilla.vanilla_ensure(763, &path) != mc_vanilla.VANILLA_OK { return 1 }
    if mc_assets.pack_open_file(&pk, rt.buf_str(&path)) != mc_assets.ASSET_OK { return 2 }
    mc_assets.stack_push(&st, &pk)
    dump_state(&st, "piston", "extended=false,facing=down")
    dump_state(&st, "piston", "extended=true,facing=down")
    dump_state(&st, "sticky_piston", "extended=false,facing=down")
    dump_state(&st, "piston", "extended=false,facing=up")
    dump_state(&st, "piston", "extended=true,facing=up")
    dump_state(&st, "sticky_piston", "extended=false,facing=up")
    dump_state(&st, "piston", "extended=false,facing=north")
    dump_state(&st, "piston", "extended=true,facing=north")
    dump_state(&st, "sticky_piston", "extended=false,facing=north")
    dump_state(&st, "piston", "extended=false,facing=south")
    dump_state(&st, "piston", "extended=true,facing=south")
    dump_state(&st, "sticky_piston", "extended=false,facing=south")
    dump_state(&st, "piston", "extended=false,facing=west")
    dump_state(&st, "piston", "extended=true,facing=west")
    dump_state(&st, "sticky_piston", "extended=false,facing=west")
    dump_state(&st, "piston", "extended=false,facing=east")
    dump_state(&st, "piston", "extended=true,facing=east")
    dump_state(&st, "sticky_piston", "extended=false,facing=east")
    return 0
}
