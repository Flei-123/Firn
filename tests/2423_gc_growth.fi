// expect_exit: 0
// The growth factor of the allocation budget (`gc_set_growth`): after a run the
// next one starts when `live * num / den` octets have been allocated. The
// default is 1/1; a program that trades memory for speed (Certus) raises it.
//
// The check is deterministic -- it counts collection runs for the same
// allocation pattern and does not look at a clock:
//   * the default is 1/1, reading it back works, 0/0 restores it,
//   * with 4/1 the same allocation pattern needs clearly fewer runs than with
//     the default (the live set is large enough to leave the minimum budget),
//   * the chain that is kept alive stays complete either way.

gc class Node {
    next: Gc[Node],
    value: u64,
}

fn chain(n: u64) -> AllocError!Gc[Node] {
    var head: Gc[Node] = gc_null[Node]()
    var i: u64 = 0
    while i < n {
        head = try gc Node { next: head, value: i }
        i = i + 1
    }
    return head
}

fn garbage(rounds: u64) -> AllocError!u64 {
    // short lived chains: only the collector's budget decides how often it runs
    var r: u64 = 0
    var sum: u64 = 0
    while r < rounds {
        let g: Gc[Node] = try chain(2000)
        sum = sum + g.value
        r = r + 1
    }
    return sum
}

fn count(head: Gc[Node]) -> u64 {
    var n: u64 = 0
    var p: Gc[Node] = head
    while p != gc_null[Node]() {
        n = n + 1
        p = p.next
    }
    return n
}

// Runs for `rounds` rounds of garbage on top of a live chain of 100 000 nodes.
fn runs_with(num: u64, den: u64) -> u64 {
    gc_set_growth(num, den)
    let live = chain(100000) catch gc_null[Node]()
    if live == gc_null[Node]() {
        return 0
    }
    gc_collect()
    let before: u64 = gc_collections()
    let total = garbage(1500) catch 0
    if total == 0 {
        return 0
    }
    let after: u64 = gc_collections()
    if count(live) != 100000 {
        return 0
    }
    return after - before
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    // default and read back
    if gc_growth_num() != 1 || gc_growth_den() != 1 {
        return 1
    }
    gc_set_growth(3, 2)
    if gc_growth_num() != 3 || gc_growth_den() != 2 {
        return 2
    }
    // 0/0 (or any zero) restores the default
    gc_set_growth(0, 0)
    if gc_growth_num() != 1 || gc_growth_den() != 1 {
        return 3
    }
    gc_set_growth(5, 0)
    if gc_growth_num() != 1 || gc_growth_den() != 1 {
        return 4
    }

    let normal: u64 = runs_with(1, 1)
    if normal == 0 {
        return 5
    }
    let wide: u64 = runs_with(4, 1)
    if wide == 0 && normal < 2 {
        return 6
    }
    // 1500 rounds of 2000 nodes (~96 MB of garbage) against a 3 MB live set:
    // the default budget is the live set, 4/1 gives four times as much.
    if wide * 2 > normal {
        return 7
    }
    gc_set_growth(0, 0)
    return 0
}
