// expect_exit: 0
import std.rt
import mc.mc_precip
import mc.mc_registry
import mc.mc_world
import mc.mc_chunk
import mc.mc_render_world
import mc.mc_splash
import mc.mc_splash_draw
import mc.mc_entity_draw
import mc.mc_camera
import mc.mc_raster
import mc.mc_backend
import mc.mc_texture
import mc.v763.mc_reg_v763

const CLEAR: u32 = 0xFF102030

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn word(rec: u64, i: usize) -> f64 {
    return *((rec + (i as u64) * (8 as u64)) as *mut f64)
}

fn run_rain(s: *mut mc_splash.Splash, p: *mut mc_precip.Precip, w: *mut mc_world.World, reg: *mut mc_registry.Registry,
    rain: i32, kind: i32, from_ms: u64, steps: i32) -> u64 {
    var t: u64 = from_ms
    var i: i32 = 0
    while i < steps {
        mc_splash.splash_update(s, p, w, reg, 0, 4.5, 12.0, 5.5, rain, kind, t)
        t = t + 50 as u64
        i = i + 1
    }
    return t
}

fn main() -> i32 {
    var reg: mc_registry.Registry = mc_reg_v763.registry_make()
    let b_air: i32 = mc_registry.reg_block_by_name(&reg, "air".p as u64, 3)
    let b_stone: i32 = mc_registry.reg_block_by_name(&reg, "stone".p as u64, 5)
    let b_water: i32 = mc_registry.reg_block_by_name(&reg, "water".p as u64, 5)
    let b_grass: i32 = mc_registry.reg_block_by_name(&reg, "short_grass".p as u64, 11)
    let st_air: i32 = mc_registry.reg_block_default_state(&reg, b_air)
    let st_stone: i32 = mc_registry.reg_block_default_state(&reg, b_stone)
    let st_water: i32 = mc_registry.reg_block_default_state(&reg, b_water)
    check(b_air >= 0 && b_stone >= 0 && b_water >= 0, 1)
    var st_plant: i32 = st_air
    if b_grass >= 0 { st_plant = mc_registry.reg_block_default_state(&reg, b_grass) }

    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    var i: usize = 0
    while i < 8192 {
        rt.st16(ids, i, st_air as u16)
        i = i + 1
    }
    var z: usize = 0
    while z < 16 {
        var x: usize = 0
        while x < 8 {
            rt.st16(ids, 10 * 256 + z * 16 + x, st_stone as u16)
            x = x + 1
        }
        z = z + 1
    }
    rt.st16(ids, 20 * 256 + 2 * 16 + 12, st_water as u16)
    rt.st16(ids, 6 * 256 + 5 * 16 + 14, st_plant as u16)
    var w: mc_world.World = mc_world.world_new()
    check(mc_world.world_put(&w, mc_render_world.wr_make_chunk(0, 0, 2, ids)), 2)

    var p: mc_precip.Precip = mc_precip.precip_new()
    let none: i32 = mc_precip.SURFACE_NONE
    check(mc_precip.precip_surface(&p, &w, &reg, 0, 2, 5, 30, 40) == 10, 3)
    check(mc_precip.precip_surface(&p, &w, &reg, 0, 12, 2, 30, 40) == 20, 4)
    check(mc_precip.precip_surface(&p, &w, &reg, 0, 12, 5, 30, 40) == none, 5)
    check(mc_precip.precip_surface(&p, &w, &reg, 0, 14, 5, 30, 40) == none, 6)
    check(mc_precip.precip_surface(&p, &w, &reg, 0, 500, 2, 30, 40) == none, 7)
    check(mc_precip.precip_surface(&p, &w, &reg, 0, 2, 5, 10, 40) == none, 8)
    check(mc_precip.precip_surface(&p, &w, &reg, 0, 2, 5, 30, 5) == none, 9)
    check(mc_precip.precip_surface(&p, &w, &reg, 0, 2, 5, 14, 5) == 10, 10)

    var s: mc_splash.Splash = mc_splash.splash_new()
    var t: u64 = run_rain(&s, &p, &w, &reg, 0, mc_precip.PRECIP_RAIN, 1000 as u64, 20)
    check(s.n_spawned == 0 as u64, 11)
    t = run_rain(&s, &p, &w, &reg, 1000, mc_precip.PRECIP_SNOW, t, 20)
    check(s.n_spawned == 0 as u64, 12)
    t = run_rain(&s, &p, &w, &reg, 1000, mc_precip.PRECIP_NONE, t, 20)
    check(s.n_spawned == 0 as u64, 13)
    t = run_rain(&s, &p, &w, &reg, 1000, mc_precip.PRECIP_RAIN, t, 20)
    check(s.n_spawned > 8 as u64, 14)
    let live: usize = mc_splash.splash_live(&s, t)
    check(live > 0 && live <= mc_splash.SPLASH_MAX, 15)

    var k: usize = 0
    var on_stone: i32 = 0
    var on_water: i32 = 0
    while k < mc_splash.SPLASH_MAX {
        if s.born[k] != 0 as u64 {
            check(s.x[k] >= 0.0 && s.x[k] < 16.0 && s.z[k] >= 0.0 && s.z[k] < 16.0, 16)
            if s.y[k] > 10.9 && s.y[k] < 11.1 { on_stone = on_stone + 1 }
            else if s.y[k] > 20.9 && s.y[k] < 21.1 { on_water = on_water + 1 }
            else { check(false, 17) }
            check(s.x[k] < 8.0 || (s.y[k] > 20.9 && s.x[k] >= 12.0 && s.x[k] < 13.0), 18)
        }
        k = k + 1
    }
    check(on_stone > 0, 19)

    var s2: mc_splash.Splash = mc_splash.splash_new()
    var t2: u64 = run_rain(&s2, &p, &w, &reg, 1000, mc_precip.PRECIP_RAIN, 1000 as u64, 40)
    var s3: mc_splash.Splash = mc_splash.splash_new()
    let t3: u64 = run_rain(&s3, &p, &w, &reg, 1000, mc_precip.PRECIP_RAIN, 1000 as u64, 40)
    check(s2.n_spawned == s3.n_spawned && t2 == t3, 20)
    var light: mc_splash.Splash = mc_splash.splash_new()
    run_rain(&light, &p, &w, &reg, 200, mc_precip.PRECIP_RAIN, 1000 as u64, 40)
    check(light.n_spawned < s2.n_spawned, 21)

    var cam: mc_camera.Camera = mc_camera.camera_new(96, 72)
    mc_camera.camera_set_pos(&cam, 4.5, 25.0, 5.5)
    mc_camera.camera_set_angles(&cam, 0.0, 90.0)
    mc_camera.camera_update(&cam)
    var l: mc_entity_draw.EntList = mc_entity_draw.entlist_new()
    let added: usize = mc_splash_draw.entlist_add_splashes(&l, &s2, &cam, t2)
    check(added > 0 && added % 4 == 0, 22)
    check(mc_entity_draw.entlist_boxes(&l) == added, 23)
    let base: u64 = rt.buf_ptr(&l.buf)
    var b: usize = 0
    while b < added {
        let rec: u64 = base + (b * mc_backend.ENT_BYTES) as u64
        check(word(rec, 3) <= 0.07 && word(rec, 3) >= 0.01 && word(rec, 11) == 0.0, 24)
        check(word(rec, 1) >= 10.9, 25)
        b = b + 1
    }
    mc_entity_draw.entlist_free(&l)
    var sm: mc_splash.Splash = mc_splash.splash_new()
    sm.x[0] = 4.5
    sm.y[0] = 11.01
    sm.z[0] = 5.5
    sm.born[0] = 1000 as u64
    mc_camera.camera_set_pos(&cam, 4.5, 12.0, 5.5)
    mc_camera.camera_update(&cam)
    l = mc_entity_draw.entlist_new()
    check(mc_splash_draw.entlist_add_splashes(&l, &sm, &cam, 1100 as u64) == 4, 31)
    var r: mc_raster.Raster = mc_raster.raster_new(96, 72)
    var at: mc_texture.Atlas = mc_texture.atlas_default()
    var be: mc_backend.Backend = mc_backend.backend_cpu(&r)
    be.upload_atlas(be.obj, (&at) as u64)
    be.begin(be.obj, (&cam) as u64, CLEAR)
    let drawn: u64 = mc_entity_draw.entlist_draw(&l, &be)
    check(drawn == 4 as u64, 26)
    var seen: i32 = 0
    var y: i32 = 0
    while y < 72 {
        var x: i32 = 0
        while x < 96 {
            if mc_raster.raster_pixel(&r, x, y) != CLEAR { seen = seen + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check(seen > 0, 27)
    mc_entity_draw.entlist_free(&l)
    mc_raster.raster_free(&r)

    let late: u64 = t2 + mc_splash.SPLASH_LIFE_MS + 10 as u64
    check(mc_splash.splash_live(&s2, late) == 0, 28)
    var l2: mc_entity_draw.EntList = mc_entity_draw.entlist_new()
    check(mc_splash_draw.entlist_add_splashes(&l2, &s2, &cam, late) == 0, 29)
    mc_entity_draw.entlist_free(&l2)
    mc_splash.splash_reset(&s2)
    check(mc_splash.splash_live(&s2, t2) == 0, 30)
    return 0
}
