// expect_exit: 0
// PROZESSSTART — `fork`, `execve`, `wait4`.
//
// Punkt 11 der Liste in `docs/SELBSTHOSTING.md`: ohne das kann ein Compiler
// `as` und `ld` nicht aufrufen, und dann ist er kein Compiler, sondern ein
// Textwerkzeug.
//
// Geprueft wird das, was dabei schiefgehen kann:
//   * der Endestatus des Kindes kommt richtig zurueck (0 und ungleich 0)
//   * ein Programm, das es nicht gibt, laesst das Kind NICHT weiterlaufen —
//     sonst gaebe es den Aufrufer zweimal
//   * eine geschriebene Datei ist danach wirklich lesbar
import modules.rt

fn main() -> i32 {
    // --- Datei schreiben und wieder einlesen
    var path: [u8; 21] = "/tmp/firn_prozess.txt"
    var pfadz: [u8; 22] = "/tmp/firn_prozess.txt\0"
    var content: [u8; 5] = "hello"
    if !rt.write_file((&pfadz[0]) as u64, (&content[0]) as u64, 5) {
        return 1
    }
    var read: rt.Buf = rt.buf_new()
    defer rt.buf_free(&read)
    if !rt.read_file((&pfadz[0]) as u64, &read) {
        return 2
    }
    if rt.buf_len(&read) != 5 {
        return 3
    }
    if !rt.mem_eq(rt.buf_ptr(&read), (&content[0]) as u64, 5) {
        return 4
    }

    // --- ein Programm mit Endestatus 0
    var bin_true: [u8; 15] = "/usr/bin/true\0\0"
    if rt.lauf3((&bin_true[0]) as u64, 0, 0, 0) != 0 {
        return 5
    }

    // --- ein Programm mit Endestatus ungleich 0
    var wrong: [u8; 16] = "/usr/bin/false\0\0"
    if rt.lauf3((&wrong[0]) as u64, 0, 0, 0) == 0 {
        return 6
    }

    // --- ein Programm, das es nicht gibt: `execve` kommt zurueck, das Kind
    // muss sich beenden. Kaeme es hier weiter, liefe `main` zweimal.
    var nothing: [u8; 20] = "/usr/bin/gibt_es_nie"
    var nichtsz: [u8; 21] = "/usr/bin/gibt_es_nie\0"
    if rt.lauf3((&nichtsz[0]) as u64, 0, 0, 0) == 0 {
        return 7
    }

    // --- ein Argument kommt beim Kind an: `/usr/bin/test 1 = 1` endet mit 0
    var test: [u8; 14] = "/usr/bin/test\0"
    var one: [u8; 2] = "1\0"
    var equal: [u8; 2] = "=\0"
    if rt.lauf3((&test[0]) as u64, (&one[0]) as u64, (&equal[0]) as u64, (&one[0]) as u64) != 0 {
        return 8
    }
    var two: [u8; 2] = "2\0"
    if rt.lauf3((&test[0]) as u64, (&one[0]) as u64, (&equal[0]) as u64, (&two[0]) as u64) == 0 {
        return 9
    }
    // Die nicht nullabgeschlossenen Fassungen stehen nur da, damit der Text
    // im Quelltext lesbar bleibt.
    if path[0] != nothing[0] {
        return 10
    }
    return 0
}
