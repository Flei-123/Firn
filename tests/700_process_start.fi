// expect_exit: 0
// PROCESS START -- `fork`, `execve`, `wait4`.
//
// Item 11 of the list in `docs/SELF_HOSTING.md`: without it a compiler
// cannot call `as` and `ld`, and then it is not a compiler but a
// text tool.
//
// What is checked is what can go wrong there:
//   * the exit status of the child comes back correctly (0 and non-zero)
//   * a program that does not exist does NOT let the child run on --
//     otherwise the caller would exist twice
//   * a written file is really readable afterwards
import modules.rt

fn main() -> i32 {
    // --- write a file and read it back in
    var path: [u8; 21] = "/tmp/firn_prozess.txt"
    var pfadz: [u8; 22] = "/tmp/firn_prozess.txt\0"
    var content: [u8; 5] = "hello"
    if !rt.write_file((&pfadz[0]) as u64, (&content[0]) as u64, 5) {
        return 1
    }
    var read: rt.Buf = rt.buf_new()
    defer rt.buf_free(&read)
    if !rt.read_file((&pfadz[0]) as u64, &read) {
        return 2
    }
    if rt.buf_len(&read) != 5 {
        return 3
    }
    if !rt.mem_eq(rt.buf_ptr(&read), (&content[0]) as u64, 5) {
        return 4
    }

    // --- a program with exit status 0
    var bin_true: [u8; 15] = "/usr/bin/true\0\0"
    if rt.run3((&bin_true[0]) as u64, 0, 0, 0) != 0 {
        return 5
    }

    // --- a program with a non-zero exit status
    var wrong: [u8; 16] = "/usr/bin/false\0\0"
    if rt.run3((&wrong[0]) as u64, 0, 0, 0) == 0 {
        return 6
    }

    // --- a program that does not exist: `execve` returns, the child has to
    // end itself. If it ran on here, `main` would run twice.
    var nothing: [u8; 20] = "/usr/bin/gibt_es_nie"
    var nichtsz: [u8; 21] = "/usr/bin/gibt_es_nie\0"
    if rt.run3((&nichtsz[0]) as u64, 0, 0, 0) == 0 {
        return 7
    }

    // --- an argument arrives at the child: `/usr/bin/test 1 = 1` ends with 0
    var test: [u8; 14] = "/usr/bin/test\0"
    var one: [u8; 2] = "1\0"
    var equal: [u8; 2] = "=\0"
    if rt.run3((&test[0]) as u64, (&one[0]) as u64, (&equal[0]) as u64, (&one[0]) as u64) != 0 {
        return 8
    }
    var two: [u8; 2] = "2\0"
    if rt.run3((&test[0]) as u64, (&one[0]) as u64, (&equal[0]) as u64, (&two[0]) as u64) == 0 {
        return 9
    }
    // The versions without a null terminator only stand there to keep the text
    // readable in the source.
    if path[0] != nothing[0] {
        return 10
    }
    return 0
}
