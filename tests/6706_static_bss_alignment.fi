// expect_exit: 0
#[align(16)]
struct Wide {
    a: u64,
    b: u64,
}

#[align(64)]
struct Line {
    a: u64,
}

static mut ODD_DATA: [u8; 3] = [1 as u8, 2 as u8, 3 as u8]
static mut BYTE_A: u8 = 0
static mut WORD_A: u64 = 0
static mut BYTE_B: u8 = 0
static mut WIDE_A: Wide = Wide { a: 0, b: 0 }
static mut BYTE_C: u8 = 0
static mut LINE_A: Line = Line { a: 0 }
static mut TABLE_A: [u64; 5] = [0 as u64; 5]

fn aligned(p: u64, a: u64) -> bool {
    return p % a == 0
}

fn word_addr(p: *mut u64) -> u64 {
    return p as u64
}

fn wide_addr(p: *mut Wide) -> u64 {
    return p as u64
}

fn line_addr(p: *mut Line) -> u64 {
    return p as u64
}

fn main() -> i32 {
    if !aligned(word_addr(&WORD_A), 8) { return 1 }
    if !aligned(wide_addr(&WIDE_A), 16) { return 2 }
    if !aligned(line_addr(&LINE_A), 64) { return 3 }
    if !aligned(word_addr(&TABLE_A[0]), 8) { return 4 }
    return 0
}
