// expect_exit: 0
import std.rt
import std.fs
import media.video.vidsource

fn load(path: str, b: *mut rt.Buf) -> bool {
    let got: usize = fs.read_file(path, b) catch | e | (0 -% 1)
    return got != (0 -% 1)
}

fn check_decode() -> bool {
    var b: rt.Buf = rt.buf_new()
    if !load("testdata/media_video/av_main.mp4", &b) {
        return false
    }
    var vs: vidsource.VideoSource = vidsource.vs_new()
    if vidsource.vs_open(&vs, b.ptr, rt.buf_len(&b)) != vidsource.VS_OK {
        return false
    }
    var ok: bool = vidsource.vs_width(&vs) == (64 as u32) && vidsource.vs_height(&vs) == (48 as u32) && vidsource.vs_fps_milli(&vs) == (25000 as u32)
    var out: rt.Buf = rt.buf_new()
    rt.buf_reserve(&out, vidsource.vs_rgba_bytes(&vs))
    rt.buf_set_len(&out, vidsource.vs_rgba_bytes(&vs))
    var pts: i64 = 0
    var last: i64 = -1
    var n: i32 = 0
    var sorted: bool = true
    var lit: bool = false
    while vidsource.vs_next_frame(&vs, out.ptr, &pts) == 1 {
        if pts <= last {
            sorted = false
        }
        last = pts
        if n == 0 && pts != 0 {
            sorted = false
        }
        if rt.ld8(out.ptr, 3) == (255 as u8) && rt.ld8(out.ptr, 20 * 4) != rt.ld8(out.ptr, 4) {
            lit = true
        }
        n = n + 1
    }
    ok = ok && n == 50 && sorted && lit && last == 1960000
    let k: i64 = vidsource.vs_seek(&vs, 1100000)
    ok = ok && k == 1000000
    var m: i32 = 0
    while vidsource.vs_next_frame(&vs, out.ptr, &pts) == 1 {
        m = m + 1
    }
    ok = ok && m == 25
    vidsource.vs_close(&vs)
    rt.buf_free(&out)
    rt.buf_free(&b)
    return ok
}

fn check_unsupported() -> bool {
    var b: rt.Buf = rt.buf_new()
    if !load("testdata/media_video/av_vp8.webm", &b) {
        return false
    }
    var vs: vidsource.VideoSource = vidsource.vs_new()
    let rc: i32 = vidsource.vs_open(&vs, b.ptr, rt.buf_len(&b))
    let ok: bool = rc == vidsource.VS_ERR_UNSUPPORTED && vidsource.vs_width(&vs) == (64 as u32)
    vidsource.vs_close(&vs)
    rt.buf_free(&b)
    return ok
}

fn main() -> i32 {
    if !check_decode() {
        return 1
    }
    if !check_unsupported() {
        return 2
    }
    return 0
}
