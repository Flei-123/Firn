// expect_exit: 0
// tests/1131_js_async.fi -- ROUND 66: PROMISES, async/await and the job queue
//
// The engine runs ONE JavaScript program with numbered assertions; the
// number of the FIRST failing one lands in the global variable `fail` and
// comes back as the exit code, so the code names the check that broke.
import html.mem
import js.lex
import js.ast
import js.parse
import js.val
import js.interp
import js.builtin
import js.gen

const SRC_LEN: usize = 2267

fn __gc_finalize(kind: u64, p: *mut u8) {
}

// ROUND 79 -- the realm is a GC object and is handed the addresses of `ctx`,
// `t` and `nm`, which lie in THIS frame. It is sound here and only here: the
// realm comes into being in this call, nothing outside gets hold of it, and
// it is garbage the moment this function returns. The escape analysis
// (compiler/src/escape.rs) cannot see that, so the exception is said out
// loud instead of the check being weakened (docs/ROUND79.md 3).
#[allow_escape]
fn run(src: *mut u8, len: usize) -> AllocError!u64 {
    var nm: lex.Names = lex.Names { pool: mem.cp_new(), off: mem.cp_new(),
        len: mem.cp_new(), hash: mem.cp_new(), buckets: mem.cp_new(),
        mask: 0, n: 0 }
    lex.names_init(&nm)
    var l: lex.Lexer = lex.lex_new()
    lex.lex_init(&l, &nm)
    var t: ast.Ast = ast.ast_new()
    ast.ast_init(&t)
    var p: parse.Parser = parse.parser_new()
    parse.parser_init(&p, &l, &t, &nm)
    lex.lex_set_ascii(&l, src, len)
    let prog: u32 = parse.parse_program(&p, false)
    if parse.parse_error(&p) != parse.ERR_NONE {
        return 900 + parse.parse_error_line(&p) as u64
    }
    var ctx: interp.Ctx = interp.ctx_new()
    ctx.native = builtin.native_dispatch
    ctx.arity = builtin.native_arity_of
    ctx.gen_start = gen.gen_start
    ctx.gen_native = gen.gen_native
    var sp: gen.Susp = gen.susp_new()
    gen.susp_init(&sp)
    ctx.gen_data = (&sp) as *mut u8
    let r: Gc[Realm] = try val.realm_new()
    val.realm_set_ctx(r, (&ctx) as *mut u8)
    val.realm_set_ast(r, &t, &nm)
    let g: Gc[JsObj] = try builtin.install(r)
    let okg: bool = try gen.install_gen(r)
    let v: Gc[JsVal] = try interp.run_program(r, prog, r.global_env)
    if ctx.comp == interp.C_THROW {
        return 800
    }
    // The microtask queue -- an async assertion only counts after it.
    let okj: bool = try gen.run_jobs(r)
    if ctx.comp == interp.C_THROW {
        return 801
    }
    var name: [u8; 4] = "fail"
    let s: Gc[JsVal] = try val.str_from_ascii(r, &name[0], 4)
    let k: u64 = try val.key_for_str(r, s)
    let gv: Gc[JsVal] = g
    let f: Gc[JsVal] = try interp.get_prop(r, gv, k)
    let n: u64 = try interp.to_number(r, f)
    let x: f64 = math_of(n)
    gen.susp_free(&sp)
    return x as u64
}

fn math_of(bits: u64) -> f64 {
    var t: u64 = bits
    return *(((&t) as usize) as *mut f64)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    gc_set_max_bytes(1 << 30)
    var s: [u8; 2267] = "globalThis.fail=0;\nfunction ck(n,c){ if(!c && globalThis.fail===0) globalThis.fail=n; }\nvar log=[];\nPromise.resolve(1).then(function(v){ log.push(\"a\"+v); });\nck(1, typeof Promise===\"function\");\nck(2, Promise.resolve(1) instanceof Promise);\nvar p=new Promise(function(res){res(5)});\np.then(function(v){ log.push(\"b\"+v); return v+1; }).then(function(v){ log.push(\"c\"+v); });\nPromise.reject(new TypeError(\"t\")).catch(function(e){ log.push(\"d\"+(e instanceof TypeError)); });\nasync function f(){ var v = await 7; log.push(\"e\"+v); return v*2; }\nf().then(function(v){ log.push(\"f\"+v); });\nasync function h(){ try { await Promise.reject(new Error(\"x\")); } catch(e){ log.push(\"g\"+e.message); } return 1; }\nh();\nPromise.all([1,Promise.resolve(2)]).then(function(a){ log.push(\"h\"+a.join(\"\")); });\nPromise.race([Promise.resolve(\"r\"),new Promise(function(){})]).then(function(v){ log.push(\"i\"+v); });\nPromise.allSettled([Promise.reject(1),2]).then(function(a){ log.push(\"j\"+a[0].status+a[1].value); });\nPromise.any([Promise.reject(1),3]).then(function(v){ log.push(\"k\"+v); });\nasync function* ag(){ yield 1; await 0; yield 2; }\n(async function(){ var acc=[]; for await (var x of ag()) acc.push(x); log.push(\"l\"+acc.join(\"\")); })();\n(async function(){ var acc=[]; for await (var y of [1,Promise.resolve(2)]) acc.push(y); log.push(\"m\"+acc.join(\"\")); })();\nglobalThis.check = function(){\n  ck(3, log.indexOf(\"a1\")>=0);\n  ck(4, log.indexOf(\"b5\")>=0);\n  ck(5, log.indexOf(\"c6\")>=0);\n  ck(6, log.indexOf(\"dtrue\")>=0);\n  ck(7, log.indexOf(\"e7\")>=0);\n  ck(8, log.indexOf(\"f14\")>=0);\n  ck(9, log.indexOf(\"gx\")>=0);\n  ck(10, log.indexOf(\"h12\")>=0);\n  ck(11, log.indexOf(\"ir\")>=0);\n  ck(12, log.indexOf(\"jrejected2\")>=0);\n  ck(13, log.indexOf(\"k3\")>=0);\n  ck(14, log.indexOf(\"l12\")>=0);\n  ck(15, log.indexOf(\"m12\")>=0);\n};\nPromise.resolve().then(function(){}).then(function(){}).then(function(){}).then(function(){}).then(function(){}).then(function(){}).then(function(){}).then(function(){ globalThis.check(); });\nck(16, (function(){var order=[];order.push(1);Promise.resolve().then(function(){order.push(3)});order.push(2);return order.join(\"\")===\"12\"})());\nck(17, typeof (async function(){})().then===\"function\");\nck(18, Object.getPrototypeOf(async function(){}) !== Function.prototype);\n"
    let bad: u64 = run(&s[0], SRC_LEN) catch 999
    return bad as i32
}
