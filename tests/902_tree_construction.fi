// expect_exit: 0
// tests/902_tree_construction.fi -- HTML TREE CONSTRUCTION (round 54).
//
// Drives the complete path -- tokenizer (lib/html/) -> binary
// token protocol -> tree building (lib/browser/tree.fi) -> output in the
// html5lib format -- in the program itself, without a file and without a
// harness. That makes the tree construction part of `test.sh` and not only
// of `tools/html/run.sh`.
//
// The eight cases are taken verbatim from tools/html/cases/*.dat;
// their expectations are checked there against html5lib 1.1 (tools/html/oracle.py,
// docs/ROUND54.md). What is checked is what the building really depends on:
//
//   0  basic skeleton with head/body and an RCDATA title
//   1  the adoption agency procedure (the textbook example of the standard)
//   2  formatting across a table (foster parenting)
//   3  foster parenting for text before the first row
//   4  RCDATA: the tree building switches the tokenizer over
//   5  three switch-overs in a row (title, style, script)
//   6  "in select"
//   7  implicit closing of list items
//
// The return value names the first case that deviates (1..8).

import html.mem
import browser.node
import browser.driver
import browser.write

#[no_gc]
fn ein0(out: *mut mem.Buf) -> usize {
    var t: [u8; 36] = "<head><title>T</title></head><body>b"
    mem.buf_clear(out)
    var i: usize = 0
    while i < 36 {
        mem.buf_push(out, t[i])
        i = i + 1
    }
    return 36
}

#[no_gc]
fn want0(out: *mut mem.Buf) -> usize {
    var t: [u8; 67] = "| <html>\n|   <head>\n|     <title>\n|       \"T\"\n|   <body>\n|     \"b\"\n"
    mem.buf_clear(out)
    var i: usize = 0
    while i < 67 {
        mem.buf_push(out, t[i])
        i = i + 1
    }
    return 67
}

