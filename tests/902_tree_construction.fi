fn buffer_equal(a: *mut mem.Buf, b: *mut mem.Buf) -> bool {
    let n: usize = mem.buf_len(a)
    if n != mem.buf_len(b) {
        return false
    }
    var i: usize = 0
    while i < n {
        if mem.buf_at(a, i) != mem.buf_at(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn input(nr: usize, out: *mut mem.Buf) -> usize {
    if nr == 0 {
        return ein0(out)
    }
    if nr == 1 {
        return ein1(out)
    }
    if nr == 2 {
        return ein2(out)
    }
    if nr == 3 {
        return ein3(out)
    }
    if nr == 4 {
        return ein4(out)
    }
    if nr == 5 {
        return ein5(out)
    }
    if nr == 6 {
        return ein6(out)
    }
    if nr == 7 {
        return ein7(out)
    }
    return 0
}

fn expectation(nr: usize, out: *mut mem.Buf) -> usize {
    if nr == 0 {
        return want0(out)
    }
    if nr == 1 {
        return want1(out)
    }
    if nr == 2 {
        return want2(out)
    }
    if nr == 3 {
        return want3(out)
    }
    if nr == 4 {
        return want4(out)
    }
    if nr == 5 {
        return want5(out)
    }
    if nr == 6 {
        return want6(out)
    }
    if nr == 7 {
        return want7(out)
    }
    return 0
}

fn case(l: *mut driver.Run, in_b: *mut mem.Buf, should_b: *mut mem.Buf,
    out: *mut mem.Buf, nr: usize) -> bool {
    let n: usize = input(nr, in_b)
    driver.run_text_out_bytes(l, mem.buf_ptr(in_b), n)
    if driver.run_document_build(l) != 0 as u32 {
        return false
    }
    mem.buf_clear(out)
    write.tree_write(driver.run_names(l), driver.run_document(l), out)
    let m: usize = expectation(nr, should_b)
    return buffer_equal(out, should_b)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    // The `Run` lies in the frame of `main`: the stack scan of the collector is
    // conservative and finds its Gc pointers only there (SPEC 3.5.3).
    var l: driver.Run = driver.run_new()
    if !driver.run_init(&l) {
        return 91
    }
    var in_b: mem.Buf = mem.buf_new()
    mem.buf_init(&in_b)
    var should_b: mem.Buf = mem.buf_new()
    mem.buf_init(&should_b)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)

    if !case(&l, &in_b, &should_b, &out, 0) {
        return 1
    }
    if !case(&l, &in_b, &should_b, &out, 1) {
        return 2
    }
    if !case(&l, &in_b, &should_b, &out, 2) {
        return 3
    }
    if !case(&l, &in_b, &should_b, &out, 3) {
        return 4
    }
    if !case(&l, &in_b, &should_b, &out, 4) {
        return 5
    }
    if !case(&l, &in_b, &should_b, &out, 5) {
        return 6
    }
    if !case(&l, &in_b, &should_b, &out, 6) {
        return 7
    }
    if !case(&l, &in_b, &should_b, &out, 7) {
        return 8
    }

    // Second pass: the same `Run` carries any number of documents,
    // and the collector may run in between. If the tree of a finished
    // document were still tied to the state, one would find it here.
    gc_collect()
    if !case(&l, &in_b, &should_b, &out, 0) {
        return 1
    }
    if !case(&l, &in_b, &should_b, &out, 1) {
        return 2
    }
    if !case(&l, &in_b, &should_b, &out, 2) {
        return 3
    }
    if !case(&l, &in_b, &should_b, &out, 3) {
        return 4
    }
    if !case(&l, &in_b, &should_b, &out, 4) {
        return 5
    }
    if !case(&l, &in_b, &should_b, &out, 5) {
        return 6
    }
    if !case(&l, &in_b, &should_b, &out, 6) {
        return 7
    }
    if !case(&l, &in_b, &should_b, &out, 7) {
        return 8
    }

    driver.run_free(&l)
    mem.buf_free(&in_b)
    mem.buf_free(&should_b)
    mem.buf_free(&out)
    return 0
}
