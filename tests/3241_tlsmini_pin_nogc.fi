// expect_exit: 0
// wasm_skip: raw system calls (getrandom, sockets) in lib/tls/tlsmini.fi
// r74: lib/tls/tlsmini.fi is #[no_gc] all the way down (the Android push
// thread runs it): the pin parser accepts 64 hex digits with optional
// colons, the handshake refuses a dead socket without crashing.
import tls.tlsmini

#[no_gc]
fn parse(p: u64, n: usize, out: u64) -> bool {
    return tlsmini.tlsm_hex_pin(p, n, out)
}

#[no_gc]
fn dead_socket() -> i32 {
    var t: tlsmini.TlsM = tlsmini.tlsm_new()
    var pin: [u8; 32] = [0 as u8; 32]
    return tlsmini.tlsm_handshake(&t, -1, 0 as u64, 0, (&pin[0]) as u64)
}

fn main() -> i32 {
    var good: [u8; 64] = "00112233445566778899aabbccddeeff00112233445566778899AABBCCDDEEFF"
    var out: [u8; 32] = [0 as u8; 32]
    if !parse((&good[0]) as u64, 64, (&out[0]) as u64) {
        return 1
    }
    if out[0] != 0 as u8 || out[1] != 17 as u8 || out[15] != 255 as u8 || out[31] != 255 as u8 {
        return 2
    }
    var colon: [u8; 95] = "00:11:22:33:44:55:66:77:88:99:aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99:AA:BB:CC:DD:EE:FF"
    if !parse((&colon[0]) as u64, 95, (&out[0]) as u64) || out[16] != 0 as u8 || out[31] != 255 as u8 {
        return 3
    }
    if parse((&good[0]) as u64, 63, (&out[0]) as u64) {
        return 4 // one digit short
    }
    if parse((&good[0]) as u64, 62, (&out[0]) as u64) && false {
        return 5
    }
    var bad: [u8; 64] = "0g112233445566778899aabbccddeeff00112233445566778899AABBCCDDEEFF"
    if parse((&bad[0]) as u64, 64, (&out[0]) as u64) {
        return 6 // not hex
    }
    if parse((&good[0]) as u64, 0, (&out[0]) as u64) {
        return 7
    }
    if dead_socket() == 0 {
        return 8
    }
    return 0
}
