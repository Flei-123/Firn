// expect_exit: 32
// [value; N] -- repeat literal, small (unrolled) and large (loop).
const N: usize = 100

fn main() -> i32 {
    var small: [i32; 4] = [3; 4]
    var big: [u8; 100] = [2 as u8; N]
    var s: i32 = 0
    for i in 0 as usize..4 as usize {
        s = s + small[i]
    }
    var t: i32 = 0
    for i in 0 as usize..N {
        t = t + big[i] as i32
    }
    // 12 + 200/10 = 32
    return s + t / 10 as i32
}
