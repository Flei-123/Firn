// expect_exit: 0
import std.rt
import std.env
import mc.mc_inv_player
import mc.mc_raster
import mc.mc_pskin

const BG: u32 = 0xFF405060

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn covered(r: *mut mc_raster.Raster, x0: i32, y0: i32, x1: i32, y1: i32) -> i32 {
    var n: i32 = 0
    var y: i32 = y0
    while y < y1 {
        var x: i32 = x0
        while x < x1 {
            if px(r, x, y) != BG { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn frame(ip: *mut mc_inv_player.InvPlayer, r: *mut mc_raster.Raster, v: *mut mc_inv_player.InvView, s: i32, mx: i32, my: i32) {
    mc_raster.raster_clear(r, BG)
    mc_inv_player.ip_draw(ip, r, v, s, 0, 0, mx, my, 0.0)
}

fn diff(a: *mut mc_raster.Raster, b: *mut mc_raster.Raster) -> i32 {
    var n: i32 = 0
    var y: i32 = 0
    while y < (*a).h {
        var x: i32 = 0
        while x < (*a).w {
            if px(a, x, y) != px(b, x, y) { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn dump(r: *mut mc_raster.Raster, key: str) {
    let o: str = env.get(key)
    if o.length() == 0 { return }
    mc_raster.raster_write_png(r, o.p as u64)
}

fn px(r: *mut mc_raster.Raster, x: i32, y: i32) -> u32 {
    return rt.ld32((*r).color, (y as usize) * ((*r).w as usize) + (x as usize))
}

fn main() -> i32 {
    let s: i32 = 2
    var ip: mc_inv_player.InvPlayer = mc_inv_player.ip_new()
    check(!mc_inv_player.ip_has_skin(&ip), 1)
    mc_inv_player.ip_ensure_default(&ip, 1 as u64, 2 as u64)
    check(mc_inv_player.ip_has_skin(&ip), 2)
    var v: mc_inv_player.InvView = mc_inv_player.view_inventory()
    let w: i32 = 176 * s
    let h: i32 = 166 * s
    var c: mc_raster.Raster = mc_raster.raster_new(w, h)
    var l: mc_raster.Raster = mc_raster.raster_new(w, h)
    var rr: mc_raster.Raster = mc_raster.raster_new(w, h)
    var u: mc_raster.Raster = mc_raster.raster_new(w, h)
    var d: mc_raster.Raster = mc_raster.raster_new(w, h)
    frame(&ip, &c, &v, s, (51) * s, (75 - 50) * s)
    frame(&ip, &l, &v, s, 20 * s, (75 - 50) * s)
    frame(&ip, &rr, &v, s, 130 * s, (75 - 50) * s)
    frame(&ip, &u, &v, s, 51 * s, 0)
    frame(&ip, &d, &v, s, 51 * s, 160 * s)
    dump(&c, "INVP_C")
    dump(&l, "INVP_L")
    dump(&rr, "INVP_R")
    dump(&u, "INVP_U")
    dump(&d, "INVP_D")
    let body: i32 = covered(&c, 26 * s, 8 * s, 75 * s, 78 * s)
    check(body > 3000 * s * s / 4, 3)
    check(body < 49 * 70 * s * s, 4)
    check(covered(&c, 0, 0, 26 * s, h) == 0, 5)
    check(covered(&c, 75 * s, 0, w, h) == 0, 6)
    check(covered(&c, 0, 78 * s, w, h) == 0, 7)
    check(covered(&c, 0, 0, w, 8 * s) == 0, 8)
    check(diff(&c, &l) > 400, 9)
    check(diff(&c, &rr) > 400, 10)
    check(diff(&l, &rr) > 800, 11)
    check(diff(&c, &u) > 100, 12)
    check(diff(&c, &d) > 100, 13)
    var hx: i32 = 51 * s
    var hy: i32 = 30 * s
    check(px(&c, hx, hy) != BG, 14)
    mc_inv_player.ip_free(&ip)
    return 0
}
