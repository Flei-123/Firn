// expect_exit: 42
// Round 52 (compiler/src/core.rs): inline assembly with an input AND an
// output operand. `out("rax")` and `in("rax") a` name the same register --
// that is the shape of a read-write operand.
//
// ROUND ARM-FREESTANDING: the same program on both machines. `add rax, rcx`
// is x86 TEXT, not a Firn expression, so there is nothing to port -- what
// the language got instead is a way to say which machine a definition
// belongs to (`#[arch(...)]`, compiler/src/archsel.rs). The x86 variant is
// the one that stood here before, character for character; the A64 one says
// the same thing in A64.
#[arch(x86_64)]
fn add_regs(a: u64, b: u64) -> u64 {
    return asm("add rax, rcx", out("rax"), in("rax") a, in("rcx") b)
}

#[arch(aarch64)]
fn add_regs(a: u64, b: u64) -> u64 {
    return asm("add x9, x9, x10", out("x9"), in("x9") a, in("x10") b)
}

fn main() -> i32 {
    let a: u64 = 40
    let b: u64 = 2
    let s: u64 = add_regs(a, b)
    return s as i32
}
