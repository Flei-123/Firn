// expect_exit: 0
// tests/912_css_anb.fi -- the An+B micro syntax of `:nth-child()`.
//
// The complete quota against An+B.json (128 cases) is measured by
// tools/css/run.sh. Checked here is the trap of the grammar: the `+`
// belongs to the `n` only WITHOUT whitespace, while around the `+` of the
// B part whitespace is allowed.
//
// The return value names the first case that deviates (1..6).
import html.mem
import css.tok
import css.anb

#[no_gc]
fn feed(src: *mut mem.CpBuf, p: u64, n: usize) {
    mem.cp_clear(src)
    var i: usize = 0
    while i < n {
        mem.cp_push(src, (*((p + i as u64) as *mut u8)) as u32)
        i = i + 1
    }
}

#[no_gc]
fn check(t: *mut tok.Tokens, src: *mut mem.CpBuf, p: u64, n: usize,
    want_ok: bool, want_a: i64, want_b: i64) -> bool {
    feed(src, p, n)
    tok.tokenize(t, src)
    var r: anb.Anb = anb.anb_new()
    let ok: bool = anb.anb_parse(t, &r)
    if ok != want_ok {
        return false
    }
    if !ok {
        return true
    }
    return r.a == want_a && r.b == want_b
}

#[no_gc]
fn main() -> i32 {
    var t: tok.Tokens = tok.tokens_new()
    tok.tokens_init(&t)
    var src: mem.CpBuf = mem.cp_new()

    var s1: [u8; 4] = "2n+1"
    if !check(&t, &src, (&s1[0]) as u64, 4, true, 2, 1) {
        return 1
    }
    var s2: [u8; 3] = "odd"
    if !check(&t, &src, (&s2[0]) as u64, 3, true, 2, 1) {
        return 2
    }
    var s3: [u8; 4] = "even"
    if !check(&t, &src, (&s3[0]) as u64, 4, true, 2, 0) {
        return 3
    }
    // whitespace around the B part is allowed
    var s4: [u8; 8] = "-n + 3  "
    if !check(&t, &src, (&s4[0]) as u64, 8, true, -1, 3) {
        return 4
    }
    // whitespace between `+` and `n` is NOT
    var s5: [u8; 5] = "+ 2n1"
    if !check(&t, &src, (&s5[0]) as u64, 4, false, 0, 0) {
        return 5
    }
    // a non-integer is not An+B
    var s6: [u8; 4] = "3.1n"
    if !check(&t, &src, (&s6[0]) as u64, 4, false, 0, 0) {
        return 6
    }
    // the positions of `2n+1` are 1, 3, 5 ... and not 2
    if !anb.anb_matches(2, 1, 1) {
        return 7
    }
    if anb.anb_matches(2, 1, 2) {
        return 7
    }
    if !anb.anb_matches(2, 1, 5) {
        return 7
    }
    // `-n+3` catches 1, 2, 3 and nothing else
    if !anb.anb_matches(-1, 3, 3) {
        return 8
    }
    if anb.anb_matches(-1, 3, 4) {
        return 8
    }
    tok.tokens_free(&t)
    mem.cp_free(&src)
    return 0
}
