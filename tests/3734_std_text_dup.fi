// expect_exit: 0
// std.text.dup: an owned copy; `"" + s` is NOT one (it aliases s).
import std.rt
import std.text
import std.testkit

#[test]
fn dup_survives_change_of_source() {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push(&b, 97)
    rt.buf_push(&b, 98)
    let s: str = str { p: rt.buf_ptr(&b) as *mut u8, n: 2 }
    let t: str = text.dup(s)
    *(s.p) = 120 as u8
    testkit.assert_eq_str(t, "ab")
    rt.buf_free(&b)
}

#[test]
fn dup_of_empty_is_empty() {
    testkit.assert_eq_i64(text.dup("").n as i64, 0)
}

#[test]
fn dup_keeps_length_and_octets() {
    testkit.assert_eq_str(text.dup("hello world"), "hello world")
}
