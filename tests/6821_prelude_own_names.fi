// expect_exit: 0
import std.io

fn println(s: str) {
    io.print_line(s)
    io.print_line("own")
}

struct Pair {
    parse: i32,
}

fn format(a: i32, b: i32) -> i32 {
    return a + b
}

fn main() -> i32 {
    var bad: i32 = 0
    println("hi")
    let p: Pair = Pair { parse: 5 }
    if p.parse != 5 {
        bad = bad + 1
    }
    if format(2, 3) != 5 {
        bad = bad + 2
    }
    return bad
}
