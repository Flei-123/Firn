// expect_exit: 0
import std.rt
import mc.mc_game_mode

fn check(c: bool, code: i32) {
    if !c { rt.finish(code as i64) }
}

fn main() -> i32 {
    check(!mc_game_mode.gm_creative(0, true), 1)
    check(mc_game_mode.gm_creative(1, false), 2)
    check(mc_game_mode.gm_creative(3, false), 3)
    check(!mc_game_mode.gm_creative(2, true), 4)
    check(mc_game_mode.gm_creative(0 - 1, true), 5)
    check(!mc_game_mode.gm_creative(0 - 1, false), 6)
    check(!mc_game_mode.gm_instant_break(0, true), 7)
    check(mc_game_mode.gm_instant_break(1, false), 8)
    check(!mc_game_mode.gm_instant_break(3, true), 9)
    check(mc_game_mode.gm_may_break(0), 10)
    check(mc_game_mode.gm_may_break(1), 11)
    check(!mc_game_mode.gm_may_break(2), 12)
    check(!mc_game_mode.gm_may_break(3), 13)
    return 0
}
