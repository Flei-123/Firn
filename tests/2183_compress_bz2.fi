// expect_exit: 0
// tests/2183_compress_bz2.fi -- lib/compress/bz2.fi (decoder): files made by
// Python's bz2 (levels 1 and 9, two streams in a row, an empty stream, long
// runs) and a hand-made block of the obsolete "randomised" kind (made by
// tools/compress/gen_fixtures.py), decoded octet for octet; refusals (cut,
// flipped, bad CRCs, bad header, limits); the streaming reader. The big corpus
// and the damaged-input sweep against libbz2 are in tools/compress/check.py.
import compress.common
import compress.bz2
import std.rt
import std.io
import std.fs

const PLAIN: str = __include_str("data/compress/plain.bin")
const RANDOM_BLOCK: str = __include_str("data/compress/random_block.bin")
const F_9: str = __include_str("data/compress/plain.bz2")
const F_1: str = __include_str("data/compress/plain_l1.bz2")
const F_MULTI: str = __include_str("data/compress/plain_multi.bz2")
const F_EMPTY: str = __include_str("data/compress/empty.bz2")
const F_RUNS: str = __include_str("data/compress/runs.bz2")
const F_RANDOMISED: str = __include_str("data/compress/random_block.bz2")

struct Tally {
    total: i64,
    fails: i64,
}

fn check(t: *mut Tally, what: str, ok: bool) {
    (*t).total = (*t).total + 1
    if !ok {
        (*t).fails = (*t).fails + 1
        io.print("FAIL ")
        io.print_line(what)
    }
}

static mut code: u32 = 0

fn why(e: CompressError) -> usize {
    if e == CompressError::Data { code = 1 }
    if e == CompressError::Format { code = 2 }
    if e == CompressError::Checksum { code = 3 }
    if e == CompressError::Truncated { code = 4 }
    if e == CompressError::TooLarge { code = 5 }
    if e == CompressError::OutOfMemory { code = 6 }
    if e == CompressError::Unsupported { code = 7 }
    if e == CompressError::Dictionary { code = 8 }
    if e == CompressError::Io { code = 9 }
    return 0
}

fn is_plain(b: *mut rt.Buf, want: str) -> bool {
    return rt.buf_len(b) == want.length() && rt.mem_eq(rt.buf_ptr(b), want.p as u64, want.length())
}

fn view(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: rt.buf_len(b) }
}

fn scratch(tag: str) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, "/tmp/firn_".p as u64, 10)
    rt.buf_push_bytes(&b, tag.p as u64, tag.length())
    rt.buf_push(&b, 95 as u8)
    rt.buf_push_dec_i64(&b, syscall(39, 0, 0, 0, 0, 0, 0))
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

// deterministic pseudo random octets
fn pseudo(n: usize, seed: u64) -> rt.Buf {
    var b: rt.Buf = rt.buf_new()
    var x: u64 = seed
    var i: usize = 0
    while i < n {
        x = x *% 6364136223846793005 +% 1442695040888963407
        rt.buf_push(&b, ((x >> 33) & 255) as u8)
        i = i + 1
    }
    return b
}

fn zeros(n: usize) -> rt.Buf {
    var z: rt.Buf = rt.buf_new()
    rt.buf_reserve(&z, n)
    rt.mem_set(rt.buf_ptr(&z), 0 as u8, n)
    rt.buf_set_len(&z, n)
    return z
}

fn finish(t: *mut Tally) -> i32 {
    io.print("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&nb, (*t).total)
    io.print_bytes(rt.buf_ptr(&nb), rt.buf_len(&nb))
    io.print_line("")
    if (*t).fails != 0 {
        return 1 as i32
    }
    return 0
}

fn dec(z: str, max: usize, out: *mut rt.Buf) -> u32 {
    code = 0
    bz2.bz2_decompress_limited(z.p as u64, z.length(), max, out) catch | e | (why(e))
    return code
}

fn decodes_to(t: *mut Tally, what: str, z: str, want: str) {
    var out: rt.Buf = rt.buf_new()
    let c: u32 = dec(z, 0, &out)
    check(t, what, c == 0 as u32 && is_plain(&out, want))
    rt.buf_free(&out)
}

fn stream_dec(path: str, z: str, piece: usize, out: *mut rt.Buf) -> u32 {
    code = 0
    fs.write_file(path, z.p as u64, z.length()) catch 0
    let fd: i64 = fs.open_read(path) catch -1
    if fd < 0 {
        return 99 as u32
    }
    var d: bz2.Bz2Dec = bz2.bz2_dec_open_fd(fd)
    let tmp: u64 = rt.heap_alloc(piece)
    while true {
        let k: usize = bz2.bz2_dec_read(&d, tmp, piece) catch | e | (why(e))
        if code != 0 as u32 || k == 0 {
            break
        }
        rt.buf_push_bytes(out, tmp, k)
    }
    rt.heap_free(tmp, piece)
    bz2.bz2_dec_close(&d)
    fs.close_fd(fd)
    return code
}

fn main() -> i32 {
    var t: Tally = Tally { total: 0, fails: 0 }
    let path: str = scratch("bz2_2183")

    decodes_to(&t, "level 9", F_9, PLAIN)
    decodes_to(&t, "level 1", F_1, PLAIN)
    decodes_to(&t, "two streams in a row", F_MULTI, PLAIN)
    decodes_to(&t, "an empty stream", F_EMPTY, "")
    decodes_to(&t, "the randomised block of bzip2 0.9.0", F_RANDOMISED, RANDOM_BLOCK)
    // long runs: 100000 a, then xy x 5000, then 300 b
    var runs: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 100000 {
        rt.buf_push(&runs, 97 as u8)
        i = i + 1
    }
    i = 0
    while i < 5000 {
        rt.buf_push(&runs, 120 as u8)
        rt.buf_push(&runs, 121 as u8)
        i = i + 1
    }
    i = 0
    while i < 300 {
        rt.buf_push(&runs, 98 as u8)
        i = i + 1
    }
    decodes_to(&t, "long runs (the run-length stage and its repeat counts)", F_RUNS, view(&runs))
    var o: rt.Buf = rt.buf_new()
    // trailing garbage after a complete stream is ignored (like Python's bz2.decompress)
    var withg: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&withg, F_9.p as u64, F_9.length())
    rt.buf_push_bytes(&withg, "garbage after the stream".p as u64, 24)
    check(&t, "trailing garbage is ignored", dec(view(&withg), 0, &o) == 0 as u32 && is_plain(&o, PLAIN))
    rt.buf_free(&withg)
    // refusals
    rt.buf_clear(&o)
    check(&t, "bad magic is Format", dec("this is not bzip2 data at all", 0, &o) == 2 as u32)
    rt.buf_clear(&o)
    check(&t, "BZh0 is Format", dec("BZh0xxxxxxxxxxxxxxxxxxxxxx", 0, &o) == 2 as u32)
    rt.buf_clear(&o)
    check(&t, "empty input is Truncated", dec("", 0, &o) == 4 as u32)
    var cuts: usize = 0
    var bad: usize = 0
    var c: usize = 0
    while c < F_9.length() {
        rt.buf_clear(&o)
        cuts = cuts + 1
        if dec(str { p: F_9.p, n: c }, 0, &o) == 0 as u32 {
            bad = bad + 1
        }
        c = c + 41
    }
    check(&t, "every cut of a stream is refused", bad == 0 && cuts > 100)
    var dmg: rt.Buf = rt.buf_new()
    var wrong: usize = 0
    var k: usize = 0
    var errs: usize = 0
    while k < 80 {
        rt.buf_clear(&dmg)
        rt.buf_push_bytes(&dmg, F_9.p as u64, F_9.length())
        let at: usize = 4 + (k * 113) % (F_9.length() - 8)
        rt.st8(rt.buf_ptr(&dmg), at, rt.ld8(rt.buf_ptr(&dmg), at) ^ ((1 + k % 7) as u8))
        rt.buf_clear(&o)
        let r: u32 = dec(view(&dmg), 0, &o)
        if r == 0 as u32 && !is_plain(&o, PLAIN) {
            wrong = wrong + 1
        }
        if r != 0 as u32 {
            errs = errs + 1
        }
        k = k + 1
    }
    check(&t, "damaged streams: never a wrong answer", wrong == 0 && errs > 70)
    // the CRCs: the block CRC (octets 10..13) and the stream CRC (the last 4 octets before padding are hard to
    // locate, so flip the block CRC and check that it is Checksum)
    rt.buf_clear(&dmg)
    rt.buf_push_bytes(&dmg, F_9.p as u64, F_9.length())
    rt.st8(rt.buf_ptr(&dmg), 10, rt.ld8(rt.buf_ptr(&dmg), 10) ^ 0x10 as u8)
    rt.buf_clear(&o)
    check(&t, "a wrong block CRC is Checksum", dec(view(&dmg), 0, &o) == 3 as u32)
    rt.buf_free(&dmg)
    rt.buf_clear(&o)
    check(&t, "limit == size passes", dec(F_9, PLAIN.length(), &o) == 0 as u32 && is_plain(&o, PLAIN))
    rt.buf_clear(&o)
    check(&t, "limit == size - 1 is TooLarge", dec(F_9, PLAIN.length() - 1, &o) == 5 as u32 && rt.buf_len(&o) <= PLAIN.length() - 1)
    rt.buf_clear(&o)
    check(&t, "the runs bomb under a limit of 50000", dec(F_RUNS, 50000, &o) == 5 as u32 && rt.buf_len(&o) <= 50000)
    // streaming
    var pieces: [usize; 4] = [1, 13, 4096, 100000]
    var pi: usize = 0
    while pi < 4 {
        var s2: rt.Buf = rt.buf_new()
        check(&t, "stream-decode level 9", stream_dec(path, F_9, pieces[pi], &s2) == 0 as u32 && is_plain(&s2, PLAIN))
        rt.buf_clear(&s2)
        check(&t, "stream-decode two streams", stream_dec(path, F_MULTI, pieces[pi], &s2) == 0 as u32 && is_plain(&s2, PLAIN))
        rt.buf_clear(&s2)
        check(&t, "stream-decode long runs", stream_dec(path, F_RUNS, pieces[pi], &s2) == 0 as u32 && is_plain(&s2, view(&runs)))
        rt.buf_free(&s2)
        pi = pi + 1
    }
    rt.buf_free(&runs)
    rt.buf_free(&o)
    fs.remove(path) catch false
    return finish(&t)
}
