// expect_exit: 0
// ERZEUGT von lib/rc/erzeuge_tests.sh: Zeile 1 und der Rumpf aus
// lib/rc/teile/833_arc_gc_wurzel.fi, dazwischen tests/modules/rc.fi WOERTLICH.
// Modul 'arc' — `Arc[T]` aus SPEC §3.4: geteilter Besitz mit ATOMAREM
// Zaehler. Runde 47.
//
// `Rc[T]` (lib/rc/rc.fi) und `Arc[T]` sind absichtlich GETRENNTE Typen:
// einfaediger Code soll den atomaren Zaehler nicht bezahlen (SPEC §3.4).
// Der Unterschied steckt an genau vier Stellen — Erhoehen und Erniedrigen
// des starken und des schwachen Zaehlers — und er ist echt: dort steht
// `__atomar_addieren`, und das ist im Assembler ein `lock xadd`
// (compiler/src/atomar.rs, Nachweis tools/atomar/run.sh).
//
// Benutzung aus tests/:   die Datei wird WOERTLICH eingesetzt
//                         (lib/rc/erzeuge_tests.sh, wie bei rc.fi)
//
// ------------------------------------------------------------------ EHRLICH
//
// E1  FADENSICHER IST DER ZAEHLER, NICHT ALLES. `arc_klonen` und
//     `arc_freigeben` sind mit `lock xadd` korrekt, auch wenn mehrere Faeden
//     gleichzeitig zugreifen: nur der Faden, der beim Erniedrigen die 1 sieht,
//     gibt frei — deshalb kann NIEMALS doppelt freigegeben werden.
//     `aufwerten` (schwach -> stark) braucht dagegen einen Vergleichs-Tausch
//     (compare_exchange); mit reinem fetch-add laesst sich das Wettrennen
//     "letzter starker Verweis faellt genau jetzt weg" nicht schliessen.
//     Runde 47 baut bewusst NUR fetch-add. `aufwerten` ist damit im heutigen
//     Firn (SPEC §7: EIN Faden) richtig, aber es ist keine Zusage fuer
//     spaeter. Das steht so in docs/RUNDE47.md und wird nicht schoengeredet.
//
// E2  ZYKLEN LECKEN, genau wie bei `Rc`. Zwei `Arc`, die sich gegenseitig
//     halten, werden nie frei — sichtbar gemacht in tests/833. Wer Zyklen
//     hat, nimmt `AtomSchwachverweis` (bricht ihn von Hand) oder `Gc[T]`
//     (loest ihn auf, SPEC §3.5).
//
// E3  ZUSAMMENSPIEL MIT DEM TRACING-GC (der Punkt dieser Runde):
//       * Die Arc-Halde ist ein eigenes mmap-Gebiet. Der Sammler kennt sie
//         NICHT — er findet Bloecke nur in seinen eigenen Chunks.
//       * Daraus folgt: ein `Gc[T]` im WERT eines `Arc` ist fuer den Sammler
//         unsichtbar und sein Ziel wird eingesammelt, obwohl es noch benutzt
//         wird. Das ist kein Sonderfall, das ist die Regel fuer JEDEN
//         Speicher ausserhalb des GC-Heaps.
//       * Deshalb gibt es seit Runde 47 `gc_wurzel_anmelden(p, bytes)`:
//         wer `Gc[T]` in einen `Arc` legt, meldet dessen Wertbereich als
//         externe Wurzel an (`arc_wert_adresse` + `arc_groesse_von`) und
//         beim Freigeben wieder ab. Nachweis in tests/834 — MIT und OHNE.
//       * KEIN DOPPELTES FREIGEBEN, und zwar aus einem strukturellen Grund:
//         der Zaehler entscheidet ausschliesslich ueber den ARC-BLOCK (er
//         geht in die Freiliste der Arc-Halde), der Sammler ausschliesslich
//         ueber GC-OBJEKTE (er kennt nur seine Chunks). Die beiden
//         Speicherbereiche ueberschneiden sich nicht, also kann keiner
//         freigeben, was dem anderen gehoert.
//
// E4  `Arc` ist wie `Rc` IMMER UNVERAENDERLICH (SPEC §3.4). `arc_lesen`
//     liefert eine Kopie; es gibt in diesem Modul keine schreibende Funktion.
//
// E5  Wie bei rc.fi: Stufe 0 hat keine Methoden (`Arc[T].neu` ist
//     `arc_neu`), kein `inout` (die Halde ist ein `*mut ArcHeap`), und der
//     Erfolgswert kommt ueber einen Ausgabezeiger, weil die
//     Monomorphisierung Typargumente in der Nutzlast einer Fehlerunion
//     nicht einsetzt. Die Allokation bleibt fehlbar (DESIGNZIELE §2) und
//     das Ergebnis ist `#[must_consume]`.

export {
    AllocError, ArcHeap, Atomverweis, AtomSchwachverweis,
    arc_heap_init, arc_heap_frei, arc_heap_kapazitaet, arc_heap_lebende,
    arc_heap_belegte_bytes, arc_heap_allokationen, arc_heap_freigaben,
    arc_groesse_von, arc_ld64, arc_st64,
    arc_neu, arc_leer, arc_ist_leer, arc_lesen, arc_klonen, arc_freigeben,
    arc_stark_zahl, arc_schwach_zahl, arc_gleich,
    arc_roh_adresse, arc_wert_adresse, arc_roh_verweis,
    aweak_von, aweak_leer, aweak_ist_leer, aufwerten_atomar, aweak_freigeben,
    aweak_stark_zahl, aweak_roh_adresse
}

error AllocError { OutOfMemory }

const ARC_SYS_MMAP: i64 = 9
const ARC_SYS_MUNMAP: i64 = 11
const ARC_PROT_READ_WRITE: i64 = 3
const ARC_MAP_PRIVATE_ANON: i64 = 34

// Zweierkomplement von 1: Erniedrigen ist die Addition davon. Ein eigenes
// Primitiv fuer die Subtraktion waere Ballast (compiler/src/atomar.rs).
const ARC_MINUS1: u64 = 18446744073709551615

// Blockkopf: 32 Byte, danach der Wert.
//   +0   stark      u64   starke Verweise      (ATOMAR)
//   +8   schwach    u64   schwache Verweise    (ATOMAR)
//   +16  klasse     u64   Groessenklasse
//   +24  naechster  u64   Freilisten-Verkettung (nur wenn frei)
//   +32  wert       T
const ARC_KOPF: usize = 32
const ARC_KLASSEN: usize = 8
const ARC_KLASSE0: usize = 64

// `Arc[T]` aus SPEC §3.4. 'block' ist 0, wenn der Verweis leer ist.
struct Atomverweis[T] { block: usize }

// `Weak[T]` zu einem `Arc[T]` — haelt den Wert NICHT am Leben.
struct AtomSchwachverweis[T] { block: usize }

struct ArcHeap {
    basis: usize,
    kapazitaet: usize,
    naechster: usize,
    frei: [usize; 8],
    lebende: usize,
    belegt: usize,
    allokationen: usize,
    freigaben: usize,
}

struct ArcPaar[T] { a: T, b: T }

fn arc_seiten(n: usize) -> usize {
    return (n + 4095 as usize) / 4096 as usize * 4096 as usize
}

fn arc_ld64(adr: usize) -> u64 {
    return *(adr as *mut u64)
}

fn arc_st64(adr: usize, v: u64) {
    *(adr as *mut u64) = v
}

// Schrittweite (Groesse einschliesslich Ausrichtung) des Typs T.
fn arc_groesse_von[T: Any](muster: T) -> usize {
    var p: ArcPaar[T] = ArcPaar[T]{ a: muster, b: muster }
    return (&p.b) as usize - (&p.a) as usize
}

fn arc_klasse_bytes(k: usize) -> usize {
    var b: usize = ARC_KLASSE0
    var i: usize = 0 as usize
    while i < k {
        b = b * 2 as usize
        i = i + 1 as usize
    }
    return b
}

fn arc_klasse_fuer(gesamt: usize) -> usize {
    var k: usize = 0 as usize
    while k < ARC_KLASSEN {
        if gesamt <= arc_klasse_bytes(k) {
            return k
        }
        k = k + 1 as usize
    }
    return ARC_KLASSEN
}

fn arc_heap_init(h: *mut ArcHeap, bytes: usize) -> bool {
    (*h).basis = 0 as usize
    (*h).kapazitaet = 0 as usize
    (*h).naechster = 0 as usize
    (*h).lebende = 0 as usize
    (*h).belegt = 0 as usize
    (*h).allokationen = 0 as usize
    (*h).freigaben = 0 as usize
    var i: usize = 0 as usize
    while i < ARC_KLASSEN {
        (*h).frei[i] = 0 as usize
        i = i + 1 as usize
    }
    if bytes == 0 as usize {
        return false
    }
    let len: usize = arc_seiten(bytes)
    let r: i64 = syscall(ARC_SYS_MMAP, 0, len as i64, ARC_PROT_READ_WRITE,
                         ARC_MAP_PRIVATE_ANON, 0 - 1, 0)
    if r < 0 && r > 0 - 4096 {
        return false
    }
    if r == 0 {
        return false
    }
    (*h).basis = r as usize
    (*h).kapazitaet = len
    return true
}

fn arc_heap_frei(h: *mut ArcHeap) {
    if (*h).basis != 0 as usize {
        syscall(ARC_SYS_MUNMAP, (*h).basis as i64, (*h).kapazitaet as i64)
    }
    (*h).basis = 0 as usize
    (*h).kapazitaet = 0 as usize
    (*h).naechster = 0 as usize
}

fn arc_heap_kapazitaet(h: *mut ArcHeap) -> usize { return (*h).kapazitaet }
fn arc_heap_lebende(h: *mut ArcHeap) -> usize { return (*h).lebende }
fn arc_heap_belegte_bytes(h: *mut ArcHeap) -> usize { return (*h).belegt }
fn arc_heap_allokationen(h: *mut ArcHeap) -> usize { return (*h).allokationen }
fn arc_heap_freigaben(h: *mut ArcHeap) -> usize { return (*h).freigaben }

fn arc_block_holen(h: *mut ArcHeap, nutzlast: usize) -> usize {
    let k: usize = arc_klasse_fuer(ARC_KOPF + nutzlast)
    if k >= ARC_KLASSEN {
        return 0 as usize
    }
    let gr: usize = arc_klasse_bytes(k)
    var adr: usize = (*h).frei[k]
    if adr != 0 as usize {
        (*h).frei[k] = arc_ld64(adr + 24 as usize) as usize
    } else {
        if (*h).basis == 0 as usize {
            return 0 as usize
        }
        if (*h).naechster + gr > (*h).kapazitaet {
            return 0 as usize
        }
        adr = (*h).basis + (*h).naechster
        (*h).naechster = (*h).naechster + gr
    }
    arc_st64(adr + 0 as usize, 0 as u64)
    arc_st64(adr + 8 as usize, 0 as u64)
    arc_st64(adr + 16 as usize, k as u64)
    arc_st64(adr + 24 as usize, 0 as u64)
    (*h).lebende = (*h).lebende + 1 as usize
    (*h).belegt = (*h).belegt + gr
    (*h).allokationen = (*h).allokationen + 1 as usize
    return adr
}

fn arc_block_zurueck(h: *mut ArcHeap, adr: usize) {
    let k: usize = arc_ld64(adr + 16 as usize) as usize
    if k >= ARC_KLASSEN {
        return
    }
    arc_st64(adr + 24 as usize, (*h).frei[k] as u64)
    (*h).frei[k] = adr
    (*h).lebende = (*h).lebende - 1 as usize
    (*h).belegt = (*h).belegt - arc_klasse_bytes(k)
    (*h).freigaben = (*h).freigaben + 1 as usize
}

// Legt 'wert' auf der Halde ab und liefert einen starken Verweis in '*aus'.
// FEHLBAR (DESIGNZIELE §2); das Ergebnis ist '#[must_consume]'.
fn arc_neu[T: Any](h: *mut ArcHeap, wert: T, aus: *mut Atomverweis[T]) -> AllocError!bool {
    (*aus).block = 0 as usize
    let gr: usize = arc_groesse_von[T](wert)
    let adr: usize = arc_block_holen(h, gr)
    if adr == 0 as usize {
        return AllocError::OutOfMemory
    }
    arc_st64(adr + 0 as usize, 1 as u64)
    arc_st64(adr + 8 as usize, 0 as u64)
    *((adr + ARC_KOPF) as *mut T) = wert
    (*aus).block = adr
    return true
}

fn arc_leer[T: Any]() -> Atomverweis[T] {
    return Atomverweis[T]{ block: 0 as usize }
}

fn arc_ist_leer[T: Any](r: Atomverweis[T]) -> bool {
    return r.block == 0 as usize
}

// NUR LESEN (SPEC §3.4): geliefert wird eine Kopie.
fn arc_lesen[T: Any](r: Atomverweis[T]) -> T {
    return *((r.block + ARC_KOPF) as *mut T)
}

// ATOMAR: `lock xadd`. Zwei Faeden, die gleichzeitig klonen, koennen keine
// Erhoehung verlieren.
fn arc_klonen[T: Any](r: Atomverweis[T]) -> Atomverweis[T] {
    if r.block == 0 as usize {
        return Atomverweis[T]{ block: 0 as usize }
    }
    __atomar_addieren(r.block as *mut u64, 1)
    return Atomverweis[T]{ block: r.block }
}

// ATOMAR erniedrigen. KEIN DOPPELTES FREIGEBEN: freigegeben wird nur von dem
// Aufruf, der beim Erniedrigen den alten Wert 1 SIEHT — und den sieht genau
// einer, weil `lock xadd` den alten Wert unteilbar zurueckliefert.
fn arc_freigeben[T: Any](h: *mut ArcHeap, r: *mut Atomverweis[T]) {
    let adr: usize = (*r).block
    if adr == 0 as usize {
        return
    }
    (*r).block = 0 as usize
    let alt: u64 = __atomar_addieren(adr as *mut u64, ARC_MINUS1)
    if alt == 0 as u64 {
        // War schon 0 — die Erniedrigung war ein Fehler des Aufrufers.
        // Wieder geradebiegen statt still unterlaufen zu lassen.
        __atomar_addieren(adr as *mut u64, 1)
        return
    }
    if alt != 1 as u64 {
        return
    }
    if arc_ld64(adr + 8 as usize) == 0 as u64 {
        arc_block_zurueck(h, adr)
    }
}

fn arc_stark_zahl[T: Any](r: Atomverweis[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return arc_ld64(r.block + 0 as usize)
}

fn arc_schwach_zahl[T: Any](r: Atomverweis[T]) -> u64 {
    if r.block == 0 as usize {
        return 0 as u64
    }
    return arc_ld64(r.block + 8 as usize)
}

fn arc_gleich[T: Any](a: Atomverweis[T], b: Atomverweis[T]) -> bool {
    return a.block == b.block
}

// Rohzugriff (SPEC §3.6). `arc_wert_adresse` ist zugleich die Adresse, die
// man dem Sammler als externe Wurzel meldet, wenn im Wert ein `Gc[T]` steckt
// (siehe E3 oben und tests/834).
fn arc_roh_adresse[T: Any](r: Atomverweis[T]) -> usize { return r.block }

fn arc_roh_verweis[T: Any](adr: usize) -> Atomverweis[T] {
    return Atomverweis[T]{ block: adr }
}

fn arc_wert_adresse[T: Any](r: Atomverweis[T]) -> usize {
    if r.block == 0 as usize {
        return 0 as usize
    }
    return r.block + ARC_KOPF
}

fn aweak_von[T: Any](r: Atomverweis[T]) -> AtomSchwachverweis[T] {
    if r.block == 0 as usize {
        return AtomSchwachverweis[T]{ block: 0 as usize }
    }
    __atomar_addieren((r.block + 8 as usize) as *mut u64, 1)
    return AtomSchwachverweis[T]{ block: r.block }
}

fn aweak_leer[T: Any]() -> AtomSchwachverweis[T] {
    return AtomSchwachverweis[T]{ block: 0 as usize }
}

fn aweak_ist_leer[T: Any](w: AtomSchwachverweis[T]) -> bool {
    return w.block == 0 as usize
}

fn aweak_roh_adresse[T: Any](w: AtomSchwachverweis[T]) -> usize { return w.block }

fn aweak_stark_zahl[T: Any](w: AtomSchwachverweis[T]) -> u64 {
    if w.block == 0 as usize {
        return 0 as u64
    }
    return arc_ld64(w.block + 0 as usize)
}

// Aufwertung: leerer Verweis, wenn der starke Zaehler schon 0 ist.
//
// EHRLICH (E1): dieses Verfahren — erhoehen und dann zuruecknehmen, falls
// der alte Wert 0 war — schliesst das Wettrennen mit einem gleichzeitig
// laufenden `arc_freigeben` NICHT. Dafuer braucht es einen Vergleichs-Tausch,
// den Runde 47 bewusst nicht baut. Im heutigen Firn (ein Faden, SPEC §7) ist
// es korrekt; als Fadenzusage gilt es NICHT.
fn aufwerten_atomar[T: Any](w: AtomSchwachverweis[T]) -> Atomverweis[T] {
    if w.block == 0 as usize {
        return Atomverweis[T]{ block: 0 as usize }
    }
    let alt: u64 = __atomar_addieren(w.block as *mut u64, 1)
    if alt == 0 as u64 {
        __atomar_addieren(w.block as *mut u64, ARC_MINUS1)
        return Atomverweis[T]{ block: 0 as usize }
    }
    return Atomverweis[T]{ block: w.block }
}

fn aweak_freigeben[T: Any](h: *mut ArcHeap, w: *mut AtomSchwachverweis[T]) {
    let adr: usize = (*w).block
    if adr == 0 as usize {
        return
    }
    (*w).block = 0 as usize
    let alt: u64 = __atomar_addieren((adr + 8 as usize) as *mut u64, ARC_MINUS1)
    if alt == 0 as u64 {
        __atomar_addieren((adr + 8 as usize) as *mut u64, 1)
        return
    }
    if alt != 1 as u64 {
        return
    }
    if arc_ld64(adr + 0 as usize) == 0 as u64 {
        arc_block_zurueck(h, adr)
    }
}

// RUNDE 47 — DAS ZUSAMMENSPIEL VON `Arc[T]` UND DEM TRACING-GC.
//
// Die Arc-Halde ist ein eigenes mmap-Gebiet; der Sammler kennt nur seine
// eigenen Chunks. Ein `Gc[T]` im WERT eines `Arc` ist fuer ihn also
// unsichtbar. Dieser Test zeigt beide Seiten in EINEM Lauf:
//
//   A  OHNE Anmeldung wird das Ziel eingesammelt, obwohl der `Arc` es haelt.
//      Das ist der Fehler, den man macht, wenn man es nicht weiss — hier
//      steht er als Messung, nicht als Warnung.
//   B  MIT `gc_wurzel_anmelden(arc_wert_adresse(a), groesse)` ueberlebt es
//      jeden Sammellauf und ist weiter lesbar.
//   C  Nach `gc_wurzel_abmelden` stirbt es wieder.
//   D  KEIN DOPPELTES FREIGEBEN: der Zaehler entscheidet ueber den ARC-BLOCK,
//      der Sammler ueber die GC-OBJEKTE. Beide Buchhaltungen stimmen.
//
// WICHTIG FUER DIE GUELTIGKEIT DES TESTS: kein `Gc[T]` und keine Kopie eines
// `Halter` darf im LEBENDEN Rahmen von `lauf` liegen, wenn gesammelt wird —
// der Stapelscan ist konservativ (SPEC 3.5.3) und wuerde das Objekt sonst
// selbst am Leben halten. Deshalb liefern alle Pruefhelfer nur `bool`/`u64`
// und sind rekursiv mit Polster (dieselbe Technik wie dom_observer_lebt()
// in lib/dom/dom.fi und wie tests/820).

gc class Blatt {
    naechster: Gc[Blatt],
    wert: u64,
}

// Der Wert im Arc traegt einen GC-Zeiger — genau der Fall, um den es geht.
struct Halter {
    knoten: Gc[Blatt],
    zahl: u64,
}

fn polster() -> u64 {
    var fuell: [u64; 128] = [0; 128]
    let fp: u64 = (&fuell) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    return *((fp + 8) as *mut u64)
}

fn ablegen(h: *mut ArcHeap, aus: *mut Atomverweis[Halter], wo: *mut GcWeak[Blatt],
           tiefe: u64) -> AllocError!bool {
    if polster() != 1 {
        return false
    }
    if tiefe > 0 {
        return try ablegen(h, aus, wo, tiefe - 1)
    }
    let k: Gc[Blatt] = try gc Blatt{ naechster: gc_null[Blatt](), wert: 4711 }
    *wo = weak(k)
    return try arc_neu[Halter](h, Halter{ knoten: k, zahl: 1 as u64 }, aus)
}

// Lebt das Ziel noch? Liefert BOOL, nie einen Gc-Zeiger.
fn lebt(w: GcWeak[Blatt], tiefe: u64) -> bool {
    if polster() != 1 {
        return false
    }
    if tiefe > 0 {
        return lebt(w, tiefe - 1)
    }
    return stark(w) != gc_null[Blatt]()
}

// Wert des Ziels, 0 wenn tot. Liefert U64, nie einen Gc-Zeiger.
fn wert_von(w: GcWeak[Blatt], tiefe: u64) -> u64 {
    if polster() != 1 {
        return 0
    }
    if tiefe > 0 {
        return wert_von(w, tiefe - 1)
    }
    if stark(w) == gc_null[Blatt]() {
        return 0
    }
    return stark(w).wert
}

// Der eigentliche Lesezugriff durch den Arc, ohne Struktur-Kopie im Rahmen
// des Aufrufers: die Adresse des Feldes wird gerechnet und der Knoten nur
// als Zahl weitergereicht.
fn wert_im_arc(a: Atomverweis[Halter], tiefe: u64) -> u64 {
    if polster() != 1 {
        return 0
    }
    if tiefe > 0 {
        return wert_im_arc(a, tiefe - 1)
    }
    let h: Halter = arc_lesen[Halter](a)
    if h.knoten == gc_null[Blatt]() {
        return 0
    }
    return h.knoten.wert
}

fn main() -> i32 {
    if !gc_init() {
        return 89
    }
    var h: ArcHeap = ArcHeap{
        basis: 0 as usize, kapazitaet: 0 as usize, naechster: 0 as usize,
        frei: [0 as usize; 8], lebende: 0 as usize, belegt: 0 as usize,
        allokationen: 0 as usize, freigaben: 0 as usize
    }
    if !arc_heap_init(&h, 65536 as usize) {
        return 90
    }
    let rc: i32 = lauf(&h) catch 91
    arc_heap_frei(&h)
    return rc
}

fn lauf(h: *mut ArcHeap) -> AllocError!i32 {
    let muster: Halter = Halter{ knoten: gc_null[Blatt](), zahl: 0 as u64 }
    let gr: usize = arc_groesse_von[Halter](muster)
    if gr < 16 as usize {
        return 1
    }

    // --- A: OHNE Anmeldung ---------------------------------------------------
    var a: Atomverweis[Halter] = arc_leer[Halter]()
    var wa: GcWeak[Blatt] = weak_null[Blatt]()
    if !(try ablegen(h, &a, &wa, 2)) {
        return 2
    }
    if !lebt(wa, 2) {
        return 3
    }
    if wert_im_arc(a, 2) != 4711 {
        return 4
    }
    if gc_wurzeln() != 0 {
        return 5
    }
    // Runde 49: die toten Rahmen von `ablegen`/`lebt` VOR dem Sammellauf
    // saeubern (gc.fi::gc_stapel_saeubern). Ohne das haengt die Aussage
    // dieses Abschnitts an der Rahmenaufteilung des Sammlers — sie kippte in
    // Runde 49, als die Allokation um den Mehrfadenbetrieb erweitert wurde.
    gc_stapel_saeubern()
    gc_collect()
    gc_collect()
    // Der Sammler hat den Knoten eingesammelt — der Arc haelt ihn NICHT.
    if lebt(wa, 2) {
        return 6
    }
    // Der Arc-Block selbst lebt unveraendert weiter (getrennte Speicher).
    if arc_heap_lebende(h) != 1 as usize {
        return 7
    }
    if arc_stark_zahl[Halter](a) != 1 as u64 {
        return 8
    }
    arc_freigeben[Halter](h, &a)
    if arc_heap_lebende(h) != 0 as usize {
        return 9
    }

    // --- B: MIT Anmeldung ----------------------------------------------------
    var b: Atomverweis[Halter] = arc_leer[Halter]()
    var wb: GcWeak[Blatt] = weak_null[Blatt]()
    if !(try ablegen(h, &b, &wb, 2)) {
        return 10
    }
    if !gc_wurzel_anmelden(arc_wert_adresse[Halter](b) as *mut u8, gr as u64) {
        return 11
    }
    if gc_wurzeln() != 1 {
        return 12
    }
    gc_collect()
    gc_collect()
    gc_collect()
    if !lebt(wb, 2) {
        return 13
    }
    if wert_von(wb, 2) != 4711 {
        return 14
    }
    // Auch DURCH den Arc gelesen ist der Zeiger noch gut.
    if wert_im_arc(b, 2) != 4711 {
        return 15
    }

    // --- Anmeldung ueberlebt viele Sammellaeufe unter Last --------------------
    if !(try muell_erzeugen(2000, 2)) {
        return 16
    }
    gc_collect()
    if wert_im_arc(b, 2) != 4711 {
        return 17
    }
    if wert_von(wb, 2) != 4711 {
        return 18
    }

    // --- C: abmelden -> das Ziel stirbt --------------------------------------
    if !gc_wurzel_abmelden(arc_wert_adresse[Halter](b) as *mut u8) {
        return 19
    }
    if gc_wurzeln() != 0 {
        return 20
    }
    if gc_wurzel_abmelden(arc_wert_adresse[Halter](b) as *mut u8) {
        return 21
    }
    gc_stapel_saeubern()
    gc_collect()
    gc_collect()
    if lebt(wb, 2) {
        return 22
    }

    // --- D: die Buchhaltung beider Seiten stimmt ------------------------------
    arc_freigeben[Halter](h, &b)
    if arc_heap_lebende(h) != 0 as usize {
        return 23
    }
    if arc_heap_allokationen(h) != arc_heap_freigaben(h) {
        return 24
    }
    if arc_heap_belegte_bytes(h) != 0 as usize {
        return 25
    }
    if gc_collections() == 0 {
        return 26
    }
    return 0
}

fn muell_erzeugen(n: u64, tiefe: u64) -> AllocError!bool {
    if polster() != 1 {
        return false
    }
    if tiefe > 0 {
        return try muell_erzeugen(n, tiefe - 1)
    }
    var i: u64 = 0
    while i < n {
        let muell: Gc[Blatt] = try gc Blatt{ naechster: gc_null[Blatt](), wert: i }
        if muell == gc_null[Blatt]() {
            return false
        }
        i = i + 1
    }
    return true
}
