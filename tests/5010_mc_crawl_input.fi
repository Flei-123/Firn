// expect_exit: 0
import std.rt
import mc.mc_world
import mc.mc_render_world
import mc.mc_input
import mc.mc_math

static mut g_fail: i32 = 0

fn check(c: bool, code: i32) {
    if !c {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_hex_u64(&o, code as u64, 2)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn near(a: f64, b: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d < 0.000000001
}

fn fill(ids: u64, x0: i32, x1: i32, ly0: i32, ly1: i32, z0: i32, z1: i32, id: u16) {
    var ly: i32 = ly0
    while ly <= ly1 {
        var z: i32 = z0
        while z <= z1 {
            var x: i32 = x0
            while x <= x1 {
                rt.st16(ids, ((ly * 16 + z) * 16 + x) as usize, id)
                x = x + 1
            }
            z = z + 1
        }
        ly = ly + 1
    }
}

fn tick(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32) {
    var ev: mc_input.InputEvents = mc_input.input_events_new()
    ev.keys = keys
    mc_input.player_tick(p, &ev, w, tb, 0 - 64)
}

fn walk(p: *mut mc_input.Player, w: *mut mc_world.World, tb: *mut mc_input.InputTables, keys: u32, ticks: i32) {
    var t: i32 = 0
    while t < ticks {
        tick(p, w, tb, keys)
        t = t + 1
    }
}

const STONE: u16 = 1 as u16
const SLAB_TOP: u16 = 2 as u16

fn main() -> i32 {
    var tb: mc_input.InputTables = mc_input.InputTables { pick: rt.heap_alloc(8), solid: rt.heap_alloc(16), n: 8 }
    var i: usize = 0
    while i < 8 {
        rt.st8(tb.pick, i, 1 as u8)
        rt.st16(tb.solid, i, 0 as u16)
        i = i + 1
    }
    rt.st16(tb.solid, STONE as usize, 1 as u16)
    rt.st16(tb.solid, SLAB_TOP as usize, (mc_math.SHAPE_BASE + 2) as u16)

    let ids: u64 = rt.heap_alloc(2 * 4096 * 2)
    i = 0
    while i < 8192 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    fill(ids, 0, 15, 0, 2, 0, 15, STONE)
    fill(ids, 0, 4, 4, 4, 6, 11, STONE)
    fill(ids, 8, 12, 4, 4, 6, 11, SLAB_TOP)
    var w: mc_world.World = mc_world.world_new()
    mc_world.world_put(&w, mc_render_world.wr_make_chunk(0, 0, 2, ids))

    var c: mc_input.Player = mc_input.player_new(2.5, 0.0 - 61.0, 7.5)
    c.low_pose = true
    walk(&c, &w, &tb, 0 as u32, 2)
    check(c.low_pose && !c.crouched, 1)
    let z0: f64 = c.z
    walk(&c, &w, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 10)
    check(c.low_pose && !c.sprinting && !c.swimming, 2)
    let dz: f64 = c.z - z0
    check(dz > 0.4 && dz < 0.9, 3)
    check(near(mc_input.player_height(&c), 0.6) && near(mc_input.player_eye(&c), 0.4), 4)
    var n: i32 = 0
    while c.z > 5.6 && n < 200 {
        tick(&c, &w, &tb, mc_input.K_BACK)
        n = n + 1
    }
    check(c.z <= 5.6 && n < 200, 5)
    walk(&c, &w, &tb, 0 as u32, 1)
    check(!c.low_pose && !c.crouched, 6)
    check(near(mc_input.player_eye(&c), 1.62), 7)

    var s: mc_input.Player = mc_input.player_new(10.5, 0.0 - 61.0, 4.0)
    walk(&s, &w, &tb, mc_input.K_FORWARD, 40)
    check(s.z < 5.75 && !s.crouched && !s.low_pose, 8)
    walk(&s, &w, &tb, mc_input.K_FORWARD | mc_input.K_SNEAK, 60)
    check(s.z > 6.5 && s.sneaking && !s.low_pose, 9)
    check(near(mc_input.player_height(&s), 1.5) && near(mc_input.player_eye(&s), 1.27), 10)
    walk(&s, &w, &tb, mc_input.K_FORWARD, 1)
    check(!s.sneaking && s.crouched && !s.low_pose, 11)
    check(near(mc_input.player_height(&s), 1.5) && near(mc_input.player_eye(&s), 1.27), 12)
    let zs: f64 = s.z
    walk(&s, &w, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 10)
    check(!s.sprinting && s.crouched, 13)
    let ds: f64 = s.z - zs
    check(ds > 0.4 && ds < 0.9, 14)
    n = 0
    while s.z < 12.4 && n < 300 {
        tick(&s, &w, &tb, mc_input.K_FORWARD)
        n = n + 1
    }
    check(s.z >= 12.4 && n < 300, 15)
    walk(&s, &w, &tb, 0 as u32, 1)
    check(!s.crouched && !s.low_pose, 16)
    check(near(mc_input.player_eye(&s), 1.62), 17)
    walk(&s, &w, &tb, mc_input.K_FORWARD | mc_input.K_SPRINT, 3)
    check(s.sprinting, 18)

    mc_world.world_free(&w)
    if g_fail != 0 { return 1 }
    return 0
}
