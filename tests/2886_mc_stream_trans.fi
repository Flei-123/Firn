// expect_exit: 0
// tests/2886_mc_stream_trans.fi -- mc_stream translucent pass (stream_set_translucent): water / glass meshed separately (F_TRANS),
// drawn after all opaque sections back to front (Backend.set_pass). Image == wr_render with wr_set_translucent (same world, same poses);
// the pass is visible (differs from the single pass image) and drawn_trans > 0.
import std.rt
import std.io
import mc.mc_chunk
import mc.mc_world
import mc.mc_mesh
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_backend
import mc.mc_terrain
import mc.mc_render_world
import mc.mc_stream

const NSEC: i32 = 6
const R: i32 = 2
const CLEAR: u32 = 0xFF3C2814 as u32
const WATER_Y: usize = 44

fn check(c: bool, code: i32) {
    if !c {
        io.fmt_print_line(f"FAIL code {code}")
        rt.finish(code as i64)
    }
}

fn fl(v: f64) -> i32 {
    var x: i32 = v as i32
    if (x as f64) > v { x = x - 1 }
    return x
}

#[allow_escape]
fn load_all(w: *mut mc_world.World, s: *mut mc_stream.Stream, ids: u64) {
    var cz: i32 = 0 - R
    while cz <= R {
        var cx: i32 = 0 - R
        while cx <= R {
            mc_terrain.terrain_column(cx, cz, NSEC, ids)
            // lake: air below WATER_Y becomes water (id 4); a glass slab (id 5) floats over column (0, 0)
            var y: usize = 0
            while y < WATER_Y {
                var i: usize = 0
                while i < 256 {
                    if rt.ld16(ids, y * 256 + i) == 0 as u16 { rt.st16(ids, y * 256 + i, 4 as u16) }
                    i = i + 1
                }
                y = y + 1
            }
            if cx == 0 && cz == 0 {
                var z: usize = 4
                while z < 10 {
                    var x: usize = 4
                    while x < 10 {
                        rt.st16(ids, 56 * 256 + z * 16 + x, 5 as u16)
                        x = x + 1
                    }
                    z = z + 1
                }
            }
            check(mc_world.world_put(w, mc_render_world.wr_make_chunk(cx, cz, NSEC as usize, ids)), 50)
            if s as u64 != 0 { check(mc_stream.stream_chunk_loaded(s, w, cx, cz), 51) }
            cx = cx + 1
        }
        cz = cz + 1
    }
}

fn pose(cam: *mut mc_camera.Camera, x: f64, z: f64, dx: f64, dz: f64) {
    mc_camera.camera_set_pos(cam, x, 60.0, z)
    mc_camera.camera_look_at(cam, x + dx, 40.0, z + dz)
    mc_camera.camera_update(cam)
}

fn diff(a: *mut mc_raster.Raster, b: *mut mc_raster.Raster) -> i32 {
    var n: i32 = 0
    var y: i32 = 0
    while y < 54 {
        var x: i32 = 0
        while x < 96 {
            if mc_raster.raster_pixel(a, x, y) != mc_raster.raster_pixel(b, x, y) { n = n + 1 }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

#[allow_escape]
fn frame(s: *mut mc_stream.Stream, w: *mut mc_world.World, b: *mut mc_backend.Backend, cam: *mut mc_camera.Camera) -> u64 {
    (*b).begin((*b).obj, cam as u64, CLEAR)
    let tris: u64 = mc_stream.stream_frame(s, w, b, cam)
    (*b).end((*b).obj)
    return tris
}

#[allow_escape]
fn main() -> i32 {
    var tb: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: 0, tiles: 0 }
    mc_terrain.terrain_tables(&tb)
    var f: usize = 0
    while f < 6 {
        rt.st16(tb.tiles, 24 + f, mc_texture.T_WATER as u16) // id 4 water
        rt.st16(tb.tiles, 30 + f, mc_texture.T_GLASS as u16) // id 5 glass
        f = f + 1
    }
    var a: mc_texture.Atlas = mc_texture.atlas_default()
    let ids: u64 = rt.heap_alloc(NSEC as usize * 4096 * 2)
    var cam: mc_camera.Camera = mc_camera.camera_new(96, 54)
    mc_camera.camera_set_lens(&cam, 70.0, 0.05, 900.0)

    var r1: mc_raster.Raster = mc_raster.raster_new(96, 54)
    mc_raster.backend_upload_atlas(&r1, &a)
    var b1: mc_backend.Backend = mc_backend.backend_cpu(&r1)
    var w1: mc_world.World = mc_world.world_new()
    var s1: mc_stream.Stream = mc_stream.stream_new(0, NSEC, 4, &tb, 0)
    mc_stream.stream_set_translucent(&s1, true, mc_texture.T_WATER, mc_texture.T_ICE, mc_texture.T_GLASS)
    // single pass stream (control)
    var r2: mc_raster.Raster = mc_raster.raster_new(96, 54)
    mc_raster.backend_upload_atlas(&r2, &a)
    var b2: mc_backend.Backend = mc_backend.backend_cpu(&r2)
    var w2: mc_world.World = mc_world.world_new()
    var s2: mc_stream.Stream = mc_stream.stream_new(0, NSEC, 4, &tb, 0)
    // reference: wr_render with the transparency pass
    var r3: mc_raster.Raster = mc_raster.raster_new(96, 54)
    mc_raster.backend_upload_atlas(&r3, &a)
    var w3: mc_world.World = mc_world.world_new()
    var wr: mc_render_world.WorldRender = mc_render_world.wr_new(0, 4, &tb)
    mc_render_world.wr_set_translucent(&wr, true, mc_texture.T_WATER, mc_texture.T_ICE, mc_texture.T_GLASS)
    load_all(&w1, &s1, ids)
    load_all(&w2, &s2, ids)
    load_all(&w3, 0 as *mut mc_stream.Stream, ids)

    var p: i32 = 0
    var vis: i32 = 0
    while p < 3 {
        if p == 0 { pose(&cam, 8.0, 8.0, 40.0, 10.0) }
        if p == 1 { pose(&cam, 20.0, 0.0 - 12.0, 0.0 - 10.0, 40.0) }
        if p == 2 { pose(&cam, 0.0 - 20.0, 20.0, 40.0, 0.0 - 20.0) }
        mc_stream.stream_flush(&s1, &w1, &b1, &cam, 400)
        mc_stream.stream_flush(&s2, &w2, &b2, &cam, 400)
        frame(&s1, &w1, &b1, &cam)
        frame(&s2, &w2, &b2, &cam)
        mc_raster.backend_begin(&r3, &cam, CLEAR)
        mc_render_world.wr_render(&wr, &w3, &r3, &cam, 0 - 1)
        mc_raster.backend_end(&r3)
        let d13: i32 = diff(&r1, &r3)
        let d12: i32 = diff(&r1, &r2)
        io.fmt_print_line(f"pose {p}: stream vs wr_render {d13} px, vs single pass {d12} px, drawn_trans {s1.st.drawn_trans}")
        check(d13 < 5, 10 + p) // measured 0 / 0 / 1 px (one pixel of a depth tie at pose 2)
        check(s1.st.drawn_trans > 0 as u32, 20 + p)
        vis = vis + d12
        p = p + 1
    }
    check(vis > 20, 30) // the pass is visible (blended water instead of cut-out)
    mc_stream.stream_free(&s1, &b1)
    mc_stream.stream_free(&s2, &b2)
    io.fmt_print_line(f"ok")
    return 0
}
