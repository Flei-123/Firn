// expect_exit: 0
// tests/4072_vec_py_index.fi -- Python-style negative index and slice on Vec (std.option, r719).
import std.io
import std.rt
import std.vec
import std.option
import std.testkit

fn slice_sum(v: *mut Vec[i64], a: i64, b: i64, want_len: usize, want_sum: i64, what: str) {
    var out: Vec[i64] = vec_new[i64]()
    let ok: bool = vec_slice_py[i64](v, a, b, &out)
    var sum: i64 = 0
    var i: usize = 0
    while i < vec_len[i64](&out) {
        sum = sum + vec_at[i64](&out, i)
        i = i + 1
    }
    testkit.check(ok && vec_len[i64](&out) == want_len && sum == want_sum, what)
    vec_free[i64](&out)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i64] = vec_new[i64]()
    var i: i64 = 1
    while i <= 5 {
        vec_push[i64](&v, i * 10)
        i = i + 1
    }
    testkit.check(vec_at_py[i64](&v, 0).val == 10, "v[0]")
    testkit.check(vec_at_py[i64](&v, -1).val == 50, "v[-1]")
    testkit.check(vec_at_py[i64](&v, -5).val == 10, "v[-5]")
    testkit.check(!vec_at_py[i64](&v, -6).has, "v[-6] out of range")
    testkit.check(!vec_at_py[i64](&v, 5).has, "v[5] out of range")
    if let Some(last) = vec_at_py[i64](&v, -1) {
        testkit.check(last == 50, "if let on v[-1]")
    } else {
        testkit.check(false, "v[-1] must exist")
    }
    slice_sum(&v, 1, 3, 2, 50, "v[1:3]")
    slice_sum(&v, 0, 5, 5, 150, "v[0:5]")
    slice_sum(&v, -2, 5, 2, 90, "v[-2:]")
    slice_sum(&v, 0, -1, 4, 100, "v[:-1]")
    slice_sum(&v, 3, 1, 0, 0, "v[3:1] empty")
    slice_sum(&v, -99, 99, 5, 150, "clamped")
    slice_sum(&v, 7, 9, 0, 0, "beyond the end")
    var e: Vec[i64] = vec_new[i64]()
    testkit.check(!vec_at_py[i64](&e, -1).has && !vec_at_py[i64](&e, 0).has, "empty vec")
    vec_free[i64](&e)
    vec_free[i64](&v)
    return testkit.finish()
}
