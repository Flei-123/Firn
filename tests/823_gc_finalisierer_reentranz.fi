// expect_exit: 71
// RUNDE 47 — EIN FINALISIERER DARF NICHT ALLOZIEREN.
//
// Eine GC-Allokation aus einem Finalisierer heraus wuerde einen Sammellauf
// MITTEN in einem Sammellauf starten: die Warteschlange, die Freilisten und
// die Fegemerker sind in diesem Augenblick halb fertig. Der Sammler wuerde
// sich selbst zerlegen.
//
// Firn laesst das nicht still passieren. Die Sperre steckt in derselben
// Pruefung, die ohnehin am Anfang jeder Allokation steht (S_INIT: 0 = kein
// gc_init, 1 = bereit, 2 = ein Finalisierer laeuft) — sie kostet den
// normalen Pfad damit NICHTS. Der Abbruch meldet sich auf Standardfehler
// und endet mit Ruecksprungwert 71.
//
// Der Kanal 2 wird vorher geschlossen, damit die Meldung das Testprotokoll
// nicht verschmutzt; geprueft wird der Ruecksprungwert. Den Meldungstext
// zeigt docs/RUNDE47.md.

const T_SYS_CLOSE: i64 = 3

gc class Fall {
    naechster: Gc[Fall],
    wert: u64,
}

fn __gc_finalisiere(art: u64, p: *mut u8) {
    if art != 3 {
        return
    }
    let f: Gc[Fall] = p as Gc[Fall]
    if f == gc_null[Fall]() {
        return
    }
    // VERBOTEN: hier bricht das Programm mit 71 ab.
    let neu: Gc[Fall] = gc Fall{ naechster: gc_null[Fall](), wert: 2 } catch gc_null[Fall]()
    if neu == gc_null[Fall]() {
        return
    }
}

fn stirbt(tiefe: u64) -> AllocError!bool {
    var fuell: [u64; 128] = [0; 128]
    let fp: u64 = (&fuell) as u64
    var iq: u64 = 0
    while iq < 128 {
        *((fp + iq * 8) as *mut u64) = iq
        iq = iq + 1
    }
    if tiefe > 0 {
        return try stirbt(tiefe - 1)
    }
    let f: Gc[Fall] = try gc Fall{ naechster: gc_null[Fall](), wert: 1 }
    return gc_finalisierer_setzen(f as *mut u8, 3)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return lauf() catch 91
}

fn lauf() -> AllocError!i32 {
    if !(try stirbt(2)) {
        return 92
    }
    syscall(T_SYS_CLOSE, 2, 0, 0, 0, 0, 0)
    gc_collect()
    // Hierhin kommt das Programm nicht: der Finalisierer hat abgebrochen.
    return 93
}
