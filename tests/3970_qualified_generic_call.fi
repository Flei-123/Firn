// expect_exit: 0
// G25: `mod.fn[T](..)` -- a generic function called through its module.
import modules.qgen

// a bare call next to the qualified ones; the local template also marks the
// file "not core" for the generics-free AST dump of parser_compare
fn local_id[T](a: T) -> T {
    return a
}

fn main() -> i32 {
    if local_id[i32](7 as i32) != 7 as i32 {
        return 7 as i32
    }
    // qualified, several type arguments, nested in expressions
    if qgen.pick[i32](3 as i32, 4 as i32, true) != 3 as i32 {
        return 1 as i32
    }
    if qgen.pick[u8](3 as u8, 4 as u8, false) != 4 as u8 {
        return 2 as i32
    }
    if qgen.twice[i64](21 as i64) != 42 as i64 {
        return 3 as i32
    }
    // a template that calls a template of its module
    if qgen.sum_to[i32](4 as i32) != 10 as i32 {
        return 4 as i32
    }
    // a plain function of the same module still works
    if qgen.plain(1 as i32) != 2 as i32 {
        return 5 as i32
    }
    // an index on a module item stays an index
    let v = qgen.twice[i32](qgen.twice[i32](5 as i32))
    if v != 20 as i32 {
        return 6 as i32
    }
    return 0 as i32
}
