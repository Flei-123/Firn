// expect_exit: 0
// firnc1_skip: lambda sugar is stage-0 only until the firnc1 mirror lands
// tests/4040_lambda_sugar.fi -- `|x| expr` / `|a, b| { block }` / typed / capturing (r715).
import std.vec

struct Point { x: i32, y: i32 }
struct Ops { op: fn(i32) -> i32 }

static mut TOTAL: i32 = 0

fn bump(i: i32) { TOTAL = TOTAL + i }
fn apply(f: fn(i32) -> i32, x: i32) -> i32 { return f(x) }
fn apply2(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 { return f(a, b) }
fn each(n: i32, f: fn(i32)) {
    var i: i32 = 0
    while i < n {
        f(i)
        i = i + 1
    }
}
fn doubler() -> fn(i32) -> i32 { return | x | x * 2 }

fn capture() -> AllocError!i32 {
    let n: i32 = 10
    let f: fn(i32) -> i32 = try gc | x | x + n
    return f(5)
}

fn main() -> i32 {
    if apply(| x | x + 1, 4) != 5 { return 1 }
    if apply2(| a, b | a * b, 3, 4) != 12 { return 2 }
    let r3: i32 = apply(| x | {
            let y: i32 = x * 2
            return y + 1
        }, 5)
    if r3 != 11 { return 3 }
    let f: fn(i32) -> i32 = | x | x - 1
    if f(10) != 9 { return 4 }
    let g = | x: i32, y: i32 | -> i32 x + y
    if g(2, 3) != 5 { return 5 }
    each(5, | i | bump(i))
    if TOTAL != 10 { return 6 }
    let z: fn() -> i32 = || 42
    if z() != 42 { return 7 }
    if apply(| x | apply(| y | y * 2, x) + 1, 3) != 7 { return 8 }
    let o: Ops = Ops { op: | x | x + 100 }
    if o.op(1) != 101 { return 9 }
    let d: fn(i32) -> i32 = doubler()
    if d(21) != 42 { return 10 }
    let c: i32 = capture() catch 0
    if c != 15 { return 11 }

    var v: Vec[Point] = vec_new[Point]()
    defer vec_free[Point](&v)
    vec_push[Point](&v, Point { x: 3, y: 1 })
    vec_push[Point](&v, Point { x: 1, y: 3 })
    vec_push[Point](&v, Point { x: 2, y: 2 })
    vec_sort_by[Point](&v, | a, b | (*a).x < (*b).x)
    let p0: *Point = vec_elem_ptr[Point](&v, 0)
    if (*p0).x != 1 { return 12 }
    vec_sort_by[Point](&v, | a, b | (*a).y < (*b).y)
    let p1: *Point = vec_elem_ptr[Point](&v, 0)
    if (*p1).y != 1 { return 13 }
    // bit-or and catch keep working next to lambdas
    let m: i32 = 6 | 1
    if m != 7 { return 14 }
    return 0
}
