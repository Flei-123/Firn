// expect_exit: 42
import window.pixcopy
import std.rt

fn lcg(s: u64) -> u64 {
    return s *% 6364136223846793005 +% 1442695040888963407
}

fn fill_random(p: u64, n: usize, seed: u64) -> u64 {
    var s: u64 = seed
    var i: usize = 0
    while i < n {
        s = lcg(s)
        rt.st8(p, i, ((s >> 33) & 255) as u8)
        i = i + 1
    }
    return s
}

fn ref_bgrx(src: u64, ss: usize, dst: u64, ds: usize, w: usize, h: usize) {
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let q: u64 = src + ((y * ss + x) * 4) as u64
            let z: u64 = dst + ((y * ds + x) * 4) as u64
            rt.st8(z, 0, rt.ld8(q, 2))
            rt.st8(z, 1, rt.ld8(q, 1))
            rt.st8(z, 2, rt.ld8(q, 0))
            rt.st8(z, 3, 255 as u8)
            x = x + 1
        }
        y = y + 1
    }
}

fn ref_rgba(src: u64, ss: usize, dst: u64, ds: usize, w: usize, h: usize) {
    var y: usize = 0
    while y < h {
        var x: usize = 0
        while x < w {
            let q: u64 = src + ((y * ss + x) * 4) as u64
            let z: u64 = dst + ((y * ds + x) * 4) as u64
            rt.st8(z, 0, rt.ld8(q, 0))
            rt.st8(z, 1, rt.ld8(q, 1))
            rt.st8(z, 2, rt.ld8(q, 2))
            rt.st8(z, 3, 255 as u8)
            x = x + 1
        }
        y = y + 1
    }
}

fn same(a: u64, b: u64, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if rt.ld8(a, i) != rt.ld8(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    let ss: usize = 37
    let ds: usize = 41
    let h: usize = 9
    let src: u64 = rt.heap_alloc(ss * h * 4 + 64)
    let fast: u64 = rt.heap_alloc(ds * h * 4 + 64)
    let slow: u64 = rt.heap_alloc(ds * h * 4 + 64)
    var seed: u64 = fill_random(src, ss * h * 4, 7)
    var mode: usize = 0
    while mode < 2 {
        var w: usize = 0
        while w <= 33 {
            var off: usize = 0
            while off < 4 {
                seed = fill_random(fast, ds * h * 4, seed)
                var i: usize = 0
                while i < ds * h * 4 {
                    rt.st8(slow, i, rt.ld8(fast, i))
                    i = i + 1
                }
                let sp: u64 = src + (off * 4) as u64
                let dp: u64 = off as u64 * 4
                if mode == 0 {
                    pixcopy.bgrx_rect_to_rgba(sp, ss, fast + dp, ds, w, h)
                    ref_bgrx(sp, ss, slow + dp, ds, w, h)
                } else {
                    pixcopy.rgba_rect_to_rgba(sp, ss, fast + dp, ds, w, h)
                    ref_rgba(sp, ss, slow + dp, ds, w, h)
                }
                if !same(fast, slow, ds * h * 4) {
                    return (10 + mode * 100 + w) as i32
                }
                off = off + 1
            }
            w = w + 1
        }
        mode = mode + 1
    }
    return 42 as i32
}
