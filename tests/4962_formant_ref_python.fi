// expect_exit: 0
// audio.formant / formant_cons against a Python port (tools/formant/gen_ref.py): the S16 output of vowels (saw and
// impulse source, vibrato, ah->ee morph), fricatives and plosive bursts is BIT IDENTICAL (CRC-32 of the samples), and an
// independent scipy.signal.lfilter band-pass agrees within 1e-4 (the table sine of the coefficients, measured 1.2e-5).
import std.rt
import std.io
import audio.pcm
import audio.synth_osc
import audio.synth_fx
import audio.formant
import audio.formant_cons
import audio.formant_table

// REF-BEGIN (generated by tools/formant/gen_ref.py -- do not edit by hand)
const R1_N: usize = 4410
const R1_CRC: u32 = 3608232384 as u32
const R2_N: usize = 4410
const R2_CRC: u32 = 1607570171 as u32
const R3_N: usize = 2205
const R3_CRC: u32 = 3002935315 as u32
const R4_N: usize = 2205
const R4_CRC: u32 = 2089842872 as u32
const R5_N: usize = 1500
const R5_CRC: u32 = 3965736007 as u32
const R6_N: usize = 265
const R6_CRC: u32 = 538362570 as u32
const R7_N: usize = 265
const R7_CRC: u32 = 719415305 as u32
fn ind_ref(i: usize) -> f64 {
    if i == 100 { return 0.028994353756471043 }
    if i == 200 { return 0.020815453397094622 }
    if i == 300 { return 0.01449676735822774 }
    if i == 400 { return -0.03553934472086239 }
    if i == 500 { return -0.05045150090807678 }
    if i == 600 { return -0.054534727983376524 }
    if i == 700 { return 0.022202037032312456 }
    if i == 800 { return 0.06262301248741989 }
    if i == 900 { return -0.004954660299718852 }
    if i == 1000 { return -0.0012762521836567958 }
    if i == 1100 { return 0.04068867009598793 }
    if i == 1200 { return -0.041083581391254356 }
    if i == 1300 { return 0.08523358367038769 }
    if i == 1400 { return -0.009177627291207916 }
    if i == 1500 { return 0.020883733355669794 }
    if i == 1600 { return 0.01525743787420416 }
    if i == 1700 { return -0.05233304261712904 }
    if i == 1800 { return 0.012228757904034921 }
    if i == 1900 { return 0.05974267369873948 }
    return 0.0
}
// REF-END

fn check(ok: bool, what: str, fails: *mut i32) {
    if !ok {
        io.fmt_print(f"FAIL {what}\n")
        *fails = *fails + 1
    }
}

fn crc_sig(sig: u64, n: usize) -> u32 {
    let b: u64 = rt.heap_alloc(n * 2 + 2)
    synth_fx.fx_to_s16(sig, n, b)
    let c: u32 = pcm.crc32(b, n * 2)
    rt.heap_free(b, n * 2 + 2)
    return c
}

fn fabs(x: f64) -> f64 {
    if x < 0.0 { return 0.0 - x }
    return x
}

fn main() -> i32 {
    var fails: i32 = 0
    // R1: ah -> ee, saw, vibrato 6 Hz +-40 cents fading in over 100 ms
    let r1: u64 = synth_osc.sig_new(R1_N)
    formant.sing_morph(r1, R1_N, 22050.0, 150.0, 6.0, 40.0, 100.0, formant_table.VOWEL_AH, formant_table.VOWEL_EE, 50.0, 150.0, 1.0, 1.0, formant.SRC_SAW)
    check(crc_sig(r1, R1_N) == R1_CRC, "R1 vowel morph saw crc", &fails)
    synth_osc.sig_free(r1, R1_N)
    // R2: oo, impulse train, shift 1.17, level 0.7
    let r2: u64 = synth_osc.sig_new(R2_N)
    formant.sing_morph(r2, R2_N, 22050.0, 180.0, 0.0, 0.0, 0.0, formant_table.VOWEL_OO, formant_table.VOWEL_OO, 0.0, 0.0, 1.17, 0.7, formant.SRC_PULSE)
    check(crc_sig(r2, R2_N) == R2_CRC, "R2 vowel pulse shift crc", &fails)
    synth_osc.sig_free(r2, R2_N)
    // R3 .. R5: fricatives
    let r3: u64 = synth_osc.sig_new(R3_N)
    formant_cons.fric_fill(r3, R3_N, 22050.0, formant_table.CONS_S, 5)
    check(crc_sig(r3, R3_N) == R3_CRC, "R3 s crc", &fails)
    synth_osc.sig_free(r3, R3_N)
    let r4: u64 = synth_osc.sig_new(R4_N)
    formant_cons.fric_fill(r4, R4_N, 22050.0, formant_table.CONS_SH, 6)
    check(crc_sig(r4, R4_N) == R4_CRC, "R4 sh crc", &fails)
    synth_osc.sig_free(r4, R4_N)
    let r5: u64 = synth_osc.sig_new(R5_N)
    formant_cons.fric_fill(r5, R5_N, 22050.0, formant_table.CONS_F, 7)
    check(crc_sig(r5, R5_N) == R5_CRC, "R5 f crc", &fails)
    synth_osc.sig_free(r5, R5_N)
    // R6, R7: plosive bursts (voiced g, voiceless k)
    let r6: u64 = synth_osc.sig_new(R6_N)
    let w6: usize = formant_cons.burst_fill(r6, R6_N, 22050.0, formant_table.CONS_G, 8)
    check(w6 == R6_N, "R6 burst length", &fails)
    check(crc_sig(r6, R6_N) == R6_CRC, "R6 g burst crc", &fails)
    synth_osc.sig_free(r6, R6_N)
    let r7: u64 = synth_osc.sig_new(R7_N)
    let w7: usize = formant_cons.burst_fill(r7, R7_N, 22050.0, formant_table.CONS_K, 9)
    check(w7 == R7_N, "R7 burst length", &fails)
    check(crc_sig(r7, R7_N) == R7_CRC, "R7 k burst crc", &fails)
    synth_osc.sig_free(r7, R7_N)
    // independent: scipy lfilter band-pass F = 730 Hz, BW = 60 Hz on white noise (seed 1)
    let n: usize = 2000
    let x: u64 = synth_osc.sig_new(n)
    synth_osc.noise_fill(x, n, synth_osc.NOISE_WHITE, 1)
    let y: u64 = synth_osc.sig_new(n)
    let c: u64 = synth_osc.sig_const(n, 730.0)
    let q: u64 = synth_osc.sig_const(n, 730.0 / 60.0)
    synth_fx.fx_biquad(x, y, n, 22050.0, synth_fx.FILT_BP, c, q)
    var maxdev: f64 = 0.0
    var i: usize = 100
    while i < n {
        let d: f64 = fabs(synth_osc.gf(y, i) - ind_ref(i))
        if d > maxdev { maxdev = d }
        i = i + 100
    }
    check(maxdev < 0.0001, "scipy lfilter deviation below 1e-4", &fails)
    synth_osc.sig_free(x, n)
    synth_osc.sig_free(y, n)
    synth_osc.sig_free(c, n)
    synth_osc.sig_free(q, n)
    if fails == 0 {
        io.fmt_print(f"formant ref python: ok\n")
    }
    return fails
}
