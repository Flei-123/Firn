// expect_exit: 0
import std.testkit
import mc.mc_snd_use

fn work() -> bool {
    testkit.check(mc_snd_use.su_item_kind("bread") == mc_snd_use.SU_EAT, "bread is food")
    testkit.check(mc_snd_use.su_item_kind("cooked_beef") == mc_snd_use.SU_EAT, "cooked prefix")
    testkit.check(mc_snd_use.su_item_kind("mushroom_stew") == mc_snd_use.SU_EAT, "stew suffix")
    testkit.check(mc_snd_use.su_item_kind("potion") == mc_snd_use.SU_DRINK, "potion drinks")
    testkit.check(mc_snd_use.su_item_kind("water_bucket") == mc_snd_use.SU_BUCKET_WATER, "water bucket")
    testkit.check(mc_snd_use.su_item_kind("lava_bucket") == mc_snd_use.SU_BUCKET_LAVA, "lava bucket")
    testkit.check(mc_snd_use.su_item_kind("stone") == mc_snd_use.SU_NONE, "stone is not usable")
    testkit.check(mc_snd_use.su_bucket_name(mc_snd_use.SU_BUCKET_LAVA, false) == "item.bucket.empty_lava", "lava empty")
    testkit.check(mc_snd_use.su_bucket_name(mc_snd_use.SU_BUCKET_EMPTY, true) == "item.bucket.fill", "fill")
    testkit.check(mc_snd_use.su_bucket_name(mc_snd_use.SU_BUCKET_EMPTY, false) == "", "empty bucket on air is silent")
    testkit.check(mc_snd_use.su_block_interact("oak_button", false) == "block.wooden_button.click_on", "wood button")
    testkit.check(mc_snd_use.su_block_interact("stone_button", false) == "block.stone_button.click_on", "stone button")
    testkit.check(mc_snd_use.su_block_interact("lever", false) == "block.lever.click", "lever")
    testkit.check(mc_snd_use.su_block_interact("oak_door", true) == "block.wooden_door.close", "door close")
    testkit.check(mc_snd_use.su_block_interact("oak_fence_gate", false) == "block.fence_gate.open", "gate open")
    testkit.check(mc_snd_use.su_block_interact("iron_door", false) == "", "iron door needs redstone")
    testkit.check(mc_snd_use.su_block_interact("dirt", false) == "", "dirt silent")
    testkit.check(mc_snd_use.su_use_cadence_hit(200 as u64, 0 - 1), "eat tick 1")
    testkit.check(!mc_snd_use.su_use_cadence_hit(399 as u64, 1), "eat no tick")
    testkit.check(mc_snd_use.su_lava_roll(0 as u64) == 1, "lava ambient roll")
    testkit.check(mc_snd_use.su_lava_roll(100 as u64) == 0, "lava quiet roll")
    return true
}

fn main() -> i32 {
    work()
    return testkit.finish()
}
