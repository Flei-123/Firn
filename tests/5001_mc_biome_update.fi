// expect_exit: 0
import std.rt
import std.bytes
import mc.mc_biome_update
import mc.mc_chunk
import mc.mc_world
import mc.mc_render_world

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn make_chunk(cx: i32, cz: i32, nsec: usize) -> u64 {
    let ids: u64 = rt.heap_alloc(nsec * 8192)
    var i: usize = 0
    while i < nsec * 4096 {
        rt.st16(ids, i, 0 as u16)
        i = i + 1
    }
    return mc_render_world.wr_make_chunk(cx, cz, nsec, ids)
}

fn put_single(b: *mut bytes.Bytes, v: i32) {
    bytes.put_u8(b, 0 as u8)
    bytes.put_varint(b, v)
    bytes.put_varint(b, 0)
}

fn put_striped(b: *mut bytes.Bytes, even: i32, odd: i32) {
    bytes.put_u8(b, 1 as u8)
    bytes.put_varint(b, 2)
    bytes.put_varint(b, even)
    bytes.put_varint(b, odd)
    bytes.put_varint(b, 1)
    var k: i32 = 0
    while k < 8 {
        bytes.put_u8(b, 170 as u8)
        k = k + 1
    }
}

fn put_entry(body: *mut bytes.Bytes, cx: i32, cz: i32, data: *mut bytes.Bytes) {
    bytes.put_i32(body, cz)
    bytes.put_i32(body, cx)
    bytes.put_varint(body, bytes.bytes_len(data) as i32)
    bytes.put_bytes(body, data)
}

fn cell(w: *mut mc_world.World, cx: i32, cz: i32, sec: usize, i: usize) -> u16 {
    let ch: *mut mc_chunk.Chunk = mc_world.world_find(w, cx, cz) as *mut mc_chunk.Chunk
    let s: *mut mc_chunk.Section = mc_chunk.chunk_section(ch, sec)
    return mc_chunk.container_get(&(*s).biomes, i)
}

fn main() -> i32 {
    var w: mc_world.World = mc_world.world_new()
    check(mc_world.world_put(&w, make_chunk(0, 0, 2)), 1)
    check(mc_world.world_put(&w, make_chunk(0 - 1, 2, 2)), 2)
    var sc: mc_chunk.Scratch = mc_chunk.scratch_new()
    let out: u64 = rt.heap_alloc(mc_biome_update.BIOME_UPDATE_MAX * 8)

    var col_a: bytes.Bytes = bytes.bytes_new()
    put_single(&col_a, 7)
    put_striped(&col_a, 3, 9)
    var col_b: bytes.Bytes = bytes.bytes_new()
    put_single(&col_b, 11)
    put_single(&col_b, 12)
    var col_gone: bytes.Bytes = bytes.bytes_new()
    put_single(&col_gone, 4)

    var body: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&body, 3)
    put_entry(&body, 0, 0, &col_a)
    put_entry(&body, 40, 40, &col_gone)
    put_entry(&body, 0 - 1, 2, &col_b)

    let n: usize = mc_biome_update.biome_apply_packet(&w, &sc, &body, out)
    check(n == 2, 4)
    check(mc_biome_update.biome_update_x(out, 0) == 0 && mc_biome_update.biome_update_z(out, 0) == 0, 5)
    check(mc_biome_update.biome_update_x(out, 1) == 0 - 1 && mc_biome_update.biome_update_z(out, 1) == 2, 6)

    check(cell(&w, 0, 0, 0, 0) == 7 as u16 && cell(&w, 0, 0, 0, 63) == 7 as u16, 7)
    check(cell(&w, 0, 0, 1, 0) == 3 as u16 && cell(&w, 0, 0, 1, 1) == 9 as u16, 8)
    check(cell(&w, 0, 0, 1, 62) == 3 as u16 && cell(&w, 0, 0, 1, 63) == 9 as u16, 9)
    check(cell(&w, 0 - 1, 2, 0, 20) == 11 as u16 && cell(&w, 0 - 1, 2, 1, 20) == 12 as u16, 10)

    var truncated: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&truncated, 1)
    bytes.put_i32(&truncated, 0)
    bytes.put_i32(&truncated, 0)
    bytes.put_varint(&truncated, 50)
    check(mc_biome_update.biome_apply_packet(&w, &sc, &truncated, out) == 0, 11)
    check(cell(&w, 0, 0, 0, 0) == 7 as u16, 12)

    var broken: bytes.Bytes = bytes.bytes_new()
    put_single(&broken, 5)
    bytes.put_u8(&broken, 40 as u8)
    var body2: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&body2, 1)
    put_entry(&body2, 0, 0, &broken)
    check(mc_biome_update.biome_apply_packet(&w, &sc, &body2, out) == 1, 13)
    check(cell(&w, 0, 0, 0, 0) == 5 as u16 && cell(&w, 0, 0, 1, 1) == 9 as u16, 14)

    var empty: bytes.Bytes = bytes.bytes_new()
    bytes.put_varint(&empty, 0)
    check(mc_biome_update.biome_apply_packet(&w, &sc, &empty, out) == 0, 15)
    return 0
}
