// expect_exit: 0
// tests/2955_photo_par.fi -- photo.par: the whole burst pipeline gives bit-identical output with 1, 3 and 8 threads.
import std.io
import std.rt
import jobs.jobs
import photo.image
import photo.meta
import photo.merge
import photo.synth
import photo.pipeline
import photo.par

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND {
        return jobs.worker_main(arg)
    }
    return 0
}

fn hash_image(im: *mut image.Image) -> u64 {
    var h: u64 = 2166136261
    let n: i32 = (*im).w * (*im).h * (*im).ch
    var i: i32 = 0
    while i < n {
        let b: u32 = __bits(*(((*im).px + (i as u64) * (4 as u64)) as *mut f32))
        h = ((h ^ (b as u64)) * 16777619) % 4294967291
        i = i + 1
    }
    return h
}

fn run_once() -> u64 {
    let ts: f32 = 2.0e-3f
    let to: f32 = 2.0e-5f
    var scene: image.Image = image.scene_make(130, 97)
    var rng: image.Rng = image.rng_new(5 as u64)
    var m: meta.SensorMeta = meta.meta_default()
    meta.meta_set_noise(&m, 0, ts, to)
    meta.meta_set_noise(&m, 1, ts, to)
    meta.meta_set_noise(&m, 2, ts, to)
    meta.meta_set_noise(&m, 3, ts, to)
    var o: pipeline.PipeOpts = pipeline.opts_default()
    var b: merge.Burst = merge.burst_new()
    synth.synth_burst(&scene, 4, 1.0f, ts, to, 3.0f, &rng, &b)
    image.img_free(&scene)
    var out: image.Image = image.img_new(1, 1, 3)
    image.img_free(&out)
    pipeline.process_burst(&b, &m, &o, &out)
    let h: u64 = hash_image(&out)
    image.img_free(&out)
    merge.burst_free(&b)
    return h
}

fn main() -> i32 {
    let h1: u64 = run_once()
    par.init(2)
    let h3: u64 = run_once()
    par.init(7)
    let h8: u64 = run_once()
    par.shutdown()
    if h1 != h3 { return 1 }
    if h1 != h8 { return 2 }
    io.print_line("ok")
    return 0
}
