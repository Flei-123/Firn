// expect_exit: 0
// ROUND REF3: the reference receivers `&self` (read-only) and `inout self`
// (modifiable). `self.f` dereferences automatically; `self` passed on stays
// the same reference. `fn drop(inout self)` (SPEC 3.3) is written this way.
struct Cell { n: i64, a: [i64; 2] }

fn show(c: &Cell) -> i64 { return c.n * 100 + c.a[1] }

impl Cell {
    fn get(&self) -> i64 { return self.n }
    fn bump(inout self, by: i64) {
        self.n += by
        self.a[1] = self.n * 2
    }
    fn twice(inout self) {
        self.bump(1)
        self.bump(inout_by())
    }
    fn view(&self) -> i64 { return show(self) }
}

fn inout_by() -> i64 { return 10 }

fn main() -> i32 {
    var c: Cell = Cell { n: 1, a: [0, 0] }
    c.bump(2)
    if c.get() != 3 { return 1 }
    if c.a[1] != 6 { return 2 }
    c.twice()
    // n = 3 + 1 + 10 = 14, a[1] = 28
    if c.get() != 14 { return 3 }
    if c.view() != 1428 { return 4 }
    return 0
}
