// expect_exit: 0
// tests/2830_mc_light_mesh.fi -- vertex light of mc_mesh: word1 layout, tile clamp, smooth lighting of one corner,
// greedy merge only with equal light. The brute force comparison is tools/mc/mesh/run.sh.
import std.rt
import mc.mc_mesh

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn pset(p: u64, x: usize, y: usize, z: usize, v: u16) {
    rt.st16(p, (y * 18 + z) * 18 + x, v)
}

fn lset(p: u64, x: usize, y: usize, z: usize, sky: u8, blk: u8) {
    rt.st8(p, (y * 18 + z) * 18 + x, (sky << 4 as u8) | blk)
}

fn main() -> i32 {
    // accessors
    let w1: u32 = 16383 as u32 | (16 as u32 << 14 as u32) | (7 as u32 << 19 as u32) | (9 as u32 << 24 as u32) | (5 as u32 << 28 as u32)
    check(mc_mesh.vtx_tile(w1) == 16383 as u32, 1)
    check(mc_mesh.vtx_u(w1) == 16 as u32, 2)
    check(mc_mesh.vtx_v(w1) == 7 as u32, 3)
    check(mc_mesh.vtx_sky(w1) == 9 as u32, 4)
    check(mc_mesh.vtx_block(w1) == 5 as u32, 5)
    // tables: block 1 opaque, tile 20000 (> MAX_TILE) on every face
    let opaque: u64 = rt.heap_alloc(32768)
    let tiles: u64 = rt.heap_alloc(32768 * 6 * 2)
    rt.mem_set(opaque, 0 as u8, 32768)
    rt.mem_set(tiles, 0 as u8, 32768 * 6 * 2)
    var f: usize = 0
    while f < 6 {
        rt.st16(tiles, 6 + f, 20000 as u16)
        f = f + 1
    }
    rt.st8(opaque, 1, 1 as u8)
    var t: mc_mesh.MeshTables = mc_mesh.MeshTables { opaque: opaque, tiles: tiles }
    var m: mc_mesh.Mesher = mc_mesh.mesher_new()
    let pad: u64 = rt.heap_alloc(5832 * 2)
    let lp: u64 = rt.heap_alloc(5832)
    rt.mem_set(pad, 0 as u8, 5832 * 2)
    rt.mem_set(lp, 0 as u8, 5832)
    // one block at (5,5,5), light: top face front cell (5,6,5) sky 12 / block 3, its +x side cell sky 4 / block 9
    pset(pad, 5, 5, 5, 1 as u16)
    lset(lp, 5, 6, 5, 12 as u8, 3 as u8)
    lset(lp, 6, 6, 5, 4 as u8, 9 as u8)
    mc_mesh.mesh_padded_lit(&m, pad, lp, &t, mc_mesh.F_LIGHT)
    check(m.nquads == 6 as u32, 6)
    // find the +y face (face 3): corner (u=1, v=0) = +z? use the corner that touches the +x side cell: u axis of +y = z, v axis = x
    var q: usize = 0
    var found: bool = false
    while q < 6 {
        let w0: u32 = rt.ld32(m.verts, q * 8)
        if mc_mesh.vtx_face(w0) == 3 as u32 {
            found = true
            // 4 corners (u,v) (0,0) (1,0) (1,1) (0,1); v = x axis: corners 2, 3 have v = 1 (+x side)
            let c0: u32 = rt.ld32(m.verts, (q * 4) * 2 + 1)
            let c2: u32 = rt.ld32(m.verts, (q * 4 + 2) * 2 + 1)
            check(mc_mesh.vtx_tile(c0) == mc_mesh.MAX_TILE, 7) // clamped
            // corner 0: front cell 12/3 + three dark default-less cells (0/0) -> (12 + 0 + 0 + 0) rounds: (2*12+4)/8 = 3, block (2*3+4)/8 = 1
            check(mc_mesh.vtx_sky(c0) == 3 as u32, 8)
            check(mc_mesh.vtx_block(c0) == 1 as u32, 9)
            // corner 2: front 12/3 + +x side 4/9 + +z side 0/0 + diagonal 0/0 -> sky (2*16+4)/8 = 4, block (2*12+4)/8 = 3
            check(mc_mesh.vtx_sky(c2) == 4 as u32, 10)
            check(mc_mesh.vtx_block(c2) == 3 as u32, 11)
        }
        q = q + 1
    }
    check(found, 12)
    // without F_LIGHT every corner is sky 15 / block 0
    mc_mesh.mesh_padded_lit(&m, pad, lp, &t, 0 as u32)
    check(mc_mesh.vtx_sky(rt.ld32(m.verts, 1)) == 15 as u32, 13)
    check(mc_mesh.vtx_block(rt.ld32(m.verts, 1)) == 0 as u32, 14)
    // greedy: a flat 4x4 floor, equal light everywhere -> one top quad; one different cell -> several
    rt.mem_set(pad, 0 as u8, 5832 * 2)
    rt.mem_set(lp, 0 as u8, 5832)
    var x: usize = 4
    while x < 8 {
        var z: usize = 4
        while z < 8 {
            pset(pad, x, 5, z, 1 as u16)
            var y: usize = 5
            while y < 7 {
                lset(lp, x - 1, y + 1, z - 1, 15 as u8, 0 as u8)
                y = y + 1
            }
            z = z + 1
        }
        x = x + 1
    }
    var yy: usize = 0
    while yy < 18 {
        var zz: usize = 0
        while zz < 18 {
            var xx: usize = 0
            while xx < 18 {
                lset(lp, xx, yy, zz, 15 as u8, 0 as u8)
                xx = xx + 1
            }
            zz = zz + 1
        }
        yy = yy + 1
    }
    mc_mesh.mesh_padded_lit(&m, pad, lp, &t, mc_mesh.F_LIGHT | mc_mesh.F_GREEDY)
    check(m.nquads == 6 as u32, 15)
    lset(lp, 5, 6, 5, 3 as u8, 0 as u8)
    mc_mesh.mesh_padded_lit(&m, pad, lp, &t, mc_mesh.F_LIGHT | mc_mesh.F_GREEDY)
    check(m.nquads > 6 as u32, 16)
    mc_mesh.mesh_padded_lit(&m, pad, lp, &t, mc_mesh.F_GREEDY)
    check(m.nquads == 6 as u32, 17) // no F_LIGHT: light ignored
    mc_mesh.mesher_free(&m)
    return 0
}
