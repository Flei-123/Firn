// expect_exit: 0
// tests/4832_chan_spsc_stress.fi -- lib/chan: one producer thread, one consumer (the main thread).
//
// A  5,000,000 one-word messages through a ring of 1024: order and sum exact
// B  200,000 messages through a ring of 2 (nearly every send / receive has to wait)
// C  1,000,000 records of 3 words: every word checked
// D  a producer that sleeps now and then (the consumer waits on an empty ring), 3000 messages
import std.rt
import std.time
import chan.chan

static mut g_blk: u64 = 0
static mut g_n: u64 = 0

fn __thread_work(kind: u64, arg: u64) -> u64 {
    var c: chan.Chan = chan.Chan { blk: g_blk }
    var i: u64 = 0
    if kind == 1 {
        while i < g_n {
            if !chan.chan_send1(&c, i) { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == 2 {
        var rec: [u64; 3] = [0; 3]
        while i < g_n {
            rec[0] = i
            rec[1] = i * 3
            rec[2] = i ^ 21845
            if !chan.chan_send(&c, &rec[0]) { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == 3 {
        while i < g_n {
            if i % 97 == 0 {
                time.sleep_ms(1)
            }
            if !chan.chan_send1(&c, i) { return 1 }
            i = i + 1
        }
        return 0
    }
    return 9
}

fn run_words(cap: u64, n: u64, kind: u64) -> u64 {
    var c: chan.Chan = chan.chan_new(cap, 1)
    g_blk = c.blk
    g_n = n
    let h: u64 = thread_start(kind, 0)
    var v: u64 = 0
    var expect: u64 = 0
    var sum: u64 = 0
    while expect < n {
        if !chan.chan_recv(&c, &v) { return 1 }
        if v != expect { return 2 }
        sum = sum + v
        expect = expect + 1
    }
    if thread_wait(h) != 0 { return 3 }
    if sum != n * (n - 1) / 2 { return 4 }
    if chan.chan_len(&c) != 0 { return 5 }
    if chan.chan_try_recv(&c, &v) { return 6 }
    chan.chan_free(&c)
    return 0
}

fn run_records(cap: u64, n: u64) -> u64 {
    var c: chan.Chan = chan.chan_new(cap, 3)
    g_blk = c.blk
    g_n = n
    let h: u64 = thread_start(2, 0)
    var rec: [u64; 3] = [0; 3]
    var i: u64 = 0
    while i < n {
        if !chan.chan_recv(&c, &rec[0]) { return 1 }
        if rec[0] != i { return 2 }
        if rec[1] != i * 3 { return 3 }
        if rec[2] != (i ^ 21845) { return 4 }
        i = i + 1
    }
    if thread_wait(h) != 0 { return 5 }
    chan.chan_free(&c)
    return 0
}

fn main() -> i32 {
    let a: u64 = run_words(1024, 5000000, 1)
    if a != 0 { return (10 + a) as i32 }
    let b: u64 = run_words(2, 200000, 1)
    if b != 0 { return (20 + b) as i32 }
    let c: u64 = run_records(256, 1000000)
    if c != 0 { return (30 + c) as i32 }
    let d: u64 = run_words(64, 3000, 3)
    if d != 0 { return (40 + d) as i32 }
    return 0
}
