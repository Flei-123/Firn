// expect_exit: 0
import jxl.jxl
import jxl.jxl_icc
import jxl.jxl_icc_pred
import std.fs
import std.rt

static mut failures: i32 = 0

fn pixel_hash(pic: *mut jxl.JxlPicture) -> u64 {
    var s: u64 = 0
    var i: usize = 0
    while i < (*pic).size {
        s = (s * 31 + (rt.ld8((*pic).data, i) as u64)) % 1000000007
        i = i + 1
    }
    return s
}

fn expect(jxl_path: str, icc_path: str, channels: u32, want: u64) {
    var data: rt.Buf = rt.buf_new()
    var want_icc: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(jxl_path, &data) catch 0
    let m: usize = fs.read_file(icc_path, &want_icc) catch 0
    var icc: jxl.JxlIcc = jxl.jxl_icc_new()
    let ok: bool = jxl.jxl_icc_profile(rt.buf_ptr(&data), n, &icc) catch false
    var good: bool = ok && m > 0 && icc.size == m
    if good {
        var i: usize = 0
        while i < m {
            if rt.ld8(icc.data, i) != rt.buf_at(&want_icc, i) {
                good = false
            }
            i = i + 1
        }
    }
    var pic: jxl.JxlPicture = jxl.jxl_picture_new()
    let dec: bool = jxl.jxl_decode(rt.buf_ptr(&data), n, &pic) catch false
    if !dec || pic.width != 16 || pic.height != 16 || pic.channels != channels || pixel_hash(&pic) != want {
        good = false
    }
    if !good {
        failures = failures + 1
    }
    jxl.jxl_picture_free(&pic)
    jxl.jxl_icc_free(&icc)
    rt.buf_free(&want_icc)
    rt.buf_free(&data)
}

fn expect_bad(bytes: u64, n: usize) {
    var out: rt.Buf = rt.buf_new()
    if jxl_icc.icc_unpredict(bytes, n, &out) == 0 {
        failures = failures + 1
    }
    rt.buf_free(&out)
}

fn expect_shuffle(width: usize, size: usize, second: u8) {
    let p: u64 = rt.heap_alloc(size)
    var i: usize = 0
    while i < size {
        rt.st8(p, i, i as u8)
        i = i + 1
    }
    jxl_icc_pred.shuffle_bytes(p, size, width)
    if rt.ld8(p, 1) != second {
        failures = failures + 1
    }
    rt.heap_free(p, size)
}

fn main() -> i32 {
    expect("tests/data/jxl/icc/a98.jxl", "tests/data/jxl/icc/a98.icc", 3, 342834020)
    expect("tests/data/jxl/icc/esrgb.jxl", "tests/data/jxl/icc/esrgb.icc", 3, 342834020)
    expect("tests/data/jxl/icc/gray.jxl", "tests/data/jxl/icc/gray.icc", 1, 585652452)
    expect("tests/data/jxl/icc/gsrgb.jxl", "tests/data/jxl/icc/gsrgb.icc", 3, 342834020)
    expect("tests/data/jxl/icc/p3.jxl", "tests/data/jxl/icc/p3.icc", 3, 342834020)
    expect("tests/data/jxl/icc/romm.jxl", "tests/data/jxl/icc/romm.icc", 3, 342834020)
    expect("tests/data/jxl/icc/scrgb.jxl", "tests/data/jxl/icc/scrgb.icc", 3, 342834020)
    expect("tests/data/jxl/icc/sgray.jxl", "tests/data/jxl/icc/sgray.icc", 1, 585652452)
    expect("tests/data/jxl/icc/srgbicm.jxl", "tests/data/jxl/icc/srgbicm.icc", 3, 342834020)
    expect("tests/data/jxl/icc/swapped.jxl", "tests/data/jxl/icc/swapped.icc", 3, 342834020)
    let junk: u64 = rt.heap_alloc(8)
    rt.mem_set(junk, 255 as u8, 8)
    expect_bad(junk, 6)
    expect_bad(junk, 0)
    rt.heap_free(junk, 8)
    expect_shuffle(2, 8, 4 as u8)
    expect_shuffle(4, 8, 2 as u8)
    return failures
}
