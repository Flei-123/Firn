// expect_out: 3|2|be|1
// firnc1 type checker: a pointer to `str` is accepted where a pointer to
// `str.Span` is expected (and the other way round), like `str` and `Span`
// themselves. Before the fix firnc1 rejected `&word` for `*mut Span` (this
// is what broke tests/3820_std_dict in the self-hosted compiler).
import std.io
import std.str

fn first_len(p: *mut str.Span) -> usize {
    return (*p).n
}

fn fill(p: *mut str) {
    *p = "ab"
}

fn main() -> i32 {
    var s: str = "abc"
    let n: usize = first_len(&s)
    var sp: str.Span = str.span_empty()
    var s2: str = ""
    fill(&sp)
    s2 = "x"
    var it: str.Divisor = str.divisor_whitespace("to be")
    var word: str = ""
    let ok: bool = str.divisor_next(&it, &word)
    let ok2: bool = str.divisor_next(&it, &word)
    var c: i32 = 0
    if ok && ok2 { c = 1 }
    io.fmt_print_line(f"{n}|{sp.n}|{word}|{c}")
    return 0
}
