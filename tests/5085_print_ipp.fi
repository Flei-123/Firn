// expect_exit: 42
import print.ippmsg
import print.ippcaps
import print.ippclient
import print.spool
import print.bitmap
import print.rle
import print.pwgraster
import print.urfraster
import print.pagejob
import print.model
import print.discover
import std.rt
import std.vec
import std.str

static mut fail_next: u32 = 0
static mut seen_ops: u32 = 0
static mut last_doc: usize = 0

fn reply(out: *mut rt.Buf, id: u32, op: u32) {
    ippmsg.begin(out, 512 as u32, 0 as u32, id)
    ippmsg.group(out, ippmsg.T_OPERATION)
    ippmsg.put_str(out, ippmsg.V_CHARSET, "attributes-charset", "utf-8")
    ippmsg.put_str(out, ippmsg.V_LANGUAGE, "attributes-natural-language", "en")
    if op == ippmsg.OP_GET_PRINTER_ATTRIBUTES {
        ippmsg.group(out, ippmsg.T_PRINTER)
        ippmsg.put_str(out, ippmsg.V_NAME, "printer-name", "Mock")
        ippmsg.put_int(out, ippmsg.V_ENUM, "printer-state", 3 as u32)
        ippmsg.put_bool(out, "printer-is-accepting-jobs", true)
        ippmsg.put_bool(out, "color-supported", true)
        ippmsg.put_str(out, ippmsg.V_MIME, "document-format-supported", "image/urf")
        ippmsg.put_more(out, ippmsg.V_MIME, "image/pwg-raster")
        ippmsg.put_str(out, ippmsg.V_KEYWORD, "sides-supported", "one-sided")
        ippmsg.put_more(out, ippmsg.V_KEYWORD, "two-sided-long-edge")
        ippmsg.put_str(out, ippmsg.V_BEG_COLLECTION, "media-size-supported", "")
        ippmsg.put_str(out, ippmsg.V_MEMBER_NAME, "", "x-dimension")
        ippmsg.put_int(out, ippmsg.V_INTEGER, "", 21000 as u32)
        ippmsg.put_str(out, ippmsg.V_MEMBER_NAME, "", "y-dimension")
        ippmsg.put_int(out, ippmsg.V_INTEGER, "", 29700 as u32)
        ippmsg.put_str(out, ippmsg.V_END_COLLECTION, "", "")
        ippmsg.put_str(out, ippmsg.V_BEG_COLLECTION, "", "")
        ippmsg.put_str(out, ippmsg.V_MEMBER_NAME, "", "x-dimension")
        ippmsg.put_int(out, ippmsg.V_INTEGER, "", 29700 as u32)
        ippmsg.put_str(out, ippmsg.V_MEMBER_NAME, "", "y-dimension")
        ippmsg.put_int(out, ippmsg.V_INTEGER, "", 42000 as u32)
        ippmsg.put_str(out, ippmsg.V_END_COLLECTION, "", "")
        ippmsg.put_resolution(out, "pwg-raster-document-resolution-supported", 300 as u32, 300 as u32, 3 as u32)
        ippmsg.put_str(out, ippmsg.V_KEYWORD, "pwg-raster-document-type-supported", "srgb_8")
        ippmsg.put_more(out, ippmsg.V_KEYWORD, "sgray_8")
        ippmsg.put_range(out, "copies-supported", 1 as u32, 9 as u32)
    } else if op == ippmsg.OP_PRINT_JOB {
        ippmsg.group(out, ippmsg.T_JOB)
        ippmsg.put_int(out, ippmsg.V_INTEGER, "job-id", 5 as u32)
    } else if op == ippmsg.OP_GET_JOB_ATTRIBUTES {
        ippmsg.group(out, ippmsg.T_JOB)
        ippmsg.put_int(out, ippmsg.V_INTEGER, "job-id", 5 as u32)
        ippmsg.put_int(out, ippmsg.V_ENUM, "job-state", 9 as u32)
    }
    ippmsg.end(out)
}

fn post(ud: u64, url: str, body: u64, n: usize, out: *mut rt.Buf) -> u32 {
    if fail_next > 0 {
        fail_next = fail_next - 1
        return ippclient.TR_NO_SERVER
    }
    var m: ippmsg.Msg = ippmsg.msg_new()
    if !ippmsg.msg_parse(&m, body, n) {
        ippmsg.msg_free(&m)
        return 500 as u32
    }
    seen_ops = seen_ops + 1
    last_doc = n
    reply(out, ippmsg.msg_id(&m), ippmsg.msg_code(&m))
    ippmsg.msg_free(&m)
    return 200 as u32
}

fn rgba_page(ud: u64, page: u32, w: u32, h: u32, dpi: u32, out: *mut rt.Buf) -> bool {
    var y: u32 = 0
    while y < h {
        var x: u32 = 0
        while x < w {
            var v: u8 = 255 as u8
            if y >= h / 2 {
                v = ((x * 7 + y) & 255) as u8
            }
            rt.buf_push(out, v)
            rt.buf_push(out, v)
            rt.buf_push(out, v)
            rt.buf_push(out, 255 as u8)
            x = x + 1
        }
        y = y + 1
    }
    return true
}

fn main() -> i32 {
    if ippclient.uri_to_url("ipp://localhost/ipp/print") != "http://127.0.0.1:631/ipp/print" { return 1 as i32 }
    if ippclient.uri_to_url("ipps://10.0.0.5:8631/x") != "https://10.0.0.5:8631/x" { return 2 as i32 }
    if ippclient.uri_to_url("https://p.local/ipp") != "https://p.local/ipp" { return 3 as i32 }
    if ippclient.normalize_uri("Office") != "ipp://localhost:631/printers/Office" { return 4 as i32 }
    if ippclient.normalize_uri("http://h:631/a") != "ipp://h:631/a" { return 5 as i32 }
    if ippclient.normalize_uri("a/b") != "" { return 6 as i32 }
    if discover.uri_from_dnssd("p.local", 631 as u32, "/ipp/print", true) != "ipps://p.local:631/ipp/print" { return 7 as i32 }

    var sp: ippclient.JobSpec = ippclient.spec_default()
    if !ippclient.spec_set_ranges(&sp, "1-3,5,7-9") || vec_len[u32](&sp.ranges) != 6 { return 10 as i32 }
    if ippclient.spec_set_ranges(&sp, "3-1") || ippclient.spec_set_ranges(&sp, "a") || ippclient.spec_set_ranges(&sp, "1,") { return 11 as i32 }

    var c: ippclient.Client = ippclient.client_new()
    ippclient.client_set_transport(&c, ippclient.Transport { post: post, ud: 0 })
    var caps: ippcaps.Caps = ippcaps.caps_new()
    let ok: bool = ippclient.get_printer_attributes(&c, "ipp://mock/ipp/print", &caps) catch | e | (false)
    if !ok { return 20 as i32 }
    if caps.name != "Mock" || caps.state != 3 || !caps.accepting || !caps.color || !caps.duplex { return 21 as i32 }
    if !ippcaps.caps_supports_urf(&caps) || !ippcaps.caps_supports_pwg(&caps) || ippcaps.caps_supports_pdf(&caps) { return 22 as i32 }
    if vec_len[ippcaps.MediaSize](&caps.media_sizes) != 2 { return 23 as i32 }
    if (*vec_elem_ptr[ippcaps.MediaSize](&caps.media_sizes, 1)).height != 42000 { return 24 as i32 }
    if caps.copies_max != 9 || vec_len[u32](&caps.pwg_resolutions) != 2 { return 25 as i32 }
    if ippcaps.caps_best_dpi(&caps, 600 as u32) != 300 { return 26 as i32 }

    let d: pagejob.Delivery = pagejob.choose_delivery(&caps, true, 600 as u32)
    if d.kind != pagejob.D_PWG || d.pix != bitmap.FMT_RGB8 || d.dpi != 300 { return 30 as i32 }
    var src: pagejob.PageSource = pagejob.PageSource { pages: 2, render: rgba_page, ud: 0 }
    var doc: rt.Buf = rt.buf_new()
    var dd: pagejob.Delivery = d
    if !pagejob.build_raster_document(&src, &dd, 72 as u32, 36 as u32, "custom_x_72x36", &doc) { return 31 as i32 }
    let p: u64 = rt.buf_ptr(&doc)
    if rt.ld8(p, 0) != 82 as u8 || rt.ld8(p, 3) != 50 as u8 { return 32 as i32 }
    if rt.ld8(p, 4) != 80 as u8 || rt.ld8(p, 4 + 372 + 3) != 44 as u8 || rt.ld8(p, 4 + 376 + 3) != 150 as u8 { return 33 as i32 }
    if rt.ld8(p, 4 + 400 + 3) != 19 as u8 || rt.ld8(p, 4 + 388 + 3) != 24 as u8 || rt.ld8(p, 4 + 276 + 3) != 44 as u8 { return 34 as i32 }
    var back: bitmap.Bitmap = bitmap.bitmap_new(300 as u32, 150 as u32, bitmap.FMT_RGB8)
    let used: usize = rle.rle_decode_page(p + 4 + 1796, rt.buf_len(&doc) - 4 - 1796, &back)
    if used == 0 { return 35 as i32 }
    if rt.ld8(bitmap.bitmap_row(&back, 10 as u32), 5) != 255 as u8 { return 36 as i32 }
    if rt.ld8(bitmap.bitmap_row(&back, 100 as u32), 3 * 20) != ((20 * 7 + 100) & 255) as u8 { return 37 as i32 }

    var u: rt.Buf = rt.buf_new()
    var bm: bitmap.Bitmap = bitmap.bitmap_new(10 as u32, 3 as u32, bitmap.FMT_GRAY8)
    urfraster.urf_begin(&u, 1 as u32)
    urfraster.urf_add_page(&u, &bm, 300 as u32, 1 as u32, 4 as u32)
    if rt.buf_len(&u) != 12 + 32 + 1 + 2 { return 40 as i32 }
    if rt.ld8(rt.buf_ptr(&u), 11) != 1 as u8 || rt.ld8(rt.buf_ptr(&u), 12 + 3) != 4 as u8 { return 41 as i32 }

    var mono: bitmap.Bitmap = bitmap.bitmap_from_rgba(rt.buf_ptr(&doc) + 4 + 1796, 1 as u32, 1 as u32, bitmap.FMT_BLACK1, bitmap.DITHER_FLOYD)
    if mono.stride != 1 { return 42 as i32 }

    var mdl: model.Model = model.model_new()
    let at: usize = model.model_add_uri(&mdl, "ipp://mock/ipp/print")
    if at != 0 || model.model_add_uri(&mdl, "ipp://mock/ipp/print") != 0 || model.model_count(&mdl) != 1 { return 50 as i32 }
    if !model.model_select(&mdl, 0) || model.model_can_print(&mdl) { return 51 as i32 }
    if !model.model_load_caps(&mdl, &c) || !model.model_can_print(&mdl) { return 52 as i32 }
    if !model.model_set(&mdl, model.FIELD_SIDES, "two-sided-long-edge") || model.model_set(&mdl, model.FIELD_SIDES, "bogus") { return 53 as i32 }
    if model.model_set_copies(&mdl, 10 as u32) || !model.model_set_copies(&mdl, 3 as u32) { return 54 as i32 }

    var spool_q: spool.Spool = spool.spool_new()
    let sid: u32 = spool.spool_submit(&spool_q, "ipp://mock/ipp/print", "t", "image/pwg-raster", rt.buf_ptr(&doc), rt.buf_len(&doc), *model.model_spec(&mdl))
    fail_next = 1
    spool.spool_step(&spool_q, &c, 0)
    if spool.spool_state(&spool_q, sid) != spool.S_QUEUED { return 60 as i32 }
    spool.spool_step(&spool_q, &c, 100)
    if spool.spool_state(&spool_q, sid) != spool.S_QUEUED { return 61 as i32 }
    spool.spool_step(&spool_q, &c, 5000)
    if spool.spool_state(&spool_q, sid) != spool.S_PRINTING { return 62 as i32 }
    spool.spool_step(&spool_q, &c, 9000)
    if spool.spool_state(&spool_q, sid) != spool.S_DONE { return 63 as i32 }
    if spool.spool_remove_finished(&spool_q) != 1 || spool.spool_count(&spool_q) != 0 { return 64 as i32 }

    let id2: u32 = spool.spool_submit(&spool_q, "ipp://mock/x", "q", "application/pdf", rt.buf_ptr(&doc), 100, ippclient.spec_default())
    var saved: rt.Buf = rt.buf_new()
    spool.spool_save(&spool_q, &saved)
    var q2: spool.Spool = spool.spool_new()
    if !spool.spool_load(&q2, rt.buf_ptr(&saved), rt.buf_len(&saved)) || spool.spool_count(&q2) != 1 { return 70 as i32 }
    if (*spool.spool_job(&q2, 0)).id != id2 || rt.buf_len(&(*spool.spool_job(&q2, 0)).data) != 100 { return 71 as i32 }
    if !spool.spool_cancel(&q2, &c, id2) || spool.spool_state(&q2, id2) != spool.S_CANCELED { return 72 as i32 }
    return 42
}
