// expect_exit: 14
// Runde 52: MMIO. Zwischen den beiden Lasten steht ein Schreibzugriff auf
// DIESELBE Adresse. Legt ein Durchgang die Lasten zusammen oder wirft er den
// ersten Schreibzugriff weg, kommt 10 oder 18 heraus statt 14.
fn main() -> i32 {
    var b: [u32; 2] = [0 as u32, 0 as u32]
    let p: *mut u32 = (&b[0]) as *mut u32
    __mmio_write32(p, 5 as u32)
    let x: u32 = __mmio_read32(p)
    __mmio_write32(p, 9 as u32)
    let y: u32 = __mmio_read32(p)
    return (x + y) as i32
}
