// expect_exit: 14
// Round 52: MMIO. Between the two loads there is a write to
// THE SAME address. If a pass merges the loads or throws the first write
// away, 10 or 18 comes out instead of 14.
fn main() -> i32 {
    var b: [u32; 2] = [0 as u32, 0 as u32]
    let p: *mut u32 = (&b[0]) as *mut u32
    __mmio_write32(p, 5 as u32)
    let x: u32 = __mmio_read32(p)
    __mmio_write32(p, 9 as u32)
    let y: u32 = __mmio_read32(p)
    return (x + y) as i32
}
