// expect_exit: 0
// The allocation counters after W2: the inline fast path only bumps S_SINCE
// and S_SERIES; `gc_total_bytes()` = bytes of finished runs + the open run,
// `gc_allok_n()` = the serial counter. Both must stay exact across
// collection runs (S_SINCE is reset to 0 at the end of every run).
// Node = 16 bytes payload -> size class 32 -> 48 bytes per block.

gc class Node {
    next: Gc[Node],
    value: u64,
}

fn chain(n: u64) -> AllocError!Gc[Node] {
    var head: Gc[Node] = gc_null[Node]()
    var i: u64 = 0
    while i < n {
        head = try gc Node { next: head, value: i }
        i = i + 1
    }
    return head
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    let b0: u64 = gc_total_bytes()
    let n0: u64 = gc_allok_n()
    let runs0: u64 = gc_collections()
    // enough garbage for several collection runs
    var r: u64 = 0
    var sink: u64 = 0
    while r < 300 {
        let g = chain(2000) catch gc_null[Node]()
        if g == gc_null[Node]() {
            return 1
        }
        sink = sink + g.value
        r = r + 1
    }
    let runs1: u64 = gc_collections()
    if runs1 <= runs0 {
        return 2
    }
    let dn: u64 = gc_allok_n() - n0
    let db: u64 = gc_total_bytes() - b0
    if dn < 600000 {
        return 3
    }
    // every Node block is 48 bytes; nothing else allocates in the loop
    if db != dn * 48 {
        return 4
    }
    // a manual full run must not lose or double count
    let b1: u64 = gc_total_bytes()
    let n1: u64 = gc_allok_n()
    gc_collect()
    if gc_total_bytes() < b1 || gc_allok_n() < n1 {
        return 5
    }
    if gc_diag(6) != gc_allok_n() {
        return 6
    }
    if sink == 0 {
        return 7
    }
    return 0
}
