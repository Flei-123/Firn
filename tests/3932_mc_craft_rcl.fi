// expect_exit: 0
// r158 (round 2): right click on the crafting result slot, remainder items (milk bucket -> bucket, honey bottle -> glass bottle) stay in the grid,
// blocked cases (honey bottle stack of 5, potion) stay with the server. Window slot 0 = result, 1..9 = grid; internal grid base g = 46.
// Slot numbers: clk() takes WINDOW slots (inventory part = internal slot + 1 in the crafting table), inv_set / inv_item take INTERNAL slots.
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_schema
import mc.mc_registry
import mc.mc_craft
import mc.mc_craft_sel
import mc.mc_inv

fn it(r: *mut mc_registry.Registry, name: str) -> i32 { return mc_registry.reg_item_by_name(r, name.p as u64, name.n) }

fn layout(ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let id: i32 = mc_version.version_pid(ver, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK)
    if id < 0 { return false }
    let sch: u64 = (*ver).schema_of(mc_version.ST_PLAY, mc_version.DIR_C2S, id)
    if sch == 0 as u64 { return false }
    bytes.bytes_set_pos(b, 0)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk(sch, b, &out)
    rt.buf_free(&out)
    return ok
}

// one click; the packet must parse with the schema of the version; returns the number of changed slots (>= 0) or -1 / -2
fn clk(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32) -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(v, (*ver).protocol, slot, button, mode, &b) { return 0 - 1 }
    let ok: bool = layout(ver, &b)
    var n: i32 = 0
    if (*ver).protocol >= 756 { n = bytes.bytes_at(&b, 6) as i32 }
    bytes.bytes_free(&b)
    if !ok { return 0 - 2 }
    return n
}

fn open_table(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    var typ: i32 = 11
    if (*ver).protocol >= 765 { typ = 12 }
    bytes.put_varint(&b, id)
    bytes.put_varint(&b, typ)
    bytes.put_u8(&b, 0 as u8)
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_open_window_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn total(v: *mut mc_inv.Inv, item: i32) -> i32 {
    var n: i32 = 0
    var k: i32 = 9
    while k < 45 {
        if mc_inv.inv_item(v, k) == item { n = n + mc_inv.inv_count(v, k) }
        k = k + 1
    }
    return n
}

fn fresh(r: *mut mc_registry.Registry, rc: *mut mc_craft.Recipes) -> mc_inv.Inv {
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_use_registry(&v, r)
    if rc != 0 as *mut mc_craft.Recipes { mc_inv.inv_use_recipes(&v, rc) }
    return v
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var r: mc_registry.Registry = ver.registry_of()
    if !mc_registry.registry_ok(&r) { return 101 }
    var rc: mc_craft.Recipes = mc_craft_sel.recipes_for_protocol(p)
    if !mc_craft.craft_ok(&rc) { return 102 }
    let planks: i32 = it(&r, "oak_planks")
    let stick: i32 = it(&r, "stick")
    let milk: i32 = it(&r, "milk_bucket")
    let bucket: i32 = it(&r, "bucket")
    let sugar: i32 = it(&r, "sugar")
    let egg: i32 = it(&r, "egg")
    let wheat: i32 = it(&r, "wheat")
    let cake: i32 = it(&r, "cake")
    let honey: i32 = it(&r, "honey_bottle")
    let hblock: i32 = it(&r, "honey_block")
    let gbottle: i32 = it(&r, "glass_bottle")
    let dirt: i32 = it(&r, "dirt")
    let potion: i32 = it(&r, "potion")
    if planks < 0 || stick < 0 || milk < 0 || bucket < 0 || sugar < 0 || egg < 0 || wheat < 0 || cake < 0 || honey < 0 || hblock < 0 || gbottle < 0 || dirt < 0 || potion < 0 { return 103 }
    let g: i32 = 46

    var t: mc_inv.Inv = fresh(&r, &rc)
    if !open_table(&t, &ver, 7) { return 110 }
    // 1: right click on the result, empty hand: the whole result goes to the cursor (not half), one of every ingredient is used up
    mc_inv.inv_set(&t, g + 1, planks, 4)
    mc_inv.inv_set(&t, g + 4, planks, 4)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != stick || mc_inv.inv_count(&t, g) != 4 { return 111 }
    let n1: i32 = clk(&t, &ver, 0, 1, 0)
    if n1 < 0 { return 112 }
    if mc_inv.inv_cursor_item(&t) != stick || mc_inv.inv_cursor_count(&t) != 4 || mc_inv.inv_count(&t, g + 1) != 3 || mc_inv.inv_count(&t, g + 4) != 3 { return 113 }
    if mc_inv.inv_item(&t, g) != stick || mc_inv.inv_count(&t, g) != 4 { return 114 } // result recomputed
    if p >= 756 && n1 != 2 { return 115 } // grid 1 and 4 (the result slot is stick x4 before and after)
    // 2: right click again with the sticks in the hand: merges (same item), 4 + 4
    if clk(&t, &ver, 0, 1, 0) < 0 || mc_inv.inv_cursor_count(&t) != 8 || mc_inv.inv_count(&t, g + 1) != 2 { return 120 }
    // 3: right click with a different item in the hand: nothing
    if clk(&t, &ver, 11, 0, 0) < 0 || mc_inv.inv_cursor_item(&t) != 0 - 1 || mc_inv.inv_count(&t, 10) != 8 { return 121 } // sticks into window slot 11 (internal 10)
    mc_inv.inv_set(&t, 11, dirt, 2)
    if clk(&t, &ver, 12, 0, 0) < 0 || mc_inv.inv_cursor_item(&t) != dirt { return 122 }
    if clk(&t, &ver, 0, 1, 0) < 0 || mc_inv.inv_cursor_item(&t) != dirt || mc_inv.inv_count(&t, g + 1) != 2 { return 123 }
    if clk(&t, &ver, 12, 0, 0) < 0 { return 124 }
    // 4: full cursor stack (63 sticks + 4 does not fit): nothing
    mc_inv.inv_set(&t, 12, stick, 63)
    if clk(&t, &ver, 13, 0, 0) < 0 || mc_inv.inv_cursor_count(&t) != 63 { return 125 }
    if clk(&t, &ver, 0, 1, 0) < 0 || mc_inv.inv_cursor_count(&t) != 63 || mc_inv.inv_count(&t, g + 1) != 2 { return 126 }
    if clk(&t, &ver, 13, 0, 0) < 0 { return 127 }
    // 5: SWAP (hotbar key) and DROP on the result stay with the server: no local change
    if clk(&t, &ver, 0, 0, 2) < 0 || mc_inv.inv_count(&t, g + 1) != 2 { return 128 }
    if clk(&t, &ver, 0, 0, 4) < 0 || mc_inv.inv_count(&t, g + 1) != 2 { return 129 }
    // clear the grid
    mc_inv.inv_set(&t, g + 1, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 4, 0 - 1, 0)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != 0 - 1 { return 130 }

    // 6: cake, right click: the three milk buckets become three buckets IN PLACE, the other ingredients are gone
    mc_inv.inv_set(&t, g + 1, milk, 1)
    mc_inv.inv_set(&t, g + 2, milk, 1)
    mc_inv.inv_set(&t, g + 3, milk, 1)
    mc_inv.inv_set(&t, g + 4, sugar, 2)
    mc_inv.inv_set(&t, g + 5, egg, 1)
    mc_inv.inv_set(&t, g + 6, sugar, 1)
    mc_inv.inv_set(&t, g + 7, wheat, 3)
    mc_inv.inv_set(&t, g + 8, wheat, 1)
    mc_inv.inv_set(&t, g + 9, wheat, 1)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != cake { return 140 }
    if clk(&t, &ver, 0, 1, 0) < 0 { return 141 }
    if mc_inv.inv_cursor_item(&t) != cake || mc_inv.inv_cursor_count(&t) != 1 { return 142 }
    if mc_inv.inv_item(&t, g + 1) != bucket || mc_inv.inv_item(&t, g + 2) != bucket || mc_inv.inv_item(&t, g + 3) != bucket { return 143 }
    if mc_inv.inv_count(&t, g + 1) != 1 { return 144 }
    if mc_inv.inv_item(&t, g + 4) != sugar || mc_inv.inv_count(&t, g + 4) != 1 || mc_inv.inv_item(&t, g + 5) != 0 - 1 || mc_inv.inv_item(&t, g + 6) != 0 - 1 { return 145 }
    if mc_inv.inv_item(&t, g + 7) != wheat || mc_inv.inv_count(&t, g + 7) != 2 || mc_inv.inv_item(&t, g + 8) != 0 - 1 { return 146 }
    if mc_inv.inv_item(&t, g) != 0 - 1 { return 147 } // buckets + sugar + wheat: no recipe
    // 7: shift click on a remainder recipe: milk buckets + ingredients for 1 cake only
    if clk(&t, &ver, 14, 0, 0) < 0 || mc_inv.inv_cursor_item(&t) != 0 - 1 || mc_inv.inv_item(&t, 13) != cake { return 150 }
    mc_inv.inv_set(&t, g + 1, milk, 1)
    mc_inv.inv_set(&t, g + 2, milk, 1)
    mc_inv.inv_set(&t, g + 3, milk, 1)
    mc_inv.inv_set(&t, g + 4, sugar, 2)
    mc_inv.inv_set(&t, g + 5, egg, 3)
    mc_inv.inv_set(&t, g + 6, sugar, 2)
    mc_inv.inv_set(&t, g + 7, wheat, 3)
    mc_inv.inv_set(&t, g + 8, wheat, 3)
    mc_inv.inv_set(&t, g + 9, wheat, 3)
    mc_inv.inv_craft_update(&t)
    if clk(&t, &ver, 0, 0, 1) < 0 { return 151 }
    if total(&t, cake) != 2 || mc_inv.inv_item(&t, g + 1) != bucket || mc_inv.inv_count(&t, g + 5) != 2 || mc_inv.inv_item(&t, g) != 0 - 1 { return 152 } // 1 craft: the buckets end the loop
    // 8: honey bottles: a single bottle in its slot -> glass bottle in place (honey bottle -> 3 sugar)
    mc_inv.inv_set(&t, g + 1, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 2, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 3, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 4, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 5, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 6, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 7, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 8, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 9, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 5, honey, 1)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != sugar || mc_inv.inv_count(&t, g) != 3 { return 160 }
    if clk(&t, &ver, 0, 0, 0) < 0 || mc_inv.inv_cursor_item(&t) != sugar || mc_inv.inv_item(&t, g + 5) != gbottle || mc_inv.inv_count(&t, g + 5) != 1 { return 161 }
    if clk(&t, &ver, 15, 0, 0) < 0 { return 162 }
    // 9: honey block (4 honey bottles) with single bottles: 4 glass bottles stay, honey block to the cursor
    mc_inv.inv_set(&t, g + 5, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 1, honey, 1)
    mc_inv.inv_set(&t, g + 2, honey, 1)
    mc_inv.inv_set(&t, g + 4, honey, 1)
    mc_inv.inv_set(&t, g + 5, honey, 1)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != hblock { return 170 }
    if clk(&t, &ver, 0, 1, 0) < 0 || mc_inv.inv_cursor_item(&t) != hblock { return 171 }
    if mc_inv.inv_item(&t, g + 1) != gbottle || mc_inv.inv_item(&t, g + 2) != gbottle || mc_inv.inv_item(&t, g + 4) != gbottle || mc_inv.inv_item(&t, g + 5) != gbottle { return 172 }
    if clk(&t, &ver, 16, 0, 0) < 0 { return 173 }
    // 10: honey bottle stack of 5: the remainder would go into the player inventory -> left to the server (no local change, cursor stays empty)
    mc_inv.inv_set(&t, g + 1, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 2, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 4, 0 - 1, 0)
    mc_inv.inv_set(&t, g + 5, honey, 5)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != sugar { return 180 }
    if clk(&t, &ver, 0, 0, 0) < 0 || mc_inv.inv_cursor_item(&t) != 0 - 1 || mc_inv.inv_count(&t, g + 5) != 5 { return 181 }
    if clk(&t, &ver, 0, 0, 1) < 0 || mc_inv.inv_count(&t, g + 5) != 5 { return 182 }
    // 11: an unknown remainder (potion) also stays with the server
    mc_inv.inv_set(&t, g + 5, potion, 1)
    mc_inv.inv_set(&t, g + 6, planks, 1)
    mc_inv.inv_craft_update(&t)
    mc_inv.inv_set(&t, g, stick, 4) // pretend the server reported a result
    if clk(&t, &ver, 0, 0, 0) < 0 || mc_inv.inv_cursor_item(&t) != 0 - 1 || mc_inv.inv_item(&t, g + 5) != potion { return 190 }
    mc_inv.inv_free(&t)

    // 12: player window (2x2): right click on the result works there as well; no recipe table: nothing predicted
    var v: mc_inv.Inv = fresh(&r, &rc)
    mc_inv.inv_set(&v, 1, planks, 2)
    mc_inv.inv_set(&v, 3, planks, 2)
    mc_inv.inv_craft_update(&v)
    if clk(&v, &ver, 0, 1, 0) < 0 || mc_inv.inv_cursor_item(&v) != stick || mc_inv.inv_cursor_count(&v) != 4 || mc_inv.inv_count(&v, 1) != 1 { return 200 }
    mc_inv.inv_free(&v)
    var v0: mc_inv.Inv = fresh(&r, 0 as *mut mc_craft.Recipes)
    mc_inv.inv_set(&v0, 0, stick, 4)
    if clk(&v0, &ver, 0, 1, 0) < 0 || mc_inv.inv_cursor_item(&v0) != 0 - 1 { return 210 }
    mc_inv.inv_free(&v0)
    return 0
}

fn main() -> i32 {
    let protos: [i32; 5] = [754, 763, 767, 772, 775]
    var k: usize = 0
    while k < 5 {
        let rcode: i32 = check(protos[k])
        if rcode != 0 { return rcode + (k as i32 + 1) * 1000 }
        k = k + 1
    }
    return 0
}
