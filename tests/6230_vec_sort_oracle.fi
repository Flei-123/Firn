// expect_exit: 0
import std.vec

struct Rec { k: i64, tag: i64 }

impl Ord for Rec {
    fn less(*self, b: *Rec) -> bool { return (*self).k < (*b).k }
}

fn rec_less(a: *Rec, b: *Rec) -> bool { return (*a).k < (*b).k }
fn i64_greater(a: *i64, b: *i64) -> bool { return *b < *a }

static mut SEED: u64 = 88172645463325252

fn rnd() -> u64 {
    SEED = SEED ^ (SEED << 13)
    SEED = SEED ^ (SEED >> 7)
    SEED = SEED ^ (SEED << 17)
    return SEED
}

fn gen(shape: i32, i: usize, n: usize) -> i64 {
    if shape == 0 { return (rnd() % 1000003) as i64 - 500000 }
    if shape == 1 { return i as i64 }
    if shape == 2 { return (n - i) as i64 }
    if shape == 3 { return 7 }
    if shape == 4 { return (rnd() % 4) as i64 }
    if shape == 5 {
        if i < n / 2 { return i as i64 }
        return (n - i) as i64
    }
    if shape == 6 { return (i % 37) as i64 }
    if shape == 7 {
        if i < n - n / 10 { return i as i64 }
        return rnd() as i64
    }
    if shape == 8 { return (i % 2) as i64 }
    if shape == 9 { return (rnd() % 10) as i64 * 1000000007 }
    if shape == 10 { return 1000000 - (i % 1000) as i64 }
    if shape == 11 {
        if i % 2 == 0 { return i as i64 }
        return (n - i) as i64
    }
    return (rnd() % 100) as i64
}

fn fill(v: *mut Vec[i64], n: usize, shape: i32) {
    vec_clear[i64](v)
    var i: usize = 0
    while i < n {
        vec_push[i64](v, gen(shape, i, n))
        i = i + 1
    }
}

fn oracle(v: *mut Vec[i64], desc: bool) {
    var i: usize = 1
    while i < (*v).len {
        let key: i64 = vec_at[i64](v, i)
        var j: isize = i as isize - 1
        while j >= 0 {
            let x: i64 = vec_at[i64](v, j as usize)
            var move: bool = key < x
            if desc { move = x < key }
            if !move { break }
            vec_set[i64](v, (j + 1) as usize, x)
            j = j - 1
        }
        vec_set[i64](v, (j + 1) as usize, key)
        i = i + 1
    }
}

fn same(a: *mut Vec[i64], b: *mut Vec[i64]) -> bool {
    if (*a).len != (*b).len { return false }
    var i: usize = 0
    while i < (*a).len {
        if vec_at[i64](a, i) != vec_at[i64](b, i) { return false }
        i = i + 1
    }
    return true
}

fn mix(v: *mut Vec[i64]) -> u64 {
    var s: u64 = 0
    var q: u64 = 0
    var i: usize = 0
    while i < (*v).len {
        let x: u64 = vec_at[i64](v, i) as u64
        s = s +% x
        q = q +% ((x ^ 0x9E3779B97F4A7C15) *% 0xBF58476D1CE4E5B9 >> 17)
        i = i + 1
    }
    return s ^ (q *% 31)
}

fn check_oracle(n: usize, shape: i32, desc: bool) -> bool {
    var a: Vec[i64] = vec_new[i64]()
    var b: Vec[i64] = vec_new[i64]()
    defer vec_free[i64](&a)
    defer vec_free[i64](&b)
    fill(&a, n, shape)
    var i: usize = 0
    while i < n {
        vec_push[i64](&b, vec_at[i64](&a, i))
        i = i + 1
    }
    oracle(&b, desc)
    if desc { vec_sort_by[i64](&a, i64_greater) } else { vec_sort[i64](&a) }
    return same(&a, &b)
}

fn check_big(n: usize, shape: i32, desc: bool) -> bool {
    var a: Vec[i64] = vec_new[i64]()
    defer vec_free[i64](&a)
    fill(&a, n, shape)
    let before: u64 = mix(&a)
    if desc {
        vec_sort_by[i64](&a, i64_greater)
        if !vec_is_sorted_by[i64](&a, i64_greater) { return false }
    } else {
        vec_sort[i64](&a)
        if !vec_is_sorted[i64](&a) { return false }
    }
    return mix(&a) == before
}

fn check_rec(n: usize, shape: i32) -> bool {
    var p: Vec[Rec] = vec_new[Rec]()
    defer vec_free[Rec](&p)
    var i: usize = 0
    var tagsum: i64 = 0
    var tagxor: i64 = 0
    while i < n {
        let t: i64 = (i * 7919 + 13) as i64
        vec_push[Rec](&p, Rec { k: gen(shape, i, n), tag: t })
        tagsum = tagsum + t
        tagxor = tagxor ^ (t * 31)
        i = i + 1
    }
    if shape % 2 == 0 { vec_sort[Rec](&p) } else { vec_sort_by[Rec](&p, rec_less) }
    var j: usize = 0
    var ts: i64 = 0
    var tx: i64 = 0
    while j < p.len {
        let b: *mut Rec = vec_elem_ptr[Rec](&p, j)
        if j > 0 {
            let a: *mut Rec = vec_elem_ptr[Rec](&p, j - 1)
            if (*b).k < (*a).k { return false }
        }
        ts = ts + (*b).tag
        tx = tx ^ ((*b).tag * 31)
        j = j + 1
    }
    return ts == tagsum && tx == tagxor
}

fn check_u8(n: usize, shape: i32) -> bool {
    var v: Vec[u8] = vec_new[u8]()
    defer vec_free[u8](&v)
    var cnt: [i64; 256] = [0; 256]
    var i: usize = 0
    while i < n {
        let x: u8 = (gen(shape, i, n) & 255) as u8
        vec_push[u8](&v, x)
        cnt[x as usize] = cnt[x as usize] + 1
        i = i + 1
    }
    vec_sort[u8](&v)
    if !vec_is_sorted[u8](&v) { return false }
    var j: usize = 0
    while j < n {
        cnt[vec_at[u8](&v, j) as usize] = cnt[vec_at[u8](&v, j) as usize] - 1
        j = j + 1
    }
    var c: usize = 0
    while c < 256 {
        if cnt[c] != 0 { return false }
        c = c + 1
    }
    return true
}

fn main() -> i32 {
    var shape: i32 = 0
    while shape < 13 {
        var n: usize = 0
        while n <= 140 {
            if !check_oracle(n, shape, false) { return 100 + shape }
            if !check_oracle(n, shape, true) { return 120 + shape }
            n = n + 1
        }
        shape = shape + 1
    }
    shape = 0
    while shape < 13 {
        var n: usize = 141
        while n <= 2000 {
            if !check_big(n, shape, false) { return 10 + shape }
            if !check_big(n, shape, true) { return 30 + shape }
            n = n + 13
        }
        if !check_big(24, shape, false) { return 50 }
        if !check_big(25, shape, false) { return 51 }
        if !check_big(50000, shape, false) { return 52 }
        if !check_big(50000, shape, true) { return 53 }
        if !check_rec(3001, shape) { return 60 + shape }
        if !check_u8(4099, shape) { return 80 + shape }
        shape = shape + 1
    }
    if !check_big(1000000, 0, false) { return 90 }
    if !check_big(1000000, 9, false) { return 91 }
    if !check_big(1000000, 7, true) { return 92 }
    return 0
}
