// expect_exit: 0
import jxl.jxl_srgb

static mut failures: i32 = 0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn verify(maxv: f64) {
    let t: u64 = jxl_srgb.srgb_table_new(maxv)
    check(t != 0)
    var state: u64 = 88172645463325252
    var i: usize = 0
    while i < 200000 {
        state = state ^ (state << 13)
        state = state ^ (state >> 7)
        state = state ^ (state << 17)
        let v: f64 = ((state >> 11) as f64) / 9007199254740992.0 * 1.2 - 0.1
        check(jxl_srgb.srgb_table_encode(t, v, maxv) == jxl_srgb.srgb_encode(v, maxv))
        i = i + 1
    }
    var q: usize = 1
    while q <= (maxv as usize) {
        let edge: f64 = *((t +% ((q * 8) as u64)) as *mut f64)
        let lo: f64 = edge * (1.0 - 1e-12)
        let hi: f64 = edge * (1.0 + 1e-12)
        check(jxl_srgb.srgb_table_encode(t, lo, maxv) == jxl_srgb.srgb_encode(lo, maxv))
        check(jxl_srgb.srgb_table_encode(t, hi, maxv) == jxl_srgb.srgb_encode(hi, maxv))
        q = q + 1
    }
    jxl_srgb.srgb_table_free(t, maxv)
}

fn main() -> i32 {
    verify(255.0)
    verify(1023.0)
    verify(4095.0)
    return failures
}
