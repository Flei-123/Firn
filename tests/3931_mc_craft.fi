// expect_exit: 0
// r158 craft prediction in mc_inv (recipe table from minecraft-data via tools/mcgen/gen_recipes.py, matcher lib/mc/mc_craft.fi):
// 2x2 grid of the player window and 3x3 grid of the crafting table: the result slot follows the grid (shaped, mirrored, shapeless), left click on the result
// takes it / merges it into an equal cursor stack and uses up one of every ingredient (right click too), shift click crafts repeatedly into the inventory,
// the remainder item (milk bucket -> bucket) stays in the grid (3932), without a recipe table nothing changes. Checked for several protocols
// (the Click Container packet must parse with the schema of the version). Return codes: 1xx = setup, case*10 + check.
import std.rt
import std.bytes
import mc.mc_version
import mc.mc_versions
import mc.mc_sem
import mc.mc_schema
import mc.mc_registry
import mc.mc_craft
import mc.mc_craft_sel
import mc.mc_inv

fn it(r: *mut mc_registry.Registry, name: str) -> i32 { return mc_registry.reg_item_by_name(r, name.p as u64, name.n) }

fn layout(ver: *mut mc_version.Version, b: *mut bytes.Bytes) -> bool {
    let id: i32 = mc_version.version_pid(ver, mc_sem.SEM_PLAY_C2S_WINDOW_CLICK)
    if id < 0 { return false }
    let sch: u64 = (*ver).schema_of(mc_version.ST_PLAY, mc_version.DIR_C2S, id)
    if sch == 0 as u64 { return false }
    bytes.bytes_set_pos(b, 0)
    var out: rt.Buf = rt.buf_new()
    let ok: bool = mc_schema.walk(sch, b, &out)
    rt.buf_free(&out)
    return ok
}

// one click; the packet must parse with the schema of the version; returns the number of changed slots (>= 0) or -1 / -2
fn clk(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, slot: i32, button: i32, mode: i32) -> i32 {
    var b: bytes.Bytes = bytes.bytes_new()
    if !mc_inv.inv_click_build(v, (*ver).protocol, slot, button, mode, &b) { return 0 - 1 }
    let ok: bool = layout(ver, &b)
    var n: i32 = 0
    if (*ver).protocol >= 756 { n = bytes.bytes_at(&b, 6) as i32 }
    bytes.bytes_free(&b)
    if !ok { return 0 - 2 }
    return n
}

fn open_table(v: *mut mc_inv.Inv, ver: *mut mc_version.Version, id: i32) -> bool {
    var b: bytes.Bytes = bytes.bytes_new()
    var typ: i32 = 11
    if (*ver).protocol >= 765 { typ = 12 }
    bytes.put_varint(&b, id)
    bytes.put_varint(&b, typ)
    bytes.put_u8(&b, 0 as u8)
    bytes.bytes_set_pos(&b, 0)
    let ok: bool = mc_inv.inv_on_open_window_v(v, ver, &b)
    bytes.bytes_free(&b)
    return ok
}

fn total(v: *mut mc_inv.Inv, item: i32) -> i32 {
    var n: i32 = 0
    var k: i32 = 9
    while k < 45 {
        if mc_inv.inv_item(v, k) == item { n = n + mc_inv.inv_count(v, k) }
        k = k + 1
    }
    return n
}

fn fresh(r: *mut mc_registry.Registry, rc: *mut mc_craft.Recipes) -> mc_inv.Inv {
    var v: mc_inv.Inv = mc_inv.inv_new()
    v.state_id = 5
    mc_inv.inv_use_registry(&v, r)
    if rc != 0 as *mut mc_craft.Recipes { mc_inv.inv_use_recipes(&v, rc) }
    return v
}

fn check(p: i32) -> i32 {
    var ver: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(p, &ver) { return 100 }
    var r: mc_registry.Registry = ver.registry_of()
    if !mc_registry.registry_ok(&r) { return 101 }
    var rc: mc_craft.Recipes = mc_craft_sel.recipes_for_protocol(p)
    if !mc_craft.craft_ok(&rc) || mc_craft.craft_count(&rc) < 500 { return 102 }
    let planks: i32 = it(&r, "oak_planks")
    let stick: i32 = it(&r, "stick")
    let table: i32 = it(&r, "crafting_table")
    let log: i32 = it(&r, "oak_log")
    let string: i32 = it(&r, "string")
    let bow: i32 = it(&r, "bow")
    let milk: i32 = it(&r, "milk_bucket")
    let sugar: i32 = it(&r, "sugar")
    let egg: i32 = it(&r, "egg")
    let wheat: i32 = it(&r, "wheat")
    let cake: i32 = it(&r, "cake")
    let dirt: i32 = it(&r, "dirt")
    if planks < 0 || stick < 0 || table < 0 || log < 0 || string < 0 || bow < 0 || milk < 0 || sugar < 0 || egg < 0 || wheat < 0 || cake < 0 || dirt < 0 { return 103 }

    // ---- player window, 2x2 grid (slots 1..4, result 0)
    var v: mc_inv.Inv = fresh(&r, &rc)
    // 1: carry 8 planks, right click puts one into slot 1 (no recipe), one into slot 3 below it -> stick x4
    mc_inv.inv_set(&v, 9, planks, 8)
    if clk(&v, &ver, 9, 0, 0) < 0 || mc_inv.inv_cursor_count(&v) != 8 { return 10 }
    if clk(&v, &ver, 1, 1, 0) < 0 { return 11 }
    if mc_inv.inv_item(&v, 0) != it(&r, "oak_button") { return 12 } // one plank alone = wooden button (shapeless)
    let n1: i32 = clk(&v, &ver, 3, 1, 0)
    if n1 < 0 { return 13 }
    if mc_inv.inv_item(&v, 0) != stick || mc_inv.inv_count(&v, 0) != 4 { return 14 }
    if p >= 756 && n1 != 2 { return 15 } // grid slot 3 and the result slot
    // 2: left click on the result with a different carried stack: nothing happens
    if clk(&v, &ver, 20, 0, 0) < 0 || mc_inv.inv_cursor_item(&v) != 0 - 1 || mc_inv.inv_count(&v, 20) != 6 { return 20 } // put the 6 planks away
    mc_inv.inv_set(&v, 21, dirt, 3)
    if clk(&v, &ver, 21, 0, 0) < 0 || mc_inv.inv_cursor_item(&v) != dirt { return 21 }
    if clk(&v, &ver, 0, 0, 0) < 0 { return 22 }
    if mc_inv.inv_cursor_item(&v) != dirt || mc_inv.inv_item(&v, 0) != stick || mc_inv.inv_item(&v, 1) != planks || mc_inv.inv_item(&v, 3) != planks { return 23 }
    if clk(&v, &ver, 21, 0, 0) < 0 { return 24 }
    // 3: take the result with an empty hand: cursor = 4 sticks, one plank of every ingredient is used up, the result is recomputed
    if clk(&v, &ver, 0, 0, 0) < 0 { return 30 }
    if mc_inv.inv_cursor_item(&v) != stick || mc_inv.inv_cursor_count(&v) != 4 { return 31 }
    if mc_inv.inv_item(&v, 1) != 0 - 1 || mc_inv.inv_item(&v, 3) != 0 - 1 || mc_inv.inv_item(&v, 0) != 0 - 1 { return 32 }
    // grid slots 1 and 3 still hold 1 plank each? (they held 1 each -> used up). Put the sticks away
    if clk(&v, &ver, 22, 0, 0) < 0 || mc_inv.inv_count(&v, 22) != 4 { return 33 }
    // 4: grid with 5 planks in slots 1 and 3 -> carried sticks merge: 2 x 4 sticks into a cursor holding 60 sticks
    mc_inv.inv_set(&v, 1, planks, 5)
    mc_inv.inv_set(&v, 3, planks, 5)
    mc_inv.inv_craft_update(&v)
    if mc_inv.inv_item(&v, 0) != stick || mc_inv.inv_count(&v, 0) != 4 { return 40 }
    mc_inv.inv_set(&v, 23, stick, 60)
    if clk(&v, &ver, 23, 0, 0) < 0 || mc_inv.inv_cursor_count(&v) != 60 { return 41 }
    if clk(&v, &ver, 0, 0, 0) < 0 || mc_inv.inv_cursor_count(&v) != 64 || mc_inv.inv_count(&v, 1) != 4 || mc_inv.inv_count(&v, 3) != 4 { return 42 }
    // 60 + 4 = 64 -> fits; the next craft (4 more) does not fit into the full cursor stack: nothing changes
    if clk(&v, &ver, 0, 0, 0) < 0 || mc_inv.inv_cursor_count(&v) != 64 || mc_inv.inv_count(&v, 1) != 4 { return 43 }
    if clk(&v, &ver, 24, 0, 0) < 0 { return 44 }
    // right click on the result takes it like a left click (3932 checks more of it)
    if clk(&v, &ver, 0, 1, 0) < 0 || mc_inv.inv_count(&v, 1) != 3 || mc_inv.inv_cursor_item(&v) != stick || mc_inv.inv_cursor_count(&v) != 4 { return 45 }
    if clk(&v, &ver, 25, 0, 0) < 0 || mc_inv.inv_count(&v, 25) != 4 { return 46 }
    // 5: shift click: 3 crafts (3 planks in each slot) -> 12 sticks into the main inventory + hotbar from the back (merges into slot 25)
    let n5: i32 = clk(&v, &ver, 0, 0, 1)
    if n5 < 0 { return 50 }
    if total(&v, stick) != 4 + 64 + 16 || mc_inv.inv_count(&v, 25) != 16 || mc_inv.inv_count(&v, 22) != 4 { return 51 } // merges into the not-full stack of 4 at slot 25 (from the back), the 64 stays
    if mc_inv.inv_item(&v, 1) != 0 - 1 || mc_inv.inv_item(&v, 3) != 0 - 1 || mc_inv.inv_item(&v, 0) != 0 - 1 { return 52 }
    if p >= 756 && n5 != 4 { return 53 } // slots 1, 3 (emptied), result (back to empty... it was a stick stack), 44
    // 6: crafting table from 4 planks (2x2 shaped), shift click with 3 sets
    mc_inv.inv_set(&v, 1, planks, 3)
    mc_inv.inv_set(&v, 2, planks, 3)
    mc_inv.inv_set(&v, 3, planks, 3)
    mc_inv.inv_set(&v, 4, planks, 3)
    mc_inv.inv_craft_update(&v)
    if mc_inv.inv_item(&v, 0) != table || mc_inv.inv_count(&v, 0) != 1 { return 60 }
    if clk(&v, &ver, 0, 0, 1) < 0 { return 61 }
    if mc_inv.inv_item(&v, 44) != table || mc_inv.inv_count(&v, 44) != 3 || mc_inv.inv_item(&v, 1) != 0 - 1 || mc_inv.inv_item(&v, 0) != 0 - 1 { return 62 }
    // 7: shapeless: one log -> 4 planks
    mc_inv.inv_set(&v, 2, log, 1)
    mc_inv.inv_craft_update(&v)
    if mc_inv.inv_item(&v, 0) != planks || mc_inv.inv_count(&v, 0) != 4 { return 70 }
    mc_inv.inv_set(&v, 2, 0 - 1, 0)
    mc_inv.inv_craft_update(&v)
    if mc_inv.inv_item(&v, 0) != 0 - 1 { return 71 }
    mc_inv.inv_free(&v)

    // 8: without a recipe table nothing is predicted
    var v0: mc_inv.Inv = fresh(&r, 0 as *mut mc_craft.Recipes)
    mc_inv.inv_set(&v0, 9, planks, 8)
    if clk(&v0, &ver, 9, 0, 0) < 0 || clk(&v0, &ver, 1, 1, 0) < 0 || clk(&v0, &ver, 3, 1, 0) < 0 { return 80 }
    if mc_inv.inv_item(&v0, 0) != 0 - 1 { return 81 }
    mc_inv.inv_free(&v0)

    // ---- crafting table window (id 7): result 0, grid 1..9 (window slots), inventory 10..45
    var t: mc_inv.Inv = fresh(&r, &rc)
    if !open_table(&t, &ver, 7) { return 90 }
    if mc_inv.inv_window_slots(&t) != 10 { return 91 }
    // 9: bow, placed mirrored: [string stick .] [string . stick] [string stick .]  (recipe: [. stick string] [stick . string] [. stick string])
    let g: i32 = 46 // internal slot of container slot 0 (result); grid k = g + k
    mc_inv.inv_set(&t, g + 1, string, 1)
    mc_inv.inv_set(&t, g + 2, stick, 1)
    mc_inv.inv_set(&t, g + 4, string, 1)
    mc_inv.inv_set(&t, g + 6, stick, 1)
    mc_inv.inv_set(&t, g + 7, string, 1)
    mc_inv.inv_set(&t, g + 8, stick, 1)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != bow { return 92 }
    // the same grid shifted one column right is not a recipe? (bow fits at any offset: the bounding box counts) -> still a bow after moving
    // one string away: no recipe
    mc_inv.inv_set(&t, g + 7, 0 - 1, 0)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != 0 - 1 { return 93 }
    mc_inv.inv_set(&t, g + 7, string, 1)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != bow { return 94 }
    // take the bow: window slot 0 -> cursor, grid used up
    let nb: i32 = clk(&t, &ver, 0, 0, 0)
    if nb < 0 { return 95 }
    if mc_inv.inv_cursor_item(&t) != bow || mc_inv.inv_item(&t, g + 1) != 0 - 1 || mc_inv.inv_item(&t, g) != 0 - 1 { return 96 }
    // 10: cake (3 milk buckets): the empty buckets stay in the grid slots of the milk
    if clk(&t, &ver, 11, 0, 0) < 0 { return 100 } // put the bow into window slot 11 (main inventory)
    mc_inv.inv_set(&t, g + 1, milk, 1)
    mc_inv.inv_set(&t, g + 2, milk, 1)
    mc_inv.inv_set(&t, g + 3, milk, 1)
    mc_inv.inv_set(&t, g + 4, sugar, 1)
    mc_inv.inv_set(&t, g + 5, egg, 1)
    mc_inv.inv_set(&t, g + 6, sugar, 1)
    mc_inv.inv_set(&t, g + 7, wheat, 1)
    mc_inv.inv_set(&t, g + 8, wheat, 1)
    mc_inv.inv_set(&t, g + 9, wheat, 1)
    mc_inv.inv_craft_update(&t)
    if mc_inv.inv_item(&t, g) != cake { return 101 }
    let nc: i32 = clk(&t, &ver, 0, 0, 0)
    if nc < 0 { return 102 }
    if p >= 756 && nc != 10 { return 103 } // result + all 9 grid slots changed
    let bucket: i32 = it(&r, "bucket")
    if bucket < 0 || mc_inv.inv_cursor_item(&t) != cake || mc_inv.inv_item(&t, g) != 0 - 1 { return 104 }
    if mc_inv.inv_item(&t, g + 1) != bucket || mc_inv.inv_item(&t, g + 3) != bucket || mc_inv.inv_item(&t, g + 4) != 0 - 1 || mc_inv.inv_item(&t, g + 9) != 0 - 1 { return 105 }
    mc_inv.inv_free(&t)
    return 0
}

fn main() -> i32 {
    // matcher unit checks on the raw table: 1.20.1
    var ver0: mc_version.Version = mc_version.version_empty()
    if !mc_versions.version_by_protocol(763, &ver0) { return 1 }
    var r0: mc_registry.Registry = ver0.registry_of()
    var rc0: mc_craft.Recipes = mc_craft_sel.recipes_for_protocol(763)
    if !mc_craft.craft_ok(&rc0) { return 2 }
    let g: u64 = rt.heap_alloc(9 * 4)
    var i: usize = 0
    while i < 9 { rt.st32(g, i, 0 as u32); i = i + 1 }
    var cnt: i32 = 0
    if mc_craft.craft_match(&rc0, g, 3, &cnt) != 0 - 1 { return 3 } // empty grid
    let planks: i32 = it(&r0, "oak_planks")
    let stick: i32 = it(&r0, "stick")
    rt.st32(g, 4, (it(&r0, "dirt") + 1) as u32) // one dirt in the middle of a 3x3 grid: no recipe
    if mc_craft.craft_match(&rc0, g, 3, &cnt) != 0 - 1 { return 4 }
    rt.st32(g, 4, (planks + 1) as u32)
    rt.st32(g, 7, (planks + 1) as u32) // two planks stacked in the middle column: sticks, whatever the offset
    if mc_craft.craft_match(&rc0, g, 3, &cnt) != stick || cnt != 4 { return 5 }
    rt.st32(g, 4, 0 as u32)
    rt.st32(g, 7, 0 as u32)
    rt.st32(g, 0, (planks + 1) as u32)
    rt.st32(g, 3, (planks + 1) as u32)
    if mc_craft.craft_match(&rc0, g, 3, &cnt) != stick { return 6 } // left column
    rt.heap_free(g, 9 * 4)
    let protos: [i32; 6] = [754, 763, 767, 770, 772, 775]
    var k: usize = 0
    while k < 6 {
        let rcode: i32 = check(protos[k])
        if rcode != 0 { return rcode + (k as i32 + 1) * 1000 }
        k = k + 1
    }
    return 0
}
