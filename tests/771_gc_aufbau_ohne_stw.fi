// expect_exit: 0
// AUFBAUPHASE OHNE STOP-THE-WORLD — der Test zur Runde 44.
//
// Bis Runde 43 lief der Sammler unterhalb von 8 MiB Heap ATOMAR. Beim
// Aufbau einer grossen lebenden Menge waren das gemessen drei volle
// Stop-the-World-Laeufe mit bis zu 11,8 ms (docs/RUNDE44.md). Seit Runde 44
// laeuft der Zyklus ab dem ersten Lauf in Scheiben.
//
// Geprueft wird deterministisch (KEIN Zeitvergleich — der waere auf einer
// belasteten Maschine wackelig):
//   * beim Aufbau ueber die alte Schwelle hinaus laeuft KEIN voller
//     Stop-the-World-Zyklus mehr (gc_volle_laeufe() == 0),
//   * es wurde ueberhaupt gesammelt (sonst prueft der Test nichts),
//   * der Heap bleibt nahe an der lebenden Menge — das faengt den Rueckfall
//     ein, dass beim gestueckelten Fegen wieder frische Chunks statt der
//     Freilisten benutzt werden (Runde 44: das verdoppelte den Heap),
//   * die Kette ist danach VOLLSTAENDIG und in der richtigen Reihenfolge:
//     der inkrementelle Zyklus darf nichts Lebendes einsammeln.

const N: u64 = 200000

gc class Knoten {
    naechster: Gc[Knoten],
    wert: u64,
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    return lauf() catch 91
}

fn lauf() -> AllocError!i32 {
    var kopf: Gc[Knoten] = gc_null[Knoten]()
    var i: u64 = 0
    while i < N {
        let k: Gc[Knoten] = try gc Knoten{ naechster: kopf, wert: i }
        kopf = k
        i = i + 1
    }
    // Der Heap muss ueber die alte Umschaltschwelle (8 MiB) gewachsen sein,
    // sonst sagt der Test nichts ueber die Aufbauphase aus.
    if gc_heap_bytes() < 8388608 {
        return 1
    }
    if gc_collections() == 0 {
        return 2
    }
    // Der Kern der Runde 44.
    if gc_volle_laeufe() != 0 {
        return 3
    }
    // Heap nahe an der lebenden Menge (gemessen 1,2-fach; 2,5-fach ist die
    // grosszuegige Schranke, der alte Fehler lag bei ueber dem Doppelten).
    let leb: u64 = gc_live_bytes()
    if leb == 0 {
        return 4
    }
    if gc_heap_bytes() / 1024 > leb / 1024 * 5 / 2 {
        return 5
    }
    // Nichts Lebendes darf verloren gegangen sein.
    var n: u64 = 0
    var p: Gc[Knoten] = kopf
    while p != gc_null[Knoten]() {
        if p.wert != N - 1 - n {
            return 6
        }
        p = p.naechster
        n = n + 1
    }
    if n != N {
        return 7
    }
    return 0
}
