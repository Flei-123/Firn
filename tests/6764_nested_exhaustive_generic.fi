// expect_exit: 0
enum Opt[T] { Some(T), None }
enum Out[T] { I(Opt[T]), O }
fn f(o: Out[i32]) -> i32 {
    match o {
        Out::I(Opt::Some(v)) => { return v }
        Out::I(Opt::None) => { return 1 }
        Out::O => { return 200 }
    }
    return 0
}
fn main() -> i32 { return f(Out[i32]::O) - 200 }
