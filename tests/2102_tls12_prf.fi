// expect_exit: 0
// tests/2102_tls12_prf.fi -- the TLS 1.2 key derivation (lib/tls/prf12.fi)
// against known answers.
//
//  A  HMAC-SHA384: RFC 4231 cases 1, 2 and 6 (the last has a key longer than
//     the 128-octet block, which is hashed first)
//  B  the TLS 1.2 PRF with SHA-256: the vector from the IETF TLS working
//     group (secret 9bbe436b..., label "test label", 100 octets), the one
//     every TLS 1.2 implementation checks itself against
//  C  the PRF with SHA-384 on the same input (the expected octets come from
//     an independent implementation of RFC 5246 5 on top of Python's hmac)
//  D  output lengths that are no multiple of the hash size: 1, 12, 47, 48, 49
//     octets are each a prefix of the 100 octet answer
//  E  master secret, key expansion and Finished label order: the first
//     octets of each are what the PRF gives for the right label and seed and
//     differ from the wrong order
import std.rt
import std.str
import tls.prf12

fn hexval(c: u8) -> u8 {
    if c >= 97 as u8 {
        return c - 87 as u8
    }
    return c - 48 as u8
}

// hex text -> octets
fn unhex(s: str, out: *mut rt.Buf) {
    var i: usize = 0
    while i + 1 < s.length() {
        rt.buf_push(out, (hexval(s.chars(i)) << 4 as u8) | hexval(s.chars(i + 1)))
        i = i + 2
    }
}

fn same(b: *mut rt.Buf, p: u64, n: usize) -> bool {
    return rt.buf_len(b) == n && rt.mem_eq(rt.buf_ptr(b), p, n)
}

fn main() -> i32 {
    var want: rt.Buf = rt.buf_new()
    var key: rt.Buf = rt.buf_new()
    var msg: rt.Buf = rt.buf_new()
    var out: [u8; 160] = [0 as u8; 160]
    let o: u64 = (&out[0]) as u64

    // ---- A. HMAC-SHA384
    var i: usize = 0
    while i < 20 {
        rt.buf_push(&key, 11 as u8)
        i = i + 1
    }
    prf12.hmac_sha384(rt.buf_ptr(&key), 20, "Hi There".p as u64, 8, o)
    unhex("afd03944d84895626b0825f4ab46907f15f9dadbe4101ec682aa034c7cebc59cfaea9ea9076ede7f4af152e8b2fa9cb6", &want)
    if !same(&want, o, 48) { return 1 as i32 }
    rt.buf_clear(&want)
    prf12.hmac_sha384("Jefe".p as u64, 4, "what do ya want for nothing?".p as u64, 28, o)
    unhex("af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649", &want)
    if !same(&want, o, 48) { return 2 as i32 }
    rt.buf_clear(&want)
    rt.buf_clear(&key)
    i = 0
    while i < 131 {
        rt.buf_push(&key, 170 as u8)
        i = i + 1
    }
    prf12.hmac_sha384(rt.buf_ptr(&key), 131,
        "Test Using Larger Than Block-Size Key - Hash Key First".p as u64, 54, o)
    unhex("4ece084485813e9088d2c63a041bc5b44f9ef1012a2b588f3cd11f05033ac4c60c2ef6ab4030fe8296248df163f44952", &want)
    if !same(&want, o, 48) { return 3 as i32 }
    rt.buf_clear(&want)

    // ---- B. PRF SHA-256, the IETF vector
    rt.buf_clear(&key)
    unhex("9bbe436ba940f017b17652849a71db35", &key)
    unhex("a0ba9f936cda311827a6f796ffd5198c", &msg)
    var full256: rt.Buf = rt.buf_new()
    unhex("e3f229ba727be17b8d122620557cd453c2aab21d07c3d495329b52d4e61edb5a6b301791e90d35c9c9a46b4e14baf9af0fa022f7077def17abfd3797c0564bab4fbc91666e9def9b97fce34f796789baa48082d122ee42c5a72e5a5110fff70187347b66", &full256)
    if !prf12.prf(prf12.PRF_SHA256, rt.buf_ptr(&key), 16, "test label".p as u64, 10,
        rt.buf_ptr(&msg), 16, o, 100) { return 4 as i32 }
    if !same(&full256, o, 100) { return 5 as i32 }

    // ---- C. PRF SHA-384
    var full384: rt.Buf = rt.buf_new()
    unhex("dd88775cd827187b67a3f7652b5c13f715791cc46e0274a6d3fb16651103defc544cd8afb68369a219bb918b8b21ddb1764af0a70339e6dec085e574f655851ba692513203536bdfc3675e53768210f0a2389dd324311a440c7c30ef44b391d914c3b0c7", &full384)
    if !prf12.prf(prf12.PRF_SHA384, rt.buf_ptr(&key), 16, "test label".p as u64, 10,
        rt.buf_ptr(&msg), 16, o, 100) { return 6 as i32 }
    if !same(&full384, o, 100) { return 7 as i32 }

    // ---- D. every length is a prefix of the long answer
    var lens: [usize; 6] = [1, 12, 31, 47, 48, 49]
    var k: usize = 0
    while k < 6 {
        var shorter: [u8; 64] = [0 as u8; 64]
        let sp: u64 = (&shorter[0]) as u64
        let n: usize = lens[k]
        if !prf12.prf(prf12.PRF_SHA384, rt.buf_ptr(&key), 16, "test label".p as u64, 10,
            rt.buf_ptr(&msg), 16, sp, n) { return 8 as i32 }
        if !rt.mem_eq(sp, rt.buf_ptr(&full384), n) { return 9 as i32 }
        // and nothing was written past the end
        if n < 64 && shorter[n] != 0 as u8 { return 10 as i32 }
        k = k + 1
    }

    // ---- E. the labels
    var cr: [u8; 32] = [1 as u8; 32]
    var sr: [u8; 32] = [2 as u8; 32]
    var pms: [u8; 32] = [3 as u8; 32]
    var m1: [u8; 48] = [0 as u8; 48]
    var m2: [u8; 48] = [0 as u8; 48]
    if !prf12.master_secret(prf12.PRF_SHA256, (&pms[0]) as u64, 32, (&cr[0]) as u64,
        (&sr[0]) as u64, (&m1[0]) as u64) { return 11 as i32 }
    // the randoms in the other order give another master secret
    if !prf12.master_secret(prf12.PRF_SHA256, (&pms[0]) as u64, 32, (&sr[0]) as u64,
        (&cr[0]) as u64, (&m2[0]) as u64) { return 12 as i32 }
    if rt.mem_eq((&m1[0]) as u64, (&m2[0]) as u64, 48) { return 13 as i32 }
    // the extended derivation differs from the plain one on the same input
    if !prf12.master_secret_ems(prf12.PRF_SHA256, (&pms[0]) as u64, 32, (&cr[0]) as u64,
        64, (&m2[0]) as u64) { return 14 as i32 }
    if rt.mem_eq((&m1[0]) as u64, (&m2[0]) as u64, 48) { return 15 as i32 }
    // the key block: client and server randoms enter in the opposite order
    // to the master secret (RFC 5246 6.3 versus 8.1)
    var kb1: [u8; 72] = [0 as u8; 72]
    var kb2: [u8; 72] = [0 as u8; 72]
    if !prf12.key_expansion(prf12.PRF_SHA384, (&m1[0]) as u64, (&cr[0]) as u64,
        (&sr[0]) as u64, (&kb1[0]) as u64, 72) { return 16 as i32 }
    if !prf12.key_expansion(prf12.PRF_SHA384, (&m1[0]) as u64, (&sr[0]) as u64,
        (&cr[0]) as u64, (&kb2[0]) as u64, 72) { return 17 as i32 }
    if rt.mem_eq((&kb1[0]) as u64, (&kb2[0]) as u64, 72) { return 18 as i32 }
    // Finished: the two labels give two answers, and 12 octets
    var f1: [u8; 12] = [0 as u8; 12]
    var f2: [u8; 12] = [0 as u8; 12]
    if !prf12.verify_data(prf12.PRF_SHA256, (&m1[0]) as u64, true, (&cr[0]) as u64, 32,
        (&f1[0]) as u64) { return 19 as i32 }
    if !prf12.verify_data(prf12.PRF_SHA256, (&m1[0]) as u64, false, (&cr[0]) as u64, 32,
        (&f2[0]) as u64) { return 20 as i32 }
    if rt.mem_eq((&f1[0]) as u64, (&f2[0]) as u64, 12) { return 21 as i32 }
    return 0
}
