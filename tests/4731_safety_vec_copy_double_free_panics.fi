// expect_exit: 101
// r905: a copy of a Vec freed together with the original is a double free of the storage: panic instead of two Vecs that share memory.
import std.rt
import std.vec

fn main() -> i32 {
    if !gc_init() { return 9 }
    var v: Vec[i32] = vec_new[i32]()
    vec_push[i32](&v, 5)
    var w: Vec[i32] = v
    vec_free[i32](&v)
    vec_free[i32](&w)
    return 0
}
