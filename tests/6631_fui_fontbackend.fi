// expect_exit: 0
import std.rt
import paint.canvas
import font.metrics
import font.fontprov
import font.platmetrics
import font.platglyph
import fui.painter
import fui.face

static mut failures: i32 = 0
static mut G_GLYPH_CALLS: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn fake_advance(cp: u32, size: f64, weight: u32) -> f64 {
    var w: f64 = size * 0.5
    if weight >= 700 { w = size * 0.6 }
    return w
}

fn fake_pair(a: u32, b: u32, size: f64, weight: u32) -> f64 {
    if a == 65 && b == 86 { return 0.0 - size * 0.1 }
    return 0.0
}

fn fake_vmetrics(size: f64, weight: u32, out: *mut f64) -> bool {
    *out = size * 0.9
    *((out as u64 + 8) as *mut f64) = size * 0.3
    return true
}

fn fake_glyph(cp: u32, size: f64, weight: u32, slant: u32, qx: u32, buf: u64, cap: usize, meta: *mut i32) -> i64 {
    G_GLYPH_CALLS += 1
    var i: usize = 0
    while i < 12 {
        *((buf + i as u64) as *mut u8) = 255 as u8
        i = i + 1
    }
    *meta = 4 as i32
    *((meta as u64 + 4) as *mut i32) = 3 as i32
    *((meta as u64 + 8) as *mut i32) = 1 as i32
    *((meta as u64 + 12) as *mut i32) = 5 as i32
    return 12 as i64
}

fn run_text(z: *mut painter.Painter, s: str, size: f64, weight: usize) -> f64 {
    var r: painter.TextRun = painter.run_new(size)
    r = painter.run_set_weight(r, weight)
    return painter.run_width(z, &r, s.p as u64, s.n)
}

fn main() -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, 200, 60) { return 1 as i32 }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 200, 60) { return 2 as i32 }
    face.install(&z)
    let base: u64 = painter.painter_font(&z)
    check("inter face loaded", metrics.fm_present(base))
    let emb_w: f64 = run_text(&z, "Hello World", 16.0, 400)
    let emb_asc: f64 = metrics.fm_ascent(base, 16.0)
    check("embedded width positive", emb_w > 10.0)

    fontprov.prov_set(fontprov.Provider { advance: fake_advance, pair: fake_pair, vmetrics: fake_vmetrics, glyph: fake_glyph })
    check("embedded is default mode", fontprov.mode_get() == fontprov.MODE_EMBEDDED && !fontprov.platform_on())
    var fs: metrics.FontSet = metrics.fontset_new()
    metrics.fontset_platform(&fs, base as *mut metrics.FontSet, 400)
    painter.painter_set_font(&z, (&fs) as u64)
    check("embedded unchanged after provider registered", run_text(&z, "Hello World", 16.0, 400) == emb_w)
    check("embedded ascent unchanged", metrics.fm_ascent((&fs) as u64, 16.0) == emb_asc)
    check("gid not platform in embedded mode", (metrics.fm_gid((&fs) as u64, 65) & metrics.GID_PLATFORM) == 0 as u32)

    fontprov.mode_set(fontprov.MODE_PLATFORM)
    check("platform mode on", fontprov.platform_on())
    let pw: f64 = run_text(&z, "Hello World", 16.0, 400)
    check("platform width from provider", pw == 11.0 * 8.0)
    check("platform width differs from embedded", pw != emb_w)
    check("platform ascent", metrics.fm_ascent((&fs) as u64, 20.0) == 18.0)
    check("platform descent", metrics.fm_descent((&fs) as u64, 20.0) == 6.0)
    check("platform kerning pair", run_text(&z, "AV", 10.0, 400) == 9.0)
    check("emoji falls back to embedded metric", metrics.fm_advance((&fs) as u64, 16.0, 0x1F600) == metrics.fm_advance(base, 16.0, 0x1F600))
    check("control falls back", !metrics.fm_has((&fs) as u64, 10) || metrics.fm_gid((&fs) as u64, 10) == 0 as u32)
    check("platform gid tagged", (metrics.fm_gid((&fs) as u64, 65) & metrics.GID_PLATFORM) != 0 as u32)
    check("cache hits after repeat", platmetrics.pm_stats(platmetrics.ST_ADV_HIT) > 0 && platmetrics.pm_stats(platmetrics.ST_ADV_MISS) > 0)

    canvas.canvas_clear(&cv, 4278190080 as u32)
    var r: painter.TextRun = painter.run_new(16.0)
    let s: str = "AAA"
    painter.run_draw(&z, &r, 10.0, 30.0, 0.0, 4294967295 as u32, s.p as u64, s.n, painter.TEXT_L)
    check("platform glyph bitmap requested once for repeated cp", G_GLYPH_CALLS >= 1)
    var lit: usize = 0
    var y: usize = 0
    while y < 60 {
        var x: usize = 0
        while x < 200 {
            if (canvas.canvas_get(&cv, x, y) & 255 as u32) > 128 as u32 { lit = lit + 1 }
            x = x + 1
        }
        y = y + 1
    }
    check("platform bitmap drawn", lit >= 12)
    check("glyph cache hit counted", platglyph.pg_stat(platglyph.PG_HIT) + platglyph.pg_stat(platglyph.PG_MISS) >= 1)

    fontprov.mode_set(fontprov.MODE_EMBEDDED)
    check("back to embedded exact", run_text(&z, "Hello World", 16.0, 400) == emb_w)
    fontprov.prov_clear()
    fontprov.mode_set(fontprov.MODE_PLATFORM)
    check("no provider keeps embedded", !fontprov.platform_on() && run_text(&z, "Hello World", 16.0, 400) == emb_w)

    if failures == 0 {
        rt.write_everything(1, "fontbackend ok\n".p as u64, 15)
    }
    return failures
}
