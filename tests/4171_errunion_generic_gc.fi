// expect_exit: 12
// r733: generic struct payload in E!Box[T], E!T over T, try gc inside a generic fn.
gc class Node { v: i32 }
struct Box[T] { v: T }
fn wrap[T](x: T) -> AllocError!Box[T] {
    return Box[T]{ v: x }
}
fn unwrap[T](b: *Box[T]) -> AllocError!T {
    return (*b).v
}
fn mk[T](x: T) -> AllocError!Gc[Node] {
    let n = try gc Node{ v: 5 }
    return n
}
fn run() -> AllocError!i32 {
    var b = try wrap[i32](7)
    let g = try unwrap[i32](&b)
    let n = try mk[i32](1)
    return g + n.v
}
fn main() -> i32 {
    if !gc_init() { return 90 }
    return run() catch 99
}
