// expect_out: r69 read: lines 4/14 dos ok empty ok eof ok all 25 ok
// tests/1282_std_io_read_line.fi -- reading input without a buffer of your
// own (round 69).
//
// `io.read_text()` gives back a `Text` that OWNS its octets; the `Span` is
// a view into it. What is checked here:
//
//   * the line feed is not part of the line, and a `\r` in front of it is
//     dropped as well (DOS line endings) -- the same rule `LineReader`
//     follows,
//   * an EMPTY LINE is a line (`is_ok`, length 0) while the END OF INPUT is
//     not (`is_ok` false) -- that is the `ReadLine() == null` of C#, and
//     without the distinction a program cannot tell "" apart from "done",
//   * a last line WITHOUT a closing line feed still is a line,
//   * `read_all()` reads everything that is left over, and it reads exactly
//     what `read_line` has NOT consumed -- the reader must not read ahead,
//     because the octets it read too much would have nowhere to live
//     (stage 0 has no global variables).
//
// Standard input is put in front of a file with `dup`/`dup2`, the same way
// tests/806 catches the output side. That keeps the test self-contained:
// it depends on no pipe of the test runner.
import std.io
import std.rt
import std.str

const SYS_DUP: i64 = 32
const SYS_DUP2: i64 = 33
const SYS_OPEN: i64 = 2
const SYS_CLOSE: i64 = 3
const O_ONLY_READ: i64 = 0
const O_WRITE: i64 = 577
const RIGHTS: i64 = 493

fn main() -> i32 {
    var path: [u8; 21] = "/tmp/firn1282_in.txt\0"
    // "alpha\r\n" "beta\n" "\n" "gamma\n" then the rest for read_all
    var content: [u8; 44] = "alpha\r\nbeta\n\ngamma\nrest one\nrest two (no nl)"

    if !io.write_file(rt.addr_of(&path[0]), rt.addr_of(&content[0]), 44) {
        return 10
    }

    let saved: i64 = syscall(SYS_DUP, 0, 0, 0, 0, 0, 0)
    if saved < 0 {
        return 11
    }
    let fd: i64 = syscall(SYS_OPEN, rt.addr_of(&path[0]) as i64, O_ONLY_READ,
        0, 0, 0, 0)
    if fd < 0 {
        return 12
    }
    syscall(SYS_DUP2, fd, 0, 0, 0, 0, 0)

    // --- 1. four lines, the \r removed with the \n
    var lines: usize = 0
    var octets: usize = 0
    var dos_ok: bool = false
    var empty_ok: bool = false
    var k: usize = 0
    while k < 4 {
        var line: io.Text = io.read_text()
        if !line.is_ok() {
            return 20
        }
        lines = lines + 1
        octets = octets + line.length()
        if k == 0 {
            // "alpha\r\n" -> "alpha", five octets, no carriage return left
            dos_ok = line.span().length() == 5 &&
            line.span().chars(4) == 97 as u8
        }
        if k == 2 {
            // the empty line: a line, and it is empty
            empty_ok = line.length() == 0 && line.is_ok()
        }
        line.free()
        k = k + 1
    }
    // 5 + 4 + 0 + 5
    if lines != 4 || octets != 14 {
        return 21
    }
    if !dos_ok || !empty_ok {
        return 22
    }

    // --- 2. read_all takes exactly the rest -- nothing was read ahead
    var rest: io.Text = io.read_all()
    if !rest.is_ok() {
        return 30
    }
    let rest_length: usize = rest.length()
    // "rest one\nrest two (no nl)"
    if rest_length != 25 {
        return 31
    }
    var wanted: io.Text = io.text_of(f"rest one\nrest two (no nl)")
    if !str.equal(rest.span(), wanted.span()) {
        return 32
    }
    wanted.free()
    rest.free()

    // --- 3. the end of input is not an empty line
    var after: io.Text = io.read_text()
    let eof_ok: bool = !after.is_ok() && after.length() == 0
    after.free()
    if !eof_ok {
        return 40
    }
    // read_all at the end delivers an empty, but successful text
    var nothing: io.Text = io.read_all()
    if !nothing.is_ok() || nothing.length() != 0 {
        return 41
    }
    nothing.free()

    syscall(SYS_DUP2, saved, 0, 0, 0, 0, 0)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    syscall(SYS_CLOSE, saved, 0, 0, 0, 0, 0)

    // --- 4. a last line WITHOUT a closing line feed is still a line
    var path2: [u8; 22] = "/tmp/firn1282_in2.txt\0"
    var one: [u8; 3] = "abc"
    if !io.write_file(rt.addr_of(&path2[0]), rt.addr_of(&one[0]), 3) {
        return 50
    }
    let saved2: i64 = syscall(SYS_DUP, 0, 0, 0, 0, 0, 0)
    let fd2: i64 = syscall(SYS_OPEN, rt.addr_of(&path2[0]) as i64, O_ONLY_READ,
        0, 0, 0, 0)
    if fd2 < 0 {
        return 51
    }
    syscall(SYS_DUP2, fd2, 0, 0, 0, 0, 0)
    var last: io.Text = io.read_text()
    let last_ok: bool = last.is_ok() && last.length() == 3
    last.free()
    var behind: io.Text = io.read_text()
    let behind_ok: bool = !behind.is_ok()
    behind.free()
    syscall(SYS_DUP2, saved2, 0, 0, 0, 0, 0)
    syscall(SYS_CLOSE, fd2, 0, 0, 0, 0, 0)
    syscall(SYS_CLOSE, saved2, 0, 0, 0, 0, 0)
    if !last_ok || !behind_ok {
        return 52
    }

    // --- 5. freeing twice is allowed and stays empty
    var twice: io.Text = io.text_of(f"xy")
    twice.free()
    twice.free()
    if twice.length() != 0 || twice.is_ok() {
        return 60
    }

    io.fmt_print(f"r69 read: lines {lines}/{octets} dos ok empty ok ")
    io.fmt_print_line(f"eof ok all {rest_length} ok")
    return 0
}
