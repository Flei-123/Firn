// expect_exit: 0
// tests/4999_x11_proc.fi -- lib/window/x11_proc.fi: new window, updater run/poll and restart as real processes (no X server needed).
import std.rt
import std.fs
import std.process
import window.x11_proc

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn marker_path(prog: str, out: *mut rt.Buf) {
    rt.buf_clear(out)
    rt.buf_push_bytes(out, prog.p as u64, prog.length())
    rt.buf_push_bytes(out, ".mark".p as u64, 5)
}

fn write_marker(start: u64, text: str) {
    var m: rt.Buf = rt.buf_new()
    marker_path(arg(start, 0), &m)
    let path: str = str { p: rt.buf_data(&m), n: rt.buf_len(&m) }
    fs.write_file(path, text.p as u64, text.length()) catch | e | 0 as usize
    rt.buf_free(&m)
}

fn child_main(start: u64) -> i32 {
    let a1: str = arg(start, 1)
    if a1 == "--pruefen" {
        return 10 as i32
    }
    if a1 == "--jetzt" {
        return 11 as i32
    }
    if a1 == "--laden" {
        return 12 as i32
    }
    if a1 == "--anwenden" {
        return 13 as i32
    }
    if a1 == "--bestaetigen" {
        write_marker(start, "confirm")
    } else if a1 == "--start" {
        write_marker(start, "start")
    } else if a1 == "--r4999-child" {
        if rt.arg_count(start) >= 3 && arg(start, 2) == "--privat=1" {
            write_marker(start, "private")
        } else {
            write_marker(start, "plain")
        }
    }
    return 0 as i32
}

fn sleep_ms(ms: i64) {
    var ts: [i64; 2] = [0; 2]
    ts[0] = ms / 1000
    ts[1] = (ms % 1000) * 1000000
    syscall(35, (&ts[0]) as i64, 0, 0, 0, 0, 0)
}

fn wait_marker(path: str, want: str) -> bool {
    var i: i32 = 0
    while i < 300 {
        var b: rt.Buf = rt.buf_new()
        let n: usize = fs.read_file(path, &b) catch | e | 0 as usize
        let same: bool = n == want.length() && rt.mem_eq(rt.buf_ptr(&b), want.p as u64, n)
        rt.buf_free(&b)
        if same {
            return true
        }
        sleep_ms(20)
        i = i + 1
    }
    return false
}

fn poll_done() -> i64 {
    var i: i32 = 0
    while i < 300 {
        let r: i64 = x11_proc.r_update_poll()
        if r != -1 {
            return r
        }
        sleep_ms(20)
        i = i + 1
    }
    return -1
}

fn copy_exe(from: str, to: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(from, &b) catch | e | 0 as usize
    if n == 0 {
        rt.buf_free(&b)
        return false
    }
    let wrote: usize = fs.write_file_mode(to, rt.buf_ptr(&b), n, 493 as u32, false) catch | e | 0 as usize
    rt.buf_free(&b)
    return wrote == n
}

fn dir_of(exe: str, out: *mut rt.Buf) {
    var i: usize = exe.length()
    while i > 0 {
        i = i - 1
        if rt.ld8(exe.p as u64, i) == 47 as u8 {
            rt.buf_push_bytes(out, exe.p as u64, i + 1)
            return
        }
    }
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) >= 2 {
        return child_main(start)
    }
    let self_path: str = arg(start, 0)
    var mp: rt.Buf = rt.buf_new()
    marker_path(self_path, &mp)
    let self_mark: str = str { p: rt.buf_data(&mp), n: rt.buf_len(&mp) }

    var up: rt.Buf = rt.buf_new()
    dir_of(self_path, &up)
    rt.buf_push_bytes(&up, "certus-update".p as u64, 13)
    let updater: str = str { p: rt.buf_data(&up), n: rt.buf_len(&up) }
    var um: rt.Buf = rt.buf_new()
    marker_path(updater, &um)
    let upd_mark: str = str { p: rt.buf_data(&um), n: rt.buf_len(&um) }

    fs.remove(self_mark) catch | e | false
    fs.remove(upd_mark) catch | e | false
    fs.remove(updater) catch | e | false

    if x11_proc.r_update_poll() != -2 { return 1 as i32 }
    if x11_proc.r_update_run(0 as u32) { return 2 as i32 }
    if !x11_proc.r_new_window("--r4999-child".p as u64, 13, false) { return 4 as i32 }
    if !wait_marker(self_mark, "plain") { return 5 as i32 }
    fs.remove(self_mark) catch | e | false
    if !x11_proc.r_new_window("--r4999-child".p as u64, 13, true) { return 6 as i32 }
    if !wait_marker(self_mark, "private") { return 7 as i32 }
    fs.remove(self_mark) catch | e | false

    if !copy_exe(self_path, updater) { return 8 as i32 }
    var mode: u32 = 0
    while mode < 4 as u32 {
        if !x11_proc.r_update_run(mode) { return (20 + mode) as i32 }
        if mode == 0 as u32 && x11_proc.r_update_run(1 as u32) { return 9 as i32 }
        if poll_done() != (10 + mode) as i64 { return (30 + mode) as i32 }
        if x11_proc.r_update_poll() != -2 { return 10 as i32 }
        mode = mode + 1
    }
    if !x11_proc.r_update_run(4 as u32) { return 11 as i32 }
    if !wait_marker(upd_mark, "confirm") { return 12 as i32 }
    fs.remove(upd_mark) catch | e | false
    if !x11_proc.r_restart_self() { return 13 as i32 }
    if !wait_marker(upd_mark, "start") { return 14 as i32 }

    fs.remove(upd_mark) catch | e | false
    fs.remove(updater) catch | e | false
    fs.remove(self_mark) catch | e | false
    rt.buf_free(&mp)
    rt.buf_free(&up)
    rt.buf_free(&um)
    return 0 as i32
}
