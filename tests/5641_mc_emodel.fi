// expect_exit: 0
import std.rt
import std.math
import mc.mc_emodel
import mc.mc_emodel_pose
import mc.mc_skin

fn rec_f(b: *mut rt.Buf, i: usize, k: usize) -> f32 {
    return *((rt.buf_ptr(b) + ((i * mc_emodel_pose.SK_FLOATS + k) * 4) as u64) as *mut f32)
}

fn near(a: f64, b: f64) -> bool {
    return math.fabs(a - b) < 0.001
}

fn main() -> i32 {
    var m: mc_emodel.EModels = mc_emodel.emodels_build()
    if mc_emodel.emodel_count(&m) != 9 { return 1 }
    let z: i32 = mc_emodel.emodel_find_name(&m, "zombie")
    let s: i32 = mc_emodel.emodel_find_name(&m, "minecraft:sheep")
    let sp: i32 = mc_emodel.emodel_find_name(&m, "spider")
    if z < 0 || s < 0 || sp < 0 { return 2 }
    if mc_emodel.emodel_find_name(&m, "ghast") != 0 - 1 { return 3 }
    if mc_emodel.mob_parts(&m, z) != 6 { return 4 }
    if mc_emodel.mob_parts(&m, s) != 12 { return 5 }
    if mc_emodel.mob_parts(&m, sp) != 11 { return 6 }
    var out: rt.Buf = rt.buf_new()
    var p: mc_emodel_pose.Pose = mc_emodel_pose.pose_new()
    p.scale = 1.0
    if mc_emodel_pose.emodel_emit(&m, z, &p, 0.0, 0.0, 0.0, 0.0, &out) != 6 { return 7 }
    if !near(rec_f(&out, 0, 1) as f64, 1.75) { return 8 }
    if !near(rec_f(&out, 0, 3) as f64, 0.5) { return 9 }
    if !near(rec_f(&out, 1, 1) as f64, 1.125) { return 10 }
    if !near(rec_f(&out, 4, 1) as f64, 0.375) { return 11 }
    if !near(rec_f(&out, 4, 0) as f64, 0.0 - 0.1188) && !near(rec_f(&out, 4, 0) as f64, 0.0 - 0.11875) { return 12 }
    if !near(rec_f(&out, 3, 21) as f64, 1.0) { return 13 }
    rt.buf_clear(&out)
    p.swing = 1.0
    p.amount = 1.0
    mc_emodel_pose.emodel_emit(&m, z, &p, 0.0, 0.0, 0.0, 0.0, &out)
    if near(rec_f(&out, 4, 1) as f64, 0.375) { return 14 }
    rt.buf_clear(&out)
    p.sheared = true
    if mc_emodel_pose.emodel_emit(&m, s, &p, 1.0, 2.0, 3.0, 90.0, &out) != 6 { return 15 }
    p.sheared = false
    rt.buf_clear(&out)
    p.death = 1.0
    mc_emodel_pose.emodel_emit(&m, z, &p, 0.0, 0.0, 0.0, 0.0, &out)
    if rec_f(&out, 0, 1) as f64 > 0.3 { return 16 }
    if mc_skin.skin_u(4, 0.0, 0.0, 0.0, 8.0, 8.0) < 8.0 { return 17 }
    if mc_skin.skin_u(4, 1.0, 0.0, 0.0, 8.0, 8.0) > 16.0 { return 18 }
    if mc_skin.skin_v(4, 1.0, 0.0, 0.0, 8.0, 8.0) > 16.0 { return 19 }
    rt.buf_free(&out)
    mc_emodel.emodels_free(&m)
    return 0
}
