// expect_exit: 244
// State machine with 32 states (SPEC 6.3, P4).
// --emit=asm shows a jump table for the match (.rodata + 'jmp qword ptr [..]'),
// not 32 comparisons. Checked by codegen_switch.rs::jump_table_at_30_states.
enum State { S0, S1, S2, S3, S4, S5, S6, S7, S8, S9, S10, S11, S12, S13, S14, S15, S16, S17, S18, S19, S20, S21, S22, S23, S24, S25, S26, S27, S28, S29, S30, S31 }

fn main() -> i32 {
    var z: State = State::S0
    var sum: i32 = 0
    var i: i32 = 0
    while i < 200 as i32 {
        match z {
            State::S0 => { sum = sum + 1 as i32; z = State::S1 }
            State::S1 => { sum = sum + 4 as i32; z = State::S6 }
            State::S2 => { sum = sum + 7 as i32; z = State::S11 }
            State::S3 => { sum = sum + 10 as i32; z = State::S16 }
            State::S4 => { sum = sum + 13 as i32; z = State::S21 }
            State::S5 => { sum = sum + 16 as i32; z = State::S26 }
            State::S6 => { sum = sum + 2 as i32; z = State::S31 }
            State::S7 => { sum = sum + 5 as i32; z = State::S4 }
            State::S8 => { sum = sum + 8 as i32; z = State::S9 }
            State::S9 => { sum = sum + 11 as i32; z = State::S14 }
            State::S10 => { sum = sum + 14 as i32; z = State::S19 }
            State::S11 => { sum = sum + 0 as i32; z = State::S24 }
            State::S12 => { sum = sum + 3 as i32; z = State::S29 }
            State::S13 => { sum = sum + 6 as i32; z = State::S2 }
            State::S14 => { sum = sum + 9 as i32; z = State::S7 }
            State::S15 => { sum = sum + 12 as i32; z = State::S12 }
            State::S16 => { sum = sum + 15 as i32; z = State::S17 }
            State::S17 => { sum = sum + 1 as i32; z = State::S22 }
            State::S18 => { sum = sum + 4 as i32; z = State::S27 }
            State::S19 => { sum = sum + 7 as i32; z = State::S0 }
            State::S20 => { sum = sum + 10 as i32; z = State::S5 }
            State::S21 => { sum = sum + 13 as i32; z = State::S10 }
            State::S22 => { sum = sum + 16 as i32; z = State::S15 }
            State::S23 => { sum = sum + 2 as i32; z = State::S20 }
            State::S24 => { sum = sum + 5 as i32; z = State::S25 }
            State::S25 => { sum = sum + 8 as i32; z = State::S30 }
            State::S26 => { sum = sum + 11 as i32; z = State::S3 }
            State::S27 => { sum = sum + 14 as i32; z = State::S8 }
            State::S28 => { sum = sum + 0 as i32; z = State::S13 }
            State::S29 => { sum = sum + 3 as i32; z = State::S18 }
            State::S30 => { sum = sum + 6 as i32; z = State::S23 }
            State::S31 => { sum = sum + 9 as i32; z = State::S28 }
        }
        i = i + 1 as i32
    }
    return sum % 251 as i32
}
