// expect_exit: 0
// mc_entity_draw: box models, frustum culling, CPU back end draws the boxes (flat colour, depth).
import std.rt
import mc.mc_entity
import mc.mc_entity_draw
import mc.mc_camera
import mc.mc_raster
import mc.mc_backend
import mc.mc_texture

fn main() -> i32 {
    var l: mc_entity_draw.EntList = mc_entity_draw.entlist_new()
    // 1 humanoid = 6 boxes, 1 object = 1 box, lod humanoid = 1 box
    mc_entity_draw.entlist_add_model(&l, 0.0, 0.0, 5.0, 0.0, 1 as u64, true, false)
    if mc_entity_draw.entlist_boxes(&l) != 6 { return 1 }
    mc_entity_draw.entlist_add_model(&l, 0.0, 0.0, 5.0, 0.0, 2 as u64, false, false)
    if mc_entity_draw.entlist_boxes(&l) != 7 { return 2 }
    mc_entity_draw.entlist_add_model(&l, 0.0, 0.0, 5.0, 90.0, 3 as u64, true, true)
    if mc_entity_draw.entlist_boxes(&l) != 8 { return 3 }
    // draw through the CPU back end: pixels change, a second draw with nothing in front is deterministic
    var r: mc_raster.Raster = mc_raster.raster_new(64, 48)
    var cam: mc_camera.Camera = mc_camera.camera_new(64, 48)
    mc_camera.camera_set_pos(&cam, 0.0, 1.0, 0.0)
    mc_camera.camera_update(&cam)
    var at: mc_texture.Atlas = mc_texture.atlas_default()
    var b: mc_backend.Backend = mc_backend.backend_cpu(&r)
    b.upload_atlas(b.obj, (&at) as u64)
    b.begin(b.obj, (&cam) as u64, 0xFF000000 as u32)
    let n: u64 = mc_entity_draw.entlist_draw(&l, &b)
    if n != 8 as u64 { return 4 }
    if r.st.pixels == 0 as u64 { return 5 }
    mc_entity_draw.entlist_free(&l)
    mc_raster.raster_free(&r)
    return 0
}
