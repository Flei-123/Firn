// expect_out: 3478596182 3723558397926772799 429514420182324 1432437304
// r-winA: integer two-address ops, casts and chains are merged in the register allocator; results must stay bit exact.
import std.io

static mut TBL: [u32; 256] = [0; 256]

fn make_table() {
    var i: u32 = 0
    while i < 256 {
        var c: u32 = i
        var k: u32 = 0
        while k < 8 {
            if (c & 1) != 0 {
                c = 0xEDB88320 ^ (c >> 1)
            } else {
                c = c >> 1
            }
            k = k + 1
        }
        TBL[i as usize] = c
        i = i + 1
    }
}

fn crc_loop(n: usize, seed: u64) -> u32 {
    var s: u64 = seed
    var c: u32 = 0xFFFFFFFF
    var i: usize = 0
    while i < n {
        s = s *% 6364136223846793005 +% 1442695040888963407
        let b: u8 = (s >> 56) as u8
        let idx: u32 = (c ^ (b as u32)) & 255
        c = TBL[idx as usize] ^ (c >> 8)
        i = i + 1
    }
    return c ^ 0xFFFFFFFF
}

fn mix64(n: u64) -> u64 {
    var a: u64 = 1
    var b: u64 = 2
    var i: u64 = 0
    while i < n {
        let t: u64 = (a ^ b) +% (b << 3)
        let u: u64 = (t & 0xFFFF) | (a >> 7)
        let v: u64 = (u *% 31) -% (b & 255)
        b = a +% v
        a = t ^ (u +% i)
        i = i + 1
    }
    return a ^ b
}

fn mix32(n: u32) -> u64 {
    var x: u32 = 12345
    var acc: u64 = 0
    var i: u32 = 0
    while i < n {
        x = x *% 1664525 +% 1013904223
        let lo: u32 = (x >> 16) & 255
        let k: usize = lo as usize
        acc = acc +% (TBL[k] as u64) +% (x as u64)
        i = i + 1
    }
    return acc
}

fn live_operands(a: u32, b: u32, n: u32) -> u32 {
    // both operands stay alive after the xor/or/and: nothing may be clobbered
    var x: u32 = a
    var y: u32 = b
    var i: u32 = 0
    var r: u32 = 0
    while i < n {
        let p: u32 = x ^ y
        let q: u32 = x | y
        let w: u32 = p & q
        r = r +% (p *% 3) +% (q >> 2) +% w
        x = x +% 7
        y = y *% 5 +% i
        i = i + 1
    }
    return r
}

fn main() -> i32 {
    make_table()
    let c: u32 = crc_loop(100000, 1)
    let m: u64 = mix64(100000)
    let k: u64 = mix32(100000)
    let l: u32 = live_operands(3, 9, 100000)
    io.fmt_print_line(f"{c} {m} {k} {l}")
    return 0
}
