// expect_exit: 0
// tests/3660_text_merge3.fi -- text.merge3: clean merges, conflicts, styles, favors, line ends, invariants.
// The byte for byte comparison with `git merge-file` over thousands of random cases is tools/textlibs_cross/run.sh.
import text.merge3
import std.rt
import std.vec

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn sp(s: str) -> u64 {
    return s.p as u64
}

fn buf_is(b: *mut rt.Buf, s: str) -> bool {
    return rt.buf_len(b) == s.n && rt.mem_eq(rt.buf_ptr(b), s.p as u64, s.n)
}

fn run(o: *mut merge3.Opts, base: str, ours: str, theirs: str, out: *mut rt.Buf) -> i64 {
    var r: merge3.Result = merge3.merge(o, sp(base), base.n, sp(ours), ours.n, sp(theirs), theirs.n)
    rt.buf_clear(out)
    rt.buf_push_bytes(out, rt.buf_ptr(&r.out), rt.buf_len(&r.out))
    let c: i64 = r.conflicts
    merge3.result_free(&r)
    return c
}

fn main() -> i32 {
    var o: merge3.Opts = merge3.opts_default()
    o.name_ours = "ours"
    o.name_base = "base"
    o.name_theirs = "theirs"
    var out: rt.Buf = rt.buf_new()
    // disjoint changes merge cleanly
    check("clean count", run(&o, "a\nb\nc\nd\ne\n", "A\nb\nc\nd\ne\n", "a\nb\nc\nd\nE\n", &out) == 0)
    check("clean text", buf_is(&out, "A\nb\nc\nd\nE\n"))
    // one side unchanged -> the other side
    check("theirs unchanged", run(&o, "x\ny\n", "x\nQ\n", "x\ny\n", &out) == 0 && buf_is(&out, "x\nQ\n"))
    check("ours unchanged", run(&o, "x\ny\n", "x\ny\n", "Q\ny\n", &out) == 0 && buf_is(&out, "Q\ny\n"))
    // the same change on both sides is no conflict
    check("same change", run(&o, "a\nb\nc\n", "a\nX\nc\n", "a\nX\nc\n", &out) == 0 && buf_is(&out, "a\nX\nc\n"))
    // conflict, merge style
    check("conflict count", run(&o, "x\n", "y\n", "z\n", &out) == 1)
    check("conflict text", buf_is(&out, "<<<<<<< ours\ny\n=======\nz\n>>>>>>> theirs\n"))
    // diff3 shows the base
    o.style = merge3.STYLE_DIFF3
    check("diff3", run(&o, "x\n", "y\n", "z\n", &out) == 1 && buf_is(&out, "<<<<<<< ours\ny\n||||||| base\nx\n=======\nz\n>>>>>>> theirs\n"))
    // zdiff3 moves common head and tail out of the conflict
    o.style = merge3.STYLE_ZDIFF3
    check("zdiff3", run(&o, "p\nx\nq\n", "p\nA\nB\nq\n", "p\nA\nC\nq\n", &out) == 1)
    check("zdiff3 text", buf_is(&out, "p\nA\n<<<<<<< ours\nB\n||||||| base\nx\n=======\nC\n>>>>>>> theirs\nq\n"))
    o.style = merge3.STYLE_MERGE
    // zealous refinement: only the differing line conflicts
    check("zealous", run(&o, "a\nb\nc\n", "a\nX\nc\n", "a\nY\nc\n", &out) == 1)
    check("zealous text", buf_is(&out, "a\n<<<<<<< ours\nX\n=======\nY\n>>>>>>> theirs\nc\n"))
    // favors
    o.favor = merge3.FAVOR_OURS
    check("favor ours", run(&o, "x\n", "y\n", "z\n", &out) == 0 && buf_is(&out, "y\n"))
    o.favor = merge3.FAVOR_THEIRS
    check("favor theirs", run(&o, "x\n", "y\n", "z\n", &out) == 0 && buf_is(&out, "z\n"))
    o.favor = merge3.FAVOR_UNION
    check("favor union", run(&o, "x\n", "y\n", "z\n", &out) == 0 && buf_is(&out, "y\nz\n"))
    o.favor = merge3.FAVOR_NONE
    // marker size and labels
    o.marker_size = 9
    o.name_ours = ""
    check("marker size", run(&o, "x\n", "y\n", "z\n", &out) == 1 && buf_is(&out, "<<<<<<<<<\ny\n=========\nz\n>>>>>>>>> theirs\n"))
    o.marker_size = 0
    o.name_ours = "ours"
    // CR LF files keep CR LF in the markers
    check("crlf", run(&o, "a\r\nb\r\n", "x\r\nb\r\n", "y\r\nb\r\n", &out) == 1)
    check("crlf text", buf_is(&out, "<<<<<<< ours\r\nx\r\n=======\r\ny\r\n>>>>>>> theirs\r\nb\r\n"))
    // a conflicting last line without LF gets one
    check("no final lf", run(&o, "a\nb", "a\nX", "a\nY", &out) == 1)
    check("no final lf text", buf_is(&out, "a\n<<<<<<< ours\nX\n=======\nY\n>>>>>>> theirs\n"))
    // empty inputs
    check("all empty", run(&o, "", "", "", &out) == 0 && rt.buf_len(&out) == 0)
    check("base empty", run(&o, "", "a\n", "b\n", &out) == 1)
    check("both add same", run(&o, "", "a\n", "a\n", &out) == 0 && buf_is(&out, "a\n"))
    // diff script: change blocks (a start, b start, a count, b count)
    var scr: Vec[i64] = vec_new[i64]()
    merge3.diff_script(sp("a\nb\nc\n"), 6, sp("a\nX\nY\nc\n"), 8, &scr)
    check("script", vec_len[i64](&scr) == 4 && vec_at[i64](&scr, 0) == 1 && vec_at[i64](&scr, 1) == 1 && vec_at[i64](&scr, 2) == 1 && vec_at[i64](&scr, 3) == 2)
    vec_free[i64](&scr)
    // random merges: identity and symmetry invariants
    var seed: u64 = 12345
    var r: usize = 0
    while r < 300 {
        var base: rt.Buf = rt.buf_new()
        var a: rt.Buf = rt.buf_new()
        var b: rt.Buf = rt.buf_new()
        var k: usize = 0
        while k < 12 {
            seed = (seed *% 6364136223846793005 as u64) +% 1442695040888963407 as u64
            let v: u64 = (seed >> 33) % 9
            rt.buf_push(&base, (97 + v) as u8)
            rt.buf_push(&base, 10 as u8)
            if (seed >> 20) % 5 == 0 {
                rt.buf_push(&a, 90 as u8)
                rt.buf_push(&a, 10 as u8)
            } else {
                rt.buf_push(&a, (97 + v) as u8)
                rt.buf_push(&a, 10 as u8)
            }
            if (seed >> 25) % 6 == 0 {
                rt.buf_push(&b, 89 as u8)
                rt.buf_push(&b, 10 as u8)
            } else {
                rt.buf_push(&b, (97 + v) as u8)
                rt.buf_push(&b, 10 as u8)
            }
            k = k + 1
        }
        var m1: merge3.Result = merge3.merge(&o, rt.buf_ptr(&base), rt.buf_len(&base), rt.buf_ptr(&a), rt.buf_len(&a), rt.buf_ptr(&base), rt.buf_len(&base))
        check("random theirs==base", m1.conflicts == 0 && rt.buf_len(&m1.out) == rt.buf_len(&a) && rt.mem_eq(rt.buf_ptr(&m1.out), rt.buf_ptr(&a), rt.buf_len(&a)))
        merge3.result_free(&m1)
        var m2: merge3.Result = merge3.merge(&o, rt.buf_ptr(&base), rt.buf_len(&base), rt.buf_ptr(&a), rt.buf_len(&a), rt.buf_ptr(&b), rt.buf_len(&b))
        var m3: merge3.Result = merge3.merge(&o, rt.buf_ptr(&base), rt.buf_len(&base), rt.buf_ptr(&b), rt.buf_len(&b), rt.buf_ptr(&a), rt.buf_len(&a))
        check("random symmetric conflict count", m2.conflicts == m3.conflicts)
        merge3.result_free(&m2)
        merge3.result_free(&m3)
        rt.buf_free(&base)
        rt.buf_free(&a)
        rt.buf_free(&b)
        r = r + 1
    }
    return failures
}
