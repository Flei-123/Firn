// expect_exit: 0
// tests/3820_std_dict.fi -- std.dict: set/get/inc/remove, insertion order,
// re-adding a removed key, compaction after many removals, sorted keys, top-n,
// the word count of the Python Counter. The random comparison with a Python
// dict is tools/vspy_cross/run.sh.
import std.io
import std.rt
import std.dict
import std.str
import std.vec
import std.testkit

fn order(d: *mut Dict[i32]) -> str {
    var b: rt.Buf = rt.buf_new()
    var i: usize = dict_first[i32](d)
    while i != dict_end[i32](d) {
        io.fmt_content(f"{dict_key[i32](d, i)}={dict_val[i32](d, i)};", &b)
        i = dict_next[i32](d, i + 1)
    }
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var d: Dict[i32] = dict_new[i32]()
    defer dict_free[i32](&d)
    testkit.check(dict_len[i32](&d) == 0 && dict_first[i32](&d) == dict_end[i32](&d), "empty")
    dict_set[i32](&d, "b", 2)
    dict_set[i32](&d, "a", 1)
    dict_set[i32](&d, "b", 20)
    testkit.check(order(&d) == "b=20;a=1;", "set keeps the first position")
    testkit.check(dict_inc[i32](&d, "c", 5) == 5 && dict_inc[i32](&d, "c", -2) == 3, "inc starts at 0")
    testkit.check(dict_get[i32](&d, "zz") == 0 && !dict_has[i32](&d, "zz") && dict_has[i32](&d, "c"), "get/has")
    testkit.check(dict_get_or[i32](&d, "zz", 9) == 9 && dict_get_or[i32](&d, "a", 9) == 1, "get_or")
    var out: i32 = 0
    testkit.check(dict_get_if[i32](&d, "b", &out) && out == 20 && !dict_get_if[i32](&d, "nope", &out), "get_if")
    testkit.check(dict_remove[i32](&d, "b") && !dict_remove[i32](&d, "b") && dict_len[i32](&d) == 2, "remove")
    dict_set[i32](&d, "b", 7)
    testkit.check(order(&d) == "a=1;c=3;b=7;", "re-added key goes to the end")
    dict_set[i32](&d, "", 4)
    testkit.check(dict_get[i32](&d, "") == 4 && dict_has[i32](&d, ""), "empty key")
    var ks: Vec[str] = vec_new[str]()
    dict_keys_sorted[i32](&d, &ks)
    testkit.check(vec_len[str](&ks) == 4 && *vec_elem_ptr[str](&ks, 0) == "" && *vec_elem_ptr[str](&ks, 3) == "c", "keys_sorted")
    dict_clear[i32](&d)
    testkit.check(dict_len[i32](&d) == 0 && !dict_has[i32](&d, "a"), "clear")
    // many keys, then remove most of them -> compaction keeps the order
    for i in 0..5000 {
        dict_set[i32](&d, io.fmt_string(f"key{i}"), i)
    }
    for i in 0..5000 {
        if i % 7 != 0 {
            dict_remove[i32](&d, io.fmt_string(f"key{i}"))
        }
    }
    var ok: bool = dict_len[i32](&d) == 715
    var prev: i32 = -1
    var j: usize = dict_first[i32](&d)
    var seen: usize = 0
    while j != dict_end[i32](&d) {
        let v: i32 = dict_val[i32](&d, j)
        if v % 7 != 0 || v <= prev { ok = false }
        prev = v
        seen = seen + 1
        j = dict_next[i32](&d, j + 1)
    }
    testkit.check(ok && seen == 715, "5000 keys, 4285 removed: order and values intact")
    testkit.check(dict_get[i32](&d, "key4998") == 4998 && !dict_has[i32](&d, "key4999"), "lookups after compaction")
    // word count
    var w: Dict[i32] = dict_new[i32]()
    defer dict_free[i32](&w)
    var it = str.divisor_whitespace("to be or not to be that is the question to be")
    var word: str = ""
    while str.divisor_next(&it, &word) { dict_inc[i32](&w, word, 1) }
    var top: Vec[DictItem[i32]] = vec_new[DictItem[i32]]()
    dict_top[i32](&w, 3, &top)
    testkit.check(vec_len[DictItem[i32]](&top) == 3, "top 3 size")
    let t0 = *vec_elem_ptr[DictItem[i32]](&top, 0)
    let t1 = *vec_elem_ptr[DictItem[i32]](&top, 1)
    let t2 = *vec_elem_ptr[DictItem[i32]](&top, 2)
    testkit.check(t0.key == "be" && t0.val == 3 && t1.key == "to" && t1.val == 3 && t2.key == "is" && t2.val == 1, "top: value desc, key asc")
    var all: Vec[DictItem[i32]] = vec_new[DictItem[i32]]()
    dict_top[i32](&w, 0, &all)
    testkit.check(vec_len[DictItem[i32]](&all) == 8, "top 0 = all items")
    // u64 values and bool-ish usage
    var c: Dict[u64] = dict_new[u64]()
    defer dict_free[u64](&c)
    dict_inc[u64](&c, "x", 18446744073709551000)
    testkit.check(dict_get[u64](&c, "x") == 18446744073709551000, "u64 value")
    return testkit.finish()
}
