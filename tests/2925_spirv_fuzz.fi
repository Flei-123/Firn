// expect_exit: 0
// tests/2925_spirv_fuzz.fi -- gpu.spirv robustness: 6 committed modules, 1500 mutations each (random words replaced, bits
// flipped, small values). spv_new / spv_find_* / spv_run must end with true or an error code -- never crash, hang or trip
// an arithmetic check (dev-fast checks overflow). Also counts how many mutants still load, to show the mutator bites.
import std.rt
import std.math
import gpu.spirv

const S0: str = __include_str("../lib/gpu/spv/tri.vert.spv")
const S1: str = __include_str("../lib/gpu/spv/tri.frag.spv")
const S2: str = __include_str("../lib/gpu/spv/test/arith.frag.spv")
const S3: str = __include_str("../lib/gpu/spv/test/flow.frag.spv")
const S4: str = __include_str("../lib/gpu/spv/test/ext.frag.spv")

static mut seed: u64 = 88172645463325252

fn rnd() -> u64 {
    seed = seed ^ (seed << 13 as u64)
    seed = seed ^ (seed >> 7 as u64)
    seed = seed ^ (seed << 17 as u64)
    return seed
}

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn fuzz(src: u64, n: usize, rounds: usize, loaded: *mut i32, ran: *mut i32) {
    let cp: u64 = rt.heap_alloc(n)
    let nw: usize = n / 4
    var r: usize = 0
    while r < rounds {
        rt.mem_copy(cp, src, n)
        let edits: usize = 1 + (rnd() % 3) as usize
        var e: usize = 0
        while e < edits {
            let at: usize = 5 + (rnd() % ((nw - 5) as u64)) as usize
            let kind: u64 = rnd() % 4
            var v: u32 = rt.ld32(cp, at)
            if kind == 0 {
                v = (rnd() & 0xffffffff) as u32
            }
            if kind == 1 {
                v = v ^ (1 << ((rnd() % 32) as u32))
            }
            if kind == 2 {
                v = (rnd() % 64) as u32
            }
            if kind == 3 {
                v = v +% (rnd() % 5) as u32
            }
            rt.st32(cp, at, v)
            e = e + 1
        }
        var m: spirv.Spv = spirv.spv_zero()
        if spirv.spv_new(cp, n, &m) {
            *loaded = *loaded + 1
            var model: u32 = 0
            while model < 6 {
                let ent: u32 = spirv.spv_find_entry(&m, model)
                if ent != 0 {
                    spirv.spv_run(&m, ent, 20000)
                    *ran = *ran + 1
                }
                model = model + 1
            }
            spirv.spv_find_location(&m, 1, 0)
            spirv.spv_find_builtin(&m, 3, 0)
            spirv.spv_reset(&m)
            spirv.spv_free(&m)
        }
        r = r + 1
    }
    rt.heap_free(cp, n)
}

fn main() -> i32 {
    var loaded: i32 = 0
    var ran: i32 = 0
    fuzz(S0.p as u64, S0.n, 1500, &loaded, &ran)
    fuzz(S1.p as u64, S1.n, 1500, &loaded, &ran)
    fuzz(S2.p as u64, S2.n, 1500, &loaded, &ran)
    fuzz(S3.p as u64, S3.n, 1500, &loaded, &ran)
    fuzz(S4.p as u64, S4.n, 1500, &loaded, &ran)
    // most mutants of a data word still load (constants, decorations); some break the structure
    check(loaded > 1500 && loaded < 7500, 1)
    check(ran > 500, 2)
    return 0
}
