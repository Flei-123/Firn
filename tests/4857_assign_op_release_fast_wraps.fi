// expect_exit: 3
// only_mode: opt
// r935: release-fast keeps wrapping for x += y, x++ and x -= y (SPEC 13, L9).
fn main() -> i32 {
    var x: i32 = 2147483647
    x += 1
    var y: u8 = 0
    y--
    var z: u8 = 200
    z *= 2
    if x == -2147483648 && y == 255 && z == 144 { return 3 }
    return 1
}
