// expect_exit: 0
// tests/2811_input_textsys_cb.fi -- the XIM pre-edit callbacks of lib/input/textsys.fi, called THROUGH THEIR C ADDRESSES
// (dynlib.callx = the System V call Xlib makes) with hand-made XIMPreeditDraw / XIMText / caret call data (LP64 layouts):
// multibyte (UTF-8) and wide text, feedback words, deletion (text == NULL), caret directions, start returns -1.
import std.rt
import std.dynlib
import input.textcore
import input.textsys

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn call3(code: u64, cd: u64, data: u64) -> u64 {
    var a: [u64; 3] = [0; 3]
    a[0] = 0
    a[1] = cd
    a[2] = data
    return dynlib.callx(code, "iii", (&a[0]) as u64, false)
}

// build XIMPreeditDrawCallbackStruct + XIMText in `d` (8 words) / `x` (4 words)
fn draw(code: u64, t: *mut textcore.Text, caret: u32, first: u32, len: u32, text: u64) {
    var d: [u64; 3] = [0; 3]
    rt.st32((&d[0]) as u64, 0, caret)
    rt.st32((&d[0]) as u64, 1, first)
    rt.st32((&d[0]) as u64, 2, len)
    d[2] = text
    call3(code, t as u64, (&d[0]) as u64)
}

fn main() -> i32 {
    var t: textcore.Text = textcore.text_new()
    let c_start: u64 = textsys.sys_callback_code(0 as u32)
    let c_done: u64 = textsys.sys_callback_code(1 as u32)
    let c_draw: u64 = textsys.sys_callback_code(2 as u32)
    let c_caret: u64 = textsys.sys_callback_code(3 as u32)
    check(c_start != 0 && c_draw != 0 && c_start != c_draw, 1)
    check((call3(c_start, 0, 0) & 4294967295) == 4294967295, 2) // int -1
    // multibyte text "häll" (UTF-8: 68 C3 A4 6C 6C), length 4 characters, feedback: 2,2,4,2
    var mb: [u8; 8] = [0 as u8; 8]
    mb[0] = 0x68 as u8
    mb[1] = 0xC3 as u8
    mb[2] = 0xA4 as u8
    mb[3] = 0x6C as u8
    mb[4] = 0x6C as u8
    var fb: [u64; 4] = [2, 2, 4, 2]
    var xt: [u64; 4] = [0; 4]
    xt[0] = 4 // length (unsigned short @0)
    xt[1] = (&fb[0]) as u64
    xt[2] = 0 // encoding_is_wchar = False
    xt[3] = (&mb[0]) as u64
    draw(c_draw, &t, 4 as u32, 0 as u32, 0 as u32, (&xt[0]) as u64)
    check(textcore.text_preedit_len(&t) == 4 && textcore.text_preedit_cp(&t, 1) == 228 as u32 && textcore.text_preedit_caret_pos(&t) == 4, 3)
    check(textcore.text_preedit_fb(&t, 2) == textcore.FB_HIGHLIGHT && textcore.text_preedit_seg_count(&t) == 3, 4)
    // wide text (wchar_t = 4 octets): replace characters [1,3) by two wide characters, no feedback array
    var wc: [u32; 4] = [0 as u32; 4]
    wc[0] = 20013 as u32
    wc[1] = 25991 as u32
    var xw: [u64; 4] = [0; 4]
    xw[0] = 2
    xw[1] = 0
    xw[2] = 1
    xw[3] = (&wc[0]) as u64
    draw(c_draw, &t, 3 as u32, 1 as u32, 2 as u32, (&xw[0]) as u64)
    check(textcore.text_preedit_len(&t) == 4 && textcore.text_preedit_cp(&t, 1) == 20013 as u32 && textcore.text_preedit_cp(&t, 2) == 25991 as u32 && textcore.text_preedit_cp(&t, 3) == 108 as u32, 5)
    check(textcore.text_preedit_fb(&t, 1) == textcore.FB_UNDERLINE, 6)
    // deletion (text == NULL)
    draw(c_draw, &t, 1 as u32, 1 as u32, 3 as u32, 0 as u64)
    check(textcore.text_preedit_len(&t) == 1 && textcore.text_preedit_caret_pos(&t) == 1, 7)
    // caret callback: absolute 0, forward, backward
    var cs: [u32; 3] = [0 as u32; 3]
    cs[0] = 0 as u32
    cs[1] = 10 as u32
    call3(c_caret, (&t) as u64, (&cs[0]) as u64)
    check(textcore.text_preedit_caret_pos(&t) == 0, 8)
    cs[1] = 0 as u32
    call3(c_caret, (&t) as u64, (&cs[0]) as u64)
    check(textcore.text_preedit_caret_pos(&t) == 1, 9)
    cs[1] = 1 as u32
    call3(c_caret, (&t) as u64, (&cs[0]) as u64)
    check(textcore.text_preedit_caret_pos(&t) == 0, 10)
    // negative values from a hostile server are clamped, not a panic
    var d2: [u64; 3] = [0; 3]
    rt.st32((&d2[0]) as u64, 0, 4294967295 as u32)
    rt.st32((&d2[0]) as u64, 1, 4294967295 as u32)
    rt.st32((&d2[0]) as u64, 2, 4294967295 as u32)
    call3(c_draw, (&t) as u64, (&d2[0]) as u64)
    // done: pre-edit cancelled
    call3(c_done, (&t) as u64, 0)
    check(textcore.text_preedit_len(&t) == 0, 11)
    // style choice
    var sup: [u64; 3] = [0; 3]
    sup[0] = textsys.XIM_PREEDIT_NOTHING | textsys.XIM_STATUS_NOTHING
    sup[1] = textsys.XIM_PREEDIT_NONE | textsys.XIM_STATUS_NONE
    check(textsys.pick_style((&sup[0]) as u64, 2) == (textsys.XIM_PREEDIT_NOTHING | textsys.XIM_STATUS_NOTHING), 12)
    sup[2] = textsys.XIM_PREEDIT_CALLBACKS | textsys.XIM_STATUS_NOTHING
    check(textsys.pick_style((&sup[0]) as u64, 3) == (textsys.XIM_PREEDIT_CALLBACKS | textsys.XIM_STATUS_NOTHING), 13)
    sup[0] = textsys.XIM_PREEDIT_POSITION | textsys.XIM_STATUS_NOTHING
    check(textsys.pick_style((&sup[0]) as u64, 1) == 0 as u64, 14)
    return 0
}
