// expect_exit: 0
// r176: sema probed the left operand of a binary expression twice, so a
// left-leaning chain of n `+` took 2^n steps (26 literals: 14 s, 32 hung).
// With 40 literals this test would not finish before the fix.
fn build(ok: bool) -> str {
    var x = "a"
    if !ok {
        x = "b"
    }
    return "ab0" + "ab1" + "ab2" + "ab3" + "ab4" + "ab5" + "ab6" + "ab7" + "ab8" + "ab9" + "ab10" + "ab11" + "ab12" + "ab13" + "ab14" + "ab15" + "ab16" + "ab17" + "ab18" + "ab19" + "ab20" + "ab21" + "ab22" + "ab23" + "ab24" + "ab25" + "ab26" + "ab27" + "ab28" + "ab29" + "ab30" + "ab31" + "ab32" + "ab33" + "ab34" + "ab35" + "ab36" + "ab37" + "ab38" + "ab39" + x + "c"
}

fn main() -> i32 {
    let s = build(false)
    if s == "ab0ab1ab2ab3ab4ab5ab6ab7ab8ab9ab10ab11ab12ab13ab14ab15ab16ab17ab18ab19ab20ab21ab22ab23ab24ab25ab26ab27ab28ab29ab30ab31ab32ab33ab34ab35ab36ab37ab38ab39bc" {
        return 0
    }
    return 1
}
