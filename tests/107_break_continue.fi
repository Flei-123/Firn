// expect_exit: 25
// break and continue in while and for.
fn main() -> i32 {
    var s: i32 = 0
    var i: i32 = 0
    while true {
        i = i + 1 as i32
        if i > 10 as i32 { break }
        if i % 2 as i32 == 0 as i32 { continue }
        s = s + i
    }
    // s = 1+3+5+7+9 = 25
    for k in 0 as i32..100 as i32 {
        if k == 3 as i32 { break }
    }
    return s
}
