// expect_exit: 100
// Pointer <-> integer: walk over elements through address arithmetic.
fn sum(base: *i32, n: usize) -> i32 {
    var addr: u64 = base as u64
    var i: usize = 0
    var s: i32 = 0
    while i < n {
        let p: *i32 = addr as *i32
        s = s + *p
        addr = addr + 4
        i = i + 1
    }
    return s
}
fn main() -> i32 {
    var a: [i32; 4] = [10, 20, 30, 40]
    return sum(&a[0], 4)
}
