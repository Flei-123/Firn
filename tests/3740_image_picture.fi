// expect_exit: 0
// image.picture: open (format sniff), resized/fit/cropped/gray, save by extension, refusals, fuzz.
// The comparison with Pillow is tools/picture_cross/check.sh.
import std.rt
import std.fs
import std.testkit
import image.picture
import paint.png
import webp.webp
import pack.packicons

// 37 x 23 gradient with a varying alpha (straight RGBA)
fn make_gradient(alpha: bool) -> picture.Picture {
    var b: rt.Buf = rt.buf_new()
    var y: usize = 0
    while y < 23 {
        var x: usize = 0
        while x < 37 {
            rt.buf_push(&b, (x * 7) as u8)
            rt.buf_push(&b, (y * 11) as u8)
            rt.buf_push(&b, ((x + y) * 3) as u8)
            if alpha {
                rt.buf_push(&b, (255 - (x * 5 + y)) as u8)
            } else {
                rt.buf_push(&b, 255 as u8)
            }
            x = x + 1
        }
        y = y + 1
    }
    let im: picture.Picture = picture.from_rgba(rt.buf_ptr(&b), 37, 23)
    rt.buf_free(&b)
    return im
}

#[test]
fn open_every_format() {
    var a: picture.Picture = picture.open("tests/data/png/rgb8_key.png")
    var b: picture.Picture = picture.open("tests/data/jpeg/base420.jpg")
    var c: picture.Picture = picture.open("tests/data/webp/ll_rgb.webp")
    var d: picture.Picture = picture.open("tests/data/gif/pal16.gif")
    testkit.assert_true(picture.ok(&a) && picture.format(&a) == picture.FMT_PNG, "png")
    testkit.assert_true(picture.ok(&b) && picture.format(&b) == picture.FMT_JPEG, "jpeg")
    testkit.assert_true(picture.ok(&c) && picture.format(&c) == picture.FMT_WEBP, "webp")
    testkit.assert_true(picture.ok(&d) && picture.format(&d) == picture.FMT_GIF, "gif")
    testkit.assert_eq_i64(picture.width(&c) as i64, 61)
    testkit.assert_eq_i64(picture.height(&c) as i64, 47)
    picture.free(&a)
    picture.free(&b)
    picture.free(&c)
    picture.free(&d)
}

#[test]
fn open_matches_the_direct_decoder() {
    var raw: rt.Buf = rt.buf_new()
    var m: picture.Picture = picture.open("tests/data/webp/ll_rgba.webp")
    var w: webp.WebpImage = webp.webp_image_new()
    var got: bool = true
    let n: usize = fs.read_file("tests/data/webp/ll_rgba.webp", &raw) catch 0
    let _ok: bool = webp.webp_decode(rt.buf_ptr(&raw), n, &w) catch false
    got = _ok
    testkit.assert_true(got && picture.ok(&m), "decoded")
    testkit.assert_eq_i64(picture.width(&m) as i64, w.w as i64)
    testkit.assert_true(rt.mem_eq(picture.pixels(&m), rt.buf_ptr(&w.px), w.w as usize * w.h as usize * 4), "same pixels")
    webp.webp_image_free(&w)
    picture.free(&m)
    rt.buf_free(&raw)
}

#[test]
fn refusals_give_an_empty_picture() {
    var a: picture.Picture = picture.open("tests/data/does_not_exist.png")
    testkit.assert_false(picture.ok(&a), "missing")
    var b: picture.Picture = picture.open("tests/data/rt_probe.txt")
    testkit.assert_false(picture.ok(&b), "not a picture")
    var c: picture.Picture = picture.from_bytes(0, 0)
    testkit.assert_false(picture.ok(&c), "empty")
    var e: picture.Picture = picture.resized(&a, 4, 4)
    testkit.assert_false(picture.ok(&e), "resize of empty stays empty")
    testkit.assert_false(picture.save(&a, "/tmp/never-written.png"), "save of empty")
    var g: picture.Picture = make_gradient(false)
    testkit.assert_false(picture.save(&g, "/tmp/never-written.xyz"), "unknown extension")
    var z: picture.Picture = picture.resized(&g, 0, 5)
    testkit.assert_false(picture.ok(&z), "zero width")
    picture.free(&g)
}

#[test]
fn png_round_trip_is_exact() {
    var g: picture.Picture = make_gradient(true)
    var out: rt.Buf = rt.buf_new()
    testkit.assert_true(picture.encode(&g, ".PNG", &out), "encode")
    var back: picture.Picture = picture.from_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    testkit.assert_true(picture.ok(&back) && picture.format(&back) == picture.FMT_PNG, "decode")
    testkit.assert_eq_i64(picture.width(&back) as i64, 37)
    testkit.assert_eq_i64(picture.height(&back) as i64, 23)
    testkit.assert_true(rt.mem_eq(picture.pixels(&g), picture.pixels(&back), 37 * 23 * 4), "same octets")
    picture.free(&g)
    picture.free(&back)
    rt.buf_free(&out)
}

#[test]
fn jpeg_round_trip_is_close() {
    var g: picture.Picture = make_gradient(false)
    var out: rt.Buf = rt.buf_new()
    testkit.assert_true(picture.encode(&g, "x.jpg", &out), "encode")
    var back: picture.Picture = picture.from_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    testkit.assert_true(picture.ok(&back) && picture.format(&back) == picture.FMT_JPEG, "decode")
    testkit.assert_eq_i64(picture.width(&back) as i64, 37)
    var sum: u64 = 0
    var i: usize = 0
    while i < 37 * 23 * 4 {
        let a: i64 = rt.ld8(picture.pixels(&g), i) as i64
        let b: i64 = rt.ld8(picture.pixels(&back), i) as i64
        if a > b {
            sum = sum + (a - b) as u64
        } else {
            sum = sum + (b - a) as u64
        }
        i = i + 1
    }
    testkit.assert_true(sum / ((37 * 23 * 4) as u64) < 6, "mean error below 6")
    picture.free(&g)
    picture.free(&back)
    rt.buf_free(&out)
}

#[test]
fn ppm_puts_alpha_on_white() {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push(&b, 0 as u8)
    rt.buf_push(&b, 0 as u8)
    rt.buf_push(&b, 0 as u8)
    rt.buf_push(&b, 0 as u8)
    var im: picture.Picture = picture.from_rgba(rt.buf_ptr(&b), 1, 1)
    var out: rt.Buf = rt.buf_new()
    testkit.assert_true(picture.encode(&im, ".ppm", &out), "encode")
    testkit.assert_eq_i64(rt.buf_len(&out) as i64, 11 + 3)
    testkit.assert_eq_i64(rt.buf_at(&out, 11) as i64, 255)
    testkit.assert_eq_i64(rt.buf_at(&out, 0) as i64, 80)
    testkit.assert_eq_i64(rt.buf_at(&out, 1) as i64, 54)
    picture.free(&im)
    rt.buf_free(&out)
    rt.buf_free(&b)
}

#[test]
fn resize_is_the_icons_resample() {
    var g: picture.Picture = make_gradient(true)
    var r: picture.Picture = picture.resized(&g, 18, 11)
    var ref: rt.Buf = rt.buf_new()
    testkit.assert_true(packicons.resample(picture.pixels(&g), 37, 23, &ref, 18, 11), "reference")
    testkit.assert_true(picture.ok(&r), "ok")
    testkit.assert_true(rt.mem_eq(picture.pixels(&r), rt.buf_ptr(&ref), 18 * 11 * 4), "same octets")
    var up: picture.Picture = picture.resized(&g, 90, 50)
    testkit.assert_eq_i64(picture.width(&up) as i64, 90)
    picture.free(&g)
    picture.free(&r)
    picture.free(&up)
    rt.buf_free(&ref)
}

#[test]
fn flat_colour_stays_flat_when_resized() {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 16 * 16 {
        rt.buf_push(&b, 200 as u8)
        rt.buf_push(&b, 100 as u8)
        rt.buf_push(&b, 50 as u8)
        rt.buf_push(&b, 255 as u8)
        i = i + 1
    }
    var im: picture.Picture = picture.from_rgba(rt.buf_ptr(&b), 16, 16)
    var r: picture.Picture = picture.resized(&im, 5, 7)
    testkit.assert_eq_i64(picture.pixel(&r, 0, 0) as i64, 0xFFC86432)
    testkit.assert_eq_i64(picture.pixel(&r, 4, 6) as i64, 0xFFC86432)
    picture.free(&im)
    picture.free(&r)
    rt.buf_free(&b)
}

#[test]
fn fit_keeps_proportions_and_never_enlarges() {
    var g: picture.Picture = make_gradient(false)
    var a: picture.Picture = picture.fit(&g, 20, 20)
    testkit.assert_eq_i64(picture.width(&a) as i64, 20)
    testkit.assert_eq_i64(picture.height(&a) as i64, 12)
    var b: picture.Picture = picture.fit(&g, 400, 400)
    testkit.assert_eq_i64(picture.width(&b) as i64, 37)
    testkit.assert_eq_i64(picture.height(&b) as i64, 23)
    picture.free(&g)
    picture.free(&a)
    picture.free(&b)
}

#[test]
fn crop_and_gray() {
    var g: picture.Picture = make_gradient(false)
    var c: picture.Picture = picture.cropped(&g, 30, 20, 100, 100)
    testkit.assert_eq_i64(picture.width(&c) as i64, 7)
    testkit.assert_eq_i64(picture.height(&c) as i64, 3)
    testkit.assert_eq_i64(picture.pixel(&c, 0, 0) as i64, picture.pixel(&g, 30, 20) as i64)
    testkit.assert_eq_i64(picture.pixel(&c, 6, 2) as i64, picture.pixel(&g, 36, 22) as i64)
    var o: picture.Picture = picture.cropped(&g, 37, 0, 3, 3)
    testkit.assert_false(picture.ok(&o), "outside")
    var y: picture.Picture = picture.gray(&g)
    let p: u32 = picture.pixel(&y, 12, 9)
    testkit.assert_eq_i64(((p >> 16) & 255) as i64, ((p >> 8) & 255) as i64)
    testkit.assert_eq_i64(((p >> 8) & 255) as i64, (p & 255) as i64)
    picture.free(&g)
    picture.free(&c)
    picture.free(&y)
}

// 300 deterministic mutations (flipped octets, cut-off tails) of every sample: never a crash.
#[test]
fn fuzz_mutated_files_never_crash() {
    var names: [str; 4] = ["tests/data/png/rgb8_key.png", "tests/data/jpeg/base420.jpg",
        "tests/data/webp/ll_rgb.webp", "tests/data/gif/pal16.gif"]
    var seed: u64 = 88172645463325252
    var k: usize = 0
    var tried: usize = 0
    while k < 4 {
        var raw: rt.Buf = rt.buf_new()
        let n: usize = fs.read_file(names[k], &raw) catch 0
        testkit.assert_true(n > 16, "sample read")
        var round: usize = 0
        while round < 75 {
            seed = seed ^ (seed << 13)
            seed = seed ^ (seed >> 7)
            seed = seed ^ (seed << 17)
            var m: rt.Buf = rt.buf_new()
            rt.buf_push_bytes(&m, rt.buf_ptr(&raw), n)
            var flips: usize = 1 + (seed % 4) as usize
            var f: usize = 0
            while f < flips {
                seed = seed ^ (seed << 13)
                seed = seed ^ (seed >> 7)
                seed = seed ^ (seed << 17)
                rt.st8(rt.buf_ptr(&m), (seed % (n as u64)) as usize, (seed >> 32) as% u8)
                f = f + 1
            }
            var len: usize = n
            if round % 3 == 0 {
                len = 8 + (seed % ((n - 8) as u64)) as usize
            }
            var im: picture.Picture = picture.from_bytes(rt.buf_ptr(&m), len)
            picture.free(&im)
            rt.buf_free(&m)
            tried = tried + 1
            round = round + 1
        }
        rt.buf_free(&raw)
        k = k + 1
    }
    testkit.assert_eq_i64(tried as i64, 300)
}
