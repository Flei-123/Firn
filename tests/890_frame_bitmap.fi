// expect_exit: 42
// Round 59: the frame allocator of the kernel, as an ordinary program.
//
// `the osum repository (kernel/mem.fi)` manages physical memory with one bit per 4 KiB
// page. That code only ever runs in QEMU (tools/kernel/run.sh) -- the
// same algorithm stands here on a buffer of its own, so that the test
// suite runs it in all three build stages and with BOTH compilers.
//
// What is checked: setting, clearing, reading back, the skipping over
// full octets in the search, and the sequence allocate / free / allocate
// again -- the freed frame has to come back.
fn bit_get(p: u64, i: u64) -> bool {
    return (__mmio_read8((p + i / 8) as *mut u8) as u64 & (1 << (i % 8))) != 0
}

fn bit_set(p: u64, i: u64) {
    let a: u64 = p + i / 8
    let v: u64 = __mmio_read8(a as *mut u8) as u64
    __mmio_write8(a as *mut u8, (v | (1 << (i % 8))) as u8)
}

fn bit_clear(p: u64, i: u64) {
    let a: u64 = p + i / 8
    let v: u64 = __mmio_read8(a as *mut u8) as u64
    __mmio_write8(a as *mut u8, (v & (255 ^ (1 << (i % 8)))) as u8)
}

// First free bit, and set it. 0xFFFFFFFFFFFFFFFF = nothing free.
fn take(p: u64, n: u64) -> u64 {
    var f: u64 = 0
    while f < n {
        if __mmio_read8((p + f / 8) as *mut u8) as u64 == 255 {
            f = f + 8 - (f % 8)
        } else {
            if !bit_get(p, f) {
                bit_set(p, f)
                return f
            }
            f = f + 1
        }
    }
    return 0xFFFFFFFFFFFFFFFF
}

fn count_free(p: u64, n: u64) -> u64 {
    var f: u64 = 0
    var free: u64 = 0
    while f < n {
        if !bit_get(p, f) {
            free = free + 1
        }
        f = f + 1
    }
    return free
}

fn main() -> i32 {
    var buf: [u8; 64] = [0 as u8; 64]
    let p: u64 = (&buf[0]) as u64
    let n: u64 = 512

    // everything taken, then two regions released
    var i: u64 = 0
    while i < 64 {
        __mmio_write8((p + i) as *mut u8, 255 as u8)
        i = i + 1
    }
    if count_free(p, n) != 0 {
        return 1
    }
    i = 40
    while i < 60 {
        bit_clear(p, i)
        i = i + 1
    }
    i = 100
    while i < 104 {
        bit_clear(p, i)
        i = i + 1
    }
    if count_free(p, n) != 24 {
        return 2
    }

    // three in a row out of the first region
    let a: u64 = take(p, n)
    let b: u64 = take(p, n)
    let c: u64 = take(p, n)
    if a != 40 || b != 41 || c != 42 {
        return 3
    }
    if count_free(p, n) != 21 {
        return 4
    }

    // the freed one has to come back, and not a different one
    bit_clear(p, b)
    if count_free(p, n) != 22 {
        return 5
    }
    if take(p, n) != b {
        return 6
    }

    // exhaust: after that nothing more, and everything is really set
    var k: u64 = 0
    while k < 21 {
        if take(p, n) == 0xFFFFFFFFFFFFFFFF {
            return 7
        }
        k = k + 1
    }
    if take(p, n) != 0xFFFFFFFFFFFFFFFF {
        return 8
    }
    if count_free(p, n) != 0 {
        return 9
    }
    return 42
}
