// expect_exit: 0
import std.rt
import mc.mc_raster
import mc.mc_gui_tex
import mc.mc_hud_tex
import mc.mc_hud_vanilla
import mc.mc_hud_state

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn fill(t: *mut mc_gui_tex.GuiTex) {
    mc_gui_tex.gtex_blank(t, 256, 256)
    var y: i32 = 0
    while y < 256 {
        var x: i32 = 0
        while x < 256 {
            mc_gui_tex.gtex_set(t, x, y, 0xFF000000 as u32 | ((y as u32) << 8 as u32) | (x as u32))
            x = x + 1
        }
        y = y + 1
    }
}

fn same_texel(r: *mut mc_raster.Raster, t: *mut mc_gui_tex.GuiTex, dx: i32, dy: i32, sx: i32, sy: i32) -> bool {
    return mc_raster.raster_pixel(r, dx, dy) == mc_gui_tex.gtex_get(t, sx, sy)
}

fn main() -> i32 {
    var tex: mc_hud_tex.HudTex = mc_hud_tex.hudtex_new()
    fill(&tex.widgets)
    fill(&tex.icons)
    var r: mc_raster.Raster = mc_raster.raster_new(640, 360)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    var v: mc_hud_vanilla.HudView = mc_hud_vanilla.hv_new()
    v.slot = 3
    v.hp_x2 = 15
    v.food = 7
    v.armor = 5
    v.level = 0
    v.xp_x1000 = 500
    mc_hud_vanilla.vh_draw(&r, &tex, &v, 2)
    let hx: i32 = mc_hud_vanilla.vh_hotbar_x(&r, 2)
    let hy: i32 = mc_hud_vanilla.vh_hotbar_y(&r, 2)
    check(hx == 138, 1)
    check(hy == (180 - 22) * 2, 2)
    check(same_texel(&r, &tex.widgets, hx + 2 * 5, hy + 2 * 7, 5, 7), 3)
    let top: i32 = (180 - 39) * 2
    check(same_texel(&r, &tex.icons, 138 + 2 * 2, top + 2 * 4, 52 + 2, 4) || same_texel(&r, &tex.icons, 138 + 2 * 2, top + 2 * 4, 16 + 2, 4), 5)
    check(same_texel(&r, &tex.icons, 138 + 2 * 3, top - 20 + 2 * 5, 34 + 3, 9 + 5) || same_texel(&r, &tex.icons, 138 + 2 * 3, top - 20 + 2 * 5, 25 + 3, 9 + 5) || same_texel(&r, &tex.icons, 138 + 2 * 3, top - 20 + 2 * 5, 16 + 3, 9 + 5), 6)
    let xp_y: i32 = (180 - 29) * 2
    check(same_texel(&r, &tex.icons, 138 + 2 * 10, xp_y + 2 * 2, 10, 69 + 2), 7)
    check(same_texel(&r, &tex.icons, 138 + 2 * 150, xp_y + 2 * 2, 150, 64 + 2), 8)

    var hs: mc_hud_state.HudState = mc_hud_state.hs_new()
    check(mc_hud_state.hs_title_alpha(&hs, 1000 as u64) == 0, 20)
    check(mc_hud_state.hs_score_count(&hs) == 0, 21)
    mc_hud_vanilla.vh_draw_title(&r, &hs, 2, 1000 as u64)
    mc_hud_vanilla.vh_draw_sidebar(&r, &hs, 2)

    mc_hud_tex.hudtex_free(&tex)
    return 0
}
