// expect_exit: 0
// tests/2745_mc_chunk19.fi -- mc_chunk.chunk_decode_19 (1.9 - 1.12.2 `map_chunk`, CF_SECTIONS_19) on hand built
// packets: indirect palette with entries that span two longs (5 bits), direct ids (13 bits, no palette),
// 4 bit palette, with and without sky light, a ground-up column (biomes) and section updates merged by
// mc_world.world_apply. The comparison with a real 1.12.2 server is tools/mcclient/run.sh.
import std.bytes
import std.rt
import mc.mc_chunk
import mc.mc_world

const N: usize = 4096

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

// ---- the four section contents (legacy value = id << 4 | meta) -------------------------------------
// kind 0: bits 5, palette of 20, index (i*7 + i/3) % 20      -> entries span two longs
// kind 1: bits 13, NO palette, value (i*53 + 7) % 4000       -> direct ids, spans two longs
// kind 2: bits 4, palette [0, 784], index (i/5) % 2
// kind 3: bits 5, palette [0, 320, 337], index i % 3          (used for updates)
fn pal_value(kind: i32, k: u32) -> u32 {
    if k == 0 as u32 {
        return 0 as u32
    }
    if kind == 0 {
        return ((((k + 1 as u32) * 11 as u32) % 200 as u32) << 4) | (k % 16 as u32)
    }
    if kind == 2 {
        return 49 * 16 + 0
    }
    if k == 1 as u32 {
        return 20 * 16
    }
    return 21 * 16 + 1
}

fn pal_size(kind: i32) -> u32 {
    if kind == 0 {
        return 20 as u32
    }
    if kind == 1 {
        return 0 as u32
    }
    if kind == 2 {
        return 2 as u32
    }
    return 3 as u32
}

fn bits_of(kind: i32) -> u32 {
    if kind == 0 || kind == 3 {
        return 5 as u32
    }
    if kind == 1 {
        return 13 as u32
    }
    return 4 as u32
}

// the entry stored in the long array at position i (palette index, or the direct value)
fn raw_entry(kind: i32, i: usize) -> u32 {
    if kind == 0 {
        return ((i * 7 + i / 3) % 20) as u32
    }
    if kind == 1 {
        return ((i * 53 + 7) % 4000) as u32
    }
    if kind == 2 {
        return ((i / 5) % 2) as u32
    }
    return (i % 3) as u32
}

// the block value the decoder must report at i
fn expect(kind: i32, i: usize) -> u32 {
    if kind == 1 {
        return raw_entry(kind, i)
    }
    return pal_value(kind, raw_entry(kind, i))
}

fn put_section(b: *mut bytes.Bytes, kind: i32, sky: bool) {
    let bpe: u32 = bits_of(kind)
    let np: u32 = pal_size(kind)
    bytes.put_u8(b, bpe as u8)
    bytes.put_varint(b, np as i32)
    var k: u32 = 0 as u32
    while k < np {
        bytes.put_varint(b, pal_value(kind, k) as i32)
        k = k + 1 as u32
    }
    let words: usize = (N * (bpe as usize) + 63) / 64
    bytes.put_varint(b, words as i32)
    let w: u64 = rt.heap_alloc(words * 8)
    var q: usize = 0
    while q < words {
        rt.st64(w, q, 0 as u64)
        q = q + 1
    }
    var i: usize = 0
    while i < N {
        let v: u64 = raw_entry(kind, i) as u64
        let bit: usize = i * (bpe as usize)
        let wi: usize = bit / 64
        let off: u32 = (bit % 64) as u32
        rt.st64(w, wi, rt.ld64(w, wi) | (v << off))
        if (off as usize) + (bpe as usize) > 64 {
            rt.st64(w, wi + 1, rt.ld64(w, wi + 1) | (v >> (64 as u32 - off)))
        }
        i = i + 1
    }
    q = 0
    while q < words {
        bytes.put_u64(b, rt.ld64(w, q))
        q = q + 1
    }
    rt.heap_free(w, words * 8)
    bytes.put_zero(b, 2048) // block light
    if sky {
        bytes.put_zero(b, 2048) // sky light
    }
}

// spec: 3 bits per section (0 = absent, kind + 1 otherwise)
fn spec_of(a: i32, b: i32, c: i32) -> u64 {
    // sections 0, 2 and 5 carry kinds a, b, c (-1 = absent)
    var s: u64 = 0 as u64
    if a >= 0 {
        s = s | (((a + 1) as u64) << 0)
    }
    if b >= 0 {
        s = s | (((b + 1) as u64) << 6)
    }
    if c >= 0 {
        s = s | (((c + 1) as u64) << 15)
    }
    return s
}

fn build(body: *mut bytes.Bytes, x: i32, z: i32, ground_up: bool, sky: bool, spec: u64) {
    bytes.put_i32(body, x)
    bytes.put_i32(body, z)
    bytes.put_bool(body, ground_up)
    var mask: i32 = 0
    var d: bytes.Bytes = bytes.bytes_new()
    var i: usize = 0
    while i < 16 {
        let k: i32 = ((spec >> ((3 * i) as u32)) & 7 as u64) as i32
        if k != 0 {
            mask = mask | (1 << (i as u32))
            put_section(&d, k - 1, sky)
        }
        i = i + 1
    }
    if ground_up {
        var j: usize = 0
        while j < 256 {
            bytes.put_u8(&d, ((j * 3) % 7) as u8)
            j = j + 1
        }
    }
    bytes.put_varint(body, mask)
    bytes.put_varint(body, bytes.bytes_len(&d) as i32)
    bytes.put_bytes(body, &d)
    bytes.put_varint(body, 0) // no block entities
    bytes.bytes_free(&d)
}

fn nonair(kind: i32) -> i32 {
    var n: i32 = 0
    var i: usize = 0
    while i < N {
        if expect(kind, i) != 0 as u32 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn check_section(c: *mut mc_chunk.Chunk, idx: usize, kind: i32, code: i32) {
    let s: *mut mc_chunk.Section = mc_chunk.chunk_section(c, idx)
    var i: usize = 0
    if kind < 0 {
        check((*s).count == 0, code)
        check(mc_chunk.container_palette_size(&(*s).blocks) == 1 as u32, code + 1)
        while i < N {
            check(mc_chunk.container_get(&(*s).blocks, i) == 0 as u16, code + 2)
            i = i + 1
        }
        return
    }
    check((*s).count == nonair(kind), code + 3)
    while i < N {
        check(mc_chunk.container_get(&(*s).blocks, i) as u32 == expect(kind, i), code + 4)
        i = i + 1
    }
}

fn check_column(c: *mut mc_chunk.Chunk, a: i32, b: i32, d: i32, base: i32) {
    check((*c).nsec == 16, base)
    var i: usize = 0
    while i < 16 {
        var kind: i32 = 0 - 1
        if i == 0 {
            kind = a
        }
        if i == 2 {
            kind = b
        }
        if i == 5 {
            kind = d
        }
        check_section(c, i, kind, base + 10 + (i as i32) * 10)
        i = i + 1
    }
}

fn decode(body: *mut bytes.Bytes, sc: *mut mc_chunk.Scratch) -> u64 {
    let p: u64 = mc_chunk.chunk_alloc()
    check(p != 0, 1)
    let ok: bool = mc_chunk.chunk_decode_19(body, sc, p as *mut mc_chunk.Chunk) catch false
    if !ok {
        mc_chunk.chunk_release(p)
        return 0
    }
    return p
}

fn main() -> i32 {
    var sc: mc_chunk.Scratch = mc_chunk.scratch_new()

    // ---- 1. ground-up column, overworld (sky light), sections 0 / 2 / 5 = kinds 0 / 1 / 2 -------------
    var b1: bytes.Bytes = bytes.bytes_new()
    build(&b1, 0 - 3, 7, true, true, spec_of(0, 1, 2))
    mc_chunk.scratch_set_sky(&sc, true)
    let p1: u64 = decode(&b1, &sc)
    check(p1 != 0, 2)
    let c1: *mut mc_chunk.Chunk = p1 as *mut mc_chunk.Chunk
    check((*c1).x == 0 - 3 && (*c1).z == 7, 3)
    check((*c1).ground_up == 1, 4)
    check((*c1).sec_mask == (1 | 4 | 32), 5)
    check((*c1).block_n == 3 && (*c1).sky_n == 3, 6)
    check((*c1).nbe == 0, 7)
    check_column(c1, 0, 1, 2, 100)
    check((*c1).bio != 0, 8)
    var j: usize = 0
    while j < 256 {
        check(rt.ld8((*c1).bio, j) == ((j * 3) % 7) as u8, 9)
        j = j + 1
    }
    // the palette of the 5 bit section keeps its 20 entries, the 4 bit one its 2 (re-packed, same values)
    check(mc_chunk.container_palette_size(&(*mc_chunk.chunk_section(c1, 0)).blocks) == 20 as u32, 10)
    check(mc_chunk.container_bits(&(*mc_chunk.chunk_section(c1, 0)).blocks) == 5 as u32, 11)
    check(mc_chunk.container_bits(&(*mc_chunk.chunk_section(c1, 5)).blocks) == 1 as u32, 12)
    mc_chunk.chunk_release(p1)

    // ---- 2. same without sky light (nether / end): no sky arrays in the packet -------------------------
    var b2: bytes.Bytes = bytes.bytes_new()
    build(&b2, 4, 4, true, false, spec_of(2, 0, 1))
    mc_chunk.scratch_set_sky(&sc, false)
    let p2: u64 = decode(&b2, &sc)
    check(p2 != 0, 20)
    let c2: *mut mc_chunk.Chunk = p2 as *mut mc_chunk.Chunk
    check((*c2).block_n == 3 && (*c2).sky_n == 0, 21)
    check_column(c2, 2, 0, 1, 300)
    mc_chunk.chunk_release(p2)

    // ---- 3. the dimension flag matters: the same bytes with the wrong flag are refused ------------------
    var b3: bytes.Bytes = bytes.bytes_new()
    build(&b3, 1, 1, true, true, spec_of(0, 0 - 1, 0 - 1))
    mc_chunk.scratch_set_sky(&sc, false)
    check(decode(&b3, &sc) == 0, 30)
    mc_chunk.scratch_set_sky(&sc, true)
    var b3b: bytes.Bytes = bytes.bytes_new()
    build(&b3b, 1, 1, true, false, spec_of(0, 0 - 1, 0 - 1))
    check(decode(&b3b, &sc) == 0, 31)

    // ---- 4. truncated and damaged packets never decode ----------------------------------------------------
    var full: bytes.Bytes = bytes.bytes_new()
    build(&full, 0, 0, true, true, spec_of(0, 1, 2))
    let flen: usize = bytes.bytes_len(&full)
    var cut: usize = 0
    while cut < flen {
        var part: bytes.Bytes = bytes.Bytes { data: full.data, cap: cut, len: cut, pos: 0, bad: false }
        let pp: u64 = decode(&part, &sc)
        check(pp == 0, 40)
        cut = cut + 997 // a handful of cut points over the whole packet, including the very beginning
    }

    // ---- 5. a hand packed 4 bit section pins the byte order: entry 0 and entry 17 are palette index 1 ---
    var raw: bytes.Bytes = bytes.bytes_new()
    var d: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&d, 4 as u8)
    bytes.put_varint(&d, 2)
    bytes.put_varint(&d, 0)
    bytes.put_varint(&d, 800) // id 50, meta 0
    bytes.put_varint(&d, 256) // 4096 * 4 / 64 longs
    var w: usize = 0
    while w < 256 {
        var v: u8 = 0 as u8
        if w == 0 {
            v = 1 as u8 // long 0 = 0x0000000000000001 (big endian on the wire): entry 0
        }
        if w == 1 {
            v = 16 as u8 // long 1 = 0x0000000000000010: entry 16 + 1 = 17
        }
        bytes.put_u8(&d, 0 as u8)
        bytes.put_u8(&d, 0 as u8)
        bytes.put_u8(&d, 0 as u8)
        bytes.put_u8(&d, 0 as u8)
        bytes.put_u8(&d, 0 as u8)
        bytes.put_u8(&d, 0 as u8)
        bytes.put_u8(&d, 0 as u8)
        bytes.put_u8(&d, v)
        w = w + 1
    }
    bytes.put_zero(&d, 2048)
    bytes.put_i32(&raw, 9)
    bytes.put_i32(&raw, 9)
    bytes.put_bool(&raw, false)
    bytes.put_varint(&raw, 1)
    bytes.put_varint(&raw, bytes.bytes_len(&d) as i32)
    bytes.put_bytes(&raw, &d)
    bytes.put_varint(&raw, 0)
    mc_chunk.scratch_set_sky(&sc, false)
    let p5: u64 = decode(&raw, &sc)
    check(p5 != 0, 50)
    let c5: *mut mc_chunk.Chunk = p5 as *mut mc_chunk.Chunk
    check((*c5).ground_up == 0 && (*c5).bio == 0, 51)
    let s5: *mut mc_chunk.Section = mc_chunk.chunk_section(c5, 0)
    check((*s5).count == 2, 52)
    var t: usize = 0
    while t < N {
        var want: u16 = 0 as u16
        if t == 0 || t == 17 {
            want = 800 as u16
        }
        check(mc_chunk.container_get(&(*s5).blocks, t) == want, 53)
        t = t + 1
    }
    mc_chunk.chunk_release(p5)

    // ---- 6. section updates are merged into the stored column -------------------------------------------------
    mc_chunk.scratch_set_sky(&sc, true)
    var w1: mc_world.World = mc_world.world_new()
    var col: bytes.Bytes = bytes.bytes_new()
    build(&col, 5, 6, true, true, spec_of(0, 1, 2))
    let pc: u64 = decode(&col, &sc)
    check(pc != 0, 60)
    check(mc_world.world_apply(&w1, pc) == mc_world.APPLY_STORED, 61)
    // update: only section 2 changes (kind 3); sections 0 and 5 stay, biomes stay
    var up: bytes.Bytes = bytes.bytes_new()
    build(&up, 5, 6, false, true, spec_of(0 - 1, 3, 0 - 1))
    let pu: u64 = decode(&up, &sc)
    check(pu != 0, 62)
    check((*(pu as *mut mc_chunk.Chunk)).ground_up == 0, 63)
    check((*(pu as *mut mc_chunk.Chunk)).sec_mask == 4, 64)
    check(mc_world.world_apply(&w1, pu) == mc_world.APPLY_MERGED, 65)
    check(mc_world.world_count(&w1) == 1, 66)
    let cm: *mut mc_chunk.Chunk = mc_world.world_find(&w1, 5, 6) as *mut mc_chunk.Chunk
    check(cm as u64 != 0, 67)
    check_column(cm, 0, 3, 2, 700)
    check((*cm).ground_up == 1 && (*cm).bio != 0, 68)
    check(rt.ld8((*cm).bio, 10) == ((10 * 3) % 7) as u8, 69)
    check((*cm).block_n == 4 && (*cm).sky_n == 4, 70)
    // an update that clears section 0 (air only) and one for a column the world does not have
    var up2: bytes.Bytes = bytes.bytes_new()
    build(&up2, 5, 6, false, true, spec_of(2, 0 - 1, 0 - 1))
    let pu2: u64 = decode(&up2, &sc)
    check(pu2 != 0, 71)
    check(mc_world.world_apply(&w1, pu2) == mc_world.APPLY_MERGED, 72)
    check_column(cm, 2, 3, 2, 900)
    var up3: bytes.Bytes = bytes.bytes_new()
    build(&up3, 99, 99, false, true, spec_of(1, 0 - 1, 0 - 1))
    let pu3: u64 = decode(&up3, &sc)
    check(pu3 != 0, 73)
    check(mc_world.world_apply(&w1, pu3) == mc_world.APPLY_DROPPED, 74)
    check(mc_world.world_count(&w1) == 1, 75)
    // a whole column replaces the stored one
    var col2: bytes.Bytes = bytes.bytes_new()
    build(&col2, 5, 6, true, true, spec_of(1, 0 - 1, 0 - 1))
    let pc2: u64 = decode(&col2, &sc)
    check(pc2 != 0, 76)
    check(mc_world.world_apply(&w1, pc2) == mc_world.APPLY_STORED, 77)
    check(mc_world.world_count(&w1) == 1, 78)
    check_column(mc_world.world_find(&w1, 5, 6) as *mut mc_chunk.Chunk, 1, 0 - 1, 0 - 1, 1100)
    mc_world.world_free(&w1)

    mc_chunk.scratch_free(&sc)
    bytes.bytes_free(&b1)
    bytes.bytes_free(&b2)
    bytes.bytes_free(&b3)
    bytes.bytes_free(&b3b)
    bytes.bytes_free(&full)
    bytes.bytes_free(&raw)
    bytes.bytes_free(&d)
    bytes.bytes_free(&col)
    bytes.bytes_free(&up)
    bytes.bytes_free(&up2)
    bytes.bytes_free(&up3)
    bytes.bytes_free(&col2)
    return 0
}
