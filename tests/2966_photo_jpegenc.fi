// expect_exit: 0
// tests/2966_photo_jpegenc.fi -- photo.jpegenc: the baseline JPEG encoder, checked with lib/jpeg (the decoder is
// compared against libjpeg/Pillow elsewhere, tools/libmvp/check_jpeg.py). A 203x157 synthetic scene (not a
// multiple of the MCU) is encoded at quality 90 and 95 in 4:2:0 and 4:4:4; the decoded picture must have the same
// size, PSNR vs the source above the limits below, quality 95 must beat 90 and cost more bytes, 4:4:4 must beat 4:2:0
// at equal quality; the EXIF orientation 6 file decodes rotated (157x203); a too small buffer gives 0.
import std.io
import std.rt
import jpeg.jpeg
import photo.image
import photo.jpegenc

fn check(c: bool, msg: str) -> bool {
    if !c { io.print(msg); io.new_line() }
    return c
}

// encode `im`, decode again, return PSNR (display space, peak 1) or -1; size in *nout
fn roundtrip(im: *mut image.Image, q: i32, sub: bool, nout: *mut usize) -> f32 {
    var o: jpegenc.EncOpts = jpegenc.enc_default()
    o.quality = q
    o.subsample = sub
    let cap: usize = jpegenc.jpeg_max_size((*im).w, (*im).h)
    let buf: u64 = rt.heap_alloc(cap)
    let n: usize = jpegenc.jpeg_encode_image(im, &o, buf, cap)
    *nout = n
    if n == 0 { rt.heap_free(buf, cap); return 0.0f - 1.0f }
    var dj: jpeg.JpegImage = jpeg.jpeg_image_new()
    let ok: bool = jpeg.jpeg_decode(buf, n, &dj) catch false
    rt.heap_free(buf, cap)
    if !ok { return 0.0f - 2.0f }
    if dj.w != ((*im).w as u32) || dj.h != ((*im).h as u32) { jpeg.jpeg_image_free(&dj); return 0.0f - 3.0f }
    var back: image.Image = image.img_from_rgba8(rt.buf_ptr(&dj.px), (*im).w, (*im).h)
    var ref8: image.Image = image.img_copy(im)
    // quantise the source to 8 bit exactly like the encoder input
    let tmp: u64 = rt.heap_alloc(((*im).w * (*im).h * 4) as usize)
    image.img_to_rgba8(im, tmp)
    image.img_free(&ref8)
    ref8 = image.img_from_rgba8(tmp, (*im).w, (*im).h)
    rt.heap_free(tmp, ((*im).w * (*im).h * 4) as usize)
    let p: f32 = image.psnr(&ref8, &back, 1.0f)
    image.img_free(&back)
    image.img_free(&ref8)
    jpeg.jpeg_image_free(&dj)
    return p
}

fn show(label: str, v: f32) {
    io.print(label)
    io.fmt_print_line(io.fmt_f32(io.fmt_new(), v))
}

fn main() -> i32 {
    var ok: bool = true
    var im: image.Image = image.scene_make(203, 157)
    var n90: usize = 0
    var n95: usize = 0
    var n90f: usize = 0
    var n95f: usize = 0
    let p90: f32 = roundtrip(&im, 90, true, &n90)
    let p95: f32 = roundtrip(&im, 95, true, &n95)
    let p90f: f32 = roundtrip(&im, 90, false, &n90f)
    let p95f: f32 = roundtrip(&im, 95, false, &n95f)
    show("psnr 420 q90 ", p90)
    show("psnr 420 q95 ", p95)
    show("psnr 444 q90 ", p90f)
    show("psnr 444 q95 ", p95f)
    show("bytes 420 q90 ", n90 as f32)
    show("bytes 420 q95 ", n95 as f32)
    ok = check(p90 > 30.0f, "q90 420 psnr low") && ok
    ok = check(p95 > p90 + 0.5f, "q95 not better than q90") && ok
    ok = check(n95 > n90, "q95 not larger than q90") && ok
    ok = check(p95f > 33.0f, "q95 444 psnr low") && ok
    ok = check(p90f > p90, "444 not better than 420") && ok
    // EXIF orientation 6 -> the decoder turns the picture upright: 157 x 203
    var o: jpegenc.EncOpts = jpegenc.enc_default()
    o.orientation = 6
    let cap: usize = jpegenc.jpeg_max_size(im.w, im.h)
    let buf: u64 = rt.heap_alloc(cap)
    let n: usize = jpegenc.jpeg_encode_image(&im, &o, buf, cap)
    ok = check(n > 0, "encode with orientation failed") && ok
    var dj: jpeg.JpegImage = jpeg.jpeg_image_new()
    let dok: bool = jpeg.jpeg_decode(buf, n, &dj) catch false
    ok = check(dok && dj.w == (157 as u32) && dj.h == (203 as u32), "orientation 6 not applied") && ok
    if dok { jpeg.jpeg_image_free(&dj) }
    // too small buffer
    let small: usize = jpegenc.jpeg_encode_image(&im, &o, buf, 300)
    ok = check(small == 0, "small buffer must fail") && ok
    rt.heap_free(buf, cap)
    // 1x1 and 17x1 sizes
    var tiny: image.Image = image.scene_make(17, 1)
    var nt: usize = 0
    let pt: f32 = roundtrip(&tiny, 95, true, &nt)
    ok = check(pt > 20.0f && nt > 0, "tiny image failed") && ok
    image.img_free(&tiny)
    image.img_free(&im)
    if ok { io.print("ok") } else { io.print("FAIL") }
    io.new_line()
    return 0
}
