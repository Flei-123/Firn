// r899 (documents a NON-guarantee): stage 0 has no `unsafe` block; dereferencing a raw
// pointer is allowed everywhere. SPEC 3.6 (implementation status, r908) says the rule is the target, not the current state.
fn main() -> i32 {
    var x: i64 = 5
    let p: *mut i64 = &x
    return (*p) as i32
}
