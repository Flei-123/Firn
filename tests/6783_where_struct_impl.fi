// expect_exit: 0
interface Area {
    fn area(*self) -> i32
}

struct Sq { side: i32 }

impl Area for Sq {
    fn area(*self) -> i32 { return (*self).side * (*self).side }
}

struct Holder[T] where T: Area { item: T }

impl Holder[T] where T: Area {
    fn total(*self) -> i32 { return (*self).item.area() + 1 }
}

enum Slot[T] where T: Area { Full(T), Empty }

fn main() -> i32 {
    let h = Holder[Sq] { item: Sq { side: 3 } }
    if h.total() != 10 { return 1 }
    let s: Slot[Sq] = Slot::Full(Sq { side: 2 })
    match s {
        Slot::Full(v) => { if v.area() != 4 { return 2 } }
        Slot::Empty => { return 3 }
    }
    return 0
}
