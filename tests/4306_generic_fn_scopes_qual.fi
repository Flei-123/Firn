// expect_exit: 0
// tests/4306_generic_fn_scopes_qual.fi -- r742b: `mod.f` as a generic fn value, a local variable named like a
// generic fn, and lambda target types through casts and `&x`.
import std.option

struct Hold { f: fn(i32) -> i32 }

fn inc(x: i32) -> i32 { return x + 1 }
fn pick_it[T](x: T) -> T { return x }
fn apply(f: fn(i32) -> i32, v: i32) -> i32 { return f(v) }
fn app_opt(f: fn(i32) -> Option[i32], v: i32) -> Option[i32] { return f(v) }

fn main() -> i32 {
    // qualified generic fn without type arguments
    let o = app_opt(option.opt_some, 4)
    if !o.has { return 1 }
    let q: fn(i32) -> Option[i32] = option.opt_some
    if !q(3).has { return 2 }
    // a local variable with the name of a generic fn stays the variable
    let pick_it: fn(i32) -> i32 = inc
    if apply(pick_it, 4) != 5 { return 3 }
    // lambda target types: cast, address-of
    var h: Hold = Hold { f: inc }
    let hp: *mut Hold = &h
    (*(hp as *mut Hold)).f = |x| x * 3
    if h.f(5) != 15 { return 5 }
    (*(&h)).f = |x| x - 1
    if h.f(5) != 4 { return 6 }
    return 0
}
