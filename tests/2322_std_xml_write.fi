// expect_exit: 0
// tests/2322_std_xml_write.fi -- r319: `xml.write`, the round trip, the limits.
//
//   A  write: escaping of text and attribute values, empty elements, subtree
//   B  round trip: parse(write(parse(x))) is the same tree, byte for byte
//      in the second write
//   C  limits: nesting depth and attributes per element, with the error codes
//   D  a large document: 20,000 elements, no stack growth (iterative parser,
//      iterative writer) and the counts come out right
import std.xml
import std.rt
import std.str

fn load(d: *mut xml.Doc, s: str) -> bool {
    return xml.parse_str(d, s) catch false
}

fn out_is(b: *mut rt.Buf, s: str) -> bool {
    return rt.buf_len(b) == s.n && rt.mem_eq(rt.buf_ptr(b), s.p as u64, s.n)
}

fn main() -> i32 {
    var d: xml.Doc = xml.doc_new()
    defer xml.doc_free(&d)
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)

    // --- A: escaping and shape
    if !load(&d, "<?xml version='1.0'?><r a='1&amp;2' b=\"x&quot;y\" c='&#9;&#10;&#13;&lt;'><e/><e></e>t&lt;&gt;&amp;\r\n<![CDATA[]]]]><![CDATA[>]]></r>") {
        return 10
    }
    xml.write(&d, xml.root(&d), &out)
    if !out_is(&out, "<r a=\"1&amp;2\" b=\"x&quot;y\" c=\"&#9;&#10;&#13;&lt;\"><e/><e/>t&lt;&gt;&amp;\n]]&gt;</r>") {
        return 11
    }
    // a subtree
    rt.buf_clear(&out)
    xml.write(&d, xml.child(&d, xml.root(&d), "e"), &out)
    if !out_is(&out, "<e/>") {
        return 12
    }
    // the second element (the first node after the first <e/> is <e></e>)
    rt.buf_clear(&out)
    xml.write(&d, xml.next(&d, xml.child(&d, xml.root(&d), "e")), &out)
    if !out_is(&out, "<e/>") {
        return 13
    }
    // no node: nothing
    rt.buf_clear(&out)
    xml.write(&d, xml.NONE, &out)
    if rt.buf_len(&out) != 0 {
        return 14
    }

    // --- B: round trip
    let docs: [str; 6] = [
        "<a/>",
        "<a x='1' y=\"2\"><b>t<c/>u</b> <d>&#x1F600; \u{e9} \u{65e5}\u{672c}</d></a>",
        "<a>\n  <b k=\"\t\n\"/>\n  <!-- c -->\n</a>",
        "<p:a xmlns:p='u'><p:b p:c='d'>e</p:b></p:a>",
        "<a><![CDATA[<>&]]>&amp;]]&gt;</a>",
        "<a>\r\r\n\n&#13;</a>",
    ]
    var i: usize = 0
    while i < 6 {
        if !load(&d, docs[i]) {
            return 20 + i as i32
        }
        rt.buf_clear(&out)
        xml.write(&d, xml.root(&d), &out)
        var d2: xml.Doc = xml.doc_new()
        let ok: bool = xml.parse(&d2, rt.buf_ptr(&out), rt.buf_len(&out)) catch false
        var w2: rt.Buf = rt.buf_new()
        var same: bool = false
        if ok {
            xml.write(&d2, xml.root(&d2), &w2)
            same = rt.buf_len(&w2) == rt.buf_len(&out)
            && rt.mem_eq(rt.buf_ptr(&w2), rt.buf_ptr(&out), rt.buf_len(&out))
            // the same tree: every text node and name agrees
            if xml.child_count(&d, xml.root(&d)) != xml.child_count(&d2, xml.root(&d2)) {
                same = false
            }
            var t1: rt.Buf = rt.buf_new()
            var t2: rt.Buf = rt.buf_new()
            xml.text_all(&d, xml.root(&d), &t1)
            xml.text_all(&d2, xml.root(&d2), &t2)
            if rt.buf_len(&t1) != rt.buf_len(&t2)
            || !rt.mem_eq(rt.buf_ptr(&t1), rt.buf_ptr(&t2), rt.buf_len(&t1)) {
                same = false
            }
            rt.buf_free(&t1)
            rt.buf_free(&t2)
        }
        rt.buf_free(&w2)
        xml.doc_free(&d2)
        if !same {
            return 30 + i as i32
        }
        i = i + 1
    }
    // CR in text survives the round trip as a character reference
    if !load(&d, "<a>&#13;x</a>") {
        return 40
    }
    rt.buf_clear(&out)
    xml.write(&d, xml.root(&d), &out)
    if !out_is(&out, "<a>&#13;x</a>") {
        return 41
    }

    // --- C: limits
    var big: rt.Buf = rt.buf_new()
    defer rt.buf_free(&big)
    i = 0
    while i < xml.XML_MAX_DEPTH + 1 {
        rt.buf_push(&big, 60 as u8)
        rt.buf_push(&big, 97 as u8)
        rt.buf_push(&big, 62 as u8)
        i = i + 1
    }
    var ok2: bool = xml.parse(&d, rt.buf_ptr(&big), rt.buf_len(&big)) catch false
    if ok2 || xml.err_code(&d) != xml.E_DEPTH {
        return 50
    }
    // the deepest allowed document parses, and is written without a stack
    rt.buf_clear(&big)
    i = 0
    while i < xml.XML_MAX_DEPTH {
        rt.buf_push(&big, 60 as u8)
        rt.buf_push(&big, 97 as u8)
        rt.buf_push(&big, 62 as u8)
        i = i + 1
    }
    i = 0
    while i < xml.XML_MAX_DEPTH {
        rt.buf_push(&big, 60 as u8)
        rt.buf_push(&big, 47 as u8)
        rt.buf_push(&big, 97 as u8)
        rt.buf_push(&big, 62 as u8)
        i = i + 1
    }
    ok2 = xml.parse(&d, rt.buf_ptr(&big), rt.buf_len(&big)) catch false
    if !ok2 {
        return 51
    }
    rt.buf_clear(&out)
    xml.write(&d, xml.root(&d), &out)
    // <a>...</a> nested: the innermost element is empty and written <a/>
    if rt.buf_len(&out) != (xml.XML_MAX_DEPTH - 1) * 7 + 4 {
        return 52
    }
    // too many attributes
    rt.buf_clear(&big)
    rt.buf_push_bytes(&big, "<a".p as u64, 2)
    i = 0
    while i < xml.XML_MAX_ATTRS + 1 {
        rt.buf_push(&big, 32 as u8)
        rt.buf_push(&big, 120 as u8)
        rt.buf_push_dec_u64(&big, i as u64)
        rt.buf_push_bytes(&big, "=\"\"".p as u64, 3)
        i = i + 1
    }
    rt.buf_push_bytes(&big, "/>".p as u64, 2)
    ok2 = xml.parse(&d, rt.buf_ptr(&big), rt.buf_len(&big)) catch false
    if ok2 || xml.err_code(&d) != xml.E_LIMIT {
        return 53
    }
    // exactly the allowed number is fine
    rt.buf_clear(&big)
    rt.buf_push_bytes(&big, "<a".p as u64, 2)
    i = 0
    while i < xml.XML_MAX_ATTRS {
        rt.buf_push(&big, 32 as u8)
        rt.buf_push(&big, 120 as u8)
        rt.buf_push_dec_u64(&big, i as u64)
        rt.buf_push_bytes(&big, "=\"\"".p as u64, 3)
        i = i + 1
    }
    rt.buf_push_bytes(&big, "/>".p as u64, 2)
    ok2 = xml.parse(&d, rt.buf_ptr(&big), rt.buf_len(&big)) catch false
    if !ok2 || xml.attr_count(&d, xml.root(&d)) != xml.XML_MAX_ATTRS {
        return 54
    }
    if !xml.has_attr(&d, xml.root(&d), "x4095") || xml.has_attr(&d, xml.root(&d), "x4096") {
        return 55
    }

    // --- D: 20,000 elements
    rt.buf_clear(&big)
    rt.buf_push_bytes(&big, "<list>".p as u64, 6)
    i = 0
    while i < 20000 {
        rt.buf_push_bytes(&big, "<i n=\"".p as u64, 6)
        rt.buf_push_dec_u64(&big, i as u64)
        rt.buf_push_bytes(&big, "\">v&amp;".p as u64, 8)
        rt.buf_push_dec_u64(&big, i as u64)
        rt.buf_push_bytes(&big, "</i>\n".p as u64, 5)
        i = i + 1
    }
    rt.buf_push_bytes(&big, "</list>".p as u64, 7)
    ok2 = xml.parse(&d, rt.buf_ptr(&big), rt.buf_len(&big)) catch false
    if !ok2 || xml.child_count(&d, xml.root(&d)) != 40000 {
        return 60
    }
    var n_items: usize = 0
    var c: u32 = xml.child(&d, xml.root(&d), "i")
    while c != xml.NONE {
        n_items = n_items + 1
        c = xml.next_named(&d, c, "i")
    }
    if n_items != 20000 {
        return 61
    }
    let last_i: u32 = xml.last(&d, xml.root(&d))
    let last_el: u32 = xml.parent(&d, last_i) // the text node's parent is the list
    if last_el != xml.root(&d) {
        return 62
    }
    var cnt: [u32; 1] = [0; 1]
    if xml.children_named(&d, xml.root(&d), "i", &cnt[0], 1) != 20000 {
        return 63
    }
    if !(xml.attr(&d, cnt[0], "n") == "0") || !(xml.text(&d, cnt[0]) == "v&0") {
        return 64
    }
    rt.buf_clear(&out)
    xml.write(&d, xml.root(&d), &out)
    var d3: xml.Doc = xml.doc_new()
    let again: bool = xml.parse(&d3, rt.buf_ptr(&out), rt.buf_len(&out)) catch false
    let kids: usize = xml.child_count(&d3, xml.root(&d3))
    xml.doc_free(&d3)
    if !again || kids != 40000 {
        return 65
    }
    return 0
}
