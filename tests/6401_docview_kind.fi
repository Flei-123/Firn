// expect_exit: 0
import std.rt
import std.testkit
import zip.zip
import image.picture
import docview.kind
import docview.kinds
import docview.doc
import docview.install
import docview.registry
import docview.lazy

static mut seed: u64 = 12345

fn rnd() -> u32 {
    seed = seed *% 6364136223846793005 +% 1442695040888963407
    return ((seed >> 33) & 2147483647) as u32
}

fn sniff_str(s: str, name: str) -> u32 {
    return kind.sniff(s.p as u64, s.n, name)
}

fn sniff_bytes(b: *mut rt.Buf, name: str) -> u32 {
    return kind.sniff(rt.buf_ptr(b), rt.buf_len(b), name)
}

fn push_all(b: *mut rt.Buf, a: u32, c: u32, d: u32, e: u32) {
    rt.buf_push(b, a as u8)
    rt.buf_push(b, c as u8)
    rt.buf_push(b, d as u8)
    rt.buf_push(b, e as u8)
}

fn make_zip(out: *mut rt.Buf, n1: str, n2: str) {
    var w: zip.ZipWriter = zip.zip_writer_new(out)
    zip.zip_add(&w, n1, "x".p as u64, 1, true) catch | e | (false)
    if n2.n > 0 {
        zip.zip_add(&w, n2, "y".p as u64, 1, true) catch | e | (false)
    }
    zip.zip_finish(&w) catch | e | (0 as usize)
    zip.zip_writer_free(&w)
}

#[test]
fn text_magic_kinds() {
    testkit.assert_eq_i64(sniff_str("%PDF-1.7\n", "x") as i64, kinds.KIND_PDF as i64)
    testkit.assert_eq_i64(sniff_str("GIF89a....", "x") as i64, kinds.KIND_GIF as i64)
    testkit.assert_eq_i64(sniff_str("RIFF\x00\x00\x00\x00WEBPVP8 ", "x") as i64, kinds.KIND_WEBP as i64)
    testkit.assert_eq_i64(sniff_str("RIFF\x00\x00\x00\x00WAVEfmt ", "x") as i64, kinds.KIND_WAV as i64)
    testkit.assert_eq_i64(sniff_str("fLaC\x00\x00\x00\x22", "x") as i64, kinds.KIND_FLAC as i64)
    testkit.assert_eq_i64(sniff_str("ID3\x04\x00\x00\x00\x00", "x") as i64, kinds.KIND_MP3 as i64)
    testkit.assert_eq_i64(sniff_str("OggS\x00\x02", "x") as i64, kinds.KIND_OGG as i64)
    testkit.assert_eq_i64(sniff_str("\x00\x00\x00\x18ftypmp42\x00\x00\x00\x00", "x") as i64, kinds.KIND_MP4 as i64)
    testkit.assert_eq_i64(sniff_str("\x00\x00\x00\x18ftypM4A \x00\x00\x00\x00", "x") as i64, kinds.KIND_M4A as i64)
    testkit.assert_eq_i64(sniff_str("\x00\x00\x00\x18ftypavif\x00\x00\x00\x00", "x") as i64, kinds.KIND_AVIF as i64)
    testkit.assert_eq_i64(sniff_str("\x00\x00\x00\x0cJXL \x0d\x0a\x00\x0a", "x") as i64, kinds.KIND_JXL as i64)
}

#[test]
fn binary_magic_kinds() {
    var b: rt.Buf = rt.buf_new()
    push_all(&b, 137, 80, 78, 71)
    testkit.assert_eq_i64(sniff_bytes(&b, "") as i64, kinds.KIND_PNG as i64)
    rt.buf_clear(&b)
    push_all(&b, 255, 216, 255, 224)
    testkit.assert_eq_i64(sniff_bytes(&b, "") as i64, kinds.KIND_JPEG as i64)
    rt.buf_clear(&b)
    push_all(&b, 26, 69, 223, 163)
    testkit.assert_eq_i64(sniff_bytes(&b, "") as i64, kinds.KIND_WEBM as i64)
    rt.buf_clear(&b)
    push_all(&b, 255, 10, 0, 0)
    testkit.assert_eq_i64(sniff_bytes(&b, "") as i64, kinds.KIND_JXL as i64)
    rt.buf_clear(&b)
    push_all(&b, 255, 251, 144, 100)
    testkit.assert_eq_i64(sniff_bytes(&b, "") as i64, kinds.KIND_MP3 as i64)
    rt.buf_free(&b)
}

#[test]
fn opus_inside_ogg() {
    testkit.assert_eq_i64(sniff_str("OggS\x00\x02\x00\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x13OpusHead\x01", "x") as i64, kinds.KIND_OPUS as i64)
}

#[test]
fn text_kinds_by_extension() {
    testkit.assert_eq_i64(sniff_str("# title\n", "README.md") as i64, kinds.KIND_MARKDOWN as i64)
    testkit.assert_eq_i64(sniff_str("fn main() {}\n", "a.rs") as i64, kinds.KIND_CODE as i64)
    testkit.assert_eq_i64(sniff_str("{\"a\":1}", "a.json") as i64, kinds.KIND_CODE as i64)
    testkit.assert_eq_i64(sniff_str("hello\n", "a.txt") as i64, kinds.KIND_TEXT as i64)
    testkit.assert_eq_i64(sniff_str("hello\n", "") as i64, kinds.KIND_TEXT as i64)
    testkit.assert_eq_i64(sniff_str("", "a.md") as i64, kinds.KIND_MARKDOWN as i64)
    testkit.assert_eq_i64(sniff_str("<svg xmlns=\"x\"></svg>", "a") as i64, kinds.KIND_SVG as i64)
    testkit.assert_eq_i64(sniff_str("<?xml version=\"1.0\"?>\n<svg></svg>", "a.xml") as i64, kinds.KIND_SVG as i64)
}

#[test]
fn binary_noise_is_unknown() {
    testkit.assert_eq_i64(sniff_str("\x01\x02\x03\x04\x05\x06", "a.bin") as i64, kinds.KIND_UNKNOWN as i64)
}

#[test]
fn zip_containers() {
    var b: rt.Buf = rt.buf_new()
    make_zip(&b, "word/document.xml", "")
    testkit.assert_eq_i64(sniff_bytes(&b, "a.docx") as i64, kinds.KIND_DOCX as i64)
    rt.buf_clear(&b)
    make_zip(&b, "xl/workbook.xml", "")
    testkit.assert_eq_i64(sniff_bytes(&b, "a.xlsx") as i64, kinds.KIND_XLSX as i64)
    rt.buf_clear(&b)
    make_zip(&b, "ppt/presentation.xml", "")
    testkit.assert_eq_i64(sniff_bytes(&b, "a.pptx") as i64, kinds.KIND_PPTX as i64)
    rt.buf_clear(&b)
    make_zip(&b, "mimetype", "content.xml")
    testkit.assert_eq_i64(sniff_bytes(&b, "a.odt") as i64, kinds.KIND_ODT as i64)
    rt.buf_clear(&b)
    make_zip(&b, "readme.txt", "")
    testkit.assert_eq_i64(sniff_bytes(&b, "a.zip") as i64, kinds.KIND_ZIP as i64)
    rt.buf_free(&b)
}

#[test]
fn family_and_names() {
    testkit.assert_eq_i64(kinds.kind_family(kinds.KIND_DOCX) as i64, kinds.FAMILY_DOCUMENT as i64)
    testkit.assert_eq_i64(kinds.kind_family(kinds.KIND_AVIF) as i64, kinds.FAMILY_IMAGE as i64)
    testkit.assert_eq_i64(kinds.kind_family(kinds.KIND_M4A) as i64, kinds.FAMILY_AUDIO as i64)
    testkit.assert_eq_i64(kinds.kind_family(kinds.KIND_WEBM) as i64, kinds.FAMILY_VIDEO as i64)
    testkit.assert_eq_i64(kinds.kind_family(kinds.KIND_CODE) as i64, kinds.FAMILY_TEXT as i64)
    testkit.assert_eq_str(kinds.kind_name(kinds.KIND_PDF), "pdf")
    testkit.assert_eq_str(kinds.kind_name(999 as u32), "unknown")
}

fn mutate(src: *mut rt.Buf, dst: *mut rt.Buf, mode: u32) {
    rt.buf_clear(dst)
    let n: usize = rt.buf_len(src)
    var keep: usize = n
    if mode == 1 as u32 && n > 0 {
        keep = (rnd() as usize) % n
    }
    var i: usize = 0
    while i < keep {
        var c: u8 = rt.buf_at(src, i)
        if mode == 0 as u32 && (rnd() % 16 as u32) == 0 as u32 {
            c = (rnd() & 255 as u32) as u8
        }
        rt.buf_push(dst, c)
        i++
    }
}

fn fuzz_one(b: *mut rt.Buf, names: *mut [str; 4]) {
    var k: usize = 0
    while k < 4 {
        kind.sniff(rt.buf_ptr(b), rt.buf_len(b), (*names)[k])
        k++
    }
    var kk: u32 = 0 as u32
    while kk < kinds.KIND_COUNT {
        var d: doc.Doc = doc.doc_open_kind(rt.buf_ptr(b), rt.buf_len(b), kk)
        if doc.doc_ok(&d) {
            var w: i32 = 0
            var h: i32 = 0
            var out: rt.Buf = rt.buf_new()
            doc.doc_page_size(&d, 0, &w, &h)
            doc.doc_text(&d, 0, &out)
            rt.buf_clear(&out)
            if w > 0 && h > 0 && w < 2000 && h < 2000 {
                doc.doc_render(&d, 0, 0.5, &out, &w, &h)
            }
            rt.buf_free(&out)
        }
        doc.doc_free(&d)
        kk = kk + 1 as u32
    }
}

fn seed_samples(out: *mut Vec[rt.Buf]) {
    var png: rt.Buf = rt.buf_new()
    var px: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < 16 * 16 * 4 {
        rt.buf_push(&px, ((i * 7) & 255) as u8)
        i++
    }
    var pic: picture.Picture = picture.from_rgba(rt.buf_ptr(&px), 16, 16)
    picture.encode(&pic, ".png", &png)
    var jpg: rt.Buf = rt.buf_new()
    picture.encode(&pic, ".jpg", &jpg)
    picture.free(&pic)
    rt.buf_free(&px)
    var zipb: rt.Buf = rt.buf_new()
    make_zip(&zipb, "word/document.xml", "a.txt")
    var txt: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&txt, "# head\nfn main() {}\n".p as u64, 20)
    vec_push[rt.Buf](out, png)
    vec_push[rt.Buf](out, jpg)
    vec_push[rt.Buf](out, zipb)
    vec_push[rt.Buf](out, txt)
}

#[test]
fn fuzz_never_crashes() {
    registry.registry_reset()
    lazy.lazy_reset()
    install.install_builtin()
    var samples: Vec[rt.Buf] = vec_new[rt.Buf]()
    seed_samples(&samples)
    var names: [str; 4] = ["a.png", "a.docx", "a.md", "a.rs"]
    var t: rt.Buf = rt.buf_new()
    var round: u32 = 0 as u32
    while round < 300 as u32 {
        let si: usize = (rnd() as usize) % vec_len[rt.Buf](&samples)
        let s: *mut rt.Buf = vec_elem_ptr[rt.Buf](&samples, si)
        mutate(s, &t, round % 3 as u32)
        fuzz_one(&t, &names)
        round = round + 1 as u32
    }
    var r: u32 = 0 as u32
    while r < 200 as u32 {
        rt.buf_clear(&t)
        let len: usize = (rnd() as usize) % 300
        var i: usize = 0
        while i < len {
            rt.buf_push(&t, (rnd() & 255 as u32) as u8)
            i++
        }
        fuzz_one(&t, &names)
        r = r + 1 as u32
    }
    testkit.assert_true(true, "survived")
}
