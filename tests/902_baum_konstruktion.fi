fn puffer_gleich(a: *mut mem.Buf, b: *mut mem.Buf) -> bool {
    let n: usize = mem.buf_len(a)
    if n != mem.buf_len(b) {
        return false
    }
    var i: usize = 0
    while i < n {
        if mem.buf_at(a, i) != mem.buf_at(b, i) {
            return false
        }
        i = i + 1
    }
    return true
}

fn eingabe(nr: usize, out: *mut mem.Buf) -> usize {
    if nr == 0 {
        return ein0(out)
    }
    if nr == 1 {
        return ein1(out)
    }
    if nr == 2 {
        return ein2(out)
    }
    if nr == 3 {
        return ein3(out)
    }
    if nr == 4 {
        return ein4(out)
    }
    if nr == 5 {
        return ein5(out)
    }
    if nr == 6 {
        return ein6(out)
    }
    if nr == 7 {
        return ein7(out)
    }
    return 0
}

fn erwartung(nr: usize, out: *mut mem.Buf) -> usize {
    if nr == 0 {
        return soll0(out)
    }
    if nr == 1 {
        return soll1(out)
    }
    if nr == 2 {
        return soll2(out)
    }
    if nr == 3 {
        return soll3(out)
    }
    if nr == 4 {
        return soll4(out)
    }
    if nr == 5 {
        return soll5(out)
    }
    if nr == 6 {
        return soll6(out)
    }
    if nr == 7 {
        return soll7(out)
    }
    return 0
}

fn fall(l: *mut treiber.Lauf, ein_b: *mut mem.Buf, soll_b: *mut mem.Buf,
        aus: *mut mem.Buf, nr: usize) -> bool {
    let n: usize = eingabe(nr, ein_b)
    treiber.lauf_text_aus_bytes(l, mem.buf_ptr(ein_b), n)
    if treiber.lauf_dokument_bauen(l) != 0 as u32 {
        return false
    }
    mem.buf_clear(aus)
    schreiben.baum_schreiben(treiber.lauf_namen(l), treiber.lauf_dokument(l), aus)
    let m: usize = erwartung(nr, soll_b)
    return puffer_gleich(aus, soll_b)
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    // Der `Lauf` liegt im Rahmen von `main`: der Stapelscan des Sammlers ist
    // konservativ und findet seine Gc-Zeiger nur dort (SPEC 3.5.3).
    var l: treiber.Lauf = treiber.lauf_neu()
    if !treiber.lauf_init(&l) {
        return 91
    }
    var ein_b: mem.Buf = mem.buf_neu()
    mem.buf_init(&ein_b)
    var soll_b: mem.Buf = mem.buf_neu()
    mem.buf_init(&soll_b)
    var aus: mem.Buf = mem.buf_neu()
    mem.buf_init(&aus)

    if !fall(&l, &ein_b, &soll_b, &aus, 0) {
        return 1
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 1) {
        return 2
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 2) {
        return 3
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 3) {
        return 4
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 4) {
        return 5
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 5) {
        return 6
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 6) {
        return 7
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 7) {
        return 8
    }

    // Zweiter Durchgang: derselbe `Lauf` traegt beliebig viele Dokumente,
    // und der Sammler darf dazwischen laufen. Waere der Baum eines fertigen
    // Dokuments noch am Zustand festgemacht, faende man es hier.
    gc_collect()
    if !fall(&l, &ein_b, &soll_b, &aus, 0) {
        return 1
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 1) {
        return 2
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 2) {
        return 3
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 3) {
        return 4
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 4) {
        return 5
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 5) {
        return 6
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 6) {
        return 7
    }
    if !fall(&l, &ein_b, &soll_b, &aus, 7) {
        return 8
    }

    treiber.lauf_frei(&l)
    mem.buf_free(&ein_b)
    mem.buf_free(&soll_b)
    mem.buf_free(&aus)
    return 0
}
