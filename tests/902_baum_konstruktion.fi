// expect_exit: 0
// tests/902_baum_konstruktion.fi — HTML-BAUMKONSTRUKTION (Runde 54).
//
// Faehrt den vollstaendigen Weg — Tokenizer (lib/html/) -> binaeres
// Tokenprotokoll -> Baumaufbau (lib/browser/baum.fi) -> Ausgabe im
// html5lib-Format — im Programm selbst, ohne Datei und ohne Harness. Damit
// ist die Baumkonstruktion Teil von `test.sh` und nicht nur von
// `tools/html/run.sh`.
//
// Die acht Faelle sind woertlich aus tools/html/faelle/*.dat uebernommen;
// ihre Erwartungen sind dort gegen html5lib 1.1 geprueft (tools/html/orakel.py,
// docs/RUNDE54.md). Geprueft wird, woran der Aufbau wirklich haengt:
//
//   0  Grundgeruest mit head/body und RCDATA-Titel
//   1  das Adoption-Agency-Verfahren (das Lehrbuchbeispiel des Standards)
//   2  Formatierung ueber eine Tabelle hinweg (foster parenting)
//   3  foster parenting fuer Text vor der ersten Zeile
//   4  RCDATA: der Baumaufbau schaltet den Tokenizer um
//   5  drei Umschaltungen hintereinander (title, style, script)
//   6  "in select"
//   7  implizites Schliessen von Listenelementen
//
// Der Rueckgabewert nennt den ersten Fall, der abweicht (1..8).

import html.mem
import browser.knoten
import browser.treiber
import browser.schreiben

#[no_gc]
fn ein0(out: *mut mem.Buf) -> usize {
    var t: [u8; 36] = "<head><title>T</title></head><body>b"
    mem.buf_clear(out)
    var i: usize = 0
    while i < 36 {
        mem.buf_push(out, t[i])
        i = i + 1
    }
    return 36
}

#[no_gc]
fn soll0(out: *mut mem.Buf) -> usize {
    var t: [u8; 67] = "| <html>\n|   <head>\n|     <title>\n|       \"T\"\n|   <body>\n|     \"b\"\n"
    mem.buf_clear(out)
    var i: usize = 0
    while i < 67 {
        mem.buf_push(out, t[i])
        i = i + 1
    }
    return 67
}

