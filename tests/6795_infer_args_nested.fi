// expect_exit: 28
enum Opt[T] { Some(T), None }
enum Res[T, E] { Ok(T), Err(E) }

struct P { x: i32 }
fn mk() -> P { return P { x: 8 } }
fn wrap[T](v: T) -> Opt[T] { return Opt::Some(v) }
fn id[T](v: T) -> T { return v }
fn lens[T](v: *T) -> i32 { return 3 }

fn f64ish() -> Opt[i64] { return Opt::Some(5) }

fn main() -> i32 {
    var total: i32 = 0
    let a = Opt::Some(mk())
    match a {
        Opt::Some(p) => { total = total + p.x }
        Opt::None => { total = total + 100 }
    }
    let b = wrap(6)
    match b {
        Opt::Some(p) => { total = total + p }
        Opt::None => { total = total + 100 }
    }
    let s: Res[i32, str] = Res::Err("bad")
    match s {
        Res::Ok(v) => { total = total + 100 }
        Res::Err(e) => { total = total + 1 }
    }
    match f64ish() {
        Opt::Some(p) => { total = total + (p as i32) }
        Opt::None => { total = total + 100 }
    }
    let q = P { x: 1 }
    total = total + lens(&q)
    total = total + id(2 + 3)
    return total
}
