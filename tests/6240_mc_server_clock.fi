// expect_exit: 0
import std.rt
import mc.server.sv_clock

static mut g_fail: i32 = 0

fn check(ok: bool, msg: str) {
    if !ok {
        var o: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&o, "FAIL ".p as u64, 5)
        rt.buf_push_bytes(&o, msg.p as u64, msg.n)
        rt.buf_push(&o, 10)
        rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
        rt.buf_free(&o)
        g_fail = g_fail + 1
    }
}

fn main() -> i32 {
    var c: sv_clock.TickClock = sv_clock.clock_new(1000000)
    var now: i64 = 1000000
    var bm: i64 = 0
    var bt: i64 = 0
    check(sv_clock.clock_due(&c, now), "first tick due immediately")
    check(!sv_clock.clock_overload_check(&c, now, &bm, &bt), "no overload at start")
    var i: i32 = 0
    while i < 200 {
        sv_clock.clock_tick_done(&c, 10000 as u64)
        now = now + 50
        i = i + 1
    }
    check(c.next_tick == 1000000 + 200 * 50, "next tick advances by 50 ms per tick")
    check(sv_clock.clock_avg_us(&c) == 10000 as u64, "avg tick time over window")
    check(sv_clock.clock_tps_x100(&c) == 2000 as u64, "tps capped at 20")
    check(sv_clock.clock_wait_ms(&c, now) == 0, "wait is zero when exactly due")
    check(sv_clock.clock_wait_ms(&c, now - 30) == 30, "wait until next tick")

    var d: sv_clock.TickClock = sv_clock.clock_new(5000)
    var t: i64 = 5000
    var ticks_run: i32 = 0
    var warned: i32 = 0
    while t < 5000 + 60000 {
        if sv_clock.clock_overload_check(&d, t, &bm, &bt) {
            warned = warned + 1
            check(bm > 2000, "behind more than 2000")
            check(bt == bm / 50, "ticks behind = ms / 50")
        }
        if sv_clock.clock_due(&d, t) {
            t = t + 80
            sv_clock.clock_tick_done(&d, 80000 as u64)
            ticks_run = ticks_run + 1
        } else {
            t = t + sv_clock.clock_wait_ms(&d, t)
        }
    }
    check(warned >= 2 && warned <= 5, "overload warned a few times, cooldown 15 s")
    check(d.skipped_ticks > 0, "ticks were skipped")
    check(sv_clock.clock_tps_x100(&d) == 100000000 as u64 / 80000 as u64, "tps follows tick time")
    check(sv_clock.clock_tps_x100(&d) < 2000 as u64, "tps below 20 when slow")

    var e: sv_clock.TickClock = sv_clock.clock_new(0)
    check(!sv_clock.clock_overload_check(&e, 2000, &bm, &bt), "exactly 2000 ms is not over the limit")
    check(sv_clock.clock_overload_check(&e, 2001, &bm, &bt), "2001 ms behind warns")
    check(bm == 2001 && bt == 40, "reported 2001 ms / 40 ticks")
    check(e.next_tick == 2000, "next tick jumped by 40 ticks")
    check(!sv_clock.clock_overload_check(&e, 20000, &bm, &bt) || e.next_tick - 2000 >= 0, "cooldown guard evaluated")
    var f: sv_clock.TickClock = sv_clock.clock_new(0)
    sv_clock.clock_overload_check(&f, 3000, &bm, &bt)
    var k: i32 = 0
    while k < 299 {
        sv_clock.clock_tick_done(&f, 1000 as u64)
        k = k + 1
    }
    check(!sv_clock.clock_overload_check(&f, 100000, &bm, &bt), "no second warning inside 15 s of schedule time")
    sv_clock.clock_tick_done(&f, 1000 as u64)
    check(sv_clock.clock_overload_check(&f, 100000, &bm, &bt), "second warning after 15 s of schedule time")

    var m: rt.Buf = rt.buf_new()
    sv_clock.clock_overload_message(&m, 2001, 40)
    var want: str = "Can't keep up! Is the server overloaded? Running 2001ms or 40 ticks behind"
    check(rt.buf_len(&m) == want.n && rt.mem_eq(rt.buf_ptr(&m), want.p as u64, want.n), "message text like vanilla")
    rt.buf_free(&m)

    if g_fail == 0 {
        rt.write_everything(1, "ok\n".p as u64, 3)
    }
    return g_fail
}
