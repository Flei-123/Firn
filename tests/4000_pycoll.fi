// expect_exit: 0
// tests/4000_pycoll.fi -- std.pycoll: stable sort_by / key sorts (reverse keeps
// ties in order), dict_items_sorted, dict_values, group_by, count_by, dict_ref.
import std.io
import std.rt
import std.dict
import std.pycoll
import std.str
import std.vec
import std.testkit

struct Row { region: str, amount: f64, id: i64 }

fn region_of(r: *Row) -> str { return (*r).region }
fn amount_of(r: *Row) -> f64 { return (*r).amount }
fn id_of(r: *Row) -> i64 { return (*r).id }
fn amount_less(a: *Row, b: *Row) -> bool { return (*a).amount < (*b).amount }

fn ids(v: *mut Vec[Row]) -> str {
    var b: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < vec_len[Row](v) {
        io.fmt_content(f"{(*vec_elem_ptr[Row](v, i)).id},", &b)
        i = i + 1
    }
    let s: str = __str_copy(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    rt.buf_free(&b)
    return s
}

fn mk(region: str, amount: f64, id: i64) -> Row { return Row { region: region, amount: amount, id: id } }

fn main() -> i32 {
    if !gc_init() { return 1 }
    var rows: Vec[Row] = vec_new[Row]()
    vec_push[Row](&rows, mk("b", 2.0, 0))
    vec_push[Row](&rows, mk("a", 1.0, 1))
    vec_push[Row](&rows, mk("b", 2.0, 2))
    vec_push[Row](&rows, mk("c", 3.0, 3))
    vec_push[Row](&rows, mk("a", 1.0, 4))
    sort_key_f64[Row](&rows, amount_of, false)
    testkit.check(ids(&rows) == "1,4,0,2,3,", "ascending is stable")
    sort_key_f64[Row](&rows, amount_of, true)
    testkit.check(ids(&rows) == "3,0,2,1,4,", "reverse keeps ties in order")
    sort_key_i64[Row](&rows, id_of, false)
    testkit.check(ids(&rows) == "0,1,2,3,4,", "i64 key")
    sort_key_str[Row](&rows, region_of, true)
    testkit.check(ids(&rows) == "3,0,2,1,4,", "str key reverse")
    sort_key_str[Row](&rows, region_of, false)
    testkit.check(ids(&rows) == "1,4,0,2,3,", "str key")
    sort_key_i64[Row](&rows, id_of, false)
    sort_stable_by[Row](&rows, amount_less)
    testkit.check(ids(&rows) == "1,4,0,2,3,", "sort_stable_by")

    var groups: Dict[Vec[Row]] = dict_new[Vec[Row]]()
    group_by[Row](&rows, region_of, &groups)
    testkit.check(dict_len[Vec[Row]](&groups) == 3, "3 groups")
    var ks: Vec[str] = vec_new[str]()
    dict_keys[Vec[Row]](&groups, &ks)
    testkit.check(*vec_elem_ptr[str](&ks, 0) == "a" && *vec_elem_ptr[str](&ks, 1) == "b" && *vec_elem_ptr[str](&ks, 2) == "c", "first-seen order")
    let gb: *mut Vec[Row] = dict_val_ptr[Vec[Row]](&groups, "b")
    testkit.check(vec_len[Row](gb) == 2 && ids(gb) == "0,2,", "group b")
    var vals: Vec[Vec[Row]] = vec_new[Vec[Row]]()
    dict_values[Vec[Row]](&groups, &vals)
    testkit.check(vec_len[Vec[Row]](&vals) == 3, "values")
    groups_free[Row](&groups)

    var cnt: Dict[i64] = dict_new[i64]()
    count_by[Row](&rows, region_of, &cnt)
    testkit.check(dict_get[i64](&cnt, "a") == 2 && dict_get[i64](&cnt, "c") == 1, "count_by")
    var items: Vec[DictItem[i64]] = vec_new[DictItem[i64]]()
    dict_set[i64](&cnt, "0", 9)
    dict_items_sorted[i64](&cnt, &items)
    testkit.check(vec_len[DictItem[i64]](&items) == 4 && (*vec_elem_ptr[DictItem[i64]](&items, 0)).key == "0" && (*vec_elem_ptr[DictItem[i64]](&items, 3)).key == "c", "items_sorted")
    dict_free[i64](&cnt)

    var dd: Dict[Row] = dict_new[Row]()
    let p: *mut Row = dict_ref[Row](&dd, "x", mk("x", 0.0, 0))
    (*p).amount = (*p).amount + 5.0
    let q: *mut Row = dict_ref[Row](&dd, "x", mk("zz", 9.0, 9))
    testkit.check((*q).amount == 5.0 && dict_len[Row](&dd) == 1, "dict_ref setdefault")
    dict_free[Row](&dd)
    return testkit.finish()
}
