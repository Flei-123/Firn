// expect_exit: 0
// tests/4202_str_slice_step.fi -- r738: pystr.slice_step(s, a, b, c) = Python s[a:b:c] (octets, owning copy).
import std.rt
import std.str
import std.pystr
import std.testkit

fn main() -> i32 {
    if !gc_init() { return 1 }
    let s: str = "hello world"
    let omit: i64 = 9223372036854775806
    testkit.check(pystr.slice_step(s, omit, omit, 2) == "hlowrd", "every second")
    testkit.check(pystr.slice_step(s, omit, omit, -1) == "dlrow olleh", "reverse")
    testkit.check(pystr.slice_step(s, 1, 8, 3) == "eoo", "range with step")
    testkit.check(pystr.slice_step(s, -1, -5, -2) == "dr", "negative step range")
    testkit.check(pystr.slice_step(s, 100, omit, -4) == "dwl", "clamped start, negative step")
    testkit.check(pystr.slice_step(s, 5, 2, 1) == "", "empty")
    testkit.check(pystr.slice_step("", omit, omit, -1) == "", "empty text")
    // an owned copy: not a view of s
    let t: str = pystr.slice_step(s, omit, omit, 1)
    testkit.check(t == s && t.p != s.p, "copy")
    return testkit.finish()
}
