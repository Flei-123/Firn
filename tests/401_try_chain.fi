// expect_exit: 0
// 'try' passes the error up unchanged -- across two levels.
error E { A, B }

fn stage0(n: i32) -> E!i32 {
    if n == 0 {
        return E::B
    }
    return n
}

fn stage1(n: i32) -> E!i32 {
    let v = try stage0(n)
    return v * 2
}

fn stage2(n: i32) -> E!i32 {
    let v = try stage1(n)
    return v + 1
}

fn main() -> i32 {
    if (stage2(3) catch 0) != 7 {
        return 1
    }
    if (stage2(0) catch 0 - 5) != 0 - 5 {
        return 2
    }
    return 0
}
