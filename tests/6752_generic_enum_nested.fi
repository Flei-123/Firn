// expect_exit: 0
struct Point { x: i32, y: i32 }

enum Pair[A, B] { Both(A, B), First(A), Second(B), Empty }
enum Tree[T] { Leaf(T), Node(Tree[T], T) }
enum Wrap[T] { Item(T), Nothing }

fn pick(n: i32) -> Pair[i32, f64] {
    if n == 0 { return Pair::Empty }
    if n == 1 { return Pair::First(10) }
    if n == 2 { return Pair::Second(2.5) }
    return Pair::Both(3, 4.5)
}

fn score(p: Pair[i32, f64]) -> i32 {
    var s: i32 = 0
    match p {
        Pair::Both(a, b) => { s = a + (b as i32) }
        Pair::First(a) => { s = a }
        Pair::Second(b) => { s = (b as i32) + 100 }
        Pair::Empty => { s = 1000 }
    }
    return s
}

fn point_sum(w: Wrap[Point]) -> i32 {
    match w {
        Wrap::Item(p) => { return p.x + p.y }
        Wrap::Nothing => { return 0 - 1 }
    }
    return 0
}

fn nested(w: Wrap[Wrap[i32]]) -> i32 {
    match w {
        Wrap::Item(Wrap::Item(v)) => { return v }
        Wrap::Item(_) => { return 2 }
        Wrap::Nothing => { return 3 }
    }
    return 0
}

fn main() -> i32 {
    if score(pick(0)) != 1000 { return 1 }
    if score(pick(1)) != 10 { return 2 }
    if score(pick(2)) != 102 { return 3 }
    if score(pick(3)) != 7 { return 4 }
    let p: Wrap[Point] = Wrap[Point]::Item(Point { x: 3, y: 4 })
    if point_sum(p) != 7 { return 5 }
    let q: Wrap[Point] = Wrap::Nothing
    if point_sum(q) != 0 - 1 { return 6 }
    let inner: Wrap[i32] = Wrap::Item(42)
    let outer: Wrap[Wrap[i32]] = Wrap::Item(inner)
    if nested(outer) != 42 { return 7 }
    let outer2: Wrap[Wrap[i32]] = Wrap::Item(Wrap::Nothing)
    if nested(outer2) != 2 { return 8 }
    return 0
}
