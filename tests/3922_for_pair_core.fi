// expect_exit: 0
// tests/3922_for_pair_core.fi -- enumerate / zip over arrays and str (core subset: runs through
// firnc1 as well, so sema_compare / fir_compare / parser_compare see the desugared tree).
import std.io
import std.rt
import std.testkit

fn main() -> i32 {
    if !gc_init() { return 1 }
    let arr: [i32; 4] = [5, 6, 7, 8]
    let brr: [i64; 3] = [10, 20, 30]
    var idx_sum: usize = 0
    var last: i32 = 0
    for (i, a) in enumerate(arr) {
        idx_sum += i
        if a == 7 { last = a + i as i32 }
    }
    testkit.check(idx_sum == 6 && last == 9, "enumerate array")
    var dot: i64 = 0
    var n: i32 = 0
    for (a, b) in zip(arr, brr) {
        dot += a as i64 * b
        n += 1
    }
    testkit.check(dot == 50 + 120 + 210 && n == 3, "zip shorter second")
    n = 0
    for (b, a) in zip(brr, arr) {
        if n == 1 { continue }
        n += 2
        if b > 10 { break }
    }
    testkit.check(n == 4, "zip break / continue")
    let s: str = "abc"
    var code: u64 = 0
    for (i, c) in enumerate(s) {
        code = code * 256 + c as u64 + i as u64
    }
    testkit.check(code == (97 * 256 + 99) * 256 + 101, "enumerate str bytes")
    var cnt: i32 = 0
    for (i, x) in enumerate(arr) {
        for (j, y) in zip(arr, brr) {
            if y > 20 { break }
            cnt += 1
        }
    }
    testkit.check(cnt == 8, "nested")
    return testkit.finish()
}
