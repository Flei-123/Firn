// expect_exit: 36
// ROUND REF2: the inclusive range 'for i in a..=b'. The end value is part of the range; the
// last step stops BEFORE incrementing, so '250u8..=255u8' ends instead of wrapping to 0.
fn main() -> i32 {
    var n: i32 = 0
    for i in 0 as i32..=5 as i32 { n = n + i }
    // 15
    var c: i32 = 0
    for b in 250 as u8..=255 as u8 { c = c + 1 }
    // 6 values, and no wrap-around to 0
    var e: i32 = 0
    for k in 5 as i32..=4 as i32 { e = e + 100 }
    // empty range
    var s: i32 = 0
    for j in 0 as i32..=3 as i32 {
        if j == 1 { continue }
        s = s + j
    }
    // 0 + 2 + 3 = 5
    for m in 1 as i64..=1 as i64 { s = s + 10 }
    return n + c + e + s
}
