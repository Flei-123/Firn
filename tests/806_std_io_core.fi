// expect_out: io: lines 5 sum 21 without 3/123 file 33 fmt 68 caught 11 abc
// tests/806_std_io_core.fi -- lines, files and the extended Fmt builder
// of `std.io` (round 42).
//
// Three parts:
//   1. files: write, APPEND (O_APPEND -- the difference between a log and
//      a lost log), do they exist?
//   2. lines: the cursor `LineReader` over a block that has been read --
//      \r\n is cleaned away, a trailing \n produces NO empty
//      final line.
//   3. Fmt: characters, bool, u64, hex, C text, repetition, width,
//      chaining two builders, content into a buffer.
//
// The functions that write a LINE BREAK themselves (`println`,
// `print_line`, `fmt_print_line`) cannot be put in the middle of a
// single-line test output. They are therefore REALLY executed, but with a
// redirected descriptor 1: `dup`/`dup2` push stdout into a file for a
// moment, and afterwards what is in it is checked. Nothing left out,
// no claim without measurement.
import std.io
import std.rt

const SYS_DUP: i64 = 32
const SYS_DUP2: i64 = 33
const NR_OPEN: i64 = 2
const NR_CLOSE: i64 = 3
const O_WRITE: i64 = 577
const RECHTE: i64 = 493

fn main() -> i32 {
    var path: [u8; 24] = "/tmp/firn806_zeilen.txt\0"
    var path2: [u8; 24] = "/tmp/firn806_stdout.txt\0"
    var missing: [u8; 26] = "/tmp/firn806_gibtsnicht.x\0"
    var part1: [u8; 21] = "eins\r\nzwei\ndrei\nvier\n"
    var part2: [u8; 6] = "fuenf\n"

    // --- 1. files
    if !io.write_file((&path[0]) as u64, (&part1[0]) as u64, 21) {
        return 10
    }
    if !io.append_file((&path[0]) as u64, (&part2[0]) as u64, 6) {
        return 11
    }
    if !io.file_exists((&path[0]) as u64) {
        return 12
    }
    if io.file_exists((&missing[0]) as u64) {
        return 13
    }
    var b: rt.Buf = rt.buf_new()
    if !io.read_file((&path[0]) as u64, &b) {
        return 14
    }
    if rt.buf_len(&b) != 27 {
        return 15
    }
    // Appending twice must not overwrite.
    if !io.append_file((&path[0]) as u64, (&part2[0]) as u64, 6) {
        return 16
    }
    var b2: rt.Buf = rt.buf_new()
    io.read_file((&path[0]) as u64, &b2)
    let file_len: usize = rt.buf_len(&b2)
    if file_len != 33 {
        return 17
    }
    rt.buf_free(&b2)

    // --- 2. lines
    var z: io.LineReader = io.lines_of_buf(&b)
    var p: u64 = 0
    var n: usize = 0
    var lines: usize = 0
    var sum: usize = 0
    while io.lines_next(&z, &p, &n) {
        lines = lines + 1
        sum = sum + n
    }
    // "eins" (the \r falls away), "zwei", "drei", "vier", "fuenf"
    if lines != 5 {
        return 20
    }
    if sum != 21 {
        return 21
    }
    if io.lines_number(rt.buf_ptr(&b), rt.buf_len(&b)) != 5 {
        return 22
    }
    // Without a trailing line break the last line is still a line.
    var without: [u8; 9] = "a\nbb\nccc\0"
    var z2: io.LineReader = io.lines_new((&without[0]) as u64, 8)
    var lengths: usize = 0
    var k: usize = 0
    while io.lines_next(&z2, &p, &n) {
        k = k + 1
        lengths = lengths * 10 + n
    }
    if k != 3 || lengths != 123 {
        return 23
    }
    if io.lines_number((&without[0]) as u64, 0) != 0 {
        return 24
    }
    rt.buf_free(&b)

    // --- 3. Fmt
    var f: io.Fmt = io.fmt_new()
    f = io.fmt_char(f, 65 as u8)
    f = io.fmt_bool(f, true)
    f = io.fmt_bool(f, false)
    f = io.fmt_u64(f, 18446744073709551615)
    f = io.fmt_hex(f, 48879, 6)
    f = io.fmt_repeat(f, 46 as u8, 3)
    f = io.fmt_wide(f, 0 - 42, 6, 32 as u8)
    f = io.fmt_c(f, (&path[0]) as u64)
    // ROUND 69: the two bool words are 'true' (4) and 'false' (5) -- they
    // were German before (`wahr`/`falsch`, 4 + 6).
    let expected: usize = 1 + 4 + 5 + 20 + 6 + 3 + 6 + 23
    if io.fmt_len(f) != expected {
        return 30
    }
    var buffer: rt.Buf = rt.buf_new()
    io.fmt_content(f, &buffer)
    if rt.buf_len(&buffer) != expected {
        return 31
    }
    if rt.buf_at(&buffer, 0) != 65 as u8 {
        return 32
    }
    // 't' of the true word, 'f' of the false word
    if rt.buf_at(&buffer, 1) != 116 as u8 || rt.buf_at(&buffer, 5) != 102 as u8 {
        return 33
    }
    // fmt_hex pads on the left with zeros: 48879 = beef -> "00beef"
    if rt.buf_at(&buffer, 30) != 48 as u8 || rt.buf_at(&buffer, 32) != 98 as u8 {
        return 34
    }
    // fmt_wide is right aligned: three padding characters before "-42"
    if rt.buf_at(&buffer, 39) != 32 as u8 || rt.buf_at(&buffer, 42) != 45 as u8 {
        return 35
    }
    rt.buf_free(&buffer)

    // Chain two builders; the second one is freed while doing so.
    var g: io.Fmt = io.fmt_append(f"a={1 + 1}", f" b={7}")
    if io.fmt_len(g) != 7 {
        return 36
    }
    var p2: rt.Buf = rt.buf_new()
    io.fmt_content(g, &p2)
    if rt.buf_at(&p2, 2) != 50 as u8 || rt.buf_at(&p2, 6) != 55 as u8 {
        return 37
    }
    rt.buf_free(&p2)
    // Write into a file and free the builder while doing so.
    // FINDING of round 42 (no compiler change, only named): an `f"..."`
    // directly in the CONDITION of an `if` reports "unknown name '_fsegN'" --
    // the hidden text segments are hoisted in front of the statement, and the
    // condition is evaluated before the body block. An intermediate value
    // solves it; the case is written down in docs/ROUND42.md.
    let content: io.Fmt = f"zahl {255}"
    if !io.fmt_in_file(content, (&path2[0]) as u64) {
        return 38
    }
    var p3: rt.Buf = rt.buf_new()
    io.read_file((&path2[0]) as u64, &p3)
    if rt.buf_len(&p3) != 8 {
        return 39
    }
    rt.buf_free(&p3)

    // --- the line writers, with a redirected descriptor 1
    var abc: [u8; 3] = "abc"
    var cd: [u8; 3] = "cd\0"
    let saved: i64 = syscall(SYS_DUP, 1, 0, 0, 0, 0, 0)
    if saved < 0 {
        return 40
    }
    let fd: i64 = syscall(NR_OPEN, (&path2[0]) as i64, O_WRITE, RECHTE, 0, 0, 0)
    if fd < 0 {
        return 41
    }
    syscall(SYS_DUP2, fd, 1, 0, 0, 0, 0)
    io.print_line_bytes((&abc[0]) as u64, 3)
    io.new_line()
    io.fmt_print_line(f"x={7}")
    io.print_c((&cd[0]) as u64)
    syscall(SYS_DUP2, saved, 1, 0, 0, 0, 0)
    syscall(NR_CLOSE, fd, 0, 0, 0, 0, 0)
    syscall(NR_CLOSE, saved, 0, 0, 0, 0, 0)

    var caught: rt.Buf = rt.buf_new()
    if !io.read_file((&path2[0]) as u64, &caught) {
        return 42
    }
    // "abc\n" + "\n" + "x=7\n" + "cd"
    if rt.buf_len(&caught) != 11 {
        return 43
    }
    if rt.buf_at(&caught, 3) != 10 as u8 || rt.buf_at(&caught, 4) != 10 as u8 {
        return 44
    }
    if rt.buf_at(&caught, 7) != 55 as u8 || rt.buf_at(&caught, 8) != 10 as u8 {
        return 45
    }
    if rt.buf_at(&caught, 10) != 100 as u8 {
        return 46
    }
    let caught_len: usize = rt.buf_len(&caught)
    rt.buf_free(&caught)

    // touch the stderr paths once (not part of the compared output).
    io.eprint_line_bytes((&abc[0]) as u64, 3)
    io.eprint_c((&cd[0]) as u64)
    io.fmt_eprint(f"e{1}")
    io.fmt_eprint_line(f"e{2}")
    io.print_fd(2, (&abc[0]) as u64, 3)

    io.fmt_print(f"io: lines {lines} sum {sum} without {k}/{lengths} ")
    io.fmt_print(f"file {file_len} fmt {expected} caught {caught_len} ")
    io.print_line_bytes((&abc[0]) as u64, 3)
    return 0
}
