// expect_out: io: zeilen 5 summe 21 ohne 3/123 datei 33 fmt 69 gefangen 11 abc
// tests/806_std_io_core.fi — Zeilen, Dateien und der ausgebaute Fmt-Builder
// von `std.io` (Runde 42).
//
// Drei Teile:
//   1. Dateien: schreiben, ANHAENGEN (O_APPEND — der Unterschied zwischen
//      einem Protokoll und einem verlorenen Protokoll), gibt es sie?
//   2. Zeilen: der Kursor `Zeilenleser` ueber einen gelesenen Block —
//      \r\n wird abgeraeumt, ein abschliessendes \n erzeugt KEINE leere
//      Schlusszeile.
//   3. Fmt: Zeichen, bool, u64, Hex, C-Text, Wiederholung, Breite,
//      Verketten zweier Builder, Inhalt in einen Puffer.
//
// Die Funktionen, die selbst einen ZEILENUMBRUCH schreiben (`println`,
// `print_zeile`, `fmt_druck_zeile`), lassen sich nicht mitten in eine
// einzeilige Testausgabe stellen. Sie werden deshalb WIRKLICH ausgefuehrt,
// aber mit umgebogenem Deskriptor 1: `dup`/`dup2` schieben stdout kurz in
// eine Datei, und danach wird geprueft, was drinsteht. Kein Weglassen,
// keine Behauptung ohne Messung.
import std.io
import std.rt

const SYS_DUP: i64 = 32
const SYS_DUP2: i64 = 33
const SYS_OEFFNEN: i64 = 2
const SYS_CLOSE: i64 = 3
const O_WRITE: i64 = 577
const RECHTE: i64 = 493

fn main() -> i32 {
    var path: [u8; 24] = "/tmp/firn806_zeilen.txt\0"
    var pfad2: [u8; 24] = "/tmp/firn806_stdout.txt\0"
    var missing: [u8; 26] = "/tmp/firn806_gibtsnicht.x\0"
    var teil1: [u8; 21] = "eins\r\nzwei\ndrei\nvier\n"
    var teil2: [u8; 6] = "fuenf\n"

    // --- 1. Dateien
    if !io.write_file((&path[0]) as u64, (&teil1[0]) as u64, 21) {
        return 10
    }
    if !io.append_file((&path[0]) as u64, (&teil2[0]) as u64, 6) {
        return 11
    }
    if !io.file_exists((&path[0]) as u64) {
        return 12
    }
    if io.file_exists((&missing[0]) as u64) {
        return 13
    }
    var b: rt.Buf = rt.buf_new()
    if !io.read_file((&path[0]) as u64, &b) {
        return 14
    }
    if rt.buf_len(&b) != 27 {
        return 15
    }
    // Zweimal anhaengen darf nicht ueberschreiben.
    if !io.append_file((&path[0]) as u64, (&teil2[0]) as u64, 6) {
        return 16
    }
    var b2: rt.Buf = rt.buf_new()
    io.read_file((&path[0]) as u64, &b2)
    let file_len: usize = rt.buf_len(&b2)
    if file_len != 33 {
        return 17
    }
    rt.buf_free(&b2)

    // --- 2. Zeilen
    var z: io.LineReader = io.lines_of_buf(&b)
    var p: u64 = 0
    var n: usize = 0
    var lines: usize = 0
    var sum: usize = 0
    while io.lines_next(&z, &p, &n) {
        lines = lines + 1
        sum = sum + n
    }
    // "eins" (das \r faellt weg), "zwei", "drei", "vier", "fuenf"
    if lines != 5 {
        return 20
    }
    if sum != 21 {
        return 21
    }
    if io.lines_number(rt.buf_ptr(&b), rt.buf_len(&b)) != 5 {
        return 22
    }
    // Ohne abschliessenden Umbruch bleibt die letzte Zeile trotzdem eine.
    var without: [u8; 9] = "a\nbb\nccc\0"
    var z2: io.LineReader = io.lines_new((&without[0]) as u64, 8)
    var lengths: usize = 0
    var k: usize = 0
    while io.lines_next(&z2, &p, &n) {
        k = k + 1
        lengths = lengths * 10 + n
    }
    if k != 3 || lengths != 123 {
        return 23
    }
    if io.lines_number((&without[0]) as u64, 0) != 0 {
        return 24
    }
    rt.buf_free(&b)

    // --- 3. Fmt
    var f: io.Fmt = io.fmt_new()
    f = io.fmt_char(f, 65 as u8)
    f = io.fmt_bool(f, true)
    f = io.fmt_bool(f, false)
    f = io.fmt_u64(f, 18446744073709551615)
    f = io.fmt_hex(f, 48879, 6)
    f = io.fmt_repeat(f, 46 as u8, 3)
    f = io.fmt_wide(f, 0 - 42, 6, 32 as u8)
    f = io.fmt_c(f, (&path[0]) as u64)
    let expected: usize = 1 + 4 + 6 + 20 + 6 + 3 + 6 + 23
    if io.fmt_len(f) != expected {
        return 30
    }
    var buffer: rt.Buf = rt.buf_new()
    io.fmt_content(f, &buffer)
    if rt.buf_len(&buffer) != expected {
        return 31
    }
    if rt.buf_at(&buffer, 0) != 65 as u8 {
        return 32
    }
    // "wahr" + "falsch"
    if rt.buf_at(&buffer, 1) != 119 as u8 || rt.buf_at(&buffer, 5) != 102 as u8 {
        return 33
    }
    // fmt_hex fuellt links mit Nullen auf: 48879 = beef -> "00beef"
    if rt.buf_at(&buffer, 31) != 48 as u8 || rt.buf_at(&buffer, 33) != 98 as u8 {
        return 34
    }
    // fmt_breit ist rechtsbuendig: drei Fuellzeichen vor "-42"
    if rt.buf_at(&buffer, 40) != 32 as u8 || rt.buf_at(&buffer, 43) != 45 as u8 {
        return 35
    }
    rt.buf_free(&buffer)

    // Zwei Builder verketten; der zweite wird dabei freigegeben.
    var g: io.Fmt = io.fmt_append(f"a={1 + 1}", f" b={7}")
    if io.fmt_len(g) != 7 {
        return 36
    }
    var p2: rt.Buf = rt.buf_new()
    io.fmt_content(g, &p2)
    if rt.buf_at(&p2, 2) != 50 as u8 || rt.buf_at(&p2, 6) != 55 as u8 {
        return 37
    }
    rt.buf_free(&p2)
    // In eine Datei schreiben und den Builder dabei freigeben.
    // BEFUND Runde 42 (keine Compileraenderung, nur benannt): ein `f"..."`
    // direkt in der BEDINGUNG eines `if` meldet "unbekannter name '_fsegN'" —
    // die versteckten Textsegmente werden vor die Anweisung gehoben, und die
    // Bedingung wird vor dem Rumpfblock ausgewertet. Ein Zwischenwert loest
    // es; in docs/RUNDE42.md steht der Fall.
    let content: io.Fmt = f"zahl {255}"
    if !io.fmt_in_file(content, (&pfad2[0]) as u64) {
        return 38
    }
    var p3: rt.Buf = rt.buf_new()
    io.read_file((&pfad2[0]) as u64, &p3)
    if rt.buf_len(&p3) != 8 {
        return 39
    }
    rt.buf_free(&p3)

    // --- die Zeilenschreiber, mit umgebogenem Deskriptor 1
    var abc: [u8; 3] = "abc"
    var cd: [u8; 3] = "cd\0"
    let saved: i64 = syscall(SYS_DUP, 1, 0, 0, 0, 0, 0)
    if saved < 0 {
        return 40
    }
    let fd: i64 = syscall(SYS_OEFFNEN, (&pfad2[0]) as i64, O_WRITE, RECHTE, 0, 0, 0)
    if fd < 0 {
        return 41
    }
    syscall(SYS_DUP2, fd, 1, 0, 0, 0, 0)
    io.println((&abc[0]) as u64, 3)
    io.print_line()
    io.fmt_print_line(f"x={7}")
    io.print_c((&cd[0]) as u64)
    syscall(SYS_DUP2, saved, 1, 0, 0, 0, 0)
    syscall(SYS_CLOSE, fd, 0, 0, 0, 0, 0)
    syscall(SYS_CLOSE, saved, 0, 0, 0, 0, 0)

    var caught: rt.Buf = rt.buf_new()
    if !io.read_file((&pfad2[0]) as u64, &caught) {
        return 42
    }
    // "abc\n" + "\n" + "x=7\n" + "cd"
    if rt.buf_len(&caught) != 11 {
        return 43
    }
    if rt.buf_at(&caught, 3) != 10 as u8 || rt.buf_at(&caught, 4) != 10 as u8 {
        return 44
    }
    if rt.buf_at(&caught, 7) != 55 as u8 || rt.buf_at(&caught, 8) != 10 as u8 {
        return 45
    }
    if rt.buf_at(&caught, 10) != 100 as u8 {
        return 46
    }
    let caught_len: usize = rt.buf_len(&caught)
    rt.buf_free(&caught)

    // stderr-Wege einmal anfassen (nicht Teil der verglichenen Ausgabe).
    io.eprintln((&abc[0]) as u64, 3)
    io.eprint_c((&cd[0]) as u64)
    io.fmt_eprint(f"e{1}")
    io.fmt_eprint_line(f"e{2}")
    io.print_fd(2, (&abc[0]) as u64, 3)

    io.fmt_print(f"io: zeilen {lines} summe {sum} ohne {k}/{lengths} ")
    io.fmt_print(f"datei {file_len} fmt {expected} gefangen {caught_len} ")
    io.println((&abc[0]) as u64, 3)
    return 0
}
