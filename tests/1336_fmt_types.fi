// expect_out: i8=-8 i16=-16 i32=-32 i64=-64 u8=200 u16=60000 u32=4000000000 u64=18446744073709551615 usize=7 isize=-7 | f=1.5 g=-0.25 big=1e+21 zero=0 bool=true/false str=text lit=quoted | 3 items, 2.5 each -> total 7.5 (true)
// tests/1336_fmt_types.fi -- `f"..."` WITH ALL TYPES (round 70).
//
// Up to round 69 the interpolation cast EVERY inserted value to `i64`
// (parser.rs: `io.fmt_number(chain, expr as i64)`). An f64 was therefore
// truncated (1.5 -> 1), a bool became 0/1, and a u64 above i64::MAX wrapped
// around into the negative.
//
// From now on the TYPE of the expression decides which builder step is
// taken: `fmt_number` for signed, `fmt_u64` for unsigned, `fmt_bool` for
// bool, `fmt_f64` (shortest decimal text with a round trip guarantee) for
// f64, and `fmt_str` for `str`.
import std.io

fn main() -> i32 {
    let a: i8 = -8 as i8
    let b: i16 = -16 as i16
    let c: i32 = -32
    let d: i64 = -64
    let e: u8 = 200 as u8
    let f: u16 = 60000 as u16
    let g: u32 = 4000000000 as u32
    let h: u64 = 18446744073709551615
    let i: usize = 7
    let j: isize = -7 as isize
    io.fmt_print(f"i8={a} i16={b} i32={c} i64={d} u8={e} u16={f} u32={g} u64={h} usize={i} isize={j} | ")

    let x: f64 = 1.5
    let y: f64 = -0.25
    let z: f64 = 1e21
    let n: f64 = 0.0
    let t: bool = true
    let fa: bool = false
    let s: str = "text"
    let q: str = "quoted"
    io.fmt_print(f"f={x} g={y} big={z} zero={n} bool={t}/{fa} str={s} lit={q} | ")

    let count: i32 = 3
    let each: f64 = 2.5
    let total: f64 = 7.5
    let ok: bool = true
    io.fmt_print_line(f"{count} items, {each} each -> total {total} ({ok})")
    return 0
}
