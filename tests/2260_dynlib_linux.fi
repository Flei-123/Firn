// expect_exit: 42
// Round FFI: std.dynlib on Linux. A static Firn program becomes a dynamically
// linked ELF (#[link_lib(c)]) and calls getpid / strlen / labs / floor through
// dlopen + dlsym. See docs/FFI.md.
import std.dynlib

fn main() -> i32 {
    let h: u64 = dynlib.open("libc.so.6")
    if h == 0 { return 1 }
    if dynlib.open("libdoesnotexist.so.9") != 0 { return 2 }
    let gp: u64 = dynlib.sym(h, "getpid")
    if gp == 0 { return 3 }
    if dynlib.sym(h, "no_such_symbol_xyz") != 0 { return 4 }
    if dynlib.ci0(gp) < 2 { return 5 }
    // strlen("hello!") through a pointer argument
    var s: [u8; 7] = "hello!\0"
    let sl: u64 = dynlib.sym(h, "strlen")
    if dynlib.ci1(sl, (&s[0]) as u64) != 6 { return 6 }
    // labs(-7): the integer argument travels as a 64 bit pattern
    let la: u64 = dynlib.sym(h, "labs")
    let neg: i64 = 0 - 7
    if dynlib.ci1(la, neg as u64) != 7 { return 7 }
    // libm: a double in, a double out
    let hm: u64 = dynlib.open("libm.so.6")
    if hm == 0 { return 8 }
    let fl: u64 = dynlib.sym(hm, "floor")
    var a: [u64; 4] = [0; 4]
    a[0] = __bits(3.75) as u64
    let r: u64 = dynlib.callx(fl, "d", (&a[0]) as u64, true)
    if __f64_from_bits(r) != 3.0 { return 9 }
    // two floats and an int: ldexp(1.5, 4) = 24
    let ld: u64 = dynlib.sym(hm, "ldexp")
    a[0] = __bits(1.5) as u64
    a[1] = 4
    let r2: u64 = dynlib.callx(ld, "di", (&a[0]) as u64, true)
    if __f64_from_bits(r2) != 24.0 { return 10 }
    // too many integer arguments are refused, not mis-called
    if dynlib.callx(gp, "iiiiiiiiiiiii", (&a[0]) as u64, false) != 0 { return 11 }
    if !dynlib.close(hm) { return 12 }
    return 42
}
