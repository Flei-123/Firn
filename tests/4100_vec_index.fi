// expect_exit: 0
// tests/4100_vec_index.fi -- r724: `v[i]` on Vec[T] / str, bounds-checked, Python negative index, assignment.
import std.io
import std.rt
import std.vec
import std.str
import std.testkit

struct P {
    a: i32,
    b: i32,
}

fn sum_ptr(v: *mut Vec[i64]) -> i64 {
    var s: i64 = 0
    var i: usize = 0
    while i < vec_len[i64](v) {
        s = s + v[i]
        i = i + 1
    }
    return s
}

fn last_of(v: *mut Vec[i32]) -> i32 {
    return v[-1]
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var v: Vec[i32] = vec_new[i32]()
    var i: i32 = 0
    while i < 5 {
        vec_push[i32](&v, i * 10)
        i = i + 1
    }
    testkit.check(v[0] == 0 && v[4] == 40, "plain index")
    testkit.check(v[-1] == 40 && v[-5] == 0 && v[-2] == 30, "negative index")
    v[2] = 99
    v[-1] = 7
    testkit.check(v[2] == 99 && v[4] == 7, "assignment")
    let k: usize = 3
    testkit.check(v[k] == 30, "usize index")
    let j: i32 = 1
    testkit.check(v[j] == 10 && v[j - 2] == 7, "i32 index expression")
    let b: u8 = 2
    testkit.check(v[b] == 99, "u8 index")
    v[1] += 5
    testkit.check(v[1] == 15, "compound assignment")
    testkit.check(last_of(&v) == 7, "through a pointer")

    var w: Vec[i64] = vec_new[i64]()
    vec_push[i64](&w, 1)
    vec_push[i64](&w, 2)
    vec_push[i64](&w, 3)
    testkit.check(sum_ptr(&w) == 6, "pointer parameter, loop")

    var ps: Vec[P] = vec_new[P]()
    vec_push[P](&ps, P { a: 1, b: 2 })
    vec_push[P](&ps, P { a: 3, b: 4 })
    testkit.check(ps[1].b == 4 && ps[-2].a == 1, "struct element field")
    ps[0].a = 11
    testkit.check(ps[0].a == 11, "field assignment through index")

    let s: str = "abc"
    testkit.check(s[0] == 97 && s[1] == 98 && s[-1] == 99, "str octets")
    testkit.check(s[-3] == 97, "str negative")
    return testkit.finish()
}
