// expect_exit: 10
// Runde 52: alle vier MMIO-Breiten auf demselben Puffer. 8+16+32+64 Bit,
// jeweils schreiben und wieder lesen; die Summe ist 1+2+3+4 = 10.
fn main() -> i32 {
    var b: [u64; 4] = [0, 0, 0, 0]
    let p8: *mut u8 = (&b[0]) as *mut u8
    let p16: *mut u16 = (&b[1]) as *mut u16
    let p32: *mut u32 = (&b[2]) as *mut u32
    let p64: *mut u64 = (&b[3]) as *mut u64
    __mmio_schreiben8(p8, 1 as u8)
    __mmio_schreiben16(p16, 2 as u16)
    __mmio_schreiben32(p32, 3 as u32)
    __mmio_schreiben64(p64, 4 as u64)
    let a: u64 = __mmio_lesen8(p8) as u64
    let c: u64 = __mmio_lesen16(p16) as u64
    let d: u64 = __mmio_lesen32(p32) as u64
    let e: u64 = __mmio_lesen64(p64)
    return (a + c + d + e) as i32
}
