// expect_exit: 0
// wasm_skip: fui.app pulls in the window layer
// tests/3723_fui_frame_stats.fi -- fui.app frame statistics (opt-in paint time per frame): all counters start at 0, reset keeps them
// at 0, an unknown key reads 0. The counting itself runs in app_paint (needs a window); tools/android/jarvis_e2e.sh reads it on a device.
import std.rt
import fui.app

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn main() -> i32 {
    app.frame_stats_reset()
    check("frames start at 0", app.frame_stat(app.FS_FRAMES) == 0)
    check("mean of no frames is 0", app.frame_stat(app.FS_AVG_US) == 0)
    check("max starts at 0", app.frame_stat(app.FS_MAX_US) == 0)
    check("slow frames start at 0", app.frame_stat(app.FS_SLOW) == 0)
    app.frame_stats_on(true)
    app.frame_stats_on(false)
    app.frame_stats_reset()
    check("unknown key reads 0", app.frame_stat(99) == 0)
    check("still 0 after on/off/reset", app.frame_stat(app.FS_FRAMES) == 0)
    if failures == 0 {
        rt.write_everything(1, "OK\n".p as u64, 3)
        return 0
    }
    return 1
}
