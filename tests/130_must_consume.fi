// expect_exit: 12
// Attributes (attrs.rs) and #[must_consume] (SPEC 3.3/5.1, DESIGN_GOALS 2).
// Used correctly: the result is bound and passed on.
#[must_consume]
struct Guard { fd: i32 }

fn open(fd: i32) -> Guard {
    return Guard { fd: fd, }
}

fn close(w: Guard) -> i32 {
    return w.fd
}

#[must_consume]
fn reserve(n: i32) -> i32 {
    return n * 2
}

fn main() -> i32 {
    let w = open(5)
    let a = close(w)
    let b = reserve(3)
    // 5 + 6 + 1 = 12
    return a + b + 1
}
