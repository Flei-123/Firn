// expect_exit: 12
// Attribute (attrs.rs) und #[must_consume] (SPEC 3.3/5.1, DESIGNZIELE 2).
// Richtig benutzt: das Ergebnis wird gebunden und weitergereicht.
#[must_consume]
struct Wache { fd: i32 }

fn oeffne(fd: i32) -> Wache {
    return Wache{ fd: fd, }
}

fn schliesse(w: Wache) -> i32 {
    return w.fd
}

#[must_consume]
fn reserviere(n: i32) -> i32 {
    return n * 2
}

fn main() -> i32 {
    let w = oeffne(5)
    let a = schliesse(w)
    let b = reserviere(3)
    // 5 + 6 + 1 = 12
    return a + b + 1
}
