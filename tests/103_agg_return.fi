// expect_exit: 77
// Returning aggregates: 8 bytes in rax, anything larger through the hidden
// pointer in rdi (abi.rs, SPEC 14.1).
struct P { x: i32, y: i32 }
struct R { a: i64, b: i64, c: i64 }

fn make_p(x: i32, y: i32) -> P {
    return P { x: x, y: y }
}

fn make_r(v: i64) -> R {
    return R { a: v, b: v + 1 as i64, c: v + 2 as i64 }
}

fn main() -> i32 {
    let p: P = make_p(30, 40)
    let r: R = make_r(2 as i64)
    // 30 + 40 + (2+3+4) = 79? no: 30+40=70, r.a+r.b+r.c = 2+3+4 = 9 -> 79
    let s: i32 = p.x + p.y - 2 as i32 + (r.a + r.b + r.c) as i32
    return s
}
