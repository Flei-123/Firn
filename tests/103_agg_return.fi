// expect_exit: 77
// Rueckgabe von Aggregaten: 8 Byte in rax, groesser ueber den versteckten
// Zeiger in rdi (abi.rs, SPEC §14.1).
struct P { x: i32, y: i32 }
struct R { a: i64, b: i64, c: i64 }

fn mach_p(x: i32, y: i32) -> P {
    return P{ x: x, y: y }
}

fn mach_r(v: i64) -> R {
    return R{ a: v, b: v + 1 as i64, c: v + 2 as i64 }
}

fn main() -> i32 {
    let p: P = mach_p(30, 40)
    let r: R = mach_r(2 as i64)
    // 30 + 40 + (2+3+4) = 79? nein: 30+40=70, r.a+r.b+r.c = 2+3+4 = 9 -> 79
    let s: i32 = p.x + p.y - 2 as i32 + (r.a + r.b + r.c) as i32
    return s
}
