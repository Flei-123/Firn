// expect_exit: 0
// tests/4280_generic_fn_value.fi -- a generic function INSTANCE as a value: `id[i32]` (r718).
import std.option
import std.vec

struct Ops { f: fn(i32) -> i32 }

struct Holder[T] { f: fn(T) -> T, v: T }

fn id[T](x: T) -> T { return x }
fn dbl[T](x: T) -> T { return x + x }
fn apply(f: fn(i32) -> i32, v: i32) -> i32 { return f(v) }
fn apply_g[T](f: fn(T) -> T, v: T) -> T { return f(v) }
fn via[T](v: T) -> T { return apply_g[T](id[T], v) }
fn mk[T](v: T) -> Holder[T] { return Holder[T]{ f: dbl[T], v: v } }

fn main() -> i32 {
    let f = id[i32]
    if f(3) != 3 { return 1 }
    if apply(id[i32], 4) != 4 { return 2 }
    let g: fn(i64) -> i64 = dbl[i64]
    if g(5) != 10 { return 3 }
    let o = Ops { f: dbl[i32] }
    if o.f(4) != 8 { return 4 }
    if via[i64](9) != 9 { return 5 }
    if apply_g[i32](dbl[i32], 6) != 12 { return 6 }
    var fs: Vec[fn(i32) -> i32] = vec_new[fn(i32) -> i32]()
    defer vec_free[fn(i32) -> i32](&fs)
    vec_push[fn(i32) -> i32](&fs, id[i32])
    vec_push[fn(i32) -> i32](&fs, dbl[i32])
    if fs[1](5) != 10 { return 7 }
    if id[i32] != id[i32] { return 8 }
    let s = option.opt_some[i32]
    if s(3).val != 3 { return 9 }
    let h = mk[i32](21)
    if h.f(h.v) != 42 { return 10 }
    let q = id[fn(i32) -> i32](dbl[i32])
    if q(8) != 16 { return 11 }
    return 0
}
