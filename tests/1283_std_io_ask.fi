// expect_out: r69 ask: 42 -7 firn 3.5 rejected 3 prompt 11 ok
// tests/1283_std_io_ask.fi -- the whole way in ONE call (round 69).
//
// This is what the round was about. Before:
//
//     var input: rt.Buf = rt.buf_new()
//     if !io.read_stdin(&input) { return 1 }
//     let s = str.span(rt.buf_ptr(&input) as *mut u8, rt.buf_len(&input)).trim()
//     var x: i64 = 0
//     if !num.text_to_i64(s.p, s.n, &x) { ... }
//
// Now:
//
//     let n: num.ParsedI64 = io.ask_i64(f"Enter a number: ")
//     if !n.ok { ... }
//
// `ask_*` writes the question, reads ONE line, trims it, parses it and
// releases the buffer -- the caller owns nothing and can forget nothing.
// The question is an `f"..."`, so that a text literal needs neither a
// length nor an array of its own.
//
// What is checked: the ordinary case, blanks around the number (they are
// trimmed HERE, unlike in `num.parse_*`, which stays strict), a text answer
// through `io.prompt`, a floating point number, and the three ways to have
// no number -- letters, an empty line and the end of input. Plus: the
// question really lands on descriptor 1, and WITHOUT a line feed, because a
// prompt stays on its line.
import std.io
import std.rt
import std.num
import std.str

const SYS_DUP: i64 = 32
const SYS_DUP2: i64 = 33
const SYS_OPEN: i64 = 2
const SYS_CLOSE: i64 = 3
const O_ONLY_READ: i64 = 0

fn main() -> i32 {
    var path: [u8; 21] = "/tmp/firn1283_in.txt\0"
    var outpath: [u8; 22] = "/tmp/firn1283_out.txt\0"
    var content: [u8; 24] = "42\n  -7  \nfirn\n3.5\nabc\n\n"

    if !io.write_file(rt.addr_of(&path[0]), rt.addr_of(&content[0]), 24) {
        return 10
    }

    let saved_in: i64 = syscall(SYS_DUP, 0, 0, 0, 0, 0, 0)
    let saved_out: i64 = syscall(SYS_DUP, 1, 0, 0, 0, 0, 0)
    if saved_in < 0 || saved_out < 0 {
        return 11
    }
    let fd_in: i64 = syscall(SYS_OPEN, rt.addr_of(&path[0]) as i64,
        O_ONLY_READ, 0, 0, 0, 0)
    let fd_out: i64 = syscall(SYS_OPEN, rt.addr_of(&outpath[0]) as i64, 577,
        493, 0, 0, 0)
    if fd_in < 0 || fd_out < 0 {
        return 12
    }
    syscall(SYS_DUP2, fd_in, 0, 0, 0, 0, 0)
    syscall(SYS_DUP2, fd_out, 1, 0, 0, 0, 0)

    let first: num.ParsedI64 = io.ask_i64(f"n? ")
    let second: num.ParsedI64 = io.read_i64()
    var who: io.Text = io.prompt(f"who? ")
    let who_length: usize = who.length()
    var who_wanted: io.Text = io.text_of(f"firn")
    let who_ok: bool = str.equal(who.span(), who_wanted.span())
    who_wanted.free()
    who.free()
    let third: num.ParsedF64 = io.ask_f64(f"x? ")
    let letters: num.ParsedI64 = io.read_i64()
    let empty: num.ParsedI64 = io.read_i64()
    let ended: num.ParsedI64 = io.read_i64()

    syscall(SYS_DUP2, saved_in, 0, 0, 0, 0, 0)
    syscall(SYS_DUP2, saved_out, 1, 0, 0, 0, 0)
    syscall(SYS_CLOSE, fd_in, 0, 0, 0, 0, 0)
    syscall(SYS_CLOSE, fd_out, 0, 0, 0, 0, 0)
    syscall(SYS_CLOSE, saved_in, 0, 0, 0, 0, 0)
    syscall(SYS_CLOSE, saved_out, 0, 0, 0, 0, 0)

    if !first.ok || first.value != 42 {
        return 20
    }
    // "  -7  " -- ask_* / read_* trim, num.parse_* does not
    if !second.ok || second.value != 0 - 7 {
        return 21
    }
    if !who_ok || who_length != 4 {
        return 22
    }
    if !third.ok || third.value != 3.5 {
        return 23
    }
    var rejected: usize = 0
    if letters.ok {
        return 24
    }
    rejected = rejected + 1
    if empty.ok {
        return 25
    }
    rejected = rejected + 1
    // the end of input: nothing read, nothing claimed
    if ended.ok || ended.value != 0 || ended.overflow {
        return 26
    }
    rejected = rejected + 1

    // --- the questions really went out, and without a line feed
    var caught: rt.Buf = rt.buf_new()
    if !io.read_file(rt.addr_of(&outpath[0]), &caught) {
        return 30
    }
    let prompt_length: usize = rt.buf_len(&caught)
    var prompt_wanted: io.Text = io.text_of(f"n? who? x? ")
    let prompt_ok: bool = str.equal(io.span_of_buf(&caught),
        prompt_wanted.span())
    prompt_wanted.free()
    rt.buf_free(&caught)
    if !prompt_ok || prompt_length != 11 {
        return 31
    }

    io.fmt_print(f"r69 ask: {first.value} {second.value} firn ")
    io.fmt_print(io.fmt_f64(f"", third.value))
    io.fmt_print_line(f" rejected {rejected} prompt {prompt_length} ok")
    return 0
}
