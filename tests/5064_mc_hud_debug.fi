// expect_exit: 0
import std.rt
import mc.mc_registry
import mc.mc_version
import mc.mc_versions
import mc.mc_world
import mc.mc_hud_debug
import mc.mc_raster

fn check(c: bool, code: i32) {
    if !c {
        rt.finish(code as i64)
    }
}

fn line_is(d: *mut mc_hud_debug.DebugInfo, w: *mut mc_world.World, reg: *mut mc_registry.Registry, k: i32, want: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    mc_hud_debug.dbg_lines(d, w, reg, k, &b)
    let ok: bool = rt.buf_len(&b) == want.n && rt.mem_eq(rt.buf_ptr(&b), want.p as u64, want.n)
    rt.buf_free(&b)
    return ok
}

fn main() -> i32 {
    check(mc_hud_debug.dbg_facing(0.0) == 0, 1)
    check(mc_hud_debug.dbg_facing(90.0) == 1, 2)
    check(mc_hud_debug.dbg_facing(180.0) == 2, 3)
    check(mc_hud_debug.dbg_facing(0.0 - 90.0) == 3, 4)
    check(mc_hud_debug.dbg_facing(270.0) == 3, 5)
    check(mc_hud_debug.dbg_facing(44.0) == 0, 6)

    var v: mc_version.Version = mc_version.version_empty()
    check(mc_versions.version_by_protocol(763, &v), 10)
    var reg: mc_registry.Registry = v.registry_of()
    var w: mc_world.World = mc_world.world_new()
    var d: mc_hud_debug.DebugInfo = mc_hud_debug.dbg_new()
    d.protocol = 763
    d.fps = 60
    d.x = 17.5
    d.y = 64.0
    d.z = 0.0 - 3.25
    d.yaw = 90.0
    d.pitch = 0.0 - 10.0
    check(line_is(&d, &w, &reg, 0, "mcplay (protocol 763)"), 11)
    check(line_is(&d, &w, &reg, 1, "60 fps"), 12)
    check(line_is(&d, &w, &reg, 3, "XYZ: 17.500 / 64.000 / -3.250"), 13)
    check(line_is(&d, &w, &reg, 4, "Block: 17 64 -4"), 14)
    check(line_is(&d, &w, &reg, 5, "Chunk: 1 0 12 in 1 4 -1"), 15)
    check(line_is(&d, &w, &reg, 6, "Facing: west (Towards negative X) (90.0 / -10.0)"), 16)
    check(line_is(&d, &w, &reg, 7, "Biome: -"), 17)
    check(line_is(&d, &w, &reg, 2, ""), 18)

    var r: mc_raster.Raster = mc_raster.raster_new(640, 360)
    mc_raster.raster_clear(&r, 0xFF000000 as u32)
    d.has_block = true
    d.state = 1
    mc_hud_debug.dbg_draw(&r, 2, &d, &w, &reg)
    check(mc_raster.raster_pixel(&r, 3, 5) != 0xFF000000 as u32, 20)
    check(mc_raster.raster_pixel(&r, 320, 340) == 0xFF000000 as u32, 21)
    return 0
}
