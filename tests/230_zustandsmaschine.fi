// expect_exit: 244
// Zustandsmaschine mit 32 Zustaenden (SPEC §6.3, P4).
// --emit=asm zeigt fuer den match eine Sprungtabelle (.rodata + 'jmp qword ptr [..]'),
// nicht 32 Vergleiche. Geprueft von codegen_switch.rs::sprungtabelle_bei_30_zustaenden.
enum Zustand { S0, S1, S2, S3, S4, S5, S6, S7, S8, S9, S10, S11, S12, S13, S14, S15, S16, S17, S18, S19, S20, S21, S22, S23, S24, S25, S26, S27, S28, S29, S30, S31 }

fn main() -> i32 {
    var z: Zustand = Zustand::S0
    var summe: i32 = 0
    var i: i32 = 0
    while i < 200 as i32 {
        match z {
            Zustand::S0 => { summe = summe + 1 as i32; z = Zustand::S1 }
            Zustand::S1 => { summe = summe + 4 as i32; z = Zustand::S6 }
            Zustand::S2 => { summe = summe + 7 as i32; z = Zustand::S11 }
            Zustand::S3 => { summe = summe + 10 as i32; z = Zustand::S16 }
            Zustand::S4 => { summe = summe + 13 as i32; z = Zustand::S21 }
            Zustand::S5 => { summe = summe + 16 as i32; z = Zustand::S26 }
            Zustand::S6 => { summe = summe + 2 as i32; z = Zustand::S31 }
            Zustand::S7 => { summe = summe + 5 as i32; z = Zustand::S4 }
            Zustand::S8 => { summe = summe + 8 as i32; z = Zustand::S9 }
            Zustand::S9 => { summe = summe + 11 as i32; z = Zustand::S14 }
            Zustand::S10 => { summe = summe + 14 as i32; z = Zustand::S19 }
            Zustand::S11 => { summe = summe + 0 as i32; z = Zustand::S24 }
            Zustand::S12 => { summe = summe + 3 as i32; z = Zustand::S29 }
            Zustand::S13 => { summe = summe + 6 as i32; z = Zustand::S2 }
            Zustand::S14 => { summe = summe + 9 as i32; z = Zustand::S7 }
            Zustand::S15 => { summe = summe + 12 as i32; z = Zustand::S12 }
            Zustand::S16 => { summe = summe + 15 as i32; z = Zustand::S17 }
            Zustand::S17 => { summe = summe + 1 as i32; z = Zustand::S22 }
            Zustand::S18 => { summe = summe + 4 as i32; z = Zustand::S27 }
            Zustand::S19 => { summe = summe + 7 as i32; z = Zustand::S0 }
            Zustand::S20 => { summe = summe + 10 as i32; z = Zustand::S5 }
            Zustand::S21 => { summe = summe + 13 as i32; z = Zustand::S10 }
            Zustand::S22 => { summe = summe + 16 as i32; z = Zustand::S15 }
            Zustand::S23 => { summe = summe + 2 as i32; z = Zustand::S20 }
            Zustand::S24 => { summe = summe + 5 as i32; z = Zustand::S25 }
            Zustand::S25 => { summe = summe + 8 as i32; z = Zustand::S30 }
            Zustand::S26 => { summe = summe + 11 as i32; z = Zustand::S3 }
            Zustand::S27 => { summe = summe + 14 as i32; z = Zustand::S8 }
            Zustand::S28 => { summe = summe + 0 as i32; z = Zustand::S13 }
            Zustand::S29 => { summe = summe + 3 as i32; z = Zustand::S18 }
            Zustand::S30 => { summe = summe + 6 as i32; z = Zustand::S23 }
            Zustand::S31 => { summe = summe + 9 as i32; z = Zustand::S28 }
        }
        i = i + 1 as i32
    }
    return summe % 251 as i32
}
