// expect_exit: 0
// tests/4022_option.fi -- std.option: Option[T] as a generic struct plus the Vec bridges (r712).
import std.io
import std.rt
import std.vec
import std.option
import std.testkit

struct P {
    a: i32,
    b: i32,
}

fn half(n: i32) -> Option[i32] {
    if n % 2 == 0 {
        return opt_some[i32](n / 2)
    }
    return opt_none[i32]()
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let a: Option[i32] = opt_some[i32](7)
    let b: Option[i32] = opt_none[i32]()
    testkit.check(a.has && a.val == 7, "some fields")
    testkit.check(!b.has && b.val == 0, "none fields")
    testkit.check(opt_is_some[i32](a) && !opt_is_none[i32](a), "is_some")
    testkit.check(opt_is_none[i32](b) && !opt_is_some[i32](b), "is_none")
    testkit.check(opt_unwrap_or[i32](a, 99) == 7, "unwrap_or full")
    testkit.check(opt_unwrap_or[i32](b, 99) == 99, "unwrap_or empty")
    testkit.check(opt_unwrap[i32](a) == 7 && opt_unwrap[i32](b) == 0, "unwrap")
    testkit.check(opt_or[i32](b, a).val == 7 && opt_or[i32](a, opt_some[i32](1)).val == 7, "or")
    testkit.check(!opt_or[i32](b, b).has, "or empty")
    testkit.check(opt_eq[i32](a, opt_some[i32](7)), "eq same")
    testkit.check(!opt_eq[i32](a, b) && opt_eq[i32](b, opt_none[i32]()), "eq empty")
    testkit.check(!opt_eq[i32](a, opt_some[i32](8)), "eq differs")
    // returned from a function
    testkit.check(half(10).val == 5 && !half(7).has, "function result")
    testkit.check(opt_unwrap_or[i32](half(9), -1) == -1, "function result unwrap_or")
    // struct payload
    let p: Option[P] = opt_some[P](P { a: 1, b: 2 })
    testkit.check(p.has && p.val.a == 1 && p.val.b == 2, "struct payload")
    let q: Option[P] = opt_none[P]()
    testkit.check(!q.has && q.val.a == 0 && q.val.b == 0, "struct payload empty")
    // Vec bridges
    var v: Vec[i64] = vec_new[i64]()
    testkit.check(!vec_first_opt[i64](&v).has, "first of empty")
    testkit.check(!vec_last_opt[i64](&v).has, "last of empty")
    testkit.check(!vec_pop_opt[i64](&v).has, "pop of empty")
    vec_push[i64](&v, 10)
    vec_push[i64](&v, 20)
    vec_push[i64](&v, 30)
    testkit.check(vec_first_opt[i64](&v).val == 10, "first")
    testkit.check(vec_last_opt[i64](&v).val == 30, "last")
    testkit.check(vec_get_opt[i64](&v, 1).val == 20 && !vec_get_opt[i64](&v, 3).has, "get")
    testkit.check(vec_index_of_opt[i64](&v, 20).val == 1, "index_of")
    testkit.check(!vec_index_of_opt[i64](&v, 21).has, "index_of missing")
    let popped: Option[i64] = vec_pop_opt[i64](&v)
    testkit.check(popped.has && popped.val == 30 && vec_len[i64](&v) == 2, "pop")
    vec_free[i64](&v)
    return testkit.finish()
}
