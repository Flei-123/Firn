// expect_exit: 0
// tests/1230_bitnot.fi -- ROUND 68: `~`, the bitwise complement.
//
// docs/ROUND59.md, section 8, named two things the kernel felt as missing:
// `~` and the line continuation. This is the first of the two. Until now
// the complement had to be written `x ^ 0xFFFF...` -- once per width, and
// wrong the moment the width changed.
//
// `~` is deliberately NOT the same operator as `!`: `!` negates a bool,
// `~` flips every bit of an integer. Mixing the two is a type error in
// both directions (tests/neg/1064_tilde_needs_integer.fi,
// tests/neg/1231_not_needs_bool.fi).

const ALL_ONES: i32 = ~0
const LOW_NIBBLE: u32 = ~0xFFFFFFF0

fn ident(x: u64) -> u64 { return x }

fn main() -> i32 {
    // 1. every unsigned width -- the complement of zero is the full word
    let a: u8 = ~0
    if a != 255 { return 1 }
    let b: u16 = ~0
    if b != 65535 { return 2 }
    let c: u32 = ~0
    if c != 4294967295 { return 3 }
    let d: u64 = ~0
    if d != 18446744073709551615 { return 4 }

    // 2. signed: ~x == -x - 1
    let e: i32 = 5
    if ~e != -6 { return 5 }
    let minus_one: i32 = -1
    if ~minus_one != 0 { return 6 }
    let f: i64 = -100
    if ~f != 99 { return 7 }

    // 3. the same as the old workaround, in every width
    let g: u32 = 0x0F0F0F0F
    if ~g != g ^ 4294967295 { return 8 }
    let h: u8 = 0x35
    if ~h != h ^ 255 { return 9 }

    // 4. double complement is the identity
    var i: u64 = 0
    while i < 64 {
        let v: u64 = 1 << i
        if ~~v != v { return 10 }
        if ~v & v != 0 { return 11 }
        if ~v | v != 18446744073709551615 { return 12 }
        i = i + 1
    }

    // 5. precedence: `~` binds tighter than every binary operator
    let m: u32 = 0xFF
    if ~m & 0xFF != 0 { return 13 }
    // ROUND 72: `0 - 255` on the UNSIGNED u32 the context asks for is a
    // deliberate wraparound -- it spells 0xFFFFFF01, the value `~m + 1`
    // really has. `-%` says so; plain `-` would (correctly) panic.
    if ~m + 1 != 0 -% 255 { return 14 }
    if ~(m & 0x0F) != 4294967280 { return 15 }

    // 6. in a constant expression -- computed by the type checker
    if ALL_ONES != -1 { return 16 }
    if LOW_NIBBLE != 15 { return 17 }
    var arr: [u8; 16] = [0; 16]
    arr[LOW_NIBBLE as usize] = 7
    if arr[15] != 7 { return 18 }

    // 7. as an argument and as a return value
    if ident(~0) != 18446744073709551615 { return 19 }

    // 8. a mask built the way a kernel builds one: bits 8..11 cleared
    var flags: u64 = 18446744073709551615
    flags = flags & ~(0xF << 8)
    if flags != 18446744073709547775 { return 20 }
    return 0
}
