// expect_exit: 0
// r481: a block that branches two ways with phis in BOTH targets must not
// write the phi values of one edge before the other edge has read them.
// Shape (from mc_assets.anim_step): a scan loop over a duration table that
// stops at the entry whose end passes `pos`; after inlining and loop
// rotation the loop test block ends in `brcond body / exit` and both have
// phis. The copy for the body edge overwrote the loop counter that the exit
// edge still needed, the exit read slot e + 1 (duration 0) and `div` trapped
// at --opt-level=release-fast.
struct Anim {
    dur: u64,
    len: usize,
    total: u64,
}

fn ld16(base: u64, i: usize) -> u16 {
    return *((base + (i as u64) * 2) as *mut u16)
}

fn st16(base: u64, i: usize, v: u16) {
    *((base + (i as u64) * 2) as *mut u16) = v
}

// Position inside the entry that covers `tick`, scaled to 0..255.
#[no_inline]
fn step(an: *mut Anim, tick: i64) -> u64 {
    let pos: u64 = (tick as u64) % (*an).total
    var e: usize = 0
    var start: u64 = 0 as u64
    while e + 1 < (*an).len {
        let dd: u64 = ld16((*an).dur, e) as u64
        if pos < start + dd { break }
        start = start + dd
        e = e + 1
    }
    let dur: u64 = ld16((*an).dur, e) as u64
    return (((pos - start) * 256 as u64) / dur) + (e as u64) * 1000 as u64
}

fn main() -> i32 {
    var tab: [u16; 4] = [3, 5, 2, 7]
    let base: u64 = (&tab) as u64
    var an: Anim = Anim { dur: base, len: 4, total: 17 as u64 }
    // expected: e and offset for every tick of the cycle
    var t: i64 = 0
    var bad: i32 = 0
    while t < 34 {
        let pos: u64 = (t as u64) % 17 as u64
        var s: u64 = 0 as u64
        var e: usize = 0
        var d: u64 = ld16(base, 0) as u64
        while pos >= s + d && e < 3 {
            s = s + d
            e = e + 1
            d = ld16(base, e) as u64
        }
        let want: u64 = (((pos - s) * 256 as u64) / d) + (e as u64) * 1000 as u64
        if step(&an, t) != want { bad = bad + 1 }
        t = t + 1
    }
    return bad
}
