// expect_exit: 0
// Round TUPLES and ownership (SPEC 3.3): a tuple whose elements have a `drop`
// is an owner like a struct with such fields -- built by a literal (the
// elements are MOVED in), returned, passed, assigned (the old value is
// dropped), dropped at the end of its block with its elements in order. It
// cannot be taken apart into names by `let (a, b)`: that would move the
// elements out one by one, and partial moves do not exist
// (tests/neg/2415_tuple_partial_move.fi).
static mut LOG: i64 = 0

struct Guard { id: i64 }

impl Guard {
    fn drop(inout self) {
        LOG = LOG * 10 + self.id
    }
}

fn mk(id: i64) -> Guard { return Guard { id: id } }
fn pair(a: i64, b: i64) -> (Guard, Guard) { return (mk(a), mk(b)) }
fn eat(p: (Guard, Guard)) {}
fn pass(p: (Guard, Guard)) -> (Guard, Guard) { return p }
fn mixed() -> (i64, Guard) { return (7, mk(8)) }

fn main() -> i32 {
    {
        let p = pair(1, 2)
    }
    if LOG != 12 { return 1 }
    LOG = 0
    {
        let p = (mk(3), mk(4))
        let q = p
    }
    if LOG != 34 { return 2 }
    LOG = 0
    {
        let p = pair(5, 6)
        eat(p)
    }
    if LOG != 56 { return 3 }
    LOG = 0
    {
        var p = pair(1, 2)
        p = pair(7, 8)
    }
    if LOG != 12 * 100 + 78 { return 4 }
    LOG = 0
    {
        let p = pass(pair(2, 3))
    }
    if LOG != 23 { return 5 }
    LOG = 0
    {
        let m = mixed()
        if m.0 != 7 { return 6 }
    }
    if LOG != 8 { return 7 }
    return 0
}
