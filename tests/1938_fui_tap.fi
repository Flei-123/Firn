// expect_exit: 0
import fui.tap
import fui.hotreg
import fui.kit
import std.rt

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn main() -> i32 {
    var t: tap.Tap = tap.tap_new()
    tap.tap_down(&t, 1 as u32, true, true, 100.0, 200.0, 1000.0)
    check("finger: still press is a tap", tap.tap_up(&t, 1 as u32, 102.0, 203.0, 1100.0))
    check("finger: a second up is nothing", !tap.tap_up(&t, 1 as u32, 102.0, 203.0, 1100.0))

    tap.tap_down(&t, 1 as u32, true, true, 100.0, 200.0, 1000.0)
    check("finger: small move keeps the tap", !tap.tap_move(&t, 1 as u32, 105.0, 204.0))
    check("finger: past the slop loses it", tap.tap_move(&t, 1 as u32, 100.0, 215.0))
    check("finger: lost stays lost on return", !tap.tap_up(&t, 1 as u32, 100.0, 200.0, 1100.0))

    tap.tap_down(&t, 1 as u32, true, true, 100.0, 200.0, 1000.0)
    check("finger: a long hold is no tap", !tap.tap_up(&t, 1 as u32, 100.0, 200.0, 1600.0))
    tap.tap_down(&t, 1 as u32, true, true, 100.0, 200.0, 1000.0)
    check("finger: release far away is no tap even without a move", !tap.tap_up(&t, 1 as u32, 100.0, 240.0, 1100.0))

    tap.tap_down(&t, 1 as u32, true, true, 100.0, 200.0, 1000.0)
    tap.tap_down(&t, 2 as u32, false, true, 300.0, 200.0, 1010.0)
    check("second finger cancels the first", !tap.tap_up(&t, 1 as u32, 100.0, 200.0, 1100.0))

    tap.tap_down(&t, 1 as u32, true, false, 50.0, 50.0, 0.0)
    check("mouse: 4 px slop holds", !tap.tap_move(&t, 1 as u32, 53.0, 53.0))
    check("mouse: 6 px loses", tap.tap_move(&t, 1 as u32, 56.0, 50.0))
    check("mouse: lost", !tap.tap_up(&t, 1 as u32, 50.0, 50.0, 1100.0))

    tap.tap_down(&t, 1 as u32, true, true, 10.0, 10.0, 1000.0)
    check("touch press color waits", !tap.tap_settled(&t, 1050.0))
    check("touch press color after the delay", tap.tap_settled(&t, 1095.0))
    let _m: bool = tap.tap_move(&t, 1 as u32, 10.0, 40.0)
    check("a lost tap never settles", !tap.tap_settled(&t, 1200.0))
    tap.tap_cancel(&t)
    check("cancel ends it", !tap.tap_live(&t))

    tap.tap_down(&t, 1 as u32, true, true, 7.0, 9.0, 2000.0)
    check("press event not yet", !tap.tap_take_press(&t, 2050.0))
    check("press event once after the delay", tap.tap_take_press(&t, 2100.0) && tap.tap_x0(&t) == 7.0 && tap.tap_y0(&t) == 9.0)
    check("press event is not repeated", !tap.tap_take_press(&t, 2200.0))
    tap.tap_cancel(&t)
    tap.tap_down(&t, 1 as u32, true, false, 10.0, 10.0, 1000.0)
    check("mouse has no press event", !tap.tap_take_press(&t, 5000.0))
    check("mouse press color at once", tap.tap_settled(&t, 1000.0))
    tap.tap_cancel(&t)

    hotreg.reset()
    hotreg.begin_frame()
    let _a: u32 = hotreg.state(1 as u32, 10.0, 10.0, 100.0, 30.0, true)
    hotreg.begin_frame()
    hotreg.touch(true)
    let _d: bool = hotreg.down(20.0, 20.0)
    check("touch down shows no press yet", hotreg.pressed() == 0 as u32 && hotreg.press_pending())
    check("settle shows the press", hotreg.press_settle() && hotreg.pressed() == 1 as u32)
    check("cancel clears the press", hotreg.press_cancel() && hotreg.pressed() == 0 as u32)
    let _d2: bool = hotreg.down(20.0, 20.0)
    check("cancel before settle clears pending", !hotreg.press_cancel() && !hotreg.press_pending() && !hotreg.press_settle())
    let _d3: bool = hotreg.down(20.0, 20.0)
    let _u: bool = hotreg.up()
    check("up before settle never shows it", !hotreg.press_pending() && hotreg.pressed() == 0 as u32)
    hotreg.touch(false)
    let _d4: bool = hotreg.down(20.0, 20.0)
    check("mouse down is active at once", hotreg.pressed() == 1 as u32)

    if failures == 0 {
        return 0
    }
    return 1
}
