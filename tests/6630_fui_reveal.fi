// expect_exit: 0
import fui.reveal
import fui.ds_tokens_motion
import std.rt

static mut failures: i32 = 0

fn check(name: str, ok: bool) {
    if !ok {
        failures += 1
        rt.write_everything(1, "  FAIL  ".p as u64, 8)
        rt.write_everything(1, name.p as u64, name.n)
        rt.write_everything(1, "\n".p as u64, 1)
    }
}

fn main() -> i32 {
    var r: reveal.Reveal = reveal.reveal_new()
    check("starts closed", reveal.reveal_value(&r, 1000.0) == 0.0 && !reveal.reveal_visible(&r, 1000.0))
    reveal.reveal_set(&r, true, 1000.0, ds_tokens_motion.M_SLIDE, ds_tokens_motion.M_DIALOG_CLOSE)
    check("busy after open", reveal.reveal_busy(&r, 1050.0))
    let v0: f64 = reveal.reveal_value(&r, 1000.0)
    let vm: f64 = reveal.reveal_value(&r, 1100.0)
    check("start at 0", v0 == 0.0)
    check("middle strictly between", vm > 0.0 && vm < 1.0)
    check("decelerate front loaded", vm > 0.4)
    check("end exact", reveal.reveal_value(&r, 1250.0) == 1.0 && reveal.reveal_value(&r, 5000.0) == 1.0)
    check("settled after end", !reveal.reveal_busy(&r, 1400.0))
    reveal.reveal_set(&r, false, 2000.0, ds_tokens_motion.M_SLIDE, ds_tokens_motion.M_DIALOG_CLOSE)
    let c1: f64 = reveal.reveal_value(&r, 2060.0)
    check("closing from 1", c1 < 1.0 && c1 > 0.0)
    check("close shorter than open", reveal.reveal_value(&r, 2167.0) == 0.0)
    check("visible while closing", reveal.reveal_visible(&r, 2100.0) && !reveal.reveal_visible(&r, 2300.0))
    reveal.reveal_set(&r, true, 3000.0, ds_tokens_motion.M_SLIDE, ds_tokens_motion.M_DIALOG_CLOSE)
    let a: f64 = reveal.reveal_value(&r, 3100.0)
    reveal.reveal_set(&r, false, 3100.0, ds_tokens_motion.M_SLIDE, ds_tokens_motion.M_DIALOG_CLOSE)
    check("reverse continues from current", reveal.reveal_value(&r, 3100.0) == a)
    check("reverse goes down", reveal.reveal_value(&r, 3140.0) < a)
    reveal.reveal_enable(false)
    reveal.reveal_set(&r, true, 4000.0, ds_tokens_motion.M_SLIDE, ds_tokens_motion.M_DIALOG_CLOSE)
    check("disabled is instant", reveal.reveal_value(&r, 4000.0) == 1.0 && !reveal.reveal_busy(&r, 4001.0))
    reveal.reveal_enable(true)
    reveal.reveal_set(&r, false, 0.0, ds_tokens_motion.M_SLIDE, ds_tokens_motion.M_DIALOG_CLOSE)
    check("no clock is instant", reveal.reveal_value(&r, 0.0) == 0.0)
    reveal.reveal_time_scale(4.0)
    reveal.reveal_set(&r, true, 5000.0, ds_tokens_motion.M_SLIDE, ds_tokens_motion.M_DIALOG_CLOSE)
    check("time scale slows", reveal.reveal_value(&r, 5250.0) < 1.0 && reveal.reveal_value(&r, 6001.0) == 1.0)
    return failures
}
