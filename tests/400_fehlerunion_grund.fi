// expect_exit: 7
// Fehlerunionen (SPEC §5.1): implizite Umwandlung bei 'return' — ein Wert
// wird zum Erfolg, eine Fehlervariante zum Fehler. Kein 'ok(...)'.
error IoError { NotFound, Permission, Closed }

fn lies(x: i32) -> IoError!i32 {
    if x < 0 {
        return IoError::NotFound
    }
    return x + 7
}

fn main() -> i32 {
    let gut = lies(0) catch 99
    if gut != 7 {
        return 1
    }
    let schlecht = lies(0 - 1) catch 99
    if schlecht != 99 {
        return 2
    }
    return gut
}
