// expect_exit: 0
#[derive(Debug, Hash, Clone)]
enum Opt[T] { Some(T), None }

#[derive(Debug, Clone)]
enum Res[T, E] { Ok(T), Err(E) }

fn main() -> i32 {
    if !gc_init() { return 99 }
    let a: Opt[i32] = Opt::Some(5)
    let n: Opt[i32] = Opt::None
    if a.debug() != "Some(5)" { return 1 }
    if n.debug() != "None" { return 2 }
    let a2 = a.clone()
    if a2.hash() != a.hash() { return 3 }
    if a.hash() == n.hash() { return 4 }
    let r: Res[i32, bool] = Res::Err(true)
    if r.debug() != "Err(true)" { return 5 }
    let r2 = r.clone()
    if r2.debug() != "Err(true)" { return 6 }
    return 0
}
