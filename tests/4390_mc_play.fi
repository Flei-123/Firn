// expect_exit: 0
// mc_play: key map, hotbar keys, block faces, Block Update + Multi Block Change decoding (no window, no server).
import std.rt
import std.bytes
import mc.mc_input
import mc.mc_play

fn main() -> i32 {
    // key map (evdev scancodes)
    if mc_play.key_bit(17 as u32) != mc_input.K_FORWARD { return 1 }
    if mc_play.key_bit(31 as u32) != mc_input.K_BACK { return 2 }
    if mc_play.key_bit(30 as u32) != mc_input.K_LEFT { return 3 }
    if mc_play.key_bit(32 as u32) != mc_input.K_RIGHT { return 4 }
    if mc_play.key_bit(57 as u32) != mc_input.K_JUMP { return 5 }
    if mc_play.key_bit(42 as u32) != mc_input.K_SNEAK { return 6 }
    if mc_play.key_bit(29 as u32) != mc_input.K_SPRINT { return 7 }
    if mc_play.key_bit(16 as u32) != 0 as u32 { return 8 }
    if mc_play.hotbar_of(2 as u32) != 0 || mc_play.hotbar_of(10 as u32) != 8 || mc_play.hotbar_of(11 as u32) != 0 - 1 { return 9 }
    if mc_play.hotbar_of(1 as u32) != 0 - 1 { return 10 }
    // faces
    if mc_play.face_of(0, 0 - 1, 0) != 0 || mc_play.face_of(0, 1, 0) != 1 { return 11 }
    if mc_play.face_of(0, 0, 0 - 1) != 2 || mc_play.face_of(0, 0, 1) != 3 { return 12 }
    if mc_play.face_of(0 - 1, 0, 0) != 4 || mc_play.face_of(1, 0, 0) != 5 { return 13 }
    if mc_play.face_of(0, 0, 0) != 0 - 1 { return 14 }
    // Block Update: negative coordinates, state id > 127 (two varint bytes)
    var b: bytes.Bytes = bytes.bytes_new()
    bytes.put_position(&b, 0 - 33, 70, 0 - 1000)
    bytes.put_varint(&b, 9000)
    var x: i32 = 0
    var y: i32 = 0
    var z: i32 = 0
    var s: i32 = 0
    if !mc_play.decode_block_change(&b, &x, &y, &z, &s) { return 20 }
    if x != 0 - 33 || y != 70 || z != 0 - 1000 || s != 9000 { return 21 }
    // truncated packet
    var t: bytes.Bytes = bytes.bytes_new()
    bytes.put_u8(&t, 1 as u8)
    if mc_play.decode_block_change(&t, &x, &y, &z, &s) { return 22 }
    bytes.bytes_free(&t)
    bytes.bytes_free(&b)
    // Multi Block Change, protocol 763: section (-2, 3, -5), two records
    var m: bytes.Bytes = bytes.bytes_new()
    let sx: i64 = 0 - 2
    let sy: i64 = 3
    let sz: i64 = 0 - 5
    let sec: u64 = (((sx & 4194303 as i64) as u64) << 42 as u64) | (((sz & 4194303 as i64) as u64) << 20 as u64) | ((sy & 1048575 as i64) as u64)
    bytes.put_u64(&m, sec)
    bytes.put_varint(&m, 2)
    bytes.put_varlong(&m, (777 as i64 << 12 as i64) | (5 as i64 << 8 as i64) | (9 as i64 << 4 as i64) | 15 as i64)
    bytes.put_varlong(&m, (1 as i64 << 12 as i64) | 0 as i64)
    var x0: i32 = 0
    var y0: i32 = 0
    var z0: i32 = 0
    let n: i32 = mc_play.multi_begin(&m, 763, &x0, &y0, &z0)
    if n != 2 { return 30 }
    if x0 != 0 - 32 || y0 != 48 || z0 != 0 - 80 { return 31 }
    if !mc_play.multi_next(&m, x0, y0, z0, &x, &y, &z, &s) { return 32 }
    if x != 0 - 27 || z != 0 - 71 || y != 63 || s != 777 { return 33 }
    if !mc_play.multi_next(&m, x0, y0, z0, &x, &y, &z, &s) { return 34 }
    if x != 0 - 32 || z != 0 - 80 || y != 48 || s != 1 { return 35 }
    if mc_play.multi_next(&m, x0, y0, z0, &x, &y, &z, &s) { return 36 }
    bytes.bytes_free(&m)
    // protocol 762 has the extra bool
    var o: bytes.Bytes = bytes.bytes_new()
    bytes.put_u64(&o, sec)
    bytes.put_bool(&o, true)
    bytes.put_varint(&o, 0)
    if mc_play.multi_begin(&o, 762, &x0, &y0, &z0) != 0 { return 40 }
    bytes.bytes_free(&o)
    return 0
}
