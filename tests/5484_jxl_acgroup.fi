import jxl.jxl_acs
import jxl.jxl_frame
import jxl.jxl_lfdata
import jxl.jxl_order
import jxl.jxl_vardct
import std.fs
import std.rt
import std.vec

static mut failures: i32 = 0

fn check(ok: bool) {
    if !ok {
        failures = failures + 1
    }
}

fn check_orders() {
    let buf: u64 = rt.heap_alloc(65536 * 4)
    var t: u32 = 0
    while t < jxl_acs.ACS_COUNT {
        let n: usize = jxl_acs.acs_cover_x(t) * jxl_acs.acs_cover_y(t) * 64
        jxl_order.natural_order(t, buf)
        let seen: u64 = rt.heap_alloc(n)
        rt.mem_set(seen, 0 as u8, n)
        var ok: bool = true
        var k: usize = 0
        while k < n {
            let v: usize = rt.ld32(buf, k) as usize
            if v >= n || rt.ld8(seen, v) != 0 {
                ok = false
            } else {
                rt.st8(seen, v, 1 as u8)
            }
            k = k + 1
        }
        check(ok)
        rt.heap_free(seen, n)
        t = t + 1
    }
    rt.heap_free(buf, 65536 * 4)
}

fn expect(path: str) {
    var data: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file(path, &data) catch 0
    check(n != 0)
    var v: jxl_vardct.JxlVardct = jxl_vardct.vd_new()
    let r: i32 = jxl_vardct.vd_open(rt.buf_ptr(&data), n, &v)
    check(r == 0)
    if r == 0 {
        var g: usize = 0
        while g < (v.doc.frame.num_lf_groups as usize) {
            var end: usize = 0
            check(jxl_vardct.vd_decode_lf_group(&v, g, &end) == 0)
            g = g + 1
        }
        var hend: usize = 0
        let rh: i32 = jxl_vardct.vd_decode_hf_global(&v, &hend)
        check(rh == 0)
        if rh == 0 {
            if v.doc.frame.toc_count != 1 {
                check(hend == jxl_frame.jf_section_size(&v.doc.frame, 1 + (v.doc.frame.num_lf_groups as usize)))
            }
            g = 0
            while g < (v.doc.frame.num_groups as usize) {
                var end: usize = 0
                let ra: i32 = jxl_vardct.vd_decode_ac_group(&v, 0, g, &end)
                check(ra == 0)
                if ra == 0 {
                    if v.doc.frame.toc_count == 1 {
                        check(end == jxl_frame.jf_section_size(&v.doc.frame, 0))
                    } else {
                        check(end == jxl_frame.jf_section_size(&v.doc.frame, 2 + (v.doc.frame.num_lf_groups as usize) + g))
                    }
                }
                g = g + 1
            }
            var nonzero: usize = 0
            var i: usize = 0
            while i < vec.vec_len[i32](&v.data.coefs) {
                if vec.vec_at[i32](&v.data.coefs, i) != 0 {
                    nonzero = nonzero + 1
                }
                i = i + 1
            }
            check(nonzero > 0)
        }
    }
    jxl_vardct.vd_free(&v)
    rt.buf_free(&data)
}

fn main() -> i32 {
    check_orders()
    expect("tests/data/jxl/vd/s64.jxl")
    expect("tests/data/jxl/vd/t64.jxl")
    expect("tests/data/jxl/vd/t37x29.jxl")
    expect("tests/data/jxl/vd/s300x200.jxl")
    expect("tests/data/jxl/vd/s600x300.jxl")
    expect("tests/data/jxl/vd/t64_e7.jxl")
    expect("tests/data/jxl/vd/t37x29_e7.jxl")
    expect("tests/data/jxl/vd/s300x200_e7.jxl")
    expect("tests/data/jxl/vd/s600x300_e7.jxl")
    return failures
}
