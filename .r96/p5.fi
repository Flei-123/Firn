fn main() -> i32 {
    var s: secret[u8] = 200
    var t: secret[u8] = 100
    let a: secret[u8] = s +% t
    let b: secret[u8] = s ^ t
    let c: secret[u8] = ~s
    let d: secret[u8] = s << 2
    let e: secret[bool] = s > t
    var acc: u8 = declassify(a) ^ declassify(b) ^ declassify(c) ^ declassify(d)
    if declassify(e) { acc = acc +% 1 }
    return acc as i32
}
