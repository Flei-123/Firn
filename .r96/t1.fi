// expect_exit: 7
#[constant_time]
fn ct_eq(a: [secret[u8]; 4], b: [secret[u8]; 4]) -> secret[bool] {
    var acc: secret[u8] = 0
    var i: usize = 0
    while i < 4 {
        acc = acc | (a[i] ^ b[i])
        i = i + 1
    }
    return acc == 0
}

fn main() -> i32 {
    var x: [secret[u8]; 4] = [1, 2, 3, 4]
    var y: [secret[u8]; 4] = [1, 2, 3, 4]
    let same: secret[bool] = ct_eq(x, y)
    if declassify(same) {
        return 7
    }
    return 9
}
