#[constant_time]
fn eq_secret(a: secret[u8], b: secret[u8]) -> secret[bool] {
    return a == b
}

fn eq_public(a: u8, b: u8) -> bool {
    if a == b { return true }
    return false
}

fn main() -> i32 {
    var x: secret[u8] = 3
    var y: secret[u8] = 4
    let s: secret[bool] = eq_secret(x, y)
    let p: bool = eq_public(3, 4)
    if declassify(s) { return 1 }
    if p { return 2 }
    return 0
}
