# @NAME@ -- the program's own texts (English is the source language).
# appkit's texts for updates, settings and the crash notice come with the
# library (lib/appkit/locale); keys here are yours.
@lang en

home.title = Welcome to {name}
home.text = This is the starting point of your program. Edit src/ui.fi.
home.hint = Use the sidebar to open Settings and Updates.
nav.home = Home
nav.settings = Settings
nav.updates = Updates
nav.about = About
