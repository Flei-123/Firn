// SPDX-License-Identifier: MPL-2.0
// src/ui.fi -- @NAME@: the window. Generated by tools/newapp.sh; edit freely.
//
// WHAT IS HERE: a sidebar (Home, Settings, Updates, About), a banner when an
// update is waiting, and the pages. Home is YOURS: replace `page_home`.
//
// HOW IT WORKS (lib/fui/kit.fi): IMMEDIATE MODE. Every frame `paint` draws the
// whole window from the state in `Ui`; the rectangles of the buttons it drew
// are remembered (`btn`) and a click is matched against them. No widget tree.
// Keep `Ui` in long-lived storage (it is allocated on the heap in `run`).
//
// THE UPDATE: the window never waits for the network. `update_start` begins a
// check in the background (a thread on Linux x86-64, a second process of this
// program elsewhere), `update_poll` is called once per frame, the status
// (`update_status`) says what to show: checking, available, downloading
// (done/total), ready, error. "Restart and install" calls `update_apply`:
// the new program is put in place and started, this window closes, and
// main.fi's `update_supervise` takes the old program back if the new one
// does not confirm itself (`update_mark_healthy`, called below once this
// window has been up for a few seconds).
import std.rt
import std.time
import fui.theme
import fui.style
import fui.painter
import fui.render
import fui.scene
import fui.anim
import fui.editor
import fui.kit
import fui.kitcolor
import fui.lucide
import fui.apphost
import plat.fuiwirt
import appkit.appinfo
import appkit.platform
import appkit.update
import appkit.config
import appkit.log
import appkit.crash
import appkit.texts
import appkit.util
import appspec

export { run, restart_requested }

const PAGE_HOME: usize = 0
const PAGE_SETTINGS: usize = 1
const PAGE_UPDATES: usize = 2
const PAGE_ABOUT: usize = 3
const NAV_N: usize = 4
const BTN_MAX: usize = 24

const B_CHECK: u32 = 1
const B_DOWNLOAD: u32 = 2
const B_INSTALL: u32 = 3
const B_CANCEL: u32 = 4
const B_RETRY: u32 = 5
const B_AUTO: u32 = 6
const B_AUTODL: u32 = 7
const B_CHANNEL: u32 = 8
const B_DARK: u32 = 9
const B_LIGHT: u32 = 10
const B_LANG_SYS: u32 = 11
const B_LANG_EN: u32 = 12
const B_LANG_DE: u32 = 13
const B_BANNER: u32 = 14
const B_BANNER_X: u32 = 15
const B_CRASH_X: u32 = 16

static mut G_RESTART: bool = false

struct Ui {
    m: theme.Theme,
    c: render.Ctx,
    sc: scene.Scene,
    w: fuiwirt.Host,
    hk: apphost.Hooks,
    tr: anim.TransReg,
    gen: anim.Animator,
    quit: bool,
    selftest: bool,
    win_w: f64,
    win_h: f64,
    page: usize,
    nav_hover: usize,
    collapsed: bool,
    toasts: kit.Toasts,
    // the buttons the last frame drew
    nb: usize,
    bx: [f64; 24],
    by: [f64; 24],
    bw: [f64; 24],
    bh: [f64; 24],
    bid: [u32; 24],
    hover_btn: u32,
    down_btn: u32,
    now: i64,
    want_frames: bool,
    // the updater and what the window remembers about it
    up: *mut update.Updater,
    first_ms: i64,
    frames: u64,
    healthy_marked: bool,
    auto_started: bool,
    banner_dismissed: bool,
    last_phase: u64,
    crash_note: bool,
    crash_dismissed: bool,
}

fn ui_size() -> usize {
    var probe: [Ui; 2] = [ui_blank(), ui_blank()]
    return ((&probe[1]) as usize) - ((&probe[0]) as usize)
}

fn ui_blank() -> Ui {
    return Ui {
        m: theme.theme_new(true),
        c: render.ctx_new(0 as u64 as *mut theme.Theme, 0 as u64 as *mut painter.Painter),
        sc: scene.scene_new(),
        w: fuiwirt.host_new(0 as u64 as *mut scene.Scene, 0 as u64 as *mut render.Ctx),
        hk: apphost.hooks_blank(),
        tr: anim.transreg_new(),
        gen: anim.animator_new(),
        quit: false, selftest: false, win_w: 0.0, win_h: 0.0,
        page: PAGE_HOME, nav_hover: kit.NONE, collapsed: false,
        toasts: kit.toasts_new(),
        nb: 0, bx: [0.0; 24], by: [0.0; 24], bw: [0.0; 24], bh: [0.0; 24],
        bid: [0 as u32; 24], hover_btn: 0 as u32, down_btn: 0 as u32,
        now: 0, want_frames: false,
        up: 0 as u64 as *mut update.Updater, first_ms: 0, frames: 0,
        healthy_marked: false, auto_started: false, banner_dismissed: false,
        last_phase: 0, crash_note: false, crash_dismissed: false,
    }
}

fn restart_requested() -> bool {
    return G_RESTART
}

// ------------------------------------------------------------ small helpers

fn settings(d: *mut Ui) -> *mut config.Config {
    return update.update_settings((*d).up)
}

fn toast(d: *mut Ui, kind: u32, text: str, action: str) {
    kit.toast_push(&(*d).toasts, kind, text, action, (*d).now, 5000 as i64)
}

fn nav_items(out: *mut [kit.NavItem; 4]) {
    (*out)[0] = kit.NavItem { icon: lucide.HOUSE, label: texts.tr("nav.home"), badge: 0, header: false }
    (*out)[1] = kit.NavItem { icon: lucide.SETTINGS, label: texts.tr("nav.settings"), badge: 0, header: false }
    (*out)[2] = kit.NavItem { icon: lucide.DOWNLOAD, label: texts.tr("nav.updates"), badge: 0, header: false }
    (*out)[3] = kit.NavItem { icon: lucide.INFO, label: texts.tr("nav.about"), badge: 0, header: false }
}

// one button: draws it, remembers where it is, returns its width
fn btn(d: *mut Ui, id: u32, x: f64, y: f64, label: str, icon_id: i64, kind: u32) -> f64 {
    let c: *mut render.Ctx = &(*d).c
    let w: f64 = kit.button_width(c, label, icon_id)
    let h: f64 = kit.button_height(c)
    var st: u32 = 0 as u32
    if (*d).hover_btn == id {
        st = st | kit.ST_HOVER
    }
    if (*d).down_btn == id {
        st = st | kit.ST_ACTIVE
    }
    kit.button_draw(c, x, y, w, h, label, icon_id, kind, st)
    if (*d).nb < BTN_MAX {
        let k: usize = (*d).nb
        (*d).bx[k] = x
        (*d).by[k] = y
        (*d).bw[k] = w
        (*d).bh[k] = h
        (*d).bid[k] = id
        (*d).nb = k + 1
    }
    return w
}

fn button_at(d: *mut Ui, px: f64, py: f64) -> u32 {
    var i: usize = 0
    while i < (*d).nb {
        if px >= (*d).bx[i] && px < (*d).bx[i] + (*d).bw[i] && py >= (*d).by[i] && py < (*d).by[i] + (*d).bh[i] {
            return (*d).bid[i]
        }
        i = i + 1
    }
    return 0 as u32
}

fn title(d: *mut Ui, x: f64, y: f64, s: str) {
    let c: *mut render.Ctx = &(*d).c
    kit.draw_label(c, x, y, kit.ln(c, 40), kit.ln(c, 24), 700, kit.tokc(c, style.TOK_TEXT), s, 0.0)
}

fn section(d: *mut Ui, x: f64, y: f64, s: str) {
    let c: *mut render.Ctx = &(*d).c
    kit.draw_label(c, x, y, kit.ln(c, 20), kit.ln(c, 12), 700, kit.tokc(c, style.TOK_TEXT_MUTED), s, 0.0)
}

fn line(d: *mut Ui, x: f64, y: f64, s: str, w: f64) {
    let c: *mut render.Ctx = &(*d).c
    kit.draw_label(c, x, y, kit.ln(c, 22), kit.ln(c, 14), 400, kit.tokc(c, style.TOK_TEXT), s, w)
}

fn muted(d: *mut Ui, x: f64, y: f64, s: str, w: f64) {
    let c: *mut render.Ctx = &(*d).c
    kit.draw_label(c, x, y, kit.ln(c, 22), kit.ln(c, 14), 400, kit.tokc(c, style.TOK_TEXT_MUTED), s, w)
}

// A paragraph: words wrapped to `w`, lines split at newlines, at most
// `max_lines`. Returns the height it used.
fn para(d: *mut Ui, x: f64, y: f64, w: f64, s: str, max_lines: usize) -> f64 {
    let c: *mut render.Ctx = &(*d).c
    let lh: f64 = kit.ln(c, 22)
    var yy: f64 = y
    var lines: usize = 0
    var i: usize = 0
    while i <= s.n && lines < max_lines {
        // one paragraph line: up to the next newline
        var e: usize = i
        while e < s.n && rt.ld8(s.p as u64, e) != 10 as u8 {
            e = e + 1
        }
        var a: usize = i
        while a < e && lines < max_lines {
            // the longest run of whole words that fits
            var b: usize = a
            var last_break: usize = a
            while b < e {
                // advance to the end of the next word
                var we: usize = b
                while we < e && rt.ld8(s.p as u64, we) != 32 as u8 {
                    we = we + 1
                }
                let part: str = str { p: (s.p as u64 + a as u64) as *mut u8, n: we - a }
                if kit.text_width(c, kit.ln(c, 14), 400, part) > w && last_break > a {
                    break
                }
                last_break = we
                b = we
                while b < e && rt.ld8(s.p as u64, b) == 32 as u8 {
                    b = b + 1
                }
                if we >= e {
                    break
                }
            }
            if last_break == a {
                last_break = e
            }
            let seg: str = str { p: (s.p as u64 + a as u64) as *mut u8, n: last_break - a }
            kit.draw_label(c, x, yy, lh, kit.ln(c, 14), 400, kit.tokc(c, style.TOK_TEXT), seg, w)
            yy = yy + lh
            lines = lines + 1
            a = last_break
            while a < e && rt.ld8(s.p as u64, a) == 32 as u8 {
                a = a + 1
            }
        }
        i = e + 1
    }
    return yy - y
}

fn pct(done: u64, total: u64) -> i64 {
    if total == 0 as u64 {
        return -1
    }
    return (done * 1000 as u64 / total) as i64
}

// ----------------------------------------------------------------- the pages

// YOUR PAGE: replace this.
fn page_home(d: *mut Ui, x0: f64, w: f64) {
    let c: *mut render.Ctx = &(*d).c
    let pad: f64 = kit.ln(c, 24)
    var y: f64 = kit.ln(c, 24) + banner_h(d)
    title(d, x0 + pad, y, texts.tr1("home.title", "name", appspec.NAME))
    y = y + kit.ln(c, 56)
    y = y + para(d, x0 + pad, y, w - 2.0 * pad, texts.tr("home.text"), 4)
    y = y + kit.ln(c, 8)
    muted(d, x0 + pad, y, texts.tr("home.hint"), w - 2.0 * pad)
}

fn page_settings(d: *mut Ui, x0: f64, w: f64) {
    let c: *mut render.Ctx = &(*d).c
    let pad: f64 = kit.ln(c, 24)
    var y: f64 = kit.ln(c, 24) + banner_h(d)
    title(d, x0 + pad, y, texts.tr("settings.title"))
    y = y + kit.ln(c, 56)
    section(d, x0 + pad, y, "LANGUAGE")
    y = y + kit.ln(c, 28)
    var x: f64 = x0 + pad
    x = x + btn(d, B_LANG_SYS, x, y, texts.tr("settings.language-system"), lucide.INFO, kit.BTN_SECONDARY) + kit.ln(c, 8)
    x = x + btn(d, B_LANG_EN, x, y, "English", kit.ICON_NONE, kit.BTN_SECONDARY) + kit.ln(c, 8)
    x = x + btn(d, B_LANG_DE, x, y, "Deutsch", kit.ICON_NONE, kit.BTN_SECONDARY)
    y = y + kit.ln(c, 64)
    section(d, x0 + pad, y, "APPEARANCE")
    y = y + kit.ln(c, 28)
    x = x0 + pad
    x = x + btn(d, B_DARK, x, y, "Dark", lucide.MOON, kit.BTN_SECONDARY) + kit.ln(c, 8)
    x = x + btn(d, B_LIGHT, x, y, "Light", lucide.SUN, kit.BTN_SECONDARY)
    y = y + kit.ln(c, 64)
    section(d, x0 + pad, y, "UPDATES")
    y = y + kit.ln(c, 28)
    var auto_label: str = texts.tr("update.auto")
    if config.get_bool(settings(d), "update.auto", true) {
        auto_label = auto_label + ": on"
    } else {
        auto_label = auto_label + ": off"
    }
    btn(d, B_AUTO, x0 + pad, y, auto_label, lucide.DOWNLOAD, kit.BTN_SECONDARY)
}

fn phase_text(d: *mut Ui, s: *mut update.Status) -> str {
    let p: u64 = (*s).phase
    if p == update.PH_CHECKING { return texts.tr("update.checking") }
    if p == update.PH_UPTODATE { return texts.tr1("update.uptodate", "version", appinfo.app_version()) }
    if p == update.PH_AVAILABLE { return texts.tr1("update.available", "version", update.status_version(s)) }
    if p == update.PH_DOWNLOADING {
        var pm: i64 = pct((*s).done, (*s).total)
        if pm < 0 as i64 { pm = 0 as i64 }
        return texts.trn("update.downloading", "percent", (pm / 10 as i64) as f64)
    }
    if p == update.PH_VERIFYING { return texts.tr("update.verifying") }
    if p == update.PH_READY { return texts.tr1("update.ready", "version", update.status_version(s)) }
    if p == update.PH_APPLYING { return texts.tr("update.installing") }
    if p == update.PH_DONE_INSTALLER { return texts.tr("update.installer") }
    if p == update.PH_ERROR { return texts.tr1("update.error", "text", update.status_error(s)) }
    if p == update.PH_UNSUPPORTED { return update.err_text(update.UE_UNSUPPORTED) }
    return ""
}

fn page_updates(d: *mut Ui, x0: f64, w: f64) {
    let c: *mut render.Ctx = &(*d).c
    let up: *mut update.Updater = (*d).up
    let s: *mut update.Status = update.update_status(up)
    let pad: f64 = kit.ln(c, 24)
    var y: f64 = kit.ln(c, 24) + banner_h(d)
    title(d, x0 + pad, y, texts.tr("update.title"))
    y = y + kit.ln(c, 52)
    line(d, x0 + pad, y, texts.tr1("about.version", "version", appinfo.app_version()), w - 2.0 * pad)
    y = y + kit.ln(c, 28)
    // the channel: one button that cycles stabil -> beta -> stabil
    var ch: rt.Buf = rt.buf_new()
    update.update_channel(up, &ch)
    let ch_label: str = texts.tr("update.channel") + ": " + util.buf_to_str_copy(&ch)
    rt.buf_free(&ch)
    btn(d, B_CHANNEL, x0 + pad, y, ch_label, lucide.SETTINGS, kit.BTN_GHOST)
    y = y + kit.ln(c, 52)
    // what the updater says, and the action that fits
    let status: str = phase_text(d, s)
    var kind: u32 = kit.PB_NORMAL
    if (*s).phase == update.PH_ERROR {
        kind = kit.PB_ERROR
    }
    line(d, x0 + pad, y, status, w - 2.0 * pad)
    y = y + kit.ln(c, 32)
    if (*s).phase == update.PH_DOWNLOADING || (*s).phase == update.PH_VERIFYING || (*s).phase == update.PH_CHECKING {
        var pm: i64 = pct((*s).done, (*s).total)
        if (*s).phase == update.PH_CHECKING { pm = -1 as i64 }
        kit.progress_draw(c, x0 + pad, y, w - 2.0 * pad, kit.progress_height(c, true), pm, "", (*d).now, kind)
        y = y + kit.progress_height(c, true) + kit.ln(c, 16)
        btn(d, B_CANCEL, x0 + pad, y, texts.tr("update.cancel"), kit.ICON_NONE, kit.BTN_SECONDARY)
        y = y + kit.ln(c, 52)
    } else if (*s).phase == update.PH_AVAILABLE {
        btn(d, B_DOWNLOAD, x0 + pad, y, texts.tr("update.download"), lucide.DOWNLOAD, kit.BTN_PRIMARY)
        y = y + kit.ln(c, 52)
    } else if (*s).phase == update.PH_READY {
        btn(d, B_INSTALL, x0 + pad, y, texts.tr("update.install"), lucide.DOWNLOAD, kit.BTN_PRIMARY)
        y = y + kit.ln(c, 52)
    } else if (*s).phase == update.PH_ERROR {
        btn(d, B_RETRY, x0 + pad, y, texts.tr("update.retry"), lucide.DOWNLOAD, kit.BTN_SECONDARY)
        y = y + kit.ln(c, 52)
    } else if (*s).phase != update.PH_APPLYING && (*s).phase != update.PH_DONE_INSTALLER {
        btn(d, B_CHECK, x0 + pad, y, texts.tr("update.check"), lucide.DOWNLOAD, kit.BTN_PRIMARY)
        y = y + kit.ln(c, 52)
    }
    // the release notes of the offered version
    if ((*s).phase == update.PH_AVAILABLE || (*s).phase == update.PH_READY) && (*s).nnotes > 0 as u64 {
        section(d, x0 + pad, y, texts.tr("update.notes"))
        y = y + kit.ln(c, 26)
        para(d, x0 + pad, y, w - 2.0 * pad, update.status_notes(s), 10)
    }
}

fn page_about(d: *mut Ui, x0: f64, w: f64) {
    let c: *mut render.Ctx = &(*d).c
    let pad: f64 = kit.ln(c, 24)
    var y: f64 = kit.ln(c, 24) + banner_h(d)
    title(d, x0 + pad, y, texts.tr("about.title"))
    y = y + kit.ln(c, 56)
    line(d, x0 + pad, y, appspec.NAME, w - 2.0 * pad)
    y = y + kit.ln(c, 28)
    line(d, x0 + pad, y, texts.tr1("about.version", "version", appinfo.app_version()), w - 2.0 * pad)
    y = y + kit.ln(c, 28)
    line(d, x0 + pad, y, texts.tr1("about.channel", "channel", appinfo.app_channel()), w - 2.0 * pad)
    y = y + kit.ln(c, 28)
    line(d, x0 + pad, y, texts.tr1("about.platform", "platform", platform.plat_id()), w - 2.0 * pad)
}

// ------------------------------------------------------------ the banner

// the height the banner takes at the top of a page (0 when none)
fn banner_h(d: *mut Ui) -> f64 {
    if !banner_visible(d) {
        return 0.0
    }
    return kit.ln(&(*d).c, 52)
}

fn banner_visible(d: *mut Ui) -> bool {
    if (*d).banner_dismissed || (*d).page == PAGE_UPDATES {
        return false
    }
    let p: u64 = (*update.update_status((*d).up)).phase
    return p == update.PH_AVAILABLE || p == update.PH_READY
}

fn draw_banner(d: *mut Ui, x0: f64, w: f64) {
    if !banner_visible(d) {
        return
    }
    let c: *mut render.Ctx = &(*d).c
    let s: *mut update.Status = update.update_status((*d).up)
    let z: *mut painter.Painter = render.ctx_painter(c)
    let h: f64 = kit.ln(c, 44)
    let pad: f64 = kit.ln(c, 12)
    painter.round_rect(z, x0 + pad, pad, w - 2.0 * pad, h, kit.ln(c, 8), kit.with_alpha(kit.tokc(c, style.TOK_ACCENT), 60 as u32))
    var text: str = texts.tr1("update.banner", "version", update.status_version(s))
    var label: str = texts.tr("update.download")
    var id: u32 = B_BANNER
    if (*s).phase == update.PH_READY {
        text = texts.tr1("update.banner-ready", "version", update.status_version(s))
        label = texts.tr("update.install")
        id = B_INSTALL
    }
    kit.draw_label(c, x0 + pad + kit.ln(c, 16), pad, h, kit.ln(c, 14), 700, kit.tokc(c, style.TOK_TEXT), text, w - kit.ln(c, 260))
    let bw: f64 = kit.button_width(c, label, kit.ICON_NONE)
    let bx: f64 = x0 + w - pad - kit.ln(c, 16) - bw - kit.ln(c, 40)
    btn(d, id, bx, pad + (h - kit.button_height(c)) / 2.0, label, kit.ICON_NONE, kit.BTN_PRIMARY)
    let xs: f64 = kit.ln(c, 28)
    btn(d, B_BANNER_X, x0 + w - pad - xs - kit.ln(c, 4), pad + (h - kit.button_height(c)) / 2.0, "x", kit.ICON_NONE, kit.BTN_GHOST)
}

// --------------------------------------------------------------- the frame

fn ui_attach(ud: u64, z: *mut painter.Painter) {
    let d: *mut Ui = ud as *mut Ui
    (*d).c = render.ctx_new(&(*d).m, z)
    anim.transreg_bind(&(*d).tr, &(*d).c)
}

// What the update status asks of the frame: notice a change, start the
// automatic check, tell the user once, mark this run healthy.
fn tick_update(d: *mut Ui) {
    let up: *mut update.Updater = (*d).up
    if update.update_poll(up) {
        (*d).want_frames = true
    }
    let s: *mut update.Status = update.update_status(up)
    if update.update_busy(up) {
        (*d).want_frames = true
    }
    // once per phase change: a short message
    if (*s).phase != (*d).last_phase {
        (*d).last_phase = (*s).phase
        if (*s).phase == update.PH_READY {
            toast(d, kit.TK_SUCCESS, texts.tr1("update.ready", "version", update.status_version(s)), texts.tr("update.install"))
        } else if (*s).phase == update.PH_ERROR && (*d).page != PAGE_UPDATES {
            toast(d, kit.TK_ERROR, texts.tr1("update.error", "text", update.status_error(s)), "")
        }
    }
    // the first check a moment after start, if it is due
    if !(*d).auto_started && !(*d).selftest && (*d).now - (*d).first_ms > 1500 as i64 {
        (*d).auto_started = true
        if update.update_auto_due(up) {
            var op: u32 = update.OP_CHECK
            if config.get_bool(settings(d), "update.auto_download", false) {
                op = update.OP_FETCH
            }
            update.update_start(up, op, update.RUN_AUTO)
            log.log_info("ui", "automatic update check started")
        }
    }
    // this run is healthy once the window has stood for a few seconds
    if !(*d).healthy_marked && (*d).frames >= 5 as u64 && (*d).now - (*d).first_ms > 3000 as i64 {
        (*d).healthy_marked = true
        update.update_mark_healthy(up)
    }
    // a crash report of the last run: say so once
    if !(*d).crash_note && !(*d).selftest {
        (*d).crash_note = true
        var p: rt.Buf = rt.buf_new()
        if crash.crash_pending(&p) {
            toast(d, kit.TK_WARNING, texts.tr("crash.title"), "")
        }
        rt.buf_free(&p)
    }
}

fn ui_paint(ud: u64, w: usize, h: usize) {
    let d: *mut Ui = ud as *mut Ui
    kitcolor.kit_apply(&(*d).m)
    let c: *mut render.Ctx = &(*d).c
    let f: *mut theme.Colors = theme.theme_colors(&(*d).m)
    painter.painter_clear(render.ctx_painter(c), theme.opaque((*f).base))
    if (*d).quit {
        return
    }
    anim.transreg_new_frame(&(*d).tr)
    (*d).now = render.ctx_time(c)
    if (*d).first_ms == 0 as i64 {
        (*d).first_ms = (*d).now
    }
    (*d).frames = (*d).frames + 1 as u64
    if (*d).frames == 1 as u64 {
        log.log_info("ui", "first frame")
    }
    (*d).win_w = w as f64
    (*d).win_h = h as f64
    (*d).nb = 0
    (*d).want_frames = false
    tick_update(d)
    if (*d).selftest && (*d).frames >= 30 as u64 {
        (*d).quit = true
    }
    var items: [kit.NavItem; 4] = [kit.NavItem { icon: kit.ICON_NONE, label: "", badge: 0, header: false }; 4]
    nav_items(&items)
    let nw: f64 = kit.nav_width(c, (*d).collapsed)
    kit.nav_draw(c, (&items[0]) as *mut kit.NavItem, NAV_N, (*d).page, (*d).nav_hover, false, 0.0, 0.0, nw, h as f64, (*d).collapsed)
    let x0: f64 = nw
    let pw: f64 = (w as f64) - nw
    if (*d).page == PAGE_HOME {
        page_home(d, x0, pw)
    } else if (*d).page == PAGE_SETTINGS {
        page_settings(d, x0, pw)
    } else if (*d).page == PAGE_UPDATES {
        page_updates(d, x0, pw)
    } else {
        page_about(d, x0, pw)
    }
    draw_banner(d, x0, pw)
    if kit.toasts_tick(&(*d).toasts, (*d).now) {
        (*d).want_frames = true
    }
    kit.toasts_draw(c, &(*d).toasts, (*d).win_w, (*d).win_h, (*d).now)
    if (*d).want_frames {
        anim.animator_clear(&(*d).gen)
        anim.animator_add(&(*d).gen, anim.anim_new((*d).now, 100, 0.0, 1.0, anim.easing_linear()))
    }
}

// ------------------------------------------------------------ the actions

fn start_update(d: *mut Ui, op: u32) {
    if !update.update_start((*d).up, op, update.RUN_AUTO) {
        toast(d, kit.TK_WARNING, "...", "")
    }
}

fn install(d: *mut Ui) {
    var none: util.Args = util.args_new()
    let rc: u32 = update.update_apply((*d).up, &none)
    util.args_free(&none)
    if rc == platform.AP_OK {
        // the new program is running (or starting): close this window; main.fi
        // then supervises until the new one confirms itself
        G_RESTART = true
        (*d).quit = true
    } else if rc == platform.AP_STAGED {
        toast(d, kit.TK_INFO, texts.tr("update.installer"), "")
    }
}

fn set_language(d: *mut Ui, code: str) {
    config.set_str(settings(d), "ui.language", code)
    update.update_save_settings((*d).up)
    texts.tr_select(code)
}

fn run_button(d: *mut Ui, id: u32) {
    if id == B_CHECK || id == B_RETRY {
        start_update(d, update.OP_CHECK)
    } else if id == B_DOWNLOAD || id == B_BANNER {
        start_update(d, update.OP_FETCH)
    } else if id == B_INSTALL {
        install(d)
    } else if id == B_CANCEL {
        update.update_cancel((*d).up)
    } else if id == B_AUTO {
        let on: bool = config.get_bool(settings(d), "update.auto", true)
        config.set_bool(settings(d), "update.auto", !on)
        update.update_save_settings((*d).up)
    } else if id == B_CHANNEL {
        var cur: rt.Buf = rt.buf_new()
        update.update_channel((*d).up, &cur)
        if util.buf_eq_str(&cur, "stabil") {
            update.update_set_channel((*d).up, "beta")
        } else {
            update.update_set_channel((*d).up, "stabil")
        }
        rt.buf_free(&cur)
    } else if id == B_DARK {
        theme.theme_set_dark(&(*d).m, true)
        kitcolor.kit_apply(&(*d).m)
        config.set_bool(settings(d), "ui.dark", true)
        update.update_save_settings((*d).up)
    } else if id == B_LIGHT {
        theme.theme_set_dark(&(*d).m, false)
        kitcolor.kit_apply(&(*d).m)
        config.set_bool(settings(d), "ui.dark", false)
        update.update_save_settings((*d).up)
    } else if id == B_LANG_SYS {
        set_language(d, "")
    } else if id == B_LANG_EN {
        set_language(d, "en")
    } else if id == B_LANG_DE {
        set_language(d, "de")
    } else if id == B_BANNER_X {
        (*d).banner_dismissed = true
    }
}

fn ui_press(ud: u64, x: f64, y: f64) {
    let d: *mut Ui = ud as *mut Ui
    let c: *mut render.Ctx = &(*d).c
    fuiwirt.host_touch(&(*d).w)
    var tid: u32 = 0 as u32
    var part: u32 = 0 as u32
    if kit.toasts_hit(c, &(*d).toasts, (*d).win_w, (*d).win_h, x, y, &tid, &part) {
        if part == kit.TOAST_PART_CLOSE || part == kit.TOAST_PART_ACTION {
            kit.toast_dismiss(&(*d).toasts, tid, (*d).now)
            if part == kit.TOAST_PART_ACTION {
                (*d).page = PAGE_UPDATES
            }
        }
        return
    }
    var items: [kit.NavItem; 4] = [kit.NavItem { icon: kit.ICON_NONE, label: "", badge: 0, header: false }; 4]
    nav_items(&items)
    let nw: f64 = kit.nav_width(c, (*d).collapsed)
    let ni: usize = kit.nav_hit(c, (&items[0]) as *mut kit.NavItem, NAV_N, 0.0, 0.0, nw, (*d).collapsed, x, y)
    if ni != kit.NONE {
        (*d).page = ni
        return
    }
    let b: u32 = button_at(d, x, y)
    if b != 0 as u32 {
        (*d).down_btn = b
    }
}

fn ui_hook(ud: u64, kind: u32, x: f64, y: f64) -> bool {
    let d: *mut Ui = ud as *mut Ui
    let c: *mut render.Ctx = &(*d).c
    if kind == fuiwirt.HOOK_LEAVE {
        (*d).nav_hover = kit.NONE
        (*d).hover_btn = 0 as u32
        return true
    }
    if kind == fuiwirt.HOOK_UP {
        let down: u32 = (*d).down_btn
        (*d).down_btn = 0 as u32
        if down != 0 as u32 && button_at(d, x, y) == down {
            run_button(d, down)
        }
        return true
    }
    if kind == fuiwirt.HOOK_MOVE {
        var changed: bool = false
        var items: [kit.NavItem; 4] = [kit.NavItem { icon: kit.ICON_NONE, label: "", badge: 0, header: false }; 4]
        nav_items(&items)
        let nw: f64 = kit.nav_width(c, (*d).collapsed)
        let ni: usize = kit.nav_hit(c, (&items[0]) as *mut kit.NavItem, NAV_N, 0.0, 0.0, nw, (*d).collapsed, x, y)
        if ni != (*d).nav_hover {
            (*d).nav_hover = ni
            changed = true
        }
        let hb: u32 = button_at(d, x, y)
        if hb != (*d).hover_btn {
            (*d).hover_btn = hb
            changed = true
        }
        return changed
    }
    return false
}

fn ui_key(ud: u64, key: u32, mods: u32) -> bool {
    let d: *mut Ui = ud as *mut Ui
    fuiwirt.host_touch(&(*d).w)
    var items: [kit.NavItem; 4] = [kit.NavItem { icon: kit.ICON_NONE, label: "", badge: 0, header: false }; 4]
    nav_items(&items)
    let nx: usize = kit.nav_key((&items[0]) as *mut kit.NavItem, NAV_N, (*d).page, key)
    if nx != (*d).page {
        (*d).page = nx
        return true
    }
    if key == editor.KEY_ESC {
        (*d).quit = true
        return true
    }
    return false
}

fn ui_text(ud: u64, cp: u32, mods: u32) -> bool {
    let d: *mut Ui = ud as *mut Ui
    fuiwirt.host_touch(&(*d).w)
    if (mods & editor.MOD_CTRL) != 0 as u32 {
        // Ctrl+B folds the sidebar (the character arrives as 2)
        if cp == 98 as u32 || cp == 66 as u32 || cp == 2 as u32 {
            (*d).collapsed = !(*d).collapsed
            return true
        }
    }
    return false
}

fn ui_act(ud: u64, i: usize) {
}

fn ui_done(ud: u64) -> bool {
    let d: *mut Ui = ud as *mut Ui
    return (*d).quit
}

fn ui_field(ud: u64, out: *mut [f64; 4]) -> bool {
    return false
}

// Opens the window and runs until it is closed. `up` is the updater main.fi
// made; `selftest` runs 30 frames and closes (the generator's smoke test).
// Returns the exit code of the program.
fn run(up: *mut update.Updater, selftest: bool) -> i32 {
    let n: usize = ui_size()
    let p: u64 = rt.heap_alloc(n)
    if p == 0 as u64 {
        return 12
    }
    let d: *mut Ui = p as *mut Ui
    *d = ui_blank()
    (*d).up = up
    (*d).selftest = selftest
    kitcolor.kit_theme(&(*d).m, config.get_bool(settings(d), "ui.dark", true))
    (*d).w = fuiwirt.host_new(&(*d).sc, &(*d).c)
    fuiwirt.host_set_transitions(&(*d).w, &(*d).tr)
    fuiwirt.host_set_animator(&(*d).w, &(*d).gen)
    fuiwirt.host_set_hook(&(*d).w, d as u64, ui_hook)
    fuiwirt.host_bind(&(*d).w)
    // the title: "<name> <version>"
    var t: rt.Buf = rt.buf_new()
    appinfo.app_title(&t)
    let title_text: str = util.buf_to_str_copy(&t)
    rt.buf_free(&t)
    (*d).hk = apphost.hooks_new(d as u64, &(*d).m, &(*d).w, ui_attach, ui_paint, ui_key,
        ui_text, ui_press, ui_act, ui_done, ui_field, title_text, 960, 640)
    let rc: i32 = apphost.run(&(*d).hk)
    if selftest {
        io_selftest(d)
    }
    return rc
}

fn io_selftest(d: *mut Ui) {
    var b: rt.Buf = rt.buf_new()
    util.buf_push_str(&b, "SELFTEST ok frames=")
    rt.buf_push_dec_u64(&b, (*d).frames)
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}
