// SPDX-License-Identifier: MPL-2.0
// src/main.fi -- @NAME@: the start and the end of the program.
// Generated by tools/newapp.sh; edit freely.
//
// THE ORDER MATTERS, and each step is one line you can read:
//
//   1. the platform layer learns the command line and environment
//   2. appinfo: who this program is (name, version, store, trust anchor)
//   3. update_boot: a worker process (`--appkit-worker`) does its job here and
//      NEVER returns; a freshly updated or rolled back start is noticed
//   4. the log, then the run marker (a crash of the LAST run becomes a report)
//   5. the single instance lock -- after an update the old copy is still
//      closing its window, so a restarted program waits a few seconds
//   6. the texts, in the user's language
//   7. the window (src/ui.fi) -- returns when it is closed
//   8. if the user chose "Restart and install": the update_supervise call
//      waits (headless) until the new version confirms itself, and puts the old
//      one back if it does not
//   9. a clean exit: the run marker is emptied, the lock released
import std.rt
import appkit.appinfo
import appkit.platform
import appkit.update
import appkit.config
import appkit.log
import appkit.crash
import appkit.single_instance
import appkit.texts
import appkit.util
import appspec
import ui

const TEXTS_EN: str = __include_str("../locale/en.opmsg")
const TEXTS_DE: str = __include_str("../locale/de.opmsg")

// The language wants a dispatcher in the program itself: update.thread_dispatch
// answers for appkit's worker thread (Linux x86-64; elsewhere the update
// runs in a second process of this program, which needs nothing here).
fn __thread_work(kind: u64, arg: u64) -> u64 {
    return update.thread_dispatch(kind, arg)
}

fn main(start: u64) -> i32 {
    platform.plat_init(start)
    if !appinfo.appinfo_init(appspec.spec()) {
        return 2
    }
    let u: *mut update.Updater = update.update_new()
    if !update.update_init(u) {
        return 2
    }
    update.update_boot(u)
    let selftest: bool = update.update_user_arg(1) == "--selftest"

    // the log: <state>/logs/app.log, three files of 512 KiB
    var logdir: rt.Buf = rt.buf_new()
    platform.plat_dir(platform.DIR_LOG, appinfo.app_id(), appinfo.app_vendor(), &logdir)
    log.log_open(util.buf_to_str_copy(&logdir), "app", log.LOG_INFO, 524288, 3)
    rt.buf_free(&logdir)
    log.log_info("main", "start " + appinfo.app_name() + " " + appinfo.app_version() + " on " + platform.plat_id())

    // a report of the last run, if it did not end cleanly
    crash.crash_begin()

    // one copy per user (after an update: wait for the old copy to go)
    if !selftest {
        var wait_ms: u64 = 0
        if update.update_started_after_update() || update.update_started_after_rollback() {
            wait_ms = 10000
        }
        if single_instance.single_acquire(wait_ms) == single_instance.SI_HELD {
            log.log_info("main", "another copy is running; leaving")
            return 0
        }
    }

    // texts: appkit's own are built in; yours come from locale/*.opmsg
    texts.tr_register("en", TEXTS_EN)
    texts.tr_register("de", TEXTS_DE)
    var lang: rt.Buf = rt.buf_new()
    config.get_str(update.update_settings(u), "ui.language", "", &lang)
    texts.tr_select(util.buf_to_str_copy(&lang))
    rt.buf_free(&lang)

    let rc: i32 = ui.run(u, selftest)

    if ui.restart_requested() {
        update.update_supervise(u)
    }
    crash.crash_end()
    single_instance.single_release()
    log.log_info("main", "end")
    log.log_close()
    return rc
}
