// src/appspec.fi -- WHO @NAME@ IS. Generated by tools/newapp.sh; edit freely.
//
// Everything the update client and the settings need to know about the
// program in one place. The version is NOT written here: build.sh reads the
// file VERSION and hands it in as FIRN_APP_VERSION, so the number is bumped
// in one file and release.sh publishes exactly what was built.
//
//   FIRN_APP_VERSION   the version (VERSION file)          default "0.0.0-dev"
//   FIRN_APP_CHANNEL   the update channel this build follows   default "stabil"
//   FIRN_APP_STORE     the store address                     default below
//   FIRN_APP_BUILD     the store's build id, when known      default 0
//
// THE STORE KEY below is the TRUST ANCHOR (appkit/appinfo.fi): the Ed25519
// public key the store's catalog is checked against. It was taken from
// @KEY_SOURCE@ when this project was generated. Whoever changes these
// 64 digits makes the program talk to a different store.
import appkit.appinfo

const NAME: str = "@NAME@"
const ID: str = "@ID@"
const VENDOR: str = "@VENDOR@"
const ANDROID_ID: str = "@ANDROID_ID@"
const VERSION: str = __env_or("FIRN_APP_VERSION", "0.0.0-dev")
const CHANNEL: str = __env_or("FIRN_APP_CHANNEL", "stabil")
const STORE_URL: str = __env_or("FIRN_APP_STORE", "@STORE_URL@")
const STORE_KEY: str = "@STORE_KEY@"
const BUILD_ID: str = __env_or("FIRN_APP_BUILD", "0")

export { spec, NAME, ID, VERSION }

fn spec() -> appinfo.AppSpec {
    return appinfo.AppSpec { id: ID, name: NAME, vendor: VENDOR, version: VERSION,
        build: 0, channel: CHANNEL, store_url: STORE_URL, store_key: STORE_KEY,
        android_id: ANDROID_ID }
}
