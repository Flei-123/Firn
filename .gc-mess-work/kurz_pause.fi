// tools/gc_mess/pause.fi — Pausen-Histogramm des GC (Runde 38, Stufe 1).
//
// Workload wie der DOM-Dauerlauf (lib/dom/soak_gc.fi): fortlaufend echte
// Zyklen bauen und fallen lassen. Nach JEDEM Zyklus wird der
// Sammellauf-Zaehler geprueft; bei einem neuen Lauf wird seine Pause
// (gc_pause_ns_last) in eine von neun Klassen einsortiert. So entsteht ein
// echtes Histogramm ALLER Pausen, nicht nur des Hoechstwerts.
//
// Ausgabe: TSV-Stichproben wie der Soak, danach das Histogramm und die
// Summen. Die Konstanten BUDGET_MS/STICHPROBE stellt run.sh per sed um.

import dom
import mess

const BUDGET_MS: i64 = 2000  // GCM_BUDGET_MS
const STICHPROBE: i64 = 1000  // GCM_STICHPROBE

fn t_kopf() {
    var t: [u8; 19] = [
        35, 32, 102, 105, 114, 110, 45, 103, 99, 45, 112, 97, 117, 115, 101, 32, 118, 49, 10,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 19)
}

fn t_spalten() {
    var t: [u8; 76] = [
        35, 32, 115, 112, 97, 108, 116, 101, 110, 58, 32, 116, 95, 109, 115, 9, 122, 121, 107, 108, 101, 110, 9, 114, 115, 115, 95, 107, 105, 98, 9, 108, 101, 98, 101, 110, 100, 101, 9, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 9, 104, 101, 97, 112, 95, 98, 121, 116, 101, 115, 9, 112, 97, 117, 115, 101, 95, 109, 97, 120, 95, 110, 115, 10,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 76)
}

fn t_hist() {
    var t: [u8; 37] = [
        35, 32, 104, 105, 115, 116, 111, 103, 114, 97, 109, 109, 58, 32, 112, 97, 117, 115, 101, 95, 110, 115, 95, 103, 114, 101, 110, 122, 101, 9, 97, 110, 122, 97, 104, 108, 10,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 37)
}

fn t_pause_max() {
    var t: [u8; 15] = [
        35, 32, 112, 97, 117, 115, 101, 95, 109, 97, 120, 95, 110, 115, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 15)
}

fn t_pause_total() {
    var t: [u8; 17] = [
        35, 32, 112, 97, 117, 115, 101, 95, 116, 111, 116, 97, 108, 95, 110, 115, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 17)
}

fn t_laeufe() {
    var t: [u8; 15] = [
        35, 32, 115, 97, 109, 109, 101, 108, 108, 97, 101, 117, 102, 101, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 15)
}

fn t_zyklen() {
    var t: [u8; 9] = [
        35, 32, 122, 121, 107, 108, 101, 110, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 9)
}

fn t_mehrfach() {
    var t: [u8; 22] = [
        35, 32, 117, 101, 98, 101, 114, 115, 101, 104, 101, 110, 95, 109, 101, 104, 114, 102, 97, 99, 104, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 22)
}

fn t_rss() {
    var t: [u8; 10] = [
        35, 32, 114, 115, 115, 95, 107, 105, 98, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 10)
}

fn t_heap() {
    var t: [u8; 13] = [
        35, 32, 104, 101, 97, 112, 95, 98, 121, 116, 101, 115, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 13)
}

fn t_fertig() {
    var t: [u8; 9] = [
        35, 32, 102, 101, 114, 116, 105, 103, 10,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 9)
}

fn t_fehler() {
    var t: [u8; 14] = [
        35, 32, 102, 101, 104, 108, 101, 114, 32, 99, 111, 100, 101, 61,
    ]
    let p: u64 = (&t) as u64
    mess.mess_schreib(p, 14)
}


fn p_ld(a: u64) -> u64 {
    return *(a as *mut u64)
}

fn p_st(a: u64, v: u64) {
    *(a as *mut u64) = v
}

fn p_bucket(ns: u64) -> u64 {
    if ns < 100000 {
        return 0
    }
    if ns < 250000 {
        return 1
    }
    if ns < 500000 {
        return 2
    }
    if ns < 1000000 {
        return 3
    }
    if ns < 2000000 {
        return 4
    }
    if ns < 4000000 {
        return 5
    }
    if ns < 8000000 {
        return 6
    }
    if ns < 16000000 {
        return 7
    }
    return 8
}

fn fehler(code: u64) -> i32 {
    t_fehler()
    mess.mess_u64(code)
    mess.mess_nl()
    return code as i32
}

fn main() -> i32 {
    if !gc_init() {
        return fehler(2)
    }
    t_kopf()
    t_spalten()
    var hist: [u64; 9] = [0; 9]
    var grenzen: [u64; 9] = [100000, 250000, 500000, 1000000, 2000000, 4000000, 8000000, 16000000, 0]
    let hp: u64 = (&hist) as u64
    let gp: u64 = (&grenzen) as u64
    let rss0: u64 = mess.mess_rss_kib()
    if rss0 == 0 {
        return fehler(3)
    }
    let t0: u64 = mess.mess_jetzt_ms()

    var laeufe: u64 = 0
    var mehrfach: u64 = 0
    var zyklen: u64 = 0
    var seit: i64 = 0
    var t: u64 = 0
    var laufen: bool = true
    while laufen {
        let n: u64 = dom.dom_zyklus_bauen() catch 0
        if n != dom.DOM_OBJEKTE_JE_SATZ {
            return fehler(4)
        }
        zyklen = zyklen + 1
        let l: u64 = gc_collections()
        if l > laeufe {
            if l > laeufe + 1 {
                mehrfach = mehrfach + l - laeufe - 1
            }
            let b: u64 = p_bucket(gc_pause_ns_last())
            p_st(hp + b * 8, p_ld(hp + b * 8) + 1)
            laeufe = l
        }
        seit = seit + 1
        if seit >= STICHPROBE {
            seit = 0
            dom.dom_zyklus_verwerfen()
            t = mess.mess_jetzt_ms() - t0
            mess.mess_u64(t)
            mess.mess_tab()
            mess.mess_u64(zyklen)
            mess.mess_tab()
            mess.mess_u64(mess.mess_rss_kib())
            mess.mess_tab()
            mess.mess_u64(gc_live_objects())
            mess.mess_tab()
            mess.mess_u64(gc_collections())
            mess.mess_tab()
            mess.mess_u64(gc_heap_bytes())
            mess.mess_tab()
            mess.mess_u64(gc_pause_ns_max())
            mess.mess_nl()
            if t >= BUDGET_MS as u64 {
                laufen = false
            }
        }
    }
    t_hist()
    var i: u64 = 0
    while i < 9 {
        mess.mess_u64(p_ld(gp + i * 8))
        mess.mess_tab()
        mess.mess_u64(p_ld(hp + i * 8))
        mess.mess_nl()
        i = i + 1
    }
    t_pause_max()
    mess.mess_u64(gc_pause_ns_max())
    mess.mess_nl()
    // Diagnose (Runde 38): laengste Pause je Scheibentyp 0..4.
    var typ: u64 = 0
    while typ < 5 {
        mess.mess_u64(typ)
        mess.mess_tab()
        mess.mess_u64(gc_pause_max_typ(typ))
        mess.mess_nl()
        typ = typ + 1
    }
    t_pause_total()
    mess.mess_u64(gc_pause_ns_total())
    mess.mess_nl()
    t_laeufe()
    mess.mess_u64(gc_collections())
    mess.mess_nl()
    t_zyklen()
    mess.mess_u64(zyklen)
    mess.mess_nl()
    t_mehrfach()
    mess.mess_u64(mehrfach)
    mess.mess_nl()
    t_rss()
    mess.mess_u64(mess.mess_rss_kib())
    mess.mess_nl()
    t_heap()
    mess.mess_u64(gc_heap_bytes())
    mess.mess_nl()
    var ueb: [u8; 1] = [35]
    mess.mess_schreib((&ueb) as u64, 1)
    var sp: [u8; 1] = [32]
    mess.mess_schreib((&sp) as u64, 1)
    mess.mess_u64(gc_ueberlaeufe())
    mess.mess_nl()
    t_fertig()
    return 0
}
