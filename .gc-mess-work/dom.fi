// lib/dom/dom.fi — DOM-Prototyp in Firn (Abnahmepunkt 2, PLAN.md §3).
//
// ZWECK: der Nachweis, dass das gewaehlte Speichermodell (Opt-in-Tracing-GC,
// SPEC §3.5) genau das traegt, woran ein Zaehlverweis scheitert — den
// ZYKLISCHEN Objektgraphen eines DOM. Jede hier gebaute Zyklenart kommt in
// einer echten Browser-Engine wirklich vor:
//
//   1. Knoten <-> Kind      Eltern- UND Kinderzeiger, beide STARK.
//   2. Element extends Node Vererbung mit Attributen (Atom-Kennung -> Wert).
//   3. Knoten <-> Listener  Der Knoten haelt den Listener, der Listener haelt
//                           seinen Knoten (Gecko musste dafuer einen
//                           Zyklensammler nachruesten).
//   4. Sammlung -> Wurzel   Eine live `HTMLCollection` haelt ihren Wurzelknoten.
//   5. Observer -> GcWeak   Haelt sein Ziel NICHT am Leben (Gegenprobe).
//   6. Knoten <-> Wrapper   Der simulierte JS-Wrapper haelt den Knoten, der
//                           Knoten haelt den Wrapper.
//
// Ein Zaehlverweis gibt in 1, 3 und 6 NIE frei. Der Nachweis, dass Firn das
// aufloest, steht in tests/560_dom_zyklen.fi und im Dauerlauf
// lib/dom/soak_gc.fi (Messung: tools/dom_soak/run.sh).
//
// Stufe 0 hat keine Methoden, keine globalen Variablen und keine Sammlungen
// mit veraenderlicher Laenge. Deshalb: Funktionen statt Methoden, Kinderliste
// als einfach verkettete Geschwisterkette, feste Attributzahl.

export {
    Node, Element, Listener, Sammlung, Wrapper, Observer,
    DOM_ART_KNOTEN, DOM_ART_ELEMENT, DOM_ART_TEXT,
    DOM_OBJEKTE_JE_SATZ,
    dom_knoten_neu, dom_element_neu,
    dom_kind_anhaengen, dom_kinder_zaehlen, dom_listener_anhaengen,
    dom_sammlung_neu, dom_sammlung_auffrischen, dom_wrapper_anhaengen,
    dom_observer_neu,
    dom_attribut_setzen, dom_attribut_lesen,
    dom_zyklus_bauen, dom_zyklus_verwerfen, dom_scrub_tief,
    dom_selbsttest, dom_observer_test, dom_observer_lebt, dom_observer_anlegen
}

// --------------------------------------------------------------- Klassen

// Ein Knoten haelt seine Eltern STARK. Damit ist der Zyklus echt und nicht
// per `GcWeak` wegdefiniert — genau das ist der Punkt des Nachweises.
gc class Node {
    eltern: Gc[Node],
    erstes_kind: Gc[Node],
    letztes_kind: Gc[Node],
    naechstes: Gc[Node],
    listener: Gc[Listener],
    wrapper: Gc[Wrapper],
    kennung: u32,
    art: u32,
}

// Praefixlayout (SPEC §4.4): die geerbten Felder liegen vorne, deshalb ist
// jede `Gc[Element]` kostenlos eine `Gc[Node]`.
gc class Element extends Node {
    attr_name: [u32; 4],
    attr_wert: [u32; 4],
    attr_zahl: u32,
}

gc class Listener {
    ziel: Gc[Node],
    naechster: Gc[Listener],
    typ: u32,
}

gc class Sammlung {
    wurzel: Gc[Node],
    laenge: u32,
}

gc class Wrapper {
    knoten: Gc[Node],
    kennung: u32,
}

// Der Observer haelt sein Ziel SCHWACH — er darf es nicht am Leben halten.
gc class Observer {
    ziel: GcWeak[Node],
    treffer: u32,
}

const DOM_ART_KNOTEN: u32 = 1
const DOM_ART_ELEMENT: u32 = 2
const DOM_ART_TEXT: u32 = 3

// Ein Satz aus dom_zyklus_bauen(): 1 Wurzelelement + 3 Kinder + 1 Listener
// + 1 Sammlung + 1 Wrapper.
const DOM_OBJEKTE_JE_SATZ: u64 = 7

// ------------------------------------------------------------- Erzeugung

fn dom_knoten_neu(kennung: u32, art: u32) -> AllocError!Gc[Node] {
    return try gc Node{
        eltern: gc_null[Node](),
        erstes_kind: gc_null[Node](),
        letztes_kind: gc_null[Node](),
        naechstes: gc_null[Node](),
        listener: gc_null[Listener](),
        wrapper: gc_null[Wrapper](),
        kennung: kennung,
        art: art,
    }
}

fn dom_element_neu(kennung: u32) -> AllocError!Gc[Element] {
    return try gc Element{
        eltern: gc_null[Node](),
        erstes_kind: gc_null[Node](),
        letztes_kind: gc_null[Node](),
        naechstes: gc_null[Node](),
        listener: gc_null[Listener](),
        wrapper: gc_null[Wrapper](),
        kennung: kennung,
        art: DOM_ART_ELEMENT,
        attr_name: [0; 4],
        attr_wert: [0; 4],
        attr_zahl: 0,
    }
}

// ------------------------------------------------------------ Baumstruktur

// Haengt `kind` an `eltern` an — BEIDE Richtungen stark. Das ist Zyklus 1.
fn dom_kind_anhaengen(eltern: Gc[Node], kind: Gc[Node]) {
    kind.eltern = eltern
    if eltern.erstes_kind == gc_null[Node]() {
        eltern.erstes_kind = kind
    } else {
        eltern.letztes_kind.naechstes = kind
    }
    eltern.letztes_kind = kind
}

fn dom_kinder_zaehlen(eltern: Gc[Node]) -> u32 {
    var n: u32 = 0
    var c: Gc[Node] = eltern.erstes_kind
    while c != gc_null[Node]() {
        n = n + 1
        c = c.naechstes
    }
    return n
}

// Zyklus 3: der Knoten haelt den Listener, der Listener haelt den Knoten.
fn dom_listener_anhaengen(knoten: Gc[Node], typ: u32) -> AllocError!Gc[Listener] {
    let l = try gc Listener{
        ziel: knoten,
        naechster: knoten.listener,
        typ: typ,
    }
    knoten.listener = l
    return l
}

// Zyklus 4: eine live Sammlung haelt ihre Wurzel.
fn dom_sammlung_neu(wurzel: Gc[Node]) -> AllocError!Gc[Sammlung] {
    return try gc Sammlung{ wurzel: wurzel, laenge: 0 }
}

fn dom_sammlung_auffrischen(s: Gc[Sammlung]) -> u32 {
    let n: u32 = dom_kinder_zaehlen(s.wurzel)
    s.laenge = n
    return n
}

// Zyklus 6: JS-Wrapper <-> Knoten.
fn dom_wrapper_anhaengen(knoten: Gc[Node], kennung: u32) -> AllocError!Gc[Wrapper] {
    let w = try gc Wrapper{ knoten: knoten, kennung: kennung }
    knoten.wrapper = w
    return w
}

// Gegenprobe 5: schwacher Verweis, haelt das Ziel NICHT.
fn dom_observer_neu(ziel: Gc[Node]) -> AllocError!Gc[Observer] {
    return try gc Observer{ ziel: weak(ziel), treffer: 0 }
}

// ------------------------------------------------------------- Attribute

fn dom_attribut_setzen(e: Gc[Element], name: u32, wert: u32) -> bool {
    var i: usize = 0
    while i < 4 {
        if e.attr_name[i] == name {
            e.attr_wert[i] = wert
            return true
        }
        i = i + 1
    }
    if e.attr_zahl >= 4 {
        return false
    }
    let k: usize = e.attr_zahl as usize
    e.attr_name[k] = name
    e.attr_wert[k] = wert
    e.attr_zahl = e.attr_zahl + 1
    return true
}

// 0 = nicht vorhanden (die Atom-Kennung 0 ist reserviert).
fn dom_attribut_lesen(e: Gc[Element], name: u32) -> u32 {
    var i: usize = 0
    while i < 4 {
        if i < e.attr_zahl as usize && e.attr_name[i] == name {
            return e.attr_wert[i]
        }
        i = i + 1
    }
    return 0
}

// ---------------------------------------------------------- Dauerlauf-Satz

// Baut EINEN vollstaendigen Zyklus-Satz (Arten 1, 2, 3, 4 und 6) und liefert
// die Zahl der dabei angelegten Objekte.
//
// EHRLICHER HINWEIS: Stufe 0 hat keine globalen Variablen. Der Satz haengt
// deshalb ausschliesslich an den Rahmenzellen DIESER Funktion und ist mit der
// Rueckkehr unerreichbar — genau das ist fuer den Dauerlauf gewollt. Ein
// Zaehlverweis wuerde hier nichts freigeben (Kind haelt Eltern, Eltern halten
// Kind; Listener haelt Knoten, Knoten haelt Listener).
fn dom_zyklus_bauen() -> AllocError!u64 {
    let w = try dom_element_neu(1)
    let wurzel: Gc[Node] = w
    if !dom_attribut_setzen(w, 7, 42) {
        return 0
    }

    var i: u32 = 0
    while i < 3 {
        let k = try dom_knoten_neu(100 + i, DOM_ART_TEXT)
        dom_kind_anhaengen(wurzel, k)
        // Rueckverweis pruefen, damit der Zyklus nicht wegoptimiert wird.
        if k.eltern != wurzel {
            return 0
        }
        i = i + 1
    }

    let l = try dom_listener_anhaengen(wurzel, 5)
    if l.ziel != wurzel {
        return 0
    }
    let s = try dom_sammlung_neu(wurzel)
    if dom_sammlung_auffrischen(s) != 3 {
        return 0
    }
    let wr = try dom_wrapper_anhaengen(wurzel, 9)
    if wr.knoten != wurzel {
        return 0
    }
    return DOM_OBJEKTE_JE_SATZ
}

// Laesst den zuletzt gebauten Satz sicher unerreichbar werden.
//
// Der Satz ist mit der Rueckkehr aus `dom_zyklus_bauen()` bereits nicht mehr
// erreichbar; was bleiben kann, sind ALTE ZEIGER in aufgegebenen Stapelrahmen.
// Der Stapelscan des Sammlers ist konservativ (SPEC §3.5.3) — ein solcher
// Altzeiger haelt ein laengst totes Objekt am Leben. Diese Funktion legt einen
// tiefen, mit Nullen beschriebenen Rahmen ueber genau diesen Bereich. Das ist
// der ehrliche Preis des konservativen Scans, hier bezahlt statt verschwiegen.
fn dom_zyklus_verwerfen() {
    dom_scrub_tief(3)
}

// Der Selbstaufruf ist Absicht und keine Spielerei: eine rekursive Funktion
// wird NIE eingebettet (compiler/src/inline.rs). Nur dadurch liegen die
// genullten Rahmen wirklich UNTERHALB des Aufrufers — eingebettet waeren sie
// Teil seines eigenen, LEBENDEN Rahmens und wuerden gar nichts saeubern.
// Dieselbe Bauart benutzt die Laufzeit in lib/gc/gc.fi (`__gc_scrub_tief`).
fn dom_scrub_tief(n: u64) {
    var puffer: [u64; 512] = [0; 512]
    var i: usize = 0
    while i < 512 {
        puffer[i] = 0
        i = i + 1
    }
    barrier(&puffer)
    if n > 0 {
        dom_scrub_tief(n - 1)
    }
}

// ---------------------------------------------------------- Selbsttest

// Prueft jede Zyklenart einzeln. 0 = alles in Ordnung, sonst Fehlercode.
fn dom_selbsttest() -> i32 {
    // --- Art 1: Eltern <-> Kind, beide stark
    let e = dom_element_neu(1) catch gc_null[Element]()
    if e == gc_null[Element]() {
        return 1
    }
    let wurzel: Gc[Node] = e
    let k1 = dom_knoten_neu(11, DOM_ART_TEXT) catch gc_null[Node]()
    let k2 = dom_knoten_neu(12, DOM_ART_TEXT) catch gc_null[Node]()
    if k1 == gc_null[Node]() || k2 == gc_null[Node]() {
        return 2
    }
    dom_kind_anhaengen(wurzel, k1)
    dom_kind_anhaengen(wurzel, k2)
    if wurzel.erstes_kind != k1 || wurzel.letztes_kind != k2 {
        return 3
    }
    if k1.eltern != wurzel || k2.eltern != wurzel {
        return 4
    }
    if k1.eltern.erstes_kind != k1 {
        return 5
    }
    if dom_kinder_zaehlen(wurzel) != 2 {
        return 6
    }

    // --- Art 2: Vererbung und Attribute
    if !dom_attribut_setzen(e, 7, 42) {
        return 7
    }
    if !dom_attribut_setzen(e, 8, 43) {
        return 8
    }
    if dom_attribut_lesen(e, 7) != 42 || dom_attribut_lesen(e, 8) != 43 {
        return 9
    }
    if dom_attribut_lesen(e, 99) != 0 {
        return 10
    }
    // Aufwaertsumwandlung ist kostenlos, abwaerts nur geprueft.
    if wurzel.as?[Element] == gc_null[Element]() {
        return 11
    }
    if k1.as?[Element] != gc_null[Element]() {
        return 12
    }

    // --- Art 3: Knoten <-> Listener
    let l = dom_listener_anhaengen(wurzel, 5) catch gc_null[Listener]()
    if l == gc_null[Listener]() {
        return 13
    }
    if wurzel.listener != l || l.ziel != wurzel {
        return 14
    }
    if wurzel.listener.ziel.listener != l {
        return 15
    }

    // --- Art 4: Sammlung haelt ihre Wurzel
    let s = dom_sammlung_neu(wurzel) catch gc_null[Sammlung]()
    if s == gc_null[Sammlung]() {
        return 16
    }
    if dom_sammlung_auffrischen(s) != 2 || s.wurzel != wurzel {
        return 17
    }

    // --- Art 6: Knoten <-> JS-Wrapper
    let w = dom_wrapper_anhaengen(wurzel, 9) catch gc_null[Wrapper]()
    if w == gc_null[Wrapper]() {
        return 18
    }
    if wurzel.wrapper != w || w.knoten != wurzel {
        return 19
    }

    // Ein Sammellauf mitten im Betrieb darf nichts Erreichbares wegnehmen.
    let vorher: u64 = gc_collections()
    gc_collect()
    if gc_collections() != vorher + 1 {
        return 20
    }
    if wurzel.listener.ziel != wurzel || w.knoten.wrapper != w {
        return 21
    }
    if dom_kinder_zaehlen(wurzel) != 2 {
        return 22
    }
    if dom_attribut_lesen(e, 7) != 42 {
        return 23
    }

    return 0
}

// --- Art 5: Observer ueber GcWeak haelt sein Ziel NICHT.
//
// BEWUSST EINE EIGENE FUNKTION, und das ist der interessante Teil des
// Nachweises: der Stapelscan ist KONSERVATIV (SPEC §3.5.3). Stuende diese
// Pruefung im Rumpf von `dom_selbsttest`, laege dort noch eine alte Kopie des
// starken Zeigers in einer Rahmenzelle dieser LEBENDEN Funktion — und ein
// konservativer Sammler muss eine solche Zelle als Wurzel behandeln. Das Ziel
// ueberlebte dann, und der Test wuerde eine Eigenschaft messen, die die
// Sprache gar nicht zusagt.
//
// Nachgemessen: genau so verhaelt es sich. Mit `--no-pass=inline` besteht die
// Pruefung auch im Rumpf von `dom_selbsttest`, mit Einbettung nicht — die
// eingebetteten Zellen werden Teil des lebenden Rahmens. Deshalb steht sie
// hier, mit flachem Aufrufer und ohne weitere lebende Gc-Werte.
//
// 0 = das nur schwach beobachtete Ziel wurde eingesammelt.
fn dom_observer_test() -> i32 {
    var beo: Gc[Observer] = gc_null[Observer]()
    let rc: i32 = dom_observer_anlegen(&beo)
    if rc != 0 {
        return rc
    }
    if beo == gc_null[Observer]() {
        return 4
    }
    // Solange der starke Zeiger im Rahmen von `dom_observer_anlegen` lebte,
    // war das Ziel erreichbar; jetzt haengt es nur noch am schwachen Verweis.
    if !dom_observer_lebt(beo, 1) {
        return 5
    }
    dom_zyklus_verwerfen()
    gc_collect()
    if dom_observer_lebt(beo, 1) {
        return 6
    }
    // Der Beobachter selbst lebt weiter — nur sein Ziel ist fort.
    if beo.treffer != 0 {
        return 7
    }
    return 0
}

// Lebt das Ziel des Beobachters noch? Die Antwort ist ein `bool` — und das ist
// keine Kosmetik: wuerde hier ein `Gc[Node]` zurueckgegeben, laege der starke
// Zeiger in einer Rahmenzelle des LEBENDEN Aufrufers, und der konservative
// Scan muesste ihn als Wurzel behandeln. Die Frage wuerde ihre eigene Antwort
// veraendern. Nachgemessen: mit `stark(b.ziel)` unmittelbar im Aufrufer faellt
// die Pruefung unter `--no-opt` durch, mit dieser Fassung besteht sie in allen
// drei Baustufen.
//
// Der Selbstaufruf haelt die Funktion aus dem Einbetter heraus (inline.rs) —
// eingebettet laege der starke Zeiger wieder im lebenden Rahmen.
fn dom_observer_lebt(b: Gc[Observer], tiefe: u64) -> bool {
    if tiefe > 0 {
        return dom_observer_lebt(b, tiefe - 1)
    }
    return stark(b.ziel) != gc_null[Node]()
}

// Legt ein Ziel an, das NUR schwach beobachtet wird: der starke Zeiger lebt
// ausschliesslich im Rahmen dieser Funktion.
fn dom_observer_anlegen(aus: *mut Gc[Observer]) -> i32 {
    let ziel = dom_knoten_neu(77, DOM_ART_KNOTEN) catch gc_null[Node]()
    if ziel == gc_null[Node]() {
        return 1
    }
    let b = dom_observer_neu(ziel) catch gc_null[Observer]()
    if b == gc_null[Observer]() {
        return 2
    }
    if stark(b.ziel) != ziel {
        return 3
    }
    *aus = b
    return 0
}
