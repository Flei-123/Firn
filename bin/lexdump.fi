// bin/lexdump.fi — Tokenstrom im Format von `firnc0 --emit=tokens`.
//
// Liest den Quelltext von der Standardeingabe und schreibt den Tokenstrom
// auf die Standardausgabe. Das Format ist ABSICHTLICH bis auf das Oktett
// dasselbe wie `firnc0 --emit=tokens` — nur so laesst sich der in Firn
// geschriebene Lexer gegen den in Rust geschriebenen pruefen
// (`tools/lex_compare.sh`).
//
// Rust schreibt "{:>4}:{:<4} {:?}": Zeile rechtsbuendig auf vier Stellen,
// Doppelpunkt, Spalte linksbuendig auf vier Stellen, Leerzeichen, dann die
// Debug-Form der Tokenart.

import rt
import lexer
import diag

const L_BYTES: u32 = 0
const L_STR: u32 = 1
const L_STR16: u32 = 2

fn write_lit(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(b, p, n)
}

// rechtsbuendig auf `breite`
fn dec_right(b: *mut rt.Buf, v: u64, width: usize) {
    var digits: usize = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        digits = digits + 1
    }
    var i: usize = digits
    while i < width {
        rt.buf_push(b, 32 as u8)
        i = i + 1
    }
    rt.buf_push_dec_u64(b, v)
}

// linksbuendig auf `breite`
fn dec_left(b: *mut rt.Buf, v: u64, width: usize) {
    var digits: usize = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        digits = digits + 1
    }
    rt.buf_push_dec_u64(b, v)
    var i: usize = digits
    while i < width {
        rt.buf_push(b, 32 as u8)
        i = i + 1
    }
}

fn main(start: u64) -> i32 {
    // --- Quelle lesen: entweder aus einer Datei (erstes Argument) oder von
    // der Standardeingabe. Der DATEINAME wird gebraucht, weil er in jeder
    // Diagnose steht — ohne Aufrufargumente (Runde 21) ginge das nicht.
    var source: rt.Buf = rt.buf_new()
    defer rt.buf_free(&source)
    var name: u64 = 0
    var name_n: usize = 0
    if rt.arg_count(start) > 1 {
        name = rt.arg_ptr(start, 1)
        name_n = rt.c_length(name)
        if !rt.read_file(name, &source) {
            return 2
        }
    } else {
        var sn: [u8; 7] = "<stdin>"
        name = (&sn[0]) as u64
        name_n = 7
        if !rt.read_stdin(&source) {
            return 2
        }
    }

    // --- Worttafeln (Firn hat keine veraenderlichen globalen Zustaende)
    var kwtxt: [u8; 172] = "fn|let|var|if|else|while|return|struct|const|profile|as|mut|true|false|syscall|extern|break|continue|defer|errdefer|comptime|for|in|import|export|enum|match|error|try|catch"
    var namtxt: [u8; 454] = "Int|Ident|Float|Str|KwFn|KwLet|KwVar|KwIf|KwElse|KwWhile|KwReturn|KwStruct|KwConst|KwProfile|KwAs|KwMut|KwTrue|KwFalse|KwSyscall|KwExtern|KwBreak|KwContinue|KwDefer|KwErrDefer|KwComptime|KwFor|KwIn|KwImport|KwExport|KwEnum|KwMatch|KwError|KwTry|KwCatch|LParen|RParen|LBrace|RBrace|LBracket|RBracket|Comma|Colon|Semi|Dot|DotDot|Arrow|Assign|Plus|Minus|Star|Slash|Percent|Amp|Pipe|Caret|Shl|Shr|AndAnd|OrOr|Not|Question|Hash|EqEq|NotEq|Lt|Le|Gt|Ge|Eof|FStr"
    var lktxt: [u8; 15] = "Bytes|Str|Str16"

    var names: lexer.Table = lexer.table_new()
    defer lexer.table_free(&names)
    lexer.tab_build(&names, (&namtxt[0]) as u64, 454)

    var litarten: lexer.Table = lexer.table_new()
    defer lexer.table_free(&litarten)
    lexer.tab_build(&litarten, (&lktxt[0]) as u64, 15)

    var l: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&source), rt.buf_len(&source),
                                       (&kwtxt[0]) as u64, 172, name, name_n)
    defer lexer.lex_free(&l)
    lexer.lex_run(&l)

    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)

    var i: usize = 0
    while i < lexer.lex_count(&l) {
        let kind: u32 = lexer.lex_kind(&l, i)
        dec_right(&out, lexer.lex_line(&l, i) as u64, 4)
        rt.buf_push(&out, 58 as u8)
        dec_left(&out, lexer.lex_col(&l, i) as u64, 4)
        rt.buf_push(&out, 32 as u8)
        // Name der Art
        write_lit(&out, lexer.tab_ptr(&names, kind as usize),
                    lexer.tab_length(&names, kind as usize))
        if kind == 0 {
            // Int(...)
            rt.buf_push(&out, 40 as u8)
            rt.buf_push_dec_u64(&out, lexer.lex_number(&l, i))
            rt.buf_push(&out, 41 as u8)
        } else if kind == 2 {
            // Float(bitmuster)
            rt.buf_push(&out, 40 as u8)
            rt.buf_push_dec_u64(&out, lexer.lex_number(&l, i))
            rt.buf_push(&out, 41 as u8)
        } else if kind == 1 {
            // Ident("name")
            let nr: u32 = lexer.lex_nr(&l, i)
            rt.buf_push(&out, 40 as u8)
            rt.buf_push(&out, 34 as u8)
            write_lit(&out, lexer.lex_name_ptr(&l, nr), lexer.lex_name_length(&l, nr))
            rt.buf_push(&out, 34 as u8)
            rt.buf_push(&out, 41 as u8)
        } else if kind == 69 {
            // FStr("roh") — Interpolation (Runde 39); die Maskierung ist
            // die Debug-Form einer Rust-Zeichenkette, damit der Strom
            // oktettgleich mit `firnc0 --emit=tokens` bleibt.
            let k: usize = lexer.lex_nr(&l, i) as usize
            let n: usize = lexer.lex_lit_len(&l, k)
            rt.buf_push(&out, 40 as u8)
            rt.buf_push(&out, 34 as u8)
            var j2: usize = 0
            while j2 < n {
                let b: u32 = lexer.lex_lit_byte(&l, k, j2) as u32
                if b == 34 || b == 92 {
                    rt.buf_push(&out, 92 as u8)
                    rt.buf_push(&out, b as u8)
                } else if b == 10 {
                    rt.buf_push(&out, 92 as u8)
                    rt.buf_push(&out, 110 as u8)
                } else if b == 9 {
                    rt.buf_push(&out, 92 as u8)
                    rt.buf_push(&out, 116 as u8)
                } else if b == 13 {
                    rt.buf_push(&out, 92 as u8)
                    rt.buf_push(&out, 114 as u8)
                } else {
                    rt.buf_push(&out, b as u8)
                }
                j2 = j2 + 1
            }
            rt.buf_push(&out, 34 as u8)
            rt.buf_push(&out, 41 as u8)
        } else if kind == 3 {
            // Str(Art, Octets([..])) bzw. Str(Str16, Units([..]))
            let k: usize = lexer.lex_nr(&l, i) as usize
            let la: u32 = lexer.lex_lit_kind(&l, k)
            let n: usize = lexer.lex_lit_len(&l, k)
            rt.buf_push(&out, 40 as u8)
            write_lit(&out, lexer.tab_ptr(&litarten, la as usize),
                        lexer.tab_length(&litarten, la as usize))
            rt.buf_push(&out, 44 as u8)
            rt.buf_push(&out, 32 as u8)
            if la == L_STR16 {
                var u: [u8; 6] = "Units("
                write_lit(&out, (&u[0]) as u64, 6)
            } else {
                var o: [u8; 7] = "Octets("
                write_lit(&out, (&o[0]) as u64, 7)
            }
            rt.buf_push(&out, 91 as u8)
            var j: usize = 0
            while j < n {
                if j > 0 {
                    rt.buf_push(&out, 44 as u8)
                    rt.buf_push(&out, 32 as u8)
                }
                if la == L_STR16 {
                    rt.buf_push_dec_u64(&out, lexer.lex_lit_unit(&l, k, j) as u64)
                } else {
                    rt.buf_push_dec_u64(&out, lexer.lex_lit_byte(&l, k, j) as u64)
                }
                j = j + 1
            }
            rt.buf_push(&out, 93 as u8)
            rt.buf_push(&out, 41 as u8)
            rt.buf_push(&out, 41 as u8)
        }
        rt.buf_push(&out, 10 as u8)
        i = i + 1
    }
    if !rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out)) {
        return 3
    }
    // --- Diagnosen auf die Fehlerausgabe, im Format von `firnc0`.
    if lexer.lex_error(&l) > 0 {
        var fb: rt.Buf = rt.buf_new()
        defer rt.buf_free(&fb)
        diag.diag_render(lexer.lex_diags(&l), &fb)
        rt.write_everything(2, rt.buf_ptr(&fb), rt.buf_len(&fb))
        return 1
    }
    // Zaehlwerte auf die FEHLERausgabe — der Vergleich mit `firnc0` liest nur
    // die Standardausgabe und bleibt davon unberuehrt.
    var stat: rt.Buf = rt.buf_new()
    defer rt.buf_free(&stat)
    var t1: [u8; 9] = "; tokens "
    rt.buf_push_bytes(&stat, (&t1[0]) as u64, 9)
    rt.buf_push_dec_u64(&stat, lexer.lex_count(&l) as u64)
    var t2: [u8; 16] = "  gleit_langsam "
    rt.buf_push_bytes(&stat, (&t2[0]) as u64, 16)
    rt.buf_push_dec_u64(&stat, lexer.lex_float_slow(&l) as u64)
    var t3: [u8; 9] = "  fehler "
    rt.buf_push_bytes(&stat, (&t3[0]) as u64, 9)
    rt.buf_push_dec_u64(&stat, lexer.lex_error(&l) as u64)
    rt.buf_push(&stat, 10 as u8)
    rt.write_everything(2, rt.buf_ptr(&stat), rt.buf_len(&stat))
    return 0
}
