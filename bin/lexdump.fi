// bin/lexdump.fi — Tokenstrom im Format von `firnc0 --emit=tokens`.
//
// Liest den Quelltext von der Standardeingabe und schreibt den Tokenstrom
// auf die Standardausgabe. Das Format ist ABSICHTLICH bis auf das Oktett
// dasselbe wie `firnc0 --emit=tokens` — nur so laesst sich der in Firn
// geschriebene Lexer gegen den in Rust geschriebenen pruefen
// (`tools/lex_vergleich.sh`).
//
// Rust schreibt "{:>4}:{:<4} {:?}": Zeile rechtsbuendig auf vier Stellen,
// Doppelpunkt, Spalte linksbuendig auf vier Stellen, Leerzeichen, dann die
// Debug-Form der Tokenart.

import rt
import lexer

const L_BYTES: u32 = 0
const L_STR: u32 = 1
const L_STR16: u32 = 2

fn schreib_lit(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(b, p, n)
}

// rechtsbuendig auf `breite`
fn dez_rechts(b: *mut rt.Buf, v: u64, breite: usize) {
    var stellen: usize = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        stellen = stellen + 1
    }
    var i: usize = stellen
    while i < breite {
        rt.buf_push(b, 32 as u8)
        i = i + 1
    }
    rt.buf_push_dez_u64(b, v)
}

// linksbuendig auf `breite`
fn dez_links(b: *mut rt.Buf, v: u64, breite: usize) {
    var stellen: usize = 1
    var t: u64 = v
    while t >= 10 {
        t = t / 10
        stellen = stellen + 1
    }
    rt.buf_push_dez_u64(b, v)
    var i: usize = stellen
    while i < breite {
        rt.buf_push(b, 32 as u8)
        i = i + 1
    }
}

fn main() -> i32 {
    // --- Quelle lesen
    var quelle: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&quelle)
    if !rt.lies_stdin(&quelle) {
        return 2
    }

    // --- Worttafeln (Firn hat keine veraenderlichen globalen Zustaende)
    var kwtxt: [u8; 172] = "fn|let|var|if|else|while|return|struct|const|profile|as|mut|true|false|syscall|extern|break|continue|defer|errdefer|comptime|for|in|import|export|enum|match|error|try|catch"
    var namtxt: [u8; 449] = "Int|Ident|Float|Str|KwFn|KwLet|KwVar|KwIf|KwElse|KwWhile|KwReturn|KwStruct|KwConst|KwProfile|KwAs|KwMut|KwTrue|KwFalse|KwSyscall|KwExtern|KwBreak|KwContinue|KwDefer|KwErrDefer|KwComptime|KwFor|KwIn|KwImport|KwExport|KwEnum|KwMatch|KwError|KwTry|KwCatch|LParen|RParen|LBrace|RBrace|LBracket|RBracket|Comma|Colon|Semi|Dot|DotDot|Arrow|Assign|Plus|Minus|Star|Slash|Percent|Amp|Pipe|Caret|Shl|Shr|AndAnd|OrOr|Not|Question|Hash|EqEq|NotEq|Lt|Le|Gt|Ge|Eof"
    var lktxt: [u8; 15] = "Bytes|Str|Str16"

    var namen: lexer.Tafel = lexer.tafel_neu()
    defer lexer.tafel_frei(&namen)
    lexer.tab_bauen(&namen, (&namtxt[0]) as u64, 449)

    var litarten: lexer.Tafel = lexer.tafel_neu()
    defer lexer.tafel_frei(&litarten)
    lexer.tab_bauen(&litarten, (&lktxt[0]) as u64, 15)

    var l: lexer.Lexer = lexer.lex_neu(rt.buf_ptr(&quelle), rt.buf_len(&quelle),
                                       (&kwtxt[0]) as u64, 172)
    defer lexer.lex_frei(&l)
    lexer.lex_lauf(&l)

    var aus: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&aus)

    var i: usize = 0
    while i < lexer.lex_anzahl(&l) {
        let art: u32 = lexer.lex_art(&l, i)
        dez_rechts(&aus, lexer.lex_zeile(&l, i) as u64, 4)
        rt.buf_push(&aus, 58 as u8)
        dez_links(&aus, lexer.lex_spalte(&l, i) as u64, 4)
        rt.buf_push(&aus, 32 as u8)
        // Name der Art
        schreib_lit(&aus, lexer.tab_zeiger(&namen, art as usize),
                    lexer.tab_laenge(&namen, art as usize))
        if art == 0 {
            // Int(...)
            rt.buf_push(&aus, 40 as u8)
            rt.buf_push_dez_u64(&aus, lexer.lex_zahl(&l, i))
            rt.buf_push(&aus, 41 as u8)
        } else if art == 2 {
            // Float(bitmuster)
            rt.buf_push(&aus, 40 as u8)
            rt.buf_push_dez_u64(&aus, lexer.lex_zahl(&l, i))
            rt.buf_push(&aus, 41 as u8)
        } else if art == 1 {
            // Ident("name")
            let nr: u32 = lexer.lex_nr(&l, i)
            rt.buf_push(&aus, 40 as u8)
            rt.buf_push(&aus, 34 as u8)
            schreib_lit(&aus, lexer.lex_name_zeiger(&l, nr), lexer.lex_name_laenge(&l, nr))
            rt.buf_push(&aus, 34 as u8)
            rt.buf_push(&aus, 41 as u8)
        } else if art == 3 {
            // Str(Art, Octets([..])) bzw. Str(Str16, Units([..]))
            let k: usize = lexer.lex_nr(&l, i) as usize
            let la: u32 = lexer.lex_lit_art(&l, k)
            let n: usize = lexer.lex_lit_len(&l, k)
            rt.buf_push(&aus, 40 as u8)
            schreib_lit(&aus, lexer.tab_zeiger(&litarten, la as usize),
                        lexer.tab_laenge(&litarten, la as usize))
            rt.buf_push(&aus, 44 as u8)
            rt.buf_push(&aus, 32 as u8)
            if la == L_STR16 {
                var u: [u8; 6] = "Units("
                schreib_lit(&aus, (&u[0]) as u64, 6)
            } else {
                var o: [u8; 7] = "Octets("
                schreib_lit(&aus, (&o[0]) as u64, 7)
            }
            rt.buf_push(&aus, 91 as u8)
            var j: usize = 0
            while j < n {
                if j > 0 {
                    rt.buf_push(&aus, 44 as u8)
                    rt.buf_push(&aus, 32 as u8)
                }
                if la == L_STR16 {
                    rt.buf_push_dez_u64(&aus, lexer.lex_lit_einheit(&l, k, j) as u64)
                } else {
                    rt.buf_push_dez_u64(&aus, lexer.lex_lit_byte(&l, k, j) as u64)
                }
                j = j + 1
            }
            rt.buf_push(&aus, 93 as u8)
            rt.buf_push(&aus, 41 as u8)
            rt.buf_push(&aus, 41 as u8)
        }
        rt.buf_push(&aus, 10 as u8)
        i = i + 1
    }
    if !rt.schreib_alles(1, rt.buf_ptr(&aus), rt.buf_len(&aus)) {
        return 3
    }
    // Zaehlwerte auf die FEHLERausgabe — der Vergleich mit `firnc0` liest nur
    // die Standardausgabe und bleibt davon unberuehrt.
    var stat: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&stat)
    var t1: [u8; 9] = "; tokens "
    rt.buf_push_bytes(&stat, (&t1[0]) as u64, 9)
    rt.buf_push_dez_u64(&stat, lexer.lex_anzahl(&l) as u64)
    var t2: [u8; 16] = "  gleit_langsam "
    rt.buf_push_bytes(&stat, (&t2[0]) as u64, 16)
    rt.buf_push_dez_u64(&stat, lexer.lex_gleit_langsam(&l) as u64)
    var t3: [u8; 9] = "  fehler "
    rt.buf_push_bytes(&stat, (&t3[0]) as u64, 9)
    rt.buf_push_dez_u64(&stat, lexer.lex_fehler(&l) as u64)
    rt.buf_push(&stat, 10 as u8)
    rt.schreib_alles(2, rt.buf_ptr(&stat), rt.buf_len(&stat))
    if lexer.lex_fehler(&l) > 0 {
        return 1
    }
    return 0
}
