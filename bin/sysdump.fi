// bin/sysdump.fi -- prints the system call table of `lib/firnc1/syscalls.fi`.
//
// ROUND ARM-FREESTANDING. One line per entry:
//
//     <canonical x86-64 number> <shape> <aarch64 number>
//
// `tools/aarch64/syscall_table.sh` builds this program with firnc0 AND with
// firnc1 and compares both outputs against the table in
// `compiler/src/syscalls.rs`. That is the whole point: the Firn table is
// not believed, it is READ OUT of a running program.
import rt
import syscalls

fn main(start: u64) -> i32 {
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    var n: i64 = 0
    var sh: u32 = 0
    while n < 400 {
        sh = 0
        let a: i64 = syscalls.aarch64(n, &sh)
        if sh != 0 {
            rt.buf_push_dec_i64(&out, n)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_i64(&out, sh as i64)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_i64(&out, a)
            rt.buf_push(&out, 10 as u8)
        }
        n = n + 1
    }
    rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}
