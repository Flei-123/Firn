// bin/astdump.fi — kanonische AST-Ausgabe im Format von
// `firnc0 --emit=ast-kanon`.
//
// Damit laesst sich der Parser in Firn gegen den Parser in Rust pruefen:
// zwei unabhaengige Umsetzungen muessen denselben Text erzeugen, wenn — und
// nur wenn — sie denselben Baum gebaut haben.
//
// Rueckgabewerte: 0 = Ausgabe erzeugt · 1 = Syntaxfehler ·
// 3 = die Datei benutzt eine Erweiterung, die dieser Parser nicht kennt
// (`enum`/`match`, Fehlerunionen, Generics, `gc class`, Attribute, `comptime`).

import rt
import vec
import intern
import lexer
import ast
import parser

fn schreib(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(b, p, n)
}

fn name_aus(it: *mut intern.Interner, b: *mut rt.Buf, nr: u32) {
    rt.buf_push_bytes(b, intern.intern_zeiger(it, nr), intern.intern_laenge(it, nr))
}

fn zeichen(b: *mut rt.Buf, c: u32) {
    rt.buf_push(b, c as u8)
}

// ------------------------------------------------------------------- Typen

fn drucke_typ(t: *mut ast.Baum, it: *mut intern.Interner, b: *mut rt.Buf, i: u32) {
    if i == ast.NICHTS {
        zeichen(b, 45)
        return
    }
    let a: u32 = ast.t_art(t, i)
    if a == ast.T_NAME {
        name_aus(it, b, ast.t_a(t, i))
        return
    }
    if a == ast.T_PTR {
        var s1: [u8; 5] = "(ptr "
        schreib(b, (&s1[0]) as u64, 5)
        if ast.t_b(t, i) == 1 {
            var m1: [u8; 4] = "mut "
            schreib(b, (&m1[0]) as u64, 4)
        } else {
            var m2: [u8; 6] = "konst "
            schreib(b, (&m2[0]) as u64, 6)
        }
        drucke_typ(t, it, b, ast.t_a(t, i))
        zeichen(b, 41)
        return
    }
    var s2: [u8; 5] = "(arr "
    schreib(b, (&s2[0]) as u64, 5)
    rt.buf_push_dez_u64(b, ast.t_b(t, i))
    zeichen(b, 32)
    drucke_typ(t, it, b, ast.t_a(t, i))
    zeichen(b, 41)
}

// -------------------------------------------------------------- Ausdruecke

// Operatortexte in der Reihenfolge von `ast::BinOp`.
fn drucke_binop(b: *mut rt.Buf, op: u32) {
    // Trennzeichen ist '~', weil '|' selbst ein Operator ist.
    var tab: [u8; 43] = "+~-~*~/~%~&~|~^~<<~>>~==~!=~<~<=~>~>=~&&~||"
    var i: usize = 0
    var nr: u32 = 0
    var start: usize = 0
    while i < 43 {
        if tab[i] == 126 as u8 {
            if nr == op {
                schreib(b, (&tab[start]) as u64, i - start)
                return
            }
            nr = nr + 1
            start = i + 1
        }
        i = i + 1
    }
    if nr == op {
        schreib(b, (&tab[start]) as u64, 43 - start)
    }
}

fn drucke_unop(b: *mut rt.Buf, op: u32) {
    if op == 0 { zeichen(b, 45) }
    else if op == 1 { zeichen(b, 33) }
    else if op == 2 { zeichen(b, 38) }
    else { zeichen(b, 42) }
}

fn drucke_ausdruck(t: *mut ast.Baum, it: *mut intern.Interner, b: *mut rt.Buf, i: u32) {
    let a: u32 = ast.e_art(t, i)
    if a == ast.E_INT {
        var s: [u8; 5] = "(int "
        schreib(b, (&s[0]) as u64, 5)
        rt.buf_push_dez_u64(b, ast.e_zahl(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.E_FLOAT {
        var s: [u8; 7] = "(float "
        schreib(b, (&s[0]) as u64, 7)
        rt.buf_push_dez_u64(b, ast.e_zahl(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.E_BOOL {
        var s: [u8; 6] = "(bool "
        schreib(b, (&s[0]) as u64, 6)
        if ast.e_a(t, i) == 1 {
            var w: [u8; 4] = "true"
            schreib(b, (&w[0]) as u64, 4)
        } else {
            var w2: [u8; 5] = "false"
            schreib(b, (&w2[0]) as u64, 5)
        }
        zeichen(b, 41)
        return
    }
    if a == ast.E_ID {
        var s: [u8; 4] = "(id "
        schreib(b, (&s[0]) as u64, 4)
        name_aus(it, b, ast.e_a(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.E_UN {
        var s: [u8; 4] = "(un "
        schreib(b, (&s[0]) as u64, 4)
        drucke_unop(b, ast.e_a(t, i))
        zeichen(b, 32)
        drucke_ausdruck(t, it, b, ast.e_b(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.E_BIN {
        var s: [u8; 5] = "(bin "
        schreib(b, (&s[0]) as u64, 5)
        drucke_binop(b, ast.e_a(t, i))
        zeichen(b, 32)
        drucke_ausdruck(t, it, b, ast.e_b(t, i))
        zeichen(b, 32)
        drucke_ausdruck(t, it, b, ast.e_c(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.E_FELD {
        var s: [u8; 6] = "(feld "
        schreib(b, (&s[0]) as u64, 6)
        drucke_ausdruck(t, it, b, ast.e_a(t, i))
        zeichen(b, 32)
        name_aus(it, b, ast.e_b(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.E_IDX {
        var s: [u8; 5] = "(idx "
        schreib(b, (&s[0]) as u64, 5)
        drucke_ausdruck(t, it, b, ast.e_a(t, i))
        zeichen(b, 32)
        drucke_ausdruck(t, it, b, ast.e_b(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.E_RUF {
        var s: [u8; 5] = "(ruf "
        schreib(b, (&s[0]) as u64, 5)
        name_aus(it, b, ast.e_a(t, i))
        var k: u32 = 0
        while k < ast.e_c(t, i) {
            zeichen(b, 32)
            drucke_ausdruck(t, it, b, ast.kind_at(t, ast.e_b(t, i) + k))
            k = k + 1
        }
        zeichen(b, 41)
        return
    }
    if a == ast.E_SYSCALL {
        var s: [u8; 8] = "(syscall"
        schreib(b, (&s[0]) as u64, 8)
        var k: u32 = 0
        while k < ast.e_c(t, i) {
            zeichen(b, 32)
            drucke_ausdruck(t, it, b, ast.kind_at(t, ast.e_b(t, i) + k))
            k = k + 1
        }
        zeichen(b, 41)
        return
    }
    if a == ast.E_AS {
        var s: [u8; 4] = "(as "
        schreib(b, (&s[0]) as u64, 4)
        drucke_ausdruck(t, it, b, ast.e_a(t, i))
        zeichen(b, 32)
        drucke_typ(t, it, b, ast.e_b(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.E_SLIT {
        var s: [u8; 6] = "(slit "
        schreib(b, (&s[0]) as u64, 6)
        name_aus(it, b, ast.e_a(t, i))
        var k: u32 = 0
        while k < ast.e_c(t, i) {
            var f: [u8; 4] = " (f "
            schreib(b, (&f[0]) as u64, 4)
            name_aus(it, b, ast.kind_at(t, ast.e_b(t, i) + k * 2))
            zeichen(b, 32)
            drucke_ausdruck(t, it, b, ast.kind_at(t, ast.e_b(t, i) + k * 2 + 1))
            zeichen(b, 41)
            k = k + 1
        }
        zeichen(b, 41)
        return
    }
    if a == ast.E_ALIT {
        var s: [u8; 5] = "(alit"
        schreib(b, (&s[0]) as u64, 5)
        var k: u32 = 0
        while k < ast.e_c(t, i) {
            zeichen(b, 32)
            drucke_ausdruck(t, it, b, ast.kind_at(t, ast.e_b(t, i) + k))
            k = k + 1
        }
        zeichen(b, 41)
        return
    }
    var s: [u8; 6] = "(awdh "
    schreib(b, (&s[0]) as u64, 6)
    drucke_ausdruck(t, it, b, ast.e_a(t, i))
    zeichen(b, 32)
    drucke_ausdruck(t, it, b, ast.e_b(t, i))
    zeichen(b, 41)
}

// -------------------------------------------------------------- Anweisungen

fn drucke_block(t: *mut ast.Baum, it: *mut intern.Interner, b: *mut rt.Buf, i: u32) {
    var s: [u8; 4] = "(blk"
    schreib(b, (&s[0]) as u64, 4)
    var k: u32 = 0
    while k < ast.b_len(t, i) {
        zeichen(b, 32)
        drucke_anweisung(t, it, b, ast.sliste_at(t, ast.b_off(t, i) + k))
        k = k + 1
    }
    zeichen(b, 41)
}

fn drucke_anweisung(t: *mut ast.Baum, it: *mut intern.Interner, b: *mut rt.Buf, i: u32) {
    let a: u32 = ast.s_art(t, i)
    if a == ast.S_LET || a == ast.S_VAR {
        if a == ast.S_LET {
            var s: [u8; 5] = "(let "
            schreib(b, (&s[0]) as u64, 5)
        } else {
            var s2: [u8; 5] = "(var "
            schreib(b, (&s2[0]) as u64, 5)
        }
        name_aus(it, b, ast.s_a(t, i))
        zeichen(b, 32)
        drucke_typ(t, it, b, ast.s_b(t, i))
        zeichen(b, 32)
        drucke_ausdruck(t, it, b, ast.s_c(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.S_ZUW {
        var s: [u8; 5] = "(zuw "
        schreib(b, (&s[0]) as u64, 5)
        drucke_ausdruck(t, it, b, ast.s_a(t, i))
        zeichen(b, 32)
        drucke_ausdruck(t, it, b, ast.s_b(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.S_IF {
        var s: [u8; 4] = "(if "
        schreib(b, (&s[0]) as u64, 4)
        drucke_ausdruck(t, it, b, ast.s_a(t, i))
        zeichen(b, 32)
        drucke_block(t, it, b, ast.s_b(t, i))
        zeichen(b, 32)
        if ast.s_c(t, i) == ast.NICHTS {
            zeichen(b, 45)
        } else {
            drucke_anweisung(t, it, b, ast.s_c(t, i))
        }
        zeichen(b, 41)
        return
    }
    if a == ast.S_WHILE {
        var s: [u8; 7] = "(while "
        schreib(b, (&s[0]) as u64, 7)
        drucke_ausdruck(t, it, b, ast.s_a(t, i))
        zeichen(b, 32)
        drucke_block(t, it, b, ast.s_b(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.S_RET {
        var s: [u8; 5] = "(ret "
        schreib(b, (&s[0]) as u64, 5)
        if ast.s_a(t, i) == ast.NICHTS {
            zeichen(b, 45)
        } else {
            drucke_ausdruck(t, it, b, ast.s_a(t, i))
        }
        zeichen(b, 41)
        return
    }
    if a == ast.S_FOR {
        var s: [u8; 5] = "(for "
        schreib(b, (&s[0]) as u64, 5)
        name_aus(it, b, ast.s_a(t, i))
        zeichen(b, 32)
        drucke_ausdruck(t, it, b, ast.s_b(t, i))
        zeichen(b, 32)
        drucke_ausdruck(t, it, b, ast.s_c(t, i))
        zeichen(b, 32)
        drucke_block(t, it, b, ast.s_d(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.S_BREAK {
        var s: [u8; 7] = "(break)"
        schreib(b, (&s[0]) as u64, 7)
        return
    }
    if a == ast.S_CONT {
        var s: [u8; 10] = "(continue)"
        schreib(b, (&s[0]) as u64, 10)
        return
    }
    if a == ast.S_DEFER || a == ast.S_ERRDEFER {
        if a == ast.S_DEFER {
            var s: [u8; 7] = "(defer "
            schreib(b, (&s[0]) as u64, 7)
        } else {
            var s2: [u8; 10] = "(errdefer "
            schreib(b, (&s2[0]) as u64, 10)
        }
        drucke_anweisung(t, it, b, ast.s_a(t, i))
        zeichen(b, 41)
        return
    }
    if a == ast.S_EXPR {
        var s: [u8; 6] = "(expr "
        schreib(b, (&s[0]) as u64, 6)
        drucke_ausdruck(t, it, b, ast.s_a(t, i))
        zeichen(b, 41)
        return
    }
    var s: [u8; 7] = "(block "
    schreib(b, (&s[0]) as u64, 7)
    drucke_block(t, it, b, ast.s_a(t, i))
    zeichen(b, 41)
}

// ------------------------------------------------------------------ Programm

fn drucke_programm(t: *mut ast.Baum, it: *mut intern.Interner, b: *mut rt.Buf) {
    var kopf: [u8; 10] = "(programm\n"
    schreib(b, (&kopf[0]) as u64, 10)
    if ast.profil(t) != ast.NICHTS {
        var s: [u8; 11] = "  (profile "
        schreib(b, (&s[0]) as u64, 11)
        name_aus(it, b, ast.profil(t))
        var e: [u8; 2] = ")\n"
        schreib(b, (&e[0]) as u64, 2)
    }
    var i: usize = 0
    while i < ast.imp_anzahl(t) {
        var s: [u8; 10] = "  (import "
        schreib(b, (&s[0]) as u64, 10)
        name_aus(it, b, ast.imp_pfad(t, i))
        zeichen(b, 32)
        name_aus(it, b, ast.imp_alias(t, i))
        var e: [u8; 2] = ")\n"
        schreib(b, (&e[0]) as u64, 2)
        i = i + 1
    }
    i = 0
    while i < ast.exp_anzahl(t) {
        var s: [u8; 10] = "  (export "
        schreib(b, (&s[0]) as u64, 10)
        name_aus(it, b, ast.exp_name(t, i))
        var e: [u8; 2] = ")\n"
        schreib(b, (&e[0]) as u64, 2)
        i = i + 1
    }
    i = 0
    while i < ast.konst_anzahl(t) {
        var s: [u8; 9] = "  (const "
        schreib(b, (&s[0]) as u64, 9)
        name_aus(it, b, ast.konst_name(t, i))
        zeichen(b, 32)
        drucke_typ(t, it, b, ast.konst_typ(t, i))
        zeichen(b, 32)
        drucke_ausdruck(t, it, b, ast.konst_wert(t, i))
        var e: [u8; 2] = ")\n"
        schreib(b, (&e[0]) as u64, 2)
        i = i + 1
    }
    i = 0
    while i < ast.struktur_anzahl(t) {
        var s: [u8; 10] = "  (struct "
        schreib(b, (&s[0]) as u64, 10)
        name_aus(it, b, ast.struktur_name(t, i))
        var k: u32 = 0
        while k < ast.struktur_flen(t, i) {
            var f: [u8; 7] = " (feld "
            schreib(b, (&f[0]) as u64, 7)
            name_aus(it, b, ast.feld_name(t, ast.struktur_foff(t, i) + k))
            zeichen(b, 32)
            drucke_typ(t, it, b, ast.feld_typ(t, ast.struktur_foff(t, i) + k))
            zeichen(b, 41)
            k = k + 1
        }
        var e: [u8; 2] = ")\n"
        schreib(b, (&e[0]) as u64, 2)
        i = i + 1
    }
    i = 0
    while i < ast.fn_anzahl(t) {
        var s: [u8; 6] = "  (fn "
        schreib(b, (&s[0]) as u64, 6)
        name_aus(it, b, ast.fn_name(t, i))
        var o: [u8; 2] = " ("
        schreib(b, (&o[0]) as u64, 2)
        var k: u32 = 0
        while k < ast.fn_plen(t, i) {
            if k > 0 {
                zeichen(b, 32)
            }
            var pp: [u8; 7] = "(param "
            schreib(b, (&pp[0]) as u64, 7)
            name_aus(it, b, ast.param_name(t, ast.fn_poff(t, i) + k))
            zeichen(b, 32)
            drucke_typ(t, it, b, ast.param_typ(t, ast.fn_poff(t, i) + k))
            zeichen(b, 41)
            k = k + 1
        }
        var c: [u8; 2] = ") "
        schreib(b, (&c[0]) as u64, 2)
        drucke_typ(t, it, b, ast.fn_ret(t, i))
        zeichen(b, 32)
        drucke_block(t, it, b, ast.fn_rumpf(t, i))
        var e: [u8; 2] = ")\n"
        schreib(b, (&e[0]) as u64, 2)
        i = i + 1
    }
    var schluss: [u8; 2] = ")\n"
    schreib(b, (&schluss[0]) as u64, 2)
}

fn main(start: u64) -> i32 {
    var quelle: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&quelle)
    var name: u64 = 0
    var name_n: usize = 0
    if rt.arg_anzahl(start) > 1 {
        name = rt.arg_zeiger(start, 1)
        name_n = rt.c_laenge(name)
        if !rt.lies_datei(name, &quelle) {
            return 2
        }
    } else {
        var sn: [u8; 7] = "<stdin>"
        name = (&sn[0]) as u64
        name_n = 7
        if !rt.lies_stdin(&quelle) {
            return 2
        }
    }

    var kwtxt: [u8; 172] = "fn|let|var|if|else|while|return|struct|const|profile|as|mut|true|false|syscall|extern|break|continue|defer|errdefer|comptime|for|in|import|export|enum|match|error|try|catch"
    var l: lexer.Lexer = lexer.lex_neu(rt.buf_ptr(&quelle), rt.buf_len(&quelle),
                                       (&kwtxt[0]) as u64, 172, name, name_n)
    defer lexer.lex_frei(&l)
    lexer.lex_lauf(&l)
    if lexer.lex_fehler(&l) > 0 {
        return 1
    }

    var p: parser.Parser = parser.par_neu((&l) as u64)
    defer parser.par_frei(&p)
    parser.par_lauf(&p)
    if parser.par_nicht_kern(&p) {
        return 3
    }
    if parser.par_fehler(&p) > 0 {
        return 1
    }

    var aus: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&aus)
    drucke_programm(parser.par_baum(&p), lexer.lex_namen(&l), &aus)
    if !rt.schreib_alles(1, rt.buf_ptr(&aus), rt.buf_len(&aus)) {
        return 2
    }
    return 0
}
