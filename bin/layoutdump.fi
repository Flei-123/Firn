// bin/layoutdump.fi — Speicherlayout und Aufrufkonvention im Format von
// `firnc0 --emit=layout`.
//
// Der Massstab fuer `lib/firnc1/typen.fi`. Rueckgabewerte wie bei astdump:
// 0 = Ausgabe · 1 = Fehler · 3 = keine Kernsprache.

import rt
import vec
import intern
import lexer
import ast
import parser
import typen

fn schreib(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(b, p, n)
}

fn name_aus(it: *mut intern.Interner, b: *mut rt.Buf, nr: u32) {
    rt.buf_push_bytes(b, intern.intern_zeiger(it, nr), intern.intern_laenge(it, nr))
}

fn wort(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_push_bytes(b, p, n)
}

fn drucke_typname(t: *mut typen.Typen, it: *mut intern.Interner, b: *mut rt.Buf, i: u32) {
    let k: u32 = typen.ty_art(t, i)
    if k == typen.K_PTR {
        var s: [u8; 5] = "(ptr "
        schreib(b, (&s[0]) as u64, 5)
        if typen.ty_n(t, i) == 1 {
            var m: [u8; 4] = "mut "
            schreib(b, (&m[0]) as u64, 4)
        } else {
            var m2: [u8; 6] = "konst "
            schreib(b, (&m2[0]) as u64, 6)
        }
        drucke_typname(t, it, b, typen.ty_a(t, i))
        rt.buf_push(b, 41 as u8)
        return
    }
    if k == typen.K_ARR {
        var s: [u8; 5] = "(arr "
        schreib(b, (&s[0]) as u64, 5)
        rt.buf_push_dez_u64(b, typen.ty_n(t, i))
        rt.buf_push(b, 32 as u8)
        drucke_typname(t, it, b, typen.ty_a(t, i))
        rt.buf_push(b, 41 as u8)
        return
    }
    if k == typen.K_STRUCT {
        name_aus(it, b, typen.st_name(t, typen.ty_a(t, i) as usize))
        return
    }
    if k == typen.K_VOID {
        var s: [u8; 4] = "void"
        schreib(b, (&s[0]) as u64, 4)
        return
    }
    if k == typen.K_FEHLER {
        rt.buf_push(b, 63 as u8)
        return
    }
    // Grundtypen in der Reihenfolge der Kennzahlen
    var tab: [u8; 50] = "i8|i16|i32|i64|u8|u16|u32|u64|usize|isize|bool|f64"
    var idx: usize = 0
    var nr: u32 = 0
    var start: usize = 0
    while idx <= 50 {
        var ende: bool = idx == 50
        if !ende {
            ende = tab[idx] == 124 as u8
        }
        if ende {
            if nr == k {
                schreib(b, (&tab[start]) as u64, idx - start)
                return
            }
            nr = nr + 1
            start = idx + 1
        }
        idx = idx + 1
    }
}

fn drucke_klasse(b: *mut rt.Buf, kl: u32) {
    if kl == typen.KLASSE_MEM {
        var m: [u8; 3] = "mem"
        schreib(b, (&m[0]) as u64, 3)
        return
    }
    var s: [u8; 3] = "int"
    schreib(b, (&s[0]) as u64, 3)
    rt.buf_push_dez_u64(b, kl as u64)
}

fn main(start: u64) -> i32 {
    var quelle: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&quelle)
    var name: u64 = 0
    var name_n: usize = 0
    if rt.arg_anzahl(start) > 1 {
        name = rt.arg_zeiger(start, 1)
        name_n = rt.c_laenge(name)
        if !rt.lies_datei(name, &quelle) {
            return 2
        }
    } else {
        var sn: [u8; 7] = "<stdin>"
        name = (&sn[0]) as u64
        name_n = 7
        if !rt.lies_stdin(&quelle) {
            return 2
        }
    }

    var kwtxt: [u8; 172] = "fn|let|var|if|else|while|return|struct|const|profile|as|mut|true|false|syscall|extern|break|continue|defer|errdefer|comptime|for|in|import|export|enum|match|error|try|catch"
    var l: lexer.Lexer = lexer.lex_neu(rt.buf_ptr(&quelle), rt.buf_len(&quelle),
                                       (&kwtxt[0]) as u64, 172, name, name_n)
    defer lexer.lex_frei(&l)
    lexer.lex_lauf(&l)
    if lexer.lex_fehler(&l) > 0 {
        return 1
    }
    var p: parser.Parser = parser.par_neu((&l) as u64)
    defer parser.par_frei(&p)
    parser.par_lauf(&p)
    if parser.par_nicht_kern(&p) {
        return 3
    }
    if parser.par_fehler(&p) > 0 {
        return 1
    }

    let baum: *mut ast.Baum = parser.par_baum(&p)
    let it: *mut intern.Interner = lexer.lex_namen(&l)
    var ty: typen.Typen = typen.typen_neu()
    defer typen.typen_frei(&ty)
    typen.typen_aufloesen(&ty, baum, it)

    var aus: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&aus)
    var kopf: [u8; 8] = "(layout\n"
    schreib(&aus, (&kopf[0]) as u64, 8)

    var i: usize = 0
    while i < typen.st_anzahl(&ty) {
        var s1: [u8; 10] = "  (struct "
        schreib(&aus, (&s1[0]) as u64, 10)
        name_aus(it, &aus, typen.st_name(&ty, i))
        var s2: [u8; 9] = " groesse "
        schreib(&aus, (&s2[0]) as u64, 9)
        rt.buf_push_dez_u64(&aus, typen.st_groesse(&ty, i))
        var s3: [u8; 13] = " ausrichtung "
        schreib(&aus, (&s3[0]) as u64, 13)
        rt.buf_push_dez_u64(&aus, typen.st_ausrichtung(&ty, i))
        var k: u32 = 0
        while k < typen.st_flen(&ty, i) {
            let fi: u32 = typen.st_foff(&ty, i) + k
            var f1: [u8; 7] = " (feld "
            schreib(&aus, (&f1[0]) as u64, 7)
            name_aus(it, &aus, typen.sf_name(&ty, fi))
            var f2: [u8; 9] = " versatz "
            schreib(&aus, (&f2[0]) as u64, 9)
            rt.buf_push_dez_u64(&aus, typen.sf_versatz(&ty, fi))
            schreib(&aus, (&s2[0]) as u64, 9)
            rt.buf_push_dez_u64(&aus, typen.groesse_von(&ty, typen.sf_typ(&ty, fi)))
            schreib(&aus, (&s3[0]) as u64, 13)
            rt.buf_push_dez_u64(&aus, typen.ausrichtung_von(&ty, typen.sf_typ(&ty, fi)))
            var f3: [u8; 5] = " typ "
            schreib(&aus, (&f3[0]) as u64, 5)
            drucke_typname(&ty, it, &aus, typen.sf_typ(&ty, fi))
            rt.buf_push(&aus, 41 as u8)
            k = k + 1
        }
        var e: [u8; 2] = ")\n"
        schreib(&aus, (&e[0]) as u64, 2)
        i = i + 1
    }

    i = 0
    while i < ast.fn_anzahl(baum) {
        var s4: [u8; 6] = "  (fn "
        schreib(&aus, (&s4[0]) as u64, 6)
        name_aus(it, &aus, ast.fn_name(baum, i))
        var k: u32 = 0
        while k < ast.fn_plen(baum, i) {
            let pt: u32 = typen.param_typ_aufgeloest(&ty, i, k)
            var a1: [u8; 6] = " (arg "
            schreib(&aus, (&a1[0]) as u64, 6)
            drucke_typname(&ty, it, &aus, pt)
            var s2b: [u8; 9] = " groesse "
            schreib(&aus, (&s2b[0]) as u64, 9)
            rt.buf_push_dez_u64(&aus, typen.groesse_von(&ty, pt))
            var a2: [u8; 8] = " klasse "
            schreib(&aus, (&a2[0]) as u64, 8)
            drucke_klasse(&aus, typen.klasse_von(&ty, pt))
            rt.buf_push(&aus, 41 as u8)
            k = k + 1
        }
        let rt2: u32 = typen.ret_typ_der_funktion(&ty, i)
        var r1: [u8; 6] = " (ret "
        schreib(&aus, (&r1[0]) as u64, 6)
        drucke_typname(&ty, it, &aus, rt2)
        var s2c: [u8; 9] = " groesse "
        schreib(&aus, (&s2c[0]) as u64, 9)
        rt.buf_push_dez_u64(&aus, typen.groesse_von(&ty, rt2))
        var a3: [u8; 8] = " klasse "
        schreib(&aus, (&a3[0]) as u64, 8)
        drucke_klasse(&aus, typen.klasse_von(&ty, rt2))
        var a4: [u8; 6] = " sret "
        schreib(&aus, (&a4[0]) as u64, 6)
        if typen.braucht_sret(&ty, rt2) {
            rt.buf_push(&aus, 49 as u8)
        } else {
            rt.buf_push(&aus, 48 as u8)
        }
        rt.buf_push(&aus, 41 as u8)
        var e2: [u8; 2] = ")\n"
        schreib(&aus, (&e2[0]) as u64, 2)
        i = i + 1
    }

    var schluss: [u8; 2] = ")\n"
    schreib(&aus, (&schluss[0]) as u64, 2)
    if !rt.schreib_alles(1, rt.buf_ptr(&aus), rt.buf_len(&aus)) {
        return 2
    }
    return 0
}
