// bin/firnc1.fi — DER COMPILER, GESCHRIEBEN IN FIRN.
//
// Die ganze Kette in einer Datei: Text -> Token -> Baum -> Typen -> FIR ->
// x86-64-Assembler -> `as` -> `ld` -> ausfuehrbare Datei.
//
// Aufruf:
//     firnc1 quelle.fi            Assembler auf die Standardausgabe
//     firnc1 quelle.fi -o ziel    ausfuehrbare Datei erzeugen
//
// Mit `-o` legt `firnc1` `ziel.s` an, ruft `/usr/bin/as` und `/usr/bin/ld`
// ueber `fork`/`execve` auf und raeumt die Zwischendateien nicht weg (sie
// sind der beste Beleg dafuer, was wirklich erzeugt wurde). Damit ist Punkt 11
// der Liste in docs/SELBSTHOSTING.md erledigt.
//
// Rueckgabewerte: 0 = Assembler erzeugt · 1 = Fehler · 2 = E/A ·
// 3 = keine Kernsprache · 4 = comptime noetig · 5 = `defer` ·
// 6 = der Codegenerator kann diese FIR nicht (Gleitkomma, > 6 Argumente).

import rt
import vec
import intern
import lexer
import ast
import mono
import pattern
import err
import time
import gc
import gctext
import iface
import package
import parser
import types
import sema
import fir
import lower
import codegen

// ------------------------------------------------------------ Modulsystem
//
// `import a.b` sucht `a/b.fi` in dieser Reihenfolge: (1) neben der
// importierenden Datei, (2) neben der Wurzeldatei, (3) in `$FIRNLIB`,
// (4) in `<Verzeichnis des laufenden Compiler-Binarys>/../lib` —
// dieselbe Regel wie in `firnc0` (`modules.rs::resolve`). Alle Dateien
// landen in EINEM Baum und teilen sich EINE Namenstafel; die Umbenennung
// mit `alias__` macht der Parser.

// Verzeichnisteil eines Pfades, einschliesslich des Schraegstrichs.
fn dirname(b: *mut rt.Buf, path: u64, n: usize) {
    var last: i64 = -1
    var i: usize = 0
    while i < n {
        if rt.ld8(path, i) == 47 as u8 {
            last = i as i64
        }
        i = i + 1
    }
    if last >= 0 {
        rt.buf_push_bytes(b, path, last as usize + 1)
    }
}

// Baut `<verz><teil1>/<teil2>....fi\0` in `aus`.
fn module_path(out: *mut rt.Buf, dir: *mut rt.Buf, l: *mut lexer.Lexer,
             of: usize, to: usize) {
    rt.buf_clear(out)
    rt.buf_push_bytes(out, rt.buf_ptr(dir), rt.buf_len(dir))
    var i: usize = of
    while i < to {
        if lexer.lex_kind(l, i) == 1 {
            let nr: u32 = lexer.lex_nr(l, i)
            rt.buf_push_bytes(out, lexer.lex_name_ptr(l, nr), lexer.lex_name_length(l, nr))
        } else {
            rt.buf_push(out, 47 as u8)
        }
        i = i + 1
    }
    var e: [u8; 4] = ".fi\0"
    rt.buf_push_bytes(out, (&e[0]) as u64, 4)
}

// Umgebungsvariable im Startblock suchen. Hinter `argv` liegt `envp`:
//     [argc][argv0]..[argvN][0][envp0]..[0][auxv..]
// Rueckgabe: Zeiger auf den WERT hinter `NAME=`, 0 wenn nicht gesetzt.
fn env(start: u64, name: u64, name_n: usize) -> u64 {
    if start == 0 {
        return 0
    }
    var i: usize = 1 + rt.arg_count(start) + 1
    while true {
        let p: u64 = rt.ld64(start, i)
        if p == 0 {
            break
        }
        var j: usize = 0
        var equal: bool = true
        while j < name_n {
            if rt.ld8(p, j) != rt.ld8(name, j) {
                equal = false
                break
            }
            j = j + 1
        }
        if equal && rt.ld8(p, name_n) == 61 as u8 {
            return p + name_n as u64 + 1
        }
        i = i + 1
    }
    return 0
}

// Installationsfallback: Verzeichnis des laufenden Compiler-Binarys,
// gefolgt von `../lib/`. `firnc0` liest dafuer `current_exe`; hier geht
// es ueber `/proc/self/exe`. Bleibt der Aufruf erfolglos, ist der Puffer
// leer und der Schritt wird uebersprungen.
fn exe_search_path(out: *mut rt.Buf) {
    rt.buf_clear(out)
    var slf: [u8; 15] = "/proc/self/exe\0"
    var target: [u8; 1024] = [0 as u8; 1024]
    let sp: u64 = (&slf[0]) as u64
    let zp: u64 = (&target[0]) as u64
    let n: i64 = syscall(89, sp as i64, zp as i64, 1023, 0, 0, 0)
    if n <= 0 {
        return
    }
    var last: i64 = -1
    var i: usize = 0
    while i < n as usize {
        if target[i] == 47 as u8 {
            last = i as i64
        }
        i = i + 1
    }
    if last < 0 {
        return
    }
    rt.buf_push_bytes(out, zp, last as usize + 1)
    var rest: [u8; 8] = "../lib/\0"
    rt.buf_push_bytes(out, (&rest[0]) as u64, 7)
}

// ------------------------------------------------------------- Suchraum
//
// Alles, was die Aufloesung EINES `import` braucht. Als Struct, weil
// `lib/firnc1/codegen.fi` hoechstens sechs Argumente kann und die Liste
// mit dem Paketsystem (Runde 48) auf acht angewachsen waere.
struct SearchSpace {
    dir: rt.Buf,        // Verzeichnis der importierenden Datei, mit '/'
    root_dir: rt.Buf,  // Verzeichnis der Wurzeldatei, mit '/'
    firnlib: rt.Buf,
    exelib: rt.Buf,
    cwd: rt.Buf,
    my_package: i64,     // Paket der importierenden Datei, -1 = keins
}

fn sr_new() -> SearchSpace {
    return SearchSpace{
        dir: rt.buf_new(), root_dir: rt.buf_new(),
        firnlib: rt.buf_new(), exelib: rt.buf_new(),
        cwd: rt.buf_new(), my_package: 0 - 1,
    }
}

fn sr_free(s: *mut SearchSpace) {
    rt.buf_free(&(*s).dir)
    rt.buf_free(&(*s).root_dir)
    rt.buf_free(&(*s).firnlib)
    rt.buf_free(&(*s).exelib)
    rt.buf_free(&(*s).cwd)
}

fn buf_set(b: *mut rt.Buf, p: u64, n: usize) {
    rt.buf_clear(b)
    rt.buf_push_bytes(b, p, n)
}

// Zu welchem Paket gehoert diese Datei? -1 = zu keinem (oder keine Welt).
fn package_of_file(w: *mut package.World, cwd: *mut rt.Buf, p: u64, n: usize) -> i64 {
    if package.world_is_empty(w) {
        return 0 - 1
    }
    var abs: rt.Buf = rt.buf_new()
    package.absolute(&abs, p, n, rt.buf_ptr(cwd), rt.buf_len(cwd))
    let r: i64 = package.world_package_of(w, rt.buf_ptr(&abs), rt.buf_len(&abs))
    rt.buf_free(&abs)
    return r
}

// Ist das Argument genau diese Option?
fn arg_is(a: u64, an: usize, lit: u64) -> bool {
    if an != rt.c_length(lit) {
        return false
    }
    return rt.mem_eq(a, lit, an)
}

// ------------------------------------------------------------ Modulliste
//
// Die Warteschlange aller Dateien dieser Uebersetzung. Index 0 ist IMMER die
// Wurzeldatei — damit ein Modul, das die Wurzel wieder einbindet, sie nicht
// ein zweites Mal einzieht (`modules.rs::resolve` haelt es genauso).
//
// Alle Pfade liegen hintereinander in EINEM Puffer, je mit einer Null
// abgeschlossen, weil `open` sie so braucht. DESHALB darf ein Zeiger aus
// `ml_zeiger` nicht ueber ein `ml_dazu` hinweg benutzt werden: der Puffer
// waechst und liegt danach woanders.
struct ModuleList {
    text: rt.Buf,
    off: Vec[u32],
    len: Vec[u32],
    alias: Vec[u32],
}

fn ml_new() -> ModuleList {
    return ModuleList{
        text: rt.buf_new(),
        off: vec_new[u32](), len: vec_new[u32](), alias: vec_new[u32](),
    }
}

fn ml_free(m: *mut ModuleList) {
    rt.buf_free(&(*m).text)
    vec_free[u32](&(*m).off)
    vec_free[u32](&(*m).len)
    vec_free[u32](&(*m).alias)
}

fn ml_count(m: *mut ModuleList) -> usize { return vec_len[u32](&(*m).off) }
fn ml_alias(m: *mut ModuleList, i: usize) -> u32 { return vec_at[u32](&(*m).alias, i) }
fn ml_length(m: *mut ModuleList, i: usize) -> usize {
    return vec_at[u32](&(*m).len, i) as usize
}
fn ml_ptr(m: *mut ModuleList, i: usize) -> u64 {
    return rt.buf_ptr(&(*m).text) + vec_at[u32](&(*m).off, i) as u64
}

fn ml_knows(m: *mut ModuleList, p: u64, n: usize) -> bool {
    var i: usize = 0
    while i < ml_count(m) {
        if ml_length(m, i) == n {
            if rt.mem_eq(ml_ptr(m, i), p, n) {
                return true
            }
        }
        i = i + 1
    }
    return false
}

fn ml_add(m: *mut ModuleList, p: u64, n: usize, alias: u32) {
    vec_push[u32](&(*m).off, rt.buf_len(&(*m).text) as u32)
    vec_push[u32](&(*m).len, n as u32)
    vec_push[u32](&(*m).alias, alias)
    rt.buf_push_bytes(&(*m).text, p, n)
    rt.buf_push(&(*m).text, 0 as u8)
}

// NAMENSKONFLIKT (Runde 48): zwei VERSCHIEDENE Dateien mit demselben
// Modulnamen fielen beim Zusammenfuehren auf dieselbe Umbenennung
// `modul__name` und wuerden sich still ueberdecken. Gesucht wird ueber die
// absoluten Pfade, damit zwei Schreibweisen derselben Datei kein Konflikt
// sind. Rueckgabe: Index des aelteren Eintrags oder -1.
fn ml_name_dup(ml: *mut ModuleList, cwd: *mut rt.Buf, new: u64, nn: usize) -> i64 {
    var an: rt.Buf = rt.buf_new()
    var bn: rt.Buf = rt.buf_new()
    var xa: rt.Buf = rt.buf_new()
    var xb: rt.Buf = rt.buf_new()
    package.absolute(&xa, new, nn, rt.buf_ptr(cwd), rt.buf_len(cwd))
    package.module_name(&an, rt.buf_ptr(&xa), rt.buf_len(&xa))
    var r: i64 = 0 - 1
    var i: usize = 0
    while i < ml_count(ml) {
        package.absolute(&xb, ml_ptr(ml, i), ml_length(ml, i),
                      rt.buf_ptr(cwd), rt.buf_len(cwd))
        var same_file: bool = false
        if rt.buf_len(&xa) == rt.buf_len(&xb) {
            same_file = rt.mem_eq(rt.buf_ptr(&xa), rt.buf_ptr(&xb), rt.buf_len(&xa))
        }
        if !same_file {
            package.module_name(&bn, rt.buf_ptr(&xb), rt.buf_len(&xb))
            if rt.buf_len(&an) == rt.buf_len(&bn) {
                if rt.mem_eq(rt.buf_ptr(&an), rt.buf_ptr(&bn), rt.buf_len(&an)) {
                    r = i as i64
                    break
                }
            }
        }
        i = i + 1
    }
    rt.buf_free(&an)
    rt.buf_free(&bn)
    rt.buf_free(&xa)
    rt.buf_free(&xb)
    return r
}

// Alle `import`-Zeilen eines Tokenstroms aufloesen und die noch unbekannten
// Dateien hinten anhaengen. So wird die Liste zur BREITENSUCHE ueber den
// ganzen Einbindungsgraphen: ein Modul darf ein Modul einbinden, ohne dass
// die Wurzeldatei davon wissen muss.
//
// Vor Runde 31 wurden nur die `import`-Zeilen der WURZELDATEI gelesen. Das
// fiel lange nicht auf, weil `bin/firnc1.fi` seine Abhaengigkeiten ohnehin
// alle aufzaehlt — `tests/640_vec_module.fi` dagegen scheiterte still daran,
// dass `modules/vec.fi` sein eigenes `rt` nicht bekam.
//
// SUCHREIHENFOLGE (Runde 48, Zwilling von `modules.rs::resolve`):
//   1. neben der importierenden Datei
//   2. neben der Wurzeldatei
//   3. in den `quelle`-Verzeichnissen des eigenen Pakets
//   4. in einer `brauche`-Abhaengigkeit des eigenen Pakets, wenn der erste
//      Pfadteil ihr Name ist
//   5. in `$FIRNLIB`
//   6. in `<exe>/../lib`
// Ohne Manifest ist die Welt leer, 3 und 4 entfallen, und es bleibt bei der
// Reihenfolge von Runde 39.
//
// Rueckgabe: 0 = gut · 2 = Modul nicht gefunden · 9 = Paketfehler, die
// fertige Meldung steht in `paket.welt_fehler(w)`.
fn imports_collect(l: *mut lexer.Lexer, s: *mut SearchSpace, w: *mut package.World,
                   ml: *mut ModuleList) -> i32 {
    var path: rt.Buf = rt.buf_new()
    defer rt.buf_free(&path)
    var base: rt.Buf = rt.buf_new()
    defer rt.buf_free(&base)
    var abs: rt.Buf = rt.buf_new()
    defer rt.buf_free(&abs)
    var mname: rt.Buf = rt.buf_new()
    defer rt.buf_free(&mname)
    var old: rt.Buf = rt.buf_new()
    defer rt.buf_free(&old)
    var i: usize = 0
    while i + 1 < lexer.lex_count(l) {
        if lexer.lex_kind(l, i) != 27 {
            i = i + 1
            continue
        }
        // Pfadteile einsammeln: IDENT (DOT IDENT)*
        var j: usize = i + 1
        var alias: u32 = 0
        var parts: usize = 0
        while j < lexer.lex_count(l) {
            if lexer.lex_kind(l, j) != 1 {
                break
            }
            alias = lexer.lex_nr(l, j)
            parts = parts + 1
            j = j + 1
            if j >= lexer.lex_count(l) {
                break
            }
            if lexer.lex_kind(l, j) != 43 {
                break
            }
            j = j + 1
        }
        if parts == 0 {
            i = j
            continue
        }
        var found: bool = false
        // (1) neben der importierenden Datei
        module_path(&path, &(*s).dir, l, i + 1, j)
        if package.is_file(rt.buf_ptr(&path)) {
            found = true
        }
        // (2) neben der Wurzeldatei
        if !found {
            module_path(&path, &(*s).root_dir, l, i + 1, j)
            if package.is_file(rt.buf_ptr(&path)) {
                found = true
            }
        }
        // (3) die eigenen Quellverzeichnisse
        if !found {
            if (*s).my_package >= 0 {
                let mp: usize = (*s).my_package as usize
                var qi: usize = 0
                while qi < package.world_source_count(w, mp) {
                    package.world_source_base(w, mp, qi, &base)
                    module_path(&path, &base, l, i + 1, j)
                    if package.is_file(rt.buf_ptr(&path)) {
                        found = true
                        break
                    }
                    qi = qi + 1
                }
            }
        }
        // (4) eine Abhaengigkeit: der ERSTE Pfadteil nennt das Paket.
        if !found {
            if (*s).my_package >= 0 {
                let mp: usize = (*s).my_package as usize
                let knr: u32 = lexer.lex_nr(l, i + 1)
                let di: i64 = package.world_edge(w, mp, lexer.lex_name_ptr(l, knr),
                                               lexer.lex_name_length(l, knr))
                if di >= 0 {
                    var of: usize = i + 1
                    if parts > 1 {
                        of = i + 3
                    }
                    var qi: usize = 0
                    while qi < package.world_source_count(w, di as usize) {
                        package.world_source_base(w, di as usize, qi, &base)
                        module_path(&path, &base, l, of, j)
                        if package.is_file(rt.buf_ptr(&path)) {
                            found = true
                            break
                        }
                        qi = qi + 1
                    }
                }
            }
        }
        // (5) $FIRNLIB
        if !found {
            if rt.buf_len(&(*s).firnlib) > 0 {
                module_path(&path, &(*s).firnlib, l, i + 1, j)
                if package.is_file(rt.buf_ptr(&path)) {
                    found = true
                }
            }
        }
        // (6) <exe>/../lib
        if !found {
            if rt.buf_len(&(*s).exelib) > 0 {
                module_path(&path, &(*s).exelib, l, i + 1, j)
                if package.is_file(rt.buf_ptr(&path)) {
                    found = true
                }
            }
        }
        if !found {
            return 2
        }
        let n: usize = rt.buf_len(&path) - 1
        // SICHTBARKEIT: fuehrt der Treffer in ein ANDERES Paket, muss es eine
        // eingetragene Abhaengigkeit sein und das Modul in dessen
        // `oeffentlich`-Liste stehen.
        if !package.world_is_empty(w) {
            package.absolute(&abs, rt.buf_ptr(&path), n,
                          rt.buf_ptr(&(*s).cwd), rt.buf_len(&(*s).cwd))
            let zp: i64 = package.world_package_of(w, rt.buf_ptr(&abs), rt.buf_len(&abs))
            if zp >= 0 {
                if (*s).my_package >= 0 {
                    if zp != (*s).my_package {
                        let mp: usize = (*s).my_package as usize
                        let zn: u64 = package.world_name_ptr(w, zp as usize)
                        if package.world_edge(w, mp, zn, rt.c_length(zn)) != zp {
                            package.world_text_no_dependency(w, zp as usize, mp)
                            return 9
                        }
                        package.module_name(&mname, rt.buf_ptr(&abs), rt.buf_len(&abs))
                        if !package.world_is_public(w, zp as usize,
                                                       rt.buf_ptr(&mname), rt.buf_len(&mname)) {
                            package.world_text_not_public(w, zp as usize,
                                                              rt.buf_ptr(&mname), rt.buf_len(&mname))
                            return 9
                        }
                    }
                }
            }
        }
        if !ml_knows(ml, rt.buf_ptr(&path), n) {
            if !package.world_is_empty(w) {
                let double: i64 = ml_name_dup(ml, &(*s).cwd, rt.buf_ptr(&path), n)
                if double >= 0 {
                    package.absolute(&abs, rt.buf_ptr(&path), n,
                                  rt.buf_ptr(&(*s).cwd), rt.buf_len(&(*s).cwd))
                    package.module_name(&mname, rt.buf_ptr(&abs), rt.buf_len(&abs))
                    package.absolute(&old, ml_ptr(ml, double as usize),
                                  ml_length(ml, double as usize),
                                  rt.buf_ptr(&(*s).cwd), rt.buf_len(&(*s).cwd))
                    package.world_text_name_clash(w, rt.buf_ptr(&mname),
                                                   rt.buf_ptr(&old), rt.buf_ptr(&abs))
                    return 9
                }
            }
            ml_add(ml, rt.buf_ptr(&path), n, alias)
        }
        i = j
    }
    return 0
}

fn main(start: u64) -> i32 {
    // --- Kommandozeile (Runde 48). Dieselben Optionen wie `firnc0`:
    //     firnc1 quelle.fi [-o ziel]
    //     firnc1 --paket <verzeichnis> [-o ziel]
    //     firnc1 --paket-info <verzeichnis>
    var inp: u64 = 0
    var in_n: usize = 0
    var pak: u64 = 0
    var pak_n: usize = 0
    var info: u64 = 0
    var info_n: usize = 0
    var targetb: rt.Buf = rt.buf_new()
    defer rt.buf_free(&targetb)
    var has_target: bool = false
    // RUNDE 52 (SPEC 2): `-c`/`--objekt` erzeugt eine freistehende
    // ELF-Objektdatei — `as`, aber KEIN `ld`. `--profile=kernel` erzwingt
    // das Kernel-Profil fuer die ganze Uebersetzungseinheit; dann ist die
    // Objektausgabe ohnehin an.
    var only_object: bool = false
    var kernel_flag: bool = false
    var c_opt: [u8; 3] = "-c\0"
    var ob_opt: [u8; 9] = "--object\0"
    var pk_opt: [u8; 17] = "--profile=kernel\0"
    var pa_opt: [u8; 14] = "--profile=app\0"
    var o_opt: [u8; 3] = "-o\0"
    var p_opt: [u8; 10] = "--package\0"
    var i_opt: [u8; 15] = "--package-info\0"
    var ai: usize = 1
    while ai < rt.arg_count(start) {
        let a: u64 = rt.arg_ptr(start, ai)
        let an: usize = rt.c_length(a)
        if arg_is(a, an, (&c_opt[0]) as u64) || arg_is(a, an, (&ob_opt[0]) as u64) {
            only_object = true
        } else {
        if arg_is(a, an, (&pk_opt[0]) as u64) {
            kernel_flag = true
        } else {
        if arg_is(a, an, (&pa_opt[0]) as u64) {
            kernel_flag = false
        } else {
        if arg_is(a, an, (&o_opt[0]) as u64) {
            ai = ai + 1
            if ai < rt.arg_count(start) {
                let z: u64 = rt.arg_ptr(start, ai)
                rt.buf_clear(&targetb)
                rt.buf_push_bytes(&targetb, z, rt.c_length(z))
                rt.buf_push(&targetb, 0 as u8)
                rt.buf_set_len(&targetb, rt.buf_len(&targetb) - 1)
                has_target = true
            }
        } else {
        if arg_is(a, an, (&p_opt[0]) as u64) {
            ai = ai + 1
            if ai < rt.arg_count(start) {
                pak = rt.arg_ptr(start, ai)
                pak_n = rt.c_length(pak)
            }
        } else {
        if arg_is(a, an, (&i_opt[0]) as u64) {
            ai = ai + 1
            if ai < rt.arg_count(start) {
                info = rt.arg_ptr(start, ai)
                info_n = rt.c_length(info)
            }
        } else {
            if inp == 0 {
                inp = a
                in_n = an
            }
        }
        }
        }
        }
        }
        }
        ai = ai + 1
    }

    if pak != 0 {
        if inp != 0 {
            var m_both: [u8; 62] = "error: --paket und eine eingabedatei schliessen einander aus\n\0"
            rt.write_everything(2, (&m_both[0]) as u64, rt.c_length((&m_both[0]) as u64))
            return 2
        }
    }

    // --- die Paketwelt. Mit `--paket`/`--paket-info` das genannte Projekt,
    // sonst das Manifest ueber der Quelldatei; ohne Manifest bleibt sie leer
    // und alles verhaelt sich wie vor Runde 48.
    var w: package.World = package.world_new()
    defer package.world_free(&w)
    var startb: rt.Buf = rt.buf_new()
    defer rt.buf_free(&startb)

    if info != 0 {
        if !package.world_ab_root(&w, info, info_n) {
            rt.write_everything(2, rt.buf_ptr(package.world_error(&w)),
                             rt.buf_len(package.world_error(&w)))
            return 2
        }
        var ib: rt.Buf = rt.buf_new()
        defer rt.buf_free(&ib)
        package.world_info(&w, info, info_n, &ib)
        if !rt.write_everything(1, rt.buf_ptr(&ib), rt.buf_len(&ib)) {
            return 2
        }
        return 0
    }

    if pak != 0 {
        if !package.world_ab_root(&w, pak, pak_n) {
            rt.write_everything(2, rt.buf_ptr(package.world_error(&w)),
                             rt.buf_len(package.world_error(&w)))
            return 2
        }
        let sp: u64 = package.world_start_ptr(&w, 0)
        if sp == 0 {
            package.world_text_no_start(&w, 0)
            rt.write_everything(2, rt.buf_ptr(package.world_error(&w)),
                             rt.buf_len(package.world_error(&w)))
            return 2
        }
        package.join(&startb, pak, pak_n, sp, rt.c_length(sp))
        inp = rt.buf_ptr(&startb)
        in_n = rt.buf_len(&startb)
        if !has_target {
            let np: u64 = package.world_name_ptr(&w, 0)
            package.join(&targetb, pak, pak_n, np, rt.c_length(np))
            has_target = true
        }
    }

    var source: rt.Buf = rt.buf_new()
    defer rt.buf_free(&source)
    var name: u64 = 0
    var name_n: usize = 0
    if inp != 0 {
        name = inp
        name_n = in_n
        if !rt.read_file(name, &source) {
            return 2
        }
    } else {
        var sn: [u8; 7] = "<stdin>"
        name = (&sn[0]) as u64
        name_n = 7
        if !rt.read_stdin(&source) {
            return 2
        }
    }
    // Ohne `--paket` bestimmt die Quelldatei das Projekt.
    if pak == 0 {
        if inp != 0 {
            if !package.world_ab_file(&w, name, name_n) {
                rt.write_everything(2, rt.buf_ptr(package.world_error(&w)),
                                 rt.buf_len(package.world_error(&w)))
                return 2
            }
        }
    }

    var kwtxt: [u8; 172] = "fn|let|var|if|else|while|return|struct|const|profile|as|mut|true|false|syscall|extern|break|continue|defer|errdefer|comptime|for|in|import|export|enum|match|error|try|catch"
    var l: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&source), rt.buf_len(&source),
                                       (&kwtxt[0]) as u64, 172, name, name_n)
    defer lexer.lex_free(&l)
    lexer.lex_run(&l)
    if lexer.lex_error(&l) > 0 {
        return 1
    }
    let it: *mut intern.Interner = lexer.lex_names(&l)
    var tree_s: ast.Tree = ast.tree_new()
    defer ast.tree_free(&tree_s)
    let tree: *mut ast.Tree = &tree_s

    // --- eingebundene Module suchen und ZUERST uebersetzen: eine Konstante
    // darf eine aus einem anderen Modul benutzen, also muessen die
    // Abhaengigkeiten vorher im Baum stehen.
    var dir: rt.Buf = rt.buf_new()
    defer rt.buf_free(&dir)
    dirname(&dir, name, name_n)

    // --- Zusaetzliche Modul-Suchpfade: $FIRNLIB (mit Schraegstrich
    // abgeschlossen, `modulpfad` haengt die Teile direkt an) und
    // `<exe>/../lib/`. Beide bleiben leer, wenn es sie nicht gibt.
    var sr: SearchSpace = sr_new()
    defer sr_free(&sr)
    var flname: [u8; 7] = "FIRNLIB"
    let flvalue: u64 = env(start, (&flname[0]) as u64, 7)
    if flvalue != 0 {
        rt.buf_push_bytes(&sr.firnlib, flvalue, rt.c_length(flvalue))
        if rt.buf_len(&sr.firnlib) > 0 {
            if rt.buf_at(&sr.firnlib, rt.buf_len(&sr.firnlib) - 1) != 47 as u8 {
                rt.buf_push(&sr.firnlib, 47 as u8)
            }
        }
    }
    exe_search_path(&sr.exelib)
    package.work_dir(&sr.cwd)
    buf_set(&sr.root_dir, rt.buf_ptr(&dir), rt.buf_len(&dir))

    // --- generische Vorlagen: erst wissen, WELCHE Namen generisch sind,
    // dann parsen. Vorher ist `Vec[i32]` nicht von einer Indizierung zu
    // unterscheiden.
    var g: mono.Gen = mono.gen_new(tree as u64, it as u64)
    defer mono.gen_free(&g)

    // Aufzaehlungen und Musterabgleiche: EINE Registrierung fuer alle
    // Dateien dieser Uebersetzung (Aufzaehlungsnamen gelten programmweit).
    var mu: pattern.Pat = pattern.pat_new()
    defer pattern.pat_free(&mu)

    // Fehlermengen und -unionen: EINE Registrierung fuer alle Dateien
    // dieser Uebersetzung (Fehlermengennamen gelten programmweit, SPEC §14.1).
    var fe: err.Error = err.error_new()
    defer err.error_free(&fe)

    // gc-Klassen: EINE Registrierung fuer alle Dateien dieser Uebersetzung
    // (Runde 34 — Klassennamen gelten programmweit, wie die Aufzaehlungen).
    var gcreg: gc.Gc = gc.gc_new()
    defer gc.gc_free(&gcreg)

    // Schnittstellen: EINE Registrierung fuer alle Dateien dieser
    // Uebersetzung (Runde 46 — Schnittstellennamen gelten programmweit).
    var ifreg: iface.If = iface.if_new()
    defer iface.if_free(&ifreg)
    // RUNDE 50: die Schrankenpruefung bei der Auspraegung braucht die
    // Schnittstellen — `T: Ord` gilt nur, wenn es `impl Ord for T` gibt.
    mono.gen_if_set(&g, (&ifreg) as u64)

    var ml: ModuleList = ml_new()
    defer ml_free(&ml)
    ml_add(&ml, name, name_n, 4294967295)

    var msource: rt.Buf = rt.buf_new()
    defer rt.buf_free(&msource)
    var mpath: rt.Buf = rt.buf_new()
    defer rt.buf_free(&mpath)
    var mdir: rt.Buf = rt.buf_new()
    defer rt.buf_free(&mdir)

    // --- GC-SUCHE am Tokenstrom (quelle_braucht_gc / quelle_hat_allocerror
    // in gc.rs): steht irgendwo `gc class`, wird die Sammler-Laufzeit
    // (lib/gc/gc.fi, eingebettet in gctext.fi) als zusaetzliches Modul
    // eingezogen; deklariert das Programm `AllocError` selbst, faellt die
    // mitgelieferte Fehlermenge weg.
    var sgc: [u8; 2] = "gc"
    var scl: [u8; 5] = "class"
    var sae: [u8; 10] = "AllocError"
    var sfin: [u8; 13] = "__gc_finalize"
    var sfa: [u8; 13] = "__thread_work"
    // intern_nummer statt intern_finde: die drei Woerter muessen im Interner
    // STEHEN, sonst sucht der Scan mit -1 und findet nichts — genau dann,
    // wenn die Wurzeldatei selbst kein `gc` enthaelt und das Schluesselwort
    // erst in einem importierten Modul auftaucht (Runde-34-Fund: 560 lief
    // nicht, weil nur modules/dom.fi `gc class` hat).
    let gc_nr: i64 = intern.intern_number(it, (&sgc[0]) as u64, 2) as i64
    let class_nr: i64 = intern.intern_number(it, (&scl[0]) as u64, 5) as i64
    let ae_nr: i64 = intern.intern_number(it, (&sae[0]) as u64, 10) as i64
    let fin_nr: i64 = intern.intern_number(it, (&sfin[0]) as u64, 13) as i64
    let fa_nr: i64 = intern.intern_number(it, (&sfa[0]) as u64, 13) as i64
    var gc_scan: u32 = gc.gc_source_scan((&l) as u64, it as u64, gc_nr, class_nr,
                                        ae_nr, fin_nr, fa_nr)

    // --- ERSTER DURCHGANG: Warteschlange aufbauen und die generischen Namen
    // einsammeln. Beides muss VOR dem Parsen der ersten Datei feststehen.
    // Der Preis ist ein zweites Lexen jeder Modulquelle; das ist billiger
    // als alle Lexer gleichzeitig offen zu halten, und es macht die
    // Reihenfolge der `import`-Zeilen bedeutungslos.
    mono.gen_upfront(&g, (&l) as u64)
    buf_set(&sr.dir, rt.buf_ptr(&dir), rt.buf_len(&dir))
    sr.my_package = package_of_file(&w, &sr.cwd, name, name_n)
    let wrc: i32 = imports_collect(&l, &sr, &w, &ml)
    if wrc == 9 {
        rt.write_everything(2, rt.buf_ptr(package.world_error(&w)),
                         rt.buf_len(package.world_error(&w)))
        return 2
    }
    if wrc != 0 {
        return wrc
    }
    var mi: usize = 1
    while mi < ml_count(&ml) {
        rt.buf_clear(&mpath)
        rt.buf_push_bytes(&mpath, ml_ptr(&ml, mi), ml_length(&ml, mi))
        rt.buf_push(&mpath, 0 as u8)
        rt.buf_clear(&msource)
        if !rt.read_file(rt.buf_ptr(&mpath), &msource) {
            return 2
        }
        var vl: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&msource), rt.buf_len(&msource),
                                            (&kwtxt[0]) as u64, 172,
                                            rt.buf_ptr(&mpath), rt.buf_len(&mpath) - 1)
        lexer.lex_names_set(&vl, it as u64)
        lexer.lex_run(&vl)
        if lexer.lex_error(&vl) > 0 {
            lexer.lex_free(&vl)
            return 1
        }
        mono.gen_upfront(&g, (&vl) as u64)
        // Runde 47: Bit 4 (eigener Finalisierer-Verteiler) zaehlt NUR aus der
        // Wurzeldatei — Modulergebnisse werden maskiert. Runde 53: Bit 8
        // (Sammlungen) zaehlt sehr wohl aus jedem Modul, genau wie Bit 1
        // und 2 — lib/dom/dom.fi benutzt GcVec, die Wurzeldatei nicht.
        // Merge R49: Bit 16 (eigener Fadenverteiler) zaehlt wie Bit 4 NUR
        // aus der Wurzeldatei, faellt also aus der Maske heraus.
        gc_scan = gc_scan | (gc.gc_source_scan((&vl) as u64, it as u64, gc_nr,
                                               class_nr, ae_nr, fin_nr, fa_nr) & 11)
        rt.buf_clear(&mdir)
        dirname(&mdir, rt.buf_ptr(&mpath), rt.buf_len(&mpath) - 1)
        buf_set(&sr.dir, rt.buf_ptr(&mdir), rt.buf_len(&mdir))
        sr.my_package = package_of_file(&w, &sr.cwd, rt.buf_ptr(&mpath),
                                        rt.buf_len(&mpath) - 1)
        let irc: i32 = imports_collect(&vl, &sr, &w, &ml)
        lexer.lex_free(&vl)
        if irc == 9 {
            rt.write_everything(2, rt.buf_ptr(package.world_error(&w)),
                             rt.buf_len(package.world_error(&w)))
            return 2
        }
        if irc != 0 {
            return irc
        }
        mi = mi + 1
    }

    // --- RUNDE 53: die generischen Vorlagen der SAMMLER-LAUFZEIT muessen
    // bekannt sein, BEVOR die erste Datei geparst wird. Sie steht nicht auf
    // der Platte, sondern in gctext.fi — und sie wird erst ganz zum Schluss
    // geparst. Ohne diesen Vorabscan sieht der Parser `gcvec_anhaengen[Z](…)`
    // in der Wurzeldatei nicht als Auspraegung, sondern als Indizierung.
    // Derselbe Preis wie bei den Modulen: ein zusaetzliches Lexen.
    if gc_scan & 9 == 9 {
        var vq: rt.Buf = rt.buf_new()
        gctext.gctext_write(&vq, true)
        var vgpn: [u8; 12] = "lib/gc/gc.fi"
        var cmp: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&vq), rt.buf_len(&vq),
                                             (&kwtxt[0]) as u64, 172,
                                             (&vgpn[0]) as u64, 12)
        lexer.lex_names_set(&cmp, it as u64)
        lexer.lex_run(&cmp)
        if lexer.lex_error(&cmp) > 0 {
            lexer.lex_free(&cmp)
            rt.buf_free(&vq)
            return 1
        }
        mono.gen_upfront(&g, (&cmp) as u64)
        lexer.lex_free(&cmp)
        rt.buf_free(&vq)
    }

    // --- ZWEITER DURCHGANG: die Module uebersetzen.
    mi = 1
    while mi < ml_count(&ml) {
        rt.buf_clear(&mpath)
        rt.buf_push_bytes(&mpath, ml_ptr(&ml, mi), ml_length(&ml, mi))
        rt.buf_push(&mpath, 0 as u8)
        let alias: u32 = ml_alias(&ml, mi)
        rt.buf_clear(&msource)
        if !rt.read_file(rt.buf_ptr(&mpath), &msource) {
            return 2
        }
        var mlx: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&msource), rt.buf_len(&msource),
                                             (&kwtxt[0]) as u64, 172,
                                             rt.buf_ptr(&mpath), rt.buf_len(&mpath) - 1)
        lexer.lex_names_set(&mlx, it as u64)
        lexer.lex_run(&mlx)
        if lexer.lex_error(&mlx) > 0 {
            lexer.lex_free(&mlx)
            return 1
        }
        var mp: parser.Parser = parser.par_new_module((&mlx) as u64, tree as u64, alias)
        parser.par_gen_set(&mp, (&g) as u64)
        parser.par_mu_set(&mp, (&mu) as u64)
        parser.par_fe_set(&mp, (&fe) as u64)
        parser.par_gc_set(&mp, (&gcreg) as u64)
        parser.par_if_set(&mp, (&ifreg) as u64)
        parser.par_time_set(&mp)
        parser.par_run(&mp)
        let bad: bool = parser.par_not_core(&mp)
        let fail: usize = parser.par_error(&mp)
        parser.par_free(&mp)
        lexer.lex_free(&mlx)
        if bad {
            return 3
        }
        if fail > 0 {
            return 1
        }
        mi = mi + 1
    }

    // --- die Wurzeldatei zuletzt: ihre Namen bleiben unveraendert.
    var p: parser.Parser = parser.par_new_module((&l) as u64, tree as u64, 4294967295)
    defer parser.par_free(&p)
    parser.par_gen_set(&p, (&g) as u64)
    parser.par_mu_set(&p, (&mu) as u64)
    parser.par_fe_set(&p, (&fe) as u64)
    parser.par_gc_set(&p, (&gcreg) as u64)
    parser.par_if_set(&p, (&ifreg) as u64)
    parser.par_time_set(&p)
    parser.par_run(&p)
    if parser.par_not_core(&p) {
        return 3
    }
    if parser.par_error(&p) > 0 {
        return 1
    }

    // --- die Sammler-Laufzeit automatisch einziehen, sobald irgendwo ein
    // `gc class` steht (Runde 34; HOOK gc in modules.rs, SPEC 3.5). Sie
    // liegt im WURZELNAMENSRAUM: `gc_init()` heisst in jedem Modul
    // `gc_init()`, ohne `import` und ohne Modulpraefix.
    if gc_scan & 1 != 0 {
        gc.gc_runtime_set(&gcreg, 1 as usize)
        var gq: rt.Buf = rt.buf_new()
        defer rt.buf_free(&gq)
        if gc_scan & 2 == 0 {
            var aed: [u8; 33] = "error AllocError { OutOfMemory }\n"
            rt.buf_push_bytes(&gq, (&aed[0]) as u64, 33)
        }
        // Runde 47: die leere Voreinstellung des Finalisierer-Verteilers —
        // nur, wenn die Wurzeldatei keinen eigenen mitbringt (Bit 4).
        // Wortgleich mit gc.rs::finalisierer_default.
        if gc_scan & 4 == 0 {
            var fdt: [u8; 217] = "// Runde 47: Voreinstellung des Finalisierer-Verteilers. Das Programm\n// deklariert keinen eigenen, also tut das Aufraeumen nichts.\nfn __gc_finalize(kind: u64, p: *mut u8) {\n    let _unused: u64 = kind + (p as u64)\n}\n"
            rt.buf_push_bytes(&gq, (&fdt[0]) as u64, 217)
        }
        // Runde 49 (Merge: Bit 16): die leere Voreinstellung des
        // Fadenverteilers — nur, wenn die Wurzeldatei keinen eigenen
        // mitbringt. Wortgleich mit gc.rs::fadenarbeit_default.
        if gc_scan & 16 == 0 {
            var fat: [u8; 203] = "// Runde 49: Voreinstellung des Fadenverteilers. Das Programm\n// deklariert keinen eigenen, also tut ein Faden nichts.\nfn __thread_work(kind: u64, arg: u64) -> u64 {\n    return kind + arg - kind - arg\n}\n"
            rt.buf_push_bytes(&gq, (&fat[0]) as u64, 203)
        }
        // Runde 53: die Sammlungen nur dazu, wenn sie vorkommen (Bit 8) —
        // ein Programm mit `gc class`, aber ohne GcVec/GcMap, erzeugt danach
        // genau denselben Code wie vorher.
        gctext.gctext_write(&gq, gc_scan & 8 != 0)
        var gpn: [u8; 12] = "lib/gc/gc.fi"
        var gl: lexer.Lexer = lexer.lex_new(rt.buf_ptr(&gq), rt.buf_len(&gq),
                                            (&kwtxt[0]) as u64, 172,
                                            (&gpn[0]) as u64, 12)
        lexer.lex_names_set(&gl, it as u64)
        lexer.lex_run(&gl)
        if lexer.lex_error(&gl) > 0 {
            lexer.lex_free(&gl)
            return 1
        }
        var gp: parser.Parser = parser.par_new_module((&gl) as u64, tree as u64, 4294967295)
        parser.par_gen_set(&gp, (&g) as u64)
        parser.par_mu_set(&gp, (&mu) as u64)
        parser.par_fe_set(&gp, (&fe) as u64)
        parser.par_gc_set(&gp, (&gcreg) as u64)
        parser.par_if_set(&gp, (&ifreg) as u64)
        parser.par_run(&gp)
        let gschlecht: bool = parser.par_not_core(&gp)
        let gerr: usize = parser.par_error(&gp)
        parser.par_free(&gp)
        lexer.lex_free(&gl)
        if gschlecht {
            return 3
        }
        if gerr > 0 {
            return 1
        }
    }

    // --- comptime: die Bloecke der Wurzeldatei laufen VOR der Typpruefung.
    // Was sie per `emit_roh`/`emit_zahl` schreiben, ist FIRN-QUELLTEXT, den
    // derselbe Lauf lext, parst und ans Programm anhaengt — danach sieht der
    // Typpruefer keinen Unterschied zu handgeschriebenem Quelltext
    // (SPEC §6.4, Abnahmepunkt 6; Vorbild compiler/src/main.rs).
    if ast.ct_count(tree) > 0 {
        var zt: time.Time = time.time_new(tree as u64, it as u64,
                                          rt.buf_ptr(&dir), rt.buf_len(&dir))
        time.time_run(&zt)
        if time.time_error(&zt) > 0 {
            time.time_free(&zt)
            return 1
        }
        let outb: *mut rt.Buf = time.time_output(&zt)
        if rt.buf_len(outb) > 0 {
            var ctname: [u8; 10] = "<comptime>"
            var ctl: lexer.Lexer = lexer.lex_new(rt.buf_ptr(outb), rt.buf_len(outb),
                                                 (&kwtxt[0]) as u64, 172,
                                                 (&ctname[0]) as u64, 10)
            lexer.lex_names_set(&ctl, it as u64)
            lexer.lex_run(&ctl)
            if lexer.lex_error(&ctl) > 0 {
                lexer.lex_free(&ctl)
                time.time_free(&zt)
                return 1
            }
            var ctp: parser.Parser = parser.par_new_module((&ctl) as u64, tree as u64, 4294967295)
            parser.par_gen_set(&ctp, (&g) as u64)
            parser.par_mu_set(&ctp, (&mu) as u64)
            parser.par_fe_set(&ctp, (&fe) as u64)
            parser.par_gc_set(&ctp, (&gcreg) as u64)
            parser.par_if_set(&ctp, (&ifreg) as u64)
            parser.par_run(&ctp)
            let ctbad: bool = parser.par_not_core(&ctp)
            let cterr: usize = parser.par_error(&ctp)
            parser.par_free(&ctp)
            lexer.lex_free(&ctl)
            time.time_free(&zt)
            if ctbad {
                return 3
            }
            if cterr > 0 {
                return 1
            }
        } else {
            time.time_free(&zt)
        }
    }

    // --- Monomorphisierung: jede benutzte Typkombination wird eine eigene,
    // vollstaendig konkrete Funktion bzw. ein eigener Struct. Danach sieht
    // der Typpruefer nur noch gewoehnlichen Code.
    mono.gen_run(&g)
    if mono.gen_error(&g) > 0 {
        return 1
    }

    // RUNDE 52 (SPEC 2): Profil aufloesen — `--profile=` gewinnt, sonst die
    // Deklaration `profile kernel` in der Wurzeldatei. Im Kernel-Profil gibt
    // es keinen `_start`, kein `syscall`, kein `gc class` und keine
    // ausfuehrbare Datei, sondern ein ELF-Objekt.
    var kernel: bool = kernel_flag
    if !kernel {
        let pn: u32 = ast.prof(tree)
        if pn != ast.NICHTS {
            var kw: [u8; 6] = "kernel"
            if intern.intern_equal(it, pn, (&kw[0]) as u64, 6) {
                kernel = true
            }
        }
    }
    let object: bool = only_object || kernel

    var sm: sema.Sema = sema.sema_new(tree as u64, it as u64)
    defer sema.sema_free(&sm)
    sema.sema_kernel_set(&sm, kernel)
    sema.sema_mu_set(&sm, (&mu) as u64)
    sema.sema_fe_set(&sm, (&fe) as u64)
    sema.sema_gc_set(&sm, (&gcreg) as u64)
    sema.sema_if_set(&sm, (&ifreg) as u64)
    sema.sema_run(&sm)
    if sema.sema_needs_comptime(&sm) {
        return 4
    }
    if sema.sema_error(&sm) > 0 {
        return 1
    }

    var lo: lower.Lower = lower.low_new(tree as u64, it as u64, (&sm) as u64)
    defer lower.low_free(&lo)
    lower.low_mu_set(&lo, (&mu) as u64)
    lower.low_fe_set(&lo, (&fe) as u64)
    lower.low_gc_set(&lo, (&gcreg) as u64)
    lower.low_if_set(&lo, (&ifreg) as u64)
    lower.low_run(&lo)
    if lower.low_unsuitable(&lo) {
        return 5
    }
    if lower.low_error(&lo) > 0 {
        return 1
    }

    var cg: codegen.Cg = codegen.cg_new(lower.low_fir(&lo) as u64, it as u64)
    defer codegen.cg_free(&cg)
    codegen.cg_gc_set(&cg, (&gcreg) as u64)
    codegen.cg_if_set(&cg, (&ifreg) as u64)
    codegen.cg_freestanding_set(&cg, kernel)
    codegen.cg_run(&cg)
    if codegen.cg_unsuitable(&cg) {
        return 6
    }
    let out: *mut rt.Buf = codegen.cg_text(&cg)

    // Ohne `-o` und ohne `--paket`: der Assembler geht auf die Standardausgabe.
    if !has_target {
        if !rt.write_everything(1, rt.buf_ptr(out), rt.buf_len(out)) {
            return 2
        }
        return 0
    }
    let target: u64 = rt.buf_ptr(&targetb)
    let target_n: usize = rt.buf_len(&targetb)

    // `ziel.s` und `ziel.o` als nullabgeschlossene Namen bauen.
    var sname: rt.Buf = rt.buf_new()
    defer rt.buf_free(&sname)
    rt.buf_push_bytes(&sname, target, target_n)
    var extension_s: [u8; 3] = ".s\0"
    rt.buf_push_bytes(&sname, (&extension_s[0]) as u64, 3)

    var oname: rt.Buf = rt.buf_new()
    defer rt.buf_free(&oname)
    if object {
        // Mit `-c` heisst das Ergebnis genau so, wie `-o` es sagt.
        rt.buf_push_bytes(&oname, target, target_n)
        rt.buf_push(&oname, 0 as u8)
    } else {
        rt.buf_push_bytes(&oname, target, target_n)
        var extension_o: [u8; 3] = ".o\0"
        rt.buf_push_bytes(&oname, (&extension_o[0]) as u64, 3)
    }

    if !rt.write_file(rt.buf_ptr(&sname), rt.buf_ptr(out), rt.buf_len(out)) {
        return 2
    }

    // as --64 -o ziel.o ziel.s
    var as_path: [u8; 12] = "/usr/bin/as\0"
    var opt64: [u8; 6] = "--64\0\0"
    var minus_o: [u8; 3] = "-o\0"
    var argv_as: [u64; 6] = [0; 6]
    argv_as[0] = (&as_path[0]) as u64
    argv_as[1] = (&opt64[0]) as u64
    argv_as[2] = (&minus_o[0]) as u64
    argv_as[3] = rt.buf_ptr(&oname)
    argv_as[4] = rt.buf_ptr(&sname)
    argv_as[5] = 0
    if rt.run((&as_path[0]) as u64, (&argv_as[0]) as u64) != 0 {
        return 7
    }
    // RUNDE 52: freistehend heisst FREISTEHEND — hier ist Schluss, kein `ld`.
    if object {
        return 0
    }

    // ld -o ziel ziel.o
    var ld_path: [u8; 12] = "/usr/bin/ld\0"
    var argv_ld: [u64; 5] = [0; 5]
    argv_ld[0] = (&ld_path[0]) as u64
