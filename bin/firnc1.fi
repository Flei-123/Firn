// bin/firnc1.fi — DER COMPILER, GESCHRIEBEN IN FIRN.
//
// Die ganze Kette in einer Datei: Text -> Token -> Baum -> Typen -> FIR ->
// x86-64-Assembler -> `as` -> `ld` -> ausfuehrbare Datei.
//
// Aufruf:
//     firnc1 quelle.fi            Assembler auf die Standardausgabe
//     firnc1 quelle.fi -o ziel    ausfuehrbare Datei erzeugen
//
// Mit `-o` legt `firnc1` `ziel.s` an, ruft `/usr/bin/as` und `/usr/bin/ld`
// ueber `fork`/`execve` auf und raeumt die Zwischendateien nicht weg (sie
// sind der beste Beleg dafuer, was wirklich erzeugt wurde). Damit ist Punkt 11
// der Liste in docs/SELBSTHOSTING.md erledigt.
//
// Rueckgabewerte: 0 = Assembler erzeugt · 1 = Fehler · 2 = E/A ·
// 3 = keine Kernsprache · 4 = comptime noetig · 5 = `defer` ·
// 6 = der Codegenerator kann diese FIR nicht (Gleitkomma, > 6 Argumente).

import rt
import vec
import intern
import lexer
import ast
import mono
import muster
import parser
import typen
import sema
import fir
import lower
import codegen

// ------------------------------------------------------------ Modulsystem
//
// `import a.b` sucht `a/b.fi` ZUERST neben der importierenden Datei, dann
// neben der Wurzeldatei — dieselbe Regel wie in `firnc0` (Blocker B3,
// Runde 17). Alle Dateien landen in EINEM Baum und teilen sich EINE
// Namenstafel; die Umbenennung mit `alias__` macht der Parser.

// Verzeichnisteil eines Pfades, einschliesslich des Schraegstrichs.
fn verzeichnis(b: *mut rt.Buf, pfad: u64, n: usize) {
    var letzter: i64 = -1
    var i: usize = 0
    while i < n {
        if rt.ld8(pfad, i) == 47 as u8 {
            letzter = i as i64
        }
        i = i + 1
    }
    if letzter >= 0 {
        rt.buf_push_bytes(b, pfad, letzter as usize + 1)
    }
}

// Baut `<verz><teil1>/<teil2>....fi\0` in `aus`.
fn modulpfad(aus: *mut rt.Buf, verz: *mut rt.Buf, l: *mut lexer.Lexer,
             von: usize, bis: usize) {
    rt.buf_leeren(aus)
    rt.buf_push_bytes(aus, rt.buf_ptr(verz), rt.buf_len(verz))
    var i: usize = von
    while i < bis {
        if lexer.lex_art(l, i) == 1 {
            let nr: u32 = lexer.lex_nr(l, i)
            rt.buf_push_bytes(aus, lexer.lex_name_zeiger(l, nr), lexer.lex_name_laenge(l, nr))
        } else {
            rt.buf_push(aus, 47 as u8)
        }
        i = i + 1
    }
    var e: [u8; 4] = ".fi\0"
    rt.buf_push_bytes(aus, (&e[0]) as u64, 4)
}

// ------------------------------------------------------------ Modulliste
//
// Die Warteschlange aller Dateien dieser Uebersetzung. Index 0 ist IMMER die
// Wurzeldatei — damit ein Modul, das die Wurzel wieder einbindet, sie nicht
// ein zweites Mal einzieht (`modules.rs::resolve` haelt es genauso).
//
// Alle Pfade liegen hintereinander in EINEM Puffer, je mit einer Null
// abgeschlossen, weil `open` sie so braucht. DESHALB darf ein Zeiger aus
// `ml_zeiger` nicht ueber ein `ml_dazu` hinweg benutzt werden: der Puffer
// waechst und liegt danach woanders.
struct Modulliste {
    text: rt.Buf,
    off: Vec[u32],
    laen: Vec[u32],
    alias: Vec[u32],
}

fn ml_neu() -> Modulliste {
    return Modulliste{
        text: rt.buf_neu(),
        off: vec_neu[u32](), laen: vec_neu[u32](), alias: vec_neu[u32](),
    }
}

fn ml_frei(m: *mut Modulliste) {
    rt.buf_frei(&(*m).text)
    vec_frei[u32](&(*m).off)
    vec_frei[u32](&(*m).laen)
    vec_frei[u32](&(*m).alias)
}

fn ml_anzahl(m: *mut Modulliste) -> usize { return vec_len[u32](&(*m).off) }
fn ml_alias(m: *mut Modulliste, i: usize) -> u32 { return vec_at[u32](&(*m).alias, i) }
fn ml_laenge(m: *mut Modulliste, i: usize) -> usize {
    return vec_at[u32](&(*m).laen, i) as usize
}
fn ml_zeiger(m: *mut Modulliste, i: usize) -> u64 {
    return rt.buf_ptr(&(*m).text) + vec_at[u32](&(*m).off, i) as u64
}

fn ml_kennt(m: *mut Modulliste, p: u64, n: usize) -> bool {
    var i: usize = 0
    while i < ml_anzahl(m) {
        if ml_laenge(m, i) == n {
            if rt.mem_eq(ml_zeiger(m, i), p, n) {
                return true
            }
        }
        i = i + 1
    }
    return false
}

fn ml_dazu(m: *mut Modulliste, p: u64, n: usize, alias: u32) {
    vec_push[u32](&(*m).off, rt.buf_len(&(*m).text) as u32)
    vec_push[u32](&(*m).laen, n as u32)
    vec_push[u32](&(*m).alias, alias)
    rt.buf_push_bytes(&(*m).text, p, n)
    rt.buf_push(&(*m).text, 0 as u8)
}

// Alle `import`-Zeilen eines Tokenstroms aufloesen und die noch unbekannten
// Dateien hinten anhaengen. So wird die Liste zur BREITENSUCHE ueber den
// ganzen Einbindungsgraphen: ein Modul darf ein Modul einbinden, ohne dass
// die Wurzeldatei davon wissen muss.
//
// Vor Runde 31 wurden nur die `import`-Zeilen der WURZELDATEI gelesen. Das
// fiel lange nicht auf, weil `bin/firnc1.fi` seine Abhaengigkeiten ohnehin
// alle aufzaehlt — `tests/640_vec_modul.fi` dagegen scheiterte still daran,
// dass `modules/vec.fi` sein eigenes `rt` nicht bekam.
fn imports_sammeln(l: *mut lexer.Lexer, verz: *mut rt.Buf, wurzelverz: *mut rt.Buf,
                   ml: *mut Modulliste) -> i32 {
    var pfad: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&pfad)
    var probe: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&probe)
    var i: usize = 0
    while i + 1 < lexer.lex_anzahl(l) {
        if lexer.lex_art(l, i) != 27 {
            i = i + 1
            continue
        }
        // Pfadteile einsammeln: IDENT (DOT IDENT)*
        var j: usize = i + 1
        var alias: u32 = 0
        while j < lexer.lex_anzahl(l) {
            if lexer.lex_art(l, j) != 1 {
                break
            }
            alias = lexer.lex_nr(l, j)
            j = j + 1
            if j >= lexer.lex_anzahl(l) {
                break
            }
            if lexer.lex_art(l, j) != 43 {
                break
            }
            j = j + 1
        }
        // ZUERST neben der importierenden Datei, dann neben der Wurzeldatei.
        modulpfad(&pfad, verz, l, i + 1, j)
        rt.buf_leeren(&probe)
        if !rt.lies_datei(rt.buf_ptr(&pfad), &probe) {
            modulpfad(&pfad, wurzelverz, l, i + 1, j)
            rt.buf_leeren(&probe)
            if !rt.lies_datei(rt.buf_ptr(&pfad), &probe) {
                return 2
            }
        }
        let n: usize = rt.buf_len(&pfad) - 1
        if !ml_kennt(ml, rt.buf_ptr(&pfad), n) {
            ml_dazu(ml, rt.buf_ptr(&pfad), n, alias)
        }
        i = j
    }
    return 0
}

fn main(start: u64) -> i32 {
    var quelle: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&quelle)
    var name: u64 = 0
    var name_n: usize = 0
    if rt.arg_anzahl(start) > 1 {
        name = rt.arg_zeiger(start, 1)
        name_n = rt.c_laenge(name)
        if !rt.lies_datei(name, &quelle) {
            return 2
        }
    } else {
        var sn: [u8; 7] = "<stdin>"
        name = (&sn[0]) as u64
        name_n = 7
        if !rt.lies_stdin(&quelle) {
            return 2
        }
    }
    var kwtxt: [u8; 172] = "fn|let|var|if|else|while|return|struct|const|profile|as|mut|true|false|syscall|extern|break|continue|defer|errdefer|comptime|for|in|import|export|enum|match|error|try|catch"
    var l: lexer.Lexer = lexer.lex_neu(rt.buf_ptr(&quelle), rt.buf_len(&quelle),
                                       (&kwtxt[0]) as u64, 172, name, name_n)
    defer lexer.lex_frei(&l)
    lexer.lex_lauf(&l)
    if lexer.lex_fehler(&l) > 0 {
        return 1
    }
    let it: *mut intern.Interner = lexer.lex_namen(&l)
    var baum_s: ast.Baum = ast.baum_neu()
    defer ast.baum_frei(&baum_s)
    let baum: *mut ast.Baum = &baum_s

    // --- eingebundene Module suchen und ZUERST uebersetzen: eine Konstante
    // darf eine aus einem anderen Modul benutzen, also muessen die
    // Abhaengigkeiten vorher im Baum stehen.
    var verz: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&verz)
    verzeichnis(&verz, name, name_n)

    // --- generische Vorlagen: erst wissen, WELCHE Namen generisch sind,
    // dann parsen. Vorher ist `Vec[i32]` nicht von einer Indizierung zu
    // unterscheiden.
    var g: mono.Gen = mono.gen_neu(baum as u64, it as u64)
    defer mono.gen_frei(&g)

    // Aufzaehlungen und Musterabgleiche: EINE Registrierung fuer alle
    // Dateien dieser Uebersetzung (Aufzaehlungsnamen gelten programmweit).
    var mu: muster.Mus = muster.mus_neu()
    defer muster.mus_frei(&mu)

    var ml: Modulliste = ml_neu()
    defer ml_frei(&ml)
    ml_dazu(&ml, name, name_n, 4294967295)

    var mquelle: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&mquelle)
    var mpfad: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&mpfad)
    var mverz: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&mverz)

    // --- ERSTER DURCHGANG: Warteschlange aufbauen und die generischen Namen
    // einsammeln. Beides muss VOR dem Parsen der ersten Datei feststehen.
    // Der Preis ist ein zweites Lexen jeder Modulquelle; das ist billiger
    // als alle Lexer gleichzeitig offen zu halten, und es macht die
    // Reihenfolge der `import`-Zeilen bedeutungslos.
    mono.gen_vorab(&g, (&l) as u64)
    let wrc: i32 = imports_sammeln(&l, &verz, &verz, &ml)
    if wrc != 0 {
        return wrc
    }
    var mi: usize = 1
    while mi < ml_anzahl(&ml) {
        rt.buf_leeren(&mpfad)
        rt.buf_push_bytes(&mpfad, ml_zeiger(&ml, mi), ml_laenge(&ml, mi))
        rt.buf_push(&mpfad, 0 as u8)
        rt.buf_leeren(&mquelle)
        if !rt.lies_datei(rt.buf_ptr(&mpfad), &mquelle) {
            return 2
        }
        var vl: lexer.Lexer = lexer.lex_neu(rt.buf_ptr(&mquelle), rt.buf_len(&mquelle),
                                            (&kwtxt[0]) as u64, 172,
                                            rt.buf_ptr(&mpfad), rt.buf_len(&mpfad) - 1)
        lexer.lex_namen_setzen(&vl, it as u64)
        lexer.lex_lauf(&vl)
        if lexer.lex_fehler(&vl) > 0 {
            lexer.lex_frei(&vl)
            return 1
        }
        mono.gen_vorab(&g, (&vl) as u64)
        rt.buf_leeren(&mverz)
        verzeichnis(&mverz, rt.buf_ptr(&mpfad), rt.buf_len(&mpfad) - 1)
        let irc: i32 = imports_sammeln(&vl, &mverz, &verz, &ml)
        lexer.lex_frei(&vl)
        if irc != 0 {
            return irc
        }
        mi = mi + 1
    }

    // --- ZWEITER DURCHGANG: die Module uebersetzen.
    mi = 1
    while mi < ml_anzahl(&ml) {
        rt.buf_leeren(&mpfad)
        rt.buf_push_bytes(&mpfad, ml_zeiger(&ml, mi), ml_laenge(&ml, mi))
        rt.buf_push(&mpfad, 0 as u8)
        let alias: u32 = ml_alias(&ml, mi)
        rt.buf_leeren(&mquelle)
        if !rt.lies_datei(rt.buf_ptr(&mpfad), &mquelle) {
            return 2
        }
        var mlx: lexer.Lexer = lexer.lex_neu(rt.buf_ptr(&mquelle), rt.buf_len(&mquelle),
                                             (&kwtxt[0]) as u64, 172,
                                             rt.buf_ptr(&mpfad), rt.buf_len(&mpfad) - 1)
        lexer.lex_namen_setzen(&mlx, it as u64)
        lexer.lex_lauf(&mlx)
        if lexer.lex_fehler(&mlx) > 0 {
            lexer.lex_frei(&mlx)
            return 1
        }
        var mp: parser.Parser = parser.par_neu_modul((&mlx) as u64, baum as u64, alias)
        parser.par_gen_setzen(&mp, (&g) as u64)
        parser.par_mu_setzen(&mp, (&mu) as u64)
        parser.par_lauf(&mp)
        let schlecht: bool = parser.par_nicht_kern(&mp)
        let fehl: usize = parser.par_fehler(&mp)
        parser.par_frei(&mp)
        lexer.lex_frei(&mlx)
        if schlecht {
            return 3
        }
        if fehl > 0 {
            return 1
        }
        mi = mi + 1
    }

    // --- die Wurzeldatei zuletzt: ihre Namen bleiben unveraendert.
    var p: parser.Parser = parser.par_neu_modul((&l) as u64, baum as u64, 4294967295)
    defer parser.par_frei(&p)
    parser.par_gen_setzen(&p, (&g) as u64)
    parser.par_mu_setzen(&p, (&mu) as u64)
    parser.par_lauf(&p)
    if parser.par_nicht_kern(&p) {
        return 3
    }
    if parser.par_fehler(&p) > 0 {
        return 1
    }

    // --- Monomorphisierung: jede benutzte Typkombination wird eine eigene,
    // vollstaendig konkrete Funktion bzw. ein eigener Struct. Danach sieht
    // der Typpruefer nur noch gewoehnlichen Code.
    mono.gen_lauf(&g)
    if mono.gen_fehler(&g) > 0 {
        return 1
    }

    var sm: sema.Sema = sema.sema_neu(baum as u64, it as u64)
    defer sema.sema_frei(&sm)
    sema.sema_mu_setzen(&sm, (&mu) as u64)
    sema.sema_lauf(&sm)
    if sema.sema_braucht_comptime(&sm) {
        return 4
    }
    if sema.sema_fehler(&sm) > 0 {
        return 1
    }

    var lo: lower.Lower = lower.low_neu(baum as u64, it as u64, (&sm) as u64)
    defer lower.low_frei(&lo)
    lower.low_mu_setzen(&lo, (&mu) as u64)
    lower.low_lauf(&lo)
    if lower.low_ungeeignet(&lo) {
        return 5
    }
    if lower.low_fehler(&lo) > 0 {
        return 1
    }

    var cg: codegen.Cg = codegen.cg_neu(lower.low_fir(&lo) as u64, it as u64)
    defer codegen.cg_frei(&cg)
    codegen.cg_lauf(&cg)
    if codegen.cg_ungeeignet(&cg) {
        return 6
    }
    let aus: *mut rt.Buf = codegen.cg_text(&cg)

    // Ohne `-o`: der Assembler geht auf die Standardausgabe.
    if rt.arg_anzahl(start) < 4 {
        if !rt.schreib_alles(1, rt.buf_ptr(aus), rt.buf_len(aus)) {
            return 2
        }
        return 0
    }
    let ziel: u64 = rt.arg_zeiger(start, 3)
    let ziel_n: usize = rt.c_laenge(ziel)

    // `ziel.s` und `ziel.o` als nullabgeschlossene Namen bauen.
    var sname: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&sname)
    rt.buf_push_bytes(&sname, ziel, ziel_n)
    var endung_s: [u8; 3] = ".s\0"
    rt.buf_push_bytes(&sname, (&endung_s[0]) as u64, 3)

    var oname: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&oname)
    rt.buf_push_bytes(&oname, ziel, ziel_n)
    var endung_o: [u8; 3] = ".o\0"
    rt.buf_push_bytes(&oname, (&endung_o[0]) as u64, 3)

    if !rt.schreib_datei(rt.buf_ptr(&sname), rt.buf_ptr(aus), rt.buf_len(aus)) {
        return 2
    }

    // as --64 -o ziel.o ziel.s
    var as_pfad: [u8; 12] = "/usr/bin/as\0"
    var opt64: [u8; 6] = "--64\0\0"
    var minus_o: [u8; 3] = "-o\0"
    var argv_as: [u64; 6] = [0; 6]
    argv_as[0] = (&as_pfad[0]) as u64
    argv_as[1] = (&opt64[0]) as u64
    argv_as[2] = (&minus_o[0]) as u64
    argv_as[3] = rt.buf_ptr(&oname)
    argv_as[4] = rt.buf_ptr(&sname)
    argv_as[5] = 0
    if rt.lauf((&as_pfad[0]) as u64, (&argv_as[0]) as u64) != 0 {
        return 7
    }

    // ld -o ziel ziel.o
    var ld_pfad: [u8; 12] = "/usr/bin/ld\0"
    var argv_ld: [u64; 5] = [0; 5]
    argv_ld[0] = (&ld_pfad[0]) as u64
    argv_ld[1] = (&minus_o[0]) as u64
    argv_ld[2] = ziel
    argv_ld[3] = rt.buf_ptr(&oname)
    argv_ld[4] = 0
    if rt.lauf((&ld_pfad[0]) as u64, (&argv_ld[0]) as u64) != 0 {
        return 8
    }
    return 0
}
