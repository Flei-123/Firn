// bin/firnc1.fi — DER COMPILER, GESCHRIEBEN IN FIRN.
//
// Die ganze Kette in einer Datei: Text -> Token -> Baum -> Typen -> FIR ->
// x86-64-Assembler -> `as` -> `ld` -> ausfuehrbare Datei.
//
// Aufruf:
//     firnc1 quelle.fi            Assembler auf die Standardausgabe
//     firnc1 quelle.fi -o ziel    ausfuehrbare Datei erzeugen
//
// Mit `-o` legt `firnc1` `ziel.s` an, ruft `/usr/bin/as` und `/usr/bin/ld`
// ueber `fork`/`execve` auf und raeumt die Zwischendateien nicht weg (sie
// sind der beste Beleg dafuer, was wirklich erzeugt wurde). Damit ist Punkt 11
// der Liste in docs/SELBSTHOSTING.md erledigt.
//
// Rueckgabewerte: 0 = Assembler erzeugt · 1 = Fehler · 2 = E/A ·
// 3 = keine Kernsprache · 4 = comptime noetig · 5 = `defer` ·
// 6 = der Codegenerator kann diese FIR nicht (Gleitkomma, > 6 Argumente).

import rt
import vec
import intern
import lexer
import ast
import mono
import muster
import fehler
import zeit
import gc
import gctext
import iface
import parser
import typen
import sema
import fir
import lower
import codegen

// ------------------------------------------------------------ Modulsystem
//
// `import a.b` sucht `a/b.fi` in dieser Reihenfolge: (1) neben der
// importierenden Datei, (2) neben der Wurzeldatei, (3) in `$FIRNLIB`,
// (4) in `<Verzeichnis des laufenden Compiler-Binarys>/../lib` —
// dieselbe Regel wie in `firnc0` (`modules.rs::resolve`). Alle Dateien
// landen in EINEM Baum und teilen sich EINE Namenstafel; die Umbenennung
// mit `alias__` macht der Parser.

// Verzeichnisteil eines Pfades, einschliesslich des Schraegstrichs.
fn verzeichnis(b: *mut rt.Buf, pfad: u64, n: usize) {
    var letzter: i64 = -1
    var i: usize = 0
    while i < n {
        if rt.ld8(pfad, i) == 47 as u8 {
            letzter = i as i64
        }
        i = i + 1
    }
    if letzter >= 0 {
        rt.buf_push_bytes(b, pfad, letzter as usize + 1)
    }
}

// Baut `<verz><teil1>/<teil2>....fi\0` in `aus`.
fn modulpfad(aus: *mut rt.Buf, verz: *mut rt.Buf, l: *mut lexer.Lexer,
             von: usize, bis: usize) {
    rt.buf_leeren(aus)
    rt.buf_push_bytes(aus, rt.buf_ptr(verz), rt.buf_len(verz))
    var i: usize = von
    while i < bis {
        if lexer.lex_art(l, i) == 1 {
            let nr: u32 = lexer.lex_nr(l, i)
            rt.buf_push_bytes(aus, lexer.lex_name_zeiger(l, nr), lexer.lex_name_laenge(l, nr))
        } else {
            rt.buf_push(aus, 47 as u8)
        }
        i = i + 1
    }
    var e: [u8; 4] = ".fi\0"
    rt.buf_push_bytes(aus, (&e[0]) as u64, 4)
}

// Umgebungsvariable im Startblock suchen. Hinter `argv` liegt `envp`:
//     [argc][argv0]..[argvN][0][envp0]..[0][auxv..]
// Rueckgabe: Zeiger auf den WERT hinter `NAME=`, 0 wenn nicht gesetzt.
fn umgebung(start: u64, name: u64, name_n: usize) -> u64 {
    if start == 0 {
        return 0
    }
    var i: usize = 1 + rt.arg_anzahl(start) + 1
    while true {
        let p: u64 = rt.ld64(start, i)
        if p == 0 {
            break
        }
        var j: usize = 0
        var gleich: bool = true
        while j < name_n {
            if rt.ld8(p, j) != rt.ld8(name, j) {
                gleich = false
                break
            }
            j = j + 1
        }
        if gleich && rt.ld8(p, name_n) == 61 as u8 {
            return p + name_n as u64 + 1
        }
        i = i + 1
    }
    return 0
}

// Installationsfallback: Verzeichnis des laufenden Compiler-Binarys,
// gefolgt von `../lib/`. `firnc0` liest dafuer `current_exe`; hier geht
// es ueber `/proc/self/exe`. Bleibt der Aufruf erfolglos, ist der Puffer
// leer und der Schritt wird uebersprungen.
fn exe_suchpfad(aus: *mut rt.Buf) {
    rt.buf_leeren(aus)
    var selbst: [u8; 15] = "/proc/self/exe\0"
    var ziel: [u8; 1024] = [0 as u8; 1024]
    let sp: u64 = (&selbst[0]) as u64
    let zp: u64 = (&ziel[0]) as u64
    let n: i64 = syscall(89, sp as i64, zp as i64, 1023, 0, 0, 0)
    if n <= 0 {
        return
    }
    var letzter: i64 = -1
    var i: usize = 0
    while i < n as usize {
        if ziel[i] == 47 as u8 {
            letzter = i as i64
        }
        i = i + 1
    }
    if letzter < 0 {
        return
    }
    rt.buf_push_bytes(aus, zp, letzter as usize + 1)
    var rest: [u8; 8] = "../lib/\0"
    rt.buf_push_bytes(aus, (&rest[0]) as u64, 7)
}

// ------------------------------------------------------------ Modulliste
//
// Die Warteschlange aller Dateien dieser Uebersetzung. Index 0 ist IMMER die
// Wurzeldatei — damit ein Modul, das die Wurzel wieder einbindet, sie nicht
// ein zweites Mal einzieht (`modules.rs::resolve` haelt es genauso).
//
// Alle Pfade liegen hintereinander in EINEM Puffer, je mit einer Null
// abgeschlossen, weil `open` sie so braucht. DESHALB darf ein Zeiger aus
// `ml_zeiger` nicht ueber ein `ml_dazu` hinweg benutzt werden: der Puffer
// waechst und liegt danach woanders.
struct Modulliste {
    text: rt.Buf,
    off: Vec[u32],
    laen: Vec[u32],
    alias: Vec[u32],
}

fn ml_neu() -> Modulliste {
    return Modulliste{
        text: rt.buf_neu(),
        off: vec_neu[u32](), laen: vec_neu[u32](), alias: vec_neu[u32](),
    }
}

fn ml_frei(m: *mut Modulliste) {
    rt.buf_frei(&(*m).text)
    vec_frei[u32](&(*m).off)
    vec_frei[u32](&(*m).laen)
    vec_frei[u32](&(*m).alias)
}

fn ml_anzahl(m: *mut Modulliste) -> usize { return vec_len[u32](&(*m).off) }
fn ml_alias(m: *mut Modulliste, i: usize) -> u32 { return vec_at[u32](&(*m).alias, i) }
fn ml_laenge(m: *mut Modulliste, i: usize) -> usize {
    return vec_at[u32](&(*m).laen, i) as usize
}
fn ml_zeiger(m: *mut Modulliste, i: usize) -> u64 {
    return rt.buf_ptr(&(*m).text) + vec_at[u32](&(*m).off, i) as u64
}

fn ml_kennt(m: *mut Modulliste, p: u64, n: usize) -> bool {
    var i: usize = 0
    while i < ml_anzahl(m) {
        if ml_laenge(m, i) == n {
            if rt.mem_eq(ml_zeiger(m, i), p, n) {
                return true
            }
        }
        i = i + 1
    }
    return false
}

fn ml_dazu(m: *mut Modulliste, p: u64, n: usize, alias: u32) {
    vec_push[u32](&(*m).off, rt.buf_len(&(*m).text) as u32)
    vec_push[u32](&(*m).laen, n as u32)
    vec_push[u32](&(*m).alias, alias)
    rt.buf_push_bytes(&(*m).text, p, n)
    rt.buf_push(&(*m).text, 0 as u8)
}

// Alle `import`-Zeilen eines Tokenstroms aufloesen und die noch unbekannten
// Dateien hinten anhaengen. So wird die Liste zur BREITENSUCHE ueber den
// ganzen Einbindungsgraphen: ein Modul darf ein Modul einbinden, ohne dass
// die Wurzeldatei davon wissen muss.
//
// Vor Runde 31 wurden nur die `import`-Zeilen der WURZELDATEI gelesen. Das
// fiel lange nicht auf, weil `bin/firnc1.fi` seine Abhaengigkeiten ohnehin
// alle aufzaehlt — `tests/640_vec_modul.fi` dagegen scheiterte still daran,
// dass `modules/vec.fi` sein eigenes `rt` nicht bekam.
fn imports_sammeln(l: *mut lexer.Lexer, verz: *mut rt.Buf, wurzelverz: *mut rt.Buf,
                   firnlib: *mut rt.Buf, exelib: *mut rt.Buf,
                   ml: *mut Modulliste) -> i32 {
    var pfad: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&pfad)
    var probe: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&probe)
    var i: usize = 0
    while i + 1 < lexer.lex_anzahl(l) {
        if lexer.lex_art(l, i) != 27 {
            i = i + 1
            continue
        }
        // Pfadteile einsammeln: IDENT (DOT IDENT)*
        var j: usize = i + 1
        var alias: u32 = 0
        while j < lexer.lex_anzahl(l) {
            if lexer.lex_art(l, j) != 1 {
                break
            }
            alias = lexer.lex_nr(l, j)
            j = j + 1
            if j >= lexer.lex_anzahl(l) {
                break
            }
            if lexer.lex_art(l, j) != 43 {
                break
            }
            j = j + 1
        }
        // (1) neben der importierenden Datei, (2) neben der Wurzeldatei,
        // (3) $FIRNLIB, (4) <exe>/../lib — derselbe Ablauf wie in
        // `modules.rs::resolve`. Leere Puffer (Variable nicht gesetzt,
        // readlink erfolglos) ueberspringen ihren Schritt. Der Treffer
        // steht im Rueckgabewert, NICHT in der Pufferlaenge: eine leere
        // Datei ist ein gueltiges Modul.
        var gefunden: bool = false
        modulpfad(&pfad, verz, l, i + 1, j)
        rt.buf_leeren(&probe)
        if rt.lies_datei(rt.buf_ptr(&pfad), &probe) {
            gefunden = true
        }
        if !gefunden {
            modulpfad(&pfad, wurzelverz, l, i + 1, j)
            rt.buf_leeren(&probe)
            if rt.lies_datei(rt.buf_ptr(&pfad), &probe) {
                gefunden = true
            }
        }
        if !gefunden && rt.buf_len(firnlib) > 0 {
            modulpfad(&pfad, firnlib, l, i + 1, j)
            rt.buf_leeren(&probe)
            if rt.lies_datei(rt.buf_ptr(&pfad), &probe) {
                gefunden = true
            }
        }
        if !gefunden && rt.buf_len(exelib) > 0 {
            modulpfad(&pfad, exelib, l, i + 1, j)
            rt.buf_leeren(&probe)
            if rt.lies_datei(rt.buf_ptr(&pfad), &probe) {
                gefunden = true
            }
        }
        if !gefunden {
            return 2
        }
        let n: usize = rt.buf_len(&pfad) - 1
        if !ml_kennt(ml, rt.buf_ptr(&pfad), n) {
            ml_dazu(ml, rt.buf_ptr(&pfad), n, alias)
        }
        i = j
    }
    return 0
}

fn main(start: u64) -> i32 {
    var quelle: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&quelle)
    var name: u64 = 0
    var name_n: usize = 0
    if rt.arg_anzahl(start) > 1 {
        name = rt.arg_zeiger(start, 1)
        name_n = rt.c_laenge(name)
        if !rt.lies_datei(name, &quelle) {
            return 2
        }
    } else {
        var sn: [u8; 7] = "<stdin>"
        name = (&sn[0]) as u64
        name_n = 7
        if !rt.lies_stdin(&quelle) {
            return 2
        }
    }
    var kwtxt: [u8; 172] = "fn|let|var|if|else|while|return|struct|const|profile|as|mut|true|false|syscall|extern|break|continue|defer|errdefer|comptime|for|in|import|export|enum|match|error|try|catch"
    var l: lexer.Lexer = lexer.lex_neu(rt.buf_ptr(&quelle), rt.buf_len(&quelle),
                                       (&kwtxt[0]) as u64, 172, name, name_n)
    defer lexer.lex_frei(&l)
    lexer.lex_lauf(&l)
    if lexer.lex_fehler(&l) > 0 {
        return 1
    }
    let it: *mut intern.Interner = lexer.lex_namen(&l)
    var baum_s: ast.Baum = ast.baum_neu()
    defer ast.baum_frei(&baum_s)
    let baum: *mut ast.Baum = &baum_s

    // --- eingebundene Module suchen und ZUERST uebersetzen: eine Konstante
    // darf eine aus einem anderen Modul benutzen, also muessen die
    // Abhaengigkeiten vorher im Baum stehen.
    var verz: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&verz)
    verzeichnis(&verz, name, name_n)

    // --- Zusaetzliche Modul-Suchpfade: $FIRNLIB (mit Schraegstrich
    // abgeschlossen, `modulpfad` haengt die Teile direkt an) und
    // `<exe>/../lib/`. Beide bleiben leer, wenn es sie nicht gibt.
    var firnlib: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&firnlib)
    var flname: [u8; 7] = "FIRNLIB"
    let flwert: u64 = umgebung(start, (&flname[0]) as u64, 7)
    if flwert != 0 {
        rt.buf_push_bytes(&firnlib, flwert, rt.c_laenge(flwert))
        if rt.buf_len(&firnlib) > 0 {
            if rt.buf_at(&firnlib, rt.buf_len(&firnlib) - 1) != 47 as u8 {
                rt.buf_push(&firnlib, 47 as u8)
            }
        }
    }
    var exelib: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&exelib)
    exe_suchpfad(&exelib)

    // --- generische Vorlagen: erst wissen, WELCHE Namen generisch sind,
    // dann parsen. Vorher ist `Vec[i32]` nicht von einer Indizierung zu
    // unterscheiden.
    var g: mono.Gen = mono.gen_neu(baum as u64, it as u64)
    defer mono.gen_frei(&g)

    // Aufzaehlungen und Musterabgleiche: EINE Registrierung fuer alle
    // Dateien dieser Uebersetzung (Aufzaehlungsnamen gelten programmweit).
    var mu: muster.Mus = muster.mus_neu()
    defer muster.mus_frei(&mu)

    // Fehlermengen und -unionen: EINE Registrierung fuer alle Dateien
    // dieser Uebersetzung (Fehlermengennamen gelten programmweit, SPEC §14.1).
    var fe: fehler.Fehler = fehler.fehler_neu()
    defer fehler.fehler_frei(&fe)

    // gc-Klassen: EINE Registrierung fuer alle Dateien dieser Uebersetzung
    // (Runde 34 — Klassennamen gelten programmweit, wie die Aufzaehlungen).
    var gcreg: gc.Gc = gc.gc_neu()
    defer gc.gc_frei(&gcreg)

    // Schnittstellen: EINE Registrierung fuer alle Dateien dieser
    // Uebersetzung (Runde 46 — Schnittstellennamen gelten programmweit).
    var ifreg: iface.If = iface.if_neu()
    defer iface.if_frei(&ifreg)

    var ml: Modulliste = ml_neu()
    defer ml_frei(&ml)
    ml_dazu(&ml, name, name_n, 4294967295)

    var mquelle: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&mquelle)
    var mpfad: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&mpfad)
    var mverz: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&mverz)

    // --- GC-SUCHE am Tokenstrom (quelle_braucht_gc / quelle_hat_allocerror
    // in gc.rs): steht irgendwo `gc class`, wird die Sammler-Laufzeit
    // (lib/gc/gc.fi, eingebettet in gctext.fi) als zusaetzliches Modul
    // eingezogen; deklariert das Programm `AllocError` selbst, faellt die
    // mitgelieferte Fehlermenge weg.
    var sgc: [u8; 2] = "gc"
    var scl: [u8; 5] = "class"
    var sae: [u8; 10] = "AllocError"
    var sfin: [u8; 16] = "__gc_finalisiere"
    // intern_nummer statt intern_finde: die drei Woerter muessen im Interner
    // STEHEN, sonst sucht der Scan mit -1 und findet nichts — genau dann,
    // wenn die Wurzeldatei selbst kein `gc` enthaelt und das Schluesselwort
    // erst in einem importierten Modul auftaucht (Runde-34-Fund: 560 lief
    // nicht, weil nur modules/dom.fi `gc class` hat).
    let gc_nr: i64 = intern.intern_nummer(it, (&sgc[0]) as u64, 2) as i64
    let class_nr: i64 = intern.intern_nummer(it, (&scl[0]) as u64, 5) as i64
    let ae_nr: i64 = intern.intern_nummer(it, (&sae[0]) as u64, 10) as i64
    let fin_nr: i64 = intern.intern_nummer(it, (&sfin[0]) as u64, 16) as i64
    var gc_scan: u32 = gc.gc_quelle_scan((&l) as u64, gc_nr, class_nr, ae_nr, fin_nr)

    // --- ERSTER DURCHGANG: Warteschlange aufbauen und die generischen Namen
    // einsammeln. Beides muss VOR dem Parsen der ersten Datei feststehen.
    // Der Preis ist ein zweites Lexen jeder Modulquelle; das ist billiger
    // als alle Lexer gleichzeitig offen zu halten, und es macht die
    // Reihenfolge der `import`-Zeilen bedeutungslos.
    mono.gen_vorab(&g, (&l) as u64)
    let wrc: i32 = imports_sammeln(&l, &verz, &verz, &firnlib, &exelib, &ml)
    if wrc != 0 {
        return wrc
    }
    var mi: usize = 1
    while mi < ml_anzahl(&ml) {
        rt.buf_leeren(&mpfad)
        rt.buf_push_bytes(&mpfad, ml_zeiger(&ml, mi), ml_laenge(&ml, mi))
        rt.buf_push(&mpfad, 0 as u8)
        rt.buf_leeren(&mquelle)
        if !rt.lies_datei(rt.buf_ptr(&mpfad), &mquelle) {
            return 2
        }
        var vl: lexer.Lexer = lexer.lex_neu(rt.buf_ptr(&mquelle), rt.buf_len(&mquelle),
                                            (&kwtxt[0]) as u64, 172,
                                            rt.buf_ptr(&mpfad), rt.buf_len(&mpfad) - 1)
        lexer.lex_namen_setzen(&vl, it as u64)
        lexer.lex_lauf(&vl)
        if lexer.lex_fehler(&vl) > 0 {
            lexer.lex_frei(&vl)
            return 1
        }
        mono.gen_vorab(&g, (&vl) as u64)
        // Runde 47: Bit 4 (eigener Finalisierer-Verteiler) zaehlt NUR aus der
        // Wurzeldatei — Modulergebnisse werden mit 3 maskiert.
        gc_scan = gc_scan | (gc.gc_quelle_scan((&vl) as u64, gc_nr, class_nr, ae_nr, fin_nr) & 3)
        rt.buf_leeren(&mverz)
        verzeichnis(&mverz, rt.buf_ptr(&mpfad), rt.buf_len(&mpfad) - 1)
        let irc: i32 = imports_sammeln(&vl, &mverz, &verz, &firnlib, &exelib, &ml)
        lexer.lex_frei(&vl)
        if irc != 0 {
            return irc
        }
        mi = mi + 1
    }

    // --- ZWEITER DURCHGANG: die Module uebersetzen.
    mi = 1
    while mi < ml_anzahl(&ml) {
        rt.buf_leeren(&mpfad)
        rt.buf_push_bytes(&mpfad, ml_zeiger(&ml, mi), ml_laenge(&ml, mi))
        rt.buf_push(&mpfad, 0 as u8)
        let alias: u32 = ml_alias(&ml, mi)
        rt.buf_leeren(&mquelle)
        if !rt.lies_datei(rt.buf_ptr(&mpfad), &mquelle) {
            return 2
        }
        var mlx: lexer.Lexer = lexer.lex_neu(rt.buf_ptr(&mquelle), rt.buf_len(&mquelle),
                                             (&kwtxt[0]) as u64, 172,
                                             rt.buf_ptr(&mpfad), rt.buf_len(&mpfad) - 1)
        lexer.lex_namen_setzen(&mlx, it as u64)
        lexer.lex_lauf(&mlx)
        if lexer.lex_fehler(&mlx) > 0 {
            lexer.lex_frei(&mlx)
            return 1
        }
        var mp: parser.Parser = parser.par_neu_modul((&mlx) as u64, baum as u64, alias)
        parser.par_gen_setzen(&mp, (&g) as u64)
        parser.par_mu_setzen(&mp, (&mu) as u64)
        parser.par_fe_setzen(&mp, (&fe) as u64)
        parser.par_gc_setzen(&mp, (&gcreg) as u64)
        parser.par_if_setzen(&mp, (&ifreg) as u64)
        parser.par_zeit_setzen(&mp)
        parser.par_lauf(&mp)
        let schlecht: bool = parser.par_nicht_kern(&mp)
        let fehl: usize = parser.par_fehler(&mp)
        parser.par_frei(&mp)
        lexer.lex_frei(&mlx)
        if schlecht {
            return 3
        }
        if fehl > 0 {
            return 1
        }
        mi = mi + 1
    }

    // --- die Wurzeldatei zuletzt: ihre Namen bleiben unveraendert.
    var p: parser.Parser = parser.par_neu_modul((&l) as u64, baum as u64, 4294967295)
    defer parser.par_frei(&p)
    parser.par_gen_setzen(&p, (&g) as u64)
    parser.par_mu_setzen(&p, (&mu) as u64)
    parser.par_fe_setzen(&p, (&fe) as u64)
    parser.par_gc_setzen(&p, (&gcreg) as u64)
    parser.par_if_setzen(&p, (&ifreg) as u64)
    parser.par_zeit_setzen(&p)
    parser.par_lauf(&p)
    if parser.par_nicht_kern(&p) {
        return 3
    }
    if parser.par_fehler(&p) > 0 {
        return 1
    }

    // --- die Sammler-Laufzeit automatisch einziehen, sobald irgendwo ein
    // `gc class` steht (Runde 34; HOOK gc in modules.rs, SPEC 3.5). Sie
    // liegt im WURZELNAMENSRAUM: `gc_init()` heisst in jedem Modul
    // `gc_init()`, ohne `import` und ohne Modulpraefix.
    if gc_scan & 1 != 0 {
        var gq: rt.Buf = rt.buf_neu()
        defer rt.buf_frei(&gq)
        if gc_scan & 2 == 0 {
            var aed: [u8; 33] = "error AllocError { OutOfMemory }\n"
            rt.buf_push_bytes(&gq, (&aed[0]) as u64, 33)
        }
        // Runde 47: die leere Voreinstellung des Finalisierer-Verteilers —
        // nur, wenn die Wurzeldatei keinen eigenen mitbringt (Bit 4).
        // Wortgleich mit gc.rs::finalisierer_default.
        if gc_scan & 4 == 0 {
            var fdt: [u8; 221] = "// Runde 47: Voreinstellung des Finalisierer-Verteilers. Das Programm\n// deklariert keinen eigenen, also tut das Aufraeumen nichts.\nfn __gc_finalisiere(art: u64, p: *mut u8) {\n    let _unbenutzt: u64 = art + (p as u64)\n}\n"
            rt.buf_push_bytes(&gq, (&fdt[0]) as u64, 221)
        }
        gctext.gctext_schreiben(&gq)
        var gpn: [u8; 12] = "lib/gc/gc.fi"
        var gl: lexer.Lexer = lexer.lex_neu(rt.buf_ptr(&gq), rt.buf_len(&gq),
                                            (&kwtxt[0]) as u64, 172,
                                            (&gpn[0]) as u64, 12)
        lexer.lex_namen_setzen(&gl, it as u64)
        lexer.lex_lauf(&gl)
        if lexer.lex_fehler(&gl) > 0 {
            lexer.lex_frei(&gl)
            return 1
        }
        var gp: parser.Parser = parser.par_neu_modul((&gl) as u64, baum as u64, 4294967295)
        parser.par_gen_setzen(&gp, (&g) as u64)
        parser.par_mu_setzen(&gp, (&mu) as u64)
        parser.par_fe_setzen(&gp, (&fe) as u64)
        parser.par_gc_setzen(&gp, (&gcreg) as u64)
        parser.par_if_setzen(&gp, (&ifreg) as u64)
        parser.par_lauf(&gp)
        let gschlecht: bool = parser.par_nicht_kern(&gp)
        let gfehl: usize = parser.par_fehler(&gp)
        parser.par_frei(&gp)
        lexer.lex_frei(&gl)
        if gschlecht {
            return 3
        }
        if gfehl > 0 {
            return 1
        }
    }

    // --- comptime: die Bloecke der Wurzeldatei laufen VOR der Typpruefung.
    // Was sie per `emit_roh`/`emit_zahl` schreiben, ist FIRN-QUELLTEXT, den
    // derselbe Lauf lext, parst und ans Programm anhaengt — danach sieht der
    // Typpruefer keinen Unterschied zu handgeschriebenem Quelltext
    // (SPEC §6.4, Abnahmepunkt 6; Vorbild compiler/src/main.rs).
    if ast.ct_anzahl(baum) > 0 {
        var zt: zeit.Zeit = zeit.zeit_neu(baum as u64, it as u64,
                                          rt.buf_ptr(&verz), rt.buf_len(&verz))
        zeit.zeit_lauf(&zt)
        if zeit.zeit_fehler(&zt) > 0 {
            zeit.zeit_frei(&zt)
            return 1
        }
        let ausg: *mut rt.Buf = zeit.zeit_ausgabe(&zt)
        if rt.buf_len(ausg) > 0 {
            var ctname: [u8; 10] = "<comptime>"
            var ctl: lexer.Lexer = lexer.lex_neu(rt.buf_ptr(ausg), rt.buf_len(ausg),
                                                 (&kwtxt[0]) as u64, 172,
                                                 (&ctname[0]) as u64, 10)
            lexer.lex_namen_setzen(&ctl, it as u64)
            lexer.lex_lauf(&ctl)
            if lexer.lex_fehler(&ctl) > 0 {
                lexer.lex_frei(&ctl)
                zeit.zeit_frei(&zt)
                return 1
            }
            var ctp: parser.Parser = parser.par_neu_modul((&ctl) as u64, baum as u64, 4294967295)
            parser.par_gen_setzen(&ctp, (&g) as u64)
            parser.par_mu_setzen(&ctp, (&mu) as u64)
            parser.par_fe_setzen(&ctp, (&fe) as u64)
            parser.par_gc_setzen(&ctp, (&gcreg) as u64)
            parser.par_if_setzen(&ctp, (&ifreg) as u64)
            parser.par_lauf(&ctp)
            let ctschlecht: bool = parser.par_nicht_kern(&ctp)
            let ctfehl: usize = parser.par_fehler(&ctp)
            parser.par_frei(&ctp)
            lexer.lex_frei(&ctl)
            zeit.zeit_frei(&zt)
            if ctschlecht {
                return 3
            }
            if ctfehl > 0 {
                return 1
            }
        } else {
            zeit.zeit_frei(&zt)
        }
    }

    // --- Monomorphisierung: jede benutzte Typkombination wird eine eigene,
    // vollstaendig konkrete Funktion bzw. ein eigener Struct. Danach sieht
    // der Typpruefer nur noch gewoehnlichen Code.
    mono.gen_lauf(&g)
    if mono.gen_fehler(&g) > 0 {
        return 1
    }

    var sm: sema.Sema = sema.sema_neu(baum as u64, it as u64)
    defer sema.sema_frei(&sm)
    sema.sema_mu_setzen(&sm, (&mu) as u64)
    sema.sema_fe_setzen(&sm, (&fe) as u64)
    sema.sema_gc_setzen(&sm, (&gcreg) as u64)
    sema.sema_if_setzen(&sm, (&ifreg) as u64)
    sema.sema_lauf(&sm)
    if sema.sema_braucht_comptime(&sm) {
        return 4
    }
    if sema.sema_fehler(&sm) > 0 {
        return 1
    }

    var lo: lower.Lower = lower.low_neu(baum as u64, it as u64, (&sm) as u64)
    defer lower.low_frei(&lo)
    lower.low_mu_setzen(&lo, (&mu) as u64)
    lower.low_fe_setzen(&lo, (&fe) as u64)
    lower.low_gc_setzen(&lo, (&gcreg) as u64)
    lower.low_if_setzen(&lo, (&ifreg) as u64)
    lower.low_lauf(&lo)
    if lower.low_ungeeignet(&lo) {
        return 5
    }
    if lower.low_fehler(&lo) > 0 {
        return 1
    }

    var cg: codegen.Cg = codegen.cg_neu(lower.low_fir(&lo) as u64, it as u64)
    defer codegen.cg_frei(&cg)
    codegen.cg_gc_setzen(&cg, (&gcreg) as u64)
    codegen.cg_if_setzen(&cg, (&ifreg) as u64)
    codegen.cg_lauf(&cg)
    if codegen.cg_ungeeignet(&cg) {
        return 6
    }
    let aus: *mut rt.Buf = codegen.cg_text(&cg)

    // Ohne `-o`: der Assembler geht auf die Standardausgabe.
    if rt.arg_anzahl(start) < 4 {
        if !rt.schreib_alles(1, rt.buf_ptr(aus), rt.buf_len(aus)) {
            return 2
        }
        return 0
    }
    let ziel: u64 = rt.arg_zeiger(start, 3)
    let ziel_n: usize = rt.c_laenge(ziel)

    // `ziel.s` und `ziel.o` als nullabgeschlossene Namen bauen.
    var sname: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&sname)
    rt.buf_push_bytes(&sname, ziel, ziel_n)
    var endung_s: [u8; 3] = ".s\0"
    rt.buf_push_bytes(&sname, (&endung_s[0]) as u64, 3)

    var oname: rt.Buf = rt.buf_neu()
    defer rt.buf_frei(&oname)
    rt.buf_push_bytes(&oname, ziel, ziel_n)
    var endung_o: [u8; 3] = ".o\0"
    rt.buf_push_bytes(&oname, (&endung_o[0]) as u64, 3)

    if !rt.schreib_datei(rt.buf_ptr(&sname), rt.buf_ptr(aus), rt.buf_len(aus)) {
        return 2
    }

    // as --64 -o ziel.o ziel.s
    var as_pfad: [u8; 12] = "/usr/bin/as\0"
    var opt64: [u8; 6] = "--64\0\0"
    var minus_o: [u8; 3] = "-o\0"
    var argv_as: [u64; 6] = [0; 6]
    argv_as[0] = (&as_pfad[0]) as u64
    argv_as[1] = (&opt64[0]) as u64
    argv_as[2] = (&minus_o[0]) as u64
    argv_as[3] = rt.buf_ptr(&oname)
    argv_as[4] = rt.buf_ptr(&sname)
    argv_as[5] = 0
    if rt.lauf((&as_pfad[0]) as u64, (&argv_as[0]) as u64) != 0 {
        return 7
    }

    // ld -o ziel ziel.o
    var ld_pfad: [u8; 12] = "/usr/bin/ld\0"
    var argv_ld: [u64; 5] = [0; 5]
    argv_ld[0] = (&ld_pfad[0]) as u64
    argv_ld[1] = (&minus_o[0]) as u64
    argv_ld[2] = ziel
    argv_ld[3] = rt.buf_ptr(&oname)
    argv_ld[4] = 0
    if rt.lauf((&ld_pfad[0]) as u64, (&argv_ld[0]) as u64) != 0 {
        return 8
    }
    return 0
}
