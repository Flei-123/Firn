// tools/vspy_cross/vspy_tool.fi -- command line face of std.dict and fsx.find
// for the cross-check against Python (tools/vspy_cross/run.sh).
//
//   vspy_tool dict FILE     ops per line, TAB separated: set K V | inc K D | rm K | get K
//                           -> one result line per op, then "keys" "sorted" "top" dumps
//   vspy_tool find ROOT PATTERN MIN_SIZE MAX_MTIME_NS   -> relative paths, sorted
import std.dict
import std.fsx
import std.fs
import std.io
import std.rt
import std.str
import std.vec
import std.num

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn num_of(s: str) -> i64 {
    return num.parse_i64(str.span(s.p, s.length())).value
}

fn field(line: str, k: usize) -> str {
    var start: usize = 0
    var idx: usize = 0
    var i: usize = 0
    while i <= line.length() {
        if i == line.length() || *(((line.p as u64) + i as u64) as *mut u8) == (9 as u8) {
            if idx == k {
                return str { p: ((line.p as u64) + start as u64) as *mut u8, n: i - start }
            }
            idx = idx + 1
            start = i + 1
        }
        i = i + 1
    }
    return str { p: line.p, n: 0 }
}

fn run_dict(path: str) {
    var b: rt.Buf = rt.buf_new()
    fs.read_file(path, &b) catch 0
    var d: Dict[i64] = dict_new[i64]()
    var pos: usize = 0
    let n: usize = rt.buf_len(&b)
    while pos < n {
        var e: usize = pos
        while e < n && rt.buf_at(&b, e) != (10 as u8) {
            e = e + 1
        }
        let line: str = str { p: ((rt.buf_ptr(&b)) + pos as u64) as *mut u8, n: e - pos }
        pos = e + 1
        let op: str = field(line, 0)
        let key: str = field(line, 1)
        if op == "set" {
            dict_set[i64](&d, key, num_of(field(line, 2)))
            io.print_line("-")
        } else if op == "inc" {
            io.fmt_print_line(f"{dict_inc[i64](&d, key, num_of(field(line, 2)))}")
        } else if op == "rm" {
            let r: bool = dict_remove[i64](&d, key)
            io.fmt_print_line(f"{r}")
        } else {
            var out: i64 = 0
            if dict_get_if[i64](&d, key, &out) {
                io.fmt_print_line(f"{out}")
            } else {
                io.print_line("none")
            }
        }
    }
    io.fmt_print_line(f"len {dict_len[i64](&d)}")
    var i: usize = dict_first[i64](&d)
    while i != dict_end[i64](&d) {
        io.fmt_print_line(f"item {dict_key[i64](&d, i)}\t{dict_val[i64](&d, i)}")
        i = dict_next[i64](&d, i + 1)
    }
    var ks: Vec[str] = vec_new[str]()
    dict_keys_sorted[i64](&d, &ks)
    for k in 0..vec_len[str](&ks) {
        io.fmt_print_line(f"sorted {*vec_elem_ptr[str](&ks, k)}")
    }
    var top: Vec[DictItem[i64]] = vec_new[DictItem[i64]]()
    dict_top[i64](&d, 7, &top)
    for k in 0..vec_len[DictItem[i64]](&top) {
        let it = *vec_elem_ptr[DictItem[i64]](&top, k)
        io.fmt_print_line(f"top {it.key}\t{it.val}")
    }
    dict_free[i64](&d)
    rt.buf_free(&b)
}

#[allow_escape]
fn run_find(root: str, pat: str, min_size: i64, max_mtime: i64) {
    var files: Vec[str] = vec_new[str]()
    let n = fsx.find(root, pat, min_size as u64, max_mtime, &files) catch 0
    io.fmt_print_line(f"count {n}")
    for k in 0..vec_len[str](&files) {
        io.fmt_print_line(f"{fsx.relpath(*vec_elem_ptr[str](&files, k), root)}")
    }
}

fn main(start: u64) -> i32 {
    if !gc_init() { return 1 }
    if arg(start, 1) == "dict" {
        run_dict(arg(start, 2))
    } else {
        run_find(arg(start, 2), arg(start, 3), num_of(arg(start, 4)), num_of(arg(start, 5)))
    }
    return 0
}
