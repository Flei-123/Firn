// SPDX-License-Identifier: MPL-2.0
// tools/dialogd/dialogd_main.fi -- dialogd, the fUi dialog service (docs/DIALOG.md, "The dialog service").
//
//     dialogd --stdio          reads ONE request line on standard input, shows the dialog, writes ONE answer line
//
// The line protocol is lib/std/dialogproto.fi's: TAB separated, escaped. std.dialog starts this program when the
// machine has neither zenity nor kdialog (FIRN_DIALOG=service forces it); on OrientOS the same lines travel over
// the action bus (dialog.open_file, dialog.save_file, dialog.pick_folder, dialog.pick_color, dialog.pick_font,
// dialog.message).
//
//   message      kind title text buttons              -> ok<TAB>ans_ok|ans_cancel|ans_yes|ans_no | cancel
//   open_file    title dir filters                    -> ok<TAB>path | cancel
//   open_files   title dir filters                    -> ok<TAB>path1\npath2 | cancel
//   save_file    title dir name filters               -> ok<TAB>path | cancel
//   pick_folder  title dir                            -> ok<TAB>path | cancel
//   pick_color   title rrggbb                         -> ok<TAB>rrggbb | cancel
//   pick_font    title family size                    -> ok<TAB>family<TAB>size<TAB>bold<TAB>italic | cancel
//
// This file is only the PROTOCOL. The dialogs themselves are fUi building blocks that any fUi program can use as
// well (roadmap fUi r177):
//
//   lib/fui/filedlg.fi   file / files / save / folder dialog with real navigation
//   lib/fui/colordlg.fi  colour chooser (basic colours, spectrum + brightness, RGB / HSV / hex, custom colours)
//   lib/fui/fontdlg.fi   font chooser (families, styles, sizes, preview)
//   lib/fui/msgdlg.fi    message / question box with icons
//
// Closing the window is a cancel. A dialog that cannot open a window (no display, no font) answers `failed`.
import std.rt
import std.dialogproto
import fui.filedlg
import fui.colordlg
import fui.fontdlg
import fui.msgdlg

fn say_err(s: str) {
    syscall(1, 2, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn out(b: *mut rt.Buf) {
    syscall(1, 1, rt.buf_ptr(b) as i64, rt.buf_len(b) as i64, 0, 0, 0)
}

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn view(b: *mut rt.Buf) -> str {
    return str { p: rt.buf_data(b), n: rt.buf_len(b) }
}

// Decimal digits at the start of `s` (stops at the first other byte).
fn num(s: str) -> i32 {
    var v: i32 = 0
    var i: usize = 0
    while i < s.length() && s.chars(i) >= 48 as u8 && s.chars(i) <= 57 as u8 && v < 100000000 {
        v = v * 10 + (s.chars(i) - 48 as u8) as i32
        i = i + 1
    }
    return v
}

// "#rrggbb", "rrggbb": false when it is not six hex digits.
fn parse_hex(s: str, out: *mut u32) -> bool {
    var i: usize = 0
    if i < s.length() && s.chars(i) == 35 as u8 {
        i = i + 1
    }
    var v: u32 = 0 as u32
    var n: usize = 0
    while i < s.length() {
        let d: i32 = dialogproto.hex_digit(s.chars(i))
        if d < 0 {
            return false
        }
        v = (v << 4) | d as u32
        n = n + 1
        i = i + 1
    }
    if n != 6 {
        return false
    }
    *out = v
    return true
}

// One answer: "failed", "cancel", or "ok" + the fields.
fn reply_failed(o: *mut rt.Buf) {
    rt.buf_push_bytes(o, "failed\n".p as u64, 7)
}

fn reply_cancel(o: *mut rt.Buf) {
    rt.buf_push_bytes(o, "cancel\n".p as u64, 7)
}

fn reply_status(o: *mut rt.Buf, rc: i32) -> bool {
    if rc == 0 {
        return true
    }
    if rc == 1 {
        reply_cancel(o)
    } else {
        reply_failed(o)
    }
    return false
}

fn serve_message(line: str, o: *mut rt.Buf) {
    var k: rt.Buf = rt.buf_new()
    var title: rt.Buf = rt.buf_new()
    var text: rt.Buf = rt.buf_new()
    var btn: rt.Buf = rt.buf_new()
    dialogproto.field_at(line, 1, &k)
    dialogproto.field_at(line, 2, &title)
    dialogproto.field_at(line, 3, &text)
    dialogproto.field_at(line, 4, &btn)
    var answer: i32 = 0
    let rc: i32 = msgdlg.run(num(view(&k)), view(&title), view(&text), num(view(&btn)), &answer)
    if reply_status(o, rc) {
        dialogproto.push_field(o, "ok", true)
        if answer == 3 {
            dialogproto.push_field(o, "ans_yes", false)
        } else if answer == 4 {
            dialogproto.push_field(o, "ans_no", false)
        } else if answer == 2 {
            dialogproto.push_field(o, "ans_cancel", false)
        } else {
            dialogproto.push_field(o, "ans_ok", false)
        }
        rt.buf_push(o, 10 as u8)
    }
    rt.buf_free(&k)
    rt.buf_free(&title)
    rt.buf_free(&text)
    rt.buf_free(&btn)
}

fn serve_file(verb: str, line: str, o: *mut rt.Buf) {
    var title: rt.Buf = rt.buf_new()
    var dirp: rt.Buf = rt.buf_new()
    var name: rt.Buf = rt.buf_new()
    var filters: rt.Buf = rt.buf_new()
    dialogproto.field_at(line, 1, &title)
    dialogproto.field_at(line, 2, &dirp)
    var mode: i32 = 0
    if verb == "save_file" {
        dialogproto.field_at(line, 3, &name)
        dialogproto.field_at(line, 4, &filters)
        mode = 2
    } else if verb == "pick_folder" {
        mode = 3
    } else {
        dialogproto.field_at(line, 3, &filters)
        if verb == "open_files" {
            mode = 1
        }
    }
    var paths: rt.Buf = rt.buf_new()
    let rc: i32 = filedlg.run(mode, view(&title), view(&dirp), view(&name), view(&filters), &paths)
    if reply_status(o, rc) {
        dialogproto.push_field(o, "ok", true)
        dialogproto.push_field(o, view(&paths), false)
        rt.buf_push(o, 10 as u8)
    }
    rt.buf_free(&paths)
    rt.buf_free(&title)
    rt.buf_free(&dirp)
    rt.buf_free(&name)
    rt.buf_free(&filters)
}

fn serve_color(line: str, o: *mut rt.Buf) {
    var title: rt.Buf = rt.buf_new()
    var init: rt.Buf = rt.buf_new()
    dialogproto.field_at(line, 1, &title)
    dialogproto.field_at(line, 2, &init)
    var rgb: u32 = 0 as u32
    if !parse_hex(view(&init), &rgb) {
        rgb = 0 as u32
    }
    var chosen: u32 = rgb
    let rc: i32 = colordlg.run(view(&title), rgb, &chosen)
    if reply_status(o, rc) {
        var hx: rt.Buf = rt.buf_new()
        rt.buf_push_hex_u64(&hx, chosen as u64, 6)
        dialogproto.push_field(o, "ok", true)
        dialogproto.push_field(o, view(&hx), false)
        rt.buf_push(o, 10 as u8)
        rt.buf_free(&hx)
    }
    rt.buf_free(&title)
    rt.buf_free(&init)
}

fn serve_font(line: str, o: *mut rt.Buf) {
    var title: rt.Buf = rt.buf_new()
    var family: rt.Buf = rt.buf_new()
    var size: rt.Buf = rt.buf_new()
    dialogproto.field_at(line, 1, &title)
    dialogproto.field_at(line, 2, &family)
    dialogproto.field_at(line, 3, &size)
    var sz: i32 = num(view(&size))
    if sz < 1 {
        sz = 12
    }
    var picked_family: rt.Buf = rt.buf_new()
    var pick: fontdlg.FontPick = fontdlg.FontPick { size: sz, bold: false, italic: false, underline: false, strike: false }
    let rc: i32 = fontdlg.run(view(&title), view(&family), sz, &picked_family, &pick)
    if reply_status(o, rc) {
        var d: rt.Buf = rt.buf_new()
        rt.buf_push_dec_u64(&d, pick.size as u64)
        dialogproto.push_field(o, "ok", true)
        dialogproto.push_field(o, view(&picked_family), false)
        dialogproto.push_field(o, view(&d), false)
        if pick.bold {
            dialogproto.push_field(o, "1", false)
        } else {
            dialogproto.push_field(o, "0", false)
        }
        if pick.italic {
            dialogproto.push_field(o, "1", false)
        } else {
            dialogproto.push_field(o, "0", false)
        }
        rt.buf_push(o, 10 as u8)
        rt.buf_free(&d)
    }
    rt.buf_free(&picked_family)
    rt.buf_free(&title)
    rt.buf_free(&family)
    rt.buf_free(&size)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 || arg(start, 1) != "--stdio" {
        say_err("usage: dialogd --stdio   (one request line on standard input, one answer line on standard output)\n")
        return 2
    }
    var req: rt.Buf = rt.buf_new()
    rt.read_stdin(&req)
    var n: usize = rt.buf_len(&req)
    while n > 0 && (rt.buf_at(&req, n - 1) == 10 as u8 || rt.buf_at(&req, n - 1) == 13 as u8) {
        n = n - 1
    }
    rt.buf_set_len(&req, n)
    let line: str = view(&req)
    var verb: rt.Buf = rt.buf_new()
    dialogproto.field_at(line, 0, &verb)
    let v: str = view(&verb)
    var o: rt.Buf = rt.buf_new()
    if v == "message" {
        serve_message(line, &o)
    } else if v == "open_file" || v == "open_files" || v == "save_file" || v == "pick_folder" {
        serve_file(v, line, &o)
    } else if v == "pick_color" {
        serve_color(line, &o)
    } else if v == "pick_font" {
        serve_font(line, &o)
    } else {
        reply_failed(&o)
    }
    out(&o)
    return 0
}
