// SPDX-License-Identifier: MPL-2.0
// tools/linebreak/probe.fi -- line break probe.
//   probe <cases.bin>
// cases.bin = repeated records: u32 little-endian octet count, then that many UTF-8 octets.
// Prints one line per record: the octet offsets (1..n) where a break is allowed or required.
import std.rt
import str.linebreak

fn main(start: u64) -> i32 {
    var inb: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &inb) {
        return 2
    }
    let t: u64 = linebreak.lb_map()
    if t == 0 {
        return 3
    }
    var out: rt.Buf = rt.buf_new()
    var pos: usize = 0
    while pos + 4 <= inb.len {
        let n: usize = rt.ld32(inb.ptr + pos as u64, 0) as usize
        pos = pos + 4
        if pos + n > inb.len {
            return 4
        }
        let p: u64 = inb.ptr + pos as u64
        let flags: u64 = rt.heap_alloc(n + 1)
        linebreak.lb_breaks(t, p, n, flags)
        var i: usize = 1
        var first: bool = true
        while i <= n {
            if rt.ld8(flags, i) != 0 as u8 {
                if !first {
                    rt.buf_push(&out, 32 as u8)
                }
                first = false
                rt.buf_push_dec_u64(&out, i as u64)
            }
            i = i + 1
        }
        rt.buf_push(&out, 10 as u8)
        rt.heap_free(flags, n + 1)
        pos = pos + n
    }
    rt.write_everything(1, out.ptr, out.len)
    linebreak.lb_free(t)
    return 0
}
