// SPDX-License-Identifier: GPL-2.0-only
// tools/aarch64/table.fi -- a program that forces every relocation type the
// round promised into ONE object file:
//
//   * the dense `match` becomes a jump table in `.rodata`; its entries are
//     absolute addresses of labels          -> R_AARCH64_ABS64
//   * the table's base is reached with adrp/add
//                        -> R_AARCH64_ADR_PREL_PG_HI21, ADD_ABS_LO12_NC
//   * `step` is called, not inlined (it is called with a variable)
//                        -> R_AARCH64_CALL26
//   * the result is written with `write(2)`  -> `svc #0` with x8 = 64
fn step(n: i64) -> i64 {
    var r: i64 = 0
    match n {
        0 => { r = 3 }
        1 => { r = 5 }
        2 => { r = 7 }
        3 => { r = 11 }
        4 => { r = 13 }
        5 => { r = 17 }
        6 => { r = 19 }
        7 => { r = 23 }
        8 => { r = 29 }
        9 => { r = 31 }
        _ => { r = 0 }
    }
    return r
}

fn main() -> i32 {
    var sum: i64 = 0
    var i: i64 = 0
    while i < 10 {
        sum = sum + step(i)
        i = i + 1
    }
    var buf: [u8; 4] = [0, 0, 10, 0]
    buf[0] = (48 + sum / 100) as u8
    buf[1] = (48 + (sum / 10) % 10) as u8
    syscall(1, 1, &buf[0], 3)
    return 0
}
