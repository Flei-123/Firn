// tools/stack_e/lib_simd.fi -- G6 intrinsics as C exports, cross-checked against numpy by host_simd.py.
import std.simd

#[export_c]
fn se_sqrt4(dst: u64, src: u64) {
    simd.st(dst, simd.sqrt_f32(simd.ld(src)))
}

#[export_c]
fn se_packs32(dst: u64, a: u64, b: u64) {
    simd.st(dst, simd.pack_i32_i16(simd.ld(a), simd.ld(b)))
}

#[export_c]
fn se_packus16(dst: u64, a: u64, b: u64) {
    simd.st(dst, simd.pack_i16_u8(simd.ld(a), simd.ld(b)))
}

#[export_c]
fn se_mulhi16(dst: u64, a: u64, b: u64) {
    simd.st(dst, simd.mulhi_16(simd.ld(a), simd.ld(b)))
}

#[export_c]
fn se_mask8(src: u64) -> u32 {
    return simd.mask8(simd.ld(src))
}

#[export_c]
fn se_maskf(src: u64) -> u32 {
    return simd.mask_f32(simd.ld(src))
}

#[export_c]
fn se_dot4(a: u64, b: u64) -> f32 {
    return simd.dot4(simd.ld(a), simd.ld(b))
}
