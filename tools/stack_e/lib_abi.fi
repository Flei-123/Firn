// SPDX-License-Identifier: MPL-2.0
// tools/stack_e/lib_abi.fi -- C ABI probe for exports with floats and with more arguments than fit in registers
// (Windows DLL: 4 register slots + stack; System V .so: 6 integer + 8 SSE registers + stack; aarch64: 8 + 8).
// The C host (host_abi.c) computes the same formulas and compares.

#[export_c]
#[no_gc]
fn abi_fadd(a: f64, b: f64) -> f64 {
    return a + b
}

#[export_c]
#[no_gc]
fn abi_fneg32(x: f32, y: f32) -> f32 {
    return y - x
}

// integer and float slots interleaved: on Win64 slot i is rcx/rdx/r8/r9 or xmm0-3 by position
#[export_c]
#[no_gc]
fn abi_mix4(a: i32, b: f64, c: i64, d: f32) -> f64 {
    return a as f64 + b * 2.0 + c as f64 * 3.0 + d as f64 * 4.0
}

// eight integer arguments: two on the stack for Win64 (4 registers) ... four, System V: two
#[export_c]
#[no_gc]
fn abi_int8(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64) -> i64 {
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + h * 8
}

// ten doubles: ten 8-register overflow on System V (two on the stack), six on the stack for Win64
#[export_c]
#[no_gc]
fn abi_dbl10(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, h: f64, i: f64, j: f64) -> f64 {
    return a + b * 2.0 + c * 3.0 + d * 4.0 + e * 5.0 + f * 6.0 + g * 7.0 + h * 8.0 + i * 9.0 + j * 10.0
}

// 14 mixed arguments of every class: registers of both files, then the stack in order of writing
#[export_c]
#[no_gc]
fn abi_mix14(a: i32, b: f64, c: i64, d: f32, e: u8, f: f64, g: i16, h: f32, i: u64, j: f64, k: i32, l: f64, m: i64, n: f32) -> f64 {
    return a as f64 + b * 2.0 + c as f64 * 3.0 + d as f64 * 4.0 + e as f64 * 5.0 + f * 6.0 + g as f64 * 7.0
    +h as f64 * 8.0 + i as f64 * 9.0 + j * 10.0 + k as f64 * 11.0 + l * 12.0 + m as f64 * 13.0 + n as f64 * 14.0
}

// nine integers (three on the stack for System V, five for Win64) with a float result of an integer sum
#[export_c]
#[no_gc]
fn abi_int9_f(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64) -> f64 {
    return (a + b + c + d + e + f + g + h + i) as f64 * 0.5
}

// an integer result after float arguments
#[export_c]
#[no_gc]
fn abi_fcount(a: f64, b: f64, c: f64, d: f64, e: f64) -> i64 {
    var n: i64 = 0
    if a > 0.0 { n = n + 1 }
    if b > 0.0 { n = n + 2 }
    if c > 0.0 { n = n + 4 }
    if d > 0.0 { n = n + 8 }
    if e > 0.0 { n = n + 16 }
    return n
}

// v128 (r506): Win64 passes a vector by a hidden pointer (an integer slot), System V and AAPCS64 in xmm / q registers.
#[export_c]
#[no_gc]
fn abi_v128_add(x: v128, y: v128) -> v128 {
    return __v128_addf32(x, y)
}

// scalar slots around two vectors: the thunk must keep every slot's position
#[export_c]
#[no_gc]
fn abi_v128_mix(a: i64, x: v128, b: f64, y: v128, c: i32) -> f64 {
    var buf: [f32; 4] = [0.0; 4]
    __v128_store((&buf[0]) as *mut u8, __v128_addf32(x, y))
    return a as f64 + b * 2.0 + c as f64 * 3.0 + buf[0] as f64 * 4.0 + buf[3] as f64 * 5.0
}
