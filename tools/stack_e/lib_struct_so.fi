// SPDX-License-Identifier: MPL-2.0
// tools/stack_e/lib_struct_so.fi -- the by-value struct shapes that are the same in Firn and in the C ABI of a Linux .so
// (x86-64 System V and AAPCS64): integer structs that fit the registers, results of at most 8 octets in rax / x0.
// Every other shape is refused by `firnc --shared` for a .so (see docs/SHARED-OBJECTS.md); host_struct_so.c checks these.
struct S3 { a: u8, b: u8, c: u8 }
struct S8 { a: i32, b: i32 }
struct S12 { a: i32, b: i32, c: i32 }
struct S16 { a: i64, b: i64 }

#[export_c]
#[no_gc]
fn st_s8(p: S8, k: i64) -> i64 { return p.a as i64 + p.b as i64 * 2 + k * 100 }
#[export_c]
#[no_gc]
fn st_s12(p: S12, k: i64) -> i64 { return p.a as i64 + p.b as i64 * 2 + p.c as i64 * 3 + k * 100 }
#[export_c]
#[no_gc]
fn st_s16_mix(a: i64, p: S16, b: f64, q: S8) -> f64 { return a as f64 + (p.a + p.b * 2) as f64 * 2.0 + b * 3.0 + (q.a + q.b) as f64 * 4.0 }
#[export_c]
#[no_gc]
fn st_ret_s3(k: i64) -> S3 { return S3 { a: k as u8, b: (k + 1) as u8, c: (k + 2) as u8 } }
#[export_c]
#[no_gc]
fn st_ret_s8(a: i32, b: i32) -> S8 { return S8 { a: a, b: b } }
