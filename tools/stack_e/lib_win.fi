// SPDX-License-Identifier: MPL-2.0
// tools/stack_e/lib_win.fi -- probe library for the Windows DLL / aarch64 .so path (G5): integer and
// pointer exports only (the Windows entry thunk moves up to 6 integer/pointer arguments).
import std.rt

struct Pair {
    a: u32,
    b: u32,
}

static mut G_COUNT: u64 = 0

#[export_c]
#[no_gc]
fn wd_abi() -> u64 {
    return 5
}

#[export_c]
#[no_gc]
fn wd_add_i32(a: i32, b: i32) -> i32 {
    return a + b
}

// 6 integer arguments (the maximum), 32-bit and 64-bit mixed
#[export_c]
#[no_gc]
fn wd_mix6(a: i32, b: i64, c: u8, d: u32, e: u64, f: i16) -> i64 {
    return a as i64 + b * 2 + c as i64 * 3 + d as i64 * 4 + e as i64 * 5 + f as i64 * 6
}

#[export_c]
#[no_gc]
fn wd_pair_swap(p: *mut Pair) {
    let t: u32 = (*p).a
    (*p).a = (*p).b
    (*p).b = t
}

#[export_c]
#[no_gc]
fn wd_sum_u8(p: *u8, n: usize) -> u64 {
    var s: u64 = 0
    var i: usize = 0
    while i < n {
        s = s + (*((p as usize + i) as *u8)) as u64
        i = i + 1
    }
    return s
}

#[export_c]
#[no_gc]
fn wd_count_inc() -> u64 {
    G_COUNT = G_COUNT + 1
    return G_COUNT
}

#[export_c]
#[no_gc]
fn wd_bool_not(x: bool) -> bool {
    return !x
}

// the GC heap: cell chains built at run time, collections forced while a chain is alive
gc class Cell {
    next: Gc[Cell],
    value: u64,
}

fn mk(i: u64, next: Gc[Cell]) -> AllocError!Gc[Cell] {
    let c: Gc[Cell] = try gc Cell { next: next, value: i }
    return c
}

// `rounds` chains of 40 cells; every 8th round collects while the chain is alive.
// Result: sum of all values if every chain stayed intact, else 0.
// A library that uses `gc` types exports its own init (no `_start` runs in a shared object).
#[export_c]
fn wd_init() -> u64 {
    if gc_init() { return 1 }
    return 0
}

#[export_c]
fn wd_gc_chains(rounds: u64) -> u64 {
    var total: u64 = 0
    var r: u64 = 0
    while r < rounds {
        var head: Gc[Cell] = gc_null[Cell]()
        var i: u64 = 0
        while i < 40 {
            head = mk(i + 1, head) catch gc_null[Cell]()
            if head == gc_null[Cell]() { return 0 }
            i = i + 1
        }
        if r % 8 == 7 { gc_collect() }
        var c: Gc[Cell] = head
        while c != gc_null[Cell]() {
            total = total + c.value
            c = c.next
        }
        r = r + 1
    }
    return total
}
