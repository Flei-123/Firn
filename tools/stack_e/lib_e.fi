// SPDX-License-Identifier: MPL-2.0
// tools/stack_e/lib_e.fi -- probe library for "graphics stack, way E": a Firn shared object with a C ABI.
// Built by run.sh: firnc --pic -c + ld -shared. Called from C (dlopen) and Python (ctypes).
import mc.mc_blend

struct Vtx {
    x: f32,
    y: f32,
    z: f32,
    w: f32,
}

struct V2 {
    x: f32,
    y: f32,
}

// A Firn fn value is a pointer to a record whose first word is the code address; a foreign
// function pointer is wrapped into such a record (see se_call_cb).
struct Holder1 { f: fn(i64) -> i64 }

static mut G_COUNT: u64 = 0

#[export_c]
#[no_gc]
fn se_abi() -> u64 {
    return 1
}

#[export_c]
#[no_gc]
fn se_add_i32(a: i32, b: i32) -> i32 {
    return a + b
}

#[export_c]
#[no_gc]
fn se_axpy_f32(a: f32, x: f32, y: f32) -> f32 {
    return a * x + y
}

#[export_c]
#[no_gc]
fn se_len_f64(x: f64, y: f64) -> f64 {
    return x * x + y * y
}

// struct by pointer: in/out
#[export_c]
#[no_gc]
fn se_vtx_scale(v: *mut Vtx, s: f32) {
    (*v).x = (*v).x * s
    (*v).y = (*v).y * s
    (*v).z = (*v).z * s
    (*v).w = (*v).w * s
}

#[export_c]
#[no_gc]
fn se_vtx_dot(a: *mut Vtx, b: *mut Vtx) -> f32 {
    return (*a).x * (*b).x + (*a).y * (*b).y + (*a).z * (*b).z + (*a).w * (*b).w
}

// small struct by value (SysV: two f32 in one xmm0)
#[export_c]
#[no_gc]
fn se_v2_add(a: V2, b: V2) -> V2 {
    return V2 { x: a.x + b.x, y: a.y + b.y }
}

// callback: C passes a function pointer, Firn calls it n times and sums the results
#[export_c]
#[no_gc]
fn se_call_cb(cb: u64, n: i64) -> i64 {
    var code: [u64; 1] = [0; 1]
    code[0] = cb
    var roh: [u64; 1] = [0; 1]
    roh[0] = (&code[0]) as u64
    let h: *mut Holder1 = (&roh[0]) as *mut Holder1
    let f: fn(i64) -> i64 = (*h).f
    var i: i64 = 0
    var sum: i64 = 0
    while i < n {
        sum = sum + f(i)
        i = i + 1
    }
    return sum
}

// module state in a global (PIC: GOT/RIP-relative data)
#[export_c]
#[no_gc]
fn se_count_inc() -> u64 {
    G_COUNT = G_COUNT + 1
    return G_COUNT
}

// SIMD in a PIC object: four f32 lanes: dst[i] = a[i] * b[i] + c[i]
#[export_c]
#[no_gc]
fn se_fma4_f32(dst: u64, a: u64, b: u64, c: u64, n: usize) {
    var i: usize = 0
    while i + 4 <= n {
        let o: u64 = (i * 4) as u64
        let va: v128 = __v128_load((a + o) as *u8)
        let vb: v128 = __v128_load((b + o) as *u8)
        let vc: v128 = __v128_load((c + o) as *u8)
        __v128_store((dst + o) as *mut u8, __v128_addf32(__v128_mulf32(va, vb), vc))
        i = i + 4
    }
}

// the existing byte-blend library inside a .so
#[export_c]
fn se_mix_span(dst: u64, n: usize, rgb: u32, f: u32) {
    mc_blend.mix_span(dst, n, rgb, f)
}

#[export_c]
fn se_blend_span(dst: u64, n: usize, rgb: u32, a: u32) {
    mc_blend.blend_span(dst, n, rgb, a)
}

// a library object still needs an entry point for the compiler; ld's version script keeps it local
fn main() -> i32 {
    return 0
}
