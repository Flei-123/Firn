// SPDX-License-Identifier: MPL-2.0
// tools/stack_e/simd_bench.fi -- scalar vs v128 for the new min/max/saturating/multiply intrinsics (way E).
// 1 MiB of data per pass, many passes; prints microseconds per pass. A busy host makes the numbers noisy.
import std.rt
import std.io

fn now_ns() -> u64 {
    var ts: [u64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64)
    return ts[0] * 1000000000 as u64 + ts[1]
}

fn main() -> i32 {
    let n: usize = 262144 // f32 / u32 lanes (1 MiB)
    let a: u64 = rt.heap_alloc(n * 4)
    let o: u64 = rt.heap_alloc(n * 4)
    var i: usize = 0
    var seed: u64 = 99 as u64
    while i < n {
        seed = (seed * 1664525 as u64 + 1013904223 as u64) & 0xFFFFFFFF as u64
        // floats in about -32 .. 32 (so the clamp hits about 60 % of them; no NaN); the bytes of the same words feed test 2
        let fv: f32 = ((((seed >> 8 as u64) & 0xFFFF as u64) as i32) - 32768) as f32 / (1000.0 as f32)
        *((a + (i * 4) as u64) as *mut f32) = fv
        i = i + 1
    }
    let reps: i32 = 200
    var sink: u64 = 0

    // 1. clamp 262144 f32 to [-10, 10]: min(max(x, lo), hi)
    let lo: f32 = (0.0 - 10.0) as f32
    let hi: f32 = 10.0 as f32
    var r: i32 = 0
    let t0: u64 = now_ns()
    while r < reps {
        i = 0
        while i < n {
            let x: f32 = *((a + (i * 4) as u64) as *mut f32)
            var y: f32 = x
            if y < lo { y = lo }
            if y > hi { y = hi }
            *((o + (i * 4) as u64) as *mut f32) = y
            i = i + 1
        }
        r = r + 1
    }
    let t1: u64 = now_ns()
    let vlo: v128 = __v128_from_u64(0xc1200000c1200000 as u64, 0xc1200000c1200000 as u64)
    let vhi: v128 = __v128_from_u64(0x4120000041200000 as u64, 0x4120000041200000 as u64)
    r = 0
    while r < reps {
        i = 0
        while i + 4 <= n {
            let off: u64 = (i * 4) as u64
            let v: v128 = __v128_load((a + off) as *u8)
            __v128_store((o + off) as *mut u8, __v128_minf32(__v128_maxf32(v, vlo), vhi))
            i = i + 4
        }
        r = r + 1
    }
    let t2: u64 = now_ns()

    // 2. saturating byte add of two 1 MiB buffers (o += a)
    r = 0
    while r < reps {
        i = 0
        while i < n * 4 {
            var s: u32 = (*((a + i as u64) as *mut u8)) as u32 + (*((o + i as u64) as *mut u8)) as u32
            if s > 255 as u32 { s = 255 as u32 }
            *((o + i as u64) as *mut u8) = s as u8
            i = i + 1
        }
        r = r + 1
    }
    let t3: u64 = now_ns()
    r = 0
    while r < reps {
        i = 0
        while i + 16 <= n * 4 {
            let off: u64 = i as u64
            let x: v128 = __v128_load((a + off) as *u8)
            let y: v128 = __v128_load((o + off) as *u8)
            __v128_store((o + off) as *mut u8, __v128_addsat_u8(x, y))
            i = i + 16
        }
        r = r + 1
    }
    let t4: u64 = now_ns()
    sink = sink + (*(o as *mut u64))
    let per: u64 = (reps as u64) * 1000 as u64
    io.fmt_print(f"metric clamp_f32_1MiB scalar_us={(t1 - t0) / per} simd_us={(t2 - t1) / per}\n")
    io.fmt_print(f"metric addsat_u8_1MiB scalar_us={(t3 - t2) / per} simd_us={(t4 - t3) / per}\n")
    if sink == 1 as u64 { return 1 }
    return 0
}
