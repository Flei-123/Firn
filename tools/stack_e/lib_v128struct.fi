// SPDX-License-Identifier: MPL-2.0
// tools/stack_e/lib_v128struct.fi -- r577: `v128` parameters that find no vector register NEXT TO a struct in a Linux .so
// export (x86-64 System V, aarch64 AAPCS64). The struct forces an entry thunk (compiler/src/so_thunk.rs); the thunk copies
// the vector from the C stack (16 octets at a 16 octet boundary) to Firn's outgoing stack area, or from a register to the
// stack when Firn ran out of vector registers earlier than C. host_v128struct.c calls the exports through gcc's ABI.
import std.simd

struct D16 { x: f64, y: f64 }
struct D24 { x: f64, y: f64, z: f64 }

// nine vectors (the ninth on the stack), then a 24 octet struct (stack, 24 octets), then an integer in a register
#[export_c]
fn sv_nine_d24(out: u64, v0: v128, v1: v128, v2: v128, v3: v128, v4: v128, v5: v128, v6: v128, v7: v128, v8: v128,
    p: D24, k: i64) -> f64 {
    simd.st(out, v0)
    simd.st(out + 16, v1)
    simd.st(out + 32, v2)
    simd.st(out + 48, v3)
    simd.st(out + 64, v4)
    simd.st(out + 80, v5)
    simd.st(out + 96, v6)
    simd.st(out + 112, v7)
    simd.st(out + 128, v8)
    return p.x + p.y * 2.0 + p.z * 3.0 + k as f64 * 100.0
}

// seven integers (the seventh on the stack), nine vectors, the struct, a tenth vector (aligned after the odd struct), an integer
#[export_c]
fn sv_ints_align(out: u64, i1: i64, i2: i64, i3: i64, i4: i64, i5: i64, i6: i64,
    v0: v128, v1: v128, v2: v128, v3: v128, v4: v128, v5: v128, v6: v128, v7: v128, v8: v128,
    p: D24, v9: v128, k: i64) -> f64 {
    simd.st(out, v0)
    simd.st(out + 16, v1)
    simd.st(out + 32, v2)
    simd.st(out + 48, v3)
    simd.st(out + 64, v4)
    simd.st(out + 80, v5)
    simd.st(out + 96, v6)
    simd.st(out + 112, v7)
    simd.st(out + 128, v8)
    simd.st(out + 144, v9)
    return p.x + p.y * 2.0 + p.z * 3.0 + (i1 + i2 * 2 + i3 * 3 + i4 * 4 + i5 * 5 + i6 * 6 + k) as f64
}

// seven doubles, then a two-double struct: C copies it to the stack whole and leaves xmm7 to the vector (x86-64; on aarch64 the
// register file is closed and the vector goes to the stack), Firn splits the struct over xmm7 + stack and sends the vector to the stack
#[export_c]
fn sv_regs_run_out(out: u64, a0: f64, a1: f64, a2: f64, a3: f64, a4: f64, a5: f64, a6: f64, p: D16, v: v128, k: i64) -> f64 {
    simd.st(out, v)
    return a0 + a1 * 2.0 + a2 * 3.0 + a3 * 4.0 + a4 * 5.0 + a5 * 6.0 + a6 * 7.0 + p.x * 8.0 + p.y * 9.0 + k as f64 * 100.0
}
