// tools/stack_e/lib_rt.fi -- probe: what of the Firn runtime works INSIDE a shared object?
//   se_heap_probe  heap_alloc + write + read (mmap through the raw syscall wrapper, global cache state)
//   se_jobs_probe  jobs.parallel_for (threads, futex, the __thread_work hook)
//   se_gc_probe    GC cells on several threads at once + forced collections (stop the world inside a .so)
import std.rt
import jobs.jobs

const GC_KIND: u64 = 77
const CHAIN: u64 = 40

gc class Cell {
    next: Gc[Cell],
    value: u64,
}

fn mk(i: u64, next: Gc[Cell]) -> AllocError!Gc[Cell] {
    let c: Gc[Cell] = try gc Cell { next: next, value: i }
    return c
}

// `rounds` chains of CHAIN cells; every 8th round forces a collection while the
// chain is alive. Result: rounds if every chain stayed intact, else 0.
fn gc_rounds(seed: u64, rounds: u64) -> u64 {
    var r: u64 = 0
    while r < rounds {
        var head: Gc[Cell] = gc_null[Cell]()
        var i: u64 = 0
        while i < CHAIN {
            head = mk(seed + i, head) catch gc_null[Cell]()
            if head == gc_null[Cell]() { return 0 }
            i = i + 1
        }
        if r % 8 == 7 { gc_collect() }
        var sum: u64 = 0
        var c: Gc[Cell] = head
        var n: u64 = 0
        while c != gc_null[Cell]() {
            sum = sum + c.value
            c = c.next
            n = n + 1
        }
        if n != CHAIN || sum != CHAIN * seed + CHAIN * (CHAIN - 1) / 2 { return 0 }
        r = r + 1
    }
    return rounds
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == jobs.WORKER_KIND { return jobs.worker_main(arg) }
    if kind == GC_KIND { return gc_rounds(arg * 1000, 400) }
    return 0
}

// `workers` GC threads plus the calling (host) thread, 400 rounds each.
// Result: 400 * (workers + 1) if everything held, otherwise less.
#[export_c]
fn se_gc_probe(workers: u64) -> u64 {
    var hs: [u64; 16] = [0; 16]
    var w: u64 = 0
    while w < workers && w < 16 {
        hs[w as usize] = thread_start(GC_KIND, w + 1)
        w = w + 1
    }
    var total: u64 = gc_rounds(0, 400)
    var k: u64 = 0
    while k < w {
        if hs[k as usize] != 0 { total = total + thread_wait(hs[k as usize]) }
        k = k + 1
    }
    return total
}

#[export_c]
fn se_heap_probe(n: usize) -> u64 {
    let p: u64 = rt.heap_alloc(n * 8)
    if p == 0 { return 0 }
    var i: usize = 0
    while i < n {
        *((p + (i * 8) as u64) as *mut u64) = i as u64
        i = i + 1
    }
    var s: u64 = 0
    i = 0
    while i < n {
        s = s + *((p + (i * 8) as u64) as *mut u64)
        i = i + 1
    }
    return s
}

fn body(ctx: u64, lo: u64, hi: u64) {
    var i: u64 = lo
    while i < hi {
        *((ctx + i * 4) as *mut u32) = (i * 3) as u32
        i = i + 1
    }
}

#[export_c]
fn se_jobs_probe(dst: u64, n: u64, workers: u64) -> u64 {
    var j: jobs.Jobs = jobs.create(workers)
    jobs.parallel_for(&j, 0, n, 64, body, dst)
    jobs.destroy(&j)
    return n
}

fn main() -> i32 {
    return 0
}
