// SPDX-License-Identifier: MPL-2.0
// tools/stack_e/lib_struct2.fi -- structs by value in LINUX .so exports (r558): the shapes where the C ABI (System V x86-64,
// AAPCS64) differs from Firn's placement and the entry thunk (compiler/src/so_thunk.rs) has to convert: float aggregates
// (HFA: one register per member on aarch64), mixed int/float words, structs that do not fit the registers whole, structs
// over 16 octets, results of 9..16 octets (rax:rdx / xmm0:xmm1 / x0:x1) and over 16 octets (hidden pointer, x8 on aarch64).
// host_struct2.c computes the same formulas with the C compiler's own ABI.

struct F12 { x: f32, y: f32, z: f32 }
struct F16 { x: f32, y: f32, z: f32, w: f32 }
struct D16 { x: f64, y: f64 }
struct D24 { x: f64, y: f64, z: f64 }
struct D32 { x: f64, y: f64, z: f64, w: f64 }
struct MD { a: f64, b: f32 }
struct IF { a: i32, b: f32, c: f64 }
struct S16 { a: i64, b: i64 }
struct S12 { a: i32, b: i32, c: i32 }
struct B24 { a: i64, b: i64, c: i64 }
struct F8 { x: f32, y: f32 }
struct A2 { v: [f32; 2] }

#[export_c]
#[no_gc]
fn t_f12(p: F12, k: f64) -> f64 { return p.x as f64 + p.y as f64 * 2.0 + p.z as f64 * 3.0 + k * 100.0 }
#[export_c]
#[no_gc]
fn t_f16(p: F16, k: i64) -> f64 { return p.x as f64 + p.y as f64 * 2.0 + p.z as f64 * 3.0 + p.w as f64 * 4.0 + k as f64 * 100.0 }
#[export_c]
#[no_gc]
fn t_d24(p: D24, k: i64) -> f64 { return p.x + p.y * 2.0 + p.z * 3.0 + k as f64 * 100.0 }
#[export_c]
#[no_gc]
fn t_d32(p: D32, k: f64) -> f64 { return p.x + p.y * 2.0 + p.z * 3.0 + p.w * 4.0 + k * 100.0 }
#[export_c]
#[no_gc]
fn t_md(p: MD, k: i64) -> f64 { return p.a + p.b as f64 * 2.0 + k as f64 * 100.0 }
#[export_c]
#[no_gc]
fn t_ifm(p: IF, k: i64) -> f64 { return p.a as f64 + p.b as f64 * 2.0 + p.c * 3.0 + k as f64 * 100.0 }
#[export_c]
#[no_gc]
fn t_a2(p: A2, k: i64) -> f64 { return p.v[0] as f64 + p.v[1] as f64 * 2.0 + k as f64 * 100.0 }

// the struct does not find its registers whole: C copies all of it to the stack and leaves the rest of the file for later arguments
#[export_c]
#[no_gc]
fn t_fit5(a: i64, b: i64, c: i64, d: i64, e: i64, p: S16, f: i64) -> i64 { return a + b * 2 + c * 3 + d * 4 + e * 5 + (p.a + p.b * 2) * 6 + f * 7 }
#[export_c]
#[no_gc]
fn t_fit7(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, p: S16, h: i64) -> i64 {
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6 + g * 7 + (p.a + p.b * 2) * 8 + h * 9
}
#[export_c]
#[no_gc]
fn t_fitx(a: f64, b: f64, c: f64, d: f64, e: f64, f: f64, g: f64, p: D16, h: f64) -> f64 {
    return a + b * 2.0 + c * 3.0 + d * 4.0 + e * 5.0 + f * 6.0 + g * 7.0 + (p.x + p.y * 2.0) * 8.0 + h * 9.0
}
#[export_c]
#[no_gc]
fn t_fit_mix(a: i64, b: i64, c: i64, d: i64, e: i64, p: S12, q: S12, f: i64) -> i64 {
    return a + b * 2 + c * 3 + d * 4 + e * 5 + (p.a + p.b * 2 + p.c * 3) as i64 * 6 + (q.a + q.b * 2 + q.c * 3) as i64 * 7 + f * 8
}
// HFAs running out of vector registers
#[export_c]
#[no_gc]
fn t_hfa_over(a: D24, b: D24, c: f64, d: D16, e: f64) -> f64 {
    return a.x + a.y * 2.0 + a.z * 3.0 + (b.x + b.y * 2.0 + b.z * 3.0) * 4.0 + c * 5.0 + (d.x + d.y * 2.0) * 6.0 + e * 7.0
}
#[export_c]
#[no_gc]
fn t_hfa_f(a: F16, b: F16, c: F12, d: F8, e: f32) -> f64 {
    return (a.x + a.y * 2.0 + a.z * 3.0 + a.w * 4.0) as f64 + (b.x + b.y * 2.0 + b.z * 3.0 + b.w * 4.0) as f64 * 5.0
        + (c.x + c.y * 2.0 + c.z * 3.0) as f64 * 6.0 + (d.x + d.y * 2.0) as f64 * 7.0 + e as f64 * 8.0
}
#[export_c]
#[no_gc]
fn t_many(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, p: S12, q: F8, r: B24, s: D16, t: i64, u: F12, v: MD, w: IF) -> f64 {
    return a as f64 + b as f64 * 2.0 + c as f64 * 3.0 + d as f64 * 4.0 + e as f64 * 5.0 + f as f64 * 6.0
        + (p.a + p.b * 2 + p.c * 3) as f64 * 7.0 + (q.x + q.y * 2.0) as f64 * 8.0 + (r.a + r.b * 2 + r.c * 3) as f64 * 9.0
        + (s.x + s.y * 2.0) * 10.0 + t as f64 * 11.0 + (u.x + u.y * 2.0 + u.z * 3.0) as f64 * 12.0
        + (v.a + v.b as f64 * 2.0) * 13.0 + (w.a as f64 + w.b as f64 * 2.0 + w.c * 3.0) * 14.0
}

// results
#[export_c]
#[no_gc]
fn t_ret_f12(a: f32, b: f32, c: f32) -> F12 { return F12 { x: a, y: b, z: c } }
#[export_c]
#[no_gc]
fn t_ret_f16(a: f32, b: f32, c: f32, d: f32) -> F16 { return F16 { x: a, y: b, z: c, w: d } }
#[export_c]
#[no_gc]
fn t_ret_d24(a: f64, b: f64, c: f64) -> D24 { return D24 { x: a, y: b, z: c } }
#[export_c]
#[no_gc]
fn t_ret_d32(a: f64, b: f64, c: f64, d: f64) -> D32 { return D32 { x: a, y: b, z: c, w: d } }
#[export_c]
#[no_gc]
fn t_ret_md(a: f64, b: f32) -> MD { return MD { a: a, b: b } }
#[export_c]
#[no_gc]
fn t_ret_if(a: i32, b: f32, c: f64) -> IF { return IF { a: a, b: b, c: c } }
#[export_c]
#[no_gc]
fn t_ret_f8(a: f32, b: f32) -> F8 { return F8 { x: a, y: b } }
#[export_c]
#[no_gc]
fn t_ret_a2(a: f32, b: f32) -> A2 { return A2 { v: [a, b] } }
// results next to struct arguments that take the registers of the hidden pointer / the vector file
#[export_c]
#[no_gc]
fn t_scale_f12(p: F12, k: f32) -> F12 { return F12 { x: p.x * k, y: p.y * k, z: p.z * k } }
#[export_c]
#[no_gc]
fn t_scale_d24(p: D24, k: f64) -> D24 { return D24 { x: p.x * k, y: p.y * k, z: p.z * k } }
#[export_c]
#[no_gc]
fn t_add_b24(a: B24, b: S16, k: i64) -> B24 { return B24 { a: a.a + b.a * k, b: a.b + b.b * k, c: a.c + k } }
#[export_c]
#[no_gc]
fn t_swap_md(p: MD, q: IF, k: i64) -> IF { return IF { a: k as i32, b: p.b, c: p.a + q.c } }
#[export_c]
#[no_gc]
fn t_swap_if(p: IF, k: f64) -> MD { return MD { a: p.c * k, b: p.b } }
#[export_c]
#[no_gc]
fn t_stackret(a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, p: S12) -> S16 { return S16 { a: a + b + c + d + e + f + g, b: (p.a + p.b + p.c) as i64 } }
