// SPDX-License-Identifier: MPL-2.0
// tools/stack_e/lib_struct.fi -- structs by value in exports (r506): sizes 1..8 in a slot, 12/16 as two words, 24 as a
// pointer to a copy, float words, struct results in rax / xmm0 / through a hidden pointer. host_struct.c computes the same
// formulas with the C compiler's own ABI (mingw Win64, gcc System V, gcc AAPCS64) and compares.

struct S1 { a: u8 }
struct S2 { a: u8, b: u8 }
struct S3 { a: u8, b: u8, c: u8 }
struct S4 { a: i16, b: i16 }
struct S5 { a: [u8; 5] }
struct S6 { a: i16, b: i16, c: i16 }
struct S7 { a: [u8; 7] }
struct S8 { a: i32, b: i32 }
struct F8 { x: f32, y: f32 }
struct D8 { x: f64 }
struct F4 { x: f32 }
struct S12 { a: i32, b: i32, c: i32 }
struct S16 { a: i64, b: i64 }
struct D16 { x: f64, y: f64 }
struct M16 { a: i64, y: f64 }
struct B24 { a: i64, b: i64, c: i64 }

#[export_c]
#[no_gc]
fn st_s1(p: S1, k: i64) -> i64 { return p.a as i64 + k * 100 }
#[export_c]
#[no_gc]
fn st_s2(p: S2, k: i64) -> i64 { return p.a as i64 + p.b as i64 * 2 + k * 100 }
#[export_c]
#[no_gc]
fn st_s3(p: S3, k: i64) -> i64 { return p.a as i64 + p.b as i64 * 2 + p.c as i64 * 3 + k * 100 }
#[export_c]
#[no_gc]
fn st_s4(p: S4, k: i64) -> i64 { return p.a as i64 + p.b as i64 * 2 + k * 100 }
#[export_c]
#[no_gc]
fn st_s5(p: S5, k: i64) -> i64 { return p.a[0] as i64 + p.a[1] as i64 * 2 + p.a[4] as i64 * 3 + k * 100 }
#[export_c]
#[no_gc]
fn st_s6(p: S6, k: i64) -> i64 { return p.a as i64 + p.b as i64 * 2 + p.c as i64 * 3 + k * 100 }
#[export_c]
#[no_gc]
fn st_s7(p: S7, k: i64) -> i64 { return p.a[0] as i64 + p.a[3] as i64 * 2 + p.a[6] as i64 * 3 + k * 100 }
#[export_c]
#[no_gc]
fn st_s8(p: S8, k: i64) -> i64 { return p.a as i64 + p.b as i64 * 2 + k * 100 }
#[export_c]
#[no_gc]
fn st_f8(p: F8, k: f64) -> f64 { return p.x as f64 + p.y as f64 * 2.0 + k * 100.0 }
#[export_c]
#[no_gc]
fn st_d8(p: D8, k: f64) -> f64 { return p.x + k * 100.0 }
#[export_c]
#[no_gc]
fn st_f4(p: F4, k: f64) -> f64 { return p.x as f64 + k * 100.0 }
#[export_c]
#[no_gc]
fn st_s12(p: S12, k: i64) -> i64 { return p.a as i64 + p.b as i64 * 2 + p.c as i64 * 3 + k * 100 }
#[export_c]
#[no_gc]
fn st_s16(p: S16, k: i64) -> i64 { return p.a + p.b * 2 + k * 100 }
#[export_c]
#[no_gc]
fn st_d16(p: D16, k: f64) -> f64 { return p.x + p.y * 2.0 + k * 100.0 }
#[export_c]
#[no_gc]
fn st_m16(p: M16, k: i64) -> f64 { return p.a as f64 + p.y * 2.0 + k as f64 * 100.0 }
#[export_c]
#[no_gc]
fn st_b24(p: B24, k: i64) -> i64 { return p.a + p.b * 2 + p.c * 3 + k * 100 }

// several aggregates and scalars mixed: slot positions, registers of both files, the stack
#[export_c]
#[no_gc]
fn st_mix(a: i64, p: S8, b: f64, q: F8, c: S16, d: f64, e: B24, f: S3, g: D16, h: i64, i: S12, j: f64) -> f64 {
    return a as f64 + (p.a + p.b * 2) as f64 + b * 3.0 + q.x as f64 * 4.0 + q.y as f64 * 5.0
    +(c.a + c.b * 2) as f64 * 6.0 + d * 7.0 + (e.a + e.b * 2 + e.c * 3) as f64 * 8.0
    +(f.a as i64 + f.b as i64 * 2 + f.c as i64 * 3) as f64 * 9.0 + (g.x + g.y * 2.0) * 10.0 + h as f64 * 11.0
    +(i.a as i64 + i.b as i64 * 2 + i.c as i64 * 3) as f64 * 12.0 + j * 13.0
}

#[export_c]
#[no_gc]
fn st_ret_s1(k: i64) -> S1 { return S1 { a: k as u8 } }
#[export_c]
#[no_gc]
fn st_ret_s3(k: i64) -> S3 { return S3 { a: k as u8, b: (k + 1) as u8, c: (k + 2) as u8 } }
#[export_c]
#[no_gc]
fn st_ret_s6(k: i64) -> S6 { return S6 { a: k as i16, b: (k + 1) as i16, c: (k + 2) as i16 } }
#[export_c]
#[no_gc]
fn st_ret_s7(k: i64) -> S7 { return S7 { a: [k as u8, (k + 1) as u8, (k + 2) as u8, (k + 3) as u8, (k + 4) as u8, (k + 5) as u8, (k + 6) as u8] } }
#[export_c]
#[no_gc]
fn st_ret_s8(a: i32, b: i32) -> S8 { return S8 { a: a, b: b } }
#[export_c]
#[no_gc]
fn st_ret_f8(x: f32, y: f32) -> F8 { return F8 { x: x, y: y } }
#[export_c]
#[no_gc]
fn st_ret_d8(x: f64) -> D8 { return D8 { x: x } }
#[export_c]
#[no_gc]
fn st_ret_s12(k: i32) -> S12 { return S12 { a: k, b: k + 1, c: k + 2 } }
#[export_c]
#[no_gc]
fn st_ret_s16(a: i64, b: i64) -> S16 { return S16 { a: a, b: b } }
#[export_c]
#[no_gc]
fn st_ret_d16(x: f64, y: f64) -> D16 { return D16 { x: x, y: y } }
#[export_c]
#[no_gc]
fn st_ret_b24(a: i64, b: i64, c: i64) -> B24 { return B24 { a: a, b: b, c: c } }
// struct in, struct out
#[export_c]
#[no_gc]
fn st_swap16(p: S16) -> S16 { return S16 { a: p.b, b: p.a } }
#[export_c]
#[no_gc]
fn st_scale_d16(p: D16, k: f64) -> D16 { return D16 { x: p.x * k, y: p.y * k } }
