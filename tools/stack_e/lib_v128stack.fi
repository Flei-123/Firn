// SPDX-License-Identifier: MPL-2.0
// tools/stack_e/lib_v128stack.fi -- r570: ten `v128` parameters (eight in xmm0-7 / v0-v7, two on the stack, 16 octets at a
// 16 octet boundary) mixed with integers and a double that also land on the stack. host_v128stack.c calls it through
// the C ABI of gcc, which is the reference for the placement.
import std.simd

fn put64(a: u64, i: usize, v: u64) {
    *((a + (i * 8) as u64) as *mut u64) = v
}

#[export_c]
fn se_v128_stack(
    out: u64,
    i0: u64, v0: v128, i1: u64, v1: v128, i2: u64, v2: v128, i3: u64, v3: v128,
    i4: u64, v4: v128, i5: u64, v5: v128, i6: u64, v6: v128, i7: u64, v7: v128,
    i8: u64, v8: v128, f0: f64, v9: v128, i9: u64,
) -> u64 {
    simd.st(out, v0)
    simd.st(out + 16, v1)
    simd.st(out + 32, v2)
    simd.st(out + 48, v3)
    simd.st(out + 64, v4)
    simd.st(out + 80, v5)
    simd.st(out + 96, v6)
    simd.st(out + 112, v7)
    simd.st(out + 128, v8)
    simd.st(out + 144, v9)
    put64(out + 160, 0, i0)
    put64(out + 160, 1, i1)
    put64(out + 160, 2, i2)
    put64(out + 160, 3, i3)
    put64(out + 160, 4, i4)
    put64(out + 160, 5, i5)
    put64(out + 160, 6, i6)
    put64(out + 160, 7, i7)
    put64(out + 160, 8, i8)
    put64(out + 160, 9, i9)
    put64(out + 160, 10, f0 as u64)
    return i0 + i1 + i2 + i3 + i4 + i5 + i6 + i7 + i8 + i9
}

// A Firn function that passes ten vectors on to another Firn function (the callee reads them off the stack too) and
// answers with the v128 sum of lane 0 -- the result travels in xmm0/v0.
fn sum10(a: v128, b: v128, c: v128, d: v128, e: v128, f: v128, g: v128, h: v128, i: v128, j: v128) -> v128 {
    return simd.add_f32(simd.add_f32(simd.add_f32(a, b), simd.add_f32(c, d)), simd.add_f32(simd.add_f32(e, f), simd.add_f32(simd.add_f32(g, h), simd.add_f32(i, j))))
}

#[export_c]
fn se_v128_sum10(out: u64, p: u64) {
    simd.st(out, sum10(simd.ld(p), simd.ld(p + 16), simd.ld(p + 32), simd.ld(p + 48), simd.ld(p + 64), simd.ld(p + 80), simd.ld(p + 96), simd.ld(p + 112), simd.ld(p + 128), simd.ld(p + 144)))
}
