// TOCTOU gate programs (tools/toctou/check.sh, docs/SECURITY-TOCTOU.md).
// Each tN snapshots attacker-writable memory (static SH / SP) and uses the
// snapshot after a check. The gate asserts that the shared symbol is read
// EXACTLY ONCE per function in the generated code.
struct Message { len: u32, data: [u8; 20] }
struct Hdr { len: u32, kind: u32 }
struct Pkt { h: Hdr, tail: u64 }

static mut SH: Message = Message { len: 0, data: [0 as u8; 20] }
static mut SP: Pkt = Pkt { h: Hdr { len: 0, kind: 0 }, tail: 0 }

#[no_inline]
fn ext(x: u64) -> u64 { return x * 3 + 1 }

// t1: scalar snapshot, check, heavy register pressure + calls, then use
#[no_inline]
fn t1(a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64) -> u64 {
    let n: u32 = SH.len
    if n > 20 { return 0 }
    let x1 = ext(a) + ext(b)
    let x2 = ext(c) * ext(d)
    let x3 = ext(e) ^ ext(f)
    let x4 = ext(g) + ext(h)
    let x5 = ext(x1) + ext(x2) + ext(x3) + ext(x4)
    return x1 + x2 + x3 + x4 + x5 + a + b + c + d + e + f + g + h + (n as u64)
}

// t2: whole struct snapshot, check, publish, no pressure
#[no_inline]
fn t2(out: *mut Message) {
    let local: Message = SH
    if local.len <= 20 { *out = local }
}

// t3: by-value struct parameter (copy at call site?) used after check
#[no_inline]
fn t3_use(m: Message) -> u64 {
    if m.len > 20 { return 0 }
    let t = ext(1) + ext(2)
    return t + (m.len as u64) + (m.data[3] as u64)
}
#[no_inline]
fn t3() -> u64 { return t3_use(SH) }

// t4: inlined callee version
fn t4_use(m: Message) -> u64 {
    if m.len > 20 { return 0 }
    return (m.len as u64) + (m.len as u64) * 3
}
#[no_inline]
fn t4() -> u64 { return t4_use(SH) }

// t5: nested struct copy, width mismatch (u32 check, u8 use)
#[no_inline]
fn t5() -> u64 {
    let h: Hdr = SP.h
    if h.len > 200 { return 0 }
    let q = ext(h.kind as u64)
    return q + ((h.len as u8) as u64) + (h.len as u64)
}

// t6: loop using snapshot count
#[no_inline]
fn t6() -> u64 {
    let n: u32 = SH.len
    if n > 20 { return 0 }
    var i: u32 = 0
    var s: u64 = 0
    while i < n { s = s + ext(i as u64)
        i = i + 1 }
    return s + (n as u64)
}

// t7: arithmetic mem-op shape: check n+4 <= 20 then use n in add
#[no_inline]
fn t7(k: u64) -> u64 {
    let n: u32 = SH.len
    if n + 4 > 20 { return 0 }
    return k + (n as u64)
}

// t8: partial struct copy then compare of whole (bulk vs scalar)
#[no_inline]
fn t8() -> u64 {
    let p: Pkt = SP
    if p.h.len > 64 { return 0 }
    return (p.h.len as u64) + p.tail
}

fn main() -> i32 {
    SH.len = 5
    let r = t1(1, 2, 3, 4, 5, 6, 7, 8) + t3() + t4() + t5() + t6() + t7(1) + t8()
    var o: Message = Message { len: 0, data: [0 as u8; 20] }
    t2(&o)
    return (r & 0) as i32
}
