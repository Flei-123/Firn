import std.rt
import fui.kpdocs
import docview.pagehash

fn main(start: u64) -> i32 {
    kpdocs.install_pdf_docx()
    var data: rt.Buf = rt.buf_new()
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, rt.arg_ptr(start, 1), rt.c_length(rt.arg_ptr(start, 1)))
    rt.buf_push(&path, 0 as u8)
    if !rt.read_file(rt.buf_ptr(&path), &data) {
        return 2
    }
    var r: pagehash.PageHash = pagehash.page_hash(rt.buf_ptr(&data), rt.buf_len(&data), 0)
    if !r.ok {
        return 1
    }
    var line: rt.Buf = rt.buf_new()
    pagehash.page_hash_line(&r, &line)
    rt.buf_push(&line, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&line), rt.buf_len(&line))
    return 0
}
