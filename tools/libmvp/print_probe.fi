// SPDX-License-Identifier: MPL-2.0
// tools/libmvp/print_probe.fi -- lib/print against a real IPP printer
// (CUPS' ippeveprinter) and a CUPS stand-in (tools/libmvp/check_print.py).
//
//     print_probe list <server-url>
//     print_probe attrs <printer>
//     print_probe print <printer> <file.pdf> <copies> <sides> <media>
//     print_probe state <printer> <job>
//     print_probe cancel <printer> <job>
import print.print
import std.fs
import std.io
import std.rt
import std.vec

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: rt.ptr_of(p), n: rt.c_length(p) }
}

fn num(s: str) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < s.n {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as u32
        i = i + 1
    }
    return v
}

fn fail(e: PrintError) -> bool {
    var b: rt.Buf = rt.buf_new()
    var t: str = "Other"
    if e == PrintError::NoServer { t = "NoServer" }
    if e == PrintError::Http { t = "Http" }
    if e == PrintError::Ipp { t = "Ipp" }
    if e == PrintError::BadPrinter { t = "BadPrinter" }
    if e == PrintError::Protocol { t = "Protocol" }
    let head: str = "ERROR "
    rt.buf_push_bytes(&b, head.p as u64, head.n)
    rt.buf_push_bytes(&b, t.p as u64, t.n)
    rt.buf_push(&b, 32 as u8)
    rt.buf_push_dec_u64(&b, print.print_last_status() as u64)
    io.print_line(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
    return false
}

fn line(parts: str) {
    io.print_line(parts)
}

fn b2s(v: bool) -> str {
    if v { return "1" }
    return "0"
}

fn show(pi: *mut print.PrinterInfo) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, (*pi).state as u64)
    let st: str = str { p: rt.buf_data(&b), n: rt.buf_len(&b) }
    line((*pi).name + "|" + (*pi).uri + "|" + (*pi).info + "|" + (*pi).location + "|" + (*pi).make + "|" + st + "|" +
        b2s((*pi).accepting) + b2s((*pi).color) + b2s((*pi).duplex) + b2s((*pi).is_default) + "|" + (*pi).media + "|" + (*pi).formats)
}

fn main(start: u64) -> i32 {
    let cmd: str = arg(start, 1)
    if cmd == "list" {
        var list: Vec[print.PrinterInfo] = vec_new[print.PrinterInfo]()
        let n: usize = print.printers_at(arg(start, 2), &list) catch | e | (fail(e) as usize + 999999)
        if n == 999999 {
            return 0
        }
        var i: usize = 0
        while i < n {
            show(vec_elem_ptr[print.PrinterInfo](&list, i))
            i = i + 1
        }
        io.print_line("END")
    } else if cmd == "attrs" {
        var pi: print.PrinterInfo = print.PrinterInfo { name: "", uri: "", info: "", location: "", make: "", state: 0, accepting: false,
            color: false, duplex: false, is_default: false, media: "", formats: "" }
        let ok: bool = print.printer_attributes(arg(start, 2), &pi) catch | e | (fail(e))
        if ok {
            show(&pi)
        }
    } else if cmd == "print" {
        var data: rt.Buf = rt.buf_new()
        fs.read_file(arg(start, 3), &data) catch 0
        var o: print.PrintOptions = print.print_options_default()
        o.copies = num(arg(start, 4))
        o.sides = num(arg(start, 5))
        o.media = arg(start, 6)
        o.job_name = "firn-probe"
        let job: u32 = print.print_pdf(arg(start, 2), rt.buf_ptr(&data), rt.buf_len(&data), o) catch | e | (fail(e) as u32)
        if job > 0 {
            var b: rt.Buf = rt.buf_new()
            let head: str = "JOB "
            rt.buf_push_bytes(&b, head.p as u64, head.n)
            rt.buf_push_dec_u64(&b, job as u64)
            io.print_line(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
        }
    } else if cmd == "state" {
        let st: u32 = print.job_state(arg(start, 2), num(arg(start, 3))) catch | e | (fail(e) as u32)
        if st > 0 {
            var b: rt.Buf = rt.buf_new()
            let head: str = "STATE "
            rt.buf_push_bytes(&b, head.p as u64, head.n)
            rt.buf_push_dec_u64(&b, st as u64)
            io.print_line(str { p: rt.buf_data(&b), n: rt.buf_len(&b) })
        }
    } else if cmd == "cancel" {
        let ok: bool = print.cancel_job(arg(start, 2), num(arg(start, 3))) catch | e | (fail(e))
        if ok {
            io.print_line("CANCELED")
        }
    }
    return 0
}
