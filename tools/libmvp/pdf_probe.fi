// SPDX-License-Identifier: MPL-2.0
// tools/libmvp/pdf_probe.fi -- a PDF with everything lib/pdf can do, for
// tools/libmvp/check_pdf.py to hold against poppler (pdfinfo, pdftotext,
// pdffonts, pdftoppm) and pypdf.
//
//     pdf_probe <out.pdf> <font.ttf>
//
// Page 1 (A3 landscape): a frame, a filled red square at 20/20 mm (40 mm),
// a blue circle, a dashed line, text in two sizes with umlauts and Greek,
// an image (8x8, a green/transparent checkerboard) at 100/20 mm, a link to
// page 2 over the title and a URI link, everything on the layer "Frame"
// except the text. Page 2 (A4 portrait): text, and the destination.
// Bookmarks: "Übersicht" -> page 1, under it "Seite 2" -> page 2.
import pdf.pdf
import std.fs
import std.rt
import std.io

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: rt.ptr_of(p), n: rt.c_length(p) }
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        io.print_line("usage: pdf_probe <out.pdf> <font.ttf>")
        return 1 as i32
    }
    var fontdata: rt.Buf = rt.buf_new()
    let fl: usize = fs.read_file(arg(start, 2), &fontdata) catch 0
    if fl == 0 { return 2 as i32 }
    var out: rt.Buf = rt.buf_new()
    var opts: pdf.PdfOptions = pdf.pdf_options_default()
    opts.title = "OpenPlan – Wendeschützschaltung"
    opts.author = "Firn"
    opts.created_ms = 1790351407123
    var doc: pdf.Pdf = pdf.pdf_new(&out, opts)
    let f: u32 = pdf.pdf_font_load(&doc, rt.buf_ptr(&fontdata), fl) catch 99 as u32
    if f == 99 { return 3 as i32 }
    let frame: u32 = pdf.pdf_layer(&doc, "Frame")
    let p2: u32 = pdf.pdf_dest_new(&doc)
    let p1: u32 = pdf.pdf_dest_new(&doc)

    pdf.pdf_page_begin(&doc, 420.0, 297.0)
    pdf.pdf_dest_set(&doc, p1, 0.0, 0.0) catch false
    pdf.pdf_layer_begin(&doc, frame) catch false
    pdf.pdf_line_width(&doc, 0.5)
    pdf.pdf_stroke_rgb(&doc, 0.0, 0.0, 0.0)
    pdf.pdf_rect(&doc, 10.0, 10.0, 400.0, 277.0)
    pdf.pdf_stroke(&doc)
    pdf.pdf_layer_end(&doc)
    pdf.pdf_fill_rgb(&doc, 1.0, 0.0, 0.0)
    pdf.pdf_rect(&doc, 20.0, 20.0, 40.0, 40.0)
    pdf.pdf_fill(&doc)
    pdf.pdf_fill_rgb(&doc, 0.0, 0.0, 1.0)
    pdf.pdf_circle(&doc, 200.0, 150.0, 30.0)
    pdf.pdf_fill(&doc)
    pdf.pdf_save(&doc)
    pdf.pdf_dash(&doc, 3.0, 2.0)
    pdf.pdf_line_cap(&doc, pdf.CAP_ROUND)
    pdf.pdf_move_to(&doc, 20.0, 250.0)
    pdf.pdf_line_to(&doc, 380.0, 250.0)
    pdf.pdf_curve_to(&doc, 390.0, 250.0, 390.0, 270.0, 380.0, 270.0)
    pdf.pdf_stroke(&doc)
    pdf.pdf_restore(&doc)
    pdf.pdf_fill_rgb(&doc, 0.0, 0.0, 0.0)
    pdf.pdf_text(&doc, f, 24.0, 20.0, 80.0, "Wendeschützschaltung -K1 -K2") catch false
    pdf.pdf_text(&doc, f, 10.0, 20.0, 90.0, "Größe: 3 × 400 V, Ω α β (Test)") catch false
    let tw: f64 = pdf.pdf_text_width(&doc, f, 24.0, "Wendeschützschaltung -K1 -K2")
    pdf.pdf_link_internal(&doc, 20.0, 70.0, tw, 12.0, p2) catch false
    pdf.pdf_link_uri(&doc, 20.0, 85.0, 50.0, 6.0, "https://example.org/openplan?a=(1)") catch false
    var px: rt.Buf = rt.buf_new()
    var y: u32 = 0
    while y < 8 {
        var x: u32 = 0
        while x < 8 {
            if (x + y) % 2 == 0 {
                rt.buf_push(&px, 0 as u8)
                rt.buf_push(&px, 200 as u8)
                rt.buf_push(&px, 0 as u8)
                rt.buf_push(&px, 255 as u8)
            } else {
                rt.buf_push(&px, 0 as u8)
                rt.buf_push(&px, 0 as u8)
                rt.buf_push(&px, 0 as u8)
                rt.buf_push(&px, 0 as u8)
            }
            x = x + 1
        }
        y = y + 1
    }
    pdf.pdf_image_rgba(&doc, rt.buf_ptr(&px), 8 as u32, 8 as u32, 100.0, 20.0, 40.0, 40.0) catch false

    pdf.pdf_page_begin(&doc, 210.0, 297.0)
    pdf.pdf_dest_set(&doc, p2, 0.0, 20.0) catch false
    pdf.pdf_text(&doc, f, 12.0, 20.0, 30.0, "Seite 2: Klemmenplan X1") catch false
    pdf.pdf_outline(&doc, "Übersicht", p1, 0 as u32) catch false
    pdf.pdf_outline(&doc, "Seite 2", p2, 1 as u32) catch false
    let size: usize = pdf.pdf_finish(&doc) catch 0
    if size == 0 { return 4 as i32 }
    let w: usize = fs.write_file(arg(start, 1), rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    if w != size { return 5 as i32 }
    io.print_line("ok")
    return 0
}
