// SPDX-License-Identifier: MPL-2.0
// tools/libmvp/regex_probe.fi -- lib/regex against Python's re.
//
// Reads lines "<pattern hex> <flags> <text hex>" from standard input and
// answers each with one line: "E <kind>" for a refused pattern, "N" for no
// match, or "M <start> <end> <g1s> <g1e> ... | <replace-all result hex>"
// (octet offsets, -1 for a group that did not take part; the replacement
// is "<$1>" for every match). tools/libmvp/check_regex.py writes the
// lines and compares.
import regex.regex
import std.io
import std.rt

fn unhex(p: u64, n: usize, out: *mut rt.Buf) {
    var i: usize = 0
    while i + 1 < n {
        rt.buf_push(out, (nib(rt.ld8(p, i)) * 16 + nib(rt.ld8(p, i + 1))) as u8)
        i = i + 2
    }
}

fn nib(c: u8) -> u32 {
    if c >= 97 as u8 {
        return (c - 87 as u8) as u32
    }
    return (c - 48 as u8) as u32
}

fn hex(b: *mut rt.Buf, s: str) {
    let d: str = "0123456789abcdef"
    var i: usize = 0
    while i < s.n {
        let c: u8 = rt.ld8(s.p as u64, i)
        rt.buf_push(b, rt.ld8(d.p as u64, (c >> 4) as usize))
        rt.buf_push(b, rt.ld8(d.p as u64, (c & 15 as u8) as usize))
        i = i + 1
    }
}

fn kind(e: RegexError, out: *mut str) -> regex.Regex {
    if e == RegexError::Syntax { *out = "Syntax" }
    if e == RegexError::Unsupported { *out = "Unsupported" }
    if e == RegexError::TooBig { *out = "TooBig" }
    if e == RegexError::TooManyGroups { *out = "TooManyGroups" }
    return regex.regex_compile("", 0 as u32) catch | f | (kind(f, out))
}

fn main() -> i32 {
    var input: rt.Buf = rt.buf_new()
    rt.read_stdin(&input)
    var out: rt.Buf = rt.buf_new()
    let p: u64 = rt.buf_ptr(&input)
    let n: usize = rt.buf_len(&input)
    var i: usize = 0
    while i < n {
        var e: usize = i
        while e < n && rt.ld8(p, e) != 10 as u8 {
            e = e + 1
        }
        // three fields
        var f1: usize = i
        while f1 < e && rt.ld8(p, f1) != 32 as u8 {
            f1 = f1 + 1
        }
        var f2: usize = f1 + 1
        while f2 < e && rt.ld8(p, f2) != 32 as u8 {
            f2 = f2 + 1
        }
        var pat: rt.Buf = rt.buf_new()
        var txt: rt.Buf = rt.buf_new()
        unhex(p + i as u64, f1 - i, &pat)
        let flags: u32 = (rt.ld8(p, f1 + 1) - 48 as u8) as u32
        unhex(p + (f2 + 1) as u64, e - f2 - 1, &txt)
        let ps: str = str { p: rt.buf_data(&pat), n: rt.buf_len(&pat) }
        let ts: str = str { p: rt.buf_data(&txt), n: rt.buf_len(&txt) }
        var why: str = ""
        var r: regex.Regex = regex.regex_compile(ps, flags) catch | x | (kind(x, &why))
        if why.n > 0 {
            let head: str = "E "
            rt.buf_push_bytes(&out, head.p as u64, 2)
            rt.buf_push_bytes(&out, why.p as u64, why.n)
        } else {
            var m: regex.Match = regex.match_new()
            if regex.regex_find(&r, ts, 0, &m) {
                rt.buf_push(&out, 77 as u8)
                var g: u32 = 0
                while g < regex.regex_group_count(&r) {
                    rt.buf_push(&out, 32 as u8)
                    rt.buf_push_dec_i64(&out, m.caps[(g * 2) as usize])
                    rt.buf_push(&out, 32 as u8)
                    rt.buf_push_dec_i64(&out, m.caps[(g * 2 + 1) as usize])
                    g = g + 1
                }
                let sep: str = " | "
                rt.buf_push_bytes(&out, sep.p as u64, 3)
                hex(&out, regex.regex_replace_all(&r, ts, "<$1>"))
            } else {
                rt.buf_push(&out, 78 as u8)
            }
            regex.regex_free(&r)
        }
        rt.buf_push(&out, 10 as u8)
        rt.buf_free(&pat)
        rt.buf_free(&txt)
        i = e + 1
    }
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}
