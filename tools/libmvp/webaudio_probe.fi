import std.rt
import std.math
import plat.web
import docview.obj
import audio.pcm
import media.audio.source
import media.audio.wav
import media.audio.sinkplay

const RATE: u32 = 44100 as u32
const SECONDS: usize = 4

struct Probe {
    player: sinkplay.SinkPlay,
    wav_data: rt.Buf,
    running: bool,
}

static mut G_PROBE: u64 = 0

fn probe() -> *mut Probe {
    if G_PROBE == 0 as u64 {
        G_PROBE = obj.obj_alloc[Probe]()
        (*(G_PROBE as *mut Probe)).wav_data = rt.buf_new()
        (*(G_PROBE as *mut Probe)).player = sinkplay.sp_new()
        (*(G_PROBE as *mut Probe)).running = false
    }
    return G_PROBE as *mut Probe
}

fn store(key: str, p: u64, n: usize) {
    web.web_store_set(key.p as u64, key.n, p, n)
}

fn build_wav(wav_data: *mut rt.Buf) {
    let frames: usize = RATE as usize * SECONDS
    pcm.wav_header(wav_data, RATE, 1 as u32, (frames * 2) as u32)
    var i: usize = 0
    while i < frames {
        let v: f64 = math.sin(6.283185307179586 * 440.0 * (i as f64) / (RATE as f64)) * 16000.0
        let s: i32 = v as i32
        rt.buf_push(wav_data, (s & 255) as u8)
        rt.buf_push(wav_data, ((s >> 8) & 255) as u8)
        i = i + 1
    }
}

fn start() -> bool {
    let pr: *mut Probe = probe()
    build_wav(&(*pr).wav_data)
    var r: source.Registry = source.registry_new()
    wav.register(&r)
    if !sinkplay.sp_open_with(&(*pr).player, &r, rt.buf_ptr(&(*pr).wav_data), rt.buf_len(&(*pr).wav_data), false) {
        return false
    }
    (*pr).running = sinkplay.sp_start(&(*pr).player, "webaudio-probe")
    return (*pr).running
}

fn report() {
    let pr: *mut Probe = probe()
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, sinkplay.sp_position_ms(&(*pr).player))
    rt.buf_push(&b, 124 as u8)
    rt.buf_push_dec_u64(&b, sinkplay.sp_state(&(*pr).player) as u64)
    rt.buf_push(&b, 124 as u8)
    if (*pr).running {
        rt.buf_push(&b, 49 as u8)
    } else {
        rt.buf_push(&b, 48 as u8)
    }
    store("webaudio", rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn paint(ud: u64, w: *mut web.Web) -> bool {
    return true
}

fn event(ud: u64, w: *mut web.Web, e: *mut web.WebEvent) -> bool {
    if (*e).kind == web.WE_KEY && (*e).status == 1 as u32 && (*e).n == 1 {
        let k: u8 = rt.ld8((*e).p, 0)
        if k == 112 as u8 {
            start()
            web.web_wake_in(w, 16.0)
        }
        if k == 115 as u8 && (*probe()).running {
            sinkplay.sp_pause(&(*probe()).player)
        }
        if k == 114 as u8 && (*probe()).running {
            sinkplay.sp_resume(&(*probe()).player)
        }
        if k == 107 as u8 && (*probe()).running {
            sinkplay.sp_seek_ms(&(*probe()).player, 2500 as u64)
        }
        return false
    }
    if (*e).kind == web.WE_TICK && (*probe()).running {
        sinkplay.sp_pump(&(*probe()).player)
        report()
        web.web_wake_in(w, 16.0)
    }
    return (*e).kind == web.WE_RESIZE
}

fn main() -> i32 {
    if !web.web_app(0, paint, event) {
        return 1
    }
    return 0
}
