// SPDX-License-Identifier: MPL-2.0
// tools/libmvp/png_probe.fi -- lib/paint/png.fi (PNG in) against Pillow.
//
//     png_probe <in.png> <out.raw>
//
// Decodes the file and writes "<w> <h>\n" followed by the RGBA octets, or
// prints "ERROR". tools/libmvp/check_png.py compares with Pillow.
import paint.png
import std.fs
import std.io
import std.rt

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: rt.ptr_of(p), n: rt.c_length(p) }
}

fn main(start: u64) -> i32 {
    var data: rt.Buf = rt.buf_new()
    fs.read_file(arg(start, 1), &data) catch 0
    var im: png.Image = png.image_new()
    if !png.decode_png(rt.buf_ptr(&data), rt.buf_len(&data), &im) {
        io.print_line("ERROR Refused")
        return 0
    }
    var out: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&out, png.image_width(&im) as u64)
    rt.buf_push(&out, 32 as u8)
    rt.buf_push_dec_u64(&out, png.image_height(&im) as u64)
    rt.buf_push(&out, 10 as u8)
    rt.buf_push_bytes(&out, im.px as u64, png.image_width(&im) * png.image_height(&im) * 4)
    fs.write_file(arg(start, 2), rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    io.print_line("OK")
    return 0
}
