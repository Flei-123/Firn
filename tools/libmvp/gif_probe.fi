// SPDX-License-Identifier: MPL-2.0
// tools/libmvp/gif_probe.fi -- lib/gif against Pillow (Pillow, libgif).
//
//     gif_probe <in.gif> <out.raw> [anim]
//
// Decodes the file and writes "<w> <h>\n" followed by the RGBA octets (with
// `anim`: "<w> <h> <frames>\n", the delays as decimal lines "d <ms>\n", then
// every canvas), or prints "ERROR <kind>". tools/libmvp/check_gif.py
// compares with Pillow.
import gif.gif
import std.fs
import std.io
import std.rt

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: rt.ptr_of(p), n: rt.c_length(p) }
}

fn kind(e: GifError) -> bool {
    if e == GifError::NotGif { io.print_line("ERROR NotWebp") }
    if e == GifError::Corrupt { io.print_line("ERROR Corrupt") }
    if e == GifError::Unsupported { io.print_line("ERROR Unsupported") }
    if e == GifError::TooLarge { io.print_line("ERROR TooLarge") }
    if e == GifError::OutOfMemory { io.print_line("ERROR OutOfMemory") }
    return false
}

fn main(start: u64) -> i32 {
    var data: rt.Buf = rt.buf_new()
    fs.read_file(arg(start, 1), &data) catch 0
    var out: rt.Buf = rt.buf_new()
    if rt.arg_count(start) > 3 {
        var an: gif.GifAnim = gif.gif_anim_new()
        let ok: bool = gif.gif_decode_anim(rt.buf_ptr(&data), rt.buf_len(&data), &an) catch | e | (kind(e))
        if !ok {
            return 0
        }
        rt.buf_push_dec_u64(&out, an.w as u64)
        rt.buf_push(&out, 32 as u8)
        rt.buf_push_dec_u64(&out, an.h as u64)
        rt.buf_push(&out, 32 as u8)
        rt.buf_push_dec_u64(&out, an.count as u64)
        rt.buf_push(&out, 32 as u8)
        rt.buf_push_dec_u64(&out, an.loops as u64)
        rt.buf_push(&out, 10 as u8)
        var i: u32 = 0
        while i < an.count {
            rt.buf_push(&out, 100 as u8)
            rt.buf_push(&out, 32 as u8)
            rt.buf_push_dec_u64(&out, gif.gif_anim_delay(&an, i) as u64)
            rt.buf_push(&out, 10 as u8)
            i = i + 1
        }
        rt.buf_push_bytes(&out, rt.buf_ptr(&an.px), rt.buf_len(&an.px))
    } else {
        var im: gif.GifImage = gif.gif_image_new()
        let ok: bool = gif.gif_decode(rt.buf_ptr(&data), rt.buf_len(&data), &im) catch | e | (kind(e))
        if !ok {
            return 0
        }
        rt.buf_push_dec_u64(&out, im.w as u64)
        rt.buf_push(&out, 32 as u8)
        rt.buf_push_dec_u64(&out, im.h as u64)
        rt.buf_push(&out, 10 as u8)
        rt.buf_push_bytes(&out, rt.buf_ptr(&im.px), rt.buf_len(&im.px))
    }
    fs.write_file(arg(start, 2), rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    io.print_line("OK")
    return 0
}
