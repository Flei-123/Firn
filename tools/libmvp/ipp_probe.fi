import print.ippmsg
import print.ippcaps
import print.ippclient
import print.pagejob
import print.bitmap
import std.fs
import std.io
import std.rt
import std.vec

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: rt.ptr_of(p), n: rt.c_length(p) }
}

fn num(s: str) -> u32 {
    var v: u32 = 0
    var i: usize = 0
    while i < s.n {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as u32
        i = i + 1
    }
    return v
}

fn dec(v: u32) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&b, v as u64)
    let s: str = __str_copy(rt.buf_str(&b))
    rt.buf_free(&b)
    return s
}

fn page(ud: u64, n: u32, w: u32, h: u32, dpi: u32, out: *mut rt.Buf) -> bool {
    var y: u32 = 0
    while y < h {
        var x: u32 = 0
        while x < w {
            var r: u32 = 255
            var g: u32 = 255
            var b: u32 = 255
            if y >= h / 2 {
                r = (x * 7 + y) & 255
                g = (x * 3 + n) & 255
                b = (y * 5) & 255
            }
            rt.buf_push(out, r as u8)
            rt.buf_push(out, g as u8)
            rt.buf_push(out, b as u8)
            rt.buf_push(out, 255 as u8)
            x = x + 1
        }
        y = y + 1
    }
    return true
}

fn main(start: u64) -> i32 {
    let cmd: str = arg(start, 1)
    if cmd == "raster" {
        var src: pagejob.PageSource = pagejob.PageSource { pages: 2, render: page, ud: 0 }
        var d: pagejob.Delivery = pagejob.Delivery { kind: pagejob.D_PWG, format: "image/pwg-raster", dpi: num(arg(start, 4)), pix: num(arg(start, 5)) }
        if arg(start, 2) == "urf" {
            d.kind = pagejob.D_URF
        }
        var out: rt.Buf = rt.buf_new()
        let ok: bool = pagejob.build_raster_document(&src, &d, num(arg(start, 6)), num(arg(start, 7)), "iso_a4_210x297mm", &out)
        fs.write_file(arg(start, 3), rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
        io.print_line(dec(ok as u32))
    } else if cmd == "attrs" {
        var c: ippclient.Client = ippclient.client_new()
        var caps: ippcaps.Caps = ippcaps.caps_new()
        let ok: bool = ippclient.get_printer_attributes(&c, arg(start, 2), &caps) catch | e | (false)
        io.print_line(dec(ok as u32) + "|" + caps.name + "|" + dec(caps.state) + "|" + caps.formats + "|" + caps.media + "|" + caps.sides + "|" + caps.color_modes + "|" + dec(vec_len[ippcaps.MediaSize](&caps.media_sizes) as u32) + "|" + dec(caps.copies_max))
    } else if cmd == "print" {
        var c: ippclient.Client = ippclient.client_new()
        var data: rt.Buf = rt.buf_new()
        fs.read_file(arg(start, 3), &data) catch 0
        var s: ippclient.JobSpec = ippclient.spec_default()
        s.copies = num(arg(start, 5))
        s.sides = arg(start, 6)
        s.job_name = "firn-ipp"
        ippclient.spec_set_ranges(&s, arg(start, 7))
        let id: u32 = ippclient.print_job(&c, arg(start, 2), rt.buf_ptr(&data), rt.buf_len(&data), arg(start, 4), &s) catch | e | (0 as u32)
        io.print_line("JOB " + dec(id) + " " + dec(ippclient.client_status(&c)))
        var info: ippclient.JobInfo = ippclient.job_info_new()
        let ok: bool = ippclient.get_job(&c, arg(start, 2), id, &info) catch | e | (false)
        io.print_line("STATE " + dec(info.state) + " " + dec(ok as u32))
        let cc: bool = ippclient.cancel_job(&c, arg(start, 2), id) catch | e | (false)
        io.print_line("CANCEL " + dec(cc as u32) + " " + dec(ippclient.client_status(&c)))
    }
    return 0
}
