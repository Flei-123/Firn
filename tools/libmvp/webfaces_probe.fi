import std.rt
import plat.web
import plat.assetio
import fui.kpdocs
import docview.pagehash

static mut G_DONE: u32 = 0

fn store(key: str, p: u64, n: usize) {
    web.web_store_set(key.p as u64, key.n, p, n)
}

fn run_asset(name: str, key: str) {
    var data: rt.Buf = rt.buf_new()
    var line: rt.Buf = rt.buf_new()
    if assetio.read(name, &data) {
        var r: pagehash.PageHash = pagehash.page_hash(rt.buf_ptr(&data), rt.buf_len(&data), 0)
        if r.ok {
            pagehash.page_hash_line(&r, &line)
        } else {
            rt.buf_push_bytes(&line, "open-failed".p as u64, 11)
        }
    } else {
        rt.buf_push_bytes(&line, "no-asset".p as u64, 8)
    }
    store(key, rt.buf_ptr(&line), rt.buf_len(&line))
    rt.buf_free(&line)
    rt.buf_free(&data)
}

fn clock_us() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] as u64) * 1000000 + (ts[1] as u64) / 1000
}

fn run_clock() {
    let a: u64 = clock_us()
    var spins: u64 = 0
    while clock_us() - a < 30000 && spins < 50000000 {
        spins = spins + 1
    }
    let d: u64 = clock_us() - a
    var line: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&line, a)
    rt.buf_push(&line, 124 as u8)
    rt.buf_push_dec_u64(&line, d)
    store("webfaces-clock", rt.buf_ptr(&line), rt.buf_len(&line))
    rt.buf_free(&line)
}

fn paint(ud: u64, w: *mut web.Web) -> bool {
    return true
}

fn event(ud: u64, w: *mut web.Web, e: *mut web.WebEvent) -> bool {
    if (*e).kind == web.WE_KEY && (*e).status == 1 as u32 && (*e).n == 1 {
        let k: u8 = rt.ld8((*e).p, 0)
        if G_DONE == 0 as u32 {
            kpdocs.install_pdf_docx()
            G_DONE = 1 as u32
        }
        if k == 112 as u8 {
            run_asset("a.pdf", "webfaces-pdf")
        }
        if k == 116 as u8 {
            run_clock()
        }
        if k == 100 as u8 {
            run_asset("a.docx", "webfaces-docx")
        }
        return false
    }
    return (*e).kind == web.WE_RESIZE
}

fn main() -> i32 {
    if !web.web_app(0, paint, event) {
        return 1
    }
    return 0
}
