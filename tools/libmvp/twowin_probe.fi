// SPDX-License-Identifier: MPL-2.0
// tools/libmvp/twowin_probe.fi -- two top-level windows in one program
// (OpenPlan LIB-005), waited on together with window.wait_any.
//
// Opens "Firn A" (red) and "Firn B" (blue), prints READY, then answers the
// events of both until both are closed or 20 s passed; prints
// "CLOSED <index>" when a window is closed (window manager / SendEvent).
// tools/libmvp/check_twowin.py drives it with python-xlib on an Xvfb.
import window.window
import std.io
import std.rt

fn paint(w: *mut window.Window, rgb: u32) {
    window.fill(w, window.rgb_to_bgrx(rgb), 0, 0, window.width(w), window.height(w))
    window.present(w)
}

fn main() -> i32 {
    var a: window.Window = window.window_new()
    var b: window.Window = window.window_new()
    if !window.open_window(&a, 0) || !window.open_window(&b, 0) {
        io.print_line("NOWINDOW")
        return 1 as i32
    }
    window.make(&a, 200, 120)
    window.make(&b, 160, 100)
    let ta: str = "Firn A"
    let tb: str = "Firn B"
    window.title(&a, ta.p as u64, ta.n)
    window.title(&b, tb.p as u64, tb.n)
    window.show_window(&a)
    window.show_window(&b)
    paint(&a, 16711680 as u32)
    paint(&b, 255 as u32)
    io.print_line("READY")
    var ws: [u64; 8] = [(&a) as u64, (&b) as u64, 0, 0, 0, 0, 0, 0]
    var open: [bool; 2] = [true, true]
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    let until: i64 = ts[0] + 20
    while open[0] || open[1] {
        // only the windows still open take part
        var live: [u64; 8] = [0 as u64; 8]
        var map: [usize; 2] = [0; 2]
        var n: usize = 0
        var i: usize = 0
        while i < 2 {
            if open[i] {
                live[n] = ws[i]
                map[n] = i
                n = n + 1
            }
            i = i + 1
        }
        let hit: i64 = window.wait_any(&live, n, 500)
        syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
        if ts[0] > until {
            io.print_line("TIMEOUT")
            return 2 as i32
        }
        if hit < 0 {
            continue
        }
        let wi: usize = map[hit as usize]
        let w: *mut window.Window = ws[wi] as *mut window.Window
        var k: u32 = window.next_event(w)
        while k != window.EV_NONE {
            if k == window.EV_EXPOSE {
                if wi == 0 {
                    paint(w, 16711680 as u32)
                } else {
                    paint(w, 255 as u32)
                }
            }
            if k == window.EV_CLOSED {
                open[wi] = false
                window.close_window(w)
                if wi == 0 {
                    io.print_line("CLOSED 0")
                } else {
                    io.print_line("CLOSED 1")
                }
                k = window.EV_NONE
            } else {
                k = window.next_event(w)
            }
        }
    }
    io.print_line("DONE")
    return 0
}
