// tools/libmvp/webclip_probe.fi -- a page for tools/libmvp/check_webclip.mjs:
// lib/plat/webclip.fi against Chromium's real clipboard. Keys drive it:
//   c  copy the text below        v  paste text
//   j  copy an own JSON type      k  paste that type
//   p  ask for image/png (nothing of that type is there)
// Every answer lands in localStorage under "webclip" as
// "<status>|<type>|<data>", every copy under "webclip_w" as "1"/"0".
import std.rt
import plat.web
import plat.webclip

const TEXT_MIME: str = "text/plain;charset=utf-8"
const OWN_MIME: str = "application/x-openplan+json"

fn store(key: str, p: u64, n: usize) {
    web.web_store_set(key.p as u64, key.n, p, n)
}

fn wrote(ok: bool) {
    var v: str = "0"
    if ok {
        v = "1"
    }
    store("webclip_w", v.p as u64, v.n)
}

fn paint(ud: u64, w: *mut web.Web) -> bool {
    return true
}

fn event(ud: u64, w: *mut web.Web, e: *mut web.WebEvent) -> bool {
    if (*e).kind == web.WE_KEY && (*e).status == 1 as u32 && (*e).n == 1 {
        let k: u8 = rt.ld8((*e).p, 0)
        if k == 99 as u8 {
            let t: str = "Firn → Zwischenablage ✓"
            wrote(webclip.web_clip_write(TEXT_MIME, t.p as u64, t.n))
        }
        if k == 118 as u8 {
            webclip.web_clip_read(TEXT_MIME)
        }
        if k == 106 as u8 {
            let j: str = "{\"devices\":[\"-K1\",\"-Q2\"]}"
            wrote(webclip.web_clip_write(OWN_MIME, j.p as u64, j.n))
        }
        if k == 107 as u8 {
            webclip.web_clip_read(OWN_MIME)
        }
        if k == 112 as u8 {
            webclip.web_clip_read("image/png")
        }
        return false
    }
    if (*e).kind == web.WE_CLIP {
        var b: rt.Buf = rt.buf_new()
        rt.buf_push_dec_u64(&b, (*e).status as u64)
        rt.buf_push(&b, 124 as u8)
        rt.buf_push_bytes(&b, (*e).q, (*e).qn)
        rt.buf_push(&b, 124 as u8)
        rt.buf_push_bytes(&b, (*e).p, (*e).n)
        store("webclip", rt.buf_ptr(&b), rt.buf_len(&b))
        rt.buf_free(&b)
        return false
    }
    return (*e).kind == web.WE_RESIZE
}

fn main() -> i32 {
    if !web.web_app(0, paint, event) {
        return 1
    }
    return 0
}
