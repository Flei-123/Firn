// SPDX-License-Identifier: MPL-2.0
// tools/libmvp/zip_probe.fi -- lib/zip against other ZIP implementations.
//
//     zip_probe write <file>      an archive with the awkward cases
//     zip_probe write64 <file>    70,000 entries: ZIP64 end records
//     zip_probe read <file>       every entry: name, size, CRC-32 of what
//                                 was extracted, or the refusal
//
// tools/libmvp/check_zip.py lets Python's zipfile and Info-ZIP's unzip read
// what `write` wrote, and lets `read` read what Python wrote.
import zip.zip
import std.fs
import std.io
import std.rt
import std.deflate

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: rt.ptr_of(p), n: rt.c_length(p) }
}

fn say(b: *mut rt.Buf) {
    rt.buf_push(b, 10 as u8)
    io.print_bytes(rt.buf_ptr(b), rt.buf_len(b))
    rt.buf_clear(b)
}

fn text(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn write(path: str, count: u32) -> i32 {
    var out: rt.Buf = rt.buf_new()
    var w: zip.ZipWriter = zip.zip_writer_new(&out)
    zip.zip_set_time(&w, 1790351407123)
    var body: rt.Buf = rt.buf_new()
    var i: u32 = 0
    while i < 3000 {
        text(&body, "Klemme X1:")
        rt.buf_push_dec_u64(&body, (i % 97) as u64)
        rt.buf_push(&body, 10 as u8)
        i = i + 1
    }
    var noise: rt.Buf = rt.buf_new()
    var x: u64 = 99
    i = 0
    while i < 70000 {
        x = x *% 6364136223846793005 +% 1442695040888963407
        rt.buf_push(&noise, ((x >> 33) & 255) as u8)
        i = i + 1
    }
    if count == 0 {
        zip.zip_add(&w, "project.json", rt.buf_ptr(&body), rt.buf_len(&body), true) catch false
        zip.zip_add_dir(&w, "pages") catch false
        zip.zip_add(&w, "pages/0001.json", rt.buf_ptr(&body), 1000, false) catch false
        zip.zip_add(&w, "media/noise.bin", rt.buf_ptr(&noise), rt.buf_len(&noise), true) catch false
        zip.zip_add(&w, "empty.txt", 0, 0, true) catch false
        zip.zip_add(&w, "Übersicht/Schütz – Ω.txt", rt.buf_ptr(&body), 77, true) catch false
    } else {
        var nb: rt.Buf = rt.buf_new()
        i = 0
        while i < count {
            rt.buf_clear(&nb)
            text(&nb, "e/")
            rt.buf_push_dec_u64(&nb, i as u64)
            let ok: bool = zip.zip_add(&w, str { p: rt.buf_data(&nb), n: rt.buf_len(&nb) }, rt.buf_ptr(&body) + (i % 50) as u64, (i % 13) as usize, true) catch false
            if !ok { return 2 as i32 }
            i = i + 1
        }
    }
    zip.zip_finish(&w) catch 0
    let wrote: usize = fs.write_file(path, rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    if wrote != rt.buf_len(&out) {
        return 3 as i32
    }
    return 0
}

fn code_name(e: ZipError) -> str {
    if e == ZipError::NotZip { return "NotZip" }
    if e == ZipError::Corrupt { return "Corrupt" }
    if e == ZipError::Unsupported { return "Unsupported" }
    if e == ZipError::Encrypted { return "Encrypted" }
    if e == ZipError::UnsafeName { return "UnsafeName" }
    if e == ZipError::Duplicate { return "Duplicate" }
    if e == ZipError::TooLarge { return "TooLarge" }
    if e == ZipError::Checksum { return "Checksum" }
    return "Other"
}

// an archive with no entries: only the end record
static mut empty_zip: [u8; 22] = [80 as u8, 75 as u8, 5 as u8, 6 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
    0 as u8, 0 as u8, 0 as u8]

fn refuse(e: ZipError, why: *mut str) -> zip.ZipReader {
    *why = code_name(e)
    return zip.zip_reader_open((&empty_zip[0]) as u64, 22) catch | f | (refuse(f, why))
}

fn read(path: str) -> i32 {
    var data: rt.Buf = rt.buf_new()
    fs.read_file(path, &data) catch 0
    var b: rt.Buf = rt.buf_new()
    var why: str = ""
    var z: zip.ZipReader = zip.zip_reader_open(rt.buf_ptr(&data), rt.buf_len(&data)) catch | e | (refuse(e, &why))
    if why.n > 0 {
        text(&b, "REFUSED ")
        text(&b, why)
        say(&b)
        return 0
    }
    var got: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < zip.zip_entry_count(&z) {
        rt.buf_clear(&got)
        text(&b, zip.zip_entry_name(&z, i))
        rt.buf_push(&b, 9 as u8)
        var err: str = ""
        let n: usize = zip.zip_extract(&z, i, &got) catch | e | (mark(e, &err))
        if err.n > 0 {
            text(&b, "ERROR ")
            text(&b, err)
        } else {
            rt.buf_push_dec_u64(&b, n as u64)
            rt.buf_push(&b, 9 as u8)
            rt.buf_push_hex_u64(&b, deflate.crc32(rt.buf_ptr(&got), rt.buf_len(&got)) as u64, 8)
        }
        say(&b)
        i = i + 1
    }
    return 0
}

fn mark(e: ZipError, err: *mut str) -> usize {
    *err = code_name(e)
    return 0
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        io.print_line("usage: zip_probe write|write64|read <file>")
        return 1 as i32
    }
    let mode: str = arg(start, 1)
    let path: str = arg(start, 2)
    if mode == "write" { return write(path, 0 as u32) }
    if mode == "write64" { return write(path, 70000 as u32) }
    if mode == "read" { return read(path) }
    return 1 as i32
}
