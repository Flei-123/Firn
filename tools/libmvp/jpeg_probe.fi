// SPDX-License-Identifier: MPL-2.0
// tools/libmvp/jpeg_probe.fi -- lib/jpeg against Pillow (libjpeg-turbo).
//
//     jpeg_probe <in.jpg> <out.raw>
//
// Decodes the file and writes "<w> <h>\n" followed by the RGBA octets, or
// prints "ERROR <kind>". tools/libmvp/check_jpeg.py compares with Pillow.
import jpeg.jpeg
import std.fs
import std.io
import std.rt

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: rt.ptr_of(p), n: rt.c_length(p) }
}

fn kind(e: JpegError) -> bool {
    if e == JpegError::NotJpeg { io.print_line("ERROR NotJpeg") }
    if e == JpegError::Corrupt { io.print_line("ERROR Corrupt") }
    if e == JpegError::Unsupported { io.print_line("ERROR Unsupported") }
    if e == JpegError::TooLarge { io.print_line("ERROR TooLarge") }
    if e == JpegError::OutOfMemory { io.print_line("ERROR OutOfMemory") }
    return false
}

fn main(start: u64) -> i32 {
    var data: rt.Buf = rt.buf_new()
    fs.read_file(arg(start, 1), &data) catch 0
    var im: jpeg.JpegImage = jpeg.jpeg_image_new()
    let ok: bool = jpeg.jpeg_decode(rt.buf_ptr(&data), rt.buf_len(&data), &im) catch | e | (kind(e))
    if !ok {
        return 0
    }
    var out: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&out, im.w as u64)
    rt.buf_push(&out, 32 as u8)
    rt.buf_push_dec_u64(&out, im.h as u64)
    rt.buf_push(&out, 10 as u8)
    rt.buf_push_bytes(&out, rt.buf_ptr(&im.px), rt.buf_len(&im.px))
    fs.write_file(arg(start, 2), rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    io.print_line("OK")
    return 0
}
