// SPDX-License-Identifier: MPL-2.0
// tools/libmvp/time_probe.fi -- std.time against Python's datetime/zoneinfo.
//
// Prints one line per instant: the millisecond value, its ISO 8601 text in
// UTC, and the UTC offset in minutes in five zones that cover the hard
// cases (a northern and a southern DST, a DST of thirty minutes, an offset
// of 5:45, a zone with no DST at all). tools/libmvp/check_time.py computes
// the same with Python and compares line by line.
import std.time
import std.io
import std.rt

fn main() -> i32 {
    var zones: [time.Tz; 5] = [time.tz_new(), time.tz_new(), time.tz_new(), time.tz_new(), time.tz_new()]
    time.tz_load("/usr/share/zoneinfo/Europe/Vienna", &zones[0]) catch false
    time.tz_load("/usr/share/zoneinfo/America/New_York", &zones[1]) catch false
    time.tz_load("/usr/share/zoneinfo/Australia/Lord_Howe", &zones[2]) catch false
    time.tz_load("/usr/share/zoneinfo/Asia/Kathmandu", &zones[3]) catch false
    time.tz_load("/usr/share/zoneinfo/America/Sao_Paulo", &zones[4]) catch false
    var x: u64 = 88172645463325252
    var i: u32 = 0
    var b: rt.Buf = rt.buf_new()
    while i < 20000 {
        // xorshift64: instants between about 1811 and 2128
        x = x ^ (x << 13)
        x = x ^ (x >> 7)
        x = x ^ (x << 17)
        let ms: i64 = (x % 10000000000000) as i64 - 5000000000000
        rt.buf_clear(&b)
        rt.buf_push_dec_i64(&b, ms)
        rt.buf_push(&b, 32 as u8)
        let s: str = time.format_iso8601(time.civil_from_unix(ms))
        rt.buf_push_bytes(&b, s.p as u64, s.n)
        var k: usize = 0
        while k < 5 {
            rt.buf_push(&b, 32 as u8)
            let off: i32 = time.tz_offset_min(&zones[k], ms) catch 9999 as i32
            rt.buf_push_dec_i64(&b, off as i64)
            k = k + 1
        }
        rt.buf_push(&b, 10 as u8)
        io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
        i = i + 1
    }
    return 0
}
