// SPDX-License-Identifier: MPL-2.0
// tools/libmvp/clip_probe.fi -- the X11 clipboard of lib/window (OpenPlan
// LIB-006) against other X11 programs (Tk, python-xlib) on an Xvfb.
//
//     clip_probe own <seconds> <mime> <text> [<mime> <text> ...]
//         owns the clipboard and answers requests for <seconds>
//     clip_probe get <mime>        prints the content (or NONE)
//     clip_probe types             prints the offered types (or NONE)
//     clip_probe ownfile <seconds> <mime> <file>   owns the file's octets
//     clip_probe getfile <mime> <file>             writes what it gets
//
// The window comes from tools/libmvp/window/backend.fi -> lib/window/x11.fi
// (lib/window/window.fi explains the link).
import window.window
import std.io
import std.rt
import std.fs

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: rt.ptr_of(p), n: rt.c_length(p) }
}

fn num(s: str) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < s.n {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as i64
        i = i + 1
    }
    return v
}

fn now_ms() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

fn main(start: u64) -> i32 {
    var w: window.Window = window.window_new()
    if !window.open_window(&w, 0) || !window.make(&w, 64, 48) {
        io.print_line("NOWINDOW")
        return 1 as i32
    }
    let cmd: str = arg(start, 1)
    if cmd == "ownfile" {
        var data: rt.Buf = rt.buf_new()
        fs.read_file(arg(start, 4), &data) catch 0
        if !window.clipboard_set(&w, arg(start, 3), rt.buf_ptr(&data), rt.buf_len(&data)) {
            io.print_line("SETFAILED")
            return 1 as i32
        }
        io.print_line("OWNING")
        let until2: i64 = now_ms() + num(arg(start, 2)) * 1000
        while now_ms() < until2 {
            window.wait_event(&w, 100)
            while window.next_event(&w) != window.EV_NONE {
            }
        }
        return 0
    }
    if cmd == "getfile" {
        var got: rt.Buf = rt.buf_new()
        if window.clipboard_get(&w, arg(start, 2), &got) {
            fs.write_file(arg(start, 3), rt.buf_ptr(&got), rt.buf_len(&got)) catch 0
            io.print_line("GOT")
        } else {
            io.print_line("NONE")
        }
        return 0
    }
    if cmd == "own" {
        let secs: i64 = num(arg(start, 2))
        var i: usize = 3
        while i + 1 < rt.arg_count(start) {
            let t: str = arg(start, i + 1)
            if !window.clipboard_set(&w, arg(start, i), t.p as u64, t.n) {
                io.print_line("SETFAILED")
                return 1 as i32
            }
            i = i + 2
        }
        io.print_line("OWNING")
        let until: i64 = now_ms() + secs * 1000
        while now_ms() < until {
            window.wait_event(&w, 100)
            while window.next_event(&w) != window.EV_NONE {
            }
        }
        // what this program itself reads back
        var mine: rt.Buf = rt.buf_new()
        if window.clipboard_get(&w, arg(start, 3), &mine) {
            io.print_line(str { p: rt.buf_data(&mine), n: rt.buf_len(&mine) })
        }
        return 0
    }
    var out: rt.Buf = rt.buf_new()
    if cmd == "get" {
        if window.clipboard_get(&w, arg(start, 2), &out) {
            io.print_line(str { p: rt.buf_data(&out), n: rt.buf_len(&out) })
        } else {
            io.print_line("NONE")
        }
    } else if cmd == "types" {
        if window.clipboard_types(&w, &out) > 0 {
            io.print_line(str { p: rt.buf_data(&out), n: rt.buf_len(&out) })
        } else {
            io.print_line("NONE")
        }
    }
    return 0
}
