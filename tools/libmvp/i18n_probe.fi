// SPDX-License-Identifier: MPL-2.0
// tools/libmvp/i18n_probe.fi -- lib/i18n against ICU.
//
// Reads lines from standard input and answers each with one line:
//     P <lang> <number> <visible fraction digits>   -> plural category
//     N <lang> <number> <fraction digits>           -> formatted number
//     D <lang> <year> <month> <day> <style>         -> formatted date
// tools/libmvp/check_i18n.py writes the lines and compares with PyICU.
import i18n.i18n
import std.io
import std.rt
import std.str
import std.num
import std.time

fn word(p: u64, n: usize, i: *mut usize) -> str {
    while *i < n && rt.ld8(p, *i) == 32 as u8 {
        *i = *i + 1
    }
    let s: usize = *i
    while *i < n && rt.ld8(p, *i) != 32 as u8 {
        *i = *i + 1
    }
    return str { p: rt.ptr_of(p + s as u64), n: *i - s }
}

fn int_of(s: str) -> i64 {
    var v: i64 = 0
    var neg: bool = false
    var i: usize = 0
    if s.n > 0 && rt.ld8(s.p as u64, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    while i < s.n {
        v = v * 10 + (rt.ld8(s.p as u64, i) - 48 as u8) as i64
        i = i + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

// a decimal "123.456" as f64 (exactly as the text says, to the last digit
// a double can hold)
fn float_of(s: str) -> f64 {
    var neg: bool = false
    var i: usize = 0
    if s.n > 0 && rt.ld8(s.p as u64, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    var whole: f64 = 0.0
    while i < s.n && rt.ld8(s.p as u64, i) != 46 as u8 {
        whole = whole * 10.0 + (rt.ld8(s.p as u64, i) - 48 as u8) as f64
        i = i + 1
    }
    var frac: f64 = 0.0
    var scale: f64 = 1.0
    if i < s.n {
        i = i + 1
        while i < s.n {
            frac = frac * 10.0 + (rt.ld8(s.p as u64, i) - 48 as u8) as f64
            scale = scale * 10.0
            i = i + 1
        }
    }
    let v: f64 = whole + frac / scale
    if neg {
        return 0.0 - v
    }
    return v
}

fn main() -> i32 {
    var input: rt.Buf = rt.buf_new()
    rt.read_stdin(&input)
    let p: u64 = rt.buf_ptr(&input)
    let n: usize = rt.buf_len(&input)
    var out: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < n {
        var e: usize = i
        while e < n && rt.ld8(p, e) != 10 as u8 {
            e = e + 1
        }
        var k: usize = i
        let cmd: str = word(p, e, &k)
        let lang: str = word(p, e, &k)
        var res: str = ""
        if cmd == "P" {
            let v: f64 = float_of(word(p, e, &k))
            let vis: u32 = int_of(word(p, e, &k)) as u32
            res = i18n.plural_name(i18n.plural_category_v(lang, v, vis))
        } else if cmd == "N" {
            let v: f64 = float_of(word(p, e, &k))
            let frac: u32 = int_of(word(p, e, &k)) as u32
            res = i18n.format_number(lang, v, frac)
        } else {
            let y: i64 = int_of(word(p, e, &k))
            let mo: i64 = int_of(word(p, e, &k))
            let d: i64 = int_of(word(p, e, &k))
            let style: u32 = int_of(word(p, e, &k)) as u32
            var t: time.DateTime = time.civil_from_unix(0)
            t.year = y as i32
            t.month = mo as u32
            t.day = d as u32
            res = i18n.format_date(lang, t, style)
        }
        rt.buf_push_bytes(&out, res.p as u64, res.n)
        rt.buf_push(&out, 10 as u8)
        i = e + 1
    }
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}
