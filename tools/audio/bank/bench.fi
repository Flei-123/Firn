// tools/audio/bank/bench.fi -- cost of engine_render per 128 frame block with N looping voices (no device).
import std.rt
import std.io
import std.time
import audio.engine

fn run(nv: u32) {
    var e: engine.Engine = engine.engine_new(48000 as u32, 128 as u32)
    let n: usize = 48000
    let p: u64 = rt.heap_alloc(n * 4)
    var i: usize = 0
    while i < n {
        *((p + (i * 4) as u64) as *mut f32) = 0.01
        i = i + 1
    }
    let s: i32 = engine.engine_add_sample(&e, p, n as u64, 1 as u32)
    let ev: i32 = engine.engine_add_event(&e, "t", 0)
    engine.engine_event_add_sample(&e, ev, s)
    (*engine.engine_event(&e, ev)).looping = true
    (*engine.engine_event(&e, ev)).spatial = true
    var k: u32 = 0 as u32
    while k < nv {
        engine.engine_play_3d(&e, ev, -1, 3.0, 0.0, 0.0 - 4.0)
        k = k + 1 as u32
    }
    let out: u64 = rt.heap_alloc(128 * 8)
    engine.engine_render(&e, out, 128)
    let blocks: u64 = 3000
    let t0: u64 = time.monotonic_ns()
    var b: u64 = 0
    while b < blocks {
        engine.engine_render(&e, out, 128)
        b = b + 1
    }
    let dt: u64 = time.monotonic_ns() - t0
    let per: u64 = dt / blocks
    io.fmt_print(f"voices={nv} ns/block={per} (budget 2666666 ns at 48 kHz)\n")
    engine.engine_free(&e)
}

fn main(start: u64) -> i32 {
    run(0 as u32)
    run(8 as u32)
    run(32 as u32)
    run(64 as u32)
    return 0
}
