// SPDX-License-Identifier: MPL-2.0
// tools/audio/wasapi/main.fi -- audio.wasapi probe (Windows target). Under Wine (tools/audio/wasapi/run.sh) or on a PC.
//
//   main <seconds> <block frames>      plays the test pattern of tools/desktop/sink_main.fi
//                                      (frame n = low16(7n + 1000), complement) at 44.1 kHz stereo
// Prints "KEY value" lines: LIST <count>, one DEV line per endpoint, OPEN <step> <hresult>, BUF <frames>,
// LAT <us>, WRITTEN <frames>, DRAINED <0|1>, then "WASAPI OK" and exits 0; exit 1 = no device, 2 = write failed.
import std.rt
import std.io
import std.str
import audio.wasapi

fn arg(start: u64, i: usize) -> str {
    let p: u64 = rt.arg_ptr(start, i)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn parse(s: str) -> usize {
    var v: usize = 0
    var i: usize = 0
    while i < s.length() {
        v = v * 10 + (s.chars(i) - 48 as u8) as usize
        i = i + 1
    }
    return v
}

fn say(s: str) {
    syscall(1, 1, s.p as i64, s.length() as i64, 0, 0, 0)
}

fn num(v: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    io.print_bytes(rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn main(start: u64) -> i32 {
    let seconds: usize = parse(arg(start, 1))
    let block: usize = parse(arg(start, 2))
    var buf_ms: usize = parse(arg(start, 3))
    if buf_ms == 0 { buf_ms = 40 }
    var names: rt.Buf = rt.buf_new()
    let n: i32 = wasapi.wasapi_list(&names)
    say("LIST ")
    num(n as i64)
    say("\n")
    if rt.buf_len(&names) > 0 {
        say("DEV ")
        io.print_bytes(rt.buf_ptr(&names), rt.buf_len(&names))
    }
    var w: wasapi.Wasapi = wasapi.wasapi_open("Firn wasapi probe", 44100 as u32, 2 as u32, buf_ms as u32)
    say("OPEN ")
    num(wasapi.wasapi_error_step(&w) as i64)
    say(" ")
    num(wasapi.wasapi_hresult(&w) as i64)
    say("\n")
    if !wasapi.wasapi_is_open(&w) {
        say("NOSINK\n")
        return 1
    }
    say("BUF ")
    num(wasapi.wasapi_buffer_frames(&w) as i64)
    say("\n")
    let total: usize = seconds * 44100
    var buf: rt.Buf = rt.buf_new()
    rt.buf_reserve(&buf, block * 4)
    var done: usize = 0
    var lat: i64 = -1
    while done < total {
        var k: usize = block
        if k > total - done {
            k = total - done
        }
        rt.buf_clear(&buf)
        var i: usize = 0
        while i < k {
            let l: u32 = (((done + i) * 7 + 1000) & 65535) as u32
            let r: u32 = l ^ 65535 as u32
            rt.buf_push(&buf, (l & 255 as u32) as u8)
            rt.buf_push(&buf, (l >> 8) as u8)
            rt.buf_push(&buf, (r & 255 as u32) as u8)
            rt.buf_push(&buf, (r >> 8) as u8)
            i = i + 1
        }
        if !wasapi.wasapi_write(&w, rt.buf_ptr(&buf), k) {
            say("WRITEFAIL ")
            num(wasapi.wasapi_hresult(&w) as i64)
            say("\n")
            return 2
        }
        done = done + k
        if lat < 0 {
            lat = wasapi.wasapi_latency_us(&w)
        }
    }
    say("LAT ")
    num(lat)
    say("\nWRITTEN ")
    num(done as i64)
    say("\nDRAINED ")
    if wasapi.wasapi_drain(&w) {
        say("1\n")
    } else {
        say("0\n")
    }
    wasapi.wasapi_close(&w)
    say("WASAPI OK\n")
    return 0
}
