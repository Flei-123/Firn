// SPDX-License-Identifier: MPL-2.0
// tools/oauth/oauth_main.fi -- lib/auth/oauth.fi as a program, driven line by
// line over standard input/output by tools/oauth/check.py (which also plays
// the browser: it reads `OPEN <url>` and visits the URL).
//
// Every command is answered by lines ending in a line with a single dot.
//   CFG <key> <rest of line>   client_id secret scope issuer auth token device
//                              jwks userinfo revoke basic redirect_host port
//                              extra_auth extra_token timeout verify leeway
//   DISCOVER <issuer url>      LOGIN <timeout ms>      DEVICE      DEVICE_START
//   DEVICE_POLL                AUTHURL                 PASTE <url> REFRESH
//   FRESH <skew s>             VERIFY [nonce]          USERINFO    REVOKE a|r
//   SAVE|LOAD|DEL <svc> <key>  CLEAR                   TOKENS      JSON
//   CANCELIN <ms>              PKCE <verifier>         PCT <text>  PCTD <text>
//   QUIT
// Answers: `RESULT <n> <name> http=<s> net=<e> err=<code> desc=<text>` and
// `TOKENS ok=.. access=.. refresh=.. id=<len> scope=.. exp=<s from now>`.
import std.rt
import std.io
import std.str
import std.time
import std.json
import auth.oauth

const KIND_CANCEL: u64 = 5151

static mut CANCEL_FLAG: u64 = 0
static mut CANCEL_MS: u64 = 0

fn __thread_work(kind: u64, arg: u64) -> u64 {
    if kind == KIND_CANCEL {
        time.sleep_ms(CANCEL_MS)
        CANCEL_FLAG = 1
    }
    return 0
}

fn out_str(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.length())
}

fn opener(u: str) -> bool {
    var b: rt.Buf = rt.buf_new()
    out_str(&b, "OPEN ")
    out_str(&b, u)
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(1, b.ptr, b.len)
    rt.buf_free(&b)
    return true
}

// one line from standard input (without the newline); false at the end
fn read_line(b: *mut rt.Buf) -> bool {
    rt.buf_clear(b)
    var ch: [u8; 1] = [0; 1]
    while true {
        let r: i64 = syscall(0, 0, (&ch[0]) as i64, 1, 0, 0, 0)
        if r <= 0 {
            return (*b).len > 0
        }
        if ch[0] == 10 as u8 {
            return true
        }
        if ch[0] != 13 as u8 {
            rt.buf_push(b, ch[0])
        }
    }
    return false
}

fn first_word(p: u64, n: usize, e: *mut usize) -> usize {
    var k: usize = 0
    while k < n && rt.ld8(p, k) != 32 as u8 {
        k = k + 1
    }
    *e = k
    var s: usize = k
    while s < n && rt.ld8(p, s) == 32 as u8 {
        s = s + 1
    }
    return s
}

fn view(p: u64, s: usize, e: usize) -> str {
    return str { p: rt.ptr_of(p + s as u64), n: e - s }
}

fn num(s: str) -> u64 {
    var v: u64 = 0
    var i: usize = 0
    while i < s.length() {
        v = v * 10 + (s.chars(i) - 48 as u8) as u64
        i = i + 1
    }
    return v
}

fn result(out: *mut rt.Buf, o: *mut oauth.OAuth, code: i64) {
    out_str(out, "RESULT ")
    rt.buf_push_dec_u64(out, code as u64)
    rt.buf_push(out, 32 as u8)
    out_str(out, oauth.oauth_error_text(code))
    out_str(out, " http=")
    rt.buf_push_dec_u64(out, oauth.oauth_last_status(o) as u64)
    out_str(out, " net=")
    rt.buf_push_dec_u64(out, oauth.oauth_net_error(o) as u64)
    out_str(out, " err=")
    out_str(out, oauth.oauth_err_code(o))
    out_str(out, " desc=")
    out_str(out, oauth.oauth_err_desc(o))
    rt.buf_push(out, 10 as u8)
}

fn tokens_line(out: *mut rt.Buf, t: *mut oauth.Tokens) {
    out_str(out, "TOKENS ok=")
    if (*t).ok { out_str(out, "1") } else { out_str(out, "0") }
    out_str(out, " access=")
    out_str(out, (*t).access)
    out_str(out, " refresh=")
    out_str(out, (*t).refresh)
    out_str(out, " id=")
    rt.buf_push_dec_u64(out, (*t).id_token.length() as u64)
    out_str(out, " scope=")
    out_str(out, (*t).scope)
    out_str(out, " exp=")
    rt.buf_push_dec_i64(out, oauth.tokens_expires_in(t))
    rt.buf_push(out, 10 as u8)
}

#[allow_escape]
fn main() -> i32 {
    var o: oauth.OAuth = oauth.oauth_new("test-client")
    oauth.oauth_init(&o)
    oauth.oauth_set_opener(&o, opener)
    oauth.oauth_set_cancel(&o, (&CANCEL_FLAG) as u64)
    var tok: oauth.Tokens = oauth.tokens_new()
    var da: oauth.DeviceAuth = oauth.deviceauth_new()
    var pk: oauth.Pkce = oauth.Pkce { verifier: "", challenge: "", state: "", nonce: "" }
    var paste_redirect: str = ""
    var line: rt.Buf = rt.buf_new()
    var out: rt.Buf = rt.buf_new()
    while read_line(&line) {
        let p: u64 = line.ptr
        let n: usize = line.len
        var ce: usize = 0
        let rs: usize = first_word(p, n, &ce)
        let cmd: str = view(p, 0, ce)
        let rest: str = view(p, rs, n)
        if cmd == "QUIT" {
            break
        } else if cmd == "CFG" {
            var ke: usize = 0
            let vs: usize = first_word(p, n, &ke)
            // rest = "<key> <value...>"
            var k2: usize = 0
            let key_start: usize = rs
            var j: usize = rs
            while j < n && rt.ld8(p, j) != 32 as u8 {
                j = j + 1
            }
            k2 = j
            var vstart: usize = j
            while vstart < n && rt.ld8(p, vstart) == 32 as u8 {
                vstart = vstart + 1
            }
            let key: str = view(p, key_start, k2)
            let val: str = __str_copy(view(p, vstart, n))
            if key == "client_id" { o.client_id = val }
            else if key == "secret" { oauth.oauth_set_secret(&o, val) }
            else if key == "scope" { oauth.oauth_set_scope(&o, val) }
            else if key == "issuer" { oauth.oauth_set_issuer(&o, val) }
            else if key == "auth" { o.auth_url = val }
            else if key == "token" { o.token_url = val }
            else if key == "device" { o.device_url = val }
            else if key == "jwks" { o.jwks_url = val }
            else if key == "userinfo" { oauth.oauth_set_userinfo(&o, val) }
            else if key == "revoke" { oauth.oauth_set_revocation(&o, val) }
            else if key == "basic" { oauth.oauth_set_basic_auth(&o, val == "1") }
            else if key == "redirect_host" { oauth.oauth_set_redirect_host(&o, val) }
            else if key == "port" { oauth.oauth_set_loopback_port(&o, num(val) as u16) }
            else if key == "extra_auth" { oauth.oauth_set_extra_auth(&o, val) }
            else if key == "extra_token" { oauth.oauth_set_extra_token(&o, val) }
            else if key == "timeout" { oauth.oauth_set_timeout(&o, num(val)) }
            else if key == "verify" { oauth.oauth_set_verify_id_token(&o, val == "1") }
            else if key == "leeway" { oauth.oauth_set_leeway(&o, num(val) as i64) }
        } else if cmd == "DISCOVER" {
            result(&out, &o, oauth.oauth_discover(&o, __str_copy(rest)))
        } else if cmd == "LOGIN" {
            tok = oauth.tokens_new()
            result(&out, &o, oauth.oauth_login_loopback(&o, &tok, num(rest)))
            tokens_line(&out, &tok)
        } else if cmd == "DEVICE_START" {
            let r: i64 = oauth.oauth_device_start(&o, &da)
            result(&out, &o, r)
            if r == oauth.OA_OK {
                out_str(&out, "DEVICE ")
                out_str(&out, da.user_code)
                out_str(&out, " ")
                out_str(&out, da.verification_uri)
                out_str(&out, " ")
                out_str(&out, da.verification_uri_complete)
                out_str(&out, " interval=")
                rt.buf_push_dec_i64(&out, da.interval)
                out_str(&out, " expires=")
                rt.buf_push_dec_i64(&out, da.expires_in)
                rt.buf_push(&out, 10 as u8)
            }
        } else if cmd == "DEVICE_POLL" {
            result(&out, &o, oauth.oauth_device_poll_once(&o, &da, &tok))
            tokens_line(&out, &tok)
            out_str(&out, "INTERVAL ")
            rt.buf_push_dec_i64(&out, da.interval)
            rt.buf_push(&out, 10 as u8)
        } else if cmd == "DEVICE" {
            tok = oauth.tokens_new()
            let r: i64 = oauth.oauth_device_start(&o, &da)
            if r != oauth.OA_OK {
                result(&out, &o, r)
            } else {
                out_str(&out, "DEVICE ")
                out_str(&out, da.user_code)
                out_str(&out, " ")
                out_str(&out, da.verification_uri)
                rt.buf_push(&out, 10 as u8)
                rt.write_everything(1, out.ptr, out.len)
                rt.buf_clear(&out)
                result(&out, &o, oauth.oauth_device_wait(&o, &da, &tok))
                out_str(&out, "INTERVAL ")
                rt.buf_push_dec_i64(&out, da.interval)
                rt.buf_push(&out, 10 as u8)
                tokens_line(&out, &tok)
            }
        } else if cmd == "AUTHURL" {
            paste_redirect = "http://127.0.0.1:9/cb"
            oauth.pkce_new(&pk)
            out_str(&out, "AUTHURL ")
            out_str(&out, oauth.oauth_auth_url(&o, &pk, paste_redirect))
            rt.buf_push(&out, 10 as u8)
        } else if cmd == "PASTE" {
            tok = oauth.tokens_new()
            result(&out, &o, oauth.oauth_complete_redirect(&o, &pk, paste_redirect, __str_copy(rest), &tok))
            tokens_line(&out, &tok)
        } else if cmd == "REFRESH" {
            result(&out, &o, oauth.oauth_refresh(&o, &tok))
            tokens_line(&out, &tok)
        } else if cmd == "FRESH" {
            result(&out, &o, oauth.oauth_ensure_fresh(&o, &tok, num(rest) as i64))
            tokens_line(&out, &tok)
        } else if cmd == "VERIFY" {
            result(&out, &o, oauth.oauth_verify_id_token(&o, &tok, __str_copy(rest)))
        } else if cmd == "USERINFO" {
            var ub: rt.Buf = rt.buf_new()
            result(&out, &o, oauth.oauth_userinfo(&o, &tok, &ub))
            out_str(&out, "USERINFO ")
            rt.buf_push_bytes(&out, ub.ptr, ub.len)
            rt.buf_push(&out, 10 as u8)
            rt.buf_free(&ub)
        } else if cmd == "REVOKE" {
            result(&out, &o, oauth.oauth_revoke(&o, &tok, rest == "r"))
        } else if cmd == "SAVE" || cmd == "LOAD" || cmd == "DEL" {
            var se: usize = 0
            let ks: usize = first_word(p, n, &se)
            // rest = "<svc> <key>"
            var sp: usize = rs
            while sp < n && rt.ld8(p, sp) != 32 as u8 {
                sp = sp + 1
            }
            var ks2: usize = sp
            while ks2 < n && rt.ld8(p, ks2) == 32 as u8 {
                ks2 = ks2 + 1
            }
            let svc: str = __str_copy(view(p, rs, sp))
            let key: str = __str_copy(view(p, ks2, n))
            var ok: bool = false
            if cmd == "SAVE" { ok = oauth.tokens_save(svc, key, &tok) }
            else if cmd == "LOAD" { tok = oauth.tokens_new(); ok = oauth.tokens_load(svc, key, &tok) }
            else { ok = oauth.tokens_delete(svc, key) }
            out_str(&out, "STORE ")
            if ok { out_str(&out, "1") } else { out_str(&out, "0") }
            rt.buf_push(&out, 10 as u8)
            tokens_line(&out, &tok)
        } else if cmd == "CLEAR" {
            tok = oauth.tokens_new()
        } else if cmd == "TOKENS" {
            tokens_line(&out, &tok)
        } else if cmd == "JSON" {
            out_str(&out, "JSON ")
            oauth.tokens_to_json(&tok, &out)
            rt.buf_push(&out, 10 as u8)
        } else if cmd == "CANCELIN" {
            CANCEL_FLAG = 0
            CANCEL_MS = num(rest)
            thread_start(KIND_CANCEL, 0)
        } else if cmd == "PKCE" {
            out_str(&out, "CHALLENGE ")
            out_str(&out, oauth.pkce_challenge_of(__str_copy(rest)))
            rt.buf_push(&out, 10 as u8)
        } else if cmd == "PCT" {
            out_str(&out, "PCT ")
            oauth.pct_encode(rest.p as u64, rest.length(), &out)
            rt.buf_push(&out, 10 as u8)
        } else if cmd == "PCTD" {
            out_str(&out, "PCTD ")
            var db: rt.Buf = rt.buf_new()
            if oauth.pct_decode(rest.p as u64, rest.length(), true, &db) {
                rt.buf_push_bytes(&out, db.ptr, db.len)
            } else {
                out_str(&out, "<error>")
            }
            rt.buf_free(&db)
            rt.buf_push(&out, 10 as u8)
        }
        out_str(&out, ".\n")
        rt.write_everything(1, out.ptr, out.len)
        rt.buf_clear(&out)
    }
    oauth.oauth_free(&o)
    return 0 as i32
}
