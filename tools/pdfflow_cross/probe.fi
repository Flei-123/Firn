// Probe for tools/pdfflow_cross/check.py: in.txt = first line "P" (paragraph) or "T" (table, rows split
// at ';', cells at ','), then the content; writes out.pdf and prints the page count.
import std.io
import std.fs
import std.rt
import std.text
import pdf.pdfflow

fn main() -> i32 {
    var font: rt.Buf = rt.buf_new()
    var inp: rt.Buf = rt.buf_new()
    fs.read_file("tests/data/fonts/FirnSans.ttf", &font) catch 0
    fs.read_file("in.txt", &inp) catch 0
    let all: str = str { p: rt.buf_ptr(&inp) as *mut u8, n: rt.buf_len(&inp) }
    let mode: str = text.field(all, "\n", 0)
    let body: str = str { p: all.p + mode.n + 1, n: all.n - mode.n - 1 }
    var out: rt.Buf = rt.buf_new()
    var fl: pdfflow.Flow = pdfflow.flow_new(&out, rt.buf_ptr(&font), rt.buf_len(&font), "cross")
    if *mode.p == 80 as u8 {
        pdfflow.paragraph(&fl, body)
    } else {
        pdfflow.table(&fl, body, ";", ",", true)
    }
    pdfflow.finish(&fl)
    fs.write_file("out.pdf", rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    io.fmt_print_line(f"pages {pdfflow.page_count(&fl)}")
    return 0
}
