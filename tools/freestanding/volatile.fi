// tools/freestanding/volatile.fi -- the volatile promise, counted exactly.
//
// Round 52. Everything is in ONE function and calls nothing: that way
// inlining (`inline.rs`) does not shift the numbers, and the expectation
// is the same in all three build stages.
//
// `pause` instead of `cli`: unprivileged, so that the program can REALLY
// run (`cli` in ring 3 is a protection fault). Counted in the
// FIR after the optimiser (`--emit=fir`) -- there it is in black and white what
// the optimiser has left standing:
//
//   3x  asm.void "pause"        three literally equal blocks, no CSE
//   1x  asm.u64 "rdtsc"         result unused (the trap from round 40)
//   1x  mmio_store.u32
//   2x  mmio_load.u32           two loads on THE SAME address
fn main() -> i32 {
    var b: [u32; 2] = [0 as u32, 0 as u32]
    let p: *mut u32 = (&b[0]) as *mut u32
    asm("pause")
    asm("pause")
    asm("pause")
    __mmio_write32(p, 3 as u32)
    let x: u32 = __mmio_read32(p)
    let y: u32 = __mmio_read32(p)
    let _t: u64 = asm("rdtsc", out("rax"), clobber("rdx"))
    return (x + y) as i32
}
