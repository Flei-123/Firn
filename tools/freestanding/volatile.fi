// tools/freestanding/volatile.fi — die volatile-Zusage, exakt gezaehlt.
//
// Runde 52. Alles steht in EINER Funktion und ruft nichts auf: dadurch
// verschiebt das Einbetten (`inline.rs`) die Zahlen nicht, und die Erwartung
// ist in allen drei Baustufen dieselbe.
//
// `pause` statt `cli`: unprivilegiert, damit das Programm auch WIRKLICH
// laufen kann (`cli` in Ring 3 ist ein Schutzfehler). Gezaehlt wird in der
// FIR nach dem Optimierer (`--emit=fir`) — dort steht schwarz auf weiss, was
// der Optimierer stehen gelassen hat:
//
//   3x  asm.void "pause"        drei woertlich gleiche Bloecke, kein CSE
//   1x  asm.u64 "rdtsc"         Ergebnis unbenutzt (Falle aus Runde 40)
//   1x  mmio_store.u32
//   2x  mmio_load.u32           zwei Lasten auf DIESELBE Adresse
fn main() -> i32 {
    var b: [u32; 2] = [0 as u32, 0 as u32]
    let p: *mut u32 = (&b[0]) as *mut u32
    asm("pause")
    asm("pause")
    asm("pause")
    __mmio_write32(p, 3 as u32)
    let x: u32 = __mmio_read32(p)
    let y: u32 = __mmio_read32(p)
    let _t: u64 = asm("rdtsc", out("rax"), clobber("rdx"))
    return (x + y) as i32
}
