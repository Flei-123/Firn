fn main() -> i32 {
    var b: [u64; 4] = [0 as u64, 0 as u64, 0 as u64, 0 as u64]
    let p64: *mut u64 = (&b[0]) as *mut u64
    let p32: *mut u32 = (&b[1]) as *mut u32
    let p16: *mut u16 = (&b[2]) as *mut u16
    let p8: *mut u8 = (&b[3]) as *mut u8
    __mmio_write32(p32, 5 as u32)
    __mmio_write32(p32, 5 as u32)
    let x: u32 = __mmio_read32(p32)
    let y: u32 = __mmio_read32(p32)
    let _u: u32 = __mmio_read32(p32)
    __mmio_write8(p8, 2 as u8)
    let c: u8 = __mmio_read8(p8)
    __mmio_write16(p16, 3 as u16)
    let d: u16 = __mmio_read16(p16)
    __mmio_write64(p64, 4 as u64)
    let e: u64 = __mmio_read64(p64)
    return (x + y + (c as u32) + (d as u32) + (e as u32)) as i32
}
