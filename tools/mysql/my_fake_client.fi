import std.rt
import std.io
import mysql.mysql
import mysql.myrows

fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    if !io.read_stdin(&inb) { return 2 }
    var port: u16 = 0
    var i: usize = 0
    while i < inb.len {
        let d: u8 = rt.ld8(inb.ptr, i)
        if d >= 48 as u8 && d <= 57 as u8 { port = port * 10 + ((d - 48 as u8) as u16) }
        i = i + 1
    }
    var c: mysql.My = mysql.my_new()
    if !mysql.my_connect(&c, 2130706433 as u32, port, "u", "s3cret", "", mysql.TLS_OFF, "x", 0, 0, 0) { return 3 }
    var r: myrows.MyResult = myrows.result_new()
    let a: bool = mysql.my_query(&c, "SELECT 1", &r)
    var np: usize = 0
    let id: i64 = mysql.my_prepare(&c, "SELECT ?", &np)
    var q: myrows.MyParams = myrows.params_new()
    myrows.params_text(&q, "1".p as u64, 1)
    if id > 0 {
        let b: bool = mysql.my_exec_stmt(&c, id as u32, &q, &r)
    }
    var row: usize = 0
    var p: u64 = 0
    var n: usize = 0
    while row < myrows.result_nrows(&r) {
        var col: usize = 0
        while col < myrows.result_ncols(&r) {
            let v: bool = myrows.result_value(&r, row, col, &p, &n)
            col = col + 1
        }
        row = row + 1
    }
    myrows.params_free(&q)
    myrows.result_free(&r)
    mysql.my_free(&c)
    if !a { return 1 }
    return 0
}
