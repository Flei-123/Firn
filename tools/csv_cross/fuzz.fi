// tools/csv_cross/fuzz.fi -- a fuzz run for the CSV parser (lib/std/csv.fi).
//
//     fuzz <iterations> <seed> <work dir>
//
// Build it with --opt-level=release-safe: every index and every arithmetic
// operation is then checked, so an out-of-range access is a crash and not a
// quiet wrong answer.
//
// Per iteration, with a random dialect (delimiter, quote, doublequote,
// strict) and one of three kinds of input:
//   A  random bytes from a small hostile alphabet (delimiter, quote, CR, LF, letters, 0, 0xFF)
//   B  a valid table written by csv.Writer and then damaged (bytes replaced, inserted, cut)
//   C  completely random bytes
// the input is parsed over memory and streamed from a file with a random read
// size (1 .. 100). It has to
//   1. end (the row count never exceeds the input length: a row eats a byte),
//   2. give the SAME rows, the same error code and the same error line both ways,
//   3. report an error row that is the number of rows delivered + 1.
// And per iteration a random table (hostile fields, empty rows, rows of one
// empty field) is written and read back: ROUND TRIP, row for row, field for field.
//
// At the end the resident memory is compared with the one after the first 10 %
// of the iterations: growth means a leak.
//
// Exit 0 = nothing wrong. A hang is the caller's `timeout`.
import std.rt
import std.str
import std.fs
import std.csv
import std.vec

static mut rng: u64 = 88172645463325252
static mut bad: i64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.length())
}

fn push(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.length())
}

fn rnd() -> u64 {
    var x: u64 = rng
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    rng = x
    return x
}

// 0 .. n-1 (n > 0)
fn below(n: u64) -> u64 {
    return (rnd() >> 11) % n
}

fn fail(what: str, iter: i64) {
    bad = bad + 1
    if bad <= 8 {
        var b: rt.Buf = rt.buf_new()
        push(&b, "  FAIL  ")
        push(&b, what)
        push(&b, " (iteration ")
        rt.buf_push_dec_i64(&b, iter)
        push(&b, ")\n")
        rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
        rt.buf_free(&b)
    }
}

// all rows as text: the field bytes, 0x01 between fields, 0x02 between rows;
// then the error code and line
fn dump(r: *mut csv.Reader, out: *mut rt.Buf, n: usize) -> bool {
    var rows: usize = 0
    while csv.next_row(r) {
        rows = rows + 1
        if rows > n + 1 {
            return false
        }
        var i: usize = 0
        while i < csv.field_count(r) {
            if i > 0 {
                rt.buf_push(out, 1 as u8)
            }
            let f: str = csv.field(r, i)
            rt.buf_push_bytes(out, f.p as u64, f.n)
            i = i + 1
        }
        rt.buf_push(out, 2 as u8)
    }
    rt.buf_push(out, csv.error_code(r) as u8)
    rt.buf_push_dec_u64(out, csv.error_line(r) as u64)
    if csv.error_code(r) != csv.E_NONE && csv.error_row(r) != rows + 1 {
        return false
    }
    return true
}

fn fuzz_byte(d: u8, q: u8) -> u8 {
    let k: u64 = below(12)
    if k == 0 || k == 1 { return d }
    if k == 2 || k == 3 { return q }
    if k == 4 { return 13 as u8 }
    if k == 5 { return 10 as u8 }
    if k == 6 { return 97 as u8 }
    if k == 7 { return 32 as u8 }
    if k == 8 { return 0 as u8 }
    if k == 9 { return 255 as u8 }
    if k == 10 { return 98 as u8 }
    return below(256) as u8
}

fn pick_delim() -> u8 {
    let k: u64 = below(6)
    if k < 3 { return 44 as u8 }
    if k == 3 { return 59 as u8 }
    if k == 4 { return 9 as u8 }
    return 97 as u8
}

fn pick_quote(d: u8) -> u8 {
    var q: u8 = 34 as u8
    let k: u64 = below(5)
    if k == 3 { q = 39 as u8 }
    if k == 4 { q = 98 as u8 }
    if q == d {
        q = 96 as u8
    }
    return q
}

fn random_field(d: u8, q: u8, out: *mut rt.Buf) {
    let n: u64 = below(7)
    var i: u64 = 0
    while i < n {
        rt.buf_push(out, fuzz_byte(d, q))
        i = i + 1
    }
}

fn rss_kib() -> i64 {
    var b: rt.Buf = rt.buf_new()
    fs.read_file("/proc/self/status", &b) catch 0
    var found: i64 = -1
    let n: usize = rt.buf_len(&b)
    let p: *mut u8 = rt.buf_data(&b)
    var i: usize = 0
    while i + 6 < n {
        if *(p + i) == 86 as u8 && *(p + i + 1) == 109 as u8 && *(p + i + 2) == 82 as u8 && *(p + i + 3) == 83 as u8 && *(p + i + 4) == 83 as u8 {
            var j: usize = i + 5
            while j < n && (*(p + j) < 48 as u8 || *(p + j) > 57 as u8) {
                j = j + 1
            }
            var v: i64 = 0
            while j < n && *(p + j) >= 48 as u8 && *(p + j) <= 57 as u8 {
                v = v * 10 + (*(p + j) - 48 as u8) as i64
                j = j + 1
            }
            found = v
            break
        }
        i = i + 1
    }
    rt.buf_free(&b)
    return found
}

fn one_parse(iter: i64, work: str) {
    let d: u8 = pick_delim()
    let q: u8 = pick_quote(d)
    let dq: bool = below(5) != 0
    let strict: bool = below(2) == 0
    var input: rt.Buf = rt.buf_new()
    let kind: u64 = below(3)
    if kind == 0 {
        let n: u64 = below(60)
        var i: u64 = 0
        while i < n {
            rt.buf_push(&input, fuzz_byte(d, q))
            i = i + 1
        }
    } else if kind == 1 {
        var w: csv.Writer = csv.writer(&input)
        csv.set_writer_delimiter(&w, d)
        csv.set_writer_quote(&w, q)
        var rows: u64 = below(6)
        while rows > 0 {
            var cols: u64 = below(5)
            while cols > 0 {
                var f: rt.Buf = rt.buf_new()
                random_field(d, q, &f)
                csv.put_bytes(&w, rt.buf_data(&f), rt.buf_len(&f))
                rt.buf_free(&f)
                cols = cols - 1
            }
            csv.end_row(&w)
            rows = rows - 1
        }
        // damage
        var dmg: u64 = below(4)
        while dmg > 0 && rt.buf_len(&input) > 0 {
            let at: usize = below(rt.buf_len(&input) as u64) as usize
            let p: *mut u8 = rt.buf_data(&input)
            *(p + at) = fuzz_byte(d, q)
            dmg = dmg - 1
        }
        if below(4) == 0 && rt.buf_len(&input) > 0 {
            rt.buf_set_len(&input, below(rt.buf_len(&input) as u64) as usize)
        }
    } else {
        let n: u64 = below(200)
        var i: u64 = 0
        while i < n {
            rt.buf_push(&input, below(256) as u8)
            i = i + 1
        }
    }
    let n: usize = rt.buf_len(&input)

    var a: rt.Buf = rt.buf_new()
    var r: csv.Reader = csv.reader(rt.buf_data(&input), n)
    csv.set_delimiter(&r, d)
    csv.set_quote(&r, q)
    csv.set_doublequote(&r, dq)
    csv.set_strict(&r, strict)
    if !dump(&r, &a, n) {
        fail("memory reader: too many rows or a wrong error row", iter)
    }
    csv.reader_free(&r)

    var path: rt.Buf = rt.buf_new()
    push(&path, work)
    push(&path, "/fuzz.csv")
    let ps: str = str { p: rt.buf_data(&path), n: rt.buf_len(&path) }
    fs.write_file(ps, rt.buf_ptr(&input), n) catch 0
    let fd: i64 = fs.open_read(ps) catch -1
    if fd >= 0 {
        var s: csv.Reader = csv.reader_fd_sized(fd, 1 + below(100) as usize)
        csv.set_delimiter(&s, d)
        csv.set_quote(&s, q)
        csv.set_doublequote(&s, dq)
        csv.set_strict(&s, strict)
        var b: rt.Buf = rt.buf_new()
        if !dump(&s, &b, n) {
            fail("stream reader: too many rows or a wrong error row", iter)
        }
        csv.reader_free(&s)
        if rt.buf_len(&a) != rt.buf_len(&b) || !rt.mem_eq(rt.buf_ptr(&a), rt.buf_ptr(&b), rt.buf_len(&a)) {
            fail("memory and stream disagree", iter)
        }
        rt.buf_free(&b)
        fs.close_fd(fd)
    } else {
        fail("cannot open the temp file", iter)
    }
    rt.buf_free(&path)
    rt.buf_free(&a)
    rt.buf_free(&input)
}

// A random table written with a random dialect and read back.
fn one_round_trip(iter: i64) {
    let d: u8 = pick_delim()
    let q: u8 = pick_quote(d)
    var out: rt.Buf = rt.buf_new()
    var w: csv.Writer = csv.writer(&out)
    csv.set_writer_delimiter(&w, d)
    csv.set_writer_quote(&w, q)
    // the table as the reader should return it: same dump format as `dump`
    var want: rt.Buf = rt.buf_new()
    var rows: u64 = below(8)
    while rows > 0 {
        var cols: u64 = below(5)
        var first: bool = true
        while cols > 0 {
            var f: rt.Buf = rt.buf_new()
            random_field(d, q, &f)
            csv.put_bytes(&w, rt.buf_data(&f), rt.buf_len(&f))
            if !first {
                rt.buf_push(&want, 1 as u8)
            }
            first = false
            rt.buf_push_bytes(&want, rt.buf_ptr(&f), rt.buf_len(&f))
            rt.buf_free(&f)
            cols = cols - 1
        }
        csv.end_row(&w)
        rt.buf_push(&want, 2 as u8)
        rows = rows - 1
    }
    rt.buf_push(&want, 0 as u8)
    rt.buf_push_dec_u64(&want, 0)
    var got: rt.Buf = rt.buf_new()
    var r: csv.Reader = csv.reader(rt.buf_data(&out), rt.buf_len(&out))
    csv.set_delimiter(&r, d)
    csv.set_quote(&r, q)
    dump(&r, &got, rt.buf_len(&out))
    csv.reader_free(&r)
    if rt.buf_len(&got) != rt.buf_len(&want) || !rt.mem_eq(rt.buf_ptr(&got), rt.buf_ptr(&want), rt.buf_len(&got)) {
        fail("round trip", iter)
    }
    rt.buf_free(&got)
    rt.buf_free(&want)
    rt.buf_free(&out)
}

fn number(a: u64) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    let n: usize = rt.c_length(a)
    while i < n {
        v = v * 10 + (rt.ld8(a, i) - 48 as u8) as i64
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 4 {
        say("usage: fuzz <iterations> <seed> <work dir>\n")
        return 2
    }
    let iters: i64 = number(rt.arg_ptr(start, 1))
    rng = rng ^ (((number(rt.arg_ptr(start, 2)) as u64) *% 2685821657736338717) +% 1)
    let a3: u64 = rt.arg_ptr(start, 3)
    let work: str = str { p: a3 as *mut u8, n: rt.c_length(a3) }
    var i: i64 = 0
    var base: i64 = 0
    while i < iters {
        one_parse(i, work)
        one_round_trip(i)
        i = i + 1
        if i == iters / 10 + 1 {
            base = rss_kib()
        }
    }
    let end: i64 = rss_kib()
    var o: rt.Buf = rt.buf_new()
    push(&o, "csv fuzz: ")
    rt.buf_push_dec_i64(&o, iters)
    push(&o, " iterations (each: 1 parse over memory, 1 streamed, 1 round trip), ")
    rt.buf_push_dec_i64(&o, bad)
    push(&o, " failures, memory ")
    rt.buf_push_dec_i64(&o, base)
    push(&o, " -> ")
    rt.buf_push_dec_i64(&o, end)
    push(&o, " KiB\n")
    rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o))
    rt.buf_free(&o)
    if base > 0 && end > base + 8192 {
        say("  FAIL  memory grew by more than 8 MiB: a leak\n")
        return 1
    }
    if bad != 0 {
        return 1
    }
    return 0
}
