// TEMPLATE, not compilable on its own: WINDOW is replaced by a number.
// probe: how many octets of the real UnicodeData.txt fit into ONE comptime
// block (MAX_STEPS = 2,000,000, compiler/src/comptime.rs:47)?
comptime {
    let n: i64 = file_size("UnicodeData.txt")
    var i: i64 = 0
    var lines: i64 = 0
    var last_cp: i64 = 0
    var last_cat: i64 = 0
    while i < n {
        if i >= WINDOW { break }
        // field 0: the code point, hexadecimal
        var cp: i64 = 0
        var digits: i64 = 0
        while i < n {
            let c: i64 = file_byte("UnicodeData.txt", i)
            var d: i64 = 0 - 1
            if c >= 48 { if c <= 57 { d = c - 48 } }
            if c >= 65 { if c <= 70 { d = c - 55 } }
            if c >= 97 { if c <= 102 { d = c - 87 } }
            if d < 0 { break }
            cp = cp * 16 + d
            digits = digits + 1
            i = i + 1
        }
        // over the ';' into field 1 (the name)
        i = i + 1
        while i < n {
            if file_byte("UnicodeData.txt", i) == 59 { break }
            i = i + 1
        }
        i = i + 1
        // field 2: the general category, two letters
        let a: i64 = file_byte("UnicodeData.txt", i)
        let b: i64 = file_byte("UnicodeData.txt", i + 1)
        let cat: i64 = a * 256 + b
        // rest of the line
        while i < n {
            if file_byte("UnicodeData.txt", i) == 10 { break }
            i = i + 1
        }
        i = i + 1
        if digits > 0 {
            lines = lines + 1
            last_cp = cp
            last_cat = cat
        }
    }
    emit_raw("const PROBE_LINES: i64 = ")
    emit_number(lines)
    emit_raw("\nconst PROBE_OFFSET: i64 = ")
    emit_number(i)
    emit_raw("\nconst PROBE_LAST_CP: i64 = ")
    emit_number(last_cp)
    emit_raw("\nconst PROBE_LAST_CAT: i64 = ")
    emit_number(last_cat)
    emit_raw("\n")
}

fn main() -> i32 {
    if PROBE_LINES < 1 { return 1 }
    return 0
}
