// SPDX-License-Identifier: GPL-2.0-only
// tools/ucd/bench_tables.fi -- SIZE AND LOOKUP TIME, measured.
//
// Two shapes for the same question ("is this code point ID_Start?"):
//
//   FLAT      `lib/js/flat_baseline.fi`, generated by a Python script out of
//             generated by a Python script out of the `unicodedata`
//             module of the Python that ran it (Unicode 14.0.0): 647 + 754
//             ranges, pushed into a `mem.CpBuf` at start up and searched
//             with a binary search. That is what the JavaScript lexer did
//             until this round.
//   THREE     `generated/unicode_tables.fi` (Unicode 17.0.0), built by
//   STAGE     `bash tools/ucd/build.sh` out of the UCD: three loads, no
//             loop -- and the same table also answers the general category
//             and the two case mappings.
//
// Both are asked the same code points in the same order. Two
// distributions, because the answer differs:
//
//   latin   0x80 .. 0x24F -- what a lexer really meets in a source text
//           with non-ASCII identifiers; the binary search stays in the
//           first few, hot entries here.
//   wide    0 .. 0x10FFFF uniformly -- the whole code space, so the binary
//           search touches cold cache lines.
//
// The set up is measured too: filling the `CpBuf` (2,802 pushes with
// growth) against `mmap` plus writing the table.
//
// Usage:  ./bench_tables
import str.ucd
import flat_baseline
import html.mem
import rt.rt

const SYS_CLOCK_GETTIME: i64 = 228
const CLOCK_MONOTONIC: i64 = 1
const ROUNDS: u64 = 20000000

fn now_ns() -> u64 {
    var ts: [u64; 2] = [0; 2]
    let p: u64 = (&ts) as u64
    syscall(SYS_CLOCK_GETTIME, CLOCK_MONOTONIC, p as i64, 0, 0, 0, 0)
    return ts[0] * 1000000000 + ts[1]
}

fn next_random(s: u64) -> u64 {
    var x: u64 = s
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    return x
}

// The binary search of lib/js/lex.fi, character for character.
fn in_ranges(tab: *mut mem.CpBuf, count: usize, c: u32) -> bool {
    var lo: usize = 0
    var hi: usize = count
    while lo < hi {
        let mid: usize = (lo + hi) / 2
        let a: u32 = mem.cp_at(tab, mid * 2)
        let b: u32 = mem.cp_at(tab, mid * 2 + 1)
        if c < a {
            hi = mid
        } else if c > b {
            lo = mid + 1
        } else {
            return true
        }
    }
    return false
}

fn say(text: u64, n: usize, v: u64) {
    var o: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&o, text, n)
    rt.buf_push_dec_u64(&o, v)
    rt.buf_push(&o, 10 as u8)
    let ok: bool = rt.write_everything(1, o.ptr, o.len)
    rt.buf_free(&o)
}

fn say2(text: u64, n: usize, a: u64, b: u64) {
    var o: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&o, text, n)
    rt.buf_push_dec_u64(&o, a)
    rt.buf_push(&o, 32 as u8)
    rt.buf_push_dec_u64(&o, b)
    rt.buf_push(&o, 10 as u8)
    let ok: bool = rt.write_everything(1, o.ptr, o.len)
    rt.buf_free(&o)
}

fn main() -> i32 {
    // ------------------------------------------------------- the set up
    let t0: u64 = now_ns()
    var flat: mem.CpBuf = mem.cp_new()
    mem.cp_init(&flat)
    flat_baseline.id_start_fill(&flat)
    var flatc: mem.CpBuf = mem.cp_new()
    mem.cp_init(&flatc)
    flat_baseline.id_continue_fill(&flatc)
    let t1: u64 = now_ns()
    let table: u64 = ucd.ucd_map()
    let t2: u64 = now_ns()
    if table == 0 {
        return 2
    }
    var l1: [u8; 24] = "setup_flat_ns           "
    say((&l1) as u64, 24, t1 - t0)
    var l2: [u8; 24] = "setup_table_ns          "
    say((&l2) as u64, 24, t2 - t1)
    var l3: [u8; 24] = "octets_flat             "
    say((&l3) as u64, 24,
        ((flat_baseline.ID_START_RANGES + flat_baseline.ID_CONTINUE_RANGES) * 2 * 4) as u64)
    var l4: [u8; 24] = "octets_table            "
    say((&l4) as u64, 24, ucd.ucd_bytes() as u64)

    // The loop overhead itself (the pseudo random number and the branch),
    // so that the numbers below can be read without it as well.
    var seed: u64 = 88172645463325252
    var idle: u64 = 0
    var k: u64 = 0
    let r0: u64 = now_ns()
    while k < ROUNDS {
        seed = next_random(seed)
        idle = idle + (seed % 0x110000)
        k = k + 1
    }
    let r1: u64 = now_ns()
    var l5: [u8; 24] = "loop_only_ps            "
    say((&l5) as u64, 24, (r1 - r0) * 1000 / ROUNDS)
    var l6: [u8; 24] = "loop_only_checksum      "
    say((&l6) as u64, 24, idle)

    // --------------------------------------------------- latin, the flat one
    seed = 88172645463325252
    var hits: u64 = 0
    var i: u64 = 0
    let a0: u64 = now_ns()
    while i < ROUNDS {
        seed = next_random(seed)
        let cp: u32 = (0x80 + seed % 0x1D0) as u32
        if in_ranges(&flat, flat_baseline.ID_START_RANGES, cp) {
            hits = hits + 1
        }
        i = i + 1
    }
    let a1: u64 = now_ns()
    var h2: u64 = 0
    seed = 88172645463325252
    i = 0
    let b0: u64 = now_ns()
    while i < ROUNDS {
        seed = next_random(seed)
        let cp: u32 = (0x80 + seed % 0x1D0) as u32
        if ucd.ucd_is_id_start(table, cp) {
            h2 = h2 + 1
        }
        i = i + 1
    }
    let b1: u64 = now_ns()
    var m1: [u8; 24] = "latin_flat_ps           "
    say((&m1) as u64, 24, (a1 - a0) * 1000 / ROUNDS)
    var m2: [u8; 24] = "latin_table_ps          "
    say((&m2) as u64, 24, (b1 - b0) * 1000 / ROUNDS)
    var m3: [u8; 24] = "latin_hits_flat_table   "
    say2((&m3) as u64, 24, hits, h2)

    // ---------------------------------------------------- wide, both of them
    seed = 88172645463325252
    var h3: u64 = 0
    i = 0
    let c0: u64 = now_ns()
    while i < ROUNDS {
        seed = next_random(seed)
        let cp: u32 = (seed % 0x110000) as u32
        if in_ranges(&flat, flat_baseline.ID_START_RANGES, cp) {
            h3 = h3 + 1
        }
        i = i + 1
    }
    let c1: u64 = now_ns()
    seed = 88172645463325252
    var h4: u64 = 0
    i = 0
    let d0: u64 = now_ns()
    while i < ROUNDS {
        seed = next_random(seed)
        let cp: u32 = (seed % 0x110000) as u32
        if ucd.ucd_is_id_start(table, cp) {
            h4 = h4 + 1
        }
        i = i + 1
    }
    let d1: u64 = now_ns()
    var n1: [u8; 24] = "wide_flat_ps            "
    say((&n1) as u64, 24, (c1 - c0) * 1000 / ROUNDS)
    var n2: [u8; 24] = "wide_table_ps           "
    say((&n2) as u64, 24, (d1 - d0) * 1000 / ROUNDS)
    var n3: [u8; 24] = "wide_hits_flat_table    "
    say2((&n3) as u64, 24, h3, h4)

    // ------------------------------- the case mapping, which the flat one
    // ------------------------------- cannot answer at all
    seed = 88172645463325252
    var h5: u64 = 0
    i = 0
    let e0: u64 = now_ns()
    while i < ROUNDS {
        seed = next_random(seed)
        let cp: u32 = (seed % 0x110000) as u32
        h5 = h5 + ucd.ucd_to_upper(table, cp) as u64
        i = i + 1
    }
    let e1: u64 = now_ns()
    var o1: [u8; 24] = "upper_table_ps          "
    say((&o1) as u64, 24, (e1 - e0) * 1000 / ROUNDS)
    var o2: [u8; 24] = "upper_checksum          "
    say((&o2) as u64, 24, h5)
    ucd.ucd_free(table)
    mem.cp_free(&flat)
    mem.cp_free(&flatc)
    return 0
}
