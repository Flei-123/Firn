// generated/bidi_tables.fi -- GENERATED. Do not edit by hand.
//
// Arises with `bash tools/ucd/build_bidi.sh`; the program
// `tools/ucd/pack_bidi.fi` reads five files of the Unicode
// Character Database for that and writes this file:
//
//   DerivedBidiClass.txt  @DBC_BYTES@ octets, sha256 @DBC_SHA@
//   BidiMirroring.txt     @MIR_BYTES@ octets, sha256 @MIR_SHA@
//   BidiBrackets.txt      @BRK_BYTES@ octets, sha256 @BRK_SHA@
//   ArabicShaping.txt     @ASH_BYTES@ octets, sha256 @ASH_SHA@
//   UnicodeData.txt       @UCD_BYTES@ octets, sha256 @UCD_SHA@
//   Unicode-Version       @UVER@
//
// The sums stand fixed in tools/ucd/UCD_BIDI.sha256 and
// tools/ucd/UCD.sha256; the build script compares them before it reads, and
// `build_bidi.sh --verify` builds the file a second time and compares
// octet for octet.
//
// THE FORM. Like `generated/unicode_tables.fi` three stages with
// merged blocks:
//
//   Stage 1   cp >> 9          2176 entries of one octet
//   Stage 2   (cp >> 4) & 31   32 entries of two octets per block
//   Stage 3   cp & 15          16 entries of one octet: THE OCTET
//
//   Bit 0..4   the bidi class: 0 L, 1 R, 2 AL, 3 EN, 4 ES, 5 ET, 6 AN,
//              7 CS, 8 NSM, 9 BN, 10 B, 11 S, 12 WS, 13 ON, 14 LRE,
//              15 LRO, 16 RLE, 17 RLO, 18 PDF, 19 LRI, 20 RLI, 21 FSI,
//              22 PDI
//   Bit 5..7   the joining type: 0 U, 1 R, 2 L, 3 D, 4 C, 5 T
//
// After that three sorted lists, described in lib/str/ucd_bidi.fi:
// mirror and bracket pairs (MIR_N of one u64 each), the Arabic
// presentation forms per base letter (FORM_N of two u64 each) and the
// two-letter ligatures (LIG_N of one u64 each).
//
// Stage 0 has no global fields, so the table is written at run time
// into a mapped, zeroed area -- only the words that are
// not zero.
export {
    BYTES, OFF_L1, OFF_L2, OFF_L3, OFF_MIR, OFF_FORM, OFF_LIG,
    L2_BLOCKS, L3_BLOCKS, MIR_N, FORM_N, LIG_N,
    load,
}

#[no_gc]
fn w(p: *mut u8, i: usize, v: u64) {
    *((p as usize + i * 8) as *mut u64) = v
}

