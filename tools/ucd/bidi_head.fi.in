// SPDX-License-Identifier: MPL-2.0
// generated/bidi_tables.fi -- ERZEUGT. Nicht von Hand aendern.
//
// Entsteht mit `bash tools/ucd/build_bidi.sh`; das Programm
// `tools/ucd/pack_bidi.fi` liest dafuer fuenf Dateien der Unicode
// Character Database und schreibt diese Datei:
//
//   DerivedBidiClass.txt  @DBC_BYTES@ Oktette, sha256 @DBC_SHA@
//   BidiMirroring.txt     @MIR_BYTES@ Oktette, sha256 @MIR_SHA@
//   BidiBrackets.txt      @BRK_BYTES@ Oktette, sha256 @BRK_SHA@
//   ArabicShaping.txt     @ASH_BYTES@ Oktette, sha256 @ASH_SHA@
//   UnicodeData.txt       @UCD_BYTES@ Oktette, sha256 @UCD_SHA@
//   Unicode-Version       @UVER@
//
// Die Summen stehen fest in tools/ucd/UCD_BIDI.sha256 und
// tools/ucd/UCD.sha256; das Bauskript vergleicht sie, bevor es liest, und
// `build_bidi.sh --verify` baut die Datei ein zweites Mal und vergleicht
// Oktett fuer Oktett.
//
// DIE FORM. Wie `generated/unicode_tables.fi` drei Stufen mit
// zusammengelegten Bloecken:
//
//   Stufe 1   cp >> 9          2176 Eintraege zu einem Oktett
//   Stufe 2   (cp >> 4) & 31   32 Eintraege zu zwei Oktetten je Block
//   Stufe 3   cp & 15          16 Eintraege zu einem Oktett: DAS OKTETT
//
//   Bit 0..4   die Bidi-Klasse: 0 L, 1 R, 2 AL, 3 EN, 4 ES, 5 ET, 6 AN,
//              7 CS, 8 NSM, 9 BN, 10 B, 11 S, 12 WS, 13 ON, 14 LRE,
//              15 LRO, 16 RLE, 17 RLO, 18 PDF, 19 LRI, 20 RLI, 21 FSI,
//              22 PDI
//   Bit 5..7   die Verbindungsart: 0 U, 1 R, 2 L, 3 D, 4 C, 5 T
//
// Danach drei sortierte Listen, beschrieben in lib/str/ucd_bidi.fi:
// Spiegel- und Klammerpaare (MIR_N zu je einem u64), die arabischen
// Darstellungsformen je Grundbuchstabe (FORM_N zu je zwei u64) und die
// Zweierligaturen (LIG_N zu je einem u64).
//
// Stufe 0 hat keine globalen Felder, darum wird die Tabelle zur Laufzeit
// in eine abgebildete, genullte Flaeche geschrieben -- nur die Worte, die
// nicht null sind.
export {
    BYTES, OFF_L1, OFF_L2, OFF_L3, OFF_MIR, OFF_FORM, OFF_LIG,
    L2_BLOCKS, L3_BLOCKS, MIR_N, FORM_N, LIG_N,
    load,
}

#[no_gc]
fn w(p: *mut u8, i: usize, v: u64) {
    *((p as usize + i * 8) as *mut u64) = v
}

