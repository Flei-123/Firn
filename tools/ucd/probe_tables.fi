// SPDX-License-Identifier: GPL-2.0-only
// tools/ucd/probe_tables.fi -- prints what the GENERATED table answers.
//
// It maps `generated/unicode_tables.fi` through `lib/str/ucd.fi` and asks
// it about EVERY one of the 1,114,112 code points. The output is what
// `tools/ucd/verify_tables.py` holds against a parser of its own over the
// two UCD files -- a table that is only checked at a few spots is not
// checked.
//
//   C <lo> <hi> <class>   maximal run with the same class octet
//   U <cp> <target>       every code point whose upper case mapping differs
//   L <cp> <target>       every code point whose lower case mapping differs
//
// Usage:  ./probe_tables > answers.txt
import str.ucd
import rt.rt

const MAX_CP: u32 = 0x110000

fn line3(tag: u8, a: u64, b: u64, c: u64, with_c: bool) {
    var o: rt.Buf = rt.buf_new()
    rt.buf_push(&o, tag)
    rt.buf_push(&o, 32 as u8)
    rt.buf_push_dec_u64(&o, a)
    rt.buf_push(&o, 32 as u8)
    rt.buf_push_dec_u64(&o, b)
    if with_c {
        rt.buf_push(&o, 32 as u8)
        rt.buf_push_dec_u64(&o, c)
    }
    rt.buf_push(&o, 10 as u8)
    let ok: bool = rt.write_everything(1, o.ptr, o.len)
    rt.buf_free(&o)
}

fn main() -> i32 {
    let t: u64 = ucd.ucd_map()
    if t == 0 {
        return 2
    }
    // The class octet, as maximal runs.
    var lo: u32 = 0
    var cur: u8 = ucd.ucd_class(t, 0 as u32)
    var cp: u32 = 1 as u32
    while cp < MAX_CP {
        let k: u8 = ucd.ucd_class(t, cp)
        if k != cur {
            line3(67 as u8, lo as u64, (cp - 1 as u32) as u64, cur as u64, true)
            lo = cp
            cur = k
        }
        cp = cp + 1 as u32
    }
    line3(67 as u8, lo as u64, (MAX_CP - 1 as u32) as u64, cur as u64, true)

    // The case mappings, one line each.
    cp = 0 as u32
    while cp < MAX_CP {
        let u: u32 = ucd.ucd_to_upper(t, cp)
        if u != cp {
            line3(85 as u8, cp as u64, u as u64, 0, false)
        }
        cp = cp + 1 as u32
    }
    cp = 0 as u32
    while cp < MAX_CP {
        let l: u32 = ucd.ucd_to_lower(t, cp)
        if l != cp {
            line3(76 as u8, cp as u64, l as u64, 0, false)
        }
        cp = cp + 1 as u32
    }
    ucd.ucd_free(t)
    return 0
}
