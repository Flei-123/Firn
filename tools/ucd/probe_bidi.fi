// tools/ucd/probe_bidi.fi -- THE BIDI TABLE IS QUERIED, AND VIA
// THE NORMAL WAY.
//
// This program does not read the table out itself, it asks
// lib/str/ucd_bidi.fi -- the same functions that lib/fui/bidi.fi and
// lib/fui/shape.fi call. What is right here is therefore right there too, and
// an error in the access (a wrong offset, a swapped
// field) is noticed here and not only in the image.
//
// The output goes to tools/ucd/verify_bidi.py, which reads the five files of the
// UCD with an own parser and compares line by line:
//
//   O <lo> <hi> <octet>           equal octets over a range,
//                                 gapless over all 1,114,112
//   M <cp> <mirror> <kind> <canon> every character with a mirror image or
//                                 bracket kind
//   F <base> <iso> <fin> <ini> <med>  the presentation forms
//   G <a> <b> <iso> <fin>         the two-part ligatures in the Arabic block
import rt.rt
import str.ucd_bidi

fn line(b: *mut rt.Buf, tag: u8, v: u64, n: usize) {
    rt.buf_push(b, tag)
    var k: usize = 0
    while k < n {
        rt.buf_push(b, 32 as u8)
        rt.buf_push_dec_u64(b, rt.ld64(v, k))
        k = k + 1
    }
    rt.buf_push(b, 10 as u8)
}

fn main() -> i32 {
    let t: u64 = ucd_bidi.ucd_bidi_map()
    if t == 0 {
        return 2
    }
    var o: rt.Buf = rt.buf_new()
    var v: [u64; 6] = [0; 6]
    let vp: u64 = (&v[0]) as u64

    // O: Bereiche gleicher Oktette
    var lo: u32 = 0
    var cur: u8 = ucd_bidi.ucd_bidi_octet(t, 0 as u32)
    var cp: u32 = 1
    while cp <= 0x110000 as u32 {
        var here: u8 = 0 as u8
        var end: bool = cp == 0x110000 as u32
        if !end {
            here = ucd_bidi.ucd_bidi_octet(t, cp)
        }
        if end || here != cur {
            v[0] = lo as u64
            v[1] = (cp - 1) as u64
            v[2] = cur as u64
            line(&o, 79 as u8, vp, 3)
            lo = cp
            cur = here
        }
        cp = cp + 1
    }

    // M: mirror images and brackets
    cp = 0
    while cp < 0x110000 as u32 {
        let m: u32 = ucd_bidi.ucd_mirror(t, cp)
        let ty: u8 = ucd_bidi.ucd_bracket_type(t, cp)
        if m != cp || ty != 0 as u8 {
            v[0] = cp as u64
            v[1] = m as u64
            v[2] = ty as u64
            v[3] = ucd_bidi.ucd_bracket_canon(t, cp) as u64
            line(&o, 77 as u8, vp, 4)
            // The bracket pair must be the same as the mirror image --
            // that is how it stands in the table, and how bidi.fi asks.
            if ty != 0 as u8 && ucd_bidi.ucd_bracket_pair(t, cp) != m {
                return 3
            }
        }
        cp = cp + 1
    }

    // F: die Darstellungsformen
    cp = 0
    while cp < 0x10000 as u32 {
        let a: u32 = ucd_bidi.ucd_arabic_form(t, cp, ucd_bidi.FORM_ISOL)
        let b: u32 = ucd_bidi.ucd_arabic_form(t, cp, ucd_bidi.FORM_FINA)
        let c: u32 = ucd_bidi.ucd_arabic_form(t, cp, ucd_bidi.FORM_INIT)
        let d: u32 = ucd_bidi.ucd_arabic_form(t, cp, ucd_bidi.FORM_MEDI)
        if a != 0 as u32 || b != 0 as u32 || c != 0 as u32 || d != 0 as u32 {
            v[0] = cp as u64
            v[1] = a as u64
            v[2] = b as u64
            v[3] = c as u64
            v[4] = d as u64
            line(&o, 70 as u8, vp, 5)
        }
        cp = cp + 1
    }

    // G: the two-part ligatures, queried for every pair in the block
    // U+0600..U+06FF (there stand all base letters of the 72 entries)
    var a2: u32 = 0x600
    while a2 < 0x700 as u32 {
        var b2: u32 = 0x600
        while b2 < 0x700 as u32 {
            let li: u32 = ucd_bidi.ucd_arabic_ligature(t, a2, b2,
                ucd_bidi.FORM_ISOL)
            let lf: u32 = ucd_bidi.ucd_arabic_ligature(t, a2, b2,
                ucd_bidi.FORM_FINA)
            if li != 0 as u32 || lf != 0 as u32 {
                v[0] = a2 as u64
                v[1] = b2 as u64
                v[2] = li as u64
                v[3] = lf as u64
                line(&o, 71 as u8, vp, 4)
            }
            b2 = b2 + 1
        }
        a2 = a2 + 1
    }
    if !rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o)) {
        return 4
    }
    ucd_bidi.ucd_bidi_free(t)
    return 0
}
