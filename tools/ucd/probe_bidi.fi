// tools/ucd/probe_bidi.fi -- DIE BIDI-TABELLE WIRD BEFRAGT, UND ZWAR
// UEBER DEN NORMALEN WEG.
//
// Dieses Programm liest die Tabelle nicht selbst aus, es fragt
// lib/str/ucd_bidi.fi -- dieselben Funktionen, die lib/fui/bidi.fi und
// lib/fui/shape.fi rufen. Was hier stimmt, stimmt also auch dort, und
// ein Fehler im Zugriff (eine falsche Verschiebung, ein vertauschtes
// Feld) faellt hier auf und nicht erst im Bild.
//
// Die Ausgabe geht an tools/ucd/verify_bidi.py, das die fuenf Dateien der
// UCD mit einem eigenen Zerleger liest und Zeile fuer Zeile vergleicht:
//
//   O <lo> <hi> <oktett>          gleiche Oktette ueber einen Bereich,
//                                 lueckenlos ueber alle 1.114.112
//   M <cp> <spiegel> <art> <kanon> jedes Zeichen mit Spiegelbild oder
//                                 Klammerart
//   F <grund> <iso> <fin> <ini> <med>  die Darstellungsformen
//   G <a> <b> <iso> <fin>         die Zweierligaturen im arabischen Block
import rt.rt
import str.ucd_bidi

fn line(b: *mut rt.Buf, tag: u8, v: u64, n: usize) {
    rt.buf_push(b, tag)
    var k: usize = 0
    while k < n {
        rt.buf_push(b, 32 as u8)
        rt.buf_push_dec_u64(b, rt.ld64(v, k))
        k = k + 1
    }
    rt.buf_push(b, 10 as u8)
}

fn main() -> i32 {
    let t: u64 = ucd_bidi.ucd_bidi_map()
    if t == 0 {
        return 2
    }
    var o: rt.Buf = rt.buf_new()
    var v: [u64; 6] = [0; 6]
    let vp: u64 = (&v[0]) as u64

    // O: Bereiche gleicher Oktette
    var lo: u32 = 0
    var cur: u8 = ucd_bidi.ucd_bidi_octet(t, 0 as u32)
    var cp: u32 = 1
    while cp <= 0x110000 as u32 {
        var here: u8 = 0 as u8
        var end: bool = cp == 0x110000 as u32
        if !end {
            here = ucd_bidi.ucd_bidi_octet(t, cp)
        }
        if end || here != cur {
            v[0] = lo as u64
            v[1] = (cp - 1) as u64
            v[2] = cur as u64
            line(&o, 79 as u8, vp, 3)
            lo = cp
            cur = here
        }
        cp = cp + 1
    }

    // M: Spiegelbilder und Klammern
    cp = 0
    while cp < 0x110000 as u32 {
        let m: u32 = ucd_bidi.ucd_mirror(t, cp)
        let ty: u8 = ucd_bidi.ucd_bracket_type(t, cp)
        if m != cp || ty != 0 as u8 {
            v[0] = cp as u64
            v[1] = m as u64
            v[2] = ty as u64
            v[3] = ucd_bidi.ucd_bracket_canon(t, cp) as u64
            line(&o, 77 as u8, vp, 4)
            // Das Klammerpaar muss dasselbe sein wie das Spiegelbild --
            // so steht es in der Tabelle, und so fragt bidi.fi.
            if ty != 0 as u8 && ucd_bidi.ucd_bracket_pair(t, cp) != m {
                return 3
            }
        }
        cp = cp + 1
    }

    // F: die Darstellungsformen
    cp = 0
    while cp < 0x10000 as u32 {
        let a: u32 = ucd_bidi.ucd_arabic_form(t, cp, ucd_bidi.FORM_ISOL)
        let b: u32 = ucd_bidi.ucd_arabic_form(t, cp, ucd_bidi.FORM_FINA)
        let c: u32 = ucd_bidi.ucd_arabic_form(t, cp, ucd_bidi.FORM_INIT)
        let d: u32 = ucd_bidi.ucd_arabic_form(t, cp, ucd_bidi.FORM_MEDI)
        if a != 0 as u32 || b != 0 as u32 || c != 0 as u32 || d != 0 as u32 {
            v[0] = cp as u64
            v[1] = a as u64
            v[2] = b as u64
            v[3] = c as u64
            v[4] = d as u64
            line(&o, 70 as u8, vp, 5)
        }
        cp = cp + 1
    }

    // G: die Zweierligaturen, befragt fuer jedes Paar im Block
    // U+0600..U+06FF (dort stehen alle Grundbuchstaben der 72 Eintraege)
    var a2: u32 = 0x600
    while a2 < 0x700 as u32 {
        var b2: u32 = 0x600
        while b2 < 0x700 as u32 {
            let li: u32 = ucd_bidi.ucd_arabic_ligature(t, a2, b2,
                ucd_bidi.FORM_ISOL)
            let lf: u32 = ucd_bidi.ucd_arabic_ligature(t, a2, b2,
                ucd_bidi.FORM_FINA)
            if li != 0 as u32 || lf != 0 as u32 {
                v[0] = a2 as u64
                v[1] = b2 as u64
                v[2] = li as u64
                v[3] = lf as u64
                line(&o, 71 as u8, vp, 4)
            }
            b2 = b2 + 1
        }
        a2 = a2 + 1
    }
    if !rt.write_everything(1, rt.buf_ptr(&o), rt.buf_len(&o)) {
        return 4
    }
    ucd_bidi.ucd_bidi_free(t)
    return 0
}
