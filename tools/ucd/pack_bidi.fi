// tools/ucd/pack_bidi.fi -- DIE BIDI-TABELLE AUS DER UNICODE CHARACTER
// DATABASE.
//
// Liest fuenf Dateien der UCD 17.0.0 und schreibt
// `generated/bidi_tables.fi` auf die Standardausgabe:
//
//   DerivedBidiClass.txt  die Bidi-Klasse JEDES Codepunktes, samt der
//                         Vorgaben fuer unbelegte Bereiche (@missing)
//   BidiMirroring.txt     das Spiegelbild (Regel L4 von UAX #9)
//   BidiBrackets.txt      die Klammerpaare (Regel N0)
//   ArabicShaping.txt     die Verbindungsart der arabischen Schrift
//   UnicodeData.txt       Allgemeine Kategorie (Mn/Me/Cf werden zur
//                         Verbindungsart T), kanonische Zerlegung (BD16)
//                         und die Darstellungsformen <initial> ...
//
// WARUM KEIN `comptime` WIE BEI unicode_tables.fi. Dort liest der
// Uebersetzer die UCD zur Uebersetzungszeit, weil Abnahmepunkt 6 genau
// das verlangte -- und braucht dafuer 24 Fenster, ein Python-Skript, das
// die Fenstergrenzen setzt, und trotzdem einen zweiten Firn-Lauf zum
// Packen, weil `comptime` keine Felder kennt. Fuer die Bidi-Daten wird
// kein Abnahmepunkt ueber den Uebersetzer gefuehrt; das Packen braucht
// ohnehin ein Programm, und dieses Programm liest die Dateien gleich
// selbst. Kein Python im Erzeugungsweg, eine Stelle, die die Formate
// kennt. Die UNABHAENGIGE Gegenrechnung steht in tools/ucd/verify_bidi.py
// (ein zweiter Zerleger, eine zweite Sprache) und laeuft in
// tools/ucd/build_bidi.sh ueber alle 1.114.112 Codepunkte.
//
// WAS DIESES PROGRAMM NICHT TUT: es erfindet keinen Wert. Kommt in einer
// Datei ein Klassenname vor, den es nicht kennt, oder widerspricht
// BidiBrackets.txt der Spiegelung, bricht es mit einem eigenen
// Rueckgabewert ab, statt eine still geratene Tabelle zu schreiben.
//
// Aufruf:  ./pack_bidi DerivedBidiClass.txt BidiMirroring.txt \
//              BidiBrackets.txt ArabicShaping.txt UnicodeData.txt
import rt.rt

const MAXCP: usize = 1114112
const N3: usize = 69632
const N2: usize = 2176
const NONE: usize = 0xFFFFFFFF
const LIGMAX: usize = 4096
// "Noch nicht gesetzt" fuer die Verbindungsart. 0..5 sind die echten.
const J_UNSET: u8 = 255

// ---------------------------------------------------------- die Eingabe

struct Reader {
    p: u64,
    n: usize,
    i: usize,
}

fn at(r: *mut Reader) -> u8 {
    if (*r).i >= (*r).n {
        return 0 as u8
    }
    return rt.ld8((*r).p, (*r).i)
}

fn at_off(r: *mut Reader, k: usize) -> u8 {
    if (*r).i + k >= (*r).n {
        return 0 as u8
    }
    return rt.ld8((*r).p, (*r).i + k)
}

fn skip_blank(r: *mut Reader) {
    while (*r).i < (*r).n {
        let c: u8 = at(r)
        if c != 32 as u8 && c != 9 as u8 {
            return
        }
        (*r).i = (*r).i + 1
    }
}

fn hexval(c: u8) -> i64 {
    if c >= 48 as u8 && c <= 57 as u8 { return c as i64 - 48 }
    if c >= 65 as u8 && c <= 70 as u8 { return c as i64 - 55 }
    if c >= 97 as u8 && c <= 102 as u8 { return c as i64 - 87 }
    return 0 - 1
}

// Eine Hexadezimalzahl. -1, wenn an dieser Stelle keine steht.
fn hexnum(r: *mut Reader) -> i64 {
    var v: i64 = 0
    var n: usize = 0
    while (*r).i < (*r).n {
        let d: i64 = hexval(at(r))
        if d < 0 {
            break
        }
        v = v * 16 + d
        n = n + 1
        (*r).i = (*r).i + 1
    }
    if n == 0 {
        return 0 - 1
    }
    return v
}

fn to_line_end(r: *mut Reader) {
    while (*r).i < (*r).n {
        if at(r) == 10 as u8 {
            (*r).i = (*r).i + 1
            return
        }
        (*r).i = (*r).i + 1
    }
}

// Bis hinter das naechste Semikolon der Zeile. false am Zeilenende.
fn past_semi(r: *mut Reader) -> bool {
    while (*r).i < (*r).n {
        let c: u8 = at(r)
        if c == 10 as u8 {
            return false
        }
        (*r).i = (*r).i + 1
        if c == 59 as u8 {
            return true
        }
    }
    return false
}

// Ein Bereich "lo..hi" oder ein einzelner Codepunkt. false, wenn keiner.
fn range(r: *mut Reader, lo: *mut i64, hi: *mut i64) -> bool {
    let a: i64 = hexnum(r)
    if a < 0 {
        return false
    }
    *lo = a
    *hi = a
    if at(r) == 46 as u8 && at_off(r, 1) == 46 as u8 {
        (*r).i = (*r).i + 2
        let b: i64 = hexnum(r)
        if b < 0 {
            return false
        }
        *hi = b
    }
    return true
}

// Ein Wort aus Buchstaben, Ziffern und Unterstrich; Laenge zurueck.
fn word_len(r: *mut Reader) -> usize {
    var k: usize = 0
    while (*r).i + k < (*r).n {
        let c: u8 = rt.ld8((*r).p, (*r).i + k)
        let ok: bool = (c >= 65 as u8 && c <= 90 as u8)
            || (c >= 97 as u8 && c <= 122 as u8)
            || (c >= 48 as u8 && c <= 57 as u8) || c == 95 as u8
        if !ok {
            break
        }
        k = k + 1
    }
    return k
}

// DER PLATZ EINES WORTES IN EINER LISTE aus Woertern, die durch je ein
// Leerzeichen getrennt sind. -1, wenn es nicht darin steht -- dann
// bricht der Aufrufer ab, statt eine Klasse zu raten.
fn index_in(p: u64, n: usize, list: u64, ln: usize) -> i64 {
    var idx: i64 = 0
    var s: usize = 0
    while s < ln {
        var e: usize = s
        while e < ln && rt.ld8(list, e) != 32 as u8 {
            e = e + 1
        }
        if e - s == n {
            var same: bool = true
            var k: usize = 0
            while k < n {
                if rt.ld8(list, s + k) != rt.ld8(p, k) {
                    same = false
                    break
                }
                k = k + 1
            }
            if same {
                return idx
            }
        }
        idx = idx + 1
        s = e + 1
    }
    return 0 - 1
}

// Die Kurznamen in der Reihenfolge von lib/str/ucd_bidi.fi (BIDI_*).
fn short_id(p: u64, n: usize) -> i64 {
    var l: [u8; 74] = "L R AL EN ES ET AN CS NSM BN B S WS ON LRE LRO RLE RLO PDF LRI RLI FSI PDI"
    return index_in(p, n, (&l[0]) as u64, 74)
}

// Die Langnamen derselben 23 Klassen, in derselben Reihenfolge -- so
// stehen sie in den @missing-Zeilen von DerivedBidiClass.txt.
fn long_id(p: u64, n: usize) -> i64 {
    var l: [u8; 430] = "Left_To_Right Right_To_Left Arabic_Letter European_Number European_Separator European_Terminator Arabic_Number Common_Separator Nonspacing_Mark Boundary_Neutral Paragraph_Separator Segment_Separator White_Space Other_Neutral Left_To_Right_Embedding Left_To_Right_Override Right_To_Left_Embedding Right_To_Left_Override Pop_Directional_Format Left_To_Right_Isolate Right_To_Left_Isolate First_Strong_Isolate Pop_Directional_Isolate"
    return index_in(p, n, (&l[0]) as u64, 430)
}

// Die Verbindungsarten in der Reihenfolge JOIN_* von ucd_bidi.fi.
fn join_id(c: u8) -> i64 {
    if c == 85 as u8 { return 0 }   // U
    if c == 82 as u8 { return 1 }   // R
    if c == 76 as u8 { return 2 }   // L
    if c == 68 as u8 { return 3 }   // D
    if c == 67 as u8 { return 4 }   // C
    if c == 84 as u8 { return 5 }   // T
    return 0 - 1
}

fn fill8(p: u64, lo: i64, hi: i64, v: u8) {
    var x: i64 = lo
    while x <= hi {
        rt.st8(p, x as usize, v)
        x = x + 1
    }
}

fn load_file(start: u64, k: usize, out: *mut rt.Buf) -> bool {
    let path: u64 = rt.arg_ptr(start, k)
    if path == 0 {
        return false
    }
    return rt.read_file(path, out)
}

// ---------------------------------------------------------- die Ausgabe

fn emit_word(b: *mut rt.Buf, i: usize, v: u64) {
    var t: [u8; 8] = "    w(p,"
    rt.buf_push_bytes(b, (&t) as u64, 8)
    rt.buf_push(b, 32 as u8)
    rt.buf_push_dec_u64(b, i as u64)
    rt.buf_push(b, 44 as u8)
    rt.buf_push(b, 32 as u8)
    rt.buf_push(b, 48 as u8)
    rt.buf_push(b, 120 as u8)
    rt.buf_push_hex_u64(b, v, 1)
    rt.buf_push(b, 41 as u8)
    rt.buf_push(b, 10 as u8)
}

fn emit_const(b: *mut rt.Buf, name: u64, nlen: usize, v: usize) {
    var t: [u8; 6] = "const "
    rt.buf_push_bytes(b, (&t) as u64, 6)
    rt.buf_push_bytes(b, name, nlen)
    var t2: [u8; 10] = ": usize = "
    rt.buf_push_bytes(b, (&t2) as u64, 10)
    rt.buf_push_dec_u64(b, v as u64)
    rt.buf_push(b, 10 as u8)
}

fn part_head(b: *mut rt.Buf, k: usize) {
    var t: [u8; 16] = "#[no_gc]\nfn part"
    rt.buf_push_bytes(b, (&t) as u64, 16)
    rt.buf_push_dec_u64(b, k as u64)
    var t2: [u8; 15] = "(p: *mut u8) {\n"
    rt.buf_push_bytes(b, (&t2) as u64, 15)
}

fn part_foot(b: *mut rt.Buf) {
    var t: [u8; 2] = "}\n"
    rt.buf_push_bytes(b, (&t) as u64, 2)
    rt.buf_push(b, 10 as u8)
}

fn footer(b: *mut rt.Buf, parts: usize) {
    var t: [u8; 22] = "fn load(p: *mut u8) {\n"
    rt.buf_push_bytes(b, (&t) as u64, 22)
    var k: usize = 0
    while k < parts {
        var t2: [u8; 8] = "    part"
        rt.buf_push_bytes(b, (&t2) as u64, 8)
        rt.buf_push_dec_u64(b, k as u64)
        var t3: [u8; 4] = "(p)\n"
        rt.buf_push_bytes(b, (&t3) as u64, 4)
        k = k + 1
    }
    var t4: [u8; 2] = "}\n"
    rt.buf_push_bytes(b, (&t4) as u64, 2)
}

fn align8(n: usize) -> usize {
    return (n + 7) / 8 * 8
}

// ------------------------------------------------ 1. DerivedBidiClass.txt
//
// ZWEI DURCHGAENGE. Zuerst die Vorgaben aus den Kopfzeilen
// `# @missing: lo..hi; Langname` in Dateireihenfolge -- die erste gilt
// fuer 0000..10FFFF, die spaeteren ueberschreiben sie blockweise, so
// sagt es der Kopf der Datei selbst. Danach die eigentlichen Zeilen.
// Wer die Vorgaben weglaesst, macht jeden unbelegten Codepunkt im
// hebraeischen oder arabischen Block zu einem lateinischen Buchstaben.
fn read_bidi_class(buf: *mut rt.Buf, cls: u64, missing: *mut usize,
    lines: *mut usize) -> i32 {
    var r: Reader = Reader { p: rt.buf_ptr(buf), n: rt.buf_len(buf), i: 0 }
    var at_pat: [u8; 11] = "# @missing:"
    while r.i < r.n {
        var is_missing: bool = true
        var k: usize = 0
        while k < 11 {
            if at_off(&r, k) != at_pat[k] {
                is_missing = false
                break
            }
            k = k + 1
        }
        if is_missing {
            r.i = r.i + 11
            skip_blank(&r)
            var lo: i64 = 0
            var hi: i64 = 0
            if !range(&r, &lo, &hi) {
                return 20
            }
            if !past_semi(&r) {
                return 20
            }
            skip_blank(&r)
            let wl: usize = word_len(&r)
            let id: i64 = long_id(r.p + r.i as u64, wl)
            if id < 0 {
                return 21
            }
            fill8(cls, lo, hi, id as u8)
            *missing = *missing + 1
        }
        to_line_end(&r)
    }
    r.i = 0
    while r.i < r.n {
        let c: u8 = at(&r)
        if c == 35 as u8 || c == 10 as u8 {
            to_line_end(&r)
            continue
        }
        var lo2: i64 = 0
        var hi2: i64 = 0
        if !range(&r, &lo2, &hi2) {
            return 22
        }
        if !past_semi(&r) {
            return 22
        }
        skip_blank(&r)
        let wl2: usize = word_len(&r)
        let id2: i64 = short_id(r.p + r.i as u64, wl2)
        if id2 < 0 {
            return 23
        }
        fill8(cls, lo2, hi2, id2 as u8)
        *lines = *lines + 1
        to_line_end(&r)
    }
    return 0
}

// ---------------------------------------------------- 2. UnicodeData.txt
//
// Gebraucht werden drei Felder: 2 (die Kategorie, fuer die Vorgabe T der
// Verbindungsart), 5 (die Zerlegung) -- und 0, der Codepunkt. Der
// Bereichsbrauch `<..., First>`/`<..., Last>` spielt hier keine Rolle:
// in solchen Bereichen stehen nur Lo, Co und Cs, und keine davon ist
// Mn, Me oder Cf oder hat eine Zerlegung.
//
// `tmark[cp]` = 1 fuer Mn/Me/Cf. `canon[cp]` (nur Ebene 0, u16) die
// einteilige kanonische Zerlegung. `form[base]` (u64) die vier
// einteiligen Darstellungsformen, 16 Bit je Form in der Reihenfolge
// isoliert, endend, anfangs, mittig. Die Zweierligaturen landen in
// `lig_*`, eine Zeile je Form.
fn read_unicode_data(buf: *mut rt.Buf, tmark: u64, canon: u64, form: u64,
    lig_a: u64, lig_b: u64, lig_f: u64, lig_cp: u64,
    nlig: *mut usize) -> i32 {
    var r: Reader = Reader { p: rt.buf_ptr(buf), n: rt.buf_len(buf), i: 0 }
    var tags: [u8; 32] = "isolated final initial medial   "
    while r.i < r.n {
        let cp: i64 = hexnum(&r)
        if cp < 0 {
            to_line_end(&r)
            continue
        }
        if !past_semi(&r) {      // hinter Feld 0
            return 30
        }
        if !past_semi(&r) {      // hinter Feld 1, dem Namen
            return 30
        }
        let g1: u8 = at(&r)
        let g2: u8 = at_off(&r, 1)
        // Mn, Me, Cf
        if (g1 == 77 as u8 && (g2 == 110 as u8 || g2 == 101 as u8))
            || (g1 == 67 as u8 && g2 == 102 as u8) {
            rt.st8(tmark, cp as usize, 1 as u8)
        }
        if !past_semi(&r) {      // hinter Feld 2
            return 30
        }
        if !past_semi(&r) {      // hinter Feld 3
            return 30
        }
        if !past_semi(&r) {      // hinter Feld 4
            return 30
        }
        // Feld 5: die Zerlegung
        var tag: i64 = 0 - 1
        if at(&r) == 60 as u8 {
            r.i = r.i + 1
            let wl: usize = word_len(&r)
            tag = index_in(r.p + r.i as u64, wl, (&tags[0]) as u64, 29)
            if tag < 0 {
                tag = 99     // eine andere Markierung (<compat> ...)
            }
            r.i = r.i + wl
            if at(&r) == 62 as u8 {
                r.i = r.i + 1
            }
            skip_blank(&r)
        }
        let d1: i64 = hexnum(&r)
        skip_blank(&r)
        let d2: i64 = hexnum(&r)
        skip_blank(&r)
        let d3: i64 = hexnum(&r)
        if d1 >= 0 && d1 < 65536 && d2 < 0 && tag < 0 && cp < 65536 {
            rt.st16(canon, cp as usize, d1 as u16)
        }
        if tag >= 0 && tag < 4 && d1 >= 0 && d1 < 65536 && cp < 65536 {
            if d2 < 0 {
                // ERSETZEN, NICHT VERODERN: fuehrt die UCD dieselbe
                // Form zweimal, gilt die spaetere Zeile (siehe unten bei
                // den Ligaturen, wo das wirklich vorkommt).
                let old: u64 = rt.ld64(form, d1 as usize)
                let sh: u64 = (tag as u64) * 16
                let keep: u64 = old & (0xFFFFFFFFFFFFFFFF ^ (0xFFFF << sh))
                rt.st64(form, d1 as usize, keep | ((cp as u64) << sh))
            } else if d3 < 0 && d2 < 65536 {
                if *nlig >= LIGMAX {
                    return 31
                }
                rt.st64(lig_a, *nlig, d1 as u64)
                rt.st64(lig_b, *nlig, d2 as u64)
                rt.st64(lig_f, *nlig, tag as u64)
                rt.st64(lig_cp, *nlig, cp as u64)
                *nlig = *nlig + 1
            }
        }
        to_line_end(&r)
    }
    return 0
}

// ---------------------------------- 3. BidiMirroring.txt, BidiBrackets.txt
fn read_mirroring(buf: *mut rt.Buf, mir: u64, count: *mut usize) -> i32 {
    var r: Reader = Reader { p: rt.buf_ptr(buf), n: rt.buf_len(buf), i: 0 }
    while r.i < r.n {
        let c: u8 = at(&r)
        if c == 35 as u8 || c == 10 as u8 {
            to_line_end(&r)
            continue
        }
        let a: i64 = hexnum(&r)
        if a < 0 {
            return 40
        }
        if !past_semi(&r) {
            return 40
        }
        skip_blank(&r)
        let b: i64 = hexnum(&r)
        if b < 0 {
            return 40
        }
        rt.st32(mir, a as usize, b as u32)
        *count = *count + 1
        to_line_end(&r)
    }
    return 0
}

fn read_brackets(buf: *mut rt.Buf, mir: u64, bt: u64,
    count: *mut usize) -> i32 {
    var r: Reader = Reader { p: rt.buf_ptr(buf), n: rt.buf_len(buf), i: 0 }
    while r.i < r.n {
        let c: u8 = at(&r)
        if c == 35 as u8 || c == 10 as u8 {
            to_line_end(&r)
            continue
        }
        let a: i64 = hexnum(&r)
        if a < 0 {
            return 50
        }
        if !past_semi(&r) {
            return 50
        }
        skip_blank(&r)
        let b: i64 = hexnum(&r)
        if b < 0 {
            return 50
        }
        if !past_semi(&r) {
            return 50
        }
        skip_blank(&r)
        let t: u8 = at(&r)
        var ty: u8 = 0 as u8
        if t == 111 as u8 {
            ty = 1 as u8
        } else if t == 99 as u8 {
            ty = 2 as u8
        } else {
            return 51
        }
        // Das Klammerpaar steht im selben Feld wie das Spiegelbild. Das
        // geht nur, solange beide dasselbe sagen; tun sie es nicht,
        // bricht das Programm ab, statt eines von beiden zu verlieren.
        let m: u32 = rt.ld32(mir, a as usize)
        if m != 0 as u32 && m != b as u32 {
            return 52
        }
        rt.st32(mir, a as usize, b as u32)
        rt.st8(bt, a as usize, ty)
        *count = *count + 1
        to_line_end(&r)
    }
    return 0
}

// --------------------------------------------------- 4. ArabicShaping.txt
fn read_shaping(buf: *mut rt.Buf, jt: u64, count: *mut usize) -> i32 {
    var r: Reader = Reader { p: rt.buf_ptr(buf), n: rt.buf_len(buf), i: 0 }
    while r.i < r.n {
        let c: u8 = at(&r)
        if c == 35 as u8 || c == 10 as u8 {
            to_line_end(&r)
            continue
        }
        let a: i64 = hexnum(&r)
        if a < 0 {
            return 60
        }
        if !past_semi(&r) {      // hinter dem Codepunkt
            return 60
        }
        if !past_semi(&r) {      // hinter dem Namen
            return 60
        }
        skip_blank(&r)
        let id: i64 = join_id(at(&r))
        if id < 0 {
            return 61
        }
        rt.st8(jt, a as usize, id as u8)
        *count = *count + 1
        to_line_end(&r)
    }
    return 0
}

fn say(n: u64, nl: usize, v: usize) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, n, nl)
    rt.buf_push_dec_u64(&b, v as u64)
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(2, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) != 6 {
        return 2
    }
    var f_dbc: rt.Buf = rt.buf_new()
    var f_mir: rt.Buf = rt.buf_new()
    var f_brk: rt.Buf = rt.buf_new()
    var f_ash: rt.Buf = rt.buf_new()
    var f_ucd: rt.Buf = rt.buf_new()
    if !load_file(start, 1, &f_dbc) { return 2 }
    if !load_file(start, 2, &f_mir) { return 2 }
    if !load_file(start, 3, &f_brk) { return 2 }
    if !load_file(start, 4, &f_ash) { return 2 }
    if !load_file(start, 5, &f_ucd) { return 2 }

    let cls: u64 = rt.heap_alloc(MAXCP)
    let jt: u64 = rt.heap_alloc(MAXCP)
    let tmark: u64 = rt.heap_alloc(MAXCP)
    let mir: u64 = rt.heap_alloc(MAXCP * 4)
    let bt: u64 = rt.heap_alloc(MAXCP)
    let canon: u64 = rt.heap_alloc(65536 * 2)
    let form: u64 = rt.heap_alloc(65536 * 8)
    let lig_a: u64 = rt.heap_alloc(LIGMAX * 8)
    let lig_b: u64 = rt.heap_alloc(LIGMAX * 8)
    let lig_f: u64 = rt.heap_alloc(LIGMAX * 8)
    let lig_cp: u64 = rt.heap_alloc(LIGMAX * 8)
    if cls == 0 || jt == 0 || tmark == 0 || mir == 0 || bt == 0
        || canon == 0 || form == 0 || lig_a == 0 || lig_b == 0
        || lig_f == 0 || lig_cp == 0 {
        return 3
    }

    var n_missing: usize = 0
    var n_lines: usize = 0
    let e1: i32 = read_bidi_class(&f_dbc, cls, &n_missing, &n_lines)
    if e1 != 0 { return e1 }
    // Die erste @missing-Zeile muss den ganzen Raum abdecken, sonst ist
    // das Dateiformat ein anderes als das, fuer das dieses Programm
    // geschrieben ist.
    if n_missing < 2 || n_lines < 1000 {
        return 24
    }

    var nlig: usize = 0
    let e2: i32 = read_unicode_data(&f_ucd, tmark, canon, form, lig_a,
        lig_b, lig_f, lig_cp, &nlig)
    if e2 != 0 { return e2 }

    var n_mir: usize = 0
    let e3: i32 = read_mirroring(&f_mir, mir, &n_mir)
    if e3 != 0 { return e3 }
    var n_brk: usize = 0
    let e4: i32 = read_brackets(&f_brk, mir, bt, &n_brk)
    if e4 != 0 { return e4 }

    // Die Verbindungsart: erst "nicht gesetzt", dann die Datei, dann
    // die Vorgabe aus dem Kopf von ArabicShaping.txt -- "Those that are
    // not explicitly listed and that are of General Category Mn, Me, or
    // Cf have joining type T. All others not explicitly listed have
    // joining type U."
    rt.mem_set(jt, J_UNSET, MAXCP)
    var n_ash: usize = 0
    let e5: i32 = read_shaping(&f_ash, jt, &n_ash)
    if e5 != 0 { return e5 }
    var x: usize = 0
    while x < MAXCP {
        if rt.ld8(jt, x) == J_UNSET {
            if rt.ld8(tmark, x) != 0 as u8 {
                rt.st8(jt, x, 5 as u8)
            } else {
                rt.st8(jt, x, 0 as u8)
            }
        }
        x = x + 1
    }

    // Das Oktett: Klasse in Bit 0..4, Verbindungsart in Bit 5..7.
    let oct: u64 = rt.heap_alloc(MAXCP)
    if oct == 0 {
        return 3
    }
    x = 0
    while x < MAXCP {
        let v: u8 = rt.ld8(cls, x) | (rt.ld8(jt, x) << 5)
        rt.st8(oct, x, v)
        x = x + 1
    }

    // ------------------------------------------- Stufe 3: 16 Oktette
    let l3data: u64 = rt.heap_alloc(N3 * 16)
    let l3idx: u64 = rt.heap_alloc(N3 * 2)
    if l3data == 0 || l3idx == 0 {
        return 3
    }
    var l3n: usize = 0
    var blk: usize = 0
    while blk < N3 {
        let w0: u64 = rt.ld64(oct, blk * 2)
        let w1: u64 = rt.ld64(oct, blk * 2 + 1)
        var found: usize = NONE
        var k: usize = 0
        while k < l3n {
            if rt.ld64(l3data, k * 2) == w0 {
                if rt.ld64(l3data, k * 2 + 1) == w1 {
                    found = k
                    break
                }
            }
            k = k + 1
        }
        if found == NONE {
            rt.st64(l3data, l3n * 2, w0)
            rt.st64(l3data, l3n * 2 + 1, w1)
            found = l3n
            l3n = l3n + 1
        }
        rt.st16(l3idx, blk, found as u16)
        blk = blk + 1
    }

    // --------------------------- Stufe 2: 32 Nummern der Stufe 3 je Block
    let l2data: u64 = rt.heap_alloc(N2 * 32 * 2)
    let l1: u64 = rt.heap_alloc(N2)
    if l2data == 0 || l1 == 0 {
        return 3
    }
    var l2n: usize = 0
    var blk2: usize = 0
    while blk2 < N2 {
        var found2: usize = NONE
        var k2: usize = 0
        while k2 < l2n {
            var same: bool = true
            var j: usize = 0
            while j < 32 {
                if rt.ld16(l2data, k2 * 32 + j) != rt.ld16(l3idx, blk2 * 32 + j) {
                    same = false
                    break
                }
                j = j + 1
            }
            if same {
                found2 = k2
                break
            }
            k2 = k2 + 1
        }
        if found2 == NONE {
            var j2: usize = 0
            while j2 < 32 {
                rt.st16(l2data, l2n * 32 + j2, rt.ld16(l3idx, blk2 * 32 + j2))
                j2 = j2 + 1
            }
            found2 = l2n
            l2n = l2n + 1
        }
        rt.st8(l1, blk2, found2 as u8)
        blk2 = blk2 + 1
    }
    // Ein Oktett je Eintrag der ersten Stufe: mehr als 256 Bloecke der
    // zweiten Stufe waeren still abgeschnitten -- also Abbruch.
    if l2n > 256 {
        return 8
    }

    // --------------------------------------- die Spiegel- und Klammerliste
    let mirlist: u64 = rt.heap_alloc(MAXCP / 16 * 8)
    if mirlist == 0 {
        return 3
    }
    var mn: usize = 0
    x = 0
    while x < MAXCP {
        let m: u64 = rt.ld32(mir, x) as u64
        let ty: u64 = rt.ld8(bt, x) as u64
        if m != 0 || ty != 0 {
            var cn: u64 = 0
            if ty != 0 && x < 65536 {
                cn = rt.ld16(canon, x) as u64
            }
            rt.st64(mirlist, mn, (x as u64) | (m << 21) | (ty << 42)
                | (cn << 44))
            mn = mn + 1
        }
        x = x + 1
    }

    // ------------------------------------------- die Darstellungsformen
    var fn_: usize = 0
    x = 0
    while x < 65536 {
        if rt.ld64(form, x) != 0 {
            fn_ = fn_ + 1
        }
        x = x + 1
    }

    // ------------------------------------------------ die Zweierligaturen
    // Zusammengefasst je Paar (a, b); behalten wird ein Paar nur, wenn es
    // die isolierte UND die endende Form hat -- nur die kann ein
    // Zeilenstueck ohne GSUB ueberhaupt brauchen (die Ligatur steht am
    // Wortende oder allein, siehe lib/fui/shape.fi).
    let lk: u64 = rt.heap_alloc(LIGMAX * 8)
    let lv: u64 = rt.heap_alloc(LIGMAX * 8)
    if lk == 0 || lv == 0 {
        return 3
    }
    var ln: usize = 0
    var q: usize = 0
    while q < nlig {
        let key: u64 = rt.ld64(lig_a, q) | (rt.ld64(lig_b, q) << 16)
        let tg: u64 = rt.ld64(lig_f, q)
        if tg <= 1 {
            var slot: usize = NONE
            var s: usize = 0
            while s < ln {
                if rt.ld64(lk, s) == key {
                    slot = s
                    break
                }
                s = s + 1
            }
            if slot == NONE {
                slot = ln
                rt.st64(lk, ln, key)
                ln = ln + 1
            }
            // DIE SPAETERE ZEILE GILT. U+FBF9 (die uigurisch-kirgisische
            // Ligatur) und U+FC03 zerlegen sich BEIDE in 0626 0649; wer
            // die beiden verodert, bekommt U+FFFB -- ein Zeichen, das es
            // nicht gibt. Gefunden hat das tools/ucd/verify_bidi.py.
            let old: u64 = rt.ld64(lv, slot)
            let lsh: u64 = 16 * tg
            let lkeep: u64 = old & (0xFFFFFFFFFFFFFFFF ^ (0xFFFF << lsh))
            rt.st64(lv, slot, lkeep | (rt.ld64(lig_cp, q) << lsh))
        }
        q = q + 1
    }
    // Nur vollstaendige Paare, nach dem Schluessel sortiert (Einfuegen --
    // es sind 72).
    let ligout: u64 = rt.heap_alloc(LIGMAX * 8)
    if ligout == 0 {
        return 3
    }
    var lo_n: usize = 0
    q = 0
    while q < ln {
        let v: u64 = rt.ld64(lv, q)
        if (v & 0xFFFF) != 0 && ((v >> 16) & 0xFFFF) != 0 {
            let e: u64 = rt.ld64(lk, q) | (v << 32)
            var p2: usize = lo_n
            while p2 > 0 && (rt.ld64(ligout, p2 - 1) & 0xFFFFFFFF)
                > (e & 0xFFFFFFFF) {
                rt.st64(ligout, p2, rt.ld64(ligout, p2 - 1))
                p2 = p2 - 1
            }
            rt.st64(ligout, p2, e)
            lo_n = lo_n + 1
        }
        q = q + 1
    }

    // ------------------------------------------------------ die Anordnung
    let off_l1: usize = 0
    let off_l2: usize = align8(off_l1 + N2)
    let off_l3: usize = align8(off_l2 + l2n * 32 * 2)
    let off_mir: usize = align8(off_l3 + l3n * 16)
    let off_form: usize = align8(off_mir + mn * 8)
    let off_lig: usize = align8(off_form + fn_ * 16)
    let bytes: usize = align8(off_lig + lo_n * 8)
    let region: u64 = rt.heap_alloc(bytes)
    if region == 0 {
        return 3
    }
    q = 0
    while q < N2 {
        rt.st8(region, off_l1 + q, rt.ld8(l1, q))
        q = q + 1
    }
    q = 0
    while q < l2n * 32 {
        rt.st16(region + off_l2 as u64, q, rt.ld16(l2data, q))
        q = q + 1
    }
    q = 0
    while q < l3n * 16 {
        rt.st8(region, off_l3 + q, rt.ld8(l3data, q))
        q = q + 1
    }
    q = 0
    while q < mn {
        rt.st64(region + off_mir as u64, q, rt.ld64(mirlist, q))
        q = q + 1
    }
    var fi: usize = 0
    x = 0
    while x < 65536 {
        let fv: u64 = rt.ld64(form, x)
        if fv != 0 {
            // Wort 0: Grund | iso << 16 | fin << 32 | ini << 48
            // Wort 1: mittig
            let w0: u64 = (x as u64) | ((fv & 0xFFFFFFFFFFFF) << 16)
            rt.st64(region + off_form as u64, fi * 2, w0)
            rt.st64(region + off_form as u64, fi * 2 + 1, fv >> 48)
            fi = fi + 1
        }
        x = x + 1
    }
    q = 0
    while q < lo_n {
        rt.st64(region + off_lig as u64, q, rt.ld64(ligout, q))
        q = q + 1
    }

    // ------------------------------------------------------ das Schreiben
    var o: rt.Buf = rt.buf_new()
    var c0: [u8; 5] = "BYTES"
    emit_const(&o, (&c0) as u64, 5, bytes)
    var c1: [u8; 6] = "OFF_L1"
    emit_const(&o, (&c1) as u64, 6, off_l1)
    var c2: [u8; 6] = "OFF_L2"
    emit_const(&o, (&c2) as u64, 6, off_l2)
    var c3: [u8; 6] = "OFF_L3"
    emit_const(&o, (&c3) as u64, 6, off_l3)
    var c4: [u8; 7] = "OFF_MIR"
    emit_const(&o, (&c4) as u64, 7, off_mir)
    var c5: [u8; 8] = "OFF_FORM"
    emit_const(&o, (&c5) as u64, 8, off_form)
    var c6: [u8; 7] = "OFF_LIG"
    emit_const(&o, (&c6) as u64, 7, off_lig)
    var c7: [u8; 9] = "L2_BLOCKS"
    emit_const(&o, (&c7) as u64, 9, l2n)
    var c8: [u8; 9] = "L3_BLOCKS"
    emit_const(&o, (&c8) as u64, 9, l3n)
    var c9: [u8; 5] = "MIR_N"
    emit_const(&o, (&c9) as u64, 5, mn)
    var ca: [u8; 6] = "FORM_N"
    emit_const(&o, (&ca) as u64, 6, fn_)
    var cb: [u8; 5] = "LIG_N"
    emit_const(&o, (&cb) as u64, 5, lo_n)
    rt.buf_push(&o, 10 as u8)
    var part: usize = 0
    var inpart: usize = 0
    var open: bool = false
    var wi: usize = 0
    while wi < bytes / 8 {
        let v: u64 = rt.ld64(region, wi)
        if v != 0 {
            if !open {
                part_head(&o, part)
                open = true
                inpart = 0
            }
            emit_word(&o, wi, v)
            inpart = inpart + 1
            if inpart >= 400 {
                part_foot(&o)
                open = false
                part = part + 1
            }
        }
        wi = wi + 1
    }
    if open {
        part_foot(&o)
        part = part + 1
    }
    footer(&o, part)
    if !rt.write_everything(1, o.ptr, o.len) {
        return 11
    }

    // Was gelesen wurde, auf den Fehlerkanal -- das Bauskript zeigt es an.
    var s1: [u8; 28] = "   @missing-Vorgaben        "
    say((&s1[0]) as u64, 28, n_missing)
    var s2: [u8; 28] = "   Klassenzeilen            "
    say((&s2[0]) as u64, 28, n_lines)
    var s3: [u8; 28] = "   Spiegelpaare             "
    say((&s3[0]) as u64, 28, n_mir)
    var s4: [u8; 28] = "   Klammern                 "
    say((&s4[0]) as u64, 28, n_brk)
    var s5: [u8; 28] = "   Verbindungsarten (Datei) "
    say((&s5[0]) as u64, 28, n_ash)
    var s6: [u8; 28] = "   Darstellungsformen       "
    say((&s6[0]) as u64, 28, fn_)
    var s7: [u8; 28] = "   Zweierligaturen          "
    say((&s7[0]) as u64, 28, lo_n)
    return 0
}
