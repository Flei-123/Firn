// generated/unicode_tables.fi -- GENERATED. Do not edit by hand.
//
// Produced by `bash tools/ucd/build.sh` (ACCEPTANCE item 6). The build step
// reads the Unicode Character Database, and it reads it AT COMPILE TIME:
// `tools/ucd/gen_ucd.fi` holds `comptime` blocks that call `file_size` and
// `file_byte` on the two files below, parse them inside the compiler and
// emit the entries as Firn source text (`firnc --emit=comptime`).
// `tools/ucd/pack.fi` -- a Firn program -- turns those entries into the
// table below.
//
//   UnicodeData.txt            @UBYTES@ octets, sha256 @USHA@
//   DerivedCoreProperties.txt  @DBYTES@ octets, sha256 @DSHA@
//   Unicode version            @UVER@
//
// Both sums are pinned in `tools/ucd/UCD.sha256`; the build step compares
// them before it reads anything. The same source state therefore produces
// this file octet for octet -- `bash tools/ucd/build.sh --verify` builds it
// a second time and compares.
//
// THE SHAPE. Three stages with deduplicated blocks, not a flat list of
// ranges:
//
//   level 1   cp >> 9          L1_LEN entries of one octet -> a level 2 block
//   level 2   (cp >> 4) & 31   32 entries of two octets     -> a level 3 block
//   level 3   cp & 15          16 entries of one octet      -> the class
//
// Three loads, no loop, no branch -- the same cost for every code point.
// The class octet answers three questions at once:
//
//   bits 0..4   general category: 0 Cn, 1 Lu, 2 Ll, 3 Lt, 4 Lm, 5 Lo,
//               6 Mn, 7 Mc, 8 Me, 9 Nd, 10 Nl, 11 No, 12 Pc, 13 Pd,
//               14 Ps, 15 Pe, 16 Pi, 17 Pf, 18 Po, 19 Sm, 20 Sc, 21 Sk,
//               22 So, 23 Zs, 24 Zl, 25 Zp, 26 Cc, 27 Cf, 28 Cs, 29 Co
//   bit 5       ID_Start (DerivedCoreProperties)
//   bit 6       ID_Continue (DerivedCoreProperties)
//
// THE CASE MAPPINGS are sparse and are held as runs instead: `lo`, `hi`, a
// stride of 1 or 2, and a delta -- one u64 per run, plus an index by
// `cp >> IDX_SHIFT` that says where to start looking.
//
//   bits  0..20   lo
//   bits 21..41   hi
//   bit  42       0 = every code point of the run, 1 = every second one
//   bits 43..63   delta + 0x100000
//
// The size of the whole table stands in `BYTES` below and is printed by the
// build step. `lib/str/ucd.fi` maps it and looks things up in it.
//
// Stage 0 has no global arrays (SPEC 14.1 item 5), so the table is written
// into a mapped area at run time -- the same way the character reference
// table of the HTML tokenizer is (`lib/html/entities_data.fi`). Only the
// words that are not zero are written; the area comes from `mmap` and is
// zeroed.
export {
    BYTES, OFF_L1, OFF_L2, OFF_L3, OFF_UPIDX, OFF_UP, OFF_LOIDX, OFF_LOW,
    L1_LEN, L2_BLOCKS, L3_BLOCKS, UP_RUNS, LOW_RUNS, IDX_SHIFT, IDX_LEN,
    load,
}

#[no_gc]
fn w(p: *mut u8, i: usize, v: u64) {
    *((p as usize + i * 8) as *mut u64) = v
}

