// SPDX-License-Identifier: MPL-2.0
// tools/pack/test/hello.fi -- the smallest program the packaging tests install:
// it writes a marker file (path = first argument, or "hello-ran.txt" next to
// the current directory) and prints its version.
import std.rt
import std.fs
import std.io

fn main(start: u64) -> i32 {
    var path: str = "hello-ran.txt"
    if rt.arg_count(start) > 1 {
        let p: u64 = rt.arg_ptr(start, 1)
        path = str { p: p as *mut u8, n: rt.c_length(p) }
    }
    let text: str = "hello from the packaged program\n"
    let n: usize = fs.write_file(path, text.p as u64, text.n) catch 0
    io.print_line("hello 1.0.0")
    if n != text.n {
        return 1
    }
    return 0
}
