// tools/pack/test/portable.fi -- prints where appkit keeps its folders:
// `config=<dir>` and `state=<dir>`. With `portable.txt` next to the program it must be
// <program folder>/data/...; without, the user profile (or APPKIT_HOME).
import std.rt
import std.io
import appkit.platform
import appkit.util

fn main(start: u64) -> i32 {
    platform.plat_init(start)
    var b: rt.Buf = rt.buf_new()
    platform.plat_dir(platform.DIR_CONFIG, "demo", "FleiTec", &b)
    io.print_line("config=" + util.buf_to_str_copy(&b))
    platform.plat_dir(platform.DIR_STATE, "demo", "FleiTec", &b)
    io.print_line("state=" + util.buf_to_str_copy(&b))
    return 0
}
