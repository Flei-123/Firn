// tools/pack/test/syncver.fi -- calls lib/pack/installed.fi like an updated program does:
//   syncver <id> <version>     exit 0 when "Apps & features" was changed
import std.rt
import pack.installed

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    let a1: u64 = rt.arg_ptr(start, 1)
    let a2: u64 = rt.arg_ptr(start, 2)
    let id: str = str { p: a1 as *mut u8, n: rt.c_length(a1) }
    let ver: str = str { p: a2 as *mut u8, n: rt.c_length(a2) }
    if installed.sync_version(id, ver) {
        return 0
    }
    return 1
}
