// SPDX-License-Identifier: GPL-2.0-only
// tools/bench87/jsonspeed.fi -- how fast does `lib/std/json.fi` READ?
//
//     jsonspeed <file> <repetitions> <out>
//
// Writes ONE number to `<out>`: the microseconds all repetitions together
// took. The throughput is worked out by run.sh -- this program must not be
// able to talk its own number up.
//
// The point of the exercise is the DIFFERENCE between two documents of the
// same shape, one with integers and one with floating point numbers. Round
// 81 measured 11.7 MiB/s against 1.4 MiB/s and named the float reader as the
// reason without measuring it separately; this is the measurement that
// round 87 turns into a before/after.
//
// The clock starts after the file has been read and one warm-up parse has
// run, and stops before anything is freed.
// `clock_gettime(CLOCK_MONOTONIC)` through the raw system call, exactly as
// in tools/bench82/speed.fi.
import std.json
import std.rt
import std.io

fn dec_u64(p: u64) -> usize {
    var v: usize = 0
    var i: usize = 0
    let n: usize = rt.c_length(p)
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c >= 48 as u8 && c <= 57 as u8 {
            v = v * 10 + (c - 48 as u8) as usize
        }
        i = i + 1
    }
    return v
}

fn now_ns() -> u64 {
    var ts: [u64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as u64)
    return ts[0] * 1000000000 + ts[1]
}

fn parse_once(p: u64, n: usize) -> bool {
    var d: json.Json = json.json_new()
    defer json.json_free(&d)
    return json.json_parse(&d, p, n) catch false
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 4 {
        return 2
    }
    var src: rt.Buf = rt.buf_new()
    defer rt.buf_free(&src)
    if !rt.read_file(rt.arg_ptr(start, 1), &src) {
        return 4
    }
    let reps: usize = dec_u64(rt.arg_ptr(start, 2))
    let p: u64 = rt.buf_ptr(&src)
    let n: usize = rt.buf_len(&src)
    if !parse_once(p, n) {
        return 1
    }
    let t0: u64 = now_ns()
    var i: usize = 0
    while i < reps {
        if !parse_once(p, n) {
            return 1
        }
        i = i + 1
    }
    let t1: u64 = now_ns()
    var out: rt.Buf = rt.buf_new()
    defer rt.buf_free(&out)
    rt.buf_push_dec_u64(&out, (t1 - t0) / 1000)
    rt.buf_push(&out, 10 as u8)
    if !rt.write_file(rt.arg_ptr(start, 3), rt.buf_ptr(&out), rt.buf_len(&out)) {
        return 6
    }
    return 0
}
