// SPDX-License-Identifier: GPL-2.0-only
// tools/bench87/deflatespeed.fi -- how fast does `lib/std/deflate.fi` PACK,
// on a real file and without anything else in the measurement?
//
//     deflatespeed <file> <level> <repetitions> <out>
//
// Writes TWO numbers to `<out>`: the microseconds all repetitions together
// took, and the size of the packed result. The throughput and the ratio are
// worked out by run.sh.
//
// WHY THIS EXISTS NEXT TO tools/bench82/speed.fi: that one measures a
// generated stream -- a linear congruential sequence folded down onto a
// small alphabet. That is the right hostile case for a compressor, and it
// is the case in which every match is SHORT. A comparison eight octets wide
// can show nothing there, and the number of round 82 (11.2 MiB/s) is
// therefore not the number that moves when the match loop gets faster. Real
// text has long matches; this program measures that case, and both numbers
// stand next to each other in docs/ROUND87.md.
//
// The clock starts after the file has been read and stops before anything
// is freed. `clock_gettime(CLOCK_MONOTONIC)` through the raw system call.
import std.deflate
import std.rt
import std.io

fn dec_u64(p: u64) -> usize {
    var v: usize = 0
    var i: usize = 0
    let n: usize = rt.c_length(p)
    while i < n {
        let c: u8 = rt.ld8(p, i)
        if c >= 48 as u8 && c <= 57 as u8 {
            v = v * 10 + (c - 48 as u8) as usize
        }
        i = i + 1
    }
    return v
}

fn now_ns() -> u64 {
    var ts: [u64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as u64)
    return ts[0] * 1000000000 + ts[1]
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 5 {
        return 2
    }
    var src: rt.Buf = rt.buf_new()
    defer rt.buf_free(&src)
    if !rt.read_file(rt.arg_ptr(start, 1), &src) {
        return 4
    }
    let level: usize = dec_u64(rt.arg_ptr(start, 2))
    let reps: usize = dec_u64(rt.arg_ptr(start, 3))
    let p: u64 = rt.buf_ptr(&src)
    let n: usize = rt.buf_len(&src)
    var packed: usize = 0

    // one warm-up pass, so that the measurement does not contain the first
    // touch of the hash table
    var warm: rt.Buf = rt.buf_new()
    let w: usize = deflate.deflate(p, n, level, &warm) catch 0
    rt.buf_free(&warm)
    if w == 0 && n != 0 {
        return 5
    }

    let t0: u64 = now_ns()
    var i: usize = 0
    while i < reps {
        var out: rt.Buf = rt.buf_new()
        let k: usize = deflate.deflate(p, n, level, &out) catch 0
        packed = k
        rt.buf_free(&out)
        i = i + 1
    }
    let t1: u64 = now_ns()

    var res: rt.Buf = rt.buf_new()
    defer rt.buf_free(&res)
    rt.buf_push_dec_u64(&res, (t1 - t0) / 1000)
    rt.buf_push(&res, 32 as u8)
    rt.buf_push_dec_u64(&res, packed as u64)
    rt.buf_push(&res, 10 as u8)
    if !rt.write_file(rt.arg_ptr(start, 4), rt.buf_ptr(&res), rt.buf_len(&res)) {
        return 6
    }
    return 0
}
