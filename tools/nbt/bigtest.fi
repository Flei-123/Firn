// SPDX-License-Identifier: GPL-2.0-only
// tools/nbt/bigtest.fi -- writes `bigtest.nbt` (round 76).
//
// `bigtest.nbt` is the reference file of the NBT specification: Notch's own
// example, the one every NBT library in the world is checked against. It is
// rebuilt here VALUE FOR VALUE out of `lib/std/nbt.fi`, and
// `tools/nbt/check.py` reads the result with a parser that has nothing to
// do with this repository and compares every field.
//
// Two things are added that bigtest does not contain, because the file
// predates them and the round has to prove all thirteen tag types:
// TAG_Int_Array and TAG_Long_Array.
//
// Argument 1: the file to write. Argument 2 (optional): "anon" for the
// network form of 1.20.2 (a root compound WITHOUT a name).
import std.nbt
import std.bytes
import std.rt

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var anon: bool = false
    if rt.arg_count(start) > 2 {
        var a: [u8; 5] = "anon\0"
        let p2: u64 = rt.arg_ptr(start, 2)
        if rt.c_length(p2) == 4 && rt.mem_eq(p2, (&a[0]) as u64, 4) {
            anon = true
        }
    }

    var b: bytes.Bytes = bytes.bytes_with_capacity(4096)
    defer bytes.bytes_free(&b)

    var n_level: [u8; 6] = "Level\0"
    if anon {
        nbt.nbt_root_begin_anon(&b)
    } else {
        nbt.nbt_c_root_begin(&b, (&n_level[0]) as u64)
    }

    // ---- the eleven entries of bigtest, in the order of the original file
    var n_long: [u8; 9] = "longTest\0"
    nbt.nbt_c_long(&b, (&n_long[0]) as u64, (9223372036854775807 as u64) as i64)

    var n_short: [u8; 10] = "shortTest\0"
    nbt.nbt_c_short(&b, (&n_short[0]) as u64, 32767 as i16)

    // The string carries A-ring, A-diaeresis and O-diaeresis -- two octets
    // each in UTF-8. If the length were counted in characters instead of
    // octets, this is where it would show.
    var n_str: [u8; 11] = "stringTest\0"
    var v_str: [u8; 42] = "HELLO WORLD THIS IS A TEST STRING \u{C5}\u{C4}\u{D6}!\0"
    nbt.nbt_c_string(&b, (&n_str[0]) as u64, (&v_str[0]) as u64)

    var n_float: [u8; 10] = "floatTest\0"
    nbt.nbt_c_float(&b, (&n_float[0]) as u64, 0.49823147f)

    var n_int: [u8; 8] = "intTest\0"
    nbt.nbt_c_int(&b, (&n_int[0]) as u64, 2147483647)

    var n_nested: [u8; 21] = "nested compound test\0"
    var n_ham: [u8; 4] = "ham\0"
    var n_egg: [u8; 4] = "egg\0"
    var n_name: [u8; 5] = "name\0"
    var n_value: [u8; 6] = "value\0"
    var v_hampus: [u8; 7] = "Hampus\0"
    var v_eggbert: [u8; 8] = "Eggbert\0"
    nbt.nbt_c_compound_begin(&b, (&n_nested[0]) as u64)
    nbt.nbt_c_compound_begin(&b, (&n_ham[0]) as u64)
    nbt.nbt_c_string(&b, (&n_name[0]) as u64, (&v_hampus[0]) as u64)
    nbt.nbt_c_float(&b, (&n_value[0]) as u64, 0.75f)
    nbt.nbt_end(&b)
    nbt.nbt_c_compound_begin(&b, (&n_egg[0]) as u64)
    nbt.nbt_c_string(&b, (&n_name[0]) as u64, (&v_eggbert[0]) as u64)
    nbt.nbt_c_float(&b, (&n_value[0]) as u64, 0.5f)
    nbt.nbt_end(&b)
    nbt.nbt_end(&b)

    // A list of longs: five elements, NO name and NO type per element.
    var n_ll: [u8; 16] = "listTest (long)\0"
    nbt.nbt_c_list_open(&b, (&n_ll[0]) as u64, nbt.TAG_LONG, 5)
    var i: i64 = 11
    while i <= 15 {
        bytes.put_i64(&b, i)
        i = i + 1
    }

    // A list of compounds -- the case in which the missing element name is
    // most visible: two compounds directly after one another, each closed by
    // its own TAG_End, and no name between them.
    //
    // The list length is written the OTHER way here, through the patch
    // path, so that both ways are exercised: placeholder, elements, patch.
    var n_lc: [u8; 20] = "listTest (compound)\0"
    var n_created: [u8; 11] = "created-on\0"
    var n_cname: [u8; 5] = "name\0"
    var v_c0: [u8; 16] = "Compound tag #0\0"
    var v_c1: [u8; 16] = "Compound tag #1\0"
    let mark: usize = nbt.nbt_c_list_begin(&b, (&n_lc[0]) as u64, nbt.TAG_COMPOUND)
    nbt.nbt_c_string(&b, (&n_cname[0]) as u64, (&v_c0[0]) as u64)
    nbt.nbt_c_long(&b, (&n_created[0]) as u64, 1264099775885)
    nbt.nbt_end(&b)
    nbt.nbt_c_string(&b, (&n_cname[0]) as u64, (&v_c1[0]) as u64)
    nbt.nbt_c_long(&b, (&n_created[0]) as u64, 1264099775885)
    nbt.nbt_end(&b)
    nbt.nbt_list_patch(&b, mark, 2)

    var n_byte: [u8; 9] = "byteTest\0"
    nbt.nbt_c_byte(&b, (&n_byte[0]) as u64, 127 as i8)

    // The famous 1000 octets: (n*n*255 + n*7) % 100.
    var n_ba: [u8; 102] = "byteArrayTest (the first 1000 values of (n*n*255+n*7)%100, starting with n=0 (0, 62, 34, 16, 8, ...))\0"
    let ba: u64 = rt.heap_alloc(1000)
    if ba == 0 {
        return 3
    }
    var k: u64 = 0
    while k < 1000 {
        *((ba + k) as *mut u8) = ((k * k * 255 + k * 7) % 100) as u8
        k = k + 1
    }
    nbt.nbt_c_byte_array(&b, (&n_ba[0]) as u64, ba, 1000)

    var n_double: [u8; 11] = "doubleTest\0"
    nbt.nbt_c_double(&b, (&n_double[0]) as u64, 0.49312871321823148)

    // ---- the two tags bigtest predates -----------------------------------
    var n_ia: [u8; 9] = "intArray\0"
    var ia: [i32; 6] = [0, 1, 0 - 1, 2147483647, 0 - 2147483647 - 1, 305419896]
    nbt.nbt_c_int_array(&b, (&n_ia[0]) as u64, (&ia[0]) as u64, 6)

    var n_la: [u8; 10] = "longArray\0"
    var la: [i64; 4] = [0, 0 - 1, (9223372036854775807 as u64) as i64,
        0 - 9223372036854775807 - 1]
    nbt.nbt_c_long_array(&b, (&n_la[0]) as u64, (&la[0]) as u64, 4)

    // An EMPTY list -- element type TAG_End, count 0. Every NBT reader has
    // a special case for it, and half of them get it wrong.
    var n_empty: [u8; 10] = "emptyList\0"
    nbt.nbt_c_list_open(&b, (&n_empty[0]) as u64, nbt.TAG_END, 0)

    nbt.nbt_end(&b)

    if !bytes.bytes_ok(&b) {
        return 4
    }
    if !rt.write_file(path, bytes.bytes_ptr(&b), bytes.bytes_len(&b)) {
        return 5
    }
    rt.heap_free(ba, 1000)
    return 0
}
