// tools/sounds/bankcheck.fi -- the generated bank loads with audio.bank and every event plays in audio.engine.
//   bankcheck <bank.json> <manifest.json>      prints one line per problem, then "bankcheck: <n> events ok"
import std.rt
import std.io
import std.str
import std.json
import audio.engine
import audio.bank

fn cstr(p: u64) -> str {
    return str { p: rt.ptr_of(p), n: rt.c_length(p) }
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        io.fmt_print(f"usage: bankcheck <bank.json> <manifest.json>\n")
        return 2
    }
    var e: engine.Engine = engine.engine_new(44100 as u32, 64 as u32)
    bank.bank_setup_buses(&e)
    var b: bank.Bank = bank.bank_new()
    if bank.bank_load_file(&b, &e, cstr(rt.arg_ptr(start, 1))) != bank.BANK_OK {
        let m: str = bank.bank_error(&b)
        io.fmt_print(f"bankcheck: FAIL bank does not load: {m}\n")
        return 1
    }
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 2), &data) {
        io.fmt_print(f"bankcheck: FAIL cannot read manifest\n")
        return 1
    }
    var j: json.Json = json.json_new()
    let ok: bool = json.json_parse(&j, rt.buf_ptr(&data), rt.buf_len(&data)) catch false
    if !ok {
        io.fmt_print(f"bankcheck: FAIL manifest is not JSON\n")
        return 1
    }
    let files: u32 = json.json_get_c(&j, json.json_root(&j), "files\0".p as u64)
    let out: u64 = rt.heap_alloc(4096 * 8)
    var fails: i32 = 0
    var played: i32 = 0
    var f: u32 = json.json_child(&j, files)
    while f != json.JSON_NONE {
        let ev: u32 = json.json_get_c(&j, f, "event\0".p as u64)
        let sp: str.Span = json.json_string(&j, ev)
        let name: str = str { p: sp.p, n: sp.n }
        let id: i32 = engine.engine_find_event(&e, name)
        if id < 0 {
            io.fmt_print(f"bankcheck: FAIL event {name} not in the engine\n")
            fails = fails + 1
        } else {
            engine.engine_stop_all(&e, 0.0)
            engine.engine_render(&e, out, 512)
            let h: u32 = bank.bank_play(&e, id, bank.BUS_EVENT)
            var mx: f32 = 0.0
            var round: i32 = 0
            while round < 120 && mx < 0.0001 {
                engine.engine_render(&e, out, 2048)
                var i: usize = 0
                while i < 4096 {
                    var v: f32 = *((out + (i * 4) as u64) as *mut f32)
                    if v < 0.0 { v = 0.0 - v }
                    if v > mx { mx = v }
                    i = i + 1
                }
                round = round + 1
            }
            if h == 0 as u32 || mx < 0.0001 {
                io.fmt_print(f"bankcheck: FAIL event {name} is silent\n")
                fails = fails + 1
            }
            played = played + 1
        }
        f = json.json_next(&j, f)
    }
    if fails > 0 { return 1 }
    io.fmt_print(f"bankcheck: {played as i64} events ok\n")
    return 0
}
