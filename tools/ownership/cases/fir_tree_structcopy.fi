import std.io
import std.gcobj

gc class Node {
    left: Gc[Node],
    right: Gc[Node],
    v: u64,
}

struct Pair {
    a: Gc[Node],
    b: Gc[Node],
}

gc class Holder {
    a: Gc[Node],
    b: Gc[Node],
    next: Gc[Holder],
}

fn build(d: u32, v: u64) -> Gc[Node] {
    if d == 0 {
        return gc Node { left: gc_null[Node](), right: gc_null[Node](), v: v } catch gc_null[Node]()
    }
    let l: Gc[Node] = build(d - 1, v * 2)
    let r: Gc[Node] = build(d - 1, v * 2 + 1)
    return gc Node { left: l, right: r, v: v } catch gc_null[Node]()
}

fn sum(t: Gc[Node]) -> u64 {
    if t == gc_null[Node]() {
        return 0
    }
    return t.v + sum(t.left) + sum(t.right)
}

fn kids(t: Gc[Node]) -> Pair {
    return Pair { a: t.left, b: t.right }
}

fn copy_kids(t: Gc[Node], h: Gc[Holder]) {
    let p: Pair = kids(t)
    let q: Pair = p
    h.a = q.a
    h.b = q.b
}

fn copy_raw(t: Gc[Node], r: *mut Pair) {
    let p: Pair = kids(t)
    *r = p
}

fn garbage(sink: Gc[Holder], n: u64) {
    var i: u64 = 0
    while i < n {
        let dead: Gc[Holder] = gc Holder { a: gc_null[Node](), b: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
        sink.next = dead
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    let h: Gc[Holder] = gc Holder { a: gc_null[Node](), b: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
    let r: *mut Pair = gcobj.alloc[Pair](size_of[Pair]()) as *mut Pair
    if r as u64 == 0 {
        return 4
    }
    var total: u64 = 0
    var i: u64 = 0
    while i < 400 {
        let t: Gc[Node] = build(3, i)
        copy_kids(t, h)
        total = total + sum(t)
        let u: Gc[Node] = build(4, i + 1)
        copy_raw(u, r)
        total = total + sum(u)
        garbage(h, 30)
        if i % 41 == 0 {
            gc_collect()
        }
        total = total + sum(h.a) + sum(h.b) + sum((*r).a) + sum((*r).b)
        i = i + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
