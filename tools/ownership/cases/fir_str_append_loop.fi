import std.io

fn piece(i: u64) -> str {
    if i % 3 == 0 {
        return "x"
    }
    if i % 3 == 1 {
        return "yz"
    }
    return ""
}

fn sum(s: str) -> u64 {
    var h: u64 = 7
    var i: u64 = 0
    while i < (s.n as u64) {
        h = h *% 31 +% ((*(((s.p as u64) + i) as *mut u8)) as u64)
        i = i + 1
    }
    return h
}

#[no_inline]
fn build(k: u64) -> str {
    var s: str = ""
    var i: u64 = 0
    while i < k {
        s = s + piece(i)
        i = i + 1
    }
    return s
}

#[no_inline]
fn build3(k: u64) -> str {
    var s: str = "<"
    var i: u64 = 0
    while i < k {
        s = s + piece(i) + "-" + piece(i + 1)
        i = i + 1
    }
    return s
}

#[no_inline]
fn local(k: u64) -> u64 {
    var s: str = ""
    var i: u64 = 0
    var t: u64 = 0
    while i < k {
        s = s + piece(i)
        t = t + (s.n as u64)
        i = i + 1
    }
    return t + sum(s)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var round: u64 = 0
    var total: u64 = 0
    while round < 40 {
        let a: str = build(round * 37)
        let b: str = build3(round * 11)
        total = total +% sum(a) +% sum(b) +% local(round * 5)
        round = round + 1
    }
    let big: str = build(20000)
    io.fmt_print_line(f"total {total} big {big.n} {sum(big)}")
    return 0
}
