import std.io

gc class Node {
    next: Gc[Node],
    v: u64,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var i: u64 = 0
    while i < 50000 {
        let n: Gc[Node] = gc Node { next: gc_null[Node](), v: i } catch gc_null[Node]()
        total = total + n.v * 3 + 1
        i = i + 1
    }
    var j: u64 = 0
    while j < 20000 {
        let a: Gc[Node] = gc Node { next: gc_null[Node](), v: j } catch gc_null[Node]()
        total = total + a.v
        if j % 4000 == 0 {
            gc_collect()
        }
        let b: Gc[Node] = gc Node { next: gc_null[Node](), v: j + 1 } catch gc_null[Node]()
        total = total + b.v * 2
        j = j + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
