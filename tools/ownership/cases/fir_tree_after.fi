import std.io

gc class Node {
    left: Gc[Node],
    right: Gc[Node],
    v: u64,
}

gc class Holder {
    keep: Gc[Node],
    next: Gc[Holder],
}

fn leaf(v: u64) -> Gc[Node] {
    return gc Node { left: gc_null[Node](), right: gc_null[Node](), v: v } catch gc_null[Node]()
}

fn build(d: u32, v: u64) -> Gc[Node] {
    if d == 0 {
        return leaf(v)
    }
    let l: Gc[Node] = build(d - 1, v * 2)
    let r: Gc[Node] = build(d - 1, v * 2 + 1)
    return gc Node { left: l, right: r, v: v } catch gc_null[Node]()
}

fn sum(t: Gc[Node]) -> u64 {
    if t == gc_null[Node]() {
        return 0
    }
    return t.v + sum(t.left) + sum(t.right)
}

fn holder() -> Gc[Holder] {
    return gc Holder { keep: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
}

fn garbage(sink: Gc[Holder], n: u64) {
    var i: u64 = 0
    while i < n {
        let dead: Gc[Holder] = holder()
        sink.next = dead
        i = i + 1
    }
}

fn grab(t: Gc[Node]) -> Gc[Node] {
    return t.left
}

#[no_inline]
fn grab_v(t: Gc[Node]) -> u64 {
    if t.left == gc_null[Node]() {
        return 0
    }
    return t.left.v
}

#[no_inline]
fn deep_left(t: Gc[Node]) -> Gc[Node] {
    var p: Gc[Node] = t
    while p.left != gc_null[Node]() {
        p = p.left
    }
    return p
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    let h: Gc[Holder] = holder()
    var total: u64 = 0
    var i: u64 = 0
    while i < 400 {
        let a: Gc[Node] = build(3, i)
        let c: Gc[Node] = grab(a)
        total = total + sum(a)
        garbage(h, 30)
        total = total + sum(c)
        let b: Gc[Node] = build(3, i + 1)
        total = total + grab_v(b) + sum(b)
        garbage(h, 30)
        total = total + b.left.v
        let e: Gc[Node] = build(4, i + 2)
        let low: Gc[Node] = deep_left(e)
        total = total + sum(e)
        garbage(h, 30)
        total = total + low.v
        if i % 43 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
