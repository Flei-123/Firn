import std.io
import std.vec

gc class Node {
    next: Gc[Node],
    v: u64,
}

struct Holder { n: Gc[Node] }

fn make(i: u64) -> Gc[Node] {
    return gc Node { next: gc_null[Node](), v: i } catch gc_null[Node]()
}

fn stash(slot: *mut Gc[Node], n: Gc[Node], i: u64) {
    if i % 7 == 0 {
        *slot = n
    }
}

fn echo(n: Gc[Node]) -> Gc[Node] {
    return n
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var kept: Gc[Node] = gc_null[Node]()
    var echoed: Gc[Node] = gc_null[Node]()
    var v: Vec[Holder] = vec_new[Holder]()
    var carry: Gc[Node] = make(1)
    var i: u64 = 0
    while i < 6000 {
        let a: Gc[Node] = make(i)
        let b: Gc[Node] = gc Node { next: gc_null[Node](), v: i * 3 } catch gc_null[Node]()
        let c: Gc[Node] = make(i + 2)
        stash(&kept, a, i)
        if i % 500 == 0 {
            vec_push[Holder](&v, Holder { n: b })
        }
        let e: Gc[Node] = echo(c)
        if i % 11 == 0 {
            echoed = e
        }
        let t: Gc[Node] = make(i + 5)
        if i % 9 == 0 {
            carry = t
        }
        if i % 1000 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    gc_collect()
    var s: u64 = 0
    var j: usize = 0
    while j < vec_len[Holder](&v) {
        s = s + (*vec_elem_ptr[Holder](&v, j)).n.v
        j = j + 1
    }
    io.fmt_print_line(f"{kept.v} {echoed.v} {carry.v} {s}")
    return 0
}
