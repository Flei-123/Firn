import std.io

gc class Item {
    id: u64,
    w: u64,
}

fn make_item(i: u64) -> Gc[Item] {
    return gc Item { id: i, w: i % 13 } catch gc_null[Item]()
}

fn make_either(i: u64) -> Gc[Item] {
    if i % 2 == 0 {
        return make_item(i)
    }
    return gc Item { id: i + 1, w: 2 } catch gc_null[Item]()
}

fn score(t: Gc[Item]) -> u64 {
    return t.id + t.w
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var i: u64 = 0
    while i < 20000 {
        let a: Gc[Item] = make_item(i)
        let b: Gc[Item] = make_either(i)
        total = total + score(a) + score(b)
        if i % 4000 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
