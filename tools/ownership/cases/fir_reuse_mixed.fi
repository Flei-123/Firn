import std.io

gc class Small {
    v: u64,
}

gc class Big {
    a: u64,
    b: u64,
    c: u64,
    d: u64,
    e: u64,
    f: u64,
    g: u64,
    h: u64,
    i: u64,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var i: u64 = 0
    while i < 30000 {
        let s: Gc[Small] = gc Small { v: i } catch gc_null[Small]()
        total = total + s.v
        let b: Gc[Big] = gc Big { a: i, b: 1, c: 2, d: 3, e: 4, f: 5, g: 6, h: 7, i: i * 2 } catch gc_null[Big]()
        total = total + b.a + b.i + b.h
        let t: Gc[Small] = gc Small { v: i + 3 } catch gc_null[Small]()
        total = total + t.v
        if i % 7000 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    io.fmt_print_line(f"mixed {total}")
    return 0
}
