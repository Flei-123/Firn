import std.io

fn count_x(s: str) -> u64 {
    var k: u64 = 0
    var i: usize = 0
    while i < s.n {
        if s[i] == 120 {
            k = k + 1
        }
        i = i + 1
    }
    return k
}

fn keep(slot: *mut str, s: str) {
    *slot = s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var saved: [str; 4] = ["", "", "", ""]
    var total: u64 = 0
    var i: u64 = 0
    while i < 20000 {
        let a: str = "x" + "yx"
        let b: str = a + "zx"
        total = total + count_x(b)
        let c: str = b + "q"
        keep(&saved[(i % 4) as usize], c)
        i = i + 1
    }
    var big: str = ""
    var j: u64 = 0
    while j < 200 {
        big = big + "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        j = j + 1
    }
    io.fmt_print_line(f"{saved[0]}{saved[1]}{saved[2]}{saved[3]} {total} {big.n}")
    return 0
}
