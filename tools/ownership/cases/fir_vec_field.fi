import std.io

gc class Bag {
    items: Gc[GcVec],
    tag: u64,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let bags: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
    var i: u64 = 0
    while i < 400 {
        let v: Gc[GcVec] = gcvec_new_raw() catch gc_null[GcVec]()
        let ok: bool = gcvec_append_raw(v, i * 7) catch false
        if !ok { return 2 }
        let b: Gc[Bag] = gc Bag { items: v, tag: i } catch gc_null[Bag]()
        let ok2: bool = gcvec_append[Bag](bags, b) catch false
        if !ok2 { return 3 }
        if i % 100 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    var total: u64 = 0
    var k: u64 = 0
    while k < gcvec_length(bags) {
        let b: Gc[Bag] = gcvec_read[Bag](bags, k)
        total = total + gcvec_read_raw(b.items, 0) + b.tag
        k = k + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
