import std.io

fn num(i: u64) -> str {
    if i % 3 == 0 {
        return ""
    }
    return "n"
}

fn width(s: str) -> u64 {
    return s.n as u64
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var i: u64 = 0
    while i < 30000 {
        let a: str = "ab" + num(i)
        let b: str = a + "cd"
        let c: str = b + num(i + 1)
        total = total + width(c) + (b.n as u64)
        i = i + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
