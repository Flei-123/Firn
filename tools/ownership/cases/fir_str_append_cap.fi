import std.io

fn byte(s: str, i: u64) -> u64 {
    return (*(((s.p as u64) + i) as *mut u8)) as u64
}

#[no_inline]
fn fill(k: u64, step: u64) -> str {
    var s: str = ""
    var i: u64 = 0
    while i < k {
        if step == 1 {
            s = s + "a"
        } else {
            s = s + "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+/"
        }
        i = i + 1
    }
    return s
}

fn check(s: str, step: u64) -> bool {
    var i: u64 = 0
    let pat: str = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ+/"
    while i < (s.n as u64) {
        var want: u64 = 97
        if step != 1 {
            want = byte(pat, i % 64)
        }
        if byte(s, i) != want {
            return false
        }
        i = i + 1
    }
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var k: u64 = 0
    var bad: u64 = 0
    var total: u64 = 0
    while k < 300 {
        let a: str = fill(k, 1)
        let b: str = fill(k, 64)
        if (a.n as u64) != k || (b.n as u64) != k * 64 || !check(a, 1) || !check(b, 64) {
            bad = bad + 1
        }
        total = total + (a.n as u64) + (b.n as u64)
        k = k + 1
    }
    io.fmt_print_line(f"cap bad {bad} total {total}")
    if bad != 0 { return 2 }
    return 0
}
