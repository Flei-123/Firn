import std.io

gc class Node {
    left: Gc[Node],
    right: Gc[Node],
    v: u64,
}

gc class Holder {
    keep: Gc[Node],
    next: Gc[Holder],
}

fn leaf(v: u64) -> Gc[Node] {
    return gc Node { left: gc_null[Node](), right: gc_null[Node](), v: v } catch gc_null[Node]()
}

fn build(d: u32, v: u64) -> Gc[Node] {
    if d == 0 {
        return leaf(v)
    }
    let l: Gc[Node] = build(d - 1, v * 2)
    let r: Gc[Node] = build(d - 1, v * 2 + 1)
    return gc Node { left: l, right: r, v: v } catch gc_null[Node]()
}

fn sum(t: Gc[Node]) -> u64 {
    if t == gc_null[Node]() {
        return 0
    }
    return t.v + sum(t.left) + sum(t.right)
}

fn holder() -> Gc[Holder] {
    return gc Holder { keep: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
}

fn garbage(sink: Gc[Holder], n: u64) {
    var i: u64 = 0
    while i < n {
        let dead: Gc[Holder] = holder()
        sink.next = dead
        i = i + 1
    }
}

#[no_inline]
fn swap(t: Gc[Node]) {
    let x: Gc[Node] = t.left
    t.left = t.right
    t.right = x
}

#[no_inline]
fn steal(t: Gc[Node], h: Gc[Holder]) {
    h.keep = t.right
    t.right = gc_null[Node]()
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    let h: Gc[Holder] = holder()
    var total: u64 = 0
    var cur: Gc[Node] = build(3, 1)
    var i: u64 = 0
    while i < 400 {
        let a: Gc[Node] = build(3, i)
        var k: u64 = 0
        while k < 3 {
            swap(a)
            k = k + 1
        }
        total = total + sum(a)
        let b: Gc[Node] = build(3, i + 1)
        steal(b, h)
        total = total + sum(b)
        garbage(h, 30)
        total = total + sum(h.keep)
        var p: Gc[Node] = build(4, i + 2)
        var n: u64 = 0
        while p != gc_null[Node]() {
            total = total + p.v
            if n % 2 == 0 {
                p = p.left
            } else {
                p = p.right
            }
            n = n + 1
        }
        total = total + sum(cur)
        cur = build(3, i + 3)
        garbage(h, 20)
        if i % 59 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    total = total + sum(cur)
    io.fmt_print_line(f"total {total}")
    return 0
}
