import std.io

gc class Node {
    left: Gc[Node],
    right: Gc[Node],
    v: u64,
}

gc class Holder {
    keep: Gc[Node],
    next: Gc[Holder],
}

fn leaf(v: u64) -> Gc[Node] {
    return gc Node { left: gc_null[Node](), right: gc_null[Node](), v: v } catch gc_null[Node]()
}

fn build(d: u32, v: u64) -> Gc[Node] {
    if d == 0 {
        return leaf(v)
    }
    let l: Gc[Node] = build(d - 1, v * 2)
    let r: Gc[Node] = build(d - 1, v * 2 + 1)
    return gc Node { left: l, right: r, v: v } catch gc_null[Node]()
}

fn pair(a: Gc[Node], b: Gc[Node]) -> Gc[Node] {
    return gc Node { left: a, right: b, v: 3 } catch gc_null[Node]()
}

fn sum(t: Gc[Node]) -> u64 {
    if t == gc_null[Node]() {
        return 0
    }
    return t.v + sum(t.left) + sum(t.right)
}

fn keep_in(h: Gc[Holder], t: Gc[Node]) {
    h.keep = t
}

fn keep_left(h: Gc[Holder], t: Gc[Node]) {
    h.keep = t.left
}

fn push_right(vs: Gc[GcVec], t: Gc[Node]) -> bool {
    return gcvec_append[Node](vs, t.right) catch false
}

fn garbage(sink: Gc[Holder], n: u64) {
    var i: u64 = 0
    while i < n {
        let dead: Gc[Holder] = gc Holder { keep: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
        sink.next = dead
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    let h: Gc[Holder] = gc Holder { keep: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
    let h2: Gc[Holder] = gc Holder { keep: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
    let vs: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
    var total: u64 = 0
    var i: u64 = 0
    while i < 300 {
        let a: Gc[Node] = build(3, i)
        let b: Gc[Node] = pair(a, build(2, i + 1))
        total = total + sum(b)
        let c: Gc[Node] = build(3, i + 2)
        keep_left(h, c)
        total = total + sum(c)
        let d: Gc[Node] = build(3, i + 3)
        let ok: bool = push_right(vs, d)
        if !ok {
            return 4
        }
        total = total + sum(d)
        let e: Gc[Node] = build(2, i + 4)
        let f: Gc[Node] = pair(e, e)
        keep_in(h2, e)
        total = total + sum(f)
        garbage(h, 40)
        if i % 37 == 0 {
            gc_collect()
        }
        total = total + sum(h.keep) + sum(h2.keep)
        i = i + 1
    }
    gc_collect()
    var k: u64 = 0
    while k < gcvec_length(vs) {
        total = total + sum(gcvec_read[Node](vs, k))
        k = k + 1
    }
    io.fmt_print_line(f"total {total} kept {gcvec_length(vs)}")
    return 0
}
