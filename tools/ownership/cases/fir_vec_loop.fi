import std.io

gc class Item {
    id: u64,
    w: u64,
}

fn fill(v: Gc[GcVec], i: u64) -> AllocError!bool {
    var k: u64 = 0
    while k < 12 {
        let it: Gc[Item] = try gc Item { id: i + k, w: k }
        if !(try gcvec_append[Item](v, it)) {
            return false
        }
        k = k + 1
    }
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var i: u64 = 0
    while i < 3000 {
        let v: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
        let ok: bool = fill(v, i) catch false
        if !ok { return 2 }
        var k: u64 = 0
        let n: u64 = gcvec_length(v)
        while k < n {
            let it: Gc[Item] = gcvec_read[Item](v, k)
            total = total + it.id * 3 + it.w
            k = k + 1
        }
        if i % 700 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
