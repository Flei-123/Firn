#[no_inline]
fn build(k: u64) -> str {
    var s: str = ""
    var i: u64 = 0
    while i < k {
        s = s + "abc"
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let s: str = build(1000)
    if (s.n as u64) != 3000 { return 2 }
    if gc_own_appended() < 900 { return 3 }
    return 0
}
