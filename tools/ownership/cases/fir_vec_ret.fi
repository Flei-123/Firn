import std.io

fn squares(n: u64) -> Gc[GcVec] {
    let v: Gc[GcVec] = gcvec_new_raw() catch gc_null[GcVec]()
    var i: u64 = 0
    while i < n {
        let ok: bool = gcvec_append_raw(v, i * i) catch false
        if !ok { return v }
        i = i + 1
    }
    return v
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var r: u64 = 0
    while r < 2000 {
        let v: Gc[GcVec] = squares(r % 40 + 1)
        total = total + gcvec_read_raw(v, gcvec_length(v) - 1) + gcvec_length(v)
        if r % 500 == 0 {
            gc_collect()
        }
        r = r + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
