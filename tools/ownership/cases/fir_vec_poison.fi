gc class Holder {
    v: Gc[GcVec],
    n: u64,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let v: Gc[GcVec] = gcvec_new_raw() catch gc_null[GcVec]()
    let ok: bool = gcvec_append_raw(v, 5) catch false
    if !ok { return 2 }
    let h: Gc[Holder] = gc Holder { v: v, n: 1 } catch gc_null[Holder]()
    __own_drop_slots_owner_check(v as u64 as *mut u8)
    gc_own_verify()
    return (h.n as i32) + 40
}
