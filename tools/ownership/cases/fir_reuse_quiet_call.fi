import std.io

gc class Node {
    next: Gc[Node],
    v: u64,
}

#[no_inline]
fn mix(x: u64) -> u64 {
    var h: u64 = x *% 1099511628211
    var k: u64 = 0
    while k < 3 {
        h = (h ^ (h >> 13)) *% 6364136223846793005
        k = k + 1
    }
    return h
}

#[no_inline]
fn depth(x: u64) -> u64 {
    if x < 2 { return mix(x) }
    return depth(x / 2) + 1
}

#[no_inline]
fn noisy(x: u64) -> u64 {
    let t: Gc[Node] = gc Node { next: gc_null[Node](), v: x } catch gc_null[Node]()
    return t.v + 1
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var j: u64 = 0
    while j < 30000 {
        let a: Gc[Node] = gc Node { next: gc_null[Node](), v: j } catch gc_null[Node]()
        total = total +% a.v
        total = total +% mix(j) +% depth(j)
        let b: Gc[Node] = gc Node { next: gc_null[Node](), v: j + 1 } catch gc_null[Node]()
        total = total +% b.v * 2
        total = total +% noisy(j)
        let c: Gc[Node] = gc Node { next: gc_null[Node](), v: j + 2 } catch gc_null[Node]()
        total = total +% c.v
        if j % 5000 == 0 {
            gc_collect()
        }
        j = j + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
