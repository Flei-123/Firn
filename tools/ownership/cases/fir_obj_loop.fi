import std.io

gc class Node {
    next: Gc[Node],
    v: u64,
}

fn weight(n: Gc[Node]) -> u64 {
    return n.v * 3 + 1
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var i: u64 = 0
    while i < 30000 {
        let n: Gc[Node] = gc Node { next: gc_null[Node](), v: i } catch gc_null[Node]()
        let m: Gc[Node] = gc Node { next: n, v: i + 7 } catch gc_null[Node]()
        total = total + weight(m) + weight(m.next)
        if i % 5000 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
