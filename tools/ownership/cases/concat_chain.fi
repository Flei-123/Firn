import std.io


fn num(i: u64) -> str {
    if i % 3 == 0 {
        return ""
    }
    return "n"
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var acc: str = ""
    var i: u64 = 0
    var total: u64 = 0
    while i < 20000 {
        let a: str = "<" + num(i) + ">"
        let b: str = a + "x" + num(i + 1) + "y" + a + "z" + "" + a
        let c: str = "" + "" + num(i) + ""
        let h: str = b + c + "!"
        total = total + (b.n as u64) + (c.n as u64) + (h.n as u64)
        if i % 5000 == 0 {
            acc = acc + b + "|" + c + ";"
        }
        i = i + 1
    }
    io.fmt_print_line(f"{acc}")
    io.fmt_print_line(f"total {total}")
    return 0
}
