gc class Pad {
    v: u64,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var i: u64 = 0
    while i < 1000 {
        let v: Gc[GcVec] = gcvec_new_raw() catch gc_null[GcVec]()
        let a: bool = gcvec_append_raw(v, i) catch false
        let b: bool = gcvec_append_raw(v, i + 1) catch false
        if !a || !b { return 2 }
        total = total + gcvec_read_raw(v, 0) + gcvec_read_raw(v, 1) + gcvec_length(v)
        i = i + 1
    }
    if total == 0 { return 3 }
    if (gc_own_freed() + gc_own_poisoned()) < 2000 { return 4 }
    return 0
}
