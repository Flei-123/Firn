gc class Node {
    left: Gc[Node],
    right: Gc[Node],
    v: u64,
}

fn build(d: u32, v: u64) -> Gc[Node] {
    if d == 0 {
        return gc Node { left: gc_null[Node](), right: gc_null[Node](), v: v } catch gc_null[Node]()
    }
    let l: Gc[Node] = build(d - 1, v * 2)
    let r: Gc[Node] = build(d - 1, v * 2 + 1)
    return gc Node { left: l, right: r, v: v } catch gc_null[Node]()
}

fn sum(t: Gc[Node]) -> u64 {
    if t == gc_null[Node]() {
        return 0
    }
    return t.v + sum(t.left) + sum(t.right)
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    var total: u64 = 0
    var i: u64 = 0
    while i < 1000 {
        total = total + sum(build(6, 1))
        i = i + 1
    }
    let kept: Gc[Node] = build(4, 1)
    let again: Gc[Node] = kept
    total = total + sum(again)
    if total == 0 {
        return 1
    }
    if gc_own_freed() + gc_own_poisoned() < 127000 {
        return 2
    }
    if gc_own_freed() + gc_own_poisoned() > 127000 + 31 {
        return 3
    }
    gc_own_verify()
    return 0
}
