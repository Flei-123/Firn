import std.io

gc class Node {
    next: Gc[Node],
    v: u64,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var head: Gc[Node] = gc_null[Node]()
    var i: u64 = 0
    while i < 5000 {
        let tmp: Gc[Node] = gc Node { next: gc_null[Node](), v: i } catch gc_null[Node]()
        let cell: Gc[Node] = gc Node { next: tmp, v: 0 } catch gc_null[Node]()
        if i % 3 == 0 {
            let n: Gc[Node] = gc Node { next: head, v: cell.next.v } catch gc_null[Node]()
            head = n
        }
        if i % 1000 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    let holder: Gc[Node] = gc Node { next: gc_null[Node](), v: 0 } catch gc_null[Node]()
    var k: u64 = 0
    while k < 100 {
        let c: Gc[Node] = gc Node { next: gc_null[Node](), v: k } catch gc_null[Node]()
        holder.next = c
        k = k + 1
    }
    gc_collect()
    var total: u64 = 0
    var p: Gc[Node] = head
    while p != gc_null[Node]() {
        total = total + p.v
        p = p.next
    }
    io.fmt_print_line(f"total {total} last {holder.next.v}")
    return 0
}
