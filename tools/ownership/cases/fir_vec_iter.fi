import std.io

gc class Node {
    v: u64,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let keep: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
    var total: u64 = 0
    var r: u64 = 0
    while r < 500 {
        let tmp: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
        var i: u64 = 0
        while i < 8 {
            let n: Gc[Node] = gc Node { v: r + i } catch gc_null[Node]()
            let ok: bool = gcvec_append[Node](tmp, n) catch false
            if !ok { return 2 }
            i = i + 1
        }
        var k: u64 = 0
        while k < gcvec_length(tmp) {
            let n: Gc[Node] = gcvec_read[Node](tmp, k)
            if n.v % 3 == 0 {
                let ok: bool = gcvec_append[Node](keep, n) catch false
                if !ok { return 3 }
            }
            k = k + 1
        }
        if r % 100 == 0 {
            gc_collect()
        }
        r = r + 1
    }
    var k: u64 = 0
    while k < gcvec_length(keep) {
        total = total + gcvec_read[Node](keep, k).v
        k = k + 1
    }
    io.fmt_print_line(f"kept {gcvec_length(keep)} total {total}")
    return 0
}
