import std.io

gc class Item {
    id: u64,
    w: u64,
}

fn fill(v: Gc[GcVec], i: u64, n: u64) -> AllocError!bool {
    var k: u64 = 0
    while k < n {
        let it: Gc[Item] = try gc Item { id: i + k, w: k }
        if !(try gcvec_append[Item](v, it)) {
            return false
        }
        k = k + 1
    }
    return true
}

fn short_lived(i: u64) -> u64 {
    let v: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
    let ok: bool = fill(v, i, 3 + i % 9) catch false
    if !ok { return 0 }
    var s: u64 = 0
    var k: u64 = 0
    let n: u64 = gcvec_length(v)
    while k < n {
        let it: Gc[Item] = gcvec_read[Item](v, k)
        s = s + it.id + it.w
        k = k + 1
    }
    return s
}

fn holes(keep: Gc[GcVec]) -> bool {
    var i: u64 = 0
    while i < 3000 {
        let v: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
        let ok: bool = fill(v, i, 1 + i % 13) catch false
        if !ok { return false }
        if i % 3 == 0 {
            let kept: bool = gcvec_append[GcVec](keep, v) catch false
            if !kept { return false }
        }
        i = i + 1
    }
    gc_collect()
    return true
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    gc_set_incr_ab(0)
    gc_set_time_budget(1)
    gc_set_slice(16)
    let keep: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
    if !holes(keep) { return 2 }
    let sink: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
    var r: u64 = 0
    while r < 64 {
        let g: Gc[Item] = gc Item { id: r, w: 0 } catch gc_null[Item]()
        let ok: bool = gcvec_append[Item](sink, g) catch false
        if !ok { return 3 }
        r = r + 1
    }
    var total: u64 = 0
    var swept: u64 = 0
    var i: u64 = 0
    while i < 60000 {
        if gc_phase() == 2 {
            swept = swept + 1
        }
        total = total + short_lived(i)
        let g: Gc[Item] = gc Item { id: i, w: 1 } catch gc_null[Item]()
        gcvec_set[Item](sink, i % 64, g)
        i = i + 1
    }
    if swept == 0 { return 4 }
    io.fmt_print_line(f"total {total} kept {gcvec_length(keep)}")
    return 0
}
