import std.io

gc class Pad {
    v: u64,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: i64 = 0
    var i: i64 = 0
    while i < 3000 {
        let k: i64 = i % 7
        let f: fn(i64) -> i64 = gc fn(a: i64) -> i64 { return a * k + 1 } catch fn(a: i64) -> i64 { return a }
        total = total + f(i) + f(3)
        if i % 700 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
