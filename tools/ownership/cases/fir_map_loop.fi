import std.io

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var r: u64 = 0
    while r < 1500 {
        let m: Gc[GcMap] = gcmap_new(false, false) catch gc_null[GcMap]()
        var i: u64 = 1
        while i < 20 {
            let ok: bool = gcmap_set(m, i * 13 + r, i) catch false
            if !ok { return 2 }
            i = i + 1
        }
        total = total + gcmap_get(m, 5 * 13 + r, 0) + gcmap_size(m)
        if r % 400 == 0 {
            gc_collect()
        }
        r = r + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
