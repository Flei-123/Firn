import std.io

fn sum(s: str) -> u64 {
    var h: u64 = 7
    var i: u64 = 0
    while i < (s.n as u64) {
        h = h *% 31 +% ((*(((s.p as u64) + i) as *mut u8)) as u64)
        i = i + 1
    }
    return h
}

#[no_inline]
fn grow(s0: str, k: u64, tag: str) -> str {
    var s: str = s0
    var i: u64 = 0
    while i < k {
        s = s + tag
        i = i + 1
    }
    return s
}

#[no_inline]
fn twice(k: u64) -> u64 {
    let base: str = grow("", k, "ab")
    let x: str = grow(base, 1, "X")
    let y: str = grow(base, 1, "Y")
    let z: str = grow(x, 2, "Z")
    let pre: str = str { p: z.p, n: 3 }
    let w: str = grow(pre, 1, "W")
    io.fmt_print_line(f"{base.n} {x.n} {y.n} {z.n} {w.n}")
    return sum(base) +% sum(x) *% 3 +% sum(y) *% 5 +% sum(z) *% 7 +% sum(w) *% 11
}

#[no_inline]
fn kept(k: u64) -> u64 {
    var s: str = "s"
    var keep: str = ""
    var i: u64 = 0
    var h: u64 = 0
    while i < k {
        if i == k / 2 {
            keep = s
        }
        s = s + "q"
        h = h +% sum(keep)
        i = i + 1
    }
    return h +% sum(s) +% sum(keep)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var h: u64 = 0
    var k: u64 = 0
    while k < 12 {
        h = h +% twice(k * 7) +% kept(k * 9)
        k = k + 1
    }
    io.fmt_print_line(f"alias {h}")
    return 0
}
