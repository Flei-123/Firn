gc class Point {
    x: u64,
    y: u64,
}

gc class Cell {
    next: Gc[Cell],
    v: u64,
}

fn norm(p: Gc[Point]) -> u64 {
    return p.x * p.x + p.y * p.y
}

fn cell_value(c: Gc[Cell]) -> u64 {
    if c == gc_null[Cell]() {
        return 0
    }
    return c.v
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    var total: u64 = 0
    var keep: Gc[Point] = gc_null[Point]()
    var i: u64 = 0
    while i < 1000 {
        let p: Gc[Point] = gc Point { x: i, y: 2 } catch gc_null[Point]()
        p.x = p.x + 1
        total = total + norm(p)
        let c: Gc[Cell] = gc Cell { next: gc_null[Cell](), v: i } catch gc_null[Cell]()
        c.v += 3
        total = total + cell_value(c)
        let q: Gc[Point] = gc Point { x: 5, y: i } catch gc_null[Point]()
        keep = q
        i = i + 1
    }
    gc_collect()
    if keep.x != 5 || keep.y != 999 {
        return 4
    }
    if total == 0 {
        return 1
    }
    let n: u64 = gc_own_freed() + gc_own_poisoned()
    if n < 2000 {
        return 2
    }
    if n > 2000 {
        return 5
    }
    gc_own_verify()
    return 0
}
