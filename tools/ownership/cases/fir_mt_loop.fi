import std.io

gc class Item {
    id: u64,
    w: u64,
}

gc class Cell {
    next: Gc[Cell],
    value: u64,
}

const ROUNDS: u64 = 20000

fn make_item(i: u64) -> Gc[Item] {
    return gc Item { id: i, w: 1 } catch gc_null[Item]()
}

fn tag(i: u64) -> str {
    if i % 3 == 0 {
        return ""
    }
    return "t"
}

fn chain_sum(h: Gc[Cell]) -> u64 {
    var p: Gc[Cell] = h
    var s: u64 = 0
    while p != gc_null[Cell]() {
        s = s + p.value
        p = p.next
    }
    return s
}

fn work(kind: u64) -> u64 {
    var keep: Gc[Cell] = gc_null[Cell]()
    var total: u64 = 0
    var i: u64 = 0
    while i < ROUNDS {
        let a: Gc[Item] = gc Item { id: i, w: kind } catch gc_null[Item]()
        let b: Gc[Item] = make_item(i)
        let s: str = "ab" + tag(i)
        let t: str = s + "cd" + tag(i + kind)
        total = total + a.id + b.w + a.w + (t.n as u64)
        if i % 50 == 0 {
            keep = gc Cell { next: keep, value: i + kind } catch keep
        }
        if i % 4000 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    return total + chain_sum(keep)
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    let _unused: u64 = arg
    return work(kind)
}

fn run_set(n: u64) -> u64 {
    var h: [u64; 4] = [0; 4]
    var i: u64 = 0
    while i < n {
        h[i as usize] = thread_start(i + 1, 0)
        if h[i as usize] == 0 {
            return 0
        }
        i = i + 1
    }
    var s: u64 = work(9)
    i = 0
    while i < n {
        s = s + thread_wait(h[i as usize])
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() { return 90 }
    if !thread_init() { return 91 }
    let a: u64 = run_set(4)
    gc_set_local(1)
    let b: u64 = run_set(4)
    io.fmt_print_line(f"mt total {a} {b}")
    return 0
}
