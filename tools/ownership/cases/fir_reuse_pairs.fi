import std.io

gc class Pair {
    a: u64,
    b: u64,
}

fn step(p: Gc[Pair]) -> Gc[Pair] {
    return gc Pair { a: p.b, b: (p.a + p.b) % 1000003 } catch gc_null[Pair]()
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var p: Gc[Pair] = gc Pair { a: 0, b: 1 } catch gc_null[Pair]()
    var i: u64 = 0
    var acc: u64 = 0
    while i < 40000 {
        let q: Gc[Pair] = gc Pair { a: p.b, b: (p.a + p.b) % 1000003 } catch gc_null[Pair]()
        acc = acc + q.a
        p = q
        if i % 10000 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    var k: u64 = 0
    while k < 1000 {
        p = step(p)
        k = k + 1
    }
    io.fmt_print_line(f"pair {p.a} {p.b} acc {acc}")
    return 0
}
