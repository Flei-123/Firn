import std.io

gc class Holder {
    f: fn(i64) -> i64,
    tag: i64,
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let keep: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
    var i: i64 = 0
    while i < 300 {
        let k: i64 = i
        let f: fn(i64) -> i64 = gc fn(a: i64) -> i64 { return a + k } catch fn(a: i64) -> i64 { return a }
        let h: Gc[Holder] = gc Holder { f: f, tag: i } catch gc_null[Holder]()
        let ok: bool = gcvec_append[Holder](keep, h) catch false
        if !ok { return 2 }
        i = i + 1
    }
    var total: i64 = 0
    var j: u64 = 0
    while j < gcvec_length(keep) {
        let h: Gc[Holder] = gcvec_read[Holder](keep, j)
        total = total + apply(h.f, 10) + h.tag
        j = j + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
