import std.io

gc class Holder {
    f: fn(i64) -> i64,
    tag: i64,
}

gc class Table {
    fs: [fn(i64) -> i64; 4],
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let keep: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
    var i: i64 = 0
    while i < 300 {
        let k: i64 = i
        let f: fn(i64) -> i64 = gc fn(a: i64) -> i64 { return a + k } catch fn(a: i64) -> i64 { return a }
        let h: Gc[Holder] = gc Holder { f: f, tag: i } catch gc_null[Holder]()
        let ok: bool = gcvec_append[Holder](keep, h) catch false
        if !ok { return 2 }
        i = i + 1
    }
    gc_collect()
    var total: i64 = 0
    var j: u64 = 0
    while j < gcvec_length(keep) {
        let h: Gc[Holder] = gcvec_read[Holder](keep, j)
        total = total + apply(h.f, 10) + h.tag
        j = j + 1
    }
    let k0: i64 = 7
    let g0: fn(i64) -> i64 = gc fn(a: i64) -> i64 { return a + k0 } catch fn(a: i64) -> i64 { return a }
    let g1: fn(i64) -> i64 = gc fn(a: i64) -> i64 { return a * k0 } catch fn(a: i64) -> i64 { return a }
    let t: Gc[Table] = gc Table { fs: [g0, g1, g0, g1] } catch gc_null[Table]()
    gc_collect()
    var q: usize = 0
    while q < 4 {
        total = total + apply(t.fs[q], 3)
        q = q + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
