gc class Cell {
    next: Gc[Cell],
    v: u64,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let child: Gc[Cell] = gc Cell { next: gc_null[Cell](), v: 7 } catch gc_null[Cell]()
    let parent: Gc[Cell] = gc Cell { next: child, v: 1 } catch gc_null[Cell]()
    let lone: Gc[Cell] = gc Cell { next: gc_null[Cell](), v: 9 } catch gc_null[Cell]()
    __gc_poison_block(lone as u64 as *mut u8)
    gc_own_verify()
    __gc_poison_block(child as u64 as *mut u8)
    gc_own_verify()
    return (parent.v as i32) + 40
}
