import std.io

gc class Node {
    left: Gc[Node],
    right: Gc[Node],
    v: u64,
}

gc class Holder {
    keep: Gc[Node],
    next: Gc[Holder],
}

fn leaf(v: u64) -> Gc[Node] {
    return gc Node { left: gc_null[Node](), right: gc_null[Node](), v: v } catch gc_null[Node]()
}

fn build(d: u32, v: u64) -> Gc[Node] {
    if d == 0 {
        return leaf(v)
    }
    let l: Gc[Node] = build(d - 1, v * 2)
    let r: Gc[Node] = build(d - 1, v * 2 + 1)
    return gc Node { left: l, right: r, v: v } catch gc_null[Node]()
}

fn sum(t: Gc[Node]) -> u64 {
    if t == gc_null[Node]() {
        return 0
    }
    return t.v + sum(t.left) + sum(t.right)
}

fn holder() -> Gc[Holder] {
    return gc Holder { keep: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
}

fn garbage(sink: Gc[Holder], n: u64) {
    var i: u64 = 0
    while i < n {
        let dead: Gc[Holder] = holder()
        sink.next = dead
        i = i + 1
    }
}

#[no_inline]
fn keep_right(h: Gc[Holder], t: Gc[Node]) {
    h.keep = t.right
}

fn work(kind: u64) -> u64 {
    let h: Gc[Holder] = holder()
    var total: u64 = 0
    var i: u64 = 0
    while i < 3000 {
        total = total + sum(build(4, i + kind))
        let a: Gc[Node] = build(3, i)
        keep_right(h, a)
        total = total + sum(a)
        garbage(h, 10)
        total = total + sum(h.keep)
        if i % 500 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    return total
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    let _unused: u64 = arg
    return work(kind)
}

fn run_set(n: u64) -> u64 {
    var hs: [u64; 4] = [0; 4]
    var i: u64 = 0
    while i < n {
        hs[i as usize] = thread_start(i + 1, 0)
        if hs[i as usize] == 0 {
            return 0
        }
        i = i + 1
    }
    var s: u64 = work(9)
    i = 0
    while i < n {
        s = s + thread_wait(hs[i as usize])
        i = i + 1
    }
    return s
}

fn main() -> i32 {
    if !gc_init() {
        return 90
    }
    if !thread_init() {
        return 91
    }
    let a: u64 = run_set(4)
    gc_set_local(1)
    let b: u64 = run_set(4)
    io.fmt_print_line(f"mt total {a} {b}")
    return 0
}
