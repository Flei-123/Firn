import std.io

fn squares(n: u64) -> Gc[GcVec] {
    let v: Gc[GcVec] = gcvec_new_raw() catch gc_null[GcVec]()
    var i: u64 = 0
    while i < n {
        let ok: bool = gcvec_append_raw(v, i * i) catch false
        if !ok { return v }
        i = i + 1
    }
    return v
}

fn wrapped(n: u64) -> Gc[GcVec] {
    return squares(n + 1)
}

fn main() -> i32 {
    if !gc_init() { return 3 }
    var total: u64 = 0
    var r: u64 = 0
    while r < 2000 {
        let v: Gc[GcVec] = wrapped(r % 40)
        total = total + gcvec_read_raw(v, gcvec_length(v) - 1) + gcvec_length(v)
        r = r + 1
    }
    io.fmt_print_line(f"total {total} freed {gc_own_freed() + gc_own_poisoned()}")
    if total != 1068000 { return 1 }
    if gc_own_freed() + gc_own_poisoned() < 4000 { return 2 }
    gc_own_verify()
    return 0
}
