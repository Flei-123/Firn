import std.io

gc class Node {
    left: Gc[Node],
    right: Gc[Node],
    v: u64,
}

gc class Holder {
    keep: Gc[Node],
    next: Gc[Holder],
}

fn leaf(v: u64) -> Gc[Node] {
    return gc Node { left: gc_null[Node](), right: gc_null[Node](), v: v } catch gc_null[Node]()
}

fn build(d: u32, v: u64) -> Gc[Node] {
    if d == 0 {
        return leaf(v)
    }
    let l: Gc[Node] = build(d - 1, v * 2)
    let r: Gc[Node] = build(d - 1, v * 2 + 1)
    return gc Node { left: l, right: r, v: v } catch gc_null[Node]()
}

fn sum(t: Gc[Node]) -> u64 {
    if t == gc_null[Node]() {
        return 0
    }
    return t.v + sum(t.left) + sum(t.right)
}

fn holder() -> Gc[Holder] {
    return gc Holder { keep: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
}

fn garbage(sink: Gc[Holder], n: u64) {
    var i: u64 = 0
    while i < n {
        let dead: Gc[Holder] = holder()
        sink.next = dead
        i = i + 1
    }
}

fn same(t: Gc[Node]) -> Gc[Node] {
    return t
}

fn pick(a: Gc[Node], b: Gc[Node], k: u64) -> Gc[Node] {
    if k % 2 == 0 {
        return a
    }
    return b
}

fn wrap_same(d: u32, v: u64) -> Gc[Node] {
    let c: Gc[Node] = same(build(d, v))
    return gc Node { left: c, right: gc_null[Node](), v: v } catch gc_null[Node]()
}

fn wrap_pick(d: u32, v: u64) -> Gc[Node] {
    let a: Gc[Node] = build(d, v)
    let b: Gc[Node] = build(d, v + 1)
    let c: Gc[Node] = pick(a, b, v)
    return gc Node { left: c, right: a, v: v } catch gc_null[Node]()
}

fn wrap_kept(h: Gc[Holder], v: u64) -> Gc[Node] {
    let c: Gc[Node] = build(2, v)
    h.keep = c
    return gc Node { left: c, right: gc_null[Node](), v: v } catch gc_null[Node]()
}

fn wrap_twice(d: u32, v: u64) -> Gc[Node] {
    let c: Gc[Node] = build(d, v)
    let x: Gc[Node] = gc Node { left: c, right: gc_null[Node](), v: v } catch gc_null[Node]()
    return gc Node { left: x, right: c, v: v } catch gc_null[Node]()
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    let h: Gc[Holder] = holder()
    let h2: Gc[Holder] = holder()
    var total: u64 = 0
    var i: u64 = 0
    while i < 400 {
        let a: Gc[Node] = wrap_same(3, i)
        total = total + sum(a)
        let b: Gc[Node] = wrap_pick(2, i)
        total = total + sum(b)
        let c: Gc[Node] = wrap_kept(h2, i)
        total = total + sum(c)
        let d: Gc[Node] = wrap_twice(2, i)
        total = total + sum(d)
        garbage(h, 40)
        total = total + sum(h2.keep)
        if i % 53 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
