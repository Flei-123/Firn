gc class Cell {
    next: Gc[Cell],
    v: u64,
}

fn mk(v: u64) -> Gc[Cell] {
    return gc Cell { next: gc_null[Cell](), v: v } catch gc_null[Cell]()
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    let a: Gc[Cell] = mk(1)
    let addr: u64 = a as u64
    __gc_free_block(addr as *mut u8)
    let b: Gc[Cell] = mk(2)
    if (b as u64) != addr { return 2 }
    if b.v != 2 { return 3 }
    if gc_own_freed() != 1 { return 4 }
    let f: Gc[Cell] = mk(3)
    gc_finalizer_set(f as u64 as *mut u8, 1)
    __gc_free_block(f as u64 as *mut u8)
    if gc_own_freed() != 1 { return 5 }
    if f.v != 3 { return 6 }
    __gc_free_block(0 as *mut u8)
    __gc_free_block(((b as u64) + 8) as *mut u8)
    if gc_own_freed() != 1 { return 7 }
    var keep: Gc[Cell] = gc_null[Cell]()
    var i: u64 = 0
    var deferred_seen: u64 = 0
    while i < 400000 {
        let c: Gc[Cell] = mk(i)
        if i % 2 == 0 {
            c.next = keep
            keep = c
        } else {
            if gc_phase() != 0 {
                deferred_seen = deferred_seen + 1
            }
            __gc_free_block(c as u64 as *mut u8)
        }
        i = i + 1
    }
    gc_collect()
    var n: u64 = 0
    var p: Gc[Cell] = keep
    while (p as u64) != 0 {
        if p.v % 2 != 0 { return 8 }
        n = n + 1
        p = p.next
    }
    if n != 200000 { return 9 }
    if gc_own_freed() + gc_own_deferred() != 200001 { return 10 }
    if deferred_seen != gc_own_deferred() { return 11 }
    if deferred_seen == 0 { return 12 }
    return 0
}
