import std.io

gc class Node {
    left: Gc[Node],
    right: Gc[Node],
    v: u64,
}

gc class Holder {
    keep: Gc[Node],
    next: Gc[Holder],
}

fn build(d: u32, v: u64) -> Gc[Node] {
    if d == 0 {
        return gc Node { left: gc_null[Node](), right: gc_null[Node](), v: v } catch gc_null[Node]()
    }
    let l: Gc[Node] = build(d - 1, v * 2)
    let r: Gc[Node] = build(d - 1, v * 2 + 1)
    return gc Node { left: l, right: r, v: v } catch gc_null[Node]()
}

fn twin(d: u32) -> Gc[Node] {
    let c: Gc[Node] = build(d, 7)
    return gc Node { left: c, right: c, v: 1 } catch gc_null[Node]()
}

fn wrap(c: Gc[Node]) -> Gc[Node] {
    return gc Node { left: c, right: gc_null[Node](), v: 2 } catch gc_null[Node]()
}

fn sum(t: Gc[Node]) -> u64 {
    if t == gc_null[Node]() {
        return 0
    }
    return t.v + sum(t.left) + sum(t.right)
}

fn grab(t: Gc[Node]) -> Gc[Node] {
    return t.left
}

fn graft(t: Gc[Node], x: Gc[Node]) {
    t.left = x
}

fn stash(h: Gc[Holder], t: Gc[Node]) {
    h.keep = t.right
}

fn garbage(sink: Gc[Holder], n: u64) {
    var i: u64 = 0
    while i < n {
        let dead: Gc[Holder] = gc Holder { keep: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
        sink.next = dead
        i = i + 1
    }
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    let h: Gc[Holder] = gc Holder { keep: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
    var total: u64 = 0
    var i: u64 = 0
    while i < 300 {
        let a: Gc[Node] = build(4, i)
        let c: Gc[Node] = grab(a)
        garbage(h, 50)
        total = total + sum(c)
        let b: Gc[Node] = build(3, i + 1)
        let shared: Gc[Node] = build(2, 5)
        graft(b, shared)
        total = total + sum(b) + sum(shared)
        let t: Gc[Node] = twin(2)
        total = total + sum(t)
        let x: Gc[Node] = build(3, 9)
        let w: Gc[Node] = wrap(x)
        total = total + sum(w) + sum(x)
        let y: Gc[Node] = build(3, i)
        stash(h, y)
        total = total + sum(y)
        if i % 50 == 0 {
            gc_collect()
        }
        total = total + sum(h.keep)
        let fresh: Gc[Node] = build(4, i + 2)
        garbage(h, 20)
        total = total + sum(fresh)
        i = i + 1
    }
    gc_collect()
    io.fmt_print_line(f"total {total}")
    return 0
}
