gc class Item {
    id: u64,
    w: u64,
}

const ROUNDS: u64 = 5000

fn make_item(i: u64) -> Gc[Item] {
    return gc Item { id: i, w: 1 } catch gc_null[Item]()
}

fn work(kind: u64) -> u64 {
    var total: u64 = 0
    var i: u64 = 0
    while i < ROUNDS {
        let a: Gc[Item] = gc Item { id: i, w: kind } catch gc_null[Item]()
        let b: Gc[Item] = make_item(i)
        total = total + a.id + b.w
        if i % 1000 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    return total
}

fn __thread_work(kind: u64, arg: u64) -> u64 {
    let _unused: u64 = arg
    return work(kind)
}

fn main() -> i32 {
    if !gc_init() { return 90 }
    if !thread_init() { return 91 }
    let h1: u64 = thread_start(1, 0)
    let h2: u64 = thread_start(2, 0)
    if h1 == 0 || h2 == 0 { return 92 }
    if thread_multi_threaded() == 0 { return 93 }
    let m: u64 = work(3)
    let r: u64 = thread_wait(h1) + thread_wait(h2) + m
    if r == 0 { return 2 }
    if (gc_own_freed() + gc_own_poisoned()) < 3 * ROUNDS { return 3 }
    return 0
}
