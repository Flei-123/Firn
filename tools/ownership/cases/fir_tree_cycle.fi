import std.io

gc class Node {
    left: Gc[Node],
    right: Gc[Node],
    v: u64,
}

gc class Holder {
    keep: Gc[Node],
    next: Gc[Holder],
}

fn leaf(v: u64) -> Gc[Node] {
    return gc Node { left: gc_null[Node](), right: gc_null[Node](), v: v } catch gc_null[Node]()
}

fn build(d: u32, v: u64) -> Gc[Node] {
    if d == 0 {
        return leaf(v)
    }
    let l: Gc[Node] = build(d - 1, v * 2)
    let r: Gc[Node] = build(d - 1, v * 2 + 1)
    return gc Node { left: l, right: r, v: v } catch gc_null[Node]()
}

fn sum(t: Gc[Node]) -> u64 {
    if t == gc_null[Node]() {
        return 0
    }
    return t.v + sum(t.left) + sum(t.right)
}

fn holder() -> Gc[Holder] {
    return gc Holder { keep: gc_null[Node](), next: gc_null[Holder]() } catch gc_null[Holder]()
}

fn garbage(sink: Gc[Holder], n: u64) {
    var i: u64 = 0
    while i < n {
        let dead: Gc[Holder] = holder()
        sink.next = dead
        i = i + 1
    }
}

#[no_inline]
fn link_back(t: Gc[Node]) {
    if t.left != gc_null[Node]() {
        t.left.right = t
    }
}

fn ring(v: u64) -> Gc[Node] {
    let a: Gc[Node] = leaf(v)
    let b: Gc[Node] = gc Node { left: a, right: gc_null[Node](), v: v + 1 } catch gc_null[Node]()
    a.right = b
    return b
}

fn either(d: u32, v: u64) -> Gc[Node] {
    let c: Gc[Node] = build(d, v)
    if v % 2 == 0 {
        return c
    }
    return gc Node { left: c, right: gc_null[Node](), v: v } catch gc_null[Node]()
}

fn sum_lim(t: Gc[Node], n: u32) -> u64 {
    if t == gc_null[Node]() || n == 0 {
        return 0
    }
    return t.v + sum_lim(t.left, n - 1) + sum_lim(t.right, n - 1)
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    let h: Gc[Holder] = holder()
    var total: u64 = 0
    var i: u64 = 0
    while i < 400 {
        let a: Gc[Node] = build(3, i)
        link_back(a)
        total = total + sum_lim(a, 6)
        let low: Gc[Node] = a.left
        garbage(h, 30)
        total = total + sum_lim(low, 6)
        let r: Gc[Node] = ring(i)
        total = total + sum_lim(r, 5)
        garbage(h, 30)
        let e: Gc[Node] = either(2, i)
        total = total + sum(e)
        let f: Gc[Node] = either(3, i + 1)
        h.keep = f.left
        total = total + sum(f)
        garbage(h, 30)
        total = total + sum(h.keep)
        if i % 47 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
