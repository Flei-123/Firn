import std.io

gc class Box {
    a: u64,
    b: u64,
}

fn pick(i: u64) -> u64 {
    return i % 4
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var i: u64 = 0
    while i < 20000 {
        let x: Gc[Box] = gc Box { a: i, b: i * 2 } catch gc_null[Box]()
        if pick(i) == 0 {
            total = total + x.a
        } else if pick(i) == 1 {
            let y: Gc[Box] = gc Box { a: x.b, b: 5 } catch gc_null[Box]()
            total = total + y.a + y.b
        } else {
            total = total + 1
        }
        i = i + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
