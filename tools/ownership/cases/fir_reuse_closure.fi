import std.io

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: i64 = 0
    var i: i64 = 0
    while i < 20000 {
        let k: i64 = i
        let f: fn(i64) -> i64 = gc fn(a: i64) -> i64 { return a + k } catch fn(a: i64) -> i64 { return a }
        total = total + f(1)
        if i % 5000 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    io.fmt_print_line(f"closures {total}")
    return 0
}
