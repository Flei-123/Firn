gc class Pad {
    v: u64,
}

fn apply(f: fn(i64) -> i64, x: i64) -> i64 {
    return f(x)
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: i64 = 0
    var i: i64 = 0
    while i < 1000 {
        let k: i64 = i
        let f: fn(i64) -> i64 = gc fn(a: i64) -> i64 { return a + k } catch fn(a: i64) -> i64 { return a }
        total = total + f(1) + apply(f, 2)
        i = i + 1
    }
    if total == 0 { return 3 }
    if (gc_own_freed() + gc_own_poisoned() + gc_own_reused()) < 1000 { return 4 }
    return 0
}
