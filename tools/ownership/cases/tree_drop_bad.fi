gc class Node {
    left: Gc[Node],
    right: Gc[Node],
    v: u64,
}

fn mk(l: Gc[Node], r: Gc[Node], v: u64) -> Gc[Node] {
    return gc Node { left: l, right: r, v: v } catch gc_null[Node]()
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    let child: Gc[Node] = mk(gc_null[Node](), gc_null[Node](), 7)
    let parent: Gc[Node] = mk(child, gc_null[Node](), 1)
    let holder: Gc[Node] = mk(child, gc_null[Node](), 2)
    __own_drop_tree_check(parent as u64)
    gc_own_verify()
    return (holder.v as i32) + 40
}
