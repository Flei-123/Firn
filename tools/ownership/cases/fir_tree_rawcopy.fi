import std.io
import std.gcobj

gc class Node {
    left: Gc[Node],
    right: Gc[Node],
    v: u64,
}

struct Raw {
    a: Gc[Node],
}

fn build(d: u32, v: u64) -> Gc[Node] {
    if d == 0 {
        return gc Node { left: gc_null[Node](), right: gc_null[Node](), v: v } catch gc_null[Node]()
    }
    let l: Gc[Node] = build(d - 1, v * 2)
    let r: Gc[Node] = build(d - 1, v * 2 + 1)
    return gc Node { left: l, right: r, v: v } catch gc_null[Node]()
}

fn sum(t: Gc[Node]) -> u64 {
    if t == gc_null[Node]() {
        return 0
    }
    return t.v + sum(t.left) + sum(t.right)
}

#[no_inline]
fn leak(t: Gc[Node], r: *mut u64) {
    let p: *mut u64 = t as *mut u64
    *r = *p
}

fn main() -> i32 {
    if !gc_init() {
        return 3
    }
    let r: *mut u64 = gcobj.alloc[Raw](size_of[Raw]()) as *mut u64
    let rr: *mut Raw = r as *mut Raw
    var total: u64 = 0
    var i: u64 = 0
    while i < 200 {
        let t: Gc[Node] = build(3, i)
        leak(t, r)
        total = total + sum(t)
        if i % 20 == 0 {
            gc_collect()
        }
        total = total + sum((*rr).a)
        i = i + 1
    }
    io.fmt_print_line(f"total {total}")
    return 0
}
