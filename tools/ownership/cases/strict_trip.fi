gc class Item {
    id: u64,
    w: u64,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    gc_set_incr_ab(0)
    gc_set_time_budget(1)
    gc_set_slice(16)
    let sink: Gc[GcVec] = gcvec_new() catch gc_null[GcVec]()
    var i: u64 = 0
    while i < 64 {
        let g: Gc[Item] = gc Item { id: i, w: 0 } catch gc_null[Item]()
        let ok: bool = gcvec_append[Item](sink, g) catch false
        if !ok { return 2 }
        i = i + 1
    }
    i = 0
    while gc_phase() != 1 && i < 10000000 {
        let g: Gc[Item] = gc Item { id: i, w: 1 } catch gc_null[Item]()
        gcvec_set[Item](sink, i % 64, g)
        i = i + 1
    }
    if gc_phase() != 1 { return 3 }
    let x: Gc[Item] = gc Item { id: 5, w: 5 } catch gc_null[Item]()
    *(((x as u64) - HEADER) as *mut u32) = 0
    gc_collect()
    return 0
}
