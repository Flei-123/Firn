fn num(i: u64) -> str {
    if i % 3 == 0 {
        return ""
    }
    return "n"
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var i: u64 = 0
    while i < 1000 {
        let a: str = "ab" + num(i)
        let b: str = a + "cd"
        total = total + (b.n as u64)
        i = i + 1
    }
    if total == 0 { return 2 }
    if (gc_own_freed() + gc_own_poisoned()) < 1000 { return 3 }
    return 0
}
