import std.io

fn tag(i: u64) -> str {
    if i % 2 == 0 {
        return "e"
    }
    return "o"
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var last: str = ""
    var i: u64 = 0
    while i < 20000 {
        let a: str = "x" + tag(i)
        var b: str = ""
        if i % 3 == 0 {
            b = a + "three"
        } else {
            b = tag(i + 1) + a
        }
        total = total + (b.n as u64)
        if i % 4999 == 0 {
            last = b + "!"
        }
        i = i + 1
    }
    io.fmt_print_line(f"{last} {total}")
    return 0
}
