import std.io
import std.vec

struct Pair { a: str, b: str }

fn tag(i: u64) -> str {
    if i % 2 == 0 {
        return "e"
    }
    return "o"
}

fn stash(slot: *mut str, s: str, i: u64) {
    if i % 5 == 0 {
        *slot = s
    }
}

fn make_pair(i: u64) -> Pair {
    let a: str = "p" + tag(i)
    let b: str = a + "q"
    return Pair { a: a, b: b }
}

fn tail_of(s: str) -> str {
    return str { p: ((s.p as u64) + 1) as *mut u8, n: s.n - 1 }
}

fn noise(i: u64) -> u64 {
    var t: u64 = 0
    var k: u64 = 0
    while k < 4 {
        let z: str = "zzzzzzzz" + tag(i + k)
        t = t + (z.n as u64)
        k = k + 1
    }
    return t
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var kept: str = ""
    var v: Vec[str] = vec_new[str]()
    var carry: str = "c"
    var slice_keep: str = ""
    var pairs: [Pair; 2] = [Pair { a: "", b: "" }, Pair { a: "", b: "" }]
    var total: u64 = 0
    var i: u64 = 0
    while i < 3000 {
        let a: str = "a" + tag(i)
        let b: str = a + "b"
        let c: str = b + "v"
        if i % 250 == 0 {
            vec_push[str](&v, c)
        }
        let d: str = c + "s"
        stash(&kept, d, i)
        let t: str = carry + tag(i)
        if i % 7 == 0 {
            carry = t
        }
        let e: str = d + "slice"
        let sl: str = tail_of(e)
        if i % 300 == 0 {
            slice_keep = sl
        }
        pairs[(i % 2) as usize] = make_pair(i)
        total = total + noise(i) + (t.n as u64)
        if i % 500 == 0 {
            gc_collect()
        }
        i = i + 1
    }
    gc_collect()
    var vs: str = ""
    var j: usize = 0
    while j < vec_len[str](&v) {
        vs = vs + *vec_elem_ptr[str](&v, j)
        j = j + 1
    }
    io.fmt_print_line(f"{vs} {kept} {carry.n} {slice_keep} {pairs[0].a}{pairs[0].b}{pairs[1].a}{pairs[1].b} {total}")
    return 0
}
