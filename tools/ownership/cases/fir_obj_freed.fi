gc class Item {
    id: u64,
    w: u64,
}

fn make_item(i: u64) -> Gc[Item] {
    return gc Item { id: i, w: 1 } catch gc_null[Item]()
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var i: u64 = 0
    while i < 1000 {
        let a: Gc[Item] = gc Item { id: i, w: 2 } catch gc_null[Item]()
        let b: Gc[Item] = make_item(i)
        total = total + a.id + b.w
        i = i + 1
    }
    if total == 0 { return 2 }
    if (gc_own_freed() + gc_own_poisoned()) < 2000 { return 3 }
    return 0
}
