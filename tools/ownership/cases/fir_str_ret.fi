import std.io

fn wrap(s: str) -> str {
    let t: str = "[" + s
    return t + "]"
}

fn pick(i: u64) -> str {
    let a: str = "a" + "b"
    let b: str = a + "c"
    if i % 2 == 0 {
        return b
    }
    return a + "d"
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var i: u64 = 0
    var out: str = ""
    while i < 20000 {
        let w: str = wrap(pick(i))
        total = total + (w.n as u64)
        if i == 7 {
            out = w
        }
        i = i + 1
    }
    let junk: str = wrap("zzzz") + wrap("yyyy")
    io.fmt_print_line(f"{out} {total} {junk}")
    return 0
}
