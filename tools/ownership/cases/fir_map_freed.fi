gc class Pad {
    v: u64,
}

fn main() -> i32 {
    if !gc_init() { return 1 }
    var total: u64 = 0
    var r: u64 = 0
    while r < 1000 {
        let m: Gc[GcMap] = gcmap_new(false, false) catch gc_null[GcMap]()
        let ok: bool = gcmap_set(m, r + 100, r + 5) catch false
        if !ok { return 2 }
        total = total + gcmap_get(m, r + 100, 0) + 1
        r = r + 1
    }
    if total == 0 { return 3 }
    if (gc_own_freed() + gc_own_poisoned()) < 2000 { return 4 }
    return 0
}
