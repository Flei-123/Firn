+pub(crate) fn inline_hint(f: &crate::ast::FnDecl) -> Option<bool> {
+    let yes = f.attrs.iter().any(|a| a.name == "inline");
+    let no = f.attrs.iter().any(|a| a.name == "no_inline");
+    match (yes, no) {
+        (_, true) => Some(false),
+        (true, false) => Some(true),
+        (false, false) => None,
+    }
+}
