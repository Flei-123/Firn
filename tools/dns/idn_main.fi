// SPDX-License-Identifier: MPL-2.0
// tools/dns/idn_main.fi -- lib/net/idn.fi as a program, for the cross-check
// against Python (tools/dns/idn_check.py).
//
//     idn_main a <name>...   host name (UTF-8) -> ASCII ("xn--" labels)
//     idn_main u <name>...   ASCII -> UTF-8
//
// One output line per name: the result, or "ERR".
import std.rt
import net.idn

fn main(start: u64) -> i32 {
    let argc: usize = rt.arg_count(start)
    if argc < 2 {
        return 2
    }
    let mp: u64 = rt.arg_ptr(start, 1)
    let to_ascii: bool = rt.ld8(mp, 0) == 97 as u8
    var i: usize = 2
    while i < argc {
        let ap: u64 = rt.arg_ptr(start, i)
        let an: usize = rt.c_length(ap)
        var out: rt.Buf = rt.buf_new()
        var ok: bool = false
        if to_ascii {
            ok = idn.idn_to_ascii(ap, an, &out)
        } else {
            ok = idn.idn_to_unicode(ap, an, &out)
        }
        if ok {
            rt.buf_push(&out, 10 as u8)
        } else {
            rt.buf_clear(&out)
            rt.buf_push(&out, 69 as u8)
            rt.buf_push(&out, 82 as u8)
            rt.buf_push(&out, 82 as u8)
            rt.buf_push(&out, 10 as u8)
        }
        syscall(1, 1, rt.buf_ptr(&out) as i64, out.len as i64, 0, 0, 0)
        rt.buf_free(&out)
        i = i + 1
    }
    return 0
}
