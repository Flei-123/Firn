// expect_out: sum=4950 len=100 hits=50 count=50 last=196
import std.io
import std.vec
import std.map

fn main() -> i32 {
    var v: Vec[i64] = vec_new[i64]()
    var i: i64 = 0
    while i < 100 {
        vec_push[i64](&v, i)
        i = i + 1
    }
    var sum: i64 = 0
    var k: usize = 0
    while k < v.len {
        sum = sum + vec_at[i64](&v, k)
        k = k + 1
    }
    var m: Map[i64, i64] = map_new[i64, i64]()
    i = 0
    while i < 100 {
        if i % 2 == 0 {
            map_set[i64, i64](&m, i, i * 2)
        }
        i = i + 1
    }
    var hits: i64 = 0
    i = 0
    while i < 100 {
        if map_has[i64, i64](&m, i) {
            hits = hits + 1
        }
        i = i + 1
    }
    io.fmt_print_line(f"sum={sum} len={v.len} hits={hits} count={map_len[i64, i64](&m)} last={map_get[i64, i64](&m, 98)}")
    vec_free[i64](&v)
    map_free[i64, i64](&m)
    return 0
}
