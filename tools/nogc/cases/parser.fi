// expect_out: 7 20 -5 42
import std.io

struct P {
    s: str,
    i: usize,
}

fn peek(p: *mut P) -> u8 {
    while (*p).i < (*p).s.n && *((*p).s.p + (*p).i) == 32 {
        (*p).i = (*p).i + 1
    }
    if (*p).i >= (*p).s.n {
        return 0
    }
    return *((*p).s.p + (*p).i)
}

fn number(p: *mut P) -> i64 {
    var v: i64 = 0
    while peek(p) >= 48 && peek(p) <= 57 {
        v = v * 10 + (peek(p) - 48) as i64
        (*p).i = (*p).i + 1
    }
    return v
}

fn atom(p: *mut P) -> i64 {
    if peek(p) == 40 {
        (*p).i = (*p).i + 1
        let v: i64 = expr(p)
        peek(p)
        (*p).i = (*p).i + 1
        return v
    }
    if peek(p) == 45 {
        (*p).i = (*p).i + 1
        return 0 - atom(p)
    }
    return number(p)
}

fn term(p: *mut P) -> i64 {
    var v: i64 = atom(p)
    while peek(p) == 42 {
        (*p).i = (*p).i + 1
        v = v * atom(p)
    }
    return v
}

fn expr(p: *mut P) -> i64 {
    var v: i64 = term(p)
    while peek(p) == 43 || peek(p) == 45 {
        let op: u8 = peek(p)
        (*p).i = (*p).i + 1
        let r: i64 = term(p)
        if op == 43 {
            v = v + r
        } else {
            v = v - r
        }
    }
    return v
}

fn eval(s: str) -> i64 {
    var p: P = P { s: s, i: 0 }
    return expr(&p)
}

fn main() -> i32 {
    io.fmt_print_line(f"{eval("1 + 2 * 3")} {eval("(2 + 3) * 4")} {eval("-(2 + 3)")} {eval("6 * 7")}")
    return 0
}
