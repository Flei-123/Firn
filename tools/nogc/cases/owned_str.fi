// vm_limit_kb: 100000
// expect_out: 3000000|abc-7|x=5|ok
import std.io

fn join_len() -> usize {
    let a: str = "ab"
    let b: str = "cdefghijklmnopqrstuvwxyz"
    let s: str = a + b
    return s.n
}

fn main() -> i32 {
    var total: usize = 0
    var i: usize = 0
    while i < 3000000 {
        total = total + join_len() - 25
        i = i + 1
    }
    let label: str = "abc" + "-" + "7"
    let text: str = io.fmt_string(f"x={5}")
    io.fmt_print(f"{total}|{label}|{text}|")
    if label == "abc-7" {
        io.print_line("ok")
    }
    return 0
}
