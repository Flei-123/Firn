// expect_out: results=100 counter=4000 locked=4000
// nogc_only
import std.io
import std.rt

fn __thread_work(kind: u64, arg: u64) -> u64 {
    var i: u64 = 0
    while i < 1000 {
        __atomic_add(arg as *mut u64, 1)
        i = i + 1
    }
    let lock: *mut u64 = (arg + 8) as *mut u64
    let shared: *mut u64 = (arg + 16) as *mut u64
    var j: u64 = 0
    while j < 1000 {
        thread_lock(lock)
        *shared = *shared + 1
        thread_unlock(lock)
        j = j + 1
    }
    return kind * 10
}

fn main() -> i32 {
    let block: u64 = rt.heap_alloc(64)
    var handles: [u64; 4] = [0, 0, 0, 0]
    var k: u64 = 0
    while k < 4 {
        handles[k as usize] = thread_start(k + 1, block)
        k = k + 1
    }
    var total: u64 = 0
    var w: u64 = 0
    while w < 4 {
        total = total + thread_wait(handles[w as usize])
        w = w + 1
    }
    io.fmt_print_line(f"results={total} counter={*(block as *mut u64)} locked={*((block + 16) as *mut u64)}")
    return 0
}
