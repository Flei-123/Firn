// expect_out: a+b+c|3|ok
import std.io
import std.str

fn main() -> i32 {
    var b: str.Bytes = str.bytes_new()
    defer str.bytes_free(&b)
    let n: usize = str.replace(&b, "a-b-c", "-", "+")
    var eq: bool = false
    let x: str = "abc"
    let y: str = "abc"
    if x == y {
        eq = true
    }
    io.fmt_print(f"{b.span()}|{n + 1}|")
    if eq {
        io.print_line("ok")
    }
    return 0
}
