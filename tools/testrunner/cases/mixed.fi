// tools/testrunner/cases/mixed.fi -- the four outcomes a test can have
// (ROUND 94). It is the input of tools/testrunner/run.sh: two cases pass,
// one panics with a position of its own, one dies without a message.
#[test]
fn adds_up() {
    var a: i32 = 2
    var b: i32 = 3
    a = a + b
    if a != 5 as i32 {
        syscall(60, 1, 0, 0, 0, 0, 0)
    }
}

#[test]
fn overflows() {
    var a: i32 = 2147483647
    var b: i32 = 1
    a = a + b
}

#[test]
fn writes_to_null() {
    let p: *mut i32 = 0 as *mut i32
    *p = 5
}

#[test]
fn prints_and_passes() {
    var m: [u8; 21] = "a test may print too\n"
    syscall(1, 1, (&m[0]) as i64, 21, 0, 0, 0)
}
