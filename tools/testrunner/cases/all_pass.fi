// tools/testrunner/cases/all_pass.fi -- the other half of the measurement in
// tools/testrunner/run.sh: a suite in which nothing fails. It has to end
// with exit code 0 and rate 1.000, otherwise the exit code of the runner
// would say nothing.
#[test]
fn arithmetic_holds() {
    var a: i64 = 6
    a = a * 7
    if a != 42 {
        syscall(60, 1, 0, 0, 0, 0, 0)
    }
}

#[test]
fn a_loop_counts() {
    var i: i64 = 0
    var s: i64 = 0
    while i < 10 {
        s = s + i
        i = i + 1
    }
    if s != 45 {
        syscall(60, 1, 0, 0, 0, 0, 0)
    }
}
