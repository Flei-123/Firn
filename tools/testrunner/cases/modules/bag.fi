// tools/testrunner/cases/modules/bag.fi -- module for generic_module.fi:
// a `Vec` of a struct of its own and `str` methods (round MODGEN).
import std.vec
import std.str
export { Bag, bag_new, bag_add, bag_count, bag_total_len, bag_free }
struct Item { name: str }
struct Bag { items: Vec[Item] }
fn bag_new() -> Bag { return Bag { items: vec_new[Item]() } }
fn bag_add(b: *mut Bag, name: str) { vec_push[Item](&(*b).items, Item { name: name }) }
fn bag_count(b: *mut Bag) -> usize { return vec_len[Item](&(*b).items) }
fn bag_total_len(b: *mut Bag) -> usize {
    var n: usize = 0
    var i: usize = 0
    while i < vec_len[Item](&(*b).items) {
        n = n + (*vec_elem_ptr[Item](&(*b).items, i)).name.length()
        i = i + 1
    }
    return n
}
fn bag_free(b: *mut Bag) { vec_free[Item](&(*b).items) }
