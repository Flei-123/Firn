// SPDX-License-Identifier: GPL-2.0-only
// tools/testrunner/cases/with_main.fi -- a file that has BOTH a `#[test]`
// and a `main` of its own.
//
// Two things are measured with it (tools/testrunner/run.sh):
//   * `firnc --test` refuses it with a clear sentence -- the runner is the
//     entry point, and two entry points would otherwise become a linker
//     error a hundred lines further down;
//   * WITHOUT `--test` the very same file compiles and runs in BOTH
//     compilers: `#[test]` is a known attribute for firnc1 too (round 94,
//     lib/firnc1/parser.fi), and a marked function is then an ordinary one.
// expect_exit: 3
#[test]
fn a_case() {
    var x: i64 = 1
    x = x + 1
}

fn main() -> i32 {
    a_case()
    return 3
}
