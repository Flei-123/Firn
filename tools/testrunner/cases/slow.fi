// tools/testrunner/cases/slow.fi -- a case that never comes back.
//
// Without a time limit it would hang the whole run; with one it is killed
// and counts as a failure like any other. `tools/testrunner/run.sh` measures
// exactly that, with `--test-limit=1`.
#[test]
fn never_returns() {
    var i: i64 = 0
    while i >= 0 {
        i = i + 1
        if i > 1000000000 {
            i = 0
        }
    }
}
