// tools/testrunner/cases/generic_module.fi -- `--test` over a file that
// uses generics and `str` from itself AND from an imported module
// (round MODGEN). Before, the test runner's own source text was parsed
// with a registry reset, and every `Vec[T]` and `str` method of the tested
// files became unknown -- a unit test of any real library could not build.
import std.vec
import modules.bag

#[test]
fn own_vec_works() {
    var v: Vec[u32] = vec_new[u32]()
    vec_push[u32](&v, 5)
    if vec_len[u32](&v) != 1 { syscall(60, 1, 0, 0, 0, 0, 0) }
    vec_free[u32](&v)
}

#[test]
fn module_vec_of_own_struct_works() {
    var b: bag.Bag = bag.bag_new()
    bag.bag_add(&b, "abc")
    bag.bag_add(&b, "de")
    if bag.bag_count(&b) != 2 { syscall(60, 1, 0, 0, 0, 0, 0) }
    if bag.bag_total_len(&b) != 5 { syscall(60, 1, 0, 0, 0, 0, 0) }
    bag.bag_free(&b)
}
