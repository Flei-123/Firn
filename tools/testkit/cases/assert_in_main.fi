// tools/testkit/cases/assert_in_main.fi -- an assertion in a plain `main`
// ends the program like a panic: message on stderr, exit code 101; the
// line after the failing assertion must NOT run.
import std.testkit
import std.rt

fn main() -> i32 {
    testkit.assert_eq_i64(1, 1)
    testkit.assert_eq_i64(5, 6)
    rt.write_everything(1, "after\n".p as u64, 6)
    return 0
}
