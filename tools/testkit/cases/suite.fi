// tools/testkit/cases/suite.fi -- `firnc --test` over std.testkit: two cases
// that pass, three that fail through an assertion, one that fails after a
// context label. tools/testkit/run.sh reads the report.
import std.testkit

#[test]
fn holds() {
    testkit.assert_eq_i64(6 * 7, 42)
    testkit.assert_eq_str("abc", "abc")
}

#[test]
fn eq_fails() {
    testkit.assert_eq_i64(1, 2)
}

#[test]
fn str_fails() {
    testkit.assert_eq_str("first line\nsecond", "first line\nsecond!")
}

#[test]
fn true_fails() {
    testkit.assert_true(1 + 1 == 3, "arithmetic is broken")
}

#[test]
fn near_holds() {
    testkit.assert_near(0.1 + 0.2, 0.3, 1.0e-12)
    assert_eq[u8](200 as u8, 200 as u8)
}

#[test]
fn context_fails() {
    testkit.context("second group")
    testkit.assert_near(1.0, 2.0, 0.1)
}
