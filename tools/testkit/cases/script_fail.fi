// tools/testkit/cases/script_fail.fi -- script style with one failing check:
// exit code 1, output in the format of OpenPlan's Python check().
import std.testkit

fn main() -> i32 {
    testkit.check(2 + 2 == 4, "two and two")
    testkit.check(3 * 3 == 10, "three times three")
    testkit.check(true, "the last one")
    return testkit.finish()
}
