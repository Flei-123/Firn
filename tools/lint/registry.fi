import rt.vec
import ctx
import rules.unused_import
import rules.duplicate_import
import rules.unused_variable
import rules.shadowed_variable
import rules.unreachable_code
import rules.unused_private_item
import rules.var_never_mutated
import rules.self_assignment
import rules.constant_condition
import rules.bool_comparison
import rules.empty_branch

export { Rule, registry_new, registry_free }

struct Rule {
    name: str,
    summary: str,
    run: fn(*mut ctx.Ctx),
}

fn registry_new() -> vec.Vec[Rule] {
    var v: vec.Vec[Rule] = vec.vec_new[Rule]()
    vec.vec_push[Rule](&v, Rule { name: unused_import.name(), summary: unused_import.summary(), run: unused_import.run })
    vec.vec_push[Rule](&v, Rule { name: duplicate_import.name(), summary: duplicate_import.summary(), run: duplicate_import.run })
    vec.vec_push[Rule](&v, Rule { name: unused_variable.name(), summary: unused_variable.summary(), run: unused_variable.run })
    vec.vec_push[Rule](&v, Rule { name: shadowed_variable.name(), summary: shadowed_variable.summary(), run: shadowed_variable.run })
    vec.vec_push[Rule](&v, Rule { name: unreachable_code.name(), summary: unreachable_code.summary(), run: unreachable_code.run })
    vec.vec_push[Rule](&v, Rule { name: unused_private_item.name(), summary: unused_private_item.summary(), run: unused_private_item.run })
    vec.vec_push[Rule](&v, Rule { name: var_never_mutated.name(), summary: var_never_mutated.summary(), run: var_never_mutated.run })
    vec.vec_push[Rule](&v, Rule { name: self_assignment.name(), summary: self_assignment.summary(), run: self_assignment.run })
    vec.vec_push[Rule](&v, Rule { name: constant_condition.name(), summary: constant_condition.summary(), run: constant_condition.run })
    vec.vec_push[Rule](&v, Rule { name: bool_comparison.name(), summary: bool_comparison.summary(), run: bool_comparison.run })
    vec.vec_push[Rule](&v, Rule { name: empty_branch.name(), summary: empty_branch.summary(), run: empty_branch.run })
    return v
}

fn registry_free(v: *mut vec.Vec[Rule]) {
    vec.vec_free[Rule](v)
}
