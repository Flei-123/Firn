import rt.vec
import ctx
import rules.unused_import
import rules.duplicate_import
import rules.unused_variable
import rules.shadowed_variable
import rules.unreachable_code

export { Rule, registry_new, registry_free }

struct Rule {
    name: str,
    summary: str,
    run: fn(*mut ctx.Ctx),
}

fn registry_new() -> vec.Vec[Rule] {
    var v: vec.Vec[Rule] = vec.vec_new[Rule]()
    vec.vec_push[Rule](&v, Rule { name: unused_import.name(), summary: unused_import.summary(), run: unused_import.run })
    vec.vec_push[Rule](&v, Rule { name: duplicate_import.name(), summary: duplicate_import.summary(), run: duplicate_import.run })
    vec.vec_push[Rule](&v, Rule { name: unused_variable.name(), summary: unused_variable.summary(), run: unused_variable.run })
    vec.vec_push[Rule](&v, Rule { name: shadowed_variable.name(), summary: shadowed_variable.summary(), run: shadowed_variable.run })
    vec.vec_push[Rule](&v, Rule { name: unreachable_code.name(), summary: unreachable_code.summary(), run: unreachable_code.run })
    return v
}

fn registry_free(v: *mut vec.Vec[Rule]) {
    vec.vec_free[Rule](v)
}
