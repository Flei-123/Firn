import fmt
import ctx
import toks

export { name, summary, run }

fn name() -> str { return "unreachable-code" }

fn summary() -> str { return "statement directly after return, break or continue in the same block" }

fn jumps(f: *mut fmt.Form, i: usize) -> bool {
    return toks.is_kw(f, i, "return") || toks.is_kw(f, i, "break") || toks.is_kw(f, i, "continue")
}

fn continues_expression(f: *mut fmt.Form, k: usize) -> bool {
    let p: usize = toks.prev_code(f, k)
    if p >= fmt.form_count(f) || fmt.tok_kind(f, p) != fmt.K_SIGN || toks.closes(f, p) {
        return false
    }
    return true
}

fn next_statement(f: *mut fmt.Form, i: usize) -> usize {
    let n: usize = fmt.form_count(f)
    var depth: u32 = 0
    var k: usize = i + 1
    while k < n {
        if toks.is_code(f, k) {
            if depth == 0 && toks.first_on_line(f, k) {
                if continues_expression(f, k) {
                    k = k + 1
                    continue
                }
                if toks.is_word(f, k) && !toks.is_kw(f, k, "else") {
                    return k
                }
                return n
            }
            if toks.opens(f, k) {
                depth = depth + 1
            } else if toks.closes(f, k) {
                if depth == 0 {
                    return n
                }
                depth = depth - 1
            }
        }
        k = k + 1
    }
    return n
}

fn run(c: *mut ctx.Ctx) {
    let f: *mut fmt.Form = (*c).f
    let n: usize = ctx.ctx_count(c)
    var i: usize = 0
    while i < n {
        if jumps(f, i) && toks.first_on_line(f, i) {
            let s: usize = next_statement(f, i)
            if s < n {
                ctx.ctx_emit_head(c, name(), fmt.tok_line(f, s))
                toks.put(c, "code after ")
                toks.put_quoted_word(c, i)
                toks.put(c, " on line ")
                toks.put_num(c, fmt.tok_line(f, i) as u64)
                ctx.ctx_emit_done(c)
            }
        }
        i = i + 1
    }
}
