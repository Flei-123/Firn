import fmt
import ctx
import toks

export { name, summary, run }

fn name() -> str { return "constant-condition" }

fn summary() -> str { return "if with a literal true/false condition, while with a literal false" }

fn literal(f: *mut fmt.Form, k: usize) -> bool {
    return toks.is_kw(f, k, "true") || toks.is_kw(f, k, "false")
}

fn run(c: *mut ctx.Ctx) {
    let f: *mut fmt.Form = (*c).f
    let n: usize = ctx.ctx_count(c)
    var i: usize = 0
    while i < n {
        let is_if: bool = toks.is_kw(f, i, "if")
        if is_if || toks.is_kw(f, i, "while") {
            let v: usize = toks.next_code(f, i)
            if v < n && literal(f, v) && (is_if || toks.is_kw(f, v, "false")) {
                let b: usize = toks.next_code(f, v)
                if b < n && fmt.is_sign(f, b, fmt.S_LBRACE) {
                    ctx.ctx_emit_head(c, name(), fmt.tok_line(f, i))
                    toks.put(c, "condition of ")
                    toks.put_quoted_word(c, i)
                    toks.put(c, " is the constant ")
                    toks.put_quoted_word(c, v)
                    ctx.ctx_emit_done(c)
                }
            }
        }
        i = i + 1
    }
}
