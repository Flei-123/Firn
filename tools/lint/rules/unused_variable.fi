import rt.rt
import fmt
import ctx
import toks

export { name, summary, run }

fn name() -> str { return "unused-variable" }

fn summary() -> str { return "let/var binding that is never read (auto-fix only for side-effect-free initializers)" }

fn declares(f: *mut fmt.Form, i: usize) -> bool {
    return toks.is_kw(f, i, "let") || toks.is_kw(f, i, "var")
}

fn plain_type_word(f: *mut fmt.Form, k: usize) -> bool {
    let names: [str; 14] = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "isize", "usize", "bool", "f32", "f64", "str"]
    var j: usize = 0
    while j < 14 {
        if toks.is_kw(f, k, names[j]) {
            return true
        }
        j = j + 1
    }
    return false
}

fn plain_type(f: *mut fmt.Form, b: usize) -> bool {
    let n: usize = fmt.form_count(f)
    let c: usize = toks.next_code(f, b)
    if c >= n || !fmt.is_sign(f, c, fmt.S_COLON) {
        return false
    }
    let t: usize = toks.next_code(f, c)
    if t >= n {
        return false
    }
    if fmt.is_sign(f, t, fmt.S_STAR) {
        return true
    }
    if !plain_type_word(f, t) {
        return false
    }
    return fmt.is_sign(f, toks.next_code(f, t), fmt.S_ASSIGN)
}

fn literal_start(f: *mut fmt.Form, b: usize) -> bool {
    let n: usize = fmt.form_count(f)
    let c: usize = toks.next_code(f, b)
    if c >= n || !fmt.is_sign(f, c, fmt.S_ASSIGN) {
        return false
    }
    let v: usize = toks.next_code(f, c)
    if v >= n {
        return false
    }
    return fmt.tok_kind(f, v) == fmt.K_NUMBER || fmt.tok_kind(f, v) == fmt.K_TEXT || toks.is_kw(f, v, "true") || toks.is_kw(f, v, "false")
}

fn pure_init(f: *mut fmt.Form, b: usize) -> bool {
    if !plain_type(f, b) && !literal_start(f, b) {
        return false
    }
    let n: usize = fmt.form_count(f)
    var depth: u32 = 0
    var k: usize = b + 1
    while k < n {
        if toks.is_code(f, k) {
            if depth == 0 && toks.first_on_line(f, k) {
                return true
            }
            if fmt.is_sign(f, k, fmt.S_LPAREN) || fmt.is_sign(f, k, fmt.S_LBRACE) || toks.is_kw(f, k, "try") || toks.is_kw(f, k, "catch") {
                return false
            }
            if fmt.is_sign(f, k, fmt.S_LBRACKET) {
                depth = depth + 1
            } else if fmt.is_sign(f, k, fmt.S_RBRACE) || fmt.is_sign(f, k, fmt.S_RBRACKET) {
                if depth == 0 {
                    return true
                }
                depth = depth - 1
            }
        }
        k = k + 1
    }
    return true
}

fn used_in(f: *mut fmt.Form, b: usize, to: usize) -> bool {
    var k: usize = b + 1
    while k < to {
        if toks.same_word(f, k, b) {
            let p: usize = toks.prev_code(f, k)
            if !toks.is_key_position(f, k) && !(p < fmt.form_count(f) && declares(f, p)) {
                return true
            }
        } else if toks.text_mentions(f, k, b) {
            return true
        }
        k = k + 1
    }
    return false
}

fn run(c: *mut ctx.Ctx) {
    let f: *mut fmt.Form = (*c).f
    let n: usize = ctx.ctx_count(c)
    var i: usize = 0
    while i < n {
        if declares(f, i) && ctx.owner_of(c, i) != ctx.NONE {
            let b: usize = toks.next_code(f, i)
            if b < n && toks.is_word(f, b) && toks.word_str(f, b).n > 0 {
                let first: u8 = rt.ld8(toks.word_str(f, b).p as u64, 0)
                var end: usize = n
                let close: u32 = ctx.close_of(c, ctx.owner_of(c, i) as usize)
                if close != ctx.NONE {
                    end = close as usize
                }
                if first != 95 as u8 && !used_in(f, b, end) {
                    ctx.ctx_emit_head(c, name(), fmt.tok_line(f, b))
                    toks.put(c, "variable ")
                    toks.put_quoted_word(c, b)
                    if pure_init(f, b) {
                        toks.put(c, " is never used")
                    } else {
                        toks.put(c, " is never used (kept: initializer may have effects)")
                    }
                    ctx.ctx_emit_done(c)
                }
            }
        }
        i = i + 1
    }
}
