import fmt
import ctx
import toks

export { name, summary, run }

fn name() -> str { return "var-never-mutated" }

fn summary() -> str { return "var with an initializer that is only ever read, so let would do" }

fn has_initializer(f: *mut fmt.Form, b: usize) -> bool {
    let n: usize = fmt.form_count(f)
    var k: usize = b + 1
    while k < n {
        if toks.is_code(f, k) {
            if toks.first_on_line(f, k) {
                return false
            }
            if fmt.is_sign(f, k, fmt.S_ASSIGN) {
                return true
            }
        }
        k = k + 1
    }
    return false
}

fn read_sign(f: *mut fmt.Form, k: usize) -> bool {
    return fmt.is_sign(f, k, fmt.S_RPAREN) || fmt.is_sign(f, k, fmt.S_COMMA)
    || fmt.is_sign(f, k, fmt.S_RBRACKET) || fmt.is_sign(f, k, fmt.S_RBRACE)
    || fmt.is_sign(f, k, fmt.S_LBRACE) || fmt.is_sign(f, k, fmt.S_PLUS)
    || fmt.is_sign(f, k, fmt.S_MINUS) || fmt.is_sign(f, k, fmt.S_STAR)
    || fmt.is_sign(f, k, fmt.S_SLASH) || fmt.is_sign(f, k, fmt.S_PERCENT)
    || fmt.is_sign(f, k, fmt.S_PIPE) || fmt.is_sign(f, k, fmt.S_CARET)
    || fmt.is_sign(f, k, fmt.S_SHL) || fmt.is_sign(f, k, fmt.S_SHR)
    || fmt.is_sign(f, k, fmt.S_ANDAND) || fmt.is_sign(f, k, fmt.S_OROR)
    || fmt.is_sign(f, k, fmt.S_EQEQ) || fmt.is_sign(f, k, fmt.S_NOTEQ)
    || fmt.is_sign(f, k, fmt.S_LT) || fmt.is_sign(f, k, fmt.S_LE)
    || fmt.is_sign(f, k, fmt.S_GT) || fmt.is_sign(f, k, fmt.S_GE)
    || fmt.is_sign(f, k, fmt.S_AMP)
}

fn plain_read(f: *mut fmt.Form, k: usize) -> bool {
    let p: usize = toks.prev_code(f, k)
    if p < fmt.form_count(f) && (fmt.is_sign(f, p, fmt.S_AMP) || toks.is_kw(f, p, "mut") || toks.is_kw(f, p, "inout")) {
        return false
    }
    let nx: usize = toks.next_code(f, k)
    if nx >= fmt.form_count(f) {
        return true
    }
    if toks.is_word(f, nx) {
        return toks.is_kw(f, nx, "as") || toks.first_on_line(f, nx)
    }
    return read_sign(f, nx)
}

fn only_read(f: *mut fmt.Form, b: usize, to: usize) -> bool {
    var uses: usize = 0
    var k: usize = b + 1
    while k < to {
        if toks.same_word(f, k, b) && !toks.is_key_position(f, k) {
            let p: usize = toks.prev_code(f, k)
            if !(p < fmt.form_count(f) && (toks.is_kw(f, p, "let") || toks.is_kw(f, p, "var"))) {
                if !plain_read(f, k) {
                    return false
                }
                uses = uses + 1
            }
        }
        k = k + 1
    }
    return uses > 0
}

fn run(c: *mut ctx.Ctx) {
    let f: *mut fmt.Form = (*c).f
    let n: usize = ctx.ctx_count(c)
    var i: usize = 0
    while i < n {
        if toks.is_kw(f, i, "var") && ctx.owner_of(c, i) != ctx.NONE {
            let b: usize = toks.next_code(f, i)
            if b < n && toks.is_word(f, b) && has_initializer(f, b) {
                var end: usize = n
                let close: u32 = ctx.close_of(c, ctx.owner_of(c, i) as usize)
                if close != ctx.NONE {
                    end = close as usize
                }
                if only_read(f, b, end) {
                    ctx.ctx_emit_head(c, name(), fmt.tok_line(f, b))
                    toks.put(c, "variable ")
                    toks.put_quoted_word(c, b)
                    toks.put(c, " is never mutated, declare it with let")
                    ctx.ctx_emit_done(c)
                }
            }
        }
        i = i + 1
    }
}
