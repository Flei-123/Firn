import fmt
import ctx
import toks

export { name, summary, run }

fn name() -> str { return "bool-comparison" }

fn summary() -> str { return "== or != against the literal true/false" }

fn literal(f: *mut fmt.Form, k: usize) -> bool {
    return toks.is_kw(f, k, "true") || toks.is_kw(f, k, "false")
}

fn run(c: *mut ctx.Ctx) {
    let f: *mut fmt.Form = (*c).f
    let n: usize = ctx.ctx_count(c)
    var i: usize = 0
    while i < n {
        if fmt.is_sign(f, i, fmt.S_EQEQ) || fmt.is_sign(f, i, fmt.S_NOTEQ) {
            let p: usize = toks.prev_code(f, i)
            let nx: usize = toks.next_code(f, i)
            var lit: usize = n
            if nx < n && literal(f, nx) {
                lit = nx
            } else if p < n && literal(f, p) {
                lit = p
            }
            if lit < n {
                ctx.ctx_emit_head(c, name(), fmt.tok_line(f, i))
                toks.put(c, "comparison with ")
                toks.put_quoted_word(c, lit)
                toks.put(c, " is redundant, use the bool directly")
                ctx.ctx_emit_done(c)
            }
        }
        i = i + 1
    }
}
