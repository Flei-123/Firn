import fmt
import ctx
import toks

export { name, summary, run }

fn name() -> str { return "self-assignment" }

fn summary() -> str { return "statement that assigns a place to itself" }

fn starts_place(f: *mut fmt.Form, i: usize) -> bool {
    if fmt.is_sign(f, i, fmt.S_LPAREN) {
        return true
    }
    if !toks.is_word(f, i) {
        return false
    }
    return !(toks.is_kw(f, i, "let") || toks.is_kw(f, i, "var") || toks.is_kw(f, i, "if")
        || toks.is_kw(f, i, "while") || toks.is_kw(f, i, "return") || toks.is_kw(f, i, "else")
        || toks.is_kw(f, i, "const") || toks.is_kw(f, i, "static") || toks.is_kw(f, i, "defer")
        || toks.is_kw(f, i, "break") || toks.is_kw(f, i, "continue") || toks.is_kw(f, i, "try")
        || toks.is_kw(f, i, "catch") || toks.is_kw(f, i, "for") || toks.is_kw(f, i, "fn"))
}

fn assign_at(f: *mut fmt.Form, i: usize, e: usize) -> usize {
    var depth: u32 = 0
    var k: usize = i
    while k < e {
        if toks.is_code(f, k) {
            if toks.opens(f, k) {
                depth = depth + 1
            } else if toks.closes(f, k) {
                if depth == 0 {
                    return e
                }
                depth = depth - 1
            } else if depth == 0 && fmt.is_sign(f, k, fmt.S_ASSIGN) {
                return k
            }
        }
        k = k + 1
    }
    return e
}

fn ends_cleanly(f: *mut fmt.Form, e: usize) -> bool {
    if e >= fmt.form_count(f) {
        return true
    }
    return toks.is_word(f, e) || toks.closes(f, e)
}

fn same_sides(f: *mut fmt.Form, i: usize, a: usize, e: usize) -> bool {
    var l: usize = i
    var r: usize = toks.next_code(f, a)
    while l < a {
        if r >= e || !toks.same_token(f, l, r) {
            return false
        }
        let nl: usize = toks.next_code(f, l)
        if toks.is_word(f, l) && nl < a && fmt.is_sign(f, nl, fmt.S_LPAREN) {
            return false
        }
        l = nl
        r = toks.next_code(f, r)
    }
    return r >= e
}

fn run(c: *mut ctx.Ctx) {
    let f: *mut fmt.Form = (*c).f
    let n: usize = ctx.ctx_count(c)
    var i: usize = 0
    while i < n {
        if toks.is_code(f, i) && toks.first_on_line(f, i) && ctx.owner_of(c, i) != ctx.NONE && (starts_place(f, i) || fmt.is_sign(f, i, fmt.S_STAR)) {
            let e: usize = toks.statement_end(f, i)
            let a: usize = assign_at(f, i, e)
            if a < e && a > i && ends_cleanly(f, e) && same_sides(f, i, a, e) {
                ctx.ctx_emit_head(c, name(), fmt.tok_line(f, i))
                toks.put(c, "value is assigned to itself")
                ctx.ctx_emit_done(c)
            }
        }
        i = i + 1
    }
}
