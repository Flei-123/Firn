import fmt
import ctx
import toks
import imports
import modnames
import rt.rt

export { name, summary, run }

fn name() -> str { return "unused-import" }

fn summary() -> str { return "import whose module name is never mentioned in the file" }

fn on_import_line(f: *mut fmt.Form, k: usize) -> bool {
    var j: usize = k
    while j > 0 && !toks.first_on_line(f, j) {
        j = j - 1
    }
    return toks.is_kw(f, j, "import")
}

fn is_used(f: *mut fmt.Form, b: usize) -> bool {
    let n: usize = fmt.form_count(f)
    var k: usize = 0
    while k < n {
        if k != b {
            if toks.same_word(f, k, b) && !toks.is_key_position(f, k) && !on_import_line(f, k) {
                return true
            }
            if toks.text_mentions(f, k, b) {
                return true
            }
        }
        k = k + 1
    }
    return false
}

fn unqualified_use(c: *mut ctx.Ctx, i: usize) -> bool {
    var src: rt.Buf = rt.buf_new()
    defer rt.buf_free(&src)
    if !modnames.try_load((*c).path, (*c).lib, (*c).f, toks.next_code((*c).f, i) - 1, &src) {
        return true
    }
    var m: fmt.Form = fmt.form_new(rt.buf_ptr(&src), rt.buf_len(&src))
    defer fmt.form_free(&m)
    fmt.form_scan(&m)
    if fmt.form_broken(&m) {
        return true
    }
    return modnames.imported_name_mentioned((*c).f, &m)
}

fn run(c: *mut ctx.Ctx) {
    let f: *mut fmt.Form = (*c).f
    let n: usize = ctx.ctx_count(c)
    var i: usize = 0
    while i < n {
        if ctx.owner_of(c, i) == ctx.NONE && imports.import_statement(f, i) {
            let b: usize = imports.import_binding(f, i)
            if b < n && !is_used(f, b) && !unqualified_use(c, i) {
                ctx.ctx_emit_head(c, name(), fmt.tok_line(f, i))
                toks.put(c, "unused import ")
                toks.put_quoted_word(c, b)
                ctx.ctx_emit_done(c)
            }
        }
        i = i + 1
    }
}
