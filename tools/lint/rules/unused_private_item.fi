import rt.rt
import fmt
import ctx
import toks

export { name, summary, run }

fn name() -> str { return "unused-private-item" }

fn summary() -> str { return "non-exported top-level fn/static that is never mentioned in its file" }

fn item_kind(f: *mut fmt.Form, i: usize) -> str {
    if toks.is_kw(f, i, "fn") {
        return "function"
    }
    if toks.is_kw(f, i, "static") {
        return "static"
    }
    return ""
}

fn has_attribute(f: *mut fmt.Form, i: usize) -> bool {
    let p: usize = toks.prev_code(f, i)
    if p >= fmt.form_count(f) || !fmt.is_sign(f, p, fmt.S_RBRACKET) {
        return false
    }
    return fmt.is_sign(f, toks.line_head(f, p), fmt.S_HASH)
}

fn item_name(f: *mut fmt.Form, i: usize) -> usize {
    let n: usize = fmt.form_count(f)
    var b: usize = toks.next_code(f, i)
    if b < n && toks.is_kw(f, b, "mut") {
        b = toks.next_code(f, b)
    }
    if b >= n || !toks.is_word(f, b) {
        return n
    }
    return b
}

fn skipped_name(f: *mut fmt.Form, b: usize) -> bool {
    return rt.ld8(toks.word_str(f, b).p as u64, 0) == 95 as u8 || toks.is_kw(f, b, "main")
}

fn mentioned(f: *mut fmt.Form, b: usize) -> bool {
    let n: usize = fmt.form_count(f)
    var k: usize = 0
    while k < n {
        if k != b {
            if toks.same_word(f, k, b) {
                if !toks.is_key_position(f, k) {
                    return true
                }
            } else if toks.any_text_mentions(f, k, b) {
                return true
            }
        }
        k = k + 1
    }
    return false
}

fn has_export_list(c: *mut ctx.Ctx) -> bool {
    let f: *mut fmt.Form = (*c).f
    let n: usize = ctx.ctx_count(c)
    var i: usize = 0
    while i < n {
        if toks.is_kw(f, i, "export") && toks.first_on_line(f, i) && ctx.owner_of(c, i) == ctx.NONE {
            return true
        }
        i = i + 1
    }
    return false
}

fn run(c: *mut ctx.Ctx) {
    let f: *mut fmt.Form = (*c).f
    let n: usize = ctx.ctx_count(c)
    if !has_export_list(c) {
        return
    }
    var i: usize = 0
    while i < n {
        let kind: str = item_kind(f, i)
        if kind.n > 0 && ctx.owner_of(c, i) == ctx.NONE && toks.first_on_line(f, i) && !has_attribute(f, i) {
            let b: usize = item_name(f, i)
            if b < n && !skipped_name(f, b) && !mentioned(f, b) {
                ctx.ctx_emit_head(c, name(), fmt.tok_line(f, b))
                toks.put(c, kind)
                toks.put(c, " ")
                toks.put_quoted_word(c, b)
                toks.put(c, " is never used")
                ctx.ctx_emit_done(c)
            }
        }
        i = i + 1
    }
}
