import fmt
import ctx
import toks

export { name, summary, run }

fn name() -> str { return "empty-branch" }

fn summary() -> str { return "if or else branch with an empty body" }

fn branch_head(f: *mut fmt.Form, b: usize) -> bool {
    let p: usize = toks.prev_code(f, b)
    if p < fmt.form_count(f) && toks.is_kw(f, p, "else") {
        return true
    }
    let h: usize = toks.line_head(f, b)
    if toks.is_kw(f, h, "if") || toks.is_kw(f, h, "else") {
        return true
    }
    if fmt.is_sign(f, h, fmt.S_RBRACE) {
        let w: usize = toks.next_code(f, h)
        return w < fmt.form_count(f) && toks.is_kw(f, w, "else")
    }
    return false
}

fn condition_calls(f: *mut fmt.Form, b: usize) -> bool {
    var k: usize = toks.line_head(f, b)
    while k < b {
        if fmt.is_sign(f, k, fmt.S_LPAREN) {
            return true
        }
        k = k + 1
    }
    return false
}

fn continues(c: *mut ctx.Ctx, b: usize) -> bool {
    let f: *mut fmt.Form = (*c).f
    let e: usize = toks.next_code(f, ctx.close_of(c, b) as usize)
    return e < ctx.ctx_count(c) && toks.is_kw(f, e, "else")
}

fn reportable(c: *mut ctx.Ctx, b: usize) -> bool {
    let f: *mut fmt.Form = (*c).f
    let p: usize = toks.prev_code(f, b)
    if p < ctx.ctx_count(c) && toks.is_kw(f, p, "else") {
        return true
    }
    return !condition_calls(f, b) && !continues(c, b)
}

fn run(c: *mut ctx.Ctx) {
    let f: *mut fmt.Form = (*c).f
    let n: usize = ctx.ctx_count(c)
    var i: usize = 0
    while i < n {
        if fmt.is_sign(f, i, fmt.S_LBRACE) && ctx.close_of(c, i) == (i + 1) as u32 && branch_head(f, i) && reportable(c, i) {
            ctx.ctx_emit_head(c, name(), fmt.tok_line(f, i))
            let p: usize = toks.prev_code(f, i)
            if p < n && toks.is_kw(f, p, "else") {
                toks.put(c, "empty else branch")
            } else {
                toks.put(c, "empty if branch")
            }
            ctx.ctx_emit_done(c)
        }
        i = i + 1
    }
}
