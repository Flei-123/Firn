import rt.rt
import fmt
import ctx
import toks
import imports

export { name, summary, run }

fn name() -> str { return "duplicate-import" }

fn summary() -> str { return "two imports that bind the same module name" }

fn run(c: *mut ctx.Ctx) {
    let f: *mut fmt.Form = (*c).f
    let n: usize = ctx.ctx_count(c)
    var seen: rt.Buf = rt.buf_new()
    defer rt.buf_free(&seen)
    var i: usize = 0
    while i < n {
        if ctx.owner_of(c, i) == ctx.NONE && imports.import_statement(f, i) {
            let b: usize = imports.import_binding(f, i)
            if b < n {
                var k: usize = 0
                var first: usize = n
                while k < rt.buf_len(&seen) / 4 {
                    let o: usize = rt.ld32(rt.buf_ptr(&seen), k) as usize
                    if toks.same_word(f, o, b) {
                        first = o
                        break
                    }
                    k = k + 1
                }
                if first < n {
                    ctx.ctx_emit_head(c, name(), fmt.tok_line(f, i))
                    toks.put(c, "duplicate import of ")
                    toks.put_quoted_word(c, b)
                    toks.put(c, ", first on line ")
                    toks.put_num(c, fmt.tok_line(f, first) as u64)
                    ctx.ctx_emit_done(c)
                } else {
                    rt.buf_push(&seen, (b & 255) as u8)
                    rt.buf_push(&seen, ((b >> 8) & 255) as u8)
                    rt.buf_push(&seen, ((b >> 16) & 255) as u8)
                    rt.buf_push(&seen, ((b >> 24) & 255) as u8)
                }
            }
        }
        i = i + 1
    }
}
