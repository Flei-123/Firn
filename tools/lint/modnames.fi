import rt.rt
import fmt
import toks

export { try_load, imported_name_mentioned }

fn push_segment(b: *mut rt.Buf, f: *mut fmt.Form, w: usize) {
    let s: str = toks.word_str(f, w)
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn build_path(out: *mut rt.Buf, base: u64, base_n: usize, f: *mut fmt.Form, first: usize, last: usize) {
    if base_n > 0 {
        rt.buf_push_bytes(out, base, base_n)
        if rt.ld8(base, base_n - 1) != 47 as u8 {
            rt.buf_push(out, 47 as u8)
        }
    }
    var k: usize = first
    while k <= last {
        if toks.is_word(f, k) {
            push_segment(out, f, k)
        } else {
            rt.buf_push(out, 47 as u8)
        }
        k = k + 1
    }
    rt.buf_push_bytes(out, ".fi".p as u64, 3)
    rt.buf_push(out, 0 as u8)
}

fn dir_of(path: u64) -> usize {
    let n: usize = rt.c_length(path)
    var last: usize = 0
    var k: usize = 0
    while k < n {
        if rt.ld8(path, k) == 47 as u8 {
            last = k + 1
        }
        k = k + 1
    }
    return last
}

fn last_path_token(f: *mut fmt.Form, first: usize) -> usize {
    let n: usize = fmt.form_count(f)
    var last: usize = first
    var k: usize = first
    while true {
        let nk: usize = toks.next_code(f, k)
        if nk < n && fmt.is_sign(f, nk, fmt.S_DOT) {
            let w: usize = toks.next_code(f, nk)
            if w >= n {
                return last
            }
            last = w
            k = w
            continue
        }
        return last
    }
    return last
}

fn try_load(importer_path: u64, lib_dir: u64, f: *mut fmt.Form, import_tok: usize, source: *mut rt.Buf) -> bool {
    let first: usize = toks.next_code(f, import_tok)
    let last: usize = last_path_token(f, first)
    var p: rt.Buf = rt.buf_new()
    defer rt.buf_free(&p)
    build_path(&p, importer_path, dir_of(importer_path), f, first, last)
    if rt.read_file(rt.buf_ptr(&p), source) {
        return true
    }
    if lib_dir == 0 {
        return false
    }
    rt.buf_clear(&p)
    build_path(&p, lib_dir, rt.c_length(lib_dir), f, first, last)
    return rt.read_file(rt.buf_ptr(&p), source)
}

fn mentioned_in(importer: *mut fmt.Form, m: *mut fmt.Form, name_tok: usize) -> bool {
    let n: usize = fmt.form_count(importer)
    let np: u64 = fmt.form_source(m) + fmt.tok_start(m, name_tok) as u64
    let nl: usize = fmt.tok_length(m, name_tok)
    var k: usize = 0
    while k < n {
        if fmt.tok_kind(importer, k) == fmt.K_WORD && fmt.tok_length(importer, k) == nl {
            if rt.mem_eq(fmt.form_source(importer) + fmt.tok_start(importer, k) as u64, np, nl) {
                return true
            }
        }
        k = k + 1
    }
    return false
}

fn imported_name_mentioned(importer: *mut fmt.Form, m: *mut fmt.Form) -> bool {
    let n: usize = fmt.form_count(m)
    var depth: u32 = 0
    var exported: bool = false
    var k: usize = 0
    while k < n {
        if toks.is_kw(m, k, "export") && depth == 0 {
            let b: usize = toks.next_code(m, k)
            if b < n && fmt.is_sign(m, b, fmt.S_LBRACE) {
                exported = true
                var j: usize = b + 1
                while j < n && !fmt.is_sign(m, j, fmt.S_RBRACE) {
                    if toks.is_word(m, j) && mentioned_in(importer, m, j) {
                        return true
                    }
                    j = j + 1
                }
            }
        }
        if fmt.is_sign(m, k, fmt.S_LBRACE) {
            depth = depth + 1
        } else if fmt.is_sign(m, k, fmt.S_RBRACE) && depth > 0 {
            depth = depth - 1
        }
        k = k + 1
    }
    if exported {
        return false
    }
    depth = 0
    k = 0
    while k < n {
        if depth == 0 && (toks.is_kw(m, k, "fn") || toks.is_kw(m, k, "struct") || toks.is_kw(m, k, "const") || toks.is_kw(m, k, "static") || toks.is_kw(m, k, "enum") || toks.is_kw(m, k, "type")) {
            let w: usize = toks.next_code(m, k)
            if w < n && toks.is_word(m, w) && mentioned_in(importer, m, w) {
                return true
            }
        }
        if fmt.is_sign(m, k, fmt.S_LBRACE) {
            depth = depth + 1
        } else if fmt.is_sign(m, k, fmt.S_RBRACE) && depth > 0 {
            depth = depth - 1
        }
        k = k + 1
    }
    return false
}
