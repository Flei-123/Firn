import fmt
import toks

export { import_binding, import_statement }

fn import_statement(f: *mut fmt.Form, i: usize) -> bool {
    return toks.is_kw(f, i, "import") && toks.first_on_line(f, i)
}

fn import_binding(f: *mut fmt.Form, i: usize) -> usize {
    let n: usize = fmt.form_count(f)
    var k: usize = toks.next_code(f, i)
    if k >= n || !toks.is_word(f, k) {
        return n
    }
    var last: usize = k
    while true {
        let nk: usize = toks.next_code(f, k)
        if nk >= n {
            return last
        }
        if fmt.is_sign(f, nk, fmt.S_DOT) {
            let w: usize = toks.next_code(f, nk)
            if w >= n || !toks.is_word(f, w) {
                return n
            }
            last = w
            k = w
            continue
        }
        if toks.is_kw(f, nk, "as") && fmt.tok_line(f, nk) == fmt.tok_line(f, i) {
            let alias: usize = toks.next_code(f, nk)
            if alias < n && toks.is_word(f, alias) {
                return alias
            }
            return n
        }
        return last
    }
    return n
}
