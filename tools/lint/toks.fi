import rt.rt
import fmt
import ctx

export { word_str, is_word, is_kw, same_word, same_token, is_code, next_code,
    prev_code, first_on_line, line_head, text_mentions, any_text_mentions,
    is_key_position, statement_end, opens, closes, put, put_word, put_quoted_word, put_num }

fn word_str(f: *mut fmt.Form, i: usize) -> str {
    return str { p: (fmt.form_source(f) + fmt.tok_start(f, i) as u64) as *mut u8, n: fmt.tok_length(f, i) }
}

fn is_word(f: *mut fmt.Form, i: usize) -> bool {
    return fmt.tok_kind(f, i) == fmt.K_WORD
}

fn is_kw(f: *mut fmt.Form, i: usize, w: str) -> bool {
    return fmt.word_equals(f, i, w.p as u64, w.n)
}

fn same_word(f: *mut fmt.Form, i: usize, j: usize) -> bool {
    if !is_word(f, i) || !is_word(f, j) {
        return false
    }
    if fmt.tok_length(f, i) != fmt.tok_length(f, j) {
        return false
    }
    return rt.mem_eq(fmt.form_source(f) + fmt.tok_start(f, i) as u64, fmt.form_source(f) + fmt.tok_start(f, j) as u64, fmt.tok_length(f, i))
}

fn is_code(f: *mut fmt.Form, i: usize) -> bool {
    let k: u32 = fmt.tok_kind(f, i)
    return k != fmt.K_LINE_NOTE && k != fmt.K_BLOCK_NOTE
}

fn next_code(f: *mut fmt.Form, i: usize) -> usize {
    let n: usize = fmt.form_count(f)
    var k: usize = i + 1
    while k < n {
        if is_code(f, k) {
            return k
        }
        k = k + 1
    }
    return n
}

fn prev_code(f: *mut fmt.Form, i: usize) -> usize {
    var k: usize = i
    while k > 0 {
        k = k - 1
        if is_code(f, k) {
            return k
        }
    }
    return fmt.form_count(f)
}

fn same_token(f: *mut fmt.Form, i: usize, j: usize) -> bool {
    if fmt.tok_kind(f, i) != fmt.tok_kind(f, j) || fmt.tok_length(f, i) != fmt.tok_length(f, j) {
        return false
    }
    return rt.mem_eq(fmt.form_source(f) + fmt.tok_start(f, i) as u64, fmt.form_source(f) + fmt.tok_start(f, j) as u64, fmt.tok_length(f, i))
}

fn line_head(f: *mut fmt.Form, i: usize) -> usize {
    var k: usize = i
    while k > 0 && !first_on_line(f, k) {
        k = k - 1
    }
    return k
}

fn opens(f: *mut fmt.Form, k: usize) -> bool {
    return fmt.is_sign(f, k, fmt.S_LPAREN) || fmt.is_sign(f, k, fmt.S_LBRACKET) || fmt.is_sign(f, k, fmt.S_LBRACE)
}

fn closes(f: *mut fmt.Form, k: usize) -> bool {
    return fmt.is_sign(f, k, fmt.S_RPAREN) || fmt.is_sign(f, k, fmt.S_RBRACKET) || fmt.is_sign(f, k, fmt.S_RBRACE)
}

fn statement_end(f: *mut fmt.Form, i: usize) -> usize {
    let n: usize = fmt.form_count(f)
    var depth: u32 = 0
    var k: usize = i
    while k < n {
        if is_code(f, k) {
            if k > i && depth == 0 && first_on_line(f, k) {
                return k
            }
            if opens(f, k) {
                depth = depth + 1
            } else if closes(f, k) {
                if depth == 0 {
                    return k
                }
                depth = depth - 1
            }
        }
        k = k + 1
    }
    return n
}

fn first_on_line(f: *mut fmt.Form, i: usize) -> bool {
    if i == 0 {
        return true
    }
    return fmt.tok_end_line(f, i - 1) < fmt.tok_line(f, i)
}

fn is_ident_char(c: u8) -> bool {
    let v: u32 = c as u32
    return v == 95 || (v >= 48 && v <= 57) || (v >= 65 && v <= 90) || (v >= 97 && v <= 122)
}

fn text_contains(f: *mut fmt.Form, t: usize, w: usize) -> bool {
    let src: u64 = fmt.form_source(f)
    let ts: usize = fmt.tok_start(f, t)
    let tn: usize = fmt.tok_length(f, t)
    let wp: u64 = src + fmt.tok_start(f, w) as u64
    let wn: usize = fmt.tok_length(f, w)
    var k: usize = 0
    while k + wn <= tn {
        if rt.mem_eq(src + (ts + k) as u64, wp, wn) {
            var left: bool = true
            if k > 0 && is_ident_char(rt.ld8(src, ts + k - 1)) {
                left = false
            }
            var right: bool = true
            if k + wn < tn && is_ident_char(rt.ld8(src, ts + k + wn)) {
                right = false
            }
            if left && right {
                return true
            }
        }
        k = k + 1
    }
    return false
}

fn text_mentions(f: *mut fmt.Form, t: usize, w: usize) -> bool {
    if fmt.tok_kind(f, t) != fmt.K_TEXT {
        return false
    }
    if fmt.tok_length(f, t) < 3 || rt.ld8(fmt.form_source(f), fmt.tok_start(f, t)) != 102 as u8 {
        return false
    }
    return text_contains(f, t, w)
}

fn any_text_mentions(f: *mut fmt.Form, t: usize, w: usize) -> bool {
    if fmt.tok_kind(f, t) != fmt.K_TEXT {
        return false
    }
    return text_contains(f, t, w)
}

fn is_key_position(f: *mut fmt.Form, i: usize) -> bool {
    let p: usize = prev_code(f, i)
    let n: usize = next_code(f, i)
    if p < fmt.form_count(f) && fmt.is_sign(f, p, fmt.S_DOT) {
        return true
    }
    if p < fmt.form_count(f) && n < fmt.form_count(f) && fmt.is_sign(f, n, fmt.S_COLON) {
        if fmt.is_sign(f, p, fmt.S_LPAREN) || fmt.is_sign(f, p, fmt.S_LBRACE) || fmt.is_sign(f, p, fmt.S_COMMA) {
            return true
        }
    }
    return false
}

fn put(c: *mut ctx.Ctx, s: str) {
    rt.buf_push_bytes(&(*c).out, s.p as u64, s.n)
}

fn put_word(c: *mut ctx.Ctx, i: usize) {
    let s: str = word_str((*c).f, i)
    rt.buf_push_bytes(&(*c).out, s.p as u64, s.n)
}

fn put_quoted_word(c: *mut ctx.Ctx, i: usize) {
    rt.buf_push(&(*c).out, 96 as u8)
    put_word(c, i)
    rt.buf_push(&(*c).out, 96 as u8)
}

fn put_num(c: *mut ctx.Ctx, v: u64) {
    rt.buf_push_dec_u64(&(*c).out, v)
}
