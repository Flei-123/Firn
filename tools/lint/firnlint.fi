import rt.rt
import rt.vec
import fmt
import ctx
import registry

fn say(s: str) {
    rt.write_everything(2, s.p as u64, s.n)
}

fn complain(prefix: str, path: u64) {
    var b: rt.Buf = rt.buf_new()
    defer rt.buf_free(&b)
    rt.buf_push_bytes(&b, prefix.p as u64, prefix.n)
    rt.buf_push_bytes(&b, path, rt.c_length(path))
    rt.buf_push(&b, 10 as u8)
    rt.write_everything(2, rt.buf_ptr(&b), rt.buf_len(&b))
}

fn list_has(list: u64, n: usize, name: str) -> bool {
    var of: usize = 0
    var k: usize = 0
    while k <= n {
        if k == n || rt.ld8(list, k) == 44 as u8 {
            if k - of == name.n && rt.mem_eq(list + of as u64, name.p as u64, name.n) {
                return true
            }
            of = k + 1
        }
        k = k + 1
    }
    return false
}

fn print_rules(rules: *mut vec.Vec[registry.Rule]) {
    var b: rt.Buf = rt.buf_new()
    defer rt.buf_free(&b)
    var i: usize = 0
    while i < vec.vec_len[registry.Rule](rules) {
        let r: *mut registry.Rule = vec.vec_elem_ptr[registry.Rule](rules, i)
        rt.buf_push_bytes(&b, (*r).name.p as u64, (*r).name.n)
        rt.buf_push(&b, 9 as u8)
        rt.buf_push_bytes(&b, (*r).summary.p as u64, (*r).summary.n)
        rt.buf_push(&b, 10 as u8)
        i = i + 1
    }
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
}

fn count_lines(b: *mut rt.Buf) -> i64 {
    var n: i64 = 0
    var k: usize = 0
    while k < rt.buf_len(b) {
        if rt.buf_at(b, k) == 10 as u8 {
            n = n + 1
        }
        k = k + 1
    }
    return n
}

fn lint_source(rules: *mut vec.Vec[registry.Rule], source: *mut rt.Buf, path: u64, only: u64, only_n: usize, lib: u64) -> i64 {
    var f: fmt.Form = fmt.form_new(rt.buf_ptr(source), rt.buf_len(source))
    defer fmt.form_free(&f)
    fmt.form_scan(&f)
    if fmt.form_broken(&f) {
        return -1
    }
    var c: ctx.Ctx = ctx.ctx_new(&f, path, lib)
    defer ctx.ctx_free(&c)
    ctx.ctx_prepare(&c)
    var i: usize = 0
    while i < vec.vec_len[registry.Rule](rules) {
        let r: *mut registry.Rule = vec.vec_elem_ptr[registry.Rule](rules, i)
        if only_n == 0 || list_has(only, only_n, (*r).name) {
            ((*r).run)(&c)
        }
        i = i + 1
    }
    rt.write_everything(1, rt.buf_ptr(&c.out), rt.buf_len(&c.out))
    return count_lines(&c.out)
}

fn main(start: u64) -> i32 {
    var rules: vec.Vec[registry.Rule] = registry.registry_new()
    defer registry.registry_free(&rules)
    var only: u64 = 0
    var only_n: usize = 0
    var lib: u64 = 0
    var first: usize = 1
    let argc: usize = rt.arg_count(start)
    while first < argc {
        let a: u64 = rt.arg_ptr(start, first)
        if rt.c_length(a) < 2 || rt.ld8(a, 0) != 45 as u8 {
            break
        }
        if list_has(a, rt.c_length(a), "--list") {
            print_rules(&rules)
            return 0
        } else if list_has(a, rt.c_length(a), "--rules") && first + 1 < argc {
            only = rt.arg_ptr(start, first + 1)
            only_n = rt.c_length(only)
            first = first + 2
        } else if list_has(a, rt.c_length(a), "--lib") && first + 1 < argc {
            lib = rt.arg_ptr(start, first + 1)
            first = first + 2
        } else {
            say("usage: firnlint [--rules a,b] [--lib dir] file...\n       firnlint --list\n")
            return 2
        }
    }
    if first >= argc {
        say("usage: firnlint [--rules a,b] [--lib dir] file...\n       firnlint --list\n")
        return 2
    }
    var rc: i32 = 0
    var found: usize = 0
    var i: usize = first
    while i < argc {
        let path: u64 = rt.arg_ptr(start, i)
        var source: rt.Buf = rt.buf_new()
        if !rt.read_file(path, &source) {
            complain("firnlint: cannot read ", path)
            rt.buf_free(&source)
            return 2
        }
        let got: i64 = lint_source(&rules, &source, path, only, only_n, lib)
        if got < 0 {
            complain("firnlint: not a well formed source text: ", path)
            rc = 3
        } else {
            found = found + got as usize
        }
        rt.buf_free(&source)
        i = i + 1
    }
    if rc == 0 && found > 0 {
        rc = 1
    }
    return rc
}
