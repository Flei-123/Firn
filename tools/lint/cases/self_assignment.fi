struct V { x: f64, y: f64 }

fn demo(v: *mut V, a: f64) -> f64 {
    var dx: f64 = a
    dx = dx
    let first: f64 = dx
    (*v).x = (*v).x
    let second: f64 = first
    (*v).y = (*v).x
    dx = dx + 1.0
    let dx2: f64 = dx
    dx = next(dx)
    let third: f64 = dx2
    dx = next(dx)
    return dx + third + second
}

fn next(a: f64) -> f64 { return a }
