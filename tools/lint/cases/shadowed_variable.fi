fn param(a: i32, b: i32) -> i32 {
    let a: i32 = 2
    return a + b
}

fn nested(v: i32) -> i32 {
    let x: i32 = v
    if v > 0 {
        let x: i32 = 5
        return x
    }
    return x
}

fn separate(v: i32) -> i32 {
    let x: i32 = v
    return x
}

fn siblings(v: i32) -> i32 {
    if v > 0 {
        let t: i32 = 1
        return t
    }
    if v < 0 {
        let t: i32 = 2
        return t
    }
    return 0
}
