export { shown, used_by_table }

static mut LIVE: usize = 0
static mut DEAD: usize = 0

fn shown() -> usize { return helper() }

fn helper() -> usize { return LIVE }

fn dead_helper() -> usize { return 1 }

fn used_by_table() -> usize { return 2 }

fn _kept() -> usize { return 3 }

fn from_text() -> usize { return 4 }

#[no_gc]
fn attributed() -> usize { return 5 }

fn main(start: u64) -> i32 {
    let s: str = f"{from_text()}"
    return s.n as i32
}
