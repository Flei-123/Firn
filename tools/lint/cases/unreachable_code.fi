fn after_return(v: i32) -> i32 {
    return v
    v = 3
}

fn loops(n: i32) -> i32 {
    var i: i32 = 0
    while i < n {
        if i == 5 {
            break
            i = 9
        }
        if i == 6 {
            continue
        }
        i = i + 1
        continue
        i = 100
    }
    return i
}

fn fine(v: i32) -> i32 {
    if v > 0 {
        return 1
    }
    if v < 0 {
        return 2
    } else {
        return 3
    }
}

fn multiline(v: i32) -> i32 {
    return foo(
        v,
        2
    )
}
