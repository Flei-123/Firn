import std.rt

struct Holder {
    name: str,
    count: u64,
}

struct Plain {
    a: u64,
    b: u32,
}

fn holder_new() -> *mut Holder {
    let h: *mut Holder = rt.heap_alloc(size_of[Holder]()) as *mut Holder
    gc_track[Holder](h as u64, size_of[Holder]())
    return h
}

fn plain_new() -> *mut Plain {
    return rt.heap_alloc(size_of[Plain]()) as *mut Plain
}
