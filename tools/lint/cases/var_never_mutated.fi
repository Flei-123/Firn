struct P { n: usize }

fn demo(q: *mut P) -> usize {
    var fixed: usize = 4
    var counted: usize = 0
    var taken: usize = 1
    var late: usize
    var rec: P = P { n: 1 }
    var shifted: usize = 2
    counted = counted + 1
    late = 5
    bump(&taken)
    shifted <<= 1
    (*q).n = rec.n
    return fixed + counted + taken + late + shifted
}

fn bump(p: *mut usize) {
    *p = *p + 1
}

fn change(p: *mut usize) {
    *p = 9
}

fn passes() -> usize {
    var out: usize = 0
    change(inout out)
    var kept: usize = 3
    return out + kept
}
