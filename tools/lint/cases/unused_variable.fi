import rt.rt

struct P { n: usize, tag: usize }
struct G { c: *mut usize }
impl G { fn drop(inout self) { *self.c = *self.c + 1 } }
fn make(c: *mut usize) -> G { return G { c: c } }

fn demo(b: *mut rt.Buf) -> usize {
    let dead: usize = 7
    let kept: usize = 8
    let _ignored: usize = 9
    let side: bool = rt.buf_len(b) > 0
    let counter: usize = 0
    let n: usize = 3
    let p: P = P { n: kept, tag: 1 }
    let label: str = "x"
    let text: str = f"value {label}"
    var unused_flag: bool = false
    let guard: G = G { c: &counter }
    let made: G = make(&counter)
    let moved: G = made
    let bare = 5
    return p.n + counter + text.n
}
