import rt.rt
import fmt

export { Ctx, NONE, ctx_new, ctx_free, ctx_prepare, ctx_count, close_of,
    owner_of, ctx_emit_head, ctx_emit_done }

const NONE: u32 = 4294967295

struct Ctx {
    f: *mut fmt.Form,
    path: u64,
    lib: u64,
    close: rt.Buf,
    owner: rt.Buf,
    out: rt.Buf,
}

fn ctx_new(f: *mut fmt.Form, path: u64, lib: u64) -> Ctx {
    return Ctx {
        f: f, path: path, lib: lib, close: rt.buf_new(), owner: rt.buf_new(),
        out: rt.buf_new(),
    }
}

fn ctx_free(c: *mut Ctx) {
    rt.buf_free(&(*c).close)
    rt.buf_free(&(*c).owner)
    rt.buf_free(&(*c).out)
}

fn ctx_count(c: *mut Ctx) -> usize {
    return fmt.form_count((*c).f)
}

fn col_push(b: *mut rt.Buf, v: u32) {
    rt.buf_push(b, (v & 255) as u8)
    rt.buf_push(b, ((v >> 8) & 255) as u8)
    rt.buf_push(b, ((v >> 16) & 255) as u8)
    rt.buf_push(b, ((v >> 24) & 255) as u8)
}

fn close_of(c: *mut Ctx, i: usize) -> u32 {
    return rt.ld32(rt.buf_ptr(&(*c).close), i)
}

fn owner_of(c: *mut Ctx, i: usize) -> u32 {
    return rt.ld32(rt.buf_ptr(&(*c).owner), i)
}

fn ctx_prepare(c: *mut Ctx) {
    let n: usize = ctx_count(c)
    let f: *mut fmt.Form = (*c).f
    var stack: rt.Buf = rt.buf_new()
    defer rt.buf_free(&stack)
    var i: usize = 0
    while i < n {
        col_push(&(*c).close, NONE)
        i = i + 1
    }
    i = 0
    while i < n {
        var top: u32 = NONE
        if rt.buf_len(&stack) > 0 {
            top = rt.ld32(rt.buf_ptr(&stack), rt.buf_len(&stack) / 4 - 1)
        }
        if fmt.is_sign(f, i, fmt.S_LBRACE) {
            col_push(&(*c).owner, top)
            col_push(&stack, i as u32)
        } else if fmt.is_sign(f, i, fmt.S_RBRACE) {
            if top != NONE {
                rt.st32(rt.buf_ptr(&(*c).close), top as usize, i as u32)
                rt.buf_set_len(&stack, rt.buf_len(&stack) - 4)
                var below: u32 = NONE
                if rt.buf_len(&stack) > 0 {
                    below = rt.ld32(rt.buf_ptr(&stack), rt.buf_len(&stack) / 4 - 1)
                }
                col_push(&(*c).owner, below)
            } else {
                col_push(&(*c).owner, NONE)
            }
        } else {
            col_push(&(*c).owner, top)
        }
        i = i + 1
    }
}

fn ctx_emit_head(c: *mut Ctx, rule: str, line: u32) {
    rt.buf_push_bytes(&(*c).out, (*c).path, rt.c_length((*c).path))
    rt.buf_push(&(*c).out, 58 as u8)
    rt.buf_push_dec_u64(&(*c).out, line as u64)
    rt.buf_push(&(*c).out, 58 as u8)
    rt.buf_push(&(*c).out, 32 as u8)
    rt.buf_push_bytes(&(*c).out, rule.p as u64, rule.n)
    rt.buf_push(&(*c).out, 58 as u8)
    rt.buf_push(&(*c).out, 32 as u8)
}

fn ctx_emit_done(c: *mut Ctx) {
    rt.buf_push(&(*c).out, 10 as u8)
}
