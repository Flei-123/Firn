// SPDX-License-Identifier: MPL-2.0
// tools/tls/p256_main.fi -- command line face of lib/std/crypto/p256.fi for
// tools/tls/p256_check.py:
//
//   p256_main pub  <d hex>                     -> 04xy hex
//   p256_main sign <d hex> <hash hex> [extra]  -> r hex, space, s hex, space, DER hex
//   p256_main mult <k hex> <x hex> <y hex>     -> x hex, space, y hex  (or "inf")
import std.rt
import std.io
import std.crypto.p256

fn hexval(c: u8) -> u32 {
    if c >= 48 as u8 && c <= 57 as u8 { return (c - 48 as u8) as u32 }
    if c >= 97 as u8 && c <= 102 as u8 { return (c - 87 as u8) as u32 }
    if c >= 65 as u8 && c <= 70 as u8 { return (c - 55 as u8) as u32 }
    return 0 as u32
}

fn unhex(a: u64, out: u64, max: usize) -> usize {
    let n: usize = rt.c_length(a) / 2
    var i: usize = 0
    while i < n && i < max {
        let hi: u32 = hexval(rt.ld8(a, 2 * i))
        let lo: u32 = hexval(rt.ld8(a, 2 * i + 1))
        rt.st8(out, i, ((hi << 4) | lo) as u8)
        i = i + 1
    }
    return i
}

fn hex(b: *mut rt.Buf, p: u64, n: usize) {
    var d: [u8; 16] = "0123456789abcdef"
    var i: usize = 0
    while i < n {
        let v: u8 = rt.ld8(p, i)
        rt.buf_push(b, d[(v >> 4) as usize])
        rt.buf_push(b, d[(v & 15 as u8) as usize])
        i = i + 1
    }
}

fn say(b: *mut rt.Buf) {
    io.print_line(str { p: (*b).ptr as *mut u8, n: (*b).len })
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 { return 2 }
    let cmd: u64 = rt.arg_ptr(start, 1)
    var out: rt.Buf = rt.buf_new()
    var d: [u8; 32] = [0; 32]
    unhex(rt.arg_ptr(start, 2), (&d[0]) as u64, 32)
    if rt.ld8(cmd, 0) == 112 as u8 { // pub
        var pk: [u8; 65] = [0; 65]
        if !p256.p256_public((&d[0]) as u64, (&pk[0]) as u64) { return 1 }
        hex(&out, (&pk[0]) as u64, 65)
        say(&out)
        return 0
    }
    if rt.ld8(cmd, 0) == 115 as u8 { // sign
        if rt.arg_count(start) < 4 { return 2 }
        var h: [u8; 32] = [0; 32]
        unhex(rt.arg_ptr(start, 3), (&h[0]) as u64, 32)
        var ex: [u8; 64] = [0; 64]
        var en: usize = 0
        if rt.arg_count(start) > 4 {
            en = unhex(rt.arg_ptr(start, 4), (&ex[0]) as u64, 64)
        }
        var r: [u8; 32] = [0; 32]
        var s: [u8; 32] = [0; 32]
        if !p256.p256_sign((&d[0]) as u64, (&h[0]) as u64, (&ex[0]) as u64, en,
            (&r[0]) as u64, (&s[0]) as u64) { return 1 }
        hex(&out, (&r[0]) as u64, 32)
        rt.buf_push(&out, 32 as u8)
        hex(&out, (&s[0]) as u64, 32)
        rt.buf_push(&out, 32 as u8)
        var der: rt.Buf = rt.buf_new()
        p256.p256_sig_der((&r[0]) as u64, (&s[0]) as u64, &der)
        hex(&out, der.ptr, der.len)
        var r2: [u8; 32] = [0; 32]
        var s2: [u8; 32] = [0; 32]
        if !p256.p256_sig_from_der(der.ptr, der.len, (&r2[0]) as u64, (&s2[0]) as u64) { return 3 }
        if !rt.mem_eq((&r2[0]) as u64, (&r[0]) as u64, 32) { return 4 }
        if !rt.mem_eq((&s2[0]) as u64, (&s[0]) as u64, 32) { return 5 }
        say(&out)
        return 0
    }
    if rt.ld8(cmd, 0) == 109 as u8 { // mult
        if rt.arg_count(start) < 5 { return 2 }
        var x: [u8; 32] = [0; 32]
        var y: [u8; 32] = [0; 32]
        unhex(rt.arg_ptr(start, 3), (&x[0]) as u64, 32)
        unhex(rt.arg_ptr(start, 4), (&y[0]) as u64, 32)
        var ox: [u8; 32] = [0; 32]
        var oy: [u8; 32] = [0; 32]
        if !p256.p256_mult((&d[0]) as u64, (&x[0]) as u64, (&y[0]) as u64,
            (&ox[0]) as u64, (&oy[0]) as u64) {
            io.print_line("inf")
            return 0
        }
        hex(&out, (&ox[0]) as u64, 32)
        rt.buf_push(&out, 32 as u8)
        hex(&out, (&oy[0]) as u64, 32)
        say(&out)
        return 0
    }
    return 2
}
