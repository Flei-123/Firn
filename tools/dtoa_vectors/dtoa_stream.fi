// expect_exit: 0
// GENERATED by tools/strlib/expand.py from tools/strlib/src/dtoa_stream.fi -- do not edit by hand.
// Number stream: reads 8-byte bit patterns from standard input, writes the
// shortest representation (lib/num/dtoa.fi) as a text line for each one and
// checks at the same time that strtod (lib/num/strtod.fi) makes EXACTLY the
// same bit pattern out of it again. Exit code 0 only if every conversion back
// was bit-identical; the summary goes to the error output (fd 2) so that the
// standard output consists purely of numbers.
//
// Without input (an empty standard input) the program runs through with 0 at once --
// so test.sh can compile and run it along without danger.
// lib/str/alloc.fi -- memory without libc (module str).
//
// Stage 0 has neither global variables nor aggregates across function
// boundaries; that is why the whole library works with pointers to
// structures held by the caller. The memory comes straight from mmap(2).
//
// Include:  //#include lib/str/alloc.fi

// ROUND 73: the pure memory work (copy/compare/zero, ld*/st*, page_round)
// moved to `lib/str/core_mem.fi` -- it is the part that a freestanding
// kernel may use. Everything that is LEFT here needs the operating
// system: mmap, munmap, write. Whoever includes this file gets both, so
// no existing caller notices the cut.
// lib/str/core_mem.fi -- memory work WITHOUT the operating system (round 73).
//
// The pure half of `lib/str/alloc.fi`: copying, comparing, zeroing and the
// raw load/store helpers for the 8/16/32/64 bit elements of a block.
// Not one of these functions asks anybody for memory and not one of them
// makes a system call -- they work on memory that the CALLER already
// holds. That is exactly the line along which round 73 cuts the library
// (docs/ROUND73.md): whatever stands here may be used under
// `profile kernel`.
//
// `page_round` stands here as well although it smells of mmap: it is
// arithmetic on a number and nothing else. Whoever rounds a length to
// pages has not yet asked for a single page.
//
// Include:  //#include lib/str/core_mem.fi

fn page_round(n: usize) -> usize {
    return (n + 4095) / 4096 * 4096
}

fn mem_copy(dst: *mut u8, src: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = *((src as usize + i) as *mut u8)
        i = i + 1
    }
}

fn mem_zero(dst: *mut u8, n: usize) {
    var i: usize = 0
    while i < n {
        *((dst as usize + i) as *mut u8) = 0 as u8
        i = i + 1
    }
}

fn mem_eq(a: *mut u8, b: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        if *((a as usize + i) as *mut u8) != *((b as usize + i) as *mut u8) {
            return false
        }
        i = i + 1
    }
    return true
}

// Raw read/write helpers for the 16/32/64 bit elements of a block.
fn ld16(p: *mut u8, i: usize) -> u16 {
    return *((p as usize + i * 2) as *mut u16)
}
fn st16(p: *mut u8, i: usize, v: u16) {
    *((p as usize + i * 2) as *mut u16) = v
}
fn ld32(p: *mut u8, i: usize) -> u32 {
    return *((p as usize + i * 4) as *mut u32)
}
fn st32(p: *mut u8, i: usize, v: u32) {
    *((p as usize + i * 4) as *mut u32) = v
}
fn ld64(p: *mut u8, i: usize) -> u64 {
    return *((p as usize + i * 8) as *mut u64)
}
fn st64(p: *mut u8, i: usize, v: u64) {
    *((p as usize + i * 8) as *mut u64) = v
}
fn ld8(p: *mut u8, i: usize) -> u8 {
    return *((p as usize + i) as *mut u8)
}
fn st8(p: *mut u8, i: usize, v: u8) {
    *((p as usize + i) as *mut u8) = v
}

const SYS_WRITE: i64 = 1
const SYS_READ: i64 = 0
const SYS_MMAP: i64 = 9
const SYS_MUNMAP: i64 = 11
const SYS_EXIT: i64 = 60
const PROT_READ_WRITE: i64 = 3
const MAP_PRIVATE_ANON: i64 = 34

// Returns n contiguous bytes (zero initialized) or 0 on failure.
fn heap_alloc(n: usize) -> *mut u8 {
    if n == 0 {
        return 0 as *mut u8
    }
    let len: usize = page_round(n)
    let r: i64 = syscall(SYS_MMAP, 0, len as i64, PROT_READ_WRITE, MAP_PRIVATE_ANON, -1, 0)
    // mmap reports failure as -1..-4095
    if r < 0 && r > -4096 {
        return 0 as *mut u8
    }
    return r as *mut u8
}

fn heap_free(p: *mut u8, n: usize) {
    if p as usize != 0 {
        syscall(SYS_MUNMAP, p as i64, page_round(n) as i64)
    }
}

fn write_all(fd: i64, p: *mut u8, n: usize) {
    var off: usize = 0
    while off < n {
        let r: i64 = syscall(SYS_WRITE, fd, (p as usize + off) as i64, (n - off) as i64)
        if r <= 0 {
            return
        }
        off = off + r as usize
    }
}

// lib/str/bytes.fi -- `Bytes` (raw octets) and `Str` (validated UTF-8).
//
// The layout is a contract (SPEC 8.1, PLAN 3.3):
//     Bytes { ptr: *mut u8, len: usize, cap: usize }
//     Str   has the same layout, its content is additionally validated UTF-8.
//
// `Bytes` NEVER turns into text silently: the conversion goes exclusively
// through `bytes_to_str` (which validates) or `str_from_bytes_lossy`.
//
// Include:  //#include lib/str/bytes.fi   (needs lib/str/alloc.fi)

struct Bytes {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

fn bytes_init(b: *mut Bytes) {
    (*b).ptr = 0 as *mut u8
    (*b).len = 0
    (*b).cap = 0
}

fn bytes_free(b: *mut Bytes) {
    heap_free((*b).ptr, (*b).cap)
    bytes_init(b)
}

fn bytes_reserve(b: *mut Bytes, need: usize) {
    if (*b).cap >= need {
        return
    }
    var cap: usize = (*b).cap
    if cap == 0 {
        cap = 32
    }
    while cap < need {
        cap = cap * 2
    }
    let p: *mut u8 = heap_alloc(cap)
    if (*b).len > 0 {
        mem_copy(p, (*b).ptr, (*b).len)
    }
    heap_free((*b).ptr, (*b).cap)
    (*b).ptr = p
    (*b).cap = cap
}

fn bytes_push(b: *mut Bytes, v: u8) {
    bytes_reserve(b, (*b).len + 1)
    st8((*b).ptr, (*b).len, v)
    (*b).len = (*b).len + 1
}

fn bytes_len(b: *mut Bytes) -> usize {
    return (*b).len
}

fn bytes_at(b: *mut Bytes, i: usize) -> u8 {
    if i >= (*b).len {
        return 0 as u8
    }
    return ld8((*b).ptr, i)
}

fn bytes_clear(b: *mut Bytes) {
    (*b).len = 0
}

fn bytes_append(b: *mut Bytes, p: *mut u8, n: usize) {
    bytes_reserve(b, (*b).len + n)
    mem_copy(((*b).ptr as usize + (*b).len) as *mut u8, p, n)
    (*b).len = (*b).len + n
}

fn bytes_eq(a: *mut Bytes, b: *mut Bytes) -> bool {
    if (*a).len != (*b).len {
        return false
    }
    return mem_eq((*a).ptr, (*b).ptr, (*a).len)
}

fn bytes_write(fd: i64, b: *mut Bytes) {
    write_all(fd, (*b).ptr, (*b).len)
}

// --- UTF-8 validation (the Bytes -> Str boundary, SPEC 8.1) --------------

// Well formed UTF-8 per Unicode table 3-7: no overlong encoding,
// no surrogates (U+D800..U+DFFF), nothing above U+10FFFF.
fn utf8_is_valid(p: *mut u8, n: usize) -> bool {
    var i: usize = 0
    while i < n {
        let b0: u32 = ld8(p, i) as u32
        var need: usize = 0
        var lo: u32 = 0
        var hi: u32 = 0
        if b0 < 0x80 {
            need = 0
        } else if b0 >= 0xC2 && b0 <= 0xDF {
            need = 1
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xE0 {
            need = 2
            lo = 0xA0
            hi = 0xBF
        } else if b0 >= 0xE1 && b0 <= 0xEC {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xED {
            need = 2
            lo = 0x80
            hi = 0x9F
        } else if b0 >= 0xEE && b0 <= 0xEF {
            need = 2
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF0 {
            need = 3
            lo = 0x90
            hi = 0xBF
        } else if b0 >= 0xF1 && b0 <= 0xF3 {
            need = 3
            lo = 0x80
            hi = 0xBF
        } else if b0 == 0xF4 {
            need = 3
            lo = 0x80
            hi = 0x8F
        } else {
            return false
        }
        if need > 0 && i + need >= n {
            return false
        }
        var k: usize = 1
        while k <= need {
            let c: u32 = ld8(p, i + k) as u32
            if k == 1 {
                if c < lo || c > hi {
                    return false
                }
            } else {
                if c < 0x80 || c > 0xBF {
                    return false
                }
            }
            k = k + 1
        }
        i = i + need + 1
    }
    return true
}

// Bytes -> Str: succeeds only for well formed UTF-8 (validates, copies nothing).
fn bytes_is_str(b: *mut Bytes) -> bool {
    return utf8_is_valid((*b).ptr, (*b).len)
}

// lib/str/print.fi -- minimal output without libc (numbers and octets).
// Used by the test programs only.
//
// Include:  //#include lib/str/print.fi   (needs lib/str/alloc.fi)

struct PrintBuf {
    b: [u8; 32],
    n: usize,
}

// A decimal number followed by a space.
fn print_num(v: u64) {
    print_num_sep(v, 32 as u8)
}

// A decimal number followed by a line break (the last value of a line).
fn print_num_nl(v: u64) {
    print_num_sep(v, 10 as u8)
}

// A decimal number followed by a separator of your choice.
fn print_num_sep(v: u64, sep: u8) {
    var p: PrintBuf = PrintBuf { b: [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8], n: 0, }
    var x: u64 = v
    var n: usize = 0
    if x == 0 {
        p.b[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        p.b[n] = (x % 10) as u8 + 48 as u8
        x = x / 10
        n = n + 1
    }
    var i: usize = 0
    while i < n / 2 {
        let t: u8 = p.b[i]
        p.b[i] = p.b[n - 1 - i]
        p.b[n - 1 - i] = t
        i = i + 1
    }
    p.b[n] = sep
    write_all(1, &p.b[0], n + 1)
}

// Line break.
fn print_nl() {
    var p: PrintBuf = PrintBuf { b: [10 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
            0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8], n: 0, }
    write_all(1, &p.b[0], 1)
}

// A single octet as a character (for text output from a Bytes buffer).
fn print_bytes_raw(b: *mut Bytes) {
    write_all(1, (*b).ptr, (*b).len)
}

// lib/num/bignum.fi -- big numbers (unsigned) for strtod/dtoa.
//
// Representation: a sequence of u32 digits, least significant first, in a
// block of memory provided by the caller. `n` is the number of digits in
// use (leading zero digits are cut off), `cap` is the capacity.
// Every computation is exact -- that is exactly what a correctly rounded
// strtod and the shortest output need.
//
// Include:  //#include lib/num/bignum.fi   (needs lib/str/alloc.fi)

const BN_LIMBS: usize = 512 // 512 * 32 bit = 16384 bit, enough for
// 10^400 * 10^780 including the shifts

struct Bn {
    d: *mut u8,
    n: usize,
    cap: usize,
}

fn bn_init(b: *mut Bn, mem: *mut u8, cap: usize) {
    (*b).d = mem
    (*b).n = 0
    (*b).cap = cap
}

fn bn_limb(b: *mut Bn, i: usize) -> u32 {
    if i >= (*b).n {
        return 0 as u32
    }
    return ld32((*b).d, i)
}

fn bn_setlimb(b: *mut Bn, i: usize, v: u32) {
    if i >= (*b).cap {
        return
    }
    st32((*b).d, i, v)
    if i >= (*b).n {
        var k: usize = (*b).n
        while k < i {
            st32((*b).d, k, 0 as u32)
            k = k + 1
        }
        (*b).n = i + 1
    }
}

fn bn_norm(b: *mut Bn) {
    while (*b).n > 0 {
        if ld32((*b).d, (*b).n - 1) != 0 as u32 {
            return
        }
        (*b).n = (*b).n - 1
    }
}

fn bn_zero(b: *mut Bn) {
    (*b).n = 0
}

fn bn_is_zero(b: *mut Bn) -> bool {
    return (*b).n == 0
}

fn bn_set_u64(b: *mut Bn, v: u64) {
    (*b).n = 0
    if v == 0 {
        return
    }
    st32((*b).d, 0, (v & 0xFFFFFFFF) as u32)
    (*b).n = 1
    if v >= 4294967296 {
        st32((*b).d, 1, (v >> 32) as u32)
        (*b).n = 2
    }
}

fn bn_copy(dst: *mut Bn, src: *mut Bn) {
    var i: usize = 0
    while i < (*src).n {
        st32((*dst).d, i, ld32((*src).d, i))
        i = i + 1
    }
    (*dst).n = (*src).n
}

fn bn_cmp(a: *mut Bn, b: *mut Bn) -> i32 {
    if (*a).n != (*b).n {
        if (*a).n < (*b).n {
            return -1
        }
        return 1
    }
    var i: usize = (*a).n
    while i > 0 {
        i = i - 1
        let x: u32 = ld32((*a).d, i)
        let y: u32 = ld32((*b).d, i)
        if x != y {
            if x < y {
                return -1
            }
            return 1
        }
    }
    return 0
}

// a += b
fn bn_add(a: *mut Bn, b: *mut Bn) {
    var carry: u64 = 0
    var i: usize = 0
    var m: usize = (*a).n
    if (*b).n > m {
        m = (*b).n
    }
    while i < m || carry != 0 {
        if i >= (*a).cap {
            return
        }
        let s: u64 = bn_limb(a, i) as u64 + bn_limb(b, i) as u64 + carry
        bn_setlimb(a, i, (s & 0xFFFFFFFF) as u32)
        carry = s >> 32
        i = i + 1
    }
    bn_norm(a)
}

// a -= b, precondition a >= b
fn bn_sub(a: *mut Bn, b: *mut Bn) {
    var borrow: u64 = 0
    var i: usize = 0
    while i < (*a).n {
        let x: u64 = bn_limb(a, i) as u64
        let y: u64 = bn_limb(b, i) as u64 + borrow
        if x >= y {
            st32((*a).d, i, (x - y) as u32)
            borrow = 0
        } else {
            st32((*a).d, i, (x + 4294967296 - y) as u32)
            borrow = 1
        }
        i = i + 1
    }
    bn_norm(a)
}

// a *= m
fn bn_mul_small(a: *mut Bn, m: u32) {
    if m == 0 as u32 {
        bn_zero(a)
        return
    }
    var carry: u64 = 0
    var i: usize = 0
    let n: usize = (*a).n
    while i < n {
        let p: u64 = ld32((*a).d, i) as u64 * m as u64 + carry
        st32((*a).d, i, (p & 0xFFFFFFFF) as u32)
        carry = p >> 32
        i = i + 1
    }
    while carry != 0 {
        bn_setlimb(a, i, (carry & 0xFFFFFFFF) as u32)
        carry = carry >> 32
        i = i + 1
    }
    bn_norm(a)
}

// a += v
fn bn_add_small(a: *mut Bn, v: u32) {
    var carry: u64 = v as u64
    var i: usize = 0
    while carry != 0 {
        let s: u64 = bn_limb(a, i) as u64 + carry
        bn_setlimb(a, i, (s & 0xFFFFFFFF) as u32)
        carry = s >> 32
        i = i + 1
    }
    bn_norm(a)
}

fn bn_bitlen(a: *mut Bn) -> usize {
    if (*a).n == 0 {
        return 0
    }
    var v: u32 = ld32((*a).d, (*a).n - 1)
    var bits: usize = 0
    while v != 0 as u32 {
        v = v >> 1
        bits = bits + 1
    }
    return ((*a).n - 1) * 32 + bits
}

// a <<= bits
fn bn_shl(a: *mut Bn, bits: usize) {
    if (*a).n == 0 || bits == 0 {
        return
    }
    let words: usize = bits / 32
    let sh: usize = bits % 32
    var i: usize = (*a).n
    if sh == 0 {
        while i > 0 {
            i = i - 1
            bn_setlimb(a, i + words, ld32((*a).d, i))
        }
    } else {
        // the new top digit first
        let top: u32 = ld32((*a).d, (*a).n - 1) >> (32 - sh)
        if top != 0 as u32 {
            bn_setlimb(a, (*a).n + words, top)
        }
        while i > 0 {
            i = i - 1
            var v: u32 = ld32((*a).d, i) << sh
            if i > 0 {
                v = v + (ld32((*a).d, i - 1) >> (32 - sh))
            }
            bn_setlimb(a, i + words, v)
        }
    }
    var k: usize = 0
    while k < words {
        st32((*a).d, k, 0 as u32)
        k = k + 1
    }
    bn_norm(a)
}

// a *= 10^e
fn bn_mul_pow10(a: *mut Bn, e: usize) {
    var r: usize = e
    while r >= 9 {
        bn_mul_small(a, 1000000000 as u32)
        r = r - 9
    }
    var m: u32 = 1 as u32
    var k: usize = 0
    while k < r {
        m = m * 10 as u32
        k = k + 1
    }
    if m != 1 as u32 {
        bn_mul_small(a, m)
    }
}

// dst = 10^e
fn bn_pow10(dst: *mut Bn, e: usize) {
    bn_set_u64(dst, 1)
    bn_mul_pow10(dst, e)
}

// Integer division: returns the floor of num/`the` as a u64 and leaves the
// remainder in `num`. Precondition: the quotient fits in 64 bit (the caller
// scales beforehand). `tmp` is scratch memory.
fn bn_div_q(num: *mut Bn, the: *mut Bn, tmp: *mut Bn) -> u64 {
    if bn_cmp(num, the) < 0 {
        return 0
    }
    let bn: usize = bn_bitlen(num)
    let bd: usize = bn_bitlen(the)
    var k: usize = bn - bd
    if k > 63 {
        // The caller scaled wrongly; a clean 0 is better than a
        // silently wrong answer.
        return 0
    }
    var q: u64 = 0
    var i: usize = k + 1
    while i > 0 {
        i = i - 1
        bn_copy(tmp, the)
        bn_shl(tmp, i)
        if bn_cmp(num, tmp) >= 0 {
            bn_sub(num, tmp)
            q = q + (1 << i)
        }
    }
    return q
}

// One decimal digit: the floor of num/`the` (0..9); the rest stays in `num`.
// Precondition: num < 10 * `the`.
fn bn_div_digit(num: *mut Bn, the: *mut Bn) -> u32 {
    var d: u32 = 0
    while bn_cmp(num, the) >= 0 {
        bn_sub(num, the)
        d = d + 1 as u32
        if d > 10 as u32 {
            return d
        }
    }
    return d
}

// lib/num/strtod.fi -- text -> IEEE-754 double precision, CORRECTLY ROUNDED
// (SPEC 8.4, requirement Z5).
//
// Stage 0 has no floating point type (yet); `strtod` therefore returns the
// BIT PATTERN of the double as a `u64`. That is no shortcut: the whole
// computation runs in integer arithmetic anyway, and `dtoa` works on the
// same bit pattern. As soon as the language has `f64`, a thin wrapper goes
// on top (see ACCEPTANCE.md, section str).
//
// Method: exact big number arithmetic. The value is held as a fraction
// of two big integers, D * 10^exp, scaled so that the quotient has exactly
// 53 bit, and from the remainder it is rounded to the nearest double -- at
// exactly half distance towards the EVEN mantissa. The result is therefore
// the correctly rounded one for EVERY input, including 2.2250738585072011e-308,
// 9007199254740993 and 5e-324.
//
// The form it recognizes:  [+-] digits [ . digits ] [ (e|E) [+-] digits ]
// Deliberately not recognized (the calling layer's job): "Infinity", "NaN",
// hexadecimal floating point, leading whitespace.
//
// Include:  //#include lib/num/strtod.fi  (needs alloc.fi, bignum.fi)

const D_INF_BITS: u64 = 0x7FF0000000000000
const D_SIGN_BIT: u64 = 0x8000000000000000
const D_TWO52: u64 = 4503599627370496
const D_TWO53: u64 = 9007199254740992
const D_MAXDIG: usize = 780 // significant digits, a sticky bit after them
const STRTOD_WS_BYTES: usize = 6 * 512 * 4

// ROUND 73: renamed from `is_digit`. `lib/std/core.fi` puts this file
// and the text facade into ONE module, and the facade has an
// `is_digit` of its own (lib/str/core_facade.fi). Two functions of the
// same name would be a compile error -- and of the two names this one
// is the one that only strtod uses.
fn strtod_digit(c: u8) -> bool {
    return c >= 48 as u8 && c <= 57 as u8
}

fn u64_bitlen(v: u64) -> usize {
    var x: u64 = v
    var n: usize = 0
    while x != 0 {
        x = x >> 1
        n = n + 1
    }
    return n
}

// The quotient of 2^s * num0 / den0; the remainder stays in `numw`, the
// scaled denominator in `denw` (the rounding afterwards needs both).
fn strtod_quot(num0: *mut Bn, den0: *mut Bn, numw: *mut Bn, denw: *mut Bn, tmp: *mut Bn, s: i64) -> u64 {
    bn_copy(numw, num0)
    bn_copy(denw, den0)
    if s >= 0 {
        bn_shl(numw, s as usize)
    } else {
        bn_shl(denw, (0 - s) as usize)
    }
    return bn_div_q(numw, denw, tmp)
}

// Text -> bit pattern. `consumed` receives the number of characters used up
// (0 = no valid number). `ws` needs STRTOD_WS_BYTES bytes.
// ROUND 71 -- `odd = true` rounds TO ODD instead of to nearest: cut off,
// and set the last bit when anything was left over.
//
// That is what makes a correct `f32` possible. The way decimal -> binary64
// (nearest) -> binary32 (nearest) is NOT correctly rounded: at the exact
// middle between two binary32 the intermediate rounding lands ON the middle,
// and the tie-to-even then decides without knowing which side the real value
// lay on. Measured against C `strtof`: 63568 of 239064 such cases came out
// one ulp wrong. With round-to-odd it cannot happen -- a value whose last
// bit is set is never exactly a binary32 middle (Boldo/Melquiond, 53 >= 24+2).
fn strtod_mode(p: *mut u8, len: usize, ws: *mut u8, consumed: *mut usize, odd: bool) -> u64 {
    *consumed = 0
    var d: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var num0: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var den0: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var numw: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var denw: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var tmp: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    let stride: usize = BN_LIMBS * 4
    bn_init(&d, ws, BN_LIMBS)
    bn_init(&num0, (ws as usize + stride) as *mut u8, BN_LIMBS)
    bn_init(&den0, (ws as usize + stride * 2) as *mut u8, BN_LIMBS)
    bn_init(&numw, (ws as usize + stride * 3) as *mut u8, BN_LIMBS)
    bn_init(&denw, (ws as usize + stride * 4) as *mut u8, BN_LIMBS)
    bn_init(&tmp, (ws as usize + stride * 5) as *mut u8, BN_LIMBS)

    var i: usize = 0
    var neg: bool = false
    if i < len {
        let c0: u8 = ld8(p, i)
        if c0 == 43 as u8 {
            i = i + 1
        } else if c0 == 45 as u8 {
            neg = true
            i = i + 1
        }
    }
    var nsig: usize = 0
    var exp: i64 = 0
    var sticky: bool = false
    var any: bool = false
    var stop: bool = false

    // --- the digits before the point ---
    while i < len && !stop {
        let c: u8 = ld8(p, i)
        if strtod_digit(c) {
            any = true
            let dig: u32 = (c - 48 as u8) as u32
            if bn_is_zero(&d) && dig == 0 as u32 {
                stop = false
            } else if nsig < D_MAXDIG {
                bn_mul_small(&d, 10 as u32)
                bn_add_small(&d, dig)
                nsig = nsig + 1
            } else {
                exp = exp + 1
                if dig != 0 as u32 {
                    sticky = true
                }
            }
            i = i + 1
        } else {
            stop = true
        }
    }

    // --- the digits after the point ---
    if i < len {
        if ld8(p, i) == 46 as u8 {
            var j: usize = i + 1
            var fany: bool = false
            stop = false
            while j < len && !stop {
                let c: u8 = ld8(p, j)
                if strtod_digit(c) {
                    fany = true
                    let dig: u32 = (c - 48 as u8) as u32
                    if bn_is_zero(&d) && dig == 0 as u32 {
                        exp = exp - 1
                    } else if nsig < D_MAXDIG {
                        bn_mul_small(&d, 10 as u32)
                        bn_add_small(&d, dig)
                        nsig = nsig + 1
                        exp = exp - 1
                    } else {
                        if dig != 0 as u32 {
                            sticky = true
                        }
                    }
                    j = j + 1
                } else {
                    stop = true
                }
            }
            if any || fany {
                any = true
                i = j
            }
        }
    }

    if !any {
        return 0
    }

    // --- exponent ---
    if i < len {
        let ec: u8 = ld8(p, i)
        if ec == 101 as u8 || ec == 69 as u8 {
            var j: usize = i + 1
            var eneg: bool = false
            if j < len {
                let sc: u8 = ld8(p, j)
                if sc == 43 as u8 {
                    j = j + 1
                } else if sc == 45 as u8 {
                    eneg = true
                    j = j + 1
                }
            }
            var eany: bool = false
            var ev: i64 = 0
            stop = false
            while j < len && !stop {
                let c: u8 = ld8(p, j)
                if strtod_digit(c) {
                    eany = true
                    if ev < 1000000 {
                        ev = ev * 10 + (c - 48 as u8) as i64
                    }
                    j = j + 1
                } else {
                    stop = true
                }
            }
            if eany {
                if eneg {
                    exp = exp - ev
                } else {
                    exp = exp + ev
                }
                i = j
            }
        }
    }
    *consumed = i

    var sign: u64 = 0
    if neg {
        sign = D_SIGN_BIT
    }

    // Digits that were cut off: a sticky bit below the last place makes sure
    // that an exact half step never turns into a wrong rounding.
    if sticky {
        bn_mul_small(&d, 10 as u32)
        bn_add_small(&d, 1 as u32)
        exp = exp - 1
    }
    if bn_is_zero(&d) {
        return sign
    }

    // Rough range: 10^(mag-1) <= |value| < 10^mag
    let likes: i64 = exp + nsig as i64
    if likes - 1 >= 309 {
        return sign + D_INF_BITS
    }
    if likes <= -400 {
        return sign
    }

    bn_copy(&num0, &d)
    bn_set_u64(&den0, 1)
    if exp > 0 {
        bn_mul_pow10(&num0, exp as usize)
    } else if exp < 0 {
        bn_mul_pow10(&den0, (0 - exp) as usize)
    }

    // Scale until the quotient has exactly 53 bit.
    var s: i64 = 53 - (bn_bitlen(&num0) as i64 - bn_bitlen(&den0) as i64)
    var q: u64 = 0
    var done: bool = false
    var iter: usize = 0
    while !done && iter < 6 {
        q = strtod_quot(&num0, &den0, &numw, &denw, &tmp, s)
        let qb: i64 = u64_bitlen(q) as i64
        if qb == 53 {
            done = true
        } else {
            s = s + (53 - qb)
        }
        iter = iter + 1
    }
    var e2: i64 = 0 - s
    if e2 < -1074 {
        s = 1074
        e2 = -1074
        q = strtod_quot(&num0, &den0, &numw, &denw, &tmp, s)
    }

    // ROUND 71: round to odd, if that is what was asked for.
    if odd {
        if !bn_is_zero(&numw) {
            q = q | 1
        }
        if e2 > 971 {
            return sign + D_INF_BITS
        }
        if q == 0 {
            return sign
        }
        if q >= D_TWO52 {
            let biased_o: u64 = (e2 + 1075) as u64
            return sign + (biased_o << 52) + (q - D_TWO52)
        }
        return sign + q
    }
    // Round: the remainder (numw) against half the denominator (denw).
    bn_shl(&numw, 1)
    let cv: i32 = bn_cmp(&numw, &denw)
    var up: bool = false
    if cv > 0 {
        up = true
    } else if cv == 0 {
        if q % 2 == 1 {
            up = true
        }
    }
    if up {
        q = q + 1
        if q == D_TWO53 {
            q = D_TWO52
            e2 = e2 + 1
        }
    }
    if e2 > 971 {
        return sign + D_INF_BITS
    }
    if q == 0 {
        return sign
    }
    var bits: u64 = 0
    if q >= D_TWO52 {
        let biased: u64 = (e2 + 1075) as u64
        bits = (biased << 52) + (q - D_TWO52)
    } else {
        bits = q
    }
    return sign + bits
}

// The two front doors: `strtod` rounds to nearest (the correctly rounded
// binary64), `strtod_odd` rounds to odd -- the intermediate value from which
// a correct binary32 comes out with ONE further rounding.
fn strtod(p: *mut u8, len: usize, ws: *mut u8, consumed: *mut usize) -> u64 {
    return strtod_mode(p, len, ws, consumed, false)
}

fn strtod_odd(p: *mut u8, len: usize, ws: *mut u8, consumed: *mut usize) -> u64 {
    return strtod_mode(p, len, ws, consumed, true)
}

// lib/num/dtoa.fi -- double -> shortest text WITH A ROUND TRIP GUARANTEE
// (SPEC 8.4, requirement Z6).
//
// Method: Dragon4 in free format (Steele/White, Burger/Dybvig) in exact big
// number arithmetic. It produces exactly as many digits as are needed to
// pin the double down uniquely -- never more, never fewer. That makes
// strtod(dtoa(x)) == x hold for EVERY finite double, and the digit sequence
// is the same one Ryu/Grisu produce.
//
// The text form follows ECMAScript `Number.prototype.toString` (section
// 6.1.6.1.20): 0.1 -> "0.1", 1e21 -> "1e+21", 5e-324 -> "5e-324".
//
// The input is the bit pattern of the double as a u64 (stage 0 has no f64
// yet, see the header of strtod.fi).
//
// Include:  //#include lib/num/dtoa.fi  (needs alloc.fi, bytes.fi, bignum.fi)

const DTOA_WS_BYTES: usize = 7 * 512 * 4

// ROUND 73: the six bit tests moved to lib/num/core_bits.fi -- the number
// reader of `lib/std/core.fi` needs them and must not drag `dtoa` (which
// writes into a Bytes) along with them.
// lib/num/core_bits.fi -- reading an IEEE-754 double off its bits
// (round 73).
//
// Sign, biased exponent, mantissa, and the three questions that follow
// from them: NaN, infinity, zero. Pure integer arithmetic on a `u64` --
// not one of these six lines touches the FPU, which is why they carry no
// `#[allow_fp]` and cost a kernel nothing.
//
// They were part of `lib/num/dtoa.fi` up to round 73. They had to move,
// because `dtoa` writes into a `*mut Bytes` (it OWNS memory) and therefore
// cannot go into `lib/std/core.fi`, while `f64_is_nan` and its kin have to
// -- and both must keep calling the SAME six lines. The names keep the
// prefix `dtoa_`: whoever searches the tree for them finds every caller
// under the name he knows.
//
// Include:  //#include lib/num/core_bits.fi

fn dtoa_sign(bits: u64) -> bool {
    return (bits >> 63) == 1
}
fn dtoa_biased_exp(bits: u64) -> u64 {
    return (bits >> 52) & 0x7FF
}
fn dtoa_frac(bits: u64) -> u64 {
    return bits & 0xFFFFFFFFFFFFF
}
fn dtoa_is_nan(bits: u64) -> bool {
    return dtoa_biased_exp(bits) == 0x7FF && dtoa_frac(bits) != 0
}
fn dtoa_is_inf(bits: u64) -> bool {
    return dtoa_biased_exp(bits) == 0x7FF && dtoa_frac(bits) == 0
}
fn dtoa_is_zero(bits: u64) -> bool {
    return (bits << 1) == 0
}

// ROUND 71 -- the same six questions for an IEEE-754 binary32. Pure integer
// arithmetic on a `u32`: sign in bit 31, eight exponent bits, 23 mantissa
// bits. No FPU is touched here either, which is why these lines cost a
// kernel nothing.
fn f32_bits_sign(bits: u32) -> bool {
    return (bits >> 31) == 1
}
fn f32_bits_exp(bits: u32) -> u32 {
    return (bits >> 23) & 255
}
fn f32_bits_frac(bits: u32) -> u32 {
    return bits & 8388607
}
fn f32_bits_is_nan(bits: u32) -> bool {
    return f32_bits_exp(bits) == 255 && f32_bits_frac(bits) != 0
}
fn f32_bits_is_inf(bits: u32) -> bool {
    return f32_bits_exp(bits) == 255 && f32_bits_frac(bits) == 0
}
fn f32_bits_is_zero(bits: u32) -> bool {
    return (bits << 1) == 0
}

// Approximation of ceil(log10(2^e * m)); the correction step catches the misses.
fn dtoa_est_k(bitlen: usize, e2: i64) -> i64 {
    let x: i64 = bitlen as i64 + e2 - 1
    // log10(2) * 2^18 = 78913
    var k: i64 = (x * 78913) >> 18
    if x > 0 {
        k = k + 1
    }
    return k
}

// The shortest digit sequence. `digits` receives ASCII digits, `k10` the
// exponent n with  value = 0.d1d2...dk * 10^n. Return value: the digit count.
// `ws` needs DTOA_WS_BYTES bytes. For finite values != 0 only.
fn dtoa_digits(bits: u64, digits: *mut u8, k10: *mut i64, ws: *mut u8) -> usize {
    var num: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var the: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var mp: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var mm: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var t1: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    var t2: Bn = Bn { d: 0 as *mut u8, n: 0, cap: 0, }
    let stride: usize = BN_LIMBS * 4
    bn_init(&num, ws, BN_LIMBS)
    bn_init(&the, (ws as usize + stride) as *mut u8, BN_LIMBS)
    bn_init(&mp, (ws as usize + stride * 2) as *mut u8, BN_LIMBS)
    bn_init(&mm, (ws as usize + stride * 3) as *mut u8, BN_LIMBS)
    bn_init(&t1, (ws as usize + stride * 4) as *mut u8, BN_LIMBS)
    bn_init(&t2, (ws as usize + stride * 5) as *mut u8, BN_LIMBS)

    let be: u64 = dtoa_biased_exp(bits)
    let mf: u64 = dtoa_frac(bits)
    var m: u64 = 0
    var e2: i64 = 0
    if be == 0 {
        m = mf
        e2 = -1074
    } else {
        m = mf + D_TWO52
        e2 = be as i64 - 1075
    }
    // The lower bound is closer when the mantissa is a power of two.
    let closer: bool = mf == 0 && be > 1
    let even: bool = m % 2 == 0

    if e2 >= 0 {
        bn_set_u64(&num, m)
        if closer {
            bn_shl(&num, (e2 + 2) as usize)
            bn_set_u64(&the, 4)
            bn_set_u64(&mp, 1)
            bn_shl(&mp, (e2 + 1) as usize)
            bn_set_u64(&mm, 1)
            bn_shl(&mm, e2 as usize)
        } else {
            bn_shl(&num, (e2 + 1) as usize)
            bn_set_u64(&the, 2)
            bn_set_u64(&mp, 1)
            bn_shl(&mp, e2 as usize)
            bn_set_u64(&mm, 1)
            bn_shl(&mm, e2 as usize)
        }
    } else {
        bn_set_u64(&num, m)
        if closer {
            bn_shl(&num, 2)
            bn_set_u64(&the, 1)
            bn_shl(&the, (2 - e2) as usize)
            bn_set_u64(&mp, 2)
            bn_set_u64(&mm, 1)
        } else {
            bn_shl(&num, 1)
            bn_set_u64(&the, 1)
            bn_shl(&the, (1 - e2) as usize)
            bn_set_u64(&mp, 1)
            bn_set_u64(&mm, 1)
        }
    }

    var k: i64 = dtoa_est_k(u64_bitlen(m), e2)
    if k >= 0 {
        bn_mul_pow10(&the, k as usize)
    } else {
        let sc: usize = (0 - k) as usize
        bn_mul_pow10(&num, sc)
        bn_mul_pow10(&mp, sc)
        bn_mul_pow10(&mm, sc)
    }

    // Correction upwards: num + mp has to stay below the denominator.
    var fixed: bool = false
    while !fixed {
        bn_copy(&t1, &num)
        bn_add(&t1, &mp)
        let c: i32 = bn_cmp(&t1, &the)
        var too_big: bool = c > 0
        if even && c == 0 {
            too_big = true
        }
        if too_big {
            bn_mul_small(&the, 10 as u32)
            k = k + 1
        } else {
            fixed = true
        }
    }
    // Correction downwards: the leading digit must not be 0.
    fixed = false
    while !fixed {
        bn_copy(&t1, &num)
        bn_add(&t1, &mp)
        bn_mul_small(&t1, 10 as u32)
        let c: i32 = bn_cmp(&t1, &the)
        var too_small: bool = c < 0
        if even && c == 0 {
            too_small = true
        }
        if too_small {
            bn_mul_small(&num, 10 as u32)
            bn_mul_small(&mp, 10 as u32)
            bn_mul_small(&mm, 10 as u32)
            k = k - 1
        } else {
            fixed = true
        }
    }
    // Produce digits until the value is pinned down uniquely.
    var n: usize = 0
    var run: bool = true
    while run {
        bn_mul_small(&num, 10 as u32)
        bn_mul_small(&mp, 10 as u32)
        bn_mul_small(&mm, 10 as u32)
        var dg: u32 = bn_div_digit(&num, &the)

        let cl: i32 = bn_cmp(&num, &mm)
        var low: bool = cl < 0
        if even && cl == 0 {
            low = true
        }
        bn_copy(&t2, &num)
        bn_add(&t2, &mp)
        let ch: i32 = bn_cmp(&t2, &the)
        var high: bool = ch > 0
        if even && ch == 0 {
            high = true
        }

        if !low && !high {
            st8(digits, n, (48 as u32 + dg) as u8)
            n = n + 1
        } else {
            var on: bool = false
            if low && high {
                // Both bounds allow a digit: the one closer to the value
                // wins. At EXACTLY equal distance ECMAScript
                // (6.1.6.1.20, item 5) takes the larger one -- hence
                // `>=` and not `>`.
                bn_copy(&t2, &num)
                bn_shl(&t2, 1)
                if bn_cmp(&t2, &the) >= 0 {
                    on = true
                }
            } else if high {
                on = true
            }
            if on {
                dg = dg + 1 as u32
            }
            st8(digits, n, (48 as u32 + dg) as u8)
            n = n + 1
            run = false
        }
        if n >= 20 {
            run = false
        }
    }

    // Carry: the rounded up digit can become 10 (classically at 1e23).
    // It then carries forward; if every digit overflows, the result is a
    // plain power of ten.
    var pos: usize = n
    var carry: bool = true
    while carry && pos > 0 {
        pos = pos - 1
        if ld8(digits, pos) > 57 as u8 {
            st8(digits, pos, 48 as u8)
            if pos > 0 {
                st8(digits, pos - 1, ld8(digits, pos - 1) + 1 as u8)
            }
        } else {
            carry = false
        }
    }
    if carry {
        st8(digits, 0, 49 as u8)
        n = 1
        k = k + 1
    }
    // trailing zeros are not part of the shortest representation
    while n > 1 && ld8(digits, n - 1) == 48 as u8 {
        n = n - 1
    }
    *k10 = k
    return n
}

fn dtoa_push_digits(out: *mut Bytes, digits: *mut u8, of: usize, to: usize) {
    var i: usize = of
    while i < to {
        bytes_push(out, ld8(digits, i))
        i = i + 1
    }
}

fn dtoa_push_zeros(out: *mut Bytes, n: i64) {
    var i: i64 = 0
    while i < n {
        bytes_push(out, 48 as u8)
        i = i + 1
    }
}

fn dtoa_push_int(out: *mut Bytes, v: i64) {
    var x: u64 = v as u64
    if v < 0 {
        bytes_push(out, 45 as u8)
        x = (0 - v) as u64
    }
    var buf: [u8; 24] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    var n: usize = 0
    if x == 0 {
        buf[0] = 48 as u8
        n = 1
    }
    while x > 0 {
        buf[n] = (48 + x % 10) as u8
        x = x / 10
        n = n + 1
    }
    while n > 0 {
        n = n - 1
        bytes_push(out, buf[n])
    }
}

// The complete text output following the ECMAScript rules.
fn dtoa(bits: u64, out: *mut Bytes, ws: *mut u8) {
    bytes_clear(out)
    if dtoa_is_nan(bits) {
        bytes_push(out, 78 as u8) // N
        bytes_push(out, 97 as u8) // a
        bytes_push(out, 78 as u8) // N
        return
    }
    if dtoa_sign(bits) && !dtoa_is_zero(bits) {
        bytes_push(out, 45 as u8) // -
    }
    if dtoa_is_inf(bits) {
        bytes_push(out, 73 as u8) // I
        bytes_push(out, 110 as u8)
        bytes_push(out, 102 as u8)
        bytes_push(out, 105 as u8)
        bytes_push(out, 110 as u8)
        bytes_push(out, 105 as u8)
        bytes_push(out, 116 as u8)
        bytes_push(out, 121 as u8)
        return
    }
    if dtoa_is_zero(bits) {
        bytes_push(out, 48 as u8) // ECMAScript: even -0 becomes "0"
        return
    }
    var digits: [u8; 32] = [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
        0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8]
    var n10: i64 = 0
    let k: usize = dtoa_digits(bits, &digits[0], &n10, ws)
    dtoa_write(out, &digits[0], k, n10)
}

// ROUND 71 -- the text output following the ECMAScript rules, for a digit
// string that somebody else produced.
//
// It stood inside `dtoa` up to round 71 and had to come out: `ftoa32`
// (lib/num/f32_text.fi) shortens the digits of the widened double until the
// text reads back as the SAME binary32, and then it wants exactly this
// formatting -- one set of rules for both widths, not two that drift apart.
fn dtoa_write(out: *mut Bytes, digits: *mut u8, k: usize, n10: i64) {
    let ki: i64 = k as i64
    if ki <= n10 && n10 <= 21 {
        dtoa_push_digits(out, digits, 0, k)
        dtoa_push_zeros(out, n10 - ki)
    } else if 0 < n10 && n10 <= 21 {
        dtoa_push_digits(out, digits, 0, n10 as usize)
        bytes_push(out, 46 as u8)
        dtoa_push_digits(out, digits, n10 as usize, k)
    } else if -6 < n10 && n10 <= 0 {
        bytes_push(out, 48 as u8)
        bytes_push(out, 46 as u8)
        dtoa_push_zeros(out, 0 - n10)
        dtoa_push_digits(out, digits, 0, k)
    } else {
        dtoa_push_digits(out, digits, 0, 1)
        if k > 1 {
            bytes_push(out, 46 as u8)
            dtoa_push_digits(out, digits, 1, k)
        }
        bytes_push(out, 101 as u8) // e
        if n10 - 1 >= 0 {
            bytes_push(out, 43 as u8)
        }
        dtoa_push_int(out, n10 - 1)
    }
}

const CHUNK: usize = 8192

fn read_block(buf: *mut u8, n: usize) -> usize {
    var got: usize = 0
    var next: bool = true
    while got < n && next {
        let r: i64 = syscall(SYS_READ, 0, (buf as usize + got) as i64, (n - got) as i64)
        if r <= 0 {
            next = false
        } else {
            got = got + r as usize
        }
    }
    return got
}

fn main() -> i32 {
    let ws: *mut u8 = heap_alloc(DTOA_WS_BYTES)
    let buf: *mut u8 = heap_alloc(CHUNK)
    var out: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0, }
    var line: Bytes = Bytes { ptr: 0 as *mut u8, len: 0, cap: 0, }
    bytes_init(&out)
    bytes_init(&line)
    var total: u64 = 0
    var bad: u64 = 0
    var next: bool = true
    while next {
        let got: usize = read_block(buf, CHUNK)
        let cnt: usize = got / 8
        if cnt == 0 {
            next = false
        }
        var i: usize = 0
        while i < cnt {
            let bits: u64 = ld64(buf, i)
            dtoa(bits, &out, ws)
            var used: usize = 0
            let back: u64 = strtod(out.ptr, out.len, ws, &used)
            if back != bits || used != out.len {
                bad = bad + 1
            }
            total = total + 1
            bytes_clear(&line)
            bytes_append(&line, out.ptr, out.len)
            bytes_push(&line, 10 as u8)
            print_bytes_raw(&line)
            i = i + 1
        }
        if got < CHUNK {
            next = false
        }
    }
    // Summary on fd 2 (the standard output stays pure text)
    bytes_clear(&line)
    dtoa_push_int(&line, total as i64)
    bytes_push(&line, 32 as u8)
    dtoa_push_int(&line, bad as i64)
    bytes_push(&line, 10 as u8)
    write_all(2, line.ptr, line.len)
    if bad == 0 {
        return 0
    }
    return 1
}
