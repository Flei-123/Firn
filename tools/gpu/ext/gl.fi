// tools/gpu/ext/gl.fi -- lib/gpu building blocks on a real context (Mesa llvmpipe here; nothing proven on a real GPU):
// probe, program + uniform cache + ivec2 uniform + UBO, instancing vs single draws (image equal + time), multi-indirect,
// timer queries, textures (mips, aniso, atlas bleed vs array), MRT / depth texture / MSAA resolve / resize.
import std.rt
import std.io
import std.time
import gpu.glctx
import gpu.gl33
import gpu.gl_ext
import gpu.gl_prog
import gpu.gl_tex
import gpu.gl_fbo
import gpu.gl_query

const VS: str = "#version 330 core\nuniform int u_inst;\nout vec2 v_uv;\nvoid main() {\n int i = u_inst >= 0 ? u_inst : gl_InstanceID;\n vec2 c = vec2(float(gl_VertexID & 1), float((gl_VertexID >> 1) & 1));\n vec2 p = (vec2(float(i % 16), float(i / 16)) + 0.1 + 0.8 * c) / 16.0 * 2.0 - 1.0;\n v_uv = c;\n gl_Position = vec4(p, 0.5, 1.0);\n}\n"
const FS: str = "#version 330 core\nuniform ivec2 u_c;\nlayout(std140) uniform Col { vec4 c; };\nlayout(location = 0) out vec4 o0;\nlayout(location = 1) out vec4 o1;\nvoid main() {\n o0 = vec4(float(u_c.x) / 255.0, float(u_c.y) / 255.0, c.b, 1.0);\n o1 = vec4(1.0, 0.0, 0.0, 1.0);\n}\n"

fn px(buf: u64, w: i32, x: i32, y: i32, ch: usize) -> i32 {
    return rt.ld8(buf, (((y * w + x) as usize) * 4) + ch) as i32
}

fn check(ok: bool, what: str, fails: *mut i32) {
    if ok { io.fmt_print(f"   ok:   {what}\n") } else { io.fmt_print(f"   FAIL: {what}\n"); *fails = *fails + 1 }
}

#[allow_escape]
fn main() -> i32 {
    var fails: i32 = 0
    var c: glctx.GlCtx = glctx.ctx_open(0, 0)
    if !c.ok { io.print("SKIP: no context\n"); return 0 }
    var x: gl_ext.GlX = gl_ext.glx_new()
    if !gl_ext.glx_load(&c, &x) { io.print("FAIL: load\n"); return 1 }
    io.fmt_print(f"gl={x.major}.{x.minor} ubo={x.has_ubo} ssbo={x.has_ssbo} indirect={x.has_indirect}/{x.has_multi_indirect} timer={x.has_timer} msaa={x.has_msaa}/{x.max_samples} aniso={x.has_aniso}/{x.max_aniso_x100} (llvmpipe only)\n")
    let W: i32 = 128
    var pxb: u64 = rt.heap_alloc((W * W * 4) as usize)
    var pxb2: u64 = rt.heap_alloc((W * W * 4) as usize)
    // ---- program, uniforms, UBO
    var p: gl_prog.Prog = gl_prog.prog_new()
    check(gl_prog.prog_build(&x, &p, VS.p as u64, VS.n, FS.p as u64, FS.n), "program builds", &fails)
    var bad: gl_prog.Prog = gl_prog.prog_new()
    let badfs: str = "#version 330 core\nvoid main() { gl_FragColor = 1; }\n"
    check(!gl_prog.prog_build(&x, &bad, VS.p as u64, VS.n, badfs.p as u64, badfs.n) && bad.log[0] != (0 as u8), "broken fragment shader fails with a log", &fails)
    var col: [f32; 4] = [0.0, 0.0, 0.5, 1.0]
    let blk: u32 = gl_ext.glx_block_index(&x, p.id, "Col")
    gl_ext.glx_block_binding(&x, p.id, blk, 3 as u32)
    let ubo: u32 = gl_ext.glx_ubo_new(&x, 16, (&col[0]) as u64, 3 as u32)
    check(blk != 0xFFFFFFFF as u32 && ubo != 0 as u32 && gl_ext.glx_block_size(&x, p.id, blk) == 16, "uniform block found, size 16, buffer bound", &fails)
    gl_prog.u_2i(&x, &p, "u_c", 200, 100)
    gl_prog.u_1i(&x, &p, "u_inst", 0 - 1)
    var chk: [i32; 2] = [0; 2]
    gl_ext.glx_get_ui(&x, p.id, gl_prog.prog_loc(&x, &p, "u_c"), (&chk[0]) as u64)
    check(chk[0] == 200 && chk[1] == 100 && p.cache_hits >= 1, "glUniform2i round trip + cache hit", &fails)
    // ---- MRT target with depth texture
    var t: gl_fbo.Target = gl_fbo.target_new(&x, W, W, 2, gl_fbo.DEPTH_TEXTURE, 0)
    check(t.ok, "target 2 colour + depth texture complete", &fails)
    let vao: u32 = gl33.gl_gen_vao(&x.g)
    gl33.gl_bind_vao(&x.g, vao)
    var idx: [u32; 6] = [0 as u32, 1 as u32, 2 as u32, 2 as u32, 1 as u32, 3 as u32]
    let ibo: u32 = gl33.gl_gen_buffer(&x.g)
    gl33.gl_bind_buffer(&x.g, gl33.GL_ELEMENT_ARRAY_BUFFER, ibo)
    gl33.gl_buffer_data(&x.g, gl33.GL_ELEMENT_ARRAY_BUFFER, (&idx[0]) as u64, 24, gl33.GL_STATIC_DRAW)
    var tm: gl_query.Timer = gl_query.timer_new(&x, gl_query.MODE_STAMP)
    var t_inst: u64 = 0
    var t_single: u64 = 0
    var f: i32 = 0
    while f < 6 {
        gl_query.timer_frame(&x, &tm)
        gl_fbo.target_bind(&x, &t)
        gl33.gl_clear_color(&x.g, 0.0, 0.0, 0.0, 1.0)
        gl33.gl_clear(&x.g, gl33.GL_COLOR_BUFFER_BIT | gl33.GL_DEPTH_BUFFER_BIT)
        gl_prog.prog_use(&x, &p)
        gl_prog.u_1i(&x, &p, "u_inst", 0 - 1)
        let a0: u64 = time.monotonic_ns()
        gl_query.pass_begin(&x, &tm, 0)
        gl_ext.glx_draw_elements_instanced(&x, gl33.GL_TRIANGLES, 6, gl33.GL_UNSIGNED_INT, 0, 256)
        gl_query.pass_end(&x, &tm, 0)
        gl33.gl_finish(&x.g)
        t_inst = time.monotonic_ns() - a0
        if f == 5 { gl_fbo.target_read_color(&x, &t, 0, pxb) }
        gl_fbo.target_bind(&x, &t)
        gl33.gl_clear(&x.g, gl33.GL_COLOR_BUFFER_BIT | gl33.GL_DEPTH_BUFFER_BIT)
        let b0: u64 = time.monotonic_ns()
        gl_query.pass_begin(&x, &tm, 1)
        var i: i32 = 0
        while i < 256 {
            gl_prog.u_1i(&x, &p, "u_inst", i)
            gl33.gl_draw_elements(&x.g, gl33.GL_TRIANGLES, 6, gl33.GL_UNSIGNED_INT, 0)
            i = i + 1
        }
        gl_query.pass_end(&x, &tm, 1)
        gl33.gl_finish(&x.g)
        t_single = time.monotonic_ns() - b0
        f = f + 1
    }
    gl_fbo.target_read_color(&x, &t, 0, pxb2)
    var same: bool = true
    var i2: usize = 0
    while i2 < ((W * W * 4) as usize) {
        if rt.ld8(pxb, i2) != rt.ld8(pxb2, i2) { same = false }
        i2 = i2 + 1
    }
    check(px(pxb, W, 4, 4, 0) == 200 && px(pxb, W, 4, 4, 1) == 100 && px(pxb, W, 4, 4, 2) >= 127 && px(pxb, W, 4, 4, 2) <= 128, "pixel = (u_c.x, u_c.y, UBO.b)", &fails)
    check(px(pxb, W, 0, 0, 0) == 0, "gap between quads stays clear", &fails)
    check(same, "instanced image == 256 single draws (byte equal)", &fails)
    io.fmt_print(f"metric instancing 256 quads: instanced {t_inst / 1000} us vs 256 single draws {t_single / 1000} us (llvmpipe, last frame, wall time incl. glFinish)\n")
    gl_query.timer_frame(&x, &tm)
    gl33.gl_finish(&x.g)
    gl_query.timer_frame(&x, &tm)
    gl_query.pass_print(&tm, 0, "pass 0 (instanced)")
    gl_query.pass_print(&tm, 1, "pass 1 (single draws)")
    check(gl_query.pass_samples(&tm, 0) > (0 as u32) && gl_query.pass_ms(&tm, 0) > 0.0 && gl_query.pass_ms(&tm, 1) > 0.0, "timer queries returned values > 0 for both passes", &fails)
    var dep: [f32; 1] = [0.0]
    var dbuf: u64 = rt.heap_alloc((W * W * 4) as usize)
    check(gl_fbo.target_read_depth(&x, &t, dbuf), "depth texture readable", &fails)
    rt.heap_free(dbuf, (W * W * 4) as usize)
    // second colour attachment
    gl_fbo.target_read_color(&x, &t, 1, pxb2)
    check(px(pxb2, W, 4, 4, 0) == 255 && px(pxb2, W, 4, 4, 1) == 0, "MRT: second attachment holds (1,0,0,1)", &fails)
    check(gl_fbo.target_resize(&x, &t, 64, 64) && t.w == 64, "target resize rebuilds", &fails)
    // ---- multi indirect
    if gl_ext.glx_multi_indirect_ok(&x) {
        var cmds: [u32; 10] = [0 as u32; 10]
        gl_ext.glx_cmd_write((&cmds[0]) as u64, 0, 6 as u32, 3 as u32, 0 as u32, 0 as u32, 0 as u32)
        gl_ext.glx_cmd_write((&cmds[0]) as u64, 1, 6 as u32, 2 as u32, 0 as u32, 0 as u32, 3 as u32)
        let ib: u32 = gl33.gl_gen_buffer(&x.g)
        gl_ext.glx_indirect_buffer(&x, ib)
        gl33.gl_buffer_data(&x.g, gl_ext.GL_DRAW_INDIRECT_BUFFER, (&cmds[0]) as u64, 40, gl33.GL_STATIC_DRAW)
        gl_fbo.target_bind(&x, &t)
        gl33.gl_clear(&x.g, gl33.GL_COLOR_BUFFER_BIT)
        gl_prog.u_1i(&x, &p, "u_inst", 0 - 1)
        check(gl_ext.glx_multi_draw_elements_indirect(&x, gl33.GL_TRIANGLES, gl33.GL_UNSIGNED_INT, 0, 2, 0), "glMultiDrawElementsIndirect issued", &fails)
        gl33.gl_finish(&x.g)
        gl_fbo.target_read_color(&x, &t, 0, pxb)
        check(px(pxb, 64, 8, 2, 0) == 200 && px(pxb, 64, 8, 2, 1) == 100, "indirect instances 3..4 drawn (base instance via gl_InstanceID only differs on GL 4.2+)", &fails)
    } else {
        io.print("   compiled only: glMultiDrawElementsIndirect (context < 4.3)\n")
    }
    // ---- textures: mips, aniso, atlas bleed vs array
    var tex: [u8; 1024] = [0 as u8; 1024] // 16 x 16 RGBA: left half 0, right half 255 (alpha 255)
    var ty: usize = 0
    while ty < 16 {
        var tx: usize = 0
        while tx < 16 {
            var v: u8 = 0 as u8
            if tx >= 8 { v = 255 as u8 }
            tex[(ty * 16 + tx) * 4] = v
            tex[(ty * 16 + tx) * 4 + 3] = 255 as u8
            tx = tx + 1
        }
        ty = ty + 1
    }
    let tid: u32 = gl_tex.tex2d_new(&x, 16, 16, (&tex[0]) as u64, true)
    var lv: [u8; 1024] = [0 as u8; 1024]
    gl_tex.tex_get_level(&x, gl_tex.GL_TEXTURE_2D, tid, 2, (&lv[0]) as u64)
    let m2: f64 = gl_tex.px_mean((&lv[0]) as u64, 16, 0)
    gl_tex.tex_get_level(&x, gl_tex.GL_TEXTURE_2D, tid, 4, (&lv[0]) as u64)
    let m4: f64 = gl_tex.px_mean((&lv[0]) as u64, 1, 0)
    io.fmt_print(f"mips: levels={gl_tex.tex_levels(16, 16)} level2 mean R={m2} (expect 127.5) level4 R={m4} (127..128)\n")
    check(gl_tex.tex_levels(16, 16) == 5 && m2 > 126.0 && m2 < 129.0 && m4 >= 127.0 && m4 <= 128.0, "mip chain means of a half-black/half-white texture", &fails)
    if x.has_aniso {
        let okA: bool = gl_tex.tex_aniso(&x, gl_tex.GL_TEXTURE_2D, tid, 800)
        check(okA && gl_tex.tex_get_aniso_x100(&x, gl_tex.GL_TEXTURE_2D, tid) == 800, "anisotropy 8x set and read back", &fails)
    } else {
        io.print("   no anisotropic filtering in this context\n")
    }
    check(gl_tex.atlas_max_level(16) == 4 && gl_tex.atlas_max_level(1) == 0, "atlas_max_level", &fails)
    // atlas 2x2 tiles of 8 px: tile 0 red, tile 1 green, 2 blue, 3 white -> array layer means
    var at: [u8; 1024] = [0 as u8; 1024]
    var yy: usize = 0
    while yy < 16 {
        var xx: usize = 0
        while xx < 16 {
            let tidx: usize = (yy / 8) * 2 + (xx / 8)
            var r: u8 = 0 as u8
            var g: u8 = 0 as u8
            var b: u8 = 0 as u8
            if tidx == 0 || tidx == 3 { r = 255 as u8 }
            if tidx == 1 || tidx == 3 { g = 255 as u8 }
            if tidx == 2 || tidx == 3 { b = 255 as u8 }
            at[(yy * 16 + xx) * 4] = r
            at[(yy * 16 + xx) * 4 + 1] = g
            at[(yy * 16 + xx) * 4 + 2] = b
            at[(yy * 16 + xx) * 4 + 3] = 255 as u8
            xx = xx + 1
        }
        yy = yy + 1
    }
    let arr: u32 = gl_tex.tex_array_from_atlas(&x, 16, 16, (&at[0]) as u64, 8, true)
    var l1: [u8; 1024] = [0 as u8; 1024]
    gl_tex.tex_get_level(&x, gl_tex.GL_TEXTURE_2D_ARRAY, arr, 3, (&l1[0]) as u64) // 1x1 per layer: layer 0..3 at offsets 0,4,8,12
    check(arr != 0 as u32 && l1[0] == (255 as u8) && l1[1] == (0 as u8) && l1[5] == (255 as u8) && l1[4] == (0 as u8) && l1[10] == (255 as u8), "array from atlas: lowest level of every layer is its own tile colour (no bleed)", &fails)
    let atl: u32 = gl_tex.tex2d_new(&x, 16, 16, (&at[0]) as u64, true)
    gl_tex.tex_get_level(&x, gl_tex.GL_TEXTURE_2D, atl, 4, (&l1[0]) as u64)
    io.fmt_print(f"atlas with a full chain, level 4 (1 texel for all tiles): RGB = {l1[0]} {l1[1]} {l1[2]} (mixed = bleed; max_level {gl_tex.atlas_max_level(8)} keeps tiles apart)\n")
    check(l1[0] != (255 as u8) || l1[1] != (0 as u8), "atlas chain mixes tiles below the tile level (documented bleed source)", &fails)
    // ---- MSAA resolve
    if x.has_msaa {
        var ms: gl_fbo.Target = gl_fbo.target_new(&x, 32, 32, 1, gl_fbo.DEPTH_RENDERBUFFER, 4)
        check(ms.ok && ms.samples > 0, "MSAA target complete", &fails)
        gl_fbo.target_bind(&x, &ms)
        gl33.gl_clear_color(&x.g, 0.0, 0.0, 0.0, 1.0)
        gl33.gl_clear(&x.g, gl33.GL_COLOR_BUFFER_BIT)
        gl_prog.u_2i(&x, &p, "u_c", 255, 255)
        gl_prog.u_1i(&x, &p, "u_inst", 135)
        gl33.gl_bind_vao(&x.g, vao)
        gl33.gl_draw_elements(&x.g, gl33.GL_TRIANGLES, 3, gl33.GL_UNSIGNED_INT, 0) // one triangle: its diagonal edge is anti-aliased
        gl_fbo.target_resolve(&x, &ms)
        gl_fbo.target_read_color(&x, &ms, 0, pxb)
        var mid: i32 = 0
        var q: i32 = 0
        while q < 32 * 32 {
            let v: i32 = rt.ld8(pxb, (q as usize) * 4) as i32
            if v > 0 && v < 255 { mid = mid + 1 }
            q = q + 1
        }
        io.fmt_print(f"msaa: {ms.samples} samples, edge pixels with partial coverage = {mid}\n")
        check(mid > 0, "MSAA resolve produces anti-aliased edge pixels", &fails)
        gl_fbo.target_free(&x, &ms)
    }
    check(gl33.gl_get_error(&x.g) == 0 as u32, "no GL error left", &fails)
    glctx.ctx_close(&c)
    if fails == 0 { io.print("gl ext: all checks ok\n") }
    return fails
}
