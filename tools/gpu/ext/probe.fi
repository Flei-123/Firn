import std.rt
import std.io
import gpu.glctx
import gpu.gl_ext
fn main() -> i32 {
    var c: glctx.GlCtx = glctx.ctx_open(0, 0)
    if !c.ok { return 10 }
    var x: gl_ext.GlX = gl_ext.glx_new()
    if !gl_ext.glx_load(&c, &x) { return 11 }
    io.fmt_print(f"gl={x.major}.{x.minor} missing={x.missing} n_ext={x.n_ext} aniso={x.has_aniso}/{x.max_aniso_x100} ubo={x.has_ubo} ssbo={x.has_ssbo} ind={x.has_indirect} mind={x.has_multi_indirect} timer={x.has_timer} msaa={x.has_msaa}/{x.max_samples} arr={x.has_tex_array} layers={x.max_layers} att={x.max_color_att} db={x.max_draw_buf}\n")
    glctx.ctx_close(&c)
    return 0
}
