// SPDX-License-Identifier: MPL-2.0
// tools/gpu/web/web_main.fi -- THE WEBGL2 BACK END IN THE BROWSER (docs/WEBGL2.md, gate 131).
// Built with `firnc --target=wasm32-browser`; demos/mcweb/glweb.js is the host. mc_raster (the reference) and
// gpu.glweb (WebGL2) run in the SAME module on the SAME scenes through the SAME mc_backend.Backend calls; per scene the
// frames are compared (coverage mismatch, PSNR, thresholds of tools/gpu/dump.fi) and one line is printed. After every
// scene the WebGL2 frame is blitted onto the canvas (glweb_show), the host takes a snapshot of it for tools/gpu/web/check.py.
// Exit 0 = every scene above its threshold, 3 = a threshold failed, 4 = no WebGL2.
import std.rt
import std.io
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_backend
import gpu.glweb
import webscene

fn main(start: u64) -> i32 {
    var gw: glweb.GlWeb = glweb.glweb_open(webscene.W, webscene.H)
    if !gw.ok {
        io.fmt_print(f"no WebGL2: step={gw.step}\n")
        io.print_c((&gw.log[0]) as u64)
        io.new_line()
        return 4
    }
    var r: mc_raster.Raster = mc_raster.raster_new(webscene.W, webscene.H)
    var bc: mc_backend.Backend = mc_backend.backend_cpu(&r)
    var bg: mc_backend.Backend = glweb.glweb_backend(&gw)
    var wd: webscene.World = webscene.world_new()
    var cam: mc_camera.Camera = mc_camera.camera_new(webscene.W, webscene.H)
    var sc: webscene.Sc = webscene.Sc { atlas: 0, verts: 0, nv: 0, idx: 0, ni: 0, nx: 1, nz: 1, ox: 0.0, oy: 0.0, oz: 0.0,
        fog: false, min_psnr_x100: 0 as u64 }
    var cur: i32 = 0 - 1
    var fails: i32 = 0
    var i: usize = 0
    while i < webscene.NSCENES {
        webscene.scene_setup(&wd, i, &cam, &sc)
        if sc.atlas != cur {
            cur = sc.atlas
            if cur == 0 {
                bc.upload_atlas(bc.obj, (&wd.ta) as u64)
                bg.upload_atlas(bg.obj, (&wd.ta) as u64)
            } else {
                bc.upload_atlas(bc.obj, (&wd.da) as u64)
                bg.upload_atlas(bg.obj, (&wd.da) as u64)
            }
        }
        mc_raster.raster_set_fog(&r, sc.fog, 20.0, 90.0, 150 as u32, 190 as u32, 230 as u32)
        glweb.glweb_set_fog(&gw, sc.fog, 20.0, 90.0, 150 as u32, 190 as u32, 230 as u32)
        let hc: usize = bc.mesh_upload(bc.obj, 1, sc.verts, sc.nv, sc.idx, sc.ni)
        let hg: usize = bg.mesh_upload(bg.obj, 1, sc.verts, sc.nv, sc.idx, sc.ni)
        let tc: u64 = webscene.frame(&bc, &cam, webscene.CLEAR, hc, sc.nx, sc.nz, sc.ox, sc.oy, sc.oz)
        let tg: u64 = webscene.frame(&bg, &cam, webscene.CLEAR, hg, sc.nx, sc.nz, sc.ox, sc.oy, sc.oz)
        glweb.glweb_show(&gw)
        let pc: u64 = bc.present(bc.obj)
        let pg: u64 = bg.present(bg.obj)
        var c: webscene.Cmp = webscene.Cmp { npx: 0 as u64, diff_px: 0 as u64, big_px: 0 as u64, max_diff: 0 as u32,
            cov_cpu: 0 as u64, cov_gpu: 0 as u64, cov_mm: 0 as u64, psnr_x100: 0 as u64 }
        let n: usize = (webscene.W as usize) * (webscene.H as usize)
        webscene.compare(pc, pg, n, webscene.CLEAR, &c)
        bc.mesh_free(bc.obj, hc)
        bg.mesh_free(bg.obj, hg)
        let mm: u64 = c.cov_mm * 1000 as u64 / c.npx
        var ok: bool = c.cov_cpu > 0 as u64 && c.cov_gpu > 0 as u64 && tc == tg && glweb.glweb_error(&gw) == 0
        if c.psnr_x100 < sc.min_psnr_x100 { ok = false }
        if mm > 5 as u64 { ok = false }
        io.print("scene ")
        io.print(webscene.scene_name(i))
        io.fmt_print(f" tris={tg} cov_cpu={c.cov_cpu} cov_gpu={c.cov_gpu} cov_mismatch={c.cov_mm} ({mm} permille) diff_px={c.diff_px} big_px={c.big_px} max_diff={c.max_diff} psnr=")
        webscene.print_f2((c.psnr_x100 as f64) / 100.0)
        io.print(" min_psnr=")
        webscene.print_f2((sc.min_psnr_x100 as f64) / 100.0)
        if ok {
            io.print(" ok\n")
        } else {
            io.print(" FAIL\n")
            fails = fails + 1
        }
        i = i + 1
    }
    glweb.glweb_close(&gw)
    io.fmt_print(f"scenes done, failed={fails}\n")
    if fails > 0 { return 3 }
    return 0
}
