// SPDX-License-Identifier: MPL-2.0
// tools/gpu/web/hills_native.fi -- r106: NATIVE reference of the browser hills demo. Same scene (webscene.fi), same navigation
// (hills.fi, key script hills.script_keys), CPU back end (mc_raster). Writes the frames hills.snap_frame(i) as raw RGBA to
// <outdir>/hills_<frame>.cpu.rgba; tools/mc/web/check.py compares them with the canvas snapshots of the browser.
// usage: hills_native <outdir>
import std.rt
import std.io
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_backend
import webscene
import hills

fn write_raw(dir: u64, dirn: usize, frame: u32, px: u64, n: usize) {
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, dirn)
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, "hills_".p as u64, 6)
    var d: u32 = frame
    var digits: [u8; 4] = [48 as u8; 4]
    var k: usize = 4
    while k > 0 {
        k = k - 1
        digits[k] = (48 as u32 + d % 10 as u32) as u8
        d = d / 10 as u32
    }
    rt.buf_push_bytes(&path, (&digits[0]) as u64, 4)
    rt.buf_push_bytes(&path, ".cpu.rgba".p as u64, 9)
    rt.buf_push(&path, 0 as u8)
    rt.write_file(rt.buf_ptr(&path), px, n * 4)
    rt.buf_free(&path)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        io.print("usage: hills_native <outdir>\n")
        return 2
    }
    let dir: u64 = rt.arg_ptr(start, 1)
    var dirn: usize = 0
    while rt.ld8(dir, dirn) != 0 as u8 { dirn = dirn + 1 }
    var r: mc_raster.Raster = mc_raster.raster_new(webscene.W, webscene.H)
    var bc: mc_backend.Backend = mc_backend.backend_cpu(&r)
    var wd: webscene.World = webscene.world_new()
    var cam: mc_camera.Camera = mc_camera.camera_new(webscene.W, webscene.H)
    var nav: hills.Nav = hills.nav_new()
    mc_raster.raster_set_fog(&r, false, 20.0, 90.0, 150 as u32, 190 as u32, 230 as u32)
    bc.upload_atlas(bc.obj, (&wd.da) as u64)
    let h: usize = bc.mesh_upload(bc.obj, 1, wd.m.verts, wd.m.nverts as usize, wd.m.idx, wd.m.nidx as usize)
    let n: usize = (webscene.W as usize) * (webscene.H as usize)
    var f: u32 = 0 as u32
    while f < hills.FRAMES {
        let keys: u32 = hills.script_keys(f)
        hills.nav_step(&nav, keys, 0.5, 0.0)
        hills.nav_apply(&nav, &cam)
        let tris: u64 = webscene.frame(&bc, &cam, webscene.CLEAR, h, 2, 2, 0.0, 0.0, 0.0)
        let px: u64 = bc.present(bc.obj)
        var s: usize = 0
        while s < hills.SNAP_N {
            if hills.snap_frame(s) == f {
                write_raw(dir, dirn, f, px, n)
                io.fmt_print(f"native hills snap {f} tris={tris} keys={keys}\n")
            }
            s = s + 1
        }
        f = f + 1 as u32
    }
    return 0
}
