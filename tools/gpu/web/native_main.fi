// SPDX-License-Identifier: MPL-2.0
// tools/gpu/web/native_main.fi -- the NATIVE reference of the WebGL2 gate: the same scenes as web_main.fi through the CPU
// rasterizer (lib/mc/mc_raster.fi) only, written as raw RGBA (row 0 = top) to <outdir>/<scene>.cpu.rgba.
// tools/gpu/web/check.py compares these files with the snapshots the browser took of its canvas.
//   usage: native_main <outdir>
import std.rt
import std.io
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_backend
import webscene

fn write_raw(dir: u64, dirn: usize, name: str, px: u64, n: usize) {
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, dirn)
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push_bytes(&path, ".cpu.rgba".p as u64, 9)
    rt.buf_push(&path, 0 as u8)
    rt.write_file(rt.buf_ptr(&path), px, n * 4)
    rt.buf_free(&path)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        io.print("usage: native_main <outdir>\n")
        return 2
    }
    let dir: u64 = rt.arg_ptr(start, 1)
    var dirn: usize = 0
    while rt.ld8(dir, dirn) != 0 as u8 { dirn = dirn + 1 }
    var r: mc_raster.Raster = mc_raster.raster_new(webscene.W, webscene.H)
    var bc: mc_backend.Backend = mc_backend.backend_cpu(&r)
    var wd: webscene.World = webscene.world_new()
    var cam: mc_camera.Camera = mc_camera.camera_new(webscene.W, webscene.H)
    var sc: webscene.Sc = webscene.Sc { atlas: 0, verts: 0, nv: 0, idx: 0, ni: 0, nx: 1, nz: 1, ox: 0.0, oy: 0.0, oz: 0.0,
        fog: false, fade_a: 64, fade_inv: 0, min_psnr_x100: 0 as u64 }
    var cur: i32 = 0 - 1
    var i: usize = 0
    while i < webscene.NSCENES {
        webscene.scene_setup(&wd, i, &cam, &sc)
        if sc.atlas != cur {
            cur = sc.atlas
            if cur == 0 {
                bc.upload_atlas(bc.obj, (&wd.ta) as u64)
            } else {
                bc.upload_atlas(bc.obj, (&wd.da) as u64)
            }
        }
        mc_raster.raster_set_fog(&r, sc.fog, 20.0, 90.0, 150 as u32, 190 as u32, 230 as u32)
        let hc: usize = bc.mesh_upload(bc.obj, 1, sc.verts, sc.nv, sc.idx, sc.ni)
        let tc: u64 = webscene.frame_f(&bc, &cam, webscene.CLEAR, hc, sc.nx, sc.nz, sc.ox, sc.oy, sc.oz, sc.fade_a, sc.fade_inv)
        let pc: u64 = bc.present(bc.obj)
        write_raw(dir, dirn, webscene.scene_name(i), pc, (webscene.W as usize) * (webscene.H as usize))
        bc.mesh_free(bc.obj, hc)
        io.print("native ")
        io.print(webscene.scene_name(i))
        io.fmt_print(f" tris={tc}\n")
        i = i + 1
    }
    return 0
}
