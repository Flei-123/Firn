// SPDX-License-Identifier: MPL-2.0
// tools/gpu/web/hills.fi -- the shared part of the browser hills demo (r106): navigation and pose per frame, DETERMINISTIC.
// The pose of frame f depends only on f and on the key mask of every frame up to f (fixed time step, no wall clock), so the
// browser build (hills_web.fi, WebGL2) and the native build (hills_native.fi, mc_raster) can be compared frame by frame.
import std.math
import mc.mc_camera
import mc.mc_math

export {
    Nav, FRAMES, K_FWD, K_BACK, K_LEFT, K_RIGHT, SNAP_N, nav_new, nav_step, nav_apply, script_keys, snap_frame,
}

const FRAMES: u32 = 40 as u32 // frames the demo runs in check mode
const SNAP_N: usize = 5 // snapshots compared by check.py
const K_FWD: u32 = 1 as u32
const K_BACK: u32 = 2 as u32
const K_LEFT: u32 = 4 as u32
const K_RIGHT: u32 = 8 as u32

struct Nav {
    x: f64,
    y: f64,
    z: f64,
    yaw: f64,
    pitch: f64,
    frame: u32,
}

fn nav_new() -> Nav {
    return Nav { x: 20.0, y: 12.0, z: 0.0 - 10.0, yaw: 10.0, pitch: 25.0, frame: 0 as u32 }
}

// Frames at which the check compares the canvas with the native frame.
fn snap_frame(i: usize) -> u32 {
    if i == 0 { return 0 as u32 }
    if i == 1 { return 8 as u32 } // W held
    if i == 2 { return 16 as u32 } // D held
    if i == 3 { return 24 as u32 } // S held
    return 39 as u32
}

// The key script the browser page injects (hills.html): W held in frames 4..11, D in 14..21, S in 24..27.
// Frame f sees the mask that was injected after the present of frame f-1.
fn script_keys(f: u32) -> u32 {
    var m: u32 = 0 as u32
    if f >= 4 as u32 && f <= 11 as u32 { m = m | K_FWD }
    if f >= 14 as u32 && f <= 21 as u32 { m = m | K_RIGHT }
    if f >= 24 as u32 && f <= 27 as u32 { m = m | K_BACK }
    return m
}

// One frame of navigation: fixed step. `turn` = yaw degrees this frame (mouse or arrow keys), `keys` = K_* mask.
fn nav_step(n: *mut Nav, keys: u32, turn: f64, look: f64) {
    (*n).yaw = (*n).yaw + turn
    (*n).pitch = (*n).pitch + look
    if (*n).pitch > 80.0 { (*n).pitch = 80.0 }
    if (*n).pitch < 0.0 - 80.0 { (*n).pitch = 0.0 - 80.0 }
    // horizontal heading from the yaw (same sin/cos pair as the camera basis would give; only consistency matters here)
    let a: f64 = (*n).yaw * 3.14159265358979 / 180.0
    let fx: f64 = math.sin(a)
    let fz: f64 = math.cos(a)
    var mx: f64 = 0.0
    var mz: f64 = 0.0
    if (keys & K_FWD) != 0 as u32 {
        mx = mx + fx
        mz = mz + fz
    }
    if (keys & K_BACK) != 0 as u32 {
        mx = mx - fx
        mz = mz - fz
    }
    if (keys & K_RIGHT) != 0 as u32 {
        mx = mx + fz
        mz = mz - fx
    }
    if (keys & K_LEFT) != 0 as u32 {
        mx = mx - fz
        mz = mz + fx
    }
    (*n).x = (*n).x + mx * 0.5
    (*n).z = (*n).z + mz * 0.5
    (*n).frame = (*n).frame + 1 as u32
}

fn nav_apply(n: *mut Nav, cam: *mut mc_camera.Camera) {
    mc_camera.camera_set_pos(cam, (*n).x, (*n).y, (*n).z)
    mc_camera.camera_set_angles(cam, (*n).yaw, (*n).pitch)
    mc_camera.camera_update(cam)
}
