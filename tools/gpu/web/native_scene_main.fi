// SPDX-License-Identifier: MPL-2.0
// tools/gpu/web/native_scene_main.fi -- NATIVE reference of gate 133: the scene-layer scenes (sceneref.fi) through the CPU path
// (mc_raster + mc_sky + mc_hud) only, written as raw RGBA (row 0 = top) to <outdir>/<scene>.cpu.rgba. check_scene.py compares them with
// the canvas snapshots of the browser.   usage: native_scene_main <outdir>
import std.rt
import std.io
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_backend
import mc.mc_sky
import webscene
import sceneref

fn write_raw(dir: u64, dirn: usize, name: str, px: u64, n: usize) {
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, dirn)
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push_bytes(&path, ".cpu.rgba".p as u64, 9)
    rt.buf_push(&path, 0 as u8)
    rt.write_file(rt.buf_ptr(&path), px, n * 4)
    rt.buf_free(&path)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        io.print("usage: native_scene_main <outdir>\n")
        return 2
    }
    let dir: u64 = rt.arg_ptr(start, 1)
    var dirn: usize = 0
    while rt.ld8(dir, dirn) != 0 as u8 { dirn = dirn + 1 }
    var r: mc_raster.Raster = mc_raster.raster_new(webscene.W, webscene.H)
    mc_raster.raster_set_cull(&r, false)
    var bc: mc_backend.Backend = mc_backend.backend_cpu(&r)
    var cam: mc_camera.Camera = mc_camera.camera_new(webscene.W, webscene.H)
    var sky: mc_sky.Sky = mc_sky.sky_new()
    var ta: mc_texture.Atlas = sceneref.scene_atlas()
    bc.upload_atlas(bc.obj, (&ta) as u64)
    var qv: u64 = 0
    var qi: u64 = 0
    sceneref.build_quad(&qv, &qi)
    bc.mesh_upload(bc.obj, 1, qv, 8, qi, 12)
    sceneref.cam_setup(&cam)
    sky.discs = false
    var en: sceneref.Ents = sceneref.ents_new()
    var i: usize = 0
    while i < sceneref.NS {
        var sp: sceneref.Scn = sceneref.Scn { name: "", flags: 0 as u32, tint: false, cull: 1 }
        sceneref.spec(i, &sp)
        if sp.tint {
            sky.tr = 200
            sky.tg = 220
            sky.tb = 256
        } else {
            sky.tr = 256
            sky.tg = 256
            sky.tb = 256
        }
        sceneref.set_fog_cpu(&r, &sky, (sp.flags & sceneref.F_FOG) != 0 as u32)
        let pc: u64 = sceneref.frame_cpu(&r, &bc, &cam, &sky, sp.flags, &en)
        write_raw(dir, dirn, sp.name, pc, (webscene.W as usize) * (webscene.H as usize))
        io.print("native ")
        io.print(sp.name)
        io.new_line()
        i = i + 1
    }
    return 0
}
