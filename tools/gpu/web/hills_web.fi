// SPDX-License-Identifier: MPL-2.0
// tools/gpu/web/hills_web.fi -- r106: the hills demo in the browser. WebGL2 (gpu.glweb) draws the hills chunk of webscene.fi,
// the camera is driven per frame by hills.fi (fixed step, WASD from input.webraw, mouse look while the pointer is locked).
// Built with `firnc --target=wasm32-browser`; demos/mcweb/glweb.js calls the exported firn_mc_frame once per requestAnimationFrame.
// State lives in heap blocks that main leaves behind (the wasm instance stays alive after _start returned).
import std.rt
import std.io
import mc.mc_camera
import mc.mc_texture
import mc.mc_backend
import input.raw
import input.webraw
import gpu.glweb
import webscene
import hills

const BLK: usize = 65536

static mut G_GW: u64 = 0
static mut G_BG: u64 = 0
static mut G_WD: u64 = 0
static mut G_CAM: u64 = 0
static mut G_NAV: u64 = 0
static mut G_RAW: u64 = 0
static mut G_MESH: u64 = 0

fn main(start: u64) -> i32 {
    G_GW = rt.heap_alloc(BLK)
    G_BG = rt.heap_alloc(BLK)
    G_WD = rt.heap_alloc(BLK)
    G_CAM = rt.heap_alloc(BLK)
    G_NAV = rt.heap_alloc(BLK)
    G_RAW = rt.heap_alloc(BLK)
    G_MESH = rt.heap_alloc(64)
    let gw: *mut glweb.GlWeb = G_GW as *mut glweb.GlWeb
    *gw = glweb.glweb_open(webscene.W, webscene.H)
    if !(*gw).ok {
        io.fmt_print(f"no WebGL2: step={(*gw).step}\n")
        io.print_c((&(*gw).log[0]) as u64)
        io.new_line()
        return 4
    }
    let bg: *mut mc_backend.Backend = G_BG as *mut mc_backend.Backend
    *bg = glweb.glweb_backend(gw)
    let wd: *mut webscene.World = G_WD as *mut webscene.World
    *wd = webscene.world_new()
    let cam: *mut mc_camera.Camera = G_CAM as *mut mc_camera.Camera
    *cam = mc_camera.camera_new(webscene.W, webscene.H)
    let nav: *mut hills.Nav = G_NAV as *mut hills.Nav
    *nav = hills.nav_new()
    let rw: *mut raw.Raw = G_RAW as *mut raw.Raw
    *rw = raw.raw_new()
    (*bg).upload_atlas((*bg).obj, (&(*wd).da) as u64)
    let h: usize = (*bg).mesh_upload((*bg).obj, 1, (*wd).m.verts, (*wd).m.nverts as usize, (*wd).m.idx, (*wd).m.nidx as usize)
    rt.st64(G_MESH, 0, h as u64)
    io.fmt_print(f"hills web ready {webscene.W}x{webscene.H} mesh={h}\n")
    return 0
}

// requestAnimationFrame callback: 1 = keep going, 0 = stop.
#[export_c]
fn firn_mc_frame(ms: u32) -> u32 {
    if G_GW == 0 { return 0 as u32 }
    let gw: *mut glweb.GlWeb = G_GW as *mut glweb.GlWeb
    let bg: *mut mc_backend.Backend = G_BG as *mut mc_backend.Backend
    let cam: *mut mc_camera.Camera = G_CAM as *mut mc_camera.Camera
    let nav: *mut hills.Nav = G_NAV as *mut hills.Nav
    let rw: *mut raw.Raw = G_RAW as *mut raw.Raw
    if !(*gw).ok { return 0 as u32 }
    webraw.webraw_poll(rw)
    var keys: u32 = 0 as u32
    if raw.key_down(rw, raw.KEY_W) { keys = keys | hills.K_FWD }
    if raw.key_down(rw, raw.KEY_S) { keys = keys | hills.K_BACK }
    if raw.key_down(rw, raw.KEY_A) { keys = keys | hills.K_LEFT }
    if raw.key_down(rw, raw.KEY_D) { keys = keys | hills.K_RIGHT }
    // slow automatic orbit (0.5 deg/frame) plus the mouse while the pointer is locked
    let turn: f64 = 0.5 + (raw.mouse_dx(rw) as f64) * 0.15
    let look: f64 = (raw.mouse_dy(rw) as f64) * 0.15
    let f: u32 = (*nav).frame
    hills.nav_step(nav, keys, turn, look)
    hills.nav_apply(nav, cam)
    let wd: *mut webscene.World = G_WD as *mut webscene.World
    let h: usize = rt.ld64(G_MESH, 0) as usize
    let tris: u64 = webscene.frame(bg, cam, webscene.CLEAR, h, 2, 2, 0.0, 0.0, 0.0)
    var s: usize = 0
    while s < hills.SNAP_N {
        if hills.snap_frame(s) == f {
            io.fmt_print(f"hills snap {f} tris={tris} keys={keys} glerr={glweb.glweb_error(gw)}\n")
        }
        s = s + 1
    }
    glweb.glweb_show(gw)
    return 1 as u32
}
