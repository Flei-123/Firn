// tools/gpu/mc/scene_smoke.fi -- smoke run of lib/gpu/gl_scene.fi: opens the passes, draws sky + one entity + HUD, prints pixels.
import std.rt
import std.io
import mc.mc_camera
import mc.mc_sky
import mc.mc_hud
import mc.mc_raster
import mc.mc_backend
import gpu.gl_mc
import gpu.gl_scene

#[allow_escape]
fn main(start: u64) -> i32 {
    var gb: gl_mc.GlBackend = gl_mc.glbe_open(320, 180)
    if !gb.ok {
        io.fmt_print(f"no GL context: step={gb.step}\n")
        return 4
    }
    var sc: gl_scene.Scene = gl_scene.scene_open(&gb)
    if !sc.ok {
        io.fmt_print(f"scene_open failed step={sc.step}\n")
        io.print_c((&sc.sky_p.log[0]) as u64)
        io.print_c((&sc.ent_p.log[0]) as u64)
        io.print_c((&sc.hud_p.log[0]) as u64)
        io.print_c((&sc.tint_p.log[0]) as u64)
        return 3
    }
    var b: mc_backend.Backend = gl_mc.glbe_backend(&gb)
    var cam: mc_camera.Camera = mc_camera.camera_new(320, 180)
    mc_camera.camera_set_pos(&cam, 0.0, 0.0, 0.0)
    mc_camera.camera_set_angles(&cam, 0.0, 0.0)
    mc_camera.camera_update(&cam)
    var sky: mc_sky.Sky = mc_sky.sky_new()
    gl_scene.scene_frame(&sc)
    b.begin(b.obj, (&cam) as u64, 0xFF000000 as u32)
    gl_scene.scene_sky(&sc, &cam, &sky)
    b.end(b.obj)
    var e: gl_scene.Ent = gl_scene.ent_new(0.0, 0.0, 6.0, 2.0, 2.0, 2.0, 0.5, 200 as u32, 80 as u32, 40 as u32)
    gl_scene.scene_ent_add(&sc, &e)
    gl_scene.scene_ent_flush(&sc, &cam)
    var r: mc_raster.Raster = mc_raster.raster_new(320, 180)
    var rec: rt.Buf = rt.buf_new()
    mc_hud.hud_record(&rec)
    var dbg: mc_hud.HudDebug = mc_hud.hud_debug_new()
    mc_hud.hud_frame(&r, 2, mc_hud.HUD_CROSSHAIR | mc_hud.HUD_HOTBAR, 1, &dbg)
    mc_hud.hud_record(0 as *mut rt.Buf)
    gl_scene.scene_hud(&sc, &rec)
    let px: u64 = b.present(b.obj)
    io.fmt_print(f"sky(5,5)={rt.ld32(px, 5 * 320 + 5)} top-left sky ok\n")
    io.fmt_print(f"ent centre={rt.ld32(px, 90 * 320 + 160)} drawn={sc.st_drawn} hud_rects={sc.st_hud_rects} runs={sc.st_hud_runs}\n")
    io.fmt_print(f"sky ref colour zen={sky.zr},{sky.zg},{sky.zb} hor={sky.hr},{sky.hg},{sky.hb}\n")
    gl_scene.scene_close(&sc)
    return 0
}
