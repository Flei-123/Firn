// tools/gpu/mc/upload_probe.fi -- raw buffer upload timings (the "pool upload 6x slower" question of docs/mc/gpu-world.md).
// A: BufferData(NULL, 8 MB) + 25 x SubData(32 KB), first time vs second time on the SAME buffer (first touch of the pages)
// B: 25 x BufferData(32 KB) on 25 buffers (legacy: one buffer per section), first vs second time
// C: 75 small SubData (2 KB) into one buffer. Every run ends with glFinish. Prints microseconds (llvmpipe, no real GPU).
import std.rt
import std.io
import std.time
import gpu.gl33
import gpu.gl_mc

const SEC: usize = 32768
const NSEC: usize = 25

fn us_since(t0: u64) -> u64 {
    return (time.monotonic_ns() - t0) / (1000 as u64)
}

fn pool_pass(g: *mut gl33.Gl, buf: u32, src: u64) -> u64 {
    let t0: u64 = time.monotonic_ns()
    gl33.gl_bind_buffer(g, gl33.GL_ARRAY_BUFFER, buf)
    var i: usize = 0
    while i < NSEC {
        gl33.gl_buffer_sub_data(g, gl33.GL_ARRAY_BUFFER, i * SEC, SEC, src)
        i = i + 1
    }
    gl33.gl_finish(g)
    return us_since(t0)
}

fn legacy_pass(g: *mut gl33.Gl, bufs: u64, src: u64) -> u64 {
    let t0: u64 = time.monotonic_ns()
    var i: usize = 0
    while i < NSEC {
        gl33.gl_bind_buffer(g, gl33.GL_ARRAY_BUFFER, rt.ld32(bufs, i))
        gl33.gl_buffer_data(g, gl33.GL_ARRAY_BUFFER, src, SEC, gl33.GL_STATIC_DRAW)
        i = i + 1
    }
    gl33.gl_finish(g)
    return us_since(t0)
}

fn main(start: u64) -> i32 {
    var gb: gl_mc.GlBackend = gl_mc.glbe_open(64, 64)
    if !gb.ok {
        io.fmt_print(f"no GL context: step={gb.step}\n")
        return 4
    }
    let g: *mut gl33.Gl = gl_mc.glbe_gl(&gb)
    let src: u64 = rt.heap_alloc(8 * 1024 * 1024)
    var i: usize = 0
    while i < 8 * 1024 * 1024 / 4 {
        rt.st32(src, i, ((i * 2654435761) % 4294967296) as u32)
        i = i + 1
    }
    let buf: u32 = gl33.gl_gen_buffer(g)
    gl33.gl_bind_buffer(g, gl33.GL_ARRAY_BUFFER, buf)
    gl33.gl_buffer_data(g, gl33.GL_ARRAY_BUFFER, 0 as u64, 8 * 1024 * 1024, gl33.GL_DYNAMIC_DRAW)
    let a1: u64 = pool_pass(g, buf, src)
    let a2: u64 = pool_pass(g, buf, src)
    let a3: u64 = pool_pass(g, buf, src)
    io.fmt_print(f"A pool 8MB + {NSEC} SubData(32KB): first={a1}us second={a2}us third={a3}us\n")
    let bufs: u64 = rt.heap_alloc(NSEC * 4)
    i = 0
    while i < NSEC {
        rt.st32(bufs, i, gl33.gl_gen_buffer(g))
        i = i + 1
    }
    let b1: u64 = legacy_pass(g, bufs, src)
    let b2: u64 = legacy_pass(g, bufs, src)
    let b3: u64 = legacy_pass(g, bufs, src)
    io.fmt_print(f"B legacy {NSEC} x BufferData(32KB): first={b1}us second={b2}us third={b3}us\n")
    gl33.gl_bind_buffer(g, gl33.GL_ARRAY_BUFFER, buf)
    let t0: u64 = time.monotonic_ns()
    i = 0
    while i < 75 {
        gl33.gl_buffer_sub_data(g, gl33.GL_ARRAY_BUFFER, i * 2048, 2048, src)
        i = i + 1
    }
    gl33.gl_finish(g)
    let c1: u64 = us_since(t0)
    io.fmt_print(f"C 75 x SubData(2KB) into the warm pool: {c1}us\n")
    return 0
}
