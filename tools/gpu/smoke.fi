// tools/gpu/smoke.fi -- EGL GL 3.3 core context + clear + readback through lib/gpu (exit 0 = red pixel read back).
import std.rt
import std.io
import gpu.glctx
import gpu.gl33

fn main() -> i32 {
    var c: glctx.GlCtx = glctx.ctx_open(0, 0)
    if !c.ok { io.fmt_print(f"ctx failed step={c.step}\n"); return 10 + c.step }
    var g: gl33.Gl = gl33.gl_new()
    let okl: bool = gl33.gl_load(&c, &g)
    io.fmt_print(f"load={okl} missing={g.missing} gl={g.major}.{g.minor} surfaceless={c.surfaceless}\n")
    if !okl { return 30 }
    io.print("renderer: ")
    io.print_c(gl33.gl_string(&g, gl33.GL_RENDERER))
    io.new_line()
    gl33.gl_clear_color(&g, 1.0, 0.0, 0.0, 1.0)
    gl33.gl_clear(&g, gl33.GL_COLOR_BUFFER_BIT)
    var px: [u8; 4] = [9; 4]
    gl33.gl_read_rgba(&g, 0, 0, 1, 1, (&px[0]) as u64)
    io.fmt_print(f"px={px[0]} {px[1]} {px[2]} {px[3]} err={gl33.gl_get_error(&g)}\n")
    glctx.ctx_close(&c)
    return 0
}
