// WIP smoke (NOT a gate yet): segfaults inside lavapipe at the first draw/push -- see docs/VK-RENDERER.md "Open bug". Exit 0 = ok.
// mc.vk_mc: Vulkan voxel back end (lavapipe, NO real GPU) -- builds, draws a textured quad through the Backend table, checks the pixels.
// SKIP (exit 0) without a Vulkan device.
import std.rt
import std.io
import mc.mc_backend
import mc.mc_camera
import mc.mc_texture
import mc.vk_mc

fn main(start: u64) -> i32 {
    var vb: vk_mc.VkBackend = vk_mc.vkbe_open(160, 90)
    if !vb.ok {
        io.fmt_print(f"SKIP vkbe_open step={vb.step}\n")
        return 0
    }
    var b: mc_backend.Backend = vk_mc.vkbe_backend(&vb)
    var ta: mc_texture.Atlas = mc_texture.atlas_default()
    b.upload_atlas(b.obj, (&ta) as u64)
    var cam: mc_camera.Camera = mc_camera.camera_new(160, 90)
    mc_camera.camera_set_pos(&cam, 8.0, 8.0, 0.0)
    mc_camera.camera_set_angles(&cam, 0.0, 0.0)
    mc_camera.camera_update(&cam)
    let v: u64 = rt.heap_alloc(4 * 8)
    let ix: u64 = rt.heap_alloc(6 * 4)
    // quad at z = 10, x 4..12, y 2..14, tile 1, face 3
    var k: usize = 0
    let xs: [u32; 4] = [12 as u32, 4 as u32, 4 as u32, 12 as u32]
    let ys: [u32; 4] = [2 as u32, 2 as u32, 14 as u32, 14 as u32]
    while k < 4 {
        rt.st32(v, k * 2, xs[k] | (ys[k] << 8 as u32) | (10 as u32 << 16 as u32) | (3 as u32 << 24 as u32))
        rt.st32(v, k * 2 + 1, 1 as u32)
        k = k + 1
    }
    rt.st32(ix, 0, 0 as u32)
    rt.st32(ix, 1, 1 as u32)
    rt.st32(ix, 2, 2 as u32)
    rt.st32(ix, 3, 0 as u32)
    rt.st32(ix, 4, 2 as u32)
    rt.st32(ix, 5, 3 as u32)
    let h: usize = b.mesh_upload(b.obj, 1, v, 4, ix, 6)
    b.begin(b.obj, (&cam) as u64, 0xFFE6BE96 as u32)
    let t: u64 = b.draw(b.obj, h, 0.0, 0.0, 0.0)
    b.end(b.obj)
    let px: u64 = b.present(b.obj)
    var fails: i32 = 0
    let clear: u32 = 0xFFE6BE96 as u32
    var cov: u64 = 0
    var i: usize = 0
    while i < 160 * 90 {
        if rt.ld32(px, i) != clear { cov = cov + 1 as u64 }
        i = i + 1
    }
    io.fmt_print(f"tris={t} covered={cov} h={h}\n")
    if t != 2 as u64 || cov < 1000 as u64 || h != 1 { fails = fails + 1 }
    if rt.ld32(px, 0) != clear { fails = fails + 1 }
    vk_mc.vkbe_close(&vb)
    io.fmt_print(f"vk_mc smoke: {fails} failed\n")
    return fails
}
