// SPDX-License-Identifier: MPL-2.0
// tools/gpu/vk/vkscene_dump.fi -- the Vulkan scene layer (lib/mc/vk_mc.fi: sky, tint, entities, HUD) against the CPU path (mc_raster + mc_sky +
// mc_hud). Same pass order on both sides; copy of the idea of tools/gpu/mc/scene.fi (GL). Scenes are added with the features (roadmap r180).
// lavapipe (CPU renderer), NO real GPU. Exit 0 = all scenes >= 34 dB, 3 = a check failed, 4 = no Vulkan device (the gate prints SKIP).
import std.rt
import std.io
import std.math
import std.time
import mc.mc_camera
import mc.mc_texture
import mc.mc_raster
import mc.mc_backend
import mc.mc_sky
import mc.mc_hud
import mc.vk_mc

const W: i32 = 320
const H: i32 = 180
const MIN_PSNR_X100: u64 = 3400

struct Cmp {
    diff_px: u64,
    big_px: u64,
    max_diff: u32,
    cov_cpu: u64,
    cov_gpu: u64,
    psnr_x100: u64,
}

struct Sc {
    r: mc_raster.Raster,
    gb: vk_mc.VkBackend,
    bc: mc_backend.Backend,
    bg: mc_backend.Backend,
    cam: mc_camera.Camera,
    sky: mc_sky.Sky,
    en: Ents,
    fails: i32,
}

fn print_f2(v: f64) {
    var x: f64 = v
    if x < 0.0 { x = 0.0 }
    let i: i64 = x as i64
    var f: i64 = ((x - (i as f64)) * 100.0 + 0.5) as i64
    var ii: i64 = i
    if f >= 100 as i64 {
        f = f - 100 as i64
        ii = ii + 1 as i64
    }
    if f < 10 as i64 {
        io.fmt_print(f"{ii}.0{f}")
    } else {
        io.fmt_print(f"{ii}.{f}")
    }
}

fn compare(a: u64, b: u64, n: usize, clear: u32, out: *mut Cmp) {
    (*out).diff_px = 0 as u64
    (*out).big_px = 0 as u64
    (*out).max_diff = 0 as u32
    (*out).cov_cpu = 0 as u64
    (*out).cov_gpu = 0 as u64
    var sq: f64 = 0.0
    var i: usize = 0
    while i < n {
        let pa: u32 = rt.ld32(a, i)
        let pb: u32 = rt.ld32(b, i)
        if pa != clear { (*out).cov_cpu = (*out).cov_cpu + 1 as u64 }
        if pb != clear { (*out).cov_gpu = (*out).cov_gpu + 1 as u64 }
        if pa != pb {
            (*out).diff_px = (*out).diff_px + 1 as u64
            var mx: u32 = 0 as u32
            var k: u32 = 0 as u32
            while k < 4 as u32 {
                let ba: i32 = ((pa >> (k * 8 as u32)) & 255 as u32) as i32
                let bb: i32 = ((pb >> (k * 8 as u32)) & 255 as u32) as i32
                var d: i32 = ba - bb
                if d < 0 { d = 0 - d }
                if k < 3 as u32 { sq = sq + (d * d) as f64 }
                if (d as u32) > mx { mx = d as u32 }
                k = k + 1 as u32
            }
            if mx > (*out).max_diff { (*out).max_diff = mx }
            if mx > 16 as u32 { (*out).big_px = (*out).big_px + 1 as u64 }
        }
        i = i + 1
    }
    var psnr: f64 = 99.0
    if sq > 0.0 {
        let mse: f64 = sq / ((n as f64) * 3.0)
        psnr = 10.0 * math.log10(255.0 * 255.0 / mse)
    }
    (*out).psnr_x100 = (psnr * 100.0) as u64
}

// tiles: 1 orange (world), 2..5 solid entity colours
fn scene_atlas() -> mc_texture.Atlas {
    var a: mc_texture.Atlas = mc_texture.atlas_new(16, 4, 4)
    var t: u32 = 1 as u32
    while t <= 5 as u32 {
        var c: u32 = mc_texture.pack_pixel(230 as u32, 120 as u32, 40 as u32, 255 as u32)
        if t == 2 as u32 { c = mc_texture.pack_pixel(200 as u32, 80 as u32, 40 as u32, 255 as u32) }
        if t == 3 as u32 { c = mc_texture.pack_pixel(40 as u32, 160 as u32, 220 as u32, 255 as u32) }
        if t == 4 as u32 { c = mc_texture.pack_pixel(90 as u32, 200 as u32, 60 as u32, 255 as u32) }
        if t == 5 as u32 { c = mc_texture.pack_pixel(230 as u32, 230 as u32, 50 as u32, 255 as u32) }
        let ox: i32 = mc_texture.atlas_tile_x(&a, t)
        let oy: i32 = mc_texture.atlas_tile_y(&a, t)
        var y: i32 = 0
        while y < 16 {
            var x: i32 = 0
            while x < 16 {
                rt.st32(a.px, ((oy + y) * a.w + ox + x) as usize, c)
                x = x + 1
            }
            y = y + 1
        }
        t = t + 1 as u32
    }
    return a
}

fn vw0(x: u32, y: u32, z: u32, face: u32, ao: u32) -> u32 {
    return x | (y << 8 as u32) | (z << 16 as u32) | (face << 24 as u32) | (ao << 27 as u32)
}

fn vw1(tile: u32, u: u32, v: u32) -> u32 {
    return tile | (u << 16 as u32) | (v << 24 as u32)
}

fn put_vtx(vp: u64, i: usize, w0: u32, w1: u32) {
    rt.st32(vp, i * 2, w0)
    rt.st32(vp, i * 2 + 1, w1)
}

fn stf(p: u64, i: usize, v: f64) {
    *((p + (i as u64) * (8 as u64)) as *mut f64) = v
}

// Entity box (centre, size, yaw about +Y) for the scenes; the record layout is mc_backend.ENT_WORDS f64.
struct Ent {
    x: f64, y: f64, z: f64, sx: f64, sy: f64, sz: f64, yaw_sin: f64, yaw_cos: f64, r: u32, g: u32, b: u32, flag: f64,
}

fn ent_new(x: f64, y: f64, z: f64, sx: f64, sy: f64, sz: f64, yaw: f64, r: u32, g: u32, b: u32) -> Ent {
    return Ent { x: x, y: y, z: z, sx: sx, sy: sy, sz: sz, yaw_sin: math.sin(yaw), yaw_cos: math.cos(yaw), r: r, g: g, b: b, flag: 0.0 }
}

fn ent_glow(e: Ent) -> Ent {
    var g: Ent = e
    g.flag = 0.0 - 1.0
    return g
}

fn ent_put(recs: u64, i: usize, e: *mut Ent) {
    let p: u64 = recs + (i * mc_backend.ENT_BYTES) as u64
    stf(p, 0, (*e).x)
    stf(p, 1, (*e).y)
    stf(p, 2, (*e).z)
    stf(p, 3, (*e).sx)
    stf(p, 4, (*e).sy)
    stf(p, 5, (*e).sz)
    stf(p, 6, (*e).yaw_sin)
    stf(p, 7, (*e).yaw_cos)
    stf(p, 8, (*e).r as f64)
    stf(p, 9, (*e).g as f64)
    stf(p, 10, (*e).b as f64)
    stf(p, 11, (*e).flag)
}

// CPU reference of one box: 6 faces x 2 triangles, the same corner order and face_k as gl_scene (FK 204 204 128 256 153 153).
fn cpu_ent(r: *mut mc_raster.Raster, cam: *mut mc_camera.Camera, e: *mut Ent, tile: u32) {
    let fkt: [u32; 6] = [204 as u32, 204 as u32, 128 as u32, 256 as u32, 153 as u32, 153 as u32]
    var vb: [f64; 24] = [0.0; 24]
    var f: usize = 0
    while f < 6 {
        let axis: usize = f / 2
        var sgn: f64 = 0.0 - 0.5
        if f % 2 == 1 { sgn = 0.5 }
        var k: usize = 0
        while k < 4 {
            var a: f64 = 0.0 - 0.5
            if k % 2 == 1 { a = 0.5 }
            var b: f64 = 0.0 - 0.5
            if k / 2 == 1 { b = 0.5 }
            var c: [f64; 3] = [0.0, 0.0, 0.0]
            c[axis] = sgn
            c[(axis + 1) % 3] = a
            c[(axis + 2) % 3] = b
            let qx: f64 = c[0] * (*e).sx
            let qy: f64 = c[1] * (*e).sy
            let qz: f64 = c[2] * (*e).sz
            let wx: f64 = qx * (*e).yaw_cos + qz * (*e).yaw_sin + (*e).x - (*cam).x
            let wy: f64 = qy + (*e).y - (*cam).y
            let wz: f64 = 0.0 - qx * (*e).yaw_sin + qz * (*e).yaw_cos + (*e).z - (*cam).z
            vb[k * 6] = wx * (*cam).rx + wy * (*cam).ry + wz * (*cam).rz
            vb[k * 6 + 1] = wx * (*cam).ux + wy * (*cam).uy + wz * (*cam).uz
            vb[k * 6 + 2] = wx * (*cam).fx + wy * (*cam).fy + wz * (*cam).fz
            vb[k * 6 + 3] = 0.5
            vb[k * 6 + 4] = 0.5
            vb[k * 6 + 5] = 3.0
            k = k + 1
        }
        let p: u64 = (&vb[0]) as u64
        mc_raster.raster_draw_tri(r, p, p + 48 as u64, p + 144 as u64, tile, fkt[f])
        mc_raster.raster_draw_tri(r, p, p + 144 as u64, p + 96 as u64, tile, fkt[f])
        f = f + 1
    }
}

// Entity list used by the scenes. kind 0 = no wall, 1 = wall (occluder) + hidden box + box behind the camera.
struct Ents {
    a: Ent, b: Ent, c: Ent, wall: Ent, hid: Ent, back: Ent, glow_a: Ent, glow_b: Ent, lit_a: Ent,
}

fn ents_new() -> Ents {
    return Ents {
        a: ent_new(8.0, 8.0, 6.0, 2.0, 2.0, 2.0, 0.5, 200 as u32, 80 as u32, 40 as u32),
        b: ent_new(11.5, 9.0, 8.0, 1.5, 3.0, 1.0, 1.1, 40 as u32, 160 as u32, 220 as u32),
        c: ent_new(5.0, 7.0, 12.0, 2.0, 1.0, 3.0, 0.0, 90 as u32, 200 as u32, 60 as u32),
        wall: ent_new(8.0, 8.0, 3.0, 5.0, 5.0, 0.5, 0.0, 230 as u32, 230 as u32, 50 as u32),
        hid: ent_new(8.0, 8.0, 9.0, 1.0, 1.0, 1.0, 0.0, 200 as u32, 80 as u32, 40 as u32),
        back: ent_new(8.0, 8.0, -6.0, 1.0, 1.0, 1.0, 0.0, 40 as u32, 160 as u32, 220 as u32),
        glow_a: ent_glow(ent_new(8.0, 9.0, 40.0, 2.0, 6.0, 2.0, 0.3, 245 as u32, 245 as u32, 255 as u32)),
        glow_b: ent_glow(ent_new(10.5, 8.0, 14.0, 1.0, 5.0, 1.0, 0.8, 245 as u32, 245 as u32, 255 as u32)),
        lit_a: ent_new(5.5, 8.0, 14.0, 1.0, 5.0, 1.0, 0.8, 245 as u32, 245 as u32, 255 as u32),
    }
}

// flags: 1 sky, 2 world quad, 4 fog, 8 tint, 16 HUD, 32 entities
fn frame_cpu(s: *mut Sc, clear: u32, flags: u32) -> u64 {
    mc_camera.camera_update(&(*s).cam)
    (*s).bc.begin((*s).bc.obj, ((&(*s).cam) as u64), clear)
    if (flags & 1 as u32) != 0 as u32 { mc_sky.sky_draw_plain(&(*s).sky, &(*s).r) }
    if (flags & 2 as u32) != 0 as u32 { (*s).bc.draw((*s).bc.obj, 1, 0.0, 0.0, 0.0) }
    (*s).bc.end((*s).bc.obj)
    if (flags & 32 as u32) != 0 as u32 {
        cpu_ent(&(*s).r, &(*s).cam, &(*s).en.a, 2 as u32)
        cpu_ent(&(*s).r, &(*s).cam, &(*s).en.b, 3 as u32)
        cpu_ent(&(*s).r, &(*s).cam, &(*s).en.c, 4 as u32)
    }
    if (flags & 64 as u32) != 0 as u32 {
        cpu_ent(&(*s).r, &(*s).cam, &(*s).en.wall, 5 as u32)
        cpu_ent(&(*s).r, &(*s).cam, &(*s).en.hid, 2 as u32)
        cpu_ent(&(*s).r, &(*s).cam, &(*s).en.back, 3 as u32)
    }
    if (flags & 128 as u32) != 0 as u32 {
        var recs: [f64; 36] = [0.0; 36]
        let rp: u64 = (&recs[0]) as u64
        let m: usize = glow_records(s, rp)
        (*s).bc.draw_entities((*s).bc.ent_obj, rp, m)
    }
    if (flags & 8 as u32) != 0 as u32 { mc_sky.sky_tint_frame(&(*s).sky, &(*s).r) }
    if (flags & 16 as u32) != 0 as u32 {
        var dbg: mc_hud.HudDebug = mc_hud.hud_debug_new()
        mc_hud.hud_frame(&(*s).r, 2, mc_hud.HUD_CROSSHAIR | mc_hud.HUD_HOTBAR | mc_hud.HUD_DEBUG, 3, &dbg)
    }
    return (*s).bc.present((*s).bc.obj)
}

fn glow_records(s: *mut Sc, rp: u64) -> usize {
    ent_put(rp, 0, &(*s).en.glow_a)
    ent_put(rp, 1, &(*s).en.glow_b)
    ent_put(rp, 2, &(*s).en.lit_a)
    return 3
}

#[allow_escape]
fn frame_gpu(s: *mut Sc, clear: u32, flags: u32) -> u64 {
    mc_camera.camera_update(&(*s).cam)
    (*s).bg.begin((*s).bg.obj, ((&(*s).cam) as u64), clear)
    if (flags & 1 as u32) != 0 as u32 { vk_mc.vkbe_sky(&(*s).gb, &(*s).cam, &(*s).sky) }
    if (flags & 2 as u32) != 0 as u32 { (*s).bg.draw((*s).bg.obj, 1, 0.0, 0.0, 0.0) }
    if (flags & 96 as u32) != 0 as u32 {
        var recs: [f64; 72] = [0.0; 72]
        let rp: u64 = (&recs[0]) as u64
        var m: usize = 0
        if (flags & 32 as u32) != 0 as u32 {
            ent_put(rp, m, &(*s).en.a)
            ent_put(rp, m + 1, &(*s).en.b)
            ent_put(rp, m + 2, &(*s).en.c)
            m = m + 3
        }
        if (flags & 64 as u32) != 0 as u32 {
            ent_put(rp, m, &(*s).en.wall)
            ent_put(rp, m + 1, &(*s).en.hid)
            ent_put(rp, m + 2, &(*s).en.back)
            m = m + 3
        }
        (*s).bg.draw_entities((*s).bg.ent_obj, rp, m)
    }
    if (flags & 128 as u32) != 0 as u32 {
        var grecs: [f64; 36] = [0.0; 36]
        let gp: u64 = (&grecs[0]) as u64
        let gm: usize = glow_records(s, gp)
        (*s).bg.draw_entities((*s).bg.ent_obj, gp, gm)
    }
    if (flags & 8 as u32) != 0 as u32 { vk_mc.vkbe_tint(&(*s).gb, &(*s).sky) }
    if (flags & 16 as u32) != 0 as u32 {
        var scratch: mc_raster.Raster = mc_raster.raster_new(W, H)
        var rec: rt.Buf = rt.buf_new()
        mc_hud.hud_record(&rec)
        var dbg: mc_hud.HudDebug = mc_hud.hud_debug_new()
        mc_hud.hud_frame(&scratch, 2, mc_hud.HUD_CROSSHAIR | mc_hud.HUD_HOTBAR | mc_hud.HUD_DEBUG, 3, &dbg)
        mc_hud.hud_record(0 as *mut rt.Buf)
        vk_mc.vkbe_hud(&(*s).gb, &rec)
        rt.buf_free(&rec)
        mc_raster.raster_free(&scratch)
    }
    (*s).bg.end((*s).bg.obj)
    return (*s).bg.present((*s).bg.obj)
}

fn set_fog(s: *mut Sc, on: bool) {
    mc_raster.raster_set_fog(&(*s).r, on, 8.0, 40.0, (*s).sky.fr as u32, (*s).sky.fg as u32, (*s).sky.fb as u32)
    vk_mc.vkbe_set_fog(&(*s).gb, on, 8.0, 40.0, (*s).sky.fr as u32, (*s).sky.fg as u32, (*s).sky.fb as u32)
}

fn report(s: *mut Sc, name: str, c: *mut Cmp, ok: bool) {
    io.print("scene ")
    io.print(name)
    io.fmt_print(f" cov_cpu={(*c).cov_cpu} cov_gpu={(*c).cov_gpu} diff_px={(*c).diff_px} big_px={(*c).big_px} max_diff={(*c).max_diff} psnr=")
    print_f2(((*c).psnr_x100 as f64) / 100.0)
    if ok {
        io.print(" ok\n")
    } else {
        io.print(" FAIL\n")
        (*s).fails = (*s).fails + 1
    }
}

// Renders `flags` on both sides and checks PSNR >= 34 plus (when `need_cov`) that something was drawn.
fn scene(s: *mut Sc, name: str, clear: u32, flags: u32, need_cov: bool) {
    scene_bright(s, name, clear, flags, need_cov, 0 as u64)
}

fn bright_count(p: u64, n: usize) -> u64 {
    var c: u64 = 0 as u64
    var i: usize = 0
    while i < n {
        let v: u32 = rt.ld32(p, i)
        if (v & 255 as u32) >= 240 as u32 && ((v >> 8 as u32) & 255 as u32) >= 240 as u32 && ((v >> 16 as u32) & 255 as u32) >= 240 as u32 { c = c + 1 as u64 }
        i = i + 1
    }
    return c
}

fn scene_bright(s: *mut Sc, name: str, clear: u32, flags: u32, need_cov: bool, min_bright: u64) {
    let pc: u64 = frame_cpu(s, clear, flags)
    let pg: u64 = frame_gpu(s, clear, flags)
    var c: Cmp = Cmp { diff_px: 0 as u64, big_px: 0 as u64, max_diff: 0 as u32, cov_cpu: 0 as u64, cov_gpu: 0 as u64, psnr_x100: 0 as u64 }
    compare(pc, pg, (W as usize) * (H as usize), clear, &c)
    var ok: bool = c.psnr_x100 >= MIN_PSNR_X100
    if need_cov && (c.cov_cpu == 0 as u64 || c.cov_gpu == 0 as u64) { ok = false }
    if min_bright > 0 as u64 {
        let bc: u64 = bright_count(pc, (W as usize) * (H as usize))
        let bg: u64 = bright_count(pg, (W as usize) * (H as usize))
        io.fmt_print(f"bright_cpu={bc} bright_gpu={bg}\n")
        if bc < min_bright || bg < min_bright { ok = false }
    }
    report(s, name, &c, ok)
}

// Median wall time of 11 GPU frames of `flags` (begin .. present, readback on), printed as a metric line.
fn time_frames(s: *mut Sc, name: str, clear: u32, flags: u32) {
    var v: [u64; 11] = [0 as u64; 11]
    var i: usize = 0
    while i < 11 {
        frame_gpu(s, clear, flags)
        v[i] = (vk_mc.vkbe_frame_ms(&(*s).gb) * 1000.0) as u64
        i = i + 1
    }
    var a: usize = 0
    while a < 11 {
        var b: usize = a + 1
        while b < 11 {
            if v[b] < v[a] {
                let t: u64 = v[a]
                v[a] = v[b]
                v[b] = t
            }
            b = b + 1
        }
        a = a + 1
    }
    io.print("metric time ")
    io.print(name)
    io.fmt_print(f" {W}x{H} renderer=llvmpipe frames=11 median_us={v[5]}\n")
}

fn quad_mesh(s: *mut Sc) -> bool {
    let qv: u64 = rt.heap_alloc(8 * 8)
    let qi: u64 = rt.heap_alloc(12 * 4)
    put_vtx(qv, 0, vw0(14 as u32, 1 as u32, 10 as u32, 3 as u32, 0 as u32), vw1(1 as u32, 0 as u32, 2 as u32))
    put_vtx(qv, 1, vw0(2 as u32, 1 as u32, 10 as u32, 3 as u32, 3 as u32), vw1(1 as u32, 2 as u32, 2 as u32))
    put_vtx(qv, 2, vw0(2 as u32, 13 as u32, 10 as u32, 3 as u32, 1 as u32), vw1(1 as u32, 2 as u32, 0 as u32))
    put_vtx(qv, 3, vw0(14 as u32, 13 as u32, 10 as u32, 3 as u32, 2 as u32), vw1(1 as u32, 0 as u32, 0 as u32))
    put_vtx(qv, 4, vw0(14 as u32, 0 as u32, 14 as u32, 3 as u32, 3 as u32), vw1(1 as u32, 0 as u32, 2 as u32))
    put_vtx(qv, 5, vw0(2 as u32, 0 as u32, 14 as u32, 3 as u32, 3 as u32), vw1(1 as u32, 2 as u32, 2 as u32))
    put_vtx(qv, 6, vw0(2 as u32, 4 as u32, 14 as u32, 3 as u32, 3 as u32), vw1(1 as u32, 2 as u32, 0 as u32))
    put_vtx(qv, 7, vw0(14 as u32, 4 as u32, 14 as u32, 3 as u32, 3 as u32), vw1(1 as u32, 0 as u32, 0 as u32))
    var k: usize = 0
    while k < 2 {
        let o: usize = k * 6
        let b: u32 = (k * 4) as u32
        rt.st32(qi, o, b)
        rt.st32(qi, o + 1, b + 1 as u32)
        rt.st32(qi, o + 2, b + 2 as u32)
        rt.st32(qi, o + 3, b)
        rt.st32(qi, o + 4, b + 2 as u32)
        rt.st32(qi, o + 5, b + 3 as u32)
        k = k + 1
    }
    let hc: usize = (*s).bc.mesh_upload((*s).bc.obj, 1, qv, 8, qi, 12)
    let hg: usize = (*s).bg.mesh_upload((*s).bg.obj, 1, qv, 8, qi, 12)
    if hc != 1 || hg != 1 {
        io.fmt_print(f"unexpected mesh handles {hc} {hg}\n")
        return false
    }
    return true
}

#[allow_escape]
fn main(start: u64) -> i32 {
    var gb: vk_mc.VkBackend = vk_mc.vkbe_open(W, H)
    if !gb.ok {
        io.fmt_print(f"no Vulkan device: step={gb.step}\n")
        return 4
    }
    io.print("renderer: ")
    io.print_c(vk_mc.vkbe_device_name(&gb))
    io.new_line()
    var s: Sc = Sc { r: mc_raster.raster_new(W, H), gb: gb, bc: mc_backend.backend_new(), bg: mc_backend.backend_new(),
        cam: mc_camera.camera_new(W, H), sky: mc_sky.sky_new(), en: ents_new(), fails: 0 }
    mc_raster.raster_set_cull(&s.r, false)
    s.bc = mc_backend.backend_cpu(&s.r)
    s.bg = vk_mc.vkbe_backend(&s.gb)
    var ta: mc_texture.Atlas = scene_atlas()
    s.bc.upload_atlas(s.bc.obj, (&ta) as u64)
    s.bg.upload_atlas(s.bg.obj, (&ta) as u64)
    mc_camera.camera_set_pos(&s.cam, 8.0, 8.0, 0.0)
    mc_camera.camera_set_angles(&s.cam, 0.0, 0.0)
    s.sky.discs = false
    if !quad_mesh(&s) { return 3 }
    let clear: u32 = 0xFF302010 as u32

    set_fog(&s, false)
    scene(&s, "sky", clear, 1 as u32, true)
    // sunset: glow + sun / moon discs, looking towards the sun and away from it
    mc_sky.sky_set_time(&s.sky, 12600 as i64, 0)
    s.sky.discs = true
    mc_camera.camera_set_angles(&s.cam, 90.0, 5.0)
    scene(&s, "sky_sunset_east", clear, 1 as u32, true)
    mc_camera.camera_set_angles(&s.cam, 270.0, 5.0)
    scene(&s, "sky_sunset_west", clear, 1 as u32, true)
    mc_sky.sky_set_time(&s.sky, 18000 as i64, 0)
    mc_camera.camera_set_angles(&s.cam, 0.0, 40.0)
    scene(&s, "sky_night_up", clear, 1 as u32, true)
    mc_sky.sky_set_time(&s.sky, 6000 as i64, 0)
    s.sky.discs = false
    mc_camera.camera_set_angles(&s.cam, 0.0, 0.0)
    // tint: only pixels the world covered (sky stays), then with fog
    s.sky.tr = 200
    s.sky.tg = 220
    s.sky.tb = 256
    scene(&s, "world+sky+tint", clear, (1 | 2 | 8) as u32, true)
    set_fog(&s, true)
    scene(&s, "world+sky+fog+tint", clear, (1 | 2 | 4 | 8) as u32, true)
    scene(&s, "world+sky+fog+tint+hud", clear, (1 | 2 | 4 | 8 | 16) as u32, true)
    set_fog(&s, false)
    scene(&s, "hud", clear, 16 as u32, true)
    // entities: three boxes on the clear colour, with sky + fog, and a wall that hides one box plus a box behind the camera
    scene(&s, "entities", clear, 32 as u32, true)
    set_fog(&s, true)
    scene(&s, "entities+fog", clear, (1 | 4 | 32) as u32, true)
    scene_bright(&s, "emissive+fog", clear, (1 | 4 | 128) as u32, true, 50 as u64)
    set_fog(&s, false)
    scene(&s, "entities+wall+world", clear, (2 | 32 | 64) as u32, true)
    s.sky.tr = 256
    s.sky.tg = 256
    s.sky.tb = 256
    scene(&s, "everything", clear, (1 | 2 | 8 | 16 | 32) as u32, true)
    time_frames(&s, "everything", clear, (1 | 2 | 8 | 16 | 32) as u32)
    time_frames(&s, "world_only", clear, 2 as u32)
    s.sky.tr = 256
    s.sky.tg = 256
    s.sky.tb = 256
    vk_mc.vkbe_close(&s.gb)
    if s.fails != 0 {
        io.fmt_print(f"RESULT vkscene: FAIL ({s.fails})\n")
        return 3
    }
    io.print("RESULT vkscene: ok\n")
    return 0
}
