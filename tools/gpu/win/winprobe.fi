// tools/gpu/win/winprobe.fi -- GL 3.3 core WINDOW (lib/gpu/glwindow.fi) on X11: open, clear, read back the window
// framebuffer, swap, swap interval, resize, ms/frame. usage: winprobe egl|glx
import std.rt
import std.io
import std.time
import gpu.gl33
import gpu.glctx
import gpu.glwindow
import window.window

fn main(start: u64) -> i32 {
    var o: glwindow.Opts = glwindow.opts_default()
    o.vsync = 0
    if rt.arg_count(start) >= 2 {
        if rt.ld8(rt.arg_ptr(start, 1), 0) == 103 as u8 { o.api = glwindow.API_GLX } else { o.api = glwindow.API_EGL }
    }
    var g: glwindow.GlWin = glwindow.glwindow_new()
    let t0: u64 = time.monotonic_ns()
    if !glwindow.open(&g, 320, 180, "glwin probe", o) {
        io.fmt_print(f"open failed step={g.step}\n")
        return 10 + g.step
    }
    let t1: u64 = time.monotonic_ns()
    var gl: gl33.Gl = gl33.gl_new()
    if !gl33.gl_load(&g.ctx, &gl) { io.print("gl_load failed\n"); return 20 }
    io.print("api=")
    io.print(glwindow.api_name(&g))
    io.print(" renderer=")
    io.print_c(gl33.gl_string(&gl, gl33.GL_RENDERER))
    io.fmt_print(f" open_ms={(t1 - t0) / 1000000} dpi={glwindow.dpi(&g)}\n")
    var sw: i32 = 0
    var sh: i32 = 0
    glwindow.surface_size(&g, &sw, &sh)
    io.fmt_print(f"size window={g.w}x{g.h} surface={sw}x{sh}\n")
    var fails: i32 = 0
    // clear + read back from the window framebuffer
    gl33.gl_clear_color(&gl, 1.0, 0.0, 1.0, 1.0)
    gl33.gl_clear(&gl, gl33.GL_COLOR_BUFFER_BIT)
    var px: [u8; 4] = [0; 4]
    gl33.gl_read_rgba(&gl, 5, 5, 1, 1, (&px[0]) as u64)
    io.fmt_print(f"px={px[0]} {px[1]} {px[2]} {px[3]}\n")
    if px[0] != 255 as u8 || px[1] != 0 as u8 || px[2] != 255 as u8 { fails = fails + 1 }
    io.fmt_print(f"swap={glwindow.swap(&g)}\n")
    // swap interval
    let i0: i32 = glwindow.swap_interval(&g, 0)
    let i1: i32 = glwindow.swap_interval(&g, 1)
    let im: i32 = glwindow.swap_interval(&g, 0 - 1)
    io.fmt_print(f"interval set0={i0} set1={i1} set-1={im}\n")
    // resize
    let okr: bool = glwindow.resize(&g, 400, 240, 2000)
    glwindow.surface_size(&g, &sw, &sh)
    gl33.gl_clear_color(&gl, 0.0, 1.0, 0.0, 1.0)
    gl33.gl_clear(&gl, gl33.GL_COLOR_BUFFER_BIT)
    gl33.gl_read_rgba(&gl, 399, 239, 1, 1, (&px[0]) as u64)
    io.fmt_print(f"resize ok={okr} window={g.w}x{g.h} surface={sw}x{sh} corner={px[0]} {px[1]} {px[2]}\n")
    if !okr || px[1] != 255 as u8 { fails = fails + 1 }
    // full screen request (no window manager under the gate: the window is sized over the screen by hand)
    var scw: usize = 0
    var sch: usize = 0
    window.screen(&g.win, &scw, &sch)
    let okf: bool = glwindow.set_fullscreen(&g, true)
    var wt: i32 = 0
    while (g.w != (scw as i32) || g.h != (sch as i32)) && wt < 2000 {
        glwindow.pump(&g, 20)
        wt = wt + 20
    }
    glwindow.resize_done(&g)
    io.fmt_print(f"fullscreen request={okf} is={glwindow.is_fullscreen(&g)} window={g.w}x{g.h} screen={scw}x{sch}\n")
    if !okf || g.w != (scw as i32) || g.h != (sch as i32) { fails = fails + 1 }
    glwindow.set_fullscreen(&g, false)
    wt = 0
    while (g.w != 400 || g.h != 240) && wt < 2000 {
        glwindow.pump(&g, 20)
        wt = wt + 20
    }
    glwindow.resize_done(&g)
    io.fmt_print(f"fullscreen off is={glwindow.is_fullscreen(&g)} window={g.w}x{g.h}\n")
    if g.w != 400 || g.h != 240 { fails = fails + 1 }
    // ms/frame with and without vsync
    var k: i32 = 0
    while k < 2 {
        glwindow.swap_interval(&g, k)
        let a: u64 = time.monotonic_ns()
        var f: i32 = 0
        while f < 100 {
            gl33.gl_clear_color(&gl, 0.1, 0.2, 0.3, 1.0)
            gl33.gl_clear(&gl, gl33.GL_COLOR_BUFFER_BIT)
            glwindow.swap(&g)
            f = f + 1
        }
        let b: u64 = time.monotonic_ns()
        glwindow.pump(&g, 0)
        io.fmt_print(f"metric swap interval={k} us_per_frame={(b - a) / 100000}\n")
        k = k + 1
    }
    glwindow.close(&g)
    io.fmt_print(f"RESULT fails={fails}\n")
    return fails
}
