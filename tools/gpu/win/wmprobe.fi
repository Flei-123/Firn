// tools/gpu/win/wmprobe.fi -- a GL window (lib/gpu/glwindow.fi) under a REAL EWMH window manager (run.sh starts openbox):
// _NET_WM_STATE_FULLSCREEN on / off and the focus events (EV_FOCUS, window.raw_input).
//
//     wmprobe main    the window under test: waits for the first FocusIn, goes full screen (prints FS_HOLD, stays 1.5 s so run.sh
//                     can ask xprop / xwininfo), back to windowed, then counts FocusIn / FocusOut for 6 s (FOCUS_READY)
//     wmprobe other   a second window that only exists for 8 s (run.sh moves the focus to it and back)
import std.rt
import std.io
import gpu.glwindow
import window.window

struct Counts {
    fin: i32,
    fout: i32,
    conf: i32,
}

// Pumps the events for `ms` and counts the focus changes and EV_CONFIGUREs (the glwindow state follows by itself).
fn spin(g: *mut glwindow.GlWin, c: *mut Counts, ms: i64) {
    var waited: i64 = 0
    while waited < ms {
        window.wait_event(&(*g).win, 20)
        var k: u32 = window.next_event(&(*g).win)
        while k != window.EV_NONE {
            if k == window.EV_FOCUS {
                if window.ev_a(&(*g).win) == 1 as u32 { (*c).fin = (*c).fin + 1 } else { (*c).fout = (*c).fout + 1 }
            }
            if k == window.EV_CONFIGURE {
                (*g).w = window.width(&(*g).win) as i32
                (*g).h = window.height(&(*g).win) as i32
                (*c).conf = (*c).conf + 1
            }
            k = window.next_event(&(*g).win)
        }
        waited = waited + 20
    }
}

fn main(start: u64) -> i32 {
    var other: bool = false
    if rt.arg_count(start) >= 2 && rt.ld8(rt.arg_ptr(start, 1), 0) == 111 as u8 {
        other = true
    }
    var o: glwindow.Opts = glwindow.opts_default()
    o.vsync = 0
    o.api = glwindow.API_EGL
    var g: glwindow.GlWin = glwindow.glwindow_new()
    var t: str = "wmprobe"
    if other { t = "wmprobe-other" }
    if !glwindow.open(&g, 320, 200, t, o) {
        io.fmt_print(f"open failed step={g.step}\n")
        return 10 + g.step
    }
    let rk: bool = window.raw_input(&g.win, true)
    var c: Counts = Counts { fin: 0, fout: 0, conf: 0 }
    var fails: i32 = 0
    if other {
        spin(&g, &c, 8000)
        glwindow.close(&g)
        return 0
    }
    io.fmt_print(f"raw_input={rk}\n")
    // the window manager maps and focuses the new window
    spin(&g, &c, 1500)
    io.fmt_print(f"start window={g.w}x{g.h} focus_in={c.fin} focus_out={c.fout}\n")
    // (the WM focuses the window while open() maps it, i.e. BEFORE raw_input could be switched on: run.sh asks the X server instead)
    var scw: usize = 0
    var sch: usize = 0
    window.screen(&g.win, &scw, &sch)
    let okf: bool = glwindow.set_fullscreen(&g, true)
    var wt: i64 = 0
    while (g.w != (scw as i32) || g.h != (sch as i32)) && wt < 3000 {
        spin(&g, &c, 20)
        wt = wt + 20
    }
    glwindow.resize_done(&g)
    let fs_on: bool = glwindow.is_fullscreen(&g)
    io.fmt_print(f"fullscreen on request={okf} is={fs_on} window={g.w}x{g.h} screen={scw}x{sch} after_ms={wt}\n")
    if !okf || !fs_on || g.w != (scw as i32) || g.h != (sch as i32) { fails = fails + 1 }
    io.print("FS_HOLD\n")
    spin(&g, &c, 1500)
    // a GL frame in full screen: the surface follows the size
    var sw: i32 = 0
    var sh: i32 = 0
    glwindow.surface_size(&g, &sw, &sh)
    io.fmt_print(f"fullscreen surface={sw}x{sh}\n")
    glwindow.set_fullscreen(&g, false)
    wt = 0
    while (g.w == (scw as i32) && g.h == (sch as i32)) && wt < 3000 {
        spin(&g, &c, 20)
        wt = wt + 20
    }
    glwindow.resize_done(&g)
    let fs_off: bool = glwindow.is_fullscreen(&g)
    io.fmt_print(f"fullscreen off is={fs_off} window={g.w}x{g.h} after_ms={wt}\n")
    if fs_off || g.w == (scw as i32) { fails = fails + 1 }
    io.print("FS_OFF\n")
    // focus phase: run.sh moves the focus to the other window and back
    let f0: i32 = c.fin
    let o0: i32 = c.fout
    io.print("FOCUS_READY\n")
    spin(&g, &c, 6000)
    io.fmt_print(f"focus changes in={c.fin - f0} out={c.fout - o0}\n")
    if c.fout - o0 < 1 || c.fin - f0 < 1 { fails = fails + 1 }
    glwindow.close(&g)
    io.fmt_print(f"RESULT fails={fails}\n")
    return fails
}
