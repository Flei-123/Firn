// tools/cliphist/check_main.fi -- lib/std/cliphist.fi against the Python model (tools/cliphist/model.py).
//
//     check_main <ops file> <result file>
//
// Runs the operation list on a History and writes the final state: one "E ..." line per entry in display order and
// "F <hex of the file image>". `model.py cmp` compares that with what the model expects.
import std.rt
import std.str
import std.fs
import std.cliphist

fn push(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn hexch(v: u32) -> u8 {
    if v < 10 {
        return (48 + v) as u8
    }
    return (87 + v) as u8
}

fn push_hex(b: *mut rt.Buf, p: u64, n: usize) {
    if n == 0 {
        rt.buf_push(b, 45 as u8)
        return
    }
    var i: usize = 0
    while i < n {
        let c: u32 = rt.ld8(p, i) as u32
        rt.buf_push(b, hexch(c >> 4))
        rt.buf_push(b, hexch(c & 15))
        i += 1
    }
}

fn unhex_c(c: u8) -> u32 {
    if c >= 97 as u8 {
        return (c - 87 as u8) as u32
    }
    return (c - 48 as u8) as u32
}

fn unhex_into(s: str, out: *mut rt.Buf) {
    if s.n == 1 && s.chars(0) == 45 as u8 {
        return
    }
    var i: usize = 0
    while i + 1 < s.n {
        rt.buf_push(out, (unhex_c(s.chars(i)) * 16 + unhex_c(s.chars(i + 1))) as u8)
        i += 2
    }
}

fn num(s: str) -> i64 {
    var v: i64 = 0
    var i: usize = 0
    while i < s.n {
        v = v * 10 + (s.chars(i) - 48 as u8) as i64
        i += 1
    }
    return v
}

// the i-th space separated word of a line
fn word(line: str, k: usize) -> str {
    var at: usize = 0
    var w: usize = 0
    while at <= line.n {
        var e: usize = at
        while e < line.n && line.chars(e) != 32 as u8 {
            e += 1
        }
        if w == k {
            return str { p: (line.p as u64 + at as u64) as *mut u8, n: e - at }
        }
        w += 1
        at = e + 1
    }
    return ""
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    let a1: u64 = rt.arg_ptr(start, 1)
    let a2: u64 = rt.arg_ptr(start, 2)
    var data: rt.Buf = rt.buf_new()
    fs.read_file(str { p: a1 as *mut u8, n: rt.c_length(a1) }, &data) catch 0
    var h: cliphist.History = cliphist.hist_new()
    let total: usize = rt.buf_len(&data)
    let base: u64 = rt.buf_ptr(&data)
    var at: usize = 0
    while at < total {
        var e: usize = at
        while e < total && rt.ld8(base, e) != 10 as u8 {
            e += 1
        }
        let line: str = str { p: (base + at as u64) as *mut u8, n: e - at }
        at = e + 1
        if line.n < 1 {
            continue
        }
        let op: u8 = line.chars(0)
        if op == 65 as u8 { // A
            var t: rt.Buf = rt.buf_new()
            var m: rt.Buf = rt.buf_new()
            unhex_into(word(line, 1), &t)
            unhex_into(word(line, 2), &m)
            cliphist.add_raw(&h, rt.buf_ptr(&t), rt.buf_len(&t), rt.buf_ptr(&m), rt.buf_len(&m), 0, 0,
                num(word(line, 3)) == 1, num(word(line, 4)))
            rt.buf_free(&t)
            rt.buf_free(&m)
        } else if op == 80 as u8 { // P
            let i: usize = cliphist.view_index(&h, num(word(line, 1)) as usize)
            if i != 0xFFFFFFFF as usize {
                cliphist.pin(&h, cliphist.id_of(&h, i), !cliphist.is_pinned(&h, i))
            }
        } else if op == 68 as u8 { // D
            let i2: usize = cliphist.view_index(&h, num(word(line, 1)) as usize)
            if i2 != 0xFFFFFFFF as usize {
                cliphist.remove(&h, cliphist.id_of(&h, i2))
            }
        } else if op == 67 as u8 { // C
            cliphist.clear(&h, num(word(line, 1)) == 1)
        } else if op == 88 as u8 { // X
            cliphist.expire(&h, num(word(line, 1)))
        } else if op == 76 as u8 { // L
            cliphist.set_limit(&h, num(word(line, 1)) as usize)
        } else if op == 83 as u8 { // S
            cliphist.set_sensitive_ttl(&h, num(word(line, 1)))
        } else if op == 77 as u8 { // M
            cliphist.set_max_entry(&h, num(word(line, 1)) as usize)
        }
    }
    var out: rt.Buf = rt.buf_new()
    var k: usize = 0
    while k < cliphist.count(&h) {
        let i3: usize = cliphist.view_index(&h, k)
        push(&out, "E ")
        if cliphist.is_pinned(&h, i3) {
            push(&out, "1 ")
        } else {
            push(&out, "0 ")
        }
        if cliphist.is_sensitive(&h, i3) {
            push(&out, "1 ")
        } else {
            push(&out, "0 ")
        }
        rt.buf_push_dec_i64(&out, cliphist.time_of(&h, i3))
        rt.buf_push(&out, 32 as u8)
        let tx: str = cliphist.text_of(&h, i3)
        push_hex(&out, tx.p as u64, tx.n)
        rt.buf_push(&out, 32 as u8)
        let hm: str = cliphist.html_of(&h, i3)
        push_hex(&out, hm.p as u64, hm.n)
        rt.buf_push(&out, 10 as u8)
        k += 1
    }
    var img: rt.Buf = rt.buf_new()
    cliphist.serialize(&h, &img)
    push(&out, "F ")
    push_hex(&out, rt.buf_ptr(&img), rt.buf_len(&img))
    rt.buf_push(&out, 10 as u8)
    let wr: usize = fs.write_file(str { p: rt.arg_ptr(start, 2) as *mut u8, n: rt.c_length(a2) }, rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    cliphist.hist_free(&h)
    rt.buf_free(&data)
    rt.buf_free(&out)
    rt.buf_free(&img)
    return 0
}
