// tools/vdso/clock_bench.fi -- ns per clock read: the old way (a real system
// call 228, what std.time did before std.vdso) against time.monotonic_ns().
// Build and run:  firnc tools/vdso/clock_bench.fi -o /tmp/cb && /tmp/cb
import std.rt
import std.io
import std.time
import std.vdso

fn dec(v: i64) -> str {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    let s: str = __str_copy(str { p: b.ptr as *mut u8, n: b.len })
    rt.buf_free(&b)
    return s
}

fn raw_ns() -> u64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return (ts[0] * 1000000000 + ts[1]) as u64
}

fn report(name: str, n: u64, t0: u64, t1: u64, sink: u64) {
    io.println_str(name + ": " + dec(((t1 - t0) * 10 / n) as i64) + " (x0.1 ns per call), sink " + dec((sink & 1) as i64))
}

fn main() -> i32 {
    let n: u64 = 2000000
    if vdso.active() { io.println_str("vdso active: yes") } else { io.println_str("vdso active: no") }
    var sink: u64 = 0
    var i: u64 = 0
    let a0: u64 = raw_ns()
    while i < n {
        sink = sink ^ raw_ns()
        i = i + 1
    }
    let a1: u64 = raw_ns()
    report("syscall    ", n, a0, a1, sink)
    i = 0
    let b0: u64 = raw_ns()
    while i < n {
        sink = sink ^ time.monotonic_ns()
        i = i + 1
    }
    let b1: u64 = raw_ns()
    report("monotonic_ns", n, b0, b1, sink)
    return 0 as i32
}
