// tools/soup_cross/soup_cli.fi -- html.soup driver for the cross check against bs4+html5lib+soupsieve.
// stdin records:  D <n>\n<n bytes>\n   parse a page
//                 S <n>\n<n bytes>\n   run a selector on the current page
// stdout per S:   R <count>\n then one line per hit: tag TAB id TAB href TAB text (escaped: \\ \n \t \r)
import std.rt
import std.io
import html.soup

fn num_at(b: *mut rt.Buf, i: *mut usize) -> usize {
    var v: usize = 0
    while *i < rt.buf_len(b) && rt.buf_at(b, *i) >= 48 as u8 && rt.buf_at(b, *i) <= 57 as u8 {
        v = v * 10 + (rt.buf_at(b, *i) - 48 as u8) as usize
        *i = *i + 1
    }
    return v
}

fn put_esc(out: *mut rt.Buf, s: str) {
    var i: usize = 0
    while i < s.n {
        let c: u8 = *(s.p + i)
        if c == 92 as u8 {
            rt.buf_push(out, 92 as u8)
            rt.buf_push(out, 92 as u8)
        } else if c == 10 as u8 {
            rt.buf_push(out, 92 as u8)
            rt.buf_push(out, 110 as u8)
        } else if c == 9 as u8 {
            rt.buf_push(out, 92 as u8)
            rt.buf_push(out, 116 as u8)
        } else if c == 13 as u8 {
            rt.buf_push(out, 92 as u8)
            rt.buf_push(out, 114 as u8)
        } else {
            rt.buf_push(out, c)
        }
        i = i + 1
    }
}

fn main() -> i32 {
    var inp: rt.Buf = rt.buf_new()
    rt.read_stdin(&inp)
    var out: rt.Buf = rt.buf_new()
    var d: soup.Doc = soup.doc_new()
    var i: usize = 0
    var parsed: bool = false
    while i + 2 < rt.buf_len(&inp) {
        let kind: u8 = rt.buf_at(&inp, i)
        i = i + 2
        let n: usize = num_at(&inp, &i)
        i = i + 1
        let body: str = str { p: rt.buf_data(&inp) + i, n: n }
        i = i + n + 1
        if kind == 68 as u8 {
            parsed = soup.parse(&d, body)
            continue
        }
        let hits: soup.Hits = soup.select(&d, body)
        rt.buf_push(&out, 82 as u8)
        rt.buf_push(&out, 32 as u8)
        rt.buf_push_dec_u64(&out, soup.count(hits) as u64)
        rt.buf_push(&out, 10 as u8)
        var k: usize = 0
        while k < soup.count(hits) {
            let e: soup.El = soup.at(hits, k)
            put_esc(&out, soup.name(&d, e))
            rt.buf_push(&out, 9 as u8)
            put_esc(&out, soup.attr(&d, e, "id"))
            rt.buf_push(&out, 9 as u8)
            put_esc(&out, soup.attr(&d, e, "href"))
            rt.buf_push(&out, 9 as u8)
            put_esc(&out, soup.text(&d, e))
            rt.buf_push(&out, 10 as u8)
            k = k + 1
        }
    }
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    soup.doc_free(&d)
    return 0
}
