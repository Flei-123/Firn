// Frames with odd-sized byte locals: the save slots of the callee-saved
// registers must stay 8-aligned (r476/r477, checked by tools/frame/check.sh).
#[no_inline]
fn touch(p: u64) {
    *(p as *mut u8) = 7 as u8
}

fn f1(a: u64, b: u64, c: u64, d: u64, e: u64) -> u64 {
    var odd: [u8; 1] = [0; 1]
    touch((&odd) as u64)
    let x1: u64 = a * 3 + 1
    let x2: u64 = b * 5 + 2
    let x3: u64 = c * 7 + 3
    let x4: u64 = d * 11 + 4
    let x5: u64 = e * 13 + 5
    touch((&odd) as u64)
    return x1 + x2 + x3 + x4 + x5 + odd[0] as u64
}

fn f3(a: u64, b: u64, c: u64, d: u64, e: u64) -> u64 {
    var odd: [u8; 3] = [0; 3]
    touch((&odd) as u64)
    let x1: u64 = a * 3 + 1
    let x2: u64 = b * 5 + 2
    let x3: u64 = c * 7 + 3
    let x4: u64 = d * 11 + 4
    let x5: u64 = e * 13 + 5
    touch((&odd) as u64)
    return x1 + x2 + x3 + x4 + x5 + odd[2] as u64
}

fn f5(a: u64, b: u64, c: u64, d: u64, e: u64) -> u64 {
    var odd: [u8; 5] = [0; 5]
    touch((&odd) as u64)
    let x1: u64 = a * 3 + 1
    let x2: u64 = b * 5 + 2
    let x3: u64 = c * 7 + 3
    let x4: u64 = d * 11 + 4
    let x5: u64 = e * 13 + 5
    touch((&odd) as u64)
    return x1 + x2 + x3 + x4 + x5 + odd[4] as u64
}

fn f7(a: u64, b: u64, c: u64, d: u64, e: u64) -> u64 {
    var odd: [u8; 7] = [0; 7]
    var odd2: [u8; 2] = [0; 2]
    touch((&odd) as u64)
    touch((&odd2) as u64)
    let x1: u64 = a * 3 + 1
    let x2: u64 = b * 5 + 2
    let x3: u64 = c * 7 + 3
    let x4: u64 = d * 11 + 4
    let x5: u64 = e * 13 + 5
    touch((&odd) as u64)
    return x1 + x2 + x3 + x4 + x5 + odd[6] as u64 + odd2[1] as u64
}

fn main() -> i32 {
    let s: u64 = f1(1, 2, 3, 4, 5) + f3(1, 2, 3, 4, 5) + f5(1, 2, 3, 4, 5) + f7(1, 2, 3, 4, 5)
    if s == 0 {
        return 1
    }
    return 0
}
