// SPDX-License-Identifier: GPL-2.0-only
// tools/gc_soak/soak.fi -- ACCEPTANCE ITEM 2, the long half:
// THE ENDURANCE RUN WITH CHANGING OBJECT SIZES.
//
// `tools/dom_soak/run.sh` builds the same set of objects over and over
// (every allocation lands in the same size class, 116 s) and
// `tools/gc_frag/run.sh` changes the sizes but runs for 15 to 40 minutes.
// `ACCEPTANCE.md` item 2 asks for two things that neither of them gives:
// a run of 24 HOURS, and fragmentation with CHANGING object sizes in the
// same run.
//
// This program is the two together. It keeps the load of
// `tools/gc_frag/frag.fi` -- five phases whose object sizes wander through
// the size classes of the allocator -- and adds
//
//   * a sixth phase, the WAVE: for WAVE_MAX rounds nothing is released,
//     then the whole wave is dropped in ONE step. That is the shape a
//     browser tab has (build a document, throw it away) and it is the case
//     in which a non-moving collector has to give whole chunks back to the
//     kernel, not merely single blocks;
//   * sampling BY TIME instead of by rounds, so that a run of a day
//     produces a few thousand lines instead of a few hundred million;
//   * the longest pause PER WINDOW (`gc_pause_reset`, round 95) next to
//     the maximum over the whole run. One outlier during the warm-up
//     otherwise hides everything that comes after it, and the question
//     "do the pauses get longer as the hours go by?" cannot be answered
//     from a monotone maximum at all.
//
// The phases (PHASE_ROUNDS rounds each, then the next one):
//
//   phase 0   tiny        1 .. 8 words         classes 0-2
//   phase 1   large       512 .. 1,535 words   the large object path
//   phase 2   mixed       1 .. 2,048 words     everything at once
//   phase 3   powers      1, 2, 4, ... 2,048   every class in turn
//   phase 4   medium      4 .. 67 words        classes 2-6
//   phase 5   wave        4 .. 195 words       kept, then dropped at once
//
// MODE decides what happens with a new object:
//   0  replace -- the working set stays at SLOTS objects (plus the wave).
//      The heap MUST stay bounded; that is the claim under test.
//   1  keep    -- nothing is ever overwritten. The heap MUST grow. Without
//      this counter-check the flat curve of mode 0 would prove nothing.
//
// The output is TSV on standard output, one line per SAMPLE_MS
// milliseconds; `tools/gc_soak/run.sh` evaluates it and
// `tools/gc_soak/longrun/` keeps the raw data.
//
// The four constants stand here verbatim so that run.sh can rewrite them
// with `sed` into a working copy -- the same trick as tools/gc_frag/run.sh.

import dom.meas

const BUDGET_MS: i64 = 86400000 // SOAK_BUDGET_MS
const ROUNDS_MAX: i64 = 1000000000000 // SOAK_ROUNDS_MAX
const SAMPLE_MS: i64 = 10000 // SOAK_SAMPLE_MS
const MODE: i64 = 0 // SOAK_MODE

// How many vectors stay alive at the same time, how long a phase lasts and
// how big a wave gets before it is dropped.
const SLOTS: u64 = 384
const PHASE_ROUNDS: u64 = 4000
const PHASES: u64 = 6
const WAVE_MAX: u64 = 1000
// How often the clock is asked. The sample itself is TIME driven, but the
// counter-check (mode 1) gets so slow towards the end that a gate of 1,024
// rounds produced seven data lines in half a minute -- too few to judge.
// A clock call every 64 rounds costs nothing next to an allocation.
const CHECK_EVERY: u64 = 64

// ------------------------------------------------------------ pseudo random
// xorshift64, so that the sequence is the same on every machine and the
// measurement is repeatable. No `rand`, no clock, no /dev/urandom.
fn next_random(s: u64) -> u64 {
    var x: u64 = s
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    return x
}

// The number of words the vector of this round gets.
fn size_for(phase: u64, r: u64) -> u64 {
    if phase == 0 {
        return 1 + r % 8
    }
    if phase == 1 {
        return 512 + r % 1024
    }
    if phase == 2 {
        return 1 + r % 2048
    }
    if phase == 3 {
        var n: u64 = 1
        var k: u64 = r % 12
        while k > 0 {
            n = n * 2
            k = k - 1
        }
        return n
    }
    if phase == 5 {
        return 4 + r % 192
    }
    return 4 + r % 64
}

// Wipe the dead stack area below this frame. The scan is CONSERVATIVE
// (SPEC 3.5.3): old pointers still stand in frames that have been left, and
// every one of them keeps a whole vector plus its buffer alive. Without this
// the measurement would report a leak that is a measuring artefact.
fn scrub() {
    var buffer: [u64; 512] = [0; 512]
    let p: u64 = (&buffer) as u64
    var i: u64 = 0
    while i < 512 {
        *((p + i * 8) as *mut u64) = 0
        i = i + 1
    }
}

fn head() {
    var t: [u8; 55] = "# firn-gc-soak v1 mode=0 (0=replace, 1=keep/must grow)\n"
    let p: u64 = (&t) as u64
    // The mode really stands in the line -- otherwise the two files could be
    // mixed up during the evaluation.
    *((p + 23) as *mut u8) = 48 + MODE as u8
    meas.meas_write(p, 55)
    var c: [u8; 146] = "# columns: t_ms rounds rss_kib live heap_bytes live_bytes collections pause_win_ns mark_win_ns sweep_win_ns stop_win_ns full_runs overflows asked\n"
    meas.meas_write((&c) as u64, 146)
}

fn line(t_ms: u64, rounds: u64, rss: u64, live: u64, heap: u64, livebytes: u64,
    runs: u64, pause: u64, mark: u64, sweep: u64, stop: u64, full: u64,
    ov: u64, asked: u64) {
    meas.meas_u64(t_ms)
    meas.meas_tab()
    meas.meas_u64(rounds)
    meas.meas_tab()
    meas.meas_u64(rss)
    meas.meas_tab()
    meas.meas_u64(live)
    meas.meas_tab()
    meas.meas_u64(heap)
    meas.meas_tab()
    meas.meas_u64(livebytes)
    meas.meas_tab()
    meas.meas_u64(runs)
    meas.meas_tab()
    meas.meas_u64(pause)
    meas.meas_tab()
    meas.meas_u64(mark)
    meas.meas_tab()
    meas.meas_u64(sweep)
    meas.meas_tab()
    meas.meas_u64(stop)
    meas.meas_tab()
    meas.meas_u64(full)
    meas.meas_tab()
    meas.meas_u64(ov)
    meas.meas_tab()
    meas.meas_u64(asked)
    meas.meas_nl()
}

fn err(code: u64) -> i32 {
    var t: [u8; 13] = "# error code="
    meas.meas_write((&t) as u64, 13)
    meas.meas_u64(code)
    meas.meas_nl()
    return code as i32
}

// One vector of `words` words, really allocated and really zeroed (the
// payload is nulled by the allocator -- so the pages are touched and the RSS
// tells the truth), with up to four words written into it so that the object
// is not merely reserved but used. The working set holds `Cell`s, not
// `GcVec`s directly: `GcVec` is a class of the collector runtime and cannot
// be named as a type argument from outside. One indirection more, and the
// cell is a small object next to a large one -- which suits the point of
// this measurement.
gc class Cell {
    data: Gc[GcVec],
    words: u64,
}

fn make(words: u64) -> AllocError!Gc[Cell] {
    let v: Gc[GcVec] = try gcvec_new_raw()
    let ok: bool = try gcvec_slot(v, words)
    var i: u64 = 0
    var n: u64 = 4
    if words < 4 {
        n = words
    }
    while i < n {
        let a: bool = try gcvec_append_raw(v, 1 + i)
        i = i + 1
    }
    return try gc Cell { data: v, words: words }
}

// The whole run. It returns an error union, so `try` is available -- stage 0
// has no `catch` with a block (SPEC 14.1), and a sentinel value per call
// site would only hide the reason.
fn work() -> AllocError!i32 {
    if !gc_init() {
        return err(2)
    }
    head()
    let rss0: u64 = meas.meas_rss_kib()
    if rss0 == 0 {
        return err(3)
    }
    let t0: u64 = meas.meas_now_ms()

    // The working set. One vector of pointers, filled with SLOTS vectors.
    let set: Gc[GcVec] = try gcvec_new()
    var i: u64 = 0
    while i < SLOTS {
        let v: Gc[Cell] = try make(1 + i % 8)
        let ok: bool = try gcvec_append[Cell](set, v)
        i = i + 1
    }
    // The wave: kept for WAVE_MAX rounds, then dropped in one step.
    var wave: Gc[GcVec] = try gcvec_new()
    var wave_n: u64 = 0

    line(0, 0, meas.meas_rss_kib(), gc_live_objects(), gc_heap_bytes(),
        gc_live_bytes(), gc_collections(), gc_pause_ns_max(),
        gc_pause_max_ty(1), gc_pause_max_ty(2), gc_stop_max(),
        gc_full_runs(), gc_overflows(), 0)
    gc_pause_reset()

    var rounds: u64 = 0
    var seed: u64 = 88172645463325252
    var asked: u64 = 0
    var t: u64 = 0
    var next_line: u64 = SAMPLE_MS as u64
    var pause_all: u64 = 0
    var stop_all: u64 = 0
    var mark_all: u64 = 0
    var sweep_all: u64 = 0
    var run: bool = true
    while run {
        seed = next_random(seed)
        let phase: u64 = rounds / PHASE_ROUNDS % PHASES
        let words: u64 = size_for(phase, seed)
        asked = asked + words * 8
        let v: Gc[Cell] = try make(words)
        if MODE == 1 {
            let ok: bool = try gcvec_append[Cell](set, v)
        } else if phase == 5 {
            let ok: bool = try gcvec_append[Cell](wave, v)
            wave_n = wave_n + 1
            if wave_n >= WAVE_MAX {
                // The whole wave dies at once. This is the case in which
                // whole chunks become free, not single blocks.
                wave = try gcvec_new()
                wave_n = 0
            }
        } else {
            let slot: u64 = seed % SLOTS
            let ok: bool = gcvec_set[Cell](set, slot, v)
            if !ok {
                return err(8)
            }
        }
        rounds = rounds + 1
        if rounds % CHECK_EVERY == 0 {
            t = meas.meas_now_ms() - t0
            if t >= next_line {
                scrub()
                let rss: u64 = meas.meas_rss_kib()
                if rss == 0 {
                    return err(10)
                }
                let pw: u64 = gc_pause_ns_max()
                let mw: u64 = gc_pause_max_ty(1)
                let sw: u64 = gc_pause_max_ty(2)
                let stw: u64 = gc_stop_max()
                if pw > pause_all {
                    pause_all = pw
                }
                if mw > mark_all {
                    mark_all = mw
                }
                if sw > sweep_all {
                    sweep_all = sw
                }
                if stw > stop_all {
                    stop_all = stw
                }
                line(t, rounds, rss, gc_live_objects(), gc_heap_bytes(),
                    gc_live_bytes(), gc_collections(), pw, mw, sw, stw,
                    gc_full_runs(), gc_overflows(), asked)
                gc_pause_reset()
                next_line = t + SAMPLE_MS as u64
                if t >= BUDGET_MS as u64 || rounds >= ROUNDS_MAX as u64 {
                    run = false
                }
            }
        }
    }

    var d: [u8; 14] = "# done rounds="
    meas.meas_write((&d) as u64, 14)
    meas.meas_u64(rounds)
    var d2: [u8; 6] = " t_ms="
    meas.meas_write((&d2) as u64, 6)
    meas.meas_u64(t)
    var d3: [u8; 7] = " asked="
    meas.meas_write((&d3) as u64, 7)
    meas.meas_u64(asked)
    var d4: [u8; 9] = " rss_kib="
    meas.meas_write((&d4) as u64, 9)
    meas.meas_u64(meas.meas_rss_kib())
    var d5: [u8; 5] = " len="
    meas.meas_write((&d5) as u64, 5)
    meas.meas_u64(gcvec_length(set))
    var d6: [u8; 11] = " pause_max="
    meas.meas_write((&d6) as u64, 11)
    meas.meas_u64(pause_all)
    var d7: [u8; 10] = " stop_max="
    meas.meas_write((&d7) as u64, 10)
    meas.meas_u64(stop_all)
    var d8: [u8; 10] = " mark_max="
    meas.meas_write((&d8) as u64, 10)
    meas.meas_u64(mark_all)
    var d9: [u8; 11] = " sweep_max="
    meas.meas_write((&d9) as u64, 11)
    meas.meas_u64(sweep_all)
    var da: [u8; 13] = " collections="
    meas.meas_write((&da) as u64, 13)
    meas.meas_u64(gc_collections())
    meas.meas_nl()
    return 0
}

fn main() -> i32 {
    // 11 = the memory ran out -- it is a result too, and it says so.
    return work() catch 11
}
