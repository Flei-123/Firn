import std.rt

static mut G_ON: u32 = 1
static mut G_SINK: u64 = 0

#[no_inline]
fn noise(x: u64) -> u64 {
    G_SINK = G_SINK + x
    return G_SINK
}

#[inline]
fn ok(w: u32) -> bool {
    return G_ON != (0 as u32) && (w >> 24) == (1 as u32) && (w & 0xFF) <= (4 as u32)
}

#[no_inline]
fn work(w: u32) -> u64 {
    var acc: u64 = 0
    let baked: bool = ok(w)
    if baked {
        acc = acc + noise(1)
    }
    acc = acc + noise(2)
    acc = acc + noise(3)
    if baked {
        acc = acc + 1000
    }
    return acc
}

#[no_inline]
fn smash(n: usize) -> u64 {
    var a: [u64; 64] = [0; 64]
    var i: usize = 0
    while i < 64 {
        a[i] = 0xFFFFFFFFFFFFFFFF - (i as u64)
        i = i + 1
    }
    return a[n & 63]
}

fn main() -> i32 {
    var bad: i32 = 0
    var k: u32 = 0
    while k < (16 as u32) {
        let s: u64 = smash(k as usize)
        let r: u64 = work(k)
        if r >= 1000 && s != 0 {
            bad = bad + 1
        }
        k = k + 1
    }
    return bad
}
