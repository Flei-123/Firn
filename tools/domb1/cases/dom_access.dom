6
0 0 1 1
null
foo
null
en
1
A
null
<svg viewBox="0 0 1 1" xlink:href="foo"><g xml:lang="en"></g></svg>

== the template content is a tree of its own
-- html
<!doctype html><body><template><div id=inside>x</div></template>
-- ask
count
id inside
tag div
inner 3
outer 3
text 3
-- want
4
-1
0
<div id="inside">x</div>
<template><div id="inside">x</div></template>
<empty>
