import std.rt
import media.video.av1.av1dec

fn put_kv(out: *mut rt.Buf, k: str, v: i64) {
    rt.buf_push_bytes(out, k.p as u64, k.n)
    rt.buf_push(out, 61 as u8)
    rt.buf_push_dec_i64(out, v)
    rt.buf_push(out, 10 as u8)
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 64
    }
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &data) {
        return 2
    }
    var out: rt.Buf = rt.buf_new()
    let d: *mut av1dec.Decoder = av1dec.dec_new()
    av1dec.dec_stream(d, &out, data.ptr, rt.buf_len(&data))
    if !rt.write_file(rt.arg_ptr(start, 2), rt.buf_ptr(&out), rt.buf_len(&out)) {
        return 6
    }
    var info: rt.Buf = rt.buf_new()
    put_kv(&info, "frames_out", (*d).frames_out)
    put_kv(&info, "frames_decoded", (*d).frames_decoded)
    put_kv(&info, "postfilter", (*d).postfilter)
    put_kv(&info, "base_q_idx", (*(*d).fh).base_q_idx)
    put_kv(&info, "coded_lossless", (*(*d).fh).coded_lossless)
    put_kv(&info, "lf_level0", (*(*d).fh).loop_filter_level[0])
    put_kv(&info, "lf_level1", (*(*d).fh).loop_filter_level[1])
    put_kv(&info, "tx_mode", (*(*d).fh).tx_mode)
    var p: usize = 0
    while p < 3 {
        var u: i64 = 0
        while u < (*(*d).td).lr_rows[p] * (*(*d).td).lr_cols[p] {
            let t: i64 = (*(((*(*d).td).lr_units[p] + (u * 40) as u64) as *mut u8)) as i64
            put_kv(&info, "lr_unit_type", p as i64 * 100 + t)
            u = u + 1
        }
        p = p + 1
    }
    put_kv(&info, "err", (*d).err)
    put_kv(&info, "err_tile", (*d).err_tile)
    put_kv(&info, "err_mi_row", (*d).err_mi_row)
    put_kv(&info, "err_mi_col", (*d).err_mi_col)
    put_kv(&info, "err_blocks", (*d).err_blocks)
    put_kv(&info, "n_palette", (*(*d).td).n_palette)
    if rt.arg_count(start) >= 4 {
        rt.write_file(rt.arg_ptr(start, 3), rt.buf_ptr(&info), rt.buf_len(&info))
    }
    if (*d).err != 0 {
        return (*d).err as i32
    }
    return 0
}
