import std.rt
import media.demux
import media.video.vp8.vp8dec
import media.video.vp8.vp8state

fn put(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn putn(b: *mut rt.Buf, v: i64) {
    if v < 0 {
        rt.buf_push(b, 45 as u8)
        rt.buf_push_dec_u64(b, (0 - v) as u64)
        return
    }
    rt.buf_push_dec_u64(b, v as u64)
}

fn stats_line(b: *mut rt.Buf, d: *mut vp8state.Vp8) {
    put(b, "key ")
    putn(b, (*d).keyframe as i64)
    put(b, " ver ")
    putn(b, (*d).version)
    put(b, " seg ")
    putn(b, (*d).seg_on)
    put(b, " map ")
    putn(b, (*d).seg_map)
    put(b, " parts ")
    putn(b, (*d).nparts)
    put(b, " simple ")
    putn(b, (*d).lf_simple)
    put(b, " lf ")
    putn(b, (*d).lf_level)
    put(b, " sharp ")
    putn(b, (*d).lf_sharp)
    put(b, " show ")
    putn(b, (*d).show as i64)
    put(b, " gf ")
    putn(b, (*d).refresh_gf)
    put(b, " arf ")
    putn(b, (*d).refresh_arf)
    put(b, " cgf ")
    putn(b, (*d).copy_gf)
    put(b, " carf ")
    putn(b, (*d).copy_arf)
    put(b, " sb ")
    putn(b, (*d).sign_bias[2] * 2 + (*d).sign_bias[3])
    put(b, " ent ")
    putn(b, (*d).refresh_entropy)
    put(b, "\n")
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 64
    }
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &data) {
        return 2
    }
    var dm: demux.Demux = demux.demux_new()
    if demux.demux_open(&dm, data.ptr, rt.buf_len(&data)) != 0 {
        return 3
    }
    let t: i32 = demux.demux_find_track(&dm, demux.TK_VIDEO)
    if t < 0 || demux.demux_track_codec(&dm, t) != demux.CODEC_VP8 {
        return 4
    }
    var dec: vp8state.Vp8 = vp8state.vp8_new()
    var out: rt.Buf = rt.buf_new()
    let n: usize = demux.demux_nsamples(&dm, t)
    var i: usize = 0
    var errs: i32 = 0
    var stats: rt.Buf = rt.buf_new()
    while i < n {
        let rc: i64 = vp8dec.dec_frame(&dec, data.ptr + demux.demux_sample_off(&dm, t, i), demux.demux_sample_size(&dm, t, i) as usize)
        if rt.arg_count(start) >= 4 {
            stats_line(&stats, &dec)
        }
        if rc != vp8dec.DEC_OK {
            errs = errs + 1
        } else {
            if dec.show {
                let sz: usize = vp8dec.dec_yuv_size(&dec)
                let tmp: u64 = rt.heap_alloc(sz) as u64
                vp8dec.dec_copy_yuv420(&dec, tmp)
                rt.buf_push_bytes(&out, tmp, sz)
                rt.heap_free(tmp, sz)
            }
        }
        i = i + 1
    }
    vp8state.vp8_release(&dec)
    if rt.arg_count(start) >= 4 {
        rt.write_file(rt.arg_ptr(start, 3), rt.buf_ptr(&stats), rt.buf_len(&stats))
    }
    let ok: bool = rt.write_file(rt.arg_ptr(start, 2), rt.buf_ptr(&out), rt.buf_len(&out))
    if !ok {
        return 6
    }
    if errs > 90 {
        return 90
    }
    return errs
}
