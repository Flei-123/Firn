import std.rt
import media.video.vidops
import media.video.vidmulti

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 64
    }
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &data) {
        return 2
    }
    let ops: vidops.VideoOps = vidmulti.vmulti_ops()
    let hd: u64 = ops.create()
    if ops.open(hd, data.ptr, rt.buf_len(&data)) != vidops.VO_OK {
        return 3
    }
    let nb: usize = ops.rgba_bytes(hd)
    let fr: u64 = rt.heap_alloc(nb) as u64
    var out: rt.Buf = rt.buf_new()
    var pts: i64 = 0
    var rc: i32 = ops.next_frame(hd, fr, &pts)
    while rc == 1 {
        rt.buf_push_bytes(&out, fr, nb)
        rc = ops.next_frame(hd, fr, &pts)
    }
    ops.close(hd)
    ops.destroy(hd)
    if rc != vidops.VO_END {
        return 4
    }
    if !rt.write_file(rt.arg_ptr(start, 2), rt.buf_ptr(&out), rt.buf_len(&out)) {
        return 6
    }
    return 0
}
