import std.rt
import media.video.vp9.vp9mem
import media.video.av1.av1cdfctx
import media.video.av1.av1cdfidx
import media.video.av1.av1cdfcn
import media.video.av1.av1tabscan
import media.video.av1.av1tabq
import media.video.av1.av1tabqm0
import media.video.av1.av1tabqm1
import media.video.av1.av1tabqm2
import media.video.av1.av1tabtx
import media.video.av1.av1tabfilt
import media.video.av1.av1tabintra

fn block_hash(p: u64, n: usize, signed: bool) -> i64 {
    var sum: i64 = 0
    var i: usize = 0
    while i < n {
        var v: i64 = vp9mem.ld16(p, i)
        if signed {
            v = vp9mem.ldi16(p, i)
        }
        sum = sum + v * ((i % 251) + 1) as i64
        i = i + 1
    }
    return sum
}

fn block_hash8(p: u64, n: usize) -> i64 {
    var sum: i64 = 0
    var i: usize = 0
    while i < n {
        sum = sum + vp9mem.ld8(p, i) * ((i % 251) + 1) as i64
        i = i + 1
    }
    return sum
}

fn block_hash32(p: u64, n: usize) -> i64 {
    var sum: i64 = 0
    var i: usize = 0
    while i < n {
        var v: i64 = vp9mem.ld32(p, i)
        if v >= 2147483648 {
            v = v - 4294967296
        }
        sum = sum + v * ((i % 251) + 1) as i64
        i = i + 1
    }
    return sum
}

fn line(out: *mut rt.Buf, name: str, idx: i64, v: i64) {
    rt.buf_push_bytes(out, name.p as u64, name.n)
    rt.buf_push(out, 32 as u8)
    rt.buf_push_dec_i64(out, idx)
    rt.buf_push(out, 32 as u8)
    rt.buf_push_dec_i64(out, v)
    rt.buf_push(out, 10 as u8)
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 64
    }
    var out: rt.Buf = rt.buf_new()
    let b: u64 = av1cdfctx.cdf_alloc()
    let qs: [i64; 4] = [0, 40, 100, 200]
    var qi: usize = 0
    while qi < 4 {
        av1cdfctx.cdf_init_default(b)
        av1cdfctx.cdf_init_coef(b, qs[qi])
        line(&out, "all_q", qi as i64, block_hash(b, av1cdfidx.CDF_ALL, false))
        qi = qi + 1
    }
    line(&out, "intrabc", 0, vp9mem.ld16(b, av1cdfidx.CDF_INTRABC))
    line(&out, "intrabc1", 0, vp9mem.ld16(b, av1cdfidx.CDF_INTRABC + 1))
    line(&out, "intrabc2", 0, vp9mem.ld16(b, av1cdfidx.CDF_INTRABC + 2))
    line(&out, "mv_joints0", 0, vp9mem.ld16(b, av1cdfidx.CDF_MV_JOINTS + 2))
    line(&out, "mv_joints_ctx1", 0, vp9mem.ld16(b, av1cdfidx.CDF_MV_JOINTS + av1cdfidx.CDF_MV_JOINTS_S0 + 2))
    line(&out, "mv_sign", 0, vp9mem.ld16(b, av1cdfidx.CDF_MV_SIGN))

    let pos: u64 = av1cdfcn.cdf_counter_pos_addr()
    var bad: i64 = 0
    var i: usize = 0
    while i < av1cdfidx.CDF_COUNTERS {
        vp9mem.st16(b, vp9mem.ld32(pos, i) as usize, 9)
        i = i + 1
    }
    av1cdfctx.cdf_init_default(b)
    av1cdfctx.cdf_init_coef(b, 200)
    let before: i64 = block_hash(b, av1cdfidx.CDF_ALL, false)
    i = 0
    while i < av1cdfidx.CDF_COUNTERS {
        vp9mem.st16(b, vp9mem.ld32(pos, i) as usize, 9)
        i = i + 1
    }
    av1cdfctx.cdf_clear_counters(b)
    line(&out, "counters_cleared", 0, block_hash(b, av1cdfidx.CDF_ALL, false) - before)

    var st: av1cdfctx.CdfState = av1cdfctx.cdfs_new()
    av1cdfctx.cdfs_begin_frame(&st, true, 0, 200)
    av1cdfctx.cdfs_begin_tile(&st)
    vp9mem.st16(st.tile, av1cdfidx.CDF_INTRABC, 123)
    vp9mem.st16(st.tile, av1cdfidx.CDF_INTRABC + 2, 17)
    av1cdfctx.cdfs_end_tile(&st, 0, 1)
    av1cdfctx.cdfs_end_tile(&st, 1, 1)
    av1cdfctx.cdfs_end_frame(&st, false)
    line(&out, "state_frame_intrabc", 0, vp9mem.ld16(st.frame, av1cdfidx.CDF_INTRABC))
    line(&out, "state_frame_counter", 0, vp9mem.ld16(st.frame, av1cdfidx.CDF_INTRABC + 2))
    av1cdfctx.cdfs_save_slot(&st, 3)
    av1cdfctx.cdfs_begin_frame(&st, true, 0, 10)
    line(&out, "state_reset", 0, vp9mem.ld16(st.frame, av1cdfidx.CDF_INTRABC))
    let ok: bool = av1cdfctx.cdfs_begin_frame(&st, false, 3, 10)
    var okv: i64 = 0
    if ok {
        okv = 1
    }
    line(&out, "state_load_ok", 0, okv)
    line(&out, "state_loaded", 0, vp9mem.ld16(st.frame, av1cdfidx.CDF_INTRABC))
    var okb: i64 = 0
    if !av1cdfctx.cdfs_begin_frame(&st, false, 5, 10) {
        okb = 1
    }
    line(&out, "state_missing_slot", 0, okb)
    av1cdfctx.cdfs_free(&st)
    av1cdfctx.cdf_free(b)

    var k: i64 = 0
    while k < 3 {
        var t: i64 = 0
        while t < 19 {
            let p: u64 = av1tabscan.scan_addr(k, t)
            line(&out, "scan", k * 100 + t, block_hash(p, 16, false))
            t = t + 1
        }
        k = k + 1
    }
    var tx: i64 = 0
    while tx < 19 {
        var ty: i64 = 0
        while ty < 16 {
            line(&out, "scanfor", tx * 100 + ty, block_hash(av1tabscan.scan_for(tx, ty), 16, false))
            ty = ty + 1
        }
        tx = tx + 1
    }
    var d: i64 = 0
    while d < 3 {
        line(&out, "dcq", d, block_hash(av1tabq.dc_q_addr(d), 256, false))
        line(&out, "acq", d, block_hash(av1tabq.ac_q_addr(d), 256, false))
        d = d + 1
    }
    line(&out, "qm0", 0, block_hash8(av1tabqm0.qm_level0_addr(), 6688))
    line(&out, "qm7", 0, block_hash8(av1tabqm1.qm_level7_addr(), 6688))
    line(&out, "qm14", 0, block_hash8(av1tabqm2.qm_level14_addr(), 6688))
    line(&out, "cospi", 0, block_hash32(av1tabtx.cospi_arr_addr(), 256))
    line(&out, "sinpi", 0, block_hash32(av1tabtx.sinpi_arr_addr(), 20))
    line(&out, "subpel", 0, block_hash(av1tabfilt.subpel_filters_addr(), 768, true))
    line(&out, "ibc_bilinear", 0, block_hash(av1tabfilt.intrabc_bilinear_addr(), 32, true))
    line(&out, "dr_deriv", 0, block_hash(av1tabintra.dr_intra_derivative_addr(), 90, false))
    line(&out, "filter_intra", 0, block_hash(av1tabintra.filter_intra_taps_addr(), 320, true))
    line(&out, "smooth", 0, block_hash8(av1tabintra.smooth_weights_addr(), 124))
    if !rt.write_file(rt.arg_ptr(start, 1), rt.buf_ptr(&out), rt.buf_len(&out)) {
        return 2
    }
    return 0
}
