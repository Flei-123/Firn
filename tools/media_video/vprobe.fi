// SPDX-License-Identifier: MPL-2.0
import std.rt
import media.demux

fn put(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.n)
}

fn putn(b: *mut rt.Buf, v: i64) {
    if v < 0 {
        rt.buf_push(b, 45 as u8)
        rt.buf_push_dec_u64(b, (0 - v) as u64)
        return
    }
    rt.buf_push_dec_u64(b, v as u64)
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 64
    }
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &data) {
        return 2
    }
    var d: demux.Demux = demux.demux_new()
    if demux.demux_open(&d, data.ptr, rt.buf_len(&data)) != 0 {
        return 3
    }
    var out: rt.Buf = rt.buf_new()
    let dump: bool = rt.arg_count(start) >= 3
    put(&out, "fmt ")
    putn(&out, demux.demux_format(&d) as i64)
    put(&out, " dur_us ")
    putn(&out, demux.demux_duration_us(&d))
    put(&out, "\n")
    var t: i32 = 0
    while t < demux.demux_ntracks(&d) {
        put(&out, "track ")
        putn(&out, t as i64)
        put(&out, " kind ")
        putn(&out, demux.demux_track_kind(&d, t) as i64)
        put(&out, " codec ")
        putn(&out, demux.demux_track_codec(&d, t) as i64)
        put(&out, " w ")
        putn(&out, demux.demux_track_width(&d, t) as i64)
        put(&out, " h ")
        putn(&out, demux.demux_track_height(&d, t) as i64)
        put(&out, " hz ")
        putn(&out, demux.demux_track_hz(&d, t) as i64)
        put(&out, " ch ")
        putn(&out, demux.demux_track_channels(&d, t) as i64)
        put(&out, " n ")
        putn(&out, demux.demux_nsamples(&d, t) as i64)
        put(&out, " dur_us ")
        putn(&out, demux.demux_track_duration_us(&d, t))
        put(&out, "\n")
        if dump {
            var i: usize = 0
            while i < demux.demux_nsamples(&d, t) {
                put(&out, "s ")
                putn(&out, t as i64)
                put(&out, " ")
                putn(&out, i as i64)
                put(&out, " ")
                putn(&out, demux.demux_sample_pts_us(&d, t, i))
                put(&out, " ")
                putn(&out, demux.demux_sample_size(&d, t, i) as i64)
                put(&out, " ")
                if demux.demux_sample_sync(&d, t, i) {
                    put(&out, "K")
                } else {
                    put(&out, "-")
                }
                put(&out, "\n")
                i = i + 1
            }
        }
        t = t + 1
    }
    rt.write_everything(1, rt.buf_ptr(&out), rt.buf_len(&out))
    demux.demux_free(&d)
    return 0
}
