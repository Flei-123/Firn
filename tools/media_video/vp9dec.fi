import std.rt
import media.demux
import media.video.vp9.vp9dec
import media.video.vp9.vp9state

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 64
    }
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &data) {
        return 2
    }
    var dm: demux.Demux = demux.demux_new()
    if demux.demux_open(&dm, data.ptr, rt.buf_len(&data)) != 0 {
        return 3
    }
    let t: i32 = demux.demux_find_track(&dm, demux.TK_VIDEO)
    if t < 0 || demux.demux_track_codec(&dm, t) != demux.CODEC_VP9 {
        return 4
    }
    var dec: vp9state.Vp9 = vp9state.vp9_new()
    var out: rt.Buf = rt.buf_new()
    let n: usize = demux.demux_nsamples(&dm, t)
    var i: usize = 0
    var errs: i32 = 0
    var first_rc: i64 = 0
    while i < n {
        let rc: i64 = vp9dec.dec_frame(&dec, data.ptr + demux.demux_sample_off(&dm, t, i), demux.demux_sample_size(&dm, t, i) as usize)
        if rc == vp9dec.DEC_SHOWN {
            let sz: usize = vp9dec.dec_yuv_size(&dec)
            let tmp: u64 = rt.heap_alloc(sz) as u64
            vp9dec.dec_copy_yuv420(&dec, tmp)
            rt.buf_push_bytes(&out, tmp, sz)
            rt.heap_free(tmp, sz)
        } else if rc != vp9dec.DEC_HIDDEN {
            errs = errs + 1
            if first_rc == 0 {
                first_rc = rc
            }
        }
        i = i + 1
    }
    vp9state.vp9_release(&dec)
    if !rt.write_file(rt.arg_ptr(start, 2), rt.buf_ptr(&out), rt.buf_len(&out)) {
        return 6
    }
    if errs > 0 {
        return (0 - first_rc) as i32
    }
    return 0
}
