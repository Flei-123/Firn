// SPDX-License-Identifier: MPL-2.0
import std.rt
import media.demux
import media.video.h264.nal
import media.video.h264.params
import media.video.h264.types

fn write_plane(out: *mut rt.Buf, base: u64, stride: i32, w: i32, h: i32) {
    var y: i32 = 0
    while y < h {
        rt.buf_push_bytes(out, base +% ((y *% stride) as u64), w as usize)
        y = y + 1
    }
}

fn drain(dec: *mut params.H264, out: *mut rt.Buf, count: *mut i32) {
    var f: types.Frame = types.Frame { y: 0, u: 0, v: 0, w: 0, h: 0, stride_y: 0, stride_c: 0, poc: 0 }
    while nal.h264_output(dec, &f) != 0 {
        write_plane(out, f.y, f.stride_y, f.w, f.h)
        write_plane(out, f.u, f.stride_c, (f.w + 1) / 2, (f.h + 1) / 2)
        write_plane(out, f.v, f.stride_c, (f.w + 1) / 2, (f.h + 1) / 2)
        *count = *count + 1
    }
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 64
    }
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &data) {
        return 2
    }
    var dm: demux.Demux = demux.demux_new()
    if demux.demux_open(&dm, data.ptr, rt.buf_len(&data)) != 0 {
        return 3
    }
    let t: i32 = demux.demux_find_track(&dm, demux.TK_VIDEO)
    if t < 0 || demux.demux_track_codec(&dm, t) != demux.CODEC_H264 {
        return 4
    }
    var dec: params.H264 = params.h264_new()
    if nal.h264_config_avcc(&dec, demux.demux_track_cfg(&dm, t), demux.demux_track_cfg_len(&dm, t)) != 0 {
        return 5
    }
    var out: rt.Buf = rt.buf_new()
    var count: i32 = 0
    let n: usize = demux.demux_nsamples(&dm, t)
    var i: usize = 0
    var errs: i32 = 0
    while i < n {
        let rc: i32 = nal.h264_decode(&dec, data.ptr + demux.demux_sample_off(&dm, t, i), demux.demux_sample_size(&dm, t, i) as usize)
        if rc != 0 {
            errs = errs + 1
        }
        drain(&dec, &out, &count)
        i = i + 1
    }
    nal.h264_flush(&dec)
    drain(&dec, &out, &count)
    let ok: bool = rt.write_file(rt.arg_ptr(start, 2), rt.buf_ptr(&out), rt.buf_len(&out))
    if !ok {
        return 6
    }
    return errs
}
