import std.rt
import media.video.vp9.vp9mem
import media.video.av1.av1sym

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 64
    }
    var data: rt.Buf = rt.buf_new()
    if !rt.read_file(rt.arg_ptr(start, 1), &data) {
        return 2
    }
    let p: u64 = data.ptr
    var w: usize = 0
    let nctx: usize = vp9mem.ld16(p, w) as usize
    w = w + 1
    var cdfs: u64 = rt.heap_alloc(nctx * 64)
    var ns: [i64; 64] = [0; 64]
    var i: usize = 0
    while i < nctx {
        let n: i64 = vp9mem.ld16(p, w) as i64
        w = w + 1
        ns[i] = n
        var k: usize = 0
        while (k as i64) <= n {
            vp9mem.st16(cdfs + (i * 64) as u64, k, vp9mem.ld16(p, w))
            w = w + 1
            k = k + 1
        }
        i = i + 1
    }
    let count: usize = vp9mem.ld16(p, w) as usize + 65536 * (vp9mem.ld16(p, w + 1) as usize)
    w = w + 2
    let sym_w: usize = w
    let stream_off: usize = (w + count * 2) * 2
    let stream_len: usize = rt.buf_len(&data) - stream_off
    var s: av1sym.Sym = av1sym.sym_new()
    av1sym.sym_init(&s, p + stream_off as u64, stream_len, true)
    var j: usize = 0
    while j < count {
        let ctx: usize = vp9mem.ld16(p, sym_w + j * 2) as usize
        let want: i64 = vp9mem.ld16(p, sym_w + j * 2 + 1) as i64
        var got: i64 = 0
        if ctx == 65535 {
            got = av1sym.sym_bool(&s)
        } else {
            got = av1sym.sym_read(&s, cdfs + (ctx * 64) as u64, ns[ctx])
        }
        if got != want {
            return 1 + (j % 100) as i32
        }
        j = j + 1
    }
    return 0
}
