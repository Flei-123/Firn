import std.rt
import media.video.vidops
import media.video.vidvp9

fn main(start: u64) -> i32 {
    let ops: vidops.VideoOps = vidvp9.vvp9_ops()
    let n: usize = 4096
    let d: u64 = rt.heap_alloc(n)
    let h: u64 = ops.create()
    if ops.open(h, d, n) != vidops.VO_OK {
        return 1
    }
    let out: u64 = rt.heap_alloc(ops.rgba_bytes(h))
    var pts: i64 = 0
    let rc: i32 = ops.next_frame(h, out, &pts)
    ops.close(h)
    ops.destroy(h)
    return rc
}
