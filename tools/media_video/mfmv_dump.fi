// SPDX-License-Identifier: MPL-2.0
import std.rt
import media.video.vp9.vp9mem
import media.video.av1.av1seq
import media.video.av1.av1fhdr
import media.video.av1.av1ref
import media.video.av1.av1mfbuf
import media.video.av1.av1mfmv

struct Rng {
    x: i64,
}

fn rng_next(r: *mut Rng) -> i64 {
    (*r).x = ((*r).x * 1103515245 + 12345) & 2147483647
    return (*r).x >> 8
}

fn put_line(out: *mut rt.Buf, a: i64, b: i64, c: i64, d: i64) {
    rt.buf_push_dec_i64(out, a)
    rt.buf_push(out, 32 as u8)
    rt.buf_push_dec_i64(out, b)
    rt.buf_push(out, 32 as u8)
    rt.buf_push_dec_i64(out, c)
    rt.buf_push(out, 32 as u8)
    rt.buf_push_dec_i64(out, d)
    rt.buf_push(out, 10 as u8)
}

fn run_seed(seed: i64, out: *mut rt.Buf) {
    var r: Rng = Rng { x: seed * 7919 + 17 }
    let bits: i64 = 4 + rng_next(&r) % 4
    let mi_rows: i64 = 2 * (4 + rng_next(&r) % 36)
    let mi_cols: i64 = 2 * (4 + rng_next(&r) % 36)
    let cur: i64 = rng_next(&r) % (1 << (bits as u64))
    let seq: *mut av1seq.SeqHdr = av1seq.seq_new()
    (*seq).enable_order_hint = 1
    (*seq).order_hint_bits = bits
    let fh: *mut av1fhdr.FrameHdr = av1fhdr.fhdr_new()
    (*fh).mi_rows = mi_rows
    (*fh).mi_cols = mi_cols
    (*fh).order_hint = cur
    var i: usize = 0
    while i < 7 {
        (*fh).ref_frame_idx[i] = rng_next(&r) % 8
        i = i + 1
    }
    let st: *mut av1ref.RefState = av1ref.ref_state_new()
    var s: usize = 0
    while s < 8 {
        let sl: *mut av1ref.RefSlot = &(*st).slots[s]
        (*sl).valid = 1
        (*sl).order_hint = rng_next(&r) % (1 << (bits as u64))
        let ft: i64 = rng_next(&r) % 8
        (*sl).frame_type = 1
        if ft == 0 {
            (*sl).frame_type = 0
        } else if ft == 1 {
            (*sl).frame_type = 2
        }
        let dims_ok: i64 = rng_next(&r) % 6
        (*sl).mi_rows = mi_rows
        (*sl).mi_cols = mi_cols
        if dims_ok == 0 {
            (*sl).mi_rows = mi_rows + 2
        }
        var k: usize = 1
        while k < 8 {
            (*sl).saved_order_hints[k] = rng_next(&r) % (1 << (bits as u64))
            k = k + 1
        }
        let has_mf: i64 = rng_next(&r) % 10
        let range_pick: i64 = rng_next(&r) % 3
        var mv_range: i64 = 64
        if range_pick == 1 {
            mv_range = 600
        } else if range_pick == 2 {
            mv_range = 4095
        }
        let mf: *mut av1mfbuf.MfBuf = av1mfbuf.mfbuf_new((*sl).mi_rows, (*sl).mi_cols)
        let cells: i64 = (*mf).rows8 * (*mf).cols8
        var c: i64 = 0
        while c < cells {
            let present: i64 = rng_next(&r) % 4
            var rf: i64 = rng_next(&r) % 8
            if present == 0 {
                rf = 0
            }
            let mvr: i64 = rng_next(&r) % (2 * mv_range + 1) - mv_range
            let mvc: i64 = rng_next(&r) % (2 * mv_range + 1) - mv_range
            vp9mem.st8((*mf).ref_frames, c as usize, rf)
            vp9mem.sti16((*mf).mvs, (c * 2) as usize, mvr)
            vp9mem.sti16((*mf).mvs, (c * 2 + 1) as usize, mvc)
            c = c + 1
        }
        if has_mf == 0 {
            av1mfbuf.mfbuf_release(mf)
        } else {
            (*sl).mf = mf as u64
        }
        s = s + 1
    }
    i = 0
    while i < 7 {
        (*fh).order_hints[i + 1] = (*st).slots[(*fh).ref_frame_idx[i] as usize].order_hint
        i = i + 1
    }
    let m: *mut av1mfmv.MotionField = av1mfmv.mfld_new(mi_rows, mi_cols)
    av1mfmv.mfld_estimate(m, fh, seq, st)
    var ref_frame: i64 = 1
    while ref_frame < 8 {
        var count: i64 = 0
        var h: i64 = 0
        var y8: i64 = 0
        while y8 < (*m).rows8 {
            var x8: i64 = 0
            while x8 < (*m).cols8 {
                var k2: i64 = 0
                while k2 < 2 {
                    let v: i64 = av1mfmv.mfld_at(m, ref_frame, y8, x8, k2)
                    h = (h * 1000003 + (v & 65535)) & 1099511627775
                    k2 = k2 + 1
                }
                if av1mfmv.mfld_valid(m, ref_frame, y8, x8) {
                    count = count + 1
                }
                x8 = x8 + 1
            }
            y8 = y8 + 1
        }
        put_line(out, seed, ref_frame, count, h)
        ref_frame = ref_frame + 1
    }
    av1mfmv.mfld_free(m)
    av1ref.ref_state_free(st)
    av1fhdr.fhdr_free(fh)
    av1seq.seq_free(seq)
}

#[allow_escape]
fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 64
    }
    var out: rt.Buf = rt.buf_new()
    let n: i64 = 300
    var seed: i64 = 1
    while seed <= n {
        run_seed(seed, &out)
        seed = seed + 1
    }
    if !rt.write_file(rt.arg_ptr(start, 1), rt.buf_ptr(&out), rt.buf_len(&out)) {
        return 6
    }
    return 0
}
