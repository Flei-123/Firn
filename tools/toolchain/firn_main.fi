import std.rt
import std.io
import std.fs
import std.env
import std.pystr
import std.process
import toolchain.tcver
import toolchain.tcpaths
import toolchain.tcplat
import toolchain.tcconfig
import toolchain.tcinstall
import toolchain.tcproject
import toolchain.tcselftest
import toolchain.tccmd

fn main(start: u64) -> i32 {
    var argv: Vec[str] = vec_new[str]()
    for i in 0..rt.arg_count(start) {
        let p: u64 = rt.arg_ptr(start, i)
        vec_push[str](&argv, str { p: p as *mut u8, n: rt.c_length(p) })
    }
    let code: i32 = tccmd.dispatch(&argv)
    vec_free[str](&argv)
    return code
}
