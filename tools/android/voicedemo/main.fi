// SPDX-License-Identifier: MPL-2.0
// tools/android/voicedemo/main.fi -- emulator check program for lib/plat/android/{speech,tts,share}.fi.
// Flow (results go to stdout.txt in the app's files dir): permission -> record 2 s -> WAV -> save to Downloads ->
// TTS "Hallo Welt" (de) -> clipboard round trip. Build: bash tools/android/build.sh tools/android/voicedemo/main.fi
// --name "Firn Voice" --package org.firn.voicedemo --speech --tts
import std.rt
import std.time
import std.io
import window.window
import plat.android.speech
import plat.android.tts
import plat.android.share

fn num(v: u64) {
    var d: [u8; 24] = [0 as u8; 24]
    var i: usize = 24
    var x: u64 = v
    if x == 0 as u64 {
        i = i - 1
        d[i] = 48 as u8
    }
    while x > 0 as u64 {
        i = i - 1
        d[i] = (48 as u64 + x % 10 as u64) as u8
        x = x / 10 as u64
    }
    io.print_bytes((&d[0]) as u64 + i as u64, 24 - i)
}

fn say(msg: str) {
    io.print(msg)
    io.print("\n")
}

fn main(start: u64) -> i32 {
    var f: window.Window = window.window_new()
    if !window.open_window(&f, 0) { return 1 }
    if !window.make(&f, 360, 640) { return 2 }
    let s: bool = window.show_window(&f)
    if speech.speech_permission() != 1 {
        say("perm: asking")
        let r: bool = speech.speech_request_permission()
        var waits: i32 = 0
        while speech.speech_permission() != 1 && waits < 3000 {
            let w: bool = window.wait_event(&f, 0)
            time.sleep_ms(50 as u64)
            waits = waits + 1
        }
    }
    say("perm: checked")
    let e: i32 = speech.speech_start(5000)
    say(speech.speech_error_text(e))
    if e == speech.E_OK {
        var t0: i32 = 0
        while t0 < 60 {
            let w: bool = window.wait_event(&f, 0)
            time.sleep_ms(50 as u64)
            let st: i32 = speech.speech_poll()
            t0 = t0 + 1
        }
        let n: usize = speech.speech_stop()
        io.print("recorded octets=")
        num(n as u64)
        io.print(" rate=")
        num(speech.speech_rate() as u64)
        io.print(" level=")
        num(speech.speech_level() as u64)
        io.print("\n")
        let wav: u64 = speech.speech_wav()
        var name: [u8; 12] = "voice01.wav\0"
        var mime: [u8; 10] = "audio/wav\0"
        var sub: [u8; 6] = "Voice\0"
        let sv: i32 = share.share_save(wav, speech.speech_wav_len(), (&name[0]) as u64, (&mime[0]) as u64, (&sub[0]) as u64)
        io.print("saved=")
        num(sv as u64)
        io.print("\n")
        speech.speech_free()
    }
    var text: [u8; 11] = "Hallo Welt!"
    var lang: [u8; 3] = "de\0"
    io.print("engines=")
    num(tts.tts_engines() as u64)
    io.print("\n")
    let sp: bool = tts.tts_speak((&text[0]) as u64, 11, (&lang[0]) as u64)
    var k: i32 = 0
    while k < 3000 && tts.tts_poll() != tts.TTS_DONE && tts.tts_state() != tts.TTS_ERROR {
        let w: bool = window.wait_event(&f, 0)
            time.sleep_ms(50 as u64)
        k = k + 1
    }
    io.print("tts state=")
    num(tts.tts_state() as u64)
    io.print(" lang=")
    num((tts.tts_lang_result() + 10) as u64)
    io.print(" ms=")
    num(tts.tts_elapsed_ms() as u64)
    io.print("\n")
    var clip: [u8; 11] = [104 as u8, 195 as u8, 164 as u8, 108 as u8, 108 as u8, 111 as u8, 32 as u8, 240 as u8, 159 as u8, 152 as u8, 128 as u8]
    let cw: bool = share.clip_write((&clip[0]) as u64, 11)
    var back: [u8; 64] = [0 as u8; 64]
    let cn: usize = share.clip_read((&back[0]) as u64, 64)
    io.print("clip written=")
    num(cw as u64)
    io.print(" read=")
    num(cn as u64)
    io.print("\n")
    window.close_window(&f)
    return 0
}
