// SPDX-License-Identifier: MPL-2.0
// tools/android/hostinfo/main.fi -- r382: THE ANDROID HOST METRICS IN A REAL WINDOW (tools/android/hostinfo_check.sh runs it on an
// emulator). Opens a window, opts in like app.follow_host does, runs window_system_look and prints (stdout.txt in the app's data dir):
// Then it keeps stepping the window for ~25 s and prints a line "LIVE text=<..> ins=<..> looks=<n>" every time the system look was read again
// (EV_THEME: the font size or the insets changed while the app runs).
//     HOSTINFO sdk=<api> fontscale_mil=<per mille from Java> raw_ins=<l>,<t>,<r>,<b>|? text=<theme per mille> ins=<l>,<t>,<r>,<b> called=<0|1>
// `raw_ins` is what WindowInsets says; `ins` is what the toolkit gets (minus the margin the window already leaves out).
import std.rt
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.scene
import fui.flex
import plat.fuiwirt
import plat.fuiwin
import plat.sysfont
import android.hostinfo
import window.window
import window.hostmetrics

static mut G_CALLED: bool = false
static mut G_CALLS: usize = 0
static mut G_L: f64 = 0.0
static mut G_T: f64 = 0.0
static mut G_R: f64 = 0.0
static mut G_B: f64 = 0.0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn put_i(v: i64) {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, v)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
}

fn got(ud: u64, l: f64, t: f64, r: f64, b: f64) {
    G_CALLED = true
    G_CALLS = G_CALLS + 1
    G_L = l
    G_T = t
    G_R = r
    G_B = b
}

fn times(ud: u64, fx: *mut fuiwin.Window) {
}

fn act(ud: u64, fx: *mut fuiwin.Window, node: usize) {
}

fn now_ms() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000 + ts[1] / 1000000
}

fn main() -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("hostinfo: no font\n")
        return 9
    }
    var fx: fuiwin.Window = fuiwin.window_new()
    fuiwin.window_set_font(&fx, fs as u64)
    fuiwin.window_set_gpu(&fx, false)
    var m: theme.Theme = theme.theme_new(false)
    var sc: scene.Scene = scene.scene_new()
    var c: render.Ctx = render.ctx_new(&m, fuiwin.window_painter(&fx))
    var w: fuiwirt.Host = fuiwirt.host_new(&sc, &c)
    let root: usize = scene.scene_box(&sc, scene.SCENE_NONE, 0 as u32, flex.FLEX_COLUMN, flex.JUSTIFY_CENTER, flex.AL_CENTER)
    fuiwirt.host_bind(&w)
    let t: str = "hostmetrics"
    if !fuiwin.window_open(&fx, &w, &m, 0, 200, 120, t.p as u64, t.n) {
        say("hostinfo: no window\n")
        return 1
    }
    fuiwin.window_follow_text_scale(&fx, true)
    fuiwin.window_follow_insets(&fx, 0, got)
    fuiwin.window_system_look(&fx, &m)
    say("HOSTINFO sdk=")
    put_i(hostinfo.hostinfo_sdk() as i64)
    say(" fontscale_mil=")
    put_i(hostmetrics.scale_from_factor(hostinfo.hostinfo_font_scale()) as i64)
    say(" raw_ins=")
    var raw: [f64; 4] = [0.0; 4]
    if hostinfo.hostinfo_insets(0, 0, &raw) {
        put_i(raw[0] as i64)
        say(",")
        put_i(raw[1] as i64)
        say(",")
        put_i(raw[2] as i64)
        say(",")
        put_i(raw[3] as i64)
    } else {
        say("?")
    }
    say(" text=")
    put_i(theme.theme_text_scale(&m) as i64)
    say(" ins=")
    put_i(G_L as i64)
    say(",")
    put_i(G_T as i64)
    say(",")
    put_i(G_R as i64)
    say(",")
    put_i(G_B as i64)
    say(" called=")
    if G_CALLED { say("1") } else { say("0") }
    say("\n")
    var last_calls: usize = G_CALLS
    var last_text: usize = theme.theme_text_scale(&m)
    let t_end: i64 = now_ms() + 25000
    var alive: bool = true
    while alive && now_ms() < t_end {
        let da: bool = window.wait_event(fuiwin.window_window(&fx), 200)
        alive = fuiwin.window_step(&fx, &w, &m, times, act, 0)
        if G_CALLS != last_calls || theme.theme_text_scale(&m) != last_text {
            last_calls = G_CALLS
            last_text = theme.theme_text_scale(&m)
            say("LIVE text=")
            put_i(last_text as i64)
            say(" ins=")
            put_i(G_L as i64)
            say(",")
            put_i(G_T as i64)
            say(",")
            put_i(G_R as i64)
            say(",")
            put_i(G_B as i64)
            var rw: [f64; 4] = [0.0; 4]
            if hostinfo.hostinfo_insets(0, 0, &rw) {
                say(" raw=")
                put_i(rw[0] as i64)
                say(",")
                put_i(rw[1] as i64)
                say(",")
                put_i(rw[2] as i64)
                say(",")
                put_i(rw[3] as i64)
            }
            say(" looks=")
            put_i(G_CALLS as i64)
            say("\n")
        }
    }
    fuiwin.window_close(&fx)
    return 0
}
