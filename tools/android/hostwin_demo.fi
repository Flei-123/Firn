import plat.hostwin
import plat.hostev
import plat.host

fn paint(ud: u64, w: u64) -> bool { return true }

fn event(ud: u64, w: u64, e: *mut hostev.HostEvent) -> bool {
    if (*e).kind == hostev.WE_TICK { host.wake_in(100.0) }
    return false
}

fn main() -> i32 {
    hostwin.set_keep(true)
    hostwin.on_demand(true)
    if !hostwin.app(0 as u64, paint, event) { return 3 }
    return 0
}
