import fui.app
import fui.editor
import android.imeinject

static mut NAME: usize = 0
static mut MAIL: usize = 0
static mut AREA: usize = 0
static mut OUT: usize = 0

const NO_FIELD: usize = 4294967295

fn pump_fd(ud: u64) -> i32 {
    return 0 - 1
}

fn pump_ms(ud: u64, wanted: i64) -> i64 {
    if wanted < 0 || wanted > 100 {
        return 100
    }
    return wanted
}

fn pump_step(ud: u64) -> bool {
    let a: *mut app.App = ud as *mut app.App
    let ran: bool = imeinject.inject_poll()
    var f: usize = app.focused_field(a)
    if f == NO_FIELD {
        f = NAME
    }
    let s: str = app.text(a, f)
    imeinject.inject_log_text(s.p as u64, s.n)
    return ran
}

fn enter_hook(a: *mut app.App, key: u32, mods: u32) -> bool {
    if key == editor.KEY_ENTER {
        app.set_text(a, OUT, "ENTER")
        imeinject.inject_note("enter")
        return true
    }
    return false
}

fn clear(a: *mut app.App) {
    app.set_text(a, NAME, "")
    app.set_text(a, MAIL, "")
    app.set_text(a, AREA, "")
    app.set_text(a, OUT, " ")
}

fn main() -> i32 {
    let a: *mut app.App = app.window("IME test", 420, 300)
    app.label(a, "IME test", 14)
    NAME = app.entry(a, "Your name")
    MAIL = app.entry(a, "you@example.com")
    AREA = app.textarea(a, "Notes", 4)
    app.row(a)
    app.button(a, "Send", clear)
    app.button(a, "Clear", clear)
    app.end(a)
    OUT = app.label(a, " ", 0)
    app.on_key(a, enter_hook)
    app.set_pump(a, a as u64, pump_fd, pump_ms, pump_step)
    return app.run(a)
}
