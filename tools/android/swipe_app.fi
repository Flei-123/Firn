import std.rt
import android.ndk
import fui.app
import fui.lay
import fui.textarea

static mut AREA: usize = 0
static mut LAST: [i64; 5] = [0 - 1; 5]

const TAG: str = "firn\0"
const ROWS: usize = 40
const CELLS: usize = 24
const AREA_LINES: usize = 30

fn pump_fd(ud: u64) -> i32 {
    return 0 - 1
}

fn pump_ms(ud: u64, wanted: i64) -> i64 {
    if wanted < 0 || wanted > 100 {
        return 100
    }
    return wanted
}

fn noop(a: *mut app.App) {
}

fn push_field(b: *mut rt.Buf, name: str, v: i64) {
    rt.buf_push_bytes(b, name.p as u64, name.n)
    rt.buf_push_dec_i64(b, v)
}

fn pump_step(ud: u64) -> bool {
    let a: *mut app.App = ud as *mut app.App
    lay.scroll_sync(a)
    let now: [i64; 5] = [
        lay.scroll_offset(0) as i64,
        lay.scroll_offset_x(1) as i64,
        textarea.ta_scroll_y(app.lines_of(a, AREA)) as i64,
        lay.scroll_over(0) as i64,
        lay.scroll_over(1) as i64,
    ]
    var same: bool = true
    var i: usize = 0
    while i < 5 {
        if now[i] != LAST[i] {
            same = false
        }
        LAST[i] = now[i]
        i = i + 1
    }
    if same {
        return false
    }
    var b: rt.Buf = rt.buf_new()
    push_field(&b, "swipe v=", now[0])
    push_field(&b, " h=", now[1])
    push_field(&b, " t=", now[2])
    push_field(&b, " ov=", now[3])
    push_field(&b, " oh=", now[4])
    rt.buf_push(&b, 0 as u8)
    ndk.log_write(ndk.LOG_INFO, TAG.p as u64, rt.buf_ptr(&b))
    rt.buf_free(&b)
    return false
}

fn main() -> i32 {
    let a: *mut app.App = app.window("Swipe test", 420, 760)
    lay.page(a)
    app.label(a, "Swipe test", 14)
    let inner: usize = lay.scroll_v(a)
    var k: usize = 0
    while k < ROWS {
        app.button(a, "Row", noop)
        k = k + 1
    }
    app.end(a)
    let hin: usize = lay.scroll_h(a, 80)
    k = 0
    while k < CELLS {
        let cell: usize = app.button(a, "Cell", noop)
        k = k + 1
    }
    app.end(a)
    AREA = app.textarea(a, "Notes", 4)
    var text: rt.Buf = rt.buf_new()
    k = 0
    while k < AREA_LINES {
        push_field(&text, "line ", k as i64)
        rt.buf_push(&text, 10 as u8)
        k = k + 1
    }
    app.set_text(a, AREA, rt.buf_str(&text))
    app.set_pump(a, a as u64, pump_fd, pump_ms, pump_step)
    return app.run(a)
}
