// SPDX-License-Identifier: MPL-2.0
// tools/android/imedex_main.fi -- write the dex of lib/android/imedex.fi to a
// file, so that `dexdump -d` can check it (tools/android/ime_check.sh).
//
//   firnc -o imedex tools/android/imedex_main.fi && ./imedex /tmp/ime.dex
import std.rt
import android.dex
import android.imedex

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        return 2
    }
    let d: u64 = dex.dex_neu()
    if d == 0 || !imedex.imedex_build(d) {
        return 3
    }
    let buf: u64 = rt.heap_alloc(dex.DEX_CAP)
    let n: usize = dex.dex_build(d, buf, dex.DEX_CAP)
    if n == 0 {
        return 4
    }
    if !rt.write_file(rt.arg_ptr(start, 1), buf, n) {
        return 5
    }
    return 0
}
