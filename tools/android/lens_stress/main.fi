// SPDX-License-Identifier: MPL-2.0
// tools/android/lens_stress/main.fi -- lens switch stress test for lib/plat/android/camera.fi (r542).
// Runs as an app (needs the window layer for the activity); no UI. Result lines go to logcat, tag "lens-stress":
//   phase A: N x close + open + start of the lenses in turn (what the LENS button does)
//   phase B: the same with the test hook camera_force_physical(own id), which sends the session through
//            ACaptureSessionPhysicalOutput_create (the call that crashed the app on physical lenses). A device
//            that is not a multi camera refuses the session -- that must be an error code, never a crash.
// Finishes with "RESULT ok=<n> fail=<n> done" (fail counts only unexpected results). Driver: tools/android/lens_stress.sh
import window.window
import plat.android.camera
import std.rt
import android.ndk

const CYCLES: i32 = 12

fn say(msg: str, v: i64) {
    var buf: [u8; 160] = [0 as u8; 160]
    var n: usize = 0
    while n < msg.n && n < 120 {
        buf[n] = *((msg.p as u64 + n as u64) as *mut u8)
        n = n + 1
    }
    var tmp: [u8; 24] = [0 as u8; 24]
    var t: usize = 0
    var x: i64 = v
    var neg: bool = false
    if x < 0 { neg = true; x = 0 - x }
    if x == 0 { tmp[0] = 48 as u8; t = 1 }
    while x > 0 {
        tmp[t] = (48 + (x % 10)) as u8
        x = x / 10
        t = t + 1
    }
    if neg { buf[n] = 45 as u8; n = n + 1 }
    while t > 0 {
        t = t - 1
        buf[n] = tmp[t]
        n = n + 1
    }
    buf[n] = 0 as u8
    var tag: [u8; 12] = [108, 101, 110, 115, 45, 115, 116, 114, 101, 115, 115, 0]
    ndk.log_write(ndk.LOG_INFO, (&tag[0]) as u64, (&buf[0]) as u64)
}

fn one_cycle(idx: i32, ok: *mut i32, bad: *mut i32, physical: bool) {
    camera.camera_close()
    let e: i32 = camera.camera_open(idx)
    if e != camera.E_OK { say("open failed code ", e as i64); *bad = *bad + 1; return }
    let s: i32 = camera.camera_start(camera.KIND_JPEG)
    if physical {
        // refused by the camera service on a non multi camera: any error code is fine, a crash is not
        say("physical session code ", s as i64)
        *ok = *ok + 1
        return
    }
    if s != camera.E_OK { say("start failed code ", s as i64); *bad = *bad + 1; return }
    var i: i32 = 0
    while i < 10 { rt_sleep_ms(40); i = i + 1 }
    if !camera.camera_is_open() { say("device lost at cycle lens ", idx as i64); *bad = *bad + 1; return }
    *ok = *ok + 1
}

fn rt_sleep_ms(ms: i32) {
    var ts: [i64; 2] = [0; 2]
    ts[0] = (ms / 1000) as i64
    ts[1] = ((ms % 1000) as i64) * 1000000
    syscall(35, (&ts[0]) as i64, 0, 0, 0, 0, 0)
}

#[allow_escape]
fn main() -> i32 {
    var f: window.Window = window.window_new()
    if !window.open_window(&f, 0) || !window.make(&f, 480, 800) { return 1 }
    window.show_window(&f)
    var asked: bool = false
    var n: i32 = 0
    var tries: i32 = 0
    while n == 0 && tries < 200 {
        if camera.camera_permission() == 1 {
            n = camera.camera_scan()
            if n == 0 { break }
        } else if !asked {
            asked = true
            camera.camera_request_permission()
        }
        window.wait_event(&f, 50)
        var k: u32 = window.next_event(&f)
        while k != window.EV_NONE { k = window.next_event(&f) }
        tries = tries + 1
    }
    say("lenses ", n as i64)
    var ok: i32 = 0
    var bad: i32 = 0
    if n > 0 {
        var i: i32 = 0
        while i < CYCLES {
            say("cycle A ", i as i64)
            one_cycle(i % n, &ok, &bad, false)
            i = i + 1
        }
        var ci: camera.CamInfo = camera.zero_info()
        if camera.camera_info(0, &ci) {
            i = 0
            while i < CYCLES {
                say("cycle B ", i as i64)
                camera.camera_force_physical((&ci.id[0]) as u64)
                one_cycle(0, &ok, &bad, true)
                camera.camera_force_physical(0)
                i = i + 1
            }
        }
        camera.camera_close()
    } else {
        bad = bad + 1
    }
    say("RESULT bad=", bad as i64)
    say("RESULT ok=", ok as i64)
    say("RESULT done lenses=", n as i64)
    window.close_window(&f)
    return 0
}
