// SPDX-License-Identifier: MPL-2.0
import std.rt
import plat.blog

export { begin, num, quoted, word, send }

const TAG: str = "firn"
const PREFIX: str = "hostdemo "
const QUOTE_CAP: usize = 160
const SPACE: u8 = 32
const EQUALS: u8 = 61
const QUOTE: u8 = 34
const UNPRINTABLE: u8 = 63

fn begin(event: str) -> rt.Buf {
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&b, PREFIX.p as u64, PREFIX.n)
    rt.buf_push_bytes(&b, event.p as u64, event.n)
    return b
}

fn key(b: *mut rt.Buf, name: str) {
    rt.buf_push(b, SPACE)
    rt.buf_push_bytes(b, name.p as u64, name.n)
    rt.buf_push(b, EQUALS)
}

fn num(b: *mut rt.Buf, name: str, v: i64) {
    key(b, name)
    rt.buf_push_dec_i64(b, v)
}

fn word(b: *mut rt.Buf, name: str, value: str) {
    key(b, name)
    rt.buf_push_bytes(b, value.p as u64, value.n)
}

fn quoted(b: *mut rt.Buf, name: str, p: u64, n: usize) {
    key(b, name)
    rt.buf_push(b, QUOTE)
    var len: usize = n
    if len > QUOTE_CAP { len = QUOTE_CAP }
    var i: usize = 0
    while i < len {
        let c: u8 = rt.ld8(p, i)
        if c < SPACE { rt.buf_push(b, UNPRINTABLE) } else { rt.buf_push(b, c) }
        i = i + 1
    }
    rt.buf_push(b, QUOTE)
}

fn send(b: *mut rt.Buf) {
    blog.log(TAG, rt.buf_str(b))
    rt.buf_free(b)
}
