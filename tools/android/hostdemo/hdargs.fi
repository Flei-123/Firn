// SPDX-License-Identifier: MPL-2.0
import std.rt

export { skip_spaces, word_end, parse_dec, is_word, flag_on }

const SPACE: u8 = 32
const DIGIT_0: u8 = 48
const DIGIT_9: u8 = 57
const DECIMAL_BASE: i64 = 10
const FLAG_ON: str = "on"

fn skip_spaces(p: u64, n: usize, from: usize) -> usize {
    var i: usize = from
    while i < n && rt.ld8(p, i) == SPACE { i = i + 1 }
    return i
}

fn word_end(p: u64, n: usize, from: usize) -> usize {
    var i: usize = from
    while i < n && rt.ld8(p, i) != SPACE { i = i + 1 }
    return i
}

fn parse_dec(p: u64, a: usize, b: usize) -> i64 {
    var v: i64 = 0
    var i: usize = a
    while i < b {
        let c: u8 = rt.ld8(p, i)
        if c >= DIGIT_0 && c <= DIGIT_9 { v = v * DECIMAL_BASE + ((c - DIGIT_0) as i64) }
        i = i + 1
    }
    return v
}

fn is_word(p: u64, a: usize, b: usize, lit: str) -> bool {
    return b - a == lit.n && rt.mem_eq(p + (a as u64), lit.p as u64, lit.n)
}

fn flag_on(p: u64, n: usize) -> bool {
    return is_word(p, 0, n, FLAG_ON)
}
