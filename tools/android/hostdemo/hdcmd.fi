// SPDX-License-Identifier: MPL-2.0
import std.rt
import hdargs
import hdlog

export { register, poll }

#[no_gc]
#[link_name(__system_property_get)]
extern fn system_property_get(name: u64, value: u64) -> i32;

const PROP: str = "debug.firn.hostdemo\0"
const VALUE_CAP: usize = 92
const MAX_COMMANDS: usize = 32

static mut G_SEQ: i64 = 0 - 1
static mut G_COUNT: usize = 0
static mut G_NAME_P: [u64; 32] = [0; 32]
static mut G_NAME_N: [usize; 32] = [0; 32]
static mut G_RUN: [u64; 32] = [0; 32]

fn register(name: str, run: fn(u64, usize) -> bool) {
    if G_COUNT >= MAX_COMMANDS { return }
    G_NAME_P[G_COUNT] = name.p as u64
    G_NAME_N[G_COUNT] = name.n
    G_RUN[G_COUNT] = run as u64
    G_COUNT = G_COUNT + 1
}

fn find(p: u64, a: usize, b: usize) -> usize {
    var i: usize = 0
    while i < G_COUNT {
        let lit: str = str { p: G_NAME_P[i] as *mut u8, n: G_NAME_N[i] }
        if hdargs.is_word(p, a, b, lit) { return i }
        i = i + 1
    }
    return MAX_COMMANDS
}

fn report(seq: i64, p: u64, a: usize, b: usize, ok: bool) {
    var line: rt.Buf = hdlog.begin("cmd")
    hdlog.num(&line, "seq", seq)
    hdlog.quoted(&line, "name", p + (a as u64), b - a)
    var flag: i64 = 0
    if ok { flag = 1 }
    hdlog.num(&line, "ok", flag)
    hdlog.send(&line)
}

fn run_line(p: u64, n: usize) {
    var pos: usize = hdargs.skip_spaces(p, n, 0)
    var end: usize = hdargs.word_end(p, n, pos)
    let seq: i64 = hdargs.parse_dec(p, pos, end)
    if seq == G_SEQ { return }
    G_SEQ = seq
    pos = hdargs.skip_spaces(p, n, end)
    end = hdargs.word_end(p, n, pos)
    let at: usize = find(p, pos, end)
    if at == MAX_COMMANDS {
        report(seq, p, pos, end, false)
        return
    }
    let arg: usize = hdargs.skip_spaces(p, n, end)
    let run: fn(u64, usize) -> bool = G_RUN[at] as fn(u64, usize) -> bool
    report(seq, p, pos, end, run(p + (arg as u64), n - arg))
}

fn poll() {
    var value: [u8; 92] = [0; 92]
    let n: i32 = system_property_get(PROP.p as u64, (&value[0]) as u64)
    if n <= 0 || (n as usize) >= VALUE_CAP { return }
    run_line((&value[0]) as u64, n as usize)
}
