import plat.hostev

export { on, dispatch }

const KIND_COUNT: usize = 32

static mut G_HANDLERS: [u64; 32] = [0; 32]

fn on(kind: u32, f: fn(*mut hostev.HostEvent)) {
    if (kind as usize) >= KIND_COUNT { return }
    G_HANDLERS[kind as usize] = f as u64
}

fn dispatch(e: *mut hostev.HostEvent) -> bool {
    let kind: usize = (*e).kind as usize
    if kind >= KIND_COUNT || G_HANDLERS[kind] == 0 { return false }
    let f: fn(*mut hostev.HostEvent) = G_HANDLERS[kind] as fn(*mut hostev.HostEvent)
    f(e)
    return true
}
