import std.rt
import plat.host
import plat.hostev
import hdargs
import hdcmd
import hdevents
import hdlog

export { init }

const MIME_TEXT: str = "text/plain"
const VALUE_CAP: usize = 1024

fn cmd_store_set(p: u64, n: usize) -> bool {
    let key_end: usize = hdargs.word_end(p, n, 0)
    let value: usize = hdargs.skip_spaces(p, n, key_end)
    if key_end == 0 { return false }
    host.store_set(p, key_end, p + (value as u64), n - value)
    return true
}

fn cmd_store_get(p: u64, n: usize) -> bool {
    var out: [u8; 1024] = [0; 1024]
    let got: usize = host.store_get(p, hdargs.word_end(p, n, 0), (&out[0]) as u64, VALUE_CAP)
    var line: rt.Buf = hdlog.begin("store")
    hdlog.num(&line, "n", got as i64)
    hdlog.quoted(&line, "value", (&out[0]) as u64, got)
    hdlog.send(&line)
    return got > 0
}

fn cmd_clip_set(p: u64, n: usize) -> bool {
    return host.clip_write(MIME_TEXT, p, n)
}

fn cmd_clip_get(p: u64, n: usize) -> bool {
    host.clip_read(MIME_TEXT)
    return true
}

fn on_clip(e: *mut hostev.HostEvent) {
    var line: rt.Buf = hdlog.begin("clip")
    hdlog.num(&line, "status", (*e).status as i64)
    hdlog.quoted(&line, "text", (*e).p, (*e).n)
    hdlog.send(&line)
}

fn init() {
    hdcmd.register("storeset", cmd_store_set)
    hdcmd.register("storeget", cmd_store_get)
    hdcmd.register("clipset", cmd_clip_set)
    hdcmd.register("clipget", cmd_clip_get)
    hdevents.on(hostev.WE_CLIP, on_clip)
}
