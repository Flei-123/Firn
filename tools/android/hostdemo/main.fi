import std.rt
import plat.hostwin
import plat.hostev
import plat.host
import android.imeinject
import hdcmd
import hdevents
import hdlog
import hdnet
import hdstate
import hdinput
import hdsys

const TICK_MS: f64 = 100.0
const EXIT_NO_WINDOW: i32 = 3

fn paint(ud: u64, w: u64) -> bool { return true }

fn event(ud: u64, w: u64, e: *mut hostev.HostEvent) -> bool {
    if (*e).kind == hostev.WE_TICK {
        host.wake_in(TICK_MS)
        hdcmd.poll()
        let injected: bool = imeinject.inject_poll()
        return false
    }
    return hdevents.dispatch(e)
}

fn announce() {
    var line: rt.Buf = hdlog.begin("ready")
    hdlog.word(&line, "backend", host.backend_name())
    hdlog.send(&line)
}

fn main() -> i32 {
    hdnet.init()
    hdstate.init()
    hdinput.init()
    hdsys.init()
    hostwin.set_keep(true)
    hostwin.on_demand(true)
    announce()
    if !hostwin.app(0 as u64, paint, event) { return EXIT_NO_WINDOW }
    return 0
}
