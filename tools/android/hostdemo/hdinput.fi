import std.rt
import plat.host
import plat.hostev
import hdargs
import hdcmd
import hdevents
import hdlog

export { init }

const FIELD_FONT: f64 = 16.0
const FIELD_LINE: f64 = 20.0
const FIELD_WIDTH: f64 = 360.0
const FIELD_HEIGHT: f64 = 48.0
const NO_SCROLL: f64 = 0.0

fn cmd_keyboard(p: u64, n: usize) -> bool {
    host.keyboard(hdargs.flag_on(p, n), 0.0, 0.0, FIELD_WIDTH, FIELD_HEIGHT)
    return true
}

fn cmd_edit_mode(p: u64, n: usize) -> bool {
    host.edit_mode(hdargs.flag_on(p, n), FIELD_FONT, FIELD_LINE, 0.0, 0.0, FIELD_WIDTH)
    return true
}

fn cmd_edit_set(p: u64, n: usize) -> bool {
    host.edit_set(p, n, n, n, NO_SCROLL)
    return true
}

fn on_text(e: *mut hostev.HostEvent) {
    var line: rt.Buf = hdlog.begin("text")
    hdlog.quoted(&line, "value", (*e).p, (*e).n)
    hdlog.send(&line)
}

fn on_edit(e: *mut hostev.HostEvent) {
    var line: rt.Buf = hdlog.begin("edit")
    hdlog.quoted(&line, "text", (*e).p, (*e).n)
    hdlog.num(&line, "cur", (*e).cur as i64)
    hdlog.num(&line, "anc", (*e).anc as i64)
    hdlog.num(&line, "ca", (*e).ca as i64)
    hdlog.num(&line, "cb", (*e).cb as i64)
    hdlog.send(&line)
}

fn on_key(e: *mut hostev.HostEvent) {
    var line: rt.Buf = hdlog.begin("key")
    hdlog.quoted(&line, "name", (*e).p, (*e).n)
    hdlog.num(&line, "down", (*e).status as i64)
    hdlog.send(&line)
}

fn init() {
    hdcmd.register("kbd", cmd_keyboard)
    hdcmd.register("edit", cmd_edit_mode)
    hdcmd.register("editset", cmd_edit_set)
    hdevents.on(hostev.WE_TEXT, on_text)
    hdevents.on(hostev.WE_EDIT, on_edit)
    hdevents.on(hostev.WE_KEY, on_key)
}
