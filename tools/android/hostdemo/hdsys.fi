import std.rt
import plat.host
import plat.hostev
import hdargs
import hdcmd
import hdevents
import hdlog

export { init }

const TITLE: str = "hostdemo"
const MIME_TEXT: str = "text/plain"
const PHOTO: str = "photo"
const KIND_PHOTO: u32 = 0
const KIND_FILE: u32 = 1
const NOTIFY_KEY: u64 = 0
const TZ_PROBE_STAMP: u64 = 1700000000
const ROUTE_CAP: usize = 256
const INSET_COUNT: usize = 4

fn text_of(p: u64, n: usize) -> str {
    return str { p: p as *mut u8, n: n }
}

fn cmd_notify(p: u64, n: usize) -> bool {
    return host.notify(NOTIFY_KEY, TITLE, text_of(p, n))
}

fn cmd_save(p: u64, n: usize) -> bool {
    let name_end: usize = hdargs.word_end(p, n, 0)
    let body: usize = hdargs.skip_spaces(p, n, name_end)
    if name_end == 0 { return false }
    return host.save(text_of(p, name_end), MIME_TEXT, p + (body as u64), n - body)
}

fn cmd_share(p: u64, n: usize) -> bool {
    return host.share(TITLE, text_of(p, n))
}

fn cmd_pick(p: u64, n: usize) -> bool {
    var kind: u32 = KIND_FILE
    if hdargs.is_word(p, 0, n, PHOTO) { kind = KIND_PHOTO }
    return host.pick(kind)
}

fn cmd_back_hold(p: u64, n: usize) -> bool {
    host.back_hold(hdargs.flag_on(p, n))
    return true
}

fn cmd_route(p: u64, n: usize) -> bool {
    if n == 0 { return false }
    host.navigate(p, n)
    return true
}

fn cmd_where(p: u64, n: usize) -> bool {
    var out: [u8; 256] = [0; 256]
    let got: usize = host.location((&out[0]) as u64, ROUTE_CAP)
    var line: rt.Buf = hdlog.begin("where")
    hdlog.quoted(&line, "path", (&out[0]) as u64, got)
    hdlog.send(&line)
    return got > 0
}

fn cmd_insets(p: u64, n: usize) -> bool {
    var v: [f64; 4] = [0.0; 4]
    let ok: bool = host.insets((&v[0]) as u64)
    var line: rt.Buf = hdlog.begin("insets")
    hdlog.num(&line, "left", v[0] as i64)
    hdlog.num(&line, "top", v[1] as i64)
    hdlog.num(&line, "right", v[2] as i64)
    hdlog.num(&line, "bottom", v[3] as i64)
    hdlog.send(&line)
    return ok
}

fn cmd_info(p: u64, n: usize) -> bool {
    var line: rt.Buf = hdlog.begin("info")
    hdlog.word(&line, "backend", host.backend_name())
    var dark: i64 = 0
    if host.dark() { dark = 1 }
    hdlog.num(&line, "dark", dark)
    hdlog.num(&line, "tz", host.tz_offset(TZ_PROBE_STAMP))
    hdlog.send(&line)
    return true
}

fn on_dialog(e: *mut hostev.HostEvent) {
    var line: rt.Buf = hdlog.begin("dialog")
    hdlog.num(&line, "status", (*e).status as i64)
    hdlog.quoted(&line, "name", (*e).q, (*e).qn)
    hdlog.num(&line, "n", (*e).n as i64)
    hdlog.quoted(&line, "head", (*e).p, (*e).n)
    hdlog.send(&line)
}

fn on_back(e: *mut hostev.HostEvent) {
    var line: rt.Buf = hdlog.begin("back")
    hdlog.send(&line)
}

fn on_route(e: *mut hostev.HostEvent) {
    var line: rt.Buf = hdlog.begin("route")
    hdlog.quoted(&line, "path", (*e).p, (*e).n)
    hdlog.send(&line)
}

fn on_resize(e: *mut hostev.HostEvent) {
    var line: rt.Buf = hdlog.begin("resize")
    hdlog.num(&line, "w", (*e).x as i64)
    hdlog.num(&line, "h", (*e).y as i64)
    hdlog.send(&line)
}

fn init() {
    hdcmd.register("notify", cmd_notify)
    hdcmd.register("save", cmd_save)
    hdcmd.register("share", cmd_share)
    hdcmd.register("pick", cmd_pick)
    hdcmd.register("backhold", cmd_back_hold)
    hdcmd.register("route", cmd_route)
    hdcmd.register("where", cmd_where)
    hdcmd.register("insets", cmd_insets)
    hdcmd.register("info", cmd_info)
    hdevents.on(hostev.WE_DIALOG, on_dialog)
    hdevents.on(hostev.WE_BACK, on_back)
    hdevents.on(hostev.WE_ROUTE, on_route)
    hdevents.on(hostev.WE_RESIZE, on_resize)
}
