import std.rt
import plat.host
import plat.hostev
import hdargs
import hdcmd
import hdevents
import hdlog

export { init }

const METHOD_GET: str = "GET"
const METHOD_POST: str = "POST"

static mut G_NEXT_ID: u32 = 1

fn next_id() -> u32 {
    let id: u32 = G_NEXT_ID
    G_NEXT_ID = G_NEXT_ID + (1 as u32)
    return id
}

fn cmd_origin(p: u64, n: usize) -> bool {
    host.origin(str { p: p as *mut u8, n: n })
    return n > 0
}

fn cmd_fetch(p: u64, n: usize) -> bool {
    if n == 0 { return false }
    host.fetch(next_id(), METHOD_GET.p as u64, METHOD_GET.n, p, n, 0 as u64, 0)
    return true
}

fn cmd_post(p: u64, n: usize) -> bool {
    let path_end: usize = hdargs.word_end(p, n, 0)
    let body: usize = hdargs.skip_spaces(p, n, path_end)
    if path_end == 0 || body >= n { return false }
    host.fetch(next_id(), METHOD_POST.p as u64, METHOD_POST.n, p, path_end, p + (body as u64), n - body)
    return true
}

fn cmd_stream(p: u64, n: usize) -> bool {
    if n == 0 { return false }
    host.stream_open(p, n)
    return true
}

fn cmd_stream_close(p: u64, n: usize) -> bool {
    host.stream_close()
    return true
}

fn on_fetch(e: *mut hostev.HostEvent) {
    var line: rt.Buf = hdlog.begin("fetch")
    hdlog.num(&line, "id", (*e).id as i64)
    hdlog.num(&line, "status", (*e).status as i64)
    hdlog.quoted(&line, "body", (*e).p, (*e).n)
    hdlog.send(&line)
}

fn on_stream(e: *mut hostev.HostEvent) {
    var line: rt.Buf = hdlog.begin("sse")
    hdlog.quoted(&line, "name", (*e).q, (*e).qn)
    hdlog.quoted(&line, "data", (*e).p, (*e).n)
    hdlog.send(&line)
}

fn on_stream_state(e: *mut hostev.HostEvent) {
    var line: rt.Buf = hdlog.begin("sse_state")
    hdlog.num(&line, "open", (*e).status as i64)
    hdlog.send(&line)
}

fn init() {
    hdcmd.register("origin", cmd_origin)
    hdcmd.register("fetch", cmd_fetch)
    hdcmd.register("post", cmd_post)
    hdcmd.register("stream", cmd_stream)
    hdcmd.register("streamclose", cmd_stream_close)
    hdevents.on(hostev.WE_FETCH, on_fetch)
    hdevents.on(hostev.WE_STREAM, on_stream)
    hdevents.on(hostev.WE_STREAM_STATE, on_stream_state)
}
