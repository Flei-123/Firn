// SPDX-License-Identifier: MPL-2.0
// tools/android/servicedex_main.fi -- THE ONE CLASS A PUSH APP NEEDS,
// WRITTEN BY FIRN.
//
// A foreground service has to be named in the manifest, and Android
// instantiates it through the app's class loader: it must be a class in
// the APK's classes.dex. No javac, no d8, no Kotlin -- this program writes
// the dex file with lib/android/dex.fi. The class is what the Java would be:
//
//     package org.firn;
//     public class FirnService extends android.app.Service {
//         static { System.loadLibrary("<lib>"); }
//         public FirnService() { super(); }
//         public native android.os.IBinder onBind(android.content.Intent i);
//         public native int onStartCommand(android.content.Intent i,
//                                           int flags, int startId);
//         public native void onDestroy();
//     }
//
// The three native methods are resolved by name in lib<lib>.so
// (Java_org_firn_FirnService_*, lib/plat/android/push.fi). The static
// initialiser loads the library itself: Android may start the service in a
// fresh process without the activity, and then nobody else would.
//
//   firnc -o servicedex tools/android/servicedex_main.fi
//   servicedex <out/classes.dex> [lib name, default firnapp]
import std.rt
import android.dex

const CAP: usize = 65536

fn s_(d: u64, lit: u64, n: usize) -> u32 {
    return dex.dex_typ(d, lit, n)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 42] = "usage: servicedex <classes.dex> [libname]\n"
        rt.write_everything(2, (&u[0]) as u64, 42)
        return 2
    }
    let out: u64 = rt.arg_ptr(start, 1)
    var lib: u64 = 0
    var libn: usize = 0
    var std_lib: [u8; 7] = "firnapp"
    if rt.arg_count(start) >= 3 {
        lib = rt.arg_ptr(start, 2)
        libn = rt.c_length(lib)
    } else {
        lib = (&std_lib[0]) as u64
        libn = 7
    }

    let d: u64 = dex.dex_neu()
    if d == 0 {
        return 3
    }
    var c_self: [u8; 24] = "Lorg/firn/FirnService;\0\0"
    var c_svc: [u8; 22] = "Landroid/app/Service;\0"
    var c_bind: [u8; 21] = "Landroid/os/IBinder;\0"
    var c_int: [u8; 25] = "Landroid/content/Intent;\0"
    var c_sys: [u8; 19] = "Ljava/lang/System;\0"
    var c_str: [u8; 19] = "Ljava/lang/String;\0"
    var c_i: [u8; 1] = "I"
    var c_v: [u8; 1] = "V"
    let t_self: u32 = s_(d, (&c_self[0]) as u64, 22)
    let t_svc: u32 = s_(d, (&c_svc[0]) as u64, 21)
    let t_bind: u32 = s_(d, (&c_bind[0]) as u64, 20)
    let t_int: u32 = s_(d, (&c_int[0]) as u64, 24)
    let t_sys: u32 = s_(d, (&c_sys[0]) as u64, 18)
    let t_str: u32 = s_(d, (&c_str[0]) as u64, 18)
    let t_i: u32 = s_(d, (&c_i[0]) as u64, 1)
    let t_v: u32 = s_(d, (&c_v[0]) as u64, 1)

    var ar: [u32; 3] = [0; 3]
    let par: u64 = (&ar[0]) as u64
    let p_v: u32 = dex.dex_proto(d, t_v, par, 0)
    ar[0] = t_int
    let p_bind: u32 = dex.dex_proto(d, t_bind, par, 1)
    ar[0] = t_int
    ar[1] = t_i
    ar[2] = t_i
    let p_start: u32 = dex.dex_proto(d, t_i, par, 3)
    ar[0] = t_str
    let p_load: u32 = dex.dex_proto(d, t_v, par, 1)

    var n_init: [u8; 6] = "<init>"
    var n_clinit: [u8; 8] = "<clinit>"
    var n_bind: [u8; 6] = "onBind"
    var n_start: [u8; 14] = "onStartCommand"
    var n_destroy: [u8; 9] = "onDestroy"
    var n_load: [u8; 11] = "loadLibrary"
    let m_super: u32 = dex.dex_methode(d, t_svc, p_v, (&n_init[0]) as u64, 6)
    let m_init: u32 = dex.dex_methode(d, t_self, p_v, (&n_init[0]) as u64, 6)
    let m_clinit: u32 = dex.dex_methode(d, t_self, p_v,
        (&n_clinit[0]) as u64, 8)
    let m_bind: u32 = dex.dex_methode(d, t_self, p_bind,
        (&n_bind[0]) as u64, 6)
    let m_start: u32 = dex.dex_methode(d, t_self, p_start,
        (&n_start[0]) as u64, 14)
    let m_destroy: u32 = dex.dex_methode(d, t_self, p_v,
        (&n_destroy[0]) as u64, 9)
    let m_load: u32 = dex.dex_methode(d, t_sys, p_load,
        (&n_load[0]) as u64, 11)
    let s_lib: u32 = dex.dex_str(d, lib, libn)

    // <clinit>: const-string v0, "<lib>"; invoke-static {v0}, loadLibrary
    let c_cl: i32 = dex.dex_code(d, 1 as u32, 0 as u32, 1 as u32)
    dex.dex_op21c(d, c_cl, dex.OP_CONST_STRING, 0 as u32, s_lib)
    dex.dex_op35c(d, c_cl, dex.OP_INVOKE_STATIC, 1 as u32, m_load,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_cl, dex.OP_RETURN_VOID)
    // <init>: invoke-direct {v0}, Service.<init>
    let c_in: i32 = dex.dex_code(d, 1 as u32, 1 as u32, 1 as u32)
    dex.dex_op35c(d, c_in, dex.OP_INVOKE_DIRECT, 1 as u32, m_super,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_in, dex.OP_RETURN_VOID)

    let k: u32 = dex.dex_klasse(d, t_self, dex.ACC_PUBLIC, t_svc)
    let nat: u32 = dex.ACC_PUBLIC | dex.ACC_NATIVE
    dex.dex_glied(d, k, dex.G_DIREKT, m_clinit,
        dex.ACC_STATIC | dex.ACC_CONSTRUCTOR, c_cl)
    dex.dex_glied(d, k, dex.G_DIREKT, m_init,
        dex.ACC_PUBLIC | dex.ACC_CONSTRUCTOR, c_in)
    dex.dex_glied(d, k, dex.G_VIRTUELL, m_bind, nat, 0 - 1)
    dex.dex_glied(d, k, dex.G_VIRTUELL, m_start, nat, 0 - 1)
    dex.dex_glied(d, k, dex.G_VIRTUELL, m_destroy, nat, 0 - 1)
    if dex.dex_fehler(d) != 0 as u32 {
        var f: [u8; 26] = "servicedex: writer failed\n"
        rt.write_everything(2, (&f[0]) as u64, 26)
        return 4
    }
    let buf: u64 = rt.heap_alloc(CAP)
    let n: usize = dex.dex_bauen(d, buf, CAP)
    if n == 0 {
        return 5
    }
    if !rt.write_file(out, buf, n) {
        return 6
    }
    return 0
}
