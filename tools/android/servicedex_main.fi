// SPDX-License-Identifier: MPL-2.0
// tools/android/servicedex_main.fi -- THE ONE CLASS A PUSH APP NEEDS,
// WRITTEN BY FIRN.
//
// A foreground service has to be named in the manifest, and Android
// instantiates it through the app's class loader: it must be a class in
// the APK's classes.dex. No javac, no d8, no Kotlin -- this program writes
// the dex file with lib/android/dex.fi. The class is what the Java would be:
//
//     package org.firn;
//     public class FirnService extends android.app.Service {
//         static { System.loadLibrary("<lib>"); }
//         public FirnService() { super(); }
//         public native android.os.IBinder onBind(android.content.Intent i);
//         public native int onStartCommand(android.content.Intent i,
//                                           int flags, int startId);
//         public native void onDestroy();
//     }
//
// Beside it, org.firn.FirnMain (the launcher activity: onNewIntent keeps the intent of a notification tap while the app is open),
// org.firn.FirnInstall (appkit's updater receiver, tools/android/build.sh --install)
// and org.firn.FirnPick -- the activity that asks for a photo
// (lib/plat/android/pick.fi, see the class at the end of main).
//
// The three native methods are resolved by name in lib<lib>.so
// (Java_org_firn_FirnService_*, lib/plat/android/push.fi). The static
// initialiser loads the library itself: Android may start the service in a
// fresh process without the activity, and then nobody else would.
//
//   firnc -o servicedex tools/android/servicedex_main.fi
//   servicedex <out/classes.dex> [lib name, default firnapp]
import std.rt
import android.dex

const CAP: usize = 65536

fn s_(d: u64, lit: u64, n: usize) -> u32 {
    return dex.dex_typ(d, lit, n)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 42] = "usage: servicedex <classes.dex> [libname]\n"
        rt.write_everything(2, (&u[0]) as u64, 42)
        return 2
    }
    let out: u64 = rt.arg_ptr(start, 1)
    var lib: u64 = 0
    var libn: usize = 0
    var std_lib: [u8; 7] = "firnapp"
    if rt.arg_count(start) >= 3 {
        lib = rt.arg_ptr(start, 2)
        libn = rt.c_length(lib)
    } else {
        lib = (&std_lib[0]) as u64
        libn = 7
    }

    let d: u64 = dex.dex_neu()
    if d == 0 {
        return 3
    }
    var c_self: [u8; 24] = "Lorg/firn/FirnService;\0\0"
    var c_svc: [u8; 22] = "Landroid/app/Service;\0"
    var c_bind: [u8; 21] = "Landroid/os/IBinder;\0"
    var c_int: [u8; 25] = "Landroid/content/Intent;\0"
    var c_sys: [u8; 19] = "Ljava/lang/System;\0"
    var c_str: [u8; 19] = "Ljava/lang/String;\0"
    var c_i: [u8; 1] = "I"
    var c_v: [u8; 1] = "V"
    let t_self: u32 = s_(d, (&c_self[0]) as u64, 22)
    let t_svc: u32 = s_(d, (&c_svc[0]) as u64, 21)
    let t_bind: u32 = s_(d, (&c_bind[0]) as u64, 20)
    let t_int: u32 = s_(d, (&c_int[0]) as u64, 24)
    let t_sys: u32 = s_(d, (&c_sys[0]) as u64, 18)
    let t_str: u32 = s_(d, (&c_str[0]) as u64, 18)
    let t_i: u32 = s_(d, (&c_i[0]) as u64, 1)
    let t_v: u32 = s_(d, (&c_v[0]) as u64, 1)

    var ar: [u32; 3] = [0; 3]
    let par: u64 = (&ar[0]) as u64
    let p_v: u32 = dex.dex_proto(d, t_v, par, 0)
    ar[0] = t_int
    let p_bind: u32 = dex.dex_proto(d, t_bind, par, 1)
    ar[0] = t_int
    ar[1] = t_i
    ar[2] = t_i
    let p_start: u32 = dex.dex_proto(d, t_i, par, 3)
    ar[0] = t_str
    let p_load: u32 = dex.dex_proto(d, t_v, par, 1)

    var n_init: [u8; 6] = "<init>"
    var n_clinit: [u8; 8] = "<clinit>"
    var n_bind: [u8; 6] = "onBind"
    var n_start: [u8; 14] = "onStartCommand"
    var n_destroy: [u8; 9] = "onDestroy"
    var n_load: [u8; 11] = "loadLibrary"
    let m_super: u32 = dex.dex_method(d, t_svc, p_v, (&n_init[0]) as u64, 6)
    let m_init: u32 = dex.dex_method(d, t_self, p_v, (&n_init[0]) as u64, 6)
    let m_clinit: u32 = dex.dex_method(d, t_self, p_v,
        (&n_clinit[0]) as u64, 8)
    let m_bind: u32 = dex.dex_method(d, t_self, p_bind,
        (&n_bind[0]) as u64, 6)
    let m_start: u32 = dex.dex_method(d, t_self, p_start,
        (&n_start[0]) as u64, 14)
    let m_destroy: u32 = dex.dex_method(d, t_self, p_v,
        (&n_destroy[0]) as u64, 9)
    let m_load: u32 = dex.dex_method(d, t_sys, p_load,
        (&n_load[0]) as u64, 11)
    let s_lib: u32 = dex.dex_str(d, lib, libn)

    // <clinit>: const-string v0, "<lib>"; invoke-static {v0}, loadLibrary
    let c_cl: i32 = dex.dex_code(d, 1 as u32, 0 as u32, 1 as u32)
    dex.dex_op21c(d, c_cl, dex.OP_CONST_STRING, 0 as u32, s_lib)
    dex.dex_op35c(d, c_cl, dex.OP_INVOKE_STATIC, 1 as u32, m_load,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_cl, dex.OP_RETURN_VOID)
    // <init>: invoke-direct {v0}, Service.<init>
    let c_in: i32 = dex.dex_code(d, 1 as u32, 1 as u32, 1 as u32)
    dex.dex_op35c(d, c_in, dex.OP_INVOKE_DIRECT, 1 as u32, m_super,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_in, dex.OP_RETURN_VOID)

    let k: u32 = dex.dex_class(d, t_self, dex.ACC_PUBLIC, t_svc)
    let nat: u32 = dex.ACC_PUBLIC | dex.ACC_NATIVE
    dex.dex_member(d, k, dex.G_DIREKT, m_clinit,
        dex.ACC_STATIC | dex.ACC_CONSTRUCTOR, c_cl)
    dex.dex_member(d, k, dex.G_DIREKT, m_init,
        dex.ACC_PUBLIC | dex.ACC_CONSTRUCTOR, c_in)
    dex.dex_member(d, k, dex.G_VIRTUELL, m_bind, nat, 0 - 1)
    dex.dex_member(d, k, dex.G_VIRTUELL, m_start, nat, 0 - 1)
    dex.dex_member(d, k, dex.G_VIRTUELL, m_destroy, nat, 0 - 1)
    // ---- org.firn.FirnPick (lib/plat/android/pick.fi): an invisible
    // activity that asks the system for a photo and gets the answer.
    //
    //     public class FirnPick extends android.app.Activity {
    //         static { System.loadLibrary("<lib>"); }
    //         public FirnPick() { super(); }
    //         protected void onCreate(Bundle b) { super.onCreate(b); pick(); }
    //         public native void pick();
    //         public native void onActivityResult(int req, int res, Intent d);
    //     }
    var c_pick: [u8; 21] = "Lorg/firn/FirnPick;\0\0"
    var c_act: [u8; 23] = "Landroid/app/Activity;\0"
    var c_bun: [u8; 20] = "Landroid/os/Bundle;\0"
    let t_pick: u32 = s_(d, (&c_pick[0]) as u64, 19)
    let t_act: u32 = s_(d, (&c_act[0]) as u64, 22)
    let t_bun: u32 = s_(d, (&c_bun[0]) as u64, 19)
    ar[0] = t_bun
    let p_bun: u32 = dex.dex_proto(d, t_v, par, 1)
    ar[0] = t_i
    ar[1] = t_i
    ar[2] = t_int
    let p_res: u32 = dex.dex_proto(d, t_v, par, 3)
    var n_create: [u8; 8] = "onCreate"
    var n_pick: [u8; 4] = "pick"
    var n_res: [u8; 16] = "onActivityResult"
    let m_asuper: u32 = dex.dex_method(d, t_act, p_v, (&n_init[0]) as u64, 6)
    let m_acreate: u32 = dex.dex_method(d, t_act, p_bun, (&n_create[0]) as u64, 8)
    let m_pinit: u32 = dex.dex_method(d, t_pick, p_v, (&n_init[0]) as u64, 6)
    let m_pclinit: u32 = dex.dex_method(d, t_pick, p_v, (&n_clinit[0]) as u64, 8)
    let m_pcreate: u32 = dex.dex_method(d, t_pick, p_bun, (&n_create[0]) as u64, 8)
    let m_ppick: u32 = dex.dex_method(d, t_pick, p_v, (&n_pick[0]) as u64, 4)
    let m_pres: u32 = dex.dex_method(d, t_pick, p_res, (&n_res[0]) as u64, 16)
    let c_pcl: i32 = dex.dex_code(d, 1 as u32, 0 as u32, 1 as u32)
    dex.dex_op21c(d, c_pcl, dex.OP_CONST_STRING, 0 as u32, s_lib)
    dex.dex_op35c(d, c_pcl, dex.OP_INVOKE_STATIC, 1 as u32, m_load,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_pcl, dex.OP_RETURN_VOID)
    let c_pin: i32 = dex.dex_code(d, 1 as u32, 1 as u32, 1 as u32)
    dex.dex_op35c(d, c_pin, dex.OP_INVOKE_DIRECT, 1 as u32, m_asuper,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_pin, dex.OP_RETURN_VOID)
    // onCreate: v0 = this, v1 = the bundle
    let c_pcr: i32 = dex.dex_code(d, 2 as u32, 2 as u32, 2 as u32)
    dex.dex_op35c(d, c_pcr, dex.OP_INVOKE_SUPER, 2 as u32, m_acreate,
        0 as u32, 1 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op35c(d, c_pcr, dex.OP_INVOKE_VIRTUAL, 1 as u32, m_ppick,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_pcr, dex.OP_RETURN_VOID)
    let kp: u32 = dex.dex_class(d, t_pick, dex.ACC_PUBLIC, t_act)
    dex.dex_member(d, kp, dex.G_DIREKT, m_pclinit,
        dex.ACC_STATIC | dex.ACC_CONSTRUCTOR, c_pcl)
    dex.dex_member(d, kp, dex.G_DIREKT, m_pinit,
        dex.ACC_PUBLIC | dex.ACC_CONSTRUCTOR, c_pin)
    dex.dex_member(d, kp, dex.G_VIRTUELL, m_pcreate, dex.ACC_PROTECTED, c_pcr)
    dex.dex_member(d, kp, dex.G_VIRTUELL, m_ppick, nat, 0 - 1)
    dex.dex_member(d, kp, dex.G_VIRTUELL, m_pres, nat, 0 - 1)

    // ---- org.firn.FirnInstall (lib/@android/appkit/platform.fi): the
    // receiver that gets the PackageInstaller answer of appkit's updater.
    //
    //     public class FirnInstall extends android.content.BroadcastReceiver {
    //         static { System.loadLibrary("<lib>"); }
    //         public FirnInstall() { super(); }
    //         public native void onReceive(Context c, Intent i);
    //     }
    var c_inst: [u8; 24] = "Lorg/firn/FirnInstall;\0\0"
    var c_recv: [u8; 40] = "Landroid/content/BroadcastReceiver;\0\0\0\0\0"
    var c_ctx: [u8; 28] = "Landroid/content/Context;\0\0\0"
    let t_inst: u32 = s_(d, (&c_inst[0]) as u64, 22)
    let t_recv: u32 = s_(d, (&c_recv[0]) as u64, 35)
    let t_ctx: u32 = s_(d, (&c_ctx[0]) as u64, 25)
    ar[0] = t_ctx
    ar[1] = t_int
    let p_recv: u32 = dex.dex_proto(d, t_v, par, 2)
    var n_recv: [u8; 9] = "onReceive"
    let m_rsuper: u32 = dex.dex_method(d, t_recv, p_v, (&n_init[0]) as u64, 6)
    let m_rinit: u32 = dex.dex_method(d, t_inst, p_v, (&n_init[0]) as u64, 6)
    let m_rclinit: u32 = dex.dex_method(d, t_inst, p_v, (&n_clinit[0]) as u64, 8)
    let m_rrecv: u32 = dex.dex_method(d, t_inst, p_recv, (&n_recv[0]) as u64, 9)
    let c_rcl: i32 = dex.dex_code(d, 1 as u32, 0 as u32, 1 as u32)
    dex.dex_op21c(d, c_rcl, dex.OP_CONST_STRING, 0 as u32, s_lib)
    dex.dex_op35c(d, c_rcl, dex.OP_INVOKE_STATIC, 1 as u32, m_load,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_rcl, dex.OP_RETURN_VOID)
    let c_rin: i32 = dex.dex_code(d, 1 as u32, 1 as u32, 1 as u32)
    dex.dex_op35c(d, c_rin, dex.OP_INVOKE_DIRECT, 1 as u32, m_rsuper,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_rin, dex.OP_RETURN_VOID)
    let kr: u32 = dex.dex_class(d, t_inst, dex.ACC_PUBLIC, t_recv)
    dex.dex_member(d, kr, dex.G_DIREKT, m_rclinit,
        dex.ACC_STATIC | dex.ACC_CONSTRUCTOR, c_rcl)
    dex.dex_member(d, kr, dex.G_DIREKT, m_rinit,
        dex.ACC_PUBLIC | dex.ACC_CONSTRUCTOR, c_rin)
    dex.dex_member(d, kr, dex.G_VIRTUELL, m_rrecv, nat, 0 - 1)

    // ---- org.firn.FirnMain: the launcher activity. A tap on a notification
    // while the app is OPEN delivers a new intent to the running activity
    // (launchMode singleTop in the manifest); NativeActivity does not keep it,
    // so onNewIntent stores it with setIntent and the app reads the chat id
    // from getIntent() (lib/plat/android/push.fi push_intent_cid).
    //
    //     public class FirnMain extends android.app.NativeActivity {
    //         public FirnMain() { super(); }
    //         protected void onNewIntent(Intent i) { super.onNewIntent(i); setIntent(i); }
    //     }
    var c_main: [u8; 20] = "Lorg/firn/FirnMain;\0"
    var c_nat: [u8; 31] = "Landroid/app/NativeActivity;\0\0\0"
    let t_main: u32 = s_(d, (&c_main[0]) as u64, 19)
    let t_nat: u32 = s_(d, (&c_nat[0]) as u64, 28)
    ar[0] = t_int
    let p_newint: u32 = dex.dex_proto(d, t_v, par, 1)
    var n_newint: [u8; 11] = "onNewIntent"
    var n_setint: [u8; 9] = "setIntent"
    let m_nsuper: u32 = dex.dex_method(d, t_nat, p_v, (&n_init[0]) as u64, 6)
    let m_minit: u32 = dex.dex_method(d, t_main, p_v, (&n_init[0]) as u64, 6)
    let m_nsup_new: u32 = dex.dex_method(d, t_nat, p_newint, (&n_newint[0]) as u64, 11)
    let m_mnew: u32 = dex.dex_method(d, t_main, p_newint, (&n_newint[0]) as u64, 11)
    let m_setint: u32 = dex.dex_method(d, t_act, p_newint, (&n_setint[0]) as u64, 9)
    let c_min: i32 = dex.dex_code(d, 1 as u32, 1 as u32, 1 as u32)
    dex.dex_op35c(d, c_min, dex.OP_INVOKE_DIRECT, 1 as u32, m_nsuper,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_min, dex.OP_RETURN_VOID)
    // onNewIntent: v0 = this, v1 = the intent
    let c_mnew: i32 = dex.dex_code(d, 2 as u32, 2 as u32, 2 as u32)
    dex.dex_op35c(d, c_mnew, dex.OP_INVOKE_SUPER, 2 as u32, m_nsup_new,
        0 as u32, 1 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op35c(d, c_mnew, dex.OP_INVOKE_VIRTUAL, 2 as u32, m_setint,
        0 as u32, 1 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_mnew, dex.OP_RETURN_VOID)
    let km: u32 = dex.dex_class(d, t_main, dex.ACC_PUBLIC, t_nat)
    dex.dex_member(d, km, dex.G_DIREKT, m_minit,
        dex.ACC_PUBLIC | dex.ACC_CONSTRUCTOR, c_min)
    dex.dex_member(d, km, dex.G_VIRTUELL, m_mnew, dex.ACC_PROTECTED, c_mnew)

    // ---- org.firn.FirnCrash: the uncaught-exception handler. A ThreadGroup
    // IS a Thread.UncaughtExceptionHandler, so the class needs no interface
    // list: the native method overrides ThreadGroup.uncaughtException and
    // lib/plat/android/javaexc.fi (Java_org_firn_FirnCrash_uncaughtException)
    // writes the stack trace to a file, then hands the exception to the
    // handler that was installed before (Android's own: it kills the app).
    //
    //     public class FirnCrash extends java.lang.ThreadGroup {
    //         static { System.loadLibrary("<lib>"); }
    //         public FirnCrash(String name) { super(name); }
    //         public native void uncaughtException(Thread t, Throwable e);
    //     }
    //
    // org.firn.FirnBoom is the test hook: a thread whose run() is native and
    // throws (javaexc.fi je_test_throw), so a check can make a REAL uncaught
    // exception on a Java thread.
    //
    //     public class FirnBoom extends java.lang.Thread {
    //         static { System.loadLibrary("<lib>"); }
    //         public FirnBoom() { super(); }
    //         public native void run();
    //     }
    var c_crash: [u8; _] = "Lorg/firn/FirnCrash;\0"
    var c_tgrp: [u8; _] = "Ljava/lang/ThreadGroup;\0"
    var c_thr: [u8; _] = "Ljava/lang/Thread;\0"
    var c_thw: [u8; _] = "Ljava/lang/Throwable;\0"
    var c_boom: [u8; _] = "Lorg/firn/FirnBoom;\0"
    let t_crash: u32 = s_(d, (&c_crash[0]) as u64, 20)
    let t_tgrp: u32 = s_(d, (&c_tgrp[0]) as u64, 23)
    let t_thr: u32 = s_(d, (&c_thr[0]) as u64, 18)
    let t_thw: u32 = s_(d, (&c_thw[0]) as u64, 21)
    let t_boom: u32 = s_(d, (&c_boom[0]) as u64, 19)
    ar[0] = t_thr
    ar[1] = t_thw
    let p_unc: u32 = dex.dex_proto(d, t_v, par, 2)
    ar[0] = t_str
    let p_str1: u32 = dex.dex_proto(d, t_v, par, 1)
    var n_unc: [u8; _] = "uncaughtException\0"
    var n_run: [u8; _] = "run\0"
    let m_tgsuper: u32 = dex.dex_method(d, t_tgrp, p_str1, (&n_init[0]) as u64, 6)
    let m_cinit: u32 = dex.dex_method(d, t_crash, p_str1, (&n_init[0]) as u64, 6)
    let m_cclinit: u32 = dex.dex_method(d, t_crash, p_v, (&n_clinit[0]) as u64, 8)
    let m_cunc: u32 = dex.dex_method(d, t_crash, p_unc, (&n_unc[0]) as u64, 17)
    let m_thsuper: u32 = dex.dex_method(d, t_thr, p_v, (&n_init[0]) as u64, 6)
    let m_binit: u32 = dex.dex_method(d, t_boom, p_v, (&n_init[0]) as u64, 6)
    let m_bclinit: u32 = dex.dex_method(d, t_boom, p_v, (&n_clinit[0]) as u64, 8)
    let m_brun: u32 = dex.dex_method(d, t_boom, p_v, (&n_run[0]) as u64, 3)
    let c_ccl: i32 = dex.dex_code(d, 1 as u32, 0 as u32, 1 as u32)
    dex.dex_op21c(d, c_ccl, dex.OP_CONST_STRING, 0 as u32, s_lib)
    dex.dex_op35c(d, c_ccl, dex.OP_INVOKE_STATIC, 1 as u32, m_load,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_ccl, dex.OP_RETURN_VOID)
    // <init>(String): v0 = this, v1 = the name
    let c_cin: i32 = dex.dex_code(d, 2 as u32, 2 as u32, 2 as u32)
    dex.dex_op35c(d, c_cin, dex.OP_INVOKE_DIRECT, 2 as u32, m_tgsuper,
        0 as u32, 1 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_cin, dex.OP_RETURN_VOID)
    let kc: u32 = dex.dex_class(d, t_crash, dex.ACC_PUBLIC, t_tgrp)
    dex.dex_member(d, kc, dex.G_DIREKT, m_cclinit,
        dex.ACC_STATIC | dex.ACC_CONSTRUCTOR, c_ccl)
    dex.dex_member(d, kc, dex.G_DIREKT, m_cinit,
        dex.ACC_PUBLIC | dex.ACC_CONSTRUCTOR, c_cin)
    dex.dex_member(d, kc, dex.G_VIRTUELL, m_cunc, nat, 0 - 1)
    let c_bcl: i32 = dex.dex_code(d, 1 as u32, 0 as u32, 1 as u32)
    dex.dex_op21c(d, c_bcl, dex.OP_CONST_STRING, 0 as u32, s_lib)
    dex.dex_op35c(d, c_bcl, dex.OP_INVOKE_STATIC, 1 as u32, m_load,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_bcl, dex.OP_RETURN_VOID)
    let c_bin: i32 = dex.dex_code(d, 1 as u32, 1 as u32, 1 as u32)
    dex.dex_op35c(d, c_bin, dex.OP_INVOKE_DIRECT, 1 as u32, m_thsuper,
        0 as u32, 0 as u32, 0 as u32, 0 as u32, 0 as u32)
    dex.dex_op10x(d, c_bin, dex.OP_RETURN_VOID)
    let kb: u32 = dex.dex_class(d, t_boom, dex.ACC_PUBLIC, t_thr)
    dex.dex_member(d, kb, dex.G_DIREKT, m_bclinit,
        dex.ACC_STATIC | dex.ACC_CONSTRUCTOR, c_bcl)
    dex.dex_member(d, kb, dex.G_DIREKT, m_binit,
        dex.ACC_PUBLIC | dex.ACC_CONSTRUCTOR, c_bin)
    dex.dex_member(d, kb, dex.G_VIRTUELL, m_brun, nat, 0 - 1)

    if dex.dex_error(d) != 0 as u32 {
        var f: [u8; 26] = "servicedex: writer failed\n"
        rt.write_everything(2, (&f[0]) as u64, 26)
        return 4
    }
    let buf: u64 = rt.heap_alloc(CAP)
    let n: usize = dex.dex_build(d, buf, CAP)
    if n == 0 {
        return 5
    }
    if !rt.write_file(out, buf, n) {
        return 6
    }
    return 0
}
