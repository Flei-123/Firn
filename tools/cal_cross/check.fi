// tools/cal_cross/check.fi -- cal.rrule against the expansion lists written by gen.py (dateutil).
//   check <cases file>      exit 0 = no difference. Last line: "cal cross-check: N cases, D differences"
import std.rt
import std.fs
import std.vec
import cal.civil
import cal.rrule

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn at(s: str, i: usize) -> u8 {
    return rt.ld8(s.p as u64, i)
}

fn sub(s: str, a: usize, b: usize) -> str {
    return str { p: s.p + a, n: b - a }
}

// Splits a line into at most 8 tab separated fields.
fn split(line: str, fa: *mut Vec[usize], fb: *mut Vec[usize]) {
    vec_clear[usize](fa)
    vec_clear[usize](fb)
    var a: usize = 0
    var i: usize = 0
    while i <= line.n {
        if i == line.n || at(line, i) == 9 as u8 {
            vec_push[usize](fa, a)
            vec_push[usize](fb, i)
            a = i + 1
        }
        i = i + 1
    }
}

fn to_i64(s: str) -> i64 {
    var i: usize = 0
    var neg: bool = false
    var v: i64 = 0
    if s.n > 0 && at(s, 0) == 45 as u8 {
        neg = true
        i = 1
    }
    while i < s.n {
        v = v * 10 + ((at(s, i) - 48 as u8) as i64)
        i = i + 1
    }
    if neg {
        return 0 - v
    }
    return v
}

fn parse_list(s: str, out: *mut Vec[i64]) {
    var a: usize = 0
    var i: usize = 0
    while i <= s.n {
        if i == s.n || at(s, i) == 44 as u8 {
            if i > a {
                vec_push[i64](out, to_i64(sub(s, a, i)))
            }
            a = i + 1
        }
        i = i + 1
    }
}

fn render(v: *mut Vec[i64], b: *mut rt.Buf) {
    var i: usize = 0
    while i < vec_len[i64](v) {
        if i > 0 {
            rt.buf_push(b, 44 as u8)
        }
        rt.buf_push_dec_i64(b, vec_at[i64](v, i))
        i = i + 1
    }
}

static mut diffs_shown: i32 = 0

fn differ(line_no: usize, text: str, got: *mut rt.Buf, want: str) {
    if diffs_shown < 12 {
        diffs_shown = diffs_shown + 1
        say("  DIFF line ")
        var b: rt.Buf = rt.buf_new()
        rt.buf_push_dec_i64(&b, line_no as i64)
        rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
        rt.buf_free(&b)
        say(": ")
        say(text)
        say("\n    got  ")
        rt.write_everything(1, rt.buf_ptr(got), rt.buf_len(got))
        say("\n    want ")
        say(want)
        say("\n")
    }
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        say("usage: check <cases file>\n")
        return 2
    }
    let a1: u64 = rt.arg_ptr(start, 1)
    let path: str = str { p: a1 as *mut u8, n: rt.c_length(a1) }
    var data: rt.Buf = rt.buf_new()
    fs.read_file(path, &data) catch 0
    if rt.buf_len(&data) == 0 {
        say("no cases\n")
        return 2
    }
    let total: usize = rt.buf_len(&data)
    let base: *mut u8 = rt.buf_data(&data)
    var fa: Vec[usize] = vec_new[usize]()
    var fb: Vec[usize] = vec_new[usize]()
    var cases: usize = 0
    var diffs: usize = 0
    var line_no: usize = 0
    var pos: usize = 0
    while pos < total {
        var e: usize = pos
        while e < total && *(base + e) != 10 as u8 {
            e = e + 1
        }
        let line: str = str { p: base + pos, n: e - pos }
        pos = e + 1
        line_no = line_no + 1
        if line.n == 0 {
            continue
        }
        split(line, &fa, &fb)
        let kind: u8 = at(line, 0)
        let dtstart: i64 = to_i64(sub(line, vec_at[usize](&fa, 1), vec_at[usize](&fb, 1)))
        let rtext: str = sub(line, vec_at[usize](&fa, 2), vec_at[usize](&fb, 2))
        var r: rrule.Rule = rrule.rule_new()
        var out: Vec[i64] = vec_new[i64]()
        var got: rt.Buf = rt.buf_new()
        var want: str = ""
        let code: u32 = rrule.parse(rtext, &r)
        if code != rrule.E_OK {
            rt.buf_push_dec_i64(&got, 0 - (code as i64))
            want = sub(line, vec_at[usize](&fa, 5), vec_at[usize](&fb, 5))
            differ(line_no, rtext, &got, want)
            diffs = diffs + 1
        } else if kind == 82 as u8 {
            let lo: i64 = to_i64(sub(line, vec_at[usize](&fa, 3), vec_at[usize](&fb, 3)))
            let hi: i64 = to_i64(sub(line, vec_at[usize](&fa, 4), vec_at[usize](&fb, 4)))
            want = sub(line, vec_at[usize](&fa, 5), vec_at[usize](&fb, 5))
            rrule.expand(&r, dtstart, lo, hi, 40, &out)
            render(&out, &got)
            if !(rt.buf_len(&got) == want.n && rt.mem_eq(rt.buf_ptr(&got), want.p as u64, want.n)) {
                differ(line_no, rtext, &got, want)
                diffs = diffs + 1
            }
        } else {
            var rd: Vec[i64] = vec_new[i64]()
            var ex: Vec[i64] = vec_new[i64]()
            parse_list(sub(line, vec_at[usize](&fa, 3), vec_at[usize](&fb, 3)), &rd)
            parse_list(sub(line, vec_at[usize](&fa, 4), vec_at[usize](&fb, 4)), &ex)
            want = sub(line, vec_at[usize](&fa, 5), vec_at[usize](&fb, 5))
            rrule.expand_set(&r, true, dtstart, &rd, &ex, 0 - rrule.FAR, rrule.FAR, 40, &out)
            render(&out, &got)
            if !(rt.buf_len(&got) == want.n && rt.mem_eq(rt.buf_ptr(&got), want.p as u64, want.n)) {
                differ(line_no, rtext, &got, want)
                diffs = diffs + 1
            }
            vec_free[i64](&rd)
            vec_free[i64](&ex)
        }
        cases = cases + 1
        rrule.rule_free(&r)
        vec_free[i64](&out)
        rt.buf_free(&got)
    }
    say("cal cross-check: ")
    var b: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b, cases as i64)
    rt.write_everything(1, rt.buf_ptr(&b), rt.buf_len(&b))
    rt.buf_free(&b)
    say(" cases, ")
    var b2: rt.Buf = rt.buf_new()
    rt.buf_push_dec_i64(&b2, diffs as i64)
    rt.write_everything(1, rt.buf_ptr(&b2), rt.buf_len(&b2))
    rt.buf_free(&b2)
    say(" differences\n")
    if diffs > 0 {
        return 1
    }
    return 0
}
