// SPDX-License-Identifier: MPL-2.0
// tools/db/expr_probe.fi -- evaluates constant expressions: one per line of the file argv[1];
// prints "I:<int>" "R:<hex bits>" "T:<hex octets>" "B:<hex octets>" "N" or "E:<message>".
// tools/db/check_expr.py compares with SQLite.
import std.rt
import std.io
import std.fs
import db.dberr
import db.sqlast as ax
import db.sqlparse as sp
import db.record as rc
import db.arena as ar
import db.dbcore as dc
import db.expr as ex

fn put_hex(out: *mut rt.Buf, p: u64, n: usize) {
    var i: usize = 0
    while i < n {
        rt.buf_push_hex_u64(out, rt.ld8(p, i) as u64, 2)
        i = i + 1
    }
}

fn run_one(line: str, out: *mut rt.Buf) -> DbError!bool {
    var ast: ax.Ast = ax.ast_new()
    var text: rt.Buf = rt.buf_new()
    util_put(&text, "SELECT ")
    rt.buf_push_bytes(&text, line.p as u64, line.length())
    var ps: sp.Parser = sp.parser_new(&ast, rt.buf_ptr(&text), rt.buf_len(&text))
    let root: i32 = try sp.parse_stmt(&ps)
    let sel: *mut ax.Node = ax.ast_n(&ast, root)
    let rcnode: *mut ax.Node = ax.ast_n(&ast, (*sel).a)
    var sc: ex.Scope = ex.scope_new()
    try ex.resolve_expr(&sc, &ast, (*rcnode).a, false, false)
    var db: dc.Db = dc.db_new()
    var arena: ar.Arena = ar.arena_new()
    var cx: ex.Ctx = ex.ctx_new(&db, &ast, &arena)
    cx.scope = &sc
    let v: rc.Val = try ex.eval(&cx, (*rcnode).a)
    if v.t == 0 {
        rt.buf_push(out, 78 as u8)
    } else if v.t == 1 {
        rt.buf_push(out, 73 as u8)
        rt.buf_push(out, 58 as u8)
        rt.buf_push_dec_i64(out, v.i)
    } else if v.t == 2 {
        rt.buf_push(out, 82 as u8)
        rt.buf_push(out, 58 as u8)
        rt.buf_push_hex_u64(out, rc.bits_of_f64(v.f), 16)
    } else if v.t == 3 {
        rt.buf_push(out, 84 as u8)
        rt.buf_push(out, 58 as u8)
        put_hex(out, v.p, v.n)
    } else {
        rt.buf_push(out, 66 as u8)
        rt.buf_push(out, 58 as u8)
        put_hex(out, v.p, v.n)
    }
    ar.arena_free(&arena)
    ax.ast_free(&ast)
    rt.buf_free(&text)
    return true
}

fn util_put(b: *mut rt.Buf, s: str) {
    rt.buf_push_bytes(b, s.p as u64, s.length())
}

fn main(start: u64) -> i32 {
    let a: u64 = rt.arg_ptr(start, 1)
    let path: str = str { p: rt.ptr_of(a), n: rt.c_length(a) }
    var data: rt.Buf = rt.buf_new()
    fs.read_file(path, &data) catch 0
    var pos: usize = 0
    let n: usize = rt.buf_len(&data)
    while pos < n {
        var e: usize = pos
        while e < n && rt.ld8(rt.buf_ptr(&data), e) != 10 as u8 {
            e = e + 1
        }
        let line: str = str { p: rt.ptr_of(rt.buf_ptr(&data) + (pos as u64)), n: e - pos }
        var out: rt.Buf = rt.buf_new()
        let ok: bool = run_one(line, &out) catch | er | (false)
        if !ok {
            rt.buf_clear(&out)
            util_put(&out, "E:")
            let m: str = dberr.last_message()
            rt.buf_push_bytes(&out, m.p as u64, m.length())
        }
        rt.buf_push(&out, 10 as u8)
        io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
        rt.buf_free(&out)
        pos = e + 1
    }
    return 0
}
