// tools/db/parse_probe.fi -- parse the statements of argv[1]; prints "OK <n statements>"
// or "ERR <kind> <message>". tools/db/check_parse.py compares with SQLite.
import std.rt
import std.io
import db.dberr
import db.sqlast
import db.sqlparse

fn main(start: u64) -> i32 {
    let a: u64 = rt.arg_ptr(start, 1)
    let sql: str = str { p: rt.ptr_of(a), n: rt.c_length(a) }
    var ast: sqlast.Ast = sqlast.ast_new()
    var ps: sqlparse.Parser = sqlparse.parser_new(&ast, sql.p as u64, sql.length())
    var n: i64 = 0
    while true {
        let r: i32 = sqlparse.parse_stmt(&ps) catch | e | (0 - 7)
        if r == 0 - 7 {
            io.eprint("ERR ")
            io.eprint_line(dberr.last_message())
            return 1
        }
        if r < 0 {
            break
        }
        n = n + 1
        sqlast.ast_clear(&ast)
    }
    io.fmt_print_line(io.fmt_number(io.fmt_text(io.fmt_new(), "OK ".p as u64, 3), n))
    return 0
}
