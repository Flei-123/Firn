// expect_exit: 14
// tools/lsp/sample.fi -- the file the LSP counter-check in
// tools/lsp/client.py works on. It contains exactly what the server has to
// find: a struct with a field that has the same name as a local variable,
// a constant, two functions with a local of their own each, and a call.
const LIMIT: i32 = 3

struct Point {
    count: i32,
    other: i32,
}

fn total(n: i32) -> i32 {
    var count: i32 = 0
    var k: i32 = 0
    while k < LIMIT {
        count = count + k
        k = k + 1 as i32
    }
    return count
}

fn helper() -> i32 {
    let other_only: i32 = 9
    return other_only
}

fn main() -> i32 {
    let p: Point = Point { count: 2, other: 3 }
    let t: i32 = total(2)
    return t + p.count + helper() as i32
}
