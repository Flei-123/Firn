// tools/regex_look/worst.fi <pattern> <n> -- the time of ONE regex_find of
// <pattern> over "a" repeated <n> times (best of three), in microseconds, on
// stdout. tools/regex_look/run.sh calls it with doubling n and prints the
// growth: x2 per doubling = linear, x4 = quadratic, x8 = cubic, more =
// worse. The patterns are the worst cases of lookaround (see the header of
// lib/regex/regex.fi); none of them finds a match, so the whole text is scanned.
import regex.regex
import std.rt
import std.io

fn never() -> regex.Regex {
    syscall(60, 99, 0, 0, 0, 0, 0)
    return never()
}

fn now_us() -> i64 {
    var ts: [i64; 2] = [0; 2]
    syscall(228, 1, (&ts[0]) as i64, 0, 0, 0, 0)
    return ts[0] * 1000000 + ts[1] / 1000
}

fn read_dec(p: u64) -> usize {
    var v: usize = 0
    var i: usize = 0
    while rt.ld8(p, i) != 0 as u8 {
        v = v * 10 + (rt.ld8(p, i) - 48 as u8) as usize
        i = i + 1
    }
    return v
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    let pp: u64 = rt.arg_ptr(start, 1)
    let pat: str = str { p: pp as *mut u8, n: rt.c_length(pp) }
    let n: usize = read_dec(rt.arg_ptr(start, 2))
    var buf: rt.Buf = rt.buf_new()
    var i: usize = 0
    while i < n {
        rt.buf_push(&buf, 97 as u8)
        i = i + 1
    }
    let text: str = str { p: rt.buf_data(&buf), n: rt.buf_len(&buf) }
    var r: regex.Regex = regex.regex_compile(pat, 0 as u32) catch | e | (never())
    var best: i64 = 0
    var round: i32 = 0
    while round < 3 {
        var m: regex.Match = regex.match_new()
        let t0: i64 = now_us()
        regex.regex_find(&r, text, 0, &m)
        let dt: i64 = now_us() - t0
        if round == 0 || dt < best {
            best = dt
        }
        round = round + 1
    }
    var out: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&out, best as u64)
    rt.buf_push(&out, 10 as u8)
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    rt.buf_free(&out)
    regex.regex_free(&r)
    rt.buf_free(&buf)
    return 0
}
