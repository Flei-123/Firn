// Probe for tools/picture_cross/check.sh: reads manifest.txt in the current directory
// ("file w h" per line), opens each picture with image.picture and writes
// <file>.dec (decoded RGBA) and <file>.rs (resized to w x h), both with a "w h\n" header.
import std.io
import std.fs
import std.rt
import std.text
import image.picture

fn dump(im: *mut picture.Picture, path: str) {
    var out: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&out, picture.width(im) as u64)
    rt.buf_push(&out, 32 as u8)
    rt.buf_push_dec_u64(&out, picture.height(im) as u64)
    rt.buf_push(&out, 10 as u8)
    if picture.ok(im) {
        rt.buf_push_bytes(&out, picture.pixels(im), picture.width(im) * picture.height(im) * 4)
    }
    fs.write_file(path, rt.buf_ptr(&out), rt.buf_len(&out)) catch 0
    rt.buf_free(&out)
}

fn main() -> i32 {
    var man: rt.Buf = rt.buf_new()
    let n: usize = fs.read_file("manifest.txt", &man) catch 0
    let all: str = str { p: rt.buf_ptr(&man) as *mut u8, n: n }
    var i: usize = 0
    while text.field(all, "\n", i).n > 0 {
        let line: str = text.field(all, "\n", i)
        let file: str = text.dup(text.field(line, " ", 0))
        let w: usize = text.int(text.field(line, " ", 1)) as usize
        let h: usize = text.int(text.field(line, " ", 2)) as usize
        var im: picture.Picture = picture.open(file)
        dump(&im, file + ".dec")
        var r: picture.Picture = picture.resized(&im, w, h)
        dump(&r, file + ".rs")
        picture.free(&im)
        picture.free(&r)
        i = i + 1
    }
    io.fmt_print_line(f"files {i}")
    return 0
}
