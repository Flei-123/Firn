// ROUND 84 -- standard input has to reach the program through `firnc run`
// unchanged, and what the program writes to standard error must stay on
// standard error.
import std.io
import std.rt

fn main() -> i32 {
    var b: rt.Buf = rt.buf_new()
    defer rt.buf_free(&b)
    if !io.read_stdin(&b) {
        return 1
    }
    io.print(rt.buf_ptr(&b), rt.buf_len(&b))
    var mark: [u8; 6] = "stderr"
    io.eprintln((&mark[0]) as u64, 6)
    return 0
}
