// ROUND 84 -- everything after the file name belongs to the PROGRAM.
// Prints how many arguments arrived (argv[0] not counted) and then every
// one of them on a line of its own, so the test can compare character for
// character. argv[0] itself is left out: it is the path in the cache and
// says nothing about the passing on.
import std.io
import std.rt

fn main(start: u64) -> i32 {
    let n: usize = rt.arg_count(start)
    var b: rt.Buf = rt.buf_new()
    defer rt.buf_free(&b)
    var head: [u8; 5] = "argc="
    rt.buf_push_bytes(&b, (&head[0]) as u64, 5)
    rt.buf_push_dec_u64(&b, (n - 1) as u64)
    rt.buf_push(&b, 10 as u8)
    io.print(rt.buf_ptr(&b), rt.buf_len(&b))
    var i: usize = 1
    while i < n {
        io.print_c(rt.arg_ptr(start, i))
        io.print_line()
        i = i + 1
    }
    return 0
}
