#!/bin/sh
# ROUND 84 -- what a shebang line calls.
#
#   #!/usr/bin/env firnc-run
#
# `env` looks this script up on the PATH and hands it the script file as the
# first argument; everything the user typed follows. All that is left to do
# is to become `firnc run <file> <args...>` -- `exec`, so that the exit code
# and the signals belong to the program and not to a wrapper.
#
# Where the compiler is: $FIRNC if set, otherwise next to this script,
# otherwise the release build of this repository, otherwise the PATH.
if [ -z "${FIRNC}" ]; then
    here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
    for candidate in \
        "$here/firnc" \
        "$here/../../compiler/target/release/firnc"
    do
        if [ -x "$candidate" ]; then
            FIRNC=$candidate
            break
        fi
    done
fi
[ -n "${FIRNC}" ] || FIRNC=firnc
exec "$FIRNC" run "$@"
