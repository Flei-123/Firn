// tools/rtcache/churn.fi -- the load of tools/rtcache/run.sh: blocks of one
// to eight pages allocated and freed in a rolling window of 64, so the
// program always has some blocks alive and gives the oldest back first.
//   churn <rounds>            rolling window (what the block cache is for)
//   churn <rounds> hold       never frees: every block is a mapping of its
//                             own (the counter-check -- the cache cannot help)
import std.rt
import std.io

fn main(start: u64) -> i32 {
    var rounds: u64 = 0
    let p1: u64 = rt.arg_ptr(start, 1)
    let a1: str = str { p: rt.ptr_of(p1), n: rt.c_length(p1) }
    var i: usize = 0
    while i < a1.n {
        rounds = rounds * 10 + (rt.ld8(a1.p as u64, i) - 48 as u8) as u64
        i = i + 1
    }
    var hold: bool = rt.arg_count(start) > 2
    var win: u64 = rt.heap_alloc(64 * 8)
    var sizes: u64 = rt.heap_alloc(64 * 8)
    var r: u64 = 0
    var sum: u64 = 0
    while r < rounds {
        let slot: usize = (r % 64) as usize
        let old: u64 = rt.ld64(win, slot)
        if old != 0 && !hold {
            rt.heap_free(old, rt.ld64(sizes, slot) as usize)
        }
        let n: usize = ((r % 8) as usize + 1) * 4096 - 64
        let p: u64 = rt.heap_alloc(n)
        if p == 0 {
            return 1
        }
        rt.st64(p, 0, r + 1)
        sum = sum + rt.ld64(p, 0)
        rt.st64(win, slot, p)
        rt.st64(sizes, slot, n as u64)
        r = r + 1
    }
    io.fmt_print_line(f"rounds={rounds} sum={sum}")
    return 0
}
