// tools/textfmt_cross/textfmt_cli.fi -- std.textfmt as a filter for the Python cross-check.
//
// stdin: one case per line, "<bits_hi> <bits_lo> <digits>" (decimal; the two halves
// of the f64 bit pattern). stdout per case: fixed(x, digits), TAB, round_to(x, digits)
// as the u64 bit pattern -- compared against '%.Nf' and round().
import std.rt
import std.io
import std.text
import std.textfmt

#[allow_fp]
fn main() -> i32 {
    var inb: rt.Buf = rt.buf_new()
    io.read_stdin(&inb)
    var out: rt.Buf = rt.buf_new()
    var lr: io.LineReader = io.lines_of_buf(&inb)
    var ap: u64 = 0
    var an: usize = 0
    while io.lines_next(&lr, &ap, &an) {
        let line: str = str { p: ap as *mut u8, n: an }
        let hi: u64 = text.int(text.field(line, " ", 0)) as u64
        let lo: u64 = text.int(text.field(line, " ", 1)) as u64
        let d: usize = text.int(text.field(line, " ", 2)) as usize
        let x: f64 = __f64_from_bits((hi << 32) | lo)
        textfmt.fixed(&out, x, d)
        rt.buf_push(&out, 9 as u8)
        rt.buf_push_dec_u64(&out, __bits(textfmt.round_to(x, d)))
        rt.buf_push(&out, 10 as u8)
    }
    io.print_bytes(rt.buf_ptr(&out), rt.buf_len(&out))
    return 0
}
