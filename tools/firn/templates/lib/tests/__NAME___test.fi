import std.testkit
import __NAME__

#[test]
fn clamp_limits_values() {
    testkit.assert_eq_i64(__NAME__.clamp(15, 0, 10), 10)
    testkit.assert_eq_i64(__NAME__.clamp(0 - 3, 0, 10), 0)
    testkit.assert_eq_i64(__NAME__.clamp(4, 0, 10), 4)
}

#[test]
fn lerp_interpolates() {
    testkit.assert_eq_i64(__NAME__.lerp(0, 100, 1, 4), 25)
}
