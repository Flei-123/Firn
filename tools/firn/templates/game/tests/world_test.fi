import std.testkit
import world

#[test]
fn player_stays_in_lane() {
    var w: world.World = world.world_new()
    w = world.step(w, 0 - 1)
    testkit.assert_eq[i32](w.pos, 0)
    var i: i32 = 0
    while i < 40 {
        w = world.step(w, 1)
        i = i + 1
    }
    testkit.assert_eq[i32](w.pos, 11)
}

#[test]
fn coins_score_points() {
    var w: world.World = world.world_new()
    w = world.step(w, 0)
    testkit.assert_eq[i32](w.score, 1)
    w = world.step(w, 1)
    testkit.assert_eq[i32](w.score, 1)
}
