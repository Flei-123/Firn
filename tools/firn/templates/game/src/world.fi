import std.io

export { World, world_new, step, render }

const LANE: i32 = 12
const COIN_EVERY: i32 = 3

struct World {
    pos: i32,
    tick: i32,
    score: i32,
}

fn world_new() -> World {
    return World { pos: 0, tick: 0, score: 0 }
}

fn step(w: World, dir: i32) -> World {
    var next: i32 = w.pos + dir
    if next < 0 { next = 0 }
    if next >= LANE { next = LANE - 1 }
    var score: i32 = w.score
    if next % COIN_EVERY == 0 { score = score + 1 }
    return World { pos: next, tick: w.tick + 1, score: score }
}

fn render(w: World) -> str {
    var line: str = ""
    var i: i32 = 0
    while i < LANE {
        if i == w.pos {
            line = line + "@"
        } else if i % COIN_EVERY == 0 {
            line = line + "o"
        } else {
            line = line + "."
        }
        i = i + 1
    }
    return line + io.fmt_string(f"  score {w.score}")
}
