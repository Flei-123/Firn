import std.io
import world

const TICKS: i32 = 16

fn main() -> i32 {
    var w: world.World = world.world_new()
    var seed: u32 = 7
    var i: i32 = 0
    while i < TICKS {
        seed = (seed * 75 + 74) % 65537
        var dir: i32 = 1
        if seed % 3 == 0 { dir = 0 - 1 }
        w = world.step(w, dir)
        io.print_line(world.render(w))
        i = i + 1
    }
    return 0
}
