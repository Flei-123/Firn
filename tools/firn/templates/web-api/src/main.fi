import std.rt
import std.io
import webfw.wf_types
import webfw.wf_web
import webfw.wf_ctx
import webfw.wf_text
import greeting

fn hello(c: *mut wf_types.Ctx) {
    wf_ctx.text(c, 200, greeting.greet(wf_ctx.param(c, "name")))
}

fn health(c: *mut wf_types.Ctx) {
    wf_ctx.json_raw(c, 200, "{\"status\": \"ok\"}")
}

fn arg_text(start: u64, k: usize) -> str {
    let p: u64 = rt.arg_ptr(start, k)
    return str { p: p as *mut u8, n: rt.c_length(p) }
}

fn main(start: u64) -> i32 {
    var port: u64 = 8080
    if rt.arg_count(start) > 1 { wf_text.parse_u64(arg_text(start, 1), &port) }
    var w: wf_types.Web = wf_web.web_new(port as u16)
    wf_web.get(&w, "/health", health)
    wf_web.get(&w, "/hello/:name", hello)
    io.print_line(wf_web.url(&w))
    return wf_web.serve(&w)
}
