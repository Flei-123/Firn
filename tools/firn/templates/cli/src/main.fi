import std.io
import std.args
import greet

fn main(start: u64) -> i32 {
    var cmd: args.Cmd = args.cmd("__NAME__", "__NAME__ command line tool")
    args.opt(&cmd, "--name", args.STR, "world", "who to greet")
    args.opt(&cmd, "--times", args.INT, "1", "how often")
    var parsed: args.Result = args.parse_argv(&cmd, start)
    if parsed.status == args.HELP {
        io.print_line(parsed.text)
        return 0
    }
    if parsed.status != args.OK {
        io.print_line(parsed.text)
        return 2
    }
    let times: i64 = args.get_int(&parsed, "times")
    var i: i64 = 0
    while i < times {
        io.print_line(greet.greeting(args.get(&parsed, "name")))
        i = i + 1
    }
    return 0
}
