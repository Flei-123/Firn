// SPDX-License-Identifier: MPL-2.0
// tools/fui/tfwin_main.fi -- r459: a transformed shape rasterised in the painter's own buffer (shared window) gives the SAME picture as
// one rasterised in a buffer of its own (window larger than the painter's buffer).
//
//     firnc -o /tmp/tfwin tools/fui/tfwin_main.fi && /tmp/tfwin
import std.rt
import paint.canvas
import fui.painter
import fui.transform

static mut SEED: u64 = 88172645463325252

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn rnd(n: u64) -> u64 {
    SEED = SEED ^ (SEED << 13)
    SEED = SEED ^ (SEED >> 7)
    SEED = SEED ^ (SEED << 17)
    return SEED % n
}

fn main(start: u64) -> i32 {
    let cw: usize = 640
    let ch: usize = 360
    var ca: canvas.Canvas = canvas.canvas_new()
    var cb: canvas.Canvas = canvas.canvas_new()
    var za: painter.Painter = painter.painter_new()
    var zb: painter.Painter = painter.painter_new()
    // A: buffer for the whole canvas (shared window); B: a tiny buffer (every window gets its own)
    if !canvas.canvas_init(&ca, cw, ch) || !canvas.canvas_init(&cb, cw, ch)
    || !painter.painter_init(&za, &ca, cw, ch) || !painter.painter_init(&zb, &cb, 8, 8) {
        say("tfwin: no canvas\n")
        return 9
    }
    canvas.canvas_clear(&ca, 0xff203040 as u32)
    canvas.canvas_clear(&cb, 0xff203040 as u32)
    var xf: transform.Xform = transform.xf_new()
    var i: usize = 0
    while i < 120 {
        transform.xf_reset(&xf)
        let cx: f64 = (rnd(500) as f64) + 60.0
        let cy: f64 = (rnd(240) as f64) + 60.0
        transform.xf_rotate_at(&xf, (rnd(3600) as f64) / 10.0, cx, cy)
        let w: f64 = (rnd(120) as f64) + 20.0
        let h: f64 = (rnd(120) as f64) + 20.0
        let r: f64 = (rnd(30) as f64)
        let col: u32 = (0xff000000 as u32) | (rnd(16777216) as u32)
        if i % 3 == 0 {
            transform.tf_fill_round_rect(&za, &xf, cx - w / 2.0, cy - h / 2.0, w, h, 0.0, col)
            transform.tf_fill_round_rect(&zb, &xf, cx - w / 2.0, cy - h / 2.0, w, h, 0.0, col)
        } else {
            transform.tf_fill_round_rect(&za, &xf, cx - w / 2.0, cy - h / 2.0, w, h, r, col)
            transform.tf_fill_round_rect(&zb, &xf, cx - w / 2.0, cy - h / 2.0, w, h, r, col)
        }
        i = i + 1
    }
    let p: *mut u8 = canvas.canvas_pixels(&ca)
    let q: *mut u8 = canvas.canvas_pixels(&cb)
    var bad: usize = 0
    var k: usize = 0
    while k < cw * ch * 4 {
        if rt.ld8(p as u64, k) != rt.ld8(q as u64, k) {
            bad = bad + 1
        }
        k = k + 1
    }
    if bad == 0 {
        say("TFWIN PASSED (120 shapes, shared window == own buffer)\n")
        return 0
    }
    say("TFWIN FAILED\n")
    return 1
}
