// tools/fui/rechook_main.fi -- live program for tools/fui/rechook.sh: a window with one entry and a Quit button.
// Run with FUI_RECORD=<file>: the event log is written when the window closes (Quit).
import std.rt
import fui.app

fn on_quit(a: *mut app.App) {
    app.quit(a)
}

fn main(start: u64) -> i32 {
    let a: *mut app.App = app.window("Recorder hook", 320, 200)
    let l: usize = app.label(a, "Type, then Quit", 0)
    let en: usize = app.entry(a, "Text")
    let qb: usize = app.button(a, "Quit", on_quit)
    return app.run(a)
}
