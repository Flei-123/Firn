// tools/fui/kitdash_main.fi -- CHECK OF lib/fui/kitfmt.fi (string builders), kitplot.fi (series), kitdash.fi (page grid, segmented switch). No window.
//
//     firnc -o /tmp/kitdash tools/fui/kitdash_main.fi && /tmp/kitdash     (last line: KITDASH PASSED / KITDASH FAILED)
import std.rt
import fui.theme
import fui.render
import fui.painter
import fui.kitfmt
import fui.kitdash

static mut BAD: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn same(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if *((a.p as u64 + i as u64) as *mut u8) != *((b.p as u64 + i as u64) as *mut u8) { return false }
        i = i + 1
    }
    return true
}

#[allow_escape]
fn main() -> i32 {
    check(same(kitfmt.uint(48210, true), "48,210"), "uint with separators")
    check(same(kitfmt.uint(7, true), "7"), "uint one digit")
    check(same(kitfmt.uint(1234567, false), "1234567"), "uint without separators")
    check(same(kitfmt.dec(3.84, 1), "3.8"), "dec one place")
    check(same(kitfmt.dec(0.05, 1), "0.1"), "dec rounds half up")
    check(same(kitfmt.dec(2.05, 2), "2.05"), "dec keeps the zero of a place")
    check(same(kitfmt.dec(0.0 - 2.3, 1), "-2.3"), "dec negative")
    check(same(kitfmt.signed(12.4, 1), "+12.4"), "signed positive")
    check(same(kitfmt.upper("Users 7d"), "USERS 7D"), "upper case")
    check(same(kitfmt.join3("a", "b", "c"), "abc"), "join3")
    check(same(kitfmt.slice("2026-10-21 11:55", 11, 5), "11:55"), "slice")
    check(same(kitfmt.slice("abc", 5, 2), ""), "slice past the end is empty")
    check(kitfmt.leading_uint("30d") == 30, "leading_uint")
    var m: theme.Theme = theme.theme_new(true)
    var z: painter.Painter = painter.painter_new()
    let c: render.Ctx = render.ctx_new(&m, &z)
    let p: kitdash.Page = kitdash.page(&c, 1100.0, 700.0, 40.0, 98.0, 1.0, 1.05, 0.0)
    check(p.ky == 78.0 && p.y1 == 192.0, "page: KPI row at 78, chart row at 192")
    check(p.h1 + p.h2 + 16.0 + p.y1 == 678.0, "page: rows end 22 above the bottom")
    check(p.wide * 1.5 + 7.0 > p.wide + p.narrow, "page: wide column is twice the narrow one")
    var sg: kitdash.Seg = kitdash.seg_new()
    sg.n = 3
    sg.x0 = 100.0
    sg.y0 = 10.0
    sg.h = 30.0
    sg.edge[0] = 100.0
    sg.edge[1] = 150.0
    sg.edge[2] = 200.0
    sg.edge[3] = 260.0
    check(kitdash.seg_hit(&sg, 120.0, 20.0) == 0, "seg_hit first button")
    check(kitdash.seg_hit(&sg, 199.0, 20.0) == 1, "seg_hit second button")
    check(kitdash.seg_hit(&sg, 259.0, 39.0) == 2, "seg_hit last button")
    check(kitdash.seg_hit(&sg, 260.0, 20.0) == 0 - 1, "seg_hit right of the switch")
    check(kitdash.seg_hit(&sg, 120.0, 41.0) == 0 - 1, "seg_hit below the switch")
    if BAD == 0 {
        say("KITDASH PASSED\n")
        return 0
    }
    say("KITDASH FAILED\n")
    return 1
}
