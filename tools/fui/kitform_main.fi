// tools/fui/kitform_main.fi -- CHECK OF lib/fui/kitform.fi: the validators and the wizard logic (no window).
//
//     firnc -o /tmp/kitform tools/fui/kitform_main.fi && /tmp/kitform
import std.io
import fui.editor
import fui.kit
import fui.kitform

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn expect(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if !ok {
        BAD = BAD + 1
        io.print_line(what)
    }
}

fn typed(z: *mut kitform.Wiz, i: usize, s: str) {
    kit.search_set_text(kitform.wf(z, i), s)
}

fn main() -> i32 {
    expect(kitform.check(kitform.REQ, "").n > 0, "empty is required")
    expect(kitform.check(kitform.REQ, "x").n == 0, "x ok")
    expect(kitform.check(kitform.EMAIL, "justin@example.com").n == 0, "email ok")
    expect(kitform.check(kitform.EMAIL, "no-at-sign").n > 0, "email without @")
    expect(kitform.check(kitform.EMAIL, "a@b").n > 0, "email without dot")
    expect(kitform.check(kitform.EMAIL, "@x.com").n > 0, "email without local part")
    expect(kitform.check(kitform.EMAIL, "a@b.").n > 0, "email ends with dot")
    expect(kitform.check(kitform.ZIP, "6020").n == 0, "zip 4")
    expect(kitform.check(kitform.ZIP, "60200").n == 0, "zip 5")
    expect(kitform.check(kitform.ZIP, "12").n > 0, "zip too short")
    expect(kitform.check(kitform.ZIP, "60a0").n > 0, "zip letters")
    expect(kitform.check(kitform.ZIP, "602000").n > 0, "zip too long")
    expect(kitform.check(kitform.CARD, "4111111111111111").n == 0, "card luhn ok")
    expect(kitform.check(kitform.CARD, "4111111111111112").n > 0, "card luhn bad")
    expect(kitform.check(kitform.CARD, "4111 1111 1111 1111").n == 0, "card with spaces")
    expect(kitform.check(kitform.CARD, "1234").n > 0, "card too short")
    expect(kitform.check(kitform.EXP, "12/28").n == 0, "exp ok")
    expect(kitform.check(kitform.EXP, "13/28").n > 0, "exp month 13")
    expect(kitform.check(kitform.EXP, "00/28").n > 0, "exp month 0")
    expect(kitform.check(kitform.EXP, "1228").n > 0, "exp no slash")
    expect(kitform.nth("a|bb|ccc", 1).n == 2 && kitform.nth("a|bb|ccc", 2).n == 3 && kitform.nth("a|bb|ccc", 3).n == 0, "nth")
    expect(kitform.parts("a|b|c") == 3 && kitform.parts("a") == 1, "parts")

    let z: *mut kitform.Wiz = kitform.wiz_new("P|A|C|S", "a|b|c|d|e|f|g|h|i", "", "224413431", "001020034")
    expect((*z).n == 9 && (*z).step == 0, "wizard starts at step 0")
    kitform.wiz_next(z)
    expect((*z).step == 0 && (*z).show, "empty step 0 does not advance, errors show")
    typed(z, 0, "Justin")
    typed(z, 1, "Muster")
    typed(z, 2, "bad")
    kitform.wiz_next(z)
    expect((*z).step == 0, "bad email blocks")
    typed(z, 2, "justin@example.com")
    expect(kitform.wiz_key(0 as u64 + (z as u64), editor.KEY_ENTER, 0 as u32), "Enter is used")
    expect((*z).step == 1 && !(*z).show, "valid step 0 advances, errors reset")
    typed(z, 3, "Hauptstrasse 1")
    typed(z, 4, "12")
    typed(z, 5, "Innsbruck")
    kitform.wiz_next(z)
    expect((*z).step == 1, "bad zip blocks")
    typed(z, 4, "6020")
    kitform.wiz_next(z)
    typed(z, 6, "Justin Muster")
    typed(z, 7, "4111111111111111")
    typed(z, 8, "12/28")
    kitform.wiz_next(z)
    expect((*z).step == 3 && !(*z).done, "summary reached")
    kitform.wiz_next(z)
    expect((*z).done, "submit")

    // typing and Tab: focus field 0 of step 0
    let y: *mut kitform.Wiz = kitform.wiz_new("P|A|C|S", "a|b|c|d|e|f|g|h|i", "", "224413431", "001020034")
    kit.search_focus(kitform.wf(y, 0), true)
    expect(kitform.wiz_text(y as u64, 65 as u32, 0 as u32), "char goes to the focused field")
    expect(kitform.field_text(kitform.wf(y, 0)).n == 1, "field 0 holds the char")
    expect(kitform.wiz_key(y as u64, editor.KEY_TAB, 0 as u32), "Tab is used")
    expect(kit.search_has_focus(kitform.wf(y, 1)) && !kit.search_has_focus(kitform.wf(y, 0)), "Tab moves the focus")
    kitform.wiz_text(y as u64, 66 as u32, 0 as u32)
    expect(kitform.field_text(kitform.wf(y, 1)).n == 1 && kitform.field_text(kitform.wf(y, 0)).n == 1, "second char in field 1")
    expect(kitform.wiz_key(y as u64, editor.KEY_BACKSPACE, 0 as u32) && kitform.field_text(kitform.wf(y, 1)).n == 0, "Backspace edits")
    if BAD == 0 {
        io.print_line("KITFORM PASSED")
        return 0
    }
    io.print_line("KITFORM FAILED")
    return 1
}
