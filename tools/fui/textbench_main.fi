// SPDX-License-Identifier: MPL-2.0
// tools/fui/textbench_main.fi -- THE TEXT BENCH (fUi W2, 17.10.2026).
//
// Paints one line of 40 characters the way the app does (painter.run_draw),
//   * as PNGs into <outdir> (black on white, white on black, white on grey,
//     at 13, 16 and 24 px), for tools/fui/textbench.py to compare with a
//     FreeType reference, and
//   * timed: cold (coverage cache off: every line is rastered) and warm
//     (coverage cache on: a kept line is only written back).
//
//     textbench <font.ttf> <outdir> [off]   (off: no coverage curve)
//
// Output on stdout: `ns_cold <n>` and `ns_warm <n>` (nanoseconds per line), `width <size> <x1000>` (run_width of the test line).
import std.rt
import std.time
import paint.canvas
import paint.png
import html.mem
import font.metrics
import fui.theme
import fui.painter
import fui.fcache
import fui.textcurve

const FONTSET_BYTES: usize = 4096
const W: usize = 640
const H: usize = 120

fn say2(p: u64, n: usize, v: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, p, n)
    rt.buf_push_dec_i64(&t, v)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// <dir>/<name>.png as a null terminated path
fn path_of(dir: u64, name: u64, nn: usize) -> rt.Buf {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, dir, rt.c_length(dir))
    rt.buf_push(&t, 47 as u8)
    rt.buf_push_bytes(&t, name, nn)
    rt.buf_push(&t, 0 as u8)
    return t
}

fn dump(cv: *mut canvas.Canvas, dir: u64, size: i64, k: i64) {
    var nm: rt.Buf = rt.buf_new()
    var a: [u8; 2] = "t_"
    rt.buf_push_bytes(&nm, (&a[0]) as u64, 2)
    rt.buf_push_dec_i64(&nm, size)
    rt.buf_push(&nm, 95 as u8)
    rt.buf_push_dec_i64(&nm, k)
    var e: [u8; 4] = ".png"
    rt.buf_push_bytes(&nm, (&e[0]) as u64, 4)
    var pth: rt.Buf = path_of(dir, rt.buf_ptr(&nm), rt.buf_len(&nm))
    var enc: mem.Buf = mem.buf_new()
    mem.buf_init(&enc)
    if png.write_png(cv, &enc) {
        rt.write_file(rt.buf_ptr(&pth), mem.buf_ptr(&enc) as u64, mem.buf_len(&enc))
    }
    rt.buf_free(&pth)
    rt.buf_free(&nm)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 3 {
        return 2
    }
    if rt.arg_count(start) >= 4 {
        // a 4th argument switches the text coverage curve off
        textcurve.tc_set(0.0, 0.0)
    }
    let fpath: u64 = rt.arg_ptr(start, 1)
    let odir: u64 = rt.arg_ptr(start, 2)
    var fbuf: rt.Buf = rt.buf_new()
    if !rt.read_file(fpath, &fbuf) {
        return 3
    }
    let fsp: *mut metrics.FontSet = rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    *fsp = metrics.fontset_new()
    if !metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
        return 3
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, H) {
        return 5
    }
    painter.painter_set_font(&z, fsp as u64)
    var line: [u8; 40] = "Hamburgefonstiv Quick fox AVATAR Tofu ry"
    let tp: u64 = (&line[0]) as u64
    let tn: usize = 40

    // ---- pictures: 3 sizes x 3 colour pairs
    var si: usize = 0
    while si < 3 {
        var size: f64 = 13.0
        if si == 1 { size = 16.0 }
        if si == 2 { size = 24.0 }
        var ci: i64 = 0
        while ci < 3 {
            var bg: u32 = 4294967295 as u32 // white
            var fg: u32 = 4278190080 as u32 // black
            if ci == 1 {
                bg = 4278190080 as u32
                fg = 4294967295 as u32
            }
            if ci == 2 {
                bg = 4280098846 as u32 // #1e1e1e
                fg = 4292927712 as u32 // #e0e0e0 (light text on dark grey)
            }
            canvas.canvas_clear(&cv, bg)
            var r: painter.TextRun = painter.run_new(size)
            painter.run_draw(&z, &r, 40.0, 60.0, 0.0, fg, tp, tn, 0)
            dump(&cv, odir, size as i64, ci)
            let wd: f64 = painter.run_width(&z, &r, tp, tn)
            if ci == 0 {
                var lb: [u8; 6] = "width "
                var t: rt.Buf = rt.buf_new()
                rt.buf_push_bytes(&t, (&lb[0]) as u64, 6)
                rt.buf_push_dec_i64(&t, size as i64)
                rt.buf_push(&t, 32 as u8)
                rt.buf_push_dec_i64(&t, (wd * 1000.0) as i64)
                rt.buf_push(&t, 10 as u8)
                rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
                rt.buf_free(&t)
            }
            ci = ci + 1
        }
        si = si + 1
    }

    // ---- kerning inside the bidi path: Latin pairs next to a Hebrew letter are
    // kerned like in the plain path (width difference must be 0)
    {
        var lt: [u8; 9] = "AVATAR To"
        var bd: [u8; 11] = "AVATAR To\u{5d0}"
        var rk: painter.TextRun = painter.run_new(16.0)
        let w_ltr: f64 = painter.run_width(&z, &rk, (&lt[0]) as u64, 9)
        let w_bidi: f64 = painter.run_width(&z, &rk, (&bd[0]) as u64, 11)
        let w_alef: f64 = metrics.fm_advance(fsp as u64, 16.0, 1488 as u32)
        var lk: [u8; 9] = "bidikern "
        say2((&lk[0]) as u64, 9, ((w_bidi - w_alef - w_ltr) * 1000000.0) as i64)
    }

    // ---- timing, 16 px, light text on dark
    let bgc: u32 = 4280098846 as u32
    let fgc: u32 = 4292927712 as u32
    var rr: painter.TextRun = painter.run_new(16.0)
    // cold: cache off, every line is rastered
    fcache.fc_set_budget(0)
    var n: i64 = 0
    var acc: u64 = 0
    while n < 300 {
        canvas.canvas_clear(&cv, bgc)
        let t0: u64 = time.monotonic_ns()
        painter.run_draw(&z, &rr, 40.0 + ((n % 4) as f64) * 0.25, 60.0, 0.0, fgc, tp, tn, 0)
        acc = acc + (time.monotonic_ns() - t0)
        n = n + 1
    }
    var lc: [u8; 8] = "ns_cold "
    say2((&lc[0]) as u64, 8, (acc / 300) as i64)
    // warm: cache on, the same line again and again
    fcache.fc_set_budget(25165824)
    canvas.canvas_clear(&cv, bgc)
    painter.run_draw(&z, &rr, 40.0, 60.0, 0.0, fgc, tp, tn, 0)
    acc = 0
    n = 0
    while n < 3000 {
        canvas.canvas_clear(&cv, bgc)
        let t0: u64 = time.monotonic_ns()
        painter.run_draw(&z, &rr, 40.0, 60.0, 0.0, fgc, tp, tn, 0)
        acc = acc + (time.monotonic_ns() - t0)
        n = n + 1
    }
    var lw: [u8; 8] = "ns_warm "
    say2((&lw[0]) as u64, 8, (acc / 3000) as i64)
    var lh: [u8; 8] = "fc_hits "
    say2((&lh[0]) as u64, 8, fcache.fc_hits() as i64)
    var lm: [u8; 10] = "fc_misses "
    say2((&lm[0]) as u64, 10, fcache.fc_misses() as i64)
    return 0
}
