// SPDX-License-Identifier: GPL-2.0-only
// tools/fui/symbol_main.fi -- DIE ZEICHEN AM BILDPUNKT.
//
// Die Zeichen aus lib/fui/symbol.fi sind GEOMETRIE, kein Text. Damit
// sind sie pruefbar wie jede andere Zeichnung: malen, zuruecklesen,
// zaehlen.
//
// Geprueft wird, was wirklich schiefgehen kann:
//   * Ein Zeichen malt GAR NICHTS (die haeufigste Art, ein Symbol zu
//     verlieren -- es faellt nur auf, wenn man hinsieht).
//   * Ein Zeichen malt AUSSERHALB seines Quadrats (dann ueberlappt es
//     im Menue den Text daneben).
//   * Die vier Dreiecksrichtungen zeigen in DIESELBE Richtung (der
//     Fehler, den man beim Nachbauen macht).
import std.rt
import paint.canvas
import fui.zeichnen
import fui.symbol

const W: usize = 120
const H: usize = 120

static mut G_FEHLER: usize = 0

fn sag(nm: u64, nn: usize, ok: bool, ist: i64, soll: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 44 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 3] = "OK "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 3)
    } else {
        var f: [u8; 8] = "FALSCH  "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_FEHLER = G_FEHLER + 1
    }
    var h1: [u8; 5] = " ist "
    rt.buf_push_bytes(&t, (&h1[0]) as u64, 5)
    rt.buf_push_i64(&t, ist)
    var h2: [u8; 6] = " soll "
    rt.buf_push_bytes(&t, (&h2[0]) as u64, 6)
    rt.buf_push_i64(&t, soll)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// Wieviele Bildpunkte in diesem Rechteck sind NICHT der Grund?
fn zaehl(cv: *mut canvas.Canvas, x: usize, y: usize, w: usize,
    h: usize, grund: u32) -> i64 {
    var n: i64 = 0
    var j: usize = 0
    while j < h {
        var i: usize = 0
        while i < w {
            if (canvas.canvas_get(cv, x + i, y + j) & 16777215 as u32)
                != grund {
                n = n + 1
            }
            i = i + 1
        }
        j = j + 1
    }
    return n
}

// Der Schwerpunkt der gemalten Punkte -- daran erkennt man, wohin ein
// Dreieck zeigt, ohne seine Form zu kennen.
fn schwer_y(cv: *mut canvas.Canvas, x: usize, y: usize, w: usize,
    h: usize, grund: u32) -> i64 {
    var s: i64 = 0
    var n: i64 = 0
    var j: usize = 0
    while j < h {
        var i: usize = 0
        while i < w {
            if (canvas.canvas_get(cv, x + i, y + j) & 16777215 as u32)
                != grund {
                s = s + (j as i64)
                n = n + 1
            }
            i = i + 1
        }
        j = j + 1
    }
    if n == 0 {
        return -1
    }
    return s / n
}

fn schwer_x(cv: *mut canvas.Canvas, x: usize, y: usize, w: usize,
    h: usize, grund: u32) -> i64 {
    var s: i64 = 0
    var n: i64 = 0
    var j: usize = 0
    while j < h {
        var i: usize = 0
        while i < w {
            if (canvas.canvas_get(cv, x + i, y + j) & 16777215 as u32)
                != grund {
                s = s + (i as i64)
                n = n + 1
            }
            i = i + 1
        }
        j = j + 1
    }
    if n == 0 {
        return -1
    }
    return s / n
}

fn main(start: u64) -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 2
    }
    var z: zeichnen.Zeichner = zeichnen.zeichner_neu()
    if !zeichnen.zeichner_init(&z, &cv, W, H) {
        return 3
    }
    let grund: u32 = 0 as u32
    let weiss: u32 = 16777215 as u32

    // ==================================================================
    // 1. JEDES ZEICHEN MALT UEBERHAUPT ETWAS
    // ==================================================================
    //
    // Der stille Tod eines Symbols: es malt nichts und niemand merkt
    // es, weil die Flaeche darunter richtig aussieht.
    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.hak(&z, 20.0, 20.0, 40.0, 3.0, weiss)
    let n_hak: i64 = zaehl(&cv, 20, 20, 40, 40, grund)
    var t1: [u8; 26] = "1 Haken malt Bildpunkte   "
    sag((&t1[0]) as u64, 26, n_hak > 40, n_hak, 40)

    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.punkt(&z, 20.0, 20.0, 20.0, weiss)
    let n_pkt: i64 = zaehl(&cv, 20, 20, 20, 20, grund)
    var t2: [u8; 26] = "1 Punkt malt Bildpunkte   "
    sag((&t2[0]) as u64, 26, n_pkt > 200, n_pkt, 200)

    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.kreuz(&z, 20.0, 20.0, 20.0, 2.0, weiss)
    let n_krz: i64 = zaehl(&cv, 18, 18, 26, 26, grund)
    var t3: [u8; 26] = "1 Kreuz malt Bildpunkte   "
    sag((&t3[0]) as u64, 26, n_krz > 40, n_krz, 40)

    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.minus(&z, 20.0, 20.0, 20.0, 2.0, weiss)
    let n_min: i64 = zaehl(&cv, 20, 20, 20, 20, grund)
    var t4: [u8; 26] = "1 Strich malt Bildpunkte  "
    sag((&t4[0]) as u64, 26, n_min > 10, n_min, 10)

    // ==================================================================
    // 2. DIE VIER DREIECKE ZEIGEN IN VIER RICHTUNGEN
    // ==================================================================
    //
    // DER FEHLER, DEN DIESE PRUEFUNG FAENGT: vier Richtungen aus einer
    // Funktion sind vier Gelegenheiten, dieselbe zu erwischen. Ein
    // Dreieck "auf", das aussieht wie "ab", faellt im Quelltext nicht
    // auf -- der Schwerpunkt verraet es sofort.
    //
    // Ein Dreieck nach UNTEN ist oben breit: sein Schwerpunkt liegt
    // ueber der Mitte. Nach OBEN ist es umgekehrt.
    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.dreieck(&z, 20.0, 20.0, 20.0, symbol.R_AB, weiss)
    let sy_ab: i64 = schwer_y(&cv, 20, 20, 20, 20, grund)

    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.dreieck(&z, 20.0, 20.0, 20.0, symbol.R_AUF, weiss)
    let sy_auf: i64 = schwer_y(&cv, 20, 20, 20, 20, grund)

    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.dreieck(&z, 20.0, 20.0, 20.0, symbol.R_LINKS, weiss)
    let sx_li: i64 = schwer_x(&cv, 20, 20, 20, 20, grund)

    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.dreieck(&z, 20.0, 20.0, 20.0, symbol.R_RECHTS, weiss)
    let sx_re: i64 = schwer_x(&cv, 20, 20, 20, 20, grund)

    var t5: [u8; 34] = "2 Dreieck ab: Schwerpunkt oben    "
    sag((&t5[0]) as u64, 34, sy_ab >= 0 && sy_ab < 5, sy_ab, 5)
    var t6: [u8; 34] = "2 Dreieck auf: Schwerpunkt unten  "
    sag((&t6[0]) as u64, 34, sy_auf > sy_ab, sy_auf, sy_ab)
    var t7: [u8; 34] = "2 Dreieck links: Punkte links     "
    sag((&t7[0]) as u64, 34, sx_li >= 0 && sx_li < 5, sx_li, 5)
    var t8: [u8; 34] = "2 Dreieck rechts: weiter rechts   "
    sag((&t8[0]) as u64, 34, sx_re > sx_li, sx_re, sx_li)

    // ==================================================================
    // 3. KEIN ZEICHEN MALT AUSSERHALB SEINES QUADRATS
    // ==================================================================
    //
    // WARUM DAS ZAEHLT: im Menue steht der Haken links, der Text
    // rechts daneben. Ein Haken, der ueber sein Quadrat hinausmalt,
    // faerbt Buchstaben an -- und das sieht aus wie ein Schriftfehler,
    // nicht wie ein Symbolfehler. Man sucht dann an der falschen
    // Stelle.
    //
    // Geprueft wird der RAHMEN um das Quadrat: alles, was dort landet,
    // ist ausgelaufen.
    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.hak(&z, 30.0, 30.0, 20.0, 3.0, weiss)
    // Ein Rahmen von 6 Punkten um das Quadrat 30..50.
    let aus_hak: i64 = zaehl(&cv, 24, 24, 32, 6, grund)
        + zaehl(&cv, 24, 50, 32, 6, grund)
        + zaehl(&cv, 24, 30, 6, 20, grund)
        + zaehl(&cv, 50, 30, 6, 20, grund)
    var t9: [u8; 34] = "3 Haken bleibt im Quadrat         "
    sag((&t9[0]) as u64, 34, aus_hak == 0, aus_hak, 0)

    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.dreieck(&z, 30.0, 30.0, 20.0, symbol.R_AB, weiss)
    let aus_dr: i64 = zaehl(&cv, 24, 24, 32, 6, grund)
        + zaehl(&cv, 24, 50, 32, 6, grund)
        + zaehl(&cv, 24, 30, 6, 20, grund)
        + zaehl(&cv, 50, 30, 6, 20, grund)
    var t10: [u8; 34] = "3 Dreieck bleibt im Quadrat       "
    sag((&t10[0]) as u64, 34, aus_dr == 0, aus_dr, 0)

    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.punkt(&z, 30.0, 30.0, 20.0, weiss)
    let aus_pk: i64 = zaehl(&cv, 24, 24, 32, 6, grund)
        + zaehl(&cv, 24, 50, 32, 6, grund)
        + zaehl(&cv, 24, 30, 6, 20, grund)
        + zaehl(&cv, 50, 30, 6, 20, grund)
    var t11: [u8; 34] = "3 Punkt bleibt im Quadrat         "
    sag((&t11[0]) as u64, 34, aus_pk == 0, aus_pk, 0)

    // ==================================================================
    // 4. DAS HAEKCHEN IST EIN HAKEN UND KEIN STRICH
    // ==================================================================
    //
    // Ein Haken hat einen KURZEN Arm nach unten und einen LANGEN nach
    // oben. Wenn beide Striche gleich lang sind, ist es ein v -- und
    // ein v sieht man einem Ankreuzfeld nicht als "an" an.
    //
    // Gemessen: der tiefste gemalte Punkt liegt in der unteren
    // Haelfte, der hoechste in der oberen. Ein waagerechter Strich
    // haette beide in der Mitte.
    canvas.canvas_clear(&cv, marke_deck(grund))
    symbol.hak(&z, 20.0, 20.0, 40.0, 3.0, weiss)
    var oben: i64 = -1
    var unten: i64 = -1
    var j: usize = 0
    while j < 40 {
        var i: usize = 0
        while i < 40 {
            if (canvas.canvas_get(&cv, 20 + i, 20 + j)
                & 16777215 as u32) != grund {
                if oben < 0 {
                    oben = j as i64
                }
                unten = j as i64
            }
            i = i + 1
        }
        j = j + 1
    }
    var t12: [u8; 34] = "4 Haken reicht ueber die Mitte    "
    sag((&t12[0]) as u64, 34, oben < 15 && unten > 24, unten - oben, 10)

    // ==================================================================
    // ERGEBNIS
    // ==================================================================
    if G_FEHLER == 0 {
        var g: [u8; 20] = "\nSYMBOLE BESTANDEN.\n"
        rt.write_everything(1, (&g[0]) as u64, 20)
        return 0
    }
    var b: [u8; 22] = "\nSYMBOLE GESCHEITERT.\n"
    rt.write_everything(2, (&b[0]) as u64, 22)
    return 1
}

// Die Leinwand haelt RGBA; `canvas_clear` will den vollen Wert mit
// Deckung. Dieselbe Rechnung wie `marke.deck`, hier ohne die Marke zu
// laden -- diese Pruefung braucht kein Thema.
fn marke_deck(c: u32) -> u32 {
    return c | 4278190080 as u32
}
