import std.rt
import std.io
import fui.theme
import fui.anim
import fui.ds_tokens
import fui.ds_tokens_comp
import fui.ds_tokens_prim
import fui.ds_tokens_color
import fui.ds_tokens_type
import fui.ds_tokens_motion

static mut CHECKS: usize = 0
static mut BAD: usize = 0
static mut MIN_X100: i64 = 99900

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: io.Fmt) {
    CHECKS = CHECKS + 1
    if ok {
        return
    }
    BAD = BAD + 1
    say("  WRONG ")
    io.fmt_print_line(what)
}

fn x100(k: f64) -> i64 {
    return (k * 100.0 + 0.5) as i64
}

fn pair(m: *mut theme.Theme, tag: usize, fg: u32, bg: u32, need: i64, mode: usize, accent: usize) {
    let h: i64 = x100(theme.contrast(fg & 16777215 as u32, bg & 16777215 as u32))
    if tag < 100 && h < MIN_X100 {
        MIN_X100 = h
    }
    check(h >= need, f"contrast pair {tag} mode {mode} accent {accent}: {h} < {need}")
}

fn over(base: u32, argb: u32) -> u32 {
    let a: usize = ((argb >> 24) & 255 as u32) as usize
    return theme.mix(base, argb & 16777215 as u32, a * 1000 / 255)
}

fn text_pairs(m: *mut theme.Theme, mode: usize, accent: usize) {
    let text: u32 = ds_tokens.color(m, ds_tokens.C_TEXT)
    let muted: u32 = ds_tokens.color(m, ds_tokens.C_TEXT_MUTED)
    let grounds: [usize; 8] = [ds_tokens.C_BASE, ds_tokens.C_SURFACE, ds_tokens.C_RAISED, ds_tokens.C_CARD,
        ds_tokens.C_BUTTON, ds_tokens.C_FIELD, ds_tokens.C_FIELD_FOCUS, ds_tokens.C_BUTTON_HOVER]
    var i: usize = 0
    while i < 8 {
        pair(m, 1, text, ds_tokens.color(m, grounds[i]), 450, mode, accent)
        i = i + 1
    }
    pair(m, 2, muted, ds_tokens.color(m, ds_tokens.C_BASE), 450, mode, accent)
    pair(m, 3, muted, ds_tokens.color(m, ds_tokens.C_SURFACE), 450, mode, accent)
    pair(m, 4, muted, ds_tokens.color(m, ds_tokens.C_RAISED), 450, mode, accent)
    pair(m, 5, ds_tokens.color(m, ds_tokens.C_TEXT_DISABLED), ds_tokens.color(m, ds_tokens.C_BUTTON), 450, mode, accent)
    let on: u32 = ds_tokens.color(m, ds_tokens.C_TEXT_ON_ACCENT)
    pair(m, 6, on, ds_tokens.color(m, ds_tokens.C_ACCENT), 450, mode, accent)
    pair(m, 7, on, ds_tokens.color(m, ds_tokens.C_ACCENT_HOVER), 450, mode, accent)
    pair(m, 8, on, ds_tokens.color(m, ds_tokens.C_ACCENT_ACTIVE), 450, mode, accent)
    pair(m, 9, ds_tokens.color(m, ds_tokens.C_SELECTION_TEXT), ds_tokens.color(m, ds_tokens.C_SELECTION), 450, mode, accent)
    let at: u32 = ds_tokens.color(m, ds_tokens.C_ACCENT_TEXT)
    pair(m, 10, at, ds_tokens.color(m, ds_tokens.C_BASE), 450, mode, accent)
    pair(m, 11, at, ds_tokens.color(m, ds_tokens.C_RAISED), 450, mode, accent)
    pair(m, 12, at, ds_tokens.color(m, ds_tokens.C_SURFACE), 450, mode, accent)
    let status: [usize; 4] = [ds_tokens.C_INFO, ds_tokens.C_SUCCESS, ds_tokens.C_WARNING, ds_tokens.C_ERROR]
    let status_bg: [usize; 4] = [ds_tokens.C_INFO_BG, ds_tokens.C_SUCCESS_BG, ds_tokens.C_WARNING_BG, ds_tokens.C_ERROR_BG]
    var k: usize = 0
    while k < 4 {
        let bg: u32 = ds_tokens.color(m, status_bg[k])
        pair(m, 13, ds_tokens.color(m, status[k]), bg, 450, mode, accent)
        pair(m, 14, text, bg, 450, mode, accent)
        pair(m, 15, muted, bg, 450, mode, accent)
        pair(m, 16, ds_tokens.color(m, status[k]), ds_tokens.color(m, ds_tokens.C_RAISED), 450, mode, accent)
        k = k + 1
    }
    let hov: u32 = over(ds_tokens.color(m, ds_tokens.C_RAISED), ds_tokens.color(m, ds_tokens.C_SUBTLE_HOVER))
    let act: u32 = over(ds_tokens.color(m, ds_tokens.C_RAISED), ds_tokens.color(m, ds_tokens.C_SUBTLE_ACTIVE))
    pair(m, 17, text, hov, 450, mode, accent)
    pair(m, 18, text, act, 450, mode, accent)
    pair(m, 19, muted, hov, 450, mode, accent)
    pair(m, 20, ds_tokens.color(m, ds_tokens.C_FOCUS_RING), ds_tokens.color(m, ds_tokens.C_BASE), 300, mode, accent)
    pair(m, 21, ds_tokens.color(m, ds_tokens.C_ACCENT), ds_tokens.color(m, ds_tokens.C_BASE), 300, mode, accent)
}

fn roles_defined(m: *mut theme.Theme, mode: usize, accent: usize) {
    var r: usize = 0
    while r < ds_tokens.C_COUNT {
        let c: u32 = ds_tokens.color(m, r)
        let p: u32 = ds_tokens.paint(m, r)
        if r < ds_tokens.C_ALPHA_FIRST {
            check((c >> 24) == 0 as u32, f"role {r} mode {mode}: solid colour carries alpha")
            check((p >> 24) == 255 as u32, f"role {r} mode {mode}: paint not opaque")
        } else {
            check((c >> 24) != 0 as u32, f"role {r} mode {mode}: alpha role without alpha")
            check(p == c, f"role {r} mode {mode}: paint differs from alpha role")
        }
        r = r + 1
    }
    check(ds_tokens.role_count() == ds_tokens.C_COUNT, f"role_count")
}

fn accent_checks() {
    var dark_i: usize = 0
    while dark_i < 2 {
        let dark: bool = dark_i == 1
        var m: theme.Theme = theme.theme_new(dark)
        let base_accent: u32 = ds_tokens.color(&m, ds_tokens.C_ACCENT)
        let base_text: u32 = ds_tokens.color(&m, ds_tokens.C_TEXT)
        var i: usize = 0
        while i < ds_tokens.accent_count() {
            ds_tokens.apply(&m, dark, i)
            let a: u32 = ds_tokens.color(&m, ds_tokens.C_ACCENT)
            check(a == ds_tokens.accent_color(i, dark) || i == 0, f"accent {i} dark {dark_i}: accent not the preset")
            check(ds_tokens.color(&m, ds_tokens.C_TEXT) == base_text, f"accent {i} dark {dark_i}: text changed")
            check(ds_tokens.color(&m, ds_tokens.C_ACCENT_HOVER) != a, f"accent {i}: hover equals accent")
            check(ds_tokens.color(&m, ds_tokens.C_ACCENT_ACTIVE) != ds_tokens.color(&m, ds_tokens.C_ACCENT_HOVER), f"accent {i}: active equals hover")
            if i == 0 {
                check(a == base_accent, f"accent 0 is not the theme default")
            } else {
                check(a != base_accent, f"accent {i} equals the default accent")
            }
            var j: usize = 0
            while j < i {
                check(ds_tokens.accent_color(j, dark) != ds_tokens.accent_color(i, dark), f"accent {i} duplicates {j} dark {dark_i}")
                j = j + 1
            }
            text_pairs(&m, dark_i, i)
            roles_defined(&m, dark_i, i)
            i = i + 1
        }
        dark_i = dark_i + 1
    }
}

fn theme_is_driven_by_tokens() {
    var d: usize = 0
    while d < 2 {
        let dark: bool = d == 1
        let c: theme.Colors = theme.colors_for_dark(dark)
        check(c.base == ds_tokens_color.core(ds_tokens_color.C_BASE, dark), f"theme base != token dark {d}")
        check(c.text == ds_tokens_color.core(ds_tokens_color.C_TEXT, dark), f"theme text != token dark {d}")
        check(c.accent == ds_tokens_color.core(ds_tokens_color.C_ACCENT, dark), f"theme accent != token dark {d}")
        check(c.success == ds_tokens_color.core(ds_tokens_color.C_SUCCESS, dark), f"theme success != token dark {d}")
        check(c.selection == ds_tokens_color.core(ds_tokens_color.C_SELECTION, dark), f"theme selection != token dark {d}")
        d = d + 1
    }
    check(theme.type_px(theme.TS_CAPTION) == 12 && theme.type_px(theme.TS_BODY) == 14 && theme.type_px(theme.TS_BODY_LARGE) == 18, f"type_px small roles")
    check(theme.type_px(theme.TS_SUBTITLE) == 20 && theme.type_px(theme.TS_TITLE) == 28 && theme.type_px(theme.TS_DISPLAY) == 40, f"type_px large roles")
    check(theme.elev_alpha(1) == 40 && theme.elev_blur(3) == 16 && theme.elev_dy(4) == 16 && theme.elev_blur(9) == 32, f"elevation numbers")
}

fn scales() {
    var m: theme.Theme = theme.theme_new(false)
    var i: usize = 1
    while i < ds_tokens_prim.SP_COUNT {
        check(ds_tokens_prim.space_px(i) > ds_tokens_prim.space_px(i - 1), f"space step {i} not increasing")
        check(ds_tokens.space(&m, i) == ds_tokens_prim.space_px(i), f"space {i} at scale 1000")
        i = i + 1
    }
    i = 1
    while i < ds_tokens_prim.RADIUS_COUNT {
        check(ds_tokens_prim.radius_px(i) > ds_tokens_prim.radius_px(i - 1), f"radius step {i} not increasing")
        i = i + 1
    }
    check(ds_tokens.radius(&m, ds_tokens.RAD_WINDOW) >= ds_tokens.radius(&m, ds_tokens.RAD_CARD), f"window radius < card radius")
    check(ds_tokens.radius(&m, ds_tokens.RAD_CARD) >= ds_tokens.radius(&m, ds_tokens.RAD_CONTROL), f"card radius < control radius")
    check(ds_tokens.radius(&m, ds_tokens.RAD_PILL) > 1000, f"pill radius")
    check(ds_tokens.radius(&m, ds_tokens.RAD_NONE) == 0, f"none radius")
    theme.theme_set_scale(&m, 2000)
    check(ds_tokens.space(&m, ds_tokens.SP_L) == 32, f"space scales with the theme")
    check(ds_tokens.type_of(&m, ds_tokens.T_BODY).size == 28, f"type scales with the theme")
    var t: usize = 1
    var seq: [usize; 7] = [ds_tokens.T_CAPTION, ds_tokens.T_BODY, ds_tokens.T_BODY_LARGE, ds_tokens.T_SUBTITLE,
        ds_tokens.T_TITLE, ds_tokens.T_TITLE_LARGE, ds_tokens.T_DISPLAY]
    while t < 7 {
        check(ds_tokens_type.size_px(seq[t]) > ds_tokens_type.size_px(seq[t - 1]), f"type ramp step {t}")
        t = t + 1
    }
    var r: usize = 0
    while r < ds_tokens.T_COUNT {
        let s: ds_tokens_type.TypeSpec = ds_tokens_type.spec(r)
        check(s.line > s.size && s.size >= 12, f"type role {r} line height")
        check(s.weight == 400 || s.weight == 600, f"type role {r} weight")
        r = r + 1
    }
    var e: usize = 1
    while e < ds_tokens_prim.SHADOW_LEVELS {
        check(ds_tokens_prim.shadow_spec(e).blur > ds_tokens_prim.shadow_spec(e - 1).blur, f"elevation {e} blur")
        check(ds_tokens_prim.shadow_spec(e).alpha > ds_tokens_prim.shadow_spec(e - 1).alpha, f"elevation {e} alpha")
        e = e + 1
    }
}

fn motion_checks() {
    var m: theme.Theme = theme.theme_new(false)
    var r: usize = 0
    while r < ds_tokens.M_COUNT {
        let t: ds_tokens.MotionTok = ds_tokens.motion(&m, r)
        check(t.ms > 0 && t.ms <= 500, f"motion role {r} duration")
        check(t.x1 <= 1000 && t.x2 <= 1000 && t.y1 <= 1000 && t.y2 <= 1000, f"motion role {r} curve")
        r = r + 1
    }
    check(ds_tokens.motion(&m, ds_tokens.M_HOVER).ms as i64 == anim.DUR_HOVER, f"hover duration drifted from anim.DUR_HOVER")
    check(ds_tokens.motion(&m, ds_tokens.M_PRESS).ms as i64 == anim.DUR_PRESS, f"press duration drifted from anim.DUR_PRESS")
    check(ds_tokens.motion(&m, ds_tokens.M_FOCUS).ms as i64 == anim.DUR_FOCUS, f"focus duration drifted from anim.DUR_FOCUS")
    check(ds_tokens.motion(&m, ds_tokens.M_FLYOUT_OPEN).ms as i64 == anim.DUR_PANEL, f"panel duration drifted from anim.DUR_PANEL")
    var classic: theme.Shape = theme.shape_classic()
    theme.theme_set_shape(&m, &classic)
    check(ds_tokens.motion(&m, ds_tokens.M_PAGE).ms == 0, f"classic shape must have no motion")
    check(ds_tokens.elevation(&m, 3).blur == 0, f"classic shape must have no shadow")
}

fn paint_over(ground: u32, c: u32) -> u32 {
    if (c >> 24) == 255 as u32 {
        return c
    }
    return over(ground, c)
}

fn comp_pair(tag: usize, fg: u32, ground: u32, bg: u32, mode: usize, accent: usize) {
    let g: u32 = paint_over(ground, bg)
    let f: u32 = fg
    let h: i64 = x100(theme.contrast(f & 16777215 as u32, g & 16777215 as u32))
    check(h >= 450, f"component pair {tag} mode {mode} accent {accent}: {h} < 450")
}

fn component_checks() {
    var d: usize = 0
    while d < 2 {
        var a: usize = 0
        while a < ds_tokens.accent_count() {
            var m: theme.Theme = theme.theme_new(d == 1)
            ds_tokens.apply(&m, d == 1, a)
            let ground: u32 = ds_tokens.paint(&m, ds_tokens.C_BASE)
            let raised: u32 = ds_tokens.paint(&m, ds_tokens.C_RAISED)
            var v: usize = 0
            while v < ds_tokens_comp.BTN_COUNT {
                let b: ds_tokens_comp.ButtonTok = ds_tokens_comp.button(&m, v)
                comp_pair(100 + v, b.fg, ground, b.bg, d, a)
                comp_pair(110 + v, b.fg, ground, b.bg_hover, d, a)
                comp_pair(120 + v, b.fg, ground, b.bg_pressed, d, a)
                comp_pair(130 + v, b.fg_disabled, ground, b.bg_disabled, d, a)
                check(b.radius > 0 && b.height >= 32 && b.pad_x > 0 && b.text_role < ds_tokens.T_COUNT, f"button {v} geometry")
                check(b.bg != b.bg_hover && b.bg_hover != b.bg_pressed, f"button {v} states equal")
                v = v + 1
            }
            let c: ds_tokens_comp.CardTok = ds_tokens_comp.card(&m)
            comp_pair(140, ds_tokens.paint(&m, ds_tokens.C_TEXT), ground, c.bg, d, a)
            comp_pair(141, ds_tokens.paint(&m, ds_tokens.C_TEXT), c.bg, c.bg_hover, d, a)
            let r: ds_tokens_comp.RowTok = ds_tokens_comp.row(&m)
            comp_pair(150, r.fg, ground, r.bg_selected, d, a)
            comp_pair(151, r.fg_secondary, ground, r.bg_selected, d, a)
            comp_pair(152, r.fg, ground, r.bg_hover, d, a)
            comp_pair(153, r.fg, ground, r.bg_pressed, d, a)
            comp_pair(154, r.fg_secondary, ground, r.bg_hover, d, a)
            comp_pair(155, r.indicator, ground, 0xFF000000 as u32 | (ds_tokens.color(&m, ds_tokens.C_BASE)), d, a)
            let i: ds_tokens_comp.InputTok = ds_tokens_comp.input(&m)
            comp_pair(160, i.fg, ground, i.bg, d, a)
            comp_pair(161, i.fg, ground, i.bg_hover, d, a)
            comp_pair(162, i.fg, ground, i.bg_focus, d, a)
            comp_pair(163, i.fg_placeholder, ground, i.bg, d, a)
            comp_pair(164, i.fg_placeholder, ground, i.bg_focus, d, a)
            comp_pair(165, i.fg_disabled, ground, i.bg_disabled, d, a)
            let n: ds_tokens_comp.NavTok = ds_tokens_comp.nav(&m)
            comp_pair(170, n.fg, ground, n.pane_bg, d, a)
            comp_pair(171, n.fg, n.pane_bg, n.bg_hover, d, a)
            comp_pair(172, n.fg_selected, n.pane_bg, n.bg_selected, d, a)
            var sv: usize = 0
            while sv < ds_tokens_comp.SEV_COUNT {
                let ib: ds_tokens_comp.InfoBarTok = ds_tokens_comp.infobar(&m, sv)
                comp_pair(180 + sv, ib.fg, ground, ib.bg, d, a)
                comp_pair(190 + sv, ib.fg_secondary, ground, ib.bg, d, a)
                comp_pair(200 + sv, ib.icon, ground, ib.bg, d, a)
                let tt: ds_tokens_comp.ToastTok = ds_tokens_comp.toast(&m, sv)
                comp_pair(210 + sv, tt.fg, ground, tt.bg, d, a)
                comp_pair(220 + sv, tt.fg_secondary, ground, tt.bg, d, a)
                check(tt.enter_ms > 0 && tt.exit_ms > 0 && tt.exit_ms <= tt.enter_ms && tt.width > 0, f"toast {sv} timing")
                sv = sv + 1
            }
            check(raised != 0 as u32, f"raised role")
            a = a + 1
        }
        d = d + 1
    }
}

fn main(start: u64) -> i32 {
    component_checks()
    accent_checks()
    theme_is_driven_by_tokens()
    scales()
    motion_checks()
    io.fmt_print_line(f"ds_tokens: {CHECKS} checks, {BAD} wrong, min text contrast {MIN_X100}/100")
    if BAD != 0 {
        return 1
    }
    say("DS TOKENS PASSED.\n")
    return 0
}
