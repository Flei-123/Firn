// SPDX-License-Identifier: MPL-2.0
// tools/fui/gridnode_main.fi -- A GRID IN THE SCENE TREE (lib/fui/scene.fi + lib/fui/grid.fi).
//
// grid_main proves the track solver on bare numbers; this program proves
// the WIRING: node_set_grid / node_grid_col / node_set_cell, the measure
// and layout passes, the memo key, RTL and a grid nested in a flexbox.
// Fixed sizes only, so no number depends on the font of the machine. Every
// value is calculated by hand above its check. Exit 1 on any WRONG.
import std.rt
import paint.canvas
import fui.theme
import fui.flex
import fui.grid
import fui.painter
import fui.render
import fui.sheet
import fui.scene

static mut BAD: usize = 0

fn say(s: str) { rt.write_everything(1, s.p as u64, s.n) }

fn check(ok: bool, what: str) {
    if ok { say("  ok    ") } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn at(sc: *mut scene.Scene, n: usize, x: i64, y: i64, w: i64, h: i64,
    what: str) {
    let ok: bool = scene.node_x(sc, n) as i64 == x &&
    scene.node_y(sc, n) as i64 == y && scene.node_w(sc, n) as i64 == w &&
    scene.node_h(sc, n) as i64 == h
    check(ok, what)
    if !ok {
        var t: rt.Buf = rt.buf_new()
        rt.buf_push_dec_i64(&t, scene.node_x(sc, n) as i64)
        rt.buf_push(&t, 32 as u8)
        rt.buf_push_dec_i64(&t, scene.node_y(sc, n) as i64)
        rt.buf_push(&t, 32 as u8)
        rt.buf_push_dec_i64(&t, scene.node_w(sc, n) as i64)
        rt.buf_push(&t, 32 as u8)
        rt.buf_push_dec_i64(&t, scene.node_h(sc, n) as i64)
        rt.buf_push(&t, 10 as u8)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
    }
}

fn main(start: u64) -> i32 {
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, 420, 260) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, 420, 200) {
        return 5
    }
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    var empty: sheet.Sheet = sheet.sheet_new()
    var sc: scene.Scene = scene.scene_new()

    // ---- 1. 100px | 1fr, rows 40px | auto, gap 10 x 5, padding 10.
    // Space 300 x 200 -> inner 280 x 180 at (10,10).
    //   columns 100 and 280 - 10 - 100 = 170; auto row = 180 - 5 - 40 = 135.
    //   A (10,10,100,40)  B (120,10,170,40)
    //   C (10,55,100,135) D (120,55,170,135)   -- unsized children stretch.
    // Measured: an empty box is 32 x 32 (render.pref_of minimum): 100 + 32 + 10 + 20 = 162
    // wide, 40 + 32 + 5 + 20 = 97 high.
    let g: usize = scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
    check(scene.node_set_grid(&sc, g), "1 node_set_grid")
    scene.node_grid_col(&sc, g, grid.tk_px(100))
    scene.node_grid_col(&sc, g, grid.tk_fr(1000))
    scene.node_grid_row(&sc, g, grid.tk_px(40))
    scene.node_grid_row(&sc, g, grid.tk_auto())
    scene.node_grid_gap(&sc, g, 10, 5)
    scene.node_grid_padding(&sc, g, 10, 10, 10, 10)
    let a: usize = scene.scene_add(&sc, g, scene.N_BOX)
    let b: usize = scene.scene_add(&sc, g, scene.N_BOX)
    let cc: usize = scene.scene_add(&sc, g, scene.N_BOX)
    let d: usize = scene.scene_add(&sc, g, scene.N_BOX)
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    check(scene.node_is_grid(&sc, g) && !scene.node_is_grid(&sc, a), "1 only the grid node is a grid")
    check(scene.node_pref_w(&sc, g) as i64 == 162, "1 measured width 100 + 32 + 10 + 20 = 162")
    check(scene.node_pref_h(&sc, g) as i64 == 97, "1 measured height 40 + 32 + 5 + 20 = 97")
    scene.scene_layout(&sc, &c, 0.0, 0.0, 300.0, 200.0)
    at(&sc, a, 10, 10, 100, 40, "1 A in (0,0)")
    at(&sc, b, 120, 10, 170, 40, "1 B in (0,1): the fr column takes the rest")
    at(&sc, cc, 10, 55, 100, 135, "1 C in (1,0): the auto row takes the rest")
    at(&sc, d, 120, 55, 170, 135, "1 D in (1,1)")
    check(scene.scene_kid_overflow(&sc) == 0, "1 no child lost")

    // ---- 2. a child with a size of its own is NOT stretched (start)
    scene.node_set_size(&sc, a, 60.0, 20.0)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 300.0, 200.0)
    at(&sc, a, 10, 10, 60, 20, "2 fixed-size A keeps 60 x 20 at the cell corner")

    // ---- 3. align inside the cell: centre x, end y -> x 10 + 20 = 30, y 10 + 20 = 30
    scene.node_set_cell_align(&sc, a, flex.AL_CENTER, flex.AL_END)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 300.0, 200.0)
    at(&sc, a, 30, 30, 60, 20, "3 justify-self centre, align-self end")
    scene.node_set_cell_align(&sc, a, flex.AL_AUTO, flex.AL_AUTO)

    // ---- 4. a span over both columns: width 100 + 10 + 170 = 280.
    // B is then moved by the flow: A holds (0,0)+(0,1), B -> (1,0), C -> (1,1).
    scene.node_set_size(&sc, a, 0.0, 0.0)
    scene.node_set_cell(&sc, a, 0 - 1, 0 - 1, 2, 1)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 300.0, 200.0)
    at(&sc, a, 10, 10, 280, 40, "4 A spans 2 columns = 280")
    at(&sc, b, 10, 55, 100, 65, "4 B flows into (1,0); D makes a 3rd (implicit) row, the two auto rows share 130")
    at(&sc, cc, 120, 55, 170, 65, "4 C flows into (1,1)")
    // an explicit cell: D to (0, 1) and A back to automatic one column
    scene.node_set_cell(&sc, a, 0 - 1, 0 - 1, 1, 1)
    scene.node_set_cell(&sc, d, 1, 0, 1, 1)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 300.0, 200.0)
    at(&sc, d, 120, 10, 170, 40, "4b explicit cell (0,1)")
    at(&sc, a, 10, 10, 100, 40, "4b A takes the free cell (0,0)")
    scene.node_set_cell(&sc, d, 0 - 1, 0 - 1, 1, 1)

    // ---- 5. RTL: column 0 at the right edge. inner x 10..290:
    // A (0,0) at 10 + 280 - 100 = 190, B (0,1) at 10 (width 170).
    scene.node_grid_rtl(&sc, g, true)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 300.0, 200.0)
    at(&sc, a, 190, 10, 100, 40, "5 rtl: A (column 0) at the right")
    at(&sc, b, 10, 10, 170, 40, "5 rtl: B (column 1) at the left")
    scene.node_grid_rtl(&sc, g, false)

    // ---- 6. the limits: the 17th explicit column is refused
    var added: usize = 0
    var q: usize = 0
    while q < 20 {
        if scene.node_grid_col(&sc, g, grid.tk_px(1)) {
            added = added + 1
        }
        q = q + 1
    }
    check(added == 14, "6 16 explicit columns at most (2 were there)")
    check(!scene.node_grid_col(&sc, a, grid.tk_px(1)), "6 a plain node takes no tracks")

    // ---- 7. a grid inside a flexbox: row 400 x 100, children: grid (grow 1)
    // and a 50-wide box. The grid gets 350; 2 x 1fr -> 175 each.
    scene.scene_reset(&sc)
    let root: usize = scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_flex(&sc, root, flex.FLEX_ROW, flex.JUSTIFY_START,
        flex.AL_STRETCH)
    let g2: usize = scene.scene_add(&sc, root, scene.N_BOX)
    scene.node_set_grid(&sc, g2)
    scene.node_grid_col(&sc, g2, grid.tk_fr(1000))
    scene.node_grid_col(&sc, g2, grid.tk_fr(1000))
    scene.node_grid_row(&sc, g2, grid.tk_fr(1000))
    scene.node_set_grow(&sc, g2, 1000, 1000)
    let g21: usize = scene.scene_add(&sc, g2, scene.N_BOX)
    let g22: usize = scene.scene_add(&sc, g2, scene.N_BOX)
    let side: usize = scene.scene_add(&sc, root, scene.N_BOX)
    scene.node_set_size(&sc, side, 50.0, 0.0)
    check(!scene.node_is_grid(&sc, root), "7 scene_reset: the root slot is a plain box again")
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 400.0, 100.0)
    at(&sc, g2, 0, 0, 350, 100, "7 the grid grows to 350 x 100")
    at(&sc, g21, 0, 0, 175, 100, "7 first fr cell")
    at(&sc, g22, 175, 0, 175, 100, "7 second fr cell")
    at(&sc, side, 350, 0, 50, 100, "7 the box next to it")

    // ---- 8. the measure memo knows the grid: a change of the spec must
    // not be served from an old entry
    let memo: *mut scene.Memo = rt.heap_alloc(1048576) as *mut scene.Memo
    *memo = scene.memo_new()
    scene.scene_attach_memo(&sc, memo)
    scene.scene_reset(&sc)
    let g3: usize = scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_grid(&sc, g3)
    scene.node_grid_col(&sc, g3, grid.tk_px(30))
    scene.node_grid_col(&sc, g3, grid.tk_px(30))
    scene.node_grid_gap(&sc, g3, 4, 0)
    let m1: usize = scene.scene_add(&sc, g3, scene.N_BOX)
    let m2: usize = scene.scene_add(&sc, g3, scene.N_BOX)
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    check(scene.node_pref_w(&sc, g3) as i64 == 64, "8 measured 30 + 4 + 30 = 64")
    scene.scene_measure(&sc, &c)
    check(scene.memo_box_hits(memo) > 0, "8 the second measure comes from the memo")
    scene.node_grid_gap(&sc, g3, 10, 0)
    scene.scene_measure(&sc, &c)
    check(scene.node_pref_w(&sc, g3) as i64 == 70, "8 a new gap is not served from the old entry (70)")
    scene.node_set_cell(&sc, m2, 0, 0, 1, 1)
    scene.node_set_cell(&sc, m1, 1, 0, 1, 1)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 70.0, 10.0)
    at(&sc, m1, 40, 0, 30, 32, "8 a new cell moves the child (memo key has the cells)")
    at(&sc, m2, 0, 0, 30, 32, "8 and the other one")
    scene.scene_attach_memo(&sc, 0 as *mut scene.Memo)
    scene.memo_free(memo)

    // ---- 9. 65 children: the 65th is counted, nothing is written behind
    scene.scene_reset(&sc)
    let g4: usize = scene.scene_add(&sc, scene.SCENE_NONE, scene.N_BOX)
    scene.node_set_grid(&sc, g4)
    scene.node_grid_col(&sc, g4, grid.tk_px(10))
    scene.node_grid_col(&sc, g4, grid.tk_px(10))
    q = 0
    while q < 65 {
        scene.scene_add(&sc, g4, scene.N_BOX)
        q = q + 1
    }
    scene.scene_style(&sc, &empty)
    scene.scene_measure(&sc, &c)
    scene.scene_layout(&sc, &c, 0.0, 0.0, 20.0, 330.0)
    check(scene.scene_kid_overflow(&sc) >= 1, "9 the 65th child is counted")
    check(scene.node_pref_h(&sc, g4) as i64 == 1024, "9 64 placed children = 32 rows of 32")

    scene.scene_free(&sc)
    say("\n")
    if BAD > 0 {
        say("GRIDNODE IS NOT IN ORDER.\n")
        return 1
    }
    say("GRIDNODE PASSED.\n")
    return 0
}
