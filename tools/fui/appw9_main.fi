// tools/fui/appw9_main.fi -- the range slider (appctl.range_slider) and the window timelines (appctl.timeline*) in the ten-line API.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.painter
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.sizeclass
import fui.a11y
import fui.scene

static mut BAD: usize = 0
static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 { d = 0.0 - d }
    return d <= tol
}

fn settle(a: *mut app.App, s: *mut Surface) {
    frame(a, s)
    frame(a, s)
}

fn has_text(buf: *mut u8, n: usize, t: str) -> bool {
    if t.n == 0 || n < t.n {
        return false
    }
    var i: usize = 0
    while i + t.n <= n {
        var j: usize = 0
        while j < t.n && *(buf + i + j) == *((t.p as u64 + j as u64) as *mut u8) {
            j = j + 1
        }
        if j == t.n {
            return true
        }
        i = i + 1
    }
    return false
}

fn dump_has(a: *mut app.App, t: str) -> bool {
    let cap: usize = 16384
    let buf: *mut u8 = rt.heap_alloc(cap) as *mut u8
    let n: usize = a11y.a11y_dump(app.app_scene(a), app.ax(a), buf as u64, cap)
    var m: usize = n
    if m > cap {
        m = cap
    }
    return has_text(buf, m, t)
}

fn click(w: *mut fuiwirt.Host, x: f64, y: f64) {
    let m: u32 = fuiwirt.host_pointer_move(w, x, y)
    let d: u32 = fuiwirt.host_pointer_down(w, x, y, fuiwirt.BTN_LEFT)
    let u: u32 = fuiwirt.host_pointer_up(w, x, y, fuiwirt.BTN_LEFT)
}

fn streq(a: str, b: str) -> bool {
    if a.n != b.n { return false }
    var i: usize = 0
    while i < a.n {
        if *((a.p as u64 + i as u64) as *mut u8) != *((b.p as u64 + i as u64) as *mut u8) { return false }
        i = i + 1
    }
    return true
}

fn type_text(a: *mut app.App, s: str) {
    var i: usize = 0
    while i < s.n {
        let ch: u8 = *((s.p as u64 + i as u64) as *mut u8)
        let r: bool = app.app_char(a as u64, ch as u32, 0 as u32)
        i = i + 1
    }
}

fn key(a: *mut app.App, k: u32) -> bool {
    return app.app_key(a as u64, k, 0 as u32)
}

static mut CALLS: usize = 0
static mut LAST: u32 = 99 as u32
fn classed(a: *mut app.App, c: u32) {
    CALLS = CALLS + 1
    LAST = c
}

fn paint_at(a: *mut app.App, s: *mut Surface, w: usize, h: usize) {
    app.app_paint(a as u64, w, h)
    fuiwirt.host_painted(app.app_host(a))
    app.app_paint(a as u64, w, h)
    fuiwirt.host_painted(app.app_host(a))
}

fn main(start: u64) -> i32 {
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("appw9: no font (DejaVu Sans)\n")
        return 9
    }
    FONT = fs as u64
    let a: *mut app.App = app.window("Wave9 size", 1100, 500)
    let b: usize = appctl.checkbox(a, "x", false, changed)
    appctl.on_size_class(a, classed)
    let s: *mut Surface = surface_for(a, 1100, 500)
    check(appctl.size_class(a) == sizeclass.SC_COMPACT && appctl.size_dp_width(a) == 0, "before the first paint: compact, 0 dp")
    check(appctl.size_columns(a, 300, 16, 4) >= 1, "columns is at least 1 before the first paint")
    paint_at(a, s, 500, 700 - 200)
    check(appctl.size_dp_width(a) == 500, "500 px = 500 dp at scale 1")
    check(appctl.size_class(a) == sizeclass.SC_COMPACT, "500 dp: compact")
    check(appctl.nav_mode(a) == sizeclass.NAV_BOTTOM, "compact: bottom navigation")
    check(appctl.size_columns(a, 300, 16, 4) == 1, "500 dp: one column of 300")
    let c0: usize = CALLS
    paint_at(a, s, 700, 480)
    check(appctl.size_class(a) == sizeclass.SC_MEDIUM && appctl.nav_mode(a) == sizeclass.NAV_RAIL, "700 dp: medium, rail")
    check(CALLS > c0 && LAST == sizeclass.SC_MEDIUM, "the callback ran once with the new class")
    check(appctl.size_columns(a, 300, 16, 4) == 2, "700 dp: two columns of 300")
    let c1: usize = CALLS
    paint_at(a, s, 700, 480)
    check(CALLS == c1, "same size again: no callback")
    paint_at(a, s, 1000, 480)
    check(appctl.size_class(a) == sizeclass.SC_EXPANDED && appctl.nav_mode(a) == sizeclass.NAV_SIDEBAR, "1000 dp: expanded, sidebar")
    check(appctl.size_columns(a, 300, 16, 3) == 3, "1000 dp: at most 3 columns")
    check(LAST == sizeclass.SC_EXPANDED, "the callback saw expanded")
    // hysteresis: just below the limit after expanded stays expanded
    paint_at(a, s, 895, 480)
    check(appctl.size_class(a) == sizeclass.SC_EXPANDED, "895 dp: still expanded (hysteresis)")
    paint_at(a, s, 850, 480)
    check(appctl.size_class(a) == sizeclass.SC_MEDIUM, "850 dp: medium again")
    // height class
    paint_at(a, s, 850, 400)
    check(appctl.height_class(a) == sizeclass.SC_COMPACT, "400 dp tall: compact height")
    paint_at(a, s, 850, 500)
    check(appctl.height_class(a) == sizeclass.SC_MEDIUM || appctl.height_class(a) == sizeclass.SC_COMPACT, "500 dp tall: a valid height class")
    check(appctl.size_changes(a) >= 4, "changes are counted")
    check(appctl.size_columns(a, 0, 0, 4) >= 1, "bad column width is harmless")
    if BAD == 0 {
        say("APPW9 PASSED\n")
        return 0
    }
    say("APPW9 FAILED\n")
    return 1
}
