// SPDX-License-Identifier: MPL-2.0
// tools/fui/kit_main.fi -- THE CHECK OF lib/fui/kit.fi (the app kit).
//
// Every part of the kit is painted into a canvas with the real font and the
// real theme (light AND dark, the launcher accent #1bd96a), the pixels are
// read back and compared with what the theme says they must be, the geometry
// the picture was made from is asked again by the `*_hit` functions, and the
// colour pairs are recomputed with the WCAG 2 formula. Without a window:
//
//     firnc -o /tmp/kit tools/fui/kit_main.fi && /tmp/kit [dir]
//
// With a directory the pictures kit-dark.png / kit-light.png / kit-narrow.png
// / kit-noicons.png are written there. The last line is KIT PASSED or KIT FAILED.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.render
import fui.style
import fui.editor
import fui.kit
import fui.kitcolor
import fui.lucide
import fui.viewport
import plat.sysfont
import plat.fuiwirt

static mut BAD: usize = 0
static mut CHECKS: usize = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

fn check(ok: bool, what: str) {
    CHECKS = CHECKS + 1
    if ok {
        say("  ok    ")
    } else {
        say("  WRONG ")
        BAD = BAD + 1
    }
    say(what)
    say("\n")
}

fn save(cv: *mut canvas.Canvas, dir: u64, name: str) {
    if dir == 0 {
        return
    }
    var path: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&path, dir, rt.c_length(dir))
    rt.buf_push(&path, 47 as u8)
    rt.buf_push_bytes(&path, name.p as u64, name.n)
    rt.buf_push(&path, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = rt.write_file(rt.buf_ptr(&path), mem.buf_ptr(&out) as u64,
            mem.buf_len(&out))
    }
    rt.buf_free(&path)
}

struct Page {
    m: theme.Theme,
    z: painter.Painter,
    cv: canvas.Canvas,
    c: render.Ctx,
    w: usize,
    h: usize,
}

fn page_new(w: usize, h: usize, dark: bool, font: u64) -> *mut Page {
    let p: *mut Page = rt.heap_alloc(1 << 20) as *mut Page
    (*p).m = theme.theme_new(dark)
    kitcolor.kit_theme(&(*p).m, dark)
    (*p).z = painter.painter_new()
    (*p).cv = canvas.canvas_new()
    (*p).w = w
    (*p).h = h
    if !canvas.canvas_init(&(*p).cv, w, h) || !painter.painter_init(&(*p).z, &(*p).cv, w, h) {
        return 0 as u64 as *mut Page
    }
    painter.painter_set_font(&(*p).z, font)
    (*p).c = render.ctx_new(&(*p).m, &(*p).z)
    return p
}

fn tok(p: *mut Page, t: u32) -> u32 {
    return theme.opaque(render.color_of(&(*p).c, style.color_token(t)))
}

fn clear(p: *mut Page) {
    canvas.canvas_clear(&(*p).cv, tok(p, style.TOK_BASE))
}

fn px(p: *mut Page, x: f64, y: f64) -> u32 {
    return canvas.canvas_get(&(*p).cv, x as usize, y as usize)
}

// pixels in the box with exactly this colour
fn count_col(p: *mut Page, x0: f64, y0: f64, x1: f64, y1: f64, col: u32) -> usize {
    var n: usize = 0
    var y: f64 = y0
    while y < y1 {
        var x: f64 = x0
        while x < x1 {
            if px(p, x, y) == col {
                n = n + 1
            }
            x = x + 1.0
        }
        y = y + 1.0
    }
    return n
}

// pixels in the box that differ from `col`
fn count_not(p: *mut Page, x0: f64, y0: f64, x1: f64, y1: f64, col: u32) -> usize {
    var n: usize = 0
    var y: f64 = y0
    while y < y1 {
        var x: f64 = x0
        while x < x1 {
            if px(p, x, y) != col {
                n = n + 1
            }
            x = x + 1.0
        }
        y = y + 1.0
    }
    return n
}

// the x of the left-most pixel in the box that differs from `col`; -1 if none
fn first_ink_x(p: *mut Page, x0: f64, y0: f64, x1: f64, y1: f64, col: u32) -> f64 {
    var x: f64 = x0
    while x < x1 {
        var y: f64 = y0
        while y < y1 {
            if px(p, x, y) != col {
                return x
            }
            y = y + 1.0
        }
        x = x + 1.0
    }
    return 0.0 - 1.0
}

fn near(a: f64, b: f64, tol: f64) -> bool {
    var d: f64 = a - b
    if d < 0.0 {
        d = 0.0 - d
    }
    return d <= tol
}

fn rgb(c: u32) -> u32 {
    return c & 16777215 as u32
}

// ====================================================================
// 1. THE BUTTON
// ====================================================================
fn run_button(p: *mut Page, ts: str) {
    say("== button (")
    say(ts)
    say(")\n")
    let c: *mut render.Ctx = &(*p).c
    let f: *mut theme.Colors = theme.theme_colors(&(*p).m)
    let h: f64 = kit.button_height(c)
    check(near(h, 36.0, 0.01), "a button is 36 points high (4-point grid)")
    let w: f64 = kit.button_width(c, "Play", lucide.PLAY)
    let w2: f64 = kit.button_width(c, "Play", kit.ICON_NONE)
    check(w > w2 + 20.0, "the symbol makes a button wider; without it the button is narrower (icon-free)")
    // primary at rest, hover, active
    clear(p)
    kit.button_draw(c, 20.0, 20.0, w, h, "Play", lucide.PLAY, kit.BTN_PRIMARY, 0 as u32)
    check(px(p, 22.0, 22.0 + h / 2.0) == theme.opaque((*f).accent) || count_col(p, 20.0, 20.0, 20.0 + w, 20.0 + h, theme.opaque((*f).accent)) > 500,
        "a primary button is filled with the accent")
    let rest: u32 = px(p, 30.0, 24.0)
    clear(p)
    kit.button_draw(c, 20.0, 20.0, w, h, "Play", lucide.PLAY, kit.BTN_PRIMARY, kit.ST_HOVER)
    let hov: u32 = px(p, 30.0, 24.0)
    clear(p)
    kit.button_draw(c, 20.0, 20.0, w, h, "Play", lucide.PLAY, kit.BTN_PRIMARY, kit.ST_ACTIVE)
    let act: u32 = px(p, 30.0, 24.0)
    check(rest != hov && hov != act && rest != act, "rest, hover and pressed are three different colours")
    check(theme.luminance(rgb(hov)) > theme.luminance(rgb(rest)) && theme.luminance(rgb(act)) < theme.luminance(rgb(rest)),
        "hover is lighter, pressed is darker")
    // ghost: nothing at rest, the hover colour on hover
    clear(p)
    kit.button_draw(c, 20.0, 20.0, w, h, "Play", lucide.PLAY, kit.BTN_GHOST, 0 as u32)
    check(px(p, 24.0, 24.0) == tok(p, style.TOK_BASE), "a ghost button paints no ground at rest")
    kit.button_draw(c, 20.0, 80.0, w, h, "Play", lucide.PLAY, kit.BTN_GHOST, kit.ST_HOVER)
    check(px(p, 24.0, 84.0) == tok(p, style.TOK_BUTTON_HOVER), "a ghost button takes the hover colour on hover")
    // disabled
    kit.button_draw(c, 20.0, 140.0, w, h, "Play", lucide.PLAY, kit.BTN_SECONDARY, kit.ST_DISABLED)
    check(px(p, 24.0, 144.0) == tok(p, style.TOK_BUTTON), "a disabled button has the plain button ground")
    check(count_col(p, 20.0, 140.0, 20.0 + w, 140.0 + h, tok(p, style.TOK_TEXT_DISABLED)) > 20, "and its label in the disabled-text colour")
    // the label text is painted in the colour that reads on the fill
    clear(p)
    kit.button_draw(c, 20.0, 20.0, w2, h, "Play", kit.ICON_NONE, kit.BTN_PRIMARY, 0 as u32)
    let fg: u32 = theme.opaque(kitcolor.on_color(&(*p).m, (*f).accent))
    check(count_col(p, 20.0, 20.0, 20.0 + w2, 20.0 + h, fg) > 2 && count_not(p, 24.0, 22.0, 16.0 + w2, 18.0 + h, theme.opaque((*f).accent)) > 40, "the primary label is painted in the colour that reads on the accent (full-coverage pixels exactly that colour)")
    // focus ring
    clear(p)
    kit.button_draw(c, 40.0, 40.0, w, h, "Play", kit.ICON_NONE, kit.BTN_SECONDARY, kit.ST_FOCUS)
    let ring: u32 = theme.opaque(kitcolor.accent_ui(&(*p).m, rgb(tok(p, style.TOK_BASE))))
    check(count_col(p, 36.0, 36.0, 44.0 + w, 44.0 + h, ring) > 100, "keyboard focus draws the accent ring around the button")
}

// ====================================================================
// 2. THE PROGRESS BAR
// ====================================================================
fn run_progress(p: *mut Page, ts: str) {
    say("== progress bar (")
    say(ts)
    say(")\n")
    let c: *mut render.Ctx = &(*p).c
    let f: *mut theme.Colors = theme.theme_colors(&(*p).m)
    let track: u32 = tok(p, style.TOK_BUTTON)
    let fill: u32 = theme.opaque(kitcolor.tone(&(*p).m, (*f).accent, rgb(track), kitcolor.MIN_UI_CONTRAST))
    let onfill: u32 = theme.opaque(kitcolor.on_color(&(*p).m, fill))
    let h: f64 = kit.progress_height(c, true)
    check(near(h, 24.0, 0.01) && near(kit.progress_height(c, false), 8.0, 0.01), "a bar with text is 24, a thin one 8 points")
    clear(p)
    kit.progress_draw(c, 20.0, 20.0, 300.0, h, 400 as i64, "", 0 as i64, kit.PB_NORMAL)
    check(px(p, 40.0, 32.0) == fill || count_col(p, 24.0, 22.0, 100.0, 24.0, fill) > 100, "the left part of a 40 % bar is the fill colour")
    check(px(p, 300.0, 22.0) == track, "the right part is the track")
    // the label: dark on the fill part, the text colour on the track
    kit.progress_draw(c, 20.0, 300.0, 300.0, h, 550 as i64, "Downloading 3 of 7", 0 as i64, kit.PB_NORMAL)
    check(count_col(p, 30.0, 306.0, 184.0, 300.0 + h - 6.0, onfill) > 2, "a label that straddles the fill edge has ink in the fill-readable colour on the fill")
    check(count_col(p, 186.0, 306.0, 310.0, 300.0 + h - 6.0, tok(p, style.TOK_TEXT)) > 2, "and in the text colour beyond the edge, on the track")
    check(count_col(p, 140.0, 20.0, 320.0, 20.0 + h, tok(p, style.TOK_TEXT)) > 2,
        "and ink in the text colour where it lies on the track")
    // a 0 % and a 100 % bar
    clear(p)
    kit.progress_draw(c, 20.0, 60.0, 300.0, h, 0 as i64, "", 0 as i64, kit.PB_NORMAL)
    check(count_col(p, 20.0, 60.0, 320.0, 60.0 + h, fill) == 0, "0 % paints no fill")
    kit.progress_draw(c, 20.0, 100.0, 300.0, h, 1000 as i64, "Done", 0 as i64, kit.PB_SUCCESS)
    check(count_col(p, 20.0, 100.0, 320.0, 100.0 + h, track) == 0 || count_col(p, 20.0, 100.0, 320.0, 100.0 + h, track) < 40,
        "100 % covers the track (only the rounded ends may show it)")
    // error colour
    kit.progress_draw(c, 20.0, 140.0, 300.0, h, 500 as i64, "Failed", 0 as i64, kit.PB_ERROR)
    let err: u32 = theme.opaque(kitcolor.tone(&(*p).m, (*f).err_col, rgb(track), kitcolor.MIN_UI_CONTRAST))
    check(count_col(p, 20.0, 140.0, 170.0, 140.0 + h, err) > 500, "an error bar is filled with the error colour")
    // indeterminate: the segment moves with the phase
    clear(p)
    kit.progress_draw(c, 20.0, 180.0, 300.0, h, -1, "", 0 as i64, kit.PB_NORMAL)
    let a: f64 = first_ink_x(p, 24.0, 186.0, 316.0, 188.0, track)
    clear(p)
    kit.progress_draw(c, 20.0, 180.0, 300.0, h, -1, "", 700 as i64, kit.PB_NORMAL)
    let b: f64 = first_ink_x(p, 24.0, 186.0, 316.0, 188.0, track)
    check(a != b, "an indeterminate bar's segment is somewhere else after 700 ms")
    // a thin bar has no text
    clear(p)
    kit.progress_draw(c, 20.0, 220.0, 300.0, 8.0, 500 as i64, "", 0 as i64, kit.PB_NORMAL)
    check(count_col(p, 20.0, 218.0, 320.0, 232.0, tok(p, style.TOK_TEXT)) == 0, "a thin bar paints no label")
}

// ====================================================================
// 3. THE SEARCH FIELD
// ====================================================================
fn type_text(s: *mut kit.Search, t: str) {
    var i: usize = 0
    while i < t.n {
        let r: u32 = kit.search_char(s, rt.ld8(t.p as u64, i) as u32, 0 as u32)
        i = i + 1
    }
}

fn run_search(p: *mut Page, ts: str) {
    say("== search field (")
    say(ts)
    say(")\n")
    let c: *mut render.Ctx = &(*p).c
    var s: kit.Search = kit.search_new()
    check(s.ok, "the field's editor is set up")
    let x: f64 = 20.0
    let y: f64 = 20.0
    let w: f64 = 320.0
    let h: f64 = 40.0
    clear(p)
    kit.search_draw(c, &s, x, y, w, h, "Search mods", false)
    // empty, not focused: the magnifier and the hint are there, the clear button is not
    check(count_not(p, x + 12.0, y + 12.0, x + 28.0, y + 28.0, tok(p, style.TOK_FIELD)) > 10, "the magnifier is drawn")
    check(count_col(p, x + 36.0, y + 10.0, x + 200.0, y + 30.0, tok(p, style.TOK_TEXT_DISABLED)) > 2, "the hint stands in the placeholder colour while the field is empty")
    check(count_col(p, x + w - 36.0, y + 8.0, x + w - 4.0, y + 32.0, tok(p, style.TOK_TEXT)) == 0, "no clear button while the field is empty")
    // type
    kit.search_focus(&s, true)
    type_text(&s, "sodium")
    check(kit.search_text_len(&s) == 6, "six characters were typed")
    clear(p)
    kit.search_draw(c, &s, x, y, w, h, "Search mods", false)
    check(count_col(p, x + 36.0, y + 8.0, x + 200.0, y + 32.0, tok(p, style.TOK_TEXT)) > 30, "the typed text is painted in the text colour")
    check(count_col(p, x + 36.0, y + 8.0, x + 200.0, y + 32.0, tok(p, style.TOK_TEXT_DISABLED)) == 0, "and the hint is gone")
    check(count_not(p, x + w - 36.0, y + 10.0, x + w - 6.0, y + 30.0, px(p, x + w - 40.0, y + 20.0)) > 15, "the clear button (an X) is there now")
    // the clear button hit: where it is drawn
    let hit0: u32 = kit.search_press(c, &s, x, y, w, h, x + w - 20.0, y + h / 2.0, 1000 as u64)
    check(hit0 == kit.SEARCH_HIT_CLEAR && kit.search_text_len(&s) == 0, "a press on the clear button empties the field")
    // a press into the field takes the focus and answers FIELD
    kit.search_focus(&s, false)
    let hit1: u32 = kit.search_press(c, &s, x, y, w, h, x + 100.0, y + h / 2.0, 2000 as u64)
    check(hit1 == kit.SEARCH_HIT_FIELD && kit.search_has_focus(&s), "a press in the field focuses it")
    check(kit.search_press(c, &s, x, y, w, h, x + w + 30.0, y, 3000 as u64) == kit.SEARCH_HIT_NONE, "a press outside is none of its business")
    // Escape clears a non-empty field, and passes when it is empty
    type_text(&s, "abc")
    check(kit.search_key(&s, editor.KEY_ESC, 0 as u32) == editor.RES_CHANGED && kit.search_text_len(&s) == 0, "Escape clears the text")
    check(kit.search_key(&s, editor.KEY_ESC, 0 as u32) != editor.RES_CHANGED, "Escape in an empty field changes nothing")
    // editing keys still work
    type_text(&s, "abc")
    let bs: u32 = kit.search_key(&s, editor.KEY_BACKSPACE, 0 as u32)
    check(kit.search_text_len(&s) == 2, "Backspace removes a character")
    // focus ring on the focused field
    kit.search_focus(&s, true)
    clear(p)
    kit.search_draw(c, &s, x, y, w, h, "Search mods", false)
    kit.search_free(&s)
}

// ====================================================================
// 4. TABS
// ====================================================================
fn run_tabs(p: *mut Page, ts: str) {
    say("== tab bar (")
    say(ts)
    say(")\n")
    let c: *mut render.Ctx = &(*p).c
    var tabs: [kit.Tab; 4] = [
        kit.Tab { icon: lucide.HOUSE, label: "Home", badge: 0 },
        kit.Tab { icon: lucide.PACKAGE, label: "Mods", badge: 3 },
        kit.Tab { icon: lucide.DOWNLOAD, label: "Downloads", badge: 0 },
        kit.Tab { icon: lucide.SETTINGS, label: "Settings", badge: 0 }]
    let tp: *mut kit.Tab = (&tabs[0]) as *mut kit.Tab
    let h: f64 = kit.tabbar_height(c)
    check(near(h, 44.0, 0.01), "the tab bar is 44 points high")
    clear(p)
    kit.tabbar_draw(c, tp, 4, 1, kit.NONE, false, 0.0, 0.0, 480.0)
    // hit test: the tab under a point, in order
    var seen: usize = 0
    var last_x: f64 = 0.0 - 1.0
    var ordered: bool = true
    var x: f64 = 5.0
    while x < 470.0 {
        let k: usize = kit.tabbar_hit(c, tp, 4, 0.0, 0.0, 480.0, x, 20.0)
        if k != kit.NONE {
            if k < seen {
                ordered = false
            }
            seen = k
        }
        x = x + 4.0
    }
    check(seen == 3 && ordered, "walking along the bar hits tab 0, 1, 2, 3 in order")
    check(kit.tabbar_hit(c, tp, 4, 0.0, 0.0, 480.0, 5.0, 60.0) == kit.NONE, "below the bar nothing is hit")
    // the active tab: the accent underline
    let ul: u32 = theme.opaque(kitcolor.accent_ui(&(*p).m, rgb(tok(p, style.TOK_BASE))))
    var tx: f64 = 0.0
    var tw: f64 = 0.0
    // find tab 1's span by hit testing
    var t1a: f64 = 0.0 - 1.0
    var t1b: f64 = 0.0
    x = 0.0
    while x < 480.0 {
        if kit.tabbar_hit(c, tp, 4, 0.0, 0.0, 480.0, x, 20.0) == 1 {
            if t1a < 0.0 {
                t1a = x
            }
            t1b = x
        }
        x = x + 1.0
    }
    check(count_col(p, t1a, h - 3.0, t1b, h, ul) > ((t1b - t1a) as usize) / 2 + 4, "the active tab has the accent underline")
    // another tab has none
    check(count_col(p, 5.0, h - 3.0, t1a - 5.0, h, ul) == 0, "an inactive tab has none")
    // the count badge is the accent
    check(count_col(p, t1a, 6.0, t1b, h - 6.0, tok(p, style.TOK_ACCENT)) > 30, "the count badge is painted in the accent")
    // hover: the hovered inactive tab has the hover ground
    clear(p)
    kit.tabbar_draw(c, tp, 4, 1, 2, false, 0.0, 0.0, 480.0)
    check(count_col(p, 0.0, 0.0, 480.0, h, tok(p, style.TOK_BUTTON_HOVER)) > 200, "a hovered tab has the hover ground")
    // the icon-free variant: the label starts further left
    var tabs2: [kit.Tab; 2] = [
        kit.Tab { icon: kit.ICON_NONE, label: "Mods", badge: 0 },
        kit.Tab { icon: kit.ICON_NONE, label: "Packs", badge: 0 }]
    var tabs3: [kit.Tab; 2] = [
        kit.Tab { icon: lucide.PACKAGE, label: "Mods", badge: 0 },
        kit.Tab { icon: lucide.PUZZLE, label: "Packs", badge: 0 }]
    clear(p)
    kit.tabbar_draw(c, (&tabs2[0]) as *mut kit.Tab, 2, 0, kit.NONE, false, 0.0, 0.0, 480.0)
    let ink_a: f64 = first_ink_x(p, 8.0, 10.0, 200.0, 30.0, tok(p, style.TOK_BASE))
    clear(p)
    kit.tabbar_draw(c, (&tabs3[0]) as *mut kit.Tab, 2, 0, kit.NONE, false, 0.0, 0.0, 480.0)
    let ink_b: f64 = first_ink_x(p, 8.0, 10.0, 200.0, 30.0, tok(p, style.TOK_BASE))
    check(ink_a >= 0.0 && ink_b >= 0.0 && ink_a > 0.0, "both variants draw")
    check(kit.tabbar_hit(c, (&tabs2[0]) as *mut kit.Tab, 2, 0.0, 0.0, 480.0, 20.0, 20.0) == 0, "an icon-free tab is hit")
    // narrow: the tabs shrink equally and still all hit
    var narrow_ok: bool = true
    var k2: usize = 0
    while k2 < 4 {
        var seen2: bool = false
        var xx: f64 = 0.0
        while xx < 200.0 {
            if kit.tabbar_hit(c, tp, 4, 0.0, 0.0, 200.0, xx, 20.0) == k2 {
                seen2 = true
            }
            xx = xx + 2.0
        }
        if !seen2 {
            narrow_ok = false
        }
        k2 = k2 + 1
    }
    check(narrow_ok, "in a 200 pt bar every tab can still be hit (they shrink)")
    // keys
    check(kit.tabbar_key(4, 1, editor.KEY_RIGHT) == 2 && kit.tabbar_key(4, 1, editor.KEY_LEFT) == 0, "Left / Right move the selection")
    check(kit.tabbar_key(4, 0, editor.KEY_LEFT) == 0 && kit.tabbar_key(4, 3, editor.KEY_RIGHT) == 3, "the ends do not wrap")
    check(kit.tabbar_key(4, 2, editor.KEY_HOME) == 0 && kit.tabbar_key(4, 1, editor.KEY_END) == 3, "Home and End jump to the ends")
}

// ====================================================================
// 5. THE SIDEBAR
// ====================================================================
fn run_nav(p: *mut Page, ts: str) {
    say("== sidebar (")
    say(ts)
    say(")\n")
    let c: *mut render.Ctx = &(*p).c
    var items: [kit.NavItem; 6] = [
        kit.NavItem { icon: kit.ICON_NONE, label: "LIBRARY", badge: 0, header: true },
        kit.NavItem { icon: lucide.HOUSE, label: "Home", badge: 0, header: false },
        kit.NavItem { icon: lucide.PACKAGE, label: "Mods", badge: 12, header: false },
        kit.NavItem { icon: kit.ICON_NONE, label: "SYSTEM", badge: 0, header: true },
        kit.NavItem { icon: lucide.DOWNLOAD, label: "Downloads", badge: 0, header: false },
        kit.NavItem { icon: lucide.SETTINGS, label: "Settings", badge: 0, header: false }]
    let ip: *mut kit.NavItem = (&items[0]) as *mut kit.NavItem
    check(near(kit.nav_width(c, false), 240.0, 0.01) && near(kit.nav_width(c, true), 64.0, 0.01), "the column is 240 wide, 64 collapsed")
    let w: f64 = kit.nav_width(c, false)
    clear(p)
    kit.nav_draw(c, ip, 6, 2, kit.NONE, false, 0.0, 0.0, w, 400.0, false)
    // ground and the separator on the right edge
    check(px(p, 100.0, 380.0) == tok(p, style.TOK_SURFACE), "the column has the surface ground")
    check(px(p, w - 1.0, 380.0) == tok(p, style.TOK_SEPARATOR), "and a separator on its right edge")
    // geometry through the hit test: header rows are not items
    var hdr_hits: usize = 0
    var item_hits: usize = 0
    var y: f64 = 0.0
    var firsty: f64 = 0.0 - 1.0
    var y2: f64 = 0.0
    while y < 400.0 {
        let k: usize = kit.nav_hit(c, ip, 6, 0.0, 0.0, w, false, 100.0, y)
        if k == 0 || k == 3 {
            hdr_hits = hdr_hits + 1
        }
        if k == 2 {
            if firsty < 0.0 {
                firsty = y
            }
            y2 = y
            item_hits = item_hits + 1
        }
        y = y + 1.0
    }
    check(hdr_hits == 0, "a section header is never an item")
    check(item_hits > 30 && near(y2 - firsty + 1.0, 40.0, 1.5), "an item is 40 points high")
    // the active item: selection ground, the mark on the left, selection text
    check(px(p, 100.0, firsty + 20.0) != tok(p, style.TOK_SURFACE), "the active item is not the plain ground")
    check(count_col(p, 8.0, firsty, w - 8.0, firsty + 40.0, tok(p, style.TOK_SELECTION)) > 3000, "the active item has the selection ground")
    let mark: u32 = theme.opaque(kitcolor.accent_ui(&(*p).m, rgb(tok(p, style.TOK_SURFACE))))
    check(count_col(p, 0.0, firsty, 6.0, firsty + 40.0, mark) > 40, "the accent mark stands on the left edge of the active item")
    check(count_col(p, 8.0, firsty + 4.0, w - 8.0, firsty + 36.0, tok(p, style.TOK_SELECTION_TEXT)) > 50, "its label is in the selection-text colour")
    // the badge pill
    check(count_col(p, 150.0, firsty, w - 8.0, firsty + 40.0, tok(p, style.TOK_ACCENT)) > 60, "the count badge is the accent")
    // hover
    clear(p)
    kit.nav_draw(c, ip, 6, 2, 4, false, 0.0, 0.0, w, 400.0, false)
    check(count_col(p, 8.0, 0.0, w - 8.0, 400.0, tok(p, style.TOK_BUTTON_HOVER)) > 3000, "a hovered item has the hover ground")
    // collapsed: icons only, narrower, the labels are gone
    let cw: f64 = kit.nav_width(c, true)
    clear(p)
    kit.nav_draw(c, ip, 6, 2, kit.NONE, false, 0.0, 0.0, cw, 400.0, true)
    var row5a: f64 = 0.0 - 1.0
    var row5b: f64 = 0.0
    var yy: f64 = 0.0
    while yy < 400.0 {
        if kit.nav_hit(c, ip, 6, 0.0, 0.0, cw, true, 30.0, yy) == 5 {
            if row5a < 0.0 {
                row5a = yy
            }
            row5b = yy
        }
        yy = yy + 1.0
    }
    check(row5a > 0.0 && count_not(p, 44.0, row5a, cw - 2.0, row5b, tok(p, style.TOK_SURFACE)) < 20, "collapsed, there is no label right of an icon")
    check(kit.nav_hit(c, ip, 6, 0.0, 0.0, cw, true, 30.0, firsty + 20.0) == 2, "collapsed, the same items are hit at the same heights")
    // the icon-free variant: labels start where the icons were
    var items2: [kit.NavItem; 2] = [
        kit.NavItem { icon: kit.ICON_NONE, label: "Home", badge: 0, header: false },
        kit.NavItem { icon: kit.ICON_NONE, label: "Mods", badge: 0, header: false }]
    clear(p)
    kit.nav_draw(c, (&items2[0]) as *mut kit.NavItem, 2, 0, kit.NONE, false, 0.0, 0.0, w, 200.0, false)
    let a: f64 = first_ink_x(p, 8.0, 14.0, 200.0, 36.0, tok(p, style.TOK_SELECTION))
    check(a >= 0.0, "an icon-free item still draws")
    // keys skip headers
    check(kit.nav_key(ip, 6, 1, editor.KEY_DOWN) == 2, "Down goes to the next item")
    check(kit.nav_key(ip, 6, 2, editor.KEY_DOWN) == 4, "Down skips a header")
    check(kit.nav_key(ip, 6, 4, editor.KEY_UP) == 2, "Up skips a header")
    check(kit.nav_key(ip, 6, 1, editor.KEY_UP) == 1, "Up at the first item stays")
    check(kit.nav_key(ip, 6, kit.NONE, editor.KEY_DOWN) == 1, "from nothing, Down goes to the first item (not the header)")
    check(kit.nav_key(ip, 6, 2, editor.KEY_END) == 5 && kit.nav_key(ip, 6, 5, editor.KEY_HOME) == 1, "Home / End go to the first / last item")
}

// ====================================================================
// 6. THE TILE GRID
// ====================================================================
static mut PIC: [u32; 64] = [0 as u32; 64]

fn run_grid(p: *mut Page, ts: str) {
    say("== tile grid (")
    say(ts)
    say(")\n")
    let c: *mut render.Ctx = &(*p).c
    var i: usize = 0
    while i < 64 {
        PIC[i] = 0xFF0000FF as u32
        i = i + 1
    }
    var tiles: [kit.Tile; 7] = [
        kit.Tile { title: "Sodium", sub: "Rendering - 12M downloads", badge: "Mod", icon: kit.ICON_NONE, seed: 0 as u32, px: 0, w: 0, h: 0, stride: 0 },
        kit.Tile { title: "Fabric API", sub: "Library", badge: "Mod", icon: kit.ICON_NONE, seed: 1 as u32, px: 0, w: 0, h: 0, stride: 0 },
        kit.Tile { title: "Iris Shaders", sub: "Shaders", badge: "", icon: lucide.SPARKLES, seed: 2 as u32, px: 0, w: 0, h: 0, stride: 0 },
        kit.Tile { title: "Red picture", sub: "Has its own pixels", badge: "", icon: kit.ICON_NONE, seed: 3 as u32, px: (&PIC[0]) as u64, w: 8, h: 8, stride: 32 },
        kit.Tile { title: "A very long title that cannot possibly fit into one tile", sub: "and a long subtitle that is cut too, with dots", badge: "Pack", icon: kit.ICON_NONE, seed: 4 as u32, px: 0, w: 0, h: 0, stride: 0 },
        kit.Tile { title: "Lithium", sub: "Optimization", badge: "Mod", icon: kit.ICON_NONE, seed: 5 as u32, px: 0, w: 0, h: 0, stride: 0 },
        kit.Tile { title: "Mod Menu", sub: "Utility", badge: "Mod", icon: kit.ICON_NONE, seed: 6 as u32, px: 0, w: 0, h: 0, stride: 0 }]
    let tp: *mut kit.Tile = (&tiles[0]) as *mut kit.Tile
    var g: kit.TileGrid = kit.grid_new()
    kit.grid_set_rect(&g, 0.0, 0.0, 640.0, 400.0)
    kit.grid_layout(c, &g, 7)
    check(g.cols == 3, "640 points hold three columns of tiles (minimum width 176 + gap 16, the scrollbar takes 12)")
    // tile rectangles: inside the content, no overlap
    var ok_rects: bool = true
    var a: usize = 0
    while a < 7 {
        var ax: f64 = 0.0
        var ay: f64 = 0.0
        var aw: f64 = 0.0
        var ah: f64 = 0.0
        kit.grid_tile_rect(&g, a, &ax, &ay, &aw, &ah)
        if ax < 0.0 || ax + aw > 640.0 {
            ok_rects = false
        }
        var b: usize = a + 1
        while b < 7 {
            var bx: f64 = 0.0
            var by: f64 = 0.0
            var bw: f64 = 0.0
            var bh: f64 = 0.0
            kit.grid_tile_rect(&g, b, &bx, &by, &bw, &bh)
            if ax < bx + bw && bx < ax + aw && ay < by + bh && by < ay + ah {
                ok_rects = false
            }
            b = b + 1
        }
        a = a + 1
    }
    check(ok_rects, "the tiles stay inside the grid and none overlaps another")
    check(kit.grid_content_height(&g) > 400.0, "seven tiles in three columns are taller than the view (it scrolls)")
    clear(p)
    kit.grid_paint(c, &g, tp, 7)
    // tile 0 has an avatar: its colour is in the middle of the picture area
    var x0: f64 = 0.0
    var y0: f64 = 0.0
    var w0: f64 = 0.0
    var h0: f64 = 0.0
    kit.grid_tile_rect(&g, 0, &x0, &y0, &w0, &h0)
    let av: u32 = theme.opaque(kitcolor.avatar_color(0 as u32))
    check(count_col(p, x0, y0, x0 + w0, y0 + h0, av) > 300, "a tile without a picture shows an avatar disc in its seed's hue")
    // tile 3: the red picture
    kit.grid_tile_rect(&g, 3, &x0, &y0, &w0, &h0)
    check(count_col(p, x0, y0 - 0.0, x0 + w0, y0 + h0, 0xFFFF0000 as u32) > 500, "a tile with pixels shows them (RGBA bytes: red)")
    // hit and hover
    kit.grid_tile_rect(&g, 1, &x0, &y0, &w0, &h0)
    check(kit.grid_hit(&g, x0 + 10.0, y0 + 10.0, 7) == 1, "a point in tile 1 hits tile 1")
    check(kit.grid_hit(&g, x0 - 4.0, y0 + 10.0, 7) == kit.NONE, "the gap between tiles hits none")
    check(kit.grid_move(&g, x0 + 10.0, y0 + 10.0, 7), "moving onto a tile changes the hover")
    check(!kit.grid_move(&g, x0 + 12.0, y0 + 12.0, 7), "moving inside it changes nothing")
    clear(p)
    kit.grid_paint(c, &g, tp, 7)
    let ring: u32 = theme.opaque(kitcolor.accent_ui(&(*p).m, rgb(tok(p, style.TOK_SURFACE))))
    check(count_col(p, x0 - 2.0, y0 - 2.0, x0 + w0 + 2.0, y0 + h0 + 2.0, ring) > 200, "the hovered tile has the accent ring")
    check(kit.grid_leave(&g) && !kit.grid_leave(&g), "leaving clears the hover once")
    // keys: select and scroll into view
    check(kit.grid_key(&g, editor.KEY_RIGHT, 7) && kit.grid_selected(&g) == 0, "Right from nothing selects the first tile")
    check(kit.grid_key(&g, editor.KEY_DOWN, 7) && kit.grid_selected(&g) == 3, "Down moves one row (three tiles)")
    check(kit.grid_key(&g, editor.KEY_END, 7) && kit.grid_selected(&g) == 6, "End selects the last tile")
    check(viewport.viewport_off_y(&g.vp) > 0.0, "selecting the last tile scrolled it into view")
    clear(p)
    kit.grid_paint(c, &g, tp, 7)
    kit.grid_tile_rect(&g, 6, &x0, &y0, &w0, &h0)
    let oy: f64 = viewport.viewport_off_y(&g.vp)
    check(count_col(p, x0, y0 - oy, x0 + w0, y0 - oy + h0, tok(p, style.TOK_ACCENT)) > 100, "the selected tile has the accent check badge")
    check(kit.grid_key(&g, editor.KEY_HOME, 7) && kit.grid_selected(&g) == 0, "Home selects the first tile")
    kit.grid_wheel(&g, 3.0)
    check(viewport.viewport_off_y(&g.vp) > 0.0, "the wheel scrolls")
    // narrow: one column
    var g2: kit.TileGrid = kit.grid_new()
    kit.grid_set_rect(&g2, 0.0, 0.0, 220.0, 400.0)
    kit.grid_layout(c, &g2, 7)
    check(g2.cols == 1, "220 points hold one column")
    // a wide window: more columns
    var g3: kit.TileGrid = kit.grid_new()
    kit.grid_set_rect(&g3, 0.0, 0.0, 1000.0, 400.0)
    kit.grid_layout(c, &g3, 7)
    check(g3.cols >= 4, "1000 points hold four or more columns")
}

// ====================================================================
// 7. TOASTS
// ====================================================================
#[allow_escape]
fn run_toasts(p: *mut Page, ts: str) {
    say("== toasts (")
    say(ts)
    say(")\n")
    let c: *mut render.Ctx = &(*p).c
    var q: kit.Toasts = kit.toasts_new()
    check(!kit.toasts_active(&q), "no toast to begin with")
    let id1: u32 = kit.toast_push(&q, kit.TK_SUCCESS, "Profile saved", "", 0 as i64, 4000 as i64)
    let id2: u32 = kit.toast_push(&q, kit.TK_ERROR, "Could not reach the server", "Retry", 100 as i64, 0 as i64)
    check(kit.toasts_count(&q) == 2 && id1 != id2, "two toasts, two ids")
    // steady state at t = 1000: bottom right, the newer one lowest
    var x1: f64 = 0.0
    var y1: f64 = 0.0
    var w1: f64 = 0.0
    var h1: f64 = 0.0
    var x2: f64 = 0.0
    var y2: f64 = 0.0
    var w2: f64 = 0.0
    var h2: f64 = 0.0
    check(kit.toasts_geometry(c, &q, 600.0, 400.0, 0, &x1, &y1, &w1, &h1), "slot 0 has a rectangle")
    check(kit.toasts_geometry(c, &q, 600.0, 400.0, 1, &x2, &y2, &w2, &h2), "slot 1 has a rectangle")
    check(y2 > y1 && near(x1, x2, 0.01), "the newer toast is below the older one, both at the right")
    check(near(x1 + w1, 600.0 - 16.0, 0.01) && near(y2 + h2, 400.0 - 16.0, 0.01), "the stack sits 16 points from the bottom right corner")
    check(near(h1, 48.0, 0.01), "a toast is 48 points high")
    clear(p)
    kit.toasts_draw(c, &q, 600.0, 400.0, 1000 as i64)
    check(px(p, x1 + w1 / 2.0, y1 + 3.0) == tok(p, style.TOK_SURFACE_RAISED), "a toast's card is the raised surface")
    // the symbol's colour (3:1 on the card): ink in the area of the icon
    check(count_not(p, x1 + 12.0, y1 + 14.0, x1 + 32.0, y1 + 34.0, tok(p, style.TOK_SURFACE_RAISED)) > 20, "the kind symbol is drawn")
    check(count_col(p, x2 + 12.0, y2 + 14.0, x2 + 32.0, y2 + 34.0, theme.opaque(kitcolor.tone(&(*p).m, (*theme.theme_colors(&(*p).m)).err_col, rgb(tok(p, style.TOK_SURFACE_RAISED)), 3.0))) > 2,
        "an error toast's symbol has the error colour")
    // hit parts
    var hid: u32 = 0 as u32
    var part: u32 = 0 as u32
    check(kit.toasts_hit(c, &q, 600.0, 400.0, x2 + w2 - 20.0, y2 + 24.0, &hid, &part) && hid == id2 && part == kit.TOAST_PART_CLOSE,
        "the right edge of a toast is its close button")
    check(kit.toasts_hit(c, &q, 600.0, 400.0, x2 + w2 - 80.0, y2 + 24.0, &hid, &part) && hid == id2 && part == kit.TOAST_PART_ACTION,
        "left of it is the action (Retry)")
    check(kit.toasts_hit(c, &q, 600.0, 400.0, x2 + 60.0, y2 + 24.0, &hid, &part) && part == kit.TOAST_PART_BODY, "the middle is the body")
    check(kit.toasts_hit(c, &q, 600.0, 400.0, x1 + w1 - 80.0, y1 + 24.0, &hid, &part) && hid == id1 && part == kit.TOAST_PART_BODY,
        "a toast without an action has no action part")
    check(!kit.toasts_hit(c, &q, 600.0, 400.0, 5.0, 5.0, &hid, &part), "elsewhere nothing is hit")
    // the action text is in the accent that reads on the card
    let acol: u32 = theme.opaque(kitcolor.accent_text(&(*p).m, rgb(tok(p, style.TOK_SURFACE_RAISED))))
    check(count_col(p, x2 + w2 - 100.0, y2 + 8.0, x2 + w2 - 40.0, y2 + 40.0, acol) > 20, "the action word is painted in the accent text colour")
    // time: the first expires at 4000, fades over 240 ms
    check(kit.toasts_tick(&q, 3000 as i64) && kit.toasts_count(&q) == 2, "at 3 s both are still there")
    check(kit.toasts_tick(&q, 4100 as i64) && kit.toasts_count(&q) == 2, "at 4.1 s the first is fading, still there")
    check(kit.toasts_tick(&q, 4400 as i64) && kit.toasts_count(&q) == 1, "at 4.4 s the first is gone (4 s + the 240 ms fade), the sticky one stays")
    check(kit.toasts_tick(&q, 999999 as i64) && kit.toasts_count(&q) == 1, "a toast with no duration never expires by itself")
    kit.toast_dismiss(&q, id2, 1000000 as i64)
    check(kit.toasts_tick(&q, 1000100 as i64), "a dismissed toast fades before it goes")
    check(!kit.toasts_tick(&q, 1000300 as i64) && !kit.toasts_active(&q), "and is gone after the fade")
    // more than four: the oldest goes
    var k: usize = 0
    while k < 5 {
        let ii: u32 = kit.toast_push(&q, kit.TK_INFO, "message", "", (2000000 + (k as i64) * 10) as i64, 0 as i64)
        k = k + 1
    }
    check(kit.toasts_count(&q) == kit.TOAST_MAX, "never more than four toasts at once")
    // a long text is cut with dots, never past the card
    var q2: kit.Toasts = kit.toasts_new()
    let idl: u32 = kit.toast_push(&q2, kit.TK_WARNING, "This message is far too long to fit into one toast and must be cut with an ellipsis at the end", "Undo", 0 as i64, 0 as i64)
    clear(p)
    kit.toasts_draw(c, &q2, 600.0, 400.0, 1000 as i64)
    var xl: f64 = 0.0
    var yl: f64 = 0.0
    var wl: f64 = 0.0
    var hl: f64 = 0.0
    let g2: bool = kit.toasts_geometry(c, &q2, 600.0, 400.0, 0, &xl, &yl, &wl, &hl)
    check(count_col(p, xl + wl + 1.0, yl, xl + wl + 40.0, yl + hl, tok(p, style.TOK_TEXT)) == 0 && count_col(p, xl - 1.0 - 40.0, yl, xl - 1.0, yl + hl, tok(p, style.TOK_TEXT)) == 0,
        "a long text does not run out of its card (no text-coloured pixel beside it)")
    // the fade-in: at the start the card is not yet opaque
    var q3: kit.Toasts = kit.toasts_new()
    let id3: u32 = kit.toast_push(&q3, kit.TK_INFO, "fading", "", 500 as i64, 0 as i64)
    clear(p)
    kit.toasts_draw(c, &q3, 600.0, 400.0, 500 as i64)
    let g3: bool = kit.toasts_geometry(c, &q3, 600.0, 400.0, 0, &xl, &yl, &wl, &hl)
    check(count_col(p, xl, yl, xl + wl, yl + hl + 10.0, tok(p, style.TOK_SURFACE_RAISED)) == 0, "at the first instant of the fade-in the card is not yet drawn solid")
}

// ====================================================================
// 8. THE MODAL AND ITS FOCUS TRAP
// ====================================================================
#[allow_escape]
fn run_modal(p: *mut Page, ts: str) {
    say("== modal dialog (")
    say(ts)
    say(")\n")
    let c: *mut render.Ctx = &(*p).c
    var m: kit.Modal = kit.modal_new()
    check(!kit.modal_blocks(&m), "a closed dialog blocks nothing")
    check(kit.modal_hit(c, &m, 600.0, 400.0, 300.0, 200.0) == 0 as u32, "a closed dialog is hit nowhere")
    kit.modal_open(&m, "Delete profile", 360, 160, 3, 0 as i64)
    check(kit.modal_blocks(&m), "an open dialog blocks the background")
    // geometry
    var x: f64 = 0.0
    var y: f64 = 0.0
    var w: f64 = 0.0
    var h: f64 = 0.0
    kit.modal_rect(c, &m, 600.0, 400.0, &x, &y, &w, &h)
    check(near(x * 2.0 + w, 600.0, 0.01) && near(y * 2.0 + h, 400.0, 0.01), "the panel is centred in the window")
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    var cw: f64 = 0.0
    var ch: f64 = 0.0
    kit.modal_content_rect(c, &m, 600.0, 400.0, &cx, &cy, &cw, &ch)
    check(cx > x && cy > y + 40.0 && cx + cw < x + w && cy + ch < y + h, "the content area lies inside the panel, below the title bar")
    // a dialog larger than the window is clamped
    var big: kit.Modal = kit.modal_new()
    kit.modal_open(&big, "Huge", 2000, 2000, 1, 0 as i64)
    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    kit.modal_rect(c, &big, 600.0, 400.0, &bx, &by, &bw, &bh)
    check(bw <= 600.0 - 64.0 + 0.01 && bh <= 400.0 - 64.0 + 0.01, "a dialog larger than the window is cut down to window minus margins")
    // painting: the scrim over the whole window, the panel on top
    clear(p)
    kit.modal_draw(c, &m, 600.0, 400.0, 1000 as i64, false)
    check(px(p, 2.0, 2.0) != tok(p, style.TOK_BASE), "the scrim covers the window (even the corners)")
    check(px(p, 598.0, 398.0) == px(p, 2.0, 2.0), "the same scrim all over")
    check(px(p, x + w / 2.0, y + h - 6.0) == tok(p, style.TOK_SURFACE), "the panel is the surface colour")
    check(count_col(p, x + 4.0, y + 4.0, x + w - 4.0, y + 56.0, tok(p, style.TOK_TEXT)) > 80, "the title is painted")
    check(count_col(p, x, y + 54.0, x + w, y + 57.0, tok(p, style.TOK_SEPARATOR)) > 200, "a separator under the title bar")
    // before it is faded in the scrim is lighter
    clear(p)
    kit.modal_draw(c, &m, 600.0, 400.0, 0 as i64, false)
    check(px(p, 2.0, 2.0) == tok(p, style.TOK_BASE), "at the very first instant nothing is drawn yet (fade-in)")
    // hits
    check(kit.modal_hit(c, &m, 600.0, 400.0, 3.0, 3.0) == kit.MODAL_HIT_SCRIM, "a click beside the panel is the scrim")
    check(kit.modal_hit(c, &m, 600.0, 400.0, x + w / 2.0, y + h / 2.0) == kit.MODAL_HIT_PANEL, "a click in the panel is the panel")
    check(kit.modal_hit(c, &m, 600.0, 400.0, x + w - 28.0, y + 28.0) == kit.MODAL_HIT_CLOSE, "the top right is the close button")
    // THE FOCUS TRAP
    check(kit.modal_focus(&m) == kit.NONE, "nothing in the dialog has the focus at first")
    check(kit.modal_key(&m, editor.KEY_TAB, 0 as u32) == kit.MODAL_KEY_FOCUS && kit.modal_focus(&m) == 0, "Tab goes to the first thing")
    let t2: u32 = kit.modal_key(&m, editor.KEY_TAB, 0 as u32)
    let t3: u32 = kit.modal_key(&m, editor.KEY_TAB, 0 as u32)
    check(kit.modal_focus(&m) == 2, "Tab, Tab goes to the third")
    let t4: u32 = kit.modal_key(&m, editor.KEY_TAB, 0 as u32)
    check(kit.modal_focus(&m) == 0, "Tab at the last wraps to the first: the focus cannot leave the dialog")
    let t5: u32 = kit.modal_key(&m, editor.KEY_TAB, editor.MOD_SHIFT)
    check(kit.modal_focus(&m) == 2, "Shift+Tab at the first wraps to the last")
    kit.modal_set_focus(&m, kit.NONE)
    let t6: u32 = kit.modal_key(&m, editor.KEY_TAB, editor.MOD_SHIFT)
    check(kit.modal_focus(&m) == 2, "Shift+Tab from nothing starts at the last")
    check(kit.modal_key(&m, editor.KEY_ENTER, 0 as u32) == kit.MODAL_KEY_ACTIVATE, "Enter activates the focused thing")
    kit.modal_set_focus(&m, kit.NONE)
    check(kit.modal_key(&m, editor.KEY_ENTER, 0 as u32) == kit.MODAL_KEY_NONE, "Enter with nothing focused does nothing")
    check(kit.modal_key(&m, editor.KEY_ESC, 0 as u32) == kit.MODAL_KEY_CLOSE, "Escape asks to close")
    check(kit.modal_key(&m, editor.KEY_LEFT, 0 as u32) == kit.MODAL_KEY_NONE, "other keys are none of the trap's business")
    // the pure ring
    check(kit.ring_next(0, 1, false) == 0 && kit.ring_next(0, 1, true) == 0, "a ring of one stays on it")
    check(kit.ring_next(kit.NONE, 0, false) == kit.NONE, "an empty ring has no focus")
    var seen: [bool; 5] = [false; 5]
    var cur: usize = kit.NONE
    var steps: usize = 0
    while steps < 5 {
        cur = kit.ring_next(cur, 5, false)
        seen[cur] = true
        steps = steps + 1
    }
    check(seen[0] && seen[1] && seen[2] && seen[3] && seen[4] && cur == 4, "five Tabs visit all five things")
    kit.modal_close(&m)
    check(!kit.modal_blocks(&m) && kit.modal_key(&m, editor.KEY_TAB, 0 as u32) == kit.MODAL_KEY_NONE, "closed again: no trap, no blocking")
}

// ====================================================================
// 9. THE PICTURE OF EVERYTHING
// ====================================================================
#[allow_escape]
fn compose(p: *mut Page, icons_on: bool, width: f64, height: f64) {
    let c: *mut render.Ctx = &(*p).c
    clear(p)
    var ic_home: i64 = lucide.HOUSE
    var ic_mod: i64 = lucide.PACKAGE
    var ic_dl: i64 = lucide.DOWNLOAD
    var ic_set: i64 = lucide.SETTINGS
    var ic_play: i64 = lucide.PLAY
    if !icons_on {
        ic_home = kit.ICON_NONE
        ic_mod = kit.ICON_NONE
        ic_dl = kit.ICON_NONE
        ic_set = kit.ICON_NONE
        ic_play = kit.ICON_NONE
    }
    var items: [kit.NavItem; 6] = [
        kit.NavItem { icon: kit.ICON_NONE, label: "LIBRARY", badge: 0, header: true },
        kit.NavItem { icon: ic_home, label: "Home", badge: 0, header: false },
        kit.NavItem { icon: ic_mod, label: "Mods", badge: 12, header: false },
        kit.NavItem { icon: kit.ICON_NONE, label: "SYSTEM", badge: 0, header: true },
        kit.NavItem { icon: ic_dl, label: "Downloads", badge: 0, header: false },
        kit.NavItem { icon: ic_set, label: "Settings", badge: 0, header: false }]
    let nw: f64 = kit.nav_width(c, false)
    kit.nav_draw(c, (&items[0]) as *mut kit.NavItem, 6, 2, 4, false, 0.0, 0.0, nw, height, false)
    var tabs: [kit.Tab; 3] = [
        kit.Tab { icon: ic_mod, label: "Installed", badge: 3 },
        kit.Tab { icon: ic_dl, label: "Browse", badge: 0 },
        kit.Tab { icon: ic_set, label: "Updates", badge: 0 }]
    let cx: f64 = nw + 16.0
    kit.tabbar_draw(c, (&tabs[0]) as *mut kit.Tab, 3, 0, 1, false, nw, 0.0, width - nw)
    var s: kit.Search = kit.search_new()
    kit.search_focus(&s, true)
    type_text(&s, "sod")
    kit.search_draw(c, &s, cx, 56.0, 240.0, 36.0, "Search mods", false)
    kit.button_draw(c, cx + 256.0, 56.0, kit.button_width(c, "Play", ic_play), 36.0, "Play", ic_play, kit.BTN_PRIMARY, 0 as u32)
    kit.button_draw(c, cx + 256.0 + kit.button_width(c, "Play", ic_play) + 8.0, 56.0, kit.button_width(c, "Folder", kit.ICON_NONE), 36.0, "Folder", kit.ICON_NONE, kit.BTN_SECONDARY, 0 as u32)
    kit.progress_draw(c, cx, 104.0, width - nw - 32.0, 24.0, 420 as i64, "Downloading 3 of 7", 0 as i64, kit.PB_NORMAL)
    var tiles: [kit.Tile; 3] = [
        kit.Tile { title: "Sodium", sub: "Rendering", badge: "Mod", icon: kit.ICON_NONE, seed: 0 as u32, px: 0, w: 0, h: 0, stride: 0 },
        kit.Tile { title: "Fabric API", sub: "Library", badge: "Mod", icon: kit.ICON_NONE, seed: 1 as u32, px: 0, w: 0, h: 0, stride: 0 },
        kit.Tile { title: "Iris Shaders", sub: "Shaders", badge: "", icon: lucide.SPARKLES, seed: 2 as u32, px: 0, w: 0, h: 0, stride: 0 }]
    var g: kit.TileGrid = kit.grid_new()
    kit.grid_set_rect(&g, nw, 140.0, width - nw, height - 140.0)
    kit.grid_layout(c, &g, 3)
    kit.grid_select(&g, 1)
    var hv: bool = kit.grid_move(&g, nw + 30.0, 160.0, 3)
    kit.grid_paint(c, &g, (&tiles[0]) as *mut kit.Tile, 3)
    var q: kit.Toasts = kit.toasts_new()
    let t1: u32 = kit.toast_push(&q, kit.TK_SUCCESS, "Sodium updated to 0.6.1", "Undo", 0 as i64, 0 as i64)
    let t2: u32 = kit.toast_push(&q, kit.TK_ERROR, "Download failed: connection reset", "Retry", 10 as i64, 0 as i64)
    kit.toasts_draw(c, &q, width, height, 1000 as i64)
    kit.search_free(&s)
}

fn run_pictures(dir: u64, font: u64) {
    say("== the pictures\n")
    let pd: *mut Page = page_new(760, 480, true, font)
    compose(pd, true, 760.0, 480.0)
    save(&(*pd).cv, dir, "kit-dark.png")
    check(count_not(pd, 0.0, 0.0, 760.0, 480.0, tok(pd, style.TOK_BASE)) > 100000, "the dark picture is full of parts")
    let pl: *mut Page = page_new(760, 480, false, font)
    compose(pl, true, 760.0, 480.0)
    save(&(*pl).cv, dir, "kit-light.png")
    let pn: *mut Page = page_new(420, 480, true, font)
    compose(pn, true, 420.0, 480.0)
    save(&(*pn).cv, dir, "kit-narrow.png")
    let pi: *mut Page = page_new(760, 480, true, font)
    compose(pi, false, 760.0, 480.0)
    save(&(*pi).cv, dir, "kit-noicons.png")
    check(count_not(pi, 0.0, 0.0, 760.0, 480.0, tok(pi, style.TOK_BASE)) > 100000, "the icon-free picture is full of parts too")
    // the icon-free picture differs from the one with symbols
    check(count_not(pi, 0.0, 0.0, 240.0, 480.0, px(pd, 0.0, 0.0)) != count_not(pd, 0.0, 0.0, 240.0, 480.0, px(pd, 0.0, 0.0)),
        "icons make a difference in the sidebar")
}

// ====================================================================
// 10. WCAG 2 CONTRAST OF EVERY PAIR THE KIT PAINTS
// ====================================================================
fn pair(m: *mut theme.Theme, fg: u32, bg: u32, need: f64, what: str, dark: bool) {
    let r: f64 = theme.contrast(rgb(fg), rgb(bg))
    var ok: bool = r >= need
    CHECKS = CHECKS + 1
    if ok {
        return
    }
    BAD = BAD + 1
    if dark {
        say("  WRONG (dark) ")
    } else {
        say("  WRONG (light) ")
    }
    say(what)
    say("\n")
}

fn run_contrast() {
    say("== contrast of every pair the kit paints (4.5:1 text, 3:1 graphics)\n")
    var d: usize = 0
    var before: usize = BAD
    while d < 2 {
        let dark: bool = d == 1
        var m: theme.Theme = theme.theme_new(dark)
        kitcolor.kit_theme(&m, dark)
        var cx: render.Ctx = render.ctx_new(&m, 0 as u64 as *mut painter.Painter)
        let f: *mut theme.Colors = theme.theme_colors(&m)
        let base: u32 = (*f).base
        let surf: u32 = (*f).surface
        let rais: u32 = (*f).surface_raised
        let btn: u32 = (*f).button
        // text
        pair(&m, (*f).text, base, 4.5, "text on base", dark)
        pair(&m, (*f).text, surf, 4.5, "text on surface", dark)
        pair(&m, (*f).text, rais, 4.5, "text on raised surface (toast, hovered tile)", dark)
        pair(&m, (*f).text, btn, 4.5, "text on button", dark)
        pair(&m, (*f).text_muted, base, 4.5, "muted text on base (inactive tab, hint)", dark)
        pair(&m, (*f).text_muted, surf, 4.5, "muted text on surface (tile subtitle, nav item)", dark)
        pair(&m, (*f).text_disabled, (*f).field, 4.5, "placeholder (hint) on the field", dark)
        pair(&m, (*f).text_muted, (*f).field, 3.0, "magnifier symbol on the field", dark)
        pair(&m, (*f).text_disabled, btn, 4.5, "disabled label on button", dark)
        pair(&m, (*f).selection_text, (*f).selection, 4.5, "active nav item", dark)
        pair(&m, (*f).text, (*f).button_hover, 4.5, "text on hover ground", dark)
        pair(&m, (*f).text, (*f).button_active, 4.5, "text on pressed ground", dark)
        // the accent as text
        pair(&m, kitcolor.accent_text(&m, base), base, 4.5, "accent text on base", dark)
        pair(&m, kitcolor.accent_text(&m, surf), surf, 4.5, "accent text on surface", dark)
        pair(&m, kitcolor.accent_text(&m, rais), rais, 4.5, "accent text on raised (toast action)", dark)
        // the accent as a graphic
        pair(&m, kitcolor.accent_ui(&m, base), base, 3.0, "accent graphic on base (tab underline)", dark)
        pair(&m, kitcolor.accent_ui(&m, surf), surf, 3.0, "accent graphic on surface (nav mark, tile ring)", dark)
        pair(&m, kitcolor.accent_ui(&m, btn), btn, 3.0, "accent graphic on the track", dark)
        // on a fill
        pair(&m, (*f).text_on_accent, (*f).accent, 4.5, "label on the primary button", dark)
        pair(&m, kitcolor.on_color(&m, theme.mix((*f).accent, 16777215 as u32, 140)), theme.mix((*f).accent, 16777215 as u32, 140), 4.5, "label on the hovered primary button", dark)
        pair(&m, kitcolor.on_color(&m, theme.mix((*f).accent, 0 as u32, 100)), theme.mix((*f).accent, 0 as u32, 100), 4.5, "label on the pressed primary button", dark)
        pair(&m, kitcolor.on_color(&m, (*f).err_col), (*f).err_col, 4.5, "label on the danger button", dark)
        pair(&m, kitcolor.on_color(&m, theme.mix((*f).err_col, 16777215 as u32, 140)), theme.mix((*f).err_col, 16777215 as u32, 140), 4.5, "label on the hovered danger button", dark)
        pair(&m, kitcolor.on_color(&m, theme.mix((*f).err_col, 0 as u32, 100)), theme.mix((*f).err_col, 0 as u32, 100), 4.5, "label on the pressed danger button", dark)
        pair(&m, (*f).text_on_accent, (*f).accent, 4.5, "count badge and check mark", dark)
        // progress: the fill against the track, the label on both
        let fillc: u32 = kitcolor.tone(&m, (*f).accent, btn, 3.0)
        pair(&m, fillc, btn, 3.0, "progress fill on the track", dark)
        pair(&m, kitcolor.on_color(&m, fillc), fillc, 4.5, "progress label on the fill", dark)
        pair(&m, (*f).text, btn, 4.5, "progress label on the track", dark)
        let okc: u32 = kitcolor.tone(&m, (*f).success, btn, 3.0)
        pair(&m, kitcolor.on_color(&m, okc), okc, 4.5, "progress label on the success fill", dark)
        let erc: u32 = kitcolor.tone(&m, (*f).err_col, btn, 3.0)
        pair(&m, kitcolor.on_color(&m, erc), erc, 4.5, "progress label on the error fill", dark)
        pair(&m, erc, btn, 3.0, "progress error fill on the track", dark)
        // toast symbols on the raised card
        pair(&m, kitcolor.tone(&m, (*f).success, rais, 3.0), rais, 3.0, "success symbol on the toast", dark)
        pair(&m, kitcolor.tone(&m, (*f).warning, rais, 3.0), rais, 3.0, "warning symbol on the toast", dark)
        pair(&m, kitcolor.tone(&m, (*f).err_col, rais, 3.0), rais, 3.0, "error symbol on the toast", dark)
        pair(&m, kitcolor.tone(&m, (*f).accent, rais, 3.0), rais, 3.0, "info symbol on the toast", dark)
        // avatars: the initials on all eight hues
        var k: usize = 0
        while k < 8 {
            let a: u32 = kitcolor.avatar_color(k as u32)
            pair(&m, kitcolor.on_color(&m, a), a, 4.5, "initials on an avatar hue", dark)
            k = k + 1
        }
        d = d + 1
    }
    check(BAD == before, "every colour pair of the kit has its contrast in both themes")
}

// ====================================================================
// 11. THE 4-POINT GRID AND THE KEY NUMBERS
// ====================================================================
fn run_grid4() {
    say("== the sizes sit on the 4-point grid, the keys are the editor's\n")
    let pg: *mut Page = page_new(100, 100, true, 0)
    let c: *mut render.Ctx = &(*pg).c
    check((kit.button_height(c) as usize) % 4 == 0, "button height")
    check((kit.tabbar_height(c) as usize) % 4 == 0, "tab bar height")
    check((kit.nav_width(c, false) as usize) % 4 == 0 && (kit.nav_width(c, true) as usize) % 4 == 0, "sidebar widths")
    check((kit.progress_height(c, true) as usize) % 4 == 0 && (kit.progress_height(c, false) as usize) % 4 == 0, "progress heights")
    check(kit.TOAST_MAX == 4, "four toasts")
    // the host's key numbers are not the editor's: fui.apphost maps them, the kit takes the editor's
    check(editor.KEY_TAB != fuiwirt.KEY_TAB || editor.KEY_UP != fuiwirt.KEY_UP, "the kit uses the editor's key numbers (what fui.apphost hands a program)")
}

fn main(start: u64) -> i32 {
    var dir: u64 = 0
    if rt.arg_count(start) >= 2 {
        dir = rt.arg_ptr(start, 1)
    }
    let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
    if !sysfont.sysfont_load(fs) {
        say("kit: no font (DejaVu Sans)\n")
        return 9
    }
    var d: usize = 0
    while d < 2 {
        let dark: bool = d == 1
        var ts: str = "light"
        if dark {
            ts = "dark"
        }
        let p: *mut Page = page_new(640, 480, dark, fs as u64)
        run_button(p, ts)
        run_progress(p, ts)
        run_search(p, ts)
        run_tabs(p, ts)
        run_nav(p, ts)
        run_grid(p, ts)
        run_toasts(p, ts)
        run_modal(p, ts)
        d = d + 1
    }
    run_pictures(dir, fs as u64)
    run_contrast()
    run_grid4()
    say("checks: ")
    var nb: rt.Buf = rt.buf_new()
    rt.buf_push_dec_u64(&nb, CHECKS as u64)
    rt.write_everything(1, rt.buf_ptr(&nb), rt.buf_len(&nb))
    rt.buf_free(&nb)
    say("\n")
    if BAD == 0 {
        say("KIT PASSED\n")
        return 0
    }
    say("KIT FAILED\n")
    return 1
}
