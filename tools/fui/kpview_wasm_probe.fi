import std.rt
import fui.kitview
import fui.kitplayer

fn main(start: u64) -> i32 {
    var v: kitview.View = kitview.view_new()
    let n: usize = 4096
    let d: u64 = rt.heap_alloc(n)
    let mode: u32 = kitview.view_open(&v, d, n, "a.wav")
    kitview.view_press(&v, 1.0, 1.0)
    kitview.view_tick(&v)
    kitview.view_key(&v, 1 as u32, 0 as u32)
    kitview.view_char(&v, 32 as u32, 0 as u32)
    kitview.view_free(&v)
    return mode as i32
}
