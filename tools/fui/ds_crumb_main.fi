import std.rt
import ds_testpage
import fui.ds_crumb
import fui.editor
import fui.render
import fui.screenax
import fui.style
import fui.widget

const PATH: str = "Home|Documents|Projects|Firn|Notes"

fn frame(k: *mut ds_crumb.Crumbs, pg: *mut ds_testpage.Page, list: str, w: f64, hx: f64, hy: f64) {
    let c: *mut render.Ctx = &(*pg).c
    ds_testpage.clear(pg)
    screenax.begin()
    ds_crumb.begin(k, c, 20.0, 20.0, w, hx, hy)
    ds_crumb.draw(k, c, list)
    ds_crumb.end(k, c)
}

fn mid_x(k: *mut ds_crumb.Crumbs, i: usize) -> f64 { return (*k).sx[i] + (*k).sw[i] / 2.0 }

fn deep_path(buf: *mut [u8; 256], n: usize) -> str {
    var len: usize = 0
    var i: usize = 0
    while i < n {
        if i > 0 {
            (*buf)[len] = 124 as u8
            len = len + 1
        }
        (*buf)[len] = 97 as u8
        len = len + 1
        i = i + 1
    }
    return str { p: ((&(*buf)[0]) as u64) as *mut u8, n: len }
}

#[allow_escape]
fn main() -> i32 {
    let font: u64 = ds_testpage.font_load()
    if font == 0 {
        ds_testpage.say("no system font\n")
        return 2
    }
    screenax.install()
    let pg: *mut ds_testpage.Page = ds_testpage.page_new(800, 300, true, font)
    let k: *mut ds_crumb.Crumbs = ds_crumb.crumbs_new()
    let base: u32 = ds_testpage.tok(pg, style.TOK_BASE)

    ds_testpage.say("== wide: every segment shown\n")
    frame(k, pg, PATH, 760.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(ds_crumb.hidden_count(k) == 0 && ds_crumb.count(k) == 5, "nothing hidden, five segments")
    ds_testpage.check((*k).sx[1] > (*k).sx[0] + (*k).sw[0], "segments are laid out left to right with a gap")
    ds_testpage.check(ds_crumb.click(k, mid_x(k, 1), 36.0) == 1, "click Documents -> 1")
    ds_testpage.check(ds_crumb.click(k, mid_x(k, 3), 36.0) == 3, "click Firn -> 3")
    ds_testpage.check(ds_crumb.click(k, mid_x(k, 4), 36.0) == ds_crumb.NONE, "current segment is not clickable")
    ds_testpage.check(ds_crumb.click(k, (*k).sx[1] - 4.0, 36.0) == ds_crumb.NONE, "separator gap is not clickable")
    ds_crumb.press(k, mid_x(k, 1), 36.0)
    ds_testpage.check(ds_crumb.release(k, mid_x(k, 2), 36.0) == ds_crumb.NONE, "release on another segment cancels")
    ds_testpage.check(ds_crumb.click(k, mid_x(k, 1), 70.0) == ds_crumb.NONE, "click below the bar misses")

    ds_testpage.say("== accessibility wide\n")
    ds_testpage.check(screenax.count() == 5, "five nodes")
    ds_testpage.check(screenax.kind_of(0) == widget.KIND_BUTTON && screenax.name_of(0) == "Home", "Home is a button")
    ds_testpage.check(screenax.kind_of(4) == widget.KIND_LABEL && screenax.name_of(4) == "Notes", "current segment is a label, not a control")

    ds_testpage.say("== narrow: ellipsis menu\n")
    frame(k, pg, PATH, 330.0, 0.0 - 1.0, 0.0 - 1.0)
    let hid: usize = ds_crumb.hidden_count(k)
    ds_testpage.check(hid > 0 && hid < 4, "leading segments collapse")
    ds_testpage.check((*k).sx[hid] >= 20.0 + (*k).mw, "visible segments start after the ellipsis button")
    ds_testpage.check((*k).sx[4] + (*k).sw[4] <= 20.0 + 330.0 + 0.5, "everything fits the width")
    ds_testpage.check(ds_crumb.click(k, 20.0 + (*k).mw / 2.0, 36.0) == ds_crumb.NONE && ds_crumb.menu_open(k), "click on the ellipsis opens the menu")
    frame(k, pg, PATH, 330.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(ds_testpage.region_differs(pg, 20.0, 60.0, 200.0, 40.0, base) > 200, "menu pixels below the ellipsis")
    ds_testpage.check(screenax.count() > 4 + hid - 1, "menu items are a11y nodes")
    ds_testpage.check(ds_crumb.click(k, 600.0, 250.0) == ds_crumb.NONE && !ds_crumb.menu_open(k), "click away closes the menu")
    frame(k, pg, PATH, 330.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_crumb.click(k, 20.0 + (*k).mw / 2.0, 36.0)
    frame(k, pg, PATH, 330.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(ds_crumb.click(k, 60.0, 20.0 + (*k).h + 8.0 + 34.0 + 17.0) == 1 && !ds_crumb.menu_open(k), "menu item 1 -> segment 1, menu closes")
    frame(k, pg, PATH, 330.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_crumb.click(k, 20.0 + (*k).mw / 2.0, 36.0)
    ds_crumb.click(k, 20.0 + (*k).mw / 2.0, 36.0)
    ds_testpage.check(!ds_crumb.menu_open(k), "second click on the ellipsis closes the menu")

    ds_testpage.say("== accessibility narrow\n")
    frame(k, pg, PATH, 330.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(screenax.name_of(0) == "More" && screenax.kind_of(0) == widget.KIND_BUTTON, "ellipsis button is named More")
    ds_crumb.set_more_name(k, "Show more")
    frame(k, pg, PATH, 330.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(screenax.name_of(0) == "Show more", "ellipsis name is settable")
    ds_crumb.set_more_name(k, "More")

    ds_testpage.say("== very narrow: only the current segment stays\n")
    frame(k, pg, PATH, 110.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(ds_crumb.hidden_count(k) == 4, "all but the last hidden")
    ds_testpage.check((*k).sx[4] + (*k).sw[4] <= 20.0 + 110.0 + 0.5, "last segment is cut to the room")

    ds_testpage.say("== keyboard\n")
    frame(k, pg, PATH, 330.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_crumb.set_focus(k, ds_crumb.NONE)
    ds_testpage.check(ds_crumb.key(k, editor.KEY_TAB, 0 as u32) && ds_crumb.focus_id(k) == ds_crumb.MORE, "Tab goes to the ellipsis first")
    ds_testpage.check(ds_crumb.key(k, editor.KEY_ENTER, 0 as u32) && ds_crumb.menu_open(k), "Enter opens the menu")
    ds_testpage.check(ds_crumb.key(k, editor.KEY_DOWN, 0 as u32) && ds_crumb.key(k, editor.KEY_ENTER, 0 as u32) && ds_crumb.fired(k) == 1 && !ds_crumb.menu_open(k), "Down + Enter picks the second hidden segment")
    ds_testpage.check(ds_crumb.key(k, editor.KEY_ENTER, 0 as u32) && ds_crumb.key(k, editor.KEY_ESC, 0 as u32) && !ds_crumb.menu_open(k), "Esc closes the menu")
    ds_testpage.check(ds_crumb.key(k, editor.KEY_RIGHT, 0 as u32) && ds_crumb.focus_id(k) == hid, "Right moves to the first visible segment")
    ds_testpage.check(ds_crumb.key(k, editor.KEY_ENTER, 0 as u32) && ds_crumb.fired(k) == hid, "Enter fires the segment")
    ds_testpage.check(ds_crumb.text(k, 32 as u32, 0 as u32) && ds_crumb.fired(k) == hid, "Space fires the segment")
    ds_crumb.set_focus(k, 3)
    ds_testpage.check(ds_crumb.key(k, editor.KEY_RIGHT, 0 as u32) && ds_crumb.focus_id(k) == ds_crumb.MORE, "focus wraps over the current segment")
    ds_testpage.check(ds_crumb.key(k, editor.KEY_LEFT, 0 as u32) && ds_crumb.focus_id(k) == 3, "Left wraps back")
    frame(k, pg, PATH, 330.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check((screenax.state_of(screenax.count() - 2) & screenax.F_FOCUS) != 0 as u32, "focused segment is flagged in the tree")

    ds_testpage.say("== deep path\n")
    var buf: [u8; 256] = [0 as u8; 256]
    let deep: str = deep_path(&buf, 70)
    frame(k, pg, deep, 780.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(ds_crumb.count(k) == 70, "70 segments counted")
    ds_testpage.check(ds_crumb.hidden_count(k) > 0, "deep path collapses")
    ds_testpage.check(ds_crumb.click(k, mid_x(k, 62), 36.0) == 68, "absolute index of a visible segment")
    ds_testpage.check(ds_crumb.click(k, mid_x(k, 63), 36.0) == ds_crumb.NONE, "last of 70 is current")

    ds_testpage.say("== pixels\n")
    frame(k, pg, PATH, 760.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(ds_testpage.region_differs(pg, 20.0, 20.0, 340.0, 32.0, base) > 300, "text and separators drawn")
    let rest_px: u32 = ds_testpage.px(pg, (*k).sx[1] + 4.0, 22.0)
    frame(k, pg, PATH, 760.0, mid_x(k, 1), 36.0)
    ds_testpage.check(ds_testpage.px(pg, (*k).sx[1] + 4.0, 22.0) != rest_px, "hover tints a clickable segment")
    let cur_rest: u32 = ds_testpage.px(pg, (*k).sx[4] + 4.0, 22.0)
    frame(k, pg, PATH, 760.0, mid_x(k, 4), 36.0)
    ds_testpage.check(ds_testpage.px(pg, (*k).sx[4] + 4.0, 22.0) == cur_rest, "current segment has no hover tint")
    let lg: *mut ds_testpage.Page = ds_testpage.page_new(800, 300, false, font)
    frame(k, lg, PATH, 760.0, 0.0 - 1.0, 0.0 - 1.0)
    ds_testpage.check(ds_testpage.regions_differ(lg, 20.0, 20.0, 340.0, 32.0, pg) > 1000, "light theme renders differently")
    return ds_testpage.finish("DS_CRUMB")
}
