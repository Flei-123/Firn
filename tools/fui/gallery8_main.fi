// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery8_main.fi -- THE MAPPING AS A PICTURE.
//
// A mapping shows itself at EDGES. Three kinds stand here
// side by side, and each proves something different:
//
//   1. ROTATED TILES WITH TEXT. Frame, surface and text go
//      through the same matrix; the glyphs are rotated as an OUTLINE
//      and rasterised at the target size. If a finished text picture were
//      rotated here, you would see it at once from the ragged letters.
//   2. SCALED TILES. The font is rasterised ANEW and not
//      enlarged -- at 1.5 the strokes are as thin as at
//      0.65, only larger.
//   3. A PICTURE, rotated and enlarged: mapped backwards and
//      sampled bilinearly, with a soft edge. A grid in the picture
//      makes visible whether the sampling is right -- a crooked line
//      with staircases is noticed at once on a grid.
//   4. A SKEW, like CSS `skewX`.
//
//     gallery8_main <out.png> [light|dark] [<font.ttf>]
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import svg.matrix
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.uiimage
import fui.transform

const FONTSET_BYTES: usize = 4096
const W: usize = 1280
const H: usize = 716

// ====================================================== THE GRID
//
// 20.09.2026 -- WHAT WAS WRONG HERE. The labels stood
// jumbled: the first above its row, a second BELOW
// the same row, and between the first and the second row lay
// an empty band from y 220 to 350 in which there was nothing but background. A
// sheet that does not keep its own order reads like three
// sheets on top of each other.
//
// So a grid with TWO numbers, and both apply to every row:
//
//   LAB_ABSTAND     from the top edge of the label to the
//                   top edge of the row. The label ALWAYS stands
//                   above, never below.
//   REIHEN_ABSTAND  from the bottom edge of a row to the
//                   label of the next one.
//
// The top edges below are calculated from that, and the program
// re-calculates at the end that the really PAINTED boxes (the four
// mapped corners, not the boxes before the mapping) lie in their
// band -- otherwise it ends with an error instead of delivering a crooked
// sheet.
const LAB_DISTANCE: f64 = 26.0
const ROWS_DISTANCE: f64 = 30.0

// Row 1: rotated tiles. 170 x 64, rotated by up to 48 degrees,
// needs in height 85*sin48 + 32*cos48 = 63.2 + 21.4 = 84.6 upwards
// and downwards. The centre therefore lies 88 under the top edge.
const R1_LAB: f64 = 52.0
const R1_TOP: f64 = 78.0
const R1_MID: f64 = 166.0
const R1_BOT: f64 = 254.0
// Reihe 2: skalierte Kacheln. 150 x 56 mal 1.5 = 84 hoch, also 42 um
// die Mitte.
const R2_LAB: f64 = 284.0
const R2_TOP: f64 = 310.0
const R2_MID: f64 = 352.0
const R2_BOT: f64 = 394.0
// Row 3: the images and the skew. The picture enlarged 2.2 times
// is with 110*2.2 = 242 the highest piece; its centre lies
// 121 under the top edge.
const R3_LAB: f64 = 424.0
const R3_TOP: f64 = 450.0
const R3_MID: f64 = 571.0
const R3_BOT: f64 = 692.0
// The edge length of the painted image. Small enough that the
// enlargement on the right is a real enlargement.
const IMAGE: usize = 64

// A straight label -- it explains what stands below it, and
// therefore goes the normal way via render.draw_label.
fn label(c: *mut render.Ctx, x: f64, y: f64, w: f64, px: usize, p: u64,
    n: usize, tok: u32) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(tok))
    *s = style.style_set_font(*s, 0, px)
    *s = style.style_set_pad(*s, 0, 0)
    render.draw_label(c, &e)
}

// A TILE THAT LOOKS LIKE A BUTTON, under the mapping.
//
// `render.draw_button` cannot do that: it paints axis-parallel through
// the painter, and that is right so -- the straight way is to stay straight.
// Here the same shape is assembled from the mapped building blocks:
// frame, surface, font. The frame is the larger rounding underneath, the surface
// the one indented by the stroke width on top -- exactly the order in which
// painter.fi draws a frame.
fn kachel(z: *mut painter.Painter, xf: *mut transform.Xform, x: f64,
    y: f64, w: f64, h: f64, r: f64, rand: u32, fill: u32, tcol: u32,
    p: u64, n: usize, size: f64) {
    let st: f64 = 1.5
    transform.tf_fill_round_rect(z, xf, x, y, w, h, r, rand)
    transform.tf_fill_round_rect(z, xf, x + st, y + st, w - 2.0 * st,
        h - 2.0 * st, r - st, fill)
    if n == 0 {
        return
    }
    // The baseline exactly as painter.text_baseline_mid calculates it,
    // only without rounding to whole pixels: nothing is rounded under
    // a rotation, there is no pixel row any more to
    // round to.
    let asc: f64 = painter.font_ascent(z, size)
    let dsc: f64 = painter.font_descent(z, size)
    let base: f64 = y + (h + asc - dsc) / 2.0
    let pad: f64 = 10.0
    transform.tf_text(z, xf, x + pad, base, w - 2.0 * pad, size, tcol,
        p, n, painter.TEXT_M)
}

// THE PAINTED IMAGE. A colour gradient, a light circle and a grid
// every 16 points. The grid is the actual proof: a rotated
// straight line shows every staircase that the sampling leaves standing.
//
// CIRCLE AND LINES ARE ALREADY SMOOTHED HERE. Otherwise the
// enlarged image on the right shows the staircases of the SOURCE and not the
// quality of the sampling -- a bilinear enlargement can only
// widen a hard edge, not invent one.
fn coverage(d: f64, half: f64) -> f64 {
    var v: f64 = half - d + 0.5
    if v < 0.0 {
        return 0.0
    }
    if v > 1.0 {
        return 1.0
    }
    return v
}

fn mix(a: f64, b: f64, t: f64) -> f64 {
    return a + (b - a) * t
}

fn image_build(p: u64, n: usize) {
    var y: usize = 0
    while y < n {
        var x: usize = 0
        while x < n {
            let fx: f64 = (x as f64) / ((n - 1) as f64)
            let fy: f64 = (y as f64) / ((n - 1) as f64)
            var r: f64 = 30.0 + 190.0 * fx
            var g: f64 = 80.0 + 110.0 * fy
            var b: f64 = 210.0 - 130.0 * fx
            // The circle, with a soft edge via the distance to the edge.
            let dx: f64 = (x as f64) + 0.5 - (n as f64) / 2.0
            let dy: f64 = (y as f64) + 0.5 - (n as f64) / 2.0
            let rr: f64 = (n as f64) * 0.28
            let dk: f64 = matrix.m_sqrt(dx * dx + dy * dy) - rr
            let ck: f64 = coverage(dk, 0.0)
            r = mix(r, 250.0, ck)
            g = mix(g, 243.0, ck)
            b = mix(b, 214.0, ck)
            // The grid: the distance to the nearest line, in both
            // directions, and of that the softer edge.
            let lx: f64 = distance_to_line((x as f64) + 0.5, 16.0)
            let ly: f64 = distance_to_line((y as f64) + 0.5, 16.0)
            var cl: f64 = coverage(lx, 0.9)
            let cl2: f64 = coverage(ly, 0.9)
            if cl2 > cl {
                cl = cl2
            }
            r = mix(r, 22.0, cl)
            g = mix(g, 26.0, cl)
            b = mix(b, 44.0, cl)
            let o: usize = (y * n + x) * 4
            rt.st8(p, o, r as u8)
            rt.st8(p, o + 1, g as u8)
            rt.st8(p, o + 2, b as u8)
            rt.st8(p, o + 3, 255 as u8)
            x = x + 1
        }
        y = y + 1
    }
}

// The distance to the nearest grid line at spacing `s`.
fn distance_to_line(v: f64, s: f64) -> f64 {
    let m: f64 = v - matrix.m_floor(v / s) * s
    if m > s - m {
        return s - m
    }
    return m
}

// ================================ THE BAND THAT PROVES A ROW
//
// What is measured is what REALLY lands on the sheet: the four corners
// of the box AFTER the mapping. A tile rotated by 48 degrees is
// higher than its box, and exactly that is why the band limits
// cannot be guessed from the tile height.
static mut G_LO: f64 = 0.0
static mut G_HI: f64 = 0.0

fn band_auf() {
    G_LO = 1000000.0
    G_HI = 0.0 - 1000000.0
}

fn band_dot(v: f64) {
    if v < G_LO {
        G_LO = v
    }
    if v > G_HI {
        G_HI = v
    }
}

fn band_box(xf: *mut transform.Xform, x: f64, y: f64, w: f64,
    h: f64) {
    band_dot(transform.xf_point_y(xf, x, y))
    band_dot(transform.xf_point_y(xf, x + w, y))
    band_dot(transform.xf_point_y(xf, x, y + h))
    band_dot(transform.xf_point_y(xf, x + w, y + h))
}

// A claim about the grid. It does not stand in a check file, but HERE, because
// only this program knows its boxes -- the same way that demos/fuidemo/main.fi
// goes for the overlap of its phases.
static mut G_ERROR: usize = 0

fn verlange(nm: u64, nn: usize, ok: bool, a: f64, b: f64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 44 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "FALSCH  "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERROR = G_ERROR + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, (a * 10.0) as i64)
    var w: [u8; 12] = "/10  want <="
    rt.buf_push_bytes(&t, (&w[0]) as u64, 12)
    rt.buf_push_dec_i64(&t, (b * 10.0) as i64)
    var e: [u8; 4] = "/10\n"
    rt.buf_push_bytes(&t, (&e[0]) as u64, 4)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 47] = "gallery8_main <out.png> [light|dark] [font.ttf]"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
    rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    // NO FONT, NO PROOF. A picture without a single
    // letter looks like a picture from afar, and that is exactly how
    // a text-less surface got through the acceptance in OrientOS. A proof without a label proves nothing -- so
    // an error on fd 2 and a return value on which the run
    // gets stuck, instead of writing a silent PNG.
    if fm == 0 {
        var ks: [u8; 60] = "gallery8: keine Schrift gefunden -- ohne Schrift kein Beleg\n"
        rt.write_everything(2, (&ks[0]) as u64, 60)
        return 9
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 120) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    let rand: u32 = theme.opaque((*f).border_col)
    let area: u32 = theme.opaque((*f).surface_raised)
    let txt: u32 = theme.opaque((*f).text)
    let accent: u32 = theme.opaque((*f).accent)
    let on_accent: u32 = theme.opaque((*f).text_on_accent)

    var t1: [u8; 48] = "TRANSFORMS -- rotate, scale, skew, and a picture"
    label(&c, 24.0, 20.0, 900.0, 15, (&t1[0]) as u64, 48, style.TOK_TEXT)

    var x: transform.Xform = transform.xf_new()

    // ---------------------------------------- 1. ROTATED TILES
    //
    // ONE label above the row, not one above and one
    // below: what the tiles show and by how many degrees they are
    // rotated belongs in THE SAME row.
    var l1: [u8; 84] = "rotated widgets, 0 to 48 degrees about the centre -- every glyph outline turns along"
    label(&c, 24.0, R1_LAB, 1100.0, 12, (&l1[0]) as u64, 84,
        style.TOK_TEXT_MUTED)
    band_auf()
    var g0: [u8; 1] = "0"
    var g1: [u8; 2] = "12"
    var g2: [u8; 2] = "24"
    var g3: [u8; 2] = "36"
    var g4: [u8; 2] = "48"
    var i: usize = 0
    while i < 5 {
        let cx: f64 = 140.0 + (i as f64) * 250.0
        let cy: f64 = R1_MID
        var grad: f64 = 0.0
        var p: u64 = (&g0[0]) as u64
        var n: usize = 1
        if i == 1 {
            grad = 12.0
            p = (&g1[0]) as u64
            n = 2
        }
        if i == 2 {
            grad = 24.0
            p = (&g2[0]) as u64
            n = 2
        }
        if i == 3 {
            grad = 36.0
            p = (&g3[0]) as u64
            n = 2
        }
        if i == 4 {
            grad = 48.0
            p = (&g4[0]) as u64
            n = 2
        }
        transform.xf_reset(&x)
        transform.xf_rotate_at(&x, grad, cx, cy)
        // The middle button is the accent button -- so there stands
        // a light text on a saturated surface next to it and you see
        // that the font is cleanly rotated in BOTH versions.
        var fl: u32 = area
        var tc: u32 = txt
        if i == 2 {
            fl = accent
            tc = on_accent
        }
        kachel(&z, &x, cx - 85.0, cy - 32.0, 170.0, 64.0, 14.0, rand, fl,
            tc, p, n, 17.0)
        band_box(&x, cx - 85.0, cy - 32.0, 170.0, 64.0)
        i = i + 1
    }
    let r1_lo: f64 = G_LO
    let r1_hi: f64 = G_HI

    // ---------------------------------------- 2. SKALIERTE KACHELN
    var l2: [u8; 57] = "scaled widgets -- the text is re-rasterised, not blown up"
    label(&c, 24.0, R2_LAB, 900.0, 12, (&l2[0]) as u64, 57,
        style.TOK_TEXT_MUTED)
    band_auf()
    var s0: [u8; 4] = "0.65"
    var s1: [u8; 4] = "0.85"
    var s2: [u8; 4] = "1.00"
    var s3: [u8; 4] = "1.25"
    var s4: [u8; 4] = "1.50"
    i = 0
    while i < 5 {
        let cx: f64 = 140.0 + (i as f64) * 250.0
        let cy: f64 = R2_MID
        var sk: f64 = 0.65
        var p: u64 = (&s0[0]) as u64
        if i == 1 {
            sk = 0.85
            p = (&s1[0]) as u64
        }
        if i == 2 {
            sk = 1.0
            p = (&s2[0]) as u64
        }
        if i == 3 {
            sk = 1.25
            p = (&s3[0]) as u64
        }
        if i == 4 {
            sk = 1.5
            p = (&s4[0]) as u64
        }
        transform.xf_reset(&x)
        transform.xf_scale(&x, sk, sk, cx, cy)
        kachel(&z, &x, cx - 75.0, cy - 28.0, 150.0, 56.0, 12.0, rand,
            area, txt, p, 4, 16.0)
        band_box(&x, cx - 75.0, cy - 28.0, 150.0, 56.0)
        i = i + 1
    }
    let r2_lo: f64 = G_LO
    let r2_hi: f64 = G_HI

    // ------------------------------------------------ 3. THE IMAGE
    let pix: u64 = rt.heap_alloc(IMAGE * IMAGE * 4)
    if pix == 0 {
        return 6
    }
    image_build(pix, IMAGE)
    var im: uiimage.Image = uiimage.image_wrap(pix, IMAGE, IMAGE, 0)

    band_auf()
    var l3: [u8; 31] = "a picture, turned by 25 degrees"
    label(&c, 60.0, R3_LAB, 300.0, 12, (&l3[0]) as u64, 31,
        style.TOK_TEXT_MUTED)
    transform.xf_reset(&x)
    transform.xf_rotate_at(&x, 25.0, 190.0, R3_MID)
    transform.tf_draw_image(&z, &x, &im, 105.0, R3_MID - 85.0, 170.0,
        170.0, 1.0)
    band_box(&x, 105.0, R3_MID - 85.0, 170.0, 170.0)

    var l4: [u8; 44] = "the same picture at 2.2x, sampled bilinearly"
    label(&c, 430.0, R3_LAB, 400.0, 12, (&l4[0]) as u64, 44,
        style.TOK_TEXT_MUTED)
    transform.xf_reset(&x)
    transform.xf_scale(&x, 2.2, 2.2, 560.0, R3_MID)
    transform.tf_draw_image(&z, &x, &im, 505.0, R3_MID - 55.0, 110.0,
        110.0, 1.0)
    band_box(&x, 505.0, R3_MID - 55.0, 110.0, 110.0)

    // ------------------------------------------------ 4. DIE SCHERUNG
    var l5: [u8; 44] = "skewX 15 degrees about the lower left corner"
    label(&c, 800.0, R3_LAB, 420.0, 12, (&l5[0]) as u64, 44,
        style.TOK_TEXT_MUTED)
    transform.xf_reset(&x)
    transform.xf_skew(&x, 15.0, 0.0, 800.0, R3_BOT - 31.0)
    var s5: [u8; 14] = "Sheared widget"
    kachel(&z, &x, 810.0, R3_MID - 72.0, 330.0, 155.0, 18.0, rand,
        area, txt, (&s5[0]) as u64, 14, 20.0)
    band_box(&x, 810.0, R3_MID - 72.0, 330.0, 155.0)
    let r3_lo: f64 = G_LO
    let r3_hi: f64 = G_HI

    // ============================ THE GRID IS RE-CALCULATED
    //
    // Three claims per row, and all via MEASURED edges:
    //
    //   a) The row begins at its top edge. It may begin a few
    //      points lower (a tile rotated by 12 degrees is lower than one
    //      rotated by 48), but not higher -- otherwise it
    //      runs into its own label.
    //   b) The distance from the label to the row is LAB_ABSTAND.
    //      The label stands 18 high; between its lower edge and
    //      the row there thus remain 8 points of air.
    //   c) Between the end of a row and the label of the
    //      next lie at most REIHEN_ABSTAND + 8 points. THAT
    //      is the number that makes the empty band y 220..350 impossible:
    //      formerly there were over a hundred there.
    let luft: f64 = 8.0
    var a1: [u8; 44] = "R1 starts at its top edge                   "
    verlange((&a1[0]) as u64, 41, r1_lo >= R1_TOP - 0.5
        && r1_lo <= R1_TOP + 12.0, r1_lo - R1_TOP, 12.0)
    var a2: [u8; 44] = "R1 ends inside its band                     "
    verlange((&a2[0]) as u64, 41, r1_hi <= R1_BOT + 0.5,
        r1_hi, R1_BOT)
    var a3: [u8; 44] = "R2 label sits LAB_ABSTAND above R2          "
    verlange((&a3[0]) as u64, 41, R2_TOP - R2_LAB == LAB_DISTANCE,
        R2_TOP - R2_LAB, LAB_DISTANCE)
    var a4: [u8; 44] = "gap R1 -> label of R2 stays small           "
    verlange((&a4[0]) as u64, 41,
        R2_LAB - r1_hi <= ROWS_DISTANCE + luft && R2_LAB - r1_hi >= 8.0,
        R2_LAB - r1_hi, ROWS_DISTANCE + luft)
    var a5: [u8; 44] = "R2 starts at its top edge                   "
    verlange((&a5[0]) as u64, 41, r2_lo >= R2_TOP - 0.5
        && r2_lo <= R2_TOP + 12.0, r2_lo - R2_TOP, 12.0)
    var a6: [u8; 44] = "gap R2 -> label of R3 stays small           "
    verlange((&a6[0]) as u64, 41,
        R3_LAB - r2_hi <= ROWS_DISTANCE + luft && R3_LAB - r2_hi >= 8.0,
        R3_LAB - r2_hi, ROWS_DISTANCE + luft)
    var a7: [u8; 44] = "R3 starts at its top edge                   "
    verlange((&a7[0]) as u64, 41, r3_lo >= R3_TOP - 0.5
        && r3_lo <= R3_TOP + 12.0, r3_lo - R3_TOP, 12.0)
    var a8: [u8; 44] = "R3 ends inside the sheet                    "
    verlange((&a8[0]) as u64, 41, r3_hi <= (H as f64) - 16.0,
        r3_hi, (H as f64) - 16.0)
    if G_ERROR > 0 {
        var gf: [u8; 60] = "gallery8: das Raster stimmt nicht -- kein Beleg geschrieben\n"
        rt.write_everything(2, (&gf[0]) as u64, 60)
        return 10
    }

    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 7
    }
    var pf: rt.Buf = rt.buf_new()
    var pk: usize = 0
    while pk < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, pk))
        pk = pk + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 8
    }
    var okm: [u8; 10] = "GALLERY 8\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    rt.heap_free(pix, IMAGE * IMAGE * 4)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
