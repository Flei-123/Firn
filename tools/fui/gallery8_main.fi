// SPDX-License-Identifier: MPL-2.0
// tools/fui/gallery8_main.fi -- DIE ABBILDUNG ALS BILD.
//
// Eine Abbildung zeigt sich an KANTEN: eine gedrehte Kachel, deren
// Rand sauber laeuft, ist der Beleg dafuer, dass die Pfadpunkte durch
// die Matrix gehen und nicht das fertige Pixelbild gedreht wird.
//
//     gallery8_main <out.png> [light|dark] [<font.ttf>]
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.style
import fui.widget
import fui.painter
import fui.render
import fui.layout
import fui.transform

const FONTSET_BYTES: usize = 4096
const W: usize = 1240
const H: usize = 570

fn label(c: *mut render.Ctx, x: f64, y: f64, w: f64, px: usize, p: u64,
    n: usize, tok: u32) {
    var e: widget.Widget = widget.widget_new(widget.KIND_LABEL)
    widget.w_place(&e, x, y, w, 18.0)
    widget.w_set_text(&e, p, n)
    let s: *mut style.Style = widget.w_style(&e)
    *s = style.style_set_fg(*s, style.color_token(tok))
    *s = style.style_set_font(*s, 0, px)
    *s = style.style_set_pad(*s, 0, 0)
    render.draw_label(c, &e)
}


fn main(start: u64) -> i32 {
    if rt.arg_count(start) < 2 {
        var u: [u8; 47] = "gallery8_main <out.png> [light|dark] [font.ttf]"
        rt.write_everything(2, (&u[0]) as u64, 47)
        return 2
    }
    let path: u64 = rt.arg_ptr(start, 1)
    var dark: bool = true
    if rt.arg_count(start) >= 3 {
        if rt.ld8(rt.arg_ptr(start, 2), 0) == 108 as u8 {
            dark = false
        }
    }
    var fbuf: rt.Buf = rt.buf_new()
    var have: bool = false
    if rt.arg_count(start) >= 4 {
        have = rt.read_file(rt.arg_ptr(start, 3), &fbuf)
    }
    if !have {
        var f1: [u8; 48] = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\0"
        have = rt.read_file((&f1[0]) as u64, &fbuf)
    }
    let fsp: *mut metrics.FontSet =
        rt.heap_alloc(FONTSET_BYTES) as *mut metrics.FontSet
    if fsp as usize == 0 {
        return 3
    }
    *fsp = metrics.fontset_new()
    var fm: u64 = 0
    if have {
        if metrics.fontset_load(fsp, fbuf.ptr as *mut u8, fbuf.len) {
            fm = fsp as u64
        }
    }
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, W, H) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, W, 300) {
        return 5
    }
    painter.painter_set_font(&z, fm)
    var m: theme.Theme = theme.theme_new(dark)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    canvas.canvas_clear(&cv, theme.opaque((*f).base))

    var t1: [u8; 33] = "TRANSFORMS -- rotate, scale, skew"
    label(&c, 24.0, 22.0, 900.0, 15, (&t1[0]) as u64, 33, style.TOK_TEXT)

    // ---- Eine Reihe gedrehter Kacheln: 0, 10, 20, 30, 45 Grad.
    var l1: [u8; 36] = "rotate 0 / 10 / 20 / 30 / 45 degrees"
    label(&c, 24.0, 58.0, 700.0, 12, (&l1[0]) as u64, 36,
        style.TOK_TEXT_MUTED)
    var x: transform.Xform = transform.xf_new()
    var i: usize = 0
    while i < 5 {
        let cx: f64 = 110.0 + (i as f64) * 220.0
        let cy: f64 = 180.0
        var grad: f64 = 0.0
        if i == 1 { grad = 10.0 }
        if i == 2 { grad = 20.0 }
        if i == 3 { grad = 30.0 }
        if i == 4 { grad = 45.0 }
        transform.xf_reset(&x)
        transform.xf_rotate_at(&x, grad, cx, cy)
        transform.tf_fill_round_rect(&z, &x, cx - 70.0, cy - 40.0, 140.0,
            80.0, 14.0, theme.opaque((*f).accent))
        i = i + 1
    }

    // ---- Dieselbe Kachel, skaliert: 0.6 / 0.8 / 1.0 / 1.25 / 1.5.
    var l2: [u8; 51] = "scale 0.6 / 0.8 / 1.0 / 1.25 / 1.5 about the centre"
    label(&c, 24.0, 262.0, 900.0, 12, (&l2[0]) as u64, 51,
        style.TOK_TEXT_MUTED)
    i = 0
    while i < 5 {
        let cx: f64 = 110.0 + (i as f64) * 220.0
        let cy: f64 = 360.0
        var s: f64 = 0.6
        if i == 1 { s = 0.8 }
        if i == 2 { s = 1.0 }
        if i == 3 { s = 1.25 }
        if i == 4 { s = 1.5 }
        transform.xf_reset(&x)
        transform.xf_scale(&x, s, s, cx, cy)
        transform.tf_fill_round_rect(&z, &x, cx - 60.0, cy - 30.0, 120.0,
            60.0, 12.0, theme.opaque((*f).surface_raised))
        transform.xf_reset(&x)
        transform.xf_scale(&x, s, s, cx, cy)
        var tx: [u8; 4] = "Tile"
        transform.tf_text(&z, &x, cx - 60.0 + 14.0, cy + 5.0, 100.0, 14.0,
            theme.opaque((*f).text), (&tx[0]) as u64, 4, painter.TEXT_L)
        i = i + 1
    }

    // ---- Scherung, wie CSS `skewX`.
    var l3: [u8; 16] = "skewX 12 degrees"
    label(&c, 24.0, 440.0, 400.0, 12, (&l3[0]) as u64, 16,
        style.TOK_TEXT_MUTED)
    transform.xf_reset(&x)
    transform.xf_skew(&x, 12.0, 0.0, 200.0, 500.0)
    transform.tf_fill_round_rect(&z, &x, 60.0, 470.0, 280.0, 60.0, 10.0,
        theme.opaque((*f).selection))

    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if !png.write_png(&cv, &out) {
        return 6
    }
    var pf: rt.Buf = rt.buf_new()
    var pk: usize = 0
    while pk < rt.c_length(path) {
        rt.buf_push(&pf, rt.ld8(path, pk))
        pk = pk + 1
    }
    rt.buf_push(&pf, 0 as u8)
    if !rt.write_file(rt.buf_ptr(&pf), mem.buf_ptr(&out) as u64,
        mem.buf_len(&out)) {
        return 7
    }
    var okm: [u8; 10] = "GALLERY 8\n"
    rt.write_everything(1, (&okm[0]) as u64, 10)
    painter.painter_free(&z)
    canvas.canvas_free(&cv)
    return 0
}
