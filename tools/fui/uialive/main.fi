// SPDX-License-Identifier: MPL-2.0
// tools/fui/uialive_main.fi -- THE UIA BRIDGE IN A REAL WINDOW (Windows, W36-a): window, buttons, controls, a table
// (rows + cells), a bottom sheet. Live: `uialive.exe` opens the window and serves UIA (Inspect.exe / Narrator).
// Oracle: with FUI_UIALIVE_DUMP=<path> the same window is built headless (any target), painted once and its a11y
// JSON is written to <path>; the program exits. The tree is the same on every OS.
import std.rt
import html.mem
import paint.canvas
import paint.png
import font.metrics
import fui.theme
import fui.painter
import fui.scene
import fui.editor
import fui.widget
import plat.fuiwirt
import plat.sysfont
import fui.apphost
import fui.app
import fui.appctl
import fui.ctxmenu
import fui.a11y
import fui.uiacom
import fui.vlist
import fui.render
import fui.safeout
import std.env
import plat.fuiwin
import plat.fuiwinvk

static mut CHANGES: usize = 0
static mut FONT: u64 = 0

fn say(s: str) {
    rt.write_everything(1, s.p as u64, s.n)
}

struct Surface {
    cv: canvas.Canvas,
    z: painter.Painter,
    w: usize,
    h: usize,
}

fn surface_for(a: *mut app.App, w: usize, h: usize) -> *mut Surface {
    let s: *mut Surface = rt.heap_alloc(65536) as *mut Surface
    (*s).cv = canvas.canvas_new()
    (*s).z = painter.painter_new()
    (*s).w = w
    (*s).h = h
    if !canvas.canvas_init(&(*s).cv, w, h)
    || !painter.painter_init(&(*s).z, &(*s).cv, w, h) {
        return 0 as u64 as *mut Surface
    }
    painter.painter_set_font(&(*s).z, FONT)
    app.app_attach(a as u64, &(*s).z)
    return s
}

fn frame(a: *mut app.App, s: *mut Surface) {
    app.app_paint(a as u64, (*s).w, (*s).h)
    fuiwirt.host_painted(app.app_host(a))
    let c: u32 = fuiwirt.host_after_layout(app.app_host(a))
}

fn changed(a: *mut app.App, id: usize) {
    CHANGES = CHANGES + 1
}

// FUI_GPU=0: the pure CPU painter (on Windows the window layer has OpenGL of its own and uses it otherwise); FUI_GPU=1: Vulkan.
fn pre_open(fx: u64) {
    if env.get("FUI_GPU") == "0" {
        fuiwin.window_set_gpu(fx as *mut fuiwin.Window, false)
    } else {
        fuiwinvk.pre_open_env(fx)
    }
}

fn save_png(cv: *mut canvas.Canvas, path: str) {
    var pb: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&pb, (path.p) as u64, path.n)
    rt.buf_push(&pb, 0 as u8)
    var out: mem.Buf = mem.buf_new()
    mem.buf_init(&out)
    if png.write_png(cv, &out) {
        let ok: bool = safeout.write_file(rt.buf_ptr(&pb), mem.buf_ptr(&out) as u64, mem.buf_len(&out))
    }
    rt.buf_free(&pb)
}

fn on_quit(a: *mut app.App) {
    app.quit(a)
}

fn on_save(a: *mut app.App) {
    CHANGES = CHANGES + 1
}

// The sheet's content: what the two a11y items below announce (sheet_item rects are relative to the body origin).
// W40-a: before, the body was empty -- the panel rose with nothing in it.
fn body_item(rc: *mut render.Ctx, kind: u32, text: str, x: f64, y: f64, w: f64, h: f64) {
    var e: widget.Widget = widget.widget_new(kind)
    widget.w_place(&e, x, y, w, h)
    widget.w_set_text(&e, (text.p) as u64, text.n)
    render.draw_widget(rc, &e)
}

fn body_draw(a: *mut app.App, rc: *mut render.Ctx, x: f64, y: f64, w: f64, h: f64) {
    body_item(rc, widget.KIND_LABEL, "Total 3 items", x + 16.0, y + 24.0, 200.0, 24.0)
    body_item(rc, widget.KIND_BUTTON, "Checkout", x + 16.0, y + 54.0, 120.0, 32.0)
}

#[allow_escape]
fn main(start: u64) -> i32 {
    let a: *mut app.App = app.window("fUi UIA Live", 560, 760)
    app.set_pre_open(a, pre_open)
    let hd: usize = app.label(a, "Preferences", 0)
    a11y.a11y_set_role(app.ax(a), hd, a11y.ROLE_HEADING)
    a11y.a11y_set_level(app.ax(a), hd, 1 as u32)
    let b1: usize = app.button(a, "Save", on_save)
    let cb: usize = appctl.checkbox(a, "Dark mode", false, changed)
    let tg: usize = appctl.toggle(a, "Notifications", false, changed)
    let sl: usize = appctl.slider(a, "Volume", 0, 100, 40, changed)
    let en: usize = app.entry(a, "Search")
    let tbl: usize = appctl.table(a, "People", 520, 150, 3, changed)
    appctl.table_col(a, tbl, 0, "Name", 200, false)
    appctl.table_col(a, tbl, 1, "Age", 120, false)
    appctl.table_col(a, tbl, 2, "ID", 160, true)
    let tr0: usize = appctl.table_add_row(a, tbl)
    appctl.table_set(a, tbl, tr0, 0, "Anna")
    appctl.table_set(a, tbl, tr0, 1, "7")
    appctl.table_set(a, tbl, tr0, 2, "a-01")
    let tr1: usize = appctl.table_add_row(a, tbl)
    appctl.table_set(a, tbl, tr1, 0, "Bruno")
    appctl.table_set(a, tbl, tr1, 1, "25")
    appctl.table_set(a, tbl, tr1, 2, "b-02")
    let tr2: usize = appctl.table_add_row(a, tbl)
    appctl.table_set(a, tbl, tr2, 0, "Carla")
    appctl.table_set(a, tbl, tr2, 1, "41")
    appctl.table_set(a, tbl, tr2, 2, "c-03")
    let qb: usize = app.button(a, "Quit", on_quit)
    let shok: bool = appctl.sheet_setup(a, "Panel", false, body_draw, changed)
    appctl.sheet_describe(a, "Three items in the cart")
    let it0: usize = appctl.sheet_item(a, a11y.ROLE_TEXT, "Total 3 items", 16, 24, 200, 24)
    let it1: usize = appctl.sheet_item(a, a11y.ROLE_BUTTON, "Checkout", 16, 54, 120, 32)
    // FUI_UIALIVE_SHEET=0: the sheet stays closed (the table rows are then free to hit-test / click)
    if env.get("FUI_UIALIVE_SHEET") != "0" {
        appctl.sheet_show(a, 0)
    }
    let dp: str = env.get("FUI_UIALIVE_DUMP")
    if dp.n > 0 {
        let fs: *mut metrics.FontSet = rt.heap_alloc(4096) as *mut metrics.FontSet
        if !sysfont.sysfont_load(fs) {
            say("uialive: no font\n")
            return 9
        }
        FONT = fs as u64
        fuiwirt.host_bind(app.app_host(a))
        let s: *mut Surface = surface_for(a, 560, 760)
        frame(a, s)
        frame(a, s)
        // the sheet glides up over time: let it settle before the picture
        let hw: *mut fuiwirt.Host = app.app_host(a)
        var gt: i64 = fuiwirt.host_now(hw)
        var gi: usize = 0
        while gi < 40 {
            gt = gt + 16
            fuiwirt.host_tick(hw, gt)
            gi = gi + 1
        }
        frame(a, s)
        // FUI_UIALIVE_PNG=<path>: the same painted frame as a PNG (the layout can be looked at without a screen)
        let pp: str = env.get("FUI_UIALIVE_PNG")
        if pp.n > 0 {
            save_png(&(*s).cv, pp)
        }
        let jb: u64 = rt.heap_alloc(262144)
        let jn: usize = a11y.a11y_dump_json(app.app_scene(a), app.ax(a), jb, 262144)
        var pb: rt.Buf = rt.buf_new()
        rt.buf_push_bytes(&pb, (dp.p) as u64, dp.n)
        rt.buf_push(&pb, 0 as u8)
        let wok: bool = safeout.write_file(rt.buf_ptr(&pb), jb, jn)
        rt.buf_free(&pb)
        say("UIALIVE DUMP written\n")
        return 0
    }
    let uia_on: bool = uiacom.enable_from_env(a, "fUi UIA Live")
    if uia_on { say("UIA LIVE on\n") } else { say("UIA LIVE off\n") }
    return app.run(a)
}
