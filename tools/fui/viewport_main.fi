// SPDX-License-Identifier: MPL-2.0
// tools/fui/viewport_main.fi -- THE PANE BOX IS RE-CALCULATED.
//
// The numbers are calculated by hand. The sheet: a section of
// 200 x 300 on a content of 200 x 900, bar thickness 12.
//
//   1. Which bars are necessary -- including the CROSS calculation:
//      a vertical bar takes away width and can thereby make
//      a horizontal one necessary.
//   2. The visible section and the largest offset.
//   3. The clamping: there is no scrolling beyond the end.
//   4. The share section/content and the position of the bar.
//   5. `viewport_ensure_visible` brings a rectangle in -- from below
//      and from above, and scrolls as little as possible.
//   6. The hit test UNDER OFFSET: the same window point
//      hits a different point in the content after scrolling.
//   7. The kinetic coasting comes to rest and does not run beyond
//      the end.
//
// From section 8 on, no more calculation is done, but PAINTING and then
// reading off -- on a real canvas (canvas.canvas_init), with the
// real painter and a real render.Ctx:
//
//   8. THE HARD CLIPPING. A deliberately far overhanging content
//      is painted between `viewport_begin` and `viewport_end`, and
//      afterwards EVERY pixel of the canvas outside the
//      section is looked at. A single set point is a
//      failure. So that this does not become green because nothing at all
//      was painted, it is counted in the same go how much is set INSIDE.
//      And there is the COUNTER-TEST: the same content without
//      clip, measured by the same count -- it must find overflowed
//      points and print their number. And the same zero measurement
//      ("no point outside") runs a second time WITHOUT clip: it
//      MUST fail, its failure stands as RED-OK in the log, and
//      thereby it is proven that the zero above measures anything at all.
//   9. THE LENGTH OF THE SLIDER, read off the canvas and calculated against
//      section/content * track length.
//  10. Wheel, keys and the coasting IN THE MIDDLE of the movement.
//  11. THE SAME BOX AT SCALE 1.5. The bar thickness stands in
//      design points; it is converted at ONE place in the tree
//      (`theme.theme_px`, here 12 -> 18), and this module
//      re-calculates none of it. It is proven that the visible
//      section is then 182 x 282 AND that the clip still sits
//      exactly on it -- with the same count as section 8.
//  12. THE BARS ARE OPERATED. Hits, grab on the slider,
//      fifty points dragged (offset = 50 * content/track =
//      50 * 900/284 = 158.45), continued dragging from the GRAB,
//      the clamping at the end and the page jump on clicking the track.
import std.rt
import paint.canvas
import fui.theme
import fui.style
import fui.painter
import fui.layout
import fui.render
import fui.viewport
import fui.widget
import fui.wave2

static mut G_ERRORS: usize = 0

fn report(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var o: [u8; 4] = "OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 4)
    } else {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 6] = " want "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 6)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// THE EXPECTED RED RESULT. An assertion that MUST FAIL:
// the same measurement as next to it, only under conditions under which it
// cannot pass. If it fails, everything is in order and in the
// log stands RED-OK; if it passes, on the other hand, then the measurement measures
// nothing, and THAT is the failure. Without this detour every
// zero measurement of this program would be unproven -- it would be green even
// if it looked at nothing.
fn rot(nm: u64, nn: usize, ok: bool, a: i64, b: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    if ok {
        var f: [u8; 8] = "WRONG   "
        rt.buf_push_bytes(&t, (&f[0]) as u64, 8)
        G_ERRORS = G_ERRORS + 1
    } else {
        var o: [u8; 8] = "ROT-OK  "
        rt.buf_push_bytes(&t, (&o[0]) as u64, 8)
    }
    var g: [u8; 4] = "got "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    var w: [u8; 20] = " want NICHT genau   "
    rt.buf_push_bytes(&t, (&w[0]) as u64, 18)
    rt.buf_push_dec_i64(&t, b)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// A measured number without a target value -- the counter-test prints with it
// HOW MUCH would have overflowed without clip. A number that one sees
// is the difference between a proof and a claim.
fn number(nm: u64, nn: usize, a: i64) {
    var t: rt.Buf = rt.buf_new()
    rt.buf_push_bytes(&t, nm, nn)
    var i: usize = nn
    while i < 46 {
        rt.buf_push(&t, 32 as u8)
        i = i + 1
    }
    var g: [u8; 4] = "  = "
    rt.buf_push_bytes(&t, (&g[0]) as u64, 4)
    rt.buf_push_dec_i64(&t, a)
    rt.buf_push(&t, 10 as u8)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
}

// The canvas for sections 8 and 9. It is deliberately only
// slightly larger than the section at (50, 40): so around the
// section there is canvas everywhere on which an overflow MUST be noticed.
const LW: usize = 400
const LH: usize = 400

// THE DELIBERATELY TOO LARGE CONTENT.
//
// Twenty rows of 44 points each, so 880 points high, and every row
// is 260 wide and begins 30 points left of the content start. With
// an offset of 100 the content thereby protrudes beyond ALL FOUR
// edges of the section -- top, bottom, left and right. Without
// clip more than half of it lands beside the box.
fn content_paint(z: *mut painter.Painter, v: *mut viewport.Viewport,
    col: u32) {
    let cx: f64 = viewport.viewport_content_x(v)
    let cy: f64 = viewport.viewport_content_y(v)
    var i: usize = 0
    while i < 20 {
        painter.round_rect(z, cx - 30.0, cy + (i as f64) * 44.0, 260.0,
            40.0, 8.0, col)
        i = i + 1
    }
}

// Counts the set pixels OUTSIDE the section. Set
// means: the opacity is not zero -- the canvas was cleared to
// transparent beforehand, so every point with opacity came from this
// painting. Measured is against the REALLY visible
// section (without the bar tracks), because exactly there
// `viewport_begin` lays its clip.
fn drueber(cv: *mut canvas.Canvas, v: *mut viewport.Viewport) -> usize {
    let x0: f64 = viewport.viewport_x(v)
    let y0: f64 = viewport.viewport_y(v)
    let x1: f64 = x0 + viewport.viewport_inner_w(v)
    let y1: f64 = y0 + viewport.viewport_inner_h(v)
    var n: usize = 0
    var y: usize = 0
    while y < LH {
        var x: usize = 0
        while x < LW {
            let inside: bool = (x as f64) >= x0 && (x as f64) < x1
            && (y as f64) >= y0 && (y as f64) < y1
            if !inside {
                if canvas.color_a(canvas.canvas_get(cv, x, y)) != 0 as u32 {
                    n = n + 1
                }
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

// And the same count INSIDE. Without it section 8 would be green
// even if nothing at all had been painted -- the
// cheapest way to pass a clipping is to draw nothing.
fn drinnen(cv: *mut canvas.Canvas, v: *mut viewport.Viewport) -> usize {
    let x0: f64 = viewport.viewport_x(v)
    let y0: f64 = viewport.viewport_y(v)
    let x1: f64 = x0 + viewport.viewport_inner_w(v)
    let y1: f64 = y0 + viewport.viewport_inner_h(v)
    var n: usize = 0
    var y: usize = y0 as usize
    while (y as f64) < y1 {
        var x: usize = x0 as usize
        while (x as f64) < x1 {
            if canvas.color_a(canvas.canvas_get(cv, x, y)) != 0 as u32 {
                n = n + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return n
}

fn main(start: u64) -> i32 {
    // The content is just as wide as the section, but three times as
    // high. So: vertical bar yes -- and because that takes 12 points
    // of width, the content no longer fits horizontally, so also
    // a horizontal one. That is the cross calculation.
    var v: viewport.Viewport = viewport.viewport_new(50.0, 40.0, 200.0,
        300.0, 200.0, 900.0)

    var n1: [u8; 30] = "1 senkrechter Balken noetig   "
    report((&n1[0]) as u64, 30, viewport.viewport_needs_v(&v),
        viewport.viewport_needs_v(&v) as i64, 1)
    var n2: [u8; 34] = "1 waagerechter Balken ueber Kreuz "
    report((&n2[0]) as u64, 34, viewport.viewport_needs_h(&v),
        viewport.viewport_needs_h(&v) as i64, 1)

    // 200 - 12 = 188 breit, 300 - 12 = 288 hoch.
    let iw: i64 = viewport.viewport_inner_w(&v) as i64
    let ih: i64 = viewport.viewport_inner_h(&v) as i64
    var n3: [u8; 30] = "2 sichtbare Breite 188        "
    report((&n3[0]) as u64, 30, iw == 188, iw, 188)
    var n4: [u8; 30] = "2 sichtbare Hoehe 288         "
    report((&n4[0]) as u64, 30, ih == 288, ih, 288)
    // 900 - 288 = 612.
    let my: i64 = viewport.viewport_max_y(&v) as i64
    var n5: [u8; 30] = "2 groesste Verschiebung 612   "
    report((&n5[0]) as u64, 30, my == 612, my, 612)

    // ========================================== 3. DIE KLEMMUNG
    viewport.viewport_set_offset(&v, 0.0, 10000.0)
    let o1: i64 = viewport.viewport_off_y(&v) as i64
    var n6: [u8; 32] = "3 ueber das Ende wird geklemmt  "
    report((&n6[0]) as u64, 32, o1 == 612, o1, 612)
    viewport.viewport_scroll_by(&v, 0.0, 0.0 - 100000.0)
    let o2: i64 = viewport.viewport_off_y(&v) as i64
    var n7: [u8; 32] = "3 vor den Anfang auch nicht     "
    report((&n7[0]) as u64, 32, o2 == 0, o2, 0)

    // ======================= 4. SHARE AND POSITION OF THE BAR
    //
    // 288 / 900 = 0.32 -- in the language of wave2 (VAL_MAX = 1000)
    // that is 320 per mille. At half the offset (306 of 612)
    // the bar stands at 500.
    let anteil: i64 = (viewport.viewport_share_v(&v)
        *(wave2.VAL_MAX as f64)) as i64
    var n8: [u8; 34] = "4 Anteil 288/900 = 320 Promille   "
    report((&n8[0]) as u64, 34, anteil == 320, anteil, 320)
    viewport.viewport_set_offset(&v, 0.0, 306.0)
    let stellung: i64 = viewport.viewport_value_v(&v)
    var n9: [u8; 35] = "4 halbe Verschiebung = Stellung 500"
    report((&n9[0]) as u64, 35, stellung == 500, stellung, 500)

    // ==================================== 5. BRINGING SOMETHING IN
    //
    // The section stands at 306 and shows 306..594. A rectangle
    // at 700 (30 high) must come with its LOWER EDGE to the lower edge:
    // 730 - 288 = 442.
    viewport.viewport_ensure_visible(&v, 0.0, 700.0, 100.0, 30.0)
    let e1: i64 = viewport.viewport_off_y(&v) as i64
    var n10: [u8; 34] = "5 von unten hereingeholt: 442     "
    report((&n10[0]) as u64, 34, e1 == 442, e1, 442)
    // Something at 100 comes with its UPPER EDGE to the upper edge.
    viewport.viewport_ensure_visible(&v, 0.0, 100.0, 100.0, 30.0)
    let e2: i64 = viewport.viewport_off_y(&v) as i64
    var n11: [u8; 34] = "5 von oben hereingeholt: 100      "
    report((&n11[0]) as u64, 34, e2 == 100, e2, 100)
    // What is already visible moves nothing at all.
    let moved: bool = viewport.viewport_ensure_visible(&v, 0.0, 150.0,
        100.0, 30.0)
    let e3: i64 = viewport.viewport_off_y(&v) as i64
    var n12: [u8; 34] = "5 was zu sehen ist, rollt nicht   "
    report((&n12[0]) as u64, 34, !moved && e3 == 100, e3, 100)

    // ================= 6. THE HIT TEST UNDER OFFSET
    //
    // The section begins at (50, 40) and stands at 100. The
    // window point (60, 50) thus lies 10 below the upper edge of the
    // section and thereby at 110 in the content.
    var cx: f64 = 0.0
    var cy: f64 = 0.0
    let inside: bool = viewport.viewport_hit(&v, 60.0, 50.0, &cx, &cy)
    var n13: [u8; 34] = "6 Punkt im Inhalt: y = 110        "
    report((&n13[0]) as u64, 34, inside && (cy as i64) == 110,
        cy as i64, 110)
    var n14: [u8; 34] = "6 Punkt im Inhalt: x = 10         "
    report((&n14[0]) as u64, 34, inside && (cx as i64) == 10,
        cx as i64, 10)
    // Under the horizontal bar there is NO section any more.
    let drunter: bool = viewport.viewport_hit(&v, 60.0, 40.0 + 295.0,
        &cx, &cy)
    var n15: [u8; 34] = "6 unter dem Balken kein Treffer   "
    report((&n15[0]) as u64, 34, !drunter, drunter as i64, 0)

    // ====================================== 7. THE COASTING
    //
    // A speed of 1 pixel per millisecond carries
    // VP_FLING_MS/2 = 210 pixels far: from 100 to 310.
    viewport.viewport_set_offset(&v, 0.0, 100.0)
    viewport.viewport_fling(&v, 0.0, 1.0, 0)
    viewport.viewport_tick(&v, viewport.VP_FLING_MS)
    let f1: i64 = viewport.viewport_off_y(&v) as i64
    var n16: [u8; 34] = "7 das Auslaufen endet bei 310     "
    report((&n16[0]) as u64, 34, f1 == 310, f1, 310)
    var n17: [u8; 34] = "7 und es steht danach still       "
    report((&n17[0]) as u64, 34, !viewport.viewport_moving(&v),
        viewport.viewport_moving(&v) as i64, 0)

    // ==================================================================
    // 8. THE HARD CLIPPING -- MEASURED ON THE CANVAS
    // ==================================================================
    //
    // Up to here this program has only calculated. A clip that is right
    // when calculated and wide of the mark when painted is exactly the
    // error because of which this box was built. So: real
    // canvas, real painter, real render.Ctx -- and afterwards
    // every single pixel is looked at.
    var cv: canvas.Canvas = canvas.canvas_new()
    if !canvas.canvas_init(&cv, LW, LH) {
        return 4
    }
    var z: painter.Painter = painter.painter_new()
    if !painter.painter_init(&z, &cv, LW, LH) {
        return 5
    }
    var m: theme.Theme = theme.theme_new(true)
    var c: render.Ctx = render.ctx_new(&m, &z)
    let f: *mut theme.Colors = theme.theme_colors(&m)
    let color: u32 = theme.opaque((*f).accent)

    var k: viewport.Viewport = viewport.viewport_new(50.0, 40.0, 200.0,
        300.0, 200.0, 900.0)
    viewport.viewport_set_offset(&k, 0.0, 100.0)

    // Cleared to transparent: every point with opacity is afterwards
    // provably from this painting and not from the background.
    canvas.canvas_clear(&cv, 0 as u32)
    let auf: bool = viewport.viewport_begin(&c, &k)
    content_paint(&z, &k, color)
    viewport.viewport_end(&c, &k)
    let over: usize = drueber(&cv, &k)
    let inner: usize = drinnen(&cv, &k)
    var n18: [u8; 40] = "8 kein Punkt ausserhalb des Ausschnitts "
    report((&n18[0]) as u64, 40, auf && over == 0, over as i64, 0)
    // 20 rows of 40 points at a spacing of 44 cover around
    // 40/44 of the section (188 x 288 = 54144), so over 45000
    // points. The threshold stands at 40000 -- lower than the content
    // can ever fall, and far above what an empty canvas
    // delivers.
    var n19: [u8; 40] = "8 innerhalb gemalt: mehr als 40000      "
    report((&n19[0]) as u64, 40, inner > 40000, inner as i64, 40000)

    // THE COUNTER-TEST. The same content, the same count -- only without
    // clip. If it now finds NO overflow, it measures nothing,
    // and section 8 would be a soliloquy.
    canvas.canvas_clear(&cv, 0 as u32)
    content_paint(&z, &k, color)
    let over2: usize = drueber(&cv, &k)
    // The 30 points on the left and the 42 on the right over 288 points of
    // height alone are together over 20000 points; to that come the rows
    // above and below the section.
    var n20: [u8; 40] = "8 Gegenprobe ohne Clip: ueber 20000     "
    report((&n20[0]) as u64, 40, over2 > 20000, over2 as i64, 20000)
    var n21: [u8; 40] = "8 uebergelaufene Punkte ohne Clip       "
    number((&n21[0]) as u64, 40, over2 as i64)
    // AND THE SAME ZERO MEASUREMENT A SECOND TIME -- WORD FOR WORD LIKE n18,
    // only without clip. It MUST fail, and its failure stands as
    // RED in the log: thereby a reader sees not only that the
    // count in line n18 found zero, but also that
    // the same count CAN find anything at all. A zero measurement
    // that never trips is no measurement.
    var n22: [u8; 40] = "8 dieselbe Messung ohne Clip (ROT)      "
    rot((&n22[0]) as u64, 40, over2 == 0, over2 as i64, 0)

    // ==================================================================
    // 9. THE LENGTH OF THE SLIDER, READ OFF THE CANVAS
    // ==================================================================
    //
    // The track of the vertical bar is 288 long, of which 2 points of padding each go off at the top
    // and bottom: 284. Visible are 288 of 900,
    // so 284 * 288/900 = 90.88 -- rounded up 91 points of slider.
    // The minimum length from wave2 (24 points) is the named
    // exception to this calculation and does not take effect here.
    //
    // Measured is in the MIDDLE of the bar (x = 244): there the
    // slider is covered over its whole length, the round corners
    // lie to the left and right of it.
    canvas.canvas_clear(&cv, theme.opaque((*f).base))
    viewport.viewport_set_offset(&k, 0.0, 306.0)
    viewport.viewport_draw_bars(&c, &k)

    var bx: f64 = 0.0
    var by: f64 = 0.0
    var bw: f64 = 0.0
    var bh: f64 = 0.0
    let has_bar: bool = viewport.viewport_bar_rect_v(&k, &bx, &by,
        &bw, &bh)
    var n23: [u8; 40] = "9 die Spur des Balkens ist 288 lang     "
    report((&n23[0]) as u64, 40, has_bar && (bh as i64) == 288,
        bh as i64, 288)

    // The track colour is read off where surely no slider
    // lies: close under the upper edge. At half position the slider stands
    // around 96 points lower.
    //
    // Counted is the LONGEST CONTIGUOUS STRETCH that deviates from the
    // track colour, and not every deviating row: the track
    // is itself a round rectangle, and its soft edges at the very top
    // and the very bottom deviate as well. The slider is the only
    // long piece in this column, and exactly its length is to
    // come out here.
    let trace: u32 = canvas.canvas_get(&cv, 244, 42)
    var measured: usize = 0
    var begin: usize = 0
    var run: usize = 0
    var yy: usize = 40
    while yy < 328 {
        if canvas.canvas_get(&cv, 244, yy) != trace {
            run = run + 1
            if run > measured {
                measured = run
                begin = yy + 1 - run
            }
        } else {
            run = 0
        }
        yy = yy + 1
    }
    // One point of play upwards and downwards: the soft edge of the
    // rasteriser colours the cut row along.
    var n24: [u8; 40] = "9 Schieberlaenge auf der Leinwand 90..92"
    report((&n24[0]) as u64, 40, measured >= 90 && measured <= 92,
        measured as i64, 91)
    // And it begins where the position demands: 138.56,
    // so on the canvas at row 138 (the cut row
    // is already coloured).
    var n23b: [u8; 40] = "9 Schieber beginnt bei Zeile 138..139   "
    report((&n23b[0]) as u64, 40, begin >= 138 && begin <= 139,
        begin as i64, 138)

    // And the same length from wave2.scrollbar_thumb -- the ONE
    // place at which it is calculated. If it were a different one here,
    // the bar in the image would have a different length than the one with
    // which a caller calculates.
    var e: widget.Widget = widget.widget_new(widget.KIND_SCROLLBAR)
    widget.w_place(&e, bx, by, bw, bh)
    widget.w_set_pref(&e, 0.0,
        viewport.viewport_share_v(&k) * (wave2.VAL_MAX as f64))
    widget.w_set_value(&e, viewport.viewport_value_v(&k))
    var tr: layout.Rect = wave2.scrollbar_thumb(&c, &e)
    var n25: [u8; 40] = "9 wave2.scrollbar_thumb sagt 91         "
    report((&n25[0]) as u64, 40, layout.rect_h(&tr) == 91,
        layout.rect_h(&tr), 91)
    // It also stands at the right place: 40 + 2 + (284 - 90.88)
    // * 500/1000 = 138.56, rounded 139.
    var n26: [u8; 40] = "9 und der Schieber steht bei 139        "
    report((&n26[0]) as u64, 40, layout.rect_y(&tr) == 139,
        layout.rect_y(&tr), 139)

    // ==================================================================
    // 10. WHEEL, KEYS AND THE COASTING IN THE MIDDLE OF THE MOVEMENT
    // ==================================================================
    //
    // One wheel notch is VP_WHEEL_STEP = 72 points; two notches in
    // one event are 144.
    viewport.viewport_set_offset(&k, 0.0, 0.0)
    viewport.viewport_wheel(&k, 0.0, 1.0)
    let r1: i64 = viewport.viewport_off_y(&k) as i64
    var n27: [u8; 40] = "10 ein Radrasten rollt 72               "
    report((&n27[0]) as u64, 40, r1 == 72, r1, 72)
    viewport.viewport_wheel(&k, 0.0, 2.0)
    let r2: i64 = viewport.viewport_off_y(&k) as i64
    var n28: [u8; 40] = "10 zwei Rasten dazu: 216                "
    report((&n28[0]) as u64, 40, r2 == 216, r2, 216)

    // One page is the visible section: 288. Twice is 576,
    // on the third time it CLAMPS at 612 -- and on the fourth nothing
    // moves any more, which the key also says.
    viewport.viewport_set_offset(&k, 0.0, 0.0)
    viewport.viewport_key(&k, viewport.VP_PAGE_DOWN)
    viewport.viewport_key(&k, viewport.VP_PAGE_DOWN)
    let s2: i64 = viewport.viewport_off_y(&k) as i64
    var n29: [u8; 40] = "10 zwei Seiten abwaerts: 576            "
    report((&n29[0]) as u64, 40, s2 == 576, s2, 576)
    viewport.viewport_key(&k, viewport.VP_PAGE_DOWN)
    let s3: i64 = viewport.viewport_off_y(&k) as i64
    var n30: [u8; 40] = "10 die dritte klemmt am Ende: 612       "
    report((&n30[0]) as u64, 40, s3 == 612, s3, 612)
    let s4: bool = viewport.viewport_key(&k, viewport.VP_PAGE_DOWN)
    var n31: [u8; 40] = "10 und die vierte bewegt nichts mehr    "
    report((&n31[0]) as u64, 40, !s4, s4 as i64, 0)
    viewport.viewport_key(&k, viewport.VP_HOME)
    viewport.viewport_key(&k, viewport.VP_DOWN)
    let s5: i64 = viewport.viewport_off_y(&k) as i64
    var n32: [u8; 40] = "10 Pos1 und ein Schritt abwaerts: 24    "
    report((&n32[0]) as u64, 40, s5 == 24, s5, 24)

    // THE COASTING IN THE MIDDLE OF THE MOVEMENT. It begins at
    // millisecond 1000 and not at 0 -- a box that kept its own
    // time would be noticed exactly here.
    //
    // From 0 at 1 point per millisecond: target 210. After half the
    // duration (210 ms) an EASE_OUT (cubic-bezier 0, 0, 0.58, 1) stands
    // NOT at half, but already further: x(t) = 1.74 t^2 -
    // 0.74 t^3 = 0.5 gives t = 0.6256, and y(t) = 3 (1-t) t^2 + t^3 =
    // 0.684. So 0.684 * 210 = 143.7 points -- demanded is the
    // band 140 to 147, and thereby it is at the same time proven that here
    // really the curve from anim.fi runs and no straight line.
    viewport.viewport_set_offset(&k, 0.0, 0.0)
    viewport.viewport_fling(&k, 0.0, 1.0, 1000)
    viewport.viewport_tick(&k, 1000)
    let a0: i64 = viewport.viewport_off_y(&k) as i64
    var n33: [u8; 40] = "10 im Augenblick des Anstosses: 0       "
    report((&n33[0]) as u64, 40, a0 == 0, a0, 0)
    var n34: [u8; 40] = "10 und der Kasten ist in Bewegung       "
    report((&n34[0]) as u64, 40, viewport.viewport_moving(&k),
        viewport.viewport_moving(&k) as i64, 1)
    viewport.viewport_tick(&k, 1210)
    let a1: i64 = viewport.viewport_off_y(&k) as i64
    var n35: [u8; 40] = "10 nach der halben Dauer: 140..147      "
    report((&n35[0]) as u64, 40, a1 >= 140 && a1 <= 147, a1, 144)
    viewport.viewport_tick(&k, 1420)
    let a2: i64 = viewport.viewport_off_y(&k) as i64
    var n36: [u8; 40] = "10 am Ende der Dauer: 210               "
    report((&n36[0]) as u64, 40, a2 == 210, a2, 210)
    var n37: [u8; 40] = "10 und danach steht es still            "
    report((&n37[0]) as u64, 40, !viewport.viewport_moving(&k),
        viewport.viewport_moving(&k) as i64, 0)

    // WHOEVER SCROLLS THEMSELVES DURING THE COASTING STOPS IT. Otherwise
    // the next tick writes the offset of the tween over it,
    // and the wheel would have done nothing.
    viewport.viewport_set_offset(&k, 0.0, 0.0)
    viewport.viewport_fling(&k, 0.0, 1.0, 2000)
    viewport.viewport_tick(&k, 2100)
    viewport.viewport_wheel(&k, 0.0, 1.0)
    let b0: i64 = viewport.viewport_off_y(&k) as i64
    var n38: [u8; 40] = "10 das Rad haelt das Auslaufen an       "
    report((&n38[0]) as u64, 40, !viewport.viewport_moving(&k),
        viewport.viewport_moving(&k) as i64, 0)
    viewport.viewport_tick(&k, 2400)
    let b1: i64 = viewport.viewport_off_y(&k) as i64
    var n39: [u8; 40] = "10 und der Takt schreibt nichts darueber"
    report((&n39[0]) as u64, 40, b1 == b0, b1, b0)

    // ==================================================================
    // 11. THE SAME BOX AT SCALE 1.5
    // ==================================================================
    //
    // The thickness of a scroll bar stands in DESIGN POINTS, and this
    // module does NOT convert it -- the conversion design point ->
    // pixel stands at exactly one place in the tree, namely
    // `theme.theme_px`. A box on a screen at 150 % therefore gets
    // its thickness from the caller: theme_px(12) = (12*1500+500)/1000
    // = 18 pixels.
    //
    // What is proven here is the consequence: the visible
    // section shrinks to 200 - 18 = 182 and 300 - 18 = 282, and
    // the clip from `viewport_begin` STILL sits exactly on this
    // section -- measured with the same count as in section 8,
    // pixel by pixel.
    var m15: theme.Theme = theme.theme_new(true)
    theme.theme_set_scale(&m15, 1500)
    var c15: render.Ctx = render.ctx_new(&m15, &z)
    let dicke: usize = theme.theme_px(&m15, 12)
    var n40: [u8; 40] = "11 theme_px(12) bei Massstab 1.5 ist 18 "
    report((&n40[0]) as u64, 40, dicke == 18, dicke as i64, 18)

    var g: viewport.Viewport = viewport.viewport_new(50.0, 40.0, 200.0,
        300.0, 200.0, 900.0)
    viewport.viewport_set_bar(&g, dicke)
    viewport.viewport_set_offset(&g, 0.0, 100.0)
    let giw: i64 = viewport.viewport_inner_w(&g) as i64
    let gih: i64 = viewport.viewport_inner_h(&g) as i64
    var n41: [u8; 40] = "11 sichtbare Breite 200 - 18 = 182      "
    report((&n41[0]) as u64, 40, giw == 182, giw, 182)
    var n42: [u8; 40] = "11 sichtbare Hoehe 300 - 18 = 282       "
    report((&n42[0]) as u64, 40, gih == 282, gih, 282)

    canvas.canvas_clear(&cv, 0 as u32)
    let auf15: bool = viewport.viewport_begin(&c15, &g)
    content_paint(&z, &g, color)
    viewport.viewport_end(&c15, &g)
    let over15: usize = drueber(&cv, &g)
    let inner15: usize = drinnen(&cv, &g)
    var n43: [u8; 40] = "11 kein Punkt ausserhalb, auch bei 1.5  "
    report((&n43[0]) as u64, 40, auf15 && over15 == 0, over15 as i64, 0)
    // 182 x 282 = 51324 points of section, of which the content covers around
    // 40/44 -- the threshold 40000 is the same as in section 8 and
    // lies far above what an empty canvas delivers.
    var n44: [u8; 40] = "11 und innerhalb ist wirklich gemalt    "
    report((&n44[0]) as u64, 40, inner15 > 40000, inner15 as i64, 40000)

    // ==================================================================
    // 12. THE BARS ARE OPERATED -- WITH THE NUMBER FOR IT
    // ==================================================================
    //
    // Until 22.09.2026 this box could only PAINT its bars.
    // A scroll bar that one cannot touch is a display;
    // here it is re-calculated that it is now an operation.
    //
    // THE SHEET (the same as above): section 200 x 300 at (50, 40),
    // content 200 x 900, bars 12 thick. The vertical bar thus sits
    // at x = 50 + 200 - 12 = 238 and is 288 long; its track
    // measures 284 (2 points of padding each), the slider 284 * 288/900 =
    // 90.88, its travel 284 - 90.88 = 193.12.
    //
    // AT POSITION 500 (offset 306 of 612) the slider stands
    // at 40 + 2 + 193.12 * 0.5 = 138.56, so on the canvas
    // with y = 139 and h = 91. Its CENTRE thus lies at 139 + 45 = 184.
    viewport.viewport_set_offset(&k, 0.0, 306.0)
    let dirv: u32 = viewport.viewport_bar_hit(&k, 244.0, 184.0)
    var n45: [u8; 40] = "12 der Punkt (244,184) trifft den Balken"
    report((&n45[0]) as u64, 40, dirv == viewport.VP_BAR_V,
        dirv as i64, viewport.VP_BAR_V as i64)
    let dirn: u32 = viewport.viewport_bar_hit(&k, 100.0, 184.0)
    var n46: [u8; 40] = "12 mitten im Inhalt trifft er keinen    "
    report((&n46[0]) as u64, 40, dirn == viewport.VP_BAR_NONE,
        dirn as i64, viewport.VP_BAR_NONE as i64)
    // The horizontal bar lies at the bottom: y = 40 + 300 - 12 = 328.
    let dirh: u32 = viewport.viewport_bar_hit(&k, 100.0, 330.0)
    var n47: [u8; 40] = "12 und unten der waagerechte            "
    report((&n47[0]) as u64, 40, dirh == viewport.VP_BAR_H,
        dirh as i64, viewport.VP_BAR_H as i64)

    // THE GRAB SITS ON THE SLIDER -- the same geometry that
    // wave2.scrollbar_thumb paints.
    var tt: layout.Rect = viewport.viewport_bar_thumb(&c, &k,
        viewport.VP_BAR_V)
    var n48: [u8; 40] = "12 der Schieber steht bei 139, 91 lang  "
    report((&n48[0]) as u64, 40,
        layout.rect_y(&tt) == 139 && layout.rect_h(&tt) == 91,
        layout.rect_y(&tt), 139)

    // FIFTY POINTS DRAGGED. The offset grows by
    // 50 * largest offset / travel of the slider
    //   = 50 * 612 / 193.12 = 158.45,
    // and that is numerically equal to 50 * content / track
    //   = 50 * 900 / 284 = 158.4507...
    // (because travel = track * (content - section) / content). Both ways
    // are held against each other here, calculated in hundredths.
    let gedrueckt: bool = viewport.viewport_bar_press(&c, &k, 244.0,
        184.0)
    var n49: [u8; 40] = "12 der Druck auf den Schieber greift    "
    report((&n49[0]) as u64, 40, gedrueckt
        && viewport.viewport_bar_dragging(&k) == viewport.VP_BAR_V,
        viewport.viewport_bar_dragging(&k) as i64,
        viewport.VP_BAR_V as i64)
    let gezogen: bool = viewport.viewport_bar_drag(&c, &k, 244.0, 234.0)
    let to: i64 = (viewport.viewport_off_y(&k) * 100.0) as i64
    let should: i64 = ((306.0 + 50.0 * 900.0 / 284.0) * 100.0) as i64
    var n50: [u8; 40] = "12 50 Punkte gezogen: 306 + 50*900/284  "
    report((&n50[0]) as u64, 40, gezogen && to == should, to, should)
    // And the same once more as a pure distance: 15845 hundredths.
    var n51: [u8; 40] = "12 die Strecke allein: 158.45 Punkte    "
    report((&n51[0]) as u64, 40, to - 30600 == 15845, to - 30600,
        15845)
    // Dragging continues calculated from the same GRAB, not from the
    // last event: 75 points are 75 * 900/284 = 237.67, and
    // not 50 + 75 points far.
    viewport.viewport_bar_drag(&c, &k, 244.0, 259.0)
    let to2: i64 = (viewport.viewport_off_y(&k) * 100.0) as i64
    var n52: [u8; 40] = "12 75 Punkte: 237.67 vom Griff gerechnet"
    report((&n52[0]) as u64, 40, to2 - 30600 == 23767, to2 - 30600,
        23767)
    // And beyond the end it is clamped here too: 306 + 316.9
    // would be 622.9, the largest offset is 612.
    viewport.viewport_bar_drag(&c, &k, 244.0, 284.0)
    let to3: i64 = viewport.viewport_off_y(&k) as i64
    var n51b: [u8; 40] = "12 und am Ende klemmt auch das Ziehen   "
    report((&n51b[0]) as u64, 40, to3 == 612, to3, 612)
    viewport.viewport_bar_release(&k)
    let nothing: bool = viewport.viewport_bar_drag(&c, &k, 244.0, 334.0)
    var n53: [u8; 40] = "12 nach dem Loslassen zieht nichts mehr "
    report((&n53[0]) as u64, 40, !nothing, nothing as i64, 0)

    // THE JUMP ON THE TRACK. Pressed above the slider means one
    // page back: 306 - 288 = 18.
    viewport.viewport_set_offset(&k, 0.0, 306.0)
    viewport.viewport_bar_press(&c, &k, 244.0, 60.0)
    let page: i64 = viewport.viewport_off_y(&k) as i64
    var n54: [u8; 40] = "12 Klick ueber dem Schieber: 306-288=18 "
    report((&n54[0]) as u64, 40, page == 18, page, 18)
    // And under it one page forward -- from 18 to 306.
    viewport.viewport_bar_press(&c, &k, 244.0, 320.0)
    let side2: i64 = viewport.viewport_off_y(&k) as i64
    var n55: [u8; 40] = "12 Klick darunter: 18+288 = 306         "
    report((&n55[0]) as u64, 40, side2 == 306, side2, 306)
    // A jump on the track is NOT a drag: whoever moves the mouse
    // afterwards shifts nothing.
    var n56: [u8; 40] = "12 der Spursprung faengt kein Ziehen an "
    report((&n56[0]) as u64, 40,
        viewport.viewport_bar_dragging(&k) == viewport.VP_BAR_NONE,
        viewport.viewport_bar_dragging(&k) as i64,
        viewport.VP_BAR_NONE as i64)

    // ================================= 13. THE PADDING OF THE SECTION
    //
    // It shrinks ONLY the cut and the hit area, not the
    // rectangle: position, bars and content dimensions stay the same
    // numbers as without padding. Both are measured -- that nothing is hit any more in the padding
    // AND that exactly one point further in is hit
    // again.
    var pv: viewport.Viewport = viewport.viewport_new(100.0, 50.0,
        200.0, 100.0, 200.0, 400.0)
    viewport.viewport_set_bar(&pv, 0)
    var pcx: f64 = 0.0
    var pcy: f64 = 0.0
    var n60: [u8; 40] = "13 ohne Polster trifft die Ecke (100,50)"
    report((&n60[0]) as u64, 40,
        viewport.viewport_hit(&pv, 100.0, 50.0, &pcx, &pcy),
        viewport.viewport_hit(&pv, 100.0, 50.0, &pcx, &pcy) as i64, 1)
    viewport.viewport_set_inset(&pv, 10.0)
    var n61: [u8; 40] = "13 das Polster steht auf 10             "
    report((&n61[0]) as u64, 40,
        viewport.viewport_inset(&pv) as i64 == 10,
        viewport.viewport_inset(&pv) as i64, 10)
    var n62: [u8; 40] = "13 mit Polster trifft die Ecke nicht    "
    report((&n62[0]) as u64, 40,
        !viewport.viewport_hit(&pv, 100.0, 50.0, &pcx, &pcy),
        viewport.viewport_hit(&pv, 100.0, 50.0, &pcx, &pcy) as i64, 0)
    var n63: [u8; 40] = "13 (110,60) liegt wieder im Ausschnitt  "
    report((&n63[0]) as u64, 40,
        viewport.viewport_hit(&pv, 110.0, 60.0, &pcx, &pcy),
        viewport.viewport_hit(&pv, 110.0, 60.0, &pcx, &pcy) as i64, 1)
    // The other edge likewise: 100+200-10 = 290 is already padding.
    var n64: [u8; 40] = "13 und (290,60) liegt schon im Polster  "
    report((&n64[0]) as u64, 40,
        !viewport.viewport_hit(&pv, 290.0, 60.0, &pcx, &pcy),
        viewport.viewport_hit(&pv, 290.0, 60.0, &pcx, &pcy) as i64, 0)
    // The padding changes nothing about the rectangle -- otherwise it would be a
    // second place for the size of the box.
    var n65: [u8; 40] = "13 das Rechteck bleibt 200 breit        "
    report((&n65[0]) as u64, 40, viewport.viewport_w(&pv) as i64 == 200,
        viewport.viewport_w(&pv) as i64, 200)
    // A negative padding does not exist.
    viewport.viewport_set_inset(&pv, -5.0)
    var n66: [u8; 40] = "13 ein negatives Polster wird zu 0      "
    report((&n66[0]) as u64, 40,
        viewport.viewport_inset(&pv) as i64 == 0,
        viewport.viewport_inset(&pv) as i64, 0)

    painter.painter_free(&z)
    canvas.canvas_free(&cv)

    var t: rt.Buf = rt.buf_new()
    rt.buf_push(&t, 10 as u8)
    if G_ERRORS > 0 {
        var f: [u8; 26] = "VIEWPORT IS NOT IN ORDER.\n"
        rt.buf_push_bytes(&t, (&f[0]) as u64, 26)
        rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
        rt.buf_free(&t)
        return 1
    }
    var o: [u8; 17] = "VIEWPORT PASSED.\n"
    rt.buf_push_bytes(&t, (&o[0]) as u64, 17)
    rt.write_everything(1, rt.buf_ptr(&t), rt.buf_len(&t))
    rt.buf_free(&t)
    return 0
}
